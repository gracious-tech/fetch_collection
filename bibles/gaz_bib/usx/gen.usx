<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="GEN" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">ኡመመ</para>
  <para style="toc1">ሴረ ኡመማ</para>
  <para style="toc2">ኡመመ</para>
  <para style="toc3">ኡመ</para>
  <para style="mt2">ሴረ</para>
  <para style="mt1">ኡመማ</para>
  <chapter number="1" style="c" sid="GEN 1"/>
  <para style="s1">ጀልቀበ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 1:1"/>ጀልቀበት ዋቅን ሰሚወኒፊ ለፈ ኡሜ። <verse eid="GEN 1:1"/><verse number="2" style="v" sid="GEN 1:2"/>ለፍት ከን ብፈ ህንቀብኔፊ ዱዋ ቱርቴ፤ ዱከንስ ቱጁበረ ቱሬ፤ ሀፉር ዋቃስ ብሻንረ ሶሶቾአ ቱሬ።<verse eid="GEN 1:2"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="3" style="v" sid="GEN 1:3"/>ዋቅንስ፣ “እፍን ሃተኡ” ጄዼ፤ እፍንስ ንተኤ። <verse eid="GEN 1:3"/><verse number="4" style="v" sid="GEN 1:4"/>ዋቅንስ አከ እፍን ሱን ጋሪ ተኤ አርጌ፤ እፋፊ ዱከነስ ገርገር ባሴ። <verse eid="GEN 1:4"/><verse number="5" style="v" sid="GEN 1:5"/>ዋቅንስ እፈ ሰናን “ጉያ” ጄዼ፤ ዱከነ ሰናንሞ “ሀልከን” ጄዼ ሞጋሴ። ገልገለስ ተኤ፤ ገነመስ ተኤ፤ ጉያ ቶኮፋ።<verse eid="GEN 1:5"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="6" style="v" sid="GEN 1:6"/>ዋቅንስ፣ “ብሻኒፊ ብሻን ገርገር ባሱፍ በንቲን ብሻኖተ ግዱ ሃጅራቱ” ጄዼ። <verse eid="GEN 1:6"/><verse number="7" style="v" sid="GEN 1:7"/>ከናፉ ዋቅን በንቲ ቶልቼ ብሻን በንቲ ጀላቲፊ ከን በንቲን ኦሊ ገርገር ባሴ። አከሱመስ ተኤ። <verse eid="GEN 1:7"/><verse number="8" style="v" sid="GEN 1:8"/>ዋቅንስ በንቲ ሰነ “ሰሚ” ጄዼ ሞጋሴ። ገልገለስ ተኤ፤ ገነመስ ተኤ፤ ጉያ ለመፋ።<verse eid="GEN 1:8"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="9" style="v" sid="GEN 1:9"/>ዋቅንስ፣ “ብሻን ሰሚዻ ገድ ጅሩ እዶ ቶኮት ወልት ሃቀበሙ፤ ለፍት ጎጋንስ ሃሙልአቱ” ጄዼ። አከሱመስ ተኤ። <verse eid="GEN 1:9"/><verse number="10" style="v" sid="GEN 1:10"/>ዋቅን ለፈ ጎጋ ሰናን “ለፈ” ጄዼ፤ ብሻንቸ ወልት ቀበሜንሞ “ገላነ” ጄዼ ሞጋሴ። ዋቅንስ ወን ኩን አከ ጋሪ ተኤ አርጌ።<verse eid="GEN 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 1:11"/>አመስ ዋቅን፣ “ለፍት ብቅልቱወን ሃባስቱ፤ ብቅልቱወን አኩመ ጎሰ ጎሰሳኒት ሰኚ ባሰን፣ ሙኬን እጀ ኬነኒ እጅሳኒሞ ሰኚ ኦፍ ኬሳ ቀቡ አዱመ አዳን አኩመ ጎሰ ጎሰሳኒት ለፈረት ሃአርገመን” ጄዼ። አከሱመስ ተኤ። <verse eid="GEN 1:11"/><verse number="12" style="v" sid="GEN 1:12"/>ለፍትስ ብቅልቱ አኩመ ጎሰሳት ሰኚ ባሱ፣ ሙከ እጀ ኬኑ፣ ከን እጅሳስ ሰኚ ኦፍ ኬሳ ቀቡ አዱመ አዳን አኩመ ጎሰሳት ባስቴ። ዋቅንስ ወን ኩን አከ ጋሪ ተኤ አርጌ። <verse eid="GEN 1:12"/><verse number="13" style="v" sid="GEN 1:13"/>ገልገለስ ተኤ፤ ገነመስ ተኤ፤ ጉያ ሰደፋ።<verse eid="GEN 1:13"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="14" style="v" sid="GEN 1:14"/>ዋቅንስ አከነ ጄዼ፤ “ጉያፊ ሀልከን ገርገር ባሱፍ በንቲ ሰሚረት እፈወን ሃተአን፤ እሳንስ መለቶወን ወቅቲሌን፣ ጉዮትኒፊ ወጎትን እቲን ቤከመን ሃተአን፤ <verse eid="GEN 1:14"/><verse number="15" style="v" sid="GEN 1:15"/>እሳንስ እፈወን በንቲ ሰሚራ ከን ለፋፍ እፈ ኬነን ሃተአን።” አከሱመስ ተኤ። <verse eid="GEN 1:15"/><verse number="16" style="v" sid="GEN 1:16"/>ዋቅን እፈ ጉርጉዳ ለመ ኡሜ፤ ኩንስ አከ እፍን ጉዳን ጉያ፣ እን ጥናንሞ ሀልከን ሞኡፍ። አከሱመ ኡርጂወንሌ ኡሜ። <verse eid="GEN 1:16"/><verse number="17" style="v" sid="GEN 1:17"/>ዋቅንስ አከ እሳን ለፋፍ እፈ ኬነኒፍ በንቲ ሰሚረ እሳን ካኤ፤ <verse eid="GEN 1:17"/><verse number="18" style="v" sid="GEN 1:18"/>ኩንስ አከ እሳን ጉያፊ ሀልከን ሞአኒፊ አከ እፈ ሰነ ዱከነራ ገርገር ባሰኒፍ። ዋቅንስ ወን ኩን አከ ጋሪ ተኤ አርጌ። <verse eid="GEN 1:18"/><verse number="19" style="v" sid="GEN 1:19"/>ገልገለስ ተኤ፤ ገነመስ ተኤ፤ ጉያ አፉረፋ።<verse eid="GEN 1:19"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="20" style="v" sid="GEN 1:20"/>ዋቅንስ፣ “ብሻን ኡመመወን ሉቡ ቀቤዪ ሙኙቀኒን ሃጉተሙ፤ ስምብሮትንስ ለፋ ኦልት፣ በንቲ ሰሚ ኬሰ ሃበርሰን” ጄዼ። <verse eid="GEN 1:20"/><verse number="21" style="v" sid="GEN 1:21"/>ከናፉ ዋቅን ኡመመወን ገላና ጉርጉዳ፣ ሉቡ ቀቤዪ ሙኙቀን ከኔን ገላነ ኬሰ ጅራተን ሁንዳፊ ስምብሮተ ቆቾ ቀበን ሁንደ አኩመ ጎሰሳኒት ኡሜ። ዋቅንስ ወን ኩን አከ ጋሪ ተኤ አርጌ። <verse eid="GEN 1:21"/><verse number="22" style="v" sid="GEN 1:22"/>ዋቅንስ፣ “ሆራ፤ ባይአዻ፤ ብሻን ገላኖታስ ጉታ፤ ስምብሮትንስ ለፈረት ሃባይአተን” ጄዼ እሳን ኤብሴ። <verse eid="GEN 1:22"/><verse number="23" style="v" sid="GEN 1:23"/>ገልገለስ ተኤ፤ ገነመስ ተኤ፤ ጉያ ሸነፋ።<verse eid="GEN 1:23"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="24" style="v" sid="GEN 1:24"/>ዋቅንስ፣ “ለፍት አኩመ ጎሰ ጎሰሳኒት ኡመመወን ሉቡ ቀቤዪ ጄቹንስ ሆሪ፣ ኡመመወን ለፈረ ሙሙኙቀን፣ ብኔንሶተ አኩመ ጎሰ ጎሰሳኒት ሃኬንቱ” ጄዼ። አከሱመስ ተኤ። <verse eid="GEN 1:24"/><verse number="25" style="v" sid="GEN 1:25"/>ዋቅን ብኔንሶተ አኩመ ጎሰ ጎሰሳኒት፣ ሆሪ አኩመ ጎሰ ጎሰሳኒት፣ ኡመመወን ለፈረ ሙሙኙቀንስ አኩመ ጎሰ ጎሰሳኒት ኡሜ። ዋቅን ወን ኩን አከ ጋሪ ተኤ አርጌ።<verse eid="GEN 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 1:26"/>ዋቅንስ፣ “ኮታ አከ ብፈኬኛት፣ አከ ፈኬኘኬኛትስ ነመ ኡምና፤ እሳንስ ቁርጡሚ ገላናረት፣ ስምብሮ ሰሚረት፣ ሆሪረት፣ ለፈ ሁንዱማፊ ኡመመወን ለፈረ ሙኙቀን ሁንዱማረት ኣንጎ ሃቀባተን” ጄዼ።<verse eid="GEN 1:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="GEN 1:27"/>ከናፉ ዋቅን አከ ብፈሳት ነመ ኡሜ፤</para>
  <para style="q2" vid="GEN 1:27">አከ ብፈ ዋቃት እሰ ኡሜ፤</para>
  <para style="q2" vid="GEN 1:27">እንስ ዺራፊ ዱበርቲ ታስሴ እሳን ኡሜ።<verse eid="GEN 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 1:28"/>ዋቅንስ እሳን ኤብሴ፣ “ሆራ፣ ባይአዻስ፤ ለፈ ጉታቲ ሀርከኬሰን ጀለትስ ቡልፈዻ። ቁርጡሚ ገላናረት፣ ስምብሮተ ሰሚረት፣ ኡመመ ለፈረ ሙኙቁ ሁንደረት ኣንጎ ቀባዻ” ጄዼን።<verse eid="GEN 1:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 1:29"/>ኤርገሲ ዋቅን አከነ ጄዼ፤ “ኩኖ አን አከ እሳን ኛተ እስኒ ተአኒፍ ብቅልቱ ለፈ ሁንደረት ሰኚ ኬኑ ሁንዳፊ ሙከ እጅሳ ሰኚ ኦፍ ኬሳ ቀቡ ጎሰ ሁንደ እስኒ ኬኔረ። <verse eid="GEN 1:29"/><verse number="30" style="v" sid="GEN 1:30"/>አንስ ብኔንሰ ለፋ ሁንዳፍ፣ ስምብሮተ ሰሚ ሁንዳፍ፣ ኡመመ ለፈረ ሙኙቁ ሁንዳፍ ጄቹንስ ዋን ሀፉረ ጅሬኛ ኦፍ ኬሳ ቀቡ ሁንዳፍ አከ ኛተሳኒ ተኡፍ ብቅልቱ ለልሳ ሁንደ ነንኬነ።” አከሱመስ ተኤ።<verse eid="GEN 1:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 1:31"/>ዋቅንስ ዋን ሆጄቴ ሁንደ እላሌ፤ ወን ሱንስ ዹጉማን ጋሪ ቱሬ። ገልገለስ ተኤ፤ ገነመስ ተኤ፤ ጉያ ጀአፋ።<verse eid="GEN 1:31"/></para>
  <para style="b"/>
  <chapter eid="GEN 1"/>
  <chapter number="2" style="c" sid="GEN 2"/>
  <para style="p">
    <verse number="1" style="v" sid="GEN 2:1"/>ኡመምን ሰሚቲፊ ለፋ፣ ከን ዋን እሳን ኬሰ ጅሩ ሁንዳስ ሃለ ከናን ጡሙረሜ።<verse eid="GEN 2:1"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="2" style="v" sid="GEN 2:2"/>ዋቅን ሆጂ ሆጄቻ ቱሬ ሁንደ ጉያ ቶርበፋት ፍጤ፤ ከናፉ እን ጉያ ቶርበፋት ሆጂሳ ሁንዱማራ ቦቆቴ። <verse eid="GEN 2:2"/><verse number="3" style="v" sid="GEN 2:3"/>ዋቅን ሰበቢ ጋፈ ሰነ ሆጂ ዋ ኡሙ ከን ሆጄቻ ቱሬ ሁንደራ ቦቆቴፍ ጉያ ቶርበፋ ኤብሴ ቁልቁሌሴ።<verse eid="GEN 2:3"/></para>
  <para style="s1">አዳሚፊ ሄዋን</para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 2:4"/>ሴናን ሰሚወኒቲፊ ለፋ ከን ዬሮ እሳን ኡመመኒ፣ ዬሮ <char style="nd">ዋቀዮ</char> ዋቅን ለፋፊ ሰሚወን ኡሜ ከናዸ።<verse eid="GEN 2:4"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="5" style="v" sid="GEN 2:5"/>ሰበቢ <char style="nd">ዋቀዮ</char> ዋቅን ቦካ ህንሮብስኒፍ፣ ነምን ለፈ ቆቱስ ዋን ህንጅራትኒፍ መርግ ቶኮዩ ለፈረት ህንሙልአትኔ፤ ብቅልቱንስ ለፈ ቆቲሳረት ህንብቅሌ ቱሬ። <verse eid="GEN 2:5"/><verse number="6" style="v" sid="GEN 2:6"/>ገሩ ብሻን ለፈ ኬሳ ቡርቄ ለፈ ሁንደ ኦባሰ ቱሬ። <verse eid="GEN 2:6"/><verse number="7" style="v" sid="GEN 2:7"/><char style="nd">ዋቀዮ</char> ዋቅን ብዮ ለፋራ ነመ ቶልቼ፤ ሀፉረ ጅሬኛስ ፉኛንሳት ባፈቴ፤ ነምንስ ኡመመ ጅራታ ተኤ።<verse eid="GEN 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 2:8"/>
    <char style="nd">ዋቀዮ</char> ዋቅንስ ኤዴን ኬሰት ገመ በአ ቢፍቱት እዶ ብቅልቱ ቆጴሴ፤ ነመ ቶልቼ ሰነስ አች ኬሰ ካኤ። <verse eid="GEN 2:8"/><verse number="9" style="v" sid="GEN 2:9"/><char style="nd">ዋቀዮ</char> ዋቅን ሙኬን ጎሰ ሁንዳ ለፈ ኬሳ ብቅልቼ፤ እን ሙኬን እጀ ነማት ቶለኒፊ ኛታፍስ ጋሪ ተአን ብቅልቼ። እዶ ብቅልቱ ሰነ ኬሰስ ሙከ ጅሬኛቲፊ ሙከ ዋን ጋሪፊ ዋን ሀማ ነመ ቤክስሱቱ ቱሬ።<verse eid="GEN 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 2:10"/>ለግን እዶ ብቅልቱ ሰነ ኦባሱ ቶኮስ ኤዴን ኬሳ ቡርቀ ቱሬ፤ ለግን ሱን ኤዴኒ ከኤ ገርገር በኤ ለገ አፉር ተኤ። <verse eid="GEN 2:10"/><verse number="11" style="v" sid="GEN 2:11"/>መቃን ለገ ቶኮፋ ጲሾን፤ እንስ ጉቱማ ብየ ሀዊላ፣ እዶ ወርቄን ጅሩት ናነኤ ያአ። <verse eid="GEN 2:11"/><verse number="12" style="v" sid="GEN 2:12"/>ወርቄን ብየ ሰና ጋሪዸ፤ ሀጴን ኡርጋኡፊ ሰርዶንክሲን አችት አርገሙ። <verse eid="GEN 2:12"/><verse number="13" style="v" sid="GEN 2:13"/>መቃን እሰ ለመፋ ጊሆን፤ እንስ ጉቱማ ለፈ እቶጵያት ናነኤ ያአ። <verse eid="GEN 2:13"/><verse number="14" style="v" sid="GEN 2:14"/>መቃን ለገ ሰደፋ ጤግሮስ፤ እንስ ከራ በአ ቢፍቱቲን አሶር ጭነ ያአ። ለግን አፉረፋንሞ ኤፍራጢስ ጄዸመ።<verse eid="GEN 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 2:15"/>
    <char style="nd">ዋቀዮ</char> ዋቅን አከ እን እሰ ምሶምሱፊ አከ እን እሰ ኤጉፍ ጄዼ ነመ ፉዼ እዶ ብቅልቱ ኤዴን ኬሰ ካኤ። <verse eid="GEN 2:15"/><verse number="16" style="v" sid="GEN 2:16"/><char style="nd">ዋቀዮ</char> ዋቅንስ አከነ ጄዼ ነመ አጀጄ፤ “ሙከ እዶ ብቅልቱ ከነ ኬሰ ጅሩ ሁንደራ ኛቹ ንደንዴሰ፤ <verse eid="GEN 2:16"/><verse number="17" style="v" sid="GEN 2:17"/>ገሩ ሙከ ዋን ጋሪፊ ዋን ሀማ ነመ ቤክስሱ ሰነራ ህንኛትን፤ ጋፈ እሰራ ኛቴ ዹጉማን ንዱታቲ።”<verse eid="GEN 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 2:18"/>
    <char style="nd">ዋቀዮ</char> ዋቅን፣ “ነምን ኮጳሳ ተኡን ጋሪ ምት፤ ገርጋርቱ እሰት ቶልቱ ነንቶልቻፍ” ጄዼ።<verse eid="GEN 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 2:19"/>
    <char style="nd">ዋቀዮ</char> ዋቅንስ ብኔንሳፊ ስምብሮተ ሰሚ ሁንዱማ ለፈራ ቶልቼ። መቃ እን እሳኒፍ ባሱ እላሉፍ ጄዼስ ገረ ነምቻት እሳን ፍዴ፤ ወን ነምች ሱን ቶኮ ቶኮ ኡመመወን ሉቡ ቀቤዪ እቲን ዋሜ ከምዩ መቃ ተኤፍ። <verse eid="GEN 2:19"/><verse number="20" style="v" sid="GEN 2:20"/>ነምች ሱንስ ሆሪ ቄኤ ሁንዳፍ፣ ስምብሮተ ሰሚ ሁንዳፍ፣ ብኔንሰ ሁንዳፍ መቃ ባሴ።</para>
  <para style="p" vid="GEN 2:20">አዳሚፍ ገሩ ገርጋርቱን እሰት ቶልቱ ህንአርገምኔ። <verse eid="GEN 2:20"/><verse number="21" style="v" sid="GEN 2:21"/>ከናፍስ <char style="nd">ዋቀዮ</char> ዋቅን አከ ነምች ህርባን ኦፍ ወላሉ ጎዼ፤ ኡቱመ እን ረፋ ጅሩ ለፌ ጭናቸሳ ኬሳ ቶኮ ፉዼ እዶ ሰነ ፎኒን ዱቼ። <verse eid="GEN 2:21"/><verse number="22" style="v" sid="GEN 2:22"/><char style="nd">ዋቀዮ</char> ዋቅን ለፌ ጭናቻ ከን ነምቸ ኬሳ ፉዼ ሰነራ ዱበርቲ ቶልቼ ገረ ነምቻት ጌሴ።<verse eid="GEN 2:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 2:23"/>ነምችስ አከነ ጄዼ፤</para>
  <para style="q1" vid="GEN 2:23">“ኤጋ ለፌን ኩን ለፌ ለፌኮቲት፤</para>
  <para style="q2" vid="GEN 2:23">ፎን ኩንስ ፎን ፎንኮቲት፤</para>
  <para style="q1" vid="GEN 2:23">እሼን ዋን ዺረራ አርገምቴፍ</para>
  <para style="q2" vid="GEN 2:23">‘ዱበርቲ’ ጄዸምት።”<verse eid="GEN 2:23"/></para>
  <para style="m">
    <verse number="24" style="v" sid="GEN 2:24"/>ከናፉ ነምን አባፊ ሃዸሳ ንዺሰ፤ ኒቲሳት ንመጠነ፤ እሳንስ ፎን ቶኮ ተኡ።<verse eid="GEN 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 2:25"/>ነምቺፊ ኒቲንሳ ቁላሳኒ ቱረን፤ ገሩ ወል ህንቃነአን ቱሬ።<verse eid="GEN 2:25"/></para>
  <chapter eid="GEN 2"/>
  <chapter number="3" style="c" sid="GEN 3"/>
  <para style="s1">ኩፋቲ ነማ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 3:1"/>ብኔንሰ <char style="nd">ዋቀዮ</char> ዋቅን ኡሜ ሁንደ ኬሳ ቦፍት ሀጤ ቱሬ። ዱበርትቲዻንስ፣ “ዹጉመ ዋቅን፣ ‘ሙከ እዶ ብቅልቱ ኬሰ ጅሩ ከም እራዩ ህንኛትና’ እስኒን ጄዼራ?” ጄዼ።<verse eid="GEN 3:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 3:2"/>ዱበርትቲንስ ዴብፍቴ ቦፈ ሰናን አከነ ጄቴ፤ “እጀ ሙኬን እዶ ብቅልቱ ኬሰ ጅረኒ ኛቹ ንደንዴኘ፤ <verse eid="GEN 3:2"/><verse number="3" style="v" sid="GEN 3:3"/>ገሩ ዋቅን፣ ‘ሙከ ወለካ እዶ ብቅልቱ ሰና ኬሰ ጅሩራ እጀ ህንኛትና፤ እትስ ህንቡእና፤ ዮ ከና አቺ ንዱቱ’ ጄዼረ።”<verse eid="GEN 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 3:4"/>ቦፍችስ ዴብሴ ዱበርትቲዻን አከነ ጄዼ፤ “እስን ዹጉማን ህንዱተን። <verse eid="GEN 3:4"/><verse number="5" style="v" sid="GEN 3:5"/>ዋቅን አከ ዮሙ እስን እጀ ሙክቻ ኛተን እጅኬሰን በነሙ፣ አከ እስን ዋን ጋሪፊ ዋን ሀማ ቤኩዻን አከ ዋቃ ታተን ንቤካቲ።”<verse eid="GEN 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 3:6"/>ዱበርትቲንስ ዮሙ አከ እጅ ሙክቻ ኛታፍ ጋሪ፣ ከን እጀ ነማት ቶሉ፣ ኦጉማ አርገቹፍስ አከ ነመ ጎጆማስሱ አርግቴት ፉዸቴ ኛቴ። ዽርስሼስ እሼ ወጅን ቱሬ፤ እሳፍስ ንላቴ፤ እንስ ንኛቴ። <verse eid="GEN 3:6"/><verse number="7" style="v" sid="GEN 3:7"/>እጅ ለቸንሳኒስ ንበነሜ፤ ቁላ ሀፉሳኒስ ቤከን፤ ከናፍስ ባለ ሀርቡ ሆዸኒ መርጦ ቶልፈተን።<verse eid="GEN 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 3:8"/>አኩመ አዱን ቀበኖፍቴንስ ነምቺፊ ኒቲንሳ ኡቱ <char style="nd">ዋቀዮ</char> ዋቅን እዶ ብቅልቱ ሰነ ኬሰ ዴሙ ሰገሌሳ ዸገአን፤ እሳንስ ሙኬን እዶ ብቅልቱ ኬሰ <char style="nd">ዋቀዮ</char> ዋቀ ዱራ ዾከተን። <verse eid="GEN 3:8"/><verse number="9" style="v" sid="GEN 3:9"/><char style="nd">ዋቀዮ</char> ዋቅን ገሩ ነምቸ ዋሜ፣ “አት ኤሰ ጅርተ?” ጄዼን።<verse eid="GEN 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 3:10"/>ነምችስ ዴብሴ፣ “አን ኡቱ አት እዶ ብቅልቱ ኬሰ ዴምቱ ነንዸገኤ፤ ዋን ቁላኮ ቱሬፍስ ነንሶዳዼ፤ ነንዾከዼስ” ጄዼን።<verse eid="GEN 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 3:11"/>እንስ፣ “ኤኙቱ አከ አት ቁላ ታቴ ስት ህሜ? ሙከ አን እጀሳ ህንኛትን ጄዼ ስ አጀጄ ሰነራ ኛቴ ሞ?” ጄዼን።<verse eid="GEN 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 3:12"/>ነምችስ፣ “ዱበርትቲ አት አከ እሼን ነ ወጅን ጅራቱፍ ና ኬንቴ ሰነቱ እጀ ሙክቻራ ና ኬኔ፤ አንስ ነንኛዼ” ጄዼ።<verse eid="GEN 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 3:13"/>
    <char style="nd">ዋቀዮ</char> ዋቅንስ ዱበርትቲዻን፣ “ወን አት ሆጄቴ ኩን ማል?” ጄዼ።</para>
  <para style="p" vid="GEN 3:13">ዱበርትቲንሞ፣ “ቦፍት ነ ጎዎምስናነን ኛዼ” ጄቴ።<verse eid="GEN 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 3:14"/>ከናፉ <char style="nd">ዋቀዮ</char> ዋቅን ቦፍቻን አከነ ጄዼ፤ “አት ሰበቢ ዋን ከነ ጎቴፍ፣</para>
  <para style="q1" vid="GEN 3:14">“ሆሪ ሁንዱማ ኬሳ፣ ብኔንሰ ሁንዱማ ኬሳስ</para>
  <para style="q2" vid="GEN 3:14">ከን አባረምቴ ንታተ!</para>
  <para style="q1" vid="GEN 3:14">በረ ጅሬኘኬቲ ጉቱ</para>
  <para style="q2" vid="GEN 3:14">ገራኬቲን ለፈረ ሎተ፤</para>
  <para style="q2" vid="GEN 3:14">ብዮሌ ንኛተ።<verse eid="GEN 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="GEN 3:15"/>ስኢፊ ዱበርትቲ፣ ሰኚኬቲፊ</para>
  <para style="q2" vid="GEN 3:15">ሰኚሼ ግዱት</para>
  <para style="q2" vid="GEN 3:15">ዲኑማ ነንኡመ፤</para>
  <para style="q1" vid="GEN 3:15">እን መታኬ ንቱመ፤</para>
  <para style="q2" vid="GEN 3:15">አትስ ኮሜሳ ንእድተ።”<verse eid="GEN 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 3:16"/>ዱበርትቲዻንስ አከነ ጄዼ፤</para>
  <para style="q1" vid="GEN 3:16">“ዮሙ አት ሙጫ ዴሱት አን ዽጵነኬ አከ መሌ ነንባይእሰ፤</para>
  <para style="q2" vid="GEN 3:16">ጭኒንሱዻንስ እጆሌ ንዴሰ።</para>
  <para style="q1" vid="GEN 3:16">ፌዺንኬ ገሩመ ዽርሰኬቲ ተአ፤</para>
  <para style="q2" vid="GEN 3:16">እንስ ስረት ኦል ኣንቱማ ቀባተ።”<verse eid="GEN 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 3:17"/>አዳሚንሞ አከነ ጄዼ፤ “ዋን አት ዱቢ ኒቲኬቲ ዸጌሴ ሙከ አን እጀሳራ፣ ‘ህንኛትን’ ጄዼራ ኛቴፍ፣</para>
  <para style="q1" vid="GEN 3:17">“ለፍት ሰበቢኬቲፍ ከን አባረምቴ ታት፤</para>
  <para style="q2" vid="GEN 3:17">አትስ በረ ጅሬኘኬቲ ጉቱ</para>
  <para style="q2" vid="GEN 3:17">ደዸቢዻን እሼራ ኛተ።<verse eid="GEN 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="GEN 3:18"/>እሼን ቆራቲፊ ሶኮሩ ስት ብቅልችት፤</para>
  <para style="q2" vid="GEN 3:18">አትስ ብቅልቱ ለፋ ንኛተ።<verse eid="GEN 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="GEN 3:19"/>አት ዋን ለፈራ አርገምቴፍ፣</para>
  <para style="q2" vid="GEN 3:19">ሀመ ለፈት ዴብቱት</para>
  <para style="q1" vid="GEN 3:19">ደፍቀ ፉለኬቲቲን ቡዴነ ኛተ፤</para>
  <para style="q2" vid="GEN 3:19">ዋን ብዮ ታቴፍስ፣</para>
  <para style="q2" vid="GEN 3:19">ገረ ብዮት ዴብተ።”<verse eid="GEN 3:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 3:20"/>አዳምስ ሰበቢ እሼን ሃዸ ጅራቶ ሁንዳ ታቴፍ ኒቲሳ “ሄዋን” ጄዼ ሞጋሴ።<verse eid="GEN 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 3:21"/>
    <char style="nd">ዋቀዮ</char> ዋቅን አዳሚፊ ሄዋኒፍ ጎጋራ ኡፈተ ሆጄቴ እሳንት ኡፍሴ። <verse eid="GEN 3:21"/><verse number="22" style="v" sid="GEN 3:22"/><char style="nd">ዋቀዮ</char> ዋቅንስ፣ “ኩኖ ነምን ዋን ጋሪፊ ዋን ሀማ ቤኩዻን ኑ ኬሳ አከ እሰ ቶኮ ተኤረ። አመስ ሀርከሳ ሂጠቴ፣ እጀ ሙከ ጅሬኛ ጭረቴ ኛቹን፣ በረ በራንስ ጅራቹን እሳፍ ኤየመሙ ህንቀቡ” ጄዼ። <verse eid="GEN 3:22"/><verse number="23" style="v" sid="GEN 3:23"/>ከናፉ <char style="nd">ዋቀዮ</char> ዋቅን ለፈ ብቅልቱ ኤዴን ኬሳ ነምቸ ባሴ አከ እን ለፉመ እራ አርገሜ ሰነ ምሶምሱ ጎዼ። <verse eid="GEN 3:23"/><verse number="24" style="v" sid="GEN 3:24"/>ኤርገ ነመ አቺ ባሴ ቦዴ ከራ ሙከ ጅሬኛት ጌሱ ኤግስሱፍ ጄዼ ኪሩቤሎታፊ ጎራዴ ቦበኡ ከን አሲፊ አች ገገረገሉ ቶኮ እዶ ብቅልቱ ኤዴኒቲን ገመ በአ ቢፍቱ ካኤ።<verse eid="GEN 3:24"/></para>
  <chapter eid="GEN 3"/>
  <chapter number="4" style="c" sid="GEN 4"/>
  <para style="s1">ቃይኒፊ አቤል</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 4:1"/>አዳም ኒቲሳ ሄዋን ብረ ገኤ፤ እሼንስ ኡልፎፍቴ ቃይንን ዴሴ። እሼንስ፣ “አን ገርጋርሰ <char style="nd">ዋቀዮቲን</char> እልመ ቶኮ አርገዼረ” ጄቴ። <verse eid="GEN 4:1"/><verse number="2" style="v" sid="GEN 4:2"/>እት ኣንስቴስ ኦቦሌሰሳ አቤልን ዴሴ።</para>
  <para style="p" vid="GEN 4:2">አቤል ትክሴ ሆሎታ ቱሬ፤ ቃይንሞ ለፈ ቆተ ቱሬ። <verse eid="GEN 4:2"/><verse number="3" style="v" sid="GEN 4:3"/>ዬሮ ሙራሰ ኬሰት ቃይን ዋን ለፍት ባፍቴፍ ኬሳ <char style="nd">ዋቀዮፍ</char> ኣርሳ ዽኤሴ። <verse eid="GEN 4:3"/><verse number="4" style="v" sid="GEN 4:4"/>አቤልሞ ሀንገፎተ ሆሎተሳ ኬሳ ጮመ ጮመሳ ዽኤሴ። <char style="nd">ዋቀዮ</char> ፋረ ቶላዻን ገረ አቤሊፊ ገረ ኣርሳ እን ዽኤሴ ሰና እላሌ። <verse eid="GEN 4:4"/><verse number="5" style="v" sid="GEN 4:5"/>ገረ ቃይኒፊ ገረ ኣርሳሳ ገሩ ህንእላሌ። ከናፉ ቃይን አከ መሌ ኣሬ ፉልሳ ጉራቸኤ።<verse eid="GEN 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 4:6"/>
    <char style="nd">ዋቀዮስ</char> ቃይኒን አከነ ጄዼ፤ “አት ማሊፍ ኣርቴ? ፉልኬስ ማሊፍ ጉራቸኤ? <verse eid="GEN 4:6"/><verse number="7" style="v" sid="GEN 4:7"/>ኡቱ ዋን ቀጄላ ሆጄቴ ስላ አት ፉዸተመ አርገተ ምቲ? ገሩ ዮ ዋን ቀጄላ ሆጄቹ ባቴ ጩቡን በልበለኬ ዱረት ርጴ ስ ኤገተ፤ ስ ቀበቹ በርባደስ፤ አት ገሩ እሰ ሞአቹ ቀብደ።”<verse eid="GEN 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 4:8"/>ቃይንስ ኤርገሲ ኦቦሌሰሳ አቤሊን፣ “ኮቱ ሜ ድሬት ባና” ጄዼ። ኡቱመ ድሬረ ጅረኑስ ቃይን ኦቦሌሰሳ አቤልት ከኤ እሰ አጄሴ።<verse eid="GEN 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 4:9"/>
    <char style="nd">ዋቀዮስ</char>፣ “ኦቦሌስኬ አቤል ኤሰ ጅረ?” ጄዼ ቃይን ጋፈቴ።</para>
  <para style="p" vid="GEN 4:9">ቃይንሞ፣ “አን ህንቤኩ፤ አን ኤግዱ ኦቦሌሰኮቲቲ?” ጄዼ ዴብሴ።<verse eid="GEN 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 4:10"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዼ፤ “አት ማል ጎቴ? ዺግን ኦቦሌሰኬቲ ለፋ ነት እያ ጅረ። <verse eid="GEN 4:10"/><verse number="11" style="v" sid="GEN 4:11"/>አት አመ አባረማዸ፤ ለፈ ዺገ ኦቦሌሰኬቲ ስ ሀርካ ፉዸቹፍ አፋን በነቴራስ ንአርአምተ። <verse eid="GEN 4:11"/><verse number="12" style="v" sid="GEN 4:12"/>ዬሮ አት ለፈ ቆተቱት ለፍት ዴብቴ ምዻን ሲፍ ህንኬንቱ። አት ለፈረት ጆርቱ ቦቆና ህንቀብኔ ታተ።”<verse eid="GEN 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 4:13"/>ቃይንሞ <char style="nd">ዋቀዮን</char> አከነ ጄዼ፤ “አደበሙንኮ ዋን አን ባቹ ደንደኡን ኦል። <verse eid="GEN 4:13"/><verse number="14" style="v" sid="GEN 4:14"/>ኩኖ አት ሀርአ ብያ ነ አርኣ ጅርተ፤ አንስ ፉለኬ ዱራ ነንዾከዸ፤ ለፈረት ጆርቱ ቦቆና ህንቀብኔ ነንተአ፤ ነምን ነ አርገቱ ከምዩስ ነ አጄሰ።”<verse eid="GEN 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 4:15"/>
    <char style="nd">ዋቀዮ</char> ገሩ፣ “አከነ ምት፤ ነምን ቃይንን አጄሱ ከምዩ ደቻ ቶርበ ሃሎ ባፈመ” ጄዼን። <char style="nd">ዋቀዮስ</char> አከ ነምን እሰ አርገቱ ቶኮዩ እሰ ህንአጄፍኔፍ ቃይንት መለቶ ጎዼ። <verse eid="GEN 4:15"/><verse number="16" style="v" sid="GEN 4:16"/>ኤርገሲስ ቃይን ፉለ <char style="nd">ዋቀዮ</char> ዱራ በኤ ኤዴንራ ከራ በአ ቢፍቱቲን ብየ ኖድ ኬሰ ጅራቴ።<verse eid="GEN 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 4:17"/>ቃይን ኒቲሳ ቤኬ፤ እሼንስ ኡልፎፍቴ ሄኖክን ዴሴ። ቃይንስ መጋላ ቶኮ ሁንዴሴ፤ መጋላ ሰነስ ሄኖክ ጄዼ መቃ እልመሳቲን ዋሜ። <verse eid="GEN 4:17"/><verse number="18" style="v" sid="GEN 4:18"/>ሄኖክ ኢራድን ዸልቼ፤ ኢራድ ሜኤልን ዸልቼ፤ ሜሁያኤል መቱሳኤልን ዸልቼ፤ መቱሳኤልሞ ላሜህን ዸልቼ።<verse eid="GEN 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 4:19"/>ላሜህ ዱበርቶተ መቃንሳኒ ኣዳፊ ጢላ ጄዸሙ ለማን ፉዼ። <verse eid="GEN 4:19"/><verse number="20" style="v" sid="GEN 4:20"/>ኣዳን ያባልን ዴሴ፤ ያባልስ አባ ወረ ዱንካነ ኬሰ ጅራተኒ ሆሪ ሆርሲሰኒ ቱሬ። <verse eid="GEN 4:20"/><verse number="21" style="v" sid="GEN 4:21"/>መቃን ኦቦሌሰሳ ዩባል ቱሬ፤ እንሞ አባ ወረ ክራረ ሩኩተኒቲፊ ኡሉሌ አፉፈኒት። <verse eid="GEN 4:21"/><verse number="22" style="v" sid="GEN 4:22"/>ጢላንሞ እልመ ቱባል ቃይን ጄዸሙ ከን ናሲፊ ስቢለ ቱሜ ሜሻወን ገራ ገራ ሆጄቱ ዴሴ፤ ኦቦሌቲን ቱባል ቃይንስ ነአማ ቱርቴ።<verse eid="GEN 4:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 4:23"/>ላሜህ ኒቶተሳቲን አከነ ጄዼ፤</para>
  <para style="q1" vid="GEN 4:23">“ኣዳፊ ጢላን ነ ዸገኣ፤</para>
  <para style="q2" vid="GEN 4:23">ያ ኒቶተ ላሜሂ ዱቢኮ ዸጌፈዻ።</para>
  <para style="q1" vid="GEN 4:23">ነመ ቶኮ ዋን እን ነ መዴሴፍ፣</para>
  <para style="q2" vid="GEN 4:23">ደርገጌሰ ቶኮ ዋን እን ነ ሚዼፍ አን እሰ አጄሴረ።<verse eid="GEN 4:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="GEN 4:24"/>ዮ ቃይኒፍ ደቻ ቶርበ ሃሎን ባፈሜ</para>
  <para style="q2" vid="GEN 4:24">ላሜሂፍሞ ደቻ ቶርባተሚ ቶርበ ንባፈመ።”<verse eid="GEN 4:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 4:25"/>አዳም አመስ ኒቲሳ ቤኬ፤ እሼንስ እልመ ዴሴ፤ መቃሳስ፣ “ኤርገ ቃይን አቤልን አጄሴ አስ ዋቅን እዶ አቤል ዳእመ ብራ ና ኬኔረ” ጄቴ “ሴት” ጄቴ ሞጋፍቴ። <verse eid="GEN 4:25"/><verse number="26" style="v" sid="GEN 4:26"/>ሴቲፍስ እልም ንዸለቴ፤ እንስ ኤኖሽ ጄዼ እሰ ሞጋሴ።</para>
  <para style="p" vid="GEN 4:26">በረ ሰነ ነሞትን መቃ <char style="nd">ዋቀዮ</char> ዋመቹ ጀልቀበን።<verse eid="GEN 4:26"/></para>
  <chapter eid="GEN 4"/>
  <chapter number="5" style="c" sid="GEN 5"/>
  <para style="s1">አዳሚ ጀልቀቤ ሀመ ኖሂት</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 5:1"/>ኩን ገልሜ ሰኚ አዳም።</para>
  <para style="b" vid="GEN 5:1"/>
  <para style="p" vid="GEN 5:1">ዋቅን ዬሮ ነመ ኡሜት አከ ፈኬኘ ዋቃት እሰ ቶልቼ። <verse eid="GEN 5:1"/><verse number="2" style="v" sid="GEN 5:2"/>እንስ ዺራፊ ዱበርቲ ታስሴ እሳን ኡሜ፤ እሳን ኤብሴስ። ዬሮ ኡመመንስ “ነመ” ጄዼ እሳን ዋሜ።<verse eid="GEN 5:2"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="3" style="v" sid="GEN 5:3"/>አዳም ወጋ 130 ጅራቴ፤ እንስ አከ ፈካቲሳት፣ አከ ብፈ እሳትስ እልመ ዸልቼ ሴት ጄዼ መቃ ባሴፍ። <verse eid="GEN 5:3"/><verse number="4" style="v" sid="GEN 5:4"/>አዳም ኤርገ ሴት ዸለቴ ቦዴ ወጋ 800 ጅራቴ፤ እንስ እልማኒፊ እንተለን ብራ ዸልቼ። <verse eid="GEN 5:4"/><verse number="5" style="v" sid="GEN 5:5"/>ወሉመት አዳም ወጋ 930 ጅራቴ ዱኤ።<verse eid="GEN 5:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="GEN 5:6"/>ሴት ወጋ 105 ጅራቴ ኤኖሽን ዸልቼ። <verse eid="GEN 5:6"/><verse number="7" style="v" sid="GEN 5:7"/>ኤርገ ኤኖሽን ዸልቼ ቦዴስ ሴት ወጋ 807 ጅራቴ፤ እንስ እልማኒፊ እንተለን ብራ ዸልቼ። <verse eid="GEN 5:7"/><verse number="8" style="v" sid="GEN 5:8"/>ወሉመት ሴት ወጋ 912 ጅራቴ ዱኤ።<verse eid="GEN 5:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="GEN 5:9"/>ኤኖሽ ወጋ 90 ጅራቴ ቄናንን ዸልቼ። <verse eid="GEN 5:9"/><verse number="10" style="v" sid="GEN 5:10"/>ኤርገ ቄናንን ዸልቼ ቦዴስ ኤኖሽ ወጋ 815 ጅራቴ፤ እንስ እልማኒፊ እንተለን ብራ ዸልቼ። <verse eid="GEN 5:10"/><verse number="11" style="v" sid="GEN 5:11"/>ወሉመት ኤኖሽ ወጋ 905 ጅራቴ ዱኤ።<verse eid="GEN 5:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="GEN 5:12"/>ቄናን ወጋ 70 ጅራቴ መሀለሌሊን ዸልቼ። <verse eid="GEN 5:12"/><verse number="13" style="v" sid="GEN 5:13"/>ኤርገ መሀለሌሊን ዸልቼ ቦዴ ቄናን ወጋ 840 ጅራቴ፤ እንስ እልማኒፊ እንተለን ብራ ዸልቼ። <verse eid="GEN 5:13"/><verse number="14" style="v" sid="GEN 5:14"/>ወሉመት ቄናን ወጋ 910 ጅራቴ ዱኤ።<verse eid="GEN 5:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="GEN 5:15"/>መሀለሌል ወጋ 65 ጅራቴ ያሬድን ዸልቼ። <verse eid="GEN 5:15"/><verse number="16" style="v" sid="GEN 5:16"/>ኤርገ ያሬድን ዸልቼ ቦዴ መሀለሌል ወጋ 830 ጅራቴ፤ እንስ እልማኒፊ እንተለን ብራ ዸልቼ። <verse eid="GEN 5:16"/><verse number="17" style="v" sid="GEN 5:17"/>ወሉመት መሀለሌል ወጋ 895 ጅራቴ ዱኤ።<verse eid="GEN 5:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="GEN 5:18"/>ያሬድ ወጋ 162 ጅራቴ ሄኖክን ዸልቼ። <verse eid="GEN 5:18"/><verse number="19" style="v" sid="GEN 5:19"/>ኤርገ ሄኖክን ዸልቼ ቦዴ ያሬድ ወጋ 800 ጅራቴ፤ እንስ እልማኒፊ እንተለን ብራ ቀበ ቱሬ። <verse eid="GEN 5:19"/><verse number="20" style="v" sid="GEN 5:20"/>ወሉመት ያሬድ ወጋ 962 ጅራቴ ዱኤ።<verse eid="GEN 5:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="GEN 5:21"/>ሄኖክ ወጋ 65 ጅራቴ መቱሴላ ዸልቼ። <verse eid="GEN 5:21"/><verse number="22" style="v" sid="GEN 5:22"/>ሄኖክ ኤርገ መቱሴላ ዸልቼ ቦዴ ወጋ 300 ዋቀ ወጅን ዴዴብኤ፤ እንስ እልማኒፊ እንተለን ብራ ዸልቼ። <verse eid="GEN 5:22"/><verse number="23" style="v" sid="GEN 5:23"/>ወሉመት ሄኖክ ወጋ 365 ጅራቴ። <verse eid="GEN 5:23"/><verse number="24" style="v" sid="GEN 5:24"/>ሄኖክ ዋቀ ወጅን ዴዴብኤ፤ ዋን ዋቅን እሰ ፉዸቴፍ እን ዴብኤ ህንአርገምኔ።<verse eid="GEN 5:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="GEN 5:25"/>መቱሴላን ወጋ 187 ጅራቴ ላሜህን ዸልቼ። <verse eid="GEN 5:25"/><verse number="26" style="v" sid="GEN 5:26"/>ኤርገ ላሜህን ዸልቼ ቦዴ መቱሴላን ወጋ 782 ጅራቴ፤ እንስ እልማኒፊ እንተለን ብራ ዸልቼ። <verse eid="GEN 5:26"/><verse number="27" style="v" sid="GEN 5:27"/>ወሉመት መቱሴላን ወጋ 969 ጅራቴ ዱኤ።<verse eid="GEN 5:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="GEN 5:28"/>ላሜህ ወጋ 182 ጅራቴ እልመ ዸልቼ። <verse eid="GEN 5:28"/><verse number="29" style="v" sid="GEN 5:29"/>እንስ፣ “ሆጂ ኑ ለፈ <char style="nd">ዋቀዮ</char> አባሬ ከነረት ሆጄትኑፊ ደዸቢ ሀርከኬኛ ከነ ኬሰት ኑ ጀጀቤሰ” ጄቹዻን መቃሳ ኖህ ጄዼ ሞጋሴ። <verse eid="GEN 5:29"/><verse number="30" style="v" sid="GEN 5:30"/>ላሜህ ኤርገ ኖህን ዸልቼ ቦዴ ወጋ 595 ጅራቴ፤ እንስ እልማኒፊ እንተለን ብራ ዸልቼ። <verse eid="GEN 5:30"/><verse number="31" style="v" sid="GEN 5:31"/>ወሉመት ላሜህ 777 ጅራቴ ዱኤ።<verse eid="GEN 5:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="GEN 5:32"/>ኖህ ኤርገ ወጋ 500 ጅራቴ ቦዴ ሴም፣ ሃሚፊ ያፌትን ዸልቼ።<verse eid="GEN 5:32"/></para>
  <chapter eid="GEN 5"/>
  <chapter number="6" style="c" sid="GEN 6"/>
  <para style="s1">ብሻን በዲሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 6:1"/>ዬሮ ነሞትን ብየ ለፋረት ባይአቹ ጀልቀበኒ እንተለን ዸለተኒፍት፣ <verse eid="GEN 6:1"/><verse number="2" style="v" sid="GEN 6:2"/>እልማን ዋቃ አከ እንተለን ነሞታ በበሬዶ ተአን አርገን፤ እሳን ኬሳስ አቡመ ፍለተን ፉዸን። <verse eid="GEN 6:2"/><verse number="3" style="v" sid="GEN 6:3"/>ዮሙስ <char style="nd">ዋቀዮ</char>፣ “ነምን ዋን ፎን ተኤፍ ሀፉርኮ በረ በራን እሰ ኬሰ ህንጅራቱ፤ በር ጅሬኘሳስ ወጋ ዽበ ቶኮፊ ድግደመ ተአ” ጄዼ።<verse eid="GEN 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 6:4"/>በረ ሰናፊ ኤርገሲስ ኔፊሊሞትን ለፈረ ቱረን፤ እልማን ዋቃስ ዮሙ ገረ እንተለን ነማ ዸቀንት እጆሌ ዸልቸን። እሳንስ ጎቶተ ዱሪ ወረ ቤከሞ ቱረን።<verse eid="GEN 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 6:5"/>
    <char style="nd">ዋቀዮስ</char> አከ ጀልእን ነማ ለፈረት ባይአቴ፣ ወን ነምን ዬሮ ሁንደ ገራሳት ያዱ ሁንድኑስ ጀልኣ ቆፈ ተኤ አርጌ። <verse eid="GEN 6:5"/><verse number="6" style="v" sid="GEN 6:6"/><char style="nd">ዋቀዮስ</char> ዋን ለፈረት ነመ ኡሜፍ ንጋቤ፤ ገራንሳስ ንገዴ። <verse eid="GEN 6:6"/><verse number="7" style="v" sid="GEN 6:7"/>ከናፉ <char style="nd">ዋቀዮ</char>፣ “አን ሰኚ ነማ ከን ኦፊኮቲን ኡሜ ለፈራ ነንበሌሰ። ነማፊ ሆሪ፣ ኡመመ ለፈረ ሙኙቁ፣ ስምብሮተ ሰሚ ነንበሌሰ፤ አን እሳን ኡሙኮት ጋቤራቲ” ጄዼ። <verse eid="GEN 6:7"/><verse number="8" style="v" sid="GEN 6:8"/>ኖህ ገሩ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ሱራ አርገቴ።<verse eid="GEN 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 6:9"/>ሴናን ኖሂፊ ማቲሳ ከናዸ።</para>
  <para style="b" vid="GEN 6:9"/>
  <para style="p" vid="GEN 6:9">ኖህ ነሞተ በረሳ ቱረን ግዱት ነመ ቀጄላ፣ ነመ ህርእነ ህንቀብኔ ከን ዋቀ ወጅን ዴዴብኡ ቱሬ። <verse eid="GEN 6:9"/><verse number="10" style="v" sid="GEN 6:10"/>ኖህ እልማን ሰዲ ዸልቼ፤ እሳንስ፦ ሴም፣ ሃሚፊ ያፌት።<verse eid="GEN 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 6:11"/>ለፍት ፉለ ዋቃ ዱረት ፋለምቴ ጄቁምሳን ጉተምቴ ቱርቴ። <verse eid="GEN 6:11"/><verse number="12" style="v" sid="GEN 6:12"/>ሰበቢ ነሞትን ለፈራ ሁንድኑ ከራሳኒ ፋለኒፍ፣ ዋቅን አከ ለፍት ፋለምቴ አርጌ። <verse eid="GEN 6:12"/><verse number="13" style="v" sid="GEN 6:13"/>ከናፉ ዋቅን ኖሂን አከነ ጄዼ፤ “ዋን ለፍት ሰበቢሳኒቲን ጄቁምሳን ጉተምቴፍ፣ አን ነመ ሁንደ ነንበሌሰ፤ ኩኖ አን ዹጉማን ለፋፊ እሳን ነንበርበዴሰ። <verse eid="GEN 6:13"/><verse number="14" style="v" sid="GEN 6:14"/>አት ሙከ ጎፈርራ ዶኒ ቶልፈዹ፤ ኬሰ እሳትስ ኩታ ገራ ገራ ቆጴስ፤ ኬሳፊ ዱበሳስ ሀጴዻን ዱች። <verse eid="GEN 6:14"/><verse number="15" style="v" sid="GEN 6:15"/>ሃል አት እቲን ዶንቸ ቶልችቱ ከናዸ፤ ዼርነሳ ዹንዹመ ዽባ ሰዲ፣ በልእነሳ ዹንዹመ ሸንተመ፣ ኦል ዼርነሳ ዹንዹመ ሶዶመ ጎዽ። <verse eid="GEN 6:15"/><verse number="16" style="v" sid="GEN 6:16"/>ዶንቻፍ በንቲ ዹንዹመ ቶኮ ኦል ከኡ ሆጄዹ፤ ጭናቸሳረትስ በልበለ ባስ፤ ከነስ አባ ደርቢ ሰዲ ጄቹንስ ከን ገዲ፣ ከን ግዱቲፊ ከን ጉባ ጎዺ ሆጄዹ። <verse eid="GEN 6:16"/><verse number="17" style="v" sid="GEN 6:17"/>ኩኖ፣ አን ኡመመወን ሉቡ ቀቤዪ ሁንደ ሰሚ ጀላ በሌሱፍ ብሻን በዲሳ ለፈት ነንፍደ፤ ወን ለፈረ ጅራቱ ሁንድኑስ ንበደ። <verse eid="GEN 6:17"/><verse number="18" style="v" sid="GEN 6:18"/>ስ ወጅን ገሩ ከኩ ነንገለ፤ አትስ ዶኒ ሴንተ፤ አቲፊ እልማንኬ፣ ኒቲንኬቲፊ ኒቶትን እልማንኬቲስ ንሴንቱ። <verse eid="GEN 6:18"/><verse number="19" style="v" sid="GEN 6:19"/>ኡመመወን ሉቡ ቀቤዪ ሁንዱማ ኬሳ አከ እሳን ስ ወጅን ጅራተኒፍ ለመ ለመ፣ ኮርማፊ ዸላ ዶንቸት ገልች። <verse eid="GEN 6:19"/><verse number="20" style="v" sid="GEN 6:20"/>ስምብሮተ ኬሳ አኩመ ጎሰ ጎሰሳኒት፣ ሆሪ ኬሳ አኩመ ጎሰ ጎሰሳኒት፣ ኡመመወን ለፈረ ሙኙቀን ኬሳስ አኩመ ጎሰ ጎሰሳኒት፣ ለመ ለመ ተአኒ ጅራቹፍ ገረኬ ዹፉ። <verse eid="GEN 6:20"/><verse number="21" style="v" sid="GEN 6:21"/>ዋን ኛተሙ ሁንደ ኬሳ ዋ ፉዺ ኦፍ ብረት ወልት ቀብ! ኩንስ ኛተኬቲፊ ኛተሳኒ ንተአ።”<verse eid="GEN 6:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 6:22"/>ኖህ አኩመ ዋቅን እሰ አጀጄት ዋን ሁንደ ሆጄቴ።<verse eid="GEN 6:22"/></para>
  <chapter eid="GEN 6"/>
  <chapter number="7" style="c" sid="GEN 7"/>
  <para style="p">
    <verse number="1" style="v" sid="GEN 7:1"/>
    <char style="nd">ዋቀዮስ</char> ኖሂን አከነ ጄዼ፤ “አን አከ አት ዸሎተ ከነ ኬሳ ነ ዱረት ቀጄላ ታቴ አርጌራቲ ማቲኬ ሁንዱማ ወጅን ዶንቸ ሴን። <verse eid="GEN 7:1"/><verse number="2" style="v" sid="GEN 7:2"/>ብኔንሰ ቁልቁሉ ጎሰ ሁንደ ኬሳ ኮርማፊ ዸላ ጭምዲ ቶርበ፣ ብኔንሰ ቁልቁሉ ህንተእን ጎሰ ሁንደ ኬሳ ጭምዲ ቶኮ፣ <verse eid="GEN 7:2"/><verse number="3" style="v" sid="GEN 7:3"/>ጎሰ ስምብሮታ ሁንደ ኬሳሌ አከ ሰኚን ለፈ ሁንደረት ሀፌ ጅራቱፍ ኮርማፊ ዸላ ጭምዲ ቶርበ ፉዸዹ ሴን። <verse eid="GEN 7:3"/><verse number="4" style="v" sid="GEN 7:4"/>አን ጉያ ቶርበ ቦዴ ሀልከን አፉርተማፊ ጉያ አፉርተመ ቦካ ነንሮብሰ፤ ኡመመ ጅራታ አን መታንኮ ኡሜ ሁንደ ለፈራ ነንሀጣአ።”<verse eid="GEN 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 7:5"/>ኖህስ ዋን <char style="nd">ዋቀዮ</char> እሰ አጀጄ ሁንደ ንሆጄቴ።<verse eid="GEN 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 7:6"/>ዬሮ ብሻን በዲሳ ዹፌት ኖህ ነመ ወጋ ዽበ ጀአ ቱሬ። <verse eid="GEN 7:6"/><verse number="7" style="v" sid="GEN 7:7"/>ኖሂፊ እልማንሳ፣ ኒቲሳቲፊ ኒቶትን እልማንሳ ብሻን በዲሳ ጀላ በኡፍ ዶኒ ሴነን። <verse eid="GEN 7:7"/><verse number="8" style="v" sid="GEN 7:8"/>ብኔንሶትን ቁልቁሉፊ ከን ቁልቁሉ ህንተእን፣ ስምብሮትኒፊ ኡመመወን ለፈረ ሙኙቀን ሁንድ፣ ጭምዲ ጭምዲዻን፣ <verse eid="GEN 7:8"/><verse number="9" style="v" sid="GEN 7:9"/>ኮርማፊ ዸላን ገረ ኖህ ዹፈኒ አኩመ ዋቅን ኖሂን አጀጄት ዶንቸ ሴነን። <verse eid="GEN 7:9"/><verse number="10" style="v" sid="GEN 7:10"/>ጉያ ቶርበ ቦዴ ብሻን በዲሳ ሎለኤ ለፈ ጉቴ።<verse eid="GEN 7:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 7:11"/>በረ ጅሬኘ ኖህ ወጋ ዽበ ጀአፋ ኬሰ፣ ጅአ ለመፋት፣ ጅአ ሰነ ኬሳስ ጉያ ኩዸ ቶርበፋት ቡርቃወን ቱጁበ ጉርጉዳ ሁንድ ንዾአን፤ ፎዳወን ብሻን ሰሚስ ንበነመን። <verse eid="GEN 7:11"/><verse number="12" style="v" sid="GEN 7:12"/>ቦካንስ ጉያ አፉርተማፊ ሀልከን አፉርተመ ለፈት ሮቤ።<verse eid="GEN 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 7:13"/>ጉዩመ ሰነ ኖሂፊ እልማንሳ፣ ሴም፣ ሃሚፊ ያፌት፣ ኒቲሳቲፊ ኒቶተ እልማንሳ ሰደኒ ወጅን ዶንቸ ሴነን። <verse eid="GEN 7:13"/><verse number="14" style="v" sid="GEN 7:14"/>እሳንስ ብኔንሶተ ሁንደ፣ አኩመ ጎሰሳኒት፣ ሆሪ ሁንደ አኩመ ጎሰሳኒት፣ ኡመመወን ለፈረ ሙኙቀን ሁንዳፊ ስምብሮተ ሁንደ አኩመ ጎሰሳኒት፣ ዋን ቆቾ ቀቡ ሁንደስ ኦፍ ፋነ ፉዸተኒ ሴነን። <verse eid="GEN 7:14"/><verse number="15" style="v" sid="GEN 7:15"/>ኡመመወን ሀፉረ ጅሬኛ ኦፍ ኬሳ ቀበን ሁንድኑስ ጭምዲ ጭምዲዻን ገረ ኖህ ዹፈኒ ዶንቸ ሴነን። <verse eid="GEN 7:15"/><verse number="16" style="v" sid="GEN 7:16"/>ብኔንሶትን አኩመ ዋቅን ኖህን አጀጄት ዶኒት ገለን ኮርማፊ ዸላ ኡመመወን ሉቡ ቀቤዪ ሁንዳ ቱረን፤ ኤርገሲሞ <char style="nd">ዋቀዮ</char> አላን እት ጩፌ።<verse eid="GEN 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 7:17"/>ብሻን በዲሳስ እቱመ ፉፌ ጉያ አፉርተማፍ ለፈረ ቱሬ፤ ብሻን ሱንስ ደበላ ዴሜ ዶኒ ሰነ ለፈራ ኦል ካሴ። <verse eid="GEN 7:17"/><verse number="18" style="v" sid="GEN 7:18"/>ብሻንችስ ኦል ከኤ ለፈረት አከ መሌ ባይአቴ፤ ዶኒን ሱንስ ብሻንቸረ ዴሜ። <verse eid="GEN 7:18"/><verse number="19" style="v" sid="GEN 7:19"/>ብሻንችስ አከ መሌ ኦል ከኣ ዴሜ ቱሉወን ሰሚ ጀለ ጅረን ሁንደ ሀጉጌ። <verse eid="GEN 7:19"/><verse number="20" style="v" sid="GEN 7:20"/>ብሻንች ዹንዹመ ኩዸ ሸን ጫላ ኦል ከኡዻን ቱሉወን ዾክሴ። <verse eid="GEN 7:20"/><verse number="21" style="v" sid="GEN 7:21"/>ኡመመወን ሉቡ ቀቤዪን ለፈረ ጅራተን ሁንድ ጄቹንስ፣ ስምብሮትን፣ ሆሪን፣ ብኔንሶትን፣ ኡመመወን ለፈረ ሙኙቀን ሁንዲፊ ነሞትን ሁንድ ንበርበዳአን። <verse eid="GEN 7:21"/><verse number="22" style="v" sid="GEN 7:22"/>ወን ለፈ ጎጋረ ጅራቱ ከን ፉኛንሳቲን ሀፉረ ጅሬኛ ባፈቱ ሁንድኑ ንዱኤ። <verse eid="GEN 7:22"/><verse number="23" style="v" sid="GEN 7:23"/>ኡመመወን ሉቡ ቀቤዪን ለፈረ ጅራተን ሁንድኑ ንሀጣአመን፤ ነምኒፊ ሆሪን፣ ኡመመወን ለፈረ ሙኙቀኒፊ ስምብሮትን ሰሚ፣ ለፈራ ንሀጣአመን። ኖሂፊ ወረ እሰ ወጅን ዶኒ ኬሰ ቱረን ቆፈቱ ሀፌ።<verse eid="GEN 7:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 7:24"/>ብሻን ሱንስ ቡልቲ ዽበ ቶኮፊ ሸንተመ ለፈረ ሎለኤ።<verse eid="GEN 7:24"/></para>
  <chapter eid="GEN 7"/>
  <chapter number="8" style="c" sid="GEN 8"/>
  <para style="p">
    <verse number="1" style="v" sid="GEN 8:1"/>ዋቅን ገሩ ኖህን፣ ብኔንሶታፊ ሆሪ እሰ ወጅን ዶኒ ኬሰ ቱረን ሁንደ ያደቴ። እንስ ቡቤ ለፈት ኤርጌ፤ ብሻንችስ ገድ ገሌ። <verse eid="GEN 8:1"/><verse number="2" style="v" sid="GEN 8:2"/>ቡርቃወን ቱጁበወኒቲፊ ፎዳወን ሰሚወኒ ንጩፈመን፤ ቦካን ሰሚ ኬሳ ገድ ሮቡስ ንጫሜ። <verse eid="GEN 8:2"/><verse number="3" style="v" sid="GEN 8:3"/>ብሻን ሱንስ ሱቱመ ሱተ ለፈራ ህርአቻ ዴሜ ዹመ ቡልቲ ዽበ ቶኮፊ ሸንተማት ገድ ቡኤ። <verse eid="GEN 8:3"/><verse number="4" style="v" sid="GEN 8:4"/>ዶኒን ሱንስ ጉያ ኩዸ ቶርበፋ ጅአ ቶርበፋት ቱሉ አራራት ጉባ ቁበቴ። <verse eid="GEN 8:4"/><verse number="5" style="v" sid="GEN 8:5"/>ብሻንች ሀመ ጅአ ኩርነፋት ገዱመ ገላ ዴሜ። ጉያ ጀልቀበ ጅአ ኩርነፋትስ መታወን ቱሉወኒ ሙልአተን።<verse eid="GEN 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 8:6"/>ጉያ አፉርተመ ቦዴ ኖህ ፎዳ ዶኒት ባሴ ቱሬ ሰነ በኔ፤ <verse eid="GEN 8:6"/><verse number="7" style="v" sid="GEN 8:7"/>እንስ አራጌሰ ቶኮ ገድ ዺሴ፤ አራጌስ ሱንስ ሀመ ብሻንች ለፈራ ጎጉት አሲፊ አች ዴዴብኣ ቱሬ። <verse eid="GEN 8:7"/><verse number="8" style="v" sid="GEN 8:8"/>ኤርገሲሞ አከ ብሻንች ለፈራ ህርአቴ ሁበቹፍ ጉጌ ቶኮ ኤርጌ። <verse eid="GEN 8:8"/><verse number="9" style="v" sid="GEN 8:9"/>ገሩ ሰበቢ ብሻን ለፈ ሁንደረ ጉቴ ጅሩፍ ጉጌን ሱን እዶ ቁበቱ ዸብዴ ገረ ኖህ ዶኒት ዴብቴ። እንስ ሀርከሳ ገድ ሂጠቴ ጉጌ ሰነ ገረ ዶኒት እዶ ኦፊ ጅሩት ኦል ገልቼ። <verse eid="GEN 8:9"/><verse number="10" style="v" sid="GEN 8:10"/>አመስ ጉያ ቶርበ ቱሬ ጉጌ ሰነ ዶኒ ኬሳ ገድ ባሴ ኤርጌ። <verse eid="GEN 8:10"/><verse number="11" style="v" sid="GEN 8:11"/>ጉጌን ሱንስ ገልገለ ዮሙ ገረሳት ዴብቴት ኩኖ፣ ባለ ኤጄርሳ ከን አመ ኩተሜ አፋንት ቀበቴ ቱርቴ። ከናንስ ኖህ አከ ብሻንች ገድ ህርአቴ ቤኬ። <verse eid="GEN 8:11"/><verse number="12" style="v" sid="GEN 8:12"/>አመስ ጉያ ብራ ቶርበ ቱሬ ጉጌ ሰነ ዴብሴ ኤርጌ፤ ጉጌን ሱን ገሩ ለመተ ገረሳት ህንዴብኔ።<verse eid="GEN 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 8:13"/>ኡሙሪ ኖሂ ወጋ ዽበ ጀኣፊ ቶኮፋት፣ ጉያ ቶኮፋ ጅአ ጀልቀባት፣ ብሻንች ለፈራ ጎጌ። ኖህስ ቀዳደ ዶኒ ሰናራ ፉዼ እላሌ ኩኖ አከ ለፍት ጎግዴ አርጌ። <verse eid="GEN 8:13"/><verse number="14" style="v" sid="GEN 8:14"/>ጉያ ድግደሚ ቶርበፋ ጅአ ለመፋት ለፍት ጉቱማን ጉቱት ጎግዴ።<verse eid="GEN 8:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 8:15"/>ዋቅንስ ኖሂን አከነ ጄዼ፤ <verse eid="GEN 8:15"/><verse number="16" style="v" sid="GEN 8:16"/>“አቲፊ ኒቲንኬ፣ እልማንኬቲፊ ኒቶትን እልማንኬቲ ኮታ ዶኒ ኬሳ በኣ። <verse eid="GEN 8:16"/><verse number="17" style="v" sid="GEN 8:17"/>አከ እሳን ለፈረት ባይአተኒፍ፣ አከ እሳን ሆረኒ ለፈረት ባይአተኒፍ፣ ጎሰ ኡመመወን ሉቡ ቀቤዪ ስ ወጅን ጅረን ሁንደ ጄቹንስ ስምብሮተ፣ ብኔንሶታፊ ኡመመወን ለፈረ ሙኙቀን ሁንደ ገድ ባስ።”<verse eid="GEN 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 8:18"/>ከናፉ ኖህ እልማንሳቲፊ ኒቲሳ፣ ኒቶተ እልማንሳ ወጅን ገድ በኤ። <verse eid="GEN 8:18"/><verse number="19" style="v" sid="GEN 8:19"/>ብኔንሶትን ሁንዲፊ ኡመመወን ለፈረ ሙኙቀን ሁንድኑ፣ ስምብሮትን ሁንድ ጄቹንስ ወን ለፈረ ጅራቱ ሁንድ ጎሱመ ጎሳን ዶኒ ሰነ ኬሳ ገድ በአን።<verse eid="GEN 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 8:20"/>ኖህስ <char style="nd">ዋቀዮፍ</char> እዶ ኣርሳ እጃሬ፤ ሆሪፊ ስምብሮተ ቁልቁሉ ሁንደ ኬሳ ፉዼ እዶ ኣርሳ ሰነረት ኣርሳ ጉበሙ ዽኤሴ። <verse eid="GEN 8:20"/><verse number="21" style="v" sid="GEN 8:21"/><char style="nd">ዋቀዮስ</char> ፎሊ ቶላ ሰነ ኡርጌፈቴ ገራሳ ኬሰት አከነ ጄዼ፤ “ዮ ወን ነምን እጆሉማሳቲ ጀልቀቤ ገራሳት ያዱ ሀምነ ተኤሌ አን ሰበቢ ነማቲፍ ጄዼ ለመተ ለፈ ህንአባሩ። አን አከን ከናን ዱረ ጎዼ ሰነ ዴብኤ ኡመመወን ጅራቶ ሁንደ ህንበሌሱ።<verse eid="GEN 8:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="GEN 8:22"/>“ሀመ ለፍት ጅርቱት፣</para>
  <para style="q1" vid="GEN 8:22">ምዻን ፈጫሱፊ ወልት ቀቡን፣</para>
  <para style="q1" vid="GEN 8:22">ዻሞቺፊ ሆእ፣</para>
  <para style="q1" vid="GEN 8:22">ቦኒፊ ገን፣</para>
  <para style="q1" vid="GEN 8:22">ሀልከኒፊ ጉያን</para>
  <para style="q1" vid="GEN 8:22">ጎንኩማ ህንሀፈን።”<verse eid="GEN 8:22"/></para>
  <chapter eid="GEN 8"/>
  <chapter number="9" style="c" sid="GEN 9"/>
  <para style="s1">ከኩ ዋቅን ኖህ ወጅን ገሌ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 9:1"/>ዋቅን አከነ ጄዼ ኖሂፊ እልማንሳ ኤብሴ፤ “ሆራ፣ ባይአዻ፣ ለፈስ ጉታ። <verse eid="GEN 9:1"/><verse number="2" style="v" sid="GEN 9:2"/>ሶዳችሱፊ ናስሱንኬሰን ብኔንሶተ ለፋ ሁንዱማፊ ስምብሮተ ሰሚ ሁንዱማ፣ ኡመመወን ለፈረ ሙኙቀን ሁንዱማፊ ቁርጡሚወን ገላና ሁንዱማረ ሃቡኡ፤ እሳን ሀርከኬሰንት ኬነመኒሩ። <verse eid="GEN 9:2"/><verse number="3" style="v" sid="GEN 9:3"/>ወን ጅራቱፊ ወን ሙኙቁ ሁንድ ኛተ እስኒፍ ንተአ። አን አኩመን ብቅለ ለልሳ እስኒ ኬኔ ሰነ አመስ ዋን ሁንደ እስኒፍ ነንኬነ።<verse eid="GEN 9:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 9:4"/>“እስን ገሩ ፎን ሉቡሳ ወጅን ጄቹንስ ዺገሳ ወጅን ህንኛትና። <verse eid="GEN 9:4"/><verse number="5" style="v" sid="GEN 9:5"/>አን ዹጉማን ዺገኬሰን ከን ሉቡንኬሰን ኬሰ ጅርቱ ነንበርባደ። ብኔንሰ ሁንደራ ነንበርባደ። ኦቦሌሰ ነመ ሁንዳራስ ሉቡ ነማ ነንበርባደ።<verse eid="GEN 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="GEN 9:6"/>“ነመ ዺገ ነማ ዸንገላሱ፣</para>
  <para style="q2" vid="GEN 9:6">ዺግንሳ ሀርከ ነማቲን ዸንገላፈመ፤</para>
  <para style="q1" vid="GEN 9:6">ዋቅን ብፈ ዋቃቲን</para>
  <para style="q2" vid="GEN 9:6">ነመ ኡሜቲ።<verse eid="GEN 9:6"/></para>
  <para style="m">
    <verse number="7" style="v" sid="GEN 9:7"/>እስንስ ሆራ፣ ባይአዻ፤ ለፈ ጉታ፣ እረትስ ባይአዻ።”<verse eid="GEN 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 9:8"/>ኤርገሲ ዋቅን ኖሂፊ እልማንሳ ወረ እሳ ወጅን ቱረኒን አከነ ጄዼ፤ <verse eid="GEN 9:8"/><verse number="9" style="v" sid="GEN 9:9"/>“ኩኖ አን እስኒፊ ሰኚኬሰን ወረ እስን ቦዴ ወጅን ከኩኮ ነንሁንዴሰ። <verse eid="GEN 9:9"/><verse number="10" style="v" sid="GEN 9:10"/>አከሱመስ ኡመመወን ሉቡ ቀቤዪ እስን ወጅን ቱረን ሁንደ ጄቹንስ ስምብሮተ፣ ሆሪፊ ብኔንሶተ ለፋ ሁንደ፣ ዋን እስን ወጅን ዶኒ ኬሳ በኤ ሁንደ፣ ኡመመወን ለፈረ ጅራተን ሁንደ ወጅንስ ከኩኮ ነንሁንዴሰ። <verse eid="GEN 9:10"/><verse number="11" style="v" sid="GEN 9:11"/>አከ ስአች ወን ሉቡ ቀቡ ሁንድ ዴብኤ ብሻን በዲሳቲን ህንበድኔፍ፣ ስአች ብሻን በዲሳ ለፈ በሌሱፍ ጎንኩማ አከ ህንዹፍኔፍ አን እስን ወጅን ከኩኮ ነንሁንዴሰ።”<verse eid="GEN 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 9:12"/>ዋቅን አከነ ጄዼ፤ “መለቶን ከኩ ከን አን ኦፊኮቲፊ እስን ግዱት፣ ኡመመወን ሉቡ ቀቤዪ እስን ብረ ጅረን ሁንደ ግዱት፣ ዸሎተ ዹፉፍ ጅሩ ሁንዳፍ ገሉ ከናዸ። <verse eid="GEN 9:12"/><verse number="13" style="v" sid="GEN 9:13"/>አን ሰበተኮ ዱሜሰ ኬሰ ዻቤረ፤ እንስ ከኩ አናፊ ለፈ ግዱ ጅሩፍ መለቶ ተአ። <verse eid="GEN 9:13"/><verse number="14" style="v" sid="GEN 9:14"/>ዬሮ አን ለፈረት ዱሜሰ ፍዴ ሰበትንኮ ዱሜሰ ኬሳን ሙልአቱት፣ <verse eid="GEN 9:14"/><verse number="15" style="v" sid="GEN 9:15"/>አን ከኩኮ ከን ኦፊኮቲፊ እስን ግዱ፣ ኡመመወን ሉቡ ቀቤዪ ጎሰ ሁንዳ ግዱስ ጅሩ ሰነ ነንያደዸ። ብሻኖትንስ ዴብአኒ ሉቡ ሁንደ በሌሱፍ ጎንኩማ ብሻን በዲሳ ህንተአን። <verse eid="GEN 9:15"/><verse number="16" style="v" sid="GEN 9:16"/>ዬሮ ሰበትንኮ ዱሜሰ ኬሳን ሙልአቱት፣ አን እሰ እላሌ ከኩ በረ በራ ከን ዋቃፊ ኡመመወን ሉቡ ቀቤዪ ጎሰ ሁንዳ ከኔን ለፈረ ጅራተን ግዱ ጅሩ ሰነ ነንያደዸ።”<verse eid="GEN 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 9:17"/>ከናፉ ዋቅን ኖሂን፣ “ኩን መለቶ ከኩ አን ኦፊኮቲፊ ሉቡ ለፈረ ጅራቱ ሁንደ ግዱ ዻቤ ሰናት” ጄዼ።<verse eid="GEN 9:17"/></para>
  <para style="s1">እልማን ኖህ</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 9:18"/>እልማን ኖህ ወር ዶኒ ኬሳ በአን ሴም፣ ሃሚፊ ያፌት ቱረን። ሃም አባ ከነኣኒት። <verse eid="GEN 9:18"/><verse number="19" style="v" sid="GEN 9:19"/>እልማን ኖህ ጀረ ከነ ሰደን ቱረን፤ ሰኚን ነማ ከን ለፈ ሁንደረ ብትኔፈሜስ እሳኑመራ አርገሜ።<verse eid="GEN 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 9:20"/>ኖህ ቆናን ቡላ ተኤ ወይኒ ዻቡት ነመ ጀልቀባ ቱሬ። <verse eid="GEN 9:20"/><verse number="21" style="v" sid="GEN 9:21"/>እንስ ዳዺ ወይኒ ሰና ዹጌ መቻኤ፤ ቁላሳስ ዱንካነሳ ኬሰ ጪሴ። <verse eid="GEN 9:21"/><verse number="22" style="v" sid="GEN 9:22"/>ሃም አባን ከነኣን ቁላ አባሳ አርጌ ኦቦሎተሳ ለማን አለ ቱረንት ህሜ። <verse eid="GEN 9:22"/><verse number="23" style="v" sid="GEN 9:23"/>ሴሚፊ ያፌት ገሩ ወያ ፉዸኒ ገቲቲሳኒ ለማንረ ቡፈተኒ ዱግደ ዱባን ዴመኒ ቁላ አባሳኒት ኡፍሰን። ዋን ፉልሳኒ አች ገረገሌ ቱሬፍ እሳን ቁላ አባሳኒ ህንአርግኔ።<verse eid="GEN 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 9:24"/>ኖህስ ዬሮ መቺንሳ እራ ገሌት ዋን እልምሳ እን ጥናን እሰት ሆጄቴ ቤኬ <verse eid="GEN 9:24"/><verse number="25" style="v" sid="GEN 9:25"/>አከነ ጄዼ፤</para>
  <para style="q1" vid="GEN 9:25">“ከነኣን አባረማ ሃተኡ!</para>
  <para style="q2" vid="GEN 9:25">እን ኦቦሎተሳቲፍ</para>
  <para style="q2" vid="GEN 9:25">ገርበ ገርቦታ ሃተኡ።”<verse eid="GEN 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 9:26"/>አከነስ ጄዼ፤</para>
  <para style="q1" vid="GEN 9:26">“<char style="nd">ዋቀዮ</char> ዋቅን ሴም ሃኤብፈሙ!</para>
  <para style="q2" vid="GEN 9:26">ከነኣንሞ ገርብቸ ሴም ሃተኡ።<verse eid="GEN 9:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="GEN 9:27"/>ዋቅን ብየ ያፌት ሃበልእሱ፤</para>
  <para style="q2" vid="GEN 9:27">ያፌት ዱንካኖተ ሴም ኬሰ ሃጅራቱ፤</para>
  <para style="q2" vid="GEN 9:27">ከነኣንሞ ገርብቸሳ ሃተኡ።”<verse eid="GEN 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 9:28"/>ብሻን በዲሳ ቦዴ ኖህ ወጋ 350 ጅራቴ። <verse eid="GEN 9:28"/><verse number="29" style="v" sid="GEN 9:29"/>ወሉመት ኖህ ወጋ 950 ጅራቴ ዱኤ።<verse eid="GEN 9:29"/></para>
  <chapter eid="GEN 9"/>
  <chapter number="10" style="c" sid="GEN 10"/>
  <para style="s1">ሰኚ እልማን ኖህ</para>
  <para style="lh">
    <verse number="1" style="v" sid="GEN 10:1"/>ሴናን እልማን ኖህ ጄቹንስ ከን ሴም፣ ከን ሃሚፊ ከን ያፌት ከነ፤ እሳንስ ብሻን በዲሳ ቦዴ እልማን ዸልቸን።<verse eid="GEN 10:1"/></para>
  <para style="s2">ሰኚ ያፌት</para>
  <para style="r">
    <ref loc="GEN 10:2-5">10፥2‑5</ref> ኩወፈ – <char style="xt"><ref loc="1CH 1:5-7">1ሴና 1፥5‑7</ref></char></para>
  <para style="li1">
    <verse number="2" style="v" sid="GEN 10:2"/>እልማን ያፌት፦</para>
  <para style="li2" vid="GEN 10:2">ጎሜር፣ ማጎግ፣ ሜዴ፣ ያዋን፣ ቱባል፣ ሜሼኪፊ ቲራስ ቱረን።<verse eid="GEN 10:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="GEN 10:3"/>እልማን ጎሜር፦</para>
  <para style="li2" vid="GEN 10:3">አሽኬነስ፣ ሪፋቲፊ ቶገርማ ቱረን።<verse eid="GEN 10:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="GEN 10:4"/>እልማን ያዋን፦</para>
  <para style="li2" vid="GEN 10:4">ኤሊሻ፣ ተርሺሽ፣ ክቲሚፊ ሮዳኖተ ቱረን። <verse eid="GEN 10:4"/><verse number="5" style="v" sid="GEN 10:5"/>ኡመትን ቀርቀረ ገላናስ ቶኮን ቶኮንሳኒ አኩመ አፋንሳኒቲፊ አኩመ ሰበሳኒት ገረ ብዮተሳኒት ብብትናአን።<verse eid="GEN 10:5"/></para>
  <para style="s2">ሰኚ ካም</para>
  <para style="r">
    <ref loc="GEN 10:6-20">10፥6‑20</ref> ኩወፈ – <char style="xt"><ref loc="1CH 1:8-16">1ሴና 1፥8‑16</ref></char></para>
  <para style="li1">
    <verse number="6" style="v" sid="GEN 10:6"/>እልማን ሃም፦</para>
  <para style="li2" vid="GEN 10:6">ኩሽ፣ ምስረይም፣ ፉጢፊ ከነኣን ቱረን።<verse eid="GEN 10:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="GEN 10:7"/>እልማን ኩሽ፦</para>
  <para style="li2" vid="GEN 10:7">ሳባ፣ ሀዊላ፣ ሰብታ፣ ረእማፊ ሰብቴካ ቱረን።</para>
  <para style="li1" vid="GEN 10:7">እልማን ረእማ፦</para>
  <para style="li2" vid="GEN 10:7">ሼባፊ ዴዳን ቱረን።<verse eid="GEN 10:7"/></para>
  <para style="lf">
    <verse number="8" style="v" sid="GEN 10:8"/>ኩሽ አባ ናምሩድ፤ ናምሩድስ ለፈረት ሎልቱ ጀባ ተኤ። <verse eid="GEN 10:8"/><verse number="9" style="v" sid="GEN 10:9"/>እንስ ፉለ <char style="nd">ዋቀዮ</char> ዱረት አደምሳ ጀባ ቱሬ፤ ከናፉ፣ “ፉለ <char style="nd">ዋቀዮ</char> ዱረት አደምሳ ጀባ አከ ናምሩድ” ጄዸሜ። <verse eid="GEN 10:9"/><verse number="10" style="v" sid="GEN 10:10"/>ጀልቀብን ሞቱማሳ ሽኔኣር ኬሰት ባብሎን፣ ኤሬክ፣ አካዲፊ ካልኔ ቱሬ። <verse eid="GEN 10:10"/><verse number="11" style="v" sid="GEN 10:11"/>እንስ ብየ ሰና በኤ አሶር ዸቄ፤ አችትስ ነነዌ፣ ሬሆቦቲፊ ካለህ እጃሬ፤ <verse eid="GEN 10:11"/><verse number="12" style="v" sid="GEN 10:12"/>አከሱመስ ሬሴን እሼ ነነዌፊ ካለህ ግዱት አርገምቱ ንእጃሬ፤ ሬሴን ኩንስ መጋላ ጉዶዸ።<verse eid="GEN 10:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="GEN 10:13"/>ምስረይምሞ አባ</para>
  <para style="li2" vid="GEN 10:13">ሉዲሞታ፣ አናሚሞታ፣ ሌሃቢሞታ፣ ነፍተሂሞታ፣ <verse eid="GEN 10:13"/><verse number="14" style="v" sid="GEN 10:14"/>ፈትሩሲሞታ፣ ከሴሉሂሞታ፣ ጄቹንስ ወረ ፍልስጤሞትን እራ ዸለተኒፊ ከፍቶሪሞታት።<verse eid="GEN 10:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="GEN 10:15"/>ከነኣን አባ ሲዶን</para>
  <para style="li2" vid="GEN 10:15">እልመሳ ሀንገፍትቻ፣ አከሱመስ ከን ሄቶታ፣ <verse eid="GEN 10:15"/><verse number="16" style="v" sid="GEN 10:16"/>ዬቡሶታ፣ አሞሮታ፣ ግርጋሾታ፣ <verse eid="GEN 10:16"/><verse number="17" style="v" sid="GEN 10:17"/>ሂዎታ፣ አርካዎታ፣ ሲኖታ፣ <verse eid="GEN 10:17"/><verse number="18" style="v" sid="GEN 10:18"/>አርዋዴዎታ፣ ዜማሮታቲፊ ሀማቶታ ቱሬ።</para>
  <para style="li2" vid="GEN 10:18">ኤርገሲ ጎሶትን ከነኣን ንብብትናአን፤ <verse eid="GEN 10:18"/><verse number="19" style="v" sid="GEN 10:19"/>ዳሪን ከነኣንስ ሲዶኒ ከኤ ከራ ጌራራቲን ሀመ ጋዛት በልአቴ፤ ከራ ሶዶም፣ ጎሞራ፣ አድማቲፊ ዜቦኢሚቲንስ ሀመ ሌሻት በልአቴ።<verse eid="GEN 10:19"/></para>
  <para style="lf">
    <verse number="20" style="v" sid="GEN 10:20"/>እልማን ሃም አኩመ ጎሳፊ አፋንሳኒት፣ አኩመ ብያፊ ሰበሳኒት ከኔኒዸ።<verse eid="GEN 10:20"/></para>
  <para style="s2">ሰኚ ሴም</para>
  <para style="r">
    <ref loc="GEN 10:21-31">10፥21‑31</ref> ኩወእ – <char style="xt"><ref loc="GEN 11:10-27">ኡመ 11፥10‑27</ref>፤ <ref loc="1CH 1:17-27">1ሴና 1፥17‑27</ref></char></para>
  <para style="lh">
    <verse number="21" style="v" sid="GEN 10:21"/>ሴሚፍስ እልማን ንዸለተን፤ ኦቦሌስ ሴም ሀንገፍት ያፌት ቱሬ፤ ሴምስ አባ እልማን ኤቤር ሁንዳ ቱሬ።<verse eid="GEN 10:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="GEN 10:22"/>እልማን ሴም</para>
  <para style="li2" vid="GEN 10:22">ኤላም፣ አሹር፣ አርፋክሸድ፣ ሉዲፊ አራም ቱረን።<verse eid="GEN 10:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="GEN 10:23"/>እልማን አራም</para>
  <para style="li2" vid="GEN 10:23">ኡዝ፣ ሁል፣ ጌቴሪፊ ሜሼክ ቱረን።<verse eid="GEN 10:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="GEN 10:24"/>አርፋክሸድ ሼላ ዸልቼ፤</para>
  <para style="li2" vid="GEN 10:24">ሼላንሞ ኤቤርን ዸልቼ።<verse eid="GEN 10:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="GEN 10:25"/>ኤቤሪፍስ እልማን ለመቱ ዸለቴ፤ ሰበቢ በረሳ ኬሰ ለፍት ገርገር ቆደምቴፍ</para>
  <para style="li2" vid="GEN 10:25">መቃን እሰ ቶኮ ፌሌግ ጄዸሜ ሞጋፈሜ፤ መቃን ኦቦሌሰሳሞ ዮቅጣን ጄዸሜ ሞጋፈሜ።<verse eid="GEN 10:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="GEN 10:26"/>ዮቅጣንሞ</para>
  <para style="li2" vid="GEN 10:26">አልሞዳድ፣ ሼሌፍ፣ ሀዘርማዌት፣ ያራ፣ <verse eid="GEN 10:26"/><verse number="27" style="v" sid="GEN 10:27"/>ሀዶራም፣ ኡዛል፣ ድቅላ፣ <verse eid="GEN 10:27"/><verse number="28" style="v" sid="GEN 10:28"/>ኦባል፣ አቢማኤል፣ ሼባ፣ <verse eid="GEN 10:28"/><verse number="29" style="v" sid="GEN 10:29"/>ኦፊር፣ ሀዊላፊ ዮባብን ዸልቼ። ወር ኩኔን ሁንድኑ እልማን ዮቅጣኒት።<verse eid="GEN 10:29"/></para>
  <para style="li2">
    <verse number="30" style="v" sid="GEN 10:30"/>ለፍት ጅሬኘሳኒ ሜሻ ከኤ ከራ ሴፋሪቲን ሀመ ጋረን በአ ቢፍቱት በልአተ።<verse eid="GEN 10:30"/></para>
  <para style="lf">
    <verse number="31" style="v" sid="GEN 10:31"/>እልማን ሴም አኩመ ጎሳፊ አፋንሳኒት፣ አኩመ ብያፊ ሰበሳኒት ከኔኒዸ።<verse eid="GEN 10:31"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="32" style="v" sid="GEN 10:32"/>ወር ኩን ጎሶተ እልማን ኖህ ከኔን አኩመ ዸሎተሳኒት ሰበሳኒ ኬሰ ጅረኒዸ፤ ብሻን በዲሳቲን ቦዴ ሰቦትን ወሩመ ከነራ ለፈረ ፈፈጨአን።<verse eid="GEN 10:32"/></para>
  <chapter eid="GEN 10"/>
  <chapter number="11" style="c" sid="GEN 11"/>
  <para style="s1">ገሞ ባቤል</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 11:1"/>በረ ሰነ አዱኛን ጉቱን አፋን ቶኮፊ ሃሳ ቶኮ ቀበ ቱሬ። <verse eid="GEN 11:1"/><verse number="2" style="v" sid="GEN 11:2"/>ነሞትን አኩመ ገረ በአ ቢፍቱት ጎዳነኒን፣ ሽኔኣር ኬሰት ለፈ ድሪራ አርገተኒ አች ቁበተን።<verse eid="GEN 11:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 11:3"/>እሳንስ፣ “ኮታ ሜ ጡቢ ሆጄትኔ እብዳን ጉብና” ወሊን ጄዸን። እሳንስ ቆደ ዸጋ፣ ጡቢት ፈየደመን፤ ሀጴዻፍሞ ሌሌት ፈየደመን። <verse eid="GEN 11:3"/><verse number="4" style="v" sid="GEN 11:4"/>ኤርገሲ፣ “ኮታ ሜ አከ ኦፊኬኛ መቃ አርገትኑፊ አከ አዱኛ ጉቱረ ህንብብትኖፍኔፍ መጋላ ገሞንሳ ሰሚ ቀቀቡ ቶኮ እጃረትና” ጄዸን።<verse eid="GEN 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 11:5"/>
    <char style="nd">ዋቀዮ</char> ገሩ መጋላፊ ገሞ እሳን እጃራ ቱረን ሰነ እላሉፍ ገድ ቡኤ። <verse eid="GEN 11:5"/><verse number="6" style="v" sid="GEN 11:6"/><char style="nd">ዋቀዮስ</char> አከነ ጄዼ፤ “ኤርገ እሳን አከ ሰበ ቶኮ ከን አፋኑመ ቶኮ ዱበቱት ዋን ከነ ሆጄቹ ጀልቀበኒ፣ ዮስ አመ ወን እሳን ሆጄቹፍ ከሮርፈተን ከን እሳኒፍ ህንደንደአምኔ ቶኮዩ ህንጅራቱ። <verse eid="GEN 11:6"/><verse number="7" style="v" sid="GEN 11:7"/>ኮታ ሜ ገድ ቡኔ፣ አከ እሳን ወል ህንሁበኔፍ አፋንሳኒ ወሊን ዾፍና!”<verse eid="GEN 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 11:8"/>ከናፉ <char style="nd">ዋቀዮ</char> አቺ እሳን ባሴ ለፈ ሁንደረ እሳን ብትኔሴ፤ እሳንስ መጋላ እጃሩ ዺሰን። <verse eid="GEN 11:8"/><verse number="9" style="v" sid="GEN 11:9"/>ዋን <char style="nd">ዋቀዮ</char> አችት አፋን አዱኛ ሁንደ ወሊን መኬፍ እዶን ሱን ባብሎን ጄዸሜ፤ <char style="nd">ዋቀዮ</char> እዶ ሰና እሳን ባሴ ለፈ ሁንደረ እሳን ብትኔሴ።<verse eid="GEN 11:9"/></para>
  <para style="s1">ሴሚ ጀልቀቤ ሀመ አብራምት</para>
  <para style="r">
    <ref loc="GEN 11:10-27">11፥10‑27</ref> ኩወፈ – <char style="xt"><ref loc="GEN 10:21-31">ኡመ 10፥21‑31</ref>፤ <ref loc="1CH 1:17-27">1ሴና 1፥17‑27</ref></char></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 11:10"/>ሴናን ማቲ ሴም ከነ።</para>
  <para style="b" vid="GEN 11:10"/>
  <para style="li1" vid="GEN 11:10">ብሻን በዲሳ ቦዴ ወጋ ለመት ሴም ዬሮ ኡሙሪንሳ ወጋ 100 ጉቴት አርፋክሸድን ዸልቼ። <verse eid="GEN 11:10"/><verse number="11" style="v" sid="GEN 11:11"/>ሴም ኤርገ አርፋክሸድን ዸልቼ ቦዴ ወጋ 500 ጅራቴ እልማኒፊ እንተለን ብራ ዸልቼ።<verse eid="GEN 11:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="GEN 11:12"/>አርፋክሸድ ወጋ 35 ጅራቴ ሼላ ዸልቼ። <verse eid="GEN 11:12"/><verse number="13" style="v" sid="GEN 11:13"/>አርፋክሸድ ኤርገ ሼላ ዸልቼ ቦዴ ወጋ 403 ጅራቴ እልማኒፊ እንተለን ብራ ዸልቼ።<verse eid="GEN 11:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="GEN 11:14"/>ሼላን ወጋ 30 ጅራቴ ኤቤርን ዸልቼ። <verse eid="GEN 11:14"/><verse number="15" style="v" sid="GEN 11:15"/>ሼላን ኤርገ ኤቤርን ዸልቼ ቦዴ ወጋ 403 ጅራቴ እልማኒፊ እንተለን ብራ ዸልቼ።<verse eid="GEN 11:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="GEN 11:16"/>ኤቤር ወጋ 34 ጅራቴ ፌሌግን ዸልቼ። <verse eid="GEN 11:16"/><verse number="17" style="v" sid="GEN 11:17"/>ኤቤር ኤርገ ፌሌግን ዸልቼ ቦዴ ወጋ 430 ጅራቴ እልማኒፊ እንተለን ብራ ዸልቼ።<verse eid="GEN 11:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="GEN 11:18"/>ፌሌግ ወጋ 30 ጅራቴ ሬኡ ዸልቼ። <verse eid="GEN 11:18"/><verse number="19" style="v" sid="GEN 11:19"/>ፌሌግ ኤርገ ሬኡ ዸልቼ ቦዴ ወጋ 209 ጅራቴ እልማኒፊ እንተለን ብራስ ዸልቼ።<verse eid="GEN 11:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="GEN 11:20"/>ሬኡን ወጋ 32 ጅራቴ ሴሩግን ዸልቼ። <verse eid="GEN 11:20"/><verse number="21" style="v" sid="GEN 11:21"/>ሬኡን ኤርገ ሴሩግን ዸልቼ ቦዴ ወጋ 207 ጅራቴ እልማኒፊ እንተለን ብራ ዸልቼ።<verse eid="GEN 11:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="GEN 11:22"/>ሴሩግ ወጋ 30 ጅራቴ ናሆርን ዸልቼ። <verse eid="GEN 11:22"/><verse number="23" style="v" sid="GEN 11:23"/>ሴሩግ ኤርገ ናሆርን ዸልቼ ቦዴ ወጋ 200 ጅራቴ እልማኒፊ እንተለን ብራ ዸልቼ።<verse eid="GEN 11:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="GEN 11:24"/>ናሆር ወጋ 29 ጅራቴ ታራ ዸልቼ። <verse eid="GEN 11:24"/><verse number="25" style="v" sid="GEN 11:25"/>ናሆር ኤርገ ታራ ዸልቼ ቦዴ ወጋ 119 ጅራቴ እልማኒፊ እንተለን ብራ ዸልቼ።<verse eid="GEN 11:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="GEN 11:26"/>ታራን ወጋ 70 ጅራቴ አብራም፣ ናሆሪፊ ሃራንን ዸልቼ።<verse eid="GEN 11:26"/></para>
  <para style="s1">ማቲ አብራም</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 11:27"/>ሴናን ማቲ ታራ ከነ።</para>
  <para style="b" vid="GEN 11:27"/>
  <para style="p" vid="GEN 11:27">ታራን አብራም፣ ናሆሪፊ ሃራንን ዸልቼ። ሃራንሞ ሎጥን ዸልቼ። <verse eid="GEN 11:27"/><verse number="28" style="v" sid="GEN 11:28"/>ሃራን ኡቱመ አባንሳ ታራን ጅሩ ኡር ብየ ከልዶታ ኬሰት ለፉመ እት ዸለቴት ዱኤ። <verse eid="GEN 11:28"/><verse number="29" style="v" sid="GEN 11:29"/>አብራሚፊ ናሆር ኒቲ ፉዸን። መቃን ኒቲ አብራም ሳራ፣ መቃን ኒቲ ናሆርሞ ሚልካ ቱሬ። ሚልካን እንተለ ሃራን። ሃራን ኩንሞ አባ ሚካቲፊ ይስካ ቱሬ። <verse eid="GEN 11:29"/><verse number="30" style="v" sid="GEN 11:30"/>ሳራን ዸብዱ ቱርቴ፤ እጆሌስ ህንዴኜ።<verse eid="GEN 11:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 11:31"/>ታራን እልመሳ አብራምን፣ እልመ እልመሳ ጄቹንስ ሎጥ እልመ ሃራኒፊ ኒቲ እልመሳ ጄቹንስ ሳራ ኒቲ አብራም ፉዸቴ ከነኣን ዸቁፍ፣ ኡር ብየ ከልዶታቲ ወሊ ወጅን በአን፤ ገሩ ዬሮ ካራን ገአንት አቹመ ቁበተን።<verse eid="GEN 11:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 11:32"/>ታራን ወጋ 205 ጅራቴ ካራንት ዱኤ።<verse eid="GEN 11:32"/></para>
  <chapter eid="GEN 11"/>
  <chapter number="12" style="c" sid="GEN 12"/>
  <para style="s1">ዋመሙ አብራም</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 12:1"/>
    <char style="nd">ዋቀዮ</char> አብራሚን አከነ ጄዼ፤ “ብየኬ፣ ሰበኬቲፊ መነ አባኬቲ ዺሲቲ ገረ ብየ አን ስ አርግሲሱ ዸቅ።<verse eid="GEN 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="GEN 12:2"/>“አን ሰበ ጉዳ ስን ታስሰ፤</para>
  <para style="q2" vid="GEN 12:2">ስን ኤብሰስ፤</para>
  <para style="q1" vid="GEN 12:2">መቃኬሌ ጉዳ ነንታስሰ፤</para>
  <para style="q2" vid="GEN 12:2">አትስ ኤበ ታታ።<verse eid="GEN 12:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="GEN 12:3"/>አን ወረ ስ ኤብሰን ነንኤብሰ፤</para>
  <para style="q2" vid="GEN 12:3">ወረ ስ አባረን ነንአባረ፤</para>
  <para style="q1" vid="GEN 12:3">ሰብን ለፈራ ሁንድኑ</para>
  <para style="q2" vid="GEN 12:3">ከራኬቲን ኤብፈመ።”<verse eid="GEN 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 12:4"/>ከናፉ አብራም አኩመ <char style="nd">ዋቀዮ</char> እሰት ህሜት ከኤ ዴሜ፤ ሎጥስ እሰ ወጅን ዴሜ። አብራም ዬሮ ካራኒ በኤት ነመ ወጋ ቶርባተሚ ሸኒ ቱሬ። <verse eid="GEN 12:4"/><verse number="5" style="v" sid="GEN 12:5"/>እንስ ኒቲሳ ሳራ፣ እልመ ኦቦሌሰሳ ሎጥ፣ ቀቤኘ ወልት ኩፈተን ሁንዱማፊ ነሞተ ካራንት አርገተን ሁንዱማ ቀበቴ ከነኣን ዸቁፍ ከኤ፤ እሳንስ አች ገአን።<verse eid="GEN 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 12:6"/>አብራምስ ሀመ ቅልጡ ሞሬ ከን ሼኬም ኬሰት አርገሙት ብየቲ ኬሰ ዴሜ። ዬሮ ሰነ ወር ከነኣን ብየ ሰነ ኬሰ ቱረን። <verse eid="GEN 12:6"/><verse number="7" style="v" sid="GEN 12:7"/><char style="nd">ዋቀዮ</char> አብራምት ሙልአቴ፣ “አን ብየ ከነ ሰኚኬቲፍ ነንኬነ” ጄዼን። ከናፉ እን አችት <char style="nd">ዋቀዮ</char> እሰት ሙልአቴ ሰናፍ እዶ ኣርሳ እጃሬ።<verse eid="GEN 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 12:8"/>አቺ ከኤ ገረ ጋረን ቤትኤልራ ገረ በአ ቢፍቱት አርገመኒ ዴሜ ቤትኤልን ገረ ልጠ ቢፍቱት፣ ኣይንሞ ገረ በአ ቢፍቱት ሀምብሴ ዱንካነሳ ዻበቴ። አችት <char style="nd">ዋቀዮፍ</char> እዶ ኣርሳ እጃሬ መቃ <char style="nd">ዋቀዮ</char> ዋመቴ።<verse eid="GEN 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 12:9"/>አብራም ኤርገሲ ከኤ ገረ ኔጌብት ከራሳ እት ፉፌ።<verse eid="GEN 12:9"/></para>
  <para style="s1">አብራም ብየ ግብጥ ኬሰት</para>
  <para style="r">
    <ref loc="GEN 12:10-20">12፥10‑20</ref> ኩወእ – <char style="xt"><ref loc="GEN 20:1-18">ኡመ 20፥1‑18</ref>፤ <ref loc="GEN 26:1-11">26፥1‑11</ref></char></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 12:10"/>በረ ሰነ ቤል ብየ ሰነት ቡኤ ቱሬ፤ ቤል ሱን ዋን ሀማቴፍ አብራም አች ጅራቹፍ ጄዼ ግብጥት ገድ ቡኤ። <verse eid="GEN 12:10"/><verse number="11" style="v" sid="GEN 12:11"/>እንስ ዬሮ ግብጥ ሴኑ ገኤት ኒቲሳ ሶራን አከነ ጄዼ፤ “አን አከ አት ዱበርቲ በሬዱ ታቴ ነንቤከ። <verse eid="GEN 12:11"/><verse number="12" style="v" sid="GEN 12:12"/>ወር ግብጥ ዮሙ ስ አርገን፣ ‘ኩን ኒቲሳት’ ጄዸኒ ነ አጄሱ፤ ስእሞ ንሀምብሱ። <verse eid="GEN 12:12"/><verse number="13" style="v" sid="GEN 12:13"/>አከ እሳን ሲፍ ጄዸኒ ሃለ ቶላን ነ እላለኒፊ አከ ሉቡንኮስ ሰበቢኬቲን ዱአ ኦልቱፍ ማሎ፣ ‘አን ኦቦሌቲሳት’ ጄዽ።”<verse eid="GEN 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 12:14"/>ዬሮ አብራም ግብጥ ሴኔትስ ወር ግብጥ አከ ሶራን ዱበርቲ ባይኤ በሬዱ ታቴ አርገን። <verse eid="GEN 12:14"/><verse number="15" style="v" sid="GEN 12:15"/>ቆንዳልቶትን ፈረኦንስ ዮሙ እሼ አርገንት እሼ ጀጀኒ ፈረኦንት ህመን፤ እሼንስ መሰራ ሞቱማ ፈረኦንት ጌፈምቴ። <verse eid="GEN 12:15"/><verse number="16" style="v" sid="GEN 12:16"/>ፈረኦን ሰበቢሼቲፍ ጄዼ አብራምን ሃለ ቶላዻን እላሌ፤ አብራምስ ሆሎታፊ ሎን፣ ሀሮተ ኮሮሚፊ ዸልቱ፣ ተጃጅልቶተ ዺራ ዱበርቲ፣ ጋለስ አርገቴ።<verse eid="GEN 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 12:17"/>
    <char style="nd">ዋቀዮ</char> ገሩ ሰበቢ ኒቲ አብራም፣ ሰበቢ ሳራቲፍ ጄዼ ፈረኦኒፊ ወረ መነሳ ጅራተን ዹኩበ ሀማን ዸኤ። <verse eid="GEN 12:17"/><verse number="18" style="v" sid="GEN 12:18"/>ከናፉ ፈረኦን አብራምን ኦፍት ዋሜ አከነ ጄዼን፤ “አት ማል ነት ሆጄቴ? አከ እሼን ኒቲኬ ታቴ ማሊፍ ነት ህንህምን? <verse eid="GEN 12:18"/><verse number="19" style="v" sid="GEN 12:19"/>አት ማሊፍ፣ ‘እሼን ኦቦሌቲኮት’ ጄቴ፣ አከ አን ኒቱማፍ እሼ ፉዸዹ ነ ጎቴ? አመስ ኒቲንኬ ኩኖት፤ እሼ ፉዸዹ ዴም!” <verse eid="GEN 12:19"/><verse number="20" style="v" sid="GEN 12:20"/>ፈረኦንስ ዋኤ አብራምረት ነሞተሳ አጀጄ፤ እሳንስ አብራሚፊ ኒቲሳ፣ ዋን እን ቀቡ ሁንደ ወጅን ጌጌሰን።<verse eid="GEN 12:20"/></para>
  <chapter eid="GEN 12"/>
  <chapter number="13" style="c" sid="GEN 13"/>
  <para style="s1">አብራሚፊ ሎጥ ገርገር በኡሳኒ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 13:1"/>አብራም ኒቲሳቲፊ ዋን ቀቡ ሁንደ ወጅን ግብጢ ከኤ ኔጌብት ኦል በኤ፤ ሎጥስ እሰ ወጅን ዴሜ። <verse eid="GEN 13:1"/><verse number="2" style="v" sid="GEN 13:2"/>አብራምስ ሆሪን፣ ሜቲፊ ወርቄዻን አከ መሌ ሶሮሜ።<verse eid="GEN 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 13:3"/>እንስ ኔጌቢ ከኤ ሀመ ቤትኤል፣ እዶ ቤትኤሊፊ ኣይ ግዱ፣ ለፈ ዱንካንሳ ጀልቀበት ቱሬ ሰነ ገኡት እዶ ቶኮ ገረ እዶ ብራት ዴምሰሳ እት ፉፌ፤ <verse eid="GEN 13:3"/><verse number="4" style="v" sid="GEN 13:4"/>እዶን ሱንስ ለፈ እን ዬሮ ጀልቀባቲፍ እዶ ኣርሳ እት እጃሬዸ። አብራምስ አችት መቃ <char style="nd">ዋቀዮ</char> ዋመቴ።<verse eid="GEN 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 13:5"/>ሎጥ ነምች አብራም ወጅን ዴማ ቱሬ ሱን አከሱመ ቡሻዬ፣ ሳወኒፊ ዱንካኖተ ቀበ ቱሬ። <verse eid="GEN 13:5"/><verse number="6" style="v" sid="GEN 13:6"/>ዬሮ እሳን ወሊ ወጅን ጅራተንት ለፍት እሳንት ዽጰቴ፤ ሰበቢ ቀቤኝሳኒ አከ መሌ ጉደቴፍስ እሳን ወል ብረ ጅራቹ ህንደንዴኜ። <verse eid="GEN 13:6"/><verse number="7" style="v" sid="GEN 13:7"/>ከናፉ ትክሶተ አብራሚፊ ትክሶተ ሎጥ ግዱት ሎል ኡመሜ። ዬሮ ሰነት ከነኣኖትኒፊ ፌርዞንስ ብየ ሰነ ኬሰ ጅራቻ ቱረን።<verse eid="GEN 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 13:8"/>አብራምስ ሎጢን አከነ ጄዼ፤ “ኑ ዋን ኦቦሎተ ታኔፍ፣ ስኢፊ አነ ግዱ ዮካን ትክሶተኬቲፊ ትክሶተኮ ግዱ ሎል ህንጅራትን። <verse eid="GEN 13:8"/><verse number="9" style="v" sid="GEN 13:9"/>ለፍት ሁንድ ፉለኬ ዱረ ጅርት ምቲ? ኮቱ ገርገር ጎዳና። ዮ አት ገረ ብታት ዴምቴ፣ አን ገረ ምርጋት ነንዴመ፤ ዮ አት ገረ ምርጋት ዴምቴሞ አን ገረ ብታት ነንዴመ።”<verse eid="GEN 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 13:10"/>ሎጥስ ኦል ጄዼ እላሌ አከ ሁሩፍን ዮርዳኖስ ሁንድ አኩመ እዶ ብቅልቱ <char style="nd">ዋቀዮ</char> አኩመ ብየ ግብጥ ከን ከራ ዞኣርረ ጅሩ ሰና ብሻን ባይኤ ቀቡ አርጌ። ኩንስ ኡቱ <char style="nd">ዋቀዮ</char> ሶዶሚፊ ጎሞራ ህንበሌስኒን ዱረ ቱሬ። <verse eid="GEN 13:10"/><verse number="11" style="v" sid="GEN 13:11"/>ከናፉ ሎጥ ሁሩፈ ዮርዳኖስ ጉቱማት ኦፊሳቲ ፍለቴ ገረ በአ ቢፍቱት ጎዳኔ። ጀር ለማንስ አከስት ገርገር በአን። <verse eid="GEN 13:11"/><verse number="12" style="v" sid="GEN 13:12"/>አብራም ብየ ከነኣን ኬሰ ጅራቴ፤ ሎጥሞ መጋላወን ድሬረ ጅረን ግዱ ጅራቴ ዱንካነሳ ሶዶም ብረ ዻበቴ። <verse eid="GEN 13:12"/><verse number="13" style="v" sid="GEN 13:13"/>ወር ሶዶም ጀልኦተ ፉለ <char style="nd">ዋቀዮ</char> ዱረት አከ መሌ ጩቡ ሆጄተን ቱረን።<verse eid="GEN 13:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 13:14"/>ኤርገ ሎጥ እሰ ብራ ጎዳኔ ቦዴ <char style="nd">ዋቀዮ</char> አብራሚን አከነ ጄዼ፤ “እዶ አመ ጅርቱ ከና እጀኬ ኦል ፉዸዹቲ ገረ ካባፊ ክባ፣ ገረ በአ ቢፍቱቲፊ ልጠ ቢፍቱ እላል። <verse eid="GEN 13:14"/><verse number="15" style="v" sid="GEN 13:15"/>አንስ ብየ አት አርግቱ ከነ ሁንደ በረ በራን ስኢፊ ሰኚኬቲፍ ነንኬነ። <verse eid="GEN 13:15"/><verse number="16" style="v" sid="GEN 13:16"/>አን ሰኚኬ አኩመ ብዮ ለፋ ነንባይእሰ፤ ዮ ነምን ብዮ ለፋ ለካኡ ደንደኤ፣ ሰኚንኬ አከሱመ ለካአሙ ደንደአ። <verse eid="GEN 13:16"/><verse number="17" style="v" sid="GEN 13:17"/>ከኢቲ ዼርናፊ በልእነ ለፈ ከና ኬሰ ዴዴም፤ አን እሰ ሲፍን ኬናቲ።”<verse eid="GEN 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 13:18"/>ከናፉ አብራም ዱንካነሳ ቡቅፈቴ ቅልጡወን መምሬ ከኔን ኬብሮንት አርገመን ብረ ጅራቹ ዸቄ፤ አችትስ እዶ ኣርሳ <char style="nd">ዋቀዮፍ</char> ቶልቼ።<verse eid="GEN 13:18"/></para>
  <chapter eid="GEN 13"/>
  <chapter number="14" style="c" sid="GEN 14"/>
  <para style="s1">ሎጥ ሀርከ ዲናቲ ባፈሜ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 14:1"/>በረ ሰነ ኬሰ አምራፌል ሞቲን ሽኔኣር፣ አርዮክ ሞቲን ኤላሳር፣ ኬዶርላኦሜር ሞቲን ኤላሚፊ ትድኣል ሞቲን ሰቦታ ከአኒ፣ <verse eid="GEN 14:1"/><verse number="2" style="v" sid="GEN 14:2"/>ቤራ ሞትቸ ሶዶም፣ ብርሻ ሞትቸ ጎሞራ፣ ሽናብ ሞትቸ አድማ፣ ሼሜቤር ሞትቸ ዜቦኢሚፊ ሞትቸ ቤላ እሼ ዞኣር ጄዸምቱ ሰና ሎሉ ዸቀን። <verse eid="GEN 14:2"/><verse number="3" style="v" sid="GEN 14:3"/>ሞቶትን ሸነን ኩኔን ሁንድ ሱሉለ ሲዲም እሰ ገላነ ሶግዳ ጄዸሙ ኬሰት ወል ገአኒ ሁምነ ቶኩማ ኡመተን። <verse eid="GEN 14:3"/><verse number="4" style="v" sid="GEN 14:4"/>እሳንስ ወጋ ኩዸ ሸን ኬዶርላኦሜር ጀለት ቡለን፤ ወጋ ኩዸ ሰደፋት ገሩ ንፍንጭለን።<verse eid="GEN 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 14:5"/>ወጋ ኩዸ አፉረፋት ኬዶርላኦሜሪፊ ሞቶትን እሰ ወጅን ቱረን በአኒ ወረ ሬፋዪም አሽቴሮት ቃርናይሚት፣ ወረ ዙዚም ሃምት፣ ወረ ኤሚም ሻዊ ክርያታይሚት፣ <verse eid="GEN 14:5"/><verse number="6" style="v" sid="GEN 14:6"/>ወረ ሆርሞ ለፈ ጋረ ሴኢሪቲ ጀልቀበኒ ሀመ ኤል ጳራን ከን ገሞጂት ዽኦ ጅሩ ሰናት ሞአተን። <verse eid="GEN 14:6"/><verse number="7" style="v" sid="GEN 14:7"/>ኤርገሲ ኦፍረ ዴብአኒ ኤን ምሽጳት ጄቹንስ ቃዴሽ ዸቀኒ ብየ ወረ አማሌቅ ሁንዳፊ ወረ አሞር ከኔን ሀዜዞን ታማር ኬሰ ጅራተን ሁምናን ቀበተን።<verse eid="GEN 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 14:8"/>ሞትች ሶዶም፣ ሞትች ጎሞራ፣ ሞትች አድማ፣ ሞትች ዜቦኢሚፊ ሞትች ቤላ ጄቹንስ ዞኣር በአኒ ሱሉለ ሲዲም ኬሰት ሎሉፍ ህሪረን። <verse eid="GEN 14:8"/><verse number="9" style="v" sid="GEN 14:9"/>እሳንስ ኬዶርላኦሜር ሞቲ ኤላም፣ ትድኣል ሞቲ ሰቦታ፣ አምራፌል ሞቲ ሽኔኣሪቲፊ አርዮክ ሞቲ ኤላሳር ሎለን፤ ሞቶትን አፍረን ኩኔን ሞቶተ ሸነኒን ሞርመን። <verse eid="GEN 14:9"/><verse number="10" style="v" sid="GEN 14:10"/>ሱሉል ሲዲም ቦለ ሌሌቲን ጉተሜ ቱሬ፤ ሞቶትን ሶዶሚፊ ሞቶትን ጎሞራስ በቀተኒ ነሞትን ቶኮ ቶኮ ቦለ ሰነ ኬሰ ቡአን፤ ወር ሀፈንሞ ገረ ጋረኒት በቀተን። <verse eid="GEN 14:10"/><verse number="11" style="v" sid="GEN 14:11"/>ሞቶትን አፍረን ሱን ምኣፊ ኛተ ወረ ሶዶሚፊ ጎሞራ ሁንደ ሳመኒ ሶከን። <verse eid="GEN 14:11"/><verse number="12" style="v" sid="GEN 14:12"/>ዋን ሎጥ እልም ኦቦሌሰ አብራም ሶዶም ኬሰ ጅራቻ ቱሬፍ ሞቶትን ሱን እሰሌ ቀቤኙመሳ ወጅን ቦጅአኒ ዴመን።<verse eid="GEN 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 14:13"/>ነምች በቀቴ በኤ ቶኮ ዹፌ ኦዱ ከነ አብራም እብርቸት ህሜ። አብራምስ ቅልጡወን መምሬ ከን ነምቸ አሞሪ ሰነ ብረ ጅራቻ ቱሬ፤ መምሬን ኩን ኦቦሌሰ ኤሽኮሊፊ ኣኔር ቱሬ፤ እሳን አብራም ወጅን ከኩ ገለኒ ቱረን። <verse eid="GEN 14:13"/><verse number="14" style="v" sid="GEN 14:14"/>አብራም አከ ፍርሳ ቦጅአሜ ዸጌኛን ነሞተ መነሳት ዸለተኒ ሌንጅፈመን 318 ወልት ዋመቴ ህዸቺሴ ሀመ ዳኒት ፋነ ቡኤ። <verse eid="GEN 14:14"/><verse number="15" style="v" sid="GEN 14:15"/>አብራምስ እሳን ሎሉፍ ጄዼ ሀልከኒን ነሞተሳ ገርገር ቆዴ፤ ሀመ ሆባ እሼ ካበ ደማስቆት አርገምቱ ሰናትስ ፋነ ቡኤ እሳን ዸኤ። <verse eid="GEN 14:15"/><verse number="16" style="v" sid="GEN 14:16"/>እንስ ምአ ሁንደ ዴብፈቴ፤ ፍረ ኦፊሳ ሎጢፊ ቀቤኘሳ፣ ዱበርቶታፊ ነሞተ ካንስ ዴብፈቴ።<verse eid="GEN 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 14:17"/>አብራም ኬዶርላኦሜሪፊ ሞቶተ እሰ ወጅን ቱረን ሞአቴ ዴብናን ሞቲን ሶዶም ሱሉለ ሻዊ ከን ሱሉለ ሞቲ ጄዸሙ ኬሰት እሰ ስመቹ በኤ።<verse eid="GEN 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 14:18"/>መልኪሴዴቅ ሞቲን ሳሌምስ ቡዴናፊ ዳዺ ወይኒ ፍዴፍ፤ እንስ ሉበ ዋቀዮ ዋቀ ዋን ሁንዳ ኦሊ ቱሬ፤ <verse eid="GEN 14:18"/><verse number="19" style="v" sid="GEN 14:19"/>እንስ አከነ ጄዼ አብራምን ኤብሴ፤</para>
  <para style="q1" vid="GEN 14:19">“አብራም፣ ዋቀዮ ዋቀ ዋን ሁንዳ ኦሊ፣</para>
  <para style="q2" vid="GEN 14:19">እሰ ሰሚፊ ለፈ ኡሜ ሰናን ሃኤብፈሙ።<verse eid="GEN 14:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="GEN 14:20"/>ዋቀዮ ዋቅን ዋን ሁንዳ ኦሊ፣</para>
  <para style="q2" vid="GEN 14:20">እን ዲኖተኬ ደበርሴ ሀርከኬት ኬኔ ሱን ሃኤብፈሙ።”</para>
  <para style="m" vid="GEN 14:20">ኤርገሲ አብራም ዋን ሁንደራ ኩዸን ኬሳ ቶኮ እሳፍ ኬኔ።<verse eid="GEN 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 14:21"/>ሞቲን ሶዶምስ አብራሚን፣ “ነሞተ ና ኬኒቲ ቀቤኘሞ ኦፊኬቲ ፉዸዹ” ጄዼ።<verse eid="GEN 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 14:22"/>አብራም ገሩ ሞቲ ሶዶሚቲን አከነ ጄዼ፤ “አን ሀርከኮ ገረ <char style="nd">ዋቀዮ</char>፣ ዋቀ ዋን ሁንዳ ኦሊ፣ ኡማ ሰሚቲፊ ለፋት ኦል ፉዸዼ ከከዼን ጅረ፤ <verse eid="GEN 14:22"/><verse number="23" style="v" sid="GEN 14:23"/>አከ አት፣ ‘አነቱ አብራምን ሶሮምሴ’ ህንጄኔፍ አን ዋን ከንኬ ተኤ ኬሳ ቶኮዩ፣ ፎኣ ዮካን ቴጰ እቲን ኮጴ ህዸተንዩ ህንፉዸዹ። <verse eid="GEN 14:23"/><verse number="24" style="v" sid="GEN 14:24"/>ዋን ነሞትንኮ ኛተኒፊ ቆደ ነሞተ አነ ወጅን ዴመኒ ጄቹንስ ቆደ ኣኔር፣ ከን ኤሽኮሊቲፊ ከን መምሬ መሌ አን ኦፊኮ ሆማ ህንፉዸዹ፤ እሳን ቆደሳኒ ሃፉዸተን።”<verse eid="GEN 14:24"/></para>
  <chapter eid="GEN 14"/>
  <chapter number="15" style="c" sid="GEN 15"/>
  <para style="s1">ከኩ ዋቅን አብራም ወጅን ገሌ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 15:1"/>ከነ ቦዴ ዱቢን <char style="nd">ዋቀዮ</char> ሙልአታን ገረ አብራም ዹፌ አከነ ጄዼ፤</para>
  <para style="q1" vid="GEN 15:1">“ያ አብራም ህንሶዳትን፤</para>
  <para style="q2" vid="GEN 15:1">አን ጋቸነኬቲፊ</para>
  <para style="q2" vid="GEN 15:1">ገቲኬ ጉድቸ።”<verse eid="GEN 15:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 15:2"/>አብራም ገሩ፣ “ያ <char style="nd">ዋቀዮ</char> ጎፍታ፣ ዋን አን እጆሌ ህንቀብኔፍ ነምን ቀቤኘኮ ዻሉፍ ጅሩ ኤሊኤዜር ነምቸ ደማስቆ ከነ፤ ኤጋ አት ማል ና ኬንተ?” ጄዼ። <verse eid="GEN 15:2"/><verse number="3" style="v" sid="GEN 15:3"/>አብራም፣ “ኩኖ አት እጆሌ ቶኮሌ ና ህንኬንኔ፤ ሆጄታን መነኮ ጅራቱ ቶኮ ኩኖ ነ ዻሉፍ ጅረ” ጄዼ።<verse eid="GEN 15:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 15:4"/>ኩኖ ዱቢን <char style="nd">ዋቀዮ</char> ገረሳ ዹፌ፣ “እልመ ጉዴደኬቲቱ ዻልቱኬ ተአ መሌ ነምች ኩን ዻልቱኬ ህንተኡ” ጄዼ። <verse eid="GEN 15:4"/><verse number="5" style="v" sid="GEN 15:5"/>እንስ አብራምን ገድ ባሴ፣ “ሰሚወን ኦል እላሊቲ ዮ ኡርጂወን ለካኡ ደንዴሴ ለካእ” ጄዼ። እት ፉፌስ፣ “ሰኚንኬስ አከኑመ ባይአተ” ጄዼን።<verse eid="GEN 15:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 15:6"/>አብራም <char style="nd">ዋቀዮት</char> አመኔ፤ እንስ ቀጄሉማት ለካኤፍ።<verse eid="GEN 15:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 15:7"/>እንስ፣ “አን <char style="nd">ዋቀዮ</char> እሰ አከ አት እሼ ዻልቱፍ ብየ ከነ ሲፍ ኬኑፍ ጄዼ ኡር ብየ ከልዶታ ኬሳ ስ ባሴዸ” ጄዼን።<verse eid="GEN 15:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 15:8"/>አብራም ገሩ፣ “ያ <char style="nd">ዋቀዮ</char> ጎፍታ፣ አን ብየ ከነ ዻሉኮ አከምትን ቤከ?” ጄዼ።<verse eid="GEN 15:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 15:9"/>ከናፉ <char style="nd">ዋቀዮ</char>፣ “ጎሮምሰ ቶኮ፣ ሬኤ ቶኮፊ ኮርቤሰ ሆላ ቶኮ ከኔን ቶኮን ቶኮንሳኒ ወጋ ሰዲ ሰዲ ጉተን፣ አከሱመስ ጉጌ ቶኮፊ ጉጌ ሶኬ ቶኮ ና ፍድ” ጄዼን።<verse eid="GEN 15:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 15:10"/>አብራምስ ወረ ከነ ሁንደ ገረሳት ፍዴ፣ ቅጤ ለማንት ኩኩቴ፤ ወረ ቅጤ ለማንት ኩኩተመንስ ገማ ገመነ ካኤ፤ ስምብሮተ ገሩ ቅጤ ለማንት ህንኩኩትኔ። <verse eid="GEN 15:10"/><verse number="11" style="v" sid="GEN 15:11"/>ኤርገሲ አላቲን ፎን ሰነት ገድ ቡቴ፤ አብራም ገሩ እራ አርኤ።<verse eid="GEN 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 15:12"/>ኡቱመ አዱን ዽኣ ጅርቱ ህርብን ጉዳን አብራምን ቀቤ፤ ኩኖ ዱከን ጉዳኒፊ ሶዳችሳን እሰረ ቡኤ። <verse eid="GEN 15:12"/><verse number="13" style="v" sid="GEN 15:13"/><char style="nd">ዋቀዮስ</char> አከነ እሳን ጄዼ፤ “አከ ሰኚንኬ ብየ ከንሳ ህንተእን ኬሰት አለጋ ተኤ ወጋ ዽበ አፉርስ አችት ገርቦምፈሜ ጩንቁርፈሙ ዹጉማን ቤክ። <verse eid="GEN 15:13"/><verse number="14" style="v" sid="GEN 15:14"/>አን ገሩ ሰበ እሳን አኩመ ገርቦታት ተጃጅለን ሰነ ነንአደበ፤ ኤርገሲሞ እሳን ቀቤኘ ጉዳ ፉዸተኒ አቺ በኡ። <verse eid="GEN 15:14"/><verse number="15" style="v" sid="GEN 15:15"/>አት ገሩ ነጋን ገረ አቦቲኬቲ ዸቅጠ፤ በረ ዼራስ ጅራቴ አዋለምተ። <verse eid="GEN 15:15"/><verse number="16" style="v" sid="GEN 15:16"/>ሰኚንኬ ዸሎተ አፉረፋት አስ ዴብአ፤ ጩቡን አሞሮታ አመዩ ህንጉትኔቲ።”<verse eid="GEN 15:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 15:17"/>ዮሙ አዱን ልጤ ዱከናኤትስ ኩኖ በርበዳን እብዳ ኣሩ ጉጨ ቶኮ ወጅን ሙልአቴ ፎን ኩኩተሜ ሰነ ግዱ ደርቤ። <verse eid="GEN 15:17"/><verse number="18" style="v" sid="GEN 15:18"/>ጋፈ ሰነስ <char style="nd">ዋቀዮ</char> አከነ ጄዼ አብራም ወጅን ከኩ ገሌ፤ “አን ብየ ለገ ግብጢ ጀልቀቤ ሀመ ለገ ኤፍራጢስ ጉድቻት ጅሩ ከነ ሰኚኬቲፍ ነንኬነ፤ <verse eid="GEN 15:18"/><verse number="19" style="v" sid="GEN 15:19"/>ኩንስ ብየ ቄኖታ፣ ቄኔዞታ፣ ቀድሞኖታስ፣ <verse eid="GEN 15:19"/><verse number="20" style="v" sid="GEN 15:20"/>ከን ሄቶታ፣ ፌርዞታ፣ ሬፋይሞታ፣ <verse eid="GEN 15:20"/><verse number="21" style="v" sid="GEN 15:21"/>አሞሮታ፣ ከነኣኖታ ግርጋሾታቲፊ ከን ዬቡሶታ ጄቹዸ።”<verse eid="GEN 15:21"/></para>
  <chapter eid="GEN 15"/>
  <chapter number="16" style="c" sid="GEN 16"/>
  <para style="s1">አጋሪፊ እሽማኤል</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 16:1"/>ሶራን ኒቲን አብራም እጆሌ እሳፍ ህንዴኜ ቱርቴ። ገሩ እሼን ገርብቲ አጋር ጄዸምቱ ቶኮ ቀብድ ቱርቴ፤ አጋርስ ነመ ብየ ግብጥ ቱርቴ፤ <verse eid="GEN 16:1"/><verse number="2" style="v" sid="GEN 16:2"/>ሶራንስ አብራሚን፣ “ኩኖ <char style="nd">ዋቀዮ</char> እጆሌ ነ ዾወቴረ። ዸቂቲ ገርብቲኮ ወጅን ጪስ፤ ተሪ አን ከራሼቲን እጆሌ ነንአርገዸን ተኣቲ” ጄቴ።</para>
  <para style="p" vid="GEN 16:2">አብራምስ ዋን ሶራን ጄቴ ፉዸቴ። <verse eid="GEN 16:2"/><verse number="3" style="v" sid="GEN 16:3"/>ኤርገ አብራም ወጋ ኩዸን ከነኣን ኬሰ ጅራቴ ቦዴ ኒቲንሳ ሶራን ገርብቲሼ አጋር ከን ነመ ብየ ግብጥ ቱርቴ ሰነ ፉቴ አከ እሼን ኒቲሳ ታቱፍ ዽርሰሼቲፍ ኬንቴ። <verse eid="GEN 16:3"/><verse number="4" style="v" sid="GEN 16:4"/>አብራምስ አጋር ወጅን ጪሴ፤ እሼንስ ንኡልፎፍቴ።</para>
  <para style="p" vid="GEN 16:4">ዮሙ አከ ኡልፎፍቴ ኦፍረት ቤክቴት ጊፍቲሼ ቱፈቹ ጀልቀብዴ። <verse eid="GEN 16:4"/><verse number="5" style="v" sid="GEN 16:5"/>ሳራንሞ አብራሚን፣ “ሚዻ ነ ሙደቴ ከነት ስቱ ጋፈተመ። ገርብቲኮ አነቱ ቦባኬ ጀለ ሲፍ ገልቼ፤ አመ ገሩ እሼን አከ ኡልፎፍቴ ኦፍረት ቤክናን ነ ቱፈቴ። ኤጋ <char style="nd">ዋቀዮ</char> ሲፊ አነ ግዱት ሙርቲ ሃኬኑ” ጄቴ።<verse eid="GEN 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 16:6"/>አብራምስ፣ “ገርብቲንኬ ሀርኩመኬ ጅርት፤ ዋኑመ ፌቴ እሼ ጎዽ” ጄዼን። ሶራንስ አከ መሌ እሼ ጩንቁርስቴ፤ ከናፉ አጋር ፉለሼ ዱራ ሶክቴ።<verse eid="GEN 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 16:7"/>ኤርገማን <char style="nd">ዋቀዮ</char> ገሞጂ ኬሰት፣ ቡርቃ ብሻኒ ቶኮ ብረት አጋርን አርጌ፤ ቡርቃን ብሻኒ ሱንስ ከራ ሹርት ጌሱረ ቱሬ። <verse eid="GEN 16:7"/><verse number="8" style="v" sid="GEN 16:8"/>ኤርገማን ሱንስ፣ “ያ አጋር፣ ገርብቲ ሳራ፣ አት ኤሳ ዹፍቴ? ኤሰ ዸቁት ጅርተ?” ጄዼ።</para>
  <para style="p" vid="GEN 16:8">እሼንስ፣ “ጊፍቲኮ ሳራ በቀቹትን ጅረ” ጄቴን።<verse eid="GEN 16:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 16:9"/>ከነረት ኤርገማን <char style="nd">ዋቀዮ</char> ሱን፣ “ገረ ጊፍቲኬቲት ዴብእ፤ ገድ ኦፍ ቀቢቲ እሼፍ ቡል” ጄዼን። <verse eid="GEN 16:9"/><verse number="10" style="v" sid="GEN 16:10"/>ኤርገማን ዋቀዮ ሱንስ እት ደበሌ፣ “አን ሰኚኬ አከ መሌ ነንባይእሰ፤ ሰበቢ ባይእነሳቲፍስ ነምን ቶኮዩ ለካኡ ህንደንደኡ” ጄዼ።<verse eid="GEN 16:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 16:11"/>ኤርገማን <char style="nd">ዋቀዮ</char> ሱን አመሌ አከነ እሼን ጄዼ፤</para>
  <para style="q1" vid="GEN 16:11">“ኩኖ አት ኡልፎፍቴርተ፤</para>
  <para style="q2" vid="GEN 16:11">እልመስ ንዴሰ።</para>
  <para style="q1" vid="GEN 16:11">መቃሳስ እሽማኤል ጄዺ ሞጋስ፤</para>
  <para style="q2" vid="GEN 16:11">
    <char style="nd">ዋቀዮ</char> ዽጰቹኬ ዸገኤራቲ።<verse eid="GEN 16:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="GEN 16:12"/>እን ነመ አከ ሀሬ ዲዳ ተአ፤</para>
  <para style="q2" vid="GEN 16:12">ሀርክሳ ነመ ሁንደረት ከአ፤</para>
  <para style="q2" vid="GEN 16:12">ሀርክ ነመ ሁንዳስ እሰረት ከአ፤</para>
  <para style="q1" vid="GEN 16:12">ኦቦሎተሳ ሁንዳንስ ጅበማ ጅራተ።”<verse eid="GEN 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 16:13"/>እሼንስ መቃ <char style="nd">ዋቀዮ</char> እሼት ዱበቴ ሰና፣ “ኤልሮኢ” ጄቴ ዋምቴ። እሼን፣ “አን ዹጉማን እሰ ነ አርጉ ሰነ አርጌረ” ጄቴርቲቲ። <verse eid="GEN 16:13"/><verse number="14" style="v" sid="GEN 16:14"/>ሰበቢን ቦል ብሻኒ ሱን፣ “ቤኤር ለሃይሮኢ” ጄዸሜፍስ ከኑመ። እንስ ሀመ ሀርኣትሌ ቃዴሺፊ ቤሬድ ግዱ ጅረ።<verse eid="GEN 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 16:15"/>አጋርስ አብራሚፍ እልመ ዴሴ፤ አብራምስ እልመ እሼን ዴሴ ሰነ እሽማኤል ጄዼ ሞጋሴ። <verse eid="GEN 16:15"/><verse number="16" style="v" sid="GEN 16:16"/>ዬሮ አጋር እሽማኤልን እሳፍ ዴሴት አብራም ነመ ወጋ ሰዴተሚ ጀኣ ቱሬ።<verse eid="GEN 16:16"/></para>
  <chapter eid="GEN 16"/>
  <chapter number="17" style="c" sid="GEN 17"/>
  <para style="s1">ከኩ ዸግነ ቀባ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 17:1"/>ዬሮ አብራም ነመ ወጋ ሰገልተሚ ሰገሊ ቱሬት <char style="nd">ዋቀዮ</char> እሰት ሙልአቴ አከነ ጄዼን፤ “አን ዋቀ ዋን ሁንዱማ ደንደኡዸ፤ አት ፉለኮ ዱረ አመነሙማን ዴዴብእ፤ ህርእነስ ህንቀባትን። <verse eid="GEN 17:1"/><verse number="2" style="v" sid="GEN 17:2"/>አን ከኩኮ አናፊ ስ ግዱ ነንዻበ፤ ጉዳስ ስን ባይእሰ።”<verse eid="GEN 17:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 17:3"/>አብራምስ አደሳቲን ለፈት ጎምብፈሜ፤ ዋቅንስ አከነ እሳን ጄዼ፤ <verse eid="GEN 17:3"/><verse number="4" style="v" sid="GEN 17:4"/>“ኩኖ፣ ከኩን አን ስ ወጅን ገሉ ከነ፦ አት አባ ሰበ ባይኤ ታተ። <verse eid="GEN 17:4"/><verse number="5" style="v" sid="GEN 17:5"/>አት ስአች አብራም ጄዸምቴ ህንዋመምቱ፤ ዋን አን አባ ሰቦተ ባይኤ ስ ታስሴፍ መቃንኬ አብረሃም ተአ። <verse eid="GEN 17:5"/><verse number="6" style="v" sid="GEN 17:6"/>አን አከ አት ጉዳ ባይአቱ ነንጎዸ፤ አከ ሰብን ሄዱን ስ ኬሳ አርገሙ ነንጎዸ፤ ሞቶትንስ ስ ኬሳ ንአርገሙ። <verse eid="GEN 17:6"/><verse number="7" style="v" sid="GEN 17:7"/>አን ዋቀኬቲፊ ዋቀ ሰኚኬ ከን ስ ዱባን ዹፉ ተኡፍ ጄዼ ከኩኮ አነ፣ ሲፊ ሰኚኬ ከን ስ ዱባ፣ ዸሎተ ዹፉፍ ጅሩ ግዱት ከኩ በረ በራ ጎዼ ነንዻበ። <verse eid="GEN 17:7"/><verse number="8" style="v" sid="GEN 17:8"/>ብየ ከነኣን ጉቱ ለፈ አት አመ ኦርመ ታቴ ጅራቱ ከነ አን ዻለ በረ በራ ጎዼ ስኢፊ ሰኚወንኬ ወረ ስ ቦዴቲፍ ነንኬነ፤ አንስ ዋቀሳኒ ነንተአ።”<verse eid="GEN 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 17:9"/>ዋቅን አብረሃሚን አከነ ጄዼ፤ “አትሞ ከኩኮ ኤጉ ቀብደ፤ አት፣ ሰኚንኬ ወር ስ ዱባስ ዸሎተሳኒ ኬሰት ከኩኮ ኤጉ ቀብዱ። <verse eid="GEN 17:9"/><verse number="10" style="v" sid="GEN 17:10"/>ከኩንኮ ከን እስን አናፊ ስእ ግዱት፣ ሰኚኬ ከን ስእ ዱባን ዹፉ ግዱትስ ኤጉ ቀብደን ከናዸ፤ እንስ እስን ኬሳ ዺር ሁንድኑ ዸግነ ሃቀበቱ። <verse eid="GEN 17:10"/><verse number="11" style="v" sid="GEN 17:11"/>ቆለኬሰን ዸግነ ቀበዻ፤ ኩንስ ከኩ አናፊ እስን ግዱ ጅሩፍ መለቶ ተአ። <verse eid="GEN 17:11"/><verse number="12" style="v" sid="GEN 17:12"/>እስን ኬሳ ዺር ጉያ ሰዴት ጉቴ ዸግነ ሃቀበቱ፤ ዸሎተኬሰን ሁንደ ኬሰት ዺር መነኬት ዸለቴ ዮካን ከን ነመ ብየ ኦርማራ ማለቀኬቲን ብተሜ ሁንድ ከን ሰኚኬ ህንተእን ዸግነ ሃቀበቱ። <verse eid="GEN 17:12"/><verse number="13" style="v" sid="GEN 17:13"/>መነኬት ዸለተንስ ዮካን ማለቀኬቲን ብተመንስ እሳን ዸግነ ሃቀበተን። ከኩንኮ ከን ፎንኬሰንረት ጎዸሜ ኩን ከኩ በረ በራ ተአ። <verse eid="GEN 17:13"/><verse number="14" style="v" sid="GEN 17:14"/>ዺር ዸግነ ህንቀበትን፣ ከን ቆለ ፎንሳ ዸግነ ህንቀበትን ከምዩ ሰበ ኦፊሳ ኬሳ በሌፈመ፤ እን ከኩኮ ጨብሴራቲ።”<verse eid="GEN 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 17:15"/>ዋቅን አመስ አብረሃሚን አከነ ጄዼ፤ “አት ስአች ኒቲኬ ሶራዻን፣ ሶራ ህንጄቱ፤ መቃንሼ ሳራ ተአ። <verse eid="GEN 17:15"/><verse number="16" style="v" sid="GEN 17:16"/>አን እሼ ነንኤብሰ፤ እሼራስ እልመ ሲፍ ነንኬነ። አከ እሼን ሃዸ ሰቦታ ታቱፍስ እሼ ነንኤብሰ፤ ሞቶትን ሰቦታስ እሼ ኬሳ አርገሙ።”<verse eid="GEN 17:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 17:17"/>አብረሃምስ አዳን ጎምብፈሜ፤ ኮልፌስ፣ “ነመ ወጋ ዽባቲፍ እልም ንዸለታ? ሳራንስ ወጋ ሰገልተመት ሙጫ ዴሲ?” ጄዼ ያዴ። <verse eid="GEN 17:17"/><verse number="18" style="v" sid="GEN 17:18"/>አብረሃምስ ዋቃን፣ “ማሎ ኡቱ እሽማኤል ፉለኬ ዱረ ና ጅራቴ!” ጄዼ።<verse eid="GEN 17:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 17:19"/>ዋቅንስ አከነ ጄዼ፤ “ቶሌ፤ ገሩ ኒቲንኬ ሳራን እልመ ሲፍ ዴስ፤ መቃሳስ ይስሃቅ ጄዺ ሞጋስ። አንስ ከኩኮ ሰኚሳ ከን እሰ ዱባን ዹፉፍ ከኩ በረ በራ ጎዼ እሰ ወጅን ነንዻበ። <verse eid="GEN 17:19"/><verse number="20" style="v" sid="GEN 17:20"/>ዋኤ እሽማኤልሞ አን ስ ዸገኤረ፤ ኩኖ አን፣ እሰ ነንኤብሰ፤ አከ እን ባይአቱ ነንጎዸ፤ ጉዳ እሰ ነንባይእሰ። እን አባ ቡልችቶተ ኩዸ ለማ ተአ፤ አንስ ሰበ ጉዳ እሰ ነንጎዸ። <verse eid="GEN 17:20"/><verse number="21" style="v" sid="GEN 17:21"/>ከኩኮ ገሩ ይስሃቅ እሰ ሳራን ወጋ ዹፉ ኬሰ ዬሮ ከነት ሲፍ ዴሱ ወጅን ነንዻበ።” <verse eid="GEN 17:21"/><verse number="22" style="v" sid="GEN 17:22"/>ዋቅን ኤርገ አብረሃም ወጅን ሃሰኤ ፍጠቴ ቦዴ እሰ ብራ ኦል በኤ።<verse eid="GEN 17:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 17:23"/>አብረሃምስ ጉዩመ ሰነ እልማንሳ እሽማኤሊፊ ወረ መነሳት ዸለተን ዮካን ወረ ማለቀሳቲን ብተመን ሁንደ፣ ዺረ መነሳ ሁንዱማስ ፉዼ አኩመ ዋቅን እሰት ህሜት ዸግነ ቀቤ። <verse eid="GEN 17:23"/><verse number="24" style="v" sid="GEN 17:24"/>አብረሃም ዬሮ ዸግነ ቀበቴት ነመ ወጋ ሰገልተሚ ሰገሊ ቱሬ። <verse eid="GEN 17:24"/><verse number="25" style="v" sid="GEN 17:25"/>እልምሳ እሽማኤልሞ ዬሮ ዸግነ ቀበቴት ነመ ወጋ ኩዸ ሰዲ ቱሬ። <verse eid="GEN 17:25"/><verse number="26" style="v" sid="GEN 17:26"/>አብረሃሚፊ እልምሳ እሽማኤል ጉዩመ ሰነ ዸግነ ቀበተን። <verse eid="GEN 17:26"/><verse number="27" style="v" sid="GEN 17:27"/>ዺር መነ አብረሃም ሁንድኑ፣ ወር መነሳት ዸለተን ዮካን ወር ኦርመራ ማለቃን ብተመንስ እሰ ወጅን ዸግነ ቀበተን።<verse eid="GEN 17:27"/></para>
  <chapter eid="GEN 17"/>
  <chapter number="18" style="c" sid="GEN 18"/>
  <para style="s1">ኬሱሞተ ሰደን</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 18:1"/>ኡቱመ አብረሃም ጉያ ሳፋዻን ቅልጡ መምሬ ብረ በልበለ ዱንካነሳ ዱረ ታኤ ጅሩ <char style="nd">ዋቀዮ</char> እሰት ሙልአቴ። <verse eid="GEN 18:1"/><verse number="2" style="v" sid="GEN 18:2"/>አብረሃምስ ኦል እላሌ ነሞተ እሰ ብረ ዸዻበተን ሰዲ አርጌ። እንስ አኩመ እሳን አርጌን በልበለ ዱንካነሳ ዱራ ከኤ እሳን ስመቹዻፍ እት ፊጌ፤ ሀመ ለፈ ገኡትስ ገድ ጄዼ ሀርከ ፉዼ።<verse eid="GEN 18:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 18:3"/>እንስ አከነ ጄዼን፤ “ጎፍታኮ፣ ዮ አን ስ ዱረት ፉዸተመ አርገዼ፣ ገርብቸኬ ብረ ህንደርብን። <verse eid="GEN 18:3"/><verse number="4" style="v" sid="GEN 18:4"/>ብሻን ጥኖ እስኒፍ ሃፍደን፤ ሚለ ዽቀዻቲ ሙከ ከነ ጀለ ቦቆዻ። <verse eid="GEN 18:4"/><verse number="5" style="v" sid="GEN 18:5"/>ኤርገ እስን ገረ ገርብቸኬሰኒ ዹፍተኒ፣ አን አከ እስን ደዸቢ ባተኒ ከራኬሰን እት ፉፍተኒፍ ዋን እስን ኛተን እስኒፍን ኬነ።”</para>
  <para style="p" vid="GEN 18:5">እሳንስ፣ “አኩመ ጄቴ ሰነ ጎዽ” ጄዸኒ ዴብሰን።<verse eid="GEN 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 18:6"/>ከናፉ አብረሃም ደፌ ሳራት ዱንካነ ሴኔ፣ “ደፊ ዳኩ ቡላኣ ሰፈርቱ ሰዲ ሱኩሚቲ መጥኖ ቶልች” ጄዼን።<verse eid="GEN 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 18:7"/>እንስ ገረ ሳወኒት ፊጌ ጀቢ ገበቴ እት ቶሌ ቶኮ ፍለቴ ሆጄታ ቶኮት ኬኔ፤ ሆጄታን ሱንስ ቆጴሱፍ አሪፈቴ። <verse eid="GEN 18:7"/><verse number="8" style="v" sid="GEN 18:8"/>አብረሃምስ እትቱፊ ኣነን፣ ፎን ጀቢ ቆጴፈሜ ሰነስ ጌሴ እሳኒ ዽኤሴ፤ ዬሮ እሳን ኛቻ ቱረንትስ አብረሃም ሙከ ቶኮ ጀለ እሳን ብረ ዻበቻ ቱሬ።<verse eid="GEN 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 18:9"/>እሳንስ፣ “ኒቲንኬ ሳራን ኤሰ ጅርት?” ጄዸኒ እሰ ጋፈተን።</para>
  <para style="p" vid="GEN 18:9">እንስ፣ “ኩኖ ዱንካነ ኬሰ ጅርት” ጄዼን።<verse eid="GEN 18:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 18:10"/>እሳን ኬሳ ቶኮ፣ “አን ዹጉማን በረ ዹፉ ኬሰ ዬሮ አከናት ዴብኤ ገረኬ ነንዹፈ፤ ኒቲንኬ ሳራንስ እልመ ንዴስ” ጄዼ።</para>
  <para style="p" vid="GEN 18:10">ዬሮ ሰነ ሳራን በልበለ ዱንካና ከን እሰ ዱባን ጅሩ ኬሳን ዸጌፈቻ ቱርቴ። <verse eid="GEN 18:10"/><verse number="11" style="v" sid="GEN 18:11"/>አብረሃሚፊ ሳራን ኡሙሪንሳኒ ዼረቴ ዱሎመኒ ቱረን፤ ሳራንስ ኡሙሪ እት ሙጫ ደኡ ደንዴሱ ደበርቴ ቱርቴ። <verse eid="GEN 18:11"/><verse number="12" style="v" sid="GEN 18:12"/>ከናፉ ሳራን፣ “አን ኤርገን ጃሬ ቡቱቴ፣ ጎፍታንኮስ ኤርገ ዱሎሜ ቦዴ፣ ገመቹ ከነ ቀባቹ ነንደንደኣ?” ጄቴ ኦፍ ኬሰት ኮልፍቴ።<verse eid="GEN 18:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 18:13"/>ከነረት <char style="nd">ዋቀዮ</char> አብረሃሚን አከነ ጄዼ፤ “ሳራን ማሊፍ፣ ‘አን ኤርገን ዱሎሜ ቦዴ አመ ዹጉማን ሙጫ ነንደኣ?’ ጄቴ ኮልፍቴ? <verse eid="GEN 18:13"/><verse number="14" style="v" sid="GEN 18:14"/>ወን <char style="nd">ዋቀዮፍ</char> ህንደንደአምኔ ቶኮዩ ጅራ? አን በረ ዹፉ ኬሰ ዬሮ ሙርቴፈሜት ዴብኤ ገረኬ ነንዹፈ፤ ሳራንስ እልመ ንዴስ።”<verse eid="GEN 18:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 18:15"/>ሳራንስ ዋን ሶዳቴፍ ሶብዴ፣ “አን ህንኮልፍኔ” ጄቴ።</para>
  <para style="p" vid="GEN 18:15">እን ገሩ፣ “ለኪ ኮልፍቴርታ” ጄዼ።<verse eid="GEN 18:15"/></para>
  <para style="s1">አብረሃም ሶዶሚፍ ከዸቹሳ</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 18:16"/>ነሞትን ሱን ዮሙ ዴሙፍ ከአንት ገረ ሶዶም ገድ እላለን፤ አብረሃምስ እሳን ጌጌሱፍ ጄዼ እሳን ወጅን በኤ። <verse eid="GEN 18:16"/><verse number="17" style="v" sid="GEN 18:17"/>ኤርገሲ <char style="nd">ዋቀዮ</char> አከነ ጄዼ፤ “አን ዋነን ጎቹፍ ጅሩ አብረሃምን ነንዾክሳ? <verse eid="GEN 18:17"/><verse number="18" style="v" sid="GEN 18:18"/>አብረሃም ዹጉማን ሰበ ጉዳፊ ጀባ ተአ፤ ሰብን ለፈራ ሁንድኑ ከራሳቲን ኤብፈመ። <verse eid="GEN 18:18"/><verse number="19" style="v" sid="GEN 18:19"/>አከ እን እጆሌሳቲፊ ሰኚሳ ወረ እሰ ዱባን ዹፈን፣ አከ እሳን ዋን ቀጄላፊ ስሪ ተኤ ሆጄቹዻን ከራ <char style="nd">ዋቀዮ</char> ኤገን አጀጁፍ አን እሰ ፍለዼራቲ፤ ኩንስ አከ <char style="nd">ዋቀዮ</char> ዋን አብረሃሚፍ ከከቴ ሰነ እሳፍ ጉቱፍ።”<verse eid="GEN 18:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 18:20"/>
    <char style="nd">ዋቀዮስ</char> አከነ ጄዼ፤ “እይ ሶዶሚፊ ጎሞራረት እየሜ ጉዳዸ፤ ጩቡንሳኒስ ዋን አከ መሌ ሀማ ተኤፍ <verse eid="GEN 18:20"/><verse number="21" style="v" sid="GEN 18:21"/>አን ገድ ቡኤ አከ ወን እሳን ሆጄተን አኩመ እየ ነ ቀቀቤ ሰና ሀማ ተኤ ነንእላለ። ዮ አከስ ተኡ ባቴሞ ነቱ ቤከ።”<verse eid="GEN 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 18:22"/>ነሞትን ሱንስ ገረ ገለኒ ሶዶምት ቀጄለን፤ አብረሃም ገሩ <char style="nd">ዋቀዮ</char> ዱረ ዻበቴ ሀፌ። <verse eid="GEN 18:22"/><verse number="23" style="v" sid="GEN 18:23"/>አብረሃምስ እሰት ዽኣቴ አከነ ጄዼ፤ “አት ነመ ቀጄላ ነመ ጀልኣ ወጅን ንበሌስታ? <verse eid="GEN 18:23"/><verse number="24" style="v" sid="GEN 18:24"/>ዮ ነሞትን ቀጄሎን ሸንተምን መጋለቲ ኬሰ ጅራተንሆ? አት ዹጉማን እሼ ንበሌስታ? ሰበቢ ቀጄሎተ ሸንተመን እሼ ኬሰ ጅራተን ሰናቲፍ ጄቴ እሼ ህንኦልችቱ? <verse eid="GEN 18:24"/><verse number="25" style="v" sid="GEN 18:25"/>ቀጄላፊ ሀማ ወል ቅጤ እላሉዻን ነመ ቀጄላ ነመ ሀማ ወጅን በሌሱን ስራ ሃፈጋቱ። ኩን ስራ ሃፈጋቱ! አባን ሙርቲ ለፈ ሁንዳ ዋን ቀጄላ ህንሆጄቱ?”<verse eid="GEN 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 18:26"/>
    <char style="nd">ዋቀዮስ</char>፣ “አን ዮ መጋላ ሶዶም ኬሰት ቀጄልቶተ ሸንተመ አርገዼ፣ እሳኒፍ ጄዼ እዶ ሰነ ጉቱ ነንኦልቸ” ጄዼ።<verse eid="GEN 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 18:27"/>አብረሃም አመስ አከነ ጄዼ፤ “ኩኖ አን ኡቱመን አዋራፊ ዳራ ተኤ ጅሩ ጎፍታት ዱበቹፍ እጀ ጀባዼረ፤ <verse eid="GEN 18:27"/><verse number="28" style="v" sid="GEN 18:28"/>ዮ ባይእን ቀጄልቶታ ሸንተመራ ሸን ህርአቴሆ? አት ሰበቢ ነሞተ ሸነን ሰናቲፍ ጄቴ መጋላ ሰነ ጉቱ ንበሌስታ?”</para>
  <para style="p" vid="GEN 18:28">እንስ፣ “አን ዮ ነመ አፉርተሚ ሸን አችት አርገዼ እሼ ህንበሌሱ” ጄዼ።<verse eid="GEN 18:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 18:29"/>አብረሃም አመሌ፣ “ዮ ቀጄልቶትን አፉርተምን ቆፍት አችት አርገመንሆ?” ጄዼ እሰት ዱበቴ።</para>
  <para style="p" vid="GEN 18:29">ጎፍታንስ፣ “አን ወረ አፉርተመ ሰናፍ ጄዼ ነንዺሰ” ጄዼ።<verse eid="GEN 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 18:30"/>አብረሃምስ፣ “ሜ ነንዱበዻቲ ጎፍታን፣ ህንኣርን። ዮ ነሞትን ሶዶምን ቆፍት አችት አርገመንሆ?” ጄዼ።</para>
  <para style="p" vid="GEN 18:30">ጎፍታንስ፣ “አን ዮን ነመ ሶዶመ አችት አርገዼ እሼ ህንበሌሱ” ጄዼ ዴብሴ።<verse eid="GEN 18:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 18:31"/>አብረሃምስ፣ “ኩኖ አመ ኤርገ አን ጎፍታት ዱበቹፍ እጀ ጀባዼ፣ ዮ ነሞትን ድግደምን ቆፍት አችት አርገመንሆ?” ጄዼ።</para>
  <para style="p" vid="GEN 18:31">ጎፍታንስ፣ “አን ሰበቢ ነሞተ ድግደመ ሰናቲፍ ጄዼ እሼ ህንበሌሱ” ጄዼ።<verse eid="GEN 18:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 18:32"/>አብረሃምስ፣ “ያ ጎፍታ አመሌ ዬሮ ቶኮ ዋ ስን ጋፈዻቲ ማሎ ህንኣርን፤ ዮ ነምን ኩዸን ቆፍት አችት አርገሜሆ?” ጄዼ።</para>
  <para style="p" vid="GEN 18:32">ጎፍታንሞ፣ “አን ሰበቢ ነሞተ ኩርነን ሰናቲፍ ጄዼ እሼ ህንበሌሱ” ጄዼ።<verse eid="GEN 18:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 18:33"/>
    <char style="nd">ዋቀዮስ</char> ኤርገ አብረሃም ወጅን ዱበቴ ፍጤ ቦዴ አቺ ዴሜ። አብረሃምሞ እዶ ኦፊሳት ዴብኤ።<verse eid="GEN 18:33"/></para>
  <chapter eid="GEN 18"/>
  <chapter number="19" style="c" sid="GEN 19"/>
  <para style="s1">በዲሰ ሶዶሚቲፊ ጎሞራ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 19:1"/>ኤርገሞትን ዋቀዮ ሱን ለማን ገልገለ ሰነ ሶዶም ገአን፤ ሎጥስ ከረ ሶዶሚ ዱረ ታኣ ቱሬ። እንስ ዬሮ ጀረ አርጌት፣ እሳን ስመቹፍ ከኤ እሳንት ዴሜ፤ ገድ ጄዼስ አደሳቲን ለፈት ጎምብፈሜ። <verse eid="GEN 19:1"/><verse number="2" style="v" sid="GEN 19:2"/>እንስ፣ “ያ ጎፍቶተኮ፣ ማሎ መነ ገርብቸኬሰኒት ጎራቲ ሚለ ዽቀዻ ቡላ፤ በሪ በራቃን ካተኒ ከራኬሰን እት ፉፉ ደንዴሱ” ጄዼ።</para>
  <para style="p" vid="GEN 19:2">እሳንሞ፣ “ህንተኡ፤ ኑ ወልተጂ ከራረ ቡላ” ጄዸኒን።<verse eid="GEN 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 19:3"/>እን ገሩ አከ መሌ እሳን ድርቅሲሴ፤ ከናፉ ጎረኒ መነሳ ሴነን፤ እንስ መጥኖ ቶልቼ ኛተ ቆጴሴፍ፤ እሳንስ ንኛተን። <verse eid="GEN 19:3"/><verse number="4" style="v" sid="GEN 19:4"/>ኡቱ እሳን ህንረፍን ነሞትን ኩታሌ መጋላ ሶዶም ሁንደ ኬሳ ዹፈን ሁንድ ደርገጎትኒፊ ጃርሶሊን መነ ሰነ መርሰን። <verse eid="GEN 19:4"/><verse number="5" style="v" sid="GEN 19:5"/>እሳንስ ሎጥን ዋመኒ፣ “ነሞትን ገልገለ ከነ ገረኬ ዹፈን ኤሰ ጅሩ? አከ ኑ እሳን ወጅን ጪፍኑፍ ገድ ኑ ያስ” ጄዸን።<verse eid="GEN 19:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 19:6"/>ሎጥስ ጀረ ሰነት ገድ በኤ በልበለ ኦፍ ዱባን ጩፌ፤ <verse eid="GEN 19:6"/><verse number="7" style="v" sid="GEN 19:7"/>አከነስ ጄዼ፤ “ያ ኦቦሎተኮ፣ ዋን ሀማ ከነ ህንሆጄትና! <verse eid="GEN 19:7"/><verse number="8" style="v" sid="GEN 19:8"/>ኩኖ አን እንተለን ለመ ከኔን ተኩማ ዺረ ወጅን ህንጪስን ቀበ። ለማኑ ገድ እስኒ ነንባሰ፤ እስንስ ዋን ፌተን እሳን ጎቹ ደንዴሱ። ነሞተ ከኔን ገሩ ዋን እሳን በንቲ መነኮ ጀለ ጅረኒፍ ሆማ እሳን ህንጎዽና።”<verse eid="GEN 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 19:9"/>እሳንስ፣ “በድ አሲ!” ጄዸኒን። እቱመ ፉፈኒስ፣ “ነምች ኩን ነመ ኦርማ ከን ኑ ኬሰ ጅራቹ ዹፌዸ፤ አመሞ አባ ሙርቲ ኑት ተኡ ፌዸ! ኑ ዋን ሀማ ጀረረት ሆጄትኑ ጫላ ስረት ሆጄትነ” ጄዸኒን። እሳንስ ሎጥን ሁምናን ዺበኒ በልበለ ሰነ ጨብሱ ገአን።<verse eid="GEN 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 19:10"/>ነሞትን ሱንስ ሂጠተኒ ሎጥን ሀርክሰኒ መነት ኦል ዴብሰን፤ በልበልቸስ ንጩፈን። <verse eid="GEN 19:10"/><verse number="11" style="v" sid="GEN 19:11"/>ኤርገሲሞ ነሞተ በልበለ መና ዱረ ቱረን ሰነ አከ እሳን በልበልቸ ህንአርግኔፍ ጥናፊ ጉዳሳኒ ዸእቻን እጀ ጃምሰን።<verse eid="GEN 19:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 19:12"/>ነሞትን ለማን ሱን ሎጢን አከነ ጄዸን፤ “አት ነመ ብራ ቶኮሌ ጄቹንስ ሶዶተ፣ እልማን ዮካን እንተለን ዮካን ነመ ከንኬ ተኤ ቶኮሌ መጋላ ከነ ኬሳ ቀብዳ? አስ ኬሰ እሳን ባፈዹ፤ <verse eid="GEN 19:12"/><verse number="13" style="v" sid="GEN 19:13"/>ኑ እዶ ከነ በሌሱፍ ዴምናቲ። ሰበቢ እይ ሰበሼረት እየሜ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ጉዳ ተኤፍ፣ ዋቅን አከ ኑ እሼ በሌስኑፍ ኑ ኤርጌረ።”<verse eid="GEN 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 19:14"/>ከናፉ ሎጥ ገድ በኤ ሶዶተሳ ወረ እንተለንሳ ፉዹፍ ጅረኒን፣ “ሰበቢ <char style="nd">ዋቀዮ</char> መጋላ ከነ በሌሱፍ ከኤፍ፣ ደፋቲ አሲ በኣ!” ጄዼ። ሶዶንሳ ገሩ ዋን እን ቆሱ ሴአን።<verse eid="GEN 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 19:15"/>ዬሮ ቦሩን ዲመቴት ኤርገሞትን ዋቀዮ ሱን ሎጥን ጀርጀርሰኒ፣ “ኒቲኬቲፊ እንተለንኬ ለማን አስ ጅረን ፉዸዹቲ ደፊ በእ! ዮ ከና አቺ ዬሮ መጋለቲን አደበምቱት አትስ ንበዳ” ጄዸኒን።<verse eid="GEN 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 19:16"/>እን ገሩ ዱበት ሀርክፈቴ፤ ዋን <char style="nd">ዋቀዮ</char> እሳኒፍ ገራ ላፌፍ ነሞትን ሱን ሀርከሳቲፊ ሀርከ ኒቲሳ፣ እንተለንሳ ለማንስ ሀርከ ቀበኒ መጋለቲ ኬሳ እሳን ባሰን። <verse eid="GEN 19:16"/><verse number="17" style="v" sid="GEN 19:17"/>አኩመ ገድ እሳን ባሰኒንስ ኤርገሞተ ሰነ ኬሳ እን ቶኮ፣ “ሉቡኬ ኦልፈቹፍ በቀዹ! ኦፍ ዱበ ህንምልአትን! ድሬረ እዶ ቶኮሌ ህንዻበትን! ቱሉወንት ኦል በቀዹ፤ ዮ ከና አቺ ንበዳ!” ጄዼ።<verse eid="GEN 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 19:18"/>ሎጥ ገሩ አከነ እሳኒን ጄዼ፤ “ያ ጎፍቶተኮ፣ ማሎ አከስ ምት! <verse eid="GEN 19:18"/><verse number="19" style="v" sid="GEN 19:19"/>ኩኖ ገርብችኬ ፉለኬ ዱረት ፉዸተመ አርገቴረ፤ አት ሉቡኮ ኦልችቴ ገረ ላፍነ ጉዳ ነ አርግሲፍቴርተ። አን ገሩ ገረ ቱሉት ኦል በቀቹ ህንደንደኡ፤ በላን ኩን ነ አርገተ፤ አንስ ነንዱአ። <verse eid="GEN 19:19"/><verse number="20" style="v" sid="GEN 19:20"/>ኩኖ፣ መጋላን እት በቀቹን ደንደአሙ ቶኮ አስ ዽኦ ጅርት፤ እሼን ጥኖዸ። አን ገረሼት ነንበቀዸ፤ እሼን ባይኤ ጥኖዸ ምቲ? አከስት ሉቡንኮ ንበራረምት።”<verse eid="GEN 19:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 19:21"/>ኤርገማን ሱንስ አከነ ጄዼን፤ “ኩኖ፣ አን ከዻ ከነ ሲፍ ነንዸገአ፤ መጋላ አት ዋኤሼ ዱበቱ ከነ አን ህንበሌሱ። <verse eid="GEN 19:21"/><verse number="22" style="v" sid="GEN 19:22"/>ገሩ ሰበቢ አን ሀመ አት አች ጌሱት ሆማ ጎቹ ህንደንዴኜፍ ደፊ አችት በቀዹ!” ወን መጋላን ሱን ዞኣር ጄዸምቴፍስ ከኑመ።<verse eid="GEN 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 19:23"/>ዬሮ ሎጥ ዞኣር ገኤት አዱን ባቴ ቱርቴ። <verse eid="GEN 19:23"/><verse number="24" style="v" sid="GEN 19:24"/><char style="nd">ዋቀዮ</char> ሰሚወን ኬሳ <char style="nd">ዋቀዮ</char> ብራ፣ ድኚ ቦበኡ ሶዶሚፊ ጎሞራረት ሮብሴ። <verse eid="GEN 19:24"/><verse number="25" style="v" sid="GEN 19:25"/>እንስ አከሲን መጋላወን ከኔኒፊ ድሬወን ሰነ ጉቱ፣ ወረ መጋላወን ሰነ ኬሰ ጅራተን ሁንዳፊ ብቅልቱ ብየ ሰና በሌሴ። <verse eid="GEN 19:25"/><verse number="26" style="v" sid="GEN 19:26"/>ኒቲን ሎጥ ገሩ ኦፍ ዱበ እላልቴ ኡቱባ ሶግዳ ታቴ ሀፍቴ።<verse eid="GEN 19:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 19:27"/>አብረሃምስ ጉያ እት ኣኑ ገነመ ኦቦሮን ከኤ እዶ ዱራን ፉለ <char style="nd">ዋቀዮ</char> ዱረ ዻበቻ ቱሬ ሰነት ዴብኤ። <verse eid="GEN 19:27"/><verse number="28" style="v" sid="GEN 19:28"/>እንስ ገረ መጋላወን ሶዶሚፊ ጎሞራ፣ ገረ ለፈ ድሬ ሰና ሁንዳስ እላሌ ኣረ አከ ኣረ ቦለ እብዳ ኬሳ በኡ ቶኮሳ ብየ ሰነ ኬሳ ኦል ከኡ አርጌ።<verse eid="GEN 19:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 19:29"/>ዋቅን ዬሮ መጋላወን ድሬ ሰና በሌሴት አብረሃምን ያደቴ፤ ከናፉ ዮሙ መጋላወን ሎጥ ኬሰ ጅራቻ ቱሬ በሌሴት ሎጥን በላ ሰነ ኬሳ ባሴ።<verse eid="GEN 19:29"/></para>
  <para style="s1">ሎጢፊ እንተለንሳ</para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 19:30"/>ሎጥ ዋን ዞኣር ኬሰ ጅራቹ ሶዳቴፍ እንተለንሳ ለማን ወጅን ዞኣሪ በኤ ጋረንረ ቁበቴ። እንስ እንተለንሳ ለማን ወጅን ሆልቀ ቶኮ ኬሰ ጅራቴ። <verse eid="GEN 19:30"/><verse number="31" style="v" sid="GEN 19:31"/>ጋፍ ቶኮ እንተልሳ እሼን ሀንገፍት እሼ ቁጥሱዻን አከነ ጄቴ፤ “አባንኬኘ ዱሎሜረ፤ አከ በርቴ ለፈ ሁንደረ ጅሩት ዺር ኑ ወጅን ጪሱ ቶኮዩ ናኖ ከነ ህንጅሩ። <verse eid="GEN 19:31"/><verse number="32" style="v" sid="GEN 19:32"/>ኮቱ ሜ አባኬኘ ዳዺ ወይኒ ኦባስኔ እሰ ወጅን ጪፍና፤ አከሲን ሰኚን አባኬኛ ለፈረት አከ ሀፉ ጎነ።”<verse eid="GEN 19:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 19:33"/>እሳንስ ሀልከን ሰነ አባሳኒ ዳዺ ወይኒ ኦባሰን፤ እንተል እሼን ሀንገፍት ኦል ሴንቴ እሰ ወጅን ጪፍቴ። እን ዬሮ እሼን ጪስቴ ዮካን ዬሮ እሼን ካቴ ህንቤክኔ።<verse eid="GEN 19:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 19:34"/>ጉያ እት ኣኑት እንተል ሀንገፍት እሼ ቁጥሱዻን አከነ ጄቴ፤ “ኩኖ አን ኤደ አባኮ ወጅን ጪሴረ። ኮቱ ኤደነስ ዳዺ ወይኒ እሰ ኦባስና፤ አትስ ኦል ሴኒ እሰ ወጅን ጪስ፤ አከስት ሰኚን አባኬኛ አከ ሀፉ ጎነ።” <verse eid="GEN 19:34"/><verse number="35" style="v" sid="GEN 19:35"/>እሳን ሀልከን ሰነስ አባሳኒ ዳዺ ወይኒ ኦባሰን፤ እንተል ቁጥሱን ዸቅጤ እሰ ወጅን ጪስቴ። እን አመስ ዬሮ እሼን ጪስቴ ዮካን ዬሮ እሼን ካቴ ህንቤክኔ።<verse eid="GEN 19:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 19:36"/>አከሲን እንተለን ሎጥ ለማኑ አባሳኒቲፍ ኡልፋአን። <verse eid="GEN 19:36"/><verse number="37" style="v" sid="GEN 19:37"/>እንተል እሼን ሀንገፍት እልመ ዴሴ መቃሳ ሞኣብ ጄቴ ሞጋፍቴ። እን አባ ሞኣቦተ ሀርኣት። <verse eid="GEN 19:37"/><verse number="38" style="v" sid="GEN 19:38"/>እንተል እሼን ቁጥሱንስ እልመ ዴሴ መቃሳ ቤን-አሚ ጄቴ ሞጋፍቴ፤ እንሞ አባ አሞኖተ ሀርኣት።<verse eid="GEN 19:38"/></para>
  <chapter eid="GEN 19"/>
  <chapter number="20" style="c" sid="GEN 20"/>
  <para style="s1">አብረሃሚፊ አቢሜሌክ</para>
  <para style="r">
    <ref loc="GEN 20:1-18">20፥1‑18</ref> ኩወእ – <char style="xt"><ref loc="GEN 12:10-20">ኡመ 12፥10‑20</ref>፤ <ref loc="GEN 26:1-11">26፥1‑11</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 20:1"/>አብረሃም አቺ ከኤ ኔጌብት ጎዳኔ ቃዴሺፊ ሹር ግዱ ጅራቴ። እንስ ዬሮዻፍ ጌራራ ኬሰ ቱሬ። <verse eid="GEN 20:1"/><verse number="2" style="v" sid="GEN 20:2"/>አችትስ አብረሃም፣ “እሼን ኦቦሌቲኮት” ጄዼ ዋኤ ኒቲሳ፣ ዋኤ ሳራ ዱበቴ። አቢሜሌክ ሞቲን ጌራራስ ነመ እት ኤርጌ ሳራ ፉዸቴ።<verse eid="GEN 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 20:3"/>ዋቅንሞ ሀልከን አብጁዻን አቢሜሌክት ዹፌ፣ “ኩኖ ሰበቢ ዱበርቲ ሰነ ፉዸቴፍ አት ነመ ዱኤዸ፤ እሼን ዽርሰ ቀብዲቲ” ጄዼን።<verse eid="GEN 20:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 20:4"/>አቢሜሌክ ገሩ እሼት ህንዽኣትኔ ቱሬ፤ ከናፉ እን አከነ ጄዼ፤ “ያ ጎፍታ አት ሰበ ቀጄላ በሌስታ? <verse eid="GEN 20:4"/><verse number="5" style="v" sid="GEN 20:5"/>እን መታንሳ፣ ‘እሼን ኦቦሌቲኮት’ ናን ህንጄኔ? እሼንስ አከሱመ፣ ‘እን ኦቦሌሰኮት’ ህንጄኔ? አንስ ሰሙ ቁልቁሉፊ ሀርከ ቁልቁሉዻን ዋን ከነ ሆጄዼ።”<verse eid="GEN 20:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 20:6"/>ዋቅን አብጁ ሰነ ኬሰ አከነ እሳን ጄዼ፤ “ኤዬ! አን አከ አት ሰሙ ቁልቁሉዻን ዋን ከነ ሆጄቴ ቤከ፤ ከናፉ አን አከ አት ጩቡ ነት ህንሆጄትኔፍ ስ ዾዌን ጅረ። ሰበቢን አን አከ አት እሼ ብረ ጌሱ ስ ህንዺስኒፍስ ከኑመ። <verse eid="GEN 20:6"/><verse number="7" style="v" sid="GEN 20:7"/>ኤጋ አመ ኒቲ ነምቻ ዴብሲፍ፤ እን ዋን ራጂ ተኤፍ፣ ዋቀ ሲፍ ከዸተ፤ አትስ ንጅራተ። ገሩ ዮ እሼ ዴብሱ ባቴ፣ አት አከ ዱቱ፣ ወር ከንኬ ተአን ሁንድስ አከ ዱአን ዹጉማን ቤክ።”<verse eid="GEN 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 20:8"/>አቢሜሌክ ጉያ እት ኣኑ ገነመ ኦቦሮን ከኤ ቆንዳልቶተሳ ሁንደ ወልት ዋሜ ዋን ተኤ ሁንደ እሳንት ህሜ፤ እሳንስ አከ መሌ ሶዳተን። <verse eid="GEN 20:8"/><verse number="9" style="v" sid="GEN 20:9"/>አቢሜሌክስ አብረሃምን ኦፍት ዋሜ አከነ ጄዼን፤ “አት ማሊፍ አከነ ኑ ጎቴ? አን ማል ስ ጎናን አት ጩቡ ጉዳ አከና አናፊ ሞቱማኮት ፍዴ? አት ዋን ነምን ህንሆጄትኔ አነት ሆጄቴ።” <verse eid="GEN 20:9"/><verse number="10" style="v" sid="GEN 20:10"/>አቢሜሌክስ “አት ማሊፍ ዋን ከነ ሆጄቴ?” ጄዼ አብረሃምን ጋፈቴ።<verse eid="GEN 20:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 20:11"/>አብረሃምሞ አከነ ጄዼ ዴብሴ፤ “አን፣ ‘ብየ ከነ ኬሰ ዹጉማን ዋቀ ሶዳቹን ህንጅሩ፤ እሳን ሰበቢ ኒቲኮቲፍ ጄዸኒ ነ አጄሱ’ ጄዼን ያዴ ቱሬ። <verse eid="GEN 20:11"/><verse number="12" style="v" sid="GEN 20:12"/>ተኡስ እሼን ዹጉማን ኦቦሌቲኮት፤ ዮ ሃዸኮራ ዸለቹ ባቴዩ እሼን እንተሉመ አባኮት፤ እሼንስ ኒቲኮ ታቴ። <verse eid="GEN 20:12"/><verse number="13" style="v" sid="GEN 20:13"/>አንስ ዬሮ ዋቅን መነ አባኮቲ ነ ባሴ ሰነ እሼዻን፣ ‘ሃል አት እቲን ጃለለ ናፍ ቀብዱ ሙልእፍቱ ከናዸ፤ ለፈ ኑ ዸቅኑ ሁንዱማት፣ “እን ኦቦሌሰኮት” ጄዺቲ ዋኤኮ ዱበዹን’ ጄዼ።”<verse eid="GEN 20:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 20:14"/>አቢሜሌክ ኤርገሲ ሆላፊ ሎን፣ ገርቦተ ዺራፊ ነዼኒ ፍዴ አብረሃሚፍ ኬኔ፤ ኒቲሳ ሳራስ ንዴብሴፍ። <verse eid="GEN 20:14"/><verse number="15" style="v" sid="GEN 20:15"/>አቢሜሌክስ፣ “ኩኖ ብይኮ ፉለኬ ዱረ ጅረ፤ እዱመ ፌቴ ጅራዹ” ጄዼን።<verse eid="GEN 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 20:16"/>ሳራዻንስ፣ “ኩኖ አን ሜቲ ሰቅሊ ኩመ ቶኮ ኦቦሌሰኬቲፍን ኬነ። ኩንስ አከ ዹጋ ቀባቹንኬ ፉለ ወረ ስ ወጅን ጅረኒ ዱረት ቤከሙፍ፤ አት ጉቱማን ጉቱት ዹጋ አርገቴርተ” ጄዼ።<verse eid="GEN 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 20:17"/>አብረሃምስ ዋቀ ከዸቴ፤ ዋቅንሞ አቢሜሌክ፣ ኒቲሳቲፊ ገርቦተሳ ዱበርቶተ ፈይሴ፤ እሳንስ እጆሌ ጎዸተን። <verse eid="GEN 20:17"/><verse number="18" style="v" sid="GEN 20:18"/><char style="nd">ዋቀዮ</char> ሰበቢ ኒቲ አብረሃም ሰበቢ ሳራቲፍ ጄዼ ገደሜሰ ዱበርቶተ መነ አቢሜሌክ ጅራተኒ ሁንደ ጩፌ ቱሬቲ።<verse eid="GEN 20:18"/></para>
  <chapter eid="GEN 20"/>
  <chapter number="21" style="c" sid="GEN 21"/>
  <para style="s1">ዸለቹ ይስሃቅ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 21:1"/>
    <char style="nd">ዋቀዮ</char> አኩመ ዱበቴ ሰነ ሳራ ያደቴ፤ <char style="nd">ዋቀዮ</char> ዋን ዋዳ ገሌፍ ሰነ ንራወቴፍ። <verse eid="GEN 21:1"/><verse number="2" style="v" sid="GEN 21:2"/>ሳራን ኡልፎፍቴ በረ ዱሉመሳ ኬሰ ዬሩመ ዋቅን ዋዳ እሳፍ ሴኔ ሰነት አብረሃሚፍ እልመ ዴሴ። <verse eid="GEN 21:2"/><verse number="3" style="v" sid="GEN 21:3"/>አብረሃምስ እልመ ሳራን እሳፍ ዴሴ ሰነ ይስሃቅ ጄዼ ሞጋሴ። <verse eid="GEN 21:3"/><verse number="4" style="v" sid="GEN 21:4"/>አብረሃም አኩመ ዋቅን እሰ አጀጄ ሰነት ይስሃቅ ዸለቴ ጉያ ሰዴትት ዸግነ እሰ ቀቤ። <verse eid="GEN 21:4"/><verse number="5" style="v" sid="GEN 21:5"/>ዬሮ እልምሳ ይስሃቅ ዸለቴፍት አብረሃም ነመ ወጋ ዽባ ቱሬ።<verse eid="GEN 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 21:6"/>ሳራንስ፣ “ዋቅን ኮልፈ ና ኬኔረ፤ ነምን ዋን ከነ ዸገኡ ሁንድስ ነ ወጅን ኮልፈ” ጄቴ። <verse eid="GEN 21:6"/><verse number="7" style="v" sid="GEN 21:7"/>እቱመ ፉፍቴስ፣ “ስላ ኤኙቱ አብረሃሚን፣ ‘ሳራን ዳእመ ሆስስት’ ጄዸ ቱሬ? ገሩ አን በረ ዱሉመሳ ኬሰ እልመ ነንደኤፍ” ጄቴ።<verse eid="GEN 21:7"/></para>
  <para style="s1">አጋሪፊ እሽማኤል መና አርአሙሳኒ</para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 21:8"/>ሙጭች ጉደቴ ሀርመ ጉፈሜ፤ አብረሃም ጋፈ ይስሃቅ ሀርመ ጉፈሜ ሰነ ጭዸ ጉዳ ቆጴሴ። <verse eid="GEN 21:8"/><verse number="9" style="v" sid="GEN 21:9"/>ሳራን ገሩ ዬሮ እልም አጋር ግብጥቲን አብረሃሚፍ ዴሴ ሱን ይስሃቅት ቆሱ አርግቴ፤ <verse eid="GEN 21:9"/><verse number="10" style="v" sid="GEN 21:10"/>እሼንስ አብረሃሚን፣ “ገርብቲ ከናፊ እልመሼ አርእ፤ እልም ገርብቲ ከና ኩን እልመኮ ይስሃቅ ወጅን ህንዻሉቲ” ጄቴ።<verse eid="GEN 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 21:11"/>ወን ኩንስ ሰበቢ እልመሳቲፍ አብረሃምን አከ መሌ ረክሴ። <verse eid="GEN 21:11"/><verse number="12" style="v" sid="GEN 21:12"/>ዋቅን ገሩ አከነ ጄዼን፤ “ዋኤ ገርብቲኬቲቲፊ ዋኤ ሙጭቻ ህንያደእን። ሰበቢ ሰኚንኬ ይስሃቂን ሲፍ ዋመሙፍ ዋን ሳራን ሲን ጄቱ ሁንደ ዸገእ። <verse eid="GEN 21:12"/><verse number="13" style="v" sid="GEN 21:13"/>እን ሰኚኬ ዋን ተኤፍ አን እልመ ገርብቲ ሰና ሰበ ነንታስሰ።”<verse eid="GEN 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 21:14"/>አብረሃምስ ጉያ እት ኣኑ ገነመ ኦቦሮን ከኤ ኛተ ሙራሳፊ ብሻን ቀልቀለ ቶኮ ፉዼ አጋሪፍ ኬኔ። ዋን ከነስ ገቲቲሼረ ካኤፊ ሙጫ ወጅን አርኤ፤ እሼንስ አቺ ባቴ ገሞጂ ቤርሼባ ኬሰ ጆርቴ።<verse eid="GEN 21:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 21:15"/>ዮሙ ብሻን ቀልቀለ ኬሳ ዹሜት፣ እሼን ሙጫሼ ደገለ ቶኮ ጀለ ኬሴ። <verse eid="GEN 21:15"/><verse number="16" style="v" sid="GEN 21:16"/>እሼንስ፣ “ሙጫ ከነ እሳ ዱኡ አን ህንእላሉ” ጄቴ ገራሼት ዋን ያዴፍ ገረ ደርበ ጥያ ቶኮ ጥኖ አች ሂቅጤ ናኖሳ ቴሴ፤ አች ቴሴስ ሰገሌሼ ኦል ፉዸቴ ቦሴ።<verse eid="GEN 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 21:17"/>ዋቅን ቦእቸ ሙጭቻ ንዸገኤ፤ ኤርገማን ዋቀዮ ሰሚ ኬሳ አጋርን ዋሜ አከነ ጄዼን፤ “ያ አጋር አት ማል ታቴ? ህንሶዳትን፤ ዋቅን ቦእቸ ሙጭቻ እዶ እን ጪሴ ጅሩ ዸገኤራቲ። <verse eid="GEN 21:17"/><verse number="18" style="v" sid="GEN 21:18"/>ሰበቢ አን ሰበ ጉዳ እሰ ጎዹፍ ከኢቲ ሀርከኬቲን ሙጭቸ ኦል ፉዽ፤ ጀቤሲቲ እሰ ቀብ።”<verse eid="GEN 21:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 21:19"/>ዋቅን እጀሼ በኔፊ ጄናን ቦለ ብሻኒ ቶኮ አርግቴ። ከናፉ ዸቅጤ ቀልቀለ ሰነ ብሻኒን ጉቴ፣ ዋን እን ዹጉ ሙጭቻፍ ኬንቴ።<verse eid="GEN 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 21:20"/>ዋቅንስ ሙጭቸ ወጅን ቱሬ፤ ሙጭችስ ንጉደቴ። እንስ ገሞጂ ኬሰ ጅራቴ፤ ጥየ ደርበቹዻንስ ቤከማ ቱሬ። <verse eid="GEN 21:20"/><verse number="21" style="v" sid="GEN 21:21"/>እንስ ገሞጂ ጳራን ኬሰ ጅራቴ፤ ሃትሳስ ብየ ግብጢቲ ኒቲ አርገቴፍ።<verse eid="GEN 21:21"/></para>
  <para style="s1">ወሊ ገልቴ ቤርሼባት ጎዸሜ</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 21:22"/>ዬሮ ሰነ አቢሜሌኪፊ ፊኮል አጀጃን ሎልቶተሳ አብረሃሚን አከነ ጄዸን፤ “ዋን አት ሆጄቱ ሁንደ ኬሰት ዋቅን ስ ወጅን ጅረ። <verse eid="GEN 21:22"/><verse number="23" style="v" sid="GEN 21:23"/>አት አከ አነ ዮካን እጆሌኮ ዮካን ሰኚኮ ህንጎዎምስኔ አመ አስ ፉለ ዋቃ ዱረት ና ከከዹ። አኩመ አን ገራ ሲፍ ላፌ ሰነ አትስ አናፊ ብየ አመ ኦርመ ታቴ ኬሰ ጅራቱ ከናፍ ገራ ላፍ።”<verse eid="GEN 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 21:24"/>አብረሃምስ፣ “አን ነንከከዸ” ጄዼ።<verse eid="GEN 21:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 21:25"/>ኤርገሲ አብረሃም ዋኤ ቦለ ብሻኒ ገርቦን አቢሜሌክ እሰራ ፉዸተን ቶኮ አቢሜሌክት ህመቴ። <verse eid="GEN 21:25"/><verse number="26" style="v" sid="GEN 21:26"/>አቢሜሌክሞ፣ “አን ነመ ዋን ከነ ሆጄቴ ህንቤኩ። አትስ ነት ህንህምኔ፤ አን ዋኤሳ ሀርኡመን ዸገኤ” ጄዼ።<verse eid="GEN 21:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 21:27"/>ከናፉ አብረሃም ሆላፊ ሎን ፍዴ አቢሜሌኪፍ ኬኔ፤ ጀር ለማንስ ወሊ ገልቴ ኡመተን። <verse eid="GEN 21:27"/><verse number="28" style="v" sid="GEN 21:28"/>አብረሃም ጎሮሚ ሆላ ቶርበ ቡሻዬ ኬሳ ኮጳት ባሴ፤ <verse eid="GEN 21:28"/><verse number="29" style="v" sid="GEN 21:29"/>አቢሜሌክስ፣ “ሂካን ጎሮሚ ሆላ ቶርበን አት ኮጳሳኒ ባፍቴ ከኔኒ ማል?” ጄዼ አብረሃምን ጋፈቴ።<verse eid="GEN 21:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 21:30"/>አብረሃምስ፣ “አከ አን ቦለ ብሻኒ ከነ ቆተዼ አከ ረጋ ተኡፍ፣ ጎሮሚ ሆላ ቶርበን ከኔን ነ ሀርካ ፉዸዹ” ጄዼ ዴብሴ።<verse eid="GEN 21:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 21:31"/>ሰበቢ ጀር ለማን ሱን አችት ወሊ ከከተኒፍ እዶን ሱን ቤርሼባ ጄዸሜ ዋመሜ።<verse eid="GEN 21:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 21:32"/>ኤርገ ወሊ ገልቴን ሱን ቤርሼባት ተኤ ቦዴ አቢሜሌኪፊ ፊኮል አጀጃን ሎልቶተሳ ገረ ብየ ፍልስጤሞታት ዴብአን። <verse eid="GEN 21:32"/><verse number="33" style="v" sid="GEN 21:33"/>አብረሃምስ ቤርሼባ ኬሰ ሙከ ተምሪ ዻቤ፤ እንስ አችት መቃ <char style="nd">ዋቀዮ</char> ዋቀ በረ በራ ዋመቴ። <verse eid="GEN 21:33"/><verse number="34" style="v" sid="GEN 21:34"/>አብረሃም ብየ ፍልስጤሞታ ኬሰ በረ ዼራ ጅራቴ።<verse eid="GEN 21:34"/></para>
  <chapter eid="GEN 21"/>
  <chapter number="22" style="c" sid="GEN 22"/>
  <para style="s1">አብረሃም ቆረሜ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 22:1"/>ዬሮ ሙራሰ ቦዴ ዋቅን አብረሃምን ቆሬ። እንስ፣ “አብረሃም!” ጄዼ እሰ ዋሜ።</para>
  <para style="p" vid="GEN 22:1">አብረሃምስ፣ “ኩኖ አሰን ጅረ” ጄዼ ዴብሴ።<verse eid="GEN 22:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 22:2"/>ዋቅንስ አከነ ጄዼን፤ “እልመኬ ይስሃቅ፣ እልመኬ ቶክቸ እሰ ጃለቱ ሰነ ፉዺቲ ብየ ሞርያ ዸቅ። ቱሉ አን ስት ህሙረት ቀልመ ጉበሙ ጎዺቲ እሰ ዽኤስ።”<verse eid="GEN 22:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 22:3"/>አብረሃምስ ጉያ እት ኣኑ ገነመ በራቃን ከኤ ሀሬሳ ፌአቴ። እንስ ሆጄቶተሳ ኬሳ ነመ ለማፊ እልመሳ ይስሃቅን ፉዸቴ ቆራን ቀልመ ጉበሙፍ ገኡ ጨብሰቴ ገረ እዶ ዋቅን እሰት ህሜ ሰናት ቀጄሌ። <verse eid="GEN 22:3"/><verse number="4" style="v" sid="GEN 22:4"/>ጉያ ሰደፋትስ አብረሃም ኦል እላሌ እዶ ሰነ ፈጎት አርጌ። <verse eid="GEN 22:4"/><verse number="5" style="v" sid="GEN 22:5"/>እንስ ሆጄቶተሳቲን፣ “እስን ሀሬ ወጅን አሱመ ቱራ። አኒፊ ሙጭች ዱበ ሰነ ዸቅና፤ አችትስ ዋቄፈትኔ ገረኬሰንት ዴብና” ጄዼ።<verse eid="GEN 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 22:6"/>አብረሃምስ ቆራን ኣርሳ ጉበሙፍ ተኡ ፉዼ እልመሳ ይስሃቅን ባችሴ፤ ኦፊሳቲሞ እብዳፊ ብላ ሀርከት ቀበቴ። እሳን ለማን ኡቱ ወሉማን ዴማ ጅረኑ፣ <verse eid="GEN 22:6"/><verse number="7" style="v" sid="GEN 22:7"/>ይስሃቅ፣ “ያ አባኮ” ጄዼ አባሳ አብረሃምት ዱበቴ።</para>
  <para style="p" vid="GEN 22:7">አብረሃምስ፣ “አሰን ጅረ እልመኮ” ጄዼ ዴብሴ።</para>
  <para style="p" vid="GEN 22:7">ይስሃቅስ ዴብሴ፣ “እብዲፊ ቆራን ኩኖት፤ ሆላን ቀልመ ጉበሙፍ ተኡሞ ኤሰ ጅረ?” ጄዼ።<verse eid="GEN 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 22:8"/>አብረሃምስ ዴብሴ፣ “ያ እልመኮ፣ ዋቅን መታንሳ ሆላ ቀልመ ጉበሙፍ ተኡ ንኬነ” ጄዼ። እሳን ለማንስ ወሉማን ከራሳኒ እት ፉፈን።<verse eid="GEN 22:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 22:9"/>ዬሮ እዶ ዋቅን እሰት ህሜ ሰነ ገአንት፣ አብረሃም እዶ ኣርሳ አችት እጃሬ እዶ ኣርሳ ሰነረ ቆራን ነቄ፤ እልመሳ ይስሃቅን ህዼስ እዶ ኣርሳ ሰነረ ቆራን ጉባ ጪብሴ። <verse eid="GEN 22:9"/><verse number="10" style="v" sid="GEN 22:10"/>ኤርገሲ እን እልመሳ ቀሉፍ ጄዼ ሀርከሳ ሂጠቴ ብላ ፉዸቴ። <verse eid="GEN 22:10"/><verse number="11" style="v" sid="GEN 22:11"/>ኤርገማን <char style="nd">ዋቀዮ</char> ገሩ፣ “አብረሃም! አብረሃም!” ጄዼ ሰሚ ኬሳ እሰ ዋሜ።</para>
  <para style="p" vid="GEN 22:11">አብረሃምስ፣ “ኩኖ አሰን ጅረ” ጄዼ ዴብሴ።<verse eid="GEN 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 22:12"/>እንስ፣ “አት ሀርከኬቲን ጉርብቸ ህንቱቅን፤ ዋን ቶኮሌ እሰ ህንጎዽን። ዋን አት እልመኬ፣ እልሙመ ቶክቸ አናፍ ጄቴ ህንመረርፈትኒፍ፣ አን አከ አት ዋቀ ሶዳቱ አመ ቤኬረ” ጄዼ።<verse eid="GEN 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 22:13"/>አብረሃምስ ኦል እላሌ ኩኖ ኮርቤሰ ሆላ ከን ጋንፍሳ ደገለ ኬሰት ቀበሜ ጅሩ ቶኮ አርጌ፤ እንስ ዸቄ ሆላ ሰነ ፉዼ ቆደ እልመሳ ቀልመ ጉበሙ ጎዼ ዽኤሴ። <verse eid="GEN 22:13"/><verse number="14" style="v" sid="GEN 22:14"/>ከናፉ አብረሃም እዶ ሰነ “<char style="nd">ዋቀዮ</char> ንኬነ” ጄዼ ሞጋሴ፤ ሀመ ሀርኣትሌ፣ “ቱሉ <char style="nd">ዋቀዮረት</char>፣ ንኬነመ” ጄዸመ።<verse eid="GEN 22:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 22:15"/>ኤርገማን <char style="nd">ዋቀዮ</char> ሱንስ ሰሚ ኬሳ ለመተ አብረሃምን ዋሜ <verse eid="GEN 22:15"/><verse number="16" style="v" sid="GEN 22:16"/>አከነ ጄዼን፤ “<char style="nd">ዋቀዮ</char> አከነ ጄዸ፤ ሰበቢ አት ዋን ከነ ጎቴፊ እልመኬ፣ እልሙመኬ ቶክቸሌ ነ ህንዾወትኒፍ አን መቃኮቲን ነንከከዸ፤ <verse eid="GEN 22:16"/><verse number="17" style="v" sid="GEN 22:17"/>አን ዹጉማን ኤበ፣ ስን ኤብሰ፤ ሰኚኬስ አኩመ ኡርጂ ሰሚቲፊ አኩመ ጭረቸ ቀርቀረ ገላና ነንባይእሰ። ሰኚወንኬስ መጋላወን ዲነሳኒ ንዹንፈቱ። <verse eid="GEN 22:17"/><verse number="18" style="v" sid="GEN 22:18"/>ዋን አት ና አጀጀምቴፍ ሰብን ለፈራ ሁንድኑ ከራ ሰኚኬቲን ኤብፈመ።”<verse eid="GEN 22:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 22:19"/>ኤርገሲ አብረሃም ተጃጅልቶተሳት ዴብኤ፤ እሳንስ ወሉማን ቤርሼባት ቀጄለን፤ አብረሃምስ ቤርሼባ ኬሰ ጅራቴ።<verse eid="GEN 22:19"/></para>
  <para style="s1">እልማን ናሆር</para>
  <para style="li1">
    <verse number="20" style="v" sid="GEN 22:20"/>ዬሮ ሙራሰ ቦዴ አከነ ጄዸሜ አብረሃምት ህመሜ፤ “ኩኖ፣ ሚልካን ኦቦሌሰኬ ናሆሪፍ እልማን ዴሴርት፤<verse eid="GEN 22:20"/></para>
  <para style="li2">
    <verse number="21" style="v" sid="GEN 22:21"/>እልማን እሼን ዴሴስ እን ሀንገፍን ኡዝ፣ ኦቦሌስሳ ቡዝ፣</para>
  <para style="li2" vid="GEN 22:21">አባን አራምሞ ቀሙኤል፣<verse eid="GEN 22:21"/></para>
  <para style="li2">
    <verse number="22" style="v" sid="GEN 22:22"/>ኬሴድ፣ ሀዞ፣ ፊልዳስ፣ ዪድላፊፊ ቤቱኤል ጄዸሙ።”<verse eid="GEN 22:22"/></para>
  <para style="li3">
    <verse number="23" style="v" sid="GEN 22:23"/>ቤቱኤል ርብቃ ዸልቼ።</para>
  <para style="lf" vid="GEN 22:23">ሚልካን እሳን ከነ ሰዴተን ናሆር ኦቦሌሰ አብረሃሚፍ ዴሴ።<verse eid="GEN 22:23"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="24" style="v" sid="GEN 22:24"/>ናሆር ሳጀቶ ሬኡማ ጄዸምቱ ቶኮ ቀበ ቱሬ፤</para>
  <para style="li2" vid="GEN 22:24">እሼን እልማን ጤባ፣ ገሀም፣ ተሃሺፊ መአካ ጄዸመን ዴሴፍ።<verse eid="GEN 22:24"/></para>
  <chapter eid="GEN 22"/>
  <chapter number="23" style="c" sid="GEN 23"/>
  <para style="s1">ሳራን ዱኡሼ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 23:1"/>ሳራን ወጋ ዽበ ቶኮፊ ድግደሚ ቶርበ ጅራቴ፤ በር ጅሬኘ ሳራስ ከኑመ ቱሬ። <verse eid="GEN 23:1"/><verse number="2" style="v" sid="GEN 23:2"/>እሼንስ ክርያት አርባቅ ጄቹንስ ኬብሮን ብየ ከነኣን ኬሳ ሰነት ዱቴ፤ አብረሃምስ ሳራዻፍ ገዱፊ ቦኡዻፍ ጄዼ ዸቄ።<verse eid="GEN 23:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 23:3"/>አብረሃም ሬፈ ኒቲሳ ብራ ከኤ ሄቶታን አከነ ጄዼ፤ <verse eid="GEN 23:3"/><verse number="4" style="v" sid="GEN 23:4"/>“አን ግዱኬሰንት ኦርማፊ ኬሱማዸ። አከ አን ዱኣኮ እት አዋለዹፍ ለፈ አዋላፍ ተኡ ነት ጉርጉራ።”<verse eid="GEN 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 23:5"/>ሄቶትንስ አከነ ጄዸኒ አብረሃሚፍ ዴቢ ኬነን፤ <verse eid="GEN 23:5"/><verse number="6" style="v" sid="GEN 23:6"/>“ጎፍታ፣ ኑ ዸገእ። አት ኑ ግዱት ሹሚ ጀባዸ። ዱኣኬ እዶ አዋለኬኛ ኬሳ ከን አከ መሌ ፍለተማ ተኤት አዋለዹ። ኑ ኬሳ ነምን እዶ አዋለሳት ዱኣኬ አዋለቹ ስ ዾወቱ ቶኮዩ ህንጅሩ።”<verse eid="GEN 23:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 23:7"/>አብረሃምስ ኦል ከኤ ፉለ ነሞተ ብየ ሰና ፉለ ሄቶታ ዱረት ገድ ጄዼ ሀርከ ፉዼ። <verse eid="GEN 23:7"/><verse number="8" style="v" sid="GEN 23:8"/>አከነስ እሳኒን ጄዼ፤ “አን ዱኣኮ አከን አዋለዹ ፌዺ ዮ ቀባተን ነ ዸገኣቲ ኤፍሮን እልመ ዞሀር ሰነ ና ከዸዻ። <verse eid="GEN 23:8"/><verse number="9" style="v" sid="GEN 23:9"/>እንስ ሆልቀ መክፌላ ጄዸሙ ከን ቀርቀረ ለፈ ቆቲሳሳት አርገሙ ሰነ ነት ንጉርጉረ። እን እዶ አዋላ ሰነ ገቲ ጉቱዻን ፉለኬሰን ዱረት አከ ነት ጉርጉሩፍ ና ጋፈዻ።”<verse eid="GEN 23:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 23:10"/>ኤፍሮን ሄትች ሰበሳ ግዱ ታኣ ቱሬ፤ እንስ ኡቱመ ሄቶትን ገረ ከረ መጋላሳ ዹፈን ሱን ሁንድ ዸገአኑ አከነ ጄዼ አብረሃሚፍ ዴቢ ኬኔ፤ <verse eid="GEN 23:10"/><verse number="11" style="v" sid="GEN 23:11"/>“ጎፍታኮ፣ አከነ ምት፤ ሜ ነ ዸጌፈዹ፤ አን ለፈ ቆቲሳ ከነ ሲፍ ነንኬነ፤ ሆልቀ አች ጅሩስ ሲፍ ነንኬነ፤ አን ፉለ ሰበኮ ዱረት ሆልቀ ከነ ሲፍን ኬነ፤ ዱኣኬ እት አዋለዹ።”<verse eid="GEN 23:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 23:12"/>አብረሃም አመሌ ፉለ ሰበ ብየ ሰና ዱረት ገድ ጄዼ ሀርከ ፉዼ፣ <verse eid="GEN 23:12"/><verse number="13" style="v" sid="GEN 23:13"/>ኡቱመ እሳን ዸገአኑ ኤፍሮኒን፣ “ዮ ፌዺኬ ተኤ፣ ነ ዸገእ። አን ገቲ ለፈ ቆቲሳ ከና ነንከፈለ። አከ አን ዱኣኮ አችት አዋለዹፍ ገቲ ከነ ነ ሀርካ ፉዸዹ” ጄዼ።<verse eid="GEN 23:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 23:14"/>ኤፍሮንስ አከነ ጄዼ አብረሃሚፍ ዴቢ ኬኔ፤ <verse eid="GEN 23:14"/><verse number="15" style="v" sid="GEN 23:15"/>“ጎፍታኮ፣ ሜ ነ ዸገእ፤ ገቲን ለፈ ከና ሜቲ ሰቅሊ ዽበ አፉር ተአ፤ ገሩ ኩን አናፊ ስ ግዱት ማል? ዱኣኬ እት አዋለዹ።”<verse eid="GEN 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 23:16"/>አብረሃምስ ዋን ኤፍሮን ዱበቴ ሰነ ፉዸቴ ገቲ እን ኡቱመ ሄቶትን ዸገአኑ ህመቴ ሰነ መዳሌፍ፤ ገቲን ሱንስ አከ መዳሊ ደልደልቶተ ዬሮ ሰናት ሜቲ ሰቅሊ ዽበ አፉር ቱሬ።<verse eid="GEN 23:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 23:17"/>አከስት ለፍት ቆቲሳ ኤፍሮን ከን ፉለ መምሬ ዱረ፣ መክፌላ ኬሰ ጅሩ ሱን ጄቹንስ ለፍት ቆቲሳቲፊ ሆልቅ እሰ ኬሰ ጅሩ፣ ሙክን ዳንጋ ለፈ ቆቲሳ ሰነ ኬሰ ጅሩ ሁንድ፣ <verse eid="GEN 23:17"/><verse number="18" style="v" sid="GEN 23:18"/>ፉለ ሄቶተ ገረ ከረ መጋላ ዹፈን ሁንዳ ዱረት አከ ዻላት አብረሃምት ደበርፈሜ። <verse eid="GEN 23:18"/><verse number="19" style="v" sid="GEN 23:19"/>ኤርገሲ አብረሃም ብየ ከነኣን ኬሰ፣ ሆልቀ መክፌላ ከን መምሬ ብረ ጄቹንስ ኬብሮን ብረ ጅሩ ሰነት ኒቲሳ ሳራ አዋለቴ። <verse eid="GEN 23:19"/><verse number="20" style="v" sid="GEN 23:20"/>አከስት ለፈ ቆቲሳ ሱኒፊ ሆልቅ አች ኬሳ አከ ለፈ አዋላ ተኡፍ ሄቶተራ አከ ዻላት አብረሃምት ደበርፈሜ።<verse eid="GEN 23:20"/></para>
  <chapter eid="GEN 23"/>
  <chapter number="24" style="c" sid="GEN 24"/>
  <para style="s1">ይስሃቂፊ ርብቃ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 24:1"/>ዬሮ ሰነ አብረሃም ዱሎሜ፣ ኡሙሪንሳ አከ መሌ ዼረቴ ቱሬ፤ <char style="nd">ዋቀዮስ</char> ዋን ሁንዱማን እሰ ኤብሴ። <verse eid="GEN 24:1"/><verse number="2" style="v" sid="GEN 24:2"/>እንስ ተጃጅላ መነሳ ሀንገፈ ከን ዋን እን ቀቡ ሁንደረት እት ጋፈተማ ተኤን አከነ ጄዼ፤ “ሜ ሀርከኬ ጉዴደኮ ጀለ ካእ። <verse eid="GEN 24:2"/><verse number="3" style="v" sid="GEN 24:3"/>አን አከ አት እንተለን ወረ ከነኣን ከኔን አን ግዱሳኒ ጅራዹ ኬሳ እልመኮቲፍ ኒቲ ህንፍድኔፍ <char style="nd">ዋቀዮ</char> ዋቀ ሰሚቲፊ ዋቀ ለፋቲን ከከቱ ነንበርባደ፤ <verse eid="GEN 24:3"/><verse number="4" style="v" sid="GEN 24:4"/>ገሩ ገረ ብየኮቲፊ ገረ ፍሮተኮ ዸቂቲ እልመኮ ይስሃቂፍ ኒቲ በርባድ።”<verse eid="GEN 24:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 24:5"/>ተጃጅላን ሱንሞ፣ “ዮ ዱበርቲን ሱን ነ ወጅን ገረ ብየ ከና ዹፉፍ ፌዺ ቀባቹ ባቴሆ? አን እልመኬ ገረ ብየ አት ኬሳ ዹፍቴ ሰናት ዴብሴ ጌሱን ቀባ?” ጄዼ እሰ ጋፈቴ።<verse eid="GEN 24:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 24:6"/>አብረሃምስ አከነ እሳን ጄዼ፤ “አት አከ እልመኮ ዴብፍቴ ብየ ሰነት ህንጌስኔ ኦፍ ኤገዹ። <verse eid="GEN 24:6"/><verse number="7" style="v" sid="GEN 24:7"/><char style="nd">ዋቀዮ</char> ዋቅን ሰሚ እን መነ አባኮቲፊ ብየ አን እት ዸለዼ ኬሳ ነ ፍዴ፣ ‘አን ብየ ከነ ሰኚኬቲፍ ነንኬነ’ ጄቹዻን ነት ዱበቴ ከከቴ ዋዳ ና ሴኔ ሱን አከ አት አቺ እልመኮቲፍ ኒቲ ፍዱፍ ኤርገማሳ ፉለኬ ዱረ ንኤርገ። <verse eid="GEN 24:7"/><verse number="8" style="v" sid="GEN 24:8"/>ዮ ዱበርቲን ሱን ስ ወጅን ዹፉፍ ፌዺ ቀባቹ ባቴሞ አት ከኩኮ ከነራ ብልሰ ታተ። እልመኮ ገሩ ጎንኩማ አች ህንዴብስን።” <verse eid="GEN 24:8"/><verse number="9" style="v" sid="GEN 24:9"/>ከናፉ ተጃጅላን ሱን ሀርከሳ ጉዴደ ጎፍታሳ አብረሃም ጀለ ካኤ ዋኤ ዋን ከና ከከቴፍ።<verse eid="GEN 24:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 24:10"/>ተጃጅላን ሱንስ ጋለ ጎፍታሳ ኬሳ ኩዸን ፉዸቴ ጎፍታሳ ብራሞ ኬናወን ፍለተሞ ጎሰ ሁንዳ ፌአቴ ቀጄሌ፤ እንስ መጋላ ናሆር እሼ ካበ ዽአ ጳዳን አራም ኬሰት አርገምቱ ዸቄ። <verse eid="GEN 24:10"/><verse number="11" style="v" sid="GEN 24:11"/>እንስ አከ ጋለወን ሱን መጋለቲን አለት ቦለ ብሻኒ ጭነ ጅጅልቤንፈተን ጎዼ፤ ዬሮን ሱን ገረ ገልገላ ዬሮ እት ዱበርቶትን ብሻን ወራበቹ በአን ቱሬ።<verse eid="GEN 24:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 24:12"/>እንስ አከነ ጄዼ ከዸቴ፤ “ያ <char style="nd">ዋቀዮ</char> ዋቀ ጎፍታኮ አብረሃም፣ ሀርአ ነ ምልኬሲቲ ጎፍታኮ አብረሃሚፍ ገራ ላፍ። <verse eid="GEN 24:12"/><verse number="13" style="v" sid="GEN 24:13"/>ኩኖ፣ አን ቡርቃ ከነ ብረ ዻበዼን ጅረ፤ እንተለን ወረ መጋላ ከናስ ብሻን ወራበቹፍ አስ በኣ ጅሩ። <verse eid="GEN 24:13"/><verse number="14" style="v" sid="GEN 24:14"/>እንተል አን፣ ‘ማሎ አከ አን ብሻን ዹጉፍ ኦኮቴኬ ገድ ቀብ’ ጄዼኒ እሼንስ፣ ‘ዹግ፤ አን ጋለወንኬስ ሲፍን ኦባሳ’ ናን ጄቱ እሼ አት ገርብቸኬ ይስሃቂፍ ፍለቴ ሃታቱ። አንስ ከናን አከ አት ጎፍታኮቲፍ ገራ ላፍቴ ቤከ።”<verse eid="GEN 24:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 24:15"/>ኡቱ እን ከዸቴ ህንፍጠን ርብቃን ኦኮቴሼ ገቲቲት ባዸቴ ዹፍቴ። እሼንስ እንተለ እልመ ሚልካ ከን ቤቱኤል ጄዸሙ ሰና ቱርቴ፤ ሚልካንሞ ኒቲ ኦቦሌሰ አብረሃም ከን ናሆር ጄዸሙ ሰናት። <verse eid="GEN 24:15"/><verse number="16" style="v" sid="GEN 24:16"/>እንተል ሱንስ አከ መሌ በሬዱፊ ዱርበ ቱርቴ፤ ዺር ቶኮዩ እሼ ወጅን ህንጪፍኔ። እሼንስ ገረ ቡርቃት ገድ ቡቴ ኦኮቴሼት ብሻን ጉተቴ ኦል ዴብቴ።<verse eid="GEN 24:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 24:17"/>ተጃጅላን ሱንስ እሼ ስመቹፍ እት ፊጌ፣ “ማሎ ኦኮቴኬ ኬሳ ብሻን ጥኖሼ ና ኬን” ጄዼን።<verse eid="GEN 24:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 24:18"/>እሼንስ፣ “ያ ጎፍታኮ፣ ዹግ” ጄቴኒ ደፍቴ ኦኮቴሼ ሀርከት ገድ ቡፈቴ ብሻን ዹጋቲ ኬንቴፍ።<verse eid="GEN 24:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 24:19"/>እሼንስ ኤርገ ብሻን እሰ ኦባፍቴ ቦዴ፣ “አን ጋለወንኬቲፍስ ሀመ እሳን ዹገኒ ዼቡ በአንት ነንወራበ” ጄቴ። <verse eid="GEN 24:19"/><verse number="20" style="v" sid="GEN 24:20"/>ደፍቴስ ኦኮቴሼ ኬሳ ብድሩት ገረገልችቴ አመስ ብሻን ወራቡዻፍ ገረ ቦለ ብሻኒት ፊግዴ፤ ጋለወንሳ ሁንዳፍስ ብሻን ወራብዴ። <verse eid="GEN 24:20"/><verse number="21" style="v" sid="GEN 24:21"/>ነምች ሱንስ አከ <char style="nd">ዋቀዮ</char> ከራ እሳፍ ምልኬሴ ዮካን አከ እሳፍ ህንምልኬስን በሩፍ ጄዼ ጨልእሴ ጥዬፈቴ እሼ እላላ ቱሬ።<verse eid="GEN 24:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 24:22"/>ኤርገ ጋለወን ብሻን ዹገኒ ቦዴ ነምች አመርቲ ፉኛኒ ከን ወርቄ ከን ወለካ ሰቅሊ ኡልፋቱፊ ብተዎ ወርቄ ከን ሰቅሊ ኩዸን ኡልፋቱ ለመ ገድ ባሴ፣ <verse eid="GEN 24:22"/><verse number="23" style="v" sid="GEN 24:23"/>“አት እንተለ ኤኙት? ዮ መነ አባኬቲ እዶን ቡለን ጅራቴ ማሎ ሜ ነት ህም” ጄዼ ጋፈቴ።<verse eid="GEN 24:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 24:24"/>እሼንስ፣ “አን እንተለ ቤቱኤል፤ ቤቱኤልሞ እልመ ሚልካን ናሆሪፍ ዴሴዸ” እሳን ጄቴ። <verse eid="GEN 24:24"/><verse number="25" style="v" sid="GEN 24:25"/>እት ደበልቴስ፣ “ጭዲፊ ኦካ ባይኤ ቀብነ፤ ኩታን እስን ቡልተንስ ጅረ” ጄቴን።<verse eid="GEN 24:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 24:26"/>ነምችስ ገድ ጄዼ <char style="nd">ዋቀዮፍ</char> ሰገዴ፤ <verse eid="GEN 24:26"/><verse number="27" style="v" sid="GEN 24:27"/>አከነስ ጄዼ፤ “<char style="nd">ዋቀዮ</char> ዋቅን ጎፍታኮ አብረሃም ከን አርጁማሳቲፊ አመነሙማሳ ጎፍታኮ ህንዾወትን ሱን ሃኤብፈሙ። <char style="nd">ዋቀዮ</char> አነስ ገረ መነ ኦቦሎተ ጎፍታኮት ከራረ ነ ቀጄልቼረ።”<verse eid="GEN 24:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 24:28"/>እንተለቲንስ ፊግዴ ዸቅጤ ወረ መነ ሃዸሼ ጅረንት ዋኤ ዋን ከና ህምቴ። <verse eid="GEN 24:28"/><verse number="29" style="v" sid="GEN 24:29"/>ርብቃን ኦቦሌሰ ላባ ጄዸሙ ቶኮ ቀብድ ቱርቴ፤ ላባንስ ፊጌ ነምቸ ቡርቃ ብሻኒ ብረ ጅሩ ሰነ ብረ ዸቄ። <verse eid="GEN 24:29"/><verse number="30" style="v" sid="GEN 24:30"/>እንስ ዮሙ ኦቦሌቲሳረት አመርቲ ፉኛኒ ወርቄቲፊ ብተዎ አርጌት፣ ዮሙ ኡቱ ርብቃን ዋን ነምች ሱን እሼዻን ጄዼ ዱበቱ ዸገኤት፣ ገረ ነምቻት ገድ በኤ፤ ነምችስ ቡርቃ ብሻኒ ጭነ ጋለወን ብረ ዻበቴ ቱሬ። <verse eid="GEN 24:30"/><verse number="31" style="v" sid="GEN 24:31"/>ነምቸ ሰናንስ፣ “ያ ነምቸ <char style="nd">ዋቀዮ</char> ኤብሴ፣ ኮቱ፤ አት ማሊፍ አለ ዻበተ? አን መንቸ ቆጴሴረ፤ ጋለወኒፍስ እዶ ቆጴሴረ” ጄዼ።<verse eid="GEN 24:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 24:32"/>ከናፉ ነምች ሱን ገረ መና ዸቄ፤ ላባንስ ጋለወንራ ፌኢሰ ቡሴ ጭዲፊ ኦካ ኬኔፍ፤ አከ ሚለሳኒ ዽቀተኒፍሞ ነምቻፊ ወረ እሰ ወጅን ቱረኒፍ ብሻን ኬኔ። <verse eid="GEN 24:32"/><verse number="33" style="v" sid="GEN 24:33"/>ኤርገሲስ ኛትን ዽኣቴፍ፤ ነምች ሱን ገሩ፣ “አን ሀመን ዽመኮ ህመዹት ህንኛዹ” ጄዼ።</para>
  <para style="p" vid="GEN 24:33">ላባንስ፣ “ህመዹካ” ጄዼን።<verse eid="GEN 24:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 24:34"/>እንስ አከነ ጄዼ፤ “አን ተጃጅላ አብረሃሚት። <verse eid="GEN 24:34"/><verse number="35" style="v" sid="GEN 24:35"/><char style="nd">ዋቀዮ</char>፣ ጎፍታኮ ጉዳ ኤብሴረ፤ እንስ ሶሮሜረ። ሆሎታፊ ሎወን፣ ሜቲፊ ወርቄ፣ ገርቦተ ዺራቲፊ ዱበርቲ፣ ጋለወኒፊ ሀሮተ እሳፍ ኬኔረ። <verse eid="GEN 24:35"/><verse number="36" style="v" sid="GEN 24:36"/>ኒቲን ጎፍታኮቲ ሳራን በረ ዱሉመሼ ኬሰ እልመ እሳፍ ዴሴ፤ እንስ ዋን ቀቡ ሁንደ እልመሳቲፍ ኬኔረ። <verse eid="GEN 24:36"/><verse number="37" style="v" sid="GEN 24:37"/>ጎፍታንኮ አከነ ጄዼ ነ ከከቺሴ፤ ‘አት እንተለን ከነኣን ከኔን አን ብየሳኒ ኬሰ ጅራዹ ኬሳ እልመኮፍ ኒቲ ህንፍድን፤ <verse eid="GEN 24:37"/><verse number="38" style="v" sid="GEN 24:38"/>ገሩ ገረ መነ አባኮቲፊ ገረ ጎሰኮ ዸቂቲ እልመኮቲፍ ኒቲ ፍድ።’<verse eid="GEN 24:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 24:39"/>“አንስ፣ ‘ዮ ዱበርቲን ሱን ነ ወጅን ዹፉፍ ፌዺ ቀባቹ ባቴሆ?’ ጄዼ ጎፍታኮ ነንጋፈዼ።<verse eid="GEN 24:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="GEN 24:40"/>“እንስ አከነ ናን ጄዼ፤ ‘<char style="nd">ዋቀዮ</char> እን አን ፉለሳ ዱረ ጅራዹ ኤርገማሳ ስ ወጅን ኤርጌ ከራኬ ሲፍ ምልኬሰ፤ አትስ ጎሰኮፊ መነ አባኮ ኬሳ እልመኮቲፍ ኒቲ ንፍደ። <verse eid="GEN 24:40"/><verse number="41" style="v" sid="GEN 24:41"/>አት ዮሙ ገረ ጎሰኮ ዸቅጡ ከኩኮራ ብልሰ ታተ፤ ዮ እሳን እንተለ ሰነ ስት ኬኑ ድደንዩ አት ከኩኮራ ብልሰ ታተ።’<verse eid="GEN 24:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 24:42"/>“አን ሀርአ ዮሙን ገረ ቡርቃ ከና ዹፌት አከነን ጄዼ፤ ‘ያ <char style="nd">ዋቀዮ</char>፣ ዋቀ ጎፍታኮ አብረሃም ዮ ፌዺኬ ተኤ ከራ አን ዴሙ ና ምልኬስ። <verse eid="GEN 24:42"/><verse number="43" style="v" sid="GEN 24:43"/>ኩኖ፣ አን ቡርቃ ከነ ብረ ዻበዼረ፤ ዮ ዱርብ ቶኮ ብሻን ወራበቹ ዹፍቴ አንሞ፣ “ማሎ ኦኮቴኬ ኬሳ ብሻን ጥኖሼ ነ ኦባስ” ጄዼኒ፣ <verse eid="GEN 24:43"/><verse number="44" style="v" sid="GEN 24:44"/>እሼንስ፣ “ዹግ፤ አን ጋለወንኬቲፍስ ነንወራበ” ናን ጄቴ፣ እሼን ከን <char style="nd">ዋቀዮ</char> እልመ ጎፍታኮቲፍ ፍሌ ሃታቱ።’<verse eid="GEN 24:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="GEN 24:45"/>“ኡቱ አን ገራኮ ኬሰት ከዸዼ ህንፍጠን ርብቃን ኦኮቴሼ ገቲቲት ባዸቴ ገድ ዹፍቴ። እሼንስ ገረ ቡርቃ ሰናት ገድ ቡቴ ብሻን ወራበቴ፤ አንስ፣ ‘ማሎ ብሻን ነ ኦባስ’ ነንጄዼን።<verse eid="GEN 24:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 24:46"/>“እሼንስ ደፍቴ ኦኮቴሼ ገቲቲራ ገድ ቡፈቴ፣ ‘ዹግ፤ አን ጋለወንኬስ ነንኦባሳ’ ጄቴ። አንስ ነንዹጌ፤ እሼንሞ ጋለወን ኦባፍቴ።<verse eid="GEN 24:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="GEN 24:47"/>“አንስ፣ ‘አት እንተለ ኤኙት?’ ጄዼን እሼ ጋፈዼ።</para>
  <para style="p" vid="GEN 24:47">“እሼሞ፣ ‘አን እንተለ ቤቱኤል፤ ቤቱኤልሞ እልመ ሚልካን ናሆሪፍ ዴሴዸ’ ጄቴ።</para>
  <para style="p" vid="GEN 24:47">“አንስ ፉኛንሼት አመርቲ፣ ሀርከሼትሞ ብተዎ ነንካኤ። <verse eid="GEN 24:47"/><verse number="48" style="v" sid="GEN 24:48"/>አንስ ገድ ጄዼ <char style="nd">ዋቀዮፍ</char> ነንሰገዴ፤ <char style="nd">ዋቀዮ</char> ዋቀ ጎፍታኮ አብረሃም እሰ አከ አን እንተለ ፍረሳ እልመሳቲፍ ጌሱ ከራ ቀጄላረ ነ ቡሴ ሰነ ነንኤብሴ። <verse eid="GEN 24:48"/><verse number="49" style="v" sid="GEN 24:49"/>ኤጋ እስን ዮ ጎፍታኮት ገራ ላፉማፊ አመነሙማ አርግሲፍተን ነት ህማ፤ ዮ ተኡ ባቴሞ አከ አን ገረ ብታት ዮካን ገረ ምርጋት ጎሩ ነት ህማ።”<verse eid="GEN 24:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 24:50"/>ላባፊ ቤቱኤልስ አከነ ጄዸኒ ዴብሰን፤ “ወን ኩን <char style="nd">ዋቀዮ</char> ብራ ዹፌ፤ ኑ ዋን ሀማ ዮካን ዋን ቶላ ስት ዱበቹ ህንደንዴኙ። <verse eid="GEN 24:50"/><verse number="51" style="v" sid="GEN 24:51"/>ኩኖ፣ ርብቃን ፉለኬ ዱረ ጅርት፤ እሼ ፉዸዹ ዴም፤ እሼንስ አኩመ <char style="nd">ዋቀዮ</char> ዱበቴት ኒቲ እልመ ጎፍታኬቲ ሃታቱ።”<verse eid="GEN 24:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="GEN 24:52"/>ተጃጅላን አብረሃምስ ዮሙ ዋን እሳን ጄዸን ዸገኤት ለፈት ጎምብፈሜ <char style="nd">ዋቀዮፍ</char> ሰገዴ። <verse eid="GEN 24:52"/><verse number="53" style="v" sid="GEN 24:53"/>ከነ ቦዴስ ተጃጅላን ሱን ፋየ ሜቲፊ ወርቄ፣ ኡፈተ አደ አዳስ ባሴ ርብቃዻፍ ኬኔ፤ ኦቦሌሰሼቲፊ ሃዸሼቲፍስ ኬና ገቲ ጉዳ ባሱ ኬኔ። <verse eid="GEN 24:53"/><verse number="54" style="v" sid="GEN 24:54"/>እኒፊ ነሞትን እሰ ወጅን ቱረንስ ኛተኒ ዹገኒ አቹመ ቡለን።</para>
  <para style="p" vid="GEN 24:54">ዮሙ እሳን ጉያ እት ኣኑ ገነማን ከአንት ተጃጅላን ሱን፣ “አከ አን ገረ ጎፍታኮት ዴብኡፍ ነ ጌጌሳ” ጄዼ።<verse eid="GEN 24:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="GEN 24:55"/>ኦቦሌስሼቲፊ ሃትሼ ገሩ፣ “እንተለቲን ጉዩመ ኩዸንሌ ኑ ብረ ሃቱርቱ፤ ኤርገሲስ እሼን ዴሙ ደንዴስ” ጄዸን።<verse eid="GEN 24:55"/></para>
  <para style="p">
    <verse number="56" style="v" sid="GEN 24:56"/>እን ገሩ፣ “ኤርገ <char style="nd">ዋቀዮ</char> ከራኮ ና ምልኬሴ እስን ነ ህንቱርስና፤ አከ አን ገረ ጎፍታኮት ዴብኡፍ ነ ጌጌሳ” እሳኒን ጄዼ።<verse eid="GEN 24:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="GEN 24:57"/>እሳንስ፣ “ሜ እንተለቲ ዋምኔ ዋን እሼን ጄቱ ጋፈትነ” ጄዸን። <verse eid="GEN 24:57"/><verse number="58" style="v" sid="GEN 24:58"/>ከነረት እሳን ርብቃ ዋመኒ፣ “ነምቸ ከነ ወጅን ዴሙ ፌታ?” ጄዸኒ እሼ ጋፈተን።</para>
  <para style="p" vid="GEN 24:58">እሼንስ፣ “አን ነንዴመ” ጄቴ።<verse eid="GEN 24:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="GEN 24:59"/>ከናፉ እሳን ኦቦሌቲሳኒ ርብቃፊ ጉድፍቱሼ፣ ተጃጅላ አብረሃሚፊ ነሞተሳ ወጅን ጌጌሰን። <verse eid="GEN 24:59"/><verse number="60" style="v" sid="GEN 24:60"/>እሳንስ አከነ ጄዸኒ ርብቃ ኤብሰን፤</para>
  <para style="q1" vid="GEN 24:60">“ያ ኦቦሌቲኬኘ፣</para>
  <para style="q2" vid="GEN 24:60">ኩማ ኩማተመ ተእ፤</para>
  <para style="q1" vid="GEN 24:60">ሰኚንኬ</para>
  <para style="q2" vid="GEN 24:60">ከረ ዲኖተሳ ሃዻሉ።”<verse eid="GEN 24:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="GEN 24:61"/>ርብቃፊ ተጃጅልቱወንሼ ቆጳአኒ ጋለወንሳኒ ያበተኒ ነምቸ ፋነ ቡአን፤ ነምችስ ርብቃ ፉዸቴ ዴሜ።<verse eid="GEN 24:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="GEN 24:62"/>ዬሮ ሰነ ይስሃቅ ቦለ ብሻኒ ቤኤር ለሃይሮኢቲ ዹፌ ኔጌብ ኬሰ ጅራቻ ቱሬ። <verse eid="GEN 24:62"/><verse number="63" style="v" sid="GEN 24:63"/>እንስ ጋፍ ቶኮ ገረ ገልገላ ኡቱ በኬት በኤ ዋ ያዳ ጅሩ ኦል እላሌ ኩኖ ጋለወን ዹፋ ጅረን አርጌ። <verse eid="GEN 24:63"/><verse number="64" style="v" sid="GEN 24:64"/>ርብቃንስ ኦል እላልቴ ይስሃቅን አርግቴ፤ ጋለራስ ቡቴ <verse eid="GEN 24:64"/><verse number="65" style="v" sid="GEN 24:65"/>ተጃጅላ ሰናን፣ “ነምች ኑ ስመቹፍ በኬ ኬሰ አስ ዴማ ጅሩ ሱን ኤኙ?” ጄቴ ጋፈቴ።</para>
  <para style="p" vid="GEN 24:65">ተጃጅላን ሱንስ፣ “እን ጎፍታኮት” ጄዼ ዴብሴፍ። ከናፉ ሀጉጊሼ ፉዸቴ ኦፍት ሀጉግዴ።<verse eid="GEN 24:65"/></para>
  <para style="p">
    <verse number="66" style="v" sid="GEN 24:66"/>ተጃጅላን ሱንስ ዋን ሆጄቴ ሁንደ ይስሃቅት ህሜ። <verse eid="GEN 24:66"/><verse number="67" style="v" sid="GEN 24:67"/>ይስሃቅስ ዱንካነ ሃዸሳ ሳራት ኦል እሼ ገልፈቴ፤ ርብቃ ፉዼስ። አከሲን እሼን ኒቲሳ ታቴ፤ እንስ እሼ ጃለቴ፤ ይስሃቅስ ዱአ ሃዸሳራ ንጀጀባቴ።<verse eid="GEN 24:67"/></para>
  <chapter eid="GEN 24"/>
  <chapter number="25" style="c" sid="GEN 25"/>
  <para style="s1">አብረሃም ዱኡሳ</para>
  <para style="r">
    <ref loc="GEN 25:1-4">25፥1‑4</ref> ኩወፈ – <char style="xt"><ref loc="1CH 1:32-33">1ሴና 1፥32‑33</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 25:1"/>አብረሃምስ ኒቲ ብራ ከን መቃንሼ ቄጡራ ጄዸሙ ፉዼ። <verse eid="GEN 25:1"/><verse number="2" style="v" sid="GEN 25:2"/>እሼንስ ዝምራን፣ ዮቅሻን፣ ሜዳን፣ ምድያን፣ ይሽባቂፊ ሹዋ እሳፍ ዴሴ። <verse eid="GEN 25:2"/><verse number="3" style="v" sid="GEN 25:3"/>ዮቅሻን ሼባፊ ዴዳን ዸልቼ፤ እልማን ዴዳንሞ አሹርም፣ ሌቱሽሞታፊ ሌኡሞተ ቱረን። <verse eid="GEN 25:3"/><verse number="4" style="v" sid="GEN 25:4"/>እልማን ምድያን ኤፋ፣ ኤፌር፣ ሄኖክ፣ አቢዳፊ ኤልዳኣ ቱረን። ወር ኩኔን ሁንድ ሰኚወን ቄጡራት።<verse eid="GEN 25:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 25:5"/>አብረሃም ዋን ቀቡ ሁንዱማ ይስሃቂፍ ኬኔ። <verse eid="GEN 25:5"/><verse number="6" style="v" sid="GEN 25:6"/>እልማን ሳጀቶወንሳቲፍ ገሩ ኡቱመ ሉቡን ጅሩ ኬና ኬኔፊ እልመሳ ይስሃቅ ብራ ገረ ብየ በአ ቢፍቱት እሳን ኤርጌ።<verse eid="GEN 25:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 25:7"/>አብረሃም ወጋ ዽበ ቶኮፊ ቶርባተሚ ሸን ጅራቴ። <verse eid="GEN 25:7"/><verse number="8" style="v" sid="GEN 25:8"/>እንስ ኡሙሪ ዼራፊ ጅሬኘ ጋሪ ጅራቴ ዱሎሜ ሀፉረ ዹማ ባፈቴ ዱኤ፤ ሰበ እሳትስ ደበለሜ። <verse eid="GEN 25:8"/><verse number="9" style="v" sid="GEN 25:9"/>እልማንሳ ይስሃቂፊ እሽማኤል ለፈ ቆቲሳ ኤፍሮን እልመ ዞሀር ነምቸ ጎሰ ሄት ሰና ኬሰት ሆልቀ መክፌላ ከን መምሬ ብረት አርገሙት እሰ አዋለን። <verse eid="GEN 25:9"/><verse number="10" style="v" sid="GEN 25:10"/>ለፍት ቆቲሳ ሱንስ ከን አብረሃም ሄቶተራ ብተቴዸ፤ አብረሃምስ አችት ኒቲሳ ሳራ ብረት አዋለሜ። <verse eid="GEN 25:10"/><verse number="11" style="v" sid="GEN 25:11"/>ኤርገ አብረሃም ዱኤ ቦዴ ዋቅን እልመሳ ይስሃቅን ኤብሴ፤ ይስሃቅስ ቤኤር ለሃይሮኢ ብረ ጅራቴ።<verse eid="GEN 25:11"/></para>
  <para style="s1">እልማን እሽማኤል</para>
  <para style="r">
    <ref loc="GEN 25:12-16">25፥12‑16</ref> ኩወፈ – <char style="xt"><ref loc="1CH 1:29-31">1ሴና 1፥29‑31</ref></char></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 25:12"/>ሴናን ማቲ እሽማኤል እልመ አብረሃም ከን አጋር ገርብቲን ሳራ እንተል ብየ ግብጥ ሱን አብረሃሚፍ ዴሴ ሰና ከነ።<verse eid="GEN 25:12"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="13" style="v" sid="GEN 25:13"/>መቃን እልማን እሽማኤል ከን አኩመ ዸሎተሳኒት ተርቲባን በሬፈሜ ከነ፦</para>
  <para style="b" vid="GEN 25:13"/>
  <para style="li1" vid="GEN 25:13">ነባዮት እልመ እሽማኤል ሀንገፍትቸ፣</para>
  <para style="li1" vid="GEN 25:13">ቄዳር፣ አድብኤል፣ ምብሳም፣<verse eid="GEN 25:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="GEN 25:14"/>ምሽማ፣ ዱማ፣ ማሳ፣<verse eid="GEN 25:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="GEN 25:15"/>ሀዳድ፣ ቴማ፣ ዬጡር፣</para>
  <para style="li1" vid="GEN 25:15">ናፊሺፊ ቄድማ።<verse eid="GEN 25:15"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="16" style="v" sid="GEN 25:16"/>ጀር ኩኔን እልማን እሽማኤል፤ መቃወን ኩኔንስ አኩመ ገንዶታፊ እዶ ቁበተሳኒት መቃወን ቡልችቶተ ጎሶተ ኩዸ ለማኒት።<verse eid="GEN 25:16"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="17" style="v" sid="GEN 25:17"/>እሽማኤል ወጋ ዽበ ቶኮፊ ሶዶሚ ቶርበ ጅራቴ፤ እንስ ሀፉረ ዹማ ባፈቴ ዱኤ፤ ሰበ እሳትስ ደበለሜ። <verse eid="GEN 25:17"/><verse number="18" style="v" sid="GEN 25:18"/>ሰኚንሳሞ ዳንጋ ግብጥ ብረ፣ ከራ አሶርት ጌሱረ፣ ለፈ ሀዊላ ጀልቀቤ ሀመ ሹሪት ጅሩረ ጅራተን። እሳንስ ኦቦሎተሳኒ ሁንደት ዲነ ተአኒ ጅራተን።<verse eid="GEN 25:18"/></para>
  <para style="s1">ያቆቢፊ ኤሳዉ</para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 25:19"/>ሴናን ማቲ ይስሃቅ እልመ አብረሃም ከነ።</para>
  <para style="b" vid="GEN 25:19"/>
  <para style="p" vid="GEN 25:19">አብረሃም ይስሃቅን ዸልቼ፤ <verse eid="GEN 25:19"/><verse number="20" style="v" sid="GEN 25:20"/>ይስሃቅ ዬሮ ርብቃ ፉዼት ነመ ወጋ አፉርተማ ቱሬ፤ ርብቃን ኩንስ እንተለ ቤቱኤል ነምቸ አራም ከን ካበ ዽአ ጳዳን አራሚቲፊ ኦቦሌቲ ላባ ነምቸ አራም ሰናት።<verse eid="GEN 25:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 25:21"/>ይስሃቅ ሰበቢ ኒቲንሳ ዸብዱ ቱርቴፍ <char style="nd">ዋቀዮን</char> እሼፍ ከዸቴ። <char style="nd">ዋቀዮስ</char> ከዸትናሳቲፍ ዴቢ ኬኔ ኒቲንሳ ርብቃን ኡልፎፍቴ። <verse eid="GEN 25:21"/><verse number="22" style="v" sid="GEN 25:22"/>ዳእመንስ ገራሼ ኬሰት ወል ዺባ ቱረን፤ እሼንስ፣ “ወን ኩን ማሊፍ ነት ዹፌ?” ጄቴ፤ ከናፉ <char style="nd">ዋቀዮ</char> ጋፈቹ ዸቅጤ።<verse eid="GEN 25:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 25:23"/>
    <char style="nd">ዋቀዮ</char>ሞ አከነ ጄዼን፤</para>
  <para style="q1" vid="GEN 25:23">“ሰቦተ ለመቱ ገደሜሰኬ ኬሰ ጅረ፤</para>
  <para style="q2" vid="GEN 25:23">ኡመትን ለማን አት ዴሱስ ገርገር በኡ፤</para>
  <para style="q1" vid="GEN 25:23">ሰብን ቶኮ ሰበ ካንረ ንጀባተ፤</para>
  <para style="q2" vid="GEN 25:23">እን ሀንገፍን እሰ ቁጥሱ ተጃጅለ።”<verse eid="GEN 25:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 25:24"/>ዬሮ ደኡምስሼ ገኤት እልማን ለኩቱ ገደሜሰሼ ኬሰ ቱሬ። <verse eid="GEN 25:24"/><verse number="25" style="v" sid="GEN 25:25"/>ሙጫን ጀልቀበት ዸለቴ ዲማዸ፤ ዸግንሳ ጉቱን ኡፈተ ርፌንሰ ቀቡ ፈካተ ቱሬ፤ ከናፉ ኤሳዉ ጄዸኒ እሰ ሞጋሰን። <verse eid="GEN 25:25"/><verse number="26" style="v" sid="GEN 25:26"/>ከነ ቦዴ ኦቦሌስሳ ኮሜ ኤሳዉ ሀርካን ቀበቴ ገድ በኤ፤ መቃንሳስ ያቆብ ጄዸሜ። ዬሮ ርብቃን እሳን ዴሴት፣ ይስሃቅ ነመ ወጋ ጃተማ ቱሬ።<verse eid="GEN 25:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 25:27"/>እጆሌን ኩንስ ንጉደተን፤ ኤሳዉ አደምሳ ቤከማፊ ነመ በኬ ኦሉ ተኤ፤ ያቆብ ገሩ ነመ ጨልእሳ ዱንካነ ኬሰ ኦሉ ተኤ። <verse eid="GEN 25:27"/><verse number="28" style="v" sid="GEN 25:28"/>ይስሃቅ ዋን ፎን ብኔንሰ ቦሶና ምኤፈቴፍ ኤሳዉን ጃለቴ፤ ርብቃን ገሩ ያቆብን ጃለቴ።<verse eid="GEN 25:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 25:29"/>ጋፍ ቶኮ ኡቱ ያቆብ እቶ ቆጴሳ ጅሩ ኤሳዉ አከ መሌ ቤለኤ በኬዻ ዹፌ። <verse eid="GEN 25:29"/><verse number="30" style="v" sid="GEN 25:30"/>እንስ ያቆቢን፣ “አን አከ መሌ ቤለኤራቲ፣ ሜ እቶ ዲማ ሰነራ ጥኖ ና ኬን!” ጄዼ። ሰበቢን እን ኤዶም ጄዸሜፍስ ከኑመ።<verse eid="GEN 25:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 25:31"/>ያቆብሞ ዴብሴ፣ “ዱረ ምርገ ሀንገፉማኬቲ ነት ጉርጉር ካ” ጄዼ።<verse eid="GEN 25:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 25:32"/>ኤሳዉስ፣ “ኩኖ፣ አን ዱኡ ገኤረ፤ ዮስ ምርግ ሀንገፉማ ማል ነ ፈየደሬ?” ጄዼ።<verse eid="GEN 25:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 25:33"/>ያቆብ ገሩ፣ “ዱራን ዱርሲ ና ከከዹ” ጄዼን፤ አከሲን እን ከከቴ ምርገ ሀንገፉማሳ ያቆብት ጉርጉረቴ።<verse eid="GEN 25:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 25:34"/>ኤርገሲስ ያቆብ ቡዴናፊ እቶ ምስራ ኤሳዉፍ ኬኔ፤ እንስ ኛቴ ዹጌ ከኤ አቺ ዴሜ።</para>
  <para style="p" vid="GEN 25:34">ኤሳዉስ አከሲን ምርገ ሀንገፉማሳ ቱፈቴ።<verse eid="GEN 25:34"/></para>
  <chapter eid="GEN 25"/>
  <chapter number="26" style="c" sid="GEN 26"/>
  <para style="s1">ይስሃቂፊ አቢሜሌክ</para>
  <para style="r">
    <ref loc="GEN 26:1-11">26፥1‑11</ref> ኩወእ – <char style="xt"><ref loc="GEN 12:10-20">ኡመ 12፥10‑20</ref>፤ <ref loc="GEN 20:1-18">20፥1‑18</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 26:1"/>ቤለ እሰ በረ አብረሃም ብይቸት ቡኤ ሰነ መሌ ቤል ብራ ቶኮ አመስ ብየ ሰነት ቡኤ፤ ይስሃቅስ ገረ ጌራራ ገረ አቢሜሌክ ሞትቸ ፍልስጤም ዸቄ። <verse eid="GEN 26:1"/><verse number="2" style="v" sid="GEN 26:2"/><char style="nd">ዋቀዮስ</char> ይስሃቅት ሙልአቴ አከነ ጄዼ፤ “ብየ አን አከ አት ኬሰ ጅራቱፍ ስት ህሙ ኬሰ ጅራዹ መሌ ግብጥት ገድ ህንቡእን። <verse eid="GEN 26:2"/><verse number="3" style="v" sid="GEN 26:3"/>ብዩመ ከነ ጅራዹ፤ አን ስ ወጅን ነንተአ፤ ስን ኤብሰስ፤ ብየ ከነ ሁንደ ሲፊ ሰኚኬቲፍ ነንኬናቲ። አን ከኩን አባኬ አብረሃሚፍ ከከዼ ሰነ ነንጉተ። <verse eid="GEN 26:3"/><verse number="4" style="v" sid="GEN 26:4"/>አን አኩመ ኡርጂወን ሰሚ ሰኚኬ ነንባይእሰ፤ ብየ ከነ ሁንደስ እሳኒፍ ነንኬነ፤ ሰቦትን ለፈረ ጅረን ሁንድኑስ ከራ ሰኚኬቲቲን ኤብፈሙ። <verse eid="GEN 26:4"/><verse number="5" style="v" sid="GEN 26:5"/>ኩንስ ዋን አብረሃም ዱቢኮ ዸገኤ ፌዺኮ፣ አጀጀኮ፣ ለብሲኮቲፊ ሴረኮ ኤጌፍ።” <verse eid="GEN 26:5"/><verse number="6" style="v" sid="GEN 26:6"/>ይስሃቅስ ጌራራ ኬሰ ጅራቴ።<verse eid="GEN 26:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 26:7"/>እንስ ዮሙ ነሞትን ብየ ሰና ዋኤ ኒቲሳ እሰ ጋፈተንት ዋን ርብቃን በሬዱ ታቴፍ፣ “ነሞትን ናኖ ከና ሰበቢሼቲፍ ነ አጄሱ ተአ” ጄዼ ያዱዻን፣ “እሼን ኒቲኮት” ጄቹ ሶዳቴ፣ “እሼን ኦቦሌቲኮት” ጄዼ።<verse eid="GEN 26:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 26:8"/>ኤርገ ይስሃቅ ዬሮ ዼራ አች ጅራቴ ቦዴ፣ አቢሜሌክ ሞትች ፍልስጤሚ ፎዳ ኬሳን ገድ እላሌ፤ ኡቱ ይስሃቅ ኒቲሳ ርብቃ ሆቅሱ አርጌ። <verse eid="GEN 26:8"/><verse number="9" style="v" sid="GEN 26:9"/>አቢሜሌክስ ይስሃቅን ኦፍት ዋሜ፣ “እሼን ዹጉማን ኒቲኬት! ዮስ አት ማሊፍ፣ ‘እሼን ኦቦሌቲኮት’ ጄቴሬ?” ጄዼን።</para>
  <para style="p" vid="GEN 26:9">ይስሃቅስ፣ “ዋን አን ሰበቢሼቲፍ ሉቡኮ ነንዸበ ተአ ጄዼ ያዴፍ” ጄዼ ዴብሴፍ።<verse eid="GEN 26:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 26:10"/>አቢሜሌክሞ፣ “ወን አት ኑት ሆጄቴ ኩን ማል? ኡቱ ነሞተ ከኔን ኬሳ ቶኮ ኒቲኬ ወጅን ጪሴ ጅራቴ ስላ አት የከ ኑት ፍዴ ቱርቴ” ጄዼን።<verse eid="GEN 26:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 26:11"/>ከነረት አቢሜሌክ፣ “ነምን ነምቸ ከነ ዮካን ኒቲሳ ቱቁ ከምዩ ዹጉማን አጄፈሙ ቀበ” ጄዼ ነመ ሁንዳፍ አጀጀ ኬኔ።<verse eid="GEN 26:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 26:12"/>ይስሃቅስ ብየ ሰነት ምዻን ፈጫፈቴ ዋን <char style="nd">ዋቀዮ</char> እሰ ኤብሴፍ በሩመ ሰነ ኬሰ ደቻ ዽበ ገልፈቴ። <verse eid="GEN 26:12"/><verse number="13" style="v" sid="GEN 26:13"/>እንስ ንሆሬ፤ ሀመ አከ መሌ ሶሮሙትስ ቀቤኝሳ እቱመ ፉፌ ባይአቴ። <verse eid="GEN 26:13"/><verse number="14" style="v" sid="GEN 26:14"/>እንስ ቡሻዬ፣ ሎወኒፊ ሆጄቶተ ሄዱ ቀበ ቱሬ፤ ፍልስጤሞትንስ እሰት ህናፈን። <verse eid="GEN 26:14"/><verse number="15" style="v" sid="GEN 26:15"/>ከናፉ ፍልስጤሞትን ቦለ ብሻኒ ሆጄቶትን አባሳ በረ አብረሃም ኬሰ ቆተን ሁንደት ብዮ ነቀኒ ዱቸን።<verse eid="GEN 26:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 26:16"/>አቢሜሌክስ ይስሃቂን፣ “አት ባይኤ ኑ ጫላ ጀባቴርታቲ ኑራ ዴም” ጄዼ።<verse eid="GEN 26:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 26:17"/>ይስሃቅ አቺ ከኤ ሱሉለ ጌራራ ኬሰ ቁበቴ አች ጅራቴ። <verse eid="GEN 26:17"/><verse number="18" style="v" sid="GEN 26:18"/>ይስሃቅስ ቦለወን ብሻኒ በረ አባሳ በረ አብረሃም ኬሰ ቆተመን ከኔን ፍልስጤሞትን ኤርገ አብረሃም ዱኤ ቦዴ ዱቸን ሰነ ዴብሴ በኔ፤ እንስ መቁመ አባንሳ ኬኔፊ ቱሬ ሰናን እሳን ዋሜ።<verse eid="GEN 26:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 26:19"/>ተጃጅልቶትን ይስሃቅ ሱሉለ ሰነ ኬሰት ለፈ ቆተኒ ቦለ ብሻን ቡርቁ አርገተን። <verse eid="GEN 26:19"/><verse number="20" style="v" sid="GEN 26:20"/>ትክሶትን ጌራራ፣ “ብሻን ኩን ከንኬኘ!” ጄዸኒ ትክሶተ ይስሃቅ ወጅን ወል ሎለን። ከናፉ እን ሰበቢ ወል ፈልመኒፍ ቦለ ብሻኒ ሰነ፣ “ኤሴቅ” ጄዼ ሞጋሴ። <verse eid="GEN 26:20"/><verse number="21" style="v" sid="GEN 26:21"/>ኤርገሲስ ቦለ ብሻኒ ብራ ቆተን፤ እሳን ገሩ ቦለ ብሻኒ ሰነረትስ ወል ሎለን፤ ከነረት ይስሃቅ ቦለ ብሻኒ ሰነ “ስጥና” ጄዼ ሞጋሴ። <verse eid="GEN 26:21"/><verse number="22" style="v" sid="GEN 26:22"/>እንስ አቺ ከኤ እዶ ብራ ዸቄ ቦለ ብሻኒ ብራ አችት ቆቴ፤ ነምን ቶኮዩ እሰረት ወል ህንሎሌ። እንስ፣ “<char style="nd">ዋቀዮ</char> አመ እዶ በልኣ ኑ ኬኔረ፤ ኑ ብየቲ ኬሰት ንባይአትነ” ጄቹዻን ሬሆቦት ጄዼን።<verse eid="GEN 26:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 26:23"/>እንስ አቺ ከኤ ገረ ቤርሼባት ኦል በኤ። <verse eid="GEN 26:23"/><verse number="24" style="v" sid="GEN 26:24"/><char style="nd">ዋቀዮስ</char> ሀልከኑመ ሰነ እሰት ሙልአቴ አከነ ጄዼን፤ “አን ዋቀ አባኬ አብረሃም፤ አን ዋን ስ ወጅን ጅሩፍ ህንሶዳትን። ገርብቸኮ አብረሃሚፍ ጄዼስ አን ስን ኤብሰ፤ ሰኚኬስ ነንባይእሰ።”<verse eid="GEN 26:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 26:25"/>ይስሃቅ አችት እዶ ኣርሳ እጃሬ መቃ <char style="nd">ዋቀዮ</char> ዋመቴ። ዱንካነሳስ አች ዻበቴ፤ ተጃጅልቶትንሳስ እዶ ሰነት ቦለ ብሻኒ ቆተተን።<verse eid="GEN 26:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 26:26"/>ኤርገሲስ አቢሜሌክ ጎርሳሳ አሁዛቲፊ አጀጃ ሎልቶተሳ ፊኮል ወጅን ጌራራዻ ከኤ ገረ ይስሃቅ ዹፌ። <verse eid="GEN 26:26"/><verse number="27" style="v" sid="GEN 26:27"/>ይስሃቅሞ፣ “እስን ኤርገ ነ ጅብተኒ ኦፍ ብራ ነ አሪተኒ ማሊፍ ገረኮ ዹፍተን?” እሳኒን ጄዼ።<verse eid="GEN 26:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 26:28"/>እሳንስ አከነ ጄዸኒ ዴብሰን፤ “ኑ አከ <char style="nd">ዋቀዮ</char> ስ ወጅን ጅሩ እፋን እፈት አርግኔረ፤ ከናፉ ኑ፣ ‘ከኩን ወሊ ገልቴ ግዱኬኘ ጄቹንስ ኑፊ ስ ግዱ ጅራቹ ቀበ’ ጄኔ፤ ሜ ኮቱ ስ ወጅን ወሊ ገልቴ ጎዸትና። <verse eid="GEN 26:28"/><verse number="29" style="v" sid="GEN 26:29"/>ኩንስ አኩመ ኑ ኡቱ ዋን ጋሪ መሌ ዋን ሀማ ስራን ህንገእን ነጋን ኦፍራ ስጌጌስኔ ሰነ አከ አትስ ኑ ህንሚኔፍ። አት አመሌ ነመ <char style="nd">ዋቀዮ</char> ኤብሴዸ።”<verse eid="GEN 26:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 26:30"/>ይስሃቅስ ኛተ እሳኒፍ ቆጴሴ፤ እሳንስ ንኛተን፤ ንዹገንስ። <verse eid="GEN 26:30"/><verse number="31" style="v" sid="GEN 26:31"/>ነሞትን ሱን ጉያ እት ኣኑ ገነመ በራቀ ከአኒ ወሊ ከከተን። ይስሃቅስ እሳን ጌጌሴ፤ ጀርስ ነጉማን እሰ ብራ ዴመን።<verse eid="GEN 26:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 26:32"/>ጉዩመ ሰነ ሆጄቶትን ይስሃቅ ዹፈኒ ዋኤ ቦለ ብሻኒ ቆተን ሰናሳት ህመን። እሳንስ፣ “ኑ ብሻን አርገኔረ!” ጄዸን። <verse eid="GEN 26:32"/><verse number="33" style="v" sid="GEN 26:33"/>እንስ ቦለ ብሻኒ ሰነ፣ “ሽቤኣ” ጄዼ ሞጋሴ። ሀመ ሀርኣት መቃን መጋላ ሰና ቤርሼባ ጄዸመ።<verse eid="GEN 26:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 26:34"/>ኤሳዉ ዬሮ ኡሙሪንሳ ወጋ አፉርተመ ጉቴት ዮዲት እንተለ ብኤር ነምቸ ጎሰ ሄት አከሱመስ ባስመት እንተለ ኤሎን ነምቸ ጎሰ ሄት ፉዼ። <verse eid="GEN 26:34"/><verse number="35" style="v" sid="GEN 26:35"/>እሳንስ ይስሃቂፊ ርብቃ ገድሲሰን።<verse eid="GEN 26:35"/></para>
  <chapter eid="GEN 26"/>
  <chapter number="27" style="c" sid="GEN 27"/>
  <para style="s1">ይስሃቅ ያቆብን ኤብሴ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 27:1"/>ይስሃቅ ዱሎሜ ዬሮ እጅሳ አርጉ ደዸቤት እልመሳ ሀንገፈ ኤሳዉን ኦፍት ዋሜ፣ “ያ እልመኮ” ጄዼን።</para>
  <para style="p" vid="GEN 27:1">እንስ፣ “ኩኖ አሰን ጅረ” ጄዼ ዴብሴ።<verse eid="GEN 27:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 27:2"/>ይስሃቅ አከነ ጄዼ፤ “ኩኖ፣ አን ዱሎሜረ፤ ጉያ ዱአኮ ህንቤኩ። <verse eid="GEN 27:2"/><verse number="3" style="v" sid="GEN 27:3"/>ከናፉ ማሎ ምአ አደሞኬቲ ጄቹንስ ኮሮጆ ጥየኬቲፊ እዳኬ ቀበዹቲ ገረ ድሬት በኢቲ ብኔንሰ ና አደምስ። <verse eid="GEN 27:3"/><verse number="4" style="v" sid="GEN 27:4"/>አከ አን ኡቱን ህንዱእኒን ዱረ ስ ኤብሱፍ፣ ኛተ ምኣዋ ጎሰ አን ጃለዹ ና ቆጴሲቲ አከ አን ኛዹፍ ና ዽኤስ።”<verse eid="GEN 27:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 27:5"/>ዮሙ ይስሃቅ እልመሳ ኤሳዉት ዱበቴት ርብቃን ንዸጌፈት ቱርቴ። ዬሮ ኤሳዉ ብኔንሰ አደምሴ ፍዱፍ ገረ ድሬት ገድ በኤት፣ <verse eid="GEN 27:5"/><verse number="6" style="v" sid="GEN 27:6"/>ርብቃን እልመሼ ያቆቢን አከነ ጄቴ፤ “ኩኖ፣ አን ኡቱ አባንኬ ኦቦሌሰኬ ኤሳዉት ዱበቱ ዸገኤረ፤ <verse eid="GEN 27:6"/><verse number="7" style="v" sid="GEN 27:7"/>እንስ፣ ‘አከ አን ኡቱን ህንዱእን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ስ ኤብሱፍ ብኔንሰ አደምሲ ፍዲቲ አከ አን ኛዹፍ ኛተ ምኣዉ ና ቆጴስ’ ጄዼን። <verse eid="GEN 27:7"/><verse number="8" style="v" sid="GEN 27:8"/>ኤጋ ያ እልመኮ፣ አኩመ አን ስ አጀጁት ዱቢኮ ዸገእ። <verse eid="GEN 27:8"/><verse number="9" style="v" sid="GEN 27:9"/>አን አከን አባኬቲፍ አኩመ እን ጃለቱት ኛተ ምኣዋ ቆጴሱፍ ገረ ቡሻዬ ዸቂቲ እልሞሌ ሬኤ ፍለተሞ ለመ ና ፍድ። <verse eid="GEN 27:9"/><verse number="10" style="v" sid="GEN 27:10"/>አከ እን ኛቴ ኡቱ ህንዱእን ስ ኤብሱፍ አባኬቲፍ ኛተ ዽኤስ።”<verse eid="GEN 27:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 27:11"/>ያቆብስ ሃዸሳ ርብቃዻን አከነ ጄዼ፤ “ኩኖ፣ ኦቦሌስኮ ኤሳዉ ደበሳኣዸ፤ አን ገሩ ርፌንሰ ህንቀቡ። <verse eid="GEN 27:11"/><verse number="12" style="v" sid="GEN 27:12"/>ዮ አባንኮ ነ ቀቀበቴ ዋን አን እሰ ጎዎምሴ ሴኤ፣ አን ቆደ ኤባ አባርሰ ኦፍት ነንፍደ።”<verse eid="GEN 27:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 27:13"/>ሃትሳሞ፣ “ያ እልመኮ፣ አባርስ ሱን ናፍ ሃተኡ፤ አት ዋኑመ አን ሲን ጄዼ ጎዽ፤ ዸቂቲ ሬኦተ ሰነ ና ፍድ” ጄቴን።<verse eid="GEN 27:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 27:14"/>እንስ ዸቄ እልሞሌ ሬኦታ ሰነ ቀቤ ሃዸሳቲፍ ፍዴ፤ እሼንሞ አኩመ አባንሳ ጃለቱት ኛተ ምኣዉ ቆጴስቴፍ። <verse eid="GEN 27:14"/><verse number="15" style="v" sid="GEN 27:15"/>ኤርገሲስ ርብቃን ኡፈተ ኤሳው እልመሼ ሀንገፍትቻ ከን እሼ ብረ ቱሬ ኬሳ ከን ሁንደረ በሬዱ ፉቴ ያቆብ እልመሼ እሰ ቁጥሱ ሰነት ኡፍፍቴ። <verse eid="GEN 27:15"/><verse number="16" style="v" sid="GEN 27:16"/>ሀርከሳቲፊ ሞርመሳ እዶ ርፌንሰ ህንቀብኔት ጎጋ ሬኦታ ኡፍፍቴ። <verse eid="GEN 27:16"/><verse number="17" style="v" sid="GEN 27:17"/>ኤርገሲስ ኛተ ምኣዋፊ ቡዴነ ቆጴስቴ ቱርቴ ሰነ እልመሼ ያቆብት ኬንቴ።<verse eid="GEN 27:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 27:18"/>እንስ ገረ አባሳ ዸቄ፣ “ያ አባኮ” ጄዼ።</para>
  <para style="p" vid="GEN 27:18">እንስ፣ “ያ እልመኮ፣ ኩኖ አሰን ጅረ፤ አት ኤኙ?” ጄዼ ዴብሴ።<verse eid="GEN 27:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 27:19"/>ያቆብስ አባሳቲን አከነ ጄዼ፤ “አን ኤሳዉ እልመኬ እሰ ሀንገፍትቸ፤ አኩመ አት ነት ህምቴ ሰነ ጎዼረ፤ አከ ነ ኤብፍቱፍ ሜ ኦል ጄዺቲ ዋን አን አደምሴ ፍዴ ኛዹ።”<verse eid="GEN 27:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 27:20"/>ይስሃቅ እልመሳቲን፣ “ያ እልመኮ፣ አከምት አከነ ደፍቴ አርገቴ?” ጄዼ።</para>
  <para style="p" vid="GEN 27:20">ያቆብሞ፣ “<char style="nd">ዋቀዮ</char> ዋቀ ኬቱ ነ ምልኮምሴ” ጄዼ ዴብሴ።<verse eid="GEN 27:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 27:21"/>ይስሃቅስ ያቆቢን፣ “አከ አን ስ ቀቀበዼ እልመኮ ኤሳው ተኡፊ ተኡ ባቹኬ ቤኩፍ ሜ አስ ዽኣዹ” ጄዼ።<verse eid="GEN 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 27:22"/>ያቆብስ አባሳ ይስሃቅት ዽኣቴ፤ አባንሳስ እሰ ቀቀበቴ፣ “ሰገሌን ኩን ሰገሌ ያቆብ፤ ሀርክ ኩን ገሩ ሀርከ ኤሳዉ” ጄዼ። <verse eid="GEN 27:22"/><verse number="23" style="v" sid="GEN 27:23"/>ዋን ሀርክሳ አኩመ ሀርከ ኤሳዉ ርፌንሰ ቀቡፍ ይስሃቅ ገርገር ባሴ እሰ ቤኩ ህንደንዴኜ፤ ከናፉ እሰ ኤብሴ። <verse eid="GEN 27:23"/><verse number="24" style="v" sid="GEN 27:24"/>እንስ፣ “አት ዹጉማን እልመኮ ኤሳዉ?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="GEN 27:24">እንሞ፣ “ኤዬ አን እሱመ” ጄዼ ዴብሴ።<verse eid="GEN 27:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 27:25"/>ይስሃቅስ፣ “ያ እልመኮ፣ አከ አን ኛዼ ስ ኤብሱፍ ሜ ዋን አደምስቴ ፍዴ ሰነ ና ኬን” ጄዼ።</para>
  <para style="p" vid="GEN 27:25">ያቆብ ንዽኤሴፍ፤ እንስ ንኛቴ፤ ዳዺ ወይኒስ ንፍዴፍ፤ እንስ ንዹጌ። <verse eid="GEN 27:25"/><verse number="26" style="v" sid="GEN 27:26"/>አባንሳ ይስሃቅስ፣ “ያ እልመኮ አስ ኮቱ ነ ዹንገዹ” ጄዼን።<verse eid="GEN 27:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 27:27"/>እንስ እት ዽኣቴ እሰ ዹንገቴ። ይስሃቅስ ፎሊ ወያሳ ሱፌ እሰ ኤብሴ፤ አከነስ ጄዼ፤</para>
  <para style="q1" vid="GEN 27:27">“እላ፣ ፎሊን እልመኮ፣</para>
  <para style="q2" vid="GEN 27:27">አኩመ ፎሊ ለፈ ቆቲሳ</para>
  <para style="q2" vid="GEN 27:27">
    <char style="nd">ዋቀዮ</char> ኤብሴት።<verse eid="GEN 27:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="GEN 27:28"/>ዋቅን ፍጤንሰ ሰሚ፣</para>
  <para style="q2" vid="GEN 27:28">ለፈ ገበታ፣ ምዻኒፊ</para>
  <para style="q2" vid="GEN 27:28">ወይኒ አከ መሌ ባይአቱ ሲፍ ሃኬኑ።<verse eid="GEN 27:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="GEN 27:29"/>ሰቦትን ስ ሃተጃጅለን፤</para>
  <para style="q2" vid="GEN 27:29">ኡመትንስ ሲፍ ሃሰገደን።</para>
  <para style="q1" vid="GEN 27:29">ኦቦሎተኬረት ጎፍታ ተእ፤</para>
  <para style="q2" vid="GEN 27:29">እልማን ሃዸኬቲስ ሲፍ ሃሰገደን።</para>
  <para style="q1" vid="GEN 27:29">ወር ስ አባረን ሃአባረመን፤</para>
  <para style="q2" vid="GEN 27:29">ወር ስ ኤብሰንሞ ሃኤብፈመን።”<verse eid="GEN 27:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 27:30"/>አኩመ ይስሃቅ ያቆብን ኤብሴ ፍጤ ያቆብሞ ፉለ አባሳ ፉለ ይስሃቅ ዱራ ገድ በኤን፣ ኦቦሌስሳ ኤሳዉ አደሞዻ ዹፌ ኦል ገሌ። <verse eid="GEN 27:30"/><verse number="31" style="v" sid="GEN 27:31"/>እንስ ኛተ ምኣዋ ቆጴሴ አባሳቲፍ ፍዴ፤ አባሳቲንስ፣ “ያ አባኮ፣ አት አከ ነ ኤብፍቱፍ ኦል ጄዺቲ ዋን አን እልምኬ አደምሴ ፍዴ ኛዹ” ጄዼ።<verse eid="GEN 27:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 27:32"/>አባንሳ ይስሃቅስ፣ “አት ኤኙ?” ጄዼ እሰ ጋፈቴ።</para>
  <para style="p" vid="GEN 27:32">እንስ፣ “አን እልመኬ ኤሳዉ ሀንገፍትቸ” ጄዼ።<verse eid="GEN 27:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 27:33"/>ዮሙስ ይስሃቅ አከ መሌ ሆለቻ፣ “ዮስ ነምን ዋ አደምሴ ና ፍዴ ኤኙሬ? አን ኡቱ አት ህንዹፍን ሁንዱመሳ ኛዼን እሰ ኤብሴ፤ እን ዹጉማን ንኤብፈመ!” ጄዼ።<verse eid="GEN 27:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 27:34"/>ኤሳዉ ዮሙ ዋን አባንሳ ዱበቴ ዸገኤት፣ አባሳቲን፣ “ያ አባኮ፣ አነስ ኤብስ!” ጄዼ ሰገሌ ኦል ፉዸቴ ህቅፈቴ ቦኤ።<verse eid="GEN 27:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 27:35"/>ይስሃቅ ገሩ፣ “ኦቦሌስኬ ሀጡማዻን ዹፌ ኤበኬ ፉዸቴረ” ጄዼ።<verse eid="GEN 27:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 27:36"/>ኤሳዉስ፣ “መቃንሳዩ ዹጉማን ያቆብ ጄዸመ ምቲ? እን ከነ ወጅን ዬሮ ለመ ነ ጎዎምሱሳት፤ ጀልቀበት ሀንገፉማኮ ነራ ፉዸቴ፤ አመሞ ኤበኮ ፉዸቴረ” ጄዼ። ኤርገሲስ እን፣ “አት ኤበ ቶኮሌ ና ህንሀምብፍኔሬ?” ጄዼ ጋፈቴ።<verse eid="GEN 27:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 27:37"/>ይስሃቅሞ አከነ ጄዼ ኤሳዉፍ ዴብሴ፤ “ኩኖ አን አከ እን ስረት ጎፍታ ተኡፊ አከ ፍሮንሳ ሁንድ ተጃጅልቶተሳ ተአን ጎዼረ፤ አከ እን ምዻኒፊ ዳዺ ወይኒ ቀባቱፍስ እሰ ኤብሴረ። ኤጋ ያ እልመኮ አን ማል ሲፍ ጎቹን ደንደአ?”<verse eid="GEN 27:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 27:38"/>ኤሳዉስ አባሳቲን፣ “ያ አባኮ፣ አት ኤቡመ ቶኮ ቆፈ ቀብዳ? ያ አባኮ፣ አነስ ኤብስ!” ጄዼ። ኤሳዉስ ሰገሌ ኦል ፉዸቴ ቦኤ።<verse eid="GEN 27:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 27:39"/>አባንሳ ይስሃቅስ አከነ ጄዼ ዴብሴፍ፤</para>
  <para style="q1" vid="GEN 27:39">“እዶን ጅሬኘኬቲ</para>
  <para style="q2" vid="GEN 27:39">ለፈ ገበታራ ንፈጋተ፤</para>
  <para style="q2" vid="GEN 27:39">ፍጤንሰ ሰሚ ጉባራስ ንፈጋተ።<verse eid="GEN 27:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="GEN 27:40"/>አት ጎራዴዻን ጅራተ፤</para>
  <para style="q2" vid="GEN 27:40">ኦቦሌሰኬስ ንተጃጅልተ።</para>
  <para style="q1" vid="GEN 27:40">ዬሮ እሳን ሞርምቱት ገሩ</para>
  <para style="q2" vid="GEN 27:40">ዋንጆሳ ጨብስቴ</para>
  <para style="q2" vid="GEN 27:40">ሞርመኬራ ቡፍተ።”<verse eid="GEN 27:40"/></para>
  <para style="s1">ያቆብ ገረ ላባት በቀቴ</para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 27:41"/>ኤሳዉ ሰበቢ አባንሳ ያቆብን ኤብሴፍ ያቆብት ሃሎ ቀበቴ። እንስ ገራሳት፣ “ዬሮን እት አባኮቲፍ ቦአን ዽኣቴረ፤ አንስ ዬሮ ሰነ ኦቦሌሰኮ ያቆብን ነንአጄሰ” ጄዼ ያዴ።<verse eid="GEN 27:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 27:42"/>ዮሙ ወን ኤሳዉ እልምሼ ሀንገፍትች ጄዼ እሼት ህመሜት ርብቃን ያቆብ እልመሼ ቁጥሱ ዋምስፍቴ አከነ ጄቴን፤ “ኩኖ፣ ኦቦሌስኬ ኤሳዉ ስ አጄሴ ገራሳ ቀበኔፈቹ በርባደ። <verse eid="GEN 27:42"/><verse number="43" style="v" sid="GEN 27:43"/>ከናፉ ያ እልመኮ ነ ዸገእ፤ ከኢቲ ገረ ኦቦሌሰኮ ላባ ከን ካራን ኬሰ ጅራቱ ሰናት በቀዹ። <verse eid="GEN 27:43"/><verse number="44" style="v" sid="GEN 27:44"/>ሀመ ኣሪን ኦቦሌሰኬቲ ቀበናኡት ዬሮ ገባባፍ እሰ ብረ ቱር። <verse eid="GEN 27:44"/><verse number="45" style="v" sid="GEN 27:45"/>ዮሙ ኣሪን ኦቦሌሰኬቲ ቀበናኤ እንስ ዋን አት እሰ ጎቴ ሰነ እራንፈቱት አን ዻምሰ ስት ኤርጌ አቺ ስን ፍችሲሰ። አን ማሊፈን ጉያ ቶኮት እስን ለቹ ዸበ?”<verse eid="GEN 27:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 27:46"/>ርብቃንስ ይስሃቂን አከነ ጄቴ፤ “አን ሰበቢ ዱበርቶተ ሄቶታ ከኔኒፍ ጅራቹ ጅቤረ። ዮ ያቆብ ዱበርቶተ ብየ ከና ጄቹንስ ዱበርቶተ ሄቶታ ከኔን ኬሳ ኒቲ ፉዼ፣ ጅሬኝኮ ማል አናፍ ጎዸሬ!”<verse eid="GEN 27:46"/></para>
  <chapter eid="GEN 27"/>
  <chapter number="28" style="c" sid="GEN 28"/>
  <para style="p">
    <verse number="1" style="v" sid="GEN 28:1"/>ይስሃቅስ ያቆብን ዋሜ ኤብሴ አከነ ጄዼ እሰ አጀጄ፦ “እንተለን ወረ ከነኣን ኬሳ ህንፉዽን። <verse eid="GEN 28:1"/><verse number="2" style="v" sid="GEN 28:2"/>አሙመ ከኢቲ ገረ ካበ ዽአ ጳዳን አራም መነ አባ ሃዸኬቲ መነ ቤቱኤል ዸቅ። አቺስ እንተለን ኦቦሌሰ ሃዸኬቲ እንተለን ላባ ኬሳ ቶኮ ፉዽ። <verse eid="GEN 28:2"/><verse number="3" style="v" sid="GEN 28:3"/>ዋቅን ዋን ሁንደ ደንደኡ ሱን ስ ሃኤብሱ፤ ሰኚ ሲፍ ሃኬኑ፤ አከ አት ሰበ በልኣ ታቱፍስ ስ ሃባይእሱ። <verse eid="GEN 28:3"/><verse number="4" style="v" sid="GEN 28:4"/>አት ብየ አመ አለጉማዻን ኬሰ ጅራቱ፣ ብየ ዋቅን ዻለ ጎዼ አብረሃሚፍ ኬኔ ሰነ አከ ዻልቱፍ እን ኤበ አብረሃሚፍ ኬኔ ሲፊ ሰኚኬቲፍ ሃኬኑ።” <verse eid="GEN 28:4"/><verse number="5" style="v" sid="GEN 28:5"/>ይስሃቅስ አከስት ያቆብን ኤርጌ፤ ያቆብስ ገረ ካበ ዽአ ጳዳን አራም ገረ ላባ እልመ ቤቱኤል ነምቸ አራም ሰና ዸቄ፤ ላባን ኩንሞ ኦቦሌሰ ርብቃ፣ ሃዸ ያቆቢፊ ኤሳዉ።<verse eid="GEN 28:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 28:6"/>ኤሳዉ አከ ይስሃቅ ያቆብን ኤብሴ አከ እን አቺ ኒቲ ፉዹፍ ገረ ካበ ዽአ ጳዳን አራምት እሰ ኤርጌፊ አከ እሰ ኤብሴትስ “እንተለን ወረ ከነኣን ህንፉዽን” ጄዼ እሰ አጀጄ ዮሙ ቤኬት፤ <verse eid="GEN 28:6"/><verse number="7" style="v" sid="GEN 28:7"/>ያቆብ አባፊ ሃዸሳቲፍ አጀጀሜ ገረ ካበ ዽአ ጳዳን አራም ዸቄ። <verse eid="GEN 28:7"/><verse number="8" style="v" sid="GEN 28:8"/>ኤሳዉስ እንተለን ወረ ከነኣን ፉለ አባሳ ይስሃቅ ዱረት ሀመም ጅበሞ አከ ተአን ሁበቴ። <verse eid="GEN 28:8"/><verse number="9" style="v" sid="GEN 28:9"/>ከናፉ ኤሳው ገረ እሽማኤል እልመ አብረሃም ዸቄ ማሀላት እንተለ እሽማኤል ኦቦሌቲ ነባዮት ኒቶተ ዱር ቀቡረት ደበሌ ፉዼ።<verse eid="GEN 28:9"/></para>
  <para style="s1">አብጁ ያቆብ ቤትኤልት አብጆቴ</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 28:10"/>ያቆብ ቤርሼባ በኤ ካራን ዸቄ። <verse eid="GEN 28:10"/><verse number="11" style="v" sid="GEN 28:11"/>እንስ እዶ ቶኮ ገኤ አዱን ዺናን አች ቡሌ፤ ዸጎተ አች ቱረን ኬሳስ ቶኮ ፉዸቴ መታ ጀለ ካአቴ ረፉፍ ጪሴ። <verse eid="GEN 28:11"/><verse number="12" style="v" sid="GEN 28:12"/>እንስ አችት አብጁ አብጆቴ፤ ኩኖ ያበኖ ለፈ ዻበቴ ፊጤንሳሞ ሰሚ ገኡ ቶኮ አርጌ፤ ኩኖ ኤርገሞትን ዋቀዮ ያበኖ ሰነረ ኦል በኣፊ ገድ ቡኣ ቱረን። <verse eid="GEN 28:12"/><verse number="13" style="v" sid="GEN 28:13"/>ኩኖ <char style="nd">ዋቀዮ</char> ያበኖ ሰነ ገረራ ዻበቴ አከነ ጄዼ፤ “አን <char style="nd">ዋቀዮ</char> ዋቀ አባኬ አብረሃሚፊ ዋቀ ይስሃቅ፤ አን ለፈ አትረ ጪፍቱ ከነ ሲፊ ሰኚኬቲፍ ነንኬነ። <verse eid="GEN 28:13"/><verse number="14" style="v" sid="GEN 28:14"/>ሰኚንኬ አኩመ ብዮ ለፋ ንባይአተ፤ አትስ ገረ ዽኣት፣ ገረ በኣት፣ ገረ ካባቲፊ ክባት ንበበልአተ። ኡመትን ለፈራ ሁንድኑ ከራኬቲፊ ከራ ሰኚኬቲቲን ንኤብፈመ። <verse eid="GEN 28:14"/><verse number="15" style="v" sid="GEN 28:15"/>ኩኖ አን ስ ወጅነን ጅረ፤ ለፈ አት ዸቅጡ ሁንደትስ ስን ኤገ፤ ገረ ብየ ከናትስ ዴብሴ ስን ፍደ። አን ሀመን ዋነን ዋዳ ሲፍ ገሌ ሰነ ሲፍ ጉቱት ስ ህንዺሱ።”<verse eid="GEN 28:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 28:16"/>ያቆብስ ዮሙ ህርባ ከኤት፣ “ዹጉማን <char style="nd">ዋቀዮ</char> እዶ ከነ ጅረ፤ አን ዋን ከነ ህንሁበትኔ” ጄዼ። <verse eid="GEN 28:16"/><verse number="17" style="v" sid="GEN 28:17"/>እንስ ሶዳቴ፣ “እዶን ኩን አከም ነመ ሶዳችሰ! ኩን መነ ዋቃት መሌ ዋን ብራ ምት፤ ኩን ከረ ሰሚት” ጄዼ።<verse eid="GEN 28:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 28:18"/>ያቆብስ ጉያ እት ኣኑ ገነመ ኦቦሮ ከኤ ዸጋ መታ ጀለ ካአቴ ቱሬ ሰነ ፉዼ አከ ኡቱባት ኦል ዻቤ፤ ፊጤሳረትስ ዘይቲ ዸንገላሴ። <verse eid="GEN 28:18"/><verse number="19" style="v" sid="GEN 28:19"/>እንስ መቃ እዶ ሰና ቤትኤል ጄዼ ሞጋሴ፤ ዱራን ገሩ መጋላን ሱን ሉዝ ጄዸመ ቱሬ።<verse eid="GEN 28:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 28:20"/>ኤርገሲስ ያቆብ አከነ ጄዼ ወሬጌ፤ “ዮ ዋቅን ነ ወጅን ተኤ፣ ዮ እን ከራ አን ዴሙ ከነረት ነ ኤጌ፣ ዮ ዋን አን ኛዹፊ ዋን አን ኡፈዹ ና ኬኔ፣ <verse eid="GEN 28:20"/><verse number="21" style="v" sid="GEN 28:21"/>ዮ አን ነጋን መነ አባኮት ዴብኤ፣ <char style="nd">ዋቀዮ</char> ዋቀኮ ንተአ፤ <verse eid="GEN 28:21"/><verse number="22" style="v" sid="GEN 28:22"/>ዸጋን አን ኡቱባ ጎዼ ኦል ዻቤ ኩንስ መነ ዋቃ ተአ፤ ዋን አት ና ኬንቱ ኬሳስ ኩዸን ኬሳ ቶኮ ሲፍን ኬነ።”<verse eid="GEN 28:22"/></para>
  <chapter eid="GEN 28"/>
  <chapter number="29" style="c" sid="GEN 29"/>
  <para style="s1">ያቆብ ጳዳን አራም ገኤ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 29:1"/>ያቆብስ ከራሳ እት ፉፌ ገረ ወረ ብየ በኣ ዹፌ። <verse eid="GEN 29:1"/><verse number="2" style="v" sid="GEN 29:2"/>እንስ እላሌ ኩኖ ቦለ ብሻኒ ቶኮ ድሬረት አርጌ፤ ኩኖ ከር ሆሎታ ሰዲ ሰበቢ አቺ ብሻን ዹገኒፍ ቦለ ብሻኒ ሰነ ብረ ጭጪሳ ቱረን። ዸጋን አፋን ቦለ ብሻኒ ሰናረ ቱሬ ጉዳ ቱሬ። <verse eid="GEN 29:2"/><verse number="3" style="v" sid="GEN 29:3"/>ዬሮ ከር ሆሎታ ሁንድ አችት ወልት ቀበመንት ትክሶትን አፋን ቦለ ብሻኒራ ዸጋ ገንገልቸኒ ሆሎተ ብሻን ኦባሱ ቱረን። ኤርገሲሞ ዸጋ ሰነ እዶሳት ዴብሰኒ አፋን ቦለ ብሻኒረ ካኡ ቱረን።<verse eid="GEN 29:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 29:4"/>ያቆብስ ትክሶተ ሰናን፣ “ያ ኦቦሎተኮ፣ እስን ወረ ኤሳት?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="GEN 29:4">እሳንስ፣ “ኑ ወረ ካራኒት” ጄዸኒ ዴብሰን።<verse eid="GEN 29:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 29:5"/>እንስ፣ “ላባ እልመ ናሆር ቤክቱ?” ጄዼን።</para>
  <para style="p" vid="GEN 29:5">ጀርስ፣ “ኤዬ፣ ቤክነ” ጄዸኒ ዴብሰን።<verse eid="GEN 29:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 29:6"/>ያቆብሞ፣ “እን ፈዩማ?” ጄዼ እሳን ጋፈቴ።</para>
  <para style="p" vid="GEN 29:6">እሳንስ፣ “ኤዬ፣ ፈዩመ፤ ኩኖ እንተልሳ ራሄልዩ ሆሎተ ፍዴ ዹፋ ጅርት” ጄዸኒን።<verse eid="GEN 29:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 29:7"/>እንስ፣ “ኩኖ፣ አመ ለፍት ጉያዸ፤ ዬሮ እት ሆሎትን ወልት ቀበመን ምት። ሆሎተ ብሻን ኦባሳቲ ዸቃ ዼችሳ” ጄዼን።<verse eid="GEN 29:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 29:8"/>እሳንስ፣ “ኑ ሀመ ከር ሆሎታ ሁንድኑ ወልት ቀበመኒ ዸጋን ሱን አፋን ቦለ ብሻኒራ ገንገልፈሙት ህንደንዴኙ፤ ኤርገሲ ሆሎተ ብሻን ኦባፍነ” ጄዸኒ ዴብሰን።<verse eid="GEN 29:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 29:9"/>ኡቱመ እን ጀረ ወጅን ሃሰኣ ጅሩ፣ ራሄል ዋን ትክሴ ቱርቴፍ ሆሎተ አባሼ ኦፍቴ ዹፍቴ። <verse eid="GEN 29:9"/><verse number="10" style="v" sid="GEN 29:10"/>ያቆብ ዮሙ ራሄል፣ እንተለ ኦቦሌሰ ሃዸሳ እንተለ ላባቲፊ ሆሎተ ላባ አርጌት ዸቄ ዸጋ አፋን ቦለ ብሻኒራ ገንገልቼ ሆሎተ ኤሱመሳ ብሻን ኦባሴ። <verse eid="GEN 29:10"/><verse number="11" style="v" sid="GEN 29:11"/>ያቆብስ ራሄሊን ዹንገቴ፤ ሰገሌ ኦል ፉዸቴስ ቦኤ። <verse eid="GEN 29:11"/><verse number="12" style="v" sid="GEN 29:12"/>እን ፍረ አባሼ አከ ተኤፊ እልመ ርብቃ አከ ተኤ ራሄልት ህሜ፤ እሼንስ ፊጋ ዸቅጤ አባሼት ህምቴ።<verse eid="GEN 29:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 29:13"/>ላባን አኩመ ዋኤ እልመ ኦቦሌቲሳ ዋኤ ያቆብ ዸገኤን እሰ ስመቹፍ አሪፈቴ በኤ። እንስ ኤርገ ሀመቴ ዹንገቴ ቦዴ መነሳት ፉዸቴ ገሌ፤ ያቆብስ ዋን ከነ ሁንደ ላባት ህሜ። <verse eid="GEN 29:13"/><verse number="14" style="v" sid="GEN 29:14"/>ላባንሞ፣ “አት ዹጉማን ፎንኮቲፊ ዺገኮት” ጄዼን።</para>
  <para style="s1" vid="GEN 29:14">ያቆብ ልያፊ ራሄልን ፉዼ</para>
  <para style="p" vid="GEN 29:14">ያቆብ ኤርገ ጅአ ቶኮ ጉቱ ላባ ወጅን ቱሬ ቦዴ፣ <verse eid="GEN 29:14"/><verse number="15" style="v" sid="GEN 29:15"/>ላባን አከነ እሳን ጄዼ፤ “አት ሰበቢ ፍረኮ ታቴፍ ቶለ ና ሆጄቹ ቀብዳ? ምንዳንኬ አከ ሀመም ተኡ ቀቡ ነት ህም።”<verse eid="GEN 29:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 29:16"/>ላባን እንተለን ለመ ቀበ ቱሬ፤ መቃንሼ ሀንገፋ ልያ ቱሬ፤ መቃንሼ ቁጥሱሞ ራሄል ጄዸመ ቱሬ። <verse eid="GEN 29:16"/><verse number="17" style="v" sid="GEN 29:17"/>እጅ ልያ ደዸባ ቱሬ፤ ራሄል ገሩ በሬዱፊ ስምቦ ቀቤቲ ቱርቴ። <verse eid="GEN 29:17"/><verse number="18" style="v" sid="GEN 29:18"/>ያቆብ ራሄልን ጃለቴ፣ “አን ዋኤ እንተለኬ እሼ ቁጥሱ፣ ራሄሊፍ ጄዼ ወጋ ቶርበ ስን ተጃጅለ” ጄዼን።<verse eid="GEN 29:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 29:19"/>ላባንሞ፣ “ነመ ብራፍ እሼ ኬኑረ ሲፍ ኬኑ ና ወየ፤ አሱመ ነ ብረ ቱር” ጄዼ። <verse eid="GEN 29:19"/><verse number="20" style="v" sid="GEN 29:20"/>ከናፉ ያቆብ ራሄልን አርገቹፍ ጄዼ ወጋ ቶርበ ተጃጅሌ። እን ዋን እሼ ጃለቴፍ ወጎትን ኩኔን ጉዮተ ሙራሰ እሰት ፈካተን።<verse eid="GEN 29:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 29:21"/>ያቆብስ ላባዻን፣ “ዋን ዬሮንኮ ጡሙረሜፍ አከ አን እሼ ብረ ገኡፍ ኒቲኮ ና ኬን” ጄዼ።<verse eid="GEN 29:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 29:22"/>ከናፉ ላባን ነሞተ እዶ ሰነ ጅረን ሁንደ ወልት ቀቤ ጭዸ ቆጴሴ። <verse eid="GEN 29:22"/><verse number="23" style="v" sid="GEN 29:23"/>ገሩ ዬሮ ለፍት ገልገላኤት እንተለሳ ልያ ፍዴ ያቆቢፍ ኬኔ፤ ያቆብስ እሼ ብረ ገኤ። <verse eid="GEN 29:23"/><verse number="24" style="v" sid="GEN 29:24"/>ላባንስ አከ እሼን ሆጄቱሼ ታቱፍ ገርብቲሳ ዝልፋ፣ እንተለሳ ልያዻፍ ኬኔ።<verse eid="GEN 29:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 29:25"/>ዮሙ ለፍት በርኤት ኩኖ ልያ ተኡንሼ ቤከሜ! ያቆብስ ላባዻን፣ “ወን አት ነ ጎቴ ኩን ማል? አን ራሄሊፍ ጄዼ ስ ህንተጃጅሌ? ዮስ አት ማሊፍ ነ ጎዎምስቴሬ?” ጄዼ።<verse eid="GEN 29:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 29:26"/>ላባንስ አከነ ጄዼ ዴብሴ፤ “ብየኬኘ ኬሰት እንተለ ሀንገፈ ዱረ እንተለ ቁጥሱ ሄሩምሲሱን ዱዻኬኘ ምት። <verse eid="GEN 29:26"/><verse number="27" style="v" sid="GEN 29:27"/>ቶርበን ምስሩማ እንተለ ከና ራወዹ፤ ኤርገሲ ዮ አት ወጋ ብራ ቶርበ ናፍ ሆጄቴ ቁጥሱሼስ ሲፍ ኬንነ።”<verse eid="GEN 29:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 29:28"/>ያቆብስ አከሱመ ጎዼ። ቶርበን ሰነስ ልያ ወጅን ደበርሴ፤ ኤርገሲስ ላባን እንተለሳ ራሄልን እሰት ሄሩምሲሴ። <verse eid="GEN 29:28"/><verse number="29" style="v" sid="GEN 29:29"/>ላባን አከ እሼን ሆጄቱሼ ታቱፍ ጦምቦሬሳ ብልሃ፣ እንተለሳ ራሄሊፍ ኬኔ። <verse eid="GEN 29:29"/><verse number="30" style="v" sid="GEN 29:30"/>ያቆብስ ራሄል ብረ ገኤ፤ እንስ ልያ ጫላት ራሄልን ጃለቴ። ወጎተ ብራ ቶርበስ ላባፍ ሆጄቴ።<verse eid="GEN 29:30"/></para>
  <para style="s1">እጆሌ ያቆብ</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 29:31"/>
    <char style="nd">ዋቀዮ</char> ዮሙ አከ ልያን ህንጃለተምን አርጌት ገደሜሰሼ በኔፍ፤ ራሄል ገሩ ዸብዱ ቱርቴ። <verse eid="GEN 29:31"/><verse number="32" style="v" sid="GEN 29:32"/>ልያን ኡልፎፍቴ እልመ ዴሴ። እሼንስ ዋን፣ “<char style="nd">ዋቀዮ</char> ዽጵነኮ አርጌራቲ ዹጉማን ስአች ዽርስኮ ነ ጃለተ” ጄቴፍ መቃሳ ሩቤን ጄቴ ሞጋፍቴ።<verse eid="GEN 29:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 29:33"/>እሼን አመስ ዮሙ ኡልፎፍቴ እልመ ዴሴት፣ “<char style="nd">ዋቀዮ</char> ሰበቢ አከ አን ህንጃለተምን ዸገኤፍ እልመ ከነስ ና ኬኔ” ጄቴ መቃሳ ስምኦን ጄቴ ሞጋፍቴ።<verse eid="GEN 29:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 29:34"/>አመስ ኡልፎፍቴ እልመ ዴሴ፤ እሼንስ፣ “ሰበቢ አን እልማን ሰዲ እሳፍ ደኤፍ አመ ዽርስኮ ነት መጠነ” ጄቴ፤ ከናፉ ሙጫን ሱን ሌዊ ጄዸሜ ሞጋፈሜ።<verse eid="GEN 29:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 29:35"/>አመስ እሼን ኡልፎፍቴ እልመ ዴሴ፤ እሼንስ፣ “አመ <char style="nd">ዋቀዮ</char> ነንገለቴፈዸ” ጄቴ። ከናፉ መቃሳ ይሁዳ ጄቴ ሞጋፍቴ። ኤርገሲስ ደኡ ንዺፍቴ።<verse eid="GEN 29:35"/></para>
  <chapter eid="GEN 29"/>
  <chapter number="30" style="c" sid="GEN 30"/>
  <para style="p">
    <verse number="1" style="v" sid="GEN 30:1"/>ራሄል ዮሙ አከ ያቆቢፍ እጆሌ ቶኮዩ ህንደእን አርግቴት ኦቦሌቲሼት ህናፍቴ። ያቆቢንስ፣ “እጆሌ ና ኬን፣ ዮ ከና አቺ ነንዱአ!” ጄቴ።<verse eid="GEN 30:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 30:2"/>ያቆብስ እሼት ኣሬ፣ “አነቱ እዶ ዋቀ እሰ እጆሌ ስ ዾወቴ ሰና ጅረ ሞ?” ጄዼን።<verse eid="GEN 30:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 30:3"/>እሼንስ፣ “ጦምቦሬንኮ ብልሃን ኩኖት፤ አከ እሼን ቆደኮ እጆሌ ናፍ ዴሴ አንስ ከራሼቲን እጆሌ አርገዹፍ ዸቂ እሼ ብረ ገእ” ጄቴ።<verse eid="GEN 30:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 30:4"/>እሼንስ ጦምቦሬሼ ብልሃ አከ ኒቲሳ ታቱፍ ኬንቴፍ። ያቆብስ እሼ ብረ ገኤ፤ <verse eid="GEN 30:4"/><verse number="5" style="v" sid="GEN 30:5"/>እሼንስ ኡልፎፍቴ እልመ እሳፍ ዴሴ። <verse eid="GEN 30:5"/><verse number="6" style="v" sid="GEN 30:6"/>ከነረት ራሄል፣ “ዋቅን ና ሙርቴሴረ፤ ከዸትናኮስ ዸገኤ እልመ ና ኬኔረ” ጄቴ። ከናፉ መቃሳ ዳን ጄቴ ሞጋፍቴ።<verse eid="GEN 30:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 30:7"/>ጦምቦሬን ራሄል ብልሃን አመስ ኡልፎፍቴ ያቆቢፍ እልመ ለመፋ ዴሴ። <verse eid="GEN 30:7"/><verse number="8" style="v" sid="GEN 30:8"/>ራሄልስ፣ “አን ኦቦሌቲኮ ወልኣንሶ ጉዳ ቀቤ ሞአዼረ” ጄቴ። መቃሳ ንፍታሌም ጄቴ ሞጋፍቴ።<verse eid="GEN 30:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 30:9"/>ልያን አከ እጆሌ ደኡ ዺፍቴ ሁበቴ፤ ጦምቦሬሼ ዝልፋ ፉቴ አከ ኒቲሳ ታቱፍ ያቆቢፍ ኬንቴ። <verse eid="GEN 30:9"/><verse number="10" style="v" sid="GEN 30:10"/>ጦምቦሬን ልያ ዝልፋንስ ያቆቢፍ እልመ ዴሴ። <verse eid="GEN 30:10"/><verse number="11" style="v" sid="GEN 30:11"/>ልያንሞ፣ “ማል ምልኪን አከና!” ጄቴ መቃሳ ጋድ ጄቴ ሞጋፍቴ።<verse eid="GEN 30:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 30:12"/>ጦምቦሬን ልያ ዝልፋን ያቆቢፍ እልመ ለመፋ ዴሴ። <verse eid="GEN 30:12"/><verse number="13" style="v" sid="GEN 30:13"/>ኤርገሲስ ልያን፣ “አን አከመን ገመዴ! ዱበርቶትንስ፣ ‘ኤብፈምቱ’ ናን ጄዹ” ጄቴ። ከናፉ መቃሳ ኣሼር ጄቴ ሞጋፍቴ።<verse eid="GEN 30:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 30:14"/>ዬሮ ሃማ ቀመዲት ሩቤን ገረ በኬት በኤ እጀ ሁዻ አርገቴ ሃዸሳ ልያዻፍ ፍዴ። ራሄልስ ልያዻን፣ “ማሎ እጀ ሁዻ እልመኬቲራ ዋ ና ኬን” ጄቴ።<verse eid="GEN 30:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 30:15"/>ልያንሞ፣ “ዽርሰኮ ነራ ፉዸቹንኬ ስት ጥናቴ? ሁዻ እልመኮስ ንፉዸታ?” ጄቴን።</para>
  <para style="p" vid="GEN 30:15">ራሄልስ፣ “ቆደ ሁዻ እልመኬቲ እን ኤደነ ስ ወጅን ሃቡሉ” ጄቴን።<verse eid="GEN 30:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 30:16"/>ጋፈ ሰነ ገልገለ ዬሮ ያቆብ ለፈ ቆቲሳቲ ገሌት ልያን እሰ ስመቹፍ ገድ ባቴ፣ “ዋን አን ሁዻ እልመኮቲን ስ ክሬፈዼፍ አት ሀርአ ነ ወጅን ቡሉ ቀብደ” ጄቴን። ያቆብስ ሀልከን ሰነ እሼ ወጅን ቡሌ።<verse eid="GEN 30:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 30:17"/>ዋቅንስ ልያ ዸገኤ፤ እሼንስ ኡልፎፍቴ ያቆቢፍ እልመ ሸነፋ ዴሴ። <verse eid="GEN 30:17"/><verse number="18" style="v" sid="GEN 30:18"/>ልያንስ፣ “ዋን አን ጦምቦሬኮ ዽርሰኮቲፍ ኬኔፍ ዋቅን ገቲኮ ና ባሴረ” ጄቴ። ከናፉ ይሳኮር ጄቴ እሰ ሞጋፍቴ።<verse eid="GEN 30:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 30:19"/>ልያን አመስ ኡልፎፍቴ ያቆቢፍ እልመ ጀአፋ ዴሴ። <verse eid="GEN 30:19"/><verse number="20" style="v" sid="GEN 30:20"/>ልያንስ፣ “ዋቅን ኬና ጋሪ ናፍ ኬኔረ፤ ሰበቢ አን እልማን ጀአ እሳፍ ደኤፍ ዽርስኮ ስአች ኡልፍነ ና ኬነ” ጄቴ። ከናፉ መቃሳ ዜቡሎን ጄቴ ሞጋፍቴ።<verse eid="GEN 30:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 30:21"/>ኤርገሲስ እንተለ ቶኮ ዴሴ ዲና ጄቴ ሞጋፍቴ።<verse eid="GEN 30:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 30:22"/>ዋቅንስ ራሄልን ያደቴ፤ ከዸትናሼስ ዸገኤ ገደሜሰሼ በኔፍ። <verse eid="GEN 30:22"/><verse number="23" style="v" sid="GEN 30:23"/>እሼንስ ኡልፎፍቴ እልመ ዴሴ፣ “ዋቅን ቃኒኮ ነራ ፉዼረ” ጄቴ። <verse eid="GEN 30:23"/><verse number="24" style="v" sid="GEN 30:24"/>እሼንስ መቃሳ ዮሴፍ ጄቴ ሞጋፍቴ፣ “<char style="nd">ዋቀዮ</char> እልመ ብራ ናፍ ሃደበሉ” ጄቴ።<verse eid="GEN 30:24"/></para>
  <para style="s1">ያቆብ ሆሎተ ሆሬ</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 30:25"/>ኤርገ ራሄል ዮሴፍን ዴሴ ቦዴ ያቆብ ላባዻን አከነ ጄዼ፤ “አከ አን ብየ ዸሎታኮት ዴብኡፍ፣ ገድ ነ ዺስ። <verse eid="GEN 30:25"/><verse number="26" style="v" sid="GEN 30:26"/>አን ነንዴማቲ ኒቶተኮፊ እጆሌኮ ወረ አን እሳኒፍ ጄዼ ሲፍ ተጃጅሌ ና ኬን። አከ አን ሆጂ ባይኤ ሲፍ ሆጄዼ አትዩ ቤክተ።”<verse eid="GEN 30:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 30:27"/>ላባን ገሩ አከነ ጄዼን፤ “ማሎ ዮ አን ፉለኬ ዱረት ፉዸተመ አርገዼ ጅራዼ አሱመ ቱር፤ አን አከ <char style="nd">ዋቀዮ</char> ሰበቢኬቲን ነ ኤብሴ ሙልአታን ቤኬራቲ።” <verse eid="GEN 30:27"/><verse number="28" style="v" sid="GEN 30:28"/>እት ፉፌስ፣ “ሜ ምንዳ አን ሲፍ ከፈሉ ቀቡ ነት ህም፤ አን ሲፍን ከፈላቲ” ጄዼ።<verse eid="GEN 30:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 30:29"/>ያቆብስ አከነ ጄዼን፤ “አከ አን ሀመም ሲፍ ሆጄዼ፣ ሆሪንኬስ ሀመም አከ ሀርከኮት ባይአቴ አቱ ንቤክተ። <verse eid="GEN 30:29"/><verse number="30" style="v" sid="GEN 30:30"/>ወን ጥናን አት ኡቱ አን ህንዹፍን ዱረ ቀብዱ ሱን አመ አከ መሌ ሲፍ ባይአቴረ፤ ለፈ አን ቱሬ ከምትዩ <char style="nd">ዋቀዮ</char> ስ ኤብሴረ። ገሩ ዬሮን አን እት ማቲኮቲፍ ያዱ ዮምሬ?”<verse eid="GEN 30:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 30:31"/>እንስ፣ “ወን አን ሲፍ ኬኑ ማልሬ?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="GEN 30:31">ያቆብሞ አከነ ጄዼ ዴብሴ፤ “ሆማ ናፍ ህንኬንን፤ ገሩ ዮ አት ዋን ከነ ናፍ ጎቴ አን እቱመ ፉፌ ቡሻዬኬ ነንትክሰ፤ ነንኤገስ፤ <verse eid="GEN 30:31"/><verse number="32" style="v" sid="GEN 30:32"/>አን ሀርአ ቡሻዬኬ ሁንደ ኬሰ በኤ ሆሎተ ጮጮሬፊ ቡቡሬ ሁንደ፣ ሆላ መጋላፊ ሬኦተ ጮጮሬ ዮካን ቡቡሬ ሁንደ አዳን ነንባሰ፤ እሳን ኩኔን ምንዳኮ ተኡ። <verse eid="GEN 30:32"/><verse number="33" style="v" sid="GEN 30:33"/>ዬሮ አት ምንዳ ና ኬንቴ ሰነ ቶአቹ ዹፍቱት፣ አመነሙማንኮ ዹጋ ና በአ። ሆሎታፊ ሬኦተኮ ኬሰት ሬኤን ጮጮሬ ዮካን ቡቡሬ ህንተእን ከምዩ፣ ሆላ ኬሳሞ ከን ጉራቸ ህንተእን ከምዩ ዮ አርገሜ አከ ዋን ሀተሜት ሃእላለሙ።”<verse eid="GEN 30:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 30:34"/>ላባንስ፣ “ቶሌ፣ አኩመ አት ጄቴ ሃተኡ” ጄዼ። <verse eid="GEN 30:34"/><verse number="35" style="v" sid="GEN 30:35"/>ጉዩመ ሰነ ላባን ኮርቤዪ ሬኤ ሀሉ ቀጣሙሮ ቀበኒፊ ቡቡሬ ሁንደ፣ ጎሮሚ ሬኤ ጮጮሬፊ ቡቡሬ ከኔን አዳዲ ቀበን ሁንደ፣ አከሱመስ ሆሎተ ጉጉራቸ ሁንደ ፉዼ እልማንሳት ኬኔ። <verse eid="GEN 30:35"/><verse number="36" style="v" sid="GEN 30:36"/>እንስ ኦፊሳቲፊ ያቆብ ግዱት ለፈ አዴምሰ ጉያ ሰዲ ሀምብሴ፤ ያቆብሞ ቡሻዬ ላባ ከኔን ሀፈን ትክሱ እት ፉፌ።<verse eid="GEN 30:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 30:37"/>ያቆብስ ደሜ አለልቱ፣ ከን ሎዚቲፊ ሀዼሰ ጂዻሳ ደርቤ ደርቤ ናኔሴ ቆለሳራ ቁንጭሱዻን ዸግነ ሙክቻ እሰ ኬሳ አዲ ሰነ ሙልእሴ። <verse eid="GEN 30:37"/><verse number="38" style="v" sid="GEN 30:38"/>ያቆብስ ዬሮ ቡሻዬን ሱን ብሻን ዹጉፍ ዹፈንት ደሜ ቆልራ ቁንጭፈሜ ሰነ ፉለሳኒ ዱረ ብድሩ ብሻን እት ኦባሰን ኬሰ ካኤ። ቡሻዬን ዬሮ ሱን ብሻን ዹጉ ዹፈንት ጎጆመአኒ <verse eid="GEN 30:38"/><verse number="39" style="v" sid="GEN 30:39"/>ኡሌ ሰነ ዱረት ወል ሆቦብሱ ቱረን፤ እሳንስ እልሞሌ ሀሉ ቀጣሙሮ ቀበን፣ ጮጮሬፊ ቡቡሬ ዸለን። <verse eid="GEN 30:39"/><verse number="40" style="v" sid="GEN 30:40"/>ያቆብስ እልሞሌ ቡሻዬ ኮጳት ባሴ፤ ቡሻዬ ላባ ከኔን ሀፈን ገሩ ወረ ሀሉ ቀጣሙሮ ቀበኒፊ ጉራቸ ዱረ ዻቤ። አከስት ሆሎተሳ አዳን ባሴ መሌ ቡሻዬ ላባት ህንመክኔ። <verse eid="GEN 30:40"/><verse number="41" style="v" sid="GEN 30:41"/>ዬሮ ዸልቱወን ጀጀቦን ጎጆመአን ከምዩ፣ ያቆብ አከ እሳን ኡሌ ሰነ ብረት ወል ሆቦብሰኒፍ ጄዼ ኡሌ ሰነ ፉለሳኒ ዱረ ብድሩ ኬሰ ካኣ ቱሬ፤ <verse eid="GEN 30:41"/><verse number="42" style="v" sid="GEN 30:42"/>ዸልቱወን ደዸቦ ዱረ ገሩ ኡሌ ሰነ ህንኬኜ። ከናፉ ወር ደዸቦን ከን ላባ፣ ወር ጀጀቦንሞ ከን ያቆብ ተአን። <verse eid="GEN 30:42"/><verse number="43" style="v" sid="GEN 30:43"/>ነምች ኩን ሃለ ከናን አከ መሌ ሶሮሜ፤ እንስ ቡሻዬ ባይኤ፣ ገርቦተ ዱበርቶታቲፊ ዺሮታ፣ ጋለወኒፊ ሀሮተ ቀበ ቱሬ።<verse eid="GEN 30:43"/></para>
  <chapter eid="GEN 30"/>
  <chapter number="31" style="c" sid="GEN 31"/>
  <para style="s1">ያቆብ ላባ ጀላ በቀቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 31:1"/>ያቆብስ አከ እልማን ላባ፣ “ያቆብ ዋን አባንኬኘ ቀቡ ሁንደ ፉዸቴረ፤ ቀቤኘ ከነ ሁንደስ ዋኑመ ከን አባኬኛ ቱሬራ አርገቴ” ጄዸን ዸገኤ። <verse eid="GEN 31:1"/><verse number="2" style="v" sid="GEN 31:2"/>ያቆብስ ፉለ ላባ እላሌ፤ ኩኖ ፉልሳ አከ ዱራት እሰት ህንቶሌ።<verse eid="GEN 31:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 31:3"/>
    <char style="nd">ዋቀዮስ</char> ያቆቢን፣ “ብየ አባኬቲፊ ፍረኬት ዴብእ፤ አንስ ስ ወጅን ነንተአ” ጄዼ።<verse eid="GEN 31:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 31:4"/>ከናፉ ያቆብ አከ እሳን በኬት ለፈ ቡሻዬንሳ ጅረንት ገድ በአኒፍ ገረ ራሄሊፊ ልያት ኤርጋ ኤርጌ። <verse eid="GEN 31:4"/><verse number="5" style="v" sid="GEN 31:5"/>እንስ አከነ እሳኒን ጄዼ፤ “አን አከ አባንኬሰን አከ ከናን ዱራ ሰነ ፉለ ነት ህንቶሌ ሁበዼረ፤ ገሩ ዋቅን አባኮቲ ነ ወጅን ጅረ። <verse eid="GEN 31:5"/><verse number="6" style="v" sid="GEN 31:6"/>አከ አን ሁምነኮ ጉቱዻን አባኬሰኒፍ ሆጄዼ እስኑ ቤክቱ፤ <verse eid="GEN 31:6"/><verse number="7" style="v" sid="GEN 31:7"/>ተኡስ አባንኬሰን ምንዳኮ ዬሮ ኩዸን ጌደሩዻን ነ ጎዎምሴ። ዋቅን ገሩ አከ እን ነ ሚዹ ህንኤየምኔፍ። <verse eid="GEN 31:7"/><verse number="8" style="v" sid="GEN 31:8"/>ዬሮ እን፣ ‘ቡሻዬን ጮጮሬን ምንዳኬ ተኡ’ ጄዼት፣ ቡሻዬን ሁንድ እልማን ጮጮሬ ዸለን፤ ዬሮ እን፣ ‘ወር ሀሉ ቀጣሙሮ ቀበን ምንዳኬ ተኡ’ ጄዼትሞ ቡሻዬን ሁንድ እልማን ቀጣሙሮ ቀበን ዸለን። <verse eid="GEN 31:8"/><verse number="9" style="v" sid="GEN 31:9"/>ዋቅን ከራ ከናን ሆሪ አባኬሰኒ ፉዼ ና ኬኔ።<verse eid="GEN 31:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 31:10"/>“አንስ ጋፍ ቶኮ ወቅቲ ጋነ ቡሻዬት አብጁ ኬሰ ኦል እላሌ ኩኖ ኮርቤዪን ሬኦተት ሆቦብሰን አከ ሀሉ ቀጣሙሮ ቀበን፣ ጮጮሬፊ ቡቡሬ ተአን ነንአርጌ። <verse eid="GEN 31:10"/><verse number="11" style="v" sid="GEN 31:11"/>ኤርገማን ዋቀዮስ አብጁ ኬሰ፣ ‘ያቆብ’ ናን ጄዼ። አን፣ ‘ኩኖ አሰን ጅረ’ ጄዼን ዴብሴ። <verse eid="GEN 31:11"/><verse number="12" style="v" sid="GEN 31:12"/>እንሞ አከነ ናን ጄዼ፤ ‘አከ ኮርቤዪን ሬኦታ ከኔን ቡሻዬት ሆቦብሰን ሁንድኑ ሀሉ ቀጣሙሮ ቀበን፣ ጮጮሬፊ ቡቡሬ ተአን ኦል ጄዺ እላል። አን ዋን ላባን ስት ሆጄቴ ሁንደ አርጌራቲ። <verse eid="GEN 31:12"/><verse number="13" style="v" sid="GEN 31:13"/>አን ዋቀ ቤትኤል ለፈ አት እት ኡቱባ ድብዴ ወሬገ ናፍ ወሬግዴ ሰናት። አመ ከኢቲ ብየ ከነ ኬሳ በኢቲ ገረ ብየ ፍረኬቲት ዴብእ።’ ”<verse eid="GEN 31:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 31:14"/>ከነረት ራሄሊፊ ልያን አከነ ጄዸኒ ዴብሰን፤ “ቆድን ዮካን ዻል መነ አባኬኛት ኑ ሀፌ ጅራ? <verse eid="GEN 31:14"/><verse number="15" style="v" sid="GEN 31:15"/>እን አኩመ ኦርማት ኑ እላለ ምቲ? እን ኑ ጉርጉረቴራቲ ማለቀ ሰበቢኬኛፍ ኬነሜ ኛቴ ፍጤረ። <verse eid="GEN 31:15"/><verse number="16" style="v" sid="GEN 31:16"/>ቀቤኝ ዋቅን አባ ኬኘራ ፉዼ ሁንድ ከንኬኛፊ ከን እጆሌኬኛት። ኤጋ ዋን ዋቅን ስት ህሜ ሁንደ ጎዽ።”<verse eid="GEN 31:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 31:17"/>ያቆብስ እጆሌሳቲፊ ኒቶተሳ ጋለወንረ ካአቴ፤ <verse eid="GEN 31:17"/><verse number="18" style="v" sid="GEN 31:18"/>ሆሪፊ ቀቤኘ ካበ ዽአ ጳዳን አራሚት ሆረቴ ሁንደ ኦፍ ዱረ ኦፌ ገረ ብየ ከነኣን አባሳ ይስሃቅ ብረ ዸቁፍ ከኤ።<verse eid="GEN 31:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 31:19"/>ላባን ሆሎተሳራ ርፌንሰ ሙርሙሩ ዸቄ፤ ራሄልሞ ዋቆተ አባሼ ሀቴ። <verse eid="GEN 31:19"/><verse number="20" style="v" sid="GEN 31:20"/>ያቆብስ አከ እሰ ዺሴ በቀቹ ያዴ እሰ ዾክሱዻን ላባን ነምቸ አራም ሰነ ጎዎምሴ። <verse eid="GEN 31:20"/><verse number="21" style="v" sid="GEN 31:21"/>እንስ ዋን ቀቡ ሁንደ ፉዸቴ በቀቴ፤ ለገ ኤፍራጢስ ጬኤ ብየ ጋረ ግልኣድት ቀጄሌ።<verse eid="GEN 31:21"/></para>
  <para style="s1">ላባን ያቆብ ዱካ ቡኤ</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 31:22"/>አከ ያቆብ በቀቴ ጉያ ሰደፋት ላባት ህመሜ። <verse eid="GEN 31:22"/><verse number="23" style="v" sid="GEN 31:23"/>ላባንስ ፍሮተሳ ፉዸቴ ጉያ ቶርበ ያቆብ ዱካ ቡኤ ብየ ጋረ ግልኣድት እሰ ቀቀቤ። <verse eid="GEN 31:23"/><verse number="24" style="v" sid="GEN 31:24"/>ዋቅንስ ሀልከን አብጁዻን ገረ ላባን ነምቸ ብየ አራም ሰና ዹፌ፣ “አት ዋን ጋሪስ ተኡ ሀማ ቶኮዩ ያቆብት አከ ህንዱበትኔ ኦፍ ኤገዹ” እሳን ጄዼ።<verse eid="GEN 31:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 31:25"/>ያቆብ ዬሮ ላባን እሰ ቀቀቤት፣ ብየ ጋራ ግልኣድ ኬሰ ዱንካነሳ ዻበቴ ቱሬ፤ ላባፊ ፍሮትንሳስ አች ቁበተን። <verse eid="GEN 31:25"/><verse number="26" style="v" sid="GEN 31:26"/>ላባንስ ያቆቢን አከነ ጄዼ፤ “አት ነ ጎዎምስቴ እንተለንኮ አከ ቦጅአምቶተ ወራናት ፉዸቴ ዴሙንኬ ማል ጎቹኬት? <verse eid="GEN 31:26"/><verse number="27" style="v" sid="GEN 31:27"/>አት ማሊፍ ዾክሳን በቀቴ? ማሊፍስ ነ ጎዎምስቴ? አከ አን ገመቹፊ ፋርፈናዻን፣ ድቤፊ በገናዻን ስ ጌጌሱፍ ማሊፍ ነት ህሙ ድዴ? <verse eid="GEN 31:27"/><verse number="28" style="v" sid="GEN 31:28"/>አት አከ አን እጆሌ እጆሌኮቲቲፊ እንተለንኮ ዹንገዼ ነጋት ጄዹ ናፍ ህንኤየምኔ። አት ሆጂ ጎዉማ ሆጄቴ። <verse eid="GEN 31:28"/><verse number="29" style="v" sid="GEN 31:29"/>አን እስን ሚዹፍ ሁምነ ቀበ፤ ገሩ ኤደ ዋቅን አባኬሰኒ፣ ‘አት ዋን ጋሪስ ተኡ ሀማ ቶኮሌ ያቆብት አከ ህንዱበትኔ ኦፍ ኤገዹ’ ናን ጄዼ። <verse eid="GEN 31:29"/><verse number="30" style="v" sid="GEN 31:30"/>አት ሰበቢ መነ አባኬቲት ዴብኡ አከ መሌ ሀውቴፍ ዴምቴርተ፤ ገሩ ማሊፍ ዋቆተኮ ሀቴ?”<verse eid="GEN 31:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 31:31"/>ያቆብስ አከነ ጄዼ ላባፍ ዴቢ ኬኔ፤ “አት እንተለንኬ ሁምናን ነራ ፉዸተ ጄዼ ዋነን ሶዳዼፍ ነንዴሜ። <verse eid="GEN 31:31"/><verse number="32" style="v" sid="GEN 31:32"/>ነምን አት ዋቆተኬ እሰ ብረት አርገቱ ጅራቹ ህንቀቡ። አከ ወን ከንኬ ተኤ ነ ብረ ጅሩፊ አከ ህንጅሬ አቱ ፉለ ፍሮተኬኛ ዱረት ሰከተእ፤ ዮ ጅራቴሞ ፉዸዹ።” ያቆብ ራሄል ዋቆተ ሰነ ሀቱሼ ያቆብ ህንቤኩ ቱሬ።<verse eid="GEN 31:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 31:33"/>ላባንስ ዱንካነ ያቆብ፣ ዱንካነ ልያቲፊ ዱንካነ ጦምቦሬወን ለማኒ ሴኔ ሆማ ዸቤ። ኤርገ ዱንካነ ልያቲ በኤ ቦዴስ ዱንካነ ራሄል ሴኔ። <verse eid="GEN 31:33"/><verse number="34" style="v" sid="GEN 31:34"/>ራሄልሞ ዋቆተ መነ ኬሳ ሀቴ ሰነ ኮራ ጋለወንሼ ጀለ ኬሴ እረ ታኣ ቱርቴ። ላባንስ ዋን ዱንካንቸ ኬሰ ጅሩ ሁንደ ኬሰ በርባዴ፤ ገሩ ሆማ ህንአርገኔ።<verse eid="GEN 31:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 31:35"/>ራሄልስ አባሼቲን፣ “ያ ጎፍታኮ፣ ሰበቢ አን ከኤ ፉለኬ ዱረ ዻበቹ ደዸቤፍ ህንኣርን፤ አን ጡሪን ኦፍራ ቀባ” ጄቴ። እንስ ንሰከተኤ መሌ ዋቆተ ሰነ ህንአርገኔ።<verse eid="GEN 31:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 31:36"/>ያቆብስ ላባት ኣሬ እሰት ዼከሜ። እንስ አከነ ጄዼ ጋፈቴ፤ “የክኮ ማል? ወን አት አከነ ነ አደምስቱፍ አን ጩቡ ማሊ ሆጄዼት? <verse eid="GEN 31:36"/><verse number="37" style="v" sid="GEN 31:37"/>አት ምአኮ ሁንደ ሰከታቴርተ፤ ኤጋ ምአ መነኬቲ ኬሳ ማል አርገቴ? ዮ ጅራቴ ፍሮተኬቲፊ ፍሮተኮ ዱረት ዽኤሲቲ እሳን ኑ ለማን ግዱት ሙርቲ ሃኬነን።<verse eid="GEN 31:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 31:38"/>“አን ወጎተ ድግደመን ከነ ስ ወጅን ጅራዼረ። ሆሎትኒፊ ሬኦትንኬ ቶኮዩ ህንገተትኔ፤ አን ቡሻዬኬ ኬሳስ ኮርቤዪ ህንኛትኔ። <verse eid="GEN 31:38"/><verse number="39" style="v" sid="GEN 31:39"/>አን ሆሪ ብኔንስ ጨብሴ ገረኬት ህንፍድኔ፤ ሆሪ በዴስ አነቱ ከፈላ ቱሬ። ዋን ጉያስ ተኡ ሀልከን ሀተሜ ሁንዳፍ አት ነ ከፈልቺፈተ ቱርቴ። <verse eid="GEN 31:39"/><verse number="40" style="v" sid="GEN 31:40"/>ሃል አን ኬሰ ጅራዼ ከነ ቱሬ፤ ጉያ ሆአ፣ ሀልከንሞ ዻሞቸቱ ነ ወጠለ ቱሬ፤ ህርብንስ እጀኮራ በዴ። <verse eid="GEN 31:40"/><verse number="41" style="v" sid="GEN 31:41"/>አከሲን አን ወጎተ ድግደመን ከነ መነኬ ቱሬ። አን ወጋ ኩዸ አፉር እንተለንኬ ለማኒፍ ጄዼ፣ ወጋ ጀአሞ ቡሻዬኬቲፍ ጄዼ ሲፍ ሆጄዼረ፤ አትሞ ዬሮ ኩዸን ምንዳኮ ጌደርቴ። <verse eid="GEN 31:41"/><verse number="42" style="v" sid="GEN 31:42"/>ዋቅን አባኮ፣ ዋቅን አብረሃም፣ ሶዳን ይስሃቅ ኡቱ ነ ወጅን ጅራቹ ባቴ አት ስላ ሀርከ ዱዋ ነ ባስተ ቱርቴ። ዋቅን ገሩ ረክነኮፊ ደዸቢኮ አርጌ ኤደ ስት ዼከሜ።”<verse eid="GEN 31:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="GEN 31:43"/>ላባን አከነ ጄዼ ያቆቢፍ ዴብሴ፤ “ዱበርቶትን ኩኔን እንተለንኮት፤ እጆሌን ኩኔንስ እጆሉመኮት፤ ቡሻዬን ኩኔንስ ቡሻዬኮት። ወን አት አርግቱ ሁንድ ከኑመኮት። ዮስ አን ዋኤ እንተለንኮ ከኔኒቲፊ ዋኤ እጆሌ እሳን ደአኒ ሀርአ ማል ጎቹን ደንደአ? <verse eid="GEN 31:43"/><verse number="44" style="v" sid="GEN 31:44"/>ኮቱ ሜ አኒፊ አት አመ ወሊ ከከትና፤ ከኩን ኩንስ አናፊ ስ ግዱት ረጋ ሃተኡ።”<verse eid="GEN 31:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="GEN 31:45"/>ያቆብስ ዸጋ ቶኮ ፉዼ አከ ኡቱባት ዻቤ። <verse eid="GEN 31:45"/><verse number="46" style="v" sid="GEN 31:46"/>እንስ ፍሮተሳቲን፣ “ዸጋ ወልት ቀባ” ጄዼ። እሳንስ ዸጋ ወልት ቀበኒ ቱለን፤ ጀርስ ቱላ ሰነ ብረት ኛተ ኛተን። <verse eid="GEN 31:46"/><verse number="47" style="v" sid="GEN 31:47"/>ላባን ቱላ ሰናን “ይጋርሰሃዱታ” ጄዼ ሞጋሴ፤ ያቆብሞ “ግልኣድ” ጄዼን።<verse eid="GEN 31:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="GEN 31:48"/>ላባንስ፣ “ቱላን ኩን አናፊ ስ ግዱት ረጋዸ” ጄዼ። ጋለኣድ ጄዸሙንሳ ከኑማፍ። <verse eid="GEN 31:48"/><verse number="49" style="v" sid="GEN 31:49"/>አከሱመስ ሚስጳ ጄዸሜ፤ ላባን አከነ ጄዼ ቱሬቲ፤ “ዬሮ ኑ ገርገር ባኑት <char style="nd">ዋቀዮ</char> ሲፊ አነ ግዱት ኤግዱ ሃተኡ። <verse eid="GEN 31:49"/><verse number="50" style="v" sid="GEN 31:50"/>ዮ አት እንተለንኮ ረክፍቴ ዮካን ዮ አት እንተለንኮረት ኒቶተ ብራ ፉቴ፣ ዮ ነምን ቶኮዩ ኑ ብረ ህንጅሬ ኩኖ ዋቅን አናፊ ስእ ግዱት ረጋዸ።”<verse eid="GEN 31:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="GEN 31:51"/>ላባን አመስ ያቆቢን አከነ ጄዼ፤ “ቱላ ከናፊ ኡቱባ አን ሲፊ አነ ግዱ ዻቤ ከነ እላል። <verse eid="GEN 31:51"/><verse number="52" style="v" sid="GEN 31:52"/>አከ አን ስ ሚዹፍ ጄዼ ቱላ ከነ ደርቤ ገረኬት ህንጬኔ፣ አከ አትስ ነ ሚዹፍ ጄቴ ቱላ ከናፊ ኡቱባ ከነ ደበርቴ ገረኮት ህንጬኔ ቱላን ኩን ረጋዸ፤ ኡቱባን ኩንስ ረጋዸ። <verse eid="GEN 31:52"/><verse number="53" style="v" sid="GEN 31:53"/>ዋቅን አብረሃም፣ ዋቅን ናሆር፣ ዋቅን አቦቲሳኒ ኑ ግዱት ሙርቲ ሃኬኑ።”</para>
  <para style="p" vid="GEN 31:53">ያቆብስ አከስት መቃ ሶዳ አባሳ ይስሃቂን ከከቴ። <verse eid="GEN 31:53"/><verse number="54" style="v" sid="GEN 31:54"/>እንስ ብየ ጋራ ሰነት ኣርሳ ዽኤሴ ፍሮተሳ ኛተት ዋሜ። እሳንስ ኤርገ ኛተኒ ቦዴ አቹመ ቡለን።<verse eid="GEN 31:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="GEN 31:55"/>ላባንስ ጉያ እት ኣኑ ገነመ በሪዻን ከኤ እጆሌ እጆሌሳቲፊ እንተለንሳ ዹንገቴ እሳን ኤብሴ። ኤርገሲስ አቺ ከኤ ገረ እዶሳት ዴብኤ።<verse eid="GEN 31:55"/></para>
  <chapter eid="GEN 31"/>
  <chapter number="32" style="c" sid="GEN 32"/>
  <para style="s1">ያቆብ ኤሳዉን ወል አርጉፍ ቆጳኤ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 32:1"/>ያቆብስ ከራሳ እት ፉፌ፤ ኤርገሞትን ዋቀዮስ እሰት ዹፈን። <verse eid="GEN 32:1"/><verse number="2" style="v" sid="GEN 32:2"/>እንስ ዮሙ እሳን አርጌት፣ “ኩን ቡፈተ ዋቃት” ጄዼ፤ እዶ ሰነስ መሀነዪም ጄዼ ሞጋሴ።<verse eid="GEN 32:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 32:3"/>ያቆብስ ገረ ኦቦሌሰሳ ኤሳዉ ከን ብየ ኤዶም ለፈ ሴኢር ጄዸሙ ኬሰ ጅራቱት ኤርገሞተ ኦፍ ዱረ ኤርጌ። <verse eid="GEN 32:3"/><verse number="4" style="v" sid="GEN 32:4"/>እንስ አከነ ጄዼ እሳን አጀጄ፦ “እስን ጎፍታኮ ኤሳዉን አከነ ጄዻ፦ ‘ገርብችኬ ያቆብ አከነ ጄዸ፤ አን ላባ ብረ ጅራዼ ሀመ አማትስ እሱመ ብረን ቱሬ። <verse eid="GEN 32:4"/><verse number="5" style="v" sid="GEN 32:5"/>አን ሎኒፊ ሀሮተ፣ ሆሎታፊ ሬኦተ፣ ሆጄቶተ ዺራቲፊ ዱበርቶተስ ቀበ። አመስ አን ፉለኬ ዱረት ሱራ አከን አርገዹፍ ኤርጋ ከነ ጎፍታኮት ነንኤርገ።’ ”<verse eid="GEN 32:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 32:6"/>ኤርገሞትን ሱንስ ገረ ያቆብት ዴብአኒ፣ “ኑ ኦቦሌሰኬ ኤሳዉ ብረ ዸቅኔረ፤ እንስ ስ ስመቹፍ ዹፋ ጅረ፤ ነሞትን ዽበ አፉር እሰ ወጅን ጅሩ” ጄዸኒን።<verse eid="GEN 32:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 32:7"/>ያቆብስ አከ መሌ ሶዳቴ ዽጰቴ፤ ነሞተ እሰ ወጅን ቱረንስ ገሬ ለመት ቆዴ፤ ቡሻዬ፣ ሎወኒፊ ጋለወንሌ አከሱመ ገሬ ለመት ቆዴ። <verse eid="GEN 32:7"/><verse number="8" style="v" sid="GEN 32:8"/>እንስ፣ “ዮ ኤሳዉ ዹፌ ገሬ ቶኮ ዸኤ፣ ገሬን ካን ጀላ በአ” ጄዼ ያዴ።<verse eid="GEN 32:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 32:9"/>ያቆብ አከነ ጄዼ ከዸቴ፤ “ያ ዋቀ አባኮ አብረሃም፣ ዋቀ አባኮ ይስሃቅ፣ ያ <char style="nd">ዋቀዮ</char>፣ እሰ ‘አት ገረ ብየኬቲፊ ገረ ፍሮተኬቲት ዴብእ፣ አን ዋን ጋሪ ሲፍን ጎዻ’ ናን ጄቴ ሱን፣ <verse eid="GEN 32:9"/><verse number="10" style="v" sid="GEN 32:10"/>አን ጋሩማፊ አመነሙማ አት አነ ገርብቸኬ አርግሲፍቴ ከነ ሁንዳፍ ህንመሉ። አን ዬሮ ዮርዳኖስ ከነ ጬኤት ኡሌኮ ቆፈ ቀበን ቱሬ፤ አመ ገሩ ገሬ ለመ ተኤን ጅረ። <verse eid="GEN 32:10"/><verse number="11" style="v" sid="GEN 32:11"/>አን አከ አት ሀርከ ኦቦሌሰኮ ኤሳዉ ጀላ ነ ባስቱ ስን ከዸዸ። አን፣ ‘እን ዹፌ ነ አጄሰ፤ ሃዾተስ እጆሌሳኒ ወጅን ንአጄሰ’ ጄዼ ሶዳዼራቲ። <verse eid="GEN 32:11"/><verse number="12" style="v" sid="GEN 32:12"/>አት ገሩ፣ ‘አን ዹጉማን ዋን ጋሪ ሲፍን ጎዸ፤ ሰኚኬስ አከ ጭረቸ ገላና ከን ለካአሙ ህንደንዴኜ ሰና ነንጎዸ’ ጄቴርተ።”<verse eid="GEN 32:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 32:13"/>እን ሀልከን ሰነ አቹመ ቡሌ፤ ዋን ኦፍ ብራ ቀቡ ኬሳስ ኬና ኦቦሌሰሳ ኤሳዉፍ ኬኑ ፍለቴ፤ <verse eid="GEN 32:13"/><verse number="14" style="v" sid="GEN 32:14"/>እሳንስ ሬኦተ ዸልቱ ዽበ ለመ፣ ኮርቤዪ ሬኤ ድግደመ፣ ሆሎተ ዸልቱ ዽበ ለመ፣ ኮርቤዪ ሆላ ድግደመ፣ <verse eid="GEN 32:14"/><verse number="15" style="v" sid="GEN 32:15"/>ጋለወን ዸላ ሶዶመ እልማንሳኒ ወጅን፣ ሳወን አፉርተመ፣ ጅቦተ ሎኒ ኩዸን፣ ሀሮተ ዸልቱ ድግደመ፣ ወደለ ሀሮታ ኩዸን ቱረን። <verse eid="GEN 32:15"/><verse number="16" style="v" sid="GEN 32:16"/>እንስ ከረ ከራን አዳን ባሴ ተጃጅልቶተሳት ኬኔ፣ “ነ ዱረ ደርባ ዴማ፤ ከረወን ሆሪ ግዱትስ ለፈ ሀምብሳ” ጄዼ ተጃጅልቶተሳ አጀጄ።<verse eid="GEN 32:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 32:17"/>ነምቸ ፉለ ዱራን ጅሩ ሰናንስ አከነ ጄዼ፦ “ዮ ኤሳው ኦቦሌስኮ ስት ዹፌ፣ ‘አት ከን ኤኙት? ኤሰ ዸቅጠ? ሆሪን ፉለኬ ዱረ ጅሩ ኩን ከን ኤኙት?’ ጄዼ ስ ጋፈቴ፣ <verse eid="GEN 32:17"/><verse number="18" style="v" sid="GEN 32:18"/>አት፣ ‘ከን ገርብቸኬ ያቆብ። እሳንስ ኬና ጎፍታኮ ኤሳዉፍ ኤርገመኒዸ፤ ኩኖ፣ ያቆብስ ኑ ዱባን ዹፋ ጅረ’ ጄቹ ቀብደ።”<verse eid="GEN 32:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 32:19"/>ነምቸ ለመፋ፣ ሰደፋፊ ወረ ከረወን ሰነ ፋነ ዴመን ሁንደስ አከነ ጄዼ አጀጄ፤ “እስንስ ዮ ኤሳዉን አርግተን ዋኑመ ከነ እሰት ህማ። <verse eid="GEN 32:19"/><verse number="20" style="v" sid="GEN 32:20"/>አከሱመስ፣ ‘ኩኖ ገርብችኬ ያቆብ ኑ ዱባን ዹፋ ጅረ’ ጄዻ።” እን፣ “አን ኬና ኦፍ ዱረ ኤርጌፍ ከናን እሰ ነንአራርፈዸ፤ ኤርገሲሞ አን ዮሙን እሰ አርጉት ተሪ እን ነ ስመተ ተአ” ጄዼ ያዴ ቱሬቲ። <verse eid="GEN 32:20"/><verse number="21" style="v" sid="GEN 32:21"/>ኬናን ያቆቢስ እሰ ዱረ ደርቤ፤ ያቆብ ገሩ ሀልከን ሰነ ቁበተ ሰነ ኬሰ ቡሌ።<verse eid="GEN 32:21"/></para>
  <para style="s1">ያቆብ ዋቀ ወልኣንሶ ቀቤ</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 32:22"/>ሀልከኑመ ሰነ ያቆብ ከኤ ኒቶተሳ ለማን፣ ጦምቦሬወንሳ ለማኒፊ እልማንሳ ኩዸ ቶኮ ፉዸቴ መልካ ያቦቅ ጬኤ። <verse eid="GEN 32:22"/><verse number="23" style="v" sid="GEN 32:23"/>እንስ ኤርገ ለገ እሳን ጬስሴ ቦዴ ቀቤኘሳ ሁንደ ኤርጌ። <verse eid="GEN 32:23"/><verse number="24" style="v" sid="GEN 32:24"/>ያቆብሞ ኮጳሳ ሀፌ፤ ነምች ቶኮስ ሀመ ለፍት በሪቱት ወልኣንሶ እሰ ቀቤ። <verse eid="GEN 32:24"/><verse number="25" style="v" sid="GEN 32:25"/>ነምችስ ዮሙ አከ ያቆብን ሞአቹ ህንደንዴኜ አርጌት፣ ቡሳ ሉቄቱ ያቆብ ቱቄ፤ ዬሮ እን ነምቸ ወጅን ወልኣንሶ ቀቤትስ ሉቄቱን ያቆብ ንአዶዴ። <verse eid="GEN 32:25"/><verse number="26" style="v" sid="GEN 32:26"/>ነምችስ፣ “ዋን በርኡ ገኤፍ ገድ ነ ዺስ” ጄዼ።</para>
  <para style="p" vid="GEN 32:26">ያቆብ ገሩ፣ “ዮ አት ነ ኤብፍቴ መሌ አን ገድ ስ ህንዺሱ” ጄዼ ዴብሴ።<verse eid="GEN 32:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 32:27"/>ነምችስ፣ “መቃንኬ ኤኙ” ጄዼ እሰ ጋፈቴ።</para>
  <para style="p" vid="GEN 32:27">እንሞ፣ “ያቆብ” ጄዼ ዴብሴ።<verse eid="GEN 32:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 32:28"/>ነምችስ፣ “አት ሰበቢ ዋቃፊ ነሞተ ወጅን ወልኣንሶ ቀብዴ ሞአቴፍ ስአች እስራኤል ጄዸምተ መሌ ያቆብ ህንጄዸምቱ” ጄዼ።<verse eid="GEN 32:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 32:29"/>ያቆብስ፣ “ማሎ መቃኬ ነት ህም” ጄዼን።</para>
  <para style="p" vid="GEN 32:29">እን ገሩ፣ “አት ማሊፍ መቃኮ ጋፈተ?” ጄዼን። ኤርገሲስ እን አቹመት እሰ ኤብሴ።<verse eid="GEN 32:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 32:30"/>ያቆብስ፣ “አን እፋን እፈት ዋቀ አርጌራቲ፤ ሉቡንኮ ገሩ ኦልፈምቴርት” ጄዼ እዶ ሰነ ጴኒኤል ጄዼ ሞጋሴ።<verse eid="GEN 32:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 32:31"/>አኩመ እን ጴኑኤልን ደርቤን አዱን እሰት ባቴ፤ እንስ ሰበቢ ሉቄቱሳቲፍ ኦኮላ ቱሬ። <verse eid="GEN 32:31"/><verse number="32" style="v" sid="GEN 32:32"/>ከናፉ እስራኤሎትን ሀመ ሀርኣት ርቡ ተፋ ህንኛተን፤ እን ቡሳ ሉቄቱ ያቆብ ከን ተፋን ወል ቀበቱ ቱቄ ቱሬቲ።<verse eid="GEN 32:32"/></para>
  <chapter eid="GEN 32"/>
  <chapter number="33" style="c" sid="GEN 33"/>
  <para style="s1">ያቆቢፊ ኤሳዉ ወል አርገን</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 33:1"/>ያቆብስ ኦል ጄዼ እላሌ ኩኖ ኤሳዉ ነሞተ ዽበ አፉር ወጅን ኡቱ ዹፋ ጅሩ አርጌ፤ እንስ ልያት፣ ራሄሊፊ ጦምቦሬወን ለማንት እጆሌ ገርገር ህሬ። <verse eid="GEN 33:1"/><verse number="2" style="v" sid="GEN 33:2"/>ጦምቦሬወኒፊ እጆሌሳኒ ዱረ ኣንሴ፤ ልያፊ እጆሌሼ እት ኣንሴ፣ ራሄሊፊ ዮሴፍንሞ ዱግደ ዱበ ቡሴ። <verse eid="GEN 33:2"/><verse number="3" style="v" sid="GEN 33:3"/>ኦፊሳቲሞ እሳን ዱረ ደርቤ ሀመ ኦቦሌሰሳ ብረ ገኡት ዬሮ ቶርበ ለፈት ገድ ጄዼ ሀርከ ፉዼ።<verse eid="GEN 33:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 33:4"/>ኤሳዉ ገሩ ያቆብን ስመቹፍ እት ፊጌ እሰ ሀመቴ፤ ሞርመ እሳትስ መርሜ እሰ ዹንገቴ። እሳን ለቸኑ ወልት ቦአን። <verse eid="GEN 33:4"/><verse number="5" style="v" sid="GEN 33:5"/>ኤሳዉስ ኦል ጄዼ እላሌ ዱበርቶታፊ እጆሌ አርጌ፣ “ወር ስ ወጅን ጅረን ኩኔን ኤኙ?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="GEN 33:5">ያቆብስ ዴብሴ፣ “እሳን እጆሌ ዋቅን አርጁማዻን አነ ገርብቸኬቲፍ ኬኔዸ” ጄዼ።<verse eid="GEN 33:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 33:6"/>ጦምቦሬወኒፊ እጆሌንሳኒ ዽኣተኒ ገድ ጄዸኒ ሀርከ ፉዸን። <verse eid="GEN 33:6"/><verse number="7" style="v" sid="GEN 33:7"/>እት ኣንሰኒስ ልያፊ እጆሌንሼ ዹፈኒ ገድ ጄዸኒ ሀርከ ፉዸን። ዹመረትሞ ዮሴፊፊ ራሄል ዹፈኒ ገድ ጄዸን ሀርከ ፉዸን።<verse eid="GEN 33:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 33:8"/>ኤሳዉ፣ “ቡሻዬፊ ሎን አን አርጉ ኩን ሁንድ ማል?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="GEN 33:8">ያቆብስ፣ “አን ፉለኬ ፉለ ጎፍታኮ ዱረት ፉዸተመ አርገቹፍ ጄዼት” ጄዼ።<verse eid="GEN 33:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 33:9"/>ኤሳዉሞ፣ “ያ ኦቦሌሰኮ አን ዋን ነ ገኡ ቀበ። አት ዋን ቀብዱ ኦፉመኬቲ ሀምብፈዹ” ጄዼን።<verse eid="GEN 33:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 33:10"/>ያቆብስ አከነ ጄዼ፤ “ማሎ አከስ ምት! ዮ አን ፉለኬ ዱረት ፉዸተመ አርገዼ ጅራዼ፣ ኬና ከነ ነ ሀርካ ፉዸዹ። ኤጋ አመ አት ፉለ ቶላዻን ነ ስመቴርተ፤ ፉለኬ አርጉን አናፍ አኩመ ፉለ ዋቃ አርጉቲ። <verse eid="GEN 33:10"/><verse number="11" style="v" sid="GEN 33:11"/>ሰበቢ ዋቅን ነት አርጆሜ አንስ ዋን ነ በርባችሱ ሁንደ ቀቡፍ ማሎ ኬና አን ሲፍ ፍዴ ከነ ፉዸዹ።” ኤሳዉስ ዋን ያቆብ ጭምሴ እሰ ከዸቴፍ ኬና ሰነ ንፉዸቴ።<verse eid="GEN 33:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 33:12"/>ኤሳዉስ፣ “ኮቱ ከራኬኘ እት ፉፍኔ ሃዴምኑ፤ አን ስ ዱረ ነንቡኣ” ጄዼ።<verse eid="GEN 33:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 33:13"/>ያቆብ ገሩ አከነ እሳን ጄዼ፤ “አከ እጆሌን ደዸቦ ተአኒፊ አከ አንስ ሆሎታፊ ሳወን ሆስሰኒፍ ኩኑንሰ ጎቹ ቀቡ አት ጎፍታንኮ ንቤክተ። ሆሪን ኩኔን ዮ ጉዩመ ቶኮን ጀርጀርሱዻን ኦፈመን ሁንድሳኒ ንዹሙ። <verse eid="GEN 33:13"/><verse number="14" style="v" sid="GEN 33:14"/>ጎፍታንኮ ገርብቸሳ ዱረ ደርቤ ሃዴሙ፤ አንሞ ሀመን ሴኢርት ጎፍታኮ ቀቀቡት አኩመ ሁምነ ቡሻዬ ፉለኮ ዱረ ጅሩቲፊ አኩመ ሁምነ እጆሌት ሱተ ጄዼ ነንዴመ።”<verse eid="GEN 33:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 33:15"/>ኤሳዉስ፣ “ዮስ ነሞተኮ ኬሳ ሙራሰ ስ ብረት ነንዺሰ” ጄዼ።</para>
  <para style="p" vid="GEN 33:15">ያቆብሞ፣ “ኩን ማሊፍ በርባችሳ? ፉለ ጎፍታኮ ዱረት ፉዸተመ አርገቹን ቆፍት ነ ገአ” ጄዼ።<verse eid="GEN 33:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 33:16"/>ኤሳዉስ ጉዩመ ሰነ ከራሳረ ሴኢርት ዴብኤ። <verse eid="GEN 33:16"/><verse number="17" style="v" sid="GEN 33:17"/>ያቆብ ገሩ ሱኮት ዸቄ አችት ኦፊሳቲፍ መነ እጃረቴ፤ ሆሪሳቲፍሞ ዳሲ እጃሬ። ከናፉ እዶን ሱን ሱኮት ጄዸሜ።<verse eid="GEN 33:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 33:18"/>ያቆብ ኤርገ ካበ ዽአ ጳዳን አራሚቲ ዴብኤ ቦዴ ነጋን መጋላ ሼኬም እሼ ብየ ከነኣን ኬሳ ሰነ ገኤ ፉለ መጋለቲ ዱረ ቁበቴ። <verse eid="GEN 33:18"/><verse number="19" style="v" sid="GEN 33:19"/>እንስ ለፈ ዱንካነሳ እረ ዻበቴ ሰነ እልማን ሀሞርራ ሜቲ ዽባን ብተቴ፤ ሀሞርሞ አባ ሼኬም። <verse eid="GEN 33:19"/><verse number="20" style="v" sid="GEN 33:20"/>ያቆብስ አችት እዶ ኣርሳ እጃሬ ኤል ኤሎሄ እስራኤል ጄዼ ሞጋሴ።<verse eid="GEN 33:20"/></para>
  <chapter eid="GEN 33"/>
  <chapter number="34" style="c" sid="GEN 34"/>
  <para style="s1">ዲናን ጉዴደምቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 34:1"/>ዲናን እንተል ልያን ያቆቢፍ ዴሴ ሱን ዱበርቶተ ብየቲ እላሉዻፍ ገድ ባቴ። <verse eid="GEN 34:1"/><verse number="2" style="v" sid="GEN 34:2"/>ሼኬም እልም ሀሞር ነምቸ ጎሰ ሂዊ ከን ቡልቻ ብየ ሰና ቱሬ እሼ አርጌ፤ እንስ ቀቤ ሁምናን እሼ ጉዴዴ። <verse eid="GEN 34:2"/><verse number="3" style="v" sid="GEN 34:3"/>ቀልቢንሳስ ዲና እንተለ ያቆቢን ፉዸተሜ፤ እንስ እሼ ጃለቴ አፋን ቶላ እት ዱበቴ። <verse eid="GEN 34:3"/><verse number="4" style="v" sid="GEN 34:4"/>ሼኬምስ አባሳ ሀሞሪን፣ “እንተለ ከነ ነ ፉስስ” ጄዼ።<verse eid="GEN 34:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 34:5"/>ያቆብ ዮሙ እንተልሳ ዲናን አከ ጉዴደምቴ ዸገኤት፣ እልማንሳ ድሬረ ሆሪ ትክሱ ቱረን፤ ከናፉ ያቆብ ሀመ እሳን ገለንት ንጨልእሴ።<verse eid="GEN 34:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 34:6"/>ሀሞር አባን ሼኬምስ ያቆብ ወጅን ዱበቹ ዸቄ። <verse eid="GEN 34:6"/><verse number="7" style="v" sid="GEN 34:7"/>እልማን ያቆብስ አኩመ ዋን ኡመሜ ሰነ ዸገአኒን ድሬዻ ዹፈን። እሳንስ ሰበቢ ሼኬም እንተለ ያቆብ ወጅን ጪሱዻን እስራኤል ኬሰት ዋን ጅብሲሳ ሆጄቴፍ ንገደን፤ አከ መሌስ ኣረን።<verse eid="GEN 34:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 34:8"/>ሀሞር ገሩ አከነ እሳኒን ጄዼ፤ “ቀልቢን እልመኮ ሼኬም እንተለኬሰንረ ቡኤረ። ማሎ እሰት እሼ ሄሩምሲሳ። <verse eid="GEN 34:8"/><verse number="9" style="v" sid="GEN 34:9"/>ፉዻፊ ሄሩማን ወልት ፍሮምና፤ እንተለንኬሰን ኑ ኬና፤ እንተለንኬኘስ ፉዻ። <verse eid="GEN 34:9"/><verse number="10" style="v" sid="GEN 34:10"/>ኑ ወጅን ጅራዻ፤ ብየቲን ፉለኬሰን ዱረ ጅርት፤ ኬሰ ጅራዻቲ እት ደልደላ፤ ቀቤኘስ እት ሆረዻ።”<verse eid="GEN 34:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 34:11"/>ሼኬምስ አባ ዲናቲፊ ኦቦሎተሼቲን አከነ ጄዼ፤ “አን ፉለኬሰን ዱረት ፉዸተመ አርገትናን ዋኑመ እስን ናን ጄተን እስኒፍ ነንኬነ። <verse eid="GEN 34:11"/><verse number="12" style="v" sid="GEN 34:12"/>እስንስ ገበረ ምስርቲቲፊ ኬና አን ፍዱ ቀቡ ሀመ ፌተን ነት ሙራ፤ አንስ ዋን እስን ናን ጄተን ነንባሰ። እንተለቲ ቆፈ ነት ሄሩምሲሳ።”<verse eid="GEN 34:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 34:13"/>እልማን ያቆብሞ ዋን ሼኬም ኦቦሌቲሳኒ ዲና ጉዴዴፍ ዬሮ ሼኬሚፊ አባሳ ሀሞሪፍ ዴቢ ኬነንት ሀጡማዻን ዱበተን። <verse eid="GEN 34:13"/><verse number="14" style="v" sid="GEN 34:14"/>እሳንስ አከነ እሳኒን ጄዸን፤ “ኑ ዋን አከና ጎቹ ህንደንዴኙ፤ ኑ ነመ ዸግነ ህንቀበትኒፍ እንተለኬኘ ኬኑ ህንደንዴኙ። ኩን ኑፍ ሰልጵነ። <verse eid="GEN 34:14"/><verse number="15" style="v" sid="GEN 34:15"/>ኑ ዋን ቶኮ ቆፋን ቶሌ እስኒን ጄነ፤ ኩንስ ዮ እስን ዺረኬሰን ሁንደ ዸግነ ቀብደኒ አኩመኬኘ ታተኒዸ። <verse eid="GEN 34:15"/><verse number="16" style="v" sid="GEN 34:16"/>ኤርገሲ ኑ እንተለንኬኘ እስኒ ኬንነ፤ እንተለንኬሰንሞ ንፉነ። ግዱኬሰን ንጅራትነ፤ እስን ወጅንስ ሰበ ቶኮ ንታነ። <verse eid="GEN 34:16"/><verse number="17" style="v" sid="GEN 34:17"/>ገሩ ዮ እስን ዸግነ ቀበቹ ድደን ኑ ኦቦሌቲኬኘ ፉዸትኔ ዴምነ።”<verse eid="GEN 34:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 34:18"/>ዱቢንሳኒ ሀሞሪፊ ሼኬም እልመ ሀሞር ንገመቺሴ። <verse eid="GEN 34:18"/><verse number="19" style="v" sid="GEN 34:19"/>ሼኬም ነሞተ መነ አባሳ ጅራተን ሁንደ ጫላ ከበጀማ ቱሬ፤ እን ሰበቢ እንተለ ያቆብት ገመዴፍ ዋን ከነ ለፈረ ህንሀርክፍኔ፤ <verse eid="GEN 34:19"/><verse number="20" style="v" sid="GEN 34:20"/>ሀሞሪፊ እልምሳ ሼኬም ገረ ከረ መጋላሳኒ ዹፈኒ ነሞተ መጋላሳኒቲን አከነ ጄዸን፤ <verse eid="GEN 34:20"/><verse number="21" style="v" sid="GEN 34:21"/>“ጀር ኩን ኑፍ ወረ ነጋት፤ ከናፉ ብየቲ ኬሰ ጅራተኒ እት ሃደልደለተን። ብየቲን እሳኒፍ ለፈ በልኣ ቀብድ፤ ኑ እንተለንሳኒ ሃፉኑ፤ እሳንስ እንተለንኬኘ ሃፉዸን። <verse eid="GEN 34:21"/><verse number="22" style="v" sid="GEN 34:22"/>ገሩ ነሞትን ኩኔን አከ ሰበ ቶኮት ኑ ወጅን ጅራቹፍ ቶሌ ከን ጄዸን ዮ ዺሮንኬኘ አኩመሳኒ ዸግነ ቀበተን ቆፈ። <verse eid="GEN 34:22"/><verse number="23" style="v" sid="GEN 34:23"/>ሎንሳኒ፣ ቀቤኝሳኒቲፊ ሆሪንሳኒ ካን ሁንድኑ ከኑመኬኘ ህንተአኒ? ከናፉ ኮታ ቶሌ እሳኒን ጄና፤ እሳንስ ኑ ወጅን ንጅራቱ።”<verse eid="GEN 34:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 34:24"/>ነሞትን ከረ መጋላ ሰናቲን ገድ በአን ሁንድኑ ሀሞሪፊ እልመሳ ሼኬሚን ወሊ ገለን፤ ዺሮትን ከረ መጋላ ሰናቲን ገድ በአን ሁንድኑስ ዸግነ ቀበተን።<verse eid="GEN 34:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 34:25"/>ጉያ ሰዲ ቦዴ ኡቱመ እሳን ዹኩብሰቻ ጅረኑ፣ እልማን ያቆቢ ኬሳ ነምን ለመ ስምኦኒፊ ሌዊን፣ ኦቦሎትን ዲና፣ ጎራዴሳኒ ፉዸተኒ መጋላ ሆማ ቁበ ህንቀብኔ ሰነ ዸአኒ ዺረ ሁንደ አጄሰን። <verse eid="GEN 34:25"/><verse number="26" style="v" sid="GEN 34:26"/>እሳንስ ጎራዴዻን ሀሞሪፊ እልመሳ ሼኬምን አጄሰኒ ዲናሞ መነ ሼኬሚቲ ፉዸተኒ ቀጄለን። <verse eid="GEN 34:26"/><verse number="27" style="v" sid="GEN 34:27"/>እልማን ያቆብስ ሬፈወንረ ደርበኒ መጋላ ኦቦሌቲንሳኒ እት ጉዴደምቴ ሰነ ሳመን። <verse eid="GEN 34:27"/><verse number="28" style="v" sid="GEN 34:28"/>እሳንስ ቡሻዬሳኒ፣ ሎንሳኒ፣ ሀሮተሳኒቲፊ ዋን እሳን መጋላ ኬሳፊ አላ ቀበን ሁንደ ፉዸተን። <verse eid="GEN 34:28"/><verse number="29" style="v" sid="GEN 34:29"/>ቀቤኘሳኒ ሁንደ፣ ዱበርቶታፊ እጆሌሳኒ ሁንደ ፉዸተኒ ዴመን፤ ዋን መነ ኬሰ ጅሩ ሁንደስ ንቦጅአን።<verse eid="GEN 34:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 34:30"/>ያቆብስ ስምኦኒፊ ሌዊዻን አከነ ጄዼ፤ “እስን አከ አን ከነኣኖታፊ ፌርዞተ ብየ ከነ ጅራተንት ጥሬፈተሙ ጎቹዻን ረኮ ነት ፍደን። ኑ ባይእናን ጥኖዸ፤ ዮ እሳን ሁምነ ወልት ደበለተኒ ነ ሎለን አኒፊ ወር መነኮ ሁንድኑ ንዹምነ።”<verse eid="GEN 34:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 34:31"/>እሳን ገሩ፣ “ዮስ እን አኩመ ሰጋገልቱ ቶኮት ኦቦሌቲኬኘት ሃተጰቱሬ?” ጄዸኒ ዴብሰን።<verse eid="GEN 34:31"/></para>
  <chapter eid="GEN 34"/>
  <chapter number="35" style="c" sid="GEN 35"/>
  <para style="s1">ያቆብ ቤትኤልት ዴብኤ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 35:1"/>ዋቅን ያቆቢን፣ “ከኢቲ ቤትኤልት ኦል በኢ አች ጅራዹ፤ አችትስ ዋቀ ዬሮ አት ኦቦሌሰኬ ኤሳዉን በቀቴት ስት ሙልአቴ ሰናፍ እዶ ኣርሳ ቶልች” ጄዼ።<verse eid="GEN 35:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 35:2"/>ያቆብ ወረ መነሳ ጅረኒፊ ወረ እሰ ወጅን ቱረን ሁንዳን አከነ ጄዼ፤ “ዋቆተ ኦርማ ከኔን እስን ኦፍ ብራ ቀብደንራ ፈጋዻ፤ ኦፍ ቁልቁሌሳ፤ ኡፈተኬሰንስ ጌደረዻ። <verse eid="GEN 35:2"/><verse number="3" style="v" sid="GEN 35:3"/>ኮታ ካኔ ቤትኤልት ኦል ባና፤ አንስ አችት ዋቀ ጋፈ ረክነኮቲ ዴቢ ና ኬኔ እሰ እዶ አን ዸቄ ሁንዱመት ነ ወጅን ቱሬ ሰናፍ እዶ ኣርሳ ነንቶልቸ።” <verse eid="GEN 35:3"/><verse number="4" style="v" sid="GEN 35:4"/>እሳንስ ዋቆተ ኦርማ ከኔን እሳን ኦፍ ብራ ቀበን ሁንዳፊ ሎቲ ጉረሳኒ ያቆብት ኬነን፤ ያቆብስ ፉዼ ቅልጡ ሼኬሚ ጀለት አዋሌ። <verse eid="GEN 35:4"/><verse number="5" style="v" sid="GEN 35:5"/>እሳንስ ከአኒ ቀጄለን፤ አከ ነምን ቶኮዩ እሳን ዱካ ህንቡኔፍ ናስሱን ዋቃ መጋላወን ናኖሳኒ ጅረንረ ቡኤ።<verse eid="GEN 35:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 35:6"/>ያቆቢፊ ነሞትን እሰ ወጅን ቱረን ሁንድ ገረ ሉዝ ከን ቤትኤል ጄዸምቱ እሼ ብየ ከነኣን ኬሰት አርገምቱ ሰና ዹፈን። <verse eid="GEN 35:6"/><verse number="7" style="v" sid="GEN 35:7"/>እንስ አችት እዶ ኣርሳ ቶልቼ ሰበቢ ዬሮ እን ኦቦሌሰሳ ጀላ በቀቻ ቱሬት ዋቅን አችት እሰት ኦፍ ሙልእሴፍ እዶ ሰነ ኤል ቤትኤል ጄዼ ዋሜ።<verse eid="GEN 35:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 35:8"/>ዴቦራን ጉድፍቱን ርብቃ ዱቴ ቤትኤሊ ገድት ቅልጡ ጀለት አዋለምቴ። መቃንሳስ አሎንባኩት ጄዸሜ።<verse eid="GEN 35:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 35:9"/>ኤርገ ያቆብ ካበ ዽአ ጳዳን አራሚቲ ዴብኤ ቦዴ ዋቅን አመስ እሰት ሙልአቴ እሰ ኤብሴ። <verse eid="GEN 35:9"/><verse number="10" style="v" sid="GEN 35:10"/>ዋቅን፣ “መቃንኬ ያቆብ፤ ስአች ገሩ አት ያቆብ ህንጄዸምቱ፤ መቃንኬ እስራኤል ጄዸመ” ጄዼን። መቃንሳስ እስራኤል ጄዸሜ።<verse eid="GEN 35:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 35:11"/>ዋቅን አከነ እሳን ጄዼ፤ “አን ዋቀ ዋን ሁንደ ደንደኡዸ፤ ሆር፤ ባይአዹስ። ሰብኒፊ ወልዳን ሰቦታ ስራ አርገሙ፤ ሞቶትንስ ሙዺኬ ኬሳ በኡ። <verse eid="GEN 35:11"/><verse number="12" style="v" sid="GEN 35:12"/>አን ብየ አብረሃሚፊ ይስሃቂፍ ኬኔ ሲፍስ ነንኬነ፤ አን ብየ ከነ ሰኚኬ ወረ ስ ቦዴቲፍስ ነንኬነ።” <verse eid="GEN 35:12"/><verse number="13" style="v" sid="GEN 35:13"/>ዋቅንስ እዶ እት እሰ ወጅን ሃሰኣ ቱሬ ሰነት እሰ ዺሴ ኦል በኤ።<verse eid="GEN 35:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 35:14"/>ያቆብ እዶ እት ዋቅን እሰ ወጅን ዱበቴ ሰነ ኡቱባ ዸጋ ቶኮ ዻቤ ኬና ዹጋቲረት ዸንገላሴ፤ ዘይቲስ እረት ዸንገላሴ። <verse eid="GEN 35:14"/><verse number="15" style="v" sid="GEN 35:15"/>ያቆብስ እዶ እት ዋቅን እሰ ወጅን ዱበቴ ሰነ ቤትኤል ጄዼ ሞጋሴ።<verse eid="GEN 35:15"/></para>
  <para style="s1">ዱአ ራሄሊፊ ይስሃቅ</para>
  <para style="r">
    <ref loc="GEN 35:23-26">35፥23‑26</ref> ኩወእ – <char style="xt"><ref loc="1CH 2:1-2">1ሴና 2፥1‑2</ref></char></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 35:16"/>እሳንስ ቤትኤሊ ከአኒ አዴምሰሳኒ እት ፉፈን። አኩመ እሳን ኤፍራታት ዽኣተኒንስ ራሄል ጭኒንሱን ቀበምቴ አከ መሌ ሙደምቴ። <verse eid="GEN 35:16"/><verse number="17" style="v" sid="GEN 35:17"/>ኡቱ እሼን ደኡፍ ጭኒንሱ ጀባ ኬሰ ጅርቱስ ዴስፍቱን፣ “አት ዋን እልመ ብራ ዴሱፍ ህንሶዳትን” ጄቴን። <verse eid="GEN 35:17"/><verse number="18" style="v" sid="GEN 35:18"/>ራሄል ገሩ ዋን ዱኡ ጌሴፍ ኡቱመ ሉቡንሼ በኣ ጅርቱ ቤን-ኦኒ ጄቴ እልመሼ ሞጋፍቴ። አባንሳ ገሩ ቤንያም ጄዼ እሰ ሞጋሴ።<verse eid="GEN 35:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 35:19"/>አከሲን ራሄል ዱቴ ከራ ኤፍራታት ጌሱረት አዋለምቴ፤ ኤፍራታን ኩንሞ ቤትልሄም። <verse eid="GEN 35:19"/><verse number="20" style="v" sid="GEN 35:20"/>ያቆብስ አዋለሼረ ሶዱ ዻቤ፤ ሶዱን ሱንስ ሀመ ሀርኣቱ አዋለ ራሄል አርግሲሰ።<verse eid="GEN 35:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 35:21"/>እስራኤል አመስ አቺ ከኤ ምግዳል ኤዴሪን ገመት ዱንካነሳ ዻበቴ። <verse eid="GEN 35:21"/><verse number="22" style="v" sid="GEN 35:22"/>ኡቱ እስራኤል ብየ ሰነ ጅራቱ ሩቤን ኦል ሴኔ ሳጀቶ አባሳ ብልሃ ወጅን ጪሴ፤ እስራኤልስ ዋን ከነ ዸገኤ።</para>
  <para style="b" vid="GEN 35:22"/>
  <para style="lh" vid="GEN 35:22">ያቆብ እልማን ኩዸ ለመ ቀበ ቱሬ፤ እሳንስ፦<verse eid="GEN 35:22"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="23" style="v" sid="GEN 35:23"/>እልማን ልያ፦</para>
  <para style="li2" vid="GEN 35:23">ሩቤን ጄቹንስ እልመ ያቆብ እሰ ሀንገፈ፣</para>
  <para style="li2" vid="GEN 35:23">ስምኦን፣ ሌዊ፣ ይሁዳ፣ ይሳኮሪፊ ዜቡሎን።<verse eid="GEN 35:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="GEN 35:24"/>እልማን ራሄል፦</para>
  <para style="li2" vid="GEN 35:24">ዮሴፊፊ ቤንያም።<verse eid="GEN 35:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="GEN 35:25"/>እልማን ብልሃ ጄቹንስ ጦምቦሬ ራሄል፦</para>
  <para style="li2" vid="GEN 35:25">ዳኒፊ ንፍታሌም።<verse eid="GEN 35:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="GEN 35:26"/>እልማን ዝልፋ ጄቹንስ ጦምቦሬ ልያ፦</para>
  <para style="li2" vid="GEN 35:26">ጋዲፊ ኣሼር።</para>
  <para style="b" vid="GEN 35:26"/>
  <para style="lf" vid="GEN 35:26">እሳን ኩኔን እልማን ያቆብ ከኔን ካበ ዽአ ጳዳን አራሚት እሳፍ ዸለተኒዸ።<verse eid="GEN 35:26"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="27" style="v" sid="GEN 35:27"/>ያቆብስ ገረ አባሳ፣ ገረ ይስሃቅ፣ ገረ መጋላ መምሬ እሼ ክርያት አርባቅ ከን ኬብሮን ጄዸምቱ፣ እዶ አብረሃሚፊ ይስሃቅ አለጎተ ተአኒ ጅራቻ ቱረን ሰና ዹፌ። <verse eid="GEN 35:27"/><verse number="28" style="v" sid="GEN 35:28"/>ይስሃቅ ወጋ ዽበ ቶኮፊ ሰዴተመ ጅራቴ። <verse eid="GEN 35:28"/><verse number="29" style="v" sid="GEN 35:29"/>እንስ ኡሙሪ ቁፌ፣ ዱሎሜ ሀፉረሳ ከን ዹማ ባፈቴ ዱኤ፤ ገረ ሰበ እሳትስ ደበለሜ። እልማንሳ ኤሳዉፊ ያቆብስ እሰ አዋለን።<verse eid="GEN 35:29"/></para>
  <chapter eid="GEN 35"/>
  <chapter number="36" style="c" sid="GEN 36"/>
  <para style="s1">ሰኚወን ኤሳዉ</para>
  <para style="r">
    <ref loc="GEN 36:10-14">36፥10‑14</ref> ኩወፈ – <char style="xt"><ref loc="1CH 1:35-37">1ሴና 1፥35‑37</ref></char></para>
  <para style="r">
    <ref loc="GEN 36:20-28">36፥20‑28</ref> ኩወፈ – <char style="xt"><ref loc="1CH 1:38-42">1ሴና 1፥38‑42</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 36:1"/>ሴናን ማቲ ኤሳዉ ከን ኤዶም ጄዸሙ ሰና ከነ።<verse eid="GEN 36:1"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="2" style="v" sid="GEN 36:2"/>ኤሳው ኒቶተሳ ዱበርቶታ ከነኣን ኬሳ ፉዼ፤ እሳንስ ኣዳ እንተለ ኤሎን ነምቸ ጎሰ ሄቲፊ ኦሆሊባማ እንተለ ኣና እልመ ዝቤኦን ነምቸ ጎሰ ሂዊ፣ <verse eid="GEN 36:2"/><verse number="3" style="v" sid="GEN 36:3"/>አከሱመስ ባስመት እንተለ እሽማኤል ኦቦሌቲ ነባዮት።<verse eid="GEN 36:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 36:4"/>ኣዳን ኤሊፋዝን ኤሳዉፍ ዴሴ፤ ባስመትሞ ሬኡኤልን ዴሴ። <verse eid="GEN 36:4"/><verse number="5" style="v" sid="GEN 36:5"/>ኦሆሊባማንስ ዬኡሽ፣ የእላሚፊ ቆራህ ዴሴ። እሳን ኩኔን እልማን ኤሳዉ ከኔን ከነኣንት እሳፍ ዸለተኒዸ።<verse eid="GEN 36:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 36:6"/>ኤሳዉ ኒቶተሳ፣ እልማንሳ፣ እንተለንሳቲፊ ወረ መነሳ ጅራተን ሁንደ፣ አከሱመስ ከረ ሎንሳ፣ ሆሪሳ ካን ሁንዳፊ ቀቤኘ ብየ ከነኣንት ሆረቴ ሁንደ ፉዸቴ ኦቦሌሰሳ ያቆብ ብራ ከኤ ብየ ብራ ዸቄ። <verse eid="GEN 36:6"/><verse number="7" style="v" sid="GEN 36:7"/>ዋን ቀቤኝሳኒ አከ መሌ ባይአቴፍ እሳን ወሊ ወጅን ጅራቹ ደዸበን፤ ለፍት እሳን ጅራቻ ቱረንስ ሰበቢ ባይእነ ሆሪሳኒቲፍ እሳን ገኡ ህንደንዴኜ። <verse eid="GEN 36:7"/><verse number="8" style="v" sid="GEN 36:8"/>ኤሳዉ ብየ ጋረ ሴኢር ኬሰ ጅራቴ፤ ኤሳዉ ጄቹን ኤዶሚዸ።<verse eid="GEN 36:8"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="9" style="v" sid="GEN 36:9"/>ሴናን ማቲ ኤሳዉ አባ ኤዶሞታ ከን ወረ ብየ ጋረ ሴኢር ኬሰ ጅራተኒ ከነ።<verse eid="GEN 36:9"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="10" style="v" sid="GEN 36:10"/>መቃን እልማን ኤሳዉ፦</para>
  <para style="li2" vid="GEN 36:10">ኤሊፋዝ፣ እልመ ኣዳ ኒቲ ኤሳዉቲፊ ሬኡኤል እልመ ባስመት ኒቲ ኤሳዉት።<verse eid="GEN 36:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="GEN 36:11"/>እልማን ኤሊፋዝ፦</para>
  <para style="li2" vid="GEN 36:11">ቴማን፣ ኦማር፣ ዜፎ፣ ጋታሚፊ ቄነዝ። <verse eid="GEN 36:11"/><verse number="12" style="v" sid="GEN 36:12"/>ኤሊፋዝ እልም ኤሳዉስ ሳጀቶ ቲምና ጄዸምቱ ቀበ ቱሬ፤ እሼንስ አማሌቅን ኤሊፋዚፍ ዴሴ። እሳን ኩኔን እልማን እልማን ኣዳ ኒቲ ኤሳዉ።<verse eid="GEN 36:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="GEN 36:13"/>እልማን ሬኡኤል፦</para>
  <para style="li2" vid="GEN 36:13">ነሃት፣ ዜራ፣ ሸማፊ ሚዛህ። እሳን ኩኔን እልማን እልማን ባስመት ኒቲ ኤሳዉ።<verse eid="GEN 36:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="GEN 36:14"/>ኦሆሊባማን ኒቲን ኤሳዉ እንተል ኣና እልመ ዝቤኦን ኤሳዉፍ፦</para>
  <para style="li2" vid="GEN 36:14">ዬኡሽ፣ የእላሚፊ ቆራህ ዴሴ።<verse eid="GEN 36:14"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="15" style="v" sid="GEN 36:15"/>እሳን ኩኔን ሰኚወን ኤሳዉ ኬሳ ሀንገፎተ ቱረን፦</para>
  <para style="li1" vid="GEN 36:15">እልማን ኤሊፋዝ እልመ ኤሳዉ እሰ ሀንገፋ፦</para>
  <para style="li2" vid="GEN 36:15">ቴማን ሀንገፍትቸ፣ ኦማር ሀንገፍትቸ፣ ዜፎ ሀንገፍትቸ፣ ቄነዝ ሀንገፍትቸ፣ <verse eid="GEN 36:15"/><verse number="16" style="v" sid="GEN 36:16"/>ቆራህ ሀንገፍትቸ፣ ጋታም ሀንገፍትቻፊ አማሌቅ ሀንገፍትቸ። እሳን ኩኔን ሀንገፎተ ብየ ኤዶም ኬሰት ኤሊፋዝራ ዸለተኒዸ፤ እሳንስ እልማን ኣዳት።<verse eid="GEN 36:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="GEN 36:17"/>እልማን ሬኡኤል እልመ ኤሳዉ፦</para>
  <para style="li2" vid="GEN 36:17">ነሃት ሀንገፍትቸ፣ ዜራ ሀንገፍትቸ፣ ሸማ ሀንገፍትቻፊ ሚዛህ ሀንገፍትቸ። እሳን ኩኔን ሀንገፎተ ብየ ኤዶምት ራቁኤልራ ዸለተኒዸ፤ እሳንስ እልማን ባስመት ኒቲ ኤሳዉ።<verse eid="GEN 36:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="GEN 36:18"/>እልማን ኦሆሊባማ ኒቲ ኤሳዉ፦</para>
  <para style="li2" vid="GEN 36:18">ዬኡሽ ሀንገፍትቸ፣ የእላማ ሀንገፍትቻፊ ቆራህ ሀንገፍትቸ። እሳን ኩኔን ሀንገፎተ አህሊባማ ኒቲ ኤሳዉ እንተለ ኣናራ ዸለተኒዸ።<verse eid="GEN 36:18"/></para>
  <para style="lf">
    <verse number="19" style="v" sid="GEN 36:19"/>እሳን ኩኔን እልማን ኤሳዉ ኤዶም ጄዸሙ ሰና ቱረን፤ እሳን ኩኔንስ ሀንገፎተሳኒ ቱረን።<verse eid="GEN 36:19"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="20" style="v" sid="GEN 36:20"/>እሳን ኩኔን እልማን ሴኢር ነምቸ ጎሰ ሆሪ ከኔን ብየ ሰነ ኬሰ ጅራቻ ቱረኒዸ፤ እሳንስ፦</para>
  <para style="li2" vid="GEN 36:20">ሎጣን፣ ሶባል፣ ዝቤኦን፣ ኣና፣ <verse eid="GEN 36:20"/><verse number="21" style="v" sid="GEN 36:21"/>ዲሾን፣ ኤዜሪፊ ዲሻን። እልማን ሴኢር ከኔን ብየ ኤዶም ኬሳ ኩኔን ሀንገፎተ ሆሮታ ቱረን።<verse eid="GEN 36:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="GEN 36:22"/>እልማን ሎጣን፦</para>
  <para style="li2" vid="GEN 36:22">ሆሪፊ ሆማም። ቲምና ኦቦሌቲ ሎጣን።<verse eid="GEN 36:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="GEN 36:23"/>እልማን ሶባል፦</para>
  <para style="li2" vid="GEN 36:23">አልዋን፣ ማነሃት፣ ኤባል፣ ሼፎፊ ኦናም።<verse eid="GEN 36:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="GEN 36:24"/>እልማን ዝቤኦን፦</para>
  <para style="li2" vid="GEN 36:24">አያፊ ኣና። ኣናን ኩንስ ነምቸ ኡቱ ሀሮተ አባሳ ዝቤኦን ትክሱ ገሞጂ ኬሰት ቡርቃ ብሻን ደንፋ አርገቴዸ።<verse eid="GEN 36:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="GEN 36:25"/>እጆሌ ኣና፦</para>
  <para style="li2" vid="GEN 36:25">ዲሾኒፊ ኦሆሊባማ እንተለ ኣና።<verse eid="GEN 36:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="GEN 36:26"/>እልማን ዲሾን፦</para>
  <para style="li2" vid="GEN 36:26">ሄምዳን፣ ኤሽባን፣ ይትራኒፊ ኬራን።<verse eid="GEN 36:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="GEN 36:27"/>እልማን ኤዜር፦</para>
  <para style="li2" vid="GEN 36:27">ብልሃን፣ ዛዋኒፊ አቃን።<verse eid="GEN 36:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="GEN 36:28"/>እልማን ዲሻን፦</para>
  <para style="li2" vid="GEN 36:28">ኡዚፊ አራን።<verse eid="GEN 36:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="GEN 36:29"/>እሳን ኩኔን ሀንገፎተ ሆሮታት፦</para>
  <para style="li2" vid="GEN 36:29">ሎጣን፣ ሶባል፣ ዝቤኦን፣ ኣና፣ <verse eid="GEN 36:29"/><verse number="30" style="v" sid="GEN 36:30"/>ዲሾን፣ ኤዜሪፊ ዲሻን።</para>
  <para style="lf" vid="GEN 36:30">እሳን ኩኔን ብየ ሴኢር ኬሰት አኩመ ጎሰ ጎሰሳኒት ሀንገፎታ ሆሮታ ቱረን።<verse eid="GEN 36:30"/></para>
  <para style="s1">ሞቶተ ኤዶም</para>
  <para style="r">
    <ref loc="GEN 36:31-43">36፥31‑43</ref> ኩወፈ – <char style="xt"><ref loc="1CH 1:43-54">1ሴና 1፥43‑54</ref></char></para>
  <para style="lh">
    <verse number="31" style="v" sid="GEN 36:31"/>ሞቶትን ኡቱ ሞቲን እስራኤል ቶኮዩ ህንሞእን ዱረ ኤዶም ኬሰት ሞአን ከኔን ቱረን፦<verse eid="GEN 36:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="GEN 36:32"/>ቤላ እልም ቤኦር ሞቲ ኤዶም ተኤ። መጋላንሳ ዲንሃባ ጄዸሜ ሞጋፈሜ።<verse eid="GEN 36:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="GEN 36:33"/>ቤላ ዱናን ዮባብ እልም ዜራ ነምች ቦዝራ እዶሳ ቡኤ ሞቲ ተኤ።<verse eid="GEN 36:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="GEN 36:34"/>ዮባብ ዱናን ሁሻም ነምች ብየ ቴማን እዶሳ ቡኤ ሞቲ ተኤ።<verse eid="GEN 36:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="GEN 36:35"/>ሁሻም ዱናን ሀዳድ እልም ቤደድ እን ብየ ሞኣብት ምድያንን ሞአቴ ሱን እዶሳ ቡኤ ሞቲ ተኤ። መቃን መጋላሳ ኣዊት ጄዸሜ።<verse eid="GEN 36:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="GEN 36:36"/>ሀዳድ ዱናን ሰምላን ነምች መስሬቃ እዶሳ ቡኤ ሞቲ ተኤ።<verse eid="GEN 36:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="GEN 36:37"/>ሰምላን ዱናን ሻዉል ነምች ብየ ሬሆቦት እሼ ለገ ብረ ጅርቱ ሰና እዶሳ ቡኤ ሞቲ ተኤ።<verse eid="GEN 36:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="GEN 36:38"/>ሻዉል ዱናን በኣል-ሃናን እልም አክቦር እዶሳ ቡኤ ሞቲ ተኤ።<verse eid="GEN 36:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="GEN 36:39"/>በኣል-ሃናን እልም አክቦር ዱናንሞ ሀዳድ እዶሳ ቡኤ ሞቲ ተኤ። መጋላንሳስ ፋኡ ጄዸሜ። መቃን ኒቲሳሞ መሄጠብኤል ጄዸመ ቱሬ። እሼንስ እንተለ መጥሬድ እንተለ ሜ-ዛሃብ ቱርቴ።<verse eid="GEN 36:39"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="40" style="v" sid="GEN 36:40"/>ሀንገፎትን ኤሳዉራ ዸለተን አኩመ ጎሰ ጎሰሳኒቲፊ አኩመ ናኖ ጅሬኘሳኒት መቃ መቃን ከኔኒዸ፦</para>
  <para style="li1" vid="GEN 36:40">ቲምና፣ ኣልዋ፣ ዬቴት፣<verse eid="GEN 36:40"/></para>
  <para style="li1">
    <verse number="41" style="v" sid="GEN 36:41"/>ኦሆሊባማ፣ ኤላ፣ ጲኖን፣<verse eid="GEN 36:41"/></para>
  <para style="li1">
    <verse number="42" style="v" sid="GEN 36:42"/>ቄነዝ፣ ቴማን፣ ምብዛር፣<verse eid="GEN 36:42"/></para>
  <para style="li1">
    <verse number="43" style="v" sid="GEN 36:43"/>መግዲኤሊፊ ኢራም።</para>
  <para style="lf" vid="GEN 36:43">ነሞትን ኩኔን አኩመ ለፈ ብየ ቀበተኒ ኬሰ ጅራተኒት ሀንገፎተ ኤዶም ቱረን።</para>
  <para style="b" vid="GEN 36:43"/>
  <para style="lf" vid="GEN 36:43">ኤሳዉን ኩንስ አባ ኤዶሞታት።<verse eid="GEN 36:43"/></para>
  <chapter eid="GEN 36"/>
  <chapter number="37" style="c" sid="GEN 37"/>
  <para style="s1">አብጁ ዮሴፍ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 37:1"/>ያቆብ ብየ አባንሳ ቱሬ፣ ከነኣን ኬሰ ጅራቴ።<verse eid="GEN 37:1"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="2" style="v" sid="GEN 37:2"/>ሴናን ማቲ ያቆብ ከነ።</para>
  <para style="b" vid="GEN 37:2"/>
  <para style="p" vid="GEN 37:2">ዮሴፍ ዬሮ ደርገጌሰ ወጋ ኩዸ ቶርበ ቱሬት ኦቦሎተሳ፣ እልማን ኒቶተ አባሳ ጄቹንስ እልማን ብልሃቲፊ ዝልፋ ወጅን ቡሻዬ ትክሰ ቱሬ፤ እንስ ዋኤ ኦቦሎተሳ ኦዱ ሀማ አባሳቲፍ ፍዴ።<verse eid="GEN 37:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 37:3"/>እስራኤል ዋን በረ ዱሉማ ኬሰ እሰ ዸልቼፍ እልማንሳ ሁንደ ጫላ ዮሴፍን ጃለተ ቱሬ፤ እንስ ቆሎ ፋዬፈሜ ሆጄቴፍ። <verse eid="GEN 37:3"/><verse number="4" style="v" sid="GEN 37:4"/>ኦቦሎትንሳስ ዮሙ አከ አባንሳኒ እሳን ሁንደ ጫላ እሰ ጃለቴ ሁበተንት ዮሴፍን ጅበን፤ አፋን ነጋስ እት ዱበቹ ህንደንዴኜ።<verse eid="GEN 37:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 37:5"/>ዮሴፍ አብጁ አብጆቴ ኦቦሎተሳት ህሜ፤ እሳንስ እቱመ ጫልችሰኒ እሰ ጅበን። <verse eid="GEN 37:5"/><verse number="6" style="v" sid="GEN 37:6"/>እንስ አከነ እሳኒን ጄዼ፤ “ሜ አብጁ አን አርጌ ከነ ዸገኣ፦ <verse eid="GEN 37:6"/><verse number="7" style="v" sid="GEN 37:7"/>ኑ ለፈ ቆቲሳ ኬሰት ብሲ ምዻኒ ህዻ ቱሬ፤ ኩኖ፣ ብሲንኮ ኦል ጄዼ ዻበቴ፤ ብሲወንኬሰንሞ ብሲኮት ናነአኒ ገድ ጄዸኒ ሰገደኒፍ።”<verse eid="GEN 37:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 37:8"/>ኦቦሎትንሳስ፣ “አት ኑረት ሞቲ ተኡ በርባዳ? ዹጉማን ስቱ ኑ ቡልቻ?” ጄዸኒን። እሳንስ ሰበቢ አብጁሳቲፊ ሰበቢ ዋን እን ዱበቴቲፍ እቱመ ጫልችሰኒ እሰ ጅበን።<verse eid="GEN 37:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 37:9"/>ኤርገሲስ አብጁ ብራ አብጆቴ ኦቦሎተሳት ህሜ። አከነስ ጄዼን፤ “ኩኖ፣ አን አብጁ ብራ አብጆዼረ፤ አዱፊ ጅእ፣ ኡርጂወን ኩዸ ቶኮስ ገድ ጄዸኒ ና ሰገዱ።”<verse eid="GEN 37:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 37:10"/>ዮሙ እን ዋን ከነ አባሳቲፊ ኦቦሎተሳት ህሜት አባንሳ፣ “አብጁን አት አብጆቴ ኩን ማል? አን፣ ሃትኬቲፊ ኦቦሎትንኬ ዹጉማን ዹፍኔ ፉለኬ ዱረት ገድ ጄኔ ሲፍ ሰገድና?” ጄዼ እሰት ዼከሜ። <verse eid="GEN 37:10"/><verse number="11" style="v" sid="GEN 37:11"/>ኦቦሎትንሳ እሰት ህናፈን፤ አባንሳ ገሩ ዋን ከነ ገራት ቀበቴ።<verse eid="GEN 37:11"/></para>
  <para style="s1">ዮሴፍ ኦቦሎተሳቲን ጉርጉረሜ</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 37:12"/>ጋፍ ቶኮ ኦቦሎትንሳ ቡሻዬ አባሳኒ ሼኬም ብረ ዼችሱ ዸቀን፤ <verse eid="GEN 37:12"/><verse number="13" style="v" sid="GEN 37:13"/>እስራኤልስ ዮሴፊን፣ “አኩመ አት ቤክቱ ኦቦሎትንኬ ሼኬም ብረ ቡሻዬ ዼችሳ ጅሩ። ሜ ኮቱ አን ገረሳኒት ስን ኤርጋ” ጄዼ።</para>
  <para style="p" vid="GEN 37:13">ዮሴፍስ፣ “ኩኖ አሰን ጅረ” ጄዼን።<verse eid="GEN 37:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 37:14"/>እስራኤልሞ፣ “ሜ ዸቂቲ አከ ኦቦሎትንኬ፣ ቡሻዬንስ ነጋ ተአኒፊ አከ ህንተእን እላሊቲ ዴብኢ ነት ህም” ጄዼን። እንስ አከሲን ሱሉለ ኬብሮኒቲ ሼኬምት እሰ ኤርጌ።</para>
  <para style="p" vid="GEN 37:14">ዮሴፍስ ሼኬም ገኤ፤ <verse eid="GEN 37:14"/><verse number="15" style="v" sid="GEN 37:15"/>ነምች ቶኮ እሰ አርጌ፤ ኩኖ እን ድሬረ ጆራ ቱሬ፤ ነምች ሱንስ፣ “አት ማል በርባደ?” ጄዼ እሰ ጋፈቴ።<verse eid="GEN 37:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 37:16"/>ዮሴፍስ ዴብሴ፣ “አን ኦቦሎተኮን በርባደ። አት እዶ እሳን ቡሻዬሳኒ ዼችሰን ሜ ነት ህም” ጄዼን።<verse eid="GEN 37:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 37:17"/>ነምችስ ዴብሴ፣ “እሳን አሲ ዴመኒሩ፤ አን ‘ገረ ዶታን ሃዸቅኑ’ ጄቹሳኒ ዸገኤረ” ጄዼ።</para>
  <para style="p" vid="GEN 37:17">ዮሴፍስ ኦቦሎተሳ ዱካ ቡኤ ዶታይን ብረት እሳን አርገቴ። <verse eid="GEN 37:17"/><verse number="18" style="v" sid="GEN 37:18"/>እሳን ገሩ ፈጎት እሰ አርገኒ እሰ አጄሱፍ ኡቱ እን እሳን ብረ ህንገእን መርአተን።<verse eid="GEN 37:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 37:19"/>እሳንስ አከነ ወሊን ጄዸን፤ “ኩኖ አባን አብጁ ሱን ዹፋ ጅረ! <verse eid="GEN 37:19"/><verse number="20" style="v" sid="GEN 37:20"/>ኮታ አጄፍኔ ቦለወን አስ ጅረን ኬሳ ቶኮት እሰ ገትኔ ብኔንሰ ሀማቱ እሰ ኛቴ ጄነ። ኤርገሲሞ አብጁንሳ ማል አከ ተኡ እላለ።”<verse eid="GEN 37:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 37:21"/>ሩቤን ዋን ከነ ዸጌኛን እሳን ሀርካ እሰ ባሴ። እንስ አከነ ጄዼ፤ “ለኪ እሰ ህንአጄፍኑ፤ <verse eid="GEN 37:21"/><verse number="22" style="v" sid="GEN 37:22"/>ዺገ ህንዸንገላስና። ገሞጂ ኬሰት ቦለ ከነ ኬሰ እሰ ቡሳ መሌ ሀርከኬሰኒን እሰ ህንቱቅና።” ሩቤን እሳን ሀርካ እሰ ባሴ ገረ አባሳት እሰ ዴብሱፍ አከነ ጄዼ።<verse eid="GEN 37:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 37:23"/>ዬሮ ዮሴፍ ኦቦሎተሳ ብረ ገኤት እሳን ቆሎ እን ኡፈቴ፣ ቆሎ ሚዸጋ ሰነ እሰራ ባሰኒ፣ <verse eid="GEN 37:23"/><verse number="24" style="v" sid="GEN 37:24"/>እሰ ፉዸኒ ቦለት ገድ ደርበተን። ቦል ሱንስ ዱዋ ቱሬ፤ ብሻንስ ህንቀቡ ቱሬ።<verse eid="GEN 37:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 37:25"/>ኦቦሎትንሳ ቡዴነ ኛቹፍ ተታአን፤ ኦል ጄዸኒስ ኩኖ፣ ደልደልቶተ ወረ እሽማኤል ከኔን ግልኣዲ ዹፋ ጅረን አርገን። እሳንስ ኡርጎፍቱ፣ ሀጴ ድበታቲፊ ቁምቢ ጋለወንሳኒት ፌአተኒ ግብጥት ጌሳ ቱረን።<verse eid="GEN 37:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 37:26"/>ይሁዳንስ ኦቦሎተሳቲን አከነ ጄዼ፤ “ኦቦሌሰኬኘ አጄፍኔ ዺገሳ ዾክሱን ቡኣ ማሊ ኑ ቀበ? <verse eid="GEN 37:26"/><verse number="27" style="v" sid="GEN 37:27"/>ኮታ እሽማኤሎተት እሰ ጉርጉረ መሌ ሀርከኬኛን እሰ ህንቱቅኑ፤ እን ኦቦሌሰኬኛፊ ፎንኬኘ።” ኦቦሎትንሳስ ያደ ከነ ፉዸተን።<verse eid="GEN 37:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 37:28"/>ዮሙ ደልደልቶትን ምድያን አቺን ደርቡፍ ዹፈንትስ ኦቦሎትን ዮሴፍ ቦለ ኬሳ ሀርክሰኒ ኦል እሰ ባሰኒ ሜቲ ሰቅሊ ድግደማት እሽማኤሎተት እሰ ጉርጉረተን፤ ጀርስ ግብጥት እሰ ጌሰን።<verse eid="GEN 37:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 37:29"/>ሩቤን ገረ ቦለ ሰናት ዴብኤ፤ ዮሴፍ ቦለ ሰነ ኬሰ ህንቱሬ፤ እንስ ኡፈተ ኦፊሳ ተርሳሴ። <verse eid="GEN 37:29"/><verse number="30" style="v" sid="GEN 37:30"/>እንስ ገረ ኦቦሎተሳ ዸቄ፣ “ጉርብች አች ህንጅሩ! ኤጋ አን ኤሰን ዸቀ?” ጄዼን።<verse eid="GEN 37:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 37:31"/>እሳንስ ቆሎ ዮሴፍ ፉዸኒ ሬኤ ቶኮ ቀለኒ ቆሎ ሰነ ዺገ ኬሰ ጩጰን። <verse eid="GEN 37:31"/><verse number="32" style="v" sid="GEN 37:32"/>ቆሎ ሚዸጋ ሰነስ አባሳኒት ጌሰኒ፣ “ኑ ቆሎ ከነ አርገኔረ፤ ሜ ቆሎ እልመኬቲ ተኡፊ ተኡ ባቹሳ እላል” ጄዸን።<verse eid="GEN 37:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 37:33"/>እንስ ቆሎ ሰነ ቤኬ፣ “ኩን ቆሎ እልመኮቲት! ብኔንሰ ሀማቱ እሰ ኛቴ። ዹጉማን ዮሴፍ ጭጭረሜረ” ጄዼ።<verse eid="GEN 37:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 37:34"/>ከነረት ያቆብ ኡፈተ ኦፊሳ ተርሳሴ፤ ወያ ገዳ ሙዺት ህዸቴ ጉያ ባይኤ እልመሳቲፍ ገዴ። <verse eid="GEN 37:34"/><verse number="35" style="v" sid="GEN 37:35"/>እልማንሳቲፊ እንተለንሳ ሁንድኑ እሰ ጀጀቤሱፍ ከአን፤ እን ገሩ ጀጀባቹ ድዴ፣ “ለኪ አን ገዳ ገረ እልመኮ ሲኦልት ገድ ቡአ” ጄዼ። አከሲን አባንሳ ንቦኤፍ።<verse eid="GEN 37:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 37:36"/>ግዱ ሰነ ወር ምድያን ሱን ግብጥ ኬሰት ጶጢፋራ ነምቸ ቆንዳልቶተ ፈረኦን ኬሳ ቶኮ ቱሬ ከን አጀጃ ዋርድያ ተኤ ቶኮት ዮሴፍን ጉርጉረተን።<verse eid="GEN 37:36"/></para>
  <chapter eid="GEN 37"/>
  <chapter number="38" style="c" sid="GEN 38"/>
  <para style="s1">ይሁዳፊ ታማር</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 38:1"/>ዬሮ ከነት ይሁዳን ኦቦሎተሳ ብራ ዴሜ ነምቸ አዱላም ከን ሂራም ጄዸሙ ቶኮ ብረ ጅራቹፍ ገድ ቡኤ። <verse eid="GEN 38:1"/><verse number="2" style="v" sid="GEN 38:2"/>አችትስ ይሁዳን እንተለ ነምቸ ከነኣን ከን ሹዋን ጄዸሙ ቶኮ አርጌ፤ እንስሼ ፉዼ እሼ ብረ ገኤ፤ <verse eid="GEN 38:2"/><verse number="3" style="v" sid="GEN 38:3"/>እሼንስ ኡልፎፍቴ እልመ ዴሴ፤ መቃንሳስ ኤር ጄዸሜ። <verse eid="GEN 38:3"/><verse number="4" style="v" sid="GEN 38:4"/>አመስ ኡልፎፍቴ እልመ ዴሴ፤ መቃሳስ ኦናን ጄቴ ሞጋፍቴ። <verse eid="GEN 38:4"/><verse number="5" style="v" sid="GEN 38:5"/>አመስ እቱመ ደበልቴ ኡልፎፍቴ እልመ ብራ ዴሴ መቃሳ ሼላ ጄቴ ሞጋፍቴ። እሼንስ ክዚብት እሰ ዴሴ።<verse eid="GEN 38:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 38:6"/>ይሁዳንስ ኤር እልመሳ ሀንገፍትቸ ኒቲ ፉስሴ፤ መቃንሼ ታማር ጄዸመ ቱሬ። <verse eid="GEN 38:6"/><verse number="7" style="v" sid="GEN 38:7"/>ገሩ ኤር እልም ይሁዳ ሀንገፍትች ሱን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ሀማ ቱሬ፤ ከናፉ <char style="nd">ዋቀዮ</char> እሰ አጄሴ።<verse eid="GEN 38:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 38:8"/>ይሁዳንስ ኦናኒን፣ “ኦቦሌሰኬቲፍ ሰኚ ዻቡፍ ጄዺቲ ኒቲ ኦቦሌሰኬቲ ብረ ገኢቲ ድርቀመ ዋርሱማኬቲ እሼፍ ጉት” ጄዼ። <verse eid="GEN 38:8"/><verse number="9" style="v" sid="GEN 38:9"/>ኦናን ገሩ አከ እጆሌን ዸለቱ ሱን ከንሳ ህንታኔ ቤኬ፤ ከናፉ አከ ኦቦሌሰሳቲፍ ሰኚ ህንዻብኔፍ ጄዼ ዬሮ ኒቲ ኦቦሌሰሳ ብረ ገኡ ሁንደ አፌታ ለፈት ዸንገላሰ ቱሬ። <verse eid="GEN 38:9"/><verse number="10" style="v" sid="GEN 38:10"/>ወን እን ሆጄቴ ሱን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ሀማ ቱሬ፤ ከናፉ <char style="nd">ዋቀዮ</char> እሰስ ንአጄሴ።<verse eid="GEN 38:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 38:11"/>ኤርገሲ ይሁዳን ኒቲ እልመሳ ታማሪን፣ “ሀመ እልምኮ ሼላ ጉደቱት ሃዸ ህዬሳ ተኢቲ መነ አባኬቲ ጅራዹ” ጄዼ። እን፣ “ሙጫን ኩንስ አኩመ ኦቦሎተሳ ዱኣ ላተ” ጄዼ ያዴ ቱሬቲ። ከናፉ ታማር መነ አባሼ ጅራቹ ዸቅጤ።<verse eid="GEN 38:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 38:12"/>በረ ዼራ ቦዴስ እንተል ሹዋ ኒቲን ይሁዳ ዱቴ። ይሁዳንስ ገደሳራ በየነናን ገረ ቲምናህት ለፈ ወረ ሆሎተሳራ ርፌንሰ ሙርሙረኒት ኦል በኤ፤ ምቹንሳ ሂራም ነምች አዱላም እሰ ወጅን ዴሜ።<verse eid="GEN 38:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 38:13"/>ታማርስ፣ “ኩኖ አባን ዽርሰኬቲ ሆሎተሳራ ርፌንሰ ሙርሙሩፍ ጄዼ ቲምናህት ኦል በኣ ጅረ” ጄዸኒ ዬሮ እት ህመንት፣ <verse eid="GEN 38:13"/><verse number="14" style="v" sid="GEN 38:14"/>ወያ ሃዸ ህዬሳ ኦፍራ ባፍቴ ኦፍ ዾክሱፍ ሀጉጊ ሀጉገቴ፤ ኤርገሲስ በልበለ ኤናይምት ኦል ገልቹ ከን ዳንዲ ቲምናህት ጌሱረ ጅሩ ዱረ ቴሴ። ሼላ ጉደቱዩ እሼን አከ ኒቱማዻን እሳፍ ህንኬነምን ቤክቴ ቱርቴቲ።<verse eid="GEN 38:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 38:15"/>ይሁዳን ዮሙ እሼ አርጌት ሰበቢ እሼን ፉለሼ ሀጉገቴ ቱርቴፍ ሰጋገልቱሼ ሴኤ። <verse eid="GEN 38:15"/><verse number="16" style="v" sid="GEN 38:16"/>እንስ ኡቱ አከ እሼን ኒቲ እልመሳ ታቴ ህንቤክን ከራ ጭነ እዶ እሼን ጅርቱ እሼ ብረ ዸቄ፣ “ሜ ኮቱ ስ ወጅን ነንጪሳ” ጄዼን።</para>
  <para style="p" vid="GEN 38:16">እሼንስ፣ “አት ነ ወጅን ጪሱፍ ማል ና ኬንተ?” ጄቴ እሰ ጋፈቴ።<verse eid="GEN 38:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 38:17"/>እንሞ፣ “አን ቡሻዬኮ ኬሳ እልሞ ሬኤ ቶኮ ሲፍን ኤርገ” ጄዼን።</para>
  <para style="p" vid="GEN 38:17">እሼንስ፣ “ሀመ እልሞ ሰነ ና ኤርግቱት ዋን ብራ ቀብሲሰ ና ኬንታ?” ጄቴን።<verse eid="GEN 38:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 38:18"/>እንስ፣ “አን ቀብሲሰ ማልን ሲፍ ኬነ?” ጄዼን።</para>
  <para style="p" vid="GEN 38:18">እሼንስ ዴብፍቴ፣ “ቻፓኬ ህዻሳ ወጅን፣ ኡሌ ቀበቴ ዴምቱስ ና ኬን” ጄቴን። እንስ ወንቶተ ከኔን ኬኔፊ እሼ ወጅን ጪሴ፤ እሼንስ ንኡልፎፍቴ። <verse eid="GEN 38:18"/><verse number="19" style="v" sid="GEN 38:19"/>ኤርገ አቺ ዴምቴ ቦዴ ሀጉጊሼ ኦፍራ ባፍቴ ወያ ዽርስሼራ ዱናን ኡፈቴ ቱርቴ ሰነ ዴብፍቴ ኡፈቴ።<verse eid="GEN 38:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 38:20"/>ይሁዳን ዋን ቀብሲሰ ኬኔ ዱበርቲ ሰነራ ዴብፈቹፍ ጄዼ ከራ ምቹሳ ነምቸ አዱላም ሰናቲን እልሞ ሬኤ ኤርጌፍ፤ ነምች ገሩ እሼ ህንአርግኔ። <verse eid="GEN 38:20"/><verse number="21" style="v" sid="GEN 38:21"/>ነምችስ፣ “ሰጋገልቱን<note caller="+" style="f"><char style="fr" closed="false">38፥21 </char><char style="fq" closed="false">ሰጋገልቱን </char><char style="ft" closed="false">ዱበርቲ ዋቄፈትና ዋቀ ሶባቲፍ ጄቴ መነ ሰገዳ ኬሰት ጎቸ ሰጋገሉማ ሆጄቱዸ።</char></note> ኤናይም ብረ፣ ዳንዲረ ታኣ ቱርቴ ሱን ኤሰ ጅርት?” ጄዼ ወረ አች ጅራተን ጋፈቴ።</para>
  <para style="p" vid="GEN 38:21">ጀርሞ ዴብሰኒ፣ “ሰጋገልቱን ቶኮዩ አስ ህንቱሬ” ጄዸን።<verse eid="GEN 38:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 38:22"/>እንስ ገረ ይሁዳት ዴብኤ፣ “አን ዱበርትቲ አርጉ ህንደንዴኜ። አከሱመስ ወር እዶ ሰነ ጅራተን፣ ‘ሰጋገልቱን ቶኮዩ አስ ህንቱሬ’ ጄዸን” ጄዼን።<verse eid="GEN 38:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 38:23"/>ይሁዳንስ፣ “እሼን ዋን ቀበቴ ሰነ ሃሀምብፈቱ፤ ዮ ከና አቺ ኑ ዋን ኮልፋ ታና። ኩኖ አን እልሞ ሬኤ ከነ እሼፍ ኤርጌረ፤ አት ገሩ እሼ ዸብዴ” ጄዼ።<verse eid="GEN 38:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 38:24"/>ገረ ጅአ ሰዲ ቦዴ፣ “ታማር ኒቲን እልመኬቲ ሰጋገልቱ ታቴርት፤ ከናንስ እሼን አመ ኡልፎፍቴርት” ጄዸኒ ይሁዳት ህመን።</para>
  <para style="p" vid="GEN 38:24">ይሁዳንሞ፣ “ገድ ባሳቲ እብዳን ጉባ እሼ አጄሳ!” ጄዼ።<verse eid="GEN 38:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 38:25"/>እሼንስ ኡቱመ ገድ ባፈማ ጅርቱ፣ “አን አባ ምአ ከናራ ኡልፋኤረ” ጄቴ አባ ዽርሰሼት ኤርጋ ኤርግቴ። አከሱመስ፣ “ቻፓፊ ክሪንሳ፣ ኡሌን ኩንስ ከን ኤኙ አከ ተኤ ሜ እላሊ አዳን ባፈዹ” ጄቴን።<verse eid="GEN 38:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 38:26"/>ይሁዳንስ ምአ ከነ ቤኬ፣ “ሰበቢ አን እልመኮ ሼላት እሼ ህንሄሩምሲስኒፍ፣ እሼን ነ ጫላ ቀጄልቱዸ” ጄዼ። እንስ ዴብኤ እሼ ብረ ህንጌኜ።<verse eid="GEN 38:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 38:27"/>ዮሙ ዬሮን ደኡምሰሼ ገኤት፣ ኩኖ፣ እልማን ለኩቱ ገደሜሰሼ ኬሰ ቱሬ። <verse eid="GEN 38:27"/><verse number="28" style="v" sid="GEN 38:28"/>ኡቱ እሼን ደኡምሰረ ጅርቱ እን ቶኮ ሀርከሳ ገድ ባፈቴ፤ ዴስፍቱንስ ቀብዴ፣ “እሳ ከነቱ ዱረ ለፈ ገኤ” ጄቴ ክሪ ዲማ ሀርከሳት ሂቴ። <verse eid="GEN 38:28"/><verse number="29" style="v" sid="GEN 38:29"/>አኩመ እን ሀርከሳ ኦል ዴብፈቴን ኩኖ ኦቦሌስሳ ዸለቴ፤ ዴስፍቱንስ፣ “አት አከሚን ኦፉመኬቲን ጨብስቴ ባቴ?” ጄቴ። መቃንሳስ ፋሬስ ጄዸሜ። <verse eid="GEN 38:29"/><verse number="30" style="v" sid="GEN 38:30"/>ኦቦሌስሳ ከን ክሪ ዲማ ሀርከራ ቀቡ ሱንስ ንዸለቴ፤ እንስ ዛራ ጄዸሜ ሞጋፈሜ።<verse eid="GEN 38:30"/></para>
  <chapter eid="GEN 38"/>
  <chapter number="39" style="c" sid="GEN 39"/>
  <para style="s1">ዮሴፊፊ ኒቲ ጶጢፋራ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 39:1"/>ዬሮ ከነት ዮሴፍ ግብጥት ጌፈሜ ቱሬ። ጶጢፋራን ነምች ግብጥ ቆንዳል ፈረኦን ከን አጀጃ ዋርድያ ቱሬ ሱን እሽማኤሎተ አች እሰ ጌሰንራ እሰ ብተቴ።<verse eid="GEN 39:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 39:2"/>ዮሴፍስ ዋን <char style="nd">ዋቀዮ</char> እሰ ወጅን ቱሬፍ ነመ ምልካኣ ተኤ፤ እንስ መነ ጎፍታሳ ነምቸ ብየ ግብጥ ሰና ጅራቴ። <verse eid="GEN 39:2"/><verse number="3" style="v" sid="GEN 39:3"/>ጎፍታንሳስ አከ <char style="nd">ዋቀዮ</char> እሰ ወጅን ጅሩፊ አከ <char style="nd">ዋቀዮ</char> ዋን እን ሆጄቱ ሁንደ ኬሰት እሰ ምልኮምሴ አርጌ፤ <verse eid="GEN 39:3"/><verse number="4" style="v" sid="GEN 39:4"/>ዮሴፍስ ፉለ ጎፍታሳ ዱረት ፉዸተመ አርገቴ ሆጄታሳ አመነማ ተኤ። ጶጢፋራንስ መነሳረት እሰ ሙዴ፤ ዋን ቀቡ ሁንዱመስ አከ እን ኤጉፍ እማና እት ኬኔ። <verse eid="GEN 39:4"/><verse number="5" style="v" sid="GEN 39:5"/>ጋፈ እን መነሳቲፊ ዋን እን ቀቡ ሁንደረት እሰ ሙዴ ጀልቀቤ <char style="nd">ዋቀዮ</char> ሰበቢ ዮሴፊፍ ጄዼ መነ ነምቸ ግብጥ ሰና ኤብሴ። ኤብ <char style="nd">ዋቀዮስ</char> ዋን ጶጢፋራን መናፊ አላ ቀቡ ሁንደረ ቱሬ። <verse eid="GEN 39:5"/><verse number="6" style="v" sid="GEN 39:6"/>ከናፉ ጶጢፋራን ዋን ቀቡ ሁንደ ሀርከ ዮሴፍ ጀለ ገልቼ፤ እንስ ዋን ኛቱ ቆፈ መሌ ቀቤኘሳ ቶኮሌ ህንቤኩ ቱሬ።</para>
  <para style="p" vid="GEN 39:6">ዮሴፍ ዻበ ቶሌሳፊ ሚዸጋ ቱሬ፤ <verse eid="GEN 39:6"/><verse number="7" style="v" sid="GEN 39:7"/>ኒቲን ጎፍታሳስ ዋን ከነ ቦዴ እጀሼ ዮሴፍራ ቡፈቴ፣ “ኮቱ ነ ብረ ገእ!” ጄቴን።<verse eid="GEN 39:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 39:8"/>እን ገሩ ድዴ አከነ እሼን ጄዼ፤ “ኩኖ፣ ጎፍታንኮ ዋን መነ ኬሰ ጅሩ ቶኮሌ ህንቤኩ፤ እን ዋን ቀቡ ሁንደ ነት ኬኔረ። <verse eid="GEN 39:8"/><verse number="9" style="v" sid="GEN 39:9"/>መነ ከነ ኬሰት ነምን ነ ጫሉ ቶኮዩ ህንጅሩ። ሰበቢ አት ኒቲሳ ታቴፍ ስእ መሌ ወን ጎፍታንኮ ነት ህንኬንን ቶኮዩ ህንጅሩ። ዮስ አን አከምተን ዋን ሀማ አከሲ ራወቹዻን ዋቀት ጩቡ ሆጄዸሬ?” <verse eid="GEN 39:9"/><verse number="10" style="v" sid="GEN 39:10"/>እሼን ጉዩመ ጉያን ዮሴፍት ዱበቱዩ፣ እን እሼ ብረ ገኡ ዮካን እሼ ብረት አርገሙሌ ንድዴ።<verse eid="GEN 39:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 39:11"/>ጋፍ ቶኮ ዮሴፍ ሆጂሳ ሆጄቹፍ መነ ሴኔ፤ ተጃጅልቶተ ወረ መነ ሰና ኬሳስ ነምን ቶኮዩ አች ህንቱሬ። <verse eid="GEN 39:11"/><verse number="12" style="v" sid="GEN 39:12"/>እሼንስ ወያሳ ቀበቴ፣ “ኮቱቲ ነ ብረ ገእ!” ጄቴን። እን ገሩ ወያሳ እሼት ገድ ለክሴ ፊጌ መና በኤ።<verse eid="GEN 39:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 39:13"/>እሼንስ ዮሙ አከ እን ወያሳ እሼት ገድ ለክሴ ፊጌ መና በኤ አርግቴት፣ <verse eid="GEN 39:13"/><verse number="14" style="v" sid="GEN 39:14"/>ሆጄቶተ መነሼ ዋምቴ አከነ ጄቴን፤ “ኩኖ፣ እን እብርቸ ከነ አከ ኑት ተጰቱፍ ፍዴ! እን ነ ብረ ገኡፍ ነት ኦል ሴናን አን ሰገሌ ጉዳን እዬ። <verse eid="GEN 39:14"/><verse number="15" style="v" sid="GEN 39:15"/>እንስ ገርጋርሰ በርባቻፍዩኮ ዸጌኛን ወያሳ ነ ብረት ዺሴ ፊጌ መና በኤ።”<verse eid="GEN 39:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 39:16"/>እሼን ሀመ ጎፍታንሳ ገሉት ወያሳ ኦፍ ብረ ኬሴ። <verse eid="GEN 39:16"/><verse number="17" style="v" sid="GEN 39:17"/>አከነ ጄቴስ ኦዱ ከነ እሰት ህምቴ፦ “ገርብች እብርች አት ኑ ፍዴ ሱን ነት ተጰቹፍ ነት ኦል ሴኔ። <verse eid="GEN 39:17"/><verse number="18" style="v" sid="GEN 39:18"/>ገሩ አኩመ አን ገርጋርሰ በርባቻፍ እዬን እን ወያሳ ነ ብረት ዺሴ ፊጌ መና በኤ።”<verse eid="GEN 39:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 39:19"/>ጎፍታንሳ ዮሙ ኦዱ ኒቲንሳ፣ “ወን ገርብችኬ ነ ጎዼ ከነ” ጄቴ እት ህምቴ ሰነ ዸገኤት ኣሬ ጉበቴ። <verse eid="GEN 39:19"/><verse number="20" style="v" sid="GEN 39:20"/>ጎፍታንሳስ ዮሴፍን ፉዼ መነ ህዻ እዶ ህዸምቶትን ሞትቻ እት ኤገመን ኬሰ ቡሴ።</para>
  <para style="p" vid="GEN 39:20">ተኡስ ዬሮ ዮሴፍ መነ ህዻ ኬሰ ቱሬት፣ <verse eid="GEN 39:20"/><verse number="21" style="v" sid="GEN 39:21"/><char style="nd">ዋቀዮ</char> እሰ ወጅን ቱሬ፤ ፉለ አጀጃ መነ ህዻ ሰና ዱረትስ ጋሩማሳ እት አርግሲሴ፤ አከ ፉዸተመስ አርገቱ ጎዼ። <verse eid="GEN 39:21"/><verse number="22" style="v" sid="GEN 39:22"/>አጀጃን መነ ህዻ ሱንስ ነሞተ መነ ህዻ ጅረን ሁንደረት ዮሴፍን ሙዴ፤ ዋን አችት ሆጄተሙ ሁንደረትስ እት ጋፈተማ እሰ ጎዼ። <verse eid="GEN 39:22"/><verse number="23" style="v" sid="GEN 39:23"/>ሰበቢ <char style="nd">ዋቀዮ</char> እሰ ወጅን ቱሬፊ ዋን እን ሆጄቱ ከምዩ እሳ ምልኬሴፍ አጀጃን መነ ህዻ ሱን ዋን እት ጋፈተመ ዮሴፍ ጀለ ጅሩ ሁንዳፍ ያዶ ቶኮሌ ህንቀቡ ቱሬ።<verse eid="GEN 39:23"/></para>
  <chapter eid="GEN 39"/>
  <chapter number="40" style="c" sid="GEN 40"/>
  <para style="s1">ዮሴፍ አብጁ ሂኩሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 40:1"/>ከነ ቦዴ ነምች ሞቲ ግብጢቲፍ ዹጋቲ ዽኤሱፊ ነምች ቡዴነ ቶልቹ ጎፍታሳኒ ሞቲ ግብጥ ሰነ ገድሲሰን። <verse eid="GEN 40:1"/><verse number="2" style="v" sid="GEN 40:2"/>ፈረኦንስ ቆንዳልቶተሳ ለማንት ጄቹንስ እት ጋፈተማ ዹጋቲቲፊ እት ጋፈተማ ቶልቻ ቡዴናት ኣሬ፤ <verse eid="GEN 40:2"/><verse number="3" style="v" sid="GEN 40:3"/>እንስ መነ አጀጃ ዋርድያ ኬሰ መነ ህዻ እዶ ዮሴፍ እት ህዸሜ ቱሬ ኬሰ እሳን ቡሴ። <verse eid="GEN 40:3"/><verse number="4" style="v" sid="GEN 40:4"/>አጀጃን ዋርድያ ዮሴፍት እሳን ኬኔ፤ ዮሴፍስ እሳን ተጃጅላ ቱሬ።</para>
  <para style="p" vid="GEN 40:4">ጀርስ ጉያ ባይኤ መነ ህዻ ቱረን፤ <verse eid="GEN 40:4"/><verse number="5" style="v" sid="GEN 40:5"/>እሳን ለቸኑ ጄቹንስ ነምች ሞቲ ግብጢቲፍ ዹጋቲ ዽኤሱፊ ነምች ቡዴነ ቶልቹ ቶኮን ቶኮንሳኒ ሀልከኑመ ቶኮ ኬሰት አብጁ አብጆተን፤ ቶኮን ቶኮን አብጁ ሰናስ ሂካ መታሳ ቀበ ቱሬ።<verse eid="GEN 40:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 40:6"/>ዮሴፍ ጉያ እት ኣኑ ገነመ እሳን ብረ ዸቄ፤ ኩኖ ኡቱ ገደኒ ጅረኑስ እሳን አርጌ። <verse eid="GEN 40:6"/><verse number="7" style="v" sid="GEN 40:7"/>እንስ፣ “ፉልኬሰን ሀርአ ማሊፍ አከነ ዱከናአ?” ጄዼ ቆንዳልቶተ ፈረኦን ወረ እሰ ወጅን መነ ጎፍታሳ ኬሰ መነ ህዻ ቱረን ሰነ ጋፈቴ።<verse eid="GEN 40:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 40:8"/>እሳንስ፣ “ኑ ለቹ አብጁ አብጆትኔ ነመ ኑ ሂኩ ዸብኔ” ጄዸኒን።</para>
  <para style="p" vid="GEN 40:8">ከነረት ዮሴፍ፣ “ሂካን ከን ዋቃት ምቲ? ሜ አብጁኬሰን ነት ህማ” ጄዼን።<verse eid="GEN 40:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 40:9"/>እት ጋፈተማን ዹጋቲ ሱን አከነ ጄዼ አብጁሳ ዮሴፍት ህመቴ፤ “አብጁኮ ኬሰት ኩኖ ሙከ ወይኒ ቶኮቱ ፉለኮ ዱረ ቱሬ፤ <verse eid="GEN 40:9"/><verse number="10" style="v" sid="GEN 40:10"/>ሙክት ወይኒ ሱንስ ደሜ ሰዲ ቀበ ቱሬ። እንስ አኩመ ለቴን ደራሬ፤ ሁርቡን እጀሳስ ንብልቻቴ። <verse eid="GEN 40:10"/><verse number="11" style="v" sid="GEN 40:11"/>ጦፎን ፈረኦን ነ ሀርከ ቱሬ፤ አንስ እጀ ወይኒ ፉዼ ጦፎ ፈረኦንት ጩንፌ ጦፎ ሰነ ሀርከ ፈረኦንት ኬኔ።”<verse eid="GEN 40:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 40:12"/>ዮሴፍስ አከነ ጄዼን፤ “ሂካንሳ ከነ፤ ደሜወን ሰደን ሱን ጉያ ሰዲ። <verse eid="GEN 40:12"/><verse number="13" style="v" sid="GEN 40:13"/>ጉያ ሰዲ ኬሰት ፈረኦን መታኬ ኦል ቀበ፤ ታይታ ኬትስ ስ ዴብሰ፤ አኩመ ዬሮ ዹጋቲ ዽኤሳፊ ቱርቴ ሰነ አትስ ጦፎ ፈረኦን ሀርከሳት ንኬንተ። <verse eid="GEN 40:13"/><verse number="14" style="v" sid="GEN 40:14"/>ገሩ ዬሮ ስት ቶሉት ነ ያደዹ፤ ዋን ጋሪስ ና ጎዽ። ዋኤኮ ፈረኦንት ህሚቲ መነ ህዻ ከና ነ ባስ። <verse eid="GEN 40:14"/><verse number="15" style="v" sid="GEN 40:15"/>አነ ብየ እብሮታቲ ሀተኒ ነ ፍደኒቲ፤ ብየ ከነ ኬሰትስ አን ዋን ቦለ ከነ ኬሰ ነ ቡስሱ ቶኮሌ ህንሆጄትኔ።”<verse eid="GEN 40:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 40:16"/>እት ጋፈተማን ቡዴና ሱንስ ዮሙ አከ ዮሴፍ አብጁ ሰናፍ ሂካ ጋሪ ኬኔ አርጌት ዮሴፊን አከነ ጄዼ፤ “አንስ አብጁ ቶኮን አብጆዼ፤ ኩኖ ጉንዶወን ቡዴና ሰዲ መታኮረ ቱረን። <verse eid="GEN 40:16"/><verse number="17" style="v" sid="GEN 40:17"/>ጉንዶ ኦል ኣኑረ ቡዴነ ጎሰ ገራ ገራ ከን ፈረኦኒፍ ቆጴፈሜቱ ቱሬ፤ ገሩ ስምብሮትን መቱመኮረት ጉንዶ ሰነ ኬሳ ኛቻ ቱረን።”<verse eid="GEN 40:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 40:18"/>ዮሴፍሞ አከነ ጄዼ፤ “ሂካንሳ ከነ፤ ጉንዶወን ሰደን ሱን ጉያ ሰዲ። <verse eid="GEN 40:18"/><verse number="19" style="v" sid="GEN 40:19"/>ጉያ ሰዲ ኬሰት ፈረኦን መታኬ ኦል ቀበ፤ ሙከት ስ ረራሰ። ስምብሮትንስ ፎንኬ ንኛቱ።”<verse eid="GEN 40:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 40:20"/>ጉያን ሰደፋን ጉያ እት ፈረኦን ዸለቴ ቱሬ፤ ፈረኦንስ ቆንዳልቶተሳቲፍ ጭዸ ቆጴሴ። እንስ እት ጋፈተማ ዹጋቲቲፊ እት ጋፈተማ ቡዴና ሰነ ፉለ ቆንዳልቶተሳ ዱረት ዽኤሴ፦ <verse eid="GEN 40:20"/><verse number="21" style="v" sid="GEN 40:21"/>እት ጋፈተማ ዹጋቲ ሰነ ሆጂሳት ዴብሴ፤ ነምች ጦፎ ሰነ አመስ ሀርከ ፈረኦንት ኬኔ። <verse eid="GEN 40:21"/><verse number="22" style="v" sid="GEN 40:22"/>እት ጋፈተማ ቡዴና ሰነ ገሩ አኩመ ዮሴፍ አብጁሳኒ ሂኬፍት ረራሴ።<verse eid="GEN 40:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 40:23"/>ተኡስ እት ጋፈተማን ዹጋቲ ሱን ዮሴፍን ንእራንፈቴ መሌ እሰ ህንያደትኔ።<verse eid="GEN 40:23"/></para>
  <chapter eid="GEN 40"/>
  <chapter number="41" style="c" sid="GEN 41"/>
  <para style="s1">አብጁ ፈረኦን</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 41:1"/>ኤርገ ወጋን ለመ ጉቱን ደርቤ ቦዴ ፈረኦን አብጁ ቶኮ አብጆቴ። ኩኖ እን ቀርቀረ ለገ አበያ ዻበቻ ቱሬ። <verse eid="GEN 41:1"/><verse number="2" style="v" sid="GEN 41:2"/>ኩኖ፣ ሳወን በበሬዶፊ ገገበቶትን ቶርበ ለገ አበያ ኬሳ ኦል በአን፤ እሳንስ ሸምበቆ ኬሰ ዼዳ ቱረን። <verse eid="GEN 41:2"/><verse number="3" style="v" sid="GEN 41:3"/>አመስ ኩኖ፣ ሳወን ፎፎክሶፊ ሁሁቀቶትን ከኔን ብራ ቶርበ ለገ አበያ ኬሳ ኦል በአኒ ሳወን ኤዴደ ለጋ ቱረን ሰነ ብረ ዸዻበተን። <verse eid="GEN 41:3"/><verse number="4" style="v" sid="GEN 41:4"/>ሳወን ፎፎክሶፊ ሁሁቀቶትን ሱንስ ሳወን በበሬዶፊ ገገበቶ ቶርበን ሰነ ኛተን። ፈረኦንስ ህርባ ደመቄ።<verse eid="GEN 41:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 41:5"/>አመስ ዴብኤ ረፌ አብጁ ለመፋ አብጆቴ፤ ኩኖ መታን ምዻኒ ቶርበ ምሴ ቶሌ ሶማ ቶኮረት ጉደቻ ቱሬ። <verse eid="GEN 41:5"/><verse number="6" style="v" sid="GEN 41:6"/>ኤርገሲሞ ኩኖ መታን ምዻን ቀቀንጨሮ ሆቦምቦሌቲ በኣ ቢፍቱቲን ጉበተኒ ቶርበ ብራ ብብቅለን። <verse eid="GEN 41:6"/><verse number="7" style="v" sid="GEN 41:7"/>መታን ምዻን ቀቀንጨሮ ሰናስ መታ ምሴ ቶሌ ቶርበን ሰነ ልልቅምሴ፤ ፈረኦንስ ህርባ ደመቄ፤ ኩኖ ወን ሱንስ አብጁ ቱሬ።<verse eid="GEN 41:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 41:8"/>ገነመ ሰነ ያድንሳ ንጄቀሜ፤ እን ነመ ኤርጌ ቶልፈቶታፊ ቤክቶተ ግብጥ ሁንደ ዋምስፈቴ። ፈረኦንስ አብጁሳ እሳንት ህሜ፤ ገሩ ነምን አብጁ ሰነ እሳፍ ሂኩ ደንደኡ ቶኮሌ ህንአርገምኔ።<verse eid="GEN 41:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 41:9"/>ኤርገሲ እት ጋፈተማን ዹጋቲ ሱን ፈረኦኒን አከነ ጄዼ፤ “አን ሀርአ በሌሳኮ ያደዼረ። <verse eid="GEN 41:9"/><verse number="10" style="v" sid="GEN 41:10"/>ዬሮ ቶኮ ፈረኦን ተጃጅልቶተሳት ኣሬ አናፊ እት ጋፈተማ ቡዴና ሰነ መነ አጀጃ ዋርድያ ኬሰት ህዼ። <verse eid="GEN 41:10"/><verse number="11" style="v" sid="GEN 41:11"/>ቶኮን ቶኮንኬኘ ሀልከኑመ ቶኮን አብጁ አብጆትኔ፤ ቶኮን ቶኮን አብጁ ሰናስ ሂካ መታሳ ቀበ ቱሬ። <verse eid="GEN 41:11"/><verse number="12" style="v" sid="GEN 41:12"/>እብርች ደርገጌስ ቶኮ ኑ ወጅን አች ቱሬ፤ እንስ ተጃጅላ አጀጃ ኤጉምሳ ቱሬ። ኑ አብጁኬኘ እት ህመናን እን ቶኮ ቶኮኬኛፍ አኩመ አብጁኬኛት ሂካሳ ኑት ህሜ። <verse eid="GEN 41:12"/><verse number="13" style="v" sid="GEN 41:13"/>አኩመ እን ኑ ሂኬ ሰነ ተኤ፤ አን እዶኮት ነንዴብኤ፤ ነምች ካንስ ንፈንፈሜ።”<verse eid="GEN 41:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 41:14"/>ፈረኦንስ ነመ ኤርጌ ዮሴፍን ዋምስሴ፤ ቦለ ህዻ ኬሳ ባሰኒስ ደፈኒ እሰ ፍደን። እንስ ሃደቴ ኡፈተሳስ ጌደረቴ ፉለ ፈረኦን ዱረት ዽኣቴ።<verse eid="GEN 41:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 41:15"/>ፈረኦንስ ዮሴፊን፣ “አን አብጁ አብጆዼን ቱሬ፤ ገሩ ነምን ቶኮዩ ና ሂኩ ህንደንዴኜ። አን አከ አት ዬሮ አብጁ ዸጌሱ ሂኩ ደንዴሱ ዸገኤረ” ጄዼ።<verse eid="GEN 41:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 41:16"/>ዮሴፍሞ፣ “አን ሂኩ ህንደንደኡ፤ ዋቅን ገሩ ፈረኦኒፍ ዴቢ ነጋ ንኬነ” ጄዼ ፈረኦኒፍ ዴብሴ።<verse eid="GEN 41:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 41:17"/>ፈረኦንስ ዮሴፊን አከነ ጄዼ፤ “አን አብጁኮቲን ቀርቀረ ለገ አበያረ ዻበቻን ቱሬ፤ <verse eid="GEN 41:17"/><verse number="18" style="v" sid="GEN 41:18"/>ኩኖ ሳወን ገገበቶፊ በበሬዶን ቶርበ ለግቸ ኬሳ ኦል በአኒ ሸምበቆ ኬሰ ዼዳ ቱረን። <verse eid="GEN 41:18"/><verse number="19" style="v" sid="GEN 41:19"/>እሳን ዱባንሞ ሳወን ሁሁቀቶ፣ ባይኤ ፎፎክሶፊ ቀቀሎን ብራ ቶርበ ኦል በአን፤ አን ተኩማ ሳወን ፎፎክሶ አከና ጉቱማ ብየ ግብጥ ኬሰት ህንአርግኔ። <verse eid="GEN 41:19"/><verse number="20" style="v" sid="GEN 41:20"/>ሳወን ሁሁቀቶፊ ፎፎክሶን ሱን ሳወን ገገበቶ ዱራን ኦል በአን ቶርበን ሰነ ኛተን። <verse eid="GEN 41:20"/><verse number="21" style="v" sid="GEN 41:21"/>ገሩ ኤርገ እሳን ኛተኒ ቦዴ ነምን ቶኮሌ አከ እሳን ሳወን ሰነ ኛተን ቤኩ ህንደንዴኜ፤ እሳን አኩመ ኡቱ ህንኛትኒን ዱረ ቱረን ሰነ ፎፎክሶ ቱረኒቲ። አንስ ህርባ ነንደመቄ።<verse eid="GEN 41:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 41:22"/>“አከሱመስ አን አብጁኮቲን መታ ምዻኒ ቶርበ ከን ምሴፊ ገጋሪ ሶማ ቶኮረት ጉደቻ ጅሩ ነንአርጌ። <verse eid="GEN 41:22"/><verse number="23" style="v" sid="GEN 41:23"/>እሳን ዱባንስ ኩኖ መታን ምዻኒ ጮጮለጋን፣ ቀቀላን ከን ሆቦምቦሌቲ በአ ቢፍቱቲን ጉበቴ ቶርበ ኦል በኤ። <verse eid="GEN 41:23"/><verse number="24" style="v" sid="GEN 41:24"/>መታወን ምዻኒ ቀቀልኣን ሱን መታ ምዻኒ ገጋሪ ቶርበን ሰነ ልቅምሰን፤ አንስ ዋን ከነ ቶልችቶተት ነንህሜ፤ ገሩ ነምን ቶኮዩ ና እብሱ ህንደንዴኜ።”<verse eid="GEN 41:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 41:25"/>ዮሴፍሞ ፈረኦኒን አከነ ጄዼ፤ “አብጁን ፈረኦን ለማኑ ቶኩመ። ዋቅን ዋን ሆጄቹፍ ጅሩ ፈረኦንት ሙልእሴረ። <verse eid="GEN 41:25"/><verse number="26" style="v" sid="GEN 41:26"/>ሳወን በበሬዶን ቶርበ ወጋ ቶርበ፤ መታወን ምዻኒ ገጋሪ ቶርበስ ወጋ ቶርበ፤ አብጁን ሱን ቶኩመ። <verse eid="GEN 41:26"/><verse number="27" style="v" sid="GEN 41:27"/>ሳወን ቀቀሎፊ ፎፎክሶን ቶርበን ዱባን ኦል በአንስ ወጋ ቶርበ፤ መታወን ምዻኒ ቀቀንጨሮን ሆቦምቦሌቲ በአ ቢፍቱቲን ጉበተን ቶርበንሞ ወጎተ ቤላ ቶርበ።<verse eid="GEN 41:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 41:28"/>“ወን ኩን አኩመ አን ፈረኦንት ህሜዸ። ዋቅን ዋን ሆጄቹፍ ጅሩ ፈረኦንት አርግሲሴረ። <verse eid="GEN 41:28"/><verse number="29" style="v" sid="GEN 41:29"/>በር ቁፋ ጉዳንሳ ቶርበ ብየ ግብጥ ጉቱት ንዹፈ፤ <verse eid="GEN 41:29"/><verse number="30" style="v" sid="GEN 41:30"/>እሳን ቦዴዻን ገሩ ወጎትን ቤላ ቶርበ ንዹፉ። ቁፍን ብየ ግብጥ ሁንድ ንእራንፈተመ፤ ቤል ሱንስ ብየ በሌሰ። <verse eid="GEN 41:30"/><verse number="31" style="v" sid="GEN 41:31"/>ዋን ቤል ዱባን ዹፉ ሱን ባይኤ ሀማ ተኡፍ ቁፍን ብየቲ ህንያደተሙ። <verse eid="GEN 41:31"/><verse number="32" style="v" sid="GEN 41:32"/>አብጁን ኩን ብፈ ለማን ፈረኦንት ኬነሙንሳ ዋን ዱብች ዋቃን ሙርቴፈሜፍዸ፤ ዋቅንስ ዋን ከነ ደፌ ንራወተ።<verse eid="GEN 41:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 41:33"/>“ከናፉ ፈረኦን ነመ ሁበታፊ ቤካ ቶኮ ፍለቴ ብየ ግብጥረት ሃሙዱ። <verse eid="GEN 41:33"/><verse number="34" style="v" sid="GEN 41:34"/>ፈረኦን አከ እሳን ወጎተ ቁፋ ቶርበን ኬሰ ምዻን ብየ ግብጢቲ ገልፈሙ ሀርከ ሸን ኬሳ ሀርከ ቶኮ ወልት ቀበኒፍ ቆንዳልቶተ ብየረት ሃሙዱ። <verse eid="GEN 41:34"/><verse number="35" style="v" sid="GEN 41:35"/>እሳንስ ወጎተ ጋሪ ዹፉፍ ጅረን ከነ ኬሰ ምዻን ሁንደ ወልት ሃቀበን፤ አከ ኛታፍ ተኡፍስ ምዻን ከነ ታይታ ፈረኦን ጀለት መጋላወን ኬሰት ሃኩሰን፤ ሃኤገንስ። <verse eid="GEN 41:35"/><verse number="36" style="v" sid="GEN 41:36"/>ምዻን ኩንስ አከ ብየቲን ቤላን ህንበድኔፍ ወጎተ ቤላ ቶርበን ግብጥት ዹፉፍ ጅሩ ኬሰ አከ ፈየዱፍ ብየቲዻፍ ኦል ሃካአሙ።”<verse eid="GEN 41:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 41:37"/>ዱብችስ ፈረኦኒፊ ቆንዳልቶተሳ ሁንደ ብረት ጋሪ ቱሬ። <verse eid="GEN 41:37"/><verse number="38" style="v" sid="GEN 41:38"/>ፈረኦንስ፣ “ነመ አከ ነምቸ ከና ከን ሀፉር ዋቃ ኬሰ ጅሩ አርገቹ ደንዴኛሬ?” ጄዼ እሳን ጋፈቴ።<verse eid="GEN 41:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 41:39"/>ፈረኦንስ ዮሴፊን አከነ ጄዼ፤ “ኤርገ ዋቅን ዋን ከነ ሁንደ ስት ሙልእሴ፣ ነምን አከኬ ሁበታፊ ቤካ ተኤ ቶኮዩ ህንጅሩ። <verse eid="GEN 41:39"/><verse number="40" style="v" sid="GEN 41:40"/>አት መሰራኮረት እት ጋፈተማ ታተ፤ ሰብንኮ ሁንድኑስ አጀጀኬ ጀለት ቡለ። አን ኡልፍነ ቴሶ ቆፋን ስ ጫለ።”<verse eid="GEN 41:40"/></para>
  <para style="s1">ዮሴፍ ግብጥረት ሙደሜ</para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 41:41"/>ፈረኦንስ ዮሴፊን፣ “እላ፣ አን ብየ ግብጥ ሁንደረት ስ ሙዴረ” ጄዼ። <verse eid="GEN 41:41"/><verse number="42" style="v" sid="GEN 41:42"/>ኤርገሲ ፈረኦን ቁቤላ ቻፓሳ ቁበሳራ ባሴ ቁበ ዮሴፍት ካኤ። ኡፈተ ቁንጬ ተልባ ሀጲራ ሆጄተሜ እሰት ኡፍሴ፤ አመርቲ ወርቄ ሞርመሳት ካኤ። <verse eid="GEN 41:42"/><verse number="43" style="v" sid="GEN 41:43"/>እንስ ጋሪሳ እሰ ለመፋረ እሰ ቴስሴ፤ ነሞትንስ፣ “ሰገዳ!” ጄቻ ፉለሳ ዱረ ዴመኒ እያ ቱረን፤ አከናን ፈረኦን ብየ ግብጥ ሁንደረት እሰ ሙዴ።<verse eid="GEN 41:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="GEN 41:44"/>ኤርገሲስ ፈረኦን ዮሴፊን፣ “አን ፈረኦኒዸ፤ ገሩ አጀጀኬ መሌ ነምን ጉቱማ ግብጥ ሀርከሳ ዮካን ሚለሳ ሶቾሱ ቶኮዩ ህንጅሩ” ጄዼ። <verse eid="GEN 41:44"/><verse number="45" style="v" sid="GEN 41:45"/>ፈረኦንስ ዮሴፊፍ መቃ ዛፌናት-ጰኔኣ ጄዸሙ ባሴ፤ እንተለ ጶጢፌራ ሉብቸ መጋላ ኦን ከን ኣሴነት ጄዸምቱሌ እት ሄሩምሲሴ። ዮሴፍስ ብየ ግብጥ ሁንደ ኬሰ ናነኤ።<verse eid="GEN 41:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 41:46"/>ዮሴፍ ዬሮ ተጃጅለ ፈረኦን ሞትቸ ግብጥ ጀልቀቤት ነመ ወጋ ሶዶማ ቱሬ፤ እንስ ፉለ ፈረኦን ዱራ በኤ ዴሜ ብየ ግብጥ ሁንደ ኬሰ ነናነኤ። <verse eid="GEN 41:46"/><verse number="47" style="v" sid="GEN 41:47"/>ወጎተ ቁፋ ቶርበን ሰነ ኬሰ ለፍት ምዻን አከ መሌ ባይአቱ ኬንቴ። <verse eid="GEN 41:47"/><verse number="48" style="v" sid="GEN 41:48"/>ዮሴፍስ ምዻን ወጎተ ቶርበን ሰነ ኬሰ ግብጢ ገልፈሜ ሁንደ ወልት ቀቤ መጋላወን ኬሰት ኩሴ። ምዻን ለፈ ቆቲሳ ናኖ መጋላስ ቶኮ ቶኮ መጋላ ሰና ኬሰት ኩሴ። <verse eid="GEN 41:48"/><verse number="49" style="v" sid="GEN 41:49"/>ዮሴፍስ ምዻን ባይእንሳ ጉዳ አከ ጭረቸ ገላና ተኤ ኩሴ። ዋን ምዻን ሱን ሰፈረሙ ህንደንደአምኒፍ እን ሰፈሩ ዺሴ።<verse eid="GEN 41:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 41:50"/>ዮሴፍ ኡቱ ወጎትን ቤላ ሱን ህንዹፍን ዱረ ኣሴነት እንተለ ጶጢፌራ ሉብቸ መጋላ ኦንራ እልማን ለመ ዸልቼ። <verse eid="GEN 41:50"/><verse number="51" style="v" sid="GEN 41:51"/>ዮሴፍስ፣ “ዋቅን ረክነኮ ሁንዳፊ መነ አባኮ ሁንደ ነ እራንፈቺሴረ” ጄዼ መቃ እልመሳ ሀንገፍትቻ ምናሴ ጄዼ ሞጋሴ። <verse eid="GEN 41:51"/><verse number="52" style="v" sid="GEN 41:52"/>“ዋቅን ብየ አን እት ረከዼ ኬሰት ነ ባይእሴረ” ጄዼ እልመሳ እሰ ለመፋሞ ኤፍሬም ጄዼ ሞጋሴ።<verse eid="GEN 41:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="GEN 41:53"/>ግብጥ ኬሰት ወጎትን ቁፋ ቶርበን ሱን ደርቤ፣ <verse eid="GEN 41:53"/><verse number="54" style="v" sid="GEN 41:54"/>አኩመ ዮሴፍ ዱበቴ ሰነ ወጎትን ቤላ ቶርበ ጀልቀቤ። ብዮተ ብራ ሁንደ ኬሰ ቤለቱ ቱሬ፤ ብየ ግብጥ ጉቱ ኬሰ ገሩ ምዻንቱ ቱሬ። <verse eid="GEN 41:54"/><verse number="55" style="v" sid="GEN 41:55"/>ዬሮ ግብጥ ጉቱን ቤለኡ ጀልቀቤት ነሞትን ምዻን በርባደኒ ፈረኦንት እየተን፤ ፈረኦንሞ ወረ ግብጥ ሁንዱማን፣ “ዮሴፍ ብረ ዸቃቲ ዋን እን እስንት ህሙ ጎዻ” ጄዼ።<verse eid="GEN 41:55"/></para>
  <para style="p">
    <verse number="56" style="v" sid="GEN 41:56"/>ቤል ጉቱማ ብየቲ ኬሰ በበልአትናን ዮሴፍ መንኩሳሌ ሁንዱማ በኔ ነሞተ ግብጥት ምዻን ጉርጉሬ፤ ቤል ግብጥ ሁንደ ኬሰት ሀማቴ ቱሬቲ። <verse eid="GEN 41:56"/><verse number="57" style="v" sid="GEN 41:57"/>ዋን ጉቱ አዱኛረት ቤል ሀማቴፍ ብዮትን ሁንድኑ ዮሴፍራ ምዻን ብተቹፍ ገረ ግብጥ ዹፋ ቱረን።<verse eid="GEN 41:57"/></para>
  <chapter eid="GEN 41"/>
  <chapter number="42" style="c" sid="GEN 42"/>
  <para style="s1">ኦቦሎትን ዮሴፍ ግብጥ ዸቀን</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 42:1"/>ያቆብ ዮሙ አከ ግብጥ ኬሰ ምዻን ጅሩ ዸገኤት፣ እልማንሳቲን፣ “እስን ማሊፍ ወል እላልቱ?” ጄዼ። <verse eid="GEN 42:1"/><verse number="2" style="v" sid="GEN 42:2"/>እት ፉፌስ፣ “ኩኖ አን አከ ግብጥ ኬሰ ምዻን ጅሩ ዸገኤረ። አከ ኑ ዱአ ጀላ ባኔ ጅራኑፍ ገድ ቡኣቲ አቺ ምዻን ኑ ብታ” ጄዼ።<verse eid="GEN 42:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 42:3"/>ኦቦሎተ ዮሴፍ ኬሳ ኩዸን ግብጥ ኬሳ ምዻን ብቱፍ ገድ ቡአን። <verse eid="GEN 42:3"/><verse number="4" style="v" sid="GEN 42:4"/>ያቆብ ገሩ በላቱ እሰረ ገአ ጄዼ ዋን ሶዳቴፍ ኦቦሌሰ ዮሴፍ ቤንያምን እሳን ወጅን ህንኤርግኔ። <verse eid="GEN 42:4"/><verse number="5" style="v" sid="GEN 42:5"/>ቤል ብየ ከነኣን ኬሰ ዋን ቱሬፍ እልማን እስራኤልስ ወረ ምዻን ብተቹ ዸቀን ወጅን ዴመን።<verse eid="GEN 42:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 42:6"/>ዮሴፍስ ቡልቻ ብየቲ ከን ኡመተ ብየቲ ሁንደት ምዻን ጉርጉሩ ቱሬ። ኦቦሎትን ዮሴፍስ ዮሙ አች ገአንት ፉለሳኒቲን ለፈት ጎምብፈመኒ ሰገደኒፍ። <verse eid="GEN 42:6"/><verse number="7" style="v" sid="GEN 42:7"/>ዮሴፍ አኩመ ኦቦሎተሳ አርጌን እሳን ቤኬ፤ ገሩ አኩመ ነመ እሳን ህንቤክኔት አፋን ሀማ እሳንት ዱበቴ፣ “እስን ኤሳ ዹፍተን?” ጄዼ እሳን ጋፈቴ።</para>
  <para style="p" vid="GEN 42:7">ጀርስ፣ “ምዻን ብተቹፍ ጄኔ ከነኣኒ ዹፍኔ” ጄዸኒ ዴብሰን።<verse eid="GEN 42:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 42:8"/>ዮ ዮሴፍ ኦቦሎተሳ ቤኬዩ ጀር እሰ ህንቤክኔ። <verse eid="GEN 42:8"/><verse number="9" style="v" sid="GEN 42:9"/>እንስ አብጁ ዋኤሳኒ አብጆቴ ሰነ ያደቴ፣ “እስን በሳስቶተ ደዸቢ ብየቲ በሳሱፍ ዹፍተኒዸ!” ጄዼን።<verse eid="GEN 42:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 42:10"/>እሳንሞ አከነ ጄዸኒ ዴብሰን፤ “ያ ጎፍታ አከስ ምት፤ ኑ ገርቦንኬ ምዻን ብተቹ ዹፍኔ። <verse eid="GEN 42:10"/><verse number="11" style="v" sid="GEN 42:11"/>ኑ ሁንድ እልማን አባ ቶኮት፤ ኑ ገርቦንኬ ነሞተ አመነሞዸ መሌ በሳስቶተ ምት።”<verse eid="GEN 42:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 42:12"/>እንስ፣ “አከስ ምት፤ እስን ደዸቢ ብየቲ በሳሱ ዹፍተን” ጄዼን።<verse eid="GEN 42:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 42:13"/>እሳን ገሩ አከነ ጄዸኒ ዴብሰን፤ “ኑ ገርቦንኬ ኦቦሎተ ኩዸ ለመ፣ እልማኑመ አባ ቶኮ ከን ብየ ከነኣን ጅራቱት። ኩኖ ቁጥሱን ሁንደኬኛ አመ አባኬኘ ብረ ጅረ፤ እን ቶኮ ገሩ ህንጅሩ።”<verse eid="GEN 42:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 42:14"/>ዮሴፍ ገሩ አከነ ጄዼን፤ “አኩመ አን እስኒን ጄዼ ሰነ እስን በሳስቶተ! <verse eid="GEN 42:14"/><verse number="15" style="v" sid="GEN 42:15"/>አክ እስን እቲን ቆረምተን ከነ፤ አን መቃ ፈረኦኒን ነንከከዸ፤ ዮ ኦቦሌስኬሰን ቁጥሱን ሱን አስ ዹፌ መሌ እስን አሲ ህንሶቾተን። <verse eid="GEN 42:15"/><verse number="16" style="v" sid="GEN 42:16"/>አከ እን ዸቄ ኦቦሌሰኬሰን ፍዱፍ ኦፍ ኬሳ ነመ ቶኮ ኤርጋ፤ እስን ወር ሀፍተንሞ መነ ህዻት ገልፈምቱ፤ አከሲንስ ዱቢንኬሰን ቆረተሜ አከ ዹጋ ተኤፊ አከ ዹጋ ህንተእን ንእላለመ፤ ዮ ከና አቺ፣ አን መቃ ፈረኦኒን ነንከከዸ፤ እስን ዹጉማን በሳስቶተ!” <verse eid="GEN 42:16"/><verse number="17" style="v" sid="GEN 42:17"/>እንስ ሁንደሳኒ ጉያ ሰዲ መነ ህዻ ኬሰ ቱርሴ።<verse eid="GEN 42:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 42:18"/>ጉያ ሰደፋት ዮሴፍ አከነ እሳኒን ጄዼ፤ “እስን ዋን ከነ ጎዻ፤ ንጅራቱ፤ አን ዋቀ ነንሶዳዻቲ። <verse eid="GEN 42:18"/><verse number="19" style="v" sid="GEN 42:19"/>እስን ዮ ነሞተ አመነሞ ታተን ኦቦሎተኬሰን ኬሳ ቶኮ አስ መነ ህዻ ሃቱሩ፤ ወር ካን ገሩ ዴማ፤ ማቲኬሰን ከኔን ቤለአኒፍ ምዻን ጌሳ። <verse eid="GEN 42:19"/><verse number="20" style="v" sid="GEN 42:20"/>ገሩ ኦቦሌሰኬሰን ቁጥሱ ና ፍዳ፤ አከሲን ዱቢንኬሰን ንምርከኔፈመ፤ እስንስ ህንዱተን።” እሳንስ አከሱመ ጎዸን።<verse eid="GEN 42:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 42:21"/>እሳንስ አከነ ወሊን ጄዸን፤ “ኑ ዹጉማን ሰበቢ ኦቦሌሰኬኛቲፍ አደበማ ጅረ። ዬሮ እን ኑ ከዸቴት ሉቡንሳ ሀመም አከ ዽጰቻ ቱርቴ አርግኔረ፤ ኑ ገሩ እሰ ዸገኡ ድድኔ፤ ዽጵን ኩን ከናፍ ኑት ዹፌ።”<verse eid="GEN 42:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 42:22"/>ሩቤንሞ፣ “አን፣ ‘ጉርባ ከነ ህንሚዽና’ ጄዼ እስንት ህንህምኔ? እስን ገሩ ነ ዸገኡ ድደን! ኩኖ ኑ ዺገሳት ንጋፈተምነ” ጄዼ። <verse eid="GEN 42:22"/><verse number="23" style="v" sid="GEN 42:23"/>ሰበቢ ዮሴፍ ከራ ነመ አፋን ሂኩቲን እሳንት ዱበቻ ቱሬፍ እሳን አከ እን ዋን እሳን ዱበተን ሁበቱ ህንቤክኔ።<verse eid="GEN 42:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 42:24"/>ዮሴፍ አች እሳንራ ገረገሌ ቦኡ ጀልቀቤ፤ ኤርገሲሞ እሳንት ገረገሌ እሳንት ዱበቴ። ስምኦንንስ እሳን ኬሳ ባስሴ ፉሉመሳኒ ዱረት ሂስሴ።<verse eid="GEN 42:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 42:25"/>ዮሴፍ አከ ቀልቀሎሳኒት ምዻን ጉተኒፍ፣ አከ ሜቲ ቶኮ ቶኮሳኒ ዴብሰኒ ቀልቀሎሳኒ ኬሰ እሳኒፍ ካአኒፊ አከ ከራሳኒቲፍ ገላ እሳኒፍ ኬነን አጀጄ። ኤርገ ወን ኩን እሳኒፍ ጎዸሜ ቦዴ <verse eid="GEN 42:25"/><verse number="26" style="v" sid="GEN 42:26"/>ጀር ምዻንሳኒ ሀሮተሳኒት ፌአተኒ ቀጄለን።<verse eid="GEN 42:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 42:27"/>እሳን ኬሳ እን ቶኮ እዶ ቡለንት ሀሬሳቲፍ ኛተ ኬኑፍ ጄዼ ቀልቀሎሳ በኔ፤ ኩኖ አፋን ቀልቀሎ ኬሰትስ ሜቲሳ አርገቴ። <verse eid="GEN 42:27"/><verse number="28" style="v" sid="GEN 42:28"/>እንስ ኦቦሎተሳቲን፣ “ሜቲንኮ ና ዴብኤረ፤ ኩኖ ቀልቀሎኮ ኬሰ ጅረ” ጄዼ።</para>
  <para style="p" vid="GEN 42:28">ከነረት እሳን ነአኒ ወልት ገረ ገለኒ ሆለቻ፣ “ወን ዋቅን ኑት ሆጄቴ ኩን ማል?” ጄዸን።<verse eid="GEN 42:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 42:29"/>እሳንስ ገረ ብየ ከነኣን አባሳኒ ያቆብ ብረ ዹፈኒ ዋን እሳንረ ገኤ ሁንደ እሰት ህመን፤ አከነስ ጄዸን፤ <verse eid="GEN 42:29"/><verse number="30" style="v" sid="GEN 42:30"/>“ነምች ጎፍታ ብየ ሰና ተኤ አፋን ሀማ ኑት ዱበቴ አከ ዋን ኑ ብየቲ በሳሱ ዸቅኔት ኑ ለካኤ። <verse eid="GEN 42:30"/><verse number="31" style="v" sid="GEN 42:31"/>ኑ ገሩ አከነ ጄኔን፤ ‘ኑ ነሞተ አመነሞዸ መሌ በሳስቶተ ምት። <verse eid="GEN 42:31"/><verse number="32" style="v" sid="GEN 42:32"/>ኑ ኦቦሎተ ኩዸ ለመ እልማኑመ አባ ቶኮት፤ እን ቶኮ ህንጅሩ፤ ቁጥሱን ሁንደኬኛሞ አባኬኘ ብረ ብየ ከነኣን ጅረ።’<verse eid="GEN 42:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 42:33"/>“ነምች ጎፍታ ብየ ሰና ተኤሞ አከነ ኑን ጄዼ፤ ‘አክ አን አከ እስን ነሞተ አመነሞ ታተኒፊ ህንተእን እቲን ቤኩ ከነ፤ ኦቦሎተኬሰን ኬሳ እሰ ቶኮ አስ ነ ብረት ዺሳቲ ማቲኬሰን ከን ቤለአኒፍ ምዻን ጌሳ። <verse eid="GEN 42:33"/><verse number="34" style="v" sid="GEN 42:34"/>ገሩ አከ አን አከ እስን ነሞተ አመነሞ መሌ በሳስቶተ ህንተእን ቤኩፍ ኦቦሌሰኬሰን እሰ ቁጥሱ ሰነ ና ፍዳ። ኤርገሲ አን ኦቦሌሰኬሰን ዴብሴ እስኒ ኬነ፤ እስንስ ብየ ከነ ኬሰት ደልደለቹ ንደንዴሱ።’ ”<verse eid="GEN 42:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 42:35"/>ዮሙ እሳን ቀልቀሎሳኒ ኬሳ ምዻን ገረገልቸንት፣ ኩኖ ሜቲን ቶኮ ቶኮሳኒ ህዻ ህዻን ቀልቀሎሳኒ ኬሰ ቱሬ። እሳኒፊ አባንሳኒ ዬሮ ሜቲ ህዸሜ ሰነ አርገንት ንርፈተን። <verse eid="GEN 42:35"/><verse number="36" style="v" sid="GEN 42:36"/>አባንሳኒ ያቆብስ፣ “እስን እጆሌኮ ነ ዸብሲፍተን። ዮሴፍ ህንጅሩ፤ ስምኦንስ ህንጅሩ። አመሞ ቤንያምን ፉዸቹ በርባዱ። ወን ሁንድ ነት ሀማቴረ!” ጄዼን።<verse eid="GEN 42:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 42:37"/>ሩቤንሞ አባሳቲን፣ “ዮ አን ዴብሴ እሰ ሲፍ ፍዱ ባዼ እልማንኮ ለማን አጄሱ ንደንዴሰ፤ እሰ እማና ነት ኬን፤ አን ዴብሴ እሰ ነንፍደ” ጄዼ።<verse eid="GEN 42:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 42:38"/>ያቆብ ገሩ አከነ ጄዼ፤ “እልምኮ እስን ወጅን አች ገድ ህንቡኡ፤ ኦቦሌስሳ ዱኤረ፤ እሰ ቆፈቱ ሀፌ። ዮ ከራኬሰንረት በላን እሰረ ገኤ፣ እስን አከ አሪንኮ ገዳን አዋለ ሴኑ ጎቱ።”<verse eid="GEN 42:38"/></para>
  <chapter eid="GEN 42"/>
  <chapter number="43" style="c" sid="GEN 43"/>
  <para style="s1">ኦቦሎትን ዮሴፍ ለመተ ግብጥት ዴብአን</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 43:1"/>አመሌ ቤል ብየቲት ባይኤ ሀማቴ ቱሬ። <verse eid="GEN 43:1"/><verse number="2" style="v" sid="GEN 43:2"/>ኤርገ እሳን ምዻን ብየ ግብጢቲ ፍደን ሰነ ኛተኒ ፍጠኒ ቦዴ አባንሳኒ፣ “አመስ ዸቃቲ ምዻን ጥኖ ደበላ ኑ ብታ” ጄዼን።<verse eid="GEN 43:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 43:3"/>ይሁዳንሞ አከነ እሳን ጄዼ፤ “ነምች ሱን፣ ‘ዮ ኦቦሌስኬሰን እስን ወጅን ዹፌ መሌ እስን ለመተ እጀኮ ህንአርግተን’ ጄዼ ኦፍ ኤገኖ ጭማ ኑ ኬኔ። <verse eid="GEN 43:3"/><verse number="4" style="v" sid="GEN 43:4"/>ዮ አት ኦቦሌሰኬኘ ኑ ወጅን ኤርግቴ ኑ ዸቅኔ ምዻን ሲፍ ብትነ። <verse eid="GEN 43:4"/><verse number="5" style="v" sid="GEN 43:5"/>ሰበቢ ነምች ሱን፣ ‘ዮ ኦቦሌስኬሰን እስን ወጅን ዹፌ መሌ እስን ለመተ እጀኮ ህንአርግተን’ ኑን ጄዼፍ፣ ዮ አት እሰ ኤርግቴ መሌ ኑ ገድ ህንቡኑ።”<verse eid="GEN 43:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 43:6"/>እስራኤልሞ፣ “እስን ማሊፍ አከ ኦቦሌሰ ብራ ቀብደን ነምቸት ህሙዻን ረክነ ነት ፍደን?” ጄዼ ጋፈቴ።<verse eid="GEN 43:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 43:7"/>እሳንስ አከነ ጄዸኒ ዴብሰን፤ “ነምች ዋኤ መታኬኛቲፊ ዋኤ ማቲኬኛ ጀቤሴ ኑ ጋፈቴ። እንስ፣ ‘አባንኬሰን አመዩ ጅራ? ኦቦሌሰ ብራ ቀብዱ?’ ጄዼ ኑ ጋፈቴ፤ ኑ ጋፊዹመሳ ዴብፍኔፍ። ዮስ አከ እን፣ ‘ኦቦሌሰኬሰን አስ ፍዳ’ ኑን ጄዹ አከሚን ቤኩ ደንዴኘሬ?”<verse eid="GEN 43:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 43:8"/>ይሁዳንስ አባሳ እስራኤሊን አከነ ጄዼ፤ “አከ ኑ፣ አቲፊ እጆሌንኬኘ ዱአ ጀላ ባኔ ጅራኑፍ ጉርብቸ ነ ወጅን ኤርግ፤ ኑ ካኔ ዴምናቲ። <verse eid="GEN 43:8"/><verse number="9" style="v" sid="GEN 43:9"/>አን ወቢ እሳፍን ተአ፤ ዋኤሳስ አኑመ መታኮ ጋፈቹ ንደንዴሰ። ዮ አን ዴብሴ እሰ ሲፍ ፍዴ ፉለኬ ዱረ ዻቡ ባዼ፣ አን በረ ጅሬኘኮ ጉቱ ፉለኬ ዱረት በሌሳ ከነት ነንጋፈተመ። <verse eid="GEN 43:9"/><verse number="10" style="v" sid="GEN 43:10"/>ኡቱ ቱሩ ባትኔ ስላ ዮነ ዬሮ ለመ ዸቅኔ ዴብኔረ ቱሬ።”<verse eid="GEN 43:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 43:11"/>ከነረት አባንሳኒ እስራኤል አከነ እሳኒን ጄዼ፤ “ኤርገ አከስ ተኤ ዋን ከነ ጎዻ፤ ኦምሸ ብየ ከና ፍለተማ ኬሳ ኬና ቶኮ ቶኮ ጄቹንስ ሀጴ ድበተን ጥኖሼ፣ ደመ ጥናሳ፣ ኡርጎፍቱፊ ቁምቢ ጥኖሼ፣ ኦቾሎኒፊ ለዉዚ ጥኖሼ ጌሳቲ ነምቻፍ ኬና። <verse eid="GEN 43:11"/><verse number="12" style="v" sid="GEN 43:12"/>እስን ዋን ሜቲ አፋን ቀልቀሎኬሰኒ ኬሰ ካአሜ እስኒ ዴብኤ ሰነ ዴብሱ ቀብደኒፍ ሜቲ ሰነ ሀርከ ለመ ፉዸዻቲ ዴማ፤ ሜቲን ሱን ዶጎጎራን ዹፌ ተኣቲ። <verse eid="GEN 43:12"/><verse number="13" style="v" sid="GEN 43:13"/>ኦቦሌሰኬሰንስ ፉዸዻቲ ደፋ ገረ ነምቻት ዴብኣ። <verse eid="GEN 43:13"/><verse number="14" style="v" sid="GEN 43:14"/>አከ እን ኦቦሌሰኬሰን ካኒፊ ቤንያምሌ እስን ወጅን ዴብሴ ኤርጉፍ ዋቅን ዋን ሁንደ ደንደኡ አከ ነምች ገራ እስኒ ላፉ ሃጎዹ። አን ዮ እጆሌ ዸቤሌ እጆሌ ነንዸበ።”<verse eid="GEN 43:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 43:15"/>ነሞትን ሱንስ ኬናወን ሰነ፣ ሜቲ ሰነ ሀርከ ለማፊ ቤንያምንስ ፉዸተኒ አሪቲዻን ግብጥት ገድ ቡአኒ ፉለ ዮሴፍ ዱረ ዸዻበተን። <verse eid="GEN 43:15"/><verse number="16" style="v" sid="GEN 43:16"/>ዮሴፍስ ዮሙ ቤንያምን እሳን ብረት አርጌት ሀንገፈ ሆጄቶተ መነሳቲን፣ “ነሞተ ከነ መነኮት ጌስ፤ ሆሪ ቶኮ ቀሊ ኛተ ቆጴስ፤ እሳን ሰኣቲ ጀአት ነ ወጅን ኛቱቲ” ጄዼ።<verse eid="GEN 43:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 43:17"/>ነምች ሱንስ አኩመ ዮሴፍ እሰ አጀጄ ጎዼ፤ ጀረ ሰነስ መነ ዮሴፍት ጌሴ። <verse eid="GEN 43:17"/><verse number="18" style="v" sid="GEN 43:18"/>ነሞትን ሱን ዬሮ መነ ዮሴፍት ጌፈመንት ሶዳተኒ አከነ ጄዸን፤ “ኑ ሰበቢ ሜቲ ዬሮ ጀልቀባ ዴብኤ አፋን ቀልቀሎኬኛ ኬሰት አርገሜ ሰናቲፍ አስ ፍደምኔ፤ እን ኑ ሩኩቴ፣ ኑ ሞአቴ፣ አከ ገርቦታት ኑ ቀበቴ ሀሮተኬኘ ፉዸቹ በርባደ።”<verse eid="GEN 43:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 43:19"/>ከናፉ ጀር ገረ ሀንገፈ ሆጄቶተ ዮሴፍት ኦል በአኒ በልበለ መና ዱረት እት ዱበተን። <verse eid="GEN 43:19"/><verse number="20" style="v" sid="GEN 43:20"/>አከነስ ጄዸን፤ “ያ ጎፍታ፣ ኑ ዬሮ ጀልቀባ ምዻን ብተቹፍ አስ ገድ ቡኔ ቱሬ። <verse eid="GEN 43:20"/><verse number="21" style="v" sid="GEN 43:21"/>ኑስ ዬሮ እዶ ቡሉ ጌኜ ቀልቀሎኬኘ በኔት ቶኮን ቶኮንኬኘ አፋን ቀልቀሎኬኛ ኬሰት ሜቲኬኘ አኩመ ጅሩት አርገትኔ። ከናፉ ሜቲ ሰነ ዴብፍኔ ፍድኔ ዹፍኔረ። <verse eid="GEN 43:21"/><verse number="22" style="v" sid="GEN 43:22"/>ሜቲ ብራስ እቲን ምዻን ብተቹፍ ፍድኔ ዹፍኔረ። ኤኙ አከ ሜቲኬኘ ቀልቀሎኬኘ ኬሰ ኑ ካኤስ ህንቤክኑ።”<verse eid="GEN 43:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 43:23"/>እንስ ዴብሴ፣ “ሆማ ምት፤ ህንሶዳትና። ዋቅንኬሰን፣ ዋቅን አባኬሰኒ ቀልቀሎኬሰንት በዻዹማ እስኒ ነቄረ፤ ሜቲንኬሰን ነ ገኤ ጅረ” ጄዼን። ኤርገሲስ ስምኦንን ገረ እሳኒት ገድ ባሴ።<verse eid="GEN 43:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 43:24"/>ሀንገፍን ሆጄቶታ ሱንስ ጀረ ሰነ መነ ዮሴፍት ጌሴ አከ እሳን ሚለሳኒ ዽቀተኒፍ ብሻን ኬኔፍ፤ ሀሮተሳኒቲፍሞ ኦካ ኬኔ። <verse eid="GEN 43:24"/><verse number="25" style="v" sid="GEN 43:25"/>እሳንስ አችት አከ ኛተን ዋን ዸገአኒፍ ዹፋቲ ዮሴፍ ከን ሰኣቲ ጀኣቲፍ ኬናሳኒ ቆጴፈተን።<verse eid="GEN 43:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 43:26"/>ዬሮ ዮሴፍ መነት ገሌት እሳን ኬና መነት ኦል ገልቸኒ ቱረን ሰነ ኬነኒፍ፤ ፉለሳ ዱረትስ ለፈት ጎምብፈመኒ ሀርከ ፉዸን። <verse eid="GEN 43:26"/><verse number="27" style="v" sid="GEN 43:27"/>እንስ ነጋ እሳን ጋፈቴ፣ “አባንኬሰን ጃርስ እስን ዋኤሳ ነት ህምተን ሱን አከም? እን አመዩ ጅራ?” ጄዼን።<verse eid="GEN 43:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 43:28"/>ጀርስ፣ “ተጃጅላንኬ አባንኬኘ አመዩ ንጅረ፤ ነጉመስ” ጄዸኒ ዴብሰን። ኡልፍነ እሳፍ ኬኑፍስ ገድ ጄዸን።<verse eid="GEN 43:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 43:29"/>እንስ ኦል እላሌ ኦቦሌሰሳ፣ እልመ ሃዸሳ ቤንያምን አርጌ፣ “እን ኩን ኦቦሌሰኬሰን ቁጥሱ እስን ዋኤሳ ነት ህምተን ሰና?” ጄዼ ጋፈቴ። እት ፉፌስ፣ “እልመኮ፣ ዋቅን ስ ሃኤብሱ” ጄዼን። <verse eid="GEN 43:29"/><verse number="30" style="v" sid="GEN 43:30"/>ዮሴፍ ዮሙ ኦቦሌሰሳ አርጌት ገራን ራፈሜ ደፌ ገድ በኤ፤ ቦኡ በርባዴስ ኩታ መነሳ ሴኔ አችት ቦኤ።<verse eid="GEN 43:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 43:31"/>ኤርገሲስ ፉለሳ ዽቀቴ ገድ በኤ፤ ኦፍ ጀጀቤሴስ፣ “ኛን ሃዽኣቱ” ጄዼ።<verse eid="GEN 43:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 43:32"/>ጀርስ ሰበቢ ወር ግብጥ እብሮተ ወጅን ህንኛትኔፍ ዮሴፊፍ ኮጳት፣ ኦቦሎተሳቲፍ ኮጳት፣ ወረ ግብጥ ከኔን እሰ ወጅን ኛተኒፍስ ኮጳት ዽኤሰን፤ እብሮተ ወጅን ኛቹን ወረ ግብጥ ብረት ጅብሲሳ ቱሬቲ። <verse eid="GEN 43:32"/><verse number="33" style="v" sid="GEN 43:33"/>ነሞትን ሱንስ አኩመ ኡሙሪሳኒት ሀንገፋ ጀልቀበኒ ሀመ ቁጥሱት ፉለሳ ዱረ ተታአኒ ድንቅፈተኒ ወል እላለን። <verse eid="GEN 43:33"/><verse number="34" style="v" sid="GEN 43:34"/>ማዲ ዮሴፍ እራስ ኛትን ቆደሜፍ፤ ቆድን ቤንያም ገሩ ቆደ ቶኮ ቶኮሳኒቲፍ ኬነሜ ደቻ ሸን ተአ ቱሬ። ጀርስ አከሲን ዮሴፍ ወጅን ዹገኒ እት ሆኤ።<verse eid="GEN 43:34"/></para>
  <chapter eid="GEN 43"/>
  <chapter number="44" style="c" sid="GEN 44"/>
  <para style="s1">ጦፎ ሜቲ ቀልቀሎ ኬሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 44:1"/>ዮሴፍስ አከነ ጄዼ ሀንገፈ ሆጄቶተ መነሳ አጀጄ፤ “ቀልቀሎ ጀረ ከና ሀመ ባቹ ደንደኡት ምዻን እት ጉት፤ ሜቲ ቶኮ ቶኮሳኒስ አፋን ቀልቀሎሳኒ ኬሰ ካእ። <verse eid="GEN 44:1"/><verse number="2" style="v" sid="GEN 44:2"/>ጦፎኮ እሰ ሜቲራ ሆጄተሜሞ ሜቲ እን እቲን ምዻን ብተቹ ዹፌ ወጅን አፋን ቀልቀሎ እሰ ቁጥሱ ሰና ኬሰ ካእ።” ነምችስ አኩመ ዮሴፍ እሰ አጀጄ ጎዼ።<verse eid="GEN 44:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 44:3"/>ነሞትን ሱን አኩመ ለፍት በሪቴን ሀሮተሳኒ ወጅን ጌጌፈመን። <verse eid="GEN 44:3"/><verse number="4" style="v" sid="GEN 44:4"/>ኡቱመ እሳን መጋላ ሰነራ ህንፈጋትን ዮሴፍ ሀንገፈ ሆጄቶተሳቲን አከነ ጄዼ፤ “ደፊ ጀረ ከነ ዱካ ቡእ፤ ዮሙ ቀቀብዱትሞ አከነ ጄዺን፤ ‘እስን ማሊፍ ዋን ጋሪ ዋን ሀማዻን ዴብፍቱ? <verse eid="GEN 44:4"/><verse number="5" style="v" sid="GEN 44:5"/>ጦፎን ኩን ጦፎ ጎፍታንኮ እቲን ዹጉፊ እቲን ዋ ህሙ ምቲ? እስን ዋን ከነ ጎቹዻን ዋን ሀማ ሆጄተን።’ ”<verse eid="GEN 44:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 44:6"/>እንስ ዮሙ እሳን ቀቀቤት ዋኑመ ከነ እሳንት ዱበቴ። <verse eid="GEN 44:6"/><verse number="7" style="v" sid="GEN 44:7"/>ጀርስ አከነ እሳን ጄዸን፤ “ጎፍታንኮ ማሊፍ ዱቢ አከና ዱበተ? ዋን አከና ሆጄቹን ተጃጅልቶተኬራ ሃፈጋቱ! <verse eid="GEN 44:7"/><verse number="8" style="v" sid="GEN 44:8"/>ኩኖ ኑ ሜቲ አፋን ቀልቀሎኬኛ ኬሰት አርገትኔዩ ብየ ከነኣኒቲ ዴብፍኔ ሲፍ ፍድኔ። ዮስ ኑ ማሊፍ መነ ጎፍታኬቲቲ ሜቲ ዮካን ወርቄ ሀትነሬ? <verse eid="GEN 44:8"/><verse number="9" style="v" sid="GEN 44:9"/>ተጃጅልቶተኬ ኬሳ ነምን ወን ኩን ብረት አርገሜ ከምዩ ሃዱኡ፤ ኑ ወር ሀፍኔሞ ገርቦተ ጎፍታኮ ንታነ።”<verse eid="GEN 44:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 44:10"/>እንሞ ጀራን፣ “አመ አኩመ እስን ጄተን ሃተኡ፤ አባን ወንት ኩን ብረት አርገሜ ገርብቸ ናፍ ተአ፤ እስን ወር ካንሞ ገድ ዺፈምቱ” ጄዼ።<verse eid="GEN 44:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 44:11"/>ቶኮን ቶኮንሳኒ ደፈኒ ቀልቀሎሳኒ ለፈ ኬየተኒ ሂከን። <verse eid="GEN 44:11"/><verse number="12" style="v" sid="GEN 44:12"/>ሀንገፍን ሆጄቶታ ሱንስ ሀንገፋ ጀልቀቤ ሀመ ቁጥሱት ሰከተኤ። ጦፎን ሱንስ ቀልቀሎ ቤንያም ኬሰት አርገሜ። <verse eid="GEN 44:12"/><verse number="13" style="v" sid="GEN 44:13"/>ከነረት እሳን ኡፈተሳኒ ተርሳሰን። ሁንድሳኒ ሀሮተሳኒ ፌአተኒ መጋለቲት ዴብአን።<verse eid="GEN 44:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 44:14"/>ዮሴፍ ዬሮ ይሁዳፊ ኦቦሎትንሳ ኦል ሴነንት አመዩ መነ ኬሰ ቱሬ፤ እሳንስ ፉለሳ ዱረት ኩኩፈን። <verse eid="GEN 44:14"/><verse number="15" style="v" sid="GEN 44:15"/>ዮሴፍስ፣ “ወንት እስን ሆጄተን ኩን ማል? አከ ነምን አከኮቲ ሆደ ህሙዻን ዋ አርጉ ደንደኡ እስን ህንቤክተኒ?” እሳኒን ጄዼን።<verse eid="GEN 44:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 44:16"/>ይሁዳንሞ አከነ ጄዼ ዴብሴ፤ “ኑ ጎፍታኮቲን ማል ጄቹ ደንዴኘ? ኑ ማል ዱበቹ ደንዴኘ? ኑ ቁልቁሉ ተኡኬኘ አከሚን ምርከኔሱ ደንዴኘ? ዋቅን በሌሳ ገርቦተኬቲ እፈት ባሴረ። ኩኖ ኑ ገርቦተ ጎፍታኮት፤ ኑ ሁንድኬኘ፣ ነምን ጦፎን ሱን ብረት አርገሜስ ገርቦተኬት።”<verse eid="GEN 44:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 44:17"/>ዮሴፍ ገሩ፣ “ዋን አከና ሆጄቹን ነራ ሃፈጋቱ! ነመ ጦፎን ብረት አርገሜ ቆፈቱ ገርብቸኮ ተአ። ወር ሀፍተን ገሩ ነጋዻን ገረ አባኬሰኒት ዴብኣ” ጄዼ።<verse eid="GEN 44:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 44:18"/>ይሁዳንሞ ዮሴፍት ዽኣቴ አከነ ጄዼ፦ “ማሎ ጎፍታኮ፣ አከ ገርብችኬ ዋን ቶኮ ጎፍታኮት ዱበቱ ኤየሚፍ። አት አኩመ ፈረኦን ታቱስ ገርብቸኬት ህንኣርን። <verse eid="GEN 44:18"/><verse number="19" style="v" sid="GEN 44:19"/>ጎፍታንኮ፣ ‘እስን አባ ዮካን ኦቦሌሰ ቀብዱ?’ ጄዼ ገርቦተሳ ጋፈቴ ቱሬ። <verse eid="GEN 44:19"/><verse number="20" style="v" sid="GEN 44:20"/>ኑስ፣ ‘አባ ዱሎማ ቶኮ ቀብነ፤ እልም ቁጥሱን በረ ዱሉመሳ ኬሰ እሳፍ ዸለቴ ቶኮስ ጅረ። ኦቦሌስሳስ ዱኤረ፤ እጆሌ ሃትሳ ዴሴ ኬሳ እሰ ቆፈቱ ሀፌ፤ አባንሳ እሰ ጃለተ’ ጄኔ ቱሬ።<verse eid="GEN 44:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 44:21"/>“አትስ ገርቦተኬቲን፣ ‘አከ አን እጀኮቲን እሰ አርጉፍ ና ፍዳ’ ጄቴ። <verse eid="GEN 44:21"/><verse number="22" style="v" sid="GEN 44:22"/>ኑስ ጎፍታኮቲን፣ ‘ሙጭች አባሳ ዺሴ ዴሙ ህንደንደኡ፤ ዮ እን እሰ ዺሴ ብራ ዴሜ አባንሳ ንዱአ’ ጄኔ። <verse eid="GEN 44:22"/><verse number="23" style="v" sid="GEN 44:23"/>አትሞ ገርቦተኬቲን፣ ‘ዮ ኦቦሌስኬሰን እን ቁጥሱን እስን ወጅን ዹፉ ባቴ፣ እስን ለመተ ፉለኮ ህንአርግተን’ ጄቴ። <verse eid="GEN 44:23"/><verse number="24" style="v" sid="GEN 44:24"/>ኑስ ዬሮ ገረ ገርብቸኬ አባኮት ዴብኔት ዋን ጎፍታንኮ ጄዼ እሰት ህምኔ።<verse eid="GEN 44:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 44:25"/>“አባንኬኘ፣ ‘አመስ ዸቃቲ ምዻን ጥኖ ደበላ ኑ ብታ’ ኑን ጄዼ። <verse eid="GEN 44:25"/><verse number="26" style="v" sid="GEN 44:26"/>ኑ ገሩ፣ ‘ኑ ዸቁ ህንደንዴኙ፤ ዮ ኦቦሌስኬኘ እን ቁጥሱን ኑ ወጅን ጅራቴ ቆፈ ዸቅነ። ዮ ኦቦሌስኬኘ እን ቁጥሱን ኑ ወጅን ዸቁ ባቴ ኑ ፉለ ነምቻ አርጉ ህንደንዴኙ’ ጄኔ።<verse eid="GEN 44:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 44:27"/>“አባንኮ ገርብች ኬሞ አከነ ኑን ጄዼ፤ ‘አከ ኒቲንኮ እልማን ለመ ናዴሴ እስን ንቤክቱ። <verse eid="GEN 44:27"/><verse number="28" style="v" sid="GEN 44:28"/>እሳን ኬሳስ እን ቶኮ ነ ብራ በኤ፤ አንስ፣ “እን ዹጉማን ጭጭረሜረ” ነንጄዼ። አን ኤርገሲ እሰ ህንአርግኔ። <verse eid="GEN 44:28"/><verse number="29" style="v" sid="GEN 44:29"/>ዮ እስን እሰ ከነስ ነ ዱራ ፉተኒ በላን እሰረ ገኤ፣ እስን አከ አሪንኮ ገዳን አዋለ ሴኑ ጎቱ።’<verse eid="GEN 44:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 44:30"/>“ከናፉ አመ ዬሮ አን ገረ ገርብቸኬ አባኮት ዴብኡት፣ ዮ ሙጭች ኑ ወጅን ጅራቹ ባቴ አባንኮ ከን ጅሬኝሳ ጅሬኘ ሙጭቻቲን ወልት ህዸሜ ሱን፣ <verse eid="GEN 44:30"/><verse number="31" style="v" sid="GEN 44:31"/>አከ ሙጭች ኑ ወጅን ህንጅሬ አርጌ ዱአ። ኑ ገርቦንኬስ አከ አሪን አባኬኘ ገርብቸኬቲ ገዳን አዋለ ሴኑ ጎነ። <verse eid="GEN 44:31"/><verse number="32" style="v" sid="GEN 44:32"/>አን ገርብችኬ አከ ሙጫን ኩን ነጋዻን ዴብኡ አባኮ ዱረት ወቢ ተኤ፣ ‘ያ አባኮ፣ ዮ አን ዴብሴ እሰ ሲፍ ፍዱ ባዼ፣ አን በረ ጅሬኘኮ ጉቱ ፉለ አባኮ ዱረት በሌሳ ከነት ነንጋፈተመ!’ ጄዼ።<verse eid="GEN 44:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 44:33"/>“ኤጋ አመ አን ገርብችኬ እዶ ሙጭቻ ገርብቸ ጎፍታኮ ተኤ አስት ነንሀፈ፤ ሙጭችሞ ኦቦሎተሳ ወጅን ሃዴብኡ። <verse eid="GEN 44:33"/><verse number="34" style="v" sid="GEN 44:34"/>ዮ ሙጭች ነ ወጅን ህንጅራትን አን አከምን ገረ አባኮቲ ዴብኡ ደንደአ? ዋዉ፤ አከ አን ገደ አባኮት ዹፉ አርጉ ነ ህንጎዽን።”<verse eid="GEN 44:34"/></para>
  <chapter eid="GEN 44"/>
  <chapter number="45" style="c" sid="GEN 45"/>
  <para style="s1">ዮሴፍ ኦፍ ቤክስሴ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 45:1"/>ከነረት ዮሴፍ ነሞተ ሁንደ ዱረት ኦፍ ቀቡ ደዸቤ፣ “ነሞተ ሁንደ ፉለኮ ዱራ ገድ ያሳ!” ጄዼ እዬ። ከናፍ ዮሙ ዮሴፍ ኦቦሎተሳት ኦፍ ቤክስሴት ነምን ቶኮዩ እሰ ብረ ህንቱሬ። <verse eid="GEN 45:1"/><verse number="2" style="v" sid="GEN 45:2"/>ሰበቢ እን ጉድሴ ቦኤፍ ወር ግብጥ ንዸገአን፤ ወረ መሰራ ፈረኦን ብረትስ ንዸገአሜ።<verse eid="GEN 45:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 45:3"/>ዮሴፍስ ኦቦሎተሳቲን፣ “አን ዮሴፍ፤ አባንኮ አመዩ ጅራ?” ጄዼ ጋፈቴ። ኦቦሎትንሳ ገሩ ሰበቢ ፉለሳ ዱረት ነአኒ ቱረኒፍ ዴቢ እሳፍ ኬኑ ህንደንዴኜ።<verse eid="GEN 45:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 45:4"/>ዮሴፍስ ኦቦሎተሳቲን፣ “ሜ አስ ነት ዽኣዻ” ጄዼ። እሳን እሰት ዽኣናን እን አከነ ጄዼ፤ “አን ዮሴፍ ኦቦሌሰኬሰን እሰ እስን ግብጥት ጉርጉርተን ሰናዸ! <verse eid="GEN 45:4"/><verse number="5" style="v" sid="GEN 45:5"/>አመስ ሰበቢ አስት ነ ጉርጉርተኒፍ ህንጋብና፤ ኦፍትስ ህንኣርና። ዋቅን ሉቡ በራሩፍ ጄዼ እስን ዱረ ነ ኤርጌራቲ። <verse eid="GEN 45:5"/><verse number="6" style="v" sid="GEN 45:6"/>ወጎተ ለማን ከነ ቤለቱ ብየቲ ኬሰ ቱሬ፤ ወጎተ ሸነን ዹፈን ኬሰስ ለፈ ቆተቹፊ ምዻን ገልፈቹን ህንጅሩ። <verse eid="GEN 45:6"/><verse number="7" style="v" sid="GEN 45:7"/>ዋቅን ለፈረት ሰኚ እስኒፍ ሀምብሱፊ ፉሪ ጉዳዻን ሉቡኬሰን ኦልቹፍ ጄዼ እስን ዱረ ነ ኤርጌ።<verse eid="GEN 45:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 45:8"/>“ዋቀቱ አስ ነ ኤርጌ መሌ እስን ምት። እን ፈረኦኒፍ አባ ነ ጎዼ፤ ወረ መነሳ ጅረን ሁንደረት ጎፍታ፣ ብየ ግብጥ ሁንደረትሞ ቡልቻ ነ ጎዼ። <verse eid="GEN 45:8"/><verse number="9" style="v" sid="GEN 45:9"/>አመስ ደፋ ገረ አባኮት ዴብኣቲ አከነ እሳን ጄዻ፤ ‘እልምኬ ዮሴፍ አከነ ጄዸ፦ ዋቅን ግብጥ ሁንደረት ጎፍታ ነ ጎዼረ። ገረኮት ገድ ቡእ፤ ህንቱርንስ። <verse eid="GEN 45:9"/><verse number="10" style="v" sid="GEN 45:10"/>አት ብየ ጎሼን ኬሰ ንጅራተ፤ አት፣ እጆሌንኬቲፊ እጆሌን እጆሌኬቲ፣ ቡሻዬንኬ፣ ሎንኬቲፊ ወን አት ቀብዱ ሁንድ ነት ዽኣተኒ ጅራቱ። <verse eid="GEN 45:10"/><verse number="11" style="v" sid="GEN 45:11"/>ሰበቢ አመዩ ወጋን ቤላ ሸን ዹፋ ጅሩፍ አን አችት ስን ሶረ፤ ዮ ከና አቺ አቲፊ ወር መነኬ ጅራተን፣ ወን አት ቀብዱ ሁንድኑስ ንረከቱ።’<verse eid="GEN 45:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 45:12"/>“አከ ነምን እስንት ዱበቻ ጅሩ ኩን አኑመ ተኤ ኩኖ፣ እጅኬሰን፣ እጅ ኦቦሌሰኮ ቤንያምስ ንአርገ። <verse eid="GEN 45:12"/><verse number="13" style="v" sid="GEN 45:13"/>ኡልፍነ ግብጥ ኬሰት ና ኬነሜ ሁንዳፊ ዋን አርግተን ሁንደ አባኮት ህማ። አባኮስ ደፋቲ አስ ፍዳ።”<verse eid="GEN 45:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 45:14"/>ኤርገሲስ ሞርመ ኦቦሌሰሳ ቤንያምት መርሜ ቦኤ፤ ቤንያምስ ቦኣ እሰ ሀመቴ። <verse eid="GEN 45:14"/><verse number="15" style="v" sid="GEN 45:15"/>ዮሴፍስ ኦቦሎተሳ ሁንደ ዹንገቴ እት ቦኤ። ኤርገሲ ኦቦሎትንሳ እሰ ወጅን ሃሰአን።<verse eid="GEN 45:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 45:16"/>ዮሙ አከ ኦቦሎትን ዮሴፍ ዹፈን መሰራ ፈረኦንት ዸገአሜት፣ ፈረኦኒፊ ቆንዳልቶትንሳ ንገመደን። <verse eid="GEN 45:16"/><verse number="17" style="v" sid="GEN 45:17"/>ፈረኦንስ ዮሴፊን አከነ ጄዼ፤ “ኦቦሎተኬቲን አከነ ጄዽ፤ ‘ዋን ከነ ጎዻ፦ ሆሪኬሰን ፌአዻ ብየ ከነኣኒት ዴብኣቲ <verse eid="GEN 45:17"/><verse number="18" style="v" sid="GEN 45:18"/>አባንኬሰኒፊ ማቲወንኬሰን ነት ፍዳ። አን ለፈ ብየ ግብጥ ኬሳ ለፈ ሁንደ ጫሉ እስኒፍ ነንኬነ። እስን ጮመ ብየቲ ንኛቱ።’<verse eid="GEN 45:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 45:19"/>“አከሱመስ አከነ ጄዺ እሳንት ህም፤ ‘ዋን ከነ ጎዻ፦ እጆሌኬሰኒፍስ፣ ኒቶተኬሰኒፍስ ብየ ግብጢቲ ጋሪወን ፉዸዻ፤ አባኬሰንስ ፍዳቲ ኮታ። <verse eid="GEN 45:19"/><verse number="20" style="v" sid="GEN 45:20"/>ዋኤ ቀቤኘኬሰኒ ህንያደእና፤ ወን ብየ ግብጥ ጉቱ ኬሳ ዋን ሁንደ ጫሉ ከንኬሰን ተኣቲ።’ ”<verse eid="GEN 45:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 45:21"/>እልማን እስራኤልስ አከሱመ ጎዸን። ዮሴፍስ አኩመ ፈረኦን እሰ አጀጄት ጋሪወን ኬኔፊ ከራሳኒቲፍሌ ገላ ገላሴፍ። <verse eid="GEN 45:21"/><verse number="22" style="v" sid="GEN 45:22"/>ቶኮ ቶኮሳኒቲፍ ወያ ኬኔ፤ ቤንያሚፍ ገሩ ሜቲ ሰቅሊ ዽበ ሰዲቲፊ ወያ እራ ጀላ ሸን ኬኔ። <verse eid="GEN 45:22"/><verse number="23" style="v" sid="GEN 45:23"/>አባሳቲፍሞ ሀሮተ፣ ወን ብየ ግብጥ ገጋሪን እት ፌአሜ ኩዸን፣ አከሱመስ ሀሮተ ዸልቱ ምዻን፣ ቡዴናፊ ገላን ብራ ከራሳቲፍ እት ፌአሜ ኩዸን ኤርጌ። <verse eid="GEN 45:23"/><verse number="24" style="v" sid="GEN 45:24"/>እንስ አከስት ኦቦሎተሳ ኤርጌ፤ እንስ ዬሮ እሳን ቀጄለንት፣ “ከራት ወል ህንሎልና!” ጄዼን።<verse eid="GEN 45:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 45:25"/>እሳንስ ግብጥ ኬሳ ኦል በአኒ ገረ ብየ ከነኣን አባሳኒ ያቆብ ብረ ዸቀን። <verse eid="GEN 45:25"/><verse number="26" style="v" sid="GEN 45:26"/>እሳንስ፣ “ዮሴፍ አመዩ ጅረ! ብየ ግብጥ ጉቱዩ እሱመቱ ቡልቸ” ጄዸኒን። ያቆብሞ ናሱዻን ኦፍ ወላሌ፤ ጀረ አመኑስ ህንደንዴኘ። <verse eid="GEN 45:26"/><verse number="27" style="v" sid="GEN 45:27"/>ገሩ ዬሮ ጀር ዋን ዮሴፍ እሳኒን ጄዼ ሁንደ እሰት ህመኒ እንስ ጋሪወን ዮሴፍ እሰ ፍችሲሱፍ ኤርጌፍ ሰነ አርጌት ሉቡን አባሳኒ ያቆብ ንበየነቴ። <verse eid="GEN 45:27"/><verse number="28" style="v" sid="GEN 45:28"/>እስራኤልስ፣ “ነ ገአ! እልምኮ ዮሴፍ አመዩ ጅረ። አንስ ኡቱን ህንዱእን ዸቄ እሰ ነንአርገ” ጄዼ።<verse eid="GEN 45:28"/></para>
  <chapter eid="GEN 45"/>
  <chapter number="46" style="c" sid="GEN 46"/>
  <para style="s1">ያቆብ ብየ ግብጥ ዸቄ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 46:1"/>እስራኤል ዋን ቀቡ ሁንደ ፉዸቴ ከኤ፤ ዬሮ ቤርሼባ ገኤትስ ዋቀ አባሳ ዋቀ ይስሃቂፍስ ኣርሳ ዽኤሴ።<verse eid="GEN 46:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 46:2"/>ዋቅንስ ሀልከን ሙልአታን፣ “ያቆብ! ያቆብ!” ጄዼ እስራኤልት ዱበቴ።</para>
  <para style="p" vid="GEN 46:2">እንስ፣ “ኩኖ አን አስ ጅረ” ጄዼ ዴብሴ።<verse eid="GEN 46:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 46:3"/>ዋቅንስ አከነ ጄዼ፤ “አን ዋቀዮ፣ ዋቀ አባኬቲት። ግብጥት ገድ ቡኡ ህንሶዳትን፤ አን አችት ሰበ ጉዳ ስን ታስሳቲ። <verse eid="GEN 46:3"/><verse number="4" style="v" sid="GEN 46:4"/>አን ስ ወጅን ግብጥት ገድ ቡኤ ዴብሴ ስን ፍደ። ሀርኩመ ዮሴፍቱ እጀኬ ወልት ሲፍ ቀበ።”<verse eid="GEN 46:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 46:5"/>ያቆብስ ቤርሼባዻ ከኤ ቀጄሌ፤ እልማን እስራኤልስ አባሳኒ ያቆብ፣ እጆሌሳኒቲፊ ኒቶተሳኒ ጋሪወን ያቆብን ባቹፍ ፈረኦን ኤርጌ ሰነረ ቴስሰን። <verse eid="GEN 46:5"/><verse number="6" style="v" sid="GEN 46:6"/>ያቆቢፊ ሰኚንሳ ሁንድስ ሆሪሳኒቲፊ ቀቤኘ ከነኣንት ሆረተን ኦፍ ፋነ ፉዸተኒ ግብጥት ጎዳነን። <verse eid="GEN 46:6"/><verse number="7" style="v" sid="GEN 46:7"/>እንስ ሰኚሳ ሁንደ ጄቹንስ እልማንሳ፣ እልማን እልማንሳ፣ እንተለንሳቲፊ እንተለን እልማንሳ ፉዸቴ ግብጥት ጎዳኔ።<verse eid="GEN 46:7"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="8" style="v" sid="GEN 46:8"/>መቃወን እልማን እስራኤል ወረ ግብጥት ጎዳነን ሰና ጄቹንስ ያቆቢፊ ሰኚወንሳ ከኔኒዸ፦</para>
  <para style="b" vid="GEN 46:8"/>
  <para style="li1" vid="GEN 46:8">ሩቤን ጄቹንስ እልመ ያቆብ ሀንገፍትቸ።<verse eid="GEN 46:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="GEN 46:9"/>እልማን ሩቤን፦</para>
  <para style="li2" vid="GEN 46:9">ሄኖክ፣ ፈሉሶ፣ ሄዝሮኒፊ ከርሚ።<verse eid="GEN 46:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="GEN 46:10"/>እልማን ስምኦን፦</para>
  <para style="li2" vid="GEN 46:10">ዬሙኤል፣ ያሚን፣ ኦሀድ፣ ያኪን፣ ዞሀሪፊ ሻዉል እልመ ዱበርቲ ከነኣን ሰና።<verse eid="GEN 46:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="GEN 46:11"/>እልማን ሌዊ፦</para>
  <para style="li2" vid="GEN 46:11">ጌርሾን፣ ቆሃቲፊ ሜራሪ።<verse eid="GEN 46:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="GEN 46:12"/>እልማን ይሁዳ፦</para>
  <para style="li2" vid="GEN 46:12">ኤር፣ ኦናን፣ ሼላ፣ ፋሬሲፊ ዛራ። ኤሪፊ ኦናን ገሩ ብየ ከነኣንት ዱአን።</para>
  <para style="li2" vid="GEN 46:12">እልማን ፋሬስ፦</para>
  <para style="li3" vid="GEN 46:12">ሄዝሮኒፊ ሀሙል።<verse eid="GEN 46:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="GEN 46:13"/>እልማን ይሳኮር፦</para>
  <para style="li2" vid="GEN 46:13">ቶላ፣ ፉዋ፣ ዮቢፊ ሽምሮን።<verse eid="GEN 46:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="GEN 46:14"/>እልማን ዜቡሎን፦</para>
  <para style="li2" vid="GEN 46:14">ሴሬድ፣ ኤሎኒፊ የህልኤል።<verse eid="GEN 46:14"/></para>
  <para style="lf">
    <verse number="15" style="v" sid="GEN 46:15"/>እሳን ኩኔን እንተለሳ ዲና ደበለቴ እልማን ልያን ካበ ዽአ ጳዳን አራምት ያቆቢፍ ዴሴዸ። እልማኒፊ እንተለንሳ ኩኔን ወሉማ ገለት ሶዶሚ ሰዲ ቱረን።<verse eid="GEN 46:15"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="16" style="v" sid="GEN 46:16"/>እልማን ጋድ፦</para>
  <para style="li2" vid="GEN 46:16">ዚፍዮን፣ ሀጊ፣ ሹኒ፣ ኤስቦን፣ ኤሪ፣ አሮዲፊ አርኤል።<verse eid="GEN 46:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="GEN 46:17"/>እልማን ኣሼር፦</para>
  <para style="li2" vid="GEN 46:17">ይምና፣ ይሽዋ፣ ይሽዊፊ ቤሪያ። ኦቦሌቲንሳኒስ ሴራዸ።</para>
  <para style="li2" vid="GEN 46:17">እልማን ቤሪያ፦</para>
  <para style="li3" vid="GEN 46:17">ሄቤሪፊ መልኪኤል።<verse eid="GEN 46:17"/></para>
  <para style="lf">
    <verse number="18" style="v" sid="GEN 46:18"/>እሳን ኩኔን እጆሌ ዚፋን ያቆቢፍ ዴሴዸ። ዚፋን እሼ ላባን እንተለሳ ልያዻፍ ኬኔ ሰናዸ። እሳን ወሉማ ገለት ኩዸ ጀአ ቱረን።<verse eid="GEN 46:18"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="19" style="v" sid="GEN 46:19"/>እልማን ራሄል ኒቲ ያቆብ፦</para>
  <para style="li2" vid="GEN 46:19">ዮሴፊፊ ቤንያም።<verse eid="GEN 46:19"/></para>
  <para style="li3">
    <verse number="20" style="v" sid="GEN 46:20"/>ምናሴፊ ኤፍሬም፣ ኣሴነት እንተለ ጶጢፌራ ሉብቸ መጋላ ኦን ሰናራ ግብጥ ኬሰት ዮሴፊፍ ዸለተን።<verse eid="GEN 46:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="GEN 46:21"/>እልማን ቤንያም፦</para>
  <para style="li2" vid="GEN 46:21">ቤላ፣ ቤኬር፣ አሽቤል፣ ጌራ፣ ነአማን፣ ኤሂ፣ ሮሽ፣ ሙፊም፣ ሁፊሚፊ አርድ።<verse eid="GEN 46:21"/></para>
  <para style="lf">
    <verse number="22" style="v" sid="GEN 46:22"/>እሳን ኩኔን እልማን ራሄል ያቆቢፍ ዴሴዸ፤ እሳንስ ወሉማ ገለት ነመ ኩዸ አፉር ቱረን።<verse eid="GEN 46:22"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="23" style="v" sid="GEN 46:23"/>እልም ዳን፦</para>
  <para style="li2" vid="GEN 46:23">ሁሺሚዸ።<verse eid="GEN 46:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="GEN 46:24"/>እልማን ንፍታሌም፦</para>
  <para style="li2" vid="GEN 46:24">የህዜል፣ ጉኒ፣ ዬጤሪፊ ሺሌም።<verse eid="GEN 46:24"/></para>
  <para style="lf">
    <verse number="25" style="v" sid="GEN 46:25"/>እሳን ኩኔን እልማን ብልሃን ያቆቢፍ ዴሴዸ፤ ብልሃን እሼ ላባን እንተለሳ ራሄሊፍ ኬኔ ሰናዸ፤ እሳን ወሉማ ገለት ነመ ቶርበ ቱረን።<verse eid="GEN 46:25"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="26" style="v" sid="GEN 46:26"/>ነሞትን ያቆብ ወጅን ግብጥት ጎዳነን ኡቱ ኒቶተ እልማንሳ ህንደበለን ሰኚንሳ ወሉማ ገለት ጃተሚ ጀአ ቱረን። <verse eid="GEN 46:26"/><verse number="27" style="v" sid="GEN 46:27"/>እልማን ግብጥት ዮሴፊፍ ዸለተን ለማን ደበለቴ ምሴንሶትን ማቲ ያቆብ ወር ግብጥት ጎዳነን ወሉማ ገለት ቶርባተመ ቱረን።<verse eid="GEN 46:27"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="28" style="v" sid="GEN 46:28"/>ያቆብስ አከ እን ዸቄ ከራ ጎሼንት ነመ ጌሱ ጋፈቱፍ ይሁዳ ኦፍ ዱረ ገረ ዮሴፍት ኤርጌ። ዮሙ እሳን ጎሼን ገአንት፣ <verse eid="GEN 46:28"/><verse number="29" style="v" sid="GEN 46:29"/>ዮሴፍ ጋሪሳ ቆጴፈቴ አባሳ እስራኤል ስመቹፍ ጎሼንት ቀጄሌ። እንስ አኩመ ፉለሳ ዱረት ሙልአቴን ሞርመሳት መርሜ ዬሮ ዼራ ቦኤ።<verse eid="GEN 46:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 46:30"/>እስራኤልስ ዮሴፊን፣ “አን ሰበቢ አከ አት አመዩ ሉቡን ጅርቱ ኦፊኮቲን አርጌፍ ስአች ዱኡሌ ህንጋቡ” ጄዼ።<verse eid="GEN 46:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 46:31"/>ዮሴፍስ ኦቦሎተሳቲፊ ወረ መነ አባሳ ጅራተኒን አከነ ጄዼ፤ “አን ኦል በኤ ፈረኦንት ነንዱበዸ፤ አከነስ ነንጄዻን፤ ‘ኦቦሎትንኮፊ ወር መነ አባኮ ጅራተን ከኔን ብየ ከነኣን ጅራቻ ቱረን ነት ዹፈኒሩ። <verse eid="GEN 46:31"/><verse number="32" style="v" sid="GEN 46:32"/>ነሞትን ኩኔን ትክሶተ፤ እሳን ሎን ትክፈቱቲ። እሳን ቡሻዬሳኒ፣ ሎኒፊ ዋን ቀበን ሁንደ ፉዸተኒ ዹፈን።’ <verse eid="GEN 46:32"/><verse number="33" style="v" sid="GEN 46:33"/>ዮ ፈረኦን ኦፍት እስን ዋሜ፣ ‘ሆጂንኬሰን ማል?’ ጄዼ እስን ጋፈቴ፣ <verse eid="GEN 46:33"/><verse number="34" style="v" sid="GEN 46:34"/>‘ኑ ገርቦንኬ አኩመ አቦቲኬኛ እጆሉማኬኛ ጀልቀብኔ ሀመ አማት ሆሪ ትክፈቻ ቱሬ’ ጄዻ ዴብሳ። ዮስ እን ሰበቢ ትክሶትን ሁንድኑ ወረ ግብጥ ብረት ጅበመኒፍ አከ እስን ብየ ጎሼን ኬሰ ጅራተን እስኒ ኤየማ።”<verse eid="GEN 46:34"/></para>
  <chapter eid="GEN 46"/>
  <chapter number="47" style="c" sid="GEN 47"/>
  <para style="p">
    <verse number="1" style="v" sid="GEN 47:1"/>ዮሴፍስ ገረ ፈረኦን ዸቄ፣ “አባንኮቲፊ ኦቦሎትንኮ ቡሻዬሳኒ፣ ሎንሳኒቲፊ ዋን ቀበን ሁንደ ፉዸተኒ ብየ ከነኣን ዹፈኒ ኩኖ ብየ ጎሼን ጅሩ” ጄዼ እት ህሜ። <verse eid="GEN 47:1"/><verse number="2" style="v" sid="GEN 47:2"/>እንስ ኦቦሎተሳ ኬሳ ነመ ሸን ፍለቴ ፈረኦንት ዽኤሴ።<verse eid="GEN 47:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 47:3"/>ፈረኦንስ፣ “ሆጂንኬሰን ማል?” ጄዼ ኦቦሎተ ዮሴፍ ጋፈቴ።</para>
  <para style="p" vid="GEN 47:3">እሳንስ፣ “ኑ ገርቦንኬ አኩመ አቦቲኬኛ ትክሶተ” ጄዸኒ ዴብሰኒፍ። <verse eid="GEN 47:3"/><verse number="4" style="v" sid="GEN 47:4"/>አከነስ ጄዸኒን፤ “ሰበቢ ቤል ብየ ከነኣንት ጭሜ ቡሻዬን ገርቦተኬቲ ዋን ዼደን ዸበኒፍ ኑ ዬሮ ገባባ አስ ጅራቹ ዹፍኔ። አከ ኑ ገርቦንኬ ብየ ጎሼን ኬሰ ጅራኑፍ ማሎ ኑ ኤየም።”<verse eid="GEN 47:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 47:5"/>ፈረኦንስ ዮሴፊን አከነ ጄዼ፤ “አባንኬቲፊ ኦቦሎትንኬ ሲፍ ዹፈኒሩ፤ <verse eid="GEN 47:5"/><verse number="6" style="v" sid="GEN 47:6"/>ለፍት ግብጥ ፉሉመኬ ዱረ ጅረ፤ አባኬቲፊ ኦቦሎተኬ እዶ ለፈ ሁንዱማ ጫሉረ ቁበቺስ። እሳን ብየ ጎሼን ኬሰ ሃጅራተን። አት ዮ ነሞተ እሳን ኬሳ ደንዴቲ ቀበን ቤክቴ ሎንኮረት እት ጋፈተምቶተ እሳን ጎዽ።”<verse eid="GEN 47:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 47:7"/>ኤርገሲ ዮሴፍ አባሳ ያቆብን ፍዴ ፉለ ፈረኦን ዱረት ዽኤሴ። ኤርገ ያቆብ ፈረኦንን ኤብሴ ቦዴ፣ <verse eid="GEN 47:7"/><verse number="8" style="v" sid="GEN 47:8"/>ፈረኦን፣ “ኡምሪንኬ ሀመም?” ጄዼ እሰ ጋፈቴ።<verse eid="GEN 47:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 47:9"/>ያቆብስ ፈረኦኒን አከነ ጄዼ፤ “በር አን ኬሱሙማን ጅራዼ ወጋ ዽባ ቶኮፊ ሶዶመ። በሮትንኮስ ሙራሰ፤ ሀማዸስ፤ እንስ በረ አቦቲንኮ ኬሱሙማን ጅራተን ሰናን ወል ቅጤ ምት።” <verse eid="GEN 47:9"/><verse number="10" style="v" sid="GEN 47:10"/>ከነ ቦዴ፣ ያቆብ ፈረኦንን ኤብሴ ፉለሳ ዱራ ገድ በኤ።<verse eid="GEN 47:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 47:11"/>ዮሴፍስ አኩመ ፈረኦን እሰ አጀጄት አባሳቲፊ ኦቦሎተሳ ግብጥ ኬሰ ቁበቺሴ፤ ለፈ ለፈ ሁንደ ጫሉ፣ ኣና ራምሴ ሀንዹራ ጎዼ እሳኒ ኬኔ። <verse eid="GEN 47:11"/><verse number="12" style="v" sid="GEN 47:12"/>አከሱመስ ዮሴፍ አባሳቲፍ፣ ኦቦሎተሳቲፊ ወረ መነ አባሳ ጅረን ሁንዳፍ አኩመ ባይእነ እጆሌሳኒት ምዻን ኬኔ።<verse eid="GEN 47:12"/></para>
  <para style="s1">ዮሴፊፊ ቤለ</para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 47:13"/>ዋን ቤል አከ መሌ ጭሜፍ ብየቲ ጉቱ ኬሰ ወን ኛተሙ ህንጅሩ ቱሬ፤ ሰበቢ ቤለ ሰናቲንስ ግብጢፊ ከነኣን አከ መሌ ሚዸመን። <verse eid="GEN 47:13"/><verse number="14" style="v" sid="GEN 47:14"/>ዮሴፍስ ከፈልቲ ምዻን ነሞትን ብተቻ ቱረን ሰና ማለቀ ብየ ግብጢፊ ከነኣን ኬሰት አርገሙ ሁንደ ወልት ቀቤ መሰራ ፈረኦንት ገልቼ። <verse eid="GEN 47:14"/><verse number="15" style="v" sid="GEN 47:15"/>ማለቅን ወረ ግብጢፊ ወረ ከነኣን ዹምናን ወር ግብጥ ሁንድ ገረ ዮሴፍ ዹፈኒ፣ “ምዻን ኑ ኬን። ኑ ማሊፍ ፉለኬ ዱረት ዱነ? ማለቅንኬኘ ዹሜረ” ጄዸን።<verse eid="GEN 47:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 47:16"/>ዮሴፍሞ፣ “ኤርገ ማለቅንኬሰን ዹሜ ሆሪኬሰን ፍዳ፤ ቆደ ሆሪኬሰኒ አን ምዻን እስኒፍ ነንኬነ” ጄዼ። <verse eid="GEN 47:16"/><verse number="17" style="v" sid="GEN 47:17"/>እሳንስ ሆሪሳኒ ዮሴፍት ፍደን፤ ዮሴፍስ ቆደ ፈርዴንሳኒ፣ ቆደ ቡሻዬሳኒ፣ ቆደ ሎወንሳኒቲፊ ቆደ ሀሮተሳኒ ምዻን ኬኔፍ። እንስ በረ ሰነ ጌደራ ሆሪሳኒ ሁንዳ ምዻን እሳን ሶሬ።<verse eid="GEN 47:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 47:18"/>ወጋን ሱን ዹምናን ጀር ወጋ እት ኣኑት ገረሳ ዹፈኒ አከነ ጄዸን፤ “ኤርገ ማለቅንኬኘ ዹሜ ሆሪንኬኘ ከንኬ ተኤ አስ፣ ያ ጎፍታኬኘ አከ ዸግነኬኛፊ ለፈኬኘ መሌ ወን ቶኮዩ ኑፍ ህንሀፍን ኑ ጎፍታኬኘ ጀላ ህንዾክስኑ። <verse eid="GEN 47:18"/><verse number="19" style="v" sid="GEN 47:19"/>ኑ ማሊፍ ፉለኬ ዱረት ዱነ? ኑፊ ለፍትኬኘስ ማሊፍ በድነ? ኑፊ ለፈኬኘ ፉዸዹቲ ቆደሳ ምዻን ኑፍ ኬን። ኑ ለፈኬኘ ወጅን ፈረኦኒፍ ንገርቦምነ። አከ ኑ ዱአ ጀላ ባኔ ጅራኑፍ፣ አከ ለፍትስ ዱዋ ህንሀፍኔፍ ሰኚ ኑፍ ኬን።”<verse eid="GEN 47:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 47:20"/>ዮሴፍስ ለፈ ብየ ግብጥ ሁንዱማ ፈረኦኒፍ ብቴ። ወር ግብጥ ሁንድ ዋን ቤል እሳንት ጭሜፍ ለፈሳኒ ጉርጉረን፤ ለፍትስ ከን ፈረኦን ተኤ፤ <verse eid="GEN 47:20"/><verse number="21" style="v" sid="GEN 47:21"/>ዮሴፍስ ዳንጋ ብየ ግብጥ ቶኮራ ሀመ ዳንጋ ካኒት ሰበ ገርቡማ ጀለ ገልቼ። <verse eid="GEN 47:21"/><verse number="22" style="v" sid="GEN 47:22"/>ለፍት እን ህንብትን ለፈ ሉቦታ ቆፈ ቱሬ፤ ኩንስ ሰበቢ እሳን ፈረኦንራ ቆደ አርገተኒፊ ሰበቢ ቆደ ፈረኦን እሳኒፍ ኬኑ ሰናን ጅራተኒፍ። ከናፉ እሳን ለፈሳኒ ህንጉርጉሬ።<verse eid="GEN 47:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 47:23"/>ዮሴፍስ ሰበ ሰናን አከነ ጄዼ፤ “ኩኖ አን ሀርአ እስኒፊ ለፈኬሰን ፈረኦኒፍ ብቴረ። ኩኖ ለፈት ሰኚ ፈጫፈዻ። <verse eid="GEN 47:23"/><verse number="24" style="v" sid="GEN 47:24"/>ዮሙ ምዻን ገልፈሙት ሀርከ ሸን ኬሳ ሀርከ ቶኮ ፈረኦኒፍ ንኬንቱ። ሀርከ አፍረን ሀፌሞ ሰኚ ፈጫፈተን፣ ኛተ ኦፊኬሰኒ፣ ኛተ ወረ መነኬሰን ጅራተኒቲፊ ኛተ እጆሌኬሰኒ ጎዸቱ።”<verse eid="GEN 47:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 47:25"/>ጀርስ፣ “አት ዱአ ኑ ኦልችቴርተ፤ ኑ ፉለ ጎፍታኬኛ ዱረት ፉዸተመ ሃአርገትኑ መሌ ፈረኦኒፍ ገርቦተ ንታነ” ጄዸን።<verse eid="GEN 47:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 47:26"/>ዮሴፍስ አከሲን አከ ሀርከ ሸን ኬሳ ሀርክ ቶኮ ከን ፈረኦን ተኡፍ ግብጥ ኬሰት ሴረ ለፋ ዻቤ፤ ሴር ሱን ሀመ ሀርኣትሌ እቲን ሆጄተማ ጅረ። ለፈ ሉቦታ ቆፈቱ ኡቱ ከን ፈረኦን ህንተእን ሀፌ።<verse eid="GEN 47:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 47:27"/>እስራኤሎንስ ግብጥ ኬሰ ኩታ ብየ ጎሼን ኬሰ ቁበተን። አችትስ ቀቤኘ አርገተን፤ ሆረኒስ ጉዳ ባይአተን።<verse eid="GEN 47:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 47:28"/>ያቆብ ወጋ ኩዸ ቶርበ ብየ ግብጥ ኬሰ ጅራቴ፤ በር ጅሬኘሳስ ወጋ ዽበ ቶኮ አፉርተሚ ቶርበ ቱሬ። <verse eid="GEN 47:28"/><verse number="29" style="v" sid="GEN 47:29"/>እስራኤልስ ዬሮን ዱአሳ ዽኣናን እልመሳ ዮሴፍን ኦፍት ዋሜ አከነ ጄዼን፤ “ዮ አን ፉለኬ ዱረት ፉዸተመ አርገዼ፣ ሜ ሀርከኬ ጉዴደኮ ጀለ ካኢቲ አከ ጋሩማ ነ አርግሲፍቱፊ አከ ናፍ አመነምቱ ዋዳ ናፍ ሴን። ግብጥት ነ ህንአዋልን፤ <verse eid="GEN 47:29"/><verse number="30" style="v" sid="GEN 47:30"/>ዬሮ አን አቦቲኮ ወጅን ቦቆዹት ብየ ግብጢ ነ ባሲ እዶ እሳን እት አዋለመንት ነ አዋል።”</para>
  <para style="p" vid="GEN 47:30">እንስ፣ “አኩመ አት ጄቴ ነንጎዸ” ጄዼ።<verse eid="GEN 47:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 47:31"/>እስራኤልስ፣ “ና ከከዹ” ጄዼን። ዮሴፍስ ንከከቴፍ። እስራኤልሞ መታ ኡሌሳት እርከቴ ሰገዴ።<verse eid="GEN 47:31"/></para>
  <chapter eid="GEN 47"/>
  <chapter number="48" style="c" sid="GEN 48"/>
  <para style="s1">ምናሴፊ ኤፍሬም</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 48:1"/>ዬሮ ሙራሰ ቦዴ፣ “ኩኖ፣ አባንኬ ዹኩብሰቴረ” ጄዸኒ ዮሴፍት ህመን። እንስ እልማንሳ ለማን ምናሴፊ ኤፍሬምን ፉዸቴ ዸቄ። <verse eid="GEN 48:1"/><verse number="2" style="v" sid="GEN 48:2"/>ያቆብ ዬሮ፣ “እልምኬ ዮሴፍ ገረኬ ዹፌረ” ጄዸኒ እት ህመንት፣ እስራኤል ኦፍ ጀጀቤሴ ከኤ ስሬረ ታኤ።<verse eid="GEN 48:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 48:3"/>ያቆብስ ዮሴፊን አከነ ጄዼ፤ “ዋቅን ዋን ሁንደ ደንደኡ ብየ ከነኣን ኬሰት ሉዝት ነት ሙልአቴ አችት ነ ኤብሴ፤ <verse eid="GEN 48:3"/><verse number="4" style="v" sid="GEN 48:4"/>አከነስ ናን ጄዼ፤ ‘አን አከ አት ሆርቱፊ አከ አት ባይአቱ ነንጎዸ። ቱተ ሰባ ስን ጎዸ፤ አን ብየ ከነ ዻለ በረ በራ ጎዼ ሰኚወንኬ ወረ ስ ቦዴቲፍ ነንኬነ።’<verse eid="GEN 48:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 48:5"/>“ኤጋ አመ እልማንኬ ለማን ወር ኡቱ አን አስ ገረኬ ህንዹፍን ዱረ ግብጥት ሲፍ ዸለተን ሱን አኩመ እልማንኮት እላለሙ፤ አኩመ ሩቤኒፊ ስምኦን ከንኮ ተአን ሰነ ኤፍሬሚፊ ምናሴንስ ከኑመኮ ተኡ። <verse eid="GEN 48:5"/><verse number="6" style="v" sid="GEN 48:6"/>እጆሌን እሳን ቦዴን ሲፍ ዸለተን ከንኬ ተኡ። ዻለ ቆደቹ ኬሰትሞ መቃ ኦቦሎተሳኒ ጀለት ለካአሙ። <verse eid="GEN 48:6"/><verse number="7" style="v" sid="GEN 48:7"/>ዬሮ አን ካበ ዽአ ጳዳኒቲ ዴብኣ ቱሬት ኡቱመ ኤፍራታ ገኡፍ ጥኑመ ኑ ሀፌ ጅሩ ራሄል ብየ ከነኣን ኬሰት ነ ጀላ ዱናን አቹመት ከራ ኤፍራታ ዸቁ ብረት አዋለዼ።” ኤፍራታን ኩንስ ቤትልሄሚዸ።<verse eid="GEN 48:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 48:8"/>እስራኤል ዬሮ እልማን ዮሴፍ አርጌት፣ “እሳን ኩኔን ኤኙ?” ጄዼ ጋፈቴ።<verse eid="GEN 48:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 48:9"/>ዮሴፍሞ አባሳቲን፣ “እሳን ኩኔን እልማን ብየ ከነት ዋቅን ናፍ ኬኔዸ” ጄዼ።</para>
  <para style="p" vid="GEN 48:9">ከነረት እስራኤል፣ “አከ አን እሳን ኤብሱፍ ነት ፍድ” ጄዼ።<verse eid="GEN 48:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 48:10"/>ዬሮ ከነት እስራኤል ዱሎሜ እጅሳ ደዸቤ ቱሬ፤ እንስ ዋ ሁበቹ ህንደንደኡ ቱሬ። ከናፉ ዮሴፍ እልማንሳ እስራኤልት ዽኤሴ፤ እስራኤልስ እሳን ዹንገቴ፤ እሳን ሀመቴስ።<verse eid="GEN 48:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 48:11"/>እስራኤልስ ዮሴፊን፣ “አን ፉሉመ ኬዩ ነንአርገ ጄዼ ህንያድኔ፤ ዋቅን ገሩ አከ አን እጆሌ ኬዩ አርጉ ና ኤየሜ” ጄዼ።<verse eid="GEN 48:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 48:12"/>ዮሴፍስ ጅልበ እስራኤልራ አች እሳን ቡቴ ፉለሳቲን ለፈት ገድ ጎምብፈሜ። <verse eid="GEN 48:12"/><verse number="13" style="v" sid="GEN 48:13"/>እንስ ኤርገሲ ለማንሳኒዩ ፉዼ ኤፍሬምን ከራ ምርገሳቲን ገረ ሀርከ እስራኤል እሰ ብታት፣ ምናሴሞ ብታሳቲን ገረ ሀርከ እስራኤል እሰ ምርጋት ፍዴ እሰት ዽኤሴ። <verse eid="GEN 48:13"/><verse number="14" style="v" sid="GEN 48:14"/>እስራኤል ገሩ ኡቱመ ኤፍሬም ቁጥሱ ተኤ ጅሩ ሀርከሳ ምርጋ መታ ኤፍሬምራ ካኤ፤ ምናሴንሞ ኡቱመ ሀንገፈ ተኤ ጅሩ እስራኤል ሀርከሳ ወል ቀጣሙርሴ ሀርከሳ ብታ መታ ምናሴረ ካኤ።<verse eid="GEN 48:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 48:15"/>እንስ አከነ ጄዼ ዮሴፍን ኤብሴ፤</para>
  <para style="q1" vid="GEN 48:15">“ዋቅን እን አቦቲንኮ አብረሃሚፊ ይስሃቅ</para>
  <para style="q2" vid="GEN 48:15">ፉለሳ ዱረ ጅራተን፣</para>
  <para style="q1" vid="GEN 48:15">ዋቅን እን በረ ጅሬኘኮ ጉቱ</para>
  <para style="q2" vid="GEN 48:15">ሀመ ሀርኣት ትክሴኮ ቱሬ ሱን፣<verse eid="GEN 48:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="GEN 48:16"/>ኤርገማን ዋቀዮ ከን በላ ሁንደ ጀላ ነ ባሴ ሱን</para>
  <para style="q2" vid="GEN 48:16">እልማን ከኔን ሃኤብሱ።</para>
  <para style="q1" vid="GEN 48:16">እሳን መቃኮቲን፣</para>
  <para style="q2" vid="GEN 48:16">መቃ አቦቲኮ አብረሃሚፊ</para>
  <para style="q1" vid="GEN 48:16">ይስሃቂን ሃዋመመን፤</para>
  <para style="q2" vid="GEN 48:16">እሳን ለፈረት ጉዳ ሃባይአተን።”<verse eid="GEN 48:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 48:17"/>ዮሴፍ ዮሙ አከ አባንሳ ሀርከሳ ምርጋ መታ ኤፍሬምራ ካኤ አርጌት ንገዴ፤ ከናፉ እን ሀርከ አባሳ መታ ኤፍሬምራ ፉዼ መታ ምናሴረ ካኡፍ ጄዼ ካሴ። <verse eid="GEN 48:17"/><verse number="18" style="v" sid="GEN 48:18"/>ዮሴፍ አባሳቲን፣ “ያ አባኮ፣ አከስ ምት፤ እን ኩን ሀንገፈ፤ ሀርከኬ ምርጋ መታሳረ ካእ” ጄዼ።<verse eid="GEN 48:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 48:19"/>አባንሳ ገሩ ድዴ አከነ ጄዼን፤ “አን ነንቤከ፤ ያ እልመኮ ነንቤከ። እንስ ሰበ ተአ፤ ሰበ ጉዳሳ ተአ። ተኡስ ኦቦሌስሳ እን ቁጥሱን እሰ ጫላ ጉዳ ተአ፤ ሰኚንሳስ ቱተ ሰበ ባይኤ ንተአ።” <verse eid="GEN 48:19"/><verse number="20" style="v" sid="GEN 48:20"/>እንስ ጋፈ ሰነ አከነ ጄዼ እሳን ኤብሴ፤</para>
  <para style="q1" vid="GEN 48:20">“እስራኤል መቃኬቲን ኤበ ከነ ኬነ፤</para>
  <para style="q2" vid="GEN 48:20">‘ዋቅን አከ ኤፍሬሚፊ አከ ምናሴ እስን ሃታስሱ።’ ”</para>
  <para style="m" vid="GEN 48:20">ዮሴፍስ አከሲን ምናሴ ዱረ ኤፍሬምን ደበርሴ።<verse eid="GEN 48:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 48:21"/>ኤርገሲ እስራኤል ዮሴፊን አከነ ጄዼ፤ “ኩኖ አን ዱኡ ገኤረ፤ ዋቅን ገሩ እስን ወጅን ተኤ ብየ አባኬሰኒት እስን ዴብሰ። <verse eid="GEN 48:21"/><verse number="22" style="v" sid="GEN 48:22"/>አን ቆደ ኦቦሎተኬቲ ጫልችሴ ቆደ ቶኮ ሲፍን ኬነ፤ ኩንስ ለፈ ኦል ከኣ አን አሞሮተራ ጎራዴኮፊ እዳኮቲን ፉዸዼ ሰናዸ።”<verse eid="GEN 48:22"/></para>
  <chapter eid="GEN 48"/>
  <chapter number="49" style="c" sid="GEN 49"/>
  <para style="s1">ያቆብ እልማንሳ ኤብሴ</para>
  <para style="r">
    <ref loc="GEN 49:1-28">49፥1‑28</ref> ኩወእ – <char style="xt"><ref loc="DEU 33:1-29">ኬዴ 33፥1‑29</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 49:1"/>ያቆብ እልማንሳ ኦፍት ዋሜ አከነ ጄዼ፦ “አከ አን ዋን በረ ዹማ ኬሰ እስንት ዹፉ እስንት ህሙፍ ሜ ወልት ቀበማ።<verse eid="GEN 49:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="GEN 49:2"/>“ያ እልማን ያቆብ ሜ ወልት ቀበማ ዸጌፈዻ፤</para>
  <para style="q2" vid="GEN 49:2">አባኬሰን እስራኤልን ዸጌፈዻ።<verse eid="GEN 49:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="GEN 49:3"/>“ያ ሩቤን፣ አት እልመኮ ሀንገፈ፤</para>
  <para style="q2" vid="GEN 49:3">ሁምነኮ፣ መለቶ ጀልቀባ ከን ጀብነኮቲት፤</para>
  <para style="q2" vid="GEN 49:3">አት ኡልፍናን ንጫልተ፤ ሁምናንሌ ንጫልተ።<verse eid="GEN 49:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="GEN 49:4"/>አት አከ ብሻኒ አሲፊ አች ራፈምተ፤ ኦል ኣንቱማስ ህንቀባቱ፤</para>
  <para style="q2" vid="GEN 49:4">አት ስሬ አባኬቲት ኦል ባቴ፣</para>
  <para style="q2" vid="GEN 49:4">አፈተኮት ኦል ባቴ ጡሬስቴርታቲ።<verse eid="GEN 49:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="GEN 49:5"/>“ስምኦኒፊ ሌዊን ኦቦሎተ፤</para>
  <para style="q2" vid="GEN 49:5">ጎራዴንሳኒ ምአ ፍንጭላት።<verse eid="GEN 49:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="GEN 49:6"/>ሉቡንኮ መሪሳኒት ህንሴንን፤</para>
  <para style="q2" vid="GEN 49:6">ኡልፍንኮስ ያኢሳኒት ህንደበለምን፤</para>
  <para style="q1" vid="GEN 49:6">እሳን ዼከምሰሳኒቲን ነመ አጄሰኒሩቲ፤</para>
  <para style="q2" vid="GEN 49:6">ፌዺ ኦፊሳኒቲንስ ቆትዮ ናፈቺሰኒሩ።<verse eid="GEN 49:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="GEN 49:7"/>ኣሪንሳኒ እን ሀማን፣</para>
  <para style="q2" vid="GEN 49:7">ዼከምስሳኒ እን ገረ ጀቤስ አባረማ ሃተኡ!</para>
  <para style="q1" vid="GEN 49:7">አን ያቆብ ኬሰ እሳን ነንብትኔሰ፤</para>
  <para style="q2" vid="GEN 49:7">እስራኤል ኬሰስ እሳን ነንፈጫሰ።<verse eid="GEN 49:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="GEN 49:8"/>“ያ ይሁዳ ኦቦሎትንኬ ስ ሌልሱ፤</para>
  <para style="q2" vid="GEN 49:8">ሀርክኬ ሞርመ ዲነኬቲ ቀበ፤</para>
  <para style="q2" vid="GEN 49:8">እልማን አባኬቲ ሲፍ ሰገዱ።<verse eid="GEN 49:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="GEN 49:9"/>ያ ይሁዳ አት ሳፌለ ሌንጫት፤</para>
  <para style="q2" vid="GEN 49:9">ያ እልመኮ አት አደሞዻ ዴብተ።</para>
  <para style="q1" vid="GEN 49:9">እን አከ ሌንጫ፣ አከ ሌንጨ ዸላስ፣ ርጴ ጪሰ፤</para>
  <para style="q2" vid="GEN 49:9">ኤኙቱ እጀ ጀባቴ እሰ ካሰሬ?<verse eid="GEN 49:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="GEN 49:10"/>ሀመ ቡልቻን ዹፉት</para>
  <para style="q2" vid="GEN 49:10">ቦኩን ሀርከ ይሁዳቲ፣</para>
  <para style="q1" vid="GEN 49:10">ኡሌን ቡልቺንሳ ሚለሳ ግዱዻ ህንዸበሙ፤</para>
  <para style="q2" vid="GEN 49:10">ሰቦትንስ እሳፍ ንአጀጀሙ።<verse eid="GEN 49:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="GEN 49:11"/>እን ሀሬሳ ሙከ ወይኒት፣</para>
  <para style="q2" vid="GEN 49:11">እልሞ ሀሬሳሞ ደሜ ፍለተማት ህዸተ፤</para>
  <para style="q1" vid="GEN 49:11">ወያሳ ዳዺ ወይኒቲን፣</para>
  <para style="q2" vid="GEN 49:11">ወንደቦሳሞ ዺገ ጉማ ወይኒቲን ሚጨተ።<verse eid="GEN 49:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="GEN 49:12"/>እጅሳ ዳዺ ወይኒረ ዲመተ፤</para>
  <para style="q2" vid="GEN 49:12">እልካንሳሞ ኣነንረ አዳተ።<verse eid="GEN 49:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="GEN 49:13"/>“ዜቡሎን ቀርቀረ ገላና ጅራተ፤</para>
  <para style="q2" vid="GEN 49:13">ቡፈተ ዶኒወኒስ ተአ፤</para>
  <para style="q2" vid="GEN 49:13">ዳንጋንሳስ ሀመ ሲዶናት በልአተ።<verse eid="GEN 49:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="GEN 49:14"/>“ይሳኮር ሀሬ ጀባ</para>
  <para style="q2" vid="GEN 49:14">ፌኢሰ ለመ ግዱ ጪሱዸ።<verse eid="GEN 49:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="GEN 49:15"/>እንስ ዬሮ አከ እዶን ቦቆናሳ ሀመም ጋሪ ተኤፊ</para>
  <para style="q2" vid="GEN 49:15">አከ ለፍትሳ ቶላ ተኤ አርጉት</para>
  <para style="q1" vid="GEN 49:15">በኣ ባቹፍ ገቲቲሳ ገድ ቀበተ፤</para>
  <para style="q2" vid="GEN 49:15">ሆጂ ሁምና ሆጄቹፍ ኦፍ ኬነ።<verse eid="GEN 49:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="GEN 49:16"/>“ዳን ጎሶተ እስራኤል ኬሳ አከ እሰ ቶኮት፣</para>
  <para style="q2" vid="GEN 49:16">ሰበሳቲፍ ሙርቲ ቀጄላ ንኬነ።<verse eid="GEN 49:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="GEN 49:17"/>ዳን ቦፈ ቀርቀረ ከራት፤</para>
  <para style="q2" vid="GEN 49:17">አከ ቡቲ ዳንዲራ፣</para>
  <para style="q1" vid="GEN 49:17">ከን አከ ነምች ፈርደ ያበቱ ገረ ዱባት ኩፉፍ</para>
  <para style="q2" vid="GEN 49:17">ኮቴ ፈርዳ እዱ ንተአ።<verse eid="GEN 49:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="GEN 49:18"/>“ያ <char style="nd">ዋቀዮ</char>፣ አን ፈይሱኬ ነንኤገዸ።<verse eid="GEN 49:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="GEN 49:19"/>“ጋድ ዌረርቶታን ንዸአመ፤</para>
  <para style="q2" vid="GEN 49:19">እን ገሩ ፋነ ቡኤ እሳን ዸአ።<verse eid="GEN 49:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="GEN 49:20"/>“ኣሼር ቡዴንሳ ፉርዳዸ፤</para>
  <para style="q2" vid="GEN 49:20">እን ሞቲዻፍ ኛተ ቶላ ንኬነ።<verse eid="GEN 49:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="GEN 49:21"/>“ንፍታሌም ቦሮፈ ሂከምቴዸ፤</para>
  <para style="q2" vid="GEN 49:21">ዱቢ ጋሪስ ንዱበተ።<verse eid="GEN 49:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="GEN 49:22"/>“ዮሴፍ ሙከ ወይኒ እጀ ቀቤሰ፣</para>
  <para style="q2" vid="GEN 49:22">ሙከ ወይኒ እጀ ቀቤሰ ቡርቃ ብሻኒት ዽኦ ጅሩዸ፤</para>
  <para style="q2" vid="GEN 49:22">ደሜንሳ ደላረ ያአ።<verse eid="GEN 49:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="GEN 49:23"/>ወር እዳ ቀበተን ወራነ እሰት በነን፤</para>
  <para style="q2" vid="GEN 49:23">እሰት ፉታሰን፤ እሰ ጅበንስ።<verse eid="GEN 49:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="GEN 49:24"/>ገሩ እዳንሳ ጀባቴ ሀፌ፤</para>
  <para style="q2" vid="GEN 49:24">እሬን ሀርከሳ፣</para>
  <para style="q1" vid="GEN 49:24">ሀርከ ዋቀ ጀባ ያቆቢን ጀቤፈሜ።</para>
  <para style="q2" vid="GEN 49:24">አቺስ ትክሴ ሰናን፣ ከታ እስራኤሊን፣<verse eid="GEN 49:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="GEN 49:25"/>ዋቀ አባኬቲ እሰ ስ ገርጋሩን፣</para>
  <para style="q2" vid="GEN 49:25">ዋቀ ዋን ሁንደ ደንደኡ እሰ</para>
  <para style="q1" vid="GEN 49:25">ኤበ ሰሚ ጉባቲን፣</para>
  <para style="q2" vid="GEN 49:25">ኤበ ገድ ፈጎ እሰ ጀላቲን፣</para>
  <para style="q2" vid="GEN 49:25">ኤበ ሀርማቲፊ ገደሜሳቲን ስኤብሱ ሰናን <optbreak/> ንኤብፈምተ።<verse eid="GEN 49:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="GEN 49:26"/>ኤብ አባኬቲ፣</para>
  <para style="q2" vid="GEN 49:26">ኤበ ቱሉወን ዱሪ፣</para>
  <para style="q2" vid="GEN 49:26">አርጁማ ጋረን ዱሪ ጫለ።</para>
  <para style="q1" vid="GEN 49:26">ኩን ሁንድ መታ ዮሴፊት፣</para>
  <para style="q2" vid="GEN 49:26">ጉቤ መታ እሰ ኦቦሎተሳ ኬሳ <optbreak/> ሆገና ተኤት ሃቀበቱ።<verse eid="GEN 49:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="GEN 49:27"/>“ቤንያም ዬዪ ባይኤ ቤለኤዸ፤</para>
  <para style="q2" vid="GEN 49:27">ገነመ ዋን አደምሴ እት ገገቤ ኛተ፤</para>
  <para style="q2" vid="GEN 49:27">ገልገለሞ ቦጁ ህረ።”<verse eid="GEN 49:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 49:28"/>ወር ኩኔን ሁንድ ጎሶተ እስራኤል ኩዸ ለማን፤ ኩንስ ዋን አባንሳኒ ዬሮ ኤበ ቶኮ ቶኮ እሳኒፍ ተኡን እሳን ኤብሴት እሳንት ዱበቴዸ።<verse eid="GEN 49:28"/></para>
  <para style="s1">ያቆብ ዱኡሳ</para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 49:29"/>ኤርገሲስ ያቆብ አከነ ጄዼ እሳን አጀጄ፤ “አን ገረ ሰበኮቲት ወልት ቀበሙ ገኤረ፤ ሆልቀ ለፈ ቆቲሳ ኤፍሮን ነምቸ ጎሰ ሄት ሰናት አቦቲኮ ብረት ነ አዋላ። <verse eid="GEN 49:29"/><verse number="30" style="v" sid="GEN 49:30"/>ሆልቅ ኩንስ ሆልቀ ብየ ከነኣን ኬሰት መምሬ ብረት ለፈ ቆቲሳ መክፌላ ኬሰት አርገሙ ከን አብረሃም እዶ አዋላ ጎዸቹፍ ኤፍሮን ነምቸ ጎሰ ሄት ሰነራ ለፈ ቆቲሳ ወጅን ብተቴዸ። <verse eid="GEN 49:30"/><verse number="31" style="v" sid="GEN 49:31"/>አብረሃሚፊ ኒቲንሳ ሳራን አችት አዋለመን፤ ይስሃቂፊ ኒቲንሳ ርብቃን አችት አዋለመን፤ አንስ አቹመተን ልያ አዋሌ። <verse eid="GEN 49:31"/><verse number="32" style="v" sid="GEN 49:32"/>ለፍት ቆቲሳቲፊ ሆልቅ እሰ ኬሰ ጅሩ ሄቶተራ ብተመን።”<verse eid="GEN 49:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 49:33"/>ያቆብ አኩመ እልማንሳ አጀጁ ራወቴን ሚለሳ ስሬረት ኦል ዴብፈቴ ሀፉረ ዹማ ባፈቴ፤ ገረ ሰበ እሳትስ ወልት ቀበሜ።<verse eid="GEN 49:33"/></para>
  <chapter eid="GEN 49"/>
  <chapter number="50" style="c" sid="GEN 50"/>
  <para style="p">
    <verse number="1" style="v" sid="GEN 50:1"/>ዮሴፍስ አባሳረት ኩፌ ቦኤፍ፤ እሰ ዹንገቴስ። <verse eid="GEN 50:1"/><verse number="2" style="v" sid="GEN 50:2"/>ኤርገሲሞ ዮሴፍ ተጃጅልቶተሳ ከኔን ኦጌሶተ ፈያ ተአን አከ እሳን ሬፈ አባሳ ቆርቻን ሱኩመን አጀጄ፤ ጀርስ ሬፈ እስራኤል ቆርቻን ሱኩመን፤ <verse eid="GEN 50:2"/><verse number="3" style="v" sid="GEN 50:3"/>ዋን ከነ ጎቹን ቡልቲ አፉርተመ ጉቱ እሳንት ፉዸቴ፤ ዬሮን ቆርቸ ሬፈ ድቡፍ በርባችሱ ከነ ቱሬቲ። ወር ግብጢስ ቡልቲ ቶርባተመ እሳፍ ቦአን።<verse eid="GEN 50:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 50:4"/>ጉዮትን ገዳ ደርብናን ዮሴፍ ወረ መነ ፈረኦን ጅራተኒን አከነ ጄዼ፤ “ዮ አን ፉለኬሰን ዱረት ፉዸተመ አርገዼረ ተኤ፣ አከነ ጄዻቲ ፈረኦንት ና ህማ፦ <verse eid="GEN 50:4"/><verse number="5" style="v" sid="GEN 50:5"/>‘አባንኮ አከነ ጄዼ ነ ከከቺሴረ፤ “ኩኖ አን ዱኡ ገኤረ፤ አዋለ አን ብየ ከነኣን ኬሰት ኦፊኮቲፍ ቆተዼት ነ አዋላ።” ከናፉ ማሎ አን አመ ዸቄ አባኮ ነንአዋለዸ፤ ኤርገሲሞ ነንዴብአ።’ ”<verse eid="GEN 50:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 50:6"/>ፈረኦንስ፣ “ዸቂቲ አኩመ እን ስ ከከቺሴ ሰነት አባኬ አዋለዹ” ጄዼን።<verse eid="GEN 50:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 50:7"/>ዮሴፍስ አባሳ አዋለቹ ዸቄ። ቆንዳልቶትን ፈረኦን ሁንድኑ ሀንገፎትን መነሳቲፊ ሀንገፎትን ግብጥ ሁንድ እሰ ወጅን ዴመን። <verse eid="GEN 50:7"/><verse number="8" style="v" sid="GEN 50:8"/>አከሱመስ ወር መነ ዮሴፍ ጅራተን፣ ኦቦሎተሳቲፊ ወር መነ አባሳ ጅራተን ሁንድ እሰ ወጅን ዴመን። እጆሌሳኒ፣ ቡሻዬሳኒቲፊ ሎንሳኒ ቆፈቱ፣ ጎሼንት ሀፌ። <verse eid="GEN 50:8"/><verse number="9" style="v" sid="GEN 50:9"/>ጋሪወኒፊ ወር ፈርደ ያበተንስ እሰ ወጅን ዴመን። ቱትን ሱንስ አከ መሌ ጉዳ ቱሬ።<verse eid="GEN 50:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 50:10"/>እሳንስ ዮሙ ዮርዳኖስ ገመ ኦብዲ አጣድ ብረ ገአንት ሰገሌሳኒ ኦል ፉዸተኒ ገዶደኒ ቦአን። ዮሴፍስ አችት አባሳቲፍ ጉያ ቶርበ ቦኤ። <verse eid="GEN 50:10"/><verse number="11" style="v" sid="GEN 50:11"/>ነሞትን ከነኣን ወር አች ጅራቻ ቱረን ቦእቸ ኦብዲ አጣድ ብረት ቦአሜ ሰነ አርገኒ፣ “ቦእች ኩን ወረ ግብጢቲፍ ቦእቸ ጉዳዸ” ጄዸን። ከናፉ እዶን ሱን አቤል ምስራይም ጄዸሜ ሞጋፈሜ። እዶን ሱንስ ዮርዳኖስ ገመት አርገመ።<verse eid="GEN 50:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 50:12"/>እልማን ያቆብ አኩመ እን እሳን አጀጄ ሰነ ጎዸን፤ <verse eid="GEN 50:12"/><verse number="13" style="v" sid="GEN 50:13"/>እሳንስ ብየ ከነኣንት እሰ ጌሰኒ ሆልቀ መምሬ ብረት ለፈ ቆቲሳ መክፌላ ኬሰት አርገሙ ከን አብረሃም እዶ አዋላ ጎዸቹዻፍ ኤፍሮን ነምቸ ጎሰ ሄት ሰነረ ለፈ ቆቲሳ ወጅን ብተቴ ሰነት አዋለን። <verse eid="GEN 50:13"/><verse number="14" style="v" sid="GEN 50:14"/>ዮሴፍ ኤርገ አባሳ አዋለቴ ቦዴ ኦቦሎተሳቲፊ ወረ እሰ ወጅን አባሳ አዋሉ ዸቀን ሁንደ ወጅን ግብጥት ዴብኤ።<verse eid="GEN 50:14"/></para>
  <para style="s1">ዮሴፍ ኦቦሎተሳ ጀጀቤሴ</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 50:15"/>ኦቦሎትን ዮሴፍ ኤርገ አባንሳኒ ዱኤ ቦዴ፣ “ዮ ዮሴፍ ሀማ ኑ እሰት ሆጄትኔ ሁንዳፍ ሃሎ ቀበቴ ሃሎ ኑት በኤሆ?” ጄዸን። <verse eid="GEN 50:15"/><verse number="16" style="v" sid="GEN 50:16"/>እሳንስ አከነ ጄዸኒ ዮሴፍት ዻመተን፤ “አባንኬ ኡቱ ህንዱእን ዱረ አከነ ጄዼ አጀጄ፤ <verse eid="GEN 50:16"/><verse number="17" style="v" sid="GEN 50:17"/>‘እስን አከነ ጄዻ ዮሴፍት ህማ፤ አን አከ አት ጩቡፊ በሌሳ ኦቦሎትንኬ ስ ሚዹፍ ጄዸኒ ስት ሆጄተን ሰነሳኒ ዺፍቱ ስን ከዸዸ።’ ማሎ ጩቡ ተጃጅልቶተ ዋቀ አባኬቲ ዺስ።” ዮሴፍስ ዮሙ ኤርጋሳኒ ዸገኤት ንቦኤ።<verse eid="GEN 50:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 50:18"/>ኦቦሎትንሳስ ዹፈኒ ፉለሳ ዱረት ለፈ ዸአኒ፣ “ኩኖ ኑ ገርቦተኬት” ጄዸን።<verse eid="GEN 50:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 50:19"/>ዮሴፍ ገሩ አከነ እሳኒን ጄዼ፤ “ህንሶዳትና። አነቱ እዶ ዋቃ ቡኣ? <verse eid="GEN 50:19"/><verse number="20" style="v" sid="GEN 50:20"/>እስን ሀማ ነት ያደን፤ ዋቅን ገሩ አኩመ አመ ተኤ ጅሩ ከነ ሉቡ ነመ ባይኤ በራሩፍ ጄዼ ዋን ጋሪፍ ያዴ። <verse eid="GEN 50:20"/><verse number="21" style="v" sid="GEN 50:21"/>ኤጋ ህንሶዳትና። አን እስኒፊ እጆሌኬሰን ነንሶራቲ።” እንስ ዋን ገራ እሳን ጪብሱ እሳንት ዱበቴ እሳን ጀጀቤሴ።<verse eid="GEN 50:21"/></para>
  <para style="s1">ዮሴፍ ዱኡሳ</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 50:22"/>ዮሴፍ ማቲ አባሳ ወጅን ግብጥ ኬሰ ቱሬ። እንስ ወጋ ዽበ ቶኮፊ ኩዸን ጅራቴ። <verse eid="GEN 50:22"/><verse number="23" style="v" sid="GEN 50:23"/>ዸሎተ ሰደፋ እጆሌ ኤፍሬም አርጌ። አከሱመስ እልማን ማኪር እልመ ምናሴ ጅልበ ዮሴፍረት ዸለተን።<verse eid="GEN 50:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 50:24"/>ዮሴፍስ ኦቦሎተሳቲን አከነ ጄዼ፤ “አን ዱኡ ገኤረ። ዋቅን ገሩ ዹጉማን ዹፌ እስን ገርጋረ፤ ብየ ከና እስን ባሴስ ገረ ብየ አብረሃሚፍ፣ ይስሃቂፊ ያቆቢፍ ከኩን ዋዳ ገሌ ሰናት እስን ጌሰ።” <verse eid="GEN 50:24"/><verse number="25" style="v" sid="GEN 50:25"/>ዮሴፍስ እጆሌ እስራኤል ከከቺሴ አከነ ጄዼን፤ “ዋቅን ዹጉማን ዹፌ እስን ገርጋረ፤ እስንስ ለፌኮ ብየ ከና ኦል ባሱ ቀብዱ።”<verse eid="GEN 50:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 50:26"/>ዮሴፍስ ወጋ ዽበ ቶኮፊ ኩዸንት ዱኤ። ጀርስ ቆርቻን ሱኩመኒ ግብጥት ሰንዱቀ ሬፋ ኬሰ እሰ ካአን።<verse eid="GEN 50:26"/></para>
  <chapter eid="GEN 50"/>
</usx>
