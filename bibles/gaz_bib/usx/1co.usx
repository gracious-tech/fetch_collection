<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1CO" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">1 ቆሮንቶስ</para>
  <para style="toc1">ቆሮንቶስ ቶኮፋ</para>
  <para style="toc2">1 ቆሮንቶስ</para>
  <para style="toc3">1ቆሮ</para>
  <para style="mt1">ቆሮንቶስ</para>
  <para style="mt2">ቶኮፋ</para>
  <chapter number="1" style="c" sid="1CO 1"/>
  <para style="po">
    <verse number="1" style="v" sid="1CO 1:1"/>ጳዉሎስ እሰ አከ ኤርገማ ክርስቶስ ዬሱስ ተኡፍ ፌዺ ዋቃቲን ዋመሜፊ ኦቦሌሰኬኘ ሶስቴንስራ።<verse eid="1CO 1:1"/></para>
  <para style="po">
    <verse number="2" style="v" sid="1CO 1:2"/>ገረ ወልዳ ዋቃ እሼ ቆሮንቶስ ኬሰ ጅርቱት፣ ገረ ወረ ክርስቶስ ዬሱሲን ቁልቁሌፈመኒፊ ወረ ለፈ ሁንዳ ከኔን መቃ ጎፍታኬኘ ዬሱስ ክርስቶስ እሰ ጎፍታሳኒቲፊ ጎፍታኬኘስ ተኤ ሰና ዋመተን ሁንደ ወጅን ቁልቁሎተ ተኡፍ ዋመመኒት።<verse eid="1CO 1:2"/></para>
  <para style="po">
    <verse number="3" style="v" sid="1CO 1:3"/>አያኒፊ ነጋን አባኬኘ ዋቃፊ ዬሱስ ክርስቶስ ጎፍታራ እስኒፍ ሃተኡ።<verse eid="1CO 1:3"/></para>
  <para style="s1">ገለተ ገልቹ</para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 1:4"/>አን ዬሮ ሁንደ አያነ ዋቃ እሰ ክርስቶስ ዬሱሲን እስኒ ኬነሜፍ ዋኤኬሰኒፍ ዋቀ ነንገለቴፈዸ። <verse eid="1CO 1:4"/><verse number="5" style="v" sid="1CO 1:5"/>እስንስ ከራ ሁንዳን ጄቹንስ ዱቢፊ ቤኩምሰ ሁንዳን እሳን በዻተኒርቱ፤ <verse eid="1CO 1:5"/><verse number="6" style="v" sid="1CO 1:6"/>ወንት ኑ ዋኤ ክርስቶስ ዹጋ ባኔ ሱን እስን ግዱት ምርከኔፈሜራቲ። <verse eid="1CO 1:6"/><verse number="7" style="v" sid="1CO 1:7"/>ከናፉ ኡቱ ሙልአቹ ጎፍታኬኘ ዬሱስ ክርስቶስ ኤገቻ ጅርተኑ ኬናን ሀፉራ ቶኮዩ እስን ጀላ ህንህርአቱ። <verse eid="1CO 1:7"/><verse number="8" style="v" sid="1CO 1:8"/>አከ እስን ጉያ ጎፍታኬኘ ዬሱስ ክርስቶስት ወረ ሙዳ ህንቀብኔ ታተኒፍስ እን ሀመ ዹማት ጀቤሴ እስን ኤገ። <verse eid="1CO 1:8"/><verse number="9" style="v" sid="1CO 1:9"/>ዋቅን ገረ ቶኩማ እልመሳ ጎፍታኬኘ ዬሱስ ክርስቶስት እስን ዋሜ ሱን አመነማዸ።<verse eid="1CO 1:9"/></para>
  <para style="s1">ገርገር በኡ ወልዳ ክርስታና</para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 1:10"/>ያ ኦቦሎተ፣ አን አከ እስን ግዱ ገርገር በኡን ህንጅራትኔፊ አከ ቀልቢፊ ያደ ቶኮ ቀባተኒ ሁንድኬሰን ወሊ ገልተኒፍ መቃ ጎፍታኬኘ ዬሱስ ክርስቶሲን እስን ከዸዸ። <verse eid="1CO 1:10"/><verse number="11" style="v" sid="1CO 1:11"/>ያ ኦቦሎተኮ፣ አከ እስን ግዱ ሎል ጅሩ ወር መነ ቀሎኤ ጅራተን ቶኮ ቶኮ ነት ህመኒሩ። <verse eid="1CO 1:11"/><verse number="12" style="v" sid="1CO 1:12"/>ወንት አን ጄዹስ ከነ፦ እስን ኬሳ ነምን ቶኮ፣ “አን ከን ጳዉሎስ” ጄዸ፤ እን ካን፣ “አን ከን አጵሎስ” ጄዸ፤ ካንስ፣ “አን ከን ኬፋት” ጄዸ፤ ካንሞ፣ “አን ከን ክርስቶስ” ጄዸ።<verse eid="1CO 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 1:13"/>ክርስቶስ ገርገር ቆደሜራ? ጳዉሎስቱ እስኒ ፈንፈሜሬ? ዮካን መቃ ጳዉሎሲን ጩጰምተኒ? <verse eid="1CO 1:13"/><verse number="14" style="v" sid="1CO 1:14"/>አን ክሪስጶሲፊ ጋዮስን መሌ እስን ኬሳ ነመ ቶኮሌ ዋን ህንጩጵኒፍ ዋቀ ነንገለቴፈዸ። <verse eid="1CO 1:14"/><verse number="15" style="v" sid="1CO 1:15"/>ከናፍ ነምን አከ እስን መቃኮቲን ጩጰምተን ዱበቹ ደንደኡ ቶኮዩ ህንጅሩ። <verse eid="1CO 1:15"/><verse number="16" style="v" sid="1CO 1:16"/>ኤዬ፣ አን ወረ መነ እስጢፋኖስ ጅራተንስ አከሱመ ጩጴረ፤ ሰናን አለት ነመ ብራ ቶኮሌ ጩጱኮ ህንያደዹ። <verse eid="1CO 1:16"/><verse number="17" style="v" sid="1CO 1:17"/>ክርስቶስ አከ አን ወንጌለ ለለቡፍ መሌ አከ አን ጩጱፍ ነ ህንኤርግኔቲ፤ አንስ አከ ፈኖን ክርስቶስ ሁምነ ህንዸብኔፍ ዱቢ ኦጉማ ነማቲን ህንለለቡ።<verse eid="1CO 1:17"/></para>
  <para style="s1">ክርስቶስ ኦጉማፊ ሁምነ ዋቃት</para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18"/>ዱቢን ፈኖ ወረ በዱፍ ጅረኒፍ ጎዉማዻቲ፤ ኑ ወረ ፈይኑፍ ገሩ ሁምነ ዋቃት። <verse eid="1CO 1:18"/><verse number="19" style="v" sid="1CO 1:19"/>ኩንስ፣</para>
  <para style="q1" vid="1CO 1:19">“አን ኦጉማ ኦጌዪ ነንበሌሰ፤</para>
  <para style="q2" vid="1CO 1:19">ሁበትና ሁበቶታስ ነንፈሸሌሰ”<note caller="+" style="f"><char style="fr" closed="false">1፥19 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 29:14">እሳ 29፥14</ref></char></char></note></para>
  <para style="m" vid="1CO 1:19">ጄዸሜ በሬፈሜረ።<verse eid="1CO 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 1:20"/>ነምን ኦጌስ ኤሰ ጅረ? ሀዩን ኤሰ ጅረ? ፈላሰማን በረ ከና ኤሰ ጅረ? ዋቅን ኦጉማ አዱኛ ከና ጎዉማ ህንጎኔሬ? <verse eid="1CO 1:20"/><verse number="21" style="v" sid="1CO 1:21"/>ሰበቢ ኦጉማ ዋቃቲን አዱኛን ከራ ኦጉማሼቲን ዋቀ ዋን ህንቤክኒፍ፣ ዋቅን ጎዉማ ለለባቲን ወረ አመነን ፈይሱ ጃለቴ። <verse eid="1CO 1:21"/><verse number="22" style="v" sid="1CO 1:22"/>ይሁዶትን መለቶ ፌዹ፤ ግሪኮትንሞ ኦጉማ በርባዱ፤ <verse eid="1CO 1:22"/><verse number="23" style="v" sid="1CO 1:23"/>ኑ ገሩ ክርስቶስ እሰ ፈንፈሜ ሰነ ለለብነ፤ እንስ ይሁዶተት ጉፉዸ፤ ነሞተ ኦርማቲፍሞ ጎዉማዸ፤ <verse eid="1CO 1:23"/><verse number="24" style="v" sid="1CO 1:24"/>ወረ ዋመመኒፍ ገሩ ይሁዶታፍስ ተኡ ግሪኮታፍ ክርስቶስ ሁምነ ዋቃቲፊ ኦጉማ ዋቃት። <verse eid="1CO 1:24"/><verse number="25" style="v" sid="1CO 1:25"/>ጎዉማን ዋቃ ኦጉማ ነማ ጫላ ኦጌሳቲ፤ ደዸቢን ዋቃስ ጀብነ ነማረ ጀባዸ።<verse eid="1CO 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 1:26"/>ያ ኦቦሎተ፣ እስን ዬሮ ዋመምተንት ማል አከ ቱርተን ያደዻ። አከ እላልቸ ነማት ባይኤንኬሰን ኦጌዪ ህንቱሬ፤ ባይኤንኬሰንስ ቤከሞ ህንቱሬ፤ ባይኤንኬሰንሞ ሰኚ ወረ ጉርጉዳራ ህንዸለትኔ። <verse eid="1CO 1:26"/><verse number="27" style="v" sid="1CO 1:27"/>ዋቅን ገሩ ኦጌዪ ቃኔሱፍ ጄዼ ዋን አዱኛረት ጎዋ ተኤ ፍለቴ፤ ዋቅን ወረ ጀጀቤዪ ቃኔሱፍ ጄዼ ዋን አዱኛረት ደዸባ ተኤ ፍለቴ። <verse eid="1CO 1:27"/><verse number="28" style="v" sid="1CO 1:28"/>ዋቅን ዋን ጅሩ ዋን ህንጅሬ ጎቹፍ፣ ዋን አዱኛ ከነረት ገድ ኣናፊ ቱፈተማ ተኤ፣ ዋን እዶ ህንቀብኔስ ፍለቴ፤ <verse eid="1CO 1:28"/><verse number="29" style="v" sid="1CO 1:29"/>ኩንስ አከ ኤኙዩ እሰ ዱረት ኦፍ ህንጀጅኔፍ። <verse eid="1CO 1:29"/><verse number="30" style="v" sid="1CO 1:30"/>እስን ሰበቢሳቲን ከን ክርስቶስ ዬሱስ ታተን፤ እን ኦጉማኬኘ ከን ዋቀ ብራ ዹፌ ጄቹንስ ቀጄሉማኬኘ፣ ቁልቁሉማፊ ፉሪኬኘዸ። <verse eid="1CO 1:30"/><verse number="31" style="v" sid="1CO 1:31"/>ኩንስ አኩመ፣ “ነምን ኦፍ ጀጁ ጎፍታዻን ኦፍ ሃጀጁ”<note caller="+" style="f"><char style="fr" closed="false">1፥31 </char><char style="ft" closed="false"><char style="xt"><ref loc="JER 9:24">ኤር 9፥24</ref></char></char></note> ጄዸሜ በሬፈሜዸ።<verse eid="1CO 1:31"/></para>
  <chapter eid="1CO 1"/>
  <chapter number="2" style="c" sid="1CO 2"/>
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1"/>ያ ኦቦሎተ፣ አን ዬሮን ገረኬሰን ዹፌት፣ አፋን ቶሉን ዮካን ኦጉማ ጉዳዻን ዹገ በኡምሰ ዋኤ ዋቃ ለለባ ህንዹፍኔ። <verse eid="1CO 2:1"/><verse number="2" style="v" sid="1CO 2:2"/>አን ዬሮን እስን ብረ ቱሬት ዬሱስ ክርስቶስ እሰ ፈንፈሜ ሰነ መሌ አከ ዋን ቶኮሌ ህንቤክኔ ሙርቴሴን ቱሬቲ። <verse eid="1CO 2:2"/><verse number="3" style="v" sid="1CO 2:3"/>አን ደዸቢን፣ ሶዳፊ ሆለትና ጉዳዻን ገረኬሰን ዹፌ። <verse eid="1CO 2:3"/><verse number="4" style="v" sid="1CO 2:4"/>ኤርጋንኮፊ ለለብንኮ ሀፉራፊ ሁምነ አርግሲሱዻን መሌ ዱቢ ኦጉማፊ ሶሶቢ ኦፍ ኬሳ ቀቡን ህንቱሬ፤ <verse eid="1CO 2:4"/><verse number="5" style="v" sid="1CO 2:5"/>ኩንስ አከ አመንቲንኬሰን ሁምነ ዋቃረት መሌ ኦጉማ ነማረት ህንሁንዴፈምኔፍ።<verse eid="1CO 2:5"/></para>
  <para style="s1">ኦጉማ ሀፉረራ አርገሙ</para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6"/>ሃተኡ መሌ ኑ ወረ ብልቻተን ግዱት ኦጉማ ዱበትነ፤ ገሩ ኦጉማ አዱኛ ከና ዮካን ኦጉማ ቡልችቶተ አዱኛ ከና ከኔን በዱፍ ጅረኒ ምት። <verse eid="1CO 2:6"/><verse number="7" style="v" sid="1CO 2:7"/>ገሩ ኑ ኦጉማ ዋቃ፣ ኦጉማ ዾክፈሜ ቱሬ፣ እሰ ዋቅን ኡመመ አዱኛቲን ዱረ ኡልፍነኬኛፍ ጄዼ ሙርቴሴ ሰና እጪቲዻን ዱበትነ። <verse eid="1CO 2:7"/><verse number="8" style="v" sid="1CO 2:8"/>ቡልችቶተ አዱኛ ከና ኬሳ ቶኮዩ ኦጉማ ከነ ህንሁበትኔ፤ እሳን ኡቱ ሁበተኒ ጅራተኒ ስላ ጎፍታ ኡልፍና ህንፈንሰን ቱሬቲ። <verse eid="1CO 2:8"/><verse number="9" style="v" sid="1CO 2:9"/>ተኡዩ አኩመ፣</para>
  <para style="q1" vid="1CO 2:9">“ዋን ዋቅን ወረ እሰ ጃለተኒፍ ቆጴሴ</para>
  <para style="q2" vid="1CO 2:9">እጅ ህንአርግኔ፣</para>
  <para style="q1" vid="1CO 2:9">ጉር ህንዸጌኜ፣</para>
  <para style="q2" vid="1CO 2:9">ገራ ነማትስ ህንያደምኔ”<note caller="+" style="f"><char style="fr" closed="false">2፥9 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 64:4">እሳ 64፥4</ref></char></char></note></para>
  <para style="m" vid="1CO 2:9">ጄዸሜ በሬፈሜ ሰነ፣ <verse eid="1CO 2:9"/><verse number="10" style="v" sid="1CO 2:10"/>ዋቅን ገሩ ሀፉረሳቲን ዋን ከነ ኑት ሙልእሴረ።</para>
  <para style="p" vid="1CO 2:10">ሀፉር ወንቶተ ሁንደ፣ ወንቶተ ዋቃ ከኔን ገድ ፈጎ ተአንሌ ንቆረ። <verse eid="1CO 2:10"/><verse number="11" style="v" sid="1CO 2:11"/>ሀፉረ እሰ ኬሰ ጅሩ መሌ ያደ ነመ ቶኮ ኤኙቱ ቤከ? አከሱመሞ ሀፉረ ዋቃ መሌ ከን ያደ ዋቃ ቤኩ ቶኮዩ ህንጅሩ። <verse eid="1CO 2:11"/><verse number="12" style="v" sid="1CO 2:12"/>ኑ አከ ዋን ዋቅን ቶሉመ ኑ ኬኔ ሁበትኑፍ ሀፉረ ዋቀራ ዹፌ አርገትኔ መሌ ሀፉረ አዱኛ ህንአርገትኔ። <verse eid="1CO 2:12"/><verse number="13" style="v" sid="1CO 2:13"/>ወን ኑ ዱበትኑስ ከነ፤ ኑ ዱቢ ሀፉር ኑ በርሲሱን መሌ ዱቢ ኦጉማን ነማ በርሲሱን ህንዱበትኑ፤ ዹጋ ሀፉራስ ዱቢ ሀፉራቲን እብስነ። <verse eid="1CO 2:13"/><verse number="14" style="v" sid="1CO 2:14"/>ነምን ፎኒ ወንቶተ ሀፉረ ዋቃ ህንፉዸቱ፤ ኩን እሳፍ ጎዉማዻቲ፤ ወንቶትን ሀፉራ ዋን ሀፉራን ቆረመኒፍ እን ሁበቹ ህንደንደኡ። <verse eid="1CO 2:14"/><verse number="15" style="v" sid="1CO 2:15"/>ነምን ሀፉራ ዋን ሁንዱማ ንቆረ፤ ኦፊሳቲ ገሩ ኤኙንዩ ህንቆረሙ።<verse eid="1CO 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CO 2:16"/>“አከ እሰ በርሲሱፍ፣</para>
  <para style="q2" vid="1CO 2:16">ኤኙቱ ያደ ገራ ጎፍታ ቤኬ?”<note caller="+" style="f"><char style="fr" closed="false">2፥16 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 40:13">እሳ 40፥13</ref></char></char></note></para>
  <para style="m" vid="1CO 2:16">ኑ ገሩ ያደ ገራ ክርስቶስ ቀብነ።<verse eid="1CO 2:16"/></para>
  <chapter eid="1CO 2"/>
  <chapter number="3" style="c" sid="1CO 3"/>
  <para style="s1">ዋኤ ገርገር በኡ ወልዳ ክርስታና</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1"/>ያ ኦቦሎተ፣ አን አከ ነሞተ ፎኒ ወረ ክርስቶስት ዳእመን ታተኒት መሌ አከ ነሞተ ሀፉራት እስንት ዱበቹ ህንደንዴኜ። <verse eid="1CO 3:1"/><verse number="2" style="v" sid="1CO 3:2"/>ዋን እስን ኛተ ጀባ ኛቹ ህንገእኒፍ አን ኣነን እስን ወገኤ መሌ ኛተ ጭማ እስኒ ህንኬንኔ። ዹጉማን እስን አመዩ ኛቹ ህንደንዴኜ። <verse eid="1CO 3:2"/><verse number="3" style="v" sid="1CO 3:3"/>እስን አመዩ ነመ ፎኒት። ሰበቢ ህናፋፊ ወል ቆጮሉን እስን ግዱ ጅሩፍ እስን ነመ ፎኒ ምቲ? አኩመ ነሞተ ካኒት ጅራቱ ምቲ? <verse eid="1CO 3:3"/><verse number="4" style="v" sid="1CO 3:4"/>ነምን ቶኮ፣ “አን ከን ጳዉሎስ” ጄዼ፣ እን ካንሞ፣ “አን ከን አጵሎስ” ዮ ጄዼ እስን ነሙመ ቆፈ ምቲሬ?<verse eid="1CO 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 3:5"/>ኤጋ አጵሎስ ኤኙ? ጳዉሎስስ ኤኙ? እሳን ወረ አኩመ ሆጂ ጎፍታን ቶኮ ቶኮሳኒቲፍ ኬኔት ተጃጅለኒዸ፤ እስንሞ ከራሳኒቲን አመንተን። <verse eid="1CO 3:5"/><verse number="6" style="v" sid="1CO 3:6"/>አን ነንዻቤ፤ አጵሎስ ብሻን ኦባሴ፤ ዋቅን ገሩ ንጉድሴ። <verse eid="1CO 3:6"/><verse number="7" style="v" sid="1CO 3:7"/>ከናፉ ዋቀ እሰ ጉድሱ ሰነ መሌ ነምች ዻቡ ዮካን እን ብሻን ኦባሱ ሱን ሆማ ምት። <verse eid="1CO 3:7"/><verse number="8" style="v" sid="1CO 3:8"/>እን ዻቡስ፣ እን ብሻን ኦባሱስ ቶኩመ፤ ቶኮን ቶኮንሳኒስ አኩመ ደዸቢሳኒት ገቲ ንአርገቱ። <verse eid="1CO 3:8"/><verse number="9" style="v" sid="1CO 3:9"/>ኑ ወረ ዋቀ ወጅን ሆጄትኑዸ፤ እስን ለፈ ቆቲሳ ዋቃት፤ እጃርሰ ዋቃትስ።<verse eid="1CO 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 3:10"/>አንስ አያነ ዋቅን ናፍ ኬኔን አኩመ ኦጌሰ እጃርሳ ቶኮት ሁንዴ ቡሴረ፤ ነምን ካንሞ እሰረት እጃራ ጅረ። ገሩ ቶኮን ቶኮን ነማ አከምት አከ እጃሩ ኦፍ ኤገቹ ቀበ። <verse eid="1CO 3:10"/><verse number="11" style="v" sid="1CO 3:11"/>ነምን ቶኮዩ ሁንዴ ዱራን ቡፈሜ ሰነ መሌ ከን ብራ ቡሱ ህንደንደኡቲ፤ ሁንዴን ሱንስ ዬሱስ ክርስቶስ። <verse eid="1CO 3:11"/><verse number="12" style="v" sid="1CO 3:12"/>ነምን ከምዩ ዮ ሁንዴ ሰነረት ወርቄን፣ ሜቲን፣ ዸጋ ገቲ ጉዳቲን፣ ሙካን፣ ጭታን ዮካን ሆፋን እጃሬ፣ <verse eid="1CO 3:12"/><verse number="13" style="v" sid="1CO 3:13"/>ጉያን ሱን ዋን እፈት እሰ ባሱፍ ሆጂንሳ ማል አከ ተኤ ንቤከመ። እንስ እብዳን እፈት ባፈመ፤ እብድ ሱንስ ቁልቁልነ ሆጂ ነመ ሁንዳ ንቆረ። <verse eid="1CO 3:13"/><verse number="14" style="v" sid="1CO 3:14"/>ዮ ወን እን እጃሬ ኡቱ ህንጉበትን ሀፌፍ እን ገቲሳ ንአርገተ። <verse eid="1CO 3:14"/><verse number="15" style="v" sid="1CO 3:15"/>ነምን ሆጂንሳ ጀላ ጉበቴ ከምዩ ገቲሳ ንዸበ፤ እን መታንሳ ገሩ ንኦልፈመ፤ ተኡስ አከ ነመ እብደ ኬሰ ደርቤት ኦልፈመ።<verse eid="1CO 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 3:16"/>እስን አከ መነ ቁልቁሉማ ዋቃ ታተኒፊ አከ ሀፉር ዋቃ እስን ኬሰ ጅራቱ ህንቤክተኒ? <verse eid="1CO 3:16"/><verse number="17" style="v" sid="1CO 3:17"/>ኤኙዩ ዮ መነ ቁልቁሉማ ዋቃ በሌሴ፣ ዋቅን እሰ ንበሌሰ፤ መን ቁልቁሉማ ዋቃ ቁልቁሉዻቲ፤ መን ቁልቁሉማ ሱንስ እስን።<verse eid="1CO 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 3:18"/>ኤኙዩ ኦፍ ህንጎዎምስን። እስን ኬሳ ነምን ቶኮ ዮ አዱኛ ከነረት ኦጌሰ ኦፍ ሴኤ፣ እን አከ ኦጌሰ ተኡፍ ጎዋ ሃተኡ። <verse eid="1CO 3:18"/><verse number="19" style="v" sid="1CO 3:19"/>ኦጉማን አዱኛ ከና ፉለ ዋቃ ዱረት ጎዉማዻቲ። ኩንስ እሰ፣ “እን ኦጌዪ ሀጡማሳኒቲን ቀበ”<note caller="+" style="f"><char style="fr" closed="false">3፥19 </char><char style="ft" closed="false"><char style="xt"><ref loc="JOB 5:13">ኢዮ 5፥13</ref></char></char></note> ጄዸሜ በሬፈሜዸ። <verse eid="1CO 3:19"/><verse number="20" style="v" sid="1CO 3:20"/>አከሱመስ፣ “ጎፍታን አከ ያድን ኦጌዪ ፋይዳ ህንቀብኔ ንቤከ”<note caller="+" style="f"><char style="fr" closed="false">3፥20 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 94:11">ፋር 94፥11</ref></char></char></note> ጄዸሜረ። <verse eid="1CO 3:20"/><verse number="21" style="v" sid="1CO 3:21"/>ከናፉ ኤኙዩ ነማን ኦፍ ህንጀጅን! ወን ሁንድኑ ከንኬሰኒቲ፤ <verse eid="1CO 3:21"/><verse number="22" style="v" sid="1CO 3:22"/>ጳዉሎስስ ተኡ አጵሎስ ዮካን ኬፋን ዮካን አዱኛን ዮካን ጅሬኝ ዮካን ዱት ዮካን ወንት አመ ጅሩስ ተኡ ወንት ዹፉ ሁንድኑኬሰን፤ <verse eid="1CO 3:22"/><verse number="23" style="v" sid="1CO 3:23"/>እስን ከን ክርስቶስ፤ ክርስቶስሞ ከን ዋቃት።<verse eid="1CO 3:23"/></para>
  <chapter eid="1CO 3"/>
  <chapter number="4" style="c" sid="1CO 4"/>
  <para style="s1">ኤርገሞተ ክርስቶስ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1"/>ከናፉ ነምን አከ ተጃጅልቶተ ክርስቶሲፊ አከ ወረ እጪቲን ዋቃ እማና እት ኬነሜት ኑ እላሉ ቀበ። <verse eid="1CO 4:1"/><verse number="2" style="v" sid="1CO 4:2"/>ወረ እማናን እት ኬነሜ ሰነስ አመነሞ ተኡቱ እራ ኤገመ። <verse eid="1CO 4:2"/><verse number="3" style="v" sid="1CO 4:3"/>ዮ እስኒን ዮካን ነመ ካኒን ነት ሙረሜ አን ሆማቱ ህንለካኡ፤ ዹጉማን አኑ ኦፍት ህንሙሩ። <verse eid="1CO 4:3"/><verse number="4" style="v" sid="1CO 4:4"/>ያድን ገራኮ ቁልቁሉዸ፤ ኩን ገሩ ቁልቁልነኮ ህንምርከኔሱ። ከን ነት ሙሩ ጎፍታዸ። <verse eid="1CO 4:4"/><verse number="5" style="v" sid="1CO 4:5"/>ከናፉ እስን ኡቱ ዬሮን ሙርቴፈሜ ሱን ህንገእን ሙርቲ ቶኮዩ ህንኬንና፤ ሀመ ጎፍታን ዹፉት ኤጋ። እን ዋን ዱከነ ኬሰት ዾክፈሜ እፈት ንባሰ፤ ሀዊ ገራ ነማስ ንሙልእሰ። ዬሮ ሰነ ነምን ሁንድኑ ዋቀ ብራ ገለተ ንአርገተ።<verse eid="1CO 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 4:6"/>ኤጋ ያ ኦቦሎተ፣ አን አከ እስን ጄች፣ “ዋን በሬፈሜረ ህንደርብን” ጄዹ ሱን ማል ጄቹ አከ ተኤ ኑራ በረተኒፍ ቡኣኬሰኒፍ ጄዼ ዋን ከነ ሁንደ አጵሎሲፊ ኦፊኮት ፈኬሴረ፤ ኩንስ አከ እስን ነመ ቶኮ እሰ ካን ጫልችፍተኒ ህንኮሬፍ። <verse eid="1CO 4:6"/><verse number="7" style="v" sid="1CO 4:7"/>ኤኙቱ አከ አት ወረ ካን ጫልቱ ስ ጎዼ? ወን ዋቅን ሲፍ ህንኬንን ከን አት ቀብዱ ማል ፋቱ ጅረ? ኤርገ ሲፍ ኬነሜሞ አከ ዋን ኬና ህንተእኒት ማሊፍ ኦፍ ጀጀሬ?<verse eid="1CO 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 4:8"/>አመ እስን ዋን በርባደን ሁንዱማ አርገተኒርቱ! ሶሮምተኒርቱስ! ኑራ ገርገር ባተኒ ሞቶተ ታተኒርቱ! ኑስ አከ እስን ወጅን ሞቶተ ታኑፍ ኡቱ እስን ሞቶተ ታተኒ አን አከመን ሀወን ቱሬ! <verse eid="1CO 4:8"/><verse number="9" style="v" sid="1CO 4:9"/>ዋቅን፣ ኑ ኤርገሞተ አከ ነሞተ ዱት እት ሙርታኤት ዋን ዹመ ህሪራ ኑ ታስሴ ነት ፈካታቲ። ኑ አዱኛ ዱረት፣ ኤርገሞታፊ ነሞተ ዱረትስ ዋን ዳወተሙ ታኔረ። <verse eid="1CO 4:9"/><verse number="10" style="v" sid="1CO 4:10"/>ኑ ክርስቶሲፍ ጄኔ ጎዎተ፤ እስን ገሩ ክርስቶሲን ኦጌዪዸ! ኑ ደዸቦዸ፤ እስንሞ ጀጀቤዪዸ! እስን ከበጀምቶተ፤ ኑሞ ቱፈተምቶተ! <verse eid="1CO 4:10"/><verse number="11" style="v" sid="1CO 4:11"/>ሀመ ሰኣቲ አማት ንቤሎፍነ፤ ንዼቦትነ፤ ንዳረ፤ ንሬበምነ፤ መነ ጅሬኛስ ህንቀብኑ። <verse eid="1CO 4:11"/><verse number="12" style="v" sid="1CO 4:12"/>ሀርኩመኬኛን ሆጄቹዻንስ ንደዸብነ። ዮሙ አባረምኑ ንኤብፍነ፤ ዮሙ አርአምኑስ ንኦብስነ። <verse eid="1CO 4:12"/><verse number="13" style="v" sid="1CO 4:13"/>ዮሙ አረብሰምኑ፣ ዋን ጋሪ ዴብፍነ፤ ሀመ ዬሮ ከናትስ ጡሪ ለፋቲፊ ኮሲ አዱኛ ታኔረ።<verse eid="1CO 4:13"/></para>
  <para style="s1">ዋምቻፊ አኬከቺሰ ጳዉሎስ</para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 4:14"/>ከነስ እስኒ በሬሱንኮ አከ እጆሌኮ ከኔን ጃለተመኒት እስን ጎርሱዻፍ መሌ እስን ቃኔሱፍ ምት። <verse eid="1CO 4:14"/><verse number="15" style="v" sid="1CO 4:15"/>እስን ዮ ከራ ክርስቶሲን ጉድፍቶተ ኩመ ኩዸን ቀባተንዩ፣ አቦቲ ባይኤ ህንቀብደን፤ አን ክርስቶስ ዬሱሲን ከራ ወንጌላቲን አባኬሰን ተኤራቲ። <verse eid="1CO 4:15"/><verse number="16" style="v" sid="1CO 4:16"/>ከናፍ አን አከ እስን ፈኬኘኮ ዱካ ቡተን እስነን ከዸዸ። <verse eid="1CO 4:16"/><verse number="17" style="v" sid="1CO 4:17"/>ሰበቢ ከናፍስ አን እልመኮ እሰን ጃለዹ፣ ከን ጎፍታትስ አመነማ ተኤ ጢሞቴዎስን ገረኬሰንት ኤርጌረ። እንስ ሃለ ጅሬኘኮ ከን አን ክርስቶስ ዬሱሲን አርገዼ ከን ዋን አን እዶ ሁንደት ወልዳ ክርስታና ሁንደ ኬሰት በርሲሱ ወጅን ዴሙ ሰነ እስን ያደቺሰ።<verse eid="1CO 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 4:18"/>እስን ኬሳ ነሞትን ቶኮ ቶኮ ዋን አን ገረኬሰን ህንዹፍኔ ሴአኒ ኦፍ ቱለኒ ጅሩ። <verse eid="1CO 4:18"/><verse number="19" style="v" sid="1CO 4:19"/>ዮ ፌዺ ዋቃ ተኤ ገሩ አን ደፌ ገረኬሰን ነንዹፈ፤ ኤርገሲ ዋን ኦፍ ቱልቶትን ኩኔን ዱበተን ቆፈ ኡቱ ህንተእን ሁምነ እሳን ቀበንስ ቤኩ ነንበርባደ። <verse eid="1CO 4:19"/><verse number="20" style="v" sid="1CO 4:20"/>ሞቱማን ዋቃ ሁምናን መሌ ዱቢዻን ምት። <verse eid="1CO 4:20"/><verse number="21" style="v" sid="1CO 4:21"/>እስን ማል በርባዱ? አን ኡሌ ቀበዼሞ ጃለላፊ ሀፉረ ገድ ኦፍ ቀቢሳቲን ገረኬሰን ዹፈ?<verse eid="1CO 4:21"/></para>
  <chapter eid="1CO 4"/>
  <chapter number="5" style="c" sid="1CO 5"/>
  <para style="s1">ሀለሉማ ወልዳ ኬሰ ጅሩ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1"/>አከ ሀለሉማን ነሞተ ኦርማ ኬሰትሌ ህንቤከምን እስን ግዱ ጅሩ ኦዴፈማ ጅረ፦ ነምን ኒቲ አባሳ ወጅን ጪሱ ቶኮ ጅራቲ። <verse eid="1CO 5:1"/><verse number="2" style="v" sid="1CO 5:2"/>እስንስ ኦፍ ቱልተኒርቱ! ቆደ ከና አከ መሌ ገድተኒ ነምቸ ዋን አከሲ ሆጄቴ ሰነ ቶኩማኬሰን ኬሳ ባሱን እስንረ ህንጅሩ? <verse eid="1CO 5:2"/><verse number="3" style="v" sid="1CO 5:3"/>አን ፎኒን እስን ብረት አርገሙ ባዹሌ ሀፉራን እስን ወጅነን ጅረ። አን አከ ዋን እስን ወጅን ጅሩት ነምቸ ዋን አከሲ ሆጄቴት አሙመ ሙሬረ። <verse eid="1CO 5:3"/><verse number="4" style="v" sid="1CO 5:4"/>ዮሙ እስን መቃ ጎፍታኬኘ ዬሱሲን ወልት ቀበምተንት አንስ ዬሮ ሀፉራን እስን ወጅን ተኡቲፊ ሁምነ ጎፍታኬኘ ዬሱስ አርገኑት፣ <verse eid="1CO 5:4"/><verse number="5" style="v" sid="1CO 5:5"/>አከ ፎንሳ በሌፈሙፍ፣ አከ ሀፉርሳሞ ጉያ ጎፍታት ፈዩፍ ነምቸ ከነ ደበርሳቲ ሴጠነት ኬና።<verse eid="1CO 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 5:6"/>ኦፍ ቱሉንኬሰን ጋሪ ምት። እስን አከ ራጭቲን ጥኖን ቡኮ ጉቱ ቡኬስቱ ህንቤክተኒ? <verse eid="1CO 5:6"/><verse number="7" style="v" sid="1CO 5:7"/>እስን ዋን ቡኮ ራጭቲ ህንቀብኔ ታተኒፍ አከ መጥኖ ሃራ ታተኒፍ ራጭቲ ሞፋ ኦፍ ኬሳ ባሳቲ ገታ፤ ሆላን ፋሲካኬኘ፣ ክርስቶስ ኣርሳ ኑፍ ተኤራቲ። <verse eid="1CO 5:7"/><verse number="8" style="v" sid="1CO 5:8"/>ከናፉ ኮታ ራጭቲ ሞፋ ዮካን ራጭቲ ጀልእናቲፊ ሀምናቲን ኡቱ ህንተእን ቡዴነ ህንቡካእን ከን ቁልቁልናፊ ዹጋ ኦፍ ኬሳ ቀቡን አያንቸ አያኔፈትና።<verse eid="1CO 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 5:9"/>አን አከ እስን ነሞተ ሀለሉማዻን ጅራተን ወጅን ወልት ዹፌኘ ህንቀባትኔፍ ጠለያኮ ኬሰት እስኒ በሬሴን ቱሬ፤ <verse eid="1CO 5:9"/><verse number="10" style="v" sid="1CO 5:10"/>ኩንስ ጎንኩማ ነሞተ ሀለሉማዻን አዱኛ ከነረ ጅራተን ዮካን ዶቅኖታፊ ሳምቶተ ዮካን ወረ ዋቀ ቶልፈማ ዋቄፈተን ጄቹኮ ምት። ኡቱ አከስ ተኤሞ ስላ አዱኛ ከነ ኬሳ በኡ ቀብዱ ቱሬ። <verse eid="1CO 5:10"/><verse number="11" style="v" sid="1CO 5:11"/>አን ገሩ አከ እስን ነመ፣ “አን ኦቦሌሰ” ኦፊን ጄቻ ሀለሉማን ጅራቱ ዮካን ዶቅነ ዮካን ነመ ዋቀ ቶልፈማ ዋቄፈቱ ዮካን መቃ ነመ በሌሱ ዮካን መቾፍቱ ዮካን ሳምቱ ወጅን ወልት ዹፌኘ ህንቀባትኔፍ አመ እስኒ በሬሰ። ነመ አከሲ ወጅን ኛተዩ ህንኛትና!<verse eid="1CO 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 5:12"/>ወረ አለ ጅረንት ሙሩን ሆጂኮቲ? እስን ወረ ኬሰ ጅረንት ሙሩ ህንቀብደኒ? <verse eid="1CO 5:12"/><verse number="13" style="v" sid="1CO 5:13"/>ዋቅን ወረ አለ ጅረንት ንሙረ፤ “ነመ ሀማ ኦፍ ኬሳ ባሳ!”<note caller="+" style="f"><char style="fr" closed="false">5፥13 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 17:7">ኬዴ 17፥7</ref>፤ <ref loc="DEU 19:19">19፥19</ref>፤ <ref loc="DEU 21:21">21፥21</ref>፤ <ref loc="DEU 22:21">22፥21</ref>፣<ref loc="DEU 22:24">24</ref>፤ <ref loc="DEU 24:7">24፥7</ref></char></char></note><verse eid="1CO 5:13"/></para>
  <chapter eid="1CO 5"/>
  <chapter number="6" style="c" sid="1CO 6"/>
  <para style="s1">ወል ህመቹ አመንቶታ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1"/>እስን ኬሳ ነምን ከምዩ ዮ ነመ ብራራ ፈልሚ ቀባቴ፣ ዽመሳ ቁልቁሎተ ዱረት ዽኤፈቹረ አከምት ወረ ዋቀት ህንአመንን ዱረት ሙርቲፍ ዽኤፈቹፍ እጀ ጀባተ? <verse eid="1CO 6:1"/><verse number="2" style="v" sid="1CO 6:2"/>እስን አከ ቁልቁሎትን አዱኛት ሙረን ህንቤክተኒ? ኤርገ ከን አዱኛት ሙርተን ታተኒ ዋን ጥጥኖት ሙሩ ህንደንዴሰኒ? <verse eid="1CO 6:2"/><verse number="3" style="v" sid="1CO 6:3"/>እስን አከ ኑ ኤርገሞተት ሙሩ ህንቤክተኒ? ዮስ ሀመም ጫላ ዋን ጅሬኘ አዱኛ ከናት ሃሙሩሬ? <verse eid="1CO 6:3"/><verse number="4" style="v" sid="1CO 6:4"/>ኤጋ ዮ ፈልሚ ዽመ አከሲ ቀባተን ማሊፍ ነሞተ ወልዳ ክርስታና ኬሰት ቱፈተመን ዱረት ዽኤፈቱሬ? <verse eid="1CO 6:4"/><verse number="5" style="v" sid="1CO 6:5"/>አንስ እስን ቃኔሱፍ ዋን ከነ ነንዱበዸ። ነምን ቤካን ፈልሚ አመንቶተ ግዱ ጅሩፍ ሙርቲ ኬኑ ደንደኡ ቶኮዩ ህንጅሩ ጄቹዻ? <verse eid="1CO 6:5"/><verse number="6" style="v" sid="1CO 6:6"/>ኦቦሌስ ቶኮ ኦቦሌሰ ካን ህመቹፍ ጄዼ መነ ሙርቲ ዸቀ፤ ኩንስ ፉለ ወረ ህንአመኔ ዱረት!<verse eid="1CO 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 6:7"/>ወል ህመቹንኬሰን አመዩ ጉቱማት ሞአተሙኬሰን አርግሲሰ። ቆደ ከና ደብን እስንት ሆጄተሙ ህንወዩ? ጎዎምፈሙ እስኒ ህንወዩ? <verse eid="1CO 6:7"/><verse number="8" style="v" sid="1CO 6:8"/>ገሩ እስን መታንኬሰንዩ ንጎዎምስቱ፤ ደበስ ንሆጄቱ፤ ከነስ ኦቦሎቱመኬሰንት ሆጄቱ። <verse eid="1CO 6:8"/><verse number="9" style="v" sid="1CO 6:9"/>እስን አከ ጀልኦትን ሞቱማ ዋቃ ህንዻሌ ህንቤክተኒ? ህንጎዎምና፦ ሀለሌወን ዮካን ወር ዋቀ ቶልፈማ ዋቄፈተን ዮካን ኤጅቶትን ዮካን ዺሮትን ሰጋገልቶትን ዮካን ዺሮትን ዺረ ወጅን ሰጋገለን፣ <verse eid="1CO 6:9"/><verse number="10" style="v" sid="1CO 6:10"/>ዮካን ሀቶትን ዮካን ዶቅኖትን ዮካን መቾፍቶትን ዮካን ወር መቃ ነመ በሌሰን ዮካን ሳምቶትን ሞቱማ ዋቃ ህንዻለን። <verse eid="1CO 6:10"/><verse number="11" style="v" sid="1CO 6:11"/>ገሪንኬሰን አከስ ቱርተን። ተኡስ እስን መቃ ጎፍታኬኘ ዬሱስ ክርስቶሲፊ ሀፉረ ዋቀኬኛቲን ዽቀምተኒርቱ፤ ቁልቁሎፍተኒርቱ፤ ቀጄልቶተስ ታስፈምተኒርቱ።<verse eid="1CO 6:11"/></para>
  <para style="s1">ሀለሉማ</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12"/>“ወንት ሁንድኑ ናፍ ኤየመሜረ”፤ ከን ፋይዳ ቀቡ ገሩ ሁንደሳ ምት፤ “ወንት ሁንድኑ ናፍ ኤየመሜረ”፤ ገሩ ወንት ቶኮዩ ነ ህንሞአቱ። <verse eid="1CO 6:12"/><verse number="13" style="v" sid="1CO 6:13"/>“ኛን ገራዻፍ፤ ገራንስ ኛታፍ”፤ ዋቅን ገሩ ለቸንሳኒዩ ንበሌሰ። ዸግን ጎፍታ ተጃጅሉዻፍ መሌ ሀለሉማፍ ምት፤ ጎፍታንስ ዸግናፍ። <verse eid="1CO 6:13"/><verse number="14" style="v" sid="1CO 6:14"/>ዋቅን ሁምነሳቲን ወረ ዱአን ኬሳ ጎፍታ ካሴረ፤ ኑስ አከሱመ ንካሰ። <verse eid="1CO 6:14"/><verse number="15" style="v" sid="1CO 6:15"/>እስን አከ ዸግንኬሰን ኩታ ዸግነ ክርስቶስ ተኤ ህንቤክተኒ? ዮስ አን ኩታ ዸግነ ክርስቶስ ፉዼ ኩታ ዸግነ ሰጋገልቱ ጎዹሬ? ጎንኩማ ህንተኡ! <verse eid="1CO 6:15"/><verse number="16" style="v" sid="1CO 6:16"/>እስን አከ ነምን ሰጋገልቱ ወጅን ወል ቁነምቲ ቀቡ ቶኮ እሼ ወጅን ዸግነ ቶኮ ተኡ ህንቤክተኒ? “ለማን እሳኒዩ ፎን ቶኮ ንተኡ”<note caller="+" style="f"><char style="fr" closed="false">6፥16 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 2:24">ኡመ 2፥24</ref></char></char></note> ጄዸሜራቲ። <verse eid="1CO 6:16"/><verse number="17" style="v" sid="1CO 6:17"/>ነምን ጎፍታ ወጅን ቶኮ ተኤ ገሩ ጎፍታ ወጅን ሀፉራን ቶኮ።<verse eid="1CO 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 6:18"/>ሀለሉማራ በቀዻ። ነምን ጩቡ ብራ ሁንደ ዸግነሳቲ አለት ሆጄተ፤ ነምን ሀለሉማ ሆጄቱ ገሩ ዸግኑመ ኦፊሳት ጩቡ ሆጄተ። <verse eid="1CO 6:18"/><verse number="19" style="v" sid="1CO 6:19"/>እስን አከ ዸግንኬሰን መነ ቁልቁሉማ ሀፉረ ቁልቁሉ እስን ኬሰ ጅራቱ፣ ከን ዋቀራ አርገተን ሰና ተኤ ህንቤክተኒ? እስን ከን ኦፊኬሰኒ ምት፤ <verse eid="1CO 6:19"/><verse number="20" style="v" sid="1CO 6:20"/>እስን ገቲን ብተምተን፤ ከናፉ ዸግነኬሰኒን ዋቃፍ ኡልፍነ ኬና።<verse eid="1CO 6:20"/></para>
  <chapter eid="1CO 6"/>
  <chapter number="7" style="c" sid="1CO 7"/>
  <para style="s1">ዋኤ ፉዻፊ ሄሩማ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 7:1"/>ዋኤ ዋን እስን ናፍ በሬስተን ሰና፣ ነምን ቶኮ ኡቱ ፉዹ ባቴ እሳፍ ጋሪዸ። <verse eid="1CO 7:1"/><verse number="2" style="v" sid="1CO 7:2"/>ገሩ ዋን ሀለሉማን ጅሩፍ ዺር ሁንድ ኒቲ ኦፊሳ ሃቀባቱ፤ ዱበርቲን ሁንድስ ዽርሰ ኦፊሼ ሃቀባቱ። <verse eid="1CO 7:2"/><verse number="3" style="v" sid="1CO 7:3"/>ዽርስ ዋን ኒቲሳቲፍ መሉ ሃጉቱፍ፤ ኒቲንስ አከሱመ ዽርሰሼቲፍ ሃጉቱ። <verse eid="1CO 7:3"/><verse number="4" style="v" sid="1CO 7:4"/>ኒቲን ዸግነ ኦፊሼረት ኣንጎ ህንቀብዱ፤ ከን ኣንጎ ቀቡ ዽርሰ። አከሱመሞ ዽርስ ዸግነ ኦፊሳረት ኣንጎ ህንቀቡ፤ ከን ኣንጎ ቀብዱ ኒቲዸ። <verse eid="1CO 7:4"/><verse number="5" style="v" sid="1CO 7:5"/>ዮ ከዸትናት ጀባቹፍ ጄተኒ ዬሮፍ እት ወሊ ገልተን መሌ ወል ህንድድና። ኤርገሲስ አከ ኦፍ ቀቡ ደዸቡኬሰኒን ሴጠን እስን ህንቆሬ ዴብኣ ወጅን ጅራዻ። <verse eid="1CO 7:5"/><verse number="6" style="v" sid="1CO 7:6"/>ከነስ አን ኤየማን መሌ አጀጃፍ ህንዱበዹ። <verse eid="1CO 7:6"/><verse number="7" style="v" sid="1CO 7:7"/>አን ኡቱ ነምን ሁንዱምቱ አኩመኮ ተኤ ነንሀወ ቱሬ። ገሩ ነምን ሁንድ ኬና ኦፊሳ ከን ዋቅን እሳፍ ኬኔ ቀበ፤ እን ቶኮ ኬና ቶኮ፣ ካንሞ ኬና ብራ ቀበ።<verse eid="1CO 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 7:8"/>አን ወረ ህንፉዽኒፊ ወረ ህንሄሩምኒን፣ ሃዾተ ህዬሳቲንሌ አከነን ጄዸ፦ እሳን ዮ አኩመኮ ፉዻፊ ሄሩመ መሌ ሀፈን እሳኒፍ ወየ። <verse eid="1CO 7:8"/><verse number="9" style="v" sid="1CO 7:9"/>ዮ ኦፍ ቀቡ ደዸበን ገሩ ሃፉዸን ዮካን ሃሄሩመን፤ ሀዊን ጉበቹረ ፉዹ ዮካን ሄሩሙ ወያቲ።<verse eid="1CO 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 7:10"/>ወረ ፉዸኒፊ ወረ ሄሩመኒፍስ አጀጅን አን ኬኑ ከነ፦ አጀጀ ከነስ ጎፍታቱ ኬነ መሌ አነ ምት፤ ኒቲን ዽርሰሼቲን ገርገር ህንበእን። <verse eid="1CO 7:10"/><verse number="11" style="v" sid="1CO 7:11"/>ዮ ገርገር ባቴ ገሩ ኡቱ ህንሄሩምን ሃጅራቱ፤ ዮ ከና አቺ ዽርሰሼት ሃአራረምቱ። ዽርስስ ኒቲሳ ህንሂክን።<verse eid="1CO 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 7:12"/>ወረ ሀፈኒንስ አን አከነን ጄዸ፦ ከነሞ አነቱ ጄዸ መሌ ጎፍታ ምት፤ ኦቦሌስ ከምዩ ዮ ኒቲ አመንቲ ህንቀብኔ ቀባቴ፣ ዮ እሼንስ እሰ ወጅን ጅራቹፍ ፌዺ ቀባቴ፣ እን እሼ ህንሂክን። <verse eid="1CO 7:12"/><verse number="13" style="v" sid="1CO 7:13"/>ዱበርቲን ቶኮስ ዮ ዽርሰ አመንቲ ህንቀብኔ ቀባቴ፣ ዮ እንስ እሼ ወጅን ጅራቹፍ ፌዺ ቀባቴ፣ እሼን እሰ ህንሂክን። <verse eid="1CO 7:13"/><verse number="14" style="v" sid="1CO 7:14"/>ዽርስ አመንቲ ህንቀብኔ ከራ ኒቲሳቲን ቁልቁሌፈሜራቲ፤ ኒቲን አመንቲ ህንቀብኔስ ከራ ዽርሰሼቲን ቁልቁሌፈምቴርቲ። ዮ ከና አቺ እጆሌንኬሰን ጡራኦ ተኡ፤ አመ ገሩ ቁልቁሎተ።<verse eid="1CO 7:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 7:15"/>ነምን አመንቲ ህንቀብኔ ገሩ ዮ ገርገር በኡ ፌዼ ገርገር ሃበኡ። ኦቦሌስ ቶኮ ዮካን ኦቦሌቲን ቶኮ ሃለ አከሲ ኬሰት ህንህዸመን፤ ዋቅን አከ እስን ነጋን ጅራተኒፍ እስን ዋሜራቲ። <verse eid="1CO 7:15"/><verse number="16" style="v" sid="1CO 7:16"/>ያ ኒቲ፣ አት ዽርሰኬ ንፈይፍተ ተኣቲ ማል ቤክተ? ዮካን ያ ዽርሰ፣ አት ኒቲኬ ንፈይፍተ ተኣቲ ማል ቤክተ?<verse eid="1CO 7:16"/></para>
  <para style="s1">ኤኙማ ጌደረሜ</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 7:17"/>ቶኮን ቶኮን ነማ ገሩ አኩመ ጅሬኘ ጎፍታን ኬኔፊት፣ አኩመ ዋቅን እሰ ዋሜትስ ሃጅራቱ። ወልዶተ ክርስታና ሁንደ ኬሰትስ አጀጅንኮ ከኑመ። <verse eid="1CO 7:17"/><verse number="18" style="v" sid="1CO 7:18"/>ነምን ቶኮ ዋመሙሳቲን ዱረ ዸግነ ቀበቴ ጅራ? እን ነመ ዸግነ ህንቀበትን ተኡ ህንቀቡ። ነምን ቶኮ ዋመሙሳቲን ዱረ ዸግነ ህንቀበትኔ? እን ዸግነ ህንቀበትን። <verse eid="1CO 7:18"/><verse number="19" style="v" sid="1CO 7:19"/>አጀጀ ዋቃ ኤጉቱ ፋይዳ ቀበ መሌ ዸግነ ቀበቹን ዮካን ቀበቹ ባቹን ፋይዳ ህንቀቡ። <verse eid="1CO 7:19"/><verse number="20" style="v" sid="1CO 7:20"/>ቶኮን ቶኮን ነማ ሃሉመ ዬሮ ዋቅን እሰ ዋሜት ኬሰ ቱሬ ኬሰ ሃጅራቱ።<verse eid="1CO 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 7:21"/>አት ዬሮ ዋመምቴት ገርበ ቱርቴ? ዮ አከስ ተኤ እን ስ ህንያዴስን፤ ዮ ብልሰ በኡ ደንዴሴ ገሩ እት ፈየደም። <verse eid="1CO 7:21"/><verse number="22" style="v" sid="1CO 7:22"/>ነምን ዬሮ ጎፍታዻን ዋመሜት ገርበ ቱሬ እን ጎፍታዻፍ ብልሰ፤ አከሱመሞ ነምን ዬሮ ዋመሜት ብልሰ ቱሬ እን ገርብቸ ክርስቶስ። <verse eid="1CO 7:22"/><verse number="23" style="v" sid="1CO 7:23"/>እስን ገቲዻን ብተምተን፤ ገርቦተ ነሞታ ህንተእና። <verse eid="1CO 7:23"/><verse number="24" style="v" sid="1CO 7:24"/>ያ ኦቦሎተ፣ ቶኮን ቶኮን ነማ ሃሉመ ዬሮ እት ዋመሜት ኬሰ ቱሬን ፉለ ዋቃ ዱረ ሃጅራቱ።<verse eid="1CO 7:24"/></para>
  <para style="s1">ዋኤ ወሮተ ህንፉዽኒ</para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 7:25"/>አን ዋኤ ዱበረን ቁልቁሉ አጀጀ ጎፍታን ነት ኬኔ ህንቀቡ፤ ገሩ አከ ነመ አመነማ ተኡፍ አራረ ጎፍታ አርገቴ ቶኮት ያደኮ ነንኬነ። <verse eid="1CO 7:25"/><verse number="26" style="v" sid="1CO 7:26"/>ሰበቢ ረክነ አማቲፍ ጄተኒ አኩመ ጅርተንት ቱሩን እስኒፍ ጋሪ ነት ፈካተ። <verse eid="1CO 7:26"/><verse number="27" style="v" sid="1CO 7:27"/>አት ኒቲት ህዸምቴ ጅርታ? እሼ ሂኩ ህንበርባድን። አት ኒቲራ ሂከምቴ ጅርታ? ኒቲ ህንበርባድን። <verse eid="1CO 7:27"/><verse number="28" style="v" sid="1CO 7:28"/>አት ገሩ ዮ ፉቴ ጩቡ ሆጄቹኬ ምት፤ ዱርብስ ዮ ሄሩምቴ ጩቡ ሆጄቹሼ ምት። ተኡስ አዱኛ ከነረት ወረ ፉዸኒፊ ወረ ሄሩመን ረክነቱ አርገተ፤ አንሞ ረክነ ከነ ጀላ እስን ባሱን በርባደ።<verse eid="1CO 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 7:29"/>ያ ኦቦሎተ፣ ወንት አን ጄዹ ከነ፤ ዬሮን ሙርቴፈሜ ሱን ገባበቴረ፤ ስአች ወር ኒቲ ቀበን አከ ዋን ህንቀባትኒት ሃጅራተን፤ <verse eid="1CO 7:29"/><verse number="30" style="v" sid="1CO 7:30"/>ወር ቦአን አከ ዋን ህንቦእኒት፣ ወር ገመደን አከ ዋን ህንገመድኒት፣ ወር ዋ ብተተን አከ ዋን ወን ብተተን ሱን ከንሳኒ ህንተእኒት፣ <verse eid="1CO 7:30"/><verse number="31" style="v" sid="1CO 7:31"/>ወር ዋን አዱኛ ከናት ፈየደመንስ አከ ዋን እት ህንፈየደምኒት ሃሄደን። ብፍት አዱኛ ከና ንበዳቲ።<verse eid="1CO 7:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="1CO 7:32"/>አን አከ እስን ያዶ መሌ ጅራተን ነንሀወ። ነምን ህንፉዽን ቶኮ ጎፍታ ገመቺሱፍ ዽመ ጎፍታት ዽመ። <verse eid="1CO 7:32"/><verse number="33" style="v" sid="1CO 7:33"/>ነምን ፉዼ ገሩ ኒቲሳ ገመቺሱፍ ዽመ አዱኛት ዽመ፤ <verse eid="1CO 7:33"/><verse number="34" style="v" sid="1CO 7:34"/>ፌዺንሳስ ገርገር ቆደሜረ። ዱበርቲን ህንሄሩምን ዮካን ዱርብ ቁልቁሉን ዸግናፊ ሀፉራን ቁልቁሉ ተኡፍ ዽመ ጎፍታት ዽምት። ዱበርቲን ሄሩምቴ ገሩ ዽርሰሼ ገመቺሱፍ ዽመ አዱኛት ዽምት። <verse eid="1CO 7:34"/><verse number="35" style="v" sid="1CO 7:35"/>ከነ ጄቹንኮስ እስን ፈየዱፍ መሌ ክዮት እስን ገልቹፍ ምት፤ ቆደ ከና አከ እስን ያደ ገርገር ህንህረምኒን ከራ ቀጄላረ ጎፍታፍ ጅራተን ነንሀወ።<verse eid="1CO 7:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 7:36"/>ነምን ከምዩ ዮ ዱርበ ካዽመቴ ስሪት ቀቡ ባቴ፣ ዮ ኡሙሪንሼ ደበላ ዴሜ እንስ አከ እሼ ፉዹ ቀቡ ያዴ፣ አኩመ ፌዺሳ ሃጎዹ። እን ጩቡ ሆጄቹሳ ምት። እሳን ወል ፉዹ ቀቡ። <verse eid="1CO 7:36"/><verse number="37" style="v" sid="1CO 7:37"/>ገሩ ነምን ዋን ከነ ያደ ኦፊሳቲን ሙርቴሴ፣ ከን ድርቀመ ቶኮሌ ጀለ ህንጅሬ ፌዺ ኦፊሳ ሞአቹ ደንደኡ፣ ከን አከ ዱርበ ሰነ ህንፉኔ ሙርቴፈቴ፣ እንስ ዋን ቀጄላ ሆጄቴ። <verse eid="1CO 7:37"/><verse number="38" style="v" sid="1CO 7:38"/>ከናፉ ነምን ዱርበ ፉዹ ዋን ቀጄላ ሆጄቴ፤ ከን እሼ ፉዹ ዺሴሞ ጫላ ዋን ቀጄላ ሆጄቴ።<verse eid="1CO 7:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 7:39"/>ዱበርቲን ቶኮ ሀመ ዽርስሼ ጅሩት እሰት ህዸምቴርት። ዮ ዽርስሼ ዱኤ ገሩ እሼን አባ በርባዴት ሄሩሙፍ ብልሰ፤ ገሩ እን ነመ ጎፍታ ተኡ ቀበ። <verse eid="1CO 7:39"/><verse number="40" style="v" sid="1CO 7:40"/>አከ ያደኮት ገሩ እሼን ዮ ኡቱ ህንሄሩምን ሀፍቴ ጫላ ገመድ፤ አንስ ሀፉረ ዋቃ ኦፍ ኬሳ ነንቀበ ጄዼን ያደ።<verse eid="1CO 7:40"/></para>
  <chapter eid="1CO 7"/>
  <chapter number="8" style="c" sid="1CO 8"/>
  <para style="s1">ኛተ ዋቆተ ቶልፈሞፍ ዽኤፈሜ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1"/>ዋኤ ኛተ ዋቆተ ቶልፈሞፍ ዽኤፈሜ አከ ኑ ሁንድኑ ቤኩምሰ ቀብኑ ቤክነ። ቤኩምስ ኦፍ ነመ ቱልችሰ፤ ጃለል ገሩ ነመ እጃረ። <verse eid="1CO 8:1"/><verse number="2" style="v" sid="1CO 8:2"/>ነምን ዋን ዋ ቤኩ ኦፍ ሴኡ እን አመሌ አከ ቤኩን እሰረ ጅሩት ህንቤኩ። <verse eid="1CO 8:2"/><verse number="3" style="v" sid="1CO 8:3"/>ነምን ዋቀ ጃለቱ ገሩ ዋቃን ቤከሜረ።<verse eid="1CO 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 8:4"/>ኤጋ ዋኤ ኛተ ዋቆተ ቶልፈሞፍ ዽኤፈሜ ኛቹረት፣ “አከ አዱኛ ከነረት ዋቅን ቶልፈማን ሆማ ህንፈየድኔ፣ ዋቀ ቶክቸ መሌስ አከ ዋቅን ብራ ህንጅሬ” ቤክነ። <verse eid="1CO 8:4"/><verse number="5" style="v" sid="1CO 8:5"/>ዹጉማን አኩመ ዋቆትን ባይኤኒፊ ጎፍቶትን ባይኤን ጅረን ሰነ ወንቶትን ዋቆተ ጄዸመን ሰሚረ ዮካን ለፈረ ጅራተንዩ፣ <verse eid="1CO 8:5"/><verse number="6" style="v" sid="1CO 8:6"/>ገሩ ዋቀ ቶክቸ፣ አባ፣ ከን ወን ሁንድ እሰ ብራ ዹፌ፣ ከን ኑስ እሳፍ ጅራትኑ ቀብነ፤ አከሱመስ ጎፍታ ቶክቸ፣ ዬሱስ ክርስቶስ ከን ወን ሁንድ ከራሳቲን ዹፌፊ ከን ኑስ ከራሳቲን ጅራትኑቱ ጅረ።<verse eid="1CO 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 8:7"/>ገሩ ነምን ቤኩምሰ ከነ ቀቡ ነመ ሁንደ ምት። ነሞትን ቶኮ ቶኮ ዋቆተ ቶልፈሞ ዋን በረኒፍ ዮሙ ኛተ አከና ኛተንት አከ ዋን ዋቀ ቶልፈማፍ ዽኤፈሜት ሄዱ፤ ያድን ገራሳኒስ ዋን ደዸባ ተኤፍ ንጡራአ። <verse eid="1CO 8:7"/><verse number="8" style="v" sid="1CO 8:8"/>ኛትን ገሩ ዋቀት ኑ ህንዽኤሱ፤ ዮ ኛቹ ባትኔ ወን ኑት ሀማቱ፣ ዮ ኛትኔስ ወን ኑት ቶሉ ህንጅሩ።<verse eid="1CO 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 8:9"/>ተኡስ አከ ምርግኬሰን ኩን ወረ ደዸቦት ጉፉ ህንታኔፍ ኦፍ ኤገዻ። <verse eid="1CO 8:9"/><verse number="10" style="v" sid="1CO 8:10"/>ነምን ያደ ደዸባ ቀቡ ቶኮ ዮ ኡቱ አትዩ ነምን ቤኩምሰ ቀብዱ መነ ቁልቁሉማ ዋቀ ቶልፈማ ኬሰት ኛቱ ስ አርጌ እን ዋን ዋቆተ ቶልፈሞፍ ዽኤፈሜ ሰነ ኛቹፍ እጀ ህንጀባቱ? <verse eid="1CO 8:10"/><verse number="11" style="v" sid="1CO 8:11"/>አከሲን ኦቦሌስ ደዸባን ክርስቶስ እሳፍ ጄዼ ዱኤ ኩን ቤኩምሰኬቲን በደ። <verse eid="1CO 8:11"/><verse number="12" style="v" sid="1CO 8:12"/>እስንስ ዮ ከራ ከናን ኦቦሎተኬሰንት ጩቡ ሆጄተን፣ ያደሳኒ እሰ ደዸባስ ዮ መዴስተን፣ እስን ክርስቶስት ጩቡ ሆጄቱ። <verse eid="1CO 8:12"/><verse number="13" style="v" sid="1CO 8:13"/>ከናፉ ዮ ወን አን ኛዹ ኦቦሌሰኮ ጉፈቺሴ፣ አን አከ ኦቦሌስኮ ህንጉፈትኔፍ ጎንኩማ ዴብኤ ፎን ህንኛዹ።<verse eid="1CO 8:13"/></para>
  <chapter eid="1CO 8"/>
  <chapter number="9" style="c" sid="1CO 9"/>
  <para style="s1">ምርገ ኤርገማ ቶኮ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1"/>አን ብልሰ ምቲ? አን ኤርገማ ምቲ? አን ጎፍታኬኘ ዬሱስን ህንአርግኔ? እስን ቡኣ ሆጂ አን ጎፍታፍ ሆጄዼ ምቲ? <verse eid="1CO 9:1"/><verse number="2" style="v" sid="1CO 9:2"/>አን ዮን ወረ ካኒፍ ኤርገማ ተኡ ባዼዩ እስኒፍ ዹጉማን ኤርገማዸ! እስን ጎፍታዻን ቻፓ ኤርገምቱማኮት።<verse eid="1CO 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 9:3"/>ዴቢን አን ወረ ነ ቆረኒፍ ኬኑ ከነ። <verse eid="1CO 9:3"/><verse number="4" style="v" sid="1CO 9:4"/>ኑ ኛቹፊ ዹጉፍ ምርገ ህንቀብኑ? <verse eid="1CO 9:4"/><verse number="5" style="v" sid="1CO 9:5"/>ኑ አኩመ ኤርገሞተ ካኒ፣ አኩመ ኦቦሎተ ጎፍታቲፊ አኩመ ኬፋ ኒቲ አመንቱ ቶኮ ኦፍ ፋነ ፉዸትኔ ዴሙፍ ምርገ ህንቀብኑ? <verse eid="1CO 9:5"/><verse number="6" style="v" sid="1CO 9:6"/>ዮካን አናፊ በርናባስ ቆፈቱ ሆጂ ዺሱፍ ምርገ ህንቀብኔ?<verse eid="1CO 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 9:7"/>ነምን ባሲ ኦፊሳቲን ሎልቱ ተኤ ተጃጅሉ ኤኙ? ነምን እዶ ዻበ ወይኒረ ወይኒ ዻቤ እጀሳ ህንኛትኔ ኤኙ? ነምን ቡሻዬ ትክሳ ኣነን ህንዹግኔ ኤኙ? <verse eid="1CO 9:7"/><verse number="8" style="v" sid="1CO 9:8"/>ከነስ አን አከ ታይታ ነማ ቆፋን ዱበዻ? ሴርስ ከኑመ ዱበተ ምቲ? <verse eid="1CO 9:8"/><verse number="9" style="v" sid="1CO 9:9"/>ሴረ ሙሴ ኬሰት፣ “ቆትዮ ምዻን ስርብሲሱት ጅሩ አፋን ህንህዽን”<note caller="+" style="f"><char style="fr" closed="false">9፥9 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 25:4">ኬዴ 25፥4</ref></char></char></note> ጄዸሜ በሬፈሜራቲ። ኤጋ ዋቅን ቆትዮዻፍ ያዱሳቲሬ? <verse eid="1CO 9:9"/><verse number="10" style="v" sid="1CO 9:10"/>እን ጉቱማት ሰበቢኬኛፍ ዱበቹሳ ምቲ? ኤዬ፣ ኩን ሰበቢኬኛፍ በሬፈሜ፤ ሰበቢንሳ እን ቆቱ ቆቱንሳ፣ እን ምዻን ስርብሲሱስ ስርብሲሱንሳ አከ ምዻን ሰነ ኬሳ ቆደቱ አብደቻ ሆጄቹ ቀበ። <verse eid="1CO 9:10"/><verse number="11" style="v" sid="1CO 9:11"/>ኑ ዋን ሀፉራ እስን ኬሰት ፈጫፍኔ ዮ ዋን ፎኒ እስንራ ሃመትኔ ኩን ንጉደታ? <verse eid="1CO 9:11"/><verse number="12" style="v" sid="1CO 9:12"/>ኤርገ ወር ካን ምርገ ገርጋርሳ ከነ እስንራ ቀባተኒ፣ ኑሞ ከን ጫሉ ህንቀባትኑሬ?</para>
  <para style="p" vid="1CO 9:12">ኑ ገሩ ምርገ ከነት ህንፈየደምኔ። ኑ ወንጌለ ክርስቶስት ጉፉ ተኡ መና ዋኑመ ሁንደ ኦብሱ ቀብነ።<verse eid="1CO 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 9:13"/>እስን አከ ወር መነ ቁልቁሉማ ኬሰ ወንቶተ ቁልቁሉረ ተጃጅለን ኛተሳኒ መነ ቁልቁሉማራ አርገተን፣ አከ ወር እዶ ኣርሳ ተጃጅለንሞ ዋን እዶ ኣርሳረት ዽኤፈሙራ ቆደተን ህንቤክተኒ? <verse eid="1CO 9:13"/><verse number="14" style="v" sid="1CO 9:14"/>አከሱመሞ አከ ወር ወንጌለ ለለበን ዋን እቲን ጅራተን ወንጌለራ አርገተን ጎፍታን አጀጄረ።<verse eid="1CO 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 9:15"/>አን ገሩ ምርገ ከነ ኬሳ ቶኮትሌ ህንፈየደምኔ። ከነስ እስኒፍ በሬሱንኮ ዋን አከሲ ናፍ ጎቱ ጄዼ አብደዼ ምት። ነምን ቶኮ ዋን አን እቲን ኦፍ ጀጁ ከነ ነ ጀላ ቡሼሱ መና አን ዱኡ ናፍ ወየ! <verse eid="1CO 9:15"/><verse number="16" style="v" sid="1CO 9:16"/>አን ዮን ወንጌለ ለለቤ ኦፍ ጀጁ ህንደንደኡ፤ ለለቡን ድርቀመኮቲ። ዮን ወንጌለ ለለቡ ባዼ አናፍ ወዮ! <verse eid="1CO 9:16"/><verse number="17" style="v" sid="1CO 9:17"/>አን ዮን ፌዺኮቲን ለለቤ በዻሰ ቀበ፤ ዮን ፌዺኮቲን ህንተእን ገሩ አን እማናዹመ ነት ኬነሜ ሰነ ራወቹኮት። <verse eid="1CO 9:17"/><verse number="18" style="v" sid="1CO 9:18"/>ዮስ በዻስንኮ ማልሬ? በዻስንኮ፣ ለለበኮ ኬሰት አን ምርገ ወንጌላን ቀቡት ጉቱማን ጉቱት ኡቱ ህንፈየደምን ከፈልቲ መሌ ወንጌለ ለለቡኮት።<verse eid="1CO 9:18"/></para>
  <para style="s1">ጳዉሎስ ምርገሳት ፈየደሙሳ</para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 9:19"/>አን ነመ ሁንደራ ብልሰ ተኡዩ ነመ ገረ ጫሉፍ ቡኣ ቡሱፍ ጄዼ ነመ ሁንዳፍ ኦፍ ገርቦምሴ። <verse eid="1CO 9:19"/><verse number="20" style="v" sid="1CO 9:20"/>አን ይሁዶታፍ ቡኣ ቡሱፍ ጄዼ ይሁዶታፍ አከ ይሁዲ ነንተኤ። ዮን ኦፊኮቲ ሴረ ጀለ ጅራቹ ባዼዩ፣ ወረ ሴረ ጀለ ጅረኒፍ ቡኣ ቡሱፍ ጄዼ አከ ነመ ሴረ ጀለ ጅሩ ነንተኤ። <verse eid="1CO 9:20"/><verse number="21" style="v" sid="1CO 9:21"/>አን ኡቱን ሴረ ዋቃቲን አለ ህንተእን፣ ገሩ ኡቱመን ሴረ ክርስቶስ ጀለ ጅሩ፣ ወረ ሴረ ህንቀብኔፍ ቡኣ ቡሱፍ ጄዼ ወረ ሴረ ህንቀብኔፍ አከ ነመ ሴረ ህንቀብኔን ተኤ። <verse eid="1CO 9:21"/><verse number="22" style="v" sid="1CO 9:22"/>አን ወረ ደዸቦፍ ቡኣ ቡሱፍ ጄዼ ወረ ደዸቦ ብረት ደዸባ ነንተኤ። አን ከራ ደንደአሙ ሁንዳን ነሞተ ቶኮ ቶኮ ፈይሱፍ ጄዼ ነመ ሁንደ ብረት ዋኑመ ሁንደ ነንተኤ። <verse eid="1CO 9:22"/><verse number="23" style="v" sid="1CO 9:23"/>አከን ወንጌለ ኬሰት ህርማዹፍስ ሰበቢ ወንጌላቲፍ ጄዼ ዋን ከነ ሁንደ ነንሆጄዸ።<verse eid="1CO 9:23"/></para>
  <para style="s1">በርባችሱማ ናሙሰ ዹንፋ</para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 9:24"/>ዶርጎሚ ፊግቻ ኬሰት አከ ወር ፊገን ሁንድኑ ዶርጎመን፣ ገሩ አከ ነምን ቶኮ ቆፍት በዻሰ አርገቱ ህንቤክተኒ? እስንስ አከሱመ አከ በዻሰ አርገተኒፍ ፊጋ! <verse eid="1CO 9:24"/><verse number="25" style="v" sid="1CO 9:25"/>ነምን ዶርጎሚ ኬሰት ዶርጎሙ ሁንድኑ ሌንጂ ጭማ ኬሰ ደርበ። እሳን ጎንፎ በዱ አርገቹፍ ዋን ከነ ጎዹ፤ ኑ ገሩ ጎንፎ ህንበድኔ አርገቹፍ ዋን ከነ ጎነ። <verse eid="1CO 9:25"/><verse number="26" style="v" sid="1CO 9:26"/>ከናፉ አን አከ ነመ ካዮ መሌ ፊጉት ህንፊጉ፤ አከ ነመ ቅሌንሰ ሩኩቱት ህንሎሉ። <verse eid="1CO 9:26"/><verse number="27" style="v" sid="1CO 9:27"/>አን ገሩ ወረ ካኒፍ ለለቤ አከ ኦፊኮቲሞ ነመ ገተሜ ህንታኔፍ ዸግነኮ አደቤ አከ እን ና አጀጀሙ ነንጎዸ።<verse eid="1CO 9:27"/></para>
  <chapter eid="1CO 9"/>
  <chapter number="10" style="c" sid="1CO 10"/>
  <para style="s1">እስራኤሎተራ ሃበረትኑ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1"/>ያ ኦቦሎተ፣ አከ አቦቲንኬኘ ሁንድ ዱሜሰ ጀለ ቱረን፣ አከ ሁንድሳኒስ ገላነ ኬሰ ደርበን አከ እስን ኡቱ ህንቤክን ሀፍተን አን ህንበርባዱ። <verse eid="1CO 10:1"/><verse number="2" style="v" sid="1CO 10:2"/>ሁንድሳኒስ ከን ሙሴ ተኡፍ ዱሜሳፊ ገላናን ጩጰመን። <verse eid="1CO 10:2"/><verse number="3" style="v" sid="1CO 10:3"/>ሁንድሳኒስ ኛተ ሀፉራ ቶክቸ ኛተን። <verse eid="1CO 10:3"/><verse number="4" style="v" sid="1CO 10:4"/>ሁንድሳኒስ ዹጋቲ ሀፉራ ቶክቸ ዹገን። እሳን ከታ ሀፉራ እሰ እሳን ወጅን ዴማ ቱሬራ ዹገኒሩቲ፤ ከታን ሱንስ ክርስቶስ ቱሬ። <verse eid="1CO 10:4"/><verse number="5" style="v" sid="1CO 10:5"/>ተኡዩ ዋን ዋቅን ሄዱሳኒት ህንገመድኒፍ እሳን ለፈ ገሞጂ ኬሰት ዹመን።<verse eid="1CO 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 10:6"/>ወንቶትን ኩኔን አከ ኑ አኩመሳኒ ዋን ሀማ ህንሀውኔፍ ፈኬኘ ኑ ተአን። <verse eid="1CO 10:6"/><verse number="7" style="v" sid="1CO 10:7"/>አከ እሳን ኬሳ ነሞትን ቶኮ ቶኮ ጎዸን ሰነ እስን ዋቆተ ቶልፈሞ ህንዋቄፈትና፤ ኩንስ አኩመ፣ “ነሞትን ኛቹፊ ዹጉፍ ተታአን፤ ስርቡፍስ ከአን”<note caller="+" style="f"><char style="fr" closed="false">10፥7 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 32:6">በኡ 32፥6</ref></char></char></note> ጄዸሜ በሬፈሜዸ። <verse eid="1CO 10:7"/><verse number="8" style="v" sid="1CO 10:8"/>አከ እሳን ኬሳ ነሞትን ቶኮ ቶኮ ሀለሉማ ራወተኒ ጉያ ቶኮት ነሞትን 23,000 ዹመን ሰነ፣ ኑ ሀለሉማ ራወቹ ህንቀብኑ። <verse eid="1CO 10:8"/><verse number="9" style="v" sid="1CO 10:9"/>አከ እሳን ኬሳ ቶኮ ቶኮ ጎፍታ ቆረኒ ቦፋን አጄፈመን ሰነ ኑ ጎፍታ ቆሩ ህንቀብኑ። <verse eid="1CO 10:9"/><verse number="10" style="v" sid="1CO 10:10"/>እስን አከ እሳን ኬሳ ቶኮ ቶኮ ጉንጉመኒ እሰ ነመ በሌሱን በሌፈመን ሰነ ህንጉንጉምና።<verse eid="1CO 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 10:11"/>ኩን ሁንድ አከ ፈኬኘ ተኡፍ እሳንረት ራወተሜ፤ ኑ ወረ ዹምን በራ እት ዹፌፍሞ አከ ኦፍ ኤገትና ተኡፍ በሬፈሜ። <verse eid="1CO 10:11"/><verse number="12" style="v" sid="1CO 10:12"/>ከናፉ ነምን ዋን ዻበቴ ኦፍ ሴኡ አከ ህንኩፍኔፍ ኦፍ ሃኤገቱ። <verse eid="1CO 10:12"/><verse number="13" style="v" sid="1CO 10:13"/>ቆረመ ነመረ ገኡ መሌ ቆረምን ቶኮዩ እስንት ህንዹፍኔ። ዋቅንስ አመነማዸ፤ እን አከ እስን ዋን ባቹ ህንደንዴኜን ቆረምተን እስን ህንጎዹ። ዮሙ ቆረምተንት ገሩ እን አከ እስን ኦብሱ ደንዴሰኒፍ ከራ እቲን ኬሳ ባተን እስኒፍ ቆጴሰ።<verse eid="1CO 10:13"/></para>
  <para style="s1">ዋቆተ ቶልፈሞራ ፈጋቹ</para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 10:14"/>ከናፉ ያ ምቾተኮ፣ እስን ዋቆተ ቶልፈሞ ዋቄፈቹራ በቀዻ። <verse eid="1CO 10:14"/><verse number="15" style="v" sid="1CO 10:15"/>አን ነሞተ ሁበትና ቀበንትን ዱበዸ፤ ዋን አን ዱበዹ እስኑ ሙርቴሳ። <verse eid="1CO 10:15"/><verse number="16" style="v" sid="1CO 10:16"/>ጦፎን ኤባ ከን ኑ ኤብፍኑ ሱን ዺገ ክርስቶስ ወጅን ቶኩማ ቀበ ምቲ? ቡዴን ኑ ጨጨብስኑ ሱንስ ፎን ክርስቶስ ወጅን ቶኩማ ቀበ ምቲ? <verse eid="1CO 10:16"/><verse number="17" style="v" sid="1CO 10:17"/>ዋን ቡዴን ቶኮ ቆፍት ጅሩፍ፣ ኑ ባይኤ ታኑዩ ዸግኑመ ቶኮ፤ ሁንድኬኘ ቡዴኑመ ቶክቸ ሰነራ ህርማትናቲ።<verse eid="1CO 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 10:18"/>ሜ ሰበ እስራኤል እላላ፦ ወር ኣርሳራ ኛተን ሱን እዶ ኣርሳራ ቆደ ቀቡ ምቲ? <verse eid="1CO 10:18"/><verse number="19" style="v" sid="1CO 10:19"/>ኤጋ ማል ጄቹኮት? ኣርሳን ዋቆተ ቶልፈሞፍ ዽኤፈሙ ወይሞሬ ዮካን ዋቅን ቶልፈማን ወይሞሬ ጄቹኮቲ? <verse eid="1CO 10:19"/><verse number="20" style="v" sid="1CO 10:20"/>አከስ ምት፤ ኣርሳን ነሞትን ኦርማ ዽኤሰን ሀፉሮተ ሀሞዻፍ መሌ ዋቃፍ ምት፤ አን አከ እስን ሀፉሮተ ሀሞ ወጅን ቶኩማ ቀባተን ህንበርባዱ። <verse eid="1CO 10:20"/><verse number="21" style="v" sid="1CO 10:21"/>እስን ጦፎ ጎፍታቲፊ ጦፎ ሀፉሮተ ሀሞ ዹጉ ህንደንዴሰን፤ ማዲ ጎፍታቲፊ ማዲ ሀፉሮተ ሀሞረትስ ህርማቹ ህንደንዴሰን። <verse eid="1CO 10:21"/><verse number="22" style="v" sid="1CO 10:22"/>ኑ ጎፍታ ህናፋፍ ከካፍና? ኑ እሰ ጫላስ ጀባትና?<verse eid="1CO 10:22"/></para>
  <para style="s1">ብልሱማ አመንቶታ</para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23"/>“ወን ሁንድኑ አናፍ ኤየመማዸ”፣ ከን ፋይዳ ቀቡ ገሩ ዋን ሁንደ ምት። “ወን ሁንድኑ አናፍ ኤየመማዸ፣” ከን ነመ ፈየዱ ገሩ ዋን ሁንደ ምት። <verse eid="1CO 10:23"/><verse number="24" style="v" sid="1CO 10:24"/>ነምን ቶኮዩ ዋን ወረ ካኒፍ ጋሪ ተኤ በርባዱ ቀበ መሌ ዋን ኦፊሳቲፍ ጋሪ ተኤ በርባዱ ህንቀቡ።<verse eid="1CO 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 10:25"/>ኡቱ ጋፊ ቀልቢ ኬሳ ቶኮሌ ህንካስን ዋን ገባ ፎኒት ጉርጉረሙ ከምዩ ኛዻ፤ <verse eid="1CO 10:25"/><verse number="26" style="v" sid="1CO 10:26"/>“ለፍቲፊ ወን ለፈረ ጅሩ ሁንድኑ ከን ጎፍታቲ።”<note caller="+" style="f"><char style="fr" closed="false">10፥26 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 24:1">ፋር 24፥1</ref></char></char></note><verse eid="1CO 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 10:27"/>ወረ ህንአመንን ኬሳ ዮ ነምን ቶኮ ኛታፍ እስን አፌሬ፣ እስንስ ዮ ዸቁ በርባደን ዸቃ፤ ኡቱ ጋፊ ቀልቢ ኬሳ ቶኮሌ ህንካስን ዋን እስን ዱረት ዽኤፈሜ ከምዩ ኛዻ። <verse eid="1CO 10:27"/><verse number="28" style="v" sid="1CO 10:28"/>ገሩ ዮ ነምን ቶኮ፣ “ኩን ዋቆተ ቶልፈሞዻፍ ዽኤፈሜ” እስኒን ጄዼ፣ ሰበቢ ነምቸ እስንት ህሜ ሰናቲፊ ሰበቢ ቀልቢቲፍ ዋን ሰነ ህንኛትና። <verse eid="1CO 10:28"/><verse number="29" style="v" sid="1CO 10:29"/>ከነስ ቀልቢ ነምቸ ሰናት መሌ ከንኬት ጄቹኮ ምት። ማሊፍ ቀልቢ ነመ ብራቲን ብልሱማኮት ሙረመሬ? <verse eid="1CO 10:29"/><verse number="30" style="v" sid="1CO 10:30"/>አን ኤርገን ገለቴፈቹዻን ኛተ ሰነረት ህርማዼ ማሊፈን ዋነን እቲን ዋቀ ገለቴፈዹን በላሌፈተመሬ?<verse eid="1CO 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="1CO 10:31"/>ከናፉ ዮ ኛተን ዮካን ዮ ዹግደን ዮካን ዮ ዋኑመ ፌዼሌ ሆጄተን ዋን ሁንደ ኡልፍነ ዋቃቲፍ ሆጄዻ። <verse eid="1CO 10:31"/><verse number="32" style="v" sid="1CO 10:32"/>ይሁዶተ ዮካን ግሪኮተ ዮካን ወልዳ ክርስታና ከን ዋቃ ህንጉፈቺስና። <verse eid="1CO 10:32"/><verse number="33" style="v" sid="1CO 10:33"/>ኩንስ አኩመ አን ነመ ሁንደ ከራ ሁንዳን ገመቺሱፍ ያሊ ጎዹ ጄቹዸ። አን አከ እሳን ፈየኒፍ ቡኣ ነሞተ ባይኤቲፍ መሌ ቡኣኮፍ ጄዼ ዋን ከነ ህንጎዹ።<verse eid="1CO 10:33"/></para>
  <chapter eid="1CO 10"/>
  <chapter number="11" style="c" sid="1CO 11"/>
  <para style="nb">
    <verse number="1" style="v" sid="1CO 11:1"/>አኩመ አን ክርስቶስን ፈካዹ፣ እስንስ ነ ፈካዻ።<verse eid="1CO 11:1"/></para>
  <para style="s1">ስርነ ዋቄፈትና</para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 11:2"/>አን ሰበቢ እስን ዋን ሁንዳን ነ ያደተኒፊ ዋን ዱዻ አን ደበርሴ እስንት ኬኔስ ጀቤስተኒ ቀበተኒፍ እስንን ገለቴፈዸ። <verse eid="1CO 11:2"/><verse number="3" style="v" sid="1CO 11:3"/>አን አከ መታን ዺረ ሁንዱማ ክርስቶስ ተኤ፣ አከ መታን ዱበርቲ ዺረ ተኤ፣ አከ መታን ክርስቶስሞ ዋቀ ተኤ አከ ቤክተን ነንበርባደ። <verse eid="1CO 11:3"/><verse number="4" style="v" sid="1CO 11:4"/>ዺር መታሳ ሀጉገቴ ከዸቱ ዮካን ራጂ ዱበቱ ሁንድኑ መታ ኦፊሳ ሰልጵሰ። <verse eid="1CO 11:4"/><verse number="5" style="v" sid="1CO 11:5"/>ዱበርቲን ኡቱ መታሼ ህንሀጉገትን ከዸቱ ዮካን ራጂ ዱበቱ ከምዩ መታ ኦፊሼ ሰልጵፍት፤ ኩን አከ ዋን መታንሼ ሃደሜት ሄደማቲ። <verse eid="1CO 11:5"/><verse number="6" style="v" sid="1CO 11:6"/>ዱበርቲን ቶኮ ዮ መታሼ ሀጉገቹ ባቴ ርፌንሰ መታሼ ሙረቹ ቀብድ፤ ዱበርቲን ርፌንሰ መታሼ ሙረቹን ዮካን ሃደቹን ዮ ቃኒ እት ተኤሞ መታሼ ሀጉገቹ ቀብድ።<verse eid="1CO 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 11:7"/>ዺር ፈካቲፊ ኡልፍነ ዋቃ ዋን ተኤፍ መታሳ ሀጉገቹ ህንቀቡ፤ ዱበርቲን ገሩ ኡልፍነ ዺራት። <verse eid="1CO 11:7"/><verse number="8" style="v" sid="1CO 11:8"/>ዱበርቲቱ ዺረራ አርገሜ መሌ ዺር ዱበርቲራ ህንአርገምኔቲ፤ <verse eid="1CO 11:8"/><verse number="9" style="v" sid="1CO 11:9"/>ዱበርቲቱ ዺራፍ ኡመሜ መሌ ዺር ዱበርቲፍ ህንኡመምኔ። <verse eid="1CO 11:9"/><verse number="10" style="v" sid="1CO 11:10"/>ከናፉ ዱበርቲን ሰበቢ ኤርገሞታቲፍ መለቶ ታይታ መታሼራ ቀባቹ ቀብድ። <verse eid="1CO 11:10"/><verse number="11" style="v" sid="1CO 11:11"/>ተኡስ ጎፍታ ብረት ዱበርቲን ዺረ መሌ ዮካን ዺር ዱበርቲ መሌ ህንተኡ። <verse eid="1CO 11:11"/><verse number="12" style="v" sid="1CO 11:12"/>አኩመ ዱበርቲን ዺረራ አርገምቴ አከሱመሞ ዺር ዱበርቲራ ዸለታቲ፤ ወን ሁንድ ገሩ ዋቀ ብራ አርገመ።<verse eid="1CO 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 11:13"/>ሜ እስኑ ሙርቴሳ፤ ዱበርቲን ኡቱ መታሼ ህንሀጉገትን ዋቀ ከዸቹን ስሪዻ? <verse eid="1CO 11:13"/><verse number="14" style="v" sid="1CO 11:14"/>አከ ዺር ርፌንሰ መታ ዼሬፈቹን እሳፍ ሰልጵነ ተኤ ኡመምንዩ እስን ህንበርሲሱ? <verse eid="1CO 11:14"/><verse number="15" style="v" sid="1CO 11:15"/>ዱበርቲን ገሩ ዮ ርፌንሰ ዼራ ቀባቴ፣ እን እሼፍ ኡልፍነ ምቲ? ርፌንስ ዼራን አከ ሀጉጊት እሼፍ ኬነሜራቲ። <verse eid="1CO 11:15"/><verse number="16" style="v" sid="1CO 11:16"/>ገሩ ዮ አባን ፌዼዩ ዋኤ ከና ሞርሙ በርባዴ፣ ኑ ዮካን ወልዳሌን ክርስታና ዋቃ ዱዻ አከሲ ህንቀብኑ።<verse eid="1CO 11:16"/></para>
  <para style="s1">እርባተ ጎፍታ</para>
  <para style="r">
    <ref loc="1CO 11:23-25">11፥23‑25</ref> ኩወፈ – <char style="xt"><ref loc="MAT 26:26-28">ማቴ 26፥26‑28</ref>፤ <ref loc="MRK 14:22-24">ማር 14፥22‑24</ref>፤ <ref loc="LUK 22:17-20">ሉቃ 22፥17‑20</ref></char></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 11:17"/>ወልት ቀበሙንኬሰን ዋን ዋ በሌሱ መሌ ዋ ቶልቹ ህንተእኒፍ አን አጀጀ ከነ ኬሰት እስን ህንጀጁ። <verse eid="1CO 11:17"/><verse number="18" style="v" sid="1CO 11:18"/>ዋን ሁንደ ዱረ፣ ዮሙ እስን አከ ወልዳት ወልት ቀበምተንት አከ ገርገር በኡን ግዱኬሰን ጅሩ ነንዸገአ፤ ከነስ ከራ ቶኮን አን ነንአመነ። <verse eid="1CO 11:18"/><verse number="19" style="v" sid="1CO 11:19"/>ወረ እስን ኬሳ ዋቀ ብረት ፉዸተመ ቀበን እፈት ባሱፍ፣ ገራ ገሩማን እስን ግዱ ጅራቹ ቀበ። <verse eid="1CO 11:19"/><verse number="20" style="v" sid="1CO 11:20"/>ዮሙ ወልት ቀበምተንት ወንት እስን ኛተን እርባተ ጎፍታ ምት፤ <verse eid="1CO 11:20"/><verse number="21" style="v" sid="1CO 11:21"/>ዬሮ ኛታት ነምን ሁንድኑ እርባተ ኦፊሳ ኛተ። እን ቶኮ ንቤለአ፤ ካንሞ ንመቻአ። <verse eid="1CO 11:21"/><verse number="22" style="v" sid="1CO 11:22"/>እስን መነ እት ኛተኒፊ እት ዹግደን ህንቀብደንሞ? ዮካን ወልዳ ክርስታና ዋቃ ቱፈተኒ ወረ ሆማ ህንቀብኔ ቃኔስቱ? አን ማለን እስኒን ጄዸ? እስን ጀጁሬ? አን ከናን እስን ህንጀጁ!<verse eid="1CO 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 11:23"/>አን ዋነን ደበርሴ እስንት ኬኔ ከነ ጎፍታራ ፉዸዼራቲ፤ ጎፍታ ዬሱስ ሀልከን ጋፈ ደበርፈሜ ኬነሜ ሰና ቡዴነ ፉዼ፣ <verse eid="1CO 11:23"/><verse number="24" style="v" sid="1CO 11:24"/>ገለተ ገልቼ፤ ቡዴነ ሰነስ ጨጨብሴ፣ <char style="wj">“ኩን ፎንኮ ከን እስኒፍ ተኡዸ፤ ከነስ ያደኖኮቲፍ ጎዸዻ”</char> ጄዼ። <verse eid="1CO 11:24"/><verse number="25" style="v" sid="1CO 11:25"/>አከሱመስ እርባተ ቦዴ ጦፎ ፉዼ፣ <char style="wj">“ጦፎን ኩን ከኩ ሃራ ዺገኮቲን ተኡዸ፤ ዬሮ እሰ ዹግደን ሁንደ ነ ያደቹፍ ጎዸዻ”</char> ጄዼ። <verse eid="1CO 11:25"/><verse number="26" style="v" sid="1CO 11:26"/>እስንስ ሀመ ጎፍታን ዹፉት ዬሮ ቡዴነ ከነ ኛተኒ ጦፎ ከነ ዹግደን ሁንደ ዱአሳ ንለብስቱ።<verse eid="1CO 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 11:27"/>ከናፉ ነምን ሃለ ህንመሌን ቡዴነ ሰነ ኛቱ ዮካን ጦፎ ጎፍታ ዹጉ ከምዩ ፎኒፊ ዺገ ጎፍታት ንጋፈተመ። <verse eid="1CO 11:27"/><verse number="28" style="v" sid="1CO 11:28"/>ነምን ቶኮ ኡቱ ቡዴነ ሰነራ ህንኛትን፣ ኡቱ ጦፎ ሰነራስ ህንዹግን ዱረ ኦፍ ቆሩ ቀበ። <verse eid="1CO 11:28"/><verse number="29" style="v" sid="1CO 11:29"/>ነምን ኡቱ ፎን ጎፍታ አዳን ባሴ ህንሁበትን ኛቴ ዹጉ፣ እን ኦፊሳት ሙርቲ ኛቴ ዹጋቲ። <verse eid="1CO 11:29"/><verse number="30" style="v" sid="1CO 11:30"/>ከናፍስ እስን ኬሳ ሄዱን ደዸበኒሩ፤ ዹኩብሰተኒሩስ፤ ሄዱንስ ቦቆተኒሩ። <verse eid="1CO 11:30"/><verse number="31" style="v" sid="1CO 11:31"/>ኡቱ ኦፍ ቆሬ ገሩ ኑት ህንሙረሙ ቱሬ። <verse eid="1CO 11:31"/><verse number="32" style="v" sid="1CO 11:32"/>ጎፍታን ዮሙ ኑት ሙሩ ገሩ አከ አዱኛ ወጅን ኑት ህንሙረምኔፍ ኑ አደበ።<verse eid="1CO 11:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 11:33"/>ከናፉ ያ ኦቦሎተኮ፣ እስን ዮሙ ኛቹፍ ወልት ቀበምተን ወል ኤጋ። <verse eid="1CO 11:33"/><verse number="34" style="v" sid="1CO 11:34"/>አከ ወልት ቀበሙንኬሰን ሙርቲ እስንት ህንፍድኔፍ ኤኙዩ ዮ ቤለኤ መነሳት ሃኛቱ!</para>
  <para style="p" vid="1CO 11:34">ዋን ሀፌረትሞ አን ዮሙን ዹፉት ቀጄልቸ ነንኬነ።<verse eid="1CO 11:34"/></para>
  <chapter eid="1CO 11"/>
  <chapter number="12" style="c" sid="1CO 12"/>
  <para style="s1">ዋኤ ኬናወን ሀፉራ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1"/>ያ ኦቦሎተኮ፣ ኤጋ አን አከ እስን ዋኤ ኬናወን ሀፉራ ወላልተን ህንበርባዱ። <verse eid="1CO 12:1"/><verse number="2" style="v" sid="1CO 12:2"/>እስን ዬሮ ነሞተ ኦርማ ቱርተንት አከ ጎዎምፈምተኒ ገረ ዋቆተ ቶልፈሞ ዱበቹ ህንደንዴኜት ጌፈምተኒ ቱርተን ንቤክቱ። <verse eid="1CO 12:2"/><verse number="3" style="v" sid="1CO 12:3"/>ከናፉ ነምን ሀፉረ ዋቃቲን ዱበቱ ከምዩ አከ፣ “ዬሱስ አባረማዸ” ህንጄኔ፣ አከ ኤኙዩ ዮ ሀፉረ ቁልቁሉዻን ተኤ መሌ፣ “ዬሱስ ጎፍታዸ” ጄቹ ህንደንዴኜ አን እስንትን ህመ።<verse eid="1CO 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 12:4"/>ኬናወን ጎሰ ገራ ገራቱ ጅረ፤ ሀፉር ገሩ ቶኩመ። <verse eid="1CO 12:4"/><verse number="5" style="v" sid="1CO 12:5"/>ተጃጅለ ጎሰ ገራ ገራቱ ጅረ፤ ጎፍታን ገሩ ቶኩመ። <verse eid="1CO 12:5"/><verse number="6" style="v" sid="1CO 12:6"/>ሆጂ ጎሰ ገራ ገራቱ ጅረ፤ ዋን ሁንዱማ ገሩ ዋቀ ቶክቸቱ ነመ ሁንዱማን ሆጄተ።<verse eid="1CO 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 12:7"/>ሙልአትን ሀፉረ ቁልቁሉ ገሩ ፋይዳ ወሊቲፍ ቶኮ ቶኮ ነማቲፍ ኬነመ። <verse eid="1CO 12:7"/><verse number="8" style="v" sid="1CO 12:8"/>እሰ ቶኮፍ ከራ ሀፉራቲን ዱቢ ኦጉማቱ ኬነመ፤ እሰ ካኒፍሞ ሀፉሩመ ሰናን ዱቢ ቤኩምሳቱ ኬነመ፤ <verse eid="1CO 12:8"/><verse number="9" style="v" sid="1CO 12:9"/>እሰ ካኒፍ ሀፉሩመ ሰናን አመንቲቱ ኬነመ፤ እሰ ካኒፍሞ ሀፉሩመ ቶክቸ ሰናን ኬናወን ወረ ዹኩብሰተን ፈይሱቱ ኬነመ፤ <verse eid="1CO 12:9"/><verse number="10" style="v" sid="1CO 12:10"/>እሰ ቶኮፍ ድንቂወን ሆጄቹ፣ እሰ ካኒፍ ራጂ ዱበቹ፣ እሰ ካኒፍ ሀፉሮተ አዳን ባሴ ቤኩ፣ እሰ ካኒፍስ አፋን ሃራ ጎሰ አደ አዳ ዱበቹ፣ እሰ ካኒፍሞ አፋን ሃራ ሰነ ሂኩቱ ኬነመ። <verse eid="1CO 12:10"/><verse number="11" style="v" sid="1CO 12:11"/>ዋን ከነ ሁንደስ ሀፉሩመ ቶክቸ ሰነቱ አኩመ ፌዺ ኦፊሳት ቶኮ ቶኮ ነማቲፍ ዹንፋት ህሩዻን ሆጄተ።<verse eid="1CO 12:11"/></para>
  <para style="s1">ቶኩማፊ ገራ ገሩማ ኩታ ዸግና</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 12:12"/>ዸግን ኩታ ባይኤ ቀባቱሌ ዸግኑመ ቶኮ፤ ኩታወን ዸግና ዮ ባይአተንሌ ሁንድሳኒ ዸግኑመ ቶኮ ተኡ። ክርስቶስስ አከሱመ። <verse eid="1CO 12:12"/><verse number="13" style="v" sid="1CO 12:13"/>ኑ ይሁዶተ ዮካን ግሪኮተ፣ ገርቦተ ዮካን ወረ ብልሶመን ታኑስ ሁንድኬኘ ሀፉረ ቶኮን ዸግነ ቶኮት ጩጰምኔራቲ፤ ሁንድኬኘስ፣ አከ ዹግኑፍ ሀፉር ቶክች ሱን ኑ ኬነሜረ። <verse eid="1CO 12:13"/><verse number="14" style="v" sid="1CO 12:14"/>ዸግን ኩታ ቶኮ ቆፈ ኡቱ ህንተእን ኩታወን ባይኤዻቲ።<verse eid="1CO 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 12:15"/>ሚል ዮ፣ “አን ዋነን ሀርከ ህንተእኒፍ፣ አን ኩታ ዸግና ምቲ” ጄዼ፣ ሰበቢ ከናፍ ኩታ ዸግና ተኡንሳ ህንሀፉ። <verse eid="1CO 12:15"/><verse number="16" style="v" sid="1CO 12:16"/>ጉርስ ዮ፣ “አን ዋነን እጀ ህንተእኒፍ፣ አን ኩታ ዸግና ምት” ጄዼ፣ ሰበቢ ከናፍ ኩታ ዸግና ተኡንሳ ህንሀፉ። <verse eid="1CO 12:16"/><verse number="17" style="v" sid="1CO 12:17"/>ኡቱ ዸግን ጉቱማት እጀ ተኤ ጅራቴ ስላ ዸገኡን ኤሰ ጅረ? ኡቱ ዸግን ጉቱማት ጉረ ተኤ ጅራቴ ስላ ፉንፈቹን ኤሰ ጅረ? <verse eid="1CO 12:17"/><verse number="18" style="v" sid="1CO 12:18"/>አመ ገሩ ዋቅን አኩመ ኦፊ በርባዴት ኩታወን ሰነ አዱመ አዳን ዸግነ ኬሰ ካኤረ። <verse eid="1CO 12:18"/><verse number="19" style="v" sid="1CO 12:19"/>ኡቱ ሁንድሳኒ ኩታ ዸግና ቶክቸ ተአኒ ስላ ዸግን ኤሰ ጅረ? <verse eid="1CO 12:19"/><verse number="20" style="v" sid="1CO 12:20"/>ኤጋ ኩታወን ዸግና ባይኤዸ፤ ዸግን ገሩ ቶኩመ።<verse eid="1CO 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 12:21"/>እጅ ሀርካን፣ “አት ነ ህንበርባችፍቱ!” ጄቹ ህንደንደኡ፤ ዮካን መታን ሚላን፣ “አት ነ ህንበርባችፍቱ!” ጄቹ ህንደንደኡ። <verse eid="1CO 12:21"/><verse number="22" style="v" sid="1CO 12:22"/>ዹጉማኑ ኩታወን ዸግና ከኔን ደዸቦ ፈካተን አከ መሌ በርባችሶዸ፤ <verse eid="1CO 12:22"/><verse number="23" style="v" sid="1CO 12:23"/>ኩታወን ዸግና ከኔን ቱፈተሞ ኑት ፈካተኒፍስ ኡልፍነ አዳ ንኬንነ። ኩታወን ዸግና ከኔን ኑ እት ቃኖፍኑፍሞ ኡልፍን አዳ ንኬነመ፤ <verse eid="1CO 12:23"/><verse number="24" style="v" sid="1CO 12:24"/>ኩታወን ዸግነኬኛ ከኔን ኑ እት ህንቃኖፍኔ ዋን ከነ ህንበርባደን። ዋቅን ገሩ ኩታወን ዸግና ወልት ፈይሴ ኩታወን ኑ እት ቃኖፍኑፍ ኡልፍነ ጫሉ ኬኔ፤ <verse eid="1CO 12:24"/><verse number="25" style="v" sid="1CO 12:25"/>ኩንስ አከ ኩታወን ሃሉመ ቶኮን ወሊ ያደኒፊ አከ ዸግነ ኬሰ ገርገር በኡን ህንጅራትኔፍ። <verse eid="1CO 12:25"/><verse number="26" style="v" sid="1CO 12:26"/>ዮ ኩታን ዸግና ቶኮ ረከቴ ኩታወን ሁንድኑ እሰ ወጅን ረከቱ፤ ዮ ኩታን ቶኮ ኡልፍነ አርገቴ ኩታወን ሁንድ እሰ ወጅን ገመዱ።<verse eid="1CO 12:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 12:27"/>እስን አመ ዸግነ ክርስቶስ፤ ቶኮን ቶኮንኬሰንስ ኩታ ዸግነ ሰናት። <verse eid="1CO 12:27"/><verse number="28" style="v" sid="1CO 12:28"/>ዋቅን ወልዳ ክርስታና ኬሰት ቶኮፋ ኤርገሞተ፣ ለመፋ ራጆተ፣ ሰደፋ በርሲስቶተ፣ ኤርገሲስ ወረ ሆጂ ድንቂ ሆጄተን፣ እት ኣንሴስ ወረ ኬና ዹኩብሰቶተ ፈይሱ ቀበን፣ ወረ ነሞተ ገርጋሩ ደንደአን፣ ወረ ኬና ቡልቺንሳ ቀበኒፊ ወረ አፋን ሃራ ጎሰ አዳ አዳ ዱበተን ፍለቴረ። <verse eid="1CO 12:28"/><verse number="29" style="v" sid="1CO 12:29"/>ሁንዱመቱ ኤርገሞታ? ሁንዱመቱ ራጆታ? ሁንዱመቱ በርሲስቶታ? ሁንድኑ ሆጂ ድንቂ ሆጄቱ? <verse eid="1CO 12:29"/><verse number="30" style="v" sid="1CO 12:30"/>ሁንዱመቱ ኬና ዹኩብሰቶተ ፈይሱ ቀባ? ሁንዱመቱ አፋን ሃራ ዱበታ? ሁንዱመቱ አፋን ሰነ ሂካ? <verse eid="1CO 12:30"/><verse number="31" style="v" sid="1CO 12:31"/>እስን ገሩ ጀቤሳቲ ኬና ጫሉ በርባዳ።</para>
  <para style="s1" vid="1CO 12:31">ጃለለ</para>
  <para style="p" vid="1CO 12:31">አመሌ አን ከራ ከራ ሁንዱማ ጫሉ እስንት ነንአርግሲሰ።<verse eid="1CO 12:31"/></para>
  <chapter eid="1CO 12"/>
  <chapter number="13" style="c" sid="1CO 13"/>
  <para style="p">
    <verse number="1" style="v" sid="1CO 13:1"/>አን ዮን አፋን ነሞታቲፊ አፋን ኤርገሞተ ዋቃ ዱበዼ፣ ገሩ ጃለለ ቀባቹ ባትናን አኩመ ስቢለ እዩ ዮካን አከ ክልሌ ቅልሱ ቶኮት። <verse eid="1CO 13:1"/><verse number="2" style="v" sid="1CO 13:2"/>አን ዮን ኬና ራጂ ዱበቹ ቀባዼ፣ እጪቲ ሁንዳፊ ቤኩምሰ ሁንደ ሁበቹ ዮን ደንደኤ፣ አመንቲ ጋረ ቡቅሱ ደንደኡስ ዮን ቀባዼ፣ ገሩ ጃለለ ቀባቹ ባትናን አን ሆማ ምት። <verse eid="1CO 13:2"/><verse number="3" style="v" sid="1CO 13:3"/>አን ዮ ዋነን ቀቡ ሁንደ ህዬዪፍ ኬኔ፣ ዸግነኮስ አከ ጉበሙፍ ዮን ኬኔ፣ ገሩ ጃለለ ቀባቹ ባትናን ሆማ ነ ህንፈየዱ።<verse eid="1CO 13:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 13:4"/>ጃለል ኦብሰ ቀበ፤ ጃለል አርጃዸ። እን ህንህናፉ፤ ህንኮሩ፤ ኦፍስ ህንቱሉ። <verse eid="1CO 13:4"/><verse number="5" style="v" sid="1CO 13:5"/>ጃለል ዋን ህንመሌ ህንሆጄቱ፤ ኦፍቶ ምት፤ ደፌ ህንኣሩ፤ ሀምነ ነመት ህንለካኡ። <verse eid="1CO 13:5"/><verse number="6" style="v" sid="1CO 13:6"/>ጃለል ዹጋት ገመደ መሌ ዋን ሀማት ህንገመዱ። <verse eid="1CO 13:6"/><verse number="7" style="v" sid="1CO 13:7"/>ጃለል ዋን ሁንደ ንኦብሰ፤ ዋን ሁንደ ንአመነ፤ ዋን ሁንደ አብደተ፤ ዋን ሁንደ ኬሰትስ ጀባቴ ዻበተ።<verse eid="1CO 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 13:8"/>ጃለል ጎንኩማ ህንበዱ። ራጂ ታናን ንደርበ፤ አፋን ሃራ ታናን ንሀፈ፤ ቤኩምሰስ ታናን ንበደ። <verse eid="1CO 13:8"/><verse number="9" style="v" sid="1CO 13:9"/>ኑ ቤኩምሰራ ገረ ቶኮ ቤክናቲ፤ ራጂስ ገረ ቶኮ ዱበትነ፤ <verse eid="1CO 13:9"/><verse number="10" style="v" sid="1CO 13:10"/>ዮሙ እን ጉቱን ዹፉት ገሩ እን ገርቶኬን ንበደ። <verse eid="1CO 13:10"/><verse number="11" style="v" sid="1CO 13:11"/>አን ዬሮን እጆሌ ቱሬት፣ አከ እጆሌን ዱበዸ ቱሬ፤ አከ እጆሌን ያደ ቱሬ፤ አከ እጆሌት ነንሄሬገ ቱሬ፤ አን ኤርገን ነመ ጉዳ ተኤ ገሩ እጆሉማ ዺሴረ። <verse eid="1CO 13:11"/><verse number="12" style="v" sid="1CO 13:12"/>አመ ኦፍ እላሌ ኬሳን ብፈ ድምምሳኣ አርግናቲ፤ ዬሮ ሰነ ገሩ እፋን እፈት ንአርግነ። አን አመ ገርቶኮን ቤከ፤ ዬሮ ሰነ ገሩ አን አኩመ ጉቱማት ቤከሜ ሰነ ጉቱማት ቤኩፍን ጅረ።<verse eid="1CO 13:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 13:13"/>ኤጋ አመንቲን፣ አብዲፊ ጃለል ሰደንሳኒዩ ንጅራቱ። እሳን ኬሳ ገሩ ጃለለቱ ጫለ።<verse eid="1CO 13:13"/></para>
  <chapter eid="1CO 13"/>
  <chapter number="14" style="c" sid="1CO 14"/>
  <para style="s1">ቀልቤፈትና ዬሮ ዋቄፈትና</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1"/>ከራ ጃለላ ዱካ ቡኣ፤ ኬናወን ሀፉራ፣ ኬሱመቱ ኬና ራጂ ጭምሳቲ በርባዳ። <verse eid="1CO 14:1"/><verse number="2" style="v" sid="1CO 14:2"/>ነምን አፋን ሃራን ዱበቱ ከምዩ ዋቀት መሌ ነሞተት ህንዱበቱቲ። ዹጉማን ነምን ቶኮዩ እሰ ህንሁበቱ፤ እን ሀፉራን እጪቲ ዱበተ። <verse eid="1CO 14:2"/><verse number="3" style="v" sid="1CO 14:3"/>ነምን ራጂ ዱበቱ ገሩ እሳን እጃሩፍ፣ ጎርሱፊ ጀጀቤሱፍ ጄዼ ነሞተት ዱበተ። <verse eid="1CO 14:3"/><verse number="4" style="v" sid="1CO 14:4"/>ነምን አፋን ሃራን ዱበቱ ኦፉመሳ ጭምሰ፤ ከን ራጂ ዱበቱ ገሩ ወልዳ ክርስታና ጭምሰ። <verse eid="1CO 14:4"/><verse number="5" style="v" sid="1CO 14:5"/>አን አከ ሁንድኬሰን አፋን ሃራን ዱበተን ነንበርባደ፤ ጫላት ገሩ አከ ራጂ ዱበተን ነንጃለዸ። ነምን አፋን ሃራን ዱበቱ ቶኮ አከ ወልዳን ክርስታና እቲን ጀጀባቱፍ ጄዼ ዋን ዱበቱ ሰነ ዮ ሂኩ ባቴ እሰ አፋን ሃራን ዱበቱረ እሰ ራጂ ዱበቱቱ ጫለ።<verse eid="1CO 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 14:6"/>ኤጋ ያ ኦቦሎተ፣ አን ዮን ሙልአተ ዮካን ቤኩምሰ ዮካን ራጂ ዮካን በርሲሰ ቶኮ ቶኮ እስንት ህሜ መሌ ዮን አፋን ሃራ ቆፈ ዱበቻ ገረኬሰን ዹፌ ማል እስን ፈየደ? <verse eid="1CO 14:6"/><verse number="7" style="v" sid="1CO 14:7"/>ኩንስ ሜሻ ሉቡ ህንቀብኔ ከን አከ ኡሉሌቲፊ ክራራ ከኔን ሰገሌ ኬነን ብረትሌ አከኑመ፤ ኡሉሌን አፉፈሜ ዮካን ክራር ሩኩተሜ ዮ ሰገሌንሳ ገርገር ባፈሜ መሌ ነምን ቶኮ አከምት አዳን ባሴ ቤኩ ደንደአ? <verse eid="1CO 14:7"/><verse number="8" style="v" sid="1CO 14:8"/>ዮ ሰገሌን መለከታ አዳን ባፈሜ ቤከሜ መሌስ ኤኙቱ ሎላፍ ቆጳአ? <verse eid="1CO 14:8"/><verse number="9" style="v" sid="1CO 14:9"/>እስንስ አከሱመ። ዮ አፋንኬሰኒን ዱቢ ሁበተማ ዱበተን መሌ ነምን ቶኮ አከምት ዋን እስን ጄተን ሰነ ቤኩ ደንደአ? ቅሌንሰት ዱበቹኬሰኒቲ። <verse eid="1CO 14:9"/><verse number="10" style="v" sid="1CO 14:10"/>አከ አፋን ጎሰ ገራ ገራ አዱኛረ ጅረን ህንሸከሙ። ገሩ እሳን ኬሳ ከን ሂካ ህንቀብኔ ቶኮዩ ህንጅሩ። <verse eid="1CO 14:10"/><verse number="11" style="v" sid="1CO 14:11"/>ከናፉ አን ዮን ሂካ ዋን ነምን ቶኮ ዱበቱ ሁበቹ ባዼ አን ነምቸ ዱበቱ ሰነት አለጋዸ። ነምች ዱበቱ ሱንስ አነት አለጋዸ። <verse eid="1CO 14:11"/><verse number="12" style="v" sid="1CO 14:12"/>እስንስ አከሱመ። እስን ዋን ጀቤስተኒ ኬናወን ሀፉራ ቀባቹ በርባደኒፍ፣ ኬናወን ወልዳ ክርስታና ጭምሰን ጀቤሳቲ በርባዳ።<verse eid="1CO 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 14:13"/>ከናፍ ነምን አፋን ሃራን ዱበቱ ቶኮ አከ ዋን ዱበቱ ሰነ ሂኩ ደንደኡፍ ከዸቹ ቀበ። <verse eid="1CO 14:13"/><verse number="14" style="v" sid="1CO 14:14"/>ዮ አን አፋን ሃራን ከዸዼ ሀፉርኮ ንከዸታቲ፤ ቀልቢንኮ ገሩ ህንህርማቱ። <verse eid="1CO 14:14"/><verse number="15" style="v" sid="1CO 14:15"/>ዮስ አን ማለን ጎዸሬ? ሀፉረኮቲን ነንከዸዸ፤ ቀልቢኮቲንስ ነንከዸዸ፤ ሀፉረኮቲን ነንፋርፈዸ፤ ቀልቢኮቲንስ ነንፋርፈዸ። <verse eid="1CO 14:15"/><verse number="16" style="v" sid="1CO 14:16"/>ዮ ከና አቺ ኡቱ አት ሀፉረኬቲን ዋቀ ገለቴፈቹት ጅርቱ፣ ነምን እዶ ወረ ህንበረትኒ ታኤ ቶኮ ዋን አት ዱበቱ ዋን ህንቤክኒፍ አከምት ገለተ አት ዽኤስቱ ሰናፍ “አሜን” ጄቹ ደንደኣ? <verse eid="1CO 14:16"/><verse number="17" style="v" sid="1CO 14:17"/>አት ዹጉማን ስሪት ገለቴፈተ ተአ፤ ነምን ካን ገሩ እቲን ህንጀጀቤፈሙ።<verse eid="1CO 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 14:18"/>አን ዋነን ሁንዱመኬሰን ጫላ አፋን ሃራን ዱበዹፍ ዋቀ ነንገለቴፈዸ። <verse eid="1CO 14:18"/><verse number="19" style="v" sid="1CO 14:19"/>ወልዳ ክርስታና ኬሰት ገሩ ዱቢ ኩመ ኩዸን አፋን ሃራን ዱበቹረ ወረ ካን በርሲሱፍ ዱቢ ሁበተማ ሸን ዱበቹ ነንበርባደ።<verse eid="1CO 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 14:20"/>ያ ኦቦሎተ፣ አከ እጆሌት ያዱ ዺሳ፤ ዋን ሀማፍ ዳእመን ተኣ፤ ሁበትናዻን ገሩ ነመ ጉዳ ተኣ። <verse eid="1CO 14:20"/><verse number="21" style="v" sid="1CO 14:21"/>ሴረ ኬሰት አከነ ጄዸሜ በሬፈሜረ፦</para>
  <para style="q1" vid="1CO 14:21">“አን አፋን ብራቲን፣</para>
  <para style="q2" vid="1CO 14:21">አፋን አለጎታቲንስ</para>
  <para style="q1" vid="1CO 14:21">ሰበ ከነት ነንዱበዸ፤</para>
  <para style="q2" vid="1CO 14:21">እሳን ገሩ ዬሮ ሰነትሌ ነ ህንዸገአን፣</para>
  <para style="q2" vid="1CO 14:21">ጄዸ ጎፍታን።”<note caller="+" style="f"><char style="fr" closed="false">14፥21 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 28:11">እሳ 28፥11</ref>፣<ref loc="ISA 28:12">12</ref></char></char></note><verse eid="1CO 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 14:22"/>ከናፉ አፋን ሃራን ዱበቹን ወረ ህንአመንኒፍ መለቶ ተአ መሌ ወረ አመነኒፍ ምት፤ ራጂ ዱበቹን ገሩ ወረ አመነኒፍ መሌ ወረ ህንአመንኒፍ ምት። <verse eid="1CO 14:22"/><verse number="23" style="v" sid="1CO 14:23"/>ኤጋ ወልዳን አመንቶታ ጉቱን ወልት ቀበሜ ዮ ሁንድሳኒ አፋን ሃራን ዱበተን፣ ዮ ነሞትን ህንበረትን ዮካን ነሞትን ህንአመኔ ኦል ሴነን እስን መራተኒርቱ እስኒን ህንጄዸኒ? <verse eid="1CO 14:23"/><verse number="24" style="v" sid="1CO 14:24"/>ኡቱ ነምን ሁንድ ራጂ ዱበቻ ጅሩ ዮ ነምን ህንአመኔ ቶኮ ዮካን ነምን ህንበረትን ቶኮ ኦል ሴኔ እን አከ ጩበማ ተኤ ነመ ሁንዳን ንአመንሲፈመ፤ ነመ ሁንዳንስ እሰት ሙረመ፤ <verse eid="1CO 14:24"/><verse number="25" style="v" sid="1CO 14:25"/>እጪቲን ገራሳ ኬሳስ እፈት ንባፈመ። እንስ፣ “ዋቅን ዹጉማን እስን ግዱ ጅረ” ጄዼ ዱበቻ አዳን ለፈት ጎምብፈሜ ዋቀ ዋቄፈተ።<verse eid="1CO 14:25"/></para>
  <para style="s1">ስርነ ጋሪ ዬሮ ዋቄፈትናት ጅራቹ ቀቡ</para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 14:26"/>ያ ኦቦሎተ፣ ኤጋ ማል ጄነሬ? ዮሙ እስን ወልት ቀበምተንት ነምን ሁንድ ፋርፈትና ዮካን በርሲሰ ዮካን ሙልአተ ዮካን አፋን ሃራ ዮካን ሂካ አፋን ሃራ ሰና ቀበ። ኩኔን ሁንድኑ ወልዳ ክርስታና ጭምሱፍ ሆጄተሙ ቀቡ። <verse eid="1CO 14:26"/><verse number="27" style="v" sid="1CO 14:27"/>ነምን አፋን ሃራን ዱበቱ ዮ ጅራቴ ለመ ዮካን ዮ ባይአቴ ሰዲ ተአኒ ደበሬ ደበሬን ሃዱበተን፤ ነምን ቶኮሞ ሃሂኩ። <verse eid="1CO 14:27"/><verse number="28" style="v" sid="1CO 14:28"/>ዮ ነምን ሂኩ ጅራቹ ባቴ ገሩ ነምች ዱበቱ ሱን ወልዳ ክርስታና ኬሰት ጨልእሴ ኦፊሳቲፊ ዋቀት ሃዱበቱ።<verse eid="1CO 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 14:29"/>ራጆትንስ ለመ ዮካን ሰዲ ተአኒ ሃዱበተን፤ ወር ካንሞ ዋን ዱበተሙ ሰነ ሃመዳለን። <verse eid="1CO 14:29"/><verse number="30" style="v" sid="1CO 14:30"/>ዮ ወረ አች ታአን ኬሳ እሰ ቶኮፍ ሙልአትን ዹፌ፣ ነምች ዱራን ዱበቻ ቱሬ ሱን ሃጨልእሱ። <verse eid="1CO 14:30"/><verse number="31" style="v" sid="1CO 14:31"/>ነምን ሁንድ አከ በረቱፍ፣ ሁንድኑስ አከ ጀጀቤፈሙፍ ደበሬ ደበሬዻን ራጂ ዱበቹ ንደንዴሱቲ። <verse eid="1CO 14:31"/><verse number="32" style="v" sid="1CO 14:32"/>ሀፉሮትን ራጆታ ራጆታፍ ንአጀጀሙ። <verse eid="1CO 14:32"/><verse number="33" style="v" sid="1CO 14:33"/>ዋቅን አከ ወልዶተ ቁልቁሎታ ሁንዱማ ኬሰት ተኣ ጅሩ ከነ ዋቀ ጄቁምሳ ኡቱ ህንተእን ዋቀ ነጋት።<verse eid="1CO 14:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="1CO 14:34"/>ዱበርቶትን ወልዳ ክርስታና ኬሰት ሃጨልእሰን። አከ ሴር ጄዹት እሳን አከ አጀጀመን መሌ አከ ዱበተን ህንኤየመምኔፊቲ። <verse eid="1CO 14:34"/><verse number="35" style="v" sid="1CO 14:35"/>ወንት እሳን ቤኩ በርባደን ዮ ጅራቴ መነት ዽርሰሳኒ ሃጋፈተን፤ ዱበርቲን ቶኮ ወልዳ ክርስታና ኬሰት ዱበቹን ቃኒዻቲ።<verse eid="1CO 14:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 14:36"/>ዱቢን ዋቃ እስን ኬሳ አርገሜ? ዮካን እስኑመ ቆፈ ብረ ገኤ? <verse eid="1CO 14:36"/><verse number="37" style="v" sid="1CO 14:37"/>ኤኙዩ ዮ ራጂ ዮካን ነመ ሀፉራ ኦፍ ሴኤ አከ ወን አን አመ እስኒፍ በሬሱ ኩን አጀጀ ጎፍታ ተኤ ሃቤኩ። <verse eid="1CO 14:37"/><verse number="38" style="v" sid="1CO 14:38"/>ነምን ከምዩ ዮ ዋን ከነ ቤኩ ባቴ፣ እን ህንቤክን።<verse eid="1CO 14:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 14:39"/>ከናፍ ያ ኦቦሎተኮ፣ ራጂ ዱበቹ ጀቤሳቲ ሀዋ፤ አፋን ሃራን ዱበቹስ ህንዾውና። <verse eid="1CO 14:39"/><verse number="40" style="v" sid="1CO 14:40"/>ወንት ሁንድኑ ገሩ ከራ ቀጄላፊ ስርነ ቀቤሰ ተኤን ሆጄተሙ ቀበ።<verse eid="1CO 14:40"/></para>
  <chapter eid="1CO 14"/>
  <chapter number="15" style="c" sid="1CO 15"/>
  <para style="s1">ዱኣ ከኡ ክርስቶስ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1"/>አመስ ያ ኦቦሎተ፣ አን ዋኤ ወንጌለ አን እስንት ለለቤ፣ ከን እስን ፉዸተኒ እቲን ዻበተን ሰና እስን ያደቺሱ ነንበርባደ። <verse eid="1CO 15:1"/><verse number="2" style="v" sid="1CO 15:2"/>እስን ዮ ዱቢ አን እስንት ለለቤ ሰነ ጀቤስተኒ ቀበተን ወንጌሉመ ከናን ንፈይቱ። ዮ ከና አቺ አከሱማን አመንተን ጄቹዸ።<verse eid="1CO 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 15:3"/>አንስ ዋነን ፉዸዼ ዱራን ዱርሴ ደበርሴ እስንት ኬኔራቲ፤ አከ ከተቢወን ቁልቁሉን ዱበተንት፣ ክርስቶስ ጩቡኬኛፍ ጄዼ ዱኤ፤ <verse eid="1CO 15:3"/><verse number="4" style="v" sid="1CO 15:4"/>ንአዋለሜስ፤ አከ ከተቢወን ቁልቁሉን ዱበተንት ጉያ ሰደፋት ዱኣ ካፈሜ። <verse eid="1CO 15:4"/><verse number="5" style="v" sid="1CO 15:5"/>እን ዱራን ዱርሴ ኬፋት፣ ኤርገሲስ ወረ ኩዸ ለማንት ሙልአቴ። <verse eid="1CO 15:5"/><verse number="6" style="v" sid="1CO 15:6"/>ሰነ ቦዴ ዬሮ ቶኮት ኦቦሎተ ዽበ ሸኒ ኦል ተአንት ሙልአቴ፤ እሳን ኬሳስ ዮ ሙራስን ቦቆተንዩ ሄዱንሳኒ ሀመ አማት ንጅሩ። <verse eid="1CO 15:6"/><verse number="7" style="v" sid="1CO 15:7"/>ኤርገሲስ ያቆብት፣ እት ኣንሴ ኤርገሞተ ሁንደት ሙልአቴ፤ <verse eid="1CO 15:7"/><verse number="8" style="v" sid="1CO 15:8"/>ዹመረትሞ አነ ከን አከ ገተታት ዸለቴት ለካአሙት ሙልአቴ።<verse eid="1CO 15:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 15:9"/>አን ኤርገሞተ ሁንዳ ገድ፤ ኤርገማ ጄዸሜ ዋመሙንዩ ናፍ ህንመሉ፤ አን ወልዳ ክርስታና ዋቃ አርአቻን ቱሬቲ። <verse eid="1CO 15:9"/><verse number="10" style="v" sid="1CO 15:10"/>ገሩ አን አያነ ዋቃቲን አኩመን ጅሩ ከነ ጅረ፤ አያንሳ ከን ናፍ ኬነሜስ አከሱማን ህንሀፍኔ። አን ሁንዱመሳኒ ጫላ ጀባዼ ሆጄዼረ፤ ከነስ ኡቱ አነ ህንተእን አያነ ዋቃ ከን ነ ወጅን ጅሩቱ ሆጄቴ። <verse eid="1CO 15:10"/><verse number="11" style="v" sid="1CO 15:11"/>ኤጋ አነስ ተኡ ዮካን እሳን፣ ወን ኑ ለለብኑ፣ ወን እስን አመንተንስ ከኑመ።<verse eid="1CO 15:11"/></para>
  <para style="s1">ዱኣ ከኡ ወረ ዱአኒ</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 15:12"/>ክርስቶስ ወረ ዱአን ኬሳ አከ ካፈሜ ኤርገ ለለበሜ፣ እስን ኬሳ ነሞትን ቶኮ ቶኮ አከምት ዱኣ ከኡን ወረ ዱአኒ ህንጅሩ ጄቹ ደንደኡሬ? <verse eid="1CO 15:12"/><verse number="13" style="v" sid="1CO 15:13"/>ኤርገ ዱኣ ከኡን ወረ ዱአኒ ህንጅሬ፣ ክርስቶስዩ ዱኣ ህንካፈምኔ ጄቹዸካ! <verse eid="1CO 15:13"/><verse number="14" style="v" sid="1CO 15:14"/>ኤርገ ክርስቶስ ዱኣ ህንካፈምንሞ ለለብንኬኘ ፋይዳ ህንቀቡ፤ አመንቲንኬሰንስ ፋይዳ ህንቀቡ። <verse eid="1CO 15:14"/><verse number="15" style="v" sid="1CO 15:15"/>ከነ መሌስ ዋቅን ክርስቶስን ዱኣ ካሴረ ጄኔ ዋኤ ዋቃ ዋን ዹጋ ባኔፍ፣ ኑ ዋኤ ዋቃ ዹገ ባቶተ ሶባ ታኔ አርገምኔረ። ገሩ ኤርገ ወር ዱአን ህንካፈምን እን ክርስቶስን ህንካፍኔ ጄቹዸ። <verse eid="1CO 15:15"/><verse number="16" style="v" sid="1CO 15:16"/>ዮ ወር ዱአን ካፈሙ ባተን፣ ክርስቶስስ ዱኣ ህንካፈምኔቲ። <verse eid="1CO 15:16"/><verse number="17" style="v" sid="1CO 15:17"/>ኤርገ ክርስቶስ ዱኣ ህንካፈምን አመንቲንኬሰን ፋይዳ ህንቀቡ፤ እስንስ አሙመዩ ጩቡ ኬሰ ጅርቱ። <verse eid="1CO 15:17"/><verse number="18" style="v" sid="1CO 15:18"/>ዮስ ወር ኡቱ ክርስቶስት ጅረኑ ቦቆተን በዱሳኒት። <verse eid="1CO 15:18"/><verse number="19" style="v" sid="1CO 15:19"/>ዮ ጅሬኘ አማ ቆፋፍ ጄኔ ክርስቶስን አብደትኔ ኑ ወረ ነምን ሁንድ ነኡፍ ተኡኬኘ።<verse eid="1CO 15:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 15:20"/>አመ ገሩ ክርስቶስ ወረ ቦቆተኒፍ ሀንገፈ ተኤ ዹጉማን ወረ ዱአን ኬሳ ካፈሜረ። <verse eid="1CO 15:20"/><verse number="21" style="v" sid="1CO 15:21"/>አኩመ ዱት ከራ ነመ ቶኮቲን ዹፌ፣ አከሱመሞ ዱኣ ከኡን ወረ ዱአኒ ከራ ነመ ቶኮቲን ዹፌቲ። <verse eid="1CO 15:21"/><verse number="22" style="v" sid="1CO 15:22"/>አኩመ ሁንድኑ አዳሚን ዱአን፣ ሁንድኑ ክርስቶሲን ጅራቶ ንታስፈሙቲ። <verse eid="1CO 15:22"/><verse number="23" style="v" sid="1CO 15:23"/>ኩን ሁንድኑስ ዬሮ ደበሬሳት ንተአ፤ ክርስቶስ ሀንገፍትቸ፣ ኤርገሲሞ ዬሮ እን ዴብኤ ዹፉት ወረ ከን ክርስቶስ ተአን። <verse eid="1CO 15:23"/><verse number="24" style="v" sid="1CO 15:24"/>እንስ ኤርገ ቡልቺንሰ ሁንደ፣ ታይታፊ ሁምነ ሁንደ በሌሴ ቦዴ፣ ዬሮ ዋቀ አባት ሞቱማ ደበርሴ ኬኑት ዹምን ንተአ። <verse eid="1CO 15:24"/><verse number="25" style="v" sid="1CO 15:25"/>እን ሀመ ዲኖተሳ ሁንደ ሚለሳ ጀለ ገልፈቱት ሞኡ ቀባቲ። <verse eid="1CO 15:25"/><verse number="26" style="v" sid="1CO 15:26"/>ዲን ዹማ ከን በርበዴፈሙ ቀቡ ዱአ። <verse eid="1CO 15:26"/><verse number="27" style="v" sid="1CO 15:27"/>እን፣ “ዋን ሁንደ ሚለሳ ጀለ ገልቼራቲ።”<note caller="+" style="f"><char style="fr" closed="false">15፥27 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 8:6">ፋር 8፥6</ref></char></char></note> ገሩ “ወን ሁንድ” እሰ ጀለ ገልፈሜረ ጄቹን አከ እሰ ዋን ሁንደ እሰ ጀለ ገልቼ ሰነ ህንደበለን ቤከማዸ። <verse eid="1CO 15:27"/><verse number="28" style="v" sid="1CO 15:28"/>ኤርገ ዋን ከነ ጎዼ ቦዴ አከ ዋቅን ዋን ሁንዱማን ሁንዱማ ተኡፍ እልም መታንሳዩ እሰ ዋን ሁንዱማ ሚለሳ ጀለ ገልቼ ሰናፍ ንቡለ።<verse eid="1CO 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 15:29"/>ዮ ዱኣ ከኡን ጅራቹ ባቴ ነሞትን ወረ ዱአኒፍ ጄዸኒ ጩጰመን ማል ጎቹሳኒት? ወር ዱአንስ ዮ ዱኣ ህንካፈምን ነሞትን ማሊፍ ቆደሳኒ ጩጰሙሬ? <verse eid="1CO 15:29"/><verse number="30" style="v" sid="1CO 15:30"/>ኑ ማሊፍ ሰኣቲ ሁንደ በላፍ ኦፍ ሳጥለ? <verse eid="1CO 15:30"/><verse number="31" style="v" sid="1CO 15:31"/>ያ ኦቦሎተ፣ አን ጉዩመ ጉያን አከን ዱኡ ኦፍ ጀጁ ከራ ጎፍታኬኘ ክርስቶስ ዬሱሲን እስንረት ቀቡን ነንከከዸ። <verse eid="1CO 15:31"/><verse number="32" style="v" sid="1CO 15:32"/>አን አከ ነማት ኤፌሶንት ብኔንሰ ወጅን ወል ሎሉንኮ፣ ኤርገ ወር ዱአን ህንካፈምኔ፣ ማል ነ ፈየደ?</para>
  <para style="q1" vid="1CO 15:32">“ኮታ ንኛትና፤ ንዹግናስ፤</para>
  <para style="q2" vid="1CO 15:32">ቦር ንዱናቲ።”<note caller="+" style="f"><char style="fr" closed="false">15፥32 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 22:13">እሳ 22፥13</ref></char></char></note><verse eid="1CO 15:32"/></para>
  <para style="m">
    <verse number="33" style="v" sid="1CO 15:33"/>ህንጎዎምፈምና፦ “ህርያን ሀማን አመለ ጋሪ በሌሰ።” <verse eid="1CO 15:33"/><verse number="34" style="v" sid="1CO 15:34"/>ገረ ቀልቢኬሰን እሰ ቀጄላት ዴብኣ፤ ጩቡ ሆጄቹስ ዺሳ፤ ነሞትን ዋቀ ህንቤክኔ ቶኮ ቶኮ እስን ግዱ ጅሩቲ። አንስ እስን ቃኔሱፍን ዋን ከነ ዱበዸ።<verse eid="1CO 15:34"/></para>
  <para style="s1">ዸግነ ዱኣ ከኡ</para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35"/>ገሩ ነምን ቶኮ፣ “ወር ዱአን አከምት ካፈሙ? ዸግነ አከሚቲን ዹፉ?” ጄዼ ንጋፈተ ተአ። <verse eid="1CO 15:35"/><verse number="36" style="v" sid="1CO 15:36"/>ያ ጎዋ! ወን አት ፈጫፍቱ ዮ ዱኤ መሌ ጅሬኘ ህንአርገቱ። <verse eid="1CO 15:36"/><verse number="37" style="v" sid="1CO 15:37"/>ወን አት ፈጫፍቱ ሰኚዹመ፣ ጄቹንስ ሰኚ ቀመዲ ዮካን ሰኚ ምዻን ብራት መሌ ዸግነ ምዻን ብቅሌ ጉደቹፍ ጅሩ ሰና ምት። <verse eid="1CO 15:37"/><verse number="38" style="v" sid="1CO 15:38"/>ዋቅን ገሩ አኩመ ፌዼት ዸግነ እሳፍ ኬነ፤ ቶኮ ቶኮ ጎሰ ሰኚቲፍስ ዸግነ መታሳ ኬነ። <verse eid="1CO 15:38"/><verse number="39" style="v" sid="1CO 15:39"/>ፎን ሁንድኑ ቶኮ ምት፤ ነምን ፎን ጎሰ ቶኮ ቀበ፤ ሆሪን ፎን ጎሰ ብራ፣ ስምብሮትን ፎን ጎሰ ብራ፣ ቁርጡሚንስ ፎን ጎሰ ብራ ቀቡ። <verse eid="1CO 15:39"/><verse number="40" style="v" sid="1CO 15:40"/>አከሱመሞ ዸግነወን ሰሚራ ንጅሩ፤ ዸግነወን ለፈራስ ንጅሩ፤ ገሩ ኡልፍን ዸግነወን ሰሚራ ጎሰ ቶኮ፤ ኡልፍን ዸግነወን ለፈራሞ ጎሰ ብራት። <verse eid="1CO 15:40"/><verse number="41" style="v" sid="1CO 15:41"/>አዱን ኡልፍነ ጎሰ ቶኮ ቀብድ፤ ጅእስ ኡልፍነ ጎሰ ብራ፣ ኡርጂወንስ ኡልፍነ ጎሰ ብራ ቀቡ፤ ኡርጂን ቶኮ ኡልፍናን ኡርጂ ብራቲን አዳቲ።<verse eid="1CO 15:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="1CO 15:42"/>ዱኣ ከኡን ወረ ዱአኒስ አከሱመ። ዸግን ፈጫፈሙ ከን በዱዸ፤ ከን ህንበድኔ ተኤሞ ካፈመ። <verse eid="1CO 15:42"/><verse number="43" style="v" sid="1CO 15:43"/>እን ሰልጵናን ፈጫፈመ፤ ኡልፍናን ካፈመ፤ ደዸቢን ፈጫፈመ፤ ሁምናን ካፈመ፤ <verse eid="1CO 15:43"/><verse number="44" style="v" sid="1CO 15:44"/>ዸግነ ፎኒቱ ፈጫፈመ፤ ዸግነ ሀፉራቱ ካፈመ።</para>
  <para style="p" vid="1CO 15:44">ኤርገ ዸግን ፎኒ ጅራቴ፣ ዸግን ሀፉራስ ንጅረ። <verse eid="1CO 15:44"/><verse number="45" style="v" sid="1CO 15:45"/>ከናፍ፣ “አዳም ነምች ጀልቀባ ሉቡ ጅራታ ተኤ”<note caller="+" style="f"><char style="fr" closed="false">15፥45 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 2:7">ኡመ 2፥7</ref></char></char></note> ጄዸሜ በሬፈሜረ፤ አዳም እን ዹማሞ ሀፉረ ጅሬኘ ኬኑ ተኤ። <verse eid="1CO 15:45"/><verse number="46" style="v" sid="1CO 15:46"/>እን ጀልቀበት ዹፌ ገሩ እሰ ሀፉራ ኡቱ ህንተእን እሰ ፎኒት፤ እን ሀፉራሞ ኤርገሲ ዹፌ። <verse eid="1CO 15:46"/><verse number="47" style="v" sid="1CO 15:47"/>ነምች ዱራ ለፈራ ዹፌ፤ እን ከን ለፋት፤ ነምች ለመፋንሞ ሰሚራ ዹፌ። <verse eid="1CO 15:47"/><verse number="48" style="v" sid="1CO 15:48"/>ወር ከን ለፋ ተአን አኩመ ነምቸ ለፈራ ሰናት፤ ወር ከን ሰሚ ተአንሞ አኩመ ነምቸ ሰሚራ ዹፌ ሰናት። <verse eid="1CO 15:48"/><verse number="49" style="v" sid="1CO 15:49"/>ኑ አኩመ ብፈ ነምቸ ለፋ ሰና ኡፈትኔ፣ አከሱመሞ ብፈ ነምቸ ሰሚ ሰና ንኡፈትነ።<verse eid="1CO 15:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="1CO 15:50"/>ያ ኦቦሎተ፣ አከ ፎኒፊ ዺግን ሞቱማ ዋቃ ዻሉ ህንደንዴኜ ዮካን አከ እን በዱ እሰ ህንበድኔ ዻሉ ህንደንዴኜ አን እስንት ነንህመ። <verse eid="1CO 15:50"/><verse number="51" style="v" sid="1CO 15:51"/>ኩኖ፣ አን እጪቲ ቶኮ እስንትን ህመ፦ ሁንድኬኘ ህንዱኑ፤ ኑ ሁንድ ገሩ ንጌደረምነ፤ <verse eid="1CO 15:51"/><verse number="52" style="v" sid="1CO 15:52"/>ኩንስ ዬሮ መለከትን ዹማ አፉፈሙ ዬሩመ ሰነት ሀመ ልጵሱ እጃት ከን ራወተሙዸ። መለከትን ንአፉፈማቲ፤ ወር ዱአንስ ከኔን ህንበድኔ ተአኒ ንካፈሙ፤ ኑስ ንጌደረምነ። <verse eid="1CO 15:52"/><verse number="53" style="v" sid="1CO 15:53"/>እን በዱ ኩን እሰ ህንበድኔ፣ እን ዱኡ ኩንሞ እሰ ህንዱኔ ኡፈቹ ቀባቲ። <verse eid="1CO 15:53"/><verse number="54" style="v" sid="1CO 15:54"/>ዬሮ እን በዱ እሰ ህንበድኔ ኡፈቴ፣ እን ዱኡሞ እሰ ህንዱኔ ኡፈቱት ዱቢን አከነ ጄዸሜ በሬፈሜ ሱን ንራወተመ፤ “ዱት ሞእቻን ልቅምፈሜረ።”<note caller="+" style="f"><char style="fr" closed="false">15፥54 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 25:8">ፋር 25፥8</ref></char></char></note> አከሱመስ፣<verse eid="1CO 15:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="1CO 15:55"/>“ያ ዱአ፣ ሞእችኬ ሜሬ?</para>
  <para style="q2" vid="1CO 15:55">ያ ዱአ፣ እልኬንኬ ሜሬ?”<note caller="+" style="f"><char style="fr" closed="false">15፥55 </char><char style="ft" closed="false"><char style="xt"><ref loc="HOS 13:14">ሆሴ 13፥14</ref></char></char></note><verse eid="1CO 15:55"/></para>
  <para style="m">
    <verse number="56" style="v" sid="1CO 15:56"/>እልኬን ዱኣ ጩቡዸ፤ ሁምን ጩቡሞ ሴረ። <verse eid="1CO 15:56"/><verse number="57" style="v" sid="1CO 15:57"/>ዋቀ ከራ ጎፍታኬኘ ዬሱስ ክርስቶሲን ሞእቸ ኑ ኬኑፍ ገሩ ገለን ሃተኡ!<verse eid="1CO 15:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="1CO 15:58"/>ከናፉ ያ ኦቦሎተኮ ጃለተሞ፣ ጀባዻ ዻበዻ። ወን ቶኮ እስን ህንሶቾስን፤ አከ ደዸቢንኬሰን ጎፍታ ብረት ፋይዳ መሌ ህንሀፍኔ ዋን ቤክተኒፍ ዬሮ ሁንደ ሆጂ ጎፍታቲፍ ጉቱማት ኦፍ ኬና።<verse eid="1CO 15:58"/></para>
  <chapter eid="1CO 15"/>
  <chapter number="16" style="c" sid="1CO 16"/>
  <para style="s1">ቡሲ ቁልቁሎታፍ ወልት ቀበሜ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1"/>ኤጋ ዋኤ ቡሲ ቁልቁሎታፍ ወልት ቀበሙ እስንስ አኩመ አን ወልዶተ ክርስታና ከኔን ገላትያ አጀጄ ሰነት ራወዻ። <verse eid="1CO 16:1"/><verse number="2" style="v" sid="1CO 16:2"/>አከ ቡሲ ወልት ቀቡን ዬሮ አን ዹፉት ህንታኔፍ ቶኮን ቶኮንኬሰን አኩመ ገሊኬሰኒት ቶርበኑመ ቶርበኒን ጉያ ጀልቀባ ዋ ኮጳት ባሳቲ ካኣ። <verse eid="1CO 16:2"/><verse number="3" style="v" sid="1CO 16:3"/>አንስ ዬሮን እስን ብረ ዹፉት አከ ነሞትን እስን ፍለተን ኬናኬሰን ጌሰኒፍ ጠለያ እቲን ቤከመን ኬኔፊ ዬሩሳሌምት እሳን ነንኤርገ። <verse eid="1CO 16:3"/><verse number="4" style="v" sid="1CO 16:4"/>ዮ ዸቁንኮ በርባችሳ ተኤሞ እሳን ነ ወጅን ዸቁ።<verse eid="1CO 16:4"/></para>
  <para style="s1">ከሮረ ከራ ጳዉሎስ</para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 16:5"/>አን ዋነን መቄዶንያ ኬሰ ደርቡፍ፣ ዬሮን መቄዶንያ ኬሰ ደርቡት እስን ብረ ነንዹፈ። <verse eid="1CO 16:5"/><verse number="6" style="v" sid="1CO 16:6"/>አከ እስን እዶ አን ዸቁ ሁንደት ከራኮረት ነ ገርጋሩ ደንዴሰኒፍ ተሪ ዬሮ ጥኖ እስን ብረ ነንቱረ ተአ፤ ዮካን ገነ እስን ብረ ነንቱረ ተአ። <verse eid="1CO 16:6"/><verse number="7" style="v" sid="1CO 16:7"/>ዮ ጎፍታን ጄዼ አን ዋነን ዬሮ ሙራሰ እስን ብረ ቱሩ አብደዹፍ፣ አመ ኡቱን ደርቡ ጎሬ እስን አርጉ ህንበርባዱ። <verse eid="1CO 16:7"/><verse number="8" style="v" sid="1CO 16:8"/>ሀመ ጉያ ጴንጤቆስጤት ገሩ ኤፌሶን ኬሰ ነንቱረ። <verse eid="1CO 16:8"/><verse number="9" style="v" sid="1CO 16:9"/>በልበል ጉዳኒፊ ቡኣ ቀቤስ ቶኮ ናፍ በነሜራቲ፤ ሞርምቶትንስ ባይኤዸ።<verse eid="1CO 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 16:10"/>ዮ ጢሞቴዎስ ገረኬሰን ዹፌ ዋን እንስ አኩመኮ ሆጂ ጎፍታ ሆጄቱፍ ዬሮ እን እስን ብረ ቱሩት አከ እን ዋ ቶኮዩ ህንሶዳትኔ ጎዻ። <verse eid="1CO 16:10"/><verse number="11" style="v" sid="1CO 16:11"/>ከናፍ ነምን ቶኮዩ እሰ ህንቱፈትን፤ አከ እን ገረኮት ዴብኡፍስ ነጋዻን ኤርጋ፤ አን ኦቦሎተ ወጅን እሰ ኤጋን ጅራቲ።<verse eid="1CO 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 16:12"/>ዋኤ ኦቦሌሰኬኘ አጵሎስሞ አከ እን ኦቦሎተ ካን ወጅን ገረኬሰን ዹፉፍ አን ጀቤሴ እሰ ከዸዼን ቱሬ። እን ገሩ አመ ዹፉፍ ጎንኩማ ፌዺ ህንቀቡ፤ ዬሮ እሳፍ ምጃኡት ገሩ ንዹፈ።<verse eid="1CO 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 16:13"/>ደመቃ፤ አመንቲት ጭማቲ ዻበዻ፤ ጀጀባዻ፤ ጭማስ። <verse eid="1CO 16:13"/><verse number="14" style="v" sid="1CO 16:14"/>ወን እስን ሆጄተን ሁንድኑ ጃለላን ሃተኡ።<verse eid="1CO 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 16:15"/>ያ ኦቦሎተ፣ አከ ወር መነ እስጢፋኖስ ጅራተን አካያ ኬሳ ወረ ጀልቀበት አመነን ተአን እስን ንቤክቱ፤ እሳንስ ቁልቁሎተ ተጃጅሉፍ ኦፍ ኬነኒሩ። <verse eid="1CO 16:15"/><verse number="16" style="v" sid="1CO 16:16"/>አንስ አከ እስን ነሞተ አከሲቲፍ፣ ወረ እሳን ወጅን ሆጄተኒፊ ደዸበን ሁንዳፍ አጀጀምተን እስንን ከዸዻ። <verse eid="1CO 16:16"/><verse number="17" style="v" sid="1CO 16:17"/>እስጢፋኖስ፣ ፈርዶናጥሲፊ አካይቆስ ነ ብረ ዹፉሳኒት አን ገመዴረ፤ እሳን ዋን አሲ ዸበሙኬሰኒን ህርአቴ ጉተኒሩቲ። <verse eid="1CO 16:17"/><verse number="18" style="v" sid="1CO 16:18"/>እሳን ሀፉረኮፊ ሀፉረኬሰን ቦቆቺሰኒሩቲ። ከናፍ እስን ነሞተ አከናቲፍ ቤከምቲ ኬና።<verse eid="1CO 16:18"/></para>
  <para style="b"/>
  <para style="s1">ዻምሰ ነጋ ጡሙራ</para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 16:19"/>ወልዶትን ክርስታና ከኔን ብየ አስያ ነጋ እስኒፍ ዻሙ።</para>
  <para style="p" vid="1CO 16:19">አቂላፊ ጵርስቅላን፣ ወልዳን ክርስታና ከን መነሳኒ ጅርቱስ ጎፍታዻን ነጋ ጉዳ እስኒፍ ዻሙ።<verse eid="1CO 16:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 16:20"/>ኦቦሎትን ሁንድኑ ነጋ እስኒ ዻሙ።</para>
  <para style="p" vid="1CO 16:20">ዹንጎ ቁልቁሉዻን ነጋ ወል ጋፈዻ።<verse eid="1CO 16:20"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="21" style="v" sid="1CO 16:21"/>አን ጳዉሎስ፣ ጠለያ ነጋ ከነ ሀርኩመኮቲን በሬሰ።<verse eid="1CO 16:21"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="22" style="v" sid="1CO 16:22"/>ነምን ጎፍታ ህንጃለትኔ ከምዩ ሃአባረሙ። ያ ጎፍታ ኮቱ።<verse eid="1CO 16:22"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="23" style="v" sid="1CO 16:23"/>አያን ጎፍታኬኘ ዬሱስ እስን ወጅን ሃተኡ።<verse eid="1CO 16:23"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="24" style="v" sid="1CO 16:24"/>ጃለልኮ ክርስቶስ ዬሱሲን ሁንዱመኬሰን ወጅን ሃተኡ። አሜን።<verse eid="1CO 16:24"/></para>
  <chapter eid="1CO 16"/>
</usx>
