<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="HEB" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">እብሮተ</para>
  <para style="toc1">እብሮተ</para>
  <para style="toc2">እብሮተ</para>
  <para style="toc3">እብሮ</para>
  <para style="mt1">እብሮተ</para>
  <chapter number="1" style="c" sid="HEB 1"/>
  <para style="s1">ዱቢ ዋቀዮ ከን ጡሙራ፦ እልመሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1"/>በረ ዱሪ ዋቅን ዬሮ ባይኤፊ ከራ አደ አዳቲን ራጆታን አቦቲኬኘት ዱበቴ ቱሬ፤ <verse eid="HEB 1:1"/><verse number="2" style="v" sid="HEB 1:2"/>በረ ዹማ ከነ ኬሰ ገሩ እልመሳ ከን እን ዻልቱ ዋን ሁንዱማ ጎዼ ሙዴን ኑት ዱበቴ፤ እሱማንስ አዱኛወን ኡሜ። <verse eid="HEB 1:2"/><verse number="3" style="v" sid="HEB 1:3"/>እልም ጨለቅሰ ኡልፍነ ዋቃት፤ ኤኙማ ዋቃስ አኩመ ጅሩት ሙልእሰ፤ ዱቢሳ ሁምነ ቀቤሰ ሰናንስ ዋን ሁንደ ህርክሴ ባተ። እንስ ኤርገ ጩቡኬኘ ኑራ ቁልቁሌሴ ቦዴ ሰሚረ ምርገ ዋቀ ኡልፍነ ቀቤሰ ሰና ታኤ። <verse eid="HEB 1:3"/><verse number="4" style="v" sid="HEB 1:4"/>አኩመ መቃን እን ዻሌ ሱን ከን ኤርገሞታ ጫላ ጉዳ ተኤ ሰነ እንስ ኤርገሞተ ጫላ ጉዳዸ።<verse eid="HEB 1:4"/></para>
  <para style="s1">እልም ኤርገሞተ ጫሉሳ</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 1:5"/>ዋቅን ኤርገሞተ ኬሳ እሰ ከሚን፣</para>
  <para style="q1" vid="HEB 1:5">“አት እልመኮት፤</para>
  <para style="q2" vid="HEB 1:5">አን ሀርአ ስ ዸልቼረ”<note caller="+" style="f"><char style="fr" closed="false">1፥5 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 2:7">ፋር 2፥7</ref></char></char></note></para>
  <para style="m" vid="HEB 1:5">ዮካን እሰ ከሚን፣</para>
  <para style="q1" vid="HEB 1:5">“አን እሳፍ አባ ነንተአ፤</para>
  <para style="q2" vid="HEB 1:5">እንስ እልመ ናፍ ተአ”<note caller="+" style="f"><char style="fr" closed="false">1፥5 </char><char style="ft" closed="false"><char style="xt"><ref loc="2SA 7:14">2ሳሙ 7፥14</ref>፤ <ref loc="1CH 17:13">1ሴና 17፥13</ref></char></char></note></para>
  <para style="m" vid="HEB 1:5">ጄዼ ቤከ? <verse eid="HEB 1:5"/><verse number="6" style="v" sid="HEB 1:6"/>አከሱመስ ዋቅን ዮሙ እልመሳ ሀንገፈ ገረ አዱኛ ከናት ኤርጉት፣</para>
  <para style="q1" vid="HEB 1:6">“ኤርገሞትን ዋቃ ሁንድ እሰ ሃዋቄፈተን”<note caller="+" style="f"><char style="fr" closed="false">1፥6 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 32:43">ኬዴ 32፥43</ref></char></char></note></para>
  <para style="m" vid="HEB 1:6">ጄዸ። <verse eid="HEB 1:6"/><verse number="7" style="v" sid="HEB 1:7"/>ዮሙ ዋኤ ኤርገሞታ ዱበቱስ፣</para>
  <para style="q1" vid="HEB 1:7">“እን ኤርገሞተሳ ሀፉሮተ፣</para>
  <para style="q2" vid="HEB 1:7">ተጃጅልቶተሳሞ አረበ እብዳ ጎዸ”<note caller="+" style="f"><char style="fr" closed="false">1፥7 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 104:4">ፋር 104፥4</ref></char></char></note></para>
  <para style="m" vid="HEB 1:7">ጄዸ። <verse eid="HEB 1:7"/><verse number="8" style="v" sid="HEB 1:8"/>ዋኤ እልማ ገሩ አከነ ጄዸ፤</para>
  <para style="q1" vid="HEB 1:8">“ያ ዋቀዮ፣ ቴሶንኬ በረ በራ ሀመ በረ በራት ንጅራተ፤</para>
  <para style="q2" vid="HEB 1:8">ቦኩን ቀጄሉማስ ቦኩ ሞቱማኬቲ ንተአ።<verse eid="HEB 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9"/>አት ቀጄሉማ ጃለቴ፤ ጀልእነሞ ንጅብቴ፤</para>
  <para style="q2" vid="HEB 1:9">ከናፉ ዋቀዮ ዋቅንኬ ዘይቲ ገመቹቲን ስ ድቤ፣</para>
  <para style="q2" vid="HEB 1:9">ህርዮተኬ ስጫልችሴ።”<note caller="+" style="f"><char style="fr" closed="false">1፥9 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 45:6">ፋር 45፥6</ref>፣<ref loc="PSA 45:7">7</ref></char></char></note><verse eid="HEB 1:9"/></para>
  <para style="m">
    <verse number="10" style="v" sid="HEB 1:10"/>አከሱመስ እን አከነ ጄዸ፤</para>
  <para style="q1" vid="HEB 1:10">“ያ ጎፍታ፣ አት ጀልቀበት ለፈ ሁንዴስቴ፤</para>
  <para style="q2" vid="HEB 1:10">ሰሚወንስ ሆጂ ሀርከኬቲት።<verse eid="HEB 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11"/>እሳን ንበዱ፤ አት ገሩ ንጅራተ፤</para>
  <para style="q2" vid="HEB 1:11">ሁንዱምትሳኒ አኩመ ኡፈታ ንሞፈኡ፤<verse eid="HEB 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12"/>አት አኩመ ወያት እሳን መርተ፤</para>
  <para style="q2" vid="HEB 1:12">እሳን አኩመ ኡፈታት ጌደረሙ፤</para>
  <para style="q1" vid="HEB 1:12">አት ገሩ ሰኑመ፤</para>
  <para style="q2" vid="HEB 1:12">ኡሙሪንኬስ ጎንኩማ ዹመ ህንቀቡ።”<note caller="+" style="f"><char style="fr" closed="false">1፥12 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 102:25-27">ፋር 102፥25‑27</ref></char></char></note><verse eid="HEB 1:12"/></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 1:13"/>ዋቅን ኤርገሞተ ኬሳ እሰ ከሚን፣</para>
  <para style="q1" vid="HEB 1:13">“ሀመ አን ዲኖተኬ ኤጄተ ሚለኬቲ ጎዹት፣</para>
  <para style="q2" vid="HEB 1:13">ገረ ምርገኮ ታእ”<note caller="+" style="f"><char style="fr" closed="false">1፥13 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 110:1">ፋር 110፥1</ref></char></char></note></para>
  <para style="m" vid="HEB 1:13">ጄዸ? <verse eid="HEB 1:13"/><verse number="14" style="v" sid="HEB 1:14"/>ኤርገሞትን ሁንድኑ ሀፉሮተ ተጃጅለን ከኔን ወረ ፈይነ ዻለን ተጃጅሉፍ ኤርገመን ምቲ?<verse eid="HEB 1:14"/></para>
  <chapter eid="HEB 1"/>
  <chapter number="2" style="c" sid="HEB 2"/>
  <para style="s1">አኬከቺሰ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1"/>ከናፉ ኑ አከ ዋን ዸጌኜራ ህንጀልአትኔፍ ዋን ሰነረት ጥዬፈኖ ጉዳ ጎቹ ቀብነ። <verse eid="HEB 2:1"/><verse number="2" style="v" sid="HEB 2:2"/>ሰበቢንሳስ ኤርገ ዱቢን ኤርገሞታን ዱበተሜ ሱን ኤገሙ ቀባቴ፣ ሴረ ጨብሱፊ አጀጀሙ ድዱን ሁንድስ ኤርገ አደቢ መሉ አርገተኒ፣ <verse eid="HEB 2:2"/><verse number="3" style="v" sid="HEB 2:3"/>ዮስ ኑ ዮ ፈይነ ጉዳ አከና ቱፈትኔ፣ አከምት አደቢ ከነ ጀላ ባነሬ? ፈይን ጀልቀበት ጎፍታዻን ለብሰሜ ኩን ወረ ዸገአኒን ኑፍ ምርከኔፈሜ። <verse eid="HEB 2:3"/><verse number="4" style="v" sid="HEB 2:4"/>ዋቅን መለቶን፣ ራጂፊ ሆጂ ድንቂ አደ አዳቲን አከሱመስ ኬናወን ሀፉረ ቁልቁሉ ከኔን አከ ፌዺሳት ኬነመኒን ዹጋ በኤረ።<verse eid="HEB 2:4"/></para>
  <para style="s1">ዬሱስ ጉቱማት ነመ ታስፈሜ</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5"/>እን አዱኛ ዹፉፍ ጅሩ፣ ከን ኑ ዋኤሳ ዱበትኑ ሰነ ኤርገሞተ ጀለ ህንገልችኔ። <verse eid="HEB 2:5"/><verse number="6" style="v" sid="HEB 2:6"/>ነምን ቶኮ ገሩ እዶ ቶኮት አከነ ጄዼ ዹጋ በኤረ፤</para>
  <para style="q1" vid="HEB 2:6">“አከ አት እሳፍ ያዱፍ ነምን ማል?</para>
  <para style="q2" vid="HEB 2:6">አከ እሳፍ ዽምቱፍ እልም ነማ ማል?<verse eid="HEB 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7"/>አት ጥኖሼ ኤርገሞታ ገድ እሰ ጎቴ፤</para>
  <para style="q2" vid="HEB 2:7">ኡልፍናፊ ከበጃን እሰ ጎንፍቴ፤ <optbreak/> ሆጂ ሀርከኬቲረትስ እሰ ሙዴ።<verse eid="HEB 2:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 2:8"/>ዋን ሁንደስ ሚለሳ ጀለ ገልችቴ።”<note caller="+" style="f"><char style="fr" closed="false">2፥8 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 8:4-6">ፋር 8፥4‑6</ref></char></char></note></para>
  <para style="m" vid="HEB 2:8">እን ዮሙ ዋን ሁንደ እሰ ጀለ ገልቼት ወን እን ኡቱ እሰ ጀለ ህንገልችን ሀምብሴ ቶኮዩ ህንጅሩ። ተኡስ ዬሮ አማ ወን ሁንድኑ እሰ ጀለ ገሌ ህንአርግኑ። <verse eid="HEB 2:8"/><verse number="9" style="v" sid="HEB 2:9"/>ገሩ ዬሱስ እን አያነ ዋቃቲን ነመ ሁንዳፍ ዱአ ዸንዸሙፍ ጄዼ ጥኖሼ ኤርገሞታ ገድ ተኤ ቱሬ ሱን ዽጵነ ዱኣ ዋን ዽጰቴፍ አመ ኡልፍናፊ ከበጃን ጎንፈሜ አርግነ።<verse eid="HEB 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 2:10"/>ዋቅን ወን ሁንድ እሳፍ ጅራቱፊ እሳን ጅራቱ ሱን እልማን ባይኤ ገረ ኡልፍናት ጌሱፍ ጄዼ መታ ፈይነሳኒ ዽጵነ ከን ህርእነ ህንቀብኔ ጎቹን እሳፍ ንመለ ቱሬ። <verse eid="HEB 2:10"/><verse number="11" style="v" sid="HEB 2:11"/>እን ነሞተ ቁልቁሌሱፊ ከኔን ቁልቁሌፈመን ሁንድ ከኑመ አባ ቶኮት። ከናፉ ዬሱስ ኦቦሎተ ጄዼ እሳን ዋሙ ህንቃነኡ። <verse eid="HEB 2:11"/><verse number="12" style="v" sid="HEB 2:12"/>እን፣</para>
  <para style="q1" vid="HEB 2:12">“መቃኬ ኦቦሎተኮት ነንለብሰ፤</para>
  <para style="q2" vid="HEB 2:12">ወልዳ ክርስታና ኬሰትስ ፋርፈትናዻን ስን ጀጀዸ”<note caller="+" style="f"><char style="fr" closed="false">2፥12 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 22:22">ፋር 22፥22</ref></char></char></note></para>
  <para style="m" vid="HEB 2:12">ጄዸ። <verse eid="HEB 2:12"/><verse number="13" style="v" sid="HEB 2:13"/>አከሱመስ፣</para>
  <para style="q1" vid="HEB 2:13">“አን እሰ ነንአመነዸ”<note caller="+" style="f"><char style="fr" closed="false">2፥13 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 8:17">እሳ 8፥17</ref></char></char></note></para>
  <para style="m" vid="HEB 2:13">ጄዸ። አመስ እን፣</para>
  <para style="q1" vid="HEB 2:13">“አኒፊ እጆሌን ዋቀዮ ና ኬኔ ኩኖት”<note caller="+" style="f"><char style="fr" closed="false">2፥13 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 8:18">እሳ 8፥18</ref></char></char></note></para>
  <para style="m" vid="HEB 2:13">ጄዸ።<verse eid="HEB 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14"/>ሰበቢ እጆሌን ሱን ፎኒፊ ዺገ ቀበኒፍ፣ ዬሱስስ ዱአ ኦፊሳቲን ዲያብሎስ እሰ ዱአረት ሁምነ ቀቡ ሰነ በሌሱፍ ጄዼ ነሙማሳኒ ቆደቴ፤ <verse eid="HEB 2:14"/><verse number="15" style="v" sid="HEB 2:15"/>እንስ ወረ በረ ጅሬኘሳኒ ሁንደ ገርቡማ ሶዳ ዱኣቲን ህዸመኒ ቱረን ብልሰ ባሱፍ ጄዼ ዋን ከነ ጎዼ። <verse eid="HEB 2:15"/><verse number="16" style="v" sid="HEB 2:16"/>እን ዹጉማኑ ሰኚ አብረሃም ገርጋሩፍ መሌ ኤርገሞተ ዋቃ ገርጋሩፍ ምት። <verse eid="HEB 2:16"/><verse number="17" style="v" sid="HEB 2:17"/>ከናፉ እን ዋቀ ተጃጅሉ ኬሰት አከ ሉበ ኦል ኣና አራረ ቀቤሳፊ አመነማ ተኡፍ፣ አከ ጩቡ ነሞታቲፍ አራረ ቡሱፍ ዋን ሁንዳን ኦቦሎተሳ ፈካቹቱ እሰረ ቱሬ። <verse eid="HEB 2:17"/><verse number="18" style="v" sid="HEB 2:18"/>እን መታንሳ ዋን ዽጵነ ኬሰት ቆረሜፍ ወረ ቆረማ ጅረን ገርጋሩ ንደንደአ።<verse eid="HEB 2:18"/></para>
  <chapter eid="HEB 2"/>
  <chapter number="3" style="c" sid="HEB 3"/>
  <para style="s1">ዬሱስ ሙሴ ጫለ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1"/>ከናፉ ያ ኦቦሎተ ቁልቁሎተ፣ ወረ ዋምቸ ሰሚ ኬሰት ህርማተን፣ ዬሱስ ኤርገማፊ ሉበ ኦል ኣና አመንቲኬኛ ሰነ እላላ። <verse eid="HEB 3:1"/><verse number="2" style="v" sid="HEB 3:2"/>አኩመ ሙሴን መነ ዋቃ ሁንደ ኬሰት አመነማ ቱሬ ሰነ እንስ እሰ እሰ ሙዴፍ አመነማ ቱሬ። <verse eid="HEB 3:2"/><verse number="3" style="v" sid="HEB 3:3"/>አኩመ ነምን መነ እጃሩ ቶኮ መነ ሰነ ጫላ ከበጀ ጉዳ ቀቡ፣ እንስ ሙሴ ጫላ ከበጀ ጉዳ ቀበ። <verse eid="HEB 3:3"/><verse number="4" style="v" sid="HEB 3:4"/>ቶኮን ቶኮን መና ነማን እጃረማቲ፤ ከን ዋን ሁንደ እጃሬ ገሩ ዋቀ። <verse eid="HEB 3:4"/><verse number="5" style="v" sid="HEB 3:5"/>ሙሴን ዋን ፉልዱረት ዱበተሙፍ ጅሩ ዹጋ በኡፍ አከ ተጃጅላ ቶኮት መነ ዋቃ ሁንደ ኬሰት አመነማ ቱሬ።<note caller="+" style="f"><char style="fr" closed="false">3፥5 </char><char style="ft" closed="false"><char style="xt"><ref loc="NUM 12:7">ለኮ 12፥7</ref></char></char></note> <verse eid="HEB 3:5"/><verse number="6" style="v" sid="HEB 3:6"/>ክርስቶስ ገሩ አከ እልማት መነ ዋቃረት አመነማዸ። ኑስ ዮ እጀ ጀብነኬኛፊ አብዲ እቲን ቦኑ ሰነ ጀቤስኔ ቀበትኔ፣ ኑ መነሳት።<verse eid="HEB 3:6"/></para>
  <para style="s1">አኬከቺሰ አመንቲ ዸቡረት ኬነሜ</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7"/>ከናፉ አኩመ ሀፉር ቁልቁሉን ጄዹ፦</para>
  <para style="q1" vid="HEB 3:7">“እስን ዮ ሀርአ ሰገሌሳ ዸጌሰን፣<verse eid="HEB 3:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 3:8"/>አከ ዬሮ ቆሩምሳ ገሞጂ ኬሰት</para>
  <para style="q1" vid="HEB 3:8">ፍንጭሉን ጎተን ሰነ፣</para>
  <para style="q2" vid="HEB 3:8">መታ ህንጀባትና፤<verse eid="HEB 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 3:9"/>አቦቲንኬሰን አችት ነ ቆረኒ ነ እላለን፤</para>
  <para style="q2" vid="HEB 3:9">ወጋ አፉርተመስ ዋን አን ሆጄዼ አርገን።<verse eid="HEB 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 3:10"/>ከናፉ አን ዸሎተ ሰነት ኣሬ፣</para>
  <para style="q2" vid="HEB 3:10">‘ዬሮ ሁንደ ቀልቢሳኒቲን ዶጎጎሩ፤</para>
  <para style="q2" vid="HEB 3:10">እሳን ከራኮ ህንቤክኔ’ ጄዼ።<verse eid="HEB 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 3:11"/>ከናፉ አን ዼከምሰኮቲን፣</para>
  <para style="q2" vid="HEB 3:11">‘እሳን ቦቆናኮት ህንገለን’ ጄዼ ከከዼ።”<note caller="+" style="f"><char style="fr" closed="false">3፥11 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 95:7-11">ፋር 95፥7‑11</ref></char></char></note><verse eid="HEB 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12"/>ያ ኦቦሎተ፣ አከ እስን ኬሳ ነምን ቶኮዩ ገራ ሀማፊ ህንአመኔ ከን ዋቀ ጅራታራ ነመ ፈጌሱ ህንቀባትኔፍ ኦፍ ኤገዻ። <verse eid="HEB 3:12"/><verse number="13" style="v" sid="HEB 3:13"/>ገሩ እስን ኬሳ አከ ነምን ቶኮዩ ጎዎምሳ ጩቡቲን መተ ጀቤሰ ህንታኔፍ ኡቱ “ሀርአ” ጄዸማ ጅሩ ጉዩመ ጉያን ወል ጀጀቤሳ። <verse eid="HEB 3:13"/><verse number="14" style="v" sid="HEB 3:14"/>ኑስ ዮ አመንቲኬኘ እሰ ጀልቀባ ሰነ ሀመ ዹማት ጀቤስኔ ቀበትኔ ክርስቶስ ወጅን ህርማቶተ ንታናቲ። <verse eid="HEB 3:14"/><verse number="15" style="v" sid="HEB 3:15"/>ኩንስ አኩመ፣</para>
  <para style="q1" vid="HEB 3:15">“እስን ዮ ሀርአ ሰገሌሳ ዸጌሰን፣</para>
  <para style="q2" vid="HEB 3:15">አከ ዬሮ ፍንጭላ ሰነ፣</para>
  <para style="q2" vid="HEB 3:15">መታ ህንጀባትና”<note caller="+" style="f"><char style="fr" closed="false">3፥15 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 95:7">ፋር 95፥7</ref>፣<ref loc="PSA 95:8">8</ref></char></char></note></para>
  <para style="m" vid="HEB 3:15">ጄዸሜ በሬፈሜዸ።<verse eid="HEB 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16"/>ወር ዸገአኒ ፍንጭለን ሱን ኤኙ? ወረ ሙሴን ቀጄልቼ ግብጢ ባሴ ሰነ ሁንደ ምቲ? <verse eid="HEB 3:16"/><verse number="17" style="v" sid="HEB 3:17"/>ዋቅን ወጋ አፉርተመ ኤኙ ፋት ኣሬ? ወሩመ ጩቡ ሆጄተኒ ሬፍሳኒ ገሞጂ ኬሰት ኩኩፌ ሰነት ምቲ? <verse eid="HEB 3:17"/><verse number="18" style="v" sid="HEB 3:18"/>ዮ ወሩመ አጀጀሙ ድደን ሰነ ተኤ መሌ ዋቅን አከ እሳን ጎንኩማ ቦቆናሳት ህንገሌፍ ኤኙ ፋት ከከቴሬ? <verse eid="HEB 3:18"/><verse number="19" style="v" sid="HEB 3:19"/>ከናፉ አከ እሳን ሰበቢ አመንቲ ዸቢሰሳኒቲፍ ቦቆና ሰነት ገሉ ህንደንደእን አርግነ።<verse eid="HEB 3:19"/></para>
  <chapter eid="HEB 3"/>
  <chapter number="4" style="c" sid="HEB 4"/>
  <para style="s1">ቦቆና ጉያ ሰንበታ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1"/>ከናፍ ዋዳን ቦቆናሳት ገሉ ሱን አመዩ ዋን ጅሩፍ እስን ኬሳ ነምን ከምዩ ኡቱ ቦቆና ሰነት ህንገልን አከ ህንሀፍኔ ኦፍ ሃኤገትኑ። <verse eid="HEB 4:1"/><verse number="2" style="v" sid="HEB 4:2"/>ወንጌል እሳንት ለለበሜ ኑትስ ለለበሜራቲ፤ ገሩ ዱቢን ለለበሜ ሱን ዋን አመንቲሳኒቲን ወል ህንፉዸትኔፍ ወረ ዸገአን ሰናፍ ፋይዳ ቶኮሌ ህንኬንኔ። <verse eid="HEB 4:2"/><verse number="3" style="v" sid="HEB 4:3"/>ኑ ወር አመኔ ቦቆና ሰነት ንገለ፤ ኩንስ አኩመ እን፣</para>
  <para style="q1" vid="HEB 4:3">“ከናፉ አን ዼከምሰኮቲን፣</para>
  <para style="q2" vid="HEB 4:3">‘እሳን ቦቆናኮት ህንገለን’ ጄዼ</para>
  <para style="q2" vid="HEB 4:3">ከከዼ”<note caller="+" style="f"><char style="fr" closed="false">4፥3 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 95:11">ፋር 95፥11</ref></char></char></note> ጄዹ ሰናዸ።</para>
  <para style="m" vid="HEB 4:3">ተኡስ ሆጂንሳ ኡመመ አዱኛቲ ጀልቀቤ ጡሙረሜረ። <verse eid="HEB 4:3"/><verse number="4" style="v" sid="HEB 4:4"/>እንስ እዶ ቶኮት ዋኤ ጉያ ቶርበፋ፣ “ዋቅን ጉያ ቶርበፋት ሆጂሳ ሁንዱማራ ቦቆቴ”<note caller="+" style="f"><char style="fr" closed="false">4፥4 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 2:2">ኡመ 2፥2</ref></char></char></note> ጄዼ ዱበቴ። <verse eid="HEB 4:4"/><verse number="5" style="v" sid="HEB 4:5"/>አመስ እን እዶዹመ ከነት፣ “እሳን ቦቆናኮት ህንገለን”<note caller="+" style="f" category="dup"> <char style="fr" closed="false">4፥5 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 95:11">ፋር 95፥11</ref></char></char></note> ጄዸ።<verse eid="HEB 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 4:6"/>አመዩ አከ ነሞትን ቶኮ ቶኮ እት ገለኒፍ እዶን ቦቆና ሱን ሀምብፈሜረ፤ ወር ዱራን ወንጌል እት ለለበሜ ሱንሞ ሰበቢ አጀጀሙ ድደኒፍ ቦቆና ሰነት ህንገሌ። <verse eid="HEB 4:6"/><verse number="7" style="v" sid="HEB 4:7"/>ከናፉ ዋቅን ዴብሴ ጉያ ቶኮ “ሀርአ” ጄዼ ዋሙዻን ሙርቴሴ። እንስ አኩመ ከናን ዱረ ዱበተሜ ሰነ በረ ዼራ ቦዴ ከራ ዳዊቲቲን፣</para>
  <para style="q1" vid="HEB 4:7">“እስን ዮ ሀርአ ሰገሌሳ ዸጌሰን፣</para>
  <para style="q2" vid="HEB 4:7">መታ ህንጀባትና”<note caller="+" style="f" category="dup"> <char style="fr" closed="false">4፥7 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 95:7">ፋር 95፥7</ref>፣<ref loc="PSA 95:8">8</ref></char></char></note> ጄዸ።<verse eid="HEB 4:7"/></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 4:8"/>ኡቱ እያሱን ቦቆና ሰነት እሳን ገልቼ ጅራቴ፣ ስላ ዋቅን ኤርገሲ ዋኤ ጉያ ብራ ህንዱበቱ ቱሬቲ። <verse eid="HEB 4:8"/><verse number="9" style="v" sid="HEB 4:9"/>ከናፉ ቦቆናን ሰንበታ ሰበ ዋቃቲፍ ካአሜረ፤ <verse eid="HEB 4:9"/><verse number="10" style="v" sid="HEB 4:10"/>ነምን ቦቆና ዋቃት ገሉ ከምዩ አኩመ ዋቅን ሆጂሳራ ቦቆቴ ሰነ፣ እንስ ሆጂሳራ ንቦቆተ።<note caller="+" style="f" category="dup"> <char style="fr" closed="false">4፥10 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 2:2">ኡመ 2፥2</ref></char></char></note> <verse eid="HEB 4:10"/><verse number="11" style="v" sid="HEB 4:11"/>ከናፉ አከ ነምን ቶኮሌ ፈኬኘ አጀጀሙ ድዱ ጀረ ሰና ዱካ ቡኤ ቦቆና ሰነት ገሉ ህንዸብኔፍ ኮታ ቦቆና ሰነት ገሉፍ ንተታፈትና።<verse eid="HEB 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12"/>ዱቢን ዋቃ ጅራታፊ ከን ሆጄቱዻቲ። ጎራዴ ቀረ ለመ ቀቡ ከምዩ ጫላ ቀረማዸ፤ ሀመ ሉቡፊ ሀፉረ፣ ቡሳፊ ዹከ ገርገር ባሱት ወራኔ ሴነ፤ ያዳፊ ፌዺ ገራ ነማስ ንቆረ። <verse eid="HEB 4:12"/><verse number="13" style="v" sid="HEB 4:13"/>ኡመመ ሁንደ ኬሳ ወንት ፉለ ዋቃ ዱራ ዾከቱ ቶኮሌ ህንጅሩ። ወንት ሁንድ እጀሳ ዱረት ቁላፊ ሳቀማዸ፤ ኑስ ዋኤ መታኬኛ ዴቢ ኬኑፊ ቀብነ።<verse eid="HEB 4:13"/></para>
  <para style="s1">ዬሱስ ሉበ ኦል ኣና ጉድቸ</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14"/>ኤጋ ሉበ ኦል ኣና ጉድቸ እሰ ሰሚወን ኬሰ ደርቤ፣ ዬሱስ እልመ ዋቃ ዋን ቀብኑፍ ኮታ አመንቲኬኘ ጀቤስኔ ቀበትና። <verse eid="HEB 4:14"/><verse number="15" style="v" sid="HEB 4:15"/>ኑ ሉበ ኦል ኣና ደዸቢኬኘ ኬሰት ገራ ኑ ህንላፍኔ ህንቀብኑቲ፤ ገሩ ከን ዋን ሁንዳን አኩመኬኘ ቆረሜ ቀብነ፤ ተኡስ እን ጩቡ ህንሆጄትኔ። <verse eid="HEB 4:15"/><verse number="16" style="v" sid="HEB 4:16"/>ከናፉ አከ አራረ አርገትኑፊ አከ አያነ ዬሮ ኑ በርባችሱት ኑ ገርጋሩ አርገትኑፍ ኮታ ገረ ቴሶ አያናት ሶዳ መሌ ዽኣትና።<verse eid="HEB 4:16"/></para>
  <chapter eid="HEB 4"/>
  <chapter number="5" style="c" sid="HEB 5"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1"/>ቶኮን ቶኮን ሉበ ኦል ኣና ነሞተ ግዱዻ ፍለተሜ ዋን ዋቀ እላለቱረት ነሞተ እዶ ቡኤ ሰበቢ ጩቡቲፍ ኬናፊ ኣርሳ ዽኤሱፍ ሙደመ። <verse eid="HEB 5:1"/><verse number="2" style="v" sid="HEB 5:2"/>እን መታንሳዩ ዋን ደዸቢ ኬሰ ጅሩፍ ወላልቶታፊ ወረ ከራራ ጀለተኒፍ ገራ ላፉ ንደንደአ። <verse eid="HEB 5:2"/><verse number="3" style="v" sid="HEB 5:3"/>ሰበቢ ከናፍ እን ጩቡ ኦፊሳቲፍ፣ አከሱመስ ጩቡ ነሞታቲፍ ኣርሳ ዽኤሱ ቀበ። <verse eid="HEB 5:3"/><verse number="4" style="v" sid="HEB 5:4"/>ነመ አኩመ ኣሮንት ዋቃን ዋመሜ መሌ፣ ነምን ከምዩ ኡልፍነ ከነ ኦፊሳቲፍ ህንፉዸቱ።<verse eid="HEB 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 5:5"/>ክርስቶስስ አከሱመ ሉበ ኦል ኣና ተኡፍ ኦፍ ህንኡልፌስኔ። ዋቅን ገሩ፣</para>
  <para style="q1" vid="HEB 5:5">“አት እልመኮት፤</para>
  <para style="q2" vid="HEB 5:5">አን ሀርአ ስ ዸልቼረ”<note caller="+" style="f"><char style="fr" closed="false">5፥5 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 2:7">ፋር 2፥7</ref></char></char></note></para>
  <para style="m" vid="HEB 5:5">ጄዼን። <verse eid="HEB 5:5"/><verse number="6" style="v" sid="HEB 5:6"/>እዶ ብራትስ፣</para>
  <para style="q1" vid="HEB 5:6">“አኩመ ስርነ መልከሴዴቅት፣</para>
  <para style="q2" vid="HEB 5:6">አት ሉበ በረ በራት”<note caller="+" style="f"><char style="fr" closed="false">5፥6 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 110:4">ፋር 110፥4</ref></char></char></note></para>
  <para style="m" vid="HEB 5:6">ጄዸ።<verse eid="HEB 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7"/>ዬሱስ ዬሮ ለፈረ ጅራቻ ቱሬት እየ ጉዳፊ እምማኒን እሰ ዱአ እሰ ኦልቹ ደንደኡ ሰነት ከዸትናፊ ዋመተ ዽኤፈቴ፤ ሰበቢ እን ሶዳ ዋቃ ቀቡፍስ ከዸትናንሳ ንዸገአሜፍ። <verse eid="HEB 5:7"/><verse number="8" style="v" sid="HEB 5:8"/>እን እልመ ተኡዩ ዽጵነሳ ሰነራ አጀጀሙ በረቴ፤ <verse eid="HEB 5:8"/><verse number="9" style="v" sid="HEB 5:9"/>ኤርገ ከን ሙዳ ህንቀብኔ ታስፈሜሞ ወረ እሳፍ አጀጀመን ሁንዳፍ ቡርቃ ፈይነ በረ በራ ተኤ። <verse eid="HEB 5:9"/><verse number="10" style="v" sid="HEB 5:10"/>አከ ስርነ መልከሴዴቅትስ ሉበ ኦል ኣና ጄዸሜ ዋቃን ዋመሜ።<verse eid="HEB 5:10"/></para>
  <para style="s1">አኬከቺሰ</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11"/>ኑ ዋኤሳ ዋን ጄኑ ባይኤ ቀብነ፤ እስን ገሩ ዋን ሁበቹት ደዸቦ ታተኒፍ እስኒ እብሱን ረክሳዸ። <verse eid="HEB 5:11"/><verse number="12" style="v" sid="HEB 5:12"/>እስን ዬሮ ከነት በርሲስቶተ ተኡ ቀብዱ ቱሬ፤ እስንሞ ነመ ዋኤ ዹጋ ዱቢ ዋቃ ከን ጀልቀባ እረ ዴብኤ እስን በርሲሱቱ እስን በርባችሰ። ኛተ ጀባታስ ኡቱ ህንተእን ኣነን እስን በርባችሰ። <verse eid="HEB 5:12"/><verse number="13" style="v" sid="HEB 5:13"/>ነምን ኣነኒን ጅራቱ ከምዩ ዋን አመሌ ዳእመ ተኤፍ ዱቢ ቀጄሉማ ህንቤኩ። <verse eid="HEB 5:13"/><verse number="14" style="v" sid="HEB 5:14"/>ኛትን ጀባታን ገሩ ነሞተ ብልቻቶ ከኔን ዋን ጋሪፊ ዋን ሀማ ገርገር ባሰኒ ቤኩፍ ኦፍ ሌንጅሰኒፍ ተአ።<verse eid="HEB 5:14"/></para>
  <chapter eid="HEB 5"/>
  <chapter number="6" style="c" sid="HEB 6"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1"/>ከናፉ ኮታ በርሲሰ ዋኤ ክርስቶስ እሰ ጀልቀባ ሰነ ዺፍኔ ገረ ብልችናት ደበራ፤ ዋኤ ሆጂ ገረ ዱኣት ነመ ጌሱ እራ ዴብኡፊ ዋኤ ዋቀት አመኑ ለመተ ሁንዴ ህንቡፍኑ፤ <verse eid="HEB 6:1"/><verse number="2" style="v" sid="HEB 6:2"/>አከሱመስ በርሲሰ ዋኤ ጩጳ፣ ዋኤ ሀርከ ነመረ ካኡ፣ ዋኤ ዱኣ ከኡ ወረ ዱአኒቲፊ ዋኤ ሙርቲ በረ በራ አመስ ሁንዴ ህንቡፍኑ። <verse eid="HEB 6:2"/><verse number="3" style="v" sid="HEB 6:3"/>ኑስ ዮ ዋቅን ጄዼ ዋን ከነ ንጎነ።<verse eid="HEB 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4"/>ወረ ዬሮ ቶኮ እፍን እፌፊ ኬና ሰሚ ምኤፈተን፣ ከኔን ሀፉረ ቁልቁሉራ ቆደተን፣ <verse eid="HEB 6:4"/><verse number="5" style="v" sid="HEB 6:5"/>ወረ ጋሩማ ዱቢ ዋቃቲፊ ሁምነ በረ ዹፉፍ ጅሩ ሰና ምኤፈተኒ <verse eid="HEB 6:5"/><verse number="6" style="v" sid="HEB 6:6"/>ኤርገሲ ገሩ አመንቲራ ገረገለን፣ ገረ ቀልቢ ጅጂረትናት እሳን ፍዱን ህንደንደአሙ፤ ሰበቢንሳስ እሳን ፌዹመሳኒቲን ዴብሰኒ እልመ ዋቃ ንፈንሱ፤ ፉለ ነሞታ ዱረትስ ሰልጵነት እሰ ሳጥሉ። <verse eid="HEB 6:6"/><verse number="7" style="v" sid="HEB 6:7"/>ለፍት ቦካ ዬሮ ባይኤ እረት ሮቡ ዹግዴ ወረ እሼ ቆተተኒፍ ምዻን ፈየዱ ኬንቱ ኤበ ዋቃ አርገት። <verse eid="HEB 6:7"/><verse number="8" style="v" sid="HEB 6:8"/>ለፍት ቆራቲፊ ሶኮሩ ብቅልችቱ ገሩ ፋይዳ ህንቀብዱ፤ አባረሙስ ጌሴርት። ዹምንሼስ ጉበሙዸ።<verse eid="HEB 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9"/>ያ ምቾተ ጃለተምቶተ፣ ኑ ዮ አከነ ዱበትኔሌ ዋኤኬሰን ዋን ወዩ፣ ዋን ፈይነ ወጅን ዴሙስ አከ ቀብደን ምርከኔፈትኔረ። <verse eid="HEB 6:9"/><verse number="10" style="v" sid="HEB 6:10"/>ዋቅን ቁልቁሎተ ተጃጅሉኬሰኒፊ አመስ ተጃጅሉኬሰኒን ሆጂ እስን ሆጄተኒፊ ጃለለ መቃሳቲፍ አርግሲፍተን እራንፈቹፍ ጀልኣ ምቲቲ። <verse eid="HEB 6:10"/><verse number="11" style="v" sid="HEB 6:11"/>ኑስ አከ ቶኮን ቶኮንኬሰን አብዲኬሰን ምርከኔስተኒ ሀመ ዹማት ተታፊ አከና አርግሲፍተን በርባድነ። <verse eid="HEB 6:11"/><verse number="12" style="v" sid="HEB 6:12"/>ኑ አከ እስን ፈኬኘ ወረ አመንቲፊ ኦብሳን ዋን ዋዳ ገለሜ ሰነ ዻለኒ ዱካ ቡተን በርባድነ መሌ አከ እስን ዽባኦ ታተን ህንበርባድኑ።<verse eid="HEB 6:12"/></para>
  <para style="s1">ዋዳን ዋቃ አመነማ ተኡሳ</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13"/>ዋቅን ዬሮ አብረሃሚፍ ዋዳ ገሌት ከን እሰ ጫሉ ከን እን እቲን ከከቱ ቶኮዩ ዋን ህንጅሬፍ መቱመ ኦፊቲን ከከቴ። <verse eid="HEB 6:13"/><verse number="14" style="v" sid="HEB 6:14"/>እንስ፣ “አን ዹጉማን ኤበ፣ ስን ኤብሰ፤ ባይእሱስ ስን ባይእሰ”<note caller="+" style="f"><char style="fr" closed="false">6፥14 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 22:17">ኡመ 22፥17</ref></char></char></note> ጄዸ። <verse eid="HEB 6:14"/><verse number="15" style="v" sid="HEB 6:15"/>ከናፉ አብረሃም ኦብሳን ኤገቴ ዋን ዋዳ ገለሜ ሰነ አርገቴ።<verse eid="HEB 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 6:16"/>ነሞትን ከን እሳን ጫሉን ከከቱ፤ ከኩን ሱንስ ዋን ጄዸሜ ሰነ ምርከኔሴ አከ ፈልሚን ሁንዱምቱ ፊጣን በኡ ጎዸ። <verse eid="HEB 6:16"/><verse number="17" style="v" sid="HEB 6:17"/>ዋቅን ሃለ ካዮሳ ከን ህንጌደረምኔ ሰነ ጫላት እብሴ ወረ ዋዳ ዻለንት አርግሲሱ ዋን በርባዴፍ ዋዳ ሰነ ከኩዻን ጭምሴ። <verse eid="HEB 6:17"/><verse number="18" style="v" sid="HEB 6:18"/>ኤጋ ዋን ህንጌደረምኔ ከን ዋቅን ዋኤሳኒ ሶቡ ህንደንዴኜ ለመቱ ጅረ፤ ከናፉ ኑ ወር እሰት በቀትኔ አብዲ ፉለኬኘ ዱረ ካአሜ ሰነ ጀቤስኔ ቀበቹፍ ጀጀብነ ጉዳ ቀብነ። <verse eid="HEB 6:18"/><verse number="19" style="v" sid="HEB 6:19"/>ኑስ አብዲ ከነ አከ ሂቱ ዶኒት ሉቡፍ ቀብነ። አብዲን ኩንስ እዶ ቁልቁሉ ጎልጋ ዱበ ጅሩ ሰነ ኦል ሴነ፤ <verse eid="HEB 6:19"/><verse number="20" style="v" sid="HEB 6:20"/>እዶን ኩንስ ከን ዬሱስ እዶኬኘ ቡኤ ኑ ዱርሴ እት ኦል ሴኔዸ። እንስ አከ ስርነ መልከሴዴቅት ሉበ ኦል ኣና በረ በራ ተኤረ።<verse eid="HEB 6:20"/></para>
  <chapter eid="HEB 6"/>
  <chapter number="7" style="c" sid="HEB 7"/>
  <para style="s1">መልከሴዴቅ ሉብቸ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1"/>መልከሴዴቅ ሞቲ ሳሌሚቲፊ ሉበ ዋቀ ዋን ሁንዳ ኦሊ ቱሬ። እንስ ኡቱ አብረሃም ሞቶተ ሞአቴ ዴብኡ እት ዹፌ እሰ ኤብሴ፤ <verse eid="HEB 7:1"/><verse number="2" style="v" sid="HEB 7:2"/>አብረሃምስ ዋን ሁንዱማ ኩዸን ኬሳ ቶኮ እሳፍ ኬኔ። ጀልቀበት መቃንሳ፣ “ሞቲ ቀጄሉማ” ጄቹዸ፤ ኤርገሲሞ፣ “ሞቲ ሳሌም” ጄቹንስ፣ “ሞቲ ነጋ” ጄቹዸ። <verse eid="HEB 7:2"/><verse number="3" style="v" sid="HEB 7:3"/>እን አባ ዮካን ሃዸ ህንቀቡ፤ ህደ ዸሎታስ ህንቀቡ፤ ጀልቀበ ጉዮታ ዮካን ዹመ ጅሬኛስ ህንቀቡ፤ እን አኩመ እልመ ዋቃት ሉበ በረ በራ ተኤ ጅራተ።<verse eid="HEB 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4"/>ኤጋ አብረሃም ሀንገፍን አቦቲዩ ኤርገ ዋን ቦጅኤራ ኩዸን ኬሳ ቶኮ እሳፍ ኬኔ፣ መልከሴዴቅ ሀመም ጉዳ አከ ተኤ ሜ እላላ! <verse eid="HEB 7:4"/><verse number="5" style="v" sid="HEB 7:5"/>እልማን ሌዊ ወር ሉቦተ ተአን ዮ ኦቦሎትንሳኒ ሰኚ አብረሃም ተአንዩ ነሞተራ ጄቹንስ ኦቦሎቱመሳኒራ ኩዸን ኬሳ ቶኮ አከ ፉዸተን ሴር ንአጀጀ። <verse eid="HEB 7:5"/><verse number="6" style="v" sid="HEB 7:6"/>ነምች ሰኚሳኒራ ህንተእን ኩን ገሩ አብረሃም እሰ ዋዳን ገለሜፍ ሰነራ ኩዸን ኬሳ ቶኮ ፉዸቴ እሰ ኤብሴ። <verse eid="HEB 7:6"/><verse number="7" style="v" sid="HEB 7:7"/>እን ጥናን አከ እሰ ጉዳዻን ኤብፈሙ ሸኪ ህንቀቡ። <verse eid="HEB 7:7"/><verse number="8" style="v" sid="HEB 7:8"/>ከራ ቶኮን ኩዸን ኬሳ ቶኮ ነሞተ ዱአ ህንኦሌን ወልት ቀበመ፤ ከራ ካኒንሞ እሰ ጅራታ ተኡንሳ ዹጋ በአሜፍ ሰናን ወልት ቀበመ። <verse eid="HEB 7:8"/><verse number="9" style="v" sid="HEB 7:9"/>ሌዊን እን ኩዸን ኬሳ ቶኮ ወልት ቀቡ መታንሳዩ ኩዸን ኬሳ ሀርከ ቶኮ ከራ አብረሃሚቲን ባሴረ ጄቹን ንደንደአመ፤ <verse eid="HEB 7:9"/><verse number="10" style="v" sid="HEB 7:10"/>መልከሴዴቅ ዮሙ አብረሃምን ስመቴት ሌዊን ሙዺ አባ ኦፊሳ ኬሰ ቱሬቲ።<verse eid="HEB 7:10"/></para>
  <para style="s1">ዬሱስ አከ መልከሴዴቂት</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11"/>ኡቱ ስርን ሉቡማ ሌዊ ከን ህርእነ ህንቀብኔ ተኤ፣ ስላ ሉብን ብራ ከን አከ ስርነ ሉቡማ ኣሮንት ኡቱ ህንተእን ሉብን አከ ስርነ ሉቡማ መልከሴዴቅት ፍለተሜ ዹፉንሳ ማሊፍ በርባችሴሬ? ሴር ስርነ ሉቡማ ሌዊ ከነረት ሁንዴፈሜ ሰባፍ ኬነሜቲ። <verse eid="HEB 7:11"/><verse number="12" style="v" sid="HEB 7:12"/>ዮሙ ሉቡማን ጌደረሙ ሴርችስ አከሱመ ጌደረማቲ። <verse eid="HEB 7:12"/><verse number="13" style="v" sid="HEB 7:13"/>እን ወን ኩን ዋኤሳ ዱበተሜ ሱን ጎስትሳ ከን ብራት፤ ጎሰ ከነ ኬሳስ ነምን ቶኮዩ ተኩማ እዶ ኣርሳ ህንተጃጅሌ። <verse eid="HEB 7:13"/><verse number="14" style="v" sid="HEB 7:14"/>ጎፍታንኬኘ አከ ሰኚ ይሁዳራ ዸለቴ ቤከማዻቲ፤ ሙሴንስ ጎሰ ሰነ እላልችሴ ዋኤ ሉቡማ ሆማ ህንዱበትኔ። <verse eid="HEB 7:14"/><verse number="15" style="v" sid="HEB 7:15"/>ዮሙ ሉብን አከ መልከሴዴቅ ከን ብራ ከኡት፣ ወን ኑ ዱበትኔ ሱን እቱመ ጫሌ እፈ ተአ፤ <verse eid="HEB 7:15"/><verse number="16" style="v" sid="HEB 7:16"/>እንስ ኡቱ አጀጀ ፎኒቲን ህንተእን ሁምነ ጅሬኘ ህንበድኔቲን ሉበ ተኤ። <verse eid="HEB 7:16"/><verse number="17" style="v" sid="HEB 7:17"/>ዋኤሳስ፣</para>
  <para style="q1" vid="HEB 7:17">“አኩመ ስርነ መልከሴዴቅት፣</para>
  <para style="q2" vid="HEB 7:17">አት ሉበ በረ በራት”<note caller="+" style="f" category="dup"> <char style="fr" closed="false">7፥17 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 110:4">ፋር 110፥4</ref></char></char></note></para>
  <para style="m" vid="HEB 7:17">ጄዸሜ ዹጋ በአሜራፊቲ።<verse eid="HEB 7:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 7:18"/>አጀጅን ዱራ ሱን ዋን ደዸባፊ ከን ህንፈየድኔ ቱሬፍ ዲገሜረ። <verse eid="HEB 7:18"/><verse number="19" style="v" sid="HEB 7:19"/>ሰበቢ ሴር ዋኑመ ቶኮሌ ከን ሙዳ ህንቀብኔ ህንጎዽኒፍ አብዲን ጫሉ ከን ኑ እቲን ገረ ዋቃት ዽኣትኑ ቶኮ ዹፌረ።<verse eid="HEB 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 7:20"/>ኩንስ ከካ መሌ ህንታኔ! ወር ካንሞ ከካ ቶኮ መሌ ሉቦተ ተአን፤ <verse eid="HEB 7:20"/><verse number="21" style="v" sid="HEB 7:21"/>እን ገሩ ዬሮ ዋቅን፣</para>
  <para style="q1" vid="HEB 7:21">“ጎፍታን፣ ‘አት ሉበ በረ በራት’</para>
  <para style="q2" vid="HEB 7:21">ጄዼ ከከቴረ፤</para>
  <para style="q2" vid="HEB 7:21">እን ያደሳ ህንጌደሩ”<note caller="+" style="f" category="dup"> <char style="fr" closed="false">7፥21 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 110:4">ፋር 110፥4</ref></char></char></note></para>
  <para style="m" vid="HEB 7:21">እሳን ጄዼት ከካዻን ሉበ ተኤ። <verse eid="HEB 7:21"/><verse number="22" style="v" sid="HEB 7:22"/>ዬሱስ ሰበቢ ከካ ከናቲፍ ከኩ ጫሉፍ ወቢ ተኤረ።<verse eid="HEB 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23"/>ሉቦትን ዱሪ ሰበቢ ዱት አከ እሳን ተጃጅለ እት ህንፉፍኔፍ እሳን ዾዌፍ ባይኤ ቱረን፤ <verse eid="HEB 7:23"/><verse number="24" style="v" sid="HEB 7:24"/>ዬሱስ ገሩ ዋን በረ በራን ጅራቱፍ ሉቡማ ህንጌደረምኔ ቀበ። <verse eid="HEB 7:24"/><verse number="25" style="v" sid="HEB 7:25"/>ከናፍ እን ዬሮ ሁንዱማ ዋን እሳኒፍ ከዸቹፍ ጅራቱፍ ወረ ከራሳቲን ገረ ዋቃ ዹፈን ጉቱማን ጉቱት ፈይሱ ንደንደአ።<verse eid="HEB 7:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 7:26"/>ኤጋ ሉበ ኦል ኣና ቁልቁሉ፣ ከን ሙዳ ህንቀብኔ፣ ከን ጡሪ ህንቀብኔ፣ ከን ጩበሞተራ አደ ተኤ፣ ሰሚ ኦልትስ ከን ከበጀሜ አከሲ ቀባቹን ኑ በርባችሰ። <verse eid="HEB 7:26"/><verse number="27" style="v" sid="HEB 7:27"/>እን አከ ሉቦተ ኦል ኣንቶተ ካኒት ጉዩመ ጉያን ዱራን ዱርሴ ጩቡ ኦፊሳቲፍ፣ ኤርገሲሞ ጩቡ ነሞታቲፍ ኣርሳ ዽኤሱን እሰ ህንበርባችሱ። እን ዮሙ ኦፍ ኬኔ ሰነት አል ቶኮ ዬሮ ሁንዳፍ ጩቡ ነሞታቲፍ ኣርሳ ዽኤሴራቲ። <verse eid="HEB 7:27"/><verse number="28" style="v" sid="HEB 7:28"/>ሴርች ነሞተ ደዸቦ፣ ሉቦተ ኦል ኣንቶተ ጎዼ ሙዳቲ፤ ዱቢን ከካ ከን ሴረ ቦዴ ዹፌ ገሩ፣ እልመ ዋቃ እሰ በረ በራን ሙዳ ህንቀብኔ ሰነ ሙደ።<verse eid="HEB 7:28"/></para>
  <chapter eid="HEB 7"/>
  <chapter number="8" style="c" sid="HEB 8"/>
  <para style="s1">ሉበ ኦል ኣና ከኩ ሃራ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1"/>ዋን ኑ ዱበትኑ ኬሳ እጆን ከነ፦ ኑ ሉበ ኦል ኣና ሰሚረ ከራ ምርገ ቴሶ ሱራ ሰናቲን ታኤ አከሲ ቀብነ። <verse eid="HEB 8:1"/><verse number="2" style="v" sid="HEB 8:2"/>እንስ እዶ ቁልቁሉማፊ ዱንካነ እሰ ዹጋ ከን ኡቱ ነማን ህንተእን ጎፍታዻን ዻበሜ ኬሰ ተጃጅለ።<verse eid="HEB 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 8:3"/>ሉብን ኦል ኣናን ከምዩ ኬናፊ ኣርሳ ዽኤሱፍ ሙደመ፤ ከናፉ ሉብን ኩን ዋን ዽኤሱ ቶኮ ቀባቹ ቀበ። <verse eid="HEB 8:3"/><verse number="4" style="v" sid="HEB 8:4"/>ዋን ሉቦትን አከ ሴራት ኬና ዽኤሰን ዱራኑ ጅረኒፍ፣ እን ኡቱ ለፈረ ጅራቴ ስላ ሉበ ህንተኡ ቱሬ። <verse eid="HEB 8:4"/><verse number="5" style="v" sid="HEB 8:5"/>እሳንስ እዶ ቁልቁሉማ ከን ፈኬኛፊ ጋድዱ ወንቶተ ሰሚ ተጃጅሉ። ዋቅንስ ዮሙ ሙሴን ዱንካነ ቁልቁሉ ዻቡፍ ከኤት፣ “ዋን ሁንደ አኩመ ፈኬኘ ቱሉረት ስት አርግሲፈሜ ሰናት ሆጄቹኬ ምርከኔፈዹ!”<note caller="+" style="f"><char style="fr" closed="false">8፥5 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 25:40">በኡ 25፥40</ref></char></char></note> ጄዼ እሰ አኬከቺሱንሳ ከኑማፍ። <verse eid="HEB 8:5"/><verse number="6" style="v" sid="HEB 8:6"/>ገሩ አኩመ ከኩን እን ዬሱስ ግዱ ገሌሰ ተኤፍ ሱን ከኩ ሞፋ አከ መሌ ጫሉ ሰነ ተጃጅል እን ፉዸቴስ ተጃጅለሳኒረ ጉዳዸ፤ ከኩን ሃራን ዋዳ ጫሉረት ሁንዴፈሜቲ።<verse eid="HEB 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7"/>ኡቱ ከኩን ጀልቀባ ሱን ሙዳ ቀባቹ ባቴ ስላ ከኩን ለመፋን ህንበርባችሱ ቱሬ። <verse eid="HEB 8:7"/><verse number="8" style="v" sid="HEB 8:8"/>ዋቅን ገሩ ሰበ ሰነረት በሌሳ አርጌ አከነ ጄዸ፤</para>
  <para style="q1" vid="HEB 8:8">“ዬሮን አን እት</para>
  <para style="q2" vid="HEB 8:8">መነ እስራኤል ወጅን፣</para>
  <para style="q1" vid="HEB 8:8">መነ ይሁዳ ወጅንስ፣</para>
  <para style="q2" vid="HEB 8:8">ከኩ ሃራ ገሉ ንዹፈ ጄዸ ጎፍታን።<verse eid="HEB 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9"/>ከኩን ኩንስ ከኩ አን፣</para>
  <para style="q2" vid="HEB 8:9">ዬሮ ብየ ግብጢቲ እሳን ባሱፍ ጄዼ</para>
  <para style="q1" vid="HEB 8:9">ሀርከሳኒ ቀቤ ሰነ</para>
  <para style="q2" vid="HEB 8:9">አቦቲሳኒ ወጅን ገሌ ሰናን ቶኮ ምት፤</para>
  <para style="q1" vid="HEB 8:9">እሳን ከኩኮት ጀባተኒ ዋን ህንዻበትኒፍ፣</para>
  <para style="q2" vid="HEB 8:9">አን እሳንራ ገረገሌረ፣</para>
  <para style="q2" vid="HEB 8:9">ጄዸ ጎፍታን።<verse eid="HEB 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10"/>ከኩን አን ዬሮ ሰነ ቦዴ</para>
  <para style="q2" vid="HEB 8:10">መነ እስራኤል ወጅን ገሉ ከናዸ፣ ጄዸ ጎፍታን።</para>
  <para style="q1" vid="HEB 8:10">አን ሴረኮ ቀልቢሳኒ ኬሰ ነንካአ፤</para>
  <para style="q2" vid="HEB 8:10">ገራሳኒ ኬሰትስ ነንበሬሰ።</para>
  <para style="q1" vid="HEB 8:10">አን ዋቀሳኒ ነንተአ፤</para>
  <para style="q2" vid="HEB 8:10">እሳንስ ሰበኮ ንተኡ።<verse eid="HEB 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11"/>ሰበቢ ሁንድሳኒ፣</para>
  <para style="q2" vid="HEB 8:11">ጥና ሀመ ጉዳት ነ ቤከኒፍ፣</para>
  <para style="q1" vid="HEB 8:11">ስአች ነምን ከምዩ፣ ‘ጎፍታ ቤክ’ ጄዼ፣</para>
  <para style="q2" vid="HEB 8:11">ኦላሳ ዮካን ኦቦሌሰሳ ህንበርሲሱ።<verse eid="HEB 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12"/>አን ደበሳኒ ነንዺሳፍ፤</para>
  <para style="q2" vid="HEB 8:12">ጩቡሳኒስ ስአች ህንያደዹ።”<note caller="+" style="f"><char style="fr" closed="false">8፥12 </char><char style="ft" closed="false"><char style="xt"><ref loc="JER 31:31-34">ኤር 31፥31‑34</ref></char></char></note><verse eid="HEB 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 8:13"/>እንስ ከኩ ከናን “ሃራ” ጄዼ ከኩ ጀልቀባ ሰነ ሞፌሴረ፤ ወን ሞፈኤፊ ወን ዱሎሜ ደፌ በደ።<verse eid="HEB 8:13"/></para>
  <chapter eid="HEB 8"/>
  <chapter number="9" style="c" sid="HEB 9"/>
  <para style="s1">እዶ ቁልቁሉ እሰ ለፋ ኬሰት ዋቄፈቹ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1"/>ከኩን ጀልቀባ ሱንዩ ስርነ ዋቄፈትናቲፊ እዶ ቁልቁሉ እሰ ለፈራ ቀበ ቱሬ። <verse eid="HEB 9:1"/><verse number="2" style="v" sid="HEB 9:2"/>ዱንካን ቁልቁሉን ዻበሜ ቱሬ። ኩታን ዱንካነ ሰና ከን ጀልቀባ፣ “እዶ ቁልቁሉ” ጄዸመ ቱሬ፤ ኩታ ከነ ኬሰስ ባቱ እብሳቲፊ ምንጃለ አከሱመስ ቡዴነ ቁልቁሌፈሜቱ ቱሬ። <verse eid="HEB 9:2"/><verse number="3" style="v" sid="HEB 9:3"/>ጎልጋ ለመፋ ዱባንሞ ኩታ፣ “እዶ ሁንዱማ ጫላ ቁልቁሉ” ጄዸሙ ቶኮቱ ቱሬ። <verse eid="HEB 9:3"/><verse number="4" style="v" sid="HEB 9:4"/>አችስ እዶ ኣርሳ እጣና ከን ወርቄራ ሆጄተሜፊ ታቦተ ከኩ ከን ከራ ሁንዳን ወርቄ ድበሜቱ ቱሬ። ታቦተ ሰነ ኬሰስ ኦኮቴ ወርቄ ከን መና ባቱ፣ ኡሌ ኣሮን እን ለቴፊ ገበቴ ዸጋ ከን ከኩን ሱን እረት በሬፈሜቱ ካአሜ። <verse eid="HEB 9:4"/><verse number="5" style="v" sid="HEB 9:5"/>ታቦትቸ ጉባዻንስ ኪሩቤሊን ኡልፍና ቴሶ አራራረ ጎልቦበኒ ቱረን። አመ ገሩ ዋኤ ከና ገድ ፈጌኛን ዱበቹ ህንደንዴኙ።<verse eid="HEB 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6"/>ሉቦትን ዮሙ ወን ሁንድኑ ሃለ ከናን ቆጴፈሜት ተጃጅለ ኬኑፍ ጄዸኒ ዬሮ ሁንደ ዱንካነ ቁልቁሉ እሰ ጀልቀባ ሴኑ ቱረን። <verse eid="HEB 9:6"/><verse number="7" style="v" sid="HEB 9:7"/>ዱንካነ እሰ ለመፋ ገሩ ሉበ ኦል ኣና ቆፈቱ ወጋት ዬሮ ቶኮ ቆፈ ሴነ፤ እንስ ዺገ ጩቡ ኦፊሳቲፍ ዽኤሱፊ ዺገ ጩቡ ነሞትን ኡቱ ህንቤክን ሆጄተኒፍ ዽኤሱ ቀበቱ መሌ ህንሴኑ ቱሬ። <verse eid="HEB 9:7"/><verse number="8" style="v" sid="HEB 9:8"/>ሀፉር ቁልቁሉንስ ሀመ ዱንካን ጀልቀባ ሱን ዻበቴ ጅሩት አከ ከራን ገረ እዶ እዶ ሁንደ ጫላ ቁልቁሉ ተኤት ጌሱ ሱን አመሌ ህንሙልእፈምን ሃለ ከናን አርግሲሳ ቱሬ። <verse eid="HEB 9:8"/><verse number="9" style="v" sid="HEB 9:9"/>ኩንስ ፈኬኘ በረ አማት፤ እንስ አከ ኬናፊ ኣርሳን ዽኤፈሙ ሱን ቀልቢ ዋቄፈታ ቶኮ ቁልቁሌሱ ህንደንዴኜ ሙልእሰ። <verse eid="HEB 9:9"/><verse number="10" style="v" sid="HEB 9:10"/>እንስ ዋኤ ኛታቲፊ ዹጋቲ፣ ዋኤ ስርነ ዽቀትና ገራ ገራ ጄቹንስ ስርነ ፎኒ እሰ ሀመ ሴርች ሃሮምፈሙት ፋይዳ ኬና ቱሬ ቆፈ።<verse eid="HEB 9:10"/></para>
  <para style="s1">ዺገ ክርስቶስ</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11"/>ክርስቶስ ገሩ ዮሙ ዋን ጋሪ ዹፉፍ ጅሩፍ ሉበ ኦል ኣና ተኤ ዹፌት፣ ዱንካንቸ ጉዳ ሙዳ ህንቀብኔ፣ ከን ሀርከ ነማቲን ህንሆጄተምን ጄቹንስ ከን ኡመመ ከነራ ህንዹፍን ሰነ ኬሰ ደርቤ። <verse eid="HEB 9:11"/><verse number="12" style="v" sid="HEB 9:12"/>ዺገ ሬኦታቲፊ ዺገ ጀቦታቲን ህንሴኔ፤ ገሩ ፉሪ በረ በራ ኑ ፍዱዻን ዺጉመ ኦፊቲን ዬሮ ቶኮ በረ በራን ገረ እዶ እዶ ሁንደ ጫላ ቁልቁሉ ተኤ ሰናት ሴኔ። <verse eid="HEB 9:12"/><verse number="13" style="v" sid="HEB 9:13"/>ኤርገ ዺግን ሬኦታ፣ ዺግን ኮሮሚቲፊ ዳራን ጎሮምሳ ከን ወረ ጡራአንት ፈጫፈሙ አከ እሳን ፎኒን ቁልቁላአን ጎዼ፣ <verse eid="HEB 9:13"/><verse number="14" style="v" sid="HEB 9:14"/>ዮስ ዺግን ክርስቶስ እሰ ከራ ሀፉረ በረ በራቲን ኣርሳ ህርእነ ህንቀብኔ ተኤ ዋቃፍ ኦፍ ዽኤሴ ሰና አከ ኑ ዋቀ ጅራታ ተጃጅሉፍ ሀመም ጫላ ሆጂ ገረ ዱኣት ነመ ጌሱራ ቀልቢኬኘ ሃቁልቁሌሱሬ!<verse eid="HEB 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15"/>ሰበቢ ከናፍ አከ ወር ዋመመን ዻለ በረ በራ እሰ አብዲ ኬነሜ ሰነ አርገተኒፍ ክርስቶስ አራርሳ ግዱ ገሌሰ ከኩ ሃራት፤ እን ጩቡ እሳን ዬሮ ከኩ ጀልቀባ ጀለ ቱረንት ሆጄተንራ እሳን ብልሶምሱፍ ጄዼ ፉሪ ተኤ ዱኤራቲ።<verse eid="HEB 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 9:16"/>እዶ ዻምስ ዻላ ጅሩት ዱአ ነምቸ ዻመቴ ሰና ምርከኔሱን በርባችሳዸ፤ <verse eid="HEB 9:16"/><verse number="17" style="v" sid="HEB 9:17"/>ዻምስ ዻላ ዮሙ ነምን ዻመቴ ሱን ዱኡ ቆፈ ሆጂረ ኦለ መሌ ኡቱ እን ሉቡን ጅሩ ህንሆጄቱቲ። <verse eid="HEB 9:17"/><verse number="18" style="v" sid="HEB 9:18"/>ሰበቢን ከኩን ጀልቀባዩ ዺገ መሌ ሆጂረ ህንኦልኒፍስ ከኑመ። <verse eid="HEB 9:18"/><verse number="19" style="v" sid="HEB 9:19"/>ሙሴን ኤርገ አጀጀ ሴረ ሰና ቶኮ ቶኮን ሰበ ሰነ ሁንደት ህሜ ቦዴት፣ ዺገ ጀቦታቲፊ ዺገ ሬኦታ ብሻን ወጅን፣ ርፌንሰ ሆላ ብልዲማፊ ሂሶጲ ፉዼ ክታበ መረማፊ ሰበ ሁንደት ፈጫሴ። <verse eid="HEB 9:19"/><verse number="20" style="v" sid="HEB 9:20"/>እንስ፣ “ኩን ዺገ ከኩ ከን ዋቅን እስኒፍ አጀጄዸ”<note caller="+" style="f"><char style="fr" closed="false">9፥20 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 24:8">በኡ 24፥8</ref></char></char></note> ጄዼ። <verse eid="HEB 9:20"/><verse number="21" style="v" sid="HEB 9:21"/>ሃሉመ ወል ፈካቱንስ ዱንካንቸቲፊ ምአ ዱንካንቸ ኬሰት ስርነ ዋቄፈትናቲፍ እት ፈየደመን ሁንዱመት ዺገ ሰነ ፈጫሴ። <verse eid="HEB 9:21"/><verse number="22" style="v" sid="HEB 9:22"/>ዹጉማን አከ ሴራት ወንቶተ ሙራሰ መሌ ወን ሁንድኑ ዺጋን ቁልቁሌፈመ፤ ዺግን ዸንገላፈሙ መሌስ ዺፈምን ጩቡ ህንጅሩ።<verse eid="HEB 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23"/>ከናፉ ፈኬኘወን ዋን ሰሚራ ኣርሳወን ከኔኒን ቁልቁሌፈሙን በርባችሳ ቱሬ፤ ወን ሰሚራ መታንሳ ገሩ ኣርሳወን ዋን ከኔን ጫለኒን ቁልቁሌፈሙ እሳን በርባችሰ። <verse eid="HEB 9:23"/><verse number="24" style="v" sid="HEB 9:24"/>ክርስቶስ አመ እዶኬኘ ቡኤ ፉለ ዋቃ ዱረት አርገሙፍ ሰሚ ሴኔ መሌ እዶ ቁልቁሉ ከን ሀርከ ነማቲን እጃረሜ እሰ ፈኬኘ እዶ ቁልቁሉ ከን ዹጋ ተኤ ህንሴኔ። <verse eid="HEB 9:24"/><verse number="25" style="v" sid="HEB 9:25"/>ዮካን እን አኩመ ሉበ ኦል ኣና ወጉመ ወጋን ዺገ ከንሳ ህንተእን ቀበቴ እዶ እዶ ሁንደ ጫላ ቁልቁሉ ተኤ ሴኑ ሰናት ዬሮ ባይኤ ኦፍ ዽኤሱፍ ሰሚ ህንሴኔ። <verse eid="HEB 9:25"/><verse number="26" style="v" sid="HEB 9:26"/>ኡቱ አከስ ተኤ ስላ ክርስቶስ ኡመመ አዱኛቲ ጀልቀቤ ዬሮ ባይኤ ዽጰቹ ቀበ ቱሬ። አመ ገሩ እን ኦፊሳ ኣርሳ ጎዼ ጩቡ በሌሱፍ ዹመ በራት ዬሮ ቶኮ በረ በራን ሙልአቴረ። <verse eid="HEB 9:26"/><verse number="27" style="v" sid="HEB 9:27"/>አኩመ ዬሮ ቶኮ ዱኡን ኤርገሲሞ ሙርቲት ዽኣቹን ነመት ሙርቴፈሜ ሰነ <verse eid="HEB 9:27"/><verse number="28" style="v" sid="HEB 9:28"/>አከሱመሞ ክርስቶስ ጩቡ ነሞተ ባይኤ ባቹፍ ጄዼ ዬሮ ቶኮ ኣርሳ ተኤረ፤ ዬሮ ለመፋሞ ጩቡ ባቹፍ ኡቱ ህንተእን ወረ እሰ ኤገቻ ጅረኒፍ ፈይነ ፍዱፍ ንሙልአተ።<verse eid="HEB 9:28"/></para>
  <chapter eid="HEB 9"/>
  <chapter number="10" style="c" sid="HEB 10"/>
  <para style="s1">ክርስቶስ ኣርሳ ተኡሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1"/>ሴር ጋድዱ ዋን ጋሪ ዹፉፍ ጅሩ ቆፈ መሌ ብፈ ዹጋ ምት። ከናፉ ሴርች ኣርሳ ኡቱ ወልራ ህንጭትን ወጉመ ወጋን ዽኤፈሙ ሰናን ጎንኩማ ነሞተ ዋቄፈቹፍ ዽኣተን ሰነ ወረ ሙዳ ህንቀብኔ ጎቹ ህንደንደኡ። <verse eid="HEB 10:1"/><verse number="2" style="v" sid="HEB 10:2"/>ኡቱ እሳን ዋን ከነ ጎቹ ደንደአኒ ስላ ኣርሳን ዽኤፈሙንሳ ንሀፈ ቱሬ ምቲ? ዋቄፈቶትንስ ስአ ቶኮ ዬሮ ሁንዳፍ ንቁልቁሌፈሙ ቱረኒቲ፤ ኤርገሲ ሰበቢ ጩቡሳኒቲፍ የክ እሳንት ህንዸገአሙ ቱሬ። <verse eid="HEB 10:2"/><verse number="3" style="v" sid="HEB 10:3"/>ኣርሳወን ኩኔን ገሩ ወጉመ ወጋን ጩቡ ነመ ያደቺሱ። <verse eid="HEB 10:3"/><verse number="4" style="v" sid="HEB 10:4"/>ሰበቢንሳስ ዺግን ኮሮሚቲፊ ዺግን ሬኦታ ጎንኩማ ጩቡ ዸበምሲሱ ህንደንደኡቲ።<verse eid="HEB 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 10:5"/>ከናፉ ክርስቶስ ዮሙ ገረ አዱኛ ዹፌት አከነ ጄዼ፦</para>
  <para style="q1" vid="HEB 10:5">“አት ኣርሳፊ ኬና ህንፌኔ፤</para>
  <para style="q2" vid="HEB 10:5">ገሩ ዸግነ ናፍ ቆጴስቴ፤<verse eid="HEB 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6"/>አት ኣርሳ ጉበሙፊ</para>
  <para style="q2" vid="HEB 10:6">ኬና ሰበቢ ጩቡቲፍ ዽኤፈሙት</para>
  <para style="q2" vid="HEB 10:6">ህንገመድኔ።<verse eid="HEB 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7"/>ዬሮ ሰነ አን፣ ‘አን ኩኖት፤</para>
  <para style="q2" vid="HEB 10:7">ዋኤንኮ ክታበ መረማ ኬሰት በሬፈሜረ፤</para>
  <para style="q2" vid="HEB 10:7">ያ ዋቀኮ፣ አን ፌዺኬ ራወቹፍ ዹፌረ’ ነንጄዼ።”<note caller="+" style="f"><char style="fr" closed="false">10፥7 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 40:6-8">ፋር 40፥6‑8</ref></char></char></note><verse eid="HEB 10:7"/></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 10:8"/>እሳን አከ ሴራት ዽኤፈመንዩ እን ጀልቀበት፣ “አት ቀልመወኒፊ ኣርሳወን፣ ኣርሳወን ጉበመኒፊ ኣርሳወን ጩቡፍ ዽኤፈመን ህንፌኔ ዮካን እት ህንገመድኔ” ጄዼ። <verse eid="HEB 10:8"/><verse number="9" style="v" sid="HEB 10:9"/>ኤርገሲስ እን፣ “አን ኩኖ ፌዺኬ ራወቹፍ ዹፌረ” ጄዼ። እንስ እሰ ለመፋ ዻቡፍ ጄዼ እሰ ጀልቀባ ዸበምሲሴ። <verse eid="HEB 10:9"/><verse number="10" style="v" sid="HEB 10:10"/>ፌዺ ሰናንስ ኑ ኣርሳ ዸግነ ዬሱስ ክርስቶስ እሰ ስአ ቶኮ ዬሮ ሁንዳፍ ዽኤፈሜን ቁልቁሌፈምኔረ።<verse eid="HEB 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11"/>ሉብን ሁንድኑ ጉዩመ ጉያን ዻበቴ ተጃጅለሳ ራወተ፤ ኣርሳ ጎንኩማ ጩቡ ዸበምሲሱ ህንደንዴኜ ሰነስ ዬሮ ሁንደ ዽኤሰ። <verse eid="HEB 10:11"/><verse number="12" style="v" sid="HEB 10:12"/>ሉብን ኩን ገሩ ኤርገ ኣርሳ ቶክቸ በረ በራን ጩቡዻፍ ዽኤሴ ቦዴ ገረ ምርገ ዋቃ ታኤ። <verse eid="HEB 10:12"/><verse number="13" style="v" sid="HEB 10:13"/>ዬሮ ሰና ጀልቀቤስ ሀመ ዲኖትንሳ ኤጄተ ሚለሳ ታስፈመንት ንኤገተ፤ <verse eid="HEB 10:13"/><verse number="14" style="v" sid="HEB 10:14"/>እን ኣርሳ ቶክቸ ሰናን ወረ ቁልቁሌፈሙት ጅረን ከኔን በረ በራን ሙዳ ህንቀብኔ ጎዼራቲ።<verse eid="HEB 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 10:15"/>ሀፉር ቁልቁሉንስ ዋኤ ከና ዹጋ ኑ በአ። እንስ ጀልቀበት አከነ ጄዸ፦<verse eid="HEB 10:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16"/>“ከኩን አን ዬሮ ሰነ ቦዴ እሳን ወጅን ገሉ ከናዸ፣</para>
  <para style="q2" vid="HEB 10:16">ጄዸ ጎፍታን።</para>
  <para style="q1" vid="HEB 10:16">አን ሴረኮ ቀልቢሳኒ ኬሰ ነንካአ፤</para>
  <para style="q2" vid="HEB 10:16">ገራሳኒ ኬሰትስ ነንበሬሰ።”<note caller="+" style="f"><char style="fr" closed="false">10፥16 </char><char style="ft" closed="false"><char style="xt"><ref loc="JER 31:33">ኤር 31፥33</ref></char></char></note><verse eid="HEB 10:16"/></para>
  <para style="m">
    <verse number="17" style="v" sid="HEB 10:17"/>አመስ፣</para>
  <para style="q1" vid="HEB 10:17">“አን ጩቡፊ የከሳኒ</para>
  <para style="q2" vid="HEB 10:17">ስአች ህንያደዹ”<note caller="+" style="f"><char style="fr" closed="false">10፥17 </char><char style="ft" closed="false"><char style="xt"><ref loc="JER 31:34">ኤር 31፥34</ref></char></char></note></para>
  <para style="m" vid="HEB 10:17">ጄዸ። <verse eid="HEB 10:17"/><verse number="18" style="v" sid="HEB 10:18"/>እዶ እሳን ኩኔን እት ዺፈመ አርገተንት ስአች ሰበቢ ጩቡቲፍ ኣርሳ ዽኤሱ ህንበርባችሱ።<verse eid="HEB 10:18"/></para>
  <para style="s1">አመንቲዻን ጭመኒ ዻበቹ</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19"/>ከናፉ ያ ኦቦሎተ፣ ኑ ዺገ ዬሱሲን ገረ እዶ እዶ ሁንደ ጫላ ቁልቁሉ ተኤት ገሉፍ እጀ ጀብነ ዋን ቀብኑፍ <verse eid="HEB 10:19"/><verse number="20" style="v" sid="HEB 10:20"/>ከራ ሃራፊ ጅራታ ጎልጋ ኬሳን ጄቹንስ ከራ ፎንሳቲን ኑ በነሜ ሰናን <verse eid="HEB 10:20"/><verse number="21" style="v" sid="HEB 10:21"/>ዋን ሉበ ጉዳ መነ ዋቃረት ቀብኑፍ፣ <verse eid="HEB 10:21"/><verse number="22" style="v" sid="HEB 10:22"/>ኮታ አከ ቀልቢንኬኘ ያደ የከ ቀባቹራ ቁልቁሌፈሙፍ ገራኬኘት ኑ ፈጫፈሜ፣ ዸግነኬኘስ ብሻን ቁልቁሉን ዽቀትኔ ገራ ቁልቁሉ አመንቲ ምርከናኣ ጉቱ ቀቡን ዋቀት ዽኣትና። <verse eid="HEB 10:22"/><verse number="23" style="v" sid="HEB 10:23"/>እን ዋዳ ገሌ ሱን ዋን አመነማ ተኤፍ ኮታ ኑ ኡቱ ህንራፈምን አብዲ ዹጋ ባኑ ሰነ ጀቤስኔ ቀበትና። <verse eid="HEB 10:23"/><verse number="24" style="v" sid="HEB 10:24"/>ኮታ ጃለላፊ ሆጂ ጋሪፍ ወል ከካሱፍ እት ያድና። <verse eid="HEB 10:24"/><verse number="25" style="v" sid="HEB 10:25"/>አከ ነሞትን ቶኮ ቶኮ ወልት ቀበሙ ዺሰን ሰነ ኮታ ኑ ወልት ቀበሙ ህንዺፍኑ፤ ቆደ ከና አከ ጉያን ሱን ዽኣቴ ዋን አርግተኒፍ እቱመ ጫልችፍኔ ወል ሃጀጀቤስኑ።<verse eid="HEB 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26"/>ኑ ኤርገ ቤኩምሰ ዹጋ አርገትኔ ቦዴ ዮ ቤካ እቱመ ፉፍኔ ጩቡ ሆጄትኔ፣ ስአች ኣርሳን ጩቡፍ ዽኤፈሙ ህንጅራቱ፤ <verse eid="HEB 10:26"/><verse number="27" style="v" sid="HEB 10:27"/>ገሩ ሙርቲፊ እብደ ሀማ ዲኖተ ዋቃ በርበዴሱ ሶዳን ኤገቹ ቆፈቱ ጅራተ። <verse eid="HEB 10:27"/><verse number="28" style="v" sid="HEB 10:28"/>ነምን ሴረ ሙሴ ቱፈቴ ከምዩ ዹገ ባቶተ ለማን ዮካን ሰዲን ገረ ላፍነ መሌ አጄፈመ። <verse eid="HEB 10:28"/><verse number="29" style="v" sid="HEB 10:29"/>ነመ እልመ ዋቃረ ኤጄቴ፣ ነመ ዺገ ከኩ ከን እቲን ቁልቁሌፈሜ ሰነ አከ ዋን ቁልቁሉ ህንተእኒት ሄዴፊ ነመ ሀፉረ አያና አረብሴ ቶኮ አደቢ ሀመም ጫላ ጉዳቱ እሳፍ መለ ሴቱ? <verse eid="HEB 10:29"/><verse number="30" style="v" sid="HEB 10:30"/>ኑ እሰ፣ “ሃሎ ባሱን ከንኮት፤ አን ገቲ ነንዴብሰ”<note caller="+" style="f"><char style="fr" closed="false">10፥30 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 32:35">ኬዴ 32፥35</ref></char></char></note> ጄዼ ሰነ ቤክናቲ፤ አከሱመስ፣ “ጎፍታን ሰበሳት ንሙረ”<note caller="+" style="f"><char style="fr" closed="false">10፥30 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 32:36">ኬዴ 32፥36</ref>፤ <ref loc="PSA 135:14">ፋር 135፥14</ref></char></char></note> ጄዼ። <verse eid="HEB 10:30"/><verse number="31" style="v" sid="HEB 10:31"/>ሀርከ ዋቀ ጅራታት ኩፉን ሶዳችሳዸ።<verse eid="HEB 10:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32"/>በረ ዱራ ዬሮ ኤርገ እፍን እስኒ እፌ ቦዴ ወልኣንሶ ዽጵና ጉዳ ኦብስተኒ ኬሰ ዻበተን ሰነ ያደዻ። <verse eid="HEB 10:32"/><verse number="33" style="v" sid="HEB 10:33"/>እስን ዬሮ ቶኮ ቶኮ ፉለ ነሞታ ዱረት አረብሶፊ አርአተማፍ ሳጥለምተኒ ቱርተን፤ ዬሮ ካንሞ ነሞተ ረክን አከሲ እረ ገኤ ወጅን ህርማቻ ቱርተን። <verse eid="HEB 10:33"/><verse number="34" style="v" sid="HEB 10:34"/>እስን መታንኬሰን አከ ቀቤኘ ወዩ ከን ህንደበሬ ቀብደን ዋን ቤክተኒፍ ወረ ህዸመን ወጅን ዽጰተኒርቱ፤ ዮሙ ቀቤኝኬሰን ሳመሙስ ገመቹዻን ፉዸተኒርቱ። <verse eid="HEB 10:34"/><verse number="35" style="v" sid="HEB 10:35"/>ከናፉ እጀ ጀብነኬሰን እሰ ገቲ ጉዳ ቀቡ ሰነ ህንገትና።<verse eid="HEB 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="HEB 10:36"/>ዮሙ ፌዺ ዋቃ ራወተንትስ አከ ዋን እን ዋዳ ገሌ ሰነ አርገተኒፍ ኦብሱ እስን በርባችሳቲ።<verse eid="HEB 10:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="HEB 10:37"/>“ዬሮ ጥኖ ኬሰት፣</para>
  <para style="q2" vid="HEB 10:37">እን ዹፉፍ ጅሩ ንዹፈ፤</para>
  <para style="q2" vid="HEB 10:37">ህንቱሩስ።”<note caller="+" style="f"><char style="fr" closed="false">10፥37 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 26:20">እሳ 26፥20</ref>፤ <ref loc="HAB 2:3">አንባ 2፥3</ref></char></char></note><verse eid="HEB 10:37"/></para>
  <para style="m">
    <verse number="38" style="v" sid="HEB 10:38"/>አከሱመስ፣</para>
  <para style="q1" vid="HEB 10:38">“ቀጄላንኮ ገሩ አመንቲዻን ጅራተ።</para>
  <para style="q2" vid="HEB 10:38">ከን ዱበት ሀርክፈቱሞ</para>
  <para style="q2" vid="HEB 10:38">አን እት ህንገመዱ።”<note caller="+" style="f"><char style="fr" closed="false">10፥38 </char><char style="ft" closed="false"><char style="xt"><ref loc="HEB 2:3">2፥3</ref>፣<ref loc="HEB 2:4">4</ref></char></char></note><verse eid="HEB 10:38"/></para>
  <para style="m">
    <verse number="39" style="v" sid="HEB 10:39"/>ኑ ገሩ ወረ አመነኒ ሉቡ ኦፊ ኦልፈተን መሌ ወረ ገረ በዲሳት ሀርክፈተን ምት።<verse eid="HEB 10:39"/></para>
  <chapter eid="HEB 10"/>
  <chapter number="11" style="c" sid="HEB 11"/>
  <para style="s1">ሆጂ አመንቲን ሆጄቱ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1"/>አመንቲን ዋን አብደትኑ ቶኮ ዹጉማን ንተአ ጄኔ ፉዸቹዸ፤ ዋን እጃን ህንአርግኔ ቶኮሞ ቀበተማዸ ጄኔ ሄዱዸ። <verse eid="HEB 11:1"/><verse number="2" style="v" sid="HEB 11:2"/>ጃርሶሊፍስ ከናን ዹጋ በአሜቲ።<verse eid="HEB 11:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 11:3"/>አዱኛወን አከ አጀጀ ዋቃቲን ኡመመን፣ ወን ሙልአቱስ አከ ዋን ሙልአቱራ ህንሆጄተምን ኑ አመንቲዻን ሁበትነ።<verse eid="HEB 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4"/>አቤል አመንቲዻን ኣርሳ እሰ ቃይን ዽኤሴ ጫሉ ዋቃፍ ዽኤሴ። እን ዮሙ ዋቅን ዋኤ ኬናሳ ዹጋ በአሜፍት ነመ ቀጄላ ተኡንሳ አመንቲዻን ዹጋ በአሜፍ። አቤል ዱኡዩ ሀመ አማት አመንቲዻን ዱበቻ ጅረ።<verse eid="HEB 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 11:5"/>ሄኖክ አከ ዱአ ህንአርግኔፍ አመንቲዻን ፉዸተሜ፤ ዋን ዋቅን እሰ ፉዸቴፍ እን ህንአርገምኔ።<note caller="+" style="f"><char style="fr" closed="false">11፥5 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 5:24">ኡመ 5፥24</ref></char></char></note> እን ኡቱ ህንፉዸተምን ዱረ አከ ነመ ዋቀ ገመቺሴት ዹጋ በአሜፊ ቱሬቲ። <verse eid="HEB 11:5"/><verse number="6" style="v" sid="HEB 11:6"/>አመንቲዻን መሌ ዋቀ ገመቺሱን ህንደንደአሙ፤ ሰበቢንሳስ ነምን ገረሳ ዹፉ ከምዩ አከ እን ጅሩፊ አከ እን ወረ እሰ በርባደኒፍ ገቲ ኬኑ አመኑ ቀበ።<verse eid="HEB 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 11:7"/>ኖህ ዋኤ ዋን አመሌ እጃን ህንአርገምኒ ዋቅን እሰ አኬከቺፍናን ሶዳቴ ወረ መነሳ ጅራተን ኦልፈቹፍ ጄዼ አመንቲን ዶኒ ቶልቼ። አመንቲሳቲንስ አዱኛት ሙሬ፤ ዻልቱ ቀጄሉማ አመንቲን አርገሙስ ተኤ።<verse eid="HEB 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8"/>አብረሃም ገረ እዶ ዻሉፍ ጅሩ አከ ዸቁ ዮሙ ዋመሜት፣ አመንቲዻን አጀጀሜ፤ ኤሰ አከ ዸቁዩ ኡቱ ህንቤክን ከኤ ዴሜ። <verse eid="HEB 11:8"/><verse number="9" style="v" sid="HEB 11:9"/>እንስ አከ ኬሱማ ብየ ኦርማ ጅሩት ብየ እሳፍ ዋዳ ገለሜ ሰነ ኬሰ አመንቲዻን ቁበቴ፤ አኩመ ወረ እሰ ወጅን ዋዳዹመ ሰነ ዻለን፣ አኩመ ይስሃቂፊ ያቆብ ዱንካነ ኬሰ ጅራቴ። <verse eid="HEB 11:9"/><verse number="10" style="v" sid="HEB 11:10"/>እን መጋላ ሁንዴ ቀብዱ ከን ዋቅን እጃሬፊ ቶልቼ ኤገቻ ቱሬቲ። <verse eid="HEB 11:10"/><verse number="11" style="v" sid="HEB 11:11"/>ሳራን ዮ ኡሙሪ ደኡምሳ ደበርቴ፣ ዸብዱ ቱርቴሌ እሼን ዋን ዋቀ ዋዳ እሼፍ ገሌ ሰነ አመነማ ጎቴ ፉዸቴፍ፣ አመንቲዻን ሙጫ ደኡ ደንዴሴ። <verse eid="HEB 11:11"/><verse number="12" style="v" sid="HEB 11:12"/>ከናፍ ነምቸ አከ ዋን ዱኤት እላለሙ ቶክቸ ከነራ ሰኚን አከ ኡርጂ ሰሚ ባይአቱፊ አከ ጭረቸ ቀርቀረ ገላና ከን ህንለካአምኔ ዸለቴ።<verse eid="HEB 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13"/>ነሞትን ኩኔን ሁንድኑ ኡቱ ዋን ዋዳ ገለሜፍ ሰነ ህንአርገን አመንቲሳኒሞ ኡቱ ህንዺስን ዱአን። ዋዳ ሰነስ ፈጎት እላለኒ ስመተን። እሳንስ ለፈረት አከ ኬሱሞታፊ ጎዳንቶተ ቱረን ቤከኒሩ። <verse eid="HEB 11:13"/><verse number="14" style="v" sid="HEB 11:14"/>ወር ዋን አከሲ ጄዸን ኩኔን አከ ብየ ኦፊሳኒ ኤገቻ ጅረን ሙልእሱ። <verse eid="HEB 11:14"/><verse number="15" style="v" sid="HEB 11:15"/>እሳን ኡቱ ዋኤ ብየ ኬሳ በአን ሰና ያዳ ቱረኒ ስላ፣ ብየሳኒት ዴብኡፍ ጨራ ንአርገቱ ቱረን። <verse eid="HEB 11:15"/><verse number="16" style="v" sid="HEB 11:16"/>ቆደ ከና እሳን ብየ ወዩ ቶኮ ጄቹንስ ብየ ሰሚራ ሰነ ሀዋ ቱረን። ከናፉ ዋቀዮ ዋቀሳኒ ጄዸሜ ዋመሙት ህንቃነኡ፤ እን መጋላ እሳኒፍ ቆጴሴራቲ።<verse eid="HEB 11:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17"/>አብረሃም ዬሮ ዋቅን እሰ ቆሬት አመንቲዻን ይስሃቅን ኣርሳዻፍ ዽኤሴ። እሱመ ዋዳ አርገቴ ሰነቱ እልመሳ ቶክቸ ኣርሳ ጎዼ ዽኤሱፍ ቆጳኤ፤ <verse eid="HEB 11:17"/><verse number="18" style="v" sid="HEB 11:18"/>እንስ እሱመ ዋቅን፣ “ሰኚንኬ ይስሃቂን ሲፍ ዋመመ”<note caller="+" style="f"><char style="fr" closed="false">11፥18 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 21:12">ኡመ 21፥12</ref></char></char></note> ጄዼን ሰነ። <verse eid="HEB 11:18"/><verse number="19" style="v" sid="HEB 11:19"/>አብረሃም አከ ዋቅን ወረ ዱአን ኬሳ ነመ ካሱ ደንደኡሌ ሁበቴ ቱሬ፤ ኩንስ ከራ ቶኮን እን እልመሳ ይስሃቅን ወረ ዱአን ኬሳ ዴብሴ አርገቴ ጄቹዸ።<verse eid="HEB 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 11:20"/>ይስሃቅ አመንቲዻን ዋን ዹፉፍ ጅሩረት ያቆቢፊ ኤሳዉን ኤብሴ።<verse eid="HEB 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 11:21"/>ያቆብ ዬሮ ዱኤት አመንቲዻን እልማን ዮሴፍ ቶኮ ቶኮን ኤብሴ፤ መታ ኡሌሳት እርከቴስ ሰገዴ።<verse eid="HEB 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 11:22"/>ዮሴፍስ ዬሮ ዱኤት አመንቲዻን ዋኤ ግብጥ ኬሳ በኡ እጆሌ እስራኤል ዱበቴ፤ ዋኤ ለፌሳስ አጀጀ ኬኔ።<verse eid="HEB 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23"/>ዬሮ ሙሴን ዸለቴት አባፊ ሃትሳ ሙጫ ሚዸጋ ተኡሳ አርገኒ ኡቱ ለብሲ ሞትቻ ህንሶዳትን አመንቲዻን ጅአ ሰዲ እሰ ዾክሰን።<verse eid="HEB 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24"/>ሙሴን ዬሮ ጉደቴት እልመ እንተለ ፈረኦን ጄዸሜ ዋመሙ አመንቲዻን ድዴ። <verse eid="HEB 11:24"/><verse number="25" style="v" sid="HEB 11:25"/>እን ገመቹ ጩቡቲን ዬሮ ገባባፍ ገመዱረ ሰበ ዋቃ ወጅን ዽጰቹ ፍለቴ። <verse eid="HEB 11:25"/><verse number="26" style="v" sid="HEB 11:26"/>እን ዋን በዻሰሳ ኦፍ ዱረት እላሌፍ፣ ክርስቶሲፍ ጄዼ ሰልጰቹ አከ ቀቤኘ ግብጥ ጫላ ገቲ ጉዳ ቀቡት ፉዸቴ። <verse eid="HEB 11:26"/><verse number="27" style="v" sid="HEB 11:27"/>እንስ ኡቱ ዼከምሰ ሞትቻ ህንሶዳትን አመንቲዻን ግብጥ ኬሳ በኤ፤ እሰ ህንሙልአትኔ ሰነ አከ ዋን አርጌት ኦብሴ ኤገቴ። <verse eid="HEB 11:27"/><verse number="28" style="v" sid="HEB 11:28"/>አከ ኤርገማን ሀንገፈ አጄሱ ሱን ሀንገፎተ ሰበ እስራኤል ህንቱቅኔፍስ አመንቲዻን አከ ፋሲካን አያኔፈሙ፣ ዺግንስ አከ ፈጫፈሙ ጎዼ።<verse eid="HEB 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="HEB 11:29"/>ሰብን እስራኤል አኩመ ነመ ለፈ ጎጋረ ዴሙት አመንቲን ገላነ ዲማ ጬኤ፤ ወር ግብጥ ገሩ ዮሙ አኩመ ሰነት ጬኡ ያለንት ንልቅምፈመን።<verse eid="HEB 11:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 11:30"/>ደላን ዬርኮ ኤርገ ጉያ ቶርበ መርፈሜ ቦዴ አመንቲዻን ጅጌ።<verse eid="HEB 11:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="HEB 11:31"/>ሰጋገልቱን ረሃብ ጄዸምቱ በሳስቶተ ስመቹ እሼቲን አመንቲዻን ሀፍቴ መሌ ወረ ህንአመንን ወጅን ህንአጄፈምኔ።<verse eid="HEB 11:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32"/>አን ኤጋ ከነ ጫላ ማልን ጄዸሬ? ዋኤ ጌዴዎን፣ ዋኤ ባርቅ፣ ዋኤ ሳምሶን፣ ዋኤ ይፍታ፣ ዋኤ ዳዊት፣ ዋኤ ሳሙኤሊፊ ዋኤ ራጆታ ኦዴሱፍ አን ዬሮ ህንቀቡ፤ <verse eid="HEB 11:32"/><verse number="33" style="v" sid="HEB 11:33"/>እሳን አመንቲዻን ሞቱሞተ ሞአተን፤ ሙርቲ ቀጄላ ኬነን፤ ዋን ዋዳ ገለሜ አርገተን፤ አፋን ሌንጮታ ጩፈን፤ <verse eid="HEB 11:33"/><verse number="34" style="v" sid="HEB 11:34"/>አመንቲዻን እብደ ጀባ ዻምሰን፤ ቀረ ጎራዴ ጀላ በአን፤ ደዸቢንሳኒ ጀብነት ጌደረሜ፤ ወራነ ኬሰት ሁምነ አርገተኒ ሎልቶተ ዲና አርአን። <verse eid="HEB 11:34"/><verse number="35" style="v" sid="HEB 11:35"/>ዱበርቶትንስ ነሞትንሳኒ ከኔን ዱአን ካፈመኒፊ ዴብሰኒ ፉዸተን። ወር ካንስ ዱኣ ከኡ ወዩ አርገቹፍ ጄዸኒ ገድ ዺፈሙ ድደኒ ዽጰተን። <verse eid="HEB 11:35"/><verse number="36" style="v" sid="HEB 11:36"/>ወረ ካንት ንቆሰሜ፤ ንገረፈመንስ፤ አከሱመስ ፎንጫን ህዸመኒ መነ ህዻት ደርበተመን። <verse eid="HEB 11:36"/><verse number="37" style="v" sid="HEB 11:37"/>ዸጋዻንስ ንቱመመን፤ እዶ ለመት በቀቅፈመን፤ ጎራዴዻን አጄፈመን። ዴጉዻን፣ አርአተሙፊ ዽጰቹዻን ጎጋ ሆሎታቲፊ ሬኦታ ኡፈተኒ ጆረን፤ <verse eid="HEB 11:37"/><verse number="38" style="v" sid="HEB 11:38"/>አዱኛን እሳኒፍ ህንመሌቲ። እሳንስ ገሞጂፊ ጋረረ፣ ሆልቃፊ ቦለ ኬሰ ጆራ ቱረን።<verse eid="HEB 11:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39"/>ወር ኩኔን ሁንድኑ ዮ ሰበቢ አመንቲሳኒቲፍ ጀጀመንዩ እሳን ኬሳ ነምን ቶኮዩ ዋን ዋዳ ገለሜ ሰነ ህንአርገትኔ። <verse eid="HEB 11:39"/><verse number="40" style="v" sid="HEB 11:40"/>ዋቅን አከ እሳን ኑ ቆፈ ወጅን ወረ ሙዳ ህንቀብኔ ተአኒፍ ዱራን ዱርሴ ዋን ኑፍ ወዩ አርጌረ።<verse eid="HEB 11:40"/></para>
  <chapter eid="HEB 11"/>
  <chapter number="12" style="c" sid="HEB 12"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1"/>ከናፉ ኑ ዋን ዹገ ባቶተ አከ ዱሜሰ ጉዳ አከናቲን መርፈምኔፍ ኮታ በኣ ሁንደ፣ ጩቡ ጠጤ ኑ ቀበቴስ ኦፍራ ባፍኔ ገትና፤ ዶርጎሚ ፉለኬኘ ዱረ ጅሩስ ኦብሳን ጀባትኔ ፊግና፤ <verse eid="HEB 12:1"/><verse number="2" style="v" sid="HEB 12:2"/>ኮታ ዬሱስ እሰ ጀልቀባፊ ፊጣን ባሳ አመንቲኬኛ ተኤ ሰነረ እጀኬኘ ካአትና። እንስ ገመቹ ፉለሳ ዱረ ጅሩፍ ጄዼ ቃኒ ፈኖ ቱፈቹን ፈኖ ኦብሴ ምርገ ቴሶ ዋቃ ታኤ። <verse eid="HEB 12:2"/><verse number="3" style="v" sid="HEB 12:3"/>እስን አከ ደዸብደኒ አብዲ ህንኩተትኔፍ እሰ ሞርሚ ጩበሞተ እሰረ ገኤ አከሲ ኦብሴ ሰነ ያደት ቀበዻ።<verse eid="HEB 12:3"/></para>
  <para style="s1">ዋቅን እልማንሳ ንአደበ</para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 12:4"/>እስን አመዩ ወልኣንሶ ጩቡ ወጅን ጎተን ኬሰት ሀመ ዺገ ዸንገላሱት ጀባተኒ ህንሞርምኔ። <verse eid="HEB 12:4"/><verse number="5" style="v" sid="HEB 12:5"/>ዱቢ ጀጀብና ከን አኩመ እልማኒት እስንት ዱበቱ ሰነ እራንፈተኒርቱ፤ እንስ አከነ ጄዸ፦</para>
  <para style="q1" vid="HEB 12:5">“ያ እልመኮ፣ አደቢ ጎፍታ ህንቱፈትን፤</para>
  <para style="q2" vid="HEB 12:5">ዮሙ እን ስ እፈቱስ አብዲ ህንኩተትን፤<verse eid="HEB 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6"/>ጎፍታን ወረ ጃለቱ ንአደባቲ፤</para>
  <para style="q2" vid="HEB 12:6">እን ነመ አከ እልማት እላሉ ከምዩ ንአደበ።”<note caller="+" style="f"><char style="fr" closed="false">12፥6 </char><char style="ft" closed="false"><char style="xt"><ref loc="PRO 3:11">ፈኬ 3፥11</ref>፣<ref loc="PRO 3:12">12</ref></char></char></note><verse eid="HEB 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 12:7"/>ረክነ አኩመ አደቢት ኦብሳ፤ ዋቅን አከ እልማንሳት እስን አደባቲ። እልም አባንሳ ህንአደብኔ እልመ አከሚት? <verse eid="HEB 12:7"/><verse number="8" style="v" sid="HEB 12:8"/>እስን ዮ አደቢ እጆሌን ሁንድኑ እቲን አደበመን ኬሰት ህንህርማትኔ እስን ድቃሎተ መሌ እጆሌ ዹጋ ምት። <verse eid="HEB 12:8"/><verse number="9" style="v" sid="HEB 12:9"/>ከነ መሌስ ኑ ሁንድኑ አቦቲ ፎኒ ከኔን ኑ አደበን ቀብነ ቱሬ፤ እሳን ከበጅነስ ቱሬ። ዮስ አባ ሀፉሮታቲፍሞ ሀመም ጫላ አጀጀምኔ ጅራቹ ቀብነሬ! <verse eid="HEB 12:9"/><verse number="10" style="v" sid="HEB 12:10"/>አቦቲንኬኘ አኩመ እሳንት ጋሪ ፈካቴት ዬሮ ገባባፍ ኑ አደባ ቱረን፤ ዋቅን ገሩ አከ ኑ ቁልቁሉማሳ ኬሰት ህርማትኑፍ ፋይዳኬኛፍ ጄዼ ኑ አደበ። <verse eid="HEB 12:10"/><verse number="11" style="v" sid="HEB 12:11"/>አደቢን ሁንድኑ ዬሮ ሰነ ዋን ነመ ገድሲሱ መሌ ዋን ነመ ገመቺሱ ህንፈካቱ። ኤርገሲ ገሩ ወረ አደቢ ሰናን ሌንጅፈመኒፍ እጀ ቀጄሉማፊ ነጋ ኬነ።<verse eid="HEB 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12"/>ከናፉ እሬ ላፌፊ ጅልበ ደዸቤ ጀቤሳ። <verse eid="HEB 12:12"/><verse number="13" style="v" sid="HEB 12:13"/>ናፍት አከ ፈዩፍ መሌ አከ ከራራ ህንጀልአትኔፍ፣ “ሚለኬሰኒፍ ዳንዲ ቀጄላ ባፈዻ።”<note caller="+" style="f"><char style="fr" closed="false">12፥13 </char><char style="ft" closed="false"><char style="xt"><ref loc="PRO 4:26">ፈኬ 4፥26</ref></char></char></note><verse eid="HEB 12:13"/></para>
  <para style="s1">አኬከቺሰ</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14"/>ነመ ሁንደ ወጅን ነጋዻን ጅራቹፊ ቁልቁሉ ተኡፍ ተታፈዻ፤ ቁልቁሉማን መሌ ነምን ከምዩ ጎፍታ አርጉ ህንደንደኡቲ። <verse eid="HEB 12:14"/><verse number="15" style="v" sid="HEB 12:15"/>ነመ ከምትዩ አያን ዋቃ አከ ህንህርአትኔ ኦፍ ኤገዻ፤ ህድ ሀዻኣን ብቅሌ ረክነ አከ ህንኡምኔፊ ነሞተ ባይኤስ ህንጡሬስኔፍ ኦፍ ኤገዻ። <verse eid="HEB 12:15"/><verse number="16" style="v" sid="HEB 12:16"/>ነምን ከምዩ አከ ኤሳዉ እሰ ምርገ ሀንገፉማሳ ኛተ ቶክቲት ጉርጉረቴ ሰና ሰጋገልቱ ዮካን ነመ ዋቀት ህንቡሌ ህንታኔፍ ኦፍ ኤገዻ። <verse eid="HEB 12:16"/><verse number="17" style="v" sid="HEB 12:17"/>እን ኤርገሲ ዬሮ ኤበ ሰነ ዻሉ በርባዴት አከ ድደሜ እስን ንቤክቱ። እን ዮ ኤበ ሰነ እምማኒን በርባዴሌ ጌደረመ ቶኮሌ ፍዱ ህንደንዴኜ።<verse eid="HEB 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18"/>እስን ገረ ቱሉ ቱቀሙ ደንደኡፊ እብድ እራ ቦበኡ፣ ገረ ዱከና፣ ገረ ድምምሳፊ ቡቤ ህንጌኜ፤ <verse eid="HEB 12:18"/><verse number="19" style="v" sid="HEB 12:19"/>ገረ ሰገሌ መለከታቲፊ ገረ ሰገሌ ዱቢ ዱበቱ ህንጌኜ፤ ወር እሰ ዸገአንስ አከ ዱቢን ብራ ደበለሜ እሳንት ህንዱበተምኔ ከዸተን። <verse eid="HEB 12:19"/><verse number="20" style="v" sid="HEB 12:20"/>እሳን ዋን፣ “ብኔንስዩ ዮ ቱሉ ሰነ ቱቄ ዸጋዻን ቱመሜ ሃአጄፈሙ”<note caller="+" style="f"><char style="fr" closed="false">12፥20 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 19:12">በኡ 19፥12</ref>፣<ref loc="EXO 19:13">13</ref></char></char></note> ጄዸሜ አጀጀሜ ሰነ ኦብሱ ህንደንዴኜቲ። <verse eid="HEB 12:20"/><verse number="21" style="v" sid="HEB 12:21"/>ወንት አችት ሙልአቴስ ዋን ሶዳችሳ ተኤፍ ሙሴን፣ “አን ሶዳዻን ሆለቻን ጅረ”<note caller="+" style="f"><char style="fr" closed="false">12፥21 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 9:19">ኬዴ 9፥19</ref></char></char></note> ጄዼ።<verse eid="HEB 12:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22"/>እስን ገሩ ገረ ቱሉ ጥዮን፣ ገረ መጋላ ዋቀ ጅራታ ጄቹንስ ዬሩሳሌም እሼ ሰሚ ኬሳ ዹፍተኒርቱ። ገረ ኤርገሞተ ኩማተመ ገመቹን ወልት ቀበመኒ ዹፍተኒርቱ፤ <verse eid="HEB 12:22"/><verse number="23" style="v" sid="HEB 12:23"/>ገረ ወልዳ ክርስታና ሀንገፎተ መቃንሳኒ ሰሚ ኬሰት በሬፈሜ ዹፍተኒርቱ። ገረ ዋቀ አባ ሙርቲ ዋን ሁንዳ፣ ገረ ሀፉሮተ ነሞተ ቀጄልቶተ ወረ ሙዳ ህንቀብኔ ታስፈመኒ፣ <verse eid="HEB 12:23"/><verse number="24" style="v" sid="HEB 12:24"/>ገረ ዬሱስ አራርሳ ግዱ ገሌሰ ከኩ ሃራ፣ ገረ ዺገ ፈጫፈሜ ከን ዱቢ ዺግን አቤል ዱበቱ ሰነ ጫላ ዱበቱ ዹፍተኒርቱ።<verse eid="HEB 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25"/>እስንስ አከ እሰ ዱበቻ ጅሩ ሰነ ህንድድኔፍ ኦፍ ኤገዻ። ኤርገ እሳን ዬሮ እሰ ለፈረት እሳን አኬከቺሴ ሰነ ድደንት ጀላ ህንበእን፣ ኑሞ ዮ እሰ ሰሚራ ኑ አኬከቺሱ ሰነራ ገረገሌ አከምት ጀላ በኡ ደንዴኘሬ? <verse eid="HEB 12:25"/><verse number="26" style="v" sid="HEB 12:26"/>ዬሮ ሰነት ሰገሌንሳ ለፈ ሶቾሴ፤ አመ ገሩ እን፣ “አን አመስ ዬሮ ቶኮ ለፈ ቆፈ ኡቱ ህንተእን ሰሚወንስ ነንሶቾሰ”<note caller="+" style="f"><char style="fr" closed="false">12፥26 </char><char style="ft" closed="false"><char style="xt"><ref loc="HAG 2:6">ሃጌ 2፥6</ref></char></char></note> ጄዼ ዋዳ ገሌረ። <verse eid="HEB 12:26"/><verse number="27" style="v" sid="HEB 12:27"/>ዱቢን፣ “አመስ ዬሮ ቶኮ” ጄዹ ኩን አከ ወን ህንሶቾፈምኔ ሀፌ ጅራቱፍ፣ ወን ሶቾፈሙ ጄቹንስ ወን ኡመሜ በዱሳ አርግሲሰ።<verse eid="HEB 12:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 12:28"/>ከናፉ ኑ ዋን ሞቱማ ህንሶቾኔ አርገትኑፍ ኮታ ሃገለቴፈትኑ! ከበጃፊ ሶዳዻንስ ከራ ፉዸተማ ተኤን ዋቀ ሃዋቄፈትኑ፤ <verse eid="HEB 12:28"/><verse number="29" style="v" sid="HEB 12:29"/>ዋቅንኬኘ እብደ ጉቤ በሌሱዻቲ።<note caller="+" style="f"><char style="fr" closed="false">12፥29 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 4:24">ኬዴ 4፥24</ref></char></char></note><verse eid="HEB 12:29"/></para>
  <chapter eid="HEB 12"/>
  <chapter number="13" style="c" sid="HEB 13"/>
  <para style="s1">ጎርሰ ጡሙራ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1"/>አከ ኦቦሎታት ወል ጃለቹ እት ፉፋ። <verse eid="HEB 13:1"/><verse number="2" style="v" sid="HEB 13:2"/>ኬሱሞተ ስመቹ ህንእራንፈትና፤ ነሞትን ቶኮ ቶኮ አከሲን ኡቱ ህንቤክን ኤርገሞተ ዋቃ ስመተኒሩቲ። <verse eid="HEB 13:2"/><verse number="3" style="v" sid="HEB 13:3"/>ወረ መነ ህዻ ጅረን አከ ዋን እሳን ወጅን ህዸምተኒት፣ ወረ ዽጵነ ኬሰ ጅረንስ አከ ዋን ኦፊ ዽጰተኒት ያደዻ።<verse eid="HEB 13:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 13:4"/>ፉዻፊ ሄሩምን ነመ ሁንደ ብረት ሃከበጀሙ፤ ስሬን ፉዻፊ ሄሩማስ ቁልቁሉ ሃተኡ፤ ዋቅን ኤጅቶታፊ ሰጋገልቶተት ንሙራቲ። <verse eid="HEB 13:4"/><verse number="5" style="v" sid="HEB 13:5"/>ጅሬኘኬሰን ጃለለ ማለቃራ ጀቤሳ ኤገዻ፤ ወን ቀብደን እስን ሃገኡ፤ ዋቅን፣</para>
  <para style="q1" vid="HEB 13:5">“አን ጎንኩማ ስ ህንዺሱ፤</para>
  <para style="q2" vid="HEB 13:5">ጎንኩማስ ስ ህንገቱ”<note caller="+" style="f"><char style="fr" closed="false">13፥5 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 31:6">ኬዴ 31፥6</ref></char></char></note></para>
  <para style="m" vid="HEB 13:5">ጄዼራቲ። <verse eid="HEB 13:5"/><verse number="6" style="v" sid="HEB 13:6"/>ከናፍ ኑ እጀ ጀብናን፣</para>
  <para style="q1" vid="HEB 13:6">“ጎፍታን ገርጋራኮት፤ አን ህንሶዳዹ።</para>
  <para style="q2" vid="HEB 13:6">ነምን ማል ነ ጎቹ ደንደአ?”<note caller="+" style="f"><char style="fr" closed="false">13፥6 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 118:6">ፋር 118፥6</ref>፣<ref loc="PSA 118:7">7</ref></char></char></note> ጄነ።<verse eid="HEB 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7"/>ሆገንቶተኬሰን ወረ ዱቢ ዋቃ እስንት ህመኒ ቱረን ሰነ ያደዻ። ዋን ጅሬኘሳኒራ አርገሜስ እላላ፤ አመንቲሳኒ ዱካ ቡኣ። <verse eid="HEB 13:7"/><verse number="8" style="v" sid="HEB 13:8"/>ዬሱስ ክርስቶስ ከሌሰ፣ ሀርአ፣ በረ በራንስ ሰኑመ።<verse eid="HEB 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 13:9"/>በርሲሰ ጎሰ ሁንዱማ ከን ኬሱማ ተኤን ህንፉዸተምና። ገራንኬኘስ ስርነ ዋኤ ኛታቲን ኡቱ ህንተእን አያናን ጀብነ አርገቹ ቀበ፤ ስርን ዋኤ ኛታ ወረ እሰ ከበጀንዩ ህንፈየዱ። <verse eid="HEB 13:9"/><verse number="10" style="v" sid="HEB 13:10"/>ኑ እዶ ኣርሳ ከን ወር ዱንካነ ቁልቁሉ ኬሰ ተጃጅለንራ ኛቹፍ ምርገ ህንቀብኔ ቶኮ ቀብነ።<verse eid="HEB 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 13:11"/>ሉብን ኦል ኣናን ዺገ ሆሪ ቀበቴ ሰበቢ ጩቡቲፍ ኣርሳ ዽኤሱፍ ጄዼ እዶ እዶ ሁንደ ጫላ ቁልቁሉ ተኤ ሰነ ሴነ፤ ፎን ሆሪ ሰናስ ቁበተ ኬሳ ገድ ባፈሜ ጉበመ። <verse eid="HEB 13:11"/><verse number="12" style="v" sid="HEB 13:12"/>ከናፉ ዬሱስስ ዺገ ኦፊቲን ሰበ ቁልቁሌሱፍ ጄዼ ከረ መጋለቲቲን አለት ዽጰቴ። <verse eid="HEB 13:12"/><verse number="13" style="v" sid="HEB 13:13"/>ኤጋ ኮታ ኑስ ሰልጵነ እን ባቴ ሰነ ባትኔ እዶ ቁበታቲን አለ ገረሳ ሃዸቅኑ። <verse eid="HEB 13:13"/><verse number="14" style="v" sid="HEB 13:14"/>ኑ መጋላ ዹፉፍ ጅርቱ ኤገትነ መሌ መጋላ በረ በራ አሲ ህንቀብኑቲ።<verse eid="HEB 13:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 13:15"/>ከናፉ ኮታ ኡቱ ገርገር ህንኩትን ከራ ዬሱሲቲን ኣርሳ ገለታ ዋቃፍ ሃዽኤስኑ፤ ኣርሳን ኩንስ ዱቢ መቃሳ ቤክስሱፍ አፋንኬኘ ኬሳ በኡዸ። <verse eid="HEB 13:15"/><verse number="16" style="v" sid="HEB 13:16"/>ዋን ጋሪ ጎቹፊ ዋን ቀብደንስ ነማን ገኡ ህንዺስና፤ ዋቅን ኣርሳ አከሲት ገመዳቲ።<verse eid="HEB 13:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17"/>ሆገንቶተኬሰኒፍ አጀጀማ፤ እሳኒፍስ ቡላ። እሳን ዋን እት ጋፈተምቶተ ሉቡኬሰኒ ተአኒፍ እስን ኤጉ፤ ከነስ ኡቱ ገዳን ህንተእን አከ እሳን ገመቹን ሆጄተኒፍ እሳኒፍ አጀጀማ፤ ዮ እሳን ገዳን ሆጄተን እስን ህንፈየዱቲ።<verse eid="HEB 13:17"/></para>
  <para style="s1">አከ ከዸትና ጎዸኒፍ ጋፈቹ</para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18"/>እስን ዋቀ ኑ ከዸዻ። ኑ አከ ከራ ሁንዱማን ቀልቢ ቁልቁሉ ቀብኑፊ አከ ጅሬኘ ከበጀማ ጅራቹ ሀውኑ ምርከኔፈትኔረ። <verse eid="HEB 13:18"/><verse number="19" style="v" sid="HEB 13:19"/>ኬሱመቱ አከ አን ደፌ ዴብኤ ገረኬሰን ዹፉፍ አከ ዋቀ ከዸተን እስን ጎርሰ።<verse eid="HEB 13:19"/></para>
  <para style="s1">ኤባፊ ዻምሰ ነጋ ጡሙራ</para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20"/>ዋቅን ነጋ እን ከራ ዺገ ከኩ በረ በራቲን ጎፍታኬኘ ዬሱስ፣ ትክሴ ሆሎታ ጉድቸ ሰነ ወረ ዱአን ኬሳ ካሴ ሱን፣ <verse eid="HEB 13:20"/><verse number="21" style="v" sid="HEB 13:21"/>አከ እስን ፌዺሳ ራወተኒፍ ዋን ጋሪ ሁንዳን እስን ሃቆጴሱ፤ እንስ ከራ ዬሱስ ክርስቶሲቲን ዋን እሰ ገመቺሱ ኑ ኬሰት ሃሆጄቱ፤ ኡልፍን በረ በራ ሀመ በረ በራት ዬሱስ ክርስቶሲፍ ሃተኡ። አሜን።<verse eid="HEB 13:21"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22"/>ያ ኦቦሎተነነ፣ አን ዋን ጠለያ ገባባ እስኒ በሬሴፍ፣ አከ እስን ኤርጋ ጎርሳ ከነ ኦብሳን ፉዸተን እስን ከዸዸ።<verse eid="HEB 13:22"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="23" style="v" sid="HEB 13:23"/>አከ ኦቦሌስኬኘ ጢሞቴዎስ መነ ህዻቲ ሂከሜ አከ ቤክተን ነንበርባደ። ዮ እን ደፌ አስ ዹፌ አን እስን አርጉፍ እሰ ወጅን ነንዹፈ።<verse eid="HEB 13:23"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24"/>ሆገንቶተኬሰን ሁንዳፊ ቁልቁሎተ ሁንደት ነጋ ናፍ ህማ።</para>
  <para style="p" vid="HEB 13:24">ወር ኢጣልያራ ዹፈንስ ነጋ እስኒ ዻሙ።<verse eid="HEB 13:24"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25"/>አያን እስን ሁንደ ወጅን ሃተኡ።<verse eid="HEB 13:25"/></para>
  <chapter eid="HEB 13"/>
</usx>
