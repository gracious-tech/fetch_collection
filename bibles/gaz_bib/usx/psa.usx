<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PSA" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">ፋርፈትና</para>
  <para style="toc1">ክታቦተ ፋርፈትና</para>
  <para style="toc2">ፋርፈትና</para>
  <para style="toc3">ፋር</para>
  <para style="mt2">ክታቦተ</para>
  <para style="mt1">ፋርፈትና</para>
  <chapter number="1" style="c" sid="PSA 1"/>
  <para style="ms">ክታበ ቶኮፋ</para>
  <para style="mr">
    <ref loc="PSA 1-41">ፋርፈትና 1–41</ref></para>
  <para style="cl">ፋርፈትና 1</para>
  <para style="ms1">ከራ ለማን</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 1:1"/>ነምን ጎርሰ ሀሞታቲን ህንዴዴብኔ፣</para>
  <para style="q2" vid="PSA 1:1">ዮካን ከራ ጩበሞታረ ህንዻበትኔ፣</para>
  <para style="q2" vid="PSA 1:1">ዮካን በርጩመ ቆስቶታረ ህንቴኜ፣ ኤብፈማዸ።<verse eid="PSA 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 1:2"/>ገሩ እን ሴረ <char style="nd">ዋቀዮት</char> ገመደ፤</para>
  <para style="q2" vid="PSA 1:2">ሴረሳስ ሀልከኒ ጉያ እረ ዴዴብኤ እት ያደ።<verse eid="PSA 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 1:3"/>እን አኩመ ሙከ ቀርቀረ ብሻን ያኡ ዻበሜ</para>
  <para style="q2" vid="PSA 1:3">ዬሮሳት እጀሳ ኬኑ፣</para>
  <para style="q1" vid="PSA 1:3">ከን ባልሳስ ህንጮለግኔት፤</para>
  <para style="q2" vid="PSA 1:3">ወን እን ሆጄቱ ሁንድኑስ ንቶላፍ።<verse eid="PSA 1:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 1:4"/>ሀሞን ገሩ አከነ ምት፤</para>
  <para style="q2" vid="PSA 1:4">እሳን አከ ሀበቂ ቅሌንስ ፉዸቴ በሌሱት።<verse eid="PSA 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 1:5"/>ከናፉ ሀሞን ሙርቲ ዱረ፣</para>
  <para style="q2" vid="PSA 1:5">ዮካን ጩበሞትን ወልዳ ቀጄልቶታ ኬሰ ህንዻበተን።<verse eid="PSA 1:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 1:6"/>
    <char style="nd">ዋቀዮ</char> ከራ ቀጄልቶታ ንቤካቲ፤</para>
  <para style="q2" vid="PSA 1:6">ከራን ሀሞታ ገሩ ገረ በዲት ጌሰ።<verse eid="PSA 1:6"/></para>
  <chapter eid="PSA 1"/>
  <chapter number="2" style="c" sid="PSA 2"/>
  <para style="cl">ፋርፈትና 2</para>
  <para style="ms1">ሞትቸ ዋቅን ድቤ ሞስሴ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 2:1"/>ነሞትን ማሊፍ አከኑማን መለቱ?</para>
  <para style="q2" vid="PSA 2:1">ሰቦትንስ ማሊፍ ዋን አከኑማን መርአቱ?<verse eid="PSA 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 2:2"/>ሞቶትን ለፋ ከአኒ፣</para>
  <para style="q2" vid="PSA 2:2">ቡልችቶትንስ <char style="nd">ዋቀዮፊ</char> መሲሂሳቲን ሞርሙፍ</para>
  <para style="q2" vid="PSA 2:2">ወልት ቀበመን፤<verse eid="PSA 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 2:3"/>እሳንስ፣ “ኮታ ፎንጫሳኒ ኦፍራ ኩኩትና፤</para>
  <para style="q2" vid="PSA 2:3">ህዻሳኒስ ኦፍራ ሂክኔ ገትና” ጄዹ።<verse eid="PSA 2:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 2:4"/>እን ሰሚ ኬሰ፣ ቴሶረ ታኤ ጅሩ ንኮልፈ፤</para>
  <para style="q2" vid="PSA 2:4">ጎፍታንስ እሳንት ቆሰ።<verse eid="PSA 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 2:5"/>እንስ ኣሪሳቲን እሳን እፈተ፤</para>
  <para style="q2" vid="PSA 2:5">ዼከምሰሳቲንስ እሳን ናስሰ፤<verse eid="PSA 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 2:6"/>እንስ፣ “አን ቱሉኮ ቁልቁሉረ፣ ጥዮንረ፣</para>
  <para style="q2" vid="PSA 2:6">ሞቲኮ ቴስፈዼረ” ጄዸ።<verse eid="PSA 2:6"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="7" style="v" sid="PSA 2:7"/>አን ሴረ <char style="nd">ዋቀዮ</char> ነንለብሰ፦</para>
  <para style="b" vid="PSA 2:7"/>
  <para style="q1" vid="PSA 2:7">እንስ አከነ አናን ጄዼ፤ “አት እልመኮት፤</para>
  <para style="q2" vid="PSA 2:7">አን ሀርአ ስ ዸልቼረ።<verse eid="PSA 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 2:8"/>ነ ከዸዹ፤</para>
  <para style="q2" vid="PSA 2:8">አን ሰቦተ ዻለኬ፣</para>
  <para style="q2" vid="PSA 2:8">ሀንዳረ ለፋስ ቀቤኘኬ ጎዼ ሲፈን ኬነ።<verse eid="PSA 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 2:9"/>አት ኡሌ ስቢላቲን እሳን ጨብስተ፤</para>
  <para style="q2" vid="PSA 2:9">አከ ቆዳ ሱጴትስ እሳን ሁሬስተ።”<verse eid="PSA 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 2:10"/>ከናፉ ያ ሞቶተ፣ ቀልቤፈዻ፤</para>
  <para style="q2" vid="PSA 2:10">ቡልችቶትን ለፋስ ኦፍ ኤገዻ።<verse eid="PSA 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 2:11"/>ሶዳዻን <char style="nd">ዋቀዮን</char> ተጃጅላ፤</para>
  <para style="q2" vid="PSA 2:11">ሆለቻስ ገመዳ።<verse eid="PSA 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 2:12"/>አከ እን ህንኣሬፍ፣</para>
  <para style="q2" vid="PSA 2:12">እስንስ አከ ከራረት ህንበድኔፍ እልመሳ ዹንገዻ፤</para>
  <para style="q1" vid="PSA 2:12">ዼከምስሳ ደፌ ቦበኣቲ።</para>
  <para style="q2" vid="PSA 2:12">ወር እሰት ኮሉ ገለን ሁንድ ኤብፈሞዸ።<verse eid="PSA 2:12"/></para>
  <chapter eid="PSA 2"/>
  <chapter number="3" style="c" sid="PSA 3"/>
  <para style="cl">ፋርፈትና 3</para>
  <para style="ms1">ከዸትና ነመ አርአተማ ጅሩ</para>
  <para style="d">ፋርፈትና ዳዊት ዬሮ እልመሳ አቤሳሎም ጀላ በቀቴት ፋርፈቴ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 3:1"/>ያ <char style="nd">ዋቀዮ</char>፣ ዲኖትንኮ አከም ባይአቱ!</para>
  <para style="q2" vid="PSA 3:1">ነሞትን ባይኤን ነት ከአኒሩ!<verse eid="PSA 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 3:2"/>ነሞትን ባይኤን፣ “ዋቅን እሰ ህንበራሩ” ጄዸኒ</para>
  <para style="q2" vid="PSA 3:2">ዋኤኮ ዱበቱ።<verse eid="PSA 3:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 3:3"/>ያ <char style="nd">ዋቀዮ</char>፣ አት ገሩ ናኖኮት ጋቸነኮት፤</para>
  <para style="q2" vid="PSA 3:3">ኡልፍነኮትስ፤ መታኮስ ከን ኦል ቀብዱ ሱመ።<verse eid="PSA 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 3:4"/>አን ጉድሴ <char style="nd">ዋቀዮት</char> ነንእየዸ፤</para>
  <para style="q2" vid="PSA 3:4">እንስ ቱሉሳ ቁልቁሉራ ዴቢ ና ኬነ።<verse eid="PSA 3:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 3:5"/>አን ነንጪሰ፤ ነንረፈስ፤</para>
  <para style="q2" vid="PSA 3:5">ዋን <char style="nd">ዋቀዮ</char> ኦል ነ ቀቡፍ ነንደመቀ።<verse eid="PSA 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 3:6"/>ሰበ ኩማተመ ቅጠ ሁንዳን</para>
  <para style="q2" vid="PSA 3:6">ከኤ ነ መርሴ አን ህንሶዳዹ።<verse eid="PSA 3:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 3:7"/>ያ <char style="nd">ዋቀዮ</char> ከእ!</para>
  <para style="q2" vid="PSA 3:7">ያ ዋቀኮ ነ በራር!</para>
  <para style="q1" vid="PSA 3:7">መንጋጋ ዲኖተኮቲ ሁንዱማ ሩኩት፤</para>
  <para style="q2" vid="PSA 3:7">እልካን ሀሞታሌ ጨጨብስ።<verse eid="PSA 3:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 3:8"/>ፈይን ከን <char style="nd">ዋቀዮት</char>።</para>
  <para style="q2" vid="PSA 3:8">ኤብኬ ሰበኬረ ሃጅራቱ።<verse eid="PSA 3:8"/></para>
  <chapter eid="PSA 3"/>
  <chapter number="4" style="c" sid="PSA 4"/>
  <para style="cl">ፋርፈትና 4</para>
  <para style="ms1">ከዸትና ገልገላ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዳዊት ከን በገናዻን ፋርፈተሙ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 4:1"/>ያ ዋቀ ቀጄሉመኮቲ፣</para>
  <para style="q2" vid="PSA 4:1">ዮሙ አን ስ ዋመዹት ዴቢ ና ኬን።</para>
  <para style="q1" vid="PSA 4:1">አት ዬሮ ረክነኮት ነ ቦቆቺስ፤</para>
  <para style="q2" vid="PSA 4:1">አራረኬ ና ቡስ፤ ከዻኮስ ዸገእ።<verse eid="PSA 4:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 4:2"/>ያ እልማን ነሞታ፣ እስን ሀመ ዮሚት ኡልፍነኮ ገረ ሰልጵናት ዴብፍቱ?</para>
  <para style="q2" vid="PSA 4:2">እስን ሀመ ዮሚት ዋን ፋይዳ ህንቀብኔ ጃለተኒ ሶበ በርባዱ?<verse eid="PSA 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 4:3"/>እስን አከ <char style="nd">ዋቀዮ</char> ወረ እሳፍ ቡለን ኦፊሳቲፍ አዳን ባፈቴ ቤካ፤</para>
  <para style="q2" vid="PSA 4:3">
    <char style="nd">ዋቀዮ</char> ዮሙ አን እሰ ዋመዹት ነ ዸገአ።<verse eid="PSA 4:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 4:4"/>ዬሮ ኣርተንት ጩቡ ህንሆጄትና፤</para>
  <para style="q2" vid="PSA 4:4">ዮሙ ስሬኬሰንረ ጅርተንት፣</para>
  <para style="q2" vid="PSA 4:4">ገራኬሰን ኬሰት ያዳ፤ ጨልእሳስ።<verse eid="PSA 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 4:5"/>ኣርሳ ቀጄሉማ ዽኤሳ፤</para>
  <para style="q2" vid="PSA 4:5">
    <char style="nd">ዋቀዮንስ</char> አመነዻ።<verse eid="PSA 4:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 4:6"/>ነሞትን፣ “ኤኙቱ ዋን ጋሪ ኑ አርግሲሰ?” ጄዸን ባይኤዸ፤</para>
  <para style="q2" vid="PSA 4:6">ያ <char style="nd">ዋቀዮ</char>፣ እፍን ፉለኬቲ ኑረት ሃእፉ።<verse eid="PSA 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 4:7"/>ገመቹ እሳን ዬሮ ምዻኒፊ ዳዺን ወይኒሳኒ ባይአቱት አርገተን ጫላ፣</para>
  <para style="q2" vid="PSA 4:7">አት ገራኮ ገመቹ ጉዳዻን ጉቴርተ።<verse eid="PSA 4:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 4:8"/>አን ነጋዻን ነንጪሰ፤ ነንረፈስ፤</para>
  <para style="q2" vid="PSA 4:8">ያ <char style="nd">ዋቀዮ</char> ስ ቆፈቱ፣</para>
  <para style="q2" vid="PSA 4:8">ሶዳ መሌ ነ ጅራችሳቲ።<verse eid="PSA 4:8"/></para>
  <chapter eid="PSA 4"/>
  <chapter number="5" style="c" sid="PSA 5"/>
  <para style="cl">ፋርፈትና 5</para>
  <para style="ms1">ከዸትና ገነማ</para>
  <para style="d">ፋርፈትና ዳዊቲ ከን ኡሉሌዻን ፋርፈተሙ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 5:1"/>ያ <char style="nd">ዋቀዮ</char>፣ ጉረኬ ዱቢኮት ቀብ፤</para>
  <para style="q2" vid="PSA 5:1">ኣዱኮሌ ና ሁበዹ።<verse eid="PSA 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 5:2"/>ያ ሞቲኮፊ ዋቀኮ፣</para>
  <para style="q2" vid="PSA 5:2">እየ አን ገርጋርሳፍ እየዹ ዸጌፈዹ፤</para>
  <para style="q2" vid="PSA 5:2">አን ስን ከዸዻቲ።<verse eid="PSA 5:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 5:3"/>ያ <char style="nd">ዋቀዮ</char>፣ ገነማን ሰገሌኮ ንዸጌሰ፤</para>
  <para style="q2" vid="PSA 5:3">አንስ ገነማን ከዸተኮ ፉለኬ ዱረት ነንዽኤሰ፤</para>
  <para style="q2" vid="PSA 5:3">አብዲዻንስ ነንኤገዸ።<verse eid="PSA 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 5:4"/>አት ዋቀ ሀምነት ገመዱ ምት፤</para>
  <para style="q2" vid="PSA 5:4">ሀማንስ ስ ወጅን ህንጅራቱ።<verse eid="PSA 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 5:5"/>ኦፍ ቱልቶትን ፉለኬ ዱረ ዻበቹ ህንደንደአን።</para>
  <para style="q2" vid="PSA 5:5">አትስ ወረ ጀልእነ ሆጄተን ሁንደ ንጅብተ፤<verse eid="PSA 5:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="PSA 5:6"/>አት ወረ ሶበ ዱበተን ንበሌስተ።</para>
  <para style="q1" vid="PSA 5:6">
    <char style="nd">ዋቀዮ</char> ወረ ዺገ ዼቦተኒፊ</para>
  <para style="q2" vid="PSA 5:6">ወረ ነመ ጎዎምሰን ንጥሬፈተ።<verse eid="PSA 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 5:7"/>አን ገሩ አራረኬ ባይኤ ሰናን መነኬት ኦል ነንገለ፤</para>
  <para style="q2" vid="PSA 5:7">ስ ሶዳቹዻንስ ገድ ጄዼ</para>
  <para style="q2" vid="PSA 5:7">ገረ መነ ቁልቁሉማኬ ቁልቁሉ ሰናት ገረገሌ ነንሰገደ።<verse eid="PSA 5:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 5:8"/>ያ <char style="nd">ዋቀዮ</char>፣ ሰበቢ ዲኖተኮቲፍ ጄዺቲ</para>
  <para style="q2" vid="PSA 5:8">ቀጄሉማኬቲን ነ ዱረ ቡእ፤</para>
  <para style="q2" vid="PSA 5:8">ከራኬስ ፉለኮ ዱረት ና ቀጄልች።<verse eid="PSA 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 5:9"/>ዱቢን አፋንሳኒቲ በኡ ቶኮዩ ህንአመነሙ፤</para>
  <para style="q2" vid="PSA 5:9">ገራንሳኒ በዲሳን ጉተሜረ።</para>
  <para style="q1" vid="PSA 5:9">ላጋንሳኒ አዋለ በነማዸ፤</para>
  <para style="q2" vid="PSA 5:9">አረበሳኒቲን ንሶቡ።<verse eid="PSA 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 5:10"/>ያ ዋቀዮ፣ የክቶተ ተኡሳኒ እሳንት ቤክስስ!</para>
  <para style="q2" vid="PSA 5:10">ደበሳኒቲንስ ሃኩፈን።</para>
  <para style="q1" vid="PSA 5:10">ባይእነ ጩቡሳኒቲን እሳን በሌስ፤</para>
  <para style="q2" vid="PSA 5:10">እሳን ስት ፍንጭለኒሩቲ።<verse eid="PSA 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 5:11"/>ወር ኮሉ ስት ገለን ሁንድኑ ገሩ ሃገመደን፤</para>
  <para style="q2" vid="PSA 5:11">በረ በራንስ ገመቹዻን ሃፋርፈተን።</para>
  <para style="q1" vid="PSA 5:11">አከ ወር መቃኬ ጃለተን ስት ገመደኒፍ</para>
  <para style="q2" vid="PSA 5:11">አት ኤጉምሰኬ እሳንረ ድሪርስ።<verse eid="PSA 5:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 5:12"/>ያ <char style="nd">ዋቀዮ</char>፣ አት ቀጄልቶተ ንኤብፍታቲ፤</para>
  <para style="q2" vid="PSA 5:12">አከ ጋቸናትስ ሱራኬቲን እሳን መርስተ።<verse eid="PSA 5:12"/></para>
  <chapter eid="PSA 5"/>
  <chapter number="6" style="c" sid="PSA 6"/>
  <para style="cl">ፋርፈትና 6</para>
  <para style="ms1">ከዸትና ዬሮ ዽጵና</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና በገናዻን ፋርፈተሙ። ፋርፈትና ዳዊት ከን አከ ስርነ <char style="tl">ሸሚኒቲት</char> ፋርፈተሙ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 6:1"/>ያ <char style="nd">ዋቀዮ</char> ኣሪኬቲን ነ ህንእፈትን፤</para>
  <para style="q2" vid="PSA 6:1">ዮካን ዼከምሰኬቲን ነ ህንአደብን።<verse eid="PSA 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 6:2"/>ና ገሜራቲ ያ <char style="nd">ዋቀዮ</char> ናፍ አራረም፤</para>
  <para style="q2" vid="PSA 6:2">ለፌንኮስ ጄቀሜራቲ ያ <char style="nd">ዋቀዮ</char> ነ ፈይስ።<verse eid="PSA 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 6:3"/>ሉቡንኮ አከ መሌ ጄቀሜረ፤</para>
  <para style="q2" vid="PSA 6:3">ኩን ሀመ ዮሚት? ያ <char style="nd">ዋቀዮ</char>፣ ሀመ ዮሚት?<verse eid="PSA 6:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 6:4"/>ያ <char style="nd">ዋቀዮ</char>፣ ዴብኢቲ ሉቡኮ ኦልች፤</para>
  <para style="q2" vid="PSA 6:4">አራረኬቲፍ ጄዺቲ ነ ፈይስ።<verse eid="PSA 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 6:5"/>ነምን ዱኤ ስ ህንያደቱ።</para>
  <para style="q2" vid="PSA 6:5">ሲኦል ኬሰት ኤኙቱ ስ ገለቴፈተ?<verse eid="PSA 6:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 6:6"/>አን ኣዱኮቲን ቡቱቴረ።</para>
  <para style="b" vid="PSA 6:6"/>
  <para style="q1" vid="PSA 6:6">ሀልከን ሁንደ ቦእቻን ስሬኮ ነንዽቀ፤</para>
  <para style="q2" vid="PSA 6:6">እምማኒንስ እዶ ጪስቻኮ ነንቶርቶርሰ።<verse eid="PSA 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 6:7"/>እጅኮ ገዳን ፈጀጄረ፤</para>
  <para style="q2" vid="PSA 6:7">ሰበቢ ዲኖተኮ ሁንዳቲፍስ ደዸቤረ።<verse eid="PSA 6:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 6:8"/>ወር ሀማ ሆጄተን ሁንድኑ ነራ ፈጋዻ፤</para>
  <para style="q2" vid="PSA 6:8">
    <char style="nd">ዋቀዮ</char> ሰገሌ ቦእቸኮ ዸገኤራቲ።<verse eid="PSA 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 6:9"/>
    <char style="nd">ዋቀዮ</char> ዋመተኮ ዸገኤረ፤</para>
  <para style="q2" vid="PSA 6:9">
    <char style="nd">ዋቀዮ</char> ከዸትናኮ ንፉዸተ።<verse eid="PSA 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 6:10"/>ዲኖትንኮ ሁንድኑ ሃቃነአን፤ አከ መሌስ ሃርፈተን፤</para>
  <para style="q2" vid="PSA 6:10">ቃኒ ተሳቲንስ ኦፍረ ሃገረገለን።<verse eid="PSA 6:10"/></para>
  <chapter eid="PSA 6"/>
  <chapter number="7" style="c" sid="PSA 7"/>
  <para style="cl">ፋርፈትና 7</para>
  <para style="ms1">ከዸትና ነምን ቀጄላን ከዸቱ</para>
  <para style="d">
    <char style="tl">ሺጋዮን</char> ዳዊት ከን እን ዋኤ ኩሽ ነምቸ ጎሰ ቤንያሚፍ ጄዼ <char style="nd">ዋቀዮፍ</char> ፋርፈቴ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 7:1"/>ያ <char style="nd">ዋቀዮ</char> ዋቀኮ፣ አን ኮሉ ስት ነንገለ፤</para>
  <para style="q2" vid="PSA 7:1">ወረ ነ አርአተን ሁንደ ጀላ ነ ባስ፤ ነ ኦልችስ፤<verse eid="PSA 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 7:2"/>ዮ ከና አቺ እሳን ዬሮ ነምን ነ ኦልቹ ህንጅሬት፣</para>
  <para style="q2" vid="PSA 7:2">አከ ሌንጫ ነ ጭጭረቱ፤ ነ ኩኩተቱስ።<verse eid="PSA 7:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 7:3"/>ያ <char style="nd">ዋቀዮ</char> ዋቀኮ፣ ዮ አን ዋን ከነ ጎዼ ጅራዼ</para>
  <para style="q2" vid="PSA 7:3">ዮ ሀርከኮ ኬሰ የክ ጅራቴ፣<verse eid="PSA 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 7:4"/>ዮ አን ነመ ነጋዻን ነ ወጅን ጅራቱት ሀማ ሆጄዼ ጅራዼ፣</para>
  <para style="q2" vid="PSA 7:4">ዮካን ዮ አን ሰበቢ መሌ ዲነኮ ሳሜ ጅራዼ፣<verse eid="PSA 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 7:5"/>ዲንኮ አርኤ ነ ሃቀበቱ፤</para>
  <para style="q2" vid="PSA 7:5">ጅሬኘኮ ለፈት ሃዽዺቱ፤</para>
  <para style="q2" vid="PSA 7:5">ኡልፍነኮስ አዋረ ኬሰ ሃቡሱ።<verse eid="PSA 7:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 7:6"/>ያ <char style="nd">ዋቀዮ</char> ኣሪኬቲን ከእ፤</para>
  <para style="q2" vid="PSA 7:6">ዼከምሰ ዲኖተኮት ከእ።</para>
  <para style="q2" vid="PSA 7:6">ያ ዋቀኮ አናፍ ደመቅ፤ ሙርቲ ቀጄላ ለብስ።<verse eid="PSA 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 7:7"/>ያኢን ነሞታ ናኖኬት ወልት ሃቀበሙ፤</para>
  <para style="q2" vid="PSA 7:7">አትስ ኦል ጉባዻ እሳን ቡልች።<verse eid="PSA 7:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="PSA 7:8"/>
    <char style="nd">ዋቀዮ</char> ሰቦታፍ ሙርቲ ሃኬኑ።</para>
  <para style="q1" vid="PSA 7:8">ያ <char style="nd">ዋቀዮ</char>፣ አከ ቀጄሉማኮቲት፣</para>
  <para style="q2" vid="PSA 7:8">አከ አመነሙማኮቲትስ ና ሙርቴስ።<verse eid="PSA 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 7:9"/>ያ ዋቀ ቀጄላ፣</para>
  <para style="q2" vid="PSA 7:9">ከን ያዳፊ ገራ ነማ ቆርቱ፣</para>
  <para style="q1" vid="PSA 7:9">ፍንጭለ ሀሞታ በሌስ፤</para>
  <para style="q2" vid="PSA 7:9">ቀጄልቶተሞ ጀቤሲ ዻብ።<verse eid="PSA 7:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 7:10"/>ጋቸንኮ ዋቀ፤</para>
  <para style="q2" vid="PSA 7:10">እን ገረ ቶሌዪ ንኦልቸ።<verse eid="PSA 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 7:11"/>ዋቅን አባ ሙርቲ ቀጄላዸ፤</para>
  <para style="q2" vid="PSA 7:11">እን ዋቀ ጉያ ሁንደ ዼከምሰሳ ሙልእሱዸ።<verse eid="PSA 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 7:12"/>ዮ ነምን ቀልቢ ጅጂረቹ ባቴ፣</para>
  <para style="q2" vid="PSA 7:12">እን ጎራዴሳ ንቀረተ፤</para>
  <para style="q2" vid="PSA 7:12">እዳሳስ ደብሴ ቆጴፈተ።<verse eid="PSA 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 7:13"/>እን ሜሻ ነመ አጄሱ</para>
  <para style="q2" vid="PSA 7:13">ቆጴፈቴረ፤ ጥየ ቦበኡስ ንቆጴፈተ።<verse eid="PSA 7:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 7:14"/>ኩኖ፣ ነምን ሀማን ሀምነ ኡልፋአ፤</para>
  <para style="q2" vid="PSA 7:14">ጀልእነ ገራት ባተ፤ ሶበ ዸለ።<verse eid="PSA 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 7:15"/>እን ገድ ፈጌሴ ቦለ ቆተ፤</para>
  <para style="q2" vid="PSA 7:15">ቦለ ቆጴሴ ሰነ ኬሰስ ንቡአ።<verse eid="PSA 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 7:16"/>ደብንሳ መቱመሳት ዴብአ፤</para>
  <para style="q2" vid="PSA 7:16">ጀልእንሳስ ጉቤ መታሳረ ቡአ።<verse eid="PSA 7:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 7:17"/>ቀጄሉማሳቲፍ <char style="nd">ዋቀዮን</char> ነንገለቴፈዸ፤</para>
  <para style="q2" vid="PSA 7:17">መቃ <char style="nd">ዋቀዮ</char> ዋቀ ዋን ሁንዳ ኦሊስ ፋርፈናዻን ነንጀጀዸ።<verse eid="PSA 7:17"/></para>
  <chapter eid="PSA 7"/>
  <chapter number="8" style="c" sid="PSA 8"/>
  <para style="cl">ፋርፈትና 8</para>
  <para style="ms1">ኡልፍነ ዋቀዮ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዳዊት ከን <char style="tl">ግቲቲዻን</char> ፋርፈተሙ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 8:1"/>ያ <char style="nd">ዋቀዮ</char> ጎፍታኬኘ፣</para>
  <para style="q2" vid="PSA 8:1">መቃንኬ ለፈ ሁንደት አከም ኡልፍነ ቀቤሰ!</para>
  <para style="b" vid="PSA 8:1"/>
  <para style="q1" vid="PSA 8:1">አት ኡልፍነኬ</para>
  <para style="q2" vid="PSA 8:1">ሰሚወንረት ድሪርስቴርተ።<verse eid="PSA 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 8:2"/>ሰበቢ ዲኖተኬቲቲፍ፣ አመጃጂፊ ነመ ሃሎ ባፈቱ</para>
  <para style="q2" vid="PSA 8:2">አፋን ቀበቺሱፍ ጄቴ፣ አፋን ዳእመኒቲፊ</para>
  <para style="q2" vid="PSA 8:2">ሙጮሊ ሀርመ ሆዸኒራ ገለተ ቆጴስቴርተ።<verse eid="PSA 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 8:3"/>ዮሙ አን ሆጂ ቁበኬቲ፣</para>
  <para style="q2" vid="PSA 8:3">ሰሚወንኬ፣</para>
  <para style="q2" vid="PSA 8:3">ጅኣፊ ኡርጂወን አት ሁንዴስቴ እላሉት፣<verse eid="PSA 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 8:4"/>አከ አት እሳፍ ያዱፍ ነምን ማል?</para>
  <para style="q2" vid="PSA 8:4">አከ እሳፍ ዽምቱፍ እልም ነማ ማል?<verse eid="PSA 8:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 8:5"/>አት ጥኖሼ ኦፊኬቲ ገድ እሰ ጎቴ፤</para>
  <para style="q2" vid="PSA 8:5">ኡልፍናፊ ከበጃን እሰ ጎንፍቴ።<verse eid="PSA 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 8:6"/>ሆጂ ሀርከኬቲረት ቡልቻ እሰ ጎቴ፤</para>
  <para style="q2" vid="PSA 8:6">ዋን ሁንደስ ሚለሳ ጀለ ገልችቴ፤<verse eid="PSA 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 8:7"/>ቡሻዬፊ ሎን ሁንደ፣</para>
  <para style="q2" vid="PSA 8:7">ብኔንሶተ ቦሶናስ፣<verse eid="PSA 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 8:8"/>ስምብሮተ ሰሚራ፣ ቁርጡሚ ገላና፣</para>
  <para style="q2" vid="PSA 8:8">ዋን ዳንዲ ገላናቲን ደርቡ</para>
  <para style="q2" vid="PSA 8:8">ሁንደስ ሚለሳ ጀለ ገልችቴ።<verse eid="PSA 8:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 8:9"/>ያ <char style="nd">ዋቀዮ</char> ጎፍታኬኘ፣</para>
  <para style="q2" vid="PSA 8:9">መቃንኬ ለፈ ሁንዱማረት አከም ኡልፍነ ቀቤሰ!<verse eid="PSA 8:9"/></para>
  <chapter eid="PSA 8"/>
  <chapter number="9" style="c" sid="PSA 9"/>
  <para style="cl">ፋርፈትና 9</para>
  <para style="ms1">ሙርቲ ዋቀዮ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ፤ ዬደሎ፣ “ዱአ እልማ” ጄዸሙ። ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 9:1"/>ያ <char style="nd">ዋቀዮ</char>፣ አን ገራኮ ጉቱዻን ስን ገለቴፈዸ፤</para>
  <para style="q2" vid="PSA 9:1">ዋኤ ድንቂኬ ሁንዱማስ ነንኦዴሰ።<verse eid="PSA 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 9:2"/>አን ስትን ገመደ፤ ነንእልልቸስ፤</para>
  <para style="q2" vid="PSA 9:2">ያ ዋቀ ዋን ሁንዳ ኦሊ፣ ፋርፈናዻን መቃኬ ነንጀጀዸ።<verse eid="PSA 9:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 9:3"/>ዲኖትንኮ ዱግደ ዱበት ንዴብኡ፤</para>
  <para style="q2" vid="PSA 9:3">ንጉፈቱ፤ ፉለኬ ዱራስ ንበዱ።<verse eid="PSA 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 9:4"/>ምርገኮፊ ዽመኮ ቀበቴርተ፤</para>
  <para style="q2" vid="PSA 9:4">አትስ ሙርቲ ቀጄላ ኬና ቴሶኬረ ቴሴርተ።<verse eid="PSA 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 9:5"/>ሰቦተ እፈቴ ሀሞተስ በሌስቴርተ፤</para>
  <para style="q2" vid="PSA 9:5">መቃሳኒስ በራ ሀመ በረ በራት ሀቅጤርተ።<verse eid="PSA 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 9:6"/>ዲኖትን በዲሰ በረ በራቲን በሌፈሙ፤</para>
  <para style="q2" vid="PSA 9:6">አት መጋላወንሳኒ ቡቡቅፍቴርተ፤</para>
  <para style="q2" vid="PSA 9:6">ሴናንሳኒስ በርበዴፈሜረ።<verse eid="PSA 9:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 9:7"/>
    <char style="nd">ዋቀዮ</char> ገሩ በረ በራን ንሞአ፤</para>
  <para style="q2" vid="PSA 9:7">ቴሶሳስ ሙርቲዻፍ ዻበቴረ።<verse eid="PSA 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 9:8"/>እን ቀጄሉማዻን አዱኛዻፍ ሙርቲ ንኬነ፤</para>
  <para style="q2" vid="PSA 9:8">ሰቦተስ ሙርቲ ቀጄላዻን ቡልቸ።<verse eid="PSA 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 9:9"/>
    <char style="nd">ዋቀዮ</char> ወረ ጩንቁርፈመኒፍ እርኮዸ፤</para>
  <para style="q2" vid="PSA 9:9">ዬሮ ረክናትስ ደኦዸ።<verse eid="PSA 9:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 9:10"/>ወር መቃኬ ቤከን ስ አመነቱ፤</para>
  <para style="q2" vid="PSA 9:10">ያ <char style="nd">ዋቀዮ</char>፣ አት ወረ ስ በርባደን ገቴ ህንቤክቱቲ።<verse eid="PSA 9:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 9:11"/>
    <char style="nd">ዋቀዮ</char> እሰ ጥዮንረ ጅራቱ ፋርፈናዻን ጀጀዻ፤</para>
  <para style="q2" vid="PSA 9:11">ሆጂሳሌ ሰቦተ ኬሰት ለብሳ።<verse eid="PSA 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 9:12"/>እን ሃሎ ዺጋ ባሱ ሱንስ እሳን ያደታቲ፤</para>
  <para style="q2" vid="PSA 9:12">እየ ወረ ዽጰተኒስ ህንእራንፈቱ።<verse eid="PSA 9:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 9:13"/>ያ <char style="nd">ዋቀዮ</char>፣ ሀመም አከ ዲኖትንኮ ነ አርአተን እላል!</para>
  <para style="q2" vid="PSA 9:13">ናፍ አራረሚቲ አፋን ቦለ ዱኣ ኬሳ ነ ባስ፤<verse eid="PSA 9:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 9:14"/>ኩንስ አን ከረ እንተለ ጥዮንረት</para>
  <para style="q2" vid="PSA 9:14">አከ ገለተኬ ለብሱፊ ፈይሱ ኬትስ</para>
  <para style="q2" vid="PSA 9:14">ባይእሴ ገመዱፍ።<verse eid="PSA 9:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 9:15"/>ሰቦትን ቦለ ቆተን ኬሰ ቡአን፤</para>
  <para style="q2" vid="PSA 9:15">ሚልሳኒስ ክዮዹመ እሳን ዾክሰኒን ቀበሜ።<verse eid="PSA 9:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 9:16"/>
    <char style="nd">ዋቀዮ</char> ሙርቲ ቀጄላ ኬኑዻን ቤከመ፤</para>
  <para style="q2" vid="PSA 9:16">ሀሞን ገሩ ሆጂ ሀርከሳኒቲን ክዮ ሴኑ።<verse eid="PSA 9:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 9:17"/>ነሞትን ሀሞን፣</para>
  <para style="q2" vid="PSA 9:17">ወር ዋቀ እራንፈተን ሁንድኑስ ሲኦልት ገድ ቡኡ።<verse eid="PSA 9:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 9:18"/>ረከቶትን ገሩ ዮምዩ ህንእራንፈተመን፤</para>
  <para style="q2" vid="PSA 9:18">አብዲን ህዬዪስ በረ በራን ህንበዱ።<verse eid="PSA 9:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 9:19"/>ያ <char style="nd">ዋቀዮ</char> ከእ፤ ጀብን ነማ ህንሙልአትን፤</para>
  <para style="q2" vid="PSA 9:19">ፉለኬ ዱረት ሰቦተት ሃሙረሙ።<verse eid="PSA 9:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 9:20"/>ያ <char style="nd">ዋቀዮ</char>፣ ሶዳ እሳንት ቡስ፤</para>
  <para style="q2" vid="PSA 9:20">ሰቦትንስ አከ ነሙመ ተአን ሃቤከን።<verse eid="PSA 9:20"/></para>
  <chapter eid="PSA 9"/>
  <chapter number="10" style="c" sid="PSA 10"/>
  <para style="cl">ፋርፈትና 10</para>
  <para style="ms1">ሙርቲ ቀጄላ አርገቹፍ ዋቀ ከዸቹ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 10:1"/>ያ <char style="nd">ዋቀዮ</char>፣ አት ማሊፍ አች ፈጋቴ ዻበተ?</para>
  <para style="q2" vid="PSA 10:1">ዬሮ ረክናትስ ማሊፍ ኦፍ ዾክስተ?<verse eid="PSA 10:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 10:2"/>ነምን ሀማን ኦፍ ቱሉማሳቲን ህዬሰ አደምሰ፤</para>
  <para style="q2" vid="PSA 10:2">እን መሉመ መለቱን ሃቀበሙ።<verse eid="PSA 10:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 10:3"/>ነምን ሀማን ሀዊሳቲን ኦፍ ጀጀ፤ ኦፍቶ ንኤብሰ፤</para>
  <para style="q2" vid="PSA 10:3">
    <char style="nd">ዋቀዮን</char>ሞ ንአረብሰ።<verse eid="PSA 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 10:4"/>ነምን ሀማን ሰበቢ ኦፍ ቱሉፍ ዋቀ ህንበርባዱ፤</para>
  <para style="q2" vid="PSA 10:4">ያደሳ ሁንዱማ ኬሰስ ዋቅን ህንጅሩ።<verse eid="PSA 10:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 10:5"/>ከራንሳ ዬሮ ሁንደ ንምልካኣፍ፤ እን ኦፍ ቱለ፤</para>
  <para style="q2" vid="PSA 10:5">ሴርኬስ እሰራ ፈጎዸ፤</para>
  <para style="q2" vid="PSA 10:5">ዲኖተሳ ሁንደትስ ቱፊዻን ቁማደ።<verse eid="PSA 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 10:6"/>እንስ፣ “ወን ነ ሶቾሱ ህንጅሩ፤</para>
  <para style="q2" vid="PSA 10:6">ረክንስ ጎንኩማ ነ ህንአርገቱ” ኦፊን ጄዸ።<verse eid="PSA 10:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 10:7"/>አፋንሳ አባርሳን፣ ሶባፊ ዶርስሳን ጉተሜረ፤</para>
  <para style="q2" vid="PSA 10:7">ደባፊ ሀምን አረበሳ ጀለ ጅሩ።<verse eid="PSA 10:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 10:8"/>እን ገንዶተ ኬሰት ርጴ ኤገተ፤</para>
  <para style="q2" vid="PSA 10:8">እዶ ዾከታትስ ወረ የከ ህንቀብኔ አጄሰ።</para>
  <para style="q1" vid="PSA 10:8">እጀሳቲንስ ህዬዪ ጋደ።<verse eid="PSA 10:8"/></para>
  <para style="q2">
    <verse number="9" style="v" sid="PSA 10:9"/>አከ ሌንጨ ደገለሳ ኬሳት ርጴ ኤገተ።</para>
  <para style="q1" vid="PSA 10:9">ህዬሰ ቀበቹዻፍ ዾከቴ ኤገተ፤</para>
  <para style="q2" vid="PSA 10:9">ህዬሰስ ቀበቴ ክዮሳቲን ሀርክፈተ።<verse eid="PSA 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 10:10"/>ህዬስ ሱንስ ንጨጨበ፤ ገድ ኦፍ ቀበስ፤</para>
  <para style="q2" vid="PSA 10:10">ሁምነ ነመ ሀማ ጀለትስ ንኩፈ።<verse eid="PSA 10:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 10:11"/>እንስ፣ “ዋቀ እራንፈቴረ፤</para>
  <para style="q2" vid="PSA 10:11">ፉለሳስ ዾክፈቴረ፤ ጎንኩማ ህንአርጉ” ኦፊን ጄዸ።<verse eid="PSA 10:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 10:12"/>ያ <char style="nd">ዋቀዮ</char> ከእ! ያ ዋቅ ሀርከኬ ኦል ካፈዹ።</para>
  <para style="q2" vid="PSA 10:12">ረከታስ ህንደገትን።<verse eid="PSA 10:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 10:13"/>ነምን ሀማን ማሊፍ ዋቀ አረብሰ?</para>
  <para style="q2" vid="PSA 10:13">ማሊፍስ ገራሳት፣</para>
  <para style="q2" vid="PSA 10:13">“እን ዋን ከነት ነ ህንጋፈቱ” ጄዸ?<verse eid="PSA 10:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 10:14"/>ያ ዋቅ፣ አት ገሩ ረክናፊ ገደ ወረ ሚዸመኒ ንአርግተ፤</para>
  <para style="q2" vid="PSA 10:14">ሀርከኬቲንስ ገቲ ባስፍተ።</para>
  <para style="q1" vid="PSA 10:14">ዴጋን ደበርሴ ስት ኦፍ ኬነ፤</para>
  <para style="q2" vid="PSA 10:14">አት እጆሌ አባ ህንቀብኔፍ ገርጋራዸ።<verse eid="PSA 10:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 10:15"/>እሬ ነመ ሀማቲፊ ጀልኣ ጨብስ፤</para>
  <para style="q2" vid="PSA 10:15">ሀመ ሀምንሳ ዹሜ ዸበሙት፣</para>
  <para style="q2" vid="PSA 10:15">ሀምነሳት እሰ ጋፈዹ።<verse eid="PSA 10:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 10:16"/>
    <char style="nd">ዋቀዮ</char> በረ በራ ሀመ በረ በራት ሞቲዸ፤</para>
  <para style="q2" vid="PSA 10:16">ኦርሞትን ለፈሳራ ንበርበዳኡ።<verse eid="PSA 10:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 10:17"/>ያ <char style="nd">ዋቀዮ</char>፣ አት ሀዊ ረከቶታ ንዸጌሰ፤</para>
  <para style="q2" vid="PSA 10:17">እሳን ጀጀቤስተ፤ እየሳኒሌ ንዸጌፈተ፤<verse eid="PSA 10:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 10:18"/>ኩንስ አከ ነምን ብዮራ ኡመሜ ስአች እሳን ህንጩንቁርስኔፍ</para>
  <para style="q2" vid="PSA 10:18">አት እጆሌ አባ ህንቀብኔፊ</para>
  <para style="q2" vid="PSA 10:18">ጩንቁርፈምቶታፍ አከ ዻበቱፍ።<verse eid="PSA 10:18"/></para>
  <chapter eid="PSA 10"/>
  <chapter number="11" style="c" sid="PSA 11"/>
  <para style="cl">ፋርፈትና 11</para>
  <para style="ms1">ዋቀ አመነቹ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 11:1"/>አን <char style="nd">ዋቀዮት</char> ኮሉ ገሌረ።</para>
  <para style="q2" vid="PSA 11:1">ዮስ እስን አከምት ሉቡኮቲን አከነ ጄቹ ደንዴሱ፦</para>
  <para style="q2" vid="PSA 11:1">“አት አኩመ ስምብሮ ቱሉኬት በርስ።<verse eid="PSA 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 11:2"/>ኩኖ ነሞትን ሀሞን እዳሳኒ ደብሰተኒሩ፤</para>
  <para style="q2" vid="PSA 11:2">እሳን ወረ ቶሎተ ተአን፣</para>
  <para style="q1" vid="PSA 11:2">ዱከነ ኬሰ ወራኑፍ ጄዸኒ፣</para>
  <para style="q2" vid="PSA 11:2">ጥየሳኒ ርቡት ዻበተኒሩ።<verse eid="PSA 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 11:3"/>ዮ ሁንዴወን ዲገመን፣ ነምን ቀጄላን</para>
  <para style="q2" vid="PSA 11:3">ማል ጎቹ ደንደአ?”<verse eid="PSA 11:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 11:4"/>
    <char style="nd">ዋቀዮ</char> መነ ቁልቁሉማሳ ቁልቁሉ ሰነ ኬሰ ጅረ፤</para>
  <para style="q2" vid="PSA 11:4">ቴሶን <char style="nd">ዋቀዮ</char> ሰሚረ ጅረ።</para>
  <para style="q1" vid="PSA 11:4">እን እልማን ነሞታ ንእላለ፤</para>
  <para style="q2" vid="PSA 11:4">እጅሳስ ነሞተ ንቆረ።<verse eid="PSA 11:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 11:5"/>
    <char style="nd">ዋቀዮ</char> ቀጄልቶታፊ ጀልኦተ ንቆረ፤</para>
  <para style="q2" vid="PSA 11:5">ሉቡንሳ ገሩ ነመ ጎሊ ጃለቱ ንጅብት።<verse eid="PSA 11:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 11:6"/>እን ሀሞተረት፣ በርበዳ እብዳቲፊ</para>
  <para style="q2" vid="PSA 11:6">ድኚ ቦበኡ ንሮብሰ፤</para>
  <para style="q2" vid="PSA 11:6">ቆድንሳኒስ ቡቤ ፍኒናዸ።<verse eid="PSA 11:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 11:7"/>
    <char style="nd">ዋቀዮ</char> ዋን ቀጄላ ተኤፍ፣</para>
  <para style="q2" vid="PSA 11:7">ሙርቲ ቀጄላ ጃለተ፤</para>
  <para style="q2" vid="PSA 11:7">ቶሎንስ ፉለሳ ንአርጉ።<verse eid="PSA 11:7"/></para>
  <chapter eid="PSA 11"/>
  <chapter number="12" style="c" sid="PSA 12"/>
  <para style="cl">ፋርፈትና 12</para>
  <para style="ms1">ከዸትና ገርጋርሰ በርባቻፍ ከዸተሜ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዳዊት ከን አከ ስርነ <char style="tl">ሸሚኒቲት</char> ፋርፈተሙ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 12:1"/>ያ <char style="nd">ዋቀዮ</char>፣ ነምን ዋቀ ሶዳቱ ህንጅሩቲ አት ነ ገርጋር፤</para>
  <para style="q2" vid="PSA 12:1">እልማን ነማ ኬሳስ ነምን አመነሙ ዸበሜራቲ።<verse eid="PSA 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 12:2"/>ነምን ሁንድኑ ኦላሳት ሶበ ዱበተ፤</para>
  <para style="q2" vid="PSA 12:2">እሳን ነመ ሳደኒ ገራ ለማን ዱበቱ።<verse eid="PSA 12:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 12:3"/>
    <char style="nd">ዋቀዮ</char> አፋን ነመ ሳዱ ሁንደ፣</para>
  <para style="q2" vid="PSA 12:3">አረበ ኦፍ ቱሉ ሁንደስ ሃኩኩቱ፤<verse eid="PSA 12:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 12:4"/>እሳንስ፣ “ኑ አረበኬኛን ንሞነ፤</para>
  <para style="q2" vid="PSA 12:4">ህዺንኬኘስ ኬኙመ፤</para>
  <para style="q2" vid="PSA 12:4">ኤኙቱ ኑረት ጎፍቱማ ቀበ?” ጄዹ።<verse eid="PSA 12:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 12:5"/>
    <char style="nd">ዋቀዮ</char>፣ “አን ሰበቢ ሀጩጨሙ ህዬዪቲፍ፣</para>
  <para style="q2" vid="PSA 12:5">ሰበቢ ኣዱ ረከቶታቲፍስ አመ ነንከአ።</para>
  <para style="q2" vid="PSA 12:5">ነጋ እሳን ሀወን ኬሰስ እሳን ነንጅራችሰ” ጄዸ።<verse eid="PSA 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 12:6"/>ዱቢን <char style="nd">ዋቀዮ</char> ህርእነ ህንቀቡ፤</para>
  <para style="q2" vid="PSA 12:6">እንስ አከ ሜቲ ቦለ እብዳ ኬሰት በቅፈሜ</para>
  <para style="q2" vid="PSA 12:6">ዬሮ ቶርበ ቁልቁሌፈሜት።<verse eid="PSA 12:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 12:7"/>ያ <char style="nd">ዋቀዮ</char> አት ኑ ኤግደ፤</para>
  <para style="q2" vid="PSA 12:7">ዸሎተ አከናራስ በረ በራን ኑ ኦልችተ።<verse eid="PSA 12:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 12:8"/>ዬሮ ወን ፋይዳ ህንቀብኔ እልማን ነማ ግዱት ከበጀሙት</para>
  <para style="q2" vid="PSA 12:8">ሀሞን ኦፍ ዺቡዻን ከለቲ ሁንዳን አሲፊ አች ናነኡ።<verse eid="PSA 12:8"/></para>
  <chapter eid="PSA 12"/>
  <chapter number="13" style="c" sid="PSA 13"/>
  <para style="cl">ፋርፈትና 13</para>
  <para style="ms1">እየተ ነመ ዋቀ አመነቴ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 13:1"/>ያ <char style="nd">ዋቀዮ</char>፣ ሀመ ዮሚት?</para>
  <para style="q2" vid="PSA 13:1">አት ሀመ በረ በራት ነ እራንፈታ?</para>
  <para style="q2" vid="PSA 13:1">ሀመ ዮሚትስ ፉለኬ ነ ዱራ ዾክስተ?<verse eid="PSA 13:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 13:2"/>አን ሀመ ዮሚትን ረክነ ኦብሴ</para>
  <para style="q2" vid="PSA 13:2">ጉያ ጉቱ ገራኮ ኬሰት ገደ?</para>
  <para style="q2" vid="PSA 13:2">ሀመ ዮሚት ዲንኮ ነረ ኣነ?<verse eid="PSA 13:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 13:3"/>ያ <char style="nd">ዋቀዮ</char> ዋቀኮ፣ ነ እላል፤ ዴቢሌ ና ኬን።</para>
  <para style="q2" vid="PSA 13:3">አከ አን ህርበ ዱኣ ህንረፍኔፍስ እጀኮቲፍ እፈ ኬን፤<verse eid="PSA 13:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 13:4"/>ዲንኮ፣ “አን እሰ ሞአዼረ” ጄዸ፤</para>
  <para style="q2" vid="PSA 13:4">አመጃጂወንኮስ ኩፋቲኮት ገመዱ።<verse eid="PSA 13:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 13:5"/>አን ገሩ አራረኬ ነንአመነዸ፤</para>
  <para style="q2" vid="PSA 13:5">ገራንኮስ ፈይሱኬት ንገመደ።<verse eid="PSA 13:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 13:6"/>አን <char style="nd">ዋቀዮፍ</char> ነንፋርፈዸ፤</para>
  <para style="q2" vid="PSA 13:6">አርጁማንሳ ና ባይአቴራቲ።<verse eid="PSA 13:6"/></para>
  <chapter eid="PSA 13"/>
  <chapter number="14" style="c" sid="PSA 14"/>
  <para style="cl">ፋርፈትና 14</para>
  <para style="ms1">ነሞተ ዋቃፍ ህንቡሌ</para>
  <para style="mr">
    <ref loc="PSA 14:1-7">14፥1‑7</ref> ኩወፈ – <char style="xt"><ref loc="PSA 53:1-6">ፋር 53፥1‑6</ref></char></para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 14:1"/>ጎዋን ገራሳት፣</para>
  <para style="q2" vid="PSA 14:1">“ዋቅን ህንጅሩ” ጄዸ።</para>
  <para style="q1" vid="PSA 14:1">እሳን ጡራአኒሩ፤ ሆጂንሳኒስ ጅብሲሳዸ፤</para>
  <para style="q2" vid="PSA 14:1">ነምን ዋን ጋሪ ሆጄቱ ቶኮዩ ህንጅሩ።<verse eid="PSA 14:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 14:2"/>
    <char style="nd">ዋቀዮ</char> ዮ ነምን ዋ ሁበቱ፣</para>
  <para style="q2" vid="PSA 14:2">ከን ዋቀስ በርባዱ፣ ቶኮዩ ጅራቴ አርጉፍ ጄዼ፣</para>
  <para style="q2" vid="PSA 14:2">ሰሚራ እልማን ነሞታ ገድ እላለ።<verse eid="PSA 14:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 14:3"/>ሁንድኑ ዶጎጎረኒሩ፤ ሁንድሳኒስ ጡራአኒሩ፤</para>
  <para style="q2" vid="PSA 14:3">ነምን ዋን ጋሪ ሆጄቱ ቶኮ ህንጅሩ፤</para>
  <para style="q2" vid="PSA 14:3">ቶኩምትዩ ህንጅሩ።<verse eid="PSA 14:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 14:4"/>ወር ሀምነ ሆጄተን</para>
  <para style="q2" vid="PSA 14:4">ከኔን አኩመ ዋን ቡዴነ ኛተኒት ሰበኮ ኛተን፣</para>
  <para style="q2" vid="PSA 14:4">ወር <char style="nd">ዋቀዮን</char> ህንዋመትኔ ሁንድኑ ሆማ ህንቤከኒ?<verse eid="PSA 14:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 14:5"/>እሳን ሶዳዻን ልቅምፈመኒሩ፤</para>
  <para style="q2" vid="PSA 14:5">ዋቅን ዸሎተ ቀጄልቶታ ወጅን ጅራቲ።<verse eid="PSA 14:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 14:6"/>እስን ጀልኦትን ከሮረ ህዬዪ ጀላ ፈሸሌስቱ፤</para>
  <para style="q2" vid="PSA 14:6">
    <char style="nd">ዋቀዮ</char> ገሩ ደኦሳኒት።<verse eid="PSA 14:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 14:7"/>ማሎ ኡቱ ጥዮን ኬሳ ፈይን እስራኤሊፍ ዹፌ!</para>
  <para style="q2" vid="PSA 14:7">ዮሙ <char style="nd">ዋቀዮ</char> ሰበሳ ወረ ቦጅአመን ዴብሱት፣</para>
  <para style="q2" vid="PSA 14:7">ያቆብ ሃእልልቹ፤ እስራኤልስ ሃገመዱ!<verse eid="PSA 14:7"/></para>
  <chapter eid="PSA 14"/>
  <chapter number="15" style="c" sid="PSA 15"/>
  <para style="cl">ፋርፈትና 15</para>
  <para style="ms1">ነመ አከሚቱ መነ ዋቃ ኬሰ ጅራቹ ደንደአ?</para>
  <para style="d">ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 15:1"/>ያ <char style="nd">ዋቀዮ</char>፣ ኤኙቱ ዱንካነኬ ኬሰ ጅራተ?</para>
  <para style="q2" vid="PSA 15:1">ኤኙቱ ቱሉኬ ቁልቁሉ ሰነረ ጅራቹ ደንደአ?<verse eid="PSA 15:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 15:2"/>ነመ አዴምስሳ ሙዳ ህንቀብኔፊ</para>
  <para style="q2" vid="PSA 15:2">ነመ ዋን ቀጄላ ሆጄቱ፣</para>
  <para style="q2" vid="PSA 15:2">ነመ ገራሳቲ ዹጋ ዱበቱፊ<verse eid="PSA 15:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 15:3"/>ከን አረበሳቲን ነመ ህንሀመትኔ፣</para>
  <para style="q2" vid="PSA 15:3">ነመ ኦላሳት ዋን ሀማ ህንሆጄትኔፊ</para>
  <para style="q2" vid="PSA 15:3">ነመ ኦላሳ መቃ ህንበሌስኔ፣<verse eid="PSA 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 15:4"/>ከን ነመ ሀማ ቱፈቴ ወረ <char style="nd">ዋቀዮን</char> ሶዳተን ገሩ ከበጁ፣</para>
  <para style="q2" vid="PSA 15:4">ዮ ዋን እሰ ሚዹ ተኤሌ ነመ ከኩሳ ኤጉ፣<verse eid="PSA 15:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 15:5"/>ነመ ማለቀሳ ሂቂዻን ህንልቄስኔፊ</para>
  <para style="q2" vid="PSA 15:5">ከን ነመ የከ ህንቀብኔ ሚዹፍ ጄዼ መተኣ ህንፉዸትኔዸ።</para>
  <para style="b" vid="PSA 15:5"/>
  <para style="q1" vid="PSA 15:5">ነምን ወንቶተ ከኔን ሆጄቱ፣</para>
  <para style="q2" vid="PSA 15:5">ጎንኩማ ህንራፈሙ።<verse eid="PSA 15:5"/></para>
  <chapter eid="PSA 15"/>
  <chapter number="16" style="c" sid="PSA 16"/>
  <para style="cl">ፋርፈትና 16</para>
  <para style="ms1">ዋቀዮ ዻለኮት</para>
  <para style="d">
    <char style="tl">ሚክታሚ</char> ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 16:1"/>ያ ዋቅ፣ አን ኮሉ ስት ገሌራቲ፣</para>
  <para style="q2" vid="PSA 16:1">አት ነ ኤግ።<verse eid="PSA 16:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 16:2"/>አንስ <char style="nd">ዋቀዮን</char>፣ “አት ጎፍታኮት፤</para>
  <para style="q2" vid="PSA 16:2">አን ስመሌ ጋሩማ ህንቀቡ” ነንጄዸ።<verse eid="PSA 16:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 16:3"/>ቁልቁሎትን ለፈራ ገሩ ኡልፍነ ቀቤዪዸ፤</para>
  <para style="q2" vid="PSA 16:3">አንስ እሳንት ባይኤ ነንገመደ።<verse eid="PSA 16:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 16:4"/>ወረ ዋቆተ ቶልፈሞ ዱካ ቡአን፣</para>
  <para style="q2" vid="PSA 16:4">ገድሳኒ ንጉደተ።</para>
  <para style="q1" vid="PSA 16:4">ዽባዩ ዺጋ አን እሳኒፍ ህንዽባፈዹ፤</para>
  <para style="q2" vid="PSA 16:4">ዮካን አፋንኮቲን መቃሳኒ ህንዸኡ።<verse eid="PSA 16:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 16:5"/>
    <char style="nd">ዋቀዮ</char> ቆደ ዻለኮቲፊ ቆደ ጦፎኮት፤</para>
  <para style="q2" vid="PSA 16:5">እጣኮስ ስቱ ና ጅራችሰ።<verse eid="PSA 16:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 16:6"/>ፉኞን ዳንጋ እዶ ጋሪ ና ቡኤረ፤</para>
  <para style="q2" vid="PSA 16:6">ዹጉማን አን ዻለ ነመ ገመቺሱ ቀበ።<verse eid="PSA 16:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 16:7"/>
    <char style="nd">ዋቀዮ</char> እሰ ነ ጎርሱ ሰነ አን ነንጀጀዸ፤</para>
  <para style="q2" vid="PSA 16:7">ሀልከንስ ያድንኮ ነ ቀጄልቸ።<verse eid="PSA 16:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 16:8"/>አን ዬሮ ሁንደ ፉለኮ ዱራ <char style="nd">ዋቀዮን</char> ቀበ።</para>
  <para style="q2" vid="PSA 16:8">ዋን እን ምርገኮ ጅሩፍ አን ህንራፈሙ።<verse eid="PSA 16:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 16:9"/>ከናፍ ገራንኮ ንገመደ፤ አረብንኮስ ንእልልቸ፤</para>
  <para style="q2" vid="PSA 16:9">ፎንኮስ ነጋዻን ጅራተ፤<verse eid="PSA 16:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 16:10"/>አት ሲኦል ኬሰት ነ ህንዺፍቱቲ፣</para>
  <para style="q2" vid="PSA 16:10">ዮካን አመነማንኬ አከ ቶርቶሩ ህንጎቱ።<verse eid="PSA 16:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 16:11"/>አት ከራ ጅሬኛ ነ በርሲፍተ፤ ፉለኬ ዱረትስ</para>
  <para style="q2" vid="PSA 16:11">ገመቹዻን ነ ጉተ፤</para>
  <para style="q2" vid="PSA 16:11">ገረ ምርገኬቲ ገመቹ በረ በራቱ ጅረ።<verse eid="PSA 16:11"/></para>
  <chapter eid="PSA 16"/>
  <chapter number="17" style="c" sid="PSA 17"/>
  <para style="cl">ፋርፈትና 17</para>
  <para style="ms1">እየተ ነመ ቀጄላ</para>
  <para style="d">ከዸትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 17:1"/>ያ <char style="nd">ዋቀዮ</char>፣ እየተ አን ሙርቲ ቀጄላፍ እየዹ ዸገእ፤</para>
  <para style="q2" vid="PSA 17:1">ቦእቸኮስ ዸጌፈዹ።</para>
  <para style="q1" vid="PSA 17:1">ከዸትናኮ ከን አፋን ነመ ህንጎዎምስኔ</para>
  <para style="q2" vid="PSA 17:1">ኬሳ በኡፍስ ጉረ ኬን።<verse eid="PSA 17:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 17:2"/>ሙርቲንኮ ስ ብራ ሃዹፉ፤</para>
  <para style="q2" vid="PSA 17:2">እጅኬስ ዋን ቀጄላ ሃአርጉ።<verse eid="PSA 17:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 17:3"/>አት ዮ ገራኮ ቆርቴ፣ ሀልከኒንስ ዮ ነ እላልቴ፣</para>
  <para style="q2" vid="PSA 17:3">ዮ ነ ሰከታቴስ፣ ሆማ ነረት ህንአርገቱ፤</para>
  <para style="q2" vid="PSA 17:3">አን አከ አፋንኮ ጩቡ ህንሆጄትኔፍ ኩተዼራቲ።<verse eid="PSA 17:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 17:4"/>ዋኤ ሆጂ ነሞታሞ አን ዱቢ አፋንኬቲቲን</para>
  <para style="q2" vid="PSA 17:4">ከራ ጎልቶታራ ኦፍ ኤገዼረ።<verse eid="PSA 17:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 17:5"/>ተርካንፊንኮ ከራኬረት ጭሜረ፤</para>
  <para style="q2" vid="PSA 17:5">ሚልኮስ ህንሙጩጫትኔ።<verse eid="PSA 17:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 17:6"/>ያ ዋቅ፣ ዋን አት ዴቢ ና ኬንቱፍ አን ስን ዋመዸ፤</para>
  <para style="q2" vid="PSA 17:6">ጉረኬ ገረኮት ቀቢቲ ከዸትናኮ ዸገእ።<verse eid="PSA 17:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 17:7"/>ያ እሰ ወረ ዲኖተሳኒ ጀላ ስት በቀተን</para>
  <para style="q2" vid="PSA 17:7">ሀርከኬ ምርጋቲን ኦልችቱ፣</para>
  <para style="q2" vid="PSA 17:7">አት ጃለለኬ እሰ ህንጌደረምኔ ሰነ ሃለ ድንቅሲሳዻን አርግሲስ።<verse eid="PSA 17:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 17:8"/>አከ አገርቱ እጀኬቲት ነ ኤግ፤</para>
  <para style="q2" vid="PSA 17:8">ጋድዱ ቆቾኬቲቲንስ ነ ዾክስ፤<verse eid="PSA 17:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 17:9"/>ሀሞተ ነ ዽጵሰን ጀላ፣</para>
  <para style="q2" vid="PSA 17:9">ዲኖተ ነ አጄሱፍ ነ መርሰን ጀላ ነ ባስ።<verse eid="PSA 17:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 17:10"/>እሳን ገራሳኒ ከን ነማ ህንናኔ ሰነ ንጉዱንፉ፤</para>
  <para style="q2" vid="PSA 17:10">አፋንሳኒስ ኦፍ ቱሉማዻን ዱበተ።<verse eid="PSA 17:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 17:11"/>እሳን ፋነ ነ ዸኡ፤ አመስ ነ መርሰኒሩ፤</para>
  <para style="q2" vid="PSA 17:11">ለፋን ነ ዸኡዻፍስ እጀ በባሱ።<verse eid="PSA 17:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 17:12"/>እሳን አከ ሌንጨ ዋ ኩኩተቹ ከጄሉት፤</para>
  <para style="q2" vid="PSA 17:12">አከ ሌንጨ ጉዳ ርጴ ዋ ጋዱት።<verse eid="PSA 17:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 17:13"/>ያ <char style="nd">ዋቀዮ</char> ከእ፤ እት በኢቲ እሳን ኩፍስ፤</para>
  <para style="q2" vid="PSA 17:13">ጎራዴኬቲንስ ሀሞተ ጀላ ነ ባስ።<verse eid="PSA 17:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 17:14"/>ያ <char style="nd">ዋቀዮ</char>፣ ነሞተ አከና ጀላ፣</para>
  <para style="q2" vid="PSA 17:14">ነሞተ አዱኛ ከና ወረ ቆድንሳኒ ጅሬኙመ አማ ተኤ ጀላ <optbreak/> ሀርከኬቲን ነ በራር።</para>
  <para style="q1" vid="PSA 17:14">ገራንሳኒ ዋን አት እሳኒፍ ኩፍቴ ሃቁፉ፤</para>
  <para style="q2" vid="PSA 17:14">እጆሌንሳኒስ አከ መሌ ሃቁፈን፤</para>
  <para style="q2" vid="PSA 17:14">እሳንስ ዋን እሳንራ ሀፌ ዳእመንሳኒቲፍ ሃካአን።<verse eid="PSA 17:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 17:15"/>አን ገሩ ቀጄሉማዻን ፉለኬ ነንአርገ፤</para>
  <para style="q2" vid="PSA 17:15">ዮሙን ደመቁትስ አን ኡልፍነኬ አርጉዻን ነንቁፈ።<verse eid="PSA 17:15"/></para>
  <chapter eid="PSA 17"/>
  <chapter number="18" style="c" sid="PSA 18"/>
  <para style="cl">ፋርፈትና 18</para>
  <para style="ms1">ፋርፈትና ሞአትና</para>
  <para style="mr">
    <ref loc="PSA 18:1-50">18፥1‑50</ref> ኩወፈ – <char style="xt"><ref loc="2SA 22:1-51">2ሳሙ 22፥1‑51</ref></char></para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዳዊት ገርብቸ <char style="nd">ዋቀዮ</char>፤ እንስ ዮሙ <char style="nd">ዋቀዮ</char> ሀርከ ዲኖተሳ ሁንዳፊ ሀርከ ሳኦል ጀላ እሰ ባሴት ዱቢ ፋርፈትና ከነ <char style="nd">ዋቀዮፍ</char> ፋርፈቴ። እንስ አከነ ጄዼ፦</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 18:1"/>ያ <char style="nd">ዋቀዮ</char> ጀብነኮ፣ አን ስን ጃለዸ።<verse eid="PSA 18:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 18:2"/>
    <char style="nd">ዋቀዮ</char> ከታኮ፣ ደአትኖኮቲፊ ኦልቻኮት፤</para>
  <para style="q2" vid="PSA 18:2">ዋቅንኮ ከታኮ ከን አን ኮሉ እት ገሉዸ፤</para>
  <para style="q2" vid="PSA 18:2">እን ጋቸነኮቲፊ ጋንፈ ፈይነኮት፤ ደአትኖኮ ጭማዸ።<verse eid="PSA 18:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 18:3"/>አን <char style="nd">ዋቀዮ</char> ገለን እሳፍ መሉ ሰነ ነንዋመዸ፤</para>
  <para style="q2" vid="PSA 18:3">ዲኖተኮ ጀላስ ነንበራረመ።<verse eid="PSA 18:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 18:4"/>ፉኞን ዱኣ ነ ጠጤ፤</para>
  <para style="q2" vid="PSA 18:4">ሎላን በዲሳስ ነ ልቅምሴረ።<verse eid="PSA 18:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 18:5"/>ፉኞን ሲኦል ነት መረሜ፤</para>
  <para style="q2" vid="PSA 18:5">ክዮን ዱኣስ ነት ዹፌ።<verse eid="PSA 18:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 18:6"/>አን ዽጵነኮ ኬሰት <char style="nd">ዋቀዮን</char> ነንዋመዼ፤</para>
  <para style="q2" vid="PSA 18:6">ገርጋርሳፍስ ዋቀኮት ነንእየዼ።</para>
  <para style="q1" vid="PSA 18:6">እንስ መነ ቁልቁሉማሳቲ ሰገሌኮ ዸገኤ፤</para>
  <para style="q2" vid="PSA 18:6">እይኮስ ጉረሳ ሴኔ።<verse eid="PSA 18:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 18:7"/>ለፍት ንሆለቴ፤ ንሶቾቴስ፤</para>
  <para style="q2" vid="PSA 18:7">ሁንዴወን ቱሉወኒስ ንራፈመን፤</para>
  <para style="q2" vid="PSA 18:7">ሰበቢ እን ዼከሜፍስ እሳን ንሆለተን።<verse eid="PSA 18:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 18:8"/>ኣር ፉኛንሳቲ ኦል በኤ፤</para>
  <para style="q2" vid="PSA 18:8">እብድ ዋ በርበዴሱ አፋንሳቲ በኤ፤</para>
  <para style="q2" vid="PSA 18:8">ጭሌን ቦበኡስ አፋንሳቲ በኤ።<verse eid="PSA 18:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 18:9"/>እን ሰሚወን ተርሳሴ ገድ ቡኤ፤</para>
  <para style="q2" vid="PSA 18:9">ዱሜሶን ጉራችስ ሚለሳ ጀለ ቱረን።<verse eid="PSA 18:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 18:10"/>እን ኪሩቤልን ያበቴ በርሴ፤</para>
  <para style="q2" vid="PSA 18:10">ቆቾ ቅሌንሳቲንስ ኦል በኤ።<verse eid="PSA 18:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 18:11"/>እን ዱከነ ሀጉጊሳ፣ ዱሜሰ ሰሚ ከን</para>
  <para style="q2" vid="PSA 18:11">ቦካዻን ዱከናኤሞ ጎዶሳ ጎዸቴ።<verse eid="PSA 18:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 18:12"/>እፈ ፉለሳ ኬሳስ ዱሜስ ዸጋ ጨቢቲፊ</para>
  <para style="q2" vid="PSA 18:12">በከካዻን ተርሳሴ በኤ።<verse eid="PSA 18:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 18:13"/>
    <char style="nd">ዋቀዮ</char> ሰሚዻ ንቀቀዌሰኤ፤</para>
  <para style="q2" vid="PSA 18:13">ሰገሌን ዋቀ ዋን ሁንዳ ኦሊስ ንዸገአሜ።<verse eid="PSA 18:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 18:14"/>እን ጥየሳ ደርበቴ ዲኖተ ብትኔሴ፤</para>
  <para style="q2" vid="PSA 18:14">በከካስ ገድ ዺሴ እሳን ፍጤ።<verse eid="PSA 18:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 18:15"/>ያ <char style="nd">ዋቀዮ</char>፣ ዼከምሰኬቲን፣</para>
  <para style="q2" vid="PSA 18:15">ሁምነ ሀፉረ ፉኛንኬቲ በኡቲንስ፣</para>
  <para style="q1" vid="PSA 18:15">ሱሉለወን ገላና እፈት ባፈመን፤</para>
  <para style="q2" vid="PSA 18:15">ሁንዴወን ለፋስ ቁላ ሀፈን።<verse eid="PSA 18:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 18:16"/>እን ኦል ጉባዻ ገድ ሂጠቴ ነ ቀቤ፤</para>
  <para style="q2" vid="PSA 18:16">ብሻኖተ ገድ ፈጎ ኬሳስ ነ ባሴ።<verse eid="PSA 18:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 18:17"/>እን ዲነኮ እሰ ጀባ ጀላ፣ አመጃጆተኮ</para>
  <para style="q2" vid="PSA 18:17">ወረ አከ መሌ ነት ጭመን ጀላስ ነ ባሴ።<verse eid="PSA 18:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 18:18"/>እሳን ጉያ ረክነኮት ነት ዹፈን፤</para>
  <para style="q2" vid="PSA 18:18">
    <char style="nd">ዋቀዮ</char> ገሩ ገርጋርሰኮ ቱሬ።<verse eid="PSA 18:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 18:19"/>እን እዶ በልኣት ነ ባሴ፤</para>
  <para style="q2" vid="PSA 18:19">ዋን ነት ገመዴፍስ ነ ኦልቼ።<verse eid="PSA 18:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 18:20"/>
    <char style="nd">ዋቀዮ</char> አኩመ ቀጄሉማኮቲት ና ኬኔረ፤</para>
  <para style="q2" vid="PSA 18:20">አኩመ ቁልቁልነ ሀርከኮትስ ነ በዻሴ።<verse eid="PSA 18:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 18:21"/>አን ከራ <char style="nd">ዋቀዮ</char> ኤጌራቲ፤</para>
  <para style="q2" vid="PSA 18:21">ዋቀኮራ ገረገሌ ሀምነ ህንሆጄትኔ።<verse eid="PSA 18:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 18:22"/>ሴርሳ ሁንድኑ ፉለኮ ዱረ ጅረ፤</para>
  <para style="q2" vid="PSA 18:22">አንስ ለብሲሳራ ህንጎሬ።<verse eid="PSA 18:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 18:23"/>አን ፉለሳ ዱረት ሙዳ ህንቀቡ ቱሬ፤</para>
  <para style="q2" vid="PSA 18:23">ጩቡራስ ኦፍ ኤገዼረ።<verse eid="PSA 18:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 18:24"/>
    <char style="nd">ዋቀዮ</char> አኩመ ቀጄሉመኮት፣</para>
  <para style="q2" vid="PSA 18:24">አኩመ ሀርክኮ ፉለሳ ዱረት ቁልቁሉ ተኤትስ ነ በዻሴረ።<verse eid="PSA 18:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 18:25"/>አት ነመ አመነማት አመነሙማኬ አርግሲፍተ፤</para>
  <para style="q2" vid="PSA 18:25">ነመ ሙዳ ህንቀብኔትስ ከን ሙዳ ህንቀብኔ ታተ።<verse eid="PSA 18:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 18:26"/>ነመ ቁልቁሉት ቁልቁሉ ታተ፤</para>
  <para style="q2" vid="PSA 18:26">ነመ ጀልኣትሞ ጀልኣ ታተ።<verse eid="PSA 18:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 18:27"/>አት ወረ ገድ ኦፍ ቀበን ንኦልችተ፤</para>
  <para style="q2" vid="PSA 18:27">እጀ ኦፍ ቱሉ ገሩ ገድ ዴብፍተ።<verse eid="PSA 18:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 18:28"/>ያ <char style="nd">ዋቀዮ</char> አት እብሳኮ ጀቤስቴ ንእብስተ፤</para>
  <para style="q2" vid="PSA 18:28">ዋቅንኮ ዱከነኮ እፈት ንጌደረ።<verse eid="PSA 18:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 18:29"/>አን ገርጋርሰኬቲን ሎልቶተ ዺበዼ ነንዴመ፤</para>
  <para style="q2" vid="PSA 18:29">ዋቀኮቲንስ ደላ ኡታሉ ነንደንደአ።<verse eid="PSA 18:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 18:30"/>ዋቀ ከነ ከራንሳ ሙዳ ህንቀቡ፤</para>
  <para style="q2" vid="PSA 18:30">ዱቢን <char style="nd">ዋቀዮ</char> ህርእነ ህንቀቡ፤</para>
  <para style="q2" vid="PSA 18:30">ወረ እሰት ኮሉ ገለን ሁንዳፍ <char style="nd">ዋቀዮ</char> ጋቸነ ተአ።<verse eid="PSA 18:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 18:31"/>
    <char style="nd">ዋቀዮ</char> መሌ ዋቅን ኤኙ?</para>
  <para style="q2" vid="PSA 18:31">ዋቀኬኘ መሌስ ከታን ኤኙ?<verse eid="PSA 18:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 18:32"/>ከን ሁምነ ነ ህዸቺሱ፣</para>
  <para style="q2" vid="PSA 18:32">ከን አከ ከራንኮስ ነጋ ተኡ ጎዹ ዋቀ።<verse eid="PSA 18:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 18:33"/>እን ሚለኮ አከ ሚለ ቦሮፋ ጎዸ፤</para>
  <para style="q2" vid="PSA 18:33">እዶ ኦል ዼራረስ ነ ዻበቺሰ።<verse eid="PSA 18:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 18:34"/>እን ሀርከኮ ወራናፍ ሌንጅሰ፤</para>
  <para style="q2" vid="PSA 18:34">እሬንኮስ እዳ ናሲ ደብሱ ንደንደአ።<verse eid="PSA 18:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 18:35"/>አት ገርጋርሰኬ ከን ነመ ፈይሱ ጋቸነ ናፍ ጎተ፤</para>
  <para style="q2" vid="PSA 18:35">ሀርክኬ ምርጋ ኦል ነ ቀቤረ፤</para>
  <para style="q2" vid="PSA 18:35">ገርጋርስኬስ ነመ ጉዳ ነ ጎዼ።<verse eid="PSA 18:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 18:36"/>አከ ኮሜንኮ ህንሙጩጫኔፍ፣</para>
  <para style="q2" vid="PSA 18:36">ሚለኮቲፍ ዳንዲ በልእፍቴርተ።<verse eid="PSA 18:36"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 18:37"/>አን ዲኖተኮ አርኤ ነንቀቀበዼ፤</para>
  <para style="q2" vid="PSA 18:37">ሀመ እሳን በርበዳአንትስ አን ዱበት ህንዴብኔ።<verse eid="PSA 18:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 18:38"/>አን አከ እሳን ዴብአኒ ከኡ ህንደንዴኜፍ እሳን ነንበርበዴሴ፤</para>
  <para style="q2" vid="PSA 18:38">እሳንስ ሚለኮ ጀለት ንኩፈን።<verse eid="PSA 18:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 18:39"/>አት ሎላፍ ሁምነ ነ ህዸቺፍቴ፤</para>
  <para style="q2" vid="PSA 18:39">አመጃጆተኮስ ፉለኮ ዱረት ገድ ዴብፍቴ።<verse eid="PSA 18:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 18:40"/>አከ ዲኖትንኮ ዱግደ ዱበት ዴብአኒ በቀተን ጎቴርተ፤</para>
  <para style="q2" vid="PSA 18:40">አንስ አመጃጆተኮ በርበዴሴረ።<verse eid="PSA 18:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 18:41"/>እሳን ገርጋርሳፍ እየን፤ ገሩ ከን እሳን ኦልቹ ቶኮዩ ህንቱሬ፤</para>
  <para style="q2" vid="PSA 18:41">ገረ <char style="nd">ዋቀዮትስ</char> ንእየተን፤ እን ገሩ ዴቢ ህንኬንኔፍ።<verse eid="PSA 18:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 18:42"/>አንስ አኩመ አዋረ ቡቤን ፉዸቱት እሳን ነንዳኬ፤</para>
  <para style="q2" vid="PSA 18:42">አኩመ ዾቄ ዳንዲራት እሳን ነንዽዺቴ።<verse eid="PSA 18:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 18:43"/>አት ሎለ ነሞታ ጀላ ነ ባፍቴርተ፤</para>
  <para style="q2" vid="PSA 18:43">መታ ሰቦታ ነ ጎቴርተ፤</para>
  <para style="q2" vid="PSA 18:43">ሰብን አን ህንቤክኔ ነ ተጃጅለ።<verse eid="PSA 18:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 18:44"/>ነሞትን ኦርማ ነ ሶሶበተን፤</para>
  <para style="q2" vid="PSA 18:44">እሳን አኩመ ዋኤኮ ዸገአኒን ናፍ አጀጀመን።<verse eid="PSA 18:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 18:45"/>እሳን ሁንድ አብዲ ኩተተን፤</para>
  <para style="q2" vid="PSA 18:45">ሆለቻስ ደአትኖሳኒ ጀባ ኬሳ በአን።<verse eid="PSA 18:45"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 18:46"/>
    <char style="nd">ዋቀዮ</char> ጅራታዸ! ከታንኮ ሃኤብፈሙ!</para>
  <para style="q2" vid="PSA 18:46">ዋቅን ፈይሳንኮ ኦል ኦል ሃጄዹ!<verse eid="PSA 18:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 18:47"/>እን ዋቀ ሃሎ ና ባሱ፣</para>
  <para style="q2" vid="PSA 18:47">ከን ሰቦተስ ነ ጀለት ቡልቹዸ፤<verse eid="PSA 18:47"/></para>
  <para style="q2">
    <verse number="48" style="v" sid="PSA 18:48"/>ዲኖተኮ ጀላስ ነ ባሰ።</para>
  <para style="q1" vid="PSA 18:48">አት አመጃጆተኮቲ ኦል ነ ጎተ፤</para>
  <para style="q2" vid="PSA 18:48">ጎልቶተ ጀላስ ነ ባፍቴ።<verse eid="PSA 18:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 18:49"/>ከናፉ ያ <char style="nd">ዋቀዮ</char>፣ አን ሰቦተ ግዱት ስን ሌልሰ፤</para>
  <para style="q2" vid="PSA 18:49">ፋርፈትና ገለታሌ መቃኬቲፍ ነንፋርፈዸ።<verse eid="PSA 18:49"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 18:50"/>እን ሞአናወን ጉርጉዳ ሞቲሳቲፍ ንኬነ፤</para>
  <para style="q2" vid="PSA 18:50">ድበማሳ ዳዊቲፊ ሰኚሳቲፍ፣</para>
  <para style="q2" vid="PSA 18:50">ጃለለ በረ በራ ንአርግሲሰ።<verse eid="PSA 18:50"/></para>
  <chapter eid="PSA 18"/>
  <chapter number="19" style="c" sid="PSA 19"/>
  <para style="cl">ፋርፈትና 19</para>
  <para style="ms1">ዋቀዮ ቢፍቱ ቀጄሉማት</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 19:1"/>ሰሚወን ኡልፍነ ዋቃ ኦዴሱ፤</para>
  <para style="q2" vid="PSA 19:1">በንቲን ሰሚስ ሆጂ ሀርከሳ ለብሰ።<verse eid="PSA 19:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 19:2"/>ጉያን ቶኮ ጉያ ካንት ኦዴሰ፣</para>
  <para style="q2" vid="PSA 19:2">ሀልከን ቶኮስ ሀልከን ካንት ቤኩምሰ ሙልእሰ።<verse eid="PSA 19:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 19:3"/>ሃሳን ዮካን ዱቢን ህንጅሩ፤</para>
  <para style="q2" vid="PSA 19:3">ሰገሌንሳኒስ ህንዸገአሙ።<verse eid="PSA 19:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 19:4"/>ተኡስ ሰገሌንሳኒ ለፈ ሁንዱማ፣</para>
  <para style="q2" vid="PSA 19:4">ዱቢንሳኒስ ሀንዳረ አዱኛ ገኤ።</para>
  <para style="q1" vid="PSA 19:4">እን ሰሚወን ኬሰት ቢፍቱዻፍ ዱንካነ ዻቤ፤<verse eid="PSA 19:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="PSA 19:5"/>ቢፍቱንስ አኩመ ምስርቸ ድንቀሳቲ በኡቲፊ</para>
  <para style="q2" vid="PSA 19:5">አኩመ ሞአታ ፊግቸ ዶርጎሙት ገመዱ ቶኮት።<verse eid="PSA 19:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 19:6"/>እሼንስ ሀንዳረ ሰሚወኒ ቶኮ ባቴ</para>
  <para style="q2" vid="PSA 19:6">ገረ ሀንዳረ ካኒት ናኖፍት፤</para>
  <para style="q2" vid="PSA 19:6">ወን ሆአሼ ጀላ ዾከቱ ቶኮዩ ህንጅሩ።<verse eid="PSA 19:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 19:7"/>ሴር <char style="nd">ዋቀዮ</char> ሙዳ ህንቀቡ፤</para>
  <para style="q2" vid="PSA 19:7">ሉቡ ነመት ዴብሰ።</para>
  <para style="q1" vid="PSA 19:7">አጀጅን <char style="nd">ዋቀዮ</char> አመነማዸ፤</para>
  <para style="q2" vid="PSA 19:7">ነመ ወላላ ቤካ ጎዸ።<verse eid="PSA 19:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 19:8"/>ሴር <char style="nd">ዋቀዮ</char> ቀጄላዸ፤</para>
  <para style="q2" vid="PSA 19:8">ገራዻፍ ገመቹ ኬነ።</para>
  <para style="q1" vid="PSA 19:8">አጀጅን <char style="nd">ዋቀዮ</char> ቁልቁሉዸ፤</para>
  <para style="q2" vid="PSA 19:8">እጃፍስ እፈ ኬነ።<verse eid="PSA 19:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 19:9"/>
    <char style="nd">ዋቀዮን</char> ሶዳቹን ቁልቁሉዸ፤</para>
  <para style="q2" vid="PSA 19:9">በረ በራን ጅራተ።</para>
  <para style="q1" vid="PSA 19:9">ሙርቲን <char style="nd">ዋቀዮ</char> ዹጋዸ፤</para>
  <para style="q2" vid="PSA 19:9">ወሉማ ገለትስ ቀጄላዸ።<verse eid="PSA 19:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 19:10"/>እን ወርቄ ጫላ፣ ወርቄ አከ መሌ ቁልቁሌፈሜ</para>
  <para style="q2" vid="PSA 19:10">ጫላዩ ገቲ ቀቤሰ፤</para>
  <para style="q1" vid="PSA 19:10">እን ደመ ጫላ፣</para>
  <para style="q2" vid="PSA 19:10">ነዺ ደማ ጫላ ምኣዋዸ።<verse eid="PSA 19:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 19:11"/>ሙርቲ ከናንስ ተጃጅላንኬ ንጎርፈመ፤</para>
  <para style="q2" vid="PSA 19:11">እሰ ኤጉንስ ገቲ ጉዳ ቀበ።<verse eid="PSA 19:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 19:12"/>ኤኙቱ ዶጎጎረሳ ሁበቹ ደንደአ?</para>
  <para style="q2" vid="PSA 19:12">የከኮ እሰ ዾክፈማራ ነ ቁልቁሌስ።<verse eid="PSA 19:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 19:13"/>ተጃጅላኬ ጩቡ እጀ ጀብናን ሆጄተሙራ ኤግ፤</para>
  <para style="q2" vid="PSA 19:13">ጩቡን ኩንስ ነ ህንሞአን።</para>
  <para style="q1" vid="PSA 19:13">ዮስ አን ህርእነ መሌ ነንጅራዸ፤</para>
  <para style="q2" vid="PSA 19:13">ዶጎጎረ ጉዳራስ ቁልቁሉ ነንተአ።<verse eid="PSA 19:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 19:14"/>ያ <char style="nd">ዋቀዮ</char>፣ ከታኮፊ ፉሪኮ፣</para>
  <para style="q2" vid="PSA 19:14">ዱቢን አፋንኮቲፊ ያድን ገራኮ</para>
  <para style="q2" vid="PSA 19:14">ፉለኬ ዱረት ፉዸተማ ሃተኡ።<verse eid="PSA 19:14"/></para>
  <chapter eid="PSA 19"/>
  <chapter number="20" style="c" sid="PSA 20"/>
  <para style="cl">ፋርፈትና 20</para>
  <para style="ms1">ከዸትና ሞቲፍ ከዸተሜ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 20:1"/>ጉያ ረክናት <char style="nd">ዋቀዮ</char> ዴቢ ሲፍ ሃኬኑ፤</para>
  <para style="q2" vid="PSA 20:1">መቃን ዋቀ ያቆብስ ስ ሃኤጉ።<verse eid="PSA 20:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 20:2"/>እን እዶ ቁልቁሉዻ ገርጋርሰ ሲፍ ሃኤርጉ፤</para>
  <para style="q2" vid="PSA 20:2">ጥዮንራስ ጀብነ ሲፍ ሃኬኑ።<verse eid="PSA 20:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 20:3"/>ኣርሳኬ ሁንደ ሲፍ ሃያደቱ፤</para>
  <para style="q2" vid="PSA 20:3">ቀልመኬ ከን ጉበሙስ ሲፍ ሃፉዸቱ።<verse eid="PSA 20:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 20:4"/>ሀዊ ገራኬቲ ሲፍ ሃኬኑ፤</para>
  <para style="q2" vid="PSA 20:4">ከሮረኬ ሁንደስ ፊጣን ሲፍ ሃባሱ።<verse eid="PSA 20:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 20:5"/>ዮሙ አት ሞአቱት እልልችኔ</para>
  <para style="q2" vid="PSA 20:5">መቃ ዋቀኬኛቲን ፋጂኬኘ ኦል ፉዸትነ።</para>
  <para style="b" vid="PSA 20:5"/>
  <para style="q1" vid="PSA 20:5">
    <char style="nd">ዋቀዮ</char> ዋን አት ከዸቱ ሁንዱማ ሲፍ ሃኬኑ።<verse eid="PSA 20:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 20:6"/>አን አከ <char style="nd">ዋቀዮ</char> ድበማሳ ፈይሱ አመ ቤከ፤</para>
  <para style="q2" vid="PSA 20:6">ዋቀዮ ሁምነ ነመ ፈይሱ ከን ሀርከሳ ምርጋ ኬሰ ጅሩ ሰናን</para>
  <para style="q2" vid="PSA 20:6">ሰሚሳ ቁልቁሉ ኬሳ ዴቢ ንኬናፍ።<verse eid="PSA 20:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 20:7"/>ነሞትን ቶኮ ቶኮ ጋሪወን አመነቱ፤ ካንሞ ፈርዴን አመነቱ፤</para>
  <para style="q2" vid="PSA 20:7">ኑ ገሩ መቃ <char style="nd">ዋቀዮ</char> ዋቀኬኛ አመነትነ።<verse eid="PSA 20:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 20:8"/>እሳን ጉፈተኒ ኩፉ፤ ኑ ገሩ ኦል ካነ፤</para>
  <para style="q2" vid="PSA 20:8">ጀባኔስ ንዻበትነ።<verse eid="PSA 20:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 20:9"/>ያ <char style="nd">ዋቀዮ</char>፣ አት ሞቲዻፍ ሞአትና ኬን!</para>
  <para style="q2" vid="PSA 20:9">ዮሙ ኑ ስ ዋመኑትስ ዴቢ ኑ ኬን!<verse eid="PSA 20:9"/></para>
  <chapter eid="PSA 20"/>
  <chapter number="21" style="c" sid="PSA 21"/>
  <para style="cl">ፋርፈትና 21</para>
  <para style="ms1">ገለተ ዋኤ ሞትቻቲፍ ዽኣቴ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 21:1"/>ያ <char style="nd">ዋቀዮ</char>፣ ሞቲን ጀብነኬት ባይኤ ገመደ።</para>
  <para style="q2" vid="PSA 21:1">ገርጋርሰ ኬትስ ገመቹንሳ ሀመም ጉዳዸ!<verse eid="PSA 21:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 21:2"/>አት ሀዊ ገራሳ ኬንቴፊ ጅርተ፤</para>
  <para style="q2" vid="PSA 21:2">ከዸትና አፋንሳስ እሰ ህንዾወትኔ።<verse eid="PSA 21:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 21:3"/>አት ኤበ ጉዳዻን እሰ ስመቴ፤</para>
  <para style="q2" vid="PSA 21:3">ጎንፎ ወርቄ ቁልቁሉስ መታሳረ ኬሴ።<verse eid="PSA 21:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 21:4"/>እን ጅሬኘ ስ ከዸቴ፤ አትስ ንኬንቴፍ፤</para>
  <para style="q2" vid="PSA 21:4">በረ ዼራስ በረ በራ ሀመ በረ በራት ኬንቴፍ።<verse eid="PSA 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 21:5"/>ኡልፍንሳ ሞአትና አት እሳፍ ኬንቴን ጉዳ ተኤ፤</para>
  <para style="q2" vid="PSA 21:5">አትስ ኡልፍናፊ ሱራ እሰት ኡውፍቴ።<verse eid="PSA 21:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 21:6"/>አት ኤበ በረ በራ ኬንቴፍ፤</para>
  <para style="q2" vid="PSA 21:6">አከ እን ገመቹ አርገመኬቲቲን ገመዱስ ጎቴ።<verse eid="PSA 21:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 21:7"/>ሞትች <char style="nd">ዋቀዮን</char> አመነታቲ፤</para>
  <para style="q2" vid="PSA 21:7">ሰበቢ ጃለለ ዋቀ ዋን ሁንዳ ኦሊ</para>
  <para style="q2" vid="PSA 21:7">ከን ህንጌደረምኔ ሰናቲፍስ እን ህንራፈሙ።<verse eid="PSA 21:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 21:8"/>ሀርክኬ ዲኖተኬ ሁንደ ንቀበተ፤</para>
  <para style="q2" vid="PSA 21:8">ሀርክኬ ምርጋስ ወረ ስ ጅበን ንቀበ።<verse eid="PSA 21:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 21:9"/>ዬሮ ሙልአቹኬቲት፣</para>
  <para style="q2" vid="PSA 21:9">አከ ቦለ እብድ ኬሳ ቦበኡ እሳን ጎተ።</para>
  <para style="q1" vid="PSA 21:9">
    <char style="nd">ዋቀዮ</char> ዼከምሰሳቲን እሳን ልቅምሰ፤</para>
  <para style="q2" vid="PSA 21:9">እብድስ እሳን ፍጠ።<verse eid="PSA 21:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 21:10"/>አት ሰኚሳኒ ለፈራ፣</para>
  <para style="q2" vid="PSA 21:10">እጆሌሳኒስ እልማን ነማ ግዱዻ ንበሌስተ።<verse eid="PSA 21:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 21:11"/>እሳን ዮ ዋን ሀማ ስት ያደን፣</para>
  <para style="q2" vid="PSA 21:11">ዮ ደበ ስት መርአተንስ ህንምልካአን።<verse eid="PSA 21:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 21:12"/>አት ዮሙ እዳኬ እሳንት ቀብዱት፣</para>
  <para style="q2" vid="PSA 21:12">አከ እሳን በቀተን ጎታቲ።<verse eid="PSA 21:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 21:13"/>ያ <char style="nd">ዋቀዮ</char>፣ ጀብነኬቲን ኦል ኦል ጄዽ፤</para>
  <para style="q2" vid="PSA 21:13">ኑ ሁምነኬ ንጀጀትነ፤ ንፋርፈነስ።<verse eid="PSA 21:13"/></para>
  <chapter eid="PSA 21"/>
  <chapter number="22" style="c" sid="PSA 22"/>
  <para style="cl">ፋርፈትና 22</para>
  <para style="ms1">ረክናፊ አብዲ ነመ ቀጄላ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ዬደሎ “ቦሮፈ ገነማ” ጄዹ። ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 22:1"/>ያ ዋቀኮ፣ ያ ዋቀኮ፣ አት ማሊፍ ነ ዺፍቴ?</para>
  <para style="q2" vid="PSA 22:1">አት ነ ገርጋሩራ፣</para>
  <para style="q2" vid="PSA 22:1">እየ ኮራስ ማሊፍ አከስ ፈጋተ?<verse eid="PSA 22:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 22:2"/>ያ ዋቀኮ፣ አን ጉያ ጉያ ስትን እየዸ፤</para>
  <para style="q2" vid="PSA 22:2">አት ገሩ ዴቢ ናፍ ህንዴብፍቱ፤</para>
  <para style="q2" vid="PSA 22:2">ሀልከን ሀልከንስ አፋን ህንቀበዹ።<verse eid="PSA 22:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 22:3"/>አት ገሩ ቁልቁልቸ ቴሶረ ታኡዸ፤</para>
  <para style="q2" vid="PSA 22:3">አት ገለተ እስራኤል።<verse eid="PSA 22:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 22:4"/>አቦቲንኬኘ ስ አመነተን፤</para>
  <para style="q2" vid="PSA 22:4">እሳን ስ አመነተን፤ አትስ እሳን ኦልችቴ።<verse eid="PSA 22:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 22:5"/>እሳን ስት እየተን፤ ንፈይፈመንስ፤</para>
  <para style="q2" vid="PSA 22:5">ስ አመነተን፤ ህንቃኖፍኔስ።<verse eid="PSA 22:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 22:6"/>አን ገሩ ራሞዸ መሌ ነመ ምት፤</para>
  <para style="q2" vid="PSA 22:6">አን ነመ ነምን እት ቆሱፊ ሰብንስ ቱፈቱዸ።<verse eid="PSA 22:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 22:7"/>ወር ነ አርገን ሁንድኑ ነት ኮልፉ፤</para>
  <para style="q2" vid="PSA 22:7">መታሳኒ ራሰኒ ነ አረብሱ።<verse eid="PSA 22:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 22:8"/>አከነስ ጄዹ፤ “እን <char style="nd">ዋቀዮን</char> አመነተ፤</para>
  <para style="q2" vid="PSA 22:8">ሜ <char style="nd">ዋቀዮ</char> እሰ ሃኦልቹ ካ።</para>
  <para style="q2" vid="PSA 22:8">እን ዋን እሰት ገመዱፍ፣ እሰ ሃኦልቹ።”<verse eid="PSA 22:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 22:9"/>አት ገሩ ገደሜሰ ኬሳ ነ ባፍቴ፤</para>
  <para style="q2" vid="PSA 22:9">ሀርመ ሃዸኮረትስ፣ ስቱ ነጋን ነ ኤጌ።<verse eid="PSA 22:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 22:10"/>አን ጋፈን ዸለዼ ጀልቀቤ ስረት ነንገተሜ፤</para>
  <para style="q2" vid="PSA 22:10">ኤርገ ሃትኮ ነ ዴሴ ጀልቀብዴ አት ዋቀኮት።<verse eid="PSA 22:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 22:11"/>አት ነራ ህንፈጋትን፤</para>
  <para style="q2" vid="PSA 22:11">ረክን ዽኣቴራቲ፤</para>
  <para style="q2" vid="PSA 22:11">ነምን ነ ገርጋሩስ ህንጅሩ።<verse eid="PSA 22:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 22:12"/>ኮሮሚን ባይኤን ነ መርሱ፤</para>
  <para style="q2" vid="PSA 22:12">ኮሮሚን ባሻን ጀጀቦንስ ከራ ሁንዱማን ነ መርሱ።<verse eid="PSA 22:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 22:13"/>እሳንስ አከ ሌንጨ ቤለኤ ኣዱ</para>
  <para style="q2" vid="PSA 22:13">አፋንሳኒ በልእሰኒ ነት በነቱ።<verse eid="PSA 22:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 22:14"/>አን አኩመ ብሻኒት ነንዸንገላፈሜ፤</para>
  <para style="q2" vid="PSA 22:14">ለፌንኮ ሁንድኑስ ወል ገድ ዺሴ።</para>
  <para style="q1" vid="PSA 22:14">ኦኔንኮ ገረ ገጋት ጌደረሜ፤</para>
  <para style="q2" vid="PSA 22:14">ነ ኬሰትስ በቄ።<verse eid="PSA 22:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 22:15"/>ጀብንኮ አከ ቅራጪ ጎጌ፤</para>
  <para style="q2" vid="PSA 22:15">አረብንኮ ላጋት ነ መጠኔ፤</para>
  <para style="q2" vid="PSA 22:15">አዋረ ዱኣ ኬሰስ ነ ጪብስቴ።<verse eid="PSA 22:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 22:16"/>ሰሮትን ነ መርሰኒሩ፤</para>
  <para style="q2" vid="PSA 22:16">ገሬን ነሞተ ሀሞ ነ መርሴረ፤</para>
  <para style="q2" vid="PSA 22:16">እሳንስ ሀርካፊ ሚለኮ ወራነኒ ፉላሰኒሩ።<verse eid="PSA 22:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 22:17"/>አን ለፌኮ ሁንደ ለካኡ ነንደንደአ፤</para>
  <para style="q2" vid="PSA 22:17">እሳንስ እጀ በባሰኒ ነ እላሉ፤ አከስ ተኡኮትስ ንገመዱ።<verse eid="PSA 22:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 22:18"/>እሳን ወያኮ ህረተን፤</para>
  <para style="q2" vid="PSA 22:18">ኡፈተኮትስ እጣ ቡፈተን።<verse eid="PSA 22:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 22:19"/>ያ <char style="nd">ዋቀዮ</char>፣ አት ገሩ ነራ ህንፈጋትን፤</para>
  <para style="q2" vid="PSA 22:19">ያ ጀብነኮ ነ ገርጋሩፍ አሪፈዹ።<verse eid="PSA 22:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 22:20"/>ሉቡኮ ጎራዴ ጀላ፣</para>
  <para style="q2" vid="PSA 22:20">ጅሬኘኮሞ ሁምነ ሰሮታ ጀላ ባስ።<verse eid="PSA 22:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 22:21"/>አፋን ሌንጫ ጀላ ነ ምልቅስ፤</para>
  <para style="q2" vid="PSA 22:21">ጋንፈ ገፈርሳ ጀላስ ነ ባስ።<verse eid="PSA 22:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 22:22"/>መቃኬ ኦቦሎተኮት ነንለብሰ፤</para>
  <para style="q2" vid="PSA 22:22">ወልዳ ኬሰትስ ስን ጀጀዸ።<verse eid="PSA 22:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 22:23"/>እስን ወር <char style="nd">ዋቀዮን</char> ሶዳተን እሰ ጀጀዻ!</para>
  <para style="q2" vid="PSA 22:23">እስን ሰኚን ያቆብ ሁንድኑ እሰ ኡልፌሳ!</para>
  <para style="q2" vid="PSA 22:23">ሰኚን እስራኤል ሁንድኑስ እሰ ሶዳዻ!<verse eid="PSA 22:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 22:24"/>እን ዽጵነ ነመ ዽጰቴ ህንቱፈትኔ</para>
  <para style="q2" vid="PSA 22:24">ዮካን ህንበልፍኔቲ፤</para>
  <para style="q1" vid="PSA 22:24">ዮሙ እን ገርጋርሳፍ እሰት እየቴትስ፣</para>
  <para style="q2" vid="PSA 22:24">ንዸገኤፍ መሌ ፉለሳ ህንዾክፈትኔ።<verse eid="PSA 22:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 22:25"/>ገለን አን ያኢ ጉዳረት ሲፍ ገልቹ ስ ብራ ዹፈ፤</para>
  <para style="q2" vid="PSA 22:25">ወረ ስ ሶዳተን ዱረትስ ወሬገኮ ኦፍራ ነንባሰ።<verse eid="PSA 22:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 22:26"/>ህዬዪን ኛተኒ ቁፉ፤</para>
  <para style="q2" vid="PSA 22:26">ወር <char style="nd">ዋቀዮን</char> በርባደተንስ እሰ ንጀጀቱ፤</para>
  <para style="q2" vid="PSA 22:26">ገራንኬሰን በረ በራን ሃጅራቱ!<verse eid="PSA 22:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 22:27"/>ሀንዳር ለፋ ሁንድኑ ንያደተ፤</para>
  <para style="q2" vid="PSA 22:27">ገረ <char style="nd">ዋቀዮትስ</char> ንዴብአ፤</para>
  <para style="q1" vid="PSA 22:27">ማቲወን ሰቦታ ሁንድኑስ</para>
  <para style="q2" vid="PSA 22:27">ፉለሳ ዱረት ንሰገዱ፤<verse eid="PSA 22:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 22:28"/>ሞቱማን ከን <char style="nd">ዋቀዮቲ</char>፤</para>
  <para style="q2" vid="PSA 22:28">እንስ ሰቦተ ሁንደ ንቡልቸ።<verse eid="PSA 22:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 22:29"/>ሶሬዪን ለፋ ሁንድኑ ንኛቱ፤ ንዋቄፈቱስ፤</para>
  <para style="q2" vid="PSA 22:29">ወር ኦፍ ጅራችሱ ህንደንዴኜ ከኔን ብዮ ሴነን ሁንድ</para>
  <para style="q2" vid="PSA 22:29">ፉለሳ ዱረት ንጅልቤንፈቱ።<verse eid="PSA 22:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 22:30"/>ዸሎትን ዹፉ እሰ ተጃጅለ፤</para>
  <para style="q2" vid="PSA 22:30">ዸሎተ ቦሪትስ ዋኤን ጎፍታ ንህመመ።<verse eid="PSA 22:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 22:31"/>ሰበቢ እን ዋን ከነ ሆጄቴፍ፣</para>
  <para style="q2" vid="PSA 22:31">እሳን ሰበ ዸለቹፍ ጅሩት ቀጄሉማሳ ንለብሱ።<verse eid="PSA 22:31"/></para>
  <chapter eid="PSA 22"/>
  <chapter number="23" style="c" sid="PSA 23"/>
  <para style="cl">ፋርፈትና 23</para>
  <para style="ms1">ትክሴ ጋሪ</para>
  <para style="d">ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 23:1"/>
    <char style="nd">ዋቀዮ</char> ትክሴኮት፤ አን ሆማ ህንዸቡ።<verse eid="PSA 23:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 23:2"/>እን መርገ ለልሳ ኬሰ ነ ቦቆቺሰ፤</para>
  <para style="q1" vid="PSA 23:2">ገረ ብሻን ተስገባኣትስ ነ ጌሰ፤<verse eid="PSA 23:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 23:3"/>እን ሉቡ ነት ዴብሰ።</para>
  <para style="q1" vid="PSA 23:3">መቃሳቲፍ ጄዼስ</para>
  <para style="q2" vid="PSA 23:3">ከራ ቀጄላረ ነ ዴምስሰ።<verse eid="PSA 23:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 23:4"/>አን ዮን ሱሉለ ጋድሰ ዱኣ ኬሰ ዴሜሌ</para>
  <para style="q2" vid="PSA 23:4">አት ዋን ነ ወጅን ጅርቱፍ፣ ሆማ ህንሶዳዹ፤</para>
  <para style="q2" vid="PSA 23:4">ኡሌንኬቲፊ ቦኩንኬ ነ ጀጀቤሱ።<verse eid="PSA 23:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 23:5"/>አት ኡቱመ ዲኖትንኮ እላለኑ</para>
  <para style="q2" vid="PSA 23:5">ፉለኮ ዱረት ማዲ ና ቆጴስተ።</para>
  <para style="q1" vid="PSA 23:5">መታኮ ዘይቲ ድብደ፤</para>
  <para style="q2" vid="PSA 23:5">ጦፎንኮስ ጉቱ እራን ዸንገለኣዸ።<verse eid="PSA 23:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 23:6"/>ዹጉማን ጋሩማንኬቲፊ አራርኬ፣</para>
  <para style="q2" vid="PSA 23:6">በረ ጅሬኘኮቲ ሁንደ ነ ዱካ ቡኡ፤</para>
  <para style="q2" vid="PSA 23:6">አንስ በረ በራን፣ መነ <char style="nd">ዋቀዮ</char> ኬሰ ነንጅራዸ።<verse eid="PSA 23:6"/></para>
  <chapter eid="PSA 23"/>
  <chapter number="24" style="c" sid="PSA 24"/>
  <para style="cl">ፋርፈትና 24</para>
  <para style="ms1">ፋርፈትና ሞቲ ኡልፍናቲፍ ፋርፈተሜ</para>
  <para style="d">ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 24:1"/>ለፍቲፊ ወን ለፈረ ጅሩ ሁንድኑ፣</para>
  <para style="q2" vid="PSA 24:1">አዱኛፊ ወን እሼ ኬሰ ጅራቱ ሁንድኑስ ከን <char style="nd">ዋቀዮት</char>፤<verse eid="PSA 24:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 24:2"/>እን ገላኖተረት እሼ ሁንዴሴራቲ፤</para>
  <para style="q2" vid="PSA 24:2">ብሻንረስ እሼ ዻቤረ።<verse eid="PSA 24:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 24:3"/>ኤኙቱ ቱሉ <char style="nd">ዋቀዮት</char> ኦል በአ?</para>
  <para style="q2" vid="PSA 24:3">እዶሳ ቁልቁሉ ሰነስ ኤኙቱ ዻበተ?<verse eid="PSA 24:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 24:4"/>ነመ ሀርከ ቁልቁሉፊ ገራ ቁልቁሉ ቀቡ፣</para>
  <para style="q2" vid="PSA 24:4">ነመ ሉቡሳ ገረ ዋቀ ቶልፈማት ኦል ህንካፍኔ</para>
  <para style="q2" vid="PSA 24:4">ዮካን ነመ ሶባን ህንከከትኔዸ።<verse eid="PSA 24:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 24:5"/>እን <char style="nd">ዋቀዮ</char> ብራ ኤበ፣</para>
  <para style="q2" vid="PSA 24:5">ዋቀ ፈይሳሳ ብራሞ ቀጄሉማ ንአርገተ።<verse eid="PSA 24:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 24:6"/>ዸሎትን ኩን ዸሎተ ወረ እሰ በርባደኒት፤</para>
  <para style="q2" vid="PSA 24:6">ከን ዸሎተ ወረ ፉለ ዋቀ ያቆብ በርባደኒት።<verse eid="PSA 24:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 24:7"/>ያ ከሮተነነ፣ መታኬሰን ኦል ቀበዻ፤</para>
  <para style="q2" vid="PSA 24:7">እስንስ በልበለወን ዱሪ፣</para>
  <para style="q2" vid="PSA 24:7">አከ ሞቲን ኡልፍና ኦል ገሉፍ ኦል ቀበማ።<verse eid="PSA 24:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 24:8"/>ሞቲን ኡልፍና ኩን ኤኙ?</para>
  <para style="q2" vid="PSA 24:8">
    <char style="nd">ዋቀዮ</char> ጀባፊ ሁምነ ቀቤሰ፣</para>
  <para style="q2" vid="PSA 24:8">
    <char style="nd">ዋቀዮ</char> እሰ ወራነ ኬሰትስ ሁምነ ቀቡ ሰናዸ።<verse eid="PSA 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 24:9"/>ያ ከሮተነነ፣ መታኬሰን ኦል ቀበዻ፤</para>
  <para style="q2" vid="PSA 24:9">እስንስ በልበለወን ዱሪ አከ ሞቲን ኡልፍና ኦል ገሉፍ</para>
  <para style="q2" vid="PSA 24:9">መታኬሰን ኦል ቀበዻ።<verse eid="PSA 24:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 24:10"/>ሞቲን ኡልፍና ኩን ኤኙ?</para>
  <para style="q2" vid="PSA 24:10">
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ ሱን፣</para>
  <para style="q2" vid="PSA 24:10">እን ሞቲ ኡልፍናት።<verse eid="PSA 24:10"/></para>
  <chapter eid="PSA 24"/>
  <chapter number="25" style="c" sid="PSA 25"/>
  <para style="cl">ፋርፈትና 25</para>
  <para style="ms1">ከዸትና ዬሮ በላ</para>
  <para style="d">ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 25:1"/>ያ <char style="nd">ዋቀዮ</char>፣ አን ሉቡኮ ገረኬት</para>
  <para style="q2" vid="PSA 25:1">ኦል ነንቀበ።<verse eid="PSA 25:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 25:2"/>ያ ዋቀኮ አን ስን አመነዸ።</para>
  <para style="q2" vid="PSA 25:2">አት ነ ህንቃኔስን፤</para>
  <para style="q2" vid="PSA 25:2">አከ ዲኖትንኮ ነ ሞአተንስ ህንጎዽን።<verse eid="PSA 25:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 25:3"/>ነምን ስ ኤገቱ ቶኮዩ</para>
  <para style="q2" vid="PSA 25:3">ዮምዩ ህንቃኔፈሙ፤</para>
  <para style="q1" vid="PSA 25:3">ወር ሰበቢ መሌ የከ ሆጄተን</para>
  <para style="q2" vid="PSA 25:3">ገሩ ንቃኔፈሙ።<verse eid="PSA 25:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 25:4"/>ያ <char style="nd">ዋቀዮ</char>፣ ከራኬ ነ አርግሲስ፤</para>
  <para style="q2" vid="PSA 25:4">ዳንዲኬስ ነ በርሲስ፤<verse eid="PSA 25:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 25:5"/>አት ዋቀ ፈይሳኮ ዋን ታቴፍ፣</para>
  <para style="q2" vid="PSA 25:5">ዹጋኬቲን ነ ዱረ ቡእ፤ ነ በርሲስ፤</para>
  <para style="q2" vid="PSA 25:5">አንስ ጉያ ጉቱ ስን ኤገዸ።<verse eid="PSA 25:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 25:6"/>ያ <char style="nd">ዋቀዮ</char>፣ አራረኬቲፊ ጃለለኬ ያደዹ፤</para>
  <para style="q2" vid="PSA 25:6">እሳን ዱሩማ ጀልቀበኒ ጅሩቲ።<verse eid="PSA 25:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 25:7"/>ጩቡ አፋንኮቲ</para>
  <para style="q2" vid="PSA 25:7">ዮካን ዶጎጎረኮ ህንያደትን፤</para>
  <para style="q1" vid="PSA 25:7">ያ <char style="nd">ዋቀዮ</char>፣ ጋሩማኬቲፍ ጄዺቲ</para>
  <para style="q2" vid="PSA 25:7">አኩመ አራረኬቲት ነ ያደዹ።<verse eid="PSA 25:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 25:8"/>
    <char style="nd">ዋቀዮ</char> ጋሪዸ፤ ቶላዸስ፤</para>
  <para style="q2" vid="PSA 25:8">ከናፉ እን ዳንዲሳ ጩበሞተት አርግሲሰ።<verse eid="PSA 25:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 25:9"/>ወረ ገድ ኦፍ ቀበን ዋን ቀጄላ ተኤን ጌጌሰ፤</para>
  <para style="q2" vid="PSA 25:9">ከራሳስ እሳን በርሲሰ።<verse eid="PSA 25:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 25:10"/>ከራን <char style="nd">ዋቀዮ</char> ሁንድኑ</para>
  <para style="q2" vid="PSA 25:10">ወረ ከኩሳቲፊ ሴረሳ ኤገኒፍ አራራፊ ዹጋዸ።<verse eid="PSA 25:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 25:11"/>ያ <char style="nd">ዋቀዮ</char>፣ ጩቡንኮ ጉዳ ተኡዩ</para>
  <para style="q2" vid="PSA 25:11">መቃኬቲፍ ጄዺቲ ዺፈመ ና ጎዽ።<verse eid="PSA 25:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 25:12"/>ነምን <char style="nd">ዋቀዮን</char> ሶዳቱ ኤኙ?</para>
  <para style="q2" vid="PSA 25:12">ዋቀዮ ከራ እን ፍለቹ ቀቡ እሰ አርግሲሰ።<verse eid="PSA 25:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 25:13"/>ሉቡንሳ በዻዹማዻን ጅራት፤</para>
  <para style="q2" vid="PSA 25:13">ሰኚንሳስ ለፈ ዻለ።<verse eid="PSA 25:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 25:14"/>
    <char style="nd">ዋቀዮ</char> እጪቲሳ ወረ እሰ ሶዳተን ዱራ ህንዾክሱ፤</para>
  <para style="q2" vid="PSA 25:14">ከኩሳሌ እሳን ቤክስሰ።<verse eid="PSA 25:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 25:15"/>እጅኮ ዬሮ ሁንደ ገረ <char style="nd">ዋቀዮ</char> እላለ፤</para>
  <para style="q2" vid="PSA 25:15">እን ሚለኮ ክዮ ኬሳ ንባሳቲ።<verse eid="PSA 25:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 25:16"/>ገረኮት ገረገል፤ ገራስ ና ላፍ፤</para>
  <para style="q2" vid="PSA 25:16">አን ኮጳኮን ጅራቲ፤ ረከታዸስ።<verse eid="PSA 25:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 25:17"/>ያዶን ገራኮቲ ባይአቴረ፤</para>
  <para style="q2" vid="PSA 25:17">ዽጵነኮ ኬሳስ ነ ባስ።<verse eid="PSA 25:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 25:18"/>ዽጵነኮቲፊ ረክነኮ እላል፤</para>
  <para style="q2" vid="PSA 25:18">ጩቡኮ ሁንደ ና ዺስ።<verse eid="PSA 25:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 25:19"/>አከ ዲኖትንኮ ባይአተን፣</para>
  <para style="q2" vid="PSA 25:19">ሀመም አከ ጭምሰኒ ነ ጅበን አርግ!<verse eid="PSA 25:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 25:20"/>ሉቡኮ ኤግ፤ ነ ኦልችስ፤</para>
  <para style="q2" vid="PSA 25:20">ሰበቢ አን ኮሉ ስት ገሌፍ፣</para>
  <para style="q2" vid="PSA 25:20">አከ አን ቃነኡ ነ ህንጎዽን።<verse eid="PSA 25:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 25:21"/>ዋን አን ስ ኤገዹፍ፣ አመነሙማፊ</para>
  <para style="q2" vid="PSA 25:21">ቀጄሉማን አነ ሃኤገን።<verse eid="PSA 25:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 25:22"/>ያ ዋቀዮ፣ ረክነሳ ሁንዱማ ኬሳ</para>
  <para style="q2" vid="PSA 25:22">እስራኤልን ፉር!<verse eid="PSA 25:22"/></para>
  <chapter eid="PSA 25"/>
  <chapter number="26" style="c" sid="PSA 26"/>
  <para style="cl">ፋርፈትና 26</para>
  <para style="ms1">ከዸትና ነመ ቀጄላ</para>
  <para style="d">ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 26:1"/>ያ <char style="nd">ዋቀዮ</char>፣ ሰበቢ አን ጅሬኘ ህርእነ</para>
  <para style="q2" vid="PSA 26:1">ህንቀብኔ ጅራዼፍ፣ አት ና ሙርቴስ፤</para>
  <para style="q1" vid="PSA 26:1">አንስ ኡቱ አሲፊ አች ህንራፈምን፣</para>
  <para style="q2" vid="PSA 26:1">
    <char style="nd">ዋቀዮን</char> አመነዼረ።<verse eid="PSA 26:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 26:2"/>ያ <char style="nd">ዋቀዮ</char>፣ ቆሪቲ ነ እላል፤</para>
  <para style="q2" vid="PSA 26:2">ገራኮፊ ቀልቢኮ ቆር፤<verse eid="PSA 26:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 26:3"/>ጃለልኬ ከን ህንጌደረምኔ ሱን እጀኮ ዱረ ጅራቲ፤</para>
  <para style="q2" vid="PSA 26:3">አንስ ዹጋኬቲን ነንዴዴብአ።<verse eid="PSA 26:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 26:4"/>አን ወረ ነመ ጎዎምሰን ወጅን ህንታኡ፣</para>
  <para style="q2" vid="PSA 26:4">ዮካን ፈኬስቶተ ወጅን ቶኩማ ህንቀባዹ፤<verse eid="PSA 26:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 26:5"/>አን ወልዳ ወረ ሀምነ ሆጄተኒ ነንጅበ፤</para>
  <para style="q2" vid="PSA 26:5">ሀሞተ ወጅንስ ህንታኡ።<verse eid="PSA 26:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 26:6"/>ያ <char style="nd">ዋቀዮ</char>፣ አን ሀርከኮ ቁልቁሉማዻን ነንዽቀዸ፤</para>
  <para style="q2" vid="PSA 26:6">እዶ ኣርሳኬቲረስ ነንናነአ።<verse eid="PSA 26:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 26:7"/>ፋርፈትና ገለታ ጉድሴ ነንፋርፈዸ፤</para>
  <para style="q2" vid="PSA 26:7">ድንቂ ሆጂኬቲ ሁንደ ነንኦዴሰ።<verse eid="PSA 26:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 26:8"/>ያ <char style="nd">ዋቀዮ</char>፣ መነ አት ኬሰ ጅራቱ፣</para>
  <para style="q2" vid="PSA 26:8">እዶ ኡልፍንኬ ጅሩስ ነንጃለዸ።<verse eid="PSA 26:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 26:9"/>ሉቡኮ ጩበሞተ ወጅን፣ ጅሬኘኮስ</para>
  <para style="q2" vid="PSA 26:9">ወረ ዺገ ዸንገላሰን ወጅን ህንበሌስን፤<verse eid="PSA 26:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 26:10"/>ወረ ሀርከሳኒ ኬሰ ከሮር ጀልእና ጅሩ</para>
  <para style="q2" vid="PSA 26:10">ከኔን ሀርክሳኒ ምርጋ መተኣዻን ጉተሜ ወጅን ነ ህንበሌስን።<verse eid="PSA 26:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 26:11"/>አን ገሩ ጅሬኘ ህርእነ ህንቀብኔ ነንጅራዸ፤</para>
  <para style="q2" vid="PSA 26:11">አት ነ ፉር፤ አራረስ ና ቡስ።<verse eid="PSA 26:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 26:12"/>ሚልኮ ለፈ ወል ቅጤረ ዻበተ፤</para>
  <para style="q2" vid="PSA 26:12">ወልዳ ጉዳ ኬሰትስ <char style="nd">ዋቀዮን</char> ነንጀጀዸ።<verse eid="PSA 26:12"/></para>
  <chapter eid="PSA 26"/>
  <chapter number="27" style="c" sid="PSA 27"/>
  <para style="cl">ፋርፈትና 27</para>
  <para style="ms1">እጀ ጀብነ ነመ ዋቀዮ</para>
  <para style="d">ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 27:1"/>
    <char style="nd">ዋቀዮ</char> እብሳኮቲፊ ፈይነኮት፤</para>
  <para style="q2" vid="PSA 27:1">አን ኤኙነን ሶዳዸ?</para>
  <para style="q1" vid="PSA 27:1">
    <char style="nd">ዋቀዮ</char> ደኦ ጅሬኘኮቲት፤</para>
  <para style="q2" vid="PSA 27:1">ኤኙቱ ነ ሶዳችሰ?<verse eid="PSA 27:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 27:2"/>ነሞትን ሀሞን ዮሙ</para>
  <para style="q2" vid="PSA 27:2">ፎንኮ ኛቹዻፍ ነት ዹፈን፣</para>
  <para style="q1" vid="PSA 27:2">ዲኖትንኮፊ አመጃጆንኮ</para>
  <para style="q2" vid="PSA 27:2">ዮሙ ነ ሚዹፍ ነት ከአን፣ ጉፈተኒ ኩፉ።<verse eid="PSA 27:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 27:3"/>ዮ ዱል ነ መርሴሌ፣</para>
  <para style="q2" vid="PSA 27:3">ገራንኮ ህንሶዳቱ፤</para>
  <para style="q1" vid="PSA 27:3">ዮ ወራን ነት በነሜሌ</para>
  <para style="q2" vid="PSA 27:3">አን ህንራፈሙ።<verse eid="PSA 27:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 27:4"/>አን ዋን ቶኮ <char style="nd">ዋቀዮን</char> ነንከዸዸ፤</para>
  <para style="q2" vid="PSA 27:4">ዋን ከነስ ነንበርባደ፦</para>
  <para style="q1" vid="PSA 27:4">ኩንስ በረ ጅሬኘኮቲ ጉቱ</para>
  <para style="q2" vid="PSA 27:4">መነ <char style="nd">ዋቀዮ</char> ኬሰ ጅራቹ፣</para>
  <para style="q1" vid="PSA 27:4">ሚዸግነ <char style="nd">ዋቀዮ</char> እላሉፊ መነ ቁልቁሉማሳ</para>
  <para style="q2" vid="PSA 27:4">ኬሰት እሰ ከዸቹዸ።<verse eid="PSA 27:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 27:5"/>እን ጉያ ረክና</para>
  <para style="q2" vid="PSA 27:5">እዶ ኦፊ ጅራቱ ነ ካአታቲ፤</para>
  <para style="q1" vid="PSA 27:5">ደኦ ዱንካነሳ ጀለ ነ ዾክሰ፤</para>
  <para style="q2" vid="PSA 27:5">ከታ ጉባትስ ኦል ነ ባሰ።<verse eid="PSA 27:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 27:6"/>ዮሙስ ዲኖተ ነ መርሰኒ ኦልት</para>
  <para style="q2" vid="PSA 27:6">መታንኮ ኦል ጄዸ፤</para>
  <para style="q1" vid="PSA 27:6">ዱንካነሳ ኬሰትሌ እልሌዻን ኣርሳ ነንዽኤሰ፤</para>
  <para style="q2" vid="PSA 27:6">
    <char style="nd">ዋቀዮፍ</char> ነንፋርፈዸ፤ ነንዌድሰስ።<verse eid="PSA 27:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 27:7"/>ያ <char style="nd">ዋቀዮ</char>፣ ዮሙ አን ስ ዋመዹ፣ ሰገሌኮ ዸገእ፤</para>
  <para style="q2" vid="PSA 27:7">ናፍ አራረም፤ ዴቢስ ናፍ ኬን።<verse eid="PSA 27:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 27:8"/>ዮሙ አት፣ “ፉለኮ በርባዳ!” ጄቴት፣</para>
  <para style="q2" vid="PSA 27:8">ገራንኮ፣ “ያ <char style="nd">ዋቀዮ</char>፣ አን ፉለኬ ነንበርባደ” ሲን ጄዸ።<verse eid="PSA 27:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 27:9"/>ፉለኬ ነ ዱራ ህንዾክስን፤</para>
  <para style="q2" vid="PSA 27:9">ኣርቴ ተጃጅላኬ ኦፍራ ህንዴብስን፤</para>
  <para style="q2" vid="PSA 27:9">አት ገርጋራኮ ታቴርተ።</para>
  <para style="q1" vid="PSA 27:9">ያ ዋቀዮ፣ ፈይሳኮ፣</para>
  <para style="q2" vid="PSA 27:9">ነ ህንገትን፤ ነ ህንዺስንስ።<verse eid="PSA 27:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 27:10"/>ዮ አባንኮቲፊ ሃትኮ ነ ዺሰንሌ፣</para>
  <para style="q2" vid="PSA 27:10">
    <char style="nd">ዋቀዮ</char> ነ ስመተ።<verse eid="PSA 27:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 27:11"/>ያ <char style="nd">ዋቀዮ</char>፣ ከራኬ ነ በርሲስ፤</para>
  <para style="q2" vid="PSA 27:11">ሰበቢ አን ዲኖተ ባይኤ ቀቡፍ</para>
  <para style="q2" vid="PSA 27:11">ዳንዲ ቀጄላረ ነ ቡስ።<verse eid="PSA 27:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 27:12"/>ፌዺ ዲኖተኮቲት ደበርስቴ ነ ህንኬንን፤</para>
  <para style="q2" vid="PSA 27:12">ዹገ ባቶትን ሶብዱን ነረት ከአኒሩቲ፤</para>
  <para style="q2" vid="PSA 27:12">እሳንስ ሀፉረ ጀልእና ባፈቱ።<verse eid="PSA 27:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 27:13"/>አንስ ብየ ጅራቶታ ኬሰት</para>
  <para style="q2" vid="PSA 27:13">ጋሩማ <char style="nd">ዋቀዮ</char> አከን አርጉ</para>
  <para style="q2" vid="PSA 27:13">አመዩ ነንአመነ።<verse eid="PSA 27:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 27:14"/>
    <char style="nd">ዋቀዮን</char> ኤገዹ፤</para>
  <para style="q2" vid="PSA 27:14">ጭም፤ ጀባዹስ፤</para>
  <para style="q2" vid="PSA 27:14">
    <char style="nd">ዋቀዮን</char> ኤገዹ።<verse eid="PSA 27:14"/></para>
  <chapter eid="PSA 27"/>
  <chapter number="28" style="c" sid="PSA 28"/>
  <para style="cl">ፋርፈትና 28</para>
  <para style="ms1">ከዸትናፊ ገለተ</para>
  <para style="d">ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 28:1"/>ያ <char style="nd">ዋቀዮ</char>፣ ከታኮ፣ አን ስን ዋመዸ፤</para>
  <para style="q2" vid="PSA 28:1">አት ነ ጀላ ህንድድን።</para>
  <para style="q1" vid="PSA 28:1">ዮ አት ነ ጀላ ድዴ፣</para>
  <para style="q2" vid="PSA 28:1">አን አከ ወረ ቦለ ቡአኒ ነንተአ።<verse eid="PSA 28:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 28:2"/>ዮሙ አን ገርጋርሳፍ ስ ዋመዼ ሀርከኮሌ</para>
  <para style="q2" vid="PSA 28:2">ገረ እዶ ቁልቁሉማኬ</para>
  <para style="q1" vid="PSA 28:2">ከን ዋን ሁንዱማ ጫላ ቁልቁሉ ተኤ</para>
  <para style="q2" vid="PSA 28:2">ሰናት ኦል ካፈዹ፣ ሰገሌ ከዸትናኮ ና ዸገእ።<verse eid="PSA 28:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 28:3"/>ነሞተ ሀሞ ወረ ጀልእነ ሆጄተን ወጅን፣</para>
  <para style="q2" vid="PSA 28:3">ወረ ገራሳኒት ሀምነ ቀበተኒ</para>
  <para style="q1" vid="PSA 28:3">ኦሎተሳኒ ወጅን ገሩ</para>
  <para style="q2" vid="PSA 28:3">ነጋ ዱበተን ወጅን ነ ህንበሌስን።<verse eid="PSA 28:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 28:4"/>አከ ሆጂሳኒት፣</para>
  <para style="q2" vid="PSA 28:4">አኩመ ሆጂሳኒ ሀማ ሰናትስ ዴብሲፍ፤</para>
  <para style="q1" vid="PSA 28:4">አኩመ ሆጂ ሀርከሳኒት ኬኒፍ፤</para>
  <para style="q2" vid="PSA 28:4">ገቲሳኒፍ መሉ እሳኑመት ዴብስ።<verse eid="PSA 28:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 28:5"/>ሰበቢ እሳን ሆጂ <char style="nd">ዋቀዮ</char>፣</para>
  <para style="q2" vid="PSA 28:5">ዮካን ዋን ሀርክሳ ሆጄቴ ህንከበጅኔፍ</para>
  <para style="q1" vid="PSA 28:5">እን እሳን ዲገ፤</para>
  <para style="q2" vid="PSA 28:5">ዴብሴስ እሳን ህንእጃሩ።<verse eid="PSA 28:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 28:6"/>
    <char style="nd">ዋቀዮ</char> ሃኤብፈሙ!</para>
  <para style="q2" vid="PSA 28:6">እን እየ ከዸትናኮቲ ና ዸገኤራቲ።<verse eid="PSA 28:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 28:7"/>
    <char style="nd">ዋቀዮ</char> ጀብነኮፊ ጋቸነኮት፤</para>
  <para style="q2" vid="PSA 28:7">ገራንኮ እሰ አመነተ፤ አንስ ገርጋርሰ አርገዼረ።</para>
  <para style="q1" vid="PSA 28:7">ገራንኮ ባይኤ ገመደ፤</para>
  <para style="q2" vid="PSA 28:7">አንስ ፋርፈናዻን እሰ ነንገለቴፈዸ።<verse eid="PSA 28:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 28:8"/>
    <char style="nd">ዋቀዮ</char> ጀብነ ሰበሳት፤</para>
  <para style="q2" vid="PSA 28:8">ድበማሳቲፍስ ደኦ ፈይናት።<verse eid="PSA 28:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 28:9"/>ሰበኬ ፈይስ፤ ዻለኬስ ኤብስ፤</para>
  <para style="q2" vid="PSA 28:9">ትክሴሳኒ ተኢ በረ በራን እሳን ባዹ።<verse eid="PSA 28:9"/></para>
  <chapter eid="PSA 28"/>
  <chapter number="29" style="c" sid="PSA 29"/>
  <para style="cl">ፋርፈትና 29</para>
  <para style="ms1">ፋርፈትና ጎፍታ ቡቤቲፍ ዽኣቴ</para>
  <para style="d">ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 29:1"/>እስን ጀጀቤዪን፣ <char style="nd">ዋቀዮፍ</char> ፍዳ፤</para>
  <para style="q2" vid="PSA 29:1">ኡልፍናፊ ጀብነ <char style="nd">ዋቀዮፍ</char> ፍዳ።<verse eid="PSA 29:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 29:2"/>ኡልፍነ መቃሳቲፍ መሉ <char style="nd">ዋቀዮፍ</char> ኬና፤</para>
  <para style="q2" vid="PSA 29:2">እዶ ቁልቁሉማሳት <char style="nd">ዋቀዮን</char> ዋቄፈዻ።<verse eid="PSA 29:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 29:3"/>ሰገሌን <char style="nd">ዋቀዮ</char> ብሻኖተረ ጅረ፤</para>
  <para style="q2" vid="PSA 29:3">ዋቅን ኡልፍና ንቀቀዌሰአ፤</para>
  <para style="q2" vid="PSA 29:3">
    <char style="nd">ዋቀዮ</char> ብሻኖተ ባይኤረት ንቀቀዌሰአ።<verse eid="PSA 29:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 29:4"/>ሰገሌን <char style="nd">ዋቀዮ</char> ሁምነ ቀበ፤</para>
  <para style="q2" vid="PSA 29:4">ሰገሌን <char style="nd">ዋቀዮ</char> ሱረ ቀቤሰ።<verse eid="PSA 29:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 29:5"/>ሰገሌን <char style="nd">ዋቀዮ</char> ብርብርሰ ንጨብሰ፤</para>
  <para style="q2" vid="PSA 29:5">
    <char style="nd">ዋቀዮ</char> ብርብርሰ ልባኖን ንጨጨብሰ።<verse eid="PSA 29:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 29:6"/>እን ልባኖንን አከ ጀቢት፣</para>
  <para style="q2" vid="PSA 29:6">ሲርዮንንሞ አከ ድብቸ ገፈርሳት ንኡታልችሰ።<verse eid="PSA 29:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 29:7"/>ሰገሌን <char style="nd">ዋቀዮ</char></para>
  <para style="q2" vid="PSA 29:7">በለቄሰ በከካቲን ሩኩተ።<verse eid="PSA 29:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 29:8"/>ሰገሌን <char style="nd">ዋቀዮ</char> ገሞጂ ሶቾሰ፤</para>
  <para style="q2" vid="PSA 29:8">
    <char style="nd">ዋቀዮ</char> ገሞጂ ቃዴሽ ሶቾሰ።<verse eid="PSA 29:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 29:9"/>ሰገሌን <char style="nd">ዋቀዮ</char> ቅልጡ ምጪረ፤</para>
  <para style="q2" vid="PSA 29:9">ቦሶነስ ቁላት ሀምብሰ።</para>
  <para style="q1" vid="PSA 29:9">ሁንድኑስ መነ ቁልቁሉማሳ ኬሰት፣ “ኡልፍነ!” ጄዼ እየ።<verse eid="PSA 29:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 29:10"/>
    <char style="nd">ዋቀዮ</char> ሎላ በዲሳቲን ኦልት ቴሶሳረ ታአ፤</para>
  <para style="q2" vid="PSA 29:10">
    <char style="nd">ዋቀዮ</char> ሞቲ ተኤ በረ በራን ቴሶሳረ ታአ።<verse eid="PSA 29:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 29:11"/>
    <char style="nd">ዋቀዮ</char> ሰበሳቲፍ ጀብነ ኬነ፤</para>
  <para style="q2" vid="PSA 29:11">
    <char style="nd">ዋቀዮ</char> ሰበሳ ነጋዻን ኤብሰ።<verse eid="PSA 29:11"/></para>
  <chapter eid="PSA 29"/>
  <chapter number="30" style="c" sid="PSA 30"/>
  <para style="cl">ፋርፈትና 30</para>
  <para style="ms1">ገለተ ነመ አፋን ዱኣቲ ዴብኤ</para>
  <para style="d">ፋርፈትና ኤበ መነ ቁልቁሉማቲፍ ፋርፈተሜ። ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 30:1"/>ያ <char style="nd">ዋቀዮ</char>፣ ሰበቢ አት ኦል ነ ፉቴ</para>
  <para style="q2" vid="PSA 30:1">አከ ዲኖትንኮ ነት ህንገመኔ ጎቴፍ፣</para>
  <para style="q2" vid="PSA 30:1">አን ስን ጀጀዸ።<verse eid="PSA 30:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 30:2"/>ያ <char style="nd">ዋቀዮ</char> ዋቀኮ፣</para>
  <para style="q2" vid="PSA 30:2">አን ገርጋርሳፍ ስን ዋመዼ፤ አትስ ነ ፈይፍቴ።<verse eid="PSA 30:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 30:3"/>ያ <char style="nd">ዋቀዮ</char>፣ አት ሉቡኮ ሲኦሊ ባፍቴ፤</para>
  <para style="q2" vid="PSA 30:3">አከ አን ቦለ ህንቡኔ ጎቴስ ነ ጅራችፍቴ።<verse eid="PSA 30:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 30:4"/>እስን ቁልቁሎንሳ፣ ፋርፈናዻን <char style="nd">ዋቀዮን</char> ጀጀዻ፤</para>
  <para style="q2" vid="PSA 30:4">መቃሳ ቁልቁሉ ሰናፍስ ገለተ ገልቻ።<verse eid="PSA 30:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 30:5"/>ዼከምስሳ ሀመ ልጵሱ እጃት፤</para>
  <para style="q2" vid="PSA 30:5">ጋሩማንሳሞ በረ ጅሬኛ ጉቱዻፍ ቱረ፤</para>
  <para style="q1" vid="PSA 30:5">ቦእች ገልገለ ቶኮ ቆፋፍ ቱረ፤</para>
  <para style="q2" vid="PSA 30:5">ገነመ ገሩ እልሌቱ ተአ።<verse eid="PSA 30:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 30:6"/>አንስ ዮሙን ነጋ አርገዼት፣</para>
  <para style="q2" vid="PSA 30:6">“አን ጎንኩማ ህንራፈሙ” ነንጄዼ።<verse eid="PSA 30:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 30:7"/>ያ <char style="nd">ዋቀዮ</char>፣ አት ጃለለኬቲን</para>
  <para style="q2" vid="PSA 30:7">አከ ቱሉ ጀባት ነ ዻብዴ፤</para>
  <para style="q1" vid="PSA 30:7">ዬሮ አት ፉለኬ ነ ዱራ ዾክስቴት ገሩ</para>
  <para style="q2" vid="PSA 30:7">ናሱቱ ነ ቀበቴ።<verse eid="PSA 30:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 30:8"/>ያ <char style="nd">ዋቀዮ</char>፣ አን ስን ዋመዸ፤</para>
  <para style="q2" vid="PSA 30:8">አን ገረ ጎፍታት አከነ ጄዼ አራራፍ ነንእየዸ፦<verse eid="PSA 30:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 30:9"/>“ዱኡኮ ኬሳ፣ ቦለ ቡኡኮ ኬሳስ</para>
  <para style="q2" vid="PSA 30:9">ፋይዳ ማሊቱ አርገመ?</para>
  <para style="q1" vid="PSA 30:9">ብዮን ስ ገለቴፈታ?</para>
  <para style="q2" vid="PSA 30:9">አመነሙማኬስ ንኦዴሳ?<verse eid="PSA 30:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 30:10"/>ያ <char style="nd">ዋቀዮ</char> ነ ዸገእ፤ ነ ማርስ፤</para>
  <para style="q2" vid="PSA 30:10">ያ <char style="nd">ዋቀዮ</char>፣ ገርጋርሰ ና ተእ።”<verse eid="PSA 30:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 30:11"/>አት ቦእቸኮ ሹብሱት ጌደርቴ፤</para>
  <para style="q2" vid="PSA 30:11">ወያ ገዳ ነራ ባፍቴ ገመቹ ነት ኡውፍቴ፤<verse eid="PSA 30:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 30:12"/>ኩንስ አከ ሉቡንኮ ፋርፈናዻን ስ ጀጀቱፊ <optbreak/> አከ እሼን ህንጨልእስኔፊዸ።</para>
  <para style="q2" vid="PSA 30:12">ያ <char style="nd">ዋቀዮ</char> ዋቀኮ፣ አን በረ በራን ስን ገለቴፈዸ።<verse eid="PSA 30:12"/></para>
  <chapter eid="PSA 30"/>
  <chapter number="31" style="c" sid="PSA 31"/>
  <para style="cl">ፋርፈትና 31</para>
  <para style="ms1">ከዸትና ዬሮ ረክና</para>
  <para style="mr">
    <ref loc="PSA 31:1-4">31፥1‑4</ref> ኩወፈ – <char style="xt"><ref loc="PSA 71:1-3">ፋር 71፥1‑3</ref></char></para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 31:1"/>ያ <char style="nd">ዋቀዮ</char>፣ አን ኮሉ ስት ገሌረ፤</para>
  <para style="q2" vid="PSA 31:1">አት ጎንኩማ ነ ህንቃኔስን፤</para>
  <para style="q2" vid="PSA 31:1">ቀጄሉማኬቲን ነ ኦልች።<verse eid="PSA 31:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 31:2"/>ጉረኬ ገረኮት ቀብ፤ ደፊቲ ነ ኦልች፤</para>
  <para style="q2" vid="PSA 31:2">ከታ አን እት ኮሉ ገሉ ና ተእ፤</para>
  <para style="q2" vid="PSA 31:2">ነ ኦልቹዻፍስ ደኦ ጀባ ና ተእ።<verse eid="PSA 31:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 31:3"/>አት ዋን ከታኮፊ ደኦኮ ታቴፍ፣</para>
  <para style="q2" vid="PSA 31:3">መቃኬቲፍ ጄዺቲ ነ ቀጄልች፤ ከራረስ ነ ቡስ።<verse eid="PSA 31:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 31:4"/>አት እዶ አን እት በቀዹ ዋን ታቴፍ፣</para>
  <para style="q2" vid="PSA 31:4">ክዮ ዲኖትንኮ ና ካአን ኬሳ ነ ባስ።<verse eid="PSA 31:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 31:5"/>አን ሀፉረኮ ደበርሴ ሀርከ ኬን ኬነዸ፤</para>
  <para style="q2" vid="PSA 31:5">ያ <char style="nd">ዋቀዮ</char> ዋቀ ዹጋ፣ አት ነ ፉር።<verse eid="PSA 31:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 31:6"/>አን ወረ ዋቆተ ፋይዳ ህንቀብኔ አብደተን ነንጅበ፤</para>
  <para style="q2" vid="PSA 31:6">
    <char style="nd">ዋቀዮን</char> ገሩ ነንአመነዸ።<verse eid="PSA 31:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 31:7"/>አን ጃለለኬ ከን ህንጌደረምኔ ሰነት ነንገመደ፤ ነንእልልቸስ፤</para>
  <para style="q2" vid="PSA 31:7">አት ዽጵነኮ አርግቴርታቲ፤</para>
  <para style="q2" vid="PSA 31:7">ረክነ ሉቡኮቲሌ ቤክቴርተ።<verse eid="PSA 31:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 31:8"/>አት ደበርስቴ ዲነት ነ ህንኬንኔ፤</para>
  <para style="q2" vid="PSA 31:8">ሚለኮስ እዶ በልኣረ ዻብዴርተ።<verse eid="PSA 31:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 31:9"/>ያ <char style="nd">ዋቀዮ</char>፣ አን ዽጵነኬሰን ጅራቲ ነ ባስ፤</para>
  <para style="q2" vid="PSA 31:9">እጅኮ ገዳን፣ ሉቡንኮፊ ዸግንኮ ገዳን ደዸበኒሩ።<verse eid="PSA 31:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 31:10"/>ጅሬኝኮ ገዳን፣ ኡሙሪንኮ ኣዱዻን ዹሜረ፤</para>
  <para style="q2" vid="PSA 31:10">ጀብንኮ ሰበቢ ዽጵነኮቲቲፍ ላፌረ፤</para>
  <para style="q2" vid="PSA 31:10">ለፌንኮስ ጡጠሜረ።<verse eid="PSA 31:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 31:11"/>ሰበቢ ዲኖተኮ ሁንዳቲፍ፣</para>
  <para style="q2" vid="PSA 31:11">አን ኦሎተኮ ብረት ዋን ሶዳችሳ፣</para>
  <para style="q1" vid="PSA 31:11">ምቾተኮ ብረትሞ ዋን ጅብሲሳ ተኤረ፤</para>
  <para style="q2" vid="PSA 31:11">ወር ከራረት ነ አርገንስ ነ በቀቱ።<verse eid="PSA 31:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 31:12"/>አን አኩመ ነመ ዱኤት እራንፈተሜረ፤</para>
  <para style="q2" vid="PSA 31:12">አኩመ ቆዳ ጨባስ ነንተኤ።<verse eid="PSA 31:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 31:13"/>አሳሰ ነሞተ ባይኤ ነንዸገኣቲ፤</para>
  <para style="q2" vid="PSA 31:13">ከለቲ ሁንዳን ሶዳቱ ጅረ!</para>
  <para style="q1" vid="PSA 31:13">እሳን ነት መለተኒ</para>
  <para style="q2" vid="PSA 31:13">ሉቡኮ በሌሱፍ መርአተን።<verse eid="PSA 31:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 31:14"/>ያ <char style="nd">ዋቀዮ</char>፣ አን ገሩ ስን አመነዸ፤</para>
  <para style="q2" vid="PSA 31:14">“አት ዋቀኮት” ነንጄዸ።<verse eid="PSA 31:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 31:15"/>በርኮ ስ ሀርከ ጅረ፤ ዲኖተኮ ጀላ፣</para>
  <para style="q2" vid="PSA 31:15">ወረ ነ አርአተን ሀርካስ ነ ባስ።<verse eid="PSA 31:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 31:16"/>ፉልኬ ተጃጅላኬረት ሃእፉ፤</para>
  <para style="q2" vid="PSA 31:16">ጃለለኬ ከን ህንጌደረምኔ ሰናንስ ነ በራር።<verse eid="PSA 31:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 31:17"/>ያ <char style="nd">ዋቀዮ</char>፣ አን ህንቃኔፈምን፤</para>
  <para style="q2" vid="PSA 31:17">አን ስ ዋመዼራቲ፤</para>
  <para style="q1" vid="PSA 31:17">ወር ሀሞን ገሩ ሃቃኔፈመን፤</para>
  <para style="q2" vid="PSA 31:17">ጨልእሰኒስ ሲኦል ኬሰ ሃቡአን።<verse eid="PSA 31:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 31:18"/>አፋን ሶበ ዱበቱ፣</para>
  <para style="q2" vid="PSA 31:18">ከን ኦፍ ቱሉማፊ ቱፊዻን፣</para>
  <para style="q2" vid="PSA 31:18">ነመ ቀጄላት ኮሬ ዱበቱ ሃዱዱ።<verse eid="PSA 31:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 31:19"/>ጋሩማንኬ ከን አት ወረ ስ ሶዳተኒፍ ኦል ኬሴ፣</para>
  <para style="q2" vid="PSA 31:19">ከን አት ፉለ ነሞታ ዱረት</para>
  <para style="q2" vid="PSA 31:19">ወረ ኮሉ ስት ገለኒፍ ኬንቴ አከም ጉዳዸ!<verse eid="PSA 31:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 31:20"/>ደኦ ፉለኬቲቲን፣</para>
  <para style="q2" vid="PSA 31:20">ዋን ነሞትን እሳንት መለተን ጀላ እሳን ዾክስተ፤</para>
  <para style="q2" vid="PSA 31:20">ዱንካነኬ ኬሰትስ ዱቢን ቱቱቁ ጀላ እሳን ደኤስተ።<verse eid="PSA 31:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 31:21"/>
    <char style="nd">ዋቀዮ</char> ሃኤብፈሙ፤</para>
  <para style="q2" vid="PSA 31:21">እን ዬሮ አን መጋላ መርፈምቴ ኬሰ ቱሬት፣</para>
  <para style="q2" vid="PSA 31:21">ጃለለሳ ድንቅሲሳ ሰነ ነ አርግሲሴራቲ።<verse eid="PSA 31:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 31:22"/>አን ዬሮን አከ መሌ ዽጰዼት፣</para>
  <para style="q2" vid="PSA 31:22">“አን ፉለኬ ዱራ በዴረ!” ጄዼን ቱሬ።</para>
  <para style="q1" vid="PSA 31:22">አት ገሩ ዬሮ አን ገርጋርሳፍ ስት እየዼት፣</para>
  <para style="q2" vid="PSA 31:22">ከዸትናኮ ና ዸጌሴ።<verse eid="PSA 31:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 31:23"/>ቁልቁሎንሳ ሁንድኑ፣ <char style="nd">ዋቀዮን</char> ጃለዻ!</para>
  <para style="q2" vid="PSA 31:23">
    <char style="nd">ዋቀዮ</char> አመነሞተ ንኤገ፤</para>
  <para style="q2" vid="PSA 31:23">ኦፍ ቱልቶታፍ ገሩ አኩመ ሆጂሳኒት እረ ደበርሴ ዴብሳፍ።<verse eid="PSA 31:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 31:24"/>ወር <char style="nd">ዋቀዮን</char> አብደተን ሁንድኑ ጀባዻ፤</para>
  <para style="q2" vid="PSA 31:24">ገራንኬሰን ህንሶዳትን።<verse eid="PSA 31:24"/></para>
  <chapter eid="PSA 31"/>
  <chapter number="32" style="c" sid="PSA 32"/>
  <para style="cl">ፋርፈትና 32</para>
  <para style="ms1">ጩቡ ህመቹ</para>
  <para style="d">ፋርፈትና ዳዊት። <char style="tl">መስኪል።</char></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 32:1"/>ነምን የክሳ ዺፈሜፍ፣</para>
  <para style="q2" vid="PSA 32:1">ከን ጩቡንሳስ ሀጉገሜፍ፣</para>
  <para style="q2" vid="PSA 32:1">ኤብፈማዸ።<verse eid="PSA 32:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 32:2"/>ነምን <char style="nd">ዋቀዮ</char> ጩቡ እት ህንለኮፍኔ፣</para>
  <para style="q2" vid="PSA 32:2">ከን ሀፉረሳ ኬሰስ ጎዎምሳን ህንጅሬ፣</para>
  <para style="q2" vid="PSA 32:2">ኤብፈማዸ።<verse eid="PSA 32:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 32:3"/>ዬሮ አን ጩቡኮ ህመቹ ዺሴት፣</para>
  <para style="q2" vid="PSA 32:3">ጉያ ጉቱ ኣዱኮቲን፣</para>
  <para style="q2" vid="PSA 32:3">ለፌንኮ ንቦሶሴ።<verse eid="PSA 32:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 32:4"/>ሀርክኬ ሀልከኒፊ ጉያ ነት ኡልፋቴራቲ፤</para>
  <para style="q2" vid="PSA 32:4">ጀብንኮስ አኩመ ዋን ሆአ ቦናቲን ተኡት ጡጠሜ።<verse eid="PSA 32:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 32:5"/>ኤርገሲስ ጩቡኮ ስት ነንህመዼ፤</para>
  <para style="q2" vid="PSA 32:5">በሌሳኮስ ስ ህንዾክፈትኔ።</para>
  <para style="q1" vid="PSA 32:5">አንስ፣ “እረ ደደርበኮ፣ <char style="nd">ዋቀዮት</char> ነንህመዸ” ነንጄዼ፤</para>
  <para style="q2" vid="PSA 32:5">አትስ የከ ጩቡኮቲ፣ ና ዺፍቴርተ።<verse eid="PSA 32:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 32:6"/>ከናፉ ነምን አመነማን ከምዩ፣</para>
  <para style="q2" vid="PSA 32:6">ዬሮ አት እት አርገምቱት ስ ሃከዸቱ፤</para>
  <para style="q2" vid="PSA 32:6">ሎላን ብሻን ጉዳስ እሰ ብረ ህንገኡ።<verse eid="PSA 32:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 32:7"/>አት እዶ አን እት ዾከዹዸ፤</para>
  <para style="q2" vid="PSA 32:7">ረክነራ ነ ኤግደ፤</para>
  <para style="q2" vid="PSA 32:7">ፋርፈትና ሞአናቲንስ ነ መርስተ።<verse eid="PSA 32:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 32:8"/>አን ከራ አት እረ ዴምቱረት ስን ቀጄልቸ፤ ስን በርሲሰስ፤</para>
  <para style="q2" vid="PSA 32:8">አን እጀኮ ጃለላቲን ስን እላላ፤ ስን ጎርሰ።<verse eid="PSA 32:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 32:9"/>እስን አከ ፈርደ ዮካን ጋንጎ</para>
  <para style="q2" vid="PSA 32:9">ሁበትና ህንቀብኔ ህንተእና፤</para>
  <para style="q1" vid="PSA 32:9">እሳን ዮ ሉገማፊ ፉሎዻን ቀበመን መሌ</para>
  <para style="q2" vid="PSA 32:9">ገረኬ ህንዹፈን።<verse eid="PSA 32:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 32:10"/>ዽጵን ነሞተ ሀሞ ባይኤዸ፤</para>
  <para style="q2" vid="PSA 32:10">አራር <char style="nd">ዋቀዮ</char> ገሩ ነመ እሰ አመነቱ ንመርሰ።<verse eid="PSA 32:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 32:11"/>ያ ቀጄልቶተ፣ እስን <char style="nd">ዋቀዮት</char> ገመዳ፤ እልልቻስ፤</para>
  <para style="q2" vid="PSA 32:11">ወር ገራ ቁልቁሉ ቀብደን ሁንድኑ እልልቻ።<verse eid="PSA 32:11"/></para>
  <chapter eid="PSA 32"/>
  <chapter number="33" style="c" sid="PSA 33"/>
  <para style="cl">ፋርፈትና 33</para>
  <para style="ms1">ዋቀ ጀጀቹ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 33:1"/>ያ ቀጄልቶተ፣ እስን <char style="nd">ዋቀዮት</char> ገመዳ፤</para>
  <para style="q2" vid="PSA 33:1">እሰ ጀጁን ቶሎታፍ ንመለ።<verse eid="PSA 33:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 33:2"/>ክራራን <char style="nd">ዋቀዮን</char> ገለቴፈዻ፤</para>
  <para style="q2" vid="PSA 33:2">በገና ርቡ ኩዸን ቀቡን እሳፍ ፋርፈዻ።<verse eid="PSA 33:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 33:3"/>ፋርፈትና ሃራ እሳፍ ፋርፈዻ፤ ርቡ ሃላን ሩኩታ፤</para>
  <para style="q2" vid="PSA 33:3">ስሪት ሩኩታ፤ ገመቹዻንስ እልልቻ።<verse eid="PSA 33:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 33:4"/>ዱቢን <char style="nd">ዋቀዮ</char> ቀጄላዻቲ፤</para>
  <para style="q2" vid="PSA 33:4">እን ዋን ሆጄቱ ሁንዱማት አመነማዸ።<verse eid="PSA 33:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 33:5"/>
    <char style="nd">ዋቀዮ</char> ቀጄሉማፊ ሙርቲ ቀጄላ ጃለተ፤</para>
  <para style="q2" vid="PSA 33:5">ለፍትስ ጃለለሳ ከን ህንጌደረምኔን ጉተምቴርት።<verse eid="PSA 33:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 33:6"/>ሰሚወን ዱቢ <char style="nd">ዋቀዮቲን</char> ሆጄተመን፤</para>
  <para style="q2" vid="PSA 33:6">ቱትን ኡርጂወኒ ሁንድኑስ <optbreak/> ሀፉረ አፋንሳቲ በኡን ኡመመን።<verse eid="PSA 33:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 33:7"/>እን ብሻን ገላና አከ ቱላት ወልት ቀበ፤</para>
  <para style="q2" vid="PSA 33:7">ብሻን ቱጁባስ ኩሳ ኬሰ ካአ።<verse eid="PSA 33:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 33:8"/>ለፍት ሁንድ <char style="nd">ዋቀዮን</char> ሃሶዳቱ፤</para>
  <para style="q2" vid="PSA 33:8">ሰብን አዱኛረ ጅራቱ ሁንድኑስ፣ ጉድሴ እሰ ሃሶዳቱ።<verse eid="PSA 33:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 33:9"/>እን ዱበቴራቲ፣ ወን እን ዱበቴ ንተኤ፤</para>
  <para style="q2" vid="PSA 33:9">እን ንአጀጄ፤ ወን እን አጀጄስ ንራወቴ።<verse eid="PSA 33:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 33:10"/>
    <char style="nd">ዋቀዮ</char> መሪ ሰቦታ ንፈሸሌሰ፤</para>
  <para style="q2" vid="PSA 33:10">አከ ከሮር ነሞታ ሆጂረ ህንኦሌስ ንጎዸ።<verse eid="PSA 33:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 33:11"/>ከሮር <char style="nd">ዋቀዮ</char> ገሩ በረ በራን፣ ያድን ገራሳስ</para>
  <para style="q2" vid="PSA 33:11">ዸሎተ ሁንዱማ ኬሰት ጭሜ ንዻበተ።<verse eid="PSA 33:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 33:12"/>ሰብን <char style="nd">ዋቀዮ</char> ዋቀ እሳፍ ተኤ፣</para>
  <para style="q2" vid="PSA 33:12">ነሞትን እን አከ ዻለ ኦፊሳት ፍለቴ ኤብፈሞዸ።<verse eid="PSA 33:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 33:13"/>
    <char style="nd">ዋቀዮ</char> ሰሚራ ገድ ንእላለ፤</para>
  <para style="q2" vid="PSA 33:13">እልማን ነሞታ ሁንደስ ንአርገ፤<verse eid="PSA 33:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 33:14"/>እን ቴሶሳረ ታኤ፣</para>
  <para style="q2" vid="PSA 33:14">ወረ ለፈረ ጅራተን ሁንደ ገድ እላለ፤<verse eid="PSA 33:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 33:15"/>እን ገራ ነመ ሁንዱማ ኡሙ ሱን፣</para>
  <para style="q2" vid="PSA 33:15">ሆጂሳኒ ሁንደ ንሁበተ።<verse eid="PSA 33:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 33:16"/>ሞቲን ባይእነ ሎልቶተሳቲን ዱአ ህንኦሉ፤</para>
  <para style="q2" vid="PSA 33:16">ጀግንስ ጉድነ ሁምነሳቲን ዱአ ጀላ ህንበኡ።<verse eid="PSA 33:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 33:17"/>ፈርድ ሞአናዻፍ አብዲ ገቲ ህንቀብኔዸ፤</para>
  <para style="q2" vid="PSA 33:17">ጉድን ሁምነሳስ ነመ ህንኦልቹ።<verse eid="PSA 33:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 33:18"/>ገሩ እጅ <char style="nd">ዋቀዮ</char> ወረ እሰ ሶዳተንረ፣</para>
  <para style="q2" vid="PSA 33:18">ወረ አራረሳ አብደተንረስ ጅረ፤<verse eid="PSA 33:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 33:19"/>እን ሉቡሳኒ ዱአ ጀላ ንባሰ፤</para>
  <para style="q2" vid="PSA 33:19">በረ ቤላስ እሳን ንጅራችሰ።<verse eid="PSA 33:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 33:20"/>ሉቡንኬኘ አብዲዻን <char style="nd">ዋቀዮን</char> ኤገት፤</para>
  <para style="q2" vid="PSA 33:20">እንስ ገርጋርሰኬኛፊ ጋቸነኬኘ።<verse eid="PSA 33:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 33:21"/>ገራንኬኘ እሰት ንገመዳቲ፤</para>
  <para style="q2" vid="PSA 33:21">ኑ መቃሳ ቁልቁሉ ንአመነናቲ።<verse eid="PSA 33:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 33:22"/>ያ <char style="nd">ዋቀዮ</char>፣ አኩመ ኑ አብዲኬኘ</para>
  <para style="q2" vid="PSA 33:22">ስረ ካአኑት፣ አራርኬ ኑረ ሃቡኡ።<verse eid="PSA 33:22"/></para>
  <chapter eid="PSA 33"/>
  <chapter number="34" style="c" sid="PSA 34"/>
  <para style="cl">ፋርፈትና 34</para>
  <para style="ms1">ዋቀ ሙርቲ ቀጄላ ጀጀቹ</para>
  <para style="d">ፋርፈትና ዳዊት። እንስ ፉለ አቢሜሌክ ዱረት መራቱ ኦፍ ፈኬሴፍ አቢሜሌክ እሰ አሪናን ዬሮ አቺ ዴሜት ፋርፈቴ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 34:1"/>አን ዬሮ ሁንደ <char style="nd">ዋቀዮን</char> ነንኤብሰ፤</para>
  <para style="q2" vid="PSA 34:1">ገለንሳስ ዬሮ ሁንደ አፋኒ ነ ህንቡኡ።<verse eid="PSA 34:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 34:2"/>ሉቡንኮ <char style="nd">ዋቀዮን</char> ቦንት፤</para>
  <para style="q2" vid="PSA 34:2">ጩንቁርፈምቶትን ዸገአኒ ሃገመደን።<verse eid="PSA 34:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 34:3"/>ነ ወጅን <char style="nd">ዋቀዮፍ</char> ኡልፍነ ኬና፤</para>
  <para style="q2" vid="PSA 34:3">ኮታ ወሊ ወጅን መቃሳ ኦል ካፍና።<verse eid="PSA 34:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 34:4"/>
    <char style="nd">ዋቀዮን</char> ነንበርባደዼ፤ እንስ ዴቢ ና ኬኔ፤</para>
  <para style="q2" vid="PSA 34:4">ሶዳኮ ሁንደ ኬሳስ ነ ባሴ።<verse eid="PSA 34:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 34:5"/>ወር ገረሳ እላለን ንእፉ፤</para>
  <para style="q2" vid="PSA 34:5">ፉልሳኒስ ዮምዩ ህንቃነኡ።<verse eid="PSA 34:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 34:6"/>ህዬስ ኩን ንእዬ፤ <char style="nd">ዋቀዮስ</char> እሰ ዸገኤ፤</para>
  <para style="q2" vid="PSA 34:6">ረክነሳ ሁንዱማ ኬሳስ እሰ ባሴ።<verse eid="PSA 34:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 34:7"/>ኤርገማን <char style="nd">ዋቀዮ</char> ናኖ ወረ ዋቀ ሶዳተኒ</para>
  <para style="q2" vid="PSA 34:7">ንቁበተ፤ እሳን ንኦልቸስ።<verse eid="PSA 34:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 34:8"/>አከ <char style="nd">ዋቀዮ</char> ጋሪ ተኤ ሜ ምኤፈዻ እላላ፤</para>
  <para style="q2" vid="PSA 34:8">ነምን እሰት ኮሉ ገሉ ኤብፈማዸ።<verse eid="PSA 34:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 34:9"/>እስን ቁልቁሎንሳ <char style="nd">ዋቀዮን</char> ሶዳዻ፤</para>
  <para style="q2" vid="PSA 34:9">ወር እሰ ሶዳተን ሆማ ህንዸበኒቲ።<verse eid="PSA 34:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 34:10"/>ሌንጭ ሳፌልዩ ዋ ንዸበ፤ ንቤለአስ፤</para>
  <para style="q2" vid="PSA 34:10">ነምን <char style="nd">ዋቀዮን</char> በርባደቱ ገሩ <optbreak/> ዋን ጋሪ ቶኮሌ ህንዸቡ።<verse eid="PSA 34:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 34:11"/>ያ እጆሌኮ፣ ኮታ ነ ዸገኣ፤</para>
  <para style="q2" vid="PSA 34:11">አንስ <char style="nd">ዋቀዮን</char> ሶዳቹ እስነን በርሲሰ።<verse eid="PSA 34:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 34:12"/>ነምን ጅሬኘ ጃለቱ፣ ከን በረ ጋሪ አርጉዻፍስ</para>
  <para style="q2" vid="PSA 34:12">በረ ባይኤ ሀዉ ኤኙ?<verse eid="PSA 34:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 34:13"/>አረበኬ ዋን ሀማራ፣</para>
  <para style="q2" vid="PSA 34:13">አፋንኬስ ሶበ ዱበቹራ ኤገዹ።<verse eid="PSA 34:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 34:14"/>ሀምነራ ዴብእ፤ ጋሪ ሆጄዹ፤</para>
  <para style="q2" vid="PSA 34:14">ነጋ በርባድ፤ ዱካ ቡእስ።<verse eid="PSA 34:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 34:15"/>እጅ <char style="nd">ዋቀዮ</char> ቀጄልቶተረ ጅረ፤</para>
  <para style="q2" vid="PSA 34:15">ጉርሳስ እየሳኒቲፍ በነማዸ፤<verse eid="PSA 34:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 34:16"/>ያደኖሳኒ ለፈራ በሌሱዻፍ፣</para>
  <para style="q2" vid="PSA 34:16">ፉል <char style="nd">ዋቀዮ</char> ወረ ሀማ ሆጄተንት ንሀማተ።<verse eid="PSA 34:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 34:17"/>ቀጄልቶትን ገርጋርሳፍ እየቱ፤ <char style="nd">ዋቀዮስ</char> እሳን ዸገአ።</para>
  <para style="q2" vid="PSA 34:17">ረክነሳኒ ሁንደ ኬሳስ እሳን ባሰ።<verse eid="PSA 34:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 34:18"/>
    <char style="nd">ዋቀዮ</char> ወረ ገራንሳኒ ጨቤት ዽኦዸ፤</para>
  <para style="q2" vid="PSA 34:18">ወረ አብዲ ኩተተንስ ንፈይሰ።<verse eid="PSA 34:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 34:19"/>ረክን ነመ ቀጄላ ባይኤዸ፤</para>
  <para style="q2" vid="PSA 34:19">
    <char style="nd">ዋቀዮ</char> ገሩ ሁንደሳ ጀላ እሰ ባሰ፤<verse eid="PSA 34:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 34:20"/>ለፌሳ ሁንደ ንኤገ፤</para>
  <para style="q2" vid="PSA 34:20">እሳን ኬሳስ ቶኮሌ ህንጨቡ።<verse eid="PSA 34:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 34:21"/>ሀሞተ ሀምነቱ አጄሰ፤</para>
  <para style="q2" vid="PSA 34:21">ወረ ነመ ቀጄላ ጅበንት ንሙርቴፈመ።<verse eid="PSA 34:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 34:22"/>
    <char style="nd">ዋቀዮ</char> ሉቡ ተጃጅልቶተሳ ንፉረ፤</para>
  <para style="q2" vid="PSA 34:22">ወረ እሰት ኮሉ ገለን ኬሳ ቶኮትሌ ህንሙርቴፈሙ።<verse eid="PSA 34:22"/></para>
  <chapter eid="PSA 34"/>
  <chapter number="35" style="c" sid="PSA 35"/>
  <para style="cl">ፋርፈትና 35</para>
  <para style="ms1">ከዸትና ነመ ዽጰቴ</para>
  <para style="d">ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 35:1"/>ያ <char style="nd">ዋቀዮ</char>፣ ወረ አናን ሞርመኒን ሞርም፤</para>
  <para style="q2" vid="PSA 35:1">ወረ ነ ሎለንስ ሎል።<verse eid="PSA 35:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 35:2"/>ጋቸናፊ ምአ ሎላ ቀበዹ፤</para>
  <para style="q2" vid="PSA 35:2">ነ ገርጋሩዻፍስ ከእ።<verse eid="PSA 35:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 35:3"/>ወረ ነ አርአንት</para>
  <para style="q2" vid="PSA 35:3">ኤቦፊ ቦዴ ሉቅፈዹ።</para>
  <para style="q1" vid="PSA 35:3">ሉቡኮቲንስ፣</para>
  <para style="q2" vid="PSA 35:3">“ፈይንኬ አነ” ጄዽ።<verse eid="PSA 35:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 35:4"/>ወር ሉቡኮ በርባደን፣</para>
  <para style="q2" vid="PSA 35:4">ሃቃነአን፤ ሃሰልጰተንስ፤</para>
  <para style="q1" vid="PSA 35:4">ወር ነ በሌሱፍ መርአተንስ፣</para>
  <para style="q2" vid="PSA 35:4">አብዲ ኩተተኒ ዱበት ሃዴብአን።<verse eid="PSA 35:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 35:5"/>አከ ሀበቂ ቅሌንሳን ፉዸተሜ ሃተአን፤</para>
  <para style="q2" vid="PSA 35:5">ኤርገማን <char style="nd">ዋቀዮስ</char> እሳን ሃአርኡ።<verse eid="PSA 35:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 35:6"/>ከራንሳኒ ዱከናኣፊ ሙጩጫታ ሃተኡ፤</para>
  <para style="q2" vid="PSA 35:6">ኤርገማን <char style="nd">ዋቀዮስ</char> እሳን ሃአርኡ።<verse eid="PSA 35:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 35:7"/>እሳን ሰበቢ መሌ ክዮሳኒ ዾክሰኒ <optbreak/> ነ ዱረ ካአኒሩቲ፤</para>
  <para style="q2" vid="PSA 35:7">ሰበቢ መሌስ ቦለ ና ቆተኒሩ፤<verse eid="PSA 35:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 35:8"/>ኡቱ እን ህንቤክን በዲስን እሰት ሃዹፉ፤</para>
  <para style="q2" vid="PSA 35:8">ክዮን እን ዾክሴ ሱንስ እሱመ ሃቀቡ፤</para>
  <para style="q2" vid="PSA 35:8">ቦሉመ ቆቴ ሰነትስ ሃኩፉ።<verse eid="PSA 35:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 35:9"/>ዮስ ሉቡንኮ፣ <char style="nd">ዋቀዮት</char> ገመድ፤</para>
  <para style="q2" vid="PSA 35:9">ፈይሱ እሳትስ ንእልልችት።<verse eid="PSA 35:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 35:10"/>ለፌንኮ ሁንድ አከነ ሲን ጄዸ፦</para>
  <para style="q2" vid="PSA 35:10">“ያ <char style="nd">ዋቀዮ</char>፣ ከን አከኬቲ ኤኙ?</para>
  <para style="q1" vid="PSA 35:10">አት ደዸብዶተ ወረ እሳን ጫላ ጀባተን ጀላ ባፍተ፤</para>
  <para style="q2" vid="PSA 35:10">ህዬዪፊ ረከቶተሌ ሳምቶተ ጀላ ባፍተ።”<verse eid="PSA 35:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 35:11"/>ዹገ ባቶትን ሶባ ነት ከአን፤</para>
  <para style="q2" vid="PSA 35:11">ዋን አን ዋኤሳ ህንቤክኔስ ነ ጋፈቱ።<verse eid="PSA 35:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 35:12"/>እሳን ቆደ ዋን ጋሪ ዋን ሀማ ና ዴብሱ፤</para>
  <para style="q2" vid="PSA 35:12">ሉቡኮስ ኮጳት ሀምብሱ።<verse eid="PSA 35:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 35:13"/>አን ገሩ ዬሮ እሳን ዽበመንት፣ <optbreak/> ወያ ገዳ ነንኡፈዼ፤</para>
  <para style="q2" vid="PSA 35:13">ሉቡኮስ ሶማን ነንሚዼ።</para>
  <para style="q1" vid="PSA 35:13">ዬሮ ከዸናንኮ ዴቢ መሌ ሀፌትስ<verse eid="PSA 35:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="PSA 35:14"/>አን አኩመ ዋን ምቹኮቲፍ ዮካን ኦቦሌሰኮቲፍ ገዱት፣</para>
  <para style="q2" vid="PSA 35:14">ገዳን አሲፊ አች ዴዴብኤ።</para>
  <para style="q1" vid="PSA 35:14">አኩመ ዋን ሃዸኮቲፍ ቦኡትስ፣</para>
  <para style="q2" vid="PSA 35:14">ገዳን መታኮ ነንቡሴ።<verse eid="PSA 35:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 35:15"/>እሳን ገሩ ዬሮ አን ጉፈዼት ገመደኒ ወልት ቀበመን፤</para>
  <para style="q2" vid="PSA 35:15">ኡቱ አን ህንቤክን ነ መርሰን፤</para>
  <para style="q2" vid="PSA 35:15">ኡቱ ወልራ ህንኩትንስ ነ ጭጭረተን።<verse eid="PSA 35:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 35:16"/>እሳን አኩመ ወረ ዋቀት ህንቡሌት ሀምናን ነት ቆሰን፤</para>
  <para style="q2" vid="PSA 35:16">እልካንሳኒሌ ነት ቀረተን።<verse eid="PSA 35:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 35:17"/>ያ ጎፍታ፣ አት ሀመ ዮሚት ጨልእስቴ እላልተ?</para>
  <para style="q2" vid="PSA 35:17">ሉቡኮ በዲሰ እሳን ፍደን ጀላ፣</para>
  <para style="q2" vid="PSA 35:17">ጅሬኘኮስ ሌንጨ ጀላ ባስ።<verse eid="PSA 35:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 35:18"/>አን ወል ገኢ ጉዳ ኬሰት ስን ገለቴፈዸ፤</para>
  <para style="q2" vid="PSA 35:18">ቱተ ጉዳ ኬሰት ስን ጀጀዸ።<verse eid="PSA 35:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 35:19"/>ወር አከሱማን ዲነ ነት ተአን ነት ህንገመድን፤</para>
  <para style="q2" vid="PSA 35:19">ወር ሰበቢ መሌ ነ ጅበን ሱንስ እጀ ነት ህንቅስን።<verse eid="PSA 35:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 35:20"/>እሳን ነጋ ህንዱበተን፤</para>
  <para style="q2" vid="PSA 35:20">ወረ ቀበናን ብየ ኬሰ ጅራተንትስ፣</para>
  <para style="q2" vid="PSA 35:20">መለ ሶባ መለቱ።<verse eid="PSA 35:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 35:21"/>እሳንስ፣ “በገ! በገ! እጁመኬኛን እሰ አርግኔ”</para>
  <para style="q2" vid="PSA 35:21">ጄዸኒ አፋን ነት በነቱ።<verse eid="PSA 35:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 35:22"/>ያ <char style="nd">ዋቀዮ</char>፣ አት ዋን ከነ አርግቴርተ፤ ህንጨልእስን።</para>
  <para style="q2" vid="PSA 35:22">ያ ጎፍታ፣ ነራ ህንፈጋትን።<verse eid="PSA 35:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 35:23"/>ያ ዋቀኮፊ ጎፍታኮ፣ አት ምርገኮቲፍ፣</para>
  <para style="q2" vid="PSA 35:23">ዽመኮቲፍስ ደመቅ፤ ከእ!<verse eid="PSA 35:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 35:24"/>ያ <char style="nd">ዋቀዮ</char> ዋቀኮ፣</para>
  <para style="q2" vid="PSA 35:24">አኩመ ቀጄሉማኬቲት ና ሙርቴስ፤</para>
  <para style="q2" vid="PSA 35:24">አከ እሳን ነት ገመደንስ ህንጎዽን።<verse eid="PSA 35:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 35:25"/>አከ እሳን፣ “በገ! አኩመ ኑ በርባኔ ተኤረ!” ጄዸን፣</para>
  <para style="q2" vid="PSA 35:25">ዮካን አከ እሳን፣ “ኑ እሰ ልቅምስኔረ” ጄዸን ህንጎዽን።<verse eid="PSA 35:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 35:26"/>ወር ዽጵነኮት ገመደን ሁንድኑ</para>
  <para style="q2" vid="PSA 35:26">ሃቃነአን፤ ሃቡርጃጀአንስ፤</para>
  <para style="q1" vid="PSA 35:26">ወር ነት ኮረን ሁንድኑስ፣</para>
  <para style="q2" vid="PSA 35:26">ቃኒፊ ሰልጵነ ሃኡፈተን።<verse eid="PSA 35:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 35:27"/>ወር ቀጄሉመኮ ጃለተን፣</para>
  <para style="q2" vid="PSA 35:27">ሰገሌ ጉዳዻን ሃእልልቸን፤ ሃገመደንስ።</para>
  <para style="q1" vid="PSA 35:27">እሳን ዬሮ ሁንደ፣</para>
  <para style="q2" vid="PSA 35:27">“<char style="nd">ዋቀዮ</char> እን ነጋ ገርብቸሳት ገመዱ <optbreak/> ጉዳዸ” ሃጄዸን።<verse eid="PSA 35:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 35:28"/>አረብንኮ ቀጄሉማኬ፣</para>
  <para style="q2" vid="PSA 35:28">ጉያ ጉቱስ ገለተኬ ኦዴሰ።<verse eid="PSA 35:28"/></para>
  <chapter eid="PSA 35"/>
  <chapter number="36" style="c" sid="PSA 36"/>
  <para style="cl">ፋርፈትና 36</para>
  <para style="ms1">ጀልእነ ነማቲፊ ጋሩማ ዋቀዮ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዳዊት ገርብቸ <char style="nd">ዋቀዮ</char>።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 36:1"/>አን ዋኤ ጩበሞታ፣</para>
  <para style="q2" vid="PSA 36:1">ኤርጋ ዋቀ ብረ ዹፌ ገራኮ ኬሳ ቀበ፦</para>
  <para style="q2" vid="PSA 36:1">ዋቀ ሶዳቹን እጀሳኒ ዱረ ህንጅሩ።<verse eid="PSA 36:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 36:2"/>አከ ጩቡንሳኒ እፈት በኤ ህንጅበምኔፍስ፣</para>
  <para style="q2" vid="PSA 36:2">እሳን እጁመ ኦፊሳኒ ዱረት አከ መሌ ኦፍ ሳዱ።<verse eid="PSA 36:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 36:3"/>ዱቢን አፋንሳኒ ጀልእናፊ ጎዎምሳዸ፤</para>
  <para style="q2" vid="PSA 36:3">እሳን ኦጉማዻን ሆጄቹፊ ዋን ጋሪ ጎቹ ዺሰኒሩ።<verse eid="PSA 36:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 36:4"/>ስሬሳኒረትዩ እሳን ሀምነ ጠጡ፤</para>
  <para style="q2" vid="PSA 36:4">ከራ ጩቡት ኦፍ ኬኑ፤ ዋን ሀማስ ህንለገተን።<verse eid="PSA 36:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 36:5"/>ያ <char style="nd">ዋቀዮ</char>፣ አራርኬ ሰሚወን ብረ፣</para>
  <para style="q2" vid="PSA 36:5">አመነሙማንኬስ ዱሜሰ ብረ ገአ።<verse eid="PSA 36:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 36:6"/>ቀጄሉማንኬ አከ ቱሉወን ጉርጉዳት፤</para>
  <para style="q2" vid="PSA 36:6">ሙርቲንኬስ አኩመ ቱጁበ ጉዳት።</para>
  <para style="q2" vid="PSA 36:6">ያ <char style="nd">ዋቀዮ</char>፣ አት ነማፊ ብኔንሰ ንጅራችፍተ።<verse eid="PSA 36:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 36:7"/>ያ ዋቅ፣ ጃለልኬ እን ህንጌደረምኔ ሱን አከም ኡልፍነ ቀቤሰ!</para>
  <para style="q2" vid="PSA 36:7">እልማን ነሞታ፣ ጋድሰ ቆቾኬቲ ጀለት ኮሉ ገሉ።<verse eid="PSA 36:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 36:8"/>እሳን በዻዹማ መነኬቲ ኛተኒ ቁፉ፤</para>
  <para style="q2" vid="PSA 36:8">አትስ ለገ ገመቹኬቲራ እሳን ኦባፍተ።<verse eid="PSA 36:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 36:9"/>ቡርቃን ጅሬኛ ስ ብረ ጅራቲ፤</para>
  <para style="q2" vid="PSA 36:9">ኑ እፈኬቲን እፈ አርግነ።<verse eid="PSA 36:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 36:10"/>ጃለለኬ ወረ ስ ቤከኒፍ፣</para>
  <para style="q2" vid="PSA 36:10">ቀጄሉማኬስ ገረ ቶሌዪዻፍ እቱመ ፉፍ።<verse eid="PSA 36:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 36:11"/>ሚል ኦፍ ቱልቶታ ነት ህንዹፍን፤</para>
  <para style="q2" vid="PSA 36:11">ሀርክ ሀሞታስ ዺቤ ነ ህንፈጌስን።<verse eid="PSA 36:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 36:12"/>ወር ዋን ሀማ ሆጄተን ኩኖ ኩፈኒ ድሪረኒሩ፤</para>
  <para style="q2" vid="PSA 36:12">ገድ ደርበተመኒሩ፤ ከኡስ ህንደንደአን!<verse eid="PSA 36:12"/></para>
  <chapter eid="PSA 36"/>
  <chapter number="37" style="c" sid="PSA 37"/>
  <para style="cl">ፋርፈትና 37</para>
  <para style="ms1">ቆደ ነመ ቀጄላፊ ሀማ</para>
  <para style="d">ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 37:1"/>አት ሰበቢ ነሞተ ሀሞቲፍ ጄቴ ህንኣርን</para>
  <para style="q2" vid="PSA 37:1">ዮካን ወረ ጀልእነ ሆጄተንት ህንህናፍን።<verse eid="PSA 37:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 37:2"/>እሳን አኩመ መርጋ ደፈኒ ጮለጉ፤</para>
  <para style="q2" vid="PSA 37:2">አኩመ ብቅልቱ ምሴ ደፈኒ ጎጉ።<verse eid="PSA 37:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 37:3"/>
    <char style="nd">ዋቀዮን</char> አመነዹ፤ ዋን ጋሪስ ሆጄዹ፤</para>
  <para style="q2" vid="PSA 37:3">ብየቲ ኬሰ ጅራዹ፤ ነጋስ ቀባዹ።<verse eid="PSA 37:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 37:4"/>
    <char style="nd">ዋቀዮት</char> ገመድ፤</para>
  <para style="q2" vid="PSA 37:4">እንስ ሀዊ ገራኬቲ ሲፍ ጉተ።<verse eid="PSA 37:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 37:5"/>ከራኬ <char style="nd">ዋቀዮት</char> ኬነዹ፤</para>
  <para style="q2" vid="PSA 37:5">እሰ አመነዹ፤ እን ሲፍ ምልኬሰ።<verse eid="PSA 37:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 37:6"/>እን ቀጄሉማኬ አከ አዱ ገነማት፣</para>
  <para style="q2" vid="PSA 37:6">ሙርቲ ኬሞ አከ አዱ ሳፋት እብሰ።<verse eid="PSA 37:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 37:7"/>
    <char style="nd">ዋቀዮ</char> ዱረት ጨልእስ፤</para>
  <para style="q2" vid="PSA 37:7">ኦብሳንስ እሰ ኤገዹ፤</para>
  <para style="q1" vid="PSA 37:7">ነመ ከራንሳ ቀጄሌፍት፣</para>
  <para style="q2" vid="PSA 37:7">ከን ሀምነ ሆጄቱትስ ህንህናፍን።<verse eid="PSA 37:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 37:8"/>ኣሪራ ኦፍ ኤግ፤ ዼከምሰራስ ዴብእ፤</para>
  <para style="q2" vid="PSA 37:8">ህንኣርን፤ ኣሪን ሀምነ ቆፈት ነመ ጌሳቲ።<verse eid="PSA 37:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 37:9"/>ነሞትን ሀሞን ንበሌፈሙቲ፤</para>
  <para style="q2" vid="PSA 37:9">ወር <char style="nd">ዋቀዮን</char> አብደተን ገሩ ለፈ ዻሉ።<verse eid="PSA 37:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 37:10"/>ነሞትን ሀሞን ዬሮ ጥኖዻፍ መሌ ስአች ህንጅራተን፤</para>
  <para style="q2" vid="PSA 37:10">ዮ አት እሳን በርባዴሌ ህንአርገመን።<verse eid="PSA 37:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 37:11"/>ገራሞትን ገሩ ለፈ ንዻሉ፤</para>
  <para style="q2" vid="PSA 37:11">ነጋ ጉዳዻንስ ንገመዱ።<verse eid="PSA 37:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 37:12"/>ነሞትን ሀሞን ነመ ቀጄላት መርአቱ፤</para>
  <para style="q2" vid="PSA 37:12">እልካንሳኒስ እሰት ቀረቱ፤<verse eid="PSA 37:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 37:13"/>ጎፍታን ሀሞተት ንኮልፈ፤</para>
  <para style="q2" vid="PSA 37:13">እን አከ ጉያንሳኒ ዽኣቴ ንቤካቲ።<verse eid="PSA 37:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 37:14"/>ነሞትን ሀሞን ህዬዪፊ</para>
  <para style="q2" vid="PSA 37:14">ረከቶተ ለፋን ዸኡዻፍ፣</para>
  <para style="q1" vid="PSA 37:14">ወረ ከራንሳኒ ቀጄላ ተኤሞ ጎረኡዻፍ፣</para>
  <para style="q2" vid="PSA 37:14">ጎራዴሳኒ ሉቅፈቱ፤ እዳሳኒስ ንደብሰቱ።<verse eid="PSA 37:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 37:15"/>ጎራዴንሳኒ ገሩ ገራዹመሳኒ ወራነ፤</para>
  <para style="q2" vid="PSA 37:15">እዳንሳኒስ ንጨጨበ።<verse eid="PSA 37:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 37:16"/>በዻዹማ ሀሞን ባይኤን ቀበንረ፣</para>
  <para style="q2" vid="PSA 37:16">ዋን ጥኖ ነምን ቀጄላን ቀቡ ወየ፤<verse eid="PSA 37:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 37:17"/>ሁምን ሀሞታ ንጨባቲ፤</para>
  <para style="q2" vid="PSA 37:17">
    <char style="nd">ዋቀዮ</char> ገሩ ቀጄልቶተ ጀቤሴ ንዻበ።<verse eid="PSA 37:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 37:18"/>
    <char style="nd">ዋቀዮ</char> በረ ቶሎታ ንቤከ፤</para>
  <para style="q2" vid="PSA 37:18">ዻልሳኒስ በረ በራን ጅራተ።<verse eid="PSA 37:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 37:19"/>እሳን በረ ሀማ ኬሰ ህንቃነአን፤</para>
  <para style="q2" vid="PSA 37:19">በረ ቤላ ኬሰስ ንቁፉ።<verse eid="PSA 37:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 37:20"/>ነሞትን ሀሞን ገሩ ንበርበዳኡ፤</para>
  <para style="q2" vid="PSA 37:20">ዲኖትን <char style="nd">ዋቀዮስ</char> አኩመ ሚዸግነ ደራራ ድሬት፤</para>
  <para style="q2" vid="PSA 37:20">እሳን ንበዱ፤ አኩመ ኣራ ንበዱ።<verse eid="PSA 37:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 37:21"/>ነሞትን ሀሞን ንልቄፈቱ፤</para>
  <para style="q2" vid="PSA 37:21">ገሩ ዴብሰኒ ኦፍራ ህንባሰን፤</para>
  <para style="q2" vid="PSA 37:21">ቀጄልቶትን ገሩ አርጁማዻን ኬኑ፤<verse eid="PSA 37:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 37:22"/>ወር <char style="nd">ዋቀዮ</char> ኤብሱ ለፈ ንዻሉ፤</para>
  <para style="q2" vid="PSA 37:22">ወር እን አባሩ ገሩ ንበሌፈሙ።<verse eid="PSA 37:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 37:23"/>አዴምስ ነመ <char style="nd">ዋቀዮ</char> ብራ አጀጀመ፤</para>
  <para style="q2" vid="PSA 37:23">እን ከራ ነምቸ ሰናት ንገመደ።<verse eid="PSA 37:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 37:24"/>እን ዮ ጉፈቴሌ ለፈ ህንገኡ፤</para>
  <para style="q2" vid="PSA 37:24">
    <char style="nd">ዋቀዮ</char> ሀርከሳቲን ቀቤ እሰ ዻባቲ።<verse eid="PSA 37:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 37:25"/>አን ደርገጌሰን ቱሬ፤ አመሞ ዱሎሜረ፤</para>
  <para style="q2" vid="PSA 37:25">ገሩ ቀጄልቶትን ገተሙሳኒ</para>
  <para style="q2" vid="PSA 37:25">ዮካን እጆሌንሳኒስ ቡዴነ ከዸቹሳኒ ህንአርግኔ።<verse eid="PSA 37:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 37:26"/>ቀጄልቶትን ዬሮ ሁንዱማ ንአርጆሙ፤ ንልቄሱስ፤</para>
  <para style="q2" vid="PSA 37:26">እጆሌንሳኒስ ንኤብፈሙ።<verse eid="PSA 37:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 37:27"/>ዋን ሀማራ ዴብኢቲ ዋን ጋሪ ሆጄዹ፤</para>
  <para style="q2" vid="PSA 37:27">ዮስ አት በረ በራን ንጅራተ።<verse eid="PSA 37:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 37:28"/>
    <char style="nd">ዋቀዮ</char> ሙርቲ ቀጄላ ጃለታቲ፤</para>
  <para style="q2" vid="PSA 37:28">ወረ እሳፍ አመነመንስ ህንገቱ።</para>
  <para style="b" vid="PSA 37:28"/>
  <para style="q1" vid="PSA 37:28">እሳንስ በረ በራን ንኤገሙ፤</para>
  <para style="q2" vid="PSA 37:28">ሰኚን ሀሞታ ገሩ ንበሌፈመ።<verse eid="PSA 37:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 37:29"/>ቀጄልቶትን ለፈ ንዻሉ፤</para>
  <para style="q2" vid="PSA 37:29">በረ በራንስ እሼረ ንጅራቱ።<verse eid="PSA 37:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 37:30"/>አፋን ነመ ቀጄላ ኦጉማ ዱበተ፤</para>
  <para style="q2" vid="PSA 37:30">አረብንሳስ ሙርቲ ቀጄላ ለብሰ።<verse eid="PSA 37:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 37:31"/>ሴር ዋቀሳ ገራሳ ኬሰ ጅረ፤</para>
  <para style="q2" vid="PSA 37:31">ሚልሳስ ህንሙጩጫቱ።<verse eid="PSA 37:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 37:32"/>ነሞትን ሀሞን ቀጄልቶተ ጋዱ፤</para>
  <para style="q2" vid="PSA 37:32">እሳን አጄሱስ ንበርባዱ፤<verse eid="PSA 37:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 37:33"/>
    <char style="nd">ዋቀዮ</char> ገሩ ሀርከሳኒት ጀረ ህንዺሱ</para>
  <para style="q2" vid="PSA 37:33">ዮካን ዮሙ እሳን ሙርቲት ዽኤፈመንት፣</para>
  <para style="q2" vid="PSA 37:33">አከ እሳንት ሙርቴፈሙ ህንኤየሙ።<verse eid="PSA 37:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 37:34"/>
    <char style="nd">ዋቀዮን</char> ኤገዹ፤ ከራሳስ ኤግ።</para>
  <para style="q2" vid="PSA 37:34">እን አከ አት ለፈ ዻልቱፍ ኡልፍነ ሲፍ ኬነ፤</para>
  <para style="q2" vid="PSA 37:34">አትስ በዲሰ ሀሞታ ንአርግተ።<verse eid="PSA 37:34"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 37:35"/>ነመ ሀማፊ ገረ ጀቤሰ፣</para>
  <para style="q2" vid="PSA 37:35">እሳ አኩመ ሙከ እዶንሳ እት ቶሌ ጅሩ ነንአርጌ።<verse eid="PSA 37:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 37:36"/>ኤርገሲስ አቺን ነንደርቤ፤ እን ገሩ አች ህንቱሬ፤</para>
  <para style="q2" vid="PSA 37:36">አን ጭምሴ እሰ ነንበርባዴ፤ እን ገሩ ህንአርገምኔ።<verse eid="PSA 37:36"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 37:37"/>ነመ ሙዳ ህንቀብኔ ያደት ቀበዹ፤ ቶሎተስ እላል፤</para>
  <para style="q2" vid="PSA 37:37">ሰኚን ነመ ነጋ ህንበዱቲ።<verse eid="PSA 37:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 37:38"/>ጩበሞትን ሁንድኑ ገሩ ንበርበዴፈሙ፤</para>
  <para style="q2" vid="PSA 37:38">ገልገል ነመ ሀማስ ህንቶሉ።<verse eid="PSA 37:38"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 37:39"/>ፈይን ቀጄልቶታ <char style="nd">ዋቀዮ</char> ብራ ዹፈ፤</para>
  <para style="q2" vid="PSA 37:39">እን ዬሮ ረክናት ደኦሳኒት።<verse eid="PSA 37:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 37:40"/>
    <char style="nd">ዋቀዮ</char> እሳን ገርጋረ፤ እሳን ኦልቸስ፤</para>
  <para style="q2" vid="PSA 37:40">ሀርከ ነሞተ ሀሞ ጀላ እሳን ባሰ፤</para>
  <para style="q2" vid="PSA 37:40">እሳን በራረስ፤ እሳን እሰት ኮሉ ገለኒሩቲ።<verse eid="PSA 37:40"/></para>
  <chapter eid="PSA 37"/>
  <chapter number="38" style="c" sid="PSA 38"/>
  <para style="cl">ፋርፈትና 38</para>
  <para style="ms1">ከዸትና ዬሮ ዽጵና</para>
  <para style="d">ፋርፈትና ዳዊት። ያደኖዻፍ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 38:1"/>ያ <char style="nd">ዋቀዮ</char>፣ ኣሪኬቲን ነ ህንፈትን</para>
  <para style="q2" vid="PSA 38:1">ዮካን ዼከምሰኬቲን ነ ህንአደብን።<verse eid="PSA 38:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 38:2"/>ጥዮሊንኬ ነ ወራነኒሩ፤</para>
  <para style="q2" vid="PSA 38:2">ሀርክኬስ አከ መሌ ነት ኡልፋቴረ።<verse eid="PSA 38:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 38:3"/>ሰበቢ ዼከምሰኬቲቲፍ ዸግንኮ ፈያ ዸቤረ፤</para>
  <para style="q2" vid="PSA 38:3">ሰበቢ ጩቡኮቲፍስ ለፌንኮ ነጋ ዸቤረ።<verse eid="PSA 38:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 38:4"/>ጩቡንኮ ነ ልቅምሴራቲ፤</para>
  <para style="q2" vid="PSA 38:4">አኩመ በኣ ባተሙ ህንደንደአምኔ ቶኮትስ ነት ኡልፋቴረ።<verse eid="PSA 38:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 38:5"/>ሰበቢ ጎዉማኮቲቲፍ፣</para>
  <para style="q2" vid="PSA 38:5">መዳንኮ መላ ነቀቴ፤ ንአጃኤስ።<verse eid="PSA 38:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 38:6"/>አን ገድ ነንቀበሜ፤ ገድስ ነንጨቤ፤</para>
  <para style="q2" vid="PSA 38:6">ጉያ ጉቱስ ገዳን ኦለ።<verse eid="PSA 38:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 38:7"/>ዱግድኮ ነ ቦበአ፤</para>
  <para style="q2" vid="PSA 38:7">ዸግንኮስ ፈያ ህንቀቡ።<verse eid="PSA 38:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 38:8"/>አን ላፌረ፤ አከ መሌስ ቡቱቴረ፤</para>
  <para style="q2" vid="PSA 38:8">ገራንኮ ዽጰቴ አን ኣዳን ጅረ።<verse eid="PSA 38:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 38:9"/>ያ ጎፍታ፣ ሀዊንኮ ሁንድኑ ፉለኬ ዱረት ቤከማዸ፤</para>
  <para style="q2" vid="PSA 38:9">አርገንሱንኮ ስ ዱራ ህንዾከቱ።<verse eid="PSA 38:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 38:10"/>ለጴንኮ ንዸአት፤ ጅልብስ ነ ላፌረ፤</para>
  <para style="q2" vid="PSA 38:10">እፍን እጀኮቲስ በዴረ።<verse eid="PSA 38:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 38:11"/>ምቾትንኮፊ ሚልቶትንኮ ሰበቢ መዳኮቲቲፍ ነራ ሂቀን፤</para>
  <para style="q2" vid="PSA 38:11">ፍሮንኮስ ነራ ፈጋተኒ ዸዻበቱ።<verse eid="PSA 38:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 38:12"/>ወር ሉቡኮ ገላፈቹ በርባደን ክዮ ና ካአኒሩ፤</para>
  <para style="q2" vid="PSA 38:12">ወር ነ ሚዹ በርባደንስ ዋኤ በዲሰኮቲ ዱበቱ፤</para>
  <para style="q2" vid="PSA 38:12">ጉያ ጉቱስ ሀምነ ነት ያዱ።<verse eid="PSA 38:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 38:13"/>አን ገሩ አኩመ ዱዳ ዸገኡ ህንደንዴኜ፣</para>
  <para style="q2" vid="PSA 38:13">አኩመ አረብ-ድዳ ዱበቹ ህንደንዴኜቲ።<verse eid="PSA 38:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 38:14"/>አን አከ ነመ ዸገኡ ህንደንዴኜ፣</para>
  <para style="q2" vid="PSA 38:14">አኩመ ነመ አፋንሳ ዴቢ ኬኑ ህንደንዴኜስ ተኤረ።<verse eid="PSA 38:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 38:15"/>ያ <char style="nd">ዋቀዮ</char>፣ አን ስን ኤገዸ፤</para>
  <para style="q2" vid="PSA 38:15">ያ ዋቀዮ ጎፍታኮ፣ አት ዴቢ ና ኬንተ።<verse eid="PSA 38:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 38:16"/>አን፣ “አከ ዲኖትንኮ ነት ገመደን</para>
  <para style="q2" vid="PSA 38:16">ዮካን አከ እሳን ዬሮ ሚልኮ ሙጩጫቱት ነት ኦፍ ጀጀን</para>
  <para style="q2" vid="PSA 38:16">ህንኤየምን” ጄዼራቲ።<verse eid="PSA 38:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 38:17"/>አን ኩፉ ገኤራቲ፤</para>
  <para style="q2" vid="PSA 38:17">ዹኩቢንኮስ ተኩማ ነ ህንዺፍኔ።<verse eid="PSA 38:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 38:18"/>አን በሌሳኮ ነንህመዸ፤</para>
  <para style="q2" vid="PSA 38:18">ሰበቢ ጩቡኮቲቲፍስ ነንገደ።<verse eid="PSA 38:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 38:19"/>ወር አከሱማን ዲኖተኮ ተአን ጀጀቦዸ፤</para>
  <para style="q2" vid="PSA 38:19">ወር ሰበቢ መሌ ነ ጅበንስ ሄዱዸ።<verse eid="PSA 38:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 38:20"/>ወር ቆደ ዋን ጋሪ ዋን ሀማ ና ዴብሰን ዲኖተኮት፤</para>
  <para style="q2" vid="PSA 38:20">አን ዋን ጋሪ ዱካ ነንቡኣቲ።<verse eid="PSA 38:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 38:21"/>ያ <char style="nd">ዋቀዮ</char>፣ አት ነ ህንገትን፤</para>
  <para style="q2" vid="PSA 38:21">ያ ዋቀኮ፣ ነራ ህንፈጋትን።<verse eid="PSA 38:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 38:22"/>ያ ጎፍታ፣ ያ ፈይሳኮ፣</para>
  <para style="q2" vid="PSA 38:22">ነ ገርጋሩዻፍ አሪፈዹ!<verse eid="PSA 38:22"/></para>
  <chapter eid="PSA 38"/>
  <chapter number="39" style="c" sid="PSA 39"/>
  <para style="cl">ፋርፈትና 39</para>
  <para style="ms1">ፉለ ዋቃ ዱረት ነምን ጥናዸ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ዬዱቱኒፍ። ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 39:1"/>አን አከነ ነንጄዼ፤ “አን ከራኮ ነንኤገዸ፤</para>
  <para style="q2" vid="PSA 39:1">አረበኮስ ጩቡራ ነንእትሰ፤</para>
  <para style="q1" vid="PSA 39:1">ሀመ ነምን ሀማን ነ ብረ ጅሩትስ፣</para>
  <para style="q2" vid="PSA 39:1">አፋንኮት ሉገመ ነንካአዸ።”<verse eid="PSA 39:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 39:2"/>አን ጨልእሴ አኩመ ዱዳ ነንተኤ፤</para>
  <para style="q2" vid="PSA 39:2">ዋን ጋሪ ዱበቹራስ ኦፍ ነንቁሰዼ፤</para>
  <para style="q2" vid="PSA 39:2">ዽጵንኮ ገሩ እቱመ ጫሌ፤<verse eid="PSA 39:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 39:3"/>ኦኔንኮ ነ ኬሰት ቡሉቃ ዴሜ፤</para>
  <para style="q2" vid="PSA 39:3">ዬሮ አንረ ዴዴብኤ ያዴትስ እብድ ሱን ንቦበኤ፤</para>
  <para style="q2" vid="PSA 39:3">አንስ አረበኮቲን አከነ ጄዼን ዱበዼ፦<verse eid="PSA 39:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 39:4"/>ያ <char style="nd">ዋቀዮ</char>፣ አት ዹመ ጅሬኘኮቲ ነ አርግሲስ፤</para>
  <para style="q2" vid="PSA 39:4">ዼርነ ኡሙሪኮቲስ ነ በርሲስ፤</para>
  <para style="q2" vid="PSA 39:4">ጅሬኝኮ አከም ደፌ አከ ደርቡስ ነ ቤክስስ።<verse eid="PSA 39:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 39:5"/>ኩኖ፣ አት በረኮ ታኩ ቶክቲ ጎቴርተ፤</para>
  <para style="q2" vid="PSA 39:5">ኡሙሪንኮስ ፉለኬ ዱረት ሆማቱ ህንሄደሙ፤</para>
  <para style="q2" vid="PSA 39:5">ጅሬኝ ነመ ሁንዱማስ አኩመ ቅሌንሰ ሹፍ ጄዼ ደርቡት።<verse eid="PSA 39:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 39:6"/>ዹጉመዩ ነምን አኩመ ጋድዱ ዴዴብአ፤</para>
  <para style="q2" vid="PSA 39:6">ዹጉማን እን አከሱማን ጎለመ፤</para>
  <para style="q2" vid="PSA 39:6">ነምን ቀቤኘ ንኩሰ፤ ገሩ ኤኙፍ አከ ወልት ቀቡ ህንቤኩ።<verse eid="PSA 39:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 39:7"/>“ኤጋ አመ ያ ጎፍታ፣ አን ማልን ኤገዸ?</para>
  <para style="q2" vid="PSA 39:7">አብዲንኮ ሱመረ ጅረ።<verse eid="PSA 39:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 39:8"/>ዶጎጎረኮ ሁንደራ ነ ኦልች፤</para>
  <para style="q2" vid="PSA 39:8">ነመ ጎዎትን እት ኮልፈን ነ ህንጎዽን።<verse eid="PSA 39:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 39:9"/>አን ዱዳዸ፤ አፋንኮስ ህንሳቀዹ፤</para>
  <para style="q2" vid="PSA 39:9">ከን ዋን ከነ ጎዼ ሱማቲ።<verse eid="PSA 39:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 39:10"/>አን ሩኩታ ሀርከኬቲቲን ዹሜራቲ፤</para>
  <para style="q2" vid="PSA 39:10">ዸእቸኬ ነራ ፉዽ።<verse eid="PSA 39:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 39:11"/>አት ሰበቢ ጩቡሳኒቲፍ ነሞተ እፈተ፤ ንአደብደስ፤</para>
  <para style="q2" vid="PSA 39:11">አኩመ ብሊስ ቀቤኘሳኒ ንበሌስተ፤</para>
  <para style="q2" vid="PSA 39:11">ዹጉማን ነምን ሁንድኑ ቅሌንሱመ ሹፍ ጄዼ ደርቡዸ።<verse eid="PSA 39:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 39:12"/>“ያ <char style="nd">ዋቀዮ</char>፣ ከዸትናኮ ና ዸገእ፤</para>
  <para style="q2" vid="PSA 39:12">እየ አን ገርጋርሰ በርባቻፍ እዩስ ዸጌፈዹ፤</para>
  <para style="q2" vid="PSA 39:12">ቦእቸኮስ ጨልእስቴ ህንእላልን።</para>
  <para style="q1" vid="PSA 39:12">አን አከ አለጋት ስ ብረ ነንጅራዻቲ፤</para>
  <para style="q2" vid="PSA 39:12">አኩመ አቦቲኮ ሁንዱማትስ አን ነመ ብየ ኦርማት።<verse eid="PSA 39:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 39:13"/>ኡቱን ጎዳኔ ለፈራ ህንዸበምን ዱረ</para>
  <para style="q2" vid="PSA 39:13">አከን ዴብኤ ገመዱፍ፣ እጀኬ ነራ ዴብፈዹ።”<verse eid="PSA 39:13"/></para>
  <chapter eid="PSA 39"/>
  <chapter number="40" style="c" sid="PSA 40"/>
  <para style="cl">ፋርፈትና 40</para>
  <para style="ms1">ፋርፈትና ገለታቲፊ ከዸትና</para>
  <para style="mr">
    <ref loc="PSA 40:13-17">40፥13‑17</ref> ኩወፈ – <char style="xt"><ref loc="PSA 70:1-5">ፋር 70፥1‑5</ref></char></para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 40:1"/>አን ኦብሳን <char style="nd">ዋቀዮን</char> ነንኤገዼ፤</para>
  <para style="q2" vid="PSA 40:1">እንስ ገረኮት ገረገሌ እየኮ ና ዸገኤ።<verse eid="PSA 40:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 40:2"/>እን ቦለ ሶዳችሳ ኬሳ፣</para>
  <para style="q2" vid="PSA 40:2">ዾቄ ነመ ልቅምሱ ኬሳስ ነ ባሴ፤</para>
  <para style="q1" vid="PSA 40:2">ሚለኮ ከታረ ዻቤ፤</para>
  <para style="q2" vid="PSA 40:2">ኤጄተኮስ ና ጀቤሴ።<verse eid="PSA 40:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 40:3"/>እንስ ፋርፈትና ሃራ፣</para>
  <para style="q2" vid="PSA 40:3">ፋርፈትና ገለታስ አፋንኮ ኬሰ <optbreak/> ዋቀኬኛፍ ካኤ።</para>
  <para style="q1" vid="PSA 40:3">ነሞትን ባይኤን አርገኒ <char style="nd">ዋቀዮ</char> ሶዳቱ፤</para>
  <para style="q2" vid="PSA 40:3">እሰስ ንአመነቱ።<verse eid="PSA 40:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 40:4"/>ነምን <char style="nd">ዋቀዮን</char> አብደቱ፣</para>
  <para style="q2" vid="PSA 40:4">ከን ገረ ኦፍ ቱልቶታ ህንእላሌ፣</para>
  <para style="q1" vid="PSA 40:4">ነምን ወረ ከራራ ጀልአተኒ</para>
  <para style="q2" vid="PSA 40:4">ዋቆተ ሶባ ዱካ ቡእንት ህንገረ ገሌ <optbreak/> ኤብፈማዸ።<verse eid="PSA 40:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 40:5"/>ያ <char style="nd">ዋቀዮ</char> ዋቀኮ፣</para>
  <para style="q2" vid="PSA 40:5">ድንቂን አት ሆጄቴ ባይኤዸ፤</para>
  <para style="q1" vid="PSA 40:5">ዋን አት ኑፍ ያዴ፣</para>
  <para style="q2" vid="PSA 40:5">ነምን ቶኮ ቶኮን ስት ህሙ ደንደኡ</para>
  <para style="q2" vid="PSA 40:5">ቶኮዩ ህንጅሩ፤</para>
  <para style="q1" vid="PSA 40:5">ዮ አን ዋኤሳኒ ለብሴ ዱበዼሌ፣</para>
  <para style="q2" vid="PSA 40:5">ባይእንሳኒ ሀመ ህንቀቡ።<verse eid="PSA 40:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 40:6"/>አት ኣርሳፊ ኬና ህንፌኔ፤</para>
  <para style="q2" vid="PSA 40:6">ጉረኮ ገሩ ና በንቴርተ፤</para>
  <para style="q2" vid="PSA 40:6">ኣርሳ ጉበሙፊ ኣርሳ ጩቡ አት ህንበርባድኔ።<verse eid="PSA 40:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 40:7"/>ዬሮ ሰነ አን አከነ ነንጄዼ፤ “አን ኩኖት፤ አን ዹፌረ፤</para>
  <para style="q2" vid="PSA 40:7">ዋኤንኮ ክታበ መረማ ኬሰት በሬፈሜረ።<verse eid="PSA 40:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 40:8"/>ያ ዋቀኮ፣ አን ፌዺኬ ራወቹት ነንገመደ፤</para>
  <para style="q2" vid="PSA 40:8">ሴርኬ ገራኮ ኬሰ ጅረ።”<verse eid="PSA 40:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 40:9"/>አን ያኢ ጉዳ ኬሰት ቀጄሉማ ነንለብሰ፤</para>
  <para style="q2" vid="PSA 40:9">ያ <char style="nd">ዋቀዮ</char>፣ አኩመ አት ቤክቱ፣</para>
  <para style="q2" vid="PSA 40:9">አን አፋንኮ ህንቀበዹ።<verse eid="PSA 40:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 40:10"/>አን ቀጄሉማኬ ገራኮ ኬሰ ህንዾክሱ፤</para>
  <para style="q2" vid="PSA 40:10">ዋኤ አመነሙማኬቲቲፊ ዋኤ ፈይሱኬቲ ነንኦዴሰ፤</para>
  <para style="q1" vid="PSA 40:10">ጃለለኬቲፊ ዹጋኬስ</para>
  <para style="q2" vid="PSA 40:10">ያኢ ጉዳ ዱራ ህንዾክሱ።<verse eid="PSA 40:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 40:11"/>ያ <char style="nd">ዋቀዮ</char> አራረኬ ነ ህንዾወትን፤</para>
  <para style="q2" vid="PSA 40:11">ጃለልኬቲፊ ዹጋንኬ ዬሮ ሁንደ አነ ሃኤገን።<verse eid="PSA 40:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 40:12"/>ረክን ሀመ ህንቀብኔ ነ መርሴራቲ፤</para>
  <para style="q2" vid="PSA 40:12">ጩቡንኮስ ነ ልቅምሴረ፤ አርጉስ ደዸቤረ፤</para>
  <para style="q1" vid="PSA 40:12">ጩቡንኮ ርፌንሰ መታኮ ጫላ ባይአተ፤</para>
  <para style="q2" vid="PSA 40:12">ኦኔንኮስ ነ ኬሰት ላፍቴርት።<verse eid="PSA 40:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 40:13"/>ያ <char style="nd">ዋቀዮ</char>፣ ነ ፈይሱት ገመድ፤</para>
  <para style="q2" vid="PSA 40:13">ያ <char style="nd">ዋቀዮ</char>፣ ነ ገርጋሩዻፍ ደፊ ኮቱ።<verse eid="PSA 40:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 40:14"/>ወር ሉቡኮ ገላፈቹ በርባደን ሁንድኑ፣</para>
  <para style="q2" vid="PSA 40:14">ሃቃነአን፤ ሃቡርጃጀአንስ።</para>
  <para style="q1" vid="PSA 40:14">ወር በዲኮ ሀወን ሁንድ፣</para>
  <para style="q2" vid="PSA 40:14">ቃነአኒ ዱበት ሃዴብአን።<verse eid="PSA 40:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 40:15"/>ወር፣ “በገ! በገ!” አናን ጄዸን፣</para>
  <para style="q2" vid="PSA 40:15">ቃኒሳኒቲን ሃርፈተን።<verse eid="PSA 40:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 40:16"/>ወር ስ በርባደን ሁንድኑ ገሩ</para>
  <para style="q2" vid="PSA 40:16">ስት ገመደኒ ሃእልልቸን።</para>
  <para style="q1" vid="PSA 40:16">ወር ፈይሱኬ ጃለተን ዬሮ ሁንደ፣</para>
  <para style="q2" vid="PSA 40:16">“<char style="nd">ዋቀዮ</char> ጉዳዸ!” ሃጄዸን።<verse eid="PSA 40:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 40:17"/>አን ገሩ ህዬሳፊ ረከታዸ፤</para>
  <para style="q2" vid="PSA 40:17">ተኡስ ጎፍታን ናፍ ያደ።</para>
  <para style="q1" vid="PSA 40:17">አት ገርጋርሰኮፊ ፈይሳኮት፤</para>
  <para style="q2" vid="PSA 40:17">ያ ዋቀኮ፣ ህንቱርን።<verse eid="PSA 40:17"/></para>
  <chapter eid="PSA 40"/>
  <chapter number="41" style="c" sid="PSA 41"/>
  <para style="cl">ፋርፈትና 41</para>
  <para style="ms1">ከዸትና ነመ ዹኩብሰቴ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 41:1"/>ነምን ህዬሳፍ ያዱ ኤብፈማዸ፤</para>
  <para style="q2" vid="PSA 41:1">ጉያ ረክናት <char style="nd">ዋቀዮ</char> እሰ ንኦልቸ።<verse eid="PSA 41:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 41:2"/>
    <char style="nd">ዋቀዮ</char> እሰ ንኤገ፤ በረ ጅሬኘሳስ ንዼሬሰ፤</para>
  <para style="q2" vid="PSA 41:2">ለፈረት እሰ ኤብሰ፤</para>
  <para style="q2" vid="PSA 41:2">ሀዊ ዲኖተ እሳትስ ደበርሴ እሰ ህንኬኑ።<verse eid="PSA 41:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 41:3"/>
    <char style="nd">ዋቀዮ</char> ስሬ እን ዹኩብሰቴረ ጪሱረት እሰ ኩኑንሰ፤</para>
  <para style="q2" vid="PSA 41:3">ፈይሴስ ስሬ ዹኩባራ እሰ ንካሰ።<verse eid="PSA 41:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 41:4"/>አንስ፣ “ያ <char style="nd">ዋቀዮ</char> ነ ማር፤</para>
  <para style="q2" vid="PSA 41:4">አን ጩቡ ስት ሆጄዼራቲ ነ ፈይስ” ነንጄዼ።<verse eid="PSA 41:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 41:5"/>ዲኖትንኮ ሀምናን፣ “እን ዮም ዱኤ መቃንሳ</para>
  <para style="q2" vid="PSA 41:5">ለፈራ በደ?” ጄዸኒ ዋኤኮ ዱበቱ።<verse eid="PSA 41:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 41:6"/>ነምን ቶኮ ዬሮ ነ ጋፈቹ ዹፉት፣</para>
  <para style="q2" vid="PSA 41:6">ኡቱመ ገራሳት ሀምነ ኩፈቴ ቀቡ፣ ሶቤ ዱበተ፤</para>
  <para style="q2" vid="PSA 41:6">ገድ በኤስ እዶ ሁንዱመት ኦዴሰ።<verse eid="PSA 41:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 41:7"/>ወር ነ ጅበን ሁንድኑ ዋኤኮ ወልት ሀሳሱ፤</para>
  <para style="q2" vid="PSA 41:7">ዋን አከ መሌ ሀማ ተኤስ ነት መርአቱ።<verse eid="PSA 41:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 41:8"/>እሳንስ፣ “ዹኩብን ሀማን እሰ ቀበቴረ፤</para>
  <para style="q2" vid="PSA 41:8">እን ስአች እዶ ጪሱ ሰና ህንከኡ” ጄዹ።<verse eid="PSA 41:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 41:9"/>ምቹንኮ እን ነት ዽኣቱ፣</para>
  <para style="q2" vid="PSA 41:9">እን አን አመነዼ፣</para>
  <para style="q1" vid="PSA 41:9">እን ቡዴነኮ ኛቴ</para>
  <para style="q2" vid="PSA 41:9">ኮሜሳ ነት ኦል ፉዸቴ።<verse eid="PSA 41:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 41:10"/>አት ገሩ ያ <char style="nd">ዋቀዮ</char> ነ ባስ፤</para>
  <para style="q2" vid="PSA 41:10">አከ አን ሃሎ ባፈዹፍስ ኦል ነ ካስ።<verse eid="PSA 41:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 41:11"/>አከ አት ነት ገመዱ አን ቤከ፤</para>
  <para style="q2" vid="PSA 41:11">ዲንኮ ነረ ህንኣኑቲ።<verse eid="PSA 41:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 41:12"/>አት ሰበቢ አመነሙማኮቲቲፍ ኡቱብዴ ነ ቀብደ፤</para>
  <para style="q2" vid="PSA 41:12">በሩመ በራንስ ፉለኬ ዱረ ነ ዻብደ።<verse eid="PSA 41:12"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 41:13"/>
    <char style="nd">ዋቀዮ</char> ዋቅን እስራኤል፣</para>
  <para style="q2" vid="PSA 41:13">በረ በራ ሀመ በረ በራት ሃኤብፈሙ።</para>
  <para style="qc" vid="PSA 41:13">አሜን፤ አሜን።<verse eid="PSA 41:13"/></para>
  <chapter eid="PSA 41"/>
  <chapter number="42" style="c" sid="PSA 42"/>
  <para style="ms">ክታበ ለመፋ</para>
  <para style="mr">
    <ref loc="PSA 42-72">ፋርፈትና 42–72</ref></para>
  <para style="cl">ፋርፈትና 42</para>
  <para style="ms1">ዋቀዮን ዼቦቹ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። <char style="tl">መስኪሊ</char> እልማን ቆራህ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 42:1"/>አኩመ ገደምስ ብሻን ያኡት ገገቡ ሰነ፣</para>
  <para style="q2" vid="PSA 42:1">ያ ዋቀኮ፣ ሉቡንኮ ስት ገገብድ።<verse eid="PSA 42:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 42:2"/>ሉቡንኮ ዋቀዮን ዋቀ ጅራታ ዼቦት።</para>
  <para style="q2" vid="PSA 42:2">አን ዮምን ዸቄ ፉለ ዋቃ አርገ?<verse eid="PSA 42:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 42:3"/>እምማንኮ ሀልከኒ ጉያ ሶረ ና ተኤረ፤</para>
  <para style="q2" vid="PSA 42:3">ነሞትን ጉያ ጉቱ “ዋቅንኬ ኤሰ ጅረ?” አናን ጄዹቲ።<verse eid="PSA 42:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 42:4"/>አን ዮሙን ዋን ከነ ያደዹት፣</para>
  <para style="q2" vid="PSA 42:4">ሉቡኮ ኦፍ ኬሰት ነንዸንገላሰ፦</para>
  <para style="q1" vid="PSA 42:4">እልሌፊ ፋርፈትና ገለታቲን</para>
  <para style="q2" vid="PSA 42:4">ቱተ አያነ አያኔፈቱ ቶኮ፣</para>
  <para style="q1" vid="PSA 42:4">ህሪራን ገረ መነ ዋቃት ጌጌሳ</para>
  <para style="q2" vid="PSA 42:4">ቱትቸ ወጅን አከምት አከ አን ዴማ ቱሬ ያደዸ።<verse eid="PSA 42:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 42:5"/>ያ ሉቡኮ፣ አት ማሊፍ ገድተ?</para>
  <para style="q2" vid="PSA 42:5">ነ ኬሰትስ ማሊፍ ራፈምተ?</para>
  <para style="q1" vid="PSA 42:5">አብዲኬ ዋቀረ ኬየዹ፤</para>
  <para style="q2" vid="PSA 42:5">አን አመዩ እሰ ነንጀጀዸ።</para>
  <para style="q2" vid="PSA 42:5">ፈይሳኮፊ ዋቀኮ ነንጀጀዸ።<verse eid="PSA 42:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 42:6"/>ሉቡንኮ ነ ኬሰት ገድቴርት፤</para>
  <para style="q2" vid="PSA 42:6">ከናፉ አን ብየ ዮርዳኖስራ፣</para>
  <para style="q1" vid="PSA 42:6">ፊጤ ሄርሞኒፊ</para>
  <para style="q2" vid="PSA 42:6">ጋረ ሚዛሪራ ስ ያደዸ።<verse eid="PSA 42:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 42:7"/>ሁርሳ ፍንጫኣኬቲቲን፣</para>
  <para style="q2" vid="PSA 42:7">ቱጁብን ቱጁበ ዋመ፤</para>
  <para style="q2" vid="PSA 42:7">ደምበሊፊ ዸኣንኬ ሁንድኑ፣ ነረ ያአን።<verse eid="PSA 42:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 42:8"/>
    <char style="nd">ዋቀዮ</char> ጉያዻን ጃለለሳ ከን ህንጌደረምኔ ንአጀጀ፤</para>
  <para style="q2" vid="PSA 42:8">ሀልከንሞ ፋርፈናንሳ ነ ወጅን ጅረ፤</para>
  <para style="q2" vid="PSA 42:8">ኩንስ ከዸትና አን ዋቀ ጅሬኘኮቲ ከዸዹዸ።<verse eid="PSA 42:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 42:9"/>አንስ ዋቀ ከታኮቲን አከነ ነንጄዸ፤</para>
  <para style="q2" vid="PSA 42:9">“አት ማሊፍ ነ ደገቴ?</para>
  <para style="q2" vid="PSA 42:9">ማሊፍ አን ዲናን ጩንቁርፈሜ ገዳን ጅራዸ?”<verse eid="PSA 42:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 42:10"/>አመጃጆንኮ ጉያ ጉቱ፣</para>
  <para style="q2" vid="PSA 42:10">“ዋቅንኬ ኤሰ ጅረ?” ጄዸኒ ነት ቆሱዻን፣</para>
  <para style="q2" vid="PSA 42:10">አኩመ ጎራዴ ለፌኮ ኬሳት ነ ዽጵሱ።<verse eid="PSA 42:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 42:11"/>ያ ሉቡኮ፣ አት ማሊፍ ገድተ?</para>
  <para style="q2" vid="PSA 42:11">ነ ኬሰትስ ማሊፍ ራፈምተ?</para>
  <para style="q1" vid="PSA 42:11">አብዲኬ ዋቀረ ካአዹ፤</para>
  <para style="q2" vid="PSA 42:11">አን አመዩ እሰ ነንገለቴፈዸ፤</para>
  <para style="q2" vid="PSA 42:11">ፈይሳኮፊ ዋቀኮ ነንጀጀዸ።<verse eid="PSA 42:11"/></para>
  <chapter eid="PSA 42"/>
  <chapter number="43" style="c" sid="PSA 43"/>
  <para style="cl">ፋርፈትና 43</para>
  <para style="ms1">ቱምሳፊ ፉረመ በርባቻፍ ከዸቹ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 43:1"/>ያ ዋቅ፣ ና ሙርቴስ፤</para>
  <para style="q2" vid="PSA 43:1">ሰበ ህንአመነሜት ዱቢኮ ና ፈልም፤</para>
  <para style="q2" vid="PSA 43:1">ጎዎምስቶታፊ ጀልኦተ ጀላስ ነ ባስ።<verse eid="PSA 43:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 43:2"/>አት ዋቀ ጀብነኮቲት።</para>
  <para style="q2" vid="PSA 43:2">ማሊፍ ነ ገቴ?</para>
  <para style="q1" vid="PSA 43:2">አን ማሊፍን ዲናን ጩንቁርፈሜ</para>
  <para style="q2" vid="PSA 43:2">ገዳን ጅራዸ?<verse eid="PSA 43:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 43:3"/>እፈኬቲፊ ዹጋኬ ኤርግ፤</para>
  <para style="q2" vid="PSA 43:3">እሳን ነ ሃቀጄልቸን፤</para>
  <para style="q1" vid="PSA 43:3">ገረ ቱሉኬ ቁልቁሉት፣</para>
  <para style="q2" vid="PSA 43:3">ገረ እዶ አት ጅራቱ ሰናት አነ ሃፍደን።<verse eid="PSA 43:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 43:4"/>ዮስ አን ገረ እዶ ኣርሳ ዋቃ፣</para>
  <para style="q2" vid="PSA 43:4">ገረ ዋቀ ገመቹፊ እልሌኮ ነንዸቀ።</para>
  <para style="q1" vid="PSA 43:4">ያ ዋቀዮ፣ ዋቀኮ፣</para>
  <para style="q2" vid="PSA 43:4">አን በገናዻን ስን ገለቴፈዸ።<verse eid="PSA 43:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 43:5"/>ያ ሉቡኮ፣ አት ማሊፍ ገድተ?</para>
  <para style="q2" vid="PSA 43:5">ነ ኬሰትስ ማሊፍ ራፈምተ?</para>
  <para style="q1" vid="PSA 43:5">አብዲኬ ዋቀረ ካአዹ፤</para>
  <para style="q2" vid="PSA 43:5">አን አመዩ እሰ ነንገለቴፈዸ፤</para>
  <para style="q2" vid="PSA 43:5">ፈይሳኮፊ ዋቀኮ ነንጀጀዸ።<verse eid="PSA 43:5"/></para>
  <chapter eid="PSA 43"/>
  <chapter number="44" style="c" sid="PSA 44"/>
  <para style="cl">ፋርፈትና 44</para>
  <para style="ms1">ፋሩ ቦእቻ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። <char style="tl">መስኪሊ</char> እልማን ቆራህ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 44:1"/>ያ ዋቅ፣ ዋን አት በረ ዱሪ፣</para>
  <para style="q2" vid="PSA 44:1">ጀበነሳኒ ኬሰ ሆጄቴ ሰነ፣</para>
  <para style="q1" vid="PSA 44:1">አቦቲንኬኘ ኑት ህመኒሩ፤</para>
  <para style="q2" vid="PSA 44:1">ኑስ ጉረኬኛን ዸጌኜረ።<verse eid="PSA 44:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 44:2"/>አት ሀርከኬቲን ሰቦተ አሪቴ ባፍቴ፤</para>
  <para style="q2" vid="PSA 44:2">አቦቲኬኘሞ ንዻብዴ፤</para>
  <para style="q1" vid="PSA 44:2">ነሞተ ንበሌስቴ፤</para>
  <para style="q2" vid="PSA 44:2">አቦቲኬኘ ገሩ ብልሰ ባፍቴ።<verse eid="PSA 44:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 44:3"/>ሀርከኬ ምርጋቲን፣ እሬኬቲፊ እፈ ፉለኬቲቲን ዻለን መሌ</para>
  <para style="q2" vid="PSA 44:3">እሳን ጎራዴሳኒቲን ለፈ ሰነ ህንዻሌ፤</para>
  <para style="q1" vid="PSA 44:3">ዮካን እሬንሳኒ ሞአትኖ እሳኒፍ ህንፍድኔ፤</para>
  <para style="q2" vid="PSA 44:3">አት እሳን ጃለቴርታቲ።<verse eid="PSA 44:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 44:4"/>አት ሞቲኮፊ ዋቀኮ</para>
  <para style="q2" vid="PSA 44:4">ከን ያቆቢፍ ሞእቸ አጀጁዸ።<verse eid="PSA 44:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 44:5"/>ኑ ሲን ዲኖተኬኘ ዱበት ዴብፍነ፤</para>
  <para style="q2" vid="PSA 44:5">መቃኬቲንስ አመጃጆተኬኘ ገድ ዽዺትነ።<verse eid="PSA 44:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 44:6"/>አን እዳኮ ህንአመነዹ፤</para>
  <para style="q2" vid="PSA 44:6">ጎራዴንኮስ ሞአትና ና ህንፍዱ፤<verse eid="PSA 44:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 44:7"/>አት ገሩ ዲኖተኬኘ ጀላ ኑ ኦልችተ፤</para>
  <para style="q2" vid="PSA 44:7">ወረ ኑ ጅበንሞ ንቃኔስተ።<verse eid="PSA 44:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 44:8"/>ኑ ዬሮ ሁንዱማ ዋቃን ዻደትነ፤</para>
  <para style="q2" vid="PSA 44:8">መቃኬስ በረ በራን ንገለቴፈትነ።<verse eid="PSA 44:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 44:9"/>አመ ገሩ አት ኑ ገቴርተ፤ ገድስ ኑ ዴብፍቴርተ፤</para>
  <para style="q2" vid="PSA 44:9">አት ሎልቶተኬኘ ወጅን ህንባኔ።<verse eid="PSA 44:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 44:10"/>አከ ኑ ዲኖተኬኘ በቀኑ ኑ ጎቴርተ፤</para>
  <para style="q2" vid="PSA 44:10">ወር ኑ ጅበንስ ኑ ሳመኒሩ።<verse eid="PSA 44:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 44:11"/>አት አከ ሆሎተ ቀለሙፍ ቆጴፈመኒ ኑ ጎቴርተ፤</para>
  <para style="q2" vid="PSA 44:11">ኦርሞተ ኬሰስ ኑ ብትኔስቴርተ።<verse eid="PSA 44:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 44:12"/>ሰበኬ ገቲ ጥናት ጉርጉርቴርተ፤</para>
  <para style="q2" vid="PSA 44:12">ጉርጉርታሳኒራስ ቡኣ ህንአርገኔ።<verse eid="PSA 44:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 44:13"/>ኦላኬኘ ዱረት ነመ ኮልፋ፣</para>
  <para style="q2" vid="PSA 44:13">ወረ ናኖኬኛ ብረትስ <optbreak/> ዋን ቆሳቲፊ ነመ ቱፊ ኑ ጎቴርተ።<verse eid="PSA 44:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 44:14"/>ኦርሞተ ኬሰት ዋን መማክሳ ኑ ጎቴ፤</para>
  <para style="q2" vid="PSA 44:14">ነሞትንስ መታ ኑት ራሰን።<verse eid="PSA 44:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 44:15"/>ሰልጵንኮ ጉያ ጉቱ ፉለኮ ዱረ ጅረ፤</para>
  <para style="q2" vid="PSA 44:15">ፉልኮስ ቃኒዻን ሀጉገሜረ።<verse eid="PSA 44:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 44:16"/>ኩንስ ሰበቢ ዱቢ ወረ ነ ቱፈተኒቲፊ ወረ ነ አረብሰኒቲፍ፣</para>
  <para style="q2" vid="PSA 44:16">ሰበቢ ዲናቲፊ ሰበቢ ነመ ሃሎ ባፈቱቲፍ ተኤ።<verse eid="PSA 44:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 44:17"/>ኩን ሁንድ ኑት ዹፌረ፤</para>
  <para style="q2" vid="PSA 44:17">ተኡስ ኑ ስ ህንደገትኔ፤</para>
  <para style="q2" vid="PSA 44:17">ዮካን ከኩኬ ኬሰት አመነሙማ ህንዸብኔ።<verse eid="PSA 44:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 44:18"/>ገራንኬኘ ዱግደ ዱበት ህንዴብኔ፤</para>
  <para style="q2" vid="PSA 44:18">ተርካንፊንኬኘስ ከራኬራ ህንጀልአትኔ።<verse eid="PSA 44:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 44:19"/>አት ገሩ እዶ ዋንጎትን ጅራተንት ኑ ጨጨብስቴ፤</para>
  <para style="q2" vid="PSA 44:19">ዱከነ ሀማዻን ኑ ሀጉግዴ።<verse eid="PSA 44:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 44:20"/>ኡቱ ኑ መቃ ዋቀኬኛ እራንፈትኔ፣</para>
  <para style="q2" vid="PSA 44:20">ዮካን ኡቱ ሀርከኬኘ ገረ ዋቀ ኦርማት በልእፈትኔ ጅራትኔ፣<verse eid="PSA 44:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 44:21"/>ስላ ዋቅን ዋን ከነ ብረ ህንገኡ ቱሬ?</para>
  <para style="q2" vid="PSA 44:21">እን እጪቲ ገራ ነማ ቤካቲ።<verse eid="PSA 44:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 44:22"/>ኑ ሲፍ ጄኔ ጉያ ጉቱ ንአጄፈምነ፤</para>
  <para style="q2" vid="PSA 44:22">አከ ሆሎተ ቀለሙፍ ጅረኒትስ ለካአምኔረ።<verse eid="PSA 44:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 44:23"/>ያ ጎፍታ ደመቅ! አት ማሊፍ ረፍተ?</para>
  <para style="q2" vid="PSA 44:23">ከእ! በረ በራንስ ኑ ህንገትን።<verse eid="PSA 44:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 44:24"/>አት ማሊፍ ፉለኬ ዾክፈተ?</para>
  <para style="q2" vid="PSA 44:24">ማሊፍስ ዽጵናፊ ሀጩጨሙኬኘ እራንፈተ?<verse eid="PSA 44:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 44:25"/>ሉቡንኬኘ ብዮት ደበለምቴርቲ፤</para>
  <para style="q2" vid="PSA 44:25">ገራንኬኘስ ለፈት መጠኔረ።<verse eid="PSA 44:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 44:26"/>ከኢቲ ኑ ገርጋር፤ ሰበቢ ጃለለኬ</para>
  <para style="q2" vid="PSA 44:26">ከን ህንጌደረምኔቲፍስ ኑ ፉር።<verse eid="PSA 44:26"/></para>
  <chapter eid="PSA 44"/>
  <chapter number="45" style="c" sid="PSA 45"/>
  <para style="cl">ፋርፈትና 45</para>
  <para style="ms1">ፋርፈትና ጭዸ ሞቲ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ዬደሎ እልማን ቆራህ ከን “ደራራ” ጄዸሙ። <char style="tl">መስኪል።</char> ፋርፈትና ጭዻ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 45:1"/>ዮሙ አን ሞቲዻፍ ፋርፈዹት፣</para>
  <para style="q2" vid="PSA 45:1">ያድን ጋሪን ገራኮ ጉቴረ ዸንገለአ፤</para>
  <para style="q2" vid="PSA 45:1">አረብንኮስ አኩመ ቢሪ በሬሳ ኦጌሰ ቶኮት።<verse eid="PSA 45:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 45:2"/>አት ነመ ሁንዱማ ጫላ ሚዸጋዸ፤</para>
  <para style="q2" vid="PSA 45:2">ህዺኬረ ሱራቱ ዸንገለአ፤</para>
  <para style="q2" vid="PSA 45:2">ከናፉ ዋቅን በረ በራን ስ ኤብሴረ።<verse eid="PSA 45:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 45:3"/>ያ ጎትቸ፣ ጎራዴኬ ሉቄቱት ህዸዹ፤</para>
  <para style="q2" vid="PSA 45:3">ኡልፍናፊ ሱራ ኡፈዹ።<verse eid="PSA 45:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 45:4"/>ሰበቢ ዱቢ ዹጋቲፍ፣ ገድ ኦፍ ቀቢሳፊ ቀጄሉማቲፍ፣</para>
  <para style="q2" vid="PSA 45:4">ሚዸግነኬቲን ሞአናዻን ፉለ ዱረት ጉሉፍ፤</para>
  <para style="q2" vid="PSA 45:4">ሀርክኬ ምርጋስ ሆጂ ሶዳችሳ ሃሆጄቱ።<verse eid="PSA 45:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 45:5"/>ጥየወንኬ ቀረ ቀቤዪን ሱን ኦኔ ዲኖተ ሞቲ ሃወራነን፤</para>
  <para style="q2" vid="PSA 45:5">ሰቦትንስ ሚለኬ ጀለት ሃጅጅገኒ።<verse eid="PSA 45:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 45:6"/>ያ ዋቀዮ፣ ቴሶንኬ በረ በራ ሀመ በረ በራት ንጅራተ፤</para>
  <para style="q2" vid="PSA 45:6">ቦኩን ቀጄሉማስ ቦኩ ሞቱማኬቲ ንተአ።<verse eid="PSA 45:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 45:7"/>አት ቀጄሉማ ጃለተ፤ ጀልእነሞ ንጅብተ፤</para>
  <para style="q2" vid="PSA 45:7">ከናፉ ዋቀዮ፣ ዋቅንኬ ህርዮተኬ ጫላት፣</para>
  <para style="q2" vid="PSA 45:7">ዘይቲዻን ገመቹ ስ ድቤረ።<verse eid="PSA 45:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 45:8"/>ኡፈትንኬ ሁንድኑ ቁምቢዻን፣</para>
  <para style="q2" vid="PSA 45:8">አርጌሳፊ ቁንዺዻን ንኡርጋአ፤</para>
  <para style="q1" vid="PSA 45:8">መሰራወን እልከ አርባቲን ሚዸግፈመን ኬሰትስ</para>
  <para style="q2" vid="PSA 45:8">ሙዚቃን ምአ ርቡ ስ ገመቺሰ።<verse eid="PSA 45:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 45:9"/>እንተለን ሞቶታ ዱበርቶተኬ ወረ ከበጀሞ ኬሰ ጅሩ፤</para>
  <para style="q2" vid="PSA 45:9">ሞትቲንስ ወርቄ ኦፊሪቲን ሚዸግፈምቴ</para>
  <para style="q2" vid="PSA 45:9">ከራ ሀርከ ምርገኬቲ ዻበት።<verse eid="PSA 45:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 45:10"/>ያ እንተላ ዸገእ፤ ሁበዹ፤ ጉረኬስ አስ ቀብ፤</para>
  <para style="q2" vid="PSA 45:10">ሰበኬቲፊ መነ አባኬቲ እራንፈዹ።<verse eid="PSA 45:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 45:11"/>ሞቲን ሚዸግነኬ ሀወ፤</para>
  <para style="q2" vid="PSA 45:11">ዋን እን ጎፍታኬ ተኤፍ እሰ ከበጅ።<verse eid="PSA 45:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 45:12"/>እንተል ጢሮስ ኬና ፍዴ ዹፍት፤</para>
  <para style="q2" vid="PSA 45:12">ሶሬዪንስ ገራ ስ ላፍፈቹ በርባዱ።<verse eid="PSA 45:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 45:13"/>እንተል ሞቲ ኡልፍነ ጉዳዻን ዲንቀሼ ጅርት፤</para>
  <para style="q2" vid="PSA 45:13">ኡፈትን እሼስ ወርቄዻን ዸአሜ።<verse eid="PSA 45:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 45:14"/>እሼንስ ኡፈተ ሀሉ ገራ ገራ ቀቡ ኡፈቴ <optbreak/> ገረ ሞቲት ጌፈምት፤</para>
  <para style="q2" vid="PSA 45:14">ዱርቦን ዋኤልሼስ እሼ ዱካ ቡአኒ <optbreak/> ገረኬት ፍደሙ።<verse eid="PSA 45:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 45:15"/>እሳንስ ገመቹፊ እልሌዻን ኦል ገልፈሙ፤</para>
  <para style="q2" vid="PSA 45:15">መሰራ ሞትቻስ ንሴኑ።<verse eid="PSA 45:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 45:16"/>እልማንኬ እዶ አቦቲኬቲ ቡአን፤</para>
  <para style="q2" vid="PSA 45:16">አትስ ለፈ ሁንደረት እሳን ንሞስፍተ።<verse eid="PSA 45:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 45:17"/>አን አከ መቃንኬ ዸሎተ ሁንደ ኬሰት ያደተሙ ነንጎዸ፤</para>
  <para style="q2" vid="PSA 45:17">ከናፉ ሰቦትን በረ በራ ሀመ በረ በራት ስ ጀጀቱ።<verse eid="PSA 45:17"/></para>
  <chapter eid="PSA 45"/>
  <chapter number="46" style="c" sid="PSA 46"/>
  <para style="cl">ፋርፈትና 46</para>
  <para style="ms1">ዋቀዮ ኑ ወጅን ጅረ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና እልማን ቆራህ። ሃለ <char style="tl">አላሞቲቲን</char>።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 46:1"/>ዋቅን ደኦፊ ጀብነኬኘ፤</para>
  <para style="q2" vid="PSA 46:1">እን ገርጋርሰ ዬሮ ሁንደ ረክነ ኬሰት ኑ ወጅን ጅሩዸ።<verse eid="PSA 46:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 46:2"/>ከናፉ ዮ ለፍት ራፈምቴ</para>
  <para style="q2" vid="PSA 46:2">ቱሉወንስ ገራ ገላና ኬሰ ገድ ቡአንዩ ኑ ህንሶዳትኑ።<verse eid="PSA 46:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 46:3"/>ኡቱ ብሻንሳስ ሁርሴ ሆመቻኤ</para>
  <para style="q2" vid="PSA 46:3">ቱሉወንስ ራፈመሳቲን ሶቾአንዩ ኑ ህንሶዳትኑ።<verse eid="PSA 46:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 46:4"/>ለግን ያኣንሳ መጋላ ዋቃ ገመቺሱ</para>
  <para style="q2" vid="PSA 46:4">ከን እዶ ቁልቁሉ ዋቅን ዋን ሁንዳ ኦሊ ጅራቱፍ <optbreak/> ገመቹ ኬኑ ቶኮ ጅረ።<verse eid="PSA 46:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 46:5"/>ዋቅን መጋለቲ ኬሰ ጅረ፤ እሼንስ ህንራፈምቱ፤</para>
  <para style="q2" vid="PSA 46:5">ገነመ በሪ ዋቅን እሼ ገርጋረ።<verse eid="PSA 46:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 46:6"/>ሰቦትን ንራፈመን፤ ሞቱሞንስ ንኩፈን፤</para>
  <para style="q2" vid="PSA 46:6">እን ሰገሌሳ ዸጌስሴ፤ ለፍትስ ንበቅጤ።<verse eid="PSA 46:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 46:7"/>
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ ኑ ወጅን ጅረ፤</para>
  <para style="q2" vid="PSA 46:7">ዋቅን ያቆብ ደኦኬኘ።<verse eid="PSA 46:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 46:8"/>ኮታ፣ ሆጂ <char style="nd">ዋቀዮ</char> እላላ፤</para>
  <para style="q2" vid="PSA 46:8">በዲሰ እን ለፈረት ፍዴስ አርጋ።<verse eid="PSA 46:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 46:9"/>እን ሀመ ሀንዳረ ለፋት ወራነ ንበሌሰ፤</para>
  <para style="q2" vid="PSA 46:9">እዳ ንጨብሰ፤ ኤቦ ንቡርኩቴሰ፤</para>
  <para style="q2" vid="PSA 46:9">ጋቸነስ እብዳን ጉበ።<verse eid="PSA 46:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 46:10"/>“ጨልእሳ፤ አከ አን ዋቀ ተኤስ ቤካ፤</para>
  <para style="q2" vid="PSA 46:10">አን ሰቦተ ግዱት ኦል ኦል ነንጄዸ፤</para>
  <para style="q2" vid="PSA 46:10">ለፈረትስ ኦል ኦል ነንጄዸ።”<verse eid="PSA 46:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 46:11"/>
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ ኑ ወጅን ጅረ፤</para>
  <para style="q2" vid="PSA 46:11">ዋቅን ያቆብ ደኦኬኘ።<verse eid="PSA 46:11"/></para>
  <chapter eid="PSA 46"/>
  <chapter number="47" style="c" sid="PSA 47"/>
  <para style="cl">ፋርፈትና 47</para>
  <para style="ms1">ዋቀዮ ሞቲ አዱኛት</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና እልማን ቆራህ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 47:1"/>እስን ሰቦትን ሁንድኑ ሀርከኬሰን ሩኩታ፤</para>
  <para style="q2" vid="PSA 47:1">ሰገሌ ኦል ፉዸዻቲ ገመቹዻን ዋቃፍ እልልቻ።<verse eid="PSA 47:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 47:2"/>
    <char style="nd">ዋቀዮ</char> ዋቀ ዋን ሁንዳ ኦሊ፣</para>
  <para style="q2" vid="PSA 47:2">ሞትች ጉዳን ለፈ ሁንዱማ፣ ሶዳችሳዻቲ!<verse eid="PSA 47:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 47:3"/>እን ሰቦተ ኑ ጀለ፣</para>
  <para style="q2" vid="PSA 47:3">ነሞተ ስ ሚለኬኘ ጀለ ገልቼረ።<verse eid="PSA 47:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 47:4"/>እንስ ኑ ወረ ያቆብ እሰ እን ጃለቴ ሰናፍ ኡልፍነ ታኔፍ፣</para>
  <para style="q2" vid="PSA 47:4">ዻለኬኘ ኑ ፍሌረ።<verse eid="PSA 47:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 47:5"/>ዋቅን እልሌዻን፣ <char style="nd">ዋቀዮ</char> ሰገሌ</para>
  <para style="q2" vid="PSA 47:5">መለከታቲን ኦል በኤ።<verse eid="PSA 47:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 47:6"/>ፋርፈትና ገለታ ዋቃፍ ፋርፈዻ፤</para>
  <para style="q2" vid="PSA 47:6">ፋርፈትና ገለታ ፋርፈዻ፤</para>
  <para style="q1" vid="PSA 47:6">ፋርፈትና ገለታ ሞቲኬኛፍ ፋርፈዻ፤</para>
  <para style="q2" vid="PSA 47:6">ፋርፈትና ገለታ ፋርፈዻ።<verse eid="PSA 47:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 47:7"/>ዋቅን ሞቲ ለፈ ሁንዳት፤</para>
  <para style="q2" vid="PSA 47:7">ፋርፈትና ገለታ ሁበትናዻን ፋርፈዻ።<verse eid="PSA 47:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 47:8"/>ዋቅን ሰቦተረት ሞቲዸ፤</para>
  <para style="q2" vid="PSA 47:8">ዋቅን ቴሶሳ ቁልቁሉረ ታኤረ።<verse eid="PSA 47:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 47:9"/>ቆንዳልቶትን ሰቦታ፣</para>
  <para style="q2" vid="PSA 47:9">አኩመ ሰበ ዋቀ አብረሃምት ወልት ቀበሙ፤</para>
  <para style="q1" vid="PSA 47:9">ሞቶትን ለፈራ ከን ዋቃቲ፤</para>
  <para style="q2" vid="PSA 47:9">እንስ ጉድሴ ኦል ኦል ጄዼረ።<verse eid="PSA 47:9"/></para>
  <chapter eid="PSA 47"/>
  <chapter number="48" style="c" sid="PSA 48"/>
  <para style="cl">ፋርፈትና 48</para>
  <para style="ms1">ጥዮን ቱሉ ዋቀዮ</para>
  <para style="d">ዌዱ። ፋርፈትና እልማን ቆራህ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 48:1"/>መጋላ ዋቀኬኛ ኬሰት፣</para>
  <para style="q2" vid="PSA 48:1">ቱሉሳ ቁልቁሉረትስ፣ <char style="nd">ዋቀዮ</char> ጉዳዸ፤</para>
  <para style="q2" vid="PSA 48:1">ዋን ሁንዳ ኦልትስ ገለን እሳፍ መለ።<verse eid="PSA 48:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 48:2"/>ቱሉን ጥዮን ገረ ካባት አርገመ፤</para>
  <para style="q2" vid="PSA 48:2">ዼርነሳቲንስ ንበሬደ።</para>
  <para style="q1" vid="PSA 48:2">እንስ ገመቹ አዱኛ ሁንዳት፤</para>
  <para style="q2" vid="PSA 48:2">መጋላ ሞትቸ ጉዳትስ።<verse eid="PSA 48:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 48:3"/>ዋቅን ደአትኖሼ ኬሰ ጅረ፤</para>
  <para style="q2" vid="PSA 48:3">እን ደአትኖሼ ተኡሳ አርግሲሴረ።<verse eid="PSA 48:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 48:4"/>ሞቶትን ሁምነ ወልት ደረተኒ</para>
  <para style="q2" vid="PSA 48:4">ቶኩማዻን እት ቀጄለን።<verse eid="PSA 48:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 48:5"/>እሳንስ እሼ አርገኒ ድንቅፈተን፤</para>
  <para style="q2" vid="PSA 48:5">ሶዳተኒስ በቀተን።<verse eid="PSA 48:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 48:6"/>አችትስ አኩመ ሙደመ ዱበርቲ ጭኒንስፈቱት፣</para>
  <para style="q2" vid="PSA 48:6">ሆለትናን እሳን ቀበቴ።<verse eid="PSA 48:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 48:7"/>አትስ ቡቤ በአ ቢፍቱቲን</para>
  <para style="q2" vid="PSA 48:7">ዶኒወን ተርሺሽ ጨጨብስቴ።<verse eid="PSA 48:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 48:8"/>አኩመ ዸጌኜ ሰነ፣</para>
  <para style="q2" vid="PSA 48:8">መጋላ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ ኬሰት፣</para>
  <para style="q1" vid="PSA 48:8">መጋላ ዋቀኬኛ ኬሰት፣ አከሱመ አርግኔረ፤</para>
  <para style="q2" vid="PSA 48:8">ዋቅን በረ በራን ጀቤሴ እሼ ዻበ።<verse eid="PSA 48:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 48:9"/>ያ ዋቀዮ፣ ኑ መነ ቁልቁሉማኬ ኬሰት፣</para>
  <para style="q2" vid="PSA 48:9">ጃለለኬ ከን ህንጌደረምኔ ሰነረ ዴዴብኔ ያድነ።<verse eid="PSA 48:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 48:10"/>ያ ዋቀዮ፣ ገለንኬ አኩመ መቃኬቲ</para>
  <para style="q2" vid="PSA 48:10">ሀንዳረ ለፋ ገአ፤</para>
  <para style="q2" vid="PSA 48:10">ሀርክኬ ምርጋስ ቀጄሉማን ጉተሜረ።<verse eid="PSA 48:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 48:11"/>ሰበቢ ሙርቲኬቲቲፍ፣</para>
  <para style="q2" vid="PSA 48:11">ቱሉን ጥዮን ሃገመዱ፤</para>
  <para style="q2" vid="PSA 48:11">እንተለን ይሁዳስ ሃእልልቸን።<verse eid="PSA 48:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 48:12"/>ጥዮንረ ናነኣ፤ ናኖሼረስ አዴማ፤</para>
  <para style="q2" vid="PSA 48:12">ገሞወንሼስ ለካኣ።<verse eid="PSA 48:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 48:13"/>ዸሎተ እት ኣኑት አከ ህምተኒፍ፣</para>
  <para style="q2" vid="PSA 48:13">ደላ ኤጉምሰሼ ስሪት ሁበዻ፤</para>
  <para style="q2" vid="PSA 48:13">ገልመሼስ እላላ።<verse eid="PSA 48:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 48:14"/>ዋቅን ኩን በረ በራ ሀመ በረ በራት ዋቀኬኛቲ፤</para>
  <para style="q2" vid="PSA 48:14">እን ሀመ ዹማትሌ ኑ ቀጄልቸ።<verse eid="PSA 48:14"/></para>
  <chapter eid="PSA 48"/>
  <chapter number="49" style="c" sid="PSA 49"/>
  <para style="cl">ፋርፈትና 49</para>
  <para style="ms1">ቀቤኘ አብደቹን ፋይዳ ህንቀቡ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና እልማን ቆራህ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 49:1"/>ያ ነሞተ፣ እስን ሁንድ ዋን ከነ ዸገኣ፤</para>
  <para style="q2" vid="PSA 49:1">ወር አዱኛ ከነረ ጅራተን ሁንድኑ ዸጌፈዻ፤<verse eid="PSA 49:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 49:2"/>ጥናፊ ጉዳን፣ ሶሬሲፊ ህዬስ ወሉማን</para>
  <para style="q2" vid="PSA 49:2">ዸጌፈዻ፤ ኩንስ፦<verse eid="PSA 49:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 49:3"/>አፋንኮ ዱቢ ኦጉማ ዱበተ፤</para>
  <para style="q2" vid="PSA 49:3">ወንት አን ገራት ያዱስ ሁበትና ኬነ።<verse eid="PSA 49:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 49:4"/>ጉረኮ ገረ መማክሳት ነንቀበዸ፤</para>
  <para style="q2" vid="PSA 49:4">ህቦኮስ በገናዻን ነንእብሰዸ።<verse eid="PSA 49:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 49:5"/>በረ ረክና፣ ዬሮ ጎዎምስቶትን ሀሞን</para>
  <para style="q2" vid="PSA 49:5">ነ መርሰንት፣ አን ማሊፈን ሶዳዸ?<verse eid="PSA 49:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 49:6"/>እሳን ቀቤኘሳኒ አመነቱ፤</para>
  <para style="q2" vid="PSA 49:6">ጉድነ ሶሩመሳኒቲንስ ቦኑ።<verse eid="PSA 49:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 49:7"/>ነምን ሉቡ ነመ ገረ ብራ ፉሩ፣</para>
  <para style="q2" vid="PSA 49:7">ዮካን ገቲ ፉሪ ነመ ሰና ዋቃፍ ባሱ ቶኮዩ ህንጅሩ፤<verse eid="PSA 49:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 49:8"/>ፉሪን ሉቡ ነማ ገቲ ጉዳ ቀባቲ፤</para>
  <para style="q2" vid="PSA 49:8">ገቲን ቁፍሳንስ ዮምዩ ህንአርገሙ፤<verse eid="PSA 49:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 49:9"/>ስላ እን በረ በራን ንጅራተ፤</para>
  <para style="q2" vid="PSA 49:9">ህንቶርቶሩስ ቱሬ።<verse eid="PSA 49:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 49:10"/>አከ ኦጌዪን ዱአን ነምን ሁንድኑ ንአርገ፤</para>
  <para style="q2" vid="PSA 49:10">ጎዎትኒፊ ራቱወንስ አከሱመ ንበዱ፤</para>
  <para style="q2" vid="PSA 49:10">ቀቤኘሳኒስ ወረ ካኒፍ ዺሱ።<verse eid="PSA 49:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 49:11"/>እሳን ዮ ለፈ መቃሳኒቲን ዋመምቱ ቀባተንሌ፣</para>
  <para style="q2" vid="PSA 49:11">አዋልሳኒ በረ በራን መነሳኒ፣</para>
  <para style="q2" vid="PSA 49:11">ዸሎታ ሀመ ዸሎታትስ እዶ ቦቆናሳኒ ተኤ ሀፈ።<verse eid="PSA 49:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 49:12"/>ነምን ገሩ ቀቤኘ ቀባቱሌ በረ ዼራ ህንጅራቱ፤</para>
  <para style="q2" vid="PSA 49:12">እን አኩመ ብኔንሰ ዱኤ በዱት።<verse eid="PSA 49:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 49:13"/>ወን ነሞተ ኦፍት አመነተኒፊ</para>
  <para style="q2" vid="PSA 49:13">ወረ እሳን ዱካ ቡአኒ ዱቢሳኒ ሆእሰን ኤገቱ ከኑመ።<verse eid="PSA 49:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 49:14"/>እሳን አኩመ ሆላ ዱኣፍ ረመደመኒሩ፤</para>
  <para style="q2" vid="PSA 49:14">ዱት ትክሴሳኒት፤</para>
  <para style="q2" vid="PSA 49:14">ቶሎን ገነማን እሳንረት ኣንጎ ቀባቱ፤</para>
  <para style="q1" vid="PSA 49:14">ዸግንሳኒ መነሳኒራ ፈጋቴ አዋለ ኬሰት ንቶርቶረ፤</para>
  <para style="q2" vid="PSA 49:14">አዋልስ መነ ጅሬኘሳኒት።<verse eid="PSA 49:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 49:15"/>ዋቅን ገሩ ሉቡኮ ሁምነ ሲኦል ጀላ ባሰ፤</para>
  <para style="q2" vid="PSA 49:15">እን ዹጉማን ኦፍት ነ ፉዸተ።<verse eid="PSA 49:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 49:16"/>ዮሙ ነምን ቶኮ ሶሮሙ፣</para>
  <para style="q2" vid="PSA 49:16">ዮሙ ኡልፍን መነሳስ ጉደቱ ህንሶዳትን።<verse eid="PSA 49:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 49:17"/>እን ዮሙ ዱኡት ዋኑመ ቶኮሌ ፉዸቴ ህንዴሙቲ፤</para>
  <para style="q2" vid="PSA 49:17">ኡልፍንሳስ እሰ ወጅን ህንዸቁ።<verse eid="PSA 49:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 49:18"/>እን በረ ጅሬኘሳ ሉቡሳ ኤብሱዩ፣</para>
  <para style="q2" vid="PSA 49:18">ዮ ነሞትን ዬሮ አት ዋን ጋሪ ኦፊኬቲ ጎዸቱት ስ ጀጀንሌ፣<verse eid="PSA 49:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 49:19"/>እን ገረ ዸሎተ አቦቲሳ፣</para>
  <para style="q2" vid="PSA 49:19">ገረ ወረ ጎንኩማ ዴብአኒ እፈ ጅሬኛ ህንአርግኔ ንዸቀ።<verse eid="PSA 49:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 49:20"/>ነምን በዻዻን ሁበትና ህንቀብኔ፣</para>
  <para style="q2" vid="PSA 49:20">አኩመ ብኔንሳ ዱኤ በደ።<verse eid="PSA 49:20"/></para>
  <chapter eid="PSA 49"/>
  <chapter number="50" style="c" sid="PSA 50"/>
  <para style="cl">ፋርፈትና 50</para>
  <para style="ms1">ዋቄፈትና ዹጋ</para>
  <para style="d">ፋርፈትና አሳፍ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 50:1"/>
    <char style="nd">ዋቀዮ</char>፣ ሁምነ ቀቤስ ዱበቴ</para>
  <para style="q2" vid="PSA 50:1">በአ ቢፍቱቲ ጀልቀቤ ሀመ ልጠ ቢፍቱት</para>
  <para style="q2" vid="PSA 50:1">ለፈ ዋሜረ።<verse eid="PSA 50:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 50:2"/>ጥዮን እሼ ሚዸግንሼ</para>
  <para style="q2" vid="PSA 50:2">ህርእነ ህንቀብኔራ ዋቅን ንእብሰ።<verse eid="PSA 50:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 50:3"/>ዋቅንኬኘ ንዹፈ፤ ህንጨልእሱስ፤</para>
  <para style="q2" vid="PSA 50:3">እብድ ሀማን ፉለሳ ዱረ፣</para>
  <para style="q2" vid="PSA 50:3">ቡቤን ጀባንስ ናኖሳ ጅረ።<verse eid="PSA 50:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 50:4"/>እን ሰበሳት ሙሩፍ ጄዼ፣</para>
  <para style="q2" vid="PSA 50:4">ሰሚወን ኦሊቲፊ ለፈ አከነ ጄዼ ንዋመ፦<verse eid="PSA 50:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 50:5"/>“ቁልቁሎተኮ ወረ ኣርሳዻን ነ ወጅን ከኩ ገለን፣</para>
  <para style="q2" vid="PSA 50:5">ገረኮት ወልት ና ቀባ።”<verse eid="PSA 50:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 50:6"/>ሰሚወን ቀጄሉማሳ ንለብሱ፤</para>
  <para style="q2" vid="PSA 50:6">ዋቅን መታንሳ አባ ሙርቲቲ።<verse eid="PSA 50:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 50:7"/>“ያ ሰበኮ፣ ነንዱበዻቲ ዸገእ፤</para>
  <para style="q2" vid="PSA 50:7">ያ እስራኤል፣ አን ዹጋ ስት ነንበአ፦</para>
  <para style="q2" vid="PSA 50:7">አን ዋቅን ዋቀኬት።<verse eid="PSA 50:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 50:8"/>አን ኣርሳኬቲፍ ስት ህንዼከሙ፤</para>
  <para style="q2" vid="PSA 50:8">ኣርሳንኬ እን ጉበሙ ዬሮ ሁንደ ፉለኮ ዱረ ጅረ።<verse eid="PSA 50:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 50:9"/>አን ደላኬ ኬሳ ኮርመ፣</para>
  <para style="q2" vid="PSA 50:9">ዮካን ከረኬ ኬሳ ኮርቤሰ ሬኤ ህንበርባዱ።<verse eid="PSA 50:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 50:10"/>ብኔንስ ቦሶና ሁንድኑ፣</para>
  <para style="q2" vid="PSA 50:10">ሆሪን ቱሉ ኩመረት ቦበኡስ ከንኮቲ።<verse eid="PSA 50:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 50:11"/>አን ስምብሮተ ቱሉወንራ ሁንደ ቤከ፤</para>
  <para style="q2" vid="PSA 50:11">ወን ለፈረ ሶሶቾኡ ሁንድኑስ ከንኮት።<verse eid="PSA 50:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 50:12"/>አን ኡቱን ቤለኤዩ ስት ህንህመዹ ቱሬ፤</para>
  <para style="q2" vid="PSA 50:12">አዱኛፊ ወን እሼ ኬሰ ጅሩ ሁንድ ከኑመኮቲ።<verse eid="PSA 50:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 50:13"/>አን ፎን ኮሮሚ ነንኛዻ?</para>
  <para style="q2" vid="PSA 50:13">ዮካን ዺገ ሬኦታ ነንዹጋ?<verse eid="PSA 50:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 50:14"/>“ኣርሳ ገለታ ዋቃፍ ዽኤስ፤ ወሬገኬሌ</para>
  <para style="q2" vid="PSA 50:14">ዋቀ ዋን ሁንዳ ኦሊቲፍ ገልች፤<verse eid="PSA 50:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 50:15"/>ጉያ ረክና ነ ዋመዹ፤</para>
  <para style="q2" vid="PSA 50:15">አን ስን ኦልቻ፤ አትስ ኡልፍነ ና ኬንተ።”<verse eid="PSA 50:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="PSA 50:16"/>ዋቅን ገሩ ነመ ሀማዻን አከነ ጄዸ፦</para>
  <para style="q1" vid="PSA 50:16">“አት ሴረኮ ለብሱዻፍ፣</para>
  <para style="q2" vid="PSA 50:16">ከኩኮስ አፋንኬቲን ዱበቹዻፍ <optbreak/> ምርገ ማሊ ቀብደ?<verse eid="PSA 50:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 50:17"/>አት አደበኮ ንጅብተ፤</para>
  <para style="q2" vid="PSA 50:17">ዱቢኮስ ኦፍ ዱበት ገተ።<verse eid="PSA 50:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 50:18"/>አት ዮ ሀቱ አርግቴ እሰ ምቹ ጎዸተ፤</para>
  <para style="q2" vid="PSA 50:18">ኤጅቶተ ወጅንስ ቆደ ቀባተ።<verse eid="PSA 50:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 50:19"/>አት አፋንኬ ዋን ሀማ ዱበቹፍ እት ፈየደምተ፤</para>
  <para style="q2" vid="PSA 50:19">አረበኬስ ጎዎምሳዻፍ ዼሬፈተ።<verse eid="PSA 50:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 50:20"/>አት ቴሴ ኦቦሌሰኬ ሀመተ፤</para>
  <para style="q2" vid="PSA 50:20">እልመ ሃዸኬ መቃ በሌስተ።<verse eid="PSA 50:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 50:21"/>አት ዋን ከነ ሁንደ ሆጄቴርተ፤ አንሞ እኑመ ጨልእሴ፤</para>
  <para style="q2" vid="PSA 50:21">አት አኩመ ኦፊኬቲ ነ ሴቴ።</para>
  <para style="q1" vid="PSA 50:21">አመ ገሩ አን ስን እፈዸ፤</para>
  <para style="q2" vid="PSA 50:21">እፈት ባሴስ ስን ህመዸ።<verse eid="PSA 50:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 50:22"/>“እስን ወር ዋቀ እራንፈተን ዋን ከነ ሁበዻ፤</para>
  <para style="q2" vid="PSA 50:22">ዮ ከና አቺ አን እስን ነንጭጭረ፤</para>
  <para style="q2" vid="PSA 50:22">ነምን እስን ኦልቹ ቶኮዩ ህንጅሩ።<verse eid="PSA 50:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 50:23"/>ነምን ኣርሳ ገለታ ዽኤሱ ኡልፍነ ና ኬነ፤</para>
  <para style="q2" vid="PSA 50:23">አንስ ወረ ህርእነ ህንቀብኔት ፈይሱ ዋቃ ነንአርግሲሰ።”<verse eid="PSA 50:23"/></para>
  <chapter eid="PSA 50"/>
  <chapter number="51" style="c" sid="PSA 51"/>
  <para style="cl">ፋርፈትና 51</para>
  <para style="ms1">ከዸትና ዺፈመ ጩቡ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዳዊት። ፋርፈትና ከነስ እን ኤርገ በትሼባ ብረ ገኤ ቦዴ ዬሮ ናታን ራጅች ገረሳ ዹፌት ፋርፈቴ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 51:1"/>ያ ዋቀዮ፣ አኩመ ጃለለኬ</para>
  <para style="q2" vid="PSA 51:1">ከን ህንጌደረምኔ ሰናት ነ ማር፤</para>
  <para style="q1" vid="PSA 51:1">አኩመ ባይእነ አራረኬቲት፣</para>
  <para style="q2" vid="PSA 51:1">የከኮ ነራ ሀቅ።<verse eid="PSA 51:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 51:2"/>የከኮ ሁንዱማ ነራ ዽቅ፤</para>
  <para style="q2" vid="PSA 51:2">ጩቡ ኮራስ ነ ቁልቁሌስ።<verse eid="PSA 51:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 51:3"/>አን የከኮ ቤካቲ፤</para>
  <para style="q2" vid="PSA 51:3">ጩቡንኮስ ዬሮ ሁንደ ፉለኮ ዱረ ጅረ።<verse eid="PSA 51:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 51:4"/>አን ስት፣ ሱመ ቆፈት ጩቡ ሆጄዼረ፤</para>
  <para style="q2" vid="PSA 51:4">ዋን ፉለኬ ዱረት ሀማ ተኤስ ሆጄዼረ፤</para>
  <para style="q1" vid="PSA 51:4">ከናፉ አት ሙርቲኬቲን ቀጄላዸ፤</para>
  <para style="q2" vid="PSA 51:4">ዮሙ ሙርቲ ኬንቱትስ ህንዶጎጎርቱ።<verse eid="PSA 51:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 51:5"/>ዹጉመዩ አን ጩቡዻነን ዸለዼ፤</para>
  <para style="q2" vid="PSA 51:5">ዬሮ ሃትኮ ነ ኡልፎፍቴ ጀልቀቤስ ጩበማን ቱሬ።<verse eid="PSA 51:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 51:6"/>አት ኬሰ ነማት ዹጋ ሀውተ፤</para>
  <para style="q2" vid="PSA 51:6">ከናፉ ኬሰኮት ኦጉማ ነ በርሲስ።<verse eid="PSA 51:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 51:7"/>ሂሶጲዻን ጩቡራ ነ ቁልቁሌስ፤ አንስ ነንቁልቁላአ፤</para>
  <para style="q2" vid="PSA 51:7">ነ ዽቅ፤ አንስ ጨቢ ጫላት ነንአዳዸ።<verse eid="PSA 51:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 51:8"/>ገመቹፊ እልሌ ነ ዸጌስስ፤</para>
  <para style="q2" vid="PSA 51:8">ለፌን አት ጨጨብስቴስ ሃእልልቹ።<verse eid="PSA 51:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 51:9"/>ፉለኬ ጩቡኮራ ዴብፈዹ፤</para>
  <para style="q2" vid="PSA 51:9">የከኮ ሁንደስ ነራ ሀቅ።<verse eid="PSA 51:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 51:10"/>ያ ዋቀዮ፣ ገራ ቁልቁሉ ነ ኬሰት ኡም፤</para>
  <para style="q2" vid="PSA 51:10">ሀፉረ ቀጄላስ ነ ኬሰት ሃሮምስ።<verse eid="PSA 51:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 51:11"/>ፉለኬ ዱራ ነ ህንበሌስን፤</para>
  <para style="q2" vid="PSA 51:11">ሀፉረኬ ቁልቁሉስ ነራ ህንፉዸን።<verse eid="PSA 51:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 51:12"/>ገመቹ ፈይነኬቲ ና ዴብስ፤</para>
  <para style="q2" vid="PSA 51:12">ነ ጅራችሱዻፍስ ሀፉረ ሰርሙ ና ኬን።<verse eid="PSA 51:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 51:13"/>አንስ ወረ ከራኬራ ጀልአተን ነንበርሲሰ፤</para>
  <para style="q2" vid="PSA 51:13">ጩበሞትንስ ገረኬ ንዴብኡ።<verse eid="PSA 51:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 51:14"/>ያ ዋቅ፣ ዋቀ ነ ፈይፍቱ፣</para>
  <para style="q2" vid="PSA 51:14">አት ዺገ ዸንገላሱራ ነ ኦልች፤</para>
  <para style="q2" vid="PSA 51:14">አረብንኮስ ቀጄሉማኬ ንፋርፈተ።<verse eid="PSA 51:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 51:15"/>ያ ጎፍታ፣ ህዺኮ ና በን፤</para>
  <para style="q2" vid="PSA 51:15">አፋንኮስ ገለተኬ ለብሰ።<verse eid="PSA 51:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 51:16"/>አት ኣርሳት ህንገመዱ መሌ ስላ ነንዽኤሰ ቱሬ፤</para>
  <para style="q2" vid="PSA 51:16">ኣርሳ ጉበሙትስ ህንገመዱ።<verse eid="PSA 51:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 51:17"/>ኣርሳን ዋቅን ፉዸቱ ሀፉረ ጨባዸ፤</para>
  <para style="q2" vid="PSA 51:17">ያ ዋቅ፣ አት ገራ ጨባፊ ከን ጋቡ ህንቱፈቱ።<verse eid="PSA 51:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 51:18"/>ጃለለኬቲን ጥዮኒፍ ዋን ጋሪ ጎዽ፤</para>
  <para style="q2" vid="PSA 51:18">ደላ ዬሩሳሌም እጃር።<verse eid="PSA 51:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 51:19"/>ዮስ አት ኣርሳ ቀጄላት፣ ቀልመ ጉበሙፊ</para>
  <para style="q2" vid="PSA 51:19">ቀልመ አኩመ ጅሩት ጉበሙት ንገመደ፤</para>
  <para style="q2" vid="PSA 51:19">ኮሮሚንስ እዶ ኣርሳኬረት ንዽኤፈመን።<verse eid="PSA 51:19"/></para>
  <chapter eid="PSA 51"/>
  <chapter number="52" style="c" sid="PSA 52"/>
  <para style="cl">ፋርፈትና 52</para>
  <para style="ms1">ዋን ነመ ሀማ ኤገቱ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። <char style="tl">መስኪሊ</char> ዳዊት። ዶኤግ ነምን ብየ ኤዶሚ ዬሮ ገረ ሳኦሊ ዸቄ፣ “ዳዊት ገረ መነ አሂሜሌኪ ዹፌረ” ጄዼ እት ህሜት ፋርፈተሜ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 52:1"/>ያ ነመ ጀባነነ፣ አት ማሊፍ ሀምናን ኮርተ?</para>
  <para style="q2" vid="PSA 52:1">አት ነምን ፉለ ዋቃ ዱረት ቱፈተምቱ፣</para>
  <para style="q2" vid="PSA 52:1">ማሊፍ ጉያ ጉቱ ኮርተ?<verse eid="PSA 52:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 52:2"/>አት ነምን ነመ ጎዎምስቱ፣</para>
  <para style="q2" vid="PSA 52:2">አረብንኬ በዲሰ ቆጴሰ፤</para>
  <para style="q2" vid="PSA 52:2">አረብንኬ አኩመ ቀረባ ቀረሜት።<verse eid="PSA 52:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 52:3"/>አት ዋን ጋሪረ ዋን ሀማ ጃለተ፤</para>
  <para style="q2" vid="PSA 52:3">ዹጋ ዱበቹረሞ ሶበ ዱበቹ ጃለተ።<verse eid="PSA 52:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 52:4"/>ያ አረበ ጎዎምስቱነነ፣</para>
  <para style="q2" vid="PSA 52:4">አት ዱቢ ነመ ሚዹ ሁንደ ጃለተ።<verse eid="PSA 52:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 52:5"/>ከናፉ ዋቅን በረ በራን ስ በሌሰ፦</para>
  <para style="q2" vid="PSA 52:5">እን ዱንካነኬ ኬሳ ቡቴ ስ ጭጭረ፤</para>
  <para style="q2" vid="PSA 52:5">ብየ ጅራቶታ ኬሳስ ስ ቡቅሰ።<verse eid="PSA 52:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 52:6"/>ቀጄልቶትን ዋን ከነ አርገኒ ሶዳተን፤</para>
  <para style="q2" vid="PSA 52:6">እሳንስ አከነ ጄዸኒ እሰት ኮልፈን፤<verse eid="PSA 52:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 52:7"/>“ኩኖ፣ ነምቸ ዋቀ ደኦሳ ህንጎዸን፣</para>
  <para style="q2" vid="PSA 52:7">ቆደ ከናሞ ባይእነ ቀቤኘሳ አመነቴ</para>
  <para style="q2" vid="PSA 52:7">ጀልእነ ኦፊት ጭቼ!”<verse eid="PSA 52:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 52:8"/>አን ገሩ አኩመ ኤጄርሰ</para>
  <para style="q2" vid="PSA 52:8">መነ ዋቃ ኬሰት ለልሱት፤</para>
  <para style="q1" vid="PSA 52:8">በራ ሀመ በረ በራትስ፣ ጃለለ ዋቃ ከን</para>
  <para style="q2" vid="PSA 52:8">ህንጌደረምኔ ሰነ ነንአመነዸ።<verse eid="PSA 52:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 52:9"/>ሰበቢ አት ዋን ከነ ጎቴፍ</para>
  <para style="q2" vid="PSA 52:9">አን በረ በራን ስን ገለቴፈዸ፤</para>
  <para style="q1" vid="PSA 52:9">ሰበቢ መቃንኬ ጋሪ ተኤፍ አን መቃኬ ነንአብደዸ።</para>
  <para style="q2" vid="PSA 52:9">ፉለ ቁልቁሎተኬ ዱረትስ ስን ሌልሰ።<verse eid="PSA 52:9"/></para>
  <chapter eid="PSA 52"/>
  <chapter number="53" style="c" sid="PSA 53"/>
  <para style="cl">ፋርፈትና 53</para>
  <para style="ms1">ዋን ወረ ዋቀት ህንቡሌ ኤገቱ</para>
  <para style="mr">
    <ref loc="PSA 53:1-6">53፥1‑6</ref> ኩወፈ – <char style="xt"><ref loc="PSA 14:1-7">ፋር 14፥1‑7</ref></char></para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ጎሰ ሙዚቃ <char style="tl">ማህላት</char> ጄዸሙን ፋርፈተሜ። <char style="tl">መስኪሊ</char> ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 53:1"/>ጎዋን ገራሳት፣ “ዋቅን ህንጅሩ” ጄዸ።</para>
  <para style="q2" vid="PSA 53:1">እሳን ጡራአኒሩ፤ ከራንሳኒስ ጅብሲሳዸ፤</para>
  <para style="q2" vid="PSA 53:1">ነምን ዋን ጋሪ ሆጄቱ ቶኮዩ ህንጅሩ።<verse eid="PSA 53:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 53:2"/>ዋቅን ዮ ነምን ዋ ሁበቱ፣</para>
  <para style="q2" vid="PSA 53:2">ከን ዋቀስ በርባዱ ቶኮዩ ጅራቴ</para>
  <para style="q1" vid="PSA 53:2">አርጉፍ ጄዼ፣</para>
  <para style="q2" vid="PSA 53:2">ሰሚራ እልማን ነሞታ ገድ እላለ።<verse eid="PSA 53:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 53:3"/>ሁንድኑ ዶጎጎረኒሩ፤</para>
  <para style="q2" vid="PSA 53:3">ሁንድሳኒስ ጡራአኒሩ፤</para>
  <para style="q1" vid="PSA 53:3">ነምን ዋን ጋሪ ሆጄቱ ቶኮዩ ህንጅሩ፤</para>
  <para style="q2" vid="PSA 53:3">ቶኩምትዩ ህንጅሩ።<verse eid="PSA 53:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 53:4"/>ወር ሀምነ ሆጄተን፣</para>
  <para style="q2" vid="PSA 53:4">ከኔን አኩመ ዋን ቡዴነ ኛተኒት ሰበኮ ኛተን፣</para>
  <para style="q2" vid="PSA 53:4">ወር ዋቀ ህንዋመትኔ ሁንድኑ ሆማ ህንቤከኒ?<verse eid="PSA 53:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 53:5"/>እሳን እዶ ወን ሶዳተሙ ህንጅሬት፣</para>
  <para style="q2" vid="PSA 53:5">ሶዳዻን ልቅምፈመኒሩ።</para>
  <para style="q1" vid="PSA 53:5">ዋቅን ለፌ ወረ ስ መርሰኒ ንብትኔሰ፤</para>
  <para style="q2" vid="PSA 53:5">ሰበቢ ዋቅን እሳን ቱፈቴፍ፣ አት እሳን ቃኔስቴ።<verse eid="PSA 53:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 53:6"/>ማሎ ኡቱ ጥዮን ኬሳ ፈይን እስራኤሊፍ ዹፌ!</para>
  <para style="q2" vid="PSA 53:6">ዮሙ ዋቅን ሰበሳ ወረ ቦጅአመን ዴብሱት፣</para>
  <para style="q2" vid="PSA 53:6">ያቆብ ሃእልልቹ፤ እስራኤልስ ሃገመዱ!<verse eid="PSA 53:6"/></para>
  <chapter eid="PSA 53"/>
  <chapter number="54" style="c" sid="PSA 54"/>
  <para style="cl">ፋርፈትና 54</para>
  <para style="ms1">ዋቀዮት አባ ሙርቲ ቀጄላት እየቹ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ምአ ርቡቲን። <char style="tl">መስኪሊ</char> ዳዊት። ዬሮ ወር ዚፍ ሳኦል ብረ ዸቀኒ፣ “ዳዊት ኑ ግዱ ዾከቴ ጅረ” ጄዸንት ፋርፈተሜ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 54:1"/>ያ ዋቅ፣ መቃኬቲን ነ ፈይስ፤</para>
  <para style="q2" vid="PSA 54:1">ሁምነኬቲንስ ና ሙርቴስ።<verse eid="PSA 54:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 54:2"/>ያ ዋቅ፣ ከዸትናኮ ና ዸገእ፣</para>
  <para style="q2" vid="PSA 54:2">ዱቢ አፋንኮቲስ ዸጌፈዹ።<verse eid="PSA 54:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 54:3"/>ኬሱሞትን ነት ከአኒሩቲ፤</para>
  <para style="q2" vid="PSA 54:3">ወር ገራ ነማ ህንላፍኔ ሉቡኮ ገላፈቹ በርባዱ፤</para>
  <para style="q2" vid="PSA 54:3">እሳንስ ወረ ዋቃፍ ኡልፍነ ህንኬንኔዸ።<verse eid="PSA 54:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 54:4"/>ኩኖ፣ ዋቅን ገርጋራኮት፤</para>
  <para style="q2" vid="PSA 54:4">ጎፍታን ጅራችሳ ሉቡኮት።<verse eid="PSA 54:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 54:5"/>ሀምን ወረ መቃ ነ በሌሰኒ እሳኑመት ሃዴብኡ፤</para>
  <para style="q2" vid="PSA 54:5">አትስ አመነሙማኬቲን እሳን በሌስ።<verse eid="PSA 54:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 54:6"/>አን ፌዺኮቲን ኣርሳ ሲፍ ዽኤሰ፤</para>
  <para style="q2" vid="PSA 54:6">ያ <char style="nd">ዋቀዮ</char>፣ አን መቃኬ ነንገለቴፈዸ፤</para>
  <para style="q2" vid="PSA 54:6">እን ጋሪዻቲ።<verse eid="PSA 54:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 54:7"/>እን ዽጵነኮ ሁንዱማ ኬሳ ነ ባሴራቲ፤</para>
  <para style="q2" vid="PSA 54:7">እጅኮስ ኦል ኣንቱማዻን ዲኖተኮ ኦፍ ጀለት እላሌረ።<verse eid="PSA 54:7"/></para>
  <chapter eid="PSA 54"/>
  <chapter number="55" style="c" sid="PSA 55"/>
  <para style="cl">ፋርፈትና 55</para>
  <para style="ms1">ከዸትና ዬሮ አርአተማ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ምአ ርቡቲን። <char style="tl">መስኪሊ</char> ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 55:1"/>ያ ዋቅ፣ ከዸትናኮ ዸገእ፤</para>
  <para style="q2" vid="PSA 55:1">ዋመተኮ ጀላስ ህንድድን።<verse eid="PSA 55:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 55:2"/>ነ ዸገኢቲ ዴቢ ና ኬን፤</para>
  <para style="q1" vid="PSA 55:2">ኮሚንኮ ነ ዽጵሰ፤ አንስ ነጋ ዸቤረ።<verse eid="PSA 55:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 55:3"/>ሰገሌ ዲናቲን፣</para>
  <para style="q2" vid="PSA 55:3">ጩንቁርሰ ነሞተ ሀሞስ ዹፌ፤</para>
  <para style="q1" vid="PSA 55:3">እሳን ዽጵነ ነት ፍዱቲ፤</para>
  <para style="q2" vid="PSA 55:3">ኣሪዻንስ ነ ጅቡ።<verse eid="PSA 55:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 55:4"/>ለጴንኮ ነ ኬሰት ዽጰቴ፤</para>
  <para style="q2" vid="PSA 55:4">ሶዳን ዱኣስ ነ ቀበቴ።<verse eid="PSA 55:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 55:5"/>ሶዳፊ ሆለትናን ነት ዹፌረ፤</para>
  <para style="q2" vid="PSA 55:5">ናሱንስ ነ ፉዸቴረ።<verse eid="PSA 55:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 55:6"/>አንስ አከነ ነንጄዼ፤ <optbreak/> “ኡቱ አን አኩመ ጉጌ ቆቾ ቀባዼ!</para>
  <para style="q2" vid="PSA 55:6">ስላ አሲ በርሴ ነንቦቆዸን ቱሬ።<verse eid="PSA 55:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 55:7"/>ስላ ፈጎት በቀዼ</para>
  <para style="q2" vid="PSA 55:7">ገሞጂ ኬሰ ነንቡቡለ ቱሬ፤<verse eid="PSA 55:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 55:8"/>ስላ ቡቤ ሀማፊ ቅሌንሰ ጀባራ ፈጋዼ</para>
  <para style="q2" vid="PSA 55:8">ገረ እዶ ቦቆናኮት ነንአሪፈዸን ቱሬ።”<verse eid="PSA 55:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 55:9"/>ያ ጎፍታ፣ ነሞተ ሀሞ ቡርጃጄስ፤</para>
  <para style="q2" vid="PSA 55:9">ዱቢሳኒስ ወሊን ዸእ፤</para>
  <para style="q2" vid="PSA 55:9">አን መጋላ ኬሰት ጎሊፊ ሎለ አርጌራቲ።<verse eid="PSA 55:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 55:10"/>እሳን ሀልከኒ ጉያ ኦል በአኒ ደላሼረ ናነኡ፤</para>
  <para style="q2" vid="PSA 55:10">ጀልእኒፊ ረክን እሼ ኬሰ ጅረ።<verse eid="PSA 55:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 55:11"/>እሼ ኬሰ በዲሰቱ ጅረ፤</para>
  <para style="q2" vid="PSA 55:11">ነመ ጩንቁርሱፊ ጎዎምሱን ዳንዲሼራ ህንዸበሙ።<verse eid="PSA 55:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 55:12"/>ኡቱ ዲን ነ አረብሴ፣</para>
  <para style="q2" vid="PSA 55:12">ስላ ኦብሱ ነንደንደአ ቱሬ፤</para>
  <para style="q1" vid="PSA 55:12">ኡቱ አመጃጂን ነት ከኤ፣</para>
  <para style="q2" vid="PSA 55:12">ስላ ጀላ ዾከቹ ነንደንደአ ቱሬ።<verse eid="PSA 55:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 55:13"/>ገሩ ስእ ነሙመ አከኮቲ፣</para>
  <para style="q2" vid="PSA 55:13">ህርያኮ፣ ምቹኮ ከን ነት ዽኣቱቱ ዋን ከነ ጎዼ።<verse eid="PSA 55:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 55:14"/>ቶኩማዻን መነ ዋቃ ወሊ ወጅን ዴምኔ፤</para>
  <para style="q2" vid="PSA 55:14">ሃሳ ምኣዋስ ወሊ ወጅን ሃሶፍኔ።<verse eid="PSA 55:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 55:15"/>ዱት ተሰ እሳንት ሃዹፉ፤</para>
  <para style="q2" vid="PSA 55:15">ኡቱመ ሉቡዻን ጅረኑ ሲኦል ኬሰ ሃቡአን፤</para>
  <para style="q2" vid="PSA 55:15">ሀምን መነሳኒቲፊ ገራሳኒ ኬሰ ጅራቲ።<verse eid="PSA 55:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 55:16"/>አን ገሩ ዋቀ ነንዋመዸ፤</para>
  <para style="q2" vid="PSA 55:16">
    <char style="nd">ዋቀዮስ</char> ጀላ ነ ባሰ።<verse eid="PSA 55:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 55:17"/>አን ገልገለ፣ ገነማፊ ዋሬት ዽጵናን ነንእየ፤</para>
  <para style="q2" vid="PSA 55:17">እንስ ሰገሌኮ ንዸገአ።<verse eid="PSA 55:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 55:18"/>ዮ ነምን ባይኤን አናን ሞርሜሌ፣</para>
  <para style="q2" vid="PSA 55:18">እን ወራነ ነት ከኤ ጀላ ሚዻ መሌ ነ ባሰ።<verse eid="PSA 55:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 55:19"/>ዋቅን እን ዱሩማ ጀልቀቤ ቴሶረ ጅሩ ሱን፣</para>
  <para style="q2" vid="PSA 55:19">ነሞተ ከራሳኒ ህንጌደረትኔ፣</para>
  <para style="q1" vid="PSA 55:19">ከኔን ዋቀ ህንሶዳትኔ ንዸገአ፤</para>
  <para style="q2" vid="PSA 55:19">እሳን ቃኔሰስ።<verse eid="PSA 55:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 55:20"/>ህርያንኮ ምቾተሳት ሀርከሳ ኦል ፉዸቴ፤</para>
  <para style="q2" vid="PSA 55:20">ከኩሳሌ ንጨብሴ።<verse eid="PSA 55:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 55:21"/>ዱቢንሳ አኩመ ዸዻት፤ ነመ ህንቁቁ፤</para>
  <para style="q2" vid="PSA 55:21">ገራሳ ኬሰ ገሩ ሎለቱ ጅረ፤</para>
  <para style="q1" vid="PSA 55:21">ዱቢንሳ ዘይቲ ጫላ ለላፈ፤</para>
  <para style="q2" vid="PSA 55:21">ገሩ ጎራዴ ሉቅፈሜዸ።<verse eid="PSA 55:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 55:22"/>ያዶኬ <char style="nd">ዋቀዮት</char> ኬነዹ፤</para>
  <para style="q2" vid="PSA 55:22">እን ስ ጅራችሰ፤</para>
  <para style="q2" vid="PSA 55:22">ነምን ቀጄላን አከ ጄቀሙስ ህንጎዹ።<verse eid="PSA 55:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 55:23"/>ያ ዋቀዮ፣ አት ገሩ</para>
  <para style="q2" vid="PSA 55:23">ነሞተ ሀሞ ቦለ በዲሳ ኬሰ ንቡፍተ፤</para>
  <para style="q1" vid="PSA 55:23">ወር ዺገ ዸንገላሰኒፊ ጎዎምስቶትን፣</para>
  <para style="q2" vid="PSA 55:23">ወለካ በረ ጅሬኘሳኒዩ ህንጅራተን።</para>
  <para style="b" vid="PSA 55:23"/>
  <para style="q1" vid="PSA 55:23">አን ገሩ ስንአመነዸ።<verse eid="PSA 55:23"/></para>
  <chapter eid="PSA 55"/>
  <chapter number="56" style="c" sid="PSA 56"/>
  <para style="cl">ፋርፈትና 56</para>
  <para style="ms1">ዋቀ አመነቹ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ዬደሎ “ጉጌ ቅልጡ ፈጎራ” ጄዹን ፋርፈተሜ። <char style="tl">ሚክታሚ</char> ፋርፈትና ዳዊት። እንስ ዬሮ ፍልስጤሞትን ጋት ኬሰት እሰ ቀበን ፋርፈቴ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 56:1"/>ያ ዋቅ ነ ማር፤</para>
  <para style="q2" vid="PSA 56:1">ዲኖትንኮ አከ መሌ ነ አርኡ፤</para>
  <para style="q2" vid="PSA 56:1">ጉያ ጉቱስ ነ ጩንቁርሱ።<verse eid="PSA 56:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 56:2"/>ዲኖትንኮ ጉያ ጉቱ ነ ጋዱ፤</para>
  <para style="q2" vid="PSA 56:2">ነሞትን ባይኤን ኦፍ ቱሉማዻን ነ ሎሉ።<verse eid="PSA 56:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 56:3"/>አን ዮሙን ሶዳዹት ስን አመነዸ።<verse eid="PSA 56:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="PSA 56:4"/>ዋቀ አን ዱቢሳ ጀጀዹ፣</para>
  <para style="q1" vid="PSA 56:4">ዋቀ ነንአመነዸ፤ ሆማ ህንሶዳዹ።</para>
  <para style="q2" vid="PSA 56:4">ነምን ዱአ ህንኦሌ ማል ነ ጎቹ ደንደአ?<verse eid="PSA 56:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 56:5"/>እሳን ጉያ ጉቱ ዱቢኮ ምጪሩ፤</para>
  <para style="q2" vid="PSA 56:5">ነ ሚዹዻፍስ ዬሮ ሁንደ ነት መለቱ።<verse eid="PSA 56:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 56:6"/>እሳን ንመርአቱ፤ ንርጱስ፤</para>
  <para style="q2" vid="PSA 56:6">ሉቡኮ ገላፈቹፍ ጄዸኒ</para>
  <para style="q2" vid="PSA 56:6">ተርካንፊኮ ኤገቱ።<verse eid="PSA 56:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 56:7"/>ሰበቢ ሀምነሳኒቲፍ አከ እሳን ምልቀን ህንጎዽን፤</para>
  <para style="q2" vid="PSA 56:7">ያ ዋቅ፣ ዼከምሰኬቲን ሰቦተ ገድ ዴብስ።<verse eid="PSA 56:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 56:8"/>ገደደሙኮ ገልሜስ፤</para>
  <para style="q2" vid="PSA 56:8">እምማንኮስ ክታበኬ ኬሰት በሬስ፤</para>
  <para style="q2" vid="PSA 56:8">እሳን ገልሜኬ ኬሰ ጅሩ ምቲ?<verse eid="PSA 56:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 56:9"/>ዮሙ አን ገርጋርሳፍ ስ ዋመዹት፣</para>
  <para style="q2" vid="PSA 56:9">ዲኖትንኮ ዱግደ ዱበ ዴብኡ።</para>
  <para style="q2" vid="PSA 56:9">አንስ ከናን አከ ዋቅን ነ ወጅን ጅሩ ቤከ።<verse eid="PSA 56:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 56:10"/>ዋቀ አን ዱቢሳ ጀጀዹ፣</para>
  <para style="q2" vid="PSA 56:10">
    <char style="nd">ዋቀዮ</char> አን ዱቢሳ ጀጀዹ፣<verse eid="PSA 56:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 56:11"/>ዋቀ ነንአመነዸ፤ አን ሆማ ህንሶዳዹ።</para>
  <para style="q2" vid="PSA 56:11">ነምን ማል ነ ጎቹ ደንደአ?<verse eid="PSA 56:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 56:12"/>ያ ዋቅ ወሬግንኬ ነረ ጅረ፤</para>
  <para style="q2" vid="PSA 56:12">ኣርሳ ገለታስ ሲፍ ነንዽኤሰ።<verse eid="PSA 56:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 56:13"/>አከ አን ፉለ ዋቃ ዱረ፣</para>
  <para style="q2" vid="PSA 56:13">እፈ ጅሬኛ ኬሰ ዴዴብኡፍ፣</para>
  <para style="q1" vid="PSA 56:13">አት ሉቡኮ ዱአ ጀላ፣</para>
  <para style="q2" vid="PSA 56:13">ሚለኮስ ጉፈቹ ኦልችቴርታቲ።<verse eid="PSA 56:13"/></para>
  <chapter eid="PSA 56"/>
  <chapter number="57" style="c" sid="PSA 57"/>
  <para style="cl">ፋርፈትና 57</para>
  <para style="ms1">ዲኖተ ገረ ጀቤዪ ግዱት</para>
  <para style="mr">
    <ref loc="PSA 57:7-11">57፥7‑11</ref> ኩወፈ – <char style="xt"><ref loc="PSA 108:1-5">ፋር 108፥1‑5</ref></char></para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ዬደሎ “ህንበሌስን” ጄዹን ፋርፈተሜ። ፋርፈትና ዳዊት። <char style="tl">ሚክታሚ።</char> እንስ ዬሮ ሳኦል ጀላ በቀቴ ሆልቀት ገሌ ፋርፈቴ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 57:1"/>ነ ማር፤ ያ ዋቅ ነ ማር፤</para>
  <para style="q2" vid="PSA 57:1">ሉቡንኮ ስት ኮሉ ገልቲቲ።</para>
  <para style="q1" vid="PSA 57:1">አንስ ሀመ በላን ደርቡት፣</para>
  <para style="q2" vid="PSA 57:1">ጋድሰ ቆቾኬቲ ጀለት ኮሉ ነንገለ።<verse eid="PSA 57:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 57:2"/>አን ገረ ዋቀ ዋን ሁንዳ ኦሊት፣</para>
  <para style="q2" vid="PSA 57:2">ገረ ዋቀ ሃሎ ና ባሱት ነንእየ።<verse eid="PSA 57:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 57:3"/>እን ሰሚራ ኤርጌ ነ ኦልቸ፤</para>
  <para style="q2" vid="PSA 57:3">ወረ አከ መሌ ነ አርአን ንእፈተ፤</para>
  <para style="q2" vid="PSA 57:3">ዋቅን ጃለለሳቲፊ አመነሙማሳ ንኤርገ።<verse eid="PSA 57:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 57:4"/>አን ሌንጮተ ግዱን ጅረ፤</para>
  <para style="q2" vid="PSA 57:4">አን ብኔንሶተ ነመ ኛተን፣</para>
  <para style="q1" vid="PSA 57:4">ነሞተ እልካንሳኒ ኤቦፊ ጥያ</para>
  <para style="q2" vid="PSA 57:4">ከኔን አረብንሳኒ አከ ጎራዴ ቀረማ ግዱ ጪሴረ።<verse eid="PSA 57:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 57:5"/>ያ ዋቅ፣ አት ሰሚወኒን ኦልት ኦል ኦል ጄዽ፤</para>
  <para style="q2" vid="PSA 57:5">ኡልፍንኬስ ለፈ ሁንደረ ሃጅራቱ።<verse eid="PSA 57:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 57:6"/>እሳንስ ክዮ ሚለኮቲፍ ካአን፤</para>
  <para style="q2" vid="PSA 57:6">ሉቡንኮስ ዽጵናን ገድ ጎግዴርት።</para>
  <para style="q1" vid="PSA 57:6">እሳን ከራኮረት ቦለ ቆተን፤</para>
  <para style="q2" vid="PSA 57:6">ገሩ እሳኑመቱ ኬሰት ኩፌ።<verse eid="PSA 57:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 57:7"/>ያ ዋቅ፣ ገራንኮ ህንራፈሙ፤</para>
  <para style="q2" vid="PSA 57:7">ገራንኮ ህንራፈሙ፤</para>
  <para style="q2" vid="PSA 57:7">አን ነንፋርፈዸ፤ ነንዌድሰስ።<verse eid="PSA 57:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 57:8"/>ያ ሉቡኮ፣ ደመቅ!</para>
  <para style="q2" vid="PSA 57:8">ያ ክራራፊ በገና ደመቃ!</para>
  <para style="q2" vid="PSA 57:8">አንስ ገነማን ነንደመቀ።<verse eid="PSA 57:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 57:9"/>ያ ጎፍታ፣ አን ሰቦተ ግዱት ገለተ ሲፍ ነንገልቸ፤</para>
  <para style="q2" vid="PSA 57:9">ነሞተ ግዱትስ ዋኤኬ ነንፋርፈዸ።<verse eid="PSA 57:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 57:10"/>ጃለልኬ ጉዳዸ፤ ሰሚወንስ ገኣቲ፤</para>
  <para style="q2" vid="PSA 57:10">አመነሙማንኬስ ሰሚወን ቀቀበ።<verse eid="PSA 57:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 57:11"/>ያ ዋቅ፣ አት ሰሚወኒን ኦልት ኦል ኦል ጄዽ፤</para>
  <para style="q2" vid="PSA 57:11">ኡልፍንኬስ ለፈ ሁንደረ ሃጅራቱ።<verse eid="PSA 57:11"/></para>
  <chapter eid="PSA 57"/>
  <chapter number="58" style="c" sid="PSA 58"/>
  <para style="cl">ፋርፈትና 58</para>
  <para style="ms1">አባ ሙርቲ ከን አቦቲ ሙርቲ ብየ ለፋ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ዬደሎ “ህንበሌስን” ጄዹን ፋርፈተሜ። ፋርፈትና ዳዊት። <char style="tl">ሚክታሚ።</char></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 58:1"/>ያ ቡልችቶተ፣ እስን ዹጉማን ዋን ቀጄላ ዱበተኒ?</para>
  <para style="q2" vid="PSA 58:1">ነመ ግዱትስ ሙርቲ ቀጄላ ኬንተኒ?<verse eid="PSA 58:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 58:2"/>አከስ ምት፤ እስን ገራኬሰን ኬሰት ሀምነ ያዱ፤</para>
  <para style="q2" vid="PSA 58:2">ሀርክኬሰንስ ለፈረት ጎሊ ካሰ።<verse eid="PSA 58:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 58:3"/>ነሞትን ሀሞን ዸሎቱማ ካሰኒ ከራራ ጀልአቱ፤</para>
  <para style="q2" vid="PSA 58:3">ገደሜሰ ሃዸሳኒቲ ጀልቀበኒስ ከራራ ጎረኒ ሶበ ዱበቱ።<verse eid="PSA 58:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 58:4"/>ሀዻንሳኒ አኩመ ሀዻ ቦፋት፤</para>
  <para style="q2" vid="PSA 58:4">እሳን አኩመ ቡቲ ዱዳ ጉረሳ ጩቃለቴ<verse eid="PSA 58:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 58:5"/>ሰገሌ ነመ እሰ ራቴሱ ዮካን ነመ ዋን እቲን እሰ ራቴሱ</para>
  <para style="q2" vid="PSA 58:5">ሆጄቱ ቶኮ ዸገኡ ድዱት።<verse eid="PSA 58:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 58:6"/>ያ ዋቅ አት እልካንሳኒ አፋንሳኒ ኬሰት ጨጨብስ፤</para>
  <para style="q2" vid="PSA 58:6">ቀርፋ ሌንጮታስ ዳክ፣ ያ <char style="nd">ዋቀዮ</char>!<verse eid="PSA 58:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 58:7"/>እሳን አኩመ ብሻን ዸንገለኤ በዱት ሃበደን፤</para>
  <para style="q2" vid="PSA 58:7">ዬሮ እዳ ፉታሰንት ጥይሳኒ ሃዶሙ።<verse eid="PSA 58:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 58:8"/>አኩመ ጪለሉ ዮሙ ዴሙ በቁት፣</para>
  <para style="q2" vid="PSA 58:8">አኩመ ዳእመ ኡቱ ዬሮን ህንገእን ዸለቱትስ አዱ ህንአርግን።<verse eid="PSA 58:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 58:9"/>ኡቱ ኦኮቴንኬሰን እብደ ቆራቲቲን ህንሆእን፣</para>
  <para style="q2" vid="PSA 58:9">ጂዻስ ተኡ ጎጋንሳኒ ሀጣአመኒ በሌፈሙ።<verse eid="PSA 58:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 58:10"/>ነምን ቀጄላን ዮሙ ሃሎ በኡ ከነ አርጉት ንገመደ፤</para>
  <para style="q2" vid="PSA 58:10">ሚለሳስ ዺገ ነሞተ ሀሞቲን ንዽቀተ።<verse eid="PSA 58:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 58:11"/>ዮሙስ ነሞትን አከነ ንጄዹ፤</para>
  <para style="q2" vid="PSA 58:11">“ዹጉማን ነመ ቀጄላዻፍ በዻስን ጅረ፤</para>
  <para style="q2" vid="PSA 58:11">ዹጉማን ዋቅን ለፈረት ሙርቲ ኬኑ ጅረ።”<verse eid="PSA 58:11"/></para>
  <chapter eid="PSA 58"/>
  <chapter number="59" style="c" sid="PSA 59"/>
  <para style="cl">ፋርፈትና 59</para>
  <para style="ms1">ከዸትና ዲነ ጀላ በኡፍ ዽኣቴ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ዬደሎ ዳዊት ከን “ህንበሌስን” ጄዹን ፋርፈተሜ። <char style="tl">ሚክታሚ።</char> ዳዊትስ ዬሮ ሳኦል እሰ አጄሱዻፍ ጄዼ ነሞተ ኤርጌ መነሳ ኤግስሴት ፋርፈቴ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 59:1"/>ያ ዋቅ፣ ዲኖተኮ ጀላ ነ ባስ፤</para>
  <para style="q2" vid="PSA 59:1">ወረ ነት ከአን ጀላስ ነ ፉር።<verse eid="PSA 59:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 59:2"/>ወረ ሀምነ ሆጄተን ጀላ ነ ባስ፤</para>
  <para style="q2" vid="PSA 59:2">ነሞተ ዺገ ዸንገላሰን ጀላስ ነ በራር።<verse eid="PSA 59:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 59:3"/>እላ፣ እሳን ርጰኒ ነ ኤገቻ ጅሩ!</para>
  <para style="q2" vid="PSA 59:3">ያ <char style="nd">ዋቀዮ</char>፣ ነሞትን ሀሞን፣</para>
  <para style="q2" vid="PSA 59:3">ኡቱ አን በሌሳፊ ጩቡ ህንቀባትን ሎለ ነት ካሱ።<verse eid="PSA 59:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 59:4"/>አን በሌሳ ቶኮሌ ህንሆጄትኔ፤</para>
  <para style="q2" vid="PSA 59:4">እሳን ገሩ ነ ሎሉፍ ቆጳአኒሩ።</para>
  <para style="q2" vid="PSA 59:4">ነ ገርጋሩዻፍ ከእ፤ ረክነኮስ እላል!<verse eid="PSA 59:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 59:5"/>ያ <char style="nd">ዋቀዮ</char>፣ ዋቀ ዋን ሁንደ ደንደኡ፣</para>
  <para style="q2" vid="PSA 59:5">ያ ዋቀ እስራኤል፣ ሰቦተ ሁንደ አደቡዻፍ ከእ፤</para>
  <para style="q2" vid="PSA 59:5">ወረ ሀምነሳኒቲን የከ ሆጄተን ቶኮሌ ህንማርን።<verse eid="PSA 59:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 59:6"/>እሳንስ ገልገለ ገልገለ ዴብአኒ፣</para>
  <para style="q2" vid="PSA 59:6">አከ ሰሬ ጉሩርኣ መጋለቲረ ናነኡ።<verse eid="PSA 59:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 59:7"/>ዋን እሳን አፋንሳኒቲ ባሰን እላል፤</para>
  <para style="q2" vid="PSA 59:7">ህዺሳኒረ ጎራዴቱ ጅረ፤</para>
  <para style="q2" vid="PSA 59:7">እሳንስ፣ “ኤኙቱ ኑ ዸገኡ ደንደአ?” ጄዹ።<verse eid="PSA 59:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 59:8"/>ያ <char style="nd">ዋቀዮ</char>፣ አት ገሩ እሳንት ኮልፍተ፤</para>
  <para style="q2" vid="PSA 59:8">ሰቦተ ሰነ ሁንዱመትስ ንቆስተ።<verse eid="PSA 59:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 59:9"/>ያ ጀብነኮ፣ አን ስን ኤገዸ፤</para>
  <para style="q2" vid="PSA 59:9">ያ ዋቅ አት ደኦኮ፣<verse eid="PSA 59:9"/></para>
  <para style="q2">
    <verse number="10" style="v" sid="PSA 59:10"/>ዋቀ ነ ጃለቱዸ።</para>
  <para style="b" vid="PSA 59:10"/>
  <para style="q1" vid="PSA 59:10">ዋቅን ፉለኮ ዱረ ዴመ፤</para>
  <para style="q2" vid="PSA 59:10">አከ አን ዲኖተኮ ሞአኖዻን ኦፍ ጀለት እላሉ ጎዸ።<verse eid="PSA 59:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 59:11"/>ያ ጎፍታ፣ ያ ጋቸነኬኘ፣</para>
  <para style="q2" vid="PSA 59:11">አት ገሩ እሳን ህንአጄስን፤</para>
  <para style="q1" vid="PSA 59:11">ዮ ከና አቺ ሰብንኮ ንእራንፈተ።</para>
  <para style="q2" vid="PSA 59:11">ሁምነኬቲን አከ እሳን ጆረን ጎዽ፤ ገድ እሳን ዴብስስ።<verse eid="PSA 59:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 59:12"/>ሰበቢ ጩቡ አፋንሳኒቲፍ፣</para>
  <para style="q2" vid="PSA 59:12">ሰበቢ ዱቢ ህዺሳኒቲፍ፣</para>
  <para style="q2" vid="PSA 59:12">እሳን ኦፍ ቱሉማሳኒቲን ሃቀበመን።</para>
  <para style="q1" vid="PSA 59:12">ሰበቢ አባርሳፊ ሶበ እሳን ዱበተኒቲፍ፣<verse eid="PSA 59:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="PSA 59:13"/>ዼከምሳን እሳን በሌስ፤</para>
  <para style="q2" vid="PSA 59:13">አከ እሳን ዴብአኒ ህንአርገምኔፍ እሳን በሌስ።</para>
  <para style="q1" vid="PSA 59:13">ከናንስ አከ ዋቅን ያቆብረት ሞቲ ተኤ፣</para>
  <para style="q2" vid="PSA 59:13">ሀመ ሀንዳረ ለፋት ንቤከመ።<verse eid="PSA 59:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 59:14"/>እሳንስ ገልገለ ገልገለ ዴብአኒ፣</para>
  <para style="q2" vid="PSA 59:14">አከ ሰሬ ጉሩርኣ፣ መጋለቲረ ናነኡ።<verse eid="PSA 59:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 59:15"/>እሳን ዋን ኛተን በርባቸ አሲፊ አች ጆሩ፤</para>
  <para style="q2" vid="PSA 59:15">ዮ ቁፉ ባተንሞ ንእዩ።<verse eid="PSA 59:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 59:16"/>አን ገሩ ዋኤ ጀብነኬቲ ነንፋርፈዸ፤</para>
  <para style="q2" vid="PSA 59:16">ገነማንስ ዋኤ ጃለለኬቲ ነንፋርፈዸ፤</para>
  <para style="q1" vid="PSA 59:16">አት ደኦኮቲ፤ ዬሮ ረክነኮትስ</para>
  <para style="q2" vid="PSA 59:16">አት እዶ አን እት ኮሉ ገሉዸ።<verse eid="PSA 59:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 59:17"/>ያ ጀብነኮ፣ አን ፋርፈትና ገለታ ሲፍን ፋርፈዸ፤</para>
  <para style="q2" vid="PSA 59:17">ያ ዋቅ፣ አት ደኦኮት፤</para>
  <para style="q2" vid="PSA 59:17">አት ዋቀ አን አብደዹዸ።<verse eid="PSA 59:17"/></para>
  <chapter eid="PSA 59"/>
  <chapter number="60" style="c" sid="PSA 60"/>
  <para style="cl">ፋርፈትና 60</para>
  <para style="ms1">ከዸትና ሞአሙ ቦዴ ዽኤፈሜ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ዬደሎ “ደራራ ከኩ” ጄዸሙን ፋርፈተሜ። <char style="tl">ሚክታሚ</char> ዳዊት። በርሲሱፍ። ዬሮ እን አራም ነሃራይሚፊ አራም ዞባ ሎሌፊ ዬሮ ዮኣብን ዴብሴ ወረ ኤዶሚ ኬሳ ነሞተ ኩመ ኩዸ ለመ ሱሉለ ሶግዳ ኬሰት ፍጤት ፋርፈተሜ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 60:1"/>ያ ዋቅ፣ አት ኑ ገቴርተ፤ ኑ ጨጨብስቴርተስ፤</para>
  <para style="q2" vid="PSA 60:1">ኑት ኣርቴርተ፤ አመ ገሩ እዶት ኑ ዴብስ!<verse eid="PSA 60:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 60:2"/>አት ለፈ ሶቾፍቴርተ፤ ተርሳፍቴስ አፋን በንሲፍቴርተ፤</para>
  <para style="q2" vid="PSA 60:2">ጨጨባሼስ ወልት ሱጵ፤ እሼን ራፈምቴርቲ።<verse eid="PSA 60:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 60:3"/>አት አከ ሰብንኬ ዋን ሀማዻን ዽጰቱ ጎቴርተ፤</para>
  <para style="q2" vid="PSA 60:3">ዳዺ ወይኒ ኑ ገተንተርሱስ ኑ ኬንቴርተ።<verse eid="PSA 60:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 60:4"/>አከ እሳን እዳ ጀላ ገረሳት በቀተኒፍ፣</para>
  <para style="q2" vid="PSA 60:4">አት ወረ ስ ሶዳተኒፍ መለቶ ኬንቴርተ።<verse eid="PSA 60:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 60:5"/>አከ ወር አት ጃለቱ ፉረመኒፍ፣</para>
  <para style="q2" vid="PSA 60:5">ሀርከኬ ምርጋቲን ኑ ኦልች፤ ኑ ገርጋርስ።<verse eid="PSA 60:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 60:6"/>ዋቅን እዶ ቁልቁሉማሳቲ አከነ ጄዼ ዱበቴረ፤</para>
  <para style="q2" vid="PSA 60:6">“አን ገመቹዻን ሼኬምን ገርገር ነንቆደ፤</para>
  <para style="q2" vid="PSA 60:6">ሱሉለ ሱኮትስ ነንሰፈረ።<verse eid="PSA 60:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 60:7"/>ግልኣድ ከንኮት፤ ምናሴንስ ከንኮት።</para>
  <para style="q2" vid="PSA 60:7">ኤፍሬም ጎንፎ ስቢላኮት፤</para>
  <para style="q2" vid="PSA 60:7">ይሁዳንስ ቦኩ ሞቱማኮት።<verse eid="PSA 60:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 60:8"/>ሞኣብ ጫቢ ዽቀትናኮት፤</para>
  <para style="q2" vid="PSA 60:8">ኤዶምራ ኮጴኮ ደርበዼ ነንቡሰ፤</para>
  <para style="q2" vid="PSA 60:8">ፍልስጤምረትስ ሞአናዻን ነንጌረረ።”<verse eid="PSA 60:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 60:9"/>ኤኙቱ መጋላ ጀቤፈምቴ እጃረምቴት ነ ፍደ?</para>
  <para style="q2" vid="PSA 60:9">ኤኙቱ ኤዶምት ነ ጌሰ?<verse eid="PSA 60:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 60:10"/>ያ ዋቅ፣ ከን ኑ ገቴ ሱመ ምቲ?</para>
  <para style="q2" vid="PSA 60:10">ያ ዋቅ፣ ከን ሎልቶተኬኘ ወጅን በኡ ድዴስ ሱመ ምቲ?<verse eid="PSA 60:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 60:11"/>ዲነኬኘ ኦፍራ ዾዉ ኑ ገርጋር፤</para>
  <para style="q2" vid="PSA 60:11">ገርጋርስ ነማ ፋይዳ ህንቀቡቲ።<verse eid="PSA 60:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 60:12"/>ኑ ዋቀ ወጅን ንሞአትነ፤</para>
  <para style="q2" vid="PSA 60:12">እንስ ዲኖተኬኘ ገድ ዽዺተ።<verse eid="PSA 60:12"/></para>
  <chapter eid="PSA 60"/>
  <chapter number="61" style="c" sid="PSA 61"/>
  <para style="cl">ፋርፈትና 61</para>
  <para style="ms1">ፋርፈትና ነመ ቦጅአሜ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዳዊት ከን ምአ ርቡቲን ፋርፈተሜ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 61:1"/>ያ ዋቅ፣ እየተኮ ዸገእ፤</para>
  <para style="q2" vid="PSA 61:1">ከዸትናኮስ ዸጌፈዹ።<verse eid="PSA 61:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 61:2"/>ዬሮ ገራንኮ ጭቴት፣</para>
  <para style="q2" vid="PSA 61:2">አን ሀንዳረ ለፋቲ ስን ዋመዸ፤</para>
  <para style="q2" vid="PSA 61:2">አት ገረ ከታ ነ ጫላ ኦል ዼረቱት ነ ጌስ።<verse eid="PSA 61:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 61:3"/>አት እዶ አን እት ኮሉ ገሉዻቲ፤</para>
  <para style="q2" vid="PSA 61:3">ፉለ ዲነኮ ዱረትስ ገሞ ጀባዸ።<verse eid="PSA 61:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 61:4"/>አን በረ በራን ዱንካነኬ ኬሰ ጅራቹ፣</para>
  <para style="q2" vid="PSA 61:4">ጋድሰ ቆቾኬቲ ጀለትስ ኮሉ ገሉ ነንሀወ።<verse eid="PSA 61:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 61:5"/>ያ ዋቅ፣ አት ወሬገኮ ዸጌሴርታቲ፤</para>
  <para style="q2" vid="PSA 61:5">ዻለ ወር መቃኬ ሶዳተን አርገተንስ ና ኬንቴርተ።<verse eid="PSA 61:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 61:6"/>በረ ጅሬኘ ሞቲ፣ ኡሙሪሳሌ</para>
  <para style="q2" vid="PSA 61:6">ዸሎታ ገረ ዸሎታት ዼሬስ።<verse eid="PSA 61:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 61:7"/>እንስ ፉለ ዋቃ ዱረት በረ በራን ሃሞኡ፤</para>
  <para style="q2" vid="PSA 61:7">አከ ጃለልኬቲፊ አመነሙማንኬ እሰ ኤገንስ ጎዽ።<verse eid="PSA 61:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 61:8"/>አንስ ፋርፈትና ገለታ መቃኬቲፍ ነንፋርፈዸ፤</para>
  <para style="q2" vid="PSA 61:8">ጉዩመ ጉያንስ ወሬገኮ ነንጉተዸ።<verse eid="PSA 61:8"/></para>
  <chapter eid="PSA 61"/>
  <chapter number="62" style="c" sid="PSA 62"/>
  <para style="cl">ፋርፈትና 62</para>
  <para style="ms1">ዋቀ ቆፈ አብደቹ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ዬዱቱኒፍ። ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 62:1"/>ሉቡንኮ ዋቀ ቆፈ ኤገት፤</para>
  <para style="q2" vid="PSA 62:1">ፈይንኮስ እሰ ብራ ና ዹፈ።<verse eid="PSA 62:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 62:2"/>ከታንኮቲፊ ፈይንኮ እሰ ቆፈ፤</para>
  <para style="q2" vid="PSA 62:2">እን ደኦኮት፤ አን ጎንኩማ ህንራፈሙ።<verse eid="PSA 62:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 62:3"/>እስን ሀመ ዮሚት ነመ ሚቱ?</para>
  <para style="q2" vid="PSA 62:3">ሀመ ዮሚት አከ ኬኘን መና ከን ዱፌት፣</para>
  <para style="q2" vid="PSA 62:3">አከ ደላ ራፈሜትስ ለፋን እሰ ዸኡ በርባዱ?<verse eid="PSA 62:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 62:4"/>እሳን ኣንጎሳ ጉዳ ሰነራ፣</para>
  <para style="q2" vid="PSA 62:4">ጉቱማት ገድ እሰ ዴብሱ በርባዱ፤</para>
  <para style="q2" vid="PSA 62:4">እሳን ሶበት ንገመዱ።</para>
  <para style="q1" vid="PSA 62:4">አፋንሳኒቲን ንኤብሱ፤</para>
  <para style="q2" vid="PSA 62:4">ገራሳኒቲን ገሩ ንአባሩ።<verse eid="PSA 62:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 62:5"/>ሉቡንኮ ዋቀ ቆፈ ኦብሳን ኤገት፤</para>
  <para style="q2" vid="PSA 62:5">አብዲንኮ እሰ ብራ ዹፋቲ።<verse eid="PSA 62:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 62:6"/>ከታንኮቲፊ ፈይንኮ እሰ ቆፈ፤</para>
  <para style="q2" vid="PSA 62:6">እን ደኦኮት፤ አን ህንራፈሙ።<verse eid="PSA 62:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 62:7"/>ፈይንኮቲፊ ኡልፍንኮ ሀርከ ዋቃ ኬሰ ጅረ፤</para>
  <para style="q2" vid="PSA 62:7">ከታንኮ ጀባን፣ እዶን አን እት ኮሉ ገሉ ዋቀ።<verse eid="PSA 62:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 62:8"/>ያ ነሞተ፣ ዬሮ ሁንደ እሰ አመነዻ፤</para>
  <para style="q2" vid="PSA 62:8">ገራኬሰንስ ፉለሳ ዱረት ዸንገላሳ፤</para>
  <para style="q2" vid="PSA 62:8">ዋቅን እዶ ኑ እት ኮሉ ገሉዻቲ።<verse eid="PSA 62:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 62:9"/>ጎሰ ቱፈተማራ ዸለቹን ሆማ ምት፤</para>
  <para style="q2" vid="PSA 62:9">ጎሰ ከበጀማራ ዸለቹንስ ሶቡመ፤</para>
  <para style="q1" vid="PSA 62:9">ዮ መዳሊዻን መዳለመን</para>
  <para style="q2" vid="PSA 62:9">ለቸኑ ቅሌንሰ ጫላ ሰልጰቱ።<verse eid="PSA 62:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 62:10"/>ዋን ሳምቻን አርገተን ህንአመነትና፤</para>
  <para style="q2" vid="PSA 62:10">ዋን ሀተሜንስ ህንኮርና።</para>
  <para style="q1" vid="PSA 62:10">ዮ ቀቤኝኬሰን ጉደቴሌ፣</para>
  <para style="q2" vid="PSA 62:10">ቀልቢኬሰን እሰረ ህንካአትና።<verse eid="PSA 62:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 62:11"/>ዋቅን ዬሮ ቶኮ ዱበቴ፤</para>
  <para style="q2" vid="PSA 62:11">አንሞ ዬሮ ለመ ነንዸገኤ፤</para>
  <para style="q1" vid="PSA 62:11">ኩንስ አከ ሁምን ከን ዋቃ ተኤዸ።<verse eid="PSA 62:11"/></para>
  <para style="q2">
    <verse number="12" style="v" sid="PSA 62:12"/>ያ ጎፍታ አራር ከንኬት።</para>
  <para style="q1" vid="PSA 62:12">አት ዹጉማን ቶኮ ቶኮ ነማ</para>
  <para style="q2" vid="PSA 62:12">አኩመ ሆጂሳት ገቲሳ ንኬንታፍ።<verse eid="PSA 62:12"/></para>
  <chapter eid="PSA 62"/>
  <chapter number="63" style="c" sid="PSA 63"/>
  <para style="cl">ፋርፈትና 63</para>
  <para style="ms1">ዋቀ በርባቸ</para>
  <para style="d">ፋርፈትና ዳዊት። ዬሮ እን ገሞጂ ይሁዳ ኬሰ ቱሬት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 63:1"/>ያ ዋቅ፣ አት ዋቀኮት፤</para>
  <para style="q2" vid="PSA 63:1">አን ዹጉማን ስን በርባደዸ፤</para>
  <para style="q1" vid="PSA 63:1">ለፈ ጎጋፊ ገሞጂ፣</para>
  <para style="q2" vid="PSA 63:1">ለፈ ብሻን ህንጅሬት፣</para>
  <para style="q1" vid="PSA 63:1">ሉቡንኮ ስ ዼቦት፤</para>
  <para style="q2" vid="PSA 63:1">ፎንኮስ ስት ገገበ።<verse eid="PSA 63:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 63:2"/>ከናፉ አን እዶ ቁልቁሉኬሰን ስ አርጌ፤</para>
  <para style="q2" vid="PSA 63:2">ሁምነኬቲፊ ኡልፍነኬስ ነንእላሌ።<verse eid="PSA 63:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 63:3"/>ዋን ጃለልኬ ጅሬኘ ጫሉፍ፣</para>
  <para style="q2" vid="PSA 63:3">ህዺንኮ ስ ጀጀት።<verse eid="PSA 63:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 63:4"/>አን ሀመን ጅሩት ስን ኤብሰ፤</para>
  <para style="q2" vid="PSA 63:4">መቃኬቲንስ ሀርከኮ ኦል ነንቀበዸ።<verse eid="PSA 63:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 63:5"/>ሉቡንኮ አከ ነመ ዹካፊ ጮመ ቁፌት ቁፍት፤</para>
  <para style="q2" vid="PSA 63:5">አፋንኮስ ህዺ እልሌቲን ስ ጀጀተ።<verse eid="PSA 63:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 63:6"/>አን ስሬኮረት ስን ያደዸ፤</para>
  <para style="q2" vid="PSA 63:6">ሀልከን ጉቱስ ዋኤኬ ነንያደ።<verse eid="PSA 63:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 63:7"/>ዋን አት ገርጋርሰኮ ታቴፍ፣</para>
  <para style="q2" vid="PSA 63:7">አን ጋድሰ ቆቾኬቲ ጀለት ገመቹዻን ነንፋርፈዸ።<verse eid="PSA 63:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 63:8"/>ሉቡንኮ ስት መጠንት፤</para>
  <para style="q2" vid="PSA 63:8">ሀርክኬ ምርጋ ኦል ነ ቀበ።<verse eid="PSA 63:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 63:9"/>ወር ሉቡኮ ገላፈቹ በርባደን ገሩ</para>
  <para style="q2" vid="PSA 63:9">ቦለ ለፋ እሰ ገድ ፈጎ ኬሰ ቡኡ።<verse eid="PSA 63:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 63:10"/>እሳን ደበርፈመኒ ጎራዴት ኬነሙ፤</para>
  <para style="q2" vid="PSA 63:10">ኛተ ዋንጎስ ንተኡ።<verse eid="PSA 63:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 63:11"/>ሞቲን ገሩ ዋቃት ንገመደ፤</para>
  <para style="q2" vid="PSA 63:11">ነምን ዋቃን ከከቱ ሁንድኑ ኡልፍነ አርገተ፤</para>
  <para style="q2" vid="PSA 63:11">አፋን ወረ ሶበ ዱበቱሞ ንጩፈመ።<verse eid="PSA 63:11"/></para>
  <chapter eid="PSA 63"/>
  <chapter number="64" style="c" sid="PSA 64"/>
  <para style="cl">ፋርፈትና 64</para>
  <para style="ms1">ወር ነመ አረብሰን አደበሙሳኒ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 64:1"/>ያ ዋቅ፣ ዮሙ አን እየዹ ሰገሌኮ ዸገእ፤</para>
  <para style="q2" vid="PSA 64:1">ሉቡኮስ ዶርስሱ ዲና ዱራ ባስ።<verse eid="PSA 64:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 64:2"/>መሪ ጀልኦታ ዱራ፣</para>
  <para style="q2" vid="PSA 64:2">መለ ነሞተ ሀሞ ዱራስ ነ ዾክስ።<verse eid="PSA 64:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 64:3"/>እሳን አረበሳኒ አከ ጎራዴ ቀረተን፤</para>
  <para style="q2" vid="PSA 64:3">ዱቢ ሀዻኣስ አኩመ ጥያት ቆጴፈቱ።<verse eid="PSA 64:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 64:4"/>እሳን ርጰኒ ነመ የከ ህንቀብኔት ፉታሱ፤</para>
  <para style="q2" vid="PSA 64:4">አኩመ ተሳስ ሶዳ መሌ እት ገድ ዺሱ።<verse eid="PSA 64:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 64:5"/>ካዮ ጀልእናረት ወል ጀጀቤሱ፤</para>
  <para style="q2" vid="PSA 64:5">ዋኤ ዾክሰኒ ክዮ ካኡስ ንመርአቱ፤</para>
  <para style="q2" vid="PSA 64:5">“ኤኙቱ እሰ አርጉ ደንደአ?” ጄዸኒስ ንያዱ።<verse eid="PSA 64:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 64:6"/>እሳንስ ጀልእነ ያዱዻን፣</para>
  <para style="q2" vid="PSA 64:6">“ኑ መለ ህርእነ ህንቀብኔ መለኔረ!” ጄዹ፤</para>
  <para style="q2" vid="PSA 64:6">ያድኒፊ ኬስ ገራ ነማ ገድ ፈጎዻቲ።<verse eid="PSA 64:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 64:7"/>ዋቅን ገሩ ጥየሳ እሳንት ፉታሰ፤</para>
  <para style="q2" vid="PSA 64:7">እሳንስ አኩመ ተሳ መዳኡ።<verse eid="PSA 64:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 64:8"/>እንስ አረቡመ እሳኒቲን እሳን በሌሰ፤</para>
  <para style="q2" vid="PSA 64:8">ወር እሳን አርገን ሁንድኑ ቱፊዻን መታ ራሱ።<verse eid="PSA 64:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 64:9"/>ነሞትን ሁንድኑ ንሶዳቱ፤</para>
  <para style="q2" vid="PSA 64:9">እሳን ሆጂ ዋቃ ንለብሱ፤</para>
  <para style="q2" vid="PSA 64:9">ዋን እን ሆጄቴሌ ንቀልቤፈቱ።<verse eid="PSA 64:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 64:10"/>ነምን ቀጄላን <char style="nd">ዋቀዮት</char> ገመደ፤</para>
  <para style="q2" vid="PSA 64:10">እሰትስ ኮሉ ገለ፤</para>
  <para style="q2" vid="PSA 64:10">ገረ ቶሌዪን ሁንድኑ እሳን ኡልፍነ አርገቱ።<verse eid="PSA 64:10"/></para>
  <chapter eid="PSA 64"/>
  <chapter number="65" style="c" sid="PSA 65"/>
  <para style="cl">ፋርፈትና 65</para>
  <para style="ms1">ሰበቢ ኬናሳቲፍ ዋቀዮን ጀጀቹ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 65:1"/>ያ ዋቅ፣ ጥዮን ኬሰት ገለተቱ ስ ኤገተ፤</para>
  <para style="q2" vid="PSA 65:1">ወሬግንኬኘስ ሲፍ ገልፈመ።<verse eid="PSA 65:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 65:2"/>ያ እሰ ከዸትና ነማ ዸጌሱ፣</para>
  <para style="q2" vid="PSA 65:2">ነምን ሁንድኑ ገረኬ ንዹፈ።<verse eid="PSA 65:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 65:3"/>ዬሮ ጩቡን ነ ሞአቴት፣</para>
  <para style="q2" vid="PSA 65:3">አት የከኬኘ ኑ ዺፍቴርተ።<verse eid="PSA 65:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 65:4"/>ወር አት ፍለቴ አከ እሳን ቄኤኬ ጅራተኒፍ</para>
  <para style="q2" vid="PSA 65:4">ኦፍት ዽኤስቴ ኤብፈሞዸ!</para>
  <para style="q1" vid="PSA 65:4">ኑስ ዋን ጋሪ መነኬቲቲን፣</para>
  <para style="q2" vid="PSA 65:4">ከን መነ ቁልቁሉማኬቲቲንስ ንቁፍነ።<verse eid="PSA 65:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 65:5"/>ያ ዋቅ ፈይሳኬኘ፣</para>
  <para style="q2" vid="PSA 65:5">አት ሆጂ ቀጄሉማ ሶዳችሳዻን <optbreak/> ዴቢ ኑ ኬንተ፤</para>
  <para style="q1" vid="PSA 65:5">ዳሪ ለፋ ሁንዱማፍ፣</para>
  <para style="q2" vid="PSA 65:5">ገላነ ፈጎት አርገሙፍስ አት አብዲዸ፤<verse eid="PSA 65:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 65:6"/>አት ሁምነ ኡፈቴርተ፤</para>
  <para style="q2" vid="PSA 65:6">ጀብነኬቲንስ ቱሉወን ሁንዴስቴ፤<verse eid="PSA 65:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 65:7"/>አት ሁርሳ ገላና፣</para>
  <para style="q2" vid="PSA 65:7">ሁርሳ ዸኣ ብሻኒ፣</para>
  <para style="q2" vid="PSA 65:7">ራፈመ ኡመታስ ንጨልእሲፍቴ።<verse eid="PSA 65:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 65:8"/>ወር ፈጎ ጅራተን ድንቂወንኬ ንሶዳቱ፤</para>
  <para style="q2" vid="PSA 65:8">አት ዬሮ በርኡፊ ዬሮ ዽኡት፣</para>
  <para style="q2" vid="PSA 65:8">አከ ፋርፈናን ገመቹ ፋርፈተሙ ንጎተ።<verse eid="PSA 65:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 65:9"/>አት ለፈ ንኤግደ፤ ብሻንስ ንኦባፍተ፤</para>
  <para style="q2" vid="PSA 65:9">አከ መሌስ ንገብፍተ፤</para>
  <para style="q1" vid="PSA 65:9">አከ ነሞታፍ ምዻን ኬነኒፍስ</para>
  <para style="q2" vid="PSA 65:9">ለጌን ዋቃ ብሻኒን ጉተመኒሩ፤</para>
  <para style="q2" vid="PSA 65:9">አት ከኑማፍ ቆጴስቴርታቲ።<verse eid="PSA 65:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 65:10"/>ቦኦሳ ብሻን ቁብስተ፤</para>
  <para style="q2" vid="PSA 65:10">ብዮሳስ ወል ቅጤስተ፤</para>
  <para style="q1" vid="PSA 65:10">ቲፉ ቦካቲንስ ንጂፍተ፤</para>
  <para style="q2" vid="PSA 65:10">ብቅለሳስ ንኤብፍተ።<verse eid="PSA 65:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 65:11"/>ጋሩማኬቲን በረ ንጎንፍተ፤</para>
  <para style="q2" vid="PSA 65:11">ዳንዲወንኬስ ጮመ ጮጮብሱ።<verse eid="PSA 65:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 65:12"/>ለፍት መርጋ ከን ገሞጂ አከ መሌ ምሰ፤</para>
  <para style="q2" vid="PSA 65:12">ጋረንስ ገመቹዻን ጉተሙ።<verse eid="PSA 65:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 65:13"/>ድሬወን ቡሻዬዻን ጉተሙ፤</para>
  <para style="q2" vid="PSA 65:13">ሱሉሎን ምዻኒን ሀጉገሙ፤</para>
  <para style="q2" vid="PSA 65:13">እሳንስ እልሌዻን እየኒ ፋርፈቱ።<verse eid="PSA 65:13"/></para>
  <chapter eid="PSA 65"/>
  <chapter number="66" style="c" sid="PSA 66"/>
  <para style="cl">ፋርፈትና 66</para>
  <para style="ms1">ዋቀ ገለቴፈቹ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 66:1"/>እስን ለፍት ሁንድኑ እልሌዻን ገረ ዋቃት እያ!<verse eid="PSA 66:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 66:2"/>ኡልፍነ መቃሳ ፋርፈዻ፤</para>
  <para style="q2" vid="PSA 66:2">ገለተሳቲፍስ ኡልፍነ ኬና!<verse eid="PSA 66:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 66:3"/>ዋቃን አከነ ጄዻ፤</para>
  <para style="q2" vid="PSA 66:3">“ሆጂንኬ አከም ሶዳችሳዸ!</para>
  <para style="q1" vid="PSA 66:3">ሰበቢ ሁምንኬ ጉዳ ተኤፍ፣</para>
  <para style="q2" vid="PSA 66:3">ዲኖትንኬ ፉለኬ ዱረት ሆለቱ።<verse eid="PSA 66:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 66:4"/>ለፍት ሁንድኑ ሲፍ ሰገዱ፤</para>
  <para style="q2" vid="PSA 66:4">ፋርፈትና ገለታ ሲፍ ፋርፈቱ፤</para>
  <para style="q2" vid="PSA 66:4">መቃኬቲፍስ ፋርፈቱ።”<verse eid="PSA 66:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 66:5"/>ኮታቲ ዋን ዋቅን ሆጄቴ፣</para>
  <para style="q2" vid="PSA 66:5">ሆጂ ሶዳቺሳ እን ነማፍ ሆጄቴ እላላ!<verse eid="PSA 66:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 66:6"/>እን ገላነ ለፈ ጎጋት ጌደሬ፤</para>
  <para style="q2" vid="PSA 66:6">እሳንስ ሚለሳኒቲን ለገ ጬአን፤</para>
  <para style="q2" vid="PSA 66:6">ኮታ እሰት ሃገመኑ!<verse eid="PSA 66:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 66:7"/>እን በረ በራን ሁምነሳቲን ቡልቸ፤</para>
  <para style="q2" vid="PSA 66:7">እጅሳስ ሰቦተ እላለ፤</para>
  <para style="q2" vid="PSA 66:7">ፍንጭልቶትን ኦል ኦል ኦፍ ህንቀብን።<verse eid="PSA 66:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 66:8"/>ያ ሰቦተ፣ ዋቀኬኘ ኤብሳ፤</para>
  <para style="q2" vid="PSA 66:8">ሰገሌን እሰ ገለቴፈቱስ ሃዸገአሙ፤<verse eid="PSA 66:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 66:9"/>እን ሉቡኬኘ ጅራችሴረ፤</para>
  <para style="q2" vid="PSA 66:9">ሚለኬኘስ ሙጩጫቹ ኦልቼረ።<verse eid="PSA 66:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 66:10"/>ያ ዋቀዮ፣ አት ኑ ቆርቴርታቲ፤</para>
  <para style="q2" vid="PSA 66:10">አኩመ ሜቲስ ኑ ቁልቁሌስቴርተ።<verse eid="PSA 66:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 66:11"/>አት ክዮት ኑ ገልችቴርተ፤</para>
  <para style="q2" vid="PSA 66:11">ዱግደኬኘረስ በኣ ኬሴርተ።<verse eid="PSA 66:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 66:12"/>አከ ነሞትን መታኬኘ ያበተን ጎቴርተ፤</para>
  <para style="q2" vid="PSA 66:12">ኑ እብዳፊ ብሻን ኬሰ ደበሬ፤</para>
  <para style="q2" vid="PSA 66:12">አት ገሩ እዶ በዻዹማት ኑ ፍዴ።<verse eid="PSA 66:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 66:13"/>አንስ ቀልመ ጉበሙ ቀበዼ <optbreak/> መነ ቁልቁሉማኬ ነንሴነ፤</para>
  <para style="q2" vid="PSA 66:13">ወሬገኮስ ሲፍ ነንገልቸ፤<verse eid="PSA 66:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 66:14"/>ኩንስ ወሬገ ዬሮ አን ረክነ ኬሰ ቱሬት</para>
  <para style="q2" vid="PSA 66:14">አረብንኮ ዋዳ ገሌ አፋንኮስ ዱበቴዸ።<verse eid="PSA 66:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 66:15"/>አንስ ሆሪ ጮጮሞ፣ ቀልመ ጉበሙ፣</para>
  <para style="q2" vid="PSA 66:15">ኮርቤዪ ሆላሞ ኣርሳ ጎዼ ሲፍ ነንዽኤሰ፤</para>
  <para style="q2" vid="PSA 66:15">ጅቦታፊ ሬኦተሌ ኣርሳ ሲፍን ዽኤሰ።<verse eid="PSA 66:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 66:16"/>እስን ወር ዋቀ ሶዳተን ሁንድ ኮታ ዸጌፈዻ፤</para>
  <para style="q2" vid="PSA 66:16">አንስ ዋን እን ናፍ ጎዼ እስንት ነንህመ።<verse eid="PSA 66:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 66:17"/>አን አፋንኮቲን እሰት ነንእዬ፤</para>
  <para style="q2" vid="PSA 66:17">ገለንሳስ አረበኮረ ቱሬ።<verse eid="PSA 66:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 66:18"/>ኡቱ አን ገራኮ ኬሰ ጩቡ ካአዼ ጅራዼ፣</para>
  <para style="q2" vid="PSA 66:18">ስላ ጎፍታን ናፍ ህንዸገኡ ቱሬ፤<verse eid="PSA 66:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 66:19"/>ዋቅን ገሩ ዹጉማን ነ ዸጌፈቴረ፤</para>
  <para style="q2" vid="PSA 66:19">ሰገሌ ከዸትናኮቲስ ዸገኤረ።<verse eid="PSA 66:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 66:20"/>ዋቅን ከዸትናኮ ህንድድን</para>
  <para style="q2" vid="PSA 66:20">ዮካን ጃለለሳ ነ ህንዾወትን ሃኤብፈሙ!<verse eid="PSA 66:20"/></para>
  <chapter eid="PSA 66"/>
  <chapter number="67" style="c" sid="PSA 67"/>
  <para style="cl">ፋርፈትና 67</para>
  <para style="ms1">ፋርፈትና ዬሮ ምዻን ገልፈሙ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ምአ ርቡቲን። ፋርፈትና።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 67:1"/>ዋቅን ገራ ኑፍ ላፉ፤ ኑ ሃኤብሱስ፤</para>
  <para style="q2" vid="PSA 67:1">ፉለሳስ ኑረት ሃእብሱ፤<verse eid="PSA 67:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 67:2"/>ኩንስ አከ ከራንኬ ለፈረት፣</para>
  <para style="q2" vid="PSA 67:2">ፈይሱን ኬሞ ሰቦተ ሁንዱማ ብረት ቤከሙፍ።<verse eid="PSA 67:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 67:3"/>ያ ዋቀዮ፣ ሰቦትን ስ ሃጀጀተን፤</para>
  <para style="q2" vid="PSA 67:3">ሰቦትን ሁንዲ ስ ሃጀጀተን።<verse eid="PSA 67:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 67:4"/>አት ዋን ቀጄሉማዻን ነሞተ ቡልችቱፍ፣</para>
  <para style="q2" vid="PSA 67:4">ሰቦተ ለፈራስ ዋን ጌጌስቱፍ፣</para>
  <para style="q2" vid="PSA 67:4">ሰቦትን ሃገመደንስ፤ እልልቸኒስ ሃፋርፈተን።<verse eid="PSA 67:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 67:5"/>ያ ዋቀዮ፣ ሰቦትን ስ ሃጀጀተን፤</para>
  <para style="q2" vid="PSA 67:5">ሰቦትን ሁንዲ ስ ሃጀጀተን።<verse eid="PSA 67:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 67:6"/>ለፍት ምዻን ኬንቴርት፤</para>
  <para style="q2" vid="PSA 67:6">ዋቀዮ ዋቅንኬኘስ ኑ ኤብሴረ።<verse eid="PSA 67:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 67:7"/>ዋቅን ኑ ኤብሴረ፤</para>
  <para style="q2" vid="PSA 67:7">ሀንዳር ለፋ ሁንድ እሰ ሃሶዳቱ።<verse eid="PSA 67:7"/></para>
  <chapter eid="PSA 67"/>
  <chapter number="68" style="c" sid="PSA 68"/>
  <para style="cl">ፋርፈትና 68</para>
  <para style="ms1">ፋርፈትና ሞአትኖ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 68:1"/>ዋቅን ሃከኡ፤ ዲኖትንሳስ ሃብትናአን፤</para>
  <para style="q2" vid="PSA 68:1">ወር እሰ ጅበንስ ፉለሳ ዱራ ሃበቀተን።<verse eid="PSA 68:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 68:2"/>አኩመ ኣር ብትናኡ፣ አት እሳን ብትኔስ፤</para>
  <para style="q2" vid="PSA 68:2">አኩመ ገጋን እብደ ዱረት በቁ፣</para>
  <para style="q2" vid="PSA 68:2">ሀሞን ፉለ ዋቃ ዱራ ሃበደን።<verse eid="PSA 68:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 68:3"/>ቀጄሎን ገሩ ሃገመደን፤</para>
  <para style="q2" vid="PSA 68:3">ፉለ ዋቃ ዱረትስ ባይኤ ሃገመደን፤</para>
  <para style="q2" vid="PSA 68:3">እሳን ገመቹዻን ሃእልልቸን።<verse eid="PSA 68:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 68:4"/>ዋቃፍ ፋርፈዻ፤</para>
  <para style="q2" vid="PSA 68:4">ፋርፈትና ገለታ መቃሳቲፍ ፋርፈዻ፤</para>
  <para style="q2" vid="PSA 68:4">እሰ ዱሜሳን ጉሉፉ ሰነ ጀጀዻ፤</para>
  <para style="q1" vid="PSA 68:4">መቃንሳ <char style="nd">ዋቀዮዸ</char>፤</para>
  <para style="q2" vid="PSA 68:4">ፉለሳ ዱረትስ ባይኤ ገመዳ።<verse eid="PSA 68:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 68:5"/>ዋቅን ወረ አባ ህንቀብኔፍ አባ፣</para>
  <para style="q2" vid="PSA 68:5">ኒቶተ ዽርሶትንራ ዱአኒፍስ ፈልማ ተኤ ሱን</para>
  <para style="q2" vid="PSA 68:5">እዶ ጅሬኘሳ ቁልቁሉ ኬሰ ጅረ።<verse eid="PSA 68:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 68:6"/>ዋቅን ወረ ኮጳ ተአን ማቲ ኬሰ ጅራችሰ፤</para>
  <para style="q2" vid="PSA 68:6">ወረ ህዸመንስ መነ ህዻቲ ባሰ፤</para>
  <para style="q2" vid="PSA 68:6">ፍንጭልቶትን ገሩ ለፈ ጎጋረ ጅራቱ።<verse eid="PSA 68:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 68:7"/>ያ ዋቀዮ፣ ጋፈ አት ሰበኬ ዱረ ባቴ፣</para>
  <para style="q2" vid="PSA 68:7">ጋፈ አት ገሞጂ ኬሰ ደበርቴ፣<verse eid="PSA 68:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 68:8"/>ፉለ ዋቃ፣ ዋቀ ሲና ዱረት፣</para>
  <para style="q2" vid="PSA 68:8">ፉለ ዋቃ፣ ዋቀ እስራኤል ዱረት፣</para>
  <para style="q2" vid="PSA 68:8">ለፍት ንራፈምቴ፤ ሰሚወንስ ቦካ ሮብሰን።<verse eid="PSA 68:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 68:9"/>ያ ዋቀዮ፣ አት ቦካ ባይኤ ሮብስቴ፤</para>
  <para style="q2" vid="PSA 68:9">ዻለኬ ከን ደዸቤሌ ንቁብስቴ።<verse eid="PSA 68:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 68:10"/>ሰብንኬ አች ቁበቴ፤</para>
  <para style="q2" vid="PSA 68:10">ያ ዋቀዮ፣ አት በዻዹማኬ ኬሳ <optbreak/> ህዬዪ ሶርቴ።<verse eid="PSA 68:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 68:11"/>ጎፍታን ዱቢሳ ኬኔ፤</para>
  <para style="q2" vid="PSA 68:11">ዱበርቶትን ዱቢ ሰነ ለብሰንስ ባይኤዸ፦<verse eid="PSA 68:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 68:12"/>“ሞቶትኒፊ ሎልቶትን አሪቲን በቀተን፤</para>
  <para style="q2" vid="PSA 68:12">ዱበርቶትን ቄኤ ኦለን ቦጁ ቆደተን።<verse eid="PSA 68:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 68:13"/>ዮ ጎለ ሆሎታ ግዱት አርገምተንሌ፣</para>
  <para style="q2" vid="PSA 68:13">እስን አከ ጉጌ ቆቾንሼ ሜቲዻን ኡፍፈሜ</para>
  <para style="q2" vid="PSA 68:13">ባሌንሼሞ ወርቄ ጨለቅሱን ኡፍፈሜት።”<verse eid="PSA 68:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 68:14"/>ዮሙ ዋቅን ዋን ሁንደ ደንደኡ</para>
  <para style="q2" vid="PSA 68:14">ሞቶተ አችት ብትኔሴት፣ <optbreak/> ዘልሞንረት ጨቢን ቡኤ።<verse eid="PSA 68:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 68:15"/>ያ ቱሉ ባሻን፣ ያ ቱሉ ሱረ ቀቤሰ፣</para>
  <para style="q2" vid="PSA 68:15">ያ ቱሉ ባሻን፣ ያ ቱሉ ፊጤ ባይኤ ቀቡ፣<verse eid="PSA 68:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 68:16"/>ያ ቱሉ ፊጤ ባይኤ ቀብዱ፣</para>
  <para style="q2" vid="PSA 68:16">አት ማሊፍ ቱሉ ዋቅን ቡልቹፍ ፍለቴ፣</para>
  <para style="q2" vid="PSA 68:16">እዶ <char style="nd">ዋቀዮ</char> በረ በራን ጅራቱ ሰነ<optbreak/> ህናፋዻን እላልተ?<verse eid="PSA 68:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 68:17"/>ጋሪወን ዋቃ ኩመ ሄዱዸ፤</para>
  <para style="q2" vid="PSA 68:17">እሳን ኩማተመ ዬሮ ኩማተማት፤</para>
  <para style="q2" vid="PSA 68:17">ጎፍታንስ ሲናዻ ገረ እዶ ቁልቁሉ ዹፌረ።<verse eid="PSA 68:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 68:18"/>አት ዮሙ ኦል ጉባ ባቴት</para>
  <para style="q2" vid="PSA 68:18">ቦጁ ባይኤ ፉዸቴ፤</para>
  <para style="q1" vid="PSA 68:18">ያ <char style="nd">ዋቀዮ</char>፣ ያ ዋቅ፣ አት አች ጅራቹፍ ጄቴ፣</para>
  <para style="q2" vid="PSA 68:18">ነሞተራ፣ ፍንጭልቶተራስ ኬና ፉዸቴ።<verse eid="PSA 68:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 68:19"/>ጎፍታን ጉዩመ ጉያን በኣኬኘ ባቱ፣</para>
  <para style="q2" vid="PSA 68:19">ዋቅን ፈይሳኬኘ ተኤ ሱን ሃኤብፈሙ።<verse eid="PSA 68:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 68:20"/>ዋቅንኬኘ ዋቀ ፈይናት፤ ዱአ ጀላ በኡንስ</para>
  <para style="q2" vid="PSA 68:20">
    <char style="nd">ዋቀዮ</char> ጎፍትቸ ብራ ዹፈ።<verse eid="PSA 68:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 68:21"/>ዋቅን ዹጉማን መታ ዲነሳ፣</para>
  <para style="q2" vid="PSA 68:21">ጉቤ መታ ወረ ጩቡሳኒት ፉፈኒ <optbreak/> ከን ርፌንሰ ቀቡ ንጨጨብሰ።<verse eid="PSA 68:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 68:22"/>ጎፍታን አከነ ጄዸ፤ “አን ዴብሴ ባሻኒ እሳን ነንፍደ፤</para>
  <para style="q2" vid="PSA 68:22">ቱጁበ ገላና ኬሳስ ዴብሴ እሳን ነንፍደ፤<verse eid="PSA 68:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 68:23"/>ኩንስ አከ አት ዺገ ዲኖተኬቲ ሚለኬቲን ቦርጭቱፍ፤</para>
  <para style="q2" vid="PSA 68:23">አረብን ሰሮተኬቲስ አከ ቆደሳኒ ቀባቱፍ።”<verse eid="PSA 68:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 68:24"/>ያ ዋቀዮ፣ ህሪርኬ ሙልአቴረ፤</para>
  <para style="q2" vid="PSA 68:24">ህሪር ዋቀኮቲቲፊ ሞቲኮቲ እዶ ቁልቁሉት ኦል ገሌረ።<verse eid="PSA 68:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 68:25"/>ፉለ ዱራን ፋርፈቶተ፣</para>
  <para style="q2" vid="PSA 68:25">ዱግደ ዱባንሞ ወረ ሙዚቃ ተጰተንቱ ቱሬ፤</para>
  <para style="q2" vid="PSA 68:25">ዱበርቶትን ድቤ ሩኩተንስ ግዱሳኒ ቱረን።<verse eid="PSA 68:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 68:26"/>ወልዳ ጉዳ ኬሰት ዋቀ ጀጀዻ፤</para>
  <para style="q2" vid="PSA 68:26">ያኢ እስራኤል ኬሰትስ <char style="nd">ዋቀዮን</char> ጀጀዻ።<verse eid="PSA 68:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 68:27"/>ቤንያም ጎስት ጥንች እሳን ዱረ ዴመ፤</para>
  <para style="q2" vid="PSA 68:27">ቱትን እልማን ሞቶተ ይሁዳስ አች ቱረን፤</para>
  <para style="q2" vid="PSA 68:27">እልማን ሞቶተ ዜቡሎኒፊ ንፍታሌምስ አች ቱረን።<verse eid="PSA 68:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 68:28"/>ያ ዋቀዮ፣ ሁምነኬ አጀጅ፤</para>
  <para style="q2" vid="PSA 68:28">ያ ዋቀኬኘ፣ አኩመ ዱራን ጎቴ ሰነ<optbreak/> ጀብነኬ ኑ አርግሲስ።<verse eid="PSA 68:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 68:29"/>ሰበቢ መነ ቁልቁሉማኬቲ ከን ዬሩሳሌም ኬሳቲፍ</para>
  <para style="q2" vid="PSA 68:29">ሞቶትን ኬና ሲፍ ፍዱ።<verse eid="PSA 68:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 68:30"/>ብኔንሶተ ሸምበቆ ኬሳ፣</para>
  <para style="q2" vid="PSA 68:30">ከረ ኮሮሚ ጀቦተ ሰቦታ ኬሳስ እፈዹ።</para>
  <para style="q1" vid="PSA 68:30">ወረ ሜቲ ፍደን ገድ ዴብስ።</para>
  <para style="q2" vid="PSA 68:30">ወረ ወራነት ገመደንስ ብትኔስ።<verse eid="PSA 68:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 68:31"/>ኤርገሞትን ግብጥ ንዹፉ፤</para>
  <para style="q2" vid="PSA 68:31">እቶጵያንስ ደፍቴ ሀርከሼ ዋቀት በልእፈት።<verse eid="PSA 68:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 68:32"/>ያ ሞቱሞተ ለፋ፣ ዋቀ ፋርፈዻ፤</para>
  <para style="q2" vid="PSA 68:32">ፋርፈትና ገለታስ ጎፍታዻፍ ፋርፈዻ፤<verse eid="PSA 68:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 68:33"/>እሰ ሰሚወን ዱሪ ኬሰ ጉሉፉ፣</para>
  <para style="q2" vid="PSA 68:33">እሰ ሰገሌ ጀባዻን ቀቀዌሰኡ ሰነ ፋርፈዻ።<verse eid="PSA 68:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 68:34"/>ዋቀ ኡልፍንሳ እስራኤልራ ጅሩ፣</para>
  <para style="q2" vid="PSA 68:34">እሰ ሚዸግንሳ</para>
  <para style="q2" vid="PSA 68:34">ሰሚወን ኬሰ ጅሩ ሰነ ሁምነሳ ለብሳ።<verse eid="PSA 68:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 68:35"/>ያ ዋቀዮ፣ አት እዶ ቁልቁሉማኬቲት ሶዳችሳዸ፤</para>
  <para style="q2" vid="PSA 68:35">ዋቅን እስራኤል ሰበሳቲፍ ሁምናፊ ጀብነ ንኬነ።</para>
  <para style="b" vid="PSA 68:35"/>
  <para style="q1" vid="PSA 68:35">ዋቅን ሃኤብፈሙ!<verse eid="PSA 68:35"/></para>
  <chapter eid="PSA 68"/>
  <chapter number="69" style="c" sid="PSA 69"/>
  <para style="cl">ፋርፈትና 69</para>
  <para style="ms1">ፋሩ ቦእቻ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ዬደሎ “ደራራቲን።” ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 69:1"/>ያ ዋቅ፣ አት ነ ባስ፤</para>
  <para style="q2" vid="PSA 69:1">ብሻን ኦል ዹፌ ሞርመ ነ ገኤራቲ።<verse eid="PSA 69:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 69:2"/>አን ራሬ ኬሰ፣ ለፈ እዶን ሚለ ዻበተን</para>
  <para style="q2" vid="PSA 69:2">ህንጅሬ ኬሰ ሴኔረ።</para>
  <para style="q1" vid="PSA 69:2">አን ቱጁበ ብሻኒ ኬሰ ሴኔረ፤</para>
  <para style="q2" vid="PSA 69:2">ሎላንስ ነረ ገረገሌረ።<verse eid="PSA 69:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 69:3"/>አን እዩዻን ደዸቤረ፤</para>
  <para style="q2" vid="PSA 69:3">ላጋንኮ በበቀቄረ፤</para>
  <para style="q2" vid="PSA 69:3">እጅኮ፣ ዋቀኮ ኤገቹዻን ደዸቤረ።<verse eid="PSA 69:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 69:4"/>ወር ለፉማ ከአኒ ነ ጅበን</para>
  <para style="q2" vid="PSA 69:4">ርፌንሰ መታኮቲ ጫላ ባይአቱ፤</para>
  <para style="q1" vid="PSA 69:4">ወር ነ አጄሱ በርባደን፣</para>
  <para style="q2" vid="PSA 69:4">ወር አከሱማን ዲነኮ ተአን ባይኤዸ።</para>
  <para style="q1" vid="PSA 69:4">አን አከን ዋን ህንሀትን</para>
  <para style="q2" vid="PSA 69:4">ዴብሱ ድርቀሜረ።<verse eid="PSA 69:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 69:5"/>ያ ዋቅ፣ አት ጎዉማኮ ንቤክተ፤</para>
  <para style="q2" vid="PSA 69:5">የክኮስ ስ ዱራ ህንዾከቱ።<verse eid="PSA 69:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 69:6"/>ያ ጎፍታ፣ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንዴሱ፣</para>
  <para style="q2" vid="PSA 69:6">ወር አብዲ ስረ ካአተን፣</para>
  <para style="q2" vid="PSA 69:6">ሰበቢኮቲፍ ህንቃነእን፤</para>
  <para style="q1" vid="PSA 69:6">ያ ዋቀ እስራኤል፣ ወር ስ በርባደን፣</para>
  <para style="q2" vid="PSA 69:6">ሰበቢኮቲፍ ህንቃኔፈምን።<verse eid="PSA 69:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 69:7"/>አን ሲፍ ጄዼ ቱፊ ኦብሴራቲ፤</para>
  <para style="q2" vid="PSA 69:7">ቃኒንስ ፉለኮ ሀጉጌረ።<verse eid="PSA 69:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 69:8"/>አን ኦቦሎተኮት ኬሱማ፣</para>
  <para style="q2" vid="PSA 69:8">እልማን ሃዸኮቲትስ አለጋዸ፤<verse eid="PSA 69:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 69:9"/>ህናፋን መነኬቲ ነ ጉጉቤራቲ፤</para>
  <para style="q2" vid="PSA 69:9">አረብሶን ወረ ስ አረብሰኒስ ነረ ቡኤረ።<verse eid="PSA 69:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 69:10"/>ቦኡፊ ሶሙንኮ፣</para>
  <para style="q2" vid="PSA 69:10">አረብሶ ነት ተኤ።<verse eid="PSA 69:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 69:11"/>ዮሙ አን ወያ ገዳ ኡፈዼት፣</para>
  <para style="q2" vid="PSA 69:11">ነሞትን ነት ቆሱ።<verse eid="PSA 69:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 69:12"/>ወር ከረ ዱረ ተታአን ነት ቆሱ፤</para>
  <para style="q2" vid="PSA 69:12">መቾፍቶትንስ ዋኤኮቲን ስርቡ።<verse eid="PSA 69:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 69:13"/>አን ገሩ ያ <char style="nd">ዋቀዮ</char>፣</para>
  <para style="q2" vid="PSA 69:13">ዬሮ አት ፍለቱት ስን ከዸዸ፤</para>
  <para style="q1" vid="PSA 69:13">ያ ዋቅ፣ ጃለለኬ ጉድቻን</para>
  <para style="q2" vid="PSA 69:13">ፈይነኬ ከን ዹጋቲንስ ዴቢ ናፍ ኬን።<verse eid="PSA 69:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 69:14"/>አከ አን ህንልቅምፈምኔፍ፣</para>
  <para style="q2" vid="PSA 69:14">ራሬ ኬሳ ነ ባስ፤</para>
  <para style="q1" vid="PSA 69:14">ወረ ነ ጅበን ጀላ፣</para>
  <para style="q2" vid="PSA 69:14">ብሻኖተ ገድ ፈጎ ኬሳስ ነ ባስ።<verse eid="PSA 69:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 69:15"/>አት አከ ሎላን ነ ህንፉዸትኔ፣</para>
  <para style="q2" vid="PSA 69:15">አከ ቱጁብን ነ ህንልቅምስኔ፣</para>
  <para style="q2" vid="PSA 69:15">አከ ቦልስ አፋንሳ ነት ህንጩፈትኔ ጎዽ።<verse eid="PSA 69:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 69:16"/>ያ <char style="nd">ዋቀዮ</char>፣ ጋሩማ ጃለለኬቲቲን <optbreak/> ዴቢ ናፍ ኬን፤</para>
  <para style="q2" vid="PSA 69:16">አራረኬ ጉድቻንስ ነት ገረገል።<verse eid="PSA 69:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 69:17"/>ፉለኬ ተጃጅላኬ ዱራ ህንዾክፈትን፤</para>
  <para style="q2" vid="PSA 69:17">ዋን አን ረክነ ኬሰ ጅሩፍ ደፊቲ ዴቢ ናፍ ኬን።<verse eid="PSA 69:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 69:18"/>ነት ዽኣዹቲ ነ ፉር፤</para>
  <para style="q2" vid="PSA 69:18">ጢቂ ዲኖተኮቲፍ ጄዺ ነ ባስ።<verse eid="PSA 69:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 69:19"/>አት አከ አን ሀመም ቱፈተሜ፣</para>
  <para style="q2" vid="PSA 69:19">ሰልጵፈሜፊ አከ አን ቃኔፈሜ ንቤክተ፤</para>
  <para style="q2" vid="PSA 69:19">ዲኖትንኮ ሁንድኑስ ፉለኮ ዱረ ጅሩ።<verse eid="PSA 69:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 69:20"/>አረብሶን ገራኮ ጨብሴ፤</para>
  <para style="q2" vid="PSA 69:20">አንስ አብዲ ኩተዼረ።</para>
  <para style="q1" vid="PSA 69:20">አን ነመ ገራ ናፍ ላፉ ነንበርባዴ፤ ገሩ ነንዸቤ፤</para>
  <para style="q2" vid="PSA 69:20">ነመ ነ ጀጀቤሱስ ነንበርባዴ፤ <optbreak/> ገሩ ቶኮሌ ህንአርገኔ።<verse eid="PSA 69:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 69:21"/>ኛተኮት ሀዾፍቱ መከን፤</para>
  <para style="q2" vid="PSA 69:21">አከ አን ዹጉፍሞ ዋን ዸንገጋኣ ና ኬነን።<verse eid="PSA 69:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 69:22"/>ማዲንሳኒ እዳ እሳንት ሃተኡ፤</para>
  <para style="q2" vid="PSA 69:22">አደባፊ ክዮ እሳንት ሃተኡ።<verse eid="PSA 69:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 69:23"/>አከ አርጉ ህንደንዴኜፍ እጅሳኒ ሃሀጉገሙ፤</para>
  <para style="q2" vid="PSA 69:23">ዱግድሳኒስ በረ በራን ሃጎጰቱ።<verse eid="PSA 69:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 69:24"/>ዼከምሰኬ እሳንረት ዸንገላስ፤</para>
  <para style="q2" vid="PSA 69:24">ኣሪንኬ ቦበኣን ሱንስ እሳንረ ሃቡኡ።<verse eid="PSA 69:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 69:25"/>ቄኤንሳኒ ሃኦኑ፤</para>
  <para style="q2" vid="PSA 69:25">ነምን ዱንካነሳኒ ኬሰ ጅራቱ ቶኮዩ ህንሀፍን።<verse eid="PSA 69:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 69:26"/>እሳን ወረ አት መዴስቴ ሰነ ንአርአቱቲ፤</para>
  <para style="q2" vid="PSA 69:26">ዋኤ ዹኩቢ ወረ አት ሚቴ ሰናስ ንኦዴሱ።<verse eid="PSA 69:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 69:27"/>የከረት የከ እሳንት ደበል፤</para>
  <para style="q2" vid="PSA 69:27">እሳን ገረ ቀጄሉመኬቲ ህንዹፍን።<verse eid="PSA 69:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 69:28"/>መቃንሳኒ ክታበ ጅሬኛ ኬሳ ሃሀቀሙ፤</para>
  <para style="q2" vid="PSA 69:28">ቀጄልቶተ ወጅንስ ህንገልሜፈምን።<verse eid="PSA 69:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 69:29"/>አን ገሩ ዽጵናፊ ረክነኬሰን ጅረ፤</para>
  <para style="q2" vid="PSA 69:29">ያ ዋቅ፣ ፈይንኬ ኦል ነ ሃቀቡ።<verse eid="PSA 69:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 69:30"/>አን ፋርፈናዻን መቃ ዋቃ ነንገለቴፈዸ፤</para>
  <para style="q2" vid="PSA 69:30">ገለታንስ ኡልፍነ ነንኬናፍ።<verse eid="PSA 69:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 69:31"/>ኩንስ ሰንጋ ጫላ፣ ኮርመ ጋንፋፊ</para>
  <para style="q2" vid="PSA 69:31">ኮቴ ቀቡ ዽኤሱ ጫላ <char style="nd">ዋቀዮን</char> ገመቺሰ።<verse eid="PSA 69:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 69:32"/>ህዬዪን ዋን ከነ አርገኒ ንገመዱ፤</para>
  <para style="q2" vid="PSA 69:32">እስን ወር ዋቀ በርባደን ገራንኬሰን ጅራተ ሃተኡ!<verse eid="PSA 69:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 69:33"/>
    <char style="nd">ዋቀዮ</char> ረከቶተ ንዸገአ፤</para>
  <para style="q2" vid="PSA 69:33">ነሞተሳ ወረ ህዸመንስ ህንቱፈቱ።<verse eid="PSA 69:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 69:34"/>ሰሚፊ ለፍት፣ ገላኖትኒፊ</para>
  <para style="q2" vid="PSA 69:34">ወን እሳን ኬሰ ጅራተን ሁንድኑ እሰ ሃሌልሰን።<verse eid="PSA 69:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 69:35"/>ዋቅን ጥዮንን ንፈይሳቲ፤</para>
  <para style="q2" vid="PSA 69:35">መጋላወን ይሁዳስ ዴብሴ ንእጃረ።</para>
  <para style="q1" vid="PSA 69:35">ሰብንሳስ አች ቁበተ፤ ንዻለስ።<verse eid="PSA 69:35"/></para>
  <para style="q2">
    <verse number="36" style="v" sid="PSA 69:36"/>ሰኚን ተጃጅልቶተሳ መጋለቲ ንዻሉ፤</para>
  <para style="q2" vid="PSA 69:36">ወር መቃሳ ጃለተንስ አች ጅራቱ።<verse eid="PSA 69:36"/></para>
  <chapter eid="PSA 69"/>
  <chapter number="70" style="c" sid="PSA 70"/>
  <para style="cl">ፋርፈትና 70</para>
  <para style="ms1">እየ ዽጵና</para>
  <para style="mr">
    <ref loc="PSA 70:1-5">70፥1‑5</ref> ኩወፈ – <char style="xt"><ref loc="PSA 40:13-17">ፋር 40፥13‑17</ref></char></para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 70:1"/>ያ ዋቅ፣ ነ ፈይሱፍ አሪፈዹ፤</para>
  <para style="q2" vid="PSA 70:1">ያ <char style="nd">ዋቀዮ</char>፣ ነ ገርጋሩፍ ደፊ ኮቱ።<verse eid="PSA 70:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 70:2"/>ወር ሉቡኮ ገላፈቹ በርባደን</para>
  <para style="q2" vid="PSA 70:2">ሁንድኑ፣ ሃቃነአን፤ ሃቡርጃጀአንስ፤</para>
  <para style="q1" vid="PSA 70:2">ወር በዲኮ ሀወን ሁንድ</para>
  <para style="q2" vid="PSA 70:2">ቃነአኒ ዱበት ሃዴብአን።<verse eid="PSA 70:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 70:3"/>ወር፣ “በገ! በገ!” አናን ጄዸን</para>
  <para style="q2" vid="PSA 70:3">ቃነአኒ ዱበት ሃዴብአን።<verse eid="PSA 70:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 70:4"/>ወር ስ በርባደን ሁንድኑ ገሩ</para>
  <para style="q2" vid="PSA 70:4">ስት ገመደኒ ሃእልልቸን፤</para>
  <para style="q1" vid="PSA 70:4">ወር ፈይሱኬ ጃለተን፣</para>
  <para style="q2" vid="PSA 70:4">ዬሮ ሁንደ፣ “ዋቅን ጉዳዸ!” ሃጄዸን።<verse eid="PSA 70:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 70:5"/>አን ገሩ ህዬሳፊ ረከታዸ፤</para>
  <para style="q2" vid="PSA 70:5">ያ ዋቅ፣ ደፊ ነ ቀቀብ።</para>
  <para style="q1" vid="PSA 70:5">አት ገርጋራኮፊ ፈይሳኮት፤</para>
  <para style="q2" vid="PSA 70:5">ያ <char style="nd">ዋቀዮ</char> ህንቱርን።<verse eid="PSA 70:5"/></para>
  <chapter eid="PSA 70"/>
  <chapter number="71" style="c" sid="PSA 71"/>
  <para style="cl">ፋርፈትና 71</para>
  <para style="ms1">ከዸትና ጃርሳ</para>
  <para style="mr">
    <ref loc="PSA 71:1-3">71፥1‑3</ref> ኩወፈ – <char style="xt"><ref loc="PSA 31:1-4">ፋር 31፥1‑4</ref></char></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 71:1"/>ያ <char style="nd">ዋቀዮ</char>፣ አን ኮሉ ስት ገሌረ፤</para>
  <para style="q2" vid="PSA 71:1">አት ጎንኩማ ነ ህንቃኔስን።<verse eid="PSA 71:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 71:2"/>ቀጄሉማኬቲን ነ ባስ፤ ነ ኦልችስ፤</para>
  <para style="q2" vid="PSA 71:2">ጉረኬ ገረኮት ቀብ፤ ነ ፈይስስ።<verse eid="PSA 71:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 71:3"/>አት ከታ አን ኮሉ እት ገሉ፣</para>
  <para style="q2" vid="PSA 71:3">እዶ አን ዬሮ ሁንደ እት በቀዹ ና ተእ፤</para>
  <para style="q1" vid="PSA 71:3">አት ዋን ከታኮፊ ደኦኮ ታቴፍ፣</para>
  <para style="q2" vid="PSA 71:3">ነ በራሩፍ አጀጀ ኬን።<verse eid="PSA 71:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 71:4"/>ያ ዋቀኮ፣ ሀርከ ነመ ሀማ፣</para>
  <para style="q2" vid="PSA 71:4">ቀባ ነመ ጀልኣቲፊ ገረ ጀቤሳ ኬሳ ነ ባስ።<verse eid="PSA 71:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 71:5"/>ያ <char style="nd">ዋቀዮ</char> ጎፍታ፣ አት አብዲኮቲ፤</para>
  <para style="q2" vid="PSA 71:5">እጆሉማኮቲ ካፍቴስ አት ዋቀ አን አመነዹዸ።<verse eid="PSA 71:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 71:6"/>አን ጋፈን ዸለዼ ጀልቀቤ ስት እርከዼረ፤</para>
  <para style="q2" vid="PSA 71:6">ገደሜሰ ሃዸኮ ኬሳስ ስቱ ነ ባሴ።</para>
  <para style="q2" vid="PSA 71:6">አን ዬሮ ሁንደ ስን ገለቴፈዸ።<verse eid="PSA 71:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 71:7"/>አን ነሞተ ባይኤዻፍ መለቶ ተኤረ፤</para>
  <para style="q2" vid="PSA 71:7">አት ገሩ ደኦኮ እሰ ጀባዸ።<verse eid="PSA 71:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 71:8"/>አፋንኮ ጉያ ጉቱ፣</para>
  <para style="q2" vid="PSA 71:8">ገለታፊ ኡልፍነኬቲን ጉተመ።<verse eid="PSA 71:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 71:9"/>ዬሮ አን ዱሎሙት አት ነ ህንገትን፤</para>
  <para style="q2" vid="PSA 71:9">ዬሮ ሁምንኮ ዹሙትስ ነ ህንዺስን።<verse eid="PSA 71:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 71:10"/>ዲኖትንኮ ነት መርአቱቲ፤</para>
  <para style="q2" vid="PSA 71:10">ወር ነ አጄሱፍ ርጰኒ ኤገተንስ ወሊ ወጅን ነት መርአቱ።<verse eid="PSA 71:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 71:11"/>እሳንስ፣ “ዋቅን እሰ ዺሴረ፤</para>
  <para style="q2" vid="PSA 71:11">ነምን እሰ ኦልቹ ቶኮዩ ህንጅሩቲ</para>
  <para style="q2" vid="PSA 71:11">ፋነ ቡኣቲ ቀባ” ጄዹ።<verse eid="PSA 71:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 71:12"/>ያ ዋቅ፣ ነራ ህንፈጋትን፤</para>
  <para style="q2" vid="PSA 71:12">ያ ዋቀኮ፣ ነ ገርጋሩፍ ደፊ ኮቱ።<verse eid="PSA 71:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 71:13"/>ወር ነ ህመተን ቃነአኒ ሃበደን፤</para>
  <para style="q2" vid="PSA 71:13">ወር ነ ሚዹ በርባደንስ</para>
  <para style="q2" vid="PSA 71:13">ቱፊፊ ሰልጵነ ሃኡፈተን።<verse eid="PSA 71:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 71:14"/>አን ገሩ ዬሮ ሁንዱማ አብዲ ቀበ፤</para>
  <para style="q2" vid="PSA 71:14">እቱመ ጫልችሴስ ስን ገለቴፈዸ።<verse eid="PSA 71:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 71:15"/>አን ዮ ሀመም አከ እን ገኡ ቤኩ ባዼሌ፣</para>
  <para style="q2" vid="PSA 71:15">አፋንኮ ዋኤ ቀጄሉማኬቲቲፊ</para>
  <para style="q2" vid="PSA 71:15">ዋኤ ፈይሱኬቲ ጉያ ጉቱ ንኦዴሰ።<verse eid="PSA 71:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 71:16"/>ያ <char style="nd">ዋቀዮ</char> ጎፍታ፣ አን ዹፌ</para>
  <para style="q2" vid="PSA 71:16">ሆጂኬ ሁምነ ቀቤሰ ሰነ ነንኦዴሰ፤</para>
  <para style="q2" vid="PSA 71:16">አን ቀጄሉማኬ ቆፈ ለብሰ።<verse eid="PSA 71:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 71:17"/>ያ ዋቅ፣ አት እጆሉማኮቲ ጀልቀብዴ ነ በርሲፍቴርተ፤</para>
  <para style="q2" vid="PSA 71:17">አንስ ሀመ ሀርኣት ሆጂኬ ድንቅሲሳ ሰነ ነንለብሰ።<verse eid="PSA 71:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 71:18"/>ያ ዋቀዮ፣ ዬሮ አን ዱሎሜ መታንኮ አሪ ተኡትሌ፣</para>
  <para style="q2" vid="PSA 71:18">ሀመ አን ሁምነኬ ዸሎተ ከነት፣</para>
  <para style="q1" vid="PSA 71:18">ጀብነኬስ ዸሎተ ዹፉፍ ጅሩ ሁንደት ለብሱት፣</para>
  <para style="q2" vid="PSA 71:18">አት ነ ህንዺስን።<verse eid="PSA 71:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 71:19"/>ያ ዋቅ፣ ቀጄሉማንኬ ሰሚወን ብረ ገአ፤</para>
  <para style="q2" vid="PSA 71:19">አት ዋን ጉርጉዳ ሆጄቴርተ፤</para>
  <para style="q2" vid="PSA 71:19">ያ ዋቅ፣ ከን አከኬቲ ኤኙ?<verse eid="PSA 71:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 71:20"/>አት ረክናፊ ዽጵነ ባይኤ ነ አርግሲፍቴርተ፤</para>
  <para style="q2" vid="PSA 71:20">ተኡስ ጅሬኘኮ ዴብፍቴ ንሃሮምስተ፣</para>
  <para style="q2" vid="PSA 71:20">ቅሌ ለፋ ኬሳስ ዴብፍቴ ኦል ነ ባፍተ።<verse eid="PSA 71:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 71:21"/>ኡልፍነኮ ንጉድፍተ፤</para>
  <para style="q2" vid="PSA 71:21">አመሌ ነ ጀጀቤስተ።<verse eid="PSA 71:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 71:22"/>ያ ዋቀኮ፣ አን አመነሙማኬቲፍ፣</para>
  <para style="q2" vid="PSA 71:22">ክራራን ስን ፋርፈዸ፤</para>
  <para style="q1" vid="PSA 71:22">ያ ቁልቁልቸ እስራኤል</para>
  <para style="q2" vid="PSA 71:22">አን ክራራን ፋርፈትና ገለታ ሲፍ ፋርፈዸ።<verse eid="PSA 71:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 71:23"/>ዮሙ አን ፋርፈትና ገለታ ሲፍ ፋርፈዹት፣ ህዺንኮ፣</para>
  <para style="q2" vid="PSA 71:23">ሉቡንኮ ከን አት ፉርቴስ ጉድሰኒ ንእልልቹ።<verse eid="PSA 71:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 71:24"/>ወር ነ ሚዹ በርባደን፣</para>
  <para style="q2" vid="PSA 71:24">ዋን ቃነአኒ ቡርጃጀአኒፍ</para>
  <para style="q1" vid="PSA 71:24">አረብንኮ ጉያ ጉቱ</para>
  <para style="q2" vid="PSA 71:24">ቀጄሉማኬ ኦዴሰ።<verse eid="PSA 71:24"/></para>
  <chapter eid="PSA 71"/>
  <chapter number="72" style="c" sid="PSA 72"/>
  <para style="cl">ፋርፈትና 72</para>
  <para style="ms1">ሞትቸ አብዲን ኤገሙ</para>
  <para style="d">ፋርፈትና ሶሎሞን።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 72:1"/>ያ ዋቅ፣ ሙርቲኬ ሞቲዻፍ፣</para>
  <para style="q2" vid="PSA 72:1">ቀጄሉመ ኬሞ እልመ ሞቲቲፍ ኬን።<verse eid="PSA 72:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 72:2"/>እንስ ሰበኬቲፍ ቀጄሉማዻን ሙርቴሰ፤</para>
  <para style="q2" vid="PSA 72:2">ህዬዪፍስ ሙርቲ ቀጄላ ኬነ።<verse eid="PSA 72:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 72:3"/>ቱሉወን በዻዹማ፣</para>
  <para style="q2" vid="PSA 72:3">ጋረንሞ እጀ ቀጄሉማ ሰባፍ ሃፍደን።<verse eid="PSA 72:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 72:4"/>እን ህዬዪ ሰበ ኬሰ ጅራተኒፍ ንፈልመ፤</para>
  <para style="q2" vid="PSA 72:4">እጆሌ ረከቶታ ንኦልቸ፤</para>
  <para style="q2" vid="PSA 72:4">ጩንቁርስቱሞ ንበርበዴሰ።<verse eid="PSA 72:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 72:5"/>ነሞትን ሀመ አዱን ጅራቱፊ ሀመ ጅእ ጅራቱት፣</para>
  <para style="q2" vid="PSA 72:5">ዸሎታ ሀመ ዸሎታት ስ ሶዳቱ።<verse eid="PSA 72:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 72:6"/>እን አኩመ ቦካ መርገ ሃመሜረት ሮቡ፣</para>
  <para style="q2" vid="PSA 72:6">አኩመ ቲፉ ለፈ ጂሱትስ ንዹፈ።<verse eid="PSA 72:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 72:7"/>በረሳ ኬሰ ቀጄሉማን ንደራረ፤</para>
  <para style="q2" vid="PSA 72:7">ነጌኝስ ሀመ ጅእ ዸበሙት ንባይአተ።<verse eid="PSA 72:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 72:8"/>እንስ ገላና ሀመ ገላናት፣</para>
  <para style="q2" vid="PSA 72:8">ለገ ኤፍራጢሲ ሀመ ሞጋ ለፋት ንቡልቸ።<verse eid="PSA 72:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 72:9"/>ወር ገሞጂ ኬሰ ጅራተን ፉለሳ ዱረት ንሰገዱ፤</para>
  <para style="q2" vid="PSA 72:9">ዲኖትንሳስ ብዮ አራቡ።<verse eid="PSA 72:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 72:10"/>ሞቶትን ተርሺሺፊ ሞቶትን</para>
  <para style="q2" vid="PSA 72:10">ብዮተ ቀርቀረወን ገላነ ፈጎ ግብረ እሳፍ ንፍዱ፤</para>
  <para style="q2" vid="PSA 72:10">ሞቶትን ሼባቲፊ ሞቶትን ሳባ ኬና ንፍዱፍ።<verse eid="PSA 72:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 72:11"/>ሞቶትን ሁንድኑስ እሳፍ ንሰገዱ፤</para>
  <para style="q2" vid="PSA 72:11">ሰቦትን ሁንድኑስ እሰ ንተጃጅሉ።<verse eid="PSA 72:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 72:12"/>እን ነመ ረከቴ ገረሳት እዩ፣</para>
  <para style="q2" vid="PSA 72:12">ህዬሳፊ ነመ ገርጋርሰ ህንቀብኔ ንበራራቲ።<verse eid="PSA 72:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 72:13"/>ነመ ደዸባፊ ረከታፍ ገራ ለፈ፤</para>
  <para style="q2" vid="PSA 72:13">ነመ ረከታስ ዱአ ጀላ ባሰ።<verse eid="PSA 72:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 72:14"/>ሉቡሳኒስ ሀጩጫፊ ጩንቁርሳ ጀላ ንፉረ፤</para>
  <para style="q2" vid="PSA 72:14">ዺግንሳኒ ፉለሳ ዱረት ገቲ ጉዳ ቀባቲ።<verse eid="PSA 72:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 72:15"/>ኡሙሪንሳ ሃዼረቱ፤</para>
  <para style="q2" vid="PSA 72:15">ወርቄን ሼባ እሳፍ ሃኬነሙ።</para>
  <para style="q1" vid="PSA 72:15">ዬሮ ሁንደ ዋቀ እሳፍ ሃከዸተን፤</para>
  <para style="q2" vid="PSA 72:15">ጉያ ጉቱስ እሰ ሃኤብሰን።<verse eid="PSA 72:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 72:16"/>ለፈረት ምዻን አከ መሌ ሃባይአቱ፤</para>
  <para style="q2" vid="PSA 72:16">ፊጤ ቱሉወኒረስ አሲፊ አች ሃራፈሙ።</para>
  <para style="q1" vid="PSA 72:16">እጅሳ አከ ልባኖን ሃቶሉ፤</para>
  <para style="q2" vid="PSA 72:16">አከ መርገ ለፋስ ሃምሱ።<verse eid="PSA 72:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 72:17"/>መቃንሳ በረ በራን ሃጅራቱ፤</para>
  <para style="q2" vid="PSA 72:17">አኩመ አዱስ እት ፉፌ ሃጅራቱ።</para>
  <para style="b" vid="PSA 72:17"/>
  <para style="q1" vid="PSA 72:17">ሰቦትን ሁንድኑ እሳን ንኤብፈሙ፤</para>
  <para style="q2" vid="PSA 72:17">ጀርስ ኤብፈማ ጄዻኒ እሰ ዋሙ።<verse eid="PSA 72:17"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 72:18"/>እን ኮጳሳ ዋን ድንቂ ሆጄቱ፣</para>
  <para style="q2" vid="PSA 72:18">
    <char style="nd">ዋቀዮ</char> ዋቅን፣ ዋቅን እስራኤል ሃኤብፈሙ።<verse eid="PSA 72:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 72:19"/>መቃሳ ኡልፋታ ሰናፍ በረ በራን ገለን ሃተኡ፤</para>
  <para style="q2" vid="PSA 72:19">ለፍት ሁንድኑ ኡልፍነሳቲን ሃጉተሙ።</para>
  <para style="qc" vid="PSA 72:19">አሜን፤ አሜን።<verse eid="PSA 72:19"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 72:20"/>ከዸናን ዳዊት እልመ እሴይ አስረት ጡሙረሜ።<verse eid="PSA 72:20"/></para>
  <chapter eid="PSA 72"/>
  <chapter number="73" style="c" sid="PSA 73"/>
  <para style="ms">ክታበ ሰደፋ</para>
  <para style="mr">
    <ref loc="PSA 73-89">ፋርፈትና 73–89</ref></para>
  <para style="cl">ፋርፈትና 73</para>
  <para style="ms1">ሞአትኖ ሙርቲ ቀጄላ</para>
  <para style="d">ፋርፈትና አሳፍ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 73:1"/>ዹጉማን ዋቅን እስራኤሊፍ፣</para>
  <para style="q2" vid="PSA 73:1">ወረ ገራንሳኒ ቁልቁሉ ተኤፍ ጋሪዸ።<verse eid="PSA 73:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 73:2"/>አን ገሩ ሚልኮ ጉፈቹ ገኤ፣</para>
  <para style="q2" vid="PSA 73:2">ፋንኮስ ሙጩጫቹ ገኤ ቱሬ።<verse eid="PSA 73:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 73:3"/>አን ዮሙን በዻዹማ ሀሞታ አርጌት፣</para>
  <para style="q2" vid="PSA 73:3">ኦፍ ቱልቶተት ህናፌን ቱሬቲ።<verse eid="PSA 73:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 73:4"/>እሳን ህንዽጰተን፤</para>
  <para style="q2" vid="PSA 73:4">ዸግንሳኒስ ፈያዸ፤ ጭማ ዸስ።<verse eid="PSA 73:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 73:5"/>ረክን ነመ ብራት ዹፉ እሳንት ህንዹፉ፤</para>
  <para style="q2" vid="PSA 73:5">እሳን አከ ነሞተ ካኒ ዹኩባን ህንዸአመን።<verse eid="PSA 73:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 73:6"/>ከናፉ ኦፍ ቱሉማን ፋየ ሞርመሳኒት፤</para>
  <para style="q2" vid="PSA 73:6">ፍንጭለስ አከ ወያት ኡፈቱ።<verse eid="PSA 73:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 73:7"/>እጅሳኒ ጮሜ አለት ዺበመ፤</para>
  <para style="q2" vid="PSA 73:7">ሀምን እሳን ገራት ያደን ዹመ ህንቀቡ።<verse eid="PSA 73:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 73:8"/>እሳን ንቆሱ፤ ሀምነስ ንዱበቱ፤</para>
  <para style="q2" vid="PSA 73:8">ኦፍ ቱላ ጩንቁርሳዻን ነመ ዶርስሱ።<verse eid="PSA 73:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 73:9"/>አፋንሳኒ ሰሚ ፈልመተ፤</para>
  <para style="q2" vid="PSA 73:9">አረብንሳኒስ ለፈ ዻለ።<verse eid="PSA 73:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 73:10"/>ከናፉ ሰብን ገረሳኒት ደቸኤ</para>
  <para style="q2" vid="PSA 73:10">ብሻን ባይኤ ዹገ።<verse eid="PSA 73:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 73:11"/>እሳንስ፣ “ዋቅን አከምት ቤኩ ደንደኣ?</para>
  <para style="q2" vid="PSA 73:11">ዋቅን ዋን ሁንዳ ኦሊ ቤኩምሰ ቀባ?” ጄዹ።<verse eid="PSA 73:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 73:12"/>ኤጋ ነሞትን ሀሞን አከነ፤</para>
  <para style="q2" vid="PSA 73:12">እሳን ዬሮ ሁንደ ያዶ መሌ ጅራቱ፤</para>
  <para style="q2" vid="PSA 73:12">በዻዹማንስ ጉደቻ ዴሙ።<verse eid="PSA 73:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 73:13"/>ዮስ አን አከሱማን ገራኮ ቁልቁልናን ኤገዼ</para>
  <para style="q2" vid="PSA 73:13">ሀርከኮስ አከሱማን ዽቀዼ ካ!<verse eid="PSA 73:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 73:14"/>አን ጉያ ጉቱ ዸአሜረ፤</para>
  <para style="q2" vid="PSA 73:14">ገነመ ገነመስ አደበሜረ።<verse eid="PSA 73:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 73:15"/>አን ኡቱ፣ “አከነ ነንዱበዸ” ጄዼ ጅራዼ</para>
  <para style="q2" vid="PSA 73:15">ስላ እጆሌኬ ነንየከን ቱሬ።<verse eid="PSA 73:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 73:16"/>ገሩ ዮሙ አን ዋን ከነ ሁንደ ሁበቹ ያሌት፣</para>
  <para style="q2" vid="PSA 73:16">ወን ኩን ሆጂ ደዸብሲሳ ነት ተኤ።<verse eid="PSA 73:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 73:17"/>ኩንስ ሀመ አን እዶ ቁልቁሉማ ዋቃ ሴኑት ቱሬ፤</para>
  <para style="q2" vid="PSA 73:17">ኤርገሲስ አን ገልገለሳኒ ነንሁበዼ።<verse eid="PSA 73:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 73:18"/>ዹጉማን አት እዶ ሙጩጫታረ እሳን ዻብዴ፤</para>
  <para style="q2" vid="PSA 73:18">አከ እሳን ኩፈኒ ጨጨበኒፍስ ገድ እሳን ደርበቴ።<verse eid="PSA 73:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 73:19"/>እሳን አከሚን ጉቱማን ጉቱት ሶዳዻን ፉዸተመኒ</para>
  <para style="q2" vid="PSA 73:19">አኩመ ተሳ በርበዳአን!<verse eid="PSA 73:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 73:20"/>አኩመ አብጁን ዬሮ ነምን ህርባ ደመቁት ተኡ ሰነ፣</para>
  <para style="q2" vid="PSA 73:20">አትስ ያ ጎፍታ፣ አከሱመ ዮሙ ኦል ካቱ፣</para>
  <para style="q2" vid="PSA 73:20">ሀዊ ገራሳኒ ንቡሼስተ።<verse eid="PSA 73:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 73:21"/>ዮሙ ሉቡንኮ ገድቴ</para>
  <para style="q2" vid="PSA 73:21">ኦኔንኮስ ወራነምቴት፣<verse eid="PSA 73:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 73:22"/>አን ጎዋፊ ወላላን ቱሬ፤</para>
  <para style="q2" vid="PSA 73:22">ፉለኬ ዱረትስ አከ ሆሪ ነንተኤ።<verse eid="PSA 73:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 73:23"/>ተኡስ አን ዬሮ ሁንደ ስ ወጅነን ጅረ፤</para>
  <para style="q2" vid="PSA 73:23">አትስ ሀርከኮ ምርጋ ንቀብደ።<verse eid="PSA 73:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 73:24"/>አት ጎርሰኬቲን ነ ቀጄልችተ፤</para>
  <para style="q2" vid="PSA 73:24">ኤርገሲሞ ኡልፍነት ነ ገልችተ።<verse eid="PSA 73:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 73:25"/>አን ሰሚ ኬሳ ኤኙነን ቀበ?</para>
  <para style="q2" vid="PSA 73:25">ለፈራስ ስ መሌ ሆማ ህንፌዹ።<verse eid="PSA 73:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 73:26"/>ፎንኮፊ ኦኔንኮ ደዸቡ ደንደኡ፤</para>
  <para style="q2" vid="PSA 73:26">ዋቅን ገሩ ጀብነ ገራኮት፤</para>
  <para style="q2" vid="PSA 73:26">በረ በራንስ እን ቆደኮ።<verse eid="PSA 73:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 73:27"/>ወር ስራ ፈጎ ጅረን ንበዱ፤</para>
  <para style="q2" vid="PSA 73:27">አትስ ወረ ሲፍ ህንአመነምኔ ሁንደ ንበሌስተ።<verse eid="PSA 73:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 73:28"/>አከ አን ያዱት ገሩ ዋቀት ዽኣቹን ጋሪዸ፤</para>
  <para style="q2" vid="PSA 73:28">
    <char style="nd">ዋቀዮ</char> ጎፍታ ደኦኮ ጎዸዼረ፤</para>
  <para style="q2" vid="PSA 73:28">አን ሆጂኬ ሁንደ ነንለብሰ።<verse eid="PSA 73:28"/></para>
  <chapter eid="PSA 73"/>
  <chapter number="74" style="c" sid="PSA 74"/>
  <para style="cl">ፋርፈትና 74</para>
  <para style="ms1">ቦእቸ ዋኤ ዲገሙ መነ ቁልቁሉማ</para>
  <para style="d">
    <char style="tl">መስኪሊ</char> አሳፍ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 74:1"/>ያ ዋቅ፣ አት ማሊፍ በረ በራን ኑ ገቴ?</para>
  <para style="q2" vid="PSA 74:1">ኣሪንኬ ማሊፍ ሆሎተ አት ቦባፍቴረት አከ መሌ ቦበአ?<verse eid="PSA 74:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 74:2"/>ሰበ አት ዱር ፍለቴ፣</para>
  <para style="q2" vid="PSA 74:2">ጎሰ ዻለኬቲ፣ ወረ አት ፉርቴ፣</para>
  <para style="q2" vid="PSA 74:2">ቱሉ ጥዮን እዶ አት ጅራቴስ ያደዹ።<verse eid="PSA 74:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 74:3"/>ተርካንፊኬ ገረ ዋን በረ በራን ዲገሜት ቀጄልፈዹ፤</para>
  <para style="q2" vid="PSA 74:3">ዲን ዋን መነ ቁልቁሉማ ኬሰ ጅሩ ሁንደ በርበዴሴረ።<verse eid="PSA 74:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 74:4"/>ዲኖትንኬ እዶ ቁልቁሉኬ ኬሰት ቦክሰን፤</para>
  <para style="q2" vid="PSA 74:4">መለቶሳኒስ መለቶ ጎዸኒ ዻበተን።<verse eid="PSA 74:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 74:5"/>እሳን ነመ ቦሶነ ኬሰት ሙከ ሙሩፍ</para>
  <para style="q2" vid="PSA 74:5">ቆቶ ኦል ፉዸቱ ፈካቱ።<verse eid="PSA 74:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 74:6"/>እሳንስ ዋን ሶፈሜ ሁንደ፣</para>
  <para style="q2" vid="PSA 74:6">ቆቶፊ ቡሩሳን ጨጨብሰን።<verse eid="PSA 74:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 74:7"/>እሳን መነ ቁልቁሉማኬ ጉበን፤</para>
  <para style="q2" vid="PSA 74:7">ለፈ ጅሬኘ መቃኬቲስ ንጡሬሰን።<verse eid="PSA 74:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 74:8"/>ገራሳኒ ኬሰት፣ “ኑ ጉቱማን ጉቱት <optbreak/> እሳን በርበዴስነ!” ጄዸን።</para>
  <para style="q2" vid="PSA 74:8">እዶ ዋቅን ብየቲ ኬሰት እት ዋቄፈማ ቱሬ ሁንዱመስ ንጉበን።<verse eid="PSA 74:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 74:9"/>መለቶን ድንቂ ኑ ህንኬነምኔ፤</para>
  <para style="q2" vid="PSA 74:9">ስአች ራጂን ቶኮሌ ህንጅሩ፤</para>
  <para style="q2" vid="PSA 74:9">ወን ኩን ሀመ ዮሚት አከ ቱሩ <optbreak/> ኑ ኬሳ ነምን ቤኩ ህንጅሩ።<verse eid="PSA 74:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 74:10"/>ያ ዋቅ፣ ሀመ ዮሚት ዲን ስት ቆሰ?</para>
  <para style="q2" vid="PSA 74:10">አመጃጂንስ በረ በራን መቃኬ ጡሬሳ?<verse eid="PSA 74:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 74:11"/>አት ማሊፍ ሀርከኬ፣ ሀርከኬ ምርጋ ደቻፈተ?</para>
  <para style="q2" vid="PSA 74:11">ሀርከኬ ቦባ ጀላ ባፈዹቲ እሳን በርበዴስ!<verse eid="PSA 74:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 74:12"/>ያ ዋቅ፣ አት ዱሩማ ጀልቀብዴ ሞቲኮት፤</para>
  <para style="q2" vid="PSA 74:12">ለፈረትስ ሆጂ ፈይና ሆጄተ።<verse eid="PSA 74:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 74:13"/>ስቱ ሁምነኬቲን ገላነ ገርገር ቆዴ፤</para>
  <para style="q2" vid="PSA 74:13">አት ብሻን ኬሰትስ መታ ብኔንሰ ጀዌ ፈካቱ ጨጨብስቴ።<verse eid="PSA 74:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 74:14"/>ስቱ መታ ሌዋታን ጨጨብሴ ኛተ ጎዼ</para>
  <para style="q2" vid="PSA 74:14">ኡመመወን ገሞጂ ጅራተኒፍ ኬኔ።<verse eid="PSA 74:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 74:15"/>ስቱ ቡርቃወኒፊ ብሻን ያኡፍ ከራ በኔ፤</para>
  <para style="q2" vid="PSA 74:15">አት ለገ ዬሮ ሁንደ ያኡሌ ጎግስቴርተ።<verse eid="PSA 74:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 74:16"/>ጉያን ከንኬት፤ ሀልከንስ ኬቱመ፤</para>
  <para style="q2" vid="PSA 74:16">አት አዱፊ ጅአ ኡምቴርተ።<verse eid="PSA 74:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 74:17"/>ስቱ ዳሪ ለፋ ሁንደ ዻቤ፤</para>
  <para style="q2" vid="PSA 74:17">አት ቦናፊ ገነ ኡምቴርተ።<verse eid="PSA 74:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 74:18"/>ያ <char style="nd">ዋቀዮ</char>፣ አከምት አከ ዲን ስት ቆሱ፣</para>
  <para style="q2" vid="PSA 74:18">አከምት አከ ነሞትን ጎዎንስ መቃኬ ጡሬሰን ያደዹ።<verse eid="PSA 74:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 74:19"/>ሉቡ ጉጌኬቲ ደበርስቴ ብኔንሰ ቦሶናት ህንኬንን፤</para>
  <para style="q2" vid="PSA 74:19">ጅሬኘ ሰበኬ ህዮሜ በረ በራን ህንእራንፈትን።<verse eid="PSA 74:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 74:20"/>ከኩኬ ኤግ፤</para>
  <para style="q2" vid="PSA 74:20">እዶን ለፋ ዱከናኣን ሁንድኑ <optbreak/> ጎሊዻን ጉተሜራቲ።<verse eid="PSA 74:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 74:21"/>ወር ጩንቁርፈመን ቃነአኒ ዱበት ህንዴብእን፤</para>
  <para style="q2" vid="PSA 74:21">ህዬዪፊ ረከቶትን መቃኬ ሃገለቴፈተን።<verse eid="PSA 74:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 74:22"/>ያ ዋቅ ከእ፤ ዱቢኬስ ፈልመዹ፤</para>
  <para style="q2" vid="PSA 74:22">አከ ጎዎትን ጉያ ጉቱ ስት ቆሰን ያደዹ።<verse eid="PSA 74:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 74:23"/>ዻደቹ ዲኖተኬቲ፣ ቦክሱ ዲነኬቲ</para>
  <para style="q2" vid="PSA 74:23">ከን ገርገር ህንጭትኔ ሰነ ህንደገትን።<verse eid="PSA 74:23"/></para>
  <chapter eid="PSA 74"/>
  <chapter number="75" style="c" sid="PSA 75"/>
  <para style="cl">ፋርፈትና 75</para>
  <para style="ms1">አባ ሙርቲ አዱኛ ሁንዳ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዬደሎ፣ “ህንበሌስን” ጄዹን ፋርፈተሜ። ፋርፈትና አሳፍ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 75:1"/>ያ ዋቅ፣ ኑ ስ ገለቴፈትነ፤</para>
  <para style="q2" vid="PSA 75:1">ሰበቢ መቃንኬ ዽኦ ተኤፍ ገለተ ሲፍ ገልችነ፤</para>
  <para style="q2" vid="PSA 75:1">ነሞትን ዋኤ ድንቂ ሆጂኬቲ ኦዴሱ።<verse eid="PSA 75:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 75:2"/>አት አከነ ጄተ፤ “አን ዬሮ ሙርቴፈሜ ነንፍለዸ፤</para>
  <para style="q2" vid="PSA 75:2">ከን ቀጄሉማዻን ሙሩ አነ።<verse eid="PSA 75:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 75:3"/>ዮሙ ለፍቲፊ ሰብንሼ ሁንድ ራፈመንት፣</para>
  <para style="q2" vid="PSA 75:3">ከን ኡቱባሼ ጀቤሴ ቀቡ አነ።<verse eid="PSA 75:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 75:4"/>አን ኦፍ ቱልቶታን አከነ ነንጄዸ፤ ‘ኦፍ ህንጀጅና።’</para>
  <para style="q2" vid="PSA 75:4">ሀሞታንስ፣ ‘ጋንፈኬሰን ኦል ህንቀበትና።<verse eid="PSA 75:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 75:5"/>ጋንፈኬሰን ሰሚት ህንካስና፤</para>
  <para style="q2" vid="PSA 75:5">ሞርመኬሰን ዼሬፈተኒ ህንዱበትና።’ ”<verse eid="PSA 75:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 75:6"/>ኡልፍን በአ ቢፍቱቲ ዮካን ልጠ ቢፍቱቲ</para>
  <para style="q2" vid="PSA 75:6">ዮካን ለፈ ኦናቲ ህንዹፉቲ።<verse eid="PSA 75:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 75:7"/>ገሩ ከን ሙርቲ ኬኑ ዋቀ፤</para>
  <para style="q2" vid="PSA 75:7">እን ነመ ቶኮ ገድ ቡሰ፤ ካንሞ ኦል ባሰ።<verse eid="PSA 75:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 75:8"/>ሀርከ <char style="nd">ዋቀዮ</char> ኬሰ፣</para>
  <para style="q2" vid="PSA 75:8">ጦፎ ወይኒ ኡርጎፍቱዻን ወልት መከሜ</para>
  <para style="q2" vid="PSA 75:8">ከን ሆመቻን ጉተሜ ቶኮቱ ጅረ፤</para>
  <para style="q1" vid="PSA 75:8">እን ወይኒ ሰነ ገድ ነቀ፤</para>
  <para style="q2" vid="PSA 75:8">ሀሞን ለፋ ሁንድኑ ኡቱ ሲጮሳሌ ህንሀምብስን <optbreak/> ጡሩርፈተኒ ዹጉ።<verse eid="PSA 75:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 75:9"/>አን ገሩ በረ በራን ዋን ከነ ነንለብሰ፤</para>
  <para style="q2" vid="PSA 75:9">ዋቀ ያቆብስ ነንፋርፈዸ።<verse eid="PSA 75:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 75:10"/>ጋንፈ ሀሞተ ሁንዳ ነንጨጨብሰ፤</para>
  <para style="q2" vid="PSA 75:10">ጋንፍ ቀጄልቶታ ገሩ ኦል ኦል ጄዸ።<verse eid="PSA 75:10"/></para>
  <chapter eid="PSA 75"/>
  <chapter number="76" style="c" sid="PSA 76"/>
  <para style="cl">ፋርፈትና 76</para>
  <para style="ms1">ፋርፈትና ዋቀ ሶዳተሙ ቀቡፍ ፋርፈተሜ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ምአ ርቡቲን። ፋርፈትና አሳፍ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 76:1"/>ይሁዳ ኬሰት ዋቅን ቤከማዸ፤</para>
  <para style="q2" vid="PSA 76:1">መቃንሳስ እስራኤል ኬሰት ጉዳዸ።<verse eid="PSA 76:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 76:2"/>ዱንካንሳ ሳሌም ኬሰ፣</para>
  <para style="q2" vid="PSA 76:2">እዶን ጅሬኘሳ ጥዮን ኬሰ ጅረ።<verse eid="PSA 76:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 76:3"/>እንስ አችት ጥየ ቦበኡፊ ጋቸነ፣ ጎራዴፊ</para>
  <para style="q2" vid="PSA 76:3">ሜሻወን ወራና ጨጨብሴ።<verse eid="PSA 76:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 76:4"/>አት እፈ ኡፈቴ ሚዸግዴርተ፤</para>
  <para style="q2" vid="PSA 76:4">አት ቱሉወን በረ በራ ጫላ ሱረ ቀቤሰ።<verse eid="PSA 76:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 76:5"/>ጎቶትን ቦጅአመኒሩ፤</para>
  <para style="q2" vid="PSA 76:5">ህርባንስ ፉዸተመኒሩ፤</para>
  <para style="q1" vid="PSA 76:5">ዱልቶተ ኬሳስ ነምን ቶኮዩ</para>
  <para style="q2" vid="PSA 76:5">ሀርከ ሶቾፈቹ ህንደንዴኜ።<verse eid="PSA 76:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 76:6"/>ያ ዋቀ ያቆብ፣ እፈትናኬቲን ፈርዴኒ</para>
  <para style="q2" vid="PSA 76:6">ፍ ወር ፈርዴን ያበተን ኦፍ ወላለኒሩ።<verse eid="PSA 76:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 76:7"/>ስእ ቆፈቱ ሶዳተሙ ቀበ።</para>
  <para style="q2" vid="PSA 76:7">ዮሙ አት ኣርቱ ኤኙቱ ፉለኬ ዱረ ዻበቹ ደንደኣ?<verse eid="PSA 76:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 76:8"/>አት ሰሚራ ሙርቲ ኬንቴ፤</para>
  <para style="q2" vid="PSA 76:8">ለፍትስ ንሶዳቴ፤ ንጨልእፍቴስ፤<verse eid="PSA 76:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 76:9"/>ያ ዋቅ፣ ወን ኩንስ ዮሙ አት ሙርቲ ኬኑዻፍ፣</para>
  <para style="q2" vid="PSA 76:9">ረከቶተ ብየቲ ፈይሱፍ ካቴት ተኤ።<verse eid="PSA 76:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 76:10"/>ዼከምስ አት ነመት ዼከምቱ ዹጉማን ኡልፍነ ሲፍ ፍደ፤</para>
  <para style="q2" vid="PSA 76:10">ወረ ዼከምሰኬራ ሀፈንስ ንህዸተ።<verse eid="PSA 76:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 76:11"/>
    <char style="nd">ዋቀዮ</char> ዋቀኬሰኒፍ ወሬጋ፤ ወሬግቸስ ጉተዻ፤</para>
  <para style="q2" vid="PSA 76:11">ወር ናኖሳ ጅራተን ሁንድኑስ</para>
  <para style="q2" vid="PSA 76:11">ዋቀ ሶዳተሙ ቀቡ ሰናፍ ኬናወን ሃፍደን።<verse eid="PSA 76:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 76:12"/>እን ሀፉረ ቡልችቶታ ንጨብሰ፤</para>
  <para style="q2" vid="PSA 76:12">ሞቶትን ለፋስ እሰ ሶዳቱ።<verse eid="PSA 76:12"/></para>
  <chapter eid="PSA 76"/>
  <chapter number="77" style="c" sid="PSA 77"/>
  <para style="cl">ፋርፈትና 77</para>
  <para style="ms1">ሴና እስራኤል ያዱ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ዬዱቱኒፍ። ፋርፈትና አሳፍ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 77:1"/>አን ገርጋርሳፍ ገረ ዋቃት ነንእየዼ፤</para>
  <para style="q2" vid="PSA 77:1">አን አከ ዋቅን ነ ዸገኡፍ ነንእየዼ።<verse eid="PSA 77:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 77:2"/>ዬሮ ረክነኮቲት ጎፍታ ነንበርባደዼ፤</para>
  <para style="q2" vid="PSA 77:2">ሀልከንስ ኡቱ ህንደዸብን ሀርከኮ ነንድሪርፈዼ፤</para>
  <para style="q2" vid="PSA 77:2">ሉቡንኮስ ጀጀባቹ ድዴ።<verse eid="PSA 77:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 77:3"/>ያ ዋቅ፣ አን ዮሙን ስ ያደዹ ነንኣደ፤</para>
  <para style="q2" vid="PSA 77:3">አን እረ ዴዴብኤ ነንያዴ፤ ሀፉርኮስ ንላፌ።<verse eid="PSA 77:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 77:4"/>አት አከ እጅኮ ህንዱኑንፈትኔ ጎቴ፤</para>
  <para style="q2" vid="PSA 77:4">አን አከ መሌ ሉበሜ ዱበቹዩ ደዸቤ።<verse eid="PSA 77:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 77:5"/>አን ዋኤ በረ ዱሪ፣</para>
  <para style="q2" vid="PSA 77:5">ዋኤ ወጎተ ዱሪ ዱሪስ ነንያዴ፤<verse eid="PSA 77:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 77:6"/>አን ሀልከኒን ፋርፈትናኮ ነንያደዼ።</para>
  <para style="q2" vid="PSA 77:6">አን እረ ዴዴብኤ ነንያዴ፤ <optbreak/> ሀፉርኮስ አከነ ጄዼ ቆረቴ፦<verse eid="PSA 77:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 77:7"/>“ጎፍታን በረ በራን ነመ ገታ?</para>
  <para style="q2" vid="PSA 77:7">እን ዴብኤ ገራ ህንላፉ?<verse eid="PSA 77:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 77:8"/>አራርሳ በረ በራን በዴ?</para>
  <para style="q2" vid="PSA 77:8">ዋዳንሳ በረ በራን ጉተሙ ዸቤ?<verse eid="PSA 77:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 77:9"/>ዋቅን አርጆሙ እራንፈቴራ?</para>
  <para style="q2" vid="PSA 77:9">እን ኣሪዻን ገረ ላፍነሳ ዺሴራ?”<verse eid="PSA 77:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 77:10"/>አንስ፣ “ሀርክ ምርጋ ከን ዋቀ ዋን ሁንዳ ኦሊ</para>
  <para style="q2" vid="PSA 77:10">ጅጂረሜረ ጄዼ ያዱንኮ፣ ደዸቢኮት” ነንጄዼ።<verse eid="PSA 77:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 77:11"/>አን ሆጂ <char style="nd">ዋቀዮ</char> ነንያደዸ፤</para>
  <para style="q2" vid="PSA 77:11">ዹጉማን ድንቂኬ ከን ዱሪ ነንያደዸ።<verse eid="PSA 77:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 77:12"/>አን ዋን አት ሆጄቴ ሁንደረ ዴዴብኤ ነንያደ፤</para>
  <para style="q2" vid="PSA 77:12">ዋኤ ሆጂኬቲሌ ነንዱበዸ።<verse eid="PSA 77:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 77:13"/>ያ ዋቅ፣ ከራንኬ ቁልቁሉዸ።</para>
  <para style="q2" vid="PSA 77:13">ዋቅን ጉዳን አከ ዋቀኬኛ ኤሰ ጅረ?<verse eid="PSA 77:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 77:14"/>አት ዋቀ ሆጂ ድንቂ ሆጄቱዸ፤</para>
  <para style="q2" vid="PSA 77:14">ሰቦተ ግዱትስ ሁምነኬ ንአርግሲፍተ።<verse eid="PSA 77:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 77:15"/>እሬኬ ጭማዻን ሰበኬ፣</para>
  <para style="q2" vid="PSA 77:15">ሰኚ ያቆቢፊ ሰኚ ዮሴፍ ፉርቴርተ።<verse eid="PSA 77:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 77:16"/>ያ ዋቅ፣ ብሻኖትን ስ አርገን፤</para>
  <para style="q2" vid="PSA 77:16">ብሻኖትን ስ አርገኒ ሶዳተን፤</para>
  <para style="q2" vid="PSA 77:16">ቱጁበወን ንሆለተን።<verse eid="PSA 77:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 77:17"/>ዱሜስ ብሻን ገድ ዸንገላሴ፤</para>
  <para style="q2" vid="PSA 77:17">ሰሚወን ንቀቀዌሰአን፤</para>
  <para style="q2" vid="PSA 77:17">ጥይኬስ ቅጠ ሁንዳን በለቅሴ።<verse eid="PSA 77:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 77:18"/>በከካንኬ ቡቤ ሀማ ኬሳ ዸገአሜ፤</para>
  <para style="q2" vid="PSA 77:18">በለቄስኬ አዱኛ እብሴ፤</para>
  <para style="q2" vid="PSA 77:18">ለፍትስ ሆለቴ ሶቾቴ።<verse eid="PSA 77:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 77:19"/>ዳንዲንኬ ገላነ ኬሰ፣</para>
  <para style="q2" vid="PSA 77:19">ከራን ኬሞ ብሻኖተ ጉርጉዳ ኬሰ በአ፤</para>
  <para style="q2" vid="PSA 77:19">ገሩ ፋንኬ ህንአርገምኔ።<verse eid="PSA 77:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 77:20"/>አት ሀርከ ሙሴቲፊ ሀርከ አሮኒን፣</para>
  <para style="q2" vid="PSA 77:20">ሰበኬ አከ ቡሻዬት ጌጌስቴ።<verse eid="PSA 77:20"/></para>
  <chapter eid="PSA 77"/>
  <chapter number="78" style="c" sid="PSA 78"/>
  <para style="cl">ፋርፈትና 78</para>
  <para style="ms1">ሴና ሰበ እስራኤል</para>
  <para style="d">
    <char style="tl">መስኪሊ</char> አሳፍ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 78:1"/>ያ ሰበኮ፣ በርሲሰኮ ዸገኣ፤</para>
  <para style="q2" vid="PSA 78:1">ዱቢ አፋንኮ ዸጌፈዻ።<verse eid="PSA 78:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 78:2"/>አን ፈኬኛን አፋንኮ ነንበነዸ፤</para>
  <para style="q2" vid="PSA 78:2">ዋን ዱሩማ ጀልቀቤ ዾክፈሜስ ነንዱበዸ።<verse eid="PSA 78:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 78:3"/>ኩንስ ዋኑመ ኑ ዸጌኜፊ ዋኑመ ኑ ቤክኑ፣</para>
  <para style="q2" vid="PSA 78:3">ዋን አቦቲንኬኘ ኑት ህመኒዸ።<verse eid="PSA 78:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 78:4"/>ኑስ ዋን ከነ እጆሌሳኒ ዱራ ህንዾክስኑ፤</para>
  <para style="q2" vid="PSA 78:4">ሆጂ <char style="nd">ዋቀዮ</char> ኡልፍነ ቀቤሰ ሰነ፣</para>
  <para style="q1" vid="PSA 78:4">ሁምነሳቲፊ ድንቂ እን ሆጄቴ፣</para>
  <para style="q2" vid="PSA 78:4">ዸሎተ እት ኣኑት ንህምነ።<verse eid="PSA 78:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 78:5"/>እን ያቆቢፍ ስርነ ዻቤ፤</para>
  <para style="q2" vid="PSA 78:5">እስራኤሊፍሞ ሴረ ኬኔ፤</para>
  <para style="q1" vid="PSA 78:5">ዋን ከነሌ አከ እሳን <optbreak/> እጆሌሳኒ በርሲሰኒፍ፣</para>
  <para style="q2" vid="PSA 78:5">አቦቲኬኘ አጀጄ፤<verse eid="PSA 78:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 78:6"/>ኩንስ አከ ዸሎትን እት ኣኑ ቤኩ፣</para>
  <para style="q2" vid="PSA 78:6">አከ እጆሌን አመዩ ህንዸለትን ቤከን፣</para>
  <para style="q2" vid="PSA 78:6">እሳንስ አከ እጆሌሳኒት ደበርሰኒ ህመኒፍ።<verse eid="PSA 78:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 78:7"/>ዮስ እሳን ዋቀ አመነቱ፤</para>
  <para style="q2" vid="PSA 78:7">አጀጀሳስ ንኤጉ መሌ ሆጂሳ ህንእራንፈተን።<verse eid="PSA 78:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 78:8"/>እሳን አከ አቦቲሳኒ፣</para>
  <para style="q2" vid="PSA 78:8">አከ ዸሎተ መተ ጀቤሳፊ ፍንጭላ፣</para>
  <para style="q1" vid="PSA 78:8">ወረ ገራንሳኒ ዋቃፍ ህንአጀጀምኔ፣</para>
  <para style="q2" vid="PSA 78:8">አከ ወረ ሀፉርሳኒ እሳፍ ህንአመነምን ሰና ህንተአን።<verse eid="PSA 78:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 78:9"/>ነሞትን ኤፍሬም ጥየ ቀበተኒ ቱረን፤</para>
  <para style="q2" vid="PSA 78:9">ተኡስ ጋፈ ሎላ ዱበት ዴብአን።<verse eid="PSA 78:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 78:10"/>እሳን ከኩ ዋቃ ህንኤግኔ፤</para>
  <para style="q2" vid="PSA 78:10">ሴረ እሳትስ ቡሉ ድደን።<verse eid="PSA 78:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 78:11"/>እሳን ሆጂ እን ሆጄቴ፣</para>
  <para style="q2" vid="PSA 78:11">ድንቂ እን እሳንት አርግሲሴስ ንእራንፈተን።<verse eid="PSA 78:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 78:12"/>እን ፉለ አቦቲሳኒ ዱረት፣</para>
  <para style="q2" vid="PSA 78:12">ብየ ግብጥ ኩታ ዞኣንት ዋን ነመ ድንቅሲሱ ሆጄቴ።<verse eid="PSA 78:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 78:13"/>እን ገላነ ገርገር ቆዴ ግዱን እሳን ደበርሴ፤</para>
  <para style="q2" vid="PSA 78:13">ብሻን ሰነስ አኩመ ኬኘን መና ዻበቺሴ።<verse eid="PSA 78:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 78:14"/>ጉያ ዱሜሳን፣ ሀልከን ጉቱሞ</para>
  <para style="q2" vid="PSA 78:14">እፈ እብዳቲን እሳን ጌጌሴ።<verse eid="PSA 78:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 78:15"/>እን ገሞጂ ኬሰት ከታ ደያሴ</para>
  <para style="q2" vid="PSA 78:15">ብሻን አከ ገላና ባይአቱ እሳኒ ኬኔ።<verse eid="PSA 78:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 78:16"/>ከታ ኬሳ ቡርቃ ቡርቅሲሴ</para>
  <para style="q2" vid="PSA 78:16">አከ ብሻን አኩመ ለጋት ያኡ ጎዼ።<verse eid="PSA 78:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 78:17"/>እሳን ገሩ ገሞጂ ኬሰት ዋቀ ዋን ሁንዳ ኦሊት ፍንጭለን፤</para>
  <para style="q2" vid="PSA 78:17">እቱመ ፉፈኒስ እሰት ጩቡ ሆጄተን።<verse eid="PSA 78:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 78:18"/>እሳን ኛተ ዸረአኒ፣ “ፍድ” ጄቹዻን</para>
  <para style="q2" vid="PSA 78:18">ቤኩምሰ ዋቃ ቆረን።<verse eid="PSA 78:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 78:19"/>አከነ ጄዸኒ ዋቀ ሀመተን፤</para>
  <para style="q2" vid="PSA 78:19">“ዋቅን ገሞጂ ኬሰት ማዲ ቆጴሱ ደንደኣ?<verse eid="PSA 78:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 78:20"/>እን ከታ ሩኩናን ብሻን ሁምናን ኬሳ ቡርቄ፤</para>
  <para style="q2" vid="PSA 78:20">ቡርቃን ጉቴ እራን ዸንገለኤ።</para>
  <para style="q1" vid="PSA 78:20">ገሩ እን ኛተ ኑ ኬኑ ደንደኣ?</para>
  <para style="q2" vid="PSA 78:20">ሰበሳቲፍስ ፎን ኬኑ ደንደኣ?”<verse eid="PSA 78:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 78:21"/>
    <char style="nd">ዋቀዮ</char> ዮሙ ዋን ከነ ዸገኤት ባይኤ ኣሬ፤</para>
  <para style="q2" vid="PSA 78:21">ያቆብረት እብድሳ ንቀብሲፈሜ፤</para>
  <para style="q2" vid="PSA 78:21">ዼከምስሳስ እስራኤልት ዹፌ፤<verse eid="PSA 78:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 78:22"/>እሳን ዋቀ ህንአመነኔቲ፤</para>
  <para style="q2" vid="PSA 78:22">ፈይሱ እሳትስ ህንአመኔ።<verse eid="PSA 78:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 78:23"/>እን ገሩ ሰሚ ጉባቲፍ አጀጀ ኬኔ፤</para>
  <para style="q2" vid="PSA 78:23">በልበለ ሰሚስ ንበኔ፤<verse eid="PSA 78:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 78:24"/>አከ እሳን ኛተኒፍ መና ገድ ሮብሴፍ፤</para>
  <para style="q2" vid="PSA 78:24">ምዻን ሰሚስ እሳኒፍ ኬኔ።<verse eid="PSA 78:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 78:25"/>ነሞትን ቡዴነ ኤርገሞተ ዋቀዮ ኛተን፤</para>
  <para style="q2" vid="PSA 78:25">እን ዋን እሳን ኛተኒ ቁፈን ኤርጌፍ።<verse eid="PSA 78:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 78:26"/>እን አከ ቡቤን በአ ቢፍቱ ሰሚ ኬሳ ቡብሱ ጎዼ፤</para>
  <para style="q2" vid="PSA 78:26">ቡቤ ክባስ ሁምነ ኦፊሳቲን ኦፌ።<verse eid="PSA 78:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 78:27"/>ፎን አኩመ አዋራት፣ ስምብሮተ በርሰንስ</para>
  <para style="q2" vid="PSA 78:27">አኩመ ጭረቸ ገላናት ገድ እሳኒፍ ሮብሴ።<verse eid="PSA 78:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 78:28"/>እንስ አከ እሳን ቁበተሳኒ ኬሰት</para>
  <para style="q2" vid="PSA 78:28">ናኖ ዱንካኖተሳኒት ገድ ሀርጨአን ጎዼ።<verse eid="PSA 78:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 78:29"/>እሳንስ ኛተኒ ቁፈን፤</para>
  <para style="q2" vid="PSA 78:29">እን ዋን እሳን ዸረአን እሳኒፍ ኬኔራቲ።<verse eid="PSA 78:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 78:30"/>ገሩ ኡቱ እሳን ኛተ ዸረአን ሰነ ህንቁፍን፣</para>
  <para style="q2" vid="PSA 78:30">ኡቱመ ኛትን ሱን አፋንሳኒ ኬሰ ጅሩ፣<verse eid="PSA 78:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 78:31"/>ዼከምስ ዋቃ እሳንት ዹፌ፤</para>
  <para style="q2" vid="PSA 78:31">እንስ እሳን ኬሳ ወረ ጀጀቤዪ ገላፈቴ፤</para>
  <para style="q2" vid="PSA 78:31">ደርገጌዪ እስራኤልስ ንፍጤ።<verse eid="PSA 78:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 78:32"/>እሳን ዋን ከነ ሁንደረ ደርበኒ ጩቡ ሆጄቹት ፉፈን፤</para>
  <para style="q2" vid="PSA 78:32">ድንቂ እሳትስ ህንአመኔ።<verse eid="PSA 78:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 78:33"/>ከናፉ እን አከ በርሳኒ ፋይዳ መሌ ደርቡ፣</para>
  <para style="q2" vid="PSA 78:33">አከ ወጎትንሳኒስ ሶዳዻን ዹመን ጎዼ።<verse eid="PSA 78:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 78:34"/>ዬሮ ዋቅን እሳን አጄሴ ከምትዩ፣ <optbreak/> እሳን እሰ በርባደተን፤</para>
  <para style="q2" vid="PSA 78:34">እሳን አመስ ፌዺዻን ገረሳት ዴብአን።<verse eid="PSA 78:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 78:35"/>አከ ዋቅን ከታሳኒ ተኤ፣</para>
  <para style="q2" vid="PSA 78:35">አከ ዋቅን ዋን ሁንዳ ኦሊ ፉሪሳኒ ተኤ ያደተን።<verse eid="PSA 78:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 78:36"/>እሳን ገሩ አፋንሳኒቲን እሰ ሳደን፤</para>
  <para style="q2" vid="PSA 78:36">አረበሳኒቲንስ እሰ ሶበን፤<verse eid="PSA 78:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 78:37"/>ገራንሳኒ እሳፍ አመነማ ህንቱሬ፤</para>
  <para style="q2" vid="PSA 78:37">እሳን ከኩሳቲፍ ህንአመነምኔ።<verse eid="PSA 78:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 78:38"/>እን ገሩ አራረ ቀቤሰ ዋን ተኤፍ፣</para>
  <para style="q2" vid="PSA 78:38">ጩቡሳኒ ንዺሴፍ መሌ እሳን ህንፍጥኔ።</para>
  <para style="q1" vid="PSA 78:38">እን ዬሮ ዬሮት ኣሪሳ እትፈቴ፤</para>
  <para style="q2" vid="PSA 78:38">ዼከምሰሳ ሁንዳስ ህንከካፍኔ።<verse eid="PSA 78:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 78:39"/>እንስ አከ እሳን ነመ ዱአ ህንኦሌ፣</para>
  <para style="q2" vid="PSA 78:39">ቅሌንሱመ ደርቡ ከን ዴብኤ ህንዹፍኔ ተአን ያደቴ።<verse eid="PSA 78:39"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 78:40"/>እሳን ሀመም ገሞጂ ኬሰት እሰት ፍንጭለኒ</para>
  <para style="q2" vid="PSA 78:40">ገሞጂ ኬሰትስ እሰ ገድሲሰን<verse eid="PSA 78:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 78:41"/>እሳን አሙማ አመ ዋቀ ቆረን፤</para>
  <para style="q2" vid="PSA 78:41">ቁልቁልቸ እስራኤል ሰነስ ንኣርሰን።<verse eid="PSA 78:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 78:42"/>እሳን ሁምነሳ ዮካን ጉያ እን እት</para>
  <para style="q2" vid="PSA 78:42">ዲኖተሳኒ ጀላ እሳን ባሴ ህንያደትኔ።<verse eid="PSA 78:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 78:43"/>ጉያ እን እት ብየ ግብጥ ኬሰት መለቶሳ፣</para>
  <para style="q2" vid="PSA 78:43">ኩታ ዞኣን ኬሰትሞ ድንቂሳ አርግሲሴ እሳን ህንያደትኔ።<verse eid="PSA 78:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 78:44"/>እን ለጌንሳኒ ዺገት ጌደሬ፤</para>
  <para style="q2" vid="PSA 78:44">እሳንስ ቡርቃወንሳኒ ዹጉ ህንደንዴኜ።<verse eid="PSA 78:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 78:45"/>እንስ ቱተ ትሲሳ ከን እሳን በሌሱ፣</para>
  <para style="q2" vid="PSA 78:45">ፈቴ እሳን በርበዴሱ እት ኤርጌ።<verse eid="PSA 78:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 78:46"/>ምዻንሳኒ እልማን ሀዋንሳቲፍ፣</para>
  <para style="q2" vid="PSA 78:46">ቡኣ ደዸቢሳኒሞ ሀዋንሳፍ ኬኔ።<verse eid="PSA 78:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 78:47"/>ሙከ ወይኒሳኒ ጨቢዻን፣</para>
  <para style="q2" vid="PSA 78:47">ሀርቡሳኒሞ ዻሞቸ ሀማን ዸኤ።<verse eid="PSA 78:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 78:48"/>ሎንሳኒ ጨቢፍ፣</para>
  <para style="q2" vid="PSA 78:48">ሆሪሳኒሞ በከካፍ ደበርሴ ኬኔ።<verse eid="PSA 78:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 78:49"/>እን ኤርገሞተ በዲሰ ፍደን እሳንት ኤርጉዻን</para>
  <para style="q2" vid="PSA 78:49">ኣሪሳ ሶዳችሳ፣ ዼከምሰሳ፣</para>
  <para style="q2" vid="PSA 78:49">ደለንሱሳቲፊ ረኮ እሳንት ገድ ለክሴ።<verse eid="PSA 78:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 78:50"/>እን ኣሪሳቲፍ ዳንዲ ቆጴሴ፤</para>
  <para style="q2" vid="PSA 78:50">ሉቡሳኒ ደበርሴ ዸእቸት ኬኔ መሌ</para>
  <para style="q2" vid="PSA 78:50">ዱአ እሳን ህንኦልችኔ።<verse eid="PSA 78:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 78:51"/>ሀንገፎተ ግብጥ ሁንደ፣</para>
  <para style="q2" vid="PSA 78:51">እልማን ጀልቀበት ዸለተንስ ዱንካነ ሃም ኬሰት ዸኤ።<verse eid="PSA 78:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 78:52"/>ሰበሳ ገሩ አኩመ ነመ ቡሻዬ ቦባሱት አቺ ባሴ፤</para>
  <para style="q2" vid="PSA 78:52">አኩመ ሆላስ ገሞጂ ኬሰ እሳን ጌጌሴ።<verse eid="PSA 78:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 78:53"/>እን ነጋዻን እሳን ጌጌሴ፤ <optbreak/> ከናፉ እሳን ሆማ ህንሶዳትኔ፤</para>
  <para style="q2" vid="PSA 78:53">ዲኖተሳኒ ገሩ ገላነቱ ልቅምሴ።<verse eid="PSA 78:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 78:54"/>እንስ ገረ ዳሪ ብየሳ ቁልቁሉት፣</para>
  <para style="q2" vid="PSA 78:54">ገረ ብየ ጋራ ከን ሀርክሳ ምርጋ ፉዸቴት እሳን ገልቼ።<verse eid="PSA 78:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 78:55"/>እን ኦርሞተ እሳን ዱራ አርኤ፤</para>
  <para style="q2" vid="PSA 78:55">ለፈ ጀራስ ዻለ ጎዼ እሳኒ ቆዴ፤</para>
  <para style="q2" vid="PSA 78:55">ጎሰ እስራኤልስ ዱንካነሳኒ ኬሰ ቁበቺሴ።<verse eid="PSA 78:55"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 78:56"/>እሳን ገሩ ዋቀ ቆረን፤</para>
  <para style="q2" vid="PSA 78:56">ዋቀ ዋን ሁንዳ ኦሊት ፍንጭለን፤</para>
  <para style="q2" vid="PSA 78:56">አጀጀሳስ ህንኤግኔ።<verse eid="PSA 78:56"/></para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 78:57"/>አኩመ አቦቲሳኒ ዱበት ዴብአን፤ አመነሙስ ንድደን፤</para>
  <para style="q2" vid="PSA 78:57">አከ እዳ ምጪረማትስ ጀጀልአተን።<verse eid="PSA 78:57"/></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 78:58"/>እሳን እዶወን ሰገዳሳኒ ከኔን ጋረን እራቲን እሰ ኣርሰን፤</para>
  <para style="q2" vid="PSA 78:58">ዋቆተሳኒ ቶልፈሞዻንስ ህናፋዻፍ እሰ ከካሰን።<verse eid="PSA 78:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 78:59"/>ዋቅንስ ዬሮ እሳን ዸገኤት አከ መሌ ዼከሜ፤</para>
  <para style="q2" vid="PSA 78:59">ጉቱማን ጉቱትስ እስራኤልን ገቴ።<verse eid="PSA 78:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 78:60"/>እንስ እዶ ጅሬኘሳ ከን ሺሎ ኬሳ፣</para>
  <para style="q2" vid="PSA 78:60">ዱንካነ እን ነሞተ ግዱ ዻበቴ ሰነስ ንዺሴ።<verse eid="PSA 78:60"/></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 78:61"/>ሁምነሳ ቦጁት፣</para>
  <para style="q2" vid="PSA 78:61">ኡልፍነሳሞ ሀርከ ዲናት ደበርሴ ኬኔ።<verse eid="PSA 78:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 78:62"/>ሰበሳ ደበርሴ ጎራዴፍ ኬኔ፤</para>
  <para style="q2" vid="PSA 78:62">ሀንዹራ እሳትስ አከ መሌ ዼከሜ።<verse eid="PSA 78:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 78:63"/>ደርገጎተሳኒ እብደቱ ፍጤ፤</para>
  <para style="q2" vid="PSA 78:63">ዱርቦተሳኒቲፍስ ስርብ ሄሩማ ህንስርበምኔ፤<verse eid="PSA 78:63"/></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 78:64"/>ሉቦትንሳኒ ጎራዴዻን ዹመን፤</para>
  <para style="q2" vid="PSA 78:64">ኒቶትን ዽርሶትንራ ዱአንሞ ቦኡ ህንደንዴኜ።<verse eid="PSA 78:64"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 78:65"/>ጎፍታንስ አኩመ ዋን ህርባ ደመቁት፣</para>
  <para style="q2" vid="PSA 78:65">አኩመ ጎተ ሰበቢ ወይኒቲን እዩትስ ደመቄ።<verse eid="PSA 78:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 78:66"/>እን ዲኖተሳ ሩኩቴ ዱበት ዴብሴ፤</para>
  <para style="q2" vid="PSA 78:66">ቃኒ በረ በራ ኬሰስ እሳን ቡሴ።<verse eid="PSA 78:66"/></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 78:67"/>ዱንካኖተ ዮሴፍ ንቱፈቴ፤</para>
  <para style="q2" vid="PSA 78:67">ጎሰ ኤፍሬምስ ህንፍለትኔ፤<verse eid="PSA 78:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 78:68"/>እን ገሩ ጎሰ ይሁዳ፣</para>
  <para style="q2" vid="PSA 78:68">ቱሉ ጥዮን ከን ጃለቱ ሰነ ንፍለቴ።<verse eid="PSA 78:68"/></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 78:69"/>መነ ቁልቁሉማሳ አከ ሰሚ ኦል ዼራት፣</para>
  <para style="q2" vid="PSA 78:69">አከ ለፈ በረ በራን ሁንዴሴትስ እጃሬ።<verse eid="PSA 78:69"/></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 78:70"/>እን ዳዊት ገርብቸሳ ንፍለቴ፤</para>
  <para style="q2" vid="PSA 78:70">ደላ ሆሎታ ኬሳስ እሰ ዋመቴ፤<verse eid="PSA 78:70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 78:71"/>አከ እን ሰበሳ ያቆብን፣</para>
  <para style="q2" vid="PSA 78:71">ሀንዹራሳ እስራኤልን ትክሱፍ ጄዼ</para>
  <para style="q2" vid="PSA 78:71">ሆሎተ ትክሱራ እሰ ፍዴ።<verse eid="PSA 78:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 78:72"/>ዳዊትስ ገራ ቀጄላዻን እሳን ትክሴ፤</para>
  <para style="q2" vid="PSA 78:72">ኦጉማ ሀርከ እሳቲንስ እሳን ዱረ ቡኤ።<verse eid="PSA 78:72"/></para>
  <chapter eid="PSA 78"/>
  <chapter number="79" style="c" sid="PSA 79"/>
  <para style="cl">ፋርፈትና 79</para>
  <para style="ms1">ፋሩ ቦእቻ ብዮሌሳ</para>
  <para style="d">ፋርፈትና አሳፍ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 79:1"/>ያ ዋቅ፣ ነሞትን ኦርማ ሀንዹራኬ ቀበተኒሩ፤</para>
  <para style="q2" vid="PSA 79:1">መነ ቁልቁሉማኬ ቁልቁልቸ ጡሬሰኒሩ፤</para>
  <para style="q2" vid="PSA 79:1">ዬሩሳሌምንስ በርበዴሰኒሩ።<verse eid="PSA 79:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 79:2"/>አከ እሳን ኛተ እሳኒፍ ተአኒፍ፣</para>
  <para style="q2" vid="PSA 79:2">ሬፈ ገርቦተኬቲ አላቲ ሰሚቲፍ፣</para>
  <para style="q2" vid="PSA 79:2">ፎን ቁልቁሎተኬቲሞ ብኔንሶተ ለፋቲፍ ኬነኒሩ።<verse eid="PSA 79:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 79:3"/>ዺገሳኒስ ናኖ ዬሩሳሌምት</para>
  <para style="q2" vid="PSA 79:3">አኩመ ብሻኒ ዸንገላሰን፤</para>
  <para style="q2" vid="PSA 79:3">ነምን እሳን አዋሉ ቶኮሌ ህንአርገምኔ።<verse eid="PSA 79:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 79:4"/>ኦላኬኘ ብረት መቃን ኑ በዴረ፤</para>
  <para style="q2" vid="PSA 79:4">ወረ ናኖኬኘ ጅረን ብረትስ ነመ ቱፊፊ ኮልፋ ታኔ።<verse eid="PSA 79:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 79:5"/>ያ <char style="nd">ዋቀዮ</char>፣ ኩን ሀመ ዮሚት?</para>
  <para style="q2" vid="PSA 79:5">አት ሀመ በረ በራት ኣርታ?</para>
  <para style="q2" vid="PSA 79:5">ህናፋንኬስ ሀመ ዮሚት አከ እብዳ ቦበአ?<verse eid="PSA 79:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 79:6"/>ዼከምሰኬ ሰነ ሰቦተ ስ ህንቤክኔረት፣</para>
  <para style="q2" vid="PSA 79:6">ሞቱሞተ መቃኬ ህንዋመትኔረት <optbreak/> ገድ ዸንገላስ፤<verse eid="PSA 79:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 79:7"/>እሳን ያቆብን ልቅምሰኒሩቲ፤</para>
  <para style="q2" vid="PSA 79:7">እዶ ጅሬኘሳስ በሌሰኒሩ።<verse eid="PSA 79:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 79:8"/>ጩቡ አቦቲኬኛ ኑት ህንሄሬግን፤</para>
  <para style="q2" vid="PSA 79:8">ዋን ኑ ባይኤ ገድ ዴብፈምኔፍ፣</para>
  <para style="q2" vid="PSA 79:8">አራርኬ ደፌ ኑ ብረ ሃገኡ።<verse eid="PSA 79:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 79:9"/>ያ ዋቅ ፈይሳኬኘ፣</para>
  <para style="q2" vid="PSA 79:9">ኡልፍነ መቃኬቲቲፍ ጄዺ ኑ ገርጋር፤</para>
  <para style="q1" vid="PSA 79:9">መቃኬቲፍ ጄዺቲ ኑ ኦልች፤</para>
  <para style="q2" vid="PSA 79:9">ጩቡኬኘሌ ኑ ዺስ።<verse eid="PSA 79:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 79:10"/>ኦርሞትን ማሊፍ፣</para>
  <para style="q2" vid="PSA 79:10">“ዋቅንሳኒ ኤሰ ጅረ?” ጄዹሬ?</para>
  <para style="b" vid="PSA 79:10"/>
  <para style="q1" vid="PSA 79:10">ዺገ ተጃጅልቶተኬቲ ከን ዸንገላፈሜ ሰናፍ፣</para>
  <para style="q2" vid="PSA 79:10">አከ ሃሎ ባፍቱ እጀኬኘ ዱረት ሰቦተ ግዱት ቤክስስ።<verse eid="PSA 79:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 79:11"/>ኣዱን ህዸምቶታ ፉለኬ ዱረ ሃገኡ፤</para>
  <para style="q2" vid="PSA 79:11">ጀብነ እሬኬቲቲን ወረ ዱት እት ሙረሜ ኦልች።<verse eid="PSA 79:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 79:12"/>ያ ጎፍታ፣ አረበ እሳን እቲን ስ አረብሰን፣</para>
  <para style="q2" vid="PSA 79:12">ደቻ ቶርበ ጎዺቲ ኦላኬኘት ዴብስ።<verse eid="PSA 79:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 79:13"/>ዮስ ኑ ሰብንኬ፣ ሆሎትን ትከኬቲ፣</para>
  <para style="q2" vid="PSA 79:13">በረ በራን ስ ጀጀትነ፤</para>
  <para style="q1" vid="PSA 79:13">ዸሎታ ሀመ ዸሎታትስ፣</para>
  <para style="q2" vid="PSA 79:13">ገለተኬ ንኦዴስነ።<verse eid="PSA 79:13"/></para>
  <chapter eid="PSA 79"/>
  <chapter number="80" style="c" sid="PSA 80"/>
  <para style="cl">ፋርፈትና 80</para>
  <para style="ms1">ሃሮምፈመ እስራኤሊፍ ዋቀ ከዸቹ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ዬደሎ፣ “ደራራ ከኩቲን” ፋርፈተሜ። ፋርፈትና አሳፍ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 80:1"/>ያ ትክሴ ሰበ እስራኤል፣</para>
  <para style="q2" vid="PSA 80:1">ከን አኩመ ቡሻዬት ዮሴፍን ጌጌስቱ ኑ ዸገእ፤</para>
  <para style="q2" vid="PSA 80:1">አት ከን ኪሩቤል ግዱ ቴሶረ ቴሱ፣ እፊቲ ሙልአዹ።<verse eid="PSA 80:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 80:2"/>ፉለ ኤፍሬም፣ ቤንያሚፊ ምናሴ ዱረት</para>
  <para style="q2" vid="PSA 80:2">ሁምነኬ ሶቾስ፤ ኮቱቲ ኑ ፈይስ።<verse eid="PSA 80:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 80:3"/>ያ ዋቅ፣ እዶኬኘት ኑ ዴብስ፤</para>
  <para style="q2" vid="PSA 80:3">አከ ፈይኑፍስ ፉለኬ ኑረት እብስ።<verse eid="PSA 80:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 80:4"/>ያ <char style="nd">ዋቀዮ</char>፣ ዋቀ ዋን ሁንደ ደንዴሱ፣</para>
  <para style="q2" vid="PSA 80:4">አት ሀመ ዮሚት ከዸትና ሰበኬቲት ኣርተ?<verse eid="PSA 80:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 80:5"/>አት ቡዴነ እምማኒ እሳን ኛችፍቴ፤</para>
  <para style="q2" vid="PSA 80:5">እምማን ወጪቲ ጉቱስ እሳን ኦባፍቴ።<verse eid="PSA 80:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 80:6"/>አት አከ ኦሎንኬኘ ኑ ቱፈተን ጎቴ፤</para>
  <para style="q2" vid="PSA 80:6">ዲኖትንኬኘስ ኑት ቆሱ።<verse eid="PSA 80:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 80:7"/>ያ ዋቀ ዋን ሁንደ ደንዴሱ፣ <optbreak/> እዶኬኘት ኑ ዴብስ፤</para>
  <para style="q2" vid="PSA 80:7">አከ ኑ ፈይኑፍስ ፉለኬ ኑረት እብስ።<verse eid="PSA 80:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 80:8"/>አት ሙከ ወይኒ ብየ ግብጢ ቡቅፍቴ ፍዴ፤</para>
  <para style="q2" vid="PSA 80:8">ኦርሞተስ አሪቴ ሙከ ሰነ ዻብዴ።<verse eid="PSA 80:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 80:9"/>ሙክቻፍስ ለፈ ቆጴስቴ፤</para>
  <para style="q2" vid="PSA 80:9">ሙክን ሱንስ ህደ ገድ ፈጌፈቴ ብየቲ ጉቴ።<verse eid="PSA 80:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 80:10"/>ቱሉወን ጋድሰሳቲን፣</para>
  <para style="q2" vid="PSA 80:10">ብርብርሰወን ጉርጉዳንስ <optbreak/> ደሜወንሳቲን ሀጉገመን።<verse eid="PSA 80:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 80:11"/>እንስ ደሜወንሳ ገረ ገላናት፣</para>
  <para style="q2" vid="PSA 80:11">ለተሳስ ሀመ ለጋት ድሪርፈቴ።<verse eid="PSA 80:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 80:12"/>ዮስ አት ማሊፍ አከ ነምን አቺን ደርቡ ሁንድኑ</para>
  <para style="q2" vid="PSA 80:12">እጀሳ ጭረቱ ጎቹፍ ጄቴ ደላሳ ዲግዴሬ?<verse eid="PSA 80:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 80:13"/>ኮርም ቦዬ ቦሶነ ኬሳ በኤ እሰ ንበሌሰ፤</para>
  <para style="q2" vid="PSA 80:13">ብኔንስ ድሬስ እሰ ንኛተ።<verse eid="PSA 80:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 80:14"/>ያ ዋቀ ዋን ሁንደ ደንዴሱ፣ <optbreak/> ስ ከዸትና ገረኬኘት ዴብእ!</para>
  <para style="q2" vid="PSA 80:14">ሰሚራ ገድ እላሊ አርግ!</para>
  <para style="q1" vid="PSA 80:14">ሙከ ወይኒ ከነ ኤግ፤<verse eid="PSA 80:14"/></para>
  <para style="q2">
    <verse number="15" style="v" sid="PSA 80:15"/>ሙክን ኩን ሙከ ወይኒ ከን ሀርክኬ ምርጋ ዻቤዸ፤</para>
  <para style="q2" vid="PSA 80:15">ብቅልቱ አት ኦፊኬቲፍ ጉድፈቴዸ።<verse eid="PSA 80:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 80:16"/>ወይኒንኬ ጭረሜ እብዳን ጉበሜረ፤</para>
  <para style="q2" vid="PSA 80:16">ሰብንኬስ ዼከምሰኬቲን በደ።<verse eid="PSA 80:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 80:17"/>ሀርክኬ ነምቸ ከራ ሀርከኬ ምርጋ ጅሩረ፣</para>
  <para style="q2" vid="PSA 80:17">እልመ ነማ ከን አት ኦፊኬቲፍ ጉድፈቴረ ሃቦቆቱ።<verse eid="PSA 80:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 80:18"/>ዮስ ኑ ስራ ህንገረገሉ፤</para>
  <para style="q2" vid="PSA 80:18">ጅሬኘ ኑ ኬን፤ ኑስ መቃኬ ንዋመትና።<verse eid="PSA 80:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 80:19"/>ያ <char style="nd">ዋቀዮ</char>፣ ዋቀ ዋን ሁንደ ደንዴሱ</para>
  <para style="q2" vid="PSA 80:19">እዶኬኘት ኑ ዴብስ፤</para>
  <para style="q2" vid="PSA 80:19">አከ ኑ ፈይኑፍስ ፉለኬ ኑረት እብስ።<verse eid="PSA 80:19"/></para>
  <chapter eid="PSA 80"/>
  <chapter number="81" style="c" sid="PSA 81"/>
  <para style="cl">ፋርፈትና 81</para>
  <para style="ms1">አያነ ዳሲቲፍ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና አሳፍ ከን <char style="tl">ግቲቲዻን</char> ፋርፈተሙ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 81:1"/>ዋቀ ጀብነ ኑ ተኤፍ ገመቹዻን ፋርፈዻ፤</para>
  <para style="q2" vid="PSA 81:1">ዋቀ ያቆቢቲፍ ገመቹዻን እልልቻ!<verse eid="PSA 81:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 81:2"/>ፋርፈቹ ጀልቀባ፤ ድቤስ ሩኩታ፤</para>
  <para style="q2" vid="PSA 81:2">በገናፊ ክራረ ሰገሌ ጋሪ ቀቡ ሩኩታ።<verse eid="PSA 81:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 81:3"/>ዬሮ ባቲን ዸለቱ፣ ዮሙ ጅእ ጎበኑት፣</para>
  <para style="q2" vid="PSA 81:3">ጉያ አያነኬኛ መለከተ አፉፋ፤<verse eid="PSA 81:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 81:4"/>ኩን ሴረ እስራኤሊፍ ኬነሜ፣</para>
  <para style="q2" vid="PSA 81:4">አጀጀ ዋቀ ያቆብ።<verse eid="PSA 81:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 81:5"/>እን ዬሮ ብየ ግብጥ ዸኡፍ በኤት፣</para>
  <para style="q2" vid="PSA 81:5">ዋን ከነ ዮሴፊፍ ሴረ ጎዼ ዻቤ።</para>
  <para style="b" vid="PSA 81:5"/>
  <para style="q1" vid="PSA 81:5">አንስ አፋን ዱራን ህንቤክን ቶኮ ዸገኤ።<verse eid="PSA 81:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 81:6"/>እንስ አከነ ጄዼ፤ <optbreak/> “አን ገቲቲሳኒራ በኣ ቡሴረ፤</para>
  <para style="q2" vid="PSA 81:6">ሀርክ እሳንስ ጉቦ ባቹ ጀላ በኤ።<verse eid="PSA 81:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 81:7"/>አት ዽጵነኬ ኬሰት ነ ዋመቴ፤ አንስ ስን ኦልቼ፤</para>
  <para style="q2" vid="PSA 81:7">አንስ ለፈ በከካን እት ዾከቱ ኬሳ ዴቢ ሲፍን ኬኔ፤</para>
  <para style="q2" vid="PSA 81:7">ብሻን መሪባ ብረትስ ስን ቆሬ።<verse eid="PSA 81:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 81:8"/>“ያ ሰበኮ ዸገእ፤ አን ሲን አኬከቺሰ፤</para>
  <para style="q2" vid="PSA 81:8">ያ እስራኤል አት ኡቱ ነ ዸጌፈቴ!<verse eid="PSA 81:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 81:9"/>ዋቅን ኦርማ ቶኮዩ እስን ግዱ ህንጅራትን፤</para>
  <para style="q2" vid="PSA 81:9">አነ መሌ ዋቀ ብራ ህንዋቄፈትን።<verse eid="PSA 81:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 81:10"/>አን <char style="nd">ዋቀዮ</char> ዋቀኬ፣</para>
  <para style="q2" vid="PSA 81:10">ከን ግብጢ ባሴ እስን ፍዴዸ።</para>
  <para style="q2" vid="PSA 81:10">አፋንኬ በልእሲ በነዹ፤ አን ነንጉታ።<verse eid="PSA 81:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 81:11"/>“ሰብንኮ ገሩ ነ ህንዸጌፈትኔ፤</para>
  <para style="q2" vid="PSA 81:11">እስራኤል አናፍ ህንቡሌ።<verse eid="PSA 81:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 81:12"/>ከናፉ አን አከ እሳን ከራ ፌዺሳኒ ዴመኒፍ</para>
  <para style="q2" vid="PSA 81:12">ደበርሴ መተ ጀብነሳኒት እሳን ኬኔ።<verse eid="PSA 81:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 81:13"/>“ኡቱ ሰብንኮ ነ ዸጌፈቴ፣</para>
  <para style="q2" vid="PSA 81:13">ኡቱ እስራኤል ከራኮረ ዴሜ ጅራቴ፣<verse eid="PSA 81:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 81:14"/>አን ስላ አከም ደፌ ዲኖተሳኒ ጅልቤንፈቺሴ</para>
  <para style="q2" vid="PSA 81:14">ሀርከኮስ አመጃጆተሳኒት ነንካሰ ቱሬ!<verse eid="PSA 81:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 81:15"/>ወር <char style="nd">ዋቀዮን</char> ጅበን ፉለሳ ዱረት ንጉጉፉ፤</para>
  <para style="q2" vid="PSA 81:15">አደቢንሳኒስ በረ በራን እት ፉፈ።<verse eid="PSA 81:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 81:16"/>አን ገሩ ቀመዲ ቁልቁሉ እስን ሶረ፤</para>
  <para style="q2" vid="PSA 81:16">ደመ ከታ ኬሳ ባፈሜስ እስነን ቁብሰ።”<verse eid="PSA 81:16"/></para>
  <chapter eid="PSA 81"/>
  <chapter number="82" style="c" sid="PSA 82"/>
  <para style="cl">ፋርፈትና 82</para>
  <para style="ms1">አቦቲ ሙርቲ ከኔን ሙርቲ ጀልእሰን</para>
  <para style="d">ፋርፈትና አሳፍ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 82:1"/>ዋቅን፣ ወልዳ ዋቆታ ግዱ ዻበተ፤</para>
  <para style="q2" vid="PSA 82:1">“ዋቆተ” ግዱትስ ሙርቲ ኬነ፤ አከነስ ጄዸ፦<verse eid="PSA 82:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 82:2"/>“እስን ሀመ ዮሚት ሴረ ጀልእፍቱ?</para>
  <para style="q2" vid="PSA 82:2">ሀመ ዮሚትስ ጀልኦታፍ ዻበቱ?<verse eid="PSA 82:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 82:3"/>ደዸብዶታፊ እጆሌ አባ ህንቀብኔፍ ሙርቲ ቀጄላ ኬና፤</para>
  <para style="q2" vid="PSA 82:3">ምርገ ህዬዪቲፊ ጩንቁርፈምቶታስ ኤግስሳ።<verse eid="PSA 82:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 82:4"/>ወረ ደዸባፊ ረከቶተ በራራ፤</para>
  <para style="q2" vid="PSA 82:4">ሀርከ ጀልኦታቲስ እሳን ባሳ።<verse eid="PSA 82:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 82:5"/>“እሳን ሆማ ህንቤከን፤ ሆማሌ ህንሁበተን።</para>
  <para style="q2" vid="PSA 82:5">እሳን ዱከነ ኬሰ ጅራቱ፤</para>
  <para style="q2" vid="PSA 82:5">ሁንዴን ለፋ ሁንድኑ ንራፈሜ።<verse eid="PSA 82:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 82:6"/>“አንስ፣ ‘እስን፣ “ዋቆተ፤”</para>
  <para style="q2" vid="PSA 82:6">ሁንድኬሰን እልማን ዋቀ ዋን ሁንዳ ኦሊት’ ጄዼረ።<verse eid="PSA 82:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 82:7"/>ተኡስ እስን አኩመ ነመት ንዱቱ፤</para>
  <para style="q2" vid="PSA 82:7">አኩመ ቡልችቶተ ከሚዩ ንኩፍቱ።”<verse eid="PSA 82:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 82:8"/>ያ ዋቅ ከእ፤ ለፈት ሙር፤</para>
  <para style="q2" vid="PSA 82:8">ሰብን ሁንድኑ ከንኬቲቲ።<verse eid="PSA 82:8"/></para>
  <chapter eid="PSA 82"/>
  <chapter number="83" style="c" sid="PSA 83"/>
  <para style="cl">ፋርፈትና 83</para>
  <para style="ms1">ከዸትና ዲኖተ እስራኤልረት ዽኣቴ</para>
  <para style="d">ፋርፈትና አሳፍ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 83:1"/>ያ ዋቅ ገብ ህንጄዽን፤</para>
  <para style="q2" vid="PSA 83:1">ያ ዋቅ፣ ህንጨልእስን፤</para>
  <para style="q2" vid="PSA 83:1">አከሱመትስ ህንዺስን።<verse eid="PSA 83:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 83:2"/>ዲኖትንኬ አከም አከ ከከአን፣</para>
  <para style="q2" vid="PSA 83:2">ወር ስ ጅበንስ አከም አከ መታ ኦል ቀበተን እላል።<verse eid="PSA 83:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 83:3"/>እሳን ሰበኬት ደበ ከሮርፈቱ፤</para>
  <para style="q2" vid="PSA 83:3">ወረ አት ኤግዱት መርአቱ።<verse eid="PSA 83:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 83:4"/>እሳንስ፣ “ኮታ አከ መቃን እስራኤል ለመተ ህንያደተምኔፍ፣</para>
  <para style="q2" vid="PSA 83:4">አከ እሳን ሰበ ህንታኔፍ እሳን በርበዴስና” ጄዹ።<verse eid="PSA 83:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 83:5"/>እሳን ያደ ቶኮን ወሊ ገሉ፤</para>
  <para style="q2" vid="PSA 83:5">ስ ትስ ንጉርማኡ፤<verse eid="PSA 83:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 83:6"/>እሳንስ ዱንካኖተ ኤዶም፣ እሽማኤሎተ፣</para>
  <para style="q2" vid="PSA 83:6">ሞኣቢፊ ጎሰ አጋር፣<verse eid="PSA 83:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 83:7"/>ጌባል፣ አሞኒፊ አማሌቅ፣</para>
  <para style="q2" vid="PSA 83:7">ፍልስጤሚፊ ነሞተ ብየ ጢሮስ ወጅን ቱረን።<verse eid="PSA 83:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 83:8"/>ወር አሶሪስ፣ እልማን ሎጢቲፍ እሬ ጀባ</para>
  <para style="q2" vid="PSA 83:8">ተኡዻፍ እሳንት መከመን።<verse eid="PSA 83:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 83:9"/>አት አኩመ ምድያንን ጎቴ፣</para>
  <para style="q2" vid="PSA 83:9">አኩመ ለገ ቂሾኒት ሲሳራፊ ያቢንን ጎቴ ሰነ እሳን ጎዽ፤<verse eid="PSA 83:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 83:10"/>እሳን ኤንዶርት ዹመኒ</para>
  <para style="q2" vid="PSA 83:10">አኩመ ኮሲ ለፋ ተአን።<verse eid="PSA 83:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 83:11"/>ጉርጉዶተሳኒ አከ ሄሬቢቲፊ ዜኤብ፣</para>
  <para style="q2" vid="PSA 83:11">እልማን ሞቶተሳኒሞ አከ ዜባፊ ዘልሙና ጎዽ፤<verse eid="PSA 83:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 83:12"/>እሳን ወረ፣ “ኮታ፣ ለፈ ትከ ዋቃ ፉዸትኔ</para>
  <para style="q2" vid="PSA 83:12">ከን ዹንፋኬኛ ጎዸትና” ጄዸኒዸ።<verse eid="PSA 83:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 83:13"/>ያ ዋቀኮ፣ አከ አዋረ ቡቤን ፉዸቱ፣</para>
  <para style="q2" vid="PSA 83:13">አከ ሀበቂ ቅሌንስ ብትኔሱ እሳን ጎዽ።<verse eid="PSA 83:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 83:14"/>አኩመ እብድ ቦሶነ በሌሱ፣</para>
  <para style="q2" vid="PSA 83:14">ዮካን አኩመ አረብን እብዳ ቱሉወን ጉቡ፣<verse eid="PSA 83:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 83:15"/>አትስ አከሱመ ኣሪኬቲን እሳን ጉግስ፤</para>
  <para style="q2" vid="PSA 83:15">ቡቤኬቲን እሳን ሶዳችስ።<verse eid="PSA 83:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 83:16"/>ያ <char style="nd">ዋቀዮ</char>፣ አከ እሳን መቃኬ በርባደተኒፍ፣</para>
  <para style="q2" vid="PSA 83:16">ፉለሳኒ ቃኒን ሀጉግ።<verse eid="PSA 83:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 83:17"/>እሳን ዬሮ ሁንደ ቃነአኒ ሃዽጰተን፤</para>
  <para style="q2" vid="PSA 83:17">ሰልጵናንስ ሃበደን።<verse eid="PSA 83:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 83:18"/>እሳን አከ አት ከን መቃንኬ <char style="nd">ዋቀዮ</char> ተኤ ሱን ቆፍት፣</para>
  <para style="q2" vid="PSA 83:18">ለፈ ሁንዱማረት ዋቀ ዋን ሁንዳ ኦሊ ታቴ ሃቤከን።<verse eid="PSA 83:18"/></para>
  <chapter eid="PSA 83"/>
  <chapter number="84" style="c" sid="PSA 84"/>
  <para style="cl">ፋርፈትና 84</para>
  <para style="ms1">ፋርፈትና ዬሮ መነ ቁልቁሉማ ዸቀን ፋርፈተሙ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ከን <char style="tl">ግቲቲዻን</char> ፋርፈተሙ። ፋርፈትና እልማን ቆራህ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 84:1"/>ያ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንዴሱ፣</para>
  <para style="q2" vid="PSA 84:1">እዶን አት ጅራቱ አከም ነመት ቶለ!<verse eid="PSA 84:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 84:2"/>ሉቡንኮ ኦብዲወን <char style="nd">ዋቀዮ</char> ሀውት፤</para>
  <para style="q2" vid="PSA 84:2">አከ መሌስ እት ገገብድ፤</para>
  <para style="q1" vid="PSA 84:2">ኦኔንኮፊ ፎንኮ</para>
  <para style="q2" vid="PSA 84:2">ዋቀ ጅራታዻፍ እልሌዻን ንፋርፈቱ።<verse eid="PSA 84:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 84:3"/>ያ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንዴሱ፣</para>
  <para style="q2" vid="PSA 84:3">ሞቲኮፊ ዋቀኮ፣</para>
  <para style="q1" vid="PSA 84:3">እዶ ኣርሳኬቲ ብረት፣ ድምቢቲን እዶ ጅሬኛ፣</para>
  <para style="q2" vid="PSA 84:3">ግርስንስ ኦፊሼቲፍ መንኤ ጩጪሼ ኬሰ ካአቱ አርገት።<verse eid="PSA 84:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 84:4"/>ወር መነኬ ኬሰ ጅራተን ኤብፈሞዸ፤</para>
  <para style="q2" vid="PSA 84:4">እሳን ዬሮ ሁንዱማ ስ ጀጀቱቲ።<verse eid="PSA 84:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 84:5"/>ወር ስራ ጀብነ አርገተን፣</para>
  <para style="q2" vid="PSA 84:5">ከኔን ገራሳኒቲን ከራኬ ያደን ኤብፈሞዸ።<verse eid="PSA 84:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 84:6"/>እሳን ዮሙ ሱሉለ ባካ ኬሰ ደርበንት፣</para>
  <para style="q2" vid="PSA 84:6">እዶ ሰነ ለፈ ብሻን ኬሳ ቡርቁ ጎዸቱ፤</para>
  <para style="q2" vid="PSA 84:6">ቦካን ጀልቀባስ ኤበ እት ዸንገላሰ።<verse eid="PSA 84:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 84:7"/>እሳን ሀመ ጥዮን ኬሰት ፉለ ዋቃ ዱረት ሙልአተንት፣</para>
  <para style="q2" vid="PSA 84:7">ጀብነራ ገረ ጀብናት ንደርቡ።<verse eid="PSA 84:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 84:8"/>ያ <char style="nd">ዋቀዮ</char>፣ ዋቀ ዋን ሁንደ ደንዴሱ፣ <optbreak/> ከዸትናኮ ዸገእ፤</para>
  <para style="q2" vid="PSA 84:8">ያ ዋቀ ያቆብ ነ ዸጌፈዹ።<verse eid="PSA 84:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 84:9"/>ያ ዋቀዮ፣ ገረ ጋቸነኬኛ እላል፤</para>
  <para style="q2" vid="PSA 84:9">ፉለ ድበማኬ ሰናስ እላል።<verse eid="PSA 84:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 84:10"/>ጉያ ኩመ ቶኮ እዶ ብራ ጅራቹረ፣</para>
  <para style="q2" vid="PSA 84:10">ጉያ ቶኮ ኦብዲኬቲረ ኦሉ ወየ፤</para>
  <para style="q1" vid="PSA 84:10">ዱንካነ ሀሞታ ኬሰ ጅራቹረ፣</para>
  <para style="q2" vid="PSA 84:10">ኤግዱ በልበለ መነ ዋቀኮ ተኡ ና ወየ።<verse eid="PSA 84:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 84:11"/>
    <char style="nd">ዋቀዮ</char> ዋቅን አዱፊ ጋቸናቲ፤</para>
  <para style="q2" vid="PSA 84:11">
    <char style="nd">ዋቀዮ</char> ሱራፊ ኡልፍነ ንኬነ፤</para>
  <para style="q2" vid="PSA 84:11">እን ቶሎተ ዋን ጋሪ ህንዾወቱ።<verse eid="PSA 84:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 84:12"/>ያ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንዴሱ፣</para>
  <para style="q2" vid="PSA 84:12">ነምን ስ አመነቱ ኤብፈማዸ።<verse eid="PSA 84:12"/></para>
  <chapter eid="PSA 84"/>
  <chapter number="85" style="c" sid="PSA 85"/>
  <para style="cl">ፋርፈትና 85</para>
  <para style="ms1">ከዸትና ነጋፍ ዽኣቴ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና እልማን ቆራህ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 85:1"/>ያ <char style="nd">ዋቀዮ</char>፣ አት ለፈኬቲፍ አርጆምቴርተ፤</para>
  <para style="q2" vid="PSA 85:1">ቦጁ ያቆብስ ዴብፍቴርተ።<verse eid="PSA 85:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 85:2"/>አት በሌሳ ኡመተኬቲ ዺፍቴርታፍ፤</para>
  <para style="q2" vid="PSA 85:2">ጩቡሳኒ ሁንዱማስ ዾክስቴርተ።<verse eid="PSA 85:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 85:3"/>ዼከምሰኬ ሁንደ ፈጌስቴርተ፤</para>
  <para style="q2" vid="PSA 85:3">ኣሪኬ ሶዳችሳ ሰነራስ ዴብቴርተ።<verse eid="PSA 85:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 85:4"/>ያ ዋቀ ፈይሳኬኘ፣ እዶኬኘት ኑ ዴብስ፤</para>
  <para style="q2" vid="PSA 85:4">ዼከምሰኬስ ኑራ ቀብ።<verse eid="PSA 85:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 85:5"/>አት በረ በራን ኑት ኣርታ? ዼከምሰኬ</para>
  <para style="q2" vid="PSA 85:5">ዸሎተ ቶኮራ ዸሎተ ካንት ደበርስታ?<verse eid="PSA 85:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 85:6"/>አከ ሰብንኬ ስት ገመዱፍ፣</para>
  <para style="q2" vid="PSA 85:6">አት ሉቡ ኑት ህንዴብፍቱ?<verse eid="PSA 85:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 85:7"/>ያ <char style="nd">ዋቀዮ</char>፣ አራረኬ ኑት ሙልእስ፤</para>
  <para style="q2" vid="PSA 85:7">ፈይነኬስ ኑ ኬን።<verse eid="PSA 85:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 85:8"/>አን ዋን <char style="nd">ዋቀዮ</char> ዋቅን ጄዹ ነንዸጌፈዸ፤</para>
  <para style="q2" vid="PSA 85:8">እን ሰበሳ ቁልቁሎታፍ ነጋ አብደቺሰ፤</para>
  <para style="q2" vid="PSA 85:8">እሳን ገሩ ገረ ጎዉማት ህንዴብእን።<verse eid="PSA 85:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 85:9"/>አከ ኡልፍንሳ ለፈኬኘረ ጅራቱፍ፣</para>
  <para style="q2" vid="PSA 85:9">ፈይሱንሳ ዹጉማን ወረ እሰ ሶዳተንት ዽኦ ጅረ።<verse eid="PSA 85:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 85:10"/>ጃለሊፊ አመነሙማን ወል ገአን፤</para>
  <para style="q2" vid="PSA 85:10">ቀጄሉማፊ ነጋን ወል ዹንገተን።<verse eid="PSA 85:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 85:11"/>አመነሙማን ለፈ ኬሳ ቡርቀ፤</para>
  <para style="q2" vid="PSA 85:11">ቀጄሉማንሞ ሰሚራ ገድ እላለ።<verse eid="PSA 85:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 85:12"/>
    <char style="nd">ዋቀዮ</char> ዹጉማን ዋን ጋሪ ንኬነ፤</para>
  <para style="q2" vid="PSA 85:12">ለፍትኬኘስ ምዻንሼ ንኬንት።<verse eid="PSA 85:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 85:13"/>ቀጄሉማን ፉለሳ ዱረ ዴመ፤</para>
  <para style="q2" vid="PSA 85:13">ሚለ እሳቲፍስ ከራ ቆጴሰ።<verse eid="PSA 85:13"/></para>
  <chapter eid="PSA 85"/>
  <chapter number="86" style="c" sid="PSA 86"/>
  <para style="cl">ፋርፈትና 86</para>
  <para style="ms1">ከዸትና ዬሮ ረክና</para>
  <para style="d">ከዸትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 86:1"/>ያ <char style="nd">ዋቀዮ</char>፣ ዋን አን ህዬሳፊ ረከታ ተኤፍ፣</para>
  <para style="q2" vid="PSA 86:1">ነ ዸገኢቲ ዴቢ ና ኬን።<verse eid="PSA 86:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 86:2"/>አን ስት ኦፍ ኬኔራቲ ሉቡኮ ኤግ።</para>
  <para style="q2" vid="PSA 86:2">አት ዋቀኮት፤</para>
  <para style="q2" vid="PSA 86:2">ገርብቸኬ ከን ስ አመነቱ ኦልች።<verse eid="PSA 86:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 86:3"/>ያ ጎፍታ ነ ማር፤</para>
  <para style="q2" vid="PSA 86:3">አን ጉያ ጉቱ ስን ዋመዻቲ።<verse eid="PSA 86:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 86:4"/>ሉቡ ገርብቸኬቲ ገመቺስ፤</para>
  <para style="q2" vid="PSA 86:4">ያ ጎፍታ፣ አን ሉቡኮ ገረኬት ኦል ነንፉዻቲ።<verse eid="PSA 86:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 86:5"/>ያ ጎፍታ አት ጋሪዸ፤ ዺፈመስ ነማ ጎተ፤</para>
  <para style="q2" vid="PSA 86:5">ወረ ስ ዋመተን ሁንዳፍስ ጃለልኬ ጉዳዸ።<verse eid="PSA 86:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 86:6"/>ያ <char style="nd">ዋቀዮ</char>፣ ከዸትናኮ ዸገእ፤</para>
  <para style="q2" vid="PSA 86:6">እየ ዋመተኮስ ዸጌፈዹ።<verse eid="PSA 86:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 86:7"/>አን ጉያ ረክነኮቲት ስን ዋመዸ፤</para>
  <para style="q2" vid="PSA 86:7">አት ዴቢ ና ኬንታቲ።<verse eid="PSA 86:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 86:8"/>ያ ጎፍታ፣ ዋቆተ ኬሳ ከን አከኬቲ ህንጅሩ፤</para>
  <para style="q2" vid="PSA 86:8">ሆጂን ሆጂኬቲን ወል ቅጣቱ ቶኮዩ ህንጅሩ።<verse eid="PSA 86:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 86:9"/>ያ ጎፍታ፣ ሰቦትን አት ኡምቴ ሁንድኑ ዹፈኒ፣</para>
  <para style="q2" vid="PSA 86:9">ፉለኬ ዱረት ንሰገዱ፤</para>
  <para style="q2" vid="PSA 86:9">መቃኬቲፍስ ኡልፍነ ፍዱ።<verse eid="PSA 86:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 86:10"/>አት ጉዳፊ ከን ሆጂ ድንቅሲሳ ሆጄቱዸ፤</para>
  <para style="q2" vid="PSA 86:10">ዋቅን ሱመ ቆፈ።<verse eid="PSA 86:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 86:11"/>ያ <char style="nd">ዋቀዮ</char>፣ ከራኬ ነ በርሲስ፤</para>
  <para style="q2" vid="PSA 86:11">አንስ ዹጋኬቲን ነንቡለ፤</para>
  <para style="q1" vid="PSA 86:11">አከ አን መቃኬ ሶዳዹፍ፣</para>
  <para style="q2" vid="PSA 86:11">ገራ ገርገር ህንቆደምኔ ና ኬን።<verse eid="PSA 86:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 86:12"/>ያ ዋቀኮ ጎፍታ፣ አን ገራኮ ጉቱዻን ስን ገለቴፈዸ፤</para>
  <para style="q2" vid="PSA 86:12">መቃኬሌ በረ በራን ነንኡልፌሰ።<verse eid="PSA 86:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 86:13"/>ጃለል አት ና ቀብዱ ጉዳዻቲ፤</para>
  <para style="q2" vid="PSA 86:13">ሉቡኮ ዽዽመ ሲኦል ኬሳ ባፍቴርተ።<verse eid="PSA 86:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 86:14"/>ያ ዋቅ፣ ኦፍ ቱልቶትን ነት ከአኒሩ፤</para>
  <para style="q2" vid="PSA 86:14">ቱትን ፍንጭልቶታ፣ ነሞትን ስ ህንሶዳትኔ</para>
  <para style="q2" vid="PSA 86:14">ሉቡኮ ገላፈቹ በርባዱ።<verse eid="PSA 86:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 86:15"/>ያ ጎፍታ፣ አት ገሩ ዋቀ ገራ ላፌሳፊ አርጃዸ፤</para>
  <para style="q2" vid="PSA 86:15">ደፍቴ ህንኣርቱ፤ ጃለሊፊ አመነሙማንኬ ዹመ ህንቀቡ።<verse eid="PSA 86:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 86:16"/>ገረኮት ዴብኢቲ ነ ማር፤</para>
  <para style="q2" vid="PSA 86:16">ጀብነኬ ተጃጅላኬቲ ኬን፤</para>
  <para style="q2" vid="PSA 86:16">እልመ ገርብቲኬቲስ ኦልች።<verse eid="PSA 86:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 86:17"/>አከ ዲኖትንኮ አርገኒ ቃነአኒፍ፣</para>
  <para style="q2" vid="PSA 86:17">መለቶ ጋሩማኬቲ ና ኬን፤</para>
  <para style="q2" vid="PSA 86:17">ያ <char style="nd">ዋቀዮ</char>፣ አት ነ ገርጋርቴ ነ ጀጀቤስቴርታቲ።<verse eid="PSA 86:17"/></para>
  <chapter eid="PSA 86"/>
  <chapter number="87" style="c" sid="PSA 87"/>
  <para style="cl">ፋርፈትና 87</para>
  <para style="ms1">ጥዮን፣ ሃዸ ሰቦታ</para>
  <para style="d">ፋርፈትና እልማን ቆራህ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 87:1"/>ሁንዴን መጋላሳ ቱሉ ቁልቁሉረ ጅረ።<verse eid="PSA 87:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 87:2"/>
    <char style="nd">ዋቀዮ</char> እዶ ጅሬኘ ያቆብ ሁንደ ጫላ፣</para>
  <para style="q2" vid="PSA 87:2">ከረወን ጥዮን ጃለተ።<verse eid="PSA 87:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 87:3"/>ያ መጋላ ዋቃ፣</para>
  <para style="q2" vid="PSA 87:3">ዋኤኬቲፍ ወን ከበጀማን አከነ ጄዸሜ ንዱበተመ፦<verse eid="PSA 87:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 87:4"/>“አን ረኣቢፊ ባብሎንን</para>
  <para style="q2" vid="PSA 87:4">ወረ ነ ቤከን ግዱት መቃ ነንዸአ፤</para>
  <para style="q1" vid="PSA 87:4">ኩኖ፣ ፍልስጤሚፊ ጢሮስ እቶጵያ ወጅን፣</para>
  <para style="q2" vid="PSA 87:4">‘ነምች ኩን አችት ዸለቴ’ ጄዹ።”<verse eid="PSA 87:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 87:5"/>ዹጉማን ዋኤ ጥዮን፣</para>
  <para style="q2" vid="PSA 87:5">“እን ኩኒፊ እን ሱን እሼ ኬሰት ዸለተን፤</para>
  <para style="q2" vid="PSA 87:5">ዋቅን ዋን ሁንደ ኦሊ መታንሳዩ እሼ ዻበ” ጄዸመ።<verse eid="PSA 87:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 87:6"/>
    <char style="nd">ዋቀዮ</char> ዬሮ ሰቦተ ገልሜሱት፣</para>
  <para style="q2" vid="PSA 87:6">“ነምች ኩን አችት ዸለቴ” ጄዼ በሬሰ።<verse eid="PSA 87:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 87:7"/>ወር ፋርፈተኒፊ ወር ሜሻ ሙዚቃ ተጰተን፣</para>
  <para style="q2" vid="PSA 87:7">“ቡርቃንኮ ሁንድ ስ ኬሰት አርገመ” ጄዹ።<verse eid="PSA 87:7"/></para>
  <chapter eid="PSA 87"/>
  <chapter number="88" style="c" sid="PSA 88"/>
  <para style="cl">ፋርፈትና 88</para>
  <para style="ms1">ከዸትና ዬሮ ረክና</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና እልማን ቆራህ ከን <char style="tl">ማህላት ሊኖቲን</char><note caller="+" style="f"><char style="fr" closed="false">88፥0 </char><char style="ft" closed="false">ማህላት ሊኖቲን <char style="it">ጎሰ ሙዚቃት።</char></char></note> ፋርፈተሜ። <char style="tl">መስኪሊ</char> ሄማን እዝራህቻ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 88:1"/>ያ <char style="nd">ዋቀዮ</char>፣ ዋቀ ነ ፈይፍቱ፣</para>
  <para style="q2" vid="PSA 88:1">አን ሀልከኒፊ ጉያ ፉለኬ ዱረት ነንእየዸ።<verse eid="PSA 88:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 88:2"/>ከዸናንኮ ፉለኬ ዱረት ሃዽኣቱ፤</para>
  <para style="q2" vid="PSA 88:2">አትስ ጉረኬ ገረ እየትናኮቲት ቀብ።<verse eid="PSA 88:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 88:3"/>ሉቡንኮ ረክናን ጉተምቴርቲ፤</para>
  <para style="q2" vid="PSA 88:3">ጅሬኝኮስ አዋለት ዽኣቴረ።<verse eid="PSA 88:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 88:4"/>አን ወረ ቦለ ኬሰ ቡአንት ነንለካአሜ፤</para>
  <para style="q2" vid="PSA 88:4">አከ ነመ ሁምነ ህንቀብኔስ ነንተኤ።<verse eid="PSA 88:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 88:5"/>አን አከ ነመ ጎረአሜ አዋለ ኬሰ ጪሱት፣</para>
  <para style="q2" vid="PSA 88:5">አከ ነመ አት ዴብቴ ህንያደኔት፣</para>
  <para style="q1" vid="PSA 88:5">አከ ወረ ኤጉምሰኬ ጀላ በአኒት፣</para>
  <para style="q2" vid="PSA 88:5">ወረ ዱአን ወጅን ገተሜረ።<verse eid="PSA 88:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 88:6"/>አት ቦለ ገድ ፈጎ ኬሰ፣</para>
  <para style="q2" vid="PSA 88:6">ዱከነ ሀማ ኬሰስ ነ ቡፍቴርተ።<verse eid="PSA 88:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 88:7"/>ዼከምስኬ ኡልፋቴ ነረ ጪሴረ፤</para>
  <para style="q2" vid="PSA 88:7">ደምበሊኬ ሁንደስ ነረ ገረገልችቴርተ።<verse eid="PSA 88:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 88:8"/>ምቾተኮ ነራ ፈጌስቴርተ፤</para>
  <para style="q2" vid="PSA 88:8">እሳን ብረት ጅበማ ነ ጎቴርተ፤</para>
  <para style="q1" vid="PSA 88:8">አከ አን ጀላ ህንባኔትስ በልበል ነት ጩፈሜረ።<verse eid="PSA 88:8"/></para>
  <para style="q2">
    <verse number="9" style="v" sid="PSA 88:9"/>እጅኮ ገዳን ደዸቤረ።</para>
  <para style="b" vid="PSA 88:9"/>
  <para style="q1" vid="PSA 88:9">ያ <char style="nd">ዋቀዮ</char>፣ አን ጉዩመ ጉያን ስን ዋመዸ፤</para>
  <para style="q2" vid="PSA 88:9">ሀርከኮሌ ገረኬት ነንበልእፈዸ።<verse eid="PSA 88:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 88:10"/>አት ድንቂኬ ወረ ዱአንት ንአርግሲፍታ?</para>
  <para style="q2" vid="PSA 88:10">ወር ዱአንስ ከአኒ ስ ገለቴፈቱ?<verse eid="PSA 88:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 88:11"/>ጃለልኬ አዋለ ኬሰት፣</para>
  <para style="q2" vid="PSA 88:11">አመነሙማን ኬሞ ቅሌ ኬሰት ንለብሰማ?<verse eid="PSA 88:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 88:12"/>ድንቂወንኬ ዱከነ ኬሰት፣</para>
  <para style="q2" vid="PSA 88:12">ዮካን ቀጄሉማንኬ ብየ እራንፈትና ኬሰት ንቤከማ?<verse eid="PSA 88:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 88:13"/>ያ <char style="nd">ዋቀዮ</char>፣ አን ገሩ አከ አት ነ ገርጋርቱፍ <optbreak/> ገረኬት ነንእየዸ፤</para>
  <para style="q2" vid="PSA 88:13">ገነማንስ ከዸናንኮ ፉለኬ ዱረት ንዽኣተ።<verse eid="PSA 88:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 88:14"/>ያ <char style="nd">ዋቀዮ</char>፣ አት ማሊፍ ነ ገተ?</para>
  <para style="q2" vid="PSA 88:14">ፉለኬስ ማሊፍ ነ ዱራ ዾክፈተ?<verse eid="PSA 88:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 88:15"/>አን እጆሉማኮቲ ጀልቀቤ ረከዼ ዱኡ ገኤን ቱሬ፤</para>
  <para style="q2" vid="PSA 88:15">ናስሱንኬ ነ ዽጵሴረ፤ አብዲስ ኩተዼረ።<verse eid="PSA 88:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 88:16"/>ዼከምስኬ ነረ ያኤ፤</para>
  <para style="q2" vid="PSA 88:16">ናስሱንኬስ ነ በሌሴረ።<verse eid="PSA 88:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 88:17"/>እሳን ጉያ ጉቱ አኩመ ሎላ ብሻኒ ነ መርሱ፤</para>
  <para style="q2" vid="PSA 88:17">ጉቱማን ጉቱትስ ነ ልቅምሰኒሩ።<verse eid="PSA 88:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 88:18"/>ምቾተኮፊ ወረ ነ ጃለተን ነራ ፉዸቴርተ፤</para>
  <para style="q2" vid="PSA 88:18">ዱከነ ቆፈቱ ምቹ ና ተኤ።<verse eid="PSA 88:18"/></para>
  <chapter eid="PSA 88"/>
  <chapter number="89" style="c" sid="PSA 89"/>
  <para style="cl">ፋርፈትና 89</para>
  <para style="ms1">ፋርፈትናፊ ከዸትና አመነሙማ ዋቃቲፍ ዽኣቴ</para>
  <para style="d">
    <char style="tl">መስኪሊ</char> ኤታን እዝራህቻ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 89:1"/>አን ዋኤ አራረ <char style="nd">ዋቀዮ</char> በረ በራን ነንፋርፈዸ፤</para>
  <para style="q2" vid="PSA 89:1">አፋንኮቲንስ አመነሙማኬ ዸሎተ ሁንዱመት ነንለብሰ።<verse eid="PSA 89:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 89:2"/>አከ አራርኬ በረ በራን ጅራቱ፣</para>
  <para style="q2" vid="PSA 89:2">አከ አት አመነሙማኬ ሰሚ ኬሰት ጀቤስቴ ዻብዴ ነንለብሰ።<verse eid="PSA 89:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 89:3"/>አት አከነ ጄቴርተ፤ “አን ፍለተማኮ ወጅን ከኩ ገሌረ፤</para>
  <para style="q2" vid="PSA 89:3">ዳዊት ተጃጅላኮቲፍሌ አከነ ጄዼ ከከዼረ፤<verse eid="PSA 89:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 89:4"/>‘አን በረ በራን ሰኚኬ ነንዻበ፤</para>
  <para style="q2" vid="PSA 89:4">ቴሶኬስ ዸሎተ ሁንዳፍ ነንጭምሰ።’ ”<verse eid="PSA 89:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 89:5"/>ያ <char style="nd">ዋቀዮ</char>፣ ሰሚወን ድንቂኬ ጀጁ፤</para>
  <para style="q2" vid="PSA 89:5">ያኢ ቁልቁሎታ ኬሰትስ አመነሙማኬ ጀጁ።<verse eid="PSA 89:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 89:6"/>ሰሚ ኬሰት ኤኙቱ <char style="nd">ዋቀዮን</char> ቅጣቹ ደንደአ?</para>
  <para style="q2" vid="PSA 89:6">ኡመመወን ሰሚ ኬሳ ከን <char style="nd">ዋቀዮን</char> ፈካቱ ኤኙ?<verse eid="PSA 89:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 89:7"/>ዋቅን ወልዳ ቁልቁሎታ ኬሰት ባይኤ ሶዳተመ፤</para>
  <para style="q2" vid="PSA 89:7">ወረ ናኖሳ ጅረን ሁንደ ኬሳስ እሰቱ ሶዳችሳዸ።<verse eid="PSA 89:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 89:8"/>ያ <char style="nd">ዋቀዮ</char>፣ ዋቀ ዋን ሁንደ ደንዴሱ፣ <optbreak/> ከን አከኬቲ ኤኙ?</para>
  <para style="q2" vid="PSA 89:8">ያ <char style="nd">ዋቀዮ</char>፣ አት ጀባዸ፤ አመነሙማንኬስ ስ መርሰ።<verse eid="PSA 89:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 89:9"/>አት ራፈመ ገላና ንሞተ፤</para>
  <para style="q2" vid="PSA 89:9">ዮሙ ዸኣንሳ ጀባቱስ ንተስገቤስተ።<verse eid="PSA 89:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 89:10"/>አከ ወረ ቀለመኒት ረኣብን ቡሌስቴ፤</para>
  <para style="q2" vid="PSA 89:10">እሬኬ ጀባ ሰናንስ ዲኖተኬ ንብትኔስቴ።<verse eid="PSA 89:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 89:11"/>ሰሚወን ከንኬት፤ ለፍትስ አከሱመ ከንኬት፤</para>
  <para style="q2" vid="PSA 89:11">አት አዱኛፊ ዋን እሼ ኬሰ ጅሩ ሁንደ ሁንዴስቴርተ።<verse eid="PSA 89:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 89:12"/>ካባፊ ክበ ስቱ ኡሜ፤</para>
  <para style="q2" vid="PSA 89:12">ታቦሪፊ ሄርሞን ገመቹዻን <optbreak/> መቃኬ ገለቴፈቱ።<verse eid="PSA 89:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 89:13"/>አት እሬ ጀባ ቀብደ፤ ሀርክኬ ጀባዸ፤</para>
  <para style="q2" vid="PSA 89:13">ሀርክኬ ምርጋስ ኦል ከኤረ።<verse eid="PSA 89:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 89:14"/>ቀጄሉማፊ ሙርቲን ቀጄላን ሁንዴ ቴሶኬቲት፤</para>
  <para style="q2" vid="PSA 89:14">አራሪፊ አመነሙማን ፉለኬ ዱረ ዴሙ።<verse eid="PSA 89:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 89:15"/>ያ <char style="nd">ዋቀዮ</char>፣ ወር ሲፍ እልልቹ ቤከን፣</para>
  <para style="q2" vid="PSA 89:15">ወር እፈ እዶ አት ጅርቱ ኬሰ ጅራተን ኤብፈሞዸ።<verse eid="PSA 89:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 89:16"/>እሳን ጉያ ጉቱ መቃኬቲን ገመዱ፤</para>
  <para style="q2" vid="PSA 89:16">ቀጄሉማኬቲንስ ስ ጀጀቱ።<verse eid="PSA 89:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 89:17"/>አት ኡልፍነ ጀብነሳኒት፤</para>
  <para style="q2" vid="PSA 89:17">ጃለለኬቲንስ ጋንፈኬኘ ኦል ቀብዴርተ።<verse eid="PSA 89:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 89:18"/>ዹጉማን ጋቸንኬኘ ከን <char style="nd">ዋቀዮት</char>፤</para>
  <para style="q2" vid="PSA 89:18">ከን ሞቲኬኘ ቁልቁልቸ እስራኤሊት።<verse eid="PSA 89:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 89:19"/>አት ዱር አከነ ጄቴ ሰበኬ አመነማት</para>
  <para style="q2" vid="PSA 89:19">ሙልአታን ዱበቴርተ፦</para>
  <para style="q1" vid="PSA 89:19">“አን ሎልቱ ቶኮፍ ሁምነ ኬኔረ፤</para>
  <para style="q2" vid="PSA 89:19">ደርገጌሰ ሰበ ኬሳ ፍለተሜ ቶኮስ አን ኦል ጉድሴረ።<verse eid="PSA 89:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 89:20"/>አን ገርብቸኮ ዳዊትን አርገዼረ፤</para>
  <para style="q2" vid="PSA 89:20">ዘይቲኮ ቁልቁሉንስ እሰ ድቤረ።<verse eid="PSA 89:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 89:21"/>ሀርክኮ እሰ ወጅን ጅረ፤</para>
  <para style="q2" vid="PSA 89:21">እሬንኮስ እሰ ጀጀቤሰ።<verse eid="PSA 89:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 89:22"/>ዲን ቶኮዩ እሰ ህንሞአቱ፤</para>
  <para style="q2" vid="PSA 89:22">ነምን ሀማንስ እሰ ህንሀጩጩ።<verse eid="PSA 89:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 89:23"/>አመጃጆተሳ ፉለሳ ዱረት ነንበርበዴሰ፤</para>
  <para style="q2" vid="PSA 89:23">ወረ እሰ ጅበንስ ነንዸአ።<verse eid="PSA 89:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 89:24"/>አመነሙማፊ አራርኮ እሰ ወጅን ጅራተ፤</para>
  <para style="q2" vid="PSA 89:24">ጋንፍሳስ መቃኮቲን ኦል ጄዸ።<verse eid="PSA 89:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 89:25"/>አን ሀርከሳ ገላነረ፣</para>
  <para style="q2" vid="PSA 89:25">ሀርከሳ ምርጋስ ለጌንረ ነንካአ።<verse eid="PSA 89:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 89:26"/>እንስ፣ ‘አት አባኮት፤</para>
  <para style="q2" vid="PSA 89:26">ዋቀኮት፣ ከታ ፈይነኮት’ ጄዼ ነ ዋመተ።<verse eid="PSA 89:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 89:27"/>አንስ እልመኮ ሀንገፈ፣</para>
  <para style="q2" vid="PSA 89:27">ከን ሞቶተ ለፋ ሁንዳ ኦሊ እሰ ነንጎዸ።<verse eid="PSA 89:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 89:28"/>ጃለለኮስ በረ በራን እሳፍ ነንቱርሰ፤</para>
  <para style="q2" vid="PSA 89:28">ከኩን አን እሰ ወጅን ቀቡስ ህንጨቡ።<verse eid="PSA 89:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 89:29"/>ህደ ሰኚሳ በረ በራን፣</para>
  <para style="q2" vid="PSA 89:29">ቴሶሳሌ ሀመ ሰሚወን ጅራተንት ነንዻበ።<verse eid="PSA 89:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 89:30"/>“ዮ እልማንሳ ሴረኮ ኤጉ ድደን፣</para>
  <para style="q2" vid="PSA 89:30">ዮ እሳን አጀጀኮ ፋነ ቡኡ ባተን፣<verse eid="PSA 89:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 89:31"/>ዮ እሳን ስርነኮ ጨብሰኒ</para>
  <para style="q2" vid="PSA 89:31">አጀጀኮሌ ኤጉ ባተን፣<verse eid="PSA 89:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 89:32"/>አን ጩቡሳኒ ኡሌዻን፣</para>
  <para style="q2" vid="PSA 89:32">የከሳኒሞ ቀጬዻን ነንአደበ፤<verse eid="PSA 89:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 89:33"/>አን ገሩ ጃለለኮ እሰራ ህንፉዸዹ፤</para>
  <para style="q2" vid="PSA 89:33">ዮካን አመነሙማኮ ሶበት ህንጌደሩ።<verse eid="PSA 89:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 89:34"/>አን ከኩኮ ህንጨብሱ፤</para>
  <para style="q2" vid="PSA 89:34">ዮካን ዋን አፋንኮ ዱበቴስ ህንጌደሩ።<verse eid="PSA 89:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 89:35"/>ስአ ቶኮ ዬሮ ሁንዳፍ፣ ቁልቁልነኮቲን ከከዼረ፤</para>
  <para style="q2" vid="PSA 89:35">አን ዳዊትን ህንሶቡ።<verse eid="PSA 89:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 89:36"/>ሰኚንሳ በረ በራን እት ፉፈ፤</para>
  <para style="q2" vid="PSA 89:36">ቴሶንሳስ አኩመ አዱ ፉለኮ ዱረ ጅራተ፤<verse eid="PSA 89:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 89:37"/>አኩመ ጅኣስ በረ በራን ንጅራተ፤</para>
  <para style="q2" vid="PSA 89:37">ሀመ ሰሚወን ጅረንትስ ጭሜ ዻበተ።”<verse eid="PSA 89:37"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 89:38"/>አት አመ ገሩ እሰ ዺፍቴርተ፤ ቱፈቴርተስ፤</para>
  <para style="q2" vid="PSA 89:38">እሰ ድብዴ ሰነት ባይኤ ኣርቴርተ።<verse eid="PSA 89:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 89:39"/>ከኩ ተጃጅላኬ ወጅን ገልቴ ጨብስቴርተ፤</para>
  <para style="q2" vid="PSA 89:39">ጎንፎሳስ አዋረ ኬሰ ቡፍቴ ጡሬስቴርተ።<verse eid="PSA 89:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 89:40"/>ደላሳ ሁንደ ጨጨብስቴርተ፤</para>
  <para style="q2" vid="PSA 89:40">ደኦሳ ጀጀባስ በርበዴስቴርተ።<verse eid="PSA 89:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 89:41"/>ወር አቺን ደርበን ሁንድ እሰ ሳሙ፤</para>
  <para style="q2" vid="PSA 89:41">ኦሎንሳስ እት ቆሱ።<verse eid="PSA 89:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 89:42"/>አት ሀርከ አመጃጂሳ ምርጋ ኦል ቀብዴርተ፤</para>
  <para style="q2" vid="PSA 89:42">አከ ዲኖትንሳ ሁንድ ገመደን ጎቴርተ።<verse eid="PSA 89:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 89:43"/>አርፊ ጎራዴሳ ዱበት ዴብፍቴርተ፤</para>
  <para style="q2" vid="PSA 89:43">ወራነ ኬሰትስ እሰ ህንገርጋሬ።<verse eid="PSA 89:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 89:44"/>ሱራሳ እሰራ በሌስቴርተ፤</para>
  <para style="q2" vid="PSA 89:44">ቴሶሳስ ለፈት ገቴርተ።<verse eid="PSA 89:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 89:45"/>ኡሙሪ ደርገጉማሳ ገባብስቴርተ፤</para>
  <para style="q2" vid="PSA 89:45">ቃኒዻንስ እሰ ሀጉግዴርተ።<verse eid="PSA 89:45"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 89:46"/>ያ <char style="nd">ዋቀዮ</char>፣ ኩን ሀመ ዮሚት?</para>
  <para style="q2" vid="PSA 89:46">አት በረ በራን ኦፍ ዾክስታ?</para>
  <para style="q2" vid="PSA 89:46">ዼከምስኬ ሀመ ዮሚት አከ እብዳ ቦበአ?<verse eid="PSA 89:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 89:47"/>ኡሙሪንኮ ሀመም አከ ገባባ ተኤ ያደዹ።</para>
  <para style="q2" vid="PSA 89:47">አት በዲሰ አከሚቲፍ እልማን ነማ ሁንደ ኡምቴ!<verse eid="PSA 89:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 89:48"/>ኡቱ ዱአ ህንአርግን ጅራቹ ከን ደንደኡ</para>
  <para style="q2" vid="PSA 89:48">ዮካን ሁምነ ሲኦል ጀላ ኦፍ ባሱ <optbreak/> ከን ደንደኡ ነመ አከሚት?<verse eid="PSA 89:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 89:49"/>ያ ጎፍታ፣ ጃለልኬ ጉዳን ዱሪ ከን አት አመነሙማኬቲን</para>
  <para style="q2" vid="PSA 89:49">ዳዊቲፍ ከከቴ ሱን ኤሰ ጅረ?<verse eid="PSA 89:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 89:50"/>ያ ጎፍታ፣ አከምት አከ ተጃጅላንኬ ቱፈተሜ፣</para>
  <para style="q2" vid="PSA 89:50">አከምት አከ አን አረብሶ ሰቦተ ሁንዳ <optbreak/> ቦባት ባዼ ያደዹ፤<verse eid="PSA 89:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 89:51"/>ያ <char style="nd">ዋቀዮ</char>፣ ቆሳ ዲኖትንኬ ነት ቆሰን፣</para>
  <para style="q2" vid="PSA 89:51">ከን እሳን እቲን ተርካንፊ ድበማኬቲ ሁንደት ቆሰን ያደዹ።<verse eid="PSA 89:51"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 89:52"/>ገለን በረ በራን <char style="nd">ዋቀዮፍ</char> ሃተኡ!</para>
  <para style="qr" vid="PSA 89:52">አሜን፤ አሜን።<verse eid="PSA 89:52"/></para>
  <chapter eid="PSA 89"/>
  <chapter number="90" style="c" sid="PSA 90"/>
  <para style="ms">ክታበ አፉረፋ</para>
  <para style="mr">
    <ref loc="PSA 90-106">ፋርፈትና 90–106</ref></para>
  <para style="cl">ፋርፈትና 90</para>
  <para style="ms1">ነምን ደዸባ ተኡሳ</para>
  <para style="d">ከዸትና ሙሴ ነመ ዋቃ ሰና።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 90:1"/>ያ ጎፍታ፣ አት ዸሎተ ሁንደ ኬሰት</para>
  <para style="q2" vid="PSA 90:1">እዶ ጅሬኛ ኑ ታቴርተ።<verse eid="PSA 90:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 90:2"/>ኡቱ ቱሉወን ህንዸለትን</para>
  <para style="q2" vid="PSA 90:2">ዮካን ኡቱ አት ለፋፊ አዱኛ ህንኡምን፣</para>
  <para style="q2" vid="PSA 90:2">በራ በራ ሀመ በረ በራት አት ዋቀ።<verse eid="PSA 90:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 90:3"/>አትስ፣ “ያ እልማን ነሞታ፣ ብዮት ዴብኣ”</para>
  <para style="q2" vid="PSA 90:3">ጄቴ ነሞተ ብዮት ዴብስተ።<verse eid="PSA 90:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 90:4"/>ፉለኬ ዱረት ወጋን ኩምን ቶኮ፣</para>
  <para style="q2" vid="PSA 90:4">አኩመ ጉያ ከሌሰ ደርቤት፤</para>
  <para style="q2" vid="PSA 90:4">ዮካን አኩመ ደበሬ ኤጉምሰ ሀልከኒ ቶኮት።<verse eid="PSA 90:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 90:5"/>አት ህርበ ዱኣቲን ነሞተ ሀጦፍቴ በሌስተ፤</para>
  <para style="q2" vid="PSA 90:5">እሳን አኩመ መርገ ገነመ በየነቱት፤<verse eid="PSA 90:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 90:6"/>መርግ ሱን ገነመ ገነመ በየነቱሌ</para>
  <para style="q2" vid="PSA 90:6">ገልገለ ገልገለ ገሩ ጮለጌ ጎገ።<verse eid="PSA 90:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 90:7"/>ኣሪንኬ ኑ ፍጤረ፤</para>
  <para style="q2" vid="PSA 90:7">ዼከምስኬስ ኑ ናስሴረ።<verse eid="PSA 90:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 90:8"/>የከኬኘ ፉለኬ ዱረ፣</para>
  <para style="q2" vid="PSA 90:8">ጩቡኬኘ ዾከታ ሰነስ እፈ ፉለኬቲ ዱረ ኬሴርተ።<verse eid="PSA 90:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 90:9"/>በርኬኘ ሁንድኑ ዼከምሰኬቲን ዹሜራቲ፤</para>
  <para style="q2" vid="PSA 90:9">ኡሙሪኬኘስ ኣዱዻን ፍጠትነ።<verse eid="PSA 90:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 90:10"/>ዼርን በረኬኛ ወጋ ቶርባተመ፣</para>
  <para style="q2" vid="PSA 90:10">ዮ ጀባትኔሞ ወጋ ሰዴተመ ተአ፤</para>
  <para style="q1" vid="PSA 90:10">ኩንዩ ገር ጫላንሳ ደዸቢፊ ረክናን ጉተሜረ፤</para>
  <para style="q2" vid="PSA 90:10">እን ደፌ ደርባቲ፤ ኑስ በርፍኔ ንሶክነ።<verse eid="PSA 90:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 90:11"/>ሁምነ ኣሪኬቲ ኤኙቱ ቤከ?</para>
  <para style="q2" vid="PSA 90:11">ዼከምስኬ አኩመ ሶዳ ኑ ሲፍ ቀባቹ ቀብኑ ሰና <optbreak/> ጉዳዻቲ።<verse eid="PSA 90:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 90:12"/>አከ ኑ ገራ ኦጉማዻን ጉተሜ ቀባኑፍ፣</para>
  <para style="q2" vid="PSA 90:12">በረኬኘ ለካኡ ኑ በርሲስ።<verse eid="PSA 90:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 90:13"/>ያ <char style="nd">ዋቀዮ</char>፣ ዴብእ! ኩን ሀመ ዮሚት ተአ?</para>
  <para style="q2" vid="PSA 90:13">ተጃጅልቶተኬቲፍስ ገራ ላፍ።<verse eid="PSA 90:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 90:14"/>አከ ኑ በረኬኘ ጉቱ ገመድኔ እልልችኑፍ፣</para>
  <para style="q2" vid="PSA 90:14">ገነመ ገነመ አራረኬቲን ኑ ቁፍስ።<verse eid="PSA 90:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 90:15"/>ሀመ ባይእነ ጉዮተ አት ኑ ሚቴ ሰና፣</para>
  <para style="q2" vid="PSA 90:15">ሀመ ባይእነ ወጎተ ኑ ረከትኔ ሰናስ ኑ ገመቺስ።<verse eid="PSA 90:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 90:16"/>ሆጂንኬ ተጃጅልቶተኬት፣</para>
  <para style="q2" vid="PSA 90:16">ኡልፍንኬስ እጆሌሳኒት ሃሙልእፈሙ።<verse eid="PSA 90:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 90:17"/>ኤብ ዋቀኬኘ ጎፍትቻ ኑረ ሃቡኡ፤</para>
  <para style="q2" vid="PSA 90:17">ሆጂ ሀርከኬኛስ ጀቤሲ ኑ ዻብ፤</para>
  <para style="q2" vid="PSA 90:17">ኤዬ፣ ሆጂ ሀርከኬኛ ጀቤሲ ኑ ዻብ።<verse eid="PSA 90:17"/></para>
  <chapter eid="PSA 90"/>
  <chapter number="91" style="c" sid="PSA 91"/>
  <para style="cl">ፋርፈትና 91</para>
  <para style="ms1">ኤጉምሰ ዋቃ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 91:1"/>ነምን ደኦ ዋቀ ዋን ሁንዳ ኦሊ ኬሰ ጅራቱ፣</para>
  <para style="q2" vid="PSA 91:1">ጋድሰ ዋቀ ዋን ሁንደ ደንደኡ ሰና ጀለ ቦቆተ።<verse eid="PSA 91:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 91:2"/>አንስ <char style="nd">ዋቀዮን</char>፣ “እን እዶ አን እት ኮሉ ገሉፊ <optbreak/> ደአትኖኮት፤</para>
  <para style="q2" vid="PSA 91:2">ዋቀኮ ከን አን አመነዹዸ” ነንጄዸ።<verse eid="PSA 91:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 91:3"/>እን ዹጉማን ክዮ አደምሳ ጀላ፣</para>
  <para style="q2" vid="PSA 91:3">ዹኩበ ነመ ፍጡ ጀላስ ስ ባሰ።<verse eid="PSA 91:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 91:4"/>እን ባሌሳቲን ስ ዾክሰ፤</para>
  <para style="q2" vid="PSA 91:4">አትስ ቆቾሳ ጀለት ኮሉ ንገልተ፤</para>
  <para style="q2" vid="PSA 91:4">አመነሙማንሳ ጋቸናፊ ደላ ኤጉምሳ ሲፍ ተአ።<verse eid="PSA 91:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 91:5"/>አትስ ናሱ ሀልከኒ፣</para>
  <para style="q2" vid="PSA 91:5">ዮካን ጥየ ጉያን ፉታፈሙ ህንሶዳቱ፤<verse eid="PSA 91:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 91:6"/>ጎልፋ ዱከነ ኬሰ ዴሙ፣</para>
  <para style="q2" vid="PSA 91:6">ዮካን ዸእቸ ጉያ ሳፋን ነመ በሌሱ ህንሶዳትኑ።<verse eid="PSA 91:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 91:7"/>ኩምን ቶኮ ስ ጭነት፣</para>
  <para style="q2" vid="PSA 91:7">ኩምን ኩዸንሞ ምርገኬት ንኩፈ፤</para>
  <para style="q2" vid="PSA 91:7">ገሩ ስት ህንዽኣቱ።<verse eid="PSA 91:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 91:8"/>አት እጁመኬ ቆፋን እላልተ፤</para>
  <para style="q2" vid="PSA 91:8">አደበ ሀሞተት ዹፉስ ንአርግተ።<verse eid="PSA 91:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 91:9"/>አት ዋን <char style="nd">ዋቀዮን</char> እዶ ኮሉ እት ገልቱ፣</para>
  <para style="q2" vid="PSA 91:9">ዋቀ ዋን ሁንዳ ኦሊ እዶ ጅሬኘኬቲ ጎዸቴፍ፣<verse eid="PSA 91:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 91:10"/>ወን ሀማን ስ ህንቱቁ፤</para>
  <para style="q2" vid="PSA 91:10">ዸእችስ ዱንካነኬት ህንዽኣቱ።<verse eid="PSA 91:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 91:11"/>እን አከ እሳን ከራኬ ሁንደረት ስ ኤገኒፍ፣</para>
  <para style="q2" vid="PSA 91:11">ኤርገሞተሳ ሲፍ ንአጀጀ፤<verse eid="PSA 91:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 91:12"/>እሳንስ አከ ሚለኬቲን ዸጋት ህንቡኔፍ</para>
  <para style="q2" vid="PSA 91:12">ሀርከሳኒቲን ኦል ስ ፉዹ።<verse eid="PSA 91:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 91:13"/>አት ሌንጫፊ ቡቲረ ኤጄተ፤</para>
  <para style="q2" vid="PSA 91:13">ሌንጨ ሳፌላፊ ጀዌ ንዽዺተ።<verse eid="PSA 91:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 91:14"/>
    <char style="nd">ዋቀዮስ</char> አከነ ጄዸ፤</para>
  <para style="q2" vid="PSA 91:14">“ሰበቢ እን ነ ጃለቱፍ፣ አን እሰ ነንኦልቸ፤</para>
  <para style="q2" vid="PSA 91:14">ዋን እን መቃኮ ቤኩፍ እሰ ነንኤገ።<verse eid="PSA 91:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 91:15"/>እን ነ ዋመተ፤ አንስ ነንዴብሳፍ፤</para>
  <para style="q2" vid="PSA 91:15">ረክነ ኬሰት አን እሰ ወጅን ነንተአ፤</para>
  <para style="q2" vid="PSA 91:15">እሰ ነንኦልቸ፤ ኡልፍነስ ነንኬናፍ።<verse eid="PSA 91:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 91:16"/>አን ኡሙሪ ዼራ እሰ ነንቁፍሰ፤</para>
  <para style="q2" vid="PSA 91:16">ፈይሱኮስ እሰት ነንአርግሲሰ።”<verse eid="PSA 91:16"/></para>
  <chapter eid="PSA 91"/>
  <chapter number="92" style="c" sid="PSA 92"/>
  <para style="cl">ፋርፈትና 92</para>
  <para style="ms1">ገመቹ ነመ ቀጄላ፣</para>
  <para style="d">ፋርፈትና ጉያ ሰንበታ ፋርፈተሙ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 92:1"/>
    <char style="nd">ዋቀዮን</char>፣ ገለቴፈቹን፣ ያ ዋቀ ዋን ሁንዳ ኦሊ፣</para>
  <para style="q2" vid="PSA 92:1">መቃኬቲፍ ፋርፈቹን ጋሪዸ።<verse eid="PSA 92:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 92:2"/>ጃለለኬ ገነማን፣</para>
  <para style="q2" vid="PSA 92:2">አመነሙማኬስ ሀልከኒን ለብሱን፣<verse eid="PSA 92:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 92:3"/>ክራረ ርቡ ኩዸኒቲን፣</para>
  <para style="q2" vid="PSA 92:3">ሰገሌ በገናቲንስ ለብሱን ጋሪዸ።<verse eid="PSA 92:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 92:4"/>ያ <char style="nd">ዋቀዮ</char>፣ አት ሆጂኬቲን ነ ገመቺፍታቲ፤</para>
  <para style="q2" vid="PSA 92:4">አን ሰበቢ ሆጂ ሀርከኬቲቲፍ ገመቹዻን ነንፋርፈዸ።<verse eid="PSA 92:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 92:5"/>ያ <char style="nd">ዋቀዮ</char>፣ ሆጂንኬ አከም ጉዳዸ፤</para>
  <para style="q2" vid="PSA 92:5">ያድንኬስ አከም ገድ ፈጎዸ!<verse eid="PSA 92:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 92:6"/>ነምን ቀልቢ ህንቀብኔ ዋን ከነ ቤኩ ህንደንደኡ፤</para>
  <para style="q2" vid="PSA 92:6">ጎዋንስ ህንሁበቱ፤<verse eid="PSA 92:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 92:7"/>ሀሞን ዮ አኩመ መርጋ ብቅለንዩ፣</para>
  <para style="q2" vid="PSA 92:7">ጀልኦትን ሁንድኑስ ዮ ደራረንዩ፣</para>
  <para style="q2" vid="PSA 92:7">እሳን በረ በራን ንበርበዳኡ።<verse eid="PSA 92:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 92:8"/>ያ <char style="nd">ዋቀዮ</char>፣ አት ገሩ በረ በራን ኦል ኦል ጄተ።<verse eid="PSA 92:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 92:9"/>ያ <char style="nd">ዋቀዮ</char>፣ ኩኖ ዲኖተኬ፣</para>
  <para style="q2" vid="PSA 92:9">ኩኖ ዲኖትንኬ ንበዱ፤</para>
  <para style="q2" vid="PSA 92:9">ወር ጀልእነ ሆጄተን ሁንድኑስ ንብትኔፈሙ።<verse eid="PSA 92:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 92:10"/>አት ጋንፈኮ አከ ጋንፈ ገፈርሳ ኦል ኦል ቀብዴ፤</para>
  <para style="q2" vid="PSA 92:10">ዘይቲ ሃራ ነት ዸንገላፍቴ።<verse eid="PSA 92:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 92:11"/>እጅኮ ሞአተሙ ዲኖተኮ አርጌረ፤</para>
  <para style="q2" vid="PSA 92:11">ጉርኮስ በዲሰ ጀልኦተ ነት ከአኒ ዸገኤረ።<verse eid="PSA 92:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 92:12"/>ቀጄልቶትን አኩመ ሙከ ሜጢ ንደጋጉ፤</para>
  <para style="q2" vid="PSA 92:12">አኩመ ብርብርሰ ልባኖንት ንጉደቱ፤<verse eid="PSA 92:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 92:13"/>እሳን መነ <char style="nd">ዋቀዮ</char> ኬሰ ዻበመኒ ጅሩ፤</para>
  <para style="q2" vid="PSA 92:13">ኦብዲ ዋቀኬኛ ኬሰትስ እት ቶሌ ምሰኒ ጅረን።<verse eid="PSA 92:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 92:14"/>እሳን አመዩ በረ ዱሉማ ኬሰ እጀ ነቀቱ፤</para>
  <para style="q2" vid="PSA 92:14">ገበተኒስ ደጋገኒ ጅራቱ።<verse eid="PSA 92:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 92:15"/>እሳንስ፣ “<char style="nd">ዋቀዮ</char> ቶላዸ፤ እን ከታኮት፤</para>
  <para style="q2" vid="PSA 92:15">ሀምን እሰ ኬሰ ህንጅሩ” ጄዸኒ ለብሱ።<verse eid="PSA 92:15"/></para>
  <chapter eid="PSA 92"/>
  <chapter number="93" style="c" sid="PSA 93"/>
  <para style="cl">ፋርፈትና 93</para>
  <para style="ms1">ሚዸግነ <char style="nd">ዋቀዮ</char></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 93:1"/>
    <char style="nd">ዋቀዮ</char> ንሞአ፤ ሱራስ ንኡፈተ፤</para>
  <para style="q2" vid="PSA 93:1">
    <char style="nd">ዋቀዮ</char> ሱረ ንኡፈተ፤ ጀብነስ ህዸተ።</para>
  <para style="q2" vid="PSA 93:1">አዱኛን ጭምቴ ዻበምቴርት፤ ህንሶቾፈምቱስ።<verse eid="PSA 93:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 93:2"/>ቴሶንኬ ዱሩማ ጀልቀቤ ጭሜ ዻበቴረ፤</para>
  <para style="q2" vid="PSA 93:2">አት ዱሪ ዱሪቲ ጀልቀብዴ ጅርተ።<verse eid="PSA 93:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 93:3"/>ያ <char style="nd">ዋቀዮ</char>፣ ገላኖትን ኦል ካሰኒሩ፤</para>
  <para style="q2" vid="PSA 93:3">ገላኖትን ሰገሌሳኒ ኦል ካፈተኒሩ፤</para>
  <para style="q2" vid="PSA 93:3">ገላኖትን ሁርሱሳኒ ኦል ካፈተኒሩ።<verse eid="PSA 93:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 93:4"/>ሰገሌ ብሻን ባይኤ ጫላ፣</para>
  <para style="q2" vid="PSA 93:4">ጀብነ ዸኣ ገላና ጫላስ፣</para>
  <para style="q2" vid="PSA 93:4">
    <char style="nd">ዋቀዮ</char> ኦል ጉባ ጅሩ ሱን ሁምነ ቀቤሰ።<verse eid="PSA 93:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 93:5"/>ሴርኬ ጀባቴ ንዻበተ፤</para>
  <para style="q2" vid="PSA 93:5">ያ <char style="nd">ዋቀዮ</char>፣ ቁልቁሉማን በረ በራን</para>
  <para style="q2" vid="PSA 93:5">ፋየ መነኬቲት።<verse eid="PSA 93:5"/></para>
  <chapter eid="PSA 93"/>
  <chapter number="94" style="c" sid="PSA 94"/>
  <para style="cl">ፋርፈትና 94</para>
  <para style="ms1">ዋቀ ሙርቲ ቀጄላ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 94:1"/>ያ <char style="nd">ዋቀዮ</char>፣ ዋቀ ሃሎ ባፍቱ፣</para>
  <para style="q2" vid="PSA 94:1">ያ ዋቀ ሃሎ ባፍቱ፣ እፊ ሙልአዹ።<verse eid="PSA 94:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 94:2"/>ያ አባ ሙርቲ ለፈ ከና ከእ፤</para>
  <para style="q2" vid="PSA 94:2">ኦፍ ቱልቶታፍሌ ዋንሳኒ መሉ ኬን።<verse eid="PSA 94:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 94:3"/>ያ <char style="nd">ዋቀዮ</char>፣ ሀመ ዮሚት ወር ሀሞን፣</para>
  <para style="q2" vid="PSA 94:3">ወር ሀሞን ሀመ ዮሚት ቡራቁ?<verse eid="PSA 94:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 94:4"/>እሳን ዱቢ ኦፍ ቱሉማ ገድ ሮብሱ፤</para>
  <para style="q2" vid="PSA 94:4">ጀልኦትን ሁንድኑ ኦፍ ዺቡዻን ጉተመን።<verse eid="PSA 94:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 94:5"/>ያ <char style="nd">ዋቀዮ</char>፣ እሳን ሰበኬ ሚዹ፤</para>
  <para style="q2" vid="PSA 94:5">ሀንዹራኬስ ንሀጩጩ።<verse eid="PSA 94:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 94:6"/>ሃዸ ህዬሳቲፊ ኬሱማ ንጎረኡ፤</para>
  <para style="q2" vid="PSA 94:6">እጆሌ አባ ህንቀብኔስ ንአጄሱ።<verse eid="PSA 94:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 94:7"/>እሳን፣ “<char style="nd">ዋቀዮ</char> ህንአርጉ፤</para>
  <para style="q2" vid="PSA 94:7">ዋቅን ያቆብ ህንቀልቤፈቱ” ጄዹ።<verse eid="PSA 94:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 94:8"/>ወር ሰበ ኬሳ ራቶፍተን ሜ ሁበዻ፤</para>
  <para style="q2" vid="PSA 94:8">እስን ወር ጎዎትን ዮም ኦጌዪ ታቱ?<verse eid="PSA 94:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 94:9"/>እን ጉረ ኡሜ ሱን ህንዸገኡ?</para>
  <para style="q2" vid="PSA 94:9">እን እጀ ኡሜ ህንአርጉ?<verse eid="PSA 94:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 94:10"/>እን ሰቦተ ስሬሱ ሱን ህንአደቡ?</para>
  <para style="q2" vid="PSA 94:10">እን ነመ በርሲሱ ሱን ቤኩምሰ ህንቀቡ?<verse eid="PSA 94:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 94:11"/>
    <char style="nd">ዋቀዮ</char> ያደ ነማ ቤከ፤</para>
  <para style="q2" vid="PSA 94:11">አከ ያድን ነማ ፋይዳ ህንቀብኔስ ንቤከ።<verse eid="PSA 94:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 94:12"/>ያ <char style="nd">ዋቀዮ</char>፣ ነምን አት አደብዱ፣</para>
  <para style="q2" vid="PSA 94:12">ነምን አት ሴረኬራ በርሲፍቱ ኤብፈማዸ፤<verse eid="PSA 94:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 94:13"/>ሀመ ሀሞታፍ ቦል ቆተሙት፣</para>
  <para style="q2" vid="PSA 94:13">ጉያ ረክናት አት ቦቆና ኬንታፍ።<verse eid="PSA 94:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 94:14"/>
    <char style="nd">ዋቀዮ</char> ሰበሳ ህንገቱቲ፤</para>
  <para style="q2" vid="PSA 94:14">እን አከነሌ ጄዼ ሀንዹራ ኦፊሳ ህንዺሱ።<verse eid="PSA 94:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 94:15"/>ሙርቲን ቀጄሉማረት ሁንዴፈመ፤</para>
  <para style="q2" vid="PSA 94:15">ቶሎን ሁንድኑስ እሰ ፋነ ቡኡ።<verse eid="PSA 94:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 94:16"/>ኤኙቱ ሀሞተት ና ከአ?</para>
  <para style="q2" vid="PSA 94:16">ኤኙቱ ነ ጭነ ዻበቴ ወረ ጀልእነ ሆጄተኒን ሞርመ?<verse eid="PSA 94:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 94:17"/>ኡቱ <char style="nd">ዋቀዮ</char> ነ ገርጋሩ ባቴ፣</para>
  <para style="q2" vid="PSA 94:17">ስላ ዮነ ሉቡንኮ ቦለ ዱኣ ኬሰ ጅርት።<verse eid="PSA 94:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 94:18"/>ያ <char style="nd">ዋቀዮ</char> ዬሮ አን፣ “ሚልኮ ሙጩጫቴረ” ጄዼት፣</para>
  <para style="q2" vid="PSA 94:18">አራርኬ ኦል ቀቤ ነ ዻቤ።<verse eid="PSA 94:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 94:19"/>ዮሙ ያዶን ነት ባይአቴት፣</para>
  <para style="q2" vid="PSA 94:19">ጀጀቤሱንኬ ሉቡኮ ገመቺሴ።<verse eid="PSA 94:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 94:20"/>ቡልችቶትን ሀሞን፣ ወር ሴረት ፈየደመኒ ጀልእነ ሆጄተን</para>
  <para style="q2" vid="PSA 94:20">ስ ወጅን ቶኩማ ቀባቹ ደንደኡ?<verse eid="PSA 94:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 94:21"/>እሳን ቶኩማዻን ነመ ቀጄላት ከአኒ</para>
  <para style="q2" vid="PSA 94:21">ነመ የከ ህንቀብኔት ዱአ ሙሩ።<verse eid="PSA 94:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 94:22"/>
    <char style="nd">ዋቀዮ</char> ገሩ ደኦ፣</para>
  <para style="q2" vid="PSA 94:22">ዋቅንኮስ፣ ከታ አን እት በቀዹ ና ተኤረ።<verse eid="PSA 94:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 94:23"/>እን ገቲ ጩቡሳኒ እሳኑመት ዴብሰ፤</para>
  <para style="q2" vid="PSA 94:23">ሰበቢ ሀምነሳኒቲፍሌ እሳን በሌሰ፤</para>
  <para style="q2" vid="PSA 94:23">
    <char style="nd">ዋቀዮ</char> ዋቅንኬኘ እሳን በርበዴሰ።<verse eid="PSA 94:23"/></para>
  <chapter eid="PSA 94"/>
  <chapter number="95" style="c" sid="PSA 95"/>
  <para style="cl">ፋርፈትና 95</para>
  <para style="ms1">ፋርፈትና ጉያ ጉያት ፋርፈተሙ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 95:1"/>ኮታ <char style="nd">ዋቀዮፍ</char> ፋርፈትና፤</para>
  <para style="q2" vid="PSA 95:1">ከታ ፈይነኬኛቲፍስ ንእልልችና።<verse eid="PSA 95:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 95:2"/>ገለታን ፉለሳ ዱረት ሃዽኣትኑ፤</para>
  <para style="q2" vid="PSA 95:2">ፋርፈትናዻንስ እሰ ሃሌልፍኑ።<verse eid="PSA 95:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 95:3"/>
    <char style="nd">ዋቀዮ</char> ዋቀ ጉዳዻቲ፤</para>
  <para style="q2" vid="PSA 95:3">እን ዋቆተ ሁንዳ ኦልት ሞቲ ጉዳዸ።<verse eid="PSA 95:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 95:4"/>ቅሌወን ለፋ ሀርከሳ ኬሰ ጅሩ፤</para>
  <para style="q2" vid="PSA 95:4">ፊጤወን ቱሉስ ከንሳት።<verse eid="PSA 95:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 95:5"/>ገላን ከንሳት፤ እሰቱ ሆጄቴቲ፤</para>
  <para style="q2" vid="PSA 95:5">ለፈ ጎጋሌ ሀርከሳቱ ኡሜ።<verse eid="PSA 95:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 95:6"/>ኮታ ገድ ጄኔ ሰገድና፤</para>
  <para style="q2" vid="PSA 95:6">ኡማኬኘ <char style="nd">ዋቀዮ</char> ዱረት ንጅልቤንፈትና፤<verse eid="PSA 95:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 95:7"/>እን ዋቀኬኛቲ፤</para>
  <para style="q2" vid="PSA 95:7">ኑሞ ሰበ ኤጉምሰሳ ጀለ ጅሩዸ፤</para>
  <para style="q2" vid="PSA 95:7">ቡሻዬ ሀርከሳ ኬሰ ጅሩዸስ።</para>
  <para style="b" vid="PSA 95:7"/>
  <para style="q1" vid="PSA 95:7">እስን ሀርአ ዮ ሰገሌሳ ዸጌሰን፣<verse eid="PSA 95:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 95:8"/>አከ መሪባት ጎተን ሰነ፣</para>
  <para style="q2" vid="PSA 95:8">አከ ጋፈ ገሞጂ ኬሰት ማሳት ጎተን ሰና <optbreak/> መታ ህንጀባትና፤<verse eid="PSA 95:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 95:9"/>አቦቲንኬሰን ኡቱመ ሆጂኮ አርገኑ፣</para>
  <para style="q2" vid="PSA 95:9">አችት ቆረኒ ነ እላለን።<verse eid="PSA 95:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 95:10"/>ዸሎተ ሰነት አን ወጋ አፉርተመ ነንዼከሜ፤</para>
  <para style="q2" vid="PSA 95:10">አንስ፣ “እሳን ሰበ ገራንሳኒ ከራራ ጀልአቴዸ፤</para>
  <para style="q2" vid="PSA 95:10">እሳን ከራኮ ህንቤክኔ” ነንጄዼን።<verse eid="PSA 95:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 95:11"/>ከናፉ አን ዼከምሰኮቲን፣</para>
  <para style="q2" vid="PSA 95:11">“እሳን ቦቆናኮት ህንገለን” ጄዼ ከከዼ።<verse eid="PSA 95:11"/></para>
  <chapter eid="PSA 95"/>
  <chapter number="96" style="c" sid="PSA 96"/>
  <para style="cl">ፋርፈትና 96</para>
  <para style="ms1">ዋቅን ሞቲፊ አባ ሙርቲት</para>
  <para style="mr">
    <ref loc="PSA 96:1-13">96፥1‑13</ref> ኩወፈ – <char style="xt"><ref loc="1CH 16:23-33">1ሴና 16፥23‑33</ref></char></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 96:1"/>ፋርፈትና ሃራ <char style="nd">ዋቀዮፍ</char> ፋርፈዻ፤</para>
  <para style="q2" vid="PSA 96:1">ለፍት ሁንድኑ <char style="nd">ዋቀዮን</char> ፋርፈዻ።<verse eid="PSA 96:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 96:2"/>
    <char style="nd">ዋቀዮን</char> ፋርፈዻ፤ መቃሳ ኤብሳ፤</para>
  <para style="q2" vid="PSA 96:2">ፈይሱሳስ ጉዩመ ጉያን ለብሳ።<verse eid="PSA 96:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 96:3"/>ኡልፍነሳ ሰቦተ ግዱት፣</para>
  <para style="q2" vid="PSA 96:3">ሆጂሳ ድንቅሲሳ ሰነሞ ነሞተ ሁንደ ኬሰት ለብሳ።<verse eid="PSA 96:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 96:4"/>
    <char style="nd">ዋቀዮ</char> ጉዳዻቲ ገለን ባይኤን እሳፍ ንመለ፤</para>
  <para style="q2" vid="PSA 96:4">እን ዋቆተ ሁንዳ ኦልትስ ሶዳተሙ ቀበ።<verse eid="PSA 96:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 96:5"/>ዋቆትን ሰቦተ ኦርማ ሁንድኑ ዋቆተ ቶልፈሞዻቲ፤</para>
  <para style="q2" vid="PSA 96:5">
    <char style="nd">ዋቀዮ</char> ገሩ ሰሚወን ኡሜ።<verse eid="PSA 96:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 96:6"/>ሚዸግኒፊ ሱራን ፉለሳ ዱረ ጅሩ፤</para>
  <para style="q2" vid="PSA 96:6">ጀብኒፊ ኡልፍን እዶ ቁልቁሉማሳ ኬሰ ጅሩ።<verse eid="PSA 96:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 96:7"/>ያ ማቲወን ሰቦታ <char style="nd">ዋቀዮፍ</char> ኬና፤</para>
  <para style="q2" vid="PSA 96:7">ኡልፍናፊ ጀብነ <char style="nd">ዋቀዮፍ</char> ኬና።<verse eid="PSA 96:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 96:8"/>ኡልፍነ መቃሳቲፍ መሉ <char style="nd">ዋቀዮፍ</char> ኬና፤</para>
  <para style="q2" vid="PSA 96:8">ኣርሳ ፍዳቲ ኦብዲሳ ሴና።<verse eid="PSA 96:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 96:9"/>በሬድነ ቁልቁሉማሳቲን <char style="nd">ዋቀዮን</char> ዋቄፈዻ፤</para>
  <para style="q2" vid="PSA 96:9">እስን ለፍት ሁንድኑ ፉለሳ ዱረት ሆለዻ።<verse eid="PSA 96:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 96:10"/>ሰቦተ ግዱት፣ “<char style="nd">ዋቀዮ</char> ሞቲዸ” ጄዻ፤</para>
  <para style="q2" vid="PSA 96:10">አዱኛን ጀባቴ ዻበቴርት፤ ሶቾፈሙስ ህንደንዴሱ።</para>
  <para style="q2" vid="PSA 96:10">እን ቀጄሉማዻን ሰቦታፍ ሙርቲ ኬነ።<verse eid="PSA 96:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 96:11"/>ሰሚወን ሃእልልቸን፤ ለፍትስ ሃገመዱ፤</para>
  <para style="q2" vid="PSA 96:11">ገላኒፊ ወን እሰ ኬሰ ጅሩ ሁንድኑ ሃሁርሱ።<verse eid="PSA 96:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 96:12"/>ድሬወኒፊ ወን እሳንረ ጅረን ሁንድኑ ሃገመደን።</para>
  <para style="q2" vid="PSA 96:12">ሙኬን ቦሶና ሁንድኑስ ገመቹዻን ሃፋርፈተን።<verse eid="PSA 96:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 96:13"/>ኡመምን ሁንድ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ሃፋርፈቱ፤ እን ንዹፋቲ፤</para>
  <para style="q2" vid="PSA 96:13">እን ለፈት ሙርቴሱፍ ንዹፈ።</para>
  <para style="q1" vid="PSA 96:13">አዱኛት ቀጄሉማዻን፣</para>
  <para style="q2" vid="PSA 96:13">ሰቦተትሞ ዹጋ እሳቲን ንሙረ።<verse eid="PSA 96:13"/></para>
  <chapter eid="PSA 96"/>
  <chapter number="97" style="c" sid="PSA 97"/>
  <para style="cl">ፋርፈትና 97</para>
  <para style="ms1">ሞአቹ <char style="nd">ዋቀዮ</char></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 97:1"/>
    <char style="nd">ዋቀዮ</char> ሞኤረ፤ ለፍት ሃገመዱ፤</para>
  <para style="q2" vid="PSA 97:1">ብዮን ቀርቀረ ገላና ሄዱንስ ሃእልልቸን።<verse eid="PSA 97:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 97:2"/>ዱሜሳፊ ዱከን ልምጢን እሰ መርሰኒሩ፤</para>
  <para style="q2" vid="PSA 97:2">ቀጄሉማፊ ሙርቲ ቀጄላን ሁንዴ ቴሶሳት።<verse eid="PSA 97:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 97:3"/>እብድ ፉለሳ ዱረ ዴሜ</para>
  <para style="q2" vid="PSA 97:3">ዲኖተሳ ናኖሳቲ ፍጠ።<verse eid="PSA 97:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 97:4"/>በለቄንሳ አዱኛ እብሰ፤</para>
  <para style="q2" vid="PSA 97:4">ለፍትስ አርግቴ ሆለት።<verse eid="PSA 97:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 97:5"/>ቱሉወን ፉለ <char style="nd">ዋቀዮ</char> ዱረት፣</para>
  <para style="q2" vid="PSA 97:5">ፉለ ጎፍታ ለፈ ሁንዱማ ዱረትስ አኩመ ገጋ በቁ።<verse eid="PSA 97:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 97:6"/>ሰሚወን ቀጄሉማሳ ለብሱ፤</para>
  <para style="q2" vid="PSA 97:6">ሰቦትን ሁንድኑስ ኡልፍነሳ አርጉ።<verse eid="PSA 97:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 97:7"/>ወር ፈኪ ዋቄፈተን፣</para>
  <para style="q2" vid="PSA 97:7">ከኔን ዋቆተ ቶልፈሞን ኦፍ ጀጀን ሁንድ ሃቃኔፈመን፤</para>
  <para style="q2" vid="PSA 97:7">እስን ዋቆትን ሁንድኑስ እሰ ዋቄፈዻ!<verse eid="PSA 97:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 97:8"/>ያ <char style="nd">ዋቀዮ</char>፣ ሰበቢ ሙርቲኬቲቲፍ፣</para>
  <para style="q2" vid="PSA 97:8">ጥዮን ዸጌሴ እልልችት፤</para>
  <para style="q2" vid="PSA 97:8">ገንዶትን ይሁዳስ ንገመዱ።<verse eid="PSA 97:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 97:9"/>ያ <char style="nd">ዋቀዮ</char>፣ አት ለፈ ሁንዱማረት ዋቀ ዋን ሁንዳ ኦሊት፤</para>
  <para style="q2" vid="PSA 97:9">አት ዋቆተ ሁንዱማረ አከ መሌ ኦል ኦል ጄቴርተ።<verse eid="PSA 97:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 97:10"/>ሰበቢ እን ሉቡ አመነሞተሳ ኤጌ፣</para>
  <para style="q2" vid="PSA 97:10">ሀርከ ሀሞታ ጀላ እሳን ባሱፍ፣</para>
  <para style="q2" vid="PSA 97:10">ወር <char style="nd">ዋቀዮን</char> ጃለተን ሀምነ ሃጅበን።<verse eid="PSA 97:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 97:11"/>ቀጄልቶተረት እፍን ንእፈ፤</para>
  <para style="q2" vid="PSA 97:11">ገረ ቶሎታፍስ ገመቹን ንዹፈ።<verse eid="PSA 97:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 97:12"/>እስን ቀጄልቶትን <char style="nd">ዋቀዮት</char> ገመዳ፤</para>
  <para style="q2" vid="PSA 97:12">መቃሳ ቁልቁሉስ ገለቴፈዻ።<verse eid="PSA 97:12"/></para>
  <chapter eid="PSA 97"/>
  <chapter number="98" style="c" sid="PSA 98"/>
  <para style="cl">ፋርፈትና 98</para>
  <para style="ms1">አባ ሙርቲ አዱኛ ሁንዳ</para>
  <para style="d">ፋርፈትና።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 98:1"/>
    <char style="nd">ዋቀዮፍ</char> ፋርፈትና ሃራ ፋርፈዻ፤</para>
  <para style="q2" vid="PSA 98:1">እን ድንቂ ሆጄቴረቲ፤</para>
  <para style="q1" vid="PSA 98:1">ሀርክሳ እን ምርጋቲፊ እሬንሳ ቁልቁሉን፣</para>
  <para style="q2" vid="PSA 98:1">አከ እን ሞአትና አርገቱ ጎዸኒሩ።<verse eid="PSA 98:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 98:2"/>
    <char style="nd">ዋቀዮ</char> አከ ፈይሱንሳ ቤከሙ ጎዼረ፤</para>
  <para style="q2" vid="PSA 98:2">ቀጄሉማሳስ ሰቦተት ሙልእሴረ።<verse eid="PSA 98:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 98:3"/>እን ጃለለሳቲፊ አመነሙማሳ</para>
  <para style="q2" vid="PSA 98:3">መነ እስራኤሊፍ ያደቴረ፤</para>
  <para style="q1" vid="PSA 98:3">ዳሪን ለፋ ሁንድኑ፣</para>
  <para style="q2" vid="PSA 98:3">ፈይሱ ዋቀኬኛ አርገኒሩ።<verse eid="PSA 98:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 98:4"/>ለፍት ሁንድኑ <char style="nd">ዋቀዮፍ</char> እልልቻ፤</para>
  <para style="q2" vid="PSA 98:4">ፋርፈትና ገመቹቲን እያ፤ ዌዱ ገለታስ ዌድሳ፤<verse eid="PSA 98:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 98:5"/>በገናዻን ፋርፈትና ገለታ፣</para>
  <para style="q2" vid="PSA 98:5">በገናፊ ሰገሌ ዌዱቲን <char style="nd">ዋቀዮፍ</char> ፋርፈዻ፤<verse eid="PSA 98:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 98:6"/>መለከታፊ ሰገሌ ጋንፋቲን፣</para>
  <para style="q2" vid="PSA 98:6">ፉለ <char style="nd">ዋቀዮ</char> ሞትቻ ዱረት እልልቻ።<verse eid="PSA 98:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 98:7"/>ገላኒፊ ወን እሰ ኬሰ ጅሩ ሁንድኑ፣</para>
  <para style="q2" vid="PSA 98:7">አዱኛፊ ወንት እሼ ኬሰ ጅራቱ ሁንድኑ ሃሁርሰን።<verse eid="PSA 98:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 98:8"/>ለጌን ሀርከሳኒ ሃሩሩኩተን፤</para>
  <para style="q2" vid="PSA 98:8">ቱሉወንስ ቶኩማዻን ሃእልልቸን፤<verse eid="PSA 98:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 98:9"/>እሳን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ሃፋርፈተን፤</para>
  <para style="q2" vid="PSA 98:9">እን ለፈት ሙርቴሱ ንዹፋቲ።</para>
  <para style="q1" vid="PSA 98:9">እን አዱኛፍ ቀጄሉማዻን፣</para>
  <para style="q2" vid="PSA 98:9">ነሞታፍሞ ኡቱ ወል ህንጫልችስን ሙርቲ ኬነ።<verse eid="PSA 98:9"/></para>
  <chapter eid="PSA 98"/>
  <chapter number="99" style="c" sid="PSA 99"/>
  <para style="cl">ፋርፈትና 99</para>
  <para style="ms1">ዋቀ ቀጄላ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 99:1"/>
    <char style="nd">ዋቀዮ</char> ሞኤረ፤</para>
  <para style="q2" vid="PSA 99:1">ሰቦትን ሃሆለተን፤</para>
  <para style="q1" vid="PSA 99:1">እን ኪሩቤል ግዱ፣ ቴሶሳረ ታአ፤</para>
  <para style="q2" vid="PSA 99:1">ለፍት ሃራፈምቱ።<verse eid="PSA 99:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 99:2"/>
    <char style="nd">ዋቀዮ</char> ጥዮን ኬሰት ጉዳዸ፤</para>
  <para style="q2" vid="PSA 99:2">እን ሰቦተ ሁንደረ ኦል ኦል ጄዼረ።<verse eid="PSA 99:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 99:3"/>እሳን መቃኬ ጉድቻፊ ሶዳችሳ ሰነ ሃጀጀን፤</para>
  <para style="q2" vid="PSA 99:3">እን ቁልቁሉዸ።<verse eid="PSA 99:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 99:4"/>ሞትች ሁምነ ቀቤሰ፤ እን ሙርቲ ቀጄላ ጃለተ፤</para>
  <para style="q2" vid="PSA 99:4">አት ቶለ ሁንዴስቴርተ፤</para>
  <para style="q1" vid="PSA 99:4">ያቆብ ኬሰትስ ሀቃፊ</para>
  <para style="q2" vid="PSA 99:4">ቀጄሉማ ሆጄቴርተ።<verse eid="PSA 99:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 99:5"/>
    <char style="nd">ዋቀዮ</char> ዋቀኬኘ ሌልሳ፤</para>
  <para style="q2" vid="PSA 99:5">ኤጄተ ሚለሳ ጀለት ሰገዳ፤</para>
  <para style="q2" vid="PSA 99:5">እን ቁልቁሉዸ።<verse eid="PSA 99:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 99:6"/>ሙሴፊ አሮን ሉቦተሳ ኬሰ ቱረን፤</para>
  <para style="q2" vid="PSA 99:6">ሳሙኤልስ ወረ መቃሳ ዋመተን ኬሰ ቱሬ፤</para>
  <para style="q1" vid="PSA 99:6">እሳን <char style="nd">ዋቀዮን</char> ዋመተን፤</para>
  <para style="q2" vid="PSA 99:6">እንስ ዴቢ ኬኔፍ።<verse eid="PSA 99:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 99:7"/>እን ኡቱባ ዱሜሳ ኬሳ እሳንት ዱበቴ፤</para>
  <para style="q2" vid="PSA 99:7">እሳንስ ስርነሳቲፊ ሴረ እን እሳኒፍ ኬኔ ኤገን።<verse eid="PSA 99:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 99:8"/>ያ <char style="nd">ዋቀዮ</char> ዋቀኬኘ፣</para>
  <para style="q2" vid="PSA 99:8">አት ዴቢሳኒ ኬንቴ፤</para>
  <para style="q1" vid="PSA 99:8">አት በሌሳሳኒ አደብዱሌ፣</para>
  <para style="q2" vid="PSA 99:8">እስራኤሊፍ ዋቀ ዺፈመ ጎቱ ቱርቴ።<verse eid="PSA 99:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 99:9"/>ዋቀኬኘ <char style="nd">ዋቀዮን</char> ሌልሳ፤</para>
  <para style="q2" vid="PSA 99:9">ቱሉሳ ቁልቁሉረትስ ዋቄፈዻ፤</para>
  <para style="q2" vid="PSA 99:9">
    <char style="nd">ዋቀዮ</char> ዋቅንኬኘ ዋቀ ቁልቁሉዻቲ።<verse eid="PSA 99:9"/></para>
  <chapter eid="PSA 99"/>
  <chapter number="100" style="c" sid="PSA 100"/>
  <para style="cl">ፋርፈትና 100</para>
  <para style="ms1">ጎርሰ ገለተ ገልቹ</para>
  <para style="d">ፋርፈትና ገለታ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 100:1"/>ለፍት ሁንድኑ <char style="nd">ዋቀዮፍ</char> እልልቻ።<verse eid="PSA 100:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 100:2"/>ገመቹዻን <char style="nd">ዋቀዮን</char> ዋቄፈዻ፤</para>
  <para style="q2" vid="PSA 100:2">ፋርፈትና ገመቹቲንስ ፉለሳ ዱረት ዽኣዻ።<verse eid="PSA 100:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 100:3"/>አከ <char style="nd">ዋቀዮ</char> ዋቀ ተኤ ቤካ፤</para>
  <para style="q2" vid="PSA 100:3">እሰቱ ኑ ኡሜ፤ ኑ ከንሳት፤</para>
  <para style="q2" vid="PSA 100:3">ኑ ሰበሳት፤ ሆሎተ ትከሳ ጀለ ጅሩዸ።<verse eid="PSA 100:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 100:4"/>ገለቴፈቹዻን ከረወንሳ፣</para>
  <para style="q2" vid="PSA 100:4">ጀጀቹዻንስ ኦብዲሳ ሴና፤</para>
  <para style="q2" vid="PSA 100:4">እሰ ገለቴፈዻ፤ መቃሳሌ ኤብሳ።<verse eid="PSA 100:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 100:5"/>
    <char style="nd">ዋቀዮ</char> ጋሪዻቲ፤ አራርሳ ከን በረ በራት፤</para>
  <para style="q2" vid="PSA 100:5">አመነሙማንሳስ ዸሎታ ገረ ዸሎታት እት ፉፈ።<verse eid="PSA 100:5"/></para>
  <chapter eid="PSA 100"/>
  <chapter number="101" style="c" sid="PSA 101"/>
  <para style="cl">ፋርፈትና 101</para>
  <para style="ms1">ቡልቺንሰ ቀጄላ</para>
  <para style="d">ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 101:1"/>አን ጃለለኬቲፊ ሙርቲኬ ቀጄላ ሰናፍ ነንፋርፈዸ፤</para>
  <para style="q2" vid="PSA 101:1">ያ <char style="nd">ዋቀዮ</char> አን ሲፍ ነንፋርፈዸ።<verse eid="PSA 101:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 101:2"/>አን ጅሬኘ ህርእነ ህንቀብኔ ጅራቹፍ ኦፍ ነንኤገዸ፤</para>
  <para style="q2" vid="PSA 101:2">አት ዮም ገረኮ ዹፍተ?</para>
  <para style="b" vid="PSA 101:2"/>
  <para style="q1" vid="PSA 101:2">አን ገራ ቁልቁሉዻን፣</para>
  <para style="q2" vid="PSA 101:2">መነኮ ነንጅራዸ።<verse eid="PSA 101:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 101:3"/>አን እጀኮ ዱረ፣</para>
  <para style="q2" vid="PSA 101:3">ዋን ሀማ ህንካኡ።</para>
  <para style="b" vid="PSA 101:3"/>
  <para style="q1" vid="PSA 101:3">ሆጂ ጀልኦታ ነንጅበ፤</para>
  <para style="q2" vid="PSA 101:3">ነትስ ህንቀበቱ።<verse eid="PSA 101:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 101:4"/>ነሞትን ያደ ምጪረማ ቀበን ነራ ሃፈጋተን፤</para>
  <para style="q2" vid="PSA 101:4">አን ጀልእነ ወጅን ቶኩማ ህንቀባዹ።<verse eid="PSA 101:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 101:5"/>ነመ ዾክሳን ኦላሳ ሀመቱ ከምዩ፣</para>
  <para style="q2" vid="PSA 101:5">አን አፋን ነንቀበቺሰ፤</para>
  <para style="q1" vid="PSA 101:5">ነመ ቱፊን ነመ እላሉፊ ከን ገራ ኦፍ ቱሉ ቀቡፍ፣</para>
  <para style="q2" vid="PSA 101:5">አን ኦብሰ ህንቀባዹ።<verse eid="PSA 101:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 101:6"/>አከ እሳን ነ ወጅን ጅራተኒፍ፣</para>
  <para style="q2" vid="PSA 101:6">እጅኮ አመነሞተ ብየቲረ ጅራት፤</para>
  <para style="q2" vid="PSA 101:6">ነምን ከራ ቀጄላረ ዴሙ፣ እን ነ ተጃጅለ።<verse eid="PSA 101:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 101:7"/>ነምን ነመ ጎዎምሱ ቶኮዩ</para>
  <para style="q2" vid="PSA 101:7">መነኮ ኬሰ ህንጅራቱ፤</para>
  <para style="q1" vid="PSA 101:7">ነምን ሶበ ዱበቱ ቶኮዩ</para>
  <para style="q2" vid="PSA 101:7">ፉለኮ ዱረ ህንዻበቱ።<verse eid="PSA 101:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 101:8"/>አን ጀልኦተ ብየቲ ሁንደ፣</para>
  <para style="q2" vid="PSA 101:8">ገነመ ገነመ ነንበርበዴሰ፤</para>
  <para style="q1" vid="PSA 101:8">ወረ ዋን ሀማ ሆጄተን</para>
  <para style="q2" vid="PSA 101:8">መጋላ <char style="nd">ዋቀዮ</char> ኬሳ ነንበሌሰ።<verse eid="PSA 101:8"/></para>
  <chapter eid="PSA 101"/>
  <chapter number="102" style="c" sid="PSA 102"/>
  <para style="cl">ፋርፈትና 102</para>
  <para style="ms1">ከዸትና ዬሮ ረክና</para>
  <para style="d">ከዸትና ነምን ዽጰቴ ቶኮ ፋሩ ቦእቻ ፋርሴ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዽኤፈቱ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 102:1"/>ያ <char style="nd">ዋቀዮ</char>፣ ከዸትናኮ ና ዸገእ፤</para>
  <para style="q2" vid="PSA 102:1">እይ አን ገርጋርሳፍ እየዹስ ስ ብረ ሃገኡ።<verse eid="PSA 102:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 102:2"/>ዬሮ አን ዽጰዼት፣</para>
  <para style="q2" vid="PSA 102:2">ፉለኬ ነ ዱራ ህንዾክስን።</para>
  <para style="q1" vid="PSA 102:2">ጉረኬ ገረኮት ዴብስ፤</para>
  <para style="q2" vid="PSA 102:2">ዮሙ አን ስ ዋመዹ ደፊቲ ዴቢ ና ኬን።<verse eid="PSA 102:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 102:3"/>በርኮ አኩመ ኣራት ንበዳቲ፤</para>
  <para style="q2" vid="PSA 102:3">ለፌንኮስ አኩመ በርበዳ እብዳ ቦበኣ ጅረ።<verse eid="PSA 102:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 102:4"/>ገራንኮ ዹኩብሰቴ አኩመ መርጋ ጮለጌረ፤</para>
  <para style="q2" vid="PSA 102:4">አን ኛተኮ ኛቹ እራንፈዼረ።<verse eid="PSA 102:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 102:5"/>ሰበቢ አን ጉድሴ ኣዱፍ፣</para>
  <para style="q2" vid="PSA 102:5">ለፌንኮ ጎጋኮት መጠኔረ።<verse eid="PSA 102:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 102:6"/>አን አከ ኡሩንጉ ገሞጂ፣</para>
  <para style="q2" vid="PSA 102:6">አከ ኡሩንጉ ለፈ በርበዳኤ ኬሳ ነንተኤ።<verse eid="PSA 102:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 102:7"/>አን ህርበ መሌ ነንቡለ፤</para>
  <para style="q2" vid="PSA 102:7">አከ ስምብሮ ኮጳሼ ጉቱ መናረ ጅርቱስ ተኤረ።<verse eid="PSA 102:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 102:8"/>ዲኖትንኮ ጉያ ጉቱ ነ አረብሱ፤</para>
  <para style="q2" vid="PSA 102:8">ወር ነት ቆሰንስ አባርሳፍ መቃኮት ፈየደሙ።<verse eid="PSA 102:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 102:9"/>አን አኩመ ቡዴናት ዳራ ኛዼራቲ፤</para>
  <para style="q2" vid="PSA 102:9">ዹጋቲኮትስ እምማን መከዼረ፤<verse eid="PSA 102:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 102:10"/>ኩንስ ሰበቢ ኣሪፊ ዼከምሰኬቲቲፍ ነት ዹፌ፤</para>
  <para style="q2" vid="PSA 102:10">አት ኦል ነ ፉቴ ገድ ነ ደርበቴርታቲ።<verse eid="PSA 102:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 102:11"/>በርኮ አኩመ ጋድዱ ገልገላት፤</para>
  <para style="q2" vid="PSA 102:11">አንስ አኩመ መርጋ ጎጌረ።<verse eid="PSA 102:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 102:12"/>ያ <char style="nd">ዋቀዮ</char>፣ አት በረ በራን ቴሶረ ጅርተ፤</para>
  <para style="q2" vid="PSA 102:12">ያደኖንኬስ ዸሎተ ሁንደት ደርበ።<verse eid="PSA 102:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 102:13"/>አት ካቴ ጥዮኒፍ ገራ ንላፍተ፤</para>
  <para style="q2" vid="PSA 102:13">ዬሮን እት እሼን ፉዸተመ አርገቹ ቀብዱ አሙማቲ፤</para>
  <para style="q2" vid="PSA 102:13">ዬሮን ሙርቴፈሜ ሱን ገኤራ።<verse eid="PSA 102:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 102:14"/>ገርቦንኬ ዸጋሼት ገመዱቲ፤</para>
  <para style="q2" vid="PSA 102:14">ብዮሼስ ንመረርፈቱ።<verse eid="PSA 102:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 102:15"/>ሰቦትን መቃ <char style="nd">ዋቀዮ</char> ንሶዳቱ፤</para>
  <para style="q2" vid="PSA 102:15">ሞቶትን ለፋ ሁንድኑስ ኡልፍነኬ ንከበጁ።<verse eid="PSA 102:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 102:16"/>
    <char style="nd">ዋቀዮ</char> ዴብሴ ጥዮንን እጃራቲ፤</para>
  <para style="q2" vid="PSA 102:16">ኡልፍነሳቲንስ ንሙልአተ።<verse eid="PSA 102:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 102:17"/>እን ከዸትና ገደደምቶታ ንዸገአ፤</para>
  <para style="q2" vid="PSA 102:17">ዋመተሳኒስ ህንቱፈቱ።<verse eid="PSA 102:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 102:18"/>አከ ሰብን ሀመ አማት ህንዸለትን <char style="nd">ዋቀዮን</char> ገለቴፈቱፍ፣</para>
  <para style="q2" vid="PSA 102:18">ወን ኩን አከነ ጄዸሜ ዸሎተ ዹፉፍ ሃበሬፈሙ፦<verse eid="PSA 102:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 102:19"/>“<char style="nd">ዋቀዮ</char> እዶ ቁልቁሉማሳ ጉባራ ገድ እላሌ፤</para>
  <para style="q2" vid="PSA 102:19">ሰሚራስ ገረ ለፋ ገድ ምልአቴ፤<verse eid="PSA 102:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 102:20"/>ከነስ ኣዱ ወረ ህዸመኒ ዸገኡፊ</para>
  <para style="q2" vid="PSA 102:20">ወረ ዱት እት ሙረሜ ባሱዻፍ ሆጄቴ።”<verse eid="PSA 102:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 102:21"/>አከሲን መቃን <char style="nd">ዋቀዮ</char> ጥዮን ኬሰት፣</para>
  <para style="q2" vid="PSA 102:21">ገለንሳስ ዬሩሳሌም ኬሰት ንለብሰመ፤<verse eid="PSA 102:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 102:22"/>ኩንስ ዮሙ ሰቦትኒፊ ሞቱሞን፣</para>
  <para style="q2" vid="PSA 102:22">
    <char style="nd">ዋቀዮን</char> ዋቄፈቹፍ ወልት ቀበመንት ተአ።<verse eid="PSA 102:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 102:23"/>እን ጀብነኮ ከራት ሀምብሴ፤</para>
  <para style="q2" vid="PSA 102:23">ኡሙሪኮስ ንገባብሴ።<verse eid="PSA 102:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 102:24"/>አንስ አከነን ጄዼ፦</para>
  <para style="q2" vid="PSA 102:24">“ያ ዋቀኮ፣ ወለካ ኡሙሪኮት ነ ህንፉዸትን፤</para>
  <para style="q2" vid="PSA 102:24">ወጎትንኬ ዸሎታ ሀመ ዸሎተ ሁንዳት እት ፉፉ።<verse eid="PSA 102:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 102:25"/>አት ጀልቀበት ለፈ ሁንዴስቴ፤</para>
  <para style="q2" vid="PSA 102:25">ሰሚወንስ ሆጂ ሀርከኬቲት።<verse eid="PSA 102:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 102:26"/>እሳን ንበዱ፤ አት ገሩ ንጅራተ፤</para>
  <para style="q2" vid="PSA 102:26">ሁንዱምትሳኒ አኩመ ወያ ንዹሙ።</para>
  <para style="q1" vid="PSA 102:26">አት አኩመ ኡፈታ እሳን ጌደርተ፤</para>
  <para style="q2" vid="PSA 102:26">እሳንስ ንበዱ።<verse eid="PSA 102:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 102:27"/>አት ገሩ ሰኑመ፤</para>
  <para style="q2" vid="PSA 102:27">ኡሙሪንኬስ ጎንኩማ ዹመ ህንቀቡ።<verse eid="PSA 102:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 102:28"/>እጆሌን ገርቦተኬቲ ሶዳ መሌ ጅራቱ፤</para>
  <para style="q2" vid="PSA 102:28">ሰኚንሳኒስ ፉለኬ ዱረ ጅራተ።”<verse eid="PSA 102:28"/></para>
  <chapter eid="PSA 102"/>
  <chapter number="103" style="c" sid="PSA 103"/>
  <para style="cl">ፋርፈትና 103</para>
  <para style="ms1">ዋቅን ጃለለ</para>
  <para style="d">ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 103:1"/>ያ ሉቡኮ፣ <char style="nd">ዋቀዮን</char> ኤብስ፤</para>
  <para style="q2" vid="PSA 103:1">ኬስ ነሙማኮ ሁንድ መቃሳ ቁልቁሉ ሰነ ኤብሳ።<verse eid="PSA 103:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 103:2"/>ያ ሉቡኮ <char style="nd">ዋቀዮን</char> ኤብስ፤</para>
  <para style="q2" vid="PSA 103:2">ቶለሳ ሁንደስ ህንእራንፈትን።<verse eid="PSA 103:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 103:3"/>እን ጩቡኬ ሁንዱማ ሲፍ ዺሰ፤</para>
  <para style="q2" vid="PSA 103:3">ዹኩበኬ ሁንዱማ ንፈይሰ፤<verse eid="PSA 103:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 103:4"/>ጅሬኘኬ ቦለራ ንበራረ፤</para>
  <para style="q2" vid="PSA 103:4">ጃለላፊ ገረ ላፍናን ስ ጎንፈ፤<verse eid="PSA 103:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 103:5"/>አከ ደርገጉማንኬ አኩመ ርሳ ሃሮምፈሙፍስ፣</para>
  <para style="q2" vid="PSA 103:5">እን ፌዺኬ ዋን ጋሪዻን ንጉተ።<verse eid="PSA 103:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 103:6"/>
    <char style="nd">ዋቀዮ</char> ወረ ጩንቁርፈመን</para>
  <para style="q2" vid="PSA 103:6">ሁንዳፍ ቀጄሉማፊ ሙርቲ ቀጄላ ኬነ።<verse eid="PSA 103:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 103:7"/>እን ከራሳ ሙሴት፣</para>
  <para style="q2" vid="PSA 103:7">ሆጂሳሞ ሰበ እስራኤልት ቤክስሴ።<verse eid="PSA 103:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 103:8"/>
    <char style="nd">ዋቀዮ</char> ገረ ላፌሳፊ አርጃዸ፤</para>
  <para style="q2" vid="PSA 103:8">እን ኣሩፍ ህንአሪፈቱ፤ ጃለልሳስ ባይኤዸ።<verse eid="PSA 103:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 103:9"/>እን ዬሮ ሁንደ ህንዼከሙ፤</para>
  <para style="q2" vid="PSA 103:9">ኣሪሳሌ በረ በራን ህንኩፈቱ፤<verse eid="PSA 103:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 103:10"/>እን አከ ጩቡኬኛት ኑ ህንአደብኔ፤</para>
  <para style="q2" vid="PSA 103:10">ዮካን አከ በሌሳኬኛት ኑፍ ህንዴብፍኔ።<verse eid="PSA 103:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 103:11"/>አኩመ ሰሚወን ለፈራ ኦል ፈጋተን ሰነ፣</para>
  <para style="q2" vid="PSA 103:11">ጃለል እን ወረ እሰ ሶዳተኒፍ ቀቡ አከሱመ ጉዳዸ፤<verse eid="PSA 103:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 103:12"/>አኩመ በእ ቢፍቱ ልጠ ቢፍቱራ ፈጋቱ፣</para>
  <para style="q2" vid="PSA 103:12">አከሱመ እን በሌሳኬኘ ኑራ ሀቄረ።<verse eid="PSA 103:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 103:13"/>አኩመ አባን እጆሌሳቲፍ ገራ ላፉ፣</para>
  <para style="q2" vid="PSA 103:13">
    <char style="nd">ዋቀዮ</char> ወረ እሰ ሶዳተኒፍ ገራ ንላፈ፤<verse eid="PSA 103:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 103:14"/>እን አከ ኑ እት ኡመምኔ ንቤካቲ፤</para>
  <para style="q2" vid="PSA 103:14">አከ ኑ ብዮ ታኔስ ንያደተ።<verse eid="PSA 103:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 103:15"/>በር ነማ አኩመ መርጋት፤</para>
  <para style="q2" vid="PSA 103:15">አከ አባቦ ድሬስ ንምሰ፤<verse eid="PSA 103:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 103:16"/>እን ዬሮ ቡቤን እት ቡብሱት ንበደ፤</para>
  <para style="q2" vid="PSA 103:16">እዶንሳስ ዴብኤ እሰ ህንያደቱ።<verse eid="PSA 103:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 103:17"/>ጃለል <char style="nd">ዋቀዮ</char> ገሩ በረ በራ ሀመ በረ በራት</para>
  <para style="q2" vid="PSA 103:17">ወረ እሰ ሶዳተን ወጅን ንጅራተ፤</para>
  <para style="q2" vid="PSA 103:17">ቀጄሉማንሳሞ እጆሌ እጆሌሳኒት ደርበ፤<verse eid="PSA 103:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 103:18"/>ወረ ከኩሳ ኤገንት፣</para>
  <para style="q2" vid="PSA 103:18">ወረ አጀጀሳት ቡሉ ያደተንትስ ንደርበ።<verse eid="PSA 103:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 103:19"/>
    <char style="nd">ዋቀዮ</char> ቴሶሳ ሰሚ ኬሰ ዻበቴረ፤</para>
  <para style="q2" vid="PSA 103:19">ሞቱማንሳስ ዋን ሁንደ ቡልቸ።<verse eid="PSA 103:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 103:20"/>እስን ኤርገሞትንሳ፣ ወር አጀጀሳ ኤግደን ጀጀቦን፣</para>
  <para style="q2" vid="PSA 103:20">ወር ዱቢሳቲፍ አጀጀምተንስ <char style="nd">ዋቀዮን</char> ኤብሳ።<verse eid="PSA 103:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 103:21"/>ራያንሳ ሁንድኑ፣ እስን ተጃጅልቶትንሳ</para>
  <para style="q2" vid="PSA 103:21">ወር ፌዺሳ ጉተን <char style="nd">ዋቀዮን</char> ኤብሳ።<verse eid="PSA 103:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 103:22"/>ኡመመወን ቡልቺንሰሳ</para>
  <para style="q2" vid="PSA 103:22">ጀለ ለፈ ሁንደ ጅርተን ሁንድ <char style="nd">ዋቀዮን</char> ኤብሳ።</para>
  <para style="b" vid="PSA 103:22"/>
  <para style="q1" vid="PSA 103:22">ያ ሉቡኮ፣ <char style="nd">ዋቀዮን</char> ኤብስ።<verse eid="PSA 103:22"/></para>
  <chapter eid="PSA 103"/>
  <chapter number="104" style="c" sid="PSA 104"/>
  <para style="cl">ፋርፈትና 104</para>
  <para style="ms1">ኡልፍነ ኡመማ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 104:1"/>ያ ሉቡኮ፣ <char style="nd">ዋቀዮን</char> ኤብስ።</para>
  <para style="b" vid="PSA 104:1"/>
  <para style="q1" vid="PSA 104:1">ያ <char style="nd">ዋቀዮ</char>፣ ዋቀኮ፣ አት አከ መሌ ጉዳዸ፤</para>
  <para style="q2" vid="PSA 104:1">ሚዸግናፊ ሱራ ኡፈቴርተ።<verse eid="PSA 104:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 104:2"/>አት አኩመ ወያ እፈ ኡፈተ፤</para>
  <para style="q2" vid="PSA 104:2">ሰሚወንስ አኩመ ዱንካና ድሪርስተ።<verse eid="PSA 104:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 104:3"/>ደሬራ ዲንቀሳ ብሻኖተረ ቡፍተ።</para>
  <para style="q1" vid="PSA 104:3">ዱሜሶተ ጋሪሳ ጎዸተ፤</para>
  <para style="q2" vid="PSA 104:3">ቆቾ ቡቤ ያበቴ ዴመ።<verse eid="PSA 104:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 104:4"/>እን ኤርገሞተሳ ሀፉሮተ፣</para>
  <para style="q2" vid="PSA 104:4">ተጃጅልቶተሳሞ አረበ እብዳ ጎዸ።<verse eid="PSA 104:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 104:5"/>እን ለፈ ሁንዴሼረ ዻቤረ፤</para>
  <para style="q2" vid="PSA 104:5">እሼንስ ጎንኩማ ህንሶቾቱ።<verse eid="PSA 104:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 104:6"/>አት አኩመ ወያት ቱጁባን እሼ ሀጉግዴ፤</para>
  <para style="q2" vid="PSA 104:6">ብሻኖትንስ ቱሉወኒ ኦል ዻበተን።<verse eid="PSA 104:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 104:7"/>አት እፈትናን ብሻኖትን በቀተን፤</para>
  <para style="q2" vid="PSA 104:7">ሰገሌ ቀቀዌኬቲ ዸጌኛን ጉገተን።<verse eid="PSA 104:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 104:8"/>እሳን ቱሉወን እራን ዸንገለአን፤</para>
  <para style="q2" vid="PSA 104:8">ገረ እዶ አት እሳኒ ቆጴስቴ፣</para>
  <para style="q2" vid="PSA 104:8">ገረ ሱሉሎታት ገድ ያአን።<verse eid="PSA 104:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 104:9"/>አከ እሳን ዴብአኒ ለፈ ህንሀጉግኔፍ</para>
  <para style="q2" vid="PSA 104:9">አት ዳሪ እሳን ደርቡ ህንደንዴኜ እሳን ዱረ ዻብዴ።<verse eid="PSA 104:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 104:10"/>አከ ቡርቃወን ሱሉሎተ ኬሰ ያአን ጎተ፤</para>
  <para style="q2" vid="PSA 104:10">እሳንስ ቱሉወን ግዱ ያኡ።<verse eid="PSA 104:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 104:11"/>እሳን ብኔንሶተ በኬ ሁንዳፍ ብሻን ኬኑ፤</para>
  <para style="q2" vid="PSA 104:11">ሀሮትን ዲዳስ ዼቡ በኡ።<verse eid="PSA 104:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 104:12"/>ስምብሮትን ሰሚ ብሻኖተ ብረት መንዼ እጃረተን፤</para>
  <para style="q2" vid="PSA 104:12">ደሜወን ግዱት ንፋርፈተን።<verse eid="PSA 104:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 104:13"/>እን መነሳ ከን ኦሊራ ቱሉወን ብሻን ኦባፍተ፤</para>
  <para style="q2" vid="PSA 104:13">ለፍትስ እጀ ሆጂኬቲቲን ቁፍት።<verse eid="PSA 104:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 104:14"/>እን ለፈራ ኛተ ኬኑፍ ጄዼ ሎኒፍ መርገ፣</para>
  <para style="q2" vid="PSA 104:14">ፋይዳ ነማቲፍሞ ብቅልቱወን ብቅልቸ፤<verse eid="PSA 104:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 104:15"/>አከ ዳዺን ወይኒ ገራ ነመ ገመቺሱ፣</para>
  <para style="q2" vid="PSA 104:15">አከ ዘይቲን ፉለ ነመ ጩሉሉቅሱፊ</para>
  <para style="q2" vid="PSA 104:15">አከ ምዻን ነመ ጀጀቤሱ ንጎተ።<verse eid="PSA 104:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 104:16"/>ሙኬን <char style="nd">ዋቀዮ</char>፣</para>
  <para style="q2" vid="PSA 104:16">ብርብርስ ልባኖን ከን እን ዻቤ ሱን ብሻን ቁፈኒሩ።<verse eid="PSA 104:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 104:17"/>ስምብሮትን አችት መንዼሳኒ እጃረቱ፤</para>
  <para style="q2" vid="PSA 104:17">ሁሞንስ ብርብርሰራ መነ ቀብድ።<verse eid="PSA 104:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 104:18"/>ቱሉወን ዼዼሮን ደኦ ሬኤ ዲዳት፤</para>
  <para style="q2" vid="PSA 104:18">ሆልቅ ከታወኒሞ ደኦ ኦሶሌት።<verse eid="PSA 104:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 104:19"/>እን አከ ጅእ ወቅቲሌ ገርገር ቆዱ ጎዸ፤</para>
  <para style="q2" vid="PSA 104:19">ቢፍቱንስ ዬሮ እት ልጡ ንቤክት።<verse eid="PSA 104:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 104:20"/>አት ዱከነ ኡምተ፤ ሀልከንስ ንተአ፤</para>
  <para style="q2" vid="PSA 104:20">ብኔንሶትን ቦሶና ሁንድስ ገድ ያኡ።<verse eid="PSA 104:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 104:21"/>ሌንጭ ሳፌል ዋን ኛቱ በርባዴ ኣደ፤</para>
  <para style="q2" vid="PSA 104:21">ኛተሳስ ዋቀ ብረ በርባደ።<verse eid="PSA 104:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 104:22"/>እሳን ዮሙ ቢፍቱን ባቱት ወልት ቀበሙ፤</para>
  <para style="q2" vid="PSA 104:22">ደቸአኒስ ጎደሳኒ ኬሰ ጭጪሱ።<verse eid="PSA 104:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 104:23"/>ነምን ገረ ሆጂሳት፣</para>
  <para style="q2" vid="PSA 104:23">ሀመ ገልገላትስ ገረ ጅሩሳት ንበአ።<verse eid="PSA 104:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 104:24"/>ያ <char style="nd">ዋቀዮ</char>፣ ሆጂንኬ አከም ባይኤዸ!</para>
  <para style="q2" vid="PSA 104:24">አት ሁንደሳኒ ኦጉማዻን ሆጄቴ፤</para>
  <para style="q2" vid="PSA 104:24">ለፍትስ ኡመመወንኬቲን ጉተምቴ።<verse eid="PSA 104:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 104:25"/>ገላን ጉዳፊ በልኣን ኩን፣</para>
  <para style="q2" vid="PSA 104:25">ኡመመወን ሀመ ህንቀብኔን ጉተሜ፤</para>
  <para style="q2" vid="PSA 104:25">ከን ሉቡ ቀቤዪን ጉርጉዳፊ <optbreak/> ጥጥኖን ኬሰ ጅራተን ኩኖ ጅረ።<verse eid="PSA 104:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 104:26"/>ዶኒወን አስረ ዴዴብኡ፤</para>
  <para style="q2" vid="PSA 104:26">ሌዋታን ከን አከ እን አች ኬሰ <optbreak/> ተጰቱፍ አት ኡምቴስ አች ጅረ።<verse eid="PSA 104:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 104:27"/>አከ አት ኛተሳኒ ዬሮ በርባችሱት እሳኒፍ ኬንቱፍ፣</para>
  <para style="q2" vid="PSA 104:27">እሳን ሁንድ ስ ኤገቱ።<verse eid="PSA 104:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 104:28"/>ዬሮ አት እሳኒፍ ኬንቱት፣</para>
  <para style="q2" vid="PSA 104:28">እሳን ወልት ቀበቱ፤</para>
  <para style="q1" vid="PSA 104:28">ዬሮ አት ሀርከኬ በልእፍቱት፣</para>
  <para style="q2" vid="PSA 104:28">እሳን ዋን ጋሪ ቁፉ።<verse eid="PSA 104:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 104:29"/>ዬሮ አት ፉለኬ ዾክፈቱት፣</para>
  <para style="q2" vid="PSA 104:29">እሳን ንነኡ፤</para>
  <para style="q1" vid="PSA 104:29">ዬሮ አት ሀፉረሳኒ ፉዸቱት፣</para>
  <para style="q2" vid="PSA 104:29">እሳን ዱአኒ ብዮት ዴብኡ።<verse eid="PSA 104:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 104:30"/>ዬሮ አት ሀፉረኬ ኤርግቱት እሳን ንኡመሙ፤</para>
  <para style="q2" vid="PSA 104:30">አትስ ፉለ ለፋ ንሃሮምስተ።<verse eid="PSA 104:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 104:31"/>ኡልፍን <char style="nd">ዋቀዮ</char> በረ በራን ሃጅራቱ፤</para>
  <para style="q2" vid="PSA 104:31">
    <char style="nd">ዋቀዮ</char> ሆጂሳት ሃገመዱ፤<verse eid="PSA 104:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 104:32"/>እን እላላን ለፍት ሆለቴ፤</para>
  <para style="q2" vid="PSA 104:32">እን ቱቅናን ቱሉወን ኬሳ ኣሪ በኤ።<verse eid="PSA 104:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 104:33"/>በረ ጅሬኘኮ ጉቱ አን <char style="nd">ዋቀዮፍ</char> ነንፋርፈዸ፤</para>
  <para style="q2" vid="PSA 104:33">ሀመ ሉቡንኮ ጅርቱትስ ፋርፈናዻን <optbreak/> ዋቀኮ ነንገለቴፈዸ።<verse eid="PSA 104:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 104:34"/>እረ ዴዴብኤ ያዱንኮ እሰ ሃገመቺሱ፤</para>
  <para style="q2" vid="PSA 104:34">አን <char style="nd">ዋቀዮት</char> ነንገመዳቲ።<verse eid="PSA 104:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 104:35"/>ጩበሞትን ለፈራ ሃበደን፤</para>
  <para style="q2" vid="PSA 104:35">ሀሞንስ ስአች ህንጅራትን።</para>
  <para style="b" vid="PSA 104:35"/>
  <para style="q1" vid="PSA 104:35">ያ ሉቡኮ <char style="nd">ዋቀዮን</char> ኤብስ።</para>
  <para style="b" vid="PSA 104:35"/>
  <para style="q1" vid="PSA 104:35">ሃሌሉያ።<verse eid="PSA 104:35"/></para>
  <chapter eid="PSA 104"/>
  <chapter number="105" style="c" sid="PSA 105"/>
  <para style="cl">ፋርፈትና 105</para>
  <para style="ms1">ሴና እስራኤል እሰ ድንቅሲሳ</para>
  <para style="mr">
    <ref loc="PSA 105:1-15">105፥1‑15</ref> ኩወፈ – <char style="xt"><ref loc="1CH 16:8-22">1ሴና 16፥8‑22</ref></char></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 105:1"/>
    <char style="nd">ዋቀዮፍ</char> ገለተ ገልቻ፤ መቃሳስ ዋመዻ፤</para>
  <para style="q2" vid="PSA 105:1">ዋን እን ሆጄቴስ ሰቦተ ግዱት ቤክስሳ።<verse eid="PSA 105:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 105:2"/>እሳፍ ፋርፈዻ፤ ፋርፈናዻን እሰ ገለቴፈዻ፤</para>
  <para style="q2" vid="PSA 105:2">ዋኤ ሆጂሳ እሰ ድንቅሲሳ ሁንዳስ ኦዴሳ።<verse eid="PSA 105:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 105:3"/>መቃሳ ቁልቁሉ ሰናን ቦና፤</para>
  <para style="q2" vid="PSA 105:3">ገራን ወረ <char style="nd">ዋቀዮን</char> በርባደኒ ሃገመዱ።<verse eid="PSA 105:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 105:4"/>
    <char style="nd">ዋቀዮፊ</char> ሁምነሳ በርባደዻ፤</para>
  <para style="q2" vid="PSA 105:4">ዬሮ ሁንደ ፉለሳ በርባዳ።<verse eid="PSA 105:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 105:5"/>ድንቂ እን ሆጄቴ፣</para>
  <para style="q2" vid="PSA 105:5">ሆጂሳ ድንቂ ሰናፊ ሙርቲ እን ለብሴ ያደዻ፤<verse eid="PSA 105:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 105:6"/>እስን ተጃጅልቶትንሳ፣ ወር ሰኚ አብረሃም ታተን፣</para>
  <para style="q2" vid="PSA 105:6">እስን ፍለተምቶትንሳ፣ እልማን ያቆብስ ከነ ያደዻ።<verse eid="PSA 105:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 105:7"/>እን <char style="nd">ዋቀዮ</char> ዋቀኬኘ፤</para>
  <para style="q2" vid="PSA 105:7">ሙርቲንሳስ ለፈ ሁንደረ ጅረ።<verse eid="PSA 105:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 105:8"/>እን ከኩሳ በረ በራን፣</para>
  <para style="q2" vid="PSA 105:8">ዋዳ ገሌ ሰነስ ዸሎተ ኩማፍ ንያደተ፤<verse eid="PSA 105:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 105:9"/>እን ከኩ አብረሃም ወጅን ገሌ፣</para>
  <para style="q2" vid="PSA 105:9">ከኩ ይስሃቂፍ ከከቴስ ንያደተ።<verse eid="PSA 105:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 105:10"/>ከነስ ያቆቢፍ ሴረ፣</para>
  <para style="q2" vid="PSA 105:10">እስራኤሊፍሞ ከኩ በረ በራ ጎዼ <optbreak/> አከነ ጄዼ ምርከኔሴረ፦<verse eid="PSA 105:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 105:11"/>“አን ብየ ከነኣን</para>
  <para style="q2" vid="PSA 105:11">ቆደ አት ዻልቱ ጎዼ ሲፍ ነንኬነ።”<verse eid="PSA 105:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 105:12"/>እሳን ዬሮ ለኮብሳን ጥኖ ቱረንት፣</para>
  <para style="q2" vid="PSA 105:12">ዹጉማኑ ጥኖፊ ብየቲ ኬሰትስ <optbreak/> ኬሱሞተ ቱረንት፣<verse eid="PSA 105:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 105:13"/>ሰባ ገረ ሰባት፣ ሞቱማ ቶኮ ገረ</para>
  <para style="q2" vid="PSA 105:13">ሞቱማ ብራት ጆረን።<verse eid="PSA 105:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 105:14"/>እን አከ ነምን ቶኮዩ እሳን ጩንቁርሱ ህንኤየምኔ፤</para>
  <para style="q2" vid="PSA 105:14">ሰበቢሳኒቲፍስ አከነ ጄዼ ሞቶተ እፈቴ፦<verse eid="PSA 105:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 105:15"/>“ድበምቶተኮ ህንቱቅና፤</para>
  <para style="q2" vid="PSA 105:15">ራጆተኮስ ህንሚዽና።”<verse eid="PSA 105:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 105:16"/>እን ቤለ ብየቲት ዋሜ፤</para>
  <para style="q2" vid="PSA 105:16">ምዻን ኛታ ሁንደስ ንበሌሴ፤<verse eid="PSA 105:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 105:17"/>እንስ ዮሴፍ ነምቸ አከ ገርባት</para>
  <para style="q2" vid="PSA 105:17">ጉርጉረሜ ቶኮ እሳን ዱረ ኤርጌ።<verse eid="PSA 105:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 105:18"/>እሳን ፎንጫዻን ሚለሳ ሉቅሰን፤</para>
  <para style="q2" vid="PSA 105:18">ሞርምሳስ ስቢለ ኬሰ ገልፈሜ፤<verse eid="PSA 105:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 105:19"/>ሀመ ወን እን ዱራን ዱርሴ ዱበቴ ጉተሙት</para>
  <para style="q2" vid="PSA 105:19">ዱቢን <char style="nd">ዋቀዮ</char> እሰ ቆሬ።<verse eid="PSA 105:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 105:20"/>ሞቲን ነመ ኤርጌ ገድ እሰ ዺስሴ፤</para>
  <para style="q2" vid="PSA 105:20">ቡልቻን ሰባ እሰ ሂክስሴ።<verse eid="PSA 105:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 105:21"/>ሞትችስ መነሳረት አጀጃ፣</para>
  <para style="q2" vid="PSA 105:21">ቀቤኘሳ ሁንደረትሞ ቡልቻ እሰ ጎዸቴ፤<verse eid="PSA 105:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 105:22"/>ከነስ አከ እን አኩመ ፌዼት ቆንዳልቶተሳ ጎርሱፍ፣</para>
  <para style="q2" vid="PSA 105:22">አከ እን ማንጉዶተሳ ኦጉማ በርሲሱፍ ጎዼ።<verse eid="PSA 105:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 105:23"/>እስራኤል ብየ ግብጥ ዸቄ፤</para>
  <para style="q2" vid="PSA 105:23">ያቆብስ አከ አለጋት ብየ ሃም ኬሰ ጅራቴ።<verse eid="PSA 105:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 105:24"/>
    <char style="nd">ዋቀዮ</char> ሰበሳ አከ መሌ ባይእሴ፤</para>
  <para style="q2" vid="PSA 105:24">አከ እሳን አመጃጆተሳኒ ጫላ ጀባተንስ ጎዼ፤<verse eid="PSA 105:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 105:25"/>እንስ አከ እሳን ሰበሳ ጅበኒፊ</para>
  <para style="q2" vid="PSA 105:25">አከ እሳን ተጃጅልቶተሳት መርአተኒፍ ያደሳኒ ጌደሬ።<verse eid="PSA 105:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 105:26"/>ዋቅንስ ሙሴ ተጃጅላሳቲፊ</para>
  <para style="q2" vid="PSA 105:26">አሮን ፍለተማሳ ኤርጌ።<verse eid="PSA 105:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 105:27"/>እሳንስ ጀረ ግዱት መለቶሳ፣</para>
  <para style="q2" vid="PSA 105:27">ብየ ሃም ኬሰትሞ ድንቂሳ አርግሲሰን።<verse eid="PSA 105:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 105:28"/>እን ዱከነ ኤርጌ ብየቲ ዱከኔሴ፤</para>
  <para style="q2" vid="PSA 105:28">እሳን ዱቢሳት ፍንጭለኒሩቲ።<verse eid="PSA 105:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 105:29"/>እን ብሻኖተሳኒ ዺገት ጌደሬ</para>
  <para style="q2" vid="PSA 105:29">አከ ቁርጡሚወንሳኒ ዹመን ጎዼ።<verse eid="PSA 105:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 105:30"/>ፈቴን ብየሳኒ ጉቴ</para>
  <para style="q2" vid="PSA 105:30">ዲንቀ ሞቶተሳኒ ኬሰ ያኤ።<verse eid="PSA 105:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 105:31"/>እን ዱበናን ቱትን ትሲሳቲፊ</para>
  <para style="q2" vid="PSA 105:31">ቦኬን ብየሳኒ ሁንደ ኬሰ ጉቴ።<verse eid="PSA 105:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 105:32"/>እን ቆደ ቦካ ጨቢ እሳኒፍ ሮብሴ፤</para>
  <para style="q2" vid="PSA 105:32">በከካስ ብየሳኒት ኤርጌ፤<verse eid="PSA 105:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 105:33"/>ወይኒሳኒቲፊ ሙከ ሀርቡሳኒ በሌሴ፤</para>
  <para style="q2" vid="PSA 105:33">ሙኬን ብየሳኒስ ንጨጨብሴ።<verse eid="PSA 105:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 105:34"/>እን ዱበናን ሀዋንስኒፊ</para>
  <para style="q2" vid="PSA 105:34">ኮሮጵስን ሄዱን ዹፈን፤<verse eid="PSA 105:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 105:35"/>እሳንስ ብቅልቱ ብየ ጀራ ሁንደ ኛተን፤</para>
  <para style="q2" vid="PSA 105:35">ዋን ለፍትሳኒ ባሴስ ንፍጠን።<verse eid="PSA 105:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 105:36"/>ኤርገሲ እን ሀንገፈ ብየሳኒ ሁንደ፣</para>
  <para style="q2" vid="PSA 105:36">ጀብነሳኒ ጀልቀባስ ንዸኤ።<verse eid="PSA 105:36"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 105:37"/>አከ ሰብን እስራኤል ሜቲፊ ወርቄ ባዸቴ በኡ ጎዼ፤</para>
  <para style="q2" vid="PSA 105:37">ጎሰሳኒ ኬሳ ነምን ቶኮዩ ህንጉፈትኔ።<verse eid="PSA 105:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 105:38"/>እስራኤሎን ባናን ወር ግብጥ ገመደን፤</para>
  <para style="q2" vid="PSA 105:38">እሳን እስራኤልን ሶዳተኒ ቱረኒቲ።<verse eid="PSA 105:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 105:39"/>እን አከ ጋድሳት ዱሜሰ እሳንረ ቀቤ፤</para>
  <para style="q2" vid="PSA 105:39">አከ ሀልከኒን እሳኒፍ እብሱፍሞ እብደ ቀብሲሴፍ።<verse eid="PSA 105:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 105:40"/>እሳን ከዸናን እን ድምብርቄ ኬኔፍ፤</para>
  <para style="q2" vid="PSA 105:40">ቡዴነ ሰሚቲንስ እሳን ቁፍሴ።<verse eid="PSA 105:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 105:41"/>እንስ ከታ በኔ፤ ብሻንስ ኬሳ ገድ ዸንገለኤ፤</para>
  <para style="q2" vid="PSA 105:41">አኩመ ብሻን ለጋትስ ገሞጂ ኬሳ ያኤ።<verse eid="PSA 105:41"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 105:42"/>እን ዋዳሳ ቁልቁሉ፣</para>
  <para style="q2" vid="PSA 105:42">ከን ገርብቸሳ አብረሃሚፍ ገሌ ሰነ ያደቴራቲ።<verse eid="PSA 105:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 105:43"/>እን ሰበሳ ገመቹን፣</para>
  <para style="q2" vid="PSA 105:43">ወረ እሳፍ ፍለተመንሞ እልሌዻን ባሴረ፤<verse eid="PSA 105:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 105:44"/>እን ብየ ኦርሞታ እሳኒፍ ኬኔ፤</para>
  <para style="q2" vid="PSA 105:44">እሳንስ ዋን ሰቦትን ሱን እት ደዸበን ዻለን፤<verse eid="PSA 105:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 105:45"/>ከነስ አከ እሳን ስርነሳ ኤገኒ</para>
  <para style="q2" vid="PSA 105:45">ሴረሳቲፍ ቡለኒፍ ጎዼ።</para>
  <para style="b" vid="PSA 105:45"/>
  <para style="q1" vid="PSA 105:45">ሃሌሉያ።<verse eid="PSA 105:45"/></para>
  <chapter eid="PSA 105"/>
  <chapter number="106" style="c" sid="PSA 106"/>
  <para style="cl">ፋርፈትና 106</para>
  <para style="ms1">ኡመትን ጩቡሳ ህመቴ</para>
  <para style="mr">
    <ref loc="PSA 106:1">106፥1</ref>፣<ref loc="PSA 106:47-48">47‑48</ref> ኩወፈ – <char style="xt"><ref loc="1CH 16:34-36">1ሴና 16፥34‑36</ref></char></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 106:1"/>ሃሌሉያ።</para>
  <para style="b" vid="PSA 106:1"/>
  <para style="q1" vid="PSA 106:1">
    <char style="nd">ዋቀዮፍ</char> ገለተ ገልቻ፤ እን ጋሪዻቲ፤</para>
  <para style="q2" vid="PSA 106:1">ጃለልሳ በረ በራን ጅራተ።<verse eid="PSA 106:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 106:2"/>ኤኙቱ ሆጂ <char style="nd">ዋቀዮ</char> ጀባ ሰነ ለብሱ፣</para>
  <para style="q2" vid="PSA 106:2">ዮካን ገለተሳ ጉቱማት ኦዴሱ ደንደኣ?<verse eid="PSA 106:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 106:3"/>ወር ጀቤሰኒ ሙርቲ ቀጄላ ኤገን፣</para>
  <para style="q2" vid="PSA 106:3">ወር ዬሮ ሁንደ ዋን ቀጄላ ሆጄተን ኤብፈሞዸ።<verse eid="PSA 106:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 106:4"/>ያ <char style="nd">ዋቀዮ</char>፣ ዮሙ ሰበኬት ፋረ ቶልቱት ነ ያደዹ፤</para>
  <para style="q2" vid="PSA 106:4">ዮሙ እሳን ኦልችቱትስ ነ ገርጋር፤<verse eid="PSA 106:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 106:5"/>አከ አን በዻዹማ ፍለተምቶተኬቲ አርጉፍ፣</para>
  <para style="q2" vid="PSA 106:5">አከ አን ገመቹ ሰበኬቲ ኬሰት ህርማዼ</para>
  <para style="q2" vid="PSA 106:5">ዻለኬ ወጅን ቦኑፍ ነ ያደዹ።<verse eid="PSA 106:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 106:6"/>ኑ አኩመ አቦቲኬኛ ጩቡ ሆጄትኔረ፤</para>
  <para style="q2" vid="PSA 106:6">የከ ሆጄትኔረ፤ ሀምነስ ሆጄትኔረ።<verse eid="PSA 106:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 106:7"/>አቦቲንኬኘ ዬሮ ብየ ግብጥ ኬሰ ቱረንት፣</para>
  <para style="q2" vid="PSA 106:7">ድንቂኬ ህንሁበትኔ፤</para>
  <para style="q1" vid="PSA 106:7">ባይእነ አራረኬቲስ ህንያደትኔ፤</para>
  <para style="q2" vid="PSA 106:7">እሳን ገላነ ብረት፣ ገላነ ዲማ ብረት ስት ፍንጭለን።<verse eid="PSA 106:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 106:8"/>ተኡስ እን አከ ሁምንሳ ጉዳን ሱን ቤከሙፍ፣</para>
  <para style="q2" vid="PSA 106:8">መቃሳቲፍ ጄዼ እሳን ኦልቼ።<verse eid="PSA 106:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 106:9"/>እን ገላነ ዲማ እፈቴ፤ ገላንችስ ንጎጌ፤</para>
  <para style="q2" vid="PSA 106:9">አኩመ ዋን ገሞጂ ኬሰ ደበርሱት ለፈ ጎጋረ እሳን ደበርሴ።<verse eid="PSA 106:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 106:10"/>ሀርከ አመጃጂሳኒ ኬሳ እሳን ባሴ፤</para>
  <para style="q2" vid="PSA 106:10">ሁምነ ዲና ጀላስ እሳን ፉሬ።<verse eid="PSA 106:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 106:11"/>ብሻኖትን ዲኖተሳኒ ልቅምሰን፤</para>
  <para style="q2" vid="PSA 106:11">ቶኮንሳኒዩ ህንሀፍኔ።<verse eid="PSA 106:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 106:12"/>ኤርገሲ እሳን ዱቢሳ አመነኒ</para>
  <para style="q2" vid="PSA 106:12">ፋርፈናዻን እሰ ገለቴፈተን።<verse eid="PSA 106:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 106:13"/>እሳን ገሩ ዮሙሱመ ዋን እን ሆጄቴ ቱሬ ደገተን፤</para>
  <para style="q2" vid="PSA 106:13">ጎርሰሳስ ኦብሳን ህንኤገትኔ።<verse eid="PSA 106:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 106:14"/>ገሞጂ ኬሰት ዸራ ሀማዻን ጉተመን፤</para>
  <para style="q2" vid="PSA 106:14">ለፈ ኦና ኬሰትስ ዋቀ ቆረን።<verse eid="PSA 106:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 106:15"/>ከናፉ እን ዋን እሳን ከዸተን ኬኔፍ፤</para>
  <para style="q2" vid="PSA 106:15">ገሩ ዹኩበ ነመ ሁቅሱ እሳንት ኤርጌ።<verse eid="PSA 106:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 106:16"/>እሳን ቁበተ ኬሰት ሙሴፊ</para>
  <para style="q2" vid="PSA 106:16">አሮን ቁልቁልቸ <char style="nd">ዋቀዮት</char> ህናፈን።<verse eid="PSA 106:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 106:17"/>ለፍት አፋን በነቴ ዳታንን ልቅምስቴ፤</para>
  <para style="q2" vid="PSA 106:17">ገሬ አቢራምስ ገድ ፉዸቴ።<verse eid="PSA 106:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 106:18"/>ዱከ ቡቶተሳኒ ግዱት እብድ ቦበኤ፤</para>
  <para style="q2" vid="PSA 106:18">አረብን እብዳስ ሀሞተ ፍጤ።<verse eid="PSA 106:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 106:19"/>እሳን ኮሬብት ጀቢ ቶልፈተን፤</para>
  <para style="q2" vid="PSA 106:19">ፈኪ በቅፈሜ ቶልፈሜስ ዋቄፈተን።<verse eid="PSA 106:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 106:20"/>እሰ ኡልፍነሳኒ ተኤ ሰነ፣</para>
  <para style="q2" vid="PSA 106:20">ፈኪ ሰንጋ መርገ ዼዱት ጌደረን።<verse eid="PSA 106:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 106:21"/>ዋቀ እሳን ፈይሴ፣</para>
  <para style="q2" vid="PSA 106:21">እሰ ብየ ግብጥት ዋን ጉርጉዳ ሆጄቴ ሰነ እራንፈተን።<verse eid="PSA 106:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 106:22"/>ድንቂ እን ብየ ሃም ኬሰት ሆጄቴ፣</para>
  <para style="q2" vid="PSA 106:22">ሆጂ ሶዳችሳ እን ገላነ ዲማረት ሆጄቴስ ንእራንፈተን።<verse eid="PSA 106:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 106:23"/>ከናፉ ኡቱ ፍለተማንሳ ሙሴን</para>
  <para style="q2" vid="PSA 106:23">አከ ዼከምስ ዋቃ እሳን ህንበሌስኔፍ</para>
  <para style="q1" vid="PSA 106:23">ግዱ ገሌ ፉለሳ ዱረ ዻበቹ ባቴ ስላ</para>
  <para style="q2" vid="PSA 106:23">ዋቅን አከ እሳን በሌሱ ዱበቴ ቱሬ።<verse eid="PSA 106:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 106:24"/>እሳንስ ብየ ነመት ቶሉ ሰነ ቱፈተን፤</para>
  <para style="q2" vid="PSA 106:24">ዋዳ ዋቅን ገሌስ ህንአመኔ።<verse eid="PSA 106:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 106:25"/>ዱንካኖተሳኒ ኬሰት ንጉንጉመን፤</para>
  <para style="q2" vid="PSA 106:25">
    <char style="nd">ዋቀዮፍስ</char> ህንአጀጀምኔ።<verse eid="PSA 106:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 106:26"/>ከናፉ እን አከ ገሞጂ ኬሰት</para>
  <para style="q2" vid="PSA 106:26">እሳን ገቱ ሀርከሳ ኦል ቀበቴ ከከቴ፤<verse eid="PSA 106:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 106:27"/>ሰኚሳኒ አከ ሰቦተ ግዱት ገቱ፣</para>
  <para style="q2" vid="PSA 106:27">ብዮተ ሁንደ ኬሰስ አከ እሳን ብትኔሱ ከከቴ።<verse eid="PSA 106:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 106:28"/>እሳን በኣል ጴኦርት ኦፍ ኬነኒ</para>
  <para style="q2" vid="PSA 106:28">ኣርሳ ዋቆተ ሉቡ ህንቀብኔፍ ዽኤፈሜ ኛተን።<verse eid="PSA 106:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 106:29"/>ሆጂሳኒ ሀማ ሰናን <optbreak/> <char style="nd">ዋቀዮን</char> ዼከምሳፍ ከካሰን፤</para>
  <para style="q2" vid="PSA 106:29">ዸእችስ እሳንረ ቡኤ።<verse eid="PSA 106:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 106:30"/>ገሩ ፊኔሃስ ከኤ ግዱ ሴናን</para>
  <para style="q2" vid="PSA 106:30">ዸእች ሱን ዻበቴ።<verse eid="PSA 106:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 106:31"/>ኩንስ ዸሎታ ሀመ ዸሎታት፣</para>
  <para style="q2" vid="PSA 106:31">አከ ቀጄሉማት እሳፍ ሄሬገሜ።<verse eid="PSA 106:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 106:32"/>እሳን ብሻን መሪባ ብረት አከ <char style="nd">ዋቀዮ</char> ኣሩ ጎዸን።</para>
  <para style="q2" vid="PSA 106:32">ሙሴንስ ሰበቢሳኒቲፍ ረከቴ፤<verse eid="PSA 106:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 106:33"/>ሰበቢ እሳን ሀፉረ ዋቃት ፍንጭለኒፍ</para>
  <para style="q2" vid="PSA 106:33">ሙሴን ኡቱ እት ህንያድን ዱበቴ።<verse eid="PSA 106:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 106:34"/>እሳን አከ <char style="nd">ዋቀዮ</char> እሳን አጀጄት፣</para>
  <para style="q2" vid="PSA 106:34">ሰቦተ ህንበሌስኔ፤<verse eid="PSA 106:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 106:35"/>እሳን ገሩ ኦርሞተት መከመኒ</para>
  <para style="q2" vid="PSA 106:35">ዱዻሳኒ በረተን።<verse eid="PSA 106:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 106:36"/>ዋቆተሳኒ ቶልፈሞ፣</para>
  <para style="q2" vid="PSA 106:36">ከኔን ክዮ እሳንት ተአን ዋቄፈተን።<verse eid="PSA 106:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 106:37"/>እልማንሳኒቲፊ እንተለንሳኒ</para>
  <para style="q2" vid="PSA 106:37">ኣርሳ ጎዸኒ ሀፉሮተ ሀሞፍ ዽኤሰን።<verse eid="PSA 106:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 106:38"/>እሳንስ ዺገ ወረ በሌሳ ህንቀብኔ፣</para>
  <para style="q2" vid="PSA 106:38">ዺገ እልማንሳኒቲፊ እንተለንሳኒ፣</para>
  <para style="q1" vid="PSA 106:38">ከን ዋቆተ ቶልፈሞ ከነኣኒፍ</para>
  <para style="q2" vid="PSA 106:38">ኣርሳ ጎዸኒ ዽኤሰን ሰነ ዸንገላሰን፤</para>
  <para style="q2" vid="PSA 106:38">ብየቲንስ ዺገሳኒቲን ፋለምቴ።<verse eid="PSA 106:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 106:39"/>እሳን ዋኑመ ሆጄተኒን ኦፍ ጡሬሰን፤</para>
  <para style="q2" vid="PSA 106:39">ሆጂሳኒቲን ሰጋገልቶተ ኦፍ ታስሰን።<verse eid="PSA 106:39"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 106:40"/>ከናፉ <char style="nd">ዋቀዮ</char> ሰበሳት ኣሬ፤</para>
  <para style="q2" vid="PSA 106:40">ሀንዹራሳስ ንበልፌ።<verse eid="PSA 106:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 106:41"/>እን ደበርሴ ኦርሞተት እሳን ኬኔ፤</para>
  <para style="q2" vid="PSA 106:41">አመጃጆንሳኒስ ኦፍ ጀለት እሳን ቡልቸን።<verse eid="PSA 106:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 106:42"/>ዲኖትንሳኒ እሳን ጩንቁርሰን፤</para>
  <para style="q2" vid="PSA 106:42">ሁምነሳኒ ጀለስ እሳን ገልፈተን።<verse eid="PSA 106:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 106:43"/>እን ዬሮ ባይኤ እሳን በራሬ፤</para>
  <para style="q2" vid="PSA 106:43">እሳን ገሩ እቱመ ፉፈኒ ፍንጭለን፤</para>
  <para style="q2" vid="PSA 106:43">እቱመ ጫልችሰኒስ ጩቡ ሆጄተን።<verse eid="PSA 106:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 106:44"/>እን ገሩ ዮሙ እየሳኒ ዸገኤት፣</para>
  <para style="q2" vid="PSA 106:44">ረክነሳኒ ሁበቴ፤<verse eid="PSA 106:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 106:45"/>እሳኒፍ ጄዼ ከኩሳ ያደቴ፤</para>
  <para style="q2" vid="PSA 106:45">ሰበቢ ጃለለሳ ጉዳ ሰናቲፍ ገራ ላፌፍ።<verse eid="PSA 106:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 106:46"/>እን አከ ወር እሳን ቦጅአን ሁንድኑ</para>
  <para style="q2" vid="PSA 106:46">ገራ እሳኒፍ ላፈኒፍ ጎዼ።<verse eid="PSA 106:46"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 106:47"/>ያ <char style="nd">ዋቀዮ</char>፣ ዋቀኬኘ ኑ ኦልች፤</para>
  <para style="q2" vid="PSA 106:47">አከ ኑ መቃኬ ቁልቁሉ ሰነ ገለቴፈኑፍ፣</para>
  <para style="q1" vid="PSA 106:47">አከ ገለተኬቲን ኦፍ ጀጅኑፍስ፣</para>
  <para style="q2" vid="PSA 106:47">ኦርሞተ ኬሳ ወልት ኑ ቀብ።<verse eid="PSA 106:47"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 106:48"/>
    <char style="nd">ዋቀዮ</char>፣ ዋቀ እስራኤሊቲፍ፣</para>
  <para style="q2" vid="PSA 106:48">በረ በራ ሀመ በረ በራት ገለን ሃገኡ።</para>
  <para style="b" vid="PSA 106:48"/>
  <para style="q1" vid="PSA 106:48">ነምን ሁንድኑ “አሜን!” ሃጄዹ።</para>
  <para style="b" vid="PSA 106:48"/>
  <para style="q1" vid="PSA 106:48">ሃሌሉያ!<verse eid="PSA 106:48"/></para>
  <chapter eid="PSA 106"/>
  <chapter number="107" style="c" sid="PSA 107"/>
  <para style="ms">ክታበ ሸነፋ</para>
  <para style="mr">
    <ref loc="PSA 107-150">ፋርፈትና 107–150</ref></para>
  <para style="cl">ፋርፈትና 107</para>
  <para style="ms1">ዋቀ ረክነ ሁንደ ኬሳ ነመ ባሱ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 107:1"/>
    <char style="nd">ዋቀዮፍ</char> ገለተ ገልቻ፤ እን ጋሪዻቲ፤</para>
  <para style="q2" vid="PSA 107:1">ጃለልሳ በረ በራን ጅራተ።<verse eid="PSA 107:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 107:2"/>ወር <char style="nd">ዋቀዮ</char> እሳን ፉሬ፣</para>
  <para style="q2" vid="PSA 107:2">ወር እን ሀርከ ዲናቲ ባሴ፣<verse eid="PSA 107:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 107:3"/>ወር እን ብየ ገረ ገራቲ፣</para>
  <para style="q2" vid="PSA 107:3">በኣፊ ልጠ ቢፍቱቲ፣ ካባፊ ክባ ወልት ቀቤ ዋን ከነ ሃዱበተን።<verse eid="PSA 107:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 107:4"/>እሳን ኬሳ ቶኮ ቶኮ ገሞጂ ጎጎጋ ኬሰ ጆረን፤</para>
  <para style="q2" vid="PSA 107:4">መጋላ ኬሰ ጅራቹ ደንደአንስ ህንአርገኔ።<verse eid="PSA 107:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 107:5"/>እሳን ንቤለአን፤ ንዼቦተንስ፤</para>
  <para style="q2" vid="PSA 107:5">ሉቡንሳኒስ እሳን ኬሰት ገገብዴ።<verse eid="PSA 107:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 107:6"/>እሳን ረክነሳኒ ኬሰት <char style="nd">ዋቀዮት</char> እየተን፤</para>
  <para style="q2" vid="PSA 107:6">እንስ ዽጵነሳኒ ኬሳ እሳን ባሴ።<verse eid="PSA 107:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 107:7"/>እን ሀመ እሳን መጋላ ኬሰ ጅራቹ ደንደአን ገአንት</para>
  <para style="q2" vid="PSA 107:7">ከራ ቀጄላረ እሳን ቀጄልቼ።<verse eid="PSA 107:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 107:8"/>እሳን ሰበቢ ጃለለሳ ከን ህንጌደረምኔ ሰናቲፊ</para>
  <para style="q2" vid="PSA 107:8">ሆጂ ድንቂ ከን እን እልማን ነማቲፍ ሆጄቴ ሰናቲፍ <optbreak/> <char style="nd">ዋቀዮን</char> ሃገለቴፈተን፤<verse eid="PSA 107:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 107:9"/>እን ወረ ዼቦተን ዼቡ ባሴ</para>
  <para style="q2" vid="PSA 107:9">ወረ ቤለአንሌ ዋን ጋሪዻን ቁፍሳቲ።<verse eid="PSA 107:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 107:10"/>እሳን ኬሳስ ቶኮ ቶኮ ስቢላን ህዸመኒ ረከቻ፣</para>
  <para style="q2" vid="PSA 107:10">ዱከናፊ ድምምሰ ኬሰ ጅራተን፤<verse eid="PSA 107:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 107:11"/>እሳን ዱቢ ዋቃት ፍንጭለኒ</para>
  <para style="q2" vid="PSA 107:11">ጎርሰ ዋቀ ዋን ሁንዳ ኦሊስ ቱፈተኒሩቲ።<verse eid="PSA 107:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 107:12"/>ከናፉ እን ደበርሴ ሆጂ ደዸብሲሳት እሳን ኬኔ፤</para>
  <para style="q2" vid="PSA 107:12">እሳንስ ንጉፈተን፤ ነምን እሳን ገርጋሩ ቶኮዩ ህንአርገምኔ።<verse eid="PSA 107:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 107:13"/>እሳን ረክነሳኒ ኬሰት <char style="nd">ዋቀዮት</char> እየተን፤</para>
  <para style="q2" vid="PSA 107:13">እንስ ዽጵነሳኒ ኬሳ እሳን ባሴ።<verse eid="PSA 107:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 107:14"/>እን ዱከናፊ ድምምሰ ኬሳ እሳን ባሴ፤</para>
  <para style="q2" vid="PSA 107:14">ፎንጫ እሳንስ ገርገር ኩኩቴ።<verse eid="PSA 107:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 107:15"/>እሳን ሰበቢ ጃለለሳ ከን ህንጌደረምኔ ሰናቲፊ</para>
  <para style="q2" vid="PSA 107:15">ሆጂ ድንቂ ከን እን እልማን ነማቲፍ ሆጄቴ ሰናቲፍ <optbreak/> <char style="nd">ዋቀዮን</char> ሃገለቴፈተን፤<verse eid="PSA 107:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 107:16"/>እን በልበለወን ናሲ ጨጨብሴ</para>
  <para style="q2" vid="PSA 107:16">ደንቀራወን ስቢላሌ ኩኩታቲ።<verse eid="PSA 107:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 107:17"/>እሳን ኬሳ ቶኮ ቶኮ ጩቡ መታሳኒቲን ጎዎመን፤</para>
  <para style="q2" vid="PSA 107:17">ሰበቢ በሌሳሳኒቲፍስ ገደዶ ኬሰ ሴነን።<verse eid="PSA 107:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 107:18"/>እሳን ኛተ ጎሰ ከሚዩ በልፈኒ</para>
  <para style="q2" vid="PSA 107:18">አፋን ቦለ ዱኣ ገአን።<verse eid="PSA 107:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 107:19"/>ረክነሳኒ ኬሰት <char style="nd">ዋቀዮት</char> እየተን፤</para>
  <para style="q2" vid="PSA 107:19">እንስ ዽጵነሳኒ ኬሳ እሳን ባሴ።<verse eid="PSA 107:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 107:20"/>እን ዱቢሳ ኤርጌ እሳን ፈይሴ፤</para>
  <para style="q2" vid="PSA 107:20">አዋለ ኬሳስ እሳን ባሴ።<verse eid="PSA 107:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 107:21"/>እሳን ሰበቢ ጃለለሳ ከን ህንጌደረምኔ ሰናቲፊ</para>
  <para style="q2" vid="PSA 107:21">ሆጂ ድንቂ ከን እን እልማን ነማቲፍ ሆጄቴ ሰናቲፍ፣ <optbreak/> <char style="nd">ዋቀዮን</char> ሃገለቴፈተን!<verse eid="PSA 107:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 107:22"/>ኣርሳ ገለታ ሃዽኤሰን፤</para>
  <para style="q2" vid="PSA 107:22">ፋርፈትና ገመቹቲንስ ሆጂሳ ሃህመን።<verse eid="PSA 107:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 107:23"/>እሳን ኬሳ ቶኮ ቶኮ ዶኒዻን ገላነረ ዴመኒ</para>
  <para style="q2" vid="PSA 107:23">ብሻኖተ ጉርጉዳረት ደልደለን።<verse eid="PSA 107:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 107:24"/>እሳንስ ሆጂ <char style="nd">ዋቀዮቲፊ</char></para>
  <para style="q2" vid="PSA 107:24">ሆጂሳ ድንቅሲሳ ሰነ ቱጁበ ኬሰት አርገን።<verse eid="PSA 107:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 107:25"/>እን ዱበቴ ቡቤ ጀባ</para>
  <para style="q2" vid="PSA 107:25">ደምበሊ ገላና ኦል ፉዹ ቶኮ ካሴራቲ።<verse eid="PSA 107:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 107:26"/>እሳን ሰሚት ኦል በአኒ ቱጁበት ገድ ቡአን፤</para>
  <para style="q2" vid="PSA 107:26">ረክነሳኒ ኬሰትስ አብዲ ኩተተን።<verse eid="PSA 107:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 107:27"/>አከ ነመ መቻኤ ደደርበተመኒ ገተንተረን</para>
  <para style="q2" vid="PSA 107:27">ኦጉማን እሳንስ ፋይዳ ዸቤ።<verse eid="PSA 107:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 107:28"/>እሳን ረክነሳኒ ኬሰት <char style="nd">ዋቀዮት</char> እየተን፤</para>
  <para style="q2" vid="PSA 107:28">እንስ ዽጵነሳኒ ኬሳ እሳን ባሴ።<verse eid="PSA 107:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 107:29"/>እን አከ ደምበሊን ሱን ቀበናኡፍ</para>
  <para style="q2" vid="PSA 107:29">ዸኣ ገላና ጨልእሲሴ።<verse eid="PSA 107:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 107:30"/>እሳን ዋን ደምበሊፊ ዸኣን ገላና ሱን ጨልእሰኒፍ ንገመደን፤</para>
  <para style="q2" vid="PSA 107:30">ሃለ ከናንስ ገረ ቁበተ ዶኒ በርባደኒት እሳን ጌሴ።<verse eid="PSA 107:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 107:31"/>እሳን ሰበቢ ጃለለሳ ከን ህንጌደረምኔ ሰናቲፊ</para>
  <para style="q2" vid="PSA 107:31">ሆጂ ድንቂ ከን እን እልማን ነማቲፍ ሆጄቴ ሰናቲፍ <optbreak/> <char style="nd">ዋቀዮን</char> ሃገለቴፈተን።<verse eid="PSA 107:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 107:32"/>ወልዳ ነሞታ ኬሰት እሰ ሃሌልሰን፤</para>
  <para style="q2" vid="PSA 107:32">ወል ገኢ ማንጉዶታ ኬሰትስ እሰ ሃጀጀን።<verse eid="PSA 107:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 107:33"/>እንስ ለጎተ ገሞጂ ታስሴ</para>
  <para style="q2" vid="PSA 107:33">ቡርቃወን ብሻንስ ገረ ለፈ ጎጎጋት ጌደሬ፤<verse eid="PSA 107:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 107:34"/>ሰበቢ ሀምነ ወረ አች ጅራተኒቲፍ፣</para>
  <para style="q2" vid="PSA 107:34">ብየ ምዻን ባሱ ለፈ ሶግዳ ታስሴ።<verse eid="PSA 107:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 107:35"/>ገሞጂ ኩሳ ብሻኒት፣</para>
  <para style="q2" vid="PSA 107:35">ለፈ ጎጎጋሞ ቡርቃ ብሻኒት ጌደሬ፤<verse eid="PSA 107:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 107:36"/>እን አከ ወር ቤለአን አች ጅራተን ጎዼ፤</para>
  <para style="q2" vid="PSA 107:36">እሳንስ መጋላ ኬሰ ጅራተን እጃረተን።<verse eid="PSA 107:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 107:37"/>ለፈ ቆቲሳሳኒ ፈጫፈተኒ ወይኒስ ንዻበተን፤</para>
  <para style="q2" vid="PSA 107:37">ምዻን ጋሪስ አርገተን።<verse eid="PSA 107:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 107:38"/>እን እሳን ኤብሴ፤ ባይእነሳኒስ አከ መሌ ደበሌ፤</para>
  <para style="q2" vid="PSA 107:38">አከ ሎንሳኒ ለኮብሳን የረቻ ዴመን ህንጎኔ።<verse eid="PSA 107:38"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 107:39"/>ዬሮ እሳን ጩንቁርሳዻን፣ ረክናፊ</para>
  <para style="q2" vid="PSA 107:39">ገዳን ጥናተኒ ገድ ዴብአንት፣<verse eid="PSA 107:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 107:40"/>እን ነሞተ ቤቤከሞረት ቱፊ ሮብሴ</para>
  <para style="q2" vid="PSA 107:40">አከ እሳን ገሞጂ ከራ ህንቀብኔ ኬሰ ጆረን ጎዼ።<verse eid="PSA 107:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 107:41"/>እን ገሩ ረከቶተ ዽጵነሳኒ ኬሳ ባሴ፤</para>
  <para style="q2" vid="PSA 107:41">ማቲ እሳንስ አኩመ ቡሻዬ ባይእሴ።<verse eid="PSA 107:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 107:42"/>ቀጄልቶትን ዋን ከነ አርገኒ እልልቹ፤</para>
  <para style="q2" vid="PSA 107:42">ሀሞን ሁንድኑ ገሩ አፋን ቀበቱ።<verse eid="PSA 107:42"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 107:43"/>ኦጌስ ከምዩ ዋን ከነ ያደት ሃቀበቱ፤</para>
  <para style="q2" vid="PSA 107:43">ጃለለ <char style="nd">ዋቀዮ</char> ከን ዹመ ህንቀብኔ ሰነሌ ሃሁበቱ።<verse eid="PSA 107:43"/></para>
  <chapter eid="PSA 107"/>
  <chapter number="108" style="c" sid="PSA 108"/>
  <para style="cl">ፋርፈትና 108</para>
  <para style="ms1">ፋርፈትና ገነማቲፊ ከዸትና ብዮሌሳ</para>
  <para style="mr">
    <ref loc="PSA 108:1-5">108፥1‑5</ref> ኩወፈ – <char style="xt"><ref loc="PSA 57:7-11">ፋር 57፥7‑11</ref></char></para>
  <para style="mr">
    <ref loc="PSA 108:6-13">108፥6‑13</ref> ኩወፈ – <char style="xt"><ref loc="PSA 60:5-12">ፋር 60፥5‑12</ref></char></para>
  <para style="d">ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 108:1"/>ያ ዋቅ፣ ገራንኮ ህንራፈሙ፤ አን ነንፋርፈዸ፤</para>
  <para style="q2" vid="PSA 108:1">ሉቡኮ ጉቱዻንስ ስን ገለቴፈዸ።<verse eid="PSA 108:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 108:2"/>ያ ክራራፊ በገና ደመቃ!</para>
  <para style="q2" vid="PSA 108:2">አንስ ገነማን ነንደመቀ።<verse eid="PSA 108:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 108:3"/>ያ <char style="nd">ዋቀዮ</char>፣ አን ሰቦተ ግዱት ገለተ ሲፍ ነንገልቸ፤</para>
  <para style="q2" vid="PSA 108:3">ነሞተ ግዱትስ ዋኤኬ ነንፋርፈዸ።<verse eid="PSA 108:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 108:4"/>ጃለልኬ ጉዳዸ፤ ሰሚወንስ ጫላ ኦል ዼራዻቲ፤</para>
  <para style="q2" vid="PSA 108:4">አመነሙማንኬስ ሰሚወን ቀቀበ።<verse eid="PSA 108:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 108:5"/>ያ ዋቅ፣ አት ሰሚወኒን ኦልት ኦል ኦል ጄዽ፤</para>
  <para style="q2" vid="PSA 108:5">ኡልፍንኬስ ለፈ ሁንደረ ሃጅራቱ።<verse eid="PSA 108:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 108:6"/>አከ ወር አት ጃለቱ ፉረመኒፍ፣</para>
  <para style="q2" vid="PSA 108:6">ሀርከኬ ምርጋቲን ኑ ኦልች፤ ኑ ገርጋርስ፤<verse eid="PSA 108:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 108:7"/>ዋቅን እዶ ቁልቁሉማሳቲ አከነ ጄዼ ዱበቴረ፦</para>
  <para style="q2" vid="PSA 108:7">“አን ገመቹዻን ሼኬምን ገርገር ነንቆደ፤</para>
  <para style="q2" vid="PSA 108:7">ሱሉለ ሱኮትስ ነንሰፈረ።<verse eid="PSA 108:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 108:8"/>ግልኣድ ከንኮት፤ ምናሴንስ ከንኮት፤</para>
  <para style="q2" vid="PSA 108:8">ኤፍሬም ጎንፎ ስቢላኮት፤</para>
  <para style="q2" vid="PSA 108:8">ይሁዳንስ ቦኩ ሞቱማኮት።<verse eid="PSA 108:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 108:9"/>ሞኣብ ጫቢ ዽቀትናኮት፤</para>
  <para style="q2" vid="PSA 108:9">ኤዶምራ ኮጴኮ ደርበዼ ነንቡሰ፤</para>
  <para style="q2" vid="PSA 108:9">ፍልስጤምረትስ ሞአናዻን ነንጌረረ።”<verse eid="PSA 108:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 108:10"/>ኤኙቱ መጋላ ጀቤፈምቴ እጃረምቴት ነ ፍደ?</para>
  <para style="q2" vid="PSA 108:10">ኤኙቱ ኤዶምት ነ ጌሰ?<verse eid="PSA 108:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 108:11"/>ያ ዋቅ ከን ኑ ገቴ፣</para>
  <para style="q2" vid="PSA 108:11">ከን ሎልቶተኬኘ ወጅን በኡ ድዴስ ሱመ ምቲ?<verse eid="PSA 108:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 108:12"/>ዲነኬኘ ኦፍራ ዾዉ ኑ ገርጋር፣</para>
  <para style="q2" vid="PSA 108:12">ገርጋርስ ነማ ፋይዳ ህንቀቡቲ።<verse eid="PSA 108:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 108:13"/>ኑ ዋቀ ወጅን ንሞአትነ፤</para>
  <para style="q2" vid="PSA 108:13">እንስ ዲኖተኬኘ ገድ ዽዺተ።<verse eid="PSA 108:13"/></para>
  <chapter eid="PSA 108"/>
  <chapter number="109" style="c" sid="PSA 109"/>
  <para style="cl">ፋርፈትና 109</para>
  <para style="ms1">ከዸትና ሃሎ ባሱፍ ዽኣቴ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 109:1"/>ያ ዋቀ አን ገለቴፈዹ</para>
  <para style="q2" vid="PSA 109:1">አት ህንጨልእስን፤<verse eid="PSA 109:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 109:2"/>ነሞትን ሀሞትኒፊ ጎዎምስቶትን፣</para>
  <para style="q2" vid="PSA 109:2">አፋንሳኒ ነት በነተኒ ጅሩቲ፤</para>
  <para style="q2" vid="PSA 109:2">እሳን አረበ ሶባቲን መቃ ነ በሌሰኒሩ።<verse eid="PSA 109:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 109:3"/>እሳን ዱቢ ጅባቲን ነ መርሰን፤</para>
  <para style="q2" vid="PSA 109:3">ሰበቢ ቶኮ መሌስ ነ ሎለን።<verse eid="PSA 109:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 109:4"/>ኡቱመ አን እሳን ጃለዹ ነ ህመተን፤</para>
  <para style="q2" vid="PSA 109:4">አን ገሩ ነንከዸዸ።<verse eid="PSA 109:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 109:5"/>ቆደ ዋን ጋሪ ሀምነ፣</para>
  <para style="q2" vid="PSA 109:5">ቆደ ጃለለኮሞ ጅበ ና ዴብሰን።<verse eid="PSA 109:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 109:6"/>አከ እን እሰ ሞርሙፍ ነመ እት ረመድ፤</para>
  <para style="q2" vid="PSA 109:6">ሴጠንስ ከራ ምርገሳ ሃዻበቱ።<verse eid="PSA 109:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 109:7"/>ዮሙ ቆረተሙት እሰት ሃሙረሙ፤</para>
  <para style="q2" vid="PSA 109:7">ከዸናንሳስ ጩቡ እሰት ሃተኡ።<verse eid="PSA 109:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 109:8"/>ኡሙሪንሳ ሃገባበቱ፣</para>
  <para style="q2" vid="PSA 109:8">ኣንጎሳ ነምን ብራ ሃፉዸቱ።<verse eid="PSA 109:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 109:9"/>እጆሌንሳ አባ መሌ ሃሀፈን፤</para>
  <para style="q2" vid="PSA 109:9">ኒቲንሳስ ሃዸ ህዬሳ ሃታቱ።<verse eid="PSA 109:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 109:10"/>እጆሌንሳ ከዸቶተ አሲፊ አች ጆረን ሃተአን፤</para>
  <para style="q2" vid="PSA 109:10">መነሳኒ ዲገማ ኬሳሌ ሃአርአመን።<verse eid="PSA 109:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 109:11"/>ዋን እን ቀቡ ሁንደ ነምን እሰራ ልቂ ቀቡ ሃፉዸቱ፤</para>
  <para style="q2" vid="PSA 109:11">ቡኣ ደዸቢሳሌ ከራ አዴምቶትን ሃሳመን።<verse eid="PSA 109:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 109:12"/>ነምን ቶኮዩ እሳፍ ህንነእን፣</para>
  <para style="q2" vid="PSA 109:12">ዮካን እጆሌሳ ከኔን አባ ህንቀብኔፍ ገራ ህንላፍን።<verse eid="PSA 109:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 109:13"/>ሰኚንሳ ሃዹሙ፤</para>
  <para style="q2" vid="PSA 109:13">መቃንሳኒ ዸሎተ እት ኣኑ ኬሳ ሃበሌፈሙ።<verse eid="PSA 109:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 109:14"/>በሌሳን አቦቲሳ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ሃያደተሙ፤</para>
  <para style="q2" vid="PSA 109:14">ጩቡን ሃዸሳስ ህንሀቀምን።<verse eid="PSA 109:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 109:15"/>አከ እን ሴናሳኒ ለፈራ በሌሱፍ፣</para>
  <para style="q2" vid="PSA 109:15">ጩቡንሳኒ ዬሮ ሁንደ ፉለ <char style="nd">ዋቀዮ</char> ዱረ ሃጅራቱ።<verse eid="PSA 109:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 109:16"/>እን ህዬዪፊ ረከቶተ፣</para>
  <para style="q2" vid="PSA 109:16">ወረ ገራንሳኒ መዳኤስ ሀመ ዱኣት ጉግሴ መሌ</para>
  <para style="q2" vid="PSA 109:16">ገራሳኒፍ ላፉ ህንያድኔቲ።<verse eid="PSA 109:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 109:17"/>እን አባሩ ጃለቴ፤</para>
  <para style="q2" vid="PSA 109:17">አባርስ ሱን እሱመት ሃዴብኡ፤</para>
  <para style="q1" vid="PSA 109:17">እን ኤብሱ ህንጃለትኔ፤</para>
  <para style="q2" vid="PSA 109:17">ኤብስ እሰራ ሃፈጋቱ።<verse eid="PSA 109:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 109:18"/>እን አኩመ ኡፈተሳት አባርሰ ኡፈተ፤</para>
  <para style="q2" vid="PSA 109:18">አባርስስ አኩመ ብሻኒ ዸግነሳ ሴነ፤</para>
  <para style="q2" vid="PSA 109:18">አኩመ ዘይቲስ ለፌሳ ልጠ።<verse eid="PSA 109:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 109:19"/>አባርስ ሱን አኩመ ኡፈተ እን እቲን ኦፍ ሀጉጉ፣</para>
  <para style="q2" vid="PSA 109:19">ሰበተ እን ዬሮ ሁንደ ህዸቱስ እሰት ሃተኡ።<verse eid="PSA 109:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 109:20"/>ከፈልቲን <char style="nd">ዋቀዮ</char> ወረ ነ ህመተኒፊ</para>
  <para style="q2" vid="PSA 109:20">ወረ ጅሬኘኮረት ዋን ሀማ ዱበተኒፍ ከፈሉ ከኑመ ሃተኡ።<verse eid="PSA 109:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 109:21"/>ያ <char style="nd">ዋቀዮ</char> ጎፍታ፣</para>
  <para style="q2" vid="PSA 109:21">አት ገሩ መቃኬቲፍ ጄዺ ነ ገርጋር፤</para>
  <para style="q2" vid="PSA 109:21">ጋሩማ ጃለለኬቲቲፍ ጄዺቲ ነ ኦልች።<verse eid="PSA 109:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 109:22"/>አን ህዬሳፊ ረከታዻቲ፤</para>
  <para style="q2" vid="PSA 109:22">ገራንኮስ ነ ኬሰት መዳኤረ።<verse eid="PSA 109:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 109:23"/>አን አኩመ ጋድዱ ገልገላ በዴረ፤</para>
  <para style="q2" vid="PSA 109:23">አኩመ ሀዋንሳስ ኦሊ ገድ ኦፈሜረ።<verse eid="PSA 109:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 109:24"/>ጅልብኮ ሶሙዻን ደዸቤረ፤</para>
  <para style="q2" vid="PSA 109:24">ዸግንኮስ ሁቀቴ ለፌት በኤረ።<verse eid="PSA 109:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 109:25"/>አን ወረ ነ ህመተን ብረት ዋን ቱፊ ተኤረ፤</para>
  <para style="q2" vid="PSA 109:25">እሳን ዮሙ ነ አርገን መታሳኒ ራሱ።<verse eid="PSA 109:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 109:26"/>ያ <char style="nd">ዋቀዮ</char> ዋቀኮ፣ ነ ገርጋር፤</para>
  <para style="q2" vid="PSA 109:26">አኩመ ጃለለኬቲትስ ነ ኦልች።<verse eid="PSA 109:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 109:27"/>ያ <char style="nd">ዋቀዮ</char>፣ አከ ወን ኩን ሀርከኬ ተኤ፣</para>
  <para style="q2" vid="PSA 109:27">አከ አት ዋን ከነ ሆጄቴ እሳን ሃቤከን።<verse eid="PSA 109:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 109:28"/>እሳን ንአባሩ፤ አት ገሩ ንኤብፍተ፤</para>
  <para style="q2" vid="PSA 109:28">ዮሙ ነት ከአን እሳን ንቃነኡ፤</para>
  <para style="q2" vid="PSA 109:28">ተጃጅላንኬ ገሩ ንገመደ።<verse eid="PSA 109:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 109:29"/>ህመቶትንኮ ሰልጵነ ሃኡፈተን፤</para>
  <para style="q2" vid="PSA 109:29">አኩመ ነመ ዋሮ ኡፈቱት ቃኒዻን ሃሀጉገመን።<verse eid="PSA 109:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 109:30"/>አን አፋንኮቲን ጉድሴ <char style="nd">ዋቀዮን</char> ነንገለቴፈዸ፤</para>
  <para style="q2" vid="PSA 109:30">ወልዳ ጉዳ ግዱትስ እሰ ነንጀጀዸ።<verse eid="PSA 109:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 109:31"/>እንስ ወረ ሉቡሳት ሙረን ጀላ እሰ ባሱፍ ጄዼ፣</para>
  <para style="q2" vid="PSA 109:31">ከራ ሀርከ ምርገ ረከታቲን ዻበታቲ።<verse eid="PSA 109:31"/></para>
  <chapter eid="PSA 109"/>
  <chapter number="110" style="c" sid="PSA 110"/>
  <para style="cl">ፋርፈትና 110</para>
  <para style="ms1">
    <char style="nd">ዋቀዮ</char> ሞቲዻፍ ኦል ኣንቱማ ኬኑሳ</para>
  <para style="d">ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 110:1"/>
    <char style="nd">ዋቀዮ</char>፣ ጎፍታኮቲን፦</para>
  <para style="b" vid="PSA 110:1"/>
  <para style="q1" vid="PSA 110:1">“ሀመ አን ዲኖተኬ ኤጄተ ሚለኬቲ ጎዹት፣</para>
  <para style="q2" vid="PSA 110:1">ከራ ምርገኮ ታእ” ጄዼ።<verse eid="PSA 110:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 110:2"/>
    <char style="nd">ዋቀዮ</char>፣ “ዲኖተኬ ግዱት ሞእ” ጄዼ</para>
  <para style="q2" vid="PSA 110:2">ቦኩ ኣንጎኬቲ ጥዮኒ ሲፍ ኤርገ።<verse eid="PSA 110:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 110:3"/>ጋፈ አት ወራናፍ ባቱ፣</para>
  <para style="q2" vid="PSA 110:3">ሎልቶትንኬ ፌዺሳኒቲን ስ ፋነ ቀጄሉ።</para>
  <para style="q1" vid="PSA 110:3">አት ገደሜሰ ገነማ ኬሳ፣</para>
  <para style="q2" vid="PSA 110:3">ሱራ ቁልቁሉ ጎንፈቴ ፍጤንሰ ደርገጉማኬቲ ቀባተ።<verse eid="PSA 110:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 110:4"/>
    <char style="nd">ዋቀዮ</char>፣ “አከ ስርነ መልኪሴዴቅት፣</para>
  <para style="q2" vid="PSA 110:4">አት ሉበ በረ በራት” ጄዼ ከከቴረ።</para>
  <para style="q2" vid="PSA 110:4">እን ያደሳ ህንጌደሩ።<verse eid="PSA 110:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 110:5"/>ጎፍታን ከራ ሀርከኬ ምርጋ ጅረ፤</para>
  <para style="q2" vid="PSA 110:5">እን ጉያ ዼከምሰሳት ሞቶተ ንቡርኩቴሰ።<verse eid="PSA 110:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 110:6"/>እን ሬፈ ቱሉዻን፣ ቡልችቶተ ጉቱማ ለፋ</para>
  <para style="q2" vid="PSA 110:6">በርበዴሱዻን ሰቦተት ሙረ።<verse eid="PSA 110:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 110:7"/>እንስ ለገ ከራ ጭነ ጅሩ ኬሳ ንዹገ፤</para>
  <para style="q2" vid="PSA 110:7">ከናፉ መታ ኦል ቀበተ።<verse eid="PSA 110:7"/></para>
  <chapter eid="PSA 110"/>
  <chapter number="111" style="c" sid="PSA 111"/>
  <para style="cl">ፋርፈትና 111</para>
  <para style="ms1">ሆጂ <char style="nd">ዋቀዮ</char> ድንቅሲፈቹ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 111:1"/>ሃሌሉያ።</para>
  <para style="b" vid="PSA 111:1"/>
  <para style="q1" vid="PSA 111:1">አን ወልዳ ቶሎታቲፊ ወል ገኢ ኬሰት፣</para>
  <para style="q2" vid="PSA 111:1">ገራኮ ጉቱዻን <char style="nd">ዋቀዮን</char> ነንገለቴፈዸ።<verse eid="PSA 111:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 111:2"/>ሆጂን <char style="nd">ዋቀዮ</char> ጉዳዸ፤</para>
  <para style="q2" vid="PSA 111:2">ወር እት ገመደን ሁንድኑስ እረ ዴዴብአኒ ያደን።<verse eid="PSA 111:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 111:3"/>ሆጂንሳ ሱረ ቀቤሳፊ ከበጀማዸ፤</para>
  <para style="q2" vid="PSA 111:3">ቀጄሉማንሳስ በረ በራን ጅራተ።<verse eid="PSA 111:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 111:4"/>እን አከ ድንቂንሳ ያደተሙ ጎዼረ፤</para>
  <para style="q2" vid="PSA 111:4">
    <char style="nd">ዋቀዮ</char> አርጃፊ ገረ ላፌሰ።<verse eid="PSA 111:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 111:5"/>እን ወረ እሰ ሶዳተኒፍ ኛተ ኬነ፤</para>
  <para style="q2" vid="PSA 111:5">ከኩሳስ በረ በራን ንያደተ።<verse eid="PSA 111:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 111:6"/>ለፈ ሰቦተ ካኒ እሳኒፍ</para>
  <para style="q2" vid="PSA 111:6">ኬኑዻን ሁምነ ሆጂሳ ሰበሳት ሙልእሴረ።<verse eid="PSA 111:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 111:7"/>ሆጂን ሀርከሳ አመነማፊ ቀጄላዸ፤</para>
  <para style="q2" vid="PSA 111:7">አጀጅንሳ ሁንድኑስ አመነማዸ።<verse eid="PSA 111:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 111:8"/>እሳንስ በረ በራ ሀመ በረ በራት ጀባተኒ ዻበቱ፤</para>
  <para style="q2" vid="PSA 111:8">አመነሙማፊ ቀጄሉማዻንስ ሆጄተሙ።<verse eid="PSA 111:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 111:9"/>እን ሰበሳቲፍ ፉሪ ኤርጌረ፤</para>
  <para style="q2" vid="PSA 111:9">ከኩሳስ በረ በራን አጀጄረ፤</para>
  <para style="q2" vid="PSA 111:9">መቃንሳ ቁልቁሉፊ ሶዳችሳዸ።<verse eid="PSA 111:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 111:10"/>
    <char style="nd">ዋቀዮን</char> ሶዳቹን ጀልቀበ ኦጉማት፤</para>
  <para style="q2" vid="PSA 111:10">ወር ስርነሳ ፋነ ቡአን ሁንድኑ ሁበትና ጋሪ ቀቡ።</para>
  <para style="q2" vid="PSA 111:10">ገለንሳ በረ በራን ጅራተ።<verse eid="PSA 111:10"/></para>
  <chapter eid="PSA 111"/>
  <chapter number="112" style="c" sid="PSA 112"/>
  <para style="cl">ፋርፈትና 112</para>
  <para style="ms1">ኤብፈሙ ነመ ቀጄላ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 112:1"/>ሃሌሉያ።</para>
  <para style="b" vid="PSA 112:1"/>
  <para style="q1" vid="PSA 112:1">ነምን <char style="nd">ዋቀዮን</char> ሶዳቱ፣</para>
  <para style="q2" vid="PSA 112:1">ከን አጀጀሳት ባይኤ ገመዱ ኤብፈማዸ።<verse eid="PSA 112:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 112:2"/>ሰኚንሳ ለፈረት ጀባ ተአ፤</para>
  <para style="q2" vid="PSA 112:2">ዸሎትን ቶሎታ ንኤብፈመ።<verse eid="PSA 112:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 112:3"/>ቀቤኚፊ በዻዹማን መነሳ ኬሰ ጅረ፤</para>
  <para style="q2" vid="PSA 112:3">ቀጄሉማንሳስ በረ በራን ጅራተ።<verse eid="PSA 112:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 112:4"/>ነመ ቶላፊ አርጃዻፍ፣</para>
  <para style="q2" vid="PSA 112:4">ገረ ላፌሳፊ ቀጄላፍ፣ <optbreak/> ዱከነ ኬሰትዩ እፍን ንበአ።<verse eid="PSA 112:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 112:5"/>ነመ አርጃፊ ነመ ዋ ነማ ልቄሱፍ፣</para>
  <para style="q2" vid="PSA 112:5">ነመ ሆጂሳ ቀጄሉማዻን አዴምስፈቱፍ <optbreak/> ዋን ጋሪቱ ተአ።<verse eid="PSA 112:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 112:6"/>ዹጉማን እን ጎንኩማ ህንራፈሙ፤</para>
  <para style="q2" vid="PSA 112:6">ነምን ቀጄላን በረ በራን ያደተመ።<verse eid="PSA 112:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 112:7"/>እን ኦዱ ሀማ ህንሶዳቱ፤</para>
  <para style="q2" vid="PSA 112:7">ገራንሳስ <char style="nd">ዋቀዮን</char> አመነቹዻን <optbreak/> ጀባቴ ዻበተ።<verse eid="PSA 112:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 112:8"/>ገራንሳ ህንራፈሙ፤ ህንሶዳቱስ፤</para>
  <para style="q2" vid="PSA 112:8">ዹመረትስ ዲኖተሳ ሞአተ።<verse eid="PSA 112:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 112:9"/>እን ንብትኔሴ፤ ህዬዪፍስ ንኬኔ፤</para>
  <para style="q2" vid="PSA 112:9">ቀጄሉማንሳ በረ በራን ንጅራተ፤</para>
  <para style="q2" vid="PSA 112:9">ጋንፍሳስ ኡልፍናን ኦል ቀበመ።<verse eid="PSA 112:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 112:10"/>ነምን ሀማን ዋን ከነ አርጌ ኣረ፤</para>
  <para style="q2" vid="PSA 112:10">እልካንሳ ቀረ፤ በቄስ ንበደ፤</para>
  <para style="q2" vid="PSA 112:10">ሀዊን ሀሞታ ፋይዳ መሌ ሀፈ።<verse eid="PSA 112:10"/></para>
  <chapter eid="PSA 112"/>
  <chapter number="113" style="c" sid="PSA 113"/>
  <para style="cl">ፋርፈትና 113</para>
  <para style="ms1">ገለተ <char style="nd">ዋቀዮፍ</char> ዽኤፈሜ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 113:1"/>ሃሌሉያ።</para>
  <para style="b" vid="PSA 113:1"/>
  <para style="q1" vid="PSA 113:1">ያ ተጃጅልቶተ <char style="nd">ዋቀዮ</char>፣ ገለተ ገልቻ፤</para>
  <para style="q2" vid="PSA 113:1">መቃ <char style="nd">ዋቀዮ</char> ጀጀዻ።<verse eid="PSA 113:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 113:2"/>አማ ሀመ በረ በራት</para>
  <para style="q2" vid="PSA 113:2">መቃን <char style="nd">ዋቀዮ</char> ሃኤብፈሙ።<verse eid="PSA 113:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 113:3"/>በአ ቢፍቱቲ ሀመ ልጠ ቢፍቱት፣</para>
  <para style="q2" vid="PSA 113:3">መቃን <char style="nd">ዋቀዮ</char> ሃጀጀሙ።<verse eid="PSA 113:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 113:4"/>
    <char style="nd">ዋቀዮ</char> ሰበ ሁንዳ ኦል ጅረ፤</para>
  <para style="q2" vid="PSA 113:4">ኡልፍንሳስ ሰሚወኒ ኦል።<verse eid="PSA 113:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 113:5"/>ከን አከ <char style="nd">ዋቀዮ</char> ዋቀኬኘ</para>
  <para style="q2" vid="PSA 113:5">እሰ ጉባ ቴሶሳረ ታኡ ሰና ኤኙ?<verse eid="PSA 113:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 113:6"/>ከን ገድ ጄዼ</para>
  <para style="q2" vid="PSA 113:6">ሰሚፊ ለፈ እላሉ ኤኙ?<verse eid="PSA 113:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 113:7"/>እን ህዬሰ አዋረ ኬሳ ንካሰ፤</para>
  <para style="q2" vid="PSA 113:7">ረከታስ ቱላ ዳራ ኬሳ ኦል ፉዸ፤<verse eid="PSA 113:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 113:8"/>እን ቡልችቶተ ግዱ፣</para>
  <para style="q2" vid="PSA 113:8">ቡልችቶተ ሰበሳ ግዱስ እሳን ቴስሰ።<verse eid="PSA 113:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 113:9"/>እን አኩመ ሃዸ እጆሌ ከን ገመቹዻን ጅራቱት፣</para>
  <para style="q2" vid="PSA 113:9">ዱበርቲ መሴነ መነሼ ኬሰ ንጅራችሰ።</para>
  <para style="b" vid="PSA 113:9"/>
  <para style="q1" vid="PSA 113:9">ሃሌሉያ።<verse eid="PSA 113:9"/></para>
  <chapter eid="PSA 113"/>
  <chapter number="114" style="c" sid="PSA 114"/>
  <para style="cl">ፋርፈትና 114</para>
  <para style="ms1">ፋርፈትና ፋሲካፍ ዽኤፈሙ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 114:1"/>ዬሮ ሰብን እስራኤል ብየ ግብጢ፣ መን ያቆብስ</para>
  <para style="q2" vid="PSA 114:1">ሰበ አፋን ኦርማ ዱበቱ ኬሳ በኤት፣<verse eid="PSA 114:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 114:2"/>ይሁዳን መነ ቁልቁሉማ ዋቃ፣</para>
  <para style="q2" vid="PSA 114:2">እስራኤልሞ ቡልቺንሰሳ ተኤ።<verse eid="PSA 114:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 114:3"/>ገላን አርጌ በቀቴ፤</para>
  <para style="q2" vid="PSA 114:3">ዮርዳኖስስ ዱበት ዴብኤ፤<verse eid="PSA 114:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 114:4"/>ቱሉወን አከ ኮርቤዪ ሆላ፣</para>
  <para style="q2" vid="PSA 114:4">ጋረንስ አኩመ ጦባላወን ሆላ ቡራቀን።<verse eid="PSA 114:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 114:5"/>ያ ገላነ፣ አት ማሊፍ በቀቴ?</para>
  <para style="q2" vid="PSA 114:5">ያ ዮርዳኖስ፣ አትስ ማሊፍ ዱበት ዴብቴ?<verse eid="PSA 114:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 114:6"/>ያ ቱሉወን፣ እስን ማሊፍ አከ ኮርቤዪ ሆላ፣</para>
  <para style="q2" vid="PSA 114:6">ያ ጋረን እስንስ ማሊፍ አከ ጦባላወን ሆላ ቡራቅጡ?<verse eid="PSA 114:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 114:7"/>ያ ለፈ፣ ፉለ ጎፍታ ዱረት፣</para>
  <para style="q2" vid="PSA 114:7">ፉለ ዋቀ ያቆብ ዱረት ሆለዹ፤<verse eid="PSA 114:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 114:8"/>እን ከታ ገረ ሀሮት፣</para>
  <para style="q2" vid="PSA 114:8">ከታ ጀባሞ ገረ ቡርቃ ብሻኒት ጌደሬ።<verse eid="PSA 114:8"/></para>
  <chapter eid="PSA 114"/>
  <chapter number="115" style="c" sid="PSA 115"/>
  <para style="cl">ፋርፈትና 115</para>
  <para style="ms1">ዋቀ ዹጋ ቶክቸ</para>
  <para style="mr">
    <ref loc="PSA 115:4-11">115፥4‑11</ref> ኩወፈ – <char style="xt"><ref loc="PSA 135:15-20">ፋር 135፥15‑20</ref></char></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 115:1"/>ኑፍ ምት፤ ያ <char style="nd">ዋቀዮ</char>፣ ኑፍ ምት፤</para>
  <para style="q2" vid="PSA 115:1">ገሩ ጃለላፊ አመነሙማኬቲፍ ጄዺቲ</para>
  <para style="q2" vid="PSA 115:1">መቃኬቲፍ ኡልፍነ ኬን።<verse eid="PSA 115:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 115:2"/>ሰቦትን ማሊፍ፣</para>
  <para style="q2" vid="PSA 115:2">“ዋቅንሳኒ ኤሰ ጅረ?” ጄዹ?<verse eid="PSA 115:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 115:3"/>ዋቅንኬኘ ሰሚ ኬሰ ጅረ፤</para>
  <para style="q2" vid="PSA 115:3">እን ዋን እሰ ገመቺሱ ከምዩ ንሆጄተ።<verse eid="PSA 115:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 115:4"/>ዋቆንሳኒ ቶልፈሞን ገሩ ሜቲፊ</para>
  <para style="q2" vid="PSA 115:4">ወርቄ ሀርከ ነማቲን ሆጄተመኒዸ።<verse eid="PSA 115:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 115:5"/>እሳን አፋን ቀቡ፤ ገሩ ዱበቹ ህንደንደአን፤</para>
  <para style="q2" vid="PSA 115:5">እጀስ ቀቡ፤ ገሩ አርጉ ህንደንደአን፤<verse eid="PSA 115:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 115:6"/>ጉረ ቀቡ፤ ገሩ ዸገኡ ህንደንደአን፤</para>
  <para style="q2" vid="PSA 115:6">ፉኛን ቀቡ፤ ገሩ ፉንፈቹ ህንደንደአን፤<verse eid="PSA 115:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 115:7"/>ሀርከ ቀቡ፤ ገሩ ቀቀበቹ ህንደንደአን፤</para>
  <para style="q2" vid="PSA 115:7">ሚለ ቀቡ፤ ገሩ ዴሙ ህንደንደአን፤</para>
  <para style="q2" vid="PSA 115:7">ላጋሳኒ ኬሰትስ ሰገሌ ቶኮሌ ህንኡመን።<verse eid="PSA 115:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 115:8"/>ወር እሳን ቶልቸን</para>
  <para style="q2" vid="PSA 115:8">ከኔን እሳን አመነተን ሁንድ አኩመሳኒ ተኡ።<verse eid="PSA 115:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 115:9"/>ያ መነ እስራኤል፣ <char style="nd">ዋቀዮን</char> አመነዹ፤</para>
  <para style="q2" vid="PSA 115:9">እን ገርጋርሳፊ ጋቸነሳኒት።<verse eid="PSA 115:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 115:10"/>ያ መነ አሮን፣ <char style="nd">ዋቀዮን</char> አመነዹ፤</para>
  <para style="q2" vid="PSA 115:10">እን ገርጋርሳፊ ጋቸነሳኒት።<verse eid="PSA 115:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 115:11"/>እስን ወር እሰ ሶዳተን፣ <char style="nd">ዋቀዮን</char> አመነዻ፤</para>
  <para style="q2" vid="PSA 115:11">እን ገርጋርሳፊ ጋቸነሳኒት።<verse eid="PSA 115:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 115:12"/>
    <char style="nd">ዋቀዮ</char> ኑ ያደተ፤ ኑ ኤብሰስ፤</para>
  <para style="q2" vid="PSA 115:12">እን መነ እስራኤል ንኤብሰ፤</para>
  <para style="q2" vid="PSA 115:12">መነ አሮንስ ንኤብሰ፤<verse eid="PSA 115:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 115:13"/>እን ወረ <char style="nd">ዋቀዮን</char> ሶዳተን፣</para>
  <para style="q2" vid="PSA 115:13">ጥናስ ጉዳስ ንኤብሰ።<verse eid="PSA 115:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 115:14"/>
    <char style="nd">ዋቀዮ</char>፣ እስኒፊ</para>
  <para style="q2" vid="PSA 115:14">እጆሌኬሰን ሃባይእሱ።<verse eid="PSA 115:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 115:15"/>
    <char style="nd">ዋቀዮ</char> ሰሚፊ</para>
  <para style="q2" vid="PSA 115:15">ለፈ ኡሜ ሱን እስን ሃኤብሱ።<verse eid="PSA 115:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 115:16"/>ሰሚን ሰሚወኒ ኦሊስ ከን <char style="nd">ዋቀዮት</char>፤</para>
  <para style="q2" vid="PSA 115:16">ለፈ ገሩ እን ነማፍ ኬኔረ።<verse eid="PSA 115:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 115:17"/>ወር ዱአን ዮካን ወር ገረ እዶ ጨልእሰንት ገድ ቡአን</para>
  <para style="q2" vid="PSA 115:17">
    <char style="nd">ዋቀዮን</char> ገለቴፈቹ ህንደንደአን፤<verse eid="PSA 115:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 115:18"/>ኑ ገሩ አማ ጀልቀብኔ በረ በራን</para>
  <para style="q2" vid="PSA 115:18">
    <char style="nd">ዋቀዮን</char> ንኤብፍነ።</para>
  <para style="b" vid="PSA 115:18"/>
  <para style="q1" vid="PSA 115:18">ሃሌሉያ።<verse eid="PSA 115:18"/></para>
  <chapter eid="PSA 115"/>
  <chapter number="116" style="c" sid="PSA 116"/>
  <para style="cl">ፋርፈትና 116</para>
  <para style="ms1">ሃሌሉያ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 116:1"/>አን <char style="nd">ዋቀዮን</char> ነንጃለዸ፤</para>
  <para style="q2" vid="PSA 116:1">እን ሰገሌ ዋመተኮቲ ና ዸገኤራቲ።<verse eid="PSA 116:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 116:2"/>ሰበቢ እን ጉረሳ ገረኮት ዴብሴፍ፣</para>
  <para style="q2" vid="PSA 116:2">አን ሀመን ሉቡን ጅራዹት እሰ ነንዋመዸ።<verse eid="PSA 116:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 116:3"/>ክዮን ዱኣ ነ መርሴ፤</para>
  <para style="q2" vid="PSA 116:3">ዽጵን ሲኦልስ ነ ቀበቴ፤</para>
  <para style="q2" vid="PSA 116:3">አን ረክናፊ ገዳን ነንሞአሜ።<verse eid="PSA 116:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 116:4"/>አንስ፣ “ያ <char style="nd">ዋቀዮ</char> ነ ኦልች!” ጄዼ</para>
  <para style="q2" vid="PSA 116:4">መቃ <char style="nd">ዋቀዮ</char> ነንዋመዼ።<verse eid="PSA 116:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 116:5"/>
    <char style="nd">ዋቀዮ</char> አርጃፊ ቀጄላዸ፤</para>
  <para style="q2" vid="PSA 116:5">ዋቅንኬኘ ገረ ላፌሰ።<verse eid="PSA 116:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 116:6"/>
    <char style="nd">ዋቀዮ</char> ገራሞተ ንኤገ፤</para>
  <para style="q2" vid="PSA 116:6">ዬሮ አን ባይኤ ረከዼት እሰቱ ነ ገርጋሬ።<verse eid="PSA 116:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 116:7"/>ያ ሉቡኮ፣ ቦቆናኬት ዴብእ፤</para>
  <para style="q2" vid="PSA 116:7">
    <char style="nd">ዋቀዮ</char> ዋን ጋሪ ሲፍ ጎዼራቲ።<verse eid="PSA 116:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 116:8"/>አት ያ <char style="nd">ዋቀዮ</char> ሉቡኮ ዱአራ፣</para>
  <para style="q2" vid="PSA 116:8">እጀኮ እምማንራ፣</para>
  <para style="q2" vid="PSA 116:8">ሚለኮ ጉፈቹራ ዋን ኦልችቴፍ፣<verse eid="PSA 116:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 116:9"/>አን ብየ ወረ ጅራቶ ኬሰ፣</para>
  <para style="q2" vid="PSA 116:9">ፉለ <char style="nd">ዋቀዮ</char> ዱረ ነንጅራዸ።<verse eid="PSA 116:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 116:10"/>አን ዬሮ፣ “አን ባይኤ ዽጰዼረ” ጄዼት፣</para>
  <para style="q2" vid="PSA 116:10">አመንቲኮ ኤገዼረ።<verse eid="PSA 116:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 116:11"/>አን ዮሙን ቡርጃጀኤት፣</para>
  <para style="q2" vid="PSA 116:11">“ነምን ሁንድኑ ሶብዱዸ” ነንጄዼ።<verse eid="PSA 116:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 116:12"/>ዋን ጋሪ እን ና ጎዼ ሁንዳፍ፣</para>
  <para style="q2" vid="PSA 116:12">አን <char style="nd">ዋቀዮፍ</char> ማለን ዴብሰ?<verse eid="PSA 116:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 116:13"/>አን ጦፎ ፈይና ኦል ካሴ</para>
  <para style="q2" vid="PSA 116:13">መቃ <char style="nd">ዋቀዮ</char> ነንዋመዸ።<verse eid="PSA 116:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 116:14"/>ፉለ ሰበሳ ሁንዱማ ዱረት፣</para>
  <para style="q2" vid="PSA 116:14">አን ወሬገኮ <char style="nd">ዋቀዮፍ</char> ነንገልቸ።<verse eid="PSA 116:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 116:15"/>ዱት ቁልቁሎተሳ፣</para>
  <para style="q2" vid="PSA 116:15">ፉለ <char style="nd">ዋቀዮ</char> ዱረት ኡልፍነ ቀበ።<verse eid="PSA 116:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 116:16"/>ያ <char style="nd">ዋቀዮ</char>፣ አን ዹጉማን ተጃጅላኬት፤</para>
  <para style="q2" vid="PSA 116:16">አን ተጃጅላኬ እልመ ተጃጅልቱኬቲት፤</para>
  <para style="q2" vid="PSA 116:16">አት ፎንጫኮ ነራ ሂክቴርተ።<verse eid="PSA 116:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 116:17"/>አን ኣርሳ ገለታ ሲፍ ነንዽኤሰ፤</para>
  <para style="q2" vid="PSA 116:17">መቃ <char style="nd">ዋቀዮስ</char> ነንዋመዸ።<verse eid="PSA 116:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 116:18"/>እዶ ሰብንሳ ሁንድ ጅሩት፣</para>
  <para style="q2" vid="PSA 116:18">አን ወሬገኮ <char style="nd">ዋቀዮፍ</char> ነንገልቸ፤<verse eid="PSA 116:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 116:19"/>ያ ዬሩሳሌም ስ ኬሰት፣</para>
  <para style="q2" vid="PSA 116:19">ኦብዲ መነ <char style="nd">ዋቀዮረትስ</char> ነንገልቸ።</para>
  <para style="b" vid="PSA 116:19"/>
  <para style="q1" vid="PSA 116:19">ሃሌሉያ።<verse eid="PSA 116:19"/></para>
  <chapter eid="PSA 116"/>
  <chapter number="117" style="c" sid="PSA 117"/>
  <para style="cl">ፋርፈትና 117</para>
  <para style="ms1">ዋምቸ ገለታ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 117:1"/>ሰቦትን ሁንድ <char style="nd">ዋቀዮን</char> ጀጀዻ፤</para>
  <para style="q2" vid="PSA 117:1">እስን ነሞትን ሁንድኑ እሰ ሌልሳ።<verse eid="PSA 117:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 117:2"/>ጃለል እን ኑፍ ቀቡ ጉዳዻቲ፤</para>
  <para style="q2" vid="PSA 117:2">አመነሙማን <char style="nd">ዋቀዮ</char> በረ በራን ጅራተ።</para>
  <para style="b" vid="PSA 117:2"/>
  <para style="q1" vid="PSA 117:2">ሃሌሉያ።<verse eid="PSA 117:2"/></para>
  <chapter eid="PSA 117"/>
  <chapter number="118" style="c" sid="PSA 118"/>
  <para style="cl">ፋርፈትና 118</para>
  <para style="ms1">ፋርፈትና አያነ ዳሲ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 118:1"/>
    <char style="nd">ዋቀዮፍ</char> ገለተ ገልቻ፤ እን ጋሪዻቲ፤</para>
  <para style="q2" vid="PSA 118:1">ጃለልሳ በረ በራን ጅራተ።<verse eid="PSA 118:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 118:2"/>ሰብን እስራኤል፣ “ጃለልሳ</para>
  <para style="q2" vid="PSA 118:2">በረ በራን ጅራተ” ሃጄዹ።<verse eid="PSA 118:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 118:3"/>መን አሮንስ፣</para>
  <para style="q2" vid="PSA 118:3">“ጃለልሳ በረ በራን ጅራተ” ሃጄዹ።<verse eid="PSA 118:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 118:4"/>ወር <char style="nd">ዋቀዮን</char> ሶዳተን፣</para>
  <para style="q2" vid="PSA 118:4">“ጃለልሳ በረ በራን ጅራተ” ሃጄዸን።<verse eid="PSA 118:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 118:5"/>ዽጵነኮ ኬሰት አን <char style="nd">ዋቀዮት</char> ነንእየዼ፤</para>
  <para style="q2" vid="PSA 118:5">እንስ ዴቢ ና ኬኔ፤ እዶ በልኣስ ነ ቁበቺሴ።<verse eid="PSA 118:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 118:6"/>
    <char style="nd">ዋቀዮ</char> ነ ወጅን ጅረ፤ አን ህንሶዳዹ፤</para>
  <para style="q2" vid="PSA 118:6">ነምን ማል ነ ጎቹ ደንደአ?<verse eid="PSA 118:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 118:7"/>
    <char style="nd">ዋቀዮ</char> ነ ወጅን ጅረ፤ እን ገርጋራኮት።</para>
  <para style="q2" vid="PSA 118:7">አንስ ዲኖተኮ ነንሞአዸ።<verse eid="PSA 118:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 118:8"/>ነመ አመነቹረ፣</para>
  <para style="q2" vid="PSA 118:8">
    <char style="nd">ዋቀዮት</char> ኮሉ ገሉ ወየ።<verse eid="PSA 118:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 118:9"/>ቆንዳልቶተ አመነቹረ፣</para>
  <para style="q2" vid="PSA 118:9">
    <char style="nd">ዋቀዮት</char> ኮሉ ገሉ ወየ።<verse eid="PSA 118:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 118:10"/>ሰቦትን ሁንድኑ ነ መርሰን፤</para>
  <para style="q2" vid="PSA 118:10">አን ገሩ መቃ <char style="nd">ዋቀዮቲን</char> እሳን ነንበርበዴሴ።<verse eid="PSA 118:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 118:11"/>እሳን ከራ ሁንዳን ነ መርሰን፤</para>
  <para style="q2" vid="PSA 118:11">አን ገሩ መቃ <char style="nd">ዋቀዮቲን</char> እሳን ነንበርበዴሴ።<verse eid="PSA 118:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 118:12"/>አኩመ ቱተ ከኒሳ ነ መርሰን፤</para>
  <para style="q2" vid="PSA 118:12">ገሩ አከ ቆራቲ ጉበቱት በርበዳአን፤</para>
  <para style="q2" vid="PSA 118:12">አንስ መቃ <char style="nd">ዋቀዮቲን</char> እሳን ነንበርበዴሴ።<verse eid="PSA 118:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 118:13"/>አን ዺበሜ ኩፉ ገኤን ቱሬ፤</para>
  <para style="q2" vid="PSA 118:13">
    <char style="nd">ዋቀዮ</char> ገሩ ነ ገርጋሬ።<verse eid="PSA 118:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 118:14"/>
    <char style="nd">ዋቀዮ</char> ጀብነኮቲፊ ፋርፈትናኮት፤</para>
  <para style="q2" vid="PSA 118:14">እን ፈይነኮ ተኤረ።<verse eid="PSA 118:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 118:15"/>ሰገሌን ገመቹቲፊ ሞአትና ዱንካኖተ</para>
  <para style="q2" vid="PSA 118:15">ቀጄልቶታ ኬሳ ንዸገአመ፤</para>
  <para style="q1" vid="PSA 118:15">“ሀርክ <char style="nd">ዋቀዮ</char> ከን ምርጋ ዋን ጀባ ሆጄቴረ!<verse eid="PSA 118:15"/></para>
  <para style="q2">
    <verse number="16" style="v" sid="PSA 118:16"/>ሀርክ <char style="nd">ዋቀዮ</char> ምርጋ ኦል ቀበሜረ፤</para>
  <para style="q2" vid="PSA 118:16">ሀርክ <char style="nd">ዋቀዮ</char> ምርጋ ዋን ጀባ ሆጄቴረ!”<verse eid="PSA 118:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 118:17"/>አን ነንጅራዸ መሌ ህንዱኡ፤</para>
  <para style="q2" vid="PSA 118:17">ዋን <char style="nd">ዋቀዮ</char> ሆጄቴስ ነንለብሰ።<verse eid="PSA 118:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 118:18"/>
    <char style="nd">ዋቀዮ</char> ጀቤሴ ነ አደቤረ፤</para>
  <para style="q2" vid="PSA 118:18">ገሩ ደበርሴ ዱአት ነ ህንኬንኔ።<verse eid="PSA 118:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 118:19"/>ከረ ቀጄሉማ ና በና፤</para>
  <para style="q2" vid="PSA 118:19">አንስ ኦል ገሌ <char style="nd">ዋቀዮፍ</char> ገለተ ነንገልቸ።<verse eid="PSA 118:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 118:20"/>ኩን ከረ <char style="nd">ዋቀዮ</char>፣</para>
  <para style="q2" vid="PSA 118:20">ከን ቀጄልቶትን እቲን ኦል ገለኒዸ።<verse eid="PSA 118:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 118:21"/>አት ዴቢ ና ኬንቴርታቲ፣ አን ስን ገለቴፈዸ፤</para>
  <para style="q2" vid="PSA 118:21">አት ፈይነ ና ታቴርተ።<verse eid="PSA 118:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 118:22"/>ዸጋን እጃርቶትን ቱፈተን፣</para>
  <para style="q2" vid="PSA 118:22">ዸጋ ጎሌ ተኤረ፤<verse eid="PSA 118:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 118:23"/>
    <char style="nd">ዋቀዮ</char> ዋን ከነ ሆጄቴረ፤</para>
  <para style="q2" vid="PSA 118:23">ኩንስ እጀኬኘት ድንቂዸ።<verse eid="PSA 118:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 118:24"/>ጉያን ኩን ጉያ <char style="nd">ዋቀዮ</char> ኡሜዸ፤</para>
  <para style="q2" vid="PSA 118:24">ኮታ ንእልልችነ፤ እት ገመድነስ።<verse eid="PSA 118:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 118:25"/>ያ <char style="nd">ዋቀዮ</char>፣ ስከዸትና ኑ ኦልች፤</para>
  <para style="q2" vid="PSA 118:25">ያ <char style="nd">ዋቀዮ</char>፣ ስ ከዸትና ኑ ምልኮምስ።<verse eid="PSA 118:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 118:26"/>ከን መቃ <char style="nd">ዋቀዮቲን</char> ዹፉ ኤብፈማዸ።</para>
  <para style="q2" vid="PSA 118:26">ኑ መነ <char style="nd">ዋቀዮ</char> ኬሳ እስን ኤብፍነ።<verse eid="PSA 118:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 118:27"/>
    <char style="nd">ዋቀዮ</char> ዋቀ፤</para>
  <para style="q2" vid="PSA 118:27">እፈሳስ ኑረት እብሴረ።</para>
  <para style="q1" vid="PSA 118:27">ደሜወን ሀርከት ቀበዻቲ <optbreak/> ወረ አያኔፈቹ ዸቀንት መከማ፤</para>
  <para style="q2" vid="PSA 118:27">ገረ ጋንፈወን እዶ ኣርሳስ ዸቃ።<verse eid="PSA 118:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 118:28"/>አት ዋቀኮት፤ አን ስን ገለቴፈዸ፤</para>
  <para style="q2" vid="PSA 118:28">አት ዋቀኮት፤ አንስ ስን ሌልሰ።<verse eid="PSA 118:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 118:29"/>
    <char style="nd">ዋቀዮፍ</char> ገለተ ገልቻ፤ እን ጋሪዻቲ፤</para>
  <para style="q2" vid="PSA 118:29">ጃለልሳ በረ በራን ጅራተ።<verse eid="PSA 118:29"/></para>
  <chapter eid="PSA 118"/>
  <chapter number="119" style="c" sid="PSA 119"/>
  <para style="cl">ፋርፈትና 119</para>
  <para style="ms1">ሴረ ዋቃ ጀጀቹ</para>
  <para style="qa">א አሌፍ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 119:1"/>ወር ጅሬኝሳኒ ሙዳ ህንቀብኔ፣</para>
  <para style="q2" vid="PSA 119:1">ከኔን አከ ሴረ <char style="nd">ዋቀዮት</char> ጅራተን ኤብፈሞዸ።<verse eid="PSA 119:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 119:2"/>ወር አጀጀወንሳ ኤገን፣</para>
  <para style="q2" vid="PSA 119:2">ከኔን ገራ ጉቱን እሰ በርባደን ኤብፈሞዸ።<verse eid="PSA 119:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 119:3"/>እሳን በሌሳ ህንሆጄተን፤</para>
  <para style="q2" vid="PSA 119:3">ከራሳረስ ንዴሙ።<verse eid="PSA 119:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 119:4"/>አከ ሴርኬ አመነሙማዻን</para>
  <para style="q2" vid="PSA 119:4">ኤገሙፍ አት አጀጄርተ።<verse eid="PSA 119:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 119:5"/>አከ አን አጀጀኬ ኤጉፍ</para>
  <para style="q2" vid="PSA 119:5">ኡቱ ከራንኮ ና ቀጄሌ ጅራቴ!<verse eid="PSA 119:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 119:6"/>አን ኡቱን አጀጀወንኬ ሁንደ ጥዬፈዼ እላሌ</para>
  <para style="q2" vid="PSA 119:6">ስላ ህንቃነኡን ቱሬ።<verse eid="PSA 119:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 119:7"/>አን ዮሙን ሴረኬ ቀጄላ ሰነ በረዹት፣</para>
  <para style="q2" vid="PSA 119:7">ገራ ቶላዻን ስን ገለቴፈዸ።<verse eid="PSA 119:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 119:8"/>አን ስርነኬቲፍ ነንቡለ፤</para>
  <para style="q2" vid="PSA 119:8">አት ጎንኩማ ነ ህንዺስን።<verse eid="PSA 119:8"/></para>
  <para style="qa">ב ቤት</para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 119:9"/>ደርገጌስ አከምት ጅሬኘ ቁልቁሉ ጅራቹ ደንደአ?</para>
  <para style="q2" vid="PSA 119:9">አከ ዱቢኬቲት ጅራቹዻን።<verse eid="PSA 119:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 119:10"/>አን ገራኮ ጉቱዻን ስን በርባደ፤</para>
  <para style="q2" vid="PSA 119:10">አከ አን አጀጀወንኬራ ጀልአዹ ነ ህንጎዽን።<verse eid="PSA 119:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 119:11"/>አን አከን ጩቡ ስት ህንሆጄትኔፍ፣</para>
  <para style="q2" vid="PSA 119:11">ዱቢኬ ገራኮ ኬሰ ዾክፈዼረ።<verse eid="PSA 119:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 119:12"/>ያ <char style="nd">ዋቀዮ</char>፣ ገለን ሲፍ ሃተኡ፤</para>
  <para style="q2" vid="PSA 119:12">ስርነኬ ነ በርሲስ።<verse eid="PSA 119:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 119:13"/>አን ሴረ አፋንኬቲ በኡ ሁንዱማ፣</para>
  <para style="q2" vid="PSA 119:13">አፋንኮቲን ነንዱበዸ።<verse eid="PSA 119:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 119:14"/>አኩመ ነምን ቶኮ በዻዹማ ጉዳት ገመዱ፣</para>
  <para style="q2" vid="PSA 119:14">አን አጀጀኬ ፋነ ቡኡት ነንገመደ።<verse eid="PSA 119:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 119:15"/>አጀጀወንኬረ ዴዴብኤ ነንያደ፤</para>
  <para style="q2" vid="PSA 119:15">ከራኬራስ እጀኮ ህንቡቅፈዹ።<verse eid="PSA 119:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 119:16"/>አን ስርነኬት ነንገመደ፤</para>
  <para style="q2" vid="PSA 119:16">ዱቢኬስ ህንደገዹ።<verse eid="PSA 119:16"/></para>
  <para style="qa">ג ጊሜል</para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 119:17"/>አከ አን ጅራዹፊ ዱቢኬ ኤጉፍ፣</para>
  <para style="q2" vid="PSA 119:17">ገርብቸኬቲፍ ዋን ጋሪ ጎዽ።<verse eid="PSA 119:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 119:18"/>አከ አን ሴረኬ ኬሰት</para>
  <para style="q2" vid="PSA 119:18">ዋን ድንቅሲሳ አርጉፍ፣ እጀኮ ና በን።<verse eid="PSA 119:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 119:19"/>አን ለፈረት ኬሱማዸ፤</para>
  <para style="q2" vid="PSA 119:19">አጀጀወንኬ ነ ዱራ ህንዾክስን።<verse eid="PSA 119:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 119:20"/>ሉቡንኮ ዬሮ ሁንደ</para>
  <para style="q2" vid="PSA 119:20">ሴረኬ ሀዉዻን፣ ላፋ ጅርት።<verse eid="PSA 119:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 119:21"/>አት ኦፍ ቱልቶተ ወረ አባረሞ፣</para>
  <para style="q2" vid="PSA 119:21">ከኔን አጀጀወንኬራ ጀልአተን ንእፈተ።<verse eid="PSA 119:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 119:22"/>ዋን አን ሴረኬ ኤጉፍ፣</para>
  <para style="q2" vid="PSA 119:22">አረብሶፊ ቱፊሳኒ ነራ ፈጌስ።<verse eid="PSA 119:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 119:23"/>ቡልችቶትን ወሊ ወጅን ታአኒ ዮ መቃ ነ በሌሰንዩ፣</para>
  <para style="q2" vid="PSA 119:23">ተጃጅላንኬ እረ ዴዴብኤ ለብሲኬ ንያደ።<verse eid="PSA 119:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 119:24"/>አጀጅንኬ ገመቹኮት፤</para>
  <para style="q2" vid="PSA 119:24">ጎርስቱኮትስ።<verse eid="PSA 119:24"/></para>
  <para style="qa">ד ዳሌት</para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 119:25"/>ሉቡንኮ ብዮት መጠንቴ፤</para>
  <para style="q2" vid="PSA 119:25">አት አኩመ ዱቢኬቲት ነ ኦልች።<verse eid="PSA 119:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 119:26"/>ዬሮ አን ዋኤ ከራኮ ስት ህሜት፣</para>
  <para style="q2" vid="PSA 119:26">አት ዴቢ ና ኬንቴ፤ ስርነኬስ ነ በርሲስ።<verse eid="PSA 119:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 119:27"/>በርሲሰ ሴረኬቲ ነ ሁበቺስ፤</para>
  <para style="q2" vid="PSA 119:27">አንስረ ዴዴብኤ ድንቂኬ ነንያደ።<verse eid="PSA 119:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 119:28"/>ሉቡንኮ ገዳን ላፍቴርት፤</para>
  <para style="q2" vid="PSA 119:28">አት አኩመ ዱቢኬቲት ነ ጀቤስ።<verse eid="PSA 119:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 119:29"/>ከራ ሶባራ ነ ፈጌስ፤</para>
  <para style="q2" vid="PSA 119:29">አርጁማዻንስ ሴረኬ ነ በርሲስ።<verse eid="PSA 119:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 119:30"/>አን ከራ ዹጋ ፍለዼረ፤</para>
  <para style="q2" vid="PSA 119:30">ሴረኬስ ኦፍ ዱረ ካአዼረ።<verse eid="PSA 119:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 119:31"/>ያ <char style="nd">ዋቀዮ</char>፣ አን አጀጀኬ</para>
  <para style="q2" vid="PSA 119:31">ጀቤሴ ቀበዼረ፤ አት ነ ህንቃኔስን።<verse eid="PSA 119:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 119:32"/>ሰበቢ አት ሁበትናኮ ና በልእፍቴፍ</para>
  <para style="q2" vid="PSA 119:32">አን ዳንዲ አጀጀወንኬቲረ ነንፊገ።<verse eid="PSA 119:32"/></para>
  <para style="qa">ה ሄ</para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 119:33"/>ያ <char style="nd">ዋቀዮ</char>፣ አከ አን ስርነኬ ዱካ ቡኡ ነ በርሲስ፤</para>
  <para style="q2" vid="PSA 119:33">አንስ ሀመ ዹማት እሰ ነንኤገ።<verse eid="PSA 119:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 119:34"/>አከ አን ሴረኬ ኤጌ ገራኮ ጉቱን</para>
  <para style="q2" vid="PSA 119:34">እሳፍ አጀጀሙፍ ሁበትና ና ኬን።<verse eid="PSA 119:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 119:35"/>ዳንዲ አጀጀወንኬቲረ ነ ዴምስስ፤</para>
  <para style="q2" vid="PSA 119:35">አንስ አችት ገመቹ ነንአርገዻቲ።<verse eid="PSA 119:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 119:36"/>ገራኮ ገረ ኦፍቱማዻን ፋይዳ አርገቹት ኡቱ ህንተእን፣</para>
  <para style="q2" vid="PSA 119:36">ገረ ስርነኬቲት ና ዴብስ።<verse eid="PSA 119:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 119:37"/>እጀኮ ዋን ፋይዳ ህንቀብኔራ ዴብስ፤</para>
  <para style="q2" vid="PSA 119:37">አኩመ ዱቢኬቲትስ ነ ጅራችስ።<verse eid="PSA 119:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 119:38"/>አት አከ ሶዳተምቱፍ፣</para>
  <para style="q2" vid="PSA 119:38">ዋዳኬ ገርብቸኬቲፍ ጉት።<verse eid="PSA 119:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 119:39"/>ሰልጵነ አን ሶዳዹ ነራ ፈጌስ፤</para>
  <para style="q2" vid="PSA 119:39">ሴርኬ ጋሪዻቲ።<verse eid="PSA 119:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 119:40"/>ኩኖ፣ አን ስርነኬ ነንሀወ፤</para>
  <para style="q2" vid="PSA 119:40">ቀጄሉማኬቲን ነ ጅራችስ።<verse eid="PSA 119:40"/></para>
  <para style="qa">ו ወው</para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 119:41"/>ያ <char style="nd">ዋቀዮ</char>፣ ጃለልኬ ከን ህንጌደረምኔ ሱን፣</para>
  <para style="q2" vid="PSA 119:41">ፈይሱንኬስ አኩመ ዱቢኬቲት ገረኮ ሃዹፉ፤<verse eid="PSA 119:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 119:42"/>ዮስ አን ሰበቢ ዱቢኬ አመነዹፍ፣</para>
  <para style="q2" vid="PSA 119:42">ወረ ነ አረብሰኒፍ ዴቢ ኬነ።<verse eid="PSA 119:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 119:43"/>ዋን አን ሴረኬ አብደዼፍ፣</para>
  <para style="q2" vid="PSA 119:43">አት ዱቢ ዹጋ አፋንኮ ኬሳ ህንበሌስን።<verse eid="PSA 119:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 119:44"/>በረ በራ ሀመ በረ በራት፣</para>
  <para style="q2" vid="PSA 119:44">አን ዬሮ ሁንደ ሴረኬ ነንኤገ።<verse eid="PSA 119:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 119:45"/>አን አጀጀኬ ዋነን በርባዱፍ፣</para>
  <para style="q2" vid="PSA 119:45">ብልሱማዻን ነንዴዴብአ።<verse eid="PSA 119:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 119:46"/>አን ዋኤ አጀጀኬቲ ሞቶተ ዱረት ነንዱበዸ፤</para>
  <para style="q2" vid="PSA 119:46">ህንቃኔፈሙስ፤<verse eid="PSA 119:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 119:47"/>ዋን አን አጀጀወንኬ ጃለዹፍ፣</para>
  <para style="q2" vid="PSA 119:47">እሳንት ነንገመደ።<verse eid="PSA 119:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 119:48"/>አን ገረ አጀጀወንኬ ከኔን አን ጃለዹ ሰናት <optbreak/> ሀርከኮ ኦል ነንፉዸዸ፤</para>
  <para style="q2" vid="PSA 119:48">ለብሲኬስ እረ ዴዴብኤ ነንያደ።<verse eid="PSA 119:48"/></para>
  <para style="qa">ז ዛይን</para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 119:49"/>ዋዳ ተጃጅላኬቲፍ ሴንቴ ሰነ ያደዹ፤</para>
  <para style="q2" vid="PSA 119:49">አት እሱማን አብዲ ና ኬንቴርታቲ።<verse eid="PSA 119:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 119:50"/>ረክነኮ ኬሰት ጀጀብንኮ ከነ፦</para>
  <para style="q2" vid="PSA 119:50">ዋዳንኬ ነ ጅራችሰ።<verse eid="PSA 119:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 119:51"/>ኦፍ ቱልቶትን አኩመ በርባደንት ነት ቆሱ፤</para>
  <para style="q2" vid="PSA 119:51">አን ገሩ ሴረኬራ ህንጀልአዹ።<verse eid="PSA 119:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 119:52"/>ያ <char style="nd">ዋቀዮ</char>፣ አን ሴረኬ ዱሪ ሰነ ነንያደዸ፤</para>
  <para style="q2" vid="PSA 119:52">እሰ ኬሰትስ ጀጀብነ ነንአርገዸ።<verse eid="PSA 119:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 119:53"/>ሰበቢ ሀሞተ ወረ ሴረኬ ዺሰኒቲፍ፣</para>
  <para style="q2" vid="PSA 119:53">ኣሪን ነ ጉጉበ።<verse eid="PSA 119:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 119:54"/>እዶ ኬሱሙማኮ ሁንደት</para>
  <para style="q2" vid="PSA 119:54">ሴርኬ ፋርፈትናኮት።<verse eid="PSA 119:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 119:55"/>ያ <char style="nd">ዋቀዮ</char>፣ አን ሀልከን ኬሰ መቃኬ ነንያደዸ፤</para>
  <para style="q2" vid="PSA 119:55">ሴረኬስ ነንኤገ።<verse eid="PSA 119:55"/></para>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 119:56"/>ዋን አን አጀጀኬ ኤጌፍ፣</para>
  <para style="q2" vid="PSA 119:56">ኩን ናፍ ተኤረ።<verse eid="PSA 119:56"/></para>
  <para style="qa">ח ሄት</para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 119:57"/>ያ <char style="nd">ዋቀዮ</char>፣ አት ቆደኮት፤</para>
  <para style="q2" vid="PSA 119:57">አንስ ዱቢኬቲፍ አጀጀሙፍ ዋዳ ገሌረ።<verse eid="PSA 119:57"/></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 119:58"/>አን ገራኮ ጉቱን ፉለኬ በርባደዼረ፤</para>
  <para style="q2" vid="PSA 119:58">አት አኩመ ዋዳኬቲት ና አራረም።<verse eid="PSA 119:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 119:59"/>አን ከራኮ እት ዴዴብኤ ያዴረ፤</para>
  <para style="q2" vid="PSA 119:59">ተርካንፊኮ ገረ ስርነኬቲት ዴብሴረ።<verse eid="PSA 119:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 119:60"/>አን አጀጀወንኬ ኤጉፍ፣</para>
  <para style="q2" vid="PSA 119:60">ነንአሪፈዸ፤ ህንበርፈዹስ።<verse eid="PSA 119:60"/></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 119:61"/>ሀሞን ዮ ፉኞዻን ነ ህዸንዩ፣</para>
  <para style="q2" vid="PSA 119:61">አን ሴረኬ ህንእራንፈዹ።<verse eid="PSA 119:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 119:62"/>ሰበቢ ሴረኬ ቀጄላ ሰናቲፍ፣</para>
  <para style="q2" vid="PSA 119:62">አን ስ ገለቴፈቹፍ ጄዼ ሀልከን ወለካ ነንከአ።<verse eid="PSA 119:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 119:63"/>አን ወረ ስ ሶዳተን ሁንዳፍ፣</para>
  <para style="q2" vid="PSA 119:63">ወረ አጀጀኬ ኤገን ሁንዳፍስ ምቹዸ።<verse eid="PSA 119:63"/></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 119:64"/>ያ <char style="nd">ዋቀዮ</char>፣ ለፍት ጃለለኬቲን ጉተምቴርት፤</para>
  <para style="q2" vid="PSA 119:64">ስርነኬ ነ በርሲስ።<verse eid="PSA 119:64"/></para>
  <para style="qa">ט ቴት</para>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 119:65"/>ያ <char style="nd">ዋቀዮ</char>፣ አት አኩመ ዱቢኬቲት፣</para>
  <para style="q2" vid="PSA 119:65">ተጃጅላኬቲፍ ዋን ጋሪ ጎቴርተ።<verse eid="PSA 119:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 119:66"/>ሙርቲ ጋሪፊ ቤኩምሰ ነ በርሲስ፤</para>
  <para style="q2" vid="PSA 119:66">አን አጀጀወንኬት ነንአመናቲ።<verse eid="PSA 119:66"/></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 119:67"/>አን ኡቱን ህንረከትን ከራራ በዴ ቱሬ፤</para>
  <para style="q2" vid="PSA 119:67">አመ ገሩ ዱቢኬ ነንኤገ።<verse eid="PSA 119:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 119:68"/>አት ጋሪዸ፤ ወን አት ሆጄቱስ ጋሪዸ፤</para>
  <para style="q2" vid="PSA 119:68">ስርነኬ ነ በርሲስ።<verse eid="PSA 119:68"/></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 119:69"/>ኦፍ ቱልቶትን ዮ ሶባን መቃ ነ በሌሰንዩ፣</para>
  <para style="q2" vid="PSA 119:69">አን ገራኮ ጉቱዻን ሴረኬ ነንኤገ።<verse eid="PSA 119:69"/></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 119:70"/>ኦኔንሳኒ ሞራን ሀጉገምቴርት፤</para>
  <para style="q2" vid="PSA 119:70">አን ገሩ ሴረኬት ነንገመደ።<verse eid="PSA 119:70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 119:71"/>አከ አን ስርነኬ በረዹፍ፣</para>
  <para style="q2" vid="PSA 119:71">ረከቹንኮ አናፍ ጋሪ ቱሬ።<verse eid="PSA 119:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 119:72"/>ሜቲፊ ወርቄ ኩማተመረ፣</para>
  <para style="q2" vid="PSA 119:72">ሴር አፋንኬቲ በኡ አናፍ ጋሪዸ።<verse eid="PSA 119:72"/></para>
  <para style="qa">י ዮድ</para>
  <para style="q1">
    <verse number="73" style="v" sid="PSA 119:73"/>ሀርክኬ ነ ኡሜ፤ ነ ቶልቼስ፤</para>
  <para style="q2" vid="PSA 119:73">አከ አን አጀጀኬ በረዹፍ አት ሁበትና ና ኬን።<verse eid="PSA 119:73"/></para>
  <para style="q1">
    <verse number="74" style="v" sid="PSA 119:74"/>ሰበቢ አን ዱቢኬ አብደዼፍ፣</para>
  <para style="q2" vid="PSA 119:74">ወር ስ ሶዳተን ዮሙ ነ አርገንት ሃገመደን።<verse eid="PSA 119:74"/></para>
  <para style="q1">
    <verse number="75" style="v" sid="PSA 119:75"/>ያ <char style="nd">ዋቀዮ</char>፣ አን አከ ሙርቲንኬ ቀጄላ ተኤ፣</para>
  <para style="q2" vid="PSA 119:75">አከ አትስ አመነሙማዻን ነ ዽጵስቴ ቤከ።<verse eid="PSA 119:75"/></para>
  <para style="q1">
    <verse number="76" style="v" sid="PSA 119:76"/>አኩመ አት ተጃጅላኬቲፍ ዋዳ ገልቴ ሰነት፣</para>
  <para style="q2" vid="PSA 119:76">ጃለልኬ ከን ህንጌደረምኔ ሱን ነ ሃጀጀቤሱ።<verse eid="PSA 119:76"/></para>
  <para style="q1">
    <verse number="77" style="v" sid="PSA 119:77"/>አከ አን ሉቡን ጅራዹፍ ገረ ላፍንኬ ገረኮ ሃዹፉ፤</para>
  <para style="q2" vid="PSA 119:77">ሴርኬ ገመቹኮቲ።<verse eid="PSA 119:77"/></para>
  <para style="q1">
    <verse number="78" style="v" sid="PSA 119:78"/>ኦፍ ቱልቶትን ዋን ሰበቢ መሌ ነ የከኒፍ ሃቃነአን፤</para>
  <para style="q2" vid="PSA 119:78">አን ገሩ እረ ዴዴብኤ ሴረኬ ነንያደ።<verse eid="PSA 119:78"/></para>
  <para style="q1">
    <verse number="79" style="v" sid="PSA 119:79"/>ወር ስ ሶዳተን፣ ከኔን ሴረኬ ሁበተን</para>
  <para style="q2" vid="PSA 119:79">ገረኮት ሃዴብአን።<verse eid="PSA 119:79"/></para>
  <para style="q1">
    <verse number="80" style="v" sid="PSA 119:80"/>አከ አን ህንቃኖፍኔፍ</para>
  <para style="q2" vid="PSA 119:80">ገራንኮ ሴረኬ ዱረት ሀንቅነ ህንቀባትን።<verse eid="PSA 119:80"/></para>
  <para style="qa">כ ካፍ</para>
  <para style="q1">
    <verse number="81" style="v" sid="PSA 119:81"/>ሉቡንኮ ፈይሱኬ ሀዉዻን ገገብድ፤</para>
  <para style="q2" vid="PSA 119:81">አን ገሩ ዱቢኬ ነንአብደዸ።<verse eid="PSA 119:81"/></para>
  <para style="q1">
    <verse number="82" style="v" sid="PSA 119:82"/>እጅኮ ዋዳኬ ኤገቹዻን ደዸቤ፤</para>
  <para style="q2" vid="PSA 119:82">አንስ፣ “አት ዮም ነ ጀጀቤስተ?” ነንጄዸ።<verse eid="PSA 119:82"/></para>
  <para style="q1">
    <verse number="83" style="v" sid="PSA 119:83"/>ቀልቀሎ ወይኒ ከን ኣረ ኬሰ ቱሬ</para>
  <para style="q2" vid="PSA 119:83">ፈካዹስ አን አጀጀኬ ህንእራንፈዹ።<verse eid="PSA 119:83"/></para>
  <para style="q1">
    <verse number="84" style="v" sid="PSA 119:84"/>ተጃጅላንኬ ሀመ ዮሚት ኦብሱ ቀበ?</para>
  <para style="q2" vid="PSA 119:84">አት ወረ ነ አርአተንት ዮም ሙርተ?<verse eid="PSA 119:84"/></para>
  <para style="q1">
    <verse number="85" style="v" sid="PSA 119:85"/>ኦፍ ቱልቶትን ወር አከ ሴረኬቲት ህንቡሌ፣</para>
  <para style="q2" vid="PSA 119:85">ቦለ ና ቆተኒሩ።<verse eid="PSA 119:85"/></para>
  <para style="q1">
    <verse number="86" style="v" sid="PSA 119:86"/>አጀጀወንኬ ሁንድኑ አመነሞዸ፤</para>
  <para style="q2" vid="PSA 119:86">ነሞትን ሰበቢ መሌ ዋን ነ አርአተኒፍ አት ነ ገርጋር።<verse eid="PSA 119:86"/></para>
  <para style="q1">
    <verse number="87" style="v" sid="PSA 119:87"/>እሳን ለፈራ ነ በሌሱ ገአኒ ቱረን፤</para>
  <para style="q2" vid="PSA 119:87">አን ገሩ ስርነኬ ህንዺፍኔ።<verse eid="PSA 119:87"/></para>
  <para style="q1">
    <verse number="88" style="v" sid="PSA 119:88"/>አት አኩመ ጃለለኬቲት ሉቡኮ በራር፤</para>
  <para style="q2" vid="PSA 119:88">አንስ ሴረ አፋንኬቲ በኡ ነንኤገ።<verse eid="PSA 119:88"/></para>
  <para style="qa">ל ላሜድ</para>
  <para style="q1">
    <verse number="89" style="v" sid="PSA 119:89"/>ያ <char style="nd">ዋቀዮ</char>፣ ዱቢንኬ በረ በራን ጅራተ፤</para>
  <para style="q2" vid="PSA 119:89">ሰሚ ኬሰስ ጀባቴ ንዻበተ።<verse eid="PSA 119:89"/></para>
  <para style="q1">
    <verse number="90" style="v" sid="PSA 119:90"/>አመነሙማንኬ ዸሎተ ሁንዳፍ እት ፉፈ፤</para>
  <para style="q2" vid="PSA 119:90">አት ለፈ ሁንዴስቴ፤ እሼንስ ንጅራት።<verse eid="PSA 119:90"/></para>
  <para style="q1">
    <verse number="91" style="v" sid="PSA 119:91"/>ሰበቢ ወን ሁንድኑ ስ ተጃጅሉፍ፣</para>
  <para style="q2" vid="PSA 119:91">ሴርኬ ሀመ ሀርኣት ጅራቴረ።<verse eid="PSA 119:91"/></para>
  <para style="q1">
    <verse number="92" style="v" sid="PSA 119:92"/>ኡቱ ሴርኬ ገመቹ ና ተኡ ባቴ፣</para>
  <para style="q2" vid="PSA 119:92">አን ስላ ረክነኮቲን በዴን ቱሬ።<verse eid="PSA 119:92"/></para>
  <para style="q1">
    <verse number="93" style="v" sid="PSA 119:93"/>ሰበቢ አት እሳን ነ ጅራችፍቴፍ፣</para>
  <para style="q2" vid="PSA 119:93">አን ጎንኩማ አጀጀኬ ህንእራንፈዹ።<verse eid="PSA 119:93"/></para>
  <para style="q1">
    <verse number="94" style="v" sid="PSA 119:94"/>ሰበቢ አን ከንኬ ተኤፍ ነ ፈይስ፤</para>
  <para style="q2" vid="PSA 119:94">አንስ ስርነኬ በርባዴረ።<verse eid="PSA 119:94"/></para>
  <para style="q1">
    <verse number="95" style="v" sid="PSA 119:95"/>ሀሞን ነ በሌሱፍ ነ ኤገቻ ጅሩ፤</para>
  <para style="q2" vid="PSA 119:95">አን ገሩ እረ ዴዴብኤ ሴረኬ ነንያደ።<verse eid="PSA 119:95"/></para>
  <para style="q1">
    <verse number="96" style="v" sid="PSA 119:96"/>አን አከ ወን ሙዳ ህንቀብኔ ሁንድኑ ዳንጋ ቀቡ አርጌረ፤</para>
  <para style="q2" vid="PSA 119:96">አጀጅንኬ ገሩ ባይኤ በልኣዸ።<verse eid="PSA 119:96"/></para>
  <para style="qa">מ ሜም</para>
  <para style="q1">
    <verse number="97" style="v" sid="PSA 119:97"/>አን ሴረኬ አከመን ጃለዸ!</para>
  <para style="q2" vid="PSA 119:97">ጉያ ጉቱረ ዴዴብኤ ዋኤሳ ነንያደ።<verse eid="PSA 119:97"/></para>
  <para style="q1">
    <verse number="98" style="v" sid="PSA 119:98"/>አጀጀወንኬ ዋን ዬሮ ሁንደ ነ ወጅን ጅረኒፍ፣</para>
  <para style="q2" vid="PSA 119:98">ዲኖተኮ ጫላ ኦጌሰ ነ ጎዸን።<verse eid="PSA 119:98"/></para>
  <para style="q1">
    <verse number="99" style="v" sid="PSA 119:99"/>አን ሰበቢን እረ ዴዴብኤ ሴረኬ ያዱፍ፣</para>
  <para style="q2" vid="PSA 119:99">በርሲሶተኮ ሁንዱማ ጫላ ሁበትና ቀበ።<verse eid="PSA 119:99"/></para>
  <para style="q1">
    <verse number="100" style="v" sid="PSA 119:100"/>አን ሰበቢን አጀጀኬ ኤጉፍ፣</para>
  <para style="q2" vid="PSA 119:100">ማንጉዶተ ጫላ ሁበትና ጉዳን ቀበ።<verse eid="PSA 119:100"/></para>
  <para style="q1">
    <verse number="101" style="v" sid="PSA 119:101"/>አን አከን ዱቢኬ ኤጉፍ፣</para>
  <para style="q2" vid="PSA 119:101">ከራ ሀማ ሁንደራ ሚለኮ አደበዼረ።<verse eid="PSA 119:101"/></para>
  <para style="q1">
    <verse number="102" style="v" sid="PSA 119:102"/>ዋን አት መታንኬ ነ በርሲፍቴፍ፣</para>
  <para style="q2" vid="PSA 119:102">አን ሴረኬራ ህንፈጋትኔ።<verse eid="PSA 119:102"/></para>
  <para style="q1">
    <verse number="103" style="v" sid="PSA 119:103"/>ዱቢንኬ አከም አረበኮት ምኣወ፤</para>
  <para style="q2" vid="PSA 119:103">ነዺ ደማ ጫላ አፋንኮት ምኣወ!<verse eid="PSA 119:103"/></para>
  <para style="q1">
    <verse number="104" style="v" sid="PSA 119:104"/>አን ቀጄልፈመኬራ ሁበትና አርገዼረ፤</para>
  <para style="q2" vid="PSA 119:104">ከናፉ ዳንዲ ሶባ ሁንደ ነንጅበ።<verse eid="PSA 119:104"/></para>
  <para style="qa">נ ኑን</para>
  <para style="q1">
    <verse number="105" style="v" sid="PSA 119:105"/>ዱቢንኬ ሚለኮቲፍ እብሳዸ፤</para>
  <para style="q2" vid="PSA 119:105">ዳንዲኮቲፍሞ እፈ።<verse eid="PSA 119:105"/></para>
  <para style="q1">
    <verse number="106" style="v" sid="PSA 119:106"/>አን አከን ሴረኬ ቀጄላ ሰነ ኤጉፍ፣ ከከዼረ፤</para>
  <para style="q2" vid="PSA 119:106">ከነስ ምርከኔሴረ።<verse eid="PSA 119:106"/></para>
  <para style="q1">
    <verse number="107" style="v" sid="PSA 119:107"/>አን አከ መሌ ዽጰዼን ጅረ፤ ያ <char style="nd">ዋቀዮ</char>፣</para>
  <para style="q2" vid="PSA 119:107">አት አኩመ ዱቢኬቲት ሉቡኮ በራር።<verse eid="PSA 119:107"/></para>
  <para style="q1">
    <verse number="108" style="v" sid="PSA 119:108"/>ያ <char style="nd">ዋቀዮ</char>፣ <optbreak/> ገለተ ፌዺዻን አፋንኮቲ በኡ ፉዸዹ፤</para>
  <para style="q2" vid="PSA 119:108">ሴረኬስ ነ በርሲስ።<verse eid="PSA 119:108"/></para>
  <para style="q1">
    <verse number="109" style="v" sid="PSA 119:109"/>ጅሬኝኮ ዬሮ ሁንደ ሀርከኮ ኬሰ ጅራቱዩ፣</para>
  <para style="q2" vid="PSA 119:109">አን ሴረኬ ህንእራንፈዹ።<verse eid="PSA 119:109"/></para>
  <para style="q1">
    <verse number="110" style="v" sid="PSA 119:110"/>ሀሞን ክዮ ና ካአኒሩ፤</para>
  <para style="q2" vid="PSA 119:110">አን ገሩ አጀጀኬራ ህንጀልአትኔ።<verse eid="PSA 119:110"/></para>
  <para style="q1">
    <verse number="111" style="v" sid="PSA 119:111"/>ሴርኬ ዻለኮ ከን በረ በራት፤</para>
  <para style="q2" vid="PSA 119:111">ገመቹ ገራኮቲትስ።<verse eid="PSA 119:111"/></para>
  <para style="q1">
    <verse number="112" style="v" sid="PSA 119:112"/>ገራንኮ ሀመ ዹማት</para>
  <para style="q2" vid="PSA 119:112">አጀጀኬ ኤጉፍ ኩተቴረ።<verse eid="PSA 119:112"/></para>
  <para style="qa">ס ሳሜክ</para>
  <para style="q1">
    <verse number="113" style="v" sid="PSA 119:113"/>አን ነመ ያደ ለማ ነንጅበ፤</para>
  <para style="q2" vid="PSA 119:113">ሴረኬ ገሩ ነንጃለዸ።<verse eid="PSA 119:113"/></para>
  <para style="q1">
    <verse number="114" style="v" sid="PSA 119:114"/>አት እዶ አን እት በቀዹፊ ጋቸነኮት፤</para>
  <para style="q2" vid="PSA 119:114">አን ዱቢኬ አብደዼረ።<verse eid="PSA 119:114"/></para>
  <para style="q1">
    <verse number="115" style="v" sid="PSA 119:115"/>አከ አን አጀጀወን ዋቀኮ ኤጉፍ፣</para>
  <para style="q2" vid="PSA 119:115">እስን ወር ዋን ሀማ ሆጄተን ነራ ፈጋዻ!<verse eid="PSA 119:115"/></para>
  <para style="q1">
    <verse number="116" style="v" sid="PSA 119:116"/>አት አኩመ ዋዳኬቲት ነ ዴገር፤ <optbreak/> አንስ ነንጅራዸ፤</para>
  <para style="q2" vid="PSA 119:116">አከ አን አብዲኮት ቃነኡ ነ ህንጎዽን።<verse eid="PSA 119:116"/></para>
  <para style="q1">
    <verse number="117" style="v" sid="PSA 119:117"/>አከ አን ነጋዻን ጅራዹፍ ነ ዴገር፤</para>
  <para style="q2" vid="PSA 119:117">ዬሮ ሁንደ ሴረኬ ነንከበጀ።<verse eid="PSA 119:117"/></para>
  <para style="q1">
    <verse number="118" style="v" sid="PSA 119:118"/>ሰበቢ ጎዎምሳንሳኒ ፋይዳ ህንቀብኔፍ፤</para>
  <para style="q2" vid="PSA 119:118">አት ወረ ሴረኬራ ጀልአተን ሁንደ ቱፈቴ ገተ።<verse eid="PSA 119:118"/></para>
  <para style="q1">
    <verse number="119" style="v" sid="PSA 119:119"/>አት ሀሞተ ለፈራ ሁንደ አከ ኮሲት ገተ፤</para>
  <para style="q2" vid="PSA 119:119">ከናፉ አን ሴረኬ ነንጃለዸ።<verse eid="PSA 119:119"/></para>
  <para style="q1">
    <verse number="120" style="v" sid="PSA 119:120"/>ፎንኮ ስ ሶዳቹዻን ሆለተ፤</para>
  <para style="q2" vid="PSA 119:120">አንስ ሙርቲኬ ነንሶዳዸ።<verse eid="PSA 119:120"/></para>
  <para style="qa">ע ኣይን</para>
  <para style="q1">
    <verse number="121" style="v" sid="PSA 119:121"/>አን ዋን ቀጄላፊ ቶላ ሆጄዼረ፤</para>
  <para style="q2" vid="PSA 119:121">አት ወረ ነ ሀጩጨንት ደበርስቴ ነ ህንኬንን።<verse eid="PSA 119:121"/></para>
  <para style="q1">
    <verse number="122" style="v" sid="PSA 119:122"/>ነጋን ጅራቹ ተጃጅላኬቲ ምርከኔስ፤</para>
  <para style="q2" vid="PSA 119:122">አከ ኦፍ ቱልቶትን ነ ጩንቁርሰንስ ህንኤየምን።<verse eid="PSA 119:122"/></para>
  <para style="q1">
    <verse number="123" style="v" sid="PSA 119:123"/>እጅኮ ፈይሱኬ ኤጉዻን፣</para>
  <para style="q2" vid="PSA 119:123">ዋዳኬ ቀጄላስ ኤጉዻንስ ደዸቤረ።<verse eid="PSA 119:123"/></para>
  <para style="q1">
    <verse number="124" style="v" sid="PSA 119:124"/>አኩመ ጃለለኬቲት ተጃጅላኬ ያደዹ፤</para>
  <para style="q2" vid="PSA 119:124">ሴረኬስ ነ በርሲስ።<verse eid="PSA 119:124"/></para>
  <para style="q1">
    <verse number="125" style="v" sid="PSA 119:125"/>አን ተጃጅላኬት፤</para>
  <para style="q2" vid="PSA 119:125">አከ አን አጀጀኬ ቤኩፍ ሁበትና ና ኬን።<verse eid="PSA 119:125"/></para>
  <para style="q1">
    <verse number="126" style="v" sid="PSA 119:126"/>ያ <char style="nd">ዋቀዮ</char>፣ ኩን ዬሮ አት እት ሆጄቱዸ፤</para>
  <para style="q2" vid="PSA 119:126">ሴርኬ ጨብሰማ ጅራቲ።<verse eid="PSA 119:126"/></para>
  <para style="q1">
    <verse number="127" style="v" sid="PSA 119:127"/>ከናፉ አን ወርቄ ጫላ፣</para>
  <para style="q2" vid="PSA 119:127">ወርቄ ቁልቁሉ ጫላ፣ አጀጀወንኬ ነንጃለዸ፤<verse eid="PSA 119:127"/></para>
  <para style="q1">
    <verse number="128" style="v" sid="PSA 119:128"/>አን አከ ሴርኬ ሁንድ ቀጄላ ተኤ ነንአመነ፤</para>
  <para style="q2" vid="PSA 119:128">ዳንዲ ሶባ ሁንደስ ነንጅበ።<verse eid="PSA 119:128"/></para>
  <para style="qa">פ ፔ</para>
  <para style="q1">
    <verse number="129" style="v" sid="PSA 119:129"/>ስርንኬ ድንቅሲሳዸ፤</para>
  <para style="q2" vid="PSA 119:129">ከናፉ አን እሰ ነንኤገ።<verse eid="PSA 119:129"/></para>
  <para style="q1">
    <verse number="130" style="v" sid="PSA 119:130"/>እብሰሙን ዱቢኬቲ እፈ ኬነ፤</para>
  <para style="q2" vid="PSA 119:130">ወላሎታፍስ ሁበትና ኬነ።<verse eid="PSA 119:130"/></para>
  <para style="q1">
    <verse number="131" style="v" sid="PSA 119:131"/>አን አጀጀወንኬ ሀዉዻን</para>
  <para style="q2" vid="PSA 119:131">አፋንኮ በኔ ነንሀርገነ።<verse eid="PSA 119:131"/></para>
  <para style="q1">
    <verse number="132" style="v" sid="PSA 119:132"/>አት አኩመ ዬሮ ሁንደ ወረ መቃኬ ጃለተኒፍ ጎቱ ሰነ፣</para>
  <para style="q2" vid="PSA 119:132">ገረኮት ገረገሊ ነ ማር።<verse eid="PSA 119:132"/></para>
  <para style="q1">
    <verse number="133" style="v" sid="PSA 119:133"/>አኩመ ዱቢኬቲት ተርካንፊ ሚለኮቲ ና ቀጄልች፤</para>
  <para style="q2" vid="PSA 119:133">ጩቡን ቶኮዩ ነረት ህንሞእን።<verse eid="PSA 119:133"/></para>
  <para style="q1">
    <verse number="134" style="v" sid="PSA 119:134"/>አከ አን አጀጀኬ ኤጉፍ</para>
  <para style="q2" vid="PSA 119:134">ሀጩጫ ነሞታ ጀላ ነ ፉር።<verse eid="PSA 119:134"/></para>
  <para style="q1">
    <verse number="135" style="v" sid="PSA 119:135"/>አከ ፉልኬ ተጃጅላኬረት እፉ ጎዽ፤</para>
  <para style="q2" vid="PSA 119:135">ስርነኬስ ነ በርሲስ።<verse eid="PSA 119:135"/></para>
  <para style="q1">
    <verse number="136" style="v" sid="PSA 119:136"/>ሰበቢ ነሞትን ሴረኬ ህንኤግኔፍ፣</para>
  <para style="q2" vid="PSA 119:136">እጅኮ እምማን ሎላሰ።<verse eid="PSA 119:136"/></para>
  <para style="qa">צ ትሳዴ</para>
  <para style="q1">
    <verse number="137" style="v" sid="PSA 119:137"/>ያ <char style="nd">ዋቀዮ</char>፣ አት ቀጄላዸ፤</para>
  <para style="q2" vid="PSA 119:137">ሙርቲንኬስ ቀጄላዸ።<verse eid="PSA 119:137"/></para>
  <para style="q1">
    <verse number="138" style="v" sid="PSA 119:138"/>ሴር አት ኬንቴ ቀጄላዸ፤</para>
  <para style="q2" vid="PSA 119:138">ጉቱማትስ አመነማዸ።<verse eid="PSA 119:138"/></para>
  <para style="q1">
    <verse number="139" style="v" sid="PSA 119:139"/>ሰበቢ ዲኖትንኮ ዱቢኬ ደገተኒፍ፣</para>
  <para style="q2" vid="PSA 119:139">ህናፋን አን ቀቡ ነ ጉጉቤረ።<verse eid="PSA 119:139"/></para>
  <para style="q1">
    <verse number="140" style="v" sid="PSA 119:140"/>ዋዳንኬ ስሪት ቆረሜ እላለሜረ፤</para>
  <para style="q2" vid="PSA 119:140">ተጃጅላንኬስ እሰ ጃለተ።<verse eid="PSA 119:140"/></para>
  <para style="q1">
    <verse number="141" style="v" sid="PSA 119:141"/>ጥናዼ ቱፈተሙዩ፣</para>
  <para style="q2" vid="PSA 119:141">አን አጀጀኬ ህንእራንፈዹ።<verse eid="PSA 119:141"/></para>
  <para style="q1">
    <verse number="142" style="v" sid="PSA 119:142"/>ቀጄሉማንኬ በረ በራን ጅራተ፤</para>
  <para style="q2" vid="PSA 119:142">ሴርኬስ ዹጋዸ።<verse eid="PSA 119:142"/></para>
  <para style="q1">
    <verse number="143" style="v" sid="PSA 119:143"/>ረክኒፊ ዽጵን ነት ዹፌረ፤</para>
  <para style="q2" vid="PSA 119:143">አጀጀወንኬ ገሩ ገመቹኮት።<verse eid="PSA 119:143"/></para>
  <para style="q1">
    <verse number="144" style="v" sid="PSA 119:144"/>ሴርኬ በረ በራን ቀጄላዸ፤</para>
  <para style="q2" vid="PSA 119:144">አከ አን ጅራዹፍ ሁበትና ና ኬን።<verse eid="PSA 119:144"/></para>
  <para style="qa">ק ቆፍ</para>
  <para style="q1">
    <verse number="145" style="v" sid="PSA 119:145"/>ያ <char style="nd">ዋቀዮ</char>፣ አን ገራኮ ጉቱዻን ስን ዋመዸ፤</para>
  <para style="q2" vid="PSA 119:145">ዴቢ ና ኬን፤ አንስ ስርነኬቲፍ ነንአጀጀመ።<verse eid="PSA 119:145"/></para>
  <para style="q1">
    <verse number="146" style="v" sid="PSA 119:146"/>አን ስትን እየዸ፤ አት ነ ፈይስ፤</para>
  <para style="q2" vid="PSA 119:146">ሴረኬስ ነንኤገ።<verse eid="PSA 119:146"/></para>
  <para style="q1">
    <verse number="147" style="v" sid="PSA 119:147"/>አን ኡቱ ለፍት ህንበርእን ከኤ ገርጋርሳፍ ነንእየዸ፤</para>
  <para style="q2" vid="PSA 119:147">አን ዱቢኬ አብደዼረ።<verse eid="PSA 119:147"/></para>
  <para style="q1">
    <verse number="148" style="v" sid="PSA 119:148"/>አከ አንረ ዴዴብኤ ዋዳኬ ያዱፍ፣</para>
  <para style="q2" vid="PSA 119:148">እጅኮ ሀልከን ጉቱ በነሜ ቡለ።<verse eid="PSA 119:148"/></para>
  <para style="q1">
    <verse number="149" style="v" sid="PSA 119:149"/>አኩመ ጃለለኬቲት ሰገሌኮ ዸገእ፤</para>
  <para style="q2" vid="PSA 119:149">ያ <char style="nd">ዋቀዮ</char>፣ አኩመ ሴረኬቲት ሉቡኮ በራር።<verse eid="PSA 119:149"/></para>
  <para style="q1">
    <verse number="150" style="v" sid="PSA 119:150"/>ወር ደበ መርአተን አስ ዽኦ ጅሩ፤</para>
  <para style="q2" vid="PSA 119:150">ሴረኬራ ገሩ ፈጎ ጅሩ።<verse eid="PSA 119:150"/></para>
  <para style="q1">
    <verse number="151" style="v" sid="PSA 119:151"/>ያ <char style="nd">ዋቀዮ</char>፣ አት ገሩ ዽኦ ጅርተ፤</para>
  <para style="q2" vid="PSA 119:151">አጀጀወንኬ ሁንድስ ዹጋዸ።<verse eid="PSA 119:151"/></para>
  <para style="q1">
    <verse number="152" style="v" sid="PSA 119:152"/>አከ አት አጀጀወንኬ በረ በራን ሁንዴስቴ፣</para>
  <para style="q2" vid="PSA 119:152">አን ሴረኬራ ዱር በረዼረ።<verse eid="PSA 119:152"/></para>
  <para style="qa">ר ሬሽ</para>
  <para style="q1">
    <verse number="153" style="v" sid="PSA 119:153"/>ዽጵነኮ አርጊቲ ነ ኦልች፤</para>
  <para style="q2" vid="PSA 119:153">አን ሴረኬ ህንደገኔቲ።<verse eid="PSA 119:153"/></para>
  <para style="q1">
    <verse number="154" style="v" sid="PSA 119:154"/>ዱቢኮ ና ፈልም፤ ነ ፉርስ፤</para>
  <para style="q2" vid="PSA 119:154">አኩመ ዋዳኬቲት ሉቡኮ በራር።<verse eid="PSA 119:154"/></para>
  <para style="q1">
    <verse number="155" style="v" sid="PSA 119:155"/>ሰበቢ እሳን ስርነኬ ህንበርባኔፍ፣</para>
  <para style="q2" vid="PSA 119:155">ፈይን ሀሞተራ ፈጋቴረ።<verse eid="PSA 119:155"/></para>
  <para style="q1">
    <verse number="156" style="v" sid="PSA 119:156"/>ያ <char style="nd">ዋቀዮ</char>፣ ገረ ላፍንኬ ጉዳዸ፤</para>
  <para style="q2" vid="PSA 119:156">አኩመ ሴረኬቲት ሉቡኮ በራር።<verse eid="PSA 119:156"/></para>
  <para style="q1">
    <verse number="157" style="v" sid="PSA 119:157"/>ዲኖትንኮ ወር ነ አርአተን ባይኤዸ፤</para>
  <para style="q2" vid="PSA 119:157">አን ገሩ ሴረኬራ ህንጀልአትኔ።<verse eid="PSA 119:157"/></para>
  <para style="q1">
    <verse number="158" style="v" sid="PSA 119:158"/>ሰበቢ እሳን ዱቢኬቲፍ ህንአጀጀምኔፍ፣</para>
  <para style="q2" vid="PSA 119:158">አን ወረ አመንቲ ህንቀብኔ እጀ ጅባቲን ነንእላለ።<verse eid="PSA 119:158"/></para>
  <para style="q1">
    <verse number="159" style="v" sid="PSA 119:159"/>አከም አከ አን ቀጄልፈመኬ ጃለዹ ሜ እላል፤</para>
  <para style="q2" vid="PSA 119:159">ያ <char style="nd">ዋቀዮ</char>፣ አኩመ ጃለለኬቲት ሉቡኮ በራር።<verse eid="PSA 119:159"/></para>
  <para style="q1">
    <verse number="160" style="v" sid="PSA 119:160"/>ዱቢንኬ ሁንድኑ ዹጋዸ፤</para>
  <para style="q2" vid="PSA 119:160">ሴርኬ ቀጄላን ሁንድኑስ በረ በራን ጅራተ።<verse eid="PSA 119:160"/></para>
  <para style="qa">ש ሲኒፊ ሺን</para>
  <para style="q1">
    <verse number="161" style="v" sid="PSA 119:161"/>ቡልችቶትን ሰበቢ መሌ ነ አርአተን፤</para>
  <para style="q2" vid="PSA 119:161">ገራንኮ ገሩ ዱቢኬ <optbreak/> ሶዳቹዻን ሆለተ።<verse eid="PSA 119:161"/></para>
  <para style="q1">
    <verse number="162" style="v" sid="PSA 119:162"/>አን አከ ነመ ቦጁ ጉዳ አርገቴ ቶኮት፣</para>
  <para style="q2" vid="PSA 119:162">ዱቢኬት ነንገመደ።<verse eid="PSA 119:162"/></para>
  <para style="q1">
    <verse number="163" style="v" sid="PSA 119:163"/>አን ሶበ ነንጅበ፤ ነንጥሬፈዸስ፤</para>
  <para style="q2" vid="PSA 119:163">ሴረኬ ገሩ ነንጃለዸ።<verse eid="PSA 119:163"/></para>
  <para style="q1">
    <verse number="164" style="v" sid="PSA 119:164"/>ሰበቢ ሴረኬ ቀጄላ ሰናቲፍ፣</para>
  <para style="q2" vid="PSA 119:164">አን ጉያት ዬሮ ቶርበ ስን ገለቴፈዸ።<verse eid="PSA 119:164"/></para>
  <para style="q1">
    <verse number="165" style="v" sid="PSA 119:165"/>ወር ሴረኬ ጃለተን ነጋ ጉዳ ቀቡ፤</para>
  <para style="q2" vid="PSA 119:165">ወን እሳን ጉፈቺሱ ቶኮዩ ህንጅሩ።<verse eid="PSA 119:165"/></para>
  <para style="q1">
    <verse number="166" style="v" sid="PSA 119:166"/>ያ <char style="nd">ዋቀዮ</char>፣ አን ፈይሱኬ ነንአብደዸ፤</para>
  <para style="q2" vid="PSA 119:166">አጀጀኬ ዱካስ ነንቡአ።<verse eid="PSA 119:166"/></para>
  <para style="q1">
    <verse number="167" style="v" sid="PSA 119:167"/>አን ዋነን ጉዳ እሰ ጃለዹፍ፣</para>
  <para style="q2" vid="PSA 119:167">አጀጀኬ ነንኤገ።<verse eid="PSA 119:167"/></para>
  <para style="q1">
    <verse number="168" style="v" sid="PSA 119:168"/>አት ከራኮ ሁንደ ዋን ቤክቱፍ፣</para>
  <para style="q2" vid="PSA 119:168">አን ስርነኬቲፊ ሴረኬ ነንኤገ።<verse eid="PSA 119:168"/></para>
  <para style="qa">ת ታው</para>
  <para style="q1">
    <verse number="169" style="v" sid="PSA 119:169"/>ያ <char style="nd">ዋቀዮ</char>፣ እይኮ ፉለኬ ዱረ ሃገኡ፤</para>
  <para style="q2" vid="PSA 119:169">አት አኩመ ዱቢኬቲት ሁበትና ና ኬን።<verse eid="PSA 119:169"/></para>
  <para style="q1">
    <verse number="170" style="v" sid="PSA 119:170"/>ዋመንኮ ፉለኬ ዱረ ሃገኡ፤</para>
  <para style="q2" vid="PSA 119:170">አኩመ ዋዳኬቲት ነ ባስ።<verse eid="PSA 119:170"/></para>
  <para style="q1">
    <verse number="171" style="v" sid="PSA 119:171"/>ሰበቢ አት ቀጄልፈመኬ ነ በርሲፍቱፍ፣</para>
  <para style="q2" vid="PSA 119:171">ህዺንኮ ገለተ ሃዸንገላሱ።<verse eid="PSA 119:171"/></para>
  <para style="q1">
    <verse number="172" style="v" sid="PSA 119:172"/>አረብንኮ ዱቢኬ ሃፋርፈቱ፤</para>
  <para style="q2" vid="PSA 119:172">አጀጅንኬ ሁንድ ቀጄላዻቲ።<verse eid="PSA 119:172"/></para>
  <para style="q1">
    <verse number="173" style="v" sid="PSA 119:173"/>ዋን አን ስርነኬ ፍለዼፍ፣</para>
  <para style="q2" vid="PSA 119:173">ሀርክኬ ነ ገርጋሩፍ ሃቆጳኡ።<verse eid="PSA 119:173"/></para>
  <para style="q1">
    <verse number="174" style="v" sid="PSA 119:174"/>ያ <char style="nd">ዋቀዮ</char>፣ አን ፈይሱኬ ነንሀወ፤</para>
  <para style="q2" vid="PSA 119:174">ሴርኬስ ገመቹኮት።<verse eid="PSA 119:174"/></para>
  <para style="q1">
    <verse number="175" style="v" sid="PSA 119:175"/>ሉቡንኮ ስ ገለቴፈቹፍ ሃጅራቱ፤</para>
  <para style="q2" vid="PSA 119:175">ሴርኬስ ነ ሃገርጋሩ።<verse eid="PSA 119:175"/></para>
  <para style="q1">
    <verse number="176" style="v" sid="PSA 119:176"/>አን አኩመ ሆላ በዴ ከራራ ጀልአዼረ።</para>
  <para style="q2" vid="PSA 119:176">አን አጀጀወንኬ ህንእራንፈትኔቲ፣</para>
  <para style="q2" vid="PSA 119:176">ተጃጅላኬ በርባድ።<verse eid="PSA 119:176"/></para>
  <chapter eid="PSA 119"/>
  <chapter number="120" style="c" sid="PSA 120"/>
  <para style="cl">ፋርፈትና 120</para>
  <para style="ms1">ፈረ ነጋ</para>
  <para style="d">ፋርፈትና ኦል በኡ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 120:1"/>አን ረክነኮ ኬሰት <char style="nd">ዋቀዮት</char> ነንእየዸ፤</para>
  <para style="q2" vid="PSA 120:1">እንስ ዴቢ ና ኬነ።<verse eid="PSA 120:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 120:2"/>ያ <char style="nd">ዋቀዮ</char>፣ አፋን ሶቡፊ</para>
  <para style="q2" vid="PSA 120:2">አረበ ነመ ጎዎምሱ ጀላ ነ ባስ።<verse eid="PSA 120:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 120:3"/>ያ አረበ ጎዎምስቱነነ፣ ማልቱ ሲፍ ኬነመ?</para>
  <para style="q2" vid="PSA 120:3">ከነ ጫላስ ማል ጎዸምተ?<verse eid="PSA 120:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 120:4"/>እን ጥየ ሎልቶታ ከን ቀረሜን፣</para>
  <para style="q2" vid="PSA 120:4">በርበዳ እብዳ ቀጨማቲን ስ አደበ።<verse eid="PSA 120:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 120:5"/>አን ዋነን ሜሼክ ኬሰ ታኤ</para>
  <para style="q2" vid="PSA 120:5">ዱንካኖተ ቄዳር ግዱ ጅራዹፍ፣ አናፍ ወዮ!<verse eid="PSA 120:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 120:6"/>ወረ ነጋ ጅበን ግዱ፣</para>
  <para style="q2" vid="PSA 120:6">አን ዬሮ ዼራ ጅራዼረ።<verse eid="PSA 120:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 120:7"/>አን ነመ ነጋ በርባዱዸ፤</para>
  <para style="q2" vid="PSA 120:7">እሳን ገሩ ዬሮ አን ዱበዹ ሎላፍ ከከአን።<verse eid="PSA 120:7"/></para>
  <chapter eid="PSA 120"/>
  <chapter number="121" style="c" sid="PSA 121"/>
  <para style="cl">ፋርፈትና 121</para>
  <para style="ms1">ኤግዱ እስራኤል</para>
  <para style="d">ፋርፈትና ኦል በኡ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 121:1"/>አን እጀኮ ገረ ቱሉወኒት ኦል ነንቀበዸ፤</para>
  <para style="q2" vid="PSA 121:1">ገርጋርስኮ ኤሳ ዹፈ?<verse eid="PSA 121:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 121:2"/>ገርጋርስኮ <char style="nd">ዋቀዮ</char></para>
  <para style="q2" vid="PSA 121:2">ሰሚፊ ለፈ ኡሜ ብራ ዹፈ።<verse eid="PSA 121:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 121:3"/>እን አከ ሚልኬ ሙጩጫቱ ህንጎዹ፤</para>
  <para style="q2" vid="PSA 121:3">ከን ስ ኤጉ ህንሙጉ፤<verse eid="PSA 121:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 121:4"/>ዹጉማን እን እስራኤልን ኤጉ</para>
  <para style="q2" vid="PSA 121:4">ህንሙጉ፤ ህንረፉስ።<verse eid="PSA 121:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 121:5"/>
    <char style="nd">ዋቀዮ</char> ስ ኤገ፤</para>
  <para style="q2" vid="PSA 121:5">
    <char style="nd">ዋቀዮ</char> ከራ ምርገኬቲቲን ጋድሰ ሲፍ ተአ፤<verse eid="PSA 121:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 121:6"/>ጉያ አዱን ስ ህንጉቡ፤</para>
  <para style="q2" vid="PSA 121:6">ሀልከንስ ጅእ ስ ህንሚዹ።<verse eid="PSA 121:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 121:7"/>
    <char style="nd">ዋቀዮ</char> ሚዻ ሁንደራ ስ ኤገ፤</para>
  <para style="q2" vid="PSA 121:7">እን ሉቡኬ ንኤገ፤<verse eid="PSA 121:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 121:8"/>
    <char style="nd">ዋቀዮ</char> አማ ጀልቀቤ</para>
  <para style="q2" vid="PSA 121:8">ሀመ በረ በራት፣ በኡፊ ገሉኬ ንኤገ።<verse eid="PSA 121:8"/></para>
  <chapter eid="PSA 121"/>
  <chapter number="122" style="c" sid="PSA 122"/>
  <para style="cl">ፋርፈትና 122</para>
  <para style="ms1">ያ ዬሩሳሌም እልልች</para>
  <para style="d">ፋርፈትና ኦል በኡ። ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 122:1"/>ዮሙ እሳን፣ “ኮቱ ገረ መነ <char style="nd">ዋቀዮ</char> ዸቅና”</para>
  <para style="q2" vid="PSA 122:1">ናን ጄዸንት፣ አን ነንገመዴ።<verse eid="PSA 122:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 122:2"/>ያ ዬሩሳሌም፣</para>
  <para style="q2" vid="PSA 122:2">ሚልኬኘ ከረወንኬረ ዻበተ።<verse eid="PSA 122:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 122:3"/>ዬሩሳሌም አከ መጋላ ወልት መጠንቴ</para>
  <para style="q2" vid="PSA 122:3">ጎበቴ ቶኮት እጃረምቴ።<verse eid="PSA 122:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 122:4"/>ኩንስ እዶ ጎሶትን፣</para>
  <para style="q2" vid="PSA 122:4">ጎሶትን <char style="nd">ዋቀዮ</char>፣</para>
  <para style="q1" vid="PSA 122:4">አከ ስርነ እስራኤሊፍ ኬነሜ ሰናት፣</para>
  <para style="q2" vid="PSA 122:4">መቃ <char style="nd">ዋቀዮ</char> ገለቴፈቹፍ እት ኦል በአኒዸ።<verse eid="PSA 122:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 122:5"/>ቴሶወን ሙርቲ፣</para>
  <para style="q2" vid="PSA 122:5">ቴሶወን መነ ዳዊት አች ዻበቱ።<verse eid="PSA 122:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 122:6"/>አከነ ጄዻ ነጋ ዬሩሳሌሚፍ ከዸዻ፦</para>
  <para style="q2" vid="PSA 122:6">“ወር ስ ጃለተን ነጋን ሃጅራተን።<verse eid="PSA 122:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 122:7"/>ደላኬ ኬሰ ነጋን፣</para>
  <para style="q2" vid="PSA 122:7">መሰራ ሞቱማኬቲ ኬሰሞ ተስገቢን ሃጅራቱ።”<verse eid="PSA 122:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 122:8"/>አን ኦቦሎተኮቲፊ ምቾተኮቲፍ ጄዼ፣</para>
  <para style="q2" vid="PSA 122:8">“ነጋን ስ ኬሰ ሃጅራቱ” ነንጄዸ።<verse eid="PSA 122:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 122:9"/>መነ <char style="nd">ዋቀዮ</char> ዋቀኬኛቲፍ ጄዼ፣</para>
  <para style="q2" vid="PSA 122:9">አን አከ ወን ጋሪን ሲፍ ተኡ ነንሀወ።<verse eid="PSA 122:9"/></para>
  <chapter eid="PSA 122"/>
  <chapter number="123" style="c" sid="PSA 123"/>
  <para style="cl">ፋርፈትና 123</para>
  <para style="ms1">ከዸትና ዬሮ ረክና</para>
  <para style="d">ፋርፈትና ኦል በኡ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 123:1"/>ያ እሰ ቴሶንኬ ሰሚረ ጅሩ፣</para>
  <para style="q2" vid="PSA 123:1">አን እጀኮ ገረኬት ኦል ነንቀበዸ።<verse eid="PSA 123:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 123:2"/>አኩመ እጅ ገርቦታ ሀርከ ጎፍታሳኒ፣</para>
  <para style="q2" vid="PSA 123:2">እጅ ገርብቲሞ ሀርከ ጊፍቲሼ እላሉ ሰነ፣</para>
  <para style="q1" vid="PSA 123:2">ሀመ እን አራረ ኑ ቡሱት፣</para>
  <para style="q2" vid="PSA 123:2">እጅኬኘስ ገረ <char style="nd">ዋቀዮ</char> ዋቀኬኛ ንእላለ።<verse eid="PSA 123:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 123:3"/>ኑ አራረም፤ ያ <char style="nd">ዋቀዮ</char>፣ ኑ አራረም፤</para>
  <para style="q2" vid="PSA 123:3">ቱፈተሙን ኑት ባይአቴራቲ።<verse eid="PSA 123:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 123:4"/>አረብን ወረ ኦፍ ጀጀኒቲፊ</para>
  <para style="q2" vid="PSA 123:4">ቱፊን ወረ ኦፍ ቱለኒ ኑት ባይአቴረ።<verse eid="PSA 123:4"/></para>
  <chapter eid="PSA 123"/>
  <chapter number="124" style="c" sid="PSA 124"/>
  <para style="cl">ፋርፈትና 124</para>
  <para style="ms1">ፈይሳ እስራኤል</para>
  <para style="d">ፋርፈትና ኦል በኡ። ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 124:1"/>እስራኤል አከነ ሃጄዹ፦</para>
  <para style="q2" vid="PSA 124:1">ኡቱ <char style="nd">ዋቀዮ</char> ገሬኬኘ ተኡ ባቴ፣<verse eid="PSA 124:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 124:2"/>ኡቱ <char style="nd">ዋቀዮ</char> ገሬኬኘ ተኡ ባቴ፣</para>
  <para style="q2" vid="PSA 124:2">ዮሙ ነሞትን ኑት ከአንት፣<verse eid="PSA 124:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 124:3"/>ዮሙ ኣሪንሳኒ ኑት ቦበኤት፣</para>
  <para style="q2" vid="PSA 124:3">ስላ እሳን ኡቱ ኑ ሉቡን ጅሩ ኑ ልቅምሱ ቱረን፤<verse eid="PSA 124:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 124:4"/>ሎላን ኑ ልቅምሴ</para>
  <para style="q2" vid="PSA 124:4">ዸኣን ብሻኒ ኑረ ያአ ቱሬ፤<verse eid="PSA 124:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 124:5"/>ብሻን ሀማን</para>
  <para style="q2" vid="PSA 124:5">ኑ ፉዸቴ በደ ቱሬ።<verse eid="PSA 124:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 124:6"/>
    <char style="nd">ዋቀዮ</char> አከ ኑ እልካንሳኒቲን ጭጭረምኑፍ</para>
  <para style="q2" vid="PSA 124:6">ደበርሴ እት ኑ ህንኬንን ሱን ሃኤብፈሙ።<verse eid="PSA 124:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 124:7"/>አኩመ ስምብር ክዮ አደምስቱ ጀላ ባቱ፣</para>
  <para style="q2" vid="PSA 124:7">ኑ እሳን ጀላ ባኔረ፤</para>
  <para style="q1" vid="PSA 124:7">ክዮን ንጭጭቴ፤</para>
  <para style="q2" vid="PSA 124:7">ኑስ ጀላ ባኔ።<verse eid="PSA 124:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 124:8"/>ገርጋርስኬኘ መቃ <char style="nd">ዋቀዮ</char>፣</para>
  <para style="q2" vid="PSA 124:8">ኡማ ሰሚፊ ለፈ ሰናት።<verse eid="PSA 124:8"/></para>
  <chapter eid="PSA 124"/>
  <chapter number="125" style="c" sid="PSA 125"/>
  <para style="cl">ፋርፈትና 125</para>
  <para style="ms1">ዋቀዮ አመነምቶተሳ ንኤገ</para>
  <para style="d">ፋርፈትና ኦል በኡ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 125:1"/>ወር <char style="nd">ዋቀዮን</char> አመነተን አከ ቱሉ ጥዮን</para>
  <para style="q2" vid="PSA 125:1">ከን ህንራፈምኔ፣ ከን በረ በራን ጅራቱ ሰናት።<verse eid="PSA 125:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 125:2"/>አኩመ ቱሉወን ዬሩሳሌምን መርሰን ሰነ፣</para>
  <para style="q2" vid="PSA 125:2">
    <char style="nd">ዋቀዮ</char> አማ ጀልቀቤ ሀመ በረ በራት፣</para>
  <para style="q2" vid="PSA 125:2">ሰበሳ ንመርሰ።<verse eid="PSA 125:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 125:3"/>አከ ቀጄልቶትን ጀልእነ ሆጄቹፍ</para>
  <para style="q2" vid="PSA 125:3">ሀርከሳኒ ኦል ህንድሪርፈኔፍ፣</para>
  <para style="q1" vid="PSA 125:3">ቦኩን ሀሞታ ለፈ ቀጄልቶታፍ</para>
  <para style="q2" vid="PSA 125:3">እጣዻን ቆደሜረ ህንጅራቱ።<verse eid="PSA 125:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 125:4"/>ያ <char style="nd">ዋቀዮ</char>፣ ወረ ጋሪፍ፣</para>
  <para style="q2" vid="PSA 125:4">ወረ ገራሳኒቲን ቶሎተ ተአኒፍስ ዋን ጋሪ ጎዽ።<verse eid="PSA 125:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 125:5"/>ወረ ከራ ምጪረማት ገረገለን ገሩ፣</para>
  <para style="q2" vid="PSA 125:5">
    <char style="nd">ዋቀዮ</char> አኩመ ወረ ሀምነ ሆጄተን በሌሱ ጀረስ ንበሌሰ።</para>
  <para style="b" vid="PSA 125:5"/>
  <para style="q1" vid="PSA 125:5">ነጋን እስራኤሊፍ ሃተኡ።<verse eid="PSA 125:5"/></para>
  <chapter eid="PSA 125"/>
  <chapter number="126" style="c" sid="PSA 126"/>
  <para style="cl">ፋርፈትና 126</para>
  <para style="ms1">ፋርፈትና ወረ ቦጁዻ ዴብአኒ</para>
  <para style="d">ፋርፈትና ኦል በኡ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 126:1"/>ዬሮ <char style="nd">ዋቀዮ</char> ወረ ቦጅአመኒ ቱረን ገረ ጥዮንት ዴብሴት፣</para>
  <para style="q2" vid="PSA 126:1">ኑ አከ ወረ አብጁ አብጆተኒ ታኔ።<verse eid="PSA 126:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 126:2"/>አፋንኬኘ ኮልፋን፣ አረብንኬኘሞ</para>
  <para style="q2" vid="PSA 126:2">ፋርፈትና ገመቹቲን ጉተሜ።</para>
  <para style="q1" vid="PSA 126:2">ከነረት ሰቦተ ግዱት፣</para>
  <para style="q2" vid="PSA 126:2">“<char style="nd">ዋቀዮ</char> ዋን ጉዳ እሳኒፍ ጎዼረ” ጄዸሜ።<verse eid="PSA 126:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 126:3"/>
    <char style="nd">ዋቀዮ</char> ዋን ጉዳ ኑፍ ጎዼ፤</para>
  <para style="q2" vid="PSA 126:3">ኑስ ንገመኔ።<verse eid="PSA 126:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 126:4"/>ያ <char style="nd">ዋቀዮ</char>፣ አኩመ ለጎተ ኔጌብ፣</para>
  <para style="q2" vid="PSA 126:4">ቦጁኬኘ ኑ ዴብስ።<verse eid="PSA 126:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 126:5"/>ወር እምማኒን ፈጫሰን፣</para>
  <para style="q2" vid="PSA 126:5">ፋርፈትና ገመቹቲን ንሃመቱ።<verse eid="PSA 126:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 126:6"/>ነምን ሰኚ ፈጫፈሙ ባዸቴ ቦኣ ገድ በኡ፣</para>
  <para style="q2" vid="PSA 126:6">ብሲሳ ባዸቴ ፋርፈትና ገመቹ ፋርፈቻ ዴብአ።<verse eid="PSA 126:6"/></para>
  <chapter eid="PSA 126"/>
  <chapter number="127" style="c" sid="PSA 127"/>
  <para style="cl">ፋርፈትና 127</para>
  <para style="ms1">ዋቀ አመነቹ</para>
  <para style="d">ፋርፈትና ኦል በኡ። ፋርፈትና ሶሎሞን።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 127:1"/>
    <char style="nd">ዋቀዮ</char> መነ እጃሩ ባናን፣</para>
  <para style="q2" vid="PSA 127:1">ወር እጃረን አከሱማን ደዸቡ።</para>
  <para style="q1" vid="PSA 127:1">
    <char style="nd">ዋቀዮ</char> መጋላ ኤጉ ባናን፣</para>
  <para style="q2" vid="PSA 127:1">ወር ኤገን አከሱማን ዻበቻ ቡሉ።<verse eid="PSA 127:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 127:2"/>እስን ቡዴነ ደዸቢ ጉዳን አርገሜ ኛቹፍ ጄተኒ፣</para>
  <para style="q2" vid="PSA 127:2">በሪ በራቃን ከኡንኬሰን፣</para>
  <para style="q1" vid="PSA 127:2">ቱርተኒ ረፉንኬሰን ፋይዳ ህንቀቡ፤</para>
  <para style="q2" vid="PSA 127:2">እን ወረ ጃለቱፍ ኡቱመ እሳን ረፈኒዩ <optbreak/> ዋን እሳን በርባችሱ ንኬናፍ።<verse eid="PSA 127:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 127:3"/>ኩኖ፣ እጆሌን ኬና <char style="nd">ዋቀዮት</char>፤</para>
  <para style="q2" vid="PSA 127:3">እጅ ገደሜሳስ በዻሰሳት።<verse eid="PSA 127:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 127:4"/>እጆሌን ደርገጉማ ኬሰ ዸልቸን፣</para>
  <para style="q2" vid="PSA 127:4">አኩመ ጥየ ሀርከ ጎተ ቶኮ ኬሰ ጅሩት።<verse eid="PSA 127:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 127:5"/>ነምን ኮሮጆንሳ ጥያን ጉተሜ ኤብፈማዸ።</para>
  <para style="q2" vid="PSA 127:5">እን ዮሙ ከረ ዱረት ዲኖተሳቲን ፈልሙት ህንቃነኡ።<verse eid="PSA 127:5"/></para>
  <chapter eid="PSA 127"/>
  <chapter number="128" style="c" sid="PSA 128"/>
  <para style="cl">ፋርፈትና 128</para>
  <para style="ms1">ኤበ ቀጄልቶትን አርገተን</para>
  <para style="d">ፋርፈትና ኦል በኡ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 128:1"/>ወር <char style="nd">ዋቀዮን</char> ሶዳተን፣</para>
  <para style="q2" vid="PSA 128:1">ከኔን ከራሳረ ዴመን ኤብፈሞዸ።<verse eid="PSA 128:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 128:2"/>አት ቡኣ ደዸቢኬቲ ንኛተ፤</para>
  <para style="q2" vid="PSA 128:2">ንኤብፈምተ፤ ጅሬኝስ ስት ቶለ።<verse eid="PSA 128:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 128:3"/>ኒቲንኬ መነኬ ኬሰት፣</para>
  <para style="q2" vid="PSA 128:3">አከ ሙከ ወይኒ ከን እጀ ነቀቴ ንታት፤</para>
  <para style="q1" vid="PSA 128:3">እጆሌንኬስ ናኖ ማዲኬቲት፣</para>
  <para style="q2" vid="PSA 128:3">አከ ለታ ሙከ ኤጄርሳ ንተኡ።<verse eid="PSA 128:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 128:4"/>ነምን <char style="nd">ዋቀዮን</char> ሶዳቱ</para>
  <para style="q2" vid="PSA 128:4">አከስት ኤብፈመ።<verse eid="PSA 128:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 128:5"/>በረ ጅሬኘኬቲ ጉቱ፣</para>
  <para style="q2" vid="PSA 128:5">
    <char style="nd">ዋቀዮ</char> ጥዮንራ ስ ሃኤብሱ፤</para>
  <para style="q2" vid="PSA 128:5">አትስ በዻዹማ ዬሩሳሌም አርግ።<verse eid="PSA 128:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 128:6"/>እጆሌ እጆሌኬቲ ንአርግ፤</para>
  <para style="q2" vid="PSA 128:6">ነጋን እስራኤሊፍ ሃተኡ።<verse eid="PSA 128:6"/></para>
  <chapter eid="PSA 128"/>
  <chapter number="129" style="c" sid="PSA 129"/>
  <para style="cl">ፋርፈትና 129</para>
  <para style="ms1">ከዸትና ዲኖተ ጥዮኒን ሞርሙፍ ከዸተሜ</para>
  <para style="d">ፋርፈትና ኦል በኡ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 129:1"/>እስራኤል አከነ ሃጄዹ፤</para>
  <para style="q2" vid="PSA 129:1">“እሳን ደርገጉማኮቲ ጀልቀበኒ አከ መሌ ነ ጩንቁርሰኒሩ፤<verse eid="PSA 129:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 129:2"/>እሳን ደርገጉማኮቲ ጀልቀበኒ አከ መሌ ነ ጩንቁርሰኒሩ፤</para>
  <para style="q2" vid="PSA 129:2">ገሩ ነ ህንሞአትኔ።<verse eid="PSA 129:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 129:3"/>ወር ቆቲሰ ቆተን ዱግደኮ ቆተን፤</para>
  <para style="q2" vid="PSA 129:3">ቦኦሳኒስ ንዼሬሰን።<verse eid="PSA 129:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 129:4"/>
    <char style="nd">ዋቀዮ</char> ገሩ ቀጄላዸ፤</para>
  <para style="q2" vid="PSA 129:4">ፉኞ ጀልኦታ ገርገር ኩኩቴረ።”<verse eid="PSA 129:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 129:5"/>ወር ጥዮንን ጅበን ሁንድኑ፣</para>
  <para style="q2" vid="PSA 129:5">ቃኒዻን ዱበት ሃዴብአን።<verse eid="PSA 129:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 129:6"/>እሳን አከ መርገ በንቲ መናራ</para>
  <para style="q2" vid="PSA 129:6">ከን ኡቱ ህንጉደትን ጎጉ ሃተአን፤<verse eid="PSA 129:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 129:7"/>ነምች ሃሙ ቀባሳ ጉተቹ፣</para>
  <para style="q2" vid="PSA 129:7">ዮካን ነምች ወልት ቀቡ ብሲሳ ጉተቹ ህንደንደኡ።<verse eid="PSA 129:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 129:8"/>ወር አቺን ደርበን፣ “ኤብ <char style="nd">ዋቀዮ</char> እስኒፍ ሃተኡ፤</para>
  <para style="q2" vid="PSA 129:8">መቃ <char style="nd">ዋቀዮቲን</char> እስን ኤብፍነ” እሳኒን ህንጄዽን።<verse eid="PSA 129:8"/></para>
  <chapter eid="PSA 129"/>
  <chapter number="130" style="c" sid="PSA 130"/>
  <para style="cl">ፋርፈትና 130</para>
  <para style="ms1">ዋምቸ ገርጋርሳፍ ዽኣቴ</para>
  <para style="d">ፋርፈትና ኦል በኡ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 130:1"/>ያ <char style="nd">ዋቀዮ</char>፣ አን ቦለ ገድ ፈጎ ኬሳ <optbreak/> ስት ነንእየዸ፤<verse eid="PSA 130:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="PSA 130:2"/>ያ ጎፍታ፣ ሰገሌኮ ዸገእ።</para>
  <para style="q1" vid="PSA 130:2">ጉርኬስ ሰገሌ ዋመተኮ</para>
  <para style="q2" vid="PSA 130:2">ጥዬፈቴ ሃዸገኡ።<verse eid="PSA 130:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 130:3"/>ያ <char style="nd">ዋቀዮ</char>፣ ኡቱ አት ጩቡ ለኮፍቴ፣</para>
  <para style="q2" vid="PSA 130:3">ያ ጎፍታ ስላ ኤኙቱ ዻበቹ ደንደአ?<verse eid="PSA 130:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 130:4"/>ገሩ ዺፈምን ስ ብረ ጅረ፤</para>
  <para style="q2" vid="PSA 130:4">ከናፍ አት ንሶዳተምተ።<verse eid="PSA 130:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 130:5"/>አን <char style="nd">ዋቀዮን</char> ነንኤገዸ፤ ሉቡንኮስ እሰ ኤገት፤</para>
  <para style="q2" vid="PSA 130:5">ዱቢሳስ ነንአብደዸ።<verse eid="PSA 130:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 130:6"/>ኤግዶተ በሪ ለፋ ኤገተን ጫላ፣</para>
  <para style="q2" vid="PSA 130:6">ዹጉማን ኤግዶተ በሪ ለፋ ኤገተን ጫላ</para>
  <para style="q2" vid="PSA 130:6">ሉቡንኮ ጎፍታ ኤገት።<verse eid="PSA 130:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 130:7"/>ያ እስራኤል፣ አት <char style="nd">ዋቀዮን</char> አብደዹ፤</para>
  <para style="q2" vid="PSA 130:7">
    <char style="nd">ዋቀዮ</char> ብረ ጃለል ዹመ ህንቀብኔ፣</para>
  <para style="q2" vid="PSA 130:7">ፉሪን ጉቱንስ ንጅራቲ።<verse eid="PSA 130:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 130:8"/>እን መታንሳ ጩቡሳኒ</para>
  <para style="q2" vid="PSA 130:8">ሁንዱማራ እስራኤልን ንፉረ።<verse eid="PSA 130:8"/></para>
  <chapter eid="PSA 130"/>
  <chapter number="131" style="c" sid="PSA 131"/>
  <para style="cl">ፋርፈትና 131</para>
  <para style="ms1">ዋቀ አመነቹ</para>
  <para style="d">ፋርፈትና ኦል በኡ። ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 131:1"/>ያ <char style="nd">ዋቀዮ</char>፣ ገራንኮ ኦፍ ህንጀጁ፤</para>
  <para style="q2" vid="PSA 131:1">እጅኮስ ኦፍ ህንቱሉ፤</para>
  <para style="q2" vid="PSA 131:1">አን ዋን ጉዳፊ ዋን ሁምነኮቲ ኦል ተኤ ኬሰ ህንሴኑ።<verse eid="PSA 131:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 131:2"/>አን ገሩ ሉቡኮ አፋን ቀበቺሴረ፤ ጨልእሲሴረስ፤</para>
  <para style="q2" vid="PSA 131:2">አኩመ ዳእምን ሀርመ ሃዸሳ ጉሰን ቶኮ ሃዸት እርከቴ ቦቆቱ ሰነ፣</para>
  <para style="q2" vid="PSA 131:2">አኩመ ዳእመ ሀርመ ሃዸሳ ጉሰኒ ሉቡንኮ ነ ኬሰት ጨልእስቴ።<verse eid="PSA 131:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 131:3"/>ያ እስራኤል፣ አማፊ በረ በራፍ፣</para>
  <para style="q2" vid="PSA 131:3">
    <char style="nd">ዋቀዮን</char> አብደዹ።<verse eid="PSA 131:3"/></para>
  <chapter eid="PSA 131"/>
  <chapter number="132" style="c" sid="PSA 132"/>
  <para style="cl">ፋርፈትና 132</para>
  <para style="ms1">ፋርፈትና ዴብፈሙ ታቦታ</para>
  <para style="mr">
    <ref loc="PSA 132:8-10">132፥8‑10</ref> ኩወፈ – <char style="xt"><ref loc="2CH 6:41-42">2ሴና 6፥41‑42</ref></char></para>
  <para style="d">ፋርፈትና ኦል በኡ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 132:1"/>ያ <char style="nd">ዋቀዮ</char>፣ ዳዊቲፊ</para>
  <para style="q2" vid="PSA 132:1">ረክነ እን ኦብሴ ሁንዱማ ያደዹ።<verse eid="PSA 132:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 132:2"/>እን ከኩ ቶኮ <char style="nd">ዋቀዮፍ</char> ከከቴ</para>
  <para style="q2" vid="PSA 132:2">ዋቀ ያቆብ ጀባ ሰናፍ አከነ ጄዼ ወሬጌ፦<verse eid="PSA 132:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 132:3"/>“አን መነኮ ኦል ህንሴኑ፤</para>
  <para style="q2" vid="PSA 132:3">ዮካን ስሬኮት ኦል ህንበኡ።<verse eid="PSA 132:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 132:4"/>አን እጀኮቲፍ ህርበ፣</para>
  <para style="q2" vid="PSA 132:4">ባሌ እጀኮቲቲፍሞ ሙጋቲ ህንኤየሙ፤<verse eid="PSA 132:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 132:5"/>ኩንስ ሀመ አን <char style="nd">ዋቀዮፍ</char> እዶ አርጉት፣</para>
  <para style="q2" vid="PSA 132:5">ዋቀ ያቆብ ጀባ ሰናፍ እዶ ጅሬኛ አርጉት።”<verse eid="PSA 132:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 132:6"/>ኩኖ፣ ኤፍራታት ዋኤሳ ዸጌኜ፤</para>
  <para style="q2" vid="PSA 132:6">ያኣርትስ እሰ አርገትኔ፦<verse eid="PSA 132:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 132:7"/>“ኮታ እዶ ጅሬኘሳ ዸቅና፤</para>
  <para style="q2" vid="PSA 132:7">ኤጄተ ሚለሳ ጀለትስ ኩፍኔ ዋቄፈትና።<verse eid="PSA 132:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 132:8"/>‘ያ <char style="nd">ዋቀዮ</char> ከኢቲ፣ ገረ እዶ ቦቆናኬቲ ኮቱ፤</para>
  <para style="q2" vid="PSA 132:8">አቲፊ ታቦትን ጀብነኬቲስ ኮታ።<verse eid="PSA 132:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 132:9"/>ሉቦትንኬ ቀጄሉማ ሃኡፈተን፤</para>
  <para style="q2" vid="PSA 132:9">ቁልቁሎትንኬስ ገመቹዻን ሃፋርፈተን።’ ”<verse eid="PSA 132:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 132:10"/>ሰበቢ ገርብቸኬ ዳዊቲፍ ጄዺቲ፣</para>
  <para style="q2" vid="PSA 132:10">ድበማኬ ህንገትን።<verse eid="PSA 132:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 132:11"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዼ ከኩ ዹጋ ቶኮ ዳዊቲፍ ከከቴረ፤</para>
  <para style="q2" vid="PSA 132:11">እን ከኩ ከነራ ዱበት ህንዴብኡ፦</para>
  <para style="q2" vid="PSA 132:11">“አን እልማንኬ ኬሳ እሰ ቶኮ ቴሶኬረ ነንቴስሰ፤<verse eid="PSA 132:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 132:12"/>ዮ እልማንኬ ከኩኮፊ ሴረ አን እሳን በርሲሱ ኤገን፣</para>
  <para style="q2" vid="PSA 132:12">እልማንሳኒስ አከሱመ በረ በራ ሀመ በረ በራት <optbreak/> ቴሶኬረ ንታኡ።”<verse eid="PSA 132:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 132:13"/>
    <char style="nd">ዋቀዮ</char> ጥዮንን ፍለቴራቲ፤</para>
  <para style="q2" vid="PSA 132:13">አከ እሼን እዶ ጅሬኘሳ ታቱስ ፌዼ አከነ ጄዼረ፦<verse eid="PSA 132:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 132:14"/>“ኩን በረ በራ ሀመ በረ በራት እዶ ጅሬኛኮት፤</para>
  <para style="q2" vid="PSA 132:14">ከነስ አን ዋነን ፌዼፍ፣ አስ ነንጅራዸ።<verse eid="PSA 132:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 132:15"/>አን ዋን ሁንዳን እሼ ነንኤብሰ፤</para>
  <para style="q2" vid="PSA 132:15">ህዬዪሼሌ ቡዴነ ነንቁብሰ።<verse eid="PSA 132:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 132:16"/>ሉቦተሼት ፈይነ ነንኡፍሰ፤</para>
  <para style="q2" vid="PSA 132:16">ቁልቁሎንሼስ ገመቹዻን ንፋርፈቱ።<verse eid="PSA 132:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 132:17"/>“አን አችት አከ ጋንፍ ቶኮ ዳዊቲፍ ብቅሉ ነንጎዸ፤</para>
  <para style="q2" vid="PSA 132:17">ድበማኮፍስ እብሳ ቆጴሴረ።<verse eid="PSA 132:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 132:18"/>ዲኖተሳት ቃኒ ነንኡፍሰ፤</para>
  <para style="q2" vid="PSA 132:18">ጎንፎን መታሳራ ገሩ ንእፈ።”<verse eid="PSA 132:18"/></para>
  <chapter eid="PSA 132"/>
  <chapter number="133" style="c" sid="PSA 133"/>
  <para style="cl">ፋርፈትና 133</para>
  <para style="ms1">ጃለለ ኦቦሉማ</para>
  <para style="d">ፋርፈትና ኦል በኡ። ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 133:1"/>ኦቦሎትን ቶኩማዻን ወሊ ወጅን ጅራቹን፣</para>
  <para style="q2" vid="PSA 133:1">አከም ጋሪዸ! አከም ነመት ቶለስ!<verse eid="PSA 133:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 133:2"/>ኩን አከ ዘይቲ ገቲ ጉዳ</para>
  <para style="q2" vid="PSA 133:2">ከን መታረት ዸንገላፈሜ፣</para>
  <para style="q1" vid="PSA 133:2">አከ እሰ አሬደረ ገድ ያኡ፣</para>
  <para style="q2" vid="PSA 133:2">አሬደ አሮንረ፣ ሞርመ ኡፈተሳረስ ገድ ያአት።<verse eid="PSA 133:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 133:3"/>እንስ አኩመ ፍጤንሰ ሄርሞን፣</para>
  <para style="q2" vid="PSA 133:3">ከን ቱሉ ጥዮንረ ገድ ያኡት።</para>
  <para style="q1" vid="PSA 133:3">አችረት <char style="nd">ዋቀዮ</char> ሀመ በረ በራት ኤበሳ፣</para>
  <para style="q2" vid="PSA 133:3">ጅሬኘስ አጀጄራቲ።<verse eid="PSA 133:3"/></para>
  <chapter eid="PSA 133"/>
  <chapter number="134" style="c" sid="PSA 134"/>
  <para style="cl">ፋርፈትና 134</para>
  <para style="ms1">ፋርፈትና ሀልከኒ</para>
  <para style="d">ፋርፈትና ኦል በኡ።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 134:1"/>እስን ተጃጅልቶትን <char style="nd">ዋቀዮ</char>፣</para>
  <para style="q2" vid="PSA 134:1">ወር ሀልከን መነ <char style="nd">ዋቀዮ</char> ኬሰ ተጃጅልተን ሁንድኑ፣</para>
  <para style="q2" vid="PSA 134:1">
    <char style="nd">ዋቀዮን</char> ገለቴፈዻ።<verse eid="PSA 134:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 134:2"/>መነ ቁልቁሉማ ኬሰት ሀርከኬሰን ኦል ቀባቲ</para>
  <para style="q2" vid="PSA 134:2">
    <char style="nd">ዋቀዮን</char> ገለቴፈዻ።<verse eid="PSA 134:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 134:3"/>
    <char style="nd">ዋቀዮ</char> ሰሚፊ ለፈ ኡሜ ሱን</para>
  <para style="q2" vid="PSA 134:3">ጥዮንራ እስን ሃኤብሱ።<verse eid="PSA 134:3"/></para>
  <chapter eid="PSA 134"/>
  <chapter number="135" style="c" sid="PSA 135"/>
  <para style="cl">ፋርፈትና 135</para>
  <para style="ms1">ፋርፈትና ገለታ</para>
  <para style="mr">
    <ref loc="PSA 135:15-20">135፥15‑20</ref> ኩወፈ – <char style="xt"><ref loc="PSA 115:4-11">ፋር 115፥4‑11</ref></char></para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 135:1"/>ሃሌሉያ።</para>
  <para style="b" vid="PSA 135:1"/>
  <para style="q1" vid="PSA 135:1">መቃ <char style="nd">ዋቀዮ</char> ጀጀዻ፤</para>
  <para style="q2" vid="PSA 135:1">እስን ገርቦን <char style="nd">ዋቀዮ</char> እሰ ገለቴፈዻ።<verse eid="PSA 135:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 135:2"/>እስን ወር መነ <char style="nd">ዋቀዮ</char> ኬሰ፣</para>
  <para style="q2" vid="PSA 135:2">ኦብዲ መነ ዋቀኬኛ ኬሰ ተጃጅልተን፣ እሰ ገለቴፈዻ።<verse eid="PSA 135:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 135:3"/>
    <char style="nd">ዋቀዮ</char> ጋሪዻቲ፣ <char style="nd">ዋቀዮን</char> ገለቴፈዻ፤</para>
  <para style="q2" vid="PSA 135:3">እን አርጃዻቲ መቃሳቲፍ ፋርፈዻ።<verse eid="PSA 135:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 135:4"/>
    <char style="nd">ዋቀዮ</char> ያቆብን ኦፊሳቲፍ፣</para>
  <para style="q2" vid="PSA 135:4">እስራኤልንሞ ዻለ ዹንፋሳ ጎዼ ፍለቴራቲ።<verse eid="PSA 135:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 135:5"/>አን አከ <char style="nd">ዋቀዮ</char> ጉዳ ተኤ፣</para>
  <para style="q2" vid="PSA 135:5">አከ ጎፍታንኬኘ ዋቆተ ሁንደ ጫላ ጉዳ ተኤ ቤከ።<verse eid="PSA 135:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 135:6"/>
    <char style="nd">ዋቀዮ</char> ሰሚወን ኬሰቲፊ ለፈረት፣</para>
  <para style="q2" vid="PSA 135:6">ገላኖታፊ ቱጁበሳኒ ሁንደ ኬሰት፣</para>
  <para style="q2" vid="PSA 135:6">ዋን እሰ ገመቺሱ ከምዩ ንሆጄተ።<verse eid="PSA 135:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 135:7"/>እን አከ ዱሜሶን ዳሪ ለፋቲ ከአን ንጎዸ፤</para>
  <para style="q2" vid="PSA 135:7">ቦካ ወጅን በለቄ ኤርገ፤</para>
  <para style="q2" vid="PSA 135:7">ጎምብሳሳ ኬሳስ ቡቤ ገድ ባሰ።<verse eid="PSA 135:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 135:8"/>እን ሀንገፎተ ግብጥ፣</para>
  <para style="q2" vid="PSA 135:8">ከን ነማቲፊ ከን ሆሪ ንዸኤ።<verse eid="PSA 135:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 135:9"/>ያ ግብጥ፣ እን ግዱኬት፣</para>
  <para style="q2" vid="PSA 135:9">ፈረኦኒፊ ተጃጅልቶተሳ ሁንደት መለቶፊ ድንቂሳ ኤርጌረ።<verse eid="PSA 135:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 135:10"/>እን ሰቦተ ባይኤ ዸኤ</para>
  <para style="q2" vid="PSA 135:10">ሞቶተ ጀጀቦ አጄሴ፤<verse eid="PSA 135:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 135:11"/>ስሆን ሞቲ ወረ አሞሮታ፣</para>
  <para style="q2" vid="PSA 135:11">ኦግ ሞቲ ባሻኒፊ ሞቶተ ከነኣን ሁንደ ንአጄሴ፤<verse eid="PSA 135:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 135:12"/>ለፈሳኒ ዻለ ጎዼ</para>
  <para style="q2" vid="PSA 135:12">አከ ዻለሳኒ ተኡፍስ ሰበሳ እስራኤሊፍ ኬኔ።<verse eid="PSA 135:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 135:13"/>ያ <char style="nd">ዋቀዮ</char>፣ መቃንኬ በረ በራን ጅራተ፤</para>
  <para style="q2" vid="PSA 135:13">ያ <char style="nd">ዋቀዮ</char>፣ አት ዸሎተ ሁንደ ኬሰት ንያደተምተ።<verse eid="PSA 135:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 135:14"/>
    <char style="nd">ዋቀዮ</char> ሰበሳቲፍ ንፈልመ፤</para>
  <para style="q2" vid="PSA 135:14">ተጃጅልቶተሳቲፍስ ገራ ላፈ።<verse eid="PSA 135:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 135:15"/>ዋቆትን ቶልፈሞን ነሞተ ኦርማ ሜቲፊ</para>
  <para style="q2" vid="PSA 135:15">ወርቄ ሀርከ ነማቲን ሆጄተመኒዸ።<verse eid="PSA 135:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 135:16"/>እሳን አፋን ቀቡ፤ ገሩ ዱበቹ ህንደንደአን፤</para>
  <para style="q2" vid="PSA 135:16">እጀስ ቀቡ፤ ገሩ አርጉ ህንደንደአን፤<verse eid="PSA 135:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 135:17"/>ጉረ ቀቡ፤ ገሩ ዸገኡ ህንደንደአን፤</para>
  <para style="q2" vid="PSA 135:17">ዮካን ሀፉር ቶኮዩ አፋንሳኒ ኬሰ ህንጅሩ።<verse eid="PSA 135:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 135:18"/>ወር እሳን ቶልቸን ከኔን እሳን አመነተን ሁንድ</para>
  <para style="q2" vid="PSA 135:18">አኩመሳኒ ተኡ።<verse eid="PSA 135:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 135:19"/>ያ መነ እስራኤል <char style="nd">ዋቀዮን</char> ኤብሳ፤</para>
  <para style="q2" vid="PSA 135:19">ያ መነ አሮን <char style="nd">ዋቀዮን</char> ኤብሳ፤<verse eid="PSA 135:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 135:20"/>ያ መነ ሌዊ <char style="nd">ዋቀዮን</char> ኤብሳ፤</para>
  <para style="q2" vid="PSA 135:20">እስን ወር እሰ ሶዳተንስ፣ <char style="nd">ዋቀዮን</char> ኤብሳ።<verse eid="PSA 135:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 135:21"/>
    <char style="nd">ዋቀዮ</char> እን ዬሩሳሌም ኬሰ ጅራቱ ሱን፣</para>
  <para style="q2" vid="PSA 135:21">ጥዮንራ ሃኤብፈሙ።</para>
  <para style="b" vid="PSA 135:21"/>
  <para style="q1" vid="PSA 135:21">ሃሌሉያ!<verse eid="PSA 135:21"/></para>
  <chapter eid="PSA 135"/>
  <chapter number="136" style="c" sid="PSA 136"/>
  <para style="cl">ፋርፈትና 136</para>
  <para style="ms1">ፋርፈትና ወል ጀላ ቀበኒ ፋርፈተን</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 136:1"/>
    <char style="nd">ዋቀዮፍ</char> ገለተ ገልቻ፤ እን ጋሪዻቲ።</para>
  <para style="qr" vid="PSA 136:1">ጃለልሳ በረ በራን ጅራተ።<verse eid="PSA 136:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 136:2"/>ዋቀ ዋቆታቲፍ ገለተ ገልቻ።</para>
  <para style="qr" vid="PSA 136:2">ጃለልሳ በረ በራን ጅራተ።<verse eid="PSA 136:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 136:3"/>ጎፍታ ጎፍቶታቲፍ ገለተ ገልቻ፦</para>
  <para style="qr" vid="PSA 136:3">ጃለልሳ በረ በራን ጅራተ።<verse eid="PSA 136:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 136:4"/>እን ኮጳሳ ድንቂ ጉርጉዳ ሆጄተ፤</para>
  <para style="qr" vid="PSA 136:4">ጃለልሳ በረ በራን ጅራተ።<verse eid="PSA 136:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 136:5"/>እን ኦጉማሳቲን ሰሚወን ኡሜ፤</para>
  <para style="qr" vid="PSA 136:5">ጃለልሳ በረ በራን ጅራተ።<verse eid="PSA 136:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 136:6"/>እን ብሻኖተረት ለፈ ድሪርሴ፤</para>
  <para style="qr" vid="PSA 136:6">ጃለልሳ በረ በራን ጅራተ።<verse eid="PSA 136:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 136:7"/>እን እፈ ጉርጉዳ ሆጄቴ፤</para>
  <para style="qr" vid="PSA 136:7">ጃለልሳ በረ በራን ጅራተ።<verse eid="PSA 136:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 136:8"/>እን አከ ቢፍቱን ጉያ ሞቱ ጎዼ፤</para>
  <para style="qr" vid="PSA 136:8">ጃለልሳ በረ በራን ጅራተ።<verse eid="PSA 136:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 136:9"/>እን አከ ጅኢፊ ኡርጂወን ሀልከን ሞአን ጎዼ፤</para>
  <para style="qr" vid="PSA 136:9">ጃለልሳ በረ በራን ጅራተ።<verse eid="PSA 136:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 136:10"/>እን ሀንገፈ ግብጥ ዸኤ፤</para>
  <para style="qr" vid="PSA 136:10">ጃለልሳ በረ በራን ጅራተ።<verse eid="PSA 136:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 136:11"/>እን እሳን ግዱዻ እስራኤልን ባሴ፤</para>
  <para style="qr" vid="PSA 136:11">ጃለልሳ በረ በራን ጅራተ።<verse eid="PSA 136:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 136:12"/>ሀርከ ጀባፊ እሬ ድሪራዻን እስራኤልን ባሴ፤</para>
  <para style="qr" vid="PSA 136:12">ጃለልሳ በረ በራን ጅራተ።<verse eid="PSA 136:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 136:13"/>እን ገላነ ዲማ እዶ ለመት ገርገሪ ቆዴ፤</para>
  <para style="qr" vid="PSA 136:13">ጃለልሳ በረ በራን ጅራተ።<verse eid="PSA 136:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 136:14"/>እን ገላነ ግዱዻን እስራኤልን ደበርሴ፤</para>
  <para style="qr" vid="PSA 136:14">ጃለልሳ በረ በራን ጅራተ።<verse eid="PSA 136:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 136:15"/>ፈረኦኒፊ ሎልቶተሳ ገሩ ገላነ ዲማት ነቄ፤</para>
  <para style="qr" vid="PSA 136:15">ጃለልሳ በረ በራን ጅራተ።<verse eid="PSA 136:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 136:16"/>እን ሰበ ኦፊሳ ገሞጂ ኬሰ ጌጌሴ፤</para>
  <para style="qr" vid="PSA 136:16">ጃለልሳ በረ በራን ጅራተ።<verse eid="PSA 136:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 136:17"/>እን ሞቶተ ጉርጉዳ ዸኤ፤</para>
  <para style="qr" vid="PSA 136:17">ጃለልሳ በረ በራን ጅራተ።<verse eid="PSA 136:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 136:18"/>እን ሞቶተ ጀጀቦ ፍጤ፤</para>
  <para style="qr" vid="PSA 136:18">ጃለልሳ በረ በራን ጅራተ።<verse eid="PSA 136:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 136:19"/>እን ስሆን ሞቲ አሞሮታ አጄሴ፤</para>
  <para style="qr" vid="PSA 136:19">ጃለልሳ በረ በራን ጅራተ።<verse eid="PSA 136:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 136:20"/>እን ኦግ ሞቲ ባሻን አጄሴ፤</para>
  <para style="qr" vid="PSA 136:20">ጃለልሳ በረ በራን ጅራተ።<verse eid="PSA 136:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 136:21"/>እን ብየሳኒ ዻለ ጎዼ ኬኔ፤</para>
  <para style="qr" vid="PSA 136:21">ጃለልሳ በረ በራን ጅራተ።<verse eid="PSA 136:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 136:22"/>ዻለ ጎዼ ገርብቸሳ እስራኤሊፍ ኬኔ፤</para>
  <para style="qr" vid="PSA 136:22">ጃለልሳ በረ በራን ጅራተ።<verse eid="PSA 136:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 136:23"/>እን ዬሮ ኑ ገድ ዴብኔት ኑ ያደቴ፤</para>
  <para style="qr" vid="PSA 136:23">ጃለልሳ በረ በራን ጅራተ።<verse eid="PSA 136:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 136:24"/>እን ሀርከ ዲኖተኬኛቲ ኑ ባሴ፣</para>
  <para style="qr" vid="PSA 136:24">ጃለልሳ በረ በራን ጅራተ።<verse eid="PSA 136:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 136:25"/>እን ኡመመ ሁንዳፍ ሶረ ኬነ፤</para>
  <para style="qr" vid="PSA 136:25">ጃለልሳ በረ በራን ጅራተ።<verse eid="PSA 136:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 136:26"/>ዋቀ ሰሚቲፍ ገለተ ገልቻ።</para>
  <para style="qr" vid="PSA 136:26">ጃለልሳ በረ በራን ጅራተ።<verse eid="PSA 136:26"/></para>
  <chapter eid="PSA 136"/>
  <chapter number="137" style="c" sid="PSA 137"/>
  <para style="cl">ፋርፈትና 137</para>
  <para style="ms1">ፋርፈትና ቦጅአምቶታ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 137:1"/>ኑ ዬሮ ጥዮንን ያደኔት፣</para>
  <para style="q2" vid="PSA 137:1">ለጌን ባብሎን ብረ ቴኜ ቦኜ።<verse eid="PSA 137:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 137:2"/>አችትስ ክራረኬኘ</para>
  <para style="q2" vid="PSA 137:2">ሙከ አለልቱት ፈንፍኔ፤<verse eid="PSA 137:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 137:3"/>አችት ወር ኑ ቦጅአን ፋርፈትና፣ ወር ኑ ዽጵሰንስ፣</para>
  <para style="q2" vid="PSA 137:3">“ፋርፈናወን ጥዮን ኬሳ ቶኮ ኑ ፋርፈዻ!”</para>
  <para style="q2" vid="PSA 137:3">ጄዸኒ አከ ኑ ፋርፈትና ገመቹ እሳኒፍ ፋርፈትኑ ኑ ጋፈተን።<verse eid="PSA 137:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 137:4"/>ኑ ኡቱ ብየ ኦርማ ጅሩ፣</para>
  <para style="q2" vid="PSA 137:4">አከምት ፋርፈትና <char style="nd">ዋቀዮ</char> ፋርፈቹ ደንዴኘ?<verse eid="PSA 137:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 137:5"/>ያ ዬሩሳሌም፣ ዮ አን ስ እራንፈዼ፣</para>
  <para style="q2" vid="PSA 137:5">ሀርክኮ ምርጋ ኦጉማሳ ሃእራንፈቱ።<verse eid="PSA 137:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 137:6"/>ዮ አን ስ ያደቹ ባዼ፣</para>
  <para style="q2" vid="PSA 137:6">ዮ አን ገመቹኮ ጉድቻ ኦልት</para>
  <para style="q1" vid="PSA 137:6">ዬሩሳሌምን እላሉ ባዼ፣</para>
  <para style="q2" vid="PSA 137:6">አረብንኮ ላጋኮት ሃመጠኑ።<verse eid="PSA 137:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 137:7"/>ያ <char style="nd">ዋቀዮ</char>፣ ዋን ወር ኤዶም</para>
  <para style="q2" vid="PSA 137:7">ጋፈ ዬሩሳሌም ዲገምቴ ጄዸን ሰነ ያደዹ፤</para>
  <para style="q1" vid="PSA 137:7">እሳንስ፣ “እሼ ዲጋ!</para>
  <para style="q2" vid="PSA 137:7">ሀመ ሁንዴሼት እሼ ዲጋ!” ጄዸኒ እየን።<verse eid="PSA 137:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 137:8"/>ያ እንተለ ባብሎን፣ ከን በዱዻፍ ቆጶፍቴ፣</para>
  <para style="q2" vid="PSA 137:8">እን ዋን አት ኑ ጎቴ ሰናፍ፣</para>
  <para style="q2" vid="PSA 137:8">ገቲኬ ሲፍ ኬኑ ኤብፈማዸ።<verse eid="PSA 137:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 137:9"/>እን ዳእመንኬ ቀቤ</para>
  <para style="q2" vid="PSA 137:9">ዸጋረት ጨጨብሱ ሱን ኤብፈማዸ።<verse eid="PSA 137:9"/></para>
  <chapter eid="PSA 137"/>
  <chapter number="138" style="c" sid="PSA 138"/>
  <para style="cl">ፋርፈትና 138</para>
  <para style="ms1">ፋርፈትና ገለታ</para>
  <para style="d">ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 138:1"/>ያ <char style="nd">ዋቀዮ</char>፣ አን ገራኮ ጉቱዻን ስን ገለቴፈዸ፤</para>
  <para style="q2" vid="PSA 138:1">ፉለ “ዋቆታ” ዱረትስ ገለተኬ ነንፋርፈዸ።<verse eid="PSA 138:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 138:2"/>ሰበቢ አት መቃኬቲፊ ዱቢኬ ዋን ሁንዳ ኦልት ጉድፍቴፍ፣</para>
  <para style="q2" vid="PSA 138:2">አን ሰበቢ ጃለላፊ አመነሙማኬቲቲፍ</para>
  <para style="q1" vid="PSA 138:2">ገረ መነ ቁልቁሉማኬ ቁልቁልቻት ገድ ጄዼ፣</para>
  <para style="q2" vid="PSA 138:2">መቃኬ ነንሌልሰ።<verse eid="PSA 138:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 138:3"/>ዬሮ አን ስ ዋመዼት አት ዴቢ ና ኬንቴ፤</para>
  <para style="q2" vid="PSA 138:3">እሬኬቲንስ ነ ጀቤስቴ።<verse eid="PSA 138:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 138:4"/>ያ <char style="nd">ዋቀዮ</char>፣ ሞቶትን ለፋ ሁንድኑ፣</para>
  <para style="q2" vid="PSA 138:4">ዬሮ ዱቢ አፋንኬቲ ዸገአንት ስ ሃሌልሰን።<verse eid="PSA 138:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 138:5"/>ኡልፍን <char style="nd">ዋቀዮ</char>፣ ጉዳዻቲ፣</para>
  <para style="q2" vid="PSA 138:5">እሳን ዋኤ ከራ <char style="nd">ዋቀዮ</char> ሃፋርፈተን።<verse eid="PSA 138:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 138:6"/>
    <char style="nd">ዋቀዮ</char> ዮ ኦል ፈጎ ጅራቴዩ፣ <optbreak/> ነመ ገድ ቀበሜ ንእላለ፤</para>
  <para style="q2" vid="PSA 138:6">ነመ ኦፍ ቱሉሞ ፈጎት ቤከ።<verse eid="PSA 138:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 138:7"/>አን ረክነ ኬሰ ጅራዹዩ፣</para>
  <para style="q2" vid="PSA 138:7">አት ሉቡኮ ንኤግደ፤</para>
  <para style="q1" vid="PSA 138:7">ኣሪ ዲነኮት ሀርከኬ ንድሪርስተ፤</para>
  <para style="q2" vid="PSA 138:7">ሀርከኬ ምርጋቲንስ ነ ኦልችተ።<verse eid="PSA 138:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 138:8"/>
    <char style="nd">ዋቀዮ</char> ካዮሳ ፊጣን ና ባሰ፤</para>
  <para style="q2" vid="PSA 138:8">ያ <char style="nd">ዋቀዮ</char>፣ ጃለልኬ በረ በራን ጅራተ፤</para>
  <para style="q2" vid="PSA 138:8">ሆጂ ሀርከኬቲ ህንገትን።<verse eid="PSA 138:8"/></para>
  <chapter eid="PSA 138"/>
  <chapter number="139" style="c" sid="PSA 139"/>
  <para style="cl">ፋርፈትና 139</para>
  <para style="ms1">ዋቀ ዋን ሁንደ ቤኩ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 139:1"/>ያ <char style="nd">ዋቀዮ</char>፣ አት ነ ቆርቴርተ፤</para>
  <para style="q2" vid="PSA 139:1">ነ ቤክቴርተስ።<verse eid="PSA 139:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 139:2"/>አት ዬሮ አን ገድ ታኡፊ ዬሮ አን ኦል ከኡ ንቤክተ፤</para>
  <para style="q2" vid="PSA 139:2">ያደኮስ ፈጎት ሁበተ።<verse eid="PSA 139:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 139:3"/>ዴሙኮፊ ጪሱኮ አዳን ባፍቴ ቤክተ፤</para>
  <para style="q2" vid="PSA 139:3">ከራኮ ሁንደስ ቤክተ።<verse eid="PSA 139:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 139:4"/>ያ <char style="nd">ዋቀዮ</char>፣ አከ ዱቢን ቶኮዩ አረበኮ ህንጅሬ፣</para>
  <para style="q2" vid="PSA 139:4">አት ጉቱማን ጉቱት ንቤክተ።<verse eid="PSA 139:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 139:5"/>አት ዱራፊ ዱባን ነ መርስቴርተ፤</para>
  <para style="q2" vid="PSA 139:5">ሀርከኬስ ነረ ኬሴርተ።<verse eid="PSA 139:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 139:6"/>ቤኩምስ አከና አናፍ አከ መሌ ድንቂዸ፤</para>
  <para style="q2" vid="PSA 139:6">ሁበቹፍስ አከ መሌ ነራ ፈጎዸ።<verse eid="PSA 139:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 139:7"/>ሀፉረኬ ብራ አን ኤሰ ዸቁን ደንደአ?</para>
  <para style="q2" vid="PSA 139:7">ፉለኬ ዱራስ አን ኤሰት በቀቹን ደንደአ?<verse eid="PSA 139:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 139:8"/>ዮ አን ሰሚወንት ኦል በኤ፣ አት አች ጅርተ፤</para>
  <para style="q2" vid="PSA 139:8">ዮ አን ስሬኮ ሲኦል ኬሰ ዻበዼስ፣ አችስ ንጅርተ።<verse eid="PSA 139:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 139:9"/>ዮ አን ቆቾ ገነማቲን</para>
  <para style="q2" vid="PSA 139:9">በርሴ ቀርቀረ ገላና ፈጎረ ቁበዼ፣<verse eid="PSA 139:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 139:10"/>አችትስ ሀርክኬ ከራ ነ አርግሲሰ፤</para>
  <para style="q2" vid="PSA 139:10">ሀርክኬ ምርጋስ ጀቤሴ ነ ቀበ።<verse eid="PSA 139:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 139:11"/>ዮ አን፣ “ዹጉማን ዱከን ነ ዾክሰ፤</para>
  <para style="q2" vid="PSA 139:11">እፍንስ ናኖኮት ሀልከን ተአ” ጄዼ፣<verse eid="PSA 139:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 139:12"/>ዱከንዩ ሲፍ ዱከነ ህንተኡ፤</para>
  <para style="q2" vid="PSA 139:12">ሀልከንስ አኩመ ጉያ እፈ፤</para>
  <para style="q2" vid="PSA 139:12">ዱከን ሲፍ አኩመ እፋቲ።<verse eid="PSA 139:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 139:13"/>አት ነሙማኮ እሰ ኬሳ ኡምቴርታቲ፤</para>
  <para style="q2" vid="PSA 139:13">ገደሜሰ ሃዸኮ ኬሰትስ ነ ቶልችቴ።<verse eid="PSA 139:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 139:14"/>አን ሰበቢ ሃለ ሶዳችሳፊ ድንቅሲሳዻን ኡመሜፍ</para>
  <para style="q2" vid="PSA 139:14">ስን ገለቴፈዸ፤</para>
  <para style="q1" vid="PSA 139:14">ሆጂንኬ ድንቅሲሳዸ፤</para>
  <para style="q2" vid="PSA 139:14">ከነስ አን አከ ጋሪተን ቤከ።<verse eid="PSA 139:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 139:15"/>ዬሮ አን እዶ ዾክሳት ኡመሜ፣</para>
  <para style="q2" vid="PSA 139:15">ለፌንኮ ስ ዱራ ህንዾከትኔ።</para>
  <para style="q2" vid="PSA 139:15">ዬሮ አን ዽዽመ ለፋ ኬሰት ቶልፈሜ፣<verse eid="PSA 139:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 139:16"/>እጅኬ ዸግነኮ ከን ህንቶልፈምን አርጌ።</para>
  <para style="q2" vid="PSA 139:16">ጉዮትን ዱራን ዱርሰኒ ናፍ ሙርቴፈመን ሁንድ <optbreak/> ኡቱ ህንጅራትን፣</para>
  <para style="q2" vid="PSA 139:16">ክታበኬ ኬሰት በሬፈመኒሩ።<verse eid="PSA 139:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 139:17"/>ያ ዋቅ፣ ያደኬ ሁበቹን አከም ኡልፋተ!</para>
  <para style="q2" vid="PSA 139:17">ባይእንሳስ አከም ጉዳዸ!<verse eid="PSA 139:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 139:18"/>ኡቱ አን እሳን ለካኤ ጅራዼ፣</para>
  <para style="q2" vid="PSA 139:18">ስላ ለኮብስሳኒ ጭረቸረ ባይአተ።</para>
  <para style="q2" vid="PSA 139:18">አን ዬሮን ደመቁት፣ አመዩ ሱመ ወጅነን ጅረ።<verse eid="PSA 139:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 139:19"/>ማሎ ያ ዋቅ፣ አት ኡቱ ሀሞተ ፍጤ!</para>
  <para style="q2" vid="PSA 139:19">ወር ዺገ ነማ ዸንገላፍተን፣ ነራ ፈጋዻ!<verse eid="PSA 139:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 139:20"/>እሳን ያደ ሀማዻን ዋኤኬ ዱበቱ፤</para>
  <para style="q2" vid="PSA 139:20">ዲኖትንኬ አከሱማን መቃኬ ዸኡ።<verse eid="PSA 139:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 139:21"/>ያ <char style="nd">ዋቀዮ</char>፣ አን ወረ ስ ጅበን ህንጅቡ?</para>
  <para style="q2" vid="PSA 139:21">ወረ ስት ከአንስ ህንጥሬፈዹ?<verse eid="PSA 139:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 139:22"/>አን ሀመ ዹማት እሳን ጅቤረ፤</para>
  <para style="q2" vid="PSA 139:22">አከ ዲነኮትስ እሳን ነንሄደ።<verse eid="PSA 139:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 139:23"/>ያ ዋቅ፣ ነ ሰከተእ፤ ገራኮስ ቤክ፤</para>
  <para style="q2" vid="PSA 139:23">ቆሪቲ ነ እላል፤ ያደኮስ ቤክ።<verse eid="PSA 139:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 139:24"/>ዮ ከራን ሀምና ነ ኬሰ ጅራቴ ሜ እላል፤</para>
  <para style="q2" vid="PSA 139:24">ከራ በረ በራረስ ነ አዴምስስ።<verse eid="PSA 139:24"/></para>
  <chapter eid="PSA 139"/>
  <chapter number="140" style="c" sid="PSA 140"/>
  <para style="cl">ፋርፈትና 140</para>
  <para style="ms1">ከዸትና ሀሞተረት ዽኣቴ</para>
  <para style="d">ዱረ ቡኣ ፋርፈቶታቲፍ። ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 140:1"/>ያ <char style="nd">ዋቀዮ</char>፣ ነሞተ ሀሞ ጀላ ነ ባስ፤</para>
  <para style="q2" vid="PSA 140:1">ነሞተ ፍንጭልቶተ<verse eid="PSA 140:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 140:2"/>ወረ ገራሳኒ ኬሰት ሀምነ ያደኒ</para>
  <para style="q2" vid="PSA 140:2">ጉያ ሁንደ ወራነ ካሰን ነራ ኤግ።<verse eid="PSA 140:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 140:3"/>እሳን አረበሳኒ አኩመ ቦፋ ቀረቱ፤</para>
  <para style="q2" vid="PSA 140:3">ሀዻን ቡቲ ህዺሳኒ ጀለ ጅረ።<verse eid="PSA 140:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 140:4"/>ያ <char style="nd">ዋቀዮ</char>፣ ሀርከ ሀሞታ ነራ ኤግ፤</para>
  <para style="q2" vid="PSA 140:4">ነሞተ ፍንጭልቶተ <optbreak/> ወረ ሚለኮ ክዮት ገልቹ ያደን ጀላ ነ ባስ።<verse eid="PSA 140:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 140:5"/>ኦፍ ቱልቶትን ዾክሰኒ ክዮ ነ ዱረ ካአኒሩ፤</para>
  <para style="q2" vid="PSA 140:5">ርቡ ክዮሳኒ ድሪርሰኒሩ፤</para>
  <para style="q2" vid="PSA 140:5">ከራኮረስ ክዮሳኒ ካአኒሩ።<verse eid="PSA 140:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 140:6"/>ያ <char style="nd">ዋቀዮ</char>፣ አን፣ “አት ዋቀኮት” ሲን ነንጄዸ።</para>
  <para style="q2" vid="PSA 140:6">ያ <char style="nd">ዋቀዮ</char>፣ ዋመተኮ ዸገእ።<verse eid="PSA 140:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 140:7"/>ያ <char style="nd">ዋቀዮ</char> ጎፍታ፣ ፈይሳኮ ጀባ፣</para>
  <para style="q2" vid="PSA 140:7">አት ጉያ ወራናት ጋቸነ መታ ና ታቴ።<verse eid="PSA 140:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 140:8"/>ያ <char style="nd">ዋቀዮ</char>፣ አከ ፌዺን ሀሞታ ፊጣን በኡ ህንጎዽን፤</para>
  <para style="q2" vid="PSA 140:8">አከ እሳን ኦፍ ህንቱሌፍ፣ አከ ከሮርሳኒ ምልካኡ ህንጎዽን።<verse eid="PSA 140:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 140:9"/>መታን ወረ ነ መርሰኒ፣</para>
  <para style="q2" vid="PSA 140:9">ሀምነ አፋንሳኒቲ በኡን ሃሀጉገሙ።<verse eid="PSA 140:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 140:10"/>በርበዳን እብዳ እሳንረ ሃቡኡ፤</para>
  <para style="q2" vid="PSA 140:10">እሳን እብደትሌ ሃደርበተመን፤</para>
  <para style="q2" vid="PSA 140:10">አከ ለመተ ህንካኔፍስ ቦለ ቅሌት ሃደርበተመን።<verse eid="PSA 140:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 140:11"/>መቀ በሌስቶትን ለፈረ ህንጅራትን፤</para>
  <para style="q2" vid="PSA 140:11">ነምን ጀልኣን ዋን ሀማዻን ሃበዱ።<verse eid="PSA 140:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 140:12"/>
    <char style="nd">ዋቀዮ</char> ረከቶታፍ ፈልሜ</para>
  <para style="q2" vid="PSA 140:12">ህዬዪፍሌ ሙርቲ ቀጄላ አከ ኬኑ አን ቤከ።<verse eid="PSA 140:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 140:13"/>ዹጉማን ነምን ቀጄላን መቃኬ ንገለቴፈተ፤</para>
  <para style="q2" vid="PSA 140:13">ነምን ቶላንስ ፉለኬ ዱረ ንጅራተ።<verse eid="PSA 140:13"/></para>
  <chapter eid="PSA 140"/>
  <chapter number="141" style="c" sid="PSA 141"/>
  <para style="cl">ፋርፈትና 141</para>
  <para style="ms1">አከ ቀነኒ ጀልዾታቲን ህንፉዸተምኔ ዋቀ ከዸቹ</para>
  <para style="d">ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 141:1"/>ያ <char style="nd">ዋቀዮ</char>፣ አን ስን ዋመዸ፤ ደፊ ነ ቀቀብ።</para>
  <para style="q2" vid="PSA 141:1">ዮሙ አን ስ ዋመዹስ ሰገሌኮ ዸገእ።<verse eid="PSA 141:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 141:2"/>ከዸናንኮ ፉለኬ ዱረት አከ እጣናት አናፍ ሃፉዸተሙ፤</para>
  <para style="q2" vid="PSA 141:2">ሀርከኮ ኦል ቀበቹንኮስ አከ ኣርሳ ገልገላ አናፍ ሃተኡ።<verse eid="PSA 141:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 141:3"/>ያ <char style="nd">ዋቀዮ</char>፣ አፋንኮቲፍ ኤግዱ ና ዻብ፤</para>
  <para style="q2" vid="PSA 141:3">በልበለ አፋንኮቲስ ና ኤግ።<verse eid="PSA 141:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 141:4"/>ገራንኮ ነሞተ ዋን ሀማ ሆጄተን ወጅን፣</para>
  <para style="q2" vid="PSA 141:4">ሆጂ ሀምና ኬሰት ህርማቹፍ፣</para>
  <para style="q1" vid="PSA 141:4">ገረ ጀልእነ ከሚትዩ ህንሀርክፈምን፤</para>
  <para style="q2" vid="PSA 141:4">አከ አን ኛተሳኒ ምኣዋ ኛዹስ አናፍ ህንኤየምን።<verse eid="PSA 141:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 141:5"/>ነምን ቀጄላን ነ ሃሩኩቱ፤ ኩን ገረ ላፍናቲ፤</para>
  <para style="q2" vid="PSA 141:5">እን አነ ሃእፈቱ፤ ኩንስ ዘይቲ መታ ኮራት።</para>
  <para style="q1" vid="PSA 141:5">መታንኮ ዋን ከነ ህንድዱ።</para>
  <para style="q2" vid="PSA 141:5">ተኡስ ከዸናንኮ ዮምዩ ሆጂ ሀሞታቲን ሞርሙዸ።<verse eid="PSA 141:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 141:6"/>ቡልችቶትንሳኒ ኤዴደ ቦላራ ገድ ንደርበተሙ፤</para>
  <para style="q2" vid="PSA 141:6">እሳን ዱቢኮ ንዸገኡ፤ ዱቢንኮ ንምኣዋቲ።<verse eid="PSA 141:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 141:7"/>እሳንስ፣ “አኩመ ነምን ለፈ ቆቱ ብዮ ቡሌሱ ሰነ፣</para>
  <para style="q2" vid="PSA 141:7">ለፌንኬኘ አፋን ሲኦልረት ብትኔፈሜ ጅረ” ጄዹ።<verse eid="PSA 141:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 141:8"/>ያ <char style="nd">ዋቀዮ</char> ጎፍታ፣ አን ገሩ እጀኮ ስራ ህንቡቅፈዹ፤</para>
  <para style="q2" vid="PSA 141:8">አን ኮሉ ስት ገሌረ፤ ደበርስቴ ዱአት ነ ህንኬንን።<verse eid="PSA 141:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 141:9"/>ክዮ እሳን ናፍ ካአንራ፣</para>
  <para style="q2" vid="PSA 141:9">ክዮ ወር ጀልእነ ሆጄተን ናፍ ቆጴሰንራስ ነ ኤግ።<verse eid="PSA 141:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 141:10"/>ወር ሀሞን ክዮ ኦፊሳኒቲን ሃቀበመን፤</para>
  <para style="q2" vid="PSA 141:10">አን ገሩ ነጉማን ነንበአ።<verse eid="PSA 141:10"/></para>
  <chapter eid="PSA 141"/>
  <chapter number="142" style="c" sid="PSA 142"/>
  <para style="cl">ፋርፈትና 142</para>
  <para style="ms1">ከዸትና ነመ አርአተማ ጅሩ ቶኮ</para>
  <para style="d">
    <char style="tl">ማስኪሊ</char> ዳዊት</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 142:1"/>አን ገረ <char style="nd">ዋቀዮት</char> ነንእየ፤</para>
  <para style="q2" vid="PSA 142:1">ሰገሌኮቲንስ ፉለ <char style="nd">ዋቀዮ</char> ዱረት <optbreak/> ዋመተኮ ነንዽኤፈዸ።<verse eid="PSA 142:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 142:2"/>አን ጉንጉሚኮ ፉለሳ ዱረት ነንዸንገላሰ፤</para>
  <para style="q2" vid="PSA 142:2">ዽቤኮስ ፉለሳ ዱረት ነንህመዸ።<verse eid="PSA 142:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 142:3"/>ዬሮፍ ሀፉርኮ ነ ኬሰት ላፉ፣</para>
  <para style="q2" vid="PSA 142:3">ስቱ ከራኮ ቤከ።</para>
  <para style="q1" vid="PSA 142:3">ነሞትን ዳንዲ አን ዴሙረ፣</para>
  <para style="q2" vid="PSA 142:3">ክዮ ና ካአኒሩ።<verse eid="PSA 142:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 142:4"/>ገረ ምርገኮ እላል፤ አርግስ፤</para>
  <para style="q2" vid="PSA 142:4">ነምን ና ያዱ ቶኮዩ ህንጅሩ፤</para>
  <para style="q1" vid="PSA 142:4">አን እዶን እት ኮሉ ገሉ ቶኮሌ ህንቀቡ፤</para>
  <para style="q2" vid="PSA 142:4">ነምን ጅሬኘኮቲፍ ያዱስ ህንጅሩ።<verse eid="PSA 142:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 142:5"/>ያ <char style="nd">ዋቀዮ</char>፣ ስት ነንእየዸ፤</para>
  <para style="q2" vid="PSA 142:5">“አት እዶ አን እት ኮሉ ገሉዸ፤</para>
  <para style="q2" vid="PSA 142:5">ብየ ወረ ጅራቶ ኬሰትስ አት ቆደኮት” ነንጄዸ።<verse eid="PSA 142:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 142:6"/>አን አብዲ ኩተዼራቲ፣</para>
  <para style="q2" vid="PSA 142:6">ከዸትናኮ ና ዸገእ፤</para>
  <para style="q1" vid="PSA 142:6">ወረ ነ አርአተን ጀላ ነ ባስ፤</para>
  <para style="q2" vid="PSA 142:6">እሳን አከ መሌ ነት ጭመኒሩቲ።<verse eid="PSA 142:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 142:7"/>አከ አን መቃኬ ገለቴፈዹፍ፣</para>
  <para style="q2" vid="PSA 142:7">ሉቡኮ መነ ህዻቲ ና ባስ።</para>
  <para style="b" vid="PSA 142:7"/>
  <para style="q1" vid="PSA 142:7">ሰበቢ አት ዋን ጋሪ ና ጎቴፍ፣</para>
  <para style="q2" vid="PSA 142:7">ቀጄልቶትን ናኖኮት ወልት ቀበሙ።<verse eid="PSA 142:7"/></para>
  <chapter eid="PSA 142"/>
  <chapter number="143" style="c" sid="PSA 143"/>
  <para style="cl">ፋርፈትና 143</para>
  <para style="ms1">ገድ ኦፍ ቀበኒ ዋቀ ከዸቹ</para>
  <para style="d">ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 143:1"/>ያ <char style="nd">ዋቀዮ</char>፣ ከዸትናኮ ና ዸገእ፤</para>
  <para style="q2" vid="PSA 143:1">ጉረኬስ ገረ ዋመተኮቲት ዴብስ፤</para>
  <para style="q1" vid="PSA 143:1">አመነሙማፊ</para>
  <para style="q2" vid="PSA 143:1">ቀጄሉማኬቲን፣ ነ ገርጋር።<verse eid="PSA 143:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 143:2"/>አት ገርብቸኬ ሙርቲት ህንዽኤስን፤</para>
  <para style="q2" vid="PSA 143:2">ነምን ሉቡን ጅራቱ ከምዩ ፉለኬ ዱረት ቀጄላ ምቲቲ።<verse eid="PSA 143:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 143:3"/>ዲን ሉቡኮ አርአቻ ጅራቲ፤</para>
  <para style="q2" vid="PSA 143:3">ጅሬኘኮስ ቡቱቼ ብዮት መኬ።</para>
  <para style="q1" vid="PSA 143:3">አኩመ ወረ ዱር ዱአኒትስ</para>
  <para style="q2" vid="PSA 143:3">ዱከነ ኬሰ ነ ጅራችሴረ።<verse eid="PSA 143:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 143:4"/>ከናፉ ሀፉርኮ ነ ኬሰት ገገቤረ፤</para>
  <para style="q2" vid="PSA 143:4">ኦኔንኮስ ነ ኬሰት ርፈቴርት።<verse eid="PSA 143:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 143:5"/>አን ጉዮተ ዱሪ ነንያደዸ፤</para>
  <para style="q2" vid="PSA 143:5">ዋን አት ሆጄቴ ሁንደስ እረ ዴዴብኤ ነንያደ፤</para>
  <para style="q2" vid="PSA 143:5">ዋን ሀርክኬ ሆጄቴሌ ነንሄደ።<verse eid="PSA 143:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 143:6"/>ሀርከኮ ገረኬት ነንድሪርፈዸ፤</para>
  <para style="q2" vid="PSA 143:6">ሉቡንኮስ አኩመ ለፈ ጎጋ ስ ዼቦት።<verse eid="PSA 143:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 143:7"/>ያ <char style="nd">ዋቀዮ</char>፣ ደፊ ዴቢ ና ኬን፤</para>
  <para style="q2" vid="PSA 143:7">ሀፉርኮ ደዸቤረ።</para>
  <para style="q1" vid="PSA 143:7">ፉለኬ ነ ዱራ ህንዾክስን</para>
  <para style="q2" vid="PSA 143:7">ዮካን አን አከ ወረ ቦለ ቡአኒ ነንተአ።<verse eid="PSA 143:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 143:8"/>አን ዋነን ስ አመነዼፍ፣</para>
  <para style="q2" vid="PSA 143:8">አከ አን ገነመ ገነመ ኦዱ ጃለለኬቲ ዸገኡ ጎዽ።</para>
  <para style="q1" vid="PSA 143:8">አን ሉቡኮ ገረኬት ኦል ነንካሳቲ፣</para>
  <para style="q2" vid="PSA 143:8">ከራ አንረ ዴሙ ቀቡ ነት አርግሲስ።<verse eid="PSA 143:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 143:9"/>ያ <char style="nd">ዋቀዮ</char>፣ አን አከ አት ነ ዾክስቱፍ <optbreak/> ስት ነንበቀዻቲ፣</para>
  <para style="q2" vid="PSA 143:9">ዲኖተኮ ጀላ ነ ባስ።<verse eid="PSA 143:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 143:10"/>አት ሰበቢ ዋቀኮ ታቴፍ፣</para>
  <para style="q2" vid="PSA 143:10">አከ አን ፌዺኬ ጉቱ ነ በርሲስ፤</para>
  <para style="q1" vid="PSA 143:10">ሀፉርኬ ጋሪን ሱን</para>
  <para style="q2" vid="PSA 143:10">ከራ ወል ቅጤረ ነ ሃቀጄልቹ።<verse eid="PSA 143:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 143:11"/>ያ <char style="nd">ዋቀዮ</char>፣ መቃኬቲ ጄዺቲ ሉቡኮ ጅራችስ፤</para>
  <para style="q2" vid="PSA 143:11">ቀጄሉማኬቲንስ ረክነ ኬሳ ነ ባስ።<verse eid="PSA 143:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 143:12"/>አት ሰበቢ ነ ጃለቱፍ ዲኖተኮ ፍጥ፤</para>
  <para style="q2" vid="PSA 143:12">ዋን አን ገርብቸኬ ተኤፍ፣</para>
  <para style="q2" vid="PSA 143:12">ወረ ነ ጩንቁርሰን ሁንደ በርበዴስ።<verse eid="PSA 143:12"/></para>
  <chapter eid="PSA 143"/>
  <chapter number="144" style="c" sid="PSA 144"/>
  <para style="cl">ፋርፈትና 144</para>
  <para style="ms1">ሞአትና አርገቹፍ ከዸቹ</para>
  <para style="d">ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 144:1"/>
    <char style="nd">ዋቀዮ</char> ከታኮ፣</para>
  <para style="q2" vid="PSA 144:1">እሰ ሀርከኮ ወራናፍ፣</para>
  <para style="q2" vid="PSA 144:1">ቁበኮስ ሎላፍ ሌንጅሱ ሰናፍ ገለን ሃገኡ።<verse eid="PSA 144:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 144:2"/>እን ዋቀ ነ ጃለቱፊ ደኦኮት፤</para>
  <para style="q2" vid="PSA 144:2">እዶ አን እት ደአዹፊ ፈይሳኮት።</para>
  <para style="q1" vid="PSA 144:2">ጋቸነኮ፣ እዶ አን እት ኮሉ ገሉ፣</para>
  <para style="q2" vid="PSA 144:2">ከን ነ ጀለት ሰበ ናፍ ቡልቹዸ።<verse eid="PSA 144:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 144:3"/>ያ <char style="nd">ዋቀዮ</char>፣ አከ አት ዋኤሳ ያዱፍ፣ ነምን ማል?</para>
  <para style="q2" vid="PSA 144:3">አከ አት እሳፍ ያዱፍ እልም ነማ ማል?<verse eid="PSA 144:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 144:4"/>ነምን አኩመ ቅሌንሰ ሹፍ ጄዼ ደርቡት፣</para>
  <para style="q2" vid="PSA 144:4">በርሳስ አኩመ ጋድሰ ደርቡት።<verse eid="PSA 144:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 144:5"/>ያ <char style="nd">ዋቀዮ</char>፣ ሰሚወንኬ ተርሳሲ ገድ ቡእ፤</para>
  <para style="q2" vid="PSA 144:5">አከ ኣር እሳን ኬሳ ያኡፍስ ቱሉወን ቱቅ።<verse eid="PSA 144:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 144:6"/>በከካ ኤርጊቲ ዲነ ብትኔስ፤</para>
  <para style="q2" vid="PSA 144:6">ጥየኬ ደርበዹቲ እሳን በሌስ።<verse eid="PSA 144:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 144:7"/>ኦል ጉባዻ ሀርከኬ ገድ ሂጠዹቲ</para>
  <para style="q2" vid="PSA 144:7">ብሻን ጀባ ጀላ፣</para>
  <para style="q1" vid="PSA 144:7">ሀርከ አለጋ ዱራስ፣</para>
  <para style="q2" vid="PSA 144:7">ነ ባስ፤ ነ ኦልችስ፤<verse eid="PSA 144:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 144:8"/>ወረ አፋንሳኒ ሶባን ጉተሜ፣</para>
  <para style="q2" vid="PSA 144:8">ወረ ሀርክሳኒ ምርጋ ነመ ዶጎጎርሱ ዱራ ነ ባስ።<verse eid="PSA 144:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 144:9"/>ያ ዋቅ፣ አን ፋርፈትና ሃራ ሲፍ ነንፋርፈዸ፤</para>
  <para style="q2" vid="PSA 144:9">ክራረ ርቡ ኩዸኒቲንስ ሲፍን ዌድሰ፤<verse eid="PSA 144:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 144:10"/>እሰ ሞቶታፍ ሞአትኖ ኬኑፍ፣ እሰ ገርብቸሳ ዳዊትን</para>
  <para style="q2" vid="PSA 144:10">ጎራዴ ነመ አጄሱ ጀላ ባሱፍ ነንፋርፈዸ።<verse eid="PSA 144:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 144:11"/>ሀርከ ኦርሞታ ዱራ፣</para>
  <para style="q2" vid="PSA 144:11">ወረ አፋንሳኒ ሶባን ጉተሜ፣</para>
  <para style="q1" vid="PSA 144:11">ወረ ሀርክሳኒ ምርጋ</para>
  <para style="q2" vid="PSA 144:11">ነመ ዶጎጎርሱ ጀላ ነ ባስ፤ ነ ኦልችስ።<verse eid="PSA 144:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 144:12"/>እልማንኬኘ ደርገጉማሳኒ ኬሰት፣</para>
  <para style="q2" vid="PSA 144:12">አከ ብቅልቱ ቶሌ ጉደቴ ሃተአን፤</para>
  <para style="q1" vid="PSA 144:12">እንተለንኬኘስ አከ ኡቱባ ጎሌ፣</para>
  <para style="q2" vid="PSA 144:12">ከን መሰራ ሞቱማ ሚዸግሱፍ <optbreak/> ሶፈሜ ሃተአን።<verse eid="PSA 144:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 144:13"/>ጎምብሳወንኬኘ፣</para>
  <para style="q2" vid="PSA 144:13">ምዻን ጎሰ ገራ ገራቲን ሃጉተመን።</para>
  <para style="q1" vid="PSA 144:13">ሆሎትንኬኘ ኩማተመ ሃዸለን፤</para>
  <para style="q2" vid="PSA 144:13">ድሬኬኘረትስ ኩማተመ ኩዸኒን <optbreak/> ሃባይአተን፤<verse eid="PSA 144:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="PSA 144:14"/>ሎንኬኘ ሃዶሮበን ህንገተትን</para>
  <para style="q1" vid="PSA 144:14">ዮካን ዬሮ መሌ ህንዸልን፤</para>
  <para style="q2" vid="PSA 144:14">ቦጅአሙንስ ህንጅራትን፤</para>
  <para style="q2" vid="PSA 144:14">ወዋቹንስ ከራኬኘረት ህንዸገአምን።<verse eid="PSA 144:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 144:15"/>ወር ኤብ ኩን ተኤፍ ሃገመደን፤</para>
  <para style="q2" vid="PSA 144:15">ወር <char style="nd">ዋቀዮ</char> ዋቀሳኒ ተኤፍ ኤብፈሞዸ።<verse eid="PSA 144:15"/></para>
  <chapter eid="PSA 144"/>
  <chapter number="145" style="c" sid="PSA 145"/>
  <para style="cl">ፋርፈትና 145</para>
  <para style="ms1">ዋቀዮ ሞትቻፍ ገለተ ገልቹ</para>
  <para style="d">ፋርፈትና ዳዊት።</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 145:1"/>ያ ዋቀኮ ሞትቸ፣ አን ስን ሌልሰ፤</para>
  <para style="q2" vid="PSA 145:1">በረ በራ ሀመ በረ በራትስ መቃኬ ነንገለቴፈዸ።<verse eid="PSA 145:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 145:2"/>አን ጉዩመ ጉያን ስን ገለቴፈዸ፤</para>
  <para style="q2" vid="PSA 145:2">በረ በራ ሀመ በረ በራትስ መቃኬ ነንሌልሰ።<verse eid="PSA 145:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 145:3"/>
    <char style="nd">ዋቀዮ</char> ጉዳዸ፤ ገለቴፈሙንስ ባይኤ መላፍ፤</para>
  <para style="q2" vid="PSA 145:3">ጉድነሳ ቆረተኒ እት በኡን ህንደንደአሙ።<verse eid="PSA 145:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 145:4"/>ዸሎትን ቶኮ ዸሎተ ብራት ሆጂኬ ንህመ፤</para>
  <para style="q2" vid="PSA 145:4">ሆጂወንኬ ጀጀቦስ ንለብሰ።<verse eid="PSA 145:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 145:5"/>እሳንስ ዋኤ ሚዸግነ ኡልፍነ ቀቤሰ <optbreak/> ሱራኬ ሰና ንዱበቱ፤</para>
  <para style="q2" vid="PSA 145:5">አንስ ዋኤ ሆጂኬ ድንቅሲሳ ሰናረ ዴዴብኤ <optbreak/> እት ነንያደ።<verse eid="PSA 145:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 145:6"/>እሳን ዋኤ ሆጂኬ ሶዳችሳ ሰና ንኦዴሱ፤</para>
  <para style="q2" vid="PSA 145:6">አንስ ጉድነኬ ነንለብሰ።<verse eid="PSA 145:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 145:7"/>እሳን ያደኖ ጋሩማኬቲ ባይእሰኒ ኦዴሱ፤</para>
  <para style="q2" vid="PSA 145:7">ዋኤ ቀጄሉማኬቲስ እልልቸኒ ፋርፈቱ።<verse eid="PSA 145:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 145:8"/>
    <char style="nd">ዋቀዮ</char> አርጃፊ ገረ ላፌሰ፤</para>
  <para style="q2" vid="PSA 145:8">እን ኣሩፍ ህንአሪፈቱ፤ ጃለልሳስ ባይኤዸ።<verse eid="PSA 145:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 145:9"/>
    <char style="nd">ዋቀዮ</char>፣ ነመ ሁንዳፍ ጋሪዸ፤</para>
  <para style="q2" vid="PSA 145:9">እን ዋን ኡሜ ሁንዳፍ ገራ ንላፈ።<verse eid="PSA 145:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 145:10"/>ያ <char style="nd">ዋቀዮ</char>፣ ሆጂንኬ ሁንድኑ ስ ገለቴፈተ፤</para>
  <para style="q2" vid="PSA 145:10">ቁልቁሎትንኬስ ስ ሌልሱ።<verse eid="PSA 145:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 145:11"/>እሳን ዋኤ ኡልፍነ ሞቱማኬቲ ንኦዴሱ፤</para>
  <para style="q2" vid="PSA 145:11">ዋኤ ሁምነኬቲስ ንዱበቱ፤<verse eid="PSA 145:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 145:12"/>ኩንስ አከ ነሞትን ሁንድ ሆጂኬ ሁምነ ቀቤሰ፣</para>
  <para style="q2" vid="PSA 145:12">ሱራ ኡልፍነ ቀቤሰ ሞቱማኬ ሰናስ ቤከኒፍ።<verse eid="PSA 145:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 145:13"/>ሞቱማንኬ ሞቱማ በረ በራት፤</para>
  <para style="q2" vid="PSA 145:13">ቡልቺንስኬስ ዸሎታ ገረ ዸሎታት ደርበ።</para>
  <para style="b" vid="PSA 145:13"/>
  <para style="q1" vid="PSA 145:13">
    <char style="nd">ዋቀዮ</char> ዱቢሳ ሁንዳን አመነማዸ፤</para>
  <para style="q2" vid="PSA 145:13">ሆጂሳ ሁንዳንስ አርጃዸ።<verse eid="PSA 145:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 145:14"/>
    <char style="nd">ዋቀዮ</char> ወረ ኩፈን ሁንደ ኦል ቀበ፤</para>
  <para style="q2" vid="PSA 145:14">ወረ ገድ ቀበመን ሁንደስ ንካሰ።<verse eid="PSA 145:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 145:15"/>እጅ ነመ ሁንዳ ስ ኤገተ፤</para>
  <para style="q2" vid="PSA 145:15">አትስ ዬሮ በርባችሱት ኛተ እሳኒፍ ንኬንተ።<verse eid="PSA 145:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 145:16"/>አት ሀርከኬ በልእፍቴ</para>
  <para style="q2" vid="PSA 145:16">ፌዺ ወረ ሉቡ ቀበን ሁንዳ ንጉተ።<verse eid="PSA 145:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 145:17"/>
    <char style="nd">ዋቀዮ</char> ከራሳ ሁንዳን ቀጄላዸ፤</para>
  <para style="q2" vid="PSA 145:17">ሆጂሳ ሁንዳንስ አርጃዸ።<verse eid="PSA 145:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 145:18"/>
    <char style="nd">ዋቀዮ</char> ወረ እሰ ዋመተን ሁንደት፣</para>
  <para style="q2" vid="PSA 145:18">ወረ ዹጋዻን እሰ ዋመተን ሁንደት ዽኦዸ።<verse eid="PSA 145:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 145:19"/>እን ፌዺ ወረ እሰ ሶዳተኒ ንጉተ፤</para>
  <para style="q2" vid="PSA 145:19">ከዸትና እሳንስ ዸገኤ እሳን ኦልቸ።<verse eid="PSA 145:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 145:20"/>
    <char style="nd">ዋቀዮ</char> ወረ እሰ ጃለተን ሁንደ ንኤገ፤</para>
  <para style="q2" vid="PSA 145:20">ጀልኦተ ሁንደ ገሩ ንበሌሰ።<verse eid="PSA 145:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 145:21"/>አፋንኮ <char style="nd">ዋቀዮን</char> ገለቴፈቹዻን ንዱበተ።</para>
  <para style="q2" vid="PSA 145:21">ኡመምን ሁንድኑ መቃሳ ቁልቁሉ ሰነ</para>
  <para style="q2" vid="PSA 145:21">በረ በራ ሀመ በረ በራት ሃኤብሱ።<verse eid="PSA 145:21"/></para>
  <chapter eid="PSA 145"/>
  <chapter number="146" style="c" sid="PSA 146"/>
  <para style="cl">ፋርፈትና 146</para>
  <para style="ms1">ዋቀ ነመ ገርጋሩ ፋርፈቹ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 146:1"/>ሃሌሉያ።</para>
  <para style="b" vid="PSA 146:1"/>
  <para style="q1" vid="PSA 146:1">ያ ሉቡኮ፣ <char style="nd">ዋቀዮን</char> ገለቴፈዹ።<verse eid="PSA 146:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 146:2"/>አን በረ ጅሬኘኮ ጉቱ <char style="nd">ዋቀዮን</char> ነንገለቴፈዸ፤</para>
  <para style="q2" vid="PSA 146:2">አን ሀመን ጅሩት ዋቃፍ ነንፋርፈዸ።<verse eid="PSA 146:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 146:3"/>አብዲኬሰን ቡልችቶተረ፣</para>
  <para style="q2" vid="PSA 146:3">ነሞተ ዱአ ህንኦሌ <optbreak/> ወረ እስን ገርጋሩ ህንደንዴኜረ ህንካአትና።<verse eid="PSA 146:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 146:4"/>እሳን ዬሩመ ሉቡን እሳን ኬሳ ባቱ ገረ ለፋት ዴብኡ፤</para>
  <para style="q2" vid="PSA 146:4">ጉዩመ ሰነስ ከሮርሳኒ በደ።<verse eid="PSA 146:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 146:5"/>ነምን ገርጋርስሳ ዋቀ ያቆብ ተኤ፣ ከን አብዲንሳስ</para>
  <para style="q2" vid="PSA 146:5">
    <char style="nd">ዋቀዮ</char> ዋቀሳ ተኤ ኤብፈማዸ።<verse eid="PSA 146:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 146:6"/>
    <char style="nd">ዋቀዮ</char> ኡማ ሰሚፊ ለፋ፣</para>
  <para style="q2" vid="PSA 146:6">ገላናፊ ዋን እሳን ኬሰ ጅሩ ሁንዳት፤</para>
  <para style="q2" vid="PSA 146:6">እን በረ በራን አመነማ ተኤ ጅራተ።<verse eid="PSA 146:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 146:7"/>እን ወረ ጩንቁርፈመኒፍ ንሙረ፤</para>
  <para style="q2" vid="PSA 146:7">ወረ ቤለአኒፍ ኛተ ኬነ።</para>
  <para style="q1" vid="PSA 146:7">
    <char style="nd">ዋቀዮ</char> ወረ ህዸመንሌ ንሂከ፤<verse eid="PSA 146:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="PSA 146:8"/>
    <char style="nd">ዋቀዮ</char> ጃሞታፍ አገርቱ ንኬነ፤</para>
  <para style="q1" vid="PSA 146:8">
    <char style="nd">ዋቀዮ</char> ወረ ገድ ዴብአን ኦል ቀበ፤</para>
  <para style="q2" vid="PSA 146:8">
    <char style="nd">ዋቀዮ</char> ቀጄልቶተ ንጃለተ።<verse eid="PSA 146:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 146:9"/>
    <char style="nd">ዋቀዮ</char> አለጋዻፍ ኤጉምሰ ንጎዸ፤</para>
  <para style="q2" vid="PSA 146:9">እጆሌ ሃዻፊ አባ ህንቀብኔፊ</para>
  <para style="q1" vid="PSA 146:9">ዱበርቶተ ዽርሶትንራ ዱአን ንጅራችሰ፤</para>
  <para style="q2" vid="PSA 146:9">ከራ ጀልኦታ ገሩ ንበሌሰ።<verse eid="PSA 146:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 146:10"/>
    <char style="nd">ዋቀዮ</char> በረ በራን ንሞአ፤</para>
  <para style="q2" vid="PSA 146:10">ያ ጥዮን፣ ዋቅንኬ ዸሎተ ሁንዳፍ ሞቲ ተአ።</para>
  <para style="b" vid="PSA 146:10"/>
  <para style="q1" vid="PSA 146:10">ሃሌሉያ።<verse eid="PSA 146:10"/></para>
  <chapter eid="PSA 146"/>
  <chapter number="147" style="c" sid="PSA 147"/>
  <para style="cl">ፋርፈትና 147</para>
  <para style="ms1">ፋርፈትና ዋቀ ዋን ሁንደ ደንደኡፍ ፋርፈተሜ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 147:1"/>ሃሌሉያ።</para>
  <para style="b" vid="PSA 147:1"/>
  <para style="q1" vid="PSA 147:1">ፋርፈናዻን ዋቀ ገለቴፈቹን አከም ጋሪዸ፤</para>
  <para style="q2" vid="PSA 147:1">እሰ ገለቴፈቹን አከም ገመቺሳፊ ከን መሉዸ!<verse eid="PSA 147:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 147:2"/>
    <char style="nd">ዋቀዮ</char> ዬሩሳሌምን ንእጃረ፤</para>
  <para style="q2" vid="PSA 147:2">እስራኤሎተ ቦጅአመንስ ወልት ቀበ።<verse eid="PSA 147:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 147:3"/>ወረ ገራን ጨቤ ንፈይሰ፤</para>
  <para style="q2" vid="PSA 147:3">መዳሳኒስ ወልት ሆዸ።<verse eid="PSA 147:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 147:4"/>እን ባይእነ ኡርጂወኒ ንቤከ፤</para>
  <para style="q2" vid="PSA 147:4">ቶኮ ቶኮሳኒስ መቃ መቃዻን ዋመ።<verse eid="PSA 147:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 147:5"/>ጎፍታንኬኘ ጉዳዸ፤ ሁምንሳስ ጀባዸ፤</para>
  <para style="q2" vid="PSA 147:5">ሁበትናንሳስ ዹመ ህንቀቡ።<verse eid="PSA 147:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 147:6"/>
    <char style="nd">ዋቀዮ</char> ወረ ገድ ቀበመን ንጅራችሰ፤</para>
  <para style="q2" vid="PSA 147:6">ሀሞተ ገሩ ለፈት ደርበተ።<verse eid="PSA 147:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 147:7"/>ገለተ ገልቻ <char style="nd">ዋቀዮን</char> ፋርፈዻ፤</para>
  <para style="q2" vid="PSA 147:7">በገናዻንስ ዋቀኬኛፍ ዌድሳ።<verse eid="PSA 147:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 147:8"/>እን ሰሚወን ዱሜሳን ሀጉገ፤</para>
  <para style="q2" vid="PSA 147:8">ለፋፍስ ቦካ ኬነ፤</para>
  <para style="q2" vid="PSA 147:8">ቱሉወንረትስ መርገ ብቅልቸ።<verse eid="PSA 147:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 147:9"/>ሆሪዻፍ ዋን እሳን ዼደን፣</para>
  <para style="q2" vid="PSA 147:9">ዮሙ እልማን አራጌሳ እየንት <optbreak/> ኛተ እሳኒፍ ንኬነ።<verse eid="PSA 147:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 147:10"/>እን ጀብነ ፈርዳት ህንገመዱ፤</para>
  <para style="q2" vid="PSA 147:10">ዮካን ሚል ነማ እሰ ህንገመቺሱ፤<verse eid="PSA 147:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 147:11"/>
    <char style="nd">ዋቀዮ</char> ወረ እሰ ሶዳተንት፣</para>
  <para style="q2" vid="PSA 147:11">ወረ አራረሳ አብደተንት ንገመደ።<verse eid="PSA 147:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 147:12"/>ያ ዬሩሳሌም፣ <char style="nd">ዋቀዮን</char> ገለቴፈዹ፤</para>
  <para style="q2" vid="PSA 147:12">ያ ጥዮን ዋቀኬ ገለቴፈዹ።<verse eid="PSA 147:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 147:13"/>እን ደንቀራ ከረኬቲ ንጀቤሳቲ፤</para>
  <para style="q2" vid="PSA 147:13">እጆሌኬስ ስ ኬሰት ኤብሰ።<verse eid="PSA 147:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 147:14"/>ዳሪኬቲፍ ነጋ ኬነ፤</para>
  <para style="q2" vid="PSA 147:14">ቀመዲ ቁልቁሉዻንስ ስ ቁብሰ።<verse eid="PSA 147:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 147:15"/>እን አጀጀሳ ገረ ለፋት ንኤርገ፤</para>
  <para style="q2" vid="PSA 147:15">ዱቢንሳስ ንአሪፈተ።<verse eid="PSA 147:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 147:16"/>እን ጨቢ አኩመ ሱፊት ድሪርሰ፤</para>
  <para style="q2" vid="PSA 147:16">ቆረስ አኩመ ዳራት ብትኔሰ።<verse eid="PSA 147:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 147:17"/>ዸጋ ጨቢ አኩመ ጭረቻ ገድ ደርበተ።</para>
  <para style="q2" vid="PSA 147:17">ዻሞቸሳ ዱረ ኤኙቱ ዻበቹ ደንደአ?<verse eid="PSA 147:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 147:18"/>እን ዱቢሳ ኤርጌ እሳን በቅሰ፤</para>
  <para style="q2" vid="PSA 147:18">ቡቤሳ ንካሰ፤ ብሻኖትንስ ንያኡ።<verse eid="PSA 147:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 147:19"/>እን ዱቢሳ ያቆብት፣</para>
  <para style="q2" vid="PSA 147:19">ሴራፊ ስርነሳሞ እስራኤልት ሙልእሴረ።<verse eid="PSA 147:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 147:20"/>ዋን ከነ ሰበ ብራ ቶኮፍዩ ህንጎኔ፤</para>
  <para style="q2" vid="PSA 147:20">እሳን ሴረሳ ህንቤከን።</para>
  <para style="b" vid="PSA 147:20"/>
  <para style="q1" vid="PSA 147:20">ሃሌሉያ።<verse eid="PSA 147:20"/></para>
  <chapter eid="PSA 147"/>
  <chapter number="148" style="c" sid="PSA 148"/>
  <para style="cl">ፋርፈትና 148</para>
  <para style="ms1">ኡመምን ሁንድ ዋቀ ሃገለቴፈቱ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 148:1"/>ሃሌሉያ።</para>
  <para style="b" vid="PSA 148:1"/>
  <para style="q1" vid="PSA 148:1">ሰሚወንራ <char style="nd">ዋቀዮን</char> ገለቴፈዻ፤</para>
  <para style="q2" vid="PSA 148:1">ኦል ጉባት እሰ ገለቴፈዻ።<verse eid="PSA 148:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 148:2"/>ኤርገሞትንሳ ሁንድኑ እሰ ገለቴፈዻ፤</para>
  <para style="q2" vid="PSA 148:2">ራያንሳ ሁንድኑስ እሰ ገለቴፈዻ።<verse eid="PSA 148:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 148:3"/>አዱፊ ጅእ እሰ ገለቴፈዻ፤</para>
  <para style="q2" vid="PSA 148:3">ኡርጂወን እብስተን ሁንድኑስ እሰ ገለቴፈዻ።<verse eid="PSA 148:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 148:4"/>ሰሚወን ሰሚ እሰ ገለቴፈዻ፤</para>
  <para style="q2" vid="PSA 148:4">ብሻኖትን ሰሚን ኦል ጅርተንስ እሰ ገለቴፈዻ።<verse eid="PSA 148:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 148:5"/>እሳን መቃ <char style="nd">ዋቀዮ</char> ሃገለቴፈተን፤</para>
  <para style="q2" vid="PSA 148:5">እን አጀጅናን፣ እሳን ኡመመኒቲ።<verse eid="PSA 148:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 148:6"/>እን በረ በራ ሀመ በረ በራት እሳን ዻቤረ፤</para>
  <para style="q2" vid="PSA 148:6">ሴረ ህንጌደረምኔስ እሳኒፍ ኬኔረ።<verse eid="PSA 148:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 148:7"/>ኡመመወን ገላናቲፊ ቱጁበወን ሁንድ፣</para>
  <para style="q2" vid="PSA 148:7">ለፈራ <char style="nd">ዋቀዮን</char> ገለቴፈዻ፤<verse eid="PSA 148:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 148:8"/>በከካፊ ዸጋን ጨቢ፣ ጨቢፊ ዱሜስ፣</para>
  <para style="q2" vid="PSA 148:8">ቡቤን ጀባን አጀጀሳ ራወተን፣<verse eid="PSA 148:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 148:9"/>ቱሉወኒፊ ጋረን ሁንድኑ፣</para>
  <para style="q2" vid="PSA 148:9">ሙኬን እጀ ነቀተኒፊ ብርብርስ ሁንድኑ፣<verse eid="PSA 148:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 148:10"/>ብኔንሶትኒፊ ሎን ሁንድኑ፣</para>
  <para style="q2" vid="PSA 148:10">ኡመመወን ጥጥኖፊ ስምብሮትን በርሰን፣<verse eid="PSA 148:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 148:11"/>ሞቶትን ለፋቲፊ ሰቦትን ሁንድኑ፣</para>
  <para style="q2" vid="PSA 148:11">እልማን ሞቶታቲፊ ቡልችቶትን ለፋ ሁንድኑ፣<verse eid="PSA 148:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 148:12"/>ደርገጎትኒፊ ሸመረን፣</para>
  <para style="q2" vid="PSA 148:12">ጃርሶሊፊ ዳእመን እሰ ገለቴፈዻ።<verse eid="PSA 148:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 148:13"/>መቃንሳ ቆፍት ኦል ኦል ጄዼራቲ፣</para>
  <para style="q2" vid="PSA 148:13">እሳን መቃ <char style="nd">ዋቀዮ</char> ሃገለቴፈተን፤</para>
  <para style="q2" vid="PSA 148:13">ኡልፍንሳስ ለፋፊ ሰሚወኒ ኦል ጅረ።<verse eid="PSA 148:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 148:14"/>እን ሰበሳቲፍ ጋንፈ ኦል ካሴረ፤</para>
  <para style="q2" vid="PSA 148:14">ኩንስ ቁልቁሎተሳ ሁንዳፍ፣</para>
  <para style="q2" vid="PSA 148:14">ሰበ እስራኤል ወረ እሰት ዽኦ ጅረን ሁንዳፍ ኡልፍነ።</para>
  <para style="b" vid="PSA 148:14"/>
  <para style="q1" vid="PSA 148:14">ሃሌሉያ።<verse eid="PSA 148:14"/></para>
  <chapter eid="PSA 148"/>
  <chapter number="149" style="c" sid="PSA 149"/>
  <para style="cl">ፋርፈትና 149</para>
  <para style="ms1">ፋርፈትና ሞአትኖ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 149:1"/>ሃሌሉያ።</para>
  <para style="b" vid="PSA 149:1"/>
  <para style="q1" vid="PSA 149:1">ፋርፈትና ሃራ <char style="nd">ዋቀዮፍ</char> ፋርፈዻ፤</para>
  <para style="q2" vid="PSA 149:1">ወልዳ ቁልቁሎታ ኬሰትሌ እሰ ጀጀዻ።<verse eid="PSA 149:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 149:2"/>እስራኤል ኡማሳት ሃገመዱ፤</para>
  <para style="q2" vid="PSA 149:2">ሰብን ጥዮን ሞቲሳት ሃገመዱ።<verse eid="PSA 149:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 149:3"/>መቃሳስ ሹብሱዻን ሃጀጀቱ፤</para>
  <para style="q2" vid="PSA 149:3">ድቤፊ በገናዻን እሳፍ ሃፋርፈቱ።<verse eid="PSA 149:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 149:4"/>
    <char style="nd">ዋቀዮ</char> ሰበሳት ንገመዳቲ፤</para>
  <para style="q2" vid="PSA 149:4">ወረ ገድ ኦፍ ቀበንስ ፈይነ ጎንፈቺሰ።<verse eid="PSA 149:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 149:5"/>ቁልቁሎትን ኡልፍነ ከነት ሃገመደን፤</para>
  <para style="q2" vid="PSA 149:5">ስሬሳኒረትስ ገመቹዻን ሃፋርፈተን።<verse eid="PSA 149:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 149:6"/>ገለን ዋቃ አፋንሳኒ ኬሰ ሃጅራቱ፤</para>
  <para style="q2" vid="PSA 149:6">ጎራዴን አፋን ለማስ ሀርከሳኒ ኬሰ ሃጅራቱ፤<verse eid="PSA 149:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 149:7"/>ኩንስ ሰቦተት ሃሎ በኡፊ</para>
  <para style="q2" vid="PSA 149:7">ነሞተ አደቡዻፍ፤<verse eid="PSA 149:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 149:8"/>ሞቶተሳኒ ፎንጫን፣</para>
  <para style="q2" vid="PSA 149:8">ሀንገፎተሳኒስ ፉኞ ስቢላቲን ህዹዻፍ፣<verse eid="PSA 149:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 149:9"/>ሙርቲ በሬፈሜ ሰነ እሳንረት ዹጋ በኡዻፍ።</para>
  <para style="q2" vid="PSA 149:9">ኩንስ አመነምቶተሳ ሁንዳፍ ኡልፍነ።</para>
  <para style="b" vid="PSA 149:9"/>
  <para style="q1" vid="PSA 149:9">ሃሌሉያ።<verse eid="PSA 149:9"/></para>
  <chapter eid="PSA 149"/>
  <chapter number="150" style="c" sid="PSA 150"/>
  <para style="cl">ፋርፈትና 150</para>
  <para style="ms1">ፋርፈትና ገለታ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 150:1"/>ሃሌሉያ።</para>
  <para style="b" vid="PSA 150:1"/>
  <para style="q1" vid="PSA 150:1">መነ ቁልቁሉማሳ ኬሰት ዋቀ ገለቴፈዻ፤</para>
  <para style="q2" vid="PSA 150:1">ሰሚወንሳ ሁምነ ቀቤዪ ኬሰትስ እሰ ገለቴፈዻ።<verse eid="PSA 150:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 150:2"/>ሆጂወንሳ ጀጀቦ ሰናፍ እሰ ሌልሳ፤</para>
  <para style="q2" vid="PSA 150:2">ጉድነሳ ሀመ ህንቀብኔ ሰናፍ እሰ ሌልሳ።<verse eid="PSA 150:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 150:3"/>መለከተ አፉፉዻን እሰ ገለቴፈዻ፤</para>
  <para style="q2" vid="PSA 150:3">በገናፊ ክራራን እሰ ገለቴፈዻ፤<verse eid="PSA 150:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 150:4"/>ድቤዻን ሹብሳቲ እሰ ጀጀዻ፤</para>
  <para style="q2" vid="PSA 150:4">ምአ ርቡቲፊ ኡሉሌዻን እሰ ጀጀዻ።<verse eid="PSA 150:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 150:5"/>ክልሌ ሰገሌ ቀቡን እሰ ጀጀዻ፤</para>
  <para style="q2" vid="PSA 150:5">ክልሌ ሰገሌ ጉዳቲን እሰ ጀጀዻ።<verse eid="PSA 150:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 150:6"/>ወን ሀፉረ ባፈቱ ሁንድኑ <char style="nd">ዋቀዮን</char> ሃጀጀቱ።</para>
  <para style="b" vid="PSA 150:6"/>
  <para style="q1" vid="PSA 150:6">ሃሌሉያ።<verse eid="PSA 150:6"/></para>
  <chapter eid="PSA 150"/>
</usx>
