<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JAS" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">ያቆብ</para>
  <para style="toc1">ያቆብ</para>
  <para style="toc2">ያቆብ</para>
  <para style="toc3">ያቆ</para>
  <para style="mt1">ያቆብ</para>
  <chapter number="1" style="c" sid="JAS 1"/>
  <para style="s1">ነጋ ጋፈቹ</para>
  <para style="po">
    <verse number="1" style="v" sid="JAS 1:1"/>ያቆብ ገርብቸ ዋቃቲፊ ከን ዬሱስ ክርስቶስ ጎፍትቻራ።</para>
  <para style="po" vid="JAS 1:1">ገረ ጎሶተ ኩዸ ለማን ብብትናአኒት።</para>
  <para style="po" vid="JAS 1:1">ነጋን እስኒፍ ሃተኡ።<verse eid="JAS 1:1"/></para>
  <para style="s1">ቆሩምሳፊ ዺባ</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2"/>ያ ኦቦሎተኮ፣ ዮሙ ቆሩምስ አደ አዳ እስንረ ገኡት አከ ገመቹ ጉቱት ፉዸዻ፤ <verse eid="JAS 1:2"/><verse number="3" style="v" sid="JAS 1:3"/>አመንቲንኬሰን ቆረሙንሳ አከ ኦብሰ እስኒፍ አርገምሲሱ ቤክቱቲ። <verse eid="JAS 1:3"/><verse number="4" style="v" sid="JAS 1:4"/>አከ እስን ብልቻቶፊ ጉቱ፣ ወረ ህርእነ ቶኮዩ ህንቀብኔ ታተኒፍ ኦብስ ሆጂሳ ሃራወቱ። <verse eid="JAS 1:4"/><verse number="5" style="v" sid="JAS 1:5"/>እስን ኬሳ ነምን ቶኮዩ ሀንቅነ ኦጉማ ዮ ቀባቴ፣ ዋቀ ኡቱ ህንቱፈትን ነመ ሁንዱማፍ አርጁማን ኬኑ ሃከዸቱ፤ እሳፍስ ንኬነመ። <verse eid="JAS 1:5"/><verse number="6" style="v" sid="JAS 1:6"/>እን ገሩ ዮሙ ከዸቱ አመንቲን ሃከዸቱ፤ ህንሸክንስ፤ ነምን ሸኩ አከ ደምበሊ ገላና ከን ቡቤን ዸአሜ ኦፈሙት። <verse eid="JAS 1:6"/><verse number="7" style="v" sid="JAS 1:7"/>ነምን ሱን ዋን ቶኮሌ ጎፍታ ብራ ነንአርገዸ ጄዼ ህንኤገን፤ <verse eid="JAS 1:7"/><verse number="8" style="v" sid="JAS 1:8"/>እን ነመ ያደ ለማት፤ እዶ ቶኮስ ህንዻበቱ።<verse eid="JAS 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9"/>ኦቦሌስ ገድ ቀበሜ ኦል ቀበሙሳቲን ኦፍ ሃጀጁ። <verse eid="JAS 1:9"/><verse number="10" style="v" sid="JAS 1:10"/>ሶሬስ ገሩ ገድ ቀበሙሳት ኦፍ ሃጀጁ፤ እን አኩመ ደራራ መርጋ ንሀርጨኣቲ። <verse eid="JAS 1:10"/><verse number="11" style="v" sid="JAS 1:11"/>አዱን ሆአ ጉቡን ባቴ መርገ ጎግስቲቲ፤ ደራራን ብቅልቱ ሰናስ ንሀርጨአ፤ ሚዸግንሳስ ንበደ። ሶሬስስ ኡቱመ ሆጂሳቲፍ ኦሊ ገድ ፊጉ በደ።<verse eid="JAS 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12"/>ነምን ቆሩምሰ ኦብሱ ኤብፈማዸ፤ እን ዮሙ ቆረሜት ጀባቴ ዋን ዻበቴፍ ጎንፎ ጅሬኛ ከን ዋቅን ወረ እሰ ጃለተኒፍ ዋዳ ገሌ ሰነ ንአርገታቲ።<verse eid="JAS 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 1:13"/>ነምን ከምዩ ዮሙ ቆረሙት፣ “ዋቀቱ ነ ቆራ ጅረ” ህንጄዽን። ዋቅን ሀማዻን ህንቆረሙቲ፤ እንስ ነመ ቶኮሌ ህንቆሩ፤ <verse eid="JAS 1:13"/><verse number="14" style="v" sid="JAS 1:14"/>ቶኮን ቶኮን ነማ ገሩ ዮሙ ሀዊ ኦፊሳ ሀማ ሰናን ሀርክፈሜ ጎዎምፈሙት ቆረመ። <verse eid="JAS 1:14"/><verse number="15" style="v" sid="JAS 1:15"/>ሀዊንስ ዮሙ ኡልፎፍቴት ጩቡ ዸልት፤ ጩቡንሞ ዮሙ ጉቱማን ጉቱት ጉደቴት ዱአ ዸልት።<verse eid="JAS 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16"/>ያ ኦቦሎተኮ ጃለተሞ፣ ህንዶጎጎርና። <verse eid="JAS 1:16"/><verse number="17" style="v" sid="JAS 1:17"/>ኬናን ጋሪን ሁንድኑ፣ ኬናን ሙዳ ህንቀብኔ ሁንድኑስ አባ እፋ እሰ አከ ጋድዱ ህንጌደረምኔ ሰነ ብራ ጉባዻ ገድ ቡአ። <verse eid="JAS 1:17"/><verse number="18" style="v" sid="JAS 1:18"/>እንስ አከ ኑ ኡመመሳ ሁንዱማፍ ጎሰ ሀንገፈ ታኑፍ አኩመ ፌዺሳት ዱቢ ዹጋቲን ኑ ዸልቼ።<verse eid="JAS 1:18"/></para>
  <para style="s1">ዸገኡፊ ሆጂረ ኦልቹ</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19"/>ያ ኦቦሎተኮ ጃለተሞ፣ ዋን ከነ ሁበዻ፦ ነምን ሁንድኑ ዸገኡት ሃአሪፈቱ፤ ዱበቹፍ ሱተ ሃጄዹ፤ ኣሩትስ ሱተ ሃጄዹ፤ <verse eid="JAS 1:19"/><verse number="20" style="v" sid="JAS 1:20"/>ኣሪን ነማ ቀጄሉማ ዋቃ ህንሆጄቱቲ። <verse eid="JAS 1:20"/><verse number="21" style="v" sid="JAS 1:21"/>ከናፍ ጡራኡማ ሁንዳፊ ሀምነ እስን ኬሰ ጅራቱ ሁንደ ኦፍራ ፈጌሳ፤ ዱቢ ሉቡኬሰን ፈይሱ ደንደኡ ከን እስን ኬሰት ፈጫፈሜ ሰነ ገራሙማን ፉዸዻ።<verse eid="JAS 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22"/>እስን ገሩ ወረ ዱብቸ ሆጂረ ኦልችተን ተኣ መሌ ወረ ዸገኡ ቆፋን ኦፍ ጎዎምስተን ህንተእና። <verse eid="JAS 1:22"/><verse number="23" style="v" sid="JAS 1:23"/>ነምን ዱብቸ ዸገኤ ሆጂረ ህንኦልችኔ ከምዩ ነመ ኦፍ እላሌ ኬሰት ፉለሳ እላለቱ ፈካተ፤ <verse eid="JAS 1:23"/><verse number="24" style="v" sid="JAS 1:24"/>እንስ ኤርገ ኦፍ እላሌን ቦዴ ንዴመ፤ ዮሙሱመ ማል አከ ፈካቱ ንእራንፈተ። <verse eid="JAS 1:24"/><verse number="25" style="v" sid="JAS 1:25"/>ገሩ ነምን ሴረ ብልሳ ከን ህርእነ ህንቀብኔ ሰነ ሁበቴ እላሉ፣ ከን አከ ሴረ ሰናትስ ጅራቱ፣ ከን ዋን ዸገኤስ ሆጂረ ኦልቹ መሌ ህንእራንፈትኔ ሱን ዋን ሆጄቱ ኬሰት ንኤብፈመ።<verse eid="JAS 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 1:26"/>ነምን ዋን አመንታ ቀቡ ኦፍ ሴኡ፣ ከን ገሩ አረበሳ ህንሉገመትኔ ዮ ጅራቴ እን ኦፍ ጎዎምሰ፤ አመንታንሳስ ፋይዳ ህንቀቡ። <verse eid="JAS 1:26"/><verse number="27" style="v" sid="JAS 1:27"/>አመንታን ዋቀ አባኬኘ ዱረት ቁልቁሉ ተኤፊ ከን ሙዳ ህንቀብኔ እሰ ከነ፤ ኩንስ እጆሌ አባፊ ሃዸ ህንቀብኔፊ ሃዾተ ህዬሳ ረክነሳኒ ኬሰት ኩኑንሱፊ ጡራኡማ አዱኛራስ ኦፍ ኤገቹዸ።<verse eid="JAS 1:27"/></para>
  <chapter eid="JAS 1"/>
  <chapter number="2" style="c" sid="JAS 2"/>
  <para style="s1">ነመ ወል ጫልችሱን ዾዋዸ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1"/>ያ ኦቦሎተኮ፣ እስን ዋን ጎፍታኬኘ ከን ኡልፍና ዬሱስ ክርስቶስት አመንተኒፍ ነመ ወል ህንጫልችስና። <verse eid="JAS 2:1"/><verse number="2" style="v" sid="JAS 2:2"/>ነምን ቁቤላ ወርቄ ካአቴ ኡፈተ በሬዳስ ኡፈቱ ቶኮ ገረ ወል ገኢኬሰኒ ዹፈ ሃጄኑ፤ አከሱመስ ህዬስ ደርሰ ኡፈቱ ንዹፈ ሃጄኑ። <verse eid="JAS 2:2"/><verse number="3" style="v" sid="JAS 2:3"/>እስንስ ዮ ነምቸ ኡፈተ በሬዳ ኡፈቱ ሰናፍ ኡልፍነ አዳ ኬንተኒ፣ “ማሎ ኮቱ እዶ ጋሪ ታእ!” ጄተን፣ ዮ ነምቸ ህዬሰ ሰናንሞ፣ “አት አች ዻበዹ” ዮካን “ኮቱቲ ሚለኮ ብረ ታእ!” ጄተን፣ <verse eid="JAS 2:3"/><verse number="4" style="v" sid="JAS 2:4"/>እስን ግዱኬሰንት ገራ ገሩማ ኡምተኒ ወረ ያደ ሀማን ሙርቴስተን ህንታኔ?<verse eid="JAS 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5"/>ያ ኦቦሎተኮ ጃለተሞ፣ ሜ ዸገኣ! ዋቅን አከ እሳን አመንቲት ሶሬዪ ተአኒፊ አከ እሳን ሞቱማ እን ወረ እሰ ጃለተኒፍ ዋዳ ገሌ ሰነ ዻለኒፍ ህዬዪ አዱኛ ከና ፍለቴራ ምቲ? <verse eid="JAS 2:5"/><verse number="6" style="v" sid="JAS 2:6"/>እስን ገሩ ህዬዪ ሰልጵፍተኒርቱ። ወር እስን ቅሳሱት ጅረን ወሩመ ሶሬዪ ሰነ ምቲ? ከኔን ገረ መነ ሙርቲት እስን ሀርክሳ ጅረንስ እሳኑመ ምቲ? <verse eid="JAS 2:6"/><verse number="7" style="v" sid="JAS 2:7"/>መቃ ከበጀማ እስን እቲን ዋመምተን ሰነስ ከን አረብሰን እሳኑማ ምቲ?<verse eid="JAS 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8"/>ሴረ ሞቲ ከን ከተቢ ቁልቁሉ ኬሰት፣ “ኦላኬ ገሩ አከ ኦፊኬት ጃለዹ”<note caller="+" style="f"><char style="fr" closed="false">2፥8 </char><char style="ft" closed="false"><char style="xt"><ref loc="LEV 19:18">ሌዎ 19፥18</ref></char></char></note> ጄዹ ሰነ ዮ ዹጉማን ኤግደን እስን ዋን ቀጄላ ጎቻ ጅርቱ። <verse eid="JAS 2:8"/><verse number="9" style="v" sid="JAS 2:9"/>ዮ ነመ ወል ጫልችፍተን ገሩ እስን ጩቡ ሆጄተን፤ ሴረ ዱረትስ አከ ሴረ ጨብስቶታት እስንት ሙረመ። <verse eid="JAS 2:9"/><verse number="10" style="v" sid="JAS 2:10"/>ሰበቢንሳስ ነምን ሴረ ጉቱማት ኤጌ ዋን ቶኮ ቆፈ ጨብሴ ከምዩ አከ ዋን ሴረ ሁንደ ጨብሴት እላለማቲ። <verse eid="JAS 2:10"/><verse number="11" style="v" sid="JAS 2:11"/>እን፣ “ህንኤጅን”<note caller="+" style="f"><char style="fr" closed="false">2፥11 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 20:14">በኡ 20፥14</ref>፤ <ref loc="DEU 5:18">ኬዴ 5፥18</ref></char></char></note> ጄዼ ሱን አከሱመሞ፣ “ህንአጄስን”<note caller="+" style="f"><char style="fr" closed="false">2፥11 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 20:13">በኡ 20፥13</ref>፤ <ref loc="DEU 5:17">ኬዴ 5፥17</ref></char></char></note> ጄዼራቲ። አት ዮ ኤጁ ባቴሌ ነመ አጄፍናን ሴረ ጨብስቴርተ።<verse eid="JAS 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 2:12"/>እስን አከ ወረ ሴረ ነመ ብልሶምሱን እት ሙረሙት ዱበዻ፤ ሆጄዻስ፤ <verse eid="JAS 2:12"/><verse number="13" style="v" sid="JAS 2:13"/>ነመ ነማፍ ህንአራረምኔት ሙርቲ አራረ ህንቀብኔቱ ሙረመ። አራር ሙርቲ ሞአ።<verse eid="JAS 2:13"/></para>
  <para style="s1">አመንቲፊ ሆጂ</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14"/>ያ ኦቦሎተኮ፣ ነምን ቶኮ ዮ፣ “አን አመንቲ ቀበ” ጄዼ ገሩ ሆጂን አርግሲሱ ባቴ፣ ኩን ፋይዳ ማሊ ቀበ? አመንቲን አከና እሰ ፈይሱ ደንደኣሬ? <verse eid="JAS 2:14"/><verse number="15" style="v" sid="JAS 2:15"/>ፈኬኛፍ ኦቦሌስ ቶኮ ዮካን ኦቦሌቲን ቶኮ ኡፈታፊ ዋን ጉያ ጉያን ኛተን ህንቀበን ሃጄኑ። <verse eid="JAS 2:15"/><verse number="16" style="v" sid="JAS 2:16"/>እስን ኬሳ ዮ ነምን ቶኮ፣ “ነጋን ዴማ፤ እስንት ሃሆኡ፤ ቁፋስ” እሳኒን ጄዼ ገሩ ዋን ፎንሳኒቲፍ በርባችሱ ቶኮሌ ህንኬንኒፍ፣ ኩን ፋይዳ ማሊ ቀበሬ? <verse eid="JAS 2:16"/><verse number="17" style="v" sid="JAS 2:17"/>አከሱመስ አመንቲን ሆጂን ህንሙልእፈምኔ ኦፊኑ ዱኣዸ።<verse eid="JAS 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18"/>ነምን ቶኮ ገሩ፣ “አት አመንቲ ቀብደ፤ አንሞ ሆጂ ቀበ” ጄዸ።</para>
  <para style="p" vid="JAS 2:18">አት አመንቲኬ ሆጂ መሌ ነ አርግሲስ፤ አንስ ሆጂኮቲን አመንቲኮ ስን አርግሲሰ። <verse eid="JAS 2:18"/><verse number="19" style="v" sid="JAS 2:19"/>አከ ዋቅን ቶክች ጅሩ አት ንአመንተ። ኩን ጋሪዸ! ሀፉሮትን ሀሞንዩ ዋን ከነ ንአመኑ፤ ሶዳዻንስ ንሆለቱ።<verse eid="JAS 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JAS 2:20"/>ያ ነምቸ ጎዋነነ፣ አት አከ አመንቲን ሆጂ ኦፍ ኬሳ ህንቀብኔ ዱኣ ተኤ ቤኩ በርባዳ? <verse eid="JAS 2:20"/><verse number="21" style="v" sid="JAS 2:21"/>አባንኬኘ አብረሃም ዮሙ እልመሳ ይስሃቅን እዶ ኣርሳረት ዽኤሴት ዋን ሆጄቴ ሰናፍ ቀጄላ ተኤ ህንለካአምኔሬ? <verse eid="JAS 2:21"/><verse number="22" style="v" sid="JAS 2:22"/>አከ አመንቲንሳቲፊ ሆጂንሳ ቶኩማን ሆጄቻ ቱረን ንአርግተ፤ ዋን እን ሆጄቴንስ አመንቲንሳ ጉቱ ተኤ። <verse eid="JAS 2:22"/><verse number="23" style="v" sid="JAS 2:23"/>ከናንስ ወን ከተቢ ቁልቁሉ ኬሰት፣ “አብረሃም ዋቀ አመኔ፤ ኩንስ ቀጄሉማት ለካአሜፍ”<note caller="+" style="f"><char style="fr" closed="false">2፥23 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 15:6">ኡመ 15፥6</ref></char></char></note> ጄዹ ንራወተሜ፤ እንስ ምቹ ዋቃ ጄዸሜ። <verse eid="JAS 2:23"/><verse number="24" style="v" sid="JAS 2:24"/>ኤጋ አከ ነምን ሆጂዻንስ መሌ አመንቲ ቆፋን ቀጄላት ህንለካአምኔ ንአርግቱ።<verse eid="JAS 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JAS 2:25"/>አከሱመሞ ሰጋገልቱን ረሃብ ጄዸምቱ ዮሙ በሳስቶተ ስመቴ ከራ ካኒን እሳን ጌጌስቴት ዋን ሆጄቴን ቀጄልቱት ህንለካአምኔሬ? <verse eid="JAS 2:25"/><verse number="26" style="v" sid="JAS 2:26"/>አኩመ ዸግን ሀፉረ ህንቀብኔ ዱኣ ተኤ ሰነ፣ አመንቲን ሆጂ ህንቀብኔስ ዱኣዸ።<verse eid="JAS 2:26"/></para>
  <chapter eid="JAS 2"/>
  <chapter number="3" style="c" sid="JAS 3"/>
  <para style="s1">አረበ ሌንጅፈቹ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1"/>ያ ኦቦሎተኮ፣ ባይኤንኬሰን በርሲስቶተ ህንተእና፤ ኑ ወረ በርሲስኑት ሙርቲ ጭማን አከ ሙረሙ ንቤክቱቲ። <verse eid="JAS 3:1"/><verse number="2" style="v" sid="JAS 3:2"/>ኑ ሁንድኑ ከራ ባይኤዻን ጉፈትነ። ነምን ዋን ዱበቱ ኬሰት ህንጉፈትኔ ከምዩ ነመ ህርእነ ህንቀብኔዸ፤ ዸግነሳስ ጉቱማት ቶአቹ ደንደአ።<verse eid="JAS 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JAS 3:3"/>ፈርድ አከ ኑፍ አጀጀሙፍ ዮ አፋንሳ ሉገምኔ ዸግነሳ ጉቱ ገረ በርባድኔ ጌሱ ደንዴኘ። <verse eid="JAS 3:3"/><verse number="4" style="v" sid="JAS 3:4"/>ሜ ዶኒሌ እላላ! ዶኒን ዮ አከ መሌ ጉዳ ተኤ ቡቤ ጀባዻን ኦፈሜሌ ነምች እሰ ኦፉ በቶ ጥኖሼቲን ገረ በርባዴት ጌሰ። <verse eid="JAS 3:4"/><verse number="5" style="v" sid="JAS 3:5"/>አከሱመሞ አረብን ኩታ ዸግና ጥኖዸ፤ ዋን ጉርጉዳዻን ኦፍ ጀጀ። ቦሶን ሀመም ጉዳ ተኡዩ ቃንቄ እብዳ ጥናዻን አከ ጉበቱ ሁበዻ። <verse eid="JAS 3:5"/><verse number="6" style="v" sid="JAS 3:6"/>አረብን እብደ፤ ኩታወን ዸግና ኬሰትስ አዱኛ ሀምናት። እን ዸግነ ጉቱ ጡሬሰ፤ አዴምሰ ኡመማትስ እብደ ቀብሲሰ፤ ኦፊሳቲሞ እብደ ገሃነሚቲን ጉበመ።<verse eid="JAS 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 3:7"/>ብኔንሶትን ጎሰ ሁንዳ፣ ስምብሮትን፣ ኡመመወን ለፈረ ሎአኒፊ ገላነ ኬሰ ጅራተን ሁንድኑ ነማን መደቅፈሙ፤ መደቅፈመኒሩስ፤ <verse eid="JAS 3:7"/><verse number="8" style="v" sid="JAS 3:8"/>አረበ ገሩ ነምን ቶኮዩ ሌንጅሱ ህንደንደኡ። አረብን ሀማ ቦቆና ህንቀብኔዸ፤ ሱሚ ነመ አጄሱንስ ከን ጉተሜዸ።<verse eid="JAS 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 3:9"/>ኑ አረባን ጎፍታፊ አባ ኤብፍነ፤ እሱማንሞ ነመ ብፈ ዋቃቲን ኡመሜ አባረ። <verse eid="JAS 3:9"/><verse number="10" style="v" sid="JAS 3:10"/>አፋኑመ ቶኮ ኬሳ ኤቢፊ አባርስ በአ። ያ ኦቦሎተኮ፣ ወን ኩን አከስ ተኡ ህንቀቡ። <verse eid="JAS 3:10"/><verse number="11" style="v" sid="JAS 3:11"/>ብሻን ምኣኣፊ ሀዻኣን ቡርቃ ቶኮ ኬሳ ንበኣ? <verse eid="JAS 3:11"/><verse number="12" style="v" sid="JAS 3:12"/>ያ ኦቦሎተኮ፣ ሙክን ሀርቡ እጀ ኤጄርሳ ነቀቹ ዮካን ወይኒን እጀ ሀርቡ ነቀቹ ደንደኣ? አከሱመሞ ቡርቃን ብሻን ሶግዳ ብሻን ምኣኣ ኬኑ ህንደንደኡ።<verse eid="JAS 3:12"/></para>
  <para style="s1">ኦጉማ ጎሰ ለማ</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13"/>እስን ኬሳ ኦጌሲፊ ሁበታን ኤኙ? ከነስ እን ጅሬኘሳ ጋሪዻን፣ ሆጂ ኦጉማ ከን ገድ ኦፍ ቀቡዻን ሆጄተሙን ሃአርግሲሱ። <verse eid="JAS 3:13"/><verse number="14" style="v" sid="JAS 3:14"/>እስን ገሩ ዮ ህናፋ ሀዻኣፊ ሀዊ ኦፍቱማ ገራኬሰን ኬሳ ቀባተን ኦፍ ህንጀጅና፤ ዹጋረትስ ሶበ ህንዱበትና። <verse eid="JAS 3:14"/><verse number="15" style="v" sid="JAS 3:15"/>ኦጉማን ኩን ከን ለፋት፤ ከን ፎኒት፤ ከን ሀፉረ ሀማት መሌ ከን ሰሚራ ዹፉ ምት። <verse eid="JAS 3:15"/><verse number="16" style="v" sid="JAS 3:16"/>እዶ ህናፋፊ ሀዊን ኦፍቱማ ጅሩ፣ ጄቁምሳፊ ሆጂ ሀምና ሁንዱመቱ ጅረ።<verse eid="JAS 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 3:17"/>ኦጉማን ሰሚራ ዹፉ ገሩ ዱራን ዱርሴ ቁልቁሉዸ፤ አከሱመስ ነጋ ቀቤሰ፤ ገራሚዸ፤ አጀጀማዸ፤ ከን አራራፊ እጀ ጋሪን ጉተሜዸ፤ ወል ጫልችሱፊ እት ፈኬሱስ ኦፍ ኬሳ ህንቀቡ። <verse eid="JAS 3:17"/><verse number="18" style="v" sid="JAS 3:18"/>እጅ ቀጄሉማ ወረ ነጋ ቡሰኒን ነጋዻን ፈጫፈመ።<verse eid="JAS 3:18"/></para>
  <chapter eid="JAS 3"/>
  <chapter number="4" style="c" sid="JAS 4"/>
  <para style="s1">ዋቃፍ ቡላ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1"/>ወን ሎላፊ ወልት ቡኡ እስን ግዱት ካሱ ማል? እሳን ሀዊ እስን ኬሰት ወል ሎለንራ ዹፉ ምቲ? <verse eid="JAS 4:1"/><verse number="2" style="v" sid="JAS 4:2"/>እስን ንሀውቱ፤ ገሩ ህንአርገተን። ከናፍ ንአጄፍቱ፤ ንህናፍቱስ። ገሩ ዋን በርባደን ሰነ አርገቹ ህንደንዴሰን። ከናፍስ ወልት ቡቱ፤ ወል ሎልቱስ። እስን ዋን ዋቀ ህንከዸትኔፍ ህንቀባተን። <verse eid="JAS 4:2"/><verse number="3" style="v" sid="JAS 4:3"/>እስን ዸራኬሰን ሀማ ጉተቹፍ ጄተኒ ያደ ሀማን ዋን ከዸተኒፍ ዮሙ ከዸተን ህንአርገተን።<verse eid="JAS 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JAS 4:4"/>ያ ኤጅቶተ፣ አዱኛት ምቾሙን ዋቀት ዲነ ተኡ አከ ተኤ ህንቤክተኒ? ነምን ምቹ አዱኛ ተኡ ከምዩ ዲነ ዋቃ ተአ። <verse eid="JAS 4:4"/><verse number="5" style="v" sid="JAS 4:5"/>ዮካን ወን ከተቢን ቁልቁሉን፣ “ሀፉር ኑ ኬሰ ጅራቱ ሱን ህናፋዻን ሀወ” ጄዹ አከሱማን ዱበተመ ሴቱሬ? <verse eid="JAS 4:5"/><verse number="6" style="v" sid="JAS 4:6"/>እን ገሩ አያነ ጫሉ ኑፍ ኬነ። ሰበቢን ከተቢን ቁልቁሉን፣</para>
  <para style="q1" vid="JAS 4:6">“ዋቅን ኦፍ ቱልቶታን ንሞርመ፤</para>
  <para style="q2" vid="JAS 4:6">ወረ ገድ ኦፍ ቀበኒፍሞ አያነ ኬነ”<note caller="+" style="f"><char style="fr" closed="false">4፥6 </char><char style="ft" closed="false"><char style="xt"><ref loc="PRO 3:34">ፈኬ 3፥34</ref></char></char></note></para>
  <para style="m" vid="JAS 4:6">ጄዹፍስ ከኑመ።<verse eid="JAS 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 4:7"/>ከናፉ ዋቃፍ ቡላ። ዲያብሎሲንሞ ሞርማ፤ እንስ እስን በቀታ። <verse eid="JAS 4:7"/><verse number="8" style="v" sid="JAS 4:8"/>ዋቀት ዽኣዻ፤ እንስ እስንት ንዽኣታ። እስን ጩበሞትን ሀርከኬሰን ዽቀዻ፤ ወር ያደ ለመ ቀብደንስ ገራኬሰን ቁልቁሌፈዻ። <verse eid="JAS 4:8"/><verse number="9" style="v" sid="JAS 4:9"/>ዽጰዻ፤ ገዳ፤ ቦኣስ። ኮልፍኬሰን ቦእቸት፣ ገመቹንኬሰንሞ ገደት ሃጌደረሙ። <verse eid="JAS 4:9"/><verse number="10" style="v" sid="JAS 4:10"/>ፉለ ጎፍታ ዱረት ገድ ኦፍ ቀባ፤ እንሞ ኦል እስን ቀባ።<verse eid="JAS 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11"/>ያ ኦቦሎተ፣ ወል ህንሀሜስና። ነምን ኦቦሌሰሳ ሀሜሱ ዮካን ኦቦሌሰሳት ሙሩ ከምዩ ሴረ ሀሜሰ፤ ሴረትስ ንሙረ። ገሩ አት ዮ ሴረት ሙርቴ ሴረ ሰነት ሙራ ጅርተ መሌ እሳፍ አጀጀማ ህንጅርቱ። <verse eid="JAS 4:11"/><verse number="12" style="v" sid="JAS 4:12"/>እን ሴረ ቱሙፊ አባን ሙርቲ ቶክቹመ፤ እንስ እሰ ፈይሱፊ በሌሱ ደንደኡዸ። ገሩ ነመ ካንት ሙሩፍ አት ኤኙ?<verse eid="JAS 4:12"/></para>
  <para style="s1">ዋኤ ቦሪቲፍ ኦፍ ጀጁ</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13"/>ኤጋ እስን ወር፣ “ሀርአ ዮካን ቦር መጋላ ከነ ዮካን መጋላ ሰነ ዸቅኔ ወጋ ቶኮ አች ቱረ፤ ደልደሌስ ቡኣ አርገትነ” ጄተን ሜ ዸገኣ። <verse eid="JAS 4:13"/><verse number="14" style="v" sid="JAS 4:14"/>እስን ዋን ቦር ተኡፍ ጅሩዩ ህንቤክተን። ጅሬኝኬሰን ማል እኒ? እስን ሁሪ ዬሮ ጥኖፍ ሙልአቴ ኤርገሲሞ በዱዸ። <verse eid="JAS 4:14"/><verse number="15" style="v" sid="JAS 4:15"/>ቆደ ከና እስን፣ “ዮ ጎፍታን ጄዼ፣ ኑ ንጅራትነ፤ ዋን ከነ ዮካን ዋን ሰነ ንሆጄትነ” ጄቹ ቀብዱ። <verse eid="JAS 4:15"/><verse number="16" style="v" sid="JAS 4:16"/>አመ ገሩ እስን ኦፍ ጀጁኬሰንት ገመዱ። ገመቹን አከሲ ሁንድ ሀማዸ። <verse eid="JAS 4:16"/><verse number="17" style="v" sid="JAS 4:17"/>ኤጋ ነምን ከምዩ ዋን ጋሪ ሆጄቹ ቀቡ ኡቱመ ቤኩ ዮ ሆጄቹ ባቴ ኩን ጩቡ እሰት ተአ።<verse eid="JAS 4:17"/></para>
  <chapter eid="JAS 4"/>
  <chapter number="5" style="c" sid="JAS 5"/>
  <para style="s1">ሶሬዪ ነመ ጩንቁርሰኒፍ አኬከቺሰ ኬኑ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1"/>እስን ያ ሶሬዪ፣ ሰበቢ ዽጵን እስንት ዹፉፍ ጅሩቲፍ ቦኣ፤ ወዋዻስ። <verse eid="JAS 5:1"/><verse number="2" style="v" sid="JAS 5:2"/>ቀቤኝኬሰን ቶርቶሬረ፤ ብሊንስ ኡፈተኬሰን ኛቴረ። <verse eid="JAS 5:2"/><verse number="3" style="v" sid="JAS 5:3"/>ወርቄፊ ሜቲንኬሰን ሰሜረ። ደንዳኡንሳኒስ እስንት ዹጋ በአ፤ አኩመ እብዳትስ ፎንኬሰን ኛተ። እስን በረ ዹማቲፍ ቀቤኘ ወልት ቀበተኒርቱ። <verse eid="JAS 5:3"/><verse number="4" style="v" sid="JAS 5:4"/>ኩኖ፣ ምንዳን እስን ወረ ምዻንኬሰን ሃመን ዾወተን ሱን ንእየ። እይ ወረ ምዻንኬሰን ወልት ቀበኒስ ጉረ ጎፍታ ዋን ሁንደ ደንደኡ ሰና ሴኔረ። <verse eid="JAS 5:4"/><verse number="5" style="v" sid="JAS 5:5"/>እስን ቀነኒፊ ገመቹን ለፈረ ጅራተኒርቱ። ጉያ ቀልማቲፍስ ኦፍ ገብፍተኒርቱ። <verse eid="JAS 5:5"/><verse number="6" style="v" sid="JAS 5:6"/>ነመ ቀጄላ እስኒን ህንሞርምኔት ሙርተኒ አጄፍቱ።<verse eid="JAS 5:6"/></para>
  <para style="s1">ዽጵነ ኬሰት ኦብሰ ቀባቹ</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7"/>ከናፉ ያ ኦቦሎተ፣ ሀመ ዹፋቲ ጎፍታት ኦብሳ። ቆናን ቡላን ቶኮ ለፈራ ምዻን ጋሪ አርገቹፍ ሀመም አከ ኤገቱ፣ ቦካ ዱራቲፊ ከን ዹማ ሀመ አርገቱትስ ሀመም አከ ኦብሱ ሁበዻ። <verse eid="JAS 5:7"/><verse number="8" style="v" sid="JAS 5:8"/>እስንስ አከሱመ ኦብሳ፤ ጀባዻ ዻበዻስ፤ ዹፋቲን ጎፍታ ዽኣቴራቲ። <verse eid="JAS 5:8"/><verse number="9" style="v" sid="JAS 5:9"/>ያ ኦቦሎተ፣ አከ እስንት ህንሙረምኔፍ ወልት ህንጉንጉምና። ኩኖ፣ አባን ሙርቲ በልበለ ዱረ ዻበቴረ።<verse eid="JAS 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JAS 5:10"/>ያ ኦቦሎተ፣ ራጆተ መቃ ጎፍታቲን ዱበቻ ቱረን ሰነ አከ ፈኬኘ ዽጵናፊ ኦብሳት ፉዸዻ። <verse eid="JAS 5:10"/><verse number="11" style="v" sid="JAS 5:11"/>ኩኖ፣ ኑ ወረ ኦብሳን ጀባተኒ ዻበተን ሰናን ኤብፈሞ ጄነ፤ ኢዮብ ኦብሱሳ ዸጌሰኒርቱ፤ ዋን ጎፍታን ዹመረት እሳፍ ጎዼስ አርግተኒርቱ። ጎፍታን ገረ ላፍናፊ አራራን ከን ጉተሜዸ።<verse eid="JAS 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12"/>ሁንዱማ ጫላሞ ያ ኦቦሎተኮ፣ ህንከከትና፤ ሰሚን ዮካን ለፋን ዮካን ዋን ብራ ቶኮንሌ ህንከከትና። ወን እስን ጄቹ ቀብደን፣ “ኤዬ” ዮካን “ዋዉ” ሃተኡ። ዮ ከና አቺ እስንት ሙረመ።<verse eid="JAS 5:12"/></para>
  <para style="s1">ከዸትና አመንቲ</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13"/>እስን ኬሳ ነምን ዽጰቻ ጅሩ ጅራ? እን ሃከዸቱ። ነምን ገመዱ ጅራ? እን ፋርፈትና ገለታ ሃፋርፈቱ። <verse eid="JAS 5:13"/><verse number="14" style="v" sid="JAS 5:14"/>እስን ኬሳ ነምን ዹኩብሰቱ ጅራ? እን ጃርሶሊ ወልዳ ክርስታና ሃዋምስፈቱ፤ እሳንስ መቃ ጎፍታቲን ዘይቲ እሰ ድበኒ ሃከዸተኒፍ። <verse eid="JAS 5:14"/><verse number="15" style="v" sid="JAS 5:15"/>ከዸትናን አመንቲን ጎዸሙ ነመ ዹኩብሰቱ ንፈይሰ፤ ጎፍታንስ እሰ ንካሰ። ዮ እን ጩቡ ሆጄቴ ጅራቴስ ንዺፈማፍ። <verse eid="JAS 5:15"/><verse number="16" style="v" sid="JAS 5:16"/>ከናፉ አከ ፈይተኒፍ ጩቡኬሰን ወልት ህመዻቲ ወሊ ከዸዻ። ከዸትናን ነመ ቀጄላ ሁምነ ቀበ፤ ዋን ጉዳስ ንሆጄተ።<verse eid="JAS 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 5:17"/>ኤልያስ ነሙመ አከኬኛ ቱሬ። እንስ አከ ቦካን ህንሮብኔፍ ጀቤሴ ከዸቴ፤ ቦካንስ ወጋ ሰዲፊ ጅአ ጀአ ለፈረት ህንሮብኔ። <verse eid="JAS 5:17"/><verse number="18" style="v" sid="JAS 5:18"/>አመስ ዴብኤ ከዸቴ፤ ሰሚን ቦካ ኬኔ፤ ለፍትስ ምዻን ባፍቴ።<verse eid="JAS 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 5:19"/>ያ ኦቦሎተኮ፣ እስን ኬሳ ነምን ቶኮ ዮ ዹጋራ ፈጋቴ፣ ነምን ብራሞ ዮ እሰ ዴብሴ፣ <verse eid="JAS 5:19"/><verse number="20" style="v" sid="JAS 5:20"/>እን ነመ ጩበማ ከራ ጀልኣራ ዴብሱ ሉቡ ነምቸ ሰና አከ ዱአ ጀላ ባሱ፣ ጩቡ ባይኤስ አከ ዾክሱ ሃቤኩ።<verse eid="JAS 5:20"/></para>
  <chapter eid="JAS 5"/>
</usx>
