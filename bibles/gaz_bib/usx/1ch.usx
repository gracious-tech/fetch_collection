<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1CH" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">1 ሴና</para>
  <para style="toc1">ክታበ ሴና ቶኮፋ</para>
  <para style="toc2">1 ሴና</para>
  <para style="toc3">1ሴና</para>
  <para style="mt2">ክታበ</para>
  <para style="mt1">ሴና</para>
  <para style="mt3">ቶኮፋ</para>
  <chapter number="1" style="c" sid="1CH 1"/>
  <para style="s1">ሰኚ አዳም</para>
  <para style="s2">ሀመ እልማን ኖሂት</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 1:1"/>አዳም፣ ሴት፣ ኤኖሽ፣<verse eid="1CH 1:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 1:2"/>ቄናን፣ መሀለሌል፣ ያሬድ፣<verse eid="1CH 1:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 1:3"/>ሄኖክ፣ መቱሴላ፣ ላሜህ፣</para>
  <para style="li1" vid="1CH 1:3">ኖህ።<verse eid="1CH 1:3"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="4" style="v" sid="1CH 1:4"/>እልማን ኖህ፦ ሴም፣ ሃም፣ ያፌት፦<verse eid="1CH 1:4"/></para>
  <para style="s2">ያፌቶተ</para>
  <para style="r">
    <ref loc="1CH 1:5-7">1፥5‑7</ref> ኩወፈ – <char style="xt"><ref loc="GEN 10:2-5">ኡመ 10፥2‑5</ref></char></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 1:5"/>እልማን ያፌት፦</para>
  <para style="li2" vid="1CH 1:5">ጎሜር፣ ማጎግ፣ ሜዴ፣ ያዋን፣ ቱባል፣ ሜሼኪፊ ቲራስ ቱረን።<verse eid="1CH 1:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 1:6"/>እልማን ጎሜር፦</para>
  <para style="li2" vid="1CH 1:6">አሽኬነስ፣ ሪፋቲፊ ቶገርማ ቱረን።<verse eid="1CH 1:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 1:7"/>እልማን ያዋን፦</para>
  <para style="li2" vid="1CH 1:7">ኤሊሻ፣ ተርሺሽ፣ ክቲሚፊ ሮዳኖተ ቱረን።<verse eid="1CH 1:7"/></para>
  <para style="s2">ካሞተ</para>
  <para style="r">
    <ref loc="1CH 1:8-16">1፥8‑16</ref> ኩወፈ – <char style="xt"><ref loc="GEN 10:6-20">ኡመ 10፥6‑20</ref></char></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 1:8"/>እልማን ሃም፦</para>
  <para style="li2" vid="1CH 1:8">ኩሽ፣ ምስረይም፣ ፉጢፊ ከነኣን ቱረን።<verse eid="1CH 1:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 1:9"/>እልማን ኩሽ፦</para>
  <para style="li2" vid="1CH 1:9">ሳባ፣ ሀዊላ፣ ሰብታ፣ ረእማፊ ሰብቴካ ቱረን።</para>
  <para style="li1" vid="1CH 1:9">እልማን ረእማ፦</para>
  <para style="li2" vid="1CH 1:9">ሼባፊ ዴዳን ቱረን።<verse eid="1CH 1:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 1:10"/>ኩሽ አባ ናምሩድ፤</para>
  <para style="li2" vid="1CH 1:10">ናምሩድስ ለፈረት ሎልቱ ጀባ ተኤ።<verse eid="1CH 1:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 1:11"/>ምስረይምሞ አባ</para>
  <para style="li2" vid="1CH 1:11">ሉዲሞታ፣ አናሚሞታ፣ ሌሃቢሞታ፣ ነፍተሂሞታ፣ <verse eid="1CH 1:11"/><verse number="12" style="v" sid="1CH 1:12"/>ፈትሩሲሞታ፣ ከሴሉሂሞታ ጄቹንስ ወረ ፍልስጤሞትን እራ ዸለተኒፊ ከፍቶሪሞታት።<verse eid="1CH 1:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 1:13"/>ከነኣን አባ</para>
  <para style="li2" vid="1CH 1:13">ሲዶን እልመሳ ሀንገፍትቻ አከሱመስ ከን ሄቶታ፣ <verse eid="1CH 1:13"/><verse number="14" style="v" sid="1CH 1:14"/>ዬቡሶታ፣ አሞሮታ፣ ግርጋሾታ፣ <verse eid="1CH 1:14"/><verse number="15" style="v" sid="1CH 1:15"/>ሂዎታ፣ አርካዎታ፣ ሲኖታ፣ <verse eid="1CH 1:15"/><verse number="16" style="v" sid="1CH 1:16"/>አርዋዴዎታ፣ ዜማሮታቲፊ ሀማቶታ ቱሬ።<verse eid="1CH 1:16"/></para>
  <para style="s2">ሴሞተ</para>
  <para style="r">
    <ref loc="1CH 1:17-23">1፥17‑23</ref> ኩወፈ – <char style="xt"><ref loc="GEN 10:21-31">ኡመ 10፥21‑31</ref>፤ <ref loc="GEN 11:10-27">11፥10‑27</ref></char></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 1:17"/>እልማን ሴም፦</para>
  <para style="li2" vid="1CH 1:17">ኤላም፣ አሹር፣ አርፋክሸድ፣ ሉዲፊ አራም ቱረን።</para>
  <para style="li1" vid="1CH 1:17">እልማን አራም፦</para>
  <para style="li2" vid="1CH 1:17">ኡዝ፣ ሁል፣ ጌቴሪፊ ሜሼክ ቱረን።<verse eid="1CH 1:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 1:18"/>አርፋክሸድ ሼላ ዸልቼ፤</para>
  <para style="li2" vid="1CH 1:18">ሼላንሞ ኤቤርን ዸልቼ።<verse eid="1CH 1:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 1:19"/>ኤቤሪፍስ እልማን ለመቱ ዸለቴ፦</para>
  <para style="li2" vid="1CH 1:19">ሰበቢ በረሳ ኬሰ ለፍት ገርገር ቆደምቴፍ፣ መቃን እሰ ቶኮ ፌሌግ ጄዸሜ ሞጋፈሜ፤ መቃን ኦቦሌሰሳሞ ዮቅጣን ጄዸሜ ሞጋፈሜ።<verse eid="1CH 1:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 1:20"/>ዮቅጣንሞ</para>
  <para style="li2" vid="1CH 1:20">አልሞዳድ፣ ሼሌፍ፣ ሀዘርማዌት፣ ያራ፣ <verse eid="1CH 1:20"/><verse number="21" style="v" sid="1CH 1:21"/>ሀዶራም፣ ኡዛል፣ ድቅላ፣ <verse eid="1CH 1:21"/><verse number="22" style="v" sid="1CH 1:22"/>ኤባል፣ አቢማኤል፣ ሼባ፣ <verse eid="1CH 1:22"/><verse number="23" style="v" sid="1CH 1:23"/>ኦፊር፣ ሀዊላፊ ዮባብን ዸልቼ። ወር ኩኔን ሁንድኑ እልማን ዮቅጣኒት።<verse eid="1CH 1:23"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 1:24"/>ሴም፣ አርፋክሸድ፣ ሼላ፣<verse eid="1CH 1:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 1:25"/>ኤቤር፣ ፌሌግ፣ ሬኡ፣<verse eid="1CH 1:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 1:26"/>ሴሩግ፣ ናሆር፣ ታራ፣<verse eid="1CH 1:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 1:27"/>አከሱመስ አብራም ከን አብረሃም ጄዸሜ ሰናዸ።<verse eid="1CH 1:27"/></para>
  <para style="s1">ማቲ አብረሃም</para>
  <para style="lh">
    <verse number="28" style="v" sid="1CH 1:28"/>እልማን አብረሃም፦ ይስሃቂፊ እሽማኤል።<verse eid="1CH 1:28"/></para>
  <para style="s2">ሰኚወን አጋር</para>
  <para style="r">
    <ref loc="1CH 1:29-31">1፥29‑31</ref> ኩወፈ – <char style="xt"><ref loc="GEN 25:12-16">ኡመ 25፥12‑16</ref></char></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 1:29"/>ሰኚወንሳኒ ወረ ከኔኒዸ፦</para>
  <para style="li2" vid="1CH 1:29">ነባዮት እልመ እሽማኤል ሀንገፍትቸ፣ ቄዳር፣ አድብኤል፣ ምብሳም፣ <verse eid="1CH 1:29"/><verse number="30" style="v" sid="1CH 1:30"/>ምሽማ፣ ዱማ፣ ማሳ፣ ሀዳድ፣ ቴማ፣ <verse eid="1CH 1:30"/><verse number="31" style="v" sid="1CH 1:31"/>ዬጡር፣ ናፊሺፊ ቄድማ።</para>
  <para style="lf" vid="1CH 1:31">እሳን ኩኔን እልማን እሽማኤል።<verse eid="1CH 1:31"/></para>
  <para style="s2">ሰኚወን ሄቱራ</para>
  <para style="r">
    <ref loc="1CH 1:32-33">1፥32‑33</ref> ኩወፈ – <char style="xt"><ref loc="GEN 25:1-4">ኡመ 25፥1‑4</ref></char></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 1:32"/>እልማን ቄጡራን ሳጀቶን አብረሃም ሱን ዴሴ፦</para>
  <para style="li2" vid="1CH 1:32">ዝምራን፣ ዮቅሻን፣ ሜዳን፣ ምድያን፣ ይሽባቂፊ ሹዋ።</para>
  <para style="li1" vid="1CH 1:32">እልማን ዮክሻን፦</para>
  <para style="li2" vid="1CH 1:32">ሼባፊ ዴዳን።<verse eid="1CH 1:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 1:33"/>እልማን ምድያን፦</para>
  <para style="li2" vid="1CH 1:33">ኤፋ፣ ኤፌር፣ ሄኖክ፣ አቢዳፊ ኤልዳኣ።</para>
  <para style="lf" vid="1CH 1:33">ወር ኩኔን ሁንድ ሰኚወን ቄጡራት።<verse eid="1CH 1:33"/></para>
  <para style="s2">ሰኚወን ሳራ</para>
  <para style="r">
    <ref loc="1CH 1:35-37">1፥35‑37</ref> ኩወፈ – <char style="xt"><ref loc="GEN 36:10-14">ኡመ 36፥10‑14</ref></char></para>
  <para style="lh">
    <verse number="34" style="v" sid="1CH 1:34"/>አብረሃም አባ ይስሃቅ።</para>
  <para style="li1" vid="1CH 1:34">እልማን ይስሃቅ፦</para>
  <para style="li2" vid="1CH 1:34">ኤሳዉፊ እስራኤል።<verse eid="1CH 1:34"/></para>
  <para style="s1">እልማን ኤሳዉ</para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 1:35"/>እልማን ኤሳዉ፦</para>
  <para style="li2" vid="1CH 1:35">ኤሊፋዝ፣ ሬኡኤል፣ ዬኡሽ፣ የእላሚፊ ቆራህ።<verse eid="1CH 1:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 1:36"/>እልማን ኤሊፋዝ፦</para>
  <para style="li2" vid="1CH 1:36">ቴማን፣ ኦማር፣ ዜፎ፣ ጋታሚፊ ቄነዝ፤</para>
  <para style="li2" vid="1CH 1:36">ከራ ቲምናቲን፦ አማሌቅ።<verse eid="1CH 1:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 1:37"/>እልማን ሬኡኤል፦</para>
  <para style="li2" vid="1CH 1:37">ነሃት፣ ዜራ፣ ሸማፊ ሚዛህ።<verse eid="1CH 1:37"/></para>
  <para style="s2">ነሞተ ሴኢር ከኔን ኤዶም ኬሰ ጅራተን</para>
  <para style="r">
    <ref loc="1CH 1:38-42">1፥38‑42</ref> ኩወፈ – <char style="xt"><ref loc="GEN 36:20-28">ኡመ 36፥20‑28</ref></char></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 1:38"/>እልማን ሴኢር፦</para>
  <para style="li2" vid="1CH 1:38">ሎጣን፣ ሶባል፣ ዝቤኦን፣ ኣና፣ ዲሾን፣ ኤዜሪፊ ዲሻን።<verse eid="1CH 1:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 1:39"/>እልማን ሎጣን፦</para>
  <para style="li2" vid="1CH 1:39">ሆሪፊ ሆማም፣ ቲምና ኦቦሌቲ ሎጣን።<verse eid="1CH 1:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 1:40"/>እልማን ሶባል፦</para>
  <para style="li2" vid="1CH 1:40">አልዋን፣ ማነሃት፣ ኤባል፣ ሼፎፊ ኦናም።</para>
  <para style="li1" vid="1CH 1:40">እልማን ዝቤኦን፦</para>
  <para style="li2" vid="1CH 1:40">አያፊ ኣና።<verse eid="1CH 1:40"/></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 1:41"/>እልም ኣና፦</para>
  <para style="li2" vid="1CH 1:41">ዲሾን።</para>
  <para style="li1" vid="1CH 1:41">እልማን ዲሾን፦</para>
  <para style="li2" vid="1CH 1:41">ሄምዳን፣ ኤሽባን፣ ይትራኒፊ ኬራን።<verse eid="1CH 1:41"/></para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 1:42"/>እልማን ኤዜር፦</para>
  <para style="li2" vid="1CH 1:42">ብልሃን፣ ዛዋኒፊ አቃን።</para>
  <para style="li1" vid="1CH 1:42">እልማን ዲሻን፦</para>
  <para style="li2" vid="1CH 1:42">ኡዚፊ አራን።<verse eid="1CH 1:42"/></para>
  <para style="s2">ቡልችቶተ ኤዶም</para>
  <para style="r">
    <ref loc="1CH 1:43-54">1፥43‑54</ref> ኩወፈ – <char style="xt"><ref loc="GEN 36:31-43">ኡመ 36፥31‑43</ref></char></para>
  <para style="lh">
    <verse number="43" style="v" sid="1CH 1:43"/>ሞቶትን ኡቱ ሞቲን እስራኤል ቶኮዩ ህንሞእን ዱረ ኤዶም ኬሰት ሞአን ከኔን ቱረን፦</para>
  <para style="li1" vid="1CH 1:43">ቤላ እልመ ቤኦር ከን መጋላንሳ ዲንሃባ ጄዸሜ ሞጋፈሜ ሰነ።<verse eid="1CH 1:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 1:44"/>ቤላ ዱናን ዮባብ እልም ዜራ ነምች ቦዝራ እዶሳ ቡኤ ሞቲ ተኤ።<verse eid="1CH 1:44"/></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 1:45"/>ዮባብ ዱናን ሁሻም ነምች ብየ ቴማን እዶሳ ቡኤ ሞቲ ተኤ።<verse eid="1CH 1:45"/></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 1:46"/>ሁሻም ዱናን ሀዳድ እልም ቤደድ እን ብየ ሞኣብት ምድያንን ሞአቴ ሱን እዶሳ ቡኤ ሞቲ ተኤ። መቃን መጋላሳ ኣዊት ጄዸሜ።<verse eid="1CH 1:46"/></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 1:47"/>ሀዳድ ዱናን ሰምላን ነምች መስሬቃ እዶሳ ቡኤ ሞቲ ተኤ።<verse eid="1CH 1:47"/></para>
  <para style="li1">
    <verse number="48" style="v" sid="1CH 1:48"/>ሰምላን ዱናን ሻዉል ነምች ብየ ሬሆቦት እሼ ለገ ብረ ጅርቱ ሰና እዶሳ ቡኤ ሞቲ ተኤ።<verse eid="1CH 1:48"/></para>
  <para style="li1">
    <verse number="49" style="v" sid="1CH 1:49"/>ሻዉል ዱናን በኣል-ሃናን እልም አክቦር እዶሳ ቡኤ ሞቲ ተኤ።<verse eid="1CH 1:49"/></para>
  <para style="li1">
    <verse number="50" style="v" sid="1CH 1:50"/>በኣል-ሃናን ዱናንሞ ሀዳድ እዶሳ ቡኤ ሞቲ ተኤ። መጋላንሳስ ፋኡ ጄዸሜ። መቃን ኒቲሳሞ መሄጠብኤል ጄዸመ ቱሬ፤ እሼንስ እንተለ መጥሬድ፣ እንተለ ሜ-ዛሃብ ቱርቴ። <verse eid="1CH 1:50"/><verse number="51" style="v" sid="1CH 1:51"/>ሀዳድስ ንዱኤ።</para>
  <para style="b" vid="1CH 1:51"/>
  <para style="lh" vid="1CH 1:51">ሀንገፎተ ሰበ ኤዶም፦</para>
  <para style="li1" vid="1CH 1:51">ቲምና፣ ኣልዋ፣ ዬቴት፣ <verse eid="1CH 1:51"/><verse number="52" style="v" sid="1CH 1:52"/>ኦሆሊባማ፣ ኤላ፣ ጲኖን፣ <verse eid="1CH 1:52"/><verse number="53" style="v" sid="1CH 1:53"/>ቄነዝ፣ ቴማን፣ ምብዛር፣ <verse eid="1CH 1:53"/><verse number="54" style="v" sid="1CH 1:54"/>መግዲኤሊፊ ኢራም።</para>
  <para style="lf" vid="1CH 1:54">ነሞትን ኩኔን ሀንገፎተ ኤዶም ቱረን።<verse eid="1CH 1:54"/></para>
  <chapter eid="1CH 1"/>
  <chapter number="2" style="c" sid="1CH 2"/>
  <para style="s1">እልማን እስራኤል</para>
  <para style="r">
    <ref loc="1CH 2:1-2">2፥1‑2</ref> ኩወፈ – <char style="xt"><ref loc="GEN 35:23-26">ኡመ 35፥23‑26</ref></char></para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 2:1"/>እልማን እስራኤል ወረ ከኔኒዸ፦ ሩቤን፣ ስምኦን፣ ሌዊ፣ ይሁዳ፣ ይሳኮር፣ ዜቡሎን፣ <verse eid="1CH 2:1"/><verse number="2" style="v" sid="1CH 2:2"/>ዳን፣ ዮሴፍ፣ ቤንያም፣ ንፍታሌም፣ ጋዲፊ ኣሼር።<verse eid="1CH 2:2"/></para>
  <para style="s1">ይሁዳ</para>
  <para style="r">
    <ref loc="1CH 2:5-15">2፥5‑15</ref> ኩወፈ – <char style="xt"><ref loc="RUT 4:18-22">ሩት 4፥18‑22</ref>፤ <ref loc="MAT 1:3-6">ማቴ 1፥3‑6</ref></char></para>
  <para style="s2">ሀመ እልማን ሄዝሮንት</para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 2:3"/>እልማን ይሁዳ፦</para>
  <para style="li2" vid="1CH 2:3">ኤር፣ ኦናኒፊ ሼላ። እሳን ከኔን ሰደኑ እንተለ ሹዋ፣ ዱበርቲ ከነኣን ሰነቱ እሳፍ ደኤ።</para>
  <para style="li2" vid="1CH 2:3">ኤር እልም ይሁዳ ሀንገፍትች ፉለ <char style="nd">ዋቀዮ</char> ዱረት ሀማ ቱሬ። ከናፉ <char style="nd">ዋቀዮ</char> እሰ አጄሴ።<verse eid="1CH 2:3"/></para>
  <para style="li2">
    <verse number="4" style="v" sid="1CH 2:4"/>ታማር ኒቲን እልመ ይሁዳ ፋሬሲፊ ዛራ ይሁዳፍ ዴሴ።</para>
  <para style="lf" vid="1CH 2:4">ይሁዳን ወሉማ ገለት እልማን ሸን ቀበ ቱሬ።<verse eid="1CH 2:4"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 2:5"/>እልማን ፋሬስ፦</para>
  <para style="li2" vid="1CH 2:5">ሄዝሮኒፊ ሀሙል።<verse eid="1CH 2:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 2:6"/>እልማን ዛራ፦</para>
  <para style="li2" vid="1CH 2:6">ዝምሪ፣ ኤታን፣ ሄማን፣ ከልኮሊፊ ዳርዳ። እሳን ወሉማ ገለት ዺሮተ ሸን ቱረን።<verse eid="1CH 2:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 2:7"/>እልመ ከርሚ፦</para>
  <para style="li2" vid="1CH 2:7">ኣካር እሰ ዋን በሌፈሙ ቀቡ ፉዸቹዻን እስራኤልት ረክነ ፍዴ።<verse eid="1CH 2:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 2:8"/>እልመ ኤታን፦</para>
  <para style="li2" vid="1CH 2:8">አዛርያ።<verse eid="1CH 2:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 2:9"/>እልማን ሄዝሮን፦</para>
  <para style="li2" vid="1CH 2:9">ዬረምኤል፣ ራሚፊ ኬሉባ።<verse eid="1CH 2:9"/></para>
  <para style="s2">ራም እልመ ሄዝሮኒ ጀልቀቤ</para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 2:10"/>ራም አባ አቢናዳብ ቱሬ፤</para>
  <para style="li1" vid="1CH 2:10">አሚናዳብሞ አባ ነህሾን ሆገና ሰበ ይሁዳ ቱሬ።<verse eid="1CH 2:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 2:11"/>ነህሾን አባ ሰልማን፤</para>
  <para style="li1" vid="1CH 2:11">ሰልማንሞ አባ ቦኤዝ፤<verse eid="1CH 2:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 2:12"/>ቦኤዝ አባ ኦቤድ፤</para>
  <para style="li1" vid="1CH 2:12">ዮቤድሞ አባ እሴይ።<verse eid="1CH 2:12"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 2:13"/>እልማን እሴይ፦</para>
  <para style="li2" vid="1CH 2:13">እልምሳ ሀንገፍን ኤሊያብ፣ ለመፋን አቢናዳብ፣</para>
  <para style="li2" vid="1CH 2:13">ሰደፋን ሽሜኣ፣ <verse eid="1CH 2:13"/><verse number="14" style="v" sid="1CH 2:14"/>አፉረፋን ናትናኤል፣</para>
  <para style="li2" vid="1CH 2:14">ሸነፋን ራዳይ፣ <verse eid="1CH 2:14"/><verse number="15" style="v" sid="1CH 2:15"/>ጀአፋን ኦዜም፣</para>
  <para style="li2" vid="1CH 2:15">ቶርበፋን ዳዊት።<verse eid="1CH 2:15"/></para>
  <para style="li2">
    <verse number="16" style="v" sid="1CH 2:16"/>ኦቦሌቶትንሳኒሞ ዜሩያፊ አቢገዪል ቱረን።</para>
  <para style="li3" vid="1CH 2:16">እልማን ዜሩያ ሰደን አቢሻይ፣ ዮኣቢፊ አሳሄል ቱረን።<verse eid="1CH 2:16"/></para>
  <para style="li3">
    <verse number="17" style="v" sid="1CH 2:17"/>አቢገዪል ሃዸ አማሳ ከን አባንሳ ዬቴር ነመ ጎሰ እሽማኤል ሰናት።<verse eid="1CH 2:17"/></para>
  <para style="s2">ካሌብ እልመ ሄዝሮን</para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 2:18"/>ካሌብ እልም ሄዝሮን ኒቲሳ አዙባፊ ዬርኦትራ እጆሌ ዸልቼ። እልማን ኣዙባ ከኔን ቱረን፦</para>
  <para style="li2" vid="1CH 2:18">ዬሴር፣ ሶባቢፊ አርዶን።<verse eid="1CH 2:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 2:19"/>ካሌብስ አዙባን ዱናን ኤፍራታ ፉዼ። እሼንስ ሁርን እሳፍ ዴሴ።<verse eid="1CH 2:19"/></para>
  <para style="li2">
    <verse number="20" style="v" sid="1CH 2:20"/>ሁር አባ ኡር፤ ኡርሞ አባ ቤዘልኤል።<verse eid="1CH 2:20"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 2:21"/>ኤርገሲ ሄዝሮን ዮሙ ኡሙሪንሳ ወጋ ጃተመ ጉቴት እንተለ አባ ግልኣድ እንተለ ማኪር ፉዼ፤ እሼንስ ሴጉብን እሳፍ ዴሴ።<verse eid="1CH 2:21"/></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 2:22"/>ሴጉብሞ አባ ያኢር ቱሬ፤ እንስ ብየ ግልኣድ ኬሳ መጋላወን ድግደሚ ሰዲ ቀበ ቱሬ።<verse eid="1CH 2:22"/></para>
  <para style="li2">
    <verse number="23" style="v" sid="1CH 2:23"/>ጌሹሪፊ አራም፣ መጋላ ያኢር አከሱመስ ቄናቲፊ ገንዶተ ናኖሼ ጅረኒን ወልት መጋላወን ጃተመ እራ ፉዸተን።</para>
  <para style="lf" vid="1CH 2:23">እሳን ኩኔን ሁንድ ሰኚ አባ ግልኣድ ሰኚ ማኪር ቱረን።<verse eid="1CH 2:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 2:24"/>ሄዝሮን ኤርገ ካሌብ ኤፍራታት ዱኤ ቦዴ፣ ኒቲንሳ አብያን አሽሁር አባ ቴቆኣ ዴሴፍ።<verse eid="1CH 2:24"/></para>
  <para style="s2">ዬረህምኤል እልመ ሄዝሮን</para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 2:25"/>እልማን ዬረምኤል እልመ ሄዝሮን ሀንገፍትቸ ሰና፦</para>
  <para style="li2" vid="1CH 2:25">ራም እልመሳ ሀንገፍትቸ፣ ቡናህ፣ ኦሬን፣ ኦዜሚፊ አሂያ። <verse eid="1CH 2:25"/><verse number="26" style="v" sid="1CH 2:26"/>ዬረምኤል ኒቲ ብራ ከን ኣጣራ ጄዸምቱ ቀበ ቱሬ፤ እሼንስ ሃዸ ኦናም ቱርቴ።<verse eid="1CH 2:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 2:27"/>እልማን ራም እልመ ዬረምኤል ሀንገፍትቸ ሰና፦</para>
  <para style="li2" vid="1CH 2:27">መኣዝ፣ ያሚኒፊ ኤቄር።<verse eid="1CH 2:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 2:28"/>እልማን ኦናም፦</para>
  <para style="li2" vid="1CH 2:28">ሸማዪፊ ያዳ።</para>
  <para style="li1" vid="1CH 2:28">እልማን ሸማይ፦</para>
  <para style="li2" vid="1CH 2:28">ናዳቢፊ አቢሹር። <verse eid="1CH 2:28"/><verse number="29" style="v" sid="1CH 2:29"/>ኒቲን አቢሹር አቢሃይል ጄዸምት፤ እሼንስ አህባኒፊ ሞሊድ እሳፍ ዴሴ።<verse eid="1CH 2:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 2:30"/>እልማን ናዳብ፦</para>
  <para style="li2" vid="1CH 2:30">ሴሌዲፊ አፈዪም። ሴሌድ ኡቱ እጆሌ ህንዸልችን ዱኤ።<verse eid="1CH 2:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 2:31"/>እልመ አፈዪም፦</para>
  <para style="li2" vid="1CH 2:31">ይሼኢ፤ ይሼኢን አባ ሼሻን። ሼሻንሞ አባ አህለይ።<verse eid="1CH 2:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 2:32"/>እልማን ያዳ ከን ኦቦሌሰ ሸማይ፦</para>
  <para style="li2" vid="1CH 2:32">ዬቴሪፊ ዮናታን። ዬቴር ኡቱ እጆሌ ህንዸልችን ዱኤ።<verse eid="1CH 2:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 2:33"/>እልማን ዮናታን፦</para>
  <para style="li2" vid="1CH 2:33">ጴሌቲፊ ዛዛ።</para>
  <para style="lf" vid="1CH 2:33">እሳን ኩኔን ሰኚወን ዬረምኤል ቱረን።<verse eid="1CH 2:33"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 2:34"/>ሼሻን እንተለን መሌ እልማን ህንቀቡ ቱሬ።</para>
  <para style="li2" vid="1CH 2:34">እንስ ተጃጅላ ለሚ ግብጥ ከን የርሃ ጄዸሙ ቶኮ ቀበ ቱሬ። <verse eid="1CH 2:34"/><verse number="35" style="v" sid="1CH 2:35"/>ሼሻን ተጃጅላሳ የርሃት እንተለሳ ንሄሩምሲሴ፤ እሼንስ አታይን ዴሴፍ።<verse eid="1CH 2:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 2:36"/>አታይ አባ ናታን፤</para>
  <para style="li1" vid="1CH 2:36">ናታንሞ አባ ዛባድን፤<verse eid="1CH 2:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 2:37"/>ዛባድ አባ ኤፍላል፤</para>
  <para style="li1" vid="1CH 2:37">ኤፍላልሞ አባ ኦቤድ፤<verse eid="1CH 2:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 2:38"/>ኦቤድ አባ ዬሁ፤</para>
  <para style="li1" vid="1CH 2:38">ዬሁን አባ አዛርያ፤<verse eid="1CH 2:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 2:39"/>አዛርያ አባ ሄሌዝ፤</para>
  <para style="li1" vid="1CH 2:39">ሄሌስሞ አባ ኤሌኣሳት፤<verse eid="1CH 2:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 2:40"/>ኤሌኣሳን አባ ስስማይ፤</para>
  <para style="li1" vid="1CH 2:40">ስስማይ አባ ሸሉም፤<verse eid="1CH 2:40"/></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 2:41"/>ሸሉም አባ ዬቀሜያት፤</para>
  <para style="li1" vid="1CH 2:41">ዬቀሜያንሞ አባ ኤሊሻማት።<verse eid="1CH 2:41"/></para>
  <para style="s2">ጎሶተ ካሌብ</para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 2:42"/>እልማን ካሌብ ኦቦሌሰ ዬረምኤል፦</para>
  <para style="li2" vid="1CH 2:42">ሜሻን እልምሳ ሀንገፍትች አባ ዚፍ፤ ዚፍ አባ ማሬሻት፤</para>
  <para style="li2" vid="1CH 2:42">ማሬሻንሞ አባ ኬብሮን።<verse eid="1CH 2:42"/></para>
  <para style="li1">
    <verse number="43" style="v" sid="1CH 2:43"/>እልማን ኬብሮን፦</para>
  <para style="li2" vid="1CH 2:43">ቆራህ፣ ተፉኣ፣ ሬቄሚፊ ሼማ።<verse eid="1CH 2:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 2:44"/>ሼማን አባ ረሀም፤</para>
  <para style="li2" vid="1CH 2:44">ረሀምሞ አባ ዮርቄኣም።</para>
  <para style="li1" vid="1CH 2:44">ሬቄም አባ ሸማይ።<verse eid="1CH 2:44"/></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 2:45"/>ሸማይ አባ ማኦን፤</para>
  <para style="li2" vid="1CH 2:45">ማኦንሞ አባ ቤት ዙር።<verse eid="1CH 2:45"/></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 2:46"/>ኤፋን ሳጀቶን ካሌብ ሱን ሃዸ</para>
  <para style="li2" vid="1CH 2:46">ሃራን፣ ሞዛፊ ጋዜዝ።</para>
  <para style="li2" vid="1CH 2:46">ሃራንሞ አባ ጋዜር።<verse eid="1CH 2:46"/></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 2:47"/>እልማን ያህዳይ፦</para>
  <para style="li2" vid="1CH 2:47">ሬጌም፣ ዮታም፣ ጌሻን፣ ጴሌት፣ ኤፋፊ ሸኣፍ።<verse eid="1CH 2:47"/></para>
  <para style="li1">
    <verse number="48" style="v" sid="1CH 2:48"/>መአካን ሳጀቶን ካሌብ ሱን ሃዸ</para>
  <para style="li2" vid="1CH 2:48">ሼቤሪፊ ትርሃናት።<verse eid="1CH 2:48"/></para>
  <para style="li2">
    <verse number="49" style="v" sid="1CH 2:49"/>እሼን አከሱመስ ሸኣፍ አባ መድማና፣</para>
  <para style="li2" vid="1CH 2:49">ሼዋ አባ መክቤናፊ አባ ግቤኣ ዴሴ።</para>
  <para style="li1" vid="1CH 2:49">ካሌብ እንተለ ኣክሳ ጄዸምቱ ቀበ ቱሬ።<verse eid="1CH 2:49"/></para>
  <para style="lf">
    <verse number="50" style="v" sid="1CH 2:50"/>እሳን ኩኔን ሰኚወን ካሌብ ቱረን።</para>
  <para style="b" vid="1CH 2:50"/>
  <para style="li1" vid="1CH 2:50">እልማን ሁር እልመ ኤፍራታ ሀንገፍትቻ፦</para>
  <para style="li2" vid="1CH 2:50">ሶባል አባ ክርያት ዬኣሪም፣ <verse eid="1CH 2:50"/><verse number="51" style="v" sid="1CH 2:51"/>ሰልማን አባ ቤትልሄም፣ ሃሬፍ አባ ቤት ጋዴር።<verse eid="1CH 2:51"/></para>
  <para style="li1">
    <verse number="52" style="v" sid="1CH 2:52"/>ሰኚወን ሶባል ከን አባ ክርያት ዬኣሪም፦</para>
  <para style="li2" vid="1CH 2:52">ወለካን ሜኑሆታ፣ ሃሮኤ፣ <verse eid="1CH 2:52"/><verse number="53" style="v" sid="1CH 2:53"/>አከሱመስ ጎስት ክርያት ዬኣሪም፣ ይትራዎን፣ ፉቶን፣ ሹማቶን፣ ምሽራዎን፣ ዞራቶታፊ ኤሽታኦሎትን ጎሶተ እሳን ከኔን ኬሳ ዸለተኒዸ።<verse eid="1CH 2:53"/></para>
  <para style="li1">
    <verse number="54" style="v" sid="1CH 2:54"/>ሰኚወን ሰልማን፦</para>
  <para style="li2" vid="1CH 2:54">ቤትልሄም፣ ኔቶፎተ፣ አትሮት ቤት ዮኣብ፣ ወለካ ማነሄቶታ፣ ዞራቶተ ፈእ፤ <verse eid="1CH 2:54"/><verse number="55" style="v" sid="1CH 2:55"/>በልበለ በሬስቶታ ከኔን ያቤጥ ኬሰ ጅራተን፦ ትራቶተ፣ ሽሜኣቶታፊ ሱካቶተ። እሳን ኩኔን ቄኖተ መነ አባ ሬካብ ሀማት ኬሳ ዸለተኒዸ።<verse eid="1CH 2:55"/></para>
  <chapter eid="1CH 2"/>
  <chapter number="3" style="c" sid="1CH 3"/>
  <para style="s2">እልማን ዳዊት</para>
  <para style="r">
    <ref loc="1CH 3:1-4">3፥1‑4</ref> ኩወፈ – <char style="xt"><ref loc="2SA 3:2-5">2ሳሙ 3፥2‑5</ref></char></para>
  <para style="r">
    <ref loc="1CH 3:5-8">3፥5‑8</ref> ኩወፈ – <char style="xt"><ref loc="2SA 5:14-16">2ሳሙ 5፥14‑16</ref>፤ <ref loc="1CH 14:4-7">1ሴና 14፥4‑7</ref></char></para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 3:1"/>እሳን ኩኔን እልማን ዳዊት ኬብሮንት ዸልቼዸ፦</para>
  <para style="b" vid="1CH 3:1"/>
  <para style="li1" vid="1CH 3:1">እልምሳ ሀንገፍን አምኖን ከን አሂኖአም ዱበርቲን ይዝርኤል ዴሴዸ፤</para>
  <para style="li1" vid="1CH 3:1">እን ለመፋንሞ ዳንኤል ከን አቢገዪል ዱበርቲን ቀርሜሎስ ዴሴዸ፤<verse eid="1CH 3:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 3:2"/>ሰደፋን አቤሳሎም እሰ መአካን እንተል ተልማይ ሞትቸ ጌሹር ዴሴዸ፤</para>
  <para style="li1" vid="1CH 3:2">አፉረፋን አዶንያ እልመ ሀጊት፤<verse eid="1CH 3:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 3:3"/>ሸነፋን ሼፋጥያ እልመ አቢጣል፤</para>
  <para style="li1" vid="1CH 3:3">ጀአፋን ይትሬኣም ከን እን ኒቲሳ ኤግላራ ዸልቼዸ።<verse eid="1CH 3:3"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="4" style="v" sid="1CH 3:4"/>እሳን ጀኣን ኩኔን ወረ ዬሮ ዳዊት ኬብሮንት ወጋ ቶርባፊ ወለካ ሞቲ ቱሬት እሳፍ ዸለተኒዸ።</para>
  <para style="b" vid="1CH 3:4"/>
  <para style="b" vid="1CH 3:4"/>
  <para style="lh" vid="1CH 3:4">ዳዊት ዬሩሳሌምት ወጋ ሶዶሚ ሰዲ ሞቲ ተኤ ቡልቼ፤ <verse eid="1CH 3:4"/><verse number="5" style="v" sid="1CH 3:5"/>እጆሌን አችት እሳፍ ዸለተንስ ከኔኒዸ፦</para>
  <para style="b" vid="1CH 3:5"/>
  <para style="li1" vid="1CH 3:5">ሽሜኣ፣ ሾባብ፣ ናታኒፊ ሶሎሞን። እልማን አፍረን ኩኔን በትሼባ እንተለ አሚኤልራ ዸለተን።<verse eid="1CH 3:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 3:6"/>አከሱመስ እልማን ብራ ቀበ ቱሬ፤ እሳንስ፦ ይቤሃር፣ ኤሊሹዋ፣ ኤሊጴሌጥ፣ <verse eid="1CH 3:6"/><verse number="7" style="v" sid="1CH 3:7"/>ኖጋ፣ ኔፌግ፣ ያፊያ፣ <verse eid="1CH 3:7"/><verse number="8" style="v" sid="1CH 3:8"/>ኤሊሻማ፣ ኤልያዳፊ ኤሊጴሌጥ፤ እሳንስ ወሉመት እልማን ሰገል ቱረን።<verse eid="1CH 3:8"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="9" style="v" sid="1CH 3:9"/>እልማን ሳጀቶወንሳራ ዸለተኒን አለት እሳን ኩኔን እልማን ዳዊት ቱረን። ታማርሞ ኦቦሌቲሳኒ ቱርቴ።<verse eid="1CH 3:9"/></para>
  <para style="s2">ሞቶተ ይሁዳ</para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 3:10"/>እልም ሶሎሞን ሬሆቦኣም፤</para>
  <para style="li1" vid="1CH 3:10">እልም ሬሆቦኣም አብያዸ፤</para>
  <para style="li1" vid="1CH 3:10">እልም አብያ ኣሳዸ፤</para>
  <para style="li1" vid="1CH 3:10">እልም ኣሳ ዬሆሻፋጥ፤<verse eid="1CH 3:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 3:11"/>እልም ዬሆሻፋጥ ዬሆራም፤</para>
  <para style="li1" vid="1CH 3:11">እልም ዮራም አሃዝያ፤</para>
  <para style="li1" vid="1CH 3:11">እልም አሃዝያ ዮኣሽ፤<verse eid="1CH 3:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 3:12"/>እልም ዮኣሽ አመስያ፤</para>
  <para style="li1" vid="1CH 3:12">እልም አመስያ አዛርያ፤</para>
  <para style="li1" vid="1CH 3:12">እልም አዛርያ ዮታም፤<verse eid="1CH 3:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 3:13"/>እልም ዮታም ኣሃዝ፤</para>
  <para style="li1" vid="1CH 3:13">እልም ኣሃዝ ህስቅያስ፤</para>
  <para style="li1" vid="1CH 3:13">እልም ህስቅያስ ምናሴዸ፤<verse eid="1CH 3:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 3:14"/>እልም ምናሴ ኣሞን፤</para>
  <para style="li1" vid="1CH 3:14">እልምሳሞ ዮስያስ።<verse eid="1CH 3:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 3:15"/>እልማን ዮስያስ፦</para>
  <para style="li2" vid="1CH 3:15">እን ሀንገፍን ዮሃናን፣</para>
  <para style="li2" vid="1CH 3:15">ለመፋን ዬሆያቂም፣</para>
  <para style="li2" vid="1CH 3:15">ሰደፋን ዜዴቅያ፣</para>
  <para style="li2" vid="1CH 3:15">አፉረፋንሞ ሸሉም።<verse eid="1CH 3:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 3:16"/>እልማን ዬሆያቂም፦</para>
  <para style="li2" vid="1CH 3:16">እልመሳ ዬሆያኪኒፊ</para>
  <para style="li2" vid="1CH 3:16">እልመሳ ዜዴቅያ።<verse eid="1CH 3:16"/></para>
  <para style="s2">ህደ ዸሎተ ሞቶታ ከን ቦጁ ቦዴ ቱሬ</para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 3:17"/>እልማን ዬሆያኪን እሰ ቦጅአሜ ሰና፦</para>
  <para style="li2" vid="1CH 3:17">እልመሳ ሼአልቲኤል፣ <verse eid="1CH 3:17"/><verse number="18" style="v" sid="1CH 3:18"/>መልኪራም፣ ጴዳያ፣ ሼናጣር፣ ዬቀሜያ፣ ሆሻማፊ ኔዳብያ።<verse eid="1CH 3:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 3:19"/>እልማን ጴዳያ፦</para>
  <para style="li2" vid="1CH 3:19">ዘሩባቤሊፊ ሽሜኢ።</para>
  <para style="li1" vid="1CH 3:19">እልማን ዘሩባቤል፦</para>
  <para style="li2" vid="1CH 3:19">ሜሹላሚፊ ሀናንያ። ኦቦሌቲንሳኒሞ ሼሎሚት ጄዸምት። <verse eid="1CH 3:19"/><verse number="20" style="v" sid="1CH 3:20"/>አከሱመስ እጆሌ ገረ ብራ ሸንቱ ቱሬ፤ እሳንስ፦ ሀሹባ፣ ኦሄል፣ ቤሬክያ፣ ሀሰድያፊ ዮሸብ-ሄሴድ።<verse eid="1CH 3:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 3:21"/>እልማን ሀናንያ፦</para>
  <para style="li2" vid="1CH 3:21">ጴላትያፊ ዬሻያ፤ አከሱመስ እልማን ሬፋያ፣ እልማን አርናን፣ እልማን ኦባድያቲፊ እልማን ሼካንያ።<verse eid="1CH 3:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 3:22"/>እልማን ሼካንያ፦</para>
  <para style="li2" vid="1CH 3:22">ሼማእያፊ እልማንሳ፦ ሀጡሽ፣ ይግኣል፣ ባሪያህ፣ ነኣርያፊ ሻፋጥ፤ እሳን ወሉመት ጀአ ቱረን።<verse eid="1CH 3:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 3:23"/>እልማን ነኣርያ፦</para>
  <para style="li2" vid="1CH 3:23">ኤሊዮኤነይ፣ ህስቅያሲፊ አዝሪቃም፤ እሳን ወሉመት ሰዲ ቱረን።<verse eid="1CH 3:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 3:24"/>እልማን ኤሊዮኤነይ፦</para>
  <para style="li2" vid="1CH 3:24">ሆደይዋ፣ ኤልያሺብ፣ ጴላያ፣ አቁብ፣ ዮሃናን፣ ዴላያፊ አናኒ፤ እሳን ወሉመት ቶርበ ቱረን።<verse eid="1CH 3:24"/></para>
  <chapter eid="1CH 3"/>
  <chapter number="4" style="c" sid="1CH 4"/>
  <para style="s2">በልበለወን ይሁዳ ከኔን ብራ</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 4:1"/>እልማን ይሁዳ፦</para>
  <para style="li2" vid="1CH 4:1">ፋሬስ፣ ሄዝሮን፣ ከርሚ፣ ሁሪፊ ሶባል።<verse eid="1CH 4:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 4:2"/>ሬኣያን እልም ሶባል አባ የሃቲት፤ የሃትሞ አባ አሁማዪፊ ላሀዲት። እሳን ኩኔን በልበለወን ዞራቶታት።<verse eid="1CH 4:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 4:3"/>እልማን ኤጣም ከኔኒዸ፦</para>
  <para style="li2" vid="1CH 4:3">ይዝርኤል፣ ይሽማፊ ይድባሽ። ኦቦሌቲንሳኒሞ ሀዜሌልጶኒ ጄዸምት። <verse eid="1CH 4:3"/><verse number="4" style="v" sid="1CH 4:4"/>ጴኑኤል አባ ጌዶር፤ ኤዜርሞ አባ ሁሻም።</para>
  <para style="li1" vid="1CH 4:4">እሳን ኩኔን ሰኚ ሁር እልመ ኤፍራታ ሀንገፍትቻቲፊ አባ ቤትልሄም ሰናት።<verse eid="1CH 4:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 4:5"/>አሽሁር አባን ቴቆኣ ኒቶተ ለመ ከኔን ሄላፊ ነአራ ጄዸመን ቀበ ቱሬ።<verse eid="1CH 4:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 4:6"/>ነአራን እልማን አሁዛም፣ ሄፌር፣ ቴሜኒፊ ሃአሀሽታር ጄዸመን ዴሴፍ። እልማን ነአራ እሳን ከኔን ቱረን።<verse eid="1CH 4:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 4:7"/>እልማን ሄላ፦</para>
  <para style="li2" vid="1CH 4:7">ዜሬት፣ ዞሀሪፊ ኤትናን፤ <verse eid="1CH 4:7"/><verse number="8" style="v" sid="1CH 4:8"/>ቆስ አባ አኑብ፣ አባ ሀዞቤባፊ አባ በልበለወን አሀርሄል እልመ ሃሩምት።<verse eid="1CH 4:8"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="9" style="v" sid="1CH 4:9"/>ያቤጥ ነመ ኦቦሎተሳ ጫላ ኡልፍነ ቀቡ ቱሬ፤ ሃቲሳ፣ “አን ዽጵናነን እሰ ደኤ” ጄቴ ያቤጥ ጄቴ እሰ ሞጋፍቴ። <verse eid="1CH 4:9"/><verse number="10" style="v" sid="1CH 4:10"/>ያቤጥሞ አከነ ጄዼ ዋቀ እስራኤልት እየቴ፤ “አት ነ ኤብስ፤ ብየኮስ ናፍ በልእስ! አከ አን ህንሚዸምኔፊ አከ አን ዽጵነ ጀላ በኡፍ ሀርክኬ ነ ወጅን ሃጅራቱ።” ዋቅንስ ዋን እን ከዸቴ ሰነ ንኬኔፍ።<verse eid="1CH 4:10"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 4:11"/>ክሉብ ኦቦሌስ ሹሃ አባ ምሂሪት፤ ሜሂርሞ አባ ኤሽቶንት። <verse eid="1CH 4:11"/><verse number="12" style="v" sid="1CH 4:12"/>ኤሽቶንስ አባ ቤት ራፋን፣ አባ ፋሴሃፊ ቴሂናት፤ ተሂናንሞ አባ ኢር ናሃሺት። እሳን ኩኔን ነሞተ ሬካት።<verse eid="1CH 4:12"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 4:13"/>እልማን ቄነዝ፦</para>
  <para style="li2" vid="1CH 4:13">ኦኒኤሊፊ ሴራያ።</para>
  <para style="li1" vid="1CH 4:13">እልማን ኦትኒኤል፦</para>
  <para style="li2" vid="1CH 4:13">ሀታቲፊ መኦኖታይ። <verse eid="1CH 4:13"/><verse number="14" style="v" sid="1CH 4:14"/>ሜኦኖታይ አባ ኦፍራት።</para>
  <para style="li1" vid="1CH 4:14">ሴራያን አባ ዮኣቢት፤ ዮኣብሞ አባ ጌ ሀራሺሚት።</para>
  <para style="li2" vid="1CH 4:14">መቃን ኩን ሰበቢ እሳን ኦጉማ ሆጂ ሀርካ ቀበኒፍ ኬነሜፍ።<verse eid="1CH 4:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 4:15"/>እልማን ካሌብ እልመ ዬፉኔ፦</para>
  <para style="li2" vid="1CH 4:15">ኢሩ፣ ኤላፊ ነኣም።</para>
  <para style="li1" vid="1CH 4:15">እልም ኤላ፦</para>
  <para style="li2" vid="1CH 4:15">ቄነዝ።<verse eid="1CH 4:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 4:16"/>እልማን ዬሀሌልኤል፦</para>
  <para style="li2" vid="1CH 4:16">ዚፊ፣ ዚፋ፣ ቲርያፊ አሰሬል።<verse eid="1CH 4:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 4:17"/>እልማን እዝራ፦</para>
  <para style="li2" vid="1CH 4:17">ዬቴር፣ ሜሬድ፣ ኤፌሪፊ ያሎን።</para>
  <para style="li1" vid="1CH 4:17">ኒቶተ ሜሬድ ኬሳ እሼን ቶኮ ሚርያም፣ ሸማዪፊ ይሽባ አባ ኤሽትሞኣ ሰነ ዴሴ። <verse eid="1CH 4:17"/><verse number="18" style="v" sid="1CH 4:18"/>ኒቲንሳ ዱበርቲን ይሁዳ ሱንስ ያሬድ አባ ጌዶር፣ ሄቤር አባ ሶኮኒቲፊ ዬቁቲኤል አባ ዛኖኣ ዴሴ።</para>
  <para style="li1" vid="1CH 4:18">እሳን ኩኔን እጆሌ ብትያ እንተለ ፈረኦን ከን ሜሬድ ፉዼ ሰናት።<verse eid="1CH 4:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 4:19"/>እልማን ኒቲን ሆድያ ኦቦሌቲን ነሀም ሱን ዴሴ፦</para>
  <para style="li2" vid="1CH 4:19">አባ ቄዪላ ነምቸ ገርሚ ሰናቲፊ ኤሽትሞኣ ነምቸ መአካት።<verse eid="1CH 4:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 4:20"/>እልማን ስምኦን፦</para>
  <para style="li2" vid="1CH 4:20">አምኖን፣ ሪና፣ ቤን-ሃናኒፊ ቲሎን።</para>
  <para style="li1" vid="1CH 4:20">እልማን ይሽኢ፦</para>
  <para style="li2" vid="1CH 4:20">ዞሄቲፊ ቤን-ዞሄቲት።<verse eid="1CH 4:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 4:21"/>እልማን ሼላ እልመ ይሁዳ፦</para>
  <para style="li2" vid="1CH 4:21">ኤር አባ ሌካ፣ ለአዳ አባ ማሬሻቲፊ በልበለወን ቤት አሽቤኣት ወረ ወያ ቁንጬ ተልባ ሀጲ ሆጄተኒ።<verse eid="1CH 4:21"/></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 4:22"/>ዮቂም፣ ነሞተ ኮዜባ፣ ዮኣሺፊ ሳራፍ እሰ ሞኣቢፊ ያሹቢሌሄም ቡልቹ። በሬፈምን ኩኔንስ ከን በረ ዱሪት። <verse eid="1CH 4:22"/><verse number="23" style="v" sid="1CH 4:23"/>እሳንስ ሱጴ ዾፍቱ ኔጣዪሚፊ ጌዴራ ኬሰ ጅራተን ቱረን፤ ጀር ኩን ሞትቻፍ ሆጄቻ አች ጅራቱ ቱሬ።<verse eid="1CH 4:23"/></para>
  <para style="s1">ስምኦን</para>
  <para style="r">
    <ref loc="1CH 4:28-33">4፥28‑33</ref> ኩወፈ – <char style="xt"><ref loc="JOS 19:2-10">እያ 19፥2‑10</ref></char></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 4:24"/>እልማን ስምኦን፦</para>
  <para style="li2" vid="1CH 4:24">ኔሙኤል፣ ያሚን፣ ያሪብ፣ ዜራፊ ሻዉል፤<verse eid="1CH 4:24"/></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 4:25"/>ሸሉም እልመ ሳኡል ቱሬ፤ ምብሳም እልመ ሸሉምት፤ ምሽማሞ እልመ መብሳምት።<verse eid="1CH 4:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 4:26"/>እልማን ምሽማ፦</para>
  <para style="li2" vid="1CH 4:26">እልመሳ ሀሙኤል፣ እልመሳ ዘኩሪፊ እልመሳ ሽሜኢ።<verse eid="1CH 4:26"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="27" style="v" sid="1CH 4:27"/>ሽሜኢን እልማን ኩዸ ጀኣፊ እንተለን ጀአ ቀበ ቱሬ፤ ኦቦሎትንሳ ገሩ እጆሌ ሄዱ ህንቀበን ቱሬ፤ ሰበቢ ከናፍ በልበለወንሳኒ ሁንድኑ አከ ጎሰ ይሁዳ ባይኤ ህንቱሬ። <verse eid="1CH 4:27"/><verse number="28" style="v" sid="1CH 4:28"/>እሳንስ ቤርሼባ፣ ሞላዳ፣ ሀዘር ሹኣል፣ <verse eid="1CH 4:28"/><verse number="29" style="v" sid="1CH 4:29"/>ብልሃ፣ ኤዜም፣ ቶላድ፣ <verse eid="1CH 4:29"/><verse number="30" style="v" sid="1CH 4:30"/>ቤቱኤል፣ ሆርማ፣ ሲቅላግ፣ <verse eid="1CH 4:30"/><verse number="31" style="v" sid="1CH 4:31"/>ቤት መርካቦት፣ ሀዘር ሱሲም፣ ቤት ቢሪፊ ሸአረዪም ኬሰ ጅራተን። መጋላወን ኩኔን ሀመ በረ ሞቱማ ዳዊቲት መጋላወንሳኒ ቱረን። <verse eid="1CH 4:31"/><verse number="32" style="v" sid="1CH 4:32"/>አከሱመስ ገንዶተ ኤጣም፣ አይን፣ ሬሞን፣ ቶኬኒፊ አሻን ጄቹንስ መጋላ ሸነኒፊ <verse eid="1CH 4:32"/><verse number="33" style="v" sid="1CH 4:33"/>ገንዶተ ናኖሳኒት አርገመን ሁንደ ኬሰ ሀመ በኣሊት ጅራቱ ቱሬ።</para>
  <para style="b" vid="1CH 4:33"/>
  <para style="lh" vid="1CH 4:33">ኩኔን እዶ እሳን ጅራተኒዸ። እሳንስ ገልሜ ህደ ዸሎተሳኒ ካወተኒ ጅረን።<verse eid="1CH 4:33"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 4:34"/>ሜሾባብ፣ የምሌክ፣</para>
  <para style="li1" vid="1CH 4:34">ዮሻ እልመ አመስያ፣ <verse eid="1CH 4:34"/><verse number="35" style="v" sid="1CH 4:35"/>ዮኤል፣</para>
  <para style="li1" vid="1CH 4:35">ዬሁ እልመ ዮሽብያ፣ እልመ ሴራያ፣ እልመ አሲኤል፣<verse eid="1CH 4:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 4:36"/>አከሱመስ ኤሊዮኤነይ፣ ያእቆባ፣ የሾሀያ፣</para>
  <para style="li1" vid="1CH 4:36">አሳያ፣ ኣዲኤል፣ ዬሲምኤል፣ ቤናያ፣<verse eid="1CH 4:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 4:37"/>ዚዛ እልመ ሺፊ፣ እልመ አሎን፣ እልመ ዬዳያ፣ እልመ ሽምሪ፣ እልመ ሼማእያ።<verse eid="1CH 4:37"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="38" style="v" sid="1CH 4:38"/>ነሞትን መቃንሳኒ ከና ኦልት ህመሜ ኩኔን ሆገንቶተ በልበለሳኒ ቱረን።</para>
  <para style="b" vid="1CH 4:38"/>
  <para style="p" vid="1CH 4:38">ባይእን ማቲሳኒስ አከ መሌ ደበላ ዹፌ፤ <verse eid="1CH 4:38"/><verse number="39" style="v" sid="1CH 4:39"/>እሳንስ ቡሻዬሳኒቲፍ ለፈ ዼዳ በርባቸ ሀመ ሞጋ ጌዶር ከን ገመ በአ ሱሉላ ጅሩ ሰናት ዴመን። <verse eid="1CH 4:39"/><verse number="40" style="v" sid="1CH 4:40"/>እሳንስ ናኖ ሰነት ለፈ ዼዳ ገበታፊ ጋሪ አርገተን፤ ለፍን ሱንስ በልኣ፣ ከን ነጋፊ ተስገቢ ቀቡ ቱሬ። በረ ዱሪ ጎሶትን ሃሚ ናኖ ሰነ ጅራቻ ቱረን።<verse eid="1CH 4:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="1CH 4:41"/>ነሞትን መቃንሳኒ ዸአሜ ኩኔን በረ ህስቅያስ ሞቲ ይሁዳ ቱሬ ኬሰ ዹፈን። እሳን አኩመ ሀመ ሀርኣትሌ ሙልአቱ ቁበተ ካሞታቲፊ ሜኡኖተ አች ጅራቻ ቱረኒ ዸአኒ ጉቱማን ጉቱት እሳን በርበዴሰን። ኤርገሲስ ሰበቢ ለፈ ዼዳ በልኣ ቡሻዬሳኒቲፍ አርገተኒፍ ለፈ ጀራረ ንቁበተን። <verse eid="1CH 4:41"/><verse number="42" style="v" sid="1CH 4:42"/>ስምኦኖተ ከኔን ኬሳ ነሞትን ዽበ ሸን እልማን ይሽኢ ጴላትያ፣ ነኣርያ፣ ሬፋያፊ ኡዚኤል ሆገነመኒ ብየ ጋራ ሴኢር ዌረረን። <verse eid="1CH 4:42"/><verse number="43" style="v" sid="1CH 4:43"/>እሳንስ አማሌቆተ ምልቀኒ ሀፈን በሌሰኒ ሀመ ሀርኣት አቹመ ጅራተን።<verse eid="1CH 4:43"/></para>
  <chapter eid="1CH 4"/>
  <chapter number="5" style="c" sid="1CH 5"/>
  <para style="s1">ሩቤን</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 5:1"/>ሩቤን እስራኤሊፍ እልመ ሀንገፈ ቱሬ፤ ተኡስ ሰበቢ እን ስሬ አባሳ ጡሬሴፍ ምርግ ሀንገፉማሳ እልማን ዮሴፍ እልመ እስራኤል ሰናቲፍ ኬነሜ። ከናፉ እን አከ ምርገሳ ከን ዸሎታን አርገሙት ህደ ዸሎታ ኬሰት ህንገልሜፈምኔ፤ <verse eid="1CH 5:1"/><verse number="2" style="v" sid="1CH 5:2"/>ይሁዳን ኦቦሎተሳ ኬሰ ነመ ጀባፊ ከን ሞቱማን እሰ ኬሳ በኤ ተኡሌ ምርግ ሀንገፉማ ከን ዮሴፊት። <verse eid="1CH 5:2"/><verse number="3" style="v" sid="1CH 5:3"/>እልማን ሩቤን እልመ እስራኤል ሀንገፍትቻ፦</para>
  <para style="li2" vid="1CH 5:3">ሄኖክ፣ ፈሉሶ፣ ሄዝሮኒፊ ከርሚ።<verse eid="1CH 5:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 5:4"/>እልማን ዮኤል፦</para>
  <para style="li2" vid="1CH 5:4">ሼማእያ እልመሳ፣ ጎግ እልመሳ፣</para>
  <para style="li2" vid="1CH 5:4">ሽሜኢ እልመሳ፣ <verse eid="1CH 5:4"/><verse number="5" style="v" sid="1CH 5:5"/>ሚካ እልመሳ፣</para>
  <para style="li2" vid="1CH 5:5">ሬኣያ እልመሳ፣ በኣል እልመሳቲፊ<verse eid="1CH 5:5"/></para>
  <para style="li2">
    <verse number="6" style="v" sid="1CH 5:6"/>ብኤራ እልመሳ ከን ሞቲን አሶር ቲግላት-ጵልኔሴር ቦጅኤ ፉዸቴዸ። ቤኤራን ሆገና ጎሰ ሩቤን ቱሬ።<verse eid="1CH 5:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 5:7"/>ፍሮንሳኒ ወር አኩመ ህደ ዸሎተሳኒት በልበለ በልበላን ገልሜፈመን ከኔኒዸ፦</para>
  <para style="li2" vid="1CH 5:7">ዬኢኤል ሀንገፍትቸ፣ ዘካርያስ፣ <verse eid="1CH 5:7"/><verse number="8" style="v" sid="1CH 5:8"/>ቤላ እልመ ኣዛዝ፣ እልመ ሼማ፣ እልመ ዮኤል።</para>
  <para style="b" vid="1CH 5:8"/>
  <para style="p" vid="1CH 5:8">እሳንስ ናኖ አሮኤር ጀልቀቤ ሀመ ኔቦፊ በኣል ሜኦኒት ጅሩ ኬሰ ቁበተን። <verse eid="1CH 5:8"/><verse number="9" style="v" sid="1CH 5:9"/>እሳንስ ሰበቢ ሆሪንሳኒ ግልኣድ ኬሰት ባይአቴፍ ከራ በአ ቢፍቱቲን ሀመ ዳሪ ገሞጂ ከን ገረ ለገ ኤፍራጢስት በልአቱ ሰናት ብየቲ ቀበተን።<verse eid="1CH 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 5:10"/>እሳን ጀበነ ሳኦል ኬሰ አጋሪት ወራነ ካሰን፤ ጀርስ ሀርከ እሳኒት ሞአተመን፤ እሳንስ እዶ ጅሬኛ ወረ አጋር ከን ግልኣዲን ገመ በአ ቢፍቱ ጅሩ ጉቱማን ጉቱት ቀበተን።<verse eid="1CH 5:10"/></para>
  <para style="s1">ጋድ</para>
  <para style="lh">
    <verse number="11" style="v" sid="1CH 5:11"/>ጎሶትን ጋድ እሳንት ኣነኒ ባሻን ኬሰ ለፈ ሀመ ሰልካት አርገሙረ ጅራተን፤ እሳንስ፦<verse eid="1CH 5:11"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 5:12"/>ዮኤል ሀንገፍትች፣ ሻፋም እት ኣናንሳ፣ የእነዪፊ ሻፋጥ ባሻን ኬሰ ጅራተን።<verse eid="1CH 5:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 5:13"/>ፍሮንሳኒ ማቲ ማቲዻን ከኔኒዸ፦</para>
  <para style="li2" vid="1CH 5:13">ሚካኤል፣ ሜሹላም፣ ሼባ፣ ዮራይ፣ ያካን፣ ዚኣፊ ኤቤር፤ ወሉማ ገለት ቶርበ ቱረን።<verse eid="1CH 5:13"/></para>
  <para style="li2">
    <verse number="14" style="v" sid="1CH 5:14"/>እሳን ኩኔንሞ እልማን አቢሃይል እልመ ሁር፣ እልመ ያሮካ፣ እልመ ግልኣድ፣ እልመ ሚካኤል፣ እልመ ዬሺሻይ፣ እልመ የኬዶ፣ እልመ ቡዚት።<verse eid="1CH 5:14"/></para>
  <para style="li2">
    <verse number="15" style="v" sid="1CH 5:15"/>አሂን እልም አብድኤል፣ ሀንገፈ ማቲሳኒ ቱሬ፤ አብድኤልሞ እልመ ጉኒት።<verse eid="1CH 5:15"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="16" style="v" sid="1CH 5:16"/>ወር ጋድ ግልኣድ ኬሰ፣ ባሻኒፊ ገንዶተ ዳሪ እሼት አርገመን፣ አከሱመስ ለፈ ትካ ከን ሻሮን ኬሰት አርገመን ሁንዳፊ ቀርቀረሳ ጅራተን።<verse eid="1CH 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 5:17"/>እሳን ኩኔን ሁንድ ጀበነ ዮታም ሞቲ ይሁዳ ቱሬፊ ጀበነ ዬሮብኣም ሞቲ እስራኤል ቱሬ ኬሰ ገልሜ ህደ ዸሎታ ኬሰት ገልሜፈመን።<verse eid="1CH 5:17"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="18" style="v" sid="1CH 5:18"/>ሩቤኖትን፣ ጋዶትኒፊ ወለካን ጎሰ ምናሴ ነሞተ ደንዴቲ ሎላ ቀበን 44,760 ቀበን ቱሬ፤ እሳንስ ነሞተ ጀጀቦ ወረ ጋቸናፊ ጎራዴ ቀበቹ ደንደአን፣ ወረ ጥየ ደርበቹ ደንደአኒፊ ወረ ወራናፍ ሌንጅፈመን ቱረን። <verse eid="1CH 5:18"/><verse number="19" style="v" sid="1CH 5:19"/>ጀር ኩንስ ወረ አጋሪት፣ ወረ ዬጡርት፣ ናፊሺቲፊ ኖዳቢት ወራነ ንበነን። <verse eid="1CH 5:19"/><verse number="20" style="v" sid="1CH 5:20"/>ሰበቢ እሳን ወራነ ሰነረት ገረ ዋቃት እየተኒ ቱረኒፍ ዋቅን እሳን ገርጋሬ ወረ አጋሪቲፊ ገሬሳኒ ሁንደ ደበርሴ ሀርከሳኒት ኬኔ። እንስ ሰበቢ እሳን እሰ አመነተኒፍ ከዸትናሳኒቲፍ ዴቢ ኬኔ። <verse eid="1CH 5:20"/><verse number="21" style="v" sid="1CH 5:21"/>እሳንስ ሆሪ ወረ አጋር ጋለ ኩመ ሸን፣ ሆላ ኩመ ዽበ ለማፊ ሸንተማፊ ሀሬ ኩመ ለመ ሳመን። አከሱመስ ነመ ኩመ ዽበ ቶኮ ቦጅአን፤ <verse eid="1CH 5:21"/><verse number="22" style="v" sid="1CH 5:22"/>ሰበቢ ሎል ሱን ከን ዋቃ ቱሬፍ ነሞትን ብራ ባይኤን ንአጄፈመን። እሳንስ ሀመ በረ ቦጁት ብየ ሰነ ኬሰ ንጅራተን።<verse eid="1CH 5:22"/></para>
  <para style="s1">ወለካ ጎሰ ምናሴ</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 5:23"/>ወለካን ጎሰ ምናሴ ባይኤ ቱረን፤ እሳንስ ባሻኒ ጀልቀበኒ ሀመ በኣል ሄርሞኒት፣ ሀመ ሴኒር ቱሉ ሄርሞንት ብየ ሰነ ኬሰ ቁበተን።<verse eid="1CH 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 5:24"/>እሳን ኩኔን ሀንገፎተ ማቲሳኒት፦ ኤፌር፣ ይሽኢ፣ ኤሊኤል፣ አዝሪኤል፣ ኤርምያስ፣ ሆደይዋፊ የዲኤል። እሳን ኩኔን ሎልቶተ ጎቶተ፣ ነሞተ ቤቤከሞፊ ሀንገፎተ ማቲሳኒት። <verse eid="1CH 5:24"/><verse number="25" style="v" sid="1CH 5:25"/>እሳን ገሩ ዋቀ አቦቲሳኒቲፍ አመነሙ ድደኒ ዋቆተ ሰቦተ ብየቲ ወጅን ሰጋገለን፤ ሰቦትን ኩኔንስ ወረ ዋቅን ፉለሳኒ ዱራ በሌሴዸ። <verse eid="1CH 5:25"/><verse number="26" style="v" sid="1CH 5:26"/>ከናፉ ዋቅን እስራኤል ሀፉረ ፎሃ ሞትቸ አሶር ጄቹንስ ሀፉረ ጱል ከካሴ አከ እን ጎሶተ ሩቤን፣ ከን ጋዲቲፊ ወለካ ጎሰ ምናሴ ቦጅኡ ጎዼ። እንስ ወረ ከኔን ገረ ሀላ፣ ሃቦር፣ ሃራቲፊ ገረ ቀርቀረ ለገ ጎዛኒት ጌሴ፤ እሳንስ ሀመ ሀርኣት አቹመ ጅራተን።<verse eid="1CH 5:26"/></para>
  <chapter eid="1CH 5"/>
  <chapter number="6" style="c" sid="1CH 6"/>
  <para style="s1">ሌዊ</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 6:1"/>እልማን ሌዊ፦</para>
  <para style="li2" vid="1CH 6:1">ጌርሾን፣ ቆሃቲፊ ሜራር።<verse eid="1CH 6:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 6:2"/>እልማን ቆሃት፦</para>
  <para style="li2" vid="1CH 6:2">አምራም፣ ይዝሃር፣ ኬብሮኒፊ ኡዚኤል።<verse eid="1CH 6:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 6:3"/>እጆሌን አምራም፦</para>
  <para style="li2" vid="1CH 6:3">አሮን፣ ሙሴፊ ሚርያም።</para>
  <para style="li1" vid="1CH 6:3">እልማን አሮን፦</para>
  <para style="li2" vid="1CH 6:3">ናዳብ፣ አቢሁ፣ ኤሌኣዛሪፊ ኢታማር።<verse eid="1CH 6:3"/></para>
  <para style="li2">
    <verse number="4" style="v" sid="1CH 6:4"/>ኤሌኣዛር አባ ፊኔሃስ፤</para>
  <para style="li2" vid="1CH 6:4">ፊኔሃስሞ አባ አቢሹዋት፤<verse eid="1CH 6:4"/></para>
  <para style="li2">
    <verse number="5" style="v" sid="1CH 6:5"/>አቢሹዋን አባ ቡኪት፤</para>
  <para style="li2" vid="1CH 6:5">ቡኪንሞ አባ ኡዚት፤<verse eid="1CH 6:5"/></para>
  <para style="li2">
    <verse number="6" style="v" sid="1CH 6:6"/>ኡዚ አባ ዜራያት፤</para>
  <para style="li2" vid="1CH 6:6">ዘራእያን አባ ሜራዮቲት፤<verse eid="1CH 6:6"/></para>
  <para style="li2">
    <verse number="7" style="v" sid="1CH 6:7"/>ሜራዮት አባ አመርያት፤</para>
  <para style="li2" vid="1CH 6:7">አመርያን አባ አሂጡቢት፤<verse eid="1CH 6:7"/></para>
  <para style="li2">
    <verse number="8" style="v" sid="1CH 6:8"/>አሂጡብ አባ ዛዶቂት፤</para>
  <para style="li2" vid="1CH 6:8">ዛዶቅ አባ አሂመአዚት፤<verse eid="1CH 6:8"/></para>
  <para style="li2">
    <verse number="9" style="v" sid="1CH 6:9"/>አሂመአዝ አባ አዛርያት፤</para>
  <para style="li2" vid="1CH 6:9">አዛርያ አባ ዮሃናኒት፤<verse eid="1CH 6:9"/></para>
  <para style="li2">
    <verse number="10" style="v" sid="1CH 6:10"/>ዮሃናን አባ አዛርያት፤</para>
  <para style="li2" vid="1CH 6:10">እን ሉበ ተኤ መነ ቁልቁሉማ ከን ሶሎሞን ዬሩሳሌምት እጃሬ ኬሰ ተጃጅላ ቱሬ።<verse eid="1CH 6:10"/></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 6:11"/>አዛርያ አባ አመርያት፤</para>
  <para style="li2" vid="1CH 6:11">አመርያን አባ አሂጡቢት፤<verse eid="1CH 6:11"/></para>
  <para style="li2">
    <verse number="12" style="v" sid="1CH 6:12"/>አሂጡብ አባ ዛዶቂት፤</para>
  <para style="li2" vid="1CH 6:12">ዛዶቅ አባ ሸሉሚት፤<verse eid="1CH 6:12"/></para>
  <para style="li2">
    <verse number="13" style="v" sid="1CH 6:13"/>ሸሉም አባ ህልቅያት፤</para>
  <para style="li2" vid="1CH 6:13">ህልቅያ አባ አዛርያት፤<verse eid="1CH 6:13"/></para>
  <para style="li2">
    <verse number="14" style="v" sid="1CH 6:14"/>አዛርያ አባ ሴራያት፤</para>
  <para style="li2" vid="1CH 6:14">ሴራያን አባ ዬሆዛዳቂት።<verse eid="1CH 6:14"/></para>
  <para style="li2">
    <verse number="15" style="v" sid="1CH 6:15"/>ዬሮ <char style="nd">ዋቀዮ</char> አከ ሰብን ይሁዳቲፊ ዬሩሳሌም ኔቡከድኔዘሪን ቦጅአሙ ጎዼት ዬሆዛዳቅስ ቦጅአሜ ፉዸተሜ።<verse eid="1CH 6:15"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 6:16"/>እልማን ሌዊ፦</para>
  <para style="li2" vid="1CH 6:16">ጌርሾም፣ ቆሃቲፊ ሜራሪ።<verse eid="1CH 6:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 6:17"/>መቃን እልማን ጌርሾም ከናዸ፦</para>
  <para style="li2" vid="1CH 6:17">ሎቤኒፊ ሽሜኢ።<verse eid="1CH 6:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 6:18"/>እልማን ቆሃት፦</para>
  <para style="li2" vid="1CH 6:18">አምራም፣ ይዝሃር፣ ኬብሮኒፊ ኡዚኤል።<verse eid="1CH 6:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 6:19"/>እልማን ሜራሪ፦</para>
  <para style="li2" vid="1CH 6:19">መህሊፊ ሙሲ።</para>
  <para style="b" vid="1CH 6:19"/>
  <para style="lh" vid="1CH 6:19">እሳን ኩኔን ሌዎተ በልበለ በልበለ አቦቲሳኒቲን ለካአመኒዸ፦<verse eid="1CH 6:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 6:20"/>በልበለ ጌርሾም ኬሳ፦</para>
  <para style="li2" vid="1CH 6:20">እልመሳ ሎቤን፣ እልመሳ የሃት፣</para>
  <para style="li2" vid="1CH 6:20">እልመሳ ዝማት፣ <verse eid="1CH 6:20"/><verse number="21" style="v" sid="1CH 6:21"/>እልመሳ ዮኣ፣</para>
  <para style="li2" vid="1CH 6:21">እልመሳ እዶ፣ እልመሳ ዜራፊ</para>
  <para style="li2" vid="1CH 6:21">እልመሳ ዬኣቴራይ።<verse eid="1CH 6:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 6:22"/>እልማን ቆሃት፦</para>
  <para style="li2" vid="1CH 6:22">እልመሳ አሚናዳብ፣ እልመሳ ቆራህ፣</para>
  <para style="li2" vid="1CH 6:22">እልመሳ አሲር፣ <verse eid="1CH 6:22"/><verse number="23" style="v" sid="1CH 6:23"/>እልመሳ ኤልቃና፣</para>
  <para style="li2" vid="1CH 6:23">እልመሳ ኤብያሳፍ፣ እልመሳ አሲር፣<verse eid="1CH 6:23"/></para>
  <para style="li2">
    <verse number="24" style="v" sid="1CH 6:24"/>እልመሳ ተሃት፣ እልመሳ ኡሪኤል፣</para>
  <para style="li2" vid="1CH 6:24">እልመሳ ኡዝያፊ እልመሳ ሻዉል።<verse eid="1CH 6:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 6:25"/>እልማን ኤልቃና፦</para>
  <para style="li2" vid="1CH 6:25">አማሳይ፣ አሂሞት፣<verse eid="1CH 6:25"/></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 6:26"/>እልመሳ ኤልቃና፣ እልመሳ ዞፈይ፣</para>
  <para style="li2" vid="1CH 6:26">እልመሳ ናሀት፣ <verse eid="1CH 6:26"/><verse number="27" style="v" sid="1CH 6:27"/>እልመሳ ኤሊያብ፣</para>
  <para style="li2" vid="1CH 6:27">እልመሳ ዬሮሃም፣ እልመሳ ኤልቃናፊ</para>
  <para style="li2" vid="1CH 6:27">እልመሳ ሳሙኤል።<verse eid="1CH 6:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 6:28"/>እልማን ሳሙኤል፦</para>
  <para style="li2" vid="1CH 6:28">እልመሳ ዮኤል ሀንገፍትቻፊ</para>
  <para style="li2" vid="1CH 6:28">እልመሳ ለመፋ አብያ።<verse eid="1CH 6:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 6:29"/>እልማን ሜራሪ፦</para>
  <para style="li2" vid="1CH 6:29">መህሊ፣ እልመሳ ሎቤን፣</para>
  <para style="li2" vid="1CH 6:29">እልመሳ ሽሜኢ፣ እልመሳ ኡዛ፣<verse eid="1CH 6:29"/></para>
  <para style="li2">
    <verse number="30" style="v" sid="1CH 6:30"/>እልመሳ ሽሜኣ፣ እልመሳ ሀግያፊ</para>
  <para style="li2" vid="1CH 6:30">እልመሳ አሳያ።<verse eid="1CH 6:30"/></para>
  <para style="s2">ፋርፈቶተ መነ ቁልቁሉማ</para>
  <para style="r">
    <ref loc="1CH 6:54-80">6፥54‑80</ref> ኩወፈ – <char style="xt"><ref loc="JOS 21:4-39">እያ 21፥4‑39</ref></char></para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 6:31"/>ነሞትን ኤርገ ታቦትን ዹፌ አች ቦቆቴ ቦዴ ዳዊት አከ እሳን ፋርፈናዻን መነ <char style="nd">ዋቀዮ</char> ኬሰ ተጃጅለኒፍ ሙዴ ከኔኒዸ። <verse eid="1CH 6:31"/><verse number="32" style="v" sid="1CH 6:32"/>እሳንስ ሀመ ሶሎሞን ዬሩሳሌም ኬሰት መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> እጃሬት ዱንካነ ቁልቁሉ፣ ዱንካነ ወል ገኢ ዱረት ፋርፈናዻን ተጃጅላ ቱረን። እሳንስ አኩመ ሴረሳኒፍ ኬነሜ ሰናት ሆጂሳኒ ሆጄቻ ቱረን።<verse eid="1CH 6:32"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="33" style="v" sid="1CH 6:33"/>መቃን ነሞተ እልማንሳኒ ወጅን ተጃጅለኒ ከኔኒዸ፦</para>
  <para style="b" vid="1CH 6:33"/>
  <para style="li1" vid="1CH 6:33">እልማን ቆሃቶታ ኬሳ፦</para>
  <para style="li2" vid="1CH 6:33">ሄማን ፋርፈታ፣</para>
  <para style="li2" vid="1CH 6:33">እልመ ዮኤል፣ እልመ ሳሙኤል፣<verse eid="1CH 6:33"/></para>
  <para style="li2">
    <verse number="34" style="v" sid="1CH 6:34"/>እልመ ኤልቃና፣ እልመ ዬሮሃም፣</para>
  <para style="li2" vid="1CH 6:34">እልመ ኤሊኤል፣ እልመ ቶኣ፣<verse eid="1CH 6:34"/></para>
  <para style="li2">
    <verse number="35" style="v" sid="1CH 6:35"/>እልመ ዙፍ፣ እልመ ኤልቃና፣</para>
  <para style="li2" vid="1CH 6:35">እልመ መሀት፣ እልመ አማሳይ፣<verse eid="1CH 6:35"/></para>
  <para style="li2">
    <verse number="36" style="v" sid="1CH 6:36"/>እልመ ኤልቃና፣ እልመ ዮኤል፣</para>
  <para style="li2" vid="1CH 6:36">እልመ አዛርያ፣ እልመ ሴፋንያ፣<verse eid="1CH 6:36"/></para>
  <para style="li2">
    <verse number="37" style="v" sid="1CH 6:37"/>እልመ ተሃት፣ እልመ አሲር፣</para>
  <para style="li2" vid="1CH 6:37">እልመ ኤብያሳፍ፣ እልመ ቆራህ፣<verse eid="1CH 6:37"/></para>
  <para style="li2">
    <verse number="38" style="v" sid="1CH 6:38"/>እልመ ይዝሃር፣ እልመ ቆሃት፣</para>
  <para style="li2" vid="1CH 6:38">እልመ ሌዊ፣ እልመ እስራኤል፤<verse eid="1CH 6:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 6:39"/>አከሱመስ አሳፍ ኦቦሌስ ሄማን ከራ ምርጋቲን ዻበተ ቱሬ፦</para>
  <para style="li2" vid="1CH 6:39">አሳፍ እልመ ቤሬክያ፣ እልመ ሽሜኣ፣<verse eid="1CH 6:39"/></para>
  <para style="li2">
    <verse number="40" style="v" sid="1CH 6:40"/>እልመ ሚካኤል፣ እልመ በአሴያ፣</para>
  <para style="li2" vid="1CH 6:40">እልመ መልክያ፣ <verse eid="1CH 6:40"/><verse number="41" style="v" sid="1CH 6:41"/>እልመ ኤትኒ፣</para>
  <para style="li2" vid="1CH 6:41">እልመ ዜራ፣ እልመ አዳያ፣<verse eid="1CH 6:41"/></para>
  <para style="li2">
    <verse number="42" style="v" sid="1CH 6:42"/>እልመ ኤታን፣ እልመ ዝማ፣</para>
  <para style="li2" vid="1CH 6:42">እልመ ሽሜኢ፣ <verse eid="1CH 6:42"/><verse number="43" style="v" sid="1CH 6:43"/>እልመ የሃት፣</para>
  <para style="li2" vid="1CH 6:43">እልመ ጌርሾም፣ እልመ ሌዊ፤<verse eid="1CH 6:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 6:44"/>ከራ ብታሳቲንሞ ወር እሳን ወጅን ቱረን ጎሰ ሜራሪ ኬሳ፦</para>
  <para style="li2" vid="1CH 6:44">ኤታን እልመ ቂሳ፣ እልመ አብዲ፣</para>
  <para style="li2" vid="1CH 6:44">እልመ መሉክ፣ <verse eid="1CH 6:44"/><verse number="45" style="v" sid="1CH 6:45"/>እልመ ሀሸብያ፣</para>
  <para style="li2" vid="1CH 6:45">እልመ አመስያ፣ እልመ ህልቅያ፣<verse eid="1CH 6:45"/></para>
  <para style="li2">
    <verse number="46" style="v" sid="1CH 6:46"/>እልመ አምዚ፣ እልመ ባኒ፣</para>
  <para style="li2" vid="1CH 6:46">እልመ ሼሜር፣ <verse eid="1CH 6:46"/><verse number="47" style="v" sid="1CH 6:47"/>እልመ መህሊ፣</para>
  <para style="li2" vid="1CH 6:47">እልመ ሙሲ፣ እልመ ሜራሪ፣</para>
  <para style="li2" vid="1CH 6:47">እልመ ሌዊ።<verse eid="1CH 6:47"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="48" style="v" sid="1CH 6:48"/>ኦቦሎትንሳኒ ሌዎትን አከ ሆጂ ዱንካነ ቁልቁሉ መነ ዋቃ ሁንደ ሆጄተኒፍ ረመደመኒ ቱረን። <verse eid="1CH 6:48"/><verse number="49" style="v" sid="1CH 6:49"/>አሮኒፊ እልማንሳ ገሩ አኩመ ዋን ሙሴን ገርብች ዋቃ ሱን አጀጄ ቱሬ ሁንዳት ሆጂ እዶ እዶ ሁንደ ጫላ ቁልቁሉ ተኤ ሰናቲፍ፣ ሰበቢ እስራኤሊቲፍስ አራረ ቡሱዻፍ እዶ ኣርሳ ከን ኣርሳ ጉበሙቲፊ እዶ ኣርሳ እጣናረት ኣርሳወን ዽኤሳ ቱረን።<verse eid="1CH 6:49"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="50" style="v" sid="1CH 6:50"/>እልማን አሮን ከኔኒዸ፦</para>
  <para style="li2" vid="1CH 6:50">እልመሳ ኤሌኣዛር፣ እልመሳ ፊኔሃስ፣</para>
  <para style="li2" vid="1CH 6:50">እልመሳ አቢሹዋ፣ <verse eid="1CH 6:50"/><verse number="51" style="v" sid="1CH 6:51"/>እልመሳ ቡኪ፣</para>
  <para style="li2" vid="1CH 6:51">እልመሳ ኡዚ፣ እልመሳ ዜራያ፣<verse eid="1CH 6:51"/></para>
  <para style="li2">
    <verse number="52" style="v" sid="1CH 6:52"/>እልመሳ ሜራዮት፣ እልመሳ አመርያ፣</para>
  <para style="li2" vid="1CH 6:52">እልመሳ አሂጡብ፣ <verse eid="1CH 6:52"/><verse number="53" style="v" sid="1CH 6:53"/>እልመሳ ዛዶቂፊ</para>
  <para style="li2" vid="1CH 6:53">እልመሳ አሂመአዝ።<verse eid="1CH 6:53"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="54" style="v" sid="1CH 6:54"/>ሰበቢ እጣን ጀልቀባ እሳኒፍ በኤፍ እዶወን ኩኔን አሮኒፊ እልማንሳ ከኔን በልበለ ቆሃት ኬሳ ዹፈኒፍ ንኬነመን፤ እዶወን ቁበተሳኒ ከኔን አከ ብየሳኒ ተአኒፍ እሳኒፍ ረመደመኒዸ፦<verse eid="1CH 6:54"/></para>
  <para style="li1">
    <verse number="55" style="v" sid="1CH 6:55"/>ኬብሮን እሼን ብየ ይሁዳ ኬሳቲፊ ለፍት ዼዳ ከን ናኖሼት አርገምቱ እሳኒፍ ንኬነመን። <verse eid="1CH 6:55"/><verse number="56" style="v" sid="1CH 6:56"/>ለፍት ቆቲሳቲፊ ገንዶትን ናኖ ኬብሮኒት አርገመን ገሩ ካሌብ እልመ ዬፉኔቲፍ ንኬነመን። <verse eid="1CH 6:56"/><verse number="57" style="v" sid="1CH 6:57"/>እልማን አሮኒፍሞ መጋላወን እት በቀተን ኬብሮን፣ ልብና፣ የቲር፣ ኤሽትሞኣ፣ <verse eid="1CH 6:57"/><verse number="58" style="v" sid="1CH 6:58"/>ሂሌን፣ ዴቢር፣ <verse eid="1CH 6:58"/><verse number="59" style="v" sid="1CH 6:59"/>አሻን፣ ዮታፊ ቤት ሼሜሽቱ ለፈ ዼደሳኒ ወጅን ኬነሜ።<verse eid="1CH 6:59"/></para>
  <para style="li1">
    <verse number="60" style="v" sid="1CH 6:60"/>ቆደ ጎሰ ቤንያም ኬሳሞ ግቤኦን፣ ጌባ፣ አሌሜቲፊ አናቶትቱ ለፈ ዼደሳኒ ወጅን ንኬነሜፍ።</para>
  <para style="lf" vid="1CH 6:60">መጋላወን በልበለወን ቆሃቶታቲፍ ኬነመን ኩኔን ወሉማ ገለት ኩዸ ሰዲ ቱረን።<verse eid="1CH 6:60"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="61" style="v" sid="1CH 6:61"/>እልማን ቆሃት ከኔን ሀፈኒፍሞ በልበለ ወለካ ጎሰ ምናሴራ መጋላወን ኩዸንቱ እጣዻን ኬነሜፍ።<verse eid="1CH 6:61"/></para>
  <para style="li1">
    <verse number="62" style="v" sid="1CH 6:62"/>እልማን ጌርሾሚቲፍሞ ቆደ ይሳኮርራ፣ ቆደ ኣሼርራ፣ ቆደ ንፍታሌሚቲፊ ቆደ ምናሴ ከን ባሻንት አርገሙራ መጋላወን ኩዸ ሰዲ አኩመ ጎሰ ጎሰሳኒት ኬነመን።<verse eid="1CH 6:62"/></para>
  <para style="li1">
    <verse number="63" style="v" sid="1CH 6:63"/>እልማን ሜራሪቲፍ ቆደ ጎሰ ሩቤንራ፣ ቆደ ጎሰ ጋዲቲፊ ቆደ ጎሰ ዜቡሎንራ መጋላወን ኩዸ ለመ አኩመ በልበለ በልበለሳኒት ንኬነመን።<verse eid="1CH 6:63"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="64" style="v" sid="1CH 6:64"/>አከሲን እስራኤሎን መጋላወን ከኔን ለፈ ዼደሳኒ ወጅን ሌዎታፍ ንኬነን።<verse eid="1CH 6:64"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="65" style="v" sid="1CH 6:65"/>ጎሰ ይሁዳራ፣ ጎሰ ስምኦኒቲፊ ጎሰ ቤንያምራ መጋላወን መቃንሳኒ አርማን ኦልት ዸአሜ ሰነ እጣዻን ንኬነኒፍ።<verse eid="1CH 6:65"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="66" style="v" sid="1CH 6:66"/>ማቲወን ቆሃት ቶኮ ቶኮስ ቆደ ጎሰ ኤፍሬም ኬሳ መጋላወን ጅሬኛ አርገተኒ ቱረን።<verse eid="1CH 6:66"/></para>
  <para style="li1">
    <verse number="67" style="v" sid="1CH 6:67"/>ብየ ጋራ ኤፍሬም ኬሰት መጋላወን እት በቀተን ሼኬም፣ ጌዝር፣ <verse eid="1CH 6:67"/><verse number="68" style="v" sid="1CH 6:68"/>ዮቄምኣም፣ ቤት ሆሮን፣ <verse eid="1CH 6:68"/><verse number="69" style="v" sid="1CH 6:69"/>አያሎኒፊ ገት ርሞን ለፈ ዼደሳኒ ወጅን ኬነኒፍ።<verse eid="1CH 6:69"/></para>
  <para style="li1">
    <verse number="70" style="v" sid="1CH 6:70"/>አከሱመስ እስራኤሎን ወለካ ቆደ ጎሰ ምናሴራ ኣኔሪፊ ብሌኣም ለፈ ዼደሳኒ ወጅን በልበለወን ቆሃት ከኔን ሀፈኒፍ ንኬነን።<verse eid="1CH 6:70"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="71" style="v" sid="1CH 6:71"/>እልማን ጌርሾምሞ፦</para>
  <para style="li1" vid="1CH 6:71">በልበለ ወለካ ጎሰ ምናሴራ ጎላን እሼ ባሻን ኬሳ ሰናፊ አሽታሮት ለፈ ዼደሳኒ ወጅን ንአርገተን፤<verse eid="1CH 6:71"/></para>
  <para style="li1">
    <verse number="72" style="v" sid="1CH 6:72"/>ጎሰ ይሳኮርራ</para>
  <para style="li2" vid="1CH 6:72">ቃዴሽ፣ ዳቤራት፣ <verse eid="1CH 6:72"/><verse number="73" style="v" sid="1CH 6:73"/>ራሞቲፊ ኣኔም ለፈ ዼደሳኒ ወጅን ንአርገተን፤<verse eid="1CH 6:73"/></para>
  <para style="li1">
    <verse number="74" style="v" sid="1CH 6:74"/>ጎሰ ኣሼርራ ማሻል፣ አብዶን፣ <verse eid="1CH 6:74"/><verse number="75" style="v" sid="1CH 6:75"/>ሁቆቂፊ ሬሆብ ለፈ ዼደሳኒ ወጅን ንአርገተን፤<verse eid="1CH 6:75"/></para>
  <para style="li1">
    <verse number="76" style="v" sid="1CH 6:76"/>ጎሰ ንፍታሌም እራሞ ቃዴሽ እሼ ገሊላት አርገምቱ፣ ሀሞኒፊ ክርያታይምን ለፈ ዼደሳኒ ወጅን ንአርገተን።<verse eid="1CH 6:76"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="77" style="v" sid="1CH 6:77"/>ነሞትን ጎሰ ሜራሪ ጄቹንስ ወር ሌዎታ ከኔን ሀፈን ቆደ ከና ገዲ አርገተን፦</para>
  <para style="li1" vid="1CH 6:77">ጎሰ ዜቡሎንራ ዮቅንኣም፣ ቀርታ፣ ርሞኒፊ ታቦርን ለፈ ዼደሳኒ ወጅን አርገተን፤<verse eid="1CH 6:77"/></para>
  <para style="li1">
    <verse number="78" style="v" sid="1CH 6:78"/>ጎሰ ሩቤን ከን በአ ዬርኮት ዮርዳኖሲን ገመ ጅሩራ ቤዜር እሼ ገሞጂ ኬሰት አርገምቱ፣ ያህዛ፣ <verse eid="1CH 6:78"/><verse number="79" style="v" sid="1CH 6:79"/>ቅዴሞቲፊ ሜፍኣት ለፈ ዼደሳኒ ወጅን ንአርገተን።<verse eid="1CH 6:79"/></para>
  <para style="li1">
    <verse number="80" style="v" sid="1CH 6:80"/>ጎሰ ጋድራ ራሞት እሼ ግልኣድ ኬሳ፣ መሀነዪም፣ <verse eid="1CH 6:80"/><verse number="81" style="v" sid="1CH 6:81"/>ሄሽቦኒፊ የእዜር ለፈ ዼደሳኒ ወጅን ንአርገተን።<verse eid="1CH 6:81"/></para>
  <chapter eid="1CH 6"/>
  <chapter number="7" style="c" sid="1CH 7"/>
  <para style="s1">ይሳኮር</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 7:1"/>እልማን ይሳኮር፦</para>
  <para style="li2" vid="1CH 7:1">ቶላ፣ ጱዋ፣ ያሹቢፊ ሽምሮን፤ ወሉመት ነመ አፉር ቱረን።<verse eid="1CH 7:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 7:2"/>እልማን ቶላ፦</para>
  <para style="li2" vid="1CH 7:2">ኡዚ፣ ሬፋያ፣ ይሪኤል፣ ያህማይ፣ ይብሳሚፊ ሼሙኤል፤ እሳን ኩኔን ሀንገፎተ ማቲሳኒት። በረ ሞቱማ ዳዊት ኬሰ እልማን ቶላ ወር ህደ ዸሎተሳኒቲን አከ ሎልቶተ ጀጀቦት ገልሜፈመን ነመ 22,600 ቱረን።<verse eid="1CH 7:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 7:3"/>እልመ ኡዚ፦</para>
  <para style="li2" vid="1CH 7:3">ይዝረህያ።</para>
  <para style="li1" vid="1CH 7:3">እልማን ይዝረህያ፦</para>
  <para style="li2" vid="1CH 7:3">ሚካኤል፣ ኦባድያ፣ ዮኤሊፊ ይሽያ። ሸነንሳኒዩ ሀንገፎተ ቱረን። <verse eid="1CH 7:3"/><verse number="4" style="v" sid="1CH 7:4"/>እሳንስ ዋን ኒቶታፊ እጆሌ ሄዱ ቀባተኒፍ አከ ህደ ዸሎተ ማቲሳኒት ነሞተ ሎላፍ ቆጳአን 36,000 ቀቡ ቱሬ።<verse eid="1CH 7:4"/></para>
  <para style="lf">
    <verse number="5" style="v" sid="1CH 7:5"/>ፍሮን ሎልቶተ ጀጀቦ ቱረን ከኔን በልበለወን ይሳኮሪ ኬሳ ዸለተን ወር አኩመ ህደ ዸሎተሳኒት ገልሜፈመን ወሉመት ነመ 87,000፦<verse eid="1CH 7:5"/></para>
  <para style="s1">ቤንያም</para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 7:6"/>እልማን ቤንያም ሰደን፦</para>
  <para style="li2" vid="1CH 7:6">ቤላ፣ ቤኬሪፊ ዬዲኤል።<verse eid="1CH 7:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 7:7"/>እልማን ቤላ፦</para>
  <para style="li2" vid="1CH 7:7">ኤስቦን፣ ኡዚ፣ ኡዚኤል፣ ዬሪሞቲፊ ኢሪ ወሉመት ሸን ቱረን፤ ሀንገፎትን መነ አቦቲሳኒስ ጎቶተ ጀጀቦ ቱረን፤ ገልሜን ህደ ዸሎተሳኒ ነሞተ 22,034 አርግሲሰ።<verse eid="1CH 7:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 7:8"/>እልማን ቤኬር፦</para>
  <para style="li2" vid="1CH 7:8">ዜሚራ፣ ዮኣሽ፣ ኤሊኤዜር፣ ኤሊዮኤነይ፣ ኦምሪ፣ ዬሬሞት፣ አብያ፣ አናቶቲፊ አላሜት። እሳን ኩኔን ሁንድ እልማን ቤኬር ቱረን። <verse eid="1CH 7:8"/><verse number="9" style="v" sid="1CH 7:9"/>ሀንገፎተ መነ አቦቲሳኒ ከኔን አከ ዸሎተሳኒት ህደ ዸሎተሳኒቲን ለካአመን ጎቶተ ጀጀቦ 20,200 ቱረን።<verse eid="1CH 7:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 7:10"/>እልም ዬዲኤል፦</para>
  <para style="li2" vid="1CH 7:10">ብልሃን።</para>
  <para style="li1" vid="1CH 7:10">እልማን ብልሃኒ፦</para>
  <para style="li2" vid="1CH 7:10">ዬኡሽ፣ ቤንያም፣ ኤሁድ፣ ኬንኣና፣ ዜታን፣ ተርሺሺፊ አሂሸሀር። <verse eid="1CH 7:10"/><verse number="11" style="v" sid="1CH 7:11"/>እልማን ዬዲኤል ኩኔን ሁንድ ሀንገፎተ ማቲወኒ ቱረን። እሳንስ ነሞተ ወራነ ዸቁፍ ቆጳአን 17,200 ቀበን ቱሬ።<verse eid="1CH 7:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 7:12"/>ጎስት ሹፊሚቲፊ ሁፊም እልማን ኢር ቱረን፤ ሁሺምሞ እልመ አሄሪት።<verse eid="1CH 7:12"/></para>
  <para style="s1">ንፍታሌም</para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 7:13"/>እልማን ንፍታሌሚ፦</para>
  <para style="li2" vid="1CH 7:13">የህዚኤል፣ ጉኒ፣ ዬጤሪፊ ሸሉም፤ እሳን ኩኔን ሰኚ ብልሃት።<verse eid="1CH 7:13"/></para>
  <para style="s1">ምናሴ</para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 7:14"/>እልማን ምናሴ፦</para>
  <para style="li2" vid="1CH 7:14">አስሪኤል ከን ሳጀቶንሳ እሼን አራሚ ዹፍቴ ሱን ዴሴፍ። እሼንስ ማኪር አባ ግልኣድ ዴሴ። <verse eid="1CH 7:14"/><verse number="15" style="v" sid="1CH 7:15"/>ማኪርሞ ጎሶተ ሁፊሚቲፊ ሹፊም ኬሳ ኒቲ ፉዼ። መቃን ኦቦሌቲሳስ መአካ ቱሬ። ሰኚንሳ ከን ብራሞ ሰልጰኣድ ጄዸመ፤ ዜሎፌሃድ እንተለን ቆፈ ቀበ ቱሬ። <verse eid="1CH 7:15"/><verse number="16" style="v" sid="1CH 7:16"/>መአካን ኒቲን ማኪሪ እልመ ዴሴ መቃሳ ጴሬሽ ጄቴ ሞጋፍቴ። ኦቦሌስሳ ሼሬሽ ጄዸመ፤ እልማንሳሞ ኡላሚፊ ሬቄም ጄዸመን።<verse eid="1CH 7:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 7:17"/>እልም ኡላም፦</para>
  <para style="li2" vid="1CH 7:17">ቤዳን።</para>
  <para style="li1" vid="1CH 7:17">እሳን ኩኔን እልማን ግልኣዲ እልመ ማኪሪ፣ እልመ ምናሴ ሰናት።<verse eid="1CH 7:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 7:18"/>ሀሞሌኬት ኦቦሌቲንሳ ኢስሆድ፣ አቢኤዜሪፊ መህላ ዴሴ።<verse eid="1CH 7:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 7:19"/>እልማን ሼሚዳሞ፦</para>
  <para style="li2" vid="1CH 7:19">አሂያን፣ ሼኬም፣ ልክሂፊ አንያም ቱረን።<verse eid="1CH 7:19"/></para>
  <para style="s1">ኤፍሬም</para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 7:20"/>እልማን ኤፍሬም፦</para>
  <para style="li2" vid="1CH 7:20">ሹቴላ፣ እልመሳ ቤሬድ፣</para>
  <para style="li2" vid="1CH 7:20">እልመሳ ተሃት፣</para>
  <para style="li2" vid="1CH 7:20">እልመሳ ኤሌኣዳ፣ እልመሳ ተሃት፣ <verse eid="1CH 7:20"/><verse number="21" style="v" sid="1CH 7:21"/>እልመሳ ዛባዲ፣</para>
  <para style="li2" vid="1CH 7:21">እልመሳ ሹቴላ።</para>
  <para style="li2" vid="1CH 7:21">ኤዜሪፊ ኤልኣድ ዬሮ ሎን ወረ ጋት ከኔን አች ጅራተን ሰና ቦጅኡፍ ገድ ቡአንት ሀርከ ጀራቲን ንአጄፈመን። <verse eid="1CH 7:21"/><verse number="22" style="v" sid="1CH 7:22"/>ኤፍሬም አባንሳኒ ጉያ ሄዱ ቦኤፍ፤ ፍሮትንሳስ እሰ ጀጀቤሱ ዹፈን። <verse eid="1CH 7:22"/><verse number="23" style="v" sid="1CH 7:23"/>ሰነ ቦዴስ ዸቄ ኒቲሳ ወጅን ጪሴ፤ እሼንስ ኡልፎፍቴ እልመ ዴሴ። እንስ ሰበቢ ማቲሳ ኬሰ ረክን ቱሬፍ ቤሪያ ጄዼ መቃ ባሴፍ። <verse eid="1CH 7:23"/><verse number="24" style="v" sid="1CH 7:24"/>እንተልሳሞ ሼራ ጄዸምት፤ ነምን መጋላወን ቤት ሆሮኒ ከን ገድ ኣኑፊ ከን ኦል ኣኑ፣ አከሱመስ መጋላ ኡዜን ሼራ ሁንዴሴ እሼዸ።<verse eid="1CH 7:24"/></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 7:25"/>ሬፋ እልመሳ፣ ሬሼፍ እልመሳ፣</para>
  <para style="li2" vid="1CH 7:25">ቴላ እልመሳ፣ ታሀን እልመሳ፣<verse eid="1CH 7:25"/></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 7:26"/>ለአዳን እልመሳ፣ አሚሁድ እልመሳ፣</para>
  <para style="li2" vid="1CH 7:26">ኤሊሻማ እልመሳ፣ <verse eid="1CH 7:26"/><verse number="27" style="v" sid="1CH 7:27"/>ኑን እልመሳቲፊ</para>
  <para style="li2" vid="1CH 7:27">እያሱ እልመሳ።<verse eid="1CH 7:27"/></para>
  <para style="lf">
    <verse number="28" style="v" sid="1CH 7:28"/>ብዮትኒፊ አርዳን ቁበተሳኒስ ቤትኤሊፊ ገንዶተ ናኖሼ፣ ከራ በአ ቢፍቱቲን ነአራን፣ ከራ ልጠ ቢፍቱቲንሞ ጌዝሪፊ ገንዶተሼ አከሱመስ ሼኬሚፊ ገንዶተሼ ከኔን ሀመ አያፊ ገንዶተሼት ጅረን ቀበተ ቱሬ። <verse eid="1CH 7:28"/><verse number="29" style="v" sid="1CH 7:29"/>ዳሪወን ምናሴረ ቤት ሼኣን፣ ተአናክ፣ ሜግዶፊ ዶርቱ ገንዶተሳኒ ወጅን ቱሬ። ሰኚወን ዮሴፍ እልመ እስራኤል ሰናስ መጋላወን ከኔን ኬሰ ጅራተን።<verse eid="1CH 7:29"/></para>
  <para style="s1">አሴር</para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 7:30"/>እልማን ኣሼር፦</para>
  <para style="li2" vid="1CH 7:30">ይምና፣ ይሽዋ፣ ይሽዊፊ ቤሪያ። ኦቦሌቲንሳኒሞ ሴራ ጄዸምት።<verse eid="1CH 7:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 7:31"/>እልማን ቤሪያ፦</para>
  <para style="li2" vid="1CH 7:31">ሄቤሪፊ መልኪኤል አባ ብርዛውቲ።<verse eid="1CH 7:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 7:32"/>ሄቤርሞ አባ ያፍሌጢ፣ ሾሜሪ፣ ሆታሚቲፊ ኦቦሌቲሳኒ ሹኣት።<verse eid="1CH 7:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 7:33"/>እልማን ያፍሌጥ፦</para>
  <para style="li2" vid="1CH 7:33">ጳሳክ፣ ቢምሃሊፊ አሽዋት።</para>
  <para style="lf" vid="1CH 7:33">እሳን ኩኔን እልማን ያፍሌጢት።<verse eid="1CH 7:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 7:34"/>እልማን ሼሜር፦</para>
  <para style="li2" vid="1CH 7:34">አሂ፣ ሮህጋ፣ ዬሁባፊ አራም።<verse eid="1CH 7:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 7:35"/>እልማን ኦቦሌሰሳ ሄሌም፦</para>
  <para style="li2" vid="1CH 7:35">ዞፋ፣ ይምና፣ ሼሌሺፊ ኣማል።<verse eid="1CH 7:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 7:36"/>እልማን ዞፋ፦</para>
  <para style="li2" vid="1CH 7:36">ሱዋ፣ ሀርኔፌር፣ ሹኣል፣ ቤሪ፣ ይምራ፣ <verse eid="1CH 7:36"/><verse number="37" style="v" sid="1CH 7:37"/>ቤዜር፣ ሆድ፣ ሸማ፣ ሽልሻ፣ ይትራኒፊ ብኤራ።<verse eid="1CH 7:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 7:38"/>እልማን ዬቴር፦</para>
  <para style="li2" vid="1CH 7:38">ዬፉኔ፣ ፊስጳፊ ኤራ።<verse eid="1CH 7:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 7:39"/>እልማን ኡላ፦</para>
  <para style="li2" vid="1CH 7:39">ኣራ፣ ሀኒኤሊፊ ሪዝያ።<verse eid="1CH 7:39"/></para>
  <para style="lf">
    <verse number="40" style="v" sid="1CH 7:40"/>እሳን ኩኔን ሁንድ ጎሶተ ኣሼሪ ቱረን፤ እሳንስ ሀንገፎተ ማቲወኒ፣ ነሞተ ፍለተሞ፣ ሎልቶተ ጀጀቦፊ ቡልችቶተ ቤቤከሞ ቱረን። አከ ገልሜ ህደ ዸሎተሳኒ ኬሰት ገልሜፈሜት ነሞትንሳኒ ከኔን ደንዴቲ ወራና ቀበን 26,000 ቱረን።<verse eid="1CH 7:40"/></para>
  <chapter eid="1CH 7"/>
  <chapter number="8" style="c" sid="1CH 8"/>
  <para style="s1">ህደ ዸሎተ ሳኦል ነምቸ ጎሰ ቤንያሚ</para>
  <para style="r">
    <ref loc="1CH 8:28-38">8፥28‑38</ref> ኩወፈ – <char style="xt"><ref loc="1CH 9:34-44">1ሴና 9፥34‑44</ref></char></para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 8:1"/>ቤንያም እልመሳ ሀንገፈ ቤላ፣ እልመሳ</para>
  <para style="li2" vid="1CH 8:1">ለመፋ አሽቤል፣ እልመሳ ሰደፋ አሀራ፣<verse eid="1CH 8:1"/></para>
  <para style="li2">
    <verse number="2" style="v" sid="1CH 8:2"/>እልመሳ አፉረፋ ኖሃፊ እልመሳ ሸነፋ ራፋ ዸልቼ።<verse eid="1CH 8:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 8:3"/>እልማን ቤላ፦</para>
  <para style="li2" vid="1CH 8:3">አዳር፣ ጌራ፣ አቢሁድ፣ <verse eid="1CH 8:3"/><verse number="4" style="v" sid="1CH 8:4"/>አቢሹዋ፣ ነአማን፣ አሆኣ፣ <verse eid="1CH 8:4"/><verse number="5" style="v" sid="1CH 8:5"/>ጌራ፣ ሼፉፋኒፊ ሁራም።<verse eid="1CH 8:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 8:6"/>እሳን ኩን እልማን ኤሁዲ ከኔን ሀንገፎተ ማቲወን ወረ ጌባ ኬሰ ጅራተኒ ቦጁዻን ማነሀትት ጌፈመኒት፦<verse eid="1CH 8:6"/></para>
  <para style="li2">
    <verse number="7" style="v" sid="1CH 8:7"/>ነአማን፣ አሂያፊ ጌራ፤ ጌራን ኩን አባ ኡዛፊ አሂሁዲት፤ ነምን ቦጁዻን ፉዼ እሳን ጌሴስ እሰ ቱሬ።<verse eid="1CH 8:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 8:8"/>ሸሀራይም ኤርገ ኒቶተሳ ሁሺሚፊ በአራ ኦፍ ጀላ አርኤ ቦዴ ሞኣብ ኬሰት እልማን ዸልቼ። <verse eid="1CH 8:8"/><verse number="9" style="v" sid="1CH 8:9"/>ኒቲሳ ሆዴሽራ ዮባብ፣ ዝብያ፣ ሜሻ፣ ማልካም፣ <verse eid="1CH 8:9"/><verse number="10" style="v" sid="1CH 8:10"/>ዬኡጥ፣ ሳክያፊ ሚርማ ዸልቼ፤ እሳን ኩኔን እልማንሳ ወረ ሀንገፎተ ማቲ ቱረኒዸ። <verse eid="1CH 8:10"/><verse number="11" style="v" sid="1CH 8:11"/>ኒቲሳ ሁሺም እራሞ አቢቱቢፊ ኤልጰአል ዸልቼ።<verse eid="1CH 8:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 8:12"/>እልማን ኤልጰአል፦</para>
  <para style="li2" vid="1CH 8:12">ኤቤር፣ ምሻም፣ ሼሜድ፤ እሰ መጋላወን ኦኖኒቲፊ ሎድ ገንዶተ ናኖሼ ጅረን ወጅን እጃሬ፤ <verse eid="1CH 8:12"/><verse number="13" style="v" sid="1CH 8:13"/>ቤሪያፊ ሼማ ከኔን ሀንገፎተ ማቲወን ወረ አያሎን ኬሰ ጅራተን ሰና ተአኒ ጅራቶተ ጋቲ አርአኒ ብያ ባሰኒዸ።<verse eid="1CH 8:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 8:14"/>አሂዮን፣ ሻሻቅ፣ ዬሬሞት፣ <verse eid="1CH 8:14"/><verse number="15" style="v" sid="1CH 8:15"/>ዜባድያን፣ ኣራድ፣ ኤዴር፣ <verse eid="1CH 8:15"/><verse number="16" style="v" sid="1CH 8:16"/>ሚካኤል፣ ይሽጳፊ ዮሃን እልማን ቤሪያ ቱረን።<verse eid="1CH 8:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 8:17"/>ዜባድያን፣ ሜሹላም፣ ህዝቂ፣ ሄቤር፣ <verse eid="1CH 8:17"/><verse number="18" style="v" sid="1CH 8:18"/>ይሽምራይ፣ ይዝልያፊ ዮባብ እልማን ኤልጰአሊ ቱረን።<verse eid="1CH 8:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 8:19"/>ያቂም፣ ዝክሪን፣ ዘብዲን፣ <verse eid="1CH 8:19"/><verse number="20" style="v" sid="1CH 8:20"/>ኤሊኤናይ፣ ዝሌታይ፣ ኤሊኤል፣ <verse eid="1CH 8:20"/><verse number="21" style="v" sid="1CH 8:21"/>አዳያ፣ ቤራያፊ ሺምራት እልማን ሽሜኢ ቱረን።<verse eid="1CH 8:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 8:22"/>ይሽጳን፣ ኤቤር፣ ኤሊኤል፣ <verse eid="1CH 8:22"/><verse number="23" style="v" sid="1CH 8:23"/>አብዶን፣ ዝክሪን ሃናን፣ <verse eid="1CH 8:23"/><verse number="24" style="v" sid="1CH 8:24"/>ሀናንያ፣ ኤላም፣ አንቶቲያ፣ <verse eid="1CH 8:24"/><verse number="25" style="v" sid="1CH 8:25"/>ይፍዴያፊ ጴኑኤል እልማን ሻሻቅ ቱረን።<verse eid="1CH 8:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 8:26"/>ሸምሼራይ፣ ሼሃርያ፣ አታልያ፣ <verse eid="1CH 8:26"/><verse number="27" style="v" sid="1CH 8:27"/>የእሬሽያ፣ ኤልያሲፊ ዝክሪን እልማን ይሮሀሚ ቱረን።<verse eid="1CH 8:27"/></para>
  <para style="lf">
    <verse number="28" style="v" sid="1CH 8:28"/>እሳን ኩኔን ሁንድ አኩመ ህደ ዸሎተሳኒ ኬሰት ገልሜፈሜት አቦቲ ማቲቲፊ ሀንገፎተ ቱረን፤ እሳንስ ዬሩሳሌም ኬሰ ጅራቱ ቱሬ።<verse eid="1CH 8:28"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 8:29"/>ዬኢኤል አባን ግቤኦንስ ግቤኦን ኬሰ ጅራተ ቱሬ፤</para>
  <para style="li2" vid="1CH 8:29">መቃን ኒቲሳ መአካዸ። <verse eid="1CH 8:29"/><verse number="30" style="v" sid="1CH 8:30"/>እልምሳ ሀንገፍን አብዶን ጄዸመ፤ ከኔን እሰ ቦዴ ዸለተንሞ ዙር፣ ቂስ፣ በኣል፣ ኔር፣ ናዳብ፣ <verse eid="1CH 8:30"/><verse number="31" style="v" sid="1CH 8:31"/>ጌዶር፣ አሂዮ፣ ዜኬሪፊ <verse eid="1CH 8:31"/><verse number="32" style="v" sid="1CH 8:32"/>ሚቅሎት አባ ሽሜኣ ቱረን፤ እሳንስ ፍሮተሳኒ ወጅን ዬሩሳሌም ኬሰ ጅራተን።<verse eid="1CH 8:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 8:33"/>ኔር አባ ቂሺት፤ ቂሽ አባ ሳኦሊት፤ ሳኦልሞ አባ ዮናታን፣ መልኪ-ሹዋ፣ አቢናዳቢቲፊ ኤሽበአሊት።<verse eid="1CH 8:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 8:34"/>እልም ዮናታን፦</para>
  <para style="li2" vid="1CH 8:34">ሜሪበኣል አባ ሚካት።<verse eid="1CH 8:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 8:35"/>እልማን ሚካ፦</para>
  <para style="li2" vid="1CH 8:35">ጲቶን፣ ሜሌክ፣ ታሬኣፊ ኣሃዝ።<verse eid="1CH 8:35"/></para>
  <para style="li2">
    <verse number="36" style="v" sid="1CH 8:36"/>ኣሃዝ አባ ይሆኣዳት፤ ይሆአዳን አባ ኣሌሜት፣ አዝማዌቲቲፊ ዝምሪት፤ ዝምሪንሞ አባ ሞዛት። <verse eid="1CH 8:36"/><verse number="37" style="v" sid="1CH 8:37"/>ሞዛን አባ ቢኔኣት፤ ራፋን እልመሳት፤ ኤሌኣሳን እልመሳት፤ ኣዜልስ እልመሳት።<verse eid="1CH 8:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 8:38"/>ኣዜል እልማን ጀአ ቀበ ቱሬ፤ መቃንሳኒስ፦</para>
  <para style="li2" vid="1CH 8:38">አዝሪቃም፣ ቦኬሩ፣ እሽማኤል፣ ሼአርያ፣ ኦባድያፊ ሃናን። እሳን ኩኔን ሁንድ እልማን ኣዜሊት።<verse eid="1CH 8:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 8:39"/>እልማን ኦቦሌሰሳ ኤሴቂ፦</para>
  <para style="li2" vid="1CH 8:39">እልምሳ ሀንገፍን ኡላም፣ እልምሳ ለመፋን ዬኡሽ፣ እልምሳ ሰደፋን ኤሊጴሌጥ። <verse eid="1CH 8:39"/><verse number="40" style="v" sid="1CH 8:40"/>እልማን ኡላም ሎልቶተ ጀጀቦ ጥያን ሎሉ ደንደአን ቱረን። እሳንስ እልማኒፊ እልማን እልማኒ ሄዱ ወሉመት ነመ 150 ቀቡ ቱረን።</para>
  <para style="li1" vid="1CH 8:40">እሳን ኩኔን ሁንድ እልማን ቤንያም ቱረን።<verse eid="1CH 8:40"/></para>
  <para style="b"/>
  <chapter eid="1CH 8"/>
  <chapter number="9" style="c" sid="1CH 9"/>
  <para style="p">
    <verse number="1" style="v" sid="1CH 9:1"/>እስራኤሎን ሁንድኑ አኩመ ህደ ዸሎተሳኒት ክታበ ሞቶተ እስራኤል ኬሰት ገልሜፈመን።</para>
  <para style="s1" vid="1CH 9:1">ሰበ ዬሩሳሌም</para>
  <para style="r" vid="1CH 9:1">
    <ref loc="1CH 9:1-17">9፥1‑17</ref> ኩወፈ – <char style="xt"><ref loc="NEH 11:3-19">ነህ 11፥3‑19</ref></char></para>
  <para style="p" vid="1CH 9:1">ሰብን ይሁዳ ሰበቢ ጩቡሳቲፍ ቦጅአሜ ባብሎንት ጌፈሜ።<verse eid="1CH 9:1"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="2" style="v" sid="1CH 9:2"/>ወር ጀልቀበት ዴብአኒ ለፋፊ መጋላወን ኦፊሳኒ ኬሰ ቁበተን እስራኤሎተ ቶኮ ቶኮ፣ ሉቦተ፣ ሌዎታፊ ተጃጅልቶተ መነ ቁልቁሉማት።<verse eid="1CH 9:2"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="3" style="v" sid="1CH 9:3"/>ሰቦትን ይሁዳ፣ ከን ቤንያሚ፣ ከን ኤፍሬሚፊ ከን ምናሴ ወር ዬሩሳሌም ኬሰ ጅራቻ ቱረን፦<verse eid="1CH 9:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 9:4"/>ኡታይ እልመ አሚሁድ፣ እልመ ኦምሪ፣ እልመ እምሪ፣ እልመ ባኒ እልማን ፋሬስ እልመ ይሁዳ።<verse eid="1CH 9:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 9:5"/>ሼላኖተ ኬሳ፦</para>
  <para style="li2" vid="1CH 9:5">አሳያ እልመሳ ሀንገፍትቻፊ እልማንሳ።<verse eid="1CH 9:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 9:6"/>ዛራሆተ ኬሳ፦</para>
  <para style="li2" vid="1CH 9:6">ዬኡኤል።</para>
  <para style="lf" vid="1CH 9:6">ሰቦትን ይሁዳ ነመ 690 ቱረን።<verse eid="1CH 9:6"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="7" style="v" sid="1CH 9:7"/>ቤንያሞተ ኬሳ፦</para>
  <para style="li1" vid="1CH 9:7">ሰኣሉ እልመ ሜሹላም፣ እልመ ሆደይዋ፣ እልመ ሀሴኑኣ፤<verse eid="1CH 9:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 9:8"/>ብኔያ እልመ ይሮሀም፤</para>
  <para style="li1" vid="1CH 9:8">ኤላ እልመ ኡዚ፣ እልመ ምክሪ፤</para>
  <para style="li1" vid="1CH 9:8">ሜሹላም እልመ ሼፋጥያ፣ እልማ ሬኡኤል፣ እልመ ይብንያ።<verse eid="1CH 9:8"/></para>
  <para style="lf">
    <verse number="9" style="v" sid="1CH 9:9"/>ሰብን ቤንያም አከ ገልሜ ህደ ዸሎተሳኒረት ገልሜፈሜት ነመ 956 ቱሬ። ነሞትን ኩኔን ሁንድ ሀንገፎተ ማቲሳኒ ቱረን።<verse eid="1CH 9:9"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="10" style="v" sid="1CH 9:10"/>ሉቦተ ኬሳ፦</para>
  <para style="li1" vid="1CH 9:10">ዬዳእያ፤ ዬሆያሪብ፤ ያኪን፤<verse eid="1CH 9:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 9:11"/>አዛርያ እልመ ህልቅያ፣ እልመ ሜሹላም፣ እልመ ዛዶቅ፣ እልመ ሜራዮት፣ እልመ አሂጡብ ቆንዳልትቸ እት ጋፈተማ መነ ዋቃ ተኤ ሰና።<verse eid="1CH 9:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 9:12"/>አዳያ እልመ ዬሮሀም፣ እልመ ጳሽሁር፣ እልመ መልክያ፤ መአሳይ እልመ ኣዲኤል፣ እልመ የህዜራ፣ እልመ ሜሹላም፣ እልመ ሜሽሌሚት፣ እልመ እሜር።<verse eid="1CH 9:12"/></para>
  <para style="lf">
    <verse number="13" style="v" sid="1CH 9:13"/>ባይእን ሉቦተ አቦቲ ማቲ ቱረኒስ 1,760 ቱሬ። እሳን ኩኔን ነሞተ ደንዴቲ ቀበን ከኔን ተጃጅለ መነ ዋቃ ኬሰት እት ጋፈተምቶተ ተአኒዸ።<verse eid="1CH 9:13"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="14" style="v" sid="1CH 9:14"/>ሌዎተ ኬሳ፦</para>
  <para style="li1" vid="1CH 9:14">ሼማእያ እልመ ሀሹቢ፣ እልመ አዝሪቃሚ፣ እልመ ሀሸብያ ነምቸ ጎሰ ሜራሪ ሰና፤<verse eid="1CH 9:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 9:15"/>በቅበቀር፣ ሄሬሽ፣ ጋላሊፊ መታንያ እልመ ሚካ፣ እልመ ዝክሪ፣ እልመ አሳፍ፤<verse eid="1CH 9:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 9:16"/>ኦባድያ እልመ ሼማእያ፣ እልመ ጋላል፣ እልመ ዬዱቱን፤</para>
  <para style="li1" vid="1CH 9:16">ቤሬክያ እልመ ኣሳ፣ እልመ ኤልቃና ከን ገንዶተ ኔቶፎታ ኬሰ ጅራቻ ቱሬ ሰነ።<verse eid="1CH 9:16"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="17" style="v" sid="1CH 9:17"/>ኤግዶተ በልበላ፦</para>
  <para style="li1" vid="1CH 9:17">ሸሉም፣ አቁብ፣ ተልሞን፣ አሂመኒፊ ኦቦሎተሳኒ፤ ሸሉም ሀንገፈ ጎሰሳኒ ቱሬ፤ <verse eid="1CH 9:17"/><verse number="18" style="v" sid="1CH 9:18"/>እንስ ሀመ አማት ከረ ሞቲ ከን ገመ በኣ ቢፍቱት ረመደሜረ። እሳን ኩኔን ኤግዶተ በልበለ ቁበተ ሌዎታ ቱረን።<verse eid="1CH 9:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 9:19"/>ሸሉም እልም ቆራህ እልመ ኤብያሳፍ፣ እልመ ቆራሂቲፊ ማቲንሳ ጄቹንስ ጎስት ቆራሂ ከኔን እሰ ወጅን ከረ ኤገን ሱን አኩመ አቦቲንሳኒ ዱር እት ጋፈተምቶተ በልበለ መነ ቡልቲ <char style="nd">ዋቀዮ</char> ቱረን ሰነ እሳንስ እት ጋፈተምቶተ በልበለ ዱንካና ተአን።<verse eid="1CH 9:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 9:20"/>በረ ዱሪ ኬሰ ፊኔሃስ እልም ኤሌኣዛር ሱን ዱረ ቡኣ ኤግዶተ በልበላ ቱሬ፤ <char style="nd">ዋቀዮስ</char> እሰ ወጅን ቱሬ።<verse eid="1CH 9:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 9:21"/>ዘካርያስ እልም ሜሼሌምያሞ ኤግዱ በልበለ ዱንካነ ወል ገኢ ቱሬ።<verse eid="1CH 9:21"/></para>
  <para style="lf">
    <verse number="22" style="v" sid="1CH 9:22"/>ነሞትን አከ በልበለ ኤገኒፍ ፍለተመን ወሉመት 212 ቱረን። እሳንስ አኩመ ህደ ዸሎተሳኒት ገንዶተሳኒ ኬሰት ገልሜፈመን።</para>
  <para style="b" vid="1CH 9:22"/>
  <para style="p" vid="1CH 9:22">ኤግዶተ በልበላ ከኔንስ ዳዊቲፊ ሳሙኤል ራጅቸቱ ሆጂሳኒት እሳን ረመዴ። <verse eid="1CH 9:22"/><verse number="23" style="v" sid="1CH 9:23"/>እሳኒፊ ሰኚወንሳኒ እት ጋፈተምቶተ ኤጉምሰ ከረ መነ <char style="nd">ዋቀዮ</char> ጄቹንስ መንቸ ዱንካነ ጄዸሙ ሰና ቱረን። <verse eid="1CH 9:23"/><verse number="24" style="v" sid="1CH 9:24"/>ኤግዶን በልበላ ኩኔን ቅጠ አፍረኒን ጄቹንስ ከራ በአ ቢፍቱ፣ ከራ ልጠ ቢፍቱ፣ ከራ ካባቲፊ ክባቲን ቱረን። <verse eid="1CH 9:24"/><verse number="25" style="v" sid="1CH 9:25"/>ኦቦሎትንሳኒስ ዬሮ ዬሮት ገንዶተሳኒ ኬሳ ዹፈኒ ቡልቲ ቶርበ ቶርበ ሆጂ እሳን ገርጋራ ቱረን። <verse eid="1CH 9:25"/><verse number="26" style="v" sid="1CH 9:26"/>ዱረ ቡቶተ ኤግዶተ በልበላ ከኔን ሌዎተ ቱረን አፍረን ገሩ እት ጋፈተሙማ ኩታሌፊ ቀቤኘ መነ ዋቃ ኬሳቱ እት ኬነሜ። <verse eid="1CH 9:26"/><verse number="27" style="v" sid="1CH 9:27"/>እሳንስ ሰበቢ መንቸ ኤጉ ቀበኒፍ ሀልከን ሀልከን ናኖ መነ ዋቃ ዻበተኒ ቡሉ ቱረን፤ ገነመ ገነመስ መንቸ በኑፍ እት ጋፈተሙማ ቀቡ ቱረን።<verse eid="1CH 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 9:28"/>እሳን ኬሳ ነሞትን ቶኮ ቶኮ ቶአቶተ ምአ መነ ቁልቁሉማ ኬሰት ፈየዱ ቱረን፤ እሳንስ ምአ ከነ ዬሮ እን ገድ ባፈሙፊ ዬሮ እን ኦል ገልፈሙ ንለካኡ ቱሬ። <verse eid="1CH 9:28"/><verse number="29" style="v" sid="1CH 9:29"/>ወር ካንሞ አከ ምኦተ መነ ቁልቁሉማ፣ ዳኩሳ፣ ዳዺ ወይኒሳ፣ ዘይቲሳ፣ እጣነሳቲፊ ኡርጎፍቱወን ኤገኒፍ ረመደመን። <verse eid="1CH 9:29"/><verse number="30" style="v" sid="1CH 9:30"/>ሉቦተ ኬሳ ቶኮ ቶኮሞ ኡርጎፍቱወን ወልት መከኒ ቆጴሱ ቱሬ። <verse eid="1CH 9:30"/><verse number="31" style="v" sid="1CH 9:31"/>ሌውቸ መቲትያ ጄዸሙ፣ እልመ ሸሉም ነምቸ ጎሰ ቆራህ ሀንገፍትቸትሞ እት ጋፈተሙማ ቡዴነ ኣርሳ ቶልቹቱ ኬነሜ። <verse eid="1CH 9:31"/><verse number="32" style="v" sid="1CH 9:32"/>ኦቦሎተሳኒ ቆሃቶተ ቶኮ ቶኮትሞ እት ጋፈተሙማ ቡዴነ ጉያ ሰንበታ ሁንደ ምንጃለረ ካአሙ ቆጴሱቱ ኬነሜ።<verse eid="1CH 9:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 9:33"/>ፋርፈቶትን አቦቲ ማቲወን ሌዎታ ቱረንሞ ዋን ሀልከኒፊ ጉያ እት ጋፈተሙማ ሆጂ ቀበኒፍ ኩታ መነ ቁልቁሉማ ኬሳ ህንበአን፤ ሆጂ ብራትስ ህንዋመመን ቱሬ።<verse eid="1CH 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 9:34"/>እሳን ኩኔን ሁንድኑ አቦቲ ማቲወን ሌዎታ ሀንገፎተ ጎሳ ከኔን አኩመ ህደ ዸሎተሳኒት ገልሜፈመኒዸ፤ እሳንስ ዬሩሳሌም ኬሰ ጅራተን።<verse eid="1CH 9:34"/></para>
  <para style="s1">ህደ ዸሎተ ሳኦል</para>
  <para style="r">
    <ref loc="1CH 9:34-44">9፥34‑44</ref> ኩወፈ – <char style="xt"><ref loc="1CH 8:28-38">1ሴና 8፥28‑38</ref></char></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 9:35"/>ዬኢኤል አባን ግቤኦንስ ግቤኦን ኬሰ ጅራተ ቱሬ።</para>
  <para style="li2" vid="1CH 9:35">መቃን ኒቲሳ መአካዸ፤ <verse eid="1CH 9:35"/><verse number="36" style="v" sid="1CH 9:36"/>እልምሳ ሀንገፍን አብዶን ጄዸመ፤ ከኔን እሰ ቦዴ ዸለተንሞ ዙር፣ ቂስ፣ በኣል፣ ኔር፣ ናዳብ፣ <verse eid="1CH 9:36"/><verse number="37" style="v" sid="1CH 9:37"/>ጌዶር፣ አሂዮ፣ ዘካርያስፊ ሚቅሎት። <verse eid="1CH 9:37"/><verse number="38" style="v" sid="1CH 9:38"/>ሚቅሎት አባ ሽሜኣም። እሳንስ ፍሮተሳኒ ወጅን ዬሩሳሌም ኬሰ ጅራተን።<verse eid="1CH 9:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 9:39"/>ኔር አባ ቂሺት፤ ቂሽ አባ ሳኦሊት፤ ሳኦልሞ አባ ዮናታን፣ መልኪ-ሹዋ፣ አቢናዳቢቲፊ ኤሽበአሊት።<verse eid="1CH 9:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 9:40"/>እልም ዮናታን፦</para>
  <para style="li2" vid="1CH 9:40">ሜሪበኣል አባ ሚካት።<verse eid="1CH 9:40"/></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 9:41"/>እልማን ሚካ፦</para>
  <para style="li2" vid="1CH 9:41">ጲቶን፣ ሜሌክ፣ ተህሬኣፊ ኣሃዝ።<verse eid="1CH 9:41"/></para>
  <para style="li2">
    <verse number="42" style="v" sid="1CH 9:42"/>ኣሃዝ አባ የእራት፤ የእራንሞ አባ ኣሌሜት፣ አዝማዌቲቲፊ ዝምሪት፤ ዝምሪንሞ አባ ሞዛት። <verse eid="1CH 9:42"/><verse number="43" style="v" sid="1CH 9:43"/>ሞዛን አባ ቢኔኣት፤ ሬፋያን እልመሳት፤ ኤሌኣሳን እልመሳት፤ ኣዜልስ እልመሳት።<verse eid="1CH 9:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 9:44"/>ኣዜል እልማን ጀአ ቀበ ቱሬ፤ መቃንሳኒስ፦</para>
  <para style="li2" vid="1CH 9:44">አዝሪቃም፣ ቦኬሩ፣ እሽማኤል፣ ሼአርያ፣ ኦባድያፊ ሃናን። እሳን ኩኔን እልማን ኣዜሊት።<verse eid="1CH 9:44"/></para>
  <chapter eid="1CH 9"/>
  <chapter number="10" style="c" sid="1CH 10"/>
  <para style="s1">ሳኦል ኦፍ አጄሴ</para>
  <para style="r">
    <ref loc="1CH 10:1-12">10፥1‑12</ref> ኩወፈ – <char style="xt"><ref loc="1SA 31:1-13">1ሳሙ 31፥1‑13</ref>፤ <ref loc="2SA 1:4-12">2ሳሙ 1፥4‑12</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 10:1"/>ፍልስጤሞትን ዬሮ ከነት እስራኤልት ወራነ ካሰን፤ እስራኤሎንስ እሳን ዱራ በቀተን፤ ሄዱንሳኒስ ቱሉ ግልቦኣረት ዹመን። <verse eid="1CH 10:1"/><verse number="2" style="v" sid="1CH 10:2"/>ፍልስጤሞትን እቱመ ጀቤሰኒ ሳኦሊፊ እልማንሳ አርአን፤ እሳንስ እልማንሳ ጄቹንስ ዮናታን፣ አቢናዳቢፊ መልኪ-ሹዋ አጄሰን። <verse eid="1CH 10:2"/><verse number="3" style="v" sid="1CH 10:3"/>ሎልስ ናኖ ሳኦልት ባይኤ ጭሜ፤ ወር ጥያን ሎለንስ እሰ ቀቀበኒ እሰ መዴሰን።<verse eid="1CH 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 10:4"/>ሳኦልስ ነምቸ ምአ ሎላሳ ባቱን፣ “ጎራዴኬ ሉቅፈዹቲ ነ ወራን፤ ዮ ከና አቺ ነሞትን ዸግነ ህንቀበምን ኩኔን ዹፈኒ ነት ተጰቱ” ጄዼ።</para>
  <para style="p" vid="1CH 10:4">ነምች ምአ ሎላ ባቱፍ ሱን ገሩ ዋን አከ መሌ ሶዳቴፍ እሰ ህንወራኔ፤ ከናፉ ሳኦል ጎራዴ ኦፊሳ ሉቅፈቴረት ኩፌ። <verse eid="1CH 10:4"/><verse number="5" style="v" sid="1CH 10:5"/>ነምች ምአ ሎላ ባቱ ሱን ዮሙ አከ ሳኦል ዱኤ አርጌት እንስ ጎራዴ ኦፊሳረት ኩፌ ዱኤ። <verse eid="1CH 10:5"/><verse number="6" style="v" sid="1CH 10:6"/>ከናፉ ሳኦሊፊ እልማንሳ ሰደን ንዱአን፤ ወር መነሳ ሁንድኑስ ወሉማን ዹመን።<verse eid="1CH 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 10:7"/>እስራኤሎን ሱሉለ ኬሰ ቱረን ሁንድ ዮሙ አከ ሎልቶትን በቀተን፣ አከ ሳኦሊፊ እልማንሳስ ዹመን አርገንት መጋላወንሳኒ ዺሰኒ በቀተን። ፍልስጤሞትንሞ ዹፈኒ ኬሰ ቁበተን።<verse eid="1CH 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 10:8"/>ፍልስጤሞትንስ ጉያ እት ኣኑት ዮሙ ወረ ዹመንራ ህዸትና ሂከቹ ዹፈንት አከ ሳኦሊፊ እልማንሳ ቱሉ ግልቦኣረት ኩኩፈኒ ጅረን አርገን። <verse eid="1CH 10:8"/><verse number="9" style="v" sid="1CH 10:9"/>እሳንስ ኤርገ ህዸተ ሳኦል ሂከተኒ መታ እሳ እራ ኩተኒ ቦዴ አከ እሳን ዋቆተ ቶልፈሞፊ ነሞተሳኒት ኦዱ ጋሪ ለብሰኒፍ ጉቱማ ፍልስጤሚት ኤርገሞተ ንኤርገን። <verse eid="1CH 10:9"/><verse number="10" style="v" sid="1CH 10:10"/>ኤርገሲሞ ምአ ሎላሳ መነ ዋቆተ ቶልፈሞሳኒ ኬሰ፣ መታሳሞ መነ ዳጎን ዋቅቸ ቶልፈማ ሰና ኬሰት ንፈንሰን።<verse eid="1CH 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 10:11"/>ጅራቶትን ያቤሽ ግልኣድ ሁንድ ዮሙ ዋን ፍልስጤሞትን ሳኦልን ጎዸን ዸገአንት፣ <verse eid="1CH 10:11"/><verse number="12" style="v" sid="1CH 10:12"/>ነሞትን ጀጀቦንሳኒ ሁንድ ዸቀኒ ሬፈ ሳኦሊፊ ሬፈ እልማንሳ ጉረኒ ገረ ያቤሽት ንፍደን። ኤርገሲሞ ሬፈሳኒ ሙከ ጉዳ ያቤሽ ኬሳ ቶኮ ጀለት አዋለን፤ ጉያ ቶርበስ ንሶመን።<verse eid="1CH 10:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 10:13"/>ሳኦል ሰበቢ <char style="nd">ዋቀዮፍ</char> አመነማ ህንተእኒፍ ዱኤ፤ እን ዱቢ <char style="nd">ዋቀዮቲፍ</char> ህንአጀጀምኔ፤ ቆደ ከና እላልቱ ጎርሰ ጋፈቴ፤ <verse eid="1CH 10:13"/><verse number="14" style="v" sid="1CH 10:14"/><char style="nd">ዋቀዮን</char> ጎርሰ ህንጋፈኔ። ከናፍ <char style="nd">ዋቀዮ</char> እሰ አጄሴ፤ ሞቱማሳስ ደበርሴ ዳዊት እልመ እሴዪቲፍ ኬኔ።<verse eid="1CH 10:14"/></para>
  <chapter eid="1CH 10"/>
  <chapter number="11" style="c" sid="1CH 11"/>
  <para style="s1">ዳዊት ሞቲ እስራኤል ተኤ</para>
  <para style="r">
    <ref loc="1CH 11:1-3">11፥1‑3</ref> ኩወፈ – <char style="xt"><ref loc="2SA 5:1-3">2ሳሙ 5፥1‑3</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 11:1"/>እስራኤሎን ሁንድኑ ኬብሮንት ዳዊት ብረት ወልት ዹፈኒ አከነ ጄዸን፤ “ኑ ፎኒፊ ዺገኬት። <verse eid="1CH 11:1"/><verse number="2" style="v" sid="1CH 11:2"/>ዱራን፣ ዬሮ ሳኦል ሞቲ ቱሬትዩ ነምን ዱለ ሎልቶተ እስራኤል ሆገኑ ስእ ቱሬ። <char style="nd">ዋቀዮ</char> ዋቅንኬስ፣ ‘ስቱ ሰበኮ እስራኤልን ትክሰ፤ ቡልቻሳኒስ ንታተ’ ሲን ጄዼ ቱሬ።”<verse eid="1CH 11:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 11:3"/>ዮሙ ማንጉዶትን እስራኤል ሁንድ ኬብሮንት ዳዊት ሞትቸ ብረ ዹፈንት፣ እን ኬብሮንት ፉለ <char style="nd">ዋቀዮ</char> ዱረት እሳን ወጅን ከኩ ገሌ። እሳንስ አኩመ <char style="nd">ዋቀዮ</char> ከራ ሳሙኤሊን አብደቺሴ ሰነት ድበኒ እስራኤልረት ሞቲ እሰ ጎዸን።<verse eid="1CH 11:3"/></para>
  <para style="s1">ዳዊት ዬሩሳሌምን ሞአቹሳ</para>
  <para style="r">
    <ref loc="1CH 11:4-9">11፥4‑9</ref> ኩወፈ – <char style="xt"><ref loc="2SA 5:6-10">2ሳሙ 5፥6‑10</ref></char></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 11:4"/>ዳዊቲፊ እስራኤሎን ሁንድኑ ገረ ዬሩሳሌምት ጄቹንስ ዬቡሲት ንቀጄለን። ዬቡሶን አች ጅራተን ገሩ <verse eid="1CH 11:4"/><verse number="5" style="v" sid="1CH 11:5"/>ዳዊቲን፣ “አት አስ ህንሴንቱ” ጄዸን። ተኡስ ዳዊት ደአትኖ ጥዮን ጄቹንስ መጋላ ዳዊት ንቀበቴ።<verse eid="1CH 11:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 11:6"/>ዳዊትስ፣ “ነምን ዱራን ዱርሴ ዸቄ ዬቡሶተ ሎሉ አጀጃ ሎልቶታ ተአ” ጄዼ ቱሬ። ዮኣብ እልም ዜሩያ ጀልቀበት በኤ፤ ከናፉ እን አጀጃ ወራና ተኤ።<verse eid="1CH 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 11:7"/>ዳዊትስ እዶ ጅሬኘሳ ደአትኖ ሰነ ኬሰ ጎዸቴ፤ ከናፉ ደአኖን ሱን መጋላ ዳዊት ጄዸሜ ዋመሜ። <verse eid="1CH 11:7"/><verse number="8" style="v" sid="1CH 11:8"/>እንስ ሚሎዻ ጀልቀቤ ናኖሼት ደላ ዸጋ ንእጃሬ፤ ዮኣብሞ ኩታ መጋላ ሰና ከን ሀፌ ዴብሴ እጃሬ። <verse eid="1CH 11:8"/><verse number="9" style="v" sid="1CH 11:9"/>ዳዊትስ ሰበቢ <char style="nd">ዋቀዮ</char>ን ዋን ሁንደ ደንደኡ እሰ ወጅን ቱሬፍ ዬሩመ ዬሮን ጀባቻ ዹፌ።<verse eid="1CH 11:9"/></para>
  <para style="s1">ነሞተ ዳዊት ጀጀቤዪ</para>
  <para style="r">
    <ref loc="1CH 11:10-41">11፥10‑41</ref> ኩወፈ – <char style="xt"><ref loc="2SA 23:8-39">2ሳሙ 23፥8‑39</ref></char></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 11:10"/>ነሞተ ዳዊት ወረ ጀጀቦ ኬሳ ሀንገፎትን ከኔኒዸ፤ እሳንስ አኩመ <char style="nd">ዋቀዮ</char> ዋኤ እስራኤል ዱበቴ ሰነት ሞቲ እሰ ጎቹፍ ጄዸኒ ሰበ እስራኤል ሁንደ ወጅን ሞቱማሳ ኬሰት ገርጋርሰ ጉዳ ጎዸኒፍ። <verse eid="1CH 11:10"/><verse number="11" style="v" sid="1CH 11:11"/>መቃን ነሞተ ዳዊት ወረ ጀጀቦ ከናዸ፦</para>
  <para style="p" vid="1CH 11:11">ያሾብኣም ነምች ጎሰ ሀክሞን ሀንገፈ አጀጆተ ሰና ቱሬ፤ እንስ ሎለ ቶኮረት ኤቦ ምርምርሴ ነሞተ ዽበ ሰዲ ፍጤ።<verse eid="1CH 11:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 11:12"/>ከን እሰት ኣኑሞ ኤሌኣዛር ነምቸ ጎሰ አሆኣ፣ እልመ ዶዶ ቱሬ፤ እንስ ነሞተ ጀጀቦ ሰደን ሰነ ኬሳ ቶኮ ቱሬ። <verse eid="1CH 11:12"/><verse number="13" style="v" sid="1CH 11:13"/>ኤሌኣዛር ዬሮ ፍልስጤሞትን ወራናፍ ወልት ቀበመኒ ቱረንት ዳዊት ወጅን ጳስ ደሚም ቱሬ። ሎልቶትንስ ለፈ ቆቲሳ ከን ገርቡዻን ጉተሜ ቶኮ ብረት ፍልስጤሞተ ዱራ በቀተን። <verse eid="1CH 11:13"/><verse number="14" style="v" sid="1CH 11:14"/>እኒፊ ዳዊት ገሩ ለፈ ቆቲሳ ወለካት እዶ ቀበተን። እሳንስ እራ እትሱዻን ፍልስጤሞተ ፍጠን፤ <char style="nd">ዋቀዮስ</char> ሞአትና ጉዳ እሳኒፍ ኬኔ።<verse eid="1CH 11:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 11:15"/>ኡቱመ ገሬን ፍልስጤሞታ ሱሉለ ሬፋይም ኬሰ ቁበቴ ጅሩ ሀንገፎተ ሶዶመን ሰነ ኬሳ ነሞትን ሰዲ ገረ ከታ ሆልቀ አዱላምት ገረ ዳዊት ገድ ቡአን። <verse eid="1CH 11:15"/><verse number="16" style="v" sid="1CH 11:16"/>ዬሮ ሰነት ዳዊት ደአትኖ ጭማ ኬሰ ቱሬ፤ ሎልቶትን ፍልስጤምሞ ቤትልሄም ቱረን። <verse eid="1CH 11:16"/><verse number="17" style="v" sid="1CH 11:17"/>ዳዊትስ ዼቦቴ፣ “ኡቱ ነምን ቶኮ ቦለ ብሻኒ ከን ከረ ቤትልሄም ብረ ጅሩ ኬሳ ብሻን ዹጋቲ ና ፍዴሆ!” ጄዼ። <verse eid="1CH 11:17"/><verse number="18" style="v" sid="1CH 11:18"/>ከናፉ ነሞትን ሰደን ሱን ቁበተ ፍልስጤሞታ ኬሳን ደርበኒ ቦለ ብሻኒ ከን ከረ ቤትልሄም ብረ ጅሩ ኬሳ ብሻን ወራበኒ ዳዊቲፍ ፍደን። እን ገሩ ዹጉ ንድዴ፤ ቆደ ከና ብሻን ሰነ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዸንገላሴ። <verse eid="1CH 11:18"/><verse number="19" style="v" sid="1CH 11:19"/>እንስ፣ “አከ አን ዋን ከነ ህንጎኔ ዋቅን ነራ ሃፈጌሱ! አን ዺገ ነሞተ ሉቡ ኦፊሳኒት ሙረኒ ዸቀን ከና ነንዹጋ?” ጄዼ። ሰበቢ እሳን ሉቡ ኦፊሳኒት ሙረኒ ዸቀኒ ፍደኒፍ ዳዊት ብሻን ሰነ ህንዹግኔ።</para>
  <para style="p" vid="1CH 11:19">ኤጋ ወን ነሞትን ጀጀቦን ሰደን ሱን ሆጄተን ከነ ቱሬ።<verse eid="1CH 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 11:20"/>አቢሻይ ኦቦሌስ ዮኣብ ሆገና ሰደንሳኒ ቱሬ። እንስ ነሞተ ዽበ ሰዲት ኤቦሳ ኦል ካፈቴ እሳን ፍጤ፤ አከሲን እንስ አኩመ ነሞተ ሰደን ሰና ቤከማ ተኤ። <verse eid="1CH 11:20"/><verse number="21" style="v" sid="1CH 11:21"/>እን ዮ እሳን ኬሳ ቶኮ ተኡ ባቴዩ ወረ ሰደን ጫላ ኡልፍነ አርገቴ አጀጃሳኒ ተኤ።<verse eid="1CH 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 11:22"/>ቤናያ እልም ዬሆያዳ ሎልቱን ጭማን ብየ ቀብዝኤል ሱንስ ሎልቱ ሞአትና ጉርጉዳ አርገምሲሴ ቱሬ። እንስ ሎልቶተ ሞኣብ ከኔን አከ መሌ ጀጀቦ ተአን ለመ አጄሴ። ጋፈ ጨቢን ሮቤ ቶኮስ ቦለ ኬሰ ሴኔ ሌንጨ አጄሴ። <verse eid="1CH 11:22"/><verse number="23" style="v" sid="1CH 11:23"/>ነምቸ ብየ ግብጥ ከን ዹንዹመ ሸን ዼረቱ ቶኮሌ ንአጄሴ። ነምች ግብጥ ሱን ኤቦ አከ ደንቀራ ወየ ዾፍቱ ሀርካ ቀባቱዩ ቤናያ ቦኩዻን እሰት በኤ። እንስ ሀርከ ነምቸ ግብጥ ሰናቲ ኤቦ ቡተቴ ኤቦዹመሳቲን እሰ አጄሴ። <verse eid="1CH 11:23"/><verse number="24" style="v" sid="1CH 11:24"/>ሆጂወን ጎቱማ ከኔን ቤናያ እልም ዬሆያዳ ሆጄቴ ከነ ፈእ፤ እንስ አኩመ ነሞተ ጀጀቦ ሰደን ሰና ነመ ቤከማ ቱሬ። <verse eid="1CH 11:24"/><verse number="25" style="v" sid="1CH 11:25"/>እን ነሞተ ሶዶመን ሰነ ኬሳ ነመ ከምዩ ጫላ ኡልፍነ ጉዳ አርገቴ፤ ገሩ ነሞተ ሰደን ሰነት ህንደበለምኔ። ዳዊትስ አጀጃ ኤግዶተ ኦፊሳ እሰ ጎዸቴ።<verse eid="1CH 11:25"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="26" style="v" sid="1CH 11:26"/>ነሞትን ጀጀቦን ሱንስ ከኔኒዸ፦</para>
  <para style="b" vid="1CH 11:26"/>
  <para style="li1" vid="1CH 11:26">አሳሄል ኦቦሌሰ ዮኣብ፣</para>
  <para style="li1" vid="1CH 11:26">ኤልሃናን ነምቸ ቤትልሄም እልመ ዶዶ፣<verse eid="1CH 11:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 11:27"/>ሸሞት ነምቸ ጎሰ ሀሮር፣</para>
  <para style="li1" vid="1CH 11:27">ሄሌዝ ነምቸ ጎሰ ጴሎና፣<verse eid="1CH 11:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 11:28"/>ኢራ እልመ እቄሽ ነመ ቴቆኣ፣</para>
  <para style="li1" vid="1CH 11:28">አቢኤዜር ነመ አናቶት፣<verse eid="1CH 11:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 11:29"/>ሲቤካይ ነመ ብየ ሁሻ፣</para>
  <para style="li1" vid="1CH 11:29">ኢላይ ነመ አሆኣ፣<verse eid="1CH 11:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 11:30"/>መሀራይ ነመ ኔቶፋ፣</para>
  <para style="li1" vid="1CH 11:30">ሄሌድ እልመ በአና ነመ ኔቶፋ፣<verse eid="1CH 11:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 11:31"/>ጎሰ ቤንያም ኬሳ</para>
  <para style="li1" vid="1CH 11:31">ኢታይ እልመ ሪባይ፣ ነምቸ ግቤኣ፣</para>
  <para style="li1" vid="1CH 11:31">ቤናያ ነመ ጵራቶን፣<verse eid="1CH 11:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 11:32"/>ሁራይ ነምቸ ሱሉሎተ ገኣሽ፣</para>
  <para style="li1" vid="1CH 11:32">አቢኤል ነምቸ ብየ አርባ፣<verse eid="1CH 11:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 11:33"/>አዝማዌት ነምቸ በሀሩም፣</para>
  <para style="li1" vid="1CH 11:33">ኤሊያባ ነምቸ ሸአልቦን፣<verse eid="1CH 11:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 11:34"/>እልማን ሃሼም ነምቸ ግዞን፣</para>
  <para style="li1" vid="1CH 11:34">ዮናታን እልመ ሻጌ ነምቸ ሀራራ፣<verse eid="1CH 11:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 11:35"/>አሂኣም እልመ ሳካር ነምቸ ሀራራ፣</para>
  <para style="li1" vid="1CH 11:35">ኤሊፋል እልመ ኡር፣<verse eid="1CH 11:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 11:36"/>ሄፌር ነምቸ ሜኬራታ፣</para>
  <para style="li1" vid="1CH 11:36">አሂያ ነምቸ ጴሎና፣<verse eid="1CH 11:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 11:37"/>ሄዝሮ ነመ ቀርሜሎስ፣</para>
  <para style="li1" vid="1CH 11:37">ነአራይ እልመ ኤዝበይ፣<verse eid="1CH 11:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 11:38"/>ዮኤል ኦቦሌሰ ናታኒ፣</para>
  <para style="li1" vid="1CH 11:38">ምቤሃር እልመ ሀግሪ፣<verse eid="1CH 11:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 11:39"/>ዜሌቅ ነምቸ ጎሰ አሞን፣</para>
  <para style="li1" vid="1CH 11:39">ነሃራይ ነምቸ ብኤሮት ከን ዮኣብ እልመ ዜሩያቲፍ ምአ ሎላ ባቱ ሰነ፣<verse eid="1CH 11:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 11:40"/>ኢራስ ነምቸ ጎሰ ይትራ፣</para>
  <para style="li1" vid="1CH 11:40">ጋሬብ ነምቸ ጎሰ ይትራ፣<verse eid="1CH 11:40"/></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 11:41"/>ኡርያ ነምቸ ሄት፣</para>
  <para style="li1" vid="1CH 11:41">ዛባድ እልመ አህለይ፣<verse eid="1CH 11:41"/></para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 11:42"/>ኣዲና እልመ ሺዛ ነምቸ ጎሰ ሩቤን፣ እን ሆገና ሩቤኖታቲፊ ከን ነሞተ ሶዶመን እሰ ወጅን ቱረኒት፤<verse eid="1CH 11:42"/></para>
  <para style="li1">
    <verse number="43" style="v" sid="1CH 11:43"/>ሃናን እልመ መአካ፣</para>
  <para style="li1" vid="1CH 11:43">ዮሻፋጥ ነምቸ ሚትና፣<verse eid="1CH 11:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 11:44"/>ኡዝያ ነምቸ አሽቴራት፣</para>
  <para style="li1" vid="1CH 11:44">ሻማኢፊ ዬኢኤል እልማን ሆታም ነምቸ አሮኤር፣<verse eid="1CH 11:44"/></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 11:45"/>ዬድያኤል እልመ ሽምሪ፣</para>
  <para style="li1" vid="1CH 11:45">ኦቦሌሰሳ ዮሃ ነምቸ ቲዚ፣<verse eid="1CH 11:45"/></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 11:46"/>ኤሊኤል ነምቸ መሀዋ፣</para>
  <para style="li1" vid="1CH 11:46">ዬሪባዪፊ ዮሸብያ እልማን ኤልነአም፣</para>
  <para style="li1" vid="1CH 11:46">ይትማ ነምቸ ሞኣብ፣<verse eid="1CH 11:46"/></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 11:47"/>ኤሊኤል፣ ኦቤዲፊ የእሲኤል ነምቸ ሜዞባ።<verse eid="1CH 11:47"/></para>
  <chapter eid="1CH 11"/>
  <chapter number="12" style="c" sid="1CH 12"/>
  <para style="s1">ሎልቶትን ዳዊትት ደበለሙሳኒ</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 12:1"/>ነሞትን ኩኔን ወረ ዬሮ እን ሰበቢ ሳኦል እልመ ቂሽ ሰናቲፍ አሲፊ አች ሶቾኡ ደዸቤት ሲቅላግት ገረ ዳዊት ዹፈኒዸ። እሳንስ ሎልቶተ ጀጀቦ ከኔን ሎለረት እሰ ገርጋረን ኬሳ ቶኮዸ፤ <verse eid="1CH 12:1"/><verse number="2" style="v" sid="1CH 12:2"/>እሳን ወረ እዳ ቀበተኒ ሀርከ ምርጋቲን ዮካን ሀርከ ብታቲን ጥየ ደርበቹ ዮካን ዸጋ ፉርሱ ደንደአኒዸ፤ እሳንስ ጎሰ ቤንያም ኬሳ ወረ ሳኦሊፍ ፍሮታ ዺጋ ተአኒዸ።<verse eid="1CH 12:2"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 12:3"/>አሂኤዜር ሀንገፈሳኒ ቱሬ፤ ሰነ ቦዴሞ ዮኣሽቱ ቱሬ፤ ለማንሳኒዩ እልማን ሼማኣ ነምቸ ግቤኣ ሰና ቱረን።</para>
  <para style="li1" vid="1CH 12:3">እልማን አዝማዌት ይዚኤሊፊ ጴሌት፣</para>
  <para style="li1" vid="1CH 12:3">ቤራክያ፣ ዬሁ ነምቸ አናቶት፣ <verse eid="1CH 12:3"/><verse number="4" style="v" sid="1CH 12:4"/>ይሽመእያ ነምች ግቤኦኒ ሱን ጀረ ሶዶመን ኬሳ ነመ ጀባፊ ሆገና ሶዶመንሳኒ ቱሬ፤</para>
  <para style="li1" vid="1CH 12:4">ኤርምያስ፣ የህዚኤል፣ ዮሃናን፣ ዮዛባድ ነምቸ ጌዴራ፣ <verse eid="1CH 12:4"/><verse number="5" style="v" sid="1CH 12:5"/>ኤልኡዘይ፣ ዬሪሞት፣ ቤኣልያ፣ ሼማርያ፣ ሼፋጥያ ነምቸ ሀሩፋ፣<verse eid="1CH 12:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 12:6"/>ኤልቃና፣ ይሽያ፣ አዘርኤል፣ ዮዜሪፊ ያሾብኣም ጀሬን ጎሰ ቆራህ፣<verse eid="1CH 12:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 12:7"/>ዮኤላፊ ዜባድያ እልማን ዬሮሃም ነምቸ ጌዶር።<verse eid="1CH 12:7"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="8" style="v" sid="1CH 12:8"/>ዬሮ ዳዊት ገሞጂት ደኦ ኬሰ ቱሬት ነሞትን ጎሰ ጋድ ቶኮ ቶኮ ዹፈኒ እሰት ንደበለመን። እሳንስ ሎልቶተ ጭጭሞ ጋቸናፊ ኤቦ ቀበቹ ደንደአን ከኔን ወራናፍ ቆጳአን ቱረን። ፉልሳኒ ፉለ ሌንጫ ፈካተ ቱሬ፤ እሳን አኩመ ኩሩጴ ቱሉ ጉባ ሰፍስቶተ ቱረን።<verse eid="1CH 12:8"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 12:9"/>ኤዜር ሆገናሳኒ ቱሬ፤</para>
  <para style="li1" vid="1CH 12:9">ኦባድያን ለመፋ፣ ኤሊያብ ሰደፋ፣<verse eid="1CH 12:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 12:10"/>ምሽመናን አፉረፋ፣ ኤርምያስ ሸነፋ፣<verse eid="1CH 12:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 12:11"/>አታይ ጀአፋ፣ ኤሊኤል ቶርበፋ፣<verse eid="1CH 12:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 12:12"/>ዮሃናን ሰዴተፋ፣ ኤልዛባድ ሰግለፋ፣<verse eid="1CH 12:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 12:13"/>ኤርምያስ ኩርነፋ፣ መክበናይ ኩዸ ቶኮፋ ቱሬ።<verse eid="1CH 12:13"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="14" style="v" sid="1CH 12:14"/>ጀሬን ጎሰ ጋድ ኩኔን አጀጆተ ሎልቶታ ቱረን፤ እሳን ኬሳ እን ጥናን አከ አጀጃ ነመ ዽባት፣ እን ጉዳንሞ አከ አጀጃ ነመ ኩማት ሄደመ ቱሬ። <verse eid="1CH 12:14"/><verse number="15" style="v" sid="1CH 12:15"/>ወር ጅአ ጀልቀባት ዬሮ ለግን ዮርዳኖስ ጉቴ ኤዴደሳ ሁንደረ ዸንገለኡት ጬአኒ አከ ነሞትን ሱሉልቸ ኬሰ ጅራቻ ቱረን ገረ በአ ቢፍቱቲፊ ገረ ልጠ ቢፍቱት በቀተን ጎዸን ነሞቱመ ከኔን ቱረን።<verse eid="1CH 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 12:16"/>ነሞትን ቤንያሚቲፊ ይሁዳ ቶኮ ቶኮስ ዳዊት ብረ ገረ ደአትኖሳ ንዹፈን። <verse eid="1CH 12:16"/><verse number="17" style="v" sid="1CH 12:17"/>ዳዊትስ እሳን ስመቹዻፍ ገድ በኤ አከነ ጄዼን፤ “እስን ዮ ነ ገርጋሩዻፍ ጄተኒ ነጋዻን ዹፍተኒ ጅራተን፣ አን ኦፍት እስን ደበለቹዻፍ ቆጳኣዸ። ገሩ ዮ እስን ኡቱ ሀርክኮ የከ ህንሆጄትን ዲኖተኮት ደበርስተኒ ነ ኬኑዻፍ ዹፍተኒ ጅራተን፣ ዋቅን አቦቲኬኛ እላሌ ሙርቲ ሃኬኑ።”<verse eid="1CH 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 12:18"/>ኤርገሲስ ሀፉር ቁልቁሉን አማሳይ ሆገና ነሞተ ሶዶመን ሰናረ ቡኤ፤ እንስ አከነ ጄዼ፦</para>
  <para style="q1" vid="1CH 12:18">“ያ ዳዊት፣ ኑ ከንኬት!</para>
  <para style="q2" vid="1CH 12:18">ያ እልመ እሴይ፣ ኑ ሱመ ወጅን ጅረ!</para>
  <para style="q1" vid="1CH 12:18">ምልካእ፣ ምልካእ፤</para>
  <para style="q2" vid="1CH 12:18">ወር ስ ገርጋረንስ ሃምልካአን፤</para>
  <para style="q3" vid="1CH 12:18">ዋቅንኬ ስ ገርጋራቲ።”</para>
  <para style="p" vid="1CH 12:18">ከናፉ ዳዊት እሳን ስመቴ ዱረ ዴምቶተ ሎልቶተሳ እሳን ጎዸቴ።<verse eid="1CH 12:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 12:19"/>ዬሮ ዳዊት ሳኦልን ሎሉፍ ጄዼ ፍልስጤሞተ ወጅን ዱሌት ነሞትን ምናሴ ቶኮ ቶኮ ፎቶቀኒ ገረ ዳዊትት ንጎረን። እን ገሩ ሰበቢ ቡልችቶትን ፍልስጤም መርአተኒ ኦፍራ እሰ አርአኒፍ እኒፊ ነሞትንሳ ፍልስጤሞተ ህንገርጋሬ። እሳንስ፣ “ዮ እን ኑ ዺሴ ገረ ጎፍታሳ ገረ ሳኦል ዴብኤ ወን ኩን ኑ ፍጭሲሰ” ጄዸኒ ቱረኒቲ። <verse eid="1CH 12:19"/><verse number="20" style="v" sid="1CH 12:20"/>ዬሮ ዳዊት ገረ ሲቅላግ ዴሜት ነሞትን ምናሴ ወር ፎቶቀኒ ገረሳ ጎረን ከኔኒዸ፦ አድናህ፣ ዮዛባድ፣ ዬዲኤል፣ ሚካኤል፣ ዮዛባድ፣ ኤሊሁፊ ዝሌታይ፤ እሳን ኩኔን ጎሰ ምናሴ ኬሰት አጀጁወን ኩማ ቱረን። <verse eid="1CH 12:20"/><verse number="21" style="v" sid="1CH 12:21"/>እሳንስ በላ ቡፍቶተ ዸኡረት ዳዊትን ንገርጋረን፤ ሁንድሳኒ ሎልቶተ ጀጀቦፊ አጀጆተ ሎልቶተሳ ቱረኒቲ። <verse eid="1CH 12:21"/><verse number="22" style="v" sid="1CH 12:22"/>ሀመ እን ሎልቶተ ጉዳ አከ ሎልቶተ ዋቃ ቀባቱት፣ ነሞትን ዳዊትን ገርጋሩዻፍ ጉያ ጉያዻን ገረሳ ዹፋ ቱሬ።<verse eid="1CH 12:22"/></para>
  <para style="s1">ነሞትን ብራስ ኬብሮንት ዳዊትት ደበለመን</para>
  <para style="lh">
    <verse number="23" style="v" sid="1CH 12:23"/>ባይእን ነሞተ ሎላፍ ህዸተኒ አኩመ <char style="nd">ዋቀዮ</char> ዱበቴ ቱሬት ሞቱማ ሳኦል ገረ ዳዊቲት ደበርሱዻፍ ጄዸኒ ዳዊት ብረ ገረ ኬብሮኒ ዹፈኒ ከኔኒዸ፦<verse eid="1CH 12:23"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 12:24"/>ነሞትን ይሁዳ ከኔን ጋቸናፊ ኤቦ ቀበተኒ ሎላፍ ቆጳአን 6,800፤<verse eid="1CH 12:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 12:25"/>ነሞትን ስምኦኒ ሎልቶትን ወራናፍ ቆጳአን 7,100፤<verse eid="1CH 12:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 12:26"/>ነሞትን ሌዊ 4,600፤ <verse eid="1CH 12:26"/><verse number="27" style="v" sid="1CH 12:27"/>ዬሆያዳን ሆገና ማቲ አሮን ቱሬ፤ ነሞትን 3,700 እሰ ወጅን ቱረን፤ <verse eid="1CH 12:27"/><verse number="28" style="v" sid="1CH 12:28"/>ዛዶቅ ደርገጌሰ ሎልቱ ጀግና ሰናፊ ማቲሳ ኬሳ አጀጆተ ወራና 22፤<verse eid="1CH 12:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 12:29"/>ነሞትን ቤንያም ከኔን ፍሮተ ሳኦሊ ተአን 3,000፤ እሳን ኬሳስ ሄዱንሳኒ ሀመ ዬሮ ሰናት መነ ሳኦሊቲፍ አመነሞ ቱረን፤<verse eid="1CH 12:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 12:30"/>ነሞትን ኤፍሬም ወር ሎለት ጭጭሞፊ በልበለሳኒ ኬሰት ቤቤከሞ ተአን 20,800፤<verse eid="1CH 12:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 12:31"/>ወለካ ጎሰ ምናሴ ኬሳ ነሞትን ዳዊትን ሞቲ ጎቹዻፍ መቃንሳኒ ገልማኤ ዹፈን 18,000፤<verse eid="1CH 12:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 12:32"/>ነሞተ ይሳኮር ኬሳ ወረ ሃለ ዬሮ ሁበተኒ ዋን እስራኤሎን ጎቹ ቀበን ቤከን ሀንገፎተ 200፣ ፍሮተሳኒ ከኔን እሳን ጀለት ቡለን ሁንደ ወጅን፤<verse eid="1CH 12:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 12:33"/>ነሞተ ዜቡሎን ኬሳ ሎልቶትን ሙጠትኖ ቀበን ወር ሜሻ ሎላ ከሚንዩ ሎሉፍ ቆጳአን ከኔን ዳዊትን ገርጋሩፍ ገራንሳኒ ቶኮ ተኤ 50,000፤<verse eid="1CH 12:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 12:34"/>ነሞተ ንፍታሌም ኬሳ አጀጆተ 1,000፤ ነሞተ ጋቸናፊ ኤቦ ቀበተን 37,000 ወጅን፤<verse eid="1CH 12:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 12:35"/>ነሞተ ዳን ከኔን ሎላፍ ቆጳአን 28,600፤<verse eid="1CH 12:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 12:36"/>ነሞተ ኣሼር ኬሳ ሎልቶትን ሙጠትኖ ቀበን ከኔን ሎላፍ ቆጳአን 40,000፤<verse eid="1CH 12:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 12:37"/>ገመ በአ ዮርዳኖሲቲ ነሞተ ሩቤን፣ ነሞተ ጋዲቲፊ ወለካ ጎሰ ምናሴ ኬሳ ነሞተ ምአ ሎላ ከን ጎሰ ሁንዳ ህዸተን 120,000።<verse eid="1CH 12:37"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="38" style="v" sid="1CH 12:38"/>እሳን ኩኔን ሁንድኑ ሎልቶተ ወራነ ኬሰ ተጃጅሉዻፍ ኦፍ ኬነኒዸ።</para>
  <para style="b" vid="1CH 12:38"/>
  <para style="p" vid="1CH 12:38">እሳንስ እስራኤል ሁንደረት ዳዊትን ሞቲ ጎቹፍ ኩተተኒ ገረ ኬብሮን ንዹፈን። እስራኤሎን ሀፈን ሁንድኑስ ዳዊትን ሞቲ ጎቹፍ ያዱመ ቶኮ ቀቡ ቱረን። <verse eid="1CH 12:38"/><verse number="39" style="v" sid="1CH 12:39"/>ነሞትንስ ሰበቢ ማቲንሳኒ ዋን ሁንደ እሳኒፍ ቆጴሰኒፍ ኛቻ ዹጋ ጉያ ሰዲ ዳዊት ወጅን አች ቱረን። <verse eid="1CH 12:39"/><verse number="40" style="v" sid="1CH 12:40"/>አከሱመስ ኦሎትንሳኒ ከኔን ሀመ ይሳኮሪት፣ ዜቡሎንቲፊ ንፍታሌሚት ጅረን ሀሮተት፣ ጋለወንት፣ ጋንጎሊፊ ሰንጎተት ኛተ ፌአኒ ፍደኒ ንዹፈን። ሰበቢ እስራኤል ኬሰ ገመቹን ጉዳን ቱሬፍስ ዳኩን፣ ብጥሌን እጀ ሀርቡቲፊ ብጥሌን እጀ ወይኒ፣ ዳዺን ወይኒ፣ ዘይቲን፣ ሎኒፊ ሆሎትን አከ መሌ ባይኤን ዽኤፈመኒ ቱረን።<verse eid="1CH 12:40"/></para>
  <chapter eid="1CH 12"/>
  <chapter number="13" style="c" sid="1CH 13"/>
  <para style="s1">ታቦተ ዴብሰኒ ፍደን</para>
  <para style="r">
    <ref loc="1CH 13:1-14">13፥1‑14</ref> ኩወፈ – <char style="xt"><ref loc="2SA 6:1-11">2ሳሙ 6፥1‑11</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 13:1"/>ዳዊት አጀጆተሳ ሁንደ አጀጆተ ኩማቲፊ አጀጆተ ዽባ ወጅን ንመርአቴ። <verse eid="1CH 13:1"/><verse number="2" style="v" sid="1CH 13:2"/>ኤርገሲ እን ያኢ እስራኤል ጉቱዻን አከነ ጄዼ፤ “ዮ ወን ኩን ዋን ጋሪ እስንት ፈካቴፊ ዮ ፌዺ <char style="nd">ዋቀዮ</char> ዋቀኬኛ ተኤ፣ ኮታ ሜ አከ እሳን ዹፈኒ ኑት ደበለመኒፍ ኦቦሎተኬኘ ከኔን ጉቱማ ብየ እስራኤል ኬሰት ሀፈንት አከሱመስ ሉቦታፊ ሌዎተ እሳን ወጅን መጋላወኒፊ ለፈ ዼደሳኒ ኬሰ ጅራተንት ኤርጋ ሃኤርግኑ። <verse eid="1CH 13:2"/><verse number="3" style="v" sid="1CH 13:3"/>ታቦተ ዋቀኬኛ ዴብፍኔ ሃፍደትኑ፤ ኑ በረ ሞቱማ ሳኦል ኬሰ እሰ ህንበርባኔቲ።” <verse eid="1CH 13:3"/><verse number="4" style="v" sid="1CH 13:4"/>ሰበቢ ወን ኩን ሰበ ሁንደት ዋን ቀጄላ ፈካቴፍ ጉቱማን ያኢ ሰና ዋን ከነ ጎቹዻፍ ወሊ ገሌ።<verse eid="1CH 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 13:5"/>ከናፉ ዳዊት ታቦተ ዋቃ ክርያት ዬኣሪሚ ፍዱዻፍ እስራኤሎተ ለገ ሽሆሪ ከን ብየ ግብጢት አርገሙ ጀልቀቤ ሀመ ከረ ሀማቲት ጅረን ሁንደ ወልት ቀቤ። <verse eid="1CH 13:5"/><verse number="6" style="v" sid="1CH 13:6"/>ዳዊቲፊ እስራኤሎን እሰ ወጅን ቱረን ሁንድ ታቦተ ዋቀ ኪሩቤሊ ግዱ ቴሶረ ጅሩ ሰና ጄቹንስ ታቦተ መቃ <char style="nd">ዋቀዮቲን</char> ዋመሙ ሰነ አቺ ፍዱፍ ጄዸኒ ገረ በኣላ ጄቹንስ ገረ ክርያት ዬኣሪም እሼ ይሁዳ ኬሳ ሰና ንዸቀን።<verse eid="1CH 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 13:7"/>እሳንስ ታቦተ ዋቃ ሰነ ጋሪ ሃራት ፌአኒ መነ አቢናዳቢቲ ንባሰን፤ ኡዛፊ አሂዮን ጋሪ ሰነ ኦፋ ቱረን። <verse eid="1CH 13:7"/><verse number="8" style="v" sid="1CH 13:8"/>ዳዊቲፊ እስራኤሎን ሁንድኑ ሁምነሳኒ ጉቱዻን ፋርፈትናፊ በገናዻን፣ ክራራፊ ድቤዻን፣ ክልሌፊ መለከታን ፉለ ዋቃ ዱረት ገመደኒ ሹብሳ።<verse eid="1CH 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 13:9"/>ዮሙ እሳን ኦብዲ ኪዶን ብረ ገአንት ዋን ሰንጎን ጉፈተኒፍ ኡዛን ታቦተ ሰነ ቀቡፍ ሀርከሳ ሂጠቴ። <verse eid="1CH 13:9"/><verse number="10" style="v" sid="1CH 13:10"/>ሰበቢ ኡዛን ታቦተረ ሀርከሳ ካኤፍ ዼከምስ <char style="nd">ዋቀዮ</char> ኡዛት ቦበኤ፤ እንስ እሰ ሩኩቴ፤ ከናፉ እን አቹመት ፉለ ዋቃ ዱረት ንዱኤ።<verse eid="1CH 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 13:11"/>ዳዊትስ ሰበቢ <char style="nd">ዋቀዮ</char> አከ መሌ ኡዛት ዼከሜፍ ንኣሬ፤ እዶን ሱን ሀመ ሀርኣት ጴሬዝ ኡዛ<note caller="+" style="f"><char style="fr" closed="false">13፥11 </char><char style="fq" closed="false">ጴሬዝ ኡዛ </char><char style="ft" closed="false">ጄቹን </char><char style="fqa" closed="false">ገላፈተሙ </char><char style="ft" closed="false">ጄቹዸ።</char></note> ጄዸሜ ዋመመ።<verse eid="1CH 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 13:12"/>ዳዊትስ ጋፈ ሰነ ዋቀ ሶዳቴ፣ “አን አከምተን ታቦተ ዋቃ ገረ መነኮት ፍዱ ደንደአ?” ጄዼ ጋፈቴ። <verse eid="1CH 13:12"/><verse number="13" style="v" sid="1CH 13:13"/>እንስ አከ ታቦትን እሰ ወጅን መጋላ ዳዊት ኬሰ ጅራቱፍ ኦፍት ህንፉዸትኔ። ቆደ ከና ገረ መነ ኦቤድ ኤዶም ነምቸ ግቲ ሰናት ጌሴ። <verse eid="1CH 13:13"/><verse number="14" style="v" sid="1CH 13:14"/>ታቦትን ዋቃስ ጅአ ሰዲ ማቲ ኦቤድ ኤዶም ወጅን መነሳ ኬሰ ቱሬ፤ <char style="nd">ዋቀዮስ</char> ወረ መነሳ ጅራተኒፊ ዋን እን ቀቡ ሁንደ ንኤብሴ።<verse eid="1CH 13:14"/></para>
  <chapter eid="1CH 13"/>
  <chapter number="14" style="c" sid="1CH 14"/>
  <para style="s1">መነ ዳዊቲፊ ማቲሳ</para>
  <para style="r">
    <ref loc="1CH 14:1-7">14፥1‑7</ref> ኩወፈ – <char style="xt"><ref loc="2SA 5:11-16">2ሳሙ 5፥11‑16</ref>፤ <ref loc="1CH 3:5-8">1ሴና 3፥5‑8</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 14:1"/>ዬሮ ከነት ሁራም ሞቲን ጢሮስ አከ እሳን ዳዊቲፍ መሰራ ሞቱማ እጃረኒፍ ኤርገሞተ ወጅን ሙከ ብርብርሳ፣ ወረ ዸጋ ሶፈኒፊ ወረ ኦጉማ ሆጂ ሙካ ቀበን ገረ ዳዊትት ኤርጌ። <verse eid="1CH 14:1"/><verse number="2" style="v" sid="1CH 14:2"/>ዳዊትስ አከ <char style="nd">ዋቀዮ</char> ሰበ እስራኤልረት ሞቲ ጎዼ ጀቤሴ እሰ ዻቤፊ አከ ሞቱማንሳስ ሰበቢ ሰበ እስራኤሊፍ አከ መሌ ጉደቴ ንቤኬ።<verse eid="1CH 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 14:3"/>ዳዊትስ ዬሩሳሌም ኬሰት ኒቶተ ደበሌ ፉዼ እልማኒፊ እንተለን ደበለታ ዸልቼ። <verse eid="1CH 14:3"/><verse number="4" style="v" sid="1CH 14:4"/>መቃን እጆሌሳ ከኔን አችት እሳፍ ዸለተኒስ፦ ሸሙኣ፣ ሾባብ፣ ናታን፣ ሶሎሞን፣ <verse eid="1CH 14:4"/><verse number="5" style="v" sid="1CH 14:5"/>ይቤሃር፣ ኤሊሹዋ፣ ኤሊጴሌጥ፣ <verse eid="1CH 14:5"/><verse number="6" style="v" sid="1CH 14:6"/>ኖጋ፣ ኔፌግ፣ ያፊያ፣ <verse eid="1CH 14:6"/><verse number="7" style="v" sid="1CH 14:7"/>ኤሊሻማ፣ ቤልያዳፊ ኤሊጴሌጥ ጄዸሙ።<verse eid="1CH 14:7"/></para>
  <para style="s1">ዳዊት ፍልስጤሞተ ሞአቴ</para>
  <para style="r">
    <ref loc="1CH 14:8-17">14፥8‑17</ref> ኩወፈ – <char style="xt"><ref loc="2SA 5:17-25">2ሳሙ 5፥17‑25</ref></char></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 14:8"/>ፍልስጤሞትን ዮሙ አከ ዳዊት ድበሜ ጉቱማ እስራኤልረት ሞቲ ተኤ ዸገአንት ሁምነ ጉቱዻን እሰ በርባቸ ኦል በአን፤ ዳዊት ገሩ ዋን ከነ ዸገኤ እሳንት በኤ። <verse eid="1CH 14:8"/><verse number="9" style="v" sid="1CH 14:9"/>ዬሮ ከነት ፍልስጤሞትን ዹፈኒ ሱሉለ ሬፋይም ዌረረን፤ <verse eid="1CH 14:9"/><verse number="10" style="v" sid="1CH 14:10"/>ከናፉ ዳዊት፣ “አን በኤ ፍልስጤሞተ ዸኡ? አት ደበርስቴ ሀርከኮት እሳን ኬንታ?” ጄዼ ዋቀ ንጋፈቴ።</para>
  <para style="p" vid="1CH 14:10">
    <char style="nd">ዋቀዮስ</char>፣ “በእ፤ አን ዹጉማን ፍልስጤሞተ ደበርሴ ሀርከኬት ነንኬናቲ” ጄዼ ዴብሴፍ።<verse eid="1CH 14:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 14:11"/>ከናፉ ዳዊቲፊ ነሞትንሳ ገረ በኣል ጴራዚም ኦል በአን፤ አችትስ እሳን ሞአቴ። እንስ፣ “አኩመ ብሻን መነሳ ጨብሴ ያኡ ሰነ ዋቅን ሀርከኮቲን ዲኖተኮ ጨብሴ በኤረ” ጄዼ። ከናፉ እዶን ሱን በኣል ጴራዚም ጄዸሜ ዋመሜ። <verse eid="1CH 14:11"/><verse number="12" style="v" sid="1CH 14:12"/>ፍልስጤሞትን ዋቆተሳኒ ቶልፈሞ አችት ንዺሰን፤ ዳዊትሞ አከ ዋቆትን ሱን እብዳን ጉበመን ንአጀጄ።<verse eid="1CH 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 14:13"/>ፍልስጤሞትን አመሌ ዴብአኒ ሱሉለ ሰነ ዌረረን፤ <verse eid="1CH 14:13"/><verse number="14" style="v" sid="1CH 14:14"/>ከናፉ ዳዊት አመስ ዋቀ ጋፈቴ፤ ዋቅንስ አከነ ጄዼ ዴብሴፍ፤ “ቀጄሉመት እት ኦል ህንበእን፤ ገሩ እሳን መርሲቲ ሙከ ቅልጡ ዱረት እሳን ወራን። <verse eid="1CH 14:14"/><verse number="15" style="v" sid="1CH 14:15"/>አኩመ ፊጤ ሙከ ቅልጡ እራን ሰገሌ ዱላ ዸጌሴን ሎሉፍ በእ፤ ዋቅን ሎልቶተ ፍልስጤም ዸኡዻፍ ስ ዱረ በኤረ ጄቹዻቲ።” <verse eid="1CH 14:15"/><verse number="16" style="v" sid="1CH 14:16"/>ከናፉ ዳዊት አኩመ ዋቅን እሰ አጀጄ ሰነ ንጎዼ፤ እሳንስ ግቤኦኒ ጀልቀበኒ ሀመ ጌዝርት ሎልቶተ ፍልስጤም ንዸአን።<verse eid="1CH 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 14:17"/>አከሲን መቃን ዳዊት ብየ ሁንደ ኬሰት ቤከሜ፤ <char style="nd">ዋቀዮስ</char> አከ ሰቦትን ሁንድኑ እሰ ሶዳተን ጎዼ።<verse eid="1CH 14:17"/></para>
  <chapter eid="1CH 14"/>
  <chapter number="15" style="c" sid="1CH 15"/>
  <para style="s1">ታቦትን ገረ ዬሩሳሌም ፍደሜ</para>
  <para style="r">
    <ref loc="1CH 15:25-16:3">15፥25–16፥3</ref> ኩወፈ – <char style="xt"><ref loc="2SA 6:12-19">2ሳሙ 6፥12‑19</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 15:1"/>ዳዊት ኤርገ ኦፊሳቲፍ መጋላ ዳዊት ኬሰት መነ እጃረቴ ቦዴ ታቦተ ዋቃቲፍ ለፈ ቆጴሴ ዱንካነ ዻቤ። <verse eid="1CH 15:1"/><verse number="2" style="v" sid="1CH 15:2"/>ኤርገሲስ ዳዊት፣ “ዋን <char style="nd">ዋቀዮ</char> አከ እሳን ታቦተ ዋቃ ባተኒ በረ በራን ፉለሳ ዱረ ተጃጅለኒፍ እሳን ፍለቴፍ፣ ሌዎተ መሌ ነምን ብራ ታቦተ <char style="nd">ዋቀዮ</char> ህንባትን” ጄዼ አጀጄ።<verse eid="1CH 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 15:3"/>ዳዊትስ ታቦተ <char style="nd">ዋቀዮ</char> እዶ ቆጴሴፍ ሰነት ፍዱፍ እስራኤሎተ ሁንደ ዬሩሳሌምት ወልት ቀቤ።<verse eid="1CH 15:3"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="4" style="v" sid="1CH 15:4"/>እንስ ሰኚወን አሮኒፊ ሌዎተ ወልት ዋሜ፤ እሳንስ፦<verse eid="1CH 15:4"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 15:5"/>እልማን ቆሃት ኬሳ፣</para>
  <para style="li2" vid="1CH 15:5">ኡሪኤል ሆገና ሰናፊ ፍሮተሳ ነመ 120፤<verse eid="1CH 15:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 15:6"/>እልማን ሜራሪ ኬሳ፣</para>
  <para style="li2" vid="1CH 15:6">አሳያ ሆገና ሰናፊ ፍሮተሳ 220፤<verse eid="1CH 15:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 15:7"/>እልማን ጌርሾም ኬሳ፣</para>
  <para style="li2" vid="1CH 15:7">ዮኤል ሆገና ሰናፊ ፍሮተሳ 130፤<verse eid="1CH 15:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 15:8"/>እልማን ኤሊሳፋን ኬሳ፣</para>
  <para style="li2" vid="1CH 15:8">ሼማእያ ሆገና ሰናፊ ፍሮተሳ 200፤<verse eid="1CH 15:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 15:9"/>እልማን ኬብሮን ኬሳ፣</para>
  <para style="li2" vid="1CH 15:9">ኤሊኤል ሆገና ሰናፊ ፍሮተሳ 80፤<verse eid="1CH 15:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 15:10"/>እልማን ኡዚኤል ኬሳ፣</para>
  <para style="li2" vid="1CH 15:10">አሚናዳብ ሆገና ሰናፊ ፍሮተሳ ነመ 112።<verse eid="1CH 15:10"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="11" style="v" sid="1CH 15:11"/>ኤርገሲስ ዳዊት ሉቦተ ጄቹንስ ሳዶቂፊ አብያታር አከሱመስ ሌዎተ ጄቹንስ ኡሪኤል፣ አሳያ፣ ዮኤል፣ ሼማእያ፣ ኤሊኤሊፊ አሚናዳብን ንዋሜ፤ <verse eid="1CH 15:11"/><verse number="12" style="v" sid="1CH 15:12"/>አከነስ እሳኒን ጄዼ፤ “እስን ሀንገፎተ ማቲወን ሌዎታት፤ እስኒፊ ሌዎትን አከኬሰኒ ኦፍ ቁልቁሌሳ፤ ኤርገሲስ ታቦተ <char style="nd">ዋቀዮ</char> ዋቀ እስራኤል ገረ እዶ አን ቆጴሴፍት ፍዳ። <verse eid="1CH 15:12"/><verse number="13" style="v" sid="1CH 15:13"/>ሰበቢ እስን ሌዎትን ዬሮ ጀልቀባት ታቦተ ሰነ ህንፍድኒፍ <char style="nd">ዋቀዮ</char> ዋቅንኬኘ ኑት ዼከሜ። ኑ አከ ሴር አጀጁት እሰ ህንበርባደኔቲ።” <verse eid="1CH 15:13"/><verse number="14" style="v" sid="1CH 15:14"/>ከናፉ ሉቦትኒፊ ሌዎትን ታቦተ <char style="nd">ዋቀዮ</char> ዋቀ እስራኤል ሰነ ፍዱፍ ኦፍ ቁልቁሌሰን። <verse eid="1CH 15:14"/><verse number="15" style="v" sid="1CH 15:15"/>ሌዎትን አኩመ ከን ሙሴን ዱቢ <char style="nd">ዋቀዮቲን</char> አጀጄት ታቦተ ዋቃ ሰነ ደንቀራዻን ገቲቲሳኒት ንባተን።<verse eid="1CH 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 15:16"/>ዳዊትስ አከ እሳን ሜሻ ሙዚቃቲን ጄቹንስ ክራራን፣ በገናፊ ክልሌዻን ፋርፈትና ገመቹ ፋርፈተኒፍ አከ እሳን ኦቦሎተሳኒ ሙደኒፍ ሌዎተ ዱረ ዴምቶተት ንህሜ።<verse eid="1CH 15:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 15:17"/>ከናፉ ሌዎትን ሄማን እልመ ዮኤል ሙደተን፤ ኦቦሎተሳ ኬሳሞ አሳፍ እልመ ቤሬክያ፣ ኦቦሎተሳኒ ጎሰ ሜራሪ ኬሳ ኤታን እልመ ቂሳ ንሙደተን፤ <verse eid="1CH 15:17"/><verse number="18" style="v" sid="1CH 15:18"/>እሳን ወጅንስ ኦቦሎተሳኒ ከኔን እሳንት ኣነን፦ ዘካርያስ፣ የአዚኤል፣ ሼሚራሞት፣ ዬሂኤል፣ ኡኒ፣ ኤሊያብ፣ ቤናያ፣ መአሴያ፣ መቲትያ፣ ኤሊጴሌሁ፣ ሚቅኔያ፣ ኦቤድ ኤዶሚፊ ዬኢኤል ኤግዶተ በልበላ ቱረን።<verse eid="1CH 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 15:19"/>ፋርፈቶትን ሄማን፣ አሳፊፊ ኤታን ጄዸመን አከ ክልሌ ናሲቲን ሰገሌሳኒ ኦል ፉዸተኒ ፋርፈትና ዸጌስሰኒፍ ንሙደመን፤ <verse eid="1CH 15:19"/><verse number="20" style="v" sid="1CH 15:20"/>ዘካርያስ፣ አዚኤል ሼሚራሞት፣ ዬሂኤል፣ ኡኒ፣ ኤሊያብ፣ መአሴያኒፊ ቤናያሞ አከ ሴረ <char style="tl">አለሞቲት</char><note caller="+" style="f"><char style="fr" closed="false">15፥20 </char><char style="ft" closed="false">አለሞቲን ጎሰ ሙዚቃት።</char></note> ክራራን ፋርፈቱ ቱሬ፤ <verse eid="1CH 15:20"/><verse number="21" style="v" sid="1CH 15:21"/>አከሱመስ መቲትያን፣ ኤሊጴሌሁ፣ ሚቅኔያን፣ ኦቤድ ኤዶም፣ ዬኢኤል፣ አዛዝያን አከ ሴረ <char style="tl">ሺሚኒቲት</char><note caller="+" style="f"><char style="fr" closed="false">15፥21 </char><char style="ft" closed="false">ሺሚኒቲን ጎሰ ሙዚቃት።</char></note> በገና ተጰቱ ቱሬ። <verse eid="1CH 15:21"/><verse number="22" style="v" sid="1CH 15:22"/>ኬናንያን ሀንገፍትች ሌዎታ እት ጋፈተማ ፋርፈትና ቱሬ፤ እንስ እት ጋፈተሙማ ከነ ሰበቢ ኦጉማሳ ቀቡፍ ፉዸቴ።<verse eid="1CH 15:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 15:23"/>ቤሬክያፊ ኤልቃናን ኤግዶተ በልበለ ታቦታ ቱረን። <verse eid="1CH 15:23"/><verse number="24" style="v" sid="1CH 15:24"/>ሉቦትን ጄቹንስ፣ ሼበንያን፣ ዮሻፋጥ፣ ናትናኤል፣ አማሳይ፣ ዘካርያስ፣ ቤናያኒፊ ኤሊኤዜር ፉለ ታቦተ ዋቃ ዱረት መለከተ አፉፉ ቱሬ። ኦቤድ ኤዶሚፊ ዬህያንሞ ኤግዶተ በልበለ ታቦታ ቱረን።<verse eid="1CH 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 15:25"/>ከናፉ ዳዊቲፊ ማንጉዶትን እስራኤል አከሱመስ አጀጁወን ኩማ ገመቹዻን ታቦተ ከኩ <char style="nd">ዋቀዮ</char> ሰነ መነ ኦቤድ ኤዶሚቲ ፍዱ ዸቀን። <verse eid="1CH 15:25"/><verse number="26" style="v" sid="1CH 15:26"/>እሳንስ ሰበቢ ዋቅን ሌዎተ ታቦተ ከኩ <char style="nd">ዋቀዮ</char> ባተን ገርጋሬፍ ኮሮሚ ሎኒ ቶርባፊ ኮርቤዪ ሆላ ቶርበ ኣርሳ ጎዸን። <verse eid="1CH 15:26"/><verse number="27" style="v" sid="1CH 15:27"/>ዳዊትስ ወንደቦ ሀጲ ቁንጬ ተልባራ ሆጄተሜ ከን አከ ኡፈተ ሌዎትን ታቦተ ሰነ ባተን፣ ከን አከ ፋርፈቶትኒፊ ኬናንያን ቀጄልቻን ፋርፈትና ፋርፈቶታ ኡፈተን ሰና ኡፈቴ ቱሬ። ዳዊትስ ድረተ ቁንጬ ተልባራ ሆጄተሜስ ኡፈቴ ቱሬ። <verse eid="1CH 15:27"/><verse number="28" style="v" sid="1CH 15:28"/>አከሲንስ እስራኤል ሁንድ ጋንፈ ኮርቤሰ ሆላቲፊ መለከተ አፉፋ፣ ክልሌ ዸጌስሳ፣ ክራራፊ በገናዻን ስርባ ታቦተ ከኩ <char style="nd">ዋቀዮ</char> ሰነ ንፍደን።<verse eid="1CH 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 15:29"/>ዬሮ ታቦትን ከኩ <char style="nd">ዋቀዮ</char> መጋላ ዳዊት ሴኑት ሚካል እንተል ሳኦል ፎዳ ኬሳን እላላ ቱርቴ። እሼንስ አከ ዳዊት ሞትች ሹብሴ ገመዱ ዮሙ አርግቴት ገራሼ ኬሰት እሰ ቱፈቴ።<verse eid="1CH 15:29"/></para>
  <chapter eid="1CH 15"/>
  <chapter number="16" style="c" sid="1CH 16"/>
  <para style="p">
    <verse number="1" style="v" sid="1CH 16:1"/>እሳንስ ታቦተ ዋቃ ፍደኒ ዱንካነ ዳዊት ዻቤፍ ኬሰ ንካአን፤ ኣርሳ ጉበሙፊ ኣርሳ ነጋ ፉለ ዋቃ ዱረት ንዽኤሰን። <verse eid="1CH 16:1"/><verse number="2" style="v" sid="1CH 16:2"/>ዳዊትስ ኤርገ ኣርሳ ጉበሙፊ ኣርሳ ነጋ ዽኤሴ ቦዴ መቃ <char style="nd">ዋቀዮቲን</char> ነሞተ ንኤብሴ። <verse eid="1CH 16:2"/><verse number="3" style="v" sid="1CH 16:3"/>ኤርገሲስ እን ቶኮ ቶኮ ነመ እስራኤሊቲፍ፣ ዺራፊ ዱበርቲፍ ቡዴነ ቶኮ ቶኮ፣ ጉማ ፎኒ ቶኮ ቶኮፊ ብጥሌ እጀ ወይኒ ቶኮ ቶኮ ንኬኔ።<verse eid="1CH 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 16:4"/>እንስ አከ እሳን ፉለ ታቦተ <char style="nd">ዋቀዮ</char> ዱረት ተጃጅለኒፍ፣ አከ እሳን <char style="nd">ዋቀዮ</char> ዋቀ እስራኤል ዋመተኒፍ፣ አከ እሰ ገለቴፈተኒፊ አከ እሰ ጀጀተኒፍ ሌዎተ ቶኮ ቶኮ ንሙደቴ፤ <verse eid="1CH 16:4"/><verse number="5" style="v" sid="1CH 16:5"/>እሳንስ አሳፍ ሀንገፍትቸ፣ ዘካርያስ እት ኣናሳ፣ እት ፉፌስ ዬኢኤል፣ ሼሚራሞት፣ ዬሂኤል፣ መቲትያ፣ ኤሊያብ፣ ቤናያ፣ ኦቤድ ኤዶሚፊ ዬኢኤል ፈእ ቱረን። ጀር ኩኔን ክራራፊ በገና ተጰቱ ቱሬ፤ አሳፍሞ ክልሌ ዸጌስሰ ቱሬ፤ <verse eid="1CH 16:5"/><verse number="6" style="v" sid="1CH 16:6"/>ቤናያፊ የህዚኤል ሉቦትን ዬሮ ሁንደ ፉለ ታቦተ ከኩ ዋቃ ዱረት መለከተ አፉፉ ቱረን።<verse eid="1CH 16:6"/></para>
  <para style="s1">ፋርፈትና ዳዊት ከን ገለታ</para>
  <para style="r">
    <ref loc="1CH 16:8-22">16፥8‑22</ref> ኩወፈ – <char style="xt"><ref loc="PSA 105:1-15">ፋር 105፥1‑15</ref></char></para>
  <para style="r">
    <ref loc="1CH 16:23-33">16፥23‑33</ref> ኩወፈ – <char style="xt"><ref loc="PSA 96:1-13">ፋር 96፥1‑13</ref></char></para>
  <para style="r">
    <ref loc="1CH 16:34-36">16፥34‑36</ref> ኩወፈ – <char style="xt"><ref loc="PSA 106:1">ፋር 106፥1</ref>፣<ref loc="PSA 106:47-48">47‑48</ref></char></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 16:7"/>ዳዊትስ ጋፈ ሰነ አከ አሳፊፊ ምቾተሳ ፋርፈትና ገለታ ከነ <char style="nd">ዋቀዮፍ</char> ፋርፈተኒፍ ጀልቀበት አጀጀ ኬኔ፦<verse eid="1CH 16:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="1CH 16:8"/>
    <char style="nd">ዋቀዮፍ</char> ገለተ ገልቻ፤ መቃሳስ ዋመዻ፤</para>
  <para style="q2" vid="1CH 16:8">ዋን እን ሆጄቴስ ሰቦተ ግዱት ቤክስሳ።<verse eid="1CH 16:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="1CH 16:9"/>እሳፍ ፋርፈዻ፤ ፋርፈናዻን እሰ ገለቴፈዻ፤</para>
  <para style="q2" vid="1CH 16:9">ዋኤ ሆጂሳ እሰ ድንቅሲሳ ሁንዳስ ኦዴሳ።<verse eid="1CH 16:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 16:10"/>መቃሳ ቁልቁሉ ሰናን ቦና፤</para>
  <para style="q2" vid="1CH 16:10">ገራን ወረ <char style="nd">ዋቀዮን</char> በርባደኒ ሃገመዱ።<verse eid="1CH 16:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 16:11"/>
    <char style="nd">ዋቀዮፊ</char> ሁምነሳ በርባደዻ፤</para>
  <para style="q2" vid="1CH 16:11">ዬሮ ሁንደ ፉለሳ በርባዳ።<verse eid="1CH 16:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 16:12"/>ድንቂ እን ሆጄቴ፣ ሆጂሳ ድንቂ ሰናፊ</para>
  <para style="q2" vid="1CH 16:12">ሙርቲ እን ለብሴ ያደዻ፤<verse eid="1CH 16:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 16:13"/>እስን ተጃጅልቶትንሳ፣ ወር ሰኚ እስራኤል ታተን፣</para>
  <para style="q2" vid="1CH 16:13">እስን ፍለተምቶትንሳ፣ እልማን ያቆብስ ከነ ያደዻ።<verse eid="1CH 16:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="1CH 16:14"/>እን <char style="nd">ዋቀዮ</char> ዋቀኬኘ፤</para>
  <para style="q2" vid="1CH 16:14">ሙርቲንሳስ ለፈ ሁንደረ ጅረ።<verse eid="1CH 16:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="1CH 16:15"/>እን ከኩሳ በረ በራን፣ ዋዳ ገሌ ሰነስ</para>
  <para style="q2" vid="1CH 16:15">ዸሎተ ኩማፍ ንያደተ፤<verse eid="1CH 16:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CH 16:16"/>እን ከኩ አብረሃም ወጅን ገሌ፣</para>
  <para style="q2" vid="1CH 16:16">ከኩ ይስሃቂፍ ከከቴስ ንያደተ።<verse eid="1CH 16:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 16:17"/>ከነስ ያቆቢፍ ሴረ፣</para>
  <para style="q2" vid="1CH 16:17">እስራኤሊፍሞ ከኩ በረ በራ ጎዼ <optbreak/> አከነ ጄዼ ምርከኔሴረ፤ እንስ፦<verse eid="1CH 16:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 16:18"/>“አን ብየ ከነኣን ቆደ አት ዻልቱ ጎዼ፣</para>
  <para style="q2" vid="1CH 16:18">ሲፍ ነንኬነ” ጄዼ።<verse eid="1CH 16:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="1CH 16:19"/>እሳን ዬሮ ለኮብሳን ጥኖ ቱረንት፣</para>
  <para style="q2" vid="1CH 16:19">ዹጉማኑ ጥኖፊ ብየቲ ኬሰትስ ኬሱሞተ ቱረንት፣<verse eid="1CH 16:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="1CH 16:20"/>ሰባ ገረ ሰባት፣ ሞቱማ ቶኮ</para>
  <para style="q2" vid="1CH 16:20">ገረ ሞቱማ ብራት ጆረን።<verse eid="1CH 16:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="1CH 16:21"/>እን አከ ነምን ቶኮዩ እሳን ጩንቁርሱ ህንኤየምኔ፤</para>
  <para style="q2" vid="1CH 16:21">ሰበቢሳኒቲፍስ አከነ ጄዼ ሞቶተ እፈቴ፦<verse eid="1CH 16:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="1CH 16:22"/>“ድበምቶተኮ ህንቱቅና፤</para>
  <para style="q2" vid="1CH 16:22">ራጆተኮስ ህንሚዽና።”<verse eid="1CH 16:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="1CH 16:23"/>ለፍት ሁንድኑ <char style="nd">ዋቀዮን</char> ፋርፈዻ፤</para>
  <para style="q2" vid="1CH 16:23">ፈይሱሳስ ጉዩመ ጉያን ለብሳ።<verse eid="1CH 16:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="1CH 16:24"/>ኡልፍነሳ ሰቦተ ግዱት፣</para>
  <para style="q2" vid="1CH 16:24">ሆጂሳ ድንቅሲሳ ሰነሞ ነሞተ ሁንደ ኬሰት ለብሳ።<verse eid="1CH 16:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="1CH 16:25"/>
    <char style="nd">ዋቀዮ</char> ጉዳዻቲ ገለን ባይኤን እሳፍ ንመለ፤</para>
  <para style="q2" vid="1CH 16:25">እን ዋቆተ ሁንዳ ኦልትስ ሶዳተሙ ቀበ።<verse eid="1CH 16:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="1CH 16:26"/>ዋቆትን ሰቦተ ኦርማ ሁንድኑ ዋቆተ ቶልፈሞዻቲ፤</para>
  <para style="q2" vid="1CH 16:26">
    <char style="nd">ዋቀዮ</char> ገሩ ሰሚወን ኡሜ።<verse eid="1CH 16:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="1CH 16:27"/>ሚዸግኒፊ ሱራን ፉለሳ ዱረ ጅሩ፤</para>
  <para style="q2" vid="1CH 16:27">ጀብኒፊ ገመቹንስ እዶ ጅሬኘሳ ጅሩ።<verse eid="1CH 16:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="1CH 16:28"/>ያ ማቲወን ሰቦታ፣ <char style="nd">ዋቀዮፍ</char> ኬና፤</para>
  <para style="q2" vid="1CH 16:28">ኡልፍናፊ ጀብነ <char style="nd">ዋቀዮፍ</char> ኬና።<verse eid="1CH 16:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="1CH 16:29"/>ኡልፍነ መቃሳቲፍ መሉ <char style="nd">ዋቀዮፍ</char> ኬና።</para>
  <para style="q2" vid="1CH 16:29">ኣርሳ ፍዳቲ ፉለሳ ዱረት ዽኣዻ።</para>
  <para style="q1" vid="1CH 16:29">በሬድነ ቁልቁሉማሳቲን <char style="nd">ዋቀዮን</char> ዋቄፈዻ።<verse eid="1CH 16:29"/></para>
  <para style="q2">
    <verse number="30" style="v" sid="1CH 16:30"/>እስን ለፍት ሁንድኑ ፉለሳ ዱረት ሆለዻ!</para>
  <para style="q2" vid="1CH 16:30">አዱኛን ጀባቴ ዻበቴርት፤ ሶቾፈሙስ ህንደንዴሱ።<verse eid="1CH 16:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="1CH 16:31"/>ሰሚወን ሃእልልቸን፤ ለፍትስ ሃገመዱ፤</para>
  <para style="q2" vid="1CH 16:31">እሳን ሰቦተ ግዱት፣ “<char style="nd">ዋቀዮ</char> ሞኤረ!” ሃጄዸን።<verse eid="1CH 16:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="1CH 16:32"/>ገላኒፊ ወን እሰ ኬሰ ጅሩ ሁንድኑ ሃሁርሱ፤</para>
  <para style="q2" vid="1CH 16:32">ድሬወኒፊ ወን እሳንረ ጅረን ሁንድኑ ሃገመደን!<verse eid="1CH 16:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="1CH 16:33"/>ሙኬን ቦሶና ሃፋርፈተን፤</para>
  <para style="q2" vid="1CH 16:33">እሳን ገመቹዻን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ሃፋርፈተን፤</para>
  <para style="q2" vid="1CH 16:33">እን ለፈት ሙሩዻፍ ንዹፋቲ።<verse eid="1CH 16:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="1CH 16:34"/>
    <char style="nd">ዋቀዮፍ</char> ገለተ ገልቻ፤ እን ጋሪዻቲ፤</para>
  <para style="q2" vid="1CH 16:34">ጃለልሳ በረ በራን ጅራተ።<verse eid="1CH 16:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="1CH 16:35"/>አከነ ጄዻቲ እያ፤ “ያ ዋቀዮ፣</para>
  <para style="q2" vid="1CH 16:35">ፈይሳኬኘ፣ አት ኑ ባስ፤</para>
  <para style="q1" vid="1CH 16:35">አከ ኑ መቃኬ ቁልቁሉ ሰነ ገለቴፈኑፍ፣</para>
  <para style="q2" vid="1CH 16:35">አከ ገለተኬቲን ኦፍ ጀጅኑፍስ፣ ወልት ኑ ቀቢቲ ሰቦተ ኦርማ ጀላ ኑ ኦልች።”<verse eid="1CH 16:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="1CH 16:36"/>
    <char style="nd">ዋቀዮ</char> ዋቀ እስራኤሊቲፍ</para>
  <para style="q2" vid="1CH 16:36">በረ በራ ሀመ በረ በራት ገለን ሃገኡ።</para>
  <para style="m" vid="1CH 16:36">ከነረት ነምን ሁንድኑ፣ “አሜን፤ <char style="nd">ዋቀዮ</char> ሃገለቶሙ” ጄዼ።<verse eid="1CH 16:36"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="37" style="v" sid="1CH 16:37"/>ዳዊትስ አከ እሳን ፉለ ታቦታ ዱረ ዬሮ ሁንደ ተጃጅለኒፍ፣ አሳፊፊ ኦቦሎተሳ አቹመ ፉለ ታቦተ ከኩ <char style="nd">ዋቀዮ</char> ዱረት እሳን ዺሴ። <verse eid="1CH 16:37"/><verse number="38" style="v" sid="1CH 16:38"/>አከሱመስ ኦቤድ ኤዶሚፊ ወረ እሳን ወጅን ሆጄተን ጃተሚ ሰዴተን አከ እሳን ወጅን ተጃጅለኒፍ አችት ዺሴ። ኦቤድ ኤዶም እልም ዬዱቱኒቲፊ ሆሳን ኤግዶተ በልበላ ቱረን።<verse eid="1CH 16:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 16:39"/>ዳዊት ዛዶቅ ሉብቻፊ ሉቦተ እሰ ወጅን ሆጄተን ካን ዱንካነ <char style="nd">ዋቀዮ</char> ቁልቁሉ ከን ግቤኦን ኬሰት ጋረ ሰገዳረት አርገሙ ብረት ዺሴ፤ <verse eid="1CH 16:39"/><verse number="40" style="v" sid="1CH 16:40"/>ኩንስ እሳን አኩመ ዋን ሴረ <char style="nd">ዋቀዮ</char> ከን እን እስራኤሊፍ ኬኔ ሁንደ ኬሰት በሬፈሜ ሰናት ዬሮ ሁንደ ገልገላፊ ገነመ እዶ ኣርሳ ጉበሙረት ኣርሳ ጉበሙ <char style="nd">ዋቀዮፍ</char> አከ ዽኤሰኒፍ። <verse eid="1CH 16:40"/><verse number="41" style="v" sid="1CH 16:41"/>እሳን ወጅንስ ሄማኒፊ ዬዱቱን አከሱመስ ወረ አከ፣ “ጃለልሳ በረ በራን ጅራተ” ጄዸኒ <char style="nd">ዋቀዮፍ</char> ገለተ ገልቸኒፍ ፍለተመኒ መቃንሳኒ ቤከሜ ብራቱ ቱሬ። <verse eid="1CH 16:41"/><verse number="42" style="v" sid="1CH 16:42"/>ሄማኒፊ ዬዱቱን ሰገሌ መለከታቲፍ ክልሌ ዸጌስሱፊ አከሱመስ ሜሻ ሙዚቃ ከን ዋቃረት እት ጋፈተምቶተ ቱረን። እልማን ዬዱቱንሞ ከረ ኤገን።<verse eid="1CH 16:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 16:43"/>ኤርገሲ ነሞትን ሁንድኑ አቺ ከአኒ ቶኮን ቶኮንሳኒ ገረ መነ ኦፊሳት ገለን፤ ዳዊትሞ ማቲ ኦፊ ኤብሱፍ ገረ መናት ንዴብኤ።<verse eid="1CH 16:43"/></para>
  <chapter eid="1CH 16"/>
  <chapter number="17" style="c" sid="1CH 17"/>
  <para style="s1">አብዲ ዋቀዮ ዳዊትን አብደቺሴ</para>
  <para style="r">
    <ref loc="1CH 17:1-15">17፥1‑15</ref> ኩወፈ – <char style="xt"><ref loc="2SA 7:1-17">2ሳሙ 7፥1‑17</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 17:1"/>ዳዊት ኤርገ መሰራሳ ኬሰ ጅራቹ ጀልቀቤ ቦዴ ናታን ራጅቻን፣ “አን ኩኖ መነ ብርብርሳን እጃረሜኬሰን ጅራዸ፤ ታቦትን ከኩ <char style="nd">ዋቀዮ</char> ገሩ ዱንካነ ኬሰ ጅራተ” ጄዼ።<verse eid="1CH 17:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 17:2"/>ናታንሞ ዴብሴ ዳዊቲን፣ “ዋቅን ስ ወጅን ጅራቲ ዋን ገራኬት ያዴ ከምዩ ጎዽ” ጄዼ።<verse eid="1CH 17:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 17:3"/>ሀልከን ሰነ ገሩ ዱቢን ዋቀዮ አከነ ጄዼ ገረ ናታን ዹፌ፦<verse eid="1CH 17:3"/></para>
  <para style="pm">
    <verse number="4" style="v" sid="1CH 17:4"/>“ዸቂቲ አከነ ጄዺ ገርብቸኮ ዳዊትት ህም፤ ‘<char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ ከን መነ አን ኬሰ ጅራዹ ናፍ እጃሩ ስእ ምት። <verse eid="1CH 17:4"/><verse number="5" style="v" sid="1CH 17:5"/>አን ጋፈን እስራኤልን ግብጢ ባሴ ጀልቀቤ ሀመ ሀርኣት መነ ኬሰ ህንጅራትኔ። አን ዱንካነ ቶኮራ ገረ እሰ ካኒት፣ እዶ ቡልቲ ቶኮራ ገረ እዶ ቡልቲ እሰ ካኒት ደርባን ቱሬ። <verse eid="1CH 17:5"/><verse number="6" style="v" sid="1CH 17:6"/>አን እዶን እስራኤሎተ ሁንደ ወጅን ናነኣ ቱሬ ከምትዩ ሆገንቶተ አከ እሳን ሰበኮ ኤገኒፍ አጀጄ ኬሳ ነመ ቶኮንዩ፣ “እስን ማሊፍ መነ ብርብርሳ ናፍ ህንእጃሬ?” ጄዼ ቤካ?’<verse eid="1CH 17:6"/></para>
  <para style="pm">
    <verse number="7" style="v" sid="1CH 17:7"/>“ኤጋ አመ አከነ ጄዺ ገርብቸኮ ዳዊትት ህም፤ ‘<char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ አከነ ጄዸ፦ አን አከ አት ቡልቻ ሰበኮ እስራኤል ታቱፍ፣ ለፈ ትካቲፊ ቡሻዬ ፋነ ዴሙ ኬሳን ስ ፉዸዼ። <verse eid="1CH 17:7"/><verse number="8" style="v" sid="1CH 17:8"/>አን ለፈ አት ዸቅጤ ሁንደት ስ ወጅንን ቱሬ፤ ዲኖተኬ ሁንደስ ፉለኬ ዱራ በሌሴረ። አመስ አን መቃኬ አኩመ መቃ ነሞተ አዱኛረት አከ መሌ ጉርጉዳ ተአኒ ነንጎዸ። <verse eid="1CH 17:8"/><verse number="9" style="v" sid="1CH 17:9"/>አን አከ እሳን መነ ኦፊሳኒ ቀባተኒፊ አከ እሳን ስአች ህንራፈምኔፍ ሰበኮ እስራኤሊፍ ለፈ ኬኔ እሳን ነንዻበ። ነሞትን ሀሞን አከ ጀልቀበት ጎዸን ሰነ ዴብአኒ እሳን ህንጩንቁርሰን፤ <verse eid="1CH 17:9"/><verse number="10" style="v" sid="1CH 17:10"/>አከ ዬሮ አን ሰበኮ እስራኤልረት አቦቲ ሙርቲ ሙዴ አስ ጎዸን ሰነሌ ህንጎዸን፤ አን ዲኖተኬ ሁንደስ ሲፍን ገርቦምሰ።</para>
  <para style="pm" vid="1CH 17:10">“ ‘አን አከ <char style="nd">ዋቀዮ</char> መነ ሲፍ እጃሩ ስትን ህመ፦ <verse eid="1CH 17:10"/><verse number="11" style="v" sid="1CH 17:11"/>ዮሙ በር ጅሬኘኬቲ ዹሜ አት አቦቲኬት ደበለሙፍ ዸቅጡት አን አከ እን እዶኬ ቡኡፍ ሰኚኬ ኬሳ፣ እልማንኬ ኬሳ ቶኮ ነንካሰ፤ ሞቱማሳሌ ጀቤሴ ነንዻበ። <verse eid="1CH 17:11"/><verse number="12" style="v" sid="1CH 17:12"/>ከን መነ ናፍ እጃሩ እሰ፤ አንስ ቴሶሳ በረ በራን ጀቤሴ ነንዻበ። <verse eid="1CH 17:12"/><verse number="13" style="v" sid="1CH 17:13"/>አን እሳፍ አባ ነንተአ፤ እንስ እልመ ና ተአ። አን አከ ነምቸ ስ ዱረ ቱሬ ሰነራ ፉዸዼ፣ ጃለለኮ ጎንኩማ እሰራ ህንፉዸዹ። <verse eid="1CH 17:13"/><verse number="14" style="v" sid="1CH 17:14"/>አን መነኮፊ ሞቱማኮረት በረ በራን እሰ ነንሙደ፤ ቴሶንሳስ በረ በራን ጀባቴ ንዻበተ።’ ”<verse eid="1CH 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 17:15"/>ናታንስ ዱቢ ሙልአተ ከና ሁንደ ዳዊትት ህሜ።<verse eid="1CH 17:15"/></para>
  <para style="s1">ከዸትና ዳዊት</para>
  <para style="r">
    <ref loc="1CH 17:16-27">17፥16‑27</ref> ኩወፈ – <char style="xt"><ref loc="2SA 7:18-29">2ሳሙ 7፥18‑29</ref></char></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 17:16"/>ኤርገሲ ዳዊት ሞትች ኦል ሴኔ ፉለ <char style="nd">ዋቀዮ</char> ዱረ ታኤ አከነ ጄዼ፦</para>
  <para style="pm" vid="1CH 17:16">“ያ <char style="nd">ዋቀዮ</char>፣ ያ ዋቅ፣ ከን አት አሲን ነ ጌሴ፣ አን ኤኙ? ማቲንኮስ ማል? <verse eid="1CH 17:16"/><verse number="17" style="v" sid="1CH 17:17"/>ያ ዋቅ፣ አት አከ ዋን ወን ኩን ፉለኬ ዱረት ቁብሳ ህንተእኒት እላልቴ ዋኤ መነ ገርብቸኬቲ ከን ፉል ዱራሌ ዱበቴ። ያ <char style="nd">ዋቀዮ</char>፣ ያ ዋቅ፣ አት አከ ዋን አን ነመ ሁንደ ጫላ ከበጀማ ተኤት ነ እላልቴ።<verse eid="1CH 17:17"/></para>
  <para style="pm">
    <verse number="18" style="v" sid="1CH 17:18"/>“ዋን አት ገርብቸኬ ኡልፌስቴፍ ዳዊት ከነ ጫላ ማል ጄቹ ደንደአ? አት ገርብቸኬ ንቤክታቲ። <verse eid="1CH 17:18"/><verse number="19" style="v" sid="1CH 17:19"/>ያ <char style="nd">ዋቀዮ</char>፣ አት ሰበቢ ገርብቸኬቲቲፊ አኩመ ፌዺኬቲት ዋን ጉዳ ከነ ጎቴ፤ አከ ዋዳወን ጉርጉዳን ኩኔንስ ቤከመን ጎቴርተ።<verse eid="1CH 17:19"/></para>
  <para style="pm">
    <verse number="20" style="v" sid="1CH 17:20"/>“ያ <char style="nd">ዋቀዮ</char>፣ ከን አከኬቲ ቶኮዩ ህንጅሩ፤ አከ ኑ ጉሩመኬኛን ዸጌኜት ስ መሌ ዋቅን ብራ ህንጅሩ። <verse eid="1CH 17:20"/><verse number="21" style="v" sid="1CH 17:21"/>ሰብን አከ ሰበኬ እስራኤል ከን ዋቅን ሰበ ለፈረ ጅራቱ ኬሳ ሰበ ቶክቸ ኦፊሳቲፍ ፉረቹፊ ኦፊኬቲፍስ መቃ ቶልፈቹፍ ጄቴ ፉለ ሰበኬቲ ዱራ ሰቦተ አርኡዻን ድንቂወን ጉርጉዳፊ ሶዳችሳ ሆጄቹዻፍ በኤ፣ ከን አት ግብጢ ባፍቴ ሰና ቶኮዩ ጅራ? <verse eid="1CH 17:21"/><verse number="22" style="v" sid="1CH 17:22"/>አት ሰበኬ እስራኤልን በረ በራን ከን ኦፊኬቲ ጎቴ፤ ያ <char style="nd">ዋቀዮ</char>፣ አት ዋቀሳኒ ታቴርተ።<verse eid="1CH 17:22"/></para>
  <para style="pm">
    <verse number="23" style="v" sid="1CH 17:23"/>“አመስ ያ <char style="nd">ዋቀዮ</char>፣ ዋዳን አት ገርብቸኬቲፊ መነሳቲፍ ገልቴ ሱን በረ በራን ጀባቴ ሃዻበቱ። አት አኩመ ዋዳ ገልቴ ሰነ ራወዹ፤ <verse eid="1CH 17:23"/><verse number="24" style="v" sid="1CH 17:24"/>ኩንስ አከ መቃንኬ ጀባቴ ዻበቴ፣ በረ በራንስ ጉዳ ተኡፍ። ከነረት ነሞትን፣ ‘<char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣ እስራኤልረት ዋቀ፤ እን ዋቀ እስራኤል!’ ንጄዹ። መን ገርብቸኬ ዳዊትስ ፉለኬ ዱረት ጀባቴ ንዻበተ።<verse eid="1CH 17:24"/></para>
  <para style="pm">
    <verse number="25" style="v" sid="1CH 17:25"/>“ያ ዋቀኮ፣ አት አከ መነ እሳፍ እጃርቱ ገርብቸኬት ሙልእፍቴርተ። ከናፉ ገርብችኬ ስ ከዸቹዻፍ እጀ ጀብነ አርገቴረ። <verse eid="1CH 17:25"/><verse number="26" style="v" sid="1CH 17:26"/>ያ <char style="nd">ዋቀዮ</char>፣ አት ዋቀ! አት ዋን ጋሪ ከነ ገርብቸኬቲፍ ዋዳ ገልቴርተ። <verse eid="1CH 17:26"/><verse number="27" style="v" sid="1CH 17:27"/>አከ መንሳ በረ በራን ጀባቴ ፉለኬ ዱረ ዻበቱፍ አመስ መነ ገርብቸኬቲ ኤብሱን ፌዺኬ ተኤረ፤ ያ <char style="nd">ዋቀዮ</char> ሰበቢ አት እሰ ኤብፍቴፍ፣ እን በረ በራን ንኤብፈመ።”<verse eid="1CH 17:27"/></para>
  <chapter eid="1CH 17"/>
  <chapter number="18" style="c" sid="1CH 18"/>
  <para style="s1">ሞአኖወን ዳዊት</para>
  <para style="r">
    <ref loc="1CH 18:1-13">18፥1‑13</ref> ኩወፈ – <char style="xt"><ref loc="2SA 8:1-14">2ሳሙ 8፥1‑14</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 18:1"/>ኤርገሲ ዳዊት ፍልስጤሞተ ሞአቴ ኦፍ ጀለ እሳን ገልፈቴ፤ ጋቲፊ ገንዶተ ናኖሼ ጅረንስ ሀርከ ፍልስጤሞታቲ ባሴ።<verse eid="1CH 18:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 18:2"/>ዳዊት ሞኣቦተስ ንሞአቴ፤ እሳንስ እሰ ጀለት ቡለኒ ግብረ ፍደኒፍ።<verse eid="1CH 18:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 18:3"/>ከነረትስ ዳዊት ዬሮ ለገ ኤፍራጢስ ብረ ያደኖ ኦፊ ዻበቹ ዸቄት፣ ሀመ ሀማቲት ዴሜ ሀዳዴዜር ሞትቸ ዞባ ሞአቴ። <verse eid="1CH 18:3"/><verse number="4" style="v" sid="1CH 18:4"/>ዳዊትስ ጋሪወን ወራናሳ ኩመ ቶኮ፣ አቦቲ ፈርዳ ኩመ ቶርባፊ ሎልቶተ ለፎ ኩመ ድግደመ እሰራ ፉዸቴ። እንስ ፈርዴን ጋሪወኒ ዽበ ቶኮ ቆፈ ሀምብሴ ከኔን ሀፈን ሁንደ ሞጎሌ ኩኩቴ።<verse eid="1CH 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 18:5"/>ዬሮ ወር ሶርያ ከኔን ደማስቆ ጅራተን ሀዳዴዜር ሞትቸ ዞባ ገርጋሩፍ ዹፈንትስ፣ ዳዊት እሳን ኬሳ ነመ ኩመ ድግደሚ ለመ ፍጤ። <verse eid="1CH 18:5"/><verse number="6" style="v" sid="1CH 18:6"/>ኤርገሲስ ኩታ ቡልቺንሰ ደማስቆ ከን ብየ ሶርያ ኬሰ ቁበተ ሎልቶታ ዻበቴ፤ ወር ሶርያስ እሰ ጀለት ቡለኒ ግብረ ፍደኒፍ። <char style="nd">ዋቀዮስ</char> ዳዊቲፍ ለፈ እን ዸቄ ሁንደት ሞእቸ ኬኔ።<verse eid="1CH 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 18:7"/>ዳዊትስ ጋቸነ ወርቄ ከን አጀጆትን ሎልቶተ ሀዳዴዜር ሀርከት ቀበተን ፉዸቴ ገረ ዬሩሳሌም ፍዴ። <verse eid="1CH 18:7"/><verse number="8" style="v" sid="1CH 18:8"/>ዳዊት መጋላወን ሀዳዴዜር ጄቹንስ ጥብሃቲፊ ኩን ናሲ አከ መሌ ባይኤ ፉዸቴ፤ ሶሎሞንሞ ጋኒ ናሲ፣ ኡቱባወኒፊ ምኦተ ናሲ ገራ ገራ ናሲ ሰነራ ሆጄቴ።<verse eid="1CH 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 18:9"/>ቶኡን ሞቲን ሀማት ዮሙ አከ ዳዊት ጉቱማ ሎልቶተ ሀዳዴዜር ሞትቸ ዞባ ሞአቴ ዸገኤት፣ <verse eid="1CH 18:9"/><verse number="10" style="v" sid="1CH 18:10"/>አከ እን ሰበቢ ኦል ኣንቱማ ዳዊት ሞትች ወራነ ኬሰት ሀዳዴዜርረት አርገቴቲፍ ሀርከ እሰ ፉዼ ዻምሰ ገመቹ እሳፍ ደበርሱፍ እልመ ኦፊ ሀዶራምን ገረሳት ኤርጌ፤ ሀዳዴዜር ቶኡ ወጅን ወል ወራና ቱሬቲ። አዶራምስ ኬና ጎሰ ሁንዳ ወርቄራ፣ ሜቲፊ ናሲራ ሆጄተመን ፍዴፍ።<verse eid="1CH 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 18:11"/>ዳዊት ሞትችስ አኩመ ሜቲፊ ወርቄ ሰቦተ ኤዶም፣ ሞኣብ፣ አሞኖተ፣ ፍልስጤሞታፊ አማሌቅ ሁንደራ ቦጅኤ ቱሬ ጎዼ ሰነ ምኦተ ከኔንሌ <char style="nd">ዋቀዮፍ</char> አዳን ባሴ።<verse eid="1CH 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 18:12"/>አቢሻይ እልም ዜሩያ ሱሉለ ሶግዳ ኬሰት ኤዶሞተ ኩመ ኩዸ ሰዴት ፍጤ። <verse eid="1CH 18:12"/><verse number="13" style="v" sid="1CH 18:13"/>እንስ ኤዶም ኬሰ ቁበተ ሎልቶታ ዻበቴ፤ ኤዶሞን ሁንድኑስ ዳዊቲፍ ንገርቦመን። <char style="nd">ዋቀዮስ</char> ለፈ እን ዸቄ ሁንደት ዳዊቲፍ ሞአትና ንኬኔ።<verse eid="1CH 18:13"/></para>
  <para style="s1">ቆንዳልቶተ ዳዊት</para>
  <para style="r">
    <ref loc="1CH 18:14-17">18፥14‑17</ref> ኩወፈ – <char style="xt"><ref loc="2SA 8:15-18">2ሳሙ 8፥15‑18</ref></char></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 18:14"/>ዳዊት ጉቱማ እስራኤልረት ሞቲ ተኤ ሰበሳ ሁንዳፍ ሙርቲ ቀጄላፊ ቀጄሉማዻን ሆጄቴ።<verse eid="1CH 18:14"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 18:15"/>ዮኣብ እልም ዜሩያ ሆገና ሎልቶታ ቱሬ፤</para>
  <para style="li1" vid="1CH 18:15">ዬሆሻፋጥ እልም አሂሉድሞ ገልሜሳ ቱሬ፤<verse eid="1CH 18:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 18:16"/>ዛዶቅ እልም አሂጡቢፊ አቢሜሌክ እልም አብያታር ሉቦተ ቱረን፤</para>
  <para style="li1" vid="1CH 18:16">ሻፍሳንሞ በሬሳ ቱሬ፤<verse eid="1CH 18:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 18:17"/>ቤናያ እልም ዬሆያዳ ሆገና ኬሬቶታፊ ጴሌቶታ ቱሬ፤</para>
  <para style="li1" vid="1CH 18:17">እልማን ዳዊትሞ ሞትቸት ኣነኒ ቆንዳልቶተ ሀንገፎተ ቱረን።<verse eid="1CH 18:17"/></para>
  <chapter eid="1CH 18"/>
  <chapter number="19" style="c" sid="1CH 19"/>
  <para style="s1">ወራነ አሞኖተረት በነሜ</para>
  <para style="r">
    <ref loc="1CH 19:1-19">19፥1‑19</ref> ኩወፈ – <char style="xt"><ref loc="2SA 10:1-19">2ሳሙ 10፥1‑19</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 19:1"/>ኤርገሲስ ናሃሽ ሞቲን አሞኖታ ንዱኤ፤ እልምሳ እዶሳ ቡኤ ሞቲ ተኤ። <verse eid="1CH 19:1"/><verse number="2" style="v" sid="1CH 19:2"/>ዳዊትስ፣ “ሰበቢ አባንሳ ና አርጆሜፍ አንስ ሃኑን እልመ ናሃሺፍ ነንአርጆመ” ጄዼ ያዴ። ከናፉ ዳዊት ገደ ዋኤ አባሳቲፍ እት ዸገአሜሳ እብሱፍ ሃኑንት ኤርገሞተ ንኤርጌ።</para>
  <para style="p" vid="1CH 19:2">ዮሙ ነሞትን ዳዊት ዻምሰ ገዳ እት ህሙፍ ሃኑን ብረ ብየ አሞኖታ ዸቀንት፣ <verse eid="1CH 19:2"/><verse number="3" style="v" sid="1CH 19:3"/>ቆንዳልቶትን አሞኖታ ሃኑኒን፣ “አት ሰበቢ ዳዊት አከ እሳን ዻምሰ ገዳ ስት ህመኒፍ ነሞተ ስት ኤርጌፍ እን ዋን አባኬቲፍ ኡልፍነ ኬኔ ሴታ? ኤርገሞትንሳ ብየቲ ቆረቹ፣ በሳሰኒ ቀበቹፍ ገረኬ ዹፈን ምቲ?” ጄዸን። <verse eid="1CH 19:3"/><verse number="4" style="v" sid="1CH 19:4"/>ከናፉ ሃኑን ነሞተ ዳዊት ሰነ ቀቀቤ ርፌንሰራ ሃዴ ወያሳኒሌ ቴሱመረት ጭጭሬ ኦፍራ እሳን ኤርጌ።<verse eid="1CH 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 19:5"/>ዳዊት ዮሙ ነምን ቶኮ ዹፌ ዋኤ ነሞተ ሰና እሰት ህሜት፣ ሰበቢ እሳን አከ መሌ ቃነአኒፍ ኤርገሞተ ገረ እሳኒት ኤርጌ። ሞትችስ “እስን ሀመ አሬድንኬሰን እስኒ ጉደቱት ዬርኮ ቱራቲ ኤርገሲ ዴብኣ ኮታ” ጄዼን።<verse eid="1CH 19:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 19:6"/>አሞኖትን ዮሙ አከ ዳዊት እሳን ጥሬፈቴ ሁበተንት ሃኑኒፊ አሞኖትን ጳዳን አራሚ፣ አራመኣካፊ ዞባዻ ጋሪወን ክሬፈቹፍ ሜቲ ታላንቲ<note caller="+" style="f"><char style="fr" closed="false">19፥6 </char><char style="ft" closed="false">ታላንቲን ቶኮ ኪሎ ግራሚ 34።</char></note> ኩመ ቶኮ ንኤርገን። <verse eid="1CH 19:6"/><verse number="7" style="v" sid="1CH 19:7"/>እሳንስ ጋሪወን ኩመ ሶዶሚ ለማፊ ኦፍቶተ ጋሪወኒ፣ አከሱመስ ሞቲ መአካቲፊ ሎልቶተሳ ከኔን ዹፈኒ ሜዴባ ብረ ቁበተን ሰነ ክሬፈተን፤ አሞኖትንሞ መጋላወንሳኒቲ ወልት ቀበመኒ ወራነት ንቀጄለን።<verse eid="1CH 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 19:8"/>ዳዊት ዮሙ ዋን ከነ ዸገኤት ዮኣቢፊ ጉቱማ ሎልቶታ ንኤርጌ። <verse eid="1CH 19:8"/><verse number="9" style="v" sid="1CH 19:9"/>አሞኖትንሞ በአኒ ከረ መጋላሳኒረት ወራናፍ ህሪረን፤ ሞቶትን ዹፈን ሱንሞ ኮጳሳኒ ድሬረ ቱረን።<verse eid="1CH 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 19:10"/>ዮኣብስ አከ ፉለሳ ዱራፊ ዱግደሳ ዱባን ወራን ጅሩ ንአርጌ፤ ከናፉ ሎልቶተ እስራኤል ኬሳ ነሞተ ቤቤከሞ ፍለቴ አደ ሎልቶትን ሶርያ ጅረንት ቦባሴ። <verse eid="1CH 19:10"/><verse number="11" style="v" sid="1CH 19:11"/>ነሞተ ሀፈንሞ አጀጀ ኦቦሌሰሳ አቢሻይ ጀለት ንህሪርሴ፤ እሳንስ አሞኖተት ዱለን። <verse eid="1CH 19:11"/><verse number="12" style="v" sid="1CH 19:12"/>ዮኣብስ አከነ ጄዼ፤ “ዮ ወር ሶርያ ነት ጀባተን አት ነ ገርጋርተ፤ ዮ አሞኖትን ስት ጀባተንሞ አን ስን ገርጋረ። <verse eid="1CH 19:12"/><verse number="13" style="v" sid="1CH 19:13"/>ጀባዻ ሰበኬኛፊ መጋላወን ዋቀኬኛቲፍ ገራ ኩተናዻን ሃሎሉ። <char style="nd">ዋቀዮስ</char> ዋን ፉለሳ ዱረት ጋሪ ተኤ ንጎዸ።”<verse eid="1CH 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 19:14"/>ኤርገሲ ዮኣቢፊ ሎልቶትን እሰ ወጅን ቱረን ወረ ሶርያ ወራኑፍ ፉል ዱረት ንቀጄለን፤ ጀርስ ፉለሳ ዱራ በቀተን። <verse eid="1CH 19:14"/><verse number="15" style="v" sid="1CH 19:15"/>አሞኖትን ዮሙ አከ ነሞትን ሶርያ በቀተን አርገንት እሳንስ ፉለ ኦቦሌሰሳ አቢሻይ ዱራ በቀተኒ መጋላ ሴነን። አከሲን ዮኣብ ዬሩሳሌምት ዴብኤ።<verse eid="1CH 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 19:16"/>ነሞትን ሶርያ ዮሙ አከ እስራኤሎን እሳን ሞአተን አርገንት ኤርገሞተ ኤርገኒ ነሞተ ሶርያ ከኔን ለገ ኤፍራጢሲቲን ገማ ፍችሲሰን፤ ሾፈክ አጀጃን ሎልቶተ ሀዳዴዜር ሱን እሳን ሆገና ቱሬ።<verse eid="1CH 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 19:17"/>ዳዊትስ ዮሙ ወን ኩን እሰት ህመሜት፣ እስራኤሎተ ሁንደ ወልት ቀቤ ዮርዳኖስ ጬኤ፤ እንስ ዱርሴ ዸቄ ፉለሳኒ ዱራን ቶረ ሎላ ንቀበቴ። ዳዊትስ ወረ ሶርያ ወራኑፍ ሎልቶተሳ ህሪርሴ፤ ነሞትን ሶርያስ ንሎለኒን። <verse eid="1CH 19:17"/><verse number="18" style="v" sid="1CH 19:18"/>እሳን ገሩ እስራኤሎተ ዱራ በቀተን፤ ዳዊትስ ነሞተ ጋሪ ወራና ኦፈን ኩመ ቶርባፊ ሎልቶተ ለፎ ኩመ አፉርተመ ፍጤ። አጀጃ ሎልቶተሳኒ ሾፈክሌ ንአጄሴ።<verse eid="1CH 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 19:19"/>ተጃጅልቶትን ሀዳዴዜሪስ ዮሙ አከ እስራኤሎታን ሞአተመን አርገንት ዳዊት ወጅን ነጋ ኡመኒ እሰ ጀለት ቡለን።</para>
  <para style="p" vid="1CH 19:19">ከናፉ ነሞትን ሶርያ ኤርገሲ አሞኖተ ገርጋሩ ህንፌኔ።<verse eid="1CH 19:19"/></para>
  <chapter eid="1CH 19"/>
  <chapter number="20" style="c" sid="1CH 20"/>
  <para style="s1">ቀበሙ መጋላ ራባ</para>
  <para style="r">
    <ref loc="1CH 20:1-3">20፥1‑3</ref> ኩወፈ – <char style="xt"><ref loc="2SA 11:1">2ሳሙ 11፥1</ref>፤ <ref loc="2SA 12:20-21">12፥20‑21</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 20:1"/>ብራ ኬሰ ዬሮ ሞቶትን ወራናፍ በአንት ዮኣብ ሁምኖተ ወራና ቀጄልቼ ብየ አሞኖታ በርበዴሴ፤ ኤርገሲስ ዸቄ ረባ መርሴ፤ ዳዊት ገሩ ዬሩሳሌምት ሀፌ። ዮኣብስ ራባ ወራኔ ዳራ እሼ ጎዼ። <verse eid="1CH 20:1"/><verse number="2" style="v" sid="1CH 20:2"/>ዳዊትስ መታ ሞቲሳኒራ ጎንፎ ፉዸቴ፤ ጎንፎን ሱን ሀመ ወርቄ ታላንቲ ቶኮ ኡልፋቴ ዸጋወን ገት ጀቤዪስ ኦፍራ ቀበ ቱሬ፤ ጎንፍችስ መታ ዳዊትራ ካአሜ። እንስ መጋላ ሰነ ኬሳ ቦጁ አከ መሌ ባይኤ ፉዸቴ <verse eid="1CH 20:2"/><verse number="3" style="v" sid="1CH 20:3"/>ነሞተ አች ኬሰ ቱረንስ ገድ ያሴ አከ እሳን መጋዚዻን፣ ገሶ ስቢላቲፊ ቆቶዻን ሆጂ ሆጄተን ጎዼ። ዳዊት መጋላወን አሞኖታ ሁንደ ኬሰትስ አከሱመ ጎዼ። ኤርገሲ ዳዊቲፊ ሎልቶትንሳ ሁንድኑ ዬሩሳሌምት ንዴብአን።<verse eid="1CH 20:3"/></para>
  <para style="s1">ወራነ ፍልስጤሞተት በነሜ</para>
  <para style="r">
    <ref loc="1CH 2:4-8">2፥4‑8</ref> ኩወፈ – <char style="xt"><ref loc="2SA 21:15-22">2ሳሙ 21፥15‑22</ref></char></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 20:4"/>ኤርገሲሞ ለፈ ጌዝር ጄዸሙት ፍልስጤሞተ ወጅን ወራን በነሜ። ዬሮ ሰነትስ ሲቤካይ ነምች ብየ ሁሻ ሱን ሲፋይ ነምቸ ጎሰ ቶኮ ሬፋይን አጄሴ፤ ፍልስጤሞትንስ ንቡለኒፍ።<verse eid="1CH 20:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 20:5"/>ወራነ ብራ ከን ፍልስጤሞተ ወጅን ጎዸሜ ኬሰትሞ ኤልሃናን እልም ያኢር ሱን ለሄሚ ኦቦሌሰ ጎልያድ ነምቸ ግቲ ከን ሶማን ኤቦሳ ሎሳ ወየ ዾፍቱ ገኡ ቀቡ ሰና ንአጄሴ።<verse eid="1CH 20:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 20:6"/>አመስ ወራነ ጋትት ጎዸሜ ከን ብራ ኬሰት ነምቸ ሀመ ወዪ ገኡ ከን ቶኮ ቶኮ ሀርከሳራ ቁቦተ ጀአ ጀአ አከሱመስ ቶኮ ቶኮ ሚለሳራ ቁቦተ ጀአ ጀአ ወሉመት ቁቦተ ድግደሚ አፉር ቀቡ ቶኮቱ ቱሬ። እንስ ሰኚ ራፋ ኬሳ ዸለቴ። <verse eid="1CH 20:6"/><verse number="7" style="v" sid="1CH 20:7"/>ዮሙ እን እስራኤልን ቱቱቄትስ ዮናታን እልም ሽሜኣ ኦቦሌስ ዳዊት እሰ አጄሴ።<verse eid="1CH 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 20:8"/>እሳን ኩኔን ሰኚወን ራፋ ወረ ጋት ኬሰ ቱረኒዸ፤ እሳንስ ሀርከ ዳዊቲፊ ሀርከ ነሞተሳቲን ዹመን።<verse eid="1CH 20:8"/></para>
  <chapter eid="1CH 20"/>
  <chapter number="21" style="c" sid="1CH 21"/>
  <para style="s1">ዳዊት ሎልቶተሳ ለካኤ</para>
  <para style="r">
    <ref loc="1CH 21:1-26">21፥1‑26</ref> ኩወፈ – <char style="xt"><ref loc="2SA 24:1-25">2ሳሙ 24፥1‑25</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 21:1"/>ሴጠን እስራኤልት ከኤ አከ ዳዊት ሰበ እስራኤል ለካኡፍ እሰ ከካሴ። <verse eid="1CH 21:1"/><verse number="2" style="v" sid="1CH 21:2"/>ከናፉ ዳዊት ዮኣቢፊ አጀጆተ ሎልቶታቲን፣ “ዸቃቲ ቤርሼባዻ ሀመ ዳኒት እስራኤሎተ ለካኣ። ኤርገሲሞ አከ አን አከ እሳን ሀመም አከ ባይአተን ቤኩ ደንደኡፍ ዴብኣቲ ነት ህማ” ጄዼ።<verse eid="1CH 21:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 21:3"/>ዮኣብ ገሩ ዴብሴ፣ “<char style="nd">ዋቀዮ</char> ሎልቶተሳ ደቻ ዽበ ጫላ ሃባይእሱ። ያ ጎፍታኮ ሞትቸ፣ እሳን ሁንድ ገርቦተ ጎፍታኮቲፍ ቡለን ምቲ? ጎፍታንኮ ማሊፍ ዋን ከነ ጎቹ በርባዴ? እን ማሊፍ እስራኤልት የከ ፍደ?” ጄዼ።<verse eid="1CH 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 21:4"/>ተኡስ ዱቢን ሞትቻ ዮኣብን ያደ ጌደረቺሴ፤ ከናፉ ዮኣብ አቺ በኤ ጉቱማ እስራኤል ኬሰ ናነኤ ዬሩሳሌምት ዴብኤ። <verse eid="1CH 21:4"/><verse number="5" style="v" sid="1CH 21:5"/>ዮኣብስ ለኮብሰ ነሞተ ሎሉ ደንደአኒ ዳዊትት ህሜ፤ ነሞተ ይሁዳ ኬሰ ጅራተን ኩመ ዽበ አፉሪፊ ቶርባተመ ደበለቴ ነሞተ ጎራዴ ቀበቹ ደንደአን ምልዮነ ቶኮፊ ኩመ ዽበ ቶኮቱ ጉቱማ እስራኤል ኬሰ ቱሬ።<verse eid="1CH 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 21:6"/>ሰበቢ አጀጅን ሞትቻ ዮኣብን ጅብሲሴፍ እን ጎሶተ ሌዊቲፊ ቤንያም እት ደበሌ ህንለኮፍኔ። <verse eid="1CH 21:6"/><verse number="7" style="v" sid="1CH 21:7"/>አጀጅን ኩን ፉለ ዋቃ ዱረትስ ዋን ሀማ ቱሬ፤ ከናፉ እን እስራኤልን ሩኩቴ።<verse eid="1CH 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 21:8"/>ከነረት ዳዊት ዋቃን፣ “አን ዋን ከነ ጎቹዻን አከ መሌ ጩቡ ሆጄዼረ። አመ ገሩ አከ አት በሌሳ ገርብቸኬቲ ዺፍቱፍ ስን ከዸዸ። አን ሆጂ ጎዉማ ጉዳ ሆጄዼራ” ጄዼ።<verse eid="1CH 21:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 21:9"/>
    <char style="nd">ዋቀዮስ</char> ጋድ ራጂ ዳዊት ሰናን አከነ ጄዼ፤ <verse eid="1CH 21:9"/><verse number="10" style="v" sid="1CH 21:10"/>“ዸቂቲ ዳዊቲን፣ ‘<char style="nd">ዋቀዮ</char> አከነ ሲን ጄዸ፦ አን ፍለትኖ ሰዲ ሲፍን ኬነ። አከ አን እሰ ስት ፍዱፍ፣ እሳን ኬሳ ቶኮ ፍለዹ’ ጄዽ።”<verse eid="1CH 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 21:11"/>ከናፉ ጋድ ገረ ዳዊት ዸቄ አከነ ጄዼን፤ “<char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ ‘ፍለትኖኬ አዳን ባፈዹ፦ <verse eid="1CH 21:11"/><verse number="12" style="v" sid="1CH 21:12"/>ቤለ ወጋ ሰዲ ዮካን ጅአ ሰዲ ፉለ ዲኖተኬቲ ዱረ አርአሙፊ ጎራዴሳኒቲን በሌፈሙ ዮካን ጉያ ጎራዴ <char style="nd">ዋቀዮ</char> ሰዲ ጄቹንስ ጉዮተ ዸእች ብየቲት ቡኤ ኤርገማን <char style="nd">ዋቀዮ</char> ኩታ እስራኤል ሁንደ በሌሱ።’ ኤጋ አመ ዋን አን እሰ ነ ኤርጌ ሰናፍ ዴብሱ ሙርቴፈዹ።”<verse eid="1CH 21:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 21:13"/>ዳዊትሞ ጋዲን፣ “አን አከ መሌ ዽጰዼረ። ዋን አራርሳ አከ መሌ ጉዳ ተኤፍ አን ሀርከ <char style="nd">ዋቀዮ</char> ሴኑ ናፍ ወየ፤ ገሩ አከ አን ሀርከ ነማ ሴኑ ነ ህንጎዽን” ጄዼ።<verse eid="1CH 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 21:14"/>ከናፉ <char style="nd">ዋቀዮ</char> እስራኤልት ዸእቸ ኤርጌ ነሞትን እስራኤል ኩመ ቶርባተመ ንዹመን። <verse eid="1CH 21:14"/><verse number="15" style="v" sid="1CH 21:15"/>ዋቅን አከ እን ዬሩሳሌም በሌሱፍ ኤርገማሳ ቶኮ ኤርጌ። ገሩ ኡቱመ ኤርገማን ዋቀዮ ሱን ዬሩሳሌምን በሌሱፍ ቆጳኣ ጅሩ <char style="nd">ዋቀዮ</char> በላ ሰነ አርጌ ጋቤ ኤርገማሳ ከን ሰበ በሌሱፍ ቱሬ ሰናን፣ “ንገአ! ሀርከኬ ዴብፈዹ” ጄዼ። ዬሮ ሰነ ኤርገማን ዋቀዮ ሱን ኦብዲ ኦርና ነምቸ ጎሰ ዬቡስ ሰና ብረ ዻበቻ ቱሬ።<verse eid="1CH 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 21:16"/>ዳዊትስ ኦል እላሌ ኤርገማ <char style="nd">ዋቀዮ</char> ከን ጎራዴ ሉቅፈሜ ዬሩሳሌምት ድሪርፈሜ ሀርከሳት ቀበቴ ሰሚፊ ለፈ ግዱ ዻበቻ ጅሩ ቶኮ ንአርጌ። ዳዊቲፊ ማንጉዶትን ወያ ገዳ ኡፈተኒ ፉለሳ ዱረት አዳን ለፈት ንጎምብፈመን።<verse eid="1CH 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 21:17"/>ዳዊትሞ ዋቃን፣ “ነምን አከ ሎልቶትን ለካአመን ጎዼ አነ ምቲ? ነምን ጩቡፊ በሌሳ ሆጄቴ አኑመ። እሳን ኩኔን ገሩ ሆሎታዸ። እሳን ማል ጎዸን? ያ <char style="nd">ዋቀዮ</char> ዋቀኮ ሀርክኬ አናፊ ማቲኮረ ሃቡኡ፤ ገሩ አከ ዸእች ኩን ሰበኬረ ቱሩ ህንጎዽን” ጄዼ።<verse eid="1CH 21:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 21:18"/>ኤርገሲ ኤርገማን <char style="nd">ዋቀዮ</char> አከ ዳዊት ኦል በኤ ኦብዲ ኦርና ነምቸ ጎሰ ዬቡስ ሰና ኬሰት እዶ ኣርሳ <char style="nd">ዋቀዮፍ</char> እጃሩ አከ እን ዳዊትት ህሙ ጋድን አጀጄ። <verse eid="1CH 21:18"/><verse number="19" style="v" sid="1CH 21:19"/>ከናፉ ዳዊት ዱቢ ጋድ መቃ <char style="nd">ዋቀዮቲን</char> እሰት ህሜ ሰናፍ አጀጀሜ ኦል በኤ።<verse eid="1CH 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 21:20"/>ኦርናን ኡቱ ቀመዲ ዸኡት ጅሩ ኦል ጄዼ ኤርገማ ዋቀዮ ሰነ አርጌ፤ እልማንሳ ወር እሰ ወጅን ቱረን አፍረንስ ንዾከተን። <verse eid="1CH 21:20"/><verse number="21" style="v" sid="1CH 21:21"/>ኤርገሲ ዳዊት አች ገኤ፤ ኦርናንስ ዮሙ ምልአቴ እሰ አርጌት ኦብዲ ሰነ ኬሳ በኤ ፉለ ዳዊት ዱረት አዳን ለፈት ጎምብፈሜ ሰገዴ።<verse eid="1CH 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 21:22"/>ዳዊትስ፣ “አን አከ እሰረት እዶ ኣርሳ <char style="nd">ዋቀዮፍ</char> ቶልቼ አከሲን ዸእች ሰበረ ቡኤ ኩን ዻበቱፍ ኦብዲኬ ናፍ ኬን። ገቲሳ ጉቱት ነት ጉርጉር” ጄዼን።<verse eid="1CH 21:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 21:23"/>ኦርናንስ ዳዊቲን፣ “ፉዸዹ! ጎፍታንኮ ሞትች ዋን እሰት ቶሉ ከምዩ ሃጎዹ። ኩኖ አን ኣርሳ ጉበሙፍ ሰንጎተ፣ ቆራኒፍ ኡሌ እቲን ምዻን ዸአን፣ ኬና ምዻን ዽኤፈሙፍስ ቀመዲ ነንኬነ፤ አን ዋን ከነ ሁንደ ነንኬነ” ጄዼ።<verse eid="1CH 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 21:24"/>ዳዊት ሞትች ገሩ ኦርናዻን፣ “ኩን ህንተኡ፤ አን ገቲሳ ጉቱ ሲፍን ኬነ። አን ዋን ከንኬ ተኤ <char style="nd">ዋቀዮፍ</char> ህንፉዸዹ ዮካን ዋን ገቲ ነ ህንባስስን ኣርሳ ጉበሙፍ ህንዽኤሱ” ጄዼ።<verse eid="1CH 21:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 21:25"/>ከናፉ ዳዊት ገቲ ለፈ ሰና ኦርናዻፍ ወርቄ ሰቅሊ ዽባ ጀአ ከፈሌ። <verse eid="1CH 21:25"/><verse number="26" style="v" sid="1CH 21:26"/>ዳዊትስ አችት እዶ ኣርሳ <char style="nd">ዋቀዮፍ</char> ቶልቼ ኣርሳ ጉበሙፊ ኣርሳ ነጋ ዽኤሴ። እንስ <char style="nd">ዋቀዮን</char> ንዋመቴ፤ <char style="nd">ዋቀዮስ</char> ሰሚዻ እብዳን እዶ ኣርሳ ጉበሙረት እሳፍ ዴቢ ኬኔ።<verse eid="1CH 21:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 21:27"/>ሰነ ቦዴ <char style="nd">ዋቀዮ</char> ኤርገማሳ ሰነት ዱበቴ፤ እንስ ጎራዴሳ መንኤሳት ንዴብሴ። <verse eid="1CH 21:27"/><verse number="28" style="v" sid="1CH 21:28"/>ዳዊት ዬሮ ሰነት አከ <char style="nd">ዋቀዮ</char> ኦብዲ ኦርና ነምቸ ጎሰ ዬቡስ ሰናረት ዴቢሳ ኬኔ ንሁበቴ፤ አችትስ ኣርሳ ንዽኤሴ። <verse eid="1CH 21:28"/><verse number="29" style="v" sid="1CH 21:29"/>ዱንካን <char style="nd">ዋቀዮ</char> ከን ሙሴን ገሞጂት ሆጄቴፊ እዶን ኣርሳ ጉበሙ ግቤኦን ኬሰ ጋረ ሰገዳረ ቱሬ። <verse eid="1CH 21:29"/><verse number="30" style="v" sid="1CH 21:30"/>ዳዊት ገሩ ሰበቢ ጎራዴ ኤርገማ <char style="nd">ዋቀዮ</char> ሶዳቴፍ አች ዸቄ ፉለ እዶ ኣርሳ ሰና ዱረት ዋቀ ከዸቹ ህንደንዴኜ።<verse eid="1CH 21:30"/></para>
  <chapter eid="1CH 21"/>
  <chapter number="22" style="c" sid="1CH 22"/>
  <para style="p">
    <verse number="1" style="v" sid="1CH 22:1"/>ኤርገሲ ዳዊት፣ “ኩን መነ <char style="nd">ዋቀዮ</char> ዋቃት፤ ኩንሞ እዶ ኣርሳ፣ ኣርሳን ጉበሙ እስራኤሊፍ እት ዽኤፈሙዸ” ጄዼ።<verse eid="1CH 22:1"/></para>
  <para style="s1">ቆጲ እጃርሰ መነ ቁልቁሉማ</para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 22:2"/>ከናፉ ዳዊት አከ አለጎን እስራኤል ኬሰ ጅራተን ወልት ቀበመን አጀጄ፤ እሳን ኬሳስ አከ እሳን እጃርሰ መነ ቁልቁሉማ ዋቃቲፍ ዸጋ ሶፈሜ ቆጴሰኒፍ ወረ ዸጋ ጨብሰን ንፍለቴ። <verse eid="1CH 22:2"/><verse number="3" style="v" sid="1CH 22:3"/>እን ምስማረ እቲን ሁንዳ በልበላ ሆጄተኒፊ ምአ እቲን ወልት ቀብሲሰን ሆጄቹዻፍ ስቢለ አከ መሌ ባይኤፊ ናሲ መዳሊንሳ ሀመ ህንቀብኔ ንኬኔ። <verse eid="1CH 22:3"/><verse number="4" style="v" sid="1CH 22:4"/>ዳዊትስ ሰበቢ ወር ሲዶናቲፊ ወር ጢሮስ ብርብርሰ አከ መሌ ባይኤ እሳፍ ፍደኒፍ ብርብርሰ ባይእንሳ ለካአሙ ህንደንዴኜ ንኬኔ።<verse eid="1CH 22:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 22:5"/>ዳዊት አከነ ጄዼ፤ “እልምኮ ሶሎሞን እጆሌዸ፤ ሙጠኖሌ ህንቀቡ። መን <char style="nd">ዋቀዮፍ</char> እጃረሙ ኩንሞ ኡልፍነ ቀቤሰ፣ ከን ጉረ ቀቡፊ ከን ፉለ ሰቦተ ሁንዳ ዱረት አከ መሌ ሚዸጉ ተኡ ቀበ። ከናፉ አን እሳፍ ቆጲ ነንጎዸ።” አከሲን ዳዊት ኡቱ ህንዱእን ቆጲ ጉዳ ጎዼ።<verse eid="1CH 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 22:6"/>ኤርገሲ ዳዊት እልመሳ ሶሎሞንን ዋሜ አከ እን <char style="nd">ዋቀዮ</char> ዋቀ እስራኤሊፍ መነ እጃሩ እሰ አጀጄ። <verse eid="1CH 22:6"/><verse number="7" style="v" sid="1CH 22:7"/>ዳዊትስ ሶሎሞኒን አከነ ጄዼ፦ “ያ እልመኮ፣ አን መቃ <char style="nd">ዋቀዮ</char> ዋቀኮቲፍ መነ እጃሩ ያዴ ቱሬ። <verse eid="1CH 22:7"/><verse number="8" style="v" sid="1CH 22:8"/>ገሩ ዱቢን <char style="nd">ዋቀዮ</char> አከነ ጄዼ ገረኮ ዹፌ፦ ‘አት ዺገ ባይኤ ዸንገላፍቴርተ፤ ሎለ ሄዱስ ሎልቴርተ። አት ሰበቢ ፉለኮ ዱረት ዺገ ባይኤ ለፈረት ዸንገላፍቴፍ መቃኮቲፍ መነ ህንእጃርቱ። <verse eid="1CH 22:8"/><verse number="9" style="v" sid="1CH 22:9"/>ኩኖ እልም ቶኮ ሲፍ ንዸለተ፤ እንስ ነመ ቦቆና ንተአ፤ አንስ ዲኖተሳ ከኔን ናኖሳ ጅረን ሁንደራ ቦቆና ነንኬናፍ። መቃንሳስ ሶሎሞን ጄዸመ፤ አን በረ ሞቱማሳ ኬሰ እስራኤሊፍ ነጋፊ ተስገቢ ነንኬነ። <verse eid="1CH 22:9"/><verse number="10" style="v" sid="1CH 22:10"/>ነምን መቃኮቲፍ መነ እጃሩ እሰ። እን እልመ ናፍ ተአ፤ አንስ አባ ነንተኣፍ። ቴሶ ሞቱማሳስ እስራኤልረት በረ በራን ጀቤሴ ነንዻበ።’<verse eid="1CH 22:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 22:11"/>“ኤጋ ያ እልመኮ፣ አኩመ እን ዋኤኬ ዱበቴ ሰነት አከ መነ <char style="nd">ዋቀዮ</char> ዋቀኬቲ እጃሩን ሲፍ ምልካኡፍ <char style="nd">ዋቀዮ</char> ስ ወጅን ሃተኡ። <verse eid="1CH 22:11"/><verse number="12" style="v" sid="1CH 22:12"/>አከ አት ዮሙ እን እስራኤልረት ኣንጎ ሲፍ ኬኑት ሴረ <char style="nd">ዋቀዮ</char> ዋቀኬቲ ኤግዱፍ <char style="nd">ዋቀዮ</char> ኦጉማፊ ሁበትና ሲፍ ሃኬኑ። <verse eid="1CH 22:12"/><verse number="13" style="v" sid="1CH 22:13"/>አከሲን አት ዮ አጀጃፊ ሴረ <char style="nd">ዋቀዮ</char> ከራ ሙሴቲን እስራኤሊፍ ኬኔ ሰነ አከ ጋሪት ኤግዴ ንምልኮፍተ። ጀባዹ፤ ኦኖምስ። ህንሶዳትን ዮካን አብዲ ህንኩተትን።<verse eid="1CH 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 22:14"/>“ኩኖ፣ አን እጃርሰ መነ <char style="nd">ዋቀዮቲፍ</char> ወርቄ ታላንቲ<note caller="+" style="f"><char style="fr" closed="false">22፥14 </char><char style="ft" closed="false">ታላንቲን ቶኮ ኪሎ ግራሚ 34።</char></note> ኩመ ዽበ ቶኮ፣ ሜቲ ታላንቲ ምልዮነ ቶኮ፣ ናሲፊ ስቢለ አከ መሌ ባይኤ ከን መዳለሙ ህንደንዴኜ፣ ሙካፊ ዸጋሌ ቆጴሱረት አከ መሌ ደዸቤረ። አትስ እት ደበሉ ንደንዴሰ። <verse eid="1CH 22:14"/><verse number="15" style="v" sid="1CH 22:15"/>አት ሆጄቶተ ሄዱ ቀብደ፤ እሳንስ፦ ወረ ዸጋ ጨብሰን፣ ወረ መነ ዸጋ እጃረኒፊ ወረ ኦጉማ ሆጂ ሙካ ቀበን፣ አከሱመስ ነሞተ ኦጉማ ሆጂ ጎሰ ጎሳ፣ <verse eid="1CH 22:15"/><verse number="16" style="v" sid="1CH 22:16"/>ከን ሆጂ ወርቄቲፊ ሜቲ፣ ከን ናሲቲፊ ስቢላ፣ ኦጌዪ ሆጂ ሀርካ ወረ ለኮብስሳኒ ህንቤከምኔ ቀብደ። ኤጋ አመ ሆጂ ጀልቀብ፤ <char style="nd">ዋቀዮስ</char> ስ ወጅን ሃተኡ።”<verse eid="1CH 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 22:17"/>ኤርገሲ ዳዊት አከ እሳን እልመሳ ሶሎሞን ገርጋረኒፍ ዱረ ቡቶተ እስራኤል ሁንደ ንአጀጄ። <verse eid="1CH 22:17"/><verse number="18" style="v" sid="1CH 22:18"/>አከነስ እሳኒን ጄዼ፤ “<char style="nd">ዋቀዮ</char> ዋቅንኬሰን እስን ወጅን ጅረ ምቲ? እን ገመ ሁንዳን ቦቆና እስኒፍ ኬኔረ ምቲ? እን ጅራቶተ ብየ ከና ደበርሴ ነት ኬኔራቲ፤ ብየቲንስ <char style="nd">ዋቀዮፊ</char> ሰበሳቲፍ ገርቦምቴርት። <verse eid="1CH 22:18"/><verse number="19" style="v" sid="1CH 22:19"/>አመ <char style="nd">ዋቀዮ</char> ዋቀኬሰን በርባዱፍ ገራፊ ሉቡኬሰን ጉቱዻን ኩተዻ ከኣ። አከ ታቦተ ከኩ <char style="nd">ዋቀዮቲፊ</char> ምኦተ ቁልቁሉ ከን ዋቃ ፍደኒ መነ ቁልቁሉማ ከን መቃ <char style="nd">ዋቀዮቲፍ</char> እጃረሙፍ ጅሩ ሰነት ገልችተኒፍ መነ <char style="nd">ዋቀዮ</char> ጎፍታ እጃሩ ጀልቀባ።”<verse eid="1CH 22:19"/></para>
  <chapter eid="1CH 22"/>
  <chapter number="23" style="c" sid="1CH 23"/>
  <para style="s1">ሌዎተ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 23:1"/>ዳዊት ኤርገ ወጋ ሄዱ ጅራቴ ዱሎሜ ቦዴ እልመሳ ሶሎሞንን እስራኤልረት ሞቲ ጎዼ።<verse eid="1CH 23:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 23:2"/>አከሱመስ ዳዊት ዱረ ቡቶተ እስራኤል ሁንደ፣ ሉቦታፊ ሌዎተሌ ወልት ቀቤ። <verse eid="1CH 23:2"/><verse number="3" style="v" sid="1CH 23:3"/>ሌዎትን ኡሙሪንሳኒ ወጋ ሶዶማፊ ሀመሲ ኦሊ ንለካአመን፤ ባይእን ዺሮታ ኩመ ሶዶሚ ሰዴት ተኤ። <verse eid="1CH 23:3"/><verse number="4" style="v" sid="1CH 23:4"/>ዳዊትስ አከነ ጄዼ፤ “እሳን ከኔን ኬሳ ኩመ ድግደሚ አፉር ሆጂ መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ሃቶአተን፤ ነሞትን ኩመ ጀአ ቆንዳልቶታፊ አቦቲ ሙርቲ ሃተአን። <verse eid="1CH 23:4"/><verse number="5" style="v" sid="1CH 23:5"/>ኩምን አፉር ኤግዶተ በልበላ ሃተአን፤ ኩምን አፉርሞ ምኦተ ፋርፈትና ከኔን አን ካዮ ከናፍ ኬኔን <char style="nd">ዋቀዮን</char> ሃገለቴፈተን።”<verse eid="1CH 23:5"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="6" style="v" sid="1CH 23:6"/>ዳዊትስ ሌዎተ አኩመ ጎሶተ ሌዊት ገሬ ገሬን ገርገር ንቆዴ፤ እሳንስ፦ ጌርሾን፣ ቆሃቲፊ ሜራሪ።<verse eid="1CH 23:6"/></para>
  <para style="s1">ጌርሾኖተ</para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 23:7"/>ጎሰ ጌርሾን ኬሳ፦</para>
  <para style="li2" vid="1CH 23:7">ለአዳኒፊ ሽሜኢ።<verse eid="1CH 23:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 23:8"/>እልማን ለአዳኒ፦</para>
  <para style="li2" vid="1CH 23:8">ዬሂኤል ሀንገፍትቸ፣ ዜታሚፊ ዮኤል፤ ወሉመት ነመ ሰዲ ቱረን።<verse eid="1CH 23:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 23:9"/>እልማን ሽሜኢ፦</para>
  <para style="li2" vid="1CH 23:9">ሼሎሞት፣ ሀዚኤሊፊ ሃራን፤ ወሉመት ነመ ሰዲ ቱረን።</para>
  <para style="li2" vid="1CH 23:9">እሳን ኩኔን ሀንገፎተ ማቲ ለአዳን ቱረን።<verse eid="1CH 23:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 23:10"/>እልማን ሽሜኢ፦</para>
  <para style="li2" vid="1CH 23:10">የሃት፣ ዚና፣ ዬኡሺፊ ቤሪያ። እሳን ኩኔን እልማን ሽሜኢት፤</para>
  <para style="li2" vid="1CH 23:10">ወሉመት ነመ አፉር ቱረን።<verse eid="1CH 23:10"/></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 23:11"/>የሃት ሀንገፈ፤ ዚናን ለመፋ፤ ዬኡሺፊ ቤሪያን ገሩ እልማን ባይኤ ህንቀበን፤ ከናፉ እሳን አኩመ ማቲ ቶኮት ለካአመን።<verse eid="1CH 23:11"/></para>
  <para style="s1">ቆሃቶተ</para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 23:12"/>እልማን ቆሃቲ፦</para>
  <para style="li2" vid="1CH 23:12">አምራም፣ ይዝሃር፣ ኬብሮኒፊ ኡዚኤል፤ ወሉመት ነመ አፉር ቱረን።<verse eid="1CH 23:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 23:13"/>እልማን አምራም፦</para>
  <para style="li2" vid="1CH 23:13">አሮኒፊ ሙሴ።</para>
  <para style="li2" vid="1CH 23:13">አሮን አከ እኒፊ ሰኚንሳ ወንቶተ ዋን ሁንደ ጫላ ቁልቁሉ ተአን ዋቃፍ ቁልቁሌሰኒፍ፣ አከ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ኣርሳ ዽኤሰኒፍ፣ አከ ፉለሳ ዱረ ተጃጅለኒፊ አከ መቃሳቲን ኤበ ለብሰኒፍ በረ በራን አዳን ባፈመን። <verse eid="1CH 23:13"/><verse number="14" style="v" sid="1CH 23:14"/>እልማን ሙሴ ነመ ዋቃሞ ጎሰ ሌዊት ደበለመኒ ለካአመን።<verse eid="1CH 23:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 23:15"/>እልማን ሙሴ፦</para>
  <para style="li2" vid="1CH 23:15">ጌርሾሚፊ ኤሊኤዜር።<verse eid="1CH 23:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 23:16"/>እልማን ጌርሾሚ፦</para>
  <para style="li2" vid="1CH 23:16">ሼቡኤል ሀንገፈ።<verse eid="1CH 23:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 23:17"/>እልማን ኤሊኤዜሪ ኬሳ፦</para>
  <para style="li2" vid="1CH 23:17">ሬሃብያ ሀንገፈ።</para>
  <para style="li2" vid="1CH 23:17">ኤሌኣዛር እልማን ብራ ህንቀቡ ቱሬ፤ እልማን ሬሃብያ ገሩ አከ መሌ ሄዱ ቱረን።<verse eid="1CH 23:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 23:18"/>እልማን ይዝሃር ኬሳ፦</para>
  <para style="li2" vid="1CH 23:18">ሼሎሚት ሀንገፍተ።<verse eid="1CH 23:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 23:19"/>እልማን ኬብሮን፤</para>
  <para style="li2" vid="1CH 23:19">ሀንገፍትች ዬርያ፣ ለመፋን አመርያ፣ ሰደፋን የህዚኤል፣ አፉረፋን ዬቀሜኣም።<verse eid="1CH 23:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 23:20"/>እልማን ኡዚኤል፦</para>
  <para style="li2" vid="1CH 23:20">ሀንገፍትች ሚካ፣ ለመፋን ይሽያ።<verse eid="1CH 23:20"/></para>
  <para style="s1">ሜራሮተ</para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 23:21"/>እልማን ሜራሪ፦</para>
  <para style="li2" vid="1CH 23:21">መህሊፊ ሙሲ።</para>
  <para style="li1" vid="1CH 23:21">እልማን መህሊ፦</para>
  <para style="li2" vid="1CH 23:21">ኤሌኣዛሪፊ ቂስ<verse eid="1CH 23:21"/></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 23:22"/>ኤሌኣዛር ኡቱ እልማን ህንዸልችን ዱኤ፤ እን እንተለን ቆፈ ቀበ ቱሬ። ዱርቢወንሳኒ እልማን ቂስቱ እሳን ፉዼ።<verse eid="1CH 23:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 23:23"/>እልማን ሙሲ፦</para>
  <para style="li2" vid="1CH 23:23">መሄሊ፣ ኤዴሪፊ ዬሬሞት፤ ወሉመት ነመ ሰዲ ቱረን።<verse eid="1CH 23:23"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="24" style="v" sid="1CH 23:24"/>እሳን ኩኔን እልማን ሌዊ ከኔን አኩመ መነ አቦቲሳኒት ሀንገፎትን አቦቲ ወር መቃ መቃዻን ገልሜፈመኒ ቶኮ ቶኮን ለካአመን፣ ሆጄቶተ ኡሙሪንሳኒ ወጋ ድግደማፊ ሰና ኦል ተኤ ወረ መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ኬሰ ተጃጅለኒዸ። <verse eid="1CH 23:24"/><verse number="25" style="v" sid="1CH 23:25"/>ዳዊት አከነ ጄዼ ቱሬቲ፤ “<char style="nd">ዋቀዮ</char> ዋቅን እስራኤል ሰበሳቲፍ ቦቆና ኬኔረ፤ በረ በራንስ ዬሩሳሌም ኬሰ ንጅራተ፤ <verse eid="1CH 23:25"/><verse number="26" style="v" sid="1CH 23:26"/>ስአች ሌዎትን ዱንካነ ዮካን ምኦተ አች ኬሰት እት ፈየደመን ህንባተን።” <verse eid="1CH 23:26"/><verse number="27" style="v" sid="1CH 23:27"/>አኩመ ቀጄልቸ ዳዊት ዹመረት ኬኔት፣ ሌዎትን ወጋ ድግደማፊ ሰና ኦሊ ሄደመኒሩቲ።<verse eid="1CH 23:27"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="28" style="v" sid="1CH 23:28"/>ሆጂን ሌዎታስ ተጃጅለ መነ ቁልቁሉማ ዋቃ ኬሰት ሰኚወን አሮኒ ገርጋሩዸ፤ ኩንስ ኦብዲወኒፊ ኩታወን መነ ቁልቁሉማ ኤጉ፣ ምኦተ ቁልቁሉ ቁልቁሌሱፊ ሆጂወን ብራስ መነ <char style="nd">ዋቀዮ</char> ኬሰት ሆጄቹዸ። <verse eid="1CH 23:28"/><verse number="29" style="v" sid="1CH 23:29"/>አከሱመስ ቡዴነ ምንጃለረ ካኡ፣ ዳኩ ኬና ምዻኒ፣ ቡዴነ ኡቱ ህንቡካእን ቶልፈሜ፣ ቶልቹፊ ወሊን መኩ፣ ሰፈርቱፊ መዳሊ ሁንደረት እት ጋፈተምቶተ ቱረን። <verse eid="1CH 23:29"/><verse number="30" style="v" sid="1CH 23:30"/>እሳን ጉያ ጉያዻን <char style="nd">ዋቀዮን</char> ገለቴፈቹፊ ጀጀቹፍ ገነመ ገነመ ፉለሳ ዱረ ንዻበቱ፤ ገልገለ ገልገለስ አከሱመ ንጎዹ፤ <verse eid="1CH 23:30"/><verse number="31" style="v" sid="1CH 23:31"/>ዬሮ ኣርሳን ጉበሙ ጉያ ሰንበታ <char style="nd">ዋቀዮፍ</char> ዽኤፈሙት ዬሮ አያነ ባቲ ሃራፊ ጋፈ አያነ ዬሮንሳ ሙርታኤ ከሚዩ አከኑመ ንጎዹ። እሳን ዬሮ ሁንደ አኩመ ለኮብሳፊ ቀጄልፈመሳኒ ኬነሜት ፉለ <char style="nd">ዋቀዮ</char> ዱረ ተጃጅሉ ቱሬ።<verse eid="1CH 23:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 23:32"/>ሌዎትን አከሲን እት ጋፈተመ ዱንካነ ወል ገኢፊ እዶ ቁልቁሉ ኤጉፍ ቀበን ራወተን፤ አከሱመስ አጀጀ ኦቦሎተሳኒ ሰኚወን አሮን ጀለት እት ጋፈተሙማ መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ኬሰት ቀበን ራወቻ ቱረን።<verse eid="1CH 23:32"/></para>
  <chapter eid="1CH 23"/>
  <chapter number="24" style="c" sid="1CH 24"/>
  <para style="s1">ረመደሙ ሉቦታ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 24:1"/>እልማን አሮን አከ አርማን ገዲት ረመደመን፦</para>
  <para style="p" vid="1CH 24:1">እልማን አሮን ናዳብ፣ አቢሁ፣ ኤሌኣዛሪፊ ኢታማር ቱረን። <verse eid="1CH 24:1"/><verse number="2" style="v" sid="1CH 24:2"/>ናዳቢፊ አቢሁ ገሩ ኡቱ እጆሌ ህንዸልችን አባሳኒ ዱርሰኒ ዱአን፤ ከናፉ ኤሌኣዛሪፊ ኢታማር ሉቦተ ተአኒ ተጃጅለን። <verse eid="1CH 24:2"/><verse number="3" style="v" sid="1CH 24:3"/>ዳዊትስ ገርጋርሰ ዛዶቅ ሰኚ ኤሌኣዛር ሰናቲፊ አሂሜሌክ ሰኚ ኢታማሪን አኩመ ተጃጅለሳኒት ገሬ ገሬን እሳን ረመዴ። <verse eid="1CH 24:3"/><verse number="4" style="v" sid="1CH 24:4"/>ሰኚወን ኢታማሪ ጫላ ሰኚወን ኤሌኣዛር ኬሳ ሆገንቶትን ሄዱን ንአርገመን፤ እሳንስ አከነት ረመደመን፦ ሰኚወን ኤሌኣዛር ኬሳ አቦቲ ማቲ ኩዸ ጀአ፣ ሰኚወን ኢታማር ኬሳሞ አቦቲ ማቲ ሰዴት። <verse eid="1CH 24:4"/><verse number="5" style="v" sid="1CH 24:5"/>እሳን ሰበቢ ሰኚወን ኤሌኣዛሪፊ ሰኚወን ኢታማር ኬሰ ቆንዳልቶትን መነ ቁልቁሉማቲፊ ቆንዳልቶትን ዋቃ ቱረኒፍ ሎጊ መሌ እጣዻን እሳን ረመደን።<verse eid="1CH 24:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 24:6"/>ሼማእያን እልም ናትናኤል ነምቸ ጎሰ ሌዊ በሬሳን ሱን ፉለ ሞትቻቲፊ ቆንዳልቶታ ዱረት መቃሳኒ ዛዶቅ ሉብቸ፣ አሂሜሌክ እልመ አብያታር፣ አቦቲ ማቲወን ሉቦታቲፊ ሌዎታ፣ እንስ ጎሰ ኤሌኣዛር ኬሳ ማቲ ቶኮ፣ ጎሰ ኢታማር ኬሳሞ ማቲ ቶኮ ፉዼ በሬሴ።<verse eid="1CH 24:6"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 24:7"/>እጣን ጀልቀባ ዬሆያሪቢፍ፣</para>
  <para style="li1" vid="1CH 24:7">ለመፋን ዬዳእያፍ፣<verse eid="1CH 24:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 24:8"/>ሰደፋን ሃሪሚፍ፣</para>
  <para style="li1" vid="1CH 24:8">አፉረፋን ሴኦሪሚፍ፣<verse eid="1CH 24:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 24:9"/>ሸነፋን መልክያፍ፣</para>
  <para style="li1" vid="1CH 24:9">ጀአፋን ምያሚኒፍ፣<verse eid="1CH 24:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 24:10"/>ቶርበፋን ሀቆሲፍ፣</para>
  <para style="li1" vid="1CH 24:10">ሰዴተፋን አብያፍ፣<verse eid="1CH 24:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 24:11"/>ሰግለፋን ዬሹኣፍ፣</para>
  <para style="li1" vid="1CH 24:11">ኩርነፋን ሼካንያፍ፣<verse eid="1CH 24:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 24:12"/>ኩዸን ቶኮፋን ኤልያሺቢፍ፣</para>
  <para style="li1" vid="1CH 24:12">ኩዸ ለመፋን ያቂሚፍ፣<verse eid="1CH 24:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 24:13"/>ኩዸ ሰደፋን ሁጳፍ፣</para>
  <para style="li1" vid="1CH 24:13">ኩዸ አፉረፋን ዬሼቤኣቢፍ፣<verse eid="1CH 24:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 24:14"/>ኩዸን ሸነፋን ብልጋፍ፣</para>
  <para style="li1" vid="1CH 24:14">ኩዸ ጀአፋን እሜሪፍ፣<verse eid="1CH 24:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 24:15"/>ኩዸ ቶርበፋን ሄዚሪፍ፣</para>
  <para style="li1" vid="1CH 24:15">ኩዸ ሰዴተፋን ሀጵዜዚፍ፣<verse eid="1CH 24:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 24:16"/>ኩዸ ሰግለፋን ጴታያፍ፣</para>
  <para style="li1" vid="1CH 24:16">ድግደመፋን ህስቅኤሊፍ፣<verse eid="1CH 24:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 24:17"/>ድግደሚ ቶኮፋን ያኪኒፍ፣</para>
  <para style="li1" vid="1CH 24:17">ድግደሚ ለመፋን ጋሙሊፍ፣<verse eid="1CH 24:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 24:18"/>ድግደሚ ሰደፋን ዴላያፍ፣</para>
  <para style="li1" vid="1CH 24:18">ድግደሚ አፉረፋን መኣዝያፍ በኤ።<verse eid="1CH 24:18"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="19" style="v" sid="1CH 24:19"/>ኩን ሴረ እሳን ዬሮ መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ሴነንት እቲን ተጃጅለኒዸ፤ ሴረ ከነስ አባሳኒ አሮንቱ አኩመ <char style="nd">ዋቀዮ</char> ዋቅን እስራኤል እሰ አጀጄት እሳኒፍ ኬኔ።<verse eid="1CH 24:19"/></para>
  <para style="s1">ሌዎተ ሀፈን</para>
  <para style="lh">
    <verse number="20" style="v" sid="1CH 24:20"/>እልማን ሌዊ ወረ ሀፈን፦</para>
  <para style="b" vid="1CH 24:20"/>
  <para style="li1" vid="1CH 24:20">እልማን አምራሚ ኬሳ፦ ሹባኤል፤</para>
  <para style="li2" vid="1CH 24:20">እልማን ሹባኤል ኬሳ፦ ዬህዴያ።<verse eid="1CH 24:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 24:21"/>እልማን ሬሃብያ ኬሳ፦ ይሽያ ሀንገፍትቸ።<verse eid="1CH 24:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 24:22"/>ይዝሃሮተ ኬሳ፦ ሼሎሚት፤</para>
  <para style="li2" vid="1CH 24:22">እልማን ሼሎሚት ኬሳሞ፦ የሃት።<verse eid="1CH 24:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 24:23"/>እልማን ኬብሮን፦ እን ጀልቀባ ዬርያ፣ ለመፋን አመርያ፣ ሰደፋን የህዚኤል፣ አፉረፋን ዬቀሜኣም።<verse eid="1CH 24:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 24:24"/>እልመ ኡዚኤል፦ ሚካ።</para>
  <para style="li2" vid="1CH 24:24">እልማን ሚካ ኬሳ፦ ሻሚር።<verse eid="1CH 24:24"/></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 24:25"/>ኦቦሌሰ ሚካ፦ ይሽያ፤</para>
  <para style="li2" vid="1CH 24:25">እልማን ይሽያ ኬሳ፦ ዘካርያስ።<verse eid="1CH 24:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 24:26"/>እልማን ሜራሪ፦ መህሊፊ ሙሲ።</para>
  <para style="li2" vid="1CH 24:26">እልመ የአዝያ፦ በኖ።<verse eid="1CH 24:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 24:27"/>እልማን ሜራሪ፦</para>
  <para style="li2" vid="1CH 24:27">የአዝያራ፦ በኖ፣ ሾሃም፣ ዘኩሪፊ እብሪ።<verse eid="1CH 24:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 24:28"/>መህሊረ፦ ኤሌኣዛር፤ ነምች ኩን እልማን ህንቀቡ ቱሬ።<verse eid="1CH 24:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 24:29"/>ቂስራ፦ ዬረምኤል እልመ ቂስ።<verse eid="1CH 24:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 24:30"/>እልማን ሙሲ፦ መሄሊ፣ ኤዴሪፊ ዬሪሞት።</para>
  <para style="b" vid="1CH 24:30"/>
  <para style="lf" vid="1CH 24:30">እሳን ኩኔን አኩመ መነ አቦቲሳኒት እልማን ሌዎታት።<verse eid="1CH 24:30"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="31" style="v" sid="1CH 24:31"/>እሳንስ አኩመ ኦቦሎተሳኒ እልማን አሮን ሰነ ፉለ ዳዊት ሞትቻ ዱረት፣ ፉለ ዛዶቅ፣ አሂሜሌክ፣ ፉለ ሀንገፎተ ማቲ ሉቦታቲፊ ሌዎታ ዱረት እጣ ቡፈተን። ማቲ ኦቦሌሰ ሀንገፍትቻቲፍስ አኩመ ማቲ ኦቦሌሰ ቁጥሱት እጣን ቡኤ።<verse eid="1CH 24:31"/></para>
  <chapter eid="1CH 24"/>
  <chapter number="25" style="c" sid="1CH 25"/>
  <para style="s1">ፋርፈቶተ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 25:1"/>ዳዊት አጀጆተ ሎልቶታ ወጅን አከ እሳን ክራራን፣ በገናፊ ክልሌት ፈየደመኒ ራጂ ዱበተኒፍ ማቲ አሳፍ፣ ሄማኒፊ ዬዱቱን ኬሳ ነሞተ አዳን ባፈቴ። መቃን ነሞተ ተጃጅለ ከነ ኬና ቱረኒስ፦<verse eid="1CH 25:1"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 25:2"/>እልማን አሳፍ ኬሳ፦</para>
  <para style="li2" vid="1CH 25:2">ዘኩር፣ ዮሴፍ፣ ናታንያፊ አሰሬላ። እልማን አሳፍ ቀጄልቸ አሳፍ ጀለ ቱረን። አሳፍሞ ቀጄልቸ ሞትቻ ጀለት ራጂ ዱበቻ ቱሬ።<verse eid="1CH 25:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 25:3"/>እልማን ዬዱቱን ኬሳ፦</para>
  <para style="li2" vid="1CH 25:3">ጌዳልያስ፣ ዜሪ፣ እሳያስ፣ ሰሜእ፣ ሀሸብያፊ መቲትያ። እሳን ኩኔን ጀአን ቀጄልቸ አባሳኒ ዬዱቱን እሰ ክራራን <char style="nd">ዋቀዮ</char> ገለቴፈቻፊ ጀጀቻ ራጂ ዱበቻ ቱሬ ሰና ጀለ ቱረን።<verse eid="1CH 25:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 25:4"/>እልማን ሄማን ኬሳ፦</para>
  <para style="li2" vid="1CH 25:4">ቡክያ፣ መታንያ፣ ኡዚኤል፣ ሼቡኤሊፊ ዬሪሞት፤ ሀናንያ፣ ሀናኒ፣ ኤሊኣታ፣ ግደልቲፊ ሮማምት-ኤዜር፤ ዮሽብቃሻ፣ መሎቲ፣ ሆቲሪፊ መሃዝዮት። <verse eid="1CH 25:4"/><verse number="5" style="v" sid="1CH 25:5"/>እሳን ኩኔን ሁንድ እልማን ሄማን ነምቸ ሞትቻፍ ሙልአተ አርጉ ሰና ቱረን። እሳን አከ እሰ ከበጀኒፍ አኩመ ዋቅን አብደቺሴ ሰነት እሳ ንኬነመን። ዋቅንስ እልማን ኩዸ አፉሪፊ እንተለን ሰዲ ሄማኒፍ ንኬኔ።<verse eid="1CH 25:5"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="6" style="v" sid="1CH 25:6"/>ነሞትን ኩኔን ሁንድ ተጃጅለ መነ ዋቃ ኬሰት ፋርፈትና ክልሌዻን፣ ክራራፊ በገናዻን መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ኬሰት ፋርፈተሙ ሰናፍ ቀጄልቸ አቦቲሳኒ ጀለ ቱረን።</para>
  <para style="p" vid="1CH 25:6">አሳፍ፣ ዬዱቱኒፊ ሄማንሞ ቀጄልቸ ሞትቻ ጀለ ቱረን። <verse eid="1CH 25:6"/><verse number="7" style="v" sid="1CH 25:7"/>እሳኒፊ ፍሮንሳኒ ከኔን ሁንድሳኒ ፋርፈትና <char style="nd">ዋቀዮፍ</char> ፋርፈተሙን ሌንጅፈመኒ ኦጉማ ቀበን ወሉማ ገለት 288 ቱረን። <verse eid="1CH 25:7"/><verse number="8" style="v" sid="1CH 25:8"/>ጀርስ ረመዲሳኒ ቤኩዻፍ ጥናፊ ጉዳን፣ በርሲሳፊ በረታን ሃሉመ ወል ፈካቱን እጣ ቡፈተን።<verse eid="1CH 25:8"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 25:9"/>እጣን ጀልቀበት አሳፊፍ ቡኤ ሱን ዮሴፊፍ፣ እልማን ዮሴፊቲፊ ፍሮተሳቲፍ በኤ፤ ባይእንሳኒስ ኩዸ ለመ ቱረን።</para>
  <para style="li1" vid="1CH 25:9">ለመፋን ጌዳልያሲፍ፣ እሳፍ፣ ፍሮተሳቲፊ እልማንሳቲፍ በኤ፤ ባይእንሳኒ ኩዸ ለመ ቱረን።<verse eid="1CH 25:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 25:10"/>ሰደፋን ዘኩሪፍ፣ እልማንሳቲፊ ፍሮተሳቲፍ በኤ፤ ባይእንሳኒ ኩዸ ለመ ቱረን።<verse eid="1CH 25:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 25:11"/>አፉረፋን እዝሪፍ፣ እልማንሳቲፊ ፍሮተሳቲፍ በኤ፤ ባይእንሳኒ ኩዸ ለመ ቱረን።<verse eid="1CH 25:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 25:12"/>ሸነፋን ናታንያፍ፣ እልማንሳቲፊ ፍሮተሳቲፍ በኤ፤ ባይእንሳኒ ኩዸ ለመ ቱረን።<verse eid="1CH 25:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 25:13"/>ጀአፋን ቡክያፍ፣ እልማንሳቲፊ ፍሮተሳቲፍ በኤ፤ ባይእንሳኒ ኩዸ ለመ ቱረን<verse eid="1CH 25:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 25:14"/>ቶርበፋን ይሽርኤሊፍ፣ እልማንሳቲፊ ፍሮተሳቲፍ በኤ፤ ባይእንሳኒ ኩዸ ለመ ቱረን።<verse eid="1CH 25:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 25:15"/>ሰዴተፋን የሻያፍ፣ እልማንሳቲፊ ፍሮተሳቲፍ በኤ፤ ባይእንሳኒ ኩዸ ለመ ቱረን።<verse eid="1CH 25:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 25:16"/>ሰግለፋን መታንያፍ፣ እልማንሳቲፊ ፍሮተሳቲፍ በኤ፤ ባይእንሳኒ ኩዸ ለመ ቱረን።<verse eid="1CH 25:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 25:17"/>ኩርነፋን ሽሜኢፍ፣ እልማንሳቲፊ ፍሮተሳቲፍ በኤ፤ ባይእንሳኒ ኩዸ ለመ ቱረን።<verse eid="1CH 25:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 25:18"/>ኩዸ ቶኮፋን አዘርኤሊፍ፣ እልማንሳቲፊ ፍሮተሳቲፍ በኤ፤ ባይእንሳኒ ኩዸ ለመ ቱረን።<verse eid="1CH 25:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 25:19"/>ኩዸ ለመፋን ሀሸብያፍ፣ እልማንሳቲፊ ፍሮተሳቲፍ በኤ፤ ባይእንሳኒ ኩዸ ለመ ቱረን።<verse eid="1CH 25:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 25:20"/>ኩዸ ሰደፋን ሹባኤሊፍ፣ እልማንሳቲፊ ፍሮተሳቲፍ በኤ፤ ባይእንሳኒ ኩዸ ለመ ቱረን።<verse eid="1CH 25:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 25:21"/>ኩዸ አፉረፋን መቲትያፍ፣ እልማንሳቲፊ ፍሮተሳቲፍ በኤ፤ ባይእንሳኒ ኩዸ ለመ ቱረን።<verse eid="1CH 25:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 25:22"/>ኩዸ ሸነፋን ዬሬሞቲፍ፣ እልማንሳቲፊ ፍሮተሳቲፍ በኤ፤ ባይእንሳኒ ነመ ኩዸ ለመ ቱረን።<verse eid="1CH 25:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 25:23"/>ኩዸ ጀአፋን ሀናንያፍ፣ እልማንሳቲፊ ፍሮተሳቲፍ በኤ፤ ባይእንሳኒ ኩዸ ለመ ቱረን።<verse eid="1CH 25:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 25:24"/>ኩዸ ቶርበፋን ዮሽብቃሻፍ፣ እልማንሳቲፊ ፍሮተሳቲፍ በኤ፤ ባይእንሳኒ ኩዸ ለመ ቱረን።<verse eid="1CH 25:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 25:25"/>ኩዸ ሰዴተፋን ሀናኒፍ፣ እልማንሳቲፊ ፍሮተሳቲፍ በኤ፤ ባይእንሳኒ ነመ ኩዸ ለመ ቱረን።<verse eid="1CH 25:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 25:26"/>ኩዸ ሰግለፋን መሎቲፍ፣ እልማንሳቲፊ ፍሮተሳቲፍ በኤ፤ ባይእንሳኒ ኩዸ ለመ ቱረን።<verse eid="1CH 25:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 25:27"/>ድግደመፋን ኤልያታፍ፣ እልማንሳቲፊ ፍሮተሳቲፍ በኤ፤ ባይእንሳኒ ኩዸ ለመ ቱረን።<verse eid="1CH 25:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 25:28"/>ድግደሚ ቶኮፋን ሆቲሪፍ፣ እልማንሳቲፊ ፍሮተሳቲፍ በኤ፤ ባይእንሳኒ ኩዸ ለመ ቱረን።<verse eid="1CH 25:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 25:29"/>ድግደሚ ለመፋን ግደልቲፍ፣ እልማንሳቲፊ ፍሮተሳቲፍ በኤ፤ ባይእንሳኒ ኩዸ ለመ ቱረን።<verse eid="1CH 25:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 25:30"/>ድግደሚ ሰደፋን መሃዝዮቲፍ፣ እልማንሳቲፊ ፍሮተሳቲፍ በኤ፤ ባይእንሳኒ ኩዸ ለመ ቱረን።<verse eid="1CH 25:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 25:31"/>ድግደሚ አፉረፋን ሮማምት-ኤዜሪፍ፣ እልማንሳቲፊ ፍሮተሳቲፍ በኤ፤ ባይእንሳኒ ኩዸ ለመ ቱረን።<verse eid="1CH 25:31"/></para>
  <chapter eid="1CH 25"/>
  <chapter number="26" style="c" sid="1CH 26"/>
  <para style="s1">ኤግዶተ በልበላ</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 26:1"/>አከ እት ኤግዶን ከራ ቆደመን፦</para>
  <para style="b" vid="1CH 26:1"/>
  <para style="lh" vid="1CH 26:1">ጎሰ ቆሬ ኬሳ፦</para>
  <para style="li1" vid="1CH 26:1">እልማን አሳፍ ኬሳ ሜሼሌምያ እልመ ቆራህ።<verse eid="1CH 26:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 26:2"/>ሜሼሌምያ እልማን ቀበ ቱሬ፤ እሳንስ፦</para>
  <para style="li2" vid="1CH 26:2">እን ሀንገፍት ዘካርያስ፣ ለመፋን ዬዲኤል፣</para>
  <para style="li2" vid="1CH 26:2">ሰደፋን ዘባድያ፣ አፉረፋን የትኒኤል፣<verse eid="1CH 26:2"/></para>
  <para style="li2">
    <verse number="3" style="v" sid="1CH 26:3"/>እን ሸነፋን ኤላም፣ ጀአፋን ዬሆሃናን፣</para>
  <para style="li2" vid="1CH 26:3">ቶርበፋን ኤሊሆኤነይ።<verse eid="1CH 26:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 26:4"/>ኦቤድ ኤዶምስ አከሱመ እልማን ቀበ ቱሬ፤ እሳንስ፦</para>
  <para style="li2" vid="1CH 26:4">እን ሀንገፍት ሼማእያ፣ ለመፋን ዬሆዛባድ፣</para>
  <para style="li2" vid="1CH 26:4">ሰደፋን ዮኣ፣ አፉረፋን ሳካር፣</para>
  <para style="li2" vid="1CH 26:4">ሸነፋን ናትናኤል፣ <verse eid="1CH 26:4"/><verse number="5" style="v" sid="1CH 26:5"/>ጀአፋን አሚኤል፣</para>
  <para style="li2" vid="1CH 26:5">ቶርበፋን ይሳኮር፣ ሰዴተፋን ጴኡሌቲ፤</para>
  <para style="li2" vid="1CH 26:5">ዋቅን ኦቤድ ኤዶምን ኤብሴራቲ።<verse eid="1CH 26:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 26:6"/>ሼማእያን እልምሳስ እልማን ቀበ ቱሬ፤ እሳንስ ዋን ደንዴቲ ጉዳ ቀበኒፍ ቀጄልችቶተ ማቲ አባሳኒ ቱረን። <verse eid="1CH 26:6"/><verse number="7" style="v" sid="1CH 26:7"/>እልማን ሼማእያ፦</para>
  <para style="li2" vid="1CH 26:7">ኦትኒ፣ ራፋኤል፣ ኦቤዲፊ ኤልዛባድ፤</para>
  <para style="li2" vid="1CH 26:7">ፍሮንሳ ኤሊሁፊ ሰማክያንስ ደንዴቲ ጉዳ ቀቡ ቱሬ።<verse eid="1CH 26:7"/></para>
  <para style="lf">
    <verse number="8" style="v" sid="1CH 26:8"/>እሳን ኩኔን ሁንድ እልማን ኦቤድ ኤዶም፤ እሳን፣ እልማንሳኒቲፊ ፍሮንሳኒ ነሞተ ጀጀቦ ደንዴቲ ሆጂ ቀበን ቱረን፤ እልማን ኦቤድ ኤዶም፤ ወሉመት ነመ 62 ቱረን።<verse eid="1CH 26:8"/></para>
  <para style="lf">
    <verse number="9" style="v" sid="1CH 26:9"/>ሜሼሌምያፊ ፍሮተ ደንዴቲ ጉዳ ቀበን ቀበ ቱሬ፤ እሳንስ ወሉመት ነመ 18 ቱረን።<verse eid="1CH 26:9"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 26:10"/>ሆሳን እን ጎሰ ሜራሪ ሱን እልማን ቀበ ቱሬ፤ እሳንስ፦</para>
  <para style="li2" vid="1CH 26:10">ሽምሪን ዱረ ቡኣ ቱሬ፤ እን ሀንገፈ ተኡ ባቱዩ አባንሳ ዱረ ቡኣ እሰ ጎዼ ቱሬ፤<verse eid="1CH 26:10"/></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 26:11"/>እን ለመፋን ህልቅያ፣ እን ሰደፋን ጥበልያ፣</para>
  <para style="li2" vid="1CH 26:11">እን አፉረፋን ዘካርያስ።</para>
  <para style="lf" vid="1CH 26:11">እልማኒፊ ፍሮን ሆሳ ወሉመት ነመ 13 ቱረን።<verse eid="1CH 26:11"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="12" style="v" sid="1CH 26:12"/>ገሬ ኤግዶተ ከራ ከነ ኬሳ ሀንገፎተሳኒቲፍ ሆጂን አኩመ ፍሮንሳኒ ሆጄተን ሰና መነ <char style="nd">ዋቀዮ</char> ኬሰ ተጃጅሉ ንኬነሜፍ። <verse eid="1CH 26:12"/><verse number="13" style="v" sid="1CH 26:13"/>ቶኮ ቶኮ በልበላቲፍስ አኩመ ማቲ ማቲሳኒት ጥና ጉዳፍ እጣን ቡኤ።<verse eid="1CH 26:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 26:14"/>እጣን ከረ በአ ቢፍቱ ሼሌምያፍ በኤ።</para>
  <para style="li1" vid="1CH 26:14">ኤርገሲሞ ዘካርያስ እልመሳ ጎርስቱ ኦጌሰ ሰናፍ እጣን ቡኤ፤ እጣን በልበለ ካባ እሳፍ በኤ።<verse eid="1CH 26:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 26:15"/>እጣን ከረ ገመ ክባ ኦቤድ ኤዶሚፍ፣ ከን መንኩሳሞ እልማንሳቲፍ በኤ።<verse eid="1CH 26:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 26:16"/>እጣን ከረ ልጠ ቢፍቱቲፊ ከረ ሸሌኬት ከን ዳንዲ ኦሊረት አርገሙ ሹፊሚፊ ሆሳፍ በኤ።</para>
  <para style="b" vid="1CH 26:16"/>
  <para style="lh" vid="1CH 26:16">ኤጉምሰ ቶኮ ፉሌዻን ኤጉምሰ ብራቱ ቱሬ፦<verse eid="1CH 26:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 26:17"/>ከራ በአ ቢፍቱቲን ጉያ ጉያት ሌዎተ ጀአ፣</para>
  <para style="li1" vid="1CH 26:17">ከራ ካባቲን ጉያ ጉያት አፉር፣</para>
  <para style="li1" vid="1CH 26:17">ከራ ክባቲን ጉያ ጉያት አፉር</para>
  <para style="li1" vid="1CH 26:17">ከራ መንኩሳሞ ዬሮ ቶኮት ለመቱ ቱሬ።<verse eid="1CH 26:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 26:18"/>ኦብዲ ገመ ልጠ ቢፍቱቲን ጅሩፍ ዳንዲረ አፉር፣ ወልተጅቸ ጉባሞ ለመቱ ቱሬ።<verse eid="1CH 26:18"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="19" style="v" sid="1CH 26:19"/>እሳን ኩኔን ገሬ ኤግዶተ ከራ ከኔን እልማን ቆራሂቲፊ ሜራሪ ኬሳ ዹፈኒዸ።<verse eid="1CH 26:19"/></para>
  <para style="s1">ቶአቶተ ቀቤኛቲፊ ቆንዳልቶተ ብራ</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 26:20"/>ሌዎተ ኬሳ አሂያን እት ጋፈተማ ቀቤኘ መነ ዋቃቲፊ እት ጋፈተማ ምኦተ ቁልቁሌፈመኒ ቱሬ።<verse eid="1CH 26:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 26:21"/>ሰኚወን ለአዳን ከኔን ከራ ለአዳኒቲን ጌርሹኖተ ተአን ወር ሀንገፎተ ማቲ ለአዳን ነምቸ ጎሰ ጌርሾን ሰና ቱረን፦ ዬሂኤሊ፣ <verse eid="1CH 26:21"/><verse number="22" style="v" sid="1CH 26:22"/>እልማን ዬሂኤሊ፣ ዜታሚፊ ኦቦሌሰሳ ዮኤል። እሳን ኩንስ እት ጋፈተምቶተ ቀቤኘ መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ቱረን።<verse eid="1CH 26:22"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="23" style="v" sid="1CH 26:23"/>አምራሞተ ኬሳ፣ ይዝሃሮተ ኬሳ፣ ኬብሮኖተ ኬሳ፣ ኡዚኤል ኬሳ፦<verse eid="1CH 26:23"/></para>
  <para style="li2">
    <verse number="24" style="v" sid="1CH 26:24"/>ሼቡኤል እልም ጌርሾም እልመ ሙሴ ሰና እት ጋፈተማ ቀቤኛ ሀንገፈ ቱሬ። <verse eid="1CH 26:24"/><verse number="25" style="v" sid="1CH 26:25"/>ነሞትን ከራ ኤሊኤዜሪቲን ፍሮተሳ ተአንሞ፦ እልመሳ ሬሃብያ፣ እልመሳ እሳያስ፣ እልመሳ ዮራም፣ እልመሳ ዝክሪፊ እልመሳ ሼሎሚት። <verse eid="1CH 26:25"/><verse number="26" style="v" sid="1CH 26:26"/>ሼሎሚቲፊ ፍሮንሳ መንኩሳ ምኦተ ዳዊት ሞትች፣ ሀንገፎትን ማቲወኒ ከኔን አጀጁወን ኩማቲፊ አጀጁወን ዽባ ቱረን፣ አከሱመስ አጀጆትን ሎልቶታ ብራ ዋቃፍ አዳን ባሰንረት እት ጋፈተምቶተ ቱረን። <verse eid="1CH 26:26"/><verse number="27" style="v" sid="1CH 26:27"/>እሳን ቦጁ ወራናን አርገሜ ኬሳ ገረ ቶኮ ሃሮምሱ መነ ቁልቁሉማ <char style="nd">ዋቀዮቲፍ</char> አዳን ባሰኒ ኬነን። <verse eid="1CH 26:27"/><verse number="28" style="v" sid="1CH 26:28"/>ዋን ሳሙኤል ነምች ሙልአተ አርጉ ሱን፣ ሳኦል እልም ቂሽ፣ አብኔር እልም ኔሪፊ ዮኣብ እልም ዜሩያ ዽኤሰኒፊ ዋን ዋቃፍ አዳን ባፈሜ ሁንደ ሼሎሚቲፊ ፍሮተሳቱ ኤገ ቱሬ።<verse eid="1CH 26:28"/></para>
  <para style="li2">
    <verse number="29" style="v" sid="1CH 26:29"/>ይዝሃሮተ ኬሳ፦</para>
  <para style="li2" vid="1CH 26:29">ኬናንያፊ እልማንሳ ሆጂ መነ ቁልቁሉማቲን አለ ተኤት እስራኤሎተረት ቆንዳልቶታፊ አቦቲ ሙርቲ ተአኒ ረመደመን።<verse eid="1CH 26:29"/></para>
  <para style="li2">
    <verse number="30" style="v" sid="1CH 26:30"/>ኬብሮኖተ ኬሳ፦</para>
  <para style="li2" vid="1CH 26:30">ሀሸብያፊ ፍሮንሳ ከኔን ደንዴቲ ቀበን ኩመ ቶኮፊ ዽበ ቶርበ ብየ እስራኤል ከን ዮርዳኖሲን ገመ ልጠ ቢፍቱ ጅሩት ሆጂ <char style="nd">ዋቀዮ</char> ሁንዳፊ ተጃጅለ ሞትቻረት እት ጋፈተምቶተ ቱረን። <verse eid="1CH 26:30"/><verse number="31" style="v" sid="1CH 26:31"/>ኬብሮኖተ ኬሳ አኩመ ገልሜ ህዳ ዸሎተ ማቲሳኒት ዬርያን ሀንገፈሳኒ ቱሬ።</para>
  <para style="li2" vid="1CH 26:31">በረ ሞቱማ ዳዊት ኬሰ ወጋ አፉርተመፋት ገልሜወን እላለመኒ ጎሰ ኬብሮን ኬሳ ነሞትን ደንዴቲ ቀበን የእዜር ብየ ግልኣድ ኬሳ ሰነት አርገመን። <verse eid="1CH 26:31"/><verse number="32" style="v" sid="1CH 26:32"/>ይሪያን ፍሮተ ደንዴቲ ቀበን ከኔን ሀንገፎተ ማቲ ቱረን ኩመ ለማፊ ዽበ ቶርበ ቀበ ቱሬ፤ ዳዊት ሞትችስ ዋን ከን ዋቃ ተኤፍ ዽመ ሞትቻ ሁንደረት ጎሰ ሩቤን ጎሰ ጋዲፊ ወለካ ጎሰ ምናሴ ቶአቶተ ጎዼ።<verse eid="1CH 26:32"/></para>
  <chapter eid="1CH 26"/>
  <chapter number="27" style="c" sid="1CH 27"/>
  <para style="s1">ኩታወን ሎልቶታ</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 27:1"/>ለኮብስ እጆሌ እስራኤል ሀንገፎትን ማቲሳኒ፣ አጀጁወን ኩማ፣ አጀጁወን ዽባቲፊ ቆንዳልቶትንሳኒ ወር ዋን ኩታወን ሎልቶታ ከኔን ወጋ ጉቱ ጅአ ጅኣን ሆጂት ረመደመን ሰና እላሉ ሁንደረት ሞትቸ ተጃጅለን ከናዸ። ቶኮን ቶኮን ኩታወን ሎልቶታ ኩንስ ነመ 24,000 ኦፍ ኬሳ ቀበ ቱሬ።<verse eid="1CH 27:1"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 27:2"/>ጅአ ጀልቀባቲፍ አጀጃን ኩታ ሎልቶታ ከን ዱራ ያሾብኣም እልመ ዘብዲኤል ቱሬ። ኩታ ሎልቶተሳ ኬሰስ ሎልቶተ 24,000 ቱሬ። <verse eid="1CH 27:2"/><verse number="3" style="v" sid="1CH 27:3"/>እንስ ሰኚ ፋሬሲፊ ሀንገፈ አጀጆተ ኩታ ሎልቶተ ሁንዳ ከን ጅአ ጀልቀባ ቱሬ።<verse eid="1CH 27:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 27:4"/>ዶዳይ ነምች አሆኣ አጀጀ ኩታ ወራና ከን ጅአ ለመፋፍ ቱሬ፤ ሚቅሎት ሆገና ኩታ ወራነሳ ቱሬ። ኩታን ወራነሳስ ነሞተ 24,000 ኦፍ ኬሳ ቀበ ቱሬ።<verse eid="1CH 27:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 27:5"/>አጀጃን ኩታ ወራና ሰደፋን ከን ጅአ ሰደፋሞ ቤናያ እልመ ዬሆያዳ ሉብቻ ቱሬ። እንስ ሀንገፈ፤ ኩታን ወራነሳ ነሞተ 24,000 ኦፍ ኬሳ ቀበ ቱሬ። <verse eid="1CH 27:5"/><verse number="6" style="v" sid="1CH 27:6"/>ቤናያ ኩን እሱመ ወረ ሶዶመ ኬሳ ነመ ጀባፊ አጀጃ ወረ ሶዶመ ሰና ቱሬ ሰናዸ። አሚዛባድ እልምሳሞ አጀጃ ኩታ ወራነሳ ቱሬ።<verse eid="1CH 27:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 27:7"/>ጅአ አፉረፋፍ አጀጃን ኩተ አፉረፋ አሳሄል ኦቦሌሰ ዮኣብ ቱሬ፤ ከን እዶሳ ቡኤሞ እልመሳ ዜባድያዸ። ኩታሳ ኬሰ ነሞተ 24,000 ቱረን።<verse eid="1CH 27:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 27:8"/>ጅአ ሸነፋፍ አጀጃን ኩታ ሸነፋ ሸምሁት ነምቸ ይዝራ ቱሬ። ኩታሳ ኬሰ ነሞተ 24,000 ቱረን።<verse eid="1CH 27:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 27:9"/>ጅአ ጀአፋፍ ኢራ እልም እቄሽ ነምቸ ቴቆኣ ሰና አጀጃ ጀአፋ ቱሬ። ኩታሳ ኬሰ ነሞተ 24,000 ቱረን።<verse eid="1CH 27:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 27:10"/>ጅአ ቶርበፋፍ ሄሌዝ ነምች ጴሎና ከን ጎሰ ኤፍሬም ሱን አጀጃ ቶርበፋ ቱሬ። ኩታሳ ኬሰ ነሞተ 24,000 ቱረን።<verse eid="1CH 27:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 27:11"/>ጅአ ሰዴተፋፍ ሲቤካይ ነምች ብየ ሁሻ ከን ጎሰ ዛሮታ አጀጃ ሰዴተፋ ቱሬ፤ ኩታሳ ኬሰ ነሞተ 24,000 ቱረን።<verse eid="1CH 27:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 27:12"/>ጅአ ሰግለፋፍ አቢኤዜር ነምቸ አናቶቲ ከን ጎሰ ቤንያም ሰነቱ አጀጃ ሰግለፋ ቱሬ፤ ኩታሳ ኬሳ ነሞተ 24,000 ቱረን።<verse eid="1CH 27:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 27:13"/>ጅአ ኩርነፋፍ መሀራይ ነምቸ ኔቶፍ ከን ጎሰ ዛራ ሰነቱ አጀጃ ኩርነፋ ቱሬ። ኩታሳ ኬሰ ነሞተ 24,000 ቱረን።<verse eid="1CH 27:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 27:14"/>ጅአ ኩዸ ቶኮፋፍ አጀጃን ኩዸ ቶኮፋን ቤናያ ነምቸ ጵራቶን ከን ጎሰ ኤፍሬም ሰነ ቱሬ። ኩታሳ ኬሰ ነሞተ 24,000 ቱረን።<verse eid="1CH 27:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 27:15"/>ጅአ ኩዸ ለመፋፍ አጀጃን ኩዸ ለመፋን ሄልዳይ ነምቸ ኔቶፍ ከን ጎሰ ኦትኒኤል ሰነ ቱሬ። ኩታሳ ኬሰ ነሞተ 24,000 ቱረን።<verse eid="1CH 27:15"/></para>
  <para style="s1">ሀንገፎተ ጎሶታ</para>
  <para style="lh">
    <verse number="16" style="v" sid="1CH 27:16"/>ሀንገፎትን ጎሶተ እስራኤል፦</para>
  <para style="b" vid="1CH 27:16"/>
  <para style="li1" vid="1CH 27:16">ጎሰ ሩቤንረት፦ ኤሊኤዜር እልመ ዝክሪ፤</para>
  <para style="li1" vid="1CH 27:16">ጎሰ ስምኦንረት፦ ሼፋጥያ እልመ መአካ፤<verse eid="1CH 27:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 27:17"/>ጎሰ ሌዊረት፦ ሀሸብያ እልመ ቄሙኤል፤</para>
  <para style="li1" vid="1CH 27:17">ጎሰ አሮንረት፦ ዛዶቅ፤<verse eid="1CH 27:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 27:18"/>ጎሰ ይሁዳረት፦ ኤሊሁ ኦቦሌሰ ዳዊት፤</para>
  <para style="li1" vid="1CH 27:18">ጎሰ ይሳኮርረት፦ ኦምሪ እልመ ሚካኤል፤<verse eid="1CH 27:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 27:19"/>ጎሰ ዜቡሎንረት፦ ይሽመእያኡ እልመ ኦባድያ፤</para>
  <para style="li1" vid="1CH 27:19">ጎሰ ንፍታሌምረት፦ ዬሪሞት እልመ አዝሪኤል፤<verse eid="1CH 27:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 27:20"/>ጎሰ ኤፍሬምረት፦ ሆሼኣ እልመ አዘዝያ፤</para>
  <para style="li1" vid="1CH 27:20">ወለካ ጎሰ ምናሴረት፦ ዮኤል እልመ ጴዳያ፤<verse eid="1CH 27:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 27:21"/>ወለካ ጎሰ ምናሴ ከን ግልኣድ ኬሰ ጅራቱረት፦</para>
  <para style="li1" vid="1CH 27:21">እዶ እልመ ዘካርያስ፤ ጎሰ ቤንያምረት፦ የእሲኤል እልመ አብኔር፤<verse eid="1CH 27:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 27:22"/>ጎሰ ዳንረት፦ አዘርኤል እልመ ይሮሀም።</para>
  <para style="b" vid="1CH 27:22"/>
  <para style="lf" vid="1CH 27:22">ሀንገፎትን ጎሶተ እስራኤል እሳን ከኔን ቱረን።<verse eid="1CH 27:22"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="23" style="v" sid="1CH 27:23"/>ዳዊት ሰበቢ <char style="nd">ዋቀዮ</char> ሰበ እስራኤል አኩመ ኡርጂወን ሰሚት ባይእሱፍ ዋዳ ገሌፍ ዺረ ወጋ ድግደማቲፊ ድግደማ ገድ ተኤ ህንለኮፍኔ። <verse eid="1CH 27:23"/><verse number="24" style="v" sid="1CH 27:24"/>ዮኣብ እልም ዜሩያ ዺሮተ ለካኡ ጀልቀቤ መሌ ለካኤ ህንፍጥኔ፤ ሰበቢ ለኮብሰ ከናቲፍስ ዼከምስ ዋቃ እስራኤልት ዹፌ፤ ከናፉ ወር ሄደመንዩ ገልሜ ዳዊት ሞትቻ ኬሰት ህንገልሜፈምኔ።<verse eid="1CH 27:24"/></para>
  <para style="s1">ሹሞተ ሞትቻ</para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 27:25"/>አዝማዌት እልም ኣዲኤል ሹሚ መንኩሳ ቀቤኘ ሞቲ ቱሬ።</para>
  <para style="li1" vid="1CH 27:25">ዮናታን እልም ኡዝያሞ ሹሚ ምኦተ ኣናሌ፣ መጋላወን፣ ከን ገንዶታቲፊ ገሞወን ኤጉምሳ ቱሬ።<verse eid="1CH 27:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 27:26"/>ኤዜሪን እልም ክሉብ ሹሚ ቆናን ቡልቶታ ቱሬ።<verse eid="1CH 27:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 27:27"/>ሽሜኢን ነምች ራማቲ ሱን እት ጋፈተማ እዶ ዻባ ወይኒ ቱሬ።</para>
  <para style="li1" vid="1CH 27:27">ዘብዲን ነምች ሽፋሚ ሱን እት ጋፈተማ መነ ጩንፋ ወይኒ እዶ ዻባ ወይኒ ኬሳ ቱሬ።<verse eid="1CH 27:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 27:28"/>በኣል-ሃናን ነምች ጌዴራ ሱን ሹሚ ሙኬን ኤጄርሳቲፊ ሀርቡ ተበወን ጋረን ገመ ልጠ ቢፍቱት አርገመኒ ቱሬ።</para>
  <para style="li1" vid="1CH 27:28">ዮኣሽሞ ሹሚ መነ ዘይቲ ኤጄርሳ ቱሬ።<verse eid="1CH 27:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 27:29"/>ሽትራይ ነምች ሻሮን ሹሚ ከረ ሎኒ ከን ሻሮንት ቦበኡ ቱሬ።</para>
  <para style="li1" vid="1CH 27:29">ሻፋጥ እልም ኣድላይ ሹሚ ከረ ሎወን ሱሉለ ኬሰ ጅረኒ ቱሬ።<verse eid="1CH 27:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 27:30"/>ኦቢል ነምች ጎሰ እሽማኤል ሱን ሹሚ ጋለወኒ ቱሬ።</para>
  <para style="li1" vid="1CH 27:30">ዬህዴያን ነምች ጎሰ ሜሮኖታ ሹሚ ሀሮታ ቱሬ።<verse eid="1CH 27:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 27:31"/>ያዚዝ ነምች ጎሰ አጋር እት ጋፈተማ ቡሻዬ ቱሬ።</para>
  <para style="lf" vid="1CH 27:31">እሳን ኩኔን ሁንድ ሹሞተ ቀቤኘ ዳዊት ሞትቻ ቱረን።<verse eid="1CH 27:31"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 27:32"/>ዮናታን ኤሱምን ዳዊት ነምች ቤካን በሬሳን ሱን ጎርስቱ ቱሬ፤</para>
  <para style="li1" vid="1CH 27:32">ዬሂኤል እልም ሀክሞኒሞ ኤግዱ እልማን ሞትቻ ቱሬ።<verse eid="1CH 27:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 27:33"/>አሂቶፌል ጎርሳ ሞትቻ ቱሬ።</para>
  <para style="li1" vid="1CH 27:33">ሁሻይ ነምች ጎሰ አርክሞ ምቹ ሞትቻ ቱሬ።<verse eid="1CH 27:33"/></para>
  <para style="lf">
    <verse number="34" style="v" sid="1CH 27:34"/>ዬሆያዳን እልም ቤናያቲፊ አብያታር እዶ አሂቶፌል ቡአን።</para>
  <para style="li1" vid="1CH 27:34">ዮኣብሞ አጀጃ ኤግዶተ ሞቱማ ቱሬ።<verse eid="1CH 27:34"/></para>
  <chapter eid="1CH 27"/>
  <chapter number="28" style="c" sid="1CH 28"/>
  <para style="s1">ከሮረ ዳዊት መነ ቁልቁሉማቲፍ ባሴ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 28:1"/>ዳዊት አከ እሳን ዬሩሳሌምት ወልት ቀበመኒፍ ሀንገፎተ እስራኤል ሁንደ ንዋሜ፤ እሳንስ፦ ጌጌስቶተ ጎሶታ፣ ተጃጅለ ሞቱማ ኬሰት አጀጆተ ኩታወን ሎልቶታ፣ አጀጆተ ኩማቲፊ አጀጆተ ዽባ፣ ወረ ቀቤኛፊ ሆሪ ሞትቻቲፊ ከን እልማንሳረት እት ጋፈተምቶተ ተአን፣ ቆንዳልቶተ መሰራ ሞቱማ፣ ነሞተ ጀጀቦፊ ጎቶተ ወራና ሁንደ።<verse eid="1CH 28:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 28:2"/>ኤርገሲ ዳዊት ሞትች ከኤ ዻበቴ አከነ ጄዼ፦ “ያ ኦቦሎተኮፊ ያ ሰበኮ፣ ሜ ነ ዸገኣ። አን ታቦተ ከኩ <char style="nd">ዋቀዮቲፍ</char> እዶ እን ቦቆቱ፣ ዋቀኬኛፍሞ እዶ እን ሚለ ዻበቱ እጃሩ ያዴ ቆጳኤረ። <verse eid="1CH 28:2"/><verse number="3" style="v" sid="1CH 28:3"/>ዋቅን ገሩ፣ ‘አት ሰበቢ ሎለ ሄዱ ሎልቴ ዺገ ባይኤ ዸንገላፍቴፍ መቃኮቲፍ መነ ህንእጃርቱ’ ናን ጄዼ።<verse eid="1CH 28:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 28:4"/>“ተኡስ <char style="nd">ዋቀዮ</char>፣ ዋቅን እስራኤል አከ አን በረ በራን እስራኤልረት ሞቲ ተኡፍ መነ አባኮ ኬሳ ነ ፍለቴ። አከ እን ዱረ ቡኣ ተኡፍስ ይሁዳ ፍለቴ፤ መነ ይሁዳ ኬሳ ማቲኮ ፍለቴ፤ እልማን አባኮቲ ኬሳሞ አከ አን ጉቱማ እስራኤልረት ሞቲ ተኡ ጃለቴ። <verse eid="1CH 28:4"/><verse number="5" style="v" sid="1CH 28:5"/><char style="nd">ዋቀዮ</char> እልማን ባይኤ ና ኬኔረ፤ እልማንኮ ሁንደ ኬሳሞ አከ እን ቴሶ ሞቱማ ዋቀዮረ ታኤ ሰበ እስራኤል ቡልቹፍ እልመኮ ሶሎሞንን ፍለቴ። <verse eid="1CH 28:5"/><verse number="6" style="v" sid="1CH 28:6"/>አከነስ ናን ጄዼ፤ ‘ከን መነኮፊ ኦብዲወንኮ ናፍ እጃሩ እልመኬ ሶሎሞኒዸ፤ አን አከ እን እልመ ና ተኡፍ እሰ ፍለዼራቲ፤ አንስ አባሳ ነንተአ። <verse eid="1CH 28:6"/><verse number="7" style="v" sid="1CH 28:7"/>ዮ እን አኩመ አማ ከነት እቱመ ፉፌ አጀጀኮፊ ሴረኮ ኤጌ አን በረ በራን ሞቱማሳ ጀቤሴ ነንዻበ።’<verse eid="1CH 28:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 28:8"/>“ከናፉ አከ እስን ለፈ ጋሪ ከነ ዻልተኒ እልማንኬሰኒፍ ዻለ በረ በራ ደበርስተኒፍ፣ አከ እስን አጀጀ <char style="nd">ዋቀዮ</char> ዋቀኬሰኒ ሁንደ ኤግደኒፊ እሰ ዱካ ቡተኒፍ አን አመ ፉለ እስራኤሎተ ሁንዳ ዱረት፣ ወልዳ <char style="nd">ዋቀዮ</char> ዱረት፣ አከሱመስ ኡቱ ዋቅንኬኘ ዸገኡ እስንን አጀጀ።<verse eid="1CH 28:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 28:9"/>“ያ እልመኮ ሶሎሞን አትስ ዋቀዮ ዋቀ አባኬቲ ቤኪ ገራ ቶኮፊ ቀልቢ ፌዺ ቀቡን እሰ ተጃጅል፤ <char style="nd">ዋቀዮ</char> ዋን ገራ ነማ ኬሰ ጅሩ ሁንደ ቆሬ ከሮራፊ ያደ ሁንደ ሁበታቲ። ዮ አት እሰ በርባዴ እን ሲፍ አርገመ፤ ዮ አት እሰ ዺፍቴ ገሩ እን በረ በራን ስ ዺሰ። <verse eid="1CH 28:9"/><verse number="10" style="v" sid="1CH 28:10"/>አመ ቀልቤፈዹ፤ <char style="nd">ዋቀዮ</char> አከ አት መነ እዶ ቁልቁሉ ተኡ ቶኮ እጃርቱፍ ስ ፍለቴራቲ። ጀጀባዹ ሆጄዹ።”<verse eid="1CH 28:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 28:11"/>ኤርገሲ ዳዊት ከሮረ ገርዳፎ መነ ቁልቁሉማ፣ ከን እጃርሰሳ፣ ኩታወን ምእ ኬሰ ካአሙ፣ ከን ኩታወን ኦል ኣነኒቲፊ ኩታወን ኬሳ፣ አከሱመስ ከሮረ እዶ ቴሶ አራራ እልመሳ ሶሎሞንት ኬኔ። <verse eid="1CH 28:11"/><verse number="12" style="v" sid="1CH 28:12"/>አከሱመስ ከሮረ ዋን ሀፉር ቁልቁሉን እሰ ያችሴ ከን ኦብዲ መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char>፣ ከን ኩታወን ናኖሳ ጅረኒ፣ ኩታወን መነ ምአ መነ ቁልቁሉማ ዋቃቲፊ ከን መንኩሳ ምኦተ ዋቃቲፍ አዳን ባፈመኒ ሁንደ እት ኬኔ። <verse eid="1CH 28:12"/><verse number="13" style="v" sid="1CH 28:13"/>ከሮረ ረመዲ ሆጂ ሉቦታቲፊ ሌዎታ፣ ተጃጅለ መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ኬሰት ኬነሙ መሉ ሁንደ፣ ምኦተ መነ ቁልቁሉማ ኬሰት ተጃጅላፍ ኦለንረትስ ቀጄልፈመ ንኬኔፍ። <verse eid="1CH 28:13"/><verse number="14" style="v" sid="1CH 28:14"/>ኡልፍነ ወርቄ ምኦተ ወርቄራ ሆጄተመኒ ተጃጅለ ገራ ገራቲፍ ኦለን ሁንዳቲፊ ኡልፍነ ሜቲ ምኦተ ሜቲራ ሆጄተመኒ ተጃጅለ ገራ ገራቲፍ ኦለን ሁንዳስ እሰ ቤክስሴ፦ <verse eid="1CH 28:14"/><verse number="15" style="v" sid="1CH 28:15"/>ኩንስ ኡልፍነ ባቱወን እብሳ ከኔን ወርቄራ ሆጄተመኒቲፊ እብሳወንሳኒ፣ ኡልፍነ ወርቄ ቶኮ ቶኮ ባቱ እብሳቲፊ እብሳሳኒ ወጅን፣ አከሱመስ አኩመ ሆጂ ቶኮ ቶኮ ባቱ እብሳ ሰናት ኡልፍነ ሜቲ ቶኮ ቶኮ ባቱ እብሳቲፊ እብሳወንሳ፣ <verse eid="1CH 28:15"/><verse number="16" style="v" sid="1CH 28:16"/>ኡልፍነ ወርቄ ቶኮ ቶኮ ምንጃለ ቡዴን ቁልቁሉን እረ ካአሙ፣ ኡልፍነ ሜቲ ምንጃል እራ ሆጄተሜ፣ <verse eid="1CH 28:16"/><verse number="17" style="v" sid="1CH 28:17"/>ኡልፍነ ወርቄ ቁልቁሉ ፈልኣነ፣ ወጪቲፊ ኩባያ፣ ኡልፍነ ወርቄ ቶኮ ቶኮ ጫቢ ወርቄራ ሆጄተሜ፤ ኡልፍነ ሜቲ ቶኮ ቶኮ ጫቢ ሜቲራ ሆጄተሜ፤ <verse eid="1CH 28:17"/><verse number="18" style="v" sid="1CH 28:18"/>አከሱመስ ኡልፍነ ወርቄ ቁልቁሌፈሜ ከን እዶ ኣርሳ እጣናቲፍ ቆጴፈሜ። ከሮረ ጋሪ ጄቹንስ ኪሩቤሊ ወርቄራ ሆጄተመን ከኔን ቆቾሳኒ በበልእሰኒ ታቦተ ከኩ <char style="nd">ዋቀዮ</char> ሀጉገን እት ኬኔ።<verse eid="1CH 28:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 28:19"/>ዳዊትስ፣ “አን ዋን ከነ ሁንደ ሀርከ <char style="nd">ዋቀዮ</char> ከን ነረ ጅሩ ሰናን በሬፈማን አርገዼ፤ እንስ ከሮረ ሆጂ ከና ሁንደረት ሁበትና ናፍ ኬኔ” ጄዼ።<verse eid="1CH 28:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 28:20"/>ዳዊት እልመሳ ሶሎሞኒን አከነ ጄዼ፤ “ጭም፤ ጀጀባዹስ፤ ሆጂ ሰነስ ሆጄዹ። ህንሶዳትን፤ አብዲስ ህንኩተትን፤ <char style="nd">ዋቀዮ</char> ጎፍታን ዋቅንኮ ስ ወጅን ጅራቲ። እን ሀመ ሆጂን ተጃጅለ መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ዹሙት ስ ህንዺሱ ዮካን ስ ህንገቱ። <verse eid="1CH 28:20"/><verse number="21" style="v" sid="1CH 28:21"/>ገሬን ሉቦታቲፊ ሌዎታ እጃርሰ መነ ቁልቁሉማ ዋቃቲፍ ቆጳኦዸ። ነምን ፌዺ ቀቡ ከን ኦጉማ ሆጂ ጎሰ ከሚዩ ቀቡ ሁንዲ ሆጂ ሁንደ ስ ገርጋረ። ቆንዳልቶትኒፊ ነሞትን ሁንዲ አጀጀኬ ሁንደ ንፉዸቱ።”<verse eid="1CH 28:21"/></para>
  <chapter eid="1CH 28"/>
  <chapter number="29" style="c" sid="1CH 29"/>
  <para style="s1">ኬና እጃርሰ መነ ቁልቁሉማቲፍ ኬነሜ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 29:1"/>ኤርገሲ ዳዊት ሞትች ያኢ ጉቱዻን አከነ ጄዼ፤ “እልምኮ ሶሎሞን እን ዋቅን ፍለቴ እጆሌፊ ነመ ሙጠትኖ ህንቀብኔዸ። መን ቁልቁሉማ ኩን ከን <char style="nd">ዋቀዮ</char> ጎፍታት መሌ ዋን ከን ነማ ህንተእኒፍ ሆጂንሳ ጉዳዸ። <verse eid="1CH 29:1"/><verse number="2" style="v" sid="1CH 29:2"/>አንስ ዋነን ኬኑ ደንደኡ ሁንደ መነ ቁልቁሉማ ዋቀኮቲፍ፣ ሆጂ ወርቄቲፍ ወርቄ፣ ከን ሜቲቲፍ ሜቲ፣ ከን ናሲቲፍ ናሲ፣ ከን ስቢላቲፍ ስቢለ፣ ከን ሙካቲፍ ሙከ አከሱመስ ዋን በሬድነ ዱበሳቲፍ ኦሉ ሰርዶንክሲ፣ ኬልቄዶን፣ ዸጋወን በበሬዶፊ ዸጋ አዲ ባይእናን ቆጴሴረ። <verse eid="1CH 29:2"/><verse number="3" style="v" sid="1CH 29:3"/>ከነ መሌስ አን ጃለለን መነ ዋቀኮቲፍ ቀቡን ዋነን ዱራን ኬኔ ቱሬት ደበሌ ቀቤኘ ኦፊኮራ ወርቄፊ ሜቲ መነ ቁልቁሉማ ዋቀኮቲፍ ነንኬነ፤ <verse eid="1CH 29:3"/><verse number="4" style="v" sid="1CH 29:4"/>ኩንስ ኬኘን መንቻት ኡፍሱፍ ወርቄ ቁልቁሉ ወርቄ፣ ኦፊሪ ታላንቲ ኩመ ሰዲፊ ሜቲ ቁልቁሌፈሜ ታላንቲ ኩመ ቶርበ፣ <verse eid="1CH 29:4"/><verse number="5" style="v" sid="1CH 29:5"/>አከ ሆጂን ሁንድ ኦጌዪ ሆጂ ሀርካቲን ሆጄተሙፍ ወርቄ ሆጂ ወርቄቲፍ፣ ሜቲሌ ሆጂ ሜቲፍ ኬኔረ። ኤጋ ሀርአ ኤኙቱ ፌዺሳቲን <char style="nd">ዋቀዮፍ</char> አዳን ኦፍ ባሰ?”<verse eid="1CH 29:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 29:6"/>ኤርገሲ ቀጄልችቶትን ማቲ፣ አጀጆትን ጎሶተ እስራኤል፣ አጀጁወን ኩማ፣ አጀጁወን ዽባቲፊ ቆንዳልቶትን ሆጂ ሞቲ ቶአተን ኬናሳኒ ፌዺዻን ኬነን። <verse eid="1CH 29:6"/><verse number="7" style="v" sid="1CH 29:7"/>እሳንስ ሆጂ እጃርሰ መነ ቁልቁሉማ ዋቃቲፍ ወርቄ ታላንቲ ኩመ ሸን፣ ወርቄ ዳሪኪ ኩመ ኩዸን፣ ሜቲ ታላንቲ ኩመ ኩዸን፣ ናሲ ታላንቲ ኩመ ኩዸ ሰዴቲፊ ስቢለ ታላንቲ ኩመ ዽበ ቶኮ ንኬነን። <verse eid="1CH 29:7"/><verse number="8" style="v" sid="1CH 29:8"/>ነምን ዸጋወን ገት ጀቤዪ ቀቡ ሁንድኑስ ሀርከ ዬሂኤል ነምቸ ጎሰ ጌርሾንት መንኩሳ መነ ቁልቁሉማ <char style="nd">ዋቀዮት</char> ንገልቼ። <verse eid="1CH 29:8"/><verse number="9" style="v" sid="1CH 29:9"/>ከነረት ዋን ዱረ ዴምቶትንሳ ፌዺፊ ገራ ጉቱዻን <char style="nd">ዋቀዮፍ</char> ኬነኒፍ ሰብን ሱን ንገመዴ። ዳዊት ሞትችስ አከ መሌ ንገመዴ።<verse eid="1CH 29:9"/></para>
  <para style="s1">ከዸትና ዳዊት</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 29:10"/>ዳዊት ያኢ ጉቱ ዱረት አከነ ጄዼ <char style="nd">ዋቀዮ</char> ገለቴፈቴ፤</para>
  <para style="q1" vid="1CH 29:10">“ያ <char style="nd">ዋቀዮ</char>፣ ዋቀ አባኬኘ እስራኤል</para>
  <para style="q2" vid="1CH 29:10">በረ በራ ሀመ በረ በራት</para>
  <para style="q2" vid="1CH 29:10">ገለን ሲፍ ሃተኡ።<verse eid="1CH 29:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 29:11"/>ያ <char style="nd">ዋቀዮ</char> ሰበቢ ወን ሰሚፊ</para>
  <para style="q2" vid="1CH 29:11">ለፈረ ጅሩ ሁንድ ከንኬ ተኤፍ ጉድትኒፊ ሁምን፣</para>
  <para style="q2" vid="1CH 29:11">ኡልፍን፣ ሱራፊ ስምቦን ከንኬት።</para>
  <para style="q1" vid="1CH 29:11">ያ <char style="nd">ዋቀዮ</char> ሞቱማን ከንኬት፤</para>
  <para style="q2" vid="1CH 29:11">አት ዋን ሁንደረት መታ ኦል ኦል ጄቴዸ።<verse eid="1CH 29:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 29:12"/>በዻዹማፊ ከበጀሙን ስ ብራ አርገመ፤</para>
  <para style="q2" vid="1CH 29:12">አት ቡልቻ ዋን ሁንዳት።</para>
  <para style="q1" vid="1CH 29:12">ኦል ኦል ጉድሱፊ ዋን ሁንዳፍ</para>
  <para style="q2" vid="1CH 29:12">ጀብነ ኬኑፍ፣ ጀብኒፊ ሁምን ስ ሀርከ ጅረ።<verse eid="1CH 29:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 29:13"/>አመስ ያ ዋቀኬኘ፣ ስ ገለቴፈትነ፤</para>
  <para style="q2" vid="1CH 29:13">መቃኬ ኡልፍነ ቀቤሰ ሰነስ ንጀጀትነ።<verse eid="1CH 29:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 29:14"/>“ገሩ አርጁማ አከሲ ጎቹፍ አን ኤኙ? ሰብንኮስ ኤኙ? ወን ሁንድ ስ ብራ ዹፌ፤ ኑ ዋኑመ ሀርከኬቲ ዹፌ ሰነ ቆፈ ሲፍ ኬንኔ። <verse eid="1CH 29:14"/><verse number="15" style="v" sid="1CH 29:15"/>ኑ አኩመ አቦቲንኬኘ ሁንድ ቱረን ሰነ ፉለኬ ዱረት አለጎታፊ ኬሱሞተ፤ በር ጅሬኘኬኛስ ለፈረት አኩመ ጋድዱት፤ አብዲሌ ህንቀብኑ። <verse eid="1CH 29:15"/><verse number="16" style="v" sid="1CH 29:16"/>ያ <char style="nd">ዋቀዮ</char> ዋቀኬኘ፣ ወን ኑ መቃኬ ቁልቁልቻፍ መነ ቁልቁሉማ ሲፍ እጃሩፍ ኬንኔ ኩን ሁንድኑ ሀርከኬቲ ዹፌ፤ ሁንድሳስ ኬቱመ። <verse eid="1CH 29:16"/><verse number="17" style="v" sid="1CH 29:17"/>ያ ዋቀኮ አከ አት ገራ ቆርቱፊ ቀጄሉማ ጃለቱ አን ቤከ። አንስ ዋን ከነ ሁንደ አመነሙማፊ ፌዺዻነን ኬኔ። አመስ አከ ሰብንኬ ከን አስ ጅሩ ኩን ፌዺዻን ሲፍ ኬኔ አን አርጌ ገመዴረ። <verse eid="1CH 29:17"/><verse number="18" style="v" sid="1CH 29:18"/>ያ <char style="nd">ዋቀዮ</char> ዋቀ አቦቲኬኛ፣ ዋቀ አብረሃም፣ ዋቀ ይስሃቅ፣ ዋቀ እስራኤል ፌዺ ከነ በረ በራን ገራ ሰበኬቲ ኬሰ ቱርስ፤ አከ ገራንሳኒስ አመነማ ሲፍ ተኡ ጎዽ። <verse eid="1CH 29:18"/><verse number="19" style="v" sid="1CH 29:19"/>እልመኮ ሶሎሞኒፍስ አከ እን አጀጀኬ፣ ቀጄልቻፊ ለብሲኬ ኤጉ፣ አከ እን ዋን ከነ ሁንደ ሆጄቴ መነ ቁልቁሉማ ከን አን ጉማተ ጎዼፍ ከነሌ እጃሩፍ ፌዺ ገራ ጉቱ ኬኒፍ።”<verse eid="1CH 29:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 29:20"/>ሰነ ቦዴስ ዳዊት ያኢ ጉቱዻን፣ “<char style="nd">ዋቀዮ</char> ዋቀኬሰን ገለቴፈዻ” ጄዼ። ከናፉ ሁንድሳኒ <char style="nd">ዋቀዮ</char> ዋቀ አቦቲሳኒ ንገለቴፈተን፤ ፉለ <char style="nd">ዋቀዮቲፊ</char> ፉለ ሞትቻ ዱረት አዳን ጎምብፈመኒ ንሰገደን።<verse eid="1CH 29:20"/></para>
  <para style="s1">ሶሎሞን ሞቲ ተኡንሳ ቤከሜ</para>
  <para style="r">
    <ref loc="1CH 29:21-25">29፥21‑25</ref> ኩወፈ – <char style="xt"><ref loc="1KI 1:28-53">1ሞቶ 1፥28‑53</ref></char></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 29:21"/>እሳንስ ጉያ እት ኣኑት <char style="nd">ዋቀዮፍ</char> ቀልመ ቀለኒ ኣርሳ ጉበሙ ዽኤሰን፤ ኣርሳን መቃ እስራኤሎታቲን ዽኣቴስ፦ ኮሮሚ ሎኒ ኩመ ቶኮ፣ ኮርቤዪ ሆላ ኩመ ቶኮ፣ ኮርቤዪ ሆላ ጥጥና ኩመ ቶኮ፣ ዽባዩፊ ኣርሳወን ብራ ባይኤዸ። <verse eid="1CH 29:21"/><verse number="22" style="v" sid="1CH 29:22"/>እሳንስ ጋፈ ሰነ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ገመቹ ጉዳዻን ኛተኒ ዹገን።</para>
  <para style="p" vid="1CH 29:22">ኤርገሲሞ ሶሎሞን እልመ ዳዊት ሞቲ ጎዸኒ አከ እን ቡልቻ ተኡፍ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዬሮ ለመፋ ድበን፤ ዛዶቂንሞ ሉበ ጎዸን። <verse eid="1CH 29:22"/><verse number="23" style="v" sid="1CH 29:23"/>ከናፉ ሶሎሞን እዶ አባሳ ዳዊት ሞቲ ተኤ ቴሶ ዋቀዮረ ታኤ። ንምልካኤስ፤ እስራኤሎን ሁንድስ እሳፍ አጀጀመን። <verse eid="1CH 29:23"/><verse number="24" style="v" sid="1CH 29:24"/>አጀጆትን ወራናቲፊ ነሞትን ጀጀቦን ሁንድ አከሱመስ እልማን ዳዊት ሞትቻ ሁንድ አመነሙማሳኒ ሶሎሞን ሞትቻፍ ምርከኔሰን።<verse eid="1CH 29:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 29:25"/>
    <char style="nd">ዋቀዮስ</char> እስራኤሎተ ዱረት ሶሎሞንን ኦል ኦል ካሴ፤ ኡልፍነ ሞቱማ ከን ሞቶትን እሰ ዱረ ቱረን ቶኮዩ እስራኤል ኬሰት ህንቀባትን ንኬኔፍ።<verse eid="1CH 29:25"/></para>
  <para style="s1">ዱአ ዳዊት</para>
  <para style="r">
    <ref loc="1CH 29:26-28">29፥26‑28</ref> ኩወፈ – <char style="xt"><ref loc="1KI 2:10-12">1ሞቶ 2፥10‑12</ref></char></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 29:26"/>ዳዊት እልም እሴይ ጉቱማ እስራኤልረት ሞቲ ቱሬ። <verse eid="1CH 29:26"/><verse number="27" style="v" sid="1CH 29:27"/>እንስ ወጋ አፉርተመ እስራኤልን ቡልቼ፤ ወጋ ቶርበ ኬብሮን ታኤ፣ ወጋ ሶዶሚ ሰዲሞ ዬሩሳሌም ታኤ ንቡልቼ። <verse eid="1CH 29:27"/><verse number="28" style="v" sid="1CH 29:28"/>ዳዊት በረ ዼራ ጅራቴ፣ በዻዹማፊ ኡልፍነ አርገቴ ዱሎሜ ዱኤ። እልምሳ ሶሎሞን ሞቲ ተኤ እዶሳ ቡኤ።<verse eid="1CH 29:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 29:29"/>ሆጂን በረ ሞቱማ ዳዊት ሞትቻ ኬሰ ጀልቀባ ሀመ ዹማት ሆጄተሜ ክታበ ሴና ሳሙኤል ነምቸ ሙልአተ አርጉ ሰና ኬሰት፣ ክታበ ሴና ናታን ራጅቻ ኬሰቲፊ ክታበ ሴና ጋድ ነምቸ ሙልአተ አርጉ ሰና ኬሰት፣ <verse eid="1CH 29:29"/><verse number="30" style="v" sid="1CH 29:30"/>ቡልቺንስሳ ሁንዲፊ ሁምንሳ፣ በር እን፣ እስራኤሊፊ ሞቱሞን ብዮተ ሁንዳ ኬሰ ደርበን በሬፈሜረ።<verse eid="1CH 29:30"/></para>
  <chapter eid="1CH 29"/>
</usx>
