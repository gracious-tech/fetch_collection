<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="LAM" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">ፋሩ</para>
  <para style="toc1">ፋሩ ኤርምያስ</para>
  <para style="toc2">ፋሩ</para>
  <para style="toc3">ፋሩ</para>
  <para style="mt1">ፋሩ</para>
  <para style="mt2">ኤርምያስ</para>
  <chapter number="1" style="c" sid="LAM 1"/>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 1:1"/>መጋላን ዱር ነማን ጉተምቴ ቱርቴ ሱን</para>
  <para style="q2" vid="LAM 1:1">አከምት ኦንቴ ሀፍቴ!</para>
  <para style="q1" vid="LAM 1:1">እሼን ዬሮ ቶኮ ሰቦተ ግዱት ጉዶ ቱርቴ</para>
  <para style="q2" vid="LAM 1:1">አከምት አከ ሃዸ ህዬሳ ታቴ!</para>
  <para style="q1" vid="LAM 1:1">እሼን ኩታሌ ብያ ግዱት ሞቲ ቱርቴ ሱን</para>
  <para style="q2" vid="LAM 1:1">አመ ገርብቲ ታቴ ጅርት።<verse eid="LAM 1:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 1:2"/>እሼን ሀልከን ሀልከን ህቅፈቴ ቦስ፤</para>
  <para style="q2" vid="LAM 1:2">መዲሼረ እምማንቱ ያአ።</para>
  <para style="q1" vid="LAM 1:2">ምቾተሼ ሁንደ ኬሳ</para>
  <para style="q2" vid="LAM 1:2">ከን እሼ ጀጀቤሱ ቶኮዩ ህንጅሩ።</para>
  <para style="q1" vid="LAM 1:2">ምቾትንሼ ሁንድኑ እሼ ገነኒሩ፤</para>
  <para style="q2" vid="LAM 1:2">እሳን ዲኖተሼ ተአኒሩ።<verse eid="LAM 1:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 1:3"/>ረክናፊ ጩንቁርፈመ ጉዳ ቦዴ</para>
  <para style="q2" vid="LAM 1:3">ይሁዳን ቦጅአምቴ ፉዸተምቴ ጅርት።</para>
  <para style="q1" vid="LAM 1:3">እሼን ሰቦተ ግዱ ጅራት፣</para>
  <para style="q2" vid="LAM 1:3">ለፈ እት ቦቆቱሌ ህንአርገትኔ።</para>
  <para style="q1" vid="LAM 1:3">ወር እሼ አርአን ሁንድ</para>
  <para style="q2" vid="LAM 1:3">ረክነሼ ኬሰት እሼ ቀበተን።<verse eid="LAM 1:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 1:4"/>ዳንዲወን ጥዮን ንቦኡ፤</para>
  <para style="q2" vid="LAM 1:4">ነምን አያነሼ ከን ሙርቴፈሜ ከበጁፍ ዹፉ <optbreak/> ቶኮዩ ህንጅሩቲ።</para>
  <para style="q1" vid="LAM 1:4">ከረወንሼ ሁንድ ኦነኒ ጅሩ፤</para>
  <para style="q2" vid="LAM 1:4">ሉቦትንሼ ንኣዱ፤</para>
  <para style="q1" vid="LAM 1:4">ሸመረንሼ ንገዱ፣</para>
  <para style="q2" vid="LAM 1:4">እሼንስ ዽጵነ ጉዳ ኬሰ ጅርት።<verse eid="LAM 1:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 1:5"/>አመጃጆንሼ ጎፍቶተሼ ተአኒሩ፤</para>
  <para style="q2" vid="LAM 1:5">ዲኖተሼት ቶሌረ።</para>
  <para style="q1" vid="LAM 1:5">ሰበቢ ጩቡሼ ባይኤ ሰናቲፍ</para>
  <para style="q2" vid="LAM 1:5">
    <char style="nd">ዋቀዮ</char> ገደ እት ፍዴረ።</para>
  <para style="q1" vid="LAM 1:5">እጆሌንሼ ፉዸተመኒ ዴመኒሩ፤</para>
  <para style="q2" vid="LAM 1:5">ፉለ አመጃጆተሼ ዱረት ቦጅአመኒሩ።<verse eid="LAM 1:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 1:6"/>እንተለ ጥዮንራ</para>
  <para style="q2" vid="LAM 1:6">ሚዸግን ሁንድ ፉዸተሜረ።</para>
  <para style="q1" vid="LAM 1:6">እልማን ሞቶተሼ</para>
  <para style="q2" vid="LAM 1:6">አኩመ ገደምሰ ለፈ ዼዳ ዸቤ ተአኒሩ፤</para>
  <para style="q1" vid="LAM 1:6">እሳን ደዸቢዻን</para>
  <para style="q2" vid="LAM 1:6">ፉለ ወረ እሳን አርአኒ ዱረ በቀተን።<verse eid="LAM 1:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 1:7"/>በሮተ ረክናፊ አሲ አች ጆሩሼ ኬሰ</para>
  <para style="q2" vid="LAM 1:7">ዬሩሳሌም ቀቤኘ</para>
  <para style="q2" vid="LAM 1:7">በረ ዱሪ ከንሼ ቱሬ ሁንደ ንያደት።</para>
  <para style="q1" vid="LAM 1:7">ዬሮ ነሞትንሼ ሀርከ ዲና ሴነንት</para>
  <para style="q2" vid="LAM 1:7">ነምን እሼ ገርጋሩ ቶኮዩ ህንቱሬ።</para>
  <para style="q1" vid="LAM 1:7">ዲኖትንሼ እሼ እላለኒ</para>
  <para style="q2" vid="LAM 1:7">በዲሰሼት ኮልፈን።<verse eid="LAM 1:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 1:8"/>ዬሩሳሌም አከ መሌ ጩቡ ሆጄቴ፤</para>
  <para style="q2" vid="LAM 1:8">አከሲንስ ጡሮፍቴ።</para>
  <para style="q1" vid="LAM 1:8">ወር ኡልፍነ ኬነኒፊ ቱረን ሁንድ እሼ ቱፈተን፤</para>
  <para style="q2" vid="LAM 1:8">እሳን ቁላት ሀፉሼ አርገኒሩቲ፤</para>
  <para style="q1" vid="LAM 1:8">እሼን መታንሼ ጉንጉምቴ</para>
  <para style="q2" vid="LAM 1:8">ኦፍረ ገረ ገልት።<verse eid="LAM 1:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 1:9"/>ጡራኡማንሼ ወንደቦሼት መጠኔ፤</para>
  <para style="q2" vid="LAM 1:9">እሼን ዋን ገረ ዱራት እት ዹፉ ህንያድኔ፤</para>
  <para style="q1" vid="LAM 1:9">ኩፋቲንሼ ነመ ርፈቺሰ፤</para>
  <para style="q2" vid="LAM 1:9">ከን እሼ ጀጀቤሱ ቶኮዩ ህንጅሩ ቱሬ።</para>
  <para style="q1" vid="LAM 1:9">“ያ <char style="nd">ዋቀዮ</char> ረክነኮ እላል፤</para>
  <para style="q2" vid="LAM 1:9">ዲን ሞአቴራቲ!”<verse eid="LAM 1:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 1:10"/>ቀቤኘሼ ሁንደት</para>
  <para style="q2" vid="LAM 1:10">ዲን ሀርከሳ ድሪርሴረ፤</para>
  <para style="q1" vid="LAM 1:10">እሼን ነሞተ ኦርማ</para>
  <para style="q2" vid="LAM 1:10">ወረ አት አከ እሳን</para>
  <para style="q1" vid="LAM 1:10">ወልዳኬ ህንሴኔ ዾውቴ ሰነ</para>
  <para style="q2" vid="LAM 1:10">ኡቱ እሳን እዶሼ ቁልቁሉ ሴነኑ አርግቴ።<verse eid="LAM 1:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 1:11"/>ነሞትንሼ ሁንድኑ ኡቱመ</para>
  <para style="q2" vid="LAM 1:11">ኣደኑ ቡዴነ በርባደቱ፤</para>
  <para style="q1" vid="LAM 1:11">እሳን ሉቡ ኦፊሳኒ ቱርፈቹፍ ጄቸ</para>
  <para style="q2" vid="LAM 1:11">ቀቤኘሳኒ ኛታን ጌደረቱ።</para>
  <para style="q1" vid="LAM 1:11">“ያ <char style="nd">ዋቀዮ</char> ነ እላል፣ ነ ያደዹስ፤</para>
  <para style="q2" vid="LAM 1:11">አን ቱፈተሜራቲ።”<verse eid="LAM 1:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 1:12"/>“ወረ ከራረ ደበርተን ሁንድ፣ ኩን እስኒፍ ሆማ ምቲ?</para>
  <para style="q2" vid="LAM 1:12">ናኖኬሰን እላላቲ አርጋ።</para>
  <para style="q1" vid="LAM 1:12">ረክን አከ ረክነኮ</para>
  <para style="q2" vid="LAM 1:12">ከን አን እቲን ረከዼ</para>
  <para style="q1" vid="LAM 1:12">ከን <char style="nd">ዋቀዮ</char> ጉያ ዼከምሰሳት</para>
  <para style="q2" vid="LAM 1:12">ነት ፍዴ ሰና ጅሩ ቶኮዩ ጅራ?<verse eid="LAM 1:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 1:13"/>“እን ኦል ጉባዻ እብደ ኤርጌ፤</para>
  <para style="q2" vid="LAM 1:13">እብደ ሰነ ለፌኮ ኬሰ ሴንስሰ።</para>
  <para style="q1" vid="LAM 1:13">እን ሚለኮቲፍ ክዮ ድሪርሴ</para>
  <para style="q2" vid="LAM 1:13">ዱግደ ዱበት ነ ዴብሴ፤</para>
  <para style="q1" vid="LAM 1:13">እን ኮጳት ነ ሀምብሴ</para>
  <para style="q2" vid="LAM 1:13">ጉያ ጉቱ ነ ደዸብሲሴ።<verse eid="LAM 1:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 1:14"/>“ጩቡንኮ ዋንጆት ህዸሜረ፤</para>
  <para style="q2" vid="LAM 1:14">እሳን ሀርከሳቲን ወልት ፎአመን።</para>
  <para style="q1" vid="LAM 1:14">እሳን ሞርመኮት ረራፈመን፤</para>
  <para style="q2" vid="LAM 1:14">ጎፍታን ሁምነኮ ደዸብሲሴ።</para>
  <para style="q1" vid="LAM 1:14">እን ወረ አን ኦፍራ ዴብሱ ህንደንዴኜት</para>
  <para style="q2" vid="LAM 1:14">ደበርሴ ነ ኬኔረ።<verse eid="LAM 1:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 1:15"/>“ጎፍታን ጎቶተ ነ ኬሰት አርገመን</para>
  <para style="q2" vid="LAM 1:15">ሁንደ ገቴረ፤</para>
  <para style="q1" vid="LAM 1:15">እን ደርገጎተኮ ጨጨብሱፍ</para>
  <para style="q2" vid="LAM 1:15">ያኢ ዋመቴ።</para>
  <para style="q1" vid="LAM 1:15">ጎፍታን እዶ ጩንፋ ወይኒሳት</para>
  <para style="q2" vid="LAM 1:15">ዱርበ ቁልቁልቲ እንተለ ይሁዳ ዽዺቴረ።<verse eid="LAM 1:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 1:16"/>“ወን አን ቦኤ</para>
  <para style="q2" vid="LAM 1:16">እጅኮ እምማኒን ጉተሜፍ ከናዸ።</para>
  <para style="q1" vid="LAM 1:16">ነምን ነ ጀጀቤሱፍ ዽኦ ጅሩ ቶኮዩ ህንጅሩ፤</para>
  <para style="q2" vid="LAM 1:16">ከን ሀፉረኮ በየነቺሱስ ህንጅሩ።</para>
  <para style="q1" vid="LAM 1:16">ሰበቢ ዲን ሁምነ አርገቴፍ</para>
  <para style="q2" vid="LAM 1:16">እጆሌንኮ ሀርከ ዱዋ ሀፈን።”<verse eid="LAM 1:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 1:17"/>ጥዮን ሀርከሼ በልእፈቴ ጅርት፤</para>
  <para style="q2" vid="LAM 1:17">ገሩ ነምን እሼ ጀጀቤሱ ቶኮዩ ህንጅሩ።</para>
  <para style="q1" vid="LAM 1:17">አከ ኦሎንሳ አመጃጆተሳ ተአኒፍ</para>
  <para style="q2" vid="LAM 1:17">
    <char style="nd">ዋቀዮ</char> ያቆብት አጀጄረ፤</para>
  <para style="q1" vid="LAM 1:17">ዬሩሳሌምስ ግዱሳኒት</para>
  <para style="q2" vid="LAM 1:17">ዋን ጡራኣ ታቴርት።<verse eid="LAM 1:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 1:18"/>“<char style="nd">ዋቀዮ</char> ቀጄላዸ፤</para>
  <para style="q2" vid="LAM 1:18">ተኡስ አን አጀጀወንሳት ፍንጭሌን ቱሬ።</para>
  <para style="q1" vid="LAM 1:18">ያ ሰቦተ፣ ሁንድኬሰን ዸገኣ፤</para>
  <para style="q2" vid="LAM 1:18">ረክነኮስ እላላ።</para>
  <para style="q1" vid="LAM 1:18">ደርገጎትኒፊ ሸመረንኮ</para>
  <para style="q2" vid="LAM 1:18">ቦጅአመኒ ፉዸተመኒሩ።<verse eid="LAM 1:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 1:19"/>“አን ቱምስቶተኮ ነንዋመዼ፤</para>
  <para style="q2" vid="LAM 1:19">እሳን ገሩ ነ ገነን።</para>
  <para style="q1" vid="LAM 1:19">ሉቦትንኮፊ ማንጉዶትንኮ</para>
  <para style="q2" vid="LAM 1:19">ኡቱ ሉቡሳኒ ኦልፈቹፍ</para>
  <para style="q1" vid="LAM 1:19">ኛተ በርባደተኑ</para>
  <para style="q2" vid="LAM 1:19">መጋላ ኬሰት ዹመን።<verse eid="LAM 1:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 1:20"/>“ያ <char style="nd">ዋቀዮ</char> አከ አን ዽጰዼ እላል!</para>
  <para style="q2" vid="LAM 1:20">አን ኬሰኮት ዽጰዼረ፤</para>
  <para style="q1" vid="LAM 1:20">ገራኮ ኬሰት ራፈሜረ፤</para>
  <para style="q2" vid="LAM 1:20">አን ነመ አከ መሌ ፍንጭሉን ቱሬቲ።</para>
  <para style="q1" vid="LAM 1:20">አላ ጎራዴን ነመ ቀለ፤</para>
  <para style="q2" vid="LAM 1:20">መነ ኬሰሞ ዱአ ቆፈቱ ጅረ።<verse eid="LAM 1:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 1:21"/>“ነሞትን አከ አን ኣዳ ጅሩ ዸገአኒሩ፤</para>
  <para style="q2" vid="LAM 1:21">ከን ነ ጀጀቤሱ ገሩ ህንጅሩ።</para>
  <para style="q1" vid="LAM 1:21">ዲኖትንኮ ሁንድኑ ረክነኮ ዸገአኒሩ፤</para>
  <para style="q2" vid="LAM 1:21">እሳን ዋን አት ጎቴት ገመደኒሩ።</para>
  <para style="q1" vid="LAM 1:21">አከ እሳን አኩመኮ ተአኒፍ</para>
  <para style="q2" vid="LAM 1:21">ማሎ አት ጉያ ጄቴ ሰነ ፍድ።<verse eid="LAM 1:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 1:22"/>“ሀምንሳኒ ሁንድኑ</para>
  <para style="q2" vid="LAM 1:22">ፉለኬ ዱረት ሃዽኣቱ፤</para>
  <para style="q1" vid="LAM 1:22">ዋኑመ ሰበቢ ጩቡኮ ሁንዳቲፍ ነት ፍዴ ሰነ</para>
  <para style="q2" vid="LAM 1:22">እሳንትሌ ፍድ!</para>
  <para style="q1" vid="LAM 1:22">ኣዱንኮ ባይአቴራቲ፤</para>
  <para style="q2" vid="LAM 1:22">ኦኔንኮስ ደዸብዴርት።”<verse eid="LAM 1:22"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="LAM 1"/>
  <chapter number="2" style="c" sid="LAM 2"/>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 2:1"/>ጎፍታን አከምት ዱሜሰ ዼከምሰሳቲን</para>
  <para style="q2" vid="LAM 2:1">እንተለ ጥዮን ሀጉጌ!</para>
  <para style="q1" vid="LAM 2:1">እን ኡልፍነ እስራኤል</para>
  <para style="q2" vid="LAM 2:1">ሰሚዻ ለፈት ገድ ደደርበቴረ፤</para>
  <para style="q1" vid="LAM 2:1">እን ጉያ ዼከምሰሳት</para>
  <para style="q2" vid="LAM 2:1">ኤጄተ ሚለሳ ህንያደትኔ።<verse eid="LAM 2:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 2:2"/>ጎፍታን ገረ ላፍነ ቶኮ መሌ</para>
  <para style="q2" vid="LAM 2:2">እዶ ጅሬኘ ያቆብ ሁንደ ልቅምሴ ጅረ፤</para>
  <para style="q1" vid="LAM 2:2">ደአኖ እንተለ ይሁዳስ</para>
  <para style="q2" vid="LAM 2:2">ዼከምሰሳቲን ዲጌ።</para>
  <para style="q1" vid="LAM 2:2">እን ሞቱማሼቲፊ ቡልችቶተሼ</para>
  <para style="q2" vid="LAM 2:2">ሰልጵሴ ለፈት ገድ ዴብሴ።<verse eid="LAM 2:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 2:3"/>እን ዼከምሰ ሶዳችሳዻን</para>
  <para style="q2" vid="LAM 2:3">ጋንፈ እስራኤል ሁንደ ጨጨብሴ።</para>
  <para style="q1" vid="LAM 2:3">ዮሙ ዲን ዽኣቴትስ</para>
  <para style="q2" vid="LAM 2:3">ሀርከሳ ምርጋ ዱበት ዴብፈቴ።</para>
  <para style="q1" vid="LAM 2:3">እን አኩመ አረበ እብዳ ከን ዋን ናኖሳ ጅሩ ጉቡ ሰና</para>
  <para style="q2" vid="LAM 2:3">ያቆብ ኬሰት ቦበኤ።<verse eid="LAM 2:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 2:4"/>እን አኩመ ዲናት እዳሳ ደብሰቴ፤</para>
  <para style="q2" vid="LAM 2:4">ሀርክሳ ምርጋ ቆጳኤረ።</para>
  <para style="q1" vid="LAM 2:4">ወረ እጀት በሬደን ሁንደ</para>
  <para style="q2" vid="LAM 2:4">አኩመ አመጃጂት ቀሌ፤</para>
  <para style="q1" vid="LAM 2:4">ዱንካነ እንተለ ጥዮንት</para>
  <para style="q2" vid="LAM 2:4">ዼከምሰሳ አኩመ እብዳ ሮብሴ።<verse eid="LAM 2:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 2:5"/>ጎፍታን አኩመ ዲና ተኤ፤</para>
  <para style="q2" vid="LAM 2:5">እን እስራኤልን ልቅምሴረ።</para>
  <para style="q1" vid="LAM 2:5">እን መሰራወንሼ ሁንደ ልቅምሴ</para>
  <para style="q2" vid="LAM 2:5">ደአኖሼ ጀባሌ ዲጌረ።</para>
  <para style="q1" vid="LAM 2:5">እን እንተለ ይሁዳት</para>
  <para style="q2" vid="LAM 2:5">ቦእቻፊ ፋሩ ቦእቻ ባይእሴረ።<verse eid="LAM 2:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 2:6"/>እን ለፈ ጅሬኘሳ አኩመ እዶ ብቅልቱ ኦንሴረ፤</para>
  <para style="q2" vid="LAM 2:6">እዶ ወል ገኢሳስ በሌሴረ።</para>
  <para style="q1" vid="LAM 2:6">
    <char style="nd">ዋቀዮ</char> አከ ጥዮን</para>
  <para style="q2" vid="LAM 2:6">አያነሼ ከን ሙርታኤፊ ሰንበቶተሼ እራንፈቱ ጎዼረ፤</para>
  <para style="q1" vid="LAM 2:6">እን ዼከምሰሳ ሶዳችሳ ሰናን</para>
  <para style="q2" vid="LAM 2:6">ሞቶታፊ ሉቦተ አከ መሌ ቱፈቴ።<verse eid="LAM 2:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 2:7"/>ጎፍታን እዶ ኣርሳሳ ቱፈቴረ፤</para>
  <para style="q2" vid="LAM 2:7">እዶ ቁልቁሉሳሌ ዺሴረ።</para>
  <para style="q1" vid="LAM 2:7">ደላወን መሰራወንሼ</para>
  <para style="q2" vid="LAM 2:7">ደበርሴ ሀርከ ዲኖታት ኬኔረ፤</para>
  <para style="q1" vid="LAM 2:7">እሳን አኩመ ጉያ አያነ ሙርቴፈሜት</para>
  <para style="q2" vid="LAM 2:7">መነ <char style="nd">ዋቀዮ</char> ኬሰት ሰገሌ ኦል ፉዸተኒ እየን።<verse eid="LAM 2:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 2:8"/>
    <char style="nd">ዋቀዮ</char> ደላ ናኖ እንተለ ጥዮን ጅሩ</para>
  <para style="q2" vid="LAM 2:8">ዲጉፍ ሙርቴሴረ።</para>
  <para style="q1" vid="LAM 2:8">እን ሰፈርቱ ድሪርሴረ፤</para>
  <para style="q2" vid="LAM 2:8">በርበዴሱራስ ሀርከሳ ህንዴብፈትኔ።</para>
  <para style="q1" vid="LAM 2:8">አከ ደላን ኤጉምሳቲፊ ኬኘን ፋርሰኒ ቦአን ጎዼ፤</para>
  <para style="q2" vid="LAM 2:8">እሳንስ ቶኩማዻን በደን።<verse eid="LAM 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 2:9"/>ከረወንሼ ለፈ ኬሰ ዽዽመኒሩ፤</para>
  <para style="q2" vid="LAM 2:9">እን ደንቀራወን ስቢለሼ ጨጨብሴ በሌሴረ።</para>
  <para style="q1" vid="LAM 2:9">ሞቲንሼቲፊ እልማን ሞቶተሼ ቦጅአመኒ <optbreak/> ሰቦተ ግዱ ብብትናአኒሩ፤</para>
  <para style="q2" vid="LAM 2:9">ሴር ስአች ህንጅራቱ፤</para>
  <para style="q1" vid="LAM 2:9">ራጆትንሼስ ስአች</para>
  <para style="q2" vid="LAM 2:9">
    <char style="nd">ዋቀዮ</char> ብራ ሙልአተ ህንአርገን።<verse eid="LAM 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 2:10"/>ማንጉዶትን እንተለ ጥዮን</para>
  <para style="q2" vid="LAM 2:10">ጨልእሰኒ ለፈ ተታአን፤</para>
  <para style="q1" vid="LAM 2:10">እሳን ዳራ መታት ፍርፍርፈተኒ</para>
  <para style="q2" vid="LAM 2:10">ኡፈተ ገዳስ ኡፈተን።</para>
  <para style="q1" vid="LAM 2:10">ሸመረን ዬሩሳሌም</para>
  <para style="q2" vid="LAM 2:10">መታሳኒ ገድ ቀበተን።<verse eid="LAM 2:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 2:11"/>እጅኮ ቦእቻን ደዸቤረ፤</para>
  <para style="q2" vid="LAM 2:11">ኬሰኮት ዽጰዼረ፤</para>
  <para style="q1" vid="LAM 2:11">ሰበቢ ሰብንኮ ዹሜፍ</para>
  <para style="q2" vid="LAM 2:11">ሰበቢ እጆሌፊ ዳእመን</para>
  <para style="q1" vid="LAM 2:11">ዳንዲወን መጋላረት ገገበኒፍ</para>
  <para style="q2" vid="LAM 2:11">ገራንኮ ገዳን ላፌረ።<verse eid="LAM 2:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 2:12"/>እሳን ዮሙ ዳንዲወን መጋላረት</para>
  <para style="q2" vid="LAM 2:12">አኩመ ነሞተ መዳአኒት ገገበንት፣</para>
  <para style="q1" vid="LAM 2:12">ዮሙ ሉቡንሳኒ</para>
  <para style="q2" vid="LAM 2:12">ሀሙ ሃዸሳኒረት በኡፍ ጅርቱት</para>
  <para style="q1" vid="LAM 2:12">“ቡዴኒፊ ዳዺን ወይኒ ኤሰ ጅሩ?”</para>
  <para style="q2" vid="LAM 2:12">ጄዸኒ ሃዾተሳኒ ጋፈቱ።<verse eid="LAM 2:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 2:13"/>ያ እንተለ ዬሩሳሌም፣</para>
  <para style="q2" vid="LAM 2:13">አን ማል ሲፍ ጄቹን ደንደአ?</para>
  <para style="q2" vid="LAM 2:13">ማሊነን ወል ስ ቅጤሰ?</para>
  <para style="q1" vid="LAM 2:13">ያ እንተለ ጥዮን ዱርበ ቁልቁልቲ</para>
  <para style="q2" vid="LAM 2:13">አን አከን ስ ጀጀቤሱፍ</para>
  <para style="q2" vid="LAM 2:13">ማልን ስ ፈኬሱ ደንደአ?</para>
  <para style="q1" vid="LAM 2:13">መዳንኬ አኩመ ገላና ገድ ፈጎዸ።</para>
  <para style="q2" vid="LAM 2:13">ኤኙቱ ስ ፈይሱ ደንደአ?<verse eid="LAM 2:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 2:14"/>ሙልአትን ራጆተኬቲ</para>
  <para style="q2" vid="LAM 2:14">ሶባፊ ከን ፋይዳ ህንቀብኔዸ፤</para>
  <para style="q1" vid="LAM 2:14">እሳን ቦጅአሙኬ ሀምብሱፍ</para>
  <para style="q2" vid="LAM 2:14">ጩቡኬ እፈ ህንባፍኔ።</para>
  <para style="q1" vid="LAM 2:14">ራጂን እሳን ሲፍ ኬነንስ</para>
  <para style="q2" vid="LAM 2:14">ሶባፊ ከን ከራራ ነመ በሌሱዸ።<verse eid="LAM 2:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 2:15"/>ወር ከራኬቲን ደርበን ሁንድኑ</para>
  <para style="q2" vid="LAM 2:15">ሀርከሳኒ ስት ሩሩኩቱ፤</para>
  <para style="q1" vid="LAM 2:15">እሳንስ እንተለ ዬሩሳሌምት</para>
  <para style="q2" vid="LAM 2:15">ቆሱፊ መታ ራሱዻን፣</para>
  <para style="q1" vid="LAM 2:15">“መጋላን ሙሜ ሚዸግና</para>
  <para style="q2" vid="LAM 2:15">ገመቹ ጉቱ ለፋ</para>
  <para style="q2" vid="LAM 2:15">ጄዸምቴ ዋመምቴ ሱን ከና?” ጄዹ።<verse eid="LAM 2:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 2:16"/>ዲኖትንኬ ሁንድኑ</para>
  <para style="q2" vid="LAM 2:16">አፋንሳኒ ስት በነቱ፤</para>
  <para style="q1" vid="LAM 2:16">እሳን ቆሱፊ እልካንሳኒ ቀሩዻን</para>
  <para style="q2" vid="LAM 2:16">“ኑ እሼ ልቅምስኔረ።</para>
  <para style="q1" vid="LAM 2:16">ጉያን ኑ ኤገቻ ቱሬ ሱን ከናዸ፤</para>
  <para style="q2" vid="LAM 2:16">ኑ ዋን ከነ አርጉፍ ጅራትኔረ” ጄዹ።<verse eid="LAM 2:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 2:17"/>
    <char style="nd">ዋቀዮ</char> ዋን ከሮርፈቴ ሆጄቴረ፤</para>
  <para style="q2" vid="LAM 2:17">ዱቢሳ ከን በረ ዼራን ዱረ</para>
  <para style="q2" vid="LAM 2:17">ዱበቴ ሰነ ጉተቴረ።</para>
  <para style="q1" vid="LAM 2:17">እን ገረ ላፍነ ቶኮ መሌ ስ ገረገልቼረ፤</para>
  <para style="q2" vid="LAM 2:17">አከ ዲንኬ ስት ገመዱ ጎዼረ፤</para>
  <para style="q2" vid="LAM 2:17">ጋንፈ አመጃጂኬቲ ኦል ኦል ቀቤረ።<verse eid="LAM 2:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 2:18"/>ኦኔን ነሞታ</para>
  <para style="q2" vid="LAM 2:18">ገረ ጎፍታት እየ።</para>
  <para style="q1" vid="LAM 2:18">ያ ደላ እንተለ ጥዮን</para>
  <para style="q2" vid="LAM 2:18">ሀልከኒ ጉያ</para>
  <para style="q2" vid="LAM 2:18">እምማንኬ አከ ለጋ ሃያኡ፤</para>
  <para style="q1" vid="LAM 2:18">ቦቆና ቶኮሌ ኦፊኬቲፍ ህንኬንን፤</para>
  <para style="q2" vid="LAM 2:18">እጅኬስ ህንቦቆትን።<verse eid="LAM 2:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 2:19"/>ዮሙ ኤጉምስ ሀልከኒ ጀልቀቡት</para>
  <para style="q2" vid="LAM 2:19">ከኢቲ ሀልከኒን እይ፤</para>
  <para style="q1" vid="LAM 2:19">ፉለ ጎፍታ ዱረት</para>
  <para style="q2" vid="LAM 2:19">ኦኔኬ አከ ብሻኒ ዸንገላስ።</para>
  <para style="q1" vid="LAM 2:19">ሉቡ እጆሌኬቲ</para>
  <para style="q2" vid="LAM 2:19">ከኔን ፊጤ ዳንዲ ሁንዳት</para>
  <para style="q1" vid="LAM 2:19">ቤላን ገገበኒቲፍ ጄዺቲ</para>
  <para style="q2" vid="LAM 2:19">ሀርከኬ ገረሳት ኦል ቀበዹ።<verse eid="LAM 2:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 2:20"/>“ያ <char style="nd">ዋቀዮ</char>፣ አት እላል፤ አርግስ፦</para>
  <para style="q2" vid="LAM 2:20">አት ተኩማ ኤኙረት ዋን አከሲ ጎቴ ቤክተ?</para>
  <para style="q1" vid="LAM 2:20">ሃዾትን ዳእመንሳኒ፣</para>
  <para style="q2" vid="LAM 2:20">እጆሌ ኩኑንሰኒ ጉድሰን ኛቹ ቀቡ?</para>
  <para style="q1" vid="LAM 2:20">ሉብኒፊ ራጂን፣</para>
  <para style="q2" vid="LAM 2:20">እዶ ቁልቁሉ ከን ጎፍታ ኬሰት አጄፈሙ ቀቡ?<verse eid="LAM 2:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 2:21"/>“ደርገጎትኒፊ ማንጉዶትን፣</para>
  <para style="q2" vid="LAM 2:21">ወሊ ወጅን አዋረ ከራረ ጪሱ፤</para>
  <para style="q1" vid="LAM 2:21">ደርገጎትኒፊ ሸመረንኮ</para>
  <para style="q2" vid="LAM 2:21">ጎራዴዻን አጄፈመኒሩ።</para>
  <para style="q1" vid="LAM 2:21">አት ጋፈ ዼከምሰኬቲት እሳን ፍጤ፤</para>
  <para style="q2" vid="LAM 2:21">ገረ ላፍነ ቶኮ መሌ እሳን ቀልቴ።<verse eid="LAM 2:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 2:22"/>“አት አኩመ ጉያ አያነ ሙርቴፈሜት ነመ ዋምቱት</para>
  <para style="q2" vid="LAM 2:22">ቅጠ ሁንዳኑ ሶዳ ነት ዋምቴ።</para>
  <para style="q1" vid="LAM 2:22">ጉያ ዼከምሰ <char style="nd">ዋቀዮት</char>፣</para>
  <para style="q2" vid="LAM 2:22">ሆማ ህንምልቅኔ ዮካን ህንሀፍኔ፤</para>
  <para style="q1" vid="LAM 2:22">ወረ አን ደኤ ጉድሴ</para>
  <para style="q2" vid="LAM 2:22">ዲንኮ ነ ጀላ በሌሴረ።”<verse eid="LAM 2:22"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="LAM 2"/>
  <chapter number="3" style="c" sid="LAM 3"/>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 3:1"/>ነምን ኡሌ ዼከምሰሳቲን</para>
  <para style="q2" vid="LAM 3:1">ረክነ አርጌ አናዸ።<verse eid="LAM 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 3:2"/>እን ፉለሳ ዱራ ነ አርኤ</para>
  <para style="q2" vid="LAM 3:2">አከ አን ቆደ እፋ ዱከነ ኬሰ ዴሙ ነ ጎዼ፤<verse eid="LAM 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 3:3"/>ዹጉማን እን ጉያ ጉቱ፣</para>
  <para style="q2" vid="LAM 3:3">አሙማ አመ ሀርከሳ ነት ዴብሴ።<verse eid="LAM 3:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 3:4"/>እን ፎንኮቲፊ ጎጋኮ ዱሎምሴረ፤</para>
  <para style="q2" vid="LAM 3:4">ለፌኮሌ ጨጨብሴረ።<verse eid="LAM 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 3:5"/>እን ነ መርሴ</para>
  <para style="q2" vid="LAM 3:5">ሀዻኡማፊ ግድራ ነት ናኔሴረ።<verse eid="LAM 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 3:6"/>አኩመ ወረ ዱር ዹመኒ</para>
  <para style="q2" vid="LAM 3:6">አከ አን ዱከነ ኬሰ ጅራዹ ነ ጎዼ።<verse eid="LAM 3:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 3:7"/>እን አከ አን ህንምልቅኔፍ ደላ ነት እጃሬ፤</para>
  <para style="q2" vid="LAM 3:7">ፎንጫ ኡልፋቱስ ነት ፌኤ።<verse eid="LAM 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 3:8"/>ዮሙ አን ዋመዹ ዮካን ገርጋርሳፍ እየዹትሌ</para>
  <para style="q2" vid="LAM 3:8">እን ከዸትናኮ ዸገኡ ድደ።<verse eid="LAM 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 3:9"/>ከራኮ ዸጋ ሶፈሜን ጩፌ፤</para>
  <para style="q2" vid="LAM 3:9">ዳንዲኮሌ ንጀልእሰ።<verse eid="LAM 3:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 3:10"/>እን አኩመ አማኬተ ርጴ ዋ ኤገቱ፣</para>
  <para style="q2" vid="LAM 3:10">አኩመ ሌንጨ ዾከቴ ጅሩ<verse eid="LAM 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 3:11"/>ዳንዲራ ነ ሀርክሴ ነ ጭጭሬ፤</para>
  <para style="q2" vid="LAM 3:11">ኮጳት ነ ገቴ።<verse eid="LAM 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 3:12"/>እን እዳሳ ሉቅፈቴ</para>
  <para style="q2" vid="LAM 3:12">ጥየሳ ነት ቀቤ።<verse eid="LAM 3:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 3:13"/>ኮሮጆሳ ኬሳ ጥየ ባሴ</para>
  <para style="q2" vid="LAM 3:13">ኦኔኮ ወራኔ።<verse eid="LAM 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 3:14"/>አን ሰበኮ ሁንዳፍ ዋን ኮልፋ ነንተኤ፤</para>
  <para style="q2" vid="LAM 3:14">እሳን ጉያ ጉቱ ፋሩዻን ነት ቆሱ።<verse eid="LAM 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 3:15"/>እን ዋን ሀዻኣ ነ ኛችሴ፤</para>
  <para style="q2" vid="LAM 3:15">ሀዾፍቱሌ ነ ቁብሴ።<verse eid="LAM 3:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 3:16"/>እን ዸጋዻን እልካንኮ ጨብሴ፤</para>
  <para style="q2" vid="LAM 3:16">አዋረ ኬሰትስ ነ ዽዺቴ።<verse eid="LAM 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 3:17"/>አን ነጋ ነንዸቤ፤</para>
  <para style="q2" vid="LAM 3:17">ገመቹን ማል አከ ተኤስ ነንእራንፈዼ።<verse eid="LAM 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 3:18"/>ከናፉ አን “ኡልፍንኮ፣</para>
  <para style="q2" vid="LAM 3:18">አብዲን አን <char style="nd">ዋቀዮራ</char> ቀቡ ሁንድኑ በዴረ” ነንጄዼ።<verse eid="LAM 3:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 3:19"/>አን ረክናፊ አሲ አች ጆሩኮ</para>
  <para style="q2" vid="LAM 3:19">ሀዻኡማፊ ሀዾፍቱስ ነንያደዸ።<verse eid="LAM 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 3:20"/>ሉቡንኮ ዬሮ ሁንደ ዋን ከነ ያድ፤</para>
  <para style="q2" vid="LAM 3:20">ነ ኬሰትስ ገድ ኦፍ ቀብድ።<verse eid="LAM 3:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 3:21"/>ተኡስ አን ዋን ከነ ነንቀልቤፈዸ፤</para>
  <para style="q2" vid="LAM 3:21">ከናፉ አን አብዲ ቀበ።<verse eid="LAM 3:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 3:22"/>ኑ ሰበቢ ጃለለ <char style="nd">ዋቀዮ</char> ጉዳ ሰናቲፍ ህንበድኑ፤</para>
  <para style="q2" vid="LAM 3:22">ገረ ላፍንሳ ህንዹሙቲ።<verse eid="LAM 3:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="LAM 3:23"/>እሳን ገነመ ሁንደ ሃራዸ፤</para>
  <para style="q2" vid="LAM 3:23">አመነሙማንኬስ ጉዳዸ።<verse eid="LAM 3:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="LAM 3:24"/>አንስ፣ “<char style="nd">ዋቀዮ</char> ቆደኮት፤</para>
  <para style="q2" vid="LAM 3:24">ከናፉ አን እሰ ነንኤገዸ” ኦፊን ነንጄዸ።<verse eid="LAM 3:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="LAM 3:25"/>
    <char style="nd">ዋቀዮ</char> ወረ እሰ አብደተኒፍ፣</para>
  <para style="q2" vid="LAM 3:25">ከኔን እሰ በርባደኒፍ ጋሪዸ፤<verse eid="LAM 3:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="LAM 3:26"/>ፈይሱ <char style="nd">ዋቀዮ</char></para>
  <para style="q2" vid="LAM 3:26">ጨልእሰኒ ኤገቹን ጋሪዸ።<verse eid="LAM 3:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="LAM 3:27"/>ዬሮ ደርገጉማሳት</para>
  <para style="q2" vid="LAM 3:27">ዋንጆ ባቹን ነማፍ ጋሪዸ።<verse eid="LAM 3:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="LAM 3:28"/>እን ኮጳሳ ጨልእሴ ሃታኡ፤</para>
  <para style="q2" vid="LAM 3:28">
    <char style="nd">ዋቀዮ</char> እሰ ባችሴራቲ።<verse eid="LAM 3:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="LAM 3:29"/>አመሌ አብዲን ንጅረ ተኣቲ፣</para>
  <para style="q2" vid="LAM 3:29">እን ፉለሳ አዋረ ኬሰ ሃሱቀቱ።<verse eid="LAM 3:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="LAM 3:30"/>እን ነመ እሰ ዸኡት መዲሳ ሃቀቡ፤</para>
  <para style="q2" vid="LAM 3:30">ሰልጵናንስ ሃጉተሙ።<verse eid="LAM 3:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="LAM 3:31"/>ጎፍታን በረ በራን</para>
  <para style="q2" vid="LAM 3:31">ነመ ህንገቱቲ።<verse eid="LAM 3:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="LAM 3:32"/>እን ገደ ፍዱሌ ገራ ንላፈ፤</para>
  <para style="q2" vid="LAM 3:32">ጃለልሳ ከን ህንጌደረምኔ ሱን ጉዳዻቲ።<verse eid="LAM 3:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="LAM 3:33"/>እን እት ያዴ ረክነ</para>
  <para style="q2" vid="LAM 3:33">ዮካን ዽጵነ ሰኚ ነማት ህንፍዱቲ።<verse eid="LAM 3:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="LAM 3:34"/>ዮሙ ህዸምቶትን ብየቲ ኬሰ ጅረን ሁንድ</para>
  <para style="q2" vid="LAM 3:34">ሚለ ጀለት ዽዺተመን፣<verse eid="LAM 3:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="LAM 3:35"/>ዮሙ ፉለ ዋቀ ዋን ሁንዳ ኦሊ ዱረት</para>
  <para style="q2" vid="LAM 3:35">ምርግ ነመ ቶኮ ዺበሙ፣<verse eid="LAM 3:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="LAM 3:36"/>ዮሙ ሙርቲን ቀጄላን ዸበሙ፣</para>
  <para style="q2" vid="LAM 3:36">ጎፍታን ዋን አከሲ ህንአርጉ?<verse eid="LAM 3:36"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="37" style="v" sid="LAM 3:37"/>ዮ ጎፍታን አጀጁ ባቴ</para>
  <para style="q2" vid="LAM 3:37">ኤኙቱ ዱበቴ ዋን ሰነ ፊጣን ባሱ ደንደአ?<verse eid="LAM 3:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="LAM 3:38"/>ወን ሀማኒፊ ወን ጋሪን</para>
  <para style="q2" vid="LAM 3:38">አፋኑመ ዋቀ ዋን ሁንዳ ኦሊቲ በኣ ምቲ?<verse eid="LAM 3:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="LAM 3:39"/>ዮስ ነምን ሉቡን ጅራቱ ከምዩ</para>
  <para style="q2" vid="LAM 3:39">ማሊፍ ዮሙ ጩቡሳቲፍ <optbreak/> አደበሙት ጉንጉመሬ?<verse eid="LAM 3:39"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="40" style="v" sid="LAM 3:40"/>ኮታ ኑ ዳንዲኬኘ ቆሬ ሃእላሉ፤</para>
  <para style="q2" vid="LAM 3:40">ገረ <char style="nd">ዋቀዮትስ</char> ሃዴብኑ።<verse eid="LAM 3:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="LAM 3:41"/>ኑ ኦኔኬኛፊ ሀርከኬኘ</para>
  <para style="q2" vid="LAM 3:41">ገረ ዋቀ ሰሚ ኬሰ ጅሩት ኦል ቀብኔ አከነ ሃጄኑ፦<verse eid="LAM 3:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="LAM 3:42"/>“ኑ ጩቡ ሆጄትኔረ፤ ፍንጭሌረስ፤</para>
  <para style="q2" vid="LAM 3:42">አትስ ኑፍ ህንዺፍኔ።<verse eid="LAM 3:42"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="43" style="v" sid="LAM 3:43"/>“አት ዼከምሳን ኦፍ ሀጉግዴ ኑ አሪቴ፤</para>
  <para style="q2" vid="LAM 3:43">ገረ ላፍነ መሌስ ኑ ፍጤ።<verse eid="LAM 3:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="LAM 3:44"/>አከ ከዸትናን ቶኮዩ ገረኬ ህንዹፍኔፍ</para>
  <para style="q2" vid="LAM 3:44">አት ዱሜሳን ኦፍ ሀጉግዴ።<verse eid="LAM 3:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="LAM 3:45"/>አት ሰቦተ ግዱት</para>
  <para style="q2" vid="LAM 3:45">ጡሪፊ ኮሲ ኑ ጎቴ።<verse eid="LAM 3:45"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="46" style="v" sid="LAM 3:46"/>“ዲኖትንኬኘ ሁንድኑ፣</para>
  <para style="q2" vid="LAM 3:46">አፋን ኑት በነተኒሩ።<verse eid="LAM 3:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="LAM 3:47"/>ሶዳፊ ክዮን፣</para>
  <para style="q2" vid="LAM 3:47">ዲገሙፊ በዲስን ኑት ዹፌረ።”<verse eid="LAM 3:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="LAM 3:48"/>ሰበቢ ኡመትንኮ በርበዳኤፍ</para>
  <para style="q2" vid="LAM 3:48">ሎላን እምማኒ እጀኮ ኬሳ ያአ።<verse eid="LAM 3:48"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="49" style="v" sid="LAM 3:49"/>እጅኮ ቦቆና መሌ</para>
  <para style="q2" vid="LAM 3:49">ኡቱ ገርገር ህንኩትን እምማን ሎላሰ፤<verse eid="LAM 3:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="LAM 3:50"/>ኩንስ ሀመ <char style="nd">ዋቀዮ</char> ኦል ሰሚዻ</para>
  <para style="q2" vid="LAM 3:50">ገድ እላሌ አርጉት።<verse eid="LAM 3:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="LAM 3:51"/>ሰበቢ ዱበርቶተ መጋላኮ ሁንዳቲፍ</para>
  <para style="q2" vid="LAM 3:51">ወን አን አርጉ ሉቡኮ ገድሲሰ።<verse eid="LAM 3:51"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="52" style="v" sid="LAM 3:52"/>ወር ሰበቢ መሌ ዲነ ነት ተአን</para>
  <para style="q2" vid="LAM 3:52">አኩመ ስምብራ ነ አደምሰን።<verse eid="LAM 3:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="LAM 3:53"/>እሳን ሉቡኮ ቦለ ኬሰት ገላፈተኒ</para>
  <para style="q2" vid="LAM 3:53">ዸጋ ነት ገረገልቹ ያለን፤<verse eid="LAM 3:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="LAM 3:54"/>ብሻን መታኮረ ገረገሌ፤</para>
  <para style="q2" vid="LAM 3:54">አንስ፣ “በዱኮት” ነንጄዼ።<verse eid="LAM 3:54"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="55" style="v" sid="LAM 3:55"/>ያ <char style="nd">ዋቀዮ</char>፣ አን ቦለ ቅሌ ኬሳ</para>
  <para style="q2" vid="LAM 3:55">መቃኬ ነንዋመዸ።<verse eid="LAM 3:55"/></para>
  <para style="q1">
    <verse number="56" style="v" sid="LAM 3:56"/>አት ከዸትናኮ ከን፣ <optbreak/> “እየ አን ገርጋርሰ በርባቻፍ እዩ</para>
  <para style="q2" vid="LAM 3:56">ዸገኡ ህንድድን” ጄዹ ዸጌሴርተ።<verse eid="LAM 3:56"/></para>
  <para style="q1">
    <verse number="57" style="v" sid="LAM 3:57"/>ዬሮ አን ስ ዋመዼት አት ነት ዽኣቴ</para>
  <para style="q2" vid="LAM 3:57">“ህንሶዳትን” ናን ጄቴ።<verse eid="LAM 3:57"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="58" style="v" sid="LAM 3:58"/>ያ ጎፍታ አት ዱቢኮ ና ፈልምቴ፤</para>
  <para style="q2" vid="LAM 3:58">ሉቡኮስ ንበራርቴ።<verse eid="LAM 3:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="LAM 3:59"/>ያ <char style="nd">ዋቀዮ</char> አት ደበ ነት ሆጄተሜ አርግቴርተ፤</para>
  <para style="q2" vid="LAM 3:59">ዱቢኮ ና እላል!<verse eid="LAM 3:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="LAM 3:60"/>አት ሃሎ በኡ እሳኒቲፊ</para>
  <para style="q2" vid="LAM 3:60">ነት መለቹሳኒ ሁንደስ አርግቴርተ።<verse eid="LAM 3:60"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="61" style="v" sid="LAM 3:61"/>ያ <char style="nd">ዋቀዮ</char> አት አረበሳኒቲፊ</para>
  <para style="q2" vid="LAM 3:61">ነት መለቹሳኒ ሁንደ ዸጌሴርተ፤<verse eid="LAM 3:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="LAM 3:62"/>ኩንስ አረበ ወረ ነት ከአኒቲፊ</para>
  <para style="q2" vid="LAM 3:62">ዋን እሳን ጉያ ጉቱ ዋኤኮ ሀሳሰኒዸ።<verse eid="LAM 3:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="LAM 3:63"/>አት እሳን እላል! እሳን ታአኒ ዮካን ዸዻበተኒ</para>
  <para style="q2" vid="LAM 3:63">ዌዱሳኒቲን ነት ቆሱ።<verse eid="LAM 3:63"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="64" style="v" sid="LAM 3:64"/>ያ <char style="nd">ዋቀዮ</char> ዋን እሳኒፍ መሉ</para>
  <para style="q2" vid="LAM 3:64">አኩመ ሆጂ ሀርከሳኒት ዴብሲ ኬኒፍ።<verse eid="LAM 3:64"/></para>
  <para style="q1">
    <verse number="65" style="v" sid="LAM 3:65"/>ኦኔሳኒ ሀጉግ፤</para>
  <para style="q2" vid="LAM 3:65">አባርስኬስ እሳንረ ሃቡኡ!<verse eid="LAM 3:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="LAM 3:66"/>ሰሚወን <char style="nd">ዋቀዮ</char> ጀላ</para>
  <para style="q2" vid="LAM 3:66">ዼከምሳን እሳን አርእ፤ እሳን በሌስስ።<verse eid="LAM 3:66"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="LAM 3"/>
  <chapter number="4" style="c" sid="LAM 4"/>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 4:1"/>ወርቄን አከምት ቦረጃኤ?</para>
  <para style="q2" vid="LAM 4:1">ወርቄን ቁልቁሉንስ አከምት ጌደረሜ!</para>
  <para style="q1" vid="LAM 4:1">ዸጋወን እዶ ቁልቁሉ</para>
  <para style="q2" vid="LAM 4:1">ፊጤ ዳንዲወን ሁንዳረት ብብትናአኒሩ።<verse eid="LAM 4:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 4:2"/>እልማን ጥዮን ከኔን አከ</para>
  <para style="q2" vid="LAM 4:2">ወርቄ ቁልቁሉት እላለማ ቱረን ሱን</para>
  <para style="q1" vid="LAM 4:2">አመ አከምት አከ ኦኮቴ ሱጴት፣</para>
  <para style="q2" vid="LAM 4:2">አከ ሆጂ ሱጴ ዾፍቱት እላለሙ!<verse eid="LAM 4:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 4:3"/>ዋንጎንዩ እልማንሳኒ ሆስሱፍ</para>
  <para style="q2" vid="LAM 4:3">ሀርመሳኒ ንኬኑ፤</para>
  <para style="q1" vid="LAM 4:3">ሰብንኮ ገሩ አኩመ ጉቺ ገሞጂ</para>
  <para style="q2" vid="LAM 4:3">ገረ ጀቤሰ ተኤረ።<verse eid="LAM 4:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 4:4"/>ሰበቢ ዼቡቲፍ አረብን ዳእመኒ</para>
  <para style="q2" vid="LAM 4:4">ላጋት መጠነ፤</para>
  <para style="q1" vid="LAM 4:4">እጆሌን ቡዴነ ከዸት፦</para>
  <para style="q2" vid="LAM 4:4">ገሩ ነምንሳኒፍ ኬኑ ቶኮዩ ህንጅሩ።<verse eid="LAM 4:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 4:5"/>ወር ዱር ጭዸ ኛቻ ቱረን፣</para>
  <para style="q2" vid="LAM 4:5">ረከተኒ ዳንዲረ ጅሩ።</para>
  <para style="q1" vid="LAM 4:5">ወር ዱር ኡፈተ ዲማ ዺልጌ ኡፈቻ ቱረን</para>
  <para style="q2" vid="LAM 4:5">ሀርአ ቱላ ድኬ ሀመቱ።<verse eid="LAM 4:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 4:6"/>አደቢን የከ ሰበኮ</para>
  <para style="q2" vid="LAM 4:6">አደቢ የከ ሶዶም</para>
  <para style="q1" vid="LAM 4:6">ከን ኡቱ ሀርክ ነመ እሼ ገርጋሩፍ ህንቱቅን</para>
  <para style="q2" vid="LAM 4:6">ተሰ በዴ ሰና ጫላ ጉዳ ቱሬ።<verse eid="LAM 4:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 4:7"/>እልማን ሞቶተሳኒ ጨቢ ጫላ ቁልቁሉ፣</para>
  <para style="q2" vid="LAM 4:7">ኣነን ጫላ አዳዲ ቱረን፤</para>
  <para style="q1" vid="LAM 4:7">ዸግንሳኒ ሉለ ዲማ ጫላ ዲማ፣</para>
  <para style="q2" vid="LAM 4:7">ብፍትሳኒሞ ሰንፔር ፈካተ ቱሬ።<verse eid="LAM 4:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 4:8"/>አመ ገሩ ቀቃ ጫላ ጉራቸአኒሩ፤</para>
  <para style="q2" vid="LAM 4:8">ዳንዲረትስ ነምን እሳን ሁበቱ ህንጅሩ።</para>
  <para style="q1" vid="LAM 4:8">ጎጋንሳኒ ለፌሳኒት መጠኔረ፤</para>
  <para style="q2" vid="LAM 4:8">አከ ሙካስ ጎጌረ።<verse eid="LAM 4:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 4:9"/>ወረ ቤላን ዹመኒ መና፣</para>
  <para style="q2" vid="LAM 4:9">ወረ ጎራዴዻን አጄፈመን ወየ፤</para>
  <para style="q1" vid="LAM 4:9">እሳን ዋን ኛተሙ ለፈ ቆቲሳራ ዸበኒ</para>
  <para style="q2" vid="LAM 4:9">ቤላን አለት ጎጎገኒ ዹሙ።<verse eid="LAM 4:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 4:10"/>ዬሮ ሰብንኮ ዹሜት</para>
  <para style="q2" vid="LAM 4:10">ዱበርቶትን ገረ ላፎን ሀርኩመሳኒቲን</para>
  <para style="q1" vid="LAM 4:10">አከ ኛተሳኒ ተአኒፍ</para>
  <para style="q2" vid="LAM 4:10">እጆሌ ኦፊ አፌለን።<verse eid="LAM 4:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 4:11"/>
    <char style="nd">ዋቀዮ</char> ዼከምሰሳ ጉቱ ገድ ዺሴ፤</para>
  <para style="q2" vid="LAM 4:11">ኣሪሳ ሶዳችሳ ሰነስ ንዸንገላሴ።</para>
  <para style="q1" vid="LAM 4:11">ጥዮን ኬሰትስ</para>
  <para style="q2" vid="LAM 4:11">እብደ ሁንዴወንሼ በርበዴሱ ቀብሲሴ።<verse eid="LAM 4:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 4:12"/>አከ ዲኖትን ዮካን አመጃጆን</para>
  <para style="q2" vid="LAM 4:12">ከረወን ዬሩሳሌም ሴኑ ደንደአን፣</para>
  <para style="q1" vid="LAM 4:12">ሞቶትን ብየ ለፋ</para>
  <para style="q2" vid="LAM 4:12">ዮካን ሰብን አዱኛ ቶኮዩ ህንአመኔ።<verse eid="LAM 4:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 4:13"/>ገሩ ወን ኩን ሰበቢ ጩቡ ራጆተሼቲፊ</para>
  <para style="q2" vid="LAM 4:13">በሌሳ ሉቦተሼ</para>
  <para style="q1" vid="LAM 4:13">ከኔን እሼ ኬሰት ዺገ ቀጄሎታ</para>
  <para style="q2" vid="LAM 4:13">ዸንገላሰን ሰናቲፍ ተኤ።<verse eid="LAM 4:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 4:14"/>እሳን አኩመ ጃሞታ</para>
  <para style="q2" vid="LAM 4:14">ዳንዲረ ገተንተሩ።</para>
  <para style="q1" vid="LAM 4:14">ሀመ ነምን ቶኮዩ ወያሳኒ ቱቁ ህንደንዴኜት</para>
  <para style="q2" vid="LAM 4:14">አከ መሌ ዺጋን ጡራአኒሩ።<verse eid="LAM 4:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 4:15"/>ነሞትንስ፣ “እስን ጡራኦዸ! አሲ በዳ!</para>
  <para style="q2" vid="LAM 4:15">በዳ! በዳ! ኑ ህንቱቅና!” ጄዸኒ እሳንት እዩ።</para>
  <para style="q1" vid="LAM 4:15">ዮሙ በቀተኒ አሲፊ አች ጆረንትስ</para>
  <para style="q2" vid="LAM 4:15">ሰቦትን ነሞተ ኦርማ ግዱ ጅረን፣</para>
  <para style="q2" vid="LAM 4:15">“እሳን ስአች አስ ጅራቹ ህንደንደአን” ጄዹ።<verse eid="LAM 4:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 4:16"/>
    <char style="nd">ዋቀዮ</char> መታሳቱ እሳን ብትኔሴ፤</para>
  <para style="q2" vid="LAM 4:16">እን ስአች እሳን ህንኤጉ።</para>
  <para style="q1" vid="LAM 4:16">ሉቦትን ህንከበጀምኔ፤</para>
  <para style="q2" vid="LAM 4:16">ማንጉዶትን ሱራ ህንአርገትኔ።<verse eid="LAM 4:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 4:17"/>አከሱማን ገርጋርሰ ኤገቹዻን</para>
  <para style="q2" vid="LAM 4:17">እጅኬኘ ደዸቤ፤</para>
  <para style="q1" vid="LAM 4:17">ገሞኬኘረ ቴኜ</para>
  <para style="q2" vid="LAM 4:17">ሰበ ኑ ባሱ ህንደንዴኜራ ገርጋርሰ ኤገትኔ።<verse eid="LAM 4:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 4:18"/>አከ ኑ ዳንዲኬኘረ ዴሙ ህንደንዴኜፍ</para>
  <para style="q2" vid="LAM 4:18">ነሞትን ተርካፊኬኘ ኤጉ።</para>
  <para style="q1" vid="LAM 4:18">ዹምንኬኘ ዽኣቴረ፤ <optbreak/> ጉዮትንኬኘስ ገባበተኒሩ፤</para>
  <para style="q2" vid="LAM 4:18">በዲስንኬኘ ዹፌራቲ።<verse eid="LAM 4:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 4:19"/>ወር ኑ አርአን</para>
  <para style="q2" vid="LAM 4:19">ርሳ ሰሚ ጫላ ሰፍሱ፤</para>
  <para style="q1" vid="LAM 4:19">እሳን ቱሉወንራ ኑ አርአኒ</para>
  <para style="q2" vid="LAM 4:19">ገሞጂ ኬሰት ርጰኒ ኑ ኤገቱ።<verse eid="LAM 4:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 4:20"/>ሀፉር ሉቡኬኛ ከን <char style="nd">ዋቀዮ</char> ድቤ፣</para>
  <para style="q2" vid="LAM 4:20">ክዮሳኒቲን ቀበሜ።</para>
  <para style="q1" vid="LAM 4:20">ኑ ዋን ጋድዱሳ ጀለ፣</para>
  <para style="q2" vid="LAM 4:20">ነሞተ ኦርማ ግዱ ጅራትኑ ሴኔ ቱሬ።<verse eid="LAM 4:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 4:21"/>ያ እንተለ ኤዶም ከን ብየ ኡዝ ኬሰ ጅራቱ</para>
  <para style="q2" vid="LAM 4:21">አት እልልች፣ ገመድስ።</para>
  <para style="q1" vid="LAM 4:21">ገሩ ጦፎን ሱን ሲፍስ ንኬነመ፤</para>
  <para style="q2" vid="LAM 4:21">አትስ መቾፍቴ ቁላኬ ሀፍተ።<verse eid="LAM 4:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 4:22"/>እንተለ ጥዮን አደበሙንኬ ንዹመ፤</para>
  <para style="q2" vid="LAM 4:22">እን በረ ቦጅአሙኬቲ ህንዼሬሱ።</para>
  <para style="q1" vid="LAM 4:22">ገሩ ያ እንተለ ኤዶም፣ እን ጩቡኬ ንአደቤ፤</para>
  <para style="q2" vid="LAM 4:22">ሀምነኬስ እፈት ባሰ።<verse eid="LAM 4:22"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="LAM 4"/>
  <chapter number="5" style="c" sid="LAM 5"/>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 5:1"/>ያ <char style="nd">ዋቀዮ</char> ዋን ኑረ ገኤ ያደዹ፤</para>
  <para style="q2" vid="LAM 5:1">እላል፤ ሰልጵነኬኘስ አርግ።<verse eid="LAM 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 5:2"/>ሀንዹራንኬኘ አለጎታፍ፣</para>
  <para style="q2" vid="LAM 5:2">መኔንኬኘስ ነሞተ ኦርማቲፍ ደበርፈመኒ ኬነመኒሩ።<verse eid="LAM 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 5:3"/>ኑ እጆሌ አባ ህንቀብኔ ታኔ፤</para>
  <para style="q2" vid="LAM 5:3">ሃዾትንኬኘሞ ሃዾተ ህዬሳ ተአኒሩ።<verse eid="LAM 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 5:4"/>ኑ ብሻን ዹግኑፍ ከፈሉ ቀብነ ቱሬ፤</para>
  <para style="q2" vid="LAM 5:4">ቆራንስ ብታ ቆፋን አርገትነ።<verse eid="LAM 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 5:5"/>ወር ኑ አርአን ኮሜኬኘ ብረ ጅሩ፤</para>
  <para style="q2" vid="LAM 5:5">ኑ ደዸብኔረ፤ ቦቆናስ ህንቀብኑ።<verse eid="LAM 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 5:6"/>ኑ ቡዴነ ገኣ አርገቹፍ ጄኔ</para>
  <para style="q2" vid="LAM 5:6">ወረ ግብጢፊ ወረ አሶሪት ሀርከ ኬንኔ፤<verse eid="LAM 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 5:7"/>አቦቲንኬኘ ጩቡ ሆጄተኒ ደርበን፤</para>
  <para style="q2" vid="LAM 5:7">ኑሞ አደቢሳኒ ባትኔ።<verse eid="LAM 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 5:8"/>ገርቦተቱ ኑ ቡልቸ፤</para>
  <para style="q2" vid="LAM 5:8">ነምን ሀርከሳኒቲ ብልሰ ኑ ባሱ ቶኮዩ ህንጅሩ።<verse eid="LAM 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 5:9"/>ሰበቢ ጎራዴ ገሞጂ ጅሩቲን</para>
  <para style="q2" vid="LAM 5:9">ሉቡኬኘ በላፍ ሳጥሌ ቡዴነ አርገትነ።<verse eid="LAM 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 5:10"/>ጎጋንኬኘ ሰበቢ ቤላቲን</para>
  <para style="q2" vid="LAM 5:10">አኩመ በዳ እብዳ ሆአ።<verse eid="LAM 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 5:11"/>ጥዮን ኬሰት ዱበርቶትን፣</para>
  <para style="q2" vid="LAM 5:11">መጋላወን ይሁዳ ኬሰትስ ዱበረን ቁልቁሉን <optbreak/> ሁምናን ጉዴደመን።<verse eid="LAM 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 5:12"/>እልማን ሞቶታ ሀርከሳኒቲን ፈንፈመኒሩ፤</para>
  <para style="q2" vid="LAM 5:12">ማንጉዶትን ኡልፍነ ህንአርገትኔ።<verse eid="LAM 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 5:13"/>ገኤሶን አከ ምዻን ዳከን ድርቅሲፈመን፤</para>
  <para style="q2" vid="LAM 5:13">እጆሌን ዺራ ሙከ ባቹን ገተንተረን።<verse eid="LAM 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 5:14"/>ማንጉዶትን ከረ መጋላ ዱራ ዴመኒሩ፤</para>
  <para style="q2" vid="LAM 5:14">ደርገጎንስ ዌዱሳኒ ዺሰኒሩ።<verse eid="LAM 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 5:15"/>ገመቹን ገራኬኘ ኬሳ በዴረ፤</para>
  <para style="q2" vid="LAM 5:15">ሹብሱንኬኘስ ቦእቸት ጌደረሜረ።<verse eid="LAM 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 5:16"/>ጎንፎን መታኬኘራ ቡኤረ።</para>
  <para style="q2" vid="LAM 5:16">ኑፍ ወዮ፤ ኑ ጩቡ ሆጄትኔራቲ!<verse eid="LAM 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 5:17"/>ሰበቢ ዋን ከናቲፍ ኦኔንኬኘ ንገገቤ፤</para>
  <para style="q2" vid="LAM 5:17">ሰበቢ ዋን ከናቲፍሞ እጅ ቴኘ ደዸብዴ፤<verse eid="LAM 5:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 5:18"/>ቱሉን ጥዮን ከን ኦኔ ሀፌ ሱን</para>
  <para style="q2" vid="LAM 5:18">ለፈ ዋንጎትን እረ ቡራቀን ተኤራቲ።<verse eid="LAM 5:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 5:19"/>ያ <char style="nd">ዋቀዮ</char> አት በረ በራን ቡልች፤</para>
  <para style="q2" vid="LAM 5:19">ቴሶንኬስ ዸሎታ ገረ ዸሎታት እት ፉፈ።<verse eid="LAM 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 5:20"/>አት ማሊፍ ጉቱማን ጉቱት ኑ እራንፈተ?</para>
  <para style="q2" vid="LAM 5:20">ማሊፍ በረ ዼራስ ኑ ዺፍተ?<verse eid="LAM 5:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 5:21"/>ያ <char style="nd">ዋቀዮ</char> አከ ኑ ዴብኑፍ ኦፍት ኑ ዴብስ፤</para>
  <para style="q2" vid="LAM 5:21">በረኬኘሌ አኩመ ዱሪት ሃሮምስ።<verse eid="LAM 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 5:22"/>አት ዮ ጉቱማን ጉቱት ኑ ገቱ ባቴ፣</para>
  <para style="q2" vid="LAM 5:22">ዮ አከ መሌስ ኑት ዼከሙ ባቴ ዋን ከነ ጎዽ።<verse eid="LAM 5:22"/></para>
  <chapter eid="LAM 5"/>
</usx>
