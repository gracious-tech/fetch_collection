<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JER" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">ኤርምያስ</para>
  <para style="toc1">ራጂ ኤርምያስ</para>
  <para style="toc2">ኤርምያስ</para>
  <para style="toc3">ኤር</para>
  <para style="mt2">ራጂ</para>
  <para style="mt1">ኤርምያስ</para>
  <chapter number="1" style="c" sid="JER 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JER 1:1"/>ኩን ዱቢ ኤርምያስ እልመ ህልቅያ ከን ሉቦተ ብየ ቤንያም ኬሰ መጋላ አናቶት ጅራተን ኬሳ ቶኮ ተኤ ሰናት። <verse eid="JER 1:1"/><verse number="2" style="v" sid="JER 1:2"/>ዱቢን <char style="nd">ዋቀዮ</char> በረ ዮስያስ እልመ ኣሞን ሞትቸ ይሁዳ ኬሰ ወጋ ኩዸ ሰደፋት ገረ ኤርምያስ ዹፌ፤ <verse eid="JER 1:2"/><verse number="3" style="v" sid="JER 1:3"/>አከሱመስ በረ ዬሆያቂም እልመ ዮስያስ ሞትቸ ይሁዳቲ ጀልቀቤ ሀመ ዹመ በረ ዜዴቅያ እልመ ዮስያስ ሞትቸ ይሁዳ ወጋ ኩዸ ቶኮፋት ወጋ ሰነ ኬሳስ ሀመ ጅአ ሸነፋት፣ ዬሮ ሰብን ዬሩሳሌም ቦጅአሜት ዱቢን ኩን ገረሳ ዹፋ ቱሬ።<verse eid="JER 1:3"/></para>
  <para style="b"/>
  <para style="s1">ዋመሙ ኤርምያስ</para>
  <para style="p">
    <verse number="4" style="v" sid="JER 1:4"/>ዱቢን <char style="nd">ዋቀዮ</char> አከነ ጄዼ ገረኮ ዹፌ፦<verse eid="JER 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 1:5"/>“አን ኡቱ ገደሜሰ ኬሰት ስ ህንኡምን ዱረ ስ ቤኬ፤</para>
  <para style="q2" vid="JER 1:5">ኡቱ አት ህንዸለትን ዱረ አዳን ስባፈዼ፤</para>
  <para style="q2" vid="JER 1:5">አከ አት ሰቦታፍ ራጂ ታቱፍስ ስሙዴ።”<verse eid="JER 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 1:6"/>አንስ፣ “ወዮ፣ ያ <char style="nd">ዋቀዮ</char> ጎፍታ አን አከምት አከን ዱበዹ ህንቤኩ፤ አን ሙጫ ጥኖዸ” ነንጄዼ።<verse eid="JER 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 1:7"/>
    <char style="nd">ዋቀዮ</char> ገሩ አከነ ናን ጄዼ፤ “አት፣ ‘አን ሙጫ ጥኖዸ’ ህንጄዽን። አት ገረ ነመ አን እት ስኤርጉ ሁንዳ ዸቅጤ ዋን አን ስ አጀጁ ሁንደ ዱበቹ ቀብደ። <verse eid="JER 1:7"/><verse number="8" style="v" sid="JER 1:8"/>አት ጀረ ህንሶዳትን፤ አን ስ ባሱፍ ስ ወጅነን ጅራቲ” ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 1:9"/>ኤርገሲስ <char style="nd">ዋቀዮ</char> ሀርከሳ ሂጠቴ አፋንኮ ቱቄ አከነ ናን ጄዼ፤ “ኩኖ፣ አን ዱቢኮ አፋንኬ ኬሰ ካኤረ። <verse eid="JER 1:9"/><verse number="10" style="v" sid="JER 1:10"/>እላ፣ አን አከ አት ቡቅፍቱፊ ዲግዱፍ፣ አከ በርበዴስቱፊ ገረገልችቱፍ፣ አከ እጃርቱፊ ዻብዱፍ ሀርአ ሰቦታፊ ሞቱሞተረት ስ ሙዴረ።”<verse eid="JER 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 1:11"/>ዱቢን <char style="nd">ዋቀዮ</char> ገረኮ ዹፌ፣ “ኤርምያስ፣ አት ማል አርጋ ጅርተ?” ናን ጄዼ።</para>
  <para style="p" vid="JER 1:11">አንስ ዴብሴ፣ “ደሜ ሙከ ለዉዚ አርጉትን ጅረ” ጄዼ።<verse eid="JER 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 1:12"/>
    <char style="nd">ዋቀዮሞ</char>፣ “አት ስሪት አርግቴ፤ አን አከ ዱቢንኮ ፊጣን በኡፍ ኩተዼ ከኤራቲ” ናን ጄዼ።<verse eid="JER 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 1:13"/>ዱቢን <char style="nd">ዋቀዮ</char> አመሌ ገረኮ ዹፌ፣ “አት ማል አርጋ ጅርተ?” ናን ጄዼ።</para>
  <para style="p" vid="JER 1:13">አንስ ዴብሴ፣ “ጡዌ ደንፋ ጅሩ ከን ካበራ አስ ገረገሌ ጅሩ ቶኮ ነንአርገ” ጄዼ።<verse eid="JER 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 1:14"/>
    <char style="nd">ዋቀዮ</char> አከነ ናን ጄዼ፤ “ገረ ካባቲ በላን ወረ ብየቲ ኬሰ ጅራተን ሁንደት ንቡአ። <verse eid="JER 1:14"/><verse number="15" style="v" sid="JER 1:15"/>ኩኖ ሰቦተ ሞቱሞተ ካባ ሁንደ ወልት ነንዋመ” ጄዸ <char style="nd">ዋቀዮ</char>።</para>
  <para style="q1" vid="JER 1:15">“ሞቶትንሳኒ ዹፈኒ ከረወን ዬሩሳሌም ዱረ</para>
  <para style="q2" vid="JER 1:15">ቴሶወንሳኒ ንዻበቱ፤</para>
  <para style="q1" vid="JER 1:15">እሳን ደላወን ናኖሼ</para>
  <para style="q2" vid="JER 1:15">ሁንዳፊ መጋላወን ይሁዳ ሁንደ መርሱ።<verse eid="JER 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 1:16"/>ሰበቢ እሳን ነ ዺሰኒ</para>
  <para style="q2" vid="JER 1:16">ዋቆተ ብራፍ እጣነ ኣርሱዻን</para>
  <para style="q1" vid="JER 1:16">ዋን ሀርክሳኒ ሆጄቴ ዋቄፈቹዻን ሀምነ ሆጄተኒፍ</para>
  <para style="q2" vid="JER 1:16">አን ሰበኮት ሙርቲ ነንለብሰ።<verse eid="JER 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 1:17"/>“አት ገሩ ሙዺኬ ህዸዹ ከኢቲ ዋን አን ስ አጀጁ ሁንደ እሳንት ህም። አት ጀረ ህንሶዳትን፤ አት እሳን ሶዳናን አን ፉለሳኒ ዱረት ሶዳ ስትን ቡሳ። <verse eid="JER 1:17"/><verse number="18" style="v" sid="JER 1:18"/>አከ አት ጉቱ ብየቲቲን ጄቹንስ ሞቶተ ይሁዳቲን፣ ቆንዳልቶተሼቲን፣ ሉቦታፊ ኡመተ ብየቲቲን ሞርምቱፍ አን ሀርአ መጋላ ደላ ጀባን መርፈምቴ፣ ኡቱባ ስቢላቲፊ ደላ ናሲ ስታስሴረ። <verse eid="JER 1:18"/><verse number="19" style="v" sid="JER 1:19"/>እሳን ስ ሎሉ፤ ገሩ ስ ህንሞአተን፤ አን ስ ባሱፍ ስ ወጅን ጅራቲ” ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 1:19"/></para>
  <chapter eid="JER 1"/>
  <chapter number="2" style="c" sid="JER 2"/>
  <para style="s1">እስራኤል ዋቀ ገንቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 2:1"/>ዱቢን <char style="nd">ዋቀዮ</char> አከነ ጄዼ ገረኮ ዹፌ፤ <verse eid="JER 2:1"/><verse number="2" style="v" sid="JER 2:2"/>“ዸቂቲ ጉረ ዬሩሳሌምት አከነ ጄዺ ለብስ፦</para>
  <para style="b" vid="JER 2:2"/>
  <para style="p" vid="JER 2:2">“ዋቀዮ አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 2:2">“ ‘አን አመነሙማኬ ከን ዬሮ ደርገጉማ፣</para>
  <para style="q2" vid="JER 2:2">አከ አት አኩመ ምስርቲት ነ ጃለቴ</para>
  <para style="q1" vid="JER 2:2">ለፈ ገሞጂ ኬሰ፣</para>
  <para style="q2" vid="JER 2:2">ለፈ ምዻን እት ህንፈጫፈምን ኬሰ ነ ዱካ ቡቴ <optbreak/> ነንያደዸ።<verse eid="JER 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 2:3"/>እስራኤል ከን <char style="nd">ዋቀዮፍ</char> ቁልቁሎፍቴ ሱን፣</para>
  <para style="q2" vid="JER 2:3">መታ ምዻንሳ ቱርቴ፤</para>
  <para style="q1" vid="JER 2:3">ወር እሼ ኛተን ሁንድስ</para>
  <para style="q2" vid="JER 2:3">አከ ነመ የከ ሆጄቴት እላለሙ ቱሬ፤</para>
  <para style="q2" vid="JER 2:3">በዲስንስ እሳንት ዹፌ’ ” ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 2:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="JER 2:4"/>ያ መነ ያቆብ፣</para>
  <para style="q2" vid="JER 2:4">እስን ማቲወን መነ እስራኤል ሁንድኑስ <optbreak/> ዱቢ <char style="nd">ዋቀዮ</char> ዸገኣ።<verse eid="JER 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 2:5"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 2:5">“አቦቲንኬሰን ከን አከስ ነራ ፈጋተን</para>
  <para style="q2" vid="JER 2:5">በሌሳ ማሊ ነረት አርገኒቲ?</para>
  <para style="q1" vid="JER 2:5">እሳን ዋቆተ ቶልፈሞ ፋይዳ ህንቀብኔ ፋነ ቡአኒ</para>
  <para style="q2" vid="JER 2:5">እሳኑምቱ ወረ ፋይዳ ህንቀብኔ ተአን።<verse eid="JER 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 2:6"/>እሳንስ፣ ‘<char style="nd">ዋቀዮ</char> እን ግብጢ ኑ ባሴ፣</para>
  <para style="q2" vid="JER 2:6">ገሞጂ ሆምቱ ኬሰ ህንጅሬ ኬሳን፣</para>
  <para style="q1" vid="JER 2:6">ለፈ ገሞጂፊ ዾቃ ኬሳን</para>
  <para style="q2" vid="JER 2:6">ለፈ ሆንጌፊ ዱከና፣</para>
  <para style="q1" vid="JER 2:6">ብየ ነምን ቶኮዩ ኬሰ ህንደበሬፊ</para>
  <para style="q2" vid="JER 2:6">ኬሰ ህንጅራትኔ ኬሳን ደበርሴ</para>
  <para style="q2" vid="JER 2:6">ኑ ፍዴ ሱን ኤሰ ጅረ?’ ጄዸኒ ህንጋፈትኔ።<verse eid="JER 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 2:7"/>አን አከ እስን እጀሼ ኛተኒ ምዻንሼት ገመደኒፍ</para>
  <para style="q2" vid="JER 2:7">ገረ ለፈ ገበታት እስን ፍዴረ።</para>
  <para style="q1" vid="JER 2:7">እስን ገሩ ዹፍተኒ ብየኮ ጡሬስተን፤</para>
  <para style="q2" vid="JER 2:7">ሀንዹራኮስ አከ ጅበሙ ጎተን።<verse eid="JER 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 2:8"/>ሉቦትንስ፣ ‘<char style="nd">ዋቀዮ</char> ኤሰ ጅረ?’</para>
  <para style="q2" vid="JER 2:8">ጄዸኒ ህንጋፈትኔ።</para>
  <para style="q1" vid="JER 2:8">ወር ሴረ ወጅን ኦለንስ ነ ህንቤክኔ፤</para>
  <para style="q2" vid="JER 2:8">ቡልችቶትን ነት ፍንጭለን፤</para>
  <para style="q1" vid="JER 2:8">ራጆትንስ ዋቆተ ፋይዳ ህንቀብኔ ዱካ ቡአኒ</para>
  <para style="q2" vid="JER 2:8">መቃ በኣሊን ራጂ ዱበተን።<verse eid="JER 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="JER 2:9"/>“ከናፉ አን አመዩ እስን ወጅን ፈልሚ ቀበ”</para>
  <para style="q2" vid="JER 2:9">ጄዸ <char style="nd">ዋቀዮ</char>።</para>
  <para style="q2" vid="JER 2:9">“እጆሌ እጆሌኬሰኒ ወጅንስ ፈልሚ ነንቀባዸ።<verse eid="JER 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 2:10"/>ሜ ገረ ቀርቀረ ክቲምት ጬኣቲ እላላ፤</para>
  <para style="q2" vid="JER 2:10">ገረ ቄዳርትስ ነመ ኤርጋቲ ቀልቢዻን ቆረዻ፤</para>
  <para style="q2" vid="JER 2:10">ዮ ዱራን ወን አከሲ ተኤ ጅራቴስ እላላ።<verse eid="JER 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 2:11"/>ዮ እሳን ዋቆተ ተኡ ባተንዩ</para>
  <para style="q2" vid="JER 2:11">ሰብን ቶኮ ተኩማ ዋቆተሳ ጌደሬ ቤካ?</para>
  <para style="q1" vid="JER 2:11">ኡመትንኮ ገሩ</para>
  <para style="q2" vid="JER 2:11">ኡልፍነሳ ዋቆተ ቶልፈሞ <optbreak/> ፋይዳ ህንቀብኔን ጌደሬረ።<verse eid="JER 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 2:12"/>ያ ሰሚወን፣ ዋን ከነ ድንቅፈዻ፤</para>
  <para style="q2" vid="JER 2:12">ናሱ ጉዳዻንስ ሆለዻ”</para>
  <para style="q2" vid="JER 2:12">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 2:13"/>“ኡመትንኮ ጩቡ ለመ ሆጄቴ፦</para>
  <para style="q1" vid="JER 2:13">እሳን አነ ቡርቃ ብሻን ጅሬኛ ዺሰኒ</para>
  <para style="q2" vid="JER 2:13">ቦለ ብሻኒ ኦፊሳኒ፣</para>
  <para style="q1" vid="JER 2:13">ቦለ ብሻኒ በቀቃ</para>
  <para style="q2" vid="JER 2:13">ብሻን ቀበቹ ህንደንዴኜ ቆተተኒሩ።<verse eid="JER 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 2:14"/>እስራኤል ገርባ? እን ገርብቸ መነት ዸለቴ?</para>
  <para style="q2" vid="JER 2:14">ዮስ እን ማሊፍ ቦጅአሜሬ?<verse eid="JER 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 2:15"/>ሌንጮትን ኣደኒሩ፤</para>
  <para style="q2" vid="JER 2:15">እሰትስ ጉሩርአኒሩ።</para>
  <para style="q1" vid="JER 2:15">እሳን ብየሳ ኦንሰኒሩ፤</para>
  <para style="q2" vid="JER 2:15">መጋላወንሳስ ጉበመኒ ዱዋ ሀፈኒሩ።<verse eid="JER 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 2:16"/>አከሱመስ ነሞትን ሜምፊሲፊ</para>
  <para style="q2" vid="JER 2:16">ተህጳንሄስ መታኬ ቡሩቅሰኒሩ።<verse eid="JER 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 2:17"/>አት ዬሮ እን ከራረ ስ ቀጄልቼት፣</para>
  <para style="q2" vid="JER 2:17">
    <char style="nd">ዋቀዮን</char> ዋቀኬ ዺሱዻን</para>
  <para style="q2" vid="JER 2:17">ዋን ከነ ኦፍት ፍዴርተ ምቲ?<verse eid="JER 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 2:18"/>ኤጋ አት ማሊፍ ሽሆሪ ብሻን ዹጉፍ ጄቴ</para>
  <para style="q2" vid="JER 2:18">ብየ ግብጥ ዸቅጠ?</para>
  <para style="q1" vid="JER 2:18">ማሊፍስ ብሻን ለገ ኤፍራጢስ</para>
  <para style="q2" vid="JER 2:18">ዹጉፍ ጄቴ አሶር ዸቅጠ?<verse eid="JER 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 2:19"/>ሀምንኬ ስ አደበ፤</para>
  <para style="q2" vid="JER 2:19">ዱበት ዴብኡንኬስ ስ እፈተ።</para>
  <para style="q1" vid="JER 2:19">አት <char style="nd">ዋቀዮን</char> ዋቀኬ ዺፍቴ</para>
  <para style="q2" vid="JER 2:19">ነ ሶዳቹ ድዱንኬ</para>
  <para style="q1" vid="JER 2:19">ሀመም ሀማፊ ሀዻኣ አከ ስት ተኤ እላሊ ሁበዹ”</para>
  <para style="q2" vid="JER 2:19">ጄዸ ጎፍታን፣ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ።<verse eid="JER 2:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JER 2:20"/>“አን በረ ዼራን ዱረ ዋንጆኬ ስራ ጨብሴረ፤</para>
  <para style="q2" vid="JER 2:20">ህዻኬስ ስራ ኩኩቴረ።</para>
  <para style="q2" vid="JER 2:20">አት ገሩ፣ ‘አን ስ ህንተጃጅሉ’ ጄቴ!</para>
  <para style="q1" vid="JER 2:20">አት ገሩ አኩመ ሰጋገልቱ ቶኮት</para>
  <para style="q2" vid="JER 2:20">ቱሉወን ዼዼሮ ሁንደራፊ</para>
  <para style="q2" vid="JER 2:20">ሙኬን ለልሶ ሁንደ ጀለ ጪፍቴ።<verse eid="JER 2:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 2:21"/>አን ገሩ ሙከ ወይኒ ፍለተማ፣</para>
  <para style="q2" vid="JER 2:21">ከን ሰኚንሳ ጉቱማን ጉቱት ቁልቁሉ ተኤ ጎዼ <optbreak/> ስ ዻበዼን ቱሬ።</para>
  <para style="q1" vid="JER 2:21">ዮስ አት አከምት ወይኒ ዲዳ</para>
  <para style="q2" vid="JER 2:21">ታቴ ነት ጌደረምቴሬ?<verse eid="JER 2:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 2:22"/>አት ዮ ዳራዻን ዽቀቴ</para>
  <para style="q2" vid="JER 2:22">ሳሙና ሄዱት ፈየደምቴዩ፣</para>
  <para style="q2" vid="JER 2:22">ጡሪን የከኬቲ አመሌ ፉለኮ ዱረ ጅረ”</para>
  <para style="q2" vid="JER 2:22">ጄዸ <char style="nd">ዋቀዮ</char> ጎፍታን።<verse eid="JER 2:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 2:23"/>“አት አከምት፣ ‘አን ህንጡሮፍኔ፤</para>
  <para style="q2" vid="JER 2:23">በኣል ዱካስ ህንቡኔ’ ጄቹ ደንዴሰ?</para>
  <para style="q1" vid="JER 2:23">ዋን ሱሉለ ኬሰት ተኣ ቱርቴ ያደዹ፤</para>
  <para style="q2" vid="JER 2:23">ዋን ሆጄቻ ቱርቴስ ቀልቤፈዹ።</para>
  <para style="q1" vid="JER 2:23">አት ጋለ ዸላ አሲፊ</para>
  <para style="q2" vid="JER 2:23">አች ፊግዱዸ፤<verse eid="JER 2:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 2:24"/>ሀሬ ዲዳ ከን ገሞጂ በረቴ</para>
  <para style="q2" vid="JER 2:24">ፌዺ ኮርማቲን ቅሌንሰ ሱፈቱ ቶኮ፣</para>
  <para style="q2" vid="JER 2:24">ማልቱ ፌዺሼራ እሼ ዴብሱ ደንደአ?</para>
  <para style="q1" vid="JER 2:24">ኮርም እሼ በርባዱ ከምዩ እሼ አርገቹፍ ህንረከቱ፤</para>
  <para style="q2" vid="JER 2:24">እን ዬሮ ጋናት እሼ አርገተ።<verse eid="JER 2:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 2:25"/>ሚለኬ ኮጴ መሌ ዴሙራ፣</para>
  <para style="q2" vid="JER 2:25">ላጋኬሞ ዼቡራ ኤገዹ።</para>
  <para style="q1" vid="JER 2:25">አት ገሩ፣ ‘ኩን ዋን አብዲ ህንቀብኔዸ!</para>
  <para style="q2" vid="JER 2:25">አን ዋቆተ ኦርማ ነንጃለዸ፤</para>
  <para style="q2" vid="JER 2:25">እሳን ፋነስ ነንቡአ’ ጄቴ።<verse eid="JER 2:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="JER 2:26"/>“አኩመ ሀቱን ዬሮ ቀበምቱ ሰልጵፈምቱ ሰነ</para>
  <para style="q2" vid="JER 2:26">መን እስራኤል ንሰልጵፈመ፤</para>
  <para style="q1" vid="JER 2:26">እሳን፣ ሞቶትንሳኒቲፊ ቆንዳልቶትንሳኒ፣</para>
  <para style="q2" vid="JER 2:26">ሉቦትንሳኒቲፊ ራጆትንሳኒ ንሰልጵፈሙ።<verse eid="JER 2:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 2:27"/>እሳን ሙካን፣ ‘አት አባኮት፣’</para>
  <para style="q2" vid="JER 2:27">ዸጋዻንሞ፣ ‘ስቱ ነ ዸሌ’ ጄዹ።</para>
  <para style="q1" vid="JER 2:27">እሳን ዱግደሳኒ መሌ</para>
  <para style="q2" vid="JER 2:27">ፉለሳኒ ነት ህንዴብፈትኔቲ፤</para>
  <para style="q1" vid="JER 2:27">ተኡስ እሳን ዬሮ ረከተንት፣</para>
  <para style="q2" vid="JER 2:27">‘ኮቱ ኑ ባስ!’ ጄዹ።<verse eid="JER 2:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 2:28"/>ዋቆትን አት ኦፊፍ ቶልፈቴ ሱን ኤሰ ጅሩ?</para>
  <para style="q2" vid="JER 2:28">እሳን ዮ ስ ባሱ ደንደአን</para>
  <para style="q2" vid="JER 2:28">ሜ ዬሮ አት ረክነ ኬሰ ጅርቱት ሃዹፈን!</para>
  <para style="q1" vid="JER 2:28">ያ ይሁዳ፣ አት አኩመ መጋላ ሄዱ ቀብዱ ሰነ</para>
  <para style="q2" vid="JER 2:28">ዋቆተ ሄዱ ቀብዳቲ።<verse eid="JER 2:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="JER 2:29"/>“እስን ማሊፍ ነ ህመቱ?</para>
  <para style="q2" vid="JER 2:29">እስን ሁንድኑ ነት ፍንጭልተኒርቱ”</para>
  <para style="q2" vid="JER 2:29">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 2:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 2:30"/>“አን አከሱማነን እጆሌኬሰን አደቤ፤</para>
  <para style="q2" vid="JER 2:30">እሳን ስሬፈመ ፉዸቹ ድደን።</para>
  <para style="q1" vid="JER 2:30">ጎራዴንኬሰን አኩመ</para>
  <para style="q2" vid="JER 2:30">ሌንጨ ቤለኤ ቶኮት ራጆተኬሰን ፍጤ።<verse eid="JER 2:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JER 2:31"/>“እስን ዸሎትን አማ ዱቢ <char style="nd">ዋቀዮ</char> ቀልቤፈዻ፦</para>
  <para style="q1" vid="JER 2:31">“እስራኤሊፍ ገሞጂ</para>
  <para style="q2" vid="JER 2:31">ዮካን ብየ ዱከነ ሀማን ቱሬ?</para>
  <para style="q1" vid="JER 2:31">ሰብንኮ ማሊፍ፣ ‘ኑ አሲፊ አች ጆሩ ንደንዴኘ፤</para>
  <para style="q2" vid="JER 2:31">ስአች ገረኬ ህንዹፍኑ’ ጄዸ?<verse eid="JER 2:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JER 2:32"/>ዱርብ ቶኮ ፋየሼ፣</para>
  <para style="q2" vid="JER 2:32">ምስርቲን ቶኮሞ ምአ እቲን ሄሩምቱ ንእራንፈቲ?</para>
  <para style="q1" vid="JER 2:32">ሰብንኮ ገሩ፣</para>
  <para style="q2" vid="JER 2:32">ጉያ ሀመ ህንቀብኔ ነ እራንፈቴረ።<verse eid="JER 2:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="JER 2:33"/>አት ጃለለ አደምሱት አከም ኦጌቲዸ! አን</para>
  <para style="q2" vid="JER 2:33">ዱበርቶተ አከ መሌ ሀሞ ተአንዩ አመለኬ በርሲፍቴርተ።<verse eid="JER 2:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="JER 2:34"/>አት ኡቱ እሳን ጨብሰኒ ሴነኑ እሳን ቀቡ ባቱዩ፣</para>
  <para style="q2" vid="JER 2:34">ዺግን ህዬዪ በሌሳ ህንቀብኔ</para>
  <para style="q2" vid="JER 2:34">ወያኬረት ንአርገመ።</para>
  <para style="q1" vid="JER 2:34">ኡቱመ ወን ኩን ሁንድ ተኤ ጅሩ<verse eid="JER 2:34"/></para>
  <para style="q2">
    <verse number="35" style="v" sid="JER 2:35"/>አት፣ ‘አን በሌሳ ህንቀቡ፤</para>
  <para style="q2" vid="JER 2:35">እን ነት ህንዼከሙ’ ጄተ።</para>
  <para style="q1" vid="JER 2:35">አን ገሩ ሰበቢ አት፣ ‘አን ጩቡ</para>
  <para style="q2" vid="JER 2:35">ህንሆጄትኔ’ ጄቱፍ፣ ስት ነንሙረ።<verse eid="JER 2:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="JER 2:36"/>አት ማሊፍ ከራኬ ጌደሩዻን፣</para>
  <para style="q2" vid="JER 2:36">አሲፊ አች ዴሙ ባይእፍተ?</para>
  <para style="q1" vid="JER 2:36">አኩመ አሶር ስ ቃኔስቴ ሰነ</para>
  <para style="q2" vid="JER 2:36">ግብጥስ ስ ቃኔስት።<verse eid="JER 2:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="JER 2:37"/>አት መታኬ ቀበቴ፣</para>
  <para style="q2" vid="JER 2:37">እዶ ሰና ባተ፤</para>
  <para style="q1" vid="JER 2:37">
    <char style="nd">ዋቀዮ</char> ወረ አት እት እርከቴ ቱፈቴራቲ፤</para>
  <para style="q2" vid="JER 2:37">አት እሳኒን ህንምልኮፍቱ።<verse eid="JER 2:37"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="JER 2"/>
  <chapter number="3" style="c" sid="JER 3"/>
  <para style="q1">
    <verse number="1" style="v" sid="JER 3:1"/>“ነምን ቶኮ ዮ ኒቲሳ ሂኬ</para>
  <para style="q2" vid="JER 3:1">እሼንስ እሰ ዺፍቴ ነመ ብራት ሄሩምቴ፣</para>
  <para style="q1" vid="JER 3:1">እን ለመተ እሼት ዴብኣ?</para>
  <para style="q2" vid="JER 3:1">ብየቲንስ ጉቱማን ጉቱት ህንጡሮፍቱ?</para>
  <para style="q1" vid="JER 3:1">አት ገሩ አከ ሰጋገልቱት <optbreak/> ሰኞወን ሄዱ ወጅን ጅራቴርተ፤</para>
  <para style="q2" vid="JER 3:1">ተኡስ አመ ገረኮት ዴብእ?”</para>
  <para style="q2" vid="JER 3:1">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 3:2"/>“ሜ ኦል ምልአዹቲ ጋረ ዱዋ እላል።</para>
  <para style="q2" vid="JER 3:2">እዶን አት እት ህንሰጋገልን ቶኮዩ ጅራ?</para>
  <para style="q1" vid="JER 3:2">አት አኩመ ጎዳንቱ ገሞጂ ኬሳ ቶኮት</para>
  <para style="q2" vid="JER 3:2">ወረ ስ ጃለተን ኤገቹፍ ቀርቀረ ከራ ቴሴ፤</para>
  <para style="q1" vid="JER 3:2">ሰጋገልቱማፊ ሀምነኬቲን</para>
  <para style="q2" vid="JER 3:2">ብየቲ ጡሬስቴርተ።<verse eid="JER 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 3:3"/>ከናፉ ቲፉን ንእትፈሜ፤</para>
  <para style="q2" vid="JER 3:3">ብራ ኬሰሌ ቦካን ህንሮብኔ።</para>
  <para style="q1" vid="JER 3:3">አት ገሩ ኛረ ሰጋገልቱ ቀብደ፤</para>
  <para style="q2" vid="JER 3:3">ቃነኡስ ንድዴ።<verse eid="JER 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 3:4"/>አት አመዩ አከነ ጄቴ ነ ህንዋምኔ?</para>
  <para style="q2" vid="JER 3:4">‘አባኮ፣ እጆሉማኮቲ ጀልቀብዴ ምቹኮ፣<verse eid="JER 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 3:5"/>አት ዬሮ ሁንደ ንኣርታ?</para>
  <para style="q2" vid="JER 3:5">ዼከምስኬ በሩመ በራን እት ፉፋ?’</para>
  <para style="q1" vid="JER 3:5">አት አከስት ዱበተ፤</para>
  <para style="q2" vid="JER 3:5">ገሩ ዋን ሀማ ደንዴሱ ሁንደ ንሆጄተ።”<verse eid="JER 3:5"/></para>
  <para style="s1">እስራኤል አመነሙማ ዸብዴ</para>
  <para style="p">
    <verse number="6" style="v" sid="JER 3:6"/>
    <char style="nd">ዋቀዮ</char> በረ ዮስያስ ሞትቻ ኬሰ አከነ ናን ጄዼ፤ “አት ዋን እስራኤል እሼን አመነሙማ ህንቀብኔ ሱን ሆጄቴ አርግቴ? እሼን ዸቅጤ ቱሉ ኦል ዼራ ሁንደረቲፊ ሙከ ለልሳ ሁንደ ጀለት ሰጋገልቴ። <verse eid="JER 3:6"/><verse number="7" style="v" sid="JER 3:7"/>አን ዋን እሼን ኤርገ ወንቶተ ከኔን ሁንደ ሆጄቴ ቦዴ ገረኮት ዴብቱ ሴኤን ቱሬ፤ እሼን ገሩ ህንዴብኔ። ኦቦሌቲንሼ ይሁዳን ህንአመነምኔ ሱንስ ዋን ከነ አርግቴ። <verse eid="JER 3:7"/><verse number="8" style="v" sid="JER 3:8"/>አን ሰበቢ ኤጁማሼ ሁንዳቲፍ ወረቃ ረጋ ሂካ ኬኔፊን እስራኤል አመነሙማ ህንቀብኔ ሰነ ኦፍራ አርኤ፤ ተኡሌ አን አከ ኦቦሌቲንሼ ይሁዳን አመነሙማ ህንቀብኔ ሱን ህንሶዳትኔ ነንአርጌ፤ እሼንስ ዸቅጤ ኤጅቴ። <verse eid="JER 3:8"/><verse number="9" style="v" sid="JER 3:9"/>እስራኤል ሰበቢ ሰጋገሉማ ኦፊ አከ ዋን ሰልጳ ቶኮት እላልቴፍ ዸጋፊ ሙከ ወጅን ኤጁዻን ብየ ጡሬስቴ። <verse eid="JER 3:9"/><verse number="10" style="v" sid="JER 3:10"/>እሼን ዋን ከነ ሁንደ ሆጄቱዩ ኦቦሌቲንሼ ይሁዳን ህንአመነምኔ ሱን ፈኬሱፍ መሌ ገራ ጉቱዻን ገረኮት ህንዴብኔ” ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 3:11"/>
    <char style="nd">ዋቀዮ</char> አከነ ናን ጄዼ፤ “ይሁዳ ህንአመነምኔረ እስራኤል አመንቲ ህንቀብኔቱ ቀጄልቱዸ። <verse eid="JER 3:11"/><verse number="12" style="v" sid="JER 3:12"/>ዸቂቲ ኤርጋ ከነ ካበት ለብስ፦</para>
  <para style="q1" vid="JER 3:12">“ ‘ያ እስራኤል አመንቲ ዸቤቲ፣ ዴብእ’ ጄዸ <char style="nd">ዋቀዮ</char>፤</para>
  <para style="q2" vid="JER 3:12">‘አን ስአች እጀ ኣሪቲን ስ ህንእላሉ፤</para>
  <para style="q1" vid="JER 3:12">አን አራረ ቀቤሳቲ’ ጄዸ <char style="nd">ዋቀዮ</char>።</para>
  <para style="q2" vid="JER 3:12">‘አን በረ በራን ህንዼከሙ።<verse eid="JER 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 3:13"/>አት አከ <char style="nd">ዋቀዮ</char> ዋቀኬት ፍንጭልቴ፣</para>
  <para style="q2" vid="JER 3:13">አከ ሙኬን ለልሶ ሁንደ ጀለት</para>
  <para style="q1" vid="JER 3:13">ጃለለኬ ዋቆተ ኦርማቲፍ ኬንቴ ና አጀጀሙ ድዴ፣</para>
  <para style="q2" vid="JER 3:13">በሌሳኬ ሰነ ቆፈ ህመዹ’ ”</para>
  <para style="q2" vid="JER 3:13">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 3:14"/>“ያ ሰበ አመንቲ ህንቀብኔ፣ ዴብኣ” ጄዸ <char style="nd">ዋቀዮ</char>፤ “አን ዽርሰኬሰኒቲ። አን መጋላ ቶኮራ ነመ ቶኮ፣ በልበለ ቶኮራ ነመ ለመ ፍለዼ ጥዮንት እስን ነንፍደ። <verse eid="JER 3:14"/><verse number="15" style="v" sid="JER 3:15"/>ኤርገሲ አን ትክሶተ አከ ገራኮቲ ተአን፣ ከኔን ቤኩምሳፊ ሁበትናዻን እስን ቀጄልቸን እስኒ ነንኬነ። <verse eid="JER 3:15"/><verse number="16" style="v" sid="JER 3:16"/>በረ ሰነ ኬሰ፣ ዬሮ ባይእንኬሰን ብየቲ ኬሰት አከ መሌ ጉደቱት፣” ጄዸ <char style="nd">ዋቀዮ</char>፣ “ነሞትን ስአች፣ ‘ታቦተ ከኩ <char style="nd">ዋቀዮ</char>’ ህንጄዸን።” ወን ኩን ጎንኩማ ሰሙሳኒ ኬሰ ህንሴኑ፣ ዮካን ህንያደተሙ፤ ከን እሰ በርባዱ ህንጅሩ፣ ዮካን ከን ብራ ህንቶልፈሙ። <verse eid="JER 3:16"/><verse number="17" style="v" sid="JER 3:17"/>እሳን ዬሮ ሰነት ዬሩሳሌሚን ቴሶ <char style="nd">ዋቀዮ</char> ጄዸኒ ዋሙ፤ ሰቦትን ሁንድኑስ መቃ <char style="nd">ዋቀዮ</char> ኡልፌሱፍ ዬሩሳሌምት ወልት ንቀበሙ። እሳን ስአች መተ ጀብነ ሀምነ ገራሳኒ ዱካ ህንቡአን። <verse eid="JER 3:17"/><verse number="18" style="v" sid="JER 3:18"/>በረ ሰነ ኬሰ መን ይሁዳ መነ እስራኤልት ንመከመ፤ እሳንስ ቶኩማዻን ብየ ካባቲ ገረ ብየ አን አከ ዻላት አቦቲኬሰኒፍ ኬኔ ሰና ንዹፉ።<verse eid="JER 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 3:19"/>“አን መታንኮ አከነ ነንጄዼ፤</para>
  <para style="q1" vid="JER 3:19">“ ‘አን ስላ ሀመን አኩመ እልማንኮት</para>
  <para style="q2" vid="JER 3:19">ስ ፉዸዼ ብየ ነመት ቶልቱ፣</para>
  <para style="q2" vid="JER 3:19">ዻለ አከ መሌ ሚዸጉ ከን ሰበ ከሚዩ <optbreak/> ሲፍ ነንኬነ ቱሬ።’</para>
  <para style="q1" vid="JER 3:19">አን ዋን አት፣ ‘አባኮ’ ጄቴ ነ ዋምቱፍ፣</para>
  <para style="q2" vid="JER 3:19">ዋን አት ነ ዱካ ቡኡ ህንዺፍኔ ሴኤ ቱሬ።<verse eid="JER 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 3:20"/>ያ መነ እስራኤል፣</para>
  <para style="q2" vid="JER 3:20">አት ገሩ አኩመ ኒቲ ዽርሰሼቲፍ ህንአመነምኔ ቶኮ፣</para>
  <para style="q2" vid="JER 3:20">አናፍ ህንአመነምኔ ቱርቴ”</para>
  <para style="q2" vid="JER 3:20">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 3:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="JER 3:21"/>እሳን ከራሳኒ ጀልእሰኒ</para>
  <para style="q2" vid="JER 3:21">
    <char style="nd">ዋቀዮ</char> ዋቀሳኒ ዋን እራንፈተኒፍ</para>
  <para style="q1" vid="JER 3:21">ጋረ ዱዋረት እይ፣</para>
  <para style="q2" vid="JER 3:21">ቦእቺፊ ዋመናን ሰበ እስራኤል ንዸገአመ።<verse eid="JER 3:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="JER 3:22"/>“ያ ሰበ አመንቲ ህንቀብኔ ዴብኣ፤</para>
  <para style="q2" vid="JER 3:22">አን ዱበት ዴብኡኬሰን ነንፈይሳቲ።”</para>
  <para style="b" vid="JER 3:22"/>
  <para style="q1" vid="JER 3:22">“ኩኖ፣ ኑ ገረኬ ንዹፍነ፤</para>
  <para style="q2" vid="JER 3:22">አት <char style="nd">ዋቀዮ</char> ዋቀኬኛቲ።<verse eid="JER 3:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 3:23"/>ዹጉማን ወጭን ጋረኒፊ</para>
  <para style="q2" vid="JER 3:23">ቱሉወንራ ጎዎምሳዸ፤</para>
  <para style="q1" vid="JER 3:23">ዹጉማን ፈይን እስራኤል</para>
  <para style="q2" vid="JER 3:23">ሀርከ <char style="nd">ዋቀዮ</char> ዋቀኬኛ ጅረ።<verse eid="JER 3:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 3:24"/>እጆሉማኬኛ ጀልቀብኔ ዋቆትን ነመ ቃኔሰን፣</para>
  <para style="q2" vid="JER 3:24">ቡኣ ደዸቢ አቦቲኬኛ</para>
  <para style="q1" vid="JER 3:24">ጄቹንስ ቡሻዬፊ ሎንሳኒ፣</para>
  <para style="q2" vid="JER 3:24">እልማንሳኒቲፊ እንተለንሳኒ ፍጠኒሩ።<verse eid="JER 3:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 3:25"/>ኑ ቃኒኬኛን ሃጪፍኑ፤</para>
  <para style="q2" vid="JER 3:25">ሰልጵንኬኘስ ኑ ሃሀጉጉ።</para>
  <para style="q1" vid="JER 3:25">ኑስ አቦቲንኬኘስ <char style="nd">ዋቀዮ</char> ዋቀኬኘት</para>
  <para style="q2" vid="JER 3:25">ጩቡ ሆጄትኔረ፤</para>
  <para style="q1" vid="JER 3:25">ኑ እጆሉማኬኛ ጀልቀብኔ <optbreak/> ሀመ አማት</para>
  <para style="q2" vid="JER 3:25">
    <char style="nd">ዋቀዮ</char> ዋቀኬኛፍ ህንአጀጀምኔ።”<verse eid="JER 3:25"/></para>
  <para style="b"/>
  <chapter eid="JER 3"/>
  <chapter number="4" style="c" sid="JER 4"/>
  <para style="q1">
    <verse number="1" style="v" sid="JER 4:1"/>“ያ እስራኤል፣ አት ዮ ዴብቴ፣</para>
  <para style="q2" vid="JER 4:1">ገረኮት ዴብእ” ጄዸ <char style="nd">ዋቀዮ</char>።</para>
  <para style="q1" vid="JER 4:1">“ዮ አት ዋቆተኬ ጅብሲሶ ሰነ<optbreak/> ፉለኮ ዱራ በሌስቴ</para>
  <para style="q2" vid="JER 4:1">ስአች ከራራ ጀልአቹ ባቴ፣<verse eid="JER 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 4:2"/>ዮ አት፣ ‘ዹጋ <char style="nd">ዋቀዮ</char> ጅራታ’ ጄቴ</para>
  <para style="q2" vid="JER 4:2">ዹጋዻን፣ ሙርቲ ቀጄላፊ ቀጄሉማዻን ከከቴ፣</para>
  <para style="q1" vid="JER 4:2">ሰቦትን እሳን ንኤብፈሙ፤</para>
  <para style="q2" vid="JER 4:2">እሱማንስ ንከበጀሙ።”<verse eid="JER 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 4:3"/>
    <char style="nd">ዋቀዮ</char> ነሞተ ይሁዳቲፊ ነሞተ ዬሩሳሌሚን አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 4:3">“በጂኬሰን ቆተዻ፤</para>
  <para style="q2" vid="JER 4:3">ቆራቲ ኬሰስ ህንፈጫስና።<verse eid="JER 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 4:4"/>ያ ነሞተ ይሁዳቲፊ ኡመተ ዬሩሳሌም</para>
  <para style="q2" vid="JER 4:4">
    <char style="nd">ዋቀዮፍ</char> ዸግነ ኦፍ ቀባ፤</para>
  <para style="q2" vid="JER 4:4">ቆለ ቀልቢኬሰኒስ ዸግነ ቀበዻ፤</para>
  <para style="q1" vid="JER 4:4">ዮ ከና አቺ ሰበቢ ሀምነ እስን ሆጄተኒቲፍ</para>
  <para style="q2" vid="JER 4:4">ዼከምስኮ ከኤ አከ እብዳ ንቦበአ፤</para>
  <para style="q2" vid="JER 4:4">ነምን እሰ ዻምሱስ ህንጅሩ።<verse eid="JER 4:4"/></para>
  <para style="s1">በላ ካበራ ዹፉ</para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 4:5"/>“ይሁዳ ኬሰት ቤክስሳ፤ <optbreak/> ዬሩሳሌም ኬሰትስ አከነ ጄዻ ለብሳ፦</para>
  <para style="q2" vid="JER 4:5">‘ብየቲ ጉቱ ኬሰት መለከተ አፉፋ!</para>
  <para style="q1" vid="JER 4:5">ሰገሌ ኦል ፉዸዻቲ አከነ ጄዻ፦</para>
  <para style="q2" vid="JER 4:5">ወልት ቀበማ!</para>
  <para style="q2" vid="JER 4:5">ኮታ ገረ መጋላወን ደላ ጀባ ቀበኒት በቀትና!’<verse eid="JER 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 4:6"/>ጥዮን ዸቁፍ ፋጂ ኦል ቀባ?</para>
  <para style="q2" vid="JER 4:6">ደፋ በቀዻ መሌ ዱበት ህንሀርክፈትና!</para>
  <para style="q1" vid="JER 4:6">አን ከራ ካባቲን በላ፣</para>
  <para style="q2" vid="JER 4:6">በዲሰ ሱከኔሳስ ነንፍዳቲ።”<verse eid="JER 4:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="JER 4:7"/>ሌንጭ ቦሶነሳቲ በኤረ፤</para>
  <para style="q2" vid="JER 4:7">በርበዴሳን ሰቦታ ከራ ቀበቴረ።</para>
  <para style="q1" vid="JER 4:7">እን ብየኬ ኦንሱፍ ጄዼ</para>
  <para style="q2" vid="JER 4:7">እዶሳቲ ከኤረ።</para>
  <para style="q1" vid="JER 4:7">መጋላወንኬ ኦነኒ</para>
  <para style="q2" vid="JER 4:7">ጅራቶተ መሌ ንሀፉ።<verse eid="JER 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 4:8"/>ከናፉ እስን ኡፈተ ገዳ ኡፈዻቲ</para>
  <para style="q2" vid="JER 4:8">ቦኣ ወዋዻ፤</para>
  <para style="q1" vid="JER 4:8">ዼከምስ <char style="nd">ዋቀዮ</char> ሶዳችሳን ሱን</para>
  <para style="q2" vid="JER 4:8">ኑራ ህንዴብኔቲ።<verse eid="JER 4:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="JER 4:9"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q2" vid="JER 4:9">“ጉያ ሰነ ሞቲኒፊ ቆንዳልቶትን ኦኔ ዸቡ፤</para>
  <para style="q1" vid="JER 4:9">ሉቦትን አከ መሌ ነኡ፤</para>
  <para style="q2" vid="JER 4:9">ራጆትንስ ንራፈሙ።”<verse eid="JER 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 4:10"/>አንስ አከነ ነንጄዼ፤ “ያ <char style="nd">ዋቀዮ</char> ጎፍታ፣ አት ኡቱ ጎራዴን ኮኬኬኘረ ጅሩ፣ ‘እስን ነጋ ቀባቱ’ ጄቹዻን ሰበ ከናፊ ዬሩሳሌምን ጉቱማን ጉቱት ጎዎምስቴርተ?”<verse eid="JER 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 4:11"/>ዬሮ ሰነት ሰበ ከናፊ ዬሩሳሌምት አከነ ጄዸሜ ንህመመ፤ “ቡቤን ዋ ጉቡ ቶኮ እዶወን ኦል ከኦ ቁላ ከኔን ገሞጂ ኬሳራ ገረ ሰበኮቲት ንቡብሰ፤ ገሩ አፈርሱፍ ዮካን ቁልቁሌሱፍ ምት፤ <verse eid="JER 4:11"/><verse number="12" style="v" sid="JER 4:12"/>ቡቤን ዋን ሰናፍ አከ መሌ ጭማ ተኤ ቶኮ ነ ብራ ንዹፈ። አንስ ሙርቲኮ እሳንት ነንለብሰ።”<verse eid="JER 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 4:13"/>ኩኖ፣ እን አከ ዱሜሳት፣</para>
  <para style="q2" vid="JER 4:13">ጋሪንሳስ አከ ቡቤት ንዹፈ፤</para>
  <para style="q1" vid="JER 4:13">ፈርዴንሳ ርሳ ጫላ ሰፍሱ።</para>
  <para style="q2" vid="JER 4:13">ወዮ ኑ በዱኬኘ!<verse eid="JER 4:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 4:14"/>ያ ዬሩሳሌም፣ አት አከ ፈይቱፍ <optbreak/> ቀልቢኬ ኬሳ ሀምነ ዽቀዹ።</para>
  <para style="q2" vid="JER 4:14">ሀመ ዮሚት ያድን ሀማን ስ ኬሰ ጅራተ?<verse eid="JER 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 4:15"/>ሰገሌን ቶኮ ዳንራ ለለበ፤</para>
  <para style="q2" vid="JER 4:15">ቱሉወን ኤፍሬምራስ በዲሰ ለብሰ።<verse eid="JER 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 4:16"/>“ዋን ከነ ሰቦተት ህማ፤</para>
  <para style="q2" vid="JER 4:16">ዬሩሳሌምትስ አከነ ጄዻ ለለባ፦</para>
  <para style="q1" vid="JER 4:16">‘ሎልቶትን መርሰኒ ብየ ቀበተን ቶኮ <optbreak/> ለፈ ፈጎዻ ንዹፉ፤</para>
  <para style="q2" vid="JER 4:16">እሳንስ መጋላወን ይሁዳት ንእዩ።<verse eid="JER 4:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 4:17"/>ሰበቢ እሼን ነት ፍንጭልቴፍ፣</para>
  <para style="q2" vid="JER 4:17">እሳን አኩመ ነመ ለፈ ቆቲሳ ኤጉ ቶኮት <optbreak/> እሼ ንመርሱ፣’ ”</para>
  <para style="q2" vid="JER 4:17">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 4:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 4:18"/>“አመልኬቲፊ ሆጂንኬ</para>
  <para style="q2" vid="JER 4:18">ዋን ከነ ስት ፍደኒሩ።</para>
  <para style="q1" vid="JER 4:18">አደቢንኬ ከናዸ።</para>
  <para style="q2" vid="JER 4:18">እንስ ሀመም ሀዻአ!</para>
  <para style="q2" vid="JER 4:18">ኦኔስ ሀመም ወራነ!”<verse eid="JER 4:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="JER 4:19"/>መርኡማንኮ፣ መርኡማንኮ!</para>
  <para style="q2" vid="JER 4:19">አን ዹኩቢዻን ነንውጥርፈዸ።</para>
  <para style="q1" vid="JER 4:19">ኦኔንኮ ነ ኬሳ ወጨ፤</para>
  <para style="q2" vid="JER 4:19">ኦኔንኮ ነ ኬሰት ዸአተ፤</para>
  <para style="q2" vid="JER 4:19">አን ጨልእሱ ህንደንደኡ።</para>
  <para style="q1" vid="JER 4:19">አን ሰገሌ መለከታ ዸገኤራቲ፤</para>
  <para style="q2" vid="JER 4:19">ወጨ ወራናስ ዸገኤረ።<verse eid="JER 4:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 4:20"/>በዲስን በዲሰ እራን ዹፈ፤</para>
  <para style="q2" vid="JER 4:20">ብየቲን ጉቱማን ጉቱት ንኦንት።</para>
  <para style="q1" vid="JER 4:20">ዱንካንኮ አኩመ ተሳ፣</para>
  <para style="q2" vid="JER 4:20">ጎልጋንኮስ ዬሮ ገባባ ኬሰት በዴ።<verse eid="JER 4:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 4:21"/>አን ሀመ ዮሚትን መለቶ ወራና እላለ?</para>
  <para style="q2" vid="JER 4:21">ሀመ ዮሚትስ ሰገሌ መለከታ ዸገአ?<verse eid="JER 4:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="JER 4:22"/>“ኡመትንኮ ጎዋዸ፤</para>
  <para style="q2" vid="JER 4:22">አነስ ህንቤከን።</para>
  <para style="q1" vid="JER 4:22">እሳን እጆሌ ቀልቢ ህንቀብኔዸ፤</para>
  <para style="q2" vid="JER 4:22">ሁበትናስ ህንቀበን።</para>
  <para style="q1" vid="JER 4:22">እሳን ዋን ሀማ ሆጄቹት ኦጌዪዸ፤</para>
  <para style="q2" vid="JER 4:22">ዋን ጋሪ ሆጄቹ ገሩ ህንቤከን።”<verse eid="JER 4:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="JER 4:23"/>አን ለፈ ነንእላሌ፤</para>
  <para style="q2" vid="JER 4:23">እሼንስ ብፈ ህንቀብዱ፤ ዱዋስ ቱርቴ፤</para>
  <para style="q1" vid="JER 4:23">ሰሚወንስ ነንእላሌ፤</para>
  <para style="q2" vid="JER 4:23">እፍንሳኒ ዻሜ ቱሬ።<verse eid="JER 4:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 4:24"/>አን ቱሉወን ነንእላሌ፤</para>
  <para style="q2" vid="JER 4:24">እሳን ሶቾኣ ቱረን፤</para>
  <para style="q2" vid="JER 4:24">ጋረን ሁንድኑስ ራፈማ ቱረን።<verse eid="JER 4:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 4:25"/>አን ነንእላሌ፤ ነምን ቶኮዩ ህንቱሬ፤</para>
  <para style="q2" vid="JER 4:25">ስምብሮትን ሰሚ ሁንድስ በርሰኒ በደኒ ቱረን።<verse eid="JER 4:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JER 4:26"/>አን ነንእላሌ፤ ኩኖ ብይ ምዻን ባፍቱ ኦንቴ ቱርቴ፤</para>
  <para style="q2" vid="JER 4:26">መጋላወንሼ ሁንድስ፣ <optbreak/> ፉለ <char style="nd">ዋቀዮ</char> ዱረት</para>
  <para style="q2" vid="JER 4:26">ዼከምሰሳ ሶዳችሳ ሰናን ዲገመን።<verse eid="JER 4:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 4:27"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 4:27">“ዮ አን ጉቱማን ጉቱት እሼ በሌሱ ባዼዩ</para>
  <para style="q2" vid="JER 4:27">ብየቲን ጉቱማን ጉቱት ንበርበዶፍት።<verse eid="JER 4:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 4:28"/>ከናፉ ለፍት ንቦስ፤</para>
  <para style="q2" vid="JER 4:28">ሰሚወን ኦሊስ ንዱከናኡ፤</para>
  <para style="q1" vid="JER 4:28">አን ዱበዼራቲ ህንጋቡ፤</para>
  <para style="q2" vid="JER 4:28">ሙርቴሴረ፤ ዱግደ ዱበስ ህንዴብኡ።”<verse eid="JER 4:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="JER 4:29"/>ሰበቢ እየ አቦቲ ፈርዴኒቲፊ ፉታፍቶተ ጥያቲን፣</para>
  <para style="q2" vid="JER 4:29">ቶኮን ቶኮን መጋላ ንበቀተ።</para>
  <para style="q1" vid="JER 4:29">ገር ቶኮ ቦሶነ ጎቡ ሴነ፤</para>
  <para style="q2" vid="JER 4:29">ካንሞ ከታት ኦል በአ፤</para>
  <para style="q1" vid="JER 4:29">መጋላወን ሁንድ ዱዋ ሀፈኒሩ፤</para>
  <para style="q2" vid="JER 4:29">ነምን ቶኮዩ እሳን ኬሰ ህንጅራቱ።<verse eid="JER 4:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="JER 4:30"/>ያ ኦንቱነነ፣ አት ማል ጎቻ ጅርተ?</para>
  <para style="q2" vid="JER 4:30">አት ማሊፍ ወያ ብልዲማ ኡፈቴ</para>
  <para style="q2" vid="JER 4:30">ፋየ ወርቄ ካአቴ?</para>
  <para style="q1" vid="JER 4:30">ማሊፍ እጀኬ ኩለቴ?</para>
  <para style="q2" vid="JER 4:30">አት አከሱማን ኦፍ ሚዸግስተ።</para>
  <para style="q1" vid="JER 4:30">ወር ጃለተን ስ ቱፈቱ፤</para>
  <para style="q2" vid="JER 4:30">ሉቡኬስ በሌሱ በርባዱ።<verse eid="JER 4:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="JER 4:31"/>አን እየ አከ እየ ዱበርቲ ጭኒንስፈቱ ቶኮ፣</para>
  <para style="q2" vid="JER 4:31">ሚጡ አከ ሚጡ ዱበርቲ ሙጫ</para>
  <para style="q2" vid="JER 4:31">ሀንገፈ ዴሱ ቶኮ ነንዸገኤ፤</para>
  <para style="q1" vid="JER 4:31">አን እየ እንተለ ጥዮን ከን ዬሮ ሀፉርሼ ጭቱት አርገንቴ</para>
  <para style="q2" vid="JER 4:31">ሀርከሼ ፈጫሱዻን፣</para>
  <para style="q1" vid="JER 4:31">“ወዮ! አን በዴ፤</para>
  <para style="q2" vid="JER 4:31">ሉቡንኮ ሀርከ ወረ ነመ አጄሱት</para>
  <para style="q2" vid="JER 4:31">ደበርፈምቴ ኬነምቴርት” ጄቱ ነንዸገኤ።<verse eid="JER 4:31"/></para>
  <chapter eid="JER 4"/>
  <chapter number="5" style="c" sid="JER 5"/>
  <para style="s1">ነምን ቶላን ቶኮዩ ህንጅሩ</para>
  <para style="q1">
    <verse number="1" style="v" sid="JER 5:1"/>“ዳንዲወን ዬሩሳሌምራ ኦሊ ገድ ዴዴብኣ፤</para>
  <para style="q2" vid="JER 5:1">አሲፊ አች እላላቲ ቀልቤፈዻ፤</para>
  <para style="q2" vid="JER 5:1">ኦብዲወንሼ ሰከተኣ።</para>
  <para style="q1" vid="JER 5:1">እስን ዮ ነመ ዋን ቀጄላ ሆጄቱ፣</para>
  <para style="q2" vid="JER 5:1">ከን ዹጋ በርባዱ ቶኮሌ አርገተን</para>
  <para style="q2" vid="JER 5:1">አን መጋላ ከናፍ ዺፈመ ነንጎዸ።<verse eid="JER 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 5:2"/>እሳን ኡቱመ ‘ዹጋ <char style="nd">ዋቀዮ</char> ጅራታ’ ጄዸኑ</para>
  <para style="q2" vid="JER 5:2">አመዩ ሶባን ከከቱ።”<verse eid="JER 5:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="JER 5:3"/>ያ <char style="nd">ዋቀዮ</char>፣ እጅኬ ዹጋ ህንበርባዱ?</para>
  <para style="q2" vid="JER 5:3">አት እሳን ዾፍቴ፤ ገሩ እሳን ህንዹኩብኔ፤</para>
  <para style="q2" vid="JER 5:3">አት እሳን ጨጨብስቴ፤ እሳን ገሩ ስሬፈሙ ድደን።</para>
  <para style="q1" vid="JER 5:3">እሳን ዸጋ ጫላ መታ ጀባተኒ</para>
  <para style="q2" vid="JER 5:3">ቀልቢ ጅጂረቹ ድደን።<verse eid="JER 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 5:4"/>አንስ አከነ ጄዼን ያዴ፤</para>
  <para style="q2" vid="JER 5:4">“ጀር ኩኔን ህዬዪዸ፤ እሳን ጎዎተ፤</para>
  <para style="q1" vid="JER 5:4">እሳን ከራ <char style="nd">ዋቀዮ</char>፣</para>
  <para style="q2" vid="JER 5:4">ሴረ ዋቀሳኒ ህንቤከኒቲ።<verse eid="JER 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 5:5"/>ከናፉ አን ሀንገፎተ ብረ ዸቄ እሳንት ነንዱበዸ፤</para>
  <para style="q2" vid="JER 5:5">ዹጉማን እሳን ከራ <char style="nd">ዋቀዮ</char>፣</para>
  <para style="q2" vid="JER 5:5">ሴረ ዋቀሳኒስ ንቤኩ።”</para>
  <para style="q1" vid="JER 5:5">እሳንስ አከሱመ ዋንጆ ኦፍራ ጨጨብሰኒ</para>
  <para style="q2" vid="JER 5:5">ህዻስ ኦፍራ ኩኩተኒሩ።<verse eid="JER 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 5:6"/>ከናፉ ሌንጭ ቦሶና በኤ እሳን ኛተ፤</para>
  <para style="q2" vid="JER 5:6">ዬዪን ገሞጂስ ዹፌ እሳን በሌሰ፤</para>
  <para style="q1" vid="JER 5:6">ቄረንስ ወረ ገድ በአን ጭጭረቹፍ</para>
  <para style="q2" vid="JER 5:6">መጋላወንሳኒ ብረት ርጴ ኤገተ፤</para>
  <para style="q1" vid="JER 5:6">ፍንጭልሳኒ አከ መሌ ጉደቴ፤</para>
  <para style="q2" vid="JER 5:6">ዱበት ዴብኡንሳኒስ ባይአቴራቲ።<verse eid="JER 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="JER 5:7"/>“አን አከሚነን ዺፈመ እስኒፍ ጎቹ ደንደአ?</para>
  <para style="q2" vid="JER 5:7">እጆሌንኬ ነ ዺሰኒ</para>
  <para style="q2" vid="JER 5:7">ዋቆተ ዋቆተ ህንተእኒን ከከተኒሩ።</para>
  <para style="q1" vid="JER 5:7">አን ዋን እሳኒፍ በርባችሱ ሁንደ ኬኔፊን ቱሬ፤</para>
  <para style="q2" vid="JER 5:7">እሳን ገሩ ንኤጀን፤</para>
  <para style="q2" vid="JER 5:7">ገረ መኔን ሰጋገልቱወኒትስ ጉገተን።<verse eid="JER 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 5:8"/>እሳን ኮሮሚ ፈርዴኒ ከኔን አከ ጋሪት ሶረመኒዸ፤</para>
  <para style="q2" vid="JER 5:8">ቶኮን ቶኮንሳኒ ኒቲ ነማት ህምምሱ።<verse eid="JER 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 5:9"/>አን ዋን ከናፍ እሳን ህንአደቡሬ?”</para>
  <para style="q2" vid="JER 5:9">ጄዸ <char style="nd">ዋቀዮ</char>።</para>
  <para style="q1" vid="JER 5:9">“አን መታንኮ ሰበ አከ ሰበ ከና</para>
  <para style="q2" vid="JER 5:9">ሃሎ ህንበኡ?<verse eid="JER 5:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JER 5:10"/>“ደላ ዸጋሼት ኦል በኣቲ በሌሳ፤</para>
  <para style="q2" vid="JER 5:10">ገሩ ጉቱማን ጉቱት ምት።</para>
  <para style="q1" vid="JER 5:10">ደሜወንሼ እራ ጭራ፤</para>
  <para style="q2" vid="JER 5:10">ሰብን ኩን ሰበ <char style="nd">ዋቀዮ</char> ምት።<verse eid="JER 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 5:11"/>መን እስራኤሊፊ መን ይሁዳ፣</para>
  <para style="q2" vid="JER 5:11">ጉቱማን ጉቱት አናፍ ህንአመነምኔ”</para>
  <para style="q2" vid="JER 5:11">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 5:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="JER 5:12"/>እሳን ዋኤ <char style="nd">ዋቀዮ</char> ሶበ ዱበተን፤</para>
  <para style="q2" vid="JER 5:12">አከነስ ጄዸን፤ “እን ሆማ ህንጎዹ!</para>
  <para style="q1" vid="JER 5:12">ሚዻን ቶኮዩ ኑት ህንዹፉ፤</para>
  <para style="q2" vid="JER 5:12">ጎራዴ ዮካን ቤለ ህንአርግኑ።<verse eid="JER 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 5:13"/>ራጆትን ቡቤ መሌ ሆማ ምት፤</para>
  <para style="q2" vid="JER 5:13">ዱቢን እሳን ኬሰ ህንጅሩ፤</para>
  <para style="q2" vid="JER 5:13">ወን እሳን ዱበተን እሳኑመት ሃዴብኡ።”<verse eid="JER 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 5:14"/>ከናፉ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 5:14">“ሰብን ኩን ዋን ዱቢ ከነ ዱበቴፍ፣</para>
  <para style="q2" vid="JER 5:14">አን ዱቢኮ አፋንኬ ኬሰት እብደ፣</para>
  <para style="q2" vid="JER 5:14">ሰበ ከነሞ ቆራን እብድ ጉቡ ነንጎዸ።<verse eid="JER 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 5:15"/>ያ መነ እስራኤል፣” ጄዸ <char style="nd">ዋቀዮ</char>፤</para>
  <para style="q2" vid="JER 5:15">“አን ሰበ ዱሪቲፊ ጀባ፣</para>
  <para style="q1" vid="JER 5:15">ሰበ አት አፋንሳ ህንቤክኔ፣</para>
  <para style="q2" vid="JER 5:15">ከን አት ዱቢሳሌ ህንሁበትኔ ቶኮ</para>
  <para style="q2" vid="JER 5:15">ብየ ፈጎዻ ስት ነንፍደ።<verse eid="JER 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 5:16"/>መንኤን ጥየሳኒ አኩመ አዋለ በነማት፤</para>
  <para style="q2" vid="JER 5:16">ሁንድሳኒስ ሎልቶተ ጀጀቦዸ።<verse eid="JER 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 5:17"/>እሳን ምዻንኬቲፊ ቡዴነኬ ንኛቱ፤</para>
  <para style="q2" vid="JER 5:17">እልማንኬቲፊ እንተለንኬ ንአጄሱ፤</para>
  <para style="q1" vid="JER 5:17">ቡሻዬፊ ሎንኬ ንኛቱ፤</para>
  <para style="q2" vid="JER 5:17">ወይኒኬቲፊ ሙኬን ሀርቡኬቲ ንኛቱ።</para>
  <para style="q1" vid="JER 5:17">መጋላወን ደላ ጀባ ቀበን</para>
  <para style="q2" vid="JER 5:17">ከኔን አት አመነቴ ሰነ ጎራዴዻን በርበዴሱ።<verse eid="JER 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 5:18"/>“ተኡስ አን በረ ሰነ ኬሰዩ ጉቱማን ጉቱት እስን ህንበሌሱ” ጄዸ <char style="nd">ዋቀዮ</char>። <verse eid="JER 5:18"/><verse number="19" style="v" sid="JER 5:19"/>“ዮሙ ነሞትን፣ ‘<char style="nd">ዋቀዮ</char> ዋቅንኬኘ ማሊፍ ዋን ከነ ሁንደ ኑት ፍዴ?’ ጄዸኒ ጋፈተንት፣ አት፣ ‘እስን አኩመ ነ ዺፍተኒ ብየኬሰን ኬሰት ዋቆተ ኦርማ ተጃጅልተን ሰነ፣ አመስ ብየ ከን መታኬሰኒ ህንተእን ኬሰት ኦርሞተ ንተጃጅልቱ’ ጄቴ እሳንት ህምተ።<verse eid="JER 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 5:20"/>“ዋን ከነ መነ ያቆብት ህማ፤</para>
  <para style="q2" vid="JER 5:20">ይሁዳ ኬሰትስ ለብሳ፦<verse eid="JER 5:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 5:21"/>እስን ኡመትን ጎዋን ሁበትና ህንቀብኔ፣</para>
  <para style="q2" vid="JER 5:21">ወር ኡቱ እጀ ቀብደኑ ህንአርግኔ</para>
  <para style="q2" vid="JER 5:21">ከኔን ኡቱ ጉረ ቀብደኑ <optbreak/> ህንዸጌኜ ዋን ከነ ዸገአ።<verse eid="JER 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 5:22"/>እስን ነ ህንሶዳተኒ?”</para>
  <para style="q2" vid="JER 5:22">ጄዸ <char style="nd">ዋቀዮ</char>።</para>
  <para style="q2" vid="JER 5:22">“ፉለኮ ዱረት ህንሆለተኒ?</para>
  <para style="q1" vid="JER 5:22">አን ገላናፍ ጭረቸ ዳሪ ደላ በረ በራ ከን እን</para>
  <para style="q2" vid="JER 5:22">ቀጣሙሩ ህንደንዴኜ ጎዼ ቶልቼረ።</para>
  <para style="q1" vid="JER 5:22">ዸኣን ገላና ዮ እት ቡኤዩ እሰ ዲጉ ህንደንደኡ፤</para>
  <para style="q2" vid="JER 5:22">ገላንች ዮ ሁርሴዩ፣ እሰ ጨብሴ ደርቡ ህንደንደኡ።<verse eid="JER 5:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 5:23"/>ሰብን ኩን ገሩ መተ ጀቤሳፊ ፍንጭላዸ፤</para>
  <para style="q2" vid="JER 5:23">እንስ ከራራ ጀልአቴ በዴረ።<verse eid="JER 5:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 5:24"/>እሳን ገራሳኒት አከነ ህንጄዸን፤</para>
  <para style="q2" vid="JER 5:24">‘ኮታ <char style="nd">ዋቀዮ</char> ዋቀኬኘ እሰ ቦካ አርፋሳቲፊ <optbreak/> ቦካ ብራ ወቅቲዻን ኬኑ፣</para>
  <para style="q1" vid="JER 5:24">እሰ ቶርበኖተ እት ምዻን ወልት ቀበትኑ</para>
  <para style="q2" vid="JER 5:24">ዬሮሳኒት ኑ ኬኑ ሰነ ሃሶዳትኑ።’<verse eid="JER 5:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 5:25"/>በሌሳንኬሰን ዋን ከነ እስንራ ዴብሴረ፤</para>
  <para style="q2" vid="JER 5:25">ጩቡንኬሰን ዋን ጋሪ እስን ዸብሲሴረ።<verse eid="JER 5:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="JER 5:26"/>“ሰበኮ ግዱ ነሞተ ሀሞ</para>
  <para style="q2" vid="JER 5:26">አከ ወረ ነመ ቀቡፍ ክዮ ካአኒት፣</para>
  <para style="q2" vid="JER 5:26">አኩመ ነመ ክዮን ስምብሮ ቀቡት <optbreak/> ርጰኒ ኤገተንቱ ጅረ።<verse eid="JER 5:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 5:27"/>አኩመ መንኤን ስምብራን ጉተሙ፣</para>
  <para style="q2" vid="JER 5:27">መኔንሳኒ ሶባን ጉተሙ፤</para>
  <para style="q1" vid="JER 5:27">እሳንስ ሶሬዪፊ ጀጀቦ ተአኒ፣<verse eid="JER 5:27"/></para>
  <para style="q2">
    <verse number="28" style="v" sid="JER 5:28"/>ገበተኒ በሬደኒሩ፤</para>
  <para style="q1" vid="JER 5:28">ሀምንሳኒ ዹመ ህንቀቡ፤</para>
  <para style="q2" vid="JER 5:28">እሳን ሙርቲ ቀጄላ ህንበርባደን።</para>
  <para style="q1" vid="JER 5:28">እሳን ዽመ እጆሌ አባ ህንቀብኔቲፍ ህንፈልመን፤</para>
  <para style="q2" vid="JER 5:28">ምርገ ህዬዪቲፍስ ህንዻበተን።<verse eid="JER 5:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JER 5:29"/>አን ዋን ከናፍ እሳን ህንአደቡ?”</para>
  <para style="q2" vid="JER 5:29">ጄዸ <char style="nd">ዋቀዮ</char>።</para>
  <para style="q1" vid="JER 5:29">“አን ሰበ አከሲ</para>
  <para style="q2" vid="JER 5:29">ሃሎ ህንባፈዹ?<verse eid="JER 5:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="JER 5:30"/>“ወን ሱከኔሳን ነመ ርፈቺሱ ቶኮ</para>
  <para style="q2" vid="JER 5:30">ብየቲ ኬሰት ተኤረ፦<verse eid="JER 5:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JER 5:31"/>ራጆትን ራጂ ሶባ ዱበቱ፤</para>
  <para style="q2" vid="JER 5:31">ሉቦትን ሁምኑመሳኒቲን ብየ ቡልቹ፤</para>
  <para style="q1" vid="JER 5:31">ሰብንኮስ ዋን አከሲ ጃለተ፤</para>
  <para style="q2" vid="JER 5:31">እስን ገሩ ዹመረት ማል ጎቹፍ ጅርቱ?<verse eid="JER 5:31"/></para>
  <chapter eid="JER 5"/>
  <chapter number="6" style="c" sid="JER 6"/>
  <para style="s1">ዬሩሳሌም መርፈምቴ</para>
  <para style="q1">
    <verse number="1" style="v" sid="JER 6:1"/>“ያ ሰበ ቤንያም በቀዻ በኣ!</para>
  <para style="q2" vid="JER 6:1">ዬሩሳሌም ኬሳ በቀዻ!</para>
  <para style="q1" vid="JER 6:1">ቴቆኣ ኬሰት መለከተ አፉፋ!</para>
  <para style="q2" vid="JER 6:1">ቤት ሀኬሬምረት መለቶ ኦል ቀባ!</para>
  <para style="q1" vid="JER 6:1">ከራ ካባቲን በላን፣</para>
  <para style="q2" vid="JER 6:1">በዲስን ሱከኔሳን ንዹፋቲ።<verse eid="JER 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 6:2"/>አን እንተለ ጥዮን እሼ በሬዱፊ</para>
  <para style="q2" vid="JER 6:2">ቀነኒቱ ሰነ ነንገላፈዸ።<verse eid="JER 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 6:3"/>ትክሶትን ቡሻዬሳኒ ፉዸተኒ እሼት ዹፉ፤</para>
  <para style="q2" vid="JER 6:3">ዱንካነሳኒስ እሼት ናኔሰኒ ዻበቱ።</para>
  <para style="q2" vid="JER 6:3">ቶኮን ቶኮንሳኒስ እዶሳኒት ቦባፈቱ።”<verse eid="JER 6:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="JER 6:4"/>“እሼት ወራነ ካሱፍ ቆጳኣ!</para>
  <para style="q2" vid="JER 6:4">ከኣ፣ ጉያ ሳፋዻን እሼ ወራና!</para>
  <para style="q1" vid="JER 6:4">ወዮ፣ አዱን ዽኣ ጅርት፤</para>
  <para style="q2" vid="JER 6:4">ጋድስን ገልገላስ ዼረቴረ።<verse eid="JER 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 6:5"/>ከናፉ ከኣ፣ ሀልከኒን እሼ ዾፍኔ</para>
  <para style="q2" vid="JER 6:5">ደአኖወንሼ በርበዴስና!”<verse eid="JER 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 6:6"/>
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ አከነ ጄዸ፤</para>
  <para style="q1" vid="JER 6:6">“ሙኬንሼ ጭራ፤</para>
  <para style="q2" vid="JER 6:6">ናኖ ዬሩሳሌምት ቱላ ብዮ ቶልቻ፤</para>
  <para style="q1" vid="JER 6:6">መጋላን ኩን አደበሙ ቀብድ፤</para>
  <para style="q2" vid="JER 6:6">እሼን ጩንቁርሳዻን ጉተምቴርቲ።<verse eid="JER 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 6:7"/>አኩመ ቦል ብሻኒ ብሻን ያሱ ሰነ፣</para>
  <para style="q2" vid="JER 6:7">እሼንስ ሀምነሼ ገድ ያፍት፤</para>
  <para style="q1" vid="JER 6:7">ጄቁምሲፊ በዲስንሼ ኬሰት ንዸገአመ።</para>
  <para style="q2" vid="JER 6:7">ዹኩብኒፊ መዳንሼ ዬሮ ሁንደ ፉለኮ ዱረ ጅረን።<verse eid="JER 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 6:8"/>ያ ዬሩሳሌም ጎርሰኮ ዸገእ፤</para>
  <para style="q2" vid="JER 6:8">ዮ ከና አቺ አን ስራ ገረገሌ፣</para>
  <para style="q1" vid="JER 6:8">አከ ነምን ቶኮዩ ኬሰ ጅራቹ</para>
  <para style="q2" vid="JER 6:8">ህንደንዴኜፍ፣ ብየኬ ነንኦንሰ።”<verse eid="JER 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 6:9"/>
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 6:9">“አኩመ ወይኒን ስሪት ፉናነሙ ሰነ፣</para>
  <para style="q2" vid="JER 6:9">እሳንስ ሀምባ እስራኤል ሃፉናነን፤</para>
  <para style="q1" vid="JER 6:9">አኩመ ነመ እጀ ወይኒ ጭሩ ቶኮት፤</para>
  <para style="q2" vid="JER 6:9">አመስ ሀርከኬ ገረ ደሜወኒት ሂጠዹ።”<verse eid="JER 6:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JER 6:10"/>አን ኤኙን ዱበዼ አኬከቺሱ ደንደአ?</para>
  <para style="q2" vid="JER 6:10">ኤኙቱ ነ ዸጌፈተ?</para>
  <para style="q1" vid="JER 6:10">ኩኖ፣ ጉርሳኒ ዸግነ ህንቀበትኔ፤</para>
  <para style="q2" vid="JER 6:10">ዸገኡስ ህንደንደአን።</para>
  <para style="q1" vid="JER 6:10">ዱቢን <char style="nd">ዋቀዮ</char> እሳንት ህንቶሉ፤</para>
  <para style="q2" vid="JER 6:10">እትስ ህንገመደን።<verse eid="JER 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 6:11"/>አን ገሩ ዼከምሰ <char style="nd">ዋቀዮቲን</char> ጉተሜረ፤</para>
  <para style="q2" vid="JER 6:11">ኦብሱስ ህንደንደኡ።</para>
  <para style="b" vid="JER 6:11"/>
  <para style="q1" vid="JER 6:11">“እጆሌ ዳንዲረ ጅረንረት፣</para>
  <para style="q2" vid="JER 6:11">ደርገጎተ ወልት ቀበመንረት፣</para>
  <para style="q1" vid="JER 6:11">ዽርሳፊ ኒቲረት፣</para>
  <para style="q2" vid="JER 6:11">ወረ ዱሎመንትስ ዼከምሰ ነንዸንገላሰ።<verse eid="JER 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 6:12"/>ዬሮ አን ሀርከኮ</para>
  <para style="q2" vid="JER 6:12">ወረ ብየቲ ኬሰ ጅራተንት ኦል ፉዸዹት</para>
  <para style="q1" vid="JER 6:12">መኔንሳኒ፣ ለፈ ቆቲሳሳኒቲፊ</para>
  <para style="q2" vid="JER 6:12">ኒቶተሳኒ ወጅን ነሞተ ካኒፍ ኬነሙ”</para>
  <para style="q2" vid="JER 6:12">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 6:13"/>“ጥናዻ ሀመ ጉዳት</para>
  <para style="q2" vid="JER 6:13">ሁንድሳኒዩ ቡኣ አርገቹፍ ገገቡ፤</para>
  <para style="q1" vid="JER 6:13">ራጆትኒፊ ሉቦትንስ አከሱመ</para>
  <para style="q2" vid="JER 6:13">ሁንድሳኒ ነመ ጎዎምሱ።<verse eid="JER 6:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 6:14"/>እሳን መዳ ሰበኮቲ</para>
  <para style="q2" vid="JER 6:14">አኩመ ዋን ጥና ቶኮት እላለኒ ወልኣኑ።</para>
  <para style="q1" vid="JER 6:14">ኡቱ ነጋን ህንጅራትንስ</para>
  <para style="q2" vid="JER 6:14">‘ነጋ፣ ነጋ’ ጄዹ።<verse eid="JER 6:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 6:15"/>እሳን አመለሳኒ ጅብሲሳ ሰነት ንቃነኡ?</para>
  <para style="q2" vid="JER 6:15">ለኪ፣ እሳን ቃኒ ቶኮዩ ህንቀበን፤</para>
  <para style="q2" vid="JER 6:15">ቃነኡን ማል አከ ተኤዩ ህንቤከን።</para>
  <para style="q1" vid="JER 6:15">ከናፉ እሳን ወረ ኩፈን ወጅን ንኩፉ፤</para>
  <para style="q2" vid="JER 6:15">ዬሮ አን እሳን አደቡት ገድ ገተሙ”</para>
  <para style="q2" vid="JER 6:15">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 6:16"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 6:16">“ከራ ቀጣሙራረ ዻበዻቲ እላላ፤</para>
  <para style="q2" vid="JER 6:16">ዳንዲ ዱሪ እያፈዻ፤</para>
  <para style="q1" vid="JER 6:16">ከራን ጋሪን ገረም አከ ጅሩ ጋፈዻቲረ ዴማ፤</para>
  <para style="q2" vid="JER 6:16">ሉቡኬሰኒፍ ቦቆና ንአርገቱቲ።</para>
  <para style="q2" vid="JER 6:16">እስን ገሩ፣ ‘ኑ እሰረ ህንዴምኑ’ ጄተን።<verse eid="JER 6:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 6:17"/>አን ኤግዶተ እስንት ረመዴን</para>
  <para style="q2" vid="JER 6:17">‘ሰገሌ መለከታ ዸጌፈዻ!’ ጄዼ፣</para>
  <para style="q2" vid="JER 6:17">እስን ገሩ፣ ‘ህንዸጌፈትኑ’ ጄተን።<verse eid="JER 6:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 6:18"/>ከናፉ ያ ሰቦተ ዸገኣ፤</para>
  <para style="q2" vid="JER 6:18">ያ ወልዳ፣</para>
  <para style="q2" vid="JER 6:18">ዋን እሳንት ዹፉፍ ጅሩ ሁበዻ።<verse eid="JER 6:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 6:19"/>ያ ለፋ ዸገእ፦</para>
  <para style="q2" vid="JER 6:19">አን ዋን እሳን ዱቢኮ ዸገኡ ድደኒ</para>
  <para style="q2" vid="JER 6:19">ሴረኮስ ቱፈተኒፍ፣</para>
  <para style="q1" vid="JER 6:19">ሰበ ከነት በዲሰ ነንፍደ፤</para>
  <para style="q2" vid="JER 6:19">ኩንስ እጀ ደበሳኒት።<verse eid="JER 6:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 6:20"/>እጣን ብየ ሼባቲ ዹፉ፣</para>
  <para style="q2" vid="JER 6:20">ዮካን ቀዪ ብየ ፈጎቲ ዹፉ ማል ነ ፈየደ?</para>
  <para style="q1" vid="JER 6:20">ኣርሳንኬሰን ከን ጉበሙ ፉዸተመ ህንቀቡ፤</para>
  <para style="q2" vid="JER 6:20">ቀልምኬሰንስ ህንቶሉ።”<verse eid="JER 6:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 6:21"/>ከናፉ <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 6:21">“አን ፉለ ሰበ ከና ዱረ ጉፉ ነንካአ።</para>
  <para style="q2" vid="JER 6:21">አቦቲኒፊ እጆሌን ወሊ ወጅን እት ጉፈቱ፤</para>
  <para style="q2" vid="JER 6:21">ኦሎትኒፊ ምቾትን ንበርበዳኡ።”<verse eid="JER 6:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JER 6:22"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፤</para>
  <para style="q1" vid="JER 6:22">“ኩኖ፣ ገሬን ሎልቶታ ቶኮ</para>
  <para style="q2" vid="JER 6:22">ብየ ካባቲ ዹፋ ጅረ፤</para>
  <para style="q1" vid="JER 6:22">ሰብን ጉዳን ቶኮስ</para>
  <para style="q2" vid="JER 6:22">አንዳረ ለፋቲ ሶሶቾኣ ጅረ።<verse eid="JER 6:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 6:23"/>እሳን ጥያፊ ኤቦ ቀበተኒሩ፤</para>
  <para style="q2" vid="JER 6:23">እሳን ገረ ጀቤዪ፣ ነማፍስ ናሱ ህንቀብኔዸ።</para>
  <para style="q1" vid="JER 6:23">ዮሙ እሳን ፈርዴንሳኒ ጉሉፈንት</para>
  <para style="q2" vid="JER 6:23">ግግግሱንሳኒ አኩመ ሁርሳ ገላናት፤</para>
  <para style="q1" vid="JER 6:23">ያ እንተለ ጥዮን፣ እሳን አኩመ ነሞተ</para>
  <para style="q2" vid="JER 6:23">ዱላፍ ህሪረኒት ስ ሎሉፍ ዹፉ።”<verse eid="JER 6:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="JER 6:24"/>ኑ ኦዱ ዋኤሳኒ ዸጌኜረ፤</para>
  <para style="q2" vid="JER 6:24">ሀርክኬኘስ ንላፌ።</para>
  <para style="q1" vid="JER 6:24">ዽጵን ኑ ቀበቴረ፤</para>
  <para style="q2" vid="JER 6:24">ሚጡንስ አኩመ ዱበርቲ ጭኒንስፈቱ ኑ ቀቤ።<verse eid="JER 6:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 6:25"/>ሰበቢ ዲን ጎራዴ ቀበቴፊ</para>
  <para style="q2" vid="JER 6:25">ሰበቢ እዶ ሁንደ ጎሊን ጅሩፍ</para>
  <para style="q1" vid="JER 6:25">እስን ዲደት ገድ ህንበእና፤</para>
  <para style="q2" vid="JER 6:25">ዮካን ከራረ ህንዴምና።<verse eid="JER 6:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JER 6:26"/>ያ ሰበኮ፣ ኡፈተ ገዳ ኡፈዻቲ</para>
  <para style="q2" vid="JER 6:26">ዳራ ኬሰ ገንገለዻ፤</para>
  <para style="q1" vid="JER 6:26">አከ ነመ እልመሳ ቶክቸ ዸቤት</para>
  <para style="q2" vid="JER 6:26">ህቅፈዻ ቦኣ፤</para>
  <para style="q1" vid="JER 6:26">እን ነመ በሌሱ ሱን</para>
  <para style="q2" vid="JER 6:26">አኩመ ተሳ ኑት ዹፋቲ።<verse eid="JER 6:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="JER 6:27"/>“አከ አት ከራሳኒ ቆርቴ ቤክቱፍ</para>
  <para style="q2" vid="JER 6:27">አን ሰበኮ ግዱት ቆረታ ስ ጎዼረ።<verse eid="JER 6:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 6:28"/>ሁንድሳኒ ፍንጭልቶተ መተ ጀቤዪ</para>
  <para style="q2" vid="JER 6:28">መቃ ነማ በሌሱፍ አሲፊ አች ጆረኒዸ።</para>
  <para style="q1" vid="JER 6:28">እሳን ናሲፊ ስቢለ፤</para>
  <para style="q2" vid="JER 6:28">እሳን ሁንድኑ መላ መልቱማ ሆጄቱ።<verse eid="JER 6:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JER 6:29"/>ቡፋን ድላሊ እብዳን ጉቤ በሌሱፍ</para>
  <para style="q2" vid="JER 6:29">ሁምነ ጉዳን ቡፈ፤</para>
  <para style="q1" vid="JER 6:29">ሆጂን እብዳን ቁልቁሌሱ ኩን ፋይዳ መሌ ሆጄተመ፤</para>
  <para style="q2" vid="JER 6:29">ነሞትን ሀሞን ህንበሌፈምኔቲ።<verse eid="JER 6:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 6:30"/>ሰበቢ <char style="nd">ዋቀዮ</char> እሳን ገቴፍ</para>
  <para style="q2" vid="JER 6:30">እሳን ሜቲ ገተማ ጄዸሙ።”<verse eid="JER 6:30"/></para>
  <chapter eid="JER 6"/>
  <chapter number="7" style="c" sid="JER 7"/>
  <para style="s1">አመንቲን ሶባ ፋይዳ ህንቀቡ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 7:1"/>ዱቢን <char style="nd">ዋቀዮ</char> ብራ ገረ ኤርምያስ ዹፌ እሰ ከናዸ፤ <verse eid="JER 7:1"/><verse number="2" style="v" sid="JER 7:2"/>“በልበለ መነ <char style="nd">ዋቀዮ</char> ዱረ ዻበዹቲ አከነ ጄዺ ኤርጋ ከነ ለብስ፦</para>
  <para style="p" vid="JER 7:2">“ ‘እስን ሰብን ይሁዳ ወር <char style="nd">ዋቀዮን</char> ዋቄፈቹፍ በልበለወን ከኔኒን ኦል ሴንተን ሁንድ ዱቢ <char style="nd">ዋቀዮ</char> ዸገኣ። <verse eid="JER 7:2"/><verse number="3" style="v" sid="JER 7:3"/><char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል አከነ ጄዸ፦ ከራኬሰኒፊ ሆጂኬሰን ቀጄልፈዻ፤ አንስ አከ እስን እዶ ከነ ጅራተን ነንጎዸ። <verse eid="JER 7:3"/><verse number="4" style="v" sid="JER 7:4"/>እስን ዱቢ ሶባ አመነተኒ፣ “ኩን መነ ቁልቁሉማ <char style="nd">ዋቀዮት</char>፤ መነ ቁልቁሉማ <char style="nd">ዋቀዮት</char>፤ መነ ቁልቁሉማ <char style="nd">ዋቀዮት!</char>” ህንጄዽና። <verse eid="JER 7:4"/><verse number="5" style="v" sid="JER 7:5"/>እስን ኡቱ ዹጉማን ከራኬሰኒፊ ሆጂኬሰን ቀጄልፈተኒ ሙርቲ ቀጄላ ወሊፍ ኬንተኒ፣ <verse eid="JER 7:5"/><verse number="6" style="v" sid="JER 7:6"/>ኡቱ እስን አለጋ፣ እጆሌ አባ ህንቀብኔ ዮካን ሃዸ ህዬሳ ጩንቁርሱ ባተኒ እዶ ከነት ዺገ ነመ የከ ህንቀብኔ ዸንገላሱ ባተኒ፣ ኡቱ ዋቆተ እስን በሌሰን ዱካ ቡኡ ባተኒ፣ <verse eid="JER 7:6"/><verse number="7" style="v" sid="JER 7:7"/>ስላ አን አከ እስን እዶ ከነ፣ ብየ አን በረ በራን አቦቲኬሰኒፍ ኬኔ ኬሰ ጅራተን ነንጎዸ። <verse eid="JER 7:7"/><verse number="8" style="v" sid="JER 7:8"/>እስን ገሩ ዱቢ ሶባ ከን ፋይዳ ህንቀብኔ አመነቻ ጅርቱ።<verse eid="JER 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 7:9"/>“ ‘እስን ሀተኒ ነመ አጄፍተኒ፣ ሰጋገልተኒ፣ ሶባን ከከተኒ፣ በኣሊፍ እጣነ ኣርስተኒ፣ ዋቆተ ህንቤክን ዱካ ቡተኒ፣ <verse eid="JER 7:9"/><verse number="10" style="v" sid="JER 7:10"/>ኤርገሲ ዹፍተኒ መነ መቃኮቲን ዋመሙ ከነ ኬሰት ፉለኮ ዻበተኒ፣ ኡቱመ አመዩ ወንቶተ ጅብሲሶ ከኔን ሁንደ ሆጄቻ ጅርተኑ፣ “ኑ ኬሳ ህንቀብኑ” ጄቱ? <verse eid="JER 7:10"/><verse number="11" style="v" sid="JER 7:11"/>መን መቃኮቲን ዋመሜ ኩን ሆልቀ ሳምቶታ እስኒፍ ተኤ? አን ገሩ ዋን ከነ ኤርጌረ! ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 7:12"/>“ ‘ሜ ገረ ሺሎ እዶ አን ጀልቀበት እዶ ጅሬኘ መቃኮቲፍ ጎዸዼ ሰና ዸቃቲ ዋን አን ሰበቢ ሀምነ ሰበኮ እስራኤሊፍ እሼ ጎዼ እላላ። <verse eid="JER 7:12"/><verse number="13" style="v" sid="JER 7:13"/><char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ ዬሮ እስን ዋን ከነ ሁንደ ጎተንት፣ አን አሙማ አመ እስንት ዱበዼረ፤ እስን ገሩ ነ ህንዸጌፈትኔ። አን እስነን ዋሜ፤ እስን ገሩ ህንአዋትኔ። <verse eid="JER 7:13"/><verse number="14" style="v" sid="JER 7:14"/>ከናፉ አን ዋነን ሺሎት ፍዴ ሰነ አመ መነ መቃኮቲን ዋመሙ፣ መነ ቁልቁሉማ ከን እስን አመነተን፣ እዶ አን እስኒፊ አቦቲኬሰኒፍ ኬኔ ከነትስ ነንፍደ። <verse eid="JER 7:14"/><verse number="15" style="v" sid="JER 7:15"/>አን አኩመን ኦቦሎተኬሰን ጄቹንስ ሰበ ኤፍሬም ሁንደ ፉለኮ ዱራ አርኤ ሰነ እስኒንስ ነንአርአ።’<verse eid="JER 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 7:16"/>“ከናፉ አት ሰበ ከናፍ ህንከዸትን፤ ዮካን ዋኤሳኒቲፍ ህንቦእን ዮካን ዋመተ ህንዽኤስን፤ አን ስ ህንገኡቲ ነ ህንከዸትን። <verse eid="JER 7:16"/><verse number="17" style="v" sid="JER 7:17"/>አት ዋን እሳን መጋላወን ይሁዳ ኬሰቲፊ ዳንዲወን ዬሩሳሌምረት ሆጄተን ህንአርግቱ? <verse eid="JER 7:17"/><verse number="18" style="v" sid="JER 7:18"/>እጆሌን ቆራን ፉናኑ፤ አቦቲን እብደ ቀብሲሱ፤ ዱበርቶትንሞ ሞትቲ ሰሚቲፍ ኬኪ ቶልቹፍ ቡኮ ቡኬሱ። እሳን ዼከምሳፍ ነ ከካሱፍ ዋቆተ ብራቲፍ ዽባዩ ዽባፈቱ። <verse eid="JER 7:18"/><verse number="19" style="v" sid="JER 7:19"/>ገሩ ከን እሳን ዼከምሳፍ ከካሰን አና? ጄዸ <char style="nd">ዋቀዮ</char>። እሳን ኦፉመ ሚዸኒ ቃነአን ምቲ?<verse eid="JER 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 7:20"/>“ ‘ከናፉ <char style="nd">ዋቀዮ</char> ጎፍታን አከነ ጄዸ፦ ኣሪፊ ዼከምስኮ እዶ ከነረት፣ ነማፊ ሆሪረት፣ ሙኬን ዲዳቲፊ ዋን ለፍት ባፍቱረት ንዸንገለአ፤ እን እኑመ ቦበአ መሌ ህንዻሙ።<verse eid="JER 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 7:21"/>“ ‘<char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል አከነ ጄዸ፦ ኣርሳኬሰን ከን ጉበሙ ቀልመኬሰንት ደበላቲ ፎን ኛዻ! <verse eid="JER 7:21"/><verse number="22" style="v" sid="JER 7:22"/>አን ዬሮን ብየ ግብጢ አቦቲኬሰን ባሴት ዋኤ ኣርሳ ጉበሙቲፊ ቀልማ እሳንት ህንዱበትኔ ዮካን እሳን ህንአጀጅኔ፤ <verse eid="JER 7:22"/><verse number="23" style="v" sid="JER 7:23"/>አን ገሩ አጀጀ ከነ እሳኒፍ ነንኬኔ፦ አናፍ አጀጀማ፤ አን ዋቀኬሰን ነንተአ፤ እስንስ ሰበኮ ንታቱ። አከ እስኒ ቶሉፍ ከራ አን እስን አጀጁ ሁንደረ ዴማ። <verse eid="JER 7:23"/><verse number="24" style="v" sid="JER 7:24"/>እሳን ገሩ ህንዸጌፈትኔ ዮካን ህንቀልቤፈትኔ፤ ቆደ ከና መተ ጀብነ ፌዺ ገራሳኒ ዱካ በአን። እሳን ዱግደ ዱበት ዴብአን መሌ ገረ ፉለ ዱራት ህንዴምኔ። <verse eid="JER 7:24"/><verse number="25" style="v" sid="JER 7:25"/>ጋፈ አቦቲንኬሰን ብየ ግብጢ በአኒ ጀልቀቤ ሀመ አማት አን ጉዩመ ጉያን፣ አሙማ አመ ተጃጅልቶተኮ ራጆተ እስኒፍ ኤርጌረ። <verse eid="JER 7:25"/><verse number="26" style="v" sid="JER 7:26"/>እሳን ገሩ ነ ህንዸጌፈትኔ ዮካን ህንቀልቤፈትኔ። እሳን መታ ጀባተኒ አቦቲሳኒ ጫላ ዋን ሀማ ሆጄተን።’<verse eid="JER 7:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 7:27"/>“ዬሮ አት ዋን ከነ ሁንደ እሳንት ህምቱ እሳን ስ ህንዸገአን፤ ዬሮ አት እሳን ዋምቱስ ስ ጀላ ህንአዋተን። <verse eid="JER 7:27"/><verse number="28" style="v" sid="JER 7:28"/>ከናፉ አከነ እሳኒን ጄዽ፤ ‘ሰብን ኩን ሰበ <char style="nd">ዋቀዮ</char> ዋቀሳቲፍ ህንአጀጀምኔ፣ ከን አደቢሳሌ ህንፉዸትኔዸ። ዹጋን በዴረ፤ አፋንሳኒ ኬሳስ ዸበሜረ።<verse eid="JER 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JER 7:29"/>“ ‘ርፌንሰ መታኬቲ ኦፍራ ጭሪ ገት፤ እዶ ኦል ከኣ ቁላት ኦል በኢ ቦእ፤ <char style="nd">ዋቀዮ</char> ዸሎተ ዼከምሰሳ ጀለ ጅሩ ከነ ቱፈቴ ገቴራቲ።<verse eid="JER 7:29"/></para>
  <para style="s1">ሱሉለ ቀልማ</para>
  <para style="p">
    <verse number="30" style="v" sid="JER 7:30"/>“ ‘ሰብን ይሁዳ ፉለኮ ዱረት ዋን ሀማ ሆጄቴረ፤ ጄዸ <char style="nd">ዋቀዮ</char>። እሳን ዋቆተሳኒ ቶልፈሞ ጅብሲሶ መነ መቃኮቲን ዋመሙ ኬሰ ዻበኒ መንቸ ጡሬሰኒሩ። <verse eid="JER 7:30"/><verse number="31" style="v" sid="JER 7:31"/>እሳን እልማኒፊ እንተለንሳኒ አችት እብዳን ጉቡፍ ጄዸኒ ሱሉለ ቤን ህኖም ኬሰት እዶ ሰገዳ ቶፌት እጃረን፤ ኩንሞ ዋን አን እሳን ህንአጀጅን ዮካን ያደኮት ህንዹፍኒዸ። <verse eid="JER 7:31"/><verse number="32" style="v" sid="JER 7:32"/>ከናፉ ቤከዻ! በር እት ነሞትን እዶ ሰናን፣ ስአች ሱሉለ ቀልማ ጄዸኒ ዋመን መሌ ቶፌት ዮካን ሱሉለ ቤን ህኖም ህንጄኔ ንዹፈ፤ እሳን ሀመ እዶን ሀንቀቱት ቶፌትት ወረ ዱአን አዋሉቲ፣ ጄዸ <char style="nd">ዋቀዮ</char>። <verse eid="JER 7:32"/><verse number="33" style="v" sid="JER 7:33"/>ሬፍ ነሞተ ከና ስምብሮተ ሰሚቲፊ ብኔንሶተ ለፋቲፍ ኛተ ተአ፤ ነምን ሶዳችሴራ እሳን አርኡ ቶኮዩ ህንጅሩ። <verse eid="JER 7:33"/><verse number="34" style="v" sid="JER 7:34"/>አን መጋላወን ይሁዳ ኬሳፊ ዳንዲወን ዬሩሳሌምራ ሰገሌ ኮልፋቲፊ ገመቹ፣ ሰገሌ ምስርቻቲፊ ምስርቲ ነንበሌሰ፤ ብየቲን ንኦንቲቲ።<verse eid="JER 7:34"/></para>
  <chapter eid="JER 7"/>
  <chapter number="8" style="c" sid="JER 8"/>
  <para style="p">
    <verse number="1" style="v" sid="JER 8:1"/>“ ‘በረ ሰነ ለፌን ሞቶታቲፊ ቆንዳልቶተ ይሁዳ፣ ለፌን ሉቦታቲፊ ራጆታ፣ ለፌን ነሞተ ዬሩሳሌም አዋለሳኒ ኬሳ ንባፈመ’ ጄዸ <char style="nd">ዋቀዮ</char>። <verse eid="JER 8:1"/><verse number="2" style="v" sid="JER 8:2"/>‘እሳን ፉለ አዱፊ ጅኣ ዱረት፣ ፉለ ጉቱማ ኡርጂወን ሰሚ ሁንዳ፣ ከኔን ጃለተኒፊ ተጃጅለኒ፣ ከኔን ፋነ ቡአኒ ጎርሰ ጋፈተኒፊ ዋቄፈተን ሰና ዱረት ንሳጥለሙ። እሳን አኩመ ኮሲ ለፈት ገተሜ ተአን መሌ ወልት ህንቀበመን ዮካን ህንአዋለመን። <verse eid="JER 8:2"/><verse number="3" style="v" sid="JER 8:3"/>ሀምባን ሰበ ሀማ ከና ሁንድ ለፈ አን እት እሳን አርኡ ሁንደት ጅሬኘረ ዱአ ፍለተ’ ጄዸ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ።<verse eid="JER 8:3"/></para>
  <para style="s1">ጩቡፊ አደቢ</para>
  <para style="p">
    <verse number="4" style="v" sid="JER 8:4"/>“አት አከነ እሳኒን ጄዽ፤ ‘<char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 8:4">“ ‘ነሞትን ዮ ኩፈን ህንከአኒ?</para>
  <para style="q2" vid="JER 8:4">ነምን ቶኮ ዮ ከራራ በዴ ህንዴብኡ?<verse eid="JER 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 8:5"/>ዮስ ሰብን ኩን ማሊፍ ከራራ ጀልአተ?</para>
  <para style="q2" vid="JER 8:5">ዬሩሳሌም ማሊፍ ዬሮ ሁንደ ከራራ ጀልአት?</para>
  <para style="q1" vid="JER 8:5">እሳን ጎዎምሳት ጭቹ፤</para>
  <para style="q2" vid="JER 8:5">ዴብኡስ ንድዱ።<verse eid="JER 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 8:6"/>አን ቀልቤፈዼ ዸጌፈዼረ፤</para>
  <para style="q2" vid="JER 8:6">እሳን ገሩ ዋን ቀጄላ ህንዱበተን።</para>
  <para style="q1" vid="JER 8:6">ነምን ቶኮዩ፣ “አን ማለን በሌሴ?” ጄዼ</para>
  <para style="q2" vid="JER 8:6">ሀምነሳራ ህንዴብኡ።</para>
  <para style="q1" vid="JER 8:6">ቶኮን ቶኮንሳኒ አኩመ ፈርደ ሎለት ጉሉፉ</para>
  <para style="q2" vid="JER 8:6">ከራ ኦፊሳኒረ ቀጄሉ።<verse eid="JER 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 8:7"/>ሁሞን ሰሚ ኬሳዩ</para>
  <para style="q2" vid="JER 8:7">ወቅቲ እሼፍ ሙርታኤ ንቤክት፤</para>
  <para style="q1" vid="JER 8:7">ጉጌን፣ ዳሎቴፊ ጩቁሊስንስ</para>
  <para style="q2" vid="JER 8:7">ዬሮ ጎዳንሰሳኒ ንኤጉ።</para>
  <para style="q1" vid="JER 8:7">ሰብንኮ ገሩ</para>
  <para style="q2" vid="JER 8:7">ሴረ <char style="nd">ዋቀዮ</char> ህንቤኩ።<verse eid="JER 8:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JER 8:8"/>“ ‘እስን አከምት፣ “ኑ ሴረ <char style="nd">ዋቀዮ</char></para>
  <para style="q2" vid="JER 8:8">ዋን ቀብኑፍ ኦጌዪዸ” ጄቹ ደንዴሱ?</para>
  <para style="q1" vid="JER 8:8">ገሩ ኩኖ፣ ቀለምን ሶባ</para>
  <para style="q2" vid="JER 8:8">ከን በሬስቶታ ሶቤ በሬሴረ።<verse eid="JER 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 8:9"/>ነሞትን ኦጌዪን ንቃኔፈሙ፤</para>
  <para style="q2" vid="JER 8:9">እሳን ነአኒ ክዮዻን ንቀበሙ፤</para>
  <para style="q1" vid="JER 8:9">እሳን ኤርገ ዱቢ <char style="nd">ዋቀዮ</char> ቱፈተኒ፣</para>
  <para style="q2" vid="JER 8:9">ኦጉማ አከሚ ቀቡሬ?<verse eid="JER 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 8:10"/>ከናፉ አን ኒቶተሳኒ ነሞተ ብራቲፍ፣</para>
  <para style="q2" vid="JER 8:10">ለፈ ቆቲሳሳኒሞ ሞአቶታፍ ነንኬነ።</para>
  <para style="q1" vid="JER 8:10">ጥናዻ ሀመ ጉዳት</para>
  <para style="q2" vid="JER 8:10">ሁንድሳኒዩ ቡኣ አርገቹፍ ገገቡ፤</para>
  <para style="q1" vid="JER 8:10">ራጆትኒፊ ሉቦትንስ አከሱመ</para>
  <para style="q2" vid="JER 8:10">ሁንድሳኒ ነመ ጎዎምሱ።<verse eid="JER 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 8:11"/>እሳን መዳ ሰበኮቲ፣</para>
  <para style="q2" vid="JER 8:11">አኩመ ዋን ጥና ቶኮት እላለኒ ወልኣኑ።</para>
  <para style="q1" vid="JER 8:11">ኡቱ ነጋን ህንጅራትንስ</para>
  <para style="q2" vid="JER 8:11">“ነጋ፣ ነጋ” ጄዹ።<verse eid="JER 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 8:12"/>እሳን አመለሳኒ ጅብሲሳ ሰነት ንቃነኡ?</para>
  <para style="q2" vid="JER 8:12">ለኪ፣ እሳን ቃኒ ቶኮዩ ህንቀበን፤</para>
  <para style="q2" vid="JER 8:12">ቃነኡን ማል አከ ተኤዩ ህንቤከን።</para>
  <para style="q1" vid="JER 8:12">ከናፉ እሳን ወረ ኩፈን ወጅን ንኩፉ፤</para>
  <para style="q2" vid="JER 8:12">ዬሮ አደበመንት ገድ ገተሙ</para>
  <para style="q2" vid="JER 8:12">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 8:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JER 8:13"/>“ ‘አን ጉቱማን ጉቱት እሳን ነንበሌሰ፤</para>
  <para style="q2" vid="JER 8:13">ጄዸ <char style="nd">ዋቀዮ</char>።</para>
  <para style="q2" vid="JER 8:13">ወይኒረት እጅ ህንአርገሙ።</para>
  <para style="q1" vid="JER 8:13">እጅ ሀርቡ ሙከ ሀርቡረት ህንአርገሙ።</para>
  <para style="q2" vid="JER 8:13">ባልሳኒስ ንጮለገ።</para>
  <para style="q1" vid="JER 8:13">ወን አን እሳኒፍ ኬኔ</para>
  <para style="q2" vid="JER 8:13">እሳንራ ንፉዸተመ።’ ”<verse eid="JER 8:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="JER 8:14"/>ኑ ማሊፍ አስ ቴኘ?</para>
  <para style="q2" vid="JER 8:14">ወልት ቀበማ!</para>
  <para style="q1" vid="JER 8:14">ኮታ ገረ መጋላወን</para>
  <para style="q2" vid="JER 8:14">ደላ ጀባ ቀበኒት በቀትኔ አችት ሃዹምኑ!</para>
  <para style="q1" vid="JER 8:14">ዋን ኑ ጩቡ እሰት ሆጄትኔፍ</para>
  <para style="q2" vid="JER 8:14">
    <char style="nd">ዋቀዮ</char> ዋቅንኬኘ በዲሰት <optbreak/> ደበርሴ ኑ ኬኔራቲ፤</para>
  <para style="q2" vid="JER 8:14">አከ ዹግኑፍስ ብሻን ሱማኣ ኑ ኬኔረ።<verse eid="JER 8:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 8:15"/>ኑ ነጋ አብደትኔ፤</para>
  <para style="q2" vid="JER 8:15">ገሩ ወን ጋሪን ቶኮዩ ህንዹፍኔ፤</para>
  <para style="q1" vid="JER 8:15">ኑ ዬሮ ፈይና አብደትኔ፤</para>
  <para style="q2" vid="JER 8:15">ገሩ ጎሊ ቆፈቱ ቱሬ።<verse eid="JER 8:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 8:16"/>ዳን ኬሳ ኮርሱ ፈርዴን ዲናቱ ዸገአመ፤</para>
  <para style="q2" vid="JER 8:16">ጉቱን ብየቲ ህምምሱ ኮሮሚ ፈርዴንሳኒቲን ሆለት።</para>
  <para style="q1" vid="JER 8:16">እሳን ብየቲፊ ዋን እሼ ኬሰ ጅሩ ሁንደ፣</para>
  <para style="q2" vid="JER 8:16">መጋላፊ ወረ እሼ ኬሰ ጅራተን ሁንደ፣</para>
  <para style="q2" vid="JER 8:16">በሌሱፍ ዹፈኒሩ።<verse eid="JER 8:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="JER 8:17"/>“አን ኩኖ ቦፈ ሀዻ ቀቡ፣</para>
  <para style="q2" vid="JER 8:17">ቡቲ ፈልፈል ደዌሱ ህንደንዴኜ እስንት ነንኤርገ፤</para>
  <para style="q2" vid="JER 8:17">እሳንስ እስን እዱ”</para>
  <para style="q2" vid="JER 8:17">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 8:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="JER 8:18"/>ያ እሰ ገደ ኬሰት ነ ጀጀቤስቱ፣</para>
  <para style="q2" vid="JER 8:18">ኦኔንኮ ነ ኬሰት ገገብዴርት።<verse eid="JER 8:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 8:19"/>ኩኖ፣ እይ ሰበኮቲ</para>
  <para style="q2" vid="JER 8:19">ብየ ፈጎዻ ንዸገአመ፦</para>
  <para style="q1" vid="JER 8:19">“<char style="nd">ዋቀዮ</char> ጥዮን ኬሰ ህንጅሩ?</para>
  <para style="q2" vid="JER 8:19">ሞቲንሼ አች ህንጅሩ?”</para>
  <para style="b" vid="JER 8:19"/>
  <para style="q1" vid="JER 8:19">“እሳን ማሊፍ ፈኪወንሳኒቲን፣</para>
  <para style="q2" vid="JER 8:19">ዋቆተሳኒ ቶልፈሞ ብየ ኦርማቲን <optbreak/> ዼከምሳፍ ነ ከካሱ?”<verse eid="JER 8:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JER 8:20"/>“ዬሮን እት ምዻን ገልፈሙ ደርቤረ፤</para>
  <para style="q2" vid="JER 8:20">ቦንስ ሆበኤረ፤</para>
  <para style="q2" vid="JER 8:20">ኑ ገሩ ህንፈይኔ።”<verse eid="JER 8:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="JER 8:21"/>ሰብንኮ ዋን ሚዸሜፍ አንስ ሚዸሜረ፤</para>
  <para style="q2" vid="JER 8:21">አን ነንቦኤ፤ ሶዳን ጉዳንስ ነ ቀበቴ።<verse eid="JER 8:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 8:22"/>ቆርች ድበተን ግልኣድ ኬሰ ህንጅሩ?</para>
  <para style="q2" vid="JER 8:22">አባን ቆርቻ ቶኮዩ አች ህንጅሩ?</para>
  <para style="q1" vid="JER 8:22">ዮስ መዳን እንተለ ሰበኮቲ</para>
  <para style="q2" vid="JER 8:22">ማሊፍ ህንፈዩሬ?<verse eid="JER 8:22"/></para>
  <chapter eid="JER 8"/>
  <chapter number="9" style="c" sid="JER 9"/>
  <para style="q1">
    <verse number="1" style="v" sid="JER 9:1"/>አከ አን ሀልከኒ ጉያ፣</para>
  <para style="q2" vid="JER 9:1">ሰበኮ ዹሜ ሰናፍ ቦኡፍ፣</para>
  <para style="q1" vid="JER 9:1">ማሎ ኡቱ መታንኮ መደ ብሻኒ</para>
  <para style="q2" vid="JER 9:1">እጅኮሞ ቡርቃ እምማኒ ተኤ!<verse eid="JER 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 9:2"/>አን አከን ሰበኮ ዺሴ</para>
  <para style="q2" vid="JER 9:2">ብራ ፈጋዹፍ፣</para>
  <para style="q1" vid="JER 9:2">ማሎ ኡቱን ገሞጂ ኬሳ</para>
  <para style="q2" vid="JER 9:2">ለፈ ቡልቲ ከረ ዴምቶታ ቀባዼ!</para>
  <para style="q1" vid="JER 9:2">ሁንድሳኒ ሰጋገልቶተ፣</para>
  <para style="q2" vid="JER 9:2">ቱተ ሰበ ህንአመነምኔ ቶኮት።<verse eid="JER 9:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="JER 9:3"/>“እሳን ሶበ ደርበቹፍ</para>
  <para style="q2" vid="JER 9:3">አረበሳኒ አከ ጥያት ቆጴፈቱ፤</para>
  <para style="q1" vid="JER 9:3">እሳን ብየቲ ኬሰት</para>
  <para style="q2" vid="JER 9:3">ዹጋዻን ህንሞአትኔ።</para>
  <para style="q1" vid="JER 9:3">እሳን ጩቡረት ጩቡ ደበሉ፤</para>
  <para style="q2" vid="JER 9:3">አናንስ ህንቤከን”</para>
  <para style="q2" vid="JER 9:3">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 9:4"/>“ምቾተኬሰንራ ኦፍ ኤጋ፤</para>
  <para style="q2" vid="JER 9:4">ኦቦሌሰ ህንአመንና።</para>
  <para style="q1" vid="JER 9:4">ኦቦሌስ ሁንድ ጎዎምስቱዸ፣</para>
  <para style="q2" vid="JER 9:4">ምቹን ሁንድስ መቀ በሌስቱዻቲ።<verse eid="JER 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 9:5"/>ምቹን ምቹ ጎዎምሰ፤</para>
  <para style="q2" vid="JER 9:5">ነምን ቶኮዩ ዹጋ ህንዱበቱ።</para>
  <para style="q1" vid="JER 9:5">እሳን አረበሳኒ ሶበ በርሲፈተኒሩ፤</para>
  <para style="q2" vid="JER 9:5">ጩቡ ሆጄቹዻንስ ኦፍ ደዸብሲሰኒሩ።<verse eid="JER 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 9:6"/>አት ግዱ ጎዎምስቶታ ጅራተ፤</para>
  <para style="q2" vid="JER 9:6">እሳን ጎዎምሳሳኒ ኬሰት ነ ቤኩ ድደን”</para>
  <para style="q2" vid="JER 9:6">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 9:7"/>ከናፉ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 9:7">“ኩኖ፣ አን ሰበቢ ጩቡ ሰበኮቲፍ በቅሴን እሳን ቆረ፤</para>
  <para style="q2" vid="JER 9:7">አን ሰበቢ እንተለ ሰበኮቲቲፍ ማል ጎቹን ደንደአ?<verse eid="JER 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 9:8"/>አረብንሳኒ ጥየ ነመ ገላፈቱዸ፤</para>
  <para style="q2" vid="JER 9:8">እን ጎዎምሳ ዱበተ።</para>
  <para style="q1" vid="JER 9:8">ቶኮን ቶኮን ነማ ኦላሳት አፋንሳቲን ነጋ ዱበተ፤</para>
  <para style="q2" vid="JER 9:8">ገራሳ ኬሰ ገሩ ክዮ ካኣፍ።<verse eid="JER 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 9:9"/>አን ዋን ከናፍ እሳን ህንአደቡሬ?”</para>
  <para style="q2" vid="JER 9:9">ጄዸ <char style="nd">ዋቀዮ</char>።</para>
  <para style="q1" vid="JER 9:9">“አን መታንኮ ሰበ አከ ሰበ ከና፣</para>
  <para style="q2" vid="JER 9:9">ሃሎ ህንበኡሬ?”<verse eid="JER 9:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JER 9:10"/>አን ቱሉወኒፍ ገዶዴ ነንቦአ፤</para>
  <para style="q2" vid="JER 9:10">ለፈ ዼዳ ገሞጂቲፍስ ፋርሴ ነንቦአ።</para>
  <para style="q1" vid="JER 9:10">ሰበቢ እሳን ኦነኒ ሀፈኒፍ ነምን ቶኮዩ አቺን ህንደርቡ፤</para>
  <para style="q2" vid="JER 9:10">መርአቹን ሎኒስ ህንዸገአሙ።</para>
  <para style="q1" vid="JER 9:10">ስምብሮትን ሰሚ አቺ በቀተኒሩ፤</para>
  <para style="q2" vid="JER 9:10">ብኔንሶትንስ ጎዳነኒሩ።<verse eid="JER 9:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="JER 9:11"/>“አን ዬሩሳሌምን ቱላ ዋን ዲገሜቲፊ</para>
  <para style="q2" vid="JER 9:11">ቦለ ዋንጎ ነንጎዸ፤</para>
  <para style="q1" vid="JER 9:11">አከ ነምን ቶኮዩ አች ጅራቹ ህንደንዴኜፍ</para>
  <para style="q2" vid="JER 9:11">መጋላወን ይሁዳ ነንኦንሰ።”<verse eid="JER 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 9:12"/>ኦጌስ ዋን ከነ ሁበቹ ደንደኡ ኤኙ? ነምን <char style="nd">ዋቀዮን</char> ቀጄልፈሜ ዋን ከነ እብሱ ደንደኡ ኤኙ? ብየቲን ማሊፍ አኩመ ገሞጂ ነምን ቶኮዩ ኬሰ ደርቡ ህንደንዴኜ ቶኮት ዲገምቴ ኦንቴ?<verse eid="JER 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 9:13"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዼ፤ “ኩን ሰበቢ እሳን ሴረኮ ከን አን ፉለሳኒ ዱረ ካኤ ሰነ ዺሰኒፊዸ፤ እሳን አናፍ ህንአጀጀምኔ ዮካን ሴረኮ ዱካ ህንቡኔ። <verse eid="JER 9:13"/><verse number="14" style="v" sid="JER 9:14"/>ቆደ ከና መተ ጀብናን ፌዺ ገራሳኒ ዱካ ቡአን፤ አኩመ አቦቲንሳኒ እሳን በርሲሰንትስ በኣል ዱካ ቡአን።” <verse eid="JER 9:14"/><verse number="15" style="v" sid="JER 9:15"/>ከናፉ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል አከነ ጄዸ፦ “ኩኖ፣ አን አከ ሰብን ኩን ኛተ ሀዻኣ ኛቱፊ አከ እን ብሻን ሱማኣ ዹጉ ነንጎዸ። <verse eid="JER 9:15"/><verse number="16" style="v" sid="JER 9:16"/>አን ሰቦተ እሳን ዮካን አቦቲንሳኒ ህንቤክን ኬሰ እሳን ነንብትኔሰ፤ አን ሀመን ለፈራ እሳን በርበዴሱትስ ጎራዴዻን እሳን ነንአርአ።”<verse eid="JER 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 9:17"/>
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 9:17">“ሜ ቀልቤፈዻ!</para>
  <para style="q2" vid="JER 9:17">አከ ዱበርቶትን ነመ ቦስሰን ዹፈኒፍ ዋማ፤</para>
  <para style="q2" vid="JER 9:17">እሳን ኬሳ ወረ ኦጉማዻን ጫለንት <optbreak/> ነመ ኤርጋ ዋምስሳ።<verse eid="JER 9:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 9:18"/>እሳን ደፈኒ ዹፈኒ</para>
  <para style="q2" vid="JER 9:18">ሀመ እጅኬኘ እምማን ያሴ</para>
  <para style="q1" vid="JER 9:18">ብሻንስ ባሌ እጀኬኛ ኬሳ ቡርቁት</para>
  <para style="q2" vid="JER 9:18">እየኒ ኑፍ ሃቦአን።<verse eid="JER 9:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 9:19"/>ሰገሌን ቦእቻ ከን፣</para>
  <para style="q2" vid="JER 9:19">‘ኑ ሀመም በድኔረ!</para>
  <para style="q2" vid="JER 9:19">ቃኒንኬኘስ ሀመም ጉዳዸ!</para>
  <para style="q1" vid="JER 9:19">ሰበቢ መኔንኬኘ ዲገመኒፍ</para>
  <para style="q2" vid="JER 9:19">ኑ ብየኬኘ ኬሳ በኡ ቀብነ’ ጄዹ ቶኮ <optbreak/> ጥዮን ኬሳ ንዸገአመ።”<verse eid="JER 9:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JER 9:20"/>ያ ዱበርቶተ፣ ኤጋ ዱቢ <char style="nd">ዋቀዮ</char> ዸገኣ፤</para>
  <para style="q2" vid="JER 9:20">ዱቢ አፋንሳቲ በኡፍ ጉረኬሰን በነዻ።</para>
  <para style="q1" vid="JER 9:20">አከ እት ቦአን እንተለንኬሰን በርሲሳ፤</para>
  <para style="q2" vid="JER 9:20">ፋሩስ ወል በርሲሳ።<verse eid="JER 9:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 9:21"/>ዱት ፎዳኬኛን ኦል ልጤረ፤</para>
  <para style="q2" vid="JER 9:21">ደአኖወንኬኘስ ሴኔረ፤</para>
  <para style="q1" vid="JER 9:21">እንስ ዳንዲወንራ እጆሌ</para>
  <para style="q2" vid="JER 9:21">ኦብዲወን ሰባራ ደርገጎተ በሌሴረ።<verse eid="JER 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JER 9:22"/>አት አከነ ጄዽ፦ “<char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 9:22">“ ‘ሬፍ ነሞታ</para>
  <para style="q2" vid="JER 9:22">አኩመ ኮሲ ዲደት ገተሜ፣</para>
  <para style="q1" vid="JER 9:22">አኩመ ብሲ ምዻኒ ከን ነመ ሃሙ ዱባን ሀፌ</para>
  <para style="q2" vid="JER 9:22">ነመ ወልት ቀቡ ዸቤት ጭጪሰ።’ ”<verse eid="JER 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JER 9:23"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 9:23">“ኦጌስ፣ ኦጉማሳቲን ህንቦንን፤</para>
  <para style="q2" vid="JER 9:23">ዮካን ነምን ጀባን፣ ጀብነሳቲን ህንቦንን</para>
  <para style="q2" vid="JER 9:23">ዮካን ሶሬስ፣ ሶሮመሳቲን ህንቦንን፤<verse eid="JER 9:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 9:24"/>ነምን ቦኑ ገሩ፣</para>
  <para style="q2" vid="JER 9:24">አከ አን <char style="nd">ዋቀዮ</char> ገራ ነማፍ ላፉ፣</para>
  <para style="q1" vid="JER 9:24">ከን ለፈረት ሙርቲ ቀጄላፊ ቀጄሉማ ሆጄቱ ተኤ</para>
  <para style="q2" vid="JER 9:24">ሁበቴ ነ ቤኩሳቲን ሃቦኑ፤</para>
  <para style="q2" vid="JER 9:24">አን ዋን ከነት ነንገመዳቲ፣”</para>
  <para style="q2" vid="JER 9:24">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JER 9:25"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፤ “በር አን እት ወረ ፎንሳኒ ቆፋን ዸግነ ቀበመን ሁንደ አደቡ ንዹፈ፤ እሳንስ፦ <verse eid="JER 9:25"/><verse number="26" style="v" sid="JER 9:26"/>ግብጥ፣ ይሁዳ፣ ኤዶም፣ አሞን፣ ሞኣቢፊ ወረ ገሞጂ ኬሰ እዶ ፈጎ ጅራተን ሁንደ። ሰቦትን ኩኔን ሁንድ ዹጉማን ዸግነ ህንቀበምኔ፤ ገራን መነ እስራኤል ሁንዳዩ ዸግነ ህንቀበምኔ።”<verse eid="JER 9:26"/></para>
  <chapter eid="JER 9"/>
  <chapter number="10" style="c" sid="JER 10"/>
  <para style="s1">
    <char style="nd">ዋቀዮፊ</char> ዋቆተ ቶልፈሞ</para>
  <para style="r">
    <ref loc="JER 10:12-16">10፥12‑16</ref> ኩወፈ – <char style="xt"><ref loc="JER 51:15-19">ኤር 51፥15‑19</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="JER 10:1"/>ያ መነ እስራኤል፣ ዋን <char style="nd">ዋቀዮ</char> እስኒን ጄዹ ዸገኣ። <verse eid="JER 10:1"/><verse number="2" style="v" sid="JER 10:2"/><char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 10:2">“እስን ከራ ሰቦተ ኦርማ ህንበረትና፤</para>
  <para style="q2" vid="JER 10:2">ሰቦትን ኦርማ እሳን ሶዳተንዩ</para>
  <para style="q2" vid="JER 10:2">እስን መለቶወን ሰሚ ህንሶዳትና።<verse eid="JER 10:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 10:3"/>በርቴን ኡመቶታ ፋይዳ ህንቀቡ፤</para>
  <para style="q2" vid="JER 10:3">እሳን ቦሶነ ኬሳ ሙከ ሙሩ፤</para>
  <para style="q2" vid="JER 10:3">ኦጌስ ሆጂ ሀርካሞ ቆቶዻን ብፈ እት ባሰ።<verse eid="JER 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 10:4"/>እሳንስ ሜቲፊ ወርቄዻን ሚዸግሱ፤</para>
  <para style="q2" vid="JER 10:4">አከ እን ህንሶቾኔፍ</para>
  <para style="q2" vid="JER 10:4">ቡሩሳፊ ምስማራን ወልት ቀብሲሱ።<verse eid="JER 10:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 10:5"/>ዋቆንሳኒ ቶልፈሞን</para>
  <para style="q2" vid="JER 10:5">አኩመ ፈኬቲ እቲን ዋ ሶዳችሰን</para>
  <para style="q1" vid="JER 10:5">ከን ለፈ ቆቲሳ ቡቄ ኬሳ ሰነ ዱበቹ ህንደንደአን፤</para>
  <para style="q2" vid="JER 10:5">እሳን ዋን ዴሙ ህንደንዴኜፍ ባተሙ ቀቡ።</para>
  <para style="q1" vid="JER 10:5">ሰበቢ እሳን ነመ ሚዹ</para>
  <para style="q2" vid="JER 10:5">ዮካን ዋን ጋሪ ቶኮዩ ሆጄቹ ህንደንዴኜፍ</para>
  <para style="q2" vid="JER 10:5">እሳን ህንሶዳትና።”<verse eid="JER 10:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="JER 10:6"/>ያ <char style="nd">ዋቀዮ</char> ከን አከኬቲ ቶኮዩ ህንጅሩ፤</para>
  <para style="q2" vid="JER 10:6">አት ጉዳዸ፤</para>
  <para style="q2" vid="JER 10:6">መቃንኬስ ሁምነ ጉዳ ቀበ።<verse eid="JER 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 10:7"/>ያ ሞቲ ሰቦታ ኤኙቱ ስ ህንሶዳትኔ?</para>
  <para style="q2" vid="JER 10:7">ኩን ሲፍ ንመላቲ።</para>
  <para style="q1" vid="JER 10:7">ኦጌዪ ሰቦታ ሁንደ ኬሳ፣</para>
  <para style="q2" vid="JER 10:7">ሞቱሞተሳኒ ሁንደ ኬሳስ</para>
  <para style="q2" vid="JER 10:7">ከን አከኬቲ ቶኮዩ ህንጅሩ።<verse eid="JER 10:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JER 10:8"/>እሳን ሁንድኑ ቀልቢ ህንቀበን፤ ጎዎተስ፤</para>
  <para style="q2" vid="JER 10:8">እሳን ዋቆተ ቶልፈሞ ሙኬኒ ከኔን ፋይዳ ህንቀብኔን ቀጄልፈሙ።<verse eid="JER 10:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 10:9"/>ሜቲን ቱመሜ ተርሺሺ፣</para>
  <para style="q2" vid="JER 10:9">ወርቄንሞ ኡፋዚ ፍደመ።</para>
  <para style="q1" vid="JER 10:9">ወን ኦጌስ ሆጂ ሙካቲፊ ቱምቱን ወርቄ ሆጄተን፣</para>
  <para style="q2" vid="JER 10:9">ወን ሆጄቶተ ኦጉማ ቀበኒን ሆጄተመን ሁንድ</para>
  <para style="q2" vid="JER 10:9">ሀሉ ጩቁሊሳፊ ዲማ ዺልጌ ኡፍፈመኒሩ።<verse eid="JER 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 10:10"/>
    <char style="nd">ዋቀዮ</char> ገሩ ዋቀ ዹጋት፤</para>
  <para style="q2" vid="JER 10:10">እን ዋቀ ጅራታ፣ ሞቲ በረ በራት።</para>
  <para style="q1" vid="JER 10:10">ዬሮ እን ዼከሙት ለፍት ንሆለት፤</para>
  <para style="q2" vid="JER 10:10">ሰቦትንስ ዼከምሰሳ ዱረ ዻበቹ ህንደንደአን።<verse eid="JER 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 10:11"/>“እስን ዋን ከነ እሳንት ህማ፤ ‘ዋቆትን ሰሚፊ ለፈ ህንኡምን ኩኔን ለፈራፊ ሰሚ ጀላ ንበርበዳኡ።’ ”<verse eid="JER 10:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 10:12"/>ዋቅን ገሩ ሁምነሳቲን ለፈ ኡሜ፤</para>
  <para style="q2" vid="JER 10:12">ኦጉማሳቲን አዱኛ ሁንዴሴ፤</para>
  <para style="q2" vid="JER 10:12">ሁበትናሳቲንስ ሰሚወን ድሪርሴ።<verse eid="JER 10:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 10:13"/>ዮሙ እን ቀቀዌሰኡት ብሻኖትን ሰሚ ንሁርሱ፤</para>
  <para style="q2" vid="JER 10:13">እን አከ ዱሜሶን ዳሪ ለፋቲ ኦል ከአን ንጎዸ።</para>
  <para style="q1" vid="JER 10:13">እን ቦካ ወጅን በለቄ ንኤርገ፤</para>
  <para style="q2" vid="JER 10:13">መንኩሳሌሳ ኬሳሞ ቡቤ ንፍደ።<verse eid="JER 10:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="JER 10:14"/>ቶኮን ቶኮን ነማ ጎዋፊ ከን ቤኩምሰ ህንቀብኔዸ፤</para>
  <para style="q2" vid="JER 10:14">ቶኮን ቶኮን ቱምቱ ወርቄ ዋቆተ ቶልፈሞሳቲን ቃኔፈመ።</para>
  <para style="q1" vid="JER 10:14">ፈኪወን እን ቶልቹ ከን ሶባት፤</para>
  <para style="q2" vid="JER 10:14">እሳን ሀፉረ ባፈተን ኦፍ ኬሳ ህንቀበን።<verse eid="JER 10:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 10:15"/>እሳን ፋይዳ ህንቀበን፤ ሜሻ ቆሳት።</para>
  <para style="q2" vid="JER 10:15">ዬሮ አደቢንሳኒ ገኡት ንበዱ።<verse eid="JER 10:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 10:16"/>እን ቆደ ያቆብ ተኤ ሱን ገሩ አከ ወረ ከና ምት፤</para>
  <para style="q2" vid="JER 10:16">እን ኡማ ዋን ሁንዱማት፣</para>
  <para style="q1" vid="JER 10:16">እስራኤልሞ ጎሰ ዻለሳት፤</para>
  <para style="q2" vid="JER 10:16">መቃንሳስ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡዸ።<verse eid="JER 10:16"/></para>
  <para style="s1">በዲሰ ዹፋ ጅሩ</para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 10:17"/>አት ከን መርፈምቴ ጅርቱ፣</para>
  <para style="q2" vid="JER 10:17">ብየቲ ኬሳ በኡፍ ቀቤኘኬ <optbreak/> ወልት ቀበዹ።<verse eid="JER 10:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 10:18"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዻቲ፤</para>
  <para style="q2" vid="JER 10:18">“ኩኖ፣ አን አመ ወረ ብየቲ ኬሰ ጅራተን</para>
  <para style="q2" vid="JER 10:18">ፉርጉግሴ ነንባሰ፤</para>
  <para style="q1" vid="JER 10:18">አከ እሳን ዽጰተኒፍስ</para>
  <para style="q2" vid="JER 10:18">ረክነ እሳንት ነንፍደ።”<verse eid="JER 10:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="JER 10:19"/>ዋን አን ሚዸሜፍ አናፍ ወዮ!</para>
  <para style="q2" vid="JER 10:19">መዳንኮ ከን ህንፈይኔዸ!</para>
  <para style="q1" vid="JER 10:19">ተኡስ አን ኦፊኮቲን፣</para>
  <para style="q2" vid="JER 10:19">“ኩን ዹኩበኮት፤ አንስ እሰ ኦብሱን ቀበ” ነንጄዼ።<verse eid="JER 10:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 10:20"/>ዱንካንኮ ዲገሜረ፤</para>
  <para style="q2" vid="JER 10:20">ፉኞንሳ ሁንድስ ጭጭቴረ።</para>
  <para style="q1" vid="JER 10:20">እልማንኮ ነ ዺሰኒ ሶከኒሩ፤</para>
  <para style="q2" vid="JER 10:20">እሳን ህንጅረን፤ ነምን ዱንካነ ና ዻቡ፣</para>
  <para style="q2" vid="JER 10:20">ዮካን ጎልጋ ና ህዹ ቶኮዩ ህንጅሩ።<verse eid="JER 10:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 10:21"/>ትክሶትን ቀልቢ ህንቀበን፤</para>
  <para style="q2" vid="JER 10:21">
    <char style="nd">ዋቀዮንስ</char> ህንበርባደተን፤</para>
  <para style="q1" vid="JER 10:21">ከናፉ እሳን ህንምልካአን፤</para>
  <para style="q2" vid="JER 10:21">ቡሻዬንሳኒ ሁንድኑስ ብትናአኒሩ።<verse eid="JER 10:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 10:22"/>ኩኖ፣ ኦዱን፣ ራፈምን ጉዳን ቶኮ</para>
  <para style="q2" vid="JER 10:22">ብየ ካባቲ ዹፋ ጅረ!</para>
  <para style="q1" vid="JER 10:22">እንስ መጋላወን ይሁዳ ኦንሴ</para>
  <para style="q2" vid="JER 10:22">እዶ ዋንጎትን ጅራተን ጎዸ።<verse eid="JER 10:22"/></para>
  <para style="s1">ከዸትና ኤርምያስ</para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 10:23"/>ያ <char style="nd">ዋቀዮ</char>፣ አን አከ ጅሬኝ ነማ <optbreak/> ከን መታሳ ህንተእን ነንቤከ፤</para>
  <para style="q2" vid="JER 10:23">ነምን አዴምሰሳ ኦፉማን ቀጄልፈቹ ደንደኡ ህንጅሩ።<verse eid="JER 10:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 10:24"/>ያ <char style="nd">ዋቀዮ</char> ዼከምሰኬቲን ኡቱ ህንተእን፣</para>
  <para style="q2" vid="JER 10:24">ሙርቲ ቀጄላዻን ነ ስሬስ፤</para>
  <para style="q2" vid="JER 10:24">ዮ ከና አቺ አት ነ በሌስታቲ።<verse eid="JER 10:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 10:25"/>ሰቦተ ስ ህንቤክኔት</para>
  <para style="q2" vid="JER 10:25">ኡመተ መቃኬ ህንዋመኔት</para>
  <para style="q2" vid="JER 10:25">ዼከምሰኬ ዸንገላስ።</para>
  <para style="q1" vid="JER 10:25">እሳን ያቆብን ኛተኒሩቲ፤</para>
  <para style="q2" vid="JER 10:25">ጉቱማን ጉቱትስ እሰ ኛተኒ፤</para>
  <para style="q2" vid="JER 10:25">እዶ ጅሬኘሳሌ በርበዴሰኒሩ።<verse eid="JER 10:25"/></para>
  <chapter eid="JER 10"/>
  <chapter number="11" style="c" sid="JER 11"/>
  <para style="s1">ከኩን ጨቤ ጅረ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 11:1"/>ዱቢን <char style="nd">ዋቀዮ</char> ብራ ገረ ኤርምያስ ዹፌ እሰ ከናዸ፦ <verse eid="JER 11:1"/><verse number="2" style="v" sid="JER 11:2"/>“ዱቢ ከኩ ከና ዸገኣቲ ሰበ ይሁዳቲፊ ነሞተ ዬሩሳሌም ኬሰ ጅራተንት ህማ። <verse eid="JER 11:2"/><verse number="3" style="v" sid="JER 11:3"/><char style="nd">ዋቀዮ</char> ዋቅን እስራኤል አከነ ጄዸ፣ ጄዺቲ እሳንት ህም፤ ‘ነምን ዱቢ ከኩ ከናቲፍ ህንአጀጀምኔ ሃአባረሙ። <verse eid="JER 11:3"/><verse number="4" style="v" sid="JER 11:4"/>ዱቢን ኩንስ ዱቢ አን ዬሮን ብየ ግብጥ ጄቹንስ ቦለ እብዳ ከን እት ስቢለ በቅሰን ኬሳ እሳን ባሴት አቦቲኬሰን አጀጄዸ።’ አንስ አከነን ጄዼ፣ ‘ናአጀጀማቲ ዋን አን እስን አጀጁ ሁንደ ሆጄዻ፤ ዮስ እስን ሰበኮ ታቱ። አንስ ዋቀኬሰን ነንተአ። <verse eid="JER 11:4"/><verse number="5" style="v" sid="JER 11:5"/>ኤርገሲስ አን ከኩ አከ ብየ ኣነኒፊ ደሚ ኬሳ ያኡ እሳኒፍ ኬኑፍ አቦቲኬሰኒፍ ከከዼ ሰነ ፊጣን ነንባሰ፤’ ብይ ሱንስ ብየ እስን ሀርአ ዻልተኒ ጅርተኒዸ።”</para>
  <para style="p" vid="JER 11:5">አንስ “አሜን፣ ያ <char style="nd">ዋቀዮ</char>” ነንጄዼ።<verse eid="JER 11:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 11:6"/>
    <char style="nd">ዋቀዮ</char> አከነ ናን ጄዼ፤ “ዱቢ ከነ ሁንደ መጋላወን ይሁዳ ኬሰቲፊ ዳንዲወን ዬሩሳሌምረት አከነ ጄዺ ለብስ፤ ‘ዱቢ ከኩ ከና ሁንደ ዸገኣቲ ዱካ ቡኣ። <verse eid="JER 11:6"/><verse number="7" style="v" sid="JER 11:7"/>አን ጋፈን አቦቲኬሰን ብየ ግብጢቲ ባሴ ጀልቀቤ ሀመ ሀርኣት፣ “ናአጀጀማ” ጄዼ አሙማ አመ እሳን አኬከቺሳን ቱሬ። <verse eid="JER 11:7"/><verse number="8" style="v" sid="JER 11:8"/>እሳን ገሩ ህንዸጌፈትኔ ዮካን ህንቀልቤፈትኔ፤ ቆደ ከና እሳን መተ ጀብነ ገራሳኒ ሀማ ሰና ፋነ ቡአን። ከናፉ አን አባርሰ ከኩ አን አከ እሳን ዱካ ቡአኒፍ እሳን አጀጄ እሳን ገሩ ኤጉ ድደን ሰና ሁንደ እሳንተን ፍዴ።’ ”<verse eid="JER 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 11:9"/>አመስ <char style="nd">ዋቀዮ</char> አከነ ናን ጄዼ፤ “ሰበ ይሁዳቲፊ ኡመተ ዬሩሳሌም ጅራቱ ግዱት ፍንጭለ ቶኮቱ አርገሜ። <verse eid="JER 11:9"/><verse number="10" style="v" sid="JER 11:10"/>እሳን ገረ ጩቡ አቦቲሳኒ ከኔን ዱቢኮ ዸገኡ ድደን ሰናት ዴብአኒሩ። ዋቆተ ብራ ተጃጅሉዻፍ ጄዸኒስ እሳን ፋነ ቡአኒሩ። መን እስራኤሊፊ መን ይሁዳ ከኩ አን አቦቲሳኒ ወጅን ከከዼ ሰነ ጨብሰኒሩ። <verse eid="JER 11:10"/><verse number="11" style="v" sid="JER 11:11"/>ከናፉ <char style="nd">ዋቀዮ</char> አከነ ጄዸ፤ ‘አን በላ ጀር ጀላ በኡ ህንደንዴኜ ቶኮ እሳንት ነንፍደ። ዮ እሳን ነት እየተንዩ አን እሳን ህንዸገኡ። <verse eid="JER 11:11"/><verse number="12" style="v" sid="JER 11:12"/>መጋላወን ይሁዳቲፊ ነሞትን ዬሩሳሌም ዸቀኒ ዋቆተ ዱራን እጣነ ኣርሰኒፍ ሰነት እየተን፤ ዋቆትን ሱን ገሩ ዬሮ ረክን እሳንት ዹፉት እሳን ገርጋሩ ህንደንደአን። <verse eid="JER 11:12"/><verse number="13" style="v" sid="JER 11:13"/>ያ ይሁዳ አት አኩመ መጋላወን ባይኤ ቀብዱ ሰነ ዋቆተ ባይኤ ቀብደ፤ እዶወን ኣርሳ ከኔን እስን በኣል ዋቀ ቃኔሳ ሰናፍ ቆጴስተንስ አኩመ ዳንዲወን ዬሩሳሌም ባይአተን።’<verse eid="JER 11:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 11:14"/>“ሰበቢ አን ዬሮ እሳን ረክነሳኒ ኬሰት ነ ዋመተንት እሳን ህንዸጌኜፍ አት ሰበ ከናፍ ህንከዸትን፤ ዋመተ ዮካን እየተ ቶኮሌ ህንዽኤስኒፍ።<verse eid="JER 11:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 11:15"/>“ምቹንኮ ነሞተ ሄዱ ወጅን ሆጂ ሀማ ሆጄቻ</para>
  <para style="q2" vid="JER 11:15">መነ ቁልቁሉማኮ ኬሳ ማል ቀብድ?</para>
  <para style="q2" vid="JER 11:15">ፎን ቁልቁሌፈሜ አዳን ባፈሜ <optbreak/> አደቢኬ ስራ ዴብሱ ንደንደኣ?</para>
  <para style="q1" vid="JER 11:15">ጋፈ ዋን ሀማ ሆጄቱ፣</para>
  <para style="q2" vid="JER 11:15">አት ንገመዳቲ።”<verse eid="JER 11:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="JER 11:16"/>
    <char style="nd">ዋቀዮ</char> ዱራን፣ ሙከ ኤጄርሳ ለልሳ</para>
  <para style="q2" vid="JER 11:16">ሚዸጋ እጀ ቀቡ ሲን ጄዼ ቱሬ።</para>
  <para style="q1" vid="JER 11:16">አመ ገሩ ሁርሳ ቡቤ ጀባቲን</para>
  <para style="q2" vid="JER 11:16">እብደ እት ቀብሲሰ፤</para>
  <para style="q2" vid="JER 11:16">ደሜወንሳስ ንጨጨብሰሙ።<verse eid="JER 11:16"/></para>
  <para style="m">
    <verse number="17" style="v" sid="JER 11:17"/>ሰበቢ መን እስራኤሊፊ መን ይሁዳ ዋን ሀማ ሆጄተኒ፣ በኣሊፍ እጣነ ኣርሱዻን ዼከምሳፍ ነ ከካሰኒፍ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ እን ስ ዻቤ ሱን በዲሰ ስት ለብሴረ።<verse eid="JER 11:17"/></para>
  <para style="s1">መሪ ኤርምያስት መርአተሜ</para>
  <para style="p">
    <verse number="18" style="v" sid="JER 11:18"/>ሰበቢ <char style="nd">ዋቀዮ</char> መለሳኒ ናፍ እብሴፍ አን ዋን ሰነ ነንቤኬ፤ እን ዬሮ ሰነት ዋን እሳን ሆጄቻ ጅረን ነት አርግሲሴራቲ። <verse eid="JER 11:18"/><verse number="19" style="v" sid="JER 11:19"/>አንስ አኩመ ጦባላ ሆላ እሰ ገራሚ ከን ገረ ቀልማት ኦፈሙ ቶኮን ቱሬ፤ አን አከ እሳን፣</para>
  <para style="q1" vid="JER 11:19">“ኮታ ሙከ ሰናፊ እጀሳ ሃበርበዴስኑ፤</para>
  <para style="q2" vid="JER 11:19">አከ መቃንሳ ስአች ህንያደተምኔፍ፣</para>
  <para style="q2" vid="JER 11:19">ኮታ ብየ ጅራቶታ ኬሳ እሰ በሌስና” ጄቹዻን</para>
  <para style="q2" vid="JER 11:19">ነት መለተን አን ህንሁበትኔን ቱሬ።<verse eid="JER 11:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 11:20"/>ገሩ ያ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንዴሱ፣</para>
  <para style="q2" vid="JER 11:20">ከን ሙርቲ ቀጄላ ኬንቱ፣ ከን ገራፊ ያደ ነማ ቆርቱ፣</para>
  <para style="q1" vid="JER 11:20">አን ዽመኮ ስት ኬነዼራቲ</para>
  <para style="q2" vid="JER 11:20">አት አከ ሃሎ እሳንት ባቱ ነ አርግሲስ።<verse eid="JER 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 11:21"/>“ከናፉ <char style="nd">ዋቀዮ</char> አከነ ጄዼ ዋኤ ነሞተ አናቶት ወረ፣ ‘አት መቃ <char style="nd">ዋቀዮቲን</char> ራጂ ህንዱበትን ዮ ከና አቺ ሀርከኬኘት ዱተ’ ጄቹዻን ስ አጄሱ በርባደን ሰና ዱበተ። <verse eid="JER 11:21"/><verse number="22" style="v" sid="JER 11:22"/>ከናፉ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ አከነ ጄዸ፦ ‘አን ጀረ ነንአደበ። ደርገጎንሳኒ ጎራዴዻን፣ እልማንሳኒቲፊ እንተለንሳኒሞ ቤላን ንዹሙ። <verse eid="JER 11:22"/><verse number="23" style="v" sid="JER 11:23"/>ሰበቢ አን በረ እሳን እት አደበመን ኬሰ ነሞተ አናቶትት በላ ፍዱፍ እሳን ሀምባ ቶኮዩ ህንቀባተን።’ ”<verse eid="JER 11:23"/></para>
  <chapter eid="JER 11"/>
  <chapter number="12" style="c" sid="JER 12"/>
  <para style="s1">ጉንጉሚ ኤርምያስ</para>
  <para style="q1">
    <verse number="1" style="v" sid="JER 12:1"/>ያ <char style="nd">ዋቀዮ</char> ዮሙ አን እየተኮ ፉለኬ ዱረት ዽኤፈዹት</para>
  <para style="q2" vid="JER 12:1">አት ዬሮ ሁንደ ቀጄላዸ።</para>
  <para style="q1" vid="JER 12:1">ተኡዩ አን ዋኤ ቀጄሉማኬቲ ነንዱበዸ፤</para>
  <para style="q2" vid="JER 12:1">ከራን ጀልኦታ ማሊፍ ምልካአ?</para>
  <para style="q2" vid="JER 12:1">ወር ህንአመነምኔ ሁንድ ማሊፍ ነጋን ጅራቱ?<verse eid="JER 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 12:2"/>አት እሳን ዻብዴ፤ እሳንስ ህደ ገድ ፈጌፈተኒሩ፤</para>
  <para style="q2" vid="JER 12:2">ንጉደቱ፤ እጀስ ንነቀቱ።</para>
  <para style="q1" vid="JER 12:2">አት ዬሮ ሁንደ አፋንሳኒቲ ህንቡቱ፤</para>
  <para style="q2" vid="JER 12:2">ገራሳኒራ ገሩ ፈጎ ጅርተ።<verse eid="JER 12:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 12:3"/>ተኡስ ያ <char style="nd">ዋቀዮ</char> አት ነ ቤክተ፤</para>
  <para style="q2" vid="JER 12:3">ነ እላልቴስ ያደ አን ሲፍ ቀቡ ንቆርተ።</para>
  <para style="q1" vid="JER 12:3">አከ ሆላ ቀለሙፍ ዴሙት <optbreak/> ሀርክሲ እሳን ጌስ!</para>
  <para style="q2" vid="JER 12:3">ጉያ ቀልማቲፍስ ኮጳት እሳን ባስ!<verse eid="JER 12:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 12:4"/>ብየቲን ሀመ ዮሚት ቦሴ</para>
  <para style="q2" vid="JER 12:4">መርግ ድሬ ሁንድስ ጎገ?</para>
  <para style="q1" vid="JER 12:4">ሰበቢ ሀምነ ወረ ብየቲ</para>
  <para style="q2" vid="JER 12:4">ኬሰ ጅራተኒቲፊ ሰበቢ ነሞትን፣</para>
  <para style="q1" vid="JER 12:4">“እን ዋን ኑረ ገኣ ጅሩ ህንአርጉ” ጄዸኒፍ</para>
  <para style="q2" vid="JER 12:4">ሆሪፊ ስምብሮትን ዹመኒሩ።<verse eid="JER 12:4"/></para>
  <para style="s1">ዴቢ ዋቀዮ</para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 12:5"/>“አት ነሞተ ለፎ ወጅን ፊግዴ ኤርገ</para>
  <para style="q2" vid="JER 12:5">እሳን ስ ደዸብሲሰኒ፣</para>
  <para style="q2" vid="JER 12:5">ፈርዴን ወጅን አከምት ዶርጎሙ ደንዴሰሬ?</para>
  <para style="q1" vid="JER 12:5">አት ብየ ነጋ ኬሰት ኤርገ ጉፈቴ፣</para>
  <para style="q2" vid="JER 12:5">ቦሶነ ዮርዳኖስ ኬሰት አከም ታተሬ?<verse eid="JER 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 12:6"/>ኦቦሎትንኬ፣ ማቲን አባኬቲ፣</para>
  <para style="q2" vid="JER 12:6">እሳንዩ ስ ገነኒሩ፤</para>
  <para style="q2" vid="JER 12:6">እሳን ሰገሌ ኦል ፉዸተኒ ስት እዩ።</para>
  <para style="q1" vid="JER 12:6">ዮ እሳን አፋን ነጋ ስት ዱበተንዩ፣</para>
  <para style="q2" vid="JER 12:6">አት እሳን ህንአመንን።<verse eid="JER 12:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="JER 12:7"/>“አን መነኮ ዺሴረ፤</para>
  <para style="q2" vid="JER 12:7">ሀንዹራኮስ ገቴረ፤</para>
  <para style="q1" vid="JER 12:7">አን እሼ ገራንኮ ጃለቱ ሰነ</para>
  <para style="q2" vid="JER 12:7">ሀርከ ዲኖተሼት ደበርሴ ኬኔረ።<verse eid="JER 12:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 12:8"/>ሀንዹራንኮ</para>
  <para style="q2" vid="JER 12:8">አኩመ ሌንጨ ቦሶና ነት ታቴርት።</para>
  <para style="q1" vid="JER 12:8">እሼን ነት ኣዴ፤</para>
  <para style="q2" vid="JER 12:8">ከናፉ አን እሼ ጅቤረ።<verse eid="JER 12:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 12:9"/>ሀንዹራንኮ አከ አላቲ ቡሬ</para>
  <para style="q2" vid="JER 12:9">ከን አላቲወን ብራ መርሰኒ ሚዸን</para>
  <para style="q2" vid="JER 12:9">ቶኮ ነት ህንታኔ?</para>
  <para style="q1" vid="JER 12:9">ዸቃቲ ብኔንሶተ ቦሶና ሁንደ ወልት ቀባ፤</para>
  <para style="q2" vid="JER 12:9">አከ እሼ ኛተኒፍስ እሳን ፍዳ።<verse eid="JER 12:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 12:10"/>ትክሶትን ሄዱን</para>
  <para style="q2" vid="JER 12:10">እዶ ዻባ ወይኒኮቲ ንበሌሱ፤</para>
  <para style="q1" vid="JER 12:10">ቆደኮስ ንዽዺቱ፤</para>
  <para style="q2" vid="JER 12:10">ቆደ ነት ቶሉስ ንኦንሱ።<verse eid="JER 12:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 12:11"/>እሳን እሰ ኦንሱ፤</para>
  <para style="q2" vid="JER 12:11">እን ኦኔ ገረኮት እየ፤</para>
  <para style="q1" vid="JER 12:11">ነምን ዽመሳ ቀቡስ</para>
  <para style="q2" vid="JER 12:11">ዋን ህንጅሬፍ ለፍት ጉቱን ኦኔ ሀፈ።<verse eid="JER 12:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 12:12"/>ለፈ ኦል ከኣ ቁላ ገሞጂ</para>
  <para style="q2" vid="JER 12:12">ኬሳ ሁንደረ በሌስቶትን ንራምእሱ፤</para>
  <para style="q1" vid="JER 12:12">ጎራዴን <char style="nd">ዋቀዮ</char> <optbreak/> ሞጋ ብየቲ ቶኮራ</para>
  <para style="q2" vid="JER 12:12">ሀመ ሞጋ ካኒት ንፍጣቲ፤</para>
  <para style="q2" vid="JER 12:12">ነምን ቶኮዩ ህንሀፉ።<verse eid="JER 12:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 12:13"/>እሳን ቀመዲ ፈጫሱ ገሩ ቆራቲ ሃመቱ፤</para>
  <para style="q2" vid="JER 12:13">ንዸመኡ ገሩ ሆማ ህንአርገተን።</para>
  <para style="q1" vid="JER 12:13">ሰበቢ ዼከምሰ <char style="nd">ዋቀዮ</char> እሰ ጭማ ሰናቲፍ</para>
  <para style="q2" vid="JER 12:13">ምዻን ገልፈተንት ንቃነኡ።”<verse eid="JER 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 12:14"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፤ “አን ኦሎተኮ ሀሞ ከኔን ሀንዹራ አን ሰበኮ እስራኤሊፍ ኬኔ ቀበተን ሁንደ ብየሳኒ ኬሳ ነንቡቅሰ፤ መነ ይሁዳስ እሳን ግዱዻ ነንቡቅሰ። <verse eid="JER 12:14"/><verse number="15" style="v" sid="JER 12:15"/>አን ኤርገን እሳን ቡቅሴ ቦዴ ዴብኤ ነኤፊ ቶኮ ቶኮሳኒ ገረ ሀንዹራሳኒቲፊ ገረ ብየ ኦፊሳኒት ነንዴብሰ። <verse eid="JER 12:15"/><verse number="16" style="v" sid="JER 12:16"/>ዮ እሳን ሃለ ጅሬኘ ሰበኮ አከ ጋሪ በረተኒ አኩመ ዱራን ሰበኮ በኣሊን ከከቹ በርሲሰን ሰነ፣ ‘ዹጋ <char style="nd">ዋቀዮ</char> ጅራታ’ ጄቹዻን መቃኮቲን ከከተን፣ እሳን ሰበኮ ግዱት ንሁንዴፈሙ። <verse eid="JER 12:16"/><verse number="17" style="v" sid="JER 12:17"/>ገሩ ዮ ሰብን ከምዩ ና አጀጀሙ ድዴ፣ አን ጉቱማን ጉቱት እሰ ነንቡቅሰ፤ ነንበሌሰስ” ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 12:17"/></para>
  <chapter eid="JER 12"/>
  <chapter number="13" style="c" sid="JER 13"/>
  <para style="s1">ሰበተ ቁንጬ ተልባራ ሆጄተሜ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 13:1"/>
    <char style="nd">ዋቀዮ</char> አከነ ናን ጄዼ፦ “ዸቂቲ ሰበተ ቁንጬ ተልባራ ሆጄተሜ ብተዹ ሙዺኬት ህዸዹ፤ ገሩ ብሻን ህንቱቅሲስን።” <verse eid="JER 13:1"/><verse number="2" style="v" sid="JER 13:2"/>ከናፉ አን አኩመ <char style="nd">ዋቀዮ</char> ነ አጀጄት ሰበተ ብተዼ ሙዺኮት ነንህዸዼ።<verse eid="JER 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 13:3"/>ኤርገሲ ዱቢን <char style="nd">ዋቀዮ</char> አከነ ጄዼ ዬሮ ለመፋ ገረኮ ዹፌ፦ <verse eid="JER 13:3"/><verse number="4" style="v" sid="JER 13:4"/>“ሰበተ ብተቴ ሙዺት ህዸቴ ሰነ ፉዺቲ ገረ ለገ ኤፍራጢስ ዸቅ፤ ሰበተ ሰነስ በቀቃ ከታ ኬሰ ዾክስ።” <verse eid="JER 13:4"/><verse number="5" style="v" sid="JER 13:5"/>ከናፉ አን አኩመ <char style="nd">ዋቀዮ</char> ነ አጀጄት ዸቄ ሰበተ ሰነ ለገ ኤፍራጢስ ብረ ነንዾክሴ።<verse eid="JER 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 13:6"/>ቡልቲ ሄዱ ቦዴ <char style="nd">ዋቀዮ</char>፣ “አመ ገረ ኤፍራጢስ ዸቂቲ ሰበተ አን አከ አት አችት ዾክስቱ ስ አጀጄ ሰነ ፉዸዹ” ናን ጄዼ። <verse eid="JER 13:6"/><verse number="7" style="v" sid="JER 13:7"/>ከናፉ አን ገረ ኤፍራጢስ ዸቄ ሰበተ ሰነ እዶን እት ዾክሴ ቱሬ ሰና ቆቴ ባሴ ነንፉዸዼ፤ ሰበትን ሱን ገሩ ዬሮ ሰነት ጭጭቴ ጉቱማን ጉቱት ሆሮማ በኤ ቱሬ።<verse eid="JER 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 13:8"/>ኤርገሲ ዱቢን <char style="nd">ዋቀዮ</char> አከነ ጄዼ ገረኮ ዹፌ፤ <verse eid="JER 13:8"/><verse number="9" style="v" sid="JER 13:9"/>“<char style="nd">ዋቀዮ</char> አከነ ጄዸ፤ ‘አን ሃሉመ ወል ፈካቱን ኦፍ ቱሉማ ይሁዳቲፊ ኦፍ ቱሉማ ዬሩሳሌም ጉዳ ሰነ ነንበሌሰ። <verse eid="JER 13:9"/><verse number="10" style="v" sid="JER 13:10"/>ሰብን ሀማን ዱቢኮ ዸገኡ ድዴ መተ ጀብነ ገራሳ ዱካ ቡኤ ዋቆተ ብራ ተጃጅሉፊ ዋቄፈቹፍ እሳን ፋነ ቡኤ ኩን አኩመ ሰበተ ከና ንተአ፤ ጉቱማን ጉቱትስ ሆሮማ በአ። <verse eid="JER 13:10"/><verse number="11" style="v" sid="JER 13:11"/>አኩመ ሰበትን ቶኮ ሙዺ ነማት ህዸሙ ሰነ አንስ አከ እሳን ሰበ፣ መቃ፣ ገለታፊ ኡልፍነ ና ተአኒፍ ጉቱማ መነ እስራኤሊፊ ጉቱማ መነ ይሁዳ ኦፍት መጠንሴን ቱሬ። እሳን ገሩ ነ ህንዸጌፈትኔ’ ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 13:11"/></para>
  <para style="s1">ቀልቀሎ ዳዺ ወይኒ</para>
  <para style="p">
    <verse number="12" style="v" sid="JER 13:12"/>“አት አከነ እሳኒን ጄዽ፦ ‘<char style="nd">ዋቀዮ</char> ዋቅን እስራኤል አከነ ጄዸ፦ ቀልቀሎን ዳዺ ወይኒ ሁንድ ዳዺ ወይኒቲን ጉተሙ ቀበ።’ ዮ እሳን፣ ‘ኑ አከ ቀልቀሎን ዳዺ ወይኒ ሁንድ ዳዺ ወይኒቲን ጉተሙ ቀቡ ህንቤክኑ?’ ሲን ጄዸን፣ <verse eid="JER 13:12"/><verse number="13" style="v" sid="JER 13:13"/>አት አከነ ጄዺን፤ ‘<char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ አን ነሞተ ብየ ከነ ኬሰ ጅራተን ሁንደ፣ ሞቶተ ቴሶ ዳዊትረ ታአን፣ ሉቦተ፣ ራጆታፊ ወረ ዬሩሳሌም ኬሰ ጅራተን ሁንደ መቺዻን ነንጉተ። <verse eid="JER 13:13"/><verse number="14" style="v" sid="JER 13:14"/>አን ቶኮ ቶኮሳኒ ወልትን ቡሰ፤ አቦቲፊ እልማንስ አከሱመ ወልት ነንቡሰ፣ ጄዸ <char style="nd">ዋቀዮ</char>። አን እሳን ነንበሌሰ መሌ እሳኒፍ ህንነኡ ዮካን እሳኒፍ ህንአራረሙ ዮካን ገራ ህንላፉፍ።’ ”<verse eid="JER 13:14"/></para>
  <para style="s1">አኬከቺሰ ኦፍ ቱሉማረት ኬነሜ</para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 13:15"/>ዸገኣ፤ ቀልቤፈዻስ፤</para>
  <para style="q2" vid="JER 13:15">ኦፍ ህንቱልና፤</para>
  <para style="q2" vid="JER 13:15">
    <char style="nd">ዋቀዮ</char> ዱበቴራቲ።<verse eid="JER 13:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 13:16"/>ኡቱ እን ዱከነ ህንፍድን፣</para>
  <para style="q2" vid="JER 13:16">ኡቱ ሚልኬሰን</para>
  <para style="q1" vid="JER 13:16">ቱሉ ዱከናኣ ጅሩረት ህንጉፈትን</para>
  <para style="q2" vid="JER 13:16">
    <char style="nd">ዋቀዮ</char> ዋቀኬሰኒፍ ኡልፍነ ኬና።</para>
  <para style="q1" vid="JER 13:16">እስን እፈ አብደቱ፤ እን ገሩ እፈ ሰነ</para>
  <para style="q2" vid="JER 13:16">ድምምሰት ዴብሴ</para>
  <para style="q2" vid="JER 13:16">ዱከነ ዱዳት ጌደረ።<verse eid="JER 13:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 13:17"/>ዮ እስን ዸገኡ ባተን ገሩ፣</para>
  <para style="q2" vid="JER 13:17">ሰበቢ ኦፍ ቱሉማኬሰኒቲፍ</para>
  <para style="q2" vid="JER 13:17">ሉቡንኮ ዾክሳት ንቦስ፤</para>
  <para style="q1" vid="JER 13:17">ሰበቢ ቡሻዬን <char style="nd">ዋቀዮ</char> ቦጁን ፉዸመኒፍ</para>
  <para style="q2" vid="JER 13:17">እጅኮ አከ መሌ ቦሴ</para>
  <para style="q2" vid="JER 13:17">እምማን እሼ ኬሳ ንሮበ።<verse eid="JER 13:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="JER 13:18"/>ሞትቻፊ ሃዸ ሞትቻቲን፣</para>
  <para style="q2" vid="JER 13:18">“ቴሶኬሰንራ ቡኣ፤</para>
  <para style="q1" vid="JER 13:18">ጎንፎንኬሰን ኡልፍነ ቀቤስ ሱን</para>
  <para style="q2" vid="JER 13:18">መታኬሰንራ ንቡኣቲ” ጄዽ።<verse eid="JER 13:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 13:19"/>መጋላወን ኔጌብ ንጩፈሙ፤</para>
  <para style="q2" vid="JER 13:19">ነምን እሳን በኑ ቶኮዩ ህንጅሩ።</para>
  <para style="q1" vid="JER 13:19">ይሁዳን ሁንድ ንቦጅአምት፤</para>
  <para style="q2" vid="JER 13:19">ጉቱማን ጉቱትስ ብያ ፉዸተምት።<verse eid="JER 13:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JER 13:20"/>እጀኬሰን ኦል ፉዸዻቲ</para>
  <para style="q2" vid="JER 13:20">ወረ ገመ ካባቲ ዹፋ ጅረን እላላ።</para>
  <para style="q1" vid="JER 13:20">ቡሻዬን እማና ስት ኬነመን፣</para>
  <para style="q2" vid="JER 13:20">ሆሎትን አት እቲን ቦንቴ ሱን ኤሰ ጅሩ?<verse eid="JER 13:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 13:21"/>ዮሙ <char style="nd">ዋቀዮ</char> ወረ አት አከ እሳን ምቾተ ሲፍ ተአኒፍ ሌንጅፍቴ ሰነ</para>
  <para style="q2" vid="JER 13:21">ስረት ሙዱት አት ማል ጄተ?</para>
  <para style="q1" vid="JER 13:21">አኩመ ዱበርቲ ጭኒንስፈቱ ቶኮ</para>
  <para style="q2" vid="JER 13:21">ዽጵን ስ ህንቀቡ?<verse eid="JER 13:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 13:22"/>ዮ አት፣ “ወን ኩን ማሊፍ ነት ዹፌ?”</para>
  <para style="q2" vid="JER 13:22">ጄቴ ኦፍ ጋፈቴ</para>
  <para style="q1" vid="JER 13:22">ወን ወንደቦንኬ ስራ ሙልቀሜ</para>
  <para style="q2" vid="JER 13:22">ዸግንኬ ሰልጵፈሜፍ</para>
  <para style="q2" vid="JER 13:22">ሰበቢ ጩቡኬ ባይኤ ሰናቲፍ።<verse eid="JER 13:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 13:23"/>ነምን እቶጵያ ቶኮ ብፈሳ</para>
  <para style="q2" vid="JER 13:23">ዮካን ቄረንስ ቡቡርነሳ ጌደሩ ንደንደኣ?</para>
  <para style="q1" vid="JER 13:23">እስን ወር ሀምነ ሆጄቹ በረተንስ</para>
  <para style="q2" vid="JER 13:23">ዋን ጋሪ ሆጄቹ ህንደንዴሰን።<verse eid="JER 13:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="JER 13:24"/>“አኩመ ቡቤን ገሞጂ ሀበቂ ብትኔሱ ሰነ</para>
  <para style="q2" vid="JER 13:24">አንስ እስን ነንብትኔሰ።<verse eid="JER 13:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 13:25"/>ሰበቢ አት ነ እራንፈቴ</para>
  <para style="q2" vid="JER 13:25">ዋቆተ ሶባ አመነቴፍ፣</para>
  <para style="q1" vid="JER 13:25">ኩን እጣኬ፣ ቆደ አን ሲፍ ሰፈሬዸ”</para>
  <para style="q2" vid="JER 13:25">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 13:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JER 13:26"/>“አከ ቃኒንኬ ሙልአቱፍ</para>
  <para style="q2" vid="JER 13:26">አን ወንደቦኬ ፉለኬት ኦል ነንሶቆለ።<verse eid="JER 13:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 13:27"/>ኤጁማፊ ህምምሱንኬ፣</para>
  <para style="q2" vid="JER 13:27">ሰጋገሉማንኬ ከን ቃኒ ህንቀብኔ ሱንስ ንሙልአተ!</para>
  <para style="q1" vid="JER 13:27">አን ሆጂኬ ጅብሲሳ ሰነ</para>
  <para style="q2" vid="JER 13:27">ጋረንራፊ በኬ ኬሰት አርጌረ።</para>
  <para style="q1" vid="JER 13:27">ያ ዬሩሳሌም፣ ሲፍ ወዮ!</para>
  <para style="q2" vid="JER 13:27">አት ሀመ ዮሚት ጡሮፍቴ ሀፍተ?”<verse eid="JER 13:27"/></para>
  <chapter eid="JER 13"/>
  <chapter number="14" style="c" sid="JER 14"/>
  <para style="s1">ሆንጌ፣ ቤለ፣ ጎራዴ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 14:1"/>ዱቢን <char style="nd">ዋቀዮ</char> ዋኤ ሆንጌ አከነ ጄዼ ገረ ኤርምያስ ዹፌ፦<verse eid="JER 14:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 14:2"/>“ይሁዳን ንቦስ፤</para>
  <para style="q2" vid="JER 14:2">መጋላወንሼስ ገድ ዴብኣ ጅሩ፤</para>
  <para style="q1" vid="JER 14:2">እሳን ብየቲዻፍ ንወዋቱ፤</para>
  <para style="q2" vid="JER 14:2">እይ ቶኮስ ዬሩሳሌሚ ዸገአማ ጅረ።<verse eid="JER 14:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 14:3"/>ነሞትን ጉርጉዶትን ሆጄቶተሳኒ ብሻን ወራቡፍ ኤርገቱ፤</para>
  <para style="q2" vid="JER 14:3">እሳንስ ገረ ቦለ ብሻኒ ዸቁ፤</para>
  <para style="q2" vid="JER 14:3">ገሩ ብሻን ህንአርገተን።</para>
  <para style="q1" vid="JER 14:3">እሳን ኦኮቴሳኒ ዱዋ ቀበተኒ ዴብኡ፤</para>
  <para style="q2" vid="JER 14:3">እሳን ቃነአኒ አብዲ ኩተተኒ</para>
  <para style="q2" vid="JER 14:3">መታሳኒ ሀጉገቱ።<verse eid="JER 14:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 14:4"/>ሰበቢ ብየቲ ኬሳ</para>
  <para style="q2" vid="JER 14:4">ቦካን ዸበሜፍ ለፍት ንበበቀቅጤ፤</para>
  <para style="q1" vid="JER 14:4">ቆናን ቡልቶትንስ አብዲ ኩተተኒ</para>
  <para style="q2" vid="JER 14:4">መታሳኒ ሀጉገቱ።<verse eid="JER 14:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 14:5"/>ሰበቢ መርግ ህንጅሬፍ፣</para>
  <para style="q2" vid="JER 14:5">ቦሮፍን በኬዩ</para>
  <para style="q2" vid="JER 14:5">እልሞሼ ከን ሬፉ ዸለቴ ገቴ ዴምት።<verse eid="JER 14:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 14:6"/>ሀሮትን ዲዳ ለፈ ኦል ከኣ ቁላረ እጃጀኒ</para>
  <para style="q2" vid="JER 14:6">አኩመ ዋንጎታ አርገኑ፤</para>
  <para style="q1" vid="JER 14:6">ሰበቢ ዋን ዼደን ዸበኒፍ</para>
  <para style="q2" vid="JER 14:6">እጅሳኒ ዋ አርጉ ደዸቤ።”<verse eid="JER 14:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="JER 14:7"/>ያ <char style="nd">ዋቀዮ</char>፣ ጩቡንኬኘ ኑት ዹጋ በኡዩ</para>
  <para style="q2" vid="JER 14:7">አት መቃኬቲፍ ጄዺቲ ዋ ኑ ጎዽ።</para>
  <para style="q1" vid="JER 14:7">ዱበት ዴብኡንኬኘ ባይአቴረ፤</para>
  <para style="q2" vid="JER 14:7">ኑ ጩቡ ስት ሆጄትኔረ።<verse eid="JER 14:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 14:8"/>ያ አብዲ እስራኤል፣</para>
  <para style="q2" vid="JER 14:8">ፈይሳሼ ከን ዬሮ ረክና፣</para>
  <para style="q1" vid="JER 14:8">አት ማሊፍ አኩመ ከረ ዴምቱ ሀልከን ቶኮ ቆፈ ቡልቱ</para>
  <para style="q2" vid="JER 14:8">ብየቲ ኬሰት አኩመ ኬሱማ ታተ?<verse eid="JER 14:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 14:9"/>አት ማሊፍ አከ ነመ ዋን ጎዹ ወላሌ ቶኮ፣</para>
  <para style="q2" vid="JER 14:9">አኩመ ሎልቱ ነመ ኦልቹ ህንደንዴኜ ቶኮ ታተ?</para>
  <para style="q1" vid="JER 14:9">ያ <char style="nd">ዋቀዮ</char>፣ አት ኑ ግዱ ጅርተ፤</para>
  <para style="q2" vid="JER 14:9">ኑ መቃኬቲን ዋመምነ፤</para>
  <para style="q2" vid="JER 14:9">አት ኑ ህንገትን።<verse eid="JER 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 14:10"/>
    <char style="nd">ዋቀዮ</char> ዋኤ ሰበ ከና አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 14:10">“እሳን ጆሩ ጃለቱ፤</para>
  <para style="q2" vid="JER 14:10">ሚለሳኒ ህንእትፈተን።</para>
  <para style="q1" vid="JER 14:10">ከናፉ <char style="nd">ዋቀዮ</char> እሳንት ህንገመዱ፤</para>
  <para style="q2" vid="JER 14:10">እን አመ ሀምነሳኒ ንያደተ፤</para>
  <para style="q2" vid="JER 14:10">ጩቡሳኒቲፍስ እሳን አደበ።”<verse eid="JER 14:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 14:11"/>
    <char style="nd">ዋቀዮ</char> አከነ ናን ጄዼ፤ “አከ ሰብን ኩን ነጋን ጅራቱ ነ ህንከዸትን። <verse eid="JER 14:11"/><verse number="12" style="v" sid="JER 14:12"/>ዮ እሳን ሶመንዩ አን እየሳኒ ህንዸገኡ፤ ዮ እሳን ኣርሳ ጉበሙፊ ኣርሳ ምዻኒ ዽኤሰንዩ አን ህንፉዸዹ። ቆደ ከና አን ጎራዴዻን፣ ቤላፊ ዸእቻን እሳን ነንበሌሰ።”<verse eid="JER 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 14:13"/>አን ገሩ አከነ ነንጄዼ፤ “ወዮ ያ <char style="nd">ዋቀዮ</char> ጎፍታ፣ ራጆትን ሰበ ከናን፣ ‘እስን ጎራዴ ህንአርግተን ዮካን ህንቤሎፍተን። አን ዹጉማን ነጋ ዹመ ህንቀብኔ እዶ ከነት እስኒፍ ነንኬነ’ ጄዹ።”<verse eid="JER 14:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 14:14"/>አመሌ <char style="nd">ዋቀዮ</char> አከነ ናን ጄዼ፤ “ራጆን ሱን መቃኮቲን ሶበ ራጁ። አን እሳን ህንኤርግኔ ዮካን እሳን ህንሙድኔ ዮካን እሳንት ህንዱበትኔ። እሳን ሙልአታፊ ራጂ ሶባ፣ ዋቀ ቶልፈማ ዋቄፈቹፊ ዋን ኦፉመሳኒቲ ያደን እስንት ህሙ። <verse eid="JER 14:14"/><verse number="15" style="v" sid="JER 14:15"/>ከናፉ <char style="nd">ዋቀዮ</char> ዋኤ ራጆተ መቃሳቲን ራጀን ሰና አከነ ጄዸ፦ አን እሳን ህንኤርግኔ፤ እሳን ገሩ፣ ‘ጎራዴን ዮካን ቤል ቶኮዩ ብየ ከነ ህንቱቁ’ ጄዹ። ራጆትን ሱንዩ ጎራዴፊ ቤላን ዹሙ። <verse eid="JER 14:15"/><verse number="16" style="v" sid="JER 14:16"/>ነሞትን እሳን ራጂ ዱበተኒፍ ሱንስ ቤላፊ ጎራዴዻን ዳንዲወን ዬሩሳሌምረት ሀርጫፈሙ። ነምን እሳን ዮካን ኒቶተሳኒ፣ እልማንሳኒ ዮካን እንተለንሳኒ አዋሉ ቶኮዩ ህንጅሩ። አን በዲሰ እሳኒፍ መሉ እሳንት ነንዸንገላሳቲ።<verse eid="JER 14:16"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="17" style="v" sid="JER 14:17"/>“አከነ ጄዺ ዱቢ ከነ እሳንት ዱበዹ፦</para>
  <para style="q1" vid="JER 14:17">“ ‘እጅኮ ሀልከኒፊ ጉያ ኡቱ ገርገር</para>
  <para style="q2" vid="JER 14:17">ህንኩትን እምማን ሃሎላሱ፤</para>
  <para style="q1" vid="JER 14:17">እንተል፣ ዱርብ ቁልቁልቲን ሰበኮቲ</para>
  <para style="q2" vid="JER 14:17">አከ መሌ መዶፍቴ</para>
  <para style="q2" vid="JER 14:17">ዸእቸ ሀማዻን ዸአምቴ።<verse eid="JER 14:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 14:18"/>አን ዮን ባድያ ዸቄ፣</para>
  <para style="q2" vid="JER 14:18">ወረ ጎራዴዻን ዹመን ነንአርገ፤</para>
  <para style="q1" vid="JER 14:18">ዮን መጋላ ሴኔሞ፣</para>
  <para style="q2" vid="JER 14:18">ወረ ቤላን ዹመን ነንአርገ።</para>
  <para style="q1" vid="JER 14:18">ራጆትኒፊ ሉቦትን</para>
  <para style="q2" vid="JER 14:18">ብየ ህንቤክኔ ኬሰ ጆሩ።’ ”<verse eid="JER 14:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="JER 14:19"/>አት ይሁዳ ጉቱማን ጉቱት ገቴርታ?</para>
  <para style="q2" vid="JER 14:19">ጥዮኒንስ ንቱፈታ?</para>
  <para style="q1" vid="JER 14:19">አት ማሊፍ</para>
  <para style="q2" vid="JER 14:19">አከ ኑ ፈዩ ህንደንዴኜፍ ኑ ሚተ?</para>
  <para style="q1" vid="JER 14:19">ኑ ነጋ አብደትኔ፤</para>
  <para style="q2" vid="JER 14:19">ገሩ ወን ጋሪን ቶኮዩ ህንዹፍኔ፤</para>
  <para style="q1" vid="JER 14:19">ኑ ዬሮ ፈይና አብደትኔ፤</para>
  <para style="q2" vid="JER 14:19">ገሩ ራፈመ ቆፈቱ ጅረ።<verse eid="JER 14:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 14:20"/>ያ <char style="nd">ዋቀዮ</char>፣ ኑ ሀምነኬኛፊ</para>
  <para style="q2" vid="JER 14:20">የከ አቦቲኬኛ ንቤክነ፤</para>
  <para style="q2" vid="JER 14:20">ኑ ዹጉማን ጩቡ ስት ሆጄትኔረ።<verse eid="JER 14:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 14:21"/>አት መቃኬቲፍ ጄዺቲ ኑ ህንቱፈትን፤</para>
  <para style="q2" vid="JER 14:21">ቴሶኬ ኡልፍነ ቀቤሰ ሰነስ ህንቃኔስን።</para>
  <para style="q1" vid="JER 14:21">ከኩ ኑ ወጅን ገልቴ ሰነ ያደዹ፤</para>
  <para style="q2" vid="JER 14:21">እሰስ ህንጨብስን።<verse eid="JER 14:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 14:22"/>ዋቆተ ነሞተ ኦርማ ከኔን ፋይዳ ህንቀብኔ ሰነ ኬሳ <optbreak/> ቶኮዩ ቦካ ንሮብሳ?</para>
  <para style="q2" vid="JER 14:22">ሰሚወን መታንሳኒዩ ቲፉ ገድ ኤርጉ?</para>
  <para style="q1" vid="JER 14:22">ያ <char style="nd">ዋቀዮ</char> ዋቅንኬኘ ሱመ ምቲ?</para>
  <para style="q2" vid="JER 14:22">ከናፉ አብዲንኬኘ ሱመ፤</para>
  <para style="q2" vid="JER 14:22">ስቱ ዋን ከነ ሁንደ ሆጄታቲ።<verse eid="JER 14:22"/></para>
  <chapter eid="JER 14"/>
  <chapter number="15" style="c" sid="JER 15"/>
  <para style="p">
    <verse number="1" style="v" sid="JER 15:1"/>
    <char style="nd">ዋቀዮ</char> አከነ ናን ጄዼ፤ “ዮ ሙሴፊ ሳሙኤል ፉለኮ ዱረ ዻበተንዩ ገራንኮ ገረ ሰበ ከናት ህንዴብኡ። ፉለኮ ዱራ እሳን አርእ! እሳን ሃዴመን! <verse eid="JER 15:1"/><verse number="2" style="v" sid="JER 15:2"/>ዮ እሳን፣ ‘ኤሰ ዸቅነ?’ ጄዸኒ ስ ጋፈተንሞ አከነ ጄዺ እሳንት ህም፤ ‘<char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 15:2">“ ‘ነምን ዱኣፍ ረመደሜ ገረ ዱኣ፣</para>
  <para style="q1" vid="JER 15:2">ነምን ጎራዴዻፍ ረመደሜ ገረ ጎራዴ፣</para>
  <para style="q1" vid="JER 15:2">ነምን ቤላፍ ረመደሜ ገረ ቤላ፣</para>
  <para style="q1" vid="JER 15:2">ነምን ቦጁዻፍ ረመደሜሞ ገረ ቦጁ ዸቀ።’<verse eid="JER 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 15:3"/>“አን ዋን እሳን በሌሱ ጎሰ አፉር እሳንት ነንኤርገ” ጄዸ <char style="nd">ዋቀዮ</char>። “አከ እሳን አጄሱፍ ጎራዴ፣ አከ እሳን ሀርክሰኒፍ ሰሮተ፣ አከ እሳን ኛተኒ ፍጠኒፍሞ አላቲወን ሰሚቲፊ ብኔንሶተ ለፋ እሳንት ነንኤርገ። <verse eid="JER 15:3"/><verse number="4" style="v" sid="JER 15:4"/>አን ሰበቢ ምናሴን እልም ህስቅያስ ሞትች ይሁዳ ዬሩሳሌም ኬሰት ሆጄቴ ዋን ሰናቲፍ ፉለ ሞቱሞተ ለፈራ ሁንደ ዱረት ጅበምቶተ እሳን ነንጎዸ።<verse eid="JER 15:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 15:5"/>“ያ ዬሩሳሌም፣ ኤኙቱ ገራ ሲፍ ላፈ?</para>
  <para style="q2" vid="JER 15:5">ኤኙቱ ሲፍ ቦአ?</para>
  <para style="q2" vid="JER 15:5">ኤኙቱ ስ ዱብሱፍ ስት ጎረ?<verse eid="JER 15:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 15:6"/>አት ነ ዺፍቴርተ፤</para>
  <para style="q2" vid="JER 15:6">እቱመ ፉፍቴስ ዱበት ዴብኣ ጅርተ”</para>
  <para style="q2" vid="JER 15:6">ጄዸ <char style="nd">ዋቀዮ</char>።</para>
  <para style="q1" vid="JER 15:6">“ከናፉ አን ሀርከኮ ስት ሂጠዼ ስን በሌሰ፤</para>
  <para style="q2" vid="JER 15:6">አን ስአች ሲፍ ነኡ ህንደንደኡ።<verse eid="JER 15:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 15:7"/>አን ከረወን መጋላ ብየቲ ዱረት፣</para>
  <para style="q2" vid="JER 15:7">ቆርቢዻን ቅሌንሰት እሳን ነንኬነ።</para>
  <para style="q1" vid="JER 15:7">አን ሰበኮት ገዳፊ በዲሰ ነንፍደ፤</para>
  <para style="q2" vid="JER 15:7">እሳን ከራሳኒራ ህንዴብኔቲ።<verse eid="JER 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 15:8"/>አን ሃዾተ ህዬሳሳኒ</para>
  <para style="q2" vid="JER 15:8">ጭረቸ ገላና ጫላ ነንባይእሰ።</para>
  <para style="q1" vid="JER 15:8">አን ሃዾተ ደርገጎተሳኒት፣</para>
  <para style="q2" vid="JER 15:8">ጉዩመ ሳፋዻን <optbreak/> ዋን እሳን በሌሱ ቶኮ ነንፍደ፤</para>
  <para style="q1" vid="JER 15:8">አን ጎሊፊ ናሱ</para>
  <para style="q2" vid="JER 15:8">አኩመ ተሳ እሳንት ነንገዺሰ።<verse eid="JER 15:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 15:9"/>ሃት እልማን ቶርባ ገገብዴ</para>
  <para style="q2" vid="JER 15:9">ሀፉረ ዹማ ባፈት።</para>
  <para style="q1" vid="JER 15:9">አዱንሼ ጉዩመ አዲዻን ዺት፤</para>
  <para style="q2" vid="JER 15:9">እሼንስ ሰልጰቴ ነማ ገድ ታት።</para>
  <para style="q1" vid="JER 15:9">አን ሀምባወንሳኒ ፉለ ዲኖተሳኒ ዱረት</para>
  <para style="q2" vid="JER 15:9">ጎራዴፍ ደበርሴ ነንኬነ”</para>
  <para style="q2" vid="JER 15:9">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 15:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JER 15:10"/>ወዮ ያ ሃዸኮ፣</para>
  <para style="q2" vid="JER 15:10">ከን አነ ነመ ብየቲ ጉቱ <optbreak/> ሎሉፊ ፈልሙ ዴሴ?</para>
  <para style="q1" vid="JER 15:10">አን ህንልቄስኔ ዮካን ህንልቄፈትኔ፤</para>
  <para style="q2" vid="JER 15:10">ነምን ሁንድ ገሩ ነ አባረ።<verse eid="JER 15:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 15:11"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዼ፤</para>
  <para style="q1" vid="JER 15:11">“አን ዹጉማን ካዮ ጋሪዻፍ ስን በራረ፤</para>
  <para style="q2" vid="JER 15:11">አን ዹጉማን ዬሮ ረክናቲፊ ግድራት፣</para>
  <para style="q2" vid="JER 15:11">አከ ዲኖትንኬ ስ ከዸተን ነንጎዸ።<verse eid="JER 15:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="JER 15:12"/>“ነምን ከምዩ ስቢለ፣</para>
  <para style="q2" vid="JER 15:12">ስቢለ ካባ ዹፌ ዮካን ናሲ ጨብሱ ንደንደኣ?<verse eid="JER 15:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JER 15:13"/>“ሰበቢ ጩቡኬ ሁንደ</para>
  <para style="q2" vid="JER 15:13">ከን ብየኬ ጉቱ ኬሰ ጅሩ ሰናቲፍ</para>
  <para style="q1" vid="JER 15:13">አን በዻዹማኬቲፊ</para>
  <para style="q2" vid="JER 15:13">ቀቤኘኬ ቶሉመ ቦጁፍ ነንኬነ።<verse eid="JER 15:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 15:14"/>ሰበቢ ዼከምስኮ</para>
  <para style="q2" vid="JER 15:14">እብደ እሼ ጉቡ ቀብሲሱፍ፣</para>
  <para style="q1" vid="JER 15:14">አን ብየ አት ህንቤክኔ ኬሰት</para>
  <para style="q2" vid="JER 15:14">ዲኖተኬቲፍ ስን ገርቦምሰ።”<verse eid="JER 15:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JER 15:15"/>ያ <char style="nd">ዋቀዮ</char> ስቱ ቤከ፤</para>
  <para style="q2" vid="JER 15:15">ነ ያደዹ፤ ነ ትክስስ።</para>
  <para style="q2" vid="JER 15:15">ወረ ነ አርአተን ሃሎ ናፍ በእ።</para>
  <para style="q1" vid="JER 15:15">አት ኦብሰ ጉዳ ቀብዳቲ ነ ህንበሌስን፤</para>
  <para style="q2" vid="JER 15:15">አከ አን ሲፍ ጄዼ ቱፈተሙ ቤክ።<verse eid="JER 15:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 15:16"/>ዱቢንኬ ንአርገሜ፤ አንስ ነንኛዼ፤</para>
  <para style="q2" vid="JER 15:16">እንስ ነ ገመቺሴ፤ ገመቹ ገራኮቲስ ተኤ፤</para>
  <para style="q1" vid="JER 15:16">ያ <char style="nd">ዋቀዮ</char>፣ ጎፍታ ዋን ሁንደ ደንዴሱ፣</para>
  <para style="q2" vid="JER 15:16">አን መቃኬቲን ነንዋመማቲ።<verse eid="JER 15:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 15:17"/>አን ጎንኩማ ቱተ ፈንደለልቶታ ወጅን ህንቴኜ፤</para>
  <para style="q2" vid="JER 15:17">ጎንኩማ እሳን ወጅን ህንገመድኔ፤</para>
  <para style="q1" vid="JER 15:17">ሰበቢ ሀርክኬ ነረ ቱሬፊ</para>
  <para style="q2" vid="JER 15:17">ሰበቢ አት ኣሪዻን ነ ጉቴፍ አን ኮጳኮ ነንታኤ።<verse eid="JER 15:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 15:18"/>ረክንኮ ማሊፍ ዹመ ዸቤ?</para>
  <para style="q2" vid="JER 15:18">መዳንኮስ ማሊፍ ፈዩ ድዴ?</para>
  <para style="q1" vid="JER 15:18">አት አከ ለገ ነመ ጎዎምሱ</para>
  <para style="q2" vid="JER 15:18">አከ ቡርቃ ጎጉስ ነት ታታ?<verse eid="JER 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 15:19"/>ከናፉ <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 15:19">“ዮ አት ቀልቢ ጅጂረቴ፣</para>
  <para style="q2" vid="JER 15:19">አን አከ አት ነ ተጃጅልቱፍ ዴብሴ ስን ዻበ፤</para>
  <para style="q1" vid="JER 15:19">አት ዮ ዱቢ ፋይዳ ህንቀብኔ</para>
  <para style="q2" vid="JER 15:19">ዺፍቴ ዱቢ ፋይዳ ቀቡ ዱበቴ አፋን ናፍ ታተ።</para>
  <para style="q1" vid="JER 15:19">ሰብን ኩን ገረኬት ሃዴብኡ መሌ</para>
  <para style="q2" vid="JER 15:19">አት ገረሳኒት ዴብኡ ህንቀብዱ።<verse eid="JER 15:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 15:20"/>አን ሰበ ከናፍ ደላ ዸጋ፣</para>
  <para style="q2" vid="JER 15:20">ደላ ናሲ ከን ጀቤፈሜ እጃረሜ ስን ታስሰ፤</para>
  <para style="q1" vid="JER 15:20">እሳን ስ ሎሉ፤</para>
  <para style="q2" vid="JER 15:20">ገሩ ስ ህንሞአተን፤</para>
  <para style="q1" vid="JER 15:20">አን ስ በራሩፊ ስ ባሱፍ ስ ወጅን ጅራቲ”</para>
  <para style="q2" vid="JER 15:20">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 15:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 15:21"/>“አን ሀርከ ነሞተ ሀሞ ጀላ ስን ባሰ፤</para>
  <para style="q2" vid="JER 15:21">ሀርከ ወረ ገረ ጀቤዪ ጀላስ ስ ንፉረ።”<verse eid="JER 15:21"/></para>
  <chapter eid="JER 15"/>
  <chapter number="16" style="c" sid="JER 16"/>
  <para style="s1">ጉያ በዲሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 16:1"/>ኤርገሲ ዱቢን <char style="nd">ዋቀዮ</char> አከነ ጄዼ ገረኮ ዹፌ፦ <verse eid="JER 16:1"/><verse number="2" style="v" sid="JER 16:2"/>“አት እዶ ከነት ኒቲ ፉቴ እልማን ዮካን እንተለን ህንዸልችን።” <verse eid="JER 16:2"/><verse number="3" style="v" sid="JER 16:3"/><char style="nd">ዋቀዮ</char> ዋኤ እልማኒፊ እንተለን እዶ ከነት ዸለተኒ፣ ዋኤ ዱበርቶተ ሃዾተሳኒ ተአኒቲፊ ዋኤ ዺሮተ አቦቲሳኒ ተአኒ አከነ ጄዻቲ፦ <verse eid="JER 16:3"/><verse number="4" style="v" sid="JER 16:4"/>“እሳን ዹኩበ ነመ አጄሱን ዹሙ። እሳን አኩመ ኮሲ ለፈት ገተሜ ተኡ መሌ ቦእቸ ህንአርገተን፤ ህንአዋለመንስ። እሳን ጎራዴፊ ቤላን ዹሙ። ሬፍሳኒስ አላቲ ሰሚቲፊ ብኔንሶተ ለፋቲፍ ኛተ ተአ።”<verse eid="JER 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 16:5"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዻቲ፦ “አት መነ ቦእቻ ህንሴንን ዮካን ዸቅጤ ህንቦእን ዮካን እሳን ህንጀጀቤስን፤ አን ኤበኮ፣ ጃለለኮቲፊ ገረ ላፍነኮ ሰበ ከነራ ፉዸዼራቲ” ጄዸ <char style="nd">ዋቀዮ</char>። <verse eid="JER 16:5"/><verse number="6" style="v" sid="JER 16:6"/>“ነምን ጥናፊ ጉዳን ብየ ከነ ኬሰት ንዱአ። እሳን ህንአዋለመን ዮካን ቦእቸ ህንአርገተን፤ ነምን ቶኮዩ እሳኒፍ ጄዼ ኦፍ ህንሙርሙሩ ዮካን መታ ህንሃደቱ። <verse eid="JER 16:6"/><verse number="7" style="v" sid="JER 16:7"/>ነምን ቶኮዩ ወረ ነምን እራ ዱኤ ጀጀቤሱፍ ጄዼ ኛተ ህንጌሱፍ፤ ዮካን ነምን ቶኮዩ ነመ አባን ዮካን ሃት ጀላ ዱቴ ጀጀቤሱፍ ጄዼ ዹጋቲ ህንጌሱ።<verse eid="JER 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 16:8"/>“መነ ጭዽ ጅሩ ህንሴንን፤ ኛቹፊ ዹጉፍ ጄቴስ እሳን ወጅን ህንታእን። <verse eid="JER 16:8"/><verse number="9" style="v" sid="JER 16:9"/><char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል አከነ ጄዻቲ፦ አን እጀኬሰን ዱረቲፊ በረኬሰን ኬሰ ሰገሌ እልሌቲፊ ገመቹ፣ ሰገሌ ምስርቲቲፊ ምስርቻ እዶ ከና ነንበሌሰ።<verse eid="JER 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 16:10"/>“ዬሮ አት ዋን ከነ ሁንደ ሰበ ከነት ህምቴ እሳን፣ ‘<char style="nd">ዋቀዮ</char> ማሊፍ በዲሰ ጉዳ አከና ኑረት ለብሴ? ኑ ማል በሌስኔ? <char style="nd">ዋቀዮ</char> ዋቀኬኘትስ ጩቡ ማሊ ሆጄትኔ?’ ጄዸኒ ስ ጋፈተንት፣ <verse eid="JER 16:10"/><verse number="11" style="v" sid="JER 16:11"/>አከነ እሳኒን ጄዽ፤ ‘ኩን ሰበቢ አቦቲንኬሰን ነ ዺሰኒ ዋቆተ ካን ዱካ ቡአኒ እሳን ተጃጅለኒፊ እሳን ዋቄፈተኒፍ’ ጄዸ <char style="nd">ዋቀዮ</char>፤ ‘እሳን ነ ዺሰን፤ ሴረኮስ ህንኤግኔ። <verse eid="JER 16:11"/><verse number="12" style="v" sid="JER 16:12"/>እስን ገሩ አቦቲኬሰንዩ ጫላ ሀማተኒርቱ። ኩኖ ቶኮን ቶኮንኬሰን ቆደ አናፍ አጀጀሙ መተ ጀብነ ሀምነ ገራኬሰኒ ዱካ ቡተኒርቱቲ። <verse eid="JER 16:12"/><verse number="13" style="v" sid="JER 16:13"/>ከናፉ አን ብየ ከነ ኬሳ እስን ባሴ፣ ብየ እስን ዮካን አቦቲንኬሰን ህንቤክኔት እስን ነንገተ፤ እስንስ አችት ሀልከኒ ጉያ ዋቆተ ብራ ተጃጅልቱ፤ አን እስኒፍ ህንነኡቲ።’<verse eid="JER 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 16:14"/>“ተኡስ” ጄዸ <char style="nd">ዋቀዮ</char>፣ “በር እት ነሞትን ስአች፣ ‘ዹጋ <char style="nd">ዋቀዮ</char> ጅራታ፣ እሰ ብየ ግብጢ እስራኤሎተ ባሴ ሰና’ ጄዸኒ ህንከከትኔ ንዹፈ፣ <verse eid="JER 16:14"/><verse number="15" style="v" sid="JER 16:15"/>እሳን ገሩ፣ ‘ዹጋ <char style="nd">ዋቀዮ</char> ጅራታ እሰ ብየ ካባቲፊ ብዮተ እት እሳን ብትኔሴ ሁንደ ኬሳ ባሴ ፍዴ ሰና’ ንጄዹ። አን ብየ አቦቲ እሳኒቲፍ ኬኔ ሰነት እሳን ነንዴብሳቲ።<verse eid="JER 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 16:16"/>“አመሞ አን አከ እሳን ቁርጡሚ ቀብዶተ ሄዱ ፍደኒፍ ነሞተ ነንኤርገ” ጄዸ <char style="nd">ዋቀዮ</char>፤ “እሳንስ ጀረ ንቀቡ። ኤርገሲ አን አከ እሳን አደምስቶተ ሄዱ ፍደኒፍ ነሞተ ነንኤርገ፤ እሳንስ ቱሉ ሁንዳፊ ጋረ ሁንደረ፣ በቀቃ ከታ ሁንደ ኬሰስ ጀረ ንአደምሱ። <verse eid="JER 16:16"/><verse number="17" style="v" sid="JER 16:17"/>እጅኮ ከራሳኒ ሁንደረ ጅረ፤ እሳንስ ነ ዱራ ህንዾከተን፤ ጩቡንሳኒስ እጀኮ ዱራ ህንዾክፈሙ። <verse eid="JER 16:17"/><verse number="18" style="v" sid="JER 16:18"/>ሰበቢ እሳን ፈኪወንሳኒ ሉቡ ዸቤዪ ፋይዳ ህንቀብኔ ሰናን ብየኮ ጡሬሰኒ፣ ዋቆተሳኒ ጅብሲሶ ሰናንስ ሀንዹራኮ ጉተኒፍ አን ገቲ ሀምናፊ ሉቡሳኒቲፍ መሉ ሀርከ ለመ ነንባሳፍ።”<verse eid="JER 16:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 16:19"/>ያ <char style="nd">ዋቀዮ</char>፣ ጀብነኮቲፊ ደአትኖኮ፣</para>
  <para style="q2" vid="JER 16:19">ደኦኮ ከን ዬሮ ረክና፣</para>
  <para style="q1" vid="JER 16:19">ኦርሞትን ሀንዳረ ለፋቲ</para>
  <para style="q2" vid="JER 16:19">ገረኬ ዹፈኒ አከነ ጄዹ፣</para>
  <para style="q1" vid="JER 16:19">“አቦቲንኬኘ ዋቆተ ሶባ፣ ዋቆተ ቶልፈሞ ፋይዳ ህንቀብኔ</para>
  <para style="q2" vid="JER 16:19">ከኔን ዋን ጋሪ ቶኮሌ እሳኒፍ ህንጎኔ ሰነ መሌ <optbreak/> ሆማ ህንዻሌ።<verse eid="JER 16:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 16:20"/>ነሞትን ኦፊሳኒቲፍ ዋቆተ ንቶልፈቱ?</para>
  <para style="q2" vid="JER 16:20">ኤዬ፣ ገሩ እሳን ዋቆተ ምት!”<verse eid="JER 16:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="JER 16:21"/>“ከናፉ አን እሳን ነንበርሲሰ፤</para>
  <para style="q2" vid="JER 16:21">ዬሮ ከነት አን ሁምነኮፊ</para>
  <para style="q2" vid="JER 16:21">ጀብነኮ እሳን ነንበርሲሰ።</para>
  <para style="q1" vid="JER 16:21">ዮስ እሳን</para>
  <para style="q2" vid="JER 16:21">አከ መቃንኮ <char style="nd">ዋቀዮ</char> ተኤ ንቤኩ።<verse eid="JER 16:21"/></para>
  <para style="b"/>
  <chapter eid="JER 16"/>
  <chapter number="17" style="c" sid="JER 17"/>
  <para style="q1">
    <verse number="1" style="v" sid="JER 17:1"/>“ጩቡን ይሁዳ ሜሻ ስቢላቲን ቅርጠሜረ፤</para>
  <para style="q2" vid="JER 17:1">ቀረ ዸጋቲንስ</para>
  <para style="q1" vid="JER 17:1">ገበቴ ገራሳኒረቲፊ</para>
  <para style="q2" vid="JER 17:1">ጋንፈ እዶ ኣርሳሳኒረት በሬፈሜረ።<verse eid="JER 17:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 17:2"/>እጆሌንሳኒዩ</para>
  <para style="q2" vid="JER 17:2">እዶወን ኣርሳሳኒቲፊ ሲዳ ኣሼራ</para>
  <para style="q1" vid="JER 17:2">ከኔን ሙኬን ለልሳ ጭናቲፊ</para>
  <para style="q2" vid="JER 17:2">ጋረን ኦል ዼሮራ ሰነ ያደተን።<verse eid="JER 17:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 17:3"/>አን ሰበቢ ጩቡ ብየኬ ጉቴ ሰናቲፍ</para>
  <para style="q2" vid="JER 17:3">ቱሉኮ ከን ብየ ኬሳ፣</para>
  <para style="q1" vid="JER 17:3">ቀቤኘኬቲፊ በዻዹማኬ ሁንደ</para>
  <para style="q2" vid="JER 17:3">እዶ ኦል ከኣኬ ወጅን</para>
  <para style="q2" vid="JER 17:3">ደበርሴ ቦጁፍ ነንኬነ።<verse eid="JER 17:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 17:4"/>አት ዶጎጎረ መታኬቲቲን</para>
  <para style="q2" vid="JER 17:4">ዻለ አን ሲፍ ኬኔ ንዸብደ።</para>
  <para style="q1" vid="JER 17:4">አን ብየ አት ህንቤክኔ ኬሰት</para>
  <para style="q2" vid="JER 17:4">ዲኖተኬቲፍ ስን ገርቦምሰ፤</para>
  <para style="q1" vid="JER 17:4">አት ዼከምሰኮ ቀብሲፍቴርታቲ፤</para>
  <para style="q2" vid="JER 17:4">እንስ በረ በራን ንቦበአ።”<verse eid="JER 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 17:5"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 17:5">“ነምን ነመ አመነቱ፣</para>
  <para style="q2" vid="JER 17:5">ከን ጀብነ ፎኒ እሬሳ ጎዸቱ፣</para>
  <para style="q2" vid="JER 17:5">ከን ገራንሳ <char style="nd">ዋቀዮራ</char> ገረገሉ አባረማዸ።<verse eid="JER 17:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 17:6"/>እን አከ ደገለ ገሞጂ ኬሳ ተአ፤</para>
  <para style="q2" vid="JER 17:6">ዬሮ ወን ጋሪን ዹፉት ህንአርጉ።</para>
  <para style="q1" vid="JER 17:6">እን ገሞጂ ኬሳ እዶ ጎጋ</para>
  <para style="q2" vid="JER 17:6">ብየ ሶግዳ ከን ነምን ቶኮዩ ህንጅራትኔ ኬሰ ጅራተ።<verse eid="JER 17:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="JER 17:7"/>“ነምን <char style="nd">ዋቀዮን</char> አመነቱ፣</para>
  <para style="q2" vid="JER 17:7">ከን አብዲንሳስ እሱመ ተኤ ገሩ ኤብፈማዸ።<verse eid="JER 17:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 17:8"/>እን አኩመ ሙከ ቀርቀረ ብሻኒ ዻበሜ፣</para>
  <para style="q2" vid="JER 17:8">ከን ህደሳ ኤዴደ ለጋረ ያፈቱ ተአ።</para>
  <para style="q1" vid="JER 17:8">ዮሙ ሆእ ዹፉ ህንሶዳቱ፤</para>
  <para style="q2" vid="JER 17:8">ባልሳ ዬሮ ሁንደ ለልሳዸ።</para>
  <para style="q1" vid="JER 17:8">ሙክን ሱን በረ ሆንጌሌ ህንያደኡ፤</para>
  <para style="q2" vid="JER 17:8">እጀ ነቀቹስ ህንዺሱ።”<verse eid="JER 17:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="JER 17:9"/>ገራን ነማ ዋን ሁንደ ጫላ ሀጤዸ፤</para>
  <para style="q2" vid="JER 17:9">ገርመሌስ ሀማዸ።</para>
  <para style="q2" vid="JER 17:9">ኤኙቱ እሰ ሁበቹ ደንደአ?<verse eid="JER 17:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JER 17:10"/>“አን <char style="nd">ዋቀዮ</char> ነመ ሁንዳፍ አኩመ አመለሳት፣</para>
  <para style="q2" vid="JER 17:10">አኩመ ዋን ሆጂሳቲፍ መሉት</para>
  <para style="q1" vid="JER 17:10">ገቲ እሳፍ ኬኑፍ ገራሳ ነንሰከተአ፤</para>
  <para style="q2" vid="JER 17:10">ቀልቢሳስ ነንቆረ።”<verse eid="JER 17:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="JER 17:11"/>ነምን ከራ ህንመሌን በዻዹማ ወልት ቀበቱ</para>
  <para style="q2" vid="JER 17:11">አኩመ ጎጎሪ ሀንቃቁ ህንሀንቃቅን ሀመቱት።</para>
  <para style="q1" vid="JER 17:11">ወለካ ኡሙሪሳት በዻዹማን ሱን እሰ ዺሴ በደ፤</para>
  <para style="q2" vid="JER 17:11">ዹመረትስ ጎዋ ተኡንሳ ንምርከኔፈመ።<verse eid="JER 17:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="JER 17:12"/>ቴሶን ኡልፍነ ቀቤስ ዱሩማ ጀልቀቤ ኦል ኦል ጄዹ ሱን፣</para>
  <para style="q2" vid="JER 17:12">እዶ ቁልቁሉማኬኛት።<verse eid="JER 17:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 17:13"/>ያ <char style="nd">ዋቀዮ</char>፣ አብዲ እስራኤል፣</para>
  <para style="q2" vid="JER 17:13">ወር ስ ዺሰን ሁንድ ንቃኔፈሙ።</para>
  <para style="q1" vid="JER 17:13">ወር ስራ ገረገለን ብዮ ኬሰት ገልሜፈመኒሩ፤</para>
  <para style="q2" vid="JER 17:13">እሳን <char style="nd">ዋቀዮን</char></para>
  <para style="q2" vid="JER 17:13">ቡርቃ ብሻን ጅሬኛ ዺሰኒሩቲ።<verse eid="JER 17:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="JER 17:14"/>ያ <char style="nd">ዋቀዮ</char> ነ ፈይስ፤ አንስ ነንፈያ፤</para>
  <para style="q2" vid="JER 17:14">ነ ኦልች፣ አንስ ነንኦልፈመ፤</para>
  <para style="q2" vid="JER 17:14">ከን አን ጀጀዹ ሱማቲ።<verse eid="JER 17:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 17:15"/>እሳን እቱመ ፉፈኒ፣</para>
  <para style="q2" vid="JER 17:15">“ዱቢን <char style="nd">ዋቀዮ</char> ኤሰ ጅረ?</para>
  <para style="q2" vid="JER 17:15">ሜ አመ ሃራወተሙ!” ናን ጄዹ።<verse eid="JER 17:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 17:16"/>አን ትክሴ ተኤ ስ ተጃጅሉራ ዱበት ህንዴብኔ፤</para>
  <para style="q2" vid="JER 17:16">አት አከ አን ጉያ በዲሳ ህንሀውኔ ንቤክተ።</para>
  <para style="q2" vid="JER 17:16">ወን አፋንኮቲ በኡ ፉሉመኬ ዱረ ጅረ።<verse eid="JER 17:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 17:17"/>አት ነ ህንርፈቺስን፤</para>
  <para style="q2" vid="JER 17:17">ጉያ በዲሳት አት ደኦኮት።<verse eid="JER 17:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 17:18"/>ወር ነ አደምሰን ሃቃኔፈመን፤</para>
  <para style="q2" vid="JER 17:18">አነ ገሩ ቃኒራ ነ ኦልች፤</para>
  <para style="q1" vid="JER 17:18">እሳን ሃርፈተን፤</para>
  <para style="q2" vid="JER 17:18">አነ ገሩ ርፋቲራ ነ ኤግ።</para>
  <para style="q1" vid="JER 17:18">ጉያ በዲሳ እሳንት ፍድ፤</para>
  <para style="q2" vid="JER 17:18">በዲሰ ደቻቲን እሳን በሌስ።<verse eid="JER 17:18"/></para>
  <para style="s1">ሰንበተ ከበጁ</para>
  <para style="p">
    <verse number="19" style="v" sid="JER 17:19"/>
    <char style="nd">ዋቀዮ</char> አከነ ናን ጄዼ፦ “ዸቂቲ ከረ ኡመታ ከራ ሞቶትን ይሁዳ እቲን ሴነኒ በአን ዱረ ዻበዹ፤ አከሱመስ ከረወን ዬሩሳሌም ካን ሁንደ ዱረ ዻበዹ። <verse eid="JER 17:19"/><verse number="20" style="v" sid="JER 17:20"/>አከነስ እሳኒን ጄዽ፤ ‘ያ ሞቶተ ይሁዳ፣ ሰብን ይሁዳ ሁንዲፊ ነሞትን ዬሩሳሌም ኬሰ ጅራተን ከኔን ከረ ከናን ኦል ገልተን ሁንድ ዱቢ <char style="nd">ዋቀዮ</char> ዸገኣ። <verse eid="JER 17:20"/><verse number="21" style="v" sid="JER 17:21"/><char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ አከ ጉያ ሰንበታቲን በኣ ህንባትኔ ዮካን ከረወን ዬሩሳሌሚን ኦል ህንገልችኔ ኦፍ ኤገዻ። <verse eid="JER 17:21"/><verse number="22" style="v" sid="JER 17:22"/>አኩመ አን አቦቲኬሰን አጀጄት ጉያ ሰንበታ ከበጃ መሌ ጉያ ሰንበታቲን መነኬሰኒ በኣ ገድ ህንባስና ዮካን ሆጂ ከምዩ ህንሆጄትና። <verse eid="JER 17:22"/><verse number="23" style="v" sid="JER 17:23"/>ተኡስ እሳን ህንዸጌፈትኔ ዮካን ህንቀልቤፈትኔ፤ ገሩ አከ ህንዸጌኜፊ አከ ቀጄልፈመ ህንፉዸኔፍ መታ ጀባተን። <verse eid="JER 17:23"/><verse number="24" style="v" sid="JER 17:24"/><char style="nd">ዋቀዮ</char> አከነ ጄዸ፤ ዮ እስን ነ ዸጌሰኒ ጉያ ሰንበታቲን በኣ ቶኮሌ ከረወን መጋላ ከናቲን ኦል ገልቹ ዺፍተኒ ቆደ ከና ጋፈስ ሆጂ ከምዩ ሆጄቹ ዺሱዻን ጉያ ሰንበታ አዳን ባፍተኒ ኤግደን፣ <verse eid="JER 17:24"/><verse number="25" style="v" sid="JER 17:25"/>ሞቶትን ቴሶ ዳዊትረ ታአን ቆንዳልቶተሳኒ ወጅን ከረወን መጋላ ከናቲን ኦል ሴኑ። እሳንስ ቆንዳልቶተሳኒ ወጅን ጋሪወኒፊ ፈርዴን ያበተኒ ነሞተ ይሁዳቲፊ ወረ ዬሩሳሌም ኬሰ ጅራተን ወጅን ንዹፉ፤ መጋላን ኩንስ መጋላ ነምን በረ በራን ኬሰ ጅራቱ ንተአ። <verse eid="JER 17:25"/><verse number="26" style="v" sid="JER 17:26"/>ነሞትንስ መጋላወን ይሁዳቲፊ ገንዶተ ናኖ ዬሩሳሌሚቲ፣ ብየ ቤንያሚቲፊ ብየ ጋረ ኬሳቲ፣ ብየ ጋራቲፊ ኔጌቢ ኣርሳ ጉበሙፊ ቀልመ፣ ኣርሳ ምዻኒ፣ እጣናፊ ኣርሳ ገለታ ፍደኒ ገረ መነ <char style="nd">ዋቀዮ</char> ንዹፉ። <verse eid="JER 17:26"/><verse number="27" style="v" sid="JER 17:27"/>ዮ እስን ጉያ ሰንበታ አዳን ባፍተኒ ኤጉፍ ጄተኒ ጉያ ሰንበታቲን በኣ ቶኮዩ ባተኒ ከረወን ዬሩሳሌሚን ኦል ሴኑ ዺሱዻን አናፍ አጀጀሙ ባተን ገሩ አን እብደ ህንዻምኔ ቶኮ ከረወን ዬሩሳሌምት ነንቀብሲሰ፤ እብድ ሱንስ ደአኖወን ዬሩሳሌም ጉቤ በርበዴሰ።’ ”<verse eid="JER 17:27"/></para>
  <chapter eid="JER 17"/>
  <chapter number="18" style="c" sid="JER 18"/>
  <para style="s1">መነ ነምቸ ሱጴ ዸኡ ቶኮት</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 18:1"/>ዱቢን <char style="nd">ዋቀዮ</char> ብራ ገረ ኤርምያስ ዹፌ እሰ ከናዸ፦ <verse eid="JER 18:1"/><verse number="2" style="v" sid="JER 18:2"/>“ከኢቲ ገረ መነ ነምቸ ሱጴ ዸኡ ሰና ዸቅ። አንስ አችት ዱቢኮ ስት ነንህመ።” <verse eid="JER 18:2"/><verse number="3" style="v" sid="JER 18:3"/>ከናፉ አን ገረ መነ ነምቸ ሱጴ ዸኡ ሰናት ገድ ነንቡኤ፤ እንስ ጌንጎረት ዋ ሆጄቻ ቱሬ። <verse eid="JER 18:3"/><verse number="4" style="v" sid="JER 18:4"/>ኦኮቴን እን ሱጴራ ሆጄቻ ቱሬ ሱን ገሩ ሀርከሳት ፈሸላኤ፤ ከናፉ ነምች ሱጴ ዸኡ ሱን አኩመ እት ቶሌት ሱጴ ሰናን ኦኮቴ ከን ብራ ሆጄቴ።<verse eid="JER 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 18:5"/>ኤርገሲ ዱቢን <char style="nd">ዋቀዮ</char> አከነ ጄዼ ገረኮ ዹፌ፦ <verse eid="JER 18:5"/><verse number="6" style="v" sid="JER 18:6"/>“ያ መነ እስራኤል፣ አንስ አኩመ ሱጴ ዾፍቱን ኩን ሆጄቱ እስን ጎቹ ህንደንደኡ?” ጄዸ <char style="nd">ዋቀዮ</char>። “ያ መነ እስራኤል፣ አኩመ ሱጴን ሀርከ ሱጴ ዾፍቱ ኬሰ ጅሩ እስንስ ሀርከኮ ኬሰ ጅርቱ። <verse eid="JER 18:6"/><verse number="7" style="v" sid="JER 18:7"/>ዬሮ አን አከ ሰብን ዮካን ሞቱማን ቶኮ ቡቅፈሙ፣ ገርገር ቆደሙፊ በርበዴፈሙ ለብሱት፣ <verse eid="JER 18:7"/><verse number="8" style="v" sid="JER 18:8"/>ዮ ሰብን አን አኬከቺሴ ሱን ሀምነሳራ ዴብኤ፣ አን ዋን ሀማ እሰት ፍዱፍ ያዴ ሰነራ ነንዴብአ። <verse eid="JER 18:8"/><verse number="9" style="v" sid="JER 18:9"/>ዮ አን ዬሮ ብራሞ አከ ሰብን ዮካን ሞቱማን ቶኮ እጃረሜ ዻበሙ ለብሴ፣ <verse eid="JER 18:9"/><verse number="10" style="v" sid="JER 18:10"/>ዮ እን ፉለኮ ዱረት ዋን ሀማ ሆጄቴ አናፍ አጀጀሙ ድዴ፣ አን ዋን ጋሪ እሳፍ ጎቹ በርባዴ ሰነ ነንዺሰ።<verse eid="JER 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 18:11"/>“ከናፉ አመ ሰበ ይሁዳቲፊ ወረ ዬሩሳሌም ኬሰ ጅራተኒን አከነ ጄዽ፤ ‘<char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ ኩኖ! አን በዲሰ እስኒፍ ቆጴሴን መለ እስንት ከሮርሳ ጅረ። ከናፉ ቶኮን ቶኮንኬሰን ከራኬሰኒፊ ሆጂኬሰን ቀጄልፈዻ።’ <verse eid="JER 18:11"/><verse number="12" style="v" sid="JER 18:12"/>እሳን ገሩ አከነ ጄዸኒ ዴቢ ኬነን፦ ‘ኩን ፋይዳ ህንቀቡ። ኑ ከሮሩመኬኛን እት ፉፍነ፤ ቶኮን ቶኮንኬኘ መተ ጀብናፊ ሀምነ ገራኬኛ ዱካ ቡነ።’ ”<verse eid="JER 18:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 18:13"/>ከናፉ <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 18:13">“ሜ ሰቦተ ኬሰ እያፈዻ፦</para>
  <para style="q2" vid="JER 18:13">ኤኙቱ ተኩማ ዋን አከና ዸገኤ ቤከ?</para>
  <para style="q1" vid="JER 18:13">እስራኤል ዱርብ ቁልቁልቲን</para>
  <para style="q2" vid="JER 18:13">ዋን ሱከኔሳ ቶኮ ሆጄቴርት።<verse eid="JER 18:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 18:14"/>ጨቢን ልባኖን</para>
  <para style="q2" vid="JER 18:14">ተኩማ ኤዴደ ከታሳራ በዴ ቤካ?</para>
  <para style="q1" vid="JER 18:14">ብሻንሳ ዲለላኣን ቡርቃ ፈጎቲ ዹፉ ሱን</para>
  <para style="q2" vid="JER 18:14">ተኩማ ጭቴ ቤካ?<verse eid="JER 18:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 18:15"/>ሰብንኮ ገሩ ነ እራንፈቴረ፤</para>
  <para style="q2" vid="JER 18:15">እሳን ዋቆተ ቶልፈሞ ፋይዳ ህንቀብኔ</para>
  <para style="q1" vid="JER 18:15">ከኔን ከራወንሳኒረቲፊ</para>
  <para style="q2" vid="JER 18:15">ዳንዲወን ዱሪረት እሳን ጉፈቺሰኒፍ <optbreak/> እጣነ ኣርሱ።</para>
  <para style="q1" vid="JER 18:15">እሳን ከራ ህንቶልፈምኔረ</para>
  <para style="q2" vid="JER 18:15">ዳንዲ ቀልኦረ እሳን ዴምስሰኒሩ።<verse eid="JER 18:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 18:16"/>ብይሳኒ ንኦነ፤</para>
  <para style="q2" vid="JER 18:16">በረ በራንስ ብየ ቆሳ ተአ፤</para>
  <para style="q1" vid="JER 18:16">ወር አቺን ደርበን ሁንድ ንነኡ፤</para>
  <para style="q2" vid="JER 18:16">መታሳኒስ ንራሱ።<verse eid="JER 18:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 18:17"/>አኩመ ቡቤ በአ ቢፍቱቲ ዹፉ፣</para>
  <para style="q2" vid="JER 18:17">አን ፉለ ዲኖተሳኒ ዱረት እሳን ነንብትኔሰ፤</para>
  <para style="q1" vid="JER 18:17">በረ በዲሰሳኒ ኬሰ፣</para>
  <para style="q2" vid="JER 18:17">አን ዱግደኮ መሌ ፉለኮ እሳንት ህንአርግሲሱ።<verse eid="JER 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 18:18"/>“ጀርስ፣ ‘ሴር ሉበ ብራ፣ ጎርስ ኦጌዪ ብራ፣ ዱቢንሞ ራጆተ ብራ ዋን ህንዸበምኔፍ ኮታ ኤርምያስት መርአትና፤ ከናፉ ኮታ ኑ አረበኬኛን እሰ ሚና፤ ዋን እን ዱበቱ ከምዩስ ህንፉዸትኑ’ ” ጄዸን።<verse eid="JER 18:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 18:19"/>ያ <char style="nd">ዋቀዮ</char>፣ ነ ዸጌፈዹ፤</para>
  <para style="q2" vid="JER 18:19">ዋን ወር ነ ህመተን ጄዸንስ ዸገእ!<verse eid="JER 18:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 18:20"/>ገቲን ዋን ጋሪ ዋን ሀማዻ?</para>
  <para style="q2" vid="JER 18:20">እሳን ገሩ ቦለ አናፍ ቆተኒሩ።</para>
  <para style="q1" vid="JER 18:20">አን አከን ዼከምሰኬ እሳንራ</para>
  <para style="q2" vid="JER 18:20">ዴብሱፍ ፉለኬ ዱረ ዻበዼ</para>
  <para style="q2" vid="JER 18:20">እዶሳኒ ቡኤ ዱበዼ ያደዹ።<verse eid="JER 18:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 18:21"/>ከናፉ አት እጆሌሳኒ ደበርሲ ቤለት ኬን፤</para>
  <para style="q2" vid="JER 18:21">ጀረሞ ደበርሲ ሁምነ ጎራዴት ኬን።</para>
  <para style="q1" vid="JER 18:21">ኒቶተሳኒ ጀላ እጆሌፊ ዽርሶትን ሃዹመን፤</para>
  <para style="q2" vid="JER 18:21">ዺሮንሳኒ ሃአጄፈመን፤</para>
  <para style="q2" vid="JER 18:21">ደርገጎንሳኒሞ ሎለ ኬሰት ጎራዴዻን ሃቀለመን።<verse eid="JER 18:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 18:22"/>ዬሮ አት አኩመ ተሳ ዌራርቶተ እሳንት ፍዱት፣</para>
  <para style="q2" vid="JER 18:22">እይ መነሳኒቲ ሃዸገአሙ፤</para>
  <para style="q1" vid="JER 18:22">እሳን ነ ቀቡፍ ቦለ ቆተኒ፣</para>
  <para style="q2" vid="JER 18:22">ሚለኮቲፍስ ክዮ ካአኒሩቲ።<verse eid="JER 18:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 18:23"/>ያ <char style="nd">ዋቀዮ</char>፣ አት ገሩ መለ እሳን ነ አጄሱፍ</para>
  <para style="q2" vid="JER 18:23">መለተን ሁንደ ንቤክተ።</para>
  <para style="q1" vid="JER 18:23">የከሳኒ ህንዺስኒፍ፤</para>
  <para style="q2" vid="JER 18:23">ዮካን ጩቡሳኒ ፉለኬ ዱራ ህንሀቅን።</para>
  <para style="q1" vid="JER 18:23">እሳን ፉለኬ ዱረት ለፈት ሃገተመን፤</para>
  <para style="q2" vid="JER 18:23">ዬሮ ዼከምቱትስ እሳን አደብ።<verse eid="JER 18:23"/></para>
  <chapter eid="JER 18"/>
  <chapter number="19" style="c" sid="JER 19"/>
  <para style="p">
    <verse number="1" style="v" sid="JER 19:1"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፤ “ዸቂቲ ሱጴ ዾፍቱራ ኦኮቴ ሱጴ ብተዹ። ማንጉዶተ ሰባቲፊ ሉቦተ ኬሳ ነሞተ ሙራሰ ፉዸዹቲ፣ <verse eid="JER 19:1"/><verse number="2" style="v" sid="JER 19:2"/>ገረ ሱሉለ ቤን ህኖምት ከን በልበለ ከረ ቅራጪ ብራ ሰነ ዸቅ። አችትስ ዱቢ አን ስት ህሙ ለብስ፤ <verse eid="JER 19:2"/><verse number="3" style="v" sid="JER 19:3"/>አከነስ ጄዽ፤ ‘ያ ሞቶተ ይሁዳቲፊ ሰበ ዬሩሳሌም ዱቢ <char style="nd">ዋቀዮ</char> ዸገኣ። <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል አከነ ጄዸ፦ ዸጌፈዻ! ኩኖ፣ አን በላ ጉረ ነመ ዋን ሰነ ዸገኡ ሁንደት ህንቶሌ ቶኮ እዶ ከነት ነንፍደ። <verse eid="JER 19:3"/><verse number="4" style="v" sid="JER 19:4"/>እሳን ነ ዺሰኒ እዶ ከነ እዶ ዋቆተ ኦርማ ጎዸኒሩቲ፤ እዶ ከነትስ ዋቆተ እሳን ዮካን አቦቲንሳኒ ዮካን ሞቶትን ይሁዳ ህንቤክኒፍ ኣርሳ ጉበሙ ዽኤሰኒሩ፤ እዶ ከነስ ዺገ ነሞተ በሌሳ ህንቀብኔቲን ጉተኒሩ። <verse eid="JER 19:4"/><verse number="5" style="v" sid="JER 19:5"/>እሳን እልማንሳኒ ኣርሳ እብዳን ጉበሙ ጎዸኒ በኣሊፍ ዽኤሱፍ እዶ ኦል ከኣ በኣሊፍ እጃረኒሩ፤ ኩንስ ዋን አን እሳን ህንአጀጅን ዮካን መቃ ህንዸእን ዮካን ያደኮ ኬሰዩ ህንቱርኒዸ። <verse eid="JER 19:5"/><verse number="6" style="v" sid="JER 19:6"/>ከናፉ ቤከዻ፤ በር እት ነሞትን እዶ ሰናን፣ ስአች ሱሉለ ቀልማ ጄዸኒ ዋሙ መሌ ቶፌት ዮካን ሱሉለ ቤን ህኖም ህንጄኔ ንዹፈ፣ ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 19:7"/>“ ‘አን እዶ ከነት ከሮረ ይሁዳቲፊ ከሮረ ዬሩሳሌም ነንዲገ፤ አከ እሳን ፉለ ዲኖተሳኒ ዱረት፣ ሀርከ ወረ ሉቡሳኒ ገላፈቹ በርባደኒት ጎራዴዻን ዹመን ነንጎዸ፤ ሬፈሳኒሞ አላቲ ሰሚቲፊ ብኔንሶተ ለፋቲፍ ኛተ ጎዼ ነንኬነ። <verse eid="JER 19:7"/><verse number="8" style="v" sid="JER 19:8"/>አን መጋላ ከነ ኦንሴ ዋን ሶዳፊ ቆሳ ነንጎዸ፤ ከን አቺን ደርቡ ሁንድ ሰበቢ መዳሼ ሁንዳቲፍ ድንቅሲፈቴ እሼት ኮልፈ። <verse eid="JER 19:8"/><verse number="9" style="v" sid="JER 19:9"/>አን አከ እሳን ፎን እልማንሳኒቲፊ እንተለንሳኒ ኛተን ነንጎዸ፤ እሳንስ ዬሮ ዲኖትንሳኒ ከኔን ሉቡሳኒ ገላፈቹ በርባደን ሱን መርሰኒ እሳን ዽጵሰንት ፎን ወሊሳኒ ኛቱ።’<verse eid="JER 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 19:10"/>“ኤርገሲ ኦኮቴ ሰነ ፉለ ወረ ስ ወጅን ዴመኒ ዱረት ጨብሲቲ <verse eid="JER 19:10"/><verse number="11" style="v" sid="JER 19:11"/>አከነ እሳኒን ጄዽ፤ ‘<char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ አከነ ጄዸ፦ አኩመ ኦኮቴን ሱጴ ዾፍቱ ኩን ኤርገ ጨጨቤ ቦዴ ዴብኤ ሃሮምፈሙ ህንደንዴኜ ሰነ አን ሰበ ከናፊ መጋላ ከነ ነንጨጨብሰ፤ ሰበቢ እዶን እት ነመ አዋለን ብራ ህንጅሬፍ ነሞትን ቶፌትት ሬፈ አዋሉ። <verse eid="JER 19:11"/><verse number="12" style="v" sid="JER 19:12"/>አን እዶ ከናፊ ወረ አስ ጅራተንት ዋን ከነ ነንፍደ፣ ጄዸ <char style="nd">ዋቀዮ</char>። መጋላ ከነስ አኩመ ቶፌት ነንጎዸ። <verse eid="JER 19:12"/><verse number="13" style="v" sid="JER 19:13"/>መኔን ዬሩሳሌም ኬሳቲፊ መኔን ሞቶተ ይሁዳ ጄቹንስ መኔን ጀር በንቲሳኒረት ኡርጂወን ሰሚ ሁንዳፍ እጣነ ኣርሰኒ ዋቆተ ብራፍስ ዽባዩ ዽባፈተን ሱን ሁንድ አኩመ እዶ ቶፌት ከና ንጡሬፈሙ።’ ”<verse eid="JER 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 19:14"/>ኤርምያስስ ኤርገሲ ቶፌት እዶ <char style="nd">ዋቀዮ</char> አከ እን አችት ራጂ ዱበቱፍ እት እሰ ኤርጌ ሰና ዴብኤ ኦብዲ መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ኬሰ ዻበቴ ሰበ ሁንዳን አከነ ጄዼ፤ <verse eid="JER 19:14"/><verse number="15" style="v" sid="JER 19:15"/>“<char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል አከነ ጄዸ፤ ‘ሜ ዸጌፈዻ! ሰበቢ እሳን መተ ጀቤዪ ተአኒ ዱቢኮ ዸገኡ ድደኒፍ በላ አን እሳንት ለብሴ ቱሬ ሁንደ መጋላ ከናፊ ገንዶተ ናኖሼ ጅረንት ነንፍደ።’ ”<verse eid="JER 19:15"/></para>
  <chapter eid="JER 19"/>
  <chapter number="20" style="c" sid="JER 20"/>
  <para style="s1">ኤርምያሲፊ ጳሽሁር</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 20:1"/>ጳሽሁር ሉብች፣ እልም እሜሪ እን መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ኬሰት ቡልቻ ሀንገፈ ቱሬ ሱን ዮሙ ኤርምያሲ ዋን ከነ ራጁ ዸገኤት፣ <verse eid="JER 20:1"/><verse number="2" style="v" sid="JER 20:2"/>አከ ኤርምያስ ራጅች ቱመሜ ከረ ቤንያም እሰ ኦል ኣኑ ከን መነ <char style="nd">ዋቀዮ</char> ብረት አርገሙ ሰነ ኬሰት ሚልሳ ጅርመ ለመ ግዱ ገሌ ህዸሙ ጎዼ። <verse eid="JER 20:2"/><verse number="3" style="v" sid="JER 20:3"/>ኤርምያስስ ጉያ እት ኣኑ ዬሮ ጳሽሁር ጅርመ ለማን ግዱዻ እሰ ባሴት አከነ ጄዼን፤ “መቃን <char style="nd">ዋቀዮ</char> ሲፍ ባሴ ማጎርሚሳቢብ መሌ ጳሽሁር ምት። <verse eid="JER 20:3"/><verse number="4" style="v" sid="JER 20:4"/><char style="nd">ዋቀዮ</char> አከነ ጄዻቲ፤ ‘አን አከ አት ኦፊኬቲፊ ምቾተኬት ሶዳችሳ ታቱ ስን ጎዸ፤ ዬሮ እሳን ጎራዴ ዲኖተሳኒቲን ዹመን እጁመኬቲን አርግተ። አን ይሁዳ ሁንደ ደበርሴ ሞቲ ባብሎኒት ነንኬነ፤ እንስ ባብሎንት እሳን ጌሰ ዮካን ጎራዴዻን እሳን ፍጠ። <verse eid="JER 20:4"/><verse number="5" style="v" sid="JER 20:5"/>አን ቀቤኘ መጋላ ከና ሁንደ ጄቹንስ ኦምሸሼ ሁንደ፣ ዋን ገቲ ጉዳ ቀቡ ሁንዳፊ በዻዹማ ሞቶተ ይሁዳ ሁንደ ደበርሴ ዲኖተሳኒት ነንኬነ። እሳንስ ቦጅአኒ ፉዸተኒ ባብሎንት እሳን ጌሱ። <verse eid="JER 20:5"/><verse number="6" style="v" sid="JER 20:6"/>ያ ጳሽሁር አት፣ ወር መነኬ ጅራተን ሁንድስ ቦጅአምተኒ ባብሎንት ጌፈምቱ። አቲፊ ምቾተኬ ወር አት ራጂ ሶባ ዱበቴፍ ሁንድ አችት ዱተኒ አዋለምቱ።’ ”<verse eid="JER 20:6"/></para>
  <para style="s1">ጉንጉሚ ኤርምያስ</para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 20:7"/>ያ <char style="nd">ዋቀዮ</char>፣ አት ነ ጎዎምስቴ፤ <optbreak/> አንስ ነንጎዎምፈሜ፤</para>
  <para style="q2" vid="JER 20:7">አት ሁምናን ነ ጫልቴ ነ ሞአቴ።</para>
  <para style="q1" vid="JER 20:7">አን ጉያ ጉቱ ዋን ኮልፋ ነንተኤ፤</para>
  <para style="q2" vid="JER 20:7">ነምን ሁንድስ ነት ቆሰ።<verse eid="JER 20:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 20:8"/>አን ዬሮን ዱበዹ ሁንደ ነንእየ፤</para>
  <para style="q2" vid="JER 20:8">“ጎሊ፣ በዲሰ” ጄዼስ ነንለብሰ።</para>
  <para style="q1" vid="JER 20:8">ከናፉ ዱቢን <char style="nd">ዋቀዮ</char></para>
  <para style="q2" vid="JER 20:8">ጉያ ጉቱ አረብሶፊ ቱፊ ነት ፍዴ።<verse eid="JER 20:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 20:9"/>ገሩ ዮ አን፣ “አን መቃሳ ህንዸኡ</para>
  <para style="q2" vid="JER 20:9">ዮካን ስአች መቃሳቲን ህንዱበዹ” ጄዼ፣</para>
  <para style="q1" vid="JER 20:9">ዱቢንሳ ኦኔኮ ኬሰት አከ እብዳ፣</para>
  <para style="q2" vid="JER 20:9">አኩመ እብደ ለፌኮ ኬሰት ኡካምሰሜት።</para>
  <para style="q1" vid="JER 20:9">አን ኦፍ ኬሰት እሰ ቀበቹ ነንደዸቤ፤</para>
  <para style="q2" vid="JER 20:9">ዹጉመዩ አን ህንደንደኡ።<verse eid="JER 20:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 20:10"/>አን ሀሳሰ፣ “ከራ ሁንዳን ሶዳ!</para>
  <para style="q2" vid="JER 20:10">እሰ በላሌፈዻ! እሰ ሃበላሌፈትኑ!”</para>
  <para style="q2" vid="JER 20:10">ጄዹ ሄዱ ነንዸገአ።</para>
  <para style="q1" vid="JER 20:10">ምቾትንኮ ሁንድ፣</para>
  <para style="q2" vid="JER 20:10">“እን ንጎዎምፈመ ተአ፤</para>
  <para style="q1" vid="JER 20:10">ኑስ ኤርገሲ እሰ ንሞአትነ፤</para>
  <para style="q2" vid="JER 20:10">ሃሎኬኘሌ ንባፈትነ” ጄቻ</para>
  <para style="q2" vid="JER 20:10">ኩፋቲኮ ኤገቱ።<verse eid="JER 20:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="JER 20:11"/>
    <char style="nd">ዋቀዮ</char> ገሩ አኩመ ጎተ ሁምነ ቀቤሰ ቶኮት <optbreak/> ነ ወጅን ጅረ፤</para>
  <para style="q2" vid="JER 20:11">ከናፉ ወር ነ አደምሰን ንጉፈቱ መሌ ህንሞአተን።</para>
  <para style="q1" vid="JER 20:11">እሳን ባይኤ ቃኔፈመን፤ ህንምልካአኒቲ፤</para>
  <para style="q2" vid="JER 20:11">ሰልጵንሳኒ ጎንኩማ ህንእራንፈተሙ።<verse eid="JER 20:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 20:12"/>ያ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንዴሱ፣</para>
  <para style="q2" vid="JER 20:12">ከን ነመ ቀጄላ ቆርቱ፣</para>
  <para style="q2" vid="JER 20:12">ከን ገራፊ ያደ ነማ ኬሰ አርግቱ፣</para>
  <para style="q1" vid="JER 20:12">አን ፈልሚኮ ስት ኬነዼራቲ</para>
  <para style="q2" vid="JER 20:12">አት ዬሮ እሳንት ሃሎ ባቱ ነ አርግሲስ።<verse eid="JER 20:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JER 20:13"/>
    <char style="nd">ዋቀዮፍ</char> ፋርፈዻ!</para>
  <para style="q2" vid="JER 20:13">
    <char style="nd">ዋቀዮን</char> ገለቴፈዻ!</para>
  <para style="q1" vid="JER 20:13">እን ሉቡ ነሞተ ህዬዪ</para>
  <para style="q2" vid="JER 20:13">ሀርከ ሀሞታቲ ንባሰ።<verse eid="JER 20:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="JER 20:14"/>ጉያን አን ዸለዼ ሃአባረሙ!</para>
  <para style="q2" vid="JER 20:14">ጉያን ሃትኮ ነ ዴሴ ሱንስ ህንኤብፈምን!<verse eid="JER 20:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 20:15"/>ነምች፣ “ዳእምን ቶኮ ጄቹንስ</para>
  <para style="q2" vid="JER 20:15">እልም ሲፍ ዸለቴ ጅረ!” ጄዼ አባኮቲፍ ኦዱ ፍዴ</para>
  <para style="q2" vid="JER 20:15">አከ መሌ እሰ ገመቺሴ ሱን ሃአባረሙ!<verse eid="JER 20:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 20:16"/>ነምች ሱን አኩመ መጋላወን</para>
  <para style="q2" vid="JER 20:16">
    <char style="nd">ዋቀዮ</char> ገረ ላፍነ መሌ ገረገልቼ ሃተኡ።</para>
  <para style="q1" vid="JER 20:16">እን ገነማን ወዋትና፣</para>
  <para style="q2" vid="JER 20:16">ሳፋንሞ እየ ወራና ሃዸገኡ።<verse eid="JER 20:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 20:17"/>አከ ሃትኮ አዋለ ና ታቱፍ፣</para>
  <para style="q2" vid="JER 20:17">አከ ገደሜስሼስ እዶ ጅሬኘ በረ በራ ናፍ ተኡፍ</para>
  <para style="q2" vid="JER 20:17">እን ኡቱ አን ገደሜሰ ኬሳ ህንበእን ነ ህንአጄፍኔቲ።<verse eid="JER 20:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 20:18"/>አን ማሊፈን ረክናፊ ገደ አርጉፍ</para>
  <para style="q2" vid="JER 20:18">ጅሬኘኮስ ቃኒን ፍጡፍ</para>
  <para style="q2" vid="JER 20:18">ገደሜሰ ኬሳ በኤ?<verse eid="JER 20:18"/></para>
  <chapter eid="JER 20"/>
  <chapter number="21" style="c" sid="JER 21"/>
  <para style="s1">ዴቢ ዜዴቅያፍ ኬነሜ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 21:1"/>ዬሮ ዜዴቅያን ሞትች ጳሽሁር እልመ መልክያቲፊ ሴፋንያ ሉብቸ እልመ መአሴያ ገረ ኤርምያስት ኤርጌት ዱቢን አከነ ጄዹ <char style="nd">ዋቀዮ</char> ብራ ገረ ኤርምያስ ዹፌ። ጀር ኤርገመንስ አከነ ጄዸን፤ <verse eid="JER 21:1"/><verse number="2" style="v" sid="JER 21:2"/>“ሰበቢ ኔቡከድኔዘር ሞትች ባብሎን ኑ ወራና ጅሩፍ <char style="nd">ዋቀዮን</char> ኑ ጋፈዹ። ተሪ <char style="nd">ዋቀዮ</char> አኩመ ዱራን ጎዼ ሰነ ሆጂወን ድንቂ ኑፍ ሆጄቴ አከ ሞትች ኑራ ዴብኡ ንጎዸ ተኣቲ።”<verse eid="JER 21:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 21:3"/>ኤርምያስ ገሩ አከነ እሳኒን ጄዼ፤ “ዜዴቅያዻን አከነ ጄዻ፤ <verse eid="JER 21:3"/><verse number="4" style="v" sid="JER 21:4"/>‘<char style="nd">ዋቀዮ</char> ዋቅን እስራኤል አከነ ጄዸ፦ አን ምኦተ ወራና ሀርከኬሰን ጅረን፣ ከኔን እስን እቲን ሞቲ ባብሎኒፊ ባብሎኖተ እስን መርሰኒ ደላን አለ ጅረን ሎሉፍ እት ፈየደምተን ከነ እስንት ነንገረገልቸ። አንስ መጋላ ከነ ኬሰት እሳን ወልት ነንቀበ። <verse eid="JER 21:4"/><verse number="5" style="v" sid="JER 21:5"/>አን መታንኮ ሀርከ ድሪርፈሜፊ እሬ ጀባዻን፣ ኣሪ ቦበኡፊ ዼከምሰ ጉዳዻን ወራነ እስንት ነንበነ። <verse eid="JER 21:5"/><verse number="6" style="v" sid="JER 21:6"/>አን ዋን መጋላ ከነ ኬሰ ጅራቱ ጄቹንስ ነማፊ ሆሪ ነንዸአ፤ እሳንስ ዸእቸ ሀማዻን ዹሙ። <verse eid="JER 21:6"/><verse number="7" style="v" sid="JER 21:7"/>አንስ ኤርገሲ፣ ጄዸ <char style="nd">ዋቀዮ</char>፣ ዜዴቅያ ሞትቸ ይሁዳ፣ ቆንዳልቶተሳቲፊ ጅራቶተ መጋላ ከና ከኔን ዸእቸ ጀላ፣ ጎራዴፊ ቤለ ጀላ በአን ኔቡከድኔዘር ሞትቸ ባብሎኒፊ ዲኖተሳኒ ከኔን ሉቡሳኒ በሌሱ በርባደንት ደበርሴ ነንኬነ። ሞትችስ ጎራዴዻን እሳን ፍጠ፤ እን እሳኒፍ ህንህሉ ዮካን ህንነኡፍ ዮካን ገራ ህንላፉፍ።’<verse eid="JER 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 21:8"/>“አመሌ አከነ ጄዺ ሰበ ከነት ህም፤ <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ ‘ኩኖ፣ አን ከራ ጅሬኛቲፊ ከራ ዱኣ ፉለኬሰን ዱረ ነንካአ። <verse eid="JER 21:8"/><verse number="9" style="v" sid="JER 21:9"/>ነምን መጋላ ከነ ኬሰት ሀፉ ከምዩ ጎራዴዻን፣ ቤላን ዮካን ዸእቻን ዱአ። ነምን ገድ በኤ ባብሎኖተ እስን መርሰኒ ጅረንት ሀርከ ኬነቱ ከምዩ ገሩ ንጅራተ፤ ሉቡሳስ ንኦልፈተ። <verse eid="JER 21:9"/><verse number="10" style="v" sid="JER 21:10"/>አን መጋላ ከናፍ ዋን ጋሪ ጎቹፍ ኡቱ ህንተእን እሼ ሚዹፍ ኩተዼረ፣ ጄዸ <char style="nd">ዋቀዮ</char>። እሼንስ ደበርፈምቴ ሀርከ ሞቲ ባብሎንት ንኬነምት፤ እንሞ እብዳን እሼ በርበዴሰ።’<verse eid="JER 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 21:11"/>“አከሱመስ መነ ሞቲ ይሁዳቲን አከነ ጄዽ፤ ‘እስን ዱቢ <char style="nd">ዋቀዮ</char> ዸገኣ፤ <verse eid="JER 21:11"/><verse number="12" style="v" sid="JER 21:12"/>ያ መነ ዳዊት፣ <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 21:12">“ ‘ገነመ ሁንደ ሙርቲ ቀጄላ ኬና፤</para>
  <para style="q2" vid="JER 21:12">ነመ ሳመሜ ቶኮ</para>
  <para style="q2" vid="JER 21:12">ሀርከ ነመ እሰ ጩንቁርሱቲ ባሳ፤</para>
  <para style="q1" vid="JER 21:12">ዮ ከና አቺ ሰበቢ ጀልእነ እስን ሆጄተኒቲፍ</para>
  <para style="q2" vid="JER 21:12">ዼከምስኮ ቡኤ አኩመ እብዳ ቦበአ፤</para>
  <para style="q2" vid="JER 21:12">ነምን እሰ ዻምሱ ቶኮዩ ህንጅራቱ።<verse eid="JER 21:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 21:13"/>ያ እሼ ሱሉለ ከናን ኦል ድሬ ከታ ቀቡረ ጅራቱ፣</para>
  <para style="q2" vid="JER 21:13">አን ስት ከኤን ጅረ፣ ጄዸ <char style="nd">ዋቀዮ</char>፤</para>
  <para style="q1" vid="JER 21:13">እስን ወር፣ “ኤኙቱ ኑት ዹፉ ደንደአ?</para>
  <para style="q2" vid="JER 21:13">ኤኙቱስ ደአትኖኬኘ ሴኑ ደንደአ?” ጄተን፣<verse eid="JER 21:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 21:14"/>አን አኩመ ሆጂኬሰኒፍ መሉት እስነን አደበ፣</para>
  <para style="q2" vid="JER 21:14">ጄዸ <char style="nd">ዋቀዮ</char>።</para>
  <para style="q1" vid="JER 21:14">አን እብደ ዋን ናኖኬሰን ጅሩ ሁንደ በርበዴሱ</para>
  <para style="q2" vid="JER 21:14">ቦሶነኬሰንት ነንቀብሲሰ።’ ”<verse eid="JER 21:14"/></para>
  <chapter eid="JER 21"/>
  <chapter number="22" style="c" sid="JER 22"/>
  <para style="s1">ሙርቲ ሞቶተ ሀሞት ሙረሜ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 22:1"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ “ገረ መሰራ ሞቲ ይሁዳት ገድ ቡኢቲ አከነ ጄዺ ኤርጋ ከነ አችት ለብስ፤ <verse eid="JER 22:1"/><verse number="2" style="v" sid="JER 22:2"/>‘ያ ሞቲ ይሁዳ፣ አት ከን ቴሶ ዳዊትረ ቴሱ፣ አት፣ ቆንዳልቶትንኬቲፊ ሰብንኬ ወር ከረ ከናን ኦል ገልተን ዱቢ <char style="nd">ዋቀዮ</char> ዸገኣ። <verse eid="JER 22:2"/><verse number="3" style="v" sid="JER 22:3"/><char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ ዋን ቀጄላፊ ስሪ ተኤ ሆጄዻ። ነመ ሳመሜ ቶኮ ሀርከ ነመ እሰ ጩንቁርሱቲ ባሳ። አለጋት፣ እጆሌ አባ ህንቀብኔት ዮካን ሃዸ ህዬሳት ደበ ዮካን ጀልእነ ህንሆጄትና፤ ዺገ ነመ በሌሳ ህንቀብኔስ እዶ ከነት ህንዸንገላስና። <verse eid="JER 22:3"/><verse number="4" style="v" sid="JER 22:4"/>ዮ እስን አጀጀወን ከኔን ስሪት ኤግደን ሞቶትን ቴሶ ዳዊትረ ታአን፣ ቆንዳልቶታፊ ሰበሳኒ ወጅን ጋሪ ሞቶታቲፊ ፈርዴን ያበተኒ ከረወን መሰራ ሞቱማ ከናን ኦል ገሉ። <verse eid="JER 22:4"/><verse number="5" style="v" sid="JER 22:5"/>ዮ እስን አጀጀወን ከኔን ኤጉ ባተን ገሩ አከ መሰራን ሞቱማ ኩን በርበዴፈሙ አን መቃኮቲን ከከዼረ፣ ጄዸ <char style="nd">ዋቀዮ</char>።’ ”<verse eid="JER 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 22:6"/>
    <char style="nd">ዋቀዮ</char> ዋኤ መሰራ ሞቲ ይሁዳ አከነ ጄዻቲ፦</para>
  <para style="q1" vid="JER 22:6">“አት አከ ግልኣድ፣</para>
  <para style="q2" vid="JER 22:6">አከ ፊጤ ልባኖን ናፍ ታቴዩ፣</para>
  <para style="q1" vid="JER 22:6">አን ዹጉማን አከ ገሞጂ፣</para>
  <para style="q2" vid="JER 22:6">አከ መጋላወን ነምን ኬሰ ህንጅራትኔ ስን ታስሰ።<verse eid="JER 22:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 22:7"/>አን በሌስቶተ ቶኮን ቶኮንሳኒ</para>
  <para style="q2" vid="JER 22:7">ምአ ሎላ ቀበተን፣ ስት ነንኤርገ፤</para>
  <para style="q1" vid="JER 22:7">እሳንስ ብርብርሰኬ ፍለተማ ንጭሩ፤</para>
  <para style="q2" vid="JER 22:7">እብደትስ ንነቁ።<verse eid="JER 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 22:8"/>“ነሞትን ብየ ሄዱስ ዮሙ መጋላ ከነ ብራን ደርበንት፣ ‘<char style="nd">ዋቀዮ</char> ማሊፍ መጋላ ጉዳ ከነት ዋን አከና ፍዴ?’ ጄዸኒ ወል ጋፈቱ። <verse eid="JER 22:8"/><verse number="9" style="v" sid="JER 22:9"/>እሳንስ፣ ‘ሰበቢ እሳን ከኩ <char style="nd">ዋቀዮ</char> ዋቀሳኒ ዺሰኒ ዋቆተ ብራ ዋቄፈተኒ ተጃጅለኒፊዸ’ ጄዸኒ ዴብሱ።”<verse eid="JER 22:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 22:10"/>እስን ነመ ዱኤፍ ህንቦእና ዮካን ህንገድና፤</para>
  <para style="q2" vid="JER 22:10">ቆደ ከና ነመ ቦጅአሜፍ ህቅፈዻ ቦኣ፤</para>
  <para style="q1" vid="JER 22:10">እን ለመተ ህንዴብኡ</para>
  <para style="q2" vid="JER 22:10">ዮካን ብየ እት ዸለቴ ህንአርጉቲ።<verse eid="JER 22:10"/></para>
  <para style="m">
    <verse number="11" style="v" sid="JER 22:11"/>
    <char style="nd">ዋቀዮ</char> ዋኤ ሸሉም እልመ ዮስያስ ከን ቆደ አባሳ ሞቲ ይሁዳ ተኤ ገሩ እዶ ከና ዴሜ ሰና አከነ ጄዻቲ፦ “እን ጎንኩማ ህንዴብኡ። <verse eid="JER 22:11"/><verse number="12" style="v" sid="JER 22:12"/>እን እዶ ቦጅአሜ እት ጌፈሜ ሰነት ዱአ፤ ብየ ከነስ ለመፋ ህንአርጉ።”<verse eid="JER 22:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 22:13"/>“ነመ ኦላሳ ኡቱ ገቲ ሁምነሳ ህንኬንኒፍ</para>
  <para style="q2" vid="JER 22:13">አከሱማን ሆጄቺፈቹዻን</para>
  <para style="q1" vid="JER 22:13">መነሳ ከራ ቀጄላ ህንተእኒን፣</para>
  <para style="q2" vid="JER 22:13">ኩታሳ ከን መነ ጉባሞ ከራ ስሪ ህንተእኒን <optbreak/> እጃረቱፍ ወዮ።<verse eid="JER 22:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 22:14"/>እን፣ ‘አን መሰራ ጉዳ ቶኮ፣</para>
  <para style="q2" vid="JER 22:14">ኩታ መነ ጉባ በልኣሳ ወጅን <optbreak/> ኦፊኮቲፍ ነንእጃረዸ’ ጄዸ።</para>
  <para style="q1" vid="JER 22:14">ከናፉ እን ፎዳወን እት ባሴ</para>
  <para style="q2" vid="JER 22:14">ሙከ ብርብርሳቲን በሬቼ</para>
  <para style="q2" vid="JER 22:14">ሀሉ ዲማዻን ሚዸግሰ።<verse eid="JER 22:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JER 22:15"/>“ብርብርሰ ሄዱ ቀባቹንኬ ሞቲ ስ ታስሳ?</para>
  <para style="q2" vid="JER 22:15">አባንኬ ኛታ ዹጋቲ ህንቀቡ ቱሬ?</para>
  <para style="q1" vid="JER 22:15">እን ዋን ቀጄላፊ ሀቀ ሆጄቴ፤</para>
  <para style="q2" vid="JER 22:15">ከናፉ ወን ሁንድኑ ንቀጄሌፍ።<verse eid="JER 22:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 22:16"/>እን ህዬዪፊ ረከቶታፍ ንፈልሜ፤</para>
  <para style="q2" vid="JER 22:16">ከናፉ ወን ሁንድ ንቀጄሌፍ።</para>
  <para style="q1" vid="JER 22:16">ነ ቤኩ ጄቹን ከኑመ ምቲ?”</para>
  <para style="q2" vid="JER 22:16">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 22:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 22:17"/>እጅኬቲፊ ገራንኬ ገሩ</para>
  <para style="q2" vid="JER 22:17">ቡኣ ከራ ህንመልኒን አርገሙረ፣</para>
  <para style="q1" vid="JER 22:17">ዺገ ነመ በሌሳ ህንቀብኔ ዸንገላሱረ፣</para>
  <para style="q2" vid="JER 22:17">ጩንቁርሳፊ ጎሊ ካሱ ቆፈረ ቡኤረ።<verse eid="JER 22:17"/></para>
  <para style="m">
    <verse number="18" style="v" sid="JER 22:18"/>ከናፉ <char style="nd">ዋቀዮ</char> ዋኤ ዬሆያቂም ሞትቸ ይሁዳ፣ እልመ ዮስያስ አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 22:18">“እሳን፣ ‘አናፍ ወዮ፣ ያ ኦቦሌሰኮ!</para>
  <para style="q2" vid="JER 22:18">አናፍ ወዮ፣ ያ ኦቦሌቲኮ!’ <optbreak/> ጄዸኒ ህንቦአኒፍ።</para>
  <para style="q1" vid="JER 22:18">እሳን፣ ‘አናፍ ወዮ፣ ያ ጎፍታኮ!</para>
  <para style="q2" vid="JER 22:18">አናፍ ወዮ ያ ኡልፍነሳ!’ <optbreak/> ጄዸኒ ህንቦአኒፍ።<verse eid="JER 22:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 22:19"/>እን አዋለ ሀሬ አርገተ፣</para>
  <para style="q2" vid="JER 22:19">ጄቹንስ ለፈረ ሀርክፈሜ</para>
  <para style="q2" vid="JER 22:19">ከረወን ዬሩሳሌም ኬሳ ገድ ባፈሜ ገተመ።”<verse eid="JER 22:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JER 22:20"/>“ልባኖንት ኦል በኢ እይ፤</para>
  <para style="q2" vid="JER 22:20">ሰገሌንኬ ባሻን ኬሰት ሃዸገአሙ፤</para>
  <para style="q1" vid="JER 22:20">አባሪም ኬሳስ እይ፤</para>
  <para style="q2" vid="JER 22:20">ምቾትንኬ ሁንድ በርበዴፈመኒሩቲ።<verse eid="JER 22:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 22:21"/>አን ዬሮ አት ነጋ ቀብዱት ስ አኬከቺሴን ቱሬ፤</para>
  <para style="q2" vid="JER 22:21">አት ገሩ፣ ‘አን ህንዸጌፈዹ!’ ጄቴ።</para>
  <para style="q1" vid="JER 22:21">ኩን እጆሉማኬቲ ጀልቀቤ አመለኬ ቱሬ፤</para>
  <para style="q2" vid="JER 22:21">አት ናፍ ህንአጀጀምኔ።<verse eid="JER 22:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 22:22"/>ትክሶተኬ ሁንደ ቡቤን ፉዸቴ ሶከ፤</para>
  <para style="q2" vid="JER 22:22">ምቾትንኬስ ንቦጅአሙ።</para>
  <para style="q1" vid="JER 22:22">ሰበቢ ሀምነኬ ሁንዳቲፍ</para>
  <para style="q2" vid="JER 22:22">አት ንቃኖፍተ፤ ንሰልጰተስ።<verse eid="JER 22:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 22:23"/>አት ከን ልባኖን ኬሰ ጅራቱ፣</para>
  <para style="q2" vid="JER 22:23">ከን ሙከ ብርብርሳቲን መነ እጃረቱ፣</para>
  <para style="q1" vid="JER 22:23">ዬሮ ዽጵን ስ ቀቤ አኩመ ዱበርቲ ጭኒንስፈቱ ቶኮ</para>
  <para style="q2" vid="JER 22:23">ሚጠቱት አት አከም ኣደ!<verse eid="JER 22:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 22:24"/>“አኩመ አን ዹጉማን ጅራታ ተኤ” ጄዸ <char style="nd">ዋቀዮ</char>፤ “ያ ዬሆያኪን ሞትቸ ይሁዳ፣ እልመ ዬሆያቂም፣ ዮ አት ቁቤላ ቻፓ ሀርከኮ ምርጋ ታቴሌ አን ባሴን ስ ገተ። <verse eid="JER 22:24"/><verse number="25" style="v" sid="JER 22:25"/>አን ወረ ሉቡኬ ገላፈቹ በርባደንት፣ ወረ አት ሶዳቱ ጄቹንስ ኔቡከድኔዘር ሞትቸ ባብሎኒፊ ባብሎኖተት ደበርሴ ስን ኬነ። <verse eid="JER 22:25"/><verse number="26" style="v" sid="JER 22:26"/>አን ስኢፊ ሃዸ ስ ዴሴ ብየ ብራት፣ ብየ ቶኮንኬሰንዩ እት ህንዸለትንት እስን ነንደርበዻ፤ እስን ለቹ አችት ዱቱ። <verse eid="JER 22:26"/><verse number="27" style="v" sid="JER 22:27"/>እስን ብየ እት ዴብኡ ሀውተንት ጎንኩማ ህንዴብተን።”<verse eid="JER 22:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 22:28"/>ዬሆያኪን ኩን ነመ አኩመ ኦኮቴ ጨባ ቱፈተሜ፣</para>
  <para style="q2" vid="JER 22:28">ምአ ነምን ቶኮዩ ህንበርባኔዻ?</para>
  <para style="q1" vid="JER 22:28">እጆሌንሳቲፊ እን ማሊፍ</para>
  <para style="q2" vid="JER 22:28">ደርበተመኒ ብየ ህንቤክኔት ገተመን?<verse eid="JER 22:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JER 22:29"/>ያ ለፋ፣ ያ ለፋ፣ ያ ለፋ፣</para>
  <para style="q2" vid="JER 22:29">ዱቢ <char style="nd">ዋቀዮ</char> ዸገእ!<verse eid="JER 22:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 22:30"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 22:30">“ነምቸ ከነ አከ ነመ እጆሌ ህንቀብኔ ቶኮት፣</para>
  <para style="q2" vid="JER 22:30">አከ ነመ በረ ጅሬኘሳ ኬሰ ህንምልኮፍኔ ቶኮት ገልሜሳ፤</para>
  <para style="q1" vid="JER 22:30">ሰኚሳ ኬሳ ነምን ቶኮዩ ህንምልካኡ፣</para>
  <para style="q2" vid="JER 22:30">ነምን ቶኮዩ ቴሶ ዳዊትራ ህንታኡ፣</para>
  <para style="q2" vid="JER 22:30">ዮካን ስአች ይሁዳ ህንቡልቹቲ።”<verse eid="JER 22:30"/></para>
  <chapter eid="JER 22"/>
  <chapter number="23" style="c" sid="JER 23"/>
  <para style="s1">ደሜ ቀጄላ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 23:1"/>“ትክሶተ ሆሎተ ከረኮ በሌሰኒ ብትኔስኒፍ ወዮ!” ጄዸ <char style="nd">ዋቀዮ</char>። <verse eid="JER 23:1"/><verse number="2" style="v" sid="JER 23:2"/>ከናፉ <char style="nd">ዋቀዮ</char> ዋቅን እስራኤል ትክሶተ ሰበኮ ትክሰኒን አከነ ጄዸ፦ “ዋን እስን ቡሻዬኮ ብትኔስተኒ አሪተኒፊ ኤጉምሰ በርባችሱ እሳኒፍ ህንጎዽኒፍ አን ኩኖ ሀምነ እስን ሆጄተኒፍ አደቢ እስንትን ፍደ” ጄዸ <char style="nd">ዋቀዮ</char>። <verse eid="JER 23:2"/><verse number="3" style="v" sid="JER 23:3"/>“አን መታንኮ ሀምባ ቡሻዬኮቲ ብዮተ አን እት እሳን አርኤ ቱሬ ሁንደ ኬሳ ወልት ቀቤ ከረሳኒት ነንዴብሰ፤ እሳንስ አችት ንሆሩ፤ ንባይአቱስ። <verse eid="JER 23:3"/><verse number="4" style="v" sid="JER 23:4"/>አንስ ትክሶተ እሳን ትክሰን እሳኒፍ ነንረመደ፤ እሳንስ ስአች ህንሶዳተን፤ ዮካን ህንርፈተን፣ ዮካን እሳን ኬሳ ቶኮዩ ህንበዱ” ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 23:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 23:5"/>“በር አን እት ዳዊቲፍ ደሜ ቀጄላ ቶኮ፣</para>
  <para style="q2" vid="JER 23:5">ሞቲ ኦጉማዻን ቡልቹፊ</para>
  <para style="q1" vid="JER 23:5">ዋን ስሪፊ ቀጄላ ተኤ</para>
  <para style="q2" vid="JER 23:5">ብየ ከነ ኬሰት ሆጄቱ ቶኮ ካሱ ንዹፈ” <optbreak/> ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 23:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 23:6"/>በረሳ ኬሰ ይሁዳን ንፈየ፤</para>
  <para style="q2" vid="JER 23:6">እስራኤልስ ነጋን ጅራተ፤</para>
  <para style="q1" vid="JER 23:6">መቃን እን እቲን ዋመሙስ፦</para>
  <para style="q2" vid="JER 23:6">
    <char style="nd">ዋቀዮ</char> ቀጄሉማኬኘ ጄዸመ።<verse eid="JER 23:6"/></para>
  <para style="m">
    <verse number="7" style="v" sid="JER 23:7"/>“ከናፉ በር እት ነሞትን ስአች፣ ‘ዹጋ <char style="nd">ዋቀዮ</char> ጅራታ እሰ እስራኤሎተ ግብጢ ባሴ ፍዴ ሰና’ ህንጄኔ ቶኮ ንዹፈ” ጄዸ <char style="nd">ዋቀዮ</char>፤ <verse eid="JER 23:7"/><verse number="8" style="v" sid="JER 23:8"/>“እሳን ገሩ፣ ‘ዹጋ <char style="nd">ዋቀዮ</char> ጅራታ እሰ ብየ ካባቲፊ ብዮተ እት እሳን አርኤ ቱሬ ሁንደ ኬሳ ሰኚወን እስራኤል ባሴ ፍዴ ሰና’ ጄዹ። ኤርገሲስ እሳን ብየ ኦፊሳኒ ኬሰ ንጅራቱ።”<verse eid="JER 23:8"/></para>
  <para style="s1">ራጆተ ሶብዱ</para>
  <para style="p">
    <verse number="9" style="v" sid="JER 23:9"/>ዋኤ ራጆታ፣</para>
  <para style="q1" vid="JER 23:9">ኦኔንኮ ነ ኬሰት ጨቤረ፣</para>
  <para style="q2" vid="JER 23:9">ለፌንኮ ሁንድ ንሆለተ፤</para>
  <para style="q1" vid="JER 23:9">ሰበቢ <char style="nd">ዋቀዮቲፊ</char></para>
  <para style="q2" vid="JER 23:9">ሰበቢ ዱቢሳ ቁልቁሉ ሰናቲፍ</para>
  <para style="q1" vid="JER 23:9">አን አኩመ ነመ መቻኤ</para>
  <para style="q2" vid="JER 23:9">አከ ነመ ዳዺ ወይኒቲን ሞአተሜ ነንተኤ።<verse eid="JER 23:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 23:10"/>ብየቲን ኤጅቶታን ጉተምቴርት፣</para>
  <para style="q2" vid="JER 23:10">ሰበቢ አባርሳቲፍ ብየቲን ንቦስ፤</para>
  <para style="q2" vid="JER 23:10">ከሎን ገሞጂ ኬሳስ ንጎገ።</para>
  <para style="q1" vid="JER 23:10">ራጆትን ከራ ሀማ ዱካ ቡኡ፤</para>
  <para style="q2" vid="JER 23:10">ኣንጎሳኒትስ ከራ መሌ ፈየደሙ።<verse eid="JER 23:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="JER 23:11"/>“ራጆንስ፣ ሉብንስ ዋቃፍ ህንቡለን፤</para>
  <para style="q2" vid="JER 23:11">አን መነኮ ኬሰትዩ ሀምነሳኒ አርጌረ”</para>
  <para style="q2" vid="JER 23:11">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 23:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 23:12"/>“ከናፉ ከራንሳኒ ሙጩጨ ተአ፤</para>
  <para style="q2" vid="JER 23:12">እሳን ዱከነት ገድ ደርበተሙ፤</para>
  <para style="q2" vid="JER 23:12">አችትስ ንኩፉ።</para>
  <para style="q1" vid="JER 23:12">በረ እሳን አደበመን ኬሰ፣</para>
  <para style="q2" vid="JER 23:12">አን በዲሰ እሳንት ነንፍደ”</para>
  <para style="q2" vid="JER 23:12">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 23:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JER 23:13"/>“ራጆተ ሰማርያ ግዱት፣</para>
  <para style="q2" vid="JER 23:13">አን ዋን ጅብሲሳ ከነ አርጌረ፦</para>
  <para style="q1" vid="JER 23:13">እሳን መቃ በኣሊን ራጀኒ</para>
  <para style="q2" vid="JER 23:13">ሰበኮ እስራኤልን ከራራ ጀልእሰን።<verse eid="JER 23:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 23:14"/>ራጆተ ዬሩሳሌም ግዱት</para>
  <para style="q2" vid="JER 23:14">አን ዋን ነመ ሱከኔሱ ቶኮ አርጌረ፤</para>
  <para style="q2" vid="JER 23:14">እሳን ንኤጁ፤ ሶባን ጅራቱስ።</para>
  <para style="q1" vid="JER 23:14">አከ ነምን ቶኮዩ ሀምነሳራ ህንዴብኔፍ</para>
  <para style="q2" vid="JER 23:14">እሳን ሀርከ ጀልኦታ ጀጀቤሱ።</para>
  <para style="q1" vid="JER 23:14">እሳን ሁንድ አናፍ አኩመ ሶዶም፤</para>
  <para style="q2" vid="JER 23:14">ሰብን ዬሩሳሌምሞ አኩመ ጎሞራት።”<verse eid="JER 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 23:15"/>ከናፉ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ ዋኤ ራጆታ አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 23:15">“ሰበቢ ራጆተ ዬሩሳሌሚፍ፣</para>
  <para style="q2" vid="JER 23:15">ዋን ጡራኡማን ብየቲ ኬሰ ጉቴፍ</para>
  <para style="q1" vid="JER 23:15">አን አከ እሳን ኛተ ሀዻኣ</para>
  <para style="q2" vid="JER 23:15">ኛተኒ ብሻን ሱማኤስ ዹገን ነንጎዸ።”<verse eid="JER 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 23:16"/>
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 23:16">“ዋን ራጆትን እስኒ ራጀን ህንዸጌፈትና፤</para>
  <para style="q2" vid="JER 23:16">እሳን አብዲ ሶባቲን እስን ጉቱ።</para>
  <para style="q1" vid="JER 23:16">እሳን ኡቱ አፋን <char style="nd">ዋቀዮቲ</char> ህንተእን</para>
  <para style="q2" vid="JER 23:16">ሙልአተ ያደ ኦፊሳኒ ዱበቱ፤</para>
  <para style="q2" vid="JER 23:16">ያደሳኒ ኬሳ ፉዸኒ ሙልአተ ዱበቱ።<verse eid="JER 23:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 23:17"/>እሳን እቱመ ፉፈኒ ወረ ነ ቱፈተኒን፣</para>
  <para style="q2" vid="JER 23:17">‘<char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ እስን ነጋ ንቀባቱ’ ጄዹ።</para>
  <para style="q1" vid="JER 23:17">ወረ መተ ጀብነ ያደ ኦፊሳኒ</para>
  <para style="q2" vid="JER 23:17">ዱካ ቡአን ሁንዳንሞ፣ ‘ሀማን እስን ህንአርገቱ’ ጄዹ።<verse eid="JER 23:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 23:18"/>ገሩ እሳን ኬሳ ነምን ዱቢሳ አርጉፍ ዮካን ዸገኡፍ</para>
  <para style="q2" vid="JER 23:18">ወልዳ <char style="nd">ዋቀዮ</char> ኬሰ ዻበቴ ኤኙ?</para>
  <para style="q2" vid="JER 23:18">ነምን ዱቢሳቲፍ ጉረ ኬኔ ዸገኤ ኤኙ?<verse eid="JER 23:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 23:19"/>ኩኖ ቡቤን <char style="nd">ዋቀዮ</char>፣</para>
  <para style="q2" vid="JER 23:19">ዼከምሳን ንቡአ፤</para>
  <para style="q1" vid="JER 23:19">ቡቤን ሀማንስ</para>
  <para style="q2" vid="JER 23:19">መታ ሀሞታረት ገድ ቡብሰ።<verse eid="JER 23:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 23:20"/>ዼከምስ <char style="nd">ዋቀዮ</char></para>
  <para style="q2" vid="JER 23:20">ሀመ እን ካዮ ያደ ገራሳ</para>
  <para style="q2" vid="JER 23:20">ጉቱማን ጉቱት ራወቱት ዱበት ህንዴብኡ።</para>
  <para style="q1" vid="JER 23:20">እስን በረ ዹማ ኬሰ</para>
  <para style="q2" vid="JER 23:20">ዋን ከነ አከ ጋሪት ንሁበቱ።<verse eid="JER 23:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 23:21"/>አን ራጆተ ከኔን ህንኤርግኔ፤</para>
  <para style="q2" vid="JER 23:21">እሳን ገሩ ኤርጋ ኦፊሳኒ ቀበተኒ ፊገኒሩ፤</para>
  <para style="q1" vid="JER 23:21">አን እሳንት ህንዱበትኔ፤</para>
  <para style="q2" vid="JER 23:21">እሳን ገሩ ራጂ ዱበተኒሩ።<verse eid="JER 23:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 23:22"/>እሳን ኡቱ ወልዳኮ ኬሰ ዻበተኒ ጅራተኒ</para>
  <para style="q2" vid="JER 23:22">ስላ ዱቢኮ ሰበኮት ለብሰኒ፣</para>
  <para style="q1" vid="JER 23:22">ከራሳኒ ጀልኣ ሰናፊ</para>
  <para style="q2" vid="JER 23:22">ሆጂሳኒ ሀማ ሰነራ እሳን ዴብሱ ቱሬ።<verse eid="JER 23:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="JER 23:23"/>“አን ዋቀ ፈጎትስ መሌ</para>
  <para style="q2" vid="JER 23:23">ዋቀ ዽኦ ቆፋ?”</para>
  <para style="q2" vid="JER 23:23">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 23:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 23:24"/>“ነምን ቶኮዩ አከ አን እሰ አርጉ ህንደንዴኜፍ</para>
  <para style="q2" vid="JER 23:24">እዶ ዾክሳ ተኤ ዾከቹ ንደንደአ?”</para>
  <para style="q2" vid="JER 23:24">ጄዸ <char style="nd">ዋቀዮ</char>።</para>
  <para style="q1" vid="JER 23:24">“አን ሰሚፊ ለፈሌ ነንጉተ ምቲ?”</para>
  <para style="q2" vid="JER 23:24">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 23:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JER 23:25"/>“አን ዋን ራጆትን መቃኮቲን ሶበ ራጀን ሱን ጄዸን ዸገኤረ፤ እሳንስ፣ ‘አን አብጁ አብጆዼረ! አን አብጁ አብጆዼረ!’ ጄዹ። <verse eid="JER 23:25"/><verse number="26" style="v" sid="JER 23:26"/>ወን አከሲ ኩን ሀመ ዮሚት ገራ ራጆተ ያዱመ ኦፊሳኒ ኬሳ ፉዸኒ ሶበ ዱበተን ከኔኒ ኬሰ ጅራተ? <verse eid="JER 23:26"/><verse number="27" style="v" sid="JER 23:27"/>ራጆትን ኩኔን አብጁ ወልት ኦዴሰኒን አከ ሰብንኮስ አኩመ አቦቲንሳኒ በኣልን ዋቄፈቹዻን መቃኮ እራንፈተኒ ቱረን ሰነ መቃኮ እራንፈቺሱ ያዱ። <verse eid="JER 23:27"/><verse number="28" style="v" sid="JER 23:28"/>ራጂን አብጁ ቀቡ አብጁሳ ሃዱበቱ፤ ነምን ዱቢኮ ቀቡሞ አመነሙማዻን ሃዱበቱ። ጭዲን ምዻንራ ማል ቀበ?” ጄዸ <char style="nd">ዋቀዮ</char>። <verse eid="JER 23:28"/><verse number="29" style="v" sid="JER 23:29"/>“ዱቢንኮ አኩመ እብዳቲፊ አኩመ ቡሩሰ ከታ ጨጨብሱ ቶኮ ምቲ?” ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 23:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JER 23:30"/>“ከናፉ አን ኩኖ ራጆተ ዱቢኮ ወልራ ሀተን ሰናን ነንሞርመ” ጄዸ <char style="nd">ዋቀዮ</char>። <verse eid="JER 23:30"/><verse number="31" style="v" sid="JER 23:31"/>“ኩኖ አን ራጆተ አፋኑመሳኒቲን፣ ‘<char style="nd">ዋቀዮ</char> አከነ ጄዸ’ ጄዸኒን ነንሞርመ” ጄዸ <char style="nd">ዋቀዮ</char>። <verse eid="JER 23:31"/><verse number="32" style="v" sid="JER 23:32"/>“አን ዹጉማን ወረ አብጁ ሶባ ራጀኒን ነንሞርመ” ጄዸ <char style="nd">ዋቀዮ</char>፣ “እሳን ሶበ እት ኦዴሰኒ ሰበኮ ከራራ በሌሱ፤ አን ገሩ እሳን ህንኤርግኔ ዮካን እሳን ህንሙድኔ። እሳን ጎንኩማ ሰበ ከነ ህንፈየደን” ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 23:32"/></para>
  <para style="s1">ራጂ ሶባ</para>
  <para style="p">
    <verse number="33" style="v" sid="JER 23:33"/>“ዮ ሰብን ኩን ዮካን ራጂን ቶኮ ዮካን ሉብን ቶኮ፣ ‘በኣን <char style="nd">ዋቀዮ</char> ማል?’ ጄዼ ስ ጋፈቱት፣ አትሞ፣ ‘በኣ ማሊ? አን ስን ገተ ጄዸ <char style="nd">ዋቀዮ</char>’ ጄዺን። <verse eid="JER 23:33"/><verse number="34" style="v" sid="JER 23:34"/>ዮ ራጂን ቶኮ ዮካን ሉብን ቶኮ ዮካን ነምን ከምዩ፣ ‘በኣን <char style="nd">ዋቀዮ</char> ከናዸ፣’ ጄዼ፣ አን ነመ ሰናፊ ወረ መነሳ ጅራተን ነንአደበ። <verse eid="JER 23:34"/><verse number="35" style="v" sid="JER 23:35"/>ቶኮን ቶኮን ነማ ምቹሳቲን ዮካን ፍረሳቲን፣ ‘ዴቢን <char style="nd">ዋቀዮ</char> ኬኔ ማል?’ ዮካን፣ ‘<char style="nd">ዋቀዮ</char> ማል ዱበተ?’ ጄቹ ቀበ። <verse eid="JER 23:35"/><verse number="36" style="v" sid="JER 23:36"/>ኤጋ እስን ለመተ፣ ‘በኣ <char style="nd">ዋቀዮ</char>፣’ ጄተኒ ዱበቹ ህንቀብደን፤ ዱቢን ነመ ሁንዳ በኣ ኦፊሳ ተኤ እስንሞ ዱቢ ዋቀኬኛ፣ ዋቀ ጅራታ፣ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ ሰና ጀልእስቱቲ። <verse eid="JER 23:36"/><verse number="37" style="v" sid="JER 23:37"/>አት እቱመ ፉፍቴ ራጂ ቶኮን፣ ‘ዴቢን <char style="nd">ዋቀዮ</char> ሲፍ ኬኔ ማል?’ ዮካን ‘<char style="nd">ዋቀዮ</char> ማል ዱበቴ?’ ጄተ። <verse eid="JER 23:37"/><verse number="38" style="v" sid="JER 23:38"/>እስን፣ ‘በኣን <char style="nd">ዋቀዮ</char> ከናዸ’ ዮ ጄተንዩ፣ <char style="nd">ዋቀዮ</char> አከነ ጄዸ፤ አን ‘በኣን <char style="nd">ዋቀዮ</char> ከናዸ’ ጄቹ ህንቀብደን እስኒን ጄዹዩ እስን ጄቸ፣ ‘በኣን <char style="nd">ዋቀዮ</char> ከናዸ’ ጄዹት ፈየደምቱ። <verse eid="JER 23:38"/><verse number="39" style="v" sid="JER 23:39"/>ከናፉ አን ዹጉማን እስን እራንፈዼ መጋላ እስኒፊ አቦቲኬሰኒፍ ኬኔ ወጅን ፉለኮ ዱራ እስን ነንገተ። <verse eid="JER 23:39"/><verse number="40" style="v" sid="JER 23:40"/>ሰልጵነ በረ በራ ጄቹንስ ቃኒ በረ በራ ከን ህንእራንፈተምኔስ እስንት ነንፍደ።”<verse eid="JER 23:40"/></para>
  <chapter eid="JER 23"/>
  <chapter number="24" style="c" sid="JER 24"/>
  <para style="s1">እጀ ሀርቡ ጉቦ ለመ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 24:1"/>ኤርገ ኔቡከድኔዘር ሞትች ባብሎን ዬሆያኪን ሞትቸ ይሁዳ እልመ ዬሆያቂሚፊ ቆንዳልቶተ ይሁዳ፣ ኦጌዪ ሆጂ ሀርካቲፊ ቱምቱወን ይሁዳ ቦጅኤ ዬሩሳሌሚ ገረ ባብሎንት ጌሴ ቦዴ <char style="nd">ዋቀዮ</char> እጀ ሀርቡ ጉቦ ለመ ፉለ መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ዱረት ነ አርግሲሴ። <verse eid="JER 24:1"/><verse number="2" style="v" sid="JER 24:2"/>ጉቦን ቶኮ እጀ ሀርቡ አከ መሌ ጋሪ ከን እጀ ዱራን ብልቻቴ ፈካቱ ቀበ ቱሬ፤ ጉቦን ካንሞ እጀ ሀርቡ አከ መሌ ቶርቶሬ፣ ሰበቢ ቶርቶሩሳቲፍ ኛተሙ ህንደንዴኜ ቀበ ቱሬ።<verse eid="JER 24:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 24:3"/>
    <char style="nd">ዋቀዮስ</char>፣ “ያ ኤርምያስ፣ አት ማል አርግተ?” ናን ጄዼ።</para>
  <para style="p" vid="JER 24:3">አንስ፣ “እጀ ሀርቡ ነንአርገ፤ እጀ ጋሪን አከ መሌ ጋሪዸ፤ እን ቶርቶራንሞ ሰበቢ አከ መሌ ቶርቶሬፍ ኛተሙ ህንደንደኡ” ጄዼን ዴብሴ።<verse eid="JER 24:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 24:4"/>ኤርገሲ ዱቢን <char style="nd">ዋቀዮ</char> አከነ ጄዼ ገረኮ ዹፌ፦ <verse eid="JER 24:4"/><verse number="5" style="v" sid="JER 24:5"/>“<char style="nd">ዋቀዮ</char> ዋቅን እስራኤል አከነ ጄዸ፤ ‘አን ቦጅአምቶተ ይሁዳ ወረ አን እዶ ከና ባሴ ብየ ባብሎኖታት ኤርጌ ሰነ አኩመ እጀ ጋሪ ከናት እጀ ጋሪን ነንእላለ። <verse eid="JER 24:5"/><verse number="6" style="v" sid="JER 24:6"/>አን ፋይዳሳኒቲፍ እጀኮ እሳንረ ቡፈዼ ብየ ከነት ዴብሴ እሳን ነንፍደ፤ አን እሳነን እጃረ መሌ እሳን ህንዲጉ፤ አን እሳነን ዻበ መሌ እሳን ህንቡቅሱ። <verse eid="JER 24:6"/><verse number="7" style="v" sid="JER 24:7"/>አን አከ እሳን አከ አን <char style="nd">ዋቀዮ</char> እሳኒ ተኤ ቤከኒፍ ቀልቢ ነንኬናፍ። እሳን ሰበኮ ተኡ፤ አንስ ዋቀሳኒ ነንተአ፤ እሳን ገራ ጉቱዻን ገረኮት ንዴብኡቲ።<verse eid="JER 24:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 24:8"/>“ ‘<char style="nd">ዋቀዮ</char> አከነ ጄዸ፤ አን ገሩ ዜዴቅያ ሞትቸ ይሁዳ፣ ቆንዳልቶተሳቲፊ ሀምባወን ዬሩሳሌም ከኔን ብየ ከነ ኬሰት ሀፈኒፊ ወረ ግብጥ ኬሰ ጅራተን አኩመ እጀ ሀርቡ ከን ዋን አከ መሌ ቶርቶሬፍ ነምን ኛቹ ህንደንዴኜ ሰናት ነንዺሰ። <verse eid="JER 24:8"/><verse number="9" style="v" sid="JER 24:9"/>አን ፉለ ሞቱሞተ ለፋ ሁንዳ ዱረት በልፈሞፊ ጅበሞ እሳን ነንጎዸ፤ እዶ አን እት እሳን ብትኔሱ ሁንደትስ ቱፈተሞ፣ ዋን ኮልፋ፣ ዋን ቆሳቲፊ ዋን አባርሳ እሳን ነንጎዸ። <verse eid="JER 24:9"/><verse number="10" style="v" sid="JER 24:10"/>አን ሀመ እሳን ብየ አን እሳኒፊ አቦቲሳኒቲፍ ኬኔራ በርበዳአንት ጎራዴ፣ ቤላፊ ዸእቸ እሳንት ነንኤርገ።’ ”<verse eid="JER 24:10"/></para>
  <chapter eid="JER 24"/>
  <chapter number="25" style="c" sid="JER 25"/>
  <para style="s1">ወጋ ቶርባተማፍ ቦጅአሙ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 25:1"/>በረ ዬሆያቂም እልም ዮስያስ ሞቲ ይሁዳ ቱሬ ኬሳ ወጋ አፉረፋት ጄቹንስ በረ ሞቱማ ኔቡከድኔዘር ሞትቸ ባብሎን ኬሰ ወጋ ቶኮፋት ዱቢን ዋኤ ሰበ ይሁዳ ሁንዳቲፍ ገረ ኤርምያስ ዹፌ ከናዸ። <verse eid="JER 25:1"/><verse number="2" style="v" sid="JER 25:2"/>ከናፉ ኤርምያስ ራጅች ሰበ ይሁዳ ሁንዳፊ ወረ ዬሩሳሌም ኬሰ ጅራተን ሁንዳን አከነ ጄዼ፦ <verse eid="JER 25:2"/><verse number="3" style="v" sid="JER 25:3"/>ወጋ ኩዸ ሰደፋ በረ ሞቱማ ዮስያስ እልመ ኣሞን ሞትቸ ይሁዳቲ ጀልቀቤ ሀመ ጉያ ሀርኣት ጄቹንስ ወጋ ድግደሚ ሰዲ ጉቱ ዱቢን <char style="nd">ዋቀዮ</char> ገረኮ ዹፌረ፤ አንስ እረ ዴዴብኤ እስንት ህሜረ፤ እስን ገሩ ህንዸጌፈትኔ።<verse eid="JER 25:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 25:4"/>ዮ <char style="nd">ዋቀዮ</char> ራጆተሳ ተጃጅልቶተ ሁንደ አሙማ አመ እስንት ኤርጌዩ፣ እስን ህንዸጌፈትኔ ዮካን ጥዬፈትና ቶኮዩ ህንኬንኔፍ። <verse eid="JER 25:4"/><verse number="5" style="v" sid="JER 25:5"/>እሳንስ አከነ ጄዸን፤ “ኤጋ ቶኮን ቶኮንኬሰን ከራኬሰን ጀልኣፊ ሆጂኬሰን ሀማ ሰነራ ዴብኣ፤ ዮስ እስን ብየ <char style="nd">ዋቀዮ</char> እስኒፊ አቦቲኬሰኒፍ በረ በራን ኬኔ ኬሰ ጅራቹ ንደንዴሱ። <verse eid="JER 25:5"/><verse number="6" style="v" sid="JER 25:6"/>እሳን ተጃጅሉፊ እሳን ዋቄፈቹፍ ጄተኒ ዋቆተ ብራ ዱካ ህንቡእና፤ ዋኑመ ሀርክኬሰን ሆጄቴን ዼከምሳፍ ነ ህንከካስና። ዮስ አን እስን ህንሚዹ።”<verse eid="JER 25:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 25:7"/>“እስን ገሩ ነ ህንዸጌፈትኔ፤ ዋኑመ ሀርክኬሰን ሆጄቴን ዼከምሳፍ ነ ከካፍተን፤ መታኬሰንትስ ሚዻ ፍደን” ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 25:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 25:8"/>ከናፉ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ አከነ ጄዼ፦ “ሰበቢ እስን ዱቢኮቲፍ ህንአጀጀምኒፍ፣ <verse eid="JER 25:8"/><verse number="9" style="v" sid="JER 25:9"/>አን ሰቦተ ብየ ካባ ሁንዳፊ ገርብቸኮ ኔቡከድኔዘር ሞትቸ ባብሎን ወልት ቀቤ ብየ ከነት፣ ጅራቶተሼቲፊ ሰቦተ ናኖሼ ጅራተን ሁንደት ነንካሰ፤ ጉቱማን ጉቱት እሳን ነንበሌሰ፤ ዋን ቃኒ፣ ዋን ቱፊቲፊ ዋን በረ በራን ኦኔ እሳን ነንጎዸ” ጄዸ <char style="nd">ዋቀዮ</char>። <verse eid="JER 25:9"/><verse number="10" style="v" sid="JER 25:10"/>“አን ሰገሌ እልሌቲፊ ገመቹ፣ ሰገሌ ምስርቲቲፊ ምስርቻ ሰገሌ ዸጋ ዳኩቲፊ እፈ እብሳ እሳን ኬሳ ነንበሌሰ። <verse eid="JER 25:10"/><verse number="11" style="v" sid="JER 25:11"/>ብይ ኩን ጉቱን በርበዶፍቴ ኦንት፤ ሰቦትን ኩኔንስ ወጋ ቶርባተመ ሞትቸ ባብሎኒቲፍ ገርቦሙ።<verse eid="JER 25:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 25:12"/>“ገሩ ኤርገ ወጋን ቶርባተምን ሱን ዹሜ ቦዴ አን ሞትቸ ባብሎኒቲፊ ሰበሳ፣ ብየ ባብሎኖታስ ሰበቢ የከሳኒቲፍ ነንአደበ፤ ብየቲስ በረ በራን ነንኦንሰ” ጄዸ <char style="nd">ዋቀዮ</char>። <verse eid="JER 25:12"/><verse number="13" style="v" sid="JER 25:13"/>“አን ዋነን ብየቲረት ዱበዼ ሁንደ፣ ዋን ክታበ ከነ ኬሰት በሬፈሜፊ ዋን ኤርምያስ ሰቦተ ሁንደት ራጂ ዱበቴ ሁንደ ብየ ሰነት ነንፍደ። <verse eid="JER 25:13"/><verse number="14" style="v" sid="JER 25:14"/>እሳን መታንሳኒዩ ሰቦተ ሄዱፊ ሞቶተ ጉርጉዶፍ ንገርቦሙ፤ አንስ አኩመ ሆጂሳኒቲፊ አኩመ ሆጂ ሀርከሳኒት ገቲ እሳኒፍ መሉ ነንኬናፍ።”<verse eid="JER 25:14"/></para>
  <para style="s1">ጦፎ ዼከምሰ ዋቃ</para>
  <para style="p">
    <verse number="15" style="v" sid="JER 25:15"/>
    <char style="nd">ዋቀዮ</char> ዋቅን እስራኤል አከነ ናን ጄዼ፦ “ጦፎ ዳዺ ወይኒ ዼከምሰኮቲቲን ጉተሜ ከነ አነ ሀርካ ፉዺቲ ሰቦተ አን እት ስ ኤርጉ ሁንደ ኦባስ። <verse eid="JER 25:15"/><verse number="16" style="v" sid="JER 25:16"/>እሳንስ ዬሮ እሰ ዹገንት ንገተንተሩ፤ ሰበቢ ጎራዴ አን እሳን ግዱት ኤርጉ ሰናቲፍስ ንመራቱ።” <verse eid="JER 25:16"/><verse number="17" style="v" sid="JER 25:17"/>ከናፉ አን ጦፎ ሰነ ሀርከ <char style="nd">ዋቀዮቲ</char> ፉዼ አከ ሰቦትን እን እት ነ ኤርጌ ሁንድ ዹገን ነንጎዼ፦<verse eid="JER 25:17"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="18" style="v" sid="JER 25:18"/>ኩንስ አከ ዬሩሳሌሚፊ መጋላወን ይሁዳ፣ ሞቶትኒፊ ቆንዳልቶትንሼ አኩመ ሀርአ ተአኒ ጅረን ከነ በርበዴፈመኒ ዋን ሰልጵና፣ ዋን ቱፊቲፊ ዋን አባርሳ ተአኒፊዸ፤<verse eid="JER 25:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="JER 25:19"/>ፈረኦን ሞትች ግብጥ፣ ተጃጅልቶትንሳ፣ ቆንዳልቶትንሳቲፊ ሰብንሳ ሁንድ፣ <verse eid="JER 25:19"/><verse number="20" style="v" sid="JER 25:20"/>ነሞትን ብየ ኦርማ ከኔን አች ጅረን ሁንድ፣</para>
  <para style="li1" vid="JER 25:20">ሞቶትን ኡዝ ሁንድ፣</para>
  <para style="li1" vid="JER 25:20">ሞቶትን ፍልስጤሞታ ሁንድ ጄቹንስ ወር ኤቅሮን፣ ወር ጋዛ፣ ወር አሽቀሎኒፊ ሰብን አሽዶድት ሀፌ ሁንድ፣<verse eid="JER 25:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="JER 25:21"/>ኤዶም፣ ሞኣቢፊ አሞን፣<verse eid="JER 25:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="JER 25:22"/>ሞቶትን ጢሮሲፊ ሲዶና ሁንድ፣</para>
  <para style="li1" vid="JER 25:22">ሞቶትን ብዮተ ቀርቀረ ገላና ወር ገላነ ገመ ጅራተን፣<verse eid="JER 25:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="JER 25:23"/>ዴዳን፣ ቴማን፣ ቡዚፊ ወር ብየ ፈጎ ጅራተን ሁንድ፣<verse eid="JER 25:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="JER 25:24"/>ሞቶትን አረባ ሁንዲፊ ሞቶትን ነሞተ ኦርማ ከኔን ገሞጂ ኬሰ ጅራተን ሁንድ፣<verse eid="JER 25:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="JER 25:25"/>ሞቶትን ዝምሪ፣ ከን ኤላሚፊ ከን ሜዴ ሁንድ፣<verse eid="JER 25:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="JER 25:26"/>ሞቶትን ብዮተ ካባ ከኔን ዽኦፊ ፈጎ፣ ወል ዱራ ዱባን ጄቹንስ ሞቶትን ለፈረ ጅረን ሁንድ ዳዺ ሰነ ዹገኒሩ።</para>
  <para style="li1" vid="JER 25:26">ሁንደሳኒ ቦዴሞ ሞቲን ሼሻኪስ ንዹገ።<verse eid="JER 25:26"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="27" style="v" sid="JER 25:27"/>“ኤርገሲ አከነ እሳኒን ጄዽ፤ ‘<char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል ሱን አከነ ጄዸ፦ ሰበቢ ጎራዴ አን እስን ግዱት ኤርጉ ሰናቲፍስ ዹጋ፣ መቻኣ፣ ሆቅሳ፤ አከ ለመተ ኦል ህንካኔፍስ ኩኩፋ።’ <verse eid="JER 25:27"/><verse number="28" style="v" sid="JER 25:28"/>ዮ እሳን ጦፎ ከነ ስ ሀርካ ፉዸኒ ዹጉ ድደን ገሩ አከነ ጄዺን፤ ‘<char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ አከነ ጄዸ፦ እስን ዹጉ ቀብዱ! <verse eid="JER 25:28"/><verse number="29" style="v" sid="JER 25:29"/>ኩኖ፣ አን መጋላ መቃኮቲን ዋመሙት በላ ቡሱ ጀልቀቤረ፤ እስንሞ ኡቱ ህንአደበምን ሀፍቱሬ? እስን ኡቱ ህንአደበምን ህንሀፍተን፤ አን ወረ ለፈረ ጅራተን ሁንደት ጎራዴ ነንዋማቲ፣ ጄዸ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ።’<verse eid="JER 25:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JER 25:30"/>“ከናፉ ዱቢ ከነ ሁንደ እሳንት ራጂቲ አከነ ጄዺን፦</para>
  <para style="q1" vid="JER 25:30">“ ‘<char style="nd">ዋቀዮ</char> ኦል ጉባዻ ጉንጉመ፤</para>
  <para style="q2" vid="JER 25:30">እዶ ጅሬኘሳ ቁልቁሉ ሰና ቀቀዌሰኤ</para>
  <para style="q2" vid="JER 25:30">ብየሳትስ ጉድሴ ንጉንጉመ።</para>
  <para style="q1" vid="JER 25:30">እን አኩመ ወረ እጀ ወይኒ ዽዺተኒት</para>
  <para style="q2" vid="JER 25:30">ወረ ለፈረ ጅራተን ሁንደት ንለለበ።<verse eid="JER 25:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JER 25:31"/>ወጭን ሀመ ዳሪ ለፋት ንዸገአመ፤</para>
  <para style="q2" vid="JER 25:31">
    <char style="nd">ዋቀዮ</char> ሰቦተት ንሙራቲ፤</para>
  <para style="q1" vid="JER 25:31">እን ሰኚ ነማ ሁንደት ሙርቲ ፍደ፤</para>
  <para style="q2" vid="JER 25:31">ሀሞተሞ ጎራዴዻን ፍጠ’ ”</para>
  <para style="q2" vid="JER 25:31">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 25:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JER 25:32"/>
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 25:32">“እላ! ሰባ ገረ ሰባት</para>
  <para style="q2" vid="JER 25:32">በላን በበልአቻ ጅረ፤</para>
  <para style="q1" vid="JER 25:32">ቡቤን ሀማን ጀባን ቶኮ</para>
  <para style="q2" vid="JER 25:32">ዳሪ ለፋቲ ከኣ ጅረ።”<verse eid="JER 25:32"/></para>
  <para style="m">
    <verse number="33" style="v" sid="JER 25:33"/>ጋፈስ ወር <char style="nd">ዋቀዮ</char> ፍጤ ሀንዳረ ለፋ ቶኮ ሀመ ካኒት ፍርፍርፈመኒ አርገሙ። እሳን አኩመ ኮሲ ለፈት ገተሙ መሌ ቦእቸ ህንአርገተን ዮካን ወልት ህንቀበመን ዮካን ህንአዋለመን።<verse eid="JER 25:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="JER 25:34"/>ያ ትክሶተ፣ ቦኣ፣ ወዋዻስ፤</para>
  <para style="q2" vid="JER 25:34">ኤግዶን ቡሻዬስ ዳራረ ገንገለዻ።</para>
  <para style="q1" vid="JER 25:34">ዬሮን እስን እት ጎረአምተን ዹፌራቲ፤</para>
  <para style="q2" vid="JER 25:34">እስን ኩፍተኒ አኩመ ምአ ሱጴ ሚዸጋ ጨጨብዱ።<verse eid="JER 25:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="JER 25:35"/>ትክሶትን እዶ እት በቀተን፣</para>
  <para style="q2" vid="JER 25:35">ኤግዶን ቡሻዬሞ እዶ እት ምልቀን ህንቀበን።<verse eid="JER 25:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="JER 25:36"/>እየ ትክሶታቲፊ ወዋትና</para>
  <para style="q2" vid="JER 25:36">ኤግዶተ ቡሻዬ ዸገኣ!</para>
  <para style="q2" vid="JER 25:36">
    <char style="nd">ዋቀዮ</char> ለፈ ዼደሳኒ በሌሳ ጅራቲ።<verse eid="JER 25:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="JER 25:37"/>ሰበቢ ዼከምሰ <char style="nd">ዋቀዮ</char> ጀባ ሰናቲፍ፣</para>
  <para style="q2" vid="JER 25:37">ለፍት ነጋ ቀቡ ንኦነ።<verse eid="JER 25:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="JER 25:38"/>ሰበቢ ጎራዴ ጩንቁርስቶታቲፊ</para>
  <para style="q2" vid="JER 25:38">ሰበቢ ዼከምሰ <char style="nd">ዋቀዮ</char> ሀማ ሰናቲፍ፣</para>
  <para style="q1" vid="JER 25:38">እን አኩመ ሌንጫ መንኤሳቲ ንበአ፤</para>
  <para style="q2" vid="JER 25:38">ብይሳኒስ ንኦንት።<verse eid="JER 25:38"/></para>
  <chapter eid="JER 25"/>
  <chapter number="26" style="c" sid="JER 26"/>
  <para style="s1">ኤርምያስ ዱኣን ዶርስፈሜ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 26:1"/>ጀልቀበ በረ ሞቱማ ዬሆያቂም እልመ ዮስያስ ሞትቸ ይሁዳ ሰናት ዱቢን ኩን <char style="nd">ዋቀዮ</char> ብራ ዹፌ፦ <verse eid="JER 26:1"/><verse number="2" style="v" sid="JER 26:2"/>“<char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ ኦብዲ መነ <char style="nd">ዋቀዮ</char> ኬሰ ዻበዹቲ ነሞተ መጋላወን ይሁዳ ኬሳ በአኒ መነ <char style="nd">ዋቀዮ</char> ኬሰት ዋቄፈቹ ዹፈን ሁንደት ዱበዹ። ዋን አን ስ አጀጁ ሁንደ እት ህም፤ ጄቸ ቶኮሌ ህንሀምብስን። <verse eid="JER 26:2"/><verse number="3" style="v" sid="JER 26:3"/>ተሪ እሳን ዸገአኒ ቶኮን ቶኮን ነማ ከራሳ ሀማ ሰነራ ንዴብአ ተአ። አንስ ጋቤ በዲሰ ሰበቢ ሀምነሳኒቲፍ እሳንት ፍዱፍ ያዳ ቱሬ ሰነ ነንሀምብሰ። <verse eid="JER 26:3"/><verse number="4" style="v" sid="JER 26:4"/>አትስ አከነ ጄዺን፤ <char style="nd">ዋቀዮ</char> አከነ ጄዸ፤ ‘ዮ እስን ነ ዸገኡ ድደኒ፣ ሴረኮ ከን አን ፉለኬሰን ዱረ ካኤ ሰነ ዱካ ቡኡ ባተን፣ <verse eid="JER 26:4"/><verse number="5" style="v" sid="JER 26:5"/>አመሌ ዮ እስን ዱቢ ተጃጅልቶተኮ ራጆተ አን ኡቱመ እስን ዸገኡ ድደኑ አሙማ አመ እስንት ኤርጌ ሰናሌ ዸጌፈቹ ባተን፣ <verse eid="JER 26:5"/><verse number="6" style="v" sid="JER 26:6"/>አን መነ ከነ አኩመ ሺሎ፣ መጋላ ከነሞ ሰቦተ ለፋ ሁንደ ኬሰት ዋን አባርሳ ነንጎዸ።’ ”<verse eid="JER 26:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 26:7"/>ሉቦትን፣ ራጆትኒፊ ሰብን ሁንድ ኤርምያሲ ዱቢ ከነ መነ <char style="nd">ዋቀዮ</char> ኬሰት ዱበቱ ዸገአን። <verse eid="JER 26:7"/><verse number="8" style="v" sid="JER 26:8"/>ገሩ አኩመ ኤርምያስ ዋን <char style="nd">ዋቀዮ</char> አከ እን ዱበቱፍ እሰ አጀጄ ሁንደ ነሞተ ሁንደት፣ ህሜ ራወቴን ሉቦትን፣ ራጆትኒፊ ነሞትን ሁንድ እሰ ቀበኒ አከነ ጄዸኒን፤ “አት ዱኡ ቀብደ! <verse eid="JER 26:8"/><verse number="9" style="v" sid="JER 26:9"/>አት ማሊፍ አከ መን ኩን አኩመ ሺሎ ተኡፊ አከ መጋላን ኩንስ ኦኔ ዱዋ ሀፉ መቃ <char style="nd">ዋቀዮቲን</char> ራጂ ዱበተ?” ነሞትን ሁንድስ መነ <char style="nd">ዋቀዮ</char> ኬሰት ኤርምያስን መርሰን።<verse eid="JER 26:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 26:10"/>ቆንዳልቶትን ይሁዳ ዮሙ ዋን ከነ ዸገአንት መነ ሞቲ ኬሳ ገረ መነ <char style="nd">ዋቀዮት</char> ኦል በአኒ በልበለ ከረ ሃራ ከን መነ <char style="nd">ዋቀዮ</char> ዱረ ተታአን። <verse eid="JER 26:10"/><verse number="11" style="v" sid="JER 26:11"/>ከነረት ሉቦትኒፊ ራጆትን ሱን ቆንዳልቶታፊ ነሞተ ሁንዳን፣ “ዋን ነምች ኩን መጋላ ከነረት ራጂ ዱበቴፍ ዱት እሰት ሙረሙ ቀበ። እስን ዋን ከነ ጉሩመኬሰኒን ዸጌሰኒርቱ!” ጄዸን።<verse eid="JER 26:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 26:12"/>ኤርምያስ ቆንዳልቶተ ሁንዳፊ ነሞተ ሁንዳን አከነ ጄዼ፤ “<char style="nd">ዋቀዮ</char> አከ አን ዋን እስን ዸጌሰን ከነ ሁንደ መነ ከናፊ መጋላ ከነረት ራጂ ዱበዹፍ ነ ኤርጌ። <verse eid="JER 26:12"/><verse number="13" style="v" sid="JER 26:13"/>ከናፉ እስን አመ ከራኬሰኒፊ ሆጂኬሰን ቀጄልፈዻ፤ <char style="nd">ዋቀዮ</char> ዋቀኬሰኒፍሌ አጀጀማ። ዮስ <char style="nd">ዋቀዮ</char> ጋቤ በላ እስንት ፍዱፍ ያዴ ሰነ ንዺሰ። <verse eid="JER 26:13"/><verse number="14" style="v" sid="JER 26:14"/>አን ገሩ ሀርኩመኬሰን ኬሰ ነንጅረ፤ እስን ተርካንፊ ጋሪፊ ቀጄላ እስንት ፈካቴ ነረት ፉዸዻ። <verse eid="JER 26:14"/><verse number="15" style="v" sid="JER 26:15"/>ገሩ እስን ዮ ነ አጄፍተን አከ ዺገ ነመ በሌሳ ህንቀብኔ ዸንገላሱኬሰኒን ኦፍት፣ መጋላ ከነቲፊ ወረ እሼ ኬሰ ጅራተንት በላ ፍደን ቤከዻ፤ <char style="nd">ዋቀዮ</char> ዹጉማን አከ አን ዱቢ እስን ዸጌሰን ከነ ሁንደ ዱበዹፍ እስንት ነ ኤርጌራቲ።”<verse eid="JER 26:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 26:16"/>ከነረት ቆንዳልቶትኒፊ ነሞትን ሁንድ፣ ሉቦታፊ ራጆታን፣ “ነምቸ ከነት ዱት ሙረሙ ህንቀቡ! እን መቃ <char style="nd">ዋቀዮ</char> ዋቀኬኛቲን ኑት ዱበቴ ጅራ” ጄዸን።<verse eid="JER 26:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 26:17"/>ማንጉዶተ ብያ ኬሳስ ቶኮ ቶኮ ከአኒ ወልዳ ሰባ ጉቱዻን አከነ ጄዸን፤ <verse eid="JER 26:17"/><verse number="18" style="v" sid="JER 26:18"/>“በረ ህስቅያስ ሞቲ ይሁዳ ቱሬ ኬሰ ሚክያስ ነምን ብየ ሞሬሼት አከነ ጄዼ ሰበ ይሁዳ ሁንደት ራጂ ዱበቴ፤ ‘<char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 26:18">“ ‘ጥዮን አኩመ ለፈ ቆቲሳት ቆተምት፤</para>
  <para style="q2" vid="JER 26:18">ዬሩሳሌምስ ቱላ ዋን ዲገሜ ታት፤</para>
  <para style="q2" vid="JER 26:18">ጋር መነ ቁልቁሉማስ ተበ ደገላን ልቅምፈሜ ተአ።’<verse eid="JER 26:18"/></para>
  <para style="m">
    <verse number="19" style="v" sid="JER 26:19"/>“ህስቅያስ ሞትች ይሁዳ ዮካን ሰበ ይሁዳ ኬሳ ነምን ቶኮዩ እሰ አጄሴራ? ህስቅያስ <char style="nd">ዋቀዮን</char> ሶዳቴ አራረሳ ህንከዸትኔ? <char style="nd">ዋቀዮስ</char> ጋቤ በዲሰ እሳንት ፍዱ ያዴ ሰነ ህንዺፍኔ? ኑስ በዲሰ ሀማ ኦፍት ፍዱ ጌኜረ!”<verse eid="JER 26:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 26:20"/>ነምን መቃ <char style="nd">ዋቀዮቲን</char> ራጂ ዱበቴ ከን ብራሞ ኡርያ እልመ ሼማእያ ነመ ብየ ክርያት ዬኣሪም ቱሬ፤ እንስ አኩመ ኤርምያስ መጋላ ከናፊ ብየ ከነረት ራጂ ዱበቴ። <verse eid="JER 26:20"/><verse number="21" style="v" sid="JER 26:21"/>ዮሙ ዬሆያቂም ሞትች፣ አጀጆትኒፊ ቆንዳልቶትንሳ ሁንድ ዱቢ ኡርያ ዸገአንት ሞትች እሰ አጄስሱ በርባዴ፤ ኡርያን ገሩ ዋን ከነ ዸጌኛን ሶዳቴ ገረ ግብጥት በቀቴ። <verse eid="JER 26:21"/><verse number="22" style="v" sid="JER 26:22"/>ዬሆያቂም ሞትች ገሩ ኤልናታን እልመ አክቦር ነሞተ ብራ ወጅን ገረ ግብጥት ኤርጌ። <verse eid="JER 26:22"/><verse number="23" style="v" sid="JER 26:23"/>እሳንስ ኡርያ ግብጢ ፍደኒ ዬሆያቂም ሞትቸት ኬነን፤ ሞትችስ ጎራዴዻን እሰ አጄሴ፤ ሬፈሳሞ እዶ ነሞትን ኡልፍነ ህንቀብኔ እት አዋለመንት ገቴ።<verse eid="JER 26:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 26:24"/>አሂቃም እልም ሻፋን ገሩ ኤርምያስን ዴገሬ፤ ከናፉ ኤርምያስ አጄፈሙፍ ደበርፈሜ ነሞተት ህንኬነምኔ።<verse eid="JER 26:24"/></para>
  <chapter eid="JER 26"/>
  <chapter number="27" style="c" sid="JER 27"/>
  <para style="s1">ይሁዳን ኔቡከድኔዘር ተጃጅለ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 27:1"/>ጀልቀበ በረ ዜዴቅያ እልም ዮስያስ ሞቲ ይሁዳ ቱሬት ዱቢን ኩን <char style="nd">ዋቀዮ</char> ብራ ገረ ኤርምያስ ዹፌ፦ <verse eid="JER 27:1"/><verse number="2" style="v" sid="JER 27:2"/><char style="nd">ዋቀዮ</char> አከነ ናን ጄዼ፤ “ቴጳፊ ደንቀራዻን ዋንጆ ቶልቺቲ ሞርመኬት ካአዹ። <verse eid="JER 27:2"/><verse number="3" style="v" sid="JER 27:3"/>ኤርገሲ ከራ ኤርገሞተ ዜዴቅያ ሞትቸ ይሁዳ ብረ ገረ ዬሩሳሌም ዹፈኒቲን ገረ ሞቲ ኤዶም፣ ሞቲ ሞኣብ፣ ሞቲ አሞን፣ ሞቲ ጢሮሲፊ ሞቲ ሲዶናት ዻምሰ ኤርግ። <verse eid="JER 27:3"/><verse number="4" style="v" sid="JER 27:4"/>ጎፍቶተሳኒቲፍ ዻምሰ ከነ ደበርሲ አከነ ጄዺን፤ ‘<char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል አከነ ጄዸ፤ “ዋን ከነ ጎፍቶተኬሰንት ህማ። <verse eid="JER 27:4"/><verse number="5" style="v" sid="JER 27:5"/>አን ሁምነኮ ጉዳፊ እሬኮ ድሪርፈሜን ለፈ፣ ኡመተሼቲፊ ብኔንሶተ እሼረ ጅራተን ኡሜረ፤ አባ ፌዼፍሌ ነንኬነ። <verse eid="JER 27:5"/><verse number="6" style="v" sid="JER 27:6"/>አን አመ ብዮተኬሰን ሁንደ ሀርከ ገርብቸኮ ኔቡከድኔዘር ሞትቸ ባብሎኒት ደበርሴ ነንኬነ። አከ ብኔንሶትን ቦሶናዩ እሰ ጀለት ቡለን ነንጎዸ። <verse eid="JER 27:6"/><verse number="7" style="v" sid="JER 27:7"/>ሀመ ጉያን ብየሳ ገኡት ሰቦትን ሁንድ እሰ፣ እልማንሳቲፊ እልማን እልማንሳ ተጃጅሉ፤ ኤርገሲሞ ሰቦትን ሄዱኒፊ ሞቶትን ጉርጉዳን እሰ ገርቦምፈቱ።<verse eid="JER 27:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 27:8"/>“ ‘ “ገሩ ዮ ሰብን ዮካን ሞቱማን ከምዩ ኔቡከድኔዘር ሞትቸ ባብሎን ህንተጃጅሌ ዮካን ዮ ሞርመሳ ዋንጆ ሞትቻቲፍ ገድ ህንቀበትኔ አን ሀመን ሀርኩመሳቲን እሳን በሌሱት ሰበ ሰነ ጎራዴዻን፣ ቤላፊ ዸእቻን ነንአደበ፣ ጄዸ <char style="nd">ዋቀዮ</char>። <verse eid="JER 27:8"/><verse number="9" style="v" sid="JER 27:9"/>ከናፉ እስን ራጆተኬሰን፣ እላልቶተኬሰን፣ ወረ አብጁ እስኒፍ ሂከን፣ ኤኬር ዱብስቶተኬሰኒፊ ፈልፈልቶተኬሰን ከኔን፣ ‘እስን ሞቲ ባብሎን ህንተጃጅልተን’ እስኒን ጄዸን ሰነ ህንዸገእና። <verse eid="JER 27:9"/><verse number="10" style="v" sid="JER 27:10"/>እሳን አከ እስን ብየኬሰን ኬሳ ቡቅፈምተኒ ፈጋተኒፍ ሶበ እስኒፍ ራጁ፤ አንስ አርኤ እስን ነንባሰ፤ እስንስ ንበዱ። <verse eid="JER 27:10"/><verse number="11" style="v" sid="JER 27:11"/>ገሩ ዮ ሰብን ከምዩ ሞርመሳ ዋንጆ ሞቲ ባብሎኒቲፍ ገድ ቀበቴ እሰ ተጃጅሌ፣ አን አከ ሰብን ሱን ብየ ኦፊሳ ኬሰት ሀፌ ለፈ ቆተቴ አች ጅራቱ ነንዺሰ፣ ጄዸ <char style="nd">ዋቀዮ</char>።” ’ ”<verse eid="JER 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 27:12"/>አንስ ዜዴቅያ ሞትቸ ይሁዳት ኤርጋዹመ ከነ ነንህሜ። አከነን ጄዼን፤ “ሞርመኬሰን ዋንጆ ሞቲ ባብሎኒቲፍ ገድ ቀበዻ፤ እሳፊ ሰበሳ ተጃጅላ፤ እስንስ ንጅራቱ። <verse eid="JER 27:12"/><verse number="13" style="v" sid="JER 27:13"/>አቲፊ ሰብንኬ ማሊፍ ጎራዴ፣ ቤላፊ ዸእቸ <char style="nd">ዋቀዮ</char> እቲን ሰበ ሞቲ ባብሎን ህንተጃጅሌ ከምዩ ሶዳችሴን ዱቱ? <verse eid="JER 27:13"/><verse number="14" style="v" sid="JER 27:14"/>ዱቢ ራጆተ፣ ‘እስን ሞቲ ባብሎን ህንተጃጅልተን’ እስኒን ጄዸኒ ህንዸገእና፤ እሳን ራጂ ሶባ እስንት ዱበቱቲ። <verse eid="JER 27:14"/><verse number="15" style="v" sid="JER 27:15"/>‘አን እሳን ህንኤርግኔ’ ጄዸ <char style="nd">ዋቀዮ</char>። ‘ጀር መቃኮቲን ሶበ ራጁ። ከናፉ አን እስኒፊ ራጆተ እስኒ ራጀንሌ አርኤ ነንባሰ፤ እስንስ ንበዱ።’ ”<verse eid="JER 27:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 27:16"/>አንስ ሉቦታፊ ነሞተ ከነ ሁንዳን አከነን ጄዼ፣ “<char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ ራጆተ፣ ‘ምእ መነ <char style="nd">ዋቀዮ</char> አሙመ ባብሎኒ ንዴብፈመ’ ጄዸን ህንዸገእና። እሳን ሶበ እስኒፍ ራጁ። <verse eid="JER 27:16"/><verse number="17" style="v" sid="JER 27:17"/>እስን ጀረ ህንዸጌፈትና። ሞቲ ባብሎን ተጃጅላ፤ ንጅራቱቲ። መጋላን ኩን ማሊፍ ዲገምት? <verse eid="JER 27:17"/><verse number="18" style="v" sid="JER 27:18"/>እሳን ዮ ራጆተ ተአኒፊ ዮ ዱቢ <char style="nd">ዋቀዮ</char> ኦፍ ኬሳ ቀባተን ሜ አከ ምእ መነ <char style="nd">ዋቀዮ</char> ከን መሰራ ሞቲ ይሁዳቲፊ ዬሩሳሌም ኬሰት ሀፌ ሱን ገረ ባብሎንት ህንፉዸተምኔፍ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ ሃከዸተን። <verse eid="JER 27:18"/><verse number="19" style="v" sid="JER 27:19"/><char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ ዋኤ ኡቱቦታ፣ ዋኤ ምአ ብሻን እት ኩሰኒ፣ ዋኤ ባቱወኒቲፊ ዋኤ ምኦተ መጋላ ከነት ሀፈን ከኔን ብራ አከነ ጄዻቲ፤ <verse eid="JER 27:19"/><verse number="20" style="v" sid="JER 27:20"/>ኔቡከድኔዘር ሞቲን ባብሎን ሱን ጋፈ ዬሆያኪን እልመ ዬሆያቂም ሞትቸ ይሁዳ ሰነ ነሞተ ይሁዳቲፊ ዬሩሳሌም ኡልፋቶ ሁንደ ወጅን ዬሩሳሌሚ ገረ ባብሎንት ቦጅኤ ሰነ ምኦተ ከኔን ህንፉዸትኔ። <verse eid="JER 27:20"/><verse number="21" style="v" sid="JER 27:21"/><char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል ዋኤ ምኦተ መነ <char style="nd">ዋቀዮቲፊ</char> መሰራ ሞቲ ይሁዳቲፊ ዬሩሳሌም ኬሰት ሀፈኒ አከነ ጄዸ፦ <verse eid="JER 27:21"/><verse number="22" style="v" sid="JER 27:22"/>‘እሳን ባብሎንት ንጌፈሙ፤ ሀመ ጉያን አን እሳኒፍ ዹፉ ገኡትስ አቹመ ቱሩ’ ጄዸ <char style="nd">ዋቀዮ</char>። ‘ኤርገሲ አን ዴብሴ እዶ ከነት እሳን ነንፍደ።’ ”<verse eid="JER 27:22"/></para>
  <chapter eid="JER 27"/>
  <chapter number="28" style="c" sid="JER 28"/>
  <para style="s1">ሀናንያ ራጂ ሶባ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 28:1"/>ጀልቀበ ቡልቺንሰ ሞቱማ ዜዴቅያ ሞቲ ይሁዳት፣ ጅአ ሸነፋ ወጋ ሰናት፣ ወጋ አፉረፋት፣ ሀናንያን ራጅች እልም አዙር፣ ነምን ግቤኦን ሱን መነ <char style="nd">ዋቀዮ</char> ኬሰት፣ ፉለ ሉቦታቲፊ ኡመተ ሁንዳ ዱረት አከነ ናን ጄዼ፦ <verse eid="JER 28:1"/><verse number="2" style="v" sid="JER 28:2"/>“<char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል አከነ ጄዸ፤ ‘አን ዋንጆ ሞቲ ባብሎን ነንጨብሰ። <verse eid="JER 28:2"/><verse number="3" style="v" sid="JER 28:3"/>አን ወጋ ለመ ኬሰት ምኦተ መነ <char style="nd">ዋቀዮ</char> ከኔን ኔቡከድኔዘር ሞትች ባብሎን አሲ ጉሬ ባብሎንት ጌሴ ሁንደ እዶ ከነት ዴብሴ ነንፍደ። <verse eid="JER 28:3"/><verse number="4" style="v" sid="JER 28:4"/>አን አመሌ ዬሆያኪን እልመ ዬሆያቂም ሞትቸ ይሁዳ ሰናፊ ቦጅአምቶተ ይሁዳዻ ገረ ባብሎንት ጌፈመን ካን ሁንደ እዶ ከነት ዴብሴ ነንፍደ፤ አን ዋንጆ ሞቲ ባብሎን ነንጨብሳቲ’ ጄዸ <char style="nd">ዋቀዮ</char>።”<verse eid="JER 28:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 28:5"/>ኤርምያስ ራጅች ፉሉመ ሉቦታቲፊ ኡመተ መነ <char style="nd">ዋቀዮ</char> ኬሰ ዻበቻ ቱረን ሁንዳ ዱረት አከነ ጄዼ ሀናንያ ራጅቻፍ ዴቢ ኬኔ፤ <verse eid="JER 28:5"/><verse number="6" style="v" sid="JER 28:6"/>“አሜን! <char style="nd">ዋቀዮ</char> ዋን ከነ ሃጎዹ! <char style="nd">ዋቀዮ</char> ምአ መነ <char style="nd">ዋቀዮቲፊ</char> ቦጅአምቶተ ቦጅአመን ሁንደ ባብሎኒ እዶ ከነት ዴብሱዻን ራጂ አት ዱበቴ ሃራወቱ። <verse eid="JER 28:6"/><verse number="7" style="v" sid="JER 28:7"/>ተኡስ ዋን አን ኡቱ አቲፊ ነሞትን ኩን ሁንድ ዸጌሰኑ ዱበዹ ከነ ዸገእ፦ <verse eid="JER 28:7"/><verse number="8" style="v" sid="JER 28:8"/>ራጆትን አናፊ ሲን ዱረ ቱረን በረ ዱሪቲ ጀልቀበኒ አከ ብዮተ ባይኤፊ ሞቱሞተ ጉርጉዶት ወራን፣ በዲስኒፊ ዸእች ዹፉ ራጀኒሩ። <verse eid="JER 28:8"/><verse number="9" style="v" sid="JER 28:9"/>ራጂን ነጋ ራጁ ገሩ ዮ ራጂንሳ ሱን ፊጣን በኤ ቆፈ አከ <char style="nd">ዋቀዮ</char> ብራ ኤርገሜ ቤከመ።”<verse eid="JER 28:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 28:10"/>ኤርገሲ ሀናንያን ራጅች ሞርመ ኤርምያስ ራጅቻራ ዋንጆ ፉዼ ጨብሴ፤ <verse eid="JER 28:10"/><verse number="11" style="v" sid="JER 28:11"/>እንስ ፉለ ነመ ሁንዳ ዱረት አከነ ጄዼ፤ “<char style="nd">ዋቀዮ</char> አከነ ጄዸ፤ ‘አን ወጋ ለመ ኬሰት ዋንጆ ኔቡከድኔዘር ሞትቸ ባብሎን ሞርመ ሰቦተ ሁንዳራ አከኑመ ነንጨብሰ።’ ” ከነረት ኤርምያስ ራጅች ከራሳ ቀበቴ ቀጄሌ።<verse eid="JER 28:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 28:12"/>ኤርገ ሀናንያን ራጅች ዋንጆ ሞርመ ኤርምያስ ራጅቻራ ጨብሴ ቦዴ ዱቢን <char style="nd">ዋቀዮ</char> አከነ ጄዼ ገረ ኤርምያስ ዹፌ፦ <verse eid="JER 28:12"/><verse number="13" style="v" sid="JER 28:13"/>“ዸቂቲ አከነ ጄዺ ሀናንያት ህም፤ ‘<char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ አት ዋንጆ ሙካ ጨብስቴርተ፤ ገሩ ቆደሳ ዋንጆ ስቢላ ንአርገተ። <verse eid="JER 28:13"/><verse number="14" style="v" sid="JER 28:14"/><char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል አከነ ጄዸ፦ አን አከ እሳን ኔቡከድኔዘር ሞትቸ ባብሎን ተጃጅለን ጎቹፍ ሞርመ ሰቦተ ከነ ሁንዳረ ዋንጆ ስቢላ ነንከኣ፤ እሳንስ እሰ ንተጃጅሉ። አን ብኔንሰረትሌ ኦል ኣንቱማ እሳፍ ነንኬነ።’ ”<verse eid="JER 28:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 28:15"/>ኤርምያስ ራጅችስ ሀናንያ ራጅቻን አከነ ጄዼ፦ “ያ ሀናንያ ዸገእ! <char style="nd">ዋቀዮ</char> ስ ህንኤርግኔ፤ አት ገሩ አከ ሰብን ኩን ሶባ አብደቱ ጎቴርተ። <verse eid="JER 28:15"/><verse number="16" style="v" sid="JER 28:16"/>ከናፉ <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ ‘አን ለፈራ ስን በሌሰ፤ አት ዋን <char style="nd">ዋቀዮረት</char> ፍንጭለ ለለብዴፍ በሩመ ከነ ዱተ።’ ”<verse eid="JER 28:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 28:17"/>ሀናንያ ራጅችስ ወጉመ ሰነ ኬሰ ጅአ ቶርበፋት ዱኤ።<verse eid="JER 28:17"/></para>
  <chapter eid="JER 28"/>
  <chapter number="29" style="c" sid="JER 29"/>
  <para style="s1">ጠለያ ቦጅአምቶታፍ ኤርገሜ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 29:1"/>ዱቢን ጠለያ ከን ኤርምያስ ራጅች ዬሩሳሌምራ ገረ ማንጉዶተ ነሞተ ቦጅአመን ግዱት ሀፈኒቲፊ ሉቦተት፣ ራጆተቲፊ ወረ ኔቡከድኔዘር ዬሩሳሌሚ ቦጅኤ ባብሎንት ጌሴ ካን ሁንደት ኤርጌ ሰና ከናዸ። <verse eid="JER 29:1"/><verse number="2" style="v" sid="JER 29:2"/>ኩንስ ኤርገ ዬሆያኪን ሞትቺፊ ሃትሳ ሞትቲን፣ ጡኣሺወን፣ ዱረ ቡቶተ ይሁዳቲፊ ዬሩሳሌም፣ ኦጌዪ ሆጂ ሙካቲፊ ቱምቱወን ዬሩሳሌሚ ቦጅአመኒ ዴመኒ ቦዴ ተኤ። <verse eid="JER 29:2"/><verse number="3" style="v" sid="JER 29:3"/>እንስ ጠለያ ሰነ ሀርከ ኤሌኣሳ እልመ ሻፋኒቲፊ ጌማርያ እልመ ህልቅያ ወረ ዜዴቅያ ሞትች ይሁዳ ገረ ኔቡከድኔዘር ሞትቸ ባብሎንት ኤርጌ ሰናት ኬኔ። ጠለያን ሱንስ አከነ ጄዸ፦<verse eid="JER 29:3"/></para>
  <para style="pm">
    <verse number="4" style="v" sid="JER 29:4"/>
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል ወረ ቦጁዻን ዬሩሳሌሚ ገረ ባብሎንት ጌፈመን ሁንዳን አከነ ጄዸ፦ <verse eid="JER 29:4"/><verse number="5" style="v" sid="JER 29:5"/>“መኔን እጃረዻቲ ኬሰ ጅራዻ፤ ብቅልቱ ዻበዻቲ እጀሳ ኛዻ። <verse eid="JER 29:5"/><verse number="6" style="v" sid="JER 29:6"/>ኒቲ ፉዻቲ እልማኒፊ እንተለን ዸልቻ፤ አከ እሳንስ እልማኒፊ እንተለን ዸልቸኒፍ እልማንኬሰን ኒቲ ፉስሳ፤ እንተለንኬሰንሌ ሄሩምሲሳ። እስንስ አችት ባይአዻ መሌ ህንጥናትና። <verse eid="JER 29:6"/><verse number="7" style="v" sid="JER 29:7"/>መጋላ አን ቦጁዻን እት እስን ኤርጌፍሌ ነጋፊ በዻዹማ ሀዋ። ዮ እሼን በዻቴ፣ እስንስ ዋን በዻተኒፍ እሼዻፍ <char style="nd">ዋቀዮን</char> ከዸዻ።” <verse eid="JER 29:7"/><verse number="8" style="v" sid="JER 29:8"/><char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል አከነ ጄዻቲ፦ “ራጆታፊ እላልቶተ እስን ግዱ ጅራተኒን ህንጎዎምፈምና። አብጁ አከ እሳን አብጆተኒፍ እሳን ከካፍተን ሰነ ህንዸጌፈትና። <verse eid="JER 29:8"/><verse number="9" style="v" sid="JER 29:9"/>እሳን መቃኮቲን ሶበ እስኒፍ ራጁ። አን እሳን ህንኤርግኔ” ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 29:9"/></para>
  <para style="pm">
    <verse number="10" style="v" sid="JER 29:10"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ “ዬሮ ወጋን ቶርባተምን ባብሎኒፍ ኬነሜ ሱን ጡሙረሙት አን ገረኬሰን ዹፌን ዋዳ አከ እዶ ከነት እስን ዴብሱፍ ገሌ ሰነ ነንራወዸ። <verse eid="JER 29:10"/><verse number="11" style="v" sid="JER 29:11"/>ያደ አን እስኒፍ ቀቡ አነቱ ቤካቲ፤ እንስ ያደ ነጋት መሌ ያደ ሀማ ምት፤ አከሱመስ ያደ አብዲቲፊ ከን ገልገለኬሰኒፍ ቶሉዸ” ጄዸ <char style="nd">ዋቀዮ</char>። <verse eid="JER 29:11"/><verse number="12" style="v" sid="JER 29:12"/>“እስንስ ነ ዋመቱ፤ ዹፍተኒስ ነ ከዸቱ፤ አንስ እስን ነንዸገአ። <verse eid="JER 29:12"/><verse number="13" style="v" sid="JER 29:13"/>እስን ዮ ገራኬሰን ጉቱዻን ነ በርባደን፣ ነ አርገቱ። <verse eid="JER 29:13"/><verse number="14" style="v" sid="JER 29:14"/>አንስ አከ እስን ነ አርገተን ነንጎዸ፤ ቦጁዻ ዴብሴስ እስን ነንፍደ” ጄዸ <char style="nd">ዋቀዮ</char>። “አን ሰቦታፊ ለፈ አን እት እስን አርኤ ቱሬ ሁንደ ኬሳ ወልት እስን ቀቤ ገረ ብየ አን ኬሳ ባሴ እስን ቦጅአምሲሴ ሰናት ዴብሴ እስነን ፍደ” ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 29:14"/></para>
  <para style="pm">
    <verse number="15" style="v" sid="JER 29:15"/>ሰበቢ እስን፣ “<char style="nd">ዋቀዮ</char> ባብሎን ኬሰት ራጆተ ኑ ካሴረ” ጄተኒፍ <verse eid="JER 29:15"/><verse number="16" style="v" sid="JER 29:16"/><char style="nd">ዋቀዮ</char> ዋኤ ሞቲ ቴሶ ዳዊትራ ታኡቲፊ ዋኤ ነሞተ መጋላ ከነ ኬሰት ሀፈን ሁንዳ፣ ፍሮተኬሰን ከኔን እስን ወጅን ቦጅአመኒ ባብሎንት ህንጌፈምኒ አከነ ጄዸ፤ <verse eid="JER 29:16"/><verse number="17" style="v" sid="JER 29:17"/><char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ አከነ ጄዸ፦ “አን ጎራዴ፣ ቤላፊ ዸእቸ እሳንት ነንኤርገ፤ አከ እሳን አኩመ እጀ ሀርቡ ከን ቶርቶሬ ነምን ኛቹ ህንደንዴኜ ተአንስ እሳን ነንጎዸ። <verse eid="JER 29:17"/><verse number="18" style="v" sid="JER 29:18"/>አን ጎራዴ፣ ቤላፊ ዸእቻን እሳን ነንአርአ፤ አከ እሳን ሰቦተ አን እት እሳን አርኤ ሁንደ ግዱት ዋን አባርሳቲፊ ዋን ሶዳችሳ፣ ዋን ቱፊቲፊ ዋን ፈፋ ተአኒፍ አን ፉለ ሞቱሞተ ለፋ ሁንዳ ዱረት ጅብሲሶ እሳን ነንጎዸ። <verse eid="JER 29:18"/><verse number="19" style="v" sid="JER 29:19"/>እሳን ዱቢኮ፣ ዱቢ አን አሙማ አመ ከራ ተጃጅልቶተኮ ራጆታቲን እሳንት ኤርጌ ህንዸጌፈኔቲ” ጄዸ <char style="nd">ዋቀዮ</char>። “እስን ወር ቦጅአምተንስ አከሱመ ህንዸጌፈትኔ” ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 29:19"/></para>
  <para style="pm">
    <verse number="20" style="v" sid="JER 29:20"/>ከናፉ እስን ቦጅአምቶትን አን ዬሩሳሌሚ ባሴ ገረ ባብሎንት ኤርጌ ሁንድ ዱቢ <char style="nd">ዋቀዮ</char> ዸገኣ። <verse eid="JER 29:20"/><verse number="21" style="v" sid="JER 29:21"/><char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል ዋኤ አሃብ እልመ ቆላያቲፊ ዋኤ መአሴያ እልመ ዜዴቅያ ወረ መቃኮቲን ራጂ ሶባ እስንት ዱበተን ሰና አከነ ጄዸ፦ “አን ደበርሴ ኔቡከድኔዘር ሞትቸ ባብሎንት እሳን ኬነ፤ እንስ እጁመኬሰን ዱረት እሳን ፍጠ። <verse eid="JER 29:21"/><verse number="22" style="v" sid="JER 29:22"/>ሰበቢሳኒቲፍስ ቦጅአምቶትን ይሁዳ ወር ብየ ባብሎን ጅራተን፣ ‘<char style="nd">ዋቀዮ</char> አከ ዜዴቅያቲፊ አከ አሃብ ወረ ኔቡከድኔዘር ሞትች ባብሎን እብዳን ጉቤ ሰና ስ ሃጎዹ!’ ጄዸኒ ወል አባሩ። <verse eid="JER 29:22"/><verse number="23" style="v" sid="JER 29:23"/>እሳን ዋን አከ መሌ ሀማ ተኤ እስራኤል ኬሰት ሆጄተኒሩቲ፤ እሳን ኒቶተ ኦላሳኒ ወጅን ኤጀኒሩ፤ ዋን አን አከ እሳን ሆጄተን እሳንት ህንህምን ሆጄቹዻን መቃኮቲን ሶበ ዱበተኒሩ፤ አን ዋን ከነ ነንቤከ፤ ዹጋሌ ነንበአ” ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 29:23"/></para>
  <para style="s1">ዻምሰ ሼማእያት ኤርገሜ</para>
  <para style="p">
    <verse number="24" style="v" sid="JER 29:24"/>ሼማእያ ነምቸ ኔሄላሚን አከነ ጄዽ፦ <verse eid="JER 29:24"/><verse number="25" style="v" sid="JER 29:25"/>“<char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል አከነ ጄዸ፦ አት ነሞተ ዬሩሳሌም ኬሰ ጅራተን ሁንደት፣ ሴፋንያ እልመ መአሴያ ሉብቻቲፊ ሉቦተ ብራ ሁንደት መቃኬቲን ጠለያ ኤርግቴርተ። ሴፋንያንስ አከነ ጄቴርተ፤ <verse eid="JER 29:25"/><verse number="26" style="v" sid="JER 29:26"/>‘<char style="nd">ዋቀዮ</char> አከ አት መነ <char style="nd">ዋቀዮ</char> ኬሰት እት ጋፈተማ ታቱፍ እዶ ዬሆያዳ ሉበ ጎዼ ስ ሙዴረ፤ አት መራቱ ራጂ ዱበቱ ከምዩ ሚለሳ ጅርመ ግዱ፣ ሞርመሳሞ ሁዻ ስቢላ ኬሰ ገልችቴ ህዹ ቀብደ። <verse eid="JER 29:26"/><verse number="27" style="v" sid="JER 29:27"/>ዮስ አት ማሊፍ ኤርምያስ ነምቸ አናቶት ከን ግዱኬሰንት ራጂ ዱበቱ ሰነ እፈቹ ዺፍቴሬ? <verse eid="JER 29:27"/><verse number="28" style="v" sid="JER 29:28"/>እን አከነ ጄዼ ዻምሰ ከነ ገረኬኘ፣ ገረ ባብሎንት ኤርጌረ፦ በር ቦጁ ንዼረተ። ከናፉ መኔን እጃረዻቲ ኬሰ ጅራዻ፤ ብቅልቱሌ ዻበዻ እጀሳ ኛዻ።’ ”<verse eid="JER 29:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JER 29:29"/>ሴፋንያ ሉብችስ ጠለያ ሰነ ኤርምያስ ራጅቻፍ ዱብሴ። <verse eid="JER 29:29"/><verse number="30" style="v" sid="JER 29:30"/>ከነረት ዱቢን <char style="nd">ዋቀዮ</char> አከነ ጄዼ ገረ ኤርምያስ ዹፌ፦ <verse eid="JER 29:30"/><verse number="31" style="v" sid="JER 29:31"/>“ኤርጋ ከነ ቦጅአምቶተ ሁንደት ኤርግ፤ ‘<char style="nd">ዋቀዮ</char> ዋኤ ሼማእያ ነምቸ ኔሄላም ሰና አከነ ጄዸ፦ ዋን ሼማእያን ዮ አን እሰ ኤርጉ ባዼዩ ራጂ እስኒ ዱበቴ አከ እስን ሶበ አመነተን ጎዼፍ <verse eid="JER 29:31"/><verse number="32" style="v" sid="JER 29:32"/><char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ አን ዹጉማን ሼማእያ ነምቸ ኔሄላም ሰናፊ ሰኚሳ ነንአደበ። እን ሰበ ከነ ግዱት ሀምባ ቶኮዩ ህንቀባቱ ዮካን ዋን ጋሪ አን ሰበኮቲፍ ጎዹ ህንአርጉ፤ እን ነ ሞርሙን ፍንጭለ ለለቤራቲ’ ጄዸ <char style="nd">ዋቀዮ</char>።”<verse eid="JER 29:32"/></para>
  <chapter eid="JER 29"/>
  <chapter number="30" style="c" sid="JER 30"/>
  <para style="s1">ሰብን እስራኤል ቦጁዻ ዴብኤ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 30:1"/>ዱቢን <char style="nd">ዋቀዮ</char> ብራ ገረ ኤርምያስ ዹፌ እሰ ከናዸ፦ <verse eid="JER 30:1"/><verse number="2" style="v" sid="JER 30:2"/>“<char style="nd">ዋቀዮ</char> ዋቅን እስራኤል አከነ ጄዸ፦ ‘ዱቢ አን ስት ዱበዼ ሁንደ ክታበት በሬስ። <verse eid="JER 30:2"/><verse number="3" style="v" sid="JER 30:3"/>በር ቶኮ ንዹፈ’ ጄዸ <char style="nd">ዋቀዮ</char>፤ ‘እንስ ዬሮ አን እት ሰበኮ እስራኤሊፊ ይሁዳ ቦጁዻ ዴብሴ ብየ አን አከ እሳን ዻለኒፍ አቦቲሳኒቲፍ ኬኔ ሰነት እሳን ገልቹዸ፣’ ጄዸ <char style="nd">ዋቀዮ</char>።”<verse eid="JER 30:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 30:4"/>ዱቢን <char style="nd">ዋቀዮ</char> ዋኤ እስራኤሊፊ ይሁዳ ዱበቴ ከናዸ፦ <verse eid="JER 30:4"/><verse number="5" style="v" sid="JER 30:5"/>“<char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 30:5">“ ‘እይ ሶዳ ንዸገአመ፤</para>
  <para style="q2" vid="JER 30:5">ኩን ራፈመ መሌ ነጋ ምት።<verse eid="JER 30:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 30:6"/>ሜ እያፈዻ እላላ፦</para>
  <para style="q2" vid="JER 30:6">ዺር ቶኮ ደኡ ንደንደኣ?</para>
  <para style="q1" vid="JER 30:6">ዮስ አን ማሊፈን ዺረ ሁንደ እሳ አኩመ ዱበርቲ ጭኒንስፈቱ፣</para>
  <para style="q2" vid="JER 30:6">ሀርከሳ ገራ ኦፊሳረ ካአቴ፣</para>
  <para style="q2" vid="JER 30:6">ፉልሳስ አከ መሌ ጉራቸኤ አርገሬ?<verse eid="JER 30:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 30:7"/>ጉያን ሱን አከም ሶዳችሳ ተአ!</para>
  <para style="q2" vid="JER 30:7">ጉያን አከ ጉያ ሰና ቶኮዩ ህንጅራቱ።</para>
  <para style="q1" vid="JER 30:7">ጉያን ሱን ያቆቢፍ ዬሮ ረክና ተአ፤</para>
  <para style="q2" vid="JER 30:7">እን ገሩ ረክነ ሰነ ኬሳ ንበአ።<verse eid="JER 30:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JER 30:8"/>“ ‘ጉያ ሰነ’ ጄዸ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣</para>
  <para style="q2" vid="JER 30:8">‘አን ሞርመሳኒራ ዋንጆ ነንጨብሰ፤</para>
  <para style="q1" vid="JER 30:8">ህዻሳኒሌ ነንኩኩተ፤</para>
  <para style="q2" vid="JER 30:8">ኤርገሲ ነሞትን ብየ ኦርማ እሳን ህንገርቦምፈተን።<verse eid="JER 30:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 30:9"/>ቆደ ከና እሳን <char style="nd">ዋቀዮ</char> ዋቀሳኒቲፊ</para>
  <para style="q2" vid="JER 30:9">ዳዊት ሞቲሳኒ እሰ አን እሳኒፍ ካሱ ንተጃጅሉ።<verse eid="JER 30:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JER 30:10"/>“ ‘ከናፉ ያ ተጃጅላኮ ያቆብ፣ አት ህንሶዳትን፤</para>
  <para style="q2" vid="JER 30:10">ያ እስራኤል ህንርፈትን’</para>
  <para style="q2" vid="JER 30:10">ጄዸ <char style="nd">ዋቀዮ</char>።</para>
  <para style="q1" vid="JER 30:10">‘አን ዹጉማን ብየ ፈጎቲ ስን ባሰ፣</para>
  <para style="q2" vid="JER 30:10">ሰኚወንኬሞ ብየ እሳን ቦጅአመኒ</para>
  <para style="q2" vid="JER 30:10">እት ጌፈመኒ ነንባሰ።</para>
  <para style="q1" vid="JER 30:10">ያቆብ አመስ ነጋፊ ተስገቢ ንቀባተ፤</para>
  <para style="q2" vid="JER 30:10">ነምን እሰ ሶዳችሱ ቶኮዩ ህንጅሩ።<verse eid="JER 30:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 30:11"/>አን ስ ባሱፍ ስ ወጅነን ጅራቲ’</para>
  <para style="q2" vid="JER 30:11">ጄዸ <char style="nd">ዋቀዮ</char>፤</para>
  <para style="q1" vid="JER 30:11">‘አን ሰቦተን ግዱ እሳኒት ስ ብትኔሴ ሰነ</para>
  <para style="q2" vid="JER 30:11">ጉቱማን ጉቱት በርበዴሱዩ</para>
  <para style="q2" vid="JER 30:11">ስእ ገሩ ጉቱማን ጉቱት ህንበርበዴሱ።</para>
  <para style="q1" vid="JER 30:11">አን ከራ ስሪ ተኤን ስን አደበ፤</para>
  <para style="q2" vid="JER 30:11">ኡቱ ስ ህንአደብን አከሱመት ስ ህንዺሱ።’<verse eid="JER 30:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 30:12"/>“<char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 30:12">“ ‘መዳንኬ ህንፈዩ፤</para>
  <para style="q2" vid="JER 30:12">ሚዸምንኬ ወልዻንሰ ህንቀቡ።<verse eid="JER 30:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 30:13"/>ነምን ሲፍ ፈልሙ ቶኮዩ ህንጅሩ፤</para>
  <para style="q2" vid="JER 30:13">መዳኬቲፍ ቆርች ህንጅሩ፤</para>
  <para style="q2" vid="JER 30:13">አት ህንፈይቱ።<verse eid="JER 30:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 30:14"/>ምቾትንኬ ሁንድ ስ ደገተኒሩ፤</para>
  <para style="q2" vid="JER 30:14">እሳን ዽመኬ ህንቀበን።</para>
  <para style="q1" vid="JER 30:14">ሰበቢ የክኬ አከ መሌ ጉዳ ተኤ</para>
  <para style="q2" vid="JER 30:14">ጩቡንኬስ ባይአቴፍ</para>
  <para style="q1" vid="JER 30:14">አን አኩመ ዲናት ስ ዸኤ</para>
  <para style="q2" vid="JER 30:14">አኩመ ነመ ገራ ጀባቱ ቶኮትስ ስ አደቤረ።<verse eid="JER 30:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 30:15"/>አት ማሊፍ መዳኬቲፊ</para>
  <para style="q2" vid="JER 30:15">ዹኩበኬ ከን ህንፈይኔ ሰናፍ እይተ?</para>
  <para style="q1" vid="JER 30:15">ሰበቢ የክኬ ጉደቴ ጩቡንኬስ ባይአቴፍ፣</para>
  <para style="q2" vid="JER 30:15">አን ወንቶተ ከኔን ስት ፍዴረ።<verse eid="JER 30:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="JER 30:16"/>“ ‘ወር ስ ኛተን ሁንድ ገሩ ንኛተሙ፤</para>
  <para style="q2" vid="JER 30:16">ዲኖትንኬ ሁንድስ ቦጁዻን ንፉዸተሙ።</para>
  <para style="q1" vid="JER 30:16">ወር ቀቤኘኬ ቦጅአን ንቦጅአሙ፤</para>
  <para style="q2" vid="JER 30:16">ወር ስ ሳመን ሁንድስ ንሳመሙ።<verse eid="JER 30:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 30:17"/>አን ገሩ ፈያኬ ሲፍን ዴብሰ፤</para>
  <para style="q2" vid="JER 30:17">መዳኬስ ሲፍ ነንፈይሰ’ ጄዸ <char style="nd">ዋቀዮ</char>።</para>
  <para style="q1" vid="JER 30:17">‘አት ጥዮን ገተምቱ</para>
  <para style="q2" vid="JER 30:17">ከን ነምን ቶኮዩ ዽመሼ ህንቀብኔ ጄዸምቴርታቲ።’<verse eid="JER 30:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 30:18"/>“<char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 30:18">“ ‘አን ሀምባ ዱንካነ ያቆብ ከን ቦጅአሜ ዴብሴ ነንዻበ፤</para>
  <para style="q2" vid="JER 30:18">እዶ ጅሬኘሳኒቲፍስ ገራ ነንላፈ፤</para>
  <para style="q1" vid="JER 30:18">መጋለቲን እዱመ ዲገምቴ ሰነት ዴብቴ ንእጃረምት፤</para>
  <para style="q2" vid="JER 30:18">መሰራንስ እዶ እሳፍ መሉ ንዻበተ።<verse eid="JER 30:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 30:19"/>ፋርፈናን ገለታቲፊ ሰገሌን ገመቹ</para>
  <para style="q2" vid="JER 30:19">እሳን ኬሳ ንዸገአመ።</para>
  <para style="q1" vid="JER 30:19">አን እሳን ነንባይእሰ፤</para>
  <para style="q2" vid="JER 30:19">እሳንስ ህንጥናተን፤</para>
  <para style="q1" vid="JER 30:19">አን ኡልፍነ ነንኬናፍ፤</para>
  <para style="q2" vid="JER 30:19">እሳንስ ህንቱፈተመን።<verse eid="JER 30:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 30:20"/>እጆሌንሳኒ አከ ወረ ጀበነ ዱሪ ተኡ፤</para>
  <para style="q2" vid="JER 30:20">ወልዳንሳኒስ ጀባቴ ፉለኮ ዱረ ንዻበተ፤</para>
  <para style="q2" vid="JER 30:20">አን ወረ እሳን ጩንቁርሱ ሁንደ ነንአደበ።<verse eid="JER 30:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 30:21"/>ሆገናንሳኒ ነሙመሳኒ ተአ፤</para>
  <para style="q2" vid="JER 30:21">ቡልቻንሳኒ እሳኑመ ግዱዻ ከአ።</para>
  <para style="q1" vid="JER 30:21">አን እሰ ኦፍት ነንዽኤሰ፤</para>
  <para style="q2" vid="JER 30:21">እንስ ነት ዽኣተ፤</para>
  <para style="q2" vid="JER 30:21">ዮ ከና አቺ ኤኙቱ ነት ዽኣቹፍ እጀ ጀባተ?’</para>
  <para style="q2" vid="JER 30:21">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 30:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 30:22"/>‘አከሲን እስን ሰበኮ ንታቱ፤</para>
  <para style="q2" vid="JER 30:22">አንስ ዋቀኬሰን ነንተአ።’ ”<verse eid="JER 30:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="JER 30:23"/>ኩኖ፣ ቡቤን <char style="nd">ዋቀዮ</char>፣</para>
  <para style="q2" vid="JER 30:23">እን ጀባን ዼከምሳን ንቡአ፤</para>
  <para style="q1" vid="JER 30:23">ቡቤን ሀማንስ</para>
  <para style="q2" vid="JER 30:23">መታ ሀሞታረት ገድ ቡብሰ።<verse eid="JER 30:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 30:24"/>ኣሪን <char style="nd">ዋቀዮ</char>፣ ሶዳችሳን ሱን</para>
  <para style="q2" vid="JER 30:24">ሀመ እን ካዮ ያደሳ</para>
  <para style="q2" vid="JER 30:24">ጉቱማን ጉቱት ፊጣን ባሱት ዱበት ህንዴብኡ።</para>
  <para style="q1" vid="JER 30:24">እስን በረ ዹማ ኬሰ</para>
  <para style="q2" vid="JER 30:24">ዋን ከነ ንሁበቱ።<verse eid="JER 30:24"/></para>
  <chapter eid="JER 30"/>
  <chapter number="31" style="c" sid="JER 31"/>
  <para style="p">
    <verse number="1" style="v" sid="JER 31:1"/>“ዬሮ ሰነት” ጄዸ <char style="nd">ዋቀዮ</char>፣ “አን በልበለ እስራኤል ሁንዳፍ ዋቀ ነንተአ፤ እሳንስ ሰበኮ ንተኡ።”<verse eid="JER 31:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JER 31:2"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 31:2">“ነሞትን ጎራዴራ ሀፈን</para>
  <para style="q2" vid="JER 31:2">ገሞጂ ኬሰት ፉዸተመ ንአርገቱ፤</para>
  <para style="q2" vid="JER 31:2">አንስ እስራኤሊፍ ቦቆና ኬኑፍ ነንዹፈ።”<verse eid="JER 31:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 31:3"/>
    <char style="nd">ዋቀዮ</char> ፈጎዻ ነት ሙልአቴ አከነ ጄዼ፦</para>
  <para style="q1" vid="JER 31:3">“አን ጃለለ በረ በራቲን ስ ጃለዼረ፤</para>
  <para style="q2" vid="JER 31:3">ከናፉ አን አርጁማኮቲን ኦፍት ስ ሀርክሴረ።<verse eid="JER 31:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 31:4"/>ያ እስራኤል ዱርበ ቁልቁልቲ፣ አን አመሌ ስን እጃረ፤</para>
  <para style="q2" vid="JER 31:4">አትስ ዴብቴ ንእጃረምተ።</para>
  <para style="q1" vid="JER 31:4">አት አመሌ ድቤኬ ፉዸቴ</para>
  <para style="q2" vid="JER 31:4">ወረ ገመደን ወጅን ሹብሱፍ ገድ ባተ።<verse eid="JER 31:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 31:5"/>አት አመሌ ጋረን</para>
  <para style="q2" vid="JER 31:5">ሰማርያረት ወይኒ ንዻበተ፤</para>
  <para style="q1" vid="JER 31:5">ቆቴ ቡላንስ ወይኒ ዻበቴ</para>
  <para style="q2" vid="JER 31:5">እጀሳ ንኛተ።<verse eid="JER 31:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 31:6"/>ጉያ እት ኤግዶትን</para>
  <para style="q2" vid="JER 31:6">ጋረን ኤፍሬምረ ዻበተኒ፣</para>
  <para style="q1" vid="JER 31:6">‘ኮታ ገረ ጥዮንት፣ ገረ <char style="nd">ዋቀዮ</char> ዋቀኬኛት ኦል ባና’</para>
  <para style="q2" vid="JER 31:6">ጄዸኒ እየን ቶኮ ንዹፈ።”<verse eid="JER 31:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 31:7"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 31:7">“ያቆቢፍ ገመቹዻን ፋርፈዻ፤</para>
  <para style="q2" vid="JER 31:7">ሀንገፈ ሰቦታቲፍ እልልቻ።</para>
  <para style="q1" vid="JER 31:7">ገለተኬሰን ዸጌስሳቲ፣</para>
  <para style="q2" vid="JER 31:7">‘ያ <char style="nd">ዋቀዮ</char> ሰበኬ፣</para>
  <para style="q2" vid="JER 31:7">ሀምባ እስራኤል በራር’ ጄዻ።<verse eid="JER 31:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 31:8"/>ኩኖ፣ አን ብየ ካባቲ እሳን ነንፍደ፤</para>
  <para style="q2" vid="JER 31:8">ሀንዳረ ለፋቲስ ወልት እሳን ነንቀበ።</para>
  <para style="q1" vid="JER 31:8">እሳን ኬሰትስ ጃሞታፊ ናፎተ፣</para>
  <para style="q2" vid="JER 31:8">ሃዾተ ኡልፋቲፊ ዱበርቶተ ጭኒንስፈተንቱ አርገመ፤</para>
  <para style="q2" vid="JER 31:8">ሰበ ጉዳ ተአኒስ ንዴብኡ።<verse eid="JER 31:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 31:9"/>እሳንስ ቦኣ ዹፉ፤</para>
  <para style="q2" vid="JER 31:9">ዬሮ አን ዴብሴ እሳን ፍዱት ዋቀ ከዸቱ።</para>
  <para style="q1" vid="JER 31:9">ዋን አን አባ እስራኤል ተኤፊ</para>
  <para style="q2" vid="JER 31:9">ኤፍሬምሞ እልመኮ ሀንገፈ ተኤፍ፣</para>
  <para style="q1" vid="JER 31:9">አን ቀርቀረ ቡርቃ ብሻኒረ፣</para>
  <para style="q2" vid="JER 31:9">ዳንዲ ቀጄላ እሳን አችረት ህንጉፈትኔረ እሳን ነንቀጄልቸ።<verse eid="JER 31:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JER 31:10"/>“ያ ሰቦተ፣ ዱቢ <char style="nd">ዋቀዮ</char> ዸገኣ፤</para>
  <para style="q2" vid="JER 31:10">እስን፣ ‘እን እስራኤልን ብትኔሴ ሱን ወልት እሳን ቀቤ</para>
  <para style="q1" vid="JER 31:10">አኩመ ትክሴ ቶኮት ቡሻዬሳ ንትክሰ’ ጄዻቲ</para>
  <para style="q2" vid="JER 31:10">ብዮተ ቀርቀረ ገላና ከኔን ፈጎ ጅረንት ለብሳ።<verse eid="JER 31:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 31:11"/>
    <char style="nd">ዋቀዮ</char> ያቆብን ፉሬረ፣</para>
  <para style="q2" vid="JER 31:11">ወረ እሰ ጫላ ጀጀቦ ተአን ሀርካስ እሰ ባሴራቲ።<verse eid="JER 31:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 31:12"/>እሳን ዹፈኒ ጋረን ጥዮንረትስ ገመደኒ እልልቹ፤</para>
  <para style="q2" vid="JER 31:12">እሳን አርጁማ <char style="nd">ዋቀዮት</char> ጄቹንስ</para>
  <para style="q1" vid="JER 31:12">ምዻንት፣ ዳዺ ወይኒ ሃራፊ</para>
  <para style="q2" vid="JER 31:12">ዘይቲት፣ እልሞሌ ቡሻዬቲፊ ጀቦታትስ ንገመዱ።</para>
  <para style="q1" vid="JER 31:12">ጅሬኝሳኒ አኩመ ብቅልቱ ብሻን ቁፌ ተአ፤</para>
  <para style="q2" vid="JER 31:12">እሳን ስአች ህንገደን።<verse eid="JER 31:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 31:13"/>ኤርገሲስ ሸመረን ንሹብሱ፤ ንገመዱ፤</para>
  <para style="q2" vid="JER 31:13">ደርገጎትኒፊ ማንጉዶትን አከሱመ ንገመዱ።</para>
  <para style="q1" vid="JER 31:13">አን ቦእቸሳኒ ገመቹት ነንጌደረ፤</para>
  <para style="q2" vid="JER 31:13">ቆደ ገዳ ጀጀብናፊ ገመቹ ነንኬናፍ።<verse eid="JER 31:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 31:14"/>አን አርጁማዻን ሉቦተ ነንቁብሰ፤</para>
  <para style="q2" vid="JER 31:14">ሰብንኮስ በዻዹማኮቲን ንጉተመ፣”</para>
  <para style="q2" vid="JER 31:14">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 31:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 31:15"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 31:15">“ሰገሌን ቦእቻቲፊ ወዋትና ጉዳን ቶኮ</para>
  <para style="q2" vid="JER 31:15">ራማ ኬሳ ዸገአሜ፤</para>
  <para style="q1" vid="JER 31:15">ሰበቢ እሳን ህንጅሬፍ፣</para>
  <para style="q2" vid="JER 31:15">ራሄል እጆሌሼቲፍ ቦኣ ጅርት፤</para>
  <para style="q2" vid="JER 31:15">ጀጀባቹስ ንድዴ።”<verse eid="JER 31:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 31:16"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 31:16">“ሰገሌኬ ቦእቸራ፣</para>
  <para style="q2" vid="JER 31:16">እጀኬሞ እምማንራ ኤገዹ፤</para>
  <para style="q1" vid="JER 31:16">ሆጂንኬ ንበዻፈማቲ”</para>
  <para style="q2" vid="JER 31:16">ጄዸ <char style="nd">ዋቀዮ</char>።</para>
  <para style="q2" vid="JER 31:16">“እሳን ብየ ዲናቲ ንዴብኡ።<verse eid="JER 31:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 31:17"/>ከናፉ ገልገልኬ አብዲ ቀበ”</para>
  <para style="q2" vid="JER 31:17">ጄዸ <char style="nd">ዋቀዮ</char>።</para>
  <para style="q2" vid="JER 31:17">እጆሌንኬ ብየ ኦፊሳኒት ንዴብኡ።<verse eid="JER 31:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="JER 31:18"/>“አን ዹጉማን ኤፍሬሚ አከነ ጄዼ ቦኡ ዸገኤረ፦</para>
  <para style="q2" vid="JER 31:18">‘አት አኩመ ድብቸ ህንሌንጅፈምን</para>
  <para style="q2" vid="JER 31:18">ቶኮት ነ አደብዴርተ፤ አንስ አደበሜረ።</para>
  <para style="q1" vid="JER 31:18">አት ሰበቢ <char style="nd">ዋቀዮ</char> ዋቀኮ ታቴፍ፣</para>
  <para style="q2" vid="JER 31:18">ነ ዴብስ፤ አንስ ነንዴብአ።<verse eid="JER 31:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 31:19"/>አን ኤርገን ዱበት ዴብኤ ቦዴ፣</para>
  <para style="q2" vid="JER 31:19">ቀልቢ ጅጂረዼረ፤</para>
  <para style="q1" vid="JER 31:19">አን ኤርገን ሁበዼ ቦዴ፣</para>
  <para style="q2" vid="JER 31:19">ቆመኮ ነንዸኤ።</para>
  <para style="q1" vid="JER 31:19">አን ሰበቢን ሰልጵነ ደርገጉማኮ ባዹፍ፣</para>
  <para style="q2" vid="JER 31:19">ነንቃነኤ፤ ገድ ነንዴብኤስ።’<verse eid="JER 31:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 31:20"/>ኤፍሬም እልመኮ ጃለተማ፣</para>
  <para style="q2" vid="JER 31:20">ሙጫ አን እት ገመዱ ምቲ?</para>
  <para style="q1" vid="JER 31:20">አን ዬሮ ባይኤ ዮን እሳን ሞርሜዩ</para>
  <para style="q2" vid="JER 31:20">አመሌ እሰ ነንያደዸ።</para>
  <para style="q1" vid="JER 31:20">ከናፉ ገራንኮ እሳፍ ንያደ፤</para>
  <para style="q2" vid="JER 31:20">ገራስ ነንላፋፍ”</para>
  <para style="q2" vid="JER 31:20">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 31:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="JER 31:21"/>“አት መለቶ ዳንዲ ዻበዹ፤</para>
  <para style="q2" vid="JER 31:21">ዋን ከራ ነመ አርግሲሱሌ ካአዹ።</para>
  <para style="q1" vid="JER 31:21">ከራ እረ ዴምቱ፣</para>
  <para style="q2" vid="JER 31:21">ዳንዲ ጉዳ ሰነ ሁበዹ።</para>
  <para style="q1" vid="JER 31:21">ያ እስራኤል ዱርበ ቁልቁልቲ ዴብእ፤</para>
  <para style="q2" vid="JER 31:21">መጋላወንኬት ዴብእ።<verse eid="JER 31:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 31:22"/>ያ እንተለ ህንአመነምኔ፣</para>
  <para style="q2" vid="JER 31:22">አት ሀመ ዮሚት አሲፊ አች ጆርተ?</para>
  <para style="q1" vid="JER 31:22">
    <char style="nd">ዋቀዮ</char> ዋን ሃራ ቶኮ ለፈረት ንኡመ፤</para>
  <para style="q2" vid="JER 31:22">ዱበርቲን ዺረ መርስት።”<verse eid="JER 31:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JER 31:23"/>
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል አከነ ጄዸ፦ “ዬሮ አን ቦጅአምቶተሳኒ ዴብሱት ነሞትን ብየ ይሁዳቲፊ መጋላወንሼ ኬሰ ጅራተን አመሌ ዬሮ ቶኮ፣ ‘ያ እዶ ሙርቲን ቀጄላን ጅራቱ፣ ያ ቱሉ ቁልቁሉ፣ <char style="nd">ዋቀዮ</char> ስ ሃኤብሱ’ ጄዸኒ ዱበቱ። <verse eid="JER 31:23"/><verse number="24" style="v" sid="JER 31:24"/>ብየ ይሁዳቲፊ መጋላወንሳ ሁንደ ኬሰ ነሞትን ጄቹንስ ቆናን ቡልቶትኒፊ ወር ቡሻዬ ፉዸተኒ አሲፊ አች ነናነአን ቶኩማዻን አች ኬሰ ጅራቱ። <verse eid="JER 31:24"/><verse number="25" style="v" sid="JER 31:25"/>አን ወረ ደዸበን ነንጀጀቤሰ፤ ወረ ገገበንሌ ነንበየነቺሰ።”<verse eid="JER 31:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JER 31:26"/>ከነረት አን ደመቄ አሲፊ አች ነንእላሌ። ህርብንኮስ ነት ምኣዌ ቱሬ።<verse eid="JER 31:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 31:27"/>“በር አን እት መነ እስራኤሊፊ መነ ይሁዳ ሰኚ ነማቲፊ ሰኚ ሆሪቲን ጉቱ ቶኮ ንዹፈ” ጄዸ <char style="nd">ዋቀዮ</char>። <verse eid="JER 31:27"/><verse number="28" style="v" sid="JER 31:28"/>“አን አኩመን እሳን ቡቅሱፊ ዲጉፍ፣ እሳን ገረገልቹፍ፣ እሳን በርበዴሱፊ በዲሰ እሳንት ፍዱፍ እሳን እላሌ ሰነ አከሱመሞ እሳን እጃሩፊ እሳን ዻቡፍ ገረሳኒ ነንእላለ” ጄዸ <char style="nd">ዋቀዮ</char>። <verse eid="JER 31:28"/><verse number="29" style="v" sid="JER 31:29"/>“በረ ሰነ ኬሰ ነሞትን ለመተ፣</para>
  <para style="q1" vid="JER 31:29">“ ‘አቦቲንሳኒ እጀ ወይኒ ዸንገጋኣ ኛትናን</para>
  <para style="q2" vid="JER 31:29">እልካን እጆሌ ሀዶዴ’ ህንጄዸን።<verse eid="JER 31:29"/></para>
  <para style="m">
    <verse number="30" style="v" sid="JER 31:30"/>ቆደ ከና ቶኮን ቶኮን ነማ ጩቡ ኦፊሳቲን ዱአ፤ ነመ እጀ ወይኒ ዸንገጋኣ ኛቱ ከምዩ እልካኑመሳቱ ሀዶደ።<verse eid="JER 31:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JER 31:31"/>“ዬሮን አን እት መነ እስራኤል ወጅን፣</para>
  <para style="q2" vid="JER 31:31">መነ ይሁዳ ወጅንስ</para>
  <para style="q1" vid="JER 31:31">ከኩ ሃራ ገሉ ንዹፈ፣”</para>
  <para style="q2" vid="JER 31:31">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 31:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JER 31:32"/>“ከኩን ኩንስ ከኩ አን፣</para>
  <para style="q2" vid="JER 31:32">ዬሮ ብየ ግብጢቲ እሳን ባሱፍ ጄዼ</para>
  <para style="q2" vid="JER 31:32">ሀርከሳኒ ቀቤ ሰነ አቦቲሳኒ ወጅን ገሌ፣</para>
  <para style="q1" vid="JER 31:32">ከኩኮ ከን ኡቱመ አን ዽርሰሳኒ ተኤ ጅሩ</para>
  <para style="q2" vid="JER 31:32">እሳን ጨብሰን ሰናን ቶኮ ምት”</para>
  <para style="q2" vid="JER 31:32">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 31:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="JER 31:33"/>“ከኩን አን ዬሮ ሰነ ቦዴ</para>
  <para style="q2" vid="JER 31:33">መነ እስራኤል ወጅን ገሉ ከናዸ” ጄዸ <char style="nd">ዋቀዮ</char>።</para>
  <para style="q1" vid="JER 31:33">“አን ሴረኮ ቀልቢሳኒ ኬሰ ነንካአ፤</para>
  <para style="q2" vid="JER 31:33">ገራሳኒ ኬሰትስ ነንበሬሰ።</para>
  <para style="q1" vid="JER 31:33">አን ዋቀሳኒ ነንተአ፤</para>
  <para style="q2" vid="JER 31:33">እሳንስ ሰበኮ ተኡ።<verse eid="JER 31:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="JER 31:34"/>ሰበቢ ሁንድሳኒ፣</para>
  <para style="q2" vid="JER 31:34">ጥና ሀመ ጉዳት ነ ቤከኒፍ፣</para>
  <para style="q1" vid="JER 31:34">ስአች ነምን ከምዩ፣ ‘<char style="nd">ዋቀዮን</char> ቤክ’ ጄዼ</para>
  <para style="q2" vid="JER 31:34">ኦላሳ ዮካን ኦቦሌሰሳ ህንበርሲሱ”</para>
  <para style="q2" vid="JER 31:34">ጄዸ <char style="nd">ዋቀዮ</char>።</para>
  <para style="q1" vid="JER 31:34">“አን የከሳኒ ነንዺሳፍ፤</para>
  <para style="q2" vid="JER 31:34">ጩቡሳኒስ ስአች ህንያደዹ።”<verse eid="JER 31:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JER 31:35"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፤</para>
  <para style="q1" vid="JER 31:35">እን አከ እሼን ጉያን እብስቱፍ አዱ ረመዱ፣</para>
  <para style="q2" vid="JER 31:35">እን አከ እሳን ሀልከኒን እብሰኒፍ፣</para>
  <para style="q2" vid="JER 31:35">ጅኣፊ ኡርጂወን አጀጁ፣</para>
  <para style="q1" vid="JER 31:35">እን አከ ደምበሊንሳ ሁርሱፍ</para>
  <para style="q2" vid="JER 31:35">ገላነ ራሱ ሱን መቃንሳ</para>
  <para style="q2" vid="JER 31:35">
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡዸ፦<verse eid="JER 31:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="JER 31:36"/>“ዮ ሴር ኩን ፉለኮ</para>
  <para style="q2" vid="JER 31:36">ዱራ በዴ ቆፈ፣ ሰኚን እስራኤል፣</para>
  <para style="q1" vid="JER 31:36">ፉለኮ ዱረት በረ በራን ሰበ ተኡንሳ ሀፈ”</para>
  <para style="q2" vid="JER 31:36">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 31:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JER 31:37"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 31:37">“ዮ ሰሚን ጉባ ሰፈረሙ ደንደኤፊ</para>
  <para style="q2" vid="JER 31:37">ሁንዴን ለፋ ከን ገዲ ቆረተሜ አርገሙ ደንደኤ ቆፈ</para>
  <para style="q1" vid="JER 31:37">አን ሰኚ እስራኤል ሁንደ</para>
  <para style="q2" vid="JER 31:37">ሰበቢ ዋን እሳን ሆጄተን ሁንዳቲፍ ነንገተ”</para>
  <para style="q2" vid="JER 31:37">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 31:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JER 31:38"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ “በር እት መጋላን ኩን ገሞ ሀናንኤሊቲ ጀልቀቤ ሀመ ከረ ጎሌት ዴብኤ ናፍ እጃረሙ ቶኮ ንዹፈ። <verse eid="JER 31:38"/><verse number="39" style="v" sid="JER 31:39"/>ፉኞን ሰፈራስ አቺ ከኤ ገረ ቱሉ ጋሬብት ቀጄሌ ገረ ጎኣት ድሪርፈመ። <verse eid="JER 31:39"/><verse number="40" style="v" sid="JER 31:40"/>ሱሉል ሬፊፊ ዳራን እት ገተሙ ጉቱን፣ ከራ በኣስ ሱሉለ ቄድሮን ቀበቴ ድሬን ሀመ ከረ ፈርዳት ጅሩ ሁንድ <char style="nd">ዋቀዮፍ</char> ንቁልቁሌፈመ። መጋላን ኩን ጎንኩማ ለመፋ ህንቡቅፈምቱ ዮካን ህንዲገምቱ።”<verse eid="JER 31:40"/></para>
  <chapter eid="JER 31"/>
  <chapter number="32" style="c" sid="JER 32"/>
  <para style="s1">ኤርምያስ ለፈ ቆቲሳ ብተቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 32:1"/>በረ ዜዴቅያ ሞትቸ ይሁዳ ኬሰ ወጋ ኩዸነፋት በረ ሞቱማ ኔቡከድኔዘር ኬሰ ወጋ ኩዸ ሰዴተፋት፣ ዱቢን ኩን <char style="nd">ዋቀዮ</char> ብራ ገረ ኤርምያስ ዹፌ። <verse eid="JER 32:1"/><verse number="2" style="v" sid="JER 32:2"/>ዬሮ ሰነት ሎልቶትን ሞቲ ባብሎን ዬሩሳሌምን መርሰኒ ቱረን፤ ኤርምያስ ራጅችሞ መሰራ ሞቲ ይሁዳ ኬሰት ኦብዲ ኤጉምሳ ኬሰት እት ጩፈሜ ቱሬ።<verse eid="JER 32:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 32:3"/>ዜዴቅያ ሞትች ይሁዳ አከነ ጄዼኒ እሰ ሂስሴ ቱሬ፤ “አት ማሊፍ አከነ ጄቴ ራጂ ዱበተ? ‘<char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ አን መጋላ ከነ ደበርሴ ሞቲ ባብሎንት ነንኬነ፤ እንስ ንቀበተ። <verse eid="JER 32:3"/><verse number="4" style="v" sid="JER 32:4"/>ዜዴቅያን ሞትች ይሁዳ ደበርፈሜ ሞቲ ባብሎንት ንኬነመ መሌ ሀርከ ወረ ባብሎን ጀላ ህንበኡ፤ ፉለ ሞትቻ ዱረ ዻበቴስ እሰ ወጅን ዱበተ፤ እጀሳቲንስ እሰ ንአርገ። <verse eid="JER 32:4"/><verse number="5" style="v" sid="JER 32:5"/>እንስ ዜዴቅያ ገረ ባብሎንት ጌሰ፤ ዜዴቅያን ሀመ አን እሰ ያደዹት አቹመ ቱረ፣ ጄዸ <char style="nd">ዋቀዮ</char>። እስን ዮ ባብሎኖተ ሎልተን ህንምልኮፍተን።’ ”<verse eid="JER 32:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 32:6"/>ኤርምያስ አከነ ጄዼ፤ “ዱቢን <char style="nd">ዋቀዮ</char> አከነ ጄዼ ገረኮ ዹፌ፦ <verse eid="JER 32:6"/><verse number="7" style="v" sid="JER 32:7"/>ሀነንኤል እልም ኤሱመኬቲ እልም ሸሉም ስ ብረ ዹፌ፣ ‘አት ሰበቢ ለፈ ከነ ብተቹፍ ምርገ ኣንቱማ ቀብዱፍ ለፈ ቆቲሳኮ ከን አናቶት ኬሳ ሰነ ብተዹ’ ሲን ጄዸ።<verse eid="JER 32:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 32:8"/>“ኤርገሲ አኩመ <char style="nd">ዋቀዮ</char> ዱበቴ ሰነ ሀነንኤል ዱርቢንኮ ገረ ኦብዲ ኤጉምሳት ነ ብረ ዹፌ፣ ‘ለፈኮ ከን ብየ ቤንያም ኬሰ አናቶት ጅሩ ሰነ ብተዹ። ዋን ምርግ ፉሩቲፊ ዹንፈቹ ከንኬ ተኤፍ አት ኦፊኬቲ ብተዹ’ ጄዼ።</para>
  <para style="p" vid="JER 32:8">“ከነረት አን አከ ወን ኩን ዱቢ <char style="nd">ዋቀዮ</char> ቱሬ ነንቤኬ፤ <verse eid="JER 32:8"/><verse number="9" style="v" sid="JER 32:9"/>ከናፉ አን ለፈ ቆቲሳ አናቶት ጅሩ ሰነ ዱርቢኮ ሀነንኤልራ ብተዼ ሜቲ ሰቅሊ ኩዸ ቶርበ ሰፈሬ ኬኔፍ። <verse eid="JER 32:9"/><verse number="10" style="v" sid="JER 32:10"/>አንስ ወሊ ገልቴ ሰነ መለቴሴ፣ ቻፓ እት ጎዼ፣ ዹገ ባቶተ ዋሜ ሜቲ ሰነ መዳሊት ሰፈሬፍ። <verse eid="JER 32:10"/><verse number="11" style="v" sid="JER 32:11"/>ወሊ ገልቴ ብታፊ ጉርጉርታ ጄቹንስ ገረገልቻ ቻፓ ቀቡ ከን አከ ሴራፊ በርቴት ሆጄተሜፊ ከን ቻፓ ህንቀብኔሌ ነንፉዸዼ፤ <verse eid="JER 32:11"/><verse number="12" style="v" sid="JER 32:12"/>ጌሴስ ፉለ ዱርቢኮ ሀነንኤሊፊ ፉለ ዹገ ባቶተ ወሊ ገልቴ ሰነረት መለቴሰኒቲፊ ፉለ ይሁዶተ ኦብዲ ኤጉምሳ ኬሰ ተታኣ ቱረን ሁንዳ ዱረት ባሩክ እልመ ኔርያ እልመ መህሴያት ኬኔ።<verse eid="JER 32:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 32:13"/>“አንስ ፉሉመሳኒ ዱረት ቀጄልቸ ከነ ባሩኪፍ ኬኔ፤ <verse eid="JER 32:13"/><verse number="14" style="v" sid="JER 32:14"/>‘<char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል አከነ ጄዸ፦ ወሊ ገልቴ ብታፊ ጉርጉርታ ከን ቻፓ ቀቡፊ ከን ቻፓ ህንቀብኔ ፉዺቲ አከ እሳን በረ ዼራ ቱሩ ደንደአኒፍ ለቹ ኦኮቴ ሱጴ ኬሰ ካእ። <verse eid="JER 32:14"/><verse number="15" style="v" sid="JER 32:15"/><char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል አከነ ጄዻቲ፤ ብየ ከነ ኬሰት መኔን፣ ለፈ ቆቲሳፊ እዶን ዻባ ወይኒ አመሌ ንብተሙ።’<verse eid="JER 32:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 32:16"/>“አንስ ኤርገ ወሊ ገልቴ ብታፊ ጉርጉርታ ሰነ ባሩክ እልመ ኔርያት ኬኔ ቦዴ አከነ ጄዼን <char style="nd">ዋቀዮን</char> ከዸዼ፦<verse eid="JER 32:16"/></para>
  <para style="pm">
    <verse number="17" style="v" sid="JER 32:17"/>“ያ <char style="nd">ዋቀዮ</char> ጎፍታ፣ አት ሁምነኬ ጉዳፊ እሬኬ ድሪርፈሜ ሰናን ሰሚወኒፊ ለፈ ኡምቴርተ። ወንት አት ህንደንዴኜ ቶኮዩ ህንጅሩ። <verse eid="JER 32:17"/><verse number="18" style="v" sid="JER 32:18"/>አት ነሞተ ኩማተመት ጃለለ ንአርግሲፍተ፤ ገሩ ሰበቢ ጩቡ አቦቲቲፍ ጄቴ እጆሌሳኒ ከኔን እሳን ቦዴሌ ንአደብደ። ያ ዋቀ ጉዳፊ ሁምነ ቀቤሰ መቃንኬ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡዸ፤ <verse eid="JER 32:18"/><verse number="19" style="v" sid="JER 32:19"/>ካዮንኬ ጉዳዸ፤ ሆጂንኬስ ጀባዸ። እጅኬ ከራ ነማ ሁንደ እላለ፤ አት ቶኮ ቶኮ ነማቲፍ ገቲ ከራሳቲፊ ሆጂሳቲፍ መሉ ኬንተ። <verse eid="JER 32:19"/><verse number="20" style="v" sid="JER 32:20"/>አት ግብጥ ኬሰት መለቶፊ ድንቂ ሆጄቴ ሀመ ሀርኣትሌ እስራኤሊፊ ሰኚ ነማ ሁንደ ኬሰት ዋን ከነ እቱመ ፉፍቴ መቃ ሀመ አማት ቀብዱ ከነ አርገቴ። <verse eid="JER 32:20"/><verse number="21" style="v" sid="JER 32:21"/>ሰበኬ እስራኤሊን መለቶፊ ድንቂዻን፣ ሀርከ ሁምነ ቀቤሳን፣ እሬ ድሪርፈማፊ ሃለ አከ መሌ ነመ ሶዳችሱን ግብጥ ኬሳ ባፍቴ። <verse eid="JER 32:21"/><verse number="22" style="v" sid="JER 32:22"/>ብየ ኣነኒፊ ደመ ባሱ ከን አት አቦቲሳኒቲፍ ኬኑፍ ከከቴ ከነ እሳኒፍ ኬንቴ። <verse eid="JER 32:22"/><verse number="23" style="v" sid="JER 32:23"/>እሳንስ ብየቲ ሴነኒ ዻለን፤ ገሩ ሲፍ ህንአጀጀምኔ ዮካን ሴረኬ ዱካ ህንቡኔ። ዋን አት አከ እሳን ሆጄተን አጀጄስ ህንሆጄትኔ። ከናፉ አት በዲሰ ከነ ሁንደ እሳንት ፍዴ።<verse eid="JER 32:23"/></para>
  <para style="pm">
    <verse number="24" style="v" sid="JER 32:24"/>“ኩኖ መጋላ ፉዸቹፍ ቱላን ብዮ እት መርፈሜረ። ሰበቢ ጎራዴ፣ ቤላቲፊ ዸእቻቲፍ መጋላን ኩን ባብሎኖተ አመ እሰ ሎላ ጅረንት ደበርፈሜ ንኬነመ። ወን አት ዱበቴ ሱን አኩመ አት አመ አርግቱ ከነ ፊጣን በኤረ። <verse eid="JER 32:24"/><verse number="25" style="v" sid="JER 32:25"/>ያ <char style="nd">ዋቀዮ</char> ጎፍታ፣ አት ዮ መጋለቲን ኩን ደበርፈምቴ ባብሎኖተት ኬነምቴዩ ‘ሜቲዻን ለፈ ቆቲሳ ብተዹቲ ብታፊ ጉርጉርታሳሌ ረጋ ቀባችስ’ ናን ጄተ።”<verse eid="JER 32:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JER 32:26"/>ኤርገሲስ ዱቢን <char style="nd">ዋቀዮ</char> አከነ ጄዼ ገረ ኤርምያስ ዹፌ፦ <verse eid="JER 32:26"/><verse number="27" style="v" sid="JER 32:27"/>“አን <char style="nd">ዋቀዮ</char>፣ ዋቀ ነመ ሁንዳት፤ ወን አን ህንደንዴኜ ቶኮዩ ጅራ? <verse eid="JER 32:27"/><verse number="28" style="v" sid="JER 32:28"/>ከናፉ <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ አን መጋላ ከነ ደበርሴ ባብሎኖታፊ ኔቡከድኔዘር ሞትቸ ባብሎንት ኬኑፍ ጅረ፤ እንስ እሼ ንቀበተ። <verse eid="JER 32:28"/><verse number="29" style="v" sid="JER 32:29"/>ባብሎኖትን መጋላ ከነ ሎላ ጅረን ኩኔን መጋለቲ ሴነኒ እብደ እት ቀብሲሱ፤ እሳንስ መኔን ነሞትን በንቲሳኒረት በኣሊፍ እጣነ ኣርሱፊ ዋቆተ ብራፍስ ዽባዩ ዽባፈቹዻን ዼከምሳፍ ነ ከካሰን ሰነሌ ወሉማን ንጉቡ።<verse eid="JER 32:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JER 32:30"/>“ሰብን እስራኤሊፊ ሰብን ይሁዳ እጆሉማሳኒቲ ጀልቀበኒ ፉለኮ ዱረት ዋን ሀማ መሌ ሆማ ህንሆጄትኔ፤ ዹጉማን ሰብን እስራኤል ዋን ሀርኩመሳኒቲን ሆጄተኒን ዼከምሳፍ ነ ከካሰን መሌ ሆማ ህንሆጄትኔ፣ ጄዸ <char style="nd">ዋቀዮ</char>። <verse eid="JER 32:30"/><verse number="31" style="v" sid="JER 32:31"/>መጋለቲን ኩን ጋፈ እጃረምቴ ጀልቀብዴ ሀመ አማት አከ አን ፉለኮ ዱራ እሼ በሌሱፍ ነ ኣርስቴ ዼከምሳፍ ነ ከካስቴ። <verse eid="JER 32:31"/><verse number="32" style="v" sid="JER 32:32"/>ሰብን እስራኤሊፊ ሰብን ይሁዳ ጄቹንስ እሳን፣ ሞቶትንሳኒቲፊ ቆንዳልቶትንሳኒ፣ ሉቦትንሳኒቲፊ ራጆትንሳኒ፣ ነሞትን ይሁዳቲፊ ነሞትን ዬሩሳሌም ሀምነ ሆጄተን ሁንዳን ዼከምሳፍ ነ ከካሰኒሩ። <verse eid="JER 32:32"/><verse number="33" style="v" sid="JER 32:33"/>እሳን ፉለሳኒ ዺሰኒ ዱግደሳኒ ነት ገረገልፈተን፤ ዮ አን አሙማ አመ እሳን በርሲሴዩ እሳን ነ ህንዸጌፈትኔ ዮካን ቀጄልፈመኮቲን ህንጌደረምኔ። <verse eid="JER 32:33"/><verse number="34" style="v" sid="JER 32:34"/>እሳን ዋቆተሳኒ በልፈሞ ሰነ መነ መቃኮቲን ዋመሙ ኬሰ ዻበተኒ መንቸ ጡሬሰን። <verse eid="JER 32:34"/><verse number="35" style="v" sid="JER 32:35"/>እሳንስ እልማንሳኒቲፊ እንተለንሳኒ ኣርሳ ጎዸኒ ሞሌኪፍ ዽኤሱፍ ጄዸኒ ሱሉለ ቤን ህኖም ኬሰት በኣሊፍ እዶ ሰገዳ እጃረን፤ አን ገሩ አከ እሳን ዋን ጅብሲሳ አከና ሆጄተኒ ይሁዳሌ ጩቡ ሆጄቺሰን ጎንኩማ እሳን ህንአጀጅኔ ዮካን ወን ኩን ቀልቢኮ ኬሰሌ ህንቱሬ።<verse eid="JER 32:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JER 32:36"/>“አት ዋኤ መጋለቲ ከና፣ ‘እሼን ጎራዴዻን፣ ቤላፊ ዸእቻን ደበርፈምቴ ሞትቸ ባብሎንት ኬነምት’ ጄተ፤ <char style="nd">ዋቀዮ</char> ዋቅን እስራኤል አከነ ጄዸ፦ <verse eid="JER 32:36"/><verse number="37" style="v" sid="JER 32:37"/>አን ዹጉማን ብዮተ አን ኣሪኮ ሶዳችሳፊ ዼከምሰኮ ጉዳዻን እት እሳን አርኤ ሁንደ ኬሳ ወልት እሳን ነንቀበ፤ እዶ ከነትስ እሳን ዴብሴ ነጋን እሳን ጅራችሰ። <verse eid="JER 32:37"/><verse number="38" style="v" sid="JER 32:38"/>እሳን ሰበኮ ተኡ፤ አንስ ዋቀሳኒ ነንተአ። <verse eid="JER 32:38"/><verse number="39" style="v" sid="JER 32:39"/>አን አከ እሳኒቲፊ እጆሌሳኒ ከኔን እሳን ቦዴትስ ጅሬኝ ቶሉፍ ጄዸኒ አከ በረ በራን ነ ሶዳተኒፍ ገራ ቶኮፊ ከራ ቶኮ እሳኒፍን ኬነ። <verse eid="JER 32:39"/><verse number="40" style="v" sid="JER 32:40"/>አን ከኩ በረ በራ እሳን ወጅን ነንገለ፤ አከ እሳን ጎንኩማ ነራ ህንገረገሌፍ አን ዋን ጋሪ እሳኒፍ ጎቹ ህንዺሱ፤ አከ እሳን ነ ሶዳተኒፍስ እሳን ነንከካሰ። <verse eid="JER 32:40"/><verse number="41" style="v" sid="JER 32:41"/>አን ዋን ጋሪ እሳኒፍ ጎቹት ነንገመደ፤ ገራኮፊ ሉቡኮ ጉቱዻን፣ አመነሙማዻንስ ብየ ከነ ኬሰ እሳን ነንዻበ።<verse eid="JER 32:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="JER 32:42"/>“<char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ አን አኩመን በዲሰ ጉዳ ከነ ሁንደ ሰበ ከነት ፍዴ ሰነ ዋን ጋሪ ዋዳ እሳኒፍ ሴኔ ሰነ ሁንደ ነንኬናፍ። <verse eid="JER 32:42"/><verse number="43" style="v" sid="JER 32:43"/>ብየ እስን፣ ‘ብየቲን ኩን ኦንቴ ዱዋ ሀፍቴርት፤ ነምን ዮካን ብኔንስ እሼ ኬሰ ህንጅሩ፤ እሼን ደበርፈምቴ ባብሎኖተት ኬነምቴርቲቲ’ ጄተኒ ዋኤሼ ዱበተን ከነ ኬሰት ለፍት ቆቲሳ አመሌ ንብተመ። <verse eid="JER 32:43"/><verse number="44" style="v" sid="JER 32:44"/>ብየ ቤንያም ኬሰት፣ ገንዶተ ናኖ ዬሩሳሌም ኬሰት፣ መጋላወን ይሁዳቲፊ መጋላወን ብየ ጋራ ኬሰት፣ መጋላወን ጋረን ዽኣቲፊ ከን ኔጌብ ኬሰት ለፍት ቆቲሳ ሜቲዻን ንብተመ፤ ወሊ ገልቴን ብታ ጉርጉርታሳስ መለቴፈሜ ቻፓን እት ጎዸሜ ዹገ ባቶታን ንረጌፈመ፤ አን ቦጁሳኒ እዶ ዱሪት ነንዴብሳቲ፣ ጄዸ <char style="nd">ዋቀዮ</char>።”<verse eid="JER 32:44"/></para>
  <chapter eid="JER 32"/>
  <chapter number="33" style="c" sid="JER 33"/>
  <para style="s1">ዋዳ ብየት ዴብኡ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 33:1"/>ኡቱ ኤርምያስ አመዩ ኦብዲ ኤጉምሳ ኬሰት ህዸሜ ጅሩ፣ ዱቢን <char style="nd">ዋቀዮ</char> ዬሮ ለመፋ አከነ ጄዼ ገረሳ ዹፌ፦ <verse eid="JER 33:1"/><verse number="2" style="v" sid="JER 33:2"/>“<char style="nd">ዋቀዮ</char> እን ለፈ ኡሜ፣ <char style="nd">ዋቀዮ</char> እን ለፈ ቶልቼ ጀቤሴ እሼ ዻቤ፣ ከን መቃንሳ <char style="nd">ዋቀዮ</char> ጄዸሙ ሱን አከነ ጄዸ፤ <verse eid="JER 33:2"/><verse number="3" style="v" sid="JER 33:3"/>‘አት ገረኮት እየዹ፤ አንስ ዴቢ ሲፍን ኬና፤ ዋን ጉዳፊ ዾክሳ አት ህንቤክኔ ስት ነንህመ።’ <verse eid="JER 33:3"/><verse number="4" style="v" sid="JER 33:4"/><char style="nd">ዋቀዮ</char> ዋቅን እስራኤል ዋኤ መኔን መጋላ ከናቲፊ ዋኤ መሰራ ሞቶተ ይሁዳ ከኔን እቲን ቱላ ብዮቲፊ ጎራዴ ኦፍራ ዾዉፍ ዲገመን ሰና አከነ ጄዻቲ፤ <verse eid="JER 33:4"/><verse number="5" style="v" sid="JER 33:5"/>ባብሎኖትን ሎሉፍ ንዹፉ፤ ‘እሳንስ መጋላ ከነ ሬፈ ነሞተ አን ኣሪፊ ዼከምሰኮቲን ፍጡቲን ንጉቱ። አን ሰበቢ ሀምነሼ ሁንዳቲፊ መጋላ ከነ ዱራ ፉለኮ ዾክፈዼራቲ።<verse eid="JER 33:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 33:6"/>“ ‘ተኡስ አን እሳን ነንፈይሰ፤ ነንበየነቺሰስ፤ አን ሰበኮ ነንፈይሰ፤ አከ እሳን ነጋፊ ተስገቢ ጉዳን ጅራተን ነንጎዸ። <verse eid="JER 33:6"/><verse number="7" style="v" sid="JER 33:7"/>አን ይሁዳፊ እስራኤልን ቦጁዻ ዴብሴ አከ እሳን ዱር ቱረንት ነንእጃረ። <verse eid="JER 33:7"/><verse number="8" style="v" sid="JER 33:8"/>ጩቡ እሳን ነት ሆጄተን ሁንደራ እሳን ነንቁልቁሌሰ፤ ጩቡ እሳን ነት ፍንጭሉን ሆጄተን ሁንደስ ነንዺሳፍ። <verse eid="JER 33:8"/><verse number="9" style="v" sid="JER 33:9"/>መጋላን ኩን ፉለ ሰቦተ ለፈራ ወረ ዋን ጋሪ አን እሼፍ ጎዼ ሁንደ ዸገአን ሁንዳ ዱረት መቃ፣ ገመቹ፣ ገለታፊ ኡልፍነ ና ታት፤ እሳን ሰበቢ በዻዹማፊ ነጋ አን እሼፍ ኬኑ ሁንዳቲፍ ሶዳተኒ ሆለተን።’<verse eid="JER 33:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 33:10"/>“<char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ ‘እስን ዋኤ እዶ ከና፣ “ብየቲን ኩን ኦንቴ ዱዋ ሀፍቴርት፤ ነምን ዮካን ብኔንስ እሼ ኬሰ ህንጅሩ” ጄቱ። ተኡሌ መጋላወን ይሁዳቲፊ ዳንዲወን ዬሩሳሌም ከኔን ዱዋ ሀፈኒ ነምን ዮካን ብኔንስ ኬሰ ህንጅሬ ሰነ ኬሰት አመሌ፣ <verse eid="JER 33:10"/><verse number="11" style="v" sid="JER 33:11"/>ሰገሌን እልሌቲፊ ገመቹ፣ ሰገሌን ምስርቻቲፊ ምስርቲ፣ ሰገሌን ወረ መነ <char style="nd">ዋቀዮት</char> ኣርሳ ዽኤሰኒ ከን፣</para>
  <para style="q1" vid="JER 33:11">“<char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ ገለቴፈዻ፤</para>
  <para style="q2" vid="JER 33:11">
    <char style="nd">ዋቀዮ</char> ጋሪዻቲ፤</para>
  <para style="q2" vid="JER 33:11">ጃለልሳስ በረ በራን ንጅራተ”</para>
  <para style="m" vid="JER 33:11">ጄዹ ንዸገአመ። አን ቦጅአምቶተ ብየቲ አኩመ እሳን ዱራን ቱረንትን ዴብሳቲ’ ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 33:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 33:12"/>“<char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ አከነ ጄዸ፦ ‘እዶ ኦና ነምን ዮካን ሆሪን ኬሰ ህንጅራትኔ ከናፊ መጋላወንሼ ሁንደ ኬሰ ለፍት ዼዳ ከን ትክሶትን ቡሻዬሳኒ እት ቦቆቺፈተን አመስ ንጅራተ። <verse eid="JER 33:12"/><verse number="13" style="v" sid="JER 33:13"/>መጋላወን ብየ ጋራ ኬሰት፣ ከኔን ጋረን ዽኣቲፊ ኔጌብ ኬሰት፣ ብየ ቤንያም ኬሰት፣ ገንዶተ ናኖ ዬሩሳሌሚፊ መጋላወን ይሁዳ ኬሰት አመሌ ቡሻዬን ሀርከ ነመ እሳን ቶአቱ ጀለ ንሁሉቁ’ ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 33:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 33:14"/>“ ‘በር አን’ ጄዸ <char style="nd">ዋቀዮ</char> ‘ዋዳ ጋሪ አን መነ እስራኤሊፊ መነ ይሁዳቲፍ ሴኔ ሰነ እት ፊጣን ባሱ ንዹፈ።’<verse eid="JER 33:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 33:15"/>“ ‘በረ ሰነ ኬሰ፣ ዬሮ ሰነት</para>
  <para style="q2" vid="JER 33:15">አን አከ ደሜን ቀጄላን ቶኮ ሰኚ ዳዊት ኬሳ ለቱ ነንጎዸ፤</para>
  <para style="q2" vid="JER 33:15">እን ዋን ቀጄላፊ ስሪ ተኤ ብየቲ ኬሰት ንሆጄተ።<verse eid="JER 33:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 33:16"/>በረ ሰነ ኬሰ ይሁዳን ንፈየ፤</para>
  <para style="q2" vid="JER 33:16">ዬሩሳሌምስ ነጋን ጅራት።</para>
  <para style="q1" vid="JER 33:16">መቃን እሼን እቲን ዋመምቱስ፣</para>
  <para style="q2" vid="JER 33:16">
    <char style="nd">ዋቀዮ</char> ቀጄሉማኬኘ’ ጄዸመ።<verse eid="JER 33:16"/></para>
  <para style="m">
    <verse number="17" style="v" sid="JER 33:17"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዻቲ፦ ‘ዳዊት ጎንኩማ ነመ ቴሶ መነ እስራኤልረ ታኡ ህንዸቡ፤ <verse eid="JER 33:17"/><verse number="18" style="v" sid="JER 33:18"/>ዮካን ሉቦትን ወር ሌዎተ ተአን ጎንኩማ ነመ ኣርሳ ጉበሙ ዽኤሱፍ፣ ኬና ምዻኒ ጉቡፊ ቀልመ ዽኤሱፍ እቱመ ፉፌ ፉለኮ ዱረ ዻበቱ ህንዸበን።’ ”<verse eid="JER 33:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 33:19"/>ዱቢን <char style="nd">ዋቀዮ</char> አከነ ጄዼ ገረ ኤርምያስ ዹፌ፦ <verse eid="JER 33:19"/><verse number="20" style="v" sid="JER 33:20"/>“<char style="nd">ዋቀዮ</char> አከነ ጄዸ፤ ‘ዮ እስን አከ ሀልከኒፊ ጉያን ዬሮሳኒ ኬነሜት ህንዹፍኔፍ ከኩ አን ሀልከን ወጅን ገሌፊ ከኩ አን ጉያ ወጅን ገሌ ሰነ ጨብሱ ደንዴሰን፣ <verse eid="JER 33:20"/><verse number="21" style="v" sid="JER 33:21"/>ከኩን አን ገርብቸኮ ዳዊት ወጅን ገሌፊ ከኩን አን ሌዎተ ሉቦተ ተአኒ ፉለኮ ዱረ ተጃጅለን ወጅን ገሌ ሱን ጨቡ ደንደአ፤ ዳዊትስ ስአች ሰኚ ቴሶሳረ ታኤ ቡልቹ ህንቀባቱ። <verse eid="JER 33:21"/><verse number="22" style="v" sid="JER 33:22"/>አን ሰኚ ገርብቸኮ ዳዊቲፊ ሌዎተ ፉለኮ ዱረ ተጃጅለን አኩመ ኡርጂወን ሰሚቲፊ አኩመ ጭረቸ ቀርቀረ ገላና ከን መዳለሙ ህንደንዴኜ ነንባይእሰ።’ ”<verse eid="JER 33:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JER 33:23"/>ዱቢን <char style="nd">ዋቀዮ</char> አከነ ጄዼ ገረ ኤርምያስ ዹፌ፦ <verse eid="JER 33:23"/><verse number="24" style="v" sid="JER 33:24"/>“አት አከ ኡመትን ኩን፣ ‘<char style="nd">ዋቀዮ</char> ሞቱሞተ ፍለቴ ቱሬ ለማን ገቴረ’ ጄቻ ጅሩ ህንቀልቤፈትኔ? ከናፉ እሳን ሰበኮ ቱፈተኒሩ፤ ስአችስ አከ ሰበ ቶኮት እሰ ህንእላለን። <verse eid="JER 33:24"/><verse number="25" style="v" sid="JER 33:25"/><char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ ‘አን ኡቱ ሀልከኒፊ ጉያ ወጅን ከኩኮ ጀቤሴ ዻቡ ባዼ፣ ሰሚፊ ለፋፍስ ሴረ ካኡ ባዼ፣ <verse eid="JER 33:25"/><verse number="26" style="v" sid="JER 33:26"/>ስላ ሰኚ ያቆቢፊ ሰኚ ተጃጅላኮ ዳዊት ገቴ አከ እን ሰኚ አብረሃም፣ ሰኚ ይስሃቂፊ ከን ያቆብ ቡልቹፍ እልማንሳ ኬሳ ነመ ቶኮ ህንፍለዹ ቱሬ። አንስ ቦጅአምቶተሳኒ ነንዴብሰ፤ ገራሌ ነንላፋፍ።’ ”<verse eid="JER 33:26"/></para>
  <chapter eid="JER 33"/>
  <chapter number="34" style="c" sid="JER 34"/>
  <para style="s1">አኬከቺሰ ዜዴቅያፍ ኬነሜ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 34:1"/>ዬሮ ኔቡከድኔዘር ሞትች ባብሎኒቲፊ ሎልቶትንሳ ሁንድ፣ ሞቱሞትኒፊ ሰቦትን ብየ እን ቡልቹ ኬሰ ጅራተን ሁንድ ዬሩሳሌሚፊ መጋላወን ናኖሼ ሁንደ ሎላ ቱረንት ዱቢን አከነ ጄዹ ቶኮ <char style="nd">ዋቀዮ</char> ብራ ገረ ኤርምያስ ዹፌ፤ <verse eid="JER 34:1"/><verse number="2" style="v" sid="JER 34:2"/>“<char style="nd">ዋቀዮ</char> ዋቅን እስራኤል አከነ ጄዸ፦ ገረ ዜዴቅያ ሞትቸ ይሁዳ ዸቂቲ አከነ ጄዺን፤ ‘<char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ አን መጋላ ከነ ደበርሴ ሞቲ ባብሎንት ነንኬነ፤ እንስ እሼ ጉበ። <verse eid="JER 34:2"/><verse number="3" style="v" sid="JER 34:3"/>አት ዹጉማን ቀበምቴ ደበርፈምቴ እሰት ኬነምተ መሌ ሀርከሳ ጀላ ህንምልቅጡ። ሞቲ ባብሎን እጁመኬቲን ንአርግተ፤ እንስ ከለቲን ስ ወጅን ንዱበተ። አትስ ባብሎንት ንጌፈምተ።<verse eid="JER 34:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 34:4"/>“ ‘ተኡስ ያ ዜዴቅያ ሞትቸ ይሁዳ፣ አት ዱቢ <char style="nd">ዋቀዮ</char> ዸገእ። <char style="nd">ዋቀዮ</char> ዋኤኬ አከነ ጄዸ፦ አት ጎራዴን ህንዱቱ፤ <verse eid="JER 34:4"/><verse number="5" style="v" sid="JER 34:5"/>ገሩ ነጉማን ዱተ። ነሞትን አኩመ ኡልፍነ አዋለ አቦቲኬቲ ሞቶተ ሲን ዱራቲፍ እብደ ቀብሲሰን ሰነ ኡልፍነኬቲፍ እብደ ቀብሲሰኒ፣ “ወዮ ያ ጎፍታ!” ጄዸኒ ቦኡ። አን መታንኮ ዱቢ ከነ ዱበዼራቲ፣ ጄዸ <char style="nd">ዋቀዮ</char>።’ ”<verse eid="JER 34:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 34:6"/>ኤርምያስ ራጅች ዬሩሳሌም ኬሰት ዋን ከነ ሁንደ ዜዴቅያ ሞትቸ ይሁዳት ህሜ፤ <verse eid="JER 34:6"/><verse number="7" style="v" sid="JER 34:7"/>ዬሮ ሰነት ሎልቶትን ሞቲ ባብሎን ዬሩሳሌሚፊ መጋላወን ይሁዳ ጄቹንስ ላኪሺፊ አዜቃ ሎላ ቱረን። መጋላወን ይሁዳ ከኔን ደላ ጀባ ቀበን ኬሳ ከኔን ሀፈን እሳኑመ ከነ ቆፈ ቱረኒቲ።<verse eid="JER 34:7"/></para>
  <para style="s1">ገርቦተ ብልሶምሱ</para>
  <para style="p">
    <verse number="8" style="v" sid="JER 34:8"/>ኤርገ ዜዴቅያ ሞትች ብልሱማ ገርቦታ ለብሱፍ ጄዼ ኡመተ ዬሩሳሌም ኬሰ ጅራቱ ሁንደ ወጅን ከኩ ገሌ ቦዴ ዱቢን ቶኮ <char style="nd">ዋቀዮ</char> ብራ ገረ ኤርምያስ ዹፌ። <verse eid="JER 34:8"/><verse number="9" style="v" sid="JER 34:9"/>ቶኮን ቶኮ ነማ ገርበሳ ዺራ ዱበርቲ ሰኚ እብሮታ ተአን ብልሰ ባሱ ቀበ ቱሬ፤ ነምን ከምዩ ይሁዲ ሰኚሳ ተኤ ቶኮ ገርቡማ ኬሰት ሀምብሱ ህንቀቡ። <verse eid="JER 34:9"/><verse number="10" style="v" sid="JER 34:10"/>ከናፉ ቆንዳልቶትኒፊ ነሞትን ከኩ ሰነ ሴነን ሁንድ ገርቦተሳኒ ዺሮታ ዱበርቲ ብልሰ ባሱፊ አከ ስአችስ እሳን ህንገርቦምፈትኔ ወሊ ገለን። እሳንስ ቶሌ ጄዸኒ ጀረ ብልሰ ባሰን። <verse eid="JER 34:10"/><verse number="11" style="v" sid="JER 34:11"/>ኤርገሲ ገሩ ያደሳኒ ጌደረተኒ ገርቦተ ብልሰ ባሰኒ ቱረን ሰነ ዴብፈተኒ አመሌ ገርቦምፈተን።<verse eid="JER 34:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 34:12"/>ኤርገሲ ዱቢን <char style="nd">ዋቀዮ</char> አከነ ጄዼ ገረ ኤርምያስ ዹፌ፦ <verse eid="JER 34:12"/><verse number="13" style="v" sid="JER 34:13"/>“<char style="nd">ዋቀዮ</char> ዋቅን እስራኤል አከነ ጄዸ፦ አን ዬሮን ግብጢ ብየ ገርቡማቲ እሳን ባሴት አቦቲኬሰን ወጅን አከነ ጄዼ ከኩ ገሌ፤ <verse eid="JER 34:13"/><verse number="14" style="v" sid="JER 34:14"/>‘ቶኮን ቶኮንኬሰን ወጋ ቶርበ ቶርበት ነመ ሰኚ እብሮታ ከን እስንት ኦፍ ጉርጉሬ ከምዩ ብልሰ ባሱ ቀብዱ። ኤርገ እን ወጋ ጀአ እስን ተጃጅሌ ቦዴ እስን ገድ እሰ ዺሱ ቀብዱ።’ አቦቲንኬሰን ገሩ ነ ህንዸጌኜ፤ ጉረስ ና ህንኬንኔ። <verse eid="JER 34:14"/><verse number="15" style="v" sid="JER 34:15"/>እስንሞ ዽኦ ከነ ቀልቢ ጅጂረተኒ ዋን ፉለኮ ዱረት ቀጄላ ተኤ ጎተኒርቱ፦ ቶኮን ቶኮንኬሰንስ ለሚወንኬሰኒፍ ብልሱማ ለብስተኒርቱ። መነ መቃኮቲን ዋመሙ ኬሰት ፉለኮ ዱረት ከኩ ገልተኒርቱ። <verse eid="JER 34:15"/><verse number="16" style="v" sid="JER 34:16"/>አመ ገሩ ገረገልተኒ መቃኮ ጡሬስተን፤ ቶኮን ቶኮንኬሰን ገርቦተ ዺራ ዱበርቲ እስን አከ እሳን ገረ ፌዸን ዴመኒፍ ብልሰ ባፍተኒ ቱርተን ሰነ ዴብፍተኒ ፉዸተኒርቱ። አከ እሳን አመስ ገርቦተኬሰን ተአኒፍ እሳን ድርቀምሲፍተኒርቱ።<verse eid="JER 34:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 34:17"/>“ከናፉ <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ እስን ናፍ ህንአጀጀምኔ፤ ለሚወንኬሰኒፍስ ብልሱማ ህንለብስኔ። ከናፉ አን አመ፣ ‘ብልሱማ እስኒ ነንለብሰ’ ጄዸ <char style="nd">ዋቀዮ</char>፤ ‘ብልሱማን’ ኩንስ ብልሱማ ጎራዴዻን፣ ዸእቻፊ ቤላን ዹሙት። አን ፉለ ሞቱሞተ ለፋ ሁንዳ ዱረትስ አከ እስን ጅበምተን ነንጎዸ። <verse eid="JER 34:17"/><verse number="18" style="v" sid="JER 34:18"/>ወረ ከኩኮ ጨብሰኒ ወሊ ገልቴ ከኩ ፉለኮ ዱረት ጎዸን ሰና ህንኤግንሞ አኩመ ጀቢ እሳን እዶ ለመት ቆደኒ ግዱሳኒ በአኒ ደርበን ሰና ነንጎዸ። <verse eid="JER 34:18"/><verse number="19" style="v" sid="JER 34:19"/>ዱረ ቡቶተ ይሁዳቲፊ ዬሩሳሌም፣ ቆንዳልቶተ መነ ሙርቲ፣ ሉቦታፊ ኡመተ ብየቲ ከኔን ጀቢ ገርገር ቆደሜ ሰነ ግዱ በአኒ ደርበን ሁንደ፣ <verse eid="JER 34:19"/><verse number="20" style="v" sid="JER 34:20"/>ደበርሴ ዲኖተ ሉቡሳኒ በሌሱ በርባደንት ነንኬነ። ሬፍሳኒ አላቲ ሰሚቲፊ ብኔንሶተ ለፋቲፍ ኛተ ንተአ።<verse eid="JER 34:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 34:21"/>“አንስ ዜዴቅያ ሞትቸ ይሁዳቲፊ ቆንዳልቶተሳ ደበርሴ ዲኖተሳኒ ወረ ሉቡሳኒ በሌሱ በርባደንት፣ ሎልቶተ ሞቲ ባብሎን ከኔን እስን ሎሉራ ዴብአንት ነንኬነ። <verse eid="JER 34:21"/><verse number="22" style="v" sid="JER 34:22"/>አን አጀጀ ኬኔ፣ ገረ መጋላ ከናት ዴብሴ እሳን ነንፍደ ጄዸ <char style="nd">ዋቀዮ</char>። እሳንስ እሼ ንሎሉ፤ ቀበተኒስ እብዳን እሼ ጉቡ። አንስ አከ ነምን ቶኮዩ ኬሰ ህንጅራኔፍ መጋላወን ይሁዳ ነንኦንሰ።”<verse eid="JER 34:22"/></para>
  <chapter eid="JER 34"/>
  <chapter number="35" style="c" sid="JER 35"/>
  <para style="s1">ሬካቦተ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 35:1"/>ዱቢን በረ ዬሆያቂም እልም ዮስያስ ሞቲ ይሁዳ ቱሬት <char style="nd">ዋቀዮ</char> ብራ ገረ ኤርምያስ ዹፌ አከነ ጄዸ፦ <verse eid="JER 35:1"/><verse number="2" style="v" sid="JER 35:2"/>“ገረ መነ ሬካቦታ ዸቂቲ ገረ መነ <char style="nd">ዋቀዮት</char> እሳን ዋም፤ ኩታ መና ቶኮት ኦል እሳን ገልቺቲ አከ ዹገኒፍ ዳዺ ወይኒ ኬኒፍ።”<verse eid="JER 35:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 35:3"/>አንስ ዸቄን ያዘንያ እልመ ኤርምያስ፣ እልመ ሀበዝኔያ፣ ኦቦሎተሳቲፊ እልማንሳ ሁንደ ጄቹንስ ማቲ ሬካቦታ ጉቱ ዋሜ። <verse eid="JER 35:3"/><verse number="4" style="v" sid="JER 35:4"/>አንስ ገረ መነ <char style="nd">ዋቀዮት</char> እሳን ፍዴ ኩታ መነ እልማን ሃናን እልመ ይግዳልያ ነመ ዋቃ ሰናት ኦል ገልቼ። ኩታን ሱንስ ኩታ ቆንዳልቶታ ከን ኩታ መአሴያ እልመ ሸሉም ነምቸ በልበለ ኤጉ ሰናቲ ኦል ጅሩት ኣነ ቱሬ። <verse eid="JER 35:4"/><verse number="5" style="v" sid="JER 35:5"/>አንስ ወጪቲወን ዳዺ ወይኒቲን ጉተመኒፊ ጦፎ ፉለ ሬካቦታ ዱረት ዽኤሴን፣ “ዳዺ ወይኒ ከነ ዹጋ” ጄዼን።<verse eid="JER 35:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 35:6"/>እሳን ገሩ አከነ ጄዸኒ ዴብሰን፦ “ኑ ሰበቢ አባንኬኘ ዮናዳብ እልም ሬካብ አከነ ጄዼ ኑ አጀጄፍ ዳዺ ወይኒ ህንዹግኑ፦ ‘እስን ዮካን ሰኚንኬሰን ጎንኩማ ዳዺ ወይኒ ህንዹግና። <verse eid="JER 35:6"/><verse number="7" style="v" sid="JER 35:7"/>አከሱመስ እስን መነ እጃረቹ፣ ሰኚ ፈጫፈቹ ዮካን ወይኒ ዻበቹ ህንቀብደን፤ እስን ዬሮ ሁንደ ዱንካኖተ ኬሰ ጅራቹ ቀብዱ መሌ ዋን ከኔን ኬሳ ቶኮሌ ቀባቹ ህንቀብደን። ዮስ እስን ብየ እት ኬሱማ ታተን ኬሰ በረ ዼራ ንጅራቱ።’ <verse eid="JER 35:7"/><verse number="8" style="v" sid="JER 35:8"/>ኑ ዋን አባንኬኘ ዬሆናዳብ እልም ሬካብ ኑ አጀጄ ሁንደ ኤግኔረ። ኑ ዮካን ኒቶትንኬኘ ዮካን እልማኒፊ እንተለንኬኘ ዳዺ ወይኒ ህንዹግኔ። <verse eid="JER 35:8"/><verse number="9" style="v" sid="JER 35:9"/>ዮካን መነ ኬሰ ጅራትኑ ዮካን ወይኒ፣ ለፈ ቆቲሳ ዮካን ምዻን ህንቀብኑ። <verse eid="JER 35:9"/><verse number="10" style="v" sid="JER 35:10"/>ኑ ዱንካነ ኬሰ ጅራትኔ ዋን አባንኬኘ ዮናዳብ ኑ አጀጄ ሁንደ ኤግኔረ። <verse eid="JER 35:10"/><verse number="11" style="v" sid="JER 35:11"/>ገሩ ዬሮ ኔቡከድኔዘር ሞትች ባብሎን ብየ ከነ ቀበቴት ኑ፣ ‘ኮታ፤ ኑ ባብሎኖታፊ ሎልቶተ ሶርያ ዱራ በቀትኔ ዬሩሳሌምት ገሉ ቀብነ’ ወሊን ጄኔ። አከሲንስ ኑ ዬሩሳሌም ኬሰት ሀፍኔ።”<verse eid="JER 35:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 35:12"/>ኤርገሲ ዱቢን <char style="nd">ዋቀዮ</char> አከነ ጄዼ ገረ ኤርምያስ ዹፌ፦ <verse eid="JER 35:12"/><verse number="13" style="v" sid="JER 35:13"/>“<char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል አከነ ጄዸ፦ ዸቂቲ ነሞተ ይሁዳቲፊ ሰበ ዬሩሳሌሚን ‘እስን ጎርሰኮ ፉዸተኒ ናፍ ህንአጀጀምተኒ?’ ጄዽ፣ ጄዸ <char style="nd">ዋቀዮ</char>። <verse eid="JER 35:13"/><verse number="14" style="v" sid="JER 35:14"/>‘ዬሆናዳብ እልም ሬካብ አከ እልማንሳ ዳዺ ወይኒ ህንዹግኔ አጀጄ፤ አጀጅን ኩንስ ኤገሜረ። እሳን ሰበቢ አጀጀ አባሳኒ ኤገኒፍ ሀመ ሀርኣት ዳዺ ወይኒ ህንዹገን። አን ገሩ አሙማ አመ እስንት ዱበዼረ፤ እስንሞ ናፍ ህንአጀጀምኔ። <verse eid="JER 35:14"/><verse number="15" style="v" sid="JER 35:15"/>አን ተጃጅልቶተኮ ራጆተ ሁንደ አሙማ አመ እስንት ኤርጌ። እሳን አከነ እስኒን ጄዸን፤ “ቶኮን ቶኮንኬሰን ከራኬሰን ሀማ ሰነራ ዴብተኒ ሆጂኬሰን ቀጄልፈቹ ቀብዱ። እሳን ተጃጅሉፍ ጄተኒ ዋቆተ ብራ ዱካ ህንቡእና። ዮስ እስን ብየ አን እስኒፊ አቦቲኬሰኒፍ ኬኔ ኬሰ ንጅራቱ።” እስን ጉረኬሰን ናፍ ህንኬንኔ፣ ዮካን ነ ህንዸጌፈትኔ። <verse eid="JER 35:15"/><verse number="16" style="v" sid="JER 35:16"/>ሰኚን ዬሆናዳብ እልመ ሬካብ አጀጀ አባንሳኒ እሳኒፍ ኬኔ ኤገኒሩ፤ ሰብን ኩን ገሩ ናፍ ህንአጀጀምኔ።’<verse eid="JER 35:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 35:17"/>“ከናፉ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል አከነ ጄዸ፦ ‘ዸጌፈዻ! አን ይሁዳቲፊ ነመ ዬሩሳሌም ኬሰ ጅራቱ ሁንደት በላ ነንፍደ ጄዼ ለብሴ ሰነ ሁንደ ነንፍደ። አን እሳንት ዱበዼን ቱሬ፤ እሳን ገሩ ህንዸጌፈትኔ። አን እሳን ዋሜን ቱሬ፤ እሳን ገሩ ህንአዋትኔ።’ ”<verse eid="JER 35:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 35:18"/>ኤርምያስስ ማቲ ሬካቦታቲን አከነ ጄዼ፤ “<char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል አከነ ጄዸ፦ ‘እስን አጀጀ አባኬሰን ዬሆናዳብ ኤግደኒ ጎርሰሳ ሁንደሌ ዱካ ቡተኒርቱ፤ ዋን እን እስን አጀጄ ሁንደስ ሆጄተኒርቱ።’ <verse eid="JER 35:18"/><verse number="19" style="v" sid="JER 35:19"/>ከናፉ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል አከነ ጄዸ፦ ‘ዮናዳብ እልም ሬካብ ጎንኩማ ነመ ፉለኮ ዱረ ዻበቴ ነ ተጃጅሉ ህንዸቡ።’ ”<verse eid="JER 35:19"/></para>
  <chapter eid="JER 35"/>
  <chapter number="36" style="c" sid="JER 36"/>
  <para style="s1">በሬፈመ ክታበ መረማራ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 36:1"/>በረ ዬሆያቂም እልም ዮስያስ ሞቲ ይሁዳ ቱሬ ኬሰ ወጋ አፉረፋት ዱቢን አከነ ጄዹ <char style="nd">ዋቀዮ</char> ብራ ገረ ኤርምያስ ዹፌ፦ <verse eid="JER 36:1"/><verse number="2" style="v" sid="JER 36:2"/>“ክታበ መረማ ፉዸዹቲ ዱቢ አን በረ ሞቱማ ዮስያሲ ጀልቀቤ ሀመ አማት ዋኤ እስራኤሊፊ ዋኤ ይሁዳ፣ ዋኤ ሰቦተ ካን ሁንዳስ ስት ዱበዼ ሰነ ሁንደረት በሬስ። <verse eid="JER 36:2"/><verse number="3" style="v" sid="JER 36:3"/>ተሪ ሰብን ይሁዳ ዬሮ ዋኤ በዲሰ አን እሳንት ፍዱፍ ያዴ ሁንዳ ዸገአንት ቶኮን ቶኮንሳኒ ከራሳኒ ሀማ ሰነራ ንዴብኡ ተአ፤ ዮስ አን ሀምነሳኒቲፊ ጩቡሳኒ ነንዺሳፍ።”<verse eid="JER 36:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 36:4"/>ኤርምያስስ ባሩክ እልመ ኔርያ ዋሜ፤ ባሩክሞ ዱቢ <char style="nd">ዋቀዮ</char> ዱበቴ ሰነ ኤርምያስራ ዸገኤ ክታበ መረማረት በሬሴ። <verse eid="JER 36:4"/><verse number="5" style="v" sid="JER 36:5"/>ኤርምያስ አከነ ጄዼ ባሩክን አጀጄ፤ “አን መነ <char style="nd">ዋቀዮ</char> ሴኑ ዾወሜረ። <verse eid="JER 36:5"/><verse number="6" style="v" sid="JER 36:6"/>ከናፉ አት ጉያ ሶማ ቶኮ መነ <char style="nd">ዋቀዮ</char> ዸቂቲ ዱቢ <char style="nd">ዋቀዮ</char> ከን ነራ ዸጌሴ በሬስቴ ሰነ ክታበ መረማራ ሰባፍ ዱብስ። ነሞተ ይሁዳ ወረ መጋላወንሳኒራ ዹፈን ሁንዳፍ ዱቢ ሰነ ዱብስ። <verse eid="JER 36:6"/><verse number="7" style="v" sid="JER 36:7"/>ተሪ እሳን ከዸትናሳኒ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዽኤፈተኒ ቶኮን ቶኮንሳኒ ከራሳኒ ሀማ ሰነራ ንዴብኡ ተአ፤ ኣሪፊ ዼከምስ <char style="nd">ዋቀዮ</char> ሰበ ከነረት ለብሴ ጉደዻቲ።”<verse eid="JER 36:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 36:8"/>ባሩክ እልም ኔርያስ ዋን ኤርምያስ ራጅች እሰት ህሜ ሁንደ ንሆጄቴ፤ መነ <char style="nd">ዋቀዮ</char> ኬሰትስ ክታበ መረማ ሰነራ ዱቢ <char style="nd">ዋቀዮ</char> ዱብሴ። <verse eid="JER 36:8"/><verse number="9" style="v" sid="JER 36:9"/>በረ ዬሆያቂም እልም ዮስያስ ሞቲ ይሁዳ ቱሬ ኬሰ ጅአ ሰግለፋ ወጋ ሸነፋት ጉያን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ሶመን ቶኮ ሰበ ዬሩሳሌም ኬሰ ጅራቱፊ ወረ መጋላወን ይሁዳቲ ዹፈን ሁንዳፍ ንለብሰሜ። <verse eid="JER 36:9"/><verse number="10" style="v" sid="JER 36:10"/>ባሩክስ ኩታ ጌማርያ እልመ ሻፋን በሬሳ ሰና ከን ኦብዲ ኦል ኣና ኬሰ በልበለ መነ ቁልቁሉማ፣ ከን ከረ ሃራ ጄዸሙ ብራ ሰነ ኬሰ ዻበቴ ሰበ መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ኬሰ ቱሬ ሁንዳፍ ዱቢ ኤርምያስ ሰነ ክታበ መረማራ ዱብሴ።<verse eid="JER 36:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 36:11"/>ሚክያስ እልም ጌማርያ እልመ ሻፋን ዬሮ ዱቢ <char style="nd">ዋቀዮ</char> ሁንደ ክታበ መረማራ ዸገኤት፣ <verse eid="JER 36:11"/><verse number="12" style="v" sid="JER 36:12"/>ገረ ኩታ በሬሳ ከን መሰራ ሞቱማ ኬሳ፣ እዶ ቆንዳልቶትን ሁንድ ተታኣ ቱረንት ገድ ቡኤ፤ እሳንስ ኤሊሻማ በሬሳ፣ ዴላያ እልመ ሼማእያ፣ ኤልናታን እልመ አክቦር፣ ጌማርያ እልመ ሻፋን፣ ዜዴቅያስ እልመ ሀናንያቲፊ ቆንዳልቶተ ብራ ሁንዳዸ። <verse eid="JER 36:12"/><verse number="13" style="v" sid="JER 36:13"/>ሚክያስ ዋን ዬሮ ባሩክ ክታበ መረማራ ኡመታፍ ዱብሴት ዸገኤ ሰነ ሁንደሳኒት ህሜ። <verse eid="JER 36:13"/><verse number="14" style="v" sid="JER 36:14"/>ቆንዳልቶትን ሁንድስ አከ እን ባሩኪን፣ “ክታበ መረማ ኡመታፍ ዱብፍቴ ሰነ ፍዲ ኮቱ” ጄዹፍ ዬሁዲ እልመ ናታንያ፣ እልመ ሼሌምያ፣ እልመ ኩሺ ኤርገን። ከናፉ ባሩክ እልም ኔርያ ክታበ መረማ ሰነ ሀርከት ቀበቴ ገረሳኒ ዸቄ። <verse eid="JER 36:14"/><verse number="15" style="v" sid="JER 36:15"/>ጀርስ፣ “ማሎ፣ ታኢቲ ክታብቸ ኑ ዱብስ” ጄዸኒን።</para>
  <para style="p" vid="JER 36:15">ከናፉ ባሩክ ክታበ ሰነ እሳኒፍ ዱብሴ። <verse eid="JER 36:15"/><verse number="16" style="v" sid="JER 36:16"/>እሳንስ ዮሙ ዱቢ ከነ ሁንደ ዸገአንት ሶዳዻን ወል እላለኒ ባሩኪን፣ “ኑ ዋን ከነ ሁንደ ሞትቸት ህሙ ቀብነ” ጄዸን። <verse eid="JER 36:16"/><verse number="17" style="v" sid="JER 36:17"/>ኤርገሲ እሳን ባሩኪን፣ “ሜ ኑት ህም፤ አት አከምት ዋን ከነ ሁንደ በሬስቴ? ኤርምያስቱ ስት ህሜ?” ጄዸኒ ጋፈተን።<verse eid="JER 36:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 36:18"/>ባሩክስ፣ “ኤዬ፣ ኤርምያስቱ ዱቢ ከነ ሁንደ ነት ህሜ፤ አንሞ ቀለሚዻን ክታበ መረማረት በሬሴ” ጄዼ ዴብሴ።<verse eid="JER 36:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 36:19"/>ከነረት ቆንዳልቶትን ሱን ባሩኪን፣ “አቲፊ ኤርምያስ ዸቃ ዾከዻ። ነምን ቶኮዩ እዶ እስን ጅርተን ህንቤክን” ጄዸን።<verse eid="JER 36:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 36:20"/>እሳንስ ክታበ መረማ ሰነ ኩታ ኤሊሻማ በሬሳ ሰና ኬሰ ካአኒ ሞትቸ ብረ ገረ ኦብዲ ዸቀኒ ዋን ሁንደ እሰት ህመን። <verse eid="JER 36:20"/><verse number="21" style="v" sid="JER 36:21"/>ሞትችስ አከ እን ክታብቸ ፍዱፍ ይሁዲ ኤርጌ፤ ዬሁዲንስ ኩታ ኤሊሻማ በሬሳ ሰና ኬሳ ክታብቸ ፍዴ ሞትቻፊ ቆንዳልቶተ እሰ ብረ ዻበቻ ቱረን ሁንዳፍ ዱብሴ። <verse eid="JER 36:21"/><verse number="22" style="v" sid="JER 36:22"/>ዬሮን ሱን ጅአ ሰግለፋ ቱሬ፤ ሞትችስ መነ እት ዬሮ ገና ደበርሱ ኬሰ ታኣ ቱሬ፤ እብድ ግርግራ ጉዳረት ቦበኡስ ፉለሳ ዱረ ቱሬ። <verse eid="JER 36:22"/><verse number="23" style="v" sid="JER 36:23"/>ዮሙ ዬሁዲን ክታበ መረማ ሰነ ኬሳ ቦኦ ሰዲ ዮካን አፉር ዱብሱት፣ ሞትች ሀመ ክታብን ሱን ጉቱማን ጉቱት ጉበቴ ዹሙት ሃዱ በሬሳቲን ኩኩቴ ግርግራ እብዳት ደርበቻ ቱሬ። <verse eid="JER 36:23"/><verse number="24" style="v" sid="JER 36:24"/>ተኡሌ ሞትቺፊ ተጃጅልቶትንሳ ከኔን ዱቢ ከነ ሁንደ ዸገአን ሁንድ ሆማ ህንሶዳትኔ ዮካን ኡፈተሳኒ ህንተርሳፍኔ። <verse eid="JER 36:24"/><verse number="25" style="v" sid="JER 36:25"/>ሞትች ዮ ኤልናታን፣ ዴላያፊ ጌማርያን አከ እን ክታብቸ ህንጉብኔፍ እሰ ከዸተንዩ እሳን ህንዸጌኜ። <verse eid="JER 36:25"/><verse number="26" style="v" sid="JER 36:26"/>ቆደ ከና ሞትች አከ እሳን ባሩክ በሬሳ ሰናፊ ኤርምያስ ራጅቸ ህዸኒፍ ዬረምኤል እልመ ሞቲ፣ ሴራያ እልመ አዝሪኤሊቲፊ ሼሌምያ እልመ አብድኤል አጀጄ። <char style="nd">ዋቀዮ</char> ገሩ እሳን ዾክሴ ቱሬ።<verse eid="JER 36:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 36:27"/>ኤርገ ሞትች ክታበ መረማ ከን ባሩክ ዱቢ ኤርምያስራ ዸገኤ እት በሬሴ ሰነ ጉቤ ቦዴ ዱቢን <char style="nd">ዋቀዮ</char> አከነ ጄዼ ገረ ኤርምያስ ዹፌ፦ <verse eid="JER 36:27"/><verse number="28" style="v" sid="JER 36:28"/>“ክታበ መረማ ብራ ፉዺቲ ዱቢ ክታብቸ ዱራ ከን ዬሆያቂም ሞትች ይሁዳ ጉቤረ ቱሬ ሰነ ሁንደ እት በሬስ። <verse eid="JER 36:28"/><verse number="29" style="v" sid="JER 36:29"/>ዬሆያቂም ሞትቸ ይሁዳቲንስ አከነ ጄዽ፤ ‘<char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ አት ክታበ መረማ ሰነ ጉብዴ፣ “አት ማሊፍ አከ ሞቲን ባብሎን ዹጉማን ዹፌ ብየ ከነ በሌሴ ነማፊ ሆሪ ኬሳ ሆባሱ ክታብቸረት በሬስቴ?” ጄቴ ጋፈቴ። <verse eid="JER 36:29"/><verse number="30" style="v" sid="JER 36:30"/>ከናፉ <char style="nd">ዋቀዮ</char> ዋኤ ዬሆያቂም ሞትቸ ይሁዳ አከነ ጄዸ፦ እን ነመ ቴሶ ዳዊትራ ታኡ ህንቀባቱ፤ ሬፍሳስ ገድ ደርበተሜ ሆአ ጉያቲፊ ቆረ ሀልከኒት ንሳጥለመ። <verse eid="JER 36:30"/><verse number="31" style="v" sid="JER 36:31"/>አን ሰበቢ ሀምነሳኒቲፍ እሰ፣ እጆሌሳቲፊ ተጃጅልቶተሳ ነንአደበ፤ ሰበቢ እሳን ነ ዸጌፈቹ ድደኒፍ አን በላ እሳንትን ፍደ ጄዼ ለብሴ ሰነ ሁንደ እሳንት፣ ነሞተ ዬሩሳሌም ኬሰ ጅራተኒፊ ነሞተ ይሁዳት ነንፍደ።’ ”<verse eid="JER 36:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JER 36:32"/>ኤርገሲ ኤርምያስ ክታበ መረማ ከን ብራ ፉዼ ባሩክ እልመ ኔርያ በሬሳ ሰነት ኬኔ፤ ባሩክስ አኩመ ኤርምያስ እት ህሜት ዱቢ ክታበ መረማ ዬሆያቂም ሞትች ይሁዳ እብዳን ጉቤ ሰነረ ቱሬ ሁንደ እት በሬሴ። ዱቢን ዱቢ ከነ ፈካቱ ሄዱንስ እት ደበለሜረ።<verse eid="JER 36:32"/></para>
  <chapter eid="JER 36"/>
  <chapter number="37" style="c" sid="JER 37"/>
  <para style="s1">ኤርምያስ ህዸሙሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 37:1"/>ኔቡከድኔዘር ሞትች ባብሎን ዜዴቅያ እልመ ዮስያስ ሞቲ ይሁዳ ታስሴ፤ እንስ እዶ ዬሆያኪን እልመ ዬሆያቂም ቡኤ ሞቲ ተኤ። <verse eid="JER 37:1"/><verse number="2" style="v" sid="JER 37:2"/>ገሩ እን ዮካን ተጃጅልቶትንሳ ዮካን ሰብን ብየ ሰና ዱቢ <char style="nd">ዋቀዮ</char> ከራ ኤርምያስ ራጅቻቲን ዱበቴ ሰነ ህንቀልቤፈትኔ።<verse eid="JER 37:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 37:3"/>ተኡስ ዜዴቅያ ሞትች፣ “ማሎ <char style="nd">ዋቀዮ</char> ዋቀኬኘ ኑ ከዸዹ” ጄዼ ዬሁከል እልመ ሼሌምያቲፊ ሴፋንያ ሉብቸ እልመ መአሴያ ገረ ኤርምያስ ራጅቻት ኤርጌ።<verse eid="JER 37:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 37:4"/>ኤርምያስ ዋን ዬሮ ሰነት መነ ህዻት ህንገልፈምኒፍ ሶዳ መሌ ሰበ ግዱ ንዴዴብአ ቱሬ። <verse eid="JER 37:4"/><verse number="5" style="v" sid="JER 37:5"/>ሎልቶትን ፈረኦን ግብጢ በአኒ ቱረን፤ ባብሎኖትን ዬሩሳሌምን መርሰኒ ቱረንስ ዮሙ ዋን ከነ ዸገአንት ዬሩሳሌምን ዺሰኒ በአን።<verse eid="JER 37:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 37:6"/>ከነረት ዱቢን <char style="nd">ዋቀዮ</char> አከነ ጄዼ ገረ ኤርምያስ ራጅቻ ዹፌ፦ <verse eid="JER 37:6"/><verse number="7" style="v" sid="JER 37:7"/>“<char style="nd">ዋቀዮ</char>፣ ዋቅን እስራኤል አከነ ጄዸ፦ ሞትቸ ይሁዳ እሰ አከ እስን ዋ ነ ጋፈተኒፍ እስን ኤርጌ ሰናን አከነ ጄዻ፤ ‘ሎልቶትን ፈረኦን ከኔን እስን ገርጋሩፍ ዹፈን ሱን ገረ ብየሳኒ፣ ገረ ግብጥት ንዴብኡ። <verse eid="JER 37:7"/><verse number="8" style="v" sid="JER 37:8"/>ኤርገሲ ባብሎኖትን ዴብአኒ መጋላ ከነ ንዸኡ፤ ንቀበቱ፤ ንጉቡስ።’<verse eid="JER 37:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 37:9"/>“<char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ ‘ባብሎኖትን ዹጉማን ኑ ዺሰኒ ዴሙ’ ጄተኒ ያዱዻን ኦፍ ህንጎዎምስና፤ እሳን ህንዴመኒቲ! <verse eid="JER 37:9"/><verse number="10" style="v" sid="JER 37:10"/>ኡቱ እስን ሎልቶተ ባብሎኖታ ከኔን እስን ሎላ ጅረን ከነ ሁንደ ሞአተኒ ወር መዳአን ቆፍት ዱንካነሳኒ ኬሰት ሀፈኒዩ እሳን ገድ በአኒ መጋላ ከነ ንጉቡ።”<verse eid="JER 37:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 37:11"/>ኤርገ ሎልቶትን ባብሎኖታ ሰበቢ ወራነ ፈረኦኒፍ ጄዸኒ ዬሩሳሌምን ዺሰኒ በአኒ አስ፣ <verse eid="JER 37:11"/><verse number="12" style="v" sid="JER 37:12"/>ኤርምያስ ሰበ አች ጅራቱ ኬሳ ቆደ ቀቤኛ ከን እሰ ገኡ አርገቹፍ ጄዼ ዬሩሳሌሚ ከኤ ብየ ቤንያም ዸቄ። <verse eid="JER 37:12"/><verse number="13" style="v" sid="JER 37:13"/>ገሩ ዬሮ እን ከረ ቤንያም ብረ ገኤት ይርያን እልም ሼሌምያ፣ እልም ሀናንያ እት ጋፈተማን ኤጉምሳ ሱን፣ “አት ገረ ባብሎኖታት ሶካ ጅርተ!” ጄዼ ኤርምያስ ራጅቸ ቀቤ ህዼ።<verse eid="JER 37:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 37:14"/>ኤርምያስሞ፣ “ኩን ዹጋ ምት! አን ገረ ባብሎኖታት ሶኩት ህንጅሩ” ጄዼ። ይርያን ገሩ እሰ ዸገኡ ድዴ፤ ቆደ ከና ኤርምያስን ቀቤ ቆንዳልቶተት ዽኤሴ። <verse eid="JER 37:14"/><verse number="15" style="v" sid="JER 37:15"/>እሳንስ ኤርምያስት ኣረኒ እሰ ቱመን፤ መነ ዮናታን በሬሳ ሰና ከን መነ ህዻ ጎዸተን ሰነ ኬሰት እሰ ህዸን።<verse eid="JER 37:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 37:16"/>ኤርምያስስ ኩታ መነ ቦላ ኬሰ ቡፈሜ፤ አችስ ዬሮ ዼራ ቱሬ። <verse eid="JER 37:16"/><verse number="17" style="v" sid="JER 37:17"/>ኤርገሲ ዜዴቅያ ሞትች ነመ እት ኤርጌ ገረ መሰራ ኦፊሳት እሰ ፍችሲሴ። አችትስ ኮጳት ባሴ፣ “ዱቢን <char style="nd">ዋቀዮ</char> ብራ ዹፌ ቶኮዩ ጅራ?” ጄዼ እሰ ጋፈቴ።</para>
  <para style="p" vid="JER 37:17">ኤርምያስስ፣ “ኤዬ፤ አት ደበርፈምቴ ሞቲ ባብሎኒት ንኬነምተ” ጄዼ ዴብሴ።<verse eid="JER 37:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 37:18"/>ኤርገሲስ ኤርምያስ፣ ዜዴቅያስ ሞትቻን አከነ ጄዼ፤ “አን ስት ዮካን ቆንዳልቶተኬት ዮካን ሰበ ከነት በሌሳ ማሊ ሆጄናን እስን መነ ህዻ ኬሰ ነ ቡፍተን? <verse eid="JER 37:18"/><verse number="19" style="v" sid="JER 37:19"/>ራጆትንኬ ወር፣ ‘ሞቲን ባብሎን ስእ ዮካን ብየ ከነ ህንሎሉ’ ጄዸኒ ራጂ ሲፍ ዱበተን ሱን ኤሰ ጅሩ? <verse eid="JER 37:19"/><verse number="20" style="v" sid="JER 37:20"/>አመ ገሩ ጎፍታኮ ያ ሞትቻ፣ ማሎ ነ ዸገእ። አን እየተኮ ፉለኬ ዱረት ነንዽኤፈዻቲ፣ መነ ዮናታን በሬሳ ሰናት ዴብፍቴ ነ ህንኤርግን፤ ዮ አት ነ ኤርግቴ አን አቹመት ዱኣቲ።”<verse eid="JER 37:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 37:21"/>ከነረት ዜዴቅያ ሞትች አከ ኤርምያስ ኦብዲ ኤጉምሳ ኬሰ ካአሙፊ አከ እሳን ሀመ ቡዴን መጋላ ሰና ዹሙት ጉያ ጉያት ቡዴነ ቶኮ ቶኮ ወረ ቡዴነ ቶልቸንራ ፉዸኒ እሳፍ ኬነን አጀጄ። አከሲን ኤርምያስ ኦብዲ ኤጉምሳ ኬሰ ቱሬ።<verse eid="JER 37:21"/></para>
  <chapter eid="JER 37"/>
  <chapter number="38" style="c" sid="JER 38"/>
  <para style="s1">ኤርምያስ ቦለ ብሻኒት ደርበተሜ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 38:1"/>ሼፋጥያ እልም መታን፣ ጌዳልያስ እልም ጳሽሁር፣ ዩካል እልም ሼሌምያቲፊ ጳሽሁር እልም መልክያ ዋን ኤርምያስ አከነ ጄዼ ሰበ ሁንደት ህሜ ዸገአን፤ <verse eid="JER 38:1"/><verse number="2" style="v" sid="JER 38:2"/>“<char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ ‘ነምን መጋላ ከነ ኬሰት ሀፉ ከምዩ ጎራዴን፣ ቤላን ዮካን ዸእቻን ንዱአ፤ ነምን ገረ ባብሎኖታት በቀቱ ከምዩ ገሩ ንጅራተ። እን ሉቡሳቲን ንበአ፤ ንጅራተስ።’ <verse eid="JER 38:2"/><verse number="3" style="v" sid="JER 38:3"/><char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ ‘መጋላን ኩን ዹጉማን ደበርፈምቴ ሀርከ ወራነ ሞቲ ባብሎንት ንኬነምት፤ እንስሼ ቀበተ።’ ”<verse eid="JER 38:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 38:4"/>ከነረት ቆንዳልቶትን ሱን ሞትቻን አከነ ጄዸን፤ “ነምች ኩን አጄፈሙ ቀበ። እን ዋን እሳንት ዱበቱን ሎልቶተ መጋላ ከነ ኬሰት ሀፈኒፊ ነሞተ ሁንደ ኦኔ ዸብሲሰ። ነምች ኩን ሰበ ከናፍ በዲሰ መሌ ዋን ጋሪ ህንሀዉ።”<verse eid="JER 38:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 38:5"/>ዜዴቅያ ሞትችሞ፣ “እን ሀርኩመኬሰን ኬሰ ጅረ፤ ሞቲን እስኒን ሞርሜ ሆማ ጎቹ ህንደንደኡ” ጄዼ ዴብሴ።<verse eid="JER 38:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 38:6"/>ከናፉ እሳን ኤርምያስን ፉዸኒ ቦለ ብሻኒ ከን መልክያ እልመ ሞትቻ ኬሰ ቡሰን፤ ቦል ብሻኒ ሱንስ ኦብዲ ኤጉምሳ ኬሰ ቱሬ። እሳን ፉኞዻን ኤርምያስን ቦለ ሰነ ኬሰ ቡሰን፤ ቦል ሱን ዾቄ መሌ ብሻን ህንቀቡ ቱሬ፤ ኤርምያስስ ዾቄ ኬሰ ዽዽሜ።<verse eid="JER 38:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 38:7"/>ገሩ ኤቤድ-ሜሌክ ቆንዳል እቶጵያ ከን መሰራ ሞቲ ኬሰ ቱሬ ሱን አከ እሳን ኤርምያስን ቦለ ብሻኒ ኬሰ ቡሰን ዸገኤ። ኡቱመ ሞትች ከረ ቤንያም ብረ ታኤ ጅሩስ፣ <verse eid="JER 38:7"/><verse number="8" style="v" sid="JER 38:8"/>ኤቤድ-ሜሌክ መሰራዻ በኤ ዸቄ አከነ እሳን ጄዼ፤ <verse eid="JER 38:8"/><verse number="9" style="v" sid="JER 38:9"/>“ያ ጎፍታኮ ሞትቸ፣ ጀር ኩን ዋን ኤርምያስ ራጅቸ ጎዸን ሁንዳን ዋን ሀማ ሆጄተኒሩ። እሳን አከ እን ቤላን ዱኡፍ ዬሮ ቡዴን ቶኮዩ መጋላ ኬሰ ህንጅሬት ቦለ ብሻኒ ኬሰ እሰ ቡሰን።”<verse eid="JER 38:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 38:10"/>ሞትችስ ኤርገሲ ኤቤድ-ሜሌክ ነምቸ እቶጵያ ሰናን፣ “ነመ ሶዶመ አሲ ፉዸዹ ዸቂቲ ኡቱ እን ህንዱእን ኤርምያስ ራጅቸ ቦለ ብሻኒ ኬሳ ባስ” ጄዼ አጀጄ።<verse eid="JER 38:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 38:11"/>ከናፉ ኤቤድ-ሜሌክ ነሞተ ሰነ ፉዸቴ ገረ ኩታ መንኩሳ መሰራ ሞትቻ ኬሳቲን ጀለ ጅሩ ሰና ዸቄ። እንስ ደርሳፊ ወያ ሞፋ አቺ ፉዸቴ ፉኞን ገረ ቦለ ብሻኒት ኤርምያሲፍ ገድ ቡሴ። <verse eid="JER 38:11"/><verse number="12" style="v" sid="JER 38:12"/>ኤቤድ-ሜሌክ ነምች እቶጵያ ሱንስ ኤርምያሲን፣ “አከ ፉኞን ስ ህንሉቅስኔፍ ደርሳፊ ወያ ሞፋ ቦባኬ ጀለ ካአዹ” ጄዼ። ኤርምያስስ አከሱመ ጎዼ፤ <verse eid="JER 38:12"/><verse number="13" style="v" sid="JER 38:13"/>እሳንስ ፉኞ ሰናን ኦል ሀርክሰኒ ቦለ ብሻኒ ኬሳ እሰ ባሰን። ኤርምያስስ ኦብዲ ኤጉምሳ ኬሰ ቱሬ።<verse eid="JER 38:13"/></para>
  <para style="s1">ዜዴቅያን አመስ ኤርምያስን ጋፊ ጋፈቴ</para>
  <para style="p">
    <verse number="14" style="v" sid="JER 38:14"/>ዜዴቅያን ሞትች ኤርምያስት ነመ ኤርጌ ገረ በልበለ ሰደፋ መነ ቁልቁሉማ <char style="nd">ዋቀዮት</char> እሰ ፍችሲሴ። ሞትችስ ኤርምያሲን፣ “አን ዋ ስን ጋፈዸ፤ አት ዋን ቶኮሌ ነ ህንዾክስን” ጄዼ።<verse eid="JER 38:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 38:15"/>ኤርምያስስ ዜዴቅያዻን፣ “ዮ አን ዴቢ ሲፍ ኬኔ፣ አት ነ ህንአጄፍቱ? ዮ አን ስ ጎርሴዩ አት ነ ህንዸጌሱ” ጄዼ።<verse eid="JER 38:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 38:16"/>ዜዴቅያን ሞትች ገሩ፣ “ዹጋ <char style="nd">ዋቀዮ</char> ጅራታ እሰ ጅሬኘ ኑ ኬኔ ሰና አን ስ ህንአጄሱ፤ ወረ ሉቡኬ በሌሱ በርባደንትስ ደበርሴ ስ ህንኬኑ” ጄዼ ከኩ ከነ ዾክሳት ኤርምያሲፍ ከከቴ።<verse eid="JER 38:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 38:17"/>ከነረት ኤርምያስ ዴብሴ ዜዴቅያዻን አከነ ጄዼ፤ “<char style="nd">ዋቀዮ</char> ዋቅን፣ እን ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል አከነ ጄዸ፦ ‘ዮ አት ቆንዳልቶተ ሞቲ ባብሎንት ሀርከ ኬነቴ ሉቡንኬ ዱአ ንኦልፈምት፤ መጋላን ኩንስ ህንጉበምቱ፤ አቲፊ ማቲንኬ ንጅራቱ። <verse eid="JER 38:17"/><verse number="18" style="v" sid="JER 38:18"/>ገሩ ዮ አት ቆንዳልቶተ ሞቲ ባብሎንት ሀርከ ኬነቹ ባቴ መጋላን ኩን ደበርፈምቴ ባብሎኖተት ንኬነምት፤ እሳንስ እሼ ጉቡ፤ አት መታንኬዩ እሳን ጀላ ህንባቱ።’ ”<verse eid="JER 38:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 38:19"/>ዜዴቅያን ሞትች ኤርምያሲን፣ “አን ይሁዶተ ባብሎኖተት ገለን ነንሶዳዸ፤ ባብሎኖትን ደበርሰኒ እሳንት ነ ኬነኒ እሳንሞ ነት ተጰቱቲ” ጄዼ።<verse eid="JER 38:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 38:20"/>ኤርምያስስ አከነ ጄዼ ዴብሴ፤ “እሳን ደበርሰኒ ስ ህንኬነን፤ አት ዋን አን ስት ህሙ ጎቹዻን <char style="nd">ዋቀዮፍ</char> አጀጀም። ዮስ አት ምልኮፍቴ ሉቡንኬስ ዱአ ኦልፈምት። <verse eid="JER 38:20"/><verse number="21" style="v" sid="JER 38:21"/>ገሩ ዮ አት ሀርከ ኬነቹ ድዴ፣ <char style="nd">ዋቀዮ</char> ዋን ከነ ናእብሴረ፦ <verse eid="JER 38:21"/><verse number="22" style="v" sid="JER 38:22"/>ዱበርቶትን መነ ሞቲ ይሁዳ ኬሰት ሀፈን ሁንድ ገረ ቆንዳልቶተ ሞቲ ባብሎንት ጌፈሙ። ዱበርቶትን ሱንስ አከነ ጄዹ፦</para>
  <para style="q1" vid="JER 38:22">“ ‘ምቾንኬ ከኔን አት አመነቴ ሱን፣</para>
  <para style="q2" vid="JER 38:22">ስ ጎዎምሰኒ፤ ስ ሞአተን።</para>
  <para style="q1" vid="JER 38:22">ሚልኬ ዾቄ ኬሰ ልጤ፤</para>
  <para style="q2" vid="JER 38:22">ምቾትንኬስ ስ ዺሰኒ ዴመን።’<verse eid="JER 38:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JER 38:23"/>“ኒቶትንኬቲፊ እጆሌንኬ ሁንድ ባብሎኖተት ጌፈሙ። አት መታንኬዩ ሞቲ ባብሎኒን ቀበምተ መሌ እሳን ሀርካ ህንባቱ፤ መጋላን ኩንስ ንጉበምት።”<verse eid="JER 38:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 38:24"/>ዜዴቅያን ኤርምያሲን አከነ ጄዼ፤ “ዱቢ ኑ አመ ዱበትኔ ከነ ነምን ቶኮዩ ህንቤክን፤ ዮ ከና አቺ አት ንዱታ። <verse eid="JER 38:24"/><verse number="25" style="v" sid="JER 38:25"/>ዮ ቆንዳልቶትን አከ አን ስ ወጅን ሃሰኤ ዸገአኒ ስ ብረ ዹፈኒ፣ ‘ዋን አት ሞቲዻን ጄቴፊ ዋን ሞቲን ሲን ጄዼ ኑት ህም፤ ኑ ህንዾክስን፤ ዮ ከና አቺ ኑ ስ አጄፍና’ ሲን ጄዸን፣ <verse eid="JER 38:25"/><verse number="26" style="v" sid="JER 38:26"/>‘አን አከ እን ገረ መነ ዮናታንት ዴብሴ ነ ኤርጌ አንስ አችት ህንዱኔፍ ሞትቸ ከዸቻ ቱሬ’ ጄዺን።”<verse eid="JER 38:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 38:27"/>ኤርገሲ ቆንዳልቶትን ሁንድ ዹፈኒ ኤርምያስን ጋፈተን፤ እንስ ዋን ሞትች አከ እን ዱበቱ እሰ አጀጄ ሁንደ እሳንት ህሜ። ሰበቢ ነምን ዋን እን ሞትቸ ወጅን ዱበቴ ዸገኤ ቶኮዩ ህንቱርኒፍ፣ ጀር ዋን ከነ ጫላ ሆማ እሰት ህንዱበትኔ።<verse eid="JER 38:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JER 38:28"/>ኤርምያስስ ሀመ ጋፈ ዬሩሳሌም ቀበምቴት ኦብዲ ኤጉምሳ ሰነ ኬሰ ቱሬ።<verse eid="JER 38:28"/></para>
  <chapter eid="JER 38"/>
  <chapter number="39" style="c" sid="JER 39"/>
  <para style="s1">ኩፋቲ ዬሩሳሌም</para>
  <para style="r">
    <ref loc="JER 39:1-10">39፥1‑10</ref> ኩወፈ – <char style="xt"><ref loc="2KI 25:1-12">2ሞቶ 25፥1‑12</ref>፤ <ref loc="JER 52:4-16">ኤር 52፥4‑16</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="JER 39:1"/>አክ ዬሩሳሌም እት ፉዸተምቴ ከነ ቱሬ፦ በረ ዜዴቅያ ሞትቸ ይሁዳ ኬሰ ጅአ ኩርነፋ ወጋ ሰግለፋት፣ ኔቡከድኔዘር ሞትች ባብሎን ሎልቶተሳ ሁንደ ወጅን ዱሌ ዬሩሳሌምን መርሴ። <verse eid="JER 39:1"/><verse number="2" style="v" sid="JER 39:2"/>በረ ዜዴቅያ ኬሰ ቡልቲ ሰግለፋ ጅአ አፉረፋ ወጋ ኩዸ ቶኮፋት፣ ደላን መጋላ ሰና ንጨብሰሜ። <verse eid="JER 39:2"/><verse number="3" style="v" sid="JER 39:3"/>ኤርገሲ ቆንዳልቶትን ሞቲ ባብሎን ሁንድ ዹፈኒ ከረ ግዱ ገሌሰ ዱረ ተታአን፤ እሳንስ ኔርጋል-ሸሬዜር ነምቸ ሰምጋር፣ ኔቦ-ሰርሴኪም አጀጃ ሀንገፈ፣ ኔርጋል-ሸሬዜር ሹሚ ሀንገፋፊ ቆንዳልቶተ ሞቲ ባብሎን ሁንዳዸ። <verse eid="JER 39:3"/><verse number="4" style="v" sid="JER 39:4"/>ዜዴቅያን ሞትቸ ይሁዳቲፊ ሎልቶትን ሁንድ ዮሙ ጀረ አርገንት ንበቀተን፤ እሳንስ ሀልከኒን ከራ ብቅልቱ ሞትቻቲን መጋላ ኬሳ በአኒ ከረ ደላ ለማን ግዱቲን ገረ አረባት ቀጄለን።<verse eid="JER 39:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 39:5"/>ሎልቶትን ባብሎኖታ ገሩ እሳን አርአኒ ድሬ ዬርኮረት ዜዴቅያ እን ቀቀበን። እሳንስ እሰ ቀበኒ ሪብላ ሀማት ኬሰት ገረ ኔቡከድኔዘር ሞትቸ ባብሎንት ጌሰን፤ ሞትችስ አችት እሰት ሙሬ። <verse eid="JER 39:5"/><verse number="6" style="v" sid="JER 39:6"/>ሞቲን ባብሎንስ አቹመ ሪብላት እጁመሳ ዱረት እልማን ዜዴቅያ ጎረኤ ነሞተ ይሁዳ ቤቤከሞ ሁንደስ አጄሴ። <verse eid="JER 39:6"/><verse number="7" style="v" sid="JER 39:7"/>እንስ ኤርገሲ ዜዴቅያ ኬሳ እጀሳ ባሴ ባብሎንት እሰ ጌሱፍ ፎንጫ ናሲቲን እሰ ህዼ።<verse eid="JER 39:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 39:8"/>ባብሎኖትንስ መሰራ ሞቲቲፊ መኔን ሰባት እብደ ቀብሲሰኒ ደላ ዬሩሳሌም ዲገን። <verse eid="JER 39:8"/><verse number="9" style="v" sid="JER 39:9"/>ኔቡዘረዳን አጀጃን ኤጉምሳ፣ ነሞተ መጋላ ኬሰት ሀፈን፣ ነሞተ እሰት ሀርከ ኬነተኒፊ ነሞተ ካን ወጅን ቦጅኤ ባብሎንት ጌሴ። <verse eid="JER 39:9"/><verse number="10" style="v" sid="JER 39:10"/>ኔቡዘረዳን አጀጃን ኤጉምሳ ሱን ገሩ ህዬዪ ሆማ ህንቀብኔ ቶኮ ቶኮ ብየ ይሁዳት ሀምብሴ፤ እንስ ዬሮ ሰነት እዶ ዻባ ወይኒቲፊ ለፈ ቆቲሳ ኬኔፍ።<verse eid="JER 39:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 39:11"/>ኔቡከድኔዘር ሞትች ባብሎን አከነ ጄዼ ከራ ኔቡዘረዳን አጀጃ ኤጉምሳ ሰናቲን ዋኤ ኤርምያስ አጀጀ ኬኔ፦ <verse eid="JER 39:11"/><verse number="12" style="v" sid="JER 39:12"/>“እሰ ፉዺቲ አከ ጋሪ ኩኑንስ፤ ዋን እን በርባዱ ከምዩ ጎዺፍ መሌ እሰ ህንሚዽን።” <verse eid="JER 39:12"/><verse number="13" style="v" sid="JER 39:13"/>ከናፉ ኔቡዘረዳን አጀጃን ኤጉምሳ ሱን ኔቡሸዝባን ሹሚን ሀንገፍት፣ ኔርጋል-ሸሬዜር ሹሚን ኦል ኣናን፣ አከሱመስ ቆንዳልቶትን ሞቲ ባብሎን ካን ሁንድ <verse eid="JER 39:13"/><verse number="14" style="v" sid="JER 39:14"/>ኤርገመኒ ኦብዲ ኤጉምሳ ኬሳ ኤርምያስን ባስሰን። እሳንስ አከ ጌዳልያስ እልም ሻፋን፣ እልም አሂቃም መነሳት እሰ ጌሱፍ እማና እት ኬነን። ኤርምያስስ አከሲን ሰበ ኦፊሳ ኬሰ ጅራቴ።<verse eid="JER 39:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 39:15"/>ኡቱመ ኤርምያስ ኦብዲ ኤጉምሳ ኬሰት ህዸሜ ጅሩ ዱቢን <char style="nd">ዋቀዮ</char> አከነ ጄዼ ገረሳ ዹፌ፦ <verse eid="JER 39:15"/><verse number="16" style="v" sid="JER 39:16"/>“ዸቂቲ ኤቤድ-ሜሌክ ነምቸ እቶጵያ ሰናን አከነ ጄዽ፤ ‘<char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል አከነ ጄዸ፦ አን ዱቢኮ ዋን ቶላዻፍ ኡቱ ህንተእን ዋን ሀማዻፍ መጋላ ከነረት ፊጣን ነንባሰ። ዬሮ ሰነት ወን ኩን እጁመኬ ዱረት ፊጣን በአ። <verse eid="JER 39:16"/><verse number="17" style="v" sid="JER 39:17"/>አን ገሩ ጋፈስ ስን ኦልቸ፣ ጄዸ <char style="nd">ዋቀዮ</char>፤ አት ደበርፈምቴ ወረ ሶዳቱ ሰነት ህንኬነምቱ። <verse eid="JER 39:17"/><verse number="18" style="v" sid="JER 39:18"/>አን ስን ባሰ፤ አት ዋን ነ አመነቱፍ ሉቡኬቲን ባተ መሌ ጎራዴዻን ህንዱቱ፣ ጄዸ <char style="nd">ዋቀዮ</char>።’ ”<verse eid="JER 39:18"/></para>
  <chapter eid="JER 39"/>
  <chapter number="40" style="c" sid="JER 40"/>
  <para style="s1">ኤርምያስ ገድ ዺፈሜ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 40:1"/>ኤርገ ኔቡዘረዳን አጀጃን ኤጉምሳ ሱን ራማት ገድ እሰ ዺሴ ቦዴ ዱቢን ኩን <char style="nd">ዋቀዮ</char> ብራ ገረ ኤርምያስ ዹፌ። አጀጃን ሱን እሳ ቦጅአምቶተ ዬሩሳሌሚፊ ይሁዳዻ ቦጅአመኒ ገረ ባብሎንት ጌፈማ ቱረን ሁንደ ግዱት ፎንጫን ህዸሜ ጅሩ ኤርምያስን አርጌ። <verse eid="JER 40:1"/><verse number="2" style="v" sid="JER 40:2"/>አጀጃን ኤጉምሳ ሱንስ ዮሙ ኤርምያስን አርጌት አከነ ጄዼን፤ “<char style="nd">ዋቀዮ</char> ዋቅንኬ በዲሰ ከነ እዶ ከነት ለብሴረ። <verse eid="JER 40:2"/><verse number="3" style="v" sid="JER 40:3"/><char style="nd">ዋቀዮ</char> አመዩ ዋን ከነ ፍዴረ፤ እን አኩመ ዱበቴ ሰነ ጎዼረ። ሰበቢ እስን <char style="nd">ዋቀዮት</char> ጩቡ ሆጄተኒፊ እሳፍ ህንአጀጀምኒፍ ወን ኩን ሁንድ ተኤ። <verse eid="JER 40:3"/><verse number="4" style="v" sid="JER 40:4"/>አን ገሩ ሀርአ ፎንጫ ሀርከኬቲ ስራ ሂኬረ። አት ዮ ነ ወጅን ባብሎን ዸቁ ፌቴ ኮቱ፤ አንስ ስን ኩኑንሳ፤ ዮ ፌዹ ባቴ ገሩ ህንዹፍን። ኩኖ ብየቲን ጉቱማን ጉቱት ፉለኬ ዱረ ጅርት፤ እዶ ጃለቴ ዸቅ።” <verse eid="JER 40:4"/><verse number="5" style="v" sid="JER 40:5"/>ተኡስ ኡቱ ኤርምያስ ኦፍረ ህንዴብእን ኔቡዘረዳን እት ደበሌ፣ “ገረ ጌዳልያስ እልመ ሻፋን እልመ አሂቃም እሰ ሞትች ባብሎን መጋላወን ይሁዳረት ሙዴ ሰና ዴብኢቲ እሰ ወጅን ሰበ ኬሰ ጅራዹ፣ ዮካን እዶ ጃለቴ ከምዩ ዸቅ” ጄዼን።</para>
  <para style="p" vid="JER 40:5">አከሲን አጀጃን ኤጉምሳ ሱን ገላፊ ኬና ኬኔፊ ገድ እሰ ዺሴ። <verse eid="JER 40:5"/><verse number="6" style="v" sid="JER 40:6"/>ከናፉ ኤርምያስ ገረ ጌዳልያስ እልመ አሂቃም ከን ሚስጳ ጅራቱ ሰና ዸቄ እሰ ወጅን ሰበ ብየ ሰነት ሀፌ ግዱ ጅራቴ።<verse eid="JER 40:6"/></para>
  <para style="s1">አጄፈሙ ጌዳልያስ</para>
  <para style="r">
    <ref loc="JER 40:7-9">40፥7‑9</ref>፤ <ref loc="JER 41:1-3">41፥1‑3</ref> ኩወፈ – <char style="xt"><ref loc="2KI 25:22-26">2ሞቶ 25፥22‑26</ref></char></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 40:7"/>አጀጆትን ሎልቶታ ሁንዲፊ ነሞትንሳኒ ከኔን ሀመ ዬሮ ሰናት አለ ቱረን ዬሮ አከ ሞትች ባብሎን ጌዳልያስ እልመ አሂቃም ሰነ ቡልቻ ኩታ ብያ ጎዼ ሙዴፊ አከ እን ዺራ ዱበርቲፊ እጆሌ ህዬዪ ከኔን ቦጅአመኒ ገረ ባብሎንት ህንጌፈምንረት እት ጋፈተመ ኬኔፍ ዸገአንት፣ <verse eid="JER 40:7"/><verse number="8" style="v" sid="JER 40:8"/>ጌዳልያስ ብረ ገረ ሚስጳ ዹፈን። እሳንስ እሽማኤል እልመ ናታንያ፣ ዮሃናኒፊ ዮናታን እልማን ቃሬያ፣ ሴራያ እልመ ተንሁሜት፣ እልማን ኤፈይ ነምቸ ኔቶፍ ሰናቲፊ ዬዛንያ እልመ ነምቸ መአካት፣ አከሱመስ ነሞተሳኒ ቱረን። <verse eid="JER 40:8"/><verse number="9" style="v" sid="JER 40:9"/>ጌዳልያስ እልም ሻፋን፣ እልም አሂቃም አከነ ጄዼ እሳኒፊ ነሞተሳኒቲፍ ከከቴ፤ “ባብሎኖተ ተጃጅሉ ህንሶዳትና፤ ብየቲ ኬሰ ቁበዻቲ ሞትቸ ባብሎን ተጃጅላ፤ ዋን ጋሪቱ እስኒ ተኣቲ። <verse eid="JER 40:9"/><verse number="10" style="v" sid="JER 40:10"/>አን መታንኮ ፉለ ባብሎኖተ ገረኬኘ ዹፈኒ ዱረት እዶኬሰን ቡኡፍ ሚስጳ ኬሰ ነንቱረ፤ እስን ገሩ ወይኒ፣ እጀ ቦናቲፊ ዘይቲ ወልት ቀባቲ ጎምብሳት ነቀዻ፤ መጋላወን ቀበተን ኬሰስ ጅራዻ።”<verse eid="JER 40:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 40:11"/>ይሁዶትን ሞኣብ፣ አሞን፣ ኤዶሚፊ ብዮተ ብራ ሁንደ ኬሰ ጅራተን ሁንድ ዮሙ አከ ሞቲን ባብሎን ይሁዳ ኬሰት ሀምባ ሀምብሴፊ አከ እን ጌዳልያስ እልመ ሻፋን እልመ አሂቃም ቡልቻ ጎዼ እሳንረት ሙዴ ዸገአንት፣ <verse eid="JER 40:11"/><verse number="12" style="v" sid="JER 40:12"/>ሁንድሳኒ ብዮተ እት ብትናአን ሁንደ ኬሳ በአኒ ይሁዳት ዴብአኒ ሚስጳት ጌዳልያስ ብረ ዹፈን። እሳንስ ወይኒፊ እጀ ቦና ባይኤ ወልት ቀበተን።<verse eid="JER 40:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 40:13"/>ዬሮ ከነት ዮሃናን እልም ቃሬያቲፊ አጀጆትን ሎልቶተ አለ ቱረኒ ሁንድ ጌዳልያስ ብረ ሚስጳ ዸቀኒ፣ <verse eid="JER 40:13"/><verse number="14" style="v" sid="JER 40:14"/>አከነ ጄዸኒን፤ “አት አከ ሞቲን አሞኖታ በኣሊስ ጄዸሙ ሱን ስ አጄሱፍ ጄዼ፣ እሽማኤል እልመ ናታንያ ኤርጌ ህንቤክቱ?” ጌዳልያስ እልም አሂቃም ገሩ እሳን ህንአመኔ።<verse eid="JER 40:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 40:15"/>ከነረት ዮሃናን እልም ቃሬያ ሚስጳ ኬሰት ጌዳልያስን ኮጳት ባሴ አከነ ጄዼን፤ “አከ አን ዸቄ እሽማኤል እልመ ናታንያ ሰነ አጄሱ ና ኤየም፤ ነምን ቶኮዩ ዋን ከነ ህንቤኩ። እን ማሊፍ ስ አጄሴ አከ ይሁዶትን ናኖኬት ወልት ቀበመን ሁንድ ብትኔፈመኒ ሀምባን ይሁዳስ በርበዳኡ ጎዸ?”<verse eid="JER 40:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 40:16"/>ጌዳልያስ እልም አሂቃም ገሩ፣ ዮሃናን እልመ ቃሬያቲን፣ “አት ዋን አከሲ ህንሆጄትን! ወን አት ዋኤ እሽማኤል ዱበቱ ኩን ዹጋ ምቲ” ጄዼ።<verse eid="JER 40:16"/></para>
  <chapter eid="JER 40"/>
  <chapter number="41" style="c" sid="JER 41"/>
  <para style="p">
    <verse number="1" style="v" sid="JER 41:1"/>ጅአ ቶርበፋ ኬሰ እሽማኤል እልም ናታንያ፣ እልመ ኤሊሻማ ከን ሰኚ ሞቶታራ ዸለቴፊ አጀጆተ ሎልቶተ ሞትቻ ኬሳ ቶኮ ቱሬ ሱን ነሞተ ኩዸን ወጅን ጌዳልያስ እልመ አሂቃም ብረ ሚስጳ ዹፌ። አችትስ ኡቱመ ወጅን ዋ ኛተኑ <verse eid="JER 41:1"/><verse number="2" style="v" sid="JER 41:2"/>እሽማኤል እልም ናታንያቲፊ ነሞትን ኩርነን እሰ ወጅን ቱረን ሱን ከአኒ ጎራዴዻን ጌዳልያስ እልመ አሂቃም፣ እልመ ሻፋን እሰ ሞቲን ባብሎን ቡልቻ ኩታ ብያ ጎዼ ሙዴ ሰነ ሩኩተኒ አጄሰን። <verse eid="JER 41:2"/><verse number="3" style="v" sid="JER 41:3"/>እሽማኤል አከሱመስ ይሁዶተ ጌዳልያስ ወጅን ሚስጳ ቱረን ሁንዳፊ ሎልቶተ ባብሎኖታ ከኔን አች ቱረንሌ ንፍጤ።<verse eid="JER 41:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 41:4"/>ጌዳልያስ አጄፈሜ ጉያ እት ኣኑት ኡቱ ነምን ቶኮዩ ህንቤክን፣ <verse eid="JER 41:4"/><verse number="5" style="v" sid="JER 41:5"/>ነሞትን አሬደሳኒ ሃደተኒ፣ ወያሳኒ ተተርሳሰኒ፣ ኦፍ ጭጭረን ሰዴተምን ኬና ምዻኒቲፊ እጣነ ቀበተኒ ሼኬሚ፣ ሺሎፊ ሰማርያዻ ገረ መነ <char style="nd">ዋቀዮ</char> ዹፈን። <verse eid="JER 41:5"/><verse number="6" style="v" sid="JER 41:6"/>እሽማኤል እልም ናታንያስ ጀረ ስመቹፍ ሚስጳዻ ቦኣ ገድ በኤ። ዮሙ እሳን አርጌትስ “ገረ ጌዳልያስ እልመ አሂቃም ኮታ” ጄዼን። <verse eid="JER 41:6"/><verse number="7" style="v" sid="JER 41:7"/>ዬሮ እሳን መጋላ ሰነ ሴነንትሞ እሽማኤል እልም ናታንያቲፊ ነሞትን እሰ ወጅን ቱረን ጀረ ሰነ ጎጎረአኒ ቦለ ብሻኒት ገድ ደርበተን። <verse eid="JER 41:7"/><verse number="8" style="v" sid="JER 41:8"/>ነሞትን ኡቱ ህንአጄፈምን ሀፈን ኩዸን ገሩ እሽማኤሊን፣ “ኑ ህንአጄስን! ኑ ቀመዲፊ ገርቡ፣ ዘይቲፊ ደመ ለፈ ቆቲሳ ኬሰ ዾክፈትኔ ቀብናቲ” ጄዸን። ከናፉ እን ገድ እሳን ዺሴ፤ ወረ ካን ወጅንስ እሳን ህንአጄፍኔ። <verse eid="JER 41:8"/><verse number="9" style="v" sid="JER 41:9"/>ቦል ብሻኒ እሽማኤል ሬፈ ነሞተ ጌዳልያስ ወጅን አጄፈመን ሰና ሁንደ እት ነቄ ሱን ቦለ ብሻኒ ኣሳን ሞትች እቲን በእሻን ሞትቸ እስራኤል ኦፍራ ዾዉፍ ሆጄተቴ ቱሬ። እሽማኤል እልም ናታንያ ቦለ ብሻኒ ሰነ ሬፈ ነማቲን ጉቴ።<verse eid="JER 41:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 41:10"/>እሽማኤል ነሞተ ሚስጳ ኬሳ ሀፈን ሁንደ እንተለን ሞትቻቲፊ ወረ አችት ሀፈን ከኔን ኔቡዘረዳን አጀጃን ኤጉምሳ ሱን ጌዳልያስ እልመ አሂቃም እሳንረት ሹሜ ቱሬ ሁንደ ቦጅኤ። እሽማኤል እልም ናታንያስ እሳን ፉዸቴ ገረ አሞኖታት ጬኡፍ ከኤ ቀጄሌ።<verse eid="JER 41:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 41:11"/>ዮሃናን እልም ቃሬያቲፊ አጀጆትን ወራና ከኔን እሰ ወጅን ቱረን ሁንድ ዬሮ ዋኤ የከ እሽማኤል እልም ናታንያ ሆጄቴ ሁንዳ ዸገአንት <verse eid="JER 41:11"/><verse number="12" style="v" sid="JER 41:12"/>ነሞተሳኒ ሁንደ ፉዸተኒ እሽማኤል እልመ ናታንያ ሎሉ ዸቀን። እሳንስ ሀሮ ግቤኦን ጉድቸ ብረት እሰ ቀቀበን። <verse eid="JER 41:12"/><verse number="13" style="v" sid="JER 41:13"/>ነሞትን እሽማኤል ወጅን ቱረን ሁንድ ዮሙ ዮሃናን እልመ ቃሬያቲፊ አጀጆተ ሎልቶታ ከኔን እሰ ወጅን ቱረን አርገንት ንገመደን። <verse eid="JER 41:13"/><verse number="14" style="v" sid="JER 41:14"/>ነሞትን እሽማኤል ሚስጳዻ ቦጅኤ ቱሬ ሁንድስ እሰ ብራ ዴብአኒ ገረ ዮሃናን እልመ ቃሬያ ዸቀን። <verse eid="JER 41:14"/><verse number="15" style="v" sid="JER 41:15"/>ገሩ እሽማኤል እልም ናታንያቲፊ ነሞተሳ ኬሳ ሰዴት ዮሃናን ጀላ ምልቀኒ ገረ አሞኖታት በቀተን።<verse eid="JER 41:15"/></para>
  <para style="s1">ገረ ግብጥት በቀቹ</para>
  <para style="p">
    <verse number="16" style="v" sid="JER 41:16"/>ዮሃናን እልም ቃሬያቲፊ አጀጆትን ሎልቶተ ወር እሰ ወጅን ቱረን ሁንድ ነሞተ ሚስጳ ወረ እሽማኤል እልም ናታንያ ኤርገ ጌዳልያስ እልመ አሂቃም አጄሴ ቦዴ ቦጅኤ ካን ሁንደ ፉዸኒ ዴመን፤ እሳንስ ሎልቶተ፣ ዱበርቶተ፣ እጆሌፊ ቆንዳልቶተ መነ ሙርቲ ከኔን ዮሃናን ግቤኦኒ ዴብሴ ፍዴዸ። <verse eid="JER 41:16"/><verse number="17" style="v" sid="JER 41:17"/>እሳንስ አቺ ከአኒ ገረ ግብጥት ቀጄሉዻን ቤትልሄም ብረት ጌሮት ክምሃም ኬሰ ቦቆተን፤ <verse eid="JER 41:17"/><verse number="18" style="v" sid="JER 41:18"/>ኩንስ ባብሎኖተ ጀላ ምልቁፍ ቱሬ። እሳን ሰበቢ እሽማኤል እልም ናታንያ ሱን ጌዳልያስ እልመ አሂቃም እሰ ሞቲን ባብሎን ብየቲረት ቡልቻ ጎዼ ሹሜ ሰነ አጄሴፍ ጀረ ሶዳተን።<verse eid="JER 41:18"/></para>
  <chapter eid="JER 41"/>
  <chapter number="42" style="c" sid="JER 42"/>
  <para style="p">
    <verse number="1" style="v" sid="JER 42:1"/>ኤርገሲ አጀጆትን ወራና ሁንድ ዮሃናን እልመ ቃሬያቲፊ ዬዛንያ እልመ ሆሸእያ ደበለቴ፣ ነምን ሁንድ፣ ጥና ጉዳን ዹፈኒ <verse eid="JER 42:1"/><verse number="2" style="v" sid="JER 42:2"/>ኤርምያስ ራጅቻን አከነ ጄዸን፤ “ማሎ ከዻኬኘ ዸገኢቲ ሀምባ ከነ ሁንዳፍ <char style="nd">ዋቀዮ</char> ዋቀኬ ከዸዹ። ኑ ዱር ባይኤ ቱሬ፤ አመ ገሩ አኩመ አት አርግቱ ከነ ኑ ነመ ሙራሰ ቆፈቱ ሀፌ። <verse eid="JER 42:2"/><verse number="3" style="v" sid="JER 42:3"/>አከ <char style="nd">ዋቀዮ</char> ዋቅንኬ ገረ ኑ ዸቁ ቀብኑፊ ዋን ኑ ጎቹ ቀብኑ ኑት ህሙፍ ኑ ከዸዹ።”<verse eid="JER 42:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 42:4"/>ኤርምያስ ራጅችስ፣ “አን እስን ዸገኤረ፤ አኩመ እስን ነ ጋፈተን ሰነ አን ዹጉማን <char style="nd">ዋቀዮ</char> ዋቀኬሰን ነንከዸዸ። ዋን <char style="nd">ዋቀዮ</char> ዱበቱ ሁንደስ እስንት ነንህመ፤ ዋን ቶኮሌስ እስን ህንዾክሱ” ጄዼ ዴብሴ።<verse eid="JER 42:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 42:5"/>ጀርስ ኤርምያሲን አከነ ጄዸን፤ “ዮ ኑ አኩመ <char style="nd">ዋቀዮ</char> ዋቅንኬ አከ አት ኑት ህምቱፍ ስ ኤርጌ ሰነ ጎቹ ባትኔ <char style="nd">ዋቀዮ</char> መታንሳ ዹገ ባቱ ዹጋቲፊ አመነማ ኑት ሃተኡ። <verse eid="JER 42:5"/><verse number="6" style="v" sid="JER 42:6"/>አከ ዬሮ ኑ ዱቢ <char style="nd">ዋቀዮ</char> ዋቀኬኛቲፍ አጀጀምኑት ወን ሁንድ ኑት ቶሉፍ ዮ ወን ሱን ጃለተማ ዮካን ጅበማ ተኤሌ ኑ ዱቢ <char style="nd">ዋቀዮ</char> ዋቀኬኛ ከን እት ስ ኤርገትኔ ሰናቲፍ ንአጀጀምነ።”<verse eid="JER 42:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 42:7"/>ዱቢን <char style="nd">ዋቀዮስ</char> ጉያ ኩዸን ቦዴ ገረ ኤርምያስ ዹፌ። <verse eid="JER 42:7"/><verse number="8" style="v" sid="JER 42:8"/>ከናፉ እን ዮሃናን እልመ ቃሬያቲፊ አጀጆተ ወራና ከኔን እሰ ወጅን ቱረን ሁንደ፣ አከሱመስ ነመ ጥና ጉዳ ሁንደ ወልት ዋሜ። <verse eid="JER 42:8"/><verse number="9" style="v" sid="JER 42:9"/>እንስ አከነ እሳኒን ጄዼ፤ “<char style="nd">ዋቀዮ</char> ዋቅን እስራኤል እን እስን አከ አን እየተኬሰን እት እስኒ ዽኤሱፍ እት ነ ኤርግተን ሱን አከነ ጄዸ፦ <verse eid="JER 42:9"/><verse number="10" style="v" sid="JER 42:10"/>‘ዮ ብየ ከነ ኬሰ ቱርተን፣ አን እስነን እጃረ መሌ እስን ህንዲጉ፤ አን እስነን ዻበ መሌ እስን ህንቡቅሱ፤ አን በዲሰ እስንት ፍዴ ሰናፍ ጋቤራቲ። <verse eid="JER 42:10"/><verse number="11" style="v" sid="JER 42:11"/>ሞቲ ባብሎን እሰ አመ ሶዳተን ከነ ህንሶዳትና። አን እስን በራሬ ሀርከሳቲ እስን ባሱፍ እስን ወጅን ጅራቲ። እሰ ህንሶዳትና፣ ጄዸ <char style="nd">ዋቀዮ</char>። <verse eid="JER 42:11"/><verse number="12" style="v" sid="JER 42:12"/>አን አከ እን ገራ እስኒ ላፌ ብየኬሰንት እስን ዴብሱፍ ገራ እስኒፍ ነንላፈ።’<verse eid="JER 42:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 42:13"/>“ገሩ ዮ እስን፣ ‘ኑ ብየ ከነ ኬሰ ህንቱሩ’ ጄተኒ አከሲን <char style="nd">ዋቀዮ</char> ዋቀኬሰኒፍ አጀጀሙ ድደን፣ <verse eid="JER 42:13"/><verse number="14" style="v" sid="JER 42:14"/>አመሌ ዮ እስን፣ ‘ህንተኡ፣ ኑ ብየ ግብጥ ኬሰ እዶ እት ወራነ ህንአርግኔ ዮካን መለከተ ህንዸጌኜ ዮካን እዶ እት ህንቤሎፍኔ ሰነ ዸቅኔ አች ጅራትነ’ ጄተን፣ <verse eid="JER 42:14"/><verse number="15" style="v" sid="JER 42:15"/>ኤጋ ያ ሀምባ ይሁዳ፣ ዱቢ <char style="nd">ዋቀዮ</char> ዸገኣ። <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል አከነ ጄዸ፦ ‘ዮ እስን ብየ ግብጥት ገሉ በርባደኒ አች ጅራቹ ዸቅጠን፣ <verse eid="JER 42:15"/><verse number="16" style="v" sid="JER 42:16"/>ጎራዴን እስን ሶዳተን ሱን አቹመት እስን አርገተ፤ ቤል እስን ሶዳተንስ ሀመ ግብጥት እስን ፋነ ቡአ፤ እስንስ አችት ዹምቱ። <verse eid="JER 42:16"/><verse number="17" style="v" sid="JER 42:17"/>ዹጉማን ወር ብየ ግብጥት ገለኒ አች ቁበቹ በርባደን ሁንድ ጎራዴን፣ ቤላፊ ዸእቻን ዹሙ፤ እሳን ኬሳ ነምን በዲሰ አን እሳንት ፍዱ ጀላ በኡ ዮካን ምልቁ ቶኮዩ ህንጅሩ።’ <verse eid="JER 42:17"/><verse number="18" style="v" sid="JER 42:18"/><char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል አከነ ጄዸ፦ ‘አኩመ ኣሪንኮፊ ዼከምስኮ ወረ ዬሩሳሌም ኬሰ ጅራተንረት ዸንገለኤ ሰነ፣ ዮ እስን ብየ ግብጥት ገልተን ዼከምስኮ እስንረት ንዸንገለአ። እስንስ ዋን አባርሳ፣ ዋን ሶዳ፣ ዋን የካቲፊ ዋን ፈፋ ንታቱ፤ እዶ ከነሌ ጎንኩማ ዴብተኒ ህንአርግተን።’<verse eid="JER 42:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 42:19"/>“ያ ሀምባ ይሁዳ <char style="nd">ዋቀዮ</char>፣ ‘ብየ ግብጥ ህንዸቅና’ እስኒን ጄዼረ። ዋን ከነ ቀልቤፈዻ፦ አን ሀርአ እስን አኬከቺሳቲ፤ <verse eid="JER 42:19"/><verse number="20" style="v" sid="JER 42:20"/>እስን ጋፈ ‘<char style="nd">ዋቀዮ</char> ዋቀኬኘ ኑ ከዸዹ፤ ዋን እን ዱበቴ ሁንደስ ኑት ህም፤ ኑስ ንአጀጀምናፍ’ ጄተኒ ገረ <char style="nd">ዋቀዮ</char> ዋቀኬሰኒ ነ ኤርግተን ሰነ በሌሳ ጉዳ ሆጄተን። <verse eid="JER 42:20"/><verse number="21" style="v" sid="JER 42:21"/>አን ሀርአ እስንት ህሜረ፤ እስን ገሩ ዋን እን አከ አን እስንት ህሙፍ ነ ኤርጌ ሰነ ሁንዳን <char style="nd">ዋቀዮ</char> ዋቀኬሰኒፍ ህንአጀጀምኔ። <verse eid="JER 42:21"/><verse number="22" style="v" sid="JER 42:22"/>ከናፉ እስን አመ ዋን ከነ ቀልቤፈዻ፦ እስን እዶ ጅራቹ ዸቁ ፌተን ሰነ ኬሰት ጎራዴን፣ ቤላፊ ዸእቻን ንዹምቱ።”<verse eid="JER 42:22"/></para>
  <chapter eid="JER 42"/>
  <chapter number="43" style="c" sid="JER 43"/>
  <para style="p">
    <verse number="1" style="v" sid="JER 43:1"/>ኤርገ ኤርምያስ ዱቢ <char style="nd">ዋቀዮ</char> ዋቀሳኒ ከን <char style="nd">ዋቀዮ</char> አከ እን ነመ ሁንደት ህሙፍ እሰ ኤርጌ ሰነ ዱበቴ ፍጤ ቦዴ፣ <verse eid="JER 43:1"/><verse number="2" style="v" sid="JER 43:2"/>አዛርያ እልም ሆሸእያ፣ ዮሃናን እልም ቃሬያቲፊ ነሞትን ኦፍ ቱለን ሁንድ ኤርምያሲን አከነ ጄዸን፤ “አት ንሶብደ! <char style="nd">ዋቀዮ</char> ዋቅንኬኘ አከ አት፣ ‘እስን አች ጅራቹፍ ጄተኒ ብየ ግብጥ ዸቁ ህንቀብደን’ ጄቱፍ ስ ህንኤርግኔ። <verse eid="JER 43:2"/><verse number="3" style="v" sid="JER 43:3"/>ባሩክ እልም ኔርያ ገሩ አከ አት አከ እሳን ኑ ፍጠኒፍ ዮካን ቦጅአኒ ባብሎንት ኑ ጌሰኒፍ ደበርስቴ ሀርከ ባብሎኖታት ኑ ኬንቱፍ ስ ከካሳ ጅረ።”<verse eid="JER 43:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 43:4"/>ከናፉ ዮሃናን እልም ቃሬያቲፊ አጀጆትን ወራና ሁንዲፊ ሰብን ሁንድ አጀጀ <char style="nd">ዋቀዮ</char> አከ እሳን ብየ ይሁዳ ቱረኒፍ ኬኔፍ ሰነ ድደን። <verse eid="JER 43:4"/><verse number="5" style="v" sid="JER 43:5"/>ቆደ ከና ዮሃናን እልም ቃሬያቲፊ አጀጆትን ወራና ሁንድ ሀምባ ይሁዳ ከኔን ብዮተ እት ብብትኔፈመን ሁንደ ኬሳ ዴብአኒ ብየ ይሁዳ ኬሰ ጅራቹፍ ዹፈን ሁንደ ፉዸተኒ ዴመን። <verse eid="JER 43:5"/><verse number="6" style="v" sid="JER 43:6"/>አከሱመስ ዺራ ዱበርቲ፣ እጆሌፊ እንተለን ሞቲ ከኔን ኔቡዘረዳን አጀጃን ኤጉምሳ ሱን ጌዳልያስ እልመ አሂቃም፣ እልመ ሻፋን፣ ኤርምያስ ራጅቻፊ ባሩክ እልመ ኔርያ ብረት ዺሴ ሰነ ሁንደ ፉዸተኒ ዴመን። <verse eid="JER 43:6"/><verse number="7" style="v" sid="JER 43:7"/>እሳንስ አከሲን <char style="nd">ዋቀዮፍ</char> አጀጀሙ ድዱዻን ብየ ግብጥት ገለኒ ሀመ ተህጳንሄስ ኬሰ ልጠን።<verse eid="JER 43:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 43:8"/>ተህጳንሄስትስ ዱቢን <char style="nd">ዋቀዮ</char> አከነ ጄዼ ገረ ኤርምያስ ዹፌ፦ <verse eid="JER 43:8"/><verse number="9" style="v" sid="JER 43:9"/>“ዸጋ ጉርጉዳ ጉሪቲ በልበለ መሰራ ፈረኦን ከን ተህጳንሄስ ጅሩ ሰና ብረት ኡቱመ ይሁዶትን እላለኑ አፋ ሱጴ ኬሰት አዋል። <verse eid="JER 43:9"/><verse number="10" style="v" sid="JER 43:10"/>ኤርገሲ አከነ እሳኒን ጄዽ፤ ‘<char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል አከነ ጄዸ፦ አን ተጃጅላኮ ኔቡከድኔዘር ሞትቸ ባብሎንት ነመ ኤርጌ ነንዋመ፤ ቴሶሳሌ ዸጋ አስት አዋሌ ከነረ ነንዻበ፤ እንስ ዱንካነ ሞቱማ ኦፊሳ እሰረት ንድሪርፈተ። <verse eid="JER 43:10"/><verse number="11" style="v" sid="JER 43:11"/>እን ዹፌ ግብጥን ንሎለ፤ ወረ ዱኣፍ ረመደመንት ዱአ፣ ወረ ቦጁፍ ረመደመንት ቦጁ፣ ወረ ጎራዴፍ ረመደመንት ጎራዴ ንፍደ። <verse eid="JER 43:11"/><verse number="12" style="v" sid="JER 43:12"/>እን መኔን ዋቄፈትና ዋቆተ ግብጥት እብደ ቀብሲሰ፤ መኔን ዋቄፈትናሳኒ ጉቤ ዋቆተሳኒ ቶልፈሞሌ ቦጅአ። አኩመ ትኬን ቶኮ ወያ መርጥፈቱ ሰነ እንስ ብየ ግብጥ መርጥፈቴ ነጉማንስ አቺ ዴመ። <verse eid="JER 43:12"/><verse number="13" style="v" sid="JER 43:13"/>እን አቹመ ገልመ ዋቄፈትና አዱ ብየ ግብጥ ኬሰት ኡቱቦተ ዋቄፈትና ጨጨብሴ ገልመ ዋቄፈትና ዋቆተ ግብጢሌ ንጉበ።’ ”<verse eid="JER 43:13"/></para>
  <chapter eid="JER 43"/>
  <chapter number="44" style="c" sid="JER 44"/>
  <para style="s1">በዲሰ ዋቆተ ቶልፈሞ ዋቄፈቹን ፍዴ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 44:1"/>ዱቢን ዋኤ ይሁዶተ ብየ ግብጥ ኬሰ ጄቹንስ ምግዶል፣ ተህጳንሄስ፣ ሜምፊሲፊ ጰጥሮስ ኬሰ ጅራተን ሁንዳ ዱበቱ ኩን አከነ ጄዼ ገረ ኤርምያስ ዹፌ፤ <verse eid="JER 44:1"/><verse number="2" style="v" sid="JER 44:2"/>“<char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል አከነ ጄዸ፦ እስን በዲሰ ጉዳ አን ዬሩሳሌሚፊ መጋላወን ይሁዳ ሁንደት ፍዴ ሰነ አርግተኒርቱ። ኩኖ፣ እሳን ሀርአ ኦነኒሩ፤ ነምን ቶኮዩ እሳን ኬሰ ህንጅራቱ፤ <verse eid="JER 44:2"/><verse number="3" style="v" sid="JER 44:3"/>ኩንስ ሰበቢ ሀምነ እሳን ሆጄተኒቲፍ ተኤ። እሳን እጣነ ኣርሱፊ ዋቆተ እሳን ዮካን እስን ዮካን አቦቲንኬሰን ህንቤክን ብራ ዋቄፈቹዻን ዼከምሳፍ ነ ከካሰን። <verse eid="JER 44:3"/><verse number="4" style="v" sid="JER 44:4"/>አንስ፣ ‘ዋን ጅብሲሳ አን ህንጃለትኔ ከነ ህንሆጄትና!’ ጄዼ ተጃጅልቶተኮ ራጆተ አሙማ አመ እሳንት ኤርጌ። <verse eid="JER 44:4"/><verse number="5" style="v" sid="JER 44:5"/>እሳን ገሩ ህንዸጌፈትኔ ዮካን ጉረ ህንኬንኔፍ፤ እሳን ሀምነሳኒራ ህንዴብኔ ዮካን ዋቆተ ብራቲፍ እጣነ ኣርሱ ህንዺፍኔ። <verse eid="JER 44:5"/><verse number="6" style="v" sid="JER 44:6"/>ከናፉ ዼከምስኮ ሶዳችሳን ሱን ዸንገለኤ መጋላወን ይሁዳቲፊ ዳንዲወን ዬሩሳሌምረት ቦበኤ፤ እሳንስ አኩመ ሀርአ ተኤ ጅሩ ከነ ንበርበዳአን፤ ንኦነንስ።<verse eid="JER 44:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 44:7"/>“አመስ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል አከነ ጄዸ፦ እስን ማሊፍ ዺራፊ ዱበርቲ፣ እጆሌፊ ዳእመን ይሁዳራ ኩተኒ በዲሰ ጉዳ አከና ኦፍት ፍዱዻን ሀምባ መሌ ኦፍ ሀምብፍቱ? <verse eid="JER 44:7"/><verse number="8" style="v" sid="JER 44:8"/>እስን ማሊፍ ብየ ግብጥ፣ ለፈ ኬሰ ጅራቹፍ ዹፍተንት ዋቆተ ብራቲፍ እጣነ ኣርሱዻን ዋኑመ ሀርክኬሰን ሆጄቴን ዼከምሳፍ ነ ከካፍቱ? እስን ኦፉመ በሌስተኒ ሰቦተ ለፈራ ሁንደ ግዱት ዋን አባርሳቲፊ ዋን ፈፋ ኦፍ ጎቱ። <verse eid="JER 44:8"/><verse number="9" style="v" sid="JER 44:9"/>እስን ሀምነ አቦቲንኬሰን፣ ሞቶትን ይሁዳቲፊ ኒቶትንሳኒ ሆጄተን፣ አከሱመስ ሀምነ እስኒፊ ኒቶትንኬሰን ብየ ይሁዳቲፊ ዳንዲወን ዬሩሳሌምረት ሆጄተን ሰነ ንእራንፈተኒ? <verse eid="JER 44:9"/><verse number="10" style="v" sid="JER 44:10"/>እሳን ሀመ ሀርኣት ገድ ኦፍ ህንቀብኔ ዮካን ነ ህንሶዳትኔ ዮካን ሴረኮቲፊ ቀጄልፈመኮ ከን አን ፉለኬሰኒፊ ፉለ አቦቲኬሰኒ ዱረ ካኤ ሰነ ዱካ ህንቡኔ።<verse eid="JER 44:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 44:11"/>“ከናፉ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል አከነ ጄዸ፦ አን በዲሰ እስንት ፍዱፊ ይሁዳ ሁንደ በሌሱፍ ኩተዼረ። <verse eid="JER 44:11"/><verse number="12" style="v" sid="JER 44:12"/>አን ሀምባ ይሁዳ ከኔን ብየ ግብጥ ዸቀኒ አች ጅራቹ ሙርቴፈተን ነንበሌሰ። እሳን ሁንድ ግብጥት ዹሙ፤ እሳን ጎራዴዻን ኩኩፉ ዮካን ቤላን ዹሙ። ጥና ጉዳንሳኒ ጎራዴዻን ዮካን ቤላን ዱአ። እሳን ዋን አባርሳቲፊ ዋን ሶዳ፣ ዋን የካቲፊ ዋን ፈፋ ተኡ። <verse eid="JER 44:12"/><verse number="13" style="v" sid="JER 44:13"/>አን አኩመ ዬሩሳሌምን አደቤ ሰነ ወረ ግብጥ ኬሰ ጅራተንሌ ጎራዴዻን፣ ቤላፊ ዸእቻን ነንአደበ። <verse eid="JER 44:13"/><verse number="14" style="v" sid="JER 44:14"/>ሀምባ ይሁዳ ከኔን ብየ ግብጥ ኬሰ ጅራቹ ዸቀን ኬሳ ነምን ምልቁ ዮካን ብየ ይሁዳ ከን አች ጅራቹፍ ሀወን ሰነት ዴብኡ ቶኮዩ ህንጅሩ፤ በቀቶተ ቶኮ ቶኮ መሌ እሳን ህንዴብአኒቲ።”<verse eid="JER 44:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 44:15"/>ኤርገሲስ ነሞትን አከ ኒቶትንሳኒ ዋቆተ ብራቲፍ እጣነ ኣርሰን ቤከን ሁንዲፊ ዱበርቶትን አች ቱረን፣ ወሉመት ወልዳን ጉዳን ቶኮፊ ነሞትን ብየ ግብጥ ኬሰ ጰጥሮስ ጅራተን ሁንድ ኤርምያሲን አከነ ጄዸን፤ <verse eid="JER 44:15"/><verse number="16" style="v" sid="JER 44:16"/>“ኑ ዱቢ አት መቃ <char style="nd">ዋቀዮቲን</char> ኑት ዱበቴ ሰነ ህንዸጌኙ! <verse eid="JER 44:16"/><verse number="17" style="v" sid="JER 44:17"/>ኑ ዋን ንሆጄትነ ጄኔ ሁንደ ዹጉማን ንሆጄትነ፦ አኩመ ኑፊ አቦቲንኬኘ፣ ሞቶትንኬኛፊ ቆንዳልቶትንኬኘ መጋላወን ይሁዳቲፊ ዳንዲወን ዬሩሳሌምረት ጎኔ ሰነ ኑ ሞትቲ ሰሚቲፍ እጣነ ንኣርስነ፤ ዽባዩስ ንዽባፈትነ። ኑ ዬሮ ሰነት ኛተ አከ መሌ ባይኤ ቀብነ ቱሬ፤ ሃለ ቶላ ኬሰ ጅራትኔ መሌ ህንሚዸምኔ። <verse eid="JER 44:17"/><verse number="18" style="v" sid="JER 44:18"/>ኤርገ ሞትቲ ሰሚቲፍ እጣነ ኣርሱፊ ዽባዩ ዽባፈቹ ዺፍኔ ገሩ ኑ ጎራዴፊ ቤላን ዹማ ጅረ መሌ ሆማ ህንአርገኔ።”<verse eid="JER 44:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 44:19"/>ዱበርቶትንስ ከነረት፣ “ዬሮ ኑ ሞትቲ ሰሚቲፍ እጣነ ኣርስኔ ዽባዩሌ ዽባፈኔፍ ሰነ አከ ኑ ፈኪ እሼቲን ኬኪ ቶልችኔ ዽባዩ ዽባፈኑፍ ዽርሶትንኬኘ ንቤኩ ምቲ?” ጄዸን።<verse eid="JER 44:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 44:20"/>ኤርምያስ ኡመተ ዴቢ እሳፍ ኬና ቱሬ ዺራ ዱበርቲ ሁንዳን አከነ ጄዼ፤ <verse eid="JER 44:20"/><verse number="21" style="v" sid="JER 44:21"/>“<char style="nd">ዋቀዮ</char> ዋኤ እጣነ እስኒፊ አቦቲንኬሰን፣ ሞቶትንኬሰኒፊ ቆንዳልቶትንኬሰን፣ ሰብን ብየቲስ መጋላወን ይሁዳቲፊ ዳንዲወን ዬሩሳሌም ኬሰት ኣርስተን ሰና ያደቴ ገራት ህንቀበትኔ? <verse eid="JER 44:21"/><verse number="22" style="v" sid="JER 44:22"/>ዬሮ <char style="nd">ዋቀዮ</char> ሆጂኬሰን ሀማፊ ዋን ጅብሲሳ እስን ሆጄተን ሰነ አርጌ ኦብሱ ደዸቤት ብይኬሰን አኩመ አመ ጅርቱ ከነ ዋን አባርሳቲፊ ኦነ ዱዋ ነምን ኬሰ ህንጅራትኔ ተኤ ሀፌ። <verse eid="JER 44:22"/><verse number="23" style="v" sid="JER 44:23"/>ሰበቢ እስን እጣነ ኣርስተኒ <char style="nd">ዋቀዮት</char> ጩቡ ሆጄተኒፊ እሳፍ አጀጀሙ ድደኒፍ ዮካን ሴረሳ ዮካን ለብሲሳ ዮካን ቀጄልፈመሳሌ ዱካ ቡኡ ድደኒፍ በላን ኩን አኩመ እስን አመ አርግተን ከነ እስንት ዹፌ።”<verse eid="JER 44:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 44:24"/>ኤርምያስስ ሰበ ሁንዳፊ ዱበርቶተ ሁንዳን አከነ ጄዼ፤ “እስን ሰብን ይሁዳ ወር ብየ ግብጥ ኬሰ ጅራተን ሁንድ ዱቢ <char style="nd">ዋቀዮ</char> ዸገኣ። <verse eid="JER 44:24"/><verse number="25" style="v" sid="JER 44:25"/><char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል አከነ ጄዸ፦ እስኒፊ ኒቶትንኬሰን ዋን፣ ‘ኑ ዹጉማን ወሬገ ዋቅቲ ሰሚቲፍ እጣነ ኣርሱፊ ዽባዩሌ ዽባፈቹፍ ወሬግኔ ሰነ ንጉትነ’ ጄተንት ዋዳ ገልተን ሰነ ሆጂዻን አርግሲፍተኒርቱ።</para>
  <para style="p" vid="JER 44:25">“ኤጋ እቱመ ፉፋቲ ዋን ዋዳ ገልተን ሰነ ራወዻ! ወሬገኬሰንስ ጉተዻ! <verse eid="JER 44:25"/><verse number="26" style="v" sid="JER 44:26"/>እስን ይሁዶትን ብየ ግብጥ ኬሰ ጅራተን ሁንድ ገሩ ዱቢ <char style="nd">ዋቀዮ</char> ዸገኣ፦ <char style="nd">ዋቀዮ</char> አከነ ጄዸ፤ ‘አከ ነምን ይሁዳዻ ዹፌ ብየ ግብጥ ኬሰ ኤሰዩ ጅራቱ ቶኮዩ ለመተ መቃኮ ህንዾፍኔ ዮካን፣ “ዹጋ <char style="nd">ዋቀዮ</char> ጎፍትቸ ጅራታ” ጄዼ ህንከከትኔን አን መቃኮ ጉዳዻን ነንከከዸ። <verse eid="JER 44:26"/><verse number="27" style="v" sid="JER 44:27"/>አን ዋን ሀማፍ እሳን እላላን ጅረ መሌ ዋን ቶላፍ እሳን እላላ ህንጅሩቲ፤ ይሁዶትን ብየ ግብጥ ኬሰ ጅራተን ሀመ ሁንድሳኒ በርበዴፈመንት ጎራዴፊ ቤላን ዹሙ። <verse eid="JER 44:27"/><verse number="28" style="v" sid="JER 44:28"/>ወር ጎራዴ ጀላ ምልቀኒ ብየ ግብጢ ገረ ይሁዳት ዴብአን አከ መሌ ጥኖ ተኡ። ጋፈስ ሀምባወን ይሁዳ ከኔን ብየ ግብጥ ኬሰ ጅራቹፍ ዹፈን ጉቱን አከ ዱቢንኮቲፊ ከንሳኒ ኬሳ ከን ኤኙ ፊጣን በኡ ንቤኩ።<verse eid="JER 44:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JER 44:29"/>“ ‘አከ አን እዶ ከነት እስን አደቡ ወን ኩን መለቶ እስኒፍ ተአ፤’ ጄዸ <char style="nd">ዋቀዮ</char>፤ ‘ኩንስ አከ እስን አከ ዱቢንኮ ዹጉማን እስኒን ሞርሜ ዻበቱ ቤክተኒፍ።’ <verse eid="JER 44:29"/><verse number="30" style="v" sid="JER 44:30"/><char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ ‘አን አኩመ ዜዴቅያ ሞትቸ ይሁዳ ደበርሴ ዲነ ሉቡሳ ገላፈቹ በርባዱት ኔቡከድኔዘር ሞትቸ ባብሎንት ኬኔ ሰነ ፈረኦን ሆፍራ ሞትቸ ግብጥሌ ደበርሴ ዲኖተሳ ወረ ሉቡሳ ገላፈቹ በርባደንት ነንኬነ።’ ”<verse eid="JER 44:30"/></para>
  <chapter eid="JER 44"/>
  <chapter number="45" style="c" sid="JER 45"/>
  <para style="s1">ዻምሰ ባሩክት ኤርገሜ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 45:1"/>በረ ዬሆያቂም እልም ዮስያስ ሞቲ ይሁዳ ቱሬ ኬሰ ወጋ አፉረፋት ባሩክ እልም ኔርያ ዱቢ ኤርምያስራ ዸገኤ ክታበ መረማረት በሬሴ፤ ዱቢን ኤርምያስ ራጅች ባሩክት ህሜስ ከናዸ፦ <verse eid="JER 45:1"/><verse number="2" style="v" sid="JER 45:2"/>“ያ ባሩክ፣ <char style="nd">ዋቀዮ</char> ዋቅን እስራኤል አከነ ሲን ጄዸ፦ <verse eid="JER 45:2"/><verse number="3" style="v" sid="JER 45:3"/>አት፣ ‘አናፍ ወዮ! <char style="nd">ዋቀዮ</char> ዽቤኮረት ገደ ነት ደበሌረ፤ አን ኣዱዻን ላፌ ቦቆና ዸቤረ’ ጄቴ። <verse eid="JER 45:3"/><verse number="4" style="v" sid="JER 45:4"/><char style="nd">ዋቀዮ</char> አከነ ጄዼ፤ ‘አከነ ጄዺን፦ <char style="nd">ዋቀዮ</char> አከነ ጄዸ፤ አን ጉቱማ ብየቲ ኬሳ ዋነን እጃሬ ነንዲገ፤ ዋነን ዻቤሌ ነንቡቅሰ። <verse eid="JER 45:4"/><verse number="5" style="v" sid="JER 45:5"/>ኤጋ አት ኦፊኬቲፍ ዋን ጉርጉዳ ንበርባዳ? እሳን ህንበርባድን። አን ሰበ ሁንደት በዲሰ ነንፍደ፤ ገሩ ለፈ ዸቅጡ ሁንደት ሉቡኬ ቦጁ ጎዼ ሲፈን ኬነ፣ ጄዸ <char style="nd">ዋቀዮ</char>።’ ”<verse eid="JER 45:5"/></para>
  <chapter eid="JER 45"/>
  <chapter number="46" style="c" sid="JER 46"/>
  <para style="s1">ኤርጋ ዋኤ ግብጥ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 46:1"/>ዱቢን <char style="nd">ዋቀዮ</char> ከን ዋኤ ሰቦታቲፍ ገረ ኤርምያስ ራጅቻ ዹፌ ከናዸ፦<verse eid="JER 46:1"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="2" style="v" sid="JER 46:2"/>ዋኤ ግብጥ፦</para>
  <para style="b" vid="JER 46:2"/>
  <para style="p" vid="JER 46:2">በረ ዬሆያቂም እልም ዮስያስ ሞቲ ይሁዳ ቱሬ ኬሰ፣ ወጋ አፉረፋት ኤርጋን ኩን ገረ ወራነ ፈረኦን ኔኮ ሞትቸ ግብጥ ከን ኔቡከድኔዘር ሞትች ባብሎን ለገ ኤፍራጢስ ብረት ከርኬሚሽት ሞአቴ ሰና ዹፌ፦<verse eid="JER 46:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 46:3"/>“ጋቸነኬሰን ጥናፊ</para>
  <para style="q2" vid="JER 46:3">ጉዳ ቆጴፈዻቲ ሎላፍ በኣ!<verse eid="JER 46:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 46:4"/>ፈርዴን ፌአዻ፤</para>
  <para style="q2" vid="JER 46:4">እሳን ያበዻስ!</para>
  <para style="q1" vid="JER 46:4">ቆቢ ስቢላ ካአዻቲ</para>
  <para style="q2" vid="JER 46:4">እዶ እዶኬሰን ቀበዻ።</para>
  <para style="q1" vid="JER 46:4">ኤቦኬሰን ቀረዻ፤</para>
  <para style="q2" vid="JER 46:4">ቆሜ ስቢላሌ ኡፈዻ!<verse eid="JER 46:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 46:5"/>አን ማል አርጋን ጅረ?</para>
  <para style="q2" vid="JER 46:5">እሳን ነአኒ ጅሩ፤</para>
  <para style="q1" vid="JER 46:5">ዱግደ ዱበት ዴብኣ ጅሩ፤</para>
  <para style="q2" vid="JER 46:5">ጎቶትንሳኒ ሞአተመኒሩ።</para>
  <para style="q1" vid="JER 46:5">እሳን ኡቱ ኦፍ ዱበ ህንምልአትን አሪቲን በቀቱ፤</para>
  <para style="q2" vid="JER 46:5">ቅጠ ሁንዳኑ ጎሊቱ ጅረ”</para>
  <para style="q2" vid="JER 46:5">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 46:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 46:6"/>“ፊጋን በቀቹ ህንደንደኡ፤</para>
  <para style="q2" vid="JER 46:6">ዮካን ነምን ጀባን ጀላ ህንበኡ።</para>
  <para style="q1" vid="JER 46:6">እሳን ከራ ካባቲን</para>
  <para style="q2" vid="JER 46:6">ለገ ኤፍራጢስ ብረት ጉጉፈተኒ ኩኩፉ።<verse eid="JER 46:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="JER 46:7"/>“ከን አከ አበያ፣</para>
  <para style="q2" vid="JER 46:7">አከ ለገ ብሻንሳ ጨብሴ ያኡ ኦል ከኡ ኩን ኤኙ?<verse eid="JER 46:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 46:8"/>ግብጥ አኩመ አበያ፣</para>
  <para style="q2" vid="JER 46:8">አኩመ ለገ ብሻንሳ ጨብሴ ያኡት ኦል ካት።</para>
  <para style="q1" vid="JER 46:8">እሼንስ፣ ‘አን ኦል ከኤ ለፈ ነንሀጉገ፤</para>
  <para style="q2" vid="JER 46:8">መጋላወኒፊ ሰበሳኒ ነንበሌሰ’ ጄት።<verse eid="JER 46:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 46:9"/>ያ ፈርዴን፣ እስን ገርማማ!</para>
  <para style="q2" vid="JER 46:9">ያ ጋሪወን፣ እስንስ ጉላ!</para>
  <para style="q1" vid="JER 46:9">ያ ጎቶተ እቶጵያቲፊ ፉጥ ወር ጋቸነ ባተን፣</para>
  <para style="q2" vid="JER 46:9">ያ ነሞተ ሉድ ወር እዳ ቀበተን ከኣቲ <optbreak/> ፉለ ዱረት ቀጄላ።<verse eid="JER 46:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 46:10"/>ጉያን ሱን ገሩ ጉያ ጎፍታ፣ <optbreak/> ከን <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣</para>
  <para style="q2" vid="JER 46:10">ጉያ ሃሎ በኡ፣ ከን እን እት ዲኖተሳ ሃሎ ባፈቱዸ።</para>
  <para style="q1" vid="JER 46:10">ጎራዴን ሀመ ቁፉት፣</para>
  <para style="q2" vid="JER 46:10">ሀመ ዼቡ ዺጋን በኡት ኛተ።</para>
  <para style="q1" vid="JER 46:10">ጎፍታን፣ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ</para>
  <para style="q2" vid="JER 46:10">ብየ ካባ ኬሰት፣ ለገ ኤፍራጢስ ብረት ኣርሳ ዽኤሳቲ።<verse eid="JER 46:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="JER 46:11"/>“ያ ግብጥ ዱርበ ቁልቁልቲ፣</para>
  <para style="q2" vid="JER 46:11">ግልኣድት ኦል በኢቲ ቆርቸ ፉዸዹ።</para>
  <para style="q1" vid="JER 46:11">አት አከሱማን ቆርቸ ሄዱት ፈየደምተ፤</para>
  <para style="q2" vid="JER 46:11">ገሩ ህንፈይቱ።<verse eid="JER 46:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 46:12"/>ሰቦትን ቃኒኬ ንዸገኡ፤</para>
  <para style="q2" vid="JER 46:12">ቦእችኬ ለፈ ጉተ።</para>
  <para style="q1" vid="JER 46:12">ጎን ቶኮ ጎተ ካንት ጉፈተ፤</para>
  <para style="q2" vid="JER 46:12">እሳን ለማኑ ወል ቀበተኒ ኩፉ።”<verse eid="JER 46:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 46:13"/>“ዱቢን <char style="nd">ዋቀዮ</char> አከ ኔቡከድኔዘር ሞቲን ባብሎን ዹፌ ግብጥ ዸኡ ኤርምያስ ራጅቸት ዱበቴ ከናዸ፦<verse eid="JER 46:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 46:14"/>“ዋን ከነ ግብጥ ኬሰት ዱበዹ፤ ምግዶልትስ ለብስ፤</para>
  <para style="q2" vid="JER 46:14">ሜምፊሲፊ ተህጳንሄስ ኬሰትሌ አከነ ጄዻ ለብሳ፦</para>
  <para style="q1" vid="JER 46:14">‘ጎራዴን ወረ ናኖኬሰን ጅሩ ንፍጣቲ</para>
  <para style="q2" vid="JER 46:14">እስን እዶ እዶኬሰን ቀበዻቲ ቆጳኣ።’<verse eid="JER 46:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 46:15"/>ጎቶትንኬ ማሊፍ ኩፈኒ ድሪሩ?</para>
  <para style="q2" vid="JER 46:15">ሰበቢ <char style="nd">ዋቀዮ</char> ገድ እሳን ቀቡፍ እሳን ዻበቹ ህንደንደአን።<verse eid="JER 46:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 46:16"/>እሳን አሙማ አመ ጉፈቱ፤</para>
  <para style="q2" vid="JER 46:16">ወልረትስ ኩኩፉ።</para>
  <para style="q1" vid="JER 46:16">እሳንስ፣ ‘ከኣ ጎራዴ ጩንቁርሳ</para>
  <para style="q2" vid="JER 46:16">ጀላ ባኔ ገረ ሰበኬኛቲፊ</para>
  <para style="q2" vid="JER 46:16">ብየ እት ዸለኔት ንዴብና’ ወሊን ጄዹ።<verse eid="JER 46:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 46:17"/>እሳን አችት፣</para>
  <para style="q2" vid="JER 46:17">‘ፈረኦን ሞትች ግብጥ ወጨ ቆፈ፤</para>
  <para style="q2" vid="JER 46:17">እን ጨራ ኦፊሳ ዸቤረ’ ጄዸኒ እዩ።<verse eid="JER 46:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="JER 46:18"/>“ዹጋ አነ ጅራታ” ጄዸ ሞትች እን መቃንሳ</para>
  <para style="q2" vid="JER 46:18">
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ ተኤ ሱን</para>
  <para style="q1" vid="JER 46:18">“ከን ጋረን ኬሳ ታቦር ፈካቱ፣</para>
  <para style="q2" vid="JER 46:18">እን ገላነ ጭነት ቀርሜሎስን ፈካቱ ቶኮ ንዹፈ።<verse eid="JER 46:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 46:19"/>አት ከን ግብጥ ኬሰ ጅራቱ፣</para>
  <para style="q2" vid="JER 46:19">ዋን ቀብዱ ወልት ቀበዹቲ በቃፍ ቆጳእ፤</para>
  <para style="q1" vid="JER 46:19">ሜምፊስ ኦንቴ ዲገምቴ</para>
  <para style="q2" vid="JER 46:19">ጅራቶተ መሌ ሀፍቲቲ።<verse eid="JER 46:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JER 46:20"/>“ግብጥ ጎሮምሰ በሬዱዸ፤</para>
  <para style="q2" vid="JER 46:20">ገሩ ቀርጣሳን</para>
  <para style="q2" vid="JER 46:20">ብየ ካባቲ እሼት ንዹፈ።<verse eid="JER 46:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 46:21"/>ሎልቶትን እሼን ክራዻን ብተቴ ግዱሼ ጅረንስ</para>
  <para style="q2" vid="JER 46:21">አኩመ ጅቦተ ጮጮመኒት።</para>
  <para style="q1" vid="JER 46:21">ሰበቢ ጉያን በዲሳ፣</para>
  <para style="q2" vid="JER 46:21">ዬሮን እት እሳን አደበመን እሳንት ዹፌፍ</para>
  <para style="q1" vid="JER 46:21">እሳንስ ገረ ገለኒ ወሉማን ንበቀቱ፤</para>
  <para style="q2" vid="JER 46:21">እዶሳኒ ዻበተኒ ኦፍራ ዴብሱ ህንደንደአን።<verse eid="JER 46:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 46:22"/>ግብጥ ዬሮ ዲን እሼት ዹፉት</para>
  <para style="q2" vid="JER 46:22">አኩመ ቦፈ ዋ በቀቱ ሲቅስት፤</para>
  <para style="q1" vid="JER 46:22">እሳን አኩመ ነሞተ ሙከ ሙረኒት</para>
  <para style="q2" vid="JER 46:22">ቆቶ ቀበተኒ እሼት ዹፉ።<verse eid="JER 46:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 46:23"/>ዮ እን ሀመ ፌዼ ጎበቴዩ፣</para>
  <para style="q2" vid="JER 46:23">እሳን ቦሶነሼ ጭረኒ በሌሱ”</para>
  <para style="q2" vid="JER 46:23">ጄዸ <char style="nd">ዋቀዮ</char>።</para>
  <para style="q1" vid="JER 46:23">“እሳን ሀዋንሰ ጫላ ባይአቱ፤</para>
  <para style="q2" vid="JER 46:23">ለካአሙስ ህንደንደአን።<verse eid="JER 46:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 46:24"/>እንተል ግብጥ ንቃኔፈምት፤</para>
  <para style="q2" vid="JER 46:24">ደበርፈምቴስ ነሞተ ካባት ንኬነምት።”<verse eid="JER 46:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JER 46:25"/>
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል አከነ ጄዸ፦ “አን ኣሞን ዋቀ ቴቤስት፣ ፈረኦንት፣ ግብጢቲፊ ዋቀሼት፣ ሞቶተ እሼቲፊ ወረ ፈረኦንን አመነተንት አደቢ ነንፍደ። <verse eid="JER 46:25"/><verse number="26" style="v" sid="JER 46:26"/>አን ደበርሴ ወረ ሉቡሳኒ ገላፈቹ በርባደንት፣ ጄቹንስ ኔቡከድኔዘር ሞትቸ ባብሎንቲፊ ቆንዳልቶተሳት እሳን ኬነ። ኤርገሲ ገሩ ግብጥ አኩመ ዱሪ ለፈ ነምን ኬሰ ጅራቱ ንታት” ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 46:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 46:27"/>“ያ ያቆብ ተጃጅላኮ፣ አት ህንሶዳትን፤</para>
  <para style="q2" vid="JER 46:27">ያ እስራኤል አትስ ህንነእን።</para>
  <para style="q1" vid="JER 46:27">አን ለፈ ፈጎቲ ስን ባሰ፤</para>
  <para style="q2" vid="JER 46:27">ሰኚ ኬሞ ብየ እሳን እት ቦጅአመኒ ነንፍደ።</para>
  <para style="q1" vid="JER 46:27">ያቆብ አመስ ነጋፊ ተስገቢ ንቀባተ፤</para>
  <para style="q2" vid="JER 46:27">ነምን እሰ ሶዳችሱ ቶኮዩ ህንጅሩ።<verse eid="JER 46:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 46:28"/>ያ ያቆብ ገርብቸኮ፣ አት ህንሶዳትን፤</para>
  <para style="q2" vid="JER 46:28">አንስ ስ ወጅነን ጅራቲ”</para>
  <para style="q2" vid="JER 46:28">ጄዸ <char style="nd">ዋቀዮ</char>።</para>
  <para style="q1" vid="JER 46:28">“አን ዮ ሰቦተ ግዱሳኒት ስ ብትኔሴ ሰነ</para>
  <para style="q2" vid="JER 46:28">ጉቱማን ጉቱት በሌሴዩ</para>
  <para style="q2" vid="JER 46:28">አን ጉቱማን ጉቱት ስ ህንበሌሱ።</para>
  <para style="q1" vid="JER 46:28">አን ስን አደበ፤ ገሩ ቀጄሉማ ቆፋን፤</para>
  <para style="q2" vid="JER 46:28">አከ አት ኡቱ ህንአደበምኑ ገድ ዺፈምቱ ህንጎዹ።”<verse eid="JER 46:28"/></para>
  <chapter eid="JER 46"/>
  <chapter number="47" style="c" sid="JER 47"/>
  <para style="s1">ኤርጋ ዋኤ ፍልስጤሞታ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 47:1"/>ዱቢን <char style="nd">ዋቀዮ</char> ከን ዋኤ ፍልስጤሞታ ከን ኡቱ ፈረኦን ጋዛ ህንዸእን ዱረ ገረ ኤርምያስ ራጅቻ ዹፌ ከናዸ፦<verse eid="JER 47:1"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="2" style="v" sid="JER 47:2"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 47:2">“ኩኖ፣ ከራ ካባቲን ብሻን ኦል ከኣ ጅረ፤</para>
  <para style="q2" vid="JER 47:2">ብሻን ኩንስ ሎላ ጉቴረ ዸንገለኡ ተአ።</para>
  <para style="q1" vid="JER 47:2">እንስ ብየቲፊ ዋን እሼ ኬሰ ጅሩ፣</para>
  <para style="q2" vid="JER 47:2">መጋላወኒፊ ወረ እሳን ኬሰ ጅራተን ሁንደረ ገረገለ።</para>
  <para style="q1" vid="JER 47:2">ኡመትን ንቦአ፤</para>
  <para style="q2" vid="JER 47:2">ወር እሼ ኬሰ ጅራተን ሁንድስ ንወዋቱ፤<verse eid="JER 47:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 47:3"/>ኩንስ ሰበቢ ድድቸ ኮቴ ፈርዴን ጉሉፈኒ፣</para>
  <para style="q2" vid="JER 47:3">ግርሰ ጋሪወን ዲናቲፊ</para>
  <para style="q2" vid="JER 47:3">ቀቀዌሰ ጎማሳኒቲፍ።</para>
  <para style="q1" vid="JER 47:3">አቦቲን እጆሌሳኒ ገርጋሩፍ ዱበት ገረ ህንገለን፤</para>
  <para style="q2" vid="JER 47:3">ሀርክሳኒስ እሳንረት ላምሸአ።<verse eid="JER 47:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 47:4"/>ፍልስጤሞተ ሁንደ በሌሱፍ</para>
  <para style="q2" vid="JER 47:4">ሀምባ ጢሮሲፊ ሲዶና</para>
  <para style="q1" vid="JER 47:4">ገርጋሩፍ ሀፈን ሁንደስ በሌሱፍ</para>
  <para style="q2" vid="JER 47:4">ጉያን ሱን ዹፌራቲ።</para>
  <para style="q1" vid="JER 47:4">
    <char style="nd">ዋቀዮ</char> ፍልስጤሞተ፣</para>
  <para style="q2" vid="JER 47:4">ሀምባ ቀርቀረ ከፍቶር በሌሱ ገኤረ።<verse eid="JER 47:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 47:5"/>ጋዛን ገዳን መታሼ ሃደት፤</para>
  <para style="q2" vid="JER 47:5">አሽቀሎን ንጨልእስት።</para>
  <para style="q1" vid="JER 47:5">ያ ሀምባ ድሬራ</para>
  <para style="q2" vid="JER 47:5">እስን ሀመ ዮሚት ኦፍ ጭጭርቱ?<verse eid="JER 47:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="JER 47:6"/>“እስን፣ ‘ያ ጎራዴ <char style="nd">ዋቀዮ</char></para>
  <para style="q2" vid="JER 47:6">አት ሀመ ዮሚት ህንቦቆትኔ?</para>
  <para style="q1" vid="JER 47:6">መንኤኬት ዴብእ፤</para>
  <para style="q2" vid="JER 47:6">ጨልእሲ ታእ’ ጄተኒ እይቱ።<verse eid="JER 47:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 47:7"/>ገሩ ኡቱ <char style="nd">ዋቀዮ</char> እሰ አጀጁ፣</para>
  <para style="q2" vid="JER 47:7">ዬሮ ዋቅን አከ እን አሽቀሎኒፊ</para>
  <para style="q1" vid="JER 47:7">ቀርቀረ ገላና ዸኡፍ ቀጄልፈመሳ ኬኑት</para>
  <para style="q2" vid="JER 47:7">እን አከምት ቦቆቹ ደንደአ?”<verse eid="JER 47:7"/></para>
  <chapter eid="JER 47"/>
  <chapter number="48" style="c" sid="JER 48"/>
  <para style="s1">ኤርጋ ዋኤ ሞኣብ</para>
  <para style="r">
    <ref loc="JER 48:29-36">48፥29‑36</ref> ኩወፈ – <char style="xt"><ref loc="ISA 16:6-12">እሳ 16፥6‑12</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="JER 48:1"/>ዋኤ ሞኣብ፦</para>
  <para style="b" vid="JER 48:1"/>
  <para style="p" vid="JER 48:1">
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 48:1">“ኔቦፍ ወዮ፤ እሼን ንዲገምቲቲ።</para>
  <para style="q2" vid="JER 48:1">ክርያታይምስ ንሰልጰት፤ ንቀበምት፤</para>
  <para style="q2" vid="JER 48:1">ደኦወንሼስ ንቃኔፈሙ፤ ንዲገሙስ።<verse eid="JER 48:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 48:2"/>ሞኣብ ስአች ህንጀጀምቱ፤</para>
  <para style="q2" vid="JER 48:2">ነሞትን ሄሽቦን ኬሰት፣</para>
  <para style="q2" vid="JER 48:2">‘ኮታ ሰበ ሰነ ንበሌስና’ <optbreak/> ጄዸኒ ዋኤ ኩፋቲሼ መርአቱ።</para>
  <para style="q1" vid="JER 48:2">ያ መጋላ ማድሜን ጄዸምቱ አትስ ንጨልእስተ፤</para>
  <para style="q2" vid="JER 48:2">ጎራዴን ስ አርኣቲ።<verse eid="JER 48:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 48:3"/>እየ ሆሮናይሚ ዹፉ፣</para>
  <para style="q2" vid="JER 48:3">እየ በርበዳኡፊ በዲሳ ጉዳ ዸገኣ!<verse eid="JER 48:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 48:4"/>ሞኣብ ንጨብድ፤</para>
  <para style="q2" vid="JER 48:4">እጆሌንሼስ ንቦኡ።<verse eid="JER 48:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 48:5"/>እሳን አከ መሌ ቦኣ፣</para>
  <para style="q2" vid="JER 48:5">ሉሂቲት ኦል በኡ፤</para>
  <para style="q1" vid="JER 48:5">ከራ ገረ ሆሮናይምት ገድ ቡሱረት</para>
  <para style="q2" vid="JER 48:5">እየ በዲሳ ዸገኡ።<verse eid="JER 48:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 48:6"/>በቀዻ! ሉቡኬሰን ባፈዻ፤</para>
  <para style="q2" vid="JER 48:6">አከ ደገለ ገሞጂ ኬሳ ተኣ።<verse eid="JER 48:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 48:7"/>እስን ዋን ሆጂኬሰኒፊ ቀቤኘኬሰን አመነተኒፍ፣</para>
  <para style="q2" vid="JER 48:7">ቦጁዻን ፉዸተምተኒ ንዴምቱ፤</para>
  <para style="q1" vid="JER 48:7">ኬሞሽስ ሉቦተሳቲፊ</para>
  <para style="q2" vid="JER 48:7">ቆንዳልቶተሳ ወጅን ቦጅአሜ ንፉዸተመ።<verse eid="JER 48:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 48:8"/>በሌስቱን ሱን መጋላ ሁንደት ንዹፈ፤</para>
  <para style="q2" vid="JER 48:8">መጋላን ቶኮዩ እሰ ጀላ ህንበኡ።</para>
  <para style="q1" vid="JER 48:8">ሰበቢ <char style="nd">ዋቀዮ</char> ዱበቴፍ ሱሉል ንበደ፤</para>
  <para style="q2" vid="JER 48:8">ድሬንስ ንበርበዴፈመ።<verse eid="JER 48:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 48:9"/>ሞኣብት ሶግደ ፍርፍርስ፤</para>
  <para style="q2" vid="JER 48:9">እሼን ንበዲቲ፤</para>
  <para style="q1" vid="JER 48:9">መጋላወንሼስ</para>
  <para style="q2" vid="JER 48:9">ነመ እሳን ኬሰ ጅራቱ ዸበኒ ኦኑ።<verse eid="JER 48:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JER 48:10"/>“ነምን ገራ ህርኡዻን ሆጂ <char style="nd">ዋቀዮ</char> ሆጄቱ አባረማ ሃተኡ!</para>
  <para style="q2" vid="JER 48:10">ነምን ጎራዴሳቲን ዺገ ዸንገላሱ ድዱስ አባረማ ሃተኡ!<verse eid="JER 48:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="JER 48:11"/>“ሞኣብ አኩመ ዳዺ ወይኒ ከን ሲጮሳረት ሀፌ</para>
  <para style="q2" vid="JER 48:11">ከን ኦኮቴ ቶኮ ኬሳ ገረ ኦኮቴ ካኒት ገረ ህንገልፈምኒ</para>
  <para style="q1" vid="JER 48:11">እጆሉማሼቲ ጀልቀብዴ ቦቆቻ ቱርቴ፤</para>
  <para style="q2" vid="JER 48:11">ቦጅአምቴስ ህንፉዸተምኔ።</para>
  <para style="q1" vid="JER 48:11">ከናፉ እሼን አኩመ ዱሪ ምኦፍት፤</para>
  <para style="q2" vid="JER 48:11">ኡርጋንሼስ ህንጌደረምኔ።<verse eid="JER 48:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 48:12"/>ገሩ በር አን እት ነሞተ ኦኮቴ ኬሳ ዸንገላሰን <optbreak/> ኤርጉ ቶኮ ንዹፈ።</para>
  <para style="q1" vid="JER 48:12">እሳንስ ገድ እሼ ነቁ፤</para>
  <para style="q2" vid="JER 48:12">ኦኮቴሼ ዱዋ ሀምብሰኒ</para>
  <para style="q2" vid="JER 48:12">ጋኒሼ ጨብሱ” ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 48:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 48:13"/>“ዮስ አኩመ መን እስራኤል</para>
  <para style="q2" vid="JER 48:13">ዬሮ ቤትኤልን አመነቴት ቃነኤ ሰነ</para>
  <para style="q2" vid="JER 48:13">ሞኣብስ ኬሞሽት ንቃነአ።<verse eid="JER 48:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="JER 48:14"/>“እስን አከሚን ‘ኑ ጎቶተ፤</para>
  <para style="q2" vid="JER 48:14">ኑ ወራነ ኬሰት ጀጀቦዸ’ ጄቹ ደንዴሱ?<verse eid="JER 48:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 48:15"/>ሞኣብ ንበርበዶፍት፤ መጋላወንሼስ ንቀበተሙ፤</para>
  <para style="q2" vid="JER 48:15">ደርገጎንሼ ፍለተሞን ገረ ቀልማት ጌፈሙ”</para>
  <para style="q2" vid="JER 48:15">ጄዸ ሞትች መቃንሳ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ ጄዸሙ ሱን።<verse eid="JER 48:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 48:16"/>“ኩፋቲን ሞኣብ ገኤረ፤</para>
  <para style="q2" vid="JER 48:16">በዲስንሼስ ደፌ ንዹፈ።<verse eid="JER 48:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 48:17"/>ወር ናኖሼ ጅራተን ሁንድ፣</para>
  <para style="q2" vid="JER 48:17">ወር መቃሼ ቤክተን ሁንድ</para>
  <para style="q1" vid="JER 48:17">‘ቦኩን ጀባን ሱን አከምት ጨቤ!</para>
  <para style="q2" vid="JER 48:17">ኡሌን ኡልፍነ ቀቤስ ሱን አከምት ጨቤ!’ ጄዻ ቦኣፊ።<verse eid="JER 48:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="JER 48:18"/>“ያ ጅራቱ ዲቦን፣</para>
  <para style="q2" vid="JER 48:18">ኡልፍነኬራ ገድ ቡኢቲ</para>
  <para style="q2" vid="JER 48:18">ለፈ ጎጎጋረ ታእ!</para>
  <para style="q1" vid="JER 48:18">በርበዴሳን ሞኣብ ሱን ስት ዹፌ</para>
  <para style="q2" vid="JER 48:18">መጋላወንኬ ከኔን</para>
  <para style="q2" vid="JER 48:18">ደላ ጀባን መርፈመን ንዲጋቲ።<verse eid="JER 48:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 48:19"/>አት ከን አሮኤር ኬሰ ጅራቱ፣</para>
  <para style="q2" vid="JER 48:19">ከራ ጭነ ዻበዹቲ እላል።</para>
  <para style="q1" vid="JER 48:19">ዺረ በቀቱፊ ዱበርቲ ምልቅጡ ጋፈዹ፤</para>
  <para style="q2" vid="JER 48:19">‘ማልቱ ዸለቴ?’ ጄዺ እሳን ጋፈዹ።<verse eid="JER 48:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 48:20"/>ሞኣብ ዋን ዲገምቴፍ ቃኖፍቴርት።</para>
  <para style="q2" vid="JER 48:20">ወዋዹ ቦእ!</para>
  <para style="q1" vid="JER 48:20">አርኖን ብረት</para>
  <para style="q2" vid="JER 48:20">አከ ሞኣብ በርበዶፍቴ ጅርቱ ለብስ።<verse eid="JER 48:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 48:21"/>ሙርቲን ድሬ ኦል ከኣት፦</para>
  <para style="q2" vid="JER 48:21">ሆሎንት፣ ያህዛፊ ሜፍኣት፣<verse eid="JER 48:21"/></para>
  <para style="q2">
    <verse number="22" style="v" sid="JER 48:22"/>ዲቦንት፣ ኔቦፊ ቤት ድብላታይምት፣<verse eid="JER 48:22"/></para>
  <para style="q2">
    <verse number="23" style="v" sid="JER 48:23"/>ክርያታይምት፣ ቤት ጋሙሊፊ ቤት ሜኦንት፣<verse eid="JER 48:23"/></para>
  <para style="q2">
    <verse number="24" style="v" sid="JER 48:24"/>ኬሪዮቲፊ ቦዝራት፣</para>
  <para style="q2" vid="JER 48:24">መጋላወን ሞኣብ ከኔን ፈጎፊ <optbreak/> ዽኦ ጅረን ሁንደት ዹፌረ።<verse eid="JER 48:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 48:25"/>ጋንፍ ሞኣብራ ሙረሜረ፤</para>
  <para style="q2" vid="JER 48:25">እሬንሼስ ጨጨቤረ”</para>
  <para style="q2" vid="JER 48:25">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 48:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="JER 48:26"/>“ዋን እሼን <char style="nd">ዋቀዮት</char> ኮርቴፍ</para>
  <para style="q2" vid="JER 48:26">ዹጋቲዻን እሼ መቼሳ።</para>
  <para style="q1" vid="JER 48:26">ሞኣብ ድድገ ኦፊሼረ ሃገንገለቱ፤</para>
  <para style="q2" vid="JER 48:26">ዋን ቆሳስ ሃታቱ።<verse eid="JER 48:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 48:27"/>እስራኤል ስ ዱረት ዋን ቆሳ ህንቱሬ?</para>
  <para style="q2" vid="JER 48:27">አከ አት ዬሮ ዋኤሼ ዱበቱ ሁንደ</para>
  <para style="q1" vid="JER 48:27">ቱፊዻን መታኬ እሼት ራፍቱፍ</para>
  <para style="q2" vid="JER 48:27">እሼን ሀቶተ ግዱት ቀበምቴ?<verse eid="JER 48:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 48:28"/>እስን ወር ሞኣብ ኬሰ ጅራተን፣</para>
  <para style="q2" vid="JER 48:28">መጋላወንኬሰን ኬሳ በኣቲ ከታወን ኬሰ ጅራዻ።</para>
  <para style="q1" vid="JER 48:28">አኩመ ጉጌ መነሼ</para>
  <para style="q2" vid="JER 48:28">አፋን ሆልቃት እጃረቱ ተአ።<verse eid="JER 48:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="JER 48:29"/>“ኑ ዋኤ ኦፍ ቱሉማ ሞኣብ</para>
  <para style="q2" vid="JER 48:29">ጄቹንስ አከ መሌ ኦፍ ጉድሱፊ ኦፊን ቦኑሼ፣</para>
  <para style="q1" vid="JER 48:29">ኦፍ ቱሉፊ ኦፍ ጀጁሼ፣</para>
  <para style="q2" vid="JER 48:29">ኦፍ ቦኮክሱሼ ዸጌኜረ።<verse eid="JER 48:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 48:30"/>አን አደጉማ ሞኣብ ቤከ፤ <optbreak/> ገሩ ፋይዳ ህንቀባቱ” ጄዸ <char style="nd">ዋቀዮ</char>፤</para>
  <para style="q2" vid="JER 48:30">“ኦፍ ቱሉንሼስ ሆማ ህንፈየዱፍ”<verse eid="JER 48:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JER 48:31"/>ከናፉ አን ሞኣቢፍ ነንወዋዸ፤</para>
  <para style="q2" vid="JER 48:31">ሞኣብ ሁንዳፍ ህቅፈዼ ቦአ፤</para>
  <para style="q2" vid="JER 48:31">አን ነሞተ ቂር ሀሬሼቲፍ ነንገደ።<verse eid="JER 48:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JER 48:32"/>ያ ሙከ ወይኒ ስብማ፣</para>
  <para style="q2" vid="JER 48:32">አን አኩመ የእዜሪፍ ቦኡ ሰነ ሲፍን ቦአ።</para>
  <para style="q1" vid="JER 48:32">ደሜንኬ ሀመ ገላናት ድሪርቴ ፈጋቴ፤</para>
  <para style="q2" vid="JER 48:32">እሼን ሀመ ገላነ የእዜርት ድሪርቴ ዴምት።</para>
  <para style="q1" vid="JER 48:32">በሌስቱን ሱን እጀኬ ብልቻታፊ</para>
  <para style="q2" vid="JER 48:32">ሁርቡ ወይኒኬቲረ ቡኤረ።<verse eid="JER 48:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="JER 48:33"/>ለፈ ብቅልቱቲፊ ለፈ ቆቲሳ</para>
  <para style="q2" vid="JER 48:33">ምዻን ሞኣብ ኬሳ እልሌፊ ገመቹን በዴረ።</para>
  <para style="q1" vid="JER 48:33">አን እዶ እት ወይኒ ጩንፈንራ ወይኒ ኩቴረ፤</para>
  <para style="q2" vid="JER 48:33">ነምን ቶኮዩ ገመዳ ስርቤ እሳን ህንጩንፉ።</para>
  <para style="q1" vid="JER 48:33">ወጭን ዮ ጅራቴሌ</para>
  <para style="q2" vid="JER 48:33">እን ወጨ ገመቹ ምት።<verse eid="JER 48:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="JER 48:34"/>“ሰበቢ ብሻን ኒምሪም ጎጌፍ፣</para>
  <para style="q2" vid="JER 48:34">ሰገሌን እየሳኒ ኦል ከኤ፣</para>
  <para style="q1" vid="JER 48:34">ሄሽቦኒ ሀመ ኤሌኣሌቲፊ ያሀዚት፣</para>
  <para style="q2" vid="JER 48:34">ዞኣሪ ሀመ ሆሮናይምቲፊ ሀመ ኤግላት ሼልሽያት <optbreak/> ንዸገአመ ቱሬ።<verse eid="JER 48:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="JER 48:35"/>አን ወረ እዶወን ሰገዳ ከኔን ጋረንራት</para>
  <para style="q2" vid="JER 48:35">ኣርሳ ዽኤሰኒ ዋቆተ እሳኒፍ እጣነ ኣርሰን</para>
  <para style="q2" vid="JER 48:35">ሞኣብ ኬሳ ነንበሌሰ” ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 48:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="JER 48:36"/>“ከናፉ ገራንኮ አኩመ ኡሉሌ ፋርሴ ሞኣቢፍ ቦአ፤</para>
  <para style="q2" vid="JER 48:36">አኩመ ኡሉሌ ፋርሴ ነሞተ ቂር ሀሬሼቲፍ ቦአ።</para>
  <para style="q2" vid="JER 48:36">ቀቤኝ እሳን ሆረተን ዱራ በዴረ።<verse eid="JER 48:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="JER 48:37"/>መታን ሁንድኑ ሃደሜ</para>
  <para style="q2" vid="JER 48:37">ሀሬድን ሁንድኑ ጭረሜረ፤</para>
  <para style="q1" vid="JER 48:37">ሀርክ ሁንድኑ ሙረሜ ሙዺን ሁንድስ</para>
  <para style="q2" vid="JER 48:37">ወያ ገዳቲን ህዸሜረ።<verse eid="JER 48:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="JER 48:38"/>ዋን አን አኩመ ኦኮቴ ነምን ቶኮዩ ህንፌኔት</para>
  <para style="q2" vid="JER 48:38">ሞኣብን ጨጨብሴፍ</para>
  <para style="q1" vid="JER 48:38">በንቲ መነ ሞኣብ ሁንደራፊ ኦብዲ ሰባ ኬሰ</para>
  <para style="q2" vid="JER 48:38">ቦእቸ መሌ ወን ቶኮዩ ህንጅሩ”</para>
  <para style="q2" vid="JER 48:38">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 48:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="JER 48:39"/>“እሼን አከም አከስ ጨጨብዴ! እሳን አከም አከስ ወዋቱ!</para>
  <para style="q2" vid="JER 48:39">ሞኣብ አከም አከስ ዱግደሼ ቃኒዻን ገረገልፈቴ!</para>
  <para style="q1" vid="JER 48:39">ሞኣብ ዋን ኮልፋ ታቴ፣</para>
  <para style="q2" vid="JER 48:39">ወረ ናኖሼ ጅራተን ሁንዳፍ ዋን ሶዳ ታቴርት።”<verse eid="JER 48:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JER 48:40"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 48:40">“እላ! ርሳን ቶኮ ሞኣብረት</para>
  <para style="q2" vid="JER 48:40">ቆቾ በልእሴ ፉርጉግፈማ ገድ ቡኣ ጅረ።<verse eid="JER 48:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="JER 48:41"/>ኬሪዮት ንቀበምት፤</para>
  <para style="q2" vid="JER 48:41">ደአኖንሼ ጀጀቦንስ ንፉዸተሙ።</para>
  <para style="q1" vid="JER 48:41">በረ ሰነ ኬሰ ገራን ሎልቶተ ሞኣብ</para>
  <para style="q2" vid="JER 48:41">አኩመ ገራ ዱበርቲ ጭኒንስፈቹት ጅርቱ ቶኮ ተአ።<verse eid="JER 48:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="JER 48:42"/>ሞኣብ ሰበቢ <char style="nd">ዋቀዮን</char> ቱፈቴፍ</para>
  <para style="q2" vid="JER 48:42">በርበዶፍቴ ሰበ ተኡንሼ ንሀፈ።<verse eid="JER 48:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="JER 48:43"/>ያ ሰበ ሞኣብ ሶዳን፣</para>
  <para style="q2" vid="JER 48:43">ቦሊፊ ክዮን ስ ኤገተ”</para>
  <para style="q2" vid="JER 48:43">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 48:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="JER 48:44"/>“ነምን ሶዳ ሰነ ዱራ በቀቱ</para>
  <para style="q2" vid="JER 48:44">ከምዩ ቦለ ኬሰ ቡአ፤</para>
  <para style="q1" vid="JER 48:44">ነምን ቦለ ሰነ ኬሳ ኦል በኡ</para>
  <para style="q2" vid="JER 48:44">ከምዩ ክዮዻን ቀበመ፤</para>
  <para style="q1" vid="JER 48:44">አን ሞኣብት</para>
  <para style="q2" vid="JER 48:44">ወጋ አደበሙሼ ነንፍዳቲ”</para>
  <para style="q2" vid="JER 48:44">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 48:44"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="45" style="v" sid="JER 48:45"/>“በቀቶትን ዋን ተአን ዸበኒ</para>
  <para style="q2" vid="JER 48:45">ጋድሰ ሄሽቦን ጀለ ዸዻበቱ፤</para>
  <para style="q1" vid="JER 48:45">ሄሽቦን ኬሳ እብድ ቶኮ፣</para>
  <para style="q2" vid="JER 48:45">ስሆን ግዱዻስ አረብን እብዳ ንከኣቲ፤</para>
  <para style="q1" vid="JER 48:45">እን አደ ሞኣብ ጉበ፣</para>
  <para style="q2" vid="JER 48:45">ቡቄ መታ ኦፍ ቱልቶታስ ንጉበ።<verse eid="JER 48:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="JER 48:46"/>ያ ሞኣብ ሲፍ ወዮ!</para>
  <para style="q2" vid="JER 48:46">ኡመትን ኬሞሽ በርበዳኤረ፤</para>
  <para style="q1" vid="JER 48:46">እልማንኬ ቦጅአመኒ ፉዸተመኒሩ፤</para>
  <para style="q2" vid="JER 48:46">እንተለንኬስ ቦጅአመኒሩ።<verse eid="JER 48:46"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="47" style="v" sid="JER 48:47"/>“ተኡሌ አን በረ ዹፉፍ ጅሩ ኬሰ</para>
  <para style="q2" vid="JER 48:47">ሀምባ ሞኣብ ዴብሴ ነንዻበ”</para>
  <para style="q2" vid="JER 48:47">ጄዸ <char style="nd">ዋቀዮ</char>።</para>
  <para style="p" vid="JER 48:47">ሙርቲን ሞኣብት ሙረሜ ሱን አስት ዹመ።<verse eid="JER 48:47"/></para>
  <chapter eid="JER 48"/>
  <chapter number="49" style="c" sid="JER 49"/>
  <para style="s1">ኤርጋ ዋኤ አሞን</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 49:1"/>ዋኤ አሞኖታ፦</para>
  <para style="b" vid="JER 49:1"/>
  <para style="p" vid="JER 49:1">
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 49:1">“እስራኤል እልማን ህንቀቡ?</para>
  <para style="q2" vid="JER 49:1">እን ነመ እሰ ዻሉ ህንቀቡ?</para>
  <para style="q1" vid="JER 49:1">ዮስ ሞሌክ ማሊፍ ጋድን ዸልቼሬ?</para>
  <para style="q2" vid="JER 49:1">ነሞትንሳ ማሊፍ መጋላሼ ኬሰ ጅራቱ?<verse eid="JER 49:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 49:2"/>ገሩ በር አን እት ረባ አሞኖታት</para>
  <para style="q1" vid="JER 49:2">ሰገሌ ወጨ ወራና ዸጌስሱ ቶኮ ንዹፈ”</para>
  <para style="q2" vid="JER 49:2">ጄዸ <char style="nd">ዋቀዮ</char>።</para>
  <para style="q1" vid="JER 49:2">“እሼን ቱላ በዲሳ ንታት፤</para>
  <para style="q2" vid="JER 49:2">ገንዶትን ናኖሼ ጅረንስ እብዳን ጉበሙ።</para>
  <para style="q1" vid="JER 49:2">ኤርገሲ እስራኤል ወረ እሼ አርኤ ባሴ ሰነ</para>
  <para style="q2" vid="JER 49:2">አሪቴ ብያ ንባፍት፣”</para>
  <para style="q2" vid="JER 49:2">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 49:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 49:3"/>“ያ ሄሽቦን ወዋዹ፣ ኣይ በርበዶፍቴርቲ!</para>
  <para style="q2" vid="JER 49:3">ያ ጅራቶተ ረባ እያ!</para>
  <para style="q1" vid="JER 49:3">ወያ ገዳ ኡፈዻቲ ቦኣ፤</para>
  <para style="q2" vid="JER 49:3">ደላ ኬሰ አሲፊ አች ፊጋ፤</para>
  <para style="q1" vid="JER 49:3">ሞሌክ ሉቦታፊ ቆንዳልቶተሳ ወጅን</para>
  <para style="q2" vid="JER 49:3">ቦጅአሜ ንፉዸተማቲ።<verse eid="JER 49:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 49:4"/>አት ማሊፍ ሱሉለኬቲን ቦንተ?</para>
  <para style="q2" vid="JER 49:4">ማሊፍ ሱሉለኬ ገበታ ሰናን ቦንተ?</para>
  <para style="q1" vid="JER 49:4">ያ እንተለ ህንአመነምኔ አት ሶሩመኬ አብደቴ፣</para>
  <para style="q2" vid="JER 49:4">‘ኤኙቱ ነ ቱቀ?’ ጄተ።<verse eid="JER 49:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 49:5"/>አን ወረ ናኖኬ ጅራተን ሁንደራ</para>
  <para style="q2" vid="JER 49:5">ሶዳ ስት ነንፍደ”</para>
  <para style="q2" vid="JER 49:5">ጄዸ ጎፍታን፣ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ።</para>
  <para style="q1" vid="JER 49:5">“ቶኮን ቶኮንኬሰን ንአርአምቱ፤</para>
  <para style="q2" vid="JER 49:5">ነምን በቀቶተ ወልት ቀቡ ቶኮዩ ህንጅሩ።<verse eid="JER 49:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="JER 49:6"/>“ተኡሌ አን ኤርገሲ ሀምባወን አሞኖታ ዴብሴ ነንዻበ”</para>
  <para style="q2" vid="JER 49:6">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 49:6"/></para>
  <para style="s1">ኤርጋ ዋኤ ኤዶም</para>
  <para style="r">
    <ref loc="JER 49:9-10">49፥9‑10</ref> ኩወፈ – <char style="xt"><ref loc="OBA 1:5-6">አብድ 5–6</ref></char></para>
  <para style="r">
    <ref loc="JER 49:14-16">49፥14‑16</ref> ኩወፈ – <char style="xt"><ref loc="OBA 1:1-4">አብድ 1–4</ref></char></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 49:7"/>ዋኤ ኤዶም፦</para>
  <para style="b" vid="JER 49:7"/>
  <para style="p" vid="JER 49:7">
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 49:7">“ስአች ቴማን ኬሰ ኦጉማን ህንጅሩ?</para>
  <para style="q2" vid="JER 49:7">ሁበቶተ ዱራ ጎርስ በዴራ?</para>
  <para style="q2" vid="JER 49:7">ኦጉማንሳኒ ሰሜራ?<verse eid="JER 49:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 49:8"/>ወር ዴዳን ኬሰ ጅራተን ገረገላ፣</para>
  <para style="q2" vid="JER 49:8">በቀዻቲ ሆልቀ ገድ ፈጎ ኬሰ ዾከዻ፤</para>
  <para style="q1" vid="JER 49:8">አን ዬሮ ኤሳዉን አደቡት</para>
  <para style="q2" vid="JER 49:8">በዲሰ እሰት ነንፍዳቲ።<verse eid="JER 49:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 49:9"/>ወር ጉማ ወይኒ ጉረን ኡቱ ገረኬ ዹፈኒ ስላ</para>
  <para style="q2" vid="JER 49:9">ቀርሚ ወዪ ህንሀምብሰኒ?</para>
  <para style="q1" vid="JER 49:9">ሀቱን ዮ ሀልከን ዹፍቴ፣</para>
  <para style="q2" vid="JER 49:9">እሳን ሀሙመ በርባደን ቆፈ ፉዸተኒ ህንዴመኒ?<verse eid="JER 49:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 49:10"/>አን ገሩ ኤሳዉን ቁላ ነንሀምብሰ፤</para>
  <para style="q2" vid="JER 49:10">አከ እን እት ህንደአኔፍ</para>
  <para style="q2" vid="JER 49:10">አን እዶ እን እት ዾከቱ እፈት ነንባሰ።</para>
  <para style="q1" vid="JER 49:10">እጆሌንሳ፣ ፍሮንሳቲፊ ኦሎንሳ ንበዱ፤</para>
  <para style="q2" vid="JER 49:10">እንስ ስአች ህንጅራቱ።<verse eid="JER 49:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 49:11"/>‘ዳእመንኬ ከኔን ወረ ህንቀብኔ ዺስ፤ <optbreak/> አነቱ እሳን ጅራችሳቲ።</para>
  <para style="q2" vid="JER 49:11">ሃዾትን ህዬሳኬ ነ አመነቹ ደንደኡ።’ ”<verse eid="JER 49:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 49:12"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ “ዮ ወር ጦፎ ዹጉን እሳኒፍ ህንመልን እሼ ዹጉ ቀባተን፣ አት ማሊፍ ኡቱ ህንአደበምን ሀፍተሬ? አት እሼ ዹጉ ቀብደ መሌ ኡቱ ህንአደበምን ህንሀፍቱ። <verse eid="JER 49:12"/><verse number="13" style="v" sid="JER 49:13"/>አን አከ ቦዝራን ዲገምቴ ዋን ሶዳ፣ ዋን ፈፋቲፊ ዋን አባርሳ ታቱ መቃኮቲን ነንከከዸ” ጄዸ <char style="nd">ዋቀዮ</char>። “መጋላወንሼ ሁንድስ በረ በራን ንዲገሙ።”<verse eid="JER 49:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 49:14"/>አን ኤርጋ ቶኮ <char style="nd">ዋቀዮ</char>ራ ዸገኤረ፦</para>
  <para style="q2" vid="JER 49:14">ኤርገማን ቶኮ አከነ ጄቹፍ ገረ ሰቦታት ኤርገሜ፤</para>
  <para style="q1" vid="JER 49:14">“እሼ ሎሉፍ ወልት ቀበማ!</para>
  <para style="q2" vid="JER 49:14">ወራናፍስ በኣ!”<verse eid="JER 49:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JER 49:15"/>“አን አመ ሰቦተ ግዱት ስን ጥኔሰ፤</para>
  <para style="q2" vid="JER 49:15">ነሞተ ኬሰትሌ ቱፈተማ ስን ጎዸ።<verse eid="JER 49:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 49:16"/>አት ከን ሀለያ ከታረ ጅራቴ</para>
  <para style="q2" vid="JER 49:16">ፊጤ ቱሉ ቀበቴ ጅርቱ፣</para>
  <para style="q1" vid="JER 49:16">ሶዳን አት ኦዴስቱፊ</para>
  <para style="q2" vid="JER 49:16">ኦፍ ቱሉማን ገራኬቲ ስ ጎዎምሴረ።</para>
  <para style="q1" vid="JER 49:16">ዮ አት አኩመ ርሳ ኦል ፈጌስቴ</para>
  <para style="q2" vid="JER 49:16">መነ እጃረቱዩ አን አቺ ገድ ስን ቡሰ”</para>
  <para style="q2" vid="JER 49:16">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 49:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 49:17"/>“ኤዶም ዋን ሶዳ ታት፤</para>
  <para style="q2" vid="JER 49:17">ነምን አቺን ደርቡ ሁንድስ ሰበቢ መዳሼ ሁንዳቲፍ</para>
  <para style="q2" vid="JER 49:17">ድንቅሲፈቴ እሼት ኮልፈ።<verse eid="JER 49:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 49:18"/>እሼን አኩመ ሶዶሚፊ ጎሞራን</para>
  <para style="q2" vid="JER 49:18">መጋላወን ናኖሳኒ ጅረን ወጅን በሌፈመን ሰነ ንታት”</para>
  <para style="q2" vid="JER 49:18">ጄዸ <char style="nd">ዋቀዮ</char>፣</para>
  <para style="q1" vid="JER 49:18">“ነምን ቶኮዩ አች ህንጅራቱ፣</para>
  <para style="q2" vid="JER 49:18">ሰኚን ነማ ቶኮስ እሼ ኬሰ ህንቁበቱ።<verse eid="JER 49:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="JER 49:19"/>“አን አኩመ ሌንጨ ቦሶነ ዮርዳኖሲ በኤ</para>
  <para style="q2" vid="JER 49:19">ገረ ለፈ ዼዳ ገበታ ዹፉ ቶኮ</para>
  <para style="q1" vid="JER 49:19">ደፌ ኤዶምን ብየሼቲ ነንአርአ።</para>
  <para style="q2" vid="JER 49:19">ፍለተማን አን ዋን ከናፍ ሙዱ ኤኙ?</para>
  <para style="q1" vid="JER 49:19">ከን አከኮ ኤኙ? ኤኙቱስ ናን ሞርኩ ደንደአ?</para>
  <para style="q2" vid="JER 49:19">ትክሴ አከሚቱ ፉለኮ ዱረ ዻበቹ ደንደአ?”<verse eid="JER 49:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JER 49:20"/>ከናፉ ዋን <char style="nd">ዋቀዮ</char> ኤዶምት ከሮርፈቴ፣</para>
  <para style="q2" vid="JER 49:20">ዋን እን ወረ ቴማን ኬሰ ጅራተንት ያዴስ ዸገኣ።</para>
  <para style="q1" vid="JER 49:20">እልማን ቡሻዬ ሀርክፈመኒ ንፉዸተሙ፤</para>
  <para style="q2" vid="JER 49:20">እንስ ሰበቢሳኒቲፍ ጄዼ ለፈ ዼደሳኒ ንበርበዴሰ።<verse eid="JER 49:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 49:21"/>ሰገሌ ኩፋቲሳኒቲን ለፍት ንራፈምት፤</para>
  <para style="q2" vid="JER 49:21">እይሳኒ ሀመ ገላነ ዲማት ንዸገአመ።<verse eid="JER 49:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 49:22"/>እላ! ርሳን ቶኮ ቦዝራረት ቆቾ በልእሴ</para>
  <para style="q2" vid="JER 49:22">ፉርጉግፈማ ገድ ቡኣ ጅረ።</para>
  <para style="q1" vid="JER 49:22">በረ ሰነ ኬሰ ገራን ሎልቶተ ኤዶም</para>
  <para style="q2" vid="JER 49:22">አኩመ ገራ ዱበርቲ ጭኒንስፈቹት ጅርቱ ቶኮ ተአ።<verse eid="JER 49:22"/></para>
  <para style="s1">ኤርጋ ዋኤ ደማስቆ</para>
  <para style="p">
    <verse number="23" style="v" sid="JER 49:23"/>ዋኤ ደማስቆ፦</para>
  <para style="q1" vid="JER 49:23">“ሀማቲፊ አርፋድ ንራፈሙ፤</para>
  <para style="q2" vid="JER 49:23">እሳን ኦዱ ሀማ ዸገአኒሩቲ።</para>
  <para style="q1" vid="JER 49:23">እሳን አብዲ ኩተተኒ አኩመ ገላነ ቦቆና</para>
  <para style="q2" vid="JER 49:23">ህንቀብኔ ቶኮ ጄቀመኒሩ።<verse eid="JER 49:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 49:24"/>ደማስቆን ደዸብዴርት፤</para>
  <para style="q2" vid="JER 49:24">እሼን በቀቹፍ ገረ ገልቴርት፤</para>
  <para style="q2" vid="JER 49:24">ሶዳን ጉዳን እሼ ቀበቴረ፤</para>
  <para style="q1" vid="JER 49:24">አኩመ ሚጡ ዱበርቲ ጭኒንስፈቱ፣</para>
  <para style="q2" vid="JER 49:24">ረክናፊ ሚጡን እሰ ቀቤረ።<verse eid="JER 49:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 49:25"/>መጋላን ቤከማን፣</para>
  <para style="q2" vid="JER 49:25">መጋላን አን እት ገመዱ ሱን አከም ገተምት!<verse eid="JER 49:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JER 49:26"/>ዹጉማን ደርገጎንሼ ከራረት ዹሙ፤</para>
  <para style="q2" vid="JER 49:26">ሎልቶትንሼ ሁንድኑ ጋፈስ አፋን ቀበቱ”</para>
  <para style="q2" vid="JER 49:26">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 49:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 49:27"/>“አን ደላወን ደማስቆት እብደ ነንቀብሲሰ፤</para>
  <para style="q2" vid="JER 49:27">እብድ ሱንስ ደአትኖ ቤን-ሀዳድ ጉቤ በሌሰ።”<verse eid="JER 49:27"/></para>
  <para style="s1">ኤርጋ ዋኤ ቄዳሪቲፊ ሃዞር</para>
  <para style="p">
    <verse number="28" style="v" sid="JER 49:28"/>ዋኤ ቄዳሪቲፊ ዋኤ ሞቱሞተ ሃዞር ከኔን ኔቡከድኔዘር ሞቲን ባብሎን ሎሌ ሰና፦</para>
  <para style="b" vid="JER 49:28"/>
  <para style="p" vid="JER 49:28">
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 49:28">“ከኣ፣ ቄዳርን ሎላቲ</para>
  <para style="q2" vid="JER 49:28">ሰበ ገመ በአ ቢፍቱ በርበዴሳ።<verse eid="JER 49:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JER 49:29"/>ዱንካኖትንሳኒቲፊ ቡሻዬንሳኒ ንፉዸተሙ፤</para>
  <para style="q2" vid="JER 49:29">ጎልጋወንሳኒ ምኣፊ</para>
  <para style="q2" vid="JER 49:29">ጋለወንሳኒ ወጅን ፉዸተሙ።</para>
  <para style="q1" vid="JER 49:29">ነሞትንስ፣ ‘ገመ ሁንዳን ሶዳቱ ጅረ!’</para>
  <para style="q2" vid="JER 49:29">ጄዸኒ እዩ።<verse eid="JER 49:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="JER 49:30"/>“እስን ወር ሃዞር ኬሰ ጅራተን ደፋ በቀዻ!</para>
  <para style="q2" vid="JER 49:30">ሆልቀ ገድ ፈጎ ኬሰ ዾከዻ”</para>
  <para style="q2" vid="JER 49:30">ጄዸ <char style="nd">ዋቀዮ</char>።</para>
  <para style="q1" vid="JER 49:30">“ኔቡከድኔዘር ሞቲን ባብሎን እስንት መለቴረ፤</para>
  <para style="q2" vid="JER 49:30">እን ደበ እስንት ያዴረ።<verse eid="JER 49:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="JER 49:31"/>“ከኣቲ ሰበ ነጋ ቀቡ ከን ኦፍ አመነቴ ጅራቱ</para>
  <para style="q2" vid="JER 49:31">ሰበ ከረ ዮካን ደንቀራ ከራ ህንቀብኔ ሰነት ዱላ፤</para>
  <para style="q1" vid="JER 49:31">ኡመትንሳ ኮጱመ ኦፊሳ ጅራተ”</para>
  <para style="q2" vid="JER 49:31">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 49:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JER 49:32"/>“ጋለወንሳኒ ንሀተሙ፣</para>
  <para style="q2" vid="JER 49:32">ሆሪንሳኒ ባይኤንስ ንቦጅአመ።</para>
  <para style="q1" vid="JER 49:32">አን ወረ ለፈ ፈጎ ጅረን ቅሌንሰት ብትኔሴ</para>
  <para style="q2" vid="JER 49:32">ገመ ሁንዳን በላ እሳንት ነንፍደ”</para>
  <para style="q2" vid="JER 49:32">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 49:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="JER 49:33"/>“ሃዞር እዶ ጅሬኛ ዋንጎ፣</para>
  <para style="q2" vid="JER 49:33">ለፈ በረ በራን ኦንቴ ታት።</para>
  <para style="q1" vid="JER 49:33">ነምን ቶኮዩ አች ህንጅራቱ፤</para>
  <para style="q2" vid="JER 49:33">ነምን ቶኮዩ እሼ ኬሰ ህንቁበቱ።”<verse eid="JER 49:33"/></para>
  <para style="s1">ኤርጋ ዋኤ ኤላም</para>
  <para style="p">
    <verse number="34" style="v" sid="JER 49:34"/>ጀልቀበ በረ ሞቱማ ዜዴቅያ ሞትቸ ይሁዳ ኬሰ ዱቢን <char style="nd">ዋቀዮ</char> ዋኤ ኤላም አከነ ጄዼ ገረ ኤርምያስ ራጅቻ ዹፌ፦<verse eid="JER 49:34"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="35" style="v" sid="JER 49:35"/>
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 49:35">“ኩኖ አን መደ ጀብነሳኒ፣</para>
  <para style="q2" vid="JER 49:35">እዳ ኤላም ነንጨብሰ።<verse eid="JER 49:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="JER 49:36"/>አን ኩታሌ ሰሚወኒ አፍረንራ</para>
  <para style="q2" vid="JER 49:36">ቡቤ አፍረን ኤላምተን ፍደ፤</para>
  <para style="q1" vid="JER 49:36">አን ቡቤ አፍረንት እሳን ነንብትኔሰ፤</para>
  <para style="q2" vid="JER 49:36">ሰብን በቀቶትን ኤላም</para>
  <para style="q2" vid="JER 49:36">እት ህንገሌ ቶኮዩ ህንጅራቱ።<verse eid="JER 49:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="JER 49:37"/>አን ፉለ ዲኖተሳኒ፣</para>
  <para style="q2" vid="JER 49:37">ፉለ ወረ ሉቡሳኒ ገላፈቹ በርባደኒ ዱረት <optbreak/> ኤላምን ነንበርበዴሰ፤</para>
  <para style="q1" vid="JER 49:37">አን በላ እሳንተን ፍደ፤</para>
  <para style="q2" vid="JER 49:37">ዼከምሰኮ ሶዳችሳ ሰነስ እሳንተን ፍደ፤</para>
  <para style="q1" vid="JER 49:37">አን ሀመ እሳን ፍጡት ጎራዴዻን እሳን አርአ”</para>
  <para style="q2" vid="JER 49:37">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 49:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="JER 49:38"/>“አን ቴሶኮ ኤላም ኬሰ ዻበዼ</para>
  <para style="q2" vid="JER 49:38">ሞቲፊ ቆንዳልቶተሼ ነንበርበዴሰ”</para>
  <para style="q2" vid="JER 49:38">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 49:38"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="39" style="v" sid="JER 49:39"/>“ተኡሌ አን በረ ዹፉፍ ጅሩ ኬሰ</para>
  <para style="q2" vid="JER 49:39">ሀምባ ኤላም ዴብሴ ነንዻበ”</para>
  <para style="q2" vid="JER 49:39">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 49:39"/></para>
  <chapter eid="JER 49"/>
  <chapter number="50" style="c" sid="JER 50"/>
  <para style="s1">ኤርጋ ዋኤ ባብሎን</para>
  <para style="r">
    <ref loc="JER 51:15-19">51፥15‑19</ref> ኩወፈ – <char style="xt"><ref loc="JER 10:12-16">ኤር 10፥12‑16</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="JER 50:1"/>ዱቢን <char style="nd">ዋቀዮ</char> ከራ ኤርምያስ ራጅቻቲን ዋኤ ባብሎኒፊ ዋኤ ብየ ባብሎኖታ ዱበቴ ከናዸ፦<verse eid="JER 50:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 50:2"/>“ሰቦተ ግዱት ለለባቲ ለብሳ፤</para>
  <para style="q2" vid="JER 50:2">ፋጂ ኦል ቀባቲ ለብሳ፤</para>
  <para style="q2" vid="JER 50:2">ኡቱ ሆማ ህንሀምብስን አከነ ጄዻ፤</para>
  <para style="q1" vid="JER 50:2">‘ባብሎን ንቀበምት፤</para>
  <para style="q2" vid="JER 50:2">ቤል ንሰልጵፈመ፤</para>
  <para style="q2" vid="JER 50:2">ሜሮደክ ጎሊዻን ጉተመ።</para>
  <para style="q1" vid="JER 50:2">ፈኪወን ባብሎን ንሰልጵፈሙ፤</para>
  <para style="q2" vid="JER 50:2">ዋቆንሼ ቶልፈሞንስ ሶዳን ጉተሙ።’<verse eid="JER 50:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 50:3"/>ሰብን ካባ ዹፉ ቶኮ እሼ ሎሌ</para>
  <para style="q2" vid="JER 50:3">ለፈሼ ዱዋ ሀምብሰ።</para>
  <para style="q1" vid="JER 50:3">ነምን ቶኮዩ እሼ ኬሰ ህንጅራቱ፤</para>
  <para style="q2" vid="JER 50:3">ነማፊ ሆሪን በቀቴ ኬሳ በአ።<verse eid="JER 50:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="JER 50:4"/>“በረ ሰነ ኬሰ፣ ዬሮ ሰነት፣</para>
  <para style="q1" vid="JER 50:4">ሰብን እስራኤሊፊ ሰብን ይሁዳ</para>
  <para style="q2" vid="JER 50:4">እምማኒን <char style="nd">ዋቀዮ</char> ዋቀሳኒ በርባቸ</para>
  <para style="q2" vid="JER 50:4">ቶኩማዻን ንዹፉ” ጄዸ <char style="nd">ዋቀዮ</char>፤<verse eid="JER 50:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 50:5"/>“እሳን ከራ ገረ ጥዮን ጌሱ ንጋፈቱ፤</para>
  <para style="q2" vid="JER 50:5">ፉለሳኒስ ገረስት ገረገልፈቱ።</para>
  <para style="q1" vid="JER 50:5">እሳን ዹፈኒ ከኩ በረ በራ</para>
  <para style="q2" vid="JER 50:5">ከን ጎንኩማ ህንእራንፈተምኔን</para>
  <para style="q2" vid="JER 50:5">
    <char style="nd">ዋቀዮት</char> ኦፍ መጠንሱ።<verse eid="JER 50:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="JER 50:6"/>“ሰብንኮ ሆሎተ በደን ተአኒሩ፤</para>
  <para style="q2" vid="JER 50:6">ትክሴንሳኒ እሳን ዶጎጎርሴ</para>
  <para style="q2" vid="JER 50:6">አከ እሳን ቱሉወንረ ጆረን ጎዼ።</para>
  <para style="q1" vid="JER 50:6">እሳን ቱሉፊ ጋረረ ጆረኒ</para>
  <para style="q2" vid="JER 50:6">ለፈ ቦቆናሳኒሌ ወላለን።<verse eid="JER 50:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 50:7"/>ከን እሳን አርጉ ሁንድ እሳን ልቅምሴ፤</para>
  <para style="q2" vid="JER 50:7">ዲኖትንሳኒስ፣ ‘ኑ በሌሳ ህንቀብኑ፤</para>
  <para style="q1" vid="JER 50:7">እሳን <char style="nd">ዋቀዮ</char> እዶ ጅሬኘሳኒ ከን ዹጋ ተኤ፣</para>
  <para style="q2" vid="JER 50:7">
    <char style="nd">ዋቀዮ</char> አብዲ አቦቲሳኒት ጩቡ ሆጄተኒሩቲ’ ጄዸን።<verse eid="JER 50:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JER 50:8"/>“ባብሎኒ በቀዻ በኣ፤</para>
  <para style="q2" vid="JER 50:8">ብየ ባብሎኖታ ኬሳ በኣ፤</para>
  <para style="q2" vid="JER 50:8">አኩመ ኮርቤሰ ሬኤ ከን ቡሻዬ ቀጄልቹ ተኣ።<verse eid="JER 50:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 50:9"/>አን ብየ ካባቲ ገሬ ሰቦተ ጉርጉዳ ካሴ</para>
  <para style="q2" vid="JER 50:9">ባብሎንት ነንኤርጋቲ።</para>
  <para style="q1" vid="JER 50:9">እሳንስ ህሪረኒ እሼት ዹፉ፤</para>
  <para style="q2" vid="JER 50:9">እሼንስ ከራ ካባቲን ንቀበምት።</para>
  <para style="q1" vid="JER 50:9">ጥይሳኒ አኩመ ሎልቶተ ኦጌዪ</para>
  <para style="q2" vid="JER 50:9">ሀርከ ዱዋ ህንዴብኔት።<verse eid="JER 50:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 50:10"/>ባብሎንስ ንሳመምት፤</para>
  <para style="q2" vid="JER 50:10">ወር እሼ ሳመን ሁንድስ ንቁፉ”</para>
  <para style="q2" vid="JER 50:10">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 50:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="JER 50:11"/>“እስን ወር ሀንዹራኮ ሳምተን</para>
  <para style="q2" vid="JER 50:11">ዋን ገመደኒፊ እልልችተኒፍ፣</para>
  <para style="q1" vid="JER 50:11">አኩመ ራዳ መርገ ኬሳ ቡራቅጠኒ</para>
  <para style="q2" vid="JER 50:11">አከ ኮርመ ፈርዳ እምምስተንሌ፣<verse eid="JER 50:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 50:12"/>ሃትኬሰን አከ መሌ ቃኖፍት፤</para>
  <para style="q2" vid="JER 50:12">ከን እስን ዴሴስ ንሰልጰት።</para>
  <para style="q1" vid="JER 50:12">እሼን ሰቦተ ሁንደ ኬሳ ገድ ኣንቱ፣</para>
  <para style="q2" vid="JER 50:12">ለፈ ኦና፣ ለፈ ጎጋፊ ገሞጂ ታት።<verse eid="JER 50:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 50:13"/>እሼን ሰበቢ ዼከምሰ <char style="nd">ዋቀዮቲፍ</char> ጉቱማን ጉቱት</para>
  <para style="q2" vid="JER 50:13">ንኦንት መሌ ነምን እሼ ኬሰ ህንጅራቱ።</para>
  <para style="q1" vid="JER 50:13">ሰበቢ መዳሼ ሁንዳቲፍ</para>
  <para style="q2" vid="JER 50:13">ነምን ባብሎን ኬሰ ደርቡ ሁንድ ንድንቅሲፈተ፤ እት ቆሰስ።<verse eid="JER 50:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="JER 50:14"/>“እስን ወር እዳ ሉቅፈተን ሁንድኑ፣</para>
  <para style="q2" vid="JER 50:14">ናኖ ባብሎንት ህሪራ።</para>
  <para style="q1" vid="JER 50:14">ሰበቢ እሼን <char style="nd">ዋቀዮት</char> ጩቡ ሆጄቴፍ፣</para>
  <para style="q2" vid="JER 50:14">ጥየወን እት ደርበዻ! ሆማ ህንሀምብስና።<verse eid="JER 50:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 50:15"/>ከራ ሁንዳን እሼት እያ!</para>
  <para style="q2" vid="JER 50:15">እሼን ሀርከኬነት፤ ገሞንሼ ንጅገ፤</para>
  <para style="q2" vid="JER 50:15">ደላንሼ ዲገሜረ።</para>
  <para style="q1" vid="JER 50:15">ኩን ሃሎ <char style="nd">ዋቀዮ</char> ዋን ተኤፍ</para>
  <para style="q2" vid="JER 50:15">እሼት ሃሎ በኣ፤</para>
  <para style="q2" vid="JER 50:15">ዋኑመ እሼን ወረ ካንት ሆጄቴ እሼት ሆጄዻ።<verse eid="JER 50:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 50:16"/>ነመ ሰኚ ፈጫሱፊ ከን ዬሮ ምዻን ሃመሙት</para>
  <para style="q2" vid="JER 50:16">ሃምቱ ቀበቱስ ባብሎን ኬሳ በሌሳ።</para>
  <para style="q1" vid="JER 50:16">ሰበቢ ጎራዴ ጩንቁርሳቲን</para>
  <para style="q2" vid="JER 50:16">ቶኮን ቶኮን ነማ ገረ ሰበ ኦፊሳት ሃዴብኡ፤</para>
  <para style="q2" vid="JER 50:16">ቶኮን ቶኮን ነማ ገረ ብየ ኦፊ እሳትስ ሃበቀቱ።<verse eid="JER 50:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="JER 50:17"/>“እስራኤል ሆላ ብትናኤዸ፤</para>
  <para style="q2" vid="JER 50:17">ሌንጮትን እሰ አርአን።</para>
  <para style="q1" vid="JER 50:17">ከን ጀልቀበት እሰ ኛቴ ሞቲ አሶር፤</para>
  <para style="q2" vid="JER 50:17">ከን ዹመረት ለፌሳ ጨጨብሴሞ</para>
  <para style="q2" vid="JER 50:17">ኔቡከድኔዘር ሞትቸ ባብሎን ቱሬ።”<verse eid="JER 50:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 50:18"/>ከናፉ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 50:18">“አን አኩመ ሞቲ አሶር አደቤ ሰነ</para>
  <para style="q2" vid="JER 50:18">ሞቲ ባብሎኒፊ ብየሳ ነንአደበ።<verse eid="JER 50:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 50:19"/>እስራኤልን ገሩ ለፈ ትከሳት ነንዴብሰ፤</para>
  <para style="q2" vid="JER 50:19">እንስ ቀርሜሎሲፊ ባሻንረ ንዼደ፤</para>
  <para style="q2" vid="JER 50:19">ቱሉ ኤፍሬሚፊ ግልኣድራ ዼዴ ንቁፈ።<verse eid="JER 50:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 50:20"/>በረ ሰነ ኬሰ፣ ዬሮ ሰነት፣</para>
  <para style="q2" vid="JER 50:20">የክ እስራኤል ንበርባደመ” ጄዸ <char style="nd">ዋቀዮ</char>፤</para>
  <para style="q1" vid="JER 50:20">“ገሩ ቶኮዩ ህንጅሩ፤</para>
  <para style="q2" vid="JER 50:20">ጩቡን ይሁዳስ ንበርባደመ፤</para>
  <para style="q1" vid="JER 50:20">ገሩ ቶኮዩ ህንአርገሙ፤</para>
  <para style="q2" vid="JER 50:20">አን ሀምባን በራሬ ሰናፍ</para>
  <para style="q2" vid="JER 50:20">ዺፈመ ነንጎዻቲ።<verse eid="JER 50:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="JER 50:21"/>“ብየ ሜራታይሚፊ</para>
  <para style="q2" vid="JER 50:21">ጅራቶተ ጴቆድ ሎላ።</para>
  <para style="q1" vid="JER 50:21">አርኣ፣ አጄሳ፣ ጉቱማን ጉቱት እሳን በሌሳ፣”</para>
  <para style="q2" vid="JER 50:21">ጄዸ <char style="nd">ዋቀዮ</char>።</para>
  <para style="q2" vid="JER 50:21">“ዋን አን እስን አጀጄ ሁንደ ጎዻ።<verse eid="JER 50:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 50:22"/>ሰገሌን ወራና፣</para>
  <para style="q2" vid="JER 50:22">ሰገሌን በዲሰ ጉዳስ ብየ ሰነ ኬሰ ጅረ!<verse eid="JER 50:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 50:23"/>ቡሩስን ጉቱማ ለፋ አከምት ጨቤ!</para>
  <para style="q2" vid="JER 50:23">አከምትስ ቡላኤ!</para>
  <para style="q1" vid="JER 50:23">ባብሎን ሰቦተ ግዱት፣</para>
  <para style="q2" vid="JER 50:23">አከም ኦንቴ!<verse eid="JER 50:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 50:24"/>ያ ባብሎን፣ አን ክዮ ሲፍ ድሪርሴረ፤</para>
  <para style="q2" vid="JER 50:24">አትስ ኡቱ ህንቤክን ቀበምቴ፤</para>
  <para style="q1" vid="JER 50:24">አት ሰበቢ <char style="nd">ዋቀዮን</char> ሞርምቴፍ፣</para>
  <para style="q2" vid="JER 50:24">አርገምቴ ቀበምቴ።<verse eid="JER 50:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 50:25"/>
    <char style="nd">ዋቀዮ</char> መንኩሳ ምአ ሎላሳ በኔ</para>
  <para style="q2" vid="JER 50:25">ምአ ሎለ ዼከምሰሳ ገድ ባፈቴረ፤</para>
  <para style="q1" vid="JER 50:25">ጎፍታን፣ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ</para>
  <para style="q2" vid="JER 50:25">ዋን ብየ ባብሎኖታት ሆጄቱ ቀባቲ።<verse eid="JER 50:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JER 50:26"/>ብየ ፈጎቲ እሼት ኮታ።</para>
  <para style="q2" vid="JER 50:26">ጎምብሳወንሼ ዲጋ፤</para>
  <para style="q2" vid="JER 50:26">አኩመ ቱላ ምዻኒት እሼ ቱላ።</para>
  <para style="q1" vid="JER 50:26">ጉቱማን ጉቱት እሼ በሌሳ፤</para>
  <para style="q2" vid="JER 50:26">ዋን ቶኮሌ እሼፍ ህንሀምብስና።<verse eid="JER 50:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 50:27"/>ኮሮሚሼ ሁንደ ቀላ፤</para>
  <para style="q2" vid="JER 50:27">እሳን ገረ ቀልማት ሃጌፈመን!</para>
  <para style="q1" vid="JER 50:27">እሳኒፍ ወዮ! ዬሮን እሳን እት አደበመን፣</para>
  <para style="q2" vid="JER 50:27">ጉያንሳኒ ዹፌራቲ።<verse eid="JER 50:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 50:28"/>አከ <char style="nd">ዋቀዮ</char> ዋቅንኬኘ ሃሎ በኤ፣</para>
  <para style="q2" vid="JER 50:28">አከ እን መነ ቁልቁሉማሳቲፍ ሃሎ በኤ፣</para>
  <para style="q1" vid="JER 50:28">ኮሉ ገልቶታፊ በቀቶተ ባብሎኒ ዹፈኒ</para>
  <para style="q2" vid="JER 50:28">ጥዮን ኬሰት ለለበንራ ዸገኣ።<verse eid="JER 50:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="JER 50:29"/>“ነሞተ ጥያን ሎለን</para>
  <para style="q2" vid="JER 50:29">ከኔን እዳ ሉቅፈተን ሁንደ ባብሎንት ዋማ።</para>
  <para style="q1" vid="JER 50:29">ናኖሼ ሁንደ መርሳ፤</para>
  <para style="q2" vid="JER 50:29">ነምን ቶኮዩ ህንምልቅን።</para>
  <para style="q1" vid="JER 50:29">ገቲ ሆጂሼ ኬናፊ፤</para>
  <para style="q2" vid="JER 50:29">ዋኑመ እሼን ወረ ካንት ሆጄቴ እሼትስ ሆጄዻ።</para>
  <para style="q1" vid="JER 50:29">እሼን ቁልቁልቸ እስራኤል፣</para>
  <para style="q2" vid="JER 50:29">
    <char style="nd">ዋቀዮት</char> ኮርቴርቲ።<verse eid="JER 50:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 50:30"/>ከናፉ ደርገጎንሼ ከራረት ዹሙ፤</para>
  <para style="q2" vid="JER 50:30">ጋፈስ ሎልቶትንሼ ሁንድ ንበርበዳኡ”</para>
  <para style="q2" vid="JER 50:30">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 50:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JER 50:31"/>“ያ ኮርቱነነ፣ ኩኖ አን ስት ከኤረ”</para>
  <para style="q2" vid="JER 50:31">ጄዸ ጎፍታን፣ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፤</para>
  <para style="q1" vid="JER 50:31">“ዬሮን አት እት አደበምቱ፣</para>
  <para style="q2" vid="JER 50:31">ጉያንኬ ዹፌራቲ።<verse eid="JER 50:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JER 50:32"/>ኮርቱን ሱን ጉፈቴ ለፈ ዾፍት፤</para>
  <para style="q2" vid="JER 50:32">ነምን ገርጋሬ ኦል እሼ ቀቡ ቶኮዩ ህንጅሩ፤</para>
  <para style="q1" vid="JER 50:32">አን መጋላወንሼ ኬሰት</para>
  <para style="q2" vid="JER 50:32">እብደ ወረ ናኖሼ ጅሩ ሁንደ <optbreak/> ጉቤ ፍጡ ነንቀብሲሰ።”<verse eid="JER 50:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JER 50:33"/>
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 50:33">“ሰብን እስራኤል ጩንቁርፈሜረ፤</para>
  <para style="q2" vid="JER 50:33">ሰብን ይሁዳስ አከሱመ ጩንቁርፈሜረ።</para>
  <para style="q1" vid="JER 50:33">ወር እሳን ቦጅአን ሁንድ ጀቤሰኒ እሳን ቀበተኒሩ፤</para>
  <para style="q2" vid="JER 50:33">እሳን ገድ ዺሱስ ድደኒሩ።<verse eid="JER 50:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="JER 50:34"/>ተኡሌ ፉራንሳኒ ጀባዸ፤</para>
  <para style="q2" vid="JER 50:34">መቃንሳስ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡዸ።</para>
  <para style="q1" vid="JER 50:34">እን ብየሳኒቲፍ ቦቆና ኬኔ፤</para>
  <para style="q2" vid="JER 50:34">ወረ ባብሎን ኬሰ ጅራተን ገሩ ቦቆና ዾዉፍ</para>
  <para style="q2" vid="JER 50:34">ዽመሳኒቲፍ ጀቤሴ ንፈልመ።<verse eid="JER 50:34"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="35" style="v" sid="JER 50:35"/>“ጎራዴን ቶኮ ባብሎኖተት ዹፌ!”</para>
  <para style="q2" vid="JER 50:35">ጄዸ <char style="nd">ዋቀዮ</char>፤</para>
  <para style="q1" vid="JER 50:35">“ወረ ባብሎን ኬሰ ጅራተንት፣</para>
  <para style="q2" vid="JER 50:35">ቆንዳልቶታፊ ነሞተሼ ኦጌዪት ዹፌረ!<verse eid="JER 50:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="JER 50:36"/>ጎራዴን ራጆተሼ ሶብዶተት፣ ዹፌረ!</para>
  <para style="q2" vid="JER 50:36">እሳን ጎዎተ ተኡ።</para>
  <para style="q1" vid="JER 50:36">ጎራዴን ጎቶተሼት ዹፌረ!</para>
  <para style="q2" vid="JER 50:36">እሳንስ ሶዳዻን ጉተሙ።<verse eid="JER 50:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="JER 50:37"/>ጎራዴን ፈርዴኒፊ ጋሪወንሼት፣</para>
  <para style="q2" vid="JER 50:37">ነሞተ ኦርማ ከኔን ግዱሼ ጅራተን ሁንደት ዹፌ!</para>
  <para style="q2" vid="JER 50:37">እሳን ደዸቦ ተኡ።</para>
  <para style="q1" vid="JER 50:37">ጎራዴን ቀቤኘሼት ዹፌ!</para>
  <para style="q2" vid="JER 50:37">እሳን ንሳመሙ።<verse eid="JER 50:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="JER 50:38"/>ጫምሳን ብሻንሼት ንዹፈ!</para>
  <para style="q2" vid="JER 50:38">እሳንስ ንጎጉ።</para>
  <para style="q1" vid="JER 50:38">እሼን ብየ ዋቆተ ቶልፈሞ፣</para>
  <para style="q2" vid="JER 50:38">ከን ዋቆተ ቶልፈሞ ሶዳዻን መራተኒቲ።<verse eid="JER 50:38"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="39" style="v" sid="JER 50:39"/>“ከናፉ ኡመመወን ገሞጂቲፊ <optbreak/> ወራቤዪን አች ጅራቱ፤</para>
  <para style="q2" vid="JER 50:39">ኡሩንጉንስ አች ጅራት።</para>
  <para style="q1" vid="JER 50:39">ለመተ ነምን እሼ ኬሰ ህንጅራቱ፤</para>
  <para style="q2" vid="JER 50:39">ዮካን ዸሎታ ሀመ ዸሎታት <optbreak/> ነምን ኬሰ ጅራቱ ህንጅሩ።<verse eid="JER 50:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="JER 50:40"/>አኩመ ዋቅን ሶዶሚፊ ጎሞራ፣</para>
  <para style="q2" vid="JER 50:40">መጋላወን ናኖሳኒ ጅረን ወጅን በሌሴ ሰነ”</para>
  <para style="q2" vid="JER 50:40">ጄዸ <char style="nd">ዋቀዮ</char>፤</para>
  <para style="q1" vid="JER 50:40">“ነምን ቶኮዩ አች ህንጅራቱ፤</para>
  <para style="q2" vid="JER 50:40">ሰኚን ነማ ቶኮስ እሼ ኬሰ ህንቁበቱ።<verse eid="JER 50:40"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="41" style="v" sid="JER 50:41"/>“ኩኖ! ገሬን ሎልቶታ ቶኮ ካበራ ዹፋ ጅረ፤</para>
  <para style="q2" vid="JER 50:41">ሰብን ጉዳን ቶኮፊ ሞቶትን ባይኤን</para>
  <para style="q2" vid="JER 50:41">ሞጋ ለፋቲ ሶሶቾኣ ጅሩ።<verse eid="JER 50:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="JER 50:42"/>እሳን ጥያፊ ኤቦ ቀበተኒሩ፤</para>
  <para style="q2" vid="JER 50:42">እሳን ገረ ጀቤዪ ነማፍስ ናሱ ህንቀብኔዸ።</para>
  <para style="q1" vid="JER 50:42">ዮሙ እሳን ፈርዴንሳኒ ጉሉፈንት</para>
  <para style="q2" vid="JER 50:42">ግግግሱንሳኒ አኩመ ሁርሳ ገላናት፤</para>
  <para style="q1" vid="JER 50:42">ያ እንተለ ባብሎን፣</para>
  <para style="q2" vid="JER 50:42">እሳን አኩመ ነሞተ ዱላፍ ህሪረኒት ስ ሎሉፍ ዹፉ።<verse eid="JER 50:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="JER 50:43"/>ሞቲን ባብሎን ኦዱ ዋኤሳኒ ዸገኤ፤</para>
  <para style="q2" vid="JER 50:43">ሀርክሳስ እረት ዱኤ።</para>
  <para style="q1" vid="JER 50:43">ዽጵን እሰ ቀበቴረ፤</para>
  <para style="q2" vid="JER 50:43">ሚጡንስ አኩመ ዱበርቲ ጭኒንስፈቱ እሰ ቀቤረ።<verse eid="JER 50:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="JER 50:44"/>አን አኩመ ሌንጨ ቦሶነ ዮርዳኖሲ በኤ</para>
  <para style="q2" vid="JER 50:44">ገረ ለፈ ዼዳ ገበታ ዹፉ ቶኮ</para>
  <para style="q2" vid="JER 50:44">ደፌ ባብሎንን ብየሼቲ ነንአርአ።</para>
  <para style="q1" vid="JER 50:44">ፍለተማን አን ዋን ከናፍ ሙዱ ኤኙ?</para>
  <para style="q2" vid="JER 50:44">ከን አከኮ ኤኙ?</para>
  <para style="q1" vid="JER 50:44">ኤኙቱስ ናን ሞርኩ ደንደአ?</para>
  <para style="q2" vid="JER 50:44">ትክሴ አከሚቱ ፉለኮ ዱረ ዻበቹ ደንደአ?”<verse eid="JER 50:44"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="45" style="v" sid="JER 50:45"/>ከናፉ ዋን <char style="nd">ዋቀዮ</char> ባብሎንት ከሮርፈቴ፣</para>
  <para style="q2" vid="JER 50:45">ዋን እን ብየ ባብሎኖታት ያዴስ ዸገኣ፤</para>
  <para style="q1" vid="JER 50:45">እልማን ቡሻዬ ሀርክፈመኒ ንፉዸተሙ፤</para>
  <para style="q2" vid="JER 50:45">እንስ ሰበቢሳኒቲፍ ለፈ ዼደሳኒ <optbreak/> ጉቱማን ጉቱት ንበርበዴሰ።<verse eid="JER 50:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="JER 50:46"/>ወጨ ቀበሙ ባብሎኒቲን ለፍት ንራፈምት፤</para>
  <para style="q2" vid="JER 50:46">እይሼስ ሰቦተ ግዱት ንዸገአመ።<verse eid="JER 50:46"/></para>
  <chapter eid="JER 50"/>
  <chapter number="51" style="c" sid="JER 51"/>
  <para style="p">
    <verse number="1" style="v" sid="JER 51:1"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 51:1">“ኩኖ አን ባብሎኒፊ ሰበ እሼ ኬሰ ጅራቱት</para>
  <para style="q2" vid="JER 51:1">ቡቤ ዋ በሌሱ ነንካሰ።<verse eid="JER 51:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 51:2"/>አን አከ እሳን ግንግልቸኒ እሼ በሌሰኒፍ</para>
  <para style="q2" vid="JER 51:2">ኦርሞተ ባብሎንት ነንኤርገ፤</para>
  <para style="q1" vid="JER 51:2">እሳን ጋፈ በዲሰሼ፣</para>
  <para style="q2" vid="JER 51:2">ከራ ሁንዳኑ እሼን ሞርሙ።<verse eid="JER 51:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 51:3"/>አባን ጥያ እዳሳ ህንአጋምን፣</para>
  <para style="q2" vid="JER 51:3">ዮካን ምአ ሎላ ህንህዸን።</para>
  <para style="q1" vid="JER 51:3">ደርገጎተሼ ህንባስና፤</para>
  <para style="q2" vid="JER 51:3">ሎልቶተሼሌ ጉቱማን ጉቱት በርበዴሳ።<verse eid="JER 51:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 51:4"/>እሳን ቀለመኒ ባብሎን ኬሰ ንሀርጫፈሙ፤</para>
  <para style="q2" vid="JER 51:4">ዳንዲወንሼረትስ ንመዳኡ።<verse eid="JER 51:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 51:5"/>ዮ ብይሳኒ ፉለ ቁልቁልቸ እስራኤል ዱረት</para>
  <para style="q2" vid="JER 51:5">የካን ጉተምቴ ጅራቴዩ</para>
  <para style="q1" vid="JER 51:5">ዋቅንሳኒ፣ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ</para>
  <para style="q2" vid="JER 51:5">እስራኤሊፊ ይሁዳ ህንገትኔ።<verse eid="JER 51:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="JER 51:6"/>“ባብሎን ኬሳ በቀዻ!</para>
  <para style="q2" vid="JER 51:6">ሉቡኬሰን ኦልፈዻ!</para>
  <para style="q2" vid="JER 51:6">እስን ሰበቢ ጩቡ እሼቲፍ ህንዹምና።</para>
  <para style="q1" vid="JER 51:6">ዬሮን ኩን ዬሮ ሃሎ በኡ ዋቀዮት፤</para>
  <para style="q2" vid="JER 51:6">እንስ ገቲ እሼፍ መሉ ንኬናፍ።<verse eid="JER 51:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 51:7"/>ባብሎን ሀርከ <char style="nd">ዋቀዮ</char> ኬሰት ጦፎ ወርቄ ቱርቴ፤</para>
  <para style="q2" vid="JER 51:7">እሼን ጉቱማ ለፋ ንመቼስቴ።</para>
  <para style="q1" vid="JER 51:7">ሰቦትን ዳዺ ወይኒሼ ዹገን፤</para>
  <para style="q2" vid="JER 51:7">ከናፉ አመ መራተኒሩ።<verse eid="JER 51:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 51:8"/>ባብሎን አኩመ ተሳ</para>
  <para style="q2" vid="JER 51:8">ኩፍቴ ጨጨብድ፤ እሼፍ ቦኣ!</para>
  <para style="q1" vid="JER 51:8">ቆርቸ እሼን መዳ ድበቱ ፍዳፊ፤</para>
  <para style="q2" vid="JER 51:8">ተሪ እሼን ንፈይት ተኣቲ።<verse eid="JER 51:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="JER 51:9"/>“ ‘ኑ ባብሎንን ፈይሱ ያሌረ፤</para>
  <para style="q2" vid="JER 51:9">እሼን ገሩ ፈዩ ህንደንዴሱ፤</para>
  <para style="q1" vid="JER 51:9">ኮታ ቶኮን ቶኮንኬኘ እሼ ዺፍኔ</para>
  <para style="q2" vid="JER 51:9">ገረ ብየ ኦፊኛት ሃቀጄሉ፤</para>
  <para style="q1" vid="JER 51:9">ሙርቲንሼ ሀመ ሰሚት ኦል በኤ፣</para>
  <para style="q2" vid="JER 51:9">ሀመ ዱሜሳት ኦል ፈጋቴራቲ።’<verse eid="JER 51:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JER 51:10"/>“ ‘<char style="nd">ዋቀዮ</char> ቀጄሉማኬኘ ዹጋ ኑ በኤረ፤</para>
  <para style="q2" vid="JER 51:10">ኮታ፣ ዋን <char style="nd">ዋቀዮ</char> ዋቅንኬኘ ሆጄቴ</para>
  <para style="q2" vid="JER 51:10">ጥዮን ኬሰት ሃኦዴስኑ።’<verse eid="JER 51:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="JER 51:11"/>“ጥየ ቀረዻ፤</para>
  <para style="q2" vid="JER 51:11">ጋቸነሌ ፉዸዻ!</para>
  <para style="q1" vid="JER 51:11">ሰበቢ ካዮንሳ ባብሎንን በሌሱ ተኤፍ</para>
  <para style="q2" vid="JER 51:11">
    <char style="nd">ዋቀዮ</char> ሞቶተ ሜዴ ከካሴረ።</para>
  <para style="q1" vid="JER 51:11">
    <char style="nd">ዋቀዮ</char> ሃሎ ንበአ፤</para>
  <para style="q2" vid="JER 51:11">መነ ቁልቁሉማሳቲ ሃሎ ንበአ።<verse eid="JER 51:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 51:12"/>ደላ ባብሎንት ፋጂ ካሳ!</para>
  <para style="q2" vid="JER 51:12">ኤጉምሰ ጀጀቤሳ፤</para>
  <para style="q1" vid="JER 51:12">ኤግዱ ዻባ፤</para>
  <para style="q2" vid="JER 51:12">ወረ ርጴ ኤገቱ ቆጴሳ!</para>
  <para style="q1" vid="JER 51:12">
    <char style="nd">ዋቀዮ</char> ካዮሳ</para>
  <para style="q2" vid="JER 51:12">ዋን ሰበ ባብሎንት ሙሬ ሰነ ፊጣን ባፈተ።<verse eid="JER 51:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 51:13"/>አት ከን ብሻን ባይኤ ቀብዱ፣</para>
  <para style="q2" vid="JER 51:13">ከን ቀቤኛንስ በዻቴ፣</para>
  <para style="q1" vid="JER 51:13">ዹምንኬ ዹፌረ፤</para>
  <para style="q2" vid="JER 51:13">ዬሮን አት እት በዱ ገኤረ።<verse eid="JER 51:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 51:14"/>
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ ኦፊን ከከቴረ፦</para>
  <para style="q2" vid="JER 51:14">አን ዹጉማን ነሞተ አኩመ ሆማ ሀዋንሳ <optbreak/> ስት ገድ ዺሰ፤</para>
  <para style="q2" vid="JER 51:14">እሳንስ ሞአናዻን ስት ዻደቱ።<verse eid="JER 51:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JER 51:15"/>“እን ሁምነሳቲን ለፈ ኡሜ፤</para>
  <para style="q2" vid="JER 51:15">ኦጉማሳቲን አዱኛ ሁንዴሴ፤</para>
  <para style="q2" vid="JER 51:15">ሁበትናሳቲንስ ሰሚወን ድሪርሴ።<verse eid="JER 51:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 51:16"/>ዮሙ እን ቀቀዌሰኡት ብሻኖትን ሰሚ ንሁርሱ፤</para>
  <para style="q2" vid="JER 51:16">እን አከ ዱሜሶን ዳሪ ለፋቲ ኦል ከአን ንጎዸ።</para>
  <para style="q1" vid="JER 51:16">ቦካ ወጅን በለቄ ንኤርገ፤</para>
  <para style="q2" vid="JER 51:16">መንኩሳሌሳ ኬሳሞ ቡቤ ንፍደ።<verse eid="JER 51:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="JER 51:17"/>“ቶኮን ቶኮን ነማ ጎዋፊ ከን ቤኩምሰ ህንቀብኔዸ፤</para>
  <para style="q2" vid="JER 51:17">ቶኮን ቶኮን ቱምቱ ወርቄ ዋቆተ ቶልፈሞሳቲን ቃኔፈመ።</para>
  <para style="q1" vid="JER 51:17">ፈኪወን እን ቶልቹ ከን ሶባት፤</para>
  <para style="q2" vid="JER 51:17">እሳን ሀፉረ ባፈተን ኦፍ ኬሳ ህንቀበን።<verse eid="JER 51:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 51:18"/>እሳን ፋይዳ ህንቀበን፤ ሜሻ ቆሳት፤</para>
  <para style="q2" vid="JER 51:18">ዬሮ አደቢንሳኒ ገኡት ንበዱ።<verse eid="JER 51:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 51:19"/>እን ቆደ ያቆብ ተኤ ሱን ገሩ አከ ወረ ከና ምት፤</para>
  <para style="q2" vid="JER 51:19">እን ኡማ ዋን ሁንዱማት፤</para>
  <para style="q1" vid="JER 51:19">እስራኤልሞ ጎሰ ዻለሳት፤</para>
  <para style="q2" vid="JER 51:19">መቃንሳስ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡዸ።<verse eid="JER 51:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JER 51:20"/>“አት ቦኩኮ ከን ዱላ</para>
  <para style="q2" vid="JER 51:20">ምአ ሎላኮቲት፤</para>
  <para style="q1" vid="JER 51:20">አን ሲን ሰቦተ ነንጨጨብሰ፤</para>
  <para style="q2" vid="JER 51:20">ሲን ሞቱሞተ ነንበርበዴሰ፤<verse eid="JER 51:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 51:21"/>አን ሲን ፈርዳፊ ያበታ ፈርዳ ነንጨጨብሰ፤</para>
  <para style="q2" vid="JER 51:21">ሲን ጋሪፊ ኦፍቱሳ ነንጨጨብሰ፤<verse eid="JER 51:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 51:22"/>አን ሲን ዺራ ዱበርቶተ ነንጨጨብሰ፤</para>
  <para style="q2" vid="JER 51:22">ሲን ጃርሳ ደርገጌሰ ነንጨጨብሰ፤</para>
  <para style="q2" vid="JER 51:22">ሲን ገኤሳፊ ሸመሬ ነንጨጨብሰ፤<verse eid="JER 51:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 51:23"/>አን ሲን ትክሴፊ ቡሻዬ ነንጨጨብሰ፤</para>
  <para style="q2" vid="JER 51:23">ሲን ቆቱፊ ቆትዮ ነንጨጨብሰ፤</para>
  <para style="q2" vid="JER 51:23">ሲን ቡልችቶታፊ ቆንዳልቶተ ነንጨጨብሰ።<verse eid="JER 51:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 51:24"/>“አን ኡቱመ እጅኬሰን አርጉ ዋን እሳን ጥዮን ጎዸን ሁንዳፍ ባብሎኒፊ ወረ ባብሎን ኬሰ ጅራተን ሁንዳፍ ገቲሳኒ ነንኬነ” ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 51:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 51:25"/>“ያ ቱሉ በርበዴሳ፣</para>
  <para style="q2" vid="JER 51:25">አት ከን ለፈ ሁንደ በሌስቱ አን ስት ከኤረ፤</para>
  <para style="q2" vid="JER 51:25">አን ሀርከኮ ስት ነንካፈዸ፤</para>
  <para style="q1" vid="JER 51:25">ኤዴደራ ገድ ገንገልቼ</para>
  <para style="q2" vid="JER 51:25">ቱሉ ጉበማ ስን ጎዸ”</para>
  <para style="q2" vid="JER 51:25">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 51:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JER 51:26"/>“ዋን አት በረ በራን ኦንቱፍ፣</para>
  <para style="q2" vid="JER 51:26">ከታን ዸጋ ጎሌ ተኡ፣</para>
  <para style="q1" vid="JER 51:26">ዮካን ዸጋን ሁንዴፍ ተኡ ቶኮዩ ስ ኬሳ ህንፉዸተሙ”</para>
  <para style="q2" vid="JER 51:26">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 51:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="JER 51:27"/>“ብየቲ ኬሰት ፋጂ ኦል ቀባ!</para>
  <para style="q2" vid="JER 51:27">ሰቦተ ግዱትስ መለከተ አፉፋ!</para>
  <para style="q1" vid="JER 51:27">ሰቦተ ወራናፍ እሼት ቆጴሳ፤</para>
  <para style="q2" vid="JER 51:27">ሞቱሞተ አራራት፣</para>
  <para style="q2" vid="JER 51:27">ከን ሚኒቲፊ አሽኬነስ እሼት ዋማ።</para>
  <para style="q1" vid="JER 51:27">አጀጃ ወራና እሼት ሹማ፤</para>
  <para style="q2" vid="JER 51:27">ፈርዴን አከ ሆማ ሀዋንሳ እት ኤርጋ።<verse eid="JER 51:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 51:28"/>እሼ ወራኑዻፍ ሰቦተ ጄቹንስ፣</para>
  <para style="q2" vid="JER 51:28">ሞቶተ ሜዴ</para>
  <para style="q1" vid="JER 51:28">ቡልችቶተሳኒቲፊ ቆንዳልቶተሳኒ ሁንደ፣</para>
  <para style="q2" vid="JER 51:28">ብዮተ እሳን ቡልቸን ሁንደስ ቆጴሳ።<verse eid="JER 51:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JER 51:29"/>ሰበቢ ወን <char style="nd">ዋቀዮ</char></para>
  <para style="q2" vid="JER 51:29">አከ ነምን ቶኮዩ አች ህንጅራኔፍ</para>
  <para style="q1" vid="JER 51:29">ብየ ባብሎን ኦንሱፍ ባብሎንት ከሮርፈቴ ሱን</para>
  <para style="q2" vid="JER 51:29">ጀባቴ ዻበቱፍ ብየቲን ንራፈምት፤ ንዽዺተትስ።<verse eid="JER 51:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 51:30"/>ጎቶትን ባብሎን ሎለ ዺሰኒሩ፤</para>
  <para style="q2" vid="JER 51:30">እሳን ደአትኖሳኒ ኬሰት ሀፈኒሩ።</para>
  <para style="q1" vid="JER 51:30">ጀብንሳኒ ዹሜረ፤</para>
  <para style="q2" vid="JER 51:30">እሳን አኩመ ዱበርቶታ ተአኒሩ።</para>
  <para style="q1" vid="JER 51:30">እዶ ጅሬኘሼት እብድ ቀብሲፈሜረ፤</para>
  <para style="q2" vid="JER 51:30">ደንቀራወን በልበለሼስ ጨጨበኒሩ።<verse eid="JER 51:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JER 51:31"/>አከ መጋላንሳ ሞጋ ሀመ ሞጋት ቀበምቴ</para>
  <para style="q2" vid="JER 51:31">ሞቲ ባብሎንት ህሙፍ፣</para>
  <para style="q1" vid="JER 51:31">ፊግዱን ቶኮ እሰ ካን ቀቀቡፍ፣</para>
  <para style="q2" vid="JER 51:31">ኤርገማን ቶኮስ ኤርገማ ካን ቀቀቡፍ ፊገ፤<verse eid="JER 51:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JER 51:32"/>ኩንስ አከ መልካን ቀበሜ፣</para>
  <para style="q2" vid="JER 51:32">አከ ደአኖወንሼ ጉበመኒፊ</para>
  <para style="q2" vid="JER 51:32">አከ ሎልቶትንሼ ነአን ህሙዻፍ።”<verse eid="JER 51:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JER 51:33"/>
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣ ዋቅን እስራኤል አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 51:33">“እንተል ባብሎን አኩመ ኦብዲት፤</para>
  <para style="q2" vid="JER 51:33">ዬሮ ሰነት እሼን ንዽዺተምት፤</para>
  <para style="q2" vid="JER 51:33">ዬሮን እሼን እት ሃመምቱስ ደፌ ንዹፈ።”<verse eid="JER 51:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="JER 51:34"/>“ኔቡከድኔዘር ሞቲን ባብሎን ነ ኛቴረ፤</para>
  <para style="q2" vid="JER 51:34">እን በርበዴሴረ፤</para>
  <para style="q2" vid="JER 51:34">አኩመ ኦኮቴ ዱዋ ነ ጎዼ።</para>
  <para style="q1" vid="JER 51:34">እን አኩመ ጀዌ ነ ልቅምሴ፤</para>
  <para style="q2" vid="JER 51:34">ቀቤኘኮ ፍለተማዻንስ ገራ ጉተቴ፤</para>
  <para style="q2" vid="JER 51:34">ኤርገሲሞ ነ ቱፌ።”<verse eid="JER 51:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="JER 51:35"/>ጅራቶትን ጥዮን፣</para>
  <para style="q2" vid="JER 51:35">“ደብን ፎንኬኘት ሆጄተሜ ባብሎንትሌ ሃዹፉ” ጄዸን።</para>
  <para style="q1" vid="JER 51:35">ዬሩሳሌምስ፣ “ዺግንኬኘ</para>
  <para style="q2" vid="JER 51:35">ወረ ባብሎን ኬሰ ጅራተን ሃሎ ሃበኡ” ጄት።<verse eid="JER 51:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JER 51:36"/>ከናፉ <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="JER 51:36">“ኩኖ፣ አን ዱቢኬ ሲፍ ፈልሜ</para>
  <para style="q2" vid="JER 51:36">ሃሎ ሲፍን በአ፤</para>
  <para style="q1" vid="JER 51:36">አን ገላነሼ ነንጎግሰ፤</para>
  <para style="q2" vid="JER 51:36">ቡርቃሼሌ ነንኩተ።<verse eid="JER 51:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="JER 51:37"/>ባብሎን ቱላ ዲገሜ፣</para>
  <para style="q2" vid="JER 51:37">እዶ ዋንጎትን ኬሰ ቡራቀን፣</para>
  <para style="q1" vid="JER 51:37">ዋን ናሱቲፊ ቆሳ፣</para>
  <para style="q2" vid="JER 51:37">ለፈ ነምን ቶኮዩረ ህንጅራትኔ ንታት።<verse eid="JER 51:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="JER 51:38"/>ሰብንሼ ሁንድ አከ ሳፌለ ሌንጫ ንኣደ፤</para>
  <para style="q2" vid="JER 51:38">እሳንስ አከ እልማን ሌንጫ ጉሩርኡ።<verse eid="JER 51:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="JER 51:39"/>ዮሙ ዸግንሳኒ ሆኡት፣</para>
  <para style="q2" vid="JER 51:39">አን አከ እሳን ኮልፋ ገመደኒ</para>
  <para style="q2" vid="JER 51:39">በረ በራን ረፈኒ ህንደመቅኔፍ</para>
  <para style="q1" vid="JER 51:39">ጭዸሳኒፍ ቆጴሴ</para>
  <para style="q2" vid="JER 51:39">አከ እሳን መቻአን ነንጎዸ”</para>
  <para style="q2" vid="JER 51:39">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 51:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="JER 51:40"/>“አን አከ እልሞሌ ሆላ፣</para>
  <para style="q2" vid="JER 51:40">አኩመ ኮርቤዪ ሆላቲፊ</para>
  <para style="q2" vid="JER 51:40">ሬኤ ገረ ቀልማት ገድ እሳን ቡሰ።<verse eid="JER 51:40"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="41" style="v" sid="JER 51:41"/>“ሼሻክ አከምት ቦጅአምት!</para>
  <para style="q2" vid="JER 51:41">ቦኑን ለፈ ሁንዳስ አከምት ቀበሜ!</para>
  <para style="q1" vid="JER 51:41">ባብሎን ሰበ ግዱት</para>
  <para style="q2" vid="JER 51:41">አከም ዋን ሶዳ ታት!<verse eid="JER 51:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="JER 51:42"/>ባብሎንረ ገላን ገረገለ፤</para>
  <para style="q2" vid="JER 51:42">ደምበሊን ገላናስ እሼ ሀጉገ።<verse eid="JER 51:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="JER 51:43"/>መጋላወንሼ ኦነኒ</para>
  <para style="q2" vid="JER 51:43">ብየ ጎጋፊ ገሞጂ፣</para>
  <para style="q1" vid="JER 51:43">ብየ ነምን ቶኮዩ ኬሰ ህንጅራትኔ፣</para>
  <para style="q2" vid="JER 51:43">ከን ነምን ኬሰ ህንደበሬ ንተኡ።<verse eid="JER 51:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="JER 51:44"/>አን ባብሎን ኬሰት ቤልን ነንአደበ፤</para>
  <para style="q2" vid="JER 51:44">ዋን እን ልቅምሴሌ ነንቱፍሲሰ።</para>
  <para style="q1" vid="JER 51:44">ሰቦትን ለመተ ገረሳት ህንያአን፤</para>
  <para style="q2" vid="JER 51:44">ደላን ባብሎንስ ንጅገ።<verse eid="JER 51:44"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="45" style="v" sid="JER 51:45"/>“ያ ሰበኮ፣ እሼ ኬሳ በኣ!</para>
  <para style="q2" vid="JER 51:45">ሉቡኬሰን ኦልፈቹፍ ፊጋ!</para>
  <para style="q2" vid="JER 51:45">ዼከምሰ <char style="nd">ዋቀዮ</char> ሶዳችሳ ሰነ ጀላ በቀዻ።<verse eid="JER 51:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="JER 51:46"/>ዬሮ ኦዱን ብየ ኬሰት ዸገአሙት</para>
  <para style="q2" vid="JER 51:46">ገራንኬሰን ህንራፈምን ዮካን ህንሶዳትን፤</para>
  <para style="q1" vid="JER 51:46">አከ ጎሊን ብየ ኬሰ ጅሩ፣</para>
  <para style="q2" vid="JER 51:46">አከ ቡልቻን ቶኮ ቡልቻ ካንት ከኡ፣</para>
  <para style="q2" vid="JER 51:46">ኦዱን ቶኮ በረነ፣ ካንሞ በረ ዹፉ ዸገአመ።<verse eid="JER 51:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="JER 51:47"/>ዬሮን አን እት ዋቆተ ባብሎን ቶልፈሞ አደቡ</para>
  <para style="q2" vid="JER 51:47">ዹጉማን ንዹፋቲ፤</para>
  <para style="q1" vid="JER 51:47">ብይሼ ጉቱማን ጉቱት ንሰልጰት፤</para>
  <para style="q2" vid="JER 51:47">ቀለምቶትንሼ ሁንድስ እሼ ኬሰት ኩኩፉ።<verse eid="JER 51:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="JER 51:48"/>ኤርገሲ ሰሚፊ ለፍት፣ ወን እሳን ኬሰ ጅሩ ሁንድስ፣</para>
  <para style="q2" vid="JER 51:48">ገመደኒ ባብሎንት እልልቹ፤</para>
  <para style="q1" vid="JER 51:48">በርበዴስቶትን ካባ በአኒ</para>
  <para style="q2" vid="JER 51:48">እሼ ወራኑቲ”</para>
  <para style="q2" vid="JER 51:48">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 51:48"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="49" style="v" sid="JER 51:49"/>“አኩመ ቀለምቶትን ለፈራ ሁንድ</para>
  <para style="q2" vid="JER 51:49">ሰበቢ ባብሎኒፍ ሀርጨአን ሰነ</para>
  <para style="q2" vid="JER 51:49">ባብሎንስ ሰበቢ ቀለምቶተ እስራኤሊፍ ሀርጨኡ ቀብድ።<verse eid="JER 51:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="JER 51:50"/>እስን ወር ጎራዴ ጀላ ምልቅጠን፣</para>
  <para style="q2" vid="JER 51:50">ዴማ፤ ለፈረ ህንሀርክፈትና!</para>
  <para style="q1" vid="JER 51:50">ብየ ፈጎትሌ <char style="nd">ዋቀዮን</char> ያደዻ፤</para>
  <para style="q2" vid="JER 51:50">ዋኤ ዬሩሳሌምስ ያዳ።”<verse eid="JER 51:50"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="51" style="v" sid="JER 51:51"/>“ሰበቢ ኦርሞትን እዶ ቁልቁላኣ</para>
  <para style="q2" vid="JER 51:51">መነ <char style="nd">ዋቀዮት</char> ቀለኒፍ፣</para>
  <para style="q2" vid="JER 51:51">ኑ ሰልጵፈምኔረ፤</para>
  <para style="q1" vid="JER 51:51">ዋን አረብሰምኔፍስ</para>
  <para style="q2" vid="JER 51:51">ቃኒዻን ፉለኬኘ ሀጉገትኔ።”<verse eid="JER 51:51"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="52" style="v" sid="JER 51:52"/>“ገሩ በር አን እት፣</para>
  <para style="q2" vid="JER 51:52">ዋቆተሼ ቶልፈሞ አደቡፊ</para>
  <para style="q1" vid="JER 51:52">ዬሮን ጉቱማ ለፈሼረት</para>
  <para style="q2" vid="JER 51:52">ወር መዳአን ኣደን ዹፋ ጅረ” ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 51:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="JER 51:53"/>“ዮ ባብሎን ሰሚት ኦል ባቴ</para>
  <para style="q2" vid="JER 51:53">ደአትኖሼ ኦል ዼራ ጀቤፈቴዩ፣</para>
  <para style="q2" vid="JER 51:53">አን ወረ እሼ በርበዴሰን እት ነንኤርገ”</para>
  <para style="q2" vid="JER 51:53">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JER 51:53"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="54" style="v" sid="JER 51:54"/>“ባብሎኒ እይ፣</para>
  <para style="q2" vid="JER 51:54">ለፈ ባብሎኖታቲሞ</para>
  <para style="q2" vid="JER 51:54">ሰገሌን በዲሰ ጉዳ ንዸገአመ።<verse eid="JER 51:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="JER 51:55"/>
    <char style="nd">ዋቀዮስ</char> ባብሎንን ንበርበዴሰ፤</para>
  <para style="q2" vid="JER 51:55">እን ወጨሼ ንጨልእሲሰ፣</para>
  <para style="q1" vid="JER 51:55">ደምበሊንሳኒስ አኩመ ብሻን ጉዳ ንሁርሰ፤</para>
  <para style="q2" vid="JER 51:55">ሰገሌን ሁርሳሳኒስ ንዸገአመ።<verse eid="JER 51:55"/></para>
  <para style="q1">
    <verse number="56" style="v" sid="JER 51:56"/>በርበዴሳን ቶኮ ባብሎንት ንዹፈ፤</para>
  <para style="q2" vid="JER 51:56">ጎቶትንሼ ንቀበሙ፤</para>
  <para style="q2" vid="JER 51:56">ፉታፍቱንሳኒስ ንጨጨበ፤</para>
  <para style="q1" vid="JER 51:56">
    <char style="nd">ዋቀዮ</char>፣ ዋቀ ሃሎ በኡዻቲ፤</para>
  <para style="q2" vid="JER 51:56">እን ጉቱማን ጉቱት ገቲሼ ንዴብሳፍ።<verse eid="JER 51:56"/></para>
  <para style="q1">
    <verse number="57" style="v" sid="JER 51:57"/>አን ቆንዳልቶታፊ ኦጌዪሼ፣</para>
  <para style="q2" vid="JER 51:57">አከሱመስ ቡልችቶተ፣ አጀጆተ ወራናቲፊ <optbreak/> ጎቶተሼ ነንመቼሰ፤</para>
  <para style="q1" vid="JER 51:57">እሳንስ በረ በራን ንረፉ፤ ህንደመቀንስ፣”</para>
  <para style="q2" vid="JER 51:57">ጄዸ ሞትች መቃንሳ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣ <optbreak/> ጄዸሙ ሱን።<verse eid="JER 51:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="JER 51:58"/>
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ አከነ ጄዸ፤</para>
  <para style="q1" vid="JER 51:58">“ደላን ባብሎን የቡን ሱን ንጅገ፤</para>
  <para style="q2" vid="JER 51:58">ከረወንሼ ዼዼሮን እብዳን ጉበሙ፤</para>
  <para style="q1" vid="JER 51:58">ነሞትን አከሱማን ኦፍ ደዸብሲሱ፤</para>
  <para style="q2" vid="JER 51:58">ደዸቢን ሰቦታ ቆራን እብዳ ቆፈ ተአ።”<verse eid="JER 51:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="JER 51:59"/>ዬሮ ሴራያን እልም ኔርያ፣ እልም መህሴያ በረ ዜዴቅያ ሞትቸ ይሁዳ ኬሰ ወጋ አፉረፋት ሞትቸ ወጅን ገረ ባብሎን ዴሜት አጀጅን ኤርምያስ ራጅች እሳፍ ኬኔ ከናዸ። <verse eid="JER 51:59"/><verse number="60" style="v" sid="JER 51:60"/>ኤርምያስ በዲሰ ባብሎንት ዹፉ ሁንደ፣ ጄቹንስ ዋኤ ባብሎን ከን በሬፈሜ ሁንደ ክታበ መረማረት በሬሴ ቱሬ። <verse eid="JER 51:60"/><verse number="61" style="v" sid="JER 51:61"/>እንስ ሴራያዻን አከነ ጄዼ፤ “ዮሙ ባብሎን ጌሱት ዱቢ ከነ ሁንደ ሰገሌ ኦል ፉዸቴ ዱብሱ ህንደገትን። <verse eid="JER 51:61"/><verse number="62" style="v" sid="JER 51:62"/>አከነስ ጄዽ፦ ‘ያ <char style="nd">ዋቀዮ</char>፣ አከ ነምን ዮካን ሆሪንሼ ኬሰ ህንጅራኔፍ አት አከ እዶ ከነ በርበዴስቱ ዱበቴርተ፤ እሼንስ በረ በራን ንኦንት።’ <verse eid="JER 51:62"/><verse number="63" style="v" sid="JER 51:63"/>ዬሮ ክታበ መረማ ከነ ዱብፍቴ ፍጡት ዸጋ እት ህዺቲ ለገ ኤፍራጢስት ደርበዹ። <verse eid="JER 51:63"/><verse number="64" style="v" sid="JER 51:64"/>አከነስ ጄዽ፤ ‘ሰበቢ በዲሰ አን እሼት ፍዱቲን አከ ለመተ ህንካኔፍ ባብሎን አከስት ንልቅምፈምት። ኡመትንሼስ ንሀርጨአ።’ ”</para>
  <para style="b" vid="JER 51:64"/>
  <para style="b" vid="JER 51:64"/>
  <para style="p" vid="JER 51:64">ዱቢን ኤርምያስ አስረት ራወተመ።<verse eid="JER 51:64"/></para>
  <para style="b"/>
  <chapter eid="JER 51"/>
  <chapter number="52" style="c" sid="JER 52"/>
  <para style="s1">ኩፋቲ ዬሩሳሌም</para>
  <para style="r">
    <ref loc="JER 52:1-3">52፥1‑3</ref> ኩወፈ – <char style="xt"><ref loc="2KI 24:18-20">2ሞቶ 24፥18‑20</ref>፤ <ref loc="2CH 36:11-16">2ሴና 36፥11‑16</ref></char></para>
  <para style="r">
    <ref loc="JER 52:4-16">52፥4‑16</ref> ኩወፈ – <char style="xt"><ref loc="JER 39:1-10">ኤር 39፥1‑10</ref></char></para>
  <para style="r">
    <ref loc="JER 52:4-21">52፥4‑21</ref> ኩወፈ – <char style="xt"><ref loc="2KI 25:1-21">2ሞቶ 25፥1‑21</ref>፤ <ref loc="2CH 36:17-20">2ሴና 36፥17‑20</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="JER 52:1"/>ዜዴቅያ ዬሮ ሞቲ ተኤት ነመ ኡሙሪንሳ ወጋ ድግደሚ ቶኮ ቱሬ፤ እንስ ዬሩሳሌም ኬሰ ታኤ ወጋ ኩዸ ቶኮ ቡልቼ። መቃን ሃዸሳ ሀሙታል ቱሬ፤ እሼንስ እንተለ ኤርምያስ ከን መጋላ ልብናቲ ዹፍቴ ቱርቴ። <verse eid="JER 52:1"/><verse number="2" style="v" sid="JER 52:2"/>እንስ አኩመ ዬሆያቂም ሆጄቴ ሰነ፣ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዋን ሀማ ንሆጄቴ። <verse eid="JER 52:2"/><verse number="3" style="v" sid="JER 52:3"/>ወን ኩን ሁንድ ሰበቢ ዼከምሰ <char style="nd">ዋቀዮቲፍ</char> ዬሩሳሌሚፊ ይሁዳረ ገኤ፤ ዹመረትስ እን ፉለሳ ዱራ እሳን በሌሴ።</para>
  <para style="p" vid="JER 52:3">ዜዴቅያ ሞትቸ ባብሎንት ፍንጭሌ።<verse eid="JER 52:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 52:4"/>በረ ሞቱማ ዜዴቅያ ኬሰ ወጋ ሰግለፋት፣ ቡልቲ ኩርነፋ ጅአ ኩርነፋት ኔቡከድኔዘር ሞቲን ባብሎን ጉቱማ ሎልቶተሳ ወጅን ዬሩሳሌምት ዱሌ፤ እሳንስ መጋለቲን አለ ቁበተኒ ናኖሼ ሁንደት ቱላ ብዮ መርሰን። <verse eid="JER 52:4"/><verse number="5" style="v" sid="JER 52:5"/>መጋላን ሱንስ ሀመ ወጋ ኩዸ ቶኮፋ በረ ዜዴቅያ ሞትቻት አኩመ መርፈምቴት ቱርቴ።<verse eid="JER 52:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 52:6"/>ቡልቲ ሰግለፋ ጅአ አፉረፋት፣ መጋለቲ ኬሰት ቤል አከ መሌ ሀማቴ ነምን ዋን ኛቱ ቶኮሌ ዸቤ። <verse eid="JER 52:6"/><verse number="7" style="v" sid="JER 52:7"/>ኤርገሲ ደላን መጋለቲ ጨብሰሜ ሎልቶትን ሁንድኑስ በአኒ በቀተን። እሳንስ ኡቱመ ባብሎኖትን መጋላ ሰነ መርሰኒ ጅረኑ ከራ ከረ ደላ እዶ ብቅልቱ ሞትቻ ብረ ጅሩ ለማን ግዱ ባሱ ሰናቲን ሀልከኒን በአኒ በቀተን። እሳንስ አረባት በቀተን፤ <verse eid="JER 52:7"/><verse number="8" style="v" sid="JER 52:8"/>ሎልቶትን ባብሎን ገሩ ዜዴቅያ ሞትቸ አርአኒ ድሬ ዬርኮረት እሰ ቀቀበን፤ ሎልቶትንሳ ሁንድስ እሰራ ገርገር በአኒ ብብትናአኒ ቱረን፤ <verse eid="JER 52:8"/><verse number="9" style="v" sid="JER 52:9"/>እንስ ንቀበሜ።</para>
  <para style="p" vid="JER 52:9">ገረ ሞቲ ባብሎንት ሪብላ ብየ ሀማት ኬሳት ጌፈሜ። አችትስ እት ሙረሜ። <verse eid="JER 52:9"/><verse number="10" style="v" sid="JER 52:10"/>ሞቲን ባብሎንስ ሪብላት እጁመሳ ዱረት እልማን ዜዴቅያ ጎረኤ፤ ቆንዳልቶተ ይሁዳ ሁንደስ ፍጤ። <verse eid="JER 52:10"/><verse number="11" style="v" sid="JER 52:11"/>እንስ ኤርገሲ ዜዴቅያ ኬሳ እጀሳ ባሴ ፎንጫ ናሲቲን ህዼ ባብሎንት እሰ ጌሴ፤ ሀመ ጋፈ እን ዱኡትስ መኑመ ህዻ ኬሰ እሰ ቱርሲሴ።<verse eid="JER 52:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 52:12"/>በረ ሞቱማ ኔቡከድኔዘር ሞትቸ ባብሎን ኬሰ ወጋ ኩዸ ሰግለፋት፣ ቡልቲ ኩርነፋ ጅአ ሸነፋት ኔቡዘረዳን አጀጃን ኤጉምሰ ሞቱማ እን ሞቲ ባብሎን ተጃጅሉ ሱን ገረ ዬሩሳሌም ዹፌ። <verse eid="JER 52:12"/><verse number="13" style="v" sid="JER 52:13"/>እንስ መነ ቁልቁሉማ <char style="nd">ዋቀዮት</char>፣ መሰራ ሞቱማቲፊ መኔን ዬሩሳሌም ሁንደት እብደ ቀብሲሴ፤ መኔን ጉርጉዳ ሁንደስ ንጉቤ። <verse eid="JER 52:13"/><verse number="14" style="v" sid="JER 52:14"/>ሎልቶትን ባብሎን ከኔን አጀጃ ኤጉምሰ ሞቱማ ጀለ ቱረን ሁንድ ደላወን ናኖ ዬሩሳሌም ቱረን ሁንደ ዲገን። <verse eid="JER 52:14"/><verse number="15" style="v" sid="JER 52:15"/>ኔቡዘረዳን አጀጃን ኤጉምሳ ሱን ነሞተ ህዬዪ ቶኮ ቶኮፊ ወረ መጋላ ኬሰት ሀፈን፣ ወረ ኦጉማ ሀርካ ቀበኒፊ ወረ በቀተኒ ሞቲ ባብሎንት ኮሉ ገለን ቦጅኤ ፉዸቴ። <verse eid="JER 52:15"/><verse number="16" style="v" sid="JER 52:16"/>ኔቡዘረዳን ገሩ ህዬዪ ብየቲ ወረ ሀፈን አከ ወይኒ ኩኑንሰኒፊ ለፈ ቆተኒፍ አችት ዺሴ።<verse eid="JER 52:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 52:17"/>ባብሎኖትን ሱን ኡቱባወን ናሲ፣ ባቱወን እዶዻ ሶቾአኒፊ ጋኒ ናሲራ ሆጄተሜ መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ኬሰ ቱሬ ጨጨብሰኒ ናሲ ሰነ ሁንደሞ ባብሎንት ጌሰን። <verse eid="JER 52:17"/><verse number="18" style="v" sid="JER 52:18"/>አከሱመስ ኦኮቴወን፣ ዋን እቲን ዳራ ሀማረን፣ ዋን እቲን እብሳራ ዳራ ዸዸአን፣ ወጪቲወን እቲን ዺገ ፈጫሰን፣ ጫቢወኒፊ ምኦተ ናሲራ ሆጄተመን ከኔን ተጃጅለ መነ ቁልቁሉማቲፍ ኦለን ሁንደ ፉዸተን። <verse eid="JER 52:18"/><verse number="19" style="v" sid="JER 52:19"/>አጀጃን ኤጉምሳ ሱንስ ምኦተ ወርቄ ቁልቁሉፊ ሜቲራ ሆጄተመን ሁንደ ጄቹንስ ጫቢ ዾቃ፣ ግርግራወን፣ ወጪቲወን እቲን ዺገ ፈጫሰን፣ ኦኮቴወን፣ ባቱወን እብሳ፣ ጫቢወኒፊ ወጪቲወን እቲን ዽባፈተን ፉዸቴ ዴሜ።<verse eid="JER 52:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 52:20"/>ኡልፍን ናሲ ከን ሶሎሞን ሞትች እቲን ኡቱባወን ለማን፣ ጋኒፊ ጅቦተ ኩዸ ለማን እሰ ጀለ ጅረኒፊ ባቱወን እዶዻ ሶቾአኒን መነ ቁልቁሉማ <char style="nd">ዋቀዮቲፍ</char> ሆጄቴ ቱሬ ዋን መዳሊን መዳሉ ደንደኡ ኦል ቱረን። <verse eid="JER 52:20"/><verse number="21" style="v" sid="JER 52:21"/>ቶኮን ቶኮን ኡቱባ ሰና ዹንዹመ ኩዸ ሰዴት ኦል ዼረቴ መርሳንሳሞ ዹንዹመ ኩዸ ለመ ቱሬ፤ የብንሳ ቁበ አፉር ተኤ ኬስሳስ በና ቱሬ። <verse eid="JER 52:21"/><verse number="22" style="v" sid="JER 52:22"/>ጉቱን ናሲ ከን ኡቱባ ቶኮራስ ዹንዹመ ሸን ኦል ዼረቴ ናኖንሳ ጉቱን ስቢለ ወል ኬሰ ሎፈሜ ቶልፈሜፊ ሮማኒ ናሲቲን ሚዸግፈሜ ቱሬ። ኡቱባን ካንስ ሮማኒ ናሲ ወጅን ከኑመ ፈካተ ቱሬ። <verse eid="JER 52:22"/><verse number="23" style="v" sid="JER 52:23"/>ሮማኖትን ብታ ምርጋን ቱረን ሰገልተሚ ሰገል ቱረን፤ ወሉመት ፋየ ናኖ ኡቱብቻ ጉባን ጅሩ ወጅን ሮመኖተ ዽበ ቶኮቱ ቱሬ።<verse eid="JER 52:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 52:24"/>አጀጃን ኤጉምሳ ሱን ሴራያ ሉብቸ ሀንገፈ፣ ሴፋንያ ሉብቸ ሰደርካን እሰት ኣኑፊ ኤግዶተ በልበላ ሰደን ህዼ ፉዼ ዴሜ። <verse eid="JER 52:24"/><verse number="25" style="v" sid="JER 52:25"/>ወረ አመሌ መጋላ ኬሰት ሀፈን ኬሳ አጀጃ ሎልቶታቲፊ ጎርስቶተ ሞቲ ቶርበ ፉዸቴ። አከሱመስ በሬሳ ቆንዳለ ኦል ኣና ቱሬ ከን ሰበ ኬሳ ሎልቱማፍ ነሞተ ፍለቱ ሰናፊ ነሞተ መጋላ ኬሰት አርገመን ጃተመ ፉዸቴ። <verse eid="JER 52:25"/><verse number="26" style="v" sid="JER 52:26"/>ኔቡዘረዳን አጀጃን ሱን ሁንደሳኒ ጉሬ ሪብላት ገረ ሞትቸ ባብሎንት ጌሴ። <verse eid="JER 52:26"/><verse number="27" style="v" sid="JER 52:27"/>ሞትችስ አቹመ ሪብላት ብየ ሀማት ኬሰት እሳን ንፍጤ።</para>
  <para style="p" vid="JER 52:27">ይሁዳንስ አከሲን ቦጅአሜ ብየሼቲ ባቴ።<verse eid="JER 52:27"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="28" style="v" sid="JER 52:28"/>ባይእን ነሞተ ኔቡከድኔዘር ቦጁዻን ፉዸቴ ከናዸ፦</para>
  <para style="b" vid="JER 52:28"/>
  <para style="li1" vid="JER 52:28">ወጋ ቶርበፋ ኬሰ</para>
  <para style="li2" vid="JER 52:28">ይሁዶተ 3,023፤<verse eid="JER 52:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="JER 52:29"/>በረ ኔቡከድኔዘር ኬሰ ወጋ ኩዸ ሰዴተፋት፣</para>
  <para style="li2" vid="JER 52:29">ዬሩሳሌሚ ነሞተ 832፤<verse eid="JER 52:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="JER 52:30"/>ወጋ ድግደሚ ሰደፋሳ ኬሰ ይሁዶትን 745፣</para>
  <para style="li2" vid="JER 52:30">ኔቡዘረዳን አጀጃ ኤጉምሳ ሰናን ቦጁዻን ፉዸተመን።</para>
  <para style="b" vid="JER 52:30"/>
  <para style="lf" vid="JER 52:30">እሳንስ ወሉመት ነሞተ 4,600 ቱረን።<verse eid="JER 52:30"/></para>
  <para style="s1">ዬሆያኪን ሂከሙሳ</para>
  <para style="r">
    <ref loc="JER 52:31-34">52፥31‑34</ref> ኩወፈ – <char style="xt"><ref loc="2KI 25:27-30">2ሞቶ 25፥27‑30</ref></char></para>
  <para style="p">
    <verse number="31" style="v" sid="JER 52:31"/>ዬሆያኪን ሞቲን ይሁዳ ቦጅአሜ ወጋ ሶዶሚ ቶርበፋሳት፣ ኤዊል መሮዳክ ሞቲ ባብሎን ተኤ፤ እንስ ወጉመ ሰነ ኬሰ ቡልቲ ድግደሚ ሸነፋ ጅአ ኩዸ ለመፋት ዬሆያኪን ሞትቸ ይሁዳ ሰነ መነ ህዻቲ ገድ ዺሴ ብልሰ እሰ ባሴ። <verse eid="JER 52:31"/><verse number="32" style="v" sid="JER 52:32"/>አፋን ቶላዻንስ እሰት ዱበቴ በርጩመ ኡልፍና ከን በርጩመ ሞቶተ እሰ ወጅን ባብሎን ኬሰ ቱረን ካኒ ጫሉ ኬኔፍ። <verse eid="JER 52:32"/><verse number="33" style="v" sid="JER 52:33"/>ከናፉ ዬሆያኪን ኡፈተሳ ከን መነ ህዻት ኡፈቻ ቱሬ ሰነ ኦፍራ ባሴ በረ ጅሬኘሳ ጉቱ ዬሮ ሁንደ ማዲ ሞትቻራ ኛቴ። <verse eid="JER 52:33"/><verse number="34" style="v" sid="JER 52:34"/>ሞቲን ባብሎንስ ሀመ እን ሉቡዻን ጅራቴት ጉዩመ ጉያዻን ዋን እሳፍ በርባችሱ ዬሆያኪኒፍ ኬና ቱሬ።<verse eid="JER 52:34"/></para>
  <chapter eid="JER 52"/>
</usx>
