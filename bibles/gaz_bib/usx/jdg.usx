<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JDG" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">አቦቲ ሙርቲ</para>
  <para style="toc1">ክታበ አቦቲ ሙርቲ</para>
  <para style="toc2">አቦቲ ሙርቲ</para>
  <para style="toc3">አቦሙ</para>
  <para style="mt2">ክታበ</para>
  <para style="mt1">አቦቲ ሙርቲ</para>
  <chapter number="1" style="c" sid="JDG 1"/>
  <para style="s1">እስራኤሎትን ከነኣኖተ ሎለን</para>
  <para style="r">
    <ref loc="JDG 1:11-15">1፥11‑15</ref> ኩወፈ – <char style="xt"><ref loc="JOS 15:15-19">እያ 15፥15‑19</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 1:1"/>ኤርገ እያሱን ዱኤ ቦዴ እስራኤሎን፣ “ከነኣኖተ ሎሉዻፍ ኤኙ ዱርሴ ኑፍ ሃበኡ?” ጄዸኒ <char style="nd">ዋቀዮን</char> ጋፈተን።<verse eid="JDG 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JDG 1:2"/>
    <char style="nd">ዋቀዮስ</char>፣ “ይሁዳን ዱርሴ ሃበኡ፤ ኩኖ፣ አን ብየቲ ደበርሴ ሀርከሳት ኬኔረ” ጄዼ ዴብሴፍ።<verse eid="JDG 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JDG 1:3"/>ነሞትን ይሁዳስ ኦቦሎተሳኒ እልማን ስምኦኒን፣ “ኮታ ገረ ለፈ ቆደኬኛት ከነኣኖተ ሎሉፍ ወጅን ባና፤ ኑስ ገመኬኛን ገረ ለፈ ቆደኬሰኒት እስን ወጅን ንባና” ጄዸን። ከናፉ ነሞትን ስምኦን እሳን ወጅን በአን።<verse eid="JDG 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JDG 1:4"/>ዮሙ ይሁዳን በኤትስ <char style="nd">ዋቀዮ</char> ከነኣኖታፊ ፌርዞተ ደበርሴ ሀርከሳኒት ኬኔ፤ እሳንስ እዶ ቤዜቅ ጄዸሙት ነመ ኩመ ኩዸን ፍጠን። <verse eid="JDG 1:4"/><verse number="5" style="v" sid="JDG 1:5"/>አችትስ አዶኒ-ቤዜቅ አርገኒ እሰ ሎለን፤ ከነኣኖታፊ ፌርዞተስ ሞአተን። <verse eid="JDG 1:5"/><verse number="6" style="v" sid="JDG 1:6"/>አዶኒ-ቤዜቅ አቺ በቀቴ፤ እሳን ገሩ አርአኒ እሰ ቀበን፤ ቁበ አቡዱ ሀርካቲፊ ቁበ አቡዱ ሚለሳራ ኩተን።<verse eid="JDG 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JDG 1:7"/>ኤርገሲስ አዶኒ-ቤዜቅ፣ “ሞቶትን ቁብን አቡዱን ሀርከሳኒቲፊ ቁብን አቡዱን ሚለሳኒ እራ ጭረሜ ቶርባተምን ዋን ማዲኮ ጀለት ሀርጨኤ ፉናነቻ ቱረን። አመ ገሩ ዋቅን ዋኑመ አን እሳንት ሆጄዼ ና ዴብሴ” ጄዼ። እሳንስ ዬሩሳሌምት እሰ ፍደን፤ እንስ አችት ዱኤ።<verse eid="JDG 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JDG 1:8"/>ነሞትን ይሁዳ ዬሩሳሌሚንስ አከሱመ ዸአኒ ቀበተን። መጋለቲስ ጎራዴዻን ዸአኒ እብደ እት ቀብሲሰን።<verse eid="JDG 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JDG 1:9"/>ኤርገሲስ ነሞትን ይሁዳ ከነኣኖተ ብየ ጋራ፣ ኔጌቢፊ ገሞጂ ከራ ልጠ ቢፍቱ ኬሰ ጅራተን ሎሉዻፍ ገድ ቡአን። <verse eid="JDG 1:9"/><verse number="10" style="v" sid="JDG 1:10"/>ነሞተ ከነኣን ከኔን ኬብሮን እሼ ዱር ክርያት አርባቅ ጄዸምቱ ኬሰ ጅራተንትስ ዱለኒ ሼሻዪን፣ አሂመኒፊ ተልማይን ሞአተን። <verse eid="JDG 1:10"/><verse number="11" style="v" sid="JDG 1:11"/>አቺስ ነሞተ ብየ ዴቢር እሼ ዱር ክርያት ሴፌር ጄዸማ ቱርቴ ሰነ ኬሰ ጅራተንት ዱለን።<verse eid="JDG 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JDG 1:12"/>ካሌብስ፣ “አን ነመ ክርያት ሴፌር ሎሌ ቀበቱት እንተለኮ ኣክሳ ነንሄሩምሲሰ” ጄዼ። <verse eid="JDG 1:12"/><verse number="13" style="v" sid="JDG 1:13"/>ኦቦሌስ ካሌብ ቁጥሱን፣ ኦትኒኤል እልም ቄነዝ መጋለቲ ቀበቴ፤ ካሌብስ እንተለሳ ኣክሳ እሰት ሄሩምሲሴ።<verse eid="JDG 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JDG 1:14"/>እሼንስ ዬሮ ገረ ኦትኒኤል ዹፍቴት፣ አከ እን አባሼ ለፈ ቆቲሳ ከዸቱ እሰ ከካፍቴ። ካሌብስ ዮሙ እሼን ሀሬሼራ ቡቴት፣ “አን ማል ሲፍ ጎዹ?” ጄዼ እሼ ጋፈቴ።<verse eid="JDG 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JDG 1:15"/>እሼንስ ዴብፍቴ፣ “ዋን አዳ ቶኮ ና ጎዽ። አኩመ ኔጌብ ኬሰት ለፈ ና ኬንቴ ሰነ ቡርቃወን ብሻኒስ ና ኬን” ጄቴን። ካሌብስ ቡርቃወን ኦሊቲፊ ገዲ ኬኔፍ።<verse eid="JDG 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JDG 1:16"/>ሰኚወን ቄኒ ነምቸ አባ ኒቲ ሙሴ ሰና ነሞተ ገሞጂ ይሁዳ ኬሰ ኔጌብ እሼ ኣራድ ብረት አርገምቱ ኬሰ ጅራተን ግዱ ጅራቹፍ ጄዸኒ ነሞተ ይሁዳ ወጅን መጋላ ሜጢቲ ኦል በአን።<verse eid="JDG 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JDG 1:17"/>ነሞትን ይሁዳ ኦቦሎተሳኒ እልማን ስምኦን ወጅን ዸቀኒ ከነኣኖተ ዜፋት ኬሰ ጅራተን ወራነን፤ መጋለቲስ ጉቱማን ጉቱት በርበዴሰን። ከናፉ መጋለቲን ሆርማ ጄዸምቴ ዋመምቴ። <verse eid="JDG 1:17"/><verse number="18" style="v" sid="JDG 1:18"/>አከሱመስ ነሞትን ይሁዳ ጋዛ ገንዶተ ናኖሼ ወጅን፣ አሽቀሎን ገንዶተ ናኖሼ ወጅን፣ ኤቅሮን ናኖሼ ወጅን ቀበተን።<verse eid="JDG 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JDG 1:19"/>
    <char style="nd">ዋቀዮ</char> ነሞተ ይሁዳ ወጅን ቱሬ። ከናፉ እሳን ብየ ጋራ ሰነ ቀበተን፤ ገሩ ሰበቢ ነሞትን ድሬረ ጅራተን ጋሪወን ስቢላ ቀበኒፍ አቺ እሳን ባሱ ህንደንዴኜ። <verse eid="JDG 1:19"/><verse number="20" style="v" sid="JDG 1:20"/>አኩመ ሙሴን አብደቺሴ ቱሬት ኬብሮን ካሌቢፍ ኬነምቴ፤ እንስ እልማን አናቅ ሰደን አቺ አርኤ ባሴ። <verse eid="JDG 1:20"/><verse number="21" style="v" sid="JDG 1:21"/>እጆሌን ቤንያም ገሩ ዬቡሶተ ዬሩሳሌም ኬሰ ጅራቻ ቱረን ሰነ አቺ ባሱ ህንደንዴኜ፤ ሀመ አማት ዬቡሶን ቤንያሞተ ወጅን እዶ ሰነ ጅራተን።<verse eid="JDG 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JDG 1:22"/>ጎስት ዮሴፍሞ ቤትኤል ወራነን፤ <char style="nd">ዋቀዮስ</char> እሳን ወጅን ቱሬ። <verse eid="JDG 1:22"/><verse number="23" style="v" sid="JDG 1:23"/>ዮሙ እሳን ገረ ቤትኤል እሼ ዱር ሉዝ ጄዸምቱት በሳስቶተ ኤርገንት፣ <verse eid="JDG 1:23"/><verse number="24" style="v" sid="JDG 1:24"/>በሳስቶትን ሱን ነምቸ መጋላዻ በኤ ዹፉ ቶኮ አርገኒ፣ “ከራ እቲን መጋላ ሴነን ኑ አርግሲስ፤ ኑስ ዋን ጋሪ ሲፍ ጎነ” ጄዸኒን። <verse eid="JDG 1:24"/><verse number="25" style="v" sid="JDG 1:25"/>እንስ እት አርግሲሴ፤ እሳንስ ነምቸ ሰናፊ ማቲሳ ጉቱ ዺሰኒ መጋላ ሰነ ጎራዴዻን ዸአን። <verse eid="JDG 1:25"/><verse number="26" style="v" sid="JDG 1:26"/>ነምችስ ገረ ሄቶታ ዴሜ መጋላ ሎዛ ጄዸምቱ ሁንዴሴ፤ እሼንስ ሀመ አማት ሉዝ ጄዸምቴ ዋመምት።<verse eid="JDG 1:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JDG 1:27"/>ምናሴን ገሩ ነሞተ ቤት ሼኣኒቲፊ ገንዶተ ናኖሼ ዮካን ተአናኪፊ ገንዶተ ናኖሼ ዮካን ዶሪፊ ገንዶተ ናኖሼ ዮካን ይብሌኣሚፊ ገንዶተ ናኖሼ ዮካን ሜግዶፊ ገንዶተ ናኖሼ ጅራተን አቺ ህንባፍኔ፤ ከናፉ ከነኣኖትን እቱመ ፉፈኒ አች ጅራቹፍ ሙርቴፈተን። <verse eid="JDG 1:27"/><verse number="28" style="v" sid="JDG 1:28"/>እስራኤሎን ዮሙ ጀባቻ ዹፈንት አከ እሳን ሆጂ ሁምና ሆጄተን እሳን ድርቅሲሰን መሌ ከነኣኖተ ጉቱማን ጉቱት አቺ ህንባፍኔ። <verse eid="JDG 1:28"/><verse number="29" style="v" sid="JDG 1:29"/>ኤፍሬምስ ከነኣኖተ ጌዝር ኬሰ ጅራተን አቺ ህንባፍኔ፤ ከነኣኖትን ገሩ እቱመ ፉፈኒ አቹመ እሳን ግዱ ጅራተን። <verse eid="JDG 1:29"/><verse number="30" style="v" sid="JDG 1:30"/>ዜቡሎንስ ከነኣኖተ ቅጥሮን ዮካን ነሀሎል ኬሰ ጅራተን ከኔን ግዱሳኒት ሀፈን ህንባፍኔ፤ ገሩ አከ እሳን ሆጂ ሁምና ሆጄተን ጎዸን። <verse eid="JDG 1:30"/><verse number="31" style="v" sid="JDG 1:31"/>ኣሼርስ ወረ አኮ ዮካን ሲዶን ዮካን አህላብ ዮካን አክዚብ ዮካን ሄልባ ዮካን አፊቂፊ ሬሆብ ኬሰ ጅራተን ህንባፍኔ፤ <verse eid="JDG 1:31"/><verse number="32" style="v" sid="JDG 1:32"/>ነሞትን ኣሼር ሰበቢ እሳን ጀረ አርአኒ ህንባስኒፍ ከነኣኖተ ብየ ሰነ ጅረን ግዱ ጅራተን። <verse eid="JDG 1:32"/><verse number="33" style="v" sid="JDG 1:33"/>ንፍታሌም ወረ ቤት ሼሜሺፊ ቤት አናት ኬሰ ጅራተን ህንባፍኔ፤ ነሞትን ንፍታሌም ገሩ ከነኣኖተ ብየ ሰነ ቱረን ግዱ ጅራተን፤ ወር ቤት ሼሜሺፊ ቤት አናት ድርቀምሲፈመኒ ሆጂ ሁምና ሆጄቻፊ ቱረን። <verse eid="JDG 1:33"/><verse number="34" style="v" sid="JDG 1:34"/>አሞሮትንሞ ወረ ዳን ገረ ብየ ጋራት ዺበን መሌ አከ እሳን ሱሉለት ገድ ቡአን ህንኤየምኔፍ ቱሬ። <verse eid="JDG 1:34"/><verse number="35" style="v" sid="JDG 1:35"/>አሞሮትንስ እት ፉፈኒ ቱሉ ሄሬስረ፣ አያሎኒፊ ሸአልቢም ኬሰ ጅራተን፤ ገሩ ዮሙ ሁምን መነ ዮሴፍ ጀባቻ ዹፌት እሳንስ ሆጂ ሁምና እሳኒ ሆጄቹፍ ድርቅሲፈመን። <verse eid="JDG 1:35"/><verse number="36" style="v" sid="JDG 1:36"/>ዳሪን አሞሮታ አቅረቢሚ ጀልቀቤ ከራ ሴላቲን ኦል በአ ቱሬ።<verse eid="JDG 1:36"/></para>
  <chapter eid="JDG 1"/>
  <chapter number="2" style="c" sid="JDG 2"/>
  <para style="s1">ኤርገማ <char style="nd">ዋቀዮ</char> ቦኪም ኬሰት</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 2:1"/>ኤርገማን <char style="nd">ዋቀዮ</char> ግልጋሊ ቦኪምት ኦል በኤ አከነ ጄዼ፤ “አን ግብጢ እስን ባሴ ብየ አን አቦቲኬሰኒፍ ኬኑፍ ከከዼ ሰነት እስን ፍዴረ። አከነስ ነንጄዼ፤ ‘አን ከኩ እስን ወጅን ገሌ ሰነ ጎንኩማ ህንዲጉ፤ <verse eid="JDG 2:1"/><verse number="2" style="v" sid="JDG 2:2"/>እስንስ ወረ ለፈ ከነረ ጅራተን ወጅን ከኩ ህንገልና፤ እዶ ኣርሳሳኒ ገሩ ጨጨብሳ።’ ተኡስ እስን ናፍ ህንአጀጀምኔ። እስን ማሊፍ ዋን ከነ ጎተን? <verse eid="JDG 2:2"/><verse number="3" style="v" sid="JDG 2:3"/>ከናፉ አን አመ አከ ፉለኬሰን ዱራ አርኤ እሳን ህንባፍኔ እስንት ነንህመ፤ እሳን እዳ እስንት ተኡ፤ ዋቆንሳኒሞ ክዮ እስንት ተኡ።”<verse eid="JDG 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JDG 2:4"/>ዬሮ ኤርገማን <char style="nd">ዋቀዮ</char> ዋን ከነ እስራኤሎተ ሁንደት ዱበቴት ነሞትን ሰገሌሳኒ ኦል ፉዸተኒ ቦአን፤ <verse eid="JDG 2:4"/><verse number="5" style="v" sid="JDG 2:5"/>እሳንስ እዶ ሰነ ቦኪም ጄዸኒ ዋመን። አችትስ <char style="nd">ዋቀዮፍ</char> ኣርሳ ዽኤሰን።<verse eid="JDG 2:5"/></para>
  <para style="s1">አጀጀሙ ድዱፊ ሞአተሙ</para>
  <para style="r">
    <ref loc="JDG 2:6-9">2፥6‑9</ref> ኩወፈ – <char style="xt"><ref loc="JOS 24:29-31">እያ 24፥29‑31</ref></char></para>
  <para style="p">
    <verse number="6" style="v" sid="JDG 2:6"/>ኤርገ እያሱን እስራኤሎተ ገድ ዺሴ ቦዴ ቶኮን ቶኮንሳኒ ብየቲ ዻሉፍ ገረ ዻለ ኦፊሳኒ ዴመን። <verse eid="JDG 2:6"/><verse number="7" style="v" sid="JDG 2:7"/>ኡመትን በረ ጅሬኘ እያሱ ጉቱፊ በረ ማንጉዶተ ኤርገ እን ዱኤ አስ ሀፈኒ ጅራተኒ ዋን ጉዳ <char style="nd">ዋቀዮ</char> እስራኤሊፍ ጎዼ አርገን ሱንስ <char style="nd">ዋቀዮን</char> ተጃጅለን።<verse eid="JDG 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JDG 2:8"/>እያሱን እልም ኑን ገርብች <char style="nd">ዋቀዮ</char> ወጋ ዽበ ቶኮፊ ኩዸንት ዱኤ። <verse eid="JDG 2:8"/><verse number="9" style="v" sid="JDG 2:9"/>እሳንስ ለፈ ዻለሳ ትምናት ሄሬስ ከን ብየ ጋራ ኤፍሬምት ከራ ካበ ቱሉ ገኣሽት አርገምቱ ሰነት እሰ አዋለን።<verse eid="JDG 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JDG 2:10"/>ኤርገ ዸሎትን ሱን ጉቱን ገረ አቦቲሳኒት ወልት ቀበመኒ ቦዴ ዸሎትን <char style="nd">ዋቀዮን</char> ህንቤክን ዮካን ዋን እን ሰበ እስራኤሊፍ ጎዼ ህንቤክን ከን ብራ ከኤ። <verse eid="JDG 2:10"/><verse number="11" style="v" sid="JDG 2:11"/>እስራኤሎንስ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዋን ሀማ ሆጄተን፤ በኣሊንስ ንተጃጅለን። <verse eid="JDG 2:11"/><verse number="12" style="v" sid="JDG 2:12"/>እሳን <char style="nd">ዋቀዮ</char> ዋቀ አቦቲሳኒ ከን ግብጢ እሳን ባሴ ሰነ ንዺሰን። ዋቆተ አደ አዳ ከኔን ሰቦተ ናኖሳኒ ጅራተኒ ዱካ ቡአን፤ ንዋቄፈተንስ። <char style="nd">ዋቀዮንስ</char> ዼከምሳፍ ከካሰን፤ <verse eid="JDG 2:12"/><verse number="13" style="v" sid="JDG 2:13"/>እሳን እሰ ዺሰኒ በኣሊፊ አሽቶሬትን ዋቄፈተኒሩቲ። <verse eid="JDG 2:13"/><verse number="14" style="v" sid="JDG 2:14"/><char style="nd">ዋቀዮስ</char> እስራኤሎተት ዼከሜ ሳምቶተ እሳን ሳመንት ደበርሴ እሳን ኬኔ። ዲኖተ ናኖሳኒ ከኔን እሳን ኦፍራ እትሱ ህንደንዴኜ ሁንደት እሳን ጉርጉሬ። <verse eid="JDG 2:14"/><verse number="15" style="v" sid="JDG 2:15"/>ዮሙ እስራኤሎን ሎላፍ በአንት አኩመ እን ዱራን ከከቴ ሰነት ሀርክ <char style="nd">ዋቀዮ</char> እሳንት ሀማቴ አከ እሳን ሞአተመን ጎዸ ቱሬ። እሳንስ ረክነ ጉዳ ኬሰ ቡአን።<verse eid="JDG 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JDG 2:16"/>
    <char style="nd">ዋቀዮስ</char> አቦቲ ሙርቲ ከኔን ሳምቶተ ጀላ እሳን ባሰን እሳኒፍ ካሴ። <verse eid="JDG 2:16"/><verse number="17" style="v" sid="JDG 2:17"/>እሳን ገሩ ዋቆተ ብራ ወጅን ሰጋገለኒ እሳን ዋቄፈተን መሌ አቦቲ ሙርቲ ሰነ ህንዸጌፈትኔ። ከራ አቦቲንሳኒ <char style="nd">ዋቀዮፍ</char> አጀጀሙዻን እረ ዴማ ቱረን ሰነራ ደፈኒ ጀልአተን፤ እሳን ዋን አቦቲንሳኒ ጎዸን ህንጎኔ። <verse eid="JDG 2:17"/><verse number="18" style="v" sid="JDG 2:18"/><char style="nd">ዋቀዮ</char> ዬሮ አባ ሙርቲ ቶኮ እሳኒ ካሴት ሀመ አባን ሙርቲ ሱን ጅሩት እሰ ወጅን ጅራቴ ሀርከ ዲኖተሳኒ ጀላ እሳን ባሰ ቱሬ፤ <char style="nd">ዋቀዮ</char> ዬሮ እሳን ሰበቢ ወረ እሳን ጩንቁርሰኒፊ ወረ እሳን ሚዸኒቲን ወዋተንት ገራ ላፋፍ ቱሬቲ። <verse eid="JDG 2:18"/><verse number="19" style="v" sid="JDG 2:19"/>ዮሙ አባን ሙርቲ ሱን ዱኡ ገሩ እሳን ዋቆተ ብራ ዱካ ቡኡዻን፣ ተጃጅሉፊ እሳን ዋቄፈቹዻን አቦቲሳኒዩ ጫላ ገረ ሀምናት ዴብአን። ሆጂ ሀምናቲፊ መታ ጀብነሳኒራስ ህንዴብአን ቱሬ።<verse eid="JDG 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JDG 2:20"/>ከናፉ <char style="nd">ዋቀዮ</char> እስራኤልት አከ መሌ ዼከሜ አከነ ጄዼ፤ “ዋን ሰብን ኩን ከኩ አን አቦቲሳቲፍ ገሌ ሰነ ጨብሴ አነስ ዸገኡ ድዴፍ፣ <verse eid="JDG 2:20"/><verse number="21" style="v" sid="JDG 2:21"/>አን ስአች ሰቦተ እያሱን ዬሮ ዱኤት እሳን ግዱት ዺሴ ሰነ እሳን ዱራ አርኤ ህንባሱ። <verse eid="JDG 2:21"/><verse number="22" style="v" sid="JDG 2:22"/>ከራ ሰቦተ ከናቲንስ አከ እሳን አኩመ አቦቲሳኒ ከራ <char style="nd">ዋቀዮ</char> ኤገኒ እረ ዴዴብአኒፊ አከ እሳን ህንኤግኔ እላሉፍ ጄዼ እስራኤልን ነንቆረ።” <verse eid="JDG 2:22"/><verse number="23" style="v" sid="JDG 2:23"/>ከናፉ <char style="nd">ዋቀዮ</char> አከ ሰቦትን ኩኔን አቹመት ሀፈን ኤየሜ፤ ሀርከ እያሱትስ ደበርሴ እሳን ኬኑዻን ደፌ አቺ እሳን ህንባፍኔ።<verse eid="JDG 2:23"/></para>
  <chapter eid="JDG 2"/>
  <chapter number="3" style="c" sid="JDG 3"/>
  <para style="p">
    <verse number="1" style="v" sid="JDG 3:1"/>ሰቦትን <char style="nd">ዋቀዮ</char> እስራኤሎተ ወራነ ከነኣን ኬሰት ዴምስፈሜ ከምዩረት ህርማተኒ ህንቤክን ሁንደ ቆሩፍ ጄዼ እዱመ እሳን ቱረንት ሀምብሴ ከኔኒዸ፤ <verse eid="JDG 3:1"/><verse number="2" style="v" sid="JDG 3:2"/>እንስ አከ እስራኤሎን ከናን ዱረ ወራነ ኬሰት ህርማተኒ ህንቤክን ሙጠትኖ አርገተኒፍ ዋን ከነ ጎዼ፤ <verse eid="JDG 3:2"/><verse number="3" style="v" sid="JDG 3:3"/>ከኔን ኡቱ ህንበእን አቹመት ሀፈንስ፦ ቡልችቶተ ፍልስጤሞታ ሸነን፣ ከነኣኖተ ሁንደ፣ ሲዶኖታፊ ሂዎተ ቱሉ በኣል ሄርሞኒ ጀልቀበኒ ሀመ በልበለ ሀማትት ጋረን ልባኖን ጉባ ጅራተኒዸ። <verse eid="JDG 3:3"/><verse number="4" style="v" sid="JDG 3:4"/>እሳን ኩኔን ወረ እስራኤሎን አጀጀ <char style="nd">ዋቀዮ</char> ከን እን ከራ ሙሴቲን አቦቲ እሳኒፍ ኬኔ ቱሬ ሰነ ኤጉፊ ኤጉ ባቹሳኒ እቲን ቆረመኒ እላለመኒፍ ሀምብፈመኒዸ።<verse eid="JDG 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JDG 3:5"/>ከናፉ እስራኤሎን ከነኣኖተ፣ ሄቶተ፣ አሞሮተ፣ ፌርዞተ፣ ሂዎታፊ ዬቡሶተ ግዱ ጅራተን። <verse eid="JDG 3:5"/><verse number="6" style="v" sid="JDG 3:6"/>እሳንስ እንተለን ጀራ ፉዸን፤ እንተለን ኦፊሳኒሞ እልማንሳኒት ሄሩምሲሰን፤ ዋቆተሳኒስ ንዋቄፈተን።<verse eid="JDG 3:6"/></para>
  <para style="s1">ኦትኒኤል</para>
  <para style="p">
    <verse number="7" style="v" sid="JDG 3:7"/>እስራኤሎን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዋን ሀማ ሆጄተን፤ <char style="nd">ዋቀዮ</char> ዋቀሳኒ እራንፈተኒ በኣሊፊ አሼራ ዋቄፈተን። <verse eid="JDG 3:7"/><verse number="8" style="v" sid="JDG 3:8"/>ኣሪን <char style="nd">ዋቀዮ</char> እስራኤሎተት ቦበኤ፤ ከናፉ ሞቲ ጳዳን አራም ኩሸን-ርሻታይምት ደበርሴ እሳን ጉርጉሬ፤ እስራኤሎንስ ወጋ ሰዴት እሰ ጀለት ቡለን። <verse eid="JDG 3:8"/><verse number="9" style="v" sid="JDG 3:9"/><char style="nd">ዋቀዮ</char> ገሩ ዬሮ እሳን ገረሳት እየተንት ነመ እሳን ፉሩ ቶኮ ጄቹንስ ኦቦሌሰ ካሌብ ቁጥሱ፣ ኦትኒኤል እልመ ቄነዝ ሰነ አከ እን እሳን ፉሩፍ ካሴፍ። <verse eid="JDG 3:9"/><verse number="10" style="v" sid="JDG 3:10"/>ሀፉር <char style="nd">ዋቀዮ</char> እሰረ ቡኤ፤ ከናፉ እን አባ ሙርቲ እስራኤሎታ ተኤ ዱላፍ በኤ። <char style="nd">ዋቀዮስ</char> ኩሸን-ርሻታይም ሞትቸ ጳዳን አራም ሰነ ደበርሴ ሀርከ ኦኒኤልት ኬኔ፤ እንስ እሰ ሞአቴ። <verse eid="JDG 3:10"/><verse number="11" style="v" sid="JDG 3:11"/>ከናፉ ብይ ሱን ሀመ ኦትኒኤል እልም ቄነዝ ዱኡት ወጋ አፉርተመ ነጋ አርገቴ።<verse eid="JDG 3:11"/></para>
  <para style="s1">ናኦድ</para>
  <para style="p">
    <verse number="12" style="v" sid="JDG 3:12"/>አመስ እስራኤሎን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዋን ሀማ ሆጄተን፤ ሰበቢ እሳን ዋን ሀማ ከነ ሆጄተኒፍ <char style="nd">ዋቀዮ</char> አከ ኤግሎን ሞቲን ሞኣብ ሀርከሳ እሳንት ጭምሱፍ ደበርሴ እሳን ኬኔ። <verse eid="JDG 3:12"/><verse number="13" style="v" sid="JDG 3:13"/>እንስ አሞኖታፊ አማሌቆተ ወልት ቀበቴ እስራኤሎተ ወራኔ፤ እሳንስ መጋላ ሜጢ ቀበተን። <verse eid="JDG 3:13"/><verse number="14" style="v" sid="JDG 3:14"/>እስራኤሎን ወጋ ኩዸ ሰዴት ኤግሎን ሞቲ ሞኣብ ጀለት ቡለን።<verse eid="JDG 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JDG 3:15"/>እስራኤሎን አመስ ገረ <char style="nd">ዋቀዮት</char> እየተን፤ እንስ ነመ እሳን ፉሩ ቶኮ ጄቹንስ ኤሁድ ነመ ሀርከ ብታቻ፣ እልመ ጌራ ሰነ ጎሰ ቤንያም ኬሳ እሳኒ ካሴ። እስራኤሎንስ አከ እን ኤግሎን ሞቲ ሞኣብ ሰናፍ ግብረ ጌሱ ናኦድን ኤርገን። <verse eid="JDG 3:15"/><verse number="16" style="v" sid="JDG 3:16"/>ኤሁድስ ጎራዴ ገመ ለማን ቀረ ቀቡ ከን ሜትረ ወለካ ዼረቱ ቶልፈቴ ኡፈተሳ ጀላን ተፈ ምርጋት ህዸቴ። <verse eid="JDG 3:16"/><verse number="17" style="v" sid="JDG 3:17"/>ግብረ ሰነ ኤግሎን ሞትቸ ሞኣብ ነምቸ አከ መሌ ፉርዳ ቱሬ ሰናፍ ዽኤሴ። <verse eid="JDG 3:17"/><verse number="18" style="v" sid="JDG 3:18"/>ናኦድ ኤርገ ግብረ ሰነ ዽኤሴ ቦዴ ነሞተ ባተኒፊ ዹፈን ጌጌሴ። <verse eid="JDG 3:18"/><verse number="19" style="v" sid="JDG 3:19"/>እን ገሩ እዶ ዸጋን ባፈሙ ከን ግልጋል ብረት አርገሙ ብረ ገኤ ዱበት ዴብኡዻን፣ “ያ ሞቲ አን ዋን ዾክሳት ስት ህሙ ቶኮ ቀበ” ጄዼ።</para>
  <para style="p" vid="JDG 3:19">ሞትችስ፣ “ጨልእሳ!” ጄዼ፤ ወር እሰ ብረ ቱረን ሁንድኑስ እሰ ዺሰኒ በአን።<verse eid="JDG 3:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JDG 3:20"/>ኡቱ ሞትች ኩታ መነሳ እዶ ቀበናኣ ቶኮ ኮጳሳ ታኤ ጅሩ ኤሁድ እት ዽኣቴ፣ “አን ኤርጋ ዋቀ ብራ ሲፍ ኤርገሜ ቀበ” ጄዼን። ኤግሎንስ ቴሶሳራ ኦል ከኤ፤ <verse eid="JDG 3:20"/><verse number="21" style="v" sid="JDG 3:21"/>ኤሁድ ሀርከሳ ብታ ድሪርሴ ተፈ ምርገሳራ ጎራዴ ሉቅፈቴ ገራ ሞትቻ ኬሰ ፉላሴ። <verse eid="JDG 3:21"/><verse number="22" style="v" sid="JDG 3:22"/>ቀበትኖንሳስ ኡቱ ህንሀፍን ገራ ሴኔ ስቢልሳ ዱባን በኤ። ናኦድ ጎራድቸ ገራ ሞትቻ ኬሳ ህንቡቅፍኔ፤ ሞርስ ጎራዴ ሰነ ሀጉጌ ቱሬ። <verse eid="JDG 3:22"/><verse number="23" style="v" sid="JDG 3:23"/>ኤርገሲስ ኤሁድ ኤግሎንት በልበለ ጩፌ ከራ ቦሮቲን በኤ ቀጄሌ።<verse eid="JDG 3:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JDG 3:24"/>ኤርገ ኤሁድ ዴሜ ቦዴ ተጃጅልቶትን ሞትቻ ዹፈን፤ በልበለ ኩታ መነ ኦል ኣኑስ አኩመ እን ጩፈሜ ጅሩት አርገን። እሳንስ፣ “ተሪ እን መነ ቦሊ ገድ ታኤ ጅረ ተአ” ጄዸን። <verse eid="JDG 3:24"/><verse number="25" style="v" sid="JDG 3:25"/>ሀመ ደዸበንትስ ኤገን፤ ገሩ ዋን እን ኡቱ በልበለ ህንበንን ቱሬፍ ፉርቱ ፉዸተኒ በልበለ በነን። ኩኖ ጎፍታንሳኒ ዱኤ ለፈረ ድሪሬ ቱሬ።<verse eid="JDG 3:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JDG 3:26"/>ኡቱመ እሳን ዻበተኒ ኤጋ ጅረኑ ኤሁድ ፈጋቴ ዴሜ። ከራ ለፈ ዸጋን እት ሶፈሙቲን ደርቤ ገረ ሴኢራት በቀቴ። <verse eid="JDG 3:26"/><verse number="27" style="v" sid="JDG 3:27"/>እንስ ዮሙ አች ገኤት ብየ ጋራ ኤፍሬም ኬሰት መለከተ አፉፌ፤ እስራኤሎንስ ሆገንቱማሳቲን ብየ ጋራ ሰነራ እሰ ወጅን ገድ ቡአን።<verse eid="JDG 3:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JDG 3:28"/>ኤሁድስ፣ “ዲነኬሰን ሞኣብን <char style="nd">ዋቀዮ</char> ደበርሴ ሀርከኬሰንት እስኒ ኬኔራቲ ነ ዱካ ቡኣ!” ጄዼን። እሳንስ መልካ ዮርዳኖስ ከን ገረ ሞኣብት ጌሱ ሰነ ቀበተኒ ነመ ቶኮሌ አቺን ደርቡ ዾወን። <verse eid="JDG 3:28"/><verse number="29" style="v" sid="JDG 3:29"/>ዬሮ ሰነት ሞኣቦተ ሁንድሳኒ ጀጀቦፊ ሁምነ ቀቤዪ ተአን ኩመ ኩዸን ፍጠን፤ ነምን ቶኮዩ እሳን ጀላ ህንባኔ። <verse eid="JDG 3:29"/><verse number="30" style="v" sid="JDG 3:30"/>ጋፈ ሰነ ሞኣብ ሀርከ እስራኤልት ገልፈምቴ፤ ብየቲንስ ወጋ ሰዴተማፍ ነጋ አርገቴ።<verse eid="JDG 3:30"/></para>
  <para style="s1">ሸምጋር</para>
  <para style="p">
    <verse number="31" style="v" sid="JDG 3:31"/>ኤሁድት ኣኔ ሸምጋር እልም አናት ከኤ፤ እንስ ኡሌ እቲን ቆትዮ ቱቱቀኒን ፍልስጤሞተ ዽበ ጀአ ፍጤ። አከሲንስ እስራኤሎተ በራሬ።<verse eid="JDG 3:31"/></para>
  <chapter eid="JDG 3"/>
  <chapter number="4" style="c" sid="JDG 4"/>
  <para style="s1">ዴቦራ</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 4:1"/>ኤርገ ኤሁድ ዱኤ ቦዴ እስራኤሎን አመስ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዋን ሀማ ሆጄተን። <verse eid="JDG 4:1"/><verse number="2" style="v" sid="JDG 4:2"/>ከናፉ <char style="nd">ዋቀዮ</char> ያቢን ሞቲ ከነኣን ከን ሃዞር ታኤ ቡልቻ ቱሬት ደበርሴ እሳን ጉርጉሬ። አጀጃን ሎልቶተሳ ሲሳራ ጄዸመ ቱሬ፤ እንስ ሀሮሼት ሀጎይም ኬሰ ጅራተ ቱሬ። <verse eid="JDG 4:2"/><verse number="3" style="v" sid="JDG 4:3"/>እን ሰበቢ ጋሪወን ስቢላ ዽበ ሰገል ቀቡፍ ወጋ ድግደመ አከ መሌ እስራኤሎተ ሀጩጬ፤ እሳንስ ገርጋርሰ በርባቸ <char style="nd">ዋቀዮት</char> እየተን።<verse eid="JDG 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JDG 4:4"/>ዬሮ ሰነት ኒቲን ለፊዶት ዴቦራን ራጅቲን እስራኤልን ቡልቻ ቱርቴ። <verse eid="JDG 4:4"/><verse number="5" style="v" sid="JDG 4:5"/>እሼንስ ብየ ጋራ ኤፍሬምት ሙከ ሜጢ ዴቦራ ከን ራማፊ ቤትኤል ግዱት አርገሙ ሰነ ጀለ ቴሴ ሙርቲ ኬና ቱርቴ። ሰብን እስራኤልስ ሙርቲ አርገቹፍ ገረሼ ዹፋ ቱሬ። <verse eid="JDG 4:5"/><verse number="6" style="v" sid="JDG 4:6"/>እሼንስ ባራቅ እልመ አቢኖአም ብየ ንፍታሌም መጋላ ቃዴሺቲ ዋምስፈቴ አከነ ጄቴን፤ “<char style="nd">ዋቀዮ</char> ዋቅን እስራኤል አከነ ጄዼ ስ አጀጀ፤ ‘ከእ፤ ጎሰ ንፍታሌሚፊ ጎሰ ዜቡሎን ኬሳ ነመ ኩመ ኩዸን ፉዸዹቲ ቱሉ ታቦሪት ኦል በእ። <verse eid="JDG 4:6"/><verse number="7" style="v" sid="JDG 4:7"/>አንስ ሲሳራ፣ አጀጃ ሎልቶተ ያቢን ሰነ ጋሪወን ሎላቲፊ ሎልቶተሳ ወጅን አከ እን ገረ ለገ ቂሾንት በኡ ነንከካሰ፤ እሰስ ሀርከኬት ደበርሴ ነንኬነ።’ ”<verse eid="JDG 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JDG 4:8"/>ባራቅስ፣ “ዮ አት ነ ወጅን ዴምቴ፣ አን ነንዴመ፤ ዮ አት ነ ወጅን ህንዴምን ገሩ አንስ ህንዴሙ” ጄዼን።<verse eid="JDG 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JDG 4:9"/>ዴቦራንስ፣ “አን ዹጉማን ስ ፋነ ነንዴመ። ዮ አት ሃለ ከናን ዴምቴ ገሩ ኡልፍን ስኢፍ ህንተኡ፤ <char style="nd">ዋቀዮ</char> ደበርሴ ሲሳራ ሀርከ ዱበርቲት ኬናቲ” ጄቴን። ከናፉ ዴቦራን ባራቅ ፋነ ገረ ቃዴሽ ዴምቴ፤ <verse eid="JDG 4:9"/><verse number="10" style="v" sid="JDG 4:10"/>ባራቅስ አችት ነሞተ ጎሰ ዜቡሎኒፊ ጎሰ ንፍታሌም ወልት ዋሜ። ነሞትን ኩመ ኩዸን እሰ ዱካ ቡአን፤ ዴቦራንስ እሰ ፋነ ዴምቴ።<verse eid="JDG 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JDG 4:11"/>ዬሮ ሰነት ሄቤር ነምች ጎሰ ቄን አባን ኒቲ ሙሴ ሱን ቄኖተ እልማን ሆባብ ካንራ ጭቴ ቃዴሽ ብረት ለፈ ዘኣናኒም ጄዸሙት ቅልጡ ጉዳ ጀለ ዱንካነሳ ዻበቴ ቱሬ።<verse eid="JDG 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JDG 4:12"/>ሲሳራን ዮሙ አከ ባራቅ እልም አቢኖአም ሱን ገረ ቱሉ ታቦርት ኦል በኤ ዸገኤት፣ <verse eid="JDG 4:12"/><verse number="13" style="v" sid="JDG 4:13"/>ጋሪወን ስቢላ ዽበ ሰገሊፊ ሎልቶተሳ ከኔን ሀሮሼት ሀጎይሚ ሀመ ለገ ቂሾንት አርገመን ሁንዱማ ወልት ቀበቴ።<verse eid="JDG 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JDG 4:14"/>ከነረት ዴቦራን ባራቂን፣ “ከእ! ጉያን <char style="nd">ዋቀዮ</char> ሲሳራ ደበርሴ ሀርከኬት ኬኔ ሀርአ። ኩኖ <char style="nd">ዋቀዮ</char> ስ ዱረ በኤረ” ጄቴ። ከናፉ ባራቅ ነሞተ ኩመ ኩዸን ፉዸቴ ቱሉ ታቦርራ ገድ ቡኤ። <verse eid="JDG 4:14"/><verse number="15" style="v" sid="JDG 4:15"/><char style="nd">ዋቀዮስ</char> አከ ሲሳራን፣ ጋሪወንሳቲፊ ሎልቶትንሳ ሁንድኑ ጎራዴዻን ፉለ ባራቅ ዱረት ሞአተመኒ ዱበት ዴብአን ጎዼ፤ ሲሳራን ጋሪሳራ ቡኤ ሚላን በቀቴ።<verse eid="JDG 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JDG 4:16"/>ባራቅ ገሩ ጋሪወኒፊ ሎልቶተ ሲሳራ ሀመ ሀሮሼት ሀጎይሚት አርኤ፤ ሎልቶትን ሲሳራ ሁንድኑ ጎራዴዻን ዹመን። ነምን ቶኮዩ ህንሀፍኔ። <verse eid="JDG 4:16"/><verse number="17" style="v" sid="JDG 4:17"/>ሲሳራን ገሩ ሰበቢ ያቢን ሞትቸ ሃዞሪፊ ሄቤር ነምቸ በልበለ ቄን ሰነ ግዱ ሀሪሮን ጋሪን ቱሬፍ ገረ ዱንካነ ያኤል ኒቲ ሄቤር ሰናት ሚላን በቀቴ።<verse eid="JDG 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JDG 4:18"/>ያኤልስ ሲሳራ ስመቹፍ ገድ ባቴ፣ “ኮቱ ያ ጎፍታኮ፤ ኮቱ ኦል ሴን፤ ህንሶዳትን” እሳን ጄቴ። እንስ ዱንካነሼ ሴኔ፤ እሼንስ ወያ እሰረ ቡፍቴ ዾክስቴ።<verse eid="JDG 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JDG 4:19"/>እንስ፣ “አን ዼቦዼረ፤ ማሎ ብሻን ና ኬን” ጄዼን። እሼንስ ቀቤ ኣነኒ በንቴ ዋን እን ዹጉ ኬንቴፊ እሰ ዾክስቴ።<verse eid="JDG 4:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JDG 4:20"/>እንስ፣ “በልበለ ዱንካና ዱረ ዻበዹ፤ ዮ ኤኙዩ ዹፌ፣ ‘ነምን አስ ጅራ?’ ሲን ጄዼ፣ ‘ህንጅሩ’ ጄዽ” እሼን ጄዼ።<verse eid="JDG 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JDG 4:21"/>ያኤል ኒቲን ሄቤር ገሩ ኡቱ ሲሳራን ህርበ ጭማ ኬሰ ጅሩ ቆፎ ዱንካናፊ ቡሩሰ ፉዸቴ ሱተ ጄቴ ብረ ጌሴ። ቆፎ ሰናንስ እሰ ወራንቴ ለፈት ሆዽቴ፤ እንስ ንዱኤ።<verse eid="JDG 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JDG 4:22"/>ዮሙ ባራቅ ሲሳራ ዱካ ቡኤ ዹፌትስ፣ ያኤል እሰ ስመቹዻፍ ገድ ባቴ፣ “ኮቱ ነመ አት በርባዱ ስተን አርግሲሳ” ጄቴን። ከናፉ እን እሼ ወጅን ገረ ዱንካንቻት ኦል ሴኔ ሲሳራ አኩመ እሌንሳ ቆፎዻን ወራነሜት ሬፈሳ አርጌ።<verse eid="JDG 4:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JDG 4:23"/>ዋቅንስ ጋፈ ሰነ አከ ያቢን ሞቲን ከነኣኖታ ፉለ እስራኤሎታ ዱረት ሞአተሙ ጎዼ። <verse eid="JDG 4:23"/><verse number="24" style="v" sid="JDG 4:24"/>ሀርክ እስራኤሎታስ ሀመ እሳን ያቢን ሞትቸ ከነኣኖታ ገላፈተንት ጀጀባቻ ዴሜ።<verse eid="JDG 4:24"/></para>
  <chapter eid="JDG 4"/>
  <chapter number="5" style="c" sid="JDG 5"/>
  <para style="s1">ፋርፈትና ዴቦራ</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 5:1"/>ጋፈስ ዴቦራፊ ባራቅ እልም አቢኖአም አከነ ጄዸኒ ፋርፈተን፦<verse eid="JDG 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JDG 5:2"/>“ዮሙ እልማን ሞቶታ እስራኤልን ሆገነን፣</para>
  <para style="q2" vid="JDG 5:2">ዮሙ ሰብን እስራኤልስ ጃለቴ ኦፍ ኬኑት</para>
  <para style="q2" vid="JDG 5:2">
    <char style="nd">ዋቀዮን</char> ገለቴፈዻ!<verse eid="JDG 5:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="JDG 5:3"/>“ያ ሞቶተ፣ ዋን ከነ ዸገኣ! ቡልችቶትንስ ዸጌፈዻ!</para>
  <para style="q2" vid="JDG 5:3">
    <char style="nd">ዋቀዮን</char> ነንፋርፈዸ፤ አመሌ ነንፋርፈዸ፤</para>
  <para style="q2" vid="JDG 5:3">
    <char style="nd">ዋቀዮ</char> ዋቀ እስራኤሊፍ ነንዌድሰ።<verse eid="JDG 5:3"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="JDG 5:4"/>“ያ <char style="nd">ዋቀዮ</char>፣ ዬሮ አት ብየ ሴኢሪ ባቴ፣</para>
  <para style="q2" vid="JDG 5:4">ዬሮ አት ብየ ኤዶሚ ካቴ፣</para>
  <para style="q1" vid="JDG 5:4">ለፍት ንሶቾቴ፤ ሰሚወንስ ቦካ፣</para>
  <para style="q2" vid="JDG 5:4">ዱሜሶትንስ ብሻን ገድ ሮብሰን።<verse eid="JDG 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JDG 5:5"/>ቱሉወን ፉለ <char style="nd">ዋቀዮ</char> ዋቀ ሲና ዱረት፣</para>
  <para style="q2" vid="JDG 5:5">ፉለ <char style="nd">ዋቀዮ</char> ዋቀ እስራኤል ዱረት ንራፈመን።<verse eid="JDG 5:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="JDG 5:6"/>“በረ እልመ አናት፣ ጀበነ ሸምጋር፣</para>
  <para style="q2" vid="JDG 5:6">በረ ያኤል ኬሰ ዳንዲወን ንኦነን፤</para>
  <para style="q2" vid="JDG 5:6">ከራ ዴምቶትንስ ዳንዲ ጀጀልኣረ ዴመን።<verse eid="JDG 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JDG 5:7"/>ሀመ አን ዴቦራን፣</para>
  <para style="q2" vid="JDG 5:7">ሃዸ ተኤ እስራኤሊፍ ከኡት፣</para>
  <para style="q2" vid="JDG 5:7">ገንዶትን እስራኤል ዱዋ ሀፉ።<verse eid="JDG 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JDG 5:8"/>ዮሙ እሳን ዋቆተ ሃራ ፍለተንት፣</para>
  <para style="q2" vid="JDG 5:8">ወራን ሀመ ከረ መጋላት ዹፌ፤</para>
  <para style="q1" vid="JDG 5:8">ጋቸን ዮካን ኤቦን ቶኮ፣</para>
  <para style="q2" vid="JDG 5:8">እስራኤሎተ ኩመ አፉርተመ ግዱት ህንአርገምኔ።<verse eid="JDG 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JDG 5:9"/>ገራንኮ ቡልችቶተ እስራኤል ከኔን ፌዺዻን</para>
  <para style="q2" vid="JDG 5:9">ሰበ ግዱት አርገመን ወጅን ጅረ።</para>
  <para style="q2" vid="JDG 5:9">
    <char style="nd">ዋቀዮን</char> ሌልሳ!<verse eid="JDG 5:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JDG 5:10"/>“እስን ወር ሀሮተ አዳዲ ያበተን፣</para>
  <para style="q2" vid="JDG 5:10">ወር ኮራ በለዲ ቀቡረ ቴሰን፣</para>
  <para style="q2" vid="JDG 5:10">ወር ከራረ ዴምተን ሁበዻ፤<verse eid="JDG 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JDG 5:11"/>ሰገሌ ፋርፈቶታ ዸገኣ።</para>
  <para style="q2" vid="JDG 5:11">እሳን ሆጂ ቀጄሉማ <char style="nd">ዋቀዮ</char>፣</para>
  <para style="q2" vid="JDG 5:11">ሆጂ ቀጄሉማ ሎልቶትንሳ እስራኤል ኬሰት ጎዸን ኦዴሱ።</para>
  <para style="b" vid="JDG 5:11"/>
  <para style="q1" vid="JDG 5:11">“ኤርገሲ ሰቦትን <char style="nd">ዋቀዮ</char>፣</para>
  <para style="q2" vid="JDG 5:11">ገረ ከረ መጋለቲት ገድ ቡአን።<verse eid="JDG 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JDG 5:12"/>‘ያ ዴቦራ! ደመቅ፤ ደመቅ፤</para>
  <para style="q2" vid="JDG 5:12">ደመቅ፤ ደመቅ፤ ፋርፈናስ ፋርፈዹ!</para>
  <para style="q1" vid="JDG 5:12">ያ ባራቅ! ደመቅ፤</para>
  <para style="q2" vid="JDG 5:12">ያ እልመ አቢኖአም ቦጅአምቶተኬ ቦጅኢ ፉዸዹ።’<verse eid="JDG 5:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JDG 5:13"/>“ነሞትን ሀፈንስ፣ ገረ ወረ ጉርጉዳት ገድ ቡአን፤</para>
  <para style="q2" vid="JDG 5:13">ሰብን <char style="nd">ዋቀዮስ</char>፣ አከ ሎልቱ ጀባት ገረኮ ዹፌ።<verse eid="JDG 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JDG 5:14"/>ወር ህድሳኒ አማሌቅ ኬሰ ጅሩ ቶኮ ቶኮስ ኤፍሬም ዹፈን፤</para>
  <para style="q2" vid="JDG 5:14">ቤንያምስ ነሞተ ስ ዱካ ቡአን ወጅን ቱሬ።</para>
  <para style="q1" vid="JDG 5:14">አጀጆትን ሎልቶተ ማኪር፣</para>
  <para style="q2" vid="JDG 5:14">ወር ቦኩ አጀጁ ቀበተንስ ዜቡሎኒ ገድ ቡአን።<verse eid="JDG 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JDG 5:15"/>ሀንገፎትን ይሳኮር ዴቦራ ወጅን ቱረን፤</para>
  <para style="q2" vid="JDG 5:15">ይሳኮርስ ባራቅ ወጅን ቱሬ፤</para>
  <para style="q2" vid="JDG 5:15">እንስ ባራቅ ወጅን ገረ ሱሉላት ገድ ቡኤ።</para>
  <para style="q1" vid="JDG 5:15">ጎሰ ሩቤን ግዱ፣</para>
  <para style="q2" vid="JDG 5:15">ቆረትኖ ያዳ ጉዳቱ ቱሬ።<verse eid="JDG 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JDG 5:16"/>አት ማሊፍ መርአቹሳኒ ዸገኡፍ ጄቴ</para>
  <para style="q2" vid="JDG 5:16">ጎለ ቡሻዬ ኬሰ ቱርቴ?</para>
  <para style="q1" vid="JDG 5:16">ጎሰ ሩቤን ግዱ፣</para>
  <para style="q2" vid="JDG 5:16">ቆረትኖ ያዳ ጉዳሳቱ ቱሬ።<verse eid="JDG 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JDG 5:17"/>ግልኣድ ዮርዳኖስ ገመ ታኤ፤</para>
  <para style="q2" vid="JDG 5:17">ዳን ማሊፍ ዶኒወን ኬሰት ሀፌ?</para>
  <para style="q1" vid="JDG 5:17">ኣሼር ቀርቀረ ገላናት ሀፌ፤</para>
  <para style="q2" vid="JDG 5:17">ቡፈተሳ ኬሰስ ቱሬ።<verse eid="JDG 5:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JDG 5:18"/>ሰብን ዜቡሎን ዱኣፍ ኦፍ ሳጥሌ፤</para>
  <para style="q2" vid="JDG 5:18">ንፍታሌምስ ጋረን ብየሳረት አከሱመ ጎዼ።<verse eid="JDG 5:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="JDG 5:19"/>“ሞቶትን ዹፈኒ ሎለን፤</para>
  <para style="q2" vid="JDG 5:19">ሞቶትን ከነኣንስ ተአናክት</para>
  <para style="q1" vid="JDG 5:19">ብሻኖተ ሜግዶ ብረት ሎለን፤</para>
  <para style="q2" vid="JDG 5:19">ቦጁ ሜቲ ቶኮሌ ህንፉዸትኔ።<verse eid="JDG 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JDG 5:20"/>ሰሚ ኬሳ ኡርጂወን ንሎለን፤</para>
  <para style="q2" vid="JDG 5:20">አዴምሰሳኒረትስ ሲሳራዻን ሎለን።<verse eid="JDG 5:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JDG 5:21"/>ለግን ዱሪ፣ ለግን ቂሾን፣</para>
  <para style="q2" vid="JDG 5:21">ለግን ቂሾን ሱን ሀጣኤ እሳን ፉዸቴ።</para>
  <para style="q2" vid="JDG 5:21">ያ ሉቡኮ፣ ጀባዹ ፉል ዱረት ዴም!<verse eid="JDG 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JDG 5:22"/>ኮቴን ፈርዴኒ ጉድሴ ድድቼ፤</para>
  <para style="q2" vid="JDG 5:22">ንጉሉፈን፤ ጀቤሰኒስ ጉሉፈን።<verse eid="JDG 5:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JDG 5:23"/>ኤርገማን <char style="nd">ዋቀዮስ</char>፣ ‘ሜሮዝን አባራ።</para>
  <para style="q2" vid="JDG 5:23">ሰበሼስ ጀቤሳቲ አባራ፤</para>
  <para style="q1" vid="JDG 5:23">አከ <char style="nd">ዋቀዮ</char> ወረ ጀጀቦት ከኡ ገርጋሩዻፍ፣</para>
  <para style="q2" vid="JDG 5:23">እሳን <char style="nd">ዋቀዮን</char> ገርጋሩዻፍ ህንዹፍኔቲ’ ጄዼ።<verse eid="JDG 5:23"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="JDG 5:24"/>“ያኤል ኒቲን ሄቤር ቄንቻ ሱን</para>
  <para style="q2" vid="JDG 5:24">ዱበርቶተ ሁንደ ኬሳ ሃኤብፈምቱ፤</para>
  <para style="q2" vid="JDG 5:24">እሼን ዱበርቶተ ዱንካነ ኬሰ ጅራተን ሁንደ ኬሳ ሃኤብፈምቱ።<verse eid="JDG 5:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JDG 5:25"/>እን ብሻን ከዸቴ፤ እሼንሞ ኣነን ኬንቴፍ፤</para>
  <para style="q2" vid="JDG 5:25">ቀቤ ኡልፍናት እትቱ ዽኤስቴፍ።<verse eid="JDG 5:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JDG 5:26"/>ሀርከሼ ገረ ቆፎ ዱንካናት ሂጠቴ፤</para>
  <para style="q2" vid="JDG 5:26">ሀርከሼ ምርጋቲን ቡሩሰ ፉዸቴ፤</para>
  <para style="q1" vid="JDG 5:26">እሼንስ ሲሳራ ዾፍቴ መታሳ ቡሩቅስቴ፤</para>
  <para style="q2" vid="JDG 5:26">ወራንቴስ እሌሳ ኬሰ ፉላፍቴ።<verse eid="JDG 5:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JDG 5:27"/>እንስ ሚለሼ ጀለት ጎምብፈሜ፤</para>
  <para style="q2" vid="JDG 5:27">ኩፌ ድሪሬስ።</para>
  <para style="q1" vid="JDG 5:27">ሚለሼ ጀለት ጎምብፈሜ፤ ንኩፌ፤</para>
  <para style="q2" vid="JDG 5:27">እዶ ጎምብፈሜትስ ኩፌ ዱኤ።<verse eid="JDG 5:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="JDG 5:28"/>“ሃት ሲሳራ ፎዳ ኬሳን ገድ እላልቴ፤</para>
  <para style="q2" vid="JDG 5:28">ቃወ ኬሳንስ እይቴ፣</para>
  <para style="q1" vid="JDG 5:28">‘ጋሪንሳ ማሊፍ ዹፉፍ ለፈረ ሀርክፈቴ?</para>
  <para style="q2" vid="JDG 5:28">ድድቹን ጋሪወንሳ ማሊፍ ቱሬ?’ ጄቴ።<verse eid="JDG 5:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JDG 5:29"/>ዱበርቶተሼ ኬሳ እሼን ኦጌቲን ዴቢ ኬንቴፍ፤</para>
  <para style="q2" vid="JDG 5:29">ተኡስ እሼን ኦፉመሼቲን ዴብፍቴ፣<verse eid="JDG 5:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JDG 5:30"/>‘እሳን ቦጁ አርገተኒ አዳን ቆደቹት ጅሩ ምቲ?</para>
  <para style="q2" vid="JDG 5:30">ቶኮን ቶኮን ነማ ዱበርቲ ቶኮ ቶኮ</para>
  <para style="q2" vid="JDG 5:30">ዮካን ለመ ለመ አርገተ ምቲ?</para>
  <para style="q1" vid="JDG 5:30">ሲሳራዻፍ ኡፈትን ቦጁ ከን ሀሉዻን ፋዬፈሜ፣</para>
  <para style="q2" vid="JDG 5:30">ኡፈትን ሀሉዻን ሚዸግፈሜ ሆዸሜ፣</para>
  <para style="q2" vid="JDG 5:30">ሞርመኮቲፍሞ ኡፈተ አከ መሌ</para>
  <para style="q1" vid="JDG 5:30">ሚዸግፈሜ ሆዸሜ ቆዱ ምቲ?</para>
  <para style="q2" vid="JDG 5:30">ኩን ሁንድ ቦጁዸ።’<verse eid="JDG 5:30"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="JDG 5:31"/>“ከናፉ ያ <char style="nd">ዋቀዮ</char>፣ ዲኖትንኬ ሁንድ ሃበርበዳአን!</para>
  <para style="q2" vid="JDG 5:31">ወር ስ ጃለተን ገሩ አከ ቢፍቱ፣</para>
  <para style="q2" vid="JDG 5:31">እሼ ሁምነ ጉቱን ባቱ ሰና ሃተአን።”</para>
  <para style="p" vid="JDG 5:31">ኤርገሲ ብየቲን ወጋ አፉርተመ ነጋ አርገቴ።<verse eid="JDG 5:31"/></para>
  <chapter eid="JDG 5"/>
  <chapter number="6" style="c" sid="JDG 6"/>
  <para style="s1">ግዴዎን</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 6:1"/>እስራኤሎን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዋን ሀማ ሆጄተን፤ እንስ ደበርሴ ወጋ ቶርባፍ ሀርከ ምድያኖታት እሳን ኬኔ። <verse eid="JDG 6:1"/><verse number="2" style="v" sid="JDG 6:2"/>እስራኤሎን ሰበቢ ሀርክ ምድያኖታ እሳንት ጀባቴፍ ቱሉወንረት፣ ሆልቃፊ ደአትኖ ጀባ ኬሰት ኦፊሳኒቲፍ እዶ ጅራተኒፊ እዶ እት ደአተን ቆጴፈተን። <verse eid="JDG 6:2"/><verse number="3" style="v" sid="JDG 6:3"/>ዬሮ እስራኤሎን ምዻን ፈጫፈተን ሁንደ ምድያኖትን፣ አማሌቆትኒፊ ነሞትን በአ ቢፍቱ ካን ዹፈኒ እሳን ዌረሩ ቱረን። <verse eid="JDG 6:3"/><verse number="4" style="v" sid="JDG 6:4"/>አችስ ቁበተኒ ምዻን ሀመ ጋዛት ጅሩ ሁንዱማ በሌሰን፤ እሳን ዋን ሉቡ ቀቡ ሆሎተ፣ ሎን ዮካን ሀሮተ ቶኮሌ እስራኤሎታፍ ህንሀምብፍኔ። <verse eid="JDG 6:4"/><verse number="5" style="v" sid="JDG 6:5"/>አኩመ ቱተ ሀዋንሳትስ ሆሪፊ ዱንካነሳኒ ፉዸተኒ እሳንረ ያአን። ነሞታፊ ጋለወንሳኒ ለካኡን ህንደንደአሙ ቱሬ፤ እሳንስ ብየ ሰነ በርበዴሱዻፍ ዌረረን። <verse eid="JDG 6:5"/><verse number="6" style="v" sid="JDG 6:6"/>ሰበቢ ምድያኖትን አከ መሌ እሳን ህዮምሰኒፍ እስራኤሎን ገርጋርሰ በርባቸ ገረ <char style="nd">ዋቀዮት</char> እየተን።<verse eid="JDG 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JDG 6:7"/>ዬሮ እስራኤሎን ሰበቢ ምድያኖታቲፍ ገረ <char style="nd">ዋቀዮት</char> እየተንት፣ <verse eid="JDG 6:7"/><verse number="8" style="v" sid="JDG 6:8"/>እን ራጂ አከነ ጄዼ ዱበቱ ቶኮ እሳኒፍ ኤርጌ፤ “<char style="nd">ዋቀዮ</char> ዋቅን እስራኤል አከነ ጄዸ፦ አን ብየ ግብጥ፣ ብየ ገርቡማቲ ባሴን እስን ፍዴ። <verse eid="JDG 6:8"/><verse number="9" style="v" sid="JDG 6:9"/>አን ሁምነ ወረ ግብጢፊ ሀርከ ጩንቁርስቶታ ጀላ እስን ፉሬ ፉለኬሰን ዱራስ አርኤ እሳን ባሴ ብየሳኒ እስኒ ኬኔረ። <verse eid="JDG 6:9"/><verse number="10" style="v" sid="JDG 6:10"/>እስኒንስ፣ ‘አን <char style="nd">ዋቀዮ</char> ዋቀኬሰን፤ ዋቆተ አሞሮታ ከኔን እስን ብየሳኒ ኬሰ ጅራተን ሰና ህንዋቄፈትና’ ጄዼረ። እስን ገሩ ሰገሌኮ ህንዸጌኜ።”<verse eid="JDG 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JDG 6:11"/>ኤርገማን <char style="nd">ዋቀዮስ</char> ገንደ ኦፍራ ጄዸሙ ዹፌ ቅልጡ ዮኣሽ ነምቸ ሰኚ አቢኤዜር ሰና ጀለ ታኤ፤ ግዴዎን እልም ዮኣሽሞ አከ ምድያኖትን ህንአርግኔፍ እዶ ወይኒን እት ጩንፈሙት ዾክሴ ቀመዲ ዸአተ ቱሬ። <verse eid="JDG 6:11"/><verse number="12" style="v" sid="JDG 6:12"/>ኤርገማን <char style="nd">ዋቀዮስ</char> እሰት ሙልአቴ፣ “ያ ሎልቱ ጎተነነ፣ <char style="nd">ዋቀዮ</char> ስ ወጅን ጅረ” ጄዼን።<verse eid="JDG 6:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JDG 6:13"/>ግዴዎን ገሩ አከነ ጄዼ ዴብሴ፤ “ገሩ ያ ጎፍታ፣ ኡቱ <char style="nd">ዋቀዮ</char> ኑ ወጅን ጅራቴ ወን ኩን ሁንድ ማሊፍ ኑረ ገአ? ድንቂወንሳ ከኔን አቦቲንኬኘ፣ ‘<char style="nd">ዋቀዮ</char> ብየ ግብጢቲ ኑ ባሴረ’ ጄዸኒ ኑት ህመን ሱን ሁንድ ኤሰ ጅሩሬ? አመ ገሩ <char style="nd">ዋቀዮ</char> ኑ ዺሴ ሀርከ ምድያኖታት ደበርሴ ኑ ኬኔረ።”<verse eid="JDG 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JDG 6:14"/>
    <char style="nd">ዋቀዮ</char> ገረ ግዴዎንት ገረገሌ፣ “ሁምነ ቀብዱ ከናን ዸቂቲ ሀርከ ምድያኖታ ጀላ እስራኤሎተ ብልሰ ባስ። አነቱ ስ ኤርጋ ጅረ ምቲ?” ጄዼን።<verse eid="JDG 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JDG 6:15"/>ግዴዎን ገሩ፣ “ያ ጎፍታ፣ ጎስትኮ ሰኚ ምናሴ ኬሳ ባይኤ ደዸባዸ፤ አንስ ማቲኮ ኬሳ ነመ ገድ ኣናዸ። ኤጋ አን አከምን ሰበ እስራኤል ብልሶምሱ ደንደአሬ?” ጄዼ ጋፈቴ።<verse eid="JDG 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JDG 6:16"/>
    <char style="nd">ዋቀዮስ</char>፣ “አን ስ ወጅን ጅረ፤ አትስ ምድያኖተ ሁንደ ወልት ቀብዴ ዾፍተ” ጄዼ ዴብሴፍ።<verse eid="JDG 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JDG 6:17"/>ግዴዎንስ አከነ ጄዼ ዴብሴ፤ “ዮ አን ፉለኬ ዱረት ሱራ አርገዼ ጅራዼ፣ ከን ነት ዱበቻ ጅሩ ዹጉማን ስእ ተኡ መለቶ ነ አርግሲስ። <verse eid="JDG 6:17"/><verse number="18" style="v" sid="JDG 6:18"/>ማሎ ሀመ አን ዴብኤ ኣርሳኮ ፍዴ ፉለኬ ዱረት ዽኤሱት ህንዴምን።”</para>
  <para style="p" vid="JDG 6:18">
    <char style="nd">ዋቀዮስ</char>፣ “አን ሀመ አት ዴብቱት ስን ኤገ” ጄዼን።<verse eid="JDG 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JDG 6:19"/>ግዴዎን ገረ መነሳ ዴሜ እልሞ ሬኤ ቶኮ ቀሌ ቆጴሴ ዳኩ ኢፊ ቶኮ ፉዼ ቡዴነ ራጭቲ ህንቀብኔ ቶልቼ። ፎን ሰነስ ጉንዶረ ካኤ ብሻን ፎን ሰናሞ ኦኮቴት ነቄ ፍዱዻን ቅልጡ ጀለት ኣርሳ እሳፍ ዽኤሴ።<verse eid="JDG 6:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JDG 6:20"/>ኤርገማን ዋቃስ፣ “ፎኒፊ መጥኖ ከነ ፉዺቲ ከታ ከነረ ካእ፤ ብሻንሳሞ ዸንገላስ” ጄዼ። ግዴዎንስ አከሱመ ጎዼ። <verse eid="JDG 6:20"/><verse number="21" style="v" sid="JDG 6:21"/>ኤርገማን <char style="nd">ዋቀዮ</char> ሱንስ ፊጤ ኡሌ ሀርከሳ ቱሬቲን ፎኒፊ መጥኖ ሰነ ቱቄ። እብድ ከታ ኬሳ በኤ ፎኒፊ መጥኖ ሰነ ኛቴ። ኤርገማን <char style="nd">ዋቀዮስ</char> ፉለሳ ዱራ ዸበሜ። <verse eid="JDG 6:21"/><verse number="22" style="v" sid="JDG 6:22"/>ግዴዎን ዮሙ አከ ኤርገማ <char style="nd">ዋቀዮ</char> አርጌ ቤኬት፣ “ወዮ፣ ያ <char style="nd">ዋቀዮ</char> ጎፍታ! አን እፋን እፈት ኤርገማ <char style="nd">ዋቀዮ</char> አርጌራቲ!” ጄዼ።<verse eid="JDG 6:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JDG 6:23"/>
    <char style="nd">ዋቀዮ</char> ገሩ፣ “ነጋን ሲፍ ሃተኡ! ህንሶዳትን፣ አት ህንዱቱቲ” ጄዼን።<verse eid="JDG 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JDG 6:24"/>ከናፉ ግዴዎን <char style="nd">ዋቀዮፍ</char> አችት እዶ ኣርሳ እጃሬ፣ “<char style="nd">ዋቀዮ</char> ነጋዸ” ጄዼ ሞጋሴ። እዶን ኣርሳ ኩን ሀመ ሀርኣት ለፈ አቢኤዜሮታረ እዶ ኦፍራ ጄዸሙ ዻበቴረ።<verse eid="JDG 6:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JDG 6:25"/>
    <char style="nd">ዋቀዮ</char> ሀልከኑመ ሰነ አከነ እሳን ጄዼ፤ “ከረ ሎን አባኬቲ ኬሳ ኮርመ ለመፋ ከን ወጋ ቶርበ ጉቴ ቶኮ ፉዽ። እዶ ኣርሳ ከን አባንኬ በኣሊፍ ቶልቼ ዲግ፤ ኡቱባ ኣሼራ ከን እሰ ብረ ዻበሜስ ጅግስ። <verse eid="JDG 6:25"/><verse number="26" style="v" sid="JDG 6:26"/>ፊጤ ጋረ ከናረትስ <char style="nd">ዋቀዮ</char> ዋቀኬቲፍ እዶ ኣርሳ በሬዳሳ ቶልች። ቆራን ኡቱባ ኣሼራ ከን ጅግስቴ ሰነትስ ፈየደሚ ኮርመ ለመፋ ሰነ ኣርሳ ጉበሙ ጎዺቲ ዽኤስ።”<verse eid="JDG 6:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JDG 6:27"/>ግዴዎንስ ሆጄቶተሳ ኬሳ ነመ ኩዸን ፉዸቴ አኩመ <char style="nd">ዋቀዮ</char> እሰት ህሜ ሰነ ጎዼ። ገሩ ዋን ማቲሳቲፊ ነሞተ መጋላ ሰነ ጅራተን ሶዳቴፍ ጉያ አዲን ጎቹረ ሀልከን ፍለቴ።<verse eid="JDG 6:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JDG 6:28"/>ገነመ በሪ ዮሙ ነሞትን መጋላ ሰና ህርባ ከአንት እዶን ኣርሳ በኣል ዲገሜ፣ ኡቱባን ኣሼራስ ኩፌ ኮርም ለመፋን እዶ ኣርሳ ሃራ ቶልፈሜ ሰነረት ቀለሜ ቱሬ!<verse eid="JDG 6:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JDG 6:29"/>እሳንስ፣ “ኤኙቱ ዋን ከነ ሆጄቴ?” ጄዸኒ ወል ጋፈተን።</para>
  <para style="p" vid="JDG 6:29">ዮሙ ገድ ፈጌኛን ቆረተንትስ፣ “ግዴዎን እልመ ዮኣሽቱ ዋን ከነ ጎዼ” ጄዸን።<verse eid="JDG 6:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JDG 6:30"/>ነሞትን መጋላ ሰናስ ዮኣሺን፣ “እልመኬ ገድ ባስ። እን ሰበቢ እዶ ኣርሳ በኣል ዲጌ ኡቱባ ኣሼራስ ጅግሴፍ አጄፈሙ ቀበ” ጄዸን።<verse eid="JDG 6:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JDG 6:31"/>ዮኣሽ ገሩ ሰበ ኣሪዻን ጉተሜ እሰ መርሴ ሰናን አከነ ጄዼ፤ “እስን በኣሊፍ ፈልሙ በርባዱ? እሰስ ኦልቹ ፌቱ? ነምን እሳፍ ፈልሙ ዮ ጅራቴ እን ገነመ ሃዱኡ! በኣል ኡቱ ዹጉማን ዋቀ ተኤ ዮሙ ነምን ቶኮ እዶ ኣርሳሳ ዲጉ እን ኦፍራ ዾዉ ደንደአ ቱሬ።” <verse eid="JDG 6:31"/><verse number="32" style="v" sid="JDG 6:32"/>ከናፉ እሳን ሰበቢ እን እዶ ኣርሳሳ ጀላ ዲጌፍ፣ “በኣል መታንሳ ሃፈልመቱ” ጄቹዻን ግዴዎኒን፣ “ዬሩብ-በኣል” ጄዸኒ ዋመን።<verse eid="JDG 6:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JDG 6:33"/>ኤርገሲስ ምድያኖትን ሁንድ፣ አማሌቆትኒፊ ነሞትን ከራ በአ ቢፍቱ ሁምነሳኒ ወልት ደበለተኒ ዮርዳኖስ ጬኡዻን ሱሉለ ይዝርኤል ኬሰ ቁበተን። <verse eid="JDG 6:33"/><verse number="34" style="v" sid="JDG 6:34"/>ሀፉር <char style="nd">ዋቀዮስ</char> ዹፌ ግዴዎንረ ቡኤ፤ እንስ አከ አቢኤዜሮን እሰ ዱካ ቡአኒፍ ዋሙፍ መለከተ አፉፌ። <verse eid="JDG 6:34"/><verse number="35" style="v" sid="JDG 6:35"/>ጉቱማ ምናሴ ኬሰስ ኤርገሞተ ኤርገቴ፤ እሳንስ እሰ ዱካ ቡኡፍ ወልት ቀበመን፤ አከሱመስ ገረ ኣሼር፣ ዜቡሎኒፊ ንፍታሌምት ኤርገቴ፤ እሳንስ ጀረ ስመቹፍ ገድ ያአን።<verse eid="JDG 6:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JDG 6:36"/>ግዴዎንስ ዋቃን አከነ ጄዼ፤ “ዮ አት አኩመ ዋዳ ገልቴት ሀርከኮቲን እስራኤል ፉርቴ፣ <verse eid="JDG 6:36"/><verse number="37" style="v" sid="JDG 6:37"/>ኩኖ፣ አን ወያ ርፌንሰ ሆላራ ሆጄተሜ ቶኮ ኦብዲረ ነንድሪርሰ። ዮ ርፌንሰ ሆላ ሰነ ቆፈረ ፍጤንስ ቡኤ ለፍትሞ ጎጎጋ ተኤ፣ አን አከ አት አኩመ ጄቴ ሰነ ሀርከኮቲን እስራኤል ፉርቱ ነንቤከ።” <verse eid="JDG 6:37"/><verse number="38" style="v" sid="JDG 6:38"/>ወን ሱንስ አከሱመ ተኤ። ግዴዎንስ ጉያ እት ኣኑ ገነማን ከኤ፤ ዬሮ እን ወያ ርፌንሰ ሆላራ ሆጄተሜ ሰነ ምጪሬትስ ብሻን ወጪቲ ጉቱቱ ኬሳ ጩንፈሜ።<verse eid="JDG 6:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JDG 6:39"/>ከነረት ግዴዎን ዋቃን፣ “ነት ህንዼከምን። አመሌ ዋን ቶኮን ስ ጋፈዸ። አከ አን ርፌንሰ ሆላ ሰነረት ያሊ ብራ ጎዹፍ ና ኤየም። አመሞ ርፌንሰ ሰነ ጎጎግሲቲ ፍጤንሰ ለፈት ኡፍስ።” <verse eid="JDG 6:39"/><verse number="40" style="v" sid="JDG 6:40"/>ዋቅንስ ሀልከን ሰነ አከሱመ ጎዼ። ርፌንሰ ሆላ ሰነ ቆፈቱ ጎጎጋ ቱሬ፤ ለፍት ጉቱን ፍጤንሳን ሀጉገሜ ቱሬ።<verse eid="JDG 6:40"/></para>
  <chapter eid="JDG 6"/>
  <chapter number="7" style="c" sid="JDG 7"/>
  <para style="s1">ግዴዎን ምድያኖተ ሞአቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 7:1"/>ዬሩብ-በኣል ነምች ግዴዎን ጄዸሙ ሱኒፊ ነሞትንሳ ሁንድ ገነመ ከአኒ ቡርቃ ሀሮድ ብረ ቁበተን። ቁበን ምድያኖታ እዶ ነሞትን ግዴዎን ቁበተን ሰናን ከራ ካባቲን ጋረ ሞሬ ብረ ሱሉለ ኬሰ ቱሬ። <verse eid="JDG 7:1"/><verse number="2" style="v" sid="JDG 7:2"/><char style="nd">ዋቀዮስ</char> ግዴዎኒን አከነ ጄዼ፤ “አከ አን ምድያኖተ ደበርሴ ሀርከሳኒት ህንኬንኔፍ እስራኤሎን ስ ወጅን ጅረን አከ መሌ ባይኤዸ። አከ ሰብን እስራኤል፣ ‘ጀብነ ኮቱ ነ ኦልቼ’ ጄዼ ነት ህንኮሬፍ፣ <verse eid="JDG 7:2"/><verse number="3" style="v" sid="JDG 7:3"/>‘ነምን ሶዳቴ ሆለቴ ከምዩ ቱሉ ግልኣድ ዺሴ ገረ መነሳት ሃዴብኡ’ ጄዺቲ አመ ሰበት ህም።” ከናፉ ነሞትን ኩመ ድግደሚ ለመ ዴብአኒ ኩመ ኩዸን አችት ሀፈን።<verse eid="JDG 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JDG 7:4"/>
    <char style="nd">ዋቀዮ</char> ገሩ ግዴዎኒን አከነ ጄዼ፤ “አመዩ ነሞተ ባይኤቱ ጅረ። እሳን ፉዸዹቲ ገረ ብሻኒት ገድ ቡእ፤ አን አችት እሳን ገርገር ሲፍ ፎአ። ዮ አን፣ ‘እን ኩን ስ ወጅን ንዴመ’ ጄዼ፣ እን ንዴመ፤ ዮ አን፣ ‘እን ኩን ስ ወጅን ህንዴሙ’ ጄዼ ገሩ እን ህንዴሙ።”<verse eid="JDG 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JDG 7:5"/>ከናፉ ግዴዎን ነሞተ ገረ ብሻኒት ገድ ቡሴ። <char style="nd">ዋቀዮስ</char> አችት፣ “ወረ አኩመ ሰሬት አረባን ብሻን ዹገን፣ ወረ ጅልቤንፈተኒ ዹገንራ ገርገር ባስ” እሳን ጄዼ። <verse eid="JDG 7:5"/><verse number="6" style="v" sid="JDG 7:6"/>ነሞትን ዽበ ሰዲ ኮኜሳኒቲን ወራበተኒ ዹገን። ወር ሀፈን ሁንድ ገሩ ዹጉፍ ጅልቤንፈተን።<verse eid="JDG 7:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JDG 7:7"/>
    <char style="nd">ዋቀዮ</char> ግዴዎኒን፣ “አን ነሞተ ሀርከሳኒቲን ዹገን ዽበ ሰደን ከናን ስ ፉሬ ምድያኖተ ደበርሴ ሀርከኬት ነንኬነ። ወር ካን ሁንድ ገረ ቄኤሳኒት ሃዴብአን” ጄዼን። <verse eid="JDG 7:7"/><verse number="8" style="v" sid="JDG 7:8"/>ከናፉ ግዴዎን አከ እስራኤሎን ሀፈን ሁንድ ገረ ዱንካነሳኒት ዴብአን ጎዼ ነሞተ ዽበ ሰደን ገሩ ቱርፈቴ፤ እሳንስ ወረ ካንራ ገላፊ መለከተ ፉዸተን።</para>
  <para style="p" vid="JDG 7:8">ቁበን ምድያኖታስ ግዴዎኒን ገድ ሱሉለ ኬሰ ቱሬ። <verse eid="JDG 7:8"/><verse number="9" style="v" sid="JDG 7:9"/>ሀልከኑመ ሰነ <char style="nd">ዋቀዮ</char> ግዴዎኒን አከነ ጄዼ፤ “ከኢቲ ቁበተ ሰነት ገድ ቡእ፤ አን ደበርሴ ሀርከኬት ሲፍን ኬናቲ። <verse eid="JDG 7:9"/><verse number="10" style="v" sid="JDG 7:10"/>አት ዮ ገድ ቡኡ ሶዳቴ ገሩ ተጃጅላኬ ፉራ ወጅን ገረ ቁበተ ሰናት ገድ ቡኢቲ <verse eid="JDG 7:10"/><verse number="11" style="v" sid="JDG 7:11"/>ዋን እሳን ዱበቻ ጅረን ዸገእ። ሰነ ቦዴ ቁበተ ሰነ ሩኩቱዻፍ ጀብነ ንአርገተ።” ከናፉ እኒፊ ተጃጅላንሳ ፉራን ገረ ሞጋ ቁበተ ሰናት ገድ ቡአን። <verse eid="JDG 7:11"/><verse number="12" style="v" sid="JDG 7:12"/>ምድያኖትን፣ አማሌቆትኒፊ ነሞትን በአ ቢፍቱቲ ዹፈን ሁንድ አኩመ ሆማ ሀዋንሳ ወልት ጎበተኒ ሱሉልቸ ኬሰ ቁበተኒ ቱረን። ባይእን ጋለወንሳኒስ አኩመ ጭረቸ ቀርቀረ ገላና ለኮብሰ ህንቀቡ ቱሬ።<verse eid="JDG 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JDG 7:13"/>ግዴዎንስ ኡቱ ነምች ቶኮ ዋኤ አብጁሳ ምቹ ኦፊሳት ህሙ አች ገኤ። ነምች ሱንስ አከነ ጄዼ፤ “አን አብጁ ቶኮ ነንአብጆዼ፤ ኩኖ መጥኖን ገርቡ ቶኮ ገንገለቻ ዹፌ ቁበተ ምድያኖታረ ቡኤ። እንስ ዹፌ አከ ዱንካን ጅጉፍ ሁምናን ዸኤ፤ ዱንካን ሱንስ ንኩፌ።”<verse eid="JDG 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JDG 7:14"/>ምቹንሳስ ዴብሴ፣ “ኩን ጎራዴ ግዴዎን እልመ ዮኣሽ እስራኤልቻት መሌ ዋን ብራ ምት። ዋቅንስ ምድያኖታፊ ጉቱማ ቁበተ ሰና ደበርሴ ሀርከ ግዴዎንት ኬኔረ” ጄዼ።<verse eid="JDG 7:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JDG 7:15"/>ግዴዎን ዮሙ አብጁ ሰናፊ ሂካሳ ዸገኤት ዋቃፍ ሰገዴ። ገረ ቁበተ እስራኤሎታትስ ዴብኤ፣ “ከኣ! <char style="nd">ዋቀዮ</char> ቁበተ ምድያኖታ ደበርሴ ሀርከኬሰንት ኬኔራ” ጄዼ። <verse eid="JDG 7:15"/><verse number="16" style="v" sid="JDG 7:16"/>እንስ ነሞተ ዽበ ሰደን ገሬ ሰዲት ቆዱዻን፣ ሀርከ ሁንደሳኒት መለከታፊ ኦኮቴ ጉጭ ኬሰ ጅሩ ቀበቺሴ።<verse eid="JDG 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JDG 7:17"/>ግዴዎንስ አከነ እሳኒን ጄዼ፤ “ነ እላላ፤ ዋን አን ሆጄዹስ ሆጄዻ፤ ዮሙ አን ቀርቀረ ቁበትቻት ዽኣዹት ቀልቤፈዻቲ ዋኑመ አን ጎዹ ጎዻ። <verse eid="JDG 7:17"/><verse number="18" style="v" sid="JDG 7:18"/>ዬሮ አኒፊ ወር ነ ወጅን ጅረን ሁንዲ መለከተኬኘ አፉፍኑት፣ እስንስ ናኖ ቁበትቻ ሁንደት አፉፋቲ፣ ‘<char style="nd">ዋቀዮፍ</char>፣ ግዴዎኒፍስ’ ጄዻ እያ።”<verse eid="JDG 7:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JDG 7:19"/>ግዴዎኒፊ ነሞትን እሰ ወጅን ቱረን ዽብ ሱን አኩመ ዋርድዮትን ወል ጌደረኒን ጀልቀበ ኤጉምሰ ወለካ ሀልከኒት ቀርቀረ ቁበተ ሰና ብረ ገአን። እሳንስ መለከተሳኒ አፉፈኒ ኦኮቴ ሀርከሳኒ ጅሩ ጨጨብሰን። <verse eid="JDG 7:19"/><verse number="20" style="v" sid="JDG 7:20"/>ገሬን ሰደኑ መለከተሳኒ አፉፈኒ ኦኮቴ ሀርከሳኒ ጅሩ ጨጨብሰን። ሀርከ ብታት ጉጨ፣ ሀርከ ምርጋትሞ መለከተ አፉፈን ቀበተኒ፣ “ጎራዴ <char style="nd">ዋቀዮቲፊ</char> ግዴዎን!” ጄዸኒ እየን። <verse eid="JDG 7:20"/><verse number="21" style="v" sid="JDG 7:21"/>ቶኮን ቶኮን ነማስ ናኖ ቁበትቻት እዶ ኬነሜፍ ቀበቴ፤ ምድያኖትን ሁንድስ እያ በቀተን።<verse eid="JDG 7:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JDG 7:22"/>ዬሮ መለከትን ዽብ ሰደን ሱን አፉፈሜት <char style="nd">ዋቀዮ</char> አከ ነምን ቁበተ ሰነ ኬሰ ቱሬ ቶኮ ቶኮን ጎራዴሳ ወልት ሉቅፈቱ ጎዼ፤ ራያን ወራናስ ከራ ዜሬራቲን ገረ ቤት ሺጣት፣ እሰ ብረስ ደርበኒ ሀመ ዳሪ አቤል ሜሆላ እሼ ጠባት ብረ ጅርቱ ሰናት በቀተኒ ዴመን። <verse eid="JDG 7:22"/><verse number="23" style="v" sid="JDG 7:23"/>እስራኤሎንስ ንፍታሌም፣ ኣሼሪፊ ምናሴ ሁንዱማ ኬሳ ዋመኒ ምድያኖተ ኦፍ ዱረ አርአን። <verse eid="JDG 7:23"/><verse number="24" style="v" sid="JDG 7:24"/>ግዴዎንስ ጉቱማ ብየ ጋራ ኤፍሬምት ኤርገሞተ ኤርጌ፣ “ኮታ ምድያኖተት ዱላቲ ብሻኖተ ሀመ ቤት ባራት ጅረኒፊ ለገ ዮርዳኖስ እሳን ዱርሳቲ ቀበዻ” ጄዼ።</para>
  <para style="p" vid="JDG 7:24">ከናፉ ነሞትን ኤፍሬም ሁንድ በአኒ ብሻኖተ ሀመ ቤት ባራት ጅረኒፊ ለገ ዮርዳኖስ ቀበተን። <verse eid="JDG 7:24"/><verse number="25" style="v" sid="JDG 7:25"/>አከሱመስ ሆገንቶተ ምድያኖታ ለማን ጄቹንስ ሄሬቢፊ ዜኤብን ቀበተን። ሄሬብ ከታ ሄሬብ ብረት ዜኤብሞ እዶ ወይኒ እት ጩንፈን ከን ዜኤቢት አጄሰን። እሳንስ ምድያኖተ አርአኒ መታ ሄሬቢፊ መታ ዜኤብ ገረ ገመ ለገ ዮርዳኖስ ግዴዎንት ፍደን።<verse eid="JDG 7:25"/></para>
  <chapter eid="JDG 7"/>
  <chapter number="8" style="c" sid="JDG 8"/>
  <para style="s1">ዛብሄሊፊ ዘልሙና</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 8:1"/>ነሞትን ኤፍሬም፣ “አት ማሊፍ አከነ ኑ ጎቴ? ዬሮ ምድያንን ዸኡፍ ዱልቴት ማሊፍ ኑ ህንዋምን?” ጄዸኒ ግዴዎን ጋፈተን። አከ መሌስ እሰት ዼከመን።<verse eid="JDG 8:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JDG 8:2"/>እንሞ አከነ ጄዼ ዴብሴፍ፤ “ወን አን ሆጄዼ ዮ ዋን እስን ሆጄተኒን ወል ብረ ቀበሜ ገቲ ማሊ ቀበ? ቀርሚን ወይኒ ኤፍሬም ኦምሸ ወይኒ አቢኤዜር ሰነ ሁንደ ህንጫሉ? <verse eid="JDG 8:2"/><verse number="3" style="v" sid="JDG 8:3"/>ዋቅን ሆገንቶተ ምድያኖታ ጄቹንስ ሄሬቢፊ ዜኤብን ደበርሴ ሀርከኬሰንት ኬኔረ። ኤጋ አን ዋን እስን ሆጄተኒን ወጅን ከን ወል ቅጣቱ ማል ሆጄቹን ደንደአ ቱሬ?” ዮሙ እን ዋን ከነ ጄዼትስ ኣሪን እሳን እሰት ኣረን ንቀበናኤ።<verse eid="JDG 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JDG 8:4"/>ግዴዎኒፊ ነሞትን እሰ ወጅን ቱረን ዽብ ሰደን ዹፈኒ ዮርዳኖስ ጬአን፤ እሳን አከ መሌ ደዸበንዩ እቱመ ፉፈኒ ጀረ አርአን። <verse eid="JDG 8:4"/><verse number="5" style="v" sid="JDG 8:5"/>እንስ ነሞተ ሱኮቲቲን፣ “ሎልቶተኮቲፍ ቡዴነ ኬና፤ እሳን ባይኤ ነ ዱራ ደዸበኒሩቲ፤ አን አመዩ ሞቶተ ምድያኖታ ጄቹንስ ዜባፊ ዘልሙና አርኣ ጅረ” ጄዼ።<verse eid="JDG 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JDG 8:6"/>ቆንዳልቶትን ሱኮት ገሩ፣ “ሎልቶተኬቲፍ ኑ ቡዴነ ከን ኬንኑ አት ዜባፊ ዘልሙና ሀርከኬት ገልፈቴርታ?” ጄዸኒን።<verse eid="JDG 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JDG 8:7"/>ግዴዎንስ ዴብሴ፣ “ቶሌ ካ፣ ዮሙ ዋቀዮ ደበርሴ ዜባፊ ዘልሙና ሀርከኮት ኬኑት አን ቆራቲ ገሞጂቲፊ አረንገማዻን ፎንኬሰን ጭጭረ” ጄዼን።<verse eid="JDG 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JDG 8:8"/>አቺስ ገረ ነሞተ ጴኑኤል ዸቄ አኩመ ወረ ዱራ ሰነ ከዸቴት እሳንስ ጋፈቴ፤ እሳን ገሩ አኩመ ወር ሱኮት ዴብሰንት ዴቢ ኬነን። <verse eid="JDG 8:8"/><verse number="9" style="v" sid="JDG 8:9"/>ከናፉ እን ነሞተ ጴኑኤሊን፣ “አን ዬሮ ሞአዼ ዴብኡት ገሞ ከነ ነንጅግሰ” ጄዼ።<verse eid="JDG 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JDG 8:10"/>ዬሮ ሰነት ዜባፊ ዘልሙናን ሎልቶተሳኒ ከኔን ኩመ ኩዸ ሸንት ሄደመን ወጅን እዶ ቀርቀር ጄዸሙ ቱረን፤ እሳን ኩኔንስ ሎልቶተ ነሞተ በአ ቢፍቱቲ ወልት ቀበመን ኬሳ ሀፈን ሁንዳዸ፤ ወር ጎራዴ ህዸተን ኩምን ኩዸ ለመ ዹመኒ ቱረኒቲ። <verse eid="JDG 8:10"/><verse number="11" style="v" sid="JDG 8:11"/>ግዴዎንስ ከራ ወረ በአ ኖባሂቲፊ ዮግብሃቲን ዱንካነ ኬሰ ጅራተኒ በኤ ሎልቶተ ሆማ ህንብርአትን ዸኤ፤ ራያን ወራና ሱን ኦፍ ደገቴ ቱሬቲ። <verse eid="JDG 8:11"/><verse number="12" style="v" sid="JDG 8:12"/>ሞቶትን ምድያን ለማን ጄቹንስ ዜባፊ ዘልሙናን ንበቀተን፤ ግዴዎን ገሩ አርኤ እሳን ቀበቴ፤ ሎልቶተሳኒስ ገርገር ብትኔሴ።<verse eid="JDG 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JDG 8:13"/>ኤርገሲ ግዴዎን እልም ዮኣሽ ከራ መልካ ሄሬስ በኤ ዱላ ገሌ። <verse eid="JDG 8:13"/><verse number="14" style="v" sid="JDG 8:14"/>እንስ ደርገጌሰ ሱኮት ቶኮ ቀቤ ቆረቴ፤ ደርገጌስ ሱንስ መቃ ቆንዳልቶተ ሱኮቲፊ ማንጉዶተ መጋለቲ ወሉመት መቃ ነመ ቶርባተሚ ቶርበ በሬሴ ኬኔፍ። <verse eid="JDG 8:14"/><verse number="15" style="v" sid="JDG 8:15"/>ግዴዎንስ ዹፌ ነሞተ ሱኮቲን፣ “ዜባፊ ዘልሙናን እስን፣ ‘ኑ ነሞተኬ ወረ ደዸበኒፍ ቡዴነ ከን ኬንኑ አት ዛብሄሊፊ ዘልሙና ሀርከኬት ገልፈቴርታ?’ ጄተኒ ዋኤሳኒ ነት ቆስተን ሱን ኩኖት” ጄዼ። <verse eid="JDG 8:15"/><verse number="16" style="v" sid="JDG 8:16"/>እንስ ማንጉዶተ መጋላ ሰና ፉዼ ቆራቲፊ አረንገማ ገሞጂቲን አደቡዻን ነሞተ ሱኮቲቲፍ በሩምሰ ኬኔ። <verse eid="JDG 8:16"/><verse number="17" style="v" sid="JDG 8:17"/>ገሞ ጴኑኤልስ ጅግሴ ነሞተ መጋለቲ ፍጤ።<verse eid="JDG 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JDG 8:18"/>ኤርገሲስ እን፣ “ነሞትን እስን ታቦርት ፍጠን ወረ አከሚቲ?” ጄዼ ዜባፊ ዘልሙና ጋፈቴ።</para>
  <para style="p" vid="JDG 8:18">እሳንስ፣ “ነሞቱመ አከኬሰኒ ከኔን ሁንድሳኒ እልማን ሞቲ ፈፈካተኒዸ” ጄዸኒን።<verse eid="JDG 8:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JDG 8:19"/>ግዴዎንስ ዴብሴ፣ “እሳን ኦቦሎተኮ እልማኑመ ሃዸኮቲ ቱረን። ዹጋ <char style="nd">ዋቀዮ</char> ጅራታ፣ ኡቱ እስን እሳን አጄሱ ባተኒ አን እስን ህንአጄሱ ቱሬ” ጄዼ። <verse eid="JDG 8:19"/><verse number="20" style="v" sid="JDG 8:20"/>እንስ ገረ ዬቴር እልመሳ ሀንገፍትቻት ገረገሌ፣ “ከኢቲ እሳን ፍጥ!” ጄዼን። ዬቴር ገሩ ሰበቢ እጆሌ ተኤፍ ሶዳቴ ጎራዴሳ ህንሉቅፈትኔ።<verse eid="JDG 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JDG 8:21"/>ኤርገሲስ ዜባፊ ዘልሙናን፣ “ከኢቲ አቱምት ኑ አጄስ፤ ‘ጀብን ነማ አኩመ ዸግነሳቲ’ ” ጄዸኒን። ግዴዎንስ ከኤ እሳን አጄሴ፤ ፋየ ሞርመ ጋለወንሳኒስ ፉዸቴ።<verse eid="JDG 8:21"/></para>
  <para style="s1">ኤፉዲ ግዴዎን</para>
  <para style="p">
    <verse number="22" style="v" sid="JDG 8:22"/>ነሞትን እስራኤልስ ግዴዎኒን፣ “አት ዋን ሀርከ ምድያኖታ ጀላ ኑ ባፍቴፍ አት፣ እልምኬቲፊ እልም እልመኬቲ ኑ ቡልቻ” ጄዸን።<verse eid="JDG 8:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JDG 8:23"/>ግዴዎን ገሩ፣ “አን እስን ህንቡልቹ፤ እልምኮስ እስን ህንቡልቹ። <char style="nd">ዋቀዮቱ</char> እስን ቡልቸ” እሳኒን ጄዼ። <verse eid="JDG 8:23"/><verse number="24" style="v" sid="JDG 8:24"/>እንስ፣ “አን ዋ ቶኮ እስን ከዸዸ፤ ኩንስ አከ ቶኮን ቶኮንኬሰን ቆደ ቦጁኬሰኒራ ሎቲ ና ኬንተኒዸ” ጄዼ። ሎቲ ወርቄ ካአቹን በርቴ እሽማኤሎታ ቱሬቲ።<verse eid="JDG 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JDG 8:25"/>እሳንስ፣ “ኑ ገመቹዻን ኬንነ” ጄዸኒ ዴብሰን። ከናፉ ወያ ለፈረ ድሪርሰኒ ቶኮን ቶኮን ነማ ቦጁሳራ ሎቲ እት ደርበቴ። <verse eid="JDG 8:25"/><verse number="26" style="v" sid="JDG 8:26"/>አመርቲን ወርቄ ከን እን ከዸቴ ሰቅሊ ኩመ ቶኮፊ ዽበ ቶርበ ዮካን ኪሎ ግራሚ ኩዸ ሰገሊፊ ወለካ ኡልፋተ ቱሬ፤ ኩንስ ዋን ሞርመት ህዸተን፣ ኡፈተ ዲማ ዺልጌ ከን ሞቶትን ምድያን ኡፈተኒፊ ፎንጫ ሞርመ ጋለወንሳኒረ ቱሬ ህንደበለቱ። <verse eid="JDG 8:26"/><verse number="27" style="v" sid="JDG 8:27"/>ግዴዎንስ ወርቄ ሰናን ድረተ ቶልቼ መጋላ እት ዸለቴ ኦፍራ ኬሰ ካኤ። እስራኤሎን ሁንድስ አችት ኤፉድቸ ዋቄፈቹዻን ሰጋገለን። ኩንስ ግዴዎኒፍ ማቲሳት ክዮ ተኤ።<verse eid="JDG 8:27"/></para>
  <para style="s1">ግዴዎን ዱኡሳ</para>
  <para style="p">
    <verse number="28" style="v" sid="JDG 8:28"/>ምድያኖትንስ አከሲን ፉለ እስራኤሎታ ዱረት ሞአተመን፤ ለመተስ መታሳኒ ኦል ህንቀበትኔ። ብየቲንስ በረ ግዴዎን ኬሰ ወጋ አፉርተመ ነጋ አርገቴ።<verse eid="JDG 8:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JDG 8:29"/>ዬሩብ-በኣል እልም ዮኣሽ አች ጅራቹፍ ገረ መነ ኦፊሳት ዴብኤ። <verse eid="JDG 8:29"/><verse number="30" style="v" sid="JDG 8:30"/>እን ሰበቢ ኒቶተ ባይኤ ፉዼፍ እልማን ቶርባተመ ቀበ ቱሬ። <verse eid="JDG 8:30"/><verse number="31" style="v" sid="JDG 8:31"/>ሳጀቶንሳ ከን ሼኬም ኬሰ ጅራቻ ቱርቴስ እልመ ዴሴፊ ቱርቴ፤ እንስ አቢሜሌክ ጄዼ እሰ ሞጋሴ። <verse eid="JDG 8:31"/><verse number="32" style="v" sid="JDG 8:32"/>ግዴዎን እልም ዮኣሽ በረ ዼራ ጅራቴ ዱኤ። እንስ ኦፍራ ብየ አቢኤዜሮታ ኬሰት፣ ለፈ አዋለ አባሳ ዮኣሽት አዋለሜ።<verse eid="JDG 8:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JDG 8:33"/>አኩመ ግዴዎን ዱኤን እስራኤሎን አመሌ በኣል ወጅን ሰጋገለን። በኣል ቤሪንስ ዋቀሳኒ ጎዸተኒ <verse eid="JDG 8:33"/><verse number="34" style="v" sid="JDG 8:34"/><char style="nd">ዋቀዮ</char> ዋቀሳኒ ከን ሀርከ ዲኖተሳኒ ሁንዱማ ጀላ እሳን ባሴ ሰነ ደገተን። <verse eid="JDG 8:34"/><verse number="35" style="v" sid="JDG 8:35"/>እሳንስ ማቲ ዬሩብ-በኣሊፍ ጄቹንስ ግዴዎኒፍ ዋን ጋሪ እን እሳኒፍ ጎዼ ሁንደ ያደተኒ አርጁማ ህንጎኔፍ።<verse eid="JDG 8:35"/></para>
  <chapter eid="JDG 8"/>
  <chapter number="9" style="c" sid="JDG 9"/>
  <para style="s1">አቢሜሌክ</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 9:1"/>አቢሜሌክ እልም ዬሩብ-በኣል ገረ ኦቦሎተ ሃዸሳ ከኔን ሼኬም ኬሰ ጅራተኒ ዸቄ እሳኒፊ ጎሰ ሃዸሳ ሁንዳን አከነ ጄዼ፤ <verse eid="JDG 9:1"/><verse number="2" style="v" sid="JDG 9:2"/>“ጅራቶተ ሼኬም ሁንዱማን፣ ‘ከም እስኒ ወየ? ዮ እልማን ዬሩብ-በኣል ቶርባተምን እስን ቡልቸንሞ ዮ ነምን ቶኮ እስን ቡልቼ ወየ?’ ጄዻ ጋፈዻ። አከ አን ፎኒፊ ዺገኬሰን ተኤሞ ያደዻ።”<verse eid="JDG 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JDG 9:3"/>ኦቦሎትን ሃዸሳስ ዱቢ ከነ ጉረ ሼኬሞታቲን ገአን፤ ገራንሳኒስ ገረ አቢሜሌክ ጎሩ ከጄሌ፤ እሳን፣ “እን ኦቦሌሰኬኘ” ጄዸኒሩቲ። <verse eid="JDG 9:3"/><verse number="4" style="v" sid="JDG 9:4"/>እሳንስ መነ ሰገዳ በኣል ቤሪት ኬሳ ሜቲ ገረ ግራሚ ዽበ ሰዴት ኡልፋቱ ኬነኒፍ፤ አቢሜሌክስ ሜቲ ሰናን ከሽለቦተ እሰ ፋነ ቡአን ቀጠረቴ። <verse eid="JDG 9:4"/><verse number="5" style="v" sid="JDG 9:5"/>ገረ መነ አባሳ ከን ኦፍራት አርገሙ ዸቄ ኦቦሎተሳ እልማን ዬሩብ-በኣል ቶርባተመ ዸጋ ቶኮረት ቀሌ። ዮታም እልም ይሩበኣል ቁጥሱን ገሩ ዾከቴ እሰ ጀላ ምልቄ። <verse eid="JDG 9:5"/><verse number="6" style="v" sid="JDG 9:6"/>ነሞትን ሼኬሚፊ ቤት ሚሎ ሁንድ አቢሜሌክን ሞስሱፍ ጄዸኒ ሼኬምት ኡቱባ ሙካ ጉዳ ቶኮ ብረት ወልት ቀበመን።<verse eid="JDG 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JDG 9:7"/>ዮታም ዮሙ ወን ኩን እት ህመሜት ፊጤ ጋረ ጌርዚምት ኦል በኤ ሰገሌ ጉዳዻን አከነ እሳኒን ጄዼ፤ “ያ ጅራቶተ ሼኬም፣ አከ ዋቅን እስን ዸገኡፍ ነ ዸጌፈዻ። <verse eid="JDG 9:7"/><verse number="8" style="v" sid="JDG 9:8"/>ጋፍ ቶኮ ሙኬን ሞቲ ሞስፈቹፍ በአን፤ እሳንስ ሙከ ኤጄርሳቲን፣ ‘ሞቲ ኑ ተእ’ ጄዸን።<verse eid="JDG 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JDG 9:9"/>“ሙክን ኤጄርሳ ገሩ፣ ‘አን ሙኬን ሁንዳ ኦልት ራፈሙዻፍ ጄዼ ዘይቲኮ ከን ዋቅኒፊ ነምን እቲን ከበጀመን ዾወዹሬ?’ ጄዼ ዴብሴ።<verse eid="JDG 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JDG 9:10"/>“እት ኣንሰኒስ ሙኬን ሙከ ሀርቡቲን፣ ‘ኮቱቲ ሞቲ ኑ ተእ’ ጄዸን።<verse eid="JDG 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JDG 9:11"/>“ሙክን ሀርቡ ገሩ ዴብሴ፣ ‘አን ሙኬን ሁንዳ ኦልት በኤ ራፈሙፍ ጄዼ እጀኮ ምኣዋፊ ጋሪ ሰነ ኬኑ ዺሱሬ?’ ጄዼ።<verse eid="JDG 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JDG 9:12"/>“ሙኬንስ ሙከ ወይኒቲን፣ ‘ኮቱቲ ሞቲ ኑ ተእ’ ጄዸን።<verse eid="JDG 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JDG 9:13"/>“ሙክን ወይኒ ገሩ ዴብሴ፣ ‘አን ሙኬን ሁንዳ ኦልት በኤ ራፈሙፍ ጄዼ ዳዺ ወይኒኮቲ ከን ዋቃፊ ነመ ገመቺሱ ሰነ ኬኑ ዺሱ?’ ጄዼ።<verse eid="JDG 9:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JDG 9:14"/>“ዹመረትስ ሙኬን ሁንድ ሙከ ቆራቲቲን፣ ‘ኮቱቲ ሞቲ ኑ ተእ’ ጄዸን።<verse eid="JDG 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JDG 9:15"/>“ሙክን ቆራቲስ ሙኬኒን፣ ‘እስን ዮ ዹጉማን ነ ሞስፈቹ ፌተን፣ ኮታቲ ጋድሰኮ ጀለት ደኤፈዻ፤ ዮ አከስ ተኡ ባቴ ገሩ እብድ ሙከ ቆራቲ ኬሳ በኤ ብርብርሰ ልባኖን ሃበርበዴሱ!’ ጄዼ።<verse eid="JDG 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JDG 9:16"/>“ኤጋ እስን አቢሜሌክን ሞስሱንኬሰን ዮ ከራ ዹጋቲፊ አመነሙማን ተኤ፣ ዮ ዬሩብ-በኣሊፊ ማቲሳቲፍ ዋን ጋሪ ጎቹፍ ተኤ፣ ዮ ዋን እሳፍ መሉ እሳፍ ጎቹፍ ተኤ፣ <verse eid="JDG 9:16"/><verse number="17" style="v" sid="JDG 9:17"/>አባንኮ ሉቡሳ ዱኣፍ ሳጥሌ ሀርከ ምድያኖታ ጀላ እስን ባሱፍ እስኒ ሎሌራቲ፤ <verse eid="JDG 9:17"/><verse number="18" style="v" sid="JDG 9:18"/>እስን ገሩ ሀርአ ማቲ አባኮት ካተኒ እልማንሳ ጄቹንስ ነመ ቶርባተመ ዸጋ ቶኮረት ቀልተን፤ ሰበቢ እን ፍረኬሰን ተኤፍ አቢሜሌክ እልመ ገርብቲ ሰነ ነሞተ ሼኬምረት ሞስፍተን፤ <verse eid="JDG 9:18"/><verse number="19" style="v" sid="JDG 9:19"/>ኤጋ ዮ እስን ሀርአ ዹጋፊ አመነሙማዻን ዬሩብ-በኣሊፊ ማቲሳቲፍ ዋን ጋሪ ጎተን፣ እስን አቢሜሌክት ገመዳ፤ እንስ እስንት ሃገመዱ! <verse eid="JDG 9:19"/><verse number="20" style="v" sid="JDG 9:20"/>አከስ ተኡ ባናን ገሩ እብድ መነ አቢሜሌኪ በኤ ነሞተ ሼኬሚፊ ቤት ሚሎ ሃፍጡ፤ አከሱመስ እብድ ነሞተ ሼኬሚፊ ቤት ሚሎ ብራ በኤ አቢሜሌክን ሃበሌሱ!”<verse eid="JDG 9:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JDG 9:21"/>ዮታምስ ብኤርት በቀቴ ሰበቢ ኦቦሌሰሳ አቢሜሌክን ሶዳቴፍ አቹመ ጅራቴ።<verse eid="JDG 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JDG 9:22"/>ኤርገ አቢሜሌክ ወጋ ሰዲ እስራኤል ቡልቼ ቦዴ፣ <verse eid="JDG 9:22"/><verse number="23" style="v" sid="JDG 9:23"/>ዋቅንስ አቢሜሌኪፊ ነሞተ ሼኬም ግዱት ሀፉረ ሀማ ኤርጌ፤ ሼኬሞንስ አቢሜሌክት ደበ ሆጄተን። <verse eid="JDG 9:23"/><verse number="24" style="v" sid="JDG 9:24"/>ዋቅንስ የከ እልማን ዬሩብ-በኣል ቶርባተመን ሰነት ሆጄተሜፊ ዺገሳኒ ከን ዸንገላፈሜ ሰናፍ፣ አቢሜሌክ ኦቦሌሰሳኒ ከን እሳን ቀሌ ሰናፊ ነሞተ ሼኬም ከኔን አከ እን ኦቦሎተሳ ፍጡፍ እሰ ገርጋረን ሰነ ሃሎ በኡፍ ዋን ከነ ጎዼ። <verse eid="JDG 9:24"/><verse number="25" style="v" sid="JDG 9:25"/>ነሞትን ሼኬምስ አከ እሳን ርጰኒ እሰ ኤገተኒፍ ፊጤ ጋራረ ነሞተ ካአተን፤ እሳንስ ነመ አቺን ደርቡ ሁንደ ሳማን፤ ወን ኩንስ አቢሜሌክት ኦዴፈሜ።<verse eid="JDG 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JDG 9:26"/>ዬሮ ከነት ገኣል እልም ኤቤድ ኦቦሎተሳ ወጅን ገረ ሼኬም ዹፌ፤ ሼኬሞንስ እሰ አብደተን። <verse eid="JDG 9:26"/><verse number="27" style="v" sid="JDG 9:27"/>እሳንስ ኤርገ ገረ ለፈ ቆቲሳ ወይኒት በአኒ ወይኒ ወልት ቀበተኒ ቦዴ ጩንፈኒ ገልመ ዋቀ ቶልፈማ እሳኒት አያነ አያኔፈተን። ኛተኒ ዹገኒስ አቢሜሌክን አባረን። <verse eid="JDG 9:27"/><verse number="28" style="v" sid="JDG 9:28"/>ገኣል እልም ኤቤድስ አከነ ጄዼ፤ “አከ ኑ እሳፍ ቡሉፍ አቢሜሌኪፊ ሼኬም ኤኙ? አቢሜሌክ እልመ ዬሩብ-በኣል ምቲ? ዜቡልስ እት ኣናሳ ምቲ? እስን ነሞተ ሀሞር አባ ሼኬም ተጃጅላ! ኑ ማሊፍ አቢሜሌክን ተጃጅላ? <verse eid="JDG 9:28"/><verse number="29" style="v" sid="JDG 9:29"/>ኡቱ ሰብን ኩን አጀጀኮ ጀለ ጅራቴ ስላ አን አቢሜሌክን ለፈራ ነንበሌሰ ቱሬ፤ ‘ወራነኬ ደበለዹቲ ገድ በእ!’ እሳን ነንጄዸስ ቱሬ።”<verse eid="JDG 9:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JDG 9:30"/>ዜቡል ቡልቻን መጋለቲ ዬሮ ዋን ገኣል እልም ኤቤድ ጄዼ ዸገኤት አከ መሌ ኣሬ። <verse eid="JDG 9:30"/><verse number="31" style="v" sid="JDG 9:31"/>አከነ ጄዼስ ዾክሳዻን ገረ አቢሜሌክት ኤርገሞተ ኤርጌ፤ “ገኣል እልም ኤቤዲፊ ኦቦሎትንሳ ገረ ሼኬም ዹፈኒ ሰበ መጋላ ስት ከካሳ ጅሩ። <verse eid="JDG 9:31"/><verse number="32" style="v" sid="JDG 9:32"/>ከናፉ አቲፊ ነሞትንኬ ሀልከኒን ባተኒ ለፈ ቆቲሳ ኬሰ ርጱ ቀብዱ። <verse eid="JDG 9:32"/><verse number="33" style="v" sid="JDG 9:33"/>ገነመ አኩመ አዱን ባቴንስ መጋላ ሰነ ጨብሳ ሴና። ዮሙ ገለኣሊፊ ነሞትንሳ ስት ዹፈንትስ ዋን ሀርክኬ ሆጄቹ መሉ ከምዩ ሆጄዹ።”<verse eid="JDG 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JDG 9:34"/>አቢሜሌክስ ነሞተ እሰ ወጅን ቱረን ሁንደ ወጅን ሀልከኒን ከኤ ገሬ አፉርት ቆደሙዻን ሼኬምት ዽኣቴ ርጴ። <verse eid="JDG 9:34"/><verse number="35" style="v" sid="JDG 9:35"/>አኩመ ገኣል እልም ኤቤድ በኤ ከረ መጋላ ሰናረ ዻበቴን፣ አቢሜሌክ ነሞተሳ ወጅን እዶ ርጴ ቱሬ ሰና እት ገድ በኤ።<verse eid="JDG 9:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JDG 9:36"/>ገኣል ዮሙ እሳን አርጌት ዜቡሊን፣ “ኩኖ ነሞትን ፊጤ ጋረኒራ ገድ ዹፋ ጅሩ!” ጄዼ።</para>
  <para style="p" vid="JDG 9:36">ዜቡልስ ዴብሴ፣ “ጋድሰ ቱሉወኒቱ ነሞተ ስት ፈካቴ” ጄዼን።<verse eid="JDG 9:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JDG 9:37"/>ገኣል ገሩ አመስ ዴብሴ፣ “እላል፤ ነሞትን ሀንዹረ ለፋቲ ዹፋ ጅሩ፤ ገሬን ቶኮስ ከራ ሙከ አብዳሪቲን ዹፋ ጅረ” ጄዼ።<verse eid="JDG 9:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JDG 9:38"/>ዜቡልስ፣ “አት ከን፣ ‘አከ ኑ እሳፍ ቡሉፍ አቢሜሌክ ኩን ኤኙ?’ ጄቴ፣ ኦዱንኬ ሱን አመ ሜሬ? ነሞትን አት ቱፈቴ እሳን ከነ ምቲ? ሜ በኢቲ ጀረ ሎል ካ!” ጄዼን።<verse eid="JDG 9:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JDG 9:39"/>ከናፉ ገኣል ነሞተ ሼኬም ሆገኔ አቢሜሌክን ሎሉፍ በኤ። <verse eid="JDG 9:39"/><verse number="40" style="v" sid="JDG 9:40"/>አቢሜሌክስ እሰ አርኤ፤ እንስ ዱራ በቀቴ፤ ነሞትን ባይኤንስ መዳአኒ ሀመ ከረ መጋለቲት ሀርጨአን። <verse eid="JDG 9:40"/><verse number="41" style="v" sid="JDG 9:41"/>አቢሜሌክ አሩማ ኬሰ ቱሬ፤ ዜቡልሞ ገኣሊፊ ኦቦሎተሳ አርኤ ሼኬም ኬሳ ባሴ።<verse eid="JDG 9:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="JDG 9:42"/>ጉያ እት ኣኑ ነሞትን ሼኬም ድሬት በአን፤ ወን ኩንስ አቢሜሌክት ህመሜ። <verse eid="JDG 9:42"/><verse number="43" style="v" sid="JDG 9:43"/>እንስ ነሞተሳ ፉዸቴ ገሬ ሰዲት ቆዴ ድሬረት ርጴ ኤገቴ። ዬሮ ነሞተ መጋላ ከአኒ ዹፋ ጅረን አርጌትስ እሳን ሎሉዻፍ ከኤ። <verse eid="JDG 9:43"/><verse number="44" style="v" sid="JDG 9:44"/>አቢሜሌኪፊ ገሬን እሰ ወጅን ቱረን ገረ ከረ መጋለቲት ጉገተን። ገሬን ሀፈን ለማንሞ ገረ ወረ ድሬረት በአኒ ቱረኒት ፊገኒ እሳን ፍጠን። <verse eid="JDG 9:44"/><verse number="45" style="v" sid="JDG 9:45"/>አቢሜሌክ ጋፈስ ጉያ ጉቱ ሎሌ መጋለቲ ቀበቴ፤ ጅራቶተሼስ ፍጤ መጋለቲሌ በርበዴሴ ሶግደ እት ፈጫሴ።<verse eid="JDG 9:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="JDG 9:46"/>ነሞትን ገሞ ሼኬም ኬሰ ጅራተን ዮሙ ዋን ከነ ዸገአንት ገረ ደአትኖ መነ ሰገዳ ኤልብሪትት ኦል ገለን። <verse eid="JDG 9:46"/><verse number="47" style="v" sid="JDG 9:47"/>አቢሜሌክስ ዮሙ አከ ነሞትን ሼኬም አችት ወልት ቀበመን ዸገኤት፣ <verse eid="JDG 9:47"/><verse number="48" style="v" sid="JDG 9:48"/>ነሞተሳ ሁንዱማ ወጅን ቱሉ ዘልሞንት ኦል በኤ። አቢሜሌክስ ቆቶ ሀርከት ቀበቴ ደሜወን ሙካ ሙሙሬ ኦል ፉዼ ገቲቲሳት ባቴ። ነሞተ እሰ ወጅን ጅረኒንስ፣ “ደፋ! ዋኑመ አና ጎዹ አርግተን ሰነ ጎዻ!” ጄዼ። <verse eid="JDG 9:48"/><verse number="49" style="v" sid="JDG 9:49"/>ነሞትን ሁንድኑስ ደሜወን ሙካ ሙሙረተኒ አቢሜሌክን ዱካ ቡአን። ደሜወን ሰነስ ደአትኖ ሼኬሞን እት በቀተን ሰነት እርክሰኒ እብደ እት ቀብሲሰን። ከናፉ ነሞትን ገሞ ሼኬም ኬሰ ቱረን ሁንድኑ ዺሮትኒፊ ዱበርቶትን ገረ ኩመ ቶኮ ተአን ዹመን።<verse eid="JDG 9:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="JDG 9:50"/>ኤርገሲስ አቢሜሌክ ገረ ቴቤዝ ዸቄ መጋላ ሰነ መርሴ ቀበቴ። <verse eid="JDG 9:50"/><verse number="51" style="v" sid="JDG 9:51"/>ተኡስ ዋን ገሞን ጀባን ቶኮ መጋላ ሰነ ኬሰ ቱሬፍ ጅራቶትን መጋላ ሰና ዺራ ዱበርቲን ኡቱ ህንሀፍን እት በቀተን። ኬሳንስ ኦፍት ጩፈኒ በንቲሳት ኦል በአን። <verse eid="JDG 9:51"/><verse number="52" style="v" sid="JDG 9:52"/>አቢሜሌክስ ዹፌ ገሞ ሰነ ዸኤ፤ ዮሙ እን እብዳን ጉቡዻፍ በልበለ ገሞ ሰናት ዽኣቴት ገሩ፣ <verse eid="JDG 9:52"/><verse number="53" style="v" sid="JDG 9:53"/>ዱበርቲን ቶኮ ጉባዻ መጂ ዸጋ እት ገድ ዺፍቴ ቡቄ መታሳ ጨብስቴ።<verse eid="JDG 9:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="JDG 9:54"/>እንስ ደፌ ደርገጌሰ ምአ ሎላ ባቱፍ ቶኮ ዋሜ፣ “አከ እሳን፣ ‘ዱበርቲቱ እሰ አጄሴ’ ጄቹ ህንደንዴኜፍ ጎራዴኬ ሉቅፈዹ ነ አጄስ” ጄዼን። ከናፉ ደርገጌስ ሱን እሰ ወራኔ፤ እንስ ንዱኤ። <verse eid="JDG 9:54"/><verse number="55" style="v" sid="JDG 9:55"/>እስራኤሎንስ ዮሙ አከ አቢሜሌክ ዱኤ አርገንት ገረ መነሳኒት ዴብአን።<verse eid="JDG 9:55"/></para>
  <para style="p">
    <verse number="56" style="v" sid="JDG 9:56"/>አከሲን ዋቅን ሀምነ አቢሜሌክ ኦቦሎተሳ ቶርባተመ ቀሉዻን አባ ኦፊት ሆጄቴፍ ገቲ ሆጂሳ ኬኔፍ። <verse eid="JDG 9:56"/><verse number="57" style="v" sid="JDG 9:57"/>አከሱመስ ዋቅን ሀምነ ነሞትን ሼኬም ሆጄተን ሁንደ መቱመሳኒት ዴብሴ። አባርስ ዮታም እልመ ዬሩብ-በኣልስ እሳንረ ገኤ።<verse eid="JDG 9:57"/></para>
  <chapter eid="JDG 9"/>
  <chapter number="10" style="c" sid="JDG 10"/>
  <para style="s1">ቶላ</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 10:1"/>ኤርገ አቢሜሌክ ዱኤ ቦዴ ነምች ጎሰ ይሳኮር፣ ቶላን እልም ጱዋ እልም ዶዶ እስራኤል በራሩፍ ከኤ። እንስ ብየ ጋራ ኤፍሬም ኬሰ ሻሚር ጅራቴ። <verse eid="JDG 10:1"/><verse number="2" style="v" sid="JDG 10:2"/>ቶላን ወጋ ድግደሚ ሰዲ እስራኤልን ቡልቼ፤ ኤርገሲስ ዱኤ ሻሚርት አዋለሜ።<verse eid="JDG 10:2"/></para>
  <para style="s1">ያኢር</para>
  <para style="p">
    <verse number="3" style="v" sid="JDG 10:3"/>እሰት ኣኔ ያኢር ነምች ጎሰ ግልኣድ ከኤ ወጋ ኩዸ ለመ እስራኤልን ቡልቼ፤ <verse eid="JDG 10:3"/><verse number="4" style="v" sid="JDG 10:4"/>እንስ እልማን ሶዶመ ከኔን ሀሮተ ሶዶመ ያበተን ቀበ ቱሬ። እሳንስ መጋላወን ሀመ ሀርኣት ገንዶተ ያኢር ጄዸመን ሶዶመ ግልኣድ ኬሳ ቀቡ ቱረን። <verse eid="JDG 10:4"/><verse number="5" style="v" sid="JDG 10:5"/>ያኢርስ ዱኤ ቃሞንት አዋለሜ።<verse eid="JDG 10:5"/></para>
  <para style="s1">ይፍታ</para>
  <para style="p">
    <verse number="6" style="v" sid="JDG 10:6"/>አመስ እስራኤሎን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዋን ሀማ ሆጄተን። በኣሊፊ አሽቶሬት አከሱመስ ዋቆተ ሶርያ፣ ሲዶና፣ ሞኣብ፣ አሞኒፊ ከን ፍልስጤም ዋቄፈተን። ዋን እስራኤሎን <char style="nd">ዋቀዮን</char> ዺሰኒ እሰ ዋቄፈቹ ድደኒፍ፣ <verse eid="JDG 10:6"/><verse number="7" style="v" sid="JDG 10:7"/>እን እሳንት ዼከሜ። ደበርሴስ ሀርከ ፍልስጤሞታቲፊ አሞኖታት እሳን ጉርጉሬ፤ <verse eid="JDG 10:7"/><verse number="8" style="v" sid="JDG 10:8"/>እሳንስ በረ ሰነ እጆሌ እስራኤል ገድ ጨብሰኒ ጩንቁርሰን። እስራኤሎተ ብየ አሞሮታ ከን ግልኣድ ኬሰ ከራ በኣቲን ለገ ዮርዳኖስ ብረ ጅራተን ሁንዱማ ወጋ ኩዸ ሰዴት አከ መሌ ጩንቁርሰን። <verse eid="JDG 10:8"/><verse number="9" style="v" sid="JDG 10:9"/>አሞኖትንስ ጎሰ ይሁዳ፣ ጎሰ ቤንያሚፊ መነ ኤፍሬም ወራኑዻፍ ለገ ዮርዳኖስ ጬአን። እስራኤሎንስ አከ መሌ ራፈመን። <verse eid="JDG 10:9"/><verse number="10" style="v" sid="JDG 10:10"/>ከናፉ እስራኤሎን፣ “ኑ ስ ዋቀኬኘ ዺፍኔ በኣል ዋቄፈቹዻን የከ ስት ሆጄትኔረ” ጄዸኒ <char style="nd">ዋቀዮት</char> እየተን።<verse eid="JDG 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JDG 10:11"/>
    <char style="nd">ዋቀዮስ</char> አከነ ጄዼ ዴብሴፍ፤ “ዬሮ ወር ግብጥ፣ አሞሮትን፣ አሞኖትን፣ ፍልስጤሞትን፣ <verse eid="JDG 10:11"/><verse number="12" style="v" sid="JDG 10:12"/>ሲዶኖትን፣ አማሌቆትኒፊ ማኦኖትን እስን ጩንቁርስናን እስን ነት እየተንት አን ሀርከሳኒ ጀላ እስን ህንባፍኔ? <verse eid="JDG 10:12"/><verse number="13" style="v" sid="JDG 10:13"/>እስን ገሩ ነ ዺፍተኒ ዋቆተ ብራ ዋቄፈተን፤ ከናፉ አን ስአች እስን ህንባሱ። <verse eid="JDG 10:13"/><verse number="14" style="v" sid="JDG 10:14"/>ዴማቲ ዋቆተ ፍለተን ሰነት እየዻ። ዮሙ እስን ረከተን እሳኑምት እስን ሃኦልቸን!”<verse eid="JDG 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JDG 10:15"/>እስራኤሎንስ <char style="nd">ዋቀዮን</char>፣ “ኑ ጩቡ ሆጄትኔረ። አት ዋን ፌቴ ኑ ጎዽ፤ አመ ገሩ ማሎ ኑ ባስ” ጄዸን። <verse eid="JDG 10:15"/><verse number="16" style="v" sid="JDG 10:16"/>እሳንስ ዋቆተ ኦርማ ግዱሳኒቲ በሌሰኒ <char style="nd">ዋቀዮን</char> ዋቄፈተን። እንስ ኤርገሲ ዽጵነ እስራኤል ጨልእሴ እላሉ ህንደንዴኜ።<verse eid="JDG 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JDG 10:17"/>ዬሮ አሞኖትን ግልኣድት ወል ገአንት እስራኤሎንስ ወል ገአኒ ሚስጳ ቁበተን። <verse eid="JDG 10:17"/><verse number="18" style="v" sid="JDG 10:18"/>ሆገንቶትን ነሞተ ግልኣድስ፣ “ነምን ጀልቀበት አሞኖተት ወራነ በኑ እን ጅራቶተ ግልኣድ ሁንዳፍ ሆገና ተአ” ወሊን ጄዸን።<verse eid="JDG 10:18"/></para>
  <chapter eid="JDG 10"/>
  <chapter number="11" style="c" sid="JDG 11"/>
  <para style="p">
    <verse number="1" style="v" sid="JDG 11:1"/>ይፍታን ነምች ጎሰ ግልኣድ ሱን ጎተ ቱሬ። አባንሳ ግልኣድ ጄዸመ፤ ሃትሳሞ ሰጋገልቱ ቱርቴ። <verse eid="JDG 11:1"/><verse number="2" style="v" sid="JDG 11:2"/>ኒቲን ግልኣድስ ግልኣዲፍ እልማን ዴሴ፤ እሳንስ ዮሙ ጉደተንት ይፍታዻን፣ “አት ዋን ዱበርቲ ብራራ ዸለቴፍ ዻለ ቶኮሌ ማቲኬኘራ ህንአርገቱ” ጄዸኒ እሰ አርአን። <verse eid="JDG 11:2"/><verse number="3" style="v" sid="JDG 11:3"/>ከናፉ ይፍታን ኦቦሎተሳ ዱራ በቀቴ ብየ ጦብ ጄዸሙ ኬሰ ጅራቴ፤ ገሬን ከሽለቦታ ናኖሳት ወልት ቀበመኒ እሰ ዱካ ቡአን።<verse eid="JDG 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JDG 11:4"/>ዬሮ ጥኖ ቦዴ፣ ዮሙ አሞኖትን ሰበ እስራኤልት ወራነ ካሰንት፣ <verse eid="JDG 11:4"/><verse number="5" style="v" sid="JDG 11:5"/>ማንጉዶትን ግልኣድ ይፍታ በርባቸ ገረ ጦብ ዴመን። <verse eid="JDG 11:5"/><verse number="6" style="v" sid="JDG 11:6"/>እሳንስ፣ “አከ ኑ አሞኖተ ወራኑ ደንዴኙፍ ኮቱ አጀጃ ኑ ተእ” ጄዸኒን።<verse eid="JDG 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JDG 11:7"/>ይፍታንስ፣ “እስን ነ ጅብተኒ መነ አባኮቲ ነ ህንአሪኔ? አመ ዮሙ ረከተን ማሊፍ ነ ብረ ዹፍቱ?” እሳኒን ጄዼ።<verse eid="JDG 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JDG 11:8"/>ማንጉዶትን ግልኣድስ፣ “ኑ ሰበቢ ከናፍ ገረኬ ዹፍኔረ፤ አሞኖተ ወራኑዻፍ ኑ ፋነ ኮቱ፤ ኑ ወረ ግልኣድ ኬሰ ጅራትኑ ሁንደረትስ ሆገና ንታታ” ጄዸኒን።<verse eid="JDG 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JDG 11:9"/>ይፍታንስ፣ “ዮ እስን አከ አን አሞኖተ ወራኑፍ ብየኮት ነ ዴብፍተኒ <char style="nd">ዋቀዮስ</char> ደበርሴ ሀርከኮት እሳን ኬኔ፣ ዹጉማን አን ሆገናኬሰን ነንተኣ?” ጄዼን።<verse eid="JDG 11:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JDG 11:10"/>ማንጉዶትን ግልኣድስ ዴብሰኒ፣ “<char style="nd">ዋቀዮ</char> ዹገ በኣኬኘ፤ ዹጉማን ኑ አኩመ አት ጄቴ ጎነ” ጄዸኒን። <verse eid="JDG 11:10"/><verse number="11" style="v" sid="JDG 11:11"/>ከናፉ ይፍታን ማንጉዶተ ግልኣድ ወጅን ቀጄሌ፤ ሰብን ግልኣድስ ሆገናፊ አባ ዱላ እሰ ጎዸቴ። እንስ እዶ ሚስጳ ጄዸሙት ዋን ዱራን ዱበቴ ሁንዱማ እረ ዴብኤ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዱበቴ።<verse eid="JDG 11:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JDG 11:12"/>ይፍታን ገረ ሞቲ አሞኖታት ኤርገሞተ ኤርጌ፣ “አት ከን ብየኬኘ ወራንቱፍ ረክነ ማሊ ኑራ ቀብደ?” ጄዼን።<verse eid="JDG 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JDG 11:13"/>ሞቲን አሞኖታስ ኤርገሞተ ይፍታቲን፣ “ሰበቢ እስራኤሎን ዬሮ ግብጢ በአንት ብየኮ ከን አርኖኒፊ ያቦቅ ግዱ ጅሩፊ ብየኮ ከን ሀመ ዮርዳኖስት ጅሩ ፉዸተኒፍ አን ዋን ከነ ጎዼረ፤ ከናፉ አመ ከራ ነጋን ና ዴብሳ” ጄዼ።<verse eid="JDG 11:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JDG 11:14"/>ይፍታንስ ገረ ሞቲ አሞኖታት ዴብሴ ኤርገሞተሳ ኤርጌ፤ <verse eid="JDG 11:14"/><verse number="15" style="v" sid="JDG 11:15"/>አከነስ ጄዼ፦</para>
  <para style="pm" vid="JDG 11:15">“ይፍታን አከነ ጄዸ፦ እስራኤል ብየ ሞኣብ ዮካን ብየ አሞኖተ ህንፉዸትኔ። <verse eid="JDG 11:15"/><verse number="16" style="v" sid="JDG 11:16"/>ገሩ ዬሮ ግብጢ በአንት እስራኤሎን ገሞጂ ኬሰ ገረ ገላነ ዲማ፣ አቺሞ ገረ ቃዴሽ ዹፈን። <verse eid="JDG 11:16"/><verse number="17" style="v" sid="JDG 11:17"/>እስራኤልስ ገረ ሞቲ ኤዶምት፣ ‘አከ አን ብየኬ ኬሳን ደርቡ ና ኤየም’ ጄዼ ኤርገሞተ ኤርጌ፤ ሞቲን ኤዶም ገሩ ህንዸጌኜ። ገረ ሞቲ ሞኣብትስ አከሱመ ኤርገን፤ እንሌ ንድዴ። ከናፉ እስራኤል ቃዴሽ ኬሰ ቱሬ።<verse eid="JDG 11:17"/></para>
  <para style="pm">
    <verse number="18" style="v" sid="JDG 11:18"/>“እት ኣንሴስ ገሞጂ ኬሰ ደርቤ ብየ ኤዶሚፊ ብየ ሞኣብራ ናነኤ ከራ በአ ብየ ሞኣቢን ደርቤ ገመ ካኒን አርኖን ጭነ ቁበቴ። ገሩ ሰበቢ አርኖን ዳሪ ሞኣብ ቱርቴፍ እሳን ብየ ሞኣብ ህንሴኔ ቱሬ።<verse eid="JDG 11:18"/></para>
  <para style="pm">
    <verse number="19" style="v" sid="JDG 11:19"/>“ኤርገሲስ እስራኤል ስሆን ሞትቸ አሞሮታ ከን ሄሽቦን ቡልቻ ቱሬ ሰነት ኤርገሞተ ኤርጌ፣ ‘አከ ኑ ብየኬ ኬሰ ገረ ብየኬኛት ደበሩ ኑ ኤየም’ ጄዼን። <verse eid="JDG 11:19"/><verse number="20" style="v" sid="JDG 11:20"/>ስሆን ገሩ አከ እን ከራ ብየሳቲን ደርቡ እስራኤልን ህንአመኔ። ከናፉ እን ነሞተሳ ወልት ቀበቴ ያህዛ ኬሰ ቁበቴ እስራኤልን ሎሌ።<verse eid="JDG 11:20"/></para>
  <para style="pm">
    <verse number="21" style="v" sid="JDG 11:21"/>“<char style="nd">ዋቀዮ</char> ዋቅን እስራኤልስ ስሆኒፊ ነሞተሳ ሁንደ ደበርሴ ሀርከ እስራኤልት ኬኔ፤ እስራኤሎንስ ጀረ ሞአተን፤ ከናፉ እስራኤሎን ብየ አሞሮተ አች ጅራተን ሁንዳ ፉዸተን፤ <verse eid="JDG 11:21"/><verse number="22" style="v" sid="JDG 11:22"/>ቀቤኘ ብየ አሞር ከን አርኖኒ ሀመ ያቦቅት አከሱመስ ከን ገሞጂ ሀመ ዮርዳኖስት ጅሩ ሁንደ ፉዸተን።<verse eid="JDG 11:22"/></para>
  <para style="pm">
    <verse number="23" style="v" sid="JDG 11:23"/>“ዮስ ኤርገ <char style="nd">ዋቀዮ</char> ዋቅን እስራኤል ፉለ ሰበ እስራኤል ዱራ አሞሮተ አርኤ ባሴ አት ፉዸቹዻፍ ምርገ ማሊ ቀብዳ? <verse eid="JDG 11:23"/><verse number="24" style="v" sid="JDG 11:24"/>አት ዋን ኬሞሽ ዋቅንኬ ሲፍ ኬኑ ህንፉዸቱ? ኑስ አከሱመ ዋን <char style="nd">ዋቀዮ</char> ዋቅንኬኘ ኑ ኬኔ ከምዩ ንፉዸትነ። <verse eid="JDG 11:24"/><verse number="25" style="v" sid="JDG 11:25"/>አት ባላቅ ሞቲ ሞኣብ እልመ ዝጶር ሰነ ንጫልታ? እን ተኩማ እስራኤል ወራኔራ? ዮካን ሎሌራ? <verse eid="JDG 11:25"/><verse number="26" style="v" sid="JDG 11:26"/>እስራኤሎን ወጋ ዽበ ሰዲ ሄሽቦን፣ አሮኤር፣ ቁበተወን ናኖ ሰናቲፊ መጋላወን ናኖ አርኖን ቀበተኒ ቱረኒሩ። አት ዬሮ ሰነት ማሊፍ ዴብፍቴ ህንፉዸትን? <verse eid="JDG 11:26"/><verse number="27" style="v" sid="JDG 11:27"/>አን የከ ስት ህንሆጄትኔ፤ አት ገሩ ወራነ ነት ካሱዻን ነ ሚቴርተ። ከነስ <char style="nd">ዋቀዮ</char>፣ አባን ሙርቲ አሙመ ከነ ከኤ እስራኤሎታፊ አሞኖተ ግዱት ሙርቲ ሃኬኑ።”<verse eid="JDG 11:27"/></para>
  <para style="m">
    <verse number="28" style="v" sid="JDG 11:28"/>ሞቲን አሞኖታ ገሩ ኤርጋ ይፍታን እሰት ኤርጌፍ ጉረ ህንኬንኔ።<verse eid="JDG 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JDG 11:29"/>ከነረት ሀፉር <char style="nd">ዋቀዮ</char> ይፍታረ ቡኤ። እንስ ግልኣዲፊ ምናሴ ኬሰ ደርቤ ሚስጳ እሼ ግልኣድ ኬሰ ጅርቱ ሰነ ኬሰ ቀጣሙሬ አሞኖተት ዱሌ። <verse eid="JDG 11:29"/><verse number="30" style="v" sid="JDG 11:30"/>ይፍታን አከነ ጄዼ <char style="nd">ዋቀዮፍ</char> ወሬጌ፤ “ዮ አት አሞኖተ ደበርስቴ ሀርከኮት ኬንቴ፣ <verse eid="JDG 11:30"/><verse number="31" style="v" sid="JDG 11:31"/>ዮሙ አን ሞአዼ ዴብኡት ወን መነኮቲ ነ ስመቹዻፍ ጀልቀበት በኡ ከምዩ ከን <char style="nd">ዋቀዮት</char>፤ አንስ ቀልመ ጉበሙ ጎዼ እሰ ነንዽኤሰ።”<verse eid="JDG 11:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JDG 11:32"/>ኤርገሲስ ይፍታን አሞኖተ ወራኑፍ በኤ፤ <char style="nd">ዋቀዮስ</char> እሳን ደበርሴ ሀርከሳት ኬኔ። <verse eid="JDG 11:32"/><verse number="33" style="v" sid="JDG 11:33"/>እንስ አሮኤሪ ጀልቀቤ መጋላወን ድግደመ ሀመ ናኖ ሚኒትት አከሱመስ ሀመ አቤል ኬራሚምት አርገመን ጉቱማን ጉቱት በርበዴሴ። አሞኖትንስ አከሲን እስራኤሎታፍ ቡለን።<verse eid="JDG 11:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JDG 11:34"/>ዬሮ ይፍታን ገረ ሚስጳት መነሳት ዴብኤት፣ እንተልሳ ድቤ ሩኩታ ስርባ እሰ ስመቹፍ ባቴ! እሼን እንተለ ቶክቲ እን ቀቡ ቱርቴ። እን እሼ መሌ እልመስ ተኡ እንተለ ብራ ህንቀቡ ቱሬ። <verse eid="JDG 11:34"/><verse number="35" style="v" sid="JDG 11:35"/>እንስ ዮሙ እሼ አርጌት ወያሳ ተርሳሴ፣ “ወዮ! ያ ሙጨቲኮ! ነ በሌስቴ፤ ዽጵነ ኬሰ ነ ገልችቴ፤ አን ወሬገ ጨብሱ ህንደንዴኜ <char style="nd">ዋቀዮፍ</char> ወሬጌራቲ” ጄዼ ቦኤ።<verse eid="JDG 11:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JDG 11:36"/>እሼንስ አከነ ጄቴ፤ “ያ አባኮ፣ አት <char style="nd">ዋቀዮፍ</char> ከከቴርተ፤ ሰበቢ <char style="nd">ዋቀዮ</char> ዲኖተኬ አሞኖተ ሃሎ ሲፍ በኤፍ፣ አት ዋን ዋዳ ገልቴ ሰነ አናን ጉተዹ። <verse eid="JDG 11:36"/><verse number="37" style="v" sid="JDG 11:37"/>ገሩ ዋን ቶኮ ና ኤየም፤ ሰበቢ አን ስአች ህንሄሩምኔፍ አከ አን ምቾተኮ ወጅን ጋረንረ ናነኤ ዱርቡማኮቲፍ ቦኡፍ ጅአ ለመ ና ኬን።”<verse eid="JDG 11:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JDG 11:38"/>እንስ፣ “ዸቁ ደንዴሰ” ጄዼን። አከ እሼን ጅአ ለማፍ ዴምቱስ ኤየሜፍ። እሼንስ ዋን ስአች ሄሩሙ ህንደንዴኜፍ ዱበረን ምቾተሼ ወጅን ጋረንት ኦል ባቴ ቦሴ። <verse eid="JDG 11:38"/><verse number="39" style="v" sid="JDG 11:39"/>ጅአ ለማ ቦዴስ ገረ አባሼት ዴብቴ፤ እንስ አኩመ ወሬጌ ሰነ ጎዼ። እሼን ዱርበ ቱርቴ።</para>
  <para style="p" vid="JDG 11:39">ዬሮ ሰና ጀልቀቤ ወን ኩን እስራኤሎተ ብረት በርቴ ተኤ <verse eid="JDG 11:39"/><verse number="40" style="v" sid="JDG 11:40"/>ዱርቦን እስራኤል ወጉመ ወጋን በአኒ ጉያ አፉር እንተለ ይፍታ ነምቸ ግልኣድ ሰና ገዳን ያደቱ።<verse eid="JDG 11:40"/></para>
  <chapter eid="JDG 11"/>
  <chapter number="12" style="c" sid="JDG 12"/>
  <para style="s1">ይፍታፊ ኤፍሬም</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 12:1"/>ነሞትን ኤፍሬም ወልት ቀበመኒ ዳፎን ጬኡዻን ይፍታን፣ “አት ዬሮ አሞኖተ ሎሉፍ ባቴት ማሊፍ አከ ኑ ስ ፋነ ዴምኑፍ ኑ ህንዋምኔ? ኑ መነኬ ስረት ጉብነ” ጄዸኒን።<verse eid="JDG 12:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JDG 12:2"/>ይፍታንስ አከነ ጄዼ ዴብሴፍ፤ “አኒፊ ነሞትንኮ አሞኖተ ሎሉፍ ወራነ ጉዳ ኬሰ ገሌ ቱሬ፤ ዮሙ አን እስን ዋሜት እስን ሀርከሳኒቲ ነ ህንባፍኔ። <verse eid="JDG 12:2"/><verse number="3" style="v" sid="JDG 12:3"/>አን ዬሮ አከ እስን ነ ህንባፍኔ አርጌት ሉቡኮት ሙሬ አሞኖተ ወራኑፍ ነንጬኤ፤ <char style="nd">ዋቀዮስ</char> እሳንረት ሞአትና ና ኬኔ። ዮስ እስን ሀርአ ማሊፍ ነ ሎሉፍ ዹፍተንሬ?”<verse eid="JDG 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JDG 12:4"/>ይፍታንስ ኤርገሲ ነሞተ ግልኣድ ወልት ዋመቴ ኤፍሬምት ሎለ ካሴ። ሰበቢ ነሞትን ኤፍሬም ወረ ግልኣዲን፣ “እስን ግልኣዶን ወረ ኤፍሬሚፊ ምናሴ ገንተኒዸ” ጄዸኒፍ ግልኣዶን እሳን ዸአን። <verse eid="JDG 12:4"/><verse number="5" style="v" sid="JDG 12:5"/>ግልኣዶን መልካወን ዮርዳኖስ ከኔን ገረ ኤፍራታት ጌሰን ቀበተን፤ ዬሮ በቀታን ኤፍራታ ቶኮ፣ “አን ገመን ጬአ” ጄዹት፣ ነሞትን ግልኣድ፣ “አት ነመ ኤፍሬም ምቲ?” ጄዸኒ እሰ ጋፈቱ። ዮ እን፣ “ዋዉ” ጄዼ ዴብሴ፣ <verse eid="JDG 12:5"/><verse number="6" style="v" sid="JDG 12:6"/>እሳን፣ “ጋሪዸ፤ አት፣ ‘ሺቦሌት’ ጄዽ” ጄዸኒን። ዮ እን፣ “ሲቦሌት” ጄዼ፣ ሰበቢ እን ቀጄለት “ሺቦሌት” ጄቹ ህንደንዴኜፍ ቀበኒ መልካወን ዮርዳኖስረት እሰ አጄሱ። ዬሮ ሰነት ነሞተ ኤፍሬም ኩመ አፉርተሚ ለመቱ አጄፈሜ።<verse eid="JDG 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JDG 12:7"/>ይፍታን ወጋ ጀአ እስራኤልን ቡልቼ። ኤርገሲ ይፍታን ነምን ግልኣድ ሱን ዱኤ መጋላ ግልኣድ ኬሳ ቶኮት አዋለሜ።<verse eid="JDG 12:7"/></para>
  <para style="s1">ኢብጣን፣ ኤሎሚፊ አብዶን</para>
  <para style="p">
    <verse number="8" style="v" sid="JDG 12:8"/>እሳን ዱበስ እብዛን ነምች ቤትልሄም ሱን እስራኤልን ቡልቼ። <verse eid="JDG 12:8"/><verse number="9" style="v" sid="JDG 12:9"/>እንስ እልማን ሶዶማፊ እንተለን ሶዶመ ቀበ ቱሬ፤ እንተለንሳስ ወረ ጎሰሳ ህንተእንት ሄሩምሲሴ፤ እልማንሳቲፍስ አከ እሳን ኒቶተ ተአኒፍ ጎሰ ብራ ኬሳ ዱርቦተ ሶዶመ ፍዴ። እብጣን ወጋ ቶርበ እስራኤል ቡልቼ። <verse eid="JDG 12:9"/><verse number="10" style="v" sid="JDG 12:10"/>እብዛንስ ዱኤ ቤትልሄም ኬሰት አዋለሜ።<verse eid="JDG 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JDG 12:11"/>እሰ ቦዴ ኤሎን ነምች ጎሰ ዜቡሎን ሱን ወጋ ኩዸን እስራኤልን ቡልቼ። <verse eid="JDG 12:11"/><verse number="12" style="v" sid="JDG 12:12"/>ኤሎንስ ዱኤ ብየ ዜቡሎን ኬሰት አያሎንት አዋለሜ።<verse eid="JDG 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JDG 12:13"/>እሰት ኣኔሞ አብዶን እልም ህሌል ነምች ጵራቶን ሱን እስራኤልን ቡልቼ። <verse eid="JDG 12:13"/><verse number="14" style="v" sid="JDG 12:14"/>እንስ እልማን አፉርተማፊ እልማን እልማኒ ሶዶመ ከኔን ሀሮተ ቶርባተመ ያበተን ቀበ ቱሬ። እን ወጋ ሰዴት እስራኤልን ቡልቼ። <verse eid="JDG 12:14"/><verse number="15" style="v" sid="JDG 12:15"/>ኤርገሲስ አብዶን እልም ህሌል ዱኤ ብየ ጋራ አማሌቆታት ኤፍሬም ኬሰት ጵራቶንት አዋለሜ።<verse eid="JDG 12:15"/></para>
  <chapter eid="JDG 12"/>
  <chapter number="13" style="c" sid="JDG 13"/>
  <para style="s1">ዸለቹ ሳምሶን</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 13:1"/>እስራኤሎን አመስ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዋን ሀማ ሆጄተን፤ ከናፉ <char style="nd">ዋቀዮ</char> ወጋ አፉርተመ ደበርሴ ሀርከ ፍልስጤሞታት እሳን ኬኔ።<verse eid="JDG 13:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JDG 13:2"/>ነምቸ ጎሰ ዳን ኬሳ ዸለቴ ዞራ ጅራቱ ከን ማኖኣ ጄዸሙ ቶኮቱ ቱሬ፤ ኒቲንሳስ ዸብዱ እጆሌ ቶኮሌ ህንቀብኔ ቱርቴ። <verse eid="JDG 13:2"/><verse number="3" style="v" sid="JDG 13:3"/>ኤርገማን <char style="nd">ዋቀዮስ</char> እሼት ሙልአቴ አከነ ጄዼን፤ “ኩኖ አት ዸብዱ እጆሌ ህንቀብኔዸ፤ ገሩ ኡልፎፍቴ እልመ ዴሰ። <verse eid="JDG 13:3"/><verse number="4" style="v" sid="JDG 13:4"/>ኤጋ አት አከ ዳዺ ወይኒ ዮካን ዹጋቲ ነመ መቼሱ ህንዹግኔ ዮካን ዋን ጡራኣ ቶኮሌ ህንኛትኔ ኦፍ ኤገዹ፤ <verse eid="JDG 13:4"/><verse number="5" style="v" sid="JDG 13:5"/>አት ኡልፎፍቴ እልመ ደኡፍ ጅርታቲ። ቀረባን ቶኮዩ መታሳ ህንቱቅን፤ እን ጋፈ ዸለቴ ጀልቀቤ ናዝርቸ ተኡዻን ከን ዋቃፍ አዳን ባፈሜ ተኣቲ፤ እን ሀርከ ፍልስጤሞታቲ እስራኤሎተ ፉሩ ጀልቀበ።”<verse eid="JDG 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JDG 13:6"/>ዱበርቲን ሱንስ ገረ ዽርሰሼ ዸቅጤ አከነ ጄቴ እት ህምቴ፤ “ነመ ዋቃ ቶኮቱ ገረኮ ዹፌ። እንስ ኤርገማ ዋቀዮ ፈካቴ አከ መሌ ነመ ሶዳችሰ። አን አከ እን ኤሳ ዹፌ እሰ ህንጋፈኔ፤ እንስ መቃሳ ነት ህንህምኔ። <verse eid="JDG 13:6"/><verse number="7" style="v" sid="JDG 13:7"/>ገሩ እን፣ ‘አት ኡልፎፍቴ እልመ ዴሰ። ኤጋ ስአች ዳዺ ወይኒ ዮካን ዹጋቲ ነመ መቼሱ ህንዹግን፤ ዋን ጡራኣስ ህንኛትን፤ ሰበቢንሳስ እን ጋፈ ዸለቴ ጀልቀቤ ሀመ ዱኡት ናዝርቸ ዋቃ ተኣቲ’ ናን ጄዼ።”<verse eid="JDG 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JDG 13:8"/>ማኖኣንስ፣ “ያ ጎፍታ፣ አከ ነምች ዋቃ ከን አት ገረኬኘት ኤርግቴ ሱን አመስ ዹፌ አከ ኑ እት ሙጫ ዸለቱ ሰነ ጉድሱ ቀብኑ ኑ በርሲሱፍ አከ ኑፍ ኤርግቱ ስን ከዸዸ” ጄዼ <char style="nd">ዋቀዮን</char> ከዸቴ።<verse eid="JDG 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JDG 13:9"/>ዋቅንስ ማኖኣ ዸገኤ፤ ኤርገማን ዋቀዮ ሱንስ ኡቱ እሼን ለፈ ቆቲሳ ኬሰ ቴሱ ገረ ዱበርቲ ሰና ዴብኤ ዹፌ፤ ዽርስሼ ማኖኣን ገሩ እሼ ወጅን ህንቱሬ። <verse eid="JDG 13:9"/><verse number="10" style="v" sid="JDG 13:10"/>ዱበርትቲንስ ዽርሰሼት ህሙፍ አሪፈቴ፣ “ኩኖ! ነምች ጉያ ካን ነት ሙልአቴ ሱን አስ ጅረ!” ጄቴ።<verse eid="JDG 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JDG 13:11"/>ማኖኣንስ ከኤ ኒቲሳ ዱካ ቡኤ። እንስ ዮሙ ነምቸ ብረ ገኤት፣ “ነምን ኒቲኮት ዱበቴ ስኢ?” ጄዼን።</para>
  <para style="p" vid="JDG 13:11">እንስ፣ “አኑመ” ጄዼ።<verse eid="JDG 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JDG 13:12"/>ከናፉ ማኖኣን፣ “ዬሮ ዱቢንኬ ራወተሙት ሴር ሙጭች እቲን ጅራቱፊ ሆጂን እን ሆጄቱ ማል?” ጄዼ እሰ ጋፈቴ።<verse eid="JDG 13:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JDG 13:13"/>ኤርገማን <char style="nd">ዋቀዮስ</char> አከነ ጄዼ ዴብሴ፤ “ኒቲንኬ ዋን አን እት ህሜ ሁንደ ጎቹ ቀብድ። <verse eid="JDG 13:13"/><verse number="14" style="v" sid="JDG 13:14"/>እሼን ዋን ሙከ ወይኒራ አርገሙ ቶኮሌ ኛቹ ህንቀብዱ፤ ዳዺ ወይኒ ዮካን ዹጋቲ ነመ መቼሱ ዹጉ ዮካን ዋን ጡራኣ ከምዩ ኛቹ ህንቀብዱ። እሼን ዋን አን እሼ አጀጄ ሁንደ ጎቹ ቀብድ።”<verse eid="JDG 13:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JDG 13:15"/>ማኖኣንስ ኤርገማ <char style="nd">ዋቀዮቲን</char>፣ “ሀመ ኑ ኮርቤሰ ሬኤ ጥናሳ ሲፍ ቆጴስኑት ኑ ቱር” ጄዼ።<verse eid="JDG 13:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JDG 13:16"/>ኤርገማን <char style="nd">ዋቀዮ</char>፣ “አት ነ ቱርስቱሌ፣ አን ኛተኬ ከምዩ ህንኛዹ። ገሩ ዮ ኣርሳ ጉበሙ ቆጴሱ ፌቴ፣ እሰ <char style="nd">ዋቀዮፍ</char> ዽኤስ” ጄዼን። ማኖኣን አከ እን ኤርገማ <char style="nd">ዋቀዮ</char> ተኤ ህንቤክኔ ቱሬ።<verse eid="JDG 13:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JDG 13:17"/>ሰነ ቦዴ ማኖኣን ኤርገማ <char style="nd">ዋቀዮቲን</char>፣ “አከ ኑ ዬሮ ዱቢን አት ዱበቴ ፊጣን በኡት ኡልፍነ ሲፍ ኬንኑፍ መቃንኬ ኤኙ?” ጄዼ ጋፈቴ።<verse eid="JDG 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JDG 13:18"/>እንስ፣ “አት ማሊፍ መቃኮ ጋፈተ? እን አከ መሌ ድንቂዸ” ጄዼን። <verse eid="JDG 13:18"/><verse number="19" style="v" sid="JDG 13:19"/>ማኖኣንስ ኮርቤሰ ሬኤ ጥናሳ ኬና ምዻኒ ወጅን ጌሴ ከታረት <char style="nd">ዋቀዮፍ</char> ኣርሳ ጎዼ። ኡቱመ ማኖኣፊ ኒቲንሳ እላለኑስ <char style="nd">ዋቀዮ</char> ዋን ድንቂ ጎዼ። <verse eid="JDG 13:19"/><verse number="20" style="v" sid="JDG 13:20"/>ዬሮ አረብን እብዳ እዶ ኣርሳራ ሰሚት ኦል በኤት ኤርገማን <char style="nd">ዋቀዮ</char> አረበ እብዳ ኬሳን ኦል በኤ። ማኖኣፊ ኒቲንሳ ዋን ከነ አርገኒ አደሳኒቲን ለፈት ጎምብፈመን። <verse eid="JDG 13:20"/><verse number="21" style="v" sid="JDG 13:21"/>ኤርገማን <char style="nd">ዋቀዮ</char> ገሩ ዴብኤ ማኖኣፊ ኒቲሳት ህንሙልአትኔ። ማኖኣንስ አከ እን ኤርገማ <char style="nd">ዋቀዮ</char> ተኤ ቤኬ።<verse eid="JDG 13:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JDG 13:22"/>እንስ ኒቲሳቲን፣ “ኑ ዋቀ አርግኔራቲ ዹጉማን ንዱነ!” ጄዼ።<verse eid="JDG 13:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JDG 13:23"/>ኒቲንሳ ገሩ ዴብፍቴ አከነ ጄቴን፤ “<char style="nd">ዋቀዮ</char> ኡቱ ኑ አጄሱ በርባዴ ስላ ኣርሳ ጉበሙፊ ኬና ምዻኒ ኑ ሀርካ ህንፉዸቱ ቱሬ፤ ዋን ከነ ሁንዱመስ ኑት ህንአርግሲሱ ዮካን ዋን ከነ አመ ኑት ህንህሙ ቱሬ።”<verse eid="JDG 13:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JDG 13:24"/>ዱበርቲን ሱን እልመ ዴሴ፤ ሳምሶን ጄቴስ እሰ ሞጋፍቴ። እንስ ንጉደቴ፤ <char style="nd">ዋቀዮስ</char> እሰ ኤብሴ። <verse eid="JDG 13:24"/><verse number="25" style="v" sid="JDG 13:25"/>ሀፉር <char style="nd">ዋቀዮስ</char> ዬሮ እን ዞራፊ ኤሽታኦል ግዱ ቁበተ ዳን ኬሰ ቱሬት እሰ ከካሱ ጀልቀቤ።<verse eid="JDG 13:25"/></para>
  <chapter eid="JDG 13"/>
  <chapter number="14" style="c" sid="JDG 14"/>
  <para style="s1">ጋኤለ ሳምሶን</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 14:1"/>ሳምሶን ገረ ቲምናህት ገድ ቡኤ ዱርበ ፍልስጤም ቶኮ አችት አርጌ። <verse eid="JDG 14:1"/><verse number="2" style="v" sid="JDG 14:2"/>ዮሙ አቺ ዴብኤትስ አባፊ ሃዸሳቲን፣ “አን ቲምናህት እንተለ ፍልስጤም ቶኮ አርጌራቲ ነ ፉስሳ” ጄዼ።<verse eid="JDG 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JDG 14:3"/>አባፊ ሃቲሳ ዴብሰኒ፣ “ወን አከ አት ፍልስጤሞተ ዸግነ ህንቀበትኔ ኬሳ ኒቲ ፉቱ ስ ጎዹ ፍሮተኬ ኬሳ ዮካን ሰበኬኘ ሁንደ ኬሳ ዱበርቲን ዸበምቴቲ?” ጄዸኒን።</para>
  <para style="p" vid="JDG 14:3">ሳምሶን ገሩ አባሳቲን፣ “እሼቱ ና ተኣቲ እሹመ ና ፍድ” ጄዼ። <verse eid="JDG 14:3"/><verse number="4" style="v" sid="JDG 14:4"/>አባፊ ሃቲሳ አከ ወን ኩን <char style="nd">ዋቀዮ</char> ብራ ዹፌ ህንቤክኔ፤ ዋቀዮ ከራ እቲን ፍልስጤሞተ ዸኡ በርባዳ ቱሬቲ። ዬሮ ሰነት ፍልስጤሞትን እስራኤሎተ ገድ ቀበኒ ቡልቻ ቱረን።<verse eid="JDG 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JDG 14:5"/>ሳምሶን አባሳቲፊ ሃዸሳ ወጅን ገረ ቲምናህት ገድ ቡኤ። አኩመ እሳን እዶ ዻባ ወይኒ ቲምናህ ብረ ገአኒንስ ሌንጭ ሳፌል ቶኮ እተና እሰት ዹፌ። <verse eid="JDG 14:5"/><verse number="6" style="v" sid="JDG 14:6"/>ሀፉር <char style="nd">ዋቀዮስ</char> ጀብናን ሳምሶንረ ቡኤ፤ እንስ ሆማ ኦፍ ሀርካ ቀባቹ ባቱሌ አኩመ ነመ እልሞ ሬኤ ቶኮ ጭጭሩት ሌንጨ ሳፌለ ሰነ ጭጭሬ። ገሩ ዋን ሆጄቴ ሰነ አባፊ ሃዸሳት ህንህምኔ። <verse eid="JDG 14:6"/><verse number="7" style="v" sid="JDG 14:7"/>ኤርገሲ ገድ ቡኤ ዱበርትቲ ወጅን ሃሰኤ፤ እሼንስ እጀሳት ቶልቴ።<verse eid="JDG 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JDG 14:8"/>እንስ ዬሮ ገባባ ቦዴ ዮሙ እሼ ፉዹፍ አች ዴብኤት ረቀ ሌንጨ ሰና እላሉፍ ኦፍረ ገረ ገሌ። ረቀ ሌንጭቻ ኬሰስ ቱትን ከኒሳ ጉቴ ደመ ደሜሴ ቱሬ፤ <verse eid="JDG 14:8"/><verse number="9" style="v" sid="JDG 14:9"/>ደምቸስ ሀርከሳት ፉዸቴ ኛቻ ከራሳ እት ፉፌ። ዮሙ ገረ አባፊ ሃዸሳ ዹፌትስ ደመ ሰነራ እሳኒፍ ኬኔ፤ እሳንስ ንኛተን። እን ገሩ አከ ደመ ሰነ ረቀ ሌንጫ ኬሳ ፉዼ እሳንት ህንህምኔ።<verse eid="JDG 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JDG 14:10"/>ኤርገሲ አባንሳ እንተለቲ እላሉፍ ገድ ቡኤ፤ ሳምሶን አኩመ ደርገጎትን ዬሮ ፉዸንት ጭዸ ጎዸተን ሰነ አችት ጭዸ ቆጴሴ። <verse eid="JDG 14:10"/><verse number="11" style="v" sid="JDG 14:11"/>ዮሙ እን አች ዽኣቴትስ እሰ አርገኒ አማሞተ ሶዶመ እሳፍ ኬነን።<verse eid="JDG 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JDG 14:12"/>ሳምሶንስ አከነ እሳኒን ጄዼ፤ “አን ህቦ ቶኮ እስንት ነንህመ፤ ዮ እስን ጉዮተ ጭዽቻ ቶርበን ኬሰት ሂካሳ አርገተን፣ አን ወያ ቁንጬ ተልባራ ሆጄተሜ ሶዶማፊ ኡፈተ ክቲ ሶዶመ እስኒፍን ኬነ። <verse eid="JDG 14:12"/><verse number="13" style="v" sid="JDG 14:13"/>እስን ዮ ሂካሳ ነት ህሙ ደዸብደን ወያ ቁንጬ ተልባራ ሆጄተሜ ሶዶማፊ ኡፈተ ክቲ ሶዶመ ና ኬንቱ።”</para>
  <para style="p" vid="JDG 14:13">እሳንስ፣ “ህቦኬ ንዸጌኛ ኑት ህመ” ጄዸን።<verse eid="JDG 14:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JDG 14:14"/>እንስ ዴብሴ፣</para>
  <para style="q1" vid="JDG 14:14">“ከን ኛቱ ኬሳ ወን ኛተሙ፣</para>
  <para style="q2" vid="JDG 14:14">ጀባ ኬሳሞ ወን ምኣዉ በኤ”</para>
  <para style="m" vid="JDG 14:14">እሳኒን ጄዼ። እሳንስ ሀመ ጉያ ሰዲት ህቦ ሰነ ሂኩ ህንደንዴኜ ቱሬ።<verse eid="JDG 14:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JDG 14:15"/>እሳንስ ጉያ አፉረፋት ኒቲ ሳምሶኒን፣ “አከ ዽርስኬ ሂካ ህቦ ከና ኑት ህሙፍ ሜ ኑ ከዸዹ፤ ዮ ከና አቺ ኑ ስኢፊ መነ አባኬቲ እብዳን ጉብና። አት ኑ ሳሙፍ አስት ኑ ዋምቴ?” ጄዸኒን።<verse eid="JDG 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JDG 14:16"/>ኒቲን ሳምሶንስ ፉለሳ ዱረት ቦኣ “አት ነ ጅብቴርተ! አት ዹጉማን ነ ህንጃለቱ። አት ሰበኮ ህቦ ጋፈቴርተ፤ ገሩ ሂካሳ ነት ህንህምኔ” ጄቴን።</para>
  <para style="p" vid="JDG 14:16">እንስ ዴብሴ፣ “አን አባኮቲፊ ሃዸኮትዩ ህንህምኔ፤ ኤጋ አን ስት ህሙ ቀባ?” ጄዼን። <verse eid="JDG 14:16"/><verse number="17" style="v" sid="JDG 14:17"/>እሼንስ ጉያ ጭዸ ሰና ቶርበኑ ቦቴ እሰ ረክፍቴ፤ እንስ ሰበቢ እሼን እቱመ ፉፍቴ ቦቆና እሰ ዾውቴፍ ጉያ ቶርበፋት ሂካሳ እሼት ህሜ። እሼንሞ ሂካ ህቦ ሰና ሰበሼት ህምቴ።<verse eid="JDG 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JDG 14:18"/>ነሞትን መጋላ ሰናስ ጉያ ቶርበፋት ኡቱ ቢፍቱን ህንልጥን፣</para>
  <para style="q1" vid="JDG 14:18">“ወን ደመ ጫላ ምኣዉ ማል?</para>
  <para style="q2" vid="JDG 14:18">ጀባን ሌንጨ ጫሉ ማል?” ጄዸኒን።</para>
  <para style="p" vid="JDG 14:18">ሳምሶንስ፣</para>
  <para style="q1" vid="JDG 14:18">“ኡቱ ራደኮቲን ቆተቹ ባተኒ፣</para>
  <para style="q2" vid="JDG 14:18">እስን ስላ ህቦኮ ህንሂክተን ቱሬ” ጄዼን።<verse eid="JDG 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JDG 14:19"/>ከነረት ሀፉር <char style="nd">ዋቀዮ</char> ጀብናን እሰረ ቡኤ። እንስ ገረ አሽቀሎንት ገድ ቡኤ ነሞተ መጋላ ኬሳ ሶዶመ አጄሴ፤ ዋን እሳን ቀበንስ እራ ፉዸቴ ነሞተ ህቦ ሰነ ሂከኒፍ ኡፈተ ክቲ ኬኔ። ኣሪዻንስ ጉበቻ ገረ መነ አባሳት ዴብኤ። <verse eid="JDG 14:19"/><verse number="20" style="v" sid="JDG 14:20"/>ኒቲ ሳምሶንስ ሚንጄሳት ሄሩምሲሰን።<verse eid="JDG 14:20"/></para>
  <chapter eid="JDG 14"/>
  <chapter number="15" style="c" sid="JDG 15"/>
  <para style="s1">ሳምሶን ፍልስጤሞተት ሃሎ በኤ</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 15:1"/>ኤርገሲ ዬሮ ቀመዲን ወልት ቀበሙት ሳምሶን ኮርመ ሬኤ ጥናሳ ፉዸቴ ኒቲሳ እላሉ ዸቄ። እንስ፣ “አን ደሬ ኒቲኮ ነንሴነ” ጄዼ። አባን ኒቲሳ ገሩ ኤየሙፊ ድዴ።<verse eid="JDG 15:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JDG 15:2"/>እንስ፣ “አን ዋን አት እሼ ጅብቴርተ ጄዼ ዹጉማን አመኔፍ ሚንጄኬት እሼ ሄሩምሲሴረ፤ ኦቦሌቲንሼ ቁጥሱን፣ እሼ ጫላ በሬዱ ምቲ? ቆደ ሰና እሼ ፉዸዹ” ጄዼን።<verse eid="JDG 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JDG 15:3"/>ሳምሶን ዴብሴ፣ “አን ዬሮ ከነት ዮ ሚዻ ከምዩ ፍልስጤሞተ እራን ገኤ እት ህንጋፈተሙ” እሳኒን ጄዼ። <verse eid="JDG 15:3"/><verse number="4" style="v" sid="JDG 15:4"/>ከናፉ እን አቺ በኤ ዋንጎተ ዽበ ሰዲ ቀቤ ለመ ለማን ኤጌሳኒ ወልት ህዼ። ኤጌ ለማን ለማንሳኒረትስ ጉጨ ጉዱንፌ፤ <verse eid="JDG 15:4"/><verse number="5" style="v" sid="JDG 15:5"/>እብደስ እት ቀብሲሴ ቀመዲ ፍልስጤሞታ ኬሰት ዋንጎተ ሰነ ገድ ለክሴ። ምዻን ሃመሜፊ ከን ህንሃመምንት አከሱመስ እዶ ዻባ ወይኒቲፊ ኤጄርሳ ጉጉቤ።<verse eid="JDG 15:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JDG 15:6"/>ዬሮ ፍልስጤሞትን፣ “ኤኙቱ ዋን ከነ ጎዼ?” ጄዸኒ ጋፈተንት፣ “ሳምሶን ዽርሰ እንተለ ነምቸ ቲምናህ ሰናቱ ሰበቢ ኒቲንሳ ሚንጄሳት ጀላ ሄሩምሲፈምቴፍ ዋን ከነ ጎዼ” ጄዸሜ እሳንት ህመሜ።</para>
  <para style="p" vid="JDG 15:6">ከናፉ ፍልስጤሞትን ኦል በአኒ ኒቲ ሳምሶኒፊ አባሼ ጉበኒ አጄሰን። <verse eid="JDG 15:6"/><verse number="7" style="v" sid="JDG 15:7"/>ሳምሶንስ፣ “ኤርገ እስን አከስ ጎተኒ አን ሀመ ሃሎኮ ባፈዹት እስን ህንዺሱ” እሳኒን ጄዼ። <verse eid="JDG 15:7"/><verse number="8" style="v" sid="JDG 15:8"/>አከ መሌስ እሳን ዸኤ ሄዱሳኒ ገላፈቴ። ኤርገሲ ገድ ቡኤ ሆልቀ ከታ ኤጣም ኬሰ ጅራቴ።<verse eid="JDG 15:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JDG 15:9"/>ፍልስጤሞትንስ ኦል በአኒ ናኖ ሌሂት ፈፈጨአኒ ይሁዳ ኬሰ ቁበተን። <verse eid="JDG 15:9"/><verse number="10" style="v" sid="JDG 15:10"/>ነሞትን ይሁዳስ፣ “እስን ማሊፍ ኑ ወራኑፍ ዹፍተን?” ጄዸኒ እሳን ጋፈተን።</para>
  <para style="p" vid="JDG 15:10">እሳንስ ዴብሰኒ፣ “ኑ ሳምሶን ሂኔ ዋን እን ኑ ጎዼ ሰነ እሰ ጎዹፍ ዹፍኔ” ጄዸን።<verse eid="JDG 15:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JDG 15:11"/>ኤርገሲስ ነሞትን ኩመ ሰዲ ይሁዳዻ ገረ ሆልቀ ኤጣምት ገድ ቡአኒ ሳምሶኒን፣ “አት ማል ኑ ጎቴ? አከ ፍልስጤሞትን ኑ ቡልቸን ህንቤክቱ?” ጄዸን።</para>
  <para style="p" vid="JDG 15:11">እንስ፣ “አን ዋኑመ እሳን ነ ጎዸን ሰነ እሳንረት ነንጎዼ” ጄዼ ዴብሴ።<verse eid="JDG 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JDG 15:12"/>እሳንስ፣ “ኑ ስ ሂኔ ደበርስኔ ፍልስጤሞተት ስ ኬኑፍ ዹፍኔ” ጄዸኒን።</para>
  <para style="p" vid="JDG 15:12">ሳምሶንሞ፣ “እስን መታንኬሰን አከ ነ ህንአጄፍኔ ና ከከዻ” ጄዼ።<verse eid="JDG 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JDG 15:13"/>እሳንስ፣ “ቶሌ፣ ኑ ስ ሂኔ ደበርስኔ ሀርከሳኒት ስ ኬንነ መሌ ኦፊኬኛን ስእ ህንአጄፍኑ” ጄዸኒን። ከናፉ ፉኞ ሃራ ለማን እሰ ህዸኒ ሆልቀ ኬሳ እሰ ባሰን። <verse eid="JDG 15:13"/><verse number="14" style="v" sid="JDG 15:14"/>ዬሮ እን ሌሂት ዽኣቴትስ ፍልስጤሞትን እያ ገረሳ ዹፈን። ሀፉር <char style="nd">ዋቀዮስ</char> ጀብናን እሰረ ቡኤ። ፉኞን ሀርክሳ እቲን ህዸሜ ቱሬ ሱን አከ ቁንጬ ተልባ ከን እብደ ኬሰ ቡኤ ተኤ፤ ህዻንሳስ ሀርከሳራ ጭጭቴ። <verse eid="JDG 15:14"/><verse number="15" style="v" sid="JDG 15:15"/>እንስ ለፌ ሀኦ ሀሬ ሃራሳ አርገቴ ሂጠቴ ፉዸቴ፤ እቲንስ ዸኤ ነመ ኩመ ቶኮ ፍጤ።<verse eid="JDG 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JDG 15:16"/>ከነረትስ ሳምሶን፣</para>
  <para style="q1" vid="JDG 15:16">“አን ለፌ ሀኦ ሀሬ ቶኮን፣</para>
  <para style="q2" vid="JDG 15:16">ወልረ እሳን ነንቱሌ፤</para>
  <para style="q1" vid="JDG 15:16">ለፌ ሀኦ ሀሬ ቶኮቲን፣</para>
  <para style="q2" vid="JDG 15:16">ነሞተ ኩመ ቶኮ ነንአጄሴ” ጄዼ።<verse eid="JDG 15:16"/></para>
  <para style="m">
    <verse number="17" style="v" sid="JDG 15:17"/>እንስ ኤርገ ዋን ከነ ዱበቴ ፍጠቴ ቦዴ ለፌ ሀኦ ሀሬ ሰነ አች ደርበቴ፤ እዶን ሱንስ ራማት ሌሂ ጄዸሜ።<verse eid="JDG 15:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JDG 15:18"/>እንስ ሰበቢ አከ መሌ ዼቦቴፍ፣ “አት ሞአትና ጉዳ አከና ገርብቸኬቲፍ ኬንቴርተ። ኤጋ አን አመ ዼቡዻን ዱኤ ሀርከ ወረ ዸግነ ህንቀበትኒ ኬሰን ቡኣ?” ጄቹዻን <char style="nd">ዋቀዮን</char> ዋመቴ። <verse eid="JDG 15:18"/><verse number="19" style="v" sid="JDG 15:19"/>ዋቅንስ ቦለ ሌሂ ኬሰ ጅሩ ዾሴ ብሻን ባሴ። ሳምሶንስ ዮሙ ብሻን ሰነ ዹጌት ሁምንሳ ዴብኤፊ ጀባቴ። ከናፉ ቡርቃን ሱን ኤን ሀቆሬ ጄዸሜ ሞጋፈሜ። እንስ ሀመ ሀርኣት አቹመ ሌሂት አርገመ።<verse eid="JDG 15:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JDG 15:20"/>ሳምሶን በረ ፍልስጤሞታ ኬሰ ወጋ ድግደመ እስራኤሎተ ቡልቼ።<verse eid="JDG 15:20"/></para>
  <chapter eid="JDG 15"/>
  <chapter number="16" style="c" sid="JDG 16"/>
  <para style="s1">ሳምሶኒፊ ደሊላ</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 16:1"/>ጋፍ ቶኮ ሳምሶን ገረ ጋዛ እዶ እት ሰጋገልቱ ቶኮ አርጌ ዸቄ። እሼ ወጅን ቡሉፍስ ኦል ሴኔ። <verse eid="JDG 16:1"/><verse number="2" style="v" sid="JDG 16:2"/>ነሞተ ጋዛትስ፣ “ሳምሶን አስ ጅረ!” ጄዸሜ ህመሜ። ከናፉ እሳን ናኖ ሰነ መርሰኒ ሀልከን ጉቱ ርጰኒ ከረ መጋለቲረት እሰ ኤገተን። እሳንስ፣ “ገነመ በሪ እሰ አጄፍነ” ጄዸኒ ሀልከን ሰነ ኡቱ ህንሶቾእን ቡለን።<verse eid="JDG 16:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JDG 16:3"/>ሳምሶን ገሩ ሀመ ወለካ ሀልከኒት አች ረፌ። ኤርገሲ ከኤ ጩፋወን ከረ መጋለቲ ምችችለ ለመ ወጅን፣ ደንቀራሳቲፊ ዋን ሁንደ ቡቅሴ። ኦል ፉዼስ ገቲቲ እሰት ባቹዻን ገረ ፊጤ ጋረ ፉሌ ኬብሮንት ኦል በኤ።<verse eid="JDG 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JDG 16:4"/>ዬሮ ሙራሰ ቦዴ ሳምሶን ጃለለ ዱበርቲ ሱሉለ ሶሬቅ ኬሰ ጅራቱ ቶኮቲን ቀበሜ፤ መቃንሼስ ደሊላ ጄዸመ ቱሬ። <verse eid="JDG 16:4"/><verse number="5" style="v" sid="JDG 16:5"/>ቡልችቶትን ፍልስጤሞታስ ገረሼ ዸቀኒ፣ “አከ ኑ ሂኔ እሰ ሚዹ ደንዴኙፍ፣ አከ እን እጪቲ ጀብነሳ ጉዳ ከናቲፊ አከ ኑ እት እሰ ሞአቹ ደንዴኙ ስት ህሙፍ እሰ ሶሶብ። ቶኮን ቶኮንኬኘስ ሜቲ ኩመ ቶኮፊ ዽበ ቶኮ ሲፍ ኬንና” ጄዸኒን።<verse eid="JDG 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JDG 16:6"/>ደሊላንስ ሳምሶኒን፣ “እጪቲ ጀብነኬ ጉዳ ሰናቲፊ አከ አት እት ቀበምቴ ህዸሙ ደንዴሱ ነት ህም” ጄቴ።<verse eid="JDG 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JDG 16:7"/>ሳምሶንሞ ዴብሴ፣ “ዮ ነምን ከምዩ ቴጰ ሃራ ህንጎግን ቶርባን ነ ህዼ፣ አን አኩመ ነመ ብራ ከምዩ ደዸባ ነንተአ” ጄዼን።<verse eid="JDG 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JDG 16:8"/>ቡልችቶትን ፍልስጤሞታስ ኤርገሲ ቴጰ ሃራ ህንጎግን ቶርበ ፍደኒ እሼት ኬነን፤ እሼንስ እቲን እሰ ሂቴ። <verse eid="JDG 16:8"/><verse number="9" style="v" sid="JDG 16:9"/>እሼን ጎለ ኬሰት ነሞተ ዾክስቴ፣ “ሳምሶን፣ ፍልስጤሞትን ስት ዹፈን!” ጄቴን። እን ገሩ ቴጰወን ሰነ አኩመ ርቡን ዮሙ እብደ ብረ ገኡ በቁት ረክነ መሌ ኦፍራ ኩኩቴ። ከናፉ እጪቲን ጀብነሳ ህንቤከምኔ።<verse eid="JDG 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JDG 16:10"/>ደሊላን ሳምሶኒን፣ “አት ነ ጎዎምስቴ፤ ነ ሶብዴስ። አመ ኮቱ አከ እት ህዸሙ ደንዴሱ ነት ህም” ጄቴ።<verse eid="JDG 16:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JDG 16:11"/>እንስ፣ “ዮ ነምን ከምዩ ፉኞ ሃራ ነምን እት ህንፈየደምኒን ነ ህዼ፣ አን አኩመ ነመ ብራ ከሚዩ ደዸባ ነንተአ” ጄዼን።<verse eid="JDG 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JDG 16:12"/>ከናፉ ደሊላን ፉኞ ሃራ ፉቴ እቲን እሰ ሂቴ። ነሞተ ስ ጎለ ኬሰት ዾክስቴ፣ “ሳምሶን፣ ፍልስጤሞትን ስት ዹፈን!” ጄቴን። እን ገሩ ፉኞወን ሰነ አኩመ ክሪት ሀርከ ኦፊራ ኩኩቴ።<verse eid="JDG 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JDG 16:13"/>ደሊላንስ ሳምሶኒን፣ “አት ሀመ አማት ነ ጎዎምስቴርተ፤ ነ ሶብዴርተስ። አከ እት ህዸሙ ደንዴሱ ነት ህም” ጄቴ።</para>
  <para style="p" vid="JDG 16:13">እንስ፣ “ዮ አት ጉዱሩ መታኮ ቶርበን ወልት ፎቴ ቆፎት ነ ሂቴ፣ አን አኩመ ነመ ብራ ከሚዩ ደዸባ ነንተአ” እሼን ጄዼ። ደሊላንስ ኡቱ እን ረፉ ጉዱሩ መታሳ ቶርበን ወልት ፎቴ፣ <verse eid="JDG 16:13"/><verse number="14" style="v" sid="JDG 16:14"/>ቆፎት እሰ ሂቴ።</para>
  <para style="p" vid="JDG 16:14">አመስ እሰ ዋምቴ፣ “ሳምሶን፣ ፍልስጤሞትን ስት ዹፈን!” ጄቴ። እን ገሩ ህርባ ከኤ ቆፎ ሰነ ጉዱሩ መታሳ ወጅን ቡቅሴ።<verse eid="JDG 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JDG 16:15"/>እሼንስ፣ “አት ኡቱ ነ ህንአመንን አከምት፣ ‘አን ስን ጃለዸ’ ናን ጄተ? ኡቱ እጪቲ ጀብነኬ ጉዳ ሰና ነት ህንህምን፣ አት ነ ሶቡንኬ ኩን ዬሮ ሰደፋዸ” ጄቴን። <verse eid="JDG 16:15"/><verse number="16" style="v" sid="JDG 16:16"/>ጉዩመ ጉያንስ ሀመ ሉቡንሳ ጅሬኘ ጅብቱት ዱቢሼቲን አፋን እሰ ጎግስቴ።<verse eid="JDG 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JDG 16:17"/>ከናፉ እን ዋን ሁንደ እሼት ህሜ። አከነስ ጄዼን፤ “ሰበቢ አን ጋፉመ ዸለዼ ጀልቀቤ ናዝርቸ ተኤ ዋቃፍ አዳን ባፈሜፍ ቀረባን ተኩማ መታኮ ቱቄ ህንቤኩ። ዮ መታንኮ ሃደሜ ገሩ ጀብንኮ ነራ በዴ አንስ አኩመ ነመ ብራ ከሚዩ ደዸባ ነንተአ።”<verse eid="JDG 16:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JDG 16:18"/>ደሊላንስ ዮሙ አከ እን ዋን ሁንደ እሼት ህሜ ሁበቴት፣ “እን ዋን ሁንደ ነት ህሜራቲ ሜ ዴብኣ ኮታ” ጄቴ ቡልችቶተ ፍልስጤሞታት ኤርጋ ኤርግቴ። ከናፉ ቡልችቶትን ፍልስጤሞታ ሀርከሳኒት ሜቲ ቀበተኒ ገረሼ ዹፈን። <verse eid="JDG 16:18"/><verse number="19" style="v" sid="JDG 16:19"/>አከ እን ጉዴደሼረ ጪሱ ጎቴ ነመ ቶኮ ዋምቴ ጉዱሩ መታሳ ቶርበን እራ ሃድችሲፍቴ። እሼንስ አከ መሌ እሰ ረክሱ ጀልቀብዴ። ጀብንሳስ እሰራ በዴ።<verse eid="JDG 16:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JDG 16:20"/>እሼንስ፣ “ሳምሶን፣ ፍልስጤሞትን ስት ዹፈን!” ጄቴን።</para>
  <para style="p" vid="JDG 16:20">እንስ ህርባ ከኤ፣ “አን አኩመ ዬሮ ካኒ ገድ በኤ ኦፍራ ሀርጫሰ” ጄዼ። ገሩ አከ <char style="nd">ዋቀዮ</char> እሰ ዺሴ ዴሜ ህንቤክኔ ቱሬ።<verse eid="JDG 16:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JDG 16:21"/>ኤርገሲ ፍልስጤሞትን እሰ ቀበኒ እጀሳ ኬሳ ባሰኒ ገረ ጋዛት እሰ ጌሰን። ፎንጫ ናሲቲን እሰ ህዸኒስ መነ ህዻ ኬሰት ዳክቱ ምዻኒ እሰ ጎዸን። <verse eid="JDG 16:21"/><verse number="22" style="v" sid="JDG 16:22"/>ርፌንስ መታሳ ገሩ ኤርገ ሃደሜ ቦዴ ዴብኤ ጉደቹ ጀልቀቤ።<verse eid="JDG 16:22"/></para>
  <para style="s1">ሳምሶን ዱኡሳ</para>
  <para style="p">
    <verse number="23" style="v" sid="JDG 16:23"/>ቡልችቶትን ፍልስጤሞታ፣ “ዋቅንኬኘ፣ ሳምሶን ዲነኬኘ ሰነ ደበርሴ ሀርከኬኘት ኑ ኬኔረ” ጄዸኒ ገመዱዻን ዳጎን ዋቀሳኒቲፍ ኣርሳ ጉዳ ዽኤሱፍ ወልት ቀበመኒ ቱረን።<verse eid="JDG 16:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JDG 16:24"/>ነሞትንስ ዬሮ እሰ አርገንት ዋቀሳኒ ገለቴፈቻ፣</para>
  <para style="q1" vid="JDG 16:24">“ዋቅንኬኘ፣</para>
  <para style="q2" vid="JDG 16:24">ዲነኬኘ ከን ብየኬኘ በሌሴ፣</para>
  <para style="q1" vid="JDG 16:24">ከን ነመ ባይኤ ኑ ዱራ አጄሴ ሰነ</para>
  <para style="q2" vid="JDG 16:24">ደበርሴ ኑ ኬኔረ” ጄዸን።<verse eid="JDG 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JDG 16:25"/>እሳንስ ኡቱመ ገራንሳኒ ገመዳ ጅሩ፣ “አከ እን ኑ በሸነንሲሱፍ ሜ ሳምሶንን ዋማ” ጄዸን። ከናፉ ሳምሶንን መነ ህዻቲ ዋመኒ ፍደን፤ እንስ እሳን በሸነንሲሴ።</para>
  <para style="p" vid="JDG 16:25">ዮሙ እሳን ኡቱባወን ጉርጉዳ ግዱ እሰ ዻበቺሰንት፣ <verse eid="JDG 16:25"/><verse number="26" style="v" sid="JDG 16:26"/>ሳምሶን ተጃጅላ ሀርከሳ ቀቤ ቱሬ ሰናን፣ “አከ አን እት እርከዹፍ ገረ ኡቱባወን መነ ሰገዳ ከነ ቀበኒ ዻበኒት ነ ዽኤስ” ጄዼ። <verse eid="JDG 16:26"/><verse number="27" style="v" sid="JDG 16:27"/>መን ሰገዳ ሱን ዺራ ዱበርቲን ጉተሜ ቱሬ፤ ቡልችቶትን ፍልስጤሞታ ሁንድኑስ አች ቱረን፤ ሳምሶኒ ተጰ አርግሲሱ እላሉፍ ጄዸኒ ነሞትን ኩመ ሰዲ በንቲ መንቻረ ቱረን። <verse eid="JDG 16:27"/><verse number="28" style="v" sid="JDG 16:28"/>ሳምሶንስ አከነ ጄዼ <char style="nd">ዋቀዮን</char> ከዸቴ፤ “ያ <char style="nd">ዋቀዮ</char> ጎፍታ፣ ነ ያደዹ። ያ ዋቅ፣ አከ አን እጀኮ ለማኒፍ ፍልስጤሞተ ሃሎ ባፈዹፍ ዬሮ ቶኮ ጀብነ ና ኬን።” <verse eid="JDG 16:28"/><verse number="29" style="v" sid="JDG 16:29"/>ሳምሶንስ ኤርገሲ ኡቱባወን ጉርጉዳ ለማን ከኔን ወለካ መነ ሰገዳ ሰና ዻበተኒ መነ ሰነ ባተንት ሂጠቴ ቶኮ ሀርከሳ ምርጋቲን፣ ካንሞ ሀርከሳ ብታቲን ቀበቴ፣ <verse eid="JDG 16:29"/><verse number="30" style="v" sid="JDG 16:30"/>“አን ፍልስጤሞተ ወጅን ዱአ!” ጄዼ ሁምነ ቀቡ ሁንዳን ዺቤ፤ መንች ሰገዳስ ቡልችቶታፊ ነሞተ አች ኬሰ ቱረን ሁንደረት ጅጌ። ከናፉ ነሞትን እን ዬሮ ዱአሳት አጄሴ ከኔን እን ዬሮ ጅሬኘሳት አጄሴ ጫላ ባይኤ ቱረን።<verse eid="JDG 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JDG 16:31"/>ኦቦሎትንሳቲፊ ማቲን አባሳ ሁንድኑ ሬፈሳ ፉዹ ገድ ቡአን። እሳንስ እሰ ፍደኒ ዞራፊ ኤሽታኦል ግዱት እዶ አዋለ አባሳ ከን ማኖኣ ኬሰት እሰ አዋለን። እን ወጋ ድግደመ እስራኤልን ቡልቼ።<verse eid="JDG 16:31"/></para>
  <chapter eid="JDG 16"/>
  <chapter number="17" style="c" sid="JDG 17"/>
  <para style="s1">ዋቆተ ቶልፈሞ ሚካ</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 17:1"/>ነምቸ ብየ ጋረ ኤፍሬም ኬሰ ጅራቱ ከን መቃንሳ ሚካያ ጄዸሙ ቶኮቱ ቱሬ፤ <verse eid="JDG 17:1"/><verse number="2" style="v" sid="JDG 17:2"/>እንስ ሃዸሳቲን፣ “ሜቲን ኩመ ቶኮፊ ዽበ ቶኮ ኡልፋቱ ከን ስ ዱራ በዴ አን ኡቱ አት ነመ ስ ጀላ ፉዸቴ አባርቱ ዸገኤ ሱን ነ ብረ ጅረ፤ ከን ፉዸቴስ አኑመ” ጄዼ።</para>
  <para style="p" vid="JDG 17:2">ሃትሳስ፣ “ያ እልመኮ፣ <char style="nd">ዋቀዮ</char> ስ ሃኤብሱ” ጄቴን።<verse eid="JDG 17:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JDG 17:3"/>ዮሙ እን ሜቲ ኩመ ቶኮፊ ዽበ ቶኮ ሰነ ዴብሴ ሃዸሳት ኬኔትስ፣ ሃትሳ፣ “አከ እልምኮ ፈኪ ሜቲን እት ኡፍፈሜ እቲን ሆጄቱፍ አን ሜቲኮ <char style="nd">ዋቀዮፍ</char> አዳን ባሴረ። አን አመስ ዴብሴ ስትን ኬነ” ጄቴን።<verse eid="JDG 17:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JDG 17:4"/>ከናፉ እን ሜቲ ሰነ ዴብሴ ሃዸሳቲፍ ኬኔ፤ እሼንስ ሜቲ ዽበ ለመ ፉቴ ቱምቱ ሜቲት ኬንቴ፤ ቱምቱን ሱንስ ፈኪፊ ዋቀ ቶልፈማ እቲን ሆጄቴ። ፈኪፊ ዋቅን ቶልፈማን ሱንስ መነ ሚካያ ኬሰ ካአመን።<verse eid="JDG 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JDG 17:5"/>ነምች ሚካ ጄዸሙ ኩንስ ገልመ ዋቀ ቶልፈማ ቀበ ቱሬ፤ እንስ ድረታፊ ዋቆተ ቶልፈሞ ቶኮ ቶኮ ቶልቼ እልማንሳ ኬሳ ነመ ቶኮ ሉበ ጎዸቴ። <verse eid="JDG 17:5"/><verse number="6" style="v" sid="JDG 17:6"/>በረ ሰነ እስራኤል ኬሰ ሞቲን ህንጅሩ ቱሬ፤ ቶኮን ቶኮን ነማ ዋኑመ እሰት ቶሌ ሆጄተ ቱሬ።<verse eid="JDG 17:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JDG 17:7"/>ዬሮ ሰነት ብየ ይሁዳ ኬሰ ደርገጌሰ ጎሰ ሌዊ ከን ቤትልሄም ኬሰ ጎሰ ይሁዳ ግዱ ጅራቱ ቶኮቱ ቱሬ። <verse eid="JDG 17:7"/><verse number="8" style="v" sid="JDG 17:8"/>እንስ እዶ ጅሬኛ ከን ብራ በርባዱፍ ጄዼ መጋላ ሰነ ዺሴ ዴሜ። ኡቱመ ዴሙስ ገረ ብየ ጋራ ኤፍሬም መነ ሚካ ዹፌ።<verse eid="JDG 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JDG 17:9"/>ሚካንስ፣ “አት ኤሳ ዹፍቴ?” ጄዼ እሰ ጋፈቴ።</para>
  <para style="p" vid="JDG 17:9">እንስ፣ “አን ነመ ሌዊ ከን ቤትልሄም ብየ ይሁዳቲ ዹፌ እዶ ጅሬኛ በርባዱዸ” ጄዼን።<verse eid="JDG 17:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JDG 17:10"/>ሚካንስ፣ “ነ ወጅን ጅራዹቲ አባፊ ሉበ ና ተእ፤ አንስ ወጋት ሜቲ ኩዸን ሲፍ ኬነ፤ ኡፈተኬቲፊ ኛተኬስ ነንደንደአ” እሳን ጄዼ። <verse eid="JDG 17:10"/><verse number="11" style="v" sid="JDG 17:11"/>ከናፉ ሌውች ሱን እሰ ወጅን ጅራቹፍ ወሊ ገሌ፤ ደርገጌስ ሱንስ ሚካዻፍ እልማንሳ ኬሳ አኩመ ነመ ቶኮ ተኤ። <verse eid="JDG 17:11"/><verse number="12" style="v" sid="JDG 17:12"/>ሚካንስ ደርገጌሰ ሌዊ ሰነ ሙደቴ፤ እንስ ሉበሳ ተኤ መነሳ ጅራቴ። <verse eid="JDG 17:12"/><verse number="13" style="v" sid="JDG 17:13"/>ሚካንስ፣ “ኤርገ ሌውች ኩን ሉበኮ ተኤ፣ አን አከ <char style="nd">ዋቀዮ</char> ዋን ጋሪ ና ጎዹ ነንቤከ” ጄዼ።<verse eid="JDG 17:13"/></para>
  <chapter eid="JDG 17"/>
  <chapter number="18" style="c" sid="JDG 18"/>
  <para style="s1">ነሞትን ዳን ላይሽ ኬሰ ቁበተን</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 18:1"/>ዬሮ ሰነት እስራኤል ኬሰ ሞቲን ህንጅሩ ቱሬ።</para>
  <para style="p" vid="JDG 18:1">ሰበቢ ሀመ ዬሮ ሰናት ጎሶተ እስራኤል ግዱት ዻል እሳኒፍ ህንኬነምኒፍ ጎስት ዳን እዶ ቁበተን በርባደቻ ቱረን። <verse eid="JDG 18:1"/><verse number="2" style="v" sid="JDG 18:2"/>ከናፉ ወር ዳን አከ እሳን ብየ ሰነ በሳሰኒፊ መጋላ ዞራቲፊ ኤሽታኦል ኬሳ ነሞተ ጀጀቦ ሸን ኤርገን። ነሞትን ኩኔንስ ጎሶተሳኒ ሁንደ እዶ ቡአን። ወረ ኤርገኒንስ፣ “ዸቃቲ ብየቲ ሰከተኣ” ጄዸን።</para>
  <para style="p" vid="JDG 18:2">ኤርገሞትን ሱንስ ብየ ጋራ ኤፍሬሚት ኦል በአኒ መነ ሚካ ዹፈን፤ ሀልከን ሰነስ አች ቡለን። <verse eid="JDG 18:2"/><verse number="3" style="v" sid="JDG 18:3"/>እሳንስ ዮሙ መነ ሚካ ብረ ገአንት ሰገሌ ደርገጌሰ ሌውቸ ሰና ሁበተን፤ ከናፉ እት ጎረኒ፣ “ኤኙቱ አስ ስ ፍዴ? አት ማል አሲ ጎተ? ማሊፍስ አስ ዹፍቴ?” ጄዸኒ እሰ ጋፈተን።<verse eid="JDG 18:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JDG 18:4"/>እንስ፣ “ሚካቱ ነ ቀጠረቴ፤ አንስ ሉበሳት” ጄዼ ዋን እን እሳፍ ጎዼ እሳንት ህሜ።<verse eid="JDG 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JDG 18:5"/>እሳንስ፣ “ማሎ ሜ አከ ከራንኬኘ ምልካኡፊ አከ ህንምልኮፍኔ ዋቀ ኑ ጋፈዹ” ጄዸኒን።<verse eid="JDG 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JDG 18:6"/>ሉብችስ፣ “ነጋን ዴማ፤ <char style="nd">ዋቀዮ</char> ከራኬሰን እስኒ ምጄሴረ” እሳኒን ጄዼ።<verse eid="JDG 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JDG 18:7"/>ከናፉ ነሞትን ሸነን ሱን ከአኒ ላይሽ ዸቀን፤ አከ ነሞትን አች ጅራተን፣ አኩመ ወረ ሲዶና ሶዳ ቶኮ መሌ ነጋዻን ጅራተንስ አርገን። እሳንስ ሰበቢ ለፍትሳኒ ዋን ሁንደ ቀብዱፍ ጅሬኘ በዻዻ ጅራተን። አከሱመስ ሰበቢ ወረ ሲዶናራ ፈጋተኒ ጅራቻ ቱረኒፍ እሳን ኤኙመ ወጅኑ ወልት ዹፌኘ ቶኮሌ ህንቀበን ቱሬ።<verse eid="JDG 18:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JDG 18:8"/>ዮሙ እሳን ዞራፊ ኤሽታኦልት ዴብአንት ኦቦሎትንሳኒ፣ “ኦዱ ማሊ ቀበተኒ ዴብተን?” ጄዸኒ እሳን ጋፈተን።<verse eid="JDG 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JDG 18:9"/>እሳንስ ዴብሰኒ አከነ ጄዸኒን፤ “ከኣ ዸቅኔ እሳን ሎላ! ኑ አከ ብየቲን ገበቱ ታቴ አርግኔረ። እስን ዋን ከነ እቱመ ዺፍቱ? ዸቅጠኒ ቀበቹ ህንመምና። <verse eid="JDG 18:9"/><verse number="10" style="v" sid="JDG 18:10"/>እስንስ ዮሙ አች ጌሰንት ሰበ ያዶ ቶኮ መሌ ጅራቱፊ ብየ በልኣ ዋቅን ደበርሴ ሀርከኬሰንት እስኒ ኬኑ ከን ወን ቶኮዩ እት ህንህርአትን አርገቱ።”<verse eid="JDG 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JDG 18:11"/>ከነረት ጎሰ ዳን ኬሳ ነሞትን ዽበ ጀአ ምአ ሎላ ህዸተኒ ዞራፊ ኤሽታኦሊ ከአን። <verse eid="JDG 18:11"/><verse number="12" style="v" sid="JDG 18:12"/>ኦል በአኒስ ይሁዳ ኬሰ እዶ ክርያት ዬኣሪም ጄዸሙ ብረ ቁበተን። ሰበቢ ከናፍ እዶን ሱን ሀመ ሀርኣት ቁበተ ዳን ጄዸሜ ዋመመ፤ ቁበን ሱንስ ገመ ልጠ ክርያት ዬኣሪምት አርገመ። <verse eid="JDG 18:12"/><verse number="13" style="v" sid="JDG 18:13"/>እሳንስ አቺ እት ፉፈኒ ገረ ብየ ጋራ ኤፍሬምት ኦል በአኒ መነ ሚካ ዹፈን።<verse eid="JDG 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JDG 18:14"/>ነሞትን ሸነን ብየ ላይሽ በሳሰኒ ቱረን ሱንስ፣ ኦቦሎተሳኒቲን፣ “እስን አከ መኔን ከነ ኬሳ ቶኮ ድረተ፣ ፈኪ ዋቆተ ቶልፈሞ መነ ኬሳ፣ ፈኪ ሶፈሜፊ ፈኪ ሜቲን እት ኡፍፈሜ ቀቡ ቤክቱ? አመ ዋን ጎቹ ቀብደን ቤካ” ጄዸን። <verse eid="JDG 18:14"/><verse number="15" style="v" sid="JDG 18:15"/>ከናፉ እሳን አች ጎረኒ መነ ሚካ እዶ ሌውች ደርገጌስ ሱን ጅራቱ ዹፈኒ ነጋ እሰ ጋፈተን። <verse eid="JDG 18:15"/><verse number="16" style="v" sid="JDG 18:16"/>ነሞትን ዳን ወር ምአ ሎላ ህዸተን ዽብ ጀኣን በልበለ እቲን ከረ ሴነንረ ዻበተኒ ቱረን። <verse eid="JDG 18:16"/><verse number="17" style="v" sid="JDG 18:17"/>ነሞትን ብየቲ በሳሰን ሸነን ኦል ገለኒ ፈኪ ሶፈሜ፣ ድረተ፣ ዋቆተ ቶልፈሞ መነ ኬሳቲፊ ዋቀ ቶልፈማ በቅፈሜ ሆጄተሜ ፉዸተን። ዬሮ ከነት ሉብን ሱኒፊ ነሞትን ምአ ሎላ ህዸተን ዽብ ጀኣን በልበለ እቲን ከረ ሴነንረ ዻበቻ ቱረን።<verse eid="JDG 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JDG 18:18"/>ዮሙ ነሞትን ኩኔን መነ ሚካ ሴነኒ ፈኪ ሶፈሜ፣ ድረተ፣ ዋቆተ ቶልፈሞ መነ ኬሳ ብራቲፊ ዋቀ በቅፈሜ ሆጄተሜ ፉዸተንት ሉብች፣ “እስን ማል ሆጄቻ ጅርቱ?” እሳኒን ጄዼ።<verse eid="JDG 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JDG 18:19"/>እሳንስ፣ “ጨልእስ! አፋንኬ ቀበዹ፤ ኑ ፋነ ኮቱቲ አባፊ ሉበ ኑ ተእ። መነ ነመ ቶኮ ኬሰ ተጃጅሉረ ሰኚፊ ጎሰ እስራኤሊፍ ሉበ ታቴ ተጃጅሉ ሲፍ ህንወዩ?” ጄዸኒን። <verse eid="JDG 18:19"/><verse number="20" style="v" sid="JDG 18:20"/>ሉብን ሱን ንገመዴ። እንስ ድረተ፣ ዋቆተ ቶልፈሞ መነ ኬሳ ብራቲፊ ፈኪ ሶፈሜ ሰነ ፉዸቴ እሳን ወጅን ዴሜ። <verse eid="JDG 18:20"/><verse number="21" style="v" sid="JDG 18:21"/>እሳንስ፣ እጆሌሳኒ ጥጥኖ፣ ሆሪሳኒቲፊ ቀቤኘሳኒ ኦፍ ዱረ ቡሰኒ ኦፍረ ገረ ገለኒ ቀጄለን።<verse eid="JDG 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JDG 18:22"/>ዬሮ እሳን መነ ሚካራ ጥኖ ፈጋተኒ ዴመንትስ፣ ነሞትን ኦላ መነ ሚካ ወል ዋመኒ ነሞተ ዳን ዱካ ቡአኒ ቀቀበን። <verse eid="JDG 18:22"/><verse number="23" style="v" sid="JDG 18:23"/>እሳን እት እይናን ወር ዳን ኦፍረ ገረ ገለኒ ሚካዻን፣ “አት ማል በርባዴ ነሞተኬ ዋመቴ ኑ ሎሉፍ ዹፍቴ?” ጄዸን።<verse eid="JDG 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JDG 18:24"/>እንስ ዴብሴ፣ “እስን ዋቆተ አን ቶልፈዼፊ ሉበኮ ፉዸተኒርቱ። ወን ና ሀፌ ማልቱ ጅረ? ዮስ እስን አከምት፣ ‘ማል ታቴ?’ ናን ጄቱሬ?”<verse eid="JDG 18:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JDG 18:25"/>ነሞትን ዳንስ፣ “አፋንኬ ኑት ህንበንን፤ ዮ ከና አቺ ነሞትን ኦብሰ ህንቀብኔ ቶኮ ቶኮ ስ ዸኡ፤ አቲፊ ማቲንኬስ ሉቡኬሰን ዸብዱ” ጄዸኒን። <verse eid="JDG 18:25"/><verse number="26" style="v" sid="JDG 18:26"/>ኤርገሲ ነሞትን ዳን ከራሳኒ እት ፉፈን፤ ሚካን አከ እሳን ሁምነሳቲ ኦል ተአን ሁበቴ ኦፍረ ገረገሌ ገረ መነ ኦፊሳት ቀጄሌ።<verse eid="JDG 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JDG 18:27"/>እሳን ዋን ሚካን ቶልፈቴፊ ሉበሳ ፉዸተኒ ላይሽት ቀጄለኒ ሰበ ያዶ ቶኮ መሌ ነጋን ጅራቱት ዱለን። ጎራዴዻን እሳን ፍጠኒ መጋላሳኒስ ጉበን። <verse eid="JDG 18:27"/><verse number="28" style="v" sid="JDG 18:28"/>ሰበቢ እሳን ሲዶንራ ፈጋተኒ ጅራተኒፊ ኤኙመ ወጅን ወልት ዹፌኘ ህንቀብኔፍ ከን እሳን በራሩ ቶኮዩ ህንጅሩ ቱሬ። መጋላን ሱን ሱሉለ ኬሰ ቤት ሬሆቦት ብረት አርገምት ቱርቴ።</para>
  <para style="p" vid="JDG 18:28">ነሞትን ዳን መጋላ ሰነ ዴብሰኒ እጃሩዻን አች ጅራተን። <verse eid="JDG 18:28"/><verse number="29" style="v" sid="JDG 18:29"/>መጋላን ሱን ዱራን ላይሽ ጄዸምት ቱርቴ፤ እሳን ገሩ ዳን ጄዸኒ መቃ አባሳኒ ዳን ነምቸ እስራኤሊፍ ዸለቴ ሰናቲን ሞጋሰን። <verse eid="JDG 18:29"/><verse number="30" style="v" sid="JDG 18:30"/>አችትስ ነሞትን ዳን ኦፊሳኒቲፍ ዋቆተ ቶልፈሞ ዻበተን፤ ዮናታን እልም ጌርሾም፣ እልም ሙሴ ሱኒፊ እልማንሳ ሀመ ብየቲን ቦጅአምቴት ሉቦተ ጎሰ ዳን ቱረን። <verse eid="JDG 18:30"/><verse number="31" style="v" sid="JDG 18:31"/>ከናፉ እሳን እቱመ ፉፈኒ በረ መን ዋቃ ሺሎ ቱሬ ጉቱ ዋቆተ ሚካን ቶልፈቴት ፈየደማ ቱረን።<verse eid="JDG 18:31"/></para>
  <chapter eid="JDG 18"/>
  <chapter number="19" style="c" sid="JDG 19"/>
  <para style="s1">ነምቸ ሌዊ ቶኮፊ ሳጀቶ</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 19:1"/>ዬሮ ሰነት እስራኤል ሞቲ ህንቀብዱ ቱሬ።</para>
  <para style="p" vid="JDG 19:1">ሌውች ለፈ ገሞጂ ብየ ጋራ ኤፍሬም ኬሰ ጅራቱ ቶኮ ቤትልሄም ይሁዳ ኬሳ ዱበርቲ ቶኮ ሳጀቶ ጎዸቴ ፉዸቴ። <verse eid="JDG 19:1"/><verse number="2" style="v" sid="JDG 19:2"/>እሼን ገሩ እሳፍ አመነምቱ ህንታኔ። እሰ ዺፍቴስ ገረ መነ አባሼ ቤትልሄም ይሁዳት ዴብቴ። ኤርገ ጅአ አፉር አች ቱርቴ ቦዴ፣ <verse eid="JDG 19:2"/><verse number="3" style="v" sid="JDG 19:3"/>ዽርስሼ አራርፈቴ ዴብሴ ገልፈቹዻፍ ገረሼ ዸቄ። እንስ ሆጄታሳቲፊ ሀሮተ ለመ ፉዸቴ ዴሜ። እሼንስ መነ አባሼት ኦል እሰ ገልችቴ፤ አባንሼስ ዮሙ እሰ አርጌት ገመቹዻን እሰ ስመቴ። <verse eid="JDG 19:3"/><verse number="4" style="v" sid="JDG 19:4"/>አባን ኒቲሳ ጄቹንስ፣ አባን እንተለቲ አከ እን አች ቱሩፍ ጀቤሴ እሰ ከዸቴ፤ ከናፉ እሳን ኛቻ፣ ዹጋስ ቡልቲ ሰዲ እሰ ብረ ቡቡለን።<verse eid="JDG 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JDG 19:5"/>ጉያ አፉረፋት ገነማን ከአኒ ዴሙፍ ቆጳአን፤ አባን እንተለቲ ገሩ ዽርሰ እንተለሳቲን፣ “አከ ጀባቱፍ ዋ ኛዹ፤ ኤርገሲ ንዴምታ” ጄዼ። <verse eid="JDG 19:5"/><verse number="6" style="v" sid="JDG 19:6"/>ከናፉ ለቸንሳኒ ወጅን ኛተኒ ዹጉፍ ተታአን። ኤርገሲስ አባን እንተለቲ፣ “ማሎ ሀርአ አሱመ ቡሊቲ ኣረ ገልፈዹ” ጄዼን። <verse eid="JDG 19:6"/><verse number="7" style="v" sid="JDG 19:7"/>ዮሙ እን ዴሙፍ ከኤትስ አባን ኒቲሳ ጀቤሴ እሰ ከዸቴ፤ ከናፉ እን ሀልከን ሰነ አች ቡሌ። <verse eid="JDG 19:7"/><verse number="8" style="v" sid="JDG 19:8"/>ጉያ ሸነፋት ዮሙ እን ገነማን ዴሙፍ ከኤት አባን እንተለቲ፣ “ኣረ ገልፈዹ። ሀመ ዋሬ ቦዴትስ አሱመ ቱር!” እሳን ጄዼ። ከናፉ ለቸንሳኒዩ ወጅን ኛተን።<verse eid="JDG 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JDG 19:9"/>ዬሮ ነምች ሳጀቶሳቲፊ ተጃጅላሳ ወጅን ዴሙፍ ከኤት አባን እንተለቲ፣ “እላል! አዱን ዽኡት ጅርት። አሱመ ቡላ፤ ጉያን ገልገላኤረ። አሱመ ቡላቲ ኣረ ገልፈዻ። ቦር ገነማን ካተኒ ከራኬሰን ዴሙ ደንዴሱ” ጄዼን። <verse eid="JDG 19:9"/><verse number="10" style="v" sid="JDG 19:10"/>ነምች ገሩ ጋፈ ሰነ አች ቡሉ ድዴ ሀሮተሳ ለማን ፌአቴ ሳጀቶሳ ፉዸቴ ቀጄሌ። ገረ ፉሌ ዬሩሳሌም እሼ ዬቡስ ጄዸምቱ ሰና ዹፌ።<verse eid="JDG 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JDG 19:11"/>ዮሙ እሳን ዬቡስ ብረ ገአንት ሰበቢ አዱን ዺቴፍ ተጃጅላን ሱን ጎፍታሳቲን፣ “ማሎ ኮታ መጋላ ዬቡሶታ ከነት ጎሬ ሃቡሉ” ጄዼ።<verse eid="JDG 19:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JDG 19:12"/>ጎፍታንሳስ ዴብሴ፣ “ለኪ። ኑ መጋላ ነሞተ ኦርማ ወረ እስራኤሎተ ህንተእኒ ህንሴኑ። ገረ ግቤኣት ደበረ” እሳን ጄዼ። <verse eid="JDG 19:12"/><verse number="13" style="v" sid="JDG 19:13"/>እት ፉፌስ፣ “ኮቱ ግቤኣ ዮካን ራማ ጌኜ ቶኮሳኒ ኬሰ ቡላ” ጄዼን። <verse eid="JDG 19:13"/><verse number="14" style="v" sid="JDG 19:14"/>ከናፉ ዴምሰሳኒ እት ፉፈኒ ዬሮ እሳን ግቤኣ እሼ ቤንያም ኬሰት አርገምቱት ዽኣተንት አዱን ዺቴ። <verse eid="JDG 19:14"/><verse number="15" style="v" sid="JDG 19:15"/>እሳንስ አች ቡሉፍ እት ጎረን። ኦብዲ መጋላ ኬሰስ ቁበተን፤ ገሩ ነምን ቶኮዩ እሳን ቡልቹፍ መነሳት ኦል እሳን ህንገልችኔ።<verse eid="JDG 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JDG 19:16"/>ገልገሉመ ሰነ ጃርስ ብየ ጋራ ኤፍሬሚቲ ዹፌ ግቤኣ ጅራቱ ቶኮ ሆጂ ቆናቲ ገሌ። ነሞትን ብየቲ ገሩ ጎሰ ቤንያም ቱረን። <verse eid="JDG 19:16"/><verse number="17" style="v" sid="JDG 19:17"/>ጃርስ ሱን ዮሙ ኦል ጄዼ ኦብዲ መጋላ ኬሰት ከረ ዴማ ሰነ አርጌት፣ “አት ገረም ዴምተ? ኤሳ ዹፍቴ?” ጄዼ ጋፈቴ።<verse eid="JDG 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JDG 19:18"/>ሌውችስ አከነ ጄዼ፤ “ኑ ቤትልሄም ይሁዳቲ ዹፍኔ ገረ ለፈ ሞጋ ብየ ጋራ ኤፍሬም እዶ አን ጅራዹ ዸቁፍ ዴምነ። አን አች ዸቄ ቱሬ። አን አመ ገረ መነ <char style="nd">ዋቀዮ</char> ዸቃን ጅረ። ነምን መነሳት ነ ስመቴ ቶኮዩ ህንጅሩ። <verse eid="JDG 19:18"/><verse number="19" style="v" sid="JDG 19:19"/>ኑ ተጃጅልቶትንኬ ሀሮተኬኛፍ ጭዲፊ ኦካ ቀብነ፤ አናፊ ተጃጅልቱኬቲፍ፣ ደርገጌሰ ኑ ወጅን ጅሩፍስ ቡዴናፊ ዳዺ ወይኒ ቀብነ። ኑ ዋን ቶኮሌ ህንበርባድኑ።”<verse eid="JDG 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JDG 19:20"/>ጃርስችስ፣ “ነጋን ሲፍ ሃተኡ፤ አን ዋን እስን በርባችሱ ሁንዱማ እስኒፍ ነንዽኤሰ፤ እስን ገሩ ኦብዲ ኬሰ ህንቡልና” ጄዼን። <verse eid="JDG 19:20"/><verse number="21" style="v" sid="JDG 19:21"/>ከናፉ እን ገረ መነሳት ኦል እሰ ገልቼ ሀሮተሳቲፍ ዋን ኛተን ኬኔ። እሳንስ ኤርገ ሚለሳኒ ዽቀተኒ ቦዴ ኛተኒ ዹገን።<verse eid="JDG 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JDG 19:22"/>ኡቱ እሳን ገመዳ ጅረኑ ከሽለቦትን መጋላ ሰና ቶኮ ቶኮ መነ ጃርስቻ መርሰን። በልበለስ ዸዸአኒ እዩዻን፣ “አከ ኑ እሰት ሰጋገሉፍ ነምቸ መነኬ ሴኔ ሰነ ገድ ኑ ባስ” ጄዸኒን።<verse eid="JDG 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JDG 19:23"/>አባን መንቻስ ገድ በኤ አከነ እሳኒን ጄዼ፤ “ለክሳ ያ ፍሮተኮ፣ ሀምነ አከሲ ህንሆጄትና፤ ነምች ኩን ዋን ኬሱማኮ ተኤፍ ዋን ጅብሲሳ ከነ ህንሆጄትና። <verse eid="JDG 19:23"/><verse number="24" style="v" sid="JDG 19:24"/>ኩኖ እንተልኮ ዱርብ ቁልቁሉኒፊ ሳጀቶን ነምቻ አስ ጅሩ። አን እሳን ገድ እስኒ ባሳቲ ዋን ፌተን እሳን ጎዻ። ነምቸ ከነት ገሩ ዋን ጅብሲሳ አከሲ ህንሆጄትና።”<verse eid="JDG 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JDG 19:25"/>ተኡስ እሳን እሰ ህንዸጌኜ። ከናፉ ሌውች ሳጀቶሳ ገድ እሳኒ ባሴ፤ እሳንስ ሀልከን ጉቱ እሼት ተጰተኒ ገነመ በሪ ገድ እሼ ዺሰን። <verse eid="JDG 19:25"/><verse number="26" style="v" sid="JDG 19:26"/>አኩመ ለፍት በሪቴንስ ዱበርቲን ሱን ገረ መነ ጎፍታንሼ ቱሬ ሰና ዸቅጤ በልበለ ዱረት ኩፍቴ ሀመ ቢፍቱን ባቱት አቹመት ድሪርቴ ሀፍቴ።<verse eid="JDG 19:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JDG 19:27"/>ዮሙ ጎፍታንሼ ገነመ በሪ ከኤ ዴሙፍ በልበለ በኔ ገድ በኤት፣ ኩኖ ሳጀቶንሳ ኩፍቴ ሀርከሼ ጉለንታ በልበላረት ድሪርስቴ አርጌ። <verse eid="JDG 19:27"/><verse number="28" style="v" sid="JDG 19:28"/>እንስ፣ “ከእ ንዴምና” እሼን ጄዼ። ገሩ ዴቢን ቶኮሌ ህንቱሬ። ከነረት ነምች ሱን ሀሬረ እሼ ካኤ ገረ መነሳት ቀጄሌ።<verse eid="JDG 19:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JDG 19:29"/>እንስ ዮሙ መነሳ ገኤት ሃዱ ፉዸቴ ሳጀቶሳ ሰነ ቡሳ ቡሳት እዶ ኩዸ ለመት ኩኩቴ ጉቱማ ብየ እስራኤልት ኤርጌ። <verse eid="JDG 19:29"/><verse number="30" style="v" sid="JDG 19:30"/>ነምን ዋን ከነ አርጌ ሁንድ፣ “ኤርገ እስራኤሎን ግብጢ በአኒ ጀልቀቤ ወን አከሲ ተኩማ አርገሜ ዮካን ሆጄተሜ ህንቤኩ። ዋኤሳ ያዳ! ሁበዻስ! ዋን ጎቹ ቀብኑስ ኑት ህማ!” ጄዼ።<verse eid="JDG 19:30"/></para>
  <chapter eid="JDG 19"/>
  <chapter number="20" style="c" sid="JDG 20"/>
  <para style="s1">እስራኤሎትን ቤንያሞተ ሎለን</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 20:1"/>እስራኤሎን ዳኒ ሀመ ቤርሼባት አርገመን አከሱመስ ከኔን ብየ ግልኣድ ኬሰ ጅራተን ሁንድ አከ ነመ ቶኮት በአኒ እዶ ሚስጳ ጄዸሙት ፉለ <char style="nd">ዋቀዮ</char> ዱረት ወልት ቀበመን። <verse eid="JDG 20:1"/><verse number="2" style="v" sid="JDG 20:2"/>ሆገንቶትን ነሞተ ጎሶተ እስራኤል ሁንድ ወል ገኢ ሰበ ዋቃረት አርገመን፤ ሎልቶትን ኩመ ዽበ አፉር ጎራዴ ህዸተኒ ቱረን። <verse eid="JDG 20:2"/><verse number="3" style="v" sid="JDG 20:3"/>ነሞትን ጎሰ ቤንያም አከ እስራኤሎን ገረ ሚስጳት ኦል በአን ዸገአን። ነሞትን እስራኤልስ፣ “ሜ አከ ወን ሀማን ኩን እት ሆጄተሜ ኑት ህማ” ጄዸን።<verse eid="JDG 20:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JDG 20:4"/>ሌውች ዽርስ ዱበርቲ አጄፈምቴ ሰናስ አከነ ጄዼ ዴብሴ፤ “አኒፊ ሳጀቶንኮ አች ቡሉፍ ብየ ቤንያም ግቤኣ ዹፍኔ። <verse eid="JDG 20:4"/><verse number="5" style="v" sid="JDG 20:5"/>ነሞትን ግቤኣስ ነ አጄሱፍ ሀልከን መነ አን ቡሌ ሰነ መርሰን። እሳንስ ሳጀቶኮ ሁምናን ጉዴደን፤ እሼንስ ንዱቴ። <verse eid="JDG 20:5"/><verse number="6" style="v" sid="JDG 20:6"/>አንስ ሬፈ ሳጀቶኮ ፉዼ ገርገር ኩኩቴ ገረ ብዮተ ዻለ ጎሶተ እስራኤል ሁንዳት ኤርጌ፤ እሳን እስራኤል ኬሰት ዋን ጅብሲሳፊ ሰልጵሳ አከሲ ሆጄተኒሩቲ። <verse eid="JDG 20:6"/><verse number="7" style="v" sid="JDG 20:7"/>አመስ እስን እስራኤሎን ሁንድኑ እረት መርአዻቲ ሙርቲኬሰን ኬና።”<verse eid="JDG 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JDG 20:8"/>ነሞትን ሁንድ አኩመ ነመ ቶኮት ከአኒ አከነ ጄዸን፤ “ኑ ኬሳ ነምን ቶኮዩ ገረ መነሳት ህንገሉ። ኑ ኬሳ ነምን ቶኮዩ መነሳት ህንዴብኡ። <verse eid="JDG 20:8"/><verse number="9" style="v" sid="JDG 20:9"/>ወን ኑ ግቤኣ ጎኑ ገሩ ከነ፦ አኩመ እጣን ኑ በኤት እት ዱሉዸ። <verse eid="JDG 20:9"/><verse number="10" style="v" sid="JDG 20:10"/>አከ እሳን ወረ ዱለኒፍ ዋን እሳን ኛተን ፍደኒፍ፣ ጎሶተ እስራኤል ሁንደ ኬሳ ነመ ዽበ ቶኮ ኬሳ ነመ ኩዸን፣ ነመ ኩመ ቶኮ ኬሳ ነመ ዽበ ቶኮ፣ ነመ ኩመ ኩዸን ኬሳ ነመ ኩመ ቶኮ ንፉዸትነ። ዱል ኩንስ ዬሮ ግቤኣ እሼ ቤንያም ኬሰ ጅርቱ ሰነ ቀቀቡት ዋን እሳን እስራኤልረት ሆጄተን ሰናፍ አደቢ በርባችሳ ንኬነ።” <verse eid="JDG 20:10"/><verse number="11" style="v" sid="JDG 20:11"/>ከናፉ ነሞትን እስራኤል ሁንድ ወልት ቀበመኒ አኩመ ነመ ቶኮት መጋለቲት ዱለን።<verse eid="JDG 20:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JDG 20:12"/>ጎሶትን እስራኤል ገረ ጎሰ ቤንያም ሁንዳት አከነ ጄዸኒ ነመ ኤርገን፤ “የክ ሀማን ግዱኬሰንት ሆጄተሜ ኩን ማል? <verse eid="JDG 20:12"/><verse number="13" style="v" sid="JDG 20:13"/>አመስ አከ ኑ እሳን በርበዴስኔ እስራኤል ኬሳ ሀምነ በሌስኑፍ ነሞተ ግቤኣ ሀሞ ሰነ ደበርሳ ኑት ኬና።”</para>
  <para style="p" vid="JDG 20:13">ቤንያሞን ገሩ እስራኤሎተ ፍሮተሳኒ ዸገኡ ድደን። <verse eid="JDG 20:13"/><verse number="14" style="v" sid="JDG 20:14"/>እሳንስ እስራኤሎተ ወራኑዻፍ መጋላወንሳኒቲ ቶኩማዻን ገረ ግቤኣ ዹፈን። <verse eid="JDG 20:14"/><verse number="15" style="v" sid="JDG 20:15"/>ቤንያሞን ዬሩመ ቶኮት ሎልቶተ ፍለተሞ ግቤኣ ኬሰ ጅራተን ዽበ ቶርበረት ነሞተ ጎራዴ ህዸተን ኩመ ድግደሚ ጀአ መጋላወንሳኒቲ ህሪርሰን። <verse eid="JDG 20:15"/><verse number="16" style="v" sid="JDG 20:16"/>ሎልቶተ ፍለተሞ ከኔን ሁንደ ኬሳ ዽበ ቶርበ ብታቾተ ቶኮን ቶኮንሳኒ ርፌንሰት ዸጋ ፉርሰኒ ህንዸብኔ ቱረን።<verse eid="JDG 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JDG 20:17"/>እስራኤሎን ቤንያሞተ መሌዩ ነሞተ ጎራዴ ህዸተን ኩመ ዽበ አፉር ቀቡ ቱረን፤ ኩኔን ሁንድኑ ጎቶተ ቱረን።<verse eid="JDG 20:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JDG 20:18"/>እስራኤሎን ቤትኤልት ኦል በአኒ፣ “ቤንያሞተ ወራኑዻፍ ኑ ኬሳ ጀልቀበት ኤኙ ሃበኡ?” ጄዸኒ ዋቀ ጋፈተን።</para>
  <para style="p" vid="JDG 20:18">
    <char style="nd">ዋቀዮስ</char>፣ “ይሁዳን ጀልቀበት ሃበኡ” ጄዼ ዴብሴ።<verse eid="JDG 20:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JDG 20:19"/>እጆሌን እስራኤልስ ገነማን ከአኒ ግቤኣ መርሰን። <verse eid="JDG 20:19"/><verse number="20" style="v" sid="JDG 20:20"/>ነሞትን እስራኤል ቤንያሞተ ወራኑፍ በአኒ ግቤኣት እዶ እዶሳኒ ቀበተን። <verse eid="JDG 20:20"/><verse number="21" style="v" sid="JDG 20:21"/>ቤንያሞንስ ግቤኣዻ በአኒ ጋፉመ ሰነ ድሬ ወራናረት እስራኤሎተ ኩመ ድግደሚ ለመ ፍጠን። <verse eid="JDG 20:21"/><verse number="22" style="v" sid="JDG 20:22"/>ነሞትን እስራኤል ገሩ ወል ጀጀቤሰኒ እዶዹመ ጋፈ ዱራ እት ህሪረን ሰነት እዶ እዶሳኒ ቀበተን። <verse eid="JDG 20:22"/><verse number="23" style="v" sid="JDG 20:23"/>እስራኤሎን ኦል በአኒ ሀመ ገልገላት ፉለ <char style="nd">ዋቀዮ</char> ዱረት ቦአን። እሳንስ፣ “ኑ ኦቦሎተኬኘ ቤንያሞተ ወራኑፍ አመሌ ኦል ባኑ?” ጄዸኒ <char style="nd">ዋቀዮን</char> ጋፈተን።</para>
  <para style="p" vid="JDG 20:23">
    <char style="nd">ዋቀዮስ</char>፣ “እት ኦል በኣ” ጄዼ ዴብሴ።<verse eid="JDG 20:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JDG 20:24"/>እስራኤሎን ጉያ ለመፋት ገረ ቤንያሞታት ዽኣተን። <verse eid="JDG 20:24"/><verse number="25" style="v" sid="JDG 20:25"/>ዬሮ ከነት፣ ቤንያሞን ግቤኣዻ እት በአኒ እስራኤሎተ ጎራዴ ህዸተን ኩመ ኩዸ ሰዴት ገላፈተን።<verse eid="JDG 20:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JDG 20:26"/>ኤርገሲ እጆሌን እስራኤል፣ ሰብን ሁንድኑ ቤትኤልት ኦል በአኒ አችት ቦኣ ፉለ <char style="nd">ዋቀዮ</char> ዱረ ተታአን። ሀመ ገልገላትስ ሶመኒ ኣርሳ ጉበሙፊ ኣርሳ ነጋ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዽኤሰን። <verse eid="JDG 20:26"/><verse number="27" style="v" sid="JDG 20:27"/>እስራኤሎንስ ጎርሰ <char style="nd">ዋቀዮ</char> ጋፈተን። በረ ሰነ ታቦትን ከኩ ዋቃ አቹመ ቱሬ፤ <verse eid="JDG 20:27"/><verse number="28" style="v" sid="JDG 20:28"/>ፊኔሃስ እልም ኤሌኣዛር፣ እልም አሮን ፉለሳ ዱረ ተጃጅላ ቱሬ። እሳንስ፣ “ኑ አመሌ ኦቦሎተኬኘ ቤንያሞተ ወራኑፍ ሃባኑሞ ሃዺፍኑ?” ጄዸኒ ጋፈተን።</para>
  <para style="p" vid="JDG 20:28">
    <char style="nd">ዋቀዮስ</char>፣ “በኣ፤ አን ቦር እሳን ደበርሴ ሀርከኬሰንት ኬናቲ” ጄዼን።<verse eid="JDG 20:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JDG 20:29"/>ከናፉ እስራኤሎን ናኖ ግቤኣት ርጰን። <verse eid="JDG 20:29"/><verse number="30" style="v" sid="JDG 20:30"/>እሳንስ ጉያ ሰደፋት ቤንያሞተት ዱለኒ አኩመ ዱራን ጎዸን ሰነ ግቤኣ ወራኑዻፍ እዶ እዶሳኒ ቀበተን። <verse eid="JDG 20:30"/><verse number="31" style="v" sid="JDG 20:31"/>ቤንያሞንስ እሳን ወራኑፍ በአኒ መጋላ ሰነራ ፈጋተን። አኩመ ከናን ዱራስ እስራኤሎተ ዸኡ ጀልቀበን፤ ዳንዲወን ቤትኤሊቲፊ ግቤኣረትስ ነሞተ እስራኤል ገረ ሶዶመ አጄሰን። <verse eid="JDG 20:31"/><verse number="32" style="v" sid="JDG 20:32"/>ቤንያሞንስ፣ “ኩኖ ኑ አኩመ ከናን ዱራ እሳን ሞአቻ ጅረ” ጄዸን፤ እስራኤሎትንሞ፣ “ኮታ ኑ ገረ ዱግደ ዱባት ዴብኔ አከ እሳን መጋላ ኬሳ በአን ጎና” ጄዸን።<verse eid="JDG 20:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JDG 20:33"/>ነሞትን እስራኤል ሁንድኑ እዶ ቱረኒ ከአኒ በኣል ታማርት እዶ እዶሳኒ ቀበተን፤ ወራን እስራኤል ከን ርጴ ኤጋ ቱሬስ ከራ ልጠ ግቤኣቲን እት በኤ። <verse eid="JDG 20:33"/><verse number="34" style="v" sid="JDG 20:34"/>ሰነ ቦዴስ ነሞትን እስራኤል ፍለተሞን ኩመ ኩዸን ግቤኣረት ወራነ በነን። ወራን ሱንስ አከ መሌ ጭማ ቱሬ፤ ቤንያሞን ገሩ አከ በዲን እሳንት ዽኣቴ ጅሩ ህንቤክኔ ቱሬ። <verse eid="JDG 20:34"/><verse number="35" style="v" sid="JDG 20:35"/><char style="nd">ዋቀዮ</char> ፉለ እስራኤሎታ ዱረት ቤንያሞተ ዸኤ፤ እስራኤሎን ጋፈስ ቤንያሞተ 25,100 ከኔን ሁንድሳኒ ጎራዴ ህዸተን ፍጠን። <verse eid="JDG 20:35"/><verse number="36" style="v" sid="JDG 20:36"/>ከናፉ ቤንያሞን አከ ሞአተመን ሁበተን።</para>
  <para style="p" vid="JDG 20:36">ዬሮ ከነት እስራኤሎን ወራነሳኒ ከን ናኖ ግቤኣት ርጴ ጅሩ ሰነ አብደተኒ ዋን ሞአተመን ፈኬሰኒ ቤንያሞታፍ እዶ ገድ ዺሰን። <verse eid="JDG 20:36"/><verse number="37" style="v" sid="JDG 20:37"/>ወራን እስራኤል ርጴ ቱሬ ሱንስ ዬሩመ ቶኮን ጨብሴ ግቤኣ ሴኔ መጋለቲ ጎራዴዻን ዸኤ። <verse eid="JDG 20:37"/><verse number="38" style="v" sid="JDG 20:38"/>ነሞትን እስራኤልስ አከ ወራን ርጴ ቱሬ ሱን መጋላ ኬሳ መለቶ ዱሜሰ ኣራ ጉዳሳ አርግሲሱ ወሊ ገለኒ ቱረን፤ <verse eid="JDG 20:38"/><verse number="39" style="v" sid="JDG 20:39"/>አከሲንስ ነሞትን እስራኤል ገረ ሎላት ደቸአን።</para>
  <para style="p" vid="JDG 20:39">ቤንያሞን ወራነ ጀልቀበኒ እስራኤሎተ ሶዶመ አጄሰን፤ ከናፉ፣ “ኑ አኩመ ዬሮ ጀልቀባ ሰነ እሳን ሞአቻ ጅረ” ጄዸን። <verse eid="JDG 20:39"/><verse number="40" style="v" sid="JDG 20:40"/>ገሩ ዮሙ መጋለቲ ኬሳ ኣር ኦል በኡ ጀልቀቤት ቤንያሞን ኦፍረ ገረ ገለኒ ኣረ ጉቱማ መጋለቲ ኬሳ ሰሚት ኦል በኣ ጅሩ አርገን። <verse eid="JDG 20:40"/><verse number="41" style="v" sid="JDG 20:41"/>ከነረት ነሞትን እስራኤል ቤንያሞተት ገረገለን፤ ቤንያሞን አከ በላን እሳንት ዹፌ ቤከኒ አከ መሌ ሶዳተኒቲ። <verse eid="JDG 20:41"/><verse number="42" style="v" sid="JDG 20:42"/>ከናፉ እሳን ገረ ገሞጂት ፉለ ዴፈተኒ እስራኤሎተ ዱራ በቀተን። ገሩ ጀላ በኡ ህንደንዴኜ። ነሞትን እስራኤል ከኔን መጋላ ሰና በአኒ ዹፈን አችት እሳን ፍጠን። <verse eid="JDG 20:42"/><verse number="43" style="v" sid="JDG 20:43"/>እሳንስ ጀረ መርሰኒ አርኡዻን ፉሌ በአ ግቤኣት እሳን ሞአተን። <verse eid="JDG 20:43"/><verse number="44" style="v" sid="JDG 20:44"/>ሎልቶትን ቤንያም ጀጀቦን ኩመ ኩዸ ሰዴት ንገላፈተመን። <verse eid="JDG 20:44"/><verse number="45" style="v" sid="JDG 20:45"/>ኡቱ እሳን ገረ ገለኒ ገረ ገሞጂ ከታ ርሞንት በቀቻ ጅረኑ ነሞትን ኩመ ሸን ከራረት ጀላ ዹመን። እስራኤሎን አመስ ሀመ ግዶምት ወረ ሀፈን ዱካ ቡአኒ ነመ ኩመ ለመ አጄሰን።<verse eid="JDG 20:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="JDG 20:46"/>ጋፈስ ቤንያሞተ ጎራዴ ህዸተን ኩመ ድግደሚ ሸንቱ አጄፈሜ፤ ሁንድሳኒስ ሎልቶተ ቤቤከሞ ቱረን። <verse eid="JDG 20:46"/><verse number="47" style="v" sid="JDG 20:47"/>ነሞትን ዽበ ጀአ ገሩ ገረ ገለኒ ገረ ገሞጂት ከታ ርሞንት በቀተን፤ ጅአ አፉርስ አች ቱረን። <verse eid="JDG 20:47"/><verse number="48" style="v" sid="JDG 20:48"/>ነሞትን እስራኤልሞ ገረ ቤንያሞታት ደቸአኒ ጉቱማ መጋላ ሰና፣ ሆሪፊ ዋን አችት አርገን ሁንደ ጎራዴን ፍጠን። መጋላ እት ዹፈን ሁንደስ እብዳን ጉበን።<verse eid="JDG 20:48"/></para>
  <chapter eid="JDG 20"/>
  <chapter number="21" style="c" sid="JDG 21"/>
  <para style="s1">ቤንያሞታፍ ኒቶትን አርገመን</para>
  <para style="p">
    <verse number="1" style="v" sid="JDG 21:1"/>እስራኤሎን፣ “ኑ ኬሳ ነምን ቶኮሌ ቤንያሞተት እንተለሳ ሄሩምሲሱ ህንቀቡ” ጄዸኒ ሚስጳት ወል ከከቺሰኒ ቱረን።<verse eid="JDG 21:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JDG 21:2"/>ሰብንስ ገረ ቤትኤል ዸቀኒ ሀመ ገልገላት ፉለ ዋቃ ዱረ ታኡዻን ሰገሌሳኒ ኦል ፉዸኒ ህቅፈተኒ ቦአን። <verse eid="JDG 21:2"/><verse number="3" style="v" sid="JDG 21:3"/>እሳንስ፣ “ያ <char style="nd">ዋቀዮ</char>፣ ዋቀ እስራኤል፣ ወን ኩን ማሊፍ እስራኤልራ ገኤ? ሀርአ ጎስት ቶኮ ማሊፍ እስራኤል ኬሳ ዸበማ?” ጄዸኒ እየን።<verse eid="JDG 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JDG 21:4"/>ነሞትንስ ጉያ እት ኣኑት ገነማን እዶ ኣርሳ ቶልቸኒ ኣርሳ ጉበሙፊ ኣርሳ ነጋ ዽኤሰን።<verse eid="JDG 21:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JDG 21:5"/>ኤርገሲስ እስራኤሎን፣ “ጎሶተ እስራኤል ሁንዱማ ኬሳ ጎስት ፉለ <char style="nd">ዋቀዮ</char> ዱረት ወል ገኢረት ህንአርገምን ከም?” ጄዸኒ ጋፈተን። ነምን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ወል ገኢረት ህንአርገምን ሃአጄፈሙ ጄዸኒ ሚስጳት ወሊ ከከተኒ ቱረኒቲ።<verse eid="JDG 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JDG 21:6"/>እስራኤሎን ገሩ ኦቦሎተሳኒ ቤንያሞታፍ ገራ ላፈኒ አከነ ጄዸን፤ “ሀርአ ጎስት ቶኮ እስራኤልራ ጭቴረ። <verse eid="JDG 21:6"/><verse number="7" style="v" sid="JDG 21:7"/>ኤጋ ወረ ሀፈኒፍ አከምት ኒቶተ አርገቹ ደንዴኘ? ኑ አከ እንተለንኬኘ እሳንት ህንሄሩምሲፍኔ <char style="nd">ዋቀዮን</char> ከከኔራቲ።” <verse eid="JDG 21:7"/><verse number="8" style="v" sid="JDG 21:8"/>ኤርገሲስ፣ “ጎስት ሚስጳት ፉለ <char style="nd">ዋቀዮ</char> ዱረት ወል ገኢረት ህንአርገምን ከም?” ጄዸን። እሳንስ አከ ነምን ቶኮዩ ያቤሽ ግልኣዲ ገረ ቁበታ ወል ገኢዻፍ ህንዹፍን ቤከን። <verse eid="JDG 21:8"/><verse number="9" style="v" sid="JDG 21:9"/>ዬሮ ነሞተ ለካአንትስ አከ ነምን ያቤሽ ግልኣድ ቶኮዩ አች ህንጅሬ ሁበተን።<verse eid="JDG 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JDG 21:10"/>ከናፉ ወልዳን ሱን ሎልቶተ ኩመ ኩዸ ለመ ገረ ያቤሽ ግልኣድ ኤርጌ አከ እሳን ወረ አች ጅራተን፣ ዱበርቶታፊ ዳእመን ደበለኒ ጎራዴዻን ፍጠን አጀጄ። <verse eid="JDG 21:10"/><verse number="11" style="v" sid="JDG 21:11"/>እሳንስ፣ “ወን እስን ጎቹ ቀብደን ከናዸ፤ ዺረ ሁንዳፊ ዱበርቶተ ዱርቡማ ህንቀብኔ ሁንደ አጄሳ” ጄዸን። <verse eid="JDG 21:11"/><verse number="12" style="v" sid="JDG 21:12"/>እሳንስ ነሞተ ያቤሽ ግልኣድ ኬሰ ጅራተን ኬሳ ዱበረን ተኩማ ዺር ብረ ህንገእን ዽበ አፉር አርገተን፤ ገረ ብየ ከነኣን ከን ቁበተ ሺሎት አርገሙ ሰናትስ እሳን ፍደን።<verse eid="JDG 21:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JDG 21:13"/>ኤርገሲስ ወልዳን ጉቱን ቤንያሞተ ከታ ርሞን ብረ ጅራተንት ዋምቸ ነጋ ኤርገን። <verse eid="JDG 21:13"/><verse number="14" style="v" sid="JDG 21:14"/>ቤንያሞንስ ዬሮ ሰነት ንደቸአን፤ ዱበርቶትን ያቤሽ ግልኣድ ከኔን ዱአ ጀላ በራረመን አከ ኒቶተ እሳኒፍ ተአኒፍ ኬነመኒፍ፤ ገሩ ሁንደሳኒ ወል ህንጌኜ።<verse eid="JDG 21:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JDG 21:15"/>ነሞትንስ ሰበቢ <char style="nd">ዋቀዮ</char> ጎሶተ እስራኤል ግዱት ገርገር በኡምሰ ኡሜፍ ቤንያሚፍ ገደን። <verse eid="JDG 21:15"/><verse number="16" style="v" sid="JDG 21:16"/>ማንጉዶትን ወልዳስ አከነ ጄዸን፤ “ዱበርቶትን ቤንያም ዹመኒሩ፤ ኤጋ ዺሮተ ሀፈኒፍ አከምት ኒቶተ አርገቹ ደንዴኘ? <verse eid="JDG 21:16"/><verse number="17" style="v" sid="JDG 21:17"/>አከ ጎስት ቶኮ እስራኤል ኬሳ ህንበድኔፍ ቤንያሞን ሀፈን ዻልቶተ አርገቹ ቀቡ። <verse eid="JDG 21:17"/><verse number="18" style="v" sid="JDG 21:18"/>ኑ እስራኤሎን ሰበቢ፣ ‘ነምን እንተለሳ ቤንያሞተት ሄሩምሲሱ ሃአባረሙ’ ጄኔ ከከኔፍ፣ እንተለንኬኘ ኒቱማዻን እሳኒ ኬኑ ህንደንዴኙ። <verse eid="JDG 21:18"/><verse number="19" style="v" sid="JDG 21:19"/>ኩኖ አያን <char style="nd">ዋቀዮ</char> ቶኮ ወጉመ ወጋን ሺሎት ንአያኔፈመ፤ ሺሎን ኩንስ ቤትኤልራ ገረ ካባት፣ ከራ ቤትኤሊ በኤ ሼኬምት ጌሱራ ገረ በኣት አከሱመስ ሌቦናራ ገረ ክባት አርገምት።”<verse eid="JDG 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JDG 21:20"/>ከናፉ እሳን አከነ ጄዸኒ ቤንያሞተ ጎርሰን፤ “ዸቃ እዶ ዻባ ወይኒ ኬሰ ርጳ ኤገዻ። <verse eid="JDG 21:20"/><verse number="21" style="v" sid="JDG 21:21"/>እላላ፤ ዮሙ ዱበር ሺሎ ስርባፍ በአንት እዶ ዻባ ወይኒ ኬሳ በኣቲ ቶኮ ቶኮኬሰኒፍ ኒቲ ቶኮ ቶኮ ቀባዻቲ ገረ ቤንያምት ዴብኣ። <verse eid="JDG 21:21"/><verse number="22" style="v" sid="JDG 21:22"/>ዮሙ አቦቲንሳኒ ዮካን ኦቦሎትንሳኒ ኑት ህመተንት፣ ‘ሰበቢ ኑ ዬሮ ወራናት ቶኮ ቶኮ እሳኒቲፍ ኒቲ አርጉ ህንደንደእኒፍ እስን እሳን ገርጋሩዻን ዺፈመ ኑ ጎዻ፤ እስንስ ሰበቢ ጃለተኒ ዱበረኬሰን ህንኬንኒፍ በሌሳ ህንቀብደን’ ጄናን።”<verse eid="JDG 21:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JDG 21:23"/>ቤንያሞንስ አኩመ እሳንት ህመሜ ሰነ ጎዸን፤ ኡቱመ ዱበረን ስርባ ጅረኑስ ቶኮን ቶኮን ነማ ቶኮ ቶኮ ቡቴ አከ ኒቲሳ ታቱፍ ፉዸቴ ቀጄሌ። ኤርገሲስ ገረ ዻለሳኒት ዴብአኒ መጋላሳኒ ሃሮምፈተኒ አች ጅራተን።<verse eid="JDG 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JDG 21:24"/>ዬሮ ሰነትስ እጆሌን እስራኤል እዶ ሰና ከአኒ ገረ መነሳኒ፣ ገረ ጎሰሳኒ፣ ገረ ለሚ እሳኒቲፊ ገረ ዻለሳኒት ዴብአን።<verse eid="JDG 21:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JDG 21:25"/>በረ ሰነ እስራኤል ኬሰ ሞቲን ህንጅሩ ቱሬ፤ ቶኮን ቶኮን ነማ ዋኑመ እሰት ቶሌ ሆጄተ ቱሬ።<verse eid="JDG 21:25"/></para>
  <chapter eid="JDG 21"/>
</usx>
