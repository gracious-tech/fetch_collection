<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2JN" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">2 ዮሀንስ</para>
  <para style="toc1">ዮሀንስ ለመፋ</para>
  <para style="toc2">2 ዮሀንስ</para>
  <para style="toc3">2ዮሀ</para>
  <para style="mt1">ዮሀንስ</para>
  <para style="mt2">ለመፋ</para>
  <chapter number="1" style="c" sid="2JN 1"/>
  <para style="s1">ነጋ ጋፈቹ</para>
  <para style="po">
    <verse number="1" style="v" sid="2JN 1:1"/>ጃርስቸራ።</para>
  <para style="po" vid="2JN 1:1">ገረ ጊፍቲ ፍለተምቱፊ እጆሌሼ፣ ወረ አን ዹጋዻን ጃለዹ፣ ወረ አነ ቆፈ ኡቱ ህንተእን ወር ዹጋ ቤከን ሁንድ አከሱመ ጃለተኒት፤ <verse eid="2JN 1:1"/><verse number="2" style="v" sid="2JN 1:2"/>ኩንስ ሰበቢ ዹጋ ኑ ኬሰ ጅራቱፊ እሰ በረ በራን ኑ ወጅን ጅራቱ ሰናቲፍ።<verse eid="2JN 1:2"/></para>
  <para style="po">
    <verse number="3" style="v" sid="2JN 1:3"/>አያን፣ አራሪፊ ነጋን ዋቀ አባ ብራ፣ ዬሱስ ክርስቶስ እልመ አባ ብራስ፣ ዹጋፊ ጃለላን ኑ ወጅን ንተአ።<verse eid="2JN 1:3"/></para>
  <para style="b"/>
  <para style="s1">ገለተ ገልቹ</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4"/>አን ዋን እጆሌኬ ኬሳ ቶኮ ቶኮ አከ እሳን አኩመ አባን ኑ አጀጄት ዹጋን ጅራተን አርጌፍ ባይኤ ገመዴረ። <verse eid="2JN 1:4"/><verse number="5" style="v" sid="2JN 1:5"/>አመስ ያ ጊፍቲ ጃለተምቱ፣ አን አጀጀ ዱሩማ ጀልቀቤ ኑፍ ኬነሜ ሰነ መሌ አጀጀ ሃራ ሲፍ በሬሱት ህንጅሩ። አከ ወል ጃለትኑፍስ ስን ከዸዸ። <verse eid="2JN 1:5"/><verse number="6" style="v" sid="2JN 1:6"/>ጃለልስ ከነ፦ ኩንስ አጀጀሳ ኤግኔ ጅራቹዸ። አኩመ እስን ዱሩማ ጀልቀብደኒ ዸጌሰን ሰነ አጀጅንሳ አከ እስን ጃለላን ጅራተኒዸ።<verse eid="2JN 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7"/>ጎዎምስቶትን አከ ዬሱስ ክርስቶስ ፎኒን ዹፌ ህንአመኔ ሄዱን አዱኛ ሴነኒሩ። ነምን አከና ከምዩ ጎዎምስቱፊ ፈረ ክርስቶስ። <verse eid="2JN 1:7"/><verse number="8" style="v" sid="2JN 1:8"/>እስን አከ ገቲ ጉቱ አርገተን መሌ አከ ዋን ሆጄተን ሰነ ህንዸብኔፍ ኦፍ ኤገዻ። <verse eid="2JN 1:8"/><verse number="9" style="v" sid="2JN 1:9"/>ነምን በርሲሰ ክርስቶሲን ህንጅራትኔ ከን በርሲሰ ሰነ ኬሳ በኡ ከምዩ ዋቀ ህንቀቡ፤ ነምን በርሲሰ ክርስቶሲን ጅራቱ ሁንድኑሞ አባስ እልመስ ቀበ። <verse eid="2JN 1:9"/><verse number="10" style="v" sid="2JN 1:10"/>እስን ዮ ነምን ከምዩ ገረኬሰን ዹፌ ገሩ በርሲሰ ከነ ህንፍድን፣ መነኬሰንት ኦል እሰ ህንገልችና ዮካን እሰ ህንስመትና። <verse eid="2JN 1:10"/><verse number="11" style="v" sid="2JN 1:11"/>ነምን እሰ ስመቱ ከምዩ ሆጂሳ ሀማ ሰነ ኬሰት ቆደ ቀባታቲ።<verse eid="2JN 1:11"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="s1">ጡሙራፊ ዻምሰ ነጋ</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12"/>አን ዋነን እስኒፍ በሬሱ ባይኤ ቀበ፤ ተኡስ ወረቃፊ ቀለሚት ፈየደሙ ህንበርባዱ። ቆደ ከና አከ ገመቹንኬኘ ጉቱ ተኡፍ አን ገረኬሰን ዹፌ እፋን እፈት ሃሶፍኑ አብዲን ቀበ።<verse eid="2JN 1:12"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13"/>እጆሌን ኦቦሌቲኬ ከን ፍለተምቴ ሰናስ ነጋ ሲፍ ዻሙ።<verse eid="2JN 1:13"/></para>
  <chapter eid="2JN 1"/>
</usx>
