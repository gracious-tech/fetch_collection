<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="SNG" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">ዌዱ</para>
  <para style="toc1">ዌዱ ዌዶታ</para>
  <para style="toc2">ዌዱ</para>
  <para style="toc3">ዌዱ</para>
  <para style="mt1">ዌዱ</para>
  <para style="mt2">ዌዶታ</para>
  <chapter number="1" style="c" sid="SNG 1"/>
  <para style="p">
    <verse number="1" style="v" sid="SNG 1:1"/>ዌዱ ዌዶታ ሶሎሞን።<verse eid="SNG 1:1"/></para>
  <para style="sp">እሼ</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 1:2"/>እን ዹንጎ አፋንሳቲን ነ ሃዹንገቱ፤</para>
  <para style="q2" vid="SNG 1:2">ጃለልኬ ዳዺ ወይኒ ጫላቲ።<verse eid="SNG 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 1:3"/>ኡርጋን ሽቶኬቲ ነመት ቶለ፤</para>
  <para style="q2" vid="SNG 1:3">መቃንኬ አኩመ ሽቶ ዸንገላፈሜት።</para>
  <para style="q2" vid="SNG 1:3">ከናፉ ዱበረን ስ ጃለቱ!<verse eid="SNG 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 1:4"/>ነ ፉዸዹ ዴም፤ ስ ዱካ ፊግና!</para>
  <para style="q2" vid="SNG 1:4">ሞትች ዲንቀሳት ኦል ነ ገልፈቴ።</para>
  <para style="sp" vid="SNG 1:4">ምቾተ</para>
  <para style="q1" vid="SNG 1:4">ኑ ስት ገመድኔ እልልችነ፤</para>
  <para style="q2" vid="SNG 1:4">ጃለለ ኬስ ዳዺ ወይኒ ጫላ ጀጀትነ።</para>
  <para style="sp" vid="SNG 1:4">እሼ</para>
  <para style="q1" vid="SNG 1:4">ስጃለቹንሳኒ አከም ስሪዸ!<verse eid="SNG 1:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 1:5"/>እንተለን ዬሩሳሌም፣</para>
  <para style="q2" vid="SNG 1:5">አን አኩመ ዱንካነ ቄዳር፣</para>
  <para style="q1" vid="SNG 1:5">አኩመ ጎልጋ ዱንካነ ሶሎሞንስ ጉራቲዸ፤</para>
  <para style="q2" vid="SNG 1:5">ገሩ በሬዱዸ።<verse eid="SNG 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 1:6"/>ሰበቢ አን ጉራቲ ተኤፍ፣ እጀ በባፍቴ ነ ህንእላልን፤</para>
  <para style="q2" vid="SNG 1:6">አዱቱ ነ ጉራቼሴቲ።</para>
  <para style="q1" vid="SNG 1:6">እልማን ሃዸኮ ነት ኣረኒ</para>
  <para style="q2" vid="SNG 1:6">አከ አን እዶ ዻባ ወይኒ ኤጉ ነ ታስሰን፤</para>
  <para style="q2" vid="SNG 1:6">አን ገሩ እዶ ዻባ ወይኒኮ ህንኤገትኔ።<verse eid="SNG 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 1:7"/>ያ እሰ አን ስጃለዹ፣</para>
  <para style="q2" vid="SNG 1:7">እዶ ቡሻዬኬ ትክፈቱፊ</para>
  <para style="q2" vid="SNG 1:7">እዶ እት ጉያ ሳፋ ሆሎተኬ ቦቆቺፈቱ ነት ህም።</para>
  <para style="q1" vid="SNG 1:7">አን ማሊፈን አከ ዱበርቲ ፉለሼ ሀጉገቴ</para>
  <para style="q2" vid="SNG 1:7">ቡሻዬ ምቾተኬቲ ብረ አሲፊ አች ጆርቱ ቶኮ ተአ?<verse eid="SNG 1:7"/></para>
  <para style="sp">ምቾተ</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 1:8"/>ያ ዱበርቲ ዱበርቶተ ሁንደ ጫላ በሬዱ፣</para>
  <para style="q2" vid="SNG 1:8">አት ዮ ቤኩ ባቴ ሆሎተ ዱካ ቡእ፤</para>
  <para style="q1" vid="SNG 1:8">እልሞሌ ሬኦተኬቲስ</para>
  <para style="q2" vid="SNG 1:8">ዱንካነ ትክሶታ ብረ ትክፈዹ።<verse eid="SNG 1:8"/></para>
  <para style="sp">እሰ</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 1:9"/>ያ ጃለሌኮ፣ አን አከ ፈርደ ዸላ</para>
  <para style="q2" vid="SNG 1:9">ፈርዴን ጋሪ ፈረኦን ሀርክሰን ኬሳ ቶኮት ስን እላለ።<verse eid="SNG 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 1:10"/>መዲንኬ አመርቲ ጉራቲን፣</para>
  <para style="q2" vid="SNG 1:10">ሞርሚኬስ ድረተ ወርቄቲን ሚዸግፈሜረ።<verse eid="SNG 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 1:11"/>ኑ ወርቄ ጉራ</para>
  <para style="q2" vid="SNG 1:11">ሜቲዻን ወል መኬ ሲፍ ቶልችነ።<verse eid="SNG 1:11"/></para>
  <para style="sp">እሼ</para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 1:12"/>ኡቱመ ሞትች ማዲት ዽኣቴ ጅሩ</para>
  <para style="q2" vid="SNG 1:12">ሽቶንኮ ኡርጋሳ ኬኔ።<verse eid="SNG 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 1:13"/>ምቹንኮ አናፍ ኮሮጆ ቁምቢት፤</para>
  <para style="q2" vid="SNG 1:13">እን ጉንቱተኮ ግዱ ቦቆተ።<verse eid="SNG 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 1:14"/>ምቹንኮ አናፍ ሁርቡ ደራራ ሄና</para>
  <para style="q2" vid="SNG 1:14">ከን እዶ ዻባ ወይኒ ኤን ጋዲቲ ዹፌዸ።<verse eid="SNG 1:14"/></para>
  <para style="sp">እሰ</para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 1:15"/>ያ ጃለሌኮ፣ አት አከም በሬደ!</para>
  <para style="q2" vid="SNG 1:15">ድንቂ አከም በሬደ!</para>
  <para style="q2" vid="SNG 1:15">እጅኬ ጉጌ ፈካተ።<verse eid="SNG 1:15"/></para>
  <para style="sp">እሼ</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 1:16"/>ያ ምቹኮ፣ አት አከም ሚዸግደ!</para>
  <para style="q2" vid="SNG 1:16">ድንቂ አከም ነመት ቶልተ!</para>
  <para style="q2" vid="SNG 1:16">መርግ ለልሳን ስሬኬኘ።<verse eid="SNG 1:16"/></para>
  <para style="sp">እሰ</para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 1:17"/>ደሬርሱማን መነኬኛ ብርብርሰ፤</para>
  <para style="q2" vid="SNG 1:17">ደገሌንሳሞ ጋትራዸ።<verse eid="SNG 1:17"/></para>
  <chapter eid="SNG 1"/>
  <chapter number="2" style="c" sid="SNG 2"/>
  <para style="sp">እሼ</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 2:1"/>አን ደራራ ሻሮን፤</para>
  <para style="q2" vid="SNG 2:1">ደራራ ሱሉለ ኬሳት።<verse eid="SNG 2:1"/></para>
  <para style="sp">እሰ</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 2:2"/>ጃለሌንኮ ዱበረን ካን ግዱት</para>
  <para style="q2" vid="SNG 2:2">አኩመ ደራራ ቆራቲ ኬሳት።<verse eid="SNG 2:2"/></para>
  <para style="sp">እሰ</para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 2:3"/>ምቹንኮ ደርገጎተ ግዱት</para>
  <para style="q2" vid="SNG 2:3">አኩመ ሙከ ሁዻ ከን ሙኬን ቦሶና ኬሰ ጅሩት።</para>
  <para style="q1" vid="SNG 2:3">አን ጋድሰሳ ጀለ ታኡ ነንጃለዸ፤</para>
  <para style="q2" vid="SNG 2:3">እጅሳስ ነት ምኣወ።<verse eid="SNG 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 2:4"/>እን ገልመ ጭዻት ነ ጌሴ፤</para>
  <para style="q2" vid="SNG 2:4">አኬክን እን ናፍ ቀቡ ጃለለ።<verse eid="SNG 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 2:5"/>ሰበቢ አን ጃለላን ገገቤፍ</para>
  <para style="q2" vid="SNG 2:5">እስን ብጥሌ ወይኒቲን ነ ጀጀቤሳ፤</para>
  <para style="q2" vid="SNG 2:5">ሙከ ሁዻቲንስ ነ ሃሮምሳ።<verse eid="SNG 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 2:6"/>ሀርክሳ ብታ መታኮ ጀለ ጅረ፤</para>
  <para style="q2" vid="SNG 2:6">ሀርክሳ ምርጋሞ ነ ሀመተ።<verse eid="SNG 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 2:7"/>ያ እንተለን ዬሩሳሌም፣</para>
  <para style="q2" vid="SNG 2:7">አን ኩሩጴፊ ቦሮፋን እስን ከከቺሰ፤</para>
  <para style="q1" vid="SNG 2:7">ሀመ እሼን ኦፉማን ፌቴ ካቱት</para>
  <para style="q2" vid="SNG 2:7">ጃለለ ህንቱቱቅና ዮካን ህንደደመቅስና።<verse eid="SNG 2:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 2:8"/>ሰገሌን ምቹኮቲ፣ ቱሉወንረ ኡታሌ</para>
  <para style="q2" vid="SNG 2:8">ጋረንረስ ቃርኤ ዹፋ ጅረ።<verse eid="SNG 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 2:9"/>ምቹንኮ አኩመ ኩሩጴ ዮካን ኮርመ ገደምሳት።</para>
  <para style="q2" vid="SNG 2:9">ኩኖ እን ደላኬኘ ዱበ ዻበቴ</para>
  <para style="q1" vid="SNG 2:9">ፎዳ ኬሳን እላላ</para>
  <para style="q2" vid="SNG 2:9">ቃወ ኬሳንስ ምምልአቻ ጅረ።<verse eid="SNG 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 2:10"/>ምቹንኮ ዱበቴ አከነ ናን ጄዼ፤</para>
  <para style="q2" vid="SNG 2:10">“ያ ሚዸግዱኮ ከእ!</para>
  <para style="q2" vid="SNG 2:10">በሬዱኮ ኮቱ ነ ወጅን ዴም።<verse eid="SNG 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 2:11"/>ኩኖ! ገን ደርቤረ፤</para>
  <para style="q2" vid="SNG 2:11">ቦካንስ ጫሜ ሶኬረ።<verse eid="SNG 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 2:12"/>ደራራን ለፈረት ሙልአቴረ፤</para>
  <para style="q2" vid="SNG 2:12">ወቅቲን ስርባ ገኤረ፤</para>
  <para style="q1" vid="SNG 2:12">ወጭን ጉጌስ</para>
  <para style="q2" vid="SNG 2:12">ብየኬኘ ኬሰት ዸገአማ ጅረ።<verse eid="SNG 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 2:13"/>ሙክን ሀርቡ እጀ ጀልቀባ ባሱ ጀልቀቤረ፤</para>
  <para style="q2" vid="SNG 2:13">ወይኒን ደራሬስ ኡርጋ ኬኔረ።</para>
  <para style="q1" vid="SNG 2:13">ያ ሚዸግዱኮ፣ ከኢ ኮቱ፤</para>
  <para style="q2" vid="SNG 2:13">ያ በሬዱኮ ነ ወጅን ዴም።”<verse eid="SNG 2:13"/></para>
  <para style="sp">እሰ</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 2:14"/>ጉጌኮ ከን ሆልቀ ዸጋ ኬሳ፣</para>
  <para style="q2" vid="SNG 2:14">ከን እዶ ዾክሳ ቱሉ ጭና ኬሳ፣</para>
  <para style="q1" vid="SNG 2:14">ሜ ፉለኬ ነ አርግሲስ፤</para>
  <para style="q2" vid="SNG 2:14">ሜ ሰገሌኬ ነ ዸጌስስ፤</para>
  <para style="q1" vid="SNG 2:14">ሰገሌንኬ ምኣዋዻቲ፤</para>
  <para style="q2" vid="SNG 2:14">ፉልኬስ ነመት ቶለ።<verse eid="SNG 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 2:15"/>ሜ ዋንጎ፣</para>
  <para style="q2" vid="SNG 2:15">ዋንጎዹመ ጥጥኖሼ</para>
  <para style="q1" vid="SNG 2:15">ከኔን እዶ ዻባ ወይኒ በሌስቱ ኑፍ ቀባ፤</para>
  <para style="q2" vid="SNG 2:15">እዶን ዻባ ወይኒኬኛ ደራራ ጅራቲ።<verse eid="SNG 2:15"/></para>
  <para style="sp">እሼ</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 2:16"/>ምቹንኮ ከኑመኮት፤ አንስ ከንሳት፤</para>
  <para style="q2" vid="SNG 2:16">እን ደራራ ኬሰ ዼችፈተ።<verse eid="SNG 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 2:17"/>ያ ምቹኮ፣</para>
  <para style="q2" vid="SNG 2:17">ሀመ በርኤ ጋድስን በዱት ዴብእ፤</para>
  <para style="q1" vid="SNG 2:17">አኩመ ኩሩጴ ዮካን አኩመ ኮርመ ገደምሳ</para>
  <para style="q2" vid="SNG 2:17">ከን ቱሉወንረ ጅሩስ ተእ።<verse eid="SNG 2:17"/></para>
  <para style="b"/>
  <chapter eid="SNG 2"/>
  <chapter number="3" style="c" sid="SNG 3"/>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 3:1"/>አን ሀልከን ጉቱ ስሬኮረ ጪሴ</para>
  <para style="q2" vid="SNG 3:1">ነመ ገራንኮ ጃለቱ ሰነ ነንበርባዴ፤</para>
  <para style="q2" vid="SNG 3:1">አን እሰ ነንበርባዴ፤ ገሩ እሰ ህንአርገኔ።<verse eid="SNG 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 3:2"/>አን አመ ከኤን መጋላ ኬሰ፣</para>
  <para style="q2" vid="SNG 3:2">ዳንዲወኒፊ ኦብዲወንረ ነንዴመ፤</para>
  <para style="q1" vid="SNG 3:2">ነመ ገራንኮ ጃለቱ ሰነ ነንበርባደ።</para>
  <para style="q2" vid="SNG 3:2">ከናፉ አን እሰ ነንበርባዴ፤</para>
  <para style="q2" vid="SNG 3:2">ገሩ እሰ ህንአርገኔ።<verse eid="SNG 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 3:3"/>ኤግዶን ኡቱ መጋላ ኬሰ ናነአኑ ነ አርገን፤</para>
  <para style="q2" vid="SNG 3:3">አንስ፣ “ምቹኮ አርግተኒ?”</para>
  <para style="q2" vid="SNG 3:3">ጄዼን እሳን ጋፈዼ።<verse eid="SNG 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 3:4"/>አን አኩመን ጥኖ እሳን ብረ ደርቤን፣</para>
  <para style="q2" vid="SNG 3:4">ነመ ሉቡንኮ ጃለቱ ሰነ ነንአርገዼ።</para>
  <para style="q1" vid="SNG 3:4">አንስ እሰ ነንቀበዼ፤ ሀመን መነ ሃዸኮት፣</para>
  <para style="q2" vid="SNG 3:4">ዲንቀ ሃዸኮ እሼ ገራት ነ ባቴ ሰናት</para>
  <para style="q2" vid="SNG 3:4">ኦል ገልቹት ገድ እሰ ህንዺስኔ።<verse eid="SNG 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 3:5"/>ያ እንተለን ዬሩሳሌም፣</para>
  <para style="q2" vid="SNG 3:5">አን ኩሩጴፊ ቦሮፋን እስን ከከቺሰ፤</para>
  <para style="q1" vid="SNG 3:5">ሀመ እሼን ኦፉማን ፌቴ ካቱት፣</para>
  <para style="q2" vid="SNG 3:5">ጃለለ ህንቱቱቅና ዮካን ህንደደመቅስና።<verse eid="SNG 3:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 3:6"/>እሼን ቁምቢፊ እጣነ</para>
  <para style="q2" vid="SNG 3:6">ኡርጎፍቱ ደልደልቶታ ሁንደራ ሆጄተሜን ኡርጌፈምቴ</para>
  <para style="q1" vid="SNG 3:6">አኩመ ኡቱባ ኣራ</para>
  <para style="q2" vid="SNG 3:6">ገሞጂ ኬሳ ኦል ባቱ ኩን ኤኙ?<verse eid="SNG 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 3:7"/>ኩኖ! ስሬ ሶሎሞን ከን ሎልቶተ ጃተመ</para>
  <para style="q2" vid="SNG 3:7">ወረ እስራኤል ኬሳ ቤቤከሞ ተአኒን መርፈምቴርት።<verse eid="SNG 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 3:8"/>ሁንድሳኒ ጎራዴ ህዸቱ፤</para>
  <para style="q2" vid="SNG 3:8">ሁንድኑ ሙጠትኖ ወራና ቀቡ፤</para>
  <para style="q1" vid="SNG 3:8">ቶኮን ቶኮንሳኒ ጎራዴሳኒ</para>
  <para style="q2" vid="SNG 3:8">ሉቄቱት ህዸተኒ ሎለ ሀልከኒቲፍ ቆጳአን።<verse eid="SNG 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 3:9"/>ሶሎሞን ሞትች ኦፊሳቲ ጋሪ ቶልፈቴ፤</para>
  <para style="q2" vid="SNG 3:9">እንስ ሙከ ልባኖንራ ቶልፈቴ።<verse eid="SNG 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 3:10"/>እን ኡቱባሳ ሜቲዻን ሆጄቴ፤</para>
  <para style="q2" vid="SNG 3:10">ጀለሳ ገሩ ወርቄዻን ሆጄቴ።</para>
  <para style="q1" vid="SNG 3:10">ቴሶንሳ ክሪ ዲማ ዺልጌዻን ሆጄተሜ፤</para>
  <para style="q2" vid="SNG 3:10">ኬስሳስ ጃለለ እንተለን ዬሩሳሌሚቲን በሬቸሜ ሆጄተሜ።<verse eid="SNG 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 3:11"/>ያ እንተለን ጥዮን ገድ በኣቲ ሶሎሞን ሞትቸ እላላ፤</para>
  <para style="q2" vid="SNG 3:11">እን ጎንፎ ሃትሳ ጋፈ ፉዸሳ፣</para>
  <para style="q1" vid="SNG 3:11">ጉያ ገራንሳ ገመዴት፣</para>
  <para style="q2" vid="SNG 3:11">መታሳረ ኬሴፍ ሰነ ካአቴረ።<verse eid="SNG 3:11"/></para>
  <chapter eid="SNG 3"/>
  <chapter number="4" style="c" sid="SNG 4"/>
  <para style="sp">እሰ</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 4:1"/>ያ በሬዱኮ፣ አት አከም ሚዸግደ!</para>
  <para style="q2" vid="SNG 4:1">ድንቂ አት አከም በሬደ!</para>
  <para style="q2" vid="SNG 4:1">እጅኬ ሀጉጊኬ ዱባን ጉጌ ፈካተ።</para>
  <para style="q1" vid="SNG 4:1">ርፌንስ መታኬቲ አኩመ ከረ ሬኦታ</para>
  <para style="q2" vid="SNG 4:1">ከን ጋረ ግልኣድራ ገድ ቡኡት።<verse eid="SNG 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 4:2"/>እልካንኬ አኩመ ከረ ሆሎታ ከን ርፌንስ እራ ሃደሜ</para>
  <para style="q2" vid="SNG 4:2">ዽቀሜ ኦል ዹፋ ጅሩት።</para>
  <para style="q1" vid="SNG 4:2">ቶኮን ቶኮንሳኒ ለኩ ቀቡ፤</para>
  <para style="q2" vid="SNG 4:2">እሳን ኬሰ መሴን ቶኮዩ ህንጅሩ።<verse eid="SNG 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 4:3"/>ህዺንኬ አኩመ ክሪ ብልዲማት፤</para>
  <para style="q2" vid="SNG 4:3">ሃሳንኬ ነመት ቶለ።</para>
  <para style="q1" vid="SNG 4:3">መዲንኬ ለማን ሀጉጊኬ ኬሰት</para>
  <para style="q2" vid="SNG 4:3">ሮማኒ ቶክቸ እዶ ለመት ቆደሜ ፈካተ።<verse eid="SNG 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 4:4"/>ሞርምኬ ገሞ ዳዊት</para>
  <para style="q2" vid="SNG 4:4">ከን ምአ ሎላ እት ኩሱፍ እጃረሜ ሰነ ፈካተ፤</para>
  <para style="q1" vid="SNG 4:4">እሰረት ጋቸነ ኩመቱ ረራፈመ፤</para>
  <para style="q2" vid="SNG 4:4">ሁንድኑ ጋቸነ ሎልቶታት።<verse eid="SNG 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 4:5"/>ጉንቱንኬ ለማን አኩመ እልሞሌ ኩሩጴ</para>
  <para style="q2" vid="SNG 4:5">ከኔን ለኩ ዸለተኒ ደራራ ኬሰ ዼደኒት።<verse eid="SNG 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 4:6"/>ሀመ በርኤ ጋድስን በዱት፣</para>
  <para style="q2" vid="SNG 4:6">አን ገረ ቱሉ ቁምቢቲፊ ገረ ጋረ እጣና ነንዸቀ።<verse eid="SNG 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 4:7"/>ያ ጃለሌኮ፣ አት ጉቱማን ጉቱት በሬዱዸ፤</para>
  <para style="q2" vid="SNG 4:7">አት ሙዳ ቶኮሌ ህንቀብዱ።<verse eid="SNG 4:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 4:8"/>ያ ምስርቲኮ፣ ልባኖኒ ነ ወጅን ኮቱ፤</para>
  <para style="q2" vid="SNG 4:8">ልባኖኒ ነ ወጅን ኮቱ።</para>
  <para style="q1" vid="SNG 4:8">ፊጤ አማናራ፣</para>
  <para style="q2" vid="SNG 4:8">ፊጤ ሴኒር፣ ፊጤ ሄርሞንራ ገድ ቡእ፤</para>
  <para style="q1" vid="SNG 4:8">ሆልቀ ሌንጫ ኬሳ፣</para>
  <para style="q2" vid="SNG 4:8">ቱሉ ኦልማ ቄረንሳራስ ገድ ቡእ።<verse eid="SNG 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 4:9"/>ያ ኦቦሌቲኮ፣ ያ ምስርቲኮ፣ አት ቀልቢኮ ሀቴርተ፤</para>
  <para style="q2" vid="SNG 4:9">አት ምልኡ እጀኬቲ ቶኮን፣</para>
  <para style="q2" vid="SNG 4:9">ፋየ ሞርመኬቲ ቶኮን ቀልቢኮ ሀቴርተ።<verse eid="SNG 4:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 4:10"/>ያ ኦቦሌቲኮ፣ ያ ምስርቲኮ፣ <optbreak/> ጃለልኬ አከም ነመ ገመቺሰ!</para>
  <para style="q2" vid="SNG 4:10">ጃለልኬ ዳዺ ወይኒ ጫላ፣ ኡርጋን ሽቶኬቲስ</para>
  <para style="q2" vid="SNG 4:10">ኡርጎፍቱ ከምዩ ጫላ አከም ነመት ቶለ!<verse eid="SNG 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 4:11"/>ያ ምስርቲኮ፣</para>
  <para style="q2" vid="SNG 4:11">ህዺንኬ አኩመ ዻበ ደማ ነዺ ጮጮብሰ፤</para>
  <para style="q2" vid="SNG 4:11">ኣነኒፊ ደም አረበኬ ጀለ ጅረ።</para>
  <para style="q1" vid="SNG 4:11">ኡርጋን ኡፈተኬቲ</para>
  <para style="q2" vid="SNG 4:11">አኩመ ኡርጋ ልባኖን።<verse eid="SNG 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 4:12"/>ያ ኦቦሌቲኮ፣ ያ ምስርቲኮ፣</para>
  <para style="q2" vid="SNG 4:12">አት አኩመ እዶ ብቅልቱ ጩፈሜት፤</para>
  <para style="q2" vid="SNG 4:12">አት ቡርቃ ደላን እት እጃረሜፊ መደ ቻፓን ጩፈሜዸ።<verse eid="SNG 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 4:13"/>ብቅልቱንኬ እዶ ሮማኒ</para>
  <para style="q2" vid="SNG 4:13">ከን እጀ ፍለተማ ሄናፊ ናርዶስ ቀቡዸ፤<verse eid="SNG 4:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="SNG 4:14"/>አከሱመስ ናርዶሲፊ መርገ ኡርጋኡ፣</para>
  <para style="q2" vid="SNG 4:14">ቁንዺፊ ቀረፋ፣ ሙከ እጣና ጎሰ ገራ ገራ፣</para>
  <para style="q2" vid="SNG 4:14">ቁምቢ፣ አርጌሳፊ ኡርጎፍቱ አከ መሌ ጋሪ ሁንደ ቀበ።<verse eid="SNG 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 4:15"/>አት ቡርቃ ብቅልቱ ኬሳት፤</para>
  <para style="q2" vid="SNG 4:15">ብሻን ቦላ ያኡ</para>
  <para style="q2" vid="SNG 4:15">ከን ልባኖንራ ገድ ዸንገለኡዸ።<verse eid="SNG 4:15"/></para>
  <para style="sp">እሼ</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 4:16"/>ያ ቡቤ ካባ ደመቅ፤</para>
  <para style="q2" vid="SNG 4:16">ቡቤን ክባስ ኮቱ!</para>
  <para style="q1" vid="SNG 4:16">አከ ኡርጋንሳ ናኖ ሁንደ ወሊን ገኡፍ</para>
  <para style="q2" vid="SNG 4:16">ብቅልቱኮረት ቡብስ።</para>
  <para style="q1" vid="SNG 4:16">ምቹንኮ ዹፌ፣ ብቅልቱ ሴኔ</para>
  <para style="q2" vid="SNG 4:16">እጀ ፍለተማ ሃኛቱ።<verse eid="SNG 4:16"/></para>
  <chapter eid="SNG 4"/>
  <chapter number="5" style="c" sid="SNG 5"/>
  <para style="sp">እሰ</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 5:1"/>ያ ኦቦሌቲኮ፣ ምስርቲኮ፣ <optbreak/> አን ዹፌ ብቅልቱኮ ሴኔረ፤</para>
  <para style="q2" vid="SNG 5:1">አን ቁምቢኮ ኡርጎፍቱኮ ወጅን ወልት ቀበዼረ።</para>
  <para style="q1" vid="SNG 5:1">አን ዻበ ደመኮ ነዺሳ ወጅን ኛዼረ፤</para>
  <para style="q2" vid="SNG 5:1">ዳዺ ወይኒኮስ ኣነንኮ ወጅን ዹጌረ።</para>
  <para style="sp" vid="SNG 5:1">ምቾተ</para>
  <para style="q1" vid="SNG 5:1">ያ ምቾተ፣ ኛዻ ዹጋ፤</para>
  <para style="q2" vid="SNG 5:1">ጃለለስ ዹጋ ቁፋ።<verse eid="SNG 5:1"/></para>
  <para style="sp">እሼ</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 5:2"/>አን ረፌረ፤ ገራንኮ ገሩ ደመቄረ።</para>
  <para style="q2" vid="SNG 5:2">ሜ ዸጌፈዻ! ምቹንኮ በልበለ ሩሩኩታ ጅራቲ፤</para>
  <para style="q1" vid="SNG 5:2">እን አከነ ጄዸ፤ “ያ ኦቦሌቲኮ፣ ሚዸግዱኮ፣</para>
  <para style="q2" vid="SNG 5:2">ጉጌኮ ከን ሙዳ ህንቀብኔ፣ በልበለ ናፍ በን።</para>
  <para style="q1" vid="SNG 5:2">መታንኮ ፍጤንሳን፣</para>
  <para style="q2" vid="SNG 5:2">ርፌንስኮስ ጂዸ ሀልከኒቲን ቶርቶሬረ።”<verse eid="SNG 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 5:3"/>አን ኡፈተኮ ኦፍራ ባሴረ፤</para>
  <para style="q2" vid="SNG 5:3">አከምተን ዴብሴ ኡፈዸሬ?</para>
  <para style="q1" vid="SNG 5:3">ሚለኮ ዽቀዼረ፤</para>
  <para style="q2" vid="SNG 5:3">አከምተን ዴብሴ ጡሬሰሬ?<verse eid="SNG 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 5:4"/>ምቹንኮ ቃወ በልበላቲን ሀርከ ገልቼ፤</para>
  <para style="q2" vid="SNG 5:4">ለጴንኮ እሳፍ ንዸአቴ።<verse eid="SNG 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 5:5"/>አን ምቹኮቲፍ በልበለ በኑፍ ነንከኤ፤</para>
  <para style="q2" vid="SNG 5:5">ቀበትኖ በልበላረትስ ሀርከኮራ ቁምቢን፣</para>
  <para style="q2" vid="SNG 5:5">ቁበኮራሞ ቁምቢን ዸንገለኣን ጮጮቤ።<verse eid="SNG 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 5:6"/>አን ምቹኮቲፍ በልበለ ነንበኔ፤</para>
  <para style="q2" vid="SNG 5:6">ምቹንኮ ገሩ አች ህንጅሩ፤ እን ዴሜረ።</para>
  <para style="q2" vid="SNG 5:6">ዴሙ እሳትስ ገራንኮ ንርፈቴ።</para>
  <para style="q1" vid="SNG 5:6">አን እሰ ነንበርባዴ፤ ገሩ ህንአርገኔ።</para>
  <para style="q2" vid="SNG 5:6">አን እሰ ነንዋሜ፤ እን ገሩ ህንኦዋትኔ።<verse eid="SNG 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 5:7"/>ኤግዶን ኡቱ መጋላ ኬሰ ናነአኑ ነ አርገን።</para>
  <para style="q2" vid="SNG 5:7">እሳንስ ነ ሬበኒ ነ መዴሰን፤</para>
  <para style="q2" vid="SNG 5:7">ወር ደላ ኤገን ሱንስ ወያኮ ነራ ባፈተን!<verse eid="SNG 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 5:8"/>ያ እንተለን ዬሩሳሌም፣</para>
  <para style="q2" vid="SNG 5:8">እስን ምቹንኮ ዮ አርግተን</para>
  <para style="q1" vid="SNG 5:8">ጃለላን ዹኩብሰቹኮ አከ</para>
  <para style="q2" vid="SNG 5:8">እሰት ናፍ ህምተን እስነን ከከቺሰ።<verse eid="SNG 5:8"/></para>
  <para style="sp">ምቾተ</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 5:9"/>ያ እሼ ዱበርቶተ ሁንደ ጫላ በሬዱ፣</para>
  <para style="q2" vid="SNG 5:9">ምቹንኬ ማሊን ወረ ካን ጫለ?</para>
  <para style="q1" vid="SNG 5:9">አት ከን አከስ ኑ ከከቺፍቱ፣</para>
  <para style="q2" vid="SNG 5:9">ምቹንኬ ማሊን ወረ ካን ጫለ?<verse eid="SNG 5:9"/></para>
  <para style="sp">እሼ</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 5:10"/>ምቹንኮ ዲማ ጩሉሉቃዸ፤</para>
  <para style="q2" vid="SNG 5:10">እን ነሞተ ኩመ ኩዸን ኬሳ ንሙልአተ።<verse eid="SNG 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 5:11"/>መታንሳ ወርቄ አከ መሌ ቁልቁሉዸ፤</para>
  <para style="q2" vid="SNG 5:11">ርፌንስ መታሳ ጅጋዸ፤</para>
  <para style="q2" vid="SNG 5:11">አኩመ አራጌሳስ ጉራቸ።<verse eid="SNG 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 5:12"/>እጅሳ አኩመ ጉጌ ቡርቃ ብሻኒ ብራ</para>
  <para style="q2" vid="SNG 5:12">ከን ኣነኒን ዽቀሜ አከ ፋያት ካአተሙዸ።<verse eid="SNG 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 5:13"/>መዲንሳ አኩመ መደቢ ብቅልቱ ኡርጎፍቱ ከን ሽቶ ባሱት።</para>
  <para style="q2" vid="SNG 5:13">ህዺንሳ አኩመ ደራራ ቁምቢንራ ጮጮቡት።<verse eid="SNG 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 5:14"/>ሀርክሳ ኡሌ ወርቄ</para>
  <para style="q2" vid="SNG 5:14">ከን ቢረሌዻን ፋዬፈሜዸ።</para>
  <para style="q1" vid="SNG 5:14">ዸግንሳ አኩመ እልከ አርባ</para>
  <para style="q2" vid="SNG 5:14">ከን ሰንፔሪን ሚዸግፈሜዸ።<verse eid="SNG 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 5:15"/>ሚልሳ ኡቱባ ዸጋ አዲ</para>
  <para style="q2" vid="SNG 5:15">ከን ባቱ ወርቄ ቁልቁሉራ ሆጄተሜረ ዻበሜዸ።</para>
  <para style="q1" vid="SNG 5:15">ብፍትሳ አኩመ ልባኖን፣</para>
  <para style="q2" vid="SNG 5:15">አኩመ ብርብርሳ ልባኖን ፍለተማዸ።<verse eid="SNG 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 5:16"/>ዱቢንሳ ዋን ሁንደ ጫላ ምኣዋዸ፤</para>
  <para style="q2" vid="SNG 5:16">እን ጉቱማን ጉቱት ነመት ቶለ።</para>
  <para style="q1" vid="SNG 5:16">ያ እንተለን ዬሩሳሌም፣</para>
  <para style="q2" vid="SNG 5:16">ኩን ምቹኮት፤ ኩን ምቹኮት።<verse eid="SNG 5:16"/></para>
  <chapter eid="SNG 5"/>
  <chapter number="6" style="c" sid="SNG 6"/>
  <para style="sp">ምቾተ</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 6:1"/>ያ እሼ ዱበርቶተ ሁንደ ጫላ በሬዱ፣</para>
  <para style="q2" vid="SNG 6:1">ምቹንኬ ኤሰ ዸቄ?</para>
  <para style="q1" vid="SNG 6:1">አከ ኑ ስ ወጅን በርባኑፍ</para>
  <para style="q2" vid="SNG 6:1">ምቹንኬ ገረምት ጎሬ?<verse eid="SNG 6:1"/></para>
  <para style="sp">እሼ</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 6:2"/>ምቹንኮ እዶ ብቅልቱ ኬሰ</para>
  <para style="q2" vid="SNG 6:2">ሆሎተሳ ትክፈቹፊ</para>
  <para style="q1" vid="SNG 6:2">ደራራ ወልት ቀበቹፍ ጄዼ ገረ እዶ ብቅልቱ፣</para>
  <para style="q2" vid="SNG 6:2">ለፈ መደቢን ብቅልቱ ኡርጎፍቱወኒ ጅሩት ገድ ቡኤረ።<verse eid="SNG 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 6:3"/>አን ከን ምቹኮት፤ ምቹንኮስ ከኑመኮት፤</para>
  <para style="q2" vid="SNG 6:3">እን ደራራ ኬሰ ዼችፈተ።<verse eid="SNG 6:3"/></para>
  <para style="sp">እሰ</para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 6:4"/>ያ ጃለሌኮ፣ አት አኩመ ቲርዛ በሬዱዸ፤</para>
  <para style="q2" vid="SNG 6:4">አኩመ ዬሩሳሌም ነመት ቶልተ፤</para>
  <para style="q2" vid="SNG 6:4">አኩመ ሎልቶተ ፋጂ ባተኒስ ኡልፍነ ቀብደ።<verse eid="SNG 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 6:5"/>እጀኬ ነራ ቡቅስ፤</para>
  <para style="q2" vid="SNG 6:5">እን ነ ጄቄራቲ።</para>
  <para style="q1" vid="SNG 6:5">ርፌንስ መታኬቲ አኩመ ከረ ሬኦተ</para>
  <para style="q2" vid="SNG 6:5">ግልኣድራ ገድ ቡአኒት።<verse eid="SNG 6:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 6:6"/>እልካንኬ አኩመ ከረ ሆሎታ</para>
  <para style="q2" vid="SNG 6:6">ከን ዽቀሜ ኦል ዹፋ ጅሩት።</para>
  <para style="q1" vid="SNG 6:6">ቶኮን ቶኮንሳኒ ለኩ ቀቡ፤</para>
  <para style="q2" vid="SNG 6:6">እሳን ኬሰ መሴን ቶኮዩ ህንጅሩ።<verse eid="SNG 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 6:7"/>መዲንኬ ለማን ሀጉጊኬ ኬሰት</para>
  <para style="q2" vid="SNG 6:7">ሮማኒ ቶክቸ እዶ ለመት ቆደሜ ፈካተ።<verse eid="SNG 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 6:8"/>ሞትቲወን ጃተምን፣ <optbreak/>ሳጀቶን ሰዴተምኒፊ</para>
  <para style="q2" vid="SNG 6:8">ዱበረን ለኮብሰ ህንቀብኔ ቁልቁሉን <optbreak/> ጅራቹ ደንደኡ፤<verse eid="SNG 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 6:9"/>ጉጌንኮ ከን ሙዳ ቶኮዩ ህንቀብኔ ሱን ከን አዳት፤</para>
  <para style="q2" vid="SNG 6:9">እሼን ሃዸሼቲፍ እንተለ ቶክቲዸ፤</para>
  <para style="q2" vid="SNG 6:9">ሃዸሼ ዴሴፍስ ፍለተምቱዸ።</para>
  <para style="q1" vid="SNG 6:9">ዱበረን እሼ አርገኒ እሼ ኤብሰን፤</para>
  <para style="q2" vid="SNG 6:9">ሞትቲወኒፊ ሳጀቶወንስ እሼ ጀጀን።<verse eid="SNG 6:9"/></para>
  <para style="sp">ምቾተ</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 6:10"/>ከን አከ ቦሩ በቀቁት ሙልአቱ፣</para>
  <para style="q2" vid="SNG 6:10">ከን አከ ጅኣ በሬዱ፣ ከን አከ ቢፍቱ እፍቱ፣</para>
  <para style="q2" vid="SNG 6:10">ከን አከ ኡርጂወን ቶራን ያአኒ ኡልፍነ ቀብዱ ኩን ኤኙ?<verse eid="SNG 6:10"/></para>
  <para style="sp">እሰ</para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 6:11"/>አንስ ደራራ ሱሉለ ኬሰት ዽኦ ብቅሌ አርጉፍ፣</para>
  <para style="q2" vid="SNG 6:11">አከ ወይኒን ሁዻ ባሴ</para>
  <para style="q1" vid="SNG 6:11">ዮካን አከ ሮማኒን ደራሬ እላሉፍ</para>
  <para style="q2" vid="SNG 6:11">ገረ ለፈ ቆቲሳ ኦቾሎኒት ገድ ነንቡኤ።<verse eid="SNG 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 6:12"/>ኡቱ አን ህንሁበትን፣</para>
  <para style="q2" vid="SNG 6:12">ሉቡንኮ ጋሪ ሞቲ ሰበኮቲ ኬሰ ነ ቴስስቴ።<verse eid="SNG 6:12"/></para>
  <para style="sp">ምቾተ</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 6:13"/>ያ ሱላማጥቲ ዴብእ፤ ዴብእ፤</para>
  <para style="q2" vid="SNG 6:13">አከ ኑ ሲላሉፍ ዴብእ፤ ዴብእ!</para>
  <para style="sp" vid="SNG 6:13">እሰ</para>
  <para style="q1" vid="SNG 6:13">እስን አኩመ ነመ ስርበ መሀነዪም እላሉት</para>
  <para style="q2" vid="SNG 6:13">ማሊፍ ሱላማጥቲ እላልቱ?<verse eid="SNG 6:13"/></para>
  <para style="b"/>
  <chapter eid="SNG 6"/>
  <chapter number="7" style="c" sid="SNG 7"/>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 7:1"/>ያ እንተለ እልመ ሞቲ፣</para>
  <para style="q2" vid="SNG 7:1">ሚልኬ ኮጴ ኬሰት አከም በሬደ!</para>
  <para style="q1" vid="SNG 7:1">ጉዴድንኬ ሚዸጋን ሱን ዶቀ ገቲ ጉዳ</para>
  <para style="q2" vid="SNG 7:1">ከን ኦጌስ ሆጂ ሀርካ ቶልቼ ፈካተ።<verse eid="SNG 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 7:2"/>ሀንዹርኬ ጦፎ ጌንጎ</para>
  <para style="q2" vid="SNG 7:2">ከን ተኩማ ዳዺን ወይኒ ወል መካን ኬሳ <optbreak/> ህንዸበምን ፈካተ።</para>
  <para style="q1" vid="SNG 7:2">ሙዺን ኬሞ ቱላ ቀመዲ</para>
  <para style="q2" vid="SNG 7:2">ከን ደራራዻን መርፈሜ ፈካተ።<verse eid="SNG 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 7:3"/>ጉንቱንኬ ለማን አኩመ እልሞሌ ኩሩጴ</para>
  <para style="q2" vid="SNG 7:3">ከኔን ለኩ ዸለተኒት።<verse eid="SNG 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 7:4"/>ሞርምኬ ገሞ እልከ አርባ ፈካተ።</para>
  <para style="q1" vid="SNG 7:4">እጅኬ ሀሮ ሄሽቦን</para>
  <para style="q2" vid="SNG 7:4">ከን ከረ ባትረቢ ብራ ፈካተ።</para>
  <para style="q1" vid="SNG 7:4">ፉኛንኬ ገሞ ልባኖን</para>
  <para style="q2" vid="SNG 7:4">ከን ገረ ደማስቆ ገድ እላሉ ፈካተ።<verse eid="SNG 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 7:5"/>መታንኬ አኩመ ቱሉ ቀርሜሎስ ጎንፎ ሲፍ ተአ።</para>
  <para style="q2" vid="SNG 7:5">ርፌንስ መታኬቲ አፋ መነ ሞቲ ፈካተ፤</para>
  <para style="q2" vid="SNG 7:5">ሞቲን ዼርነሳቲን ቀበሜ ቦጅአመ።<verse eid="SNG 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 7:6"/>ያ ጃለሌ አት ገመቹኬ ወጅን</para>
  <para style="q2" vid="SNG 7:6">አከም በሬደ፤ አከምስ ነመት ቶልተ!<verse eid="SNG 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 7:7"/>ዻብንኬ ዻበ ሜጢ ፈካተ፤</para>
  <para style="q2" vid="SNG 7:7">ጉንቱንኬስ ሁርቡ እጃ ፈካተ።<verse eid="SNG 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 7:8"/>አንስ፣ “ሙከ ሜጢ ከነ ነንያበዸ፤</para>
  <para style="q2" vid="SNG 7:8">እጀሳ ነንቀበዸ” ነንጄዼ።</para>
  <para style="q1" vid="SNG 7:8">ጉንቱንኬ አኩመ ሁርቡ ወይኒ፣</para>
  <para style="q2" vid="SNG 7:8">ኡርጋን ሀፉረኬቲ አኩመ ኡርጋ ሁዻት፤<verse eid="SNG 7:8"/></para>
  <para style="q2">
    <verse number="9" style="v" sid="SNG 7:9"/>አፋንኬስ አኩመ ዳዺ ወይኒ ከን አከ መሌ ጋሪ ተኤት።</para>
  <para style="sp" vid="SNG 7:9">እሼ</para>
  <para style="q1" vid="SNG 7:9">ዳዺን ወይኒ ሱቱማን ህዺፊ</para>
  <para style="q2" vid="SNG 7:9">እልካንረ ገድ ያኤ ገረ ምቹኮ ሃዸቁ።<verse eid="SNG 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 7:10"/>አን ከን ምቹኮት፤</para>
  <para style="q2" vid="SNG 7:10">ሀዊንሳስ አኑማፍ።<verse eid="SNG 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 7:11"/>ያ ምቹኮ፣ ኮቱ ሜ ገረ ባድያ ሃዴምኑ፤</para>
  <para style="q2" vid="SNG 7:11">ገንዶተ አቺ ኬሰ ሃቡሉ።<verse eid="SNG 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 7:12"/>አከ ሙክን ወይኒ ሁዻ ባፈቴ፣</para>
  <para style="q2" vid="SNG 7:12">አከ ደራራን እጀ በነቴፊ</para>
  <para style="q1" vid="SNG 7:12">አከ ሮማኒን ደራሬ እላሉፍ ገነመ በሪን ካኔ</para>
  <para style="q2" vid="SNG 7:12">ገረ እዶ ዻባ ወይኒ ሃዴምኑ፤</para>
  <para style="q2" vid="SNG 7:12">አንስ አችት ጃለለኮ ሲፍ ነንኬነ።<verse eid="SNG 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 7:13"/>ሁዻን ኡርጋሳ ገድ ዺሰ፤</para>
  <para style="q2" vid="SNG 7:13">ያ ምቹኮ፣ ወን አን ሲፍ ኩሴ፣</para>
  <para style="q1" vid="SNG 7:13">ሃራፊ ሞፋንስ ወን ፍለተማን ሁንድ</para>
  <para style="q2" vid="SNG 7:13">በልበለኬኘ ዱረ ጅረ።<verse eid="SNG 7:13"/></para>
  <chapter eid="SNG 7"/>
  <chapter number="8" style="c" sid="SNG 8"/>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 8:1"/>ኡቱ አት አከ ኦቦሌሰኮ</para>
  <para style="q2" vid="SNG 8:1">ከን ሀርመ ሃዸኮ ሆዼ ጉደቴ ና ታቴ!</para>
  <para style="q1" vid="SNG 8:1">አን ዮን አለት ስ አርጌ ስን ዹንገዸን ቱሬ፤</para>
  <para style="q2" vid="SNG 8:1">ነምን ቶኮዩ ነ ህንቱፈቱ።<verse eid="SNG 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 8:2"/>አንስ ስ ዱረ ዴሜ መነ ሃዸኮ</para>
  <para style="q2" vid="SNG 8:2">እሼ ነ በርሲፍቴ ሰናት ስን ጌሰ ቱሬ።</para>
  <para style="q1" vid="SNG 8:2">አከ አት ዹግዱፍስ ዳዺ ወይኒ ከን ምኤፈሜ</para>
  <para style="q2" vid="SNG 8:2">ጩንፋ ሮማኒኮስ ሲፍን ኬነ ቱሬ።<verse eid="SNG 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 8:3"/>ሀርክሳ ብታ መታኮ ጀለ ጅረ፤</para>
  <para style="q2" vid="SNG 8:3">ሀርክሳ ምርጋሞ ነ ሀመተ።<verse eid="SNG 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 8:4"/>ያ እንተለን ዬሩሳሌም፣ አን እስን ከከቺሰ፤</para>
  <para style="q2" vid="SNG 8:4">ሀመ እሼን ኦፉማን ፌቴ ካቱት</para>
  <para style="q2" vid="SNG 8:4">ጃለለ ህንቱቱቅና ዮካን ህንደደመቅስና።<verse eid="SNG 8:4"/></para>
  <para style="sp">ምቾተ</para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 8:5"/>ከን ምቹሼት እርከቴ</para>
  <para style="q2" vid="SNG 8:5">ገሞጂ ኬሳ ኦል ዹፋ ጅርቱ ኩን ኤኙ?</para>
  <para style="sp" vid="SNG 8:5">እሼ</para>
  <para style="q1" vid="SNG 8:5">አን ሙከ ሁዻ ጀለት ስን ከካሴ፤</para>
  <para style="q2" vid="SNG 8:5">ሃትኬ አችት ስ ኡልፎፍቴ፤</para>
  <para style="q2" vid="SNG 8:5">አቹመትስ ጭኒንስፈቴ ስ ዴሴ።<verse eid="SNG 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 8:6"/>አኩመ ቻፓት ለጴኬረ፣</para>
  <para style="q2" vid="SNG 8:6">አኩመ ቻፓት እሬኬረ ነ ካአዹ፤</para>
  <para style="q1" vid="SNG 8:6">ጃለል አኩመ ዱኣ ጀብዱዻቲ፤</para>
  <para style="q2" vid="SNG 8:6">ህናፋንሳስ አኩመ አዋላ ሀማዸ።</para>
  <para style="q1" vid="SNG 8:6">እን አኩመ እብደ በለልኡ፣</para>
  <para style="q2" vid="SNG 8:6">አኩመ አረበ እብደ ጀባ ቦበአ።<verse eid="SNG 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 8:7"/>ብሻን ባይኤን ጃለለ ዻምሱ ህንደንደኡ፤</para>
  <para style="q2" vid="SNG 8:7">ለግንስ ዽቄ እሰ በሌሱ ህንደንደኡ።</para>
  <para style="q1" vid="SNG 8:7">ነምን ቶኮ ቀቤኘ መነሳ ሁንደ</para>
  <para style="q2" vid="SNG 8:7">ዮ ጃለላፍ ኬኔ</para>
  <para style="q2" vid="SNG 8:7">ቀቤኝ ሱን ጉቱማን ጉቱት ንቱፈተመ።<verse eid="SNG 8:7"/></para>
  <para style="sp">ምቾተ</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 8:8"/>ኑ ኦቦሌቲ ጥኖ ቶኮ ቀብነ፤</para>
  <para style="q2" vid="SNG 8:8">እሼን ጉንቱተዩ ህንባፍኔ።</para>
  <para style="q1" vid="SNG 8:8">ጉያ እሼን ሄሩማፍ ከዸተምቱት</para>
  <para style="q2" vid="SNG 8:8">ኑ ኦቦሌቲኬኛፍ ማል ጎነ?<verse eid="SNG 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 8:9"/>ኡቱ እሼን ደላ ዸጋ ታቴ</para>
  <para style="q2" vid="SNG 8:9">ኑ ስላ ገሞ ሜቲሼረት እጃረ ቱሬ።</para>
  <para style="q1" vid="SNG 8:9">ኡቱ እሼን በልበለ ታቴ</para>
  <para style="q2" vid="SNG 8:9">ኑ ስላ ብርብርሳን እሼ መርስነ።<verse eid="SNG 8:9"/></para>
  <para style="sp">እሼ</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 8:10"/>አን ደላ ዸጋት፤</para>
  <para style="q2" vid="SNG 8:10">ጉንቱንኮስ አኩመ ገሞት።</para>
  <para style="q1" vid="SNG 8:10">ከናፉ አን ፉለሳ ዱረት</para>
  <para style="q2" vid="SNG 8:10">አኩመ ነመ ነጋ ፍዱ ቶኮት ነንእላለመን ቱሬ።<verse eid="SNG 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 8:11"/>ሶሎሞን በኣል ሃሞን ኬሳ እዶ ዻባ ወይኒ ቀበ ቱሬ፤</para>
  <para style="q2" vid="SNG 8:11">እንስ እዶ ዻባ ወይኒ ኦፊሳ ቆቱወንት ክራ ኬነቴ።</para>
  <para style="q1" vid="SNG 8:11">ቶኮን ቶኮንሳኒስ እጀ አርገተንራ</para>
  <para style="q2" vid="SNG 8:11">ሜቲ ሰቅሊ ኩመ ቶኮ ፍዱፊ ቀቡ ቱሬ።<verse eid="SNG 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 8:12"/>እዶን ዻባ ወይኒኮቲ፣ ከኑመኮት፤</para>
  <para style="q2" vid="SNG 8:12">ያ ሶሎሞን፣ ሰቅሊን ኩምን ሱን ሱማፍ፤</para>
  <para style="q2" vid="SNG 8:12">ዽብ ለመሞ ከን ወረ እጀሳ ኤገኒት።<verse eid="SNG 8:12"/></para>
  <para style="sp">እሰ</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 8:13"/>ያ እሼ እዶ ብቅልቱ ኬሰ ጅራቱ፣</para>
  <para style="q2" vid="SNG 8:13">ምቾትን ሰገሌኬ ዸጌፈቻ ጅሩ፤</para>
  <para style="q2" vid="SNG 8:13">ሜ አንስ ነንዸገአ!<verse eid="SNG 8:13"/></para>
  <para style="sp">እሼ</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 8:14"/>ያ ምቹኮ፣ ደፊ ኮቱ፤</para>
  <para style="q2" vid="SNG 8:14">አከ ኩሩጴ</para>
  <para style="q1" vid="SNG 8:14">ዮካን አከ ኮርመ ገደምሳ</para>
  <para style="q2" vid="SNG 8:14">ከን ጋረ ኡርጎፍቱረ ቡራቁ ተእ።<verse eid="SNG 8:14"/></para>
  <chapter eid="SNG 8"/>
</usx>
