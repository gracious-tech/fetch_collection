<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ACT" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">ሆጂ</para>
  <para style="toc1">ሆጂ ኤርገሞታ</para>
  <para style="toc2">ሆጂ</para>
  <para style="toc3">ሆጂ</para>
  <para style="mt1">ሆጂ ኤርገሞታ</para>
  <chapter number="1" style="c" sid="ACT 1"/>
  <para style="s1">ሴንሰ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 1:1"/>ያ ቴዎፍሎስ፣ አን ዋን ዬሱስ ሆጄቹፊ በርሲሱ ጀልቀቤ ሁንደ ክታበኮ ከን ጀልቀባ ኬሰት በሬሴረ። <verse eid="ACT 1:1"/><verse number="2" style="v" sid="ACT 1:2"/>ወን ኩንስ ዋን ኤርገ ዬሱስ ኤርገሞተ ፍለቴ ሰናፍ ከራ ሀፉረ ቁልቁሉቲን አጀጀ ኬኔ ቦዴ ሀመ ጋፈ እን ሰሚት ኦል ፉዸተሜት ተኤዸ። <verse eid="ACT 1:2"/><verse number="3" style="v" sid="ACT 1:3"/>እንስ ዱአሳ ቦዴ ነሞተ ከነት ኦፍ አርግሲሴ ዋን አከ እን ጅራታ ተኤ ምርከኔሱ ባይኤስ ዽኤሴ፤ ቡልቲ አፉርተመ እሳንት ሙልአቴ ዋኤ ሞቱማ ዋቃ ዱበቴ። <verse eid="ACT 1:3"/><verse number="4" style="v" sid="ACT 1:4"/>ኡቱ እሳን ወጅን ጅሩስ አከነ ጄዼ እሳን አጀጄ፤ <char style="wj">“ዋዳ አባ ከን ዋኤሳ ነራ ዸጌሰን ሰነ ኤገዻ መሌ ዬሩሳሌሚ ህንበእና።</char> <verse eid="ACT 1:4"/><verse number="5" style="v" sid="ACT 1:5"/><char style="wj">ዮሀንስ ብሻኒን ጩጴቲ፤ እስን ገሩ ቡልቲ ጥኖ ቦዴ ሀፉረ ቁልቁሉዻን ንጩጰምቱ።”</char><verse eid="ACT 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6"/>እሳንስ ዮሙ ወልት ቀበመንት፣ “ያ ጎፍታ፣ አት ዬሮ ከነት እስራኤሊፍ ሞቱማ ንዴብፍታ?” ጄዸኒ እሰ ጋፈተን።<verse eid="ACT 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 1:7"/>እንሞ አከነ እሳኒን ጄዼ፤ <char style="wj">“ዬሮ ዮካን ጉያ አባን ኣንጎሳቲን ሙርቴሴ ቤኩን ሆጂኬሰን ምት።</char> <verse eid="ACT 1:7"/><verse number="8" style="v" sid="ACT 1:8"/><char style="wj">ዬሮ ሀፉር ቁልቁሉን እስንረ ቡኡት ገሩ ሁምነ ንአርገቱ፤ እስንስ ዬሩሳሌም ኬሰት፣ ይሁዳ ሁንዳፊ ሰማርያ ኬሰት፣ ሀመ ቀርቀረ ለፋትስ ዹገ ባቶተኮ ንታቱ።”</char><verse eid="ACT 1:8"/></para>
  <para style="s1">ዬሱስ ገረ ሰሚት ኦል ፉዸተሜ</para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 1:9"/>ኤርገ እን ዋን ከነ ዱበቴ ቦዴ ኡቱመ እሳን እላለኑ ኦል ፉዸተሜ፤ ዱሜስስ እጀሳኒ ዱራ እሰ ዾክሴ።<verse eid="ACT 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 1:10"/>ዬሮ እን ኦል በኣ ቱሬትስ፣ ኡቱመ እሳን ጥዬፈተኒ ገረ ሰሚ እላላ ጅረኑ ነሞትን ኡፈተ አዳዲ ኡፈተን ለመ እሳን ብረ ዸዻበተን። <verse eid="ACT 1:10"/><verse number="11" style="v" sid="ACT 1:11"/>አከነስ ጄዸኒን፤ “ያ ነሞተ ገሊላ፣ እስን ማሊፍ አስ ዸዻበተኒ ገረ ሰሚ እላልቱ? ዬሱስ እኑምት እስን ብራ ሰሚት ኦል ፉዸተሜ ኩን፣ አኩመ እስን ኡቱ እን ሰሚት ኦል በኡ አርግተን ከነ ዴብኤ ንዹፈ።”<verse eid="ACT 1:11"/></para>
  <para style="s1">ማትያስ እዶ ይሁዳ ፍለተሜ</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12"/>እሳንስ ቱሉ ጋረ ኤጄርሳ ጄዸሙራ ዬሩሳሌምት ዴብአን፤ ጋር ኩንስ ዬሩሳሌምራ ገረ ዴምሰ ጉያ ሰንበተ<note caller="+" style="f"><char style="fr" closed="false">1፥12 </char><char style="fq" closed="false">ዴምሰ ጉያ ሰንበተ </char><char style="ft" closed="false">– ዴምስ ጉያ ሰንበታ ገረ ኪሎ ሜትረ ቶኮት።</char></note> ቶኮ ፈጋተ። <verse eid="ACT 1:12"/><verse number="13" style="v" sid="ACT 1:13"/>እሳንስ ዮሙ ዬሩሳሌም ገአንት ኩታ ደርቢ ከን ኬሰ ጅራቻ ቱረን ሰነት ኦል በአን፤ እሳንስ፦</para>
  <para style="b" vid="ACT 1:13"/>
  <para style="li1" vid="ACT 1:13">ጴጥሮሲፊ ዮሀንስ፣ ያቆቢፊ እንድሪያስ፣</para>
  <para style="li1" vid="ACT 1:13">ፊልጶሲፊ ቶማስ፣</para>
  <para style="li1" vid="ACT 1:13">በርተሎሜዎሲፊ ማቴዎስ፣</para>
  <para style="li1" vid="ACT 1:13">ያቆብ እልመ እልፍዮስ፣ ስሞን እሰ “ህናፍትቸ” ጄዸሙፊ ይሁዳ እልመ ያቆብ ቱረን።<verse eid="ACT 1:13"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="14" style="v" sid="ACT 1:14"/>ሁንድሳኒስ ዱበርቶታፊ ማርያም ሃዸ ዬሱስ ወጅን፣ ኦቦሎተሳ ወጅንስ ኡቱ ገርገር ህንኩትን ያደ ቶኮን ከዸትናት ጀባቻ ቱረን።<verse eid="ACT 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 1:15"/>ግዱመ ሰነ ጴጥሮስ ከኤ አመንቶተ ገረ 120 ተአን ግዱ ዻበቴ። <verse eid="ACT 1:15"/><verse number="16" style="v" sid="ACT 1:16"/>አከነስ ጄዼ፤ “ያ ኦቦሎተ፣ ዱቢን ክታባ ከን ሀፉር ቁልቁሉን ዬሮ ዼራን ዱረ ዋኤ ይሁዳ እሰ ወረ ዬሱስን ቀበን ፍዴ ሰና አፋን ዳዊቲቲን ዱበቴ ሱን ራወተሙ ቀበ። <verse eid="ACT 1:16"/><verse number="17" style="v" sid="ACT 1:17"/>እንስ ምሴንሰኬኛፊ ነመ አከ ተጃጅለ ከነ ኬሰት ቆደ ቀባቱፍ ፍለተሜ ቱሬ።”<verse eid="ACT 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 1:18"/>ይሁዳን ሆሪ ሀምነ ሆጄቴ አርገቴ ሰናን ለፈ ብተቴ፤ እንስ መታን ኩፌ ቅጤ ለማንት ተርሰኤ፤ መርኡማንሳ ሁንድኑስ ኬሳ ጅጌ። <verse eid="ACT 1:18"/><verse number="19" style="v" sid="ACT 1:19"/>ነሞትን ዬሩሳሌም ኬሰ ጅራተን ሁንድኑስ ዋን ከነ ዸገአን፤ ለፈ ሰነስ አፋንሳኒቲን <char style="tl">አኬልዳማ</char> ጄዸኒ ዋመን። አኬልዳማ ጄቹን “ለፈ ዺጋ” ጄቹዸ።<verse eid="ACT 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 1:20"/>ጴጥሮስስ አከነ ጄዼ፤ “ክታበ ፋርፈትና ኬሰት አከነ ጄዸሜ በሬፈሜራቲ፦</para>
  <para style="q1" vid="ACT 1:20">“ ‘ቄኤንሳ ሃኦኑ፤</para>
  <para style="q2" vid="ACT 1:20">ነምን ኬሰ ጅራቱ ቶኮዩስ ህንሀፍን’<note caller="+" style="f"><char style="fr" closed="false">1፥20 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 69:25">ፋር 69፥25</ref></char></char></note></para>
  <para style="m" vid="ACT 1:20">አከሱመስ</para>
  <para style="q1" vid="ACT 1:20">“ ‘ኣንጎሳ ነምን ብራ ሃፉዸቱ።’<note caller="+" style="f"><char style="fr" closed="false">1፥20 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 109:8">ፋር 109፥8</ref></char></char></note><verse eid="ACT 1:20"/></para>
  <para style="m">
    <verse number="21" style="v" sid="ACT 1:21"/>ከናፍ ወረ ዬሮ ጎፍታ ዬሱስ ኑ ግዱ በኤ ገላ ቱሬ ሁንዱማ ኑ ወጅን ቱረን ኬሳ ነመ ቶኮ ፍለቹን በርባችሳዸ፤ <verse eid="ACT 1:21"/><verse number="22" style="v" sid="ACT 1:22"/>ነምን ፍለተሙ ኩን ነመ ጩጳ ዮሀንሲ ጀልቀቤ ሀመ ጋፈ ዬሱስ ኑ ብራ ሰሚት ኦል ፉዸተሜት ኑ ወጅን ቱሬ ተኡ ቀበ። ነሞተ ከኔን ኬሳ ቶኮ ኑ ወጅን ዹገ ባቱ ዱኣ ከኡ ዬሱስ ተኡ ቀባቲ።”<verse eid="ACT 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 1:23"/>ከናፍስ ነሞተ ለመ ዽኤሰን፤ እሳንስ ዮሴፍ እሰ በርሳባስ ጄዸሙ ከን ዮስጦስ ጄዸሜ ቤከሙ ቶኮፊ ማትያስ። <verse eid="ACT 1:23"/><verse number="24" style="v" sid="ACT 1:24"/>አከነስ ጄዸኒ ዋቀ ከዸተን፤ “ያ ጎፍታ ገራ ነመ ሁንዱማ ቤክቱ፣ አት ነሞተ ከኔን ለማን ኬሳ እሰ ከም አከ ፍለቴ ኑት አርግሲስ፤ <verse eid="ACT 1:24"/><verse number="25" style="v" sid="ACT 1:25"/>ኩንስ አከ እን ተጃጅላፊ ኤርገምቱማ ይሁዳን ዺሴ ገረ እዶ ኦፊሳት ገረገሌ ሰነ ፉዸቱፍ።” <verse eid="ACT 1:25"/><verse number="26" style="v" sid="ACT 1:26"/>እሳንስ እጣ ቡሰን፤ እጣን ሱንስ ማትያሲፍ በኤ። ከናፉ እን ኤርገሞተ ኩዸ ቶኮት ደበለሜ።<verse eid="ACT 1:26"/></para>
  <chapter eid="ACT 1"/>
  <chapter number="2" style="c" sid="ACT 2"/>
  <para style="s1">ዹፋቲ ሀፉረ ቁልቁሉ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1"/>ዬሮ ጉያን ጴንጤቆስጤ<note caller="+" style="f"><char style="fr" closed="false">2፥1 </char><char style="fq" closed="false">ጉያን ጴንጤቆስጤ </char><char style="ft" closed="false">– ጉያን ኩን ናኖ ጫምሳ 20 ተአ፤ እንስ ጉያ ይሁዶትን አያነ ሃማ ምዻኒ እት አያኔፈተን። ጴንጤቆስጤ ጄቹን “ሸንተመፋ” ጄቹዸ፤ ኩንስ ሰበቢ አያን ኩን ኤርገ አያን ፋሲካ ደርቤ ጉያ ሸንተማ ቦዴ አያኔፈሙፍ። አያን ኩን አያኖተ ወር እስራኤሊ ወጋ ኬሰት አያኔፈተን ጉርጉዶ ሰደን ኬሳ እሰ ቶኮ። እሳን ጉያ ከነት ኬነሙ ሴራ ያደተን፤ ዬሮ አያነ ከናት ዺሮትን ይሁዶታ ገረ ዬሩሳሌም ዸቁን በርባችሳ ቱሬ።</char></note> ገኤት፣ ሁንድሳኒ እዶ ቶኮት ወልት ቀበመኒ ቱረን። <verse eid="ACT 2:1"/><verse number="2" style="v" sid="ACT 2:2"/>አኩመ ተሳስ ሰገሌን አከ ቡቤ ጀባ ቡብሱ ቶኮ ሰሚራ ዹፌ መነ እሳን ኬሰ ተታኣ ቱረን ሰነ ሁንደ ጉቴ። <verse eid="ACT 2:2"/><verse number="3" style="v" sid="ACT 2:3"/>እሳንስ ዋን አከ አረበ እብዳ<note caller="+" style="f"><char style="fr" closed="false">2፥3 </char><char style="fq" closed="false">ዋን አከ አረበ እብዳ </char><char style="ft" closed="false">– እብድ መለቶ አርገሙ ዋቃት፤ ሙርቲ ዋቃ ወጅንስ ንዴመ።</char></note> ቶኮ እሳ ገርገር ቆደሜ ዹፌ ቶኮ ቶኮሳኒረ ቡቡኡ አርገን። <verse eid="ACT 2:3"/><verse number="4" style="v" sid="ACT 2:4"/>ሁንድሳኒስ ሀፉረ ቁልቁሉዻን ጉተመኒ አኩመ ሀፉር ሱን እሳን ደንዴስሴት አፋን ገረ ብራቲን ዱበቹ ጀልቀበን።<verse eid="ACT 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 2:5"/>ዬሮ ሰነ ይሁዶትን ዋቀ ሶዳተን ሰቦተ ሰሚ ጀለ ጅረን ሁንደ ኬሳ ዹፈኒ ዬሩሳሌም ኬሰ ጅራቻ ቱረን። <verse eid="ACT 2:5"/><verse number="6" style="v" sid="ACT 2:6"/>ዬሮ ሰገሌን ሱን ዸገአሜትስ ነሞትን ሄዱን ዋን ጄዸን ዸበኒ ወልት ቀበመን፤ ወር ሀፉራን ጉተመን ሱን አፋን ቶኮ ቶኮ ነሞተ ሰናቲን ዱበቻ ቱረኒቲ። <verse eid="ACT 2:6"/><verse number="7" style="v" sid="ACT 2:7"/>እሳንስ አከ መሌ ድንቅፈተኒ አከነ ጄዸን፤ “ነሞትን ዱዱበተን ኩኔን ሁንድ ወረ ገሊላት ምቲ? <verse eid="ACT 2:7"/><verse number="8" style="v" sid="ACT 2:8"/>ዮስ አከሚን ቶኮን ቶኮንኬኘ እሳኒ አፋኑመኬኘ ከን ኑ እት ዸለትኔ ዱበተን ዸጌኘሬ? <verse eid="ACT 2:8"/><verse number="9" style="v" sid="ACT 2:9"/>ኑ ወር ጰርቴ፣<note caller="+" style="f"><char style="fr" closed="false">2፥9 </char><char style="fq" closed="false">ጰርቴ </char><char style="ft" closed="false">– ጰርቴን ናኖ ብየ ሀርአ እራን ጄዸምቱ ኬሰት ገረ ካበ በኣት አርገምቱዸ።</char></note> ወር ሜዲፊ<note caller="+" style="f"><char style="fr" closed="false">2፥9 </char><char style="fq" closed="false">ሜዲፊ </char><char style="ft" closed="false">– ሜዲን ናኖ ብየ ሀርአ እራን ጄዸምቱ ኬሰት ገረ ካበ ዽኣት አርገምቱዸ።</char></note> ወር ኤላም፣<note caller="+" style="f"><char style="fr" closed="false">2፥9 </char><char style="fq" closed="false">ኤላም </char><char style="ft" closed="false">– ብየ ሀርአ እራን ጄዸምቱ ኬሰት ገረ ካበ ዽኣት አርገምት።</char></note> ጅራቶትን ሜሶጶታምያ፣<note caller="+" style="f"><char style="fr" closed="false">2፥9 </char><char style="fq" closed="false">ሜሶጶታምያ</char><char style="ft" closed="false">– ብየ ሀርአ እራቅ ጄዸምቱ ኬሰት፣ ለገ ጤግሮሲቲፊ ለገ ኤፍራጥስ ግዱት አርገምት።</char></note> ወር ይሁዳፊ<note caller="+" style="f"><char style="fr" closed="false">2፥9 </char><char style="fq" closed="false">ይሁዳ </char><char style="ft" closed="false">– ናኖን ኩን ዬሩሳሌምሌ ኦፍት ደበለተ።</char></note> ቀጰዶቅያ<note caller="+" style="f"><char style="fr" closed="false">2፥9 </char><char style="fq" closed="false">ቀጰዶቅያ</char><char style="ft" closed="false">– ለፈ አስያ ጥኖ ኬሰት ናኖ በኣት፣ ብየ ሀርአ ቱርክ ጄዸምቱ ኬሰት አርገምቱዸ።</char></note> አከሱመስ ጅራቶትን ጳንጦሲፊ<note caller="+" style="f"><char style="fr" closed="false">2፥9 </char><char style="fqa" closed="false">ጳንጦስ </char><char style="ft" closed="false">– ሞቱማ ገመ ክባቲን ቀርቀረ ገላነ ጉራቻ ገረ ጫሉ ቀበቱ።</char></note> አስያ፣<note caller="+" style="f"><char style="fr" closed="false">2፥9 </char><char style="fq" closed="false">አስያ</char><char style="ft" closed="false">– ብየ ሮማ ከን ዽአ ብየ ሀርአ ቱርክ ጄዸምቱት አርገምቱ።</char></note> <verse eid="ACT 2:9"/><verse number="10" style="v" sid="ACT 2:10"/>ፍርግያፊ<note caller="+" style="f"><char style="fr" closed="false">2፥10 </char><char style="fq" closed="false">ፍርግያ</char><char style="ft" closed="false">– ቡልቺሰ ግዱ ገለ ዽአ አስያ ጥኖ ኬሰት ካበ አጄኒቲፊ ለገ ሃሊሲ ግዱት አርገሙ።</char></note> ጰምፉልያ፣<note caller="+" style="f"><char style="fr" closed="false">2፥10 </char><char style="fq" closed="false">ጰምፉልያ</char><char style="ft" closed="false">– ብየ ሮማ ከን ክበ አስያ ጥኖት ብየ ሀርአ ቱርክ ጄዸምቱ ኬሰት አርገምቱ።</char></note> ግብጢፊ<note caller="+" style="f"><char style="fr" closed="false">2፥10 </char><char style="fq" closed="false">ግብጢፊ</char><char style="ft" closed="false">– ብየ ሮማ ከን ለፉመ ሀርአ ግብጥ ጄዸሙ ከነ ቱርቴ።</char></note> ኩታወን ብየ ሊብያ<note caller="+" style="f"><char style="fr" closed="false">2፥10 </char><char style="fq" closed="false">ሊብያ</char><char style="ft" closed="false">– ብየ ካበ አፍሪካት አርገምቱ ከን ገመ ዽኣቲን ግብጢት ኣንቱ።</char></note> ከኔን ናኖ ቀሬኔት<note caller="+" style="f"><char style="fr" closed="false">2፥10 </char><char style="fq" closed="false">ቀሬኔት </char><char style="ft" closed="false">– መጋላ ጉድቲ ብየ ሮማ ከን ቀሬንካቲፊ ኩታ ቡልቺሰ ሊብያ።</char></note> አርገመን፣ ኑ ወር ሮማዻ<note caller="+" style="f"><char style="fr" closed="false">2፥10 </char><char style="fq" closed="false">ሮማ </char><char style="ft" closed="false">– መጋላ ጉድቲ ቴሶ ቡልቺሰ ሞቱማ ሮማ።</char></note> ዹፍኔ፣ <verse eid="ACT 2:10"/><verse number="11" style="v" sid="ACT 2:11"/>ኑ ይሁዶትኒፊ ወር አመንቲ ይሁዶታ ፉዸትኔ ለማን፣ ነሞትን ቀርጤሲፊ አረቦትን ኩኖ ዮሙ ነሞትን ኩኔን አፋኑመኬኛን ድንቂ ዋቃ ዱበተን ዸጌኘ!” <verse eid="ACT 2:11"/><verse number="12" style="v" sid="ACT 2:12"/>ሁንድሳኒስ ድንቅፈተኒ፣ ዋን ጄዸንስ ወላለኒ፣ “ኩን ማል ጄቹዸ?” ጄዸኒ ወል ጋፈተን።<verse eid="ACT 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 2:13"/>ነሞትን ቶኮ ቶኮ ገሩ፣ “እሳን ዳዺ ወይኒ ባይኤ ዹገኒሩ” ጄዸኒ እሳንት ቆሰን።<verse eid="ACT 2:13"/></para>
  <para style="s1">ሃሳ ጴጥሮስ</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14"/>ጴጥሮስስ ኤርገሞተ ኩዸ ቶኮ ሰነ ወጅን ከኤ ዻበቴ፤ ሰገሌሳስ ኦል ፉዸቴ ቱተ ሰናን አከነ ጄዼ፤ “እስን ያ ነሞተ ይሁዳቲፊ ወር ዬሩሳሌም ኬሰ ጅራተን ሁንድ፣ ሜ ዋን ከነ ቤካ፤ ዋን አን እስንት ህሙ ከነ ሁበዻ ዸገኣ። <verse eid="ACT 2:14"/><verse number="15" style="v" sid="ACT 2:15"/>ዬሮን ኩን ዋን ጉያ ኬሳ ሰኣቲ ሰደፋ ተኤፍ ነሞትን ኩኔን አከ እስን ያደን ሰነ ህንመቾፍኔ። <verse eid="ACT 2:15"/><verse number="16" style="v" sid="ACT 2:16"/>ኩን ገሩ ዋን ዮኤል ራጅች ዱበቴዸ፤ እንስ አከነ ጄዸ፦<verse eid="ACT 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 2:17"/>“ ‘ዋቀዮ አከነ ጄዸ፤ በረ ዹማ ኬሰ፣</para>
  <para style="q2" vid="ACT 2:17">አን ሀፉረኮ ነመ ሁንደረት ነንዸንገላሰ፤</para>
  <para style="q1" vid="ACT 2:17">እልማኒፊ እንተለንኬሰን ራጂ ዱበቱ፤</para>
  <para style="q2" vid="ACT 2:17">ደርገጎትንኬሰን ሙልአተ አርጉ፤</para>
  <para style="q2" vid="ACT 2:17">ጃርሶሊንኬሰን አብጁ አብጆቱ።<verse eid="ACT 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 2:18"/>በረ ሰነ ኬሰ ገርቦተኮ ወረ ዺራፊ ዱበርቲረትሌ፣</para>
  <para style="q2" vid="ACT 2:18">ሀፉረኮ ነንዸንገላሰ፤</para>
  <para style="q2" vid="ACT 2:18">እሳንስ ራጂ ንዱበቱ።<verse eid="ACT 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ACT 2:19"/>አን ኦል ሰሚረት ድንቂ፣</para>
  <para style="q2" vid="ACT 2:19">ገድ ለፈረትስ መለቶ፣</para>
  <para style="q2" vid="ACT 2:19">ዺገ፣ እብዳፊ ሁሪ ኣራ ነንአርግሲሰ።<verse eid="ACT 2:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ACT 2:20"/>ኡቱ ጉያን ጎፍታ እን ጉድቺፊ <optbreak/> ኡልፍነ ቀቤስ ሱን ህንዹፍን ዱረ፣</para>
  <para style="q2" vid="ACT 2:20">አዱን ዱከነት ጌደረምት፤</para>
  <para style="q2" vid="ACT 2:20">ጅእሞ ዺገት ጌደረመ።<verse eid="ACT 2:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ACT 2:21"/>ነምን መቃ ጎፍታ ዋመቱ፣</para>
  <para style="q2" vid="ACT 2:21">ሁንድኑ ንፈየ።’<note caller="+" style="f"><char style="fr" closed="false">2፥21 </char><char style="ft" closed="false"><char style="xt"><ref loc="JOL 2:28-32">ዮኤ 2፥28‑32</ref></char></char></note><verse eid="ACT 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 2:22"/>“ያ ነሞተ እስራኤል፣ ዱቢ ከነ ዸገኣ፤ አኩመ እስኑ ቤክተን፣ ዬሱስ ነምን ናዝሬት ነመ ዋቅን ድንቂ፣ ራጂፊ መለቶ ከራሳቲን እስን ግዱት ሆጄቴን እስኒ ምርከኔሴዸ። <verse eid="ACT 2:22"/><verse number="23" style="v" sid="ACT 2:23"/>ነምቸ ከነ ዋቀቱ አኩመ ዱር ሙርቴሴፊ አኩመ ዱራን ዱርሴ ቤኩ ሰነት ደበርሴ እስንት ኬኔ። እስንስ ነሞተ ሀሞ ወጅን ቶኮ ታተኒ ፈንፍተኒ እሰ አጄፍተን። <verse eid="ACT 2:23"/><verse number="24" style="v" sid="ACT 2:24"/>ዋቅን ገሩ ዽጵነ ኬሳ እሰ ባሴ፣ ወረ ዱአን ኬሳ እሰ ካሴ፤ ዱት እሰረት ኣንጎ ቀባቹ ህንደንዴኜቲ። <verse eid="ACT 2:24"/><verse number="25" style="v" sid="ACT 2:25"/>ዳዊትስ አከነ ጄዼ ዋኤሳ ዱበቴ፦</para>
  <para style="q1" vid="ACT 2:25">“ ‘አን ዬሮ ሁንደ ጎፍታ ኦፍ ዱረት ነንአርገ ቱሬ፤</para>
  <para style="q2" vid="ACT 2:25">ዋን እን ምርገኮ ጅሩፍ፣ አን ህንራፈሙ።<verse eid="ACT 2:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 2:26"/>ከናፍ ገራንኮ ንገመደ፤ አረብንኮስ ንእልልቸ፤</para>
  <para style="q2" vid="ACT 2:26">ፎንኮስ አብዲዻን ጅራተ።<verse eid="ACT 2:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 2:27"/>አት ሲኦል ኬሰት ነ ህንዺፍቱቲ፤</para>
  <para style="q2" vid="ACT 2:27">ቁልቁልችኬ አከ ቶርቶሩ ህንጎቱ።<verse eid="ACT 2:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ACT 2:28"/>ከራ ጅሬኛ ነ በርሲፍቴርተ፤</para>
  <para style="q2" vid="ACT 2:28">ፉለኬ ዱረትስ ገመቹዻን ነ ጉተ።’<note caller="+" style="f"><char style="fr" closed="false">2፥28 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 16:8-11">ፋር 16፥8‑11</ref></char></char></note><verse eid="ACT 2:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 2:29"/>“ያ ኦቦሎተ፣ አከ ዳዊት ሀንገፍን አቦቲ ዱሪ ሱን ዱኤ አዋለሜ፣ አዋልሳስ ሀመ ሀርኣት አከ አሱመ ጅሩ አን እጀ ጀባዼ እስንት ህሙ ነንደንደአ። <verse eid="ACT 2:29"/><verse number="30" style="v" sid="ACT 2:30"/>እንስ ዋን ራጂ ቱሬፍ አከ ዋቅን ሰኚሳ ኬሳ ነመ ቶኮ ቴሶሳረ ቴስሱፍ አከ ከከቴ ዋዳ ገሌፊ ቱሬ ቤኬ። <verse eid="ACT 2:30"/><verse number="31" style="v" sid="ACT 2:31"/>እንስ ዋኤ ዱኣ ከኡ ክርስቶስ፣ አከ ሉቡንሳ ሲኦል ኬሰት ህንሀፍን፣ ዮካን ፎንሳስ አከ ህንቶርቶርን ዱራን ዱርሴ አርጌ ዱበቴ። <verse eid="ACT 2:31"/><verse number="32" style="v" sid="ACT 2:32"/>ዬሱሱመ ከነ ዋቅን ዱኣ ካሴረ፤ ኑ ሁንድኑ ዹገ ባቶተ ዋን ከናት። <verse eid="ACT 2:32"/><verse number="33" style="v" sid="ACT 2:33"/>ከናፍ እን ገረ ምርገ ዋቃት ኦል ኦል ጄዼ፣ አብዲ ሀፉረ ቁልቁሉ አባ ብራ ፉዼ ዋን እስን አመ አርግተኒፊ ዸጌሰን ከነ ዸንገላሴ። <verse eid="ACT 2:33"/><verse number="34" style="v" sid="ACT 2:34"/>ዳዊት ገረ ሰሚት ኦል ህንባኔቲ፤ እን መታንሳ ገሩ አከነ ጄዸ፦</para>
  <para style="q1" vid="ACT 2:34">“ ‘ጎፍታን ጎፍታኮቲን አከነ ጄዼ፤</para>
  <para style="q2" vid="ACT 2:34">“ገረ ምርገኮ ታእ፤<verse eid="ACT 2:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="ACT 2:35"/>ሀመ አን ዲኖተኬ</para>
  <para style="q2" vid="ACT 2:35">ኤጄተ ሚለኬቲ ሲፍ ጎዹት።” ’<note caller="+" style="f"><char style="fr" closed="false">2፥35 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 110:1">ፋር 110፥1</ref></char></char></note><verse eid="ACT 2:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 2:36"/>“ከናፉ ዬሱሱመ እስን ፈንፍተን ከነ አከ ዋቅን ጎፍታፊ ክርስቶስ እሰ ጎዼ መን እስራኤል ሁንድ ዹጉማን ሃቤኩ።”<verse eid="ACT 2:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 2:37"/>ነሞትን ሱንስ ዮሙ ዋን ከነ ዸገአንት፣ ገራንሳኒ ራፈሜ ጴጥሮሲፊ ኤርገሞተ ካኒን፣ “ያ ኦቦሎተ፣ ዮስ ማል ሃጎኑ?” ጄዸን።<verse eid="ACT 2:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 2:38"/>ጴጥሮስስ አከነ ጄዼ ዴብሴ፤ “ቶኮን ቶኮንኬሰን ቀልቢ ጅጂረዻ፤ ዺፈመ ጩቡኬሰኒቲፍስ መቃ ዬሱስ ክርስቶሲቲን ጩጰማ፤ ኬና ሀፉረ ቁልቁሉስ ንአርገቱ። <verse eid="ACT 2:38"/><verse number="39" style="v" sid="ACT 2:39"/>አብዲን ኩንስ እስኒፊ እጆሌኬሰኒፍ፣ አከሱመስ ወረ ዋቅን ጎፍታንኬኘ ኦፍት ዋሙ ከኔን ፈጎ ጅረን ሁንዳፍ ኬነሜ።”<verse eid="ACT 2:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 2:40"/>እንስ ዱቢ ብራ ባይኤዻን ዹጋ በኤ፣ “ዸሎተ ጀላ ከነ ዱራ ኦፍ ኦልቻ” ጄዼ እሳን ጎርሴ። <verse eid="ACT 2:40"/><verse number="41" style="v" sid="ACT 2:41"/>ወር ዱቢሳ ፉዸተንስ ንጩጰመን፤ ጋፈስ ነመ ገረ ኩመ ሰዲቱ እሳንት ደበለሜ።<verse eid="ACT 2:41"/></para>
  <para style="s1">ቶኩማ አመንቶታ</para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 2:42"/>እሳንስ በርሲሰ ኤርገሞታት፣ ጅሬኘ ቶኩማት፣ ቡዴነ ጨጨብሱት፣ ዋቀ ከዸቹትስ ንጀባተን። <verse eid="ACT 2:42"/><verse number="43" style="v" sid="ACT 2:43"/>ነምን ሁንድኑስ ሶዳን ጉተሜ፤ ድንቂፊ መለቶን ባይኤን ኤርገሞታን ሆጄተሜ። <verse eid="ACT 2:43"/><verse number="44" style="v" sid="ACT 2:44"/>አመንቶትን ሁንድኑስ ወጅን ቱረን፤ ዋን ሁንደስ ወሉማን ቀቡ ቱረን። <verse eid="ACT 2:44"/><verse number="45" style="v" sid="ACT 2:45"/>ቀቤኘሳኒቲፊ ምአሳኒስ ጉርጉረኒ ነመ ረክነ ቀቡ ከሚፍዩ ቆዳ ቱረን። <verse eid="ACT 2:45"/><verse number="46" style="v" sid="ACT 2:46"/>እሳንስ ጉዩመ ጉያን መነ ቁልቁሉማት ወል ገኣ ቱረን፤ መነ ቶኮ ቶኮሳኒትስ ቡዴነ ኩኩተኒ፣ ገመቹፊ ገራ ቁልቁሉዻን ወጅን ኛቻ ቱረን። <verse eid="ACT 2:46"/><verse number="47" style="v" sid="ACT 2:47"/>ዋቀስ ገለቴፈቻ ቱረን። ነሞተ ሁንደ ዱረትስ ኡልፍነ ቀቡ ቱረን። ጎፍታንስ ጉዩመ ጉያን ወረ ፈየን ወልዳሳኒት ደበላ ቱሬ።<verse eid="ACT 2:47"/></para>
  <chapter eid="ACT 2"/>
  <chapter number="3" style="c" sid="ACT 3"/>
  <para style="s1">ጴጥሮስ ነምቸ ናፈ ቶኮ ፈይሴ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1"/>ጋፍ ቶኮ ጴጥሮሲፊ ዮሀንስ ዬሮ ከዸትናት ጄቹንስ ዋሬ ቦዴ ሰኣቲ ሰገልት መነ ቁልቁሉማት ኦል በኣ ቱረን። <verse eid="ACT 3:1"/><verse number="2" style="v" sid="ACT 3:2"/>ነሞትንስ አከ እን ወረ መነ ቁልቁሉማ ሴነን ዋ ከዸቱፍ ጄዸኒ ነምቸ ዸሎቱመሳቲ ጀልቀቤ ናፈ ቱሬ ቶኮ ጉዩመ ጉያን ባተኒ ገረ ከረ መነ ቁልቁሉማ ከን “ሚዸጋ” ጄዸሙት ጌሱ ቱረን። <verse eid="ACT 3:2"/><verse number="3" style="v" sid="ACT 3:3"/>እንስ ኡቱ ጴጥሮሲፊ ዮሀንስ መነ ቁልቁሉማ ሴነኑ አርጌ ሆሪ እሳን ከዸቴ። <verse eid="ACT 3:3"/><verse number="4" style="v" sid="ACT 3:4"/>ጴጥሮስስ ዮሀንስ ወጅን ነምቸ ሁበቴ እላሌ፣ “ሜ ኑ እላል” ጄዼን። <verse eid="ACT 3:4"/><verse number="5" style="v" sid="ACT 3:5"/>ነምችስ ዋ እሳንራ አርገቹ አብደቴ ሁበቴ እሳን እላሌ።<verse eid="ACT 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 3:6"/>ጴጥሮስስ፣ “አን ሜቲ ዮካን ወርቄ ህንቀቡ፤ አን ገሩ ዋን ቀቡ ሲፍን ኬነ። መቃ ዬሱስ ክርስቶስ እሰ ናዝሬቲን ኦል ከኢ ዴም!” ጄዼ። <verse eid="ACT 3:6"/><verse number="7" style="v" sid="ACT 3:7"/>ጴጥሮስስ ሀርከሳ ምርጋ ቀቤ ኦል እሰ ካሴ፤ ዬሩመ ሰነ ሚላፊ ጉሉቢንሳ ንጀባቴ። <verse eid="ACT 3:7"/><verse number="8" style="v" sid="ACT 3:8"/>እንስ ኡታሌ ከኤ ሚላን ዴሙ ጀልቀቤ፤ ዴማ፣ ኡታላ፣ ዋቀስ ገለቴፈቻ እሳን ወጅን መነ ቁልቁሉማ ሴኔ። <verse eid="ACT 3:8"/><verse number="9" style="v" sid="ACT 3:9"/>ነሞትን ሁንድኑ ዮሙ ዴሙሳቲፊ ዋቀ ገለቴፈቹሳ አርገንት፣ <verse eid="ACT 3:9"/><verse number="10" style="v" sid="ACT 3:10"/>አከ እን ነምቸ ከረ መነ ቁልቁሉማ ከን፣ “ሚዸጋ” ጄዸሙ ሰነ ብረ ታኤ ከዸቻ ቱሬ ሰነ ተኤ ሁበተን፤ እሳንስ ዋን እሳፍ ተኤ ሰናፍ አከ መሌ ራጄፈተን፤ ንድንቅፈተንስ።<verse eid="ACT 3:10"/></para>
  <para style="s1">ዱቢ ጴጥሮስ ዱበቴ</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 3:11"/>ነሞትን ሁንድኑ ዬሮ ነምች ፈዬ ሱን ጴጥሮሲፊ ዮሀንስ ብራ ዴብኡ ድዴት ድንቅሲፈተኒ ኡቱ እሳን እዶ ገርዳፎ ሶሎሞን ጄዸሙ ኬሰ ጅረኑ ፊጋ እሳንት ዹፈን። <verse eid="ACT 3:11"/><verse number="12" style="v" sid="ACT 3:12"/>ጴጥሮስስ ዮሙ ዋን ከነ አርጌት አከነ እሳኒን ጄዼ፤ “ያ ነሞተ እስራኤል ወን ኩን ማሊፍ እስን ድንቀ? አከ ዋን ኑ ሁምነ ዮካን ቁልቁሉማ መታኬኛቲን አከ ነምች ኩን ዴሙ ጎኔት ማሊፍ እጀ ኑት በባፍቱ? <verse eid="ACT 3:12"/><verse number="13" style="v" sid="ACT 3:13"/>ዋቅን አቦቲኬኛ፣ ዋቅን አብረሃም፣ ዋቅን ይስሃቂፊ ዋቅን ያቆብ ተጃጅላሳ ዬሱስን ከበጄረ። እስን ገሩ አከ እን አጄፈሙፍ ደበርስተኒ እሰ ኬንተን፤ ጲላጦስ ገድ እሰ ዺሱ ሙርቴሱዩ እስን ፉሉመ ጲላጦስ ዱረት እሰ ሃልተን። <verse eid="ACT 3:13"/><verse number="14" style="v" sid="ACT 3:14"/>እስንስ እሰ ቁልቁሉፊ ቀጄላ ሰነ ገንተኒ አከ ነምች ነመ አጄሴ ሱን ገድ እስኒ ዺፈሙ ከዸተን። <verse eid="ACT 3:14"/><verse number="15" style="v" sid="ACT 3:15"/>እስን ቡርቃ ጅሬኛ አጄፍተን፤ ዋቅን ገሩ ወረ ዱአን ኬሳ እሰ ካሴ፤ ኑስ ዹገ ባቶተ ዋን ከናት። <verse eid="ACT 3:15"/><verse number="16" style="v" sid="ACT 3:16"/>ነምች እስን አርግተኒፊ እሰ ቤክተን ኩን መቃ ዬሱስት አመኑዻን ጀባቴ። መቃ ዬሱሲፊ አመንቲ ከራሳቲን ዹፉቱ አኩመ እስን ሁንድ አርግተን ከነ ነምቸ ከናፍ ፈያ ጉቱ ኬኔ።<verse eid="ACT 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 3:17"/>“አመስ ያ ኦቦሎተ፣ አከ እስንስ ኡቱ ህንቤክን አኩመ ቡልችቶትንኬሰን ጎቻ ቱረን ሰነ ጎተን አን ነንቤከ። <verse eid="ACT 3:17"/><verse number="18" style="v" sid="ACT 3:18"/>ዋቅን ገሩ ዋን አከ ክርስቶሰ ዽጰቹፍ ጅሩ ዱራን ዱርሴ ከራ ራጆተ ሁንዳቲን ዱበቴ ሰነ አከናን ራወቴ። <verse eid="ACT 3:18"/><verse number="19" style="v" sid="ACT 3:19"/>ከናፍ አከ ጩቡንኬሰን ሀቀሙፊ አከ በር ሃሮማ ጎፍታ ብራ ዹፉፍ ቀልቢ ጅጂረዻ ገረ ዋቃት ዴብኣ፤ <verse eid="ACT 3:19"/><verse number="20" style="v" sid="ACT 3:20"/>ኩንስ አከ እን ክርስቶስ እስኒፍ ፍለተሜ ሰነ ጄቹንስ ዬሱስን ኤርጉፍ። <verse eid="ACT 3:20"/><verse number="21" style="v" sid="ACT 3:21"/>እንስ ሀመ ዬሮን ዋቅን እት ዋን ሁንደ እዶት ዴብሱ ሱን ገኡት ሰሚረ ቱሩ ቀበ፤ ዋን ከነስ ዋቅን በረ ዼራዻን ዱረ ከራ ራጆተሳ ቁልቁሎታቲን ዱበቴ ቱሬ። <verse eid="ACT 3:21"/><verse number="22" style="v" sid="ACT 3:22"/>ሙሴን አከነ ጄዼራቲ፤ ‘ዋቅንኬሰን ጎፍታን ሰቡመኬሰን ኬሳ ራጂ አከኮቲ ቶኮ እስኒ ካሰ፤ እስንስ ዋን እን እስንት ህሙ ሁንደ ዸገኣ። <verse eid="ACT 3:22"/><verse number="23" style="v" sid="ACT 3:23"/>ነምን ራጂ ሰነ ህንዸጌኜ ከምዩ ሰበሳ ኬሳ ባፈሜ ንበሌፈመ።’<note caller="+" style="f"><char style="fr" closed="false">3፥23 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 18:15">ኬዴ 18፥15</ref>፣<ref loc="DEU 18:18">18</ref>፣<ref loc="DEU 18:19">19</ref></char></char></note><verse eid="ACT 3:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 3:24"/>“ሳሙኤልራ ጀልቀቤ ራጆትን እሰ ዱባን ዹፈኒ ዋ ዱበተን ሁንድ ዱራን ዱርሰኒ ዋኤ ዬሮ ሰና ለብሰኒሩ። <verse eid="ACT 3:24"/><verse number="25" style="v" sid="ACT 3:25"/>እስንሞ እልማን ራጆታቲፊ እልማን ከኩ ዋቅን አቦቲኬሰን ወጅን ሴኔ ሰናት። እንስ አብረሃሚን፣ ‘ሰብን ለፈራ ሁንድ ከራ ሰኚኬቲቲን ንኤብፈመ’<note caller="+" style="f"><char style="fr" closed="false">3፥25 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 22:18">ኡመ 22፥18</ref>፤ <ref loc="GEN 26:4">26፥4</ref></char></char></note> ጄዼ። <verse eid="ACT 3:25"/><verse number="26" style="v" sid="ACT 3:26"/>ዋቅን ዬሮ እልመሳ ዱኣ ካሴት፣ ቶኮ ቶኮኬሰን ሀምነራ እስን ዴብሱዻን እስን ኤብሱፍ ጄዼ ጀልቀበት ገረኬሰንት እሰ ኤርጌ።”<verse eid="ACT 3:26"/></para>
  <chapter eid="ACT 3"/>
  <chapter number="4" style="c" sid="ACT 4"/>
  <para style="s1">ጴጥሮሲፊ ዮሀንስ ያኢ ይሁዶታ ዱረት</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1"/>ኡቱ ጴጥሮሲፊ ዮሀንስ ነሞተት ዱበቻ ጅረኑ፣ ሉቦትን፣ አጀጃን ኤግዶተ መነ ቁልቁሉማቲፊ ሰዱቆትን እሳንት ዹፈን። <verse eid="ACT 4:1"/><verse number="2" style="v" sid="ACT 4:2"/>ሰበቢ ኤርገሞትን ሱን ነሞተ በርሲሰኒ ዱኣ ከኡ ከራ ዬሱሲቲን አርገሙ ለብሰኒፍስ አከ መሌ ኣረን። <verse eid="ACT 4:2"/><verse number="3" style="v" sid="ACT 4:3"/>እሳንስ ጴጥሮሲፊ ዮሀንስን ቀበኒ ሀመ ጉያ እት ኣኑት መነ ህዻት እሳን ገልቸን፤ ለፍት ገልገሎፍቴ ቱርቴቲ። <verse eid="ACT 4:3"/><verse number="4" style="v" sid="ACT 4:4"/>ወረ ዱብቸ ዸገአን ኬሳስ ባይኤቱ አመኔ፤ ባይእን ወረ አመኔስ ገረ ኩመ ሸኒት ኦል ከኤ።<verse eid="ACT 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 4:5"/>ጉያ እት ኣኑትስ ቡልችቶትን፣ ማንጉዶትኒፊ በርሲስቶትን ሴራ ዬሩሳሌምት ወል ገአን። <verse eid="ACT 4:5"/><verse number="6" style="v" sid="ACT 4:6"/>ሃናን ሉብች ኦል ኣናን፣ እሰ ወጅንሞ ቀያፋን፣ ዮሀንስ፣ እስክንድሮሲፊ ነሞትን ማቲ ሉብቸ ኦል ኣና ተአን ካን ሁንድ አች ቱረን። <verse eid="ACT 4:6"/><verse number="7" style="v" sid="ACT 4:7"/>እሳንስ ጴጥሮሲፊ ዮሀንስን ግዱሳኒ ዻበኒ፣ “እስን ሁምነ ማሊቲን ዮካን መቃ ኤኙቲን ዋን ከነ ጎተን?” ጄዸኒ ጋፈቹ ጀልቀበን።<verse eid="ACT 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 4:8"/>ጴጥሮስስ ሀፉረ ቁልቁሉዻን ጉተሜ አከነ እሳኒን ጄዼ፤ “እስን ያ ቡልችቶታፊ ማንጉዶተ ኡመታ! <verse eid="ACT 4:8"/><verse number="9" style="v" sid="ACT 4:9"/>ሀርአ ዋኤ ዋን ጋሪ ነመ ናፈ ቶኮፍ ጎዸሜቲፊ አከ እን እት ፈይፈሜ ዮ ኑ ጋፈተን፣ <verse eid="ACT 4:9"/><verse number="10" style="v" sid="ACT 4:10"/>እስኒፊ ነሞትን እስራኤል ሁንድኑ ዋን ከነ ቤካ፤ ነምች ኩን መቃ ዬሱስ ክርስቶስ ነመ ናዝሬት ከን እስን ፈንፍተኒ ዋቅንሞ ወረ ዱአን ኬሳ እሰ ካሴ ሰናቲን ፈዬ ፉለኬሰን ዱረ ዻበተ። <verse eid="ACT 4:10"/><verse number="11" style="v" sid="ACT 4:11"/>ዬሱስስ፣</para>
  <para style="q1" vid="ACT 4:11">“ ‘ዸጋ እስን እጃርቶትን ቱፈተን</para>
  <para style="q2" vid="ACT 4:11">ከን ዸጋ ጎሌ ተኤዸ።’<note caller="+" style="f"><char style="fr" closed="false">4፥11 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 118:22">ፋር 118፥22</ref></char></char></note><verse eid="ACT 4:11"/></para>
  <para style="m">
    <verse number="12" style="v" sid="ACT 4:12"/>ፈይን ነመ ብራ ቶኮራሌ ህንአርገሙ፤ መቃን ኑ እቲን ፈይፈምኑ ከን ሰሚ ገድት ነሞታፍ ኬነሜ ብራ ቶኮዩ ህንጅሩቲ።”<verse eid="ACT 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 4:13"/>ነሞትን ሱንስ ዮሙ እጀ ጀብነ ጴጥሮሲፊ ዮሀንስ አርገኒ አከ እሳን ወረ በሩምሰ ህንቀብኔፊ ወረ ህንቤከምኔ ተአን ሁበተንት ንድንቅሲፈተን፤ አከ እሳን ዬሱስ ወጅን ቱረንስ ንቀልቤፈተን። <verse eid="ACT 4:13"/><verse number="14" style="v" sid="ACT 4:14"/>ገሩ ነምቸ ፈይፈሜ ሰነ እሳ እሳኑመ ወጅን አች ዻበቱ አርገኒ ዋን ዱበተን ዸበን። <verse eid="ACT 4:14"/><verse number="15" style="v" sid="ACT 4:15"/>ከናፍ አከ እሳን ወልዳ ኬሳ ገድ በአን አጀጀኒ ወጅን መርአቹ ጀልቀበን። <verse eid="ACT 4:15"/><verse number="16" style="v" sid="ACT 4:16"/>አከነስ ጄዸን፤ “ጀረ ከነ ማል ሃጎኑ? አከ እሳን ድንቂ ጉዳ ሆጄተን ነምን ዬሩሳሌም ኬሰ ጅራቱ ሁንድ ንቤከ፤ ኑስ ዋን ከነ ዋከቹ ህንደንዴኙ። <verse eid="ACT 4:16"/><verse number="17" style="v" sid="ACT 4:17"/>ገሩ አከ ወን ኩን ሀመነ ጫላ ኡመተ ኬሰ ህንበበልአትኔፍ ኑ አከ ጀር ኩን ስአች መቃ ከናን ነመ ቶኮትሌ ህንዱበትኔ እሳን ኦፍ ኤገቺሱ ቀብነ።”<verse eid="ACT 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 4:18"/>እሳንስ ጀረ ዋመኒ አከ እሳን ጎንኩማ መቃ ዬሱሲቲን ህንዱበትኔ ዮካን ህንበርሲፍኔ እሳን አጀጀን። <verse eid="ACT 4:18"/><verse number="19" style="v" sid="ACT 4:19"/>ጴጥሮሲፊ ዮሀንስ ገሩ ዴብሰኒ አከነ ጄዸን፤ “ቆደ ዋቃ እስኒፍ አጀጀሙን ፉለ ዋቃ ዱረት አከ ቀጄላ ተኤፊ አከ ህንተእን ሜ እስኑ እላላ! <verse eid="ACT 4:19"/><verse number="20" style="v" sid="ACT 4:20"/>ኑ ዋን አርግኔፊ ዋን ዸጌኜ ዱበቹ ዺሱ ህንደንዴኙቲ።”<verse eid="ACT 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 4:21"/>እሳንስ ኤርገ እቱመ ፉፈኒ ዶርስሰኒ ቦዴ ጀረ ገድ ዺሰን። ዋን ነሞትን ሰበቢ ዋን ሆጄተሜ ሰናቲፍ ዋቀ ገለቴፈቻ ቱረኒፍስ አከ እት ጀረ አደበን ሙርቴፈቹ ህንደንዴኜ። <verse eid="ACT 4:21"/><verse number="22" style="v" sid="ACT 4:22"/>ኡሙሪን ነምቸ ከራ ድንቂቲን ፈይፈሜ ሰና ወጋ አፉርተማ ኦል ቱሬቲ።<verse eid="ACT 4:22"/></para>
  <para style="s1">ከዸትና አመንቶታ</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23"/>ጴጥሮሲፊ ዮሀንስ ዬሮ ገድ ዺፈመንት ገረ ሰበሳኒ ዸቀኒ ዋን ሉቦትን ሀንገፎትኒፊ ማንጉዶትን ጄዸኒን ሁንዱማ እሳንት ህመን። <verse eid="ACT 4:23"/><verse number="24" style="v" sid="ACT 4:24"/>እሳንስ ዮሙ ዋን ከነ ዸገአንት ከዸትናዻን ሰገሌሳኒ ቶኩማን ዋቀት ኦል ፉዸኒ አከነ ጄዸን፤ “ያ ጎፍታ ዋን ሁንዳ ኦሊ፣ ስቱ ሰሚ፣ ለፈ፣ ገላናፊ ዋን እሳን ኬሰ ጅሩ ሁንደ ኡሜ። <verse eid="ACT 4:24"/><verse number="25" style="v" sid="ACT 4:25"/>አት ሀፉረ ቁልቁሉዻን ከራ አፋን ተጃጅላኬ አባኬኘ ዳዊቲቲን አከነ ጄቴ ዱበቴርተ፤</para>
  <para style="q1" vid="ACT 4:25">“ ‘ነሞትን ማሊፍ አከኑማን መርአቱ?</para>
  <para style="q2" vid="ACT 4:25">ሰቦትንስ ማሊፍ ዋን ፋይዳ ህንቀብኔ ያዱ?<verse eid="ACT 4:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 4:26"/>ሞቶትን ለፋ ከአኒ፣</para>
  <para style="q2" vid="ACT 4:26">ቡልችቶትንስ ጎፍትቻፊ</para>
  <para style="q1" vid="ACT 4:26">ድበማሳቲን ሞርሙፍ</para>
  <para style="q2" vid="ACT 4:26">ወልት ቀበመን።’<note caller="+" style="f"><char style="fr" closed="false">4፥26 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 2:1">ፋር 2፥1</ref>፣<ref loc="PSA 2:2">2</ref></char></char></note><verse eid="ACT 4:26"/></para>
  <para style="m">
    <verse number="27" style="v" sid="ACT 4:27"/>ዹጉማን ሄሮድሲፊ ጶንጦስ ጲላጦስ ነሞተ ኦርማቲፊ ኡመተ እስራኤል ወጅን ሆጄታኬ እሰ ቁልቁሉ፣ ዬሱስ እሰ አት ድብዴት መርአቹፍ ጄዸኒ መጋላ ከነ ኬሰት ወልት ቀበመን። <verse eid="ACT 4:27"/><verse number="28" style="v" sid="ACT 4:28"/>እሳንስ ዋኑመ ሁምኒፊ ፌዺንኬ አከ ወን ኩን ተኡፍ ዱራን ዱርሰኒ ሙርቴሰን ሰነ ሆጄተን። <verse eid="ACT 4:28"/><verse number="29" style="v" sid="ACT 4:29"/>ያ ጎፍታ፣ ኤጋ ዶርስሰሳኒ እላሊቲ አከ ገርቦትንኬ እጀ ጀብናን ዱቢኬ ዱበተኒፍ ደንዴቲ ኬኒፍ። <verse eid="ACT 4:29"/><verse number="30" style="v" sid="ACT 4:30"/>ነመ ፈይሱፊ መቃ ተጃጅላኬ ቁልቁልቻ፣ መቃ ዬሱሲቲን መለቶፊ ድንቂ ሆጄቹፍ ሀርከኬ ድሪርፈዹ።”<verse eid="ACT 4:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 4:31"/>ኤርገ እሳን ዋቀ ከዸተኒ ቦዴ ለፍት እሳን እት ወል ገአን ሱን ንሶሶቾቴ፤ እሳን ሁንድኑስ ሀፉረ ቁልቁሉዻን ጉተመኒ እጀ ጀብናን ዱቢ ዋቃ ዱበተን።<verse eid="ACT 4:31"/></para>
  <para style="s1">ቀቤኝ አመንቶታ ከን ሁንደሳኒ ተኤ</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 4:32"/>አመንቶትን ሁንድኑስ ገራ ቶኮፊ ያደ ቶኮ ቀቡ ቱረን፤ ዋን ቀበን ሁንደስ ወሉማን ቆደቻ ቱረን መሌ ነምን ቶኮዩ አከ ዋን ቀቤኝ እን ቀቡ ከምዩ ከን መታሳ ቆፈ ተኤት ህንለኮፍኔ። <verse eid="ACT 4:32"/><verse number="33" style="v" sid="ACT 4:33"/>ኤርገሞትንስ ዱኣ ከኡ ጎፍታ ዬሱስ ሁምነ ጉዳዻን ዹጋ በኣ ቱረን፤ አያን ጉዳንስ ሁንዱመሳኒረ ቱሬ። <verse eid="ACT 4:33"/><verse number="34" style="v" sid="ACT 4:34"/>ረከታን ቶኮዩ እሳን ግዱ ህንቱሬ። ወር ለፈ ዮካን መነ ቀበን ሁንድኑ ጉርጉረኒ ማለቀ ፍደኒ፣ <verse eid="ACT 4:34"/><verse number="35" style="v" sid="ACT 4:35"/>ሚለ ኤርገሞታ ብረ ካኡ ቱረን፤ ማለቅን ሱንስ ነመ ረክነ ቀቡ ከሚፍዩ ንቆደመ ቱሬ።<verse eid="ACT 4:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 4:36"/>ዮሴፍ ነምን ጎሰ ሌዊ ከን ቆጵሮስት ዸለቴ፣ እን ኤርገሞትን በርናባስ ጄዸኒን ቶኮስ አች ቱሬ። በርናባስ ጄቹን እልመ ጀጀብና ጄቹዸ። <verse eid="ACT 4:36"/><verse number="37" style="v" sid="ACT 4:37"/>እንስ ለፈ ቆቲሳ ኦፊሳ ጉርጉሬ ሆሪሳ ፍዴ ሚለ ኤርገሞታ ብረ ካኤ።<verse eid="ACT 4:37"/></para>
  <chapter eid="ACT 4"/>
  <chapter number="5" style="c" sid="ACT 5"/>
  <para style="s1">ሀናንያፊ ሰፊራ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 5:1"/>ነምን አናንያ ጄዸሙ ቶኮ ኒቲሳ ሰፊራ ወጅን ለፈ ጉርጉረቴ። <verse eid="ACT 5:1"/><verse number="2" style="v" sid="ACT 5:2"/>እንስ ኡቱመ ኒቲንሳ ቤክቱ ሆሪ ሰነራ ገር ቶኮ ኦፊሳቲ ሀምብፈቴ ከን ሀፌሞ ጌሴ ሚለ ኤርገሞታ ብረ ካኤ።<verse eid="ACT 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 5:3"/>ጴጥሮስ ገሩ አከነ ጄዼ፤ “ያ አናንያ፣ አከ አት ሀፉረ ቁልቁሉ ሶብዴ ሆሪ ለፈ ጉርጉረቴ አርገቴራ ገር ቶኮ ሀምብፍቱፍ ሴጠን ማሊፍ አከስ ገራኬ ጉቴ? <verse eid="ACT 5:3"/><verse number="4" style="v" sid="ACT 5:4"/>ለፍት ሱን ኡቱ ህንጉርጉረምንዩ ከንኬ ቱሬ ምቲ? ኤርገ ጉርጉረሜ ቦዴስ ሆሪን ሱን ሀርኩመኬ ህንቱሬ? ዮስ አከ አት ዋን አከሲ ጎቱ ማልቱ ስ ያችሴ? አት ዋቀ ሶብዴ መሌ ነመ ህንሶብኔ።”<verse eid="ACT 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 5:5"/>አናንያስስ ዮሙ ዋን ከነ ዸገኤት ኩፌ ዱኤ፤ ወር ዋን ከነ ዸገአን ሁንድኑስ ሶዳ ጉዳን ቀበመን። <verse eid="ACT 5:5"/><verse number="6" style="v" sid="ACT 5:6"/>ደርገጎትንስ ዹፈኒ፣ ሬፈሳ ከፈነን፤ ገድ ባሰኒስ እሰ አዋለን።<verse eid="ACT 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 5:7"/>ገረ ሰኣቲ ሰዲ ቦዴ ኒቲንሳ ኡቱ ዋን ተኤ ህንቤክን ዹፍቴ ኦል ሴንቴ። <verse eid="ACT 5:7"/><verse number="8" style="v" sid="ACT 5:8"/>ጴጥሮስስ፣ “ገቲን እስን ሀናንያ ወጅን ለፈ ጉርጉረተን ሰነራ አርገተን ከኑማ? ሜ ነት ህም!” ጄዼ እሼ ጋፈቴ።</para>
  <para style="p" vid="ACT 5:8">እሼንስ፣ “ኤዬ ከኑመ” ጄቴ።<verse eid="ACT 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 5:9"/>ጴጥሮስስ፣ “እስን አከም ሀፉረ ጎፍታ ቆሩፍ ወሊ ገሉ ደንዴሰን? እላ! ሚል ወረ ዽርሰኬ አዋለኒ በልበለ ዱረ ገኤረ፤ ስስ ገድ ስባሱ” ጄዼን።<verse eid="ACT 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 5:10"/>እሼንስ ዬሩመ ሰነ ሚለሳ ጀለት ለፈ ዾፍቴ ዱቴ፤ ደርገጎትን ሱንስ ኦል ሴነኒ ሬፈሼ አርገን፤ ገድ ባሰኒስ ዽርሰሼ ብረት እሼ አዋለን። <verse eid="ACT 5:10"/><verse number="11" style="v" sid="ACT 5:11"/>ወልዳን ክርስታና ሁንድ፣ ወር ዋን ከነ ዸገአን ሁንድኑስ ሶዳ ጉዳን ቀበመን።<verse eid="ACT 5:11"/></para>
  <para style="s1">ኤርገሞትን ዹኩብሰቶተ ባይኤ ፈይሰን</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12"/>ኤርገሞትንስ መለቶፊ ድንቂ ባይኤ ኡመተ ግዱት ሆጄተን። አመንቶትን ሁንድኑስ እዶ ገርዳፎ ሶሎሞን ጄዸሙት ወልት ቀበሙ ቱረን። <verse eid="ACT 5:12"/><verse number="13" style="v" sid="ACT 5:13"/>ወረ ሀፈን ኬሳ ነምን ቶኮዩ እሳንት ደበለሙፍ እጀ ህንጀባትኔ፣ ኡመትን ገሩ አከ መሌ እሳን ኡልፌሰ ቱሬ። <verse eid="ACT 5:13"/><verse number="14" style="v" sid="ACT 5:14"/>ሀመ ዱራ ጫላስ ዺሮትኒፊ ዱበርቶትን ሄዱን ጎፍታ አመነኒ አመንቶተት ደበለመን። <verse eid="ACT 5:14"/><verse number="15" style="v" sid="ACT 5:15"/>ከናፍስ አከ ዮሙ ጴጥሮስ አቺን ደርቡት ጋድዱምትሳዩ እሳን ኬሳ ቶኮ ቶኮረ ቡኡፍ ጄዸኒ ነሞትን ዹኩብሰቶተ ከራት ባሰኒ ስሬፊ እትሌረ ጭጪብሰን። <verse eid="ACT 5:15"/><verse number="16" style="v" sid="ACT 5:16"/>ነሞትንስ መጋላወን ናኖ ዬሩሳሌም ጅረን ኬሳ ወረ ዹኩብሰተኒፊ ወረ ሀፉረ ጡራኣን ዽጰተን ፍደኒ አችት ወል ገአን፤ ወር ጌፈመን ሁንድኑስ ንፈይፈመን።<verse eid="ACT 5:16"/></para>
  <para style="s1">ኤርገሞትን አርአተመን</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 5:17"/>ሉብን ኦል ኣናኒፊ ምሴንሶትን ገሬ ሰዱቆታ ወር እሰ ወጅን ቱረን ሁንድኑ ህናፋን ጉተመን። <verse eid="ACT 5:17"/><verse number="18" style="v" sid="ACT 5:18"/>እሳንስ ኤርገሞተ ቀበኒ መነ ህዻ ኡመታ ኬሰ ቡሰን። <verse eid="ACT 5:18"/><verse number="19" style="v" sid="ACT 5:19"/>ገሩ ኤርገማን ጎፍታ ቶኮ ሀልከኒን በልበለ መነ ህዻ በኔ ገድ እሳን ባሴ። <verse eid="ACT 5:19"/><verse number="20" style="v" sid="ACT 5:20"/>እንስ፣ “ዸቃ መነ ቁልቁሉማ ኬሰ ዸዻበዻቲ፣ ዱቢ ጅሬኘ ሃራ ከነ ሁንደሳ ኡመተት ህማ” ጄዼን።<verse eid="ACT 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 5:21"/>እሳንስ አኩመ እሳንት ህመሜ ሰነት ገነመ በሪ መነ ቁልቁሉማ ሴነኒ ኡመተ በርሲሱ ጀልቀበን።</para>
  <para style="p" vid="ACT 5:21">ሉብን ኦል ኣናኒፊ ወር እሰ ወጅን ቱረን ዮሙ አች ገአንት ወልዳ ይሁዶታቲፊ ያኢ ማንጉዶተ እስራኤል ወልት ዋመን፤ አከ ኤርገሞተ ሰነ ፍደኒፍስ መነ ህዻት ነሞተ ኤርገን። <verse eid="ACT 5:21"/><verse number="22" style="v" sid="ACT 5:22"/>ቆንዳልቶትን ኤርገመን ሱን ገሩ ዮሙ መነ ህዻ ገአንት ጀረ አችት ህንአርገትኔ፤ ከናፍስ ዴብአኒ፣ <verse eid="ACT 5:22"/><verse number="23" style="v" sid="ACT 5:23"/>“መነ ህዻ ሰነ እሳ ስሪት ቆሎፈሜ ጅሩ፣ ኤግዶተስ፣ ኡቱ እሳን በልበለ ዱረ ዻበተኒ ጅረኑ አርግኔ፤ ዬሮ በኔት ገሩ ነመ ቶኮሌ አች ኬሰት ህንአርገትኔ” ጄዸን። <verse eid="ACT 5:23"/><verse number="24" style="v" sid="ACT 5:24"/>አጀጃን ኤግዶተ መነ ቁልቁሉማቲፊ ሉቦትን ሀንገፎትን ዮሙ ኦዱ ከነ ዸገአንት ድንቅፈቹዻን ዋን ጄዸን ወላለኒ፣ “ማልቱ ዸለቴሞ?” ጄዸን።<verse eid="ACT 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 5:25"/>ዮሙስ ነምች ቶኮ ዹፌ፣ “ጀር እስን መነ ህዻት ገልችተን ሱን ኩኖ፣ መነ ቁልቁሉማ ኬሰ ዸዻበተኒ ኡመተ በርሲሳ ጅሩ!” ጄዼ። <verse eid="ACT 5:25"/><verse number="26" style="v" sid="ACT 5:26"/>ከነረት አጀጃን ሱን ቆንዳልቶተ ወጅን ዸቄ ኤርገሞተ ሰነ ፍዴ፤ እሳንስ ሰበቢ ኡመትን ዸጋን ኑ ቱመ ጄዸኒ ሶዳተኒፍ ሁምነት ህንፈየደምኔ።<verse eid="ACT 5:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 5:27"/>ኤርገሞተስ ፍደኒ፣ አከ ሉብን ኦል ኣናን እሳን ቆሩፍ ፉለ ያኢ ይሁዶታ ዱረ እሳን ዸዻበቺሰን። <verse eid="ACT 5:27"/><verse number="28" style="v" sid="ACT 5:28"/>ሉብች ኦል ኣናንስ፣ “ኑ አከ እስን መቃ ከናን ህንበርሲስኔ ጀቤስኔ እስን አጀጅኔ ቱሬ፤ እስን ገሩ በርሲሰኬሰኒን ዬሩሳሌም ጉተኒርቱ፤ አከ ኑ እት ጋፈተምቶተ ዺገ ነምቸ ከና ታኑ ኑ ጎቹ በርባዱ” ጄዼ።<verse eid="ACT 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 5:29"/>ጴጥሮሲፊ ኤርገሞትን ካን ገሩ አከነ ጄዸኒ ዴብሰን፤ “ኑ ነማፍ አጀጀሙረ ዋቃፍ አጀጀሙ ቀብነ! <verse eid="ACT 5:29"/><verse number="30" style="v" sid="ACT 5:30"/>ዬሱስ እሰ እስን ፈኖረት ፈንፍተኒ አጄፍተን ሰነ ዋቅን አቦቲኬኛ ወረ ዱአን ኬሳ እሰ ካሴረ። <verse eid="ACT 5:30"/><verse number="31" style="v" sid="ACT 5:31"/>ዋቅን አከ እን እስራኤሊፍ ቀልቢ ጅጂረቹፊ ዺፈመ ጩቡ ኬኑፍ ጄዼ ቡልቻፊ ፈይሳ ጎዼ ምርገ ኦፊት ኦል ኦል እሰ ቀቤ። <verse eid="ACT 5:31"/><verse number="32" style="v" sid="ACT 5:32"/>ኑ ዹገ ባቶተ ዋን ከናት፤ አከሱመስ ሀፉር ቁልቁሉን ዋቅን ወረ እሳፍ አጀጀመኒፍ ኬኔ ሱን ዹገ በኣ ዋን ከናት።”<verse eid="ACT 5:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 5:33"/>እሳንስ ዮሙ ዋን ከነ ዸገአንት አከ መሌ ኣሪዻን ጉጉበተኒ ኤርገሞተ አጄሱፍ መርአተን። <verse eid="ACT 5:33"/><verse number="34" style="v" sid="ACT 5:34"/>ፈሪስች ገማልያል ጄዸሙ፣ በርሲሳን ሴራ ከን ነምን ሁንድ ከበጁ ቶኮ ገሩ ወልዳ ይሁዶታ ኬሰ ዻበቴ አከ ኤርገሞትን ሱን ዬሮፍ ገድ ባፈመን አጀጄ። <verse eid="ACT 5:34"/><verse number="35" style="v" sid="ACT 5:35"/>እንስ አከነ እሳኒን ጄዼ፤ “ያ ነሞተ እስራኤል፣ ዋን ጀረ ከነ ጎቹፍ ዴምተን ኬሰት ኦፍ ኤገዻ። <verse eid="ACT 5:35"/><verse number="36" style="v" sid="ACT 5:36"/>በረ ዼራን ዱረ ቶይዳስ አከ ዋን ነመ ጉዳ ተኤት ኦፍ እላሌ ካናን ነሞትን ገረ ዽበ አፉሪት ሄደመን እሰ ፋነ ቡአን፤ እን ንአጄፈሜ፤ ዱካ ቡቶትንሳ ንብትኔፈመን፤ አከሱማን በደንስ። <verse eid="ACT 5:36"/><verse number="37" style="v" sid="ACT 5:37"/>ነምቸ ከነ ቦዴሞ ይሁዳን፣ ነምን ገሊላ በረ ለኮብሰ ሰባ ኬሰ ከኤ ነመ ባይኤ ኦፍት ኩተቴ፤ እንስ ንአጄፈሜ፤ ወር እሰ ፋነ ቡአንስ ንብትናአን። <verse eid="ACT 5:37"/><verse number="38" style="v" sid="ACT 5:38"/>ከናፉ ዱቢ ከነ ኬሰት አን እስንትን ህመ፤ ነሞተ ከነ ገድ ዺሳ! ሃዴመን! መሪንሳኒ ዮካን ሆጂንሳኒ ኩን ዮ ዋን ነመራ ዹፌ ተኤ ንበደ። <verse eid="ACT 5:38"/><verse number="39" style="v" sid="ACT 5:39"/>ዮ ዋን ዋቀራ ዹፌ ተኤ ገሩ ጀረ ከነ ዾዉ ህንደንዴሰን፤ እስን መታንኬሰንዩ አከ ኡቱ ዋቃን ወል ሎልተኑ ህንአርገምኔ ኦፍ ኤገዻ!”<verse eid="ACT 5:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 5:40"/>እሳንስ ጎርሰሳ ፉዸተን፤ ኤርገሞተ ሰነስ ኦል ዋመኒ ገረፈን፤ አከ እሳን መቃ ዬሱሲቲን ዋ ህንዱበትኔስ አጀጀኒ ገድ እሳን ዺሰን።<verse eid="ACT 5:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="ACT 5:41"/>ኤርገሞትንስ አከ መቃ ሰናፍ ጄዸኒ ቃነአኒፍ ዋን ገኡምሰ አርገተኒፍ አከ መሌ ገመዳ ፉለ ወልዳ ዱራ ዴመን። <verse eid="ACT 5:41"/><verse number="42" style="v" sid="ACT 5:42"/>እሳንስ ጉዩመ ጉያን መነ ቁልቁሉማት፣ መነ ነማትስ ኡቱ ገርገር ህንኩትን አከ ዬሱስ ክርስቶስ ተኤ በርሲሳ፣ ለለባስ ቱረን።<verse eid="ACT 5:42"/></para>
  <chapter eid="ACT 5"/>
  <chapter number="6" style="c" sid="ACT 6"/>
  <para style="s1">ነሞትን ቶርበ ፍለተሙ እሰኒ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1"/>በረ ሰነ ኬሰ ዮሙ ባይእን በረቶታ ደበለማ ዴሜት ይሁዶትን ግሪኮተ ኬሰ ጅራተን እብሮተት ጉንጉመን፤ ሃዾትን ህዬሳ<note caller="+" style="f"><char style="fr" closed="false">6፥1 </char><char style="fqa" closed="false">ዽርሶትንሳኒራ ዱአን </char><char style="ft" closed="false">– ኩን ገሬ ዱበርቶተ አከ መሌ ረከተኒት። ዬሩሳሌም ኬሰ ሃዾተ ህዬሳ ከኔን በረ ጅሬኘሳኒ ገረ ጫሉ መጋላ ቁልቁልቲን አለ ጅራተኒ አከ አችት ዱአኒ እት አዋለመኒፍ ጄዸኒ ገረ ዬሩሳሌም ዹፈኒራ ዱአን ቶኮ ቶኮቱ ቱሬ። ይሁዶትንስ ገሬ ከነ ገርጋሩፍ ጄዸኒ አከ ማለቅን እሳን እቲን ኛተ ብተተን እሳኒፍ ኬነሙፍ መለ ቶኮ ቆጴሰን።</char></note> ይሁዶታ ኛተ ጉያ ጉያን ህረሙ ኬሰት ሀጩጨመኒ ቱረኒቲ። <verse eid="ACT 6:1"/><verse number="2" style="v" sid="ACT 6:2"/>ከናፍ ኤርገሞትን ኩዸ ለማን በረቶተ ሁንደ ወልት ቀበኒ አከነ ጄዸኒን፤ “ማዲ ተጃጅሉፍ ጄኔ ዱቢ ዋቃ በርሲሱ ዺሱን ኑፍ ቀጄላ ምት። <verse eid="ACT 6:2"/><verse number="3" style="v" sid="ACT 6:3"/>ከናፍ ያ ኦቦሎተ እስን ነሞተ መቃ ጋሪ ቀበን ከኔን ሀፉረ ቁልቁሉፊ ኦጉማን ጉተመን ቶርበ ግዱኬሰኒ ፍለዻ። ኑስ እት ጋፈተመ ከነ እሳንት ኬንኔ፣ <verse eid="ACT 6:3"/><verse number="4" style="v" sid="ACT 6:4"/>ዋቀ ከዸቹፊ ዱቢሳ በርሲሱት ጀባትና።”<verse eid="ACT 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 6:5"/>ወን እሳን ጄዸንስ ቱተ ሰነ ሁንደ ገመቺሴ። እሳንስ እስጥፋኖስ ነምቸ አመንቲፊ ሀፉረ ቁልቁሉዻን ጉተሜ ቶኮ፣ አከሱመስ ፊልጶሲፊ ጵሮኮሮስን፣ ኒቃሮናፊ ጢሞና፣ ጰርሜናፊ ኒቆላዎስ ነምቸ አንጦኪያ እሰ አመንቲ ይሁዶታት ገሌ ሰነ ፍለተን። <verse eid="ACT 6:5"/><verse number="6" style="v" sid="ACT 6:6"/>እሳንስ ጀረ ከነ ፉለ ኤርገሞታ ዱረ ዻበን፤ ኤርገሞትንስ ከዸተኒፊ ሀርከ እሳንረ ካአን።<verse eid="ACT 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 6:7"/>ዱቢን ዋቃ ንበበልአቴ፤ ባይእን በረቶታስ ዬሩሳሌም ኬሰት አከ መሌ ደበለሜ፤ ሉቦትን ሄዱን አመንቲ ከናፍ አጀጀመን።<verse eid="ACT 6:7"/></para>
  <para style="s1">እስጥፋኖስ ቀበሜ</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 6:8"/>እስጥፋኖስ አያናፊ ሁምነ ዋቃቲን ጉተሜ ድንቂፊ መለቶ ጉርጉዳ ነሞተ ግዱት ሆጄቴ። <verse eid="ACT 6:8"/><verse number="9" style="v" sid="ACT 6:9"/>ምሴንሶትን መነ ሰገዳ ወረ፣ “ነሞተ ብልሶመን” ጄዸመን፣ ጄቹንስ ይሁዶትን ቀሬናፊ እስክንድርያዻ ዹፈን አከሱመስ ይሁዶትን ኪልቅያፊ አስያዻ ዹፈን ቶኮ ቶኮ እስጥፋኖሲን ሞርሙ ጀልቀበን። <verse eid="ACT 6:9"/><verse number="10" style="v" sid="ACT 6:10"/>እሳን ገሩ ኦጉማሳ ዮካን ሀፉረ ቁልቁሉ እን እቲን ዱበቱ ሰናን ሞርሙ ህንደንዴኜ።<verse eid="ACT 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 6:11"/>ከናፉ አከ እሳን፣ “ኑ ኡቱ እስጥፋኖስ ሙሴፊ ዋቀረት ዱቢ አረብሶ ዱበቱ ዸጌኜረ” ጄዸኒፍ ዾክሳን ነሞተ ቶኮ ቶኮ ሶሶበተን።<verse eid="ACT 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 6:12"/>እሳንስ ኡመተ፣ ማንጉዶታፊ በርሲስቶተ ሴራ ከካሰን። እስጥፋኖሲንስ ቀበኒ ፉለ ወልዳ ይሁዶታ ዱረት እሰ ዽኤሰን። <verse eid="ACT 6:12"/><verse number="13" style="v" sid="ACT 6:13"/>ዹገ ባቶተ ሶብዱስ ቆጴፈተን፤ እሳንስ አከነ ጄዸን፤ “ነምች ኩን እዶ ቁልቁሉ ከናፊ ሴራን ሞርሙ ተኩማ ህንዺፍኔ። <verse eid="ACT 6:13"/><verse number="14" style="v" sid="ACT 6:14"/>ኑ እሳ፣ ‘ዬሱስ ነምን ናዝሬት ኩን እዶ ከነ ንዲገ፤ ሴረ ሙሴን ኑ ኬኔስ ንጌደረ’ ጄዹ ዸጌኜረ።”<verse eid="ACT 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 6:15"/>ወር ወልዳ ሰነ ኬሰ ቱረን ሁንድ እጀ በባሰኒ እስጥፋኖስን እላለኒ አከ ፉልሳ አኩመ ፉለ ኤርገማ ዋቃ ተኤ አርገን።<verse eid="ACT 6:15"/></para>
  <chapter eid="ACT 6"/>
  <chapter number="7" style="c" sid="ACT 7"/>
  <para style="s1">ሃሳ እስጥፋኖስ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1"/>ሉብን ኦል ኣናንስ፣ “ወን ኩን ዹጉማ?” ጄዼ እሰ ጋፈቴ።<verse eid="ACT 7:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 7:2"/>እንስ አከነ ጄዼ ዴብሴ፤ “ያ ኦቦሎታፊ ያ አቦቲ፣ ሜ ነ ዸገኣ! ዋቅን ኡልፍና፣ ዬሮ አባንኬኘ አብረሃም መስጴጦምያ ኬሰ ቱሬት፣ ኡቱ እን ብየ ካራን ህንዸቅን እሰት ሙልአቴ። <verse eid="ACT 7:2"/><verse number="3" style="v" sid="ACT 7:3"/>ዋቅንስ፣ ‘ብየኬቲፊ ሰበኬ ዺሲቲ ገረ ብየ አን ስ አርግሲሱ ዸቅ’<note caller="+" style="f"><char style="fr" closed="false">7፥3 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 12:1">ኡመ 12፥1</ref></char></char></note> ጄዼን።<verse eid="ACT 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 7:4"/>“እንስ ብየ ከልዶታቲ በኤ ዸቄ ካራን ኬሰ ጅራቴ። ኤርገ አባንሳ ዱኤሞ ዋቅን አቺ እሰ ባሴ ብየ እስን አመ ኬሰ ጅራተን ከነት እሰ ኤርጌ። <verse eid="ACT 7:4"/><verse number="5" style="v" sid="ACT 7:5"/>ተኡስ ዋቅን ዻለ ቶኮሌ፣ ለፈ ታኩ ቶክቲሌ ብየ ሰነ ኬሰት ህንኬንኔፍ፤ ገሩ ዋቅን አከ አብረሃሚፊ ሰኚሳ ወረ እሳን ቦዴቲፍ ብየ ሰነ አኩመ ቀቤኛት ኬኑፍ ዋዳ ገሌፍ። አብረሃም ዬሮ ሰነ እጆሌ ቶኮሌ ህንቀቡ ቱሬ። <verse eid="ACT 7:5"/><verse number="6" style="v" sid="ACT 7:6"/>ዋቅን አከነ ጄዼ ከራ ከናን እሰት ዱበቴ፤ ‘ሰኚንኬ ብየ ከንሳ ህንተእን ኬሰት አለጋ ተአ፤ ወጋ ዽበ አፉርስ ንገርቦምፈመ፤ ንጩንቁርፈመስ።’ <verse eid="ACT 7:6"/><verse number="7" style="v" sid="ACT 7:7"/>ዋቅን አከነ ጄዼ፤ ‘አን ገሩ ሰበ እሳን አኩመ ገርቦታት ተጃጅለን ሰነ ነንአደበ፤ ኤርገሲሞ እሳን ብየ ሰና በአኒ ለፈ ከነት ነ ዋቄፈቱ።’<note caller="+" style="f"><char style="fr" closed="false">7፥7 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 15:13">ኡመ 15፥13</ref>፣<ref loc="GEN 15:14">14</ref></char></char></note> <verse eid="ACT 7:7"/><verse number="8" style="v" sid="ACT 7:8"/>ዋቅንስ ከኩ ዸግነ ቀባ አብረሃሚፍ ኬኔ፤ አብረሃምስ አባ ይስሃቅ ተኤ ጉያ ሰዴተፋት ዸግነ እሰ ቀቤ፤ ይስሃቅስ ኤርገሲ አባ ያቆብ ተኤ፤ ያቆብሞ አባ አቦቲ ጎሶተ ኩዸ ለማኒ ተኤ።<verse eid="ACT 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 7:9"/>“አቦቲን ሱንስ ዋን ዮሴፍት ህናፈኒፍ አከ እን ብየ ግብጥት ገርበ ተኡፍ እሰ ጉርጉረን፤ ዋቅን ገሩ እሰ ወጅን ቱሬ፤ <verse eid="ACT 7:9"/><verse number="10" style="v" sid="ACT 7:10"/>ረክነሳ ሁንደ ኬሳ እሰ ባሴ፤ ዋቅንስ ፉለ ፈረኦን ሞትቸ ግብጥ ዱረት ኡልፍናፊ ኦጉማ ዮሴፊ ኬኔ፤ ፈረኦንስ ብየ ግብጢፊ መነ ሞቱማሳ ሁንደረት ቡልቻ እሰ ጎዼ።<verse eid="ACT 7:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 7:11"/>“በሩመ ሰነ ብየ ግብጢፊ ብየ ከነኣን ሁንደት ቤል ቡኤ ረክነ ጉዳ ፍዴ፤ አቦቲንኬኘስ ዋን ኛተን ቶኮሌ አርገቹ ህንደንዴኜ። <verse eid="ACT 7:11"/><verse number="12" style="v" sid="ACT 7:12"/>ያቆብስ አከ ግብጥ ኬሰ ምዻን ጅሩ ዸጌኛን ዬሮ ጀልቀባቲፍ አቦቲኬኘ አች ኤርጌ። <verse eid="ACT 7:12"/><verse number="13" style="v" sid="ACT 7:13"/>እመለሳኒ ለመፋረትስ ዮሴፍ ኤኙማሳ ኦቦሎተሳት ህሜ፤ ፈረኦንስ ዋኤ ኦቦሎተ ዮሴፍ ቤኬ። <verse eid="ACT 7:13"/><verse number="14" style="v" sid="ACT 7:14"/>ዮሴፍስ ኤርገሲ ነመ ኤርጌ አባሳ ያቆቢፊ ማቲሳ ሁንደ ጄቹንስ ወሉመት ቀባት ነመ 75 ዋምስሴ። <verse eid="ACT 7:14"/><verse number="15" style="v" sid="ACT 7:15"/>ያቆብስ ግብጥት ገድ ቡኤ፤ እንስ፣ አቦቲንኬኘስ አችት ዱአን። <verse eid="ACT 7:15"/><verse number="16" style="v" sid="ACT 7:16"/>ሬፍሳኒስ ሼኬምት ጌፈሜ ለፈ አዋላ ከን አብረሃም እጆሌ ሀሞርራ ሆሪ ወዪቲን ብቴ ቱሬ ሰነት አዋለሜ።<verse eid="ACT 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 7:17"/>“አኩመ ዬሮን ዋዳ ዋቅን አብረሃሚፍ ገሌ ሱን እት ራወተሙ ዽኣቻ ዹፌን ባይእን ሰበኬኛ ግብጥ ኬሰት አከ መሌ ጉደቴ። <verse eid="ACT 7:17"/><verse number="18" style="v" sid="ACT 7:18"/>ኤርገሲ ሞቲን ዋኤ ዮሴፍ ህንቤክን ሃራን ቶኮ ቡልቻ ግብጥ ተኤ። <verse eid="ACT 7:18"/><verse number="19" style="v" sid="ACT 7:19"/>እንስ አከ መሌ ሰበኬኘ ጩንቁርሴ፤ አቦቲኬኘስ አከ ዳእመንሳኒ ዹመኒፍ አከ እሳን ገድ ገተን ድርቅሲሴ።<verse eid="ACT 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 7:20"/>“ዬሮን ሙሴን ዸለቴስ ዬሩመ ከነ ቱሬ፤ እንስ ፉለ ዋቃ ዱረት ሚዸጋ ቱሬ፤ ጅአ ሰዲፍስ መነ አባሳት ኩኑንፈሜ ጉደቴ። <verse eid="ACT 7:20"/><verse number="21" style="v" sid="ACT 7:21"/>ዮሙ እን አለት ገተሜት እንተል ፈረኦን ፉዸቴ አከ እልመሼት እሰ ጉድፈቴ። <verse eid="ACT 7:21"/><verse number="22" style="v" sid="ACT 7:22"/>ሙሴን ኦጉማ ወረ ግብጥ ሁንደ በረቴ፤ እንስ ዱቢሳቲፊ ሆጂሳቲን ጀባ ቱሬ።<verse eid="ACT 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 7:23"/>“ሙሴን ዮሙ ኡሙሪንሳ ወጋ 40 ጉቴት ዸቄ ኦቦሎተሳ እጆሌ እስራኤል እላሉ ሙርቴሴ። <verse eid="ACT 7:23"/><verse number="24" style="v" sid="ACT 7:24"/>ሙሴንስ ኡቱ ነምን ግብጥ ቶኮ ነመሳኒ ቶኮ ሚዹ አርጌ። ከናፍስ ነመሳኒ ገርጋሩ ዸቄ ነምቸ ግብጥ ሰነ አጄሱን ሃሎ ባሴፍ። <verse eid="ACT 7:24"/><verse number="25" style="v" sid="ACT 7:25"/>ሙሴን ዋን ሰብንሳ አከ ዋቅን ከራሳቲን ሰበ እስራኤል ፉሩ ሁበቱ ሴኤ ቱሬ፤ ሰብን ሱን ገሩ ህንሁበትኔ። <verse eid="ACT 7:25"/><verse number="26" style="v" sid="ACT 7:26"/>ጉያ እት ኣኑትሞ ኡቱ ነሞትን እስራኤል ለመ ወል ሎለኑ እት ዹፌ፣ ‘ጀረነ፣ እስን ኦቦሎተ ወሊት፤ ዮስ ማሊፍ ወል ሚቱሬ?’ ጄዼ ወልት አራርሱ ያሌ።<verse eid="ACT 7:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 7:27"/>“ነምች ህርያሳ ሚዻ ቱሬ ሱን ገሩ ሙሴ አች ኦፍራ ደርበቴ አከነ ጄዼ፤ ‘ኤኙቱ ኑረት ቡልቻፊ አባ ሙርቲ ስ ጎዼ? <verse eid="ACT 7:27"/><verse number="28" style="v" sid="ACT 7:28"/>አኩመ ከሌሰ ነምቸ ግብጥ አጄፍቴ ሰነ አነሌ አጄሱ በርባዳ?’<note caller="+" style="f"><char style="fr" closed="false">7፥28 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 2:14">በኡ 2፥14</ref></char></char></note> <verse eid="ACT 7:28"/><verse number="29" style="v" sid="ACT 7:29"/>ሙሴንስ ዋን ከነ ዸጌኛን ብየ ሚድያንት በቀቴ ገልቱ ተኤ አች ጅራቴ፤ አችትስ እልማን ለመ ዸልቼ።<verse eid="ACT 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 7:30"/>“ኤርገ ወጋን አፉርተምን ደርቤ ቦዴስ ኤርገማን ዋቃ ቶኮ ገሞጂ ናኖ ቱሉ ሲና ኬሰት ደገለ ቦበኡ ኬሳ አረበ እብዳ ኬሳን ሙሴት ሙልአቴ። <verse eid="ACT 7:30"/><verse number="31" style="v" sid="ACT 7:31"/>እንስ ዋን ከነ አርግናን ዋን አርጌ ሰነ ድንቅፈቴ። ዮሙ እላሉፍ እት ዽኣቴትስ ሰገሌ ጎፍታ ዸገኤ። <verse eid="ACT 7:31"/><verse number="32" style="v" sid="ACT 7:32"/>ሰገሌን ሱንስ፣ ‘አን ዋቀ አቦቲኬቲ፣ ዋቀ አብረሃም፣ ከን ይስሃቂፊ ከን ያቆብ’<note caller="+" style="f"><char style="fr" closed="false">7፥32 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 3:6">በኡ 3፥6</ref></char></char></note> ጄዼን። ሙሴንስ ንሆለቴ፤ እላሉስ ንሶዳቴ።<verse eid="ACT 7:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 7:33"/>“ጎፍታንሞ አከነ ጄዼን፤ ‘ሰበቢ እዶን አት ዻበቱ ኩን ቁልቁሉ ተኤፍ ኮጴኬ ባፈዹ። <verse eid="ACT 7:33"/><verse number="34" style="v" sid="ACT 7:34"/>አን አከ ሰብንኮ ብየ ግብጥ ኬሰት ጩንቁርፈማ ጅሩ ዹጉማን አርጌረ፤ ቦእቸሳኒስ ዸገኤ እሳን ብልሶምሱፍ ጄዼ ገድ ቡኤረ፤ ኤጋ ኮቱ ግብጥን ዴብሴ ስኤርጋቲ።’<note caller="+" style="f"><char style="fr" closed="false">7፥34 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 3:5">በኡ 3፥5</ref>፣<ref loc="EXO 3:7">7</ref>፣<ref loc="EXO 3:8">8</ref>፣<ref loc="EXO 3:10">10</ref></char></char></note><verse eid="ACT 7:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 7:35"/>“ነምን እሳን፣ ‘ኤኙቱ ቡልቻፊ አባ ሙርቲ ስ ጎዼ?’ ጄዸኒ ቱፈተን ሱን ሙሴዹመ ከነ። እሰስ ዋቅን አከ እን ቡልቻፊ ፉራሳኒ ተኡፍ ሀርከ ኤርገማ ዋቃ ከን ደገለ ኬሳን እሰት ሙልአቴ ሰናቲን ኤርጌ። <verse eid="ACT 7:35"/><verse number="36" style="v" sid="ACT 7:36"/>እንስ ግብጥ ኬሰት፣ ገላነ ዲማረት አከሱመስ ወጋ 40 ገሞጂ ኬሰት ድንቂፊ መለቶ ሆጄቻ ግብጥ ኬሳ እሳን ባሴ።<verse eid="ACT 7:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 7:37"/>“ሙሴን ኩን እሱመ ሰበ እስራኤሊቲን፣ ‘ዋቅን ሰቡመኬሰን ኬሳ ራጂ አከኮቲ ቶኮ እስኒ ካሰ’<note caller="+" style="f"><char style="fr" closed="false">7፥37 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 18:15">ኬዴ 18፥15</ref></char></char></note> ጄዼ ሰናዸ። <verse eid="ACT 7:37"/><verse number="38" style="v" sid="ACT 7:38"/>እንስ፣ ኤርገማ ዋቃ ከን ቱሉ ሲናረት እሰት ዱበቴ ሰናፊ አቦቲኬኘ ወጅን ገሞጂ ኬሰት ወልዳ ኬሰ ቱሬ፤ ዱቢ ጅራታስ ኑት ኬኑፍ ፉዸቴ።<verse eid="ACT 7:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 7:39"/>“አቦቲንኬኘ ገሩ እሳፍ አጀጀሙ ድደን፤ ቆደ አጀጀሙ እሰ ቱፈተኒ ገራሳኒቲንስ ገረ ግብጥት ዴብአን። <verse eid="ACT 7:39"/><verse number="40" style="v" sid="ACT 7:40"/>ኣሮኒንስ፣ ‘ዋቆተ ኑ ዱረ ዴመን ኑ ቶልች፤ ሙሴን ብየ ግብጢ ኑ ባሴ ሱን ማል አከ ተኤ ህንቤክኑቲ!’<note caller="+" style="f"><char style="fr" closed="false">7፥40 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 32:1">በኡ 32፥1</ref></char></char></note> ጄዸን። <verse eid="ACT 7:40"/><verse number="41" style="v" sid="ACT 7:41"/>ዬሮን እሳን ዋቀ ቶልፈማ ብፈ ጀቢቲን ቆጴፈተንስ በሩመ ሰነ፤ እሳንስ ዋቀ ሰናፍ ኣርሳ ዽኤሰኒ ዋኑመ ሀርከሳኒቲን ቶልፈሜ ሰናፍ አያነ ኡልፍና አያኔፈተን። <verse eid="ACT 7:41"/><verse number="42" style="v" sid="ACT 7:42"/>ዋቅን ገሩ እሳንራ ገረገሌ አከ እሳን ሁምኖተ ሰሚራ ዋቄፈተኒፍ እሳን ዺሴ። ኩንስ ዋን ክታበ ራጆታ ኬሰት በሬፈሜ ሰናን ወል ፈካተ፤ እንስ አከነ ጄዸ፤</para>
  <para style="q1" vid="ACT 7:42">“ ‘ያ መነ እስራኤል እስን ወጋ 40 ገሞጂ ኬሰት</para>
  <para style="q2" vid="ACT 7:42">ተኩማ ኣርሳፊ ኬና ናፍ ፍደኒርቱ?<verse eid="ACT 7:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="ACT 7:43"/>እስን ፈኪ ዋቆተ ዋቄፈቹፍ ቶልፈተኒ ጄቹንስ</para>
  <para style="q2" vid="ACT 7:43">ዱንካነ ሞሌኪቲፊ<note caller="+" style="f"><char style="fr" closed="false">7፥43 </char><char style="fqa" closed="false">ሞሌክ </char><char style="ft" closed="false">– ዋቀ ቶልፈማ ወረ ከነኣኒ ከን ዋቄፈተሙሳ ኬሰ እጆሌ ጉበኒ ኣርሳ ዽኤሱንስ ጅሩ።</char></note></para>
  <para style="q2" vid="ACT 7:43">ኡርጂ ዋቀኬሰን ራፋ<note caller="+" style="f"><char style="fr" closed="false">7፥43 </char><char style="fqa" closed="false">ራፋ </char><char style="ft" closed="false">– ዋቀ ቶልፈማ በረ ዱሪ ከን ቡልቻ ፕላኔቲ ሳተርን ጄዸሙት ጄዸሜ ዋቄፈተሙ።</char></note> ኦል ቀብደኒርቱ።</para>
  <para style="q1" vid="ACT 7:43">ከናፉ አን ብየ ባብሎኒን ገማት እስን አርአ።’<note caller="+" style="f"><char style="fr" closed="false">7፥43 </char><char style="ft" closed="false"><char style="xt"><ref loc="AMO 5:25">አሞ 5፥25</ref></char></char></note><verse eid="ACT 7:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 7:44"/>“አቦቲንኬኘ ገሞጂ ኬሰት ዱንካነ ዹገ በኡምሳ ኦፍ ብራ ቀቡ ቱረን። ዱንካን ሱንስ አኩመ ዋቅን አከ ሙሴን አኩመ ብፈ አርጌ ሰናት ሆጄቱፍ እሰ ቀጄልቼት ሆጄተሜ ቱሬ። <verse eid="ACT 7:44"/><verse number="45" style="v" sid="ACT 7:45"/>አቦቲንኬኘስ ዱንካንቸ ፉዸተኒ ብየ ሰበ ዋቅን እሳን ዱራ አርኤ ባሴ ሰናት እያሱ ወጅን ገለን፤ ዱንካን ሱን ሀመ በረ ዳዊቲት ብየ ሰነ ቱሬ። <verse eid="ACT 7:45"/><verse number="46" style="v" sid="ACT 7:46"/>ዳዊትስ ፉለ ዋቃ ዱረት ፉዸተመ አርገቴ ዋቀ ያቆቢቲፍ መነ ጅሬኛ እጃሩፍ ከዸቴ። <verse eid="ACT 7:46"/><verse number="47" style="v" sid="ACT 7:47"/>ገሩ ከን መነ ሰነ እጃሬፍ ሶሎሞን ቱሬ።<verse eid="ACT 7:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 7:48"/>“ተኡስ ዋቅን ዋን ሁንዳ ኦሊ መነ ሀርክ ነማ እጃሬ ኬሰ ህንጅራቱ፤ ኩንስ አኩመ ራጅች አከነ ጄዼ ዱበቴዸ፦<verse eid="ACT 7:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="ACT 7:49"/>“ ‘ሰሚን ቴሶኮት፤</para>
  <para style="q2" vid="ACT 7:49">ለፍትስ ኤጄተ ሚለኮቲት።</para>
  <para style="q1" vid="ACT 7:49">ዮስ እስን መነ አከሚ ናፍ እጃርቱሬ?</para>
  <para style="q2" vid="ACT 7:49">ጄዸ ጎፍታን፤</para>
  <para style="q2" vid="ACT 7:49">ዮካን ለፍት ቦቆናኮቲ ኤሰ ተአ?<verse eid="ACT 7:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="ACT 7:50"/>ዋን ከነ ሁንደ ሀርክኮ ህንሆጄትኔ?’<note caller="+" style="f"><char style="fr" closed="false">7፥50 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 66:1">እሳ 66፥1</ref>፣<ref loc="ISA 66:2">2</ref></char></char></note><verse eid="ACT 7:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="ACT 7:51"/>“ያ ነሞተ መተ ጀቤዪነነ! ገራንኬሰን ህንአመኑ፤ ጉርኬሰንስ ህንዸገኡ! እስን ዬሮ ሁንደ ሀፉረ ቁልቁሉን ሞርምቱ፤ አኩመ አቦቲንኬሰን ጎዸን ሰነ እስንስ ጎቱ። <verse eid="ACT 7:51"/><verse number="52" style="v" sid="ACT 7:52"/>ራጂን አቦቲንኬሰን ህንአርአትን ቶኮዩ ጅራ? እሳን ወረ ዱራን ዱርሰኒ ዹፋቲ እሰ ቀጄላ ሰና ህመንሌ ንአጄሰን፤ እስንስ አመ እሰ ደበርስተኒ ኬንተኒ አጄፍተኒርቱ፤ <verse eid="ACT 7:52"/><verse number="53" style="v" sid="ACT 7:53"/>ወር ከራ ኤርገሞታቲን ሴረ ፉዸተኒ ሴረ ሰናፍ አጀጀሙ ድደንስ እስኑመ።”<verse eid="ACT 7:53"/></para>
  <para style="s1">እስጥፋኖስ ዸጋን ቱመሜ</para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54"/>እሳንስ ዮሙ ዋን ከነ ዸገአንት ኣሪን ጉጉበተኒ እሰት ጭኒነተን። <verse eid="ACT 7:54"/><verse number="55" style="v" sid="ACT 7:55"/>እስጥፋኖስ ገሩ ሀፉረ ቁልቁሉን ጉተሜ ገረ ሰሚ ኦል እላሌ ኡልፍነ ዋቃቲፊ ዬሱስንስ እሳ ምርገ ዋቃ ዻበቴ ጅሩ አርጌ። <verse eid="ACT 7:55"/><verse number="56" style="v" sid="ACT 7:56"/>እንስ፣ “አን ኩኖ ሰሚን በነሜ፣ እልመ ነማስ እሳ ምርገ ዋቃ ዻበቴ ጅሩ ነንአርገ” ጄዼ።<verse eid="ACT 7:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="ACT 7:57"/>ከነረት እሳን ሁንድ ጉረሳኒ ቀበተኒ ሰገሌ ጉዳን እያ እሰት ግርሰን። <verse eid="ACT 7:57"/><verse number="58" style="v" sid="ACT 7:58"/>መጋላ ኬሳስ ገድ እሰ ባሰኒ ዸጋን እሰ ቱሙ ጀልቀበን። ዬሮ ሰነ ዹገ ባቶትን ኡፈተሳኒ ሚለ ደርገጌሰ ሳዉል ጄዸሙ ቶኮ ጀለ ኬወተን።<verse eid="ACT 7:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="ACT 7:59"/>እስጥፋኖስስ ኡቱ እሳን ዸጋን እሰ ቱማ ጅረኑ፣ “ያ ጎፍታ ዬሱስ፣ ሀፉረኮ ፉዸዹ” ጄዼ ከዸቴ። <verse eid="ACT 7:59"/><verse number="60" style="v" sid="ACT 7:60"/>ጅልቤንፈቴስ ሰገሌ ጉዳዻን፣ “ያ ጎፍታ፣ ጩቡ ከነ እሳንት ህንለካእን!” ጄዼ እዬ፤ እንስ ኤርገ ዋን ከነ ዱበቴ ቦዴ ንዱኤ።<verse eid="ACT 7:60"/></para>
  <chapter eid="ACT 7"/>
  <chapter number="8" style="c" sid="ACT 8"/>
  <para style="p">
    <verse number="1" style="v" sid="ACT 8:1"/>ሳዉልስ አጄፈሙ እስጥፋኖስረት ነሞታን ወሊ ገሌ ቱሬ።</para>
  <para style="s1" vid="ACT 8:1">አርአተመ ወልዳ ክርስታና</para>
  <para style="p" vid="ACT 8:1">ጉዩመ ሰነ ወልዳ ክርስታና እሼ ዬሩሳሌም ጅርቱት አርአተምን ጉዳንሳ ከኤ፤ ኤርገሞተ መሌ ወር ካን ሁንድኑ ብየ ይሁዳቲፊ ሰማርያ ሁንደ ኬሰ ብብትናአን። <verse eid="ACT 8:1"/><verse number="2" style="v" sid="ACT 8:2"/>ነሞትን ዋቀ ሶዳተንስ እስጥፋኖስን አዋለን፤ ቦእቸ ጉዳስ ቦአኒፍ። <verse eid="ACT 8:2"/><verse number="3" style="v" sid="ACT 8:3"/>ሳዉል ገሩ ወልዳ ክርስታና በሌሱ ጀልቀቤ፤ እንስ መነ ቶኮራ ገረ መነ ብራ ዸቄ ዺራፊ ዱበርቲ ለፈረ ሀርክሴ መነ ህዻት ገልቻ ቱሬ።<verse eid="ACT 8:3"/></para>
  <para style="s1">ፊልጶስ ሰማርያ ኬሰት</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 8:4"/>ወር ብትናአን ሱን ለፈ ዸቀን ሁንደት ዱቢ ሰነ ለለበን። <verse eid="ACT 8:4"/><verse number="5" style="v" sid="ACT 8:5"/>ፊልጶስስ ገረ መጋላ ሰማርያ ቶኮት ገድ ቡኤ አችት ክርስቶስ ለለቤ። <verse eid="ACT 8:5"/><verse number="6" style="v" sid="ACT 8:6"/>ነሞትን ሱንስ ዮሙ ዋን ፊልጶስ ዱበቱ ዸገአኒ ድንቂ እን ሆጄቱ አርገንት ሁንድሳኒ ቀልቤፈተኒ እሰ ዸገአን። <verse eid="ACT 8:6"/><verse number="7" style="v" sid="ACT 8:7"/>ሀፉር ጡራኣንስ ሰገሌ ጉዳን እዬ ነመ ሄዱ ኬሳ በኤ፤ ወር ላምሸአኒፊ ወር ናፈተን ባይኤንስ ንፈየን። <verse eid="ACT 8:7"/><verse number="8" style="v" sid="ACT 8:8"/>ከናፍስ ገመቹ ጉዳቱ መጋላ ሰነ ኬሰት ተኤ።<verse eid="ACT 8:8"/></para>
  <para style="s1">ስሞን ፈልፈልትቸ</para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 8:9"/>ገሩ ዬሮ ሰናን ዱረ ነምች ስሞን ጄዸሙ ቶኮ መጋላ ሰነ ኬሰት ፈልፈለ ሆጄቴ ነሞተ ሰማርያ ሁንደ ድንቅሲሳ ቱሬ፤ እንስ አከ ዋን ነመ ጉዳ ተኤት ኦፍ ሄዳ ቱሬ። <verse eid="ACT 8:9"/><verse number="10" style="v" sid="ACT 8:10"/>ነሞትን ሁንድኑ ጥና ጉዳን ቀልቢሳኒ ገረሳት ዴብፈተኒ፣ “ነምች ኩን ሁምነ ዋቃ እሰ ‘ሁምነ ጉዳ’ ጄዸሙ ሰናዸ” ጄዸኒ እሰ ሳደን። <verse eid="ACT 8:10"/><verse number="11" style="v" sid="ACT 8:11"/>ነሞትን ሱንስ ሰበቢ እን ዬሮ ዼራ ፈልፈለሳቲን እሳን ድንቅሲሴፍ ቀልቢሳኒ ገረሳት ዴብፈተን። <verse eid="ACT 8:11"/><verse number="12" style="v" sid="ACT 8:12"/>ገሩ ዮሙ ፊልጶስ ወንጌለ ዋኤ ሞቱማ ዋቃቲፊ መቃ ዬሱስ ክርስቶስ ለለቤት አመነኒ ዺራ ዱበርቲን ጩጰመን። <verse eid="ACT 8:12"/><verse number="13" style="v" sid="ACT 8:13"/>ስሞን መታንሳዩ አመኔ ጩጰሜ። እንስ መለቶፊ ድንቂ አርጌ ሰነ ድንቅፈቻ ፊልጶስ ወጅን ዴሜ።<verse eid="ACT 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 8:14"/>ኤርገሞትን ዬሩሳሌም ቱረን አከ ወር ሰማርያ ዱቢ ዋቃ ፉዸተን ዸገአኒ ጴጥሮሲፊ ዮሀንስን እሳንት ኤርገን። <verse eid="ACT 8:14"/><verse number="15" style="v" sid="ACT 8:15"/>ኤርገሞትን ሱንስ ዮሙ አች ገአንት አከ እሳን ሀፉረ ቁልቁሉ አርገተኒፍ ንከዸተኒፍ፤ <verse eid="ACT 8:15"/><verse number="16" style="v" sid="ACT 8:16"/>ሀፉር ቁልቁሉን እሳን ኬሳ ነመ ቶኮረሌ ህንቡኔ ቱሬቲ፤ እሳን መቃ ጎፍታ ዬሱስ ቆፋን ጩጰመኒ ቱረን። <verse eid="ACT 8:16"/><verse number="17" style="v" sid="ACT 8:17"/>ጴጥሮሲፊ ዮሀንስ ሀርከሳኒ ጀረ ሰነረ ከካአን፤ እሳንስ ሀፉረ ቁልቁሉ አርገተን።<verse eid="ACT 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 8:18"/>ስሞን ፈልፈልትችስ አከ ዬሮ ኤርገሞትን ሀርከሳኒ ነመረ ካአን ሀፉር ቁልቁሉን ነማ ኬነሙ አርግናን ኤርገሞታፍ ሆሪ ኬኔ፣ <verse eid="ACT 8:18"/><verse number="19" style="v" sid="ACT 8:19"/>“አከ ነምን አን ሀርከ እረ ካኡ ሁንድ ሀፉረ ቁልቁሉ አርገቱፍ ደንዴቲ ከነ አናፍሌ ኬና” ጄዼን።<verse eid="ACT 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 8:20"/>ጴጥሮስ ገሩ አከነ ጄዼ ዴብሴፍ፤ “ሰበቢ አት ኬና ዋቃ ዋን ሆሪን ብተቹ ደንዴሱ ሴቴፍ ሆሪንኬ ሱመ ወጅን ሃበዱ! <verse eid="ACT 8:20"/><verse number="21" style="v" sid="ACT 8:21"/>ገራንኬ ፉለ ዋቃ ዱረት ዋን ቀጄላ ህንተእኒፍ አት ተጃጅለ ከነ ኬሰት ቆደ ዮካን ጨራ ህንቀብዱ። <verse eid="ACT 8:21"/><verse number="22" style="v" sid="ACT 8:22"/>ከናፍ ሀምነኬ ከነራ ዴብኢቲ ጎፍታ ከዸዹ፤ እን ያደ ገራኬቲ ከነ ሲፍ ዺሰ ተኣቲ። <verse eid="ACT 8:22"/><verse number="23" style="v" sid="ACT 8:23"/>አን አከ አት ያደ ሀዻኣን ጉተምቴፊ አከ አት ገርብቸ ጩቡ ታቴ ነንአርገ።”<verse eid="ACT 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 8:24"/>ስሞንስ፣ “አከ ወን እስን ጄተን ኩን ቶኮዩ ነረ ህንጌኜፍ ጎፍታ ናፍ ከዸዻ” ጄዼ ዴብሴ።<verse eid="ACT 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 8:25"/>ጴጥሮሲፊ ዮሀንስ ኤርገ ዹጋ በአኒ ዱቢ ጎፍታስ ለብሰኒ ቦዴ ገንዶተ ሰማርያ ሄዱ ኬሰት ወንጌለ ለለባ ዬሩሳሌምት ዴብአን።<verse eid="ACT 8:25"/></para>
  <para style="s1">ፊልጶሲፊ ነምቸ እቶጵያ ቶኮ</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26"/>ኤርገማን ጎፍታ ቶኮስ ፊልጶሲን፣ “ከኢቲ ከራ ክባቲን ገረ ዳንዲ ዬሩሳሌሚ በኤ ጋዛት ገድ ቡኡ ሰና ዸቅ” ጄዼ፤ ዳንዲን ሱንስ ዳንዲ ገሞጂት። <verse eid="ACT 8:26"/><verse number="27" style="v" sid="ACT 8:27"/>እንስ ከኤ ዴሜ፤ ከራሳረትስ ጡኣሺ እቶጵያ ቶኮ ጄቹንስ ቆንዳልትቸ ህንደኬ ሞትቲ ሰበ እቶጵያ ከን ቀቤኘሼ ሁንደረት እት ጋፈተማ ተኤ አርጌ፤ ቆንዳል ሱን ሰገዱፍ ጄዼ ዬሩሳሌም ዸቄ ቱሬ። <verse eid="ACT 8:27"/><verse number="28" style="v" sid="ACT 8:28"/>እንስ ዬሮ ብየሳት ዴብኡ ጋሪሳረ ታኤ ክታበ እሳያስ ራጅቻ ዱብፈቻ ቱሬ። <verse eid="ACT 8:28"/><verse number="29" style="v" sid="ACT 8:29"/>ሀፉር ቁልቁሉንስ ፊልጶሲን፣ “ዸቂቲ ጋሪ ሰነት ዽኣዹ” ጄዼ።<verse eid="ACT 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 8:30"/>ፊልጶስስ ጋሪ ሰነት ፊጌ ኡቱ ነምች ሱን ክታበ እሳያስ ራጅቻ ዱብፈቱ ዸገኤ፣ “አት ዋን ዱብፈቱ ከነ ንሁበታ?” ጄዼ ጋፈቴ።<verse eid="ACT 8:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 8:31"/>ነምችስ፣ “ዮ ነምን ናፍ ህንእብስን አን አከሚን ሁበቹ ደንደአ?” ጄዼ። እንስ አከ ፊልጶስ ኦል በኤ እሰ ብረ ታኡፍ ዋመቴ።<verse eid="ACT 8:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 8:32"/>ኩታን ክታባ ከን ጡኣሺን ሱን ዱብሳ ቱሬ እሰ ከነ፦</para>
  <para style="q1" vid="ACT 8:32">“እን አኩመ ሆላ እዶ ቀልማት ጌፈሜ፣</para>
  <para style="q2" vid="ACT 8:32">ዮካን አኩመ እልሞ ሆላ</para>
  <para style="q1" vid="ACT 8:32">ከን ፉለ ነመ ርፌንሰ እራ ሙሙሩ ዱረት ጨልእሱ</para>
  <para style="q2" vid="ACT 8:32">አከሱመ አፋንሳ ህንሳቀትኔ።<verse eid="ACT 8:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="ACT 8:33"/>እን ጩንቁርፈሙሳቲን ሙርቲ ቀጄላ ዾወተሜ፤</para>
  <para style="q2" vid="ACT 8:33">ኤኙቱ ዋኤ ሰኚሳ ዱበቹ ደንደአ?</para>
  <para style="q2" vid="ACT 8:33">ጅሬኝሳ ለፈራ ፉዸተሜራቲ።”<note caller="+" style="f"><char style="fr" closed="false">8፥33 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 53:7">እሳ 53፥7</ref>፣<ref loc="ISA 53:8">8</ref></char></char></note><verse eid="ACT 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 8:34"/>ጡኣሺን ሱንስ ፊልጶሲን፣ “ራጂን ሱን ዋኤ ኤኙ ዱበተ? ዋኤ መታሳሞ ዋኤ ነመ ብራት? ማሎ ሜ ነት ህም!” ጄዼ ጋፈቴ። <verse eid="ACT 8:34"/><verse number="35" style="v" sid="ACT 8:35"/>ፊልጶስስ ኩታዹመ ክታባ ሰናን አፋን ሳቀቴ ኦዱ ጋሪ ዋኤ ዬሱስ እሰት ህሜ።<verse eid="ACT 8:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 8:36"/>እሳንስ ኡቱ ከራ ዴመኑ ብሻንት በአን፤ ጡኣሺን ሱንስ፣ “ኩኖ ብሻን አስ ጅረ፤ ዮስ ማልቱ ጩጰሙ ነ ዾወሬ?” ጄዼን።</para>
  <para style="p" vid="ACT 8:36">[ <verse eid="ACT 8:36"/><verse number="37" style="v" sid="ACT 8:37"/>ፊልጶስስ፣ “አት ዮ ገራኬ ጉቱን አመንቴ ጩጰሙ ንደንዴሰ” ጄዼን።</para>
  <para style="p" vid="ACT 8:37">ነምችስ ዴብሴ፣ “አከ ዬሱስ ክርስቶስ እልመ ዋቃ ተኤ አን ነንአመነ” ጄዼ።]<note caller="+" style="f"><char style="fr" closed="false">8፥37 </char><char style="ft" closed="false">ወራብሌን ዱሪ ቶኮ ቶኮ ኩታ ከነ ህንቀበን።</char></note> <verse eid="ACT 8:37"/><verse number="38" style="v" sid="ACT 8:38"/>እንስ አከ ጋሪን ሱን ዻበቱ አጀጄ፤ እሳን ለማኑ ዸቀኒ ብሻን ሴነን፤ ፊልጶስስ እሰ ጩጴ። <verse eid="ACT 8:38"/><verse number="39" style="v" sid="ACT 8:39"/>ዮሙ እሳን ብሻን ኬሳ በአንትስ ሀፉር ጎፍታ ፊልጶስን ፉዸቴ፤ ጡኣሺን ሱንስ ኤርገሲ እሰ ህንአርግኔ፤ ገሩ ገመዳ ከራሳ እት ፉፌ። <verse eid="ACT 8:39"/><verse number="40" style="v" sid="ACT 8:40"/>ፊልጶስሞ አዞጦንት አርገሜ፤ እንስ ሀመ ቂሳርያ ገኡት መጋላወን ሁንደ ኬሰት ወንጌለ ለለባ ደርቤ።<verse eid="ACT 8:40"/></para>
  <chapter eid="ACT 8"/>
  <chapter number="9" style="c" sid="ACT 9"/>
  <para style="s1">ሳዉል ጅጂረሜ</para>
  <para style="r">
    <ref loc="ACT 9:1-19">9፥1‑19</ref> ኩወፈ – <char style="xt"><ref loc="ACT 22:3-16">ሆጂ 22፥3‑16</ref>፤ <ref loc="ACT 26:9-18">26፥9‑18</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1"/>ግዱዹመ ሰነ ሳዉል በረቶተ ጎፍታ አጄሱፍ ዻደቻ ገረ ሉበ ኦል ኣና ዸቄ፣ <verse eid="ACT 9:1"/><verse number="2" style="v" sid="ACT 9:2"/>ነመ ከራ ከነረ ጅሩ ከምዩ ዺረስ ዱበርቲስ ዮ አርገቴ አከ ህዼ ዬሩሳሌምት ጌሱፍ አከ ሉብን ሱን ገረ መኔን ሰገዳ ከኔን ደማስቆ ጅረኒት ጠለያወን እሳፍ በሬሱፍ እሰ ከዸቴ። <verse eid="ACT 9:2"/><verse number="3" style="v" sid="ACT 9:3"/>ኡቱ እን ዴማ ጅሩ አኩመ ደማስቆት ዽኣቴን አኩመ ተሳ እፍን ቶኮ ሰሚራ ናኖሳት በለቅሴ። <verse eid="ACT 9:3"/><verse number="4" style="v" sid="ACT 9:4"/>እንስ ለፈት ኩፌ ሰገሌ፣ <char style="wj">“ያ ሳዉል፣ ያ ሳዉል፣ አት ማሊፍ ነ አርአተ?”</char> እሳን ጄዹ ቶኮ ዸገኤ።<verse eid="ACT 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 9:5"/>ሳዉልስ፣ “ያ ጎፍታ፣ አት ኤኙ?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="ACT 9:5">እንስ አከነ ጄዼ ዴብሴፍ፤ <char style="wj">“አን ዬሱስ እሰ አት አርአቱዸ። አርፊ ወዪ ዺቱን ሱመ ሚዸ።</char> <verse eid="ACT 9:5"/><verse number="6" style="v" sid="ACT 9:6"/><char style="wj">አመ ከኢ መጋላ ሴን፤ ወን አት ጎቱ ስት ህመማቲ”</char> ጄዼን።<verse eid="ACT 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 9:7"/>ነሞትን ሳዉል ወጅን ዴማ ቱረንስ ዋን ዱበተን ዸበኒ ዸዻበተን፤ እሳንስ ሰገሌ ዸገአን መሌ ነመ ቶኮሌ ህንአርግኔ። <verse eid="ACT 9:7"/><verse number="8" style="v" sid="ACT 9:8"/>ሳዉልስ ለፋ ከኤ፤ እንስ ዮሙ እጅሳ በነሜት ሆማ አርጉ ህንደንዴኜ፤ እሳንስ ሀርከሳ ቀበኒ ደማስቆት እሰ ጌሰን። <verse eid="ACT 9:8"/><verse number="9" style="v" sid="ACT 9:9"/>እጅሳስ ጉያ ሰዲ ጉቱ አርጉ ህንደንዴኜ፤ እንስ ሆማ ህንኛትኔ፤ ሆማስ ህንዹግኔ።<verse eid="ACT 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 9:10"/>ደማስቆ ኬሰ በረታ አናንያ ጄዸሙ ቶኮቱ ቱሬ። ጎፍታንስ ሙልአታን፣ <char style="wj">“ያ ሀናንያ!”</char> ጄዼ እሰ ዋሜ።</para>
  <para style="p" vid="ACT 9:10">እንስ፣ “ያ ጎፍታ፣ ኩኖ አን አስን ጅረ” ጄዼ ዴብሴ።<verse eid="ACT 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 9:11"/>ጎፍታንስ አከነ ጄዼን፤ <char style="wj">“ከኢ ገረ ዳንዲ ‘ቀጄላ’ ጄዸሙ ሰና መነ ይሁዳ ዸቂቲ ነመ ሳዉል ጄዸሙ ከን ጠርሴሲ ዹፌ ቶኮ እያፈዹ፤ እን ከዸትናረ ጅራቲ።</char> <verse eid="ACT 9:11"/><verse number="12" style="v" sid="ACT 9:12"/><char style="wj">ሳዉልስ ነመ አናንያ ጄዸሙ ቶኮ እሳ ዹፌ አከ አገርቱንሳ ዴብኡፊፍ ሀርከ እሰረ ካኡ ሙልአታን አርጌ።”</char><verse eid="ACT 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 9:13"/>አናንያንስ ዴብሴ አከነ ጄዼ፤ “ያ ጎፍታ፣ አን ዋኤ ነምቸ ከና፣ ሚዻ እን ቁልቁሎተኬ ወረ ዬሩሳሌም ጅራተንረት ሆጄቴ ሁንዱማ ዸገኤረ። <verse eid="ACT 9:13"/><verse number="14" style="v" sid="ACT 9:14"/>አመስ ወረ መቃኬ ዋመተን ሁንደ ህዹፍ ጄዼ ሉቦተ ሀንገፎተራ ኣንጎ ፉዸቴ ዹፌረ።”<verse eid="ACT 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 9:15"/>ጎፍታን ገሩ አናንያዻን አከነ ጄዼ፤ <char style="wj">“ነምች ኩን ምአኮ ከን አን አከ እን ነሞተ ኦርማቲፊ ሞቶተሳኒ ዱረት፣ ሰበ እስራኤል ዱረትስ መቃኮ ባቱፍ ጄዼ ፍለዼ ዋን ተኤፍ ከኢ ዸቅ!</char> <verse eid="ACT 9:15"/><verse number="16" style="v" sid="ACT 9:16"/><char style="wj">አን አከ እን መቃኮቲፍ ጄዼ ረከቹ ቀቡ እሰን አርግሲሰ።”</char><verse eid="ACT 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 9:17"/>አናንያንስ ዸቄ መነ ሰነ ሴኔ። ሀርከሳስ ሳዉልረ ካኤ፣ “ያ ኦቦሌሰኮ ሳዉል፣ ጎፍታ ዬሱስ እን ኡቱ አት አስ ዹፍቱ ከራረት ስት ሙልአቴ ሱን አከ አት አርግቱፊ አከ አት ሀፉረ ቁልቁሉን ጉተምቱፍ ነ ኤርጌረ” ጄዼ። <verse eid="ACT 9:17"/><verse number="18" style="v" sid="ACT 9:18"/>ዮሙሱመ ወን አከ ቆላ እጀ ሳዉልራ ሀርጨኤ፤ እን አመስ አርጉ ደንደኤ። ከኤስ ጩጰሜ። <verse eid="ACT 9:18"/><verse number="19" style="v" sid="ACT 9:19"/>ኛተስ ኛቴ ጀጀባቴ።</para>
  <para style="s1" vid="ACT 9:19">ሳዉል ደማስቆፊ ዬሩሳሌምት ለለቤ</para>
  <para style="p" vid="ACT 9:19">ሳዉል ቡልቲ ገባብዱዻፍ በረቶተ ደማስቆ ጅረን ብረ ቡቡሌ። <verse eid="ACT 9:19"/><verse number="20" style="v" sid="ACT 9:20"/>እንስ አከ ዬሱስ እልመ ዋቃ ተኤ ዬሩመ ሰነ መኔን ሰገዳ ኬሰት ለለቡ ጀልቀቤ። <verse eid="ACT 9:20"/><verse number="21" style="v" sid="ACT 9:21"/>ወር እሰ ዸገአን ሁንድኑስ ድንቅፈተኒ አከነ ጄዸን፤ “ነምች ኩን እሱመ ዬሩሳሌም ኬሰት ወረ መቃ ከነ ዋመተን በሌሴ ሰነ ምቲ? አመስ ህዼ ሉቦተ ሀንገፎተት እሳን ጌሱፍ ዹፌ ምቲ?” <verse eid="ACT 9:21"/><verse number="22" style="v" sid="ACT 9:22"/>ሳዉል ገሩ እቱመ ጀባቻ ዴሜ፤ እንስ አከ ዬሱስ ኩን ክርስቶስ ተኤ ምርከኔሱዻን ይሁዶተ ደማስቆ ኬሰ ጅራተን አፋን ቀበቺሴ።<verse eid="ACT 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 9:23"/>ኤርገ ጉያን ሄዱን ደርቤ ቦዴስ ይሁዶትን እሰ አጄሱፍ መርአተን። <verse eid="ACT 9:23"/><verse number="24" style="v" sid="ACT 9:24"/>ሳዉል ገሩ መሪሳኒ ከነ ቤኬ፤ እሳንስ እሰ አጄሱፍ ጄዸኒ ሀልከኒ ጉያ በልበለ መጋላ ሰና ጀቤሰኒ ኤጋ ቱረን። <verse eid="ACT 9:24"/><verse number="25" style="v" sid="ACT 9:25"/>በረቶትንሳ ገሩ ሀልከኒን ፉዸኒ ጉቦዻን ደላ እራን ደበርሰኒ ገድ እሰ ቡሰን።<verse eid="ACT 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26"/>እንስ ዮሙ ገረ ዬሩሳሌም ዹፌት በረቶተት ደበለሙ ያሌ፤ እሳንስ ዋን በረታ ተኡሳ ህንአመንኒፍ ሁንድሳኒ እሰ ሶዳተን። <verse eid="ACT 9:26"/><verse number="27" style="v" sid="ACT 9:27"/>በርናባስሞ ፉዼ ኤርገሞተት እሰ ጌሴ፤ አከ ሳዉል እት ከራት ጎፍታ አርጌ፣ አከ እት ጎፍታን እሰት ዱበቴፊ አከ እን ሶዳ መሌ ደማስቆ ኬሰት መቃ ዬሱሲቲን ለለቤ እሳንት ህሜ። <verse eid="ACT 9:27"/><verse number="28" style="v" sid="ACT 9:28"/>ሳዉልስ እሳን ወጅን ጅራቴ ዬሩሳሌም ኬሰ ሶዳ መሌ በኤ ገላ ቱሬ፤ መቃ ጎፍታቲንስ እጀ ጀብናን ለለቤ። <verse eid="ACT 9:28"/><verse number="29" style="v" sid="ACT 9:29"/>ይሁዶተ ግሪኮተ ኬሰ ጅራተን ወጅንስ ዱበቻ እሳኒንስ ሞርከቻ ቱሬ፤ እሳን ገሩ እሰ አጄሱ በርባደን። <verse eid="ACT 9:29"/><verse number="30" style="v" sid="ACT 9:30"/>ኦቦሎትንስ ዮሙ ዋን ከነ ቤከንት ፉዸኒ ቂሳርያት ገድ እሰ ቡሰን፤ ገረ ጠርሴሲትስ እሰ ኤርገን።<verse eid="ACT 9:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 9:31"/>ከናፍስ ወልዳን ክርስታና ይሁዳ፣ ገሊላፊ ሰማርያ ኬሰ ጅርቱ ጉቱማት ነጋ አርገቴ፤ ንጭምቴስ። እሼንስ ሀፉረ ቁልቁሉዻን ጀጀባቴ ሶዳ ጎፍታቲን ጅራቹዻን ባይእናን ጉደቻ ዴምቴ።<verse eid="ACT 9:31"/></para>
  <para style="s1">ኤንያፊ ዶርቃ</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 9:32"/>ጴጥሮስ ኡቱ ብየ ሰነ ኬሰ ናነኣ ጅሩ ቁልቁሎተ ሊዳ ኬሰ ጅራተን እላሉፍ ገድ ቡኤ። <verse eid="ACT 9:32"/><verse number="33" style="v" sid="ACT 9:33"/>አችትስ ነምቸ ላምሸኣ ኤንያ ጄዸሙ ከን ወጋ ሰዴት ስሬረት ሀፌ ቱሬ ቶኮ አርጌ። <verse eid="ACT 9:33"/><verse number="34" style="v" sid="ACT 9:34"/>ጴጥሮስስ፣ “ያ ኤንያ፣ ዬሱስ ክርስቶስ ስፈይሰ፤ ከኢቲ ስሬኬ አፈዹ” ጄዼን። ኤንያንስ ዮሙሱመ ከኤ። <verse eid="ACT 9:34"/><verse number="35" style="v" sid="ACT 9:35"/>ነሞትን ሊዳፊ ሰሮና ኬሰ ጅራተን ሁንድኑ እሰ አርገኒ ጎፍታት ዴብአን።<verse eid="ACT 9:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36"/>ዮጴ ኬሰስ በረቱ ጣቢታ ጄዸምቱ ቶኮቱ ቱሬ፤ ጣቢታ ጄቹን ዶርቃ ጄቹዸ። እሼንስ ዬሮ ሁንደ ዋን ጋሪ ሆጄት፤ ህዬዪስ ንገርጋርት ቱርቴ። <verse eid="ACT 9:36"/><verse number="37" style="v" sid="ACT 9:37"/>እሼንስ በሩመ ሰነ ኬሰ ዹኩብሰቴ ዱቴ፤ ሬፈሼስ ዽቀኒ ኩታ ደርቢ ቶኮ ኬሰ ካአን። <verse eid="ACT 9:37"/><verse number="38" style="v" sid="ACT 9:38"/>ሊዳን ኩን ዮጴት ዽኦ ቱርቴ፤ በረቶትንስ ዮሙ አከ ጴጥሮስ ሊዳ ጅሩ ዸገአንት ነመ ለመ እሰት ኤርገኒ፣ “ማሎ ደፊ ኑ ብረ ገእ!” ጄዸኒ እሰ ከዸተን።<verse eid="ACT 9:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 9:39"/>ጴጥሮስስ ከኤ እሳን ወጅን ዴሜ፤ አኩመ እን አች ገኤንስ ገረ ኩታ ደርቢ ሰናት እሰ ጌሰን። ሃዾትን ህዬሳ ሁንድኑ እሰ ብረ ዻበተኒ ኮቲፊ ወያ ብራ ከን ዶርቃን ዬሮ እሳን ወጅን ቱርቴ ሆጄቴ ሰነ እሰት አርግሲሰኒ ቦኣ ቱረን።<verse eid="ACT 9:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 9:40"/>ጴጥሮስስ ሁንደሳኒ ገድ ባሴ ጅልቤንፈቴ ዋቀ ከዸቴ፤ ሬፈ ሰነትስ ገረ ገሌ፣ “ጣቢታ ከእ!” ጄዼ። እሼንስ እጀሼ በነቴ ጴጥሮስን አርግቴ፤ ካቴስ ንቴሴ። <verse eid="ACT 9:40"/><verse number="41" style="v" sid="ACT 9:41"/>እንስ ሀርከ ቀቤ እሼ ካሴ፤ አመንቶታፊ ዱበርቶተ ዽርሶትንሳኒ እራ ዱአን ዋሜ ጅራቱ ታቴ እሳን ፉልዱረ ዻቤ። <verse eid="ACT 9:41"/><verse number="42" style="v" sid="ACT 9:42"/>ኩንስ ዮጴ ሁንደ ኬሰት ቤከሜ፤ ነሞትን ባይኤንስ ጎፍታት አመነን። <verse eid="ACT 9:42"/><verse number="43" style="v" sid="ACT 9:43"/>ጴጥሮስስ ዮጴ ኬሰ ጎጋ ዱግዱ ስሞን ጄዸሙ ቶኮ ብረ ጉያ ሄዱ ቱሬ።<verse eid="ACT 9:43"/></para>
  <chapter eid="ACT 9"/>
  <chapter number="10" style="c" sid="ACT 10"/>
  <para style="s1">ቆርኔሌዎስ ጴጥሮስን ዋሜ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1"/>ነምች ቆርኔሌዎስ ጄዸሙ ቶኮ ቂሳርያ ኬሰ ቱሬ፤ እንስ ኩታ፣ “ሁምነ ወራነ ኢጣልያ” ጄዸሙ ኬሰት አጀጃ ዽባ ቱሬ። <verse eid="ACT 10:1"/><verse number="2" style="v" sid="ACT 10:2"/>ቆርኔሌዎሲፊ ማቲንሳ ሁንድኑ ወረ ዋቃፍ ቡለኒፊ ወረ ዋቀ ሶዳተን ቱረን፤ እንስ ወረ ረከተኒፍ አርጁማዻን ኬነ ቱሬ፤ ዬሮ ሁንደስ ዋቀ ከዸተ ቱሬ። <verse eid="ACT 10:2"/><verse number="3" style="v" sid="ACT 10:3"/>እንስ ጋፈ ቶኮ ኤርገማ ዋቃ ቶኮ እሳ ገረሳ ዹፌ፣ “ያ ቆርኔሌዎስ!” ጄዹን ጉያ ኬሳ ገረ ሰኣቲ ሰገሊት እፋን እፈት ሙልአታን አርጌ።<verse eid="ACT 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 10:4"/>ቆርኔሌዎስስ ሶዳን እጀ በባሴ እሰ እላሌ፣ “ያ ጎፍታ፣ ማል በርባደ?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="ACT 10:4">ኤርገማን ዋቃ ሱንሞ አከነ ጄዼ ዴብሴ፤ “ከዸትናኬቲፊ ኬናን አት ህዬዪዻፍ ኬንቱ ኣርሳ ያደቻ ተኤ ፉለ ዋቃ ዱረት ኦል በኤረ። <verse eid="ACT 10:4"/><verse number="5" style="v" sid="ACT 10:5"/>አመ ዮጴት ነመ ኤርጊቲ ስሞን እሰ ጴጥሮስ ጄዸሙ ሰነ አስ ፍችሲስ። <verse eid="ACT 10:5"/><verse number="6" style="v" sid="ACT 10:6"/>እንስ ነምቸ ጎጋ ዱጉ ከን ስሞን ጄዸሙ ከን መንሳ ቀርቀረ ገላናት አርገሙ ቶኮ ብረ ጅረ።”<verse eid="ACT 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 10:7"/>ቆርኔሌዎስስ ዮሙ ኤርገማን ዋቃ ከን እሰት ዱበቴ ሱን ዴሜት ተጃጅልቶተሳ ኬሳ ነመ ለመ፣ ወረ እሰ ኤገን ኬሳሞ ሎልቱ ዋቃፍ ቡሉ ቶኮ ዋሜ፣ <verse eid="ACT 10:7"/><verse number="8" style="v" sid="ACT 10:8"/>ዋን ከነ ሁንደ እት ህሜ ዮጴት እሳን ኤርጌ።<verse eid="ACT 10:8"/></para>
  <para style="s1">ሙልአተ ጴጥሮስ አርጌ ቶኮ</para>
  <para style="r">
    <ref loc="ACT 10:9-32">10፥9‑32</ref> ኩወእ – <char style="xt"><ref loc="ACT 11:5-14">ሆጂ 11፥5‑14</ref></char></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9"/>ጉያ እት ኣኑትስ ኡቱ ወር ኤርገመን ሱን ከራ ጅረኑ፣ ዬሮ መጋላት ዽኣተንት ጴጥሮስ ገረ ሰኣቲ ጀኣት ከዸትናፍ በንቲ መናት ኦል በኤ። <verse eid="ACT 10:9"/><verse number="10" style="v" sid="ACT 10:10"/>እንስ ቤለኤ ዋን ኛቱ በርባዴ፤ ኡቱ እሳን ቆጴሳፊ ጅረኑስ አከ ዋን ያዳን ፉዸተሜ ተኤ። <verse eid="ACT 10:10"/><verse number="11" style="v" sid="ACT 10:11"/>ሰሚ በነሜፊ ዋን አከ ወያ በልኣ ቶኮስ እሳ ሮገሳ አፍረኒን ቀበሜ ለፈት ገድ ቡፈሙ አርጌ። <verse eid="ACT 10:11"/><verse number="12" style="v" sid="ACT 10:12"/>ወያን ሱንስ ብኔንሶተ ሚለ አፉሪ፣ ኡመመወን ለፈረ ሎአኒፊ ስምብሮተ ሰሚ ከኔን ጎሰ ሁንዳ ኦፍ ኬሳ ቀበ ቱሬ። <verse eid="ACT 10:12"/><verse number="13" style="v" sid="ACT 10:13"/>ሰገሌን ቶኮስ፣ <char style="wj">“ያ ጴጥሮስ፣ ከኢቲ ቀለዹ ኛዹ”</char> ጄዼን።<verse eid="ACT 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 10:14"/>ጴጥሮስ ገሩ ዴብሴ፣ “ያ ጎፍታ፣ ህንተኡ! አን ተኩማ ዋን በልፈማ ዮካን ዋን ጡራኣ ህንኛትኔ” ጄዼ።<verse eid="ACT 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 10:15"/>ሰገሌን ሱንስ ዬሮ ለመፋ፣ <char style="wj">“አት ዋን ዋቅን ቁልቁሌሴን ጡራኣ ህንጄዽን”</char> ጄዼን።<verse eid="ACT 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 10:16"/>ወን ኩንስ ዬሮ ሰዲ ተኤ፤ ወያን ሱንስ ዮሙሱመ ዴብኤ ሰሚት ኦል ፉዸተሜ።<verse eid="ACT 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 10:17"/>ኡቱ ጴጥሮስ ዋኤ ሂካ ሙልአተ ሰና ድንቅሲፈቻ ጅሩስ ነሞትን ቆርኔሌዎስ ኤርጌ ሱን መነ ስሞን እያፈቻ ዹፈኒ ከረ ዱረ ዻበተን። <verse eid="ACT 10:17"/><verse number="18" style="v" sid="ACT 10:18"/>እሳንስ ለለበኒ፣ “ስሞን እን ጴጥሮስ ጄዸሙ ቶኮ አስ ጅራ?” ጄዸኒ ጋፈተን።<verse eid="ACT 10:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 10:19"/>አመስ ኡቱ ጴጥሮስ ዋኤ ሙልአተ ሰና ያዳ ጅሩ፣ ሀፉር ቁልቁሉን አከነ እሳን ጄዼ፤ “ያ ስሞን፣ ኩኖ ነሞትን ሰዲ ስ በርባዱት ጅሩ። <verse eid="ACT 10:19"/><verse number="20" style="v" sid="ACT 10:20"/>ከኢቲ ገድ ቡእ። እሳን ወጅን ዴሙስ ህንሸክን፤ አነቱ እሳን ኤርጌቲ።”<verse eid="ACT 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 10:21"/>ጴጥሮስስ ገረ ነሞተ ሰናት ገድ ቡኤ፣ “ነምን እስን በርባዳ ጅርተን አነ፤ ማሊፍ ዹፍተን?” ጄዼን።<verse eid="ACT 10:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 10:22"/>ጀር ሱንስ አከነ ጄዸኒ ዴብሰን፤ “ኑ አጀጃ ዽባ ከን ቆርኔሌዎስ ጄዸሙ ቶኮ ብራ ዹፍኔ፤ እን ነመ ቀጄላፊ ነመ ዋቀ ሶዳቱ ከን ይሁዶተ ሁንደ ብረትስ ከበጀሙዸ፤ ኤርገማን ዋቃ ቁልቁሉን ቶኮ አከ እን መነሳት ስዋምስሴ ዋን አት ጄቱ ዸገኡፍ እሰት ዱበቴ።” <verse eid="ACT 10:22"/><verse number="23" style="v" sid="ACT 10:23"/>ጴጥሮስስ ነሞተ ሰነ መነት ኦል ገልቼ ኬሱምሲሴ።</para>
  <para style="s1" vid="ACT 10:23">ጴጥሮስ መነ ቆርኔሌዎስ ዸቄ</para>
  <para style="p" vid="ACT 10:23">ጉያ እት ኣኑት ጴጥሮስ ከኤ እሳን ወጅን ዴሜ፤ ኦቦሎትን ቶኮ ቶኮስ ዮጴዻ ከአኒ እሰ ወጅን ዴመን። <verse eid="ACT 10:23"/><verse number="24" style="v" sid="ACT 10:24"/>እሳንስ ጉያ እት ኣኑ ቂሳርያት ገለን፤ ቆርኔሌዎስስ ፍሮተሳቲፊ ምቾተሳ ወረ እሰት ዽኣተን ወልት ዋሜ እሳን ኤጋ ቱሬ። <verse eid="ACT 10:24"/><verse number="25" style="v" sid="ACT 10:25"/>አኩመ ጴጥሮስ መነ ሴኔን ቆርኔሌዎስ እሰ ስመቴ እሳፍ ሰገዱፍ ጄዼ ሚለሳረት ኩፌ። <verse eid="ACT 10:25"/><verse number="26" style="v" sid="ACT 10:26"/>ጴጥሮስ ገሩ፣ “ከእ! አንስ ነሙማቲ” ጄዼ ኦል እሰ ቀቤ።<verse eid="ACT 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 10:27"/>ጴጥሮስስ እሰ ወጅን ዱዱበቻ መነ ሴኔ ነሞተ ወልት ቀበመን ሄዱ አርጌ። <verse eid="ACT 10:27"/><verse number="28" style="v" sid="ACT 10:28"/>እንስ አከነ እሳኒን ጄዼ፤ “አከ ይሁዲን ቶኮ ነመ ኦርማ ወጅን ቶኩማ ቀባቹፊ እት ዽኣቹን ሴረኬኘ ህንተእን እስን መታንኬሰንዩ ቤክቱ፤ ገሩ ዋቅን አከ አን ነመ ቶኮኑ ጅበማ ዮካን ጡራኣ ህንጄኔ ነት አርግሲሴረ። <verse eid="ACT 10:28"/><verse number="29" style="v" sid="ACT 10:29"/>ከናፍ ዮሙ እስን ነመ ነት ኤርግተንት አን ሞርሚ ቶኮ መሌ ዹፌ፤ ኤጋ ዋን እስን ነ ዋምተኒፍ ቤኩ ነንበርባደ።”<verse eid="ACT 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 10:30"/>ቆርኔሌዎስስ አከነ ጄዼ ዴብሴ፦ “ቡልቲ አፉሪን ዱረ፣ ሰኣቲዹመ ከነት፣ አን ሰኣቲ ሰገልት መነኮት ዋቀ ከዸቻን ቱሬ። አኩመ ተሳ ነምች ወያ አዲ ቃንቄ ኡፈቱ ቶኮ ነ ዱረ ዻበቴ <verse eid="ACT 10:30"/><verse number="31" style="v" sid="ACT 10:31"/>አከነ ጄዼ፤ ‘ያ ቆርኔሌዎስ፣ ዋቅን ከዸትናኬ ዸገኤረ፤ ኬና አት ህዬዪፍ ኬንቱስ ያደቴረ። <verse eid="ACT 10:31"/><verse number="32" style="v" sid="ACT 10:32"/>ዮጴት ነመ ኤርጊቲ ስሞን እሰ ጴጥሮስ ጄዸሙ ሰነ ዋምስስ። እን መነ ስሞን ነምቸ ጎጋ ዱጉ ከን ቀርቀረ ገላና ጅራቱ ሰና ጅረ።’ <verse eid="ACT 10:32"/><verse number="33" style="v" sid="ACT 10:33"/>ከናፍ አን ዬሩመ ሰነ ነመ ኤርጌ ስዋምስሴ፤ አትስ በገ ዹፍቴ። ኤጋ ኑ ሁንድኑ ዋን አከ አት ኑት ህምቱ ጎፍታን ስ አጀጄ ሁንደ ዸገኡፍ ጄኔ አስ ፉለ ዋቃ ዱረ ጅረ።”<verse eid="ACT 10:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 10:34"/>ጴጥሮስስ አከነ ጄዼ ዱበቹ ጀልቀቤ፤ “አን አመ አከ ዋቅን ነመ ወል ህንጫልችፍኔ ዹጉማን ነንሁበዸ። <verse eid="ACT 10:34"/><verse number="35" style="v" sid="ACT 10:35"/>ገሩ ሰበ ሁንዱማ ኬሳ ነምን እሰ ሶዳቱፊ ነምን ዋን ቀጄላ ሆጄቱ ከምዩ ፉለሳ ዱረት ፉዸተማዸ። <verse eid="ACT 10:35"/><verse number="36" style="v" sid="ACT 10:36"/>እስን ኤርጋ ዋቅን ከራ ዬሱስ ክርስቶሲን ነጋ ለብሱዻን ሰበ እስራኤልት ኤርጌ ሰነ ቤክቱ፤ ዬሱስ ክርስቶስ ኩን ጎፍታ ዋን ሁንዳት። <verse eid="ACT 10:36"/><verse number="37" style="v" sid="ACT 10:37"/>እስን ዋን ጩጳ ዮሀንስ ለለቤ ቦዴ ገሊላዻ ጀልቀቤ ይሁዳ ሁንደ ኬሰት ተኤ ሰነ ንቤክቱ። <verse eid="ACT 10:37"/><verse number="38" style="v" sid="ACT 10:38"/>ኩንስ አከ ዋቅን ዬሱስ ነመ ናዝሬት ሰነ ሀፉረ ቁልቁሉፊ ሁምናን ድቤፊ አከ ዬሱስ ዋን ጋሪ ሆጄቻፊ ወረ ሁምነ ዲያብሎስ ጀለ ቱረን ፈይሳ ብየ ሁንደ ኬሰ ነናነኤዸ፤ ዋቅን እሰ ወጅን ቱሬቲ።<verse eid="ACT 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 10:39"/>“ኑስ ዋን እን ብየ ይሁዶታቲፊ ዬሩሳሌም ኬሰት ሆጄቴ ሁንዳፍ ዹገ ባቶተ። እሳንስ ፈኖረት ፈንሰኒ እሰ አጄሰን። <verse eid="ACT 10:39"/><verse number="40" style="v" sid="ACT 10:40"/>ዋቅንሞ ጉያ ሰደፋት ወረ ዱአን ኬሳ እሰ ካሴ፤ አከ እን ነመት ሙልአቱስ ጎዼ። <verse eid="ACT 10:40"/><verse number="41" style="v" sid="ACT 10:41"/>እን ነመ ሁንደት ህንሙልአትኔ፤ ገሩ ኑ ዹገ ባቶተ ዋቅን ዱራን ዱርሴ ፍለቴቲፊ ኤርገ እን ወረ ዱአን ኬሳ ከኤ ቦዴ እሰ ወጅን ኛትኔ ዹግኔት ሙልአቴ። <verse eid="ACT 10:41"/><verse number="42" style="v" sid="ACT 10:42"/>እንስ አከ ኑ ነሞተት ለለብኑፊ አከ እን ነመ ዋቅን ወረ ጅረኒፊ ወረ ዱአንረት አባ ሙርቲ ጎዼ ሙዴ ተኤ አከ ዹጋ ባኑፍ ኑ አጀጄ። <verse eid="ACT 10:42"/><verse number="43" style="v" sid="ACT 10:43"/>ራጆትን ሁንድኑ አከ ነምን እሰት አመኑ ሁንድ መቃሳቲን ዺፈመ ጩቡ አርገቱ ዋኤሳ ዹጋ በኡ።”<verse eid="ACT 10:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44"/>ኡቱመ ጴጥሮስ አመሌ ዋን ከነ ዱበቻ ጅሩ፣ ሀፉር ቁልቁሉን ወረ ዱቢ ሰነ ዸገኣ ቱረን ሁንደረ ቡኤ። <verse eid="ACT 10:44"/><verse number="45" style="v" sid="ACT 10:45"/>አመንቶትን ዸግነ ቀበተን ከኔን ጴጥሮስ ወጅን ዹፈን ሱን ዋን ኬናን ሀፉረ ቁልቁሉ ነሞተ ኦርማረትሌ ዸንገለኤፍ ንድንቅፈተን፤ <verse eid="ACT 10:45"/><verse number="46" style="v" sid="ACT 10:46"/>እሳን ጀራ አፋን ሃራ ዱበተኒፊ ዋቀስ ጀጀተን ዸገአኒሩቲ።</para>
  <para style="p" vid="ACT 10:46">ጴጥሮስስ አከነ ጄዼ፤ <verse eid="ACT 10:46"/><verse number="47" style="v" sid="ACT 10:47"/>“አከ ነሞትን አኩመኬኘ ሀፉረ ቁልቁሉ አርገተን ኩኔን ህንጩጰምኔፍ ነምን ብሻን ዾወቹ ደንደኡ ኤኙ?” <verse eid="ACT 10:47"/><verse number="48" style="v" sid="ACT 10:48"/>እንስ አከ እሳን መቃ ዬሱስ ክርስቶስት ጩጰመን አጀጄ፤ እሳንስ አከ ጴጥሮስ ቡልቲ ጥኖ እሳን ብረ ቱሩፍ እሰ ከዸተን።<verse eid="ACT 10:48"/></para>
  <chapter eid="ACT 10"/>
  <chapter number="11" style="c" sid="ACT 11"/>
  <para style="s1">ጴጥሮስ ዋን ሆጄቴ ገባሴ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1"/>ኤርገሞትኒፊ ኦቦሎትን ይሁዳ ኬሰ ጅረን አከ ነሞትን ኦርማስ ዱቢ ዋቃ ፉዸተን ዸገአን። <verse eid="ACT 11:1"/><verse number="2" style="v" sid="ACT 11:2"/>ከናፍ ዮሙ ጴጥሮስ ዬሩሳሌምት ኦል በኤት አመንቶትን ዸግነ ቀበተን እሳን ሞርመን፤ <verse eid="ACT 11:2"/><verse number="3" style="v" sid="ACT 11:3"/>አከነስ ጄዸን፤ “አት ማሊፍ መነ ነሞተ ዸግነ ህንቀበትኒ ዸቅጤ እሳን ወጅን ኛቴ?”<verse eid="ACT 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 11:4"/>ጴጥሮስስ አከነ ጄዼ ዋን ተኤ ሰነ ቶኮ ቶኮን እሳኒ እብሱ ጀልቀቤ። <verse eid="ACT 11:4"/><verse number="5" style="v" sid="ACT 11:5"/>“አን መጋላ ዮጴ ኬሰት ከዸትናረን ቱሬ፤ አከ ዋን ያዳን ፉዸተሙስ ተኤ ዋን አከ ወያ በልኣ ቶኮ እሳ ሮገሳ አፍረኒን ቀበሜ ሰሚራ ገድ ቡፈሙ ሙልአታን አርጌ። እንስ እዶ አን ቱሬት ገድ ዹፌ። <verse eid="ACT 11:5"/><verse number="6" style="v" sid="ACT 11:6"/>አንስ ጥዬፈዼ እላሌ ብኔንሶተ ሚለ አፉሪ፣ ብኔንሶተ ቦሶና፣ ኡመመወን ለፈረ ሎአኒፊ ስምብሮተ ሰሚ ነንአርጌ። <verse eid="ACT 11:6"/><verse number="7" style="v" sid="ACT 11:7"/>አንስ ሰገሌ፣ <char style="wj">‘ያ ጴጥሮስ፣ ከኢቲ ቀለዹ ኛዹ’</char> ናን ጄዹ ቶኮን ዸገኤ።<verse eid="ACT 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 11:8"/>“አን ገሩ ዴብሴ፣ ‘ያ ጎፍታ፣ ህንተኡ! ተኩማ ወን በልፈማን ዮካን ወን ጡራኣን ቶኮዩ አፋንኮ ህንሴኔ’ ጄዼ።<verse eid="ACT 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 11:9"/>“ሰገሌን ሱንስ ዬሮ ለመፋ ሰሚራ፣ <char style="wj">‘አት ዋን ዋቅን ቁልቁሌሴን ጡራኣ ህንጄዽን’</char> ጄዼ። <verse eid="ACT 11:9"/><verse number="10" style="v" sid="ACT 11:10"/>ወን ኩንስ ዬሮ ሰዲ ተኤ፤ ከነ ቦዴስ ሁንዱምትሳ አመሌ ሰሚት ኦል ፉዸተሜ።<verse eid="ACT 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 11:11"/>“ዮሙሱመ ነሞትን ቂሳርያዻ ነት ኤርገመን ሰዲ መነ አን ጅራቻ ቱሬ ሰነ ዱረ ዻበተን። <verse eid="ACT 11:11"/><verse number="12" style="v" sid="ACT 11:12"/>ሀፉርስ አከ አን ሸኪ ቶኮ መሌ እሳን ወጅን ዴሙ ነት ህሜ። ኦቦሎትን ኩኔን ጀኣንስ ነ ወጅን ዴመን፤ ኑስ መነ ነምቻ ኦል ሴኔ። <verse eid="ACT 11:12"/><verse number="13" style="v" sid="ACT 11:13"/>እንስ አከ ኤርገማ ዋቃ ከን መነሳ ኬሰት እት ሙልአቴ ቶኮ አርጌ ኑት ህሜ፤ ኤርገማን ሱንስ አከነ እሳን ጄዼ፤ ‘ዮጴት ነመ ኤርጊቲ ስሞን እሰ ጴጥሮስ ጄዸሙ ሰነ ዋምስስ፤ <verse eid="ACT 11:13"/><verse number="14" style="v" sid="ACT 11:14"/>እን ኤርጋ ሲፊ ነሞትን መነኬቲ ሁንድኑ እቲን ፈይተን ስት ህመ።’<verse eid="ACT 11:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 11:15"/>“አኩመ አን ዱበቹ ጀልቀቤን፣ ሀፉር ቁልቁሉን አኩመ ጀልቀበት ኑረ ቡኤ ሰነ እሳንረስ ቡኤ። <verse eid="ACT 11:15"/><verse number="16" style="v" sid="ACT 11:16"/>አንስ ዋን ጎፍታን፣ <char style="wj">‘ዮሀንስ ብሻኒን ጩጴ፤ እስን ገሩ ሀፉረ ቁልቁሉዻን ጩጰምቱ’</char> ጄዼ ቱሬ ሰነ ነንያደዼ። <verse eid="ACT 11:16"/><verse number="17" style="v" sid="ACT 11:17"/>ከናፉ ኤርገ ዋቅን ኬናዹመ ዬሮ ኑ ጎፍታ ዬሱስ ክርስቶስት አመኔ ኑ ኬኔ ሰነ እሳኒፍስ ኬኔ ዋቃን ሞርሙፍ አን ኤኙ?”<verse eid="ACT 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 11:18"/>እሳንስ ዋን ከነ ዸገአኒ ጨልእሰን፤ “ዮስ ዋቅን ቀልቢ ጅጂረተኒ ጅራቹ ነሞተ ኦርማቲፍስ ኬኔረ” ጄዸኒ ዋቀ ገለቴፈተን።<verse eid="ACT 11:18"/></para>
  <para style="s1">ወልዳ ክርስታና አንጦኪያ</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19"/>ወር ሰበቢ አርአተመ እስጥፋኖስት ከኤቲን ብትናአኒ ቱረን ሱን ኤርጋ ሰነ ይሁዶተ ቆፈት ህማ ሀመ ፊንቄ፣ ቆጵሮሲፊ አንጦኪያት ዴመን። <verse eid="ACT 11:19"/><verse number="20" style="v" sid="ACT 11:20"/>እሳን ኬሳ ነሞትን ቆጵሮሲፊ ቀሬናራ ዹፈን ቶኮ ቶኮ ገሩ አንጦኪያ ዸቀኒ ኦዱ ጋሪ ዋኤ ጎፍታ ዬሱስ ግሪኮተትስ ህሙ ጀልቀበን። <verse eid="ACT 11:20"/><verse number="21" style="v" sid="ACT 11:21"/>ሀርክ ጎፍታ እሳን ወጅን ቱሬ፤ ነሞትን ሄዱንስ አመነኒ ጎፍታት ዴብአን።<verse eid="ACT 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 11:22"/>ኦዱን ኩንስ ጉረ ወልዳ ክርስታና እሼ ዬሩሳሌም ጅርቱ ሴኔ፤ እሳንስ በርናባስን አንጦኪያት ኤርገን። <verse eid="ACT 11:22"/><verse number="23" style="v" sid="ACT 11:23"/>እንስ ዮሙ አች ገኤ አያነ ዋቃ አርጌት ንገመዴ፤ አከ እሳን ገራ ቶኮን ጎፍታፍ አመነመኒ ጅራተኒፍስ እሳን ሁንደ ጀጀቤሴ። <verse eid="ACT 11:23"/><verse number="24" style="v" sid="ACT 11:24"/>እን ነመ ጋሪ ሀፉረ ቁልቁሉፊ አመንቲዻን ጉተሜ ቱሬ፤ ነሞትን ባይኤንስ ጎፍታት ደበለመን።<verse eid="ACT 11:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 11:25"/>በርናባስስ ሳዉልን በርባዱፍ ጄዼ ጠርሴስ ዸቄ፤ <verse eid="ACT 11:25"/><verse number="26" style="v" sid="ACT 11:26"/>ዮሙ እሰ አርጌትስ አንጦኪያት እሰ ጌሴ። እሳንስ ወጋ ቶኮ ጉቱ ወልዳ ሰናን ወል ገአኒ ነሞተ ባይኤ በርሲሰን። በረቶትንስ ዬሮ ጀልቀባቲፍ አንጦኪያት፣ “ክርስታነ” ጄዸመን።<verse eid="ACT 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 11:27"/>ግዱዹመ ሰነ ራጆትን ቶኮ ቶኮ ዬሩሳሌሚ ከአኒ አንጦኪያት ገድ ቡአን። <verse eid="ACT 11:27"/><verse number="28" style="v" sid="ACT 11:28"/>እሳን ኬሳስ ነምች አጋቦስ ጄዸሙ ቶኮ ከኤ ዻበቴ አከ ቤል ጉዳንሳ አዱኛ ሁንደረት ቡኡ ሀፉራን ዱበቴ። ወን ኩንስ በረ ሞኡምሰ ቀላዉዴዎስ ቄሳር ኬሰ ተኤ። <verse eid="ACT 11:28"/><verse number="29" style="v" sid="ACT 11:29"/>በረቶትንስ ቶኮን ቶኮንሳኒ አኩመ ደንዴቲሳኒት ኦቦሎተ ይሁዳ ኬሰ ጅራተን ገርጋሩ ሙርቴሰን። <verse eid="ACT 11:29"/><verse number="30" style="v" sid="ACT 11:30"/>እሳንስ ሀርከ በርናባሲፊ ሀርከ ሳዉልት ገርጋርሰሳኒ ማንጉዶታት ኤርጉን ገርጋርሰ ኬነን።<verse eid="ACT 11:30"/></para>
  <chapter eid="ACT 11"/>
  <chapter number="12" style="c" sid="ACT 12"/>
  <para style="s1">ጴጥሮስ ድንቂዻን መነ ህዻቲ በኤ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1"/>በሩመ ሰነ ኬሰ ሄሮድስ ሞትች እሳን አርአቹፍ ጄዼ ምሴንሶተ ወልዳ ክርስታና ቶኮ ቶኮ ቀቤ። <verse eid="ACT 12:1"/><verse number="2" style="v" sid="ACT 12:2"/>እንስ ያቆብ ኦቦሌሰ ዮሀንስ ጎራዴን አጄሴ። <verse eid="ACT 12:2"/><verse number="3" style="v" sid="ACT 12:3"/>ዮሙ አከ ወን ኩን ይሁዶተ ገመቺሴ አርጌትስ፣ እቱመ ፉፌ ጴጥሮስንስ ቀብሲሴ። ወን ኩንስ ዬሮ አያነ መጥኖ ኬሰ ተኤ። <verse eid="ACT 12:3"/><verse number="4" style="v" sid="ACT 12:4"/>ኤርገ እሰ ቀቤ ቦዴ አከ እሳን እሰ ኤገኒፍ ጄዼ ገሬወን ሎልቶታ አፉር ከኔን ቶኮን ቶኮንሳኒ ሎልቶተ አፉር አፉር ኦፍ ኬሳ ቀበንት ደበርሴ እሰ ኬኑዻን፣ መነ ህዻ ኬሰ እሰ ቡሴ፤ ከነስ አያነ ፋሲካ ቦዴ ፉለ ኡመታ ዱረት ዽኤሴ እሰ ቆሩፍ ጎዼ።<verse eid="ACT 12:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 12:5"/>ከናፉ ጴጥሮስ መነ ህዻ ኬሰት ኤገማ ቱሬ፤ ወልዳን ክርስታና ገሩ ጀቤስቴ ዋኤሳቲፍ ዋቀ ከዸቻ ቱርቴ።<verse eid="ACT 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 12:6"/>ኤዱምቲ ጉያ ሄሮድስ እት ጴጥሮስን ዽኤሱፍ ቱሬ ሰና ጴጥሮስ ፎንጫ ለማን ህዸሜ ሎልቶተ ለመ ግዱ ረፋ ቱሬ፤ ሎልቶትን ካንስ በልበለ ዱረ ዻበተኒ መነ ህዻ ሰነ ኤጋ ቱረን። <verse eid="ACT 12:6"/><verse number="7" style="v" sid="ACT 12:7"/>አኩመ ተሳስ፣ ኤርገማን ጎፍታ ቶኮ ሙልአቴ፤ ኩታ መነ ህዻ ሰነ ኬሰትስ እፍን እፌ፤ ኤርገማን ሱንስ ጭናቸ ጴጥሮስ ቱቄ እሰ ደመቅሱዻን፣ “ደፊ ከእ!” ጄዼን። ፎንጫን ሱንስ ሀርከሳራ ሀርጨኤ።<verse eid="ACT 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 12:8"/>ኤርገማን ዋቃ ሱንስ፣ “ኡፈተኬ ኡፈዹ፤ ኮጴኬስ ካአዹ” ጄዼን። ጴጥሮስስ አከሱመ ጎዼ። ኤርገማን ሱንስ፣ “ወያኬ መርጥፈዹቲ ነ ፋነ ቡእ” ጄዼን። <verse eid="ACT 12:8"/><verse number="9" style="v" sid="ACT 12:9"/>ጴጥሮስስ እሰ ዱካ ቡኤ መነ ህዻቲ በኤ፤ እንስ ዋን ሙልአተ አርጉ ሴኤ መሌ አከ ወን ኤርገማን ዋቃ ሆጄቻ ቱሬ ሱን ዹጋ ተኤ ህንቤክኔ። <verse eid="ACT 12:9"/><verse number="10" style="v" sid="ACT 12:10"/>እሳንስ ዋርድያ ዱራቲፊ እሰ ለመፋ ብረ ደርበኒ በልበለ ስቢላ ከን መጋላት ገድ ባሱ ብረ ገአን፤ በልበል ሱንስ ኦፉማን በነሜፍ፤ እሳንስ ገድ በአኒ ኡቱ ዳንዲ ቶኮረ ገድ ቡኣ ጅረኑ ኤርገማን ሱን እሰ ብራ ሶኬ።<verse eid="ACT 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 12:11"/>ጴጥሮስስ ቀልቢሳት ዴብኤ፣ “አን አመ አከ ጎፍታን ኤርገማሳ ኤርጌ ሀርከ ሄሮድሲፊ ዋን ይሁዶትን ነት ያዳ ቱረን ሁንደ ጀላ ነ ባሴ ሸኪ መሌ ቤኬረ” ጄዼ።<verse eid="ACT 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 12:12"/>እንስ ኤርገ ዋን ከነ ሁበቴ ቦዴ መነ ማርያም ሃዸ ዮሀንስ እሰ ማርቆስ ጄዸሙ ሰና እዶ እት ነሞትን ባይኤን ወልት ቀበመኒ ዋቀ ከዸቻ ቱረን ዸቄ። <verse eid="ACT 12:12"/><verse number="13" style="v" sid="ACT 12:13"/>ዮሙ ጴጥሮስ በልበለ አላ ሩሩኩቴት እንተል ሆጄቱን ሮዴ ጄዸምቱ ቶኮ እላሉ ዹፍቴ። <verse eid="ACT 12:13"/><verse number="14" style="v" sid="ACT 12:14"/>እሼንስ ዮሙ ሰገሌ ጴጥሮስ ሁበቴት አከ መሌ ገመዴ፤ በልበለ በኑ ዺፍቴስ ፊግዴ ኦል ዴብቴ አከ ጴጥሮስ በልበለ ዱረ ዻበቱ ህምቴ።<verse eid="ACT 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 12:15"/>እሳንስ፣ “አት መራቴርተ!” ጄዸኒን፤ እሼን ገሩ ጭምስቴ አከ ወን ኩን አከሱመ ተኤ ዱበቴ፤ እሳንሞ፣ “ዮስ ኤርገማሳት!” ጄዸን።<verse eid="ACT 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 12:16"/>ጴጥሮስ ገሩ እቱመ ፉፌ በልበልቸ ሩሩኩቴ፤ እሳንስ ዮሙ በነንት፣ እሰ አርገኒ ድንቅፈተን። <verse eid="ACT 12:16"/><verse number="17" style="v" sid="ACT 12:17"/>ጴጥሮስስ አከ እሳን ጨልእሰኒፍ ሀርካን እት ህሜ፤ አከ እት ጎፍታን መነ ህዻቲ እሰ ባሴስ እሳንት ኦዴሴ፤ እንስ፣ “ዋን ከነ ያቆቢፊ ኦቦሎተት ህማ” እሳኒን ጄዼ፤ አቺ ከኤስ ለፈ ብራ ዸቄ።<verse eid="ACT 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 12:18"/>ዮሙ ለፍት በሪቴት ራፈምን ጉዳንሳ ሎልቶተ ግዱት ኡመሜ፤ እሳንስ፣ “ጴጥሮስ ማል ተኤ?” ጄዸኒ ወል ገጋፈተን። <verse eid="ACT 12:18"/><verse number="19" style="v" sid="ACT 12:19"/>ሄሮድስስ ጭምሴ በርባዴ እሰ ዸብናን ኤግዶተ ሰነ ጀቤሴ ቆሬ አከ እሳን አጄፈመን አጀጄ።</para>
  <para style="s1" vid="ACT 12:19">ዱአ ሄሮድስ</para>
  <para style="p" vid="ACT 12:19">ሄሮድስ ይሁዳዻ ከኤ ቂሳርያት ገድ ቡኤ ጥኖ አች ጅራቴ። <verse eid="ACT 12:19"/><verse number="20" style="v" sid="ACT 12:20"/>እንስ ወረ ጢሮሲፊ ስዶንት አከ መሌ ኣሬ፤ እሳንስ ተጃጅላ ሞትቻ አመነማ ብላስጦስ ጄዸሙ ቶኮ ምቾምፈተኒ ቶኩማን ገረ ሞትቻ ዸቀኒ አራረ ከዸተን፤ ብይሳኒ ብየ ሞትቸ ሰናራ ምዻን ኛታ አርገቻ ጅራቴቲ።<verse eid="ACT 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 12:21"/>ጉያ ቤለማትስ ሄሮድስ ኡፈተ ሞቲ ኡፈቴ ቴሶሳረ ታኤ፤ ኡመተትስ ዱበቴ። <verse eid="ACT 12:21"/><verse number="22" style="v" sid="ACT 12:22"/>ነሞትንስ፣ “ኩን ሰገሌ ዋቃት መሌ ሰገሌ ነማ ምት” ጄዸኒ እየን። <verse eid="ACT 12:22"/><verse number="23" style="v" sid="ACT 12:23"/>ሄሮድስስ ዋን ዋቃፍ ኡልፍነ ህንኬንኒፍ ዬሩመ ሰነ ኤርገማን ዋቃ ቶኮ እሰ ዸኤ፤ እንስ ራሞዻን ኛተሜ ዱኤ።<verse eid="ACT 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 12:24"/>ዱቢን ዋቃ ገሩ እቱመ ፉፌ ጉደቻ፣ በበልአቻስ ዴሜ።<verse eid="ACT 12:24"/></para>
  <para style="s1">በርናባሲፊ ሳዉል ጌጌፈመን</para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 12:25"/>በርናባሲፊ ሳዉል ኤርገ ኤርገመሳኒ ፍጠተኒ ቦዴ ዮሀንስ እሰ ማርቆስ ጄዸሙ ሰነ ፉዸተኒ ዬሩሳሌሚ ዴብአን።<verse eid="ACT 12:25"/></para>
  <chapter eid="ACT 12"/>
  <chapter number="13" style="c" sid="ACT 13"/>
  <para style="s1">በርናባሲፊ ሳዉል ኤርገመን</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1"/>ወልዳ ክርስታና አንጦኪያ ኬሰ ራጆታፊ በርሲስቶተቱ ቱሬ፤ እሳንስ በርናባስ፣ ስምኦን እሰ ኒጌር ጄዸሙ፣ ሉክዮስ ነመ ቀሬና፣ ምናሄ እሰ ሄሮድስ ቡልቻ ሰነ ወጅን ጉደቴፊ ሳዉል ፈአ። <verse eid="ACT 13:1"/><verse number="2" style="v" sid="ACT 13:2"/>ኡቱ እሳን ጎፍታ ተጃጅላ፣ ሶማስ ጅረኑ ሀፉር ቁልቁሉን፣ “በርናባሲፊ ሳዉልን ሆጂ አን እት እሳን ዋመዼፍ ናፍ ፍላ” ጄዼ። <verse eid="ACT 13:2"/><verse number="3" style="v" sid="ACT 13:3"/>ከናፍ እሳን ኤርገ ሶመኒ ዋቀ ከዸተኒ ቦዴ ሀርከሳኒ ጀረረ ካአኒ እሳን ኤርገን።<verse eid="ACT 13:3"/></para>
  <para style="s1">በርናባሲፊ ሳዉል ቆጵሮስት ለለበን</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4"/>እሳን ለቹ ሀፉረ ቁልቁሉዻን ኤርገመኒ ሴሉቅያት ገድ ቡአን፤ አቺስ ከአኒ ዶኒን ቆጵሮስ ዸቀን። <verse eid="ACT 13:4"/><verse number="5" style="v" sid="ACT 13:5"/>ዮሙ ሰላሚስ ገአንትስ መኔን ሰገዳ ይሁዶታ ኬሰት ዱቢ ዋቃ ለለበን፤ ዮሀንስስ እሳን ገርጋሩፍ እሳን ብረ ቱሬ።<verse eid="ACT 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 13:6"/>እሳንስ ዮሙ ብዮተ ብሻኒን መርፈመን ሰነ ሁንዱማ ኬሰ በአኒ ሀመ ጳፉት ዹፈንት፣ ይሁዲ ፈልፈልትቻፊ ራጂ ሶባ ከን መቃንሳ ባርዬሱስ ጄዸሙ ቶኮት ዹፈን። <verse eid="ACT 13:6"/><verse number="7" style="v" sid="ACT 13:7"/>እንስ ነምቸ ሁበታ ቡልቻ ብያ ተኤ ከን ሰርግዮስ ጳዉሎስ ጄዸሙ ቶኮ ወጅን ቱሬ። ቡልቻን ሱንስ ዋን ዱቢ ዋቃ ዸገኡ በርባዴፍ ነመ ኤርጌ በርናባሲፊ ሳዉልን ዋምስፈቴ። <verse eid="ACT 13:7"/><verse number="8" style="v" sid="ACT 13:8"/>ኤሊማስ ፈልፈልትች ከን ሂካን መቃሳ አፋን ግሪኪን አከሱመ ተኤ ሱን ገሩ ቡልቻ ብያ ሰነ አመንቲራ ዴብሱፍ ጄዼ እሳኒን ሞርሜ። <verse eid="ACT 13:8"/><verse number="9" style="v" sid="ACT 13:9"/>ሳዉል እን ጳዉሎስ ጄዸሙ ሱን ገሩ ሀፉረ ቁልቁሉዻን ጉተሜ ኤሊማስን ሁበቴ እላሌ አከነ ጄዼን፤ <verse eid="ACT 13:9"/><verse number="10" style="v" sid="ACT 13:10"/>“አት እልመ ዲያብሎሲፊ ዲነ ቀጄሉማ ሁንዳት! ሶባፊ ጎዎምሳ ጎሰ ሁንዳቲንስ ጉተምቴርተ። አት ከራ ጎፍታ እሰ ቀጄላ ሰነ ጀልእሱ ህንዺፍቱ? <verse eid="ACT 13:10"/><verse number="11" style="v" sid="ACT 13:11"/>ኩኖ አመ ሀርክ ጎፍታ ስት ከኤረ፤ አትስ ጃምቴ ዬሮፍ እፈ አዱ አርጉ ንደዸብደ።”</para>
  <para style="p" vid="ACT 13:11">ዬሩመ ሰነ ሁሪፊ ዱከን እሰረ ቡኤ፤ እንስ ነመ ሀርከ ቀቤ እሰ ቀጄልቹ በርባዱ ጀልቀቤ። <verse eid="ACT 13:11"/><verse number="12" style="v" sid="ACT 13:12"/>ቡልቻን ብያ ሱንስ ዋን ከነ አርግናን አመኔ፤ በርሲሰ ዋኤ ጎፍታ ድንቅፈቴ ቱሬቲ።<verse eid="ACT 13:12"/></para>
  <para style="s1">ጳዉሎሲፊ በርናባስ ጵሲድያ ኬሰት</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 13:13"/>ጳዉሎሲፊ ሚልቶትንሳ ጳፉዻ ብድሩዻን ከአኒ ጴርጌን ከን ጰምፉልያ ሰነ ዸቀን፤ ዮሀንስስ አችት እሳን ዺሴ ዬሩሳሌምት ዴብኤ። <verse eid="ACT 13:13"/><verse number="14" style="v" sid="ACT 13:14"/>እሳን ገሩ ጴርጌኒ ከአኒ ገረ አንጦኪያ እሼ ጵሲድያት አርገምቱ ዹፈን፤ ጉያ ሰንበታቲንስ መነ ሰገዳ ሴነኒ ተታአን። <verse eid="ACT 13:14"/><verse number="15" style="v" sid="ACT 13:15"/>ቡልችቶትን መነ ሰገዳ ሰናስ ኤርገ ክታቦትን ሴራቲፊ ራጆታ ዱብፈመኒ ቦዴ ነመ እሳንት ኤርገኒ፣ “ያ ኦቦሎተ፣ ዮ ዱቢ ጎርሳ ኡመታፍ ቀባተን ሜ ዱበዻ” ጄዸኒን።<verse eid="ACT 13:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 13:16"/>ጳዉሎስ ከኤ ዻበቴ ሀርካን መለቶ አርግሲሴ አከነ ጄዼ፤ “ያ ነሞተ እስራኤል፣ እስን ወር ዋቀ ሶዳተንስ ሜ ነ ዸገኣ! <verse eid="ACT 13:16"/><verse number="17" style="v" sid="ACT 13:17"/>ዋቅን ሰበ እስራኤል አቦቲኬኘ ፍለቴ፤ እንስ ዬሮ እሳን ብየ ግብጥ ጅራቻ ቱረንት ሰብቸ ሰበ ጉዳ ጎዼ፤ እሬ ጀባንስ አቺ እሳን ባሴ፤ <verse eid="ACT 13:17"/><verse number="18" style="v" sid="ACT 13:18"/>ገሞጂ ኬሰትስ ገረ ወጋ አፉርተማ እሳኒ ኦብሴ። <verse eid="ACT 13:18"/><verse number="19" style="v" sid="ACT 13:19"/>ብየ ከነኣን ኬሳስ ሰቦተ ቶርበ በሌሴ ለፈሳኒ አከ ዻላት ሰበሳቲ ኬኔ። <verse eid="ACT 13:19"/><verse number="20" style="v" sid="ACT 13:20"/>ወን ኩን ሁንድኑ ገረ ወጋ 450 ፉዸቴ።</para>
  <para style="p" vid="ACT 13:20">“ከነ ቦዴስ ዋቅን ሀመ በረ ሳሙኤል ራጅቻት አቦቲ ሙርቲ እሳኒፍ ኬኔ። <verse eid="ACT 13:20"/><verse number="21" style="v" sid="ACT 13:21"/>ዮሙ እሳን አከ እን ሞቲ ኬኑፊፍ እሰ ከዸተንት ዋቅን ጎሰ ቤንያም ኬሳ ሳኦል እልመ ቂስ እሳኒፍ ኬኔ፤ ሳኦልስ ወጋ 40 እሳን ቡልቼ። <verse eid="ACT 13:21"/><verse number="22" style="v" sid="ACT 13:22"/>ዋቅን ሳኦልን ሞቱማራ ቡሴ ዳዊትን ሞቲሳኒ ጎዼ፤ እንስ፣ ‘አን ነመ አከ ገራኮ ዳዊት እልመ እሴይ አርገዼረ፤ እን ዋን አን አከ እን ሆጄቱ ፌዹ ሁንደ ንሆጄተ’ ጄዼ ዋኤ ዳዊት ረጌሴረ።<verse eid="ACT 13:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 13:23"/>“ዋቅንስ አኩመ አብደቺሴ ሰነ፣ ሰኚ ነመ ከና ኬሳ ዬሱስ ፈይሳ ሰበ እስራኤሊፍ ፍዴ። <verse eid="ACT 13:23"/><verse number="24" style="v" sid="ACT 13:24"/>ዮሀንስ ዹፋቲ ዬሱስ ዱረት ጩጳ ቀልቢ ጅጂረትና ሰበ እስራኤል ሁንዱመት ለለቤ ቱሬ። <verse eid="ACT 13:24"/><verse number="25" style="v" sid="ACT 13:25"/>ዮሀንስስ ኡቱ ኤርገመሳ ጉተቻ ጅሩ፣ ‘እስን ኤኙ ነ ሴተን? አን እሰ እስን ኤገቻ ጅርተን ምት። ገሩ ነምን አን ኮጴሳሌ ሂኩ ህንመሌ ቶኮ ነ ዱባን ንዹፈ’ ጄዼ።<verse eid="ACT 13:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 13:26"/>“ኦቦሎተ፣ ያ እጆሌ አብረሃም፣ እስን ወር ዋቀ ሶዳተንስ፣ ዱቢን ፈይነ ከና ኑ ኤርገሜ። <verse eid="ACT 13:26"/><verse number="27" style="v" sid="ACT 13:27"/>ወረ ዬሩሳሌም ኬሰ ጅራተኒፊ ቡልችቶትንሳኒ ዋን ዬሱስን ህንቤክኒፍ ዮካን ዱቢ ራጆታ እሰ ሰንበተ ሰንበተ ዱብፈሙ ዋን ህንሁበትኒፍ እሰት ሙሩዻን ዱቢ ራጆታ ሰነ ጉተን። <verse eid="ACT 13:27"/><verse number="28" style="v" sid="ACT 13:28"/>እሳንስ ዮ ሰበቢ ዱአ እሰት ሙርሲሱ ደንደኡ አርገቹ ባተንሌ አከ ዬሱስ አጄፈሙፍ ጲላጦስን ከዸተን። <verse eid="ACT 13:28"/><verse number="29" style="v" sid="ACT 13:29"/>ኤርገ ዋን ዋኤሳ በሬፈሜ ሁንደ ጉተተኒ ቦዴስ ፈኖራ ገድ ቡሰኒ አዋለ ኬሰ እሰ ካአን። <verse eid="ACT 13:29"/><verse number="30" style="v" sid="ACT 13:30"/>ዋቅን ገሩ ወረ ዱአን ኬሳ እሰ ካሴ። <verse eid="ACT 13:30"/><verse number="31" style="v" sid="ACT 13:31"/>እንስ ወረ እሰ ወጅን ገሊላዻ ገረ ዬሩሳሌምት ኦል በአንት ጉያ ሄዱ ሙልአቴ፤ እሳንስ አመ ሰበኬኘ ዱረት ዹገ ባቶተሳት።<verse eid="ACT 13:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 13:32"/>“ኑስ ኦዱ ነመ ገመቺሱ እስንት ኦዴስነ፤ ኦዱን ኩንስ፦ ዋቅን ዋን አቦቲኬኘ አብደቺሴ ሰነ፣ <verse eid="ACT 13:32"/><verse number="33" style="v" sid="ACT 13:33"/>ዬሱስን ዱኣ ካሱዻን ኑ እጆሌሳኒቲፍ ጉቴረ። ኩንስ አኩመ ፋርፈትና ለመፋ ኬሰት አከነ ጄዸሜ በሬፈሜዸ፤</para>
  <para style="q1" vid="ACT 13:33">“ ‘አት እልመኮት፤</para>
  <para style="q2" vid="ACT 13:33">አን ሀርአ ስ ዸልቼረ።’<note caller="+" style="f"><char style="fr" closed="false">13፥33 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 2:7">ፋር 2፥7</ref></char></char></note><verse eid="ACT 13:33"/></para>
  <para style="m">
    <verse number="34" style="v" sid="ACT 13:34"/>ወን ዋቅን፣ አከ እን ለመተ ህንቶርቶሬፍ ጄዼ ወረ ዱአን ኬሳ እሰ ካሴፍ አከነ ጄዸሜ ዱቢ ከነ ኬሰት በሬፈሜረ፤</para>
  <para style="q1" vid="ACT 13:34">“ ‘አን ኤበ ቁልቁሉፊ ምርከናኣ፣</para>
  <para style="q2" vid="ACT 13:34">እሰ ዳዊት አብደቺፈሜ ሰነ እስኒፍ ነንኬነ።’<note caller="+" style="f"><char style="fr" closed="false">13፥34 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 55:3">እሳ 55፥3</ref></char></char></note><verse eid="ACT 13:34"/></para>
  <para style="m">
    <verse number="35" style="v" sid="ACT 13:35"/>አከሱመስ እዶ ብራት አከነ ጄዸ፦</para>
  <para style="q1" vid="ACT 13:35">“ ‘ቁልቁልችኬ አከ ቶርቶሩ ህንጎቱ።’<note caller="+" style="f"><char style="fr" closed="false">13፥35 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 16:10">ፋር 16፥10</ref></char></char></note><verse eid="ACT 13:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 13:36"/>“ዳዊትስ በረሳ ኬሰ ፌዺ ዋቃ ተጃጅሌ ቦቆቴ፤ አቦቲሳ ብረት አዋለሜ፤ ዸግንሳስ ንቶርቶሬ። <verse eid="ACT 13:36"/><verse number="37" style="v" sid="ACT 13:37"/>እን ዋቅን ወረ ዱአን ኬሳ እሰ ካሴ ሱን ገሩ ህንቶርቶሬ።<verse eid="ACT 13:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 13:38"/>“ከናፍ ያ ኦቦሎተኮ፣ እስን አከ ከራ ዬሱሲቲን ዺፈምን ጩቡ እስንት ለለበሜ አከ ቤክተን ነንፌዸ። <verse eid="ACT 13:38"/><verse number="39" style="v" sid="ACT 13:39"/>ነምን አመኑ ሁንድኑ ዋን ሴረ ሙሴቲን ፉረሙ ህንደንደእን ሁንደራ ከራ ዬሱሲቲን ፉረሙ ንደንደአ። <verse eid="ACT 13:39"/><verse number="40" style="v" sid="ACT 13:40"/>እስንስ አከ ወን ራጆትን ዱበተን ሱን እስንረ ህንጌኜፍ ኦፍ ኤገዻ፤ እንስ አከነ ጄዸ፦<verse eid="ACT 13:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="ACT 13:41"/>“ ‘እላላ፣ እስን ቆስቶተነነ፤</para>
  <para style="q2" vid="ACT 13:41">ድንቅሲፈዻ፤ ዹማስ፤</para>
  <para style="q1" vid="ACT 13:41">አን በረኬሰን ኬሰ</para>
  <para style="q2" vid="ACT 13:41">ዋን እስን ዮ ነምን ቶኮ እስንት ህሜሌ</para>
  <para style="q2" vid="ACT 13:41">ህንአመኔ ቶኮ ነንሆጄዸ።’<note caller="+" style="f"><char style="fr" closed="false">13፥41 </char><char style="ft" closed="false"><char style="xt"><ref loc="HAB 1:5">አንባ 1፥5</ref></char></char></note>”<verse eid="ACT 13:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 13:42"/>ኡቱ ጳዉሎሲፊ በርናባስ መነ ሰገዳቲ በኡት ጅረኑ ነሞትን ሱን አከ እሳን ሰንበተ እት ኣኑሌ ዴብአኒ ዱቢ ሰነ ለለበኒፍ እሳን ከዸተን። <verse eid="ACT 13:42"/><verse number="43" style="v" sid="ACT 13:43"/>ኤርገ ወል ገኢን መነ ሰገዳ ብትናኤ ቦዴ፣ ይሁዶትኒፊ ነሞትን አመንቲ ይሁዶታ ፉዸተኒ እት ቡለን ባይኤን እሳን ዱካ ቡአን፤ ጳዉሎሲፊ በርናባስስ ጀረ ሰነ ወጅን ዱዱበተኒ አከ እሳን አያነ ዋቃት ጅራተኒፍ ጭምሰኒ እሳን ጎርሰን።<verse eid="ACT 13:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 13:44"/>ሰንበተ እት ኣኑት ነመ ሙራሰ መሌ ኡመትን መጋላ ሰና ጉቱን ዱቢ ጎፍታ ዸገኡፍ ወልት ቀበሜ። <verse eid="ACT 13:44"/><verse number="45" style="v" sid="ACT 13:45"/>ይሁዶትን ገሩ ኡመተ ባይኤ አርገኒ ህናፋን ጉተመን፤ ጳዉሎስንስ አረብሰኒ ዋን እን ዱበቴን ሞርመን።<verse eid="ACT 13:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="ACT 13:46"/>ጳዉሎሲፊ በርናባስስ አከነ ጄዸኒ ሶዳ መሌ ዴቢ ኬነኒፍ፤ “ኑ ዱራን ዱርስኔ ዱቢ ዋቃ እስንት ህሙ ቀብነ ቱሬ፤ እስን ገሩ ዱቢ ሰነ ድደኒ አከ ጅሬኝ በረ በራ እስኒፍ ህንመሌት ዋን ኦፍ ሄደኒፍ ኩኖ፣ ኑ አመ ገረ ነሞተ ኦርማት ገረገለ። <verse eid="ACT 13:46"/><verse number="47" style="v" sid="ACT 13:47"/>ጎፍታን አከነ ጄዼ ኑ አጀጄራቲ፤</para>
  <para style="q1" vid="ACT 13:47">“ ‘አን አከ አት ነሞተ ኦርማቲፍ እፈ ታቴ፣</para>
  <para style="q2" vid="ACT 13:47">ሀመ ቀርቀረ ለፋት ፈይነ ጌስቱፍ ስ ፍለዼረ።’<note caller="+" style="f"><char style="fr" closed="false">13፥47 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 49:6">እሳ 49፥6</ref></char></char></note>”<verse eid="ACT 13:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 13:48"/>ነሞትን ኦርማስ ዮሙ ዋን ከነ ዸገአንት ገመደኒ ዱቢ ጎፍታ ኡልፌሰን፤ ወር ጅሬኘ በረ በራቲፍ ፍለተመን ሁንድኑስ ንአመነን።<verse eid="ACT 13:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="ACT 13:49"/>ዱቢን ጎፍታስ ናኖ ሰነ ሁንደ ኬሰት ፈጫፈሜ። <verse eid="ACT 13:49"/><verse number="50" style="v" sid="ACT 13:50"/>ይሁዶትን ገሩ ዱበርቶተ ቤቤከሞ ዋቀ ሶዳተኒፊ ዱረ ቡኦተ መጋለቲ እሳንት ቱቱቀን፤ እሳንስ ጳዉሎሲፊ በርናባስረት አርአተመ ካሰኒ ብየሳኒ ኬሳ እሳን ባሰን። <verse eid="ACT 13:50"/><verse number="51" style="v" sid="ACT 13:51"/>እሳን ገሩ አከ አኬከቺሰ እሳኒፍ ተኡፍ፣ አዋረ ሚለሳኒ ዸዸአተኒ እቆንዮንት ቀጄለን። <verse eid="ACT 13:51"/><verse number="52" style="v" sid="ACT 13:52"/>በረቶትንስ ገመቹፊ ሀፉረ ቁልቁሉዻን ጉተመን።<verse eid="ACT 13:52"/></para>
  <chapter eid="ACT 13"/>
  <chapter number="14" style="c" sid="ACT 14"/>
  <para style="s1">ጳዉሎሲፊ በርናባስ ኢቆንዮን ኬሰት</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1"/>ጳዉሎሲፊ በርናባስ አኩመ አመለሳኒ እቆንዮንት መነ ሰገዳ ይሁዶታ ሴነን፤ አችትስ ዋን አከ ጋሪ ዱበተኒፍ ይሁዶትኒፊ ግሪኮትን ሄዱን ንአመነን። <verse eid="ACT 14:1"/><verse number="2" style="v" sid="ACT 14:2"/>ይሁዶትን ህንአመንን ገሩ ነሞተ ኦርማ ከካሰኒ አከ እሳን ኦቦሎታን ሞርመኒፍ ያደሳኒ ሀሜሰን። <verse eid="ACT 14:2"/><verse number="3" style="v" sid="ACT 14:3"/>ጳዉሎሲፊ በርናባስ ሶዳ መሌ ዋኤ ጎፍታ ዱበቻ ዬሮ ዼራ አች ቱረን፤ ጎፍታንስ አከ እሳን መለቶፊ ድንቂ ሆጄተን እሳን ደንዴስሱዻን ዱቢ አያነሳ ምርከኔሴ። <verse eid="ACT 14:3"/><verse number="4" style="v" sid="ACT 14:4"/>ኡመትን መጋላ ሰናስ ገርገር ቆደሜ፤ ገር ቶኮ ይሁዶተ ወጅን፣ ካንሞ ኤርገሞተ ወጅን ዻበቴ። <verse eid="ACT 14:4"/><verse number="5" style="v" sid="ACT 14:5"/>ነሞትን ኦርማቲፊ ይሁዶትን ቡልችቶተሳኒ ወጅን እሳን ዽጵሱፊ ዸጋዻን እሳን ቱሙፍ መርአተን። <verse eid="ACT 14:5"/><verse number="6" style="v" sid="ACT 14:6"/>ጀር ገሩ ዋን ከነ ቤከተኒ መጋላወን ሊቃኦንያ ከኔን ልስጥራኒፊ ደርቤን ጄዸመንት፣ ገረ ብየ ናኖ ሰናትስ በቀተን። <verse eid="ACT 14:6"/><verse number="7" style="v" sid="ACT 14:7"/>አችትስ ወንጌለ ለለቡ እት ፉፈን።<verse eid="ACT 14:7"/></para>
  <para style="s1">ጳዉሎሲፊ በርናባስ ልስጥራኒፊ ደርቤን ኬሰት</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 14:8"/>ልስጥራን ኬሰ ነምች ሚልሳ ላምሸኤ፣ ከን ዸሎተሳቲ ጀልቀቤ ናፈ ቱሬፊ ተኩማ ሚላን ዴሜ ህንቤክን ቶኮ ታኣ ቱሬ። <verse eid="ACT 14:8"/><verse number="9" style="v" sid="ACT 14:9"/>እንስ ዬሮ ጳዉሎስ ዱበቱት እሰ ዸጌፈቻ ቱሬ፤ ጳዉሎስስ ሁበቴ እሰ እላሌ አከ ነምች ሱን ፈዩፍ አመንቲ ቀቡ አርጌ፤ <verse eid="ACT 14:9"/><verse number="10" style="v" sid="ACT 14:10"/>ሰገሌ ጉዳዻንስ፣ “ከኢ ሚለኬቲን ዻበዹ!” ጄዼን። ነምች ሱንስ ኦል ኡታሌ ከኤ፤ ሚላን ዴሙስ ጀልቀቤ።<verse eid="ACT 14:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 14:11"/>ነሞትንስ ዮሙ ዋን ጳዉሎስ ሆጄቴ አርገንት፣ ሰገሌሳኒ ኦል ፉዸተኒ አፋን ሊቃኦንያቲን፣ “ዋቆትን ብፈ ነማቲን ኑት ገድ ቡአኒሩ!” ጄዸን። <verse eid="ACT 14:11"/><verse number="12" style="v" sid="ACT 14:12"/>እሳንስ በርናባሲን፣ “ዜኦስ” ጄዸን፤ ጳዉሎስሞ ዋን እን ዱበታ ሀንገፈ ቱሬፍ፣ “ሄርሜን” ጄዸኒን። <verse eid="ACT 14:12"/><verse number="13" style="v" sid="ACT 14:13"/>ሉብን ዜኦስ ኡመተ ወጅን ኣርሳሳኒ ዽኤሱ በርባዴ ሰንጎታፊ ደራራ ፎአሜ ገረ በልበለ መጋላት ፍዴ፤ መን ቁልቁሉማ ድያስ መጋላ ሰናን አለት አርገመ ቱሬ።<verse eid="ACT 14:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 14:14"/>ኤርገሞትን ጄቹንስ በርናባሲፊ ጳዉሎስ ገሩ ዮሙ ዋን ከነ ዸገአንት ወያሳኒ ተርሳሰኒ እያ ፊገኒ ኡመተ ኬሰ ሴነን፤ አከነስ ጄዸን፤ <verse eid="ACT 14:14"/><verse number="15" style="v" sid="ACT 14:15"/>“ያ ጀረነ፣ እስን ማሊፍ ዋን ከነ ጎተን? ኑስ ነሙመ አከኬሰኒት። አከ እስን ዋን ፋይዳ ህንቀብኔ ከነራ ዴብተኒ ዋቀ ጅራታ እሰ ሰሚ፣ ለፈ፣ ገላናፊ ዋን እሳን ኬሰ ጅሩ ሁንደ ኡሜት ዴብተኒፍ ኑ ኦዱ ጋሪ እስንት ህምነ። <verse eid="ACT 14:15"/><verse number="16" style="v" sid="ACT 14:16"/>እን በረ ዱሪ ኬሰ አከ ሰቦትን ሁንድኑ አኩመ ፌዸንት ጅራተን እሳን ዺሴ፤ <verse eid="ACT 14:16"/><verse number="17" style="v" sid="ACT 14:17"/>ተኡስ ዹገ በኡምሰ መሌ ኦፍ ህንዺፍኔ። ቦካ ሰሚራ ሮብሴ ምዻንስ ዬሮሳት እስኒ ኬኔ፣ ገራ ላፉማሳ አርግሲሴረ፤ ሶረ ሄዱስ እስኒ ኬኔ ገራኬሰን ገመቹዻን ጉተ።” <verse eid="ACT 14:17"/><verse number="18" style="v" sid="ACT 14:18"/>ጀር ገሩ ዱቢ ከናንዩ ረክነ ጉዳዻን አከ ቱትን ሱን ኣርሳሳኒፍ ህንዽኤስኔ ኦፍራ ዴብሰን።<verse eid="ACT 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 14:19"/>ይሁዶትን ቶኮ ቶኮ አንጦኪያፊ እቆንዮኒ ዹፈኒ ኡመተ ገረ ኦፊሳኒት ዴብፈተን። ጳዉሎስን ዸጋዻን ቱመኒ ዋን እን ዱኤ ሴአኒስ ለፈረ ሀርክሳ መጋላ ኬሳ ገድ እሰ ባሰን። <verse eid="ACT 14:19"/><verse number="20" style="v" sid="ACT 14:20"/>እን ገሩ ዬሮ በረቶትን እሰት ናነአንት ከኤ መጋላ ሴኔ፤ ጉያ እት ኣኑትሞ በርናባስ ወጅን መጋላ ደርቤንት ቀጄሌ።<verse eid="ACT 14:20"/></para>
  <para style="s1">ገረ አንጦኪያ እሼ ሶርያ ኬሳት ዴብአን</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 14:21"/>እሳንስ ኤርገ መጋላ ሰነት ወንጌለ ለለበኒ ነሞተ ሄዱ በረቶተ ጎዸተኒ ቦዴ ልስጥራንት፣ እቆንዮኒፊ አንጦኪያት ዴብአን። <verse eid="ACT 14:21"/><verse number="22" style="v" sid="ACT 14:22"/>እሳንስ፣ “ኑ ሞቱማ ዋቃት ገሉዻፍ ረክነ ባይኤ ኬሰ ደርቡ ቀብነ” ጄዸኒ በረቶተ ጀጀቤሳ፣ አከ እሳን አመንቲት ጭመኒፍስ ጎርሳ ቱረን። <verse eid="ACT 14:22"/><verse number="23" style="v" sid="ACT 14:23"/>ጳዉሎሲፊ በርናባስ ቶኮ ቶኮ ወልዳ ክርስታና ኬሰት ማንጉዶተ ሙደኒፊ ከዻፊ ሶማን ጎፍትቸ እሳን እት አመነንት ደበርሰኒ እሳን ኬነን። <verse eid="ACT 14:23"/><verse number="24" style="v" sid="ACT 14:24"/>ጵሲድያ ኬሰ ደርበኒ ጰምፉልያ ሴነን። <verse eid="ACT 14:24"/><verse number="25" style="v" sid="ACT 14:25"/>ጴርጌንት ዱብቸ ለለበኒ አጣልያት ገድ ቡአን።<verse eid="ACT 14:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 14:26"/>አጣልያዻ ከአኒ ገረ እዶ እት ሆጂ አመ ፍጠተን ከናፍ አያነ ዋቃት እማና ኬነመኒ ቱረኒ አንጦኪያት ዶኒን ዴብአን። <verse eid="ACT 14:26"/><verse number="27" style="v" sid="ACT 14:27"/>አኩመ አች ገአኒንስ ወልዳ ክርስታና ወልት ቀበኒ ዋን ዋቅን ከራሳኒቲን ሆጄቴ ሁንዳፊ አከምት አከ እን ነሞተ ኦርማቲፍ በልበለ አመንቲ በኔስ እሳንት ህመን። <verse eid="ACT 14:27"/><verse number="28" style="v" sid="ACT 14:28"/>እሳንስ በረቶተ ወጅን ዬሮ ዼራ አች ቱረን።<verse eid="ACT 14:28"/></para>
  <chapter eid="ACT 14"/>
  <chapter number="15" style="c" sid="ACT 15"/>
  <para style="s1">ወል ገኢ ዬሩሳሌምት ጎዸሜ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 15:1"/>ነሞትን ቶኮ ቶኮ ይሁዳ ገረ አንጦኪያት ገድ ቡአኒ፣ “እስን ዮ አኩመ ሴረ ሙሴት ዸግነ ቀበቹ ባተን ፈዩ ህንደንዴሰን” ጄዸኒ ኦቦሎተ በርሲሳ ቱረን። <verse eid="ACT 15:1"/><verse number="2" style="v" sid="ACT 15:2"/>ኩንስ አከ ጳዉሎሲፊ በርናባስ ጀረ ወጅን ወል ድዳፊ ወል ሞርኪ ጭማ ኬሰ ሴነን እሳን ጎዼ፤ ከናፍ ጳዉሎሲፊ በርናባስ ዋኤ ዱቢ ከናቲፍ ጄዸኒ አከ ዬሩሳሌምት ኦል በአኒ ኤርገሞታፊ ማንጉዶተ ብረ ዸቀኒፍ አመንቶተ ቶኮ ቶኮ ወጅን ፍለተመን። <verse eid="ACT 15:2"/><verse number="3" style="v" sid="ACT 15:3"/>ወልዳን ክርስታናስ እሳን ኤርግቴ፤ እሳንስ አከ ነሞትን ኦርማ ዋቀት ዴብአን ኦዴሳ ፍኒቄፊ ሰማርያ ኬሰ ደርበን። ኦዱን ኩንስ ኦቦሎተ ሁንደ አከ መሌ ገመቺሴ። <verse eid="ACT 15:3"/><verse number="4" style="v" sid="ACT 15:4"/>ዮሙ እሳን ዬሩሳሌም ገአንት ወልዳን ክርስታና፣ ኤርገሞትኒፊ ማንጉዶትን እሳን ስመተን፤ እሳንስ ዋን ዋቅን ከራሳኒቲን ሆጄቴ ሁንደ ጀረት ህመን።<verse eid="ACT 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 15:5"/>አመንቶትን ገሬ ፈሪሶታ ቶኮ ቶኮ ገሩ ከአኒ ዻበተኒ፣ “ነሞትን ኦርማ ዸግነ ቀበቹ ቀበን፤ አከ ሴረ ሙሴ ኤገኒፍስ እት ህመሙ ቀበ” ጄዸን።<verse eid="ACT 15:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 15:6"/>ኤርገሞትኒፊ ማንጉዶትን ዱቢ ከነ እላሉፍ ወልት ቀበመን። <verse eid="ACT 15:6"/><verse number="7" style="v" sid="ACT 15:7"/>ጴጥሮስስ ፈልሚ ጉዳ ቦዴ ከኤ ዻበቴ አከነ እሳኒን ጄዼ፤ “ያ ኦቦሎተ፣ እስን አከ ዋቅን ዬሮ ገባባን ዱረ አከ ነሞትን ኦርማ አፋንኮራ ዱቢ ወንጌላ ዸገአኒ አመነኒፍ ጄዼ እስኑመ ኬሳ ነ ፍለቴ ቤክቱ። <verse eid="ACT 15:7"/><verse number="8" style="v" sid="ACT 15:8"/>ዋቅን ያደ ገራ ነማ ቤኩ ሱን አኩመ ኑፍ ኬኔ ሰነት እሳኒፍስ ሀፉረ ቁልቁሉ ኬኑዻን አከ እሳን ስመቴ ምርከኔሴ። <verse eid="ACT 15:8"/><verse number="9" style="v" sid="ACT 15:9"/>እንስ ሰበቢ ገራሳኒ አመንቲን ቁልቁሌሴፍ፣ ኑፊ እሳን ግዱት ገራ ገሩማ ቶኮሌ ህንጎኔ። <verse eid="ACT 15:9"/><verse number="10" style="v" sid="ACT 15:10"/>ዮስ ማሊፍ ዋንጆ ኑስ አቦቲንኬኘስ ባቹ ህንደንደእን ሞርመ በረቶታረ ካኡዻን ዋቀ ቆርቱሬ? <verse eid="ACT 15:10"/><verse number="11" style="v" sid="ACT 15:11"/>ኑ አከ አያነ ጎፍታኬኘ ዬሱሲቲን ፈይኑ ንአመነ፤ እሳንስ አከሱመ ንፈዩ።”<verse eid="ACT 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 15:12"/>ዮሙ በርናባሲፊ ጳዉሎስ ዋኤ መለቶፊ ድንቂ ዋቅን ሀርከሳኒቲን ነሞተ ኦርማ ኬሰት ሆጄቴ ሰና ዱበተንት ያኢን ጉቱን ጨልእሴ እሳን ዸገኣ ቱሬ። <verse eid="ACT 15:12"/><verse number="13" style="v" sid="ACT 15:13"/>ኤርገ እሳን ዱበተኒ ፍጠኒ ቦዴስ ያቆብ አከነ ጄዼ፤ “ያ ኦቦሎተ፣ ሜ ነ ዸጌፈዻ! <verse eid="ACT 15:13"/><verse number="14" style="v" sid="ACT 15:14"/>ስሞንስ አከ ዋቅን ዱራን ዱርሴ ነሞተ ኦርማ ኬሳ ሰበ ቶኮ ኦፊሳቲ ፍለቹን ጃለለሳ አርግሲሴ ኑት ህሜረ። <verse eid="ACT 15:14"/><verse number="15" style="v" sid="ACT 15:15"/>ዱቢን ራጆታስ ዋን ከነ ወጅን ወሊ ገለ፤ እንስ አከነ ጄዸሜ በሬፈሜረ፦<verse eid="ACT 15:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ACT 15:16"/>“ ‘ከነ ቦዴ አን ነንዴብአ፤</para>
  <para style="q2" vid="ACT 15:16">ዱንካነ ዳዊት ከን ኩፌ ሰነ ዴብሴ ነንእጃረ፤</para>
  <para style="q1" vid="ACT 15:16">ዲገማሳሞ ዴብሴ ነንእጃረ፤</para>
  <para style="q2" vid="ACT 15:16">ዴብሴስ ነንዻበ፤<verse eid="ACT 15:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 15:17"/>ኩንስ አከ ነሞትን ሀፈን ጄቹንስ፣</para>
  <para style="q2" vid="ACT 15:17">ነሞትን ኦርማ ወር መቃኮቲን ዋመመን ሁንድኑ</para>
  <para style="q1" vid="ACT 15:17">ጎፍታ በርባደኒፍ’<note caller="+" style="f"><char style="fr" closed="false">15፥17 </char><char style="ft" closed="false"><char style="xt"><ref loc="AMO 9:11">አሞ 9፥11</ref>፣<ref loc="AMO 9:12">12</ref></char></char></note><verse eid="ACT 15:17"/></para>
  <para style="q2">
    <verse number="18" style="v" sid="ACT 15:18"/>ጄዸ ጎፍትች ዋን በረ ዼራፍ ቤከሜ ሆጄቴ ሱን።<verse eid="ACT 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 15:19"/>“ከናፍ ኑ አከ ሙርቲኮቲት ነሞተ ኦርማ ከኔን ዋቀት ዴብአን ረክሱ ህንቀብኑ። <verse eid="ACT 15:19"/><verse number="20" style="v" sid="ACT 15:20"/>ቆደ ከና አከ እሳን ኛተ ዋቆትን ቶልፈሞን ጡሬሰን፣ ሰጋገሉማ፣ ፎን ሆሪ ሁዸሜ ዱኤቲፊ ዺገ ለገተኒፍ ጠለያ በሬስኔ እት ህሙ ቀብነ። <verse eid="ACT 15:20"/><verse number="21" style="v" sid="ACT 15:21"/>ሴር ሙሴ ዸሎተ ዱሪቲ ጀልቀቤ መጋላ ሁንደ ኬሰት ለለበማ ቱሬ፤ መኔን ሰገዳ ኬሰትስ ሰንበተ ሰንበተ ንዱብፈመ።”<verse eid="ACT 15:21"/></para>
  <para style="s1">ጠለያ ነሞተ ኦርማት ኤርገሜ</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22"/>ዮሙስ ኤርገሞትኒፊ ማንጉዶትን ምሴንሶተ ወልዳ ክርስታና ጉቱ ወጅን ቶኮ ተአኒ ነሞተሳኒ ኬሳ ቶኮ ቶኮ ፍለተኒ ጳዉሎሲፊ በርናባስ ወጅን ገረ አንጦኪያት ኤርጉ ሙርቴሰን፤ እሳንስ ነሞተ ለመ ጄቹንስ ይሁዳ እሰ በርስያን ጄዸሙፊ ሲላስ ከኔን ኦቦሎተ ኬሰት ዱረ ቡኦተ ቱረን ሰነ ፍለተን። <verse eid="ACT 15:22"/><verse number="23" style="v" sid="ACT 15:23"/>ጠለያ አርማን ገድ ጅሩ ከነስ እሳንት ኤርገን፦</para>
  <para style="pmo" vid="ACT 15:23">ኦቦሎተኬሰን፣ ኤርገሞታፊ ማንጉዶተራ፤</para>
  <para style="pmo" vid="ACT 15:23">ገረ ነሞተ ኦርማ ከኔን አመነን ወረ አንጦኪያ፣ ሶርያፊ ኪልቅያ ኬሰ ጅራተኒት፤</para>
  <para style="pmo" vid="ACT 15:23">ነጋ እስኒ ዻምነ።<verse eid="ACT 15:23"/></para>
  <para style="pm">
    <verse number="24" style="v" sid="ACT 15:24"/>ኑ አከ ነሞትን ቶኮ ቶኮ ኤየመኬኘ መሌ ኑ ብራ በአኒ ዋን ዱበተኒን ቀልቢ እስን ራሰኒ እስን ጄቀን ዸጌኜረ። <verse eid="ACT 15:24"/><verse number="25" style="v" sid="ACT 15:25"/>ከናፉ ኑ ሁንድ ነሞተ ቶኮ ቶኮ ፍለትኔ ኦቦሎተኬኘ ጃለተሞ በርናባሲፊ ጳዉሎስ ጄቹንስ <verse eid="ACT 15:25"/><verse number="26" style="v" sid="ACT 15:26"/>ነሞተ መቃ ጎፍታኬኘ ዬሱስ ክርስቶሲቲፍ ጄዸኒ ጅሬኘሳኒ ኬነን እስንት ኤርጉፍ ወሊ ገሌ። <verse eid="ACT 15:26"/><verse number="27" style="v" sid="ACT 15:27"/>ከናፉ አከ እሳን ዋኑመ ኑ በሬስኔ ሰነ ዱቢ አፋኒቲን እስኒ ምርከኔሰኒፍ ጄኔ ይሁዳፊ ሲላስን ኤርግኔረ። <verse eid="ACT 15:27"/><verse number="28" style="v" sid="ACT 15:28"/>ዋን በርባችሳ አርማን ገድ ጅሩ ከነ መሌ አከ ኑ በኣ ቶኮሌ እስንረ ህንኬኜ ሀፉር ቁልቁሉን ጃለቴረ፤ ኑስ እት ገመድኔረ፤ <verse eid="ACT 15:28"/><verse number="29" style="v" sid="ACT 15:29"/>ኩንስ አከ እስን ኛተ ዋቆተ ቶልፈሞፍ ኣርሳ ዽኤፈሙ፣ ዺገ፣ ፎን ሆሪ ሁዸሜ ዱኤቲፊ ሰጋገሉማ ለገተኒዸ። እስን ዮ ዋን ከነራ ኦፍ ኤግደን፣ ዋን ቀጄላ ሆጄተን።</para>
  <para style="pmc" vid="ACT 15:29">ነጋት።<verse eid="ACT 15:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 15:30"/>ጀር ሱንስ ኤርገመኒ አንጦኪያት ገድ ቡአን፤ አችትስ አመንቶተ ወልት ቀበኒ ጠለያ ሰነ እት ኬነን። <verse eid="ACT 15:30"/><verse number="31" style="v" sid="ACT 15:31"/>አመንቶትንስ ዮሙ ጠለያ ሰነ ዱብሰንት ጎርሰ ጀጀቤሳ ሰነት ንገመደን። <verse eid="ACT 15:31"/><verse number="32" style="v" sid="ACT 15:32"/>ይሁዳፊ ሲላስ ወር መታንሳኒዩ ራጆተ ቱረን ሱን ዱቢ ባይኤን ኦቦሎተ ጎርሰኒ ጀጀቤሰን። <verse eid="ACT 15:32"/><verse number="33" style="v" sid="ACT 15:33"/>ኤርገ እሳን ዬሮ ገባባ አች ቱረኒ ቦዴስ፣ ኦቦሎትን አከ እሳን ወረ እሳን ኤርገንት ዴብአኒፍ ነጋን እሳን ጌጌሰን። [ <verse eid="ACT 15:33"/><verse number="34" style="v" sid="ACT 15:34"/>ሲላስሞ አቹመት ሀፉ ሙርቴሴ።]<note caller="+" style="f"><char style="fr" closed="false">15፥34 </char><char style="ft" closed="false">ወራብሌን ዱሪ ቶኮ ቶኮ ሉቅሳ ከነ ህንቀበን።</char></note> <verse eid="ACT 15:34"/><verse number="35" style="v" sid="ACT 15:35"/>ጳዉሎሲፊ በርናባስ ገሩ አንጦኪያት ሀፈኒ ነሞተ ብራ ሄዱ ወጅን ዱቢ ጎፍታ በርሲሰን፤ ንለለበንስ።<verse eid="ACT 15:35"/></para>
  <para style="s1">ወል ዸቡ ጳዉሎሲፊ በርናባስ</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 15:36"/>ጳዉሎስስ ቡልቲ ገባብዱ ቦዴ በርናባሲን፣ “ሜ ኮቱ፣ መጋላወን እት ዱቢ ጎፍታ ለለብኔ ሁንደት ዴብኔ ኦቦሎተ ዱብፍና፤ ሃለ እሳን ኬሰ ጅረንስ ንእላላ!” ጄዼ። <verse eid="ACT 15:36"/><verse number="37" style="v" sid="ACT 15:37"/>በርናባስስ ዮሀንስ እሰ ማርቆስ ጄዸሙ ሰነ እሳን ወጅን ፉዸቴ ዴሙ በርባዴ። <verse eid="ACT 15:37"/><verse number="38" style="v" sid="ACT 15:38"/>ጳዉሎስ ገሩ ሰበቢ ማርቆስ እሳን ወጅን ሆጂት ፉፉ ድዴ ጰምፉልያት እሳን ዺሴ ዴሜፍ አከ እን እሳን ወጅን ዴሙ ህንጃለትኔ። <verse eid="ACT 15:38"/><verse number="39" style="v" sid="ACT 15:39"/>ከነረት ወልዸቢስን ጉዳንሳ ግዱሳኒት ኡመምናን ገርገር በአን፤ በርናባስስ ማርቆስን ፉዸቴ ዶኒዻን ቆጵሮስት ቀጄሌ። <verse eid="ACT 15:39"/><verse number="40" style="v" sid="ACT 15:40"/>ጳዉሎስሞ ሲላስን ፍለቴ ኤርገ ኦቦሎትን ደበርሰኒ አያነ ጎፍታት እሰ ኬነኒ ቦዴ ከኤ ዴሜ። <verse eid="ACT 15:40"/><verse number="41" style="v" sid="ACT 15:41"/>እንስ ወልዶተ ክርስታና ጀጀቤሳ ሶርያፊ ኪልቅያ ኬሰ ደርቤ።<verse eid="ACT 15:41"/></para>
  <chapter eid="ACT 15"/>
  <chapter number="16" style="c" sid="ACT 16"/>
  <para style="s1">ጢሞቴዎስ ጳዉሎሲፊ ሲላስት መከሜ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1"/>ጳዉሎስ እቱመ ፉፌ ገረ ደርቤኒፊ ልስጥራኒ ዸቄ፤ በረታን ጢሞቴዎስ ጄዸሙ ከን ሃትሳ ይሁዲ አመንቱ ታቴ ቶኮስ አች ቱሬ፤ አባንሳ ገሩ ነመ ግሪክ። <verse eid="ACT 16:1"/><verse number="2" style="v" sid="ACT 16:2"/>ኦቦሎትን ልስጥራኒፊ እቆንዮን ኬሰ ጅራተን ዋኤሳ ዋን ጋሪ ዱበተን። <verse eid="ACT 16:2"/><verse number="3" style="v" sid="ACT 16:3"/>ጳዉሎስ አከ ጢሞቴዎስ እሰ ፋነ ዴሙ በርባዴ፤ ከናፍ ሰበቢ ይሁዶተ ናኖ ሰነ ጅራተኒቲፍ ጄዼ ዸግነ እሰ ቀቤ፤ እሳን ሁንድኑ አከ አባን ጢሞቴዎስ ነመ ግሪክ ተኤ ቤኩ ቱረኒቲ። <verse eid="ACT 16:3"/><verse number="4" style="v" sid="ACT 16:4"/>እሳንስ አኩመ መጋላ ቶኮ ገረ መጋላ ካኒት ደርበኒን አከ ነሞትን አጀጀመኒፍ ጄዸኒ ሙርቲ ኤርገሞትኒፊ ማንጉዶትን ዬሩሳሌም ኬሰ ጅራተን ሙርቴሰን ሰነ ነሞተት ህመን። <verse eid="ACT 16:4"/><verse number="5" style="v" sid="ACT 16:5"/>ከናፉ ወልዶትን ክርስታና አመንቲት ጭማ፣ ባይእናንስ ጉዩመ ጉያን እት ደበለማ ዴመን።<verse eid="ACT 16:5"/></para>
  <para style="s1">ጳዉሎስ ሙልአታን ነምቸ መቄዶንያ ቶኮ አርጌ</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6"/>እሳንስ ሀፉር ቁልቁሉን አከ እሳን ብየ አስያ ኬሰት ዱብቸ ህንለለብኔ እሳን ዾውናን ብየ ፍርግያቲፊ ገላትያ ኬሰ ደርበን። <verse eid="ACT 16:6"/><verse number="7" style="v" sid="ACT 16:7"/>ዮሙ ሚስያ ገአንትስ ቢታንያ ሴኑ ያለን፤ ሀፉር ዬሱስ ገሩ እሳኒ ህንኤየምኔ። <verse eid="ACT 16:7"/><verse number="8" style="v" sid="ACT 16:8"/>ከናፍ ሚስያ ኬሰ በአኒ ጢሮአዳት ገድ ቡአን። <verse eid="ACT 16:8"/><verse number="9" style="v" sid="ACT 16:9"/>ጳዉሎስስ ሀልከን ሰነ ነምቸ መቄዶንያ ቶኮ እሳ ዻበቴ፣ “መቄዶንያ ኮቱቲ ኑ ገርጋር” ጄዼ እሰ ከዸቱ ሙልአታን አርጌ። <verse eid="ACT 16:9"/><verse number="10" style="v" sid="ACT 16:10"/>ኑስ ኤርገ ጳዉሎስ ሙልአተ ሰነ አርጌ ቦዴ፣ ዋቅን አከ ኑ ወንጌለ እሳንት ለለብኑፍ ኑ ዋሙ እሳት ጄኔ መቄዶንያ ዸቁፍ ቆጶፍኔ ካኔ።<verse eid="ACT 16:10"/></para>
  <para style="s1">ልድያን ክርስቶስት አመንቴ</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11"/>ጢሮአዳዻስ ዶኒዻን ካኔ ሳሞትራቄት ፉለ ዴብፈትኔ ቀጄሌ፤ ጉያ እት ኣኑሞ ኔአጶልስት ደበሬ። <verse eid="ACT 16:11"/><verse number="12" style="v" sid="ACT 16:12"/>አቺ ካኔስ ፊልጵስዩስ ዸቅኔ፤ እሼንስ መጋላ ቤከምቱ ኣና መቄዶንያ ከን ኮሎኒ ሞቱማ ሮማ ጀለ ቱርቴዸ፤ ኑስ መጋለቲ ኬሰ ጉያ ሙራሰ ቱሬ።<verse eid="ACT 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 16:13"/>ጉያ ሰንበታሞ መጋለቲ ኬሳ ባኔ ገረ ለጋ እዶ አከ ለፈ ከዸትና እት አርገትኑ አብደትኔ ቶኮት ገድ ቡኔ፤ ቴቴኜስ ዱበርቶተ አችት ወልት ቀበመንት ዱበቹ ጀልቀብኔ። <verse eid="ACT 16:13"/><verse number="14" style="v" sid="ACT 16:14"/>ወረ ኑ ዸጌፈቻ ቱረን ኬሳስ ዱበርቲ ልድያ ጄዸምቱ ቶኮቱ ቱሬ፤ እሼን ደልደልቱ ወያ ዺልጌ ከን መጋላ ትያትራ ዹፍቴ፣ ዋቀስ ዋቄፈቱ ቱርቴ። ጎፍታን አከ እሼን ዋን ጳዉሎስ ዱበቱ ቀልቤፈቱፍ ቀልቢሼ በኔፍ። <verse eid="ACT 16:14"/><verse number="15" style="v" sid="ACT 16:15"/>እሼንስ ኤርገ ወረ መነሼ ጅራተን ወጅን ጩጰምቴ ቦዴ፣ “ዮ አከ ነመ ጎፍታት አመኑ ቶኮት ነ እላልተን፣ ኮታቲ መነኮ ቱራ” ጄቴ ኑ ዋምቴ፤ ጀቤስቴስ ኑ ከዸቴ።<verse eid="ACT 16:15"/></para>
  <para style="s1">ጳዉሎሲፊ ሲላስ መነ ህዻ ኬሰት</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 16:16"/>ጋፍ ቶኮ ኡቱ እዶ እት ዋቀ ከዸተን ዸቅኑ ጦምቦሬ ሀፉረ ዋ ህምሲሱን ጉተምቴ ቶኮን ወልት ዹፍኔ፤ እሼን ዋ ነማ ህሙን ጎፍቶተ እሼቲፍ ማለቀ ጉዳ ገልችት ቱርቴ። <verse eid="ACT 16:16"/><verse number="17" style="v" sid="ACT 16:17"/>እሼንስ፣ “ነሞትን ኩኔን ተጃጅልቶተ ዋቀ ጉድቻ ከኔን ከራ ፈይና እስንት ህመኒዸ” ጄቴ እያ ጳዉሎሲፊ ኑ ዱካ ቡቴ። <verse eid="ACT 16:17"/><verse number="18" style="v" sid="ACT 16:18"/>ዋን ከነስ ጉያ ሄዱ እት ፉፍቴ፤ ጳዉሎስ ገሩ ዋን አከ መሌ ኣሬፍ እት ገረገሌ ሀፉረ ሰናን፣ “አን አከ አት እሼ ኬሳ ባቱ መቃ ዬሱስ ክርስቶሲቲን ስን አጀጀ” ጄዼ፤ ሀፉርችስ ዮሙሱመ እሼ ኬሳ በኤ።<verse eid="ACT 16:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 16:19"/>ጎፍቶትን ጦምቦሬ ሰናስ ዮሙ አከ አብዲን ገሊሳኒ ጭቴ ሁበተንት ጳዉሎሲፊ ሲላስን ቀበኒ ፉለ አቦቲ ታይታ ዱረት ዽኤሱፍ ጄዸኒ ለፈረ ሀርክሳ እዶ ገባት እሳን ጌሰን። <verse eid="ACT 16:19"/><verse number="20" style="v" sid="ACT 16:20"/>ፉለ ቆንዳልቶታ ዱረትስ እሳን ዽኤሰኒ አከነ ጄዸን፤ “ነሞትን ኩኔን ይሁዶተ፤ መጋላኬኘስ ጄቁት ጅሩ። <verse eid="ACT 16:20"/><verse number="21" style="v" sid="ACT 16:21"/>እሳንስ ዱዻ ፉዸቹን ዮካን እት ቡሉን ኑ ወረ ሮማቲፍ ህንኤየመምኔ በርሲሱ።”<verse eid="ACT 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 16:22"/>ነሞትንስ ቶኩማዻን ጳዉሎሲፊ ሲላስት ከአን፤ ቆንዳልቶትን ሱንስ አከ ወያን እሳንራ ባፈሜ ኡሌዻን ቱመመን አጀጀን። <verse eid="ACT 16:22"/><verse number="23" style="v" sid="ACT 16:23"/>ጀርስ ኤርገ አከ መሌ ገረፈመኒ ቦዴ መነ ህዻት ደርበተመን፤ ኤግዱን መነ ህዻ ሰናስ አከ ጀቤሴ እሳን ኤጉ አጀጀሜ። <verse eid="ACT 16:23"/><verse number="24" style="v" sid="ACT 16:24"/>እንስ አጀጀ ከነ ፉዸቴ ጎለ መነ ህዻ ኬሰ እሳን ገልቼ፤ ሚለሳኒስ ጅርመ ግዱ ገልቼ ህዼ።<verse eid="ACT 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 16:25"/>ገረ ሀልከን ወለካት ጳዉሎሲፊ ሲላስ ከዸቻ፣ ፋርፈትናዻንስ ዋቀ ገለቴፈቻ ቱረን፤ ህዸምቶትን ካንስ እሳን ዸጌፈቻ ቱረን። <verse eid="ACT 16:25"/><verse number="26" style="v" sid="ACT 16:26"/>አኩመ ተሳ ሶቺን ለፋ ጭማን ቶኮ ተኤ፤ ከናንስ ሁንዴን መነ ህዻ ሰና ራፈሜ፤ ዮሙሱመ በልበል ሁንድኑ ንበነሜ፤ ፎንጫን ነመ ሁንዳስ ንሂከሜ። <verse eid="ACT 16:26"/><verse number="27" style="v" sid="ACT 16:27"/>ኤግዱን መነ ህዻ ሱንስ ዮሙ ደመቄ አከ በልበል መነ ህዻ በነሜ አርጌት ዋን ህዸምቶትን በአኒ በደን ሴኤ ኦፍ አጄሱፍ ጎራዴሳ ሉቅፈቴ። <verse eid="ACT 16:27"/><verse number="28" style="v" sid="ACT 16:28"/>ጳዉሎስ ገሩ ሰገሌ ጉዳን እዬ፣ “ኑ ሁንድ አሱመ ጅራቲ ኦፍ ህንሚዽን” ጄዼን።<verse eid="ACT 16:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 16:29"/>ኤግዱን ሱንስ እብሳ ፍችሲፈቴ ፊጋ ኦል ገሌ፤ ሶዳዻንስ ሆለቻ ጳዉሎሲፊ ሲላስ ዱረት ኩፌ፤ <verse eid="ACT 16:29"/><verse number="30" style="v" sid="ACT 16:30"/>ገድ እሳን ባሴስ፣ “ያ ጎፍቶተኮ፣ አን አከ ፈዩፍ ማል ጎቹን ቀበ?” ጄዼ ጋፈቴ።<verse eid="ACT 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 16:31"/>እሳንስ ዴብሰኒ፣ “ጎፍታ ዬሱስት አመን፤ አት ንፈይታ፤ ወር መነኬ ጅራተንስ ንፈዩቲ” ጄዸን። <verse eid="ACT 16:31"/><verse number="32" style="v" sid="ACT 16:32"/>ዱቢ ጎፍታስ እሳፊ ወረ መነሳ ጅራተን ሁንደት ህመን። <verse eid="ACT 16:32"/><verse number="33" style="v" sid="ACT 16:33"/>ኤግዱን መነ ህዻ ሱንስ ሰኣቱመ ሀልከኒ ሰነ እሳን ፉዼ መዳሳኒ ዽቄፍ፤ ዮሙሱመስ እኒፊ ማቲንሳ ሁንድኑ ጩጰመን። <verse eid="ACT 16:33"/><verse number="34" style="v" sid="ACT 16:34"/>ኤግዱን ሱንስ መነሳት እሳን ጌሴ ኛተ ዽኤሴፍ፤ ሰበቢ ማቲንሳ ሁንድ ገረ ዋቀ አመኑት ዹፈኒፍ ወር መነሳ ጅራተን ሁንድ አከ መሌ ገመደን።<verse eid="ACT 16:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35"/>ዮሙ ለፍት በርኤት ቆንዳልቶትን ሱን፣ “ነሞተ ሰነ ገድ ዺስ” ጄዸኒ ኤግዱ መነ ህዻ ሰነት ፖልሲ ኤርገን። <verse eid="ACT 16:35"/><verse number="36" style="v" sid="ACT 16:36"/>ኤግዱን ሱንስ፣ “ቆንዳልቶትን አከ እስን ሂከምተን አጀጀኒሩ፤ ከናፍ አመ ዴሙ ንደንዴሱ፤ ነጋን ገላ” ጄዼ ጳዉሎስት ህሜ።<verse eid="ACT 16:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 16:37"/>ጳዉሎስ ገሩ ፖልሶተ ሰናን አከነ ጄዼ፤ “እሳን ኡቱመ ኑ ለሚወን ሮማ ታኔ ጅሩ፣ ሙርቲ ቶኮ መሌ ኑ ገረፈኒ መነ ህዻት ኑ ደርበተን፤ አመሞ ዾክሳን ኑ ባሱ በርባዱ? ኩን ህንተኡ! እሳኑምት መታንሳኒ ዹፈኒ ኑ ሃባሰኒ!” ጄዼ።<verse eid="ACT 16:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 16:38"/>ፖልሶትንስ ዱቢ ከነ ቆንዳልቶተት ህመን፤ ቆንዳልቶትንስ ዮሙ አከ ጳዉሎሲፊ ሲላስ ለሚወን ሮማ ተአን ዸገአንት ንርፈተን። <verse eid="ACT 16:38"/><verse number="39" style="v" sid="ACT 16:39"/>እሳንስ ዹፈኒ ዺፈመ እሳን ጋፈተን፤ መነ ህዻቲ እሳን ባሰኒ አከ እሳን መጋለቲ ኬሳ በአኒ ዴመኒፍ እሳን ከዸተን። <verse eid="ACT 16:39"/><verse number="40" style="v" sid="ACT 16:40"/>ጳዉሎሲፊ ሲላስ መነ ህዻቲ በአኒ መነ ልድያ ዸቀን፤ እሳንስ ዮሙ ኦቦሎተ አርገንት እሳን ጀጀቤሰን፤ አቺስ በአኒ ዴመን።<verse eid="ACT 16:40"/></para>
  <chapter eid="ACT 16"/>
  <chapter number="17" style="c" sid="ACT 17"/>
  <para style="s1">ጳዉሎሲፊ ሲላስ ተሰሎኒቄ ኬሰት</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1"/>እሳንስ አምፊጶሊሲፊ አጶሎንያ ኬሰ ደርበኒ ተሰሎኒቄ እዶ መን ሰገዳ ይሁዶታ ቱሬ ዹፈን። <verse eid="ACT 17:1"/><verse number="2" style="v" sid="ACT 17:2"/>ጳዉሎስስ አኩመ አመለሳ መነ ሰገዳ ሴኔ ጉያ ሰንበታ ሰዲ ዱቢ ክታባረት እሳን ወጅን ዱዱበቻ፣ <verse eid="ACT 17:2"/><verse number="3" style="v" sid="ACT 17:3"/>አከ ክርስቶስ ዽጰቹፊ ወረ ዱአን ኬሳ ከኡ ቀቡ አዴሳ፣ ምርከኔሳስ ቱሬ። እንስ፣ “ዬሱስ አን አመ እስንት ህሙ ኩን ክርስቶሲዸ” ጄዼ። <verse eid="ACT 17:3"/><verse number="4" style="v" sid="ACT 17:4"/>ይሁዶተ ኬሳ ቶኮ ቶኮ፣ ግሪኮተ ዋቀ ሶዳተን ኬሳስ ነሞትን አከ መሌ ባይአተኒፊ ዱበርቶትን ቤቤከሞን ሄዱን አመነኒ ጳዉሎሲፊ ሲላስት ደበለመን።<verse eid="ACT 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 17:5"/>ይሁዶትን ገሩ ህናፋን ጉተመን፤ እሳንስ እዶ ገባቲ ከሽለቦተ ቶኮ ቶኮ ወልት ቀበተኒ፣ ኡመተስ ከካሰኒ መጋላ ኬሰት ጎሊ ኡመን፤ ጳዉሎሲፊ ሲላስንስ ፉለ ኡመታ ዱረት ዽኤሱፍ ጄዸኒ እሳን በርባቸ መነ ያሶንት ፊገን። <verse eid="ACT 17:5"/><verse number="6" style="v" sid="ACT 17:6"/>ዮሙ ጀረ ዸበንትሞ ያሶኒፊ ኦቦሎተ ቶኮ ቶኮ ሀርክሳ ፉለ ቆንዳልቶተ መጋላ ዱረት ዽኤሰኒ አከነ ጄዸኒ እየን፤ “ነሞትን አዱኛ ሁንደ ረክሳ ቱረን ኩኔን አመ ኩኖ አስ ዹፈኒሩ፤ <verse eid="ACT 17:6"/><verse number="7" style="v" sid="ACT 17:7"/>ያሶንስ መነሳት እሳን ስመቴረ። ሁንድሳኒስ፣ ‘ሞቲን ብራ ከን ዬሱስ ጄዸሙ ቶኮ ጅረ’ ጄዸኒ ለብሲ ቄሳሪን ሞርሙ።” <verse eid="ACT 17:7"/><verse number="8" style="v" sid="ACT 17:8"/>ኡመትኒፊ ቆንዳልቶትን መጋላ ሰናስ ዮሙ ዋን ከነ ዸገአንት ንራፈመን። <verse eid="ACT 17:8"/><verse number="9" style="v" sid="ACT 17:9"/>እሳንስ ያሶኒፊ ወረ ካንራ ቀብሲሰ ፉዸኒ ገድ እሳን ዺሰን።<verse eid="ACT 17:9"/></para>
  <para style="s1">ጳዉሎሲፊ ሲላስ ቤርያ ኬሰት</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 17:10"/>ኦቦሎትንስ ዬሩመ ሰነ ጳዉሎሲፊ ሲላስን ሀልከኒን ቤርያት ኤርገን፤ እሳንስ ዮሙ አች ገአንት መነ ሰገዳ ይሁዶታ ሴነን። <verse eid="ACT 17:10"/><verse number="11" style="v" sid="ACT 17:11"/>ይሁዶትን ቤርያ ይሁዶተ ተሰሎኒቄረ ቀልቢ ቀቤዪ ቱረን፤ እሳንስ ፌዺ ጉዳን ዱቢ ሰነ ፉዸተኒ አከ ወን ጳዉሎስ ጄዼ ሱን ዹጋ ተኤፊ አከ ዹጋ ህንተእን እላሉፍ ጄዸኒ ጉዩመ ጉያን ከተቢወን ቁልቁሉ ቆረቻ ቱረኒቲ። <verse eid="ACT 17:11"/><verse number="12" style="v" sid="ACT 17:12"/>ከናፍ ይሁዶተ ኬሳ ባይኤን ንአመነን፤ አከሱመስ ዱበርቶትን ግሪክ ቤከሞን ሄዱኒፊ ዺሮትን ግሪክ ሄዱን ንአመነን።<verse eid="ACT 17:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 17:13"/>ይሁዶትን ተሰሎኒቄ ዮሙ አከ ጳዉሎስ ቤርያ ኬሰትስ ዱቢ ዋቃ ለለባ ቱሬ ዸገአንት አችስ ዸቀኒ ረኮ ኡመኒ ኡመተ ከካሰን። <verse eid="ACT 17:13"/><verse number="14" style="v" sid="ACT 17:14"/>ኦቦሎትንሞ ዮሙሱመ ጳዉሎስን ገረ ቀርቀረ ገላናት ኤርገን፤ ሲላሲፊ ጢሞቴዎስ ገሩ ቤርያት ሀፈን። <verse eid="ACT 17:14"/><verse number="15" style="v" sid="ACT 17:15"/>ነሞትን ጳዉሎስን ጌጌሰንስ አቴናን እሰ ገአኒ አከ ሲላሲፊ ጢሞቴዎስ ሀመ እሳኒ ደንደአሜት ደፈኒ ጳዉሎስ ብረ ዸቀኒፍ አጀጀ ፉዸኒፊ ዴብአን።<verse eid="ACT 17:15"/></para>
  <para style="s1">ጳዉሎሲፊ ሲላስ አቴና ኬሰት</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16"/>ጳዉሎስ ኡቱ አቴና ኬሰት እሳን ኤጋ ጅሩ አከ መጋላን ሱን ዋቆተ ቶልፈሞዻን ጉተምቴ አርጌ አከ መሌ ገዴ። <verse eid="ACT 17:16"/><verse number="17" style="v" sid="ACT 17:17"/>ከናፍ መነ ሰገዳ ኬሰት ይሁዶታፊ ግሪኮተ ዋቀ ሶዳተን ወጅን፣ እዶ ገባትሞ ጉዩመ ጉያን ወረ አችት አርገመን ወጅን ፈልማ ቱሬ። <verse eid="ACT 17:17"/><verse number="18" style="v" sid="ACT 17:18"/>ገሬን ፈላሰምቶተ ኤፊቆሮሲቲፊ<note caller="+" style="f"><char style="fr" closed="false">17፥18 </char><char style="fq" closed="false">ኤፊቆሮሲቲ </char><char style="ft" closed="false">– ፈላሰማን ግሪኪ ከን ኤፊቆሮስ ጄዸሙ ቶኮ ዸሎተ ጎፍታቲን ዱረ (በረ 341–270 ኬሰ) አከ ገመቹን ጅሬኘ ነማ ኬሰት ዋን ሁንዱማ ጫላ ጋሪ ተኤ በርሲሴ ቱሬ። ገሬን ኤፊቆሮስ አከ ዋን ዋቆትን ህንጅሬት ዮካን አከ ዋን ዋቆትን ዋን አዱኛ ኬሰት ተኡረት ሁምነ ህንቀብኔት አመነን።</char></note> እስጦኢክ<note caller="+" style="f"><char style="fr" closed="false">17፥18 </char><char style="fq" closed="false">እስጦኢክ </char><char style="ft" closed="false">– እሳን በሩምሰ ፈላስቱ ዜኖ ጄዸሙ ከን ዸሎተ ክርስቶሲቲን ዱረ (በረ 340–265 ኬሰ) አከ ገመቹን ጅሬኘ ቶላን ዮካን ዹኩብሰቻን ዮካን ሞአቹን ዮካን ሞአተሙን ቱቀሙ ዸቡ ኬሰ ጅሩ አዴሰኒ እብሰን።</char></note> ቶኮስ እሳን ፈልማ ቱሬ፤ እሳን ኬሳ ቶኮ ቶኮ፣ “ነምች ሌጌሌጋን ኩን ማል ጄዸ?” ጄዸን። ወር ካንሞ፣ “እን ዋኤ ዋቆተ ኦርማ ለብሰ ፈካተ” ጄዸን። ጳዉሎስ ዋኤ ዬሱሲፊ ዋኤ ዱኣ ከኡ ለለባ ቱሬቲ። <verse eid="ACT 17:18"/><verse number="19" style="v" sid="ACT 17:19"/>እሳንስ እሰ ቀበኒ ገረ ወል ገኢ አርዮጳጎስት ጌሰን፤ አችትስ አከነ ጄዸኒን፤ “በርሲስን ሃራን አት ፍዴ ኩን ማል አከ ተኤ ቤኩ ደንዴኛ? <verse eid="ACT 17:19"/><verse number="20" style="v" sid="ACT 17:20"/>አት ዋን ኑ ተኩማ ህንዸገእን ኑት ህማ ጅርተ፤ ከናፍ ኑ አከ ወን ኩን ማል ጄቹ ተኤ ቤኩ ፌነ።” <verse eid="ACT 17:20"/><verse number="21" style="v" sid="ACT 17:21"/>ወር አቴና ሁንዲፊ ነሞትን ብየ ኦርማ ከኔን አች ጅራተን ዬሮሳኒ ዋን ሃራ ዸገኡፊ ኦዴሱረት መሌ ዋን ብራረት ህንበሌሰን ቱሬ።<verse eid="ACT 17:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 17:22"/>ጳዉሎስስ ወል ገኢ አርዮጳጎስ ወለካ ዻበቴ አከነ ጄዼ፤ “ያ ነሞተ አቴና! አን አከ እስን ከራ ሁንዳኑ ወረ አመንታ ታተን ነንሁበዸ። <verse eid="ACT 17:22"/><verse number="23" style="v" sid="ACT 17:23"/>አን ዮሙን ነናነኤ ዋን እስን ዋቄፈተን እላሌት እዶ ኣርሳ ከን ከተቢ፣</para>
  <para style="pc" vid="ACT 17:23">ዋቀ ህንቤከምኔፍ</para>
  <para style="m" vid="ACT 17:23">ጄዹ ኦፍራ ቀቡ አርጌራቲ። ኤጋ አመ ዋን እስን ኡቱ ህንቤክን ዋቄፈተን ከነ እስንትን ህመ።<verse eid="ACT 17:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 17:24"/>“ዋቅን አዱኛፊ ዋን እሼ ኬሰ ጅሩ ሁንደ ኡሜ ሱን ጎፍታ ሰሚቲፊ ለፋት፤ እን መነ ቁልቁሉማ ከን ሀርከ ነማቲን ሆጄተሜ ኬሰ ህንጅራቱ። <verse eid="ACT 17:24"/><verse number="25" style="v" sid="ACT 17:25"/>እን መታንሳ ሰበቢ ጅሬኘ ሀፉረ ባፈተሙፊ ዋን ብራ ሁንደ ነመ ሁንዳፍ ኬኑፍ አከ ዋን ዋ ዸቤት ሀርከ ነማቲን ህንተጃጅለሙ። <verse eid="ACT 17:25"/><verse number="26" style="v" sid="ACT 17:26"/>እን ሰቦተ ሁንደ ነመ ቶኮራ ኡሜ አከ እሳን ለፈ ሁንደረ ጅራተን ጎዼ፤ በረ ጅሬኛ ከን እሳኒ ኬነሜፊ ዳሪ ለፈ እሳን ጅራተኒ ሙርቴሴ። <verse eid="ACT 17:26"/><verse number="27" style="v" sid="ACT 17:27"/>ዋቅን ዮ ቶኮ ቶኮኬኘራ ፈጎ ጅራቹ ባቴዩ አከ ነሞትን እሰ በርባደኒ፣ ተሪ ጨራቀኒስ እሰ አርገተኒፍ ጄዼ ዋን ከነ ጎዼ። <verse eid="ACT 17:27"/><verse number="28" style="v" sid="ACT 17:28"/>አኩመ ቤክቶትንኬሰን ቶኮ ቶኮ፣ ‘ኑ እልማንሳት’ ጄዸን ሰነ ‘ኑ እሰ ኬሰ ጅራትነ፤ እሰ ኬሰ ሶቾነ፤ ኤኙማኬኘሌ እሰ ኬሰት ቀባትናቲ።’<verse eid="ACT 17:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 17:29"/>“ከናፉ ኑ ዋን እልማን ዋቃ ታኔፍ ዋቅን ዋን አከ ወርቄ ዮካን ሜቲ ዮካን ዸጋ ጄቹንስ ዋን ኦጉማፊ ቤኩምሰ ነማቲን ሆጄተሜ ፈካተ ጄኔ ያዱ ህንቀብኑ። <verse eid="ACT 17:29"/><verse number="30" style="v" sid="ACT 17:30"/>ዋቅን በረ ወላሉማ ዱሪ ህንእላሉ ቱሬ፤ አመ ገሩ አከ ነምን እዶ ሁንደ ጅሩ ሁንድ ቀልቢ ጅጂረቱ አጀጀ። <verse eid="ACT 17:30"/><verse number="31" style="v" sid="ACT 17:31"/>እንስ ጉያ እት ሀርከ ነምቸ ፍለቴ ሰናቲን ቀጄሉማዻን አዱኛት ሙሩ ሙርቴሴራቲ፤ ከነስ ወረ ዱአን ኬሳ እሰ ካሱን ነመ ሁንዱማፍ ምርከኔሴረ።”<verse eid="ACT 17:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 17:32"/>እሳን ኬሳ ነሞትን ቶኮ ቶኮ ዮሙ ዋኤ ዱኣ ከኡ ወረ ዱአኒ ዸገአንት ንቆሰን፤ ወር ካንሞ፣ “ኑ አመስ ዱቢ ከነ ስራ ዸገኡ በርባድነ” ጄዸን። <verse eid="ACT 17:32"/><verse number="33" style="v" sid="ACT 17:33"/>ከነረት ጳዉሎስ እሳን ኬሳ በኤ ዴሜ። <verse eid="ACT 17:33"/><verse number="34" style="v" sid="ACT 17:34"/>ነሞትን ቶኮ ቶኮ ገሩ ገመ ጳዉሎስ ጎረኒ አመነን፤ እሳን ኬሳስ ነምች ዲዮናስዮስ ጄዸሙ ከን ምሴንሰ አርዮስፋጎስ ቱሬ ቶኮ፣ ዱበርቲን ደማሪስ ጄዸምቱፊ ነሞትን ብራስ እሳን ወጅን ቱረን።<verse eid="ACT 17:34"/></para>
  <chapter eid="ACT 17"/>
  <chapter number="18" style="c" sid="ACT 18"/>
  <para style="s1">ጳዉሎስ ቆሮንቶስ ኬሰት</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 18:1"/>ከነ ቦዴ ጳዉሎስ አቴና ከኤ ቆሮንቶስ ዸቄ። <verse eid="ACT 18:1"/><verse number="2" style="v" sid="ACT 18:2"/>አችትስ ይሁዲ አቂላ ጄዸሙ ከን ብየ ጳንጦስት ዸለቴ ቶኮ አርገቴ፤ አቂላን ኩንስ ሰበቢ ቀላዉዴዎስ አከ ይሁዶትን ሁንድኑ ብየ ሮማ ኬሳ በአን አጀጄፍ ዽኦ ኒቲሳ ጵርስቅላ ወጅን ኢጣልያዻ ዹፌ። ጳዉሎስስ እሳን እላሉ ዸቄ። <verse eid="ACT 18:2"/><verse number="3" style="v" sid="ACT 18:3"/>እንስ ዋን አኩመሳኒ ሆጄታ ዱንካና ቱሬፍ አች ጅራቴ እሳን ወጅን ሆጄቴ። <verse eid="ACT 18:3"/><verse number="4" style="v" sid="ACT 18:4"/>ጉያ ሰንበታ ሁንደስ መነ ሰገዳ ኬሰት ፈልሜ ይሁዶታፊ ግሪኮተ አመንሲሰ ቱሬ።<verse eid="ACT 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 18:5"/>ጳዉሎስ ዬሮ ሲላሲፊ ጢሞቴዎስ መቄዶንያዻ ዹፈንት አከ ዬሱስ ኩን ክርስቶስ ተኤ ይሁዶታፍ ዹጋ በኣ ዱብቸ ለለቡት ንጀባተ ቱሬ። <verse eid="ACT 18:5"/><verse number="6" style="v" sid="ACT 18:6"/>ዮሙ ይሁዶትን እሳን ሞርመኒ እሰ አረብሰንትስ ገሩ ጳዉሎስ ኡፈተሳ ሁርጉፈቴ፣ “ዺግንኬሰን መቱመኬሰንረ ሃጅራቱ! አን ቁልቁሉዸ፤ አማ ጀልቀቤ ገረ ነሞተ ኦርማ ነንዸቀ” ጄዼን።<verse eid="ACT 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 18:7"/>እንስ አቺ በኤ መነ ነምቸ ዋቀ ዋቄፈቱ ከን መቃንሳ ዮስጦስ ጄዸሙ ቶኮ ዸቄ፤ መን ነምቸ ሰናስ መነ ሰገዳት ኣነ ቱሬ። <verse eid="ACT 18:7"/><verse number="8" style="v" sid="ACT 18:8"/>ክሪስጶስ ቡልቻን መነ ሰገዳ ሰናስ ወረ መነሳ ጅራተን ሁንደ ወጅን ጎፍታት አመኔ፤ ነሞተ ቆሮንቶስ ከኔን ጳዉሎስን ዸገአን ኬሳ ባይኤንሳኒ አመነኒ ጩጰመን።<verse eid="ACT 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 18:9"/>ሀልከን ቶኮ ጎፍታን አከነ ጄዼ ሙልአታን ጳዉሎስት ዱበቴ፤ <char style="wj">“ህንሶዳትን፤ ዱበዹ መሌስ ህንጨልእስን።</char> <verse eid="ACT 18:9"/><verse number="10" style="v" sid="ACT 18:10"/><char style="wj">ሰበቢ አን ስ ወጅን ጅሩፍ ነምን ቶኮዩ ስ ሚዹፍ ጄዼ ስ ህንቱቁ፤ አን መጋላ ከነ ኬሳ ነመ ባይኤ ቀባቲ።”</char> <verse eid="ACT 18:10"/><verse number="11" style="v" sid="ACT 18:11"/>ከናፉ ጳዉሎስ ዱቢ ዋቃ እሳን በርሲሳ ወጋ ቶኮፊ ወለካ አች ቱሬ።<verse eid="ACT 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12"/>ዬሮ ጋልዮን ቡልቻ አካያ ቱሬት ይሁዶትን ቶኩማዻን ጳዉሎስት ከአኒ መነ ሙርቲት እሰ ዽኤሰን። <verse eid="ACT 18:12"/><verse number="13" style="v" sid="ACT 18:13"/>እሳንስ፣ “ነምች ኩን አከ እሳን ከራ ሴራን አለ ተኤን ዋቀ ዋቄፈተኒፍ ነሞተ ሶሶባ ጅረ” ጄዸኒ እሰ ህመተን።<verse eid="ACT 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 18:14"/>ኡቱ ጳዉሎስ ዱበቹፍ ጄዼ አፋን በነቹት ጅሩ ጋልዮን ይሁዶታን አከነ ጄዼ፤ “ያ ይሁዶተ፣ ኡቱ ዱቢን ኩን ዋኤ በሌሳ ሆጄቹ ዮካን ዋኤ የከ ጉዳ ተኤ አን ስላ ኦብሳን እስነን ዸገአ ቱሬ። <verse eid="ACT 18:14"/><verse number="15" style="v" sid="ACT 18:15"/>ጋፊንኬሰን ገሩ ዋን ዋኤ ጄቾታ፣ ዋኤ መቃወኒቲፊ ዋኤ ሴረኬሰኒ ተኤፍ ከነ እስኑ ፍጠዻ፤ አን ዋን አከናቲፍ አባ ሙርቲ ህንተኡቲ።” <verse eid="ACT 18:15"/><verse number="16" style="v" sid="ACT 18:16"/>ከናፉ መነ ሙርቲ ኬሳ ገድ እሳን ባሴ። <verse eid="ACT 18:16"/><verse number="17" style="v" sid="ACT 18:17"/>እሳን ሁንድ ቡልቻ መነ ሰገዳ ሰነት ጄቹንስ ሶስቴንስት ገረ ገለኒ ፉለ መነ ሙርቲ ዱረት እሰ ቱሙ ጀልቀበን። ወን ኩን ገሩ ጥኑመሌ ጋልዮ ህንያዴስኔ።<verse eid="ACT 18:17"/></para>
  <para style="s1">ጵርስቅላ፣ አቂላፊ አጵሎስ</para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18"/>ጳዉሎስ ዬሮ ሙራሰ ቆሮንቶስ ኬሰ ቱሬ። ኤርገሲስ ኦቦሎተ ብራ ዴሜ ጵርስቅላፊ አቂላ ወጅን ዶኒዻን ሶርያ ዸቄ፤ እንስ ዋን ወሬገ ቀቡፍ ኡቱ ህንዴምን ክንክራኦስት መታ ሃደቴ። <verse eid="ACT 18:18"/><verse number="19" style="v" sid="ACT 18:19"/>ጳዉሎስስ ዬሮ ኤፌሶን ገአንት ጵርስቅላፊ አቂላ አችት ዺሴ ኦፊሳቲ ገሩ መነ ሰገዳ ሴኔ ይሁዶታን ሞርማ ቱሬ። <verse eid="ACT 18:19"/><verse number="20" style="v" sid="ACT 18:20"/>ዮሙ እሳን አከ እን ዬሮ ዼራ እሳን ብረ ቱሩ ከዸተንትሞ ዸገኡ ድዴ። <verse eid="ACT 18:20"/><verse number="21" style="v" sid="ACT 18:21"/>ገሩ አኩመ እሳን ብራ ዴሜን፣ “ዮ ዋቅን ጄዼ አን ዴብኤ ነንዹፈ” ጄዼን፤ ዶኒዻንስ ኤፌሶኒ ከኤ ዴሜ። <verse eid="ACT 18:21"/><verse number="22" style="v" sid="ACT 18:22"/>እንስ ቂሳርያ ጌኛን ኦል በኤ ወልዳ ክርስታና ዱብሴ፤ ኤርገሲስ አንጦኪያት ገድ ቡኤ።<verse eid="ACT 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 18:23"/>ጳዉሎስ ኤርገ አንጦኪያ ኬሰ ተከ ቡቡሌ ቦዴ አቺ ከኤ በረቶተ ሁንደ ጀጀቤሳ ብየ ገላትያቲፊ ፍርግያ ሁንደ ኬሰ እዶ ቶኮራ እዶ ካንት ነናነኣ ቱሬ።<verse eid="ACT 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 18:24"/>ግዱዹመ ሰነ ይሁዲን እስክንድርያት ዸለቴ ከን አጵሎስ ጄዸሙ ቶኮ ገረ ኤፌሶን ዹፌ፤ እንስ ነመ አረበ ቀጄሉ፣ ከን ከተቢወን ቁልቁሉ ገድ ፈጌኛን ቤኩ ቱሬ። <verse eid="ACT 18:24"/><verse number="25" style="v" sid="ACT 18:25"/>ነምች ኩን ዱራን ከራ ጎፍታ በረቴ ቱሬ፤ እን ዮ ጩጳ ዮሀንስ ቆፈ ቤኬሌ ሀፉረ ሆኣዻን ዋኤ ዬሱስ ቀጄልቼ ዱበቻ፣ በርሲሳስ ቱሬ። <verse eid="ACT 18:25"/><verse number="26" style="v" sid="ACT 18:26"/>መነ ሰገዳ ኬሰትስ ሶዳ መሌ ዱበቹ ጀልቀቤ፤ ጵርስቅላፊ አቂላንስ ዮሙ እሰ ዸገአንት መነሳኒት እሰ ዋመኒ ከራ ዋቃ እሰ ዱራ ጫላት ስሪት አዴሰኒፍ።<verse eid="ACT 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 18:27"/>ዬሮ አጵሎስ አካያ ዸቁ በርባዴት ኦቦሎትን እሰ ጀጀቤሰኒ አከ በረቶትን አች ጅረን ሱን እሰ ስመተኒፍ ጠለያ በሬሰኒፍ። እንስ አች ገኤ ወረ አያነ ዋቃቲን አመነኒ ቱረኒፍ ገርጋርሰ ጉዳ ተኤ። <verse eid="ACT 18:27"/><verse number="28" style="v" sid="ACT 18:28"/>እን አከ ዬሱስ ኩን ክርስቶስ ተኤ ከተቢወን ቁልቁሉዻን ምርከኔሳ፣ ጀባቴ እፋን እፈት ይሁዶታን ሞርሜ አመንሲሳ ቱሬቲ።<verse eid="ACT 18:28"/></para>
  <chapter eid="ACT 18"/>
  <chapter number="19" style="c" sid="ACT 19"/>
  <para style="s1">ጳዉሎስ ኤፌሶን ኬሰት</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 19:1"/>ኡቱ አጵሎስ ቆሮንቶስ ኬሰ ጅሩ ጳዉሎስሞ ብየ ኦል ኣኑ ኬሰ በኤ ኤፌሶን ዹፌ፤ አችትስ በረቶተ ቶኮ ቶኮ አርገቴ። <verse eid="ACT 19:1"/><verse number="2" style="v" sid="ACT 19:2"/>እንስ፣ “እስን ዬሮ አመንተንት ሀፉረ ቁልቁሉ አርገተኒርቱ?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="ACT 19:2">እሳንሞ ዴብሰኒ፣ “ህንአርገትኔ፤ ኑ አከ ሀፉር ቁልቁሉን ጅሩዩ ተኩማ ህንዸጌኜ” ጄዸን።<verse eid="ACT 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 19:3"/>ጳዉሎስስ፣ “ዮስ ጩጳ ከም ጩጰምተንሬ?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="ACT 19:3">እሳንስ፣ “ጩጳ ዮሀንስ” ጄዸን።<verse eid="ACT 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 19:4"/>ጳዉሎስስ፣ “ጩጳን ዮሀንስ ጩጳ ቀልቢ ጅጂረትናት፤ ዮሀንስ አከ እሳን ከን እሰ ዱባን ዹፋ ጅሩት፣ ጄቹንስ ዬሱስት አመነኒፍ ነሞተት ህመ ቱሬ” ጄዼ። <verse eid="ACT 19:4"/><verse number="5" style="v" sid="ACT 19:5"/>እሳንስ ዋን ከነ ዸገአኒ መቃ ጎፍታ ዬሱስት ጩጰመን። <verse eid="ACT 19:5"/><verse number="6" style="v" sid="ACT 19:6"/>ዮሙ ጳዉሎስ ሀርከ እሳንረ ካኤት ሀፉር ቁልቁሉን እሳንረ ቡኤ፤ እሳንስ አፋን ሃራዻን ዱበተን፤ ራጂስ ንዱበተን። <verse eid="ACT 19:6"/><verse number="7" style="v" sid="ACT 19:7"/>እሳንስ ወሉመት ገረ ነመ ኩዸ ለማ ቱረን።<verse eid="ACT 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 19:8"/>ጳዉሎስስ መነ ሰገዳ ሴኔ ዋኤ ሞቱማ ዋቃ እሳን ወጅን ፈልማ፣ አከ እሳን አመነኒፍስ ያላ፣ ጅአ ሰዲ ሶዳ መሌ ዱበቻ ቱሬ። <verse eid="ACT 19:8"/><verse number="9" style="v" sid="ACT 19:9"/>እሳን ኬሳ ቶኮ ቶኮ ገሩ መተ ጀቤዪ ተአን፤ አመኑስ ድደኒ ዋኤ ከራ ሰና ኡመተ ዱረት ዋን ሀማ ዱበተን፤ ከናፍ ጳዉሎስ እሳን ዺሴ ዴሜ፤ በረቶተስ ኦፍት ፉዸቴ መነ በሩምሳ ጥራኖስ ኬሰት ጉዩመ ጉያን እሳን ወጅን መርአቻ ቱሬ። <verse eid="ACT 19:9"/><verse number="10" style="v" sid="ACT 19:10"/>ኩንስ ወጋ ለመ እት ፉፌ፤ ከናፍ ይሁዶትኒፊ ግሪኮትን ብየ አስያ ኬሰ ጅራተን ሁንድኑ ዱቢ ጎፍታ ዸገአን።<verse eid="ACT 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 19:11"/>ዋቅን ሀርከ ጳዉሎሲቲን ሆጂ ድንቂ ከን አከ መሌ ድንቅሲሱ ሆጄቻ ቱሬ። <verse eid="ACT 19:11"/><verse number="12" style="v" sid="ACT 19:12"/>ከናፍ ማረቢን ዮካን መርጦን ዸግነሳ ቱቄዩ ዹኩብሰቶተት ጌፈመ ቱሬ፤ እሳንስ ንፈዩ፤ ሀፉር ሀማንስ እሳን ኬሳ በአ ቱሬ።<verse eid="ACT 19:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 19:13"/>ይሁዶትን ብየ ኬሰ ነናነአኒ ሀፉሮተ ጡራኦ ነመ ኬሳ ባሰን ቶኮ ቶኮስ ነሞተ ሀፉረ ሀማን ቀበመንረት መቃ ጎፍታ ዬሱስ ዋሙ ያለን፤ እሳንስ፣ “አን መቃ ዬሱስ ከን ጳዉሎስ ለለቡ ሰናን ስን አጀጀ” ጄዸን። <verse eid="ACT 19:13"/><verse number="14" style="v" sid="ACT 19:14"/>እልማን አስቄዋ፣ እሰ ሉበ ሀንገፈ ይሁዶታ ቱሬ ሰና ቶርበንስ ዋን ከነ ሆጄተኒሩ። <verse eid="ACT 19:14"/><verse number="15" style="v" sid="ACT 19:15"/>ሀፉር ሀማን ሱን ገሩ፣ “አን ዬሱስን ቤከ፤ ዋኤ ጳዉሎስስ ቤከ፤ እስንሞ ኤኙ?” ጄዼ ዴብሴፍ። <verse eid="ACT 19:15"/><verse number="16" style="v" sid="ACT 19:16"/>ነምች ሀፉረ ሀማን ቀበሜ ሱንስ እሳንት ኡታሌ፤ ሁንደሳኒስ ሞአቴ፤ ንቱሜስ፤ እሳንስ መዳአኒ ቁላሳኒ መነ ኬሳ በአኒ በቀተን።<verse eid="ACT 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 19:17"/>ኩንስ ይሁዶታፊ ግሪኮተ ኤፌሶን ኬሰ ጅራተን ሁንደ ብረት ቤከሜ፤ እሳን ሁንድስ ሶዳን ጉተመን፤ መቃን ጎፍታ ዬሱስስ ባይኤ ከበጀሜ። <verse eid="ACT 19:17"/><verse number="18" style="v" sid="ACT 19:18"/>ወረ አመነን ኬሳስ ባይኤንሳኒ ዹፈኒ ሆጂሳኒ ሀማ ሰነ እፈት ባሰኒ ህመቻ ቱረን። <verse eid="ACT 19:18"/><verse number="19" style="v" sid="ACT 19:19"/>ወረ ፈልፈለ ሆጄቻ ቱረን ኬሳስ ነሞትን ባይኤን ክታቦተሳኒ ወልት ቀበኒ ፉለ ኡመታ ዱረት ጉበን፤ ገቲን ክታቦተ ሰናስ ዮሙ ሸለገሜት ገረ ሜቲ<note caller="+" style="f"><char style="fr" closed="false">19፥19 </char><char style="fq" closed="false">ሜቲ </char><char style="ft" closed="false">– ቤሴን ሜቲ ቶኮ ምንዳ ሆጄታን ቶኮ ጉያት አርገቱዸ።</char></note> ኩመ ሸንተመ ተኤ። <verse eid="ACT 19:19"/><verse number="20" style="v" sid="ACT 19:20"/>ሃለ ከናንስ ዱቢን ጎፍታ አከ መሌ በበልአቴ፤ ሁምናንስ ጉደቴ።<verse eid="ACT 19:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 19:21"/>ኤርገ ወን ኩን ሁንድኑ ተኤ ቦዴ ጳዉሎስ መቄዶንያፊ አካያ ኬሰ ደርቤ ዬሩሳሌም ዸቁ ሙርቴፈቴ፤ እንስ፣ “አን ኤርገን አች ገኤ ቦዴ ሮማስ ዸቁን ቀበ” ጄዼ። <verse eid="ACT 19:21"/><verse number="22" style="v" sid="ACT 19:22"/>እንስ ገርጋርቶተሳ ኬሳ ነመ ለመ ጄቹንስ ጢሞቴዎሲፊ ኤርስጦስን መቄዶንያት ኤርጌ ኦፊሞ ዬሮፍ ብየ አስያ ኬሰ ቱሬ።<verse eid="ACT 19:22"/></para>
  <para style="s1">ጎሊ ኤፌሶን ኬሰት ከኤ</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 19:23"/>ግዱመ ሰነ ዋኤ ከራ ሰናረት ጎሊን ጉዳን ኡመሜ። <verse eid="ACT 19:23"/><verse number="24" style="v" sid="ACT 19:24"/>ቱምቱን ሜቲ ከን ድሜጥሮስ ጄዸሙ ቶኮ ፈኪ መነ ቁልቁሉማ አርጤሚስ<note caller="+" style="f"><char style="fr" closed="false">19፥24 </char><char style="fq" closed="false">አርጤሚስ </char><char style="ft" closed="false">– ዋቅቲ ቶልፈምቱ ዸልቲ፤ መን ቁልቁሉማሼ ድንቂወን ቶርበን አዱኛ ዱሪ ኬሳ ቶኮ ቱሬ።</char></note> ሜቲራ ሆጄቹን ኦጌዪ ሆጂ ሀርካቲፍ ገሊ ጉዳ ገልቻ ቱሬ። <verse eid="ACT 19:24"/><verse number="25" style="v" sid="ACT 19:25"/>እንስ እሳን ሁንዳፊ ነሞተ ሆጂ አከሲ ቀበን ካን ወልት ዋሜ አከነ ጄዼን፤ “ያ ነሞተነነ፣ አከ ኑ ሆጂ ከነራ ገሊ ጉዳ አርገትኑ ንቤክቱ። <verse eid="ACT 19:25"/><verse number="26" style="v" sid="ACT 19:26"/>እስን አከ ነምች ጳዉሎስ ጄዸሙ ኩን ኡቱ ኤፌሶን ቆፈት ህንተእን ጉቱማ ብየ አስያ ገረ ጫሉ ኬሰትስ አከ ዋቆትን ሀርከ ነማቲን ቶልፈመን ዋቆተ ህንተእን ዱበቹዻን ነመ ሄዱ አመንሲሴ ከራራ በሌሴ ንአርግቱ፤ ንዸጌሱስ። <verse eid="ACT 19:26"/><verse number="27" style="v" sid="ACT 19:27"/>ከናፉ አከ መቃን ሆጂኬኛ እን ጋሪን ሱን በዱ ሶዳን ጅረ፤ ገሩ ከነ ቆፈ ኡቱ ህንተእን መን ሰገዳ አርጤሚስ ዋቅቲ ጉዶ ሰናዩ ንሰልጰተ፤ ዋቅቲን ብየ አስያ ጉቱፊ አዱኛ ኬሰት ዋቄፈተምቱ መታንሼዩ ኡልፍነ ዋቁማሼ ንዸብድ።”<verse eid="ACT 19:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 19:28"/>እሳንስ ዮሙ ዋን ከነ ዸገአንት አከ መሌ ኣረኒ፣ “አርጤሚሲን ወረ ኤፌሶን ጉዶዸ!” ጄዸኒ እየን። <verse eid="ACT 19:28"/><verse number="29" style="v" sid="ACT 19:29"/>ዮሙሱመ መጋለቲን ንራፈምቴ፤ ነሞትን ሱንስ ሚልቶወን ጳዉሎስ ከኔን መቄዶንያዻ ዹፈን ጄቹንስ ጋይዮሲፊ አርስጥሮኮስን ቀበኒ አኩመ ነመ ቶኮት ገረ እዶ እት ተጰ አርግሲሰኒ ግርሰኒ ፊገን። <verse eid="ACT 19:29"/><verse number="30" style="v" sid="ACT 19:30"/>ጳዉሎስ ኡመተት ሙልአቹ በርባዴ፤ በረቶትን ገሩ ህንኤየምኔፍ። <verse eid="ACT 19:30"/><verse number="31" style="v" sid="ACT 19:31"/>ቆንዳልቶተ ብየ አስያ ወረ ምቾተ ጳዉሎስ ቱረን ኬሳስ ቶኮ ቶኮ ነመ እሰት ኤርገኒ አከ እን እዶ እት ተጰ አርግሲሰን ሰነ ህንዸቅኔ እሰ ከዸተን።<verse eid="ACT 19:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 19:32"/>ያእችስ ወጫን ጉተሜ፦ ገር ቶኮ ዋን ቶኮ፣ ገር ካን ዋን ብራ እዬ። ገር ጫላንሳኒሞ ዋን አችት ወልት ቀበመኒፍሌ ህንቤክኔ። <verse eid="ACT 19:32"/><verse number="33" style="v" sid="ACT 19:33"/>ይሁዶትንስ እስክንድሮስን ዺበኒ ፉለ ኡመታ ዱረት ባፍናን፣ ነሞትን ቶኮ ቶኮ ኡመተ ኬሳ እየኒ ጎርሰ ኬነኒፍ፤ እንስ ኡመተ ዱረት ፈልመቹፍ ጄዼ አከ ነሞትን ጨልእሰኒፍ ሀርካን መለቶ ኬኔ። <verse eid="ACT 19:33"/><verse number="34" style="v" sid="ACT 19:34"/>ዮሙ አከ እን ይሁዲ ተኤ ሁበተንት ገሩ እሳን ሁንድኑ ሰገሌ ቶኮን፣ “አርጤሚሲን ወረ ኤፌሶን ጉዶዸ!” ጄዸኒ ገረ ሰኣቲ ለማ እያ ቱረን።<verse eid="ACT 19:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 19:35"/>በሬሳን መጋላ ሰናስ ኡመተ ጨልእሲሴ አከነ ጄዼ፤ “ያ ነሞተ ኤፌሶን፣ አከ መጋላን ኤፌሶን ኩን ኤግዱ መነ ሰገዳ አርጤሚስ ጉድቲቲፊ ፈኪሼ ከን ሰሚራ ቡኤ ሰና ታቴ ነምን ህንቤክኔ ጅራ? <verse eid="ACT 19:35"/><verse number="36" style="v" sid="ACT 19:36"/>ከናፍ ዋን ነምን ዹጋ ከነ ፈልሙ ህንጅሬፍ እስን ጨልእሱ ቀብዱ፤ ዋን ቶኮሌ ጀርጀርሱን ሆጄቹ ህንቀብደን። <verse eid="ACT 19:36"/><verse number="37" style="v" sid="ACT 19:37"/>እሳን መነ ሰገዳ ሳሙ ዮካን ዋቅቲኬኘ አረብሱ ባተንሌ እስን ጀረ ከነ አስ ፍደኒርቱ። <verse eid="ACT 19:37"/><verse number="38" style="v" sid="ACT 19:38"/>ከናፍ ድሜጥሮሲፊ ኦጌዪን እሰ ወጅን ጅረን ሱን ዮ ዋን እቲን ነመ ቶኮዩ ህመተን ቀባተን መኔን ሙርቲ በናዸ፤ ቡልችቶትን ብያስ ጅሩ። እሳን ህመተ ቀበን አችት ሃዽኤፈተን። <verse eid="ACT 19:38"/><verse number="39" style="v" sid="ACT 19:39"/>ዮ ወን ብራ ከን እስን ዽኤፈቹ በርባደን ቶኮዩ ጅራቴ ገሩ ወን ሱን ያኢ ሴረ ቀቤሰረት እላለመ። <verse eid="ACT 19:39"/><verse number="40" style="v" sid="ACT 19:40"/>ኑ ወል ገኢ ከናፍ ሰበቢ ዽኤፈቹ ደንዴኙ ዋን ህንቀብኔፍ ጎሊ ሀርአ ተኤ ከነት አከ ጋፈተምኑ ሶዳ ቀብነ።” <verse eid="ACT 19:40"/><verse number="41" style="v" sid="ACT 19:41"/>እንስ ኤርገ ዋን ከነ ዱበቴ ቦዴ ወልዳ ሰነ ገድ ለክሴ።<verse eid="ACT 19:41"/></para>
  <chapter eid="ACT 19"/>
  <chapter number="20" style="c" sid="ACT 20"/>
  <para style="s1">ጳዉሎስ መቄዶንያፊ ግሪክ ዸቄ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1"/>ጳዉሎስ ኤርገ ጎሊን ቀበናኤ ቦዴ በረቶተ ዋምስሴ እሳን ጀጀቤሴ፤ “ነጋት” እሳኒን ጄዼስ መቄዶንያ ዸቁፍ ከኤ። <verse eid="ACT 20:1"/><verse number="2" style="v" sid="ACT 20:2"/>እንስ ዱቢ ነመ ጀጀቤሱ ባይኤ ኡመተት ዱበቻ ናኖ ሰነ ኬሰ ደርቤ ዹመረት ግሪክ ገኤ፤ <verse eid="ACT 20:2"/><verse number="3" style="v" sid="ACT 20:3"/>አችስ ጅአ ሰዲ ቱሬ። አኩመ እን ዶኒን ሶርያ ዸቁፍ ከኤንስ ሰበቢ ይሁዶትን እሰት መለተኒፍ ከራ መቄዶንያቲን ዴብኡፍ ኩተቴ። <verse eid="ACT 20:3"/><verse number="4" style="v" sid="ACT 20:4"/>ቤርያዻ ሱሲጳጥሮስ እልመ ጳይሮስ፣ ተሰሎኒቄዻ አርስጥሮኮሲፊ ስኮንዱስ፣ ደርቤኒሞ ጋዮስ እሰ ወጅን ዴመን፤ አከሱመስ ጢሞቴዎስ፣ ብየ አስያቲሞ ቲኪቆሲፊ ጥሮፊሞስ እሰ ወጅን ዴመን። <verse eid="ACT 20:4"/><verse number="5" style="v" sid="ACT 20:5"/>ነሞትን ኩኔን ኑ ዱረ ደርበኒ ጢሮአዳት ኑ ኤገን። <verse eid="ACT 20:5"/><verse number="6" style="v" sid="ACT 20:6"/>አያነ መጥኖ ቦዴ ገሩ ፊልጵስዩሲ ዶኒን ካኔ ቡልቲ ሸን ቦዴ ወረ ካን ወጅን ጢሮአዳት ወል አርገትኔ፤ አችስ ጉያ ቶርበ ቱሬ።<verse eid="ACT 20:6"/></para>
  <para style="s1">አዉጤኪስ ዱኣ ካፈሜ</para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7"/>ኑስ ጉያ ጀልቀበ ቶርበን ሰናት ቡዴነ ጨጨብሱፍ ጄኔ ወልት ቀበምኔ፤ ጳዉሎስ ነሞተት ሃሰኤ። እንስ ዋን ጉያ እት ኣኑት ዴሙ በርባዴፍ ሀመ ሀልከን ወለካት ሃሳ ዼሬሴ። <verse eid="ACT 20:7"/><verse number="8" style="v" sid="ACT 20:8"/>ጉለንታ ደርቢ እዶ ኑ እት ወልት ቀበምኔ ኬሰ እብሳ ባይኤቱ ቱሬ። <verse eid="ACT 20:8"/><verse number="9" style="v" sid="ACT 20:9"/>ደርገጌስ አዉጤኪስ ጄዸሙ ቶኮስ ፎዳረ ታኣ ቱሬ፤ ዮሙ ጳዉሎስ ሃሳ ዼሬሴትስ ህርብን ጭማን እሰ ፉዸቴ፤ ኡቱ ህርባን ኦፍ ወላሌ ጅሩስ ደርቢ ሰደፋራ ኩፌ፤ እሳንስ ሬፈሳ ለፋ ፉዸን። <verse eid="ACT 20:9"/><verse number="10" style="v" sid="ACT 20:10"/>ጳዉሎስስ ገድ ቡኤ ደርገጌሰ ሰነረት ጎምብፈሜ እሰ ሀመቹዻን፣ “ሉቡን ኬሰ ጅርቲቲ ህንርፈትና!” ጄዼ። <verse eid="ACT 20:10"/><verse number="11" style="v" sid="ACT 20:11"/>እንስ ደርቢ ሰነት ኦል ዴብኤ ቡዴነ ጨጨብሴ ኛቴ፤ ሀመ ለፍት በሪቱትስ ዬሮ ዼራ እሳን ወጅን ሃሰኤ አቺ ዴሜ። <verse eid="ACT 20:11"/><verse number="12" style="v" sid="ACT 20:12"/>ነሞትንስ ደርገጌሰ ሰነ ጅራታ ተኤ መነት ጌሰን፤ ባይኤስ ንጀጀባተን።<verse eid="ACT 20:12"/></para>
  <para style="s1">ጳዉሎስ ጃርሶሊ ወልዳ ክርስታነ ኤፌሶን ጎርሴ</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13"/>ኑስ ጳዉሎስን አቺ ፉዹፍ ጄኔ ዱራን ዱርስኔ ገረ ዶኒ ዸቅኔ ዶኒዻን አሶንት ቀጄሌ፤ ጳዉሎስ ሚላን ዴሙፍ ጄዼ ኦፉመሳቲ ዋን ከነ ከሮርፈቴ ቱሬቲ። <verse eid="ACT 20:13"/><verse number="14" style="v" sid="ACT 20:14"/>አሶንትስ እሳን ወል አርግኔ ዶኒዻን ሚጢሊንት ደበሬ። <verse eid="ACT 20:14"/><verse number="15" style="v" sid="ACT 20:15"/>ጉያ እት ኣኑትስ ዶኒን አቺ ካኔ ፉሌ ኪዩ ጌኜ፤ ጉያ ቶኮ ቦዴስ ሳሞንት ባኔ፤ ጉያ እት ኣኑሞ ሚሊጢን ጌኜ። <verse eid="ACT 20:15"/><verse number="16" style="v" sid="ACT 20:16"/>ጳዉሎስስ ዮ ደንደአሜፍ ዋን ጉያ ጴንጤቆስጤቲን ዬሩሳሌም ገኡፍ አሪፈቴፍ አከ ብየ አስያ ኬሰት ዬሮን እሰ ዱራ ህንዹምኔፍ ጄዼ ዶኒዻን ኤፌሶን ብረ ደርቤ ዴሙ ሙርቴፈቴ ቱሬ።<verse eid="ACT 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 20:17"/>እንስ ሚሊጢኒ ኤፌሶንት ነመ ኤርጌ ጃርሶሊ ወልዳ ክርስታና ኦፍት ዋምስሴ። <verse eid="ACT 20:17"/><verse number="18" style="v" sid="ACT 20:18"/>እሳን ገረሳ ዹፍናን አከነ ጄዼን፤ “አን ጋፈን ብየ አስያ ዹፌ ከን ዱራቲ ጀልቀቤ ዬሮን እስን ወጅን ጅራቻ ቱሬ ሰነ ሁንደ ሃለ አከሚ ኬሰ አከ አን ጅራቻ ቱሬ እስን መታንኬሰንዩ ቤክቱ። <verse eid="ACT 20:18"/><verse number="19" style="v" sid="ACT 20:19"/>አን ዮ መለ ይሁዶታቲን አከ መሌ ቆረሜሌ ገድ ኦፍ ቀቢሰ ጉዳፊ እምማኒን ጎፍታ ተጃጅሌረ። <verse eid="ACT 20:19"/><verse number="20" style="v" sid="ACT 20:20"/>ኡቱ ዋን ፋይዳ እስኒ ቀቡ ቶኮሌ ለለቡራ ኦፍ ህንቁሰትን አከ አን መነ ቶኮ ገረ መነ ካኒ ዴሜ እፈት ባሴ እስን በርሲሴ እስኑ ቤክቱ። <verse eid="ACT 20:20"/><verse number="21" style="v" sid="ACT 20:21"/>አን አከ ይሁዶትኒፊ ግሪኮትን ቀልቢ ጅጂረቹዻን ገረ ዋቃት ዴብአኒፊ አከ እሳን ጎፍታኬኘ ዬሱስ ክርስቶስት አመነን እሳንት ህሜረ።<verse eid="ACT 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 20:22"/>“አመስ አን ኡቱ ዋን አችት ነረ ገኡፍ ጅሩ ህንቤክን ሀፉራን ድርቀሜ ዬሩሳሌም ዸቁን ጅረ። <verse eid="ACT 20:22"/><verse number="23" style="v" sid="ACT 20:23"/>ሀፉር ቁልቁሉንሞ አከ ህዸሙፊ ረከቹን ነ ኤገቱ መጋላ ሁንደ ኬሰት ዹጋ ናፍ በአ። <verse eid="ACT 20:23"/><verse number="24" style="v" sid="ACT 20:24"/>ተኡስ አን ፊግቸ ሰነ ጡሙሩፊ ሆጂ ጎፍታ ዬሱስ ነት ኬኔ ሰነ ሆባፈቹፍ ጄዼ ጅሬኘኮ አከ ዋን ፋይዳ ህንቀብኔት ነንለካአ፤ ሆጂን ኩንስ ወንጌለ አያነ ዋቃቲፍ ዹጋ በኡዸ።<verse eid="ACT 20:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 20:25"/>“አን አከ እስን ወረ አን ኬሰ ነናነኤ ሞቱማ ዋቃ ለለቤ ከኔን ኬሳ ነምን ቶኮዩ ለመተ ነ ህንአርግኔ ነንቤከ። <verse eid="ACT 20:25"/><verse number="26" style="v" sid="ACT 20:26"/>ከናፉ አን ዺገ ነመ ሁንዳራ ቁልቁሉ ተኡኮ ሀርአ እስንት ነንህመ። <verse eid="ACT 20:26"/><verse number="27" style="v" sid="ACT 20:27"/>አን ፌዺ ዋቃ ሁንደ እስንት ህሙራ ኦፍ ህንቁሰትኔቲ። <verse eid="ACT 20:27"/><verse number="28" style="v" sid="ACT 20:28"/>እስን ኦፍ ኤጋ፤ ከረ ሆሎተ ሀፉር ቁልቁሉን እረት ጳጳሶተ እስን ጎዼ ሰና ሁንደስ ኤጋ። ወልዳ ክርስታና ዋቃ ከን እን ዺገ ኦፊሳቲን ብተቴ ሰናፍስ ትክሶተ ተኣ። <verse eid="ACT 20:28"/><verse number="29" style="v" sid="ACT 20:29"/>ኤርገ አን ዴሜ ቦዴ አከ ዬዪወን ሀሞን ዹፈኒ ግዱኬሰን ሴነን፣ አከ እሳን ከረ ሆሎታ ሰነ ኬሳ ቶኮሌ ህንሀምብፍኔስ አን ቤከ። <verse eid="ACT 20:29"/><verse number="30" style="v" sid="ACT 20:30"/>እስኑመ ኬሳዩ ነሞትን በረቶተ ኦፍ ፋነ ፉዸቹፍ ጄዸኒ ዱቢ ምጪረማ ዱበተን ንከኡ። <verse eid="ACT 20:30"/><verse number="31" style="v" sid="ACT 20:31"/>ከናፉ እስን ኦፍ ኤገዻ! አከ አን ወጋ ሰዲ ሀልከኒ ጉያ ኡቱ ገርገር ህንኩትን እምማኒን ቶኮ ቶኮኬሰን ጎርሳ ቱሬ ያደዻ።<verse eid="ACT 20:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 20:32"/>“አን አመ ዋቀት፣ አከሱመስ ዱቢ አያነሳ ከን እስን እጃሩ ደንደኡፊ ከን ወረ ቁልቁላአን ሁንደ ኬሰት ዻለ እስኒ ኬኑ ደንደኡ ሰነት እስንትን ኬነዸ። <verse eid="ACT 20:32"/><verse number="33" style="v" sid="ACT 20:33"/>አን ሜቲ ዮካን ወርቄ ዮካን ኡፈተ ነመ ቶኮዩ ህንከጄሌ። <verse eid="ACT 20:33"/><verse number="34" style="v" sid="ACT 20:34"/>አከ አን ሀርኩመኮ ከናን ሆጄዼ ዋን ናፊ ወረ ነ ወጅን ጅረኒፍ በርባችሱ አርገምሲሴ እስን መታንኬሰንዩ ንቤክቱ። <verse eid="ACT 20:34"/><verse number="35" style="v" sid="ACT 20:35"/>አን ዋን ሆጄዼ ሁንደ ኬሰት ኑ ዱቢ ጎፍታ ዬሱስ መታንሳ፣ <char style="wj">‘ፉዸቹረ ኬኑቱ ኤበ ቀበ’</char> ጄዼ ዱበቴ ሰነ ያደቻ ሆጂ ጀባ አከናቲን አከ ወረ ደዸባ ገርጋሩ ቀብኑ እስን አርግሲሴረ።”<verse eid="ACT 20:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 20:36"/>እንስ ዋን ከነ ዱበቴ እሳን ሁንደ ወጅን ጅልቤንፈቴ ዋቀ ከዸቴ። <verse eid="ACT 20:36"/><verse number="37" style="v" sid="ACT 20:37"/>ሁንድሳኒስ አከ መሌ ቦኣ ሞርመ ጳዉሎስት መርመኒ እሰ ዹንገተን። <verse eid="ACT 20:37"/><verse number="38" style="v" sid="ACT 20:38"/>ወን አከ መሌ እሳን ገድሲሴ አከ እሳን ዬሮ ሰና ጀልቀበኒ ለመተ እሰ ህንአርግኔ ዱበቹሳት። ኤርገሲ እሳን ሀመ ዶኒት እሰ ጌጌሰን።<verse eid="ACT 20:38"/></para>
  <chapter eid="ACT 20"/>
  <chapter number="21" style="c" sid="ACT 21"/>
  <para style="s1">ጳዉሎስ ዬሩሳሌም ዸቄ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1"/>ኤርገ እሳኒን ገርገር ባኔ ቦዴስ ዶኒዻን ካኔ ኡቱ ምርጋ ብታት ህንጎርን ቆስት ቀጄሌ። ጉያ እት ኣኑት ሮዴ ዸቅኔ አቺሞ ጳጥራት ደበሬ። <verse eid="ACT 21:1"/><verse number="2" style="v" sid="ACT 21:2"/>ዶኒ ፍኒቄት ጬኡ ቶኮስ አርገትኔ እሰ ያበትኔ አዴምሰ እት ፉፍኔ። <verse eid="ACT 21:2"/><verse number="3" style="v" sid="ACT 21:3"/>ዮሙ ቆጵሮስን አርጉ ደንዴኜት፣ ሀርከ ብታት እሼ ዺፍኔ ሶርያት ቀጄሌ፤ ኑስ እዶ ዶኒንኬኘ ፌእሰሳ እት ቡፈቹፍ ቱሬ ጢሮስት እራ ቡኔ። <verse eid="ACT 21:3"/><verse number="4" style="v" sid="ACT 21:4"/>አችት በረቶተ አርገትኔ ጉያ ቶርበ እሳን ብረ ቱሬ። እሳንስ አከ ጳዉሎስ ዬሩሳሌም ህንዸቅኔፍ ሀፉረ ቁልቁሉን እሰ አኬከቺሰን። <verse eid="ACT 21:4"/><verse number="5" style="v" sid="ACT 21:5"/>ገሩ ዬሮንኬኘ ዹምናን አቺ ካኔ ዴምሰኬኘ እት ፉፍኔ፤ በረቶትን ሁንድኑ ኒቶተሳኒቲፊ እጆሌሳኒ ወጅን መጋለቲ ኬሳ ኑ ባሰኒ ኑ ጌጌሰን፤ ኑስ ቀርቀረ ገላናት ጅልቤንፈትኔ ከዸትኔ። <verse eid="ACT 21:5"/><verse number="6" style="v" sid="ACT 21:6"/>ኤርገ ነጋት ወሊን ጄኔ ቦዴስ ዶኒ ያበትኔ፤ እሳንሞ መነሳኒት ዴብአን።<verse eid="ACT 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 21:7"/>ጢሮሲ ካኔ አዴምሰኬኘ እት ፉፉዻን ጵቶሌማይስት ገሌ፤ አችትስ ኦቦሎተ ዱብፍኔ ጉያ ቶኮ እሳን ብረ ኦሌ። <verse eid="ACT 21:7"/><verse number="8" style="v" sid="ACT 21:8"/>ጉያ እት ኣኑት አቺ ካኔ ቂሳርያ ጌኜ፤ አችትስ መነ ለለባ ወንጌላ ቶኮ መነ ፊልጶስ እሰ ወረ ቶርባን ኬሳ ቶኮ ቱሬ ሰና ዸቅኔ እሰ ብረ ቱሬ። <verse eid="ACT 21:8"/><verse number="9" style="v" sid="ACT 21:9"/>እንስ እጆሌ ዱርባ ከኔን ህንሄሩምን አፉር ቀበ ቱሬ፤ እሳንስ ራጂ ዱበቱ ቱረን።<verse eid="ACT 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 21:10"/>ኤርገ ኑ ጉያ ሄዱ አች ቱሬ ቦዴ ራጂን አጋቦስ ጄዸሙ ቶኮ ይሁዳዻ ገድ ቡኤ። <verse eid="ACT 21:10"/><verse number="11" style="v" sid="ACT 21:11"/>እንስ ገረኬኘ ዹፌ ሰበተ ጳዉሎስ ፉዼ ሀርካፊ ሚለ ኦፊሳ ህዼ፣ “ሀፉር ቁልቁሉን፣ ‘ይሁዶን ዬሩሳሌም ጅራተን አባ ሰበተ ከና አከነት ህዸኒ ደበርሰኒ ነሞተ ኦርማት እሰ ኬኑ’ ጄዸ” ጄዼ።<verse eid="ACT 21:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 21:12"/>ኑስ ዮሙ ዋን ከነ ዸጌኜት አከ ጳዉሎስ ዬሩሳሌምት ኦል ህንባኔፍ ነሞተ አች ጅረን ወጅን እሰ ከዸትኔ። <verse eid="ACT 21:12"/><verse number="13" style="v" sid="ACT 21:13"/>ጳዉሎስሞ ዴብሴ፣ “እስን ማሊፍ ቦሰኒ ገራ ነ ራፍቱ? አን መቃ ጎፍታ ዬሱሲፍ ጄዼ ዬሩሳሌምት ህዸሙ ቆፈ ኡቱ ህንተእን ዱኡፍሌ ቆጳኤራቲ” ጄዼ። <verse eid="ACT 21:13"/><verse number="14" style="v" sid="ACT 21:14"/>ዮሙ እን ኑ ሰርሙ ድዴትስ፣ “ፌዺን ጎፍታ ሃተኡ” ጄኔ ዺፍኔ።<verse eid="ACT 21:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 21:15"/>ጉዮተ ከኔን ቦዴስ ቆጶፍኔ ዬሩሳሌምት ኦል ባኔ። <verse eid="ACT 21:15"/><verse number="16" style="v" sid="ACT 21:16"/>በረቶትን ቂሳርያ ኬሳ ቶኮ ቶኮ ኑ ሚልቴሰኒ ገረ መነ ምናሶን ኑ ጌሰን፤ እንስ ነመ ቆጵሮስ ከን በረቶተ ዱሪ ኬሳ ቶኮ ቱሬዸ።<verse eid="ACT 21:16"/></para>
  <para style="s1">ጳዉሎስ ዬሩሳሌም ገኤ</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 21:17"/>ዮሙ ኑ ዬሩሳሌም ጌኜት ኦቦሎትን ገመቹዻን ኑ ስመተን። <verse eid="ACT 21:17"/><verse number="18" style="v" sid="ACT 21:18"/>ጉያ እት ኣኑትስ ጳዉሎስ ኑ ወጅን ያቆብ ብረ ዸቄ፤ ጃርሶሊን ሁንድኑስ አች ቱረን። <verse eid="ACT 21:18"/><verse number="19" style="v" sid="ACT 21:19"/>ጳዉሎስስ ነጋ እሳን ጋፈቴ ዋን ዋቅን ተጃጅለ እን ኬኔን ነሞተ ኦርማ ኬሰት ሆጄቴ ሁንደ ቶኮ ቶኮን እሳኒ እብሴ።<verse eid="ACT 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 21:20"/>እሳን ዮሙ ዋን ከነ ዸገአንት ዋቀ ገለቴፈተን። ጳዉሎሲንስ አከነ ጄዸን፤ “ያ ኦቦሌሰ፣ አት አከ ይሁዶትን ኩመ ሄዱን አመነን ንአርግተ፤ ሁንድሳኒስ ህናፋ ሴራፍ ቀቡ። <verse eid="ACT 21:20"/><verse number="21" style="v" sid="ACT 21:21"/>አት አከ ይሁዶትን ነሞተ ኦርማ ኬሰ ጅራተን ሁንድኑ እልማንሳኒ ዸግነ ህንቀብኔፊ አከ እሳን አከ ዱዻኬኛት ህንጅራትኔ እት ህምቴ አከ እሳን ሴረ ሙሴራ ገረገለን በርሲሱንኬ እሳንት ህመሜረ። <verse eid="ACT 21:21"/><verse number="22" style="v" sid="ACT 21:22"/>እሳን አከ አት ዹፍቴ ዹጉማን ንዸገኡቲ፤ ኤጋ ማል ጎቹ ወየ? <verse eid="ACT 21:22"/><verse number="23" style="v" sid="ACT 21:23"/>ከናፍ አት ዋን ኑ ስት ህምኑ ጎዽ፤ ነሞትን ወሬገ ኦፍራ ቀበን አፉር ኑ ብረ ጅሩ። <verse eid="ACT 21:23"/><verse number="24" style="v" sid="ACT 21:24"/>አከ እሳን መታሳኒ ሃደተኒፍ ነሞተ ከኔን ኦፍት ፉዺቲ እሳን ወጅን ኦፍ ቁልቁሌሲቲ ባሲሳኒ አት ባስ። ከናንስ ነሞትን ሁንድኑ አከ ኦዱን ዋኤኬ ኦዴፈሜ ሱን ዹጋ ህንተእን፣ አከ አት መታንኬዩ ሴራፍ አጀጀምቴ ጅራቱ ንቤኩ። <verse eid="ACT 21:24"/><verse number="25" style="v" sid="ACT 21:25"/>ዋኤ ነሞተ ኦርማ ከኔን አመነኒሞ አከ እሳን ኛተ ዋቆተ ቶልፈሞፍ ኣርሳ ዽኤፈሜ፣ ዺገ፣ ፎን ሆሪ ሁዸሜ ዱኤቲፊ ሰጋገሉማ ለገተኒፍ ኑ ሙርቲኬኘ እሳኒፍ በሬስኔረ።”<verse eid="ACT 21:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 21:26"/>ጳዉሎስስ ጉያ እት ኣኑት ነሞተ ሰነ ኦፍት ፉዼ እሳን ወጅን ኦፍ ቁልቁሌሴ፤ ኤርገሲሞ ጋፈ ጉዮትን ቁልቁላኡማ<note caller="+" style="f"><char style="fr" closed="false">21፥26 </char><char style="fq" closed="false">ጉዮትን ቁልቁላኡማ </char><char style="ft" closed="false">– ዬሮ ጉያ ቶርበኒ ከን እት ነሞትን አፍረን ስርነ ናዝሩማ ጉተተን ሱን ኡቱ አከ ኣዳት ኣርሳ ዽኤሱፍ ጅላን ህንቁልቁሌፈምን ዱረ ኬሰ ደርቡ መለን አርግሲሰ።</char></note> ሱን እት ጡሙረመኒፊ ዬሮ እት ኣርሳን መቃ ቶኮ ቶኮሳኒቲን ዽኤፈሙ መሉ ቤክስሱፍ መነ ቁልቁሉማ ሴኔ።<verse eid="ACT 21:26"/></para>
  <para style="s1">ጳዉሎስ ቀበሜ</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27"/>ዮሙ ጉዮትን ቶርበን ሱን ጡሙረሙ ገአንት ይሁዶትን ብየ አስያቲ ዹፈን ቶኮ ቶኮ ጳዉሎስን መነ ቁልቁሉማ ኬሰት አርገን። እሳንስ ነመ ሁንዱማ ከካሰኒ እሰ ቀበን። <verse eid="ACT 21:27"/><verse number="28" style="v" sid="ACT 21:28"/>እየኒስ፣ “ያ ነሞተ እስራኤል ኑ ገርጋራ! ነምች ኩን ነመ ሰበኬኛን ሞርማ፣ ሴረኬኛፊ መነ ቁልቁሉማ ሞርማ ነመ ሁንደ እዶ ሁንደት በርሲሱዸ። ከነ መሌስ እን ግሪኮተ መነ ቁልቁሉማት ኦል ገልቼ እዶ ቁልቁሉ ከነ ጡሬሴረ” ጄዸን። <verse eid="ACT 21:28"/><verse number="29" style="v" sid="ACT 21:29"/>እሳን ዋን ዱራን ነምቸ ኤፌሶን ከን መቃንሳ ጥሮፊሞስ ጄዸሙ ቶኮ ጳዉሎስ ብረት መጋላ ኬሰት አርገኒ ቱረኒፍ፣ ዋን ጳዉሎስ መነ ቁልቁሉማት ኦል እሰ ገልቼ ሴአኒቲ።<verse eid="ACT 21:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 21:30"/>መጋላን ሱንስ ጉቱማት ንራፈምቴ፤ ነሞትንስ ከራ ሁንዱማን ፊጋ ዹፈን። እሳንስ ጳዉሎስን ቀበኒ ለፈረ ሀርክሳ መነ ቁልቁሉማቲ ገድ ባሰን፤ ዮሙሱመ ከሮትን ጩፈመን። <verse eid="ACT 21:30"/><verse number="31" style="v" sid="ACT 21:31"/>ኡቱ እሳን እሰ አጄሱ ያለኑ አከ መጋላን ዬሩሳሌም ጉቱማት ራፈማ ጅርቱ ኦዱን አጀጃ ወራነ ሮማ ገኤ። <verse eid="ACT 21:31"/><verse number="32" style="v" sid="ACT 21:32"/>እንስ ዬሩመ ሰነ ሎልቶታፊ አጀጁወን ዽባ ቶኮ ቶኮ ፉዸቴ ፊግቻን እሳንት ገድ ቡኤ። እሳንስ ዮሙ አጀጃ ሰናፊ ሎልቶተሳ አርገንት ጳዉሎስን ቱሙ ዺሰን።<verse eid="ACT 21:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 21:33"/>አጀጃን ሱንስ ዹፌ እሰ ቀቤ፤ አከ እን ፎንጫ ለማን ህዸሙስ አጀጄ፤ አከ እን ኤኙ ተኤፊ አከ እን ማል ሆጄቻ ቱሬስ እሰ ጋፈቴ። <verse eid="ACT 21:33"/><verse number="34" style="v" sid="ACT 21:34"/>ቱተ ሰነ ኬሳስ ገር ቶኮ ዋን ቶኮ ጄዸኒ እያ፣ ገር ካንሞ ዋን ብራ ጄዸኒ እያ ቱረን፤ አጀጃን ሱንስ ሰበቢ ወጨ ነማቲፍ ዋን ምርከነ ተኤ አርገቹ ዋን ደዸቤፍ አከ ጳዉሎስ ገረ ቁበተ ሎልቶታት ጌፈሙ አጀጄ። <verse eid="ACT 21:34"/><verse number="35" style="v" sid="ACT 21:35"/>ጳዉሎስ ጉለንታ እቲን ገድ በአን ብረ ጌኛን ሰበቢ ጎሊ ነሞታቲፍ ሎልቶትን እሰ ባተን። <verse eid="ACT 21:35"/><verse number="36" style="v" sid="ACT 21:36"/>ነሞትን ሄዱንስ፣ “እሰ አጄስ!” ጄዸኒ እያ ዱካ ቡአን።<verse eid="ACT 21:36"/></para>
  <para style="s1">ዱቢ ጳዉሎስ ኡመተት ዱበቴ</para>
  <para style="r">
    <ref loc="ACT 22:3-16">22፥3‑16</ref> ኩወፈ – <char style="xt"><ref loc="ACT 9:1-22">ሆጂ 9፥1‑22</ref>፤ <ref loc="ACT 26:9-18">26፥9‑18</ref></char></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 21:37"/>ጳዉሎስ ዮሙ ሎልቶትን እሰ ፉዸኒ ቁበተ ሎልቶታት ኦል እሰ ገልቹፍ ጄዸንት፣ አጀጃ ሰናን፣ “አከ አን ዋ ስት ህሙ ናፍ ኤየምታ?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="ACT 21:37">አጀጃን ሱንሞ ዴብሴ አከነ ጄዼ፤ “አት አፋን ግሪክ ንዱበታ? <verse eid="ACT 21:37"/><verse number="38" style="v" sid="ACT 21:38"/>አት ነምቸ ብየ ግብጥ ከን ዽኤኘ ከነ ጎሊ ካሴ ሾሮርኬስቶተ<note caller="+" style="f"><char style="fr" closed="false">21፥38 </char><char style="fq" closed="false">ሾሮርኬስቶተ </char><char style="ft" closed="false">– ነሞትን ኩኔን ፍንጭልቶተ ጭጭሞ አከ ዲኖተ ወረ ሮማቲፊ አከ ዲኖተ ይሁዶተ ወረ ሮማ ዴገረኒት ኦፍ እላለን ሁንዳት ኦፍ ለካአኒዸ። እሳንስ ዬሮ አያነ ገረ ገራት ሰበ ካንት መከመኒ ዲኖተሳኒ አጄሳ ቱረን።</char></note> 4,000 ፉዸቴ ገሞጂት ገሌ ሰነ ምቲ?”<verse eid="ACT 21:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 21:39"/>ጳዉሎስስ፣ “አን ይሁዲ ጠርሴስ መጋላ ቤከምቱ ኪልቅያ ኬሳ ሰናት። ማሎ፣ አከ አን ነሞተ ከነት ዱበዹ ናፍ ኤየም” ጄዼ ዴብሴ።<verse eid="ACT 21:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 21:40"/>ጳዉሎስ አኩመ ኤየመ አጀጃ ሰና አርገቴን ጉለንታ ሰነረ ዻበቴ አከ ነሞትን ጨልእሰኒፍ ሀርካን መለቶ ኬኔ፤ ዮሙ እሳን ሁንድኑ ጨልእሰንትሞ አፋን አራማይኪቲን አከነ ጄዼን።<verse eid="ACT 21:40"/></para>
  <chapter eid="ACT 21"/>
  <chapter number="22" style="c" sid="ACT 22"/>
  <para style="nb">
    <verse number="1" style="v" sid="ACT 22:1"/>“ያ ኦቦሎታፊ አቦቲ፣ ፈልመተ አን አመ እስን ዱረት ዽኤፈዹ ከነ ሜ ናፍ ዸገኣ።”<verse eid="ACT 22:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 22:2"/>ጀርስ ዮሙ እሳ አፋን እብራይስጢቲን እሳንት ዱበቱ ዸገአንት ከን ዱራሌ ጫላ ጨልእሰን።</para>
  <para style="p" vid="ACT 22:2">ጳዉሎስስ አከነ ጄዼ፤ <verse eid="ACT 22:2"/><verse number="3" style="v" sid="ACT 22:3"/>“አን ይሁዲዸ፤ መጋላ ጠርሴስ እሼ ብየ ኪልቅያ ኬሳ ሰነትን ዸለዼ፤ ገሩ ዬሩሳሌምን ጉደዼ። ሚለ ገማልያል ጀለትስ ሴረ አቦቲኬኛ አከ ጋሪት በረዼ፣ አኩመ እስን ሁንድ ሀርአ ህናፍተን ከነ አንስ ዋቃፍ ነንህናፈ ቱሬ። <verse eid="ACT 22:3"/><verse number="4" style="v" sid="ACT 22:4"/>ዺራፊ ዱበርቲ ቀቤ፣ መነ ህዻ ኬሰ እሳን ቡሱዻን ዱካ ቡቶተ ከራ ከና ሀመ ዱኣት አርአዼረ፤ <verse eid="ACT 22:4"/><verse number="5" style="v" sid="ACT 22:5"/>ዋን ከነስ ሉብን ኦል ኣናኒፊ ወልዳን ጃርሶሊ ጉቱን ረጋ ናፍ በኡ። አንስ ጠለዮተ እሳን ገረ ኦቦሎተ ወረ ደማስቆ ጅረኒት በሬሰን ፉዸዼ አከ ነሞትን ኩኔን አደበመኒፍ ህዼ ዬሩሳሌምት እሳ ፍዱፍ አች ነንዸቄ።<verse eid="ACT 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 22:6"/>“ገረ ሳፋት፣ አኩመ አን ደማስቆት ዽኣዼን እፍን ጉዳንሳ አኩመ ተሳ ሰሚራ ናኖኮት በለቅሴ። <verse eid="ACT 22:6"/><verse number="7" style="v" sid="ACT 22:7"/>አንስ ለፈት ኩፌን ሰገሌ፣ <char style="wj">‘ያ ሳዉል! ያ ሳዉል! አት ማሊፍ ነ አርአተ?’</char> ናን ጄዹ ቶኮን ዸገኤ።<verse eid="ACT 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 22:8"/>“አንስ፣ ‘ያ ጎፍታ አት ኤኙ?’ ጄዼን ጋፈዼ።</para>
  <para style="p" vid="ACT 22:8">“እንሞ ዴብሴ፣ <char style="wj">‘አን ዬሱስ ነመ ናዝሬት እሰ አት አርአቱዸ’</char> ናን ጄዼ። <verse eid="ACT 22:8"/><verse number="9" style="v" sid="ACT 22:9"/>ወር ነ ወጅን ቱረንስ እፈ ሰነ አርገን መሌ ሰገሌ እሰ ነት ዱበቻ ቱሬ ሰና ህንሁበትኔ።<verse eid="ACT 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 22:10"/>“አንስ፣ ‘ያ ጎፍታ፣ አን ማል ጎዹሬ?’ ጄዼ ጋፈዼ።</para>
  <para style="p" vid="ACT 22:10">“ጎፍታንስ፣ <char style="wj">‘ከኢ ደማስቆ ሴን። ወን አከ አት ሆጄቱፍ ሲፍ ካአሜ ሁንድኑ አችት ስት ህመማቲ’</char> ናን ጄዼ። <verse eid="ACT 22:10"/><verse number="11" style="v" sid="ACT 22:11"/>አንስ ሰበቢ ጨለቅሰ እፈ ሰናቲፍ ሆማ አርጉ ደዸብናን፣ ወር ነ ወጅን ቱረን ሀርከ ቀበኒ ደማስቆት ነ ጌሰን።<verse eid="ACT 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 22:12"/>“ነምች አናንያ ጄዸሙ ከን ስሪት ሴረ ኤጉ ቶኮ ይሁዶተ አች ጅራተን ሁንደ ብረት መቃ ጋሪ ቀበ ቱሬ። <verse eid="ACT 22:12"/><verse number="13" style="v" sid="ACT 22:13"/>እንስ ገረኮ ዹፌ ነ ብረ ዻበቴ፣ ‘ያ ኦቦሌሰኮ ሳዉል፣ አገርቱንኬ ሲፍ ሃዴብኡ!’ ናን ጄዼ፤ አገርቱንኮስ ዬሩመ ሰነ ናፍ ዴብኤ። አንስ እሰ አርጉ ደንደኤ።<verse eid="ACT 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 22:14"/>“እንስ አከነ ጄዼ፤ ‘ዋቅን አቦቲኬኛ አከ አት ፌዺሳ ቤክቱ፣ አከ አት እሰ ቀጄላ ሰነ አርግቱፊ አከ አፋንሳራ ዱቢ ዸጌሱፍ ስ ፍለቴረ። <verse eid="ACT 22:14"/><verse number="15" style="v" sid="ACT 22:15"/>አትስ ዋን አርግቴፊ ዋን ዸጌሴ ሰነ ፉለ ነመ ሁንዱማ ዱረት እሳፍ ዹጋ ንባተ። <verse eid="ACT 22:15"/><verse number="16" style="v" sid="ACT 22:16"/>ኤጋ አመ ማል ኤግደሬ? ከኢ መቃሳ ዋመቻ ጩጰሚቲ ጩቡኬ ኦፍራ ዽቅ።’<verse eid="ACT 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 22:17"/>“አንስ ዬሩሳሌምት ዴብኤ ኡቱ መነ ቁልቁሉማ ኬሰት ከዸትናት ጅሩ አከ ዋን ኦፍ ወላሉ ነንተኤ። <verse eid="ACT 22:17"/><verse number="18" style="v" sid="ACT 22:18"/>ጎፍታሌ እሳ፣ <char style="wj">‘ጀር ኩን ዋን አት ዋኤኮ ዹጋ ባቱ ህንፉዸተኒቲ ደፊ አሙመ ዬሩሳሌም ኬሳ በእ!’</char> ጄዼ ነት ዱበቱ ነንአርጌ።<verse eid="ACT 22:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 22:19"/>“አንስ ዴብሴን አከነ ጄዼ፤ ‘ያ ጎፍታ ጀር ኩን አከ አን ወረ ስት አመነን ህዹፊ ቱሙፍ ጄዼ መነ ሰገዳ ቶኮራ ገረ እሰ ብራት ደርባ ቱሬ ቤኩ። <verse eid="ACT 22:19"/><verse number="20" style="v" sid="ACT 22:20"/>ዬሮ ዺግን ዹገ ባቱኬቲ፣ ዺግን እስጥፋኖስ ዸንገላፈሜትስ አን አጄፈሙሳት ነሞታን ወሊ ገሌ አች ዻበዼን ኡፈተ ወረ እሰ አጄሰኒ ኤጋ ቱሬ።’<verse eid="ACT 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 22:21"/>“ጎፍታንስ፣ <char style="wj">‘አን ፈጎት፣ ገረ ነሞተ ኦርማት ስን ኤርጋቲ ዴም’</char> ናን ጄዼ።”<verse eid="ACT 22:21"/></para>
  <para style="s1">ጳዉሎስ አከ ለሚ ሮማ ተኤ እብሴ</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22"/>ነሞትን ሱንስ ሀመ እን ዱቢ ከነ ዱበቱት እሰ ዸገኣ ቱረን፤ ኤርገሲስ ሰገሌሳኒ ኦል ፉዸተኒ፣ “ነምን አከና ጅራቹ ህንቀቡቲ ለፈራ በሌሳ!” ጄዸኒ እየን።<verse eid="ACT 22:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 22:23"/>ኡቱ እሳን ኡፈተሳኒ ደደርበተኒ፣ አዋረስ ቅሌንሰ ኬሰ ብብትኔሰኒ እየኑ፣ <verse eid="ACT 22:23"/><verse number="24" style="v" sid="ACT 22:24"/>አጀጃን ሱን አከ ጳዉሎስ ቁበተ ሎልቶታት ኦል ገልፈሙ አጀጄ፤ እንስ ዋን ነሞትን አከስ እሰት እየኒፍ ቤኩፍ ጄዼ አከ ጳዉሎስ ገረፈሜ ቆረተሙ አጀጄ። <verse eid="ACT 22:24"/><verse number="25" style="v" sid="ACT 22:25"/>ጳዉሎስሞ ዮሙ እሳን እሰ ገረፉፍ<note caller="+" style="f"><char style="fr" closed="false">22፥25 </char><char style="fq" closed="false">ገረፉፍ </char><char style="ft" closed="false">– ጎች ኩን አከ አደቢት ኡቱ ህንተእን ከራ እቲን ነመ ቶኮ ቆረተኒ ዮካን ረክሰኒ አከ እን ዹጋ ባሱ ምርከኔሱፍ እት ፈየደመኒዸ። ጎች ኩን ገርበ ዮካን መጠንቱረት ራወተመ መሌ ለሚ ሮማ ቶኮረት ህንራወተሙ ቱሬ።</char></note> ጄዸኒ ቴጳን እሰ ህዸንት አጀጃ ዽባ ከን እሰ ብረ ዻበቻ ቱሬን፣ “ለሚ ሮማ ቶኮ ሙርቲ መሌ ገረፉን እስኒፍ ንኤየመማ?” ጄዼ።<verse eid="ACT 22:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 22:26"/>አጀጃን ዽባ ሱንስ ዮሙ ዋን ከነ ዸገኤት ገረ አጀጃ ኩማ ሰና ዸቄ፣ “ነምች ኩኖ ለሚ ሮማቲ አት ማል ጎቹ ያደ?” ጄዼን።<verse eid="ACT 22:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 22:27"/>አጀጃን ኩማ ሱንስ ጳዉሎስ ብረ ዸቄ፣ “ሜ ነት ህም፤ አት ለሚ ሮማቲ?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="ACT 22:27">እንስ፣ “ኤዬ” ጄዼ ዴብሴ።<verse eid="ACT 22:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 22:28"/>አጀጃን ኩማ ሱንስ፣ “አን ለሙማ ከነ አርገቹዻፍ ገቲ ጉዳ ባሴ” ጄዼ።</para>
  <para style="p" vid="ACT 22:28">ጳዉሎስሞ ዴብሴ፣ “አን ገሩ እን ዸለዼ” ጄዼ።<verse eid="ACT 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 22:29"/>ወር እሰ ቆሩፍ ያደንስ ዮሙሱመ እሰራ ዴብአን፤ አጀጃን ኩማ ሱንስ ዮሙ አከ ጳዉሎስ ለሚ ሮማ ተኤፊ አከ ኦፊሳቲሞ ጳዉሎስን ፎንጫን ህዼ ሁበቴት ንርፈቴ።<verse eid="ACT 22:29"/></para>
  <para style="s1">ጳዉሎስ ያኢ ይሁዶታ ዱረት ዽኣቴ</para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 22:30"/>አጀጃን ኩማ ሱን ሰበቢ ይሁዶትን ጳዉሎስን ህመተኒፍ ስሪት ቤኩ ፌዼ ጉያ እት ኣኑ እሰ ሂኬ አከ ሉቦትን ሀንገፎትኒፊ ወልዳን ይሁዶታ ሁንድ ወልት ቀበመን አጀጄ። ኤርገሲሞ ጳዉሎስን ፍዴ አከ እን ፉለሳኒ ዱረት ዽኣቱ ጎዼ።<verse eid="ACT 22:30"/></para>
  <chapter eid="ACT 22"/>
  <chapter number="23" style="c" sid="ACT 23"/>
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1"/>ጳዉሎስ ጥዬፈቴ ያኢ ሰነ እላሌ፣ “ያ ኦቦሎተኮ፣ አን ሀመ ጉያ ሀርኣት ፉለ ዋቃ ዱረ ያደ ጋሪዻን ጅራዼረ” ጄዼ። <verse eid="ACT 23:1"/><verse number="2" style="v" sid="ACT 23:2"/>ከነረት አናንያን ሉብን ኦል ኣናን አከ ወር ጳዉሎስ ብረ ዻበቻ ቱረን ሱን አፋንሳ ኬሰ ዸአን አጀጄ። <verse eid="ACT 23:2"/><verse number="3" style="v" sid="ACT 23:3"/>ጳዉሎስስ ዴብሴ፣ “አት ኬኘን ኖራ ድበሜ፣ ዋቅን ስሩኩተ! ሴራን ነት ሙሩፍ ጄቴ አች ቴሴ አቱምት መታንኬሞ አከ አን ዸአሙ አጀጁዻን ሴረ ጨብስታ?” ጄዼ።<verse eid="ACT 23:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 23:4"/>ወር ጳዉሎስ ብረ ዻበቻ ቱረንስ፤ “አት አከም ሉበ ዋቃ ኦል ኣና ቶኮ አረብስተ?” ጄዸኒን።<verse eid="ACT 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 23:5"/>ጳዉሎስሞ ዴብሴ፣ “ያ ኦቦሎተ፣ አን አከ እን ሉብቸ ኦል ኣና ተኤ ህንቤክኔ፤ ‘ዋኤ ቡልቻ ሰበኬቲ ሀማ ህንዱበትን’ ጄዸሜ በሬፈሜራቲ”<note caller="+" style="f"><char style="fr" closed="false">23፥5 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 22:28">በኡ 22፥28</ref></char></char></note> ጄዼ።<verse eid="ACT 23:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 23:6"/>ጳዉሎስ ዮሙ አከ እሳን ኬሳ ገር ቶኮ ሰዱቆተ፣ ገር ካንሞ ፈሪሶተ ተአን ቤኬት፣ “ያ ኦቦሎተኮ፣ አን ፈሪስቸ እልመ ፈሪሲት። አን ሰበቢ አከ ወር ዱአን ዱኣ ከአን አብደዹፍ ቆረሙፍ ዽኣዼረ” ጄዼ። <verse eid="ACT 23:6"/><verse number="7" style="v" sid="ACT 23:7"/>ዮሙ እን ዋን ከነ ዱበቴት ፈሪሶታፊ ሰዱቆተ ግዱት ፈልሚን ኡመሜ፤ ያኢን ሱን ገርገር ቆደሜ። <verse eid="ACT 23:7"/><verse number="8" style="v" sid="ACT 23:8"/>ሰዱቆትን፣ “ዱኣ ከኡን ህንጅሩ፣ ኤርገሞትንስ፣ ሀፉሮትንስ ህንጅረን” ጄዹ፤ ፈሪሶትን ገሩ አከ ኩኔን ሁንድኑ ጅረን አመኑ።<verse eid="ACT 23:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 23:9"/>ወጭን ጉዳንስ ኡመሜ፤ በርሲስቶትን ሴራ ቶኮ ቶኮስ ገሬ ፈሪሶታ ኬሳ ከአኒ፣ “ኑ በሌሳ ቶኮሌ ነምቸ ከነረት ህንአርገትኔ፤ ሀፉረ ዮካን ኤርገማቱ እሰት ዱበቴ ተእና?” ጄዸኒ ጭምሰኒ ዱበተን። <verse eid="ACT 23:9"/><verse number="10" style="v" sid="ACT 23:10"/>አጀጃን ኩማ ሱንስ ዮሙ ፈልሚን ጀባቻ ዴሜት ጀር ኩን ጳዉሎስን ጭጭሩ ጄዼ ሶዳቴ። ከናፍ አከ ሎልቶትን ዸቀኒ ሁምናን አቺ እሰ ፉዸኒ ቁበተ ሎልቶታት ኦል ገልቸን አጀጄ።<verse eid="ACT 23:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 23:11"/>ጎፍታንስ ሀልከን እት ኣኑት ጳዉሎስት ሙልአቴ፣ <char style="wj">“ጀባዹ! አኩመ ዬሩሳሌም ኬሰት ዋኤኮ ዹጋ ባቴ ሰነ ሮማ ኬሰትስ ዹጋ በኡ ቀብዳቲ”</char> ጄዼን።<verse eid="ACT 23:11"/></para>
  <para style="s1">መሬ ጳዉሎስረት መርአተሜ</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 23:12"/>ይሁዶትን ቶኮ ቶኮ በሪ ጉያ እት ኣኑ መርአተኒ አከ ሀመ ጳዉሎስን አጄሰንት ዋ ህንኛትኔ ዮካን ዋ ህንዹግኔ ወሊ ከከተን። <verse eid="ACT 23:12"/><verse number="13" style="v" sid="ACT 23:13"/>ነሞተ አፉርተማ ኦልቱ መሬ ከነረት ህርማቴ። <verse eid="ACT 23:13"/><verse number="14" style="v" sid="ACT 23:14"/>እሳንስ ገረ ሉቦተ ሀንገፎታቲፊ ገረ ማንጉዶታ ዸቀኒ አከነ ጄዸን፤ “ኑ ሀመ ጳዉሎስን አጄፍኑት አከ ሆማ አፋኒን ህንቀብኔ ጀቤስኔ ከከትኔረ። <verse eid="ACT 23:14"/><verse number="15" style="v" sid="ACT 23:15"/>ከናፉ እስኒፊ ወልዳን ይሁዶታ ዋን ዋኤ ጳዉሎስ ስሪት ጭምስተኒ ቆረቹ በርባደን ፈኬሳቲ አከ አጀጃን ኩማ ሱን ጳዉሎስን ገረኬሰንት ገድ ኤርጉ ከዸዻ፤ ኑ ኡቱ እን አች ህንገእን እሰ አጄሱፍ ቆጶፍኔራቲ።”<verse eid="ACT 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 23:16"/>ገሩ እልም ኦቦሌቲ ጳዉሎስ ዮሙ መሬ ከነ ዸገኤት ቁበተ ሎልቶታት ኦል ገሌ ጳዉሎስት ህሜ።<verse eid="ACT 23:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 23:17"/>ጳዉሎስስ አጀጁወን ዽባ ኬሳ ነመ ቶኮ ዋሜ፣ “ደርገጌስ ኩን ዋን እሰት ህሙ ቀባቲ ሜ አጀጃ ኩማት እሰ ጌስ” ጄዼን። <verse eid="ACT 23:17"/><verse number="18" style="v" sid="ACT 23:18"/>እንስ አጀጃ ኩማ ሰነት እሰ ጌሴ።</para>
  <para style="p" vid="ACT 23:18">አጀጃን ዽባ ሱንስ፣ “ጳዉሎስ እን መነ ህዻ ጅሩ ሱን ነ ዋምስሴ ዋን ደርገጌስ ኩን ዋን ስት ህሙ ቶኮ ቀቡፍ አከ አን እሰ ስት ፍዱ ነ ከዸቴ” ጄዼን።<verse eid="ACT 23:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 23:19"/>አጀጃን ኩማስ ደርገጌሰ ሰነ ሀርከ ቀቤ ኮጳት ባሴ፣ “ወን አት ነት ህሙ በርባዱ ማል?” ጄዼ ጋፈቴ።<verse eid="ACT 23:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 23:20"/>ደርገጌስ ሱንስ አከነ ጄዼ፤ “ይሁዶን ዋን ዋኤሳ ስሪት ጭምሰኒ ቆሩ በርባደን ፈኬሰኒ አከ አት ጳዉሎስን ቦር ገረ ያኢ ይሁዶታት ገድ ኤርግቱ ስከዸቹፍ ወሊ ገለኒሩ። <verse eid="ACT 23:20"/><verse number="21" style="v" sid="ACT 23:21"/>ዋን እሳን ኬሳ ነሞትን አፉርተማ ኦል ተአን ርጰኒ እሰ ኤገቻ ጅረኒፍ አት እሳን ጀላ ህንቀብን። እሳን አከ ሀመ እሰ አጄሰንት ዋን ቶኮሌ ህንኛትኔ ዮካን ህንዹግኔ ከከተኒሩ፤ ቆጳአኒስ ኤየመኬ ኤገቻ ጅሩ።”<verse eid="ACT 23:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 23:22"/>አጀጃን ኩማ ሱንስ፣ “አት አከ ዋን ከነ ነት ህምቴ ነመ ቶኮትዩ ህንዱበትን” ጄዼ ደርገጌሰ ሰነ አኬከቺሴ ገድ ዺሴ።<verse eid="ACT 23:22"/></para>
  <para style="s1">ጳዉሎስ ቂሳርያት ደበርፈሜ</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 23:23"/>ኤርገሲ እን አጀጁወን ዽባ ኬሳ ነመ ለመ ዋሜ አከነ ጄዼ አጀጄ፤ “አከ ሎልቶትን ዽብ ለመ፣ አቦቲን ፈርዳ ቶርባተምኒፊ ወር ኤቦ ቀበተን ዽብ ለመ ኤደነ ሰኣቲ ሰዲት ቂሳርያ ዸቀኒፍ ቆጴሳ። <verse eid="ACT 23:23"/><verse number="24" style="v" sid="ACT 23:24"/>ጳዉሎሲፍስ ፈርደ እን ያበቱ ቆጴሳቲ ገረ ፊልክስ ቡልቻ ብያት ነጋን ጌሳ።”<verse eid="ACT 23:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 23:25"/>እንስ አከነ ጄዼ ጠለያ ቶኮ በሬሴ።<verse eid="ACT 23:25"/></para>
  <para style="pmo">
    <verse number="26" style="v" sid="ACT 23:26"/>ቀላዉዴዎስ ሉስዮስራ፣</para>
  <para style="pmo" vid="ACT 23:26">ገረ ቡልቻ ከበጀማ፣ ገረ ፊልክስ፤</para>
  <para style="pmo" vid="ACT 23:26">ነጋ ጅርታ?<verse eid="ACT 23:26"/></para>
  <para style="pm">
    <verse number="27" style="v" sid="ACT 23:27"/>ይሁዶትን ነምቸ ከነ ቀበኒ አጄሱ በርባዳ ቱረን፤ አን ገሩ አከ እን ለሚ ሮማ ተኤ ቤኬ ሎልቶተኮ ወጅን ዸቄ እሰ ባሴ። <verse eid="ACT 23:27"/><verse number="28" style="v" sid="ACT 23:28"/>አንስ ዋን እሳን እሰ ህመተኒፍ ቤኩ በርባዴን ፉለ ወልዳሳኒ ዱረት እሰ ዽኤሴ። <verse eid="ACT 23:28"/><verse number="29" style="v" sid="ACT 23:29"/>አን አከ እን ዋኤ ጋፊ ሴረሳኒቲን ህመተሜ አርጌ መሌ አከ እን ዋን ዱኣን ዮካን ህዻን እሰ ገኡ ቶኩማኑ ህመተሜ ህንአርግኔ። <verse eid="ACT 23:29"/><verse number="30" style="v" sid="ACT 23:30"/>አን ዬሮ አከ እሳን ነምቸ ሰነት መርአተን ዸገኤት ደፌ እሰ ስተን ኤርጌ። ወረ እሰ ህመተንስ አከ እሳን ህመተሳኒ ስት ዽኤፈተን አጀጄረ።<verse eid="ACT 23:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 23:31"/>ከናፍ ሎልቶትን ሱን አኩመ አጀጀመን ሰነ ጳዉሎስን ፉዸኒ ሀልከኒን አንቲጳጥሪስት ጌሰን። <verse eid="ACT 23:31"/><verse number="32" style="v" sid="ACT 23:32"/>እሳንስ ጉያ እት ኣኑት አከ አቦቲን ፈርዳ እሰ ወጅን ዴመን ጎዸኒ ኦፊሞ ቁበተ ሎልቶታት ዴብአን። <verse eid="ACT 23:32"/><verse number="33" style="v" sid="ACT 23:33"/>አቦቲን ፈርዳ ሱንስ ዮሙ ቂሳርያ ገአንት ጠለያ ሰነ ቡልቻት ኬነን፤ ጳዉሎስንስ ፉለሳ ዱረ ዽኤሰን። <verse eid="ACT 23:33"/><verse number="34" style="v" sid="ACT 23:34"/>ቡልቻን ሱንስ ኤርገ ጠለያ ሰነ ዱብፈቴ ቦዴ፣ አከ እን ብየ ከሚ ዹፌ እሰ ጋፈቴ። ዮሙ አከ እን ኪልቅያዻ ዹፌ ቤኬትስ፣ <verse eid="ACT 23:34"/><verse number="35" style="v" sid="ACT 23:35"/>“አን ዬሮ ህመቶትንኬ አስ ገአንት ዱቢኬ ነንዸገአ” ጄዼ። እንስ ኤርገሲ አከ ጳዉሎስ መሰራ ሄሮድስ ኬሰት ኤገሙስ አጀጄ።<verse eid="ACT 23:35"/></para>
  <chapter eid="ACT 23"/>
  <chapter number="24" style="c" sid="ACT 24"/>
  <para style="s1">ጳዉሎስ ፉለ ፊልክስ ዱረት</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1"/>ጉያ ሸን ቦዴ አናንያን ሉብን ኦል ኣናን ማንጉዶተ ቶኮ ቶኮፊ አቡካቶ ጠርጡሎስ ጄዸሙ ቶኮ ወጅን ቂሳርያት ገድ ቡኤ፤ እሳንስ ዋን እቲን ጳዉሎስን ህመተን ቡልቻ ዱረት ዽኤፈተን። <verse eid="ACT 24:1"/><verse number="2" style="v" sid="ACT 24:2"/>ዮሙ ጳዉሎስ ዋመሜ ኦል ገሌት፣ ጠርጡሎስ አከነ ጄዼ ህመተሳ ፊልክስ ዱረት ዽኤፈቴ፤ “ያ ፊልክስ ከበጀማ፣ ኑ በረኬ ኬሰ ዬሮ ዼራ ነጋን ጅራትኔረ፤ ኦጉማንኬስ ሰበ ከናፍ ጌደረመ ፍዴረ። <verse eid="ACT 24:2"/><verse number="3" style="v" sid="ACT 24:3"/>ያ ፊልክስ ከበጀማ፣ ኑ ዋን ከነ ከራ ሁንዱማፊ እዶ ሁንደት ገለተ ጉዳዻን ንፉዸትነ። <verse eid="ACT 24:3"/><verse number="4" style="v" sid="ACT 24:4"/>ገሩ አን አከ ሀመነረ ስ ህንደዸብሲፍኔፍ አከ አት ገባቡመት ገረ ላፍናን ኑ ዸጌሱ ስን ከዸዸ።<verse eid="ACT 24:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 24:5"/>“ኑ አከ ነምች ኩን ዹኩበ ሀማ ተኤ ይሁዶተ አዱኛ ጉቱረ ጅረን ሁንደ ኬሰት ጎሊ ካሳ ጅሩ አርግኔረ። እን ሆገና ገሬ ናዝሮታት። <verse eid="ACT 24:5"/><verse number="6" style="v" sid="ACT 24:6"/>እን መነ ቁልቁሉማዩ ጡሬሱ ያሌረ፤ ኑሞ አከ ሴረኬኛት እት ሙሩፍ ጄኔ እሰ ቀብኔ። [ <verse eid="ACT 24:6"/><verse number="7" style="v" sid="ACT 24:7"/>ገሩ ሉስዮስ አጀጃን ኩማ ሱን ዹፌ ሁምነ ጉዳን ሀርከኬኘ ኬሳ እሰ ባሴ፤ አከ ህመቶትንሳ ፉለኬ ዱረት ዽኣተንስ ንአጀጄ።]<note caller="+" style="f"><char style="fr" closed="false">24፥7 </char><char style="ft" closed="false">ወራብሌን ዱሪ ቶኮ ቶኮ ሉቅሳ 7 ህንቀበን።</char></note> <verse eid="ACT 24:7"/><verse number="8" style="v" sid="ACT 24:8"/>አት መታንኬዩ እሰ ቆሩዻን ዋኤ ዋን ኑ እሰ ህመትኑ ከና ሁንደ ቤኩ ንደንዴሰ።”<verse eid="ACT 24:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 24:9"/>ይሁዶትንስ አከ ዱቢን ኩን ዹጋ ተኤ ምርከኔሰኒ ህመተ ሰነ ዴገረን።<verse eid="ACT 24:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 24:10"/>ጳዉሎስስ ዮሙ ቡልቻን ሱን አከ እን ዱበቱፍ ሀርካን መለቶ ኬኔፍት አከነ ጄዼ ዴቢ ኬኔ፤ “አን ዋን አከ አት ወጎተ ሄዱፍ አባ ሙርቲ ሰበ ከና ታቴ ቤኩፍ ፈልሚኮ ገመቹዻን ነንዽኤፈዸ። <verse eid="ACT 24:10"/><verse number="11" style="v" sid="ACT 24:11"/>አኩመ አት ረኮ መሌ ምርከኔፈቹ ደንዴሱ አን ዋቄፈቹፍ ጄዼ ዬሩሳሌምት ኦል በኡንኮ ጉያ 12 ህንጫሉ። <verse eid="ACT 24:11"/><verse number="12" style="v" sid="ACT 24:12"/>ወር ነ ህመተን ኩን አና መነ ቁልቁሉማ ኬሰት ዮካን መኔን ሰገዳ ኬሰት ዮካን መጋላ ኬሰት ነመ ቶኮንሌ ፈልሙ ዮካን ኡመተ ከካሱ ነ ህንአርገትኔ። <verse eid="ACT 24:12"/><verse number="13" style="v" sid="ACT 24:13"/>እሳን ዋን አመ እቲን ነ ህመቻ ጅረን ከነስ ሲፍ ምርከኔሱ ህንደንደአን። <verse eid="ACT 24:13"/><verse number="14" style="v" sid="ACT 24:14"/>ተኡስ አን አከ ነመ ከራ እሳን ገሬ ሞርምቶታ ጄዸኒን ሰነ ዱካ ቡኡ ቶኮት አከ ዋቀ አቦቲኬኛ ዋቄፈዹ ፉለኬ ዱረት ነንአመነ። ዋን ሴረ ሙሴቲን ወሊ ገሉፊ ዋን ክታቦተ ራጆታ ኬሰት በሬፈሜ ሁንደስ ነንአመነ። <verse eid="ACT 24:14"/><verse number="15" style="v" sid="ACT 24:15"/>አንስ አኩመ ጀረ ከና አከ ዱኣ ከኡን ቀጄልቶታቲፊ ሀሞታ ጅራቱ ዋቀ ነንአብደዸ። <verse eid="ACT 24:15"/><verse number="16" style="v" sid="ACT 24:16"/>ከናፉ አን አከ ዬሮ ሁንደ ዋቃፊ ነመ ዱረት ያደ ቁልቁሉ ቀባዹ ነንተታፈዸ።<verse eid="ACT 24:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 24:17"/>“አንስ በረ ባይኤ ህዬዪ ሰበኮቲቲፍ ገርጋርሰ ኬኑፍ፣ ዋቃፍስ ኣርሳ ዽኤሱፍ ጄዼ ዬሩሳሌም ዹፌ። <verse eid="ACT 24:17"/><verse number="18" style="v" sid="ACT 24:18"/>ዬሮ አን ዋን ከነ ሆጄቻ ቱሬትስ እሳን አና ቁልቁላኤ ጅሩ መነ ቁልቁሉማ ኬሰት ነ አርገን። ቱትን ቶኮዩ ነ ብረ ህንቱሬ፤ አንስ ጎሊ ኬሰት ህንህርማትኔ። <verse eid="ACT 24:18"/><verse number="19" style="v" sid="ACT 24:19"/>ገሩ ይሁዶትን ብየ አስያ ከኔን ዮ ዋን እቲን ነ ህመተን ቶኮሌ ነራ ቀባተን ስ ዱረት አስ ዽኣተኒ ነ ህመቹ መለን ቶኮ ቶኮ ጅሩ። <verse eid="ACT 24:19"/><verse number="20" style="v" sid="ACT 24:20"/>ዮካን ወር አስ ጅረን ኩኔን የከ ዬሮ አን ፉለ ወልዳ ይሁዶታ ዱረ ዻበዼ ሰነ ነረት አርገን ሃህመን፤ <verse eid="ACT 24:20"/><verse number="21" style="v" sid="ACT 24:21"/>ዋን አን ዬሮ ፉለሳኒ ዱረ ዻበዼ ሰነ እዬ፣ ‘አን ሀርአ ዋኤ ዱኣ ከኡ ወረ ዱአኒረት ቆረሙፍ ጄዼ ፉለኬሰን ዱረ ዻበዼረ’ ጄዼ ቶክቸ ሰነ መሌ ዮ ጅራቴ ሃህመን።”<verse eid="ACT 24:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 24:22"/>ፊልክስ ገሩ ዋን ዋኤ ከራ ሰና ስሪት ቤኩፍ፣ “አን ጋፈ ሉስዮስ አጀጃን ኩማ ሱን ዹፉት ዱቢኬሰን ነንሙርቴሰ” ጄዼ ዬሮ ብራት ደበርሴ። <verse eid="ACT 24:22"/><verse number="23" style="v" sid="ACT 24:23"/>እንስ አከ አጀጃን ዽባ ሱን ጳዉሎስን ኤጉምሰ ጀለ ቱርሱ፣ ገሩ አከ ሃለሳ እት ፉሩፊ አከ ምቾትንሳስ ዋን እሰ በርባችሱ ከምዩ እሳፍ ዽኤሰን ኤየሙፍ አጀጄ።<verse eid="ACT 24:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 24:24"/>ፊልክስስ ቡልቲ ሙራሰ ቦዴ ኒቲሳ ድሩሲላ እሼ ይሁዲ ቱርቴ ወጅን ዹፌ፤ እንስ ጳዉሎስን ዋምስሴ እሳ ዋኤ ክርስቶስ ዬሱስት አመኑ ዱበቱ ዸጌፈቴ። <verse eid="ACT 24:24"/><verse number="25" style="v" sid="ACT 24:25"/>ዮሙ ጳዉሎስ ዋኤ ቀጄሉማ፣ ዋኤ ኦፍ ቀቡቲፊ ዋኤ ሙርቲ ከን ዹፉፍ ጅሩ ሰና ዱበቴት ፊልክስ ሶዳቴ፣ “አማፍ ንገኣቲ ዴም! ዮሙ ናፍ ምጃኡት አኑ ስን ዋምስሳቲ” ጄዼ። <verse eid="ACT 24:25"/><verse number="26" style="v" sid="ACT 24:26"/>ዬሮዹመ ሰነትስ እን አከ ዋን ጳዉሎስ መተኣ እሳፍ ኬኑት ዋን አብደቻ ቱሬፍ አሙመ አመ ዋምስሴ እሰ ወጅን ሃሰኣ ቱሬ።<verse eid="ACT 24:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 24:27"/>ጶርቅዮስ ፍስጦስ ኤርገ ወጋን ለመ ደርቤ ቦዴ እዶ ፊልክስ ቀበቴ፤ ፊልክስስ ዋን ይሁዶተ ገመቺሱ በርባዴፍ ጳዉሎስን መኑመ ህዻት ዺሴ።<verse eid="ACT 24:27"/></para>
  <chapter eid="ACT 24"/>
  <chapter number="25" style="c" sid="ACT 25"/>
  <para style="s1">ጳዉሎስ ፉለ ፍስጦስ ዱረት ቆረሜ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1"/>ፍስጦስስ ብየ ሰነ ገኤ ጉያ ሰዲ ቦዴ ቂሳርያዻ ዬሩሳሌምት ኦል በኤ፤ <verse eid="ACT 25:1"/><verse number="2" style="v" sid="ACT 25:2"/>አችትስ ሉቦትን ሀንገፎትኒፊ ዱረ ቡኦትን ይሁዶታ ፉለሳ ዱረት ዽኣተኒ ህመተ ጳዉሎስራ ቀበን ዽኤፈተን። <verse eid="ACT 25:2"/><verse number="3" style="v" sid="ACT 25:3"/>እሳንስ ዋን ከራት ርጰኒ ጳዉሎስን አጄሱፍ ቆጳኣ ቱረኒፍ አከ ፍስጦስ እሳን ዴገሬ ነመ ኤርጌ ገረ ዬሩሳሌም እሰ ፍችሲሱ ከዸተን። <verse eid="ACT 25:3"/><verse number="4" style="v" sid="ACT 25:4"/>ፍስጦስሞ አከነ ጄዼ ዴብሴ፤ “ጳዉሎስ ቂሳርያት ኤገማ ጅረ፤ አን መታንኮዩ ዽኤኘት አች ነንዸቀ። <verse eid="ACT 25:4"/><verse number="5" style="v" sid="ACT 25:5"/>ከናፉ አቦቲ ታይታኬሰን ኬሳ ቶኮ ቶኮ ነ ወጅን ዴመኒ ዮ ነምች ሱን በሌሳ ወዪ ቀባቴ አችት እሰ ሃህመተን።”<verse eid="ACT 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 25:6"/>እንስ ኤርገ ጉያ ሰዴት ዮካን ኩዸን እሳን ብረ ቡቡሌ ቦዴ ቂሳርያት ገድ ቡኤ፤ ጉያ እት ኣኑትስ በርጩመ ሙርቲረ ታኤ አከ ጳዉሎስ ፉለሳ ዱረት ዽኤፈሙ አጀጄ። <verse eid="ACT 25:6"/><verse number="7" style="v" sid="ACT 25:7"/>ዮሙ ጳዉሎስ ዽኣቴትስ ይሁዶትን ዬሩሳሌሚ ገድ ቡአን ሱን እሰት ናነአኒ ዻበቹን ህመተ ጭጭማ ሄዱ እሰረት ዽኤሰን፤ ገሩ አመንሲሱ ህንደንዴኜ።<verse eid="ACT 25:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 25:8"/>ጳዉሎስስ፣ “አን ሴረ ይሁዶታረት ዮካን መነ ቁልቁሉማረት ዮካን ቄሳርረት የከ ቶኮሌ ህንሆጄትኔ” ጄዼ ፈልመቴ።<verse eid="ACT 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 25:9"/>ፍስጦስስ ይሁዶተ ገመቺሱፍ ጄዼ ጳዉሎሲን፣ “አት ዬሩሳሌምት ኦል ባቴ ህመተ ከነረት ፉለኮ ዱረት ቆረተሙ ንፌታ?” ጄዼ።<verse eid="ACT 25:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 25:10"/>ጳዉሎስ ገሩ አከነ ጄዼ ዴብሴ፤ “አን አመ በርጩመ ሙርቲ ቄሳር ዱረ፣ እዶ እት ቆረተሙ ቀቡ ዻበዼን ጅረ፤ አኩመ አት መታንኬዩ ስሪት ቤክቱ አን የከ ቶኮሌ ይሁዶተረት ህንሆጄትኔ። <verse eid="ACT 25:10"/><verse number="11" style="v" sid="ACT 25:11"/>ተኡስ አን ኡቱ በሌሳ ዱአ ነት ሙርሲሱ ቶኮሌ ሆጄዼ ስላ ዱአ ጀላ በኡፍ ህንጨራቁ፤ ገሩ ዮ ወን ይሁዶትን ኩኔን እቲን ነ ህመተን ዹጋ ህንተእን፣ ነምን ቶኮዩ ደበርሴ ሀርከሳኒት ነ ኬኑፍ ምርገ ህንቀቡ። አን ቄሳርት ኦል ነንእየዸ!”<verse eid="ACT 25:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 25:12"/>ፍስጦስስ ኤርገ ጎርስቶተሳ ወጅን መርአቴ ቦዴ፣ “አት ቄሳርት ኦል እየቴርተ፤ ገረ ቄሳር ንዸቅጠ!” ጄዼ።<verse eid="ACT 25:12"/></para>
  <para style="s1">ፍስጦስ ጎርሰ አግሪጳ ጋፈቴ</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13"/>ቡልቲ ሙራሰ ቦዴ አግሪጳ ሞትቺፊ በርኒቄን<note caller="+" style="f"><char style="fr" closed="false">25፥13 </char><char style="fq" closed="false">በርኒቄን </char><char style="ft" closed="false">– በርኒቄን ኦቦሌቲ አግሪጳት፤ እሼን ዽርሲራ ዱናን መነ ኦቦሌሳ ጅራቴ።</char></note> ፍስጦስ ስመቹፍ ቂሳርያ ዸቀን። <verse eid="ACT 25:13"/><verse number="14" style="v" sid="ACT 25:14"/>ፍስጦስስ እሳን ጉያ ሄዱ አች ቡቡላን አከነ ጄዼ ዋኤ ህመተ ጳዉሎስ ሞትቸ ወጅን ዱበቴ፤ “ነምች ፊልክስ መነ ህዻ ኬሰት ዺሴ ዴሜ ቶኮ አስ ጅረ። <verse eid="ACT 25:14"/><verse number="15" style="v" sid="ACT 25:15"/>ዬሮ አን ዬሩሳሌም ቱሬት ሉቦትን ሀንገፎትኒፊ ማንጉዶትን ይሁዶታ እሰ ህመተኒ አከ እት ሙረሙ ከዸተን።<verse eid="ACT 25:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 25:16"/>“አንስ አከ ነምን ከምዩ አከ ሴረ ብየ ሮማት ኡቱ ፉለ ህመቶተሳ ዱረት ዽኣቴ ህመተ ሰነ ሞርመቹፍ ጨራ ህንአርገን ደበርፈሜ ኬነሙ ህንቀብኔ እሳንት ህሜረ። <verse eid="ACT 25:16"/><verse number="17" style="v" sid="ACT 25:17"/>ከናፉ አን ዮሙ እሳን ነ ወጅን አስ ዹፈንት በርጩመ ሙርቲረ ታኤ አከ ነምቸ ነት ፍደን አጀጄ መሌ ዱቢ ሰነ ለፈረ ህንሀርክፍኔ። <verse eid="ACT 25:17"/><verse number="18" style="v" sid="ACT 25:18"/>ህመቶትንሳስ ዮሙ ዱበቹፍ ከአንት የከ አን እቲን እሰ ህመቱ ጄዼ ኤጌ ኬሳ ቶኮሌ እሰረት ህንዽኤስኔ። <verse eid="ACT 25:18"/><verse number="19" style="v" sid="ACT 25:19"/>ገሩ እሳን ዋኤ አመንታሳኒቲፊ ዋኤ ነምቸ ዱኤ ከን ዬሱስ ጄዸሙ እሰ ጳዉሎስሞ፣ ‘እን ጅራታዸ’ ጄዼ ፈልሙ ቶኮረት ወል ዸበን። <verse eid="ACT 25:19"/><verse number="20" style="v" sid="ACT 25:20"/>አንስ አከ እት ዱቢ ሰነ ቆረዹ ወላሌ፤ ከናፍ እን ዬሩሳሌም ዸቄ ህመተ ከነረት ቆረተሙፍ ፌዺ ቀቡፊ አከ እን ህንቀብኔ እሰ ጋፈዼ። <verse eid="ACT 25:20"/><verse number="21" style="v" sid="ACT 25:21"/>ገሩ ዮሙ ጳዉሎስ ሙርቲ አዉግስጦስ ቄሳር አርገቹፍ ጄዼ ቱርፈሙ ከዸቴት አን አከ እን ሀመ አን ቄሳርት እሰ ኤርጉት ኤገሙ ነንአጀጄ።”<verse eid="ACT 25:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 25:22"/>አግሪጳንስ ፍስጦሲን፣ “አን መታንኮ ነምቸ ከነ ዸገኡ ነንበርባደ” ጄዼ።</para>
  <para style="p" vid="ACT 25:22">እንሞ ዴብሴ፣ “ቦር እሰ ዸጌሰ” ጄዼን።<verse eid="ACT 25:22"/></para>
  <para style="s1">ጳዉሎስ ፉለ አግሪጳ ዱረት</para>
  <para style="r">
    <ref loc="ACT 26:12-18">26፥12‑18</ref> ኩወፈ – <char style="xt"><ref loc="ACT 9:3-8">ሆጂ 9፥3‑8</ref>፤ <ref loc="ACT 22:6-11">22፥6‑11</ref></char></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 25:23"/>ጉያ እት ኣኑትስ አግሪጳፊ በርኒቄን ኡልፍነ ጉዳን ዹፈኒ አጀጁወን ኩማቲፊ ጉርጉዶተ መጋላ ወጅን ገልመ ወል ገኢ ሴነን። ፍስጦስ አጀጅናን ጳዉሎስን ኦል ገልቸን። <verse eid="ACT 25:23"/><verse number="24" style="v" sid="ACT 25:24"/>ፍስጦስስ አከነ ጄዼ፤ “ያ አግሪጳ ሞትቸ፣ ወር ኑ ወጅን አስ ጅርተን ሁንድኑስ እስን ነምቸ ከነ ንአርግቱ! ሀዋስን ይሁዶታ ጉቱማት፣ ‘ነምች ኩን ስአች ጅራቹ ህንቀቡ’ ጄዸኒ ዋኤሳ ዬሩሳሌምቲፊ አስ ቂሳርያት እየኒ ነ ከዸተን። <verse eid="ACT 25:24"/><verse number="25" style="v" sid="ACT 25:25"/>አን ዋን ዱኣን እሰ ገኡ ከን እን ሆጄቴ ቶኮሌ ህንአርግኔ፤ አን ገሩ ሰበቢ እን አዉግስጦስት ኦል እየቴፍ ገረ ሮማት እሰ ኤርጉ ነንሙርቴሴ። <verse eid="ACT 25:25"/><verse number="26" style="v" sid="ACT 25:26"/>አን ዋኤ ነምቸ ከና ዋን እፈት በኤ ከን ጎፍታኮቲፍ በሬሱ ቶኮሌ ህንቀቡ፤ ከናፉ አን ኤርገ እሰ ቆረትኔ ቦዴ አከ ዋን በሬሱ አርገዹፍ ጄዼ ፉለ ሁንደኬሰኒ ዱረት፣ ኬሱመቱ ያ አግሪጳ ሞትቸ፣ ፉለኬ ዱረት እሰ ዽኤሴረ። <verse eid="ACT 25:26"/><verse number="27" style="v" sid="ACT 25:27"/>አን ነመ ህዸሜ ቶኮ ኡቱ ዋን እን እቲን ህመተሜ እፈት ህንባስን ኦል ደበርሱ ቀጄለ ህንሴኡቲ።”<verse eid="ACT 25:27"/></para>
  <chapter eid="ACT 25"/>
  <chapter number="26" style="c" sid="ACT 26"/>
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1"/>አግሪጳን ጳዉሎሲን፣ “አከ አት ኦፊኬቲፍ ዱበቱ ሲፍ ኤየመሜረ” ጄዼ።</para>
  <para style="p" vid="ACT 26:1">ጳዉሎስስ ሀርካን መለቶ ኬኔ አከነ ጄዼ ፈልመቹ ጀልቀቤ፤ <verse eid="ACT 26:1"/><verse number="2" style="v" sid="ACT 26:2"/>“ያ አግሪጳ ሞትቸ፣ አን ሰበቢ ዋን ይሁዶትን እቲን ነ ህመተን ሁንደ ፈልመቹዻፍ ጄዼ ሀርአ ፉለኬ ዱረ ዻበዹፍ አከ አያንቱ ቶኮን ኦፍ እላለ። <verse eid="ACT 26:2"/><verse number="3" style="v" sid="ACT 26:3"/>ኩንስ ዋን አት ዱዻፊ ወል ሞርሚ ይሁዶታ ሁንደ ኬሰ ቤክቱፊዸ። ከናፉ አን አከ አት ኦብሳን ነ ዸጌፈቱ ስን ከዸዸ።<verse eid="ACT 26:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 26:4"/>“አን እጆሉማኮቲ ጀልቀቤ ሰበኮ ኬሰት፣ ዬሩሳሌም ኬሰትስ አከምት አከ ጅራቻ ቱሬ ይሁዶትን ሁንድኑ ንቤኩ። <verse eid="ACT 26:4"/><verse number="5" style="v" sid="ACT 26:5"/>አከ አን አከ ፈሪስቸ ቶኮት አኩመ ስርነ ገሬ አከ መሌ አመንታኬኘት ጭቹ ሰናት ጅራዼ እሳኑ በረ ዼራ ዋን ነ ቤከኒፍ፣ ዮ ፌዺ ቀባተን ዹጋ በኡ ንደንደኡ። <verse eid="ACT 26:5"/><verse number="6" style="v" sid="ACT 26:6"/>አመስ አን ዋዳ ዋቅን አቦቲኬኛፍ ገሌ ሰነ ዋን አብደዹፍ ቆረተሙፍ ዽኣዼን አስ ጅረ። <verse eid="ACT 26:6"/><verse number="7" style="v" sid="ACT 26:7"/>ዋዳን ኩን እሱመ ጎሶትንኬኘ ኩዸ ለማን ሀልከኒ ጉያ ዋቀ ተጃጅሉት ጀባተኒ ራወተሙሳ አርጉ ሀወን ሰናዸ። ያ አግሪጳ ሞትቸ፣ ይሁዶትንስ ሰበቡመ አብዲ ከናቲፍ ነ ህመቻ ጅሩ። <verse eid="ACT 26:7"/><verse number="8" style="v" sid="ACT 26:8"/>አከ ዋቅን ወረ ዱአን ዱኣ ካሱ እስን ማሊፍ አከ ዋን ህንአመነምኔ ቶኮት ሄሬግዱ?<verse eid="ACT 26:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 26:9"/>“አን መታንኮዩ መቃ ዬሱስ ነመ ናዝሬቲቲን ሞርሙዻፍ አከ ዋን ደንደአሙ ሁንደ ጎቹ ቀቡ ነንአመነ ቱሬ። <verse eid="ACT 26:9"/><verse number="10" style="v" sid="ACT 26:10"/>ወን አን ዬሩሳሌም ኬሰት ሆጄዼስ ከኑመ፤ አን ታይታ ሉቦተ ሀንገፎተራ አርገዼን ቁልቁሎተ ባይኤ መነ ህዻት ነቁ ቆፈ ኡቱ ህንተእን ዬሮ እሳን አጄፈመንዩ ዱብቸረት ወሊ ገላን ቱሬ። <verse eid="ACT 26:10"/><verse number="11" style="v" sid="ACT 26:11"/>አንስ አከ እሳን አደበመኒፍ ዬሮ ባይኤ መነ ሰገዳ ቶኮራ ገረ መነ ሰገዳ ብራት ደርባ፣ አከ እሳን አመንቲሳኒ አረብሰኒፍስ እሳን ድርቅሲሳን ቱሬ። አን ዋን አከ መሌ እሳንት ኣራ ቱሬፍ ሀመ መጋላወን ብየ አላትሌ ዴሜ እሳን አርአቻን ቱሬ።<verse eid="ACT 26:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 26:12"/>“አንስ ጋፈ ቶኮ ከኑማፍ ጄዼ ታይታፊ ኤርገመ ሉቦተ ሀንገፎተ ብራ ፉዸዼ ኡቱን ደማስቆ ዴማ ጅሩ፣ <verse eid="ACT 26:12"/><verse number="13" style="v" sid="ACT 26:13"/>ያ ሞትቸ፣ አን ኡቱመን ከራ ዴማ ጅሩ ገረ ሳፋት እፈ እፈ አዱ ጫላ እብሱ ቶኮ እሳ ሰሚራ ናኖኮቲፊ ናኖ ወረ ነ ወጅን ዴመኒት እብሱ አርጌ። <verse eid="ACT 26:13"/><verse number="14" style="v" sid="ACT 26:14"/>ሁንድኬኘ ለፈት ኩኩፍኔ፤ አንስ ሰገሌ አፋን እብራይስጢቲን <char style="wj">‘ያ ሳዉል፣ ያ ሳዉል፣ አት ማሊፍ ነ አርአተ? አርፊ ወዪ ዺቱን ሱመ ሚዸ’</char> ናን ጄዹ ቶኮን ዸገኤ።<verse eid="ACT 26:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 26:15"/>“አንስ፣ ‘ያ ጎፍታ አት ኤኙ?’ ጄዼን ጋፈዼ።</para>
  <para style="p" vid="ACT 26:15">“ጎፍታንስ ዴብሴ አከነ ጄዼ፤ <char style="wj">‘አን ዬሱስ እሰ አት አርአቱዸ።</char> <verse eid="ACT 26:15"/><verse number="16" style="v" sid="ACT 26:16"/><char style="wj">አመ ከኢ ሚለኬቲን ዻበዹ። አን አከ አት ተጃጅላኮ ታቴ፣ ዋኤኮስ ዋን አርግቴፊ ዋን አን ስት ሙልእሱፍ ጅሩ አከ ዹጋ ባቱፍ ስሙዱፍ ጄዼ ስት ሙልአዼረ።</char> <verse eid="ACT 26:16"/><verse number="17" style="v" sid="ACT 26:17"/><char style="wj">አን ሰበኬቲፊ ነሞተ ኦርማ ከኔን ገረሳኒት ስ ኤርጉ ጀላ ስን ባሰ።</char> <verse eid="ACT 26:17"/><verse number="18" style="v" sid="ACT 26:18"/><char style="wj">አትስ እጀሳኒ በንቴ ዱከነ ኬሳ ገረ እፋት፣ ሁምነ ሴጠና ጀላስ ገረ ዋቃት እሳን ዴብፍተ፤ ኩንስ አከ እሳን ዺፈመ ጩቡ አርገተኒፊ አከ እሳን ወረ ነት አመኑን ቁልቁላአን ግዱት ዻለ አርገተኒፍ።’</char><verse eid="ACT 26:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 26:19"/>“ከናፉ ያ አግሪጳ ሞትቸ፣ አን ሙልአተ ሰሚራ ዹፌ ሰናፍ አጀጀሙ ህንድድኔ። <verse eid="ACT 26:19"/><verse number="20" style="v" sid="ACT 26:20"/>አንስ አከ እሳን ቀልቢ ጅጂረተኒ ገረ ዋቃት ዴብአኒፍ፣ ቀልቢ ጅጂረቹሳኒስ አከ ሆጂዻን ምርከኔሰኒፍ ጀልቀበት ወረ ደማስቆት፣ ወረ ዬሩሳሌሚት፣ ወረ ይሁዳ ጉቱት አከሱመስ ነሞተ ኦርማት ለለቤረ። <verse eid="ACT 26:20"/><verse number="21" style="v" sid="ACT 26:21"/>ሰበቢን ይሁዶትን መነ ቁልቁሉማ ኬሰት ነ ቀበኒ ነ አጄሱ ያለኒፍስ ከኑመ። <verse eid="ACT 26:21"/><verse number="22" style="v" sid="ACT 26:22"/>አን ገሩ ሀመ ጉያ ሀርኣት ገርጋርሰ ዋቃ ቀበ፤ ከናፉ አን ዻበዼ ጥና ጉዳፍ ዹጋ በኣን ጅረ። አን ዋን ራጆትኒፊ ሙሴን ‘ንተአ’ ጄዸኒ ዱበተኒን አለት ዋን ቶኮሌ ህንዱበዹ። <verse eid="ACT 26:22"/><verse number="23" style="v" sid="ACT 26:23"/>ኩንስ አከ ክርስቶስ ዽጰቹ ቀቡ፣ አከ እን ወረ ዱአን ኬሳ ከኡዻን ከን ጀልቀባ ተኤ ሰበሳቲፊ ነሞተ ኦርማቲፍ እፈ ለብሱዸ።”<verse eid="ACT 26:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 26:24"/>ኡቱመ ጳዉሎስ አከስት ፈልመቻ ጅሩ ፍስጦስ ሰገሌ ጉዳን፣ “ጳዉሎስ፣ አት መራቴርተ! በሩምስኬ ጉዳን ሱን ስመራችሳ ጅረ” ጄዼን።<verse eid="ACT 26:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 26:25"/>ጳዉሎስስ አከነ ጄዼ ዴብሴ፤ “ያ ፍስጦስ ከበጀማ፣ አን ህንመራትኔ፤ ወን አን ዱበቻ ጅሩስ ዹጋዸ፤ ስሪዸስ። <verse eid="ACT 26:25"/><verse number="26" style="v" sid="ACT 26:26"/>ሰበቢ ሞትች ዋን ከነ ቤኩፍ፣ አን እፈት ባሴ እሰት ህሙ ነንደንደአ። ሰበቢ ወን ኩን ሱቀት ህንሆጄተምኒፍ አን አከ ዋን ከነ ኬሳ ቶኮዩ እሰ ዱራ ህንዾከትን ነንአመነ። <verse eid="ACT 26:26"/><verse number="27" style="v" sid="ACT 26:27"/>ያ አግሪጳ ሞትቸ፣ አት ራጆተ ንአመንታ? አከ አት አመንቱ አንዩ ቤከ።”<verse eid="ACT 26:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 26:28"/>አግሪጳንስ ጳዉሎሲን፣ “አት ዬሩመ ገባባ ኬሰት ክርስታነ ነ ጎቹ ያዳ?” ጄዼ።<verse eid="ACT 26:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 26:29"/>ጳዉሎስስ ዴብሴ፣ “ዬሮ ገባባትስ ተኡ ዼራት፣ ስቆፈ ኡቱ ህንተእን አከ ወር ነ ዸገኣ ጅረን ሁንድኑ ፎንጫ ከናን ህዸሙ መሌ አኩመኮ አከ ተአን አን ዋቀ ነንከዸዸ” ጄዼ።<verse eid="ACT 26:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 26:30"/>ከነረት ሞትች፣ ቡልቻኒፊ በርኒቄን፣ አከሱመስ ወር እሳን ወጅን ተታኣ ቱረን ኦል ከአን። <verse eid="ACT 26:30"/><verse number="31" style="v" sid="ACT 26:31"/>እሳንስ ዬሮ ገድ በአንት፣ “ነምች ኩን ዋን ዱኣን ዮካን ህዻን እሰ ገኡ ቶኮሌ ህንሆጄትኔ” ወጅን ጄዸን።<verse eid="ACT 26:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 26:32"/>አግሪጳንስ ፍስጦሲን፣ “ነምች ኩን ኡቱ ቄሳርት ኦል እየቹ ባቴ ስላ ንሂከመ ቱሬ” ጄዼ።<verse eid="ACT 26:32"/></para>
  <chapter eid="ACT 26"/>
  <chapter number="27" style="c" sid="ACT 27"/>
  <para style="s1">ጳዉሎስ ሮማ ዸቁሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1"/>ዮሙ ዶኒን ኢጣልያ ዸቁንኬኘ ሙርቴፈሜት፣ ጳዉሎሲፊ ወር ህዸመን ብራ አጀጃ ዽባ ከን ዩልዮስ ጄዸሙ ቶኮት ደበርፈመኒ ኬነመን፤ እንስ ምሴንሰ ኩታ ወራና “አዉግስጦስ” ጄዸሙ ቶኮ ቱሬ። <verse eid="ACT 27:1"/><verse number="2" style="v" sid="ACT 27:2"/>ኑስ ዶኒ አድራሚጢሲ ከኤ ገረ ቡፈተወን ዶኒ ከኔን ቀርቀረ ገላነ ብየ አስያ ዸቁፍ ከኤ ቶኮ ያበትኔ ዴሙ ጀልቀበኔ። አርስጥሮኮስ ነምች መቄዶንያ ከን ተሰሎኒቄ ጅራቱ ቶኮስ ኑ ወጅን ቱሬ።<verse eid="ACT 27:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 27:3"/>ጉያ እት ኣኑት ስዶንት ገሌ፤ ዩልዮስስ ጳዉሎሲፍ ገራ ላፌ አከ እን ምቾተሳ ብረ ዸቄ ዋን እሰ በርባችሱ አርገቱ ኤየሜፍ። <verse eid="ACT 27:3"/><verse number="4" style="v" sid="ACT 27:4"/>ኑስ ዶኒን አቺ ካኔ ዋን ቡቤን ፉለኬኘ ዱራን ኑት ቡብሳ ቱሬፍ ቆጵሮሲን ደአትኔ ደበሬ። <verse eid="ACT 27:4"/><verse number="5" style="v" sid="ACT 27:5"/>ኤርገ ገላነ ኪልቅያፊ ጰምፉልያረ ዶኒን ደርብኔ ቦዴ መጋላ ሚራ ከን ሉስያ ኬሰት አርገምቱ ጌኜ። <verse eid="ACT 27:5"/><verse number="6" style="v" sid="ACT 27:6"/>አጀጃን ዽባ ሱንስ ዶኒ እስክንድርያ ከን ኢጣልያ ዸቁት ጅሩ ቶኮ አችት አርገቴ ኑ ያበቺሴ። <verse eid="ACT 27:6"/><verse number="7" style="v" sid="ACT 27:7"/>ኑስ ጉያ ሄዱ ሱተ ጄኔ ዶኒን ዴምኔ ረክናን ናኖ ቀኒዶስ ጌኜ፤ ዮሙ ቡቤን ከራ ሰነረ ደርቡ ኑ ዾዌትስ ሰልሙና ብራን ገረ ደኦ ቀርጤስት ቀጄሌ። <verse eid="ACT 27:7"/><verse number="8" style="v" sid="ACT 27:8"/>ረክነ ጉዳዻንስ ቀርቀረ ገላንቻረ ደርብኔ እዶ “ቡፈተ ዶኒ ጋሪ” ጄዸሙ ከን መጋላ ላስያ ብራ ቶኮት ባኔ።<verse eid="ACT 27:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 27:9"/>ዬሮን ዼራን በዴረ፤ ሰበቢ ዬሮን ሱን ኤርገ ሶምን ደርቤ ተኤፍ ብድሩዻን ከራ ዴሙን ሶዳችሳ ተኤረ፤ ከናፉ ጳዉሎስ አከነ ጄዼ እሳን አኬከቺሴ፤ <verse eid="ACT 27:9"/><verse number="10" style="v" sid="ACT 27:10"/>“ያ ጀረነ፣ አን አከ ከራንኬኘ ኩን በዲሰ ኦፍ ኬሳ ቀቡ፣ አከ እን ዶንቸቲፊ ምአ ቆፈት ኡቱ ህንተእን ጅሬኘኬኘትሌ በላ ጉዳ ፍዱፍ ዴሙ ነንአርገ።” <verse eid="ACT 27:10"/><verse number="11" style="v" sid="ACT 27:11"/>አጀጃን ዽባ ሱን ገሩ ቆደ ዋን ጳዉሎስ ጄዼ ዸገኡ ጎርሰ ኦፍቱ ዶኒቲፊ ጎርሰ አባ ዶኒ ፉዸቴ። <verse eid="ACT 27:11"/><verse number="12" style="v" sid="ACT 27:12"/>ሰበቢ ቡፈትን ዶኒ ሱን ገነ አች ቱሩፍ ምጃኣ ህንተእኒፍ ባይኤንሳኒ ፊንቄት ገለኒ ገነ አችት ደበርሱ አብደተኒ አከ ኑ እቱመ ፉፍኔ ዶኒን ዴምኑ ሙርቴሰን። ቡፈትን ቀርጤስ ኩን ፉልሳ ገረ ክበ ዽኣቲፊ ገረ ካበ ዽኣት ዴብኤ ቱሬ።<verse eid="ACT 27:12"/></para>
  <para style="s1">ቡቤ ገላነራ</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 27:13"/>ዬሮ ቡቤን ክባ ሱተ ቡብሱ ጀልቀቤት ዋን ካዮሳኒ ጉተቹ ደንደአን ሴአኒ ሂቱ ዶኒ ሂከኒ ቀርጤስ ብራን ቀርቀረ ገላነረ ደርበን። <verse eid="ACT 27:13"/><verse number="14" style="v" sid="ACT 27:14"/>ኡቱ ህንቱርንስ ቡቤን ሀማን፣ “አዉራቂስ” ጄዸሙ ቶኮ ብየ ብሻኒን መርፈምቴ ሰነራ ገድ ቡብሴ። <verse eid="ACT 27:14"/><verse number="15" style="v" sid="ACT 27:15"/>ዶኒን ሱንስ ቡቤዻን ቀበሜ ገረ ቡቤ ሰናት ዴሙ ደዸቤ፤ ከናፉ አከ እን ቡቤን ፉዸተሙፍ እቱመ ዺፍኔ። <verse eid="ACT 27:15"/><verse number="16" style="v" sid="ACT 27:16"/>ኑስ ብየ ብሻኒን መርፈምቴ ጥኖ ቄዳ ጄዸምቱ ቶኮን ደአትኔ ረክነ ጉዳዻን ብድሩ ዶንቻ ኦልቹ ደንዴኜ። <verse eid="ACT 27:16"/><verse number="17" style="v" sid="ACT 27:17"/>ነሞትን ሱንስ ብድሩ ሰነ ዶኒት ኦል ባሰኒ አከ ዶኒን ሱን ገርገር ህንዲገምኔፍ ፉኞን ጠጠኒ ወልት ህዸን። እሳንስ ትመ ጭረቸ ስርቲስት ቡኡ ሶዳተኒ ሂቱ ዶኒ ገላነት ገድ ቡሰኒ አከ ዶኒን ሱን ቡቤን ኦፈምቱፍ እቱመ ዺሰን። <verse eid="ACT 27:17"/><verse number="18" style="v" sid="ACT 27:18"/>ዋን ቡቤን ሱን አከ መሌ ኑት ጀባቻ ዴሜፍ እሳን ጉያ እት ኣኑት ዶኒ ሰነራ ፌኢሰ ጉረኒ ብሻንት ደደርበቹ ጀልቀበን። <verse eid="ACT 27:18"/><verse number="19" style="v" sid="ACT 27:19"/>ጉያ ሰደፋትሞ ምአ ዶኒ ሰና ሀርኩመ ኦፊ እሳኒቲን ደደርበተን። <verse eid="ACT 27:19"/><verse number="20" style="v" sid="ACT 27:20"/>ኑ ዋን ኡቱ አዱ ዮካን ኡርጂ ህንአርግን ጉያ ሄዱ ቱሬፊ ዋን ቡቤን ኑት ጀባቴፍ ዹመረት አብዲ በዲሰ ኦሉፍ ቀብኑ ሁንደ ንኩተትኔ።<verse eid="ACT 27:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 27:21"/>ጳዉሎስስ ኤርገ ነሞትን ሱን አገቡሳኒ ዬሮ ዼራ ቱረኒ ቦዴ ግዱሳኒ ዻበቴ አከነ ጄዼ፤ “ያ ጀረነ፣ እስን ኡቱ ጎርሰኮ ዸጌሰኒ ቀርጤሲ ከኡ ህንቀብደን ቱሬ፤ ስላ በላፊ በዲሰ ከነ ሁንዱማራ ኦፍ ኦልችቱ ቱርተን። <verse eid="ACT 27:21"/><verse number="22" style="v" sid="ACT 27:22"/>አመ ገሩ አን አከ እስን ጀባተን እስነን ጎርሰ፤ ዶንቸ መሌ እስን ኬሳ ሉቡን ነመ ቶኮዩ ህንበዱቲ። <verse eid="ACT 27:22"/><verse number="23" style="v" sid="ACT 27:23"/>ኤርገማን ዋቀ አን ከንሳ ተኤፊ እሰ ተጃጅሉ ሰና ቶኮ ኤደ ዹፌ ነ ጭነ ዻበቴ፣ <verse eid="ACT 27:23"/><verse number="24" style="v" sid="ACT 27:24"/>‘ያ ጳዉሎስ፣ ህንሶዳትን፤ አት ቄሳር ዱረ ዻበቹ ቀብዳቲ፤ ኩኖ፣ ዋቅን ወረ ስ ወጅን ዴማ ጅረን ሁንደ ጋሩማሳቲን ስት ኬኔረ’ ናን ጄዼ። <verse eid="ACT 27:24"/><verse number="25" style="v" sid="ACT 27:25"/>ከናፍ ያ ጀረነ ጀባዻ! አን አከ ወን ኩን አኩመ ነት ህመሜ ሰነ ተኡ ዋቀ ነንአመናቲ። <verse eid="ACT 27:25"/><verse number="26" style="v" sid="ACT 27:26"/>ተኡስ ብየ ብሻኒን መርፈምቴ ቶኮት ቡኡንኬኘ ህንኦሉ።”<verse eid="ACT 27:26"/></para>
  <para style="s1">ዶኒን ጨጨቡሳ</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27"/>ሀልከን ኩዸ አፉረፋት ኡቱ ገላነ አድርያረ አሲፊ አች ኦፈማ ጅሩ ገረ ሀልከን ወለካት ወር ዶኒረ ሆጄተን ሱን ዋን ገረ ለፋት ዽኣተን ሴአን። <verse eid="ACT 27:27"/><verse number="28" style="v" sid="ACT 27:28"/>እሳን ፉኞ እቲን ገድ ፈጌኘ ገላና እላለን ገድ ቡሰኒ አከ ገላን ሱን ሜትረ ሶዶሚ ቶርበ ገድ ፈጋቱ አርገን፤ ዬሮ ገባባ ቦዴ አመስ ፉኞ ሰነ ገድ ቡሰኒ አከ ገድ ፈጌኝ ገላንቻ ሜትረ ድግደሚ ሰዴት ተኤ አርገን። <verse eid="ACT 27:28"/><verse number="29" style="v" sid="ACT 27:29"/>እሳንስ ከታት ቡነ ጄዸኒ ሶዳተኒ ሂቱ ዶኒ አፉር ዱግደ ዱባን ዶኒራ ገድ ቡሰን። አከ ለፍት በሪቱፍስ ከዸተን። <verse eid="ACT 27:29"/><verse number="30" style="v" sid="ACT 27:30"/>ወር ዶኒረ ሆጄተንስ ብድሩ ኬሳ በቀቹፍ ጄዸኒ ዋን ፉለ ዶኒ ዱራን ሂቱ ዶኒ ቡሰን ፈካተኒ ብድሩ ሰነ ገላነ ኬሰ ቡሰን። <verse eid="ACT 27:30"/><verse number="31" style="v" sid="ACT 27:31"/>ጳዉሎስሞ አጀጃ ዽባቲፊ ሎልቶታን፣ “ዮ ነሞትን ኩኔን ዶኒ ኬሰት ሀፈን መሌ እስን በዲ ኦሉ ህንደንዴሰን” ጄዼ። <verse eid="ACT 27:31"/><verse number="32" style="v" sid="ACT 27:32"/>ከናፉ ሎልቶትን ሱን ፉኞ ብድርች እቲን ህዸሜ ቱሬ ሰነራ ኩተኒ ገላነት ገድ እሼ ዺሰን።<verse eid="ACT 27:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 27:33"/>ገረ በሪ ለፋትስ ጳዉሎስ አከ ነሞትን ሁንድኑ ዋ ኛተኒፍ እሳን ከዸቴ፤ አከነስ ጄዼን፤ “እስን ቡልቲ ኩዸ አፍረን ደርበን ያደኣ፣ ኡቱ ዋ ቶኮሌ ህንኛትን አገቡኬሰን ኦልተኒ ቡልተኒርቱ። <verse eid="ACT 27:33"/><verse number="34" style="v" sid="ACT 27:34"/>ከናፍ አን አከ እስን ዋ ኛተኒፍ እስን ከዸዸ። ኛትን ጅራቹፍ እስን በርባችሳቲ። እስን ኬሳ ነመ ከምዩ ርፌንሰ መታሳ ኬሳ ቶኮዩ ህንበዱቲ።” <verse eid="ACT 27:34"/><verse number="35" style="v" sid="ACT 27:35"/>እንስ ኤርገ ዋን ከነ ዱበቴ ቦዴ ቡዴነ ፉዼ ሁንዱመሳኒ ዱረት ዋቀ ገለቴፈቴ፤ ኩተቴስ ኛቹ ጀልቀቤ። <verse eid="ACT 27:35"/><verse number="36" style="v" sid="ACT 27:36"/>እሳን ሁንድኑ ጀጀባተኒ ኦፉማን ዋ ኛተን። <verse eid="ACT 27:36"/><verse number="37" style="v" sid="ACT 27:37"/>ወሉመት ኑ ነመ 276 ታኔ ዶኒ ሰነ ኬሰ ቱሬ። <verse eid="ACT 27:37"/><verse number="38" style="v" sid="ACT 27:38"/>እሳንስ ኤርገ ኛተኒ ቁፈኒ ቦዴ ቀመዲ ፌአሜ ቱሬ ሰነ ገላነት ነቀኒ አከ ዶኒን ሰልጰቱ ጎዸን።<verse eid="ACT 27:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 27:39"/>እሳንስ ዮሙ ለፍት በሪቴት ገሎ ገላና ከን ኩፈመ ጭረቻ ቀቡ ቶኮ አርገን መሌ ብይ ፉለሳኒ ዱረ ጅሩ ሱን ኤሰ አከ ተኤ ህንሁበትኔ፤ ዶኒ ሰነስ ዮ እሳኒ ደንደአሜ ዺበኒ ቀርቀረ ገላናት ባሱ ሙርቴሰን። <verse eid="ACT 27:39"/><verse number="40" style="v" sid="ACT 27:40"/>ከናፉ ፉኞ ሂቱ ዶኒ ኩተኒ ገላነ ኬሰት ገድ ዺሰን፤ ዬሩመ ሰነ ፉኞ በቶን እቲን ህዸሜ ሰነ ሂከን፤ ኤርገሲስ ሸራ ከራ ፉለ ዶኒ ዱራን ጅሩ ሰነ ቅሌንሰት ኦል ፉዸኒ ገረ ኩፈመ ጭረቻት ቀጄለን። <verse eid="ACT 27:40"/><verse number="41" style="v" sid="ACT 27:41"/>ገሩ ዶኒን ሱን እዶ እት ገላን ለመ ወል ገኡት ትመ ጭረቻት ቡኤ ለፈ ቱቄ። መታንሳ አችት ቀበሜ ሶቾኡ ድዴ፤ ዱግደ ዱብንሳሞ ሁምነ ዸኣ ገላናቲን ዸአሜ ጨጨቤ።<verse eid="ACT 27:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 27:42"/>ሎልቶትንስ አከ ወረ ህዸመን ሰነ ኬሳ ነምን ቶኮዩ ብሻን ዳኬ በቀቴ ጀላ ህንባኔፍ እሳን አጄሱፍ ከሮርፈተን። <verse eid="ACT 27:42"/><verse number="43" style="v" sid="ACT 27:43"/>ገሩ አጀጃን ዽባ ሱን ዋን ጳዉሎስን ዱአ ኦልቹ ፌዼፍ አከ እሳን ዋን ከሮርፈተን ሰነ ህንጎኔ ዾዌ፤ እንስ አከ ወር ብሻን ዳኩ ደንደአን ዱራን ዱርሰኒ ዶኒራ ኡታለኒ ገረ ለፋት በአን አጀጄ። <verse eid="ACT 27:43"/><verse number="44" style="v" sid="ACT 27:44"/>አከ ወር ሀፈንሞ ሳንቃ ዮካን ጨጨባ ዶኒቲን አች ገአን አጀጄ፤ ሃለ ከናን ሁንድሳኒ ነጋን ለፈት በአን።<verse eid="ACT 27:44"/></para>
  <chapter eid="ACT 27"/>
  <chapter number="28" style="c" sid="ACT 28"/>
  <para style="s1">ጳዉሎስ መላጥያ ገኡሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1"/>ኑስ ነጉማን ቀርቀረ ገላናት ባኔ አከ ብይ ብሻኒን መርፈምቴ ሱን መላጥያ ጄዸምቱ ቤክኔ። <verse eid="ACT 28:1"/><verse number="2" style="v" sid="ACT 28:2"/>ነሞትን ብየ ብሻኒን መርፈምቴ ሰነረ ጅራተንስ ገረ ላፍነ ድንቅሲሳ ኑ አርግሲሰን። እሳንስ ሰበቢ ሮብኒፊ ዻሞች ቱሬፍ እብደ ቦቤሰኒ ሁንደኬኘ ስመተን። <verse eid="ACT 28:2"/><verse number="3" style="v" sid="ACT 28:3"/>ኡቱ ጳዉሎስ ሀንጠጢ ቆራኒ ወልት ቀቤ እብደት ነቃ ጅሩ ቡቲን ሰበቢ ሆኣቲን ገድ ባቴ ቶኮ ሀርከሳት መጠንቴ ገድ ዺሱ ድዴ። <verse eid="ACT 28:3"/><verse number="4" style="v" sid="ACT 28:4"/>ወር ብየ ብሻኒን መርፈምቴ ሰነረ ጅራተን ሱንስ ቡቲ ሀርከሳት ረራቱ አርገኒ፣ “ነምች ኩን ነመ ነመ አጄሴ ተኡ ህንኦሉ፤ እን ዮ በላ ገላና ጀላ በኤሌ ሙርቲን ቀጄላን አከ እን ጅራቱ ህንኤየምኔፍ” ወሊን ጄዸን። <verse eid="ACT 28:4"/><verse number="5" style="v" sid="ACT 28:5"/>ጳዉሎስ ቡቲ ሰነ እብደ ኬሰ ኦፍራ ቡሴ፤ ሚዻ ቶኮ መሌስ ሀፌ። <verse eid="ACT 28:5"/><verse number="6" style="v" sid="ACT 28:6"/>ነሞትን ሱንስ፣ “እን ንዺተአ ዮካን አኩመ ተሳ ኩፌ ዱአ” ጄዸኒ ኤገን፤ ገሩ ዮሙ ዬሮ ዼራ ኤገኒ አከ እን ዋ ቶኮሌ ህንተእን አርገንት ያደ ጌደረተኒ፣ “እን ዋቀ” ጄዸን።<verse eid="ACT 28:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 28:7"/>ቡልቻን ጱብልዮስ ጄዸሙ ቶኮስ ናኖ ሰና ለፈ ቆቲሳ ቀበ ቱሬ፤ እንስ መነሳት ኑ ስመቴ ጉያ ሰዲ ጃለላን ኑ ኬሱምሲሴ። <verse eid="ACT 28:7"/><verse number="8" style="v" sid="ACT 28:8"/>አባን ጱብልዮስ ዹኩበ ዸግነ ነመ ጉቡፊ ገራ ነመ ካሱን ቀበሜ ጪሳ ቱሬ፤ ጳዉሎስስ እሰ ጋፈቹፍ ኦል ሴኔ ኤርገ ከዸቴ ቦዴ ሀርከረ ካኤ እሰ ፈይሴ። <verse eid="ACT 28:8"/><verse number="9" style="v" sid="ACT 28:9"/>ዮሙ ወን ኩን ተኤት ዹኩብሰቶትን ብየ ብሻኒን መርፈምቴ ሰነረ ጅራተን ብራ ሁንድ ዹፈኒ ፈየን። <verse eid="ACT 28:9"/><verse number="10" style="v" sid="ACT 28:10"/>እሳንስ ከራ ባይኤዻን ኡልፍነ ኑ ኬነን፤ ዮሙ ኑ ዶኒዻን ዴሙፍ ካኔትስ ዋን ኑ በርባችሱ ሁንደ ኑፍ ኬነን።<verse eid="ACT 28:10"/></para>
  <para style="s1">ጳዉሎስ ሮማ ገኤ</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11"/>ኑስ ጅአ ሰዲ ቦዴ ዶኒ እስክንድርያ ከን ብየ ብሻኒን መርፈምቴ ሰነረት ዬሮ ገና ደበርሴ ቶኮን ካኔ ዴምሰ ጀልቀብኔ፤ ዶኒን ሱንስ አስጣ ዋቆተ ለኩ ከስቶሪፊ ፓሉክስ አደሳራ ቀበ ቱሬ። <verse eid="ACT 28:11"/><verse number="12" style="v" sid="ACT 28:12"/>ሰራኩስ ጌኜስ ቡልቲ ሰዲ አች ቱሬ። <verse eid="ACT 28:12"/><verse number="13" style="v" sid="ACT 28:13"/>አቺስ ካኔ ሬግዩምት ገሌ፤ ጉያ ቶኮ ቦዴስ ዋን ቡቤን ክባ ቡብሴፍ ጉያ እት ኣኑት ፑትዮሉስ ጌኜ። <verse eid="ACT 28:13"/><verse number="14" style="v" sid="ACT 28:14"/>አችት ኦቦሎተ ቶኮ ቶኮ አርገትኔ፤ እሳንስ አከ ኑ ቡልቲ ቶርበ እሳን ብረ ቱሩ ኑ ከዸተን። ኑስ አከሲን ሮማት ገሌ። <verse eid="ACT 28:14"/><verse number="15" style="v" sid="ACT 28:15"/>ኦቦሎትን አች ቱረንስ ዮሙ ዹፋቲኬኘ ዸገአንት ሀመ እዶ ገባ አጵዩሲቲፊ እዶ “ለፈ ቡልቶ ሰዲ” ጄዸሙት ኑ ስመቹ ዹፈን፤ ጳዉሎስስ እሳን አርጌ ዋቀ ገለቴፈቴ፤ ኦፊሳቲስ ንጀጀባቴ። <verse eid="ACT 28:15"/><verse number="16" style="v" sid="ACT 28:16"/>ዮሙ ኑ ሮማ ጌኜት ጳዉሎስ አከ ሎልቱ እሰ ኤጉ ቶኮ ወጅን ኮጳሳ ጅራቱ ኤየመሜፍ።<verse eid="ACT 28:16"/></para>
  <para style="s1">ጳዉሎስ ኤጉምሰ ጀለት ሮማት ለለቡሳ</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 28:17"/>ጳዉሎስስ ጉያ ሰዲ ቦዴ ዱረ ቡኦተ ይሁዶታ ወልት ዋሜ፤ ዮሙ እሳን ወልት ቀበመንትስ አከነ ጄዼን፤ “ያ ኦቦሎተኮ፣ አን ኡቱ ዋን ሰበኬኛን ዮካን ዱዻ አቦቲኬኛቲን ሞርሙ ቶኮሌ ህንሆጄትን ዬሩሳሌም ኬሰት ቀበሜ ደበርፈሜ ሀርከ ወረ ሮማት ኬነሜረ። <verse eid="ACT 28:17"/><verse number="18" style="v" sid="ACT 28:18"/>እሳንስ ኤርገ ነ ቆረኒ ቦዴ ሰበቢ አን የከ ዱአ ነመት ሙርሲሱ ቶኮሌ ህንቀባትኒፍ ገድ ነ ዺሱ በርባደን። <verse eid="ACT 28:18"/><verse number="19" style="v" sid="ACT 28:19"/>አን ገሩ ዮ ዋን እቲን ሰበኮ ህመዹ ቶኮዩ ህንቀባትንሌ ዮሙ ይሁዶትን ሞርመንት አከ ቄሳርት ኦል እየዹ ነንድርቀሜ። <verse eid="ACT 28:19"/><verse number="20" style="v" sid="ACT 28:20"/>ወን አን እስን አርጉፊ እስን ወጅን ሃሰኡ ከዸዼፍስ ከኑመ። አን ሰበቡመ አብዲ እስራኤሊፍ ጄዼ ፎንጫ ከናን ህዸሜ ጅረ።”<verse eid="ACT 28:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 28:21"/>እሳንስ አከነ ጄዸኒ ዴብሰን፤ “ኑ ጠለያ ዋኤኬ ዱበቱ ቶኮሌ ብየ ይሁዳቲ ህንአርገትኔ፤ ኦቦሎተ አቺ ዹፈን ኬሳስ ነምን ቶኮዩ ዋኤኬ ዋን ሀማ ህንዱበትኔ፤ ኑትስ ህንህምኔ። <verse eid="ACT 28:21"/><verse number="22" style="v" sid="ACT 28:22"/>ኑ ገሩ ያድንኬ ማል አከ ተኤ ስራ ዸገኡ በርባድነ፤ ኑ አከ ነሞትን እዶ ሁንደ ጅረን ገሬ ከናን ሞርመን ንቤክናቲ።”<verse eid="ACT 28:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23"/>እሳንስ ጉያ እት ጳዉሎስ ወጅን ወል አርገን ቀበተኒ፣ አከ መሌ ባይአተኒ ለፈ እን ጅራቻ ቱሬ ዸቀን፤ እንስ ገነማ ጀልቀቤ ሀመ ገልገላት ዋኤ ሞቱማ ዋቃ እሳኒ እብሳ፣ ለለባስ ቱሬ፤ ዋኤ ዬሱሲስ ሴረ ሙሴቲፊ ክታቦተ ራጆታ ኬሳ ኤሬ እሳን አመንሲሱ ያላ ቱሬ። <verse eid="ACT 28:23"/><verse number="24" style="v" sid="ACT 28:24"/>እሳን ኬሳ ወር ቶኮ ቶኮ ዋን እን ጄዼ ንፉዸተን፤ ወር ካንሞ አመኑ ድደን። <verse eid="ACT 28:24"/><verse number="25" style="v" sid="ACT 28:25"/>እሳን ግዱት ወልዸቢስን ኡመምናን ከአኒ ዴሙ ጀልቀበን፤ ኩንስ ኤርገ ጳዉሎስ አከነ ጄዼ ዱቢ ዹማ ዱበቴ ቦዴ፤ ሀፉር ቁልቁሉን ዬሮ ከራ እሳያስ ራጅቻቲን አቦቲኬሰንት ዱበቴ ሰነ ዹጋሳ ዱበቴ፤ እንስ አከነ ጄዼ፦<verse eid="ACT 28:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 28:26"/>“ ‘ገረ ሰበ ከና ዸቂቲ አከነ ጄዽ፤</para>
  <para style="q1" vid="ACT 28:26">“ዸገኡ እኑመ ዸጌሱ፤ ገሩ ህንሁበተን፤</para>
  <para style="q2" vid="ACT 28:26">እላሉስ እኑመ እላልቱ፤ ገሩ ህንቀልቤፈተን።”<verse eid="ACT 28:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 28:27"/>ቀልቢን ሰበ ከና ዶሜራቲ፤</para>
  <para style="q2" vid="ACT 28:27">ጉርሳኒ ስሪት ህንዸገኡ፤</para>
  <para style="q2" vid="ACT 28:27">እጀሳኒስ ዱኑንፈተኒሩ፤</para>
  <para style="q1" vid="ACT 28:27">ኡቱ አከስ ተኡ ባቴ ስላ እጀሳኒቲን አርገኒ፣</para>
  <para style="q2" vid="ACT 28:27">ጉረሳኒቲን ዸገአኒ፣</para>
  <para style="q2" vid="ACT 28:27">ቀልቢሳኒቲንስ ሁበተኒ፣</para>
  <para style="q1" vid="ACT 28:27">ንዴብኡ ቱረን፤ አንስ እሳን ነንፈይሰ ቱሬ።’<note caller="+" style="f"><char style="fr" closed="false">28፥27 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 6:9">እሳ 6፥9</ref>፣<ref loc="ISA 6:10">10</ref></char></char></note><verse eid="ACT 28:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 28:28"/>“ከናፉ አን አከ ፈይሱን ዋቃ ገረ ነሞተ ኦርማት ኤርገሜ አከ እስን ቤክተን ነንበርባደ! እሳንስ ንዸገኡ።” [ <verse eid="ACT 28:28"/><verse number="29" style="v" sid="ACT 28:29"/>ይሁዶትንስ ኤርገ እን ዋን ከነ ዱበቴ ቦዴ ጀቤሰኒ ወሊን ሞርማ አቺ ዴመን።]<note caller="+" style="f"><char style="fr" closed="false">28፥29 </char><char style="ft" closed="false">ሂካወን ዱሪ ቶኮ ቶኮ ሉቅሳ ከነ ህንቀበን።</char></note><verse eid="ACT 28:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 28:30"/>ጳዉሎስስ ወጋ ለመ ጉቱ መነ ኦፊሳቲ ክሬፈቴ ኬሰ ጅራቻ፣ ወረ እሰ ዱብሱ ዹፈን ሁንደስ ስመቻ ቱሬ። <verse eid="ACT 28:30"/><verse number="31" style="v" sid="ACT 28:31"/>እንስ እጀ ጀብናን፣ ጉፉ ቶኮ መሌስ ሞቱማ ዋቃ ለለባ፣ ዋኤ ጎፍታ ዬሱስ ክርስቶስስ በርሲሳ ቱሬ።<verse eid="ACT 28:31"/></para>
  <chapter eid="ACT 28"/>
</usx>
