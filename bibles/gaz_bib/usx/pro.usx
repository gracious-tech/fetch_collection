<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PRO" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">ፈኬኘ</para>
  <para style="toc1">ክታበ ፈኬኛ</para>
  <para style="toc2">ፈኬኘ</para>
  <para style="toc3">ፈኬ</para>
  <para style="mt2">ክታበ</para>
  <para style="mt1">ፈኬኛ</para>
  <chapter number="1" style="c" sid="PRO 1"/>
  <para style="ms1">ካዮ እጆ ዱቢ ክታብቻ</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1"/>ፈኬኘ ሶሎሞን እልመ ዳዊት፣ ሞቲ እስራኤል፦<verse eid="PRO 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 1:2"/>ኦጉማፊ ቀጄልፈመ ቀባቹዻፍ፣</para>
  <para style="q2" vid="PRO 1:2">ዱቢ ቤኩምሰ ጉዳ ሁበቹዻፍ፤<verse eid="PRO 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 1:3"/>ኦጉማዻን ጅራቹዻን፣ ቀጄሉማዻን፣</para>
  <para style="q2" vid="PRO 1:3">ሙርቲ ቀጄላ ኬኑፊ ነመ ወል ቅጤሱዻን <optbreak/> ቀጄልፈመ አርገቹዻፍ፤<verse eid="PRO 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 1:4"/>ወረ ዋ ህንቤክኔፍ ኦፍ ኤገትኖ ኬኑዻፍ፣</para>
  <para style="q2" vid="PRO 1:4">ደርገጎታፍሞ ቤኩምሳፊ ሁበትና ኬኑዻፍ፣<verse eid="PRO 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 1:5"/>ኦጌዪን ዸጌፈተኒ በሩምሰሳኒረት ዋ ሃደበለተን፤</para>
  <para style="q2" vid="PRO 1:5">ወር ቀልቢ ቀበንስ ቀጄልፈመ ሃአርገተን፤<verse eid="PRO 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 1:6"/>ኩንስ ፈኬኛፊ ሂካ፣</para>
  <para style="q2" vid="PRO 1:6">ጄቻፊ ህቦ ኦጌዪ ሁበቹዻፍ።<verse eid="PRO 1:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 1:7"/>
    <char style="nd">ዋቀዮን</char> ሶዳቹን ጀልቀበ ኦጉማት፤</para>
  <para style="q2" vid="PRO 1:7">ጎዎትን ገሩ ኦጉማፊ አደበሙ ቱፈቱ።<verse eid="PRO 1:7"/></para>
  <para style="ms1">ጎርሰ አከ ነምን ኦጉማ አርገቱፍ ኬነሜ</para>
  <para style="s1">ጎዎምፈሙራ ኦፍ ኤጉ</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 1:8"/>ያ እልመኮ፣ ጎርሰ አባኬቲ ዸጌፈዹ፤</para>
  <para style="q2" vid="PRO 1:8">በርሲሰ ሃዸኬቲሌ ህንገትን።<verse eid="PRO 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 1:9"/>ወን ኩን መታኬ ሚዸግሱዻፍ ጎንፎ፣</para>
  <para style="q2" vid="PRO 1:9">ሞርመኬ በሬቹዻፍሞ ፋየ ሲፍ ተአ።<verse eid="PRO 1:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 1:10"/>ያ እልመኮ፣ ዮ ጩበሞትን ሶሶበኒ</para>
  <para style="q2" vid="PRO 1:10">ኦፍት ስ ሀርክሰን፣ ቶሌ ህንጄዽኒፍ።<verse eid="PRO 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 1:11"/>ዮ እሳን፣ “ኑ ወጅን ኮቱ፤</para>
  <para style="q2" vid="PRO 1:11">ርጵኔ ዺገ ነማ ዸንገላስና፤</para>
  <para style="q2" vid="PRO 1:11">ነመ በሌሳ ህንቀብኔ ገላፈቹዻፍስ <optbreak/> ዾከትኔ ኤገትና፤<verse eid="PRO 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 1:12"/>ኮቱ አኩመ አዋላ ጅራት እሳን ልቅምስና፤</para>
  <para style="q2" vid="PRO 1:12">አኩመ ወረ ቦለ ኬሰ ቡፈመኒስ</para>
  <para style="q2" vid="PRO 1:12">ጉቱማን ጉቱት እሳን ልቅምስና፤<verse eid="PRO 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 1:13"/>ኑ ዋን ገቲ ቀቡ ከን ጎሰ ሁንዳ ንአርገትነ፤</para>
  <para style="q2" vid="PRO 1:13">መኔንኬኘሌ ቦጁዻን ጉተትነ፤<verse eid="PRO 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 1:14"/>እጣኬ ኑ ወጅን ቡፈዹ፤</para>
  <para style="q2" vid="PRO 1:14">ኑስ ኮሮጆ ቶኮ ስ ወጅን ቆደትና” ሲን ጄዸን፣<verse eid="PRO 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 1:15"/>ያ እልመኮ፣ አት እሳን ወጅን ህንዴምን፤</para>
  <para style="q2" vid="PRO 1:15">ሚለኬቲን ከራሳኒረሌ ህንኤጄትን፤<verse eid="PRO 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 1:16"/>ሚልሳኒ ጩቡት አሪፈታቲ፤</para>
  <para style="q2" vid="PRO 1:16">እሳን ዺገ ዸንገላሱፍ ጀርጀሩ።<verse eid="PRO 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 1:17"/>ኡቱመ ስምብሮትን ሁንድ አርገኑ፣</para>
  <para style="q2" vid="PRO 1:17">ክዮ ቡሱን ዋን ገቲ ህንቀብኔዸ!<verse eid="PRO 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 1:18"/>ነሞትን ኩኔን ዺጉመ ኦፊሳኒ ርጰኒ ኤገቱ፤</para>
  <para style="q2" vid="PRO 1:18">ሉቡመ ኦፊሳኒ ጋዱ!<verse eid="PRO 1:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 1:19"/>ኩን ዹመ ወረ ቀቤኘ ከራ ሀማዻን አርገሙ ዱካ ቡአን ሁንዳት፤</para>
  <para style="q2" vid="PRO 1:19">ወን አከሲ ጅሬኘ ወረ እሰ አርገተኒ በሌሰ።<verse eid="PRO 1:19"/></para>
  <para style="s1">አኬከቺሰ ኦጉማ ቱፈቹረት ኬነሜ</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 1:20"/>ኦጉማን ከራረት ጉድፍቴ እይት፤</para>
  <para style="q2" vid="PRO 1:20">እዶ ወል ገኢ ኡመታትስ ሰገሌሼ ኦል ፉዸት።<verse eid="PRO 1:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 1:21"/>እሼን ፊጤ ዳንዲራ እይት፤</para>
  <para style="q2" vid="PRO 1:21">ከረ መጋላ ዱራስ አከነ ጄቴ ዱበት፦<verse eid="PRO 1:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 1:22"/>“እስን ወር ሆማ ህንቤክኔ</para>
  <para style="q2" vid="PRO 1:22">ኩን ሀመ ዮሚት ከራኬሰን ከን ፋይዳ ህንቀብኔ ሰነ ጃለቱ?</para>
  <para style="q1" vid="PRO 1:22">ወር ነመት ቆሰን ሀመ ዮሚት ቆሳ ሰነት ገመደኒ</para>
  <para style="q2" vid="PRO 1:22">ጎዎትንስ ቤኩምሰ ጅቡ?<verse eid="PRO 1:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 1:23"/>ሞርሚኮ ቀልቤፈዻ፤</para>
  <para style="q2" vid="PRO 1:23">አን ያደኮ እስኒ ነንዸንገላሰ፤</para>
  <para style="q2" vid="PRO 1:23">ዱቢኮስ እስኒፍን እብሰ።<verse eid="PRO 1:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 1:24"/>ገሩ ሰበቢ እስን ዬሮ አን እስን ዋሜት ድደኒ</para>
  <para style="q2" vid="PRO 1:24">ዬሮ አን ሀርከ በልእፈዼት ነምን ቶኮዩ ነ ህንዸጌፈትኒፍ፣<verse eid="PRO 1:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 1:25"/>ዋን እስን ጎርሰኮ ሁንደ ቱፈተኒ</para>
  <para style="q2" vid="PRO 1:25">ዼከምሰኮ ዸገኡ ድደኒፍ፣<verse eid="PRO 1:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 1:26"/>አንስ በዲሰኬሰንት ነንኮልፈ፣</para>
  <para style="q2" vid="PRO 1:26">ዬሮ በላን እስንት ዹፉትስ ነንቆሰ፤<verse eid="PRO 1:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 1:27"/>ዬሮ በላን አኩመ ቡቤት እስን ፉዸቱት፣</para>
  <para style="q2" vid="PRO 1:27">ዬሮ በዲስን አኩመ ቡቤ ሀማት እስን ሀጣኡት፣</para>
  <para style="q2" vid="PRO 1:27">ዬሮ ዽጵናፊ ረክን እስንት ዹፉት አን እስንተን ቆሰ።<verse eid="PRO 1:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 1:28"/>“ዬሮ ሰነ እሳን ነ ዋመቱ፤ አን ገሩ እሳን ጀላ ህንኦዋዹ፤</para>
  <para style="q2" vid="PRO 1:28">እሳን ነ በርባዱ፤ ገሩ ነ ህንአርገተን።<verse eid="PRO 1:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 1:29"/>እሳን ዋን ቤኩምሰ ጅበኒ</para>
  <para style="q2" vid="PRO 1:29">
    <char style="nd">ዋቀዮን</char> ሶዳቹሌ ፍለቹ ድደኒፍ፣<verse eid="PRO 1:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 1:30"/>ዋን ጎርሰኮ ፉዸቹ ድደኒ</para>
  <para style="q2" vid="PRO 1:30">ዼከምሰኮስ ቱፈተኒፍ፣<verse eid="PRO 1:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 1:31"/>እሳን ገቲ ከራሳኒ ንኛቱ፤</para>
  <para style="q2" vid="PRO 1:31">ቡኣ ጀልእነሳኒስ ንቁፉ።<verse eid="PRO 1:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 1:32"/>ጎዎተ ዋ ደገቹቱ እሳን በሌሳቲ፤</para>
  <para style="q2" vid="PRO 1:32">ቁፍን ጎዎታ እሳኑመ በሌሰ፤<verse eid="PRO 1:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 1:33"/>ነምን ነ ዸጌፈቱ ከምዩ ገሩ ነጋዻን ጅራተ፤</para>
  <para style="q2" vid="PRO 1:33">እን ቀበናን ጅራተ፤ ወን ሀማንስ እሰ ህንሶዳችሱ።”<verse eid="PRO 1:33"/></para>
  <chapter eid="PRO 1"/>
  <chapter number="2" style="c" sid="PRO 2"/>
  <para style="s1">በዻሰ ኦጉማ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 2:1"/>ያ እልመኮ፣ ዮ አት ዱቢኮ ፉዸቴ</para>
  <para style="q2" vid="PRO 2:1">አጀጀኮስ ኦፍ ኬሰት ኩፈቴ፣<verse eid="PRO 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 2:2"/>ዮ አት ጉረኬ ኦጉማት ገረገልፈቴ</para>
  <para style="q2" vid="PRO 2:2">ያደኬ ሁበትናት ዴብፈቴ፣<verse eid="PRO 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 2:3"/>ዮ አት ጀባቴ ቀልቤፈትና በርባዴ</para>
  <para style="q2" vid="PRO 2:3">ሁበትና አርገቹፍ ጄቴ እይቴ ከዸቴ፣<verse eid="PRO 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 2:4"/>ዮ አት አኩመ ሜቲት እሰ በርባደቴ</para>
  <para style="q2" vid="PRO 2:4">አኩመ ቀቤኘ ዾክፈሜት እሰ በርባዴ፣<verse eid="PRO 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 2:5"/>አት <char style="nd">ዋቀዮን</char> ሶዳቹ ንሁበተ፤</para>
  <para style="q2" vid="PRO 2:5">ዋቀ ቤኩስ ንአርገተ።<verse eid="PRO 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 2:6"/>
    <char style="nd">ዋቀዮ</char> ኦጉማ ነማ ኬናቲ፤</para>
  <para style="q2" vid="PRO 2:6">አፋንሳ ኬሳሌ ቤኩምሳፊ ሁበትናቱ በአ።<verse eid="PRO 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 2:7"/>እን ቀጄልቶታፍ ኦጉማ ዹጋ ኩሰ፤</para>
  <para style="q2" vid="PRO 2:7">ወረ አዴምስሳኒ ሙዳ ህንቀብኔፍ ጋቸነ፤<verse eid="PRO 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 2:8"/>እን ዳንዲ ቶሎታ ንኤገ፤</para>
  <para style="q2" vid="PRO 2:8">ከራ ቁልቁሎተሳሌ ንትክሰ።<verse eid="PRO 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 2:9"/>ኤርገሲ አት ቀጄሉማፊ ሙርቲ ቀጄላ፣</para>
  <para style="q2" vid="PRO 2:9">ነመ ወል ቅጤሱ፣ ከራ ቀጄላ ሁንደስ ንሁበተ።<verse eid="PRO 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 2:10"/>ኦጉማን ገራኬ ሴነ፤</para>
  <para style="q2" vid="PRO 2:10">ቤኩምስስ ሉቡኬ ገመቺሰ።<verse eid="PRO 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 2:11"/>ቀልቤፈናን ስ ኤገ፤</para>
  <para style="q2" vid="PRO 2:11">ሁበትናንስ ስ ትክሰ።<verse eid="PRO 2:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 2:12"/>ኦጉማን ከራ ሀሞታራ፣</para>
  <para style="q2" vid="PRO 2:12">ነሞተ ደበ ዱበተን ጀላስ ስ በራረ፤<verse eid="PRO 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 2:13"/>ወረ ከራ ዱከናረ ዴሙዻፍ ጄዸኒ</para>
  <para style="q2" vid="PRO 2:13">ዳንዲ ቀጄላ ዺሰን፣<verse eid="PRO 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 2:14"/>ወረ ዋን ሀማ ሆጄቹት ገመደን፣</para>
  <para style="q2" vid="PRO 2:14">ወረ ጀልእነ ሆጄቹን እት ቶሉ፣<verse eid="PRO 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 2:15"/>ወረ ዳንዲንሳኒ ጀልአቴ፣</para>
  <para style="q2" vid="PRO 2:15">ወረ ከራንሳኒ ደቤ ጀላ ስ በራረ።<verse eid="PRO 2:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 2:16"/>ኦጉማቱ ዱበርቲ ገንደ ለቤ፣</para>
  <para style="q2" vid="PRO 2:16">ኒቲ ዱቢዻን ሶሶብዴ ኦፍት ነመ ሀርክፍቱ ጀላ ስ በራረ፤<verse eid="PRO 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 2:17"/>ኒቲ ዽርሰሼ ከን ጀልቀባ ዺፍቴ</para>
  <para style="q2" vid="PRO 2:17">ከኩ ፉለ ዋቃ ዱረት ገልቴ ሰነ ደገቴ ጀላ ስ በራረ።<verse eid="PRO 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 2:18"/>መንሼ ገረ ዱኣት፣ ከራንሼሞ</para>
  <para style="q2" vid="PRO 2:18">ገረ ሀፉሮተ ወረ ዱአኒት ነመ ጌሳቲ።<verse eid="PRO 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 2:19"/>ነምን ገረሼ ዸቁ ቶኮዩ ህንዴብኡ</para>
  <para style="q2" vid="PRO 2:19">ዮካን ከራ ጅሬኛ ህንአርገቱ።<verse eid="PRO 2:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 2:20"/>ከናፉ አት ከራ ነሞተ ገጋሪረ ንዴምተ፤</para>
  <para style="q2" vid="PRO 2:20">ዳንዲ ቀጄልቶታራስ ህንጀልአቱ።<verse eid="PRO 2:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 2:21"/>ቶሎን ብየቲ ኬሰ ንጅራቱቲ፤</para>
  <para style="q2" vid="PRO 2:21">ወር ሙዳ ህንቀብኔስ አች ኬሰ ጅራቱ፤<verse eid="PRO 2:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 2:22"/>ሀሞን ገሩ ብየቲ ኬሳ ንበሌፈሙ፤</para>
  <para style="q2" vid="PRO 2:22">ወር ህንአመነምኔስ እሼ ኬሳ ቡቅፈሙ።<verse eid="PRO 2:22"/></para>
  <chapter eid="PRO 2"/>
  <chapter number="3" style="c" sid="PRO 3"/>
  <para style="s1">ኤበ ኦጉማ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 3:1"/>ያ እልመኮ፣ በሩምሰ አን ሲፍ ኬኑ ህንደገትን፤</para>
  <para style="q2" vid="PRO 3:1">አጀጀኮስ ገራት ቀበዹ፤<verse eid="PRO 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 3:2"/>እሳን በረ ባይኤፊ ኡሙሪ ዼራ፣</para>
  <para style="q2" vid="PRO 3:2">ነጋፊ በዻዹማ ሲፍ ደበሉቲ።<verse eid="PRO 3:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 3:3"/>ጃለሊፊ አመነሙማን ዮምዩ ስራ ህንፈጋትን፤</para>
  <para style="q2" vid="PRO 3:3">ሞርመኬት ህዸዹ፤</para>
  <para style="q2" vid="PRO 3:3">ገበቴ ገራኬረትስ በሬፈዹ።<verse eid="PRO 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 3:4"/>አት ከራ ከናን ፉለ ዋቃቲፊ</para>
  <para style="q2" vid="PRO 3:4">ፉለ ነማ ዱረት ሱራፊ መቃ ጋሪ ንአርገተ።<verse eid="PRO 3:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 3:5"/>ገራኬ ጉቱን <char style="nd">ዋቀዮን</char> አመነዹ፤</para>
  <para style="q2" vid="PRO 3:5">ሁበትናኬስ ህንአብደትን፤<verse eid="PRO 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 3:6"/>ከራኬ ሁንደ ኬሰት እሰ ዱርስ፤</para>
  <para style="q2" vid="PRO 3:6">እንስ ዳንዲኬ ሲፍ ቀጄልቸ።<verse eid="PRO 3:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 3:7"/>አን ኦጌሰ ኦፊን ህንጄዽን፤</para>
  <para style="q2" vid="PRO 3:7">
    <char style="nd">ዋቀዮን</char> ሶዳዹ፤ ዋን ሀማራስ ፈጋዹ።<verse eid="PRO 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 3:8"/>ወን ኩን ዸግነኬቲፍ ፈያ ኬነ፤</para>
  <para style="q2" vid="PRO 3:8">ለፌኬሌ ንሃሮምሰ።<verse eid="PRO 3:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 3:9"/>ቀቤኘኬቲን፣</para>
  <para style="q2" vid="PRO 3:9">መታ ምዻንኬቲ ሁንዳንስ <char style="nd">ዋቀዮን</char> ከበጅ፤<verse eid="PRO 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 3:10"/>ዮስ ጎምብሳንኬ ሀመ እራን ዸንገለኡት ጉተመ፤</para>
  <para style="q2" vid="PRO 3:10">እዶን ጩንፋ ወይኒኬቲስ <optbreak/> ዳዺዻን ጉተሜ እራን ዸንገለአ።<verse eid="PRO 3:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 3:11"/>ያ እልመኮ፣ አደቢ <char style="nd">ዋቀዮ</char> ህንቱፈትን፤</para>
  <para style="q2" vid="PRO 3:11">ዼከምሰሳስ ህንጅብን።<verse eid="PRO 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 3:12"/>
    <char style="nd">ዋቀዮ</char> አኩመ አባ እልመ ኦፊሳ ጃለቱ ቶኮት</para>
  <para style="q2" vid="PRO 3:12">ወረ ጃለቱ ንአደባቲ።<verse eid="PRO 3:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 3:13"/>ነምን ኦጉማ አርገቱ</para>
  <para style="q2" vid="PRO 3:13">ከን ሁበትናስ አርገቱ ኤብፈማዸ፤<verse eid="PRO 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 3:14"/>ኦጉማን ሜቲ ጫላ ፋይዳ ቀባቲ፤</para>
  <para style="q2" vid="PRO 3:14">ወርቄ ጫላስ ቡኣ ነማፍ ቡሰ።<verse eid="PRO 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 3:15"/>ገቲንሼ ገቲ ሉለ ዲማ ጫለ፤</para>
  <para style="q2" vid="PRO 3:15">ወን አት አከ መሌ ሀውቱ ከምዩ እሼዻን ወል ቅጣቹ ህንደንደኡ።<verse eid="PRO 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 3:16"/>ጅሬኝ ዼራን ሀርከሼ ምርጋ ኬሰ ጅረ፤</para>
  <para style="q2" vid="PRO 3:16">በዻዹማፊ ኡልፍን ሀርከሼ ብታ ኬሰ ጅሩ።<verse eid="PRO 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 3:17"/>ከራንሼ ከራ ነመ ገመቺሱዸ፤</para>
  <para style="q2" vid="PRO 3:17">ዳንዲንሼ ሁንድስ ነጋዸ።<verse eid="PRO 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 3:18"/>እሼን ወረ ጀቤሰኒ እሼ ቀበተኒፍ ሙከ ጅሬኛት፤</para>
  <para style="q2" vid="PRO 3:18">ወር እት ጭቸኒ እሼ ቀበተንሞ ንኤብፈሙ።<verse eid="PRO 3:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 3:19"/>
    <char style="nd">ዋቀዮ</char> ኦጉማዻን ሁንዴ ለፋ ቡሴ፤</para>
  <para style="q2" vid="PRO 3:19">ሁበትናዻንስ ሰሚወን እዶሳኒ ካኤ፤<verse eid="PRO 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 3:20"/>ቤኩምሰሳቲን ቱጁበወን ገርገር ቆደመን፤</para>
  <para style="q2" vid="PRO 3:20">ዱሜሶንስ ፍጤንሰ ጮጮብሰን።<verse eid="PRO 3:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 3:21"/>ያ እልመኮ ኦጉማፊ ሁበትና ዹጋ ኤገዹ፤</para>
  <para style="q2" vid="PRO 3:21">እሳንስ ፉለኬ ዱራ ህንዸበምን፤<verse eid="PRO 3:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 3:22"/>እሳን ጅሬኘ ሲፍ ተኡ፤</para>
  <para style="q2" vid="PRO 3:22">ሞርመኬ ሚዸግሱፍስ ፋየ ሞርማ ሲፍ ተኡ።<verse eid="PRO 3:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 3:23"/>ዮስ አት ከራኬ ነጉማን ዴምተ፤</para>
  <para style="q2" vid="PRO 3:23">ሚልኬስ ህንጉፈቱ፤<verse eid="PRO 3:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 3:24"/>አት ዮ ረፍቱ ህንሶዳቱ፤</para>
  <para style="q2" vid="PRO 3:24">ህርብንኬስ ዮ አት ረፍቱ ስት ምኣወ።<verse eid="PRO 3:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 3:25"/>በላ አኩመ ተሳ ስት ዹፉ</para>
  <para style="q2" vid="PRO 3:25">ዮካን በዲሰ ሀሞተ ገላፈቱ ህንሶዳትን፤<verse eid="PRO 3:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 3:26"/>
    <char style="nd">ዋቀዮ</char> እርኮ ሲፍ ተኣቲ፤</para>
  <para style="q2" vid="PRO 3:26">አከ ሚልኬ ክዮዻን ህንቀበምኔስ ስ ኤገ።<verse eid="PRO 3:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 3:27"/>አት ዬሮ ዋን ቶኮ ጎቹዻፍ ኣንጎ ቀብዱት፣</para>
  <para style="q2" vid="PRO 3:27">ወረ ወን ጋሪን እሳኒፍ መሉራ ዋን ሰነ ህንሀንቅስን።<verse eid="PRO 3:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 3:28"/>ኡቱ አመ ዋ ቀብዱ፣</para>
  <para style="q2" vid="PRO 3:28">ኦላኬቲን፣ “ዬሮ ብራ ዴብኢ ኮቱ፤</para>
  <para style="q2" vid="PRO 3:28">አን ቦር ሲፍን ኬናቲ” ህንጄዽን።<verse eid="PRO 3:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 3:29"/>ኦላኬ ከን ስ አመኔ ስ ጭነ ጅራቱ ሚዹፍ ጄቴ</para>
  <para style="q2" vid="PRO 3:29">ዋን ሀማ እት ህንያድን።<verse eid="PRO 3:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 3:30"/>ነመ ቶኮ ኡቱ እን ሆማ ስ ህንጎዽን</para>
  <para style="q2" vid="PRO 3:30">አከሱማን ህንሚዽን።<verse eid="PRO 3:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 3:31"/>ነመ ደባት ህንህናፍን፤</para>
  <para style="q2" vid="PRO 3:31">ዮካን ከራሳ ቶኮሌ ህንፍለን።<verse eid="PRO 3:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 3:32"/>
    <char style="nd">ዋቀዮ</char> ነመ ጀልኣ ንጅባቲ፤</para>
  <para style="q2" vid="PRO 3:32">ነመ ቀጄላ ገሩ ኦፍት ኣንፈተ።<verse eid="PRO 3:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 3:33"/>አባርስ <char style="nd">ዋቀዮ</char> መነ ነመ ሀማረ ቡአ፤</para>
  <para style="q2" vid="PRO 3:33">እን ገሩ መነ ነመ ቀጄላ ንኤብሰ።<verse eid="PRO 3:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 3:34"/>እን ቆስቶተ ኦፍ ቱልቶተት ንቆሰ፤</para>
  <para style="q2" vid="PRO 3:34">ወረ ገድ ኦፍ ቀበኒፍሞ አያነ ኬነ።<verse eid="PRO 3:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 3:35"/>ኦጌዪን ኡልፍነ ዻሉ፤</para>
  <para style="q2" vid="PRO 3:35">ጎዎተ ገሩ እን ንቃኔሰ።<verse eid="PRO 3:35"/></para>
  <chapter eid="PRO 3"/>
  <chapter number="4" style="c" sid="PRO 4"/>
  <para style="s1">ኦጉማን ዋን ሁንደ ጫልት</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 4:1"/>ያ እልማንኮ፣ ሜ ጎርሰ አባን ነማፍ ኬኑ ዸገኣ፤</para>
  <para style="q2" vid="PRO 4:1">ቀልቤፈዻቲ ሁበትና አርገዻ።<verse eid="PRO 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 4:2"/>አን በሩምሰ ጋሪ እስኒ ነንኬነ፤</para>
  <para style="q2" vid="PRO 4:2">ከናፉ በርሲሰኮ ህንዺስና።<verse eid="PRO 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 4:3"/>ዬሮ አን ሙጫ ጥና ተኤ መነ አባኮ ቱሬት፣</para>
  <para style="q2" vid="PRO 4:3">ዬሮ አን ዳእመ ዺገ ተኤ ሃዸኮቲፍ እልመ ቶክቸ ቱሬት፣<verse eid="PRO 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 4:4"/>እን አከነ ጄዼ ነ በርሲሴ፤</para>
  <para style="q2" vid="PRO 4:4">“ገራኬ ጉቱዻን ዱቢኮ ጀቤሲ ቀበዹ፤</para>
  <para style="q2" vid="PRO 4:4">ሴረኮ ኤግ፤ አት ንጅራታቲ።<verse eid="PRO 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 4:5"/>ኦጉማ አርገዹ፤ ሁበትናስ አርገዹ፤</para>
  <para style="q2" vid="PRO 4:5">ዱቢኮ ህንደገትን ዮካን እራ ህንጀልአትን።<verse eid="PRO 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 4:6"/>ኦጉማ ህንዺስን፤ እሼን ስ ኤግዲ፤</para>
  <para style="q2" vid="PRO 4:6">እሼ ጃለዹ፤ እሼንስ ስ ትክስቲ።<verse eid="PRO 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 4:7"/>ኦጉማን ዋን ሁንደ ጫልት፤ ከናፉ ኦጉማ አርገዹ።</para>
  <para style="q2" vid="PRO 4:7">ዮ እሼን ዋን አት ቀብዱ ሁንደ ስ ባስፍቴሌ ሁበትና አርገዹ።<verse eid="PRO 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 4:8"/>ኦጉማ ከበጅ፤ እን ኦል ስ ጉድሳቲ፤</para>
  <para style="q2" vid="PRO 4:8">እሰ ሀመዹ፤ እንስ ስ ከበጃቲ።<verse eid="PRO 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 4:9"/>እሼን ከለቸ በሬዳ መታኬረ ሲፍ ኬስ፤</para>
  <para style="q2" vid="PRO 4:9">ጎንፎ ሚዸጋሌ ሲፍ ኬንት።”<verse eid="PRO 4:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 4:10"/>ያ እልመኮ ዸገእ፤ ዋን አን ጄዹሌ ፉዸዹ፤</para>
  <para style="q2" vid="PRO 4:10">በር ጅሬኘኬቲስ ንባይአታ።<verse eid="PRO 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 4:11"/>አን ከራ ኦጉማረ ስን ቀጄልቸ፤</para>
  <para style="q2" vid="PRO 4:11">ዳንዲ ቀጄላረስ ስን ቡሰ።<verse eid="PRO 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 4:12"/>ዬሮ አት ዴምቱ፣ ተርካንፊንኬ ህንእትፈሙ፤</para>
  <para style="q2" vid="PRO 4:12">ዮ ፊግዱሌ አት ህንጉፈቱ።<verse eid="PRO 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 4:13"/>ቀጄልፈመ ጀቤሲ ቀበዹ፤ ገድ ህንዺስን፤</para>
  <para style="q2" vid="PRO 4:13">ዋን እን ጅሬኘኬ ተኤፍ ጀቤሲ ኤገዹ።<verse eid="PRO 4:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 4:14"/>ዳንዲ ሀሞታረ ሚለኬ ህንዻብን</para>
  <para style="q2" vid="PRO 4:14">ዮካን ከራ ጀልኦታረ ህንዴምን።<verse eid="PRO 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 4:15"/>እራ ፈጋዹ፤ እረስ ህንዴምን፤</para>
  <para style="q2" vid="PRO 4:15">እራ ጎሪቲ ከራኬረ ቀጄል።<verse eid="PRO 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 4:16"/>እሳን ዋን ሀማ ሆጄተን መሌ ረፉ ህንደንደአኒቲ፤</para>
  <para style="q2" vid="PRO 4:16">እሳን ሀመ ነመ ጉፈቺሰንት ህርበ ህንአርገተን።<verse eid="PRO 4:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 4:17"/>እሳን ቡዴነ ሀምና ኛቱ፤</para>
  <para style="q2" vid="PRO 4:17">ዳዺ ወይኒ ከን ደባን አርገሜ ዹጉ።<verse eid="PRO 4:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 4:18"/>ከራን ቀጄልቶታ አኩመ እፈ በሪ በራቃ</para>
  <para style="q2" vid="PRO 4:18">ከን ሀመ ሳፋት እቱመ ፉፌ እፋ ዴሙት።<verse eid="PRO 4:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 4:19"/>ከራን ሀሞታ ገሩ አኩመ ዱከነ ጉዳት፤</para>
  <para style="q2" vid="PRO 4:19">እሳን ዋን እሳን ጉፈቺሱ ህንቤከን።<verse eid="PRO 4:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 4:20"/>ያ እልመኮ፣ ዋን አን ጄዹ ቀልቤፈዹ፤</para>
  <para style="q2" vid="PRO 4:20">ዱቢኮቲፍስ ጉረ ኬን።<verse eid="PRO 4:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 4:21"/>አከ እን ፉለኬ ዱራ ዸበሙ ህንጎዽን፤</para>
  <para style="q2" vid="PRO 4:21">ገራኬ ኬሰ ኦል ካአዹ፤<verse eid="PRO 4:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 4:22"/>እን ወረ እሰ አርገቱፍ ጅሬኘ፣</para>
  <para style="q2" vid="PRO 4:22">ዸግነ ነማ ጉቱፍስ ፈይናቲ።<verse eid="PRO 4:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 4:23"/>ዋን ሁንደ ጫላ ቀልቢኬ ኤገዹ፤</para>
  <para style="q2" vid="PRO 4:23">ቡርቃን ጅሬኛ አቺ በኣቲ።<verse eid="PRO 4:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 4:24"/>ዱቢ ጀልእና አፋንኬ ኬሳ በሌስ፤</para>
  <para style="q2" vid="PRO 4:24">ሃሳ ሀማስ አረበኬራ ፈጌስ።<verse eid="PRO 4:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 4:25"/>እጅኬ ከለቲዻን ቀጄልቼ ሃእላሉ፤</para>
  <para style="q2" vid="PRO 4:25">አትስ ጥዬፈዹ ፉለኬ ዱረ እላል።<verse eid="PRO 4:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 4:26"/>ሚለኬቲፍ ዳንዲ ወል ቅጤፈዹ፤</para>
  <para style="q2" vid="PRO 4:26">ከራንኬ ሁንድኑ ሃጀባቱ።<verse eid="PRO 4:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 4:27"/>ገረ ምርጋት ዮካን ገረ ብታት ህንጎርን፤</para>
  <para style="q2" vid="PRO 4:27">ሚለኬ ሀምነራ ኤገዹ።<verse eid="PRO 4:27"/></para>
  <chapter eid="PRO 4"/>
  <chapter number="5" style="c" sid="PRO 5"/>
  <para style="s1">ኤጀራ ኦፍ ኤገቹ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 5:1"/>ያ እልመኮ፣ ኦጉማኮ ቀልቤፈዹ፤</para>
  <para style="q2" vid="PRO 5:1">ሁበትናኮቲፍሌ ጉረ ኬን፤<verse eid="PRO 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 5:2"/>ኩንስ አከ አት ሁበትና ቱርፈቴ</para>
  <para style="q2" vid="PRO 5:2">አረብንኬስ ቤኩምሰ ኩፈቱፍ።<verse eid="PRO 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 5:3"/>ህዺን ኤጅቱ ደመ ጮጮብሰ፤</para>
  <para style="q2" vid="PRO 5:3">ሃሳንሼ ዘይቲ ጫላ ለላፈ፤<verse eid="PRO 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 5:4"/>ዹመረት ገሩ እሼን አኩመ ሀዾፍቱ ሀዾፍት፤</para>
  <para style="q2" vid="PRO 5:4">አኩመ ጎራዴ አፋን ለማስ ቀረ ቀቤቲዸ።<verse eid="PRO 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 5:5"/>ሚልሼ ገረ ዱኣት ገድ ቡአ፤</para>
  <para style="q2" vid="PRO 5:5">ተርካንፊንሼ አዋለት ነመ ጌሰ።<verse eid="PRO 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 5:6"/>እሼን ዋኤ ከራ ጅሬኛ ዽመ ህንቀብዱ፤</para>
  <para style="q2" vid="PRO 5:6">ዳንዲንሼ ጀልኣዸ፤ እሼን ገሩ ከነ ህንቤክቱ።<verse eid="PRO 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 5:7"/>ኤጋ ያ እልማንኮ፣ ሜ ነ ዸገኣ፤</para>
  <para style="q2" vid="PRO 5:7">ዋን አን ጄዹራ ገረ ከምትዩ ህንጎርና።<verse eid="PRO 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 5:8"/>ከራኬሰን እሼራ ፈጌፈዻ፤</para>
  <para style="q2" vid="PRO 5:8">በልበለ መነሼት ህንዽኣና፤<verse eid="PRO 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 5:9"/>ኩንስ አከ አት ኡልፍነኬ ነመ ብራቲፍ፣</para>
  <para style="q2" vid="PRO 5:9">ኡሙሪኬስ ነመ ነማፍ ህናኔፍ ህንኬንኔፍ፤<verse eid="PRO 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 5:10"/>አከሱመስ ቀቤኘኬ ኦርመቱ ኛተ፤</para>
  <para style="q2" vid="PRO 5:10">ደዸቢንኬስ መነ አለጋ በዻሰ።<verse eid="PRO 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 5:11"/>ዹመ ጅሬኘኬቲት፣</para>
  <para style="q2" vid="PRO 5:11">ዬሮ ፎኒፊ ዸግንኬ ዹሙት አት ንኣደ።<verse eid="PRO 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 5:12"/>አትስ አከነ ጄተ፤ “አን አከምን አደበሙ ጅቤ!</para>
  <para style="q2" vid="PRO 5:12">ገራንኮስ አከም ስሬፈሙ ቱፈቴ!<verse eid="PRO 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 5:13"/>አን በርሲስቶተኮቲፍ ህንአጀጀምኔ</para>
  <para style="q2" vid="PRO 5:13">ዮካን ቀጄልችቶተኮ ህንዸጌፈትኔ።<verse eid="PRO 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 5:14"/>አን ወልዳ ጉቱ ግዱት</para>
  <para style="q2" vid="PRO 5:14">ቀርቀረ በዲሳ ገኤን ቱሬ።”<verse eid="PRO 5:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 5:15"/>ኤለኬ ኬሳ ብሻን፣</para>
  <para style="q2" vid="PRO 5:15">ቦለ ብሻኒኬ ኬሳሞ ብሻን ቁልቁሉ ዹግ።<verse eid="PRO 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 5:16"/>ቡርቃንኬ ጉቴ ዳንዲረ፣ ብሻንኬ ከን ያኡስ</para>
  <para style="q2" vid="PRO 5:16">ኦብዲ ኬሰ ዸንገለኡ ቀባ?<verse eid="PRO 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 5:17"/>እሳን ከንኬ ሃተአን፤</para>
  <para style="q2" vid="PRO 5:17">ኦርም ስ ወጅን ቆደቹ ህንቀቡ።<verse eid="PRO 5:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 5:18"/>ቡርቃንኬ ሃኤብፈሙ፤</para>
  <para style="q2" vid="PRO 5:18">ኒቲ ደርገጉማኬቲት ገመድ።<verse eid="PRO 5:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 5:19"/>እሼን ሚዸግዱ አከ ቦሮፋ፣ በሬዱ አከ ገደምሳት፤</para>
  <para style="q2" vid="PRO 5:19">ሀርምሼ ዬሮ ሁንደ ስት ሃቶሉ፤</para>
  <para style="q2" vid="PRO 5:19">ዬሮ ሁንደ ጃለልሼ ስ ሃቦጅኡ።<verse eid="PRO 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 5:20"/>ያ እልመኮ፣ አት ማሊፍ ኤጅቱዻን ቦጅአምተ?</para>
  <para style="q2" vid="PRO 5:20">ማሊፍ ቦባ ኒቲ ነመ ብራ ሀመተ?<verse eid="PRO 5:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 5:21"/>ከራን ነማ ጉቱማን ጉቱት ፉለ <char style="nd">ዋቀዮ</char> ዱረ ጅራቲ፤</para>
  <para style="q2" vid="PRO 5:21">እንስ ዳንዲ ነማ ሁንደ ንቶአተ።<verse eid="PRO 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 5:22"/>በሌሳን ነመ ሀማ እሱመ ቀባተ፤</para>
  <para style="q2" vid="PRO 5:22">ፉኞን ጩቡሳ ጀቤሴ እሰ ቀበ።<verse eid="PRO 5:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 5:23"/>እን ሰበቢ አደበሙ ዸቤፍ ዱአ፤</para>
  <para style="q2" vid="PRO 5:23">ጉድን ጎዉማሳስ ከራራ እሰ በሌሰ።<verse eid="PRO 5:23"/></para>
  <chapter eid="PRO 5"/>
  <chapter number="6" style="c" sid="PRO 6"/>
  <para style="s1">አኬከቺሰ ዋኤ ጎዉማረት ኬነሜ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 6:1"/>ያ እልመኮ፣ አት ዮ ኦላኬቲፍ ወቢ ታቴ</para>
  <para style="q2" vid="PRO 6:1">ሀርከ ዾፍቴ ነመ ኦርማቲፍ ከከቴ፣<verse eid="PRO 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 6:2"/>ዮ ዋኑመ ዱበቴን ቀበምቴ</para>
  <para style="q2" vid="PRO 6:2">ዱቡመ አፋንኬቲቲን ክዮ ሴንቴ፣<verse eid="PRO 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 6:3"/>ዮስ ያ እልመኮ፣ <optbreak/> አት ሰበቢ ሀርከ ኦላኬቲ ሴንቴ ጅርቱፍ</para>
  <para style="q2" vid="PRO 6:3">አት ኦፍ ባሱዻፍ</para>
  <para style="q1" vid="PRO 6:3">ደፊ ዸቂቲ ገድ ኦፍ ቀቢ</para>
  <para style="q2" vid="PRO 6:3">ጀቤሲቲ ኦላኬ ከዸዹ!<verse eid="PRO 6:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 6:4"/>እጀኬቲፍ ህርበ፣</para>
  <para style="q2" vid="PRO 6:4">ባሌ እጀኬቲቲፍሞ ሙጋቲ ህንኤየምን።<verse eid="PRO 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 6:5"/>አት አኩመ ኩሩጴ ሀርከ አደምስቱቲ ባቱት፣</para>
  <para style="q2" vid="PRO 6:5">አኩመ ስምብሮ ክዮ ነመ እሼ ቀቡ ጀላ ባቱት ኦፍ ኦልች።<verse eid="PRO 6:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 6:6"/>ያ ዽባኣነነ ሜ ገረ ጎንዳ ዸቅ፤</para>
  <para style="q2" vid="PRO 6:6">ከራሼ ቀልቤፈዹቲ ኦጌሰ ተእ!<verse eid="PRO 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 6:7"/>እን አጀጃ ህንቀቡ፤</para>
  <para style="q2" vid="PRO 6:7">ቶአታ ዮካን ቡልቻ ህንቀቡ፤<verse eid="PRO 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 6:8"/>ተኡሌ እን ቦነ ኬሰ ኛተሳ ኩፈተ፤</para>
  <para style="q2" vid="PRO 6:8">ዬሮ ምዻን ገልፈሙትሞ ኛተሳ ወልት ቀበተ።<verse eid="PRO 6:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 6:9"/>ያ ዽባኣነነ፣ አት ሀመ ዮሚት ጪፍተ?</para>
  <para style="q2" vid="PRO 6:9">አት ዮም ህርበኬቲ ካተ?<verse eid="PRO 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 6:10"/>ህርበ ጥና፣ ሙጋቲ ጥና፣</para>
  <para style="q2" vid="PRO 6:10">ጥኖ ሀርከ ወልት መረቹ፣<verse eid="PRO 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 6:11"/>ህዩማንስ አኩመ ሀቱት ስት ዹፈ፤</para>
  <para style="q2" vid="PRO 6:11">ዴጉማንስ አኩመ ሎልቱ ህዸቴት ስት ዹፈ።<verse eid="PRO 6:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 6:12"/>ነምን ረክሳን፣ ነምን ሀማን፣</para>
  <para style="q2" vid="PRO 6:12">ዱቢ ሶባቲን አሲፊ አች ናነአ፤<verse eid="PRO 6:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="PRO 6:13"/>እን እጃን ዸአ፤</para>
  <para style="q2" vid="PRO 6:13">ሚለሳቲንስ መለቶ ኬነ፤</para>
  <para style="q2" vid="PRO 6:13">ቁበሳቲን አርግሲሰ፤<verse eid="PRO 6:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="PRO 6:14"/>እን ገራሳ እሰ ሶባዻን ሀምነ ያደ፤</para>
  <para style="q2" vid="PRO 6:14">ዬሮ ሁንደስ ሎለ ከካሰ።<verse eid="PRO 6:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 6:15"/>ከናፉ በዲስን ዮሙሱመ እሰት ዹፈ፤</para>
  <para style="q2" vid="PRO 6:15">እን አኩመ ተሳ ጨበ፤ ዴብኤስ ህንፈዩ።<verse eid="PRO 6:15"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="16" style="v" sid="PRO 6:16"/>
    <char style="nd">ዋቀዮ</char> ዋን ጀአ ጅበ፤</para>
  <para style="li2" vid="PRO 6:16">ዋን ቶርበሞ ንጥሬፈተ፤ እሳንስ፦<verse eid="PRO 6:16"/></para>
  <para style="li3">
    <verse number="17" style="v" sid="PRO 6:17"/>እጀ ኦፍ ቱሉ፣</para>
  <para style="li3" vid="PRO 6:17">አረበ ሶቡ፣</para>
  <para style="li3" vid="PRO 6:17">ሀርከ ዺገ ነመ በሌሳ ህንቀብኔ ዸንገላሱ፣<verse eid="PRO 6:17"/></para>
  <para style="li3">
    <verse number="18" style="v" sid="PRO 6:18"/>ገራ መለ ሀማ መሉ፣</para>
  <para style="li3" vid="PRO 6:18">ሚለ ገረ ጀልእናት አሪፈቱ፣<verse eid="PRO 6:18"/></para>
  <para style="li3">
    <verse number="19" style="v" sid="PRO 6:19"/>ዹገ ባቱ ሶባ ከን ሶበ ዸንገላሱ፣</para>
  <para style="li3" vid="PRO 6:19">ነመ ኦቦሎተ ግዱት ሎለ ከካሱዸ።<verse eid="PRO 6:19"/></para>
  <para style="s1">አኬከቺሰ ዋኤ ኤጃረት ኬነሜ</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 6:20"/>ያ እልመኮ፣ አጀጀ አባኬቲ ኤግ፤</para>
  <para style="q2" vid="PRO 6:20">በርሲሰ ሃዸኬቲሌ ህንገትን።<verse eid="PRO 6:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 6:21"/>በረ በራን ገራኬት ቀበዹ፤</para>
  <para style="q2" vid="PRO 6:21">ሞርመ ኬትስ ህዸዹ።<verse eid="PRO 6:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 6:22"/>ዬሮ አት ዴምቱ እሳን ስ ቀጄልቹ፤</para>
  <para style="q2" vid="PRO 6:22">ዬሮ አት ረፍቱ ስ ኤጉ፤</para>
  <para style="q2" vid="PRO 6:22">ዬሮ አት ህርባ ካቱሌ ስ ሃሶፍሲሱ።<verse eid="PRO 6:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 6:23"/>አጀጅን ኩን እብሳዻቲ፤</para>
  <para style="q2" vid="PRO 6:23">በርሲስን ኩንስ እፈ፤</para>
  <para style="q2" vid="PRO 6:23">ስሬፈምን አመላሞ ከራ ጅሬኛት፤<verse eid="PRO 6:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 6:24"/>እሳን ዱበርቲ ሀምቱራ፣</para>
  <para style="q2" vid="PRO 6:24">ኒቲ ከሽለቤ አፋን ደማራ ስ ኤጉ።<verse eid="PRO 6:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 6:25"/>ገራኬ ኬሰት በሬድነሼ ህንዸረእን፤</para>
  <para style="q2" vid="PRO 6:25">ዮካን አከ እሼን እጀ እሼቲን ስ ቦጅቱ ህንጎዽን።<verse eid="PRO 6:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 6:26"/>ሰጋገልቱን ቡዴነ ቶኮን ብተምቲቲ፤</para>
  <para style="q2" vid="PRO 6:26">ኤጅቱንስ ጅሬኙመኬ አደምስት።<verse eid="PRO 6:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 6:27"/>ነምን ቦባ ጀለት እብደ ባዸቴ</para>
  <para style="q2" vid="PRO 6:27">ወያንሳ ህንጉበትኔ ጅራ?<verse eid="PRO 6:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 6:28"/>ነምን እብደ ጭሌረ ኤጄቴ</para>
  <para style="q2" vid="PRO 6:28">ሚልሳ ህንጉበትኔ ጅራ?<verse eid="PRO 6:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 6:29"/>ነምን ኒቲ ነመ ብራ ወጅን ጪሱስ አከሱመ ተአ፤</para>
  <para style="q2" vid="PRO 6:29">ነምን እሼ ቱቁ ከምዩ ኡቱ ህንአደበምን ህንሀፉ።<verse eid="PRO 6:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 6:30"/>ዮ ሀቱን ቶኮ ቤለ በኡፍ ጄዼ ሀቴ፣</para>
  <para style="q2" vid="PRO 6:30">ነሞትን ህንቱፈተን።<verse eid="PRO 6:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 6:31"/>ገሩ እን ዮ ቀበሜ ደቻ ቶርበ ባሰ፤</para>
  <para style="q2" vid="PRO 6:31">ምአ መነሳ ሁንደስ ንኬነ።<verse eid="PRO 6:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 6:32"/>ነምን ሰጋገሉ ቀልቢ ህንቀቡ፤</para>
  <para style="q2" vid="PRO 6:32">ነምን ዋን አከሲ ሆጄቱ ኦፉመ ገላፈተ።<verse eid="PRO 6:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 6:33"/>ቆድንሳ ዻነሙፊ ሰልጰቹዸ፤</para>
  <para style="q2" vid="PRO 6:33">ቃኒንሳ ዮምዩ እሰራ ህንሀቀሙ።<verse eid="PRO 6:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 6:34"/>ህናፋን ኣሪ ዽርሳ ከካሳቲ፤</para>
  <para style="q2" vid="PRO 6:34">እን ዬሮ ሃሎ በኡት ዺፈመ ቶኮዩ ህንጎዹ።<verse eid="PRO 6:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 6:35"/>እን ቤኛ ቶኮሌ ህንፉዸቱ፤</para>
  <para style="q2" vid="PRO 6:35">ሀመም ባይአቱዩ እን መተኣ ንድደ።<verse eid="PRO 6:35"/></para>
  <chapter eid="PRO 6"/>
  <chapter number="7" style="c" sid="PRO 7"/>
  <para style="s1">ሰጋገልቱራ ኦፍ ኤገቹ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 7:1"/>ያ እልመኮ፣ ዱቢኮ ኤጊቲ</para>
  <para style="q2" vid="PRO 7:1">አጀጀኮስ ኦፍ ኬሰት ኩፈዹ።<verse eid="PRO 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 7:2"/>አጀጀኮ ኤግ፣ አት ንጅራታቲ፤</para>
  <para style="q2" vid="PRO 7:2">በርሲሰኮስ አኩመ ቀሮ እጀኬቲት ኤግ።<verse eid="PRO 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 7:3"/>ቁበኬት እሳን ህዸዹ፤</para>
  <para style="q2" vid="PRO 7:3">ገበቴ ገራኬቲረትስ በሬፈዹ።<verse eid="PRO 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 7:4"/>ኦጉማን፣ “አት ኦቦሌቲኮት” ጄዽ፤</para>
  <para style="q2" vid="PRO 7:4">ሁበትናሞ፣ ፍረኮ ጄዺ ዋም፤<verse eid="PRO 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 7:5"/>እሳን ሰጋገልቱራ፣ ኒቲ ከሽለቤ ዱቢ እሼቲን</para>
  <para style="q2" vid="PRO 7:5">ነመ ሀርክፍቱራ ስ ኤጉ።<verse eid="PRO 7:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 7:6"/>አን ፎዳ መነኮ ብራ ኬሳን፣</para>
  <para style="q2" vid="PRO 7:6">ከራ ቃዋቲን አለ እላሌ።<verse eid="PRO 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 7:7"/>አን ወረ ሆማ ህንደንዴኜ ኬሰት፣</para>
  <para style="q2" vid="PRO 7:7">ደርገጎተ ኬሰት ሁበዼ</para>
  <para style="q2" vid="PRO 7:7">ደርገጌሰ ቀልቢ ህንቀብኔ ቶኮ አርጌ።<verse eid="PRO 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 7:8"/>እንስ ከራ መነሼ ዸቁ ቀበቴ</para>
  <para style="q2" vid="PRO 7:8">ዳንዲ ጎሌ መነሼ ብረ ጅሩቲን ገድ ቡኣ ቱሬ።<verse eid="PRO 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 7:9"/>ኩንስ ዬሮ አዱን ዺቴ ለፍት ድምምሳኣ ቱሬት፣</para>
  <para style="q2" vid="PRO 7:9">ዬሮ ሀልከን ዱከናኡ ጀልቀቤት ቱሬ።<verse eid="PRO 7:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 7:10"/>ዱበርቲን ቶኮ አከ ሰጋገልቱት ኡፈቴ</para>
  <para style="q2" vid="PRO 7:10">ያደ ሀጡማቲን እሰ ስመቹፍ ገድ ባቴ።<verse eid="PRO 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 7:11"/>እሼን እይቱፊ ከሽለቤዸ፤</para>
  <para style="q2" vid="PRO 7:11">ሚልሼ መነ ህንዻበቱ፤<verse eid="PRO 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 7:12"/>ተከ ዳንዲረት፣ ተከ ኦብዲረት፣</para>
  <para style="q2" vid="PRO 7:12">ጎሌ ሁንደት ርጵጤ ነመ ኤገት።<verse eid="PRO 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 7:13"/>እሼን ቀብዴ እሰ ዹንገት፤</para>
  <para style="q2" vid="PRO 7:13">ፉለ ቃኒ ህንቀብኔን አከነ ጄቲን፦<verse eid="PRO 7:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 7:14"/>“አን ኣርሳ ነጋ ዽኤሱን ቀበ፤</para>
  <para style="q2" vid="PRO 7:14">ሀርአ ወሬገኮ ጉተዼረ።<verse eid="PRO 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 7:15"/>ከናፉ አን ስ ስመቹፍን ገድ በኤ፤</para>
  <para style="q2" vid="PRO 7:15">አን በርባዴ ስ አርገዼረ!<verse eid="PRO 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 7:16"/>አን ወያ በሬዱ ቁንጬ ተልባራ ሆጄተሜ ከን ግብጢ ዹፌን፣</para>
  <para style="q2" vid="PRO 7:16">ስሬኮ አፌ ሚዸግሴረ።<verse eid="PRO 7:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 7:17"/>አን ቁምቢን፣ አርጌሳፊ ቀረፋን</para>
  <para style="q2" vid="PRO 7:17">ስሬኮ ኡርጌሴረ።<verse eid="PRO 7:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 7:18"/>ኮቱ ሜ ሀመ በሪት ገድ ፈጌኘ ጃለላ ወሊ ወጅን ዹግና፤</para>
  <para style="q2" vid="PRO 7:18">ኮቱ ጃለላን ኦፍ ገመቺፍና!<verse eid="PRO 7:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 7:19"/>ዽርስኮ መነ ህንጅሩ፤</para>
  <para style="q2" vid="PRO 7:19">እን ከራ ዼራ ዴሜረ።<verse eid="PRO 7:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 7:20"/>እን ቦርሳሳ ማለቃን ጉተቴ ዴሜ፤</para>
  <para style="q2" vid="PRO 7:20">ሀመ ጅእ ጎበኑት መነት ህንዴብኡ።”<verse eid="PRO 7:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 7:21"/>እሼን ዱቢ ምኦፍቱዻን ከራራ እሰ ጀልእፍቴ፤</para>
  <para style="q2" vid="PRO 7:21">ሃሳ ነመ ሶሶቡንስ እሰ ድርቅሲፍቴ።<verse eid="PRO 7:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 7:22"/>እንስ አኩመ ሰንጋ ቀለሙፍ ዴሙት፣</para>
  <para style="q2" vid="PRO 7:22">አኩመ ገደምሰ ክዮ ኬሰ ሴኑትስ</para>
  <para style="q1" vid="PRO 7:22">ዮሙሱመ ከኤ እሼ ዱካ ቡኤ፤<verse eid="PRO 7:22"/></para>
  <para style="q2">
    <verse number="23" style="v" sid="PRO 7:23"/>አኩመ ስምብረ ክዮት አሪፈቱት፣</para>
  <para style="q1" vid="PRO 7:23">እን ሀመ ጥይ ትሩሳ ወራኑት</para>
  <para style="q2" vid="PRO 7:23">አከ ወን ኩን ሉቡሳ ገላፈቱ ህንቤኩ።<verse eid="PRO 7:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 7:24"/>ኤጋ ያ እልማንኮ፣ ነ ዸጌፈዻ፤</para>
  <para style="q2" vid="PRO 7:24">ዋን አን ጄዹስ ቀልቤፈዻ።<verse eid="PRO 7:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 7:25"/>አከ ገራንኬ ከራሼት ገረገሉ ህንጎዽን፤</para>
  <para style="q2" vid="PRO 7:25">ከራኬራስ በዴ ዳንዲሼረ ህንቡእን።<verse eid="PRO 7:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 7:26"/>ነሞትን ሄዱን ወረ እሼን ለፋን ዾፍቴዸ፤</para>
  <para style="q2" vid="PRO 7:26">ነሞትን ጀጀቦን ባይኤንስ ሀርከሼት ዹመኒሩ።<verse eid="PRO 7:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 7:27"/>መንሼ ከራ ቅሌት ነመ ጌሱ፣</para>
  <para style="q2" vid="PRO 7:27">ከን ጎለ ዱኣት ገድ ነመ ቡሱዸ።<verse eid="PRO 7:27"/></para>
  <chapter eid="PRO 7"/>
  <chapter number="8" style="c" sid="PRO 8"/>
  <para style="s1">ዋምቸ ኦጉማ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 8:1"/>ኦጉማን ህንዩ?</para>
  <para style="q2" vid="PRO 8:1">ሁበትናንስ ሰገሌሳ ኦል ህንፉዸቱ?<verse eid="PRO 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 8:2"/>እሼን ቀርቀረ ከራ፣ ለፈ ኦል ከኣረ፣</para>
  <para style="q2" vid="PRO 8:2">እዶ ዳንዲን እት ወል ገኡ ዻበት፤<verse eid="PRO 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 8:3"/>ከረ መጋላት ነመ ገልቹ ብረ፣</para>
  <para style="q2" vid="PRO 8:3">በልበለ ዱረ ዻበቴ አከነ ጄቴ እይት፦<verse eid="PRO 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 8:4"/>“ያ ነሞተ፣ አን እዬን እስን ዋመ፤</para>
  <para style="q2" vid="PRO 8:4">አን እልማን ነማ ሁንደት ሰገሌኮ ኦል ነንፉዸዸ።<verse eid="PRO 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 8:5"/>እስን ወር ሆማ ህንቤክኔ፣ ቀልቢ ሆረዻ፤</para>
  <para style="q2" vid="PRO 8:5">እስን ወር ጎዋን ሁበትና አርገዻ።<verse eid="PRO 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 8:6"/>አን ዋን ፋይዳ ቀቡ ነንዱበዻቲ፣ ዸገኣ፤</para>
  <para style="q2" vid="PRO 8:6">ዋን ቀጄላ ዱበቹፍስ አፋንኮ ነንበነዸ።<verse eid="PRO 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 8:7"/>አፋንኮ ዹጋ ዱበተ፤</para>
  <para style="q2" vid="PRO 8:7">አረብንኮ ሀምነ ጅባቲ።<verse eid="PRO 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 8:8"/>ዱቢን አፋንኮ ሁንድኑ ቀጄላዸ፤</para>
  <para style="q2" vid="PRO 8:8">ዱቢኮ ኬሳ ቶኮዩ ጀልኣ ዮካን ምጪረማ ምት።<verse eid="PRO 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 8:9"/>ነመ ዋ ሁበቱፍ ዱቢንኮ ሁንድኑ ቀጄላዸ፤</para>
  <para style="q2" vid="PRO 8:9">ወረ ቤኩምሰ ቀቡፍስ ህርእነ ህንቀቡ።<verse eid="PRO 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 8:10"/>ቆደ ሜቲ ጎርሰኮ፣</para>
  <para style="q2" vid="PRO 8:10">ወርቄ ቁልቁሉ ጫላስ ቤኩምሰ ፍለዹ፤<verse eid="PRO 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 8:11"/>ኦጉማን ሉለ ዲማ ጫላ ገቲ ጉዳ ቀብዲ፤</para>
  <para style="q2" vid="PRO 8:11">ወን አት ሀውቱ ቶኮዩ እሼዻን ወል ህንመዳሉ።<verse eid="PRO 8:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 8:12"/>“አን ኦጉማን፣ ቀልቢ ወጅን ነንጅራዸ፤</para>
  <para style="q2" vid="PRO 8:12">አን ቤኩምሳፊ ሁበትና ቀበ።<verse eid="PRO 8:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 8:13"/>
    <char style="nd">ዋቀዮን</char> ሶዳቹን ጅቡዸ፤</para>
  <para style="q2" vid="PRO 8:13">ሀምነ አን ኦፍ ቱሉማፊ ኦፍ ጉድሱ፣</para>
  <para style="q2" vid="PRO 8:13">አመለ ሀማፊ ሃሳ ጀልኣ ነንጅበ።<verse eid="PRO 8:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 8:14"/>ጎርሳፊ ሙርቲን ዹጋ ከንኮት፤</para>
  <para style="q2" vid="PRO 8:14">አን ሁበትናፊ ሁምነ ቀበ።<verse eid="PRO 8:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 8:15"/>ሞቶትን አናን ሞኡ፤</para>
  <para style="q2" vid="PRO 8:15">ቡልችቶትንስ አናን ሴረ ቀጄላ ባሱ።<verse eid="PRO 8:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 8:16"/>እልማን ሞቶታ አናን ቡልቹ፤</para>
  <para style="q2" vid="PRO 8:16">ነሞትን ቤቤከሞን ሁንድስ አናን ብየ ቡልቹ።<verse eid="PRO 8:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 8:17"/>አን ወረ ነ ጃለተን ነንጃለዸ፤</para>
  <para style="q2" vid="PRO 8:17">ወር ነ በርባደንስ ነ አርገቱ።<verse eid="PRO 8:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 8:18"/>ሶሩምኒፊ ኡልፍን፣ ቀቤኚፊ</para>
  <para style="q2" vid="PRO 8:18">በዻዹማን ዹመ ህንቀብኔ ሀርኩመኮ ጅሩ።<verse eid="PRO 8:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 8:19"/>እጅኮ ወርቄ ቁልቁሉ ጫለ፤</para>
  <para style="q2" vid="PRO 8:19">ቡኣን ነራ አርገሙስ ሜቲ ፍለተማ ጫለ።<verse eid="PRO 8:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 8:20"/>አን ከራ ቀጄሉማረ፣</para>
  <para style="q2" vid="PRO 8:20">ዳንዲ ቀጄላረስ ነንዴመ፤<verse eid="PRO 8:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 8:21"/>ወረ ነ ጃለቱት ቀቤኘ ነንዸንገላሰ፤</para>
  <para style="q2" vid="PRO 8:21">መንኩሰ ቀቤኘሳኒሌ ነንጉተ።<verse eid="PRO 8:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 8:22"/>“<char style="nd">ዋቀዮ</char> ዋን በረ ዱሪ ሆጄቴን ዱረ፣</para>
  <para style="q2" vid="PRO 8:22">ሆጂሳ ከን ጀልቀባቲን ዱረ ነ ኣንፈቴ፤<verse eid="PRO 8:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 8:23"/>አን ኡቱ አዱኛን ህንኡመምን ዱረ፣</para>
  <para style="q2" vid="PRO 8:23">ጀልቀቡመት፣ በረ ሀመ ህንቀብኔን ዱረ ነንሙደሜ።<verse eid="PRO 8:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 8:24"/>አን ኡቱ ቱጁብን ህንጅራትን፣</para>
  <para style="q2" vid="PRO 8:24">ኡቱ ቡርቃወን ብሻኒን ህንጉተምን ዸለዼ፤<verse eid="PRO 8:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 8:25"/>ኡቱ ቱሉወን እዶሳኒ ህንዻበምን ዱረ፣</para>
  <para style="q2" vid="PRO 8:25">አን ጋረኒን ዱረ ነንዸለዼ፤<verse eid="PRO 8:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 8:26"/>ኡቱ እን ለፈ ዮካን ድሬሼ</para>
  <para style="q2" vid="PRO 8:26">ዮካን ብዮ አዱኛ ቶኮዩ <optbreak/> ህንኡምን ዱረ ነንዸለዼ።<verse eid="PRO 8:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 8:27"/>ዬሮ እን ሰሚወን ሁንዴሴት፣</para>
  <para style="q2" vid="PRO 8:27">ዬሮ እን ዽዽመረ ሙሜ ካኤት አን አችን ቱሬ፤<verse eid="PRO 8:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 8:28"/>ዬሮ እን ጉባት ዱሜሰ ጀቤሴ ዻቤ</para>
  <para style="q2" vid="PRO 8:28">መደ ቱጁባሌ ሁንዴሴት አን አችን ቱሬ፤<verse eid="PRO 8:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 8:29"/>ዬሮ እን አከ ብሻኖትን አጀጀሳ ህንጨብስኔፍ ጄዼ፣</para>
  <para style="q2" vid="PRO 8:29">ገላናፍ ዳንጋ ዻቤት፣</para>
  <para style="q1" vid="PRO 8:29">ዬሮ እን ለፈ ሁንዴሴት አን አችን ቱሬ።<verse eid="PRO 8:29"/></para>
  <para style="q2">
    <verse number="30" style="v" sid="PRO 8:30"/>ዬሮ ሰነት አን ኦጌሰ ሆጂ ሀርካ ተኤ እሰ ብረን ቱሬ።</para>
  <para style="q1" vid="PRO 8:30">አን ዬሮ ሁንደ ፉለሳ ዱረ ቡራቃ፣</para>
  <para style="q2" vid="PRO 8:30">ጉዩመ ጉያዻን ገመቹዻን ጉተማን ቱሬ፤<verse eid="PRO 8:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 8:31"/>አን ጉቱማ አዱኛሳ ኬሰት እልልቻ፣</para>
  <para style="q2" vid="PRO 8:31">እልማን ነማትሌ ገመዳን ቱሬ።<verse eid="PRO 8:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 8:32"/>“ኤጋ ያ እልማንኮ፣ ሜ ነ ዸገኣ፤</para>
  <para style="q2" vid="PRO 8:32">ወር ከራኮ ኤገን ኤብፈሞዸ።<verse eid="PRO 8:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 8:33"/>ጎርሰኮ ዸጌፈዻቲ ኦጌዪ ተኣ፤</para>
  <para style="q2" vid="PRO 8:33">እሰ ህንቱፈትና።<verse eid="PRO 8:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 8:34"/>ነምን ነ ዸገኡ፣</para>
  <para style="q2" vid="PRO 8:34">ከን ጉያ ሁንደ በልበለኮ ኤጉ፣</para>
  <para style="q2" vid="PRO 8:34">ከን ከረኮ ዱረ ቱሩ ኤብፈማዸ።<verse eid="PRO 8:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 8:35"/>ነምን ነ አርገቱ ከምዩ ጅሬኘ አርገተ፤</para>
  <para style="q2" vid="PRO 8:35">
    <char style="nd">ዋቀዮ</char> ብረትሌ ፉዸተመ አርገተ።<verse eid="PRO 8:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PRO 8:36"/>ነምን ነ ህንአርገትኔ ገሩ ኦፉመ ሚዸ፤</para>
  <para style="q2" vid="PRO 8:36">ነምን ነ ጅቡ ሁንድኑ ዱአ ጃለተ።”<verse eid="PRO 8:36"/></para>
  <chapter eid="PRO 8"/>
  <chapter number="9" style="c" sid="PRO 9"/>
  <para style="s1">ኦጉማፊ ጎዉማ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 9:1"/>ኦጉማን መነሼ እጃረቴ፤</para>
  <para style="q2" vid="PRO 9:1">ኡቱባሼ ቶርበንስ ዸጋራ ቆጴፈቴ።<verse eid="PRO 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 9:2"/>እሼን ሆሪ ቀለቴ ዳዺ ወይኒሼ ቡልቡለቴ፤</para>
  <para style="q2" vid="PRO 9:2">ማዲሼሌ ቆጴፈቴ።<verse eid="PRO 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 9:3"/>ተጃጅልቶተሼ ዱበረን ኤርገቴ</para>
  <para style="q2" vid="PRO 9:3">ፊጤ መጋላራ ለለብዴ።<verse eid="PRO 9:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="PRO 9:4"/>እሼን ወረ ቀልቢ ህንቀብኔን አከነ ጄት፤</para>
  <para style="q1" vid="PRO 9:4">“እስን ወር ሆማ ህንቤክኔ ሁንድ አስ ኮታ!<verse eid="PRO 9:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="PRO 9:5"/>ኮታቲ ኛተኮ ኛዻ፤</para>
  <para style="q2" vid="PRO 9:5">ዳዺ ወይኒ አን ቡልቡለዼሌ ዹጋ።<verse eid="PRO 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 9:6"/>ከራ ጎዉማኬሰኒ ሰነ ዺሳቲ ጅራዻ፤</para>
  <para style="q2" vid="PRO 9:6">ከራ ሁበትናረ ዴማ።<verse eid="PRO 9:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 9:7"/>“ነምን ነመ ነመት ቆሱ ጎርሱ ከምዩ ንአረብሰመ፤</para>
  <para style="q2" vid="PRO 9:7">ነምን ነመ ሀማ እፈቱ ከምዩ ንሰልጰተ።<verse eid="PRO 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 9:8"/>አት ነመ ነመት ቆሱ ህንፈትን፤ እን ስ ጅባቲ፤</para>
  <para style="q2" vid="PRO 9:8">ነመ ኦጌሰ እፈዹ፤ እን ስ ጃለታቲ።<verse eid="PRO 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 9:9"/>ነመ ኦጌሰ ጎርስ፤ እን እቱመ ጫልችሴ ኦጌሰ ተኣ፤</para>
  <para style="q2" vid="PRO 9:9">ነመ ቀጄላፍ በሩምሰ ኬን፤ እን ቤኩምሰሳት ደበላቲ።<verse eid="PRO 9:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 9:10"/>“<char style="nd">ዋቀዮን</char> ሶዳቹን ጀልቀበ ኦጉማት፤</para>
  <para style="q2" vid="PRO 9:10">እሰ ቁልቁሉ ሰነ ቤኩን ሁበትናዸ።<verse eid="PRO 9:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 9:11"/>ከራኮቲን በሪ ጅሬኘኬቲ ንዼረተ፤</para>
  <para style="q2" vid="PRO 9:11">ጅሬኘኬረትስ ወጎትን ንደበለሙቲ።<verse eid="PRO 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 9:12"/>ዮ አት ነመ ኦጌሰ ታቴ፣ ኦጉማንኬ ስ በዻሰ፤</para>
  <para style="q2" vid="PRO 9:12">ዮ አት ከን ነመት ቆስቱ ታቴ ሱመ ቆፈቱ ግድረመ።”<verse eid="PRO 9:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 9:13"/>ዱበርቲን ጎዋን ኦዱ ባይእፍት፤</para>
  <para style="q2" vid="PRO 9:13">እሼን ራቱ ሆማ ህንቤክኔዸ።<verse eid="PRO 9:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 9:14"/>እሼን በልበለ መነሼ ዱረ፣</para>
  <para style="q2" vid="PRO 9:14">ፊጤ መጋላ ጉባ በርጩመረ ቴሴ<verse eid="PRO 9:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 9:15"/>ወረ አቺን ደርበን፣ ከኔን ቀጄለኒ</para>
  <para style="q2" vid="PRO 9:15">ዳንዲሳኒረ ዴመን ዋምት።<verse eid="PRO 9:15"/></para>
  <para style="q2">
    <verse number="16" style="v" sid="PRO 9:16"/>እሼን ወረ ቀልቢ ህንቀብኔን አከነ ጄት።</para>
  <para style="q1" vid="PRO 9:16">“እስን ወር ሆማ ህንቤክኔ ሁንድ አስ ኮታ!<verse eid="PRO 9:16"/></para>
  <para style="q2">
    <verse number="17" style="v" sid="PRO 9:17"/>ብሻን ሀተን ንምኣወ፤</para>
  <para style="q2" vid="PRO 9:17">ኛትን ዾክሳን ኛተንስ ጉዶ ነመት ቶለ!”<verse eid="PRO 9:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 9:18"/>እሳን ገሩ አከ ወር ዱአን አች ጅረን፣</para>
  <para style="q2" vid="PRO 9:18">አከ ኬሱሞንሼ ዽዽመ አዋላ ኬሰ ጅረንሌ <optbreak/> ጥኑመ ቤኩ።<verse eid="PRO 9:18"/></para>
  <chapter eid="PRO 9"/>
  <chapter number="10" style="c" sid="PRO 10"/>
  <para style="ms1">ፈኬኘወን ሶሎሞን</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 10:1"/>ፈኬኘወን ሶሎሞን፦</para>
  <para style="q1" vid="PRO 10:1">እልም ኦጌስ አባሳ ገመቺሰ፤</para>
  <para style="q2" vid="PRO 10:1">እልም ጎዋን ገሩ ሃዸሳ ገድሲሰ።<verse eid="PRO 10:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 10:2"/>ቀቤኝ ከራ ሀማዻን ሆረተን ገቲ ህንቀቡ፤</para>
  <para style="q2" vid="PRO 10:2">ቀጄሉማን ገሩ ዱአ ጀላ ነመ ባሰ።<verse eid="PRO 10:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 10:3"/>
    <char style="nd">ዋቀዮ</char> አከ ወር ቀጄላን ቤለአን ህንኤየሙ፤</para>
  <para style="q2" vid="PRO 10:3">ሀዊ ጀልኦታ ገሩ ንቡሼሰ።<verse eid="PRO 10:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 10:4"/>ሀርክ ሆጂ ህንሆጄትኔ ነመ ህዮምሰ፤</para>
  <para style="q2" vid="PRO 10:4">ሀርክ ጀባቴ ሆጂ ሆጄቱ ገሩ ነመ ሶሮምሰ።<verse eid="PRO 10:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 10:5"/>ነምን ዬሮ ቦና ምዻን ወልት ቀበቱ እልመ ኦጌሰ፤</para>
  <para style="q2" vid="PRO 10:5">ከን ዬሮ ምዻን ገልፈሙት ረፉሞ <optbreak/> እልመ ነመ ቃኔሱዸ።<verse eid="PRO 10:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 10:6"/>ኤብ መታ ቀጄልቶታት ጎንፎ ካአ፤</para>
  <para style="q2" vid="PRO 10:6">አፋን ሀሞታረ ገሩ ጄቁምሰቱ ሎለአ።<verse eid="PRO 10:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 10:7"/>ያደኖን ነመ ቀጄላ ኤበ ተአ፤</para>
  <para style="q2" vid="PRO 10:7">መቃን ነመ ሀማ ገሩ ለፈራ በደ።<verse eid="PRO 10:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 10:8"/>ነምን ገራሳት ኦጌሰ ተኤ አጀጀ ፉዸተ፤</para>
  <para style="q2" vid="PRO 10:8">ጎዋን ኦዱ ባይእሱ ገሩ ንበደ።<verse eid="PRO 10:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 10:9"/>ነምን አመነማን ሶዳ መሌ ዴመ፤</para>
  <para style="q2" vid="PRO 10:9">ከን ከራሳ ጀልእሱ ገሩ ንሳጥለመ።<verse eid="PRO 10:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 10:10"/>ነምን እጀ ሀምናቲን ዋ ነማን ጄዹ ረኮ ኡመ፤</para>
  <para style="q2" vid="PRO 10:10">ጎዋን ኦዱ ባይእሱ ገሩ ንበደ።<verse eid="PRO 10:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 10:11"/>አፋን ነመ ቀጄላ ቡርቃ ጅሬኛት፤</para>
  <para style="q2" vid="PRO 10:11">አፋን ሀሞታረ ገሩ ጄቁምሰቱ ሎለአ።<verse eid="PRO 10:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 10:12"/>ጅብ ሎለ ከካሰ፤</para>
  <para style="q2" vid="PRO 10:12">ጃለል ገሩ በሌሳ ሁንደ ሀጉገ።<verse eid="PRO 10:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 10:13"/>ኦጉማን ህዺ ነመ ዋ ሁበቱረት አርገምት፤</para>
  <para style="q2" vid="PRO 10:13">ኡሌንሞ ድረ ነመ ሁበትና ህንቀብኔረ ቡአ።<verse eid="PRO 10:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 10:14"/>ነሞትን ኦጌዪን ቤኩምሰ ኩፈቱ፤</para>
  <para style="q2" vid="PRO 10:14">አፋን ጎዋ ገሩ በዲሰ ዋመ።<verse eid="PRO 10:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 10:15"/>ቀቤኝ ሶሬዪ እሳኒፍ መጋላ ደኦ ቀብዱዸ፤</para>
  <para style="q2" vid="PRO 10:15">ህዩማን ገሩ በዲሰ ህዬዪት።<verse eid="PRO 10:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 10:16"/>ምንዳን ቀጄልቶታ ጅሬኘ፤</para>
  <para style="q2" vid="PRO 10:16">ገሊን ሀሞታ ገሩ ጩቡፊ ዱአ።<verse eid="PRO 10:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 10:17"/>ነምን ጎርሰ ፉዸቱ ከራ ጅሬኛረ ዴመ፤</para>
  <para style="q2" vid="PRO 10:17">ነምን አደበ ድዱ ከምዩ ገሩ ወረ ካን ከራራ ጀልእሰ።<verse eid="PRO 10:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 10:18"/>ነምን ህዺ ሶቡን ጅበ ዾክፈቱ፣</para>
  <para style="q2" vid="PRO 10:18">ከን መቃ ነማ በሌሱስ ጎዋዸ።<verse eid="PRO 10:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 10:19"/>ዮ ዱቢን ባይአቱ፣ ጩቡን ኬሳ ህንዸበሙ፤</para>
  <para style="q2" vid="PRO 10:19">ነምን አረበሳ ኤገቱ ገሩ ኦጌሰ።<verse eid="PRO 10:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 10:20"/>አረብን ነመ ቀጄላ ሜቲ ፍለተማዸ፤</para>
  <para style="q2" vid="PRO 10:20">ገራን ነመ ሀማ ገሩ ፋይዳ ጥኖ ቀበ።<verse eid="PRO 10:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 10:21"/>አረብን ነመ ቀጄላ ነመ ሄዱ ሶረ፤</para>
  <para style="q2" vid="PRO 10:21">ጎዎትን ገሩ ሁበትና ዸቢሳን ዱኡ።<verse eid="PRO 10:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 10:22"/>ኤብ <char style="nd">ዋቀዮ</char> ነመ ሶሮምሰ፤</para>
  <para style="q2" vid="PRO 10:22">እን ረክነ ቶኮሌ እት ህንደበሉ።<verse eid="PRO 10:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 10:23"/>ጎዋን አመለ ሀማዻን ገመቹ አርገተ፤</para>
  <para style="q2" vid="PRO 10:23">ነምን ዋ ሁበቱ ገሩ ኦጉማት ገመደ።<verse eid="PRO 10:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 10:24"/>ወን ነምን ሀማን ሶዳቱ እሱመት ዹፈ፤</para>
  <para style="q2" vid="PRO 10:24">ሀዊን ነመ ቀጄላሞ ንጉተማፍ።<verse eid="PRO 10:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 10:25"/>ዬሮ ቡቤን ሀማን ቡብሱ ነሞትን ሀሞን ንበዱ፤</para>
  <para style="q2" vid="PRO 10:25">ቀጄልቶትን ገሩ በረ በራን ጀባተኒ ጅራቱ።<verse eid="PRO 10:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 10:26"/>አኩመ ወን ዸንገጋኣን እልካን ሚዼ፣ <optbreak/> ኣርስ እጀ ሚዹ ሰነ</para>
  <para style="q2" vid="PRO 10:26">ነምን ዽባኣን ወረ እሰ ኤርገቱ ሚዸ።<verse eid="PRO 10:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 10:27"/>
    <char style="nd">ዋቀዮን</char> ሶዳቹን በረ ጅሬኘ ነማ ዼሬሰ፤</para>
  <para style="q2" vid="PRO 10:27">ኡሙሪን ነመ ሀማ ገሩ ንገባበተ።<verse eid="PRO 10:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 10:28"/>አብዲን ነመ ቀጄላ ገመቹ ተአ፤</para>
  <para style="q2" vid="PRO 10:28">ወን ነምን ሀማን ኤገቱ ገሩ ንበደ።<verse eid="PRO 10:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 10:29"/>ከራን <char style="nd">ዋቀዮ</char> ነመ ቀጄላፍ ደኦዸ፤</para>
  <para style="q2" vid="PRO 10:29">ነመ ጀልኣፍ ገሩ በዲሰ።<verse eid="PRO 10:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 10:30"/>ቀጄልቶትን ዮምዩ ህንፎንቆልፈመን፤</para>
  <para style="q2" vid="PRO 10:30">ሀሞን ገሩ ለፈረት ህንሀፈን።<verse eid="PRO 10:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 10:31"/>አፋን ነመ ቀጄላ ኦጉማ ዱበተ፤</para>
  <para style="q2" vid="PRO 10:31">አረብን ጀልኣን ገሩ ንኩተመ።<verse eid="PRO 10:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 10:32"/>አረብን ነመ ቀጄላ ዋን ፉዸተመ ቀቡ ዱበተ፤</para>
  <para style="q2" vid="PRO 10:32">አፋን ነመ ሀማ ገሩ ዋን ጀልኣ ቆፈ ዱበተ።<verse eid="PRO 10:32"/></para>
  <para style="b"/>
  <chapter eid="PRO 10"/>
  <chapter number="11" style="c" sid="PRO 11"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 11:1"/>
    <char style="nd">ዋቀዮ</char> መዳሊ ህንአመነምኔ ንበልፈ፤</para>
  <para style="q2" vid="PRO 11:1">መዳሊ ዹጋትሞ ንገመደ።<verse eid="PRO 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 11:2"/>ጋፈ ኦፍ ቱሉን ዹፉ፣ ሰልጵነቱ ዹፈ፤</para>
  <para style="q2" vid="PRO 11:2">ገድ ኦፍ ቀቢሰ ወጅንሞ ኦጉማቱ ዹፈ።<verse eid="PRO 11:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 11:3"/>አመነሙማን ቶሎታ እሳን ዱረ ዴመ፤</para>
  <para style="q2" vid="PRO 11:3">ወር ህንአመነምኔ ገሩ ደቡመሳኒቲን በዱ።<verse eid="PRO 11:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 11:4"/>ጉያ ዼከምሳት ቀቤኝ ፋይዳ ህንቀቡ፤</para>
  <para style="q2" vid="PRO 11:4">ቀጄሉማን ገሩ ዱአ ጀላ ነመ ባሰ።<verse eid="PRO 11:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 11:5"/>ቀጄሉማን ወረ ሙዳ ህንቀብኔ <optbreak/> ከራ ቀጄላ ባሳፍ፤</para>
  <para style="q2" vid="PRO 11:5">ሀሞን ገሩ ሀምኑመሳኒቲን በዱ።<verse eid="PRO 11:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 11:6"/>ቀጄሉማን ቶሎታ እሳን ኦልቸ፤</para>
  <para style="q2" vid="PRO 11:6">ወር ህንአመነምኔ ገሩ <optbreak/> ሀዊ ሀማዻን ቀበሙ።<verse eid="PRO 11:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 11:7"/>ዬሮ ነምን ሀማን ዱኡ፣ አብዲንሳስ ንበደ፤</para>
  <para style="q2" vid="PRO 11:7">ወን ነምን ሀማን ኤገቱስ ንበርበዴፈመ።<verse eid="PRO 11:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 11:8"/>ነምን ቀጄላን ረኮ ጀላ ንባፈመ፤</para>
  <para style="q2" vid="PRO 11:8">ረኮን ሱንስ ቆደሳ ነመ ሀማረ ገአ።<verse eid="PRO 11:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 11:9"/>ነምን ዋቀት ህንቡሌ ዱቢ አፋንሳቲን ኦላሳ በሌሰ፤</para>
  <para style="q2" vid="PRO 11:9">ነምን ቀጄላንሞ ቤኩምሳን ምልቀ።<verse eid="PRO 11:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 11:10"/>ዮሙ ነምን ቀጄላን በዻዹ መጋላን ንገመደ፤</para>
  <para style="q2" vid="PRO 11:10">ዮሙ ነምን ሀማን በርበዳኡሞ እየ ገመቹቱ ዸገአመ።<verse eid="PRO 11:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 11:11"/>ኤበ ነመ ቶላቲን መጋላን ኡልፍነ አርገተ፤</para>
  <para style="q2" vid="PRO 11:11">አፋን ነመ ሀማቲን ገሩ ንበርበዴፈመ።<verse eid="PRO 11:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 11:12"/>ነምን ሰሙ ህንቀብኔ ኦላሳ ቱፈተ፤</para>
  <para style="q2" vid="PRO 11:12">ከን ሁበትና ቀቡ ገሩ ንጨልእሰ።<verse eid="PRO 11:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 11:13"/>ነምን ኦዴሱ ዾክሳ ገድ ባሰ፤</para>
  <para style="q2" vid="PRO 11:13">ከን አመነሙ ገሩ እጪቲ ኤገ።<verse eid="PRO 11:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 11:14"/>ቀጄልፈመ ዸቢሳን ሰብን ንኩፈ፤</para>
  <para style="q2" vid="PRO 11:14">ባይእነ ጎርስቶታቲን ገሩ ነጋቱ አርገመ።<verse eid="PRO 11:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 11:15"/>ነምን ነመ ህንቤክኔፍ ወቢ ተኡ ንረከተ፤</para>
  <para style="q2" vid="PRO 11:15">ነምን ነማፍ ከከቹፍ ጄዼ ሀርከ ዸኡ ድዱሞ <optbreak/> ነጋን ጅራተ።<verse eid="PRO 11:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 11:16"/>ዱበርቲን ገረ ላፌቲን ኡልፍነ አርገት፤</para>
  <para style="q2" vid="PRO 11:16">ነሞትን ገራ ዸጋሞ ቀቤኘ ቆፈ አርገቱ።<verse eid="PRO 11:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 11:17"/>ነምን ጋሪን ኦፍ ፈየደ፤</para>
  <para style="q2" vid="PRO 11:17">ገረ ጀቤስ ገሩ ረክነ ኦፍት ፍደ።<verse eid="PRO 11:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 11:18"/>ነምን ሀማን ምንዳ ሶባ አርገተ፤</para>
  <para style="q2" vid="PRO 11:18">ከን ቀጄሉማ ፈጫፈቱሞ በዻሰ ዹጋ አርገተ።<verse eid="PRO 11:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 11:19"/>ነምን ቀጄላን ዹጉማን ጅሬኘ አርገተ፤</para>
  <para style="q2" vid="PRO 11:19">ከን ዋን ሀማ ዱካ ቡኡ ገሩ ገረ ዱኣ አርገተ።<verse eid="PRO 11:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 11:20"/>
    <char style="nd">ዋቀዮ</char> ወረ ያደ ጀልኣ ቀበን በልፈ፤</para>
  <para style="q2" vid="PRO 11:20">ወረ ከራንሳኒ ሙዳ ህንቀብኔትሞ ንገመደ።<verse eid="PRO 11:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 11:21"/>ዋን ከነ ሁበዹ፦ ነምን ሀማን ኡቱ ህንአደበምን ህንሀፉ፤</para>
  <para style="q2" vid="PRO 11:21">ቀጄልቶትን ገሩ ብልሰ በኡ።<verse eid="PRO 11:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 11:22"/>ዱበርቲን ሚዸግዱን ቀልቢ ህንቀብኔ</para>
  <para style="q2" vid="PRO 11:22">አኩመ ቁቤላ ወርቄ ከን ፉኛን ቦዬት ጅርቱት።<verse eid="PRO 11:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 11:23"/>ወን ቀጄልቶትን ሀወን ጋሪ ተኣፍ፤</para>
  <para style="q2" vid="PRO 11:23">አብዲን ሀሞታ ገሩ ዼከምሰ ቆፈ ተአ።<verse eid="PRO 11:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 11:24"/>ነምን ቶኮ ቶሉመ ዋ ነማ ኬነ፤</para>
  <para style="q2" vid="PRO 11:24">ተኡስ እቱመ ጫልችሴ ሶሮመ፤</para>
  <para style="q2" vid="PRO 11:24">ካንሞ ዋን ኬኑ መሉ ዾወተ፤ <optbreak/> ተኡስ እኑመ ህዮመ።<verse eid="PRO 11:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 11:25"/>ነምን አርጃን ንበዻዸ፤</para>
  <para style="q2" vid="PRO 11:25">ነምን ወረ ካን ዼቡ ባሱ ኦፊሳቲሌ ዼቡ በአ።<verse eid="PRO 11:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 11:26"/>ነመ ዾክሴ ምዻን ኩፈቱ ሰብን ንአባረ፤</para>
  <para style="q2" vid="PRO 11:26">ከን ጉርጉሩፍ ፌዺ ቀቡሞ ኤበቱ ጎንፎ ተኣፍ።<verse eid="PRO 11:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 11:27"/>ነምን ዋን ጋሪ በርባዱ ጨራ ጋሪ አርገተ፤</para>
  <para style="q2" vid="PRO 11:27">ሀምን ገሩ ነመ ሀምነ በርባዱት ዹፈ።<verse eid="PRO 11:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 11:28"/>ነምን ሶሩመ ኦፊሳ አብደቱ ከምዩ ንኩፈ፤</para>
  <para style="q2" vid="PRO 11:28">ቀጄላን ገሩ አኩመ ባለ መገሪሳት ለልሰ።<verse eid="PRO 11:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 11:29"/>ነምን ማቲሳት ረኮ ፍዱ ቡቤ ቆፈ ዻለ፤</para>
  <para style="q2" vid="PRO 11:29">ጎዋንሞ ገርብቸ ነመ ኦጌሳ ተአ።<verse eid="PRO 11:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 11:30"/>እጅ ነመ ቀጄላ ሙከ ጅሬኛት፤</para>
  <para style="q2" vid="PRO 11:30">ነምን ሉቡ ነማ በራሩሞ ኦጌሰ።<verse eid="PRO 11:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 11:31"/>ኤርገ ቀጄልቶትን ለፈረት ገቲሳኒ አርገተኒ፣</para>
  <para style="q2" vid="PRO 11:31">ነምን ዋቀት ህንቡሌፊ ጩበማን <optbreak/> ሀመም ጫላ ሃአርገተኒ ሬ!<verse eid="PRO 11:31"/></para>
  <para style="b"/>
  <chapter eid="PRO 11"/>
  <chapter number="12" style="c" sid="PRO 12"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 12:1"/>ነምን አደበሙ ጃለቱ ከምዩ ቤኩምሰ ጃለተ፤</para>
  <para style="q2" vid="PRO 12:1">ከን ስሬፈሙ ጅቡ ገሩ ጎዋዸ።<verse eid="PRO 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 12:2"/>ነምን ጋሪን <char style="nd">ዋቀዮ</char> ብረት ፉዸተመ አርገተ፤</para>
  <para style="q2" vid="PRO 12:2">
    <char style="nd">ዋቀዮ</char> ገሩ ነመ ሀምነ መለቱት ንሙረ።<verse eid="PRO 12:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 12:3"/>ነምን ቶኮ ሀምናን ጀባቴ ህንዻበቱ፤</para>
  <para style="q2" vid="PRO 12:3">ቀጄላን ገሩ ህንቡቅፈሙ።<verse eid="PRO 12:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 12:4"/>ኒቲን አመለ ጋሪ ዽርሰሼቲፍ ጎንፎዸ፤</para>
  <para style="q2" vid="PRO 12:4">ኒቲን ቃኔስቱ ገሩ አኩመ ቶርቶረ ለፌሳ ኬሳት።<verse eid="PRO 12:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 12:5"/>ከሮር ቀጄልቶታ ቀጄላዸ፤</para>
  <para style="q2" vid="PRO 12:5">ጎርስ ጀልኦታ ገሩ ጎዎምሳዸ።<verse eid="PRO 12:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 12:6"/>ዱቢን ሀሞታ ዺገ ዸንገላሱፍ <optbreak/> ርጴ ነመ ኤገተ፤</para>
  <para style="q2" vid="PRO 12:6">ሃሳን ቶሎታ ገሩ ዱአ ጀላ ነመ ባሰ።<verse eid="PRO 12:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 12:7"/>ነሞትን ሀሞን ንገረገልፈሙ፤ ዴብአኒስ ህንአርገመን፤</para>
  <para style="q2" vid="PRO 12:7">መን ቀጄልቶታ ገሩ ጀባቴ ዻበተ።<verse eid="PRO 12:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 12:8"/>ነምን ቶኮ አኩመ ኦጉማሳት ጀጀመ፤</para>
  <para style="q2" vid="PRO 12:8">ነምን ያደ ጀልኣ ቀቡሞ ንቱፈተመ።<verse eid="PRO 12:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 12:9"/>ነምን ቱፈተማን ሆጄታ ቀቡ ቶኮ፣</para>
  <para style="q2" vid="PRO 12:9">ነመ ኦፍ ከበጁ ከን ዋን ኛቱዩ ህንቀብኔ ጫለ።<verse eid="PRO 12:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 12:10"/>ነምን ቀጄላን ሉቡ ሆሪሳቲፍ ያደ፤</para>
  <para style="q2" vid="PRO 12:10">ሆጂን ጀልኦታ ገሩ ቶላንሳዩ ሀምነ።<verse eid="PRO 12:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 12:11"/>ነምን ለፈሳ ቆተቱ ኛተ ጉዳ አርገተ፤</para>
  <para style="q2" vid="PRO 12:11">ከን ያደ ፋይዳ ህንቀብኔ ዱካ ቡኡ ገሩ ሁበትና ህንቀቡ።<verse eid="PRO 12:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 12:12"/>ሀሞን ቦጁ ጀልኦታ ሀዉ፤</para>
  <para style="q2" vid="PRO 12:12">ህድ ቀጄልቶታ ገሩ ንለልሰ።<verse eid="PRO 12:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 12:13"/>ነምን ሀማን ጩቡ አፋንሳቲን ቀበመ፤</para>
  <para style="q2" vid="PRO 12:13">ነምን ቀጄላን ገሩ ረኮ ጀላ ምልቀ።<verse eid="PRO 12:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 12:14"/>ነምን ዋን አፋንሳቲ በኡን ዋን ጋሪን ጉተመ፤</para>
  <para style="q2" vid="PRO 12:14">ሆጂን ሀርከ ነማስ እሱማፍ ዴብአ።<verse eid="PRO 12:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 12:15"/>ነመ ጎዋ ከራንሳ ቀጄላ እት ፈካተ፤</para>
  <para style="q2" vid="PRO 12:15">ነምን ኦጌስ ገሩ ጎርሰ ዸገአ።<verse eid="PRO 12:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 12:16"/>ኣሪን ጎዋ ዮሙሱመ እሰራ ቤከመ፤</para>
  <para style="q2" vid="PRO 12:16">ነምን ሁበታን ገሩ አረብሶ ቱፈተ።<verse eid="PRO 12:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 12:17"/>ነምኒ ዹጋ ዱበቱ ረጋ አመነማ ኬነ፤</para>
  <para style="q2" vid="PRO 12:17">ዹገ ባቱን ሶባ ገሩ ሶበ ዱበት።<verse eid="PRO 12:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 12:18"/>ዱቢን ኦፍ ኤገትና ህንቀብኔ <optbreak/> አኩመ ጎራዴ ነመ ወራነ፤</para>
  <para style="q2" vid="PRO 12:18">አረብን ነመ ኦጌሳ ገሩ ነመ ፈይሰ።<verse eid="PRO 12:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 12:19"/>አፋን ዹጋ ዱበቱ በረ በራን ጅራተ፤</para>
  <para style="q2" vid="PRO 12:19">አረብን ሶበ ዱበቱ ገሩ ዬሮ ገባባ ቆፈ ጅራተ።<verse eid="PRO 12:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 12:20"/>ገራ ወረ ዋን ሀማ መለተኒ ኬሰ <optbreak/> ጎዎምሳቱ ጅረ፤</para>
  <para style="q2" vid="PRO 12:20">ወር ነጋ ቡሰን ገሩ ገመቹ ቀቡ።<verse eid="PRO 12:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 12:21"/>ቀጄልቶተት ሚዻን ቶኮዩ ህንዹፉ፤</para>
  <para style="q2" vid="PRO 12:21">ሀሞን ረክናን ጉተሙ።<verse eid="PRO 12:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 12:22"/>
    <char style="nd">ዋቀዮ</char> አረበ ሶቡ ንጅበ፤</para>
  <para style="q2" vid="PRO 12:22">ወረ ዹጋ ዱበቱት ገሩ ንገመደ።<verse eid="PRO 12:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 12:23"/>ነምን ሁበታን ቤካ ተኡሳ ዾክፈተ፤</para>
  <para style="q2" vid="PRO 12:23">ጎዎትን ገሩ ጎዉማሳኒ ለብሱ።<verse eid="PRO 12:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 12:24"/>ሀርክ ነመ ጀባቴ ሆጄቱ ንሞአ፤</para>
  <para style="q2" vid="PRO 12:24">ዽባኡማን ገሩ ገርቡማት ነመ ጌሰ።<verse eid="PRO 12:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 12:25"/>ገራን ያደኡ ገድ ነመ ዴብሰ፤</para>
  <para style="q2" vid="PRO 12:25">ዱቢን ቶላንሞ ነመ ገመቺሰ።<verse eid="PRO 12:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 12:26"/>ነምን ቀጄላን ኦላሳ ከራ አርግሲሰ፤</para>
  <para style="q2" vid="PRO 12:26">ከራን ሀሞታ ገሩ ከራራ ነመ ጀልእሰ።<verse eid="PRO 12:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 12:27"/>ነምን ዽባኣን ዋን አደምሴ አጄሴ ህንዋደቱ፤</para>
  <para style="q2" vid="PRO 12:27">ከን ጀባቴ ሆጄቱሞ ቀቤኘ ገቲ ጉዳ አርገተ።<verse eid="PRO 12:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 12:28"/>ከራ ቀጄሉማረ ጅሬኘቱ ጅረ፤</para>
  <para style="q2" vid="PRO 12:28">ዳንዲ ሰነረ ዱት ህንጅሩ።<verse eid="PRO 12:28"/></para>
  <para style="b"/>
  <chapter eid="PRO 12"/>
  <chapter number="13" style="c" sid="PRO 13"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 13:1"/>እልም ኦጌስ ጎርሰ አባሳ ዸገአ፤</para>
  <para style="q2" vid="PRO 13:1">ቆስቱን ነማሞ ዼከምሰ ህንዸጌፈቱ።<verse eid="PRO 13:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 13:2"/>ነምን ዋን አፋንሳቲ በኡን ዋን ጋሪን ገመደ፤</para>
  <para style="q2" vid="PRO 13:2">ነምን ህንአመነምኔ ገሩ ጄቁምሳፍ አሪፈተ።<verse eid="PRO 13:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 13:3"/>ነምን አረበሳ ኤገቱ፣ ጅሬኘሳ ኤገተ፤</para>
  <para style="q2" vid="PRO 13:3">ከን ኦፍ ኤገቹ መሌ ዱበቱሞ በዱፍ አሪፈተ።<verse eid="PRO 13:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 13:4"/>ፌዺን ዽባኣ ዮምዩ ህንጉተሙ፤</para>
  <para style="q2" vid="PRO 13:4">ፌዺን ነመ ጀባቴ ሆጄቱሞ ጉቱማን ንምልካአ።<verse eid="PRO 13:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 13:5"/>ነምን ቀጄላን ሶበ ጅበ፤</para>
  <para style="q2" vid="PRO 13:5">ነምን ሀማን ገሩ ቃኒፊ ሰልጵነ ፍደ።<verse eid="PRO 13:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 13:6"/>ቀጄሉማቱ ነመ ቶላ ትክሰ፤</para>
  <para style="q2" vid="PRO 13:6">ሀምን ገሩ ጩበማ ገላፈተ።<verse eid="PRO 13:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 13:7"/>ነምን ቶኮ ሶሬሰ ኦፍ ፈኬሰ፤ ገሩ ሆማ ህንቀቡ፤</para>
  <para style="q2" vid="PRO 13:7">ቶኮሞ ህዬሰ ኦፍ ፈኬሰ፤ ገሩ ቀቤኘ ጉዳ ቀበ።<verse eid="PRO 13:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 13:8"/>ሶሩምን ነመ ቶኮ ፉሪ ጅሬኘሳ ተኡ ደንደአ፤</para>
  <para style="q2" vid="PRO 13:8">ህዬስ ገሩ እፈትና ህንዸገኡ።<verse eid="PRO 13:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 13:9"/>እፍን ነመ ቀጄላ አከ ጋሪ እፈ፤</para>
  <para style="q2" vid="PRO 13:9">እብሳን ነመ ሀማ ገሩ ንዻመ።<verse eid="PRO 13:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 13:10"/>ኦፍ ቱሉማን ሎለ ቆፈ ባይእሰ፤ ኦጉማን ገሩ</para>
  <para style="q2" vid="PRO 13:10">ወረ ጎርሰ ዸገአን ብረት አርገምት።<verse eid="PRO 13:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 13:11"/>ማለቅን ከራ ሶባቲን ዹፉ ደፌ በደ፤</para>
  <para style="q2" vid="PRO 13:11">ነምን ጥኖ ጥኖን ማለቀ ወልት ቀበቱ ገሩ ንኩፈተ።<verse eid="PRO 13:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 13:12"/>አብዲን ለፈረ ሀርክፈቱ ገራ ነመ ዹኩብሰ፤</para>
  <para style="q2" vid="PRO 13:12">ሀዊን ጉተሙ ገሩ ሙከ ጅሬኛት።<verse eid="PRO 13:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 13:13"/>ነምን ጎርሰ ቱፈቱ በዲሰ ኦፍት ፍደ፤</para>
  <para style="q2" vid="PRO 13:13">ከን አጀጀ ኡልፌሱሞ በዻሰ አርገተ።<verse eid="PRO 13:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 13:14"/>በርሲስን ነመ ኦጌሳ ቡርቃ ጅሬኛት፤</para>
  <para style="q2" vid="PRO 13:14">ክዮ ዱኣራስ ነመ ዴብሰ።<verse eid="PRO 13:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 13:15"/>ሁበትናን ጋሪን ሱራ አርገምሲሰ፤</para>
  <para style="q2" vid="PRO 13:15">ከራን ወረ ህንአመነምኔ ገሩ <optbreak/> በዲሰት እሳን ጌሰ።<verse eid="PRO 13:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 13:16"/>ነምን ቀልቢ ቀቡ ከምዩ ቤኩምሳን ሆጄተ፤</para>
  <para style="q2" vid="PRO 13:16">ጎዋንሞ ጎዉማሳ ሙልእሰ።<verse eid="PRO 13:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 13:17"/>ኤርገማን ሀማን ረኮ ኬሰ ሴነ፤</para>
  <para style="q2" vid="PRO 13:17">ኤርገማን አመነማን ገሩ ፈይነ ፍደ።<verse eid="PRO 13:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 13:18"/>ነምን አደበሙ ጅቡ ንህዮመ፤ ንቃነአስ፤</para>
  <para style="q2" vid="PRO 13:18">ከን ስሬፈመ ከበጁሞ ኡልፍነ አርገተ።<verse eid="PRO 13:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 13:19"/>ሀዊን ጉተሜ ነመት ምኣወ፤</para>
  <para style="q2" vid="PRO 13:19">ጎዎትን ገሩ ዋን ሀማራ ዴብኡ በልፉ።<verse eid="PRO 13:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 13:20"/>ነምን ነመ ኦጌሰ ወጅን ዴሙ ኦጌሰ ተአ፣</para>
  <para style="q2" vid="PRO 13:20">ምቹን ጎዎታ ገሩ ንሚዸመ።<verse eid="PRO 13:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 13:21"/>ወን ሀማን ጩበሞተ አርአተ፤</para>
  <para style="q2" vid="PRO 13:21">በዻዹማንሞ በዻሰ ቀጄሎታት።<verse eid="PRO 13:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 13:22"/>ነምን ጋሪን እልማን እልማንሳቲፍ ዻለ ደበርሰ፤</para>
  <para style="q2" vid="PRO 13:22">ቀቤኝ ነመ ጩበማ ገሩ ቀጄልቶታፍ ኩፈመ።<verse eid="PRO 13:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 13:23"/>ቆናን ህዬሳ ምዻን ጉዳ ባሰ፤</para>
  <para style="q2" vid="PRO 13:23">ሙርቲን ጀልኣን ገሩ ሀጣኤ ዱራ በሌሰ።<verse eid="PRO 13:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 13:24"/>ነምን ሀርጩሜ ቁሰቱ እልመሳ ጅበ፤</para>
  <para style="q2" vid="PRO 13:24">ከን እልመ ኦፊ ጃለቱሞ እላለቻ እሰ አደበ።<verse eid="PRO 13:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 13:25"/>ነምን ቀጄላን ሀመ ቁፉት ኛተ፤</para>
  <para style="q2" vid="PRO 13:25">ገራን ነመ ሀማ ገሩ ንቤለአ።<verse eid="PRO 13:25"/></para>
  <para style="b"/>
  <chapter eid="PRO 13"/>
  <chapter number="14" style="c" sid="PRO 14"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 14:1"/>ዱበርቲን ኦጌቲን መነሼ እጃረት፤</para>
  <para style="q2" vid="PRO 14:1">ጎዋንሞ ሀርኩመሼቲን መነ ኦፊ ዲግድ።<verse eid="PRO 14:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 14:2"/>ነምን ቀጄሉማን ጅራቱ <char style="nd">ዋቀዮን</char> ሶዳተ፤</para>
  <para style="q2" vid="PRO 14:2">ከን ከራንሳ ጀልኣ ተኤ ገሩ እሰ ቱፈተ።<verse eid="PRO 14:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 14:3"/>አፋን ነመ ጎዋ ዱግደሳት ኡሌ ኦፍ ቱሉማ ፍደ፤</para>
  <para style="q2" vid="PRO 14:3">አረብን ኦጌዪ ገሩ እሳን ኤገ።<verse eid="PRO 14:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 14:4"/>ዮ ቆትዮን ህንጅሬ፣ ደላን ዱዋ ተአ፤</para>
  <para style="q2" vid="PRO 14:4">ገሩ ሁምነ ቆትዮ ቶኮቲን ምዻን ባይኤን አርገመ።<verse eid="PRO 14:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 14:5"/>ዹገ ባቱን አመነማን ህንሶቡ፤</para>
  <para style="q2" vid="PRO 14:5">ዹገ ባቱን ሶባሞ ዸረ ኦፍ ኬሳ ገድ ነቀ።<verse eid="PRO 14:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 14:6"/>ቆስቱን ነማ ኦጉማ በርባዴ ህንአርገቱ፤</para>
  <para style="q2" vid="PRO 14:6">ነመ ዋ ሁበቱፍ ገሩ ቤኩምስ ደዸቢ መሌ ዹፈ።<verse eid="PRO 14:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 14:7"/>አት ነመ ጎዋራ ፈጋዹ፤</para>
  <para style="q2" vid="PRO 14:7">አረበሳራ ቤኩምሰ ህንአርገቱቲ።<verse eid="PRO 14:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 14:8"/>ኦጉማን ሁበቶታ አከ እሳን ከራሳኒ ቤከን እሳን ጎዸ፤</para>
  <para style="q2" vid="PRO 14:8">ጎዉማን ጎዎታ ገሩ ከራራ እሳን በሌሰ።<verse eid="PRO 14:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 14:9"/>ጎዎትን ጩቡት ቆሱ፤</para>
  <para style="q2" vid="PRO 14:9">ቀጄልቶተ ግዱት ገሩ ሀዊ ጋሪቱ አርገመ።<verse eid="PRO 14:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 14:10"/>ገራን ገደ ኦፊሳ ንቤከ፤</para>
  <para style="q2" vid="PRO 14:10">ነምን ብራ ቶኮዩ ገመቹሳራ ህንቆደቱ።<verse eid="PRO 14:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 14:11"/>መን ነመ ሀማ ንበደ፤</para>
  <para style="q2" vid="PRO 14:11">ዱንካን ነመ ቀጄላሞ ንደራረ።<verse eid="PRO 14:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 14:12"/>ከራን ቀጄላ ነመት ፈካቱ ቶኮ ጅረ፤</para>
  <para style="q2" vid="PRO 14:12">ዹመረት ገሩ ዱአት ነመ ጌሰ።<verse eid="PRO 14:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 14:13"/>ኮልፈ ኬሰትዩ ገራን ነመ ዹኩቡ ደንደአ፤</para>
  <para style="q2" vid="PRO 14:13">ገመቹንስ ገዳን ዹሙ ደንደአ።<verse eid="PRO 14:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 14:14"/>ነምን ህንአመነምኔ ገቲ ከራሳ፣</para>
  <para style="q2" vid="PRO 14:14">ነምን ጋሪንሞ ገቲ ሆጂሳ አርገተ።<verse eid="PRO 14:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 14:15"/>ነምን ሆማ ህንቤክኔ ዋን ሁንደ አመነ፤</para>
  <para style="q2" vid="PRO 14:15">ነምን ቀልቢ ቀቡ ገሩ ተርካንፊሳ እላለተ።<verse eid="PRO 14:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 14:16"/>ነምን ኦጌስ ኦፍ ኤገተ፤ ዋን ሀማራስ ንዴብአ፤</para>
  <para style="q2" vid="PRO 14:16">ጎዋን ገሩ ዋን ሁንደት ጀርጀረ፤ ኦፍሌ ህንኤገቱ።<verse eid="PRO 14:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 14:17"/>ነምን ደፌ ኣሩ ጎዉማ ሆጄተ፤</para>
  <para style="q2" vid="PRO 14:17">ነምን ደበ ሆጄቱ ገሩ ንጅበመ።<verse eid="PRO 14:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 14:18"/>ነምን ሆማ ህንቤክኔ ጎዉማ ዻለ፤</para>
  <para style="q2" vid="PRO 14:18">ቀልቤፈታን ገሩ ቤኩምሰ ጎንፈተ።<verse eid="PRO 14:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 14:19"/>ነሞትን ሀሞን ፉለ ነሞተ ጋሪ ዱረት፣</para>
  <para style="q2" vid="PRO 14:19">ጀልኦንስ ከረ ቀጄልቶታ ዱረት ሰገዱ።<verse eid="PRO 14:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 14:20"/>ህዬዪ ኦሎንሳኒዩ ንጅቡ፤</para>
  <para style="q2" vid="PRO 14:20">ሶሬዪንሞ ምቾተ ሄዱ ቀቡ።<verse eid="PRO 14:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 14:21"/>ነምን ኦላሳ ቱፈቱ ጩቡ ሆጄተ፤</para>
  <para style="q2" vid="PRO 14:21">ከን ረከታፍ ገራ ላፉ ገሩ ኤብፈማዸ።<verse eid="PRO 14:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 14:22"/>ነምን ሀምነ ያዱ ከራራ ህንበዱ?</para>
  <para style="q2" vid="PRO 14:22">ወር ዋን ጋሪ ከሮርሰን ገሩ ጃለላፊ <optbreak/> አመነሙማ አርገቱ።<verse eid="PRO 14:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 14:23"/>ጀባተኒ ሆጄቹን ሁንድ ቡኣ ቡሰ፤</para>
  <para style="q2" vid="PRO 14:23">ኦዱን ፋይዳ ህንቀብኔ ገሩ ህዩማ ቆፈ ፍደ።<verse eid="PRO 14:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 14:24"/>ጎንፎን ኦጌዪ ቀቤኘሳኒት፤</para>
  <para style="q2" vid="PRO 14:24">ጎዉማን ጎዎታ ገሩ ጎዉማ ዸለ።<verse eid="PRO 14:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 14:25"/>ዹገ ባቱን ዹጋ ሉቡ በራረ፤</para>
  <para style="q2" vid="PRO 14:25">ዹገ ባቱን ሶባሞ ሶበ ዱበተ።<verse eid="PRO 14:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 14:26"/>ነምን <char style="nd">ዋቀዮን</char> ሶዳቱ ደአኖ ጀባ ቀበ፤</para>
  <para style="q2" vid="PRO 14:26">እጆሌንሳስ ደኦ አርገቱ።<verse eid="PRO 14:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 14:27"/>
    <char style="nd">ዋቀዮን</char> ሶዳቹን ቡርቃ ጅሬኛት፤</para>
  <para style="q2" vid="PRO 14:27">ክዮ ዱኣራስ ነመ ዴብሰ።<verse eid="PRO 14:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 14:28"/>ኡልፍን ሞቲ ቶኮ ባይእነ ኡመተሳት፤</para>
  <para style="q2" vid="PRO 14:28">ዮ ኡመትን ህንጅሬ ገሩ እልም ሞቲስ ንበደ።<verse eid="PRO 14:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 14:29"/>ነምን ኦብሰ ቀቡ ሁበትና ጉዳ ቀበ፤</para>
  <para style="q2" vid="PRO 14:29">ከን ደፌ ኣሩ ገሩ ጎዉማ ሙልእሰ።<verse eid="PRO 14:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 14:30"/>ገራን ነጋ ቀቡ ዸግናፍ ጅሬኘ ኬነ፤</para>
  <para style="q2" vid="PRO 14:30">ህናፋን ገሩ ለፌ ቶርቶርሰ።<verse eid="PRO 14:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 14:31"/>ነምን ህዬሰ ጩንቁርሱ ከን እሰ ኡሜ ቱፈተ፤</para>
  <para style="q2" vid="PRO 14:31">ነምን ህዬሳፍ ገራ ላፉሞ ዋቀ ከበጀ።<verse eid="PRO 14:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 14:32"/>ሀሞን ጀልእኑመሳኒቲን በዱ፤</para>
  <para style="q2" vid="PRO 14:32">ቀጄልቶትን ገሩ ዱአ ኬሰትሌ <optbreak/> አመነሙማሳኒቲን ደአትኖ አርገቱ።<verse eid="PRO 14:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 14:33"/>ኦጉማን ቀልቢ ነመ ዋ ሁበቱ ኬሰ ጅርት፤</para>
  <para style="q2" vid="PRO 14:33">ገራ ጎዎታ ኬሰት ገሩ ህንቤከምቱ።<verse eid="PRO 14:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 14:34"/>ቀጄሉማን ሰበ ኦል ጉድሰ፤</para>
  <para style="q2" vid="PRO 14:34">ጩቡን ገሩ ሰበ ከሚፍዩ ሰልጵነ።<verse eid="PRO 14:34"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 14:35"/>ሞቲን ተጃጅላ ኦጌሰት ንገመደ፤</para>
  <para style="q2" vid="PRO 14:35">ከን እሰ ቃኔሱት ገሩ ንዼከመ።<verse eid="PRO 14:35"/></para>
  <para style="b"/>
  <chapter eid="PRO 14"/>
  <chapter number="15" style="c" sid="PRO 15"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 15:1"/>ዴቢን ላፋን ዼከምሰ ቀበኔሰ፤</para>
  <para style="q2" vid="PRO 15:1">ጄች ሀማን ገሩ ኣሪ ከካሰ።<verse eid="PRO 15:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 15:2"/>አረብን ነመ ኦጌሳ ቤኩምሰ ጀጀ፤</para>
  <para style="q2" vid="PRO 15:2">አፋን ነመ ጎዋ ገሩ ጎዉማ ዸንገላሰ።<verse eid="PRO 15:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 15:3"/>እጅ <char style="nd">ዋቀዮ</char> እዱመ ሁንደ ጅረ፤</para>
  <para style="q2" vid="PRO 15:3">ነመ ሀማፊ ጋሪስ ንቶአተ።<verse eid="PRO 15:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 15:4"/>አረብን ፈይነ ፍዱ ሙከ ጅሬኛት፤</para>
  <para style="q2" vid="PRO 15:4">አረብን ሶቡ ገሩ ሀፉረ ጨብሰ።<verse eid="PRO 15:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 15:5"/>ጎዋን አደቢ አባሳ ቱፈተ፤</para>
  <para style="q2" vid="PRO 15:5">ነምን ስሬፈመ ፉዸቱ ከምዩ ገሩ ቀልቢ ቀቤሰ።<verse eid="PRO 15:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 15:6"/>መን ነመ ቀጄላ በዻዹማ ጉዳ ቀበ፤</para>
  <para style="q2" vid="PRO 15:6">ገሊን ነመ ሀማ ገሩ ረኮ እሰት ፍደ።<verse eid="PRO 15:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 15:7"/>አረብን ነመ ኦጌሳ ቤኩምሰ ፈጫሰ፤</para>
  <para style="q2" vid="PRO 15:7">ገራን ነመ ጎዋ ገሩ አከስ ምት።<verse eid="PRO 15:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 15:8"/>
    <char style="nd">ዋቀዮ</char> ኣርሳ ሀሞታ ንበልፈ፤</para>
  <para style="q2" vid="PRO 15:8">ከዸናን ቶሎታ ገሩ እሰ ገመቺሰ።<verse eid="PRO 15:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 15:9"/>
    <char style="nd">ዋቀዮ</char> ከራ ሀሞታ ንበልፈ፤</para>
  <para style="q2" vid="PRO 15:9">ወረ ቀጄሉማ ዱካ ቡአን ገሩ ንጃለተ።<verse eid="PRO 15:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 15:10"/>ነመ ዳንዲራ ጀልአቱ አደቢ ሀማቱ እሰ ኤገተ፤</para>
  <para style="q2" vid="PRO 15:10">ከን ስሬፈመ ጅቡ ንዱአ።<verse eid="PRO 15:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 15:11"/>ዱኣፊ በዲስን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ቤከሞዸ፤</para>
  <para style="q2" vid="PRO 15:11">ዮስ ገራን ነማ ሀመም ጫላ ሃቤከሙ ሬ!<verse eid="PRO 15:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 15:12"/>ነምን ቆሱ ስሬፈመ ህንጃለቱ፤</para>
  <para style="q2" vid="PRO 15:12">ነመ ኦጌሳንስ ህንመርአቱ።<verse eid="PRO 15:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 15:13"/>ገራን ገመዱ አከ ፉል እፉ ጎዸ፤</para>
  <para style="q2" vid="PRO 15:13">ገድ ገራ ገሩ ሀፉረ ጨብሰ።<verse eid="PRO 15:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 15:14"/>ገራን ዋ ቀልቤፈቱ ቤኩምሰ በርባደ፤</para>
  <para style="q2" vid="PRO 15:14">አፋን ጎዋ ገሩ ጎዉማ ኛተ።<verse eid="PRO 15:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 15:15"/>በር ነመ ሀጩጨሜ ጉቱማን ጉቱት ገደዶዸ፤</para>
  <para style="q2" vid="PRO 15:15">ገራ ገመዱፍ ገሩ ጉያን ሁንድኑ ጭዸ።<verse eid="PRO 15:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 15:16"/>ቀቤኘ ጉዳ ረክነ ኦፍ ኬሳ ቀቡ መና፣</para>
  <para style="q2" vid="PRO 15:16">
    <char style="nd">ዋቀዮን</char> ሶዳቻ ዋን ጥና ቀባቹ ወየ።<verse eid="PRO 15:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 15:17"/>ጅባን ጮመ ሰንጋ ኛቹ መና፣</para>
  <para style="q2" vid="PRO 15:17">ጃለላን ራፉ ኛቹ ወየ።<verse eid="PRO 15:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 15:18"/>ነምን ደፌ ኣሩ ሎለ ከካሰ፤</para>
  <para style="q2" vid="PRO 15:18">ነምን ኦብሰ ቀቡ ገሩ ሎለ ቀበኔሰ።<verse eid="PRO 15:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 15:19"/>ከራን ነመ ዽባኣ ቆራቲዻን ጩፈመ፤</para>
  <para style="q2" vid="PRO 15:19">ዳንዲን ቶሎታ ገሩ ከራ ድሪራዸ።<verse eid="PRO 15:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 15:20"/>እልም ኦጌስ አባሳ ገመቺሰ፤</para>
  <para style="q2" vid="PRO 15:20">ነምን ጎዋን ገሩ ሃዸሳ ቱፈተ።<verse eid="PRO 15:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 15:21"/>ነመ ቀልቢ ህንቀብኔ ጎዉማቱ እሰ ገመቺሰ፤</para>
  <para style="q2" vid="PRO 15:21">ነምን ሁበታን ገሩ ዳንዲ ቀጄላረ ዴመ።<verse eid="PRO 15:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 15:22"/>ከሮር ጎርሰ ህንቀብኔ ፊጣን ህንበኡ፤</para>
  <para style="q2" vid="PRO 15:22">ገሩ ጎርስቶተ ሄዱዻን ንምልካአ።<verse eid="PRO 15:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 15:23"/>ነምን ቶኮ ዴቢ መሉ ኬኑዻን ገመቹ አርገተ፤</para>
  <para style="q2" vid="PRO 15:23">ዱቢን ዬሮሳት ዱበተሙ አከም ጋሪዸ!<verse eid="PRO 15:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 15:24"/>ዳንዲን ነመ ሁበታ አከ እን ሲኦልት ገድ ህንቡኔፍ</para>
  <para style="q2" vid="PRO 15:24">ገረ ጅሬኛት ኦል እሰ ባሰ።<verse eid="PRO 15:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 15:25"/>
    <char style="nd">ዋቀዮ</char> መነ ነመ ኦፍ ቱሉ ንዲገ፤</para>
  <para style="q2" vid="PRO 15:25">ዳንጋ ሃዸ ህዬሳ ገሩ ንዻበ።<verse eid="PRO 15:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 15:26"/>
    <char style="nd">ዋቀዮ</char> ያደ ነመ ሀማ ንበልፈ፤</para>
  <para style="q2" vid="PRO 15:26">ያድን ነመ ቁልቁሉ ገሩ እሰ ገመቺሰ።<verse eid="PRO 15:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 15:27"/>ነምን ዶቅን ማቲሳት ረክነ ፍደ፤</para>
  <para style="q2" vid="PRO 15:27">ከን መተኣ ጅቡ ገሩ ንጅራተ።<verse eid="PRO 15:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 15:28"/>ገራን ነመ ቀጄላ ሃለ እቲን ዴቢ ኬኑ ያደ፤</para>
  <para style="q2" vid="PRO 15:28">አፋን ነመ ሀማ ገሩ ሀምነ ዸንገላሰ።<verse eid="PRO 15:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 15:29"/>
    <char style="nd">ዋቀዮ</char> ነመ ሀማራ ፈጎ ጅረ፤</para>
  <para style="q2" vid="PRO 15:29">ከዸትና ነመ ቀጄላ ገሩ ንዸገአ።<verse eid="PRO 15:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 15:30"/>ፉል እፋን ገራ ገመቺሰ፤</para>
  <para style="q2" vid="PRO 15:30">ኦዱን ጋሪንስ ለፌ ሃሮምሰ።<verse eid="PRO 15:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 15:31"/>ነምን አደቢ ጅሬኘ ኬኑ ዸጌፈቱ፣</para>
  <para style="q2" vid="PRO 15:31">ኦጌዪ ግዱ ጅራተ።<verse eid="PRO 15:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 15:32"/>ነምን አደቢ ቱፈቱ ኦፉመ ቱፈተ፤</para>
  <para style="q2" vid="PRO 15:32">ከን ስሬፈመ ፉዸቱ ገሩ ሁበትና አርገተ።<verse eid="PRO 15:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 15:33"/>
    <char style="nd">ዋቀዮን</char> ሶዳቹን ኦጉማ ነመ በርሲሰ፤</para>
  <para style="q2" vid="PRO 15:33">ገድ ኦፍ ቀቡንስ ኡልፍነ ዱረ ዹፈ።<verse eid="PRO 15:33"/></para>
  <para style="b"/>
  <chapter eid="PRO 15"/>
  <chapter number="16" style="c" sid="PRO 16"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 16:1"/>ከሮር ገራ ከን ነማት፤</para>
  <para style="q2" vid="PRO 16:1">ዴቢን አረባ ገሩ <char style="nd">ዋቀዮ</char> ብራ ዹፈ።<verse eid="PRO 16:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 16:2"/>ነመ ቶኮ ከራንሳ ሁንድ ቁልቁሉ እት ፈካተ፤</para>
  <para style="q2" vid="PRO 16:2">ያደ ነማ ገሩ <char style="nd">ዋቀዮቱ</char> መዳለ።<verse eid="PRO 16:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 16:3"/>ዋን ሆጄቱ ሁንደ <char style="nd">ዋቀዮት</char> ኬነዹ፤</para>
  <para style="q2" vid="PRO 16:3">ከሮርኬስ ሲፍ ምልካአ።<verse eid="PRO 16:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 16:4"/>
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ካዮ ኦፊሳቲፍ ሆጄተ፤</para>
  <para style="q2" vid="PRO 16:4">ሀሞተዩ ጉያ በዲሳቲፍ ቆጴሰ።<verse eid="PRO 16:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 16:5"/>ነምን ኦፍ ቱሉ ከምዩ ፉለ <char style="nd">ዋቀዮ</char> ዱረት በልፈማዸ፤</para>
  <para style="q2" vid="PRO 16:5">ዹጉማን እን ኡቱ ህንአደበምን ህንሀፉ።<verse eid="PRO 16:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 16:6"/>ነምን ጃለላፊ አመነሙማዻን አራረ ጩቡ አርገተ፤</para>
  <para style="q2" vid="PRO 16:6">
    <char style="nd">ዋቀዮን</char> ሶዳቹዻንስ ሀምነራ ጭተ።<verse eid="PRO 16:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 16:7"/>ዮ ከራን ነማ <char style="nd">ዋቀዮን</char> ገመቺሴ፣</para>
  <para style="q2" vid="PRO 16:7">እን አከ ዲኖትንሳስ ነጋን እሰ ወጅን ጅራተን ንጎዸ።<verse eid="PRO 16:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 16:8"/>ገሊ ጉዳ ጀልእናን አርገተን መና</para>
  <para style="q2" vid="PRO 16:8">ዋን ጥኖ ቀጄሉማን አርገተን ወየ።<verse eid="PRO 16:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 16:9"/>ነምን ገራሳ ኬሰት ከራሳ ከሮርፈተ፤</para>
  <para style="q2" vid="PRO 16:9">
    <char style="nd">ዋቀዮ</char> ገሩ ተርካንፊሳሌ ንሙርቴሰ።<verse eid="PRO 16:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 16:10"/>ህዺን ሞቲ ሆደ ዱበተ፤</para>
  <para style="q2" vid="PRO 16:10">አፋንሳሌ ሙርቲ ህንጀልእሱ።<verse eid="PRO 16:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 16:11"/>መዳሊፊ ሰፈርቱን ቀጄላን ከን <char style="nd">ዋቀዮት</char>፤</para>
  <para style="q2" vid="PRO 16:11">ኡልፍን ኮሮጆ ኬሰ ጅሩ ሁንድኑ ሆጂሳት።<verse eid="PRO 16:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 16:12"/>ሰበቢ ቴሶን ቀጄሉማዻን ጀባቴ ዻበቱፍ</para>
  <para style="q2" vid="PRO 16:12">ሞቶትን ዋን ሀማ ሆጄቹ ንበልፉ።<verse eid="PRO 16:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 16:13"/>ሞቶትን አፋን ዹጋ ዱበቱት ንገመዱ፤</para>
  <para style="q2" vid="PRO 16:13">እሳን ነመ ዹጋ ዱበቱ ንጃለቱ።<verse eid="PRO 16:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 16:14"/>ዼከምስ ሞቲ ኤርገማ ዱኣት፤</para>
  <para style="q2" vid="PRO 16:14">ነምን ኦጌስ ገሩ ንቀበኔሰ።<verse eid="PRO 16:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 16:15"/>ጅሬኝ እፈ ፉለ ሞቲ ኬሰ ጅረ፤</para>
  <para style="q2" vid="PRO 16:15">ሱራንሳ አኩመ ዱሜሰ ቦካ አርፋሳት።<verse eid="PRO 16:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 16:16"/>ኦጉማ አርገቹን ወርቄ ጫለ፤</para>
  <para style="q2" vid="PRO 16:16">ሁበትና አርገቹንስ ሜቲ ጫለ!<verse eid="PRO 16:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 16:17"/>ዳንዲን ነመ ቶላ ሀምነራ ፈጎዸ፤</para>
  <para style="q2" vid="PRO 16:17">ነምን ከራሳ ኤጉስ ጅሬኘሳ ኤገተ።<verse eid="PRO 16:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 16:18"/>ኦፍ ቱሉን በዲሳን ዱረ፣</para>
  <para style="q2" vid="PRO 16:18">ኦፍ ቦኮክሱንስ ኩፋቲን ዱረ ዴመ።<verse eid="PRO 16:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 16:19"/>ወረ ኦፍ ቱሉ ወጅን ቦጁ ቆደቹ መና፣</para>
  <para style="q2" vid="PRO 16:19">ሀፉራን ገድ ኦፍ ቀበኒ ወረ ጩንቁርፈሜ ወጅን ጅራቹ ወየ።<verse eid="PRO 16:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 16:20"/>ነምን ጎርሰ ፉዸቱ ከምዩ ንምልካአ፤</para>
  <para style="q2" vid="PRO 16:20">ከን <char style="nd">ዋቀዮን</char> አመነቱስ ኤብፈማዸ።<verse eid="PRO 16:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 16:21"/>ነምን ገራዻን ኦጌሰ ተኤ ቀልቤፈታ ጄዸመ፤</para>
  <para style="q2" vid="PRO 16:21">ዱቢን ምኣዉሞ ጎርሰ ደበለ።<verse eid="PRO 16:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 16:22"/>ሁበትናን ነመ እሰ ቀቡፍ መደ ጅሬኛት፤</para>
  <para style="q2" vid="PRO 16:22">ጎዉማን ገሩ ጎዎተት አደቢ ፍደ።<verse eid="PRO 16:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 16:23"/>ገራን ነመ ኦጌሳ አረበሳ ቀጄልቸ፤</para>
  <para style="q2" vid="PRO 16:23">አፋንሳስ ጎርሰ ደበለ።<verse eid="PRO 16:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 16:24"/>ዱቢን ነመ ገመቺሱ ዻበ ደማት፤</para>
  <para style="q2" vid="PRO 16:24">እን ሉቡት ንምኣወ፤ ለፌስ ንፈይሰ።<verse eid="PRO 16:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 16:25"/>ከራን ቀጄላ ነመት ፈካቱ ቶኮ ጅረ፤</para>
  <para style="q2" vid="PRO 16:25">ዹመረት ገሩ ዱአት ነመ ጌሰ።<verse eid="PRO 16:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 16:26"/>ፌዺን ሆጄታን ቶኮ ኛታፍ ቀቡ</para>
  <para style="q2" vid="PRO 16:26">ሆጂፍ እሰ ከካሰ፤ ቤለኡንሳስ እቱመ ጭመ።<verse eid="PRO 16:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 16:27"/>ነምን ፋይዳ ህንቀብኔ ሀምነ መለተ፤</para>
  <para style="q2" vid="PRO 16:27">ሃሳንሳስ አኩመ እብደ ዋ ጉቡት።<verse eid="PRO 16:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 16:28"/>ነምን ጀልኣን ሎለ ከካሰ፤ ሀመቱንሞ</para>
  <para style="q2" vid="PRO 16:28">ምቾተ ወልት ዽኣተን ገርገር ባፍት።<verse eid="PRO 16:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 16:29"/>ነምን ጄቁምሳን ዴሙ ኦላሳ ጎዎምሴ</para>
  <para style="q2" vid="PRO 16:29">ከራ ጀልኣት እሰ ጌሰ።<verse eid="PRO 16:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 16:30"/>ነምን እጀ ቅሱ ጀልእነ ከሮርፈተ፤</para>
  <para style="q2" vid="PRO 16:30">ከን ህዺ ጭኒነቱሞ ሀምነ ፍደ።<verse eid="PRO 16:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 16:31"/>አሪን ጎንፎ ኡልፍናት፤</para>
  <para style="q2" vid="PRO 16:31">እንስ ከራ ቀጄላዻን አርገመ።<verse eid="PRO 16:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 16:32"/>ጎተ ወራናረ ነመ ኦብሰ ቀቡ፣</para>
  <para style="q2" vid="PRO 16:32">ነመ መጋላ ቶኮ ቦጅኤ ፉዸቱረ ከን ኦፍ ቀቡ ወየ።<verse eid="PRO 16:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 16:33"/>እጣን ጉዴደረት ቡፈመ፤</para>
  <para style="q2" vid="PRO 16:33">ሙርቶትንሳ ገሩ ጉቱማን ጉቱት <char style="nd">ዋቀዮ</char> ብራ ዹፈ።<verse eid="PRO 16:33"/></para>
  <para style="b"/>
  <chapter eid="PRO 16"/>
  <chapter number="17" style="c" sid="PRO 17"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 17:1"/>መነ ኛታ ዹጋቲን ጉተሜ ከን ሎለ ቀቡ መና፣</para>
  <para style="q2" vid="PRO 17:1">እዶ ነጋን ጅሩት ሁራኣ ቡዴነ ጎጎጋ ወየ።<verse eid="PRO 17:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 17:2"/>ገርብች ሁበታን እልመ ሰልጳ ቡልቸ፤</para>
  <para style="q2" vid="PRO 17:2">ኦቦሎተ ግዱትስ ዻለ ቆደተ።<verse eid="PRO 17:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 17:3"/>ኦኮቴን ዋ እት በቅሰን ሜቲፍ፣ ቦል እብዳሞ ወርቄፍ፤</para>
  <para style="q2" vid="PRO 17:3">
    <char style="nd">ዋቀዮ</char> ገሩ ገራ ነማ ቆረ።<verse eid="PRO 17:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 17:4"/>ነምን ሀማን ዱቢ ጎዎምሳ ዸጌፈተ፤</para>
  <para style="q2" vid="PRO 17:4">ሶባንስ አረበ በለአማዻፍ ጉረ ኬነ።<verse eid="PRO 17:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 17:5"/>ነምን ህዬዪት ቆሱ ከን እሳን ኡሜ ሰነ ቱፈተ፤</para>
  <para style="q2" vid="PRO 17:5">ከን በዲሰ ነማት ገመዱ ኡቱ ህንአደበምን ህንሀፉ።<verse eid="PRO 17:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 17:6"/>ነመ ጃሬ ቶኮፍ እልማን እልማንሳ ጎንፎዸ፤</para>
  <para style="q2" vid="PRO 17:6">ሃዻፊ አባንስ እጆሌሳኒቲፍ ኡልፍነ።<verse eid="PRO 17:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 17:7"/>ዱቢን በኤስ ነመ ጎዋት ህንቶሉ፤</para>
  <para style="q2" vid="PRO 17:7">ህዺን ሶቡሞ ሀመም ቡልቻ ቶኮት ሃሀማቱሬ!<verse eid="PRO 17:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 17:8"/>መተኣን ነምቸ ኬኑፍ ምአ ፈልፈላት፤</para>
  <para style="q2" vid="PRO 17:8">እን ለፈ ዸቁ ከምትዩ ንምልካአ።<verse eid="PRO 17:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 17:9"/>ነምን በሌሳ ነማፍ ዺሱ ጃለለ ጉድሰ፤</para>
  <para style="q2" vid="PRO 17:9">ነምን ዋን ቶኮረ ዴዴብኡ፣ <optbreak/> ገሩ ምቾተ ወልት ዽኣተን ገርገር ባሰ።<verse eid="PRO 17:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 17:10"/>ሀመ ጎዋን ዬሮ ዽበ ገረፈሜ እት ዸገአሙ ጫላ</para>
  <para style="q2" vid="PRO 17:10">እፈትናን ነመ ዋ ሁበቱት ዸገአመ።<verse eid="PRO 17:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 17:11"/>ነምን ሀማን ፍንጭለ ቆፈ በርባደ፤</para>
  <para style="q2" vid="PRO 17:11">ኤርገማን ነማ ህንናኔ እሰት ንኤርገመ።<verse eid="PRO 17:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 17:12"/>ጎዋ ጎዉማ እሰ ኬሰ ጅሩን</para>
  <para style="q2" vid="PRO 17:12">ወልት ዹፉ መና አማኬተ ዸልቱ እልማንሼ <optbreak/> ጀላ ፉዸተመኒን ወልት ዹፉ ወየ።<verse eid="PRO 17:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 17:13"/>ነመ ቆደ ጋሪ ሀማ ዴብሱ፣</para>
  <para style="q2" vid="PRO 17:13">ሀምን መነሳ ኬሳ ህንበኡ።<verse eid="PRO 17:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 17:14"/>ሎለ ጀልቀቡን አኩመ ብሻን ጨብሰኒ ያሱት፤</para>
  <para style="q2" vid="PRO 17:14">ከናፉ ኡቱ ሎል ህንሆእን ዱቢ ዺስ።<verse eid="PRO 17:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 17:15"/>
    <char style="nd">ዋቀዮ</char> ዋን ከነ ለቹ ንበልፈ፤</para>
  <para style="q2" vid="PRO 17:15">ኩንስ ነመ የከ ቀቡ ቁልቁሉ ጎቹፊ <optbreak/> ነመ በሌሳ ህንቀብኔት ሙሩዸ።<verse eid="PRO 17:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 17:16"/>ሰበቢ እን ኦጉማ አርገቹፍ ፌዺ ህንቀብኔፍ፣</para>
  <para style="q2" vid="PRO 17:16">ማለቅን ሀርከ ጎዋ ጅሩ ፋይዳ ማሊ ቀበ?<verse eid="PRO 17:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 17:17"/>ምቹን ዬሮ ሁንደ ነመ ጃለተ፤</para>
  <para style="q2" vid="PRO 17:17">ኦቦሌስሞ ጉያ ረኮቲፍ ዸለተ።<verse eid="PRO 17:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 17:18"/>ነምን ቀልቢ ህንቀብኔ ሀርከ ዸኤ ዋ ነማፍ ከከተ፤</para>
  <para style="q2" vid="PRO 17:18">ፉለ ኦላ ኦፊሳ ዱረትስ ወቢ ተአ።<verse eid="PRO 17:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 17:19"/>ነምን ሎለ ጃለቱ ጩቡ ጃለተ፤</para>
  <para style="q2" vid="PRO 17:19">ነምን ከረ ኦል ዼራ እጃሩስ በዲሰ ዋመ።<verse eid="PRO 17:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 17:20"/>ነምን ያደ ሀማ ቀቡ ህንምልካኡ፤</para>
  <para style="q2" vid="PRO 17:20">ከን አረብንሳ ነመ ጎዎምሱስ ረኮ ኬሰ ሴነ።<verse eid="PRO 17:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 17:21"/>እልም ጎዋን አባሳት ገደ ፍደ፤</para>
  <para style="q2" vid="PRO 17:21">አባን እልመ ጎዋስ ህንገመዱ።<verse eid="PRO 17:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 17:22"/>ገራን ገመዱ ቆርቸ ጋሪዸ፤</para>
  <para style="q2" vid="PRO 17:22">ሀፉር ጨቤሞ ለፌ ጎግሰ።<verse eid="PRO 17:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 17:23"/>ነምን ሀማን ከራ ሙርቲ ቀጄላ ጀልእሱፍ ጄዼ</para>
  <para style="q2" vid="PRO 17:23">ዾክሳዻን መተኣ ፉዸተ።<verse eid="PRO 17:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 17:24"/>ነምን ሁበታን ፉለሳ ገረ ኦጉማት ዴብፈተ፤</para>
  <para style="q2" vid="PRO 17:24">እጅ ጎዋ ገሩ ሀመ ሀንዳረ ለፋት ጆረ።<verse eid="PRO 17:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 17:25"/>እልም ጎዋን አባሳት ገደ ፍደ፤</para>
  <para style="q2" vid="PRO 17:25">ሃዸ እሰ ዴሴትስ ጅሬኘ ሀዼሰ።<verse eid="PRO 17:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 17:26"/>ነመ በሌሳ ህንቀብኔ ቶኮ አደቡን ጋሪ ምት፤</para>
  <para style="q2" vid="PRO 17:26">ቆንዳልቶተ አመነሞ ሩኩቱንስ ስሪ ምት።<verse eid="PRO 17:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 17:27"/>ነምን ቤካን ኦፍ ቁሰቻ ዱበተ፤</para>
  <para style="q2" vid="PRO 17:27">ነምን ሁበታንስ ሀፉረ ቀበናኣ ቀበ።<verse eid="PRO 17:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 17:28"/>ጎዋንዩ ዮሙ ጨልእሱ ኦጌሰ ፈካተ፤</para>
  <para style="q2" vid="PRO 17:28">ዮሙ አረበሳ ቶአቱስ ሁበታ ፈካተ።<verse eid="PRO 17:28"/></para>
  <para style="b"/>
  <chapter eid="PRO 17"/>
  <chapter number="18" style="c" sid="PRO 18"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 18:1"/>ነምን አዳን ኦፍ ባሱ ኦፍቱማ ዱካ ቡአ፤</para>
  <para style="q2" vid="PRO 18:1">ሙርቲ ዹጋ ሁንዳንስ ንሞርመ።<verse eid="PRO 18:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 18:2"/>ነምን ጎዋን ሁበትና አርገቹት ህንገመዱ፤</para>
  <para style="q2" vid="PRO 18:2">ገሩ ያዱመሳ እብሱት ገመደ።<verse eid="PRO 18:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 18:3"/>ዬሮ ሀምን ዹፉ ቱፊን ዹፈ፤</para>
  <para style="q2" vid="PRO 18:3">ሰልጵንስ ቃኒ ወጅን ዹፈ።<verse eid="PRO 18:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 18:4"/>ዱቢን አፋን ነማ ብሻን ገድ ፈጎዸ፤</para>
  <para style="q2" vid="PRO 18:4">ቡርቃን ኦጉማ ገሩ ብሻን ያኡዸ።<verse eid="PRO 18:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 18:5"/>ገረ ነመ ሀማ ጎሩን <optbreak/> ዮካን ነመ በሌሳ ህንቀብኔ</para>
  <para style="q2" vid="PRO 18:5">ሙርቲ ቀጄላ ዾወቹን ጋሪ ምት።<verse eid="PRO 18:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 18:6"/>ህዺን ጎዋ ሎለ ፍደ፤</para>
  <para style="q2" vid="PRO 18:6">አፋንሳስ ሩኩተሙ እት ዋመ።<verse eid="PRO 18:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 18:7"/>አፋን ጎዋ በዲሰሳት፤</para>
  <para style="q2" vid="PRO 18:7">ህዺንሳስ ክዮ ሉቡሳት።<verse eid="PRO 18:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 18:8"/>ዱቢን ሀመቱ አኩመ ጉርሻ ምኣዉት፤</para>
  <para style="q2" vid="PRO 18:8">ገረ ኩታ ገራትስ ገድ ቡአ።<verse eid="PRO 18:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 18:9"/>ነምን ሆጂሳረት ዽባኡ፣</para>
  <para style="q2" vid="PRO 18:9">ኦቦሌሰ ነመ ዋ በሌሱት።<verse eid="PRO 18:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 18:10"/>መቃን <char style="nd">ዋቀዮ</char> ገሞ ጀባዸ፤</para>
  <para style="q2" vid="PRO 18:10">ነምን ቀጄላን እት በቀቴ በዲሰ ኦለ።<verse eid="PRO 18:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 18:11"/>ቀቤኝ ሶሬዪ እሳኒፍ መጋላ ደኦ ቀብዱዸ፤</para>
  <para style="q2" vid="PRO 18:11">እሳንስ አከ ደላ ኦል ዼራት ሄዱ።<verse eid="PRO 18:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 18:12"/>ኩፋቲዻን ዱረ ገራን ነማ ኦፍ ቱለ፤</para>
  <para style="q2" vid="PRO 18:12">ገድ ኦፍ ቀቡን ገሩ ኡልፍናን ዱረ ዹፈ።<verse eid="PRO 18:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 18:13"/>ኡቱ ህንዸጌፈትን ዴቢ ኬኑን፣</para>
  <para style="q2" vid="PRO 18:13">ጎዉማፊ ቃኒዸ።<verse eid="PRO 18:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 18:14"/>ሀፉር ነማ ዹኩበ ንኦብሰ፤</para>
  <para style="q2" vid="PRO 18:14">ሀፉረ ጨቤ ገሩ ኤኙቱ ኦብሱ ደንደአ?<verse eid="PRO 18:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 18:15"/>ገራን ነመ ሁበታ ቤኩምሰ አርገተ፤</para>
  <para style="q2" vid="PRO 18:15">ጉር ኦጌሳስ ዋን ከነ በርባደ።<verse eid="PRO 18:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 18:16"/>ኬናን አብቸ ኬኑፍ ከራ በነ፤</para>
  <para style="q2" vid="PRO 18:16">ፉለ ነሞተ ጉርጉዳ ዱረትስ እሰ ዽኤሰ።<verse eid="PRO 18:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 18:17"/>ሀመ ነምን ብራ ዹፌ እሳን ሞርሙት፣</para>
  <para style="q2" vid="PRO 18:17">ነምን ጀልቀበት ህመተሳ ዽኤፈቱ ቶኮ <optbreak/> ዹጋ ቀቤሰ ፈካተ።<verse eid="PRO 18:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 18:18"/>እጣ ቡሱን ወል ፈልሚ ቀበኔሰ፤</para>
  <para style="q2" vid="PRO 18:18">ነሞተ ወል ሎለን ጀጀቦስ አዳን ገልቸ።<verse eid="PRO 18:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 18:19"/>ኦቦሌሰ የከሜ ቶኮ ዴብሱን <optbreak/> መጋላ ደኦ ቀብዱረ ኡልፋተ፤</para>
  <para style="q2" vid="PRO 18:19">ወል ፈልሚንስ አኩመ ደንቀራ ከረ ደላ ዸጋት።<verse eid="PRO 18:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 18:20"/>እጀ አፋንሳቲን ገራን ነማ ቁፈ፤</para>
  <para style="q2" vid="PRO 18:20">ዱቢ አረበሳቲንስ ንጉተ።<verse eid="PRO 18:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 18:21"/>አረብን ሁምነ ጅሬኛቲፊ ዱኣ ቀበ፤</para>
  <para style="q2" vid="PRO 18:21">ወር እሰ ጃለተንስ እጀሳ ኛቱ።<verse eid="PRO 18:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 18:22"/>ነምን ኒቲ አርገቱ ዋን ጋሪ አርገተ፤</para>
  <para style="q2" vid="PRO 18:22">ፉለ <char style="nd">ዋቀዮ</char> ዱረትስ ሱራ አርገተ።<verse eid="PRO 18:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 18:23"/>ህዬስ አረበ ላፋዻን ዱበተ፤</para>
  <para style="q2" vid="PRO 18:23">ሶሬስ ገሩ ሰገሌ ጀባዻን ዴቢ ኬነ።<verse eid="PRO 18:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 18:24"/>ነምን ምቾተ ባይእሱ ንበደ፤</para>
  <para style="q2" vid="PRO 18:24">ገሩ ምቹን ኦቦሌሰ ጫላ ነመት ኣኑ ንጅረ።<verse eid="PRO 18:24"/></para>
  <para style="b"/>
  <chapter eid="PRO 18"/>
  <chapter number="19" style="c" sid="PRO 19"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 19:1"/>ጎዋ ደበ ዱበቱ መና</para>
  <para style="q2" vid="PRO 19:1">ህዬሰ አመነሙማዻን ጅራቱ ወየ።<verse eid="PRO 19:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 19:2"/>ነምን ቤኩምሰ ህንቀብኔ ጋሪ ምት፤</para>
  <para style="q2" vid="PRO 19:2">ሚል ጀርጀሩስ ከራራ ጀልአተ።<verse eid="PRO 19:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 19:3"/>ጎዉማን ነማ ከራሳ ጀልእሰ፤</para>
  <para style="q2" vid="PRO 19:3">ገራንሳሞ <char style="nd">ዋቀዮት</char> ኣረ።<verse eid="PRO 19:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 19:4"/>በዻዹማን ምቾተ ሄዱ ነመ አርገቺሰ፤</para>
  <para style="q2" vid="PRO 19:4">ህዬስ ገሩ ምቾተሳራ ገርገር በአ።<verse eid="PRO 19:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 19:5"/>ነምን ሶባን ዹጋ በኡ ኡቱ ህንአደበምን ህንሀፉ፤</para>
  <para style="q2" vid="PRO 19:5">ነምን ሶበ ኦዴሱስ ጀላ ህንበኡ።<verse eid="PRO 19:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 19:6"/>ነምን ሄዱን ቡልቻ ብረት ሱራ አርገቹ በርባደ፤</para>
  <para style="q2" vid="PRO 19:6">ነምን ሁንድስ ምቹ ነመ ዋ ነማ ኬኑት።<verse eid="PRO 19:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 19:7"/>ኦቦሎትን ህዬሳ ሁንድኑ እሰ ጅቡ፤</para>
  <para style="q2" vid="PRO 19:7">ዮስ ምቾትንሳ ሀመም ጫላ እሰራ ሃፈጋተን ሬ!</para>
  <para style="q1" vid="PRO 19:7">እን ከዸቻ እሳን ዱካ ቡኡዩ</para>
  <para style="q2" vid="PRO 19:7">እሳን ኤሰቱ ህንአርገመን።<verse eid="PRO 19:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 19:8"/>ነምን ቀልቢ ቀቡ ኦፊሳ ጃለተ፤</para>
  <para style="q2" vid="PRO 19:8">ነምን ሁበትና ጃለቱ ንምልካአ።<verse eid="PRO 19:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 19:9"/>ነምን ሶባን ዹጋ በኡ ኡቱ ህንአደበምን ህንሀፉ፤</para>
  <para style="q2" vid="PRO 19:9">ነምን ሶበ ኦዴሱስ ንበደ።<verse eid="PRO 19:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 19:10"/>ጅሬኘ ቀነኒ ጅራቹን ጎዋፍ ህንመሉ፤</para>
  <para style="q2" vid="PRO 19:10">ዮስ እልማን ሞቲ ቡልቹን ገርብቻፍ <optbreak/> ሀመም ጫላ ሃሀማቱሬ?<verse eid="PRO 19:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 19:11"/>ኦጉማን ነመ ቶኮ ኦብሰ ኬናፍ፤</para>
  <para style="q2" vid="PRO 19:11">በሌሳ ነማረ ደርቡንስ እሳፍ ኡልፍነ።<verse eid="PRO 19:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 19:12"/>ዼከምስ ሞቲ አኩመ ኣዱ ሌንጫት፣</para>
  <para style="q2" vid="PRO 19:12">ሱራንሳሞ አኩመ ፍጤንሰ መርገረት።<verse eid="PRO 19:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 19:13"/>እልም ጎዋን አባሳቲፍ በዲሰ፤</para>
  <para style="q2" vid="PRO 19:13">ኒቲን ኘክፍቱንስ</para>
  <para style="q2" vid="PRO 19:13">አከ መነ ዬሮ ሁንዱማ ዽምሱት።<verse eid="PRO 19:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 19:14"/>መናፊ ቀቤኝ ወረ ኦፊራ ዻለሙ፤</para>
  <para style="q2" vid="PRO 19:14">ኒቲ ቀልቢ ቀብዱ ገሩ <char style="nd">ዋቀዮቱ</char> ነማፍ ኬነ።<verse eid="PRO 19:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 19:15"/>ዽባኡማን ህርበ ጉዳ ነመት ቡሰ፤</para>
  <para style="q2" vid="PRO 19:15">ነምን ሆጂ መሌ ታኡስ ንቤለአ።<verse eid="PRO 19:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 19:16"/>ነምን አጀጀ ኤጉ ሉቡሳ ኤገተ፤</para>
  <para style="q2" vid="PRO 19:16">ከን ከራሳ ቱፈቱሞ ንዱአ።<verse eid="PRO 19:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 19:17"/>ነምን ህዬሳፍ ገራ ላፉ <char style="nd">ዋቀዮፍ</char> ልቄሰ፤</para>
  <para style="q2" vid="PRO 19:17">ዋቅንስ ዋን እን ሆጄቴ ሰናፍ እሰ በዻሰ።<verse eid="PRO 19:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 19:18"/>ዬሮ አብዲን ጅሩት እልመኬ አደበዹ፤</para>
  <para style="q2" vid="PRO 19:18">አከ እን ዱኡፍስ ጨልእስቴ ህንእላልን።<verse eid="PRO 19:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 19:19"/>ነምን ደፌ ኣሩ አደበሙ ቀበ፤</para>
  <para style="q2" vid="PRO 19:19">አት ዮ እሰ ኦልችቴ፣ አመሌ አከሱመ ጎቹ ቀብደ።<verse eid="PRO 19:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 19:20"/>ጎርሰ ነማ ዸጌፈዹ፤ ስሬፈመስ ፉዸዹ፤</para>
  <para style="q2" vid="PRO 19:20">ዹመረት አት ነመ ኦጌሰ ታተ።<verse eid="PRO 19:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 19:21"/>ገራ ነማ ኬሰ ከሮረ ባይኤቱ ጅረ፤</para>
  <para style="q2" vid="PRO 19:21">ገሩ ወን ፊጣን በኡ ካዮ <char style="nd">ዋቀዮት</char>።<verse eid="PRO 19:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 19:22"/>ወን ነምን ሀዉ ጃለለ ዹመ ህንቀብኔዸ፤</para>
  <para style="q2" vid="PRO 19:22">ሶብዱ ተኡ መና ህዬሰ ተኡ ወየ።<verse eid="PRO 19:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 19:23"/>
    <char style="nd">ዋቀዮን</char> ሶዳቹን ጅሬኘት ነመ ጌሰ፤</para>
  <para style="q2" vid="PRO 19:23">ዮስ ነምን ቦቆናዻን ጅራተ፤ <optbreak/> ረክንስ እሰ ህንአርገቱ።<verse eid="PRO 19:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 19:24"/>ዽባኣን ሀርከሳ ወጪቲ ኬሰ ካአ፤</para>
  <para style="q2" vid="PRO 19:24">ገረ አፋን እሳትስ ህንዴብፈቱ!<verse eid="PRO 19:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 19:25"/>ቆስቱ ገረፍ፤ ወላላን ሁበትና አርገታ፤</para>
  <para style="q2" vid="PRO 19:25">ነመ ቀልቢ ቀቡ እፈዹ፤ እን ቤኩምሰ አርገታቲ።<verse eid="PRO 19:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 19:26"/>ነምን አባሳ ሳሙ፣ ሃዸሳስ ከን መና አርኡ፣</para>
  <para style="q2" vid="PRO 19:26">እልመ ቃኒፊ ሰልጵነ ፍዱዸ።<verse eid="PRO 19:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 19:27"/>ያ እልመኮ፣ ሜ ቀጄልፈመ ዸጌፈቹ ዺስ፤</para>
  <para style="q2" vid="PRO 19:27">አት ዱቢ ቤኩምሳራ ንበዳ።<verse eid="PRO 19:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 19:28"/>ዹገ በኣን ፋይዳ ህንቀብኔ ሙርቲ ቀጄላ ቱፈተ፤</para>
  <para style="q2" vid="PRO 19:28">አፋን ሀሞታሞ ሀምነ ልቅምሰ።<verse eid="PRO 19:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 19:29"/>ቆስቶታፍ አደቢ፣</para>
  <para style="q2" vid="PRO 19:29">ዱግደ ጎዎታቲፍሞ ሩኩታቱ ቆጴፈመ።<verse eid="PRO 19:29"/></para>
  <para style="b"/>
  <chapter eid="PRO 19"/>
  <chapter number="20" style="c" sid="PRO 20"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 20:1"/>ዳዺን ወይኒ ነመ ቆስቱ፣ <optbreak/> ዹጋቲን ጭማንሞ ወጩ ነመ ጎዸ፤</para>
  <para style="q2" vid="PRO 20:1">ነምን እሳኒን ፉዸተሙስ ኦጌሰ ምት።<verse eid="PRO 20:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 20:2"/>ዼከምስ ሞቲ አኩመ ኣዱ ሌንጫት፤</para>
  <para style="q2" vid="PRO 20:2">ነምን እሰ ኣርሱስ ሉቡ ኦፊሳ ዸበ።<verse eid="PRO 20:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 20:3"/>ሎለራ ፈጋቹን ኡልፍነ፤</para>
  <para style="q2" vid="PRO 20:3">ጎዋን ሁንድ ገሩ ሎለት አሪፈተ።<verse eid="PRO 20:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 20:4"/>ዽባኣን ዬሮዻን ህንቆተቱ፤</para>
  <para style="q2" vid="PRO 20:4">ከናፉ እን ዬሮ ሃማት ንእላለ መሌ <optbreak/> ሆማ ህንአርገቱ።<verse eid="PRO 20:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 20:5"/>ያድን ቀልቢ ነማ አኩመ ብሻን ገድ ፈጎት፤</para>
  <para style="q2" vid="PRO 20:5">ሁበታን ነማ ገሩ ንወራበተ።<verse eid="PRO 20:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 20:6"/>ነምን ሄዱን አከ ጃለለ ህንዹምኔ ቀቡ ዱበተ፤</para>
  <para style="q2" vid="PRO 20:6">ነመ አመነማ ገሩ ኤኙቱ አርገቹ ደንደአ?<verse eid="PRO 20:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 20:7"/>ነምን ቀጄላን አመነሙማዻን ጅራተ፤</para>
  <para style="q2" vid="PRO 20:7">እጆሌንሳ ወር ቦዴ ዸለተንስ ንኤብፈሙ።<verse eid="PRO 20:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 20:8"/>ሞቲን ቶኮ ዬሮ ሙርቲ ኬኑፍ ቴሶሳረ ታኡት፣</para>
  <para style="q2" vid="PRO 20:8">ዋን ሀማ ሁንደ እጁመሳቲን ግንግልቼ አዳን ባሰ።<verse eid="PRO 20:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 20:9"/>ኤኙቱ፣ “አን ገራኮ ቁልቁሌፈዼረ፤</para>
  <para style="q2" vid="PRO 20:9">አን ቁልቁሉዸ፤ ጩቡስ ህንቀቡ” ጄቹ ደንደአ?<verse eid="PRO 20:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 20:10"/>መዳሊ ጀልኣፊ ሰፈርቱ ጀልኣ</para>
  <para style="q2" vid="PRO 20:10">ለማኑ <char style="nd">ዋቀዮ</char> ንበልፈ።<verse eid="PRO 20:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 20:11"/>ሙጫን ጥናንዩ አመልሳ ቁልቁሉፊ</para>
  <para style="q2" vid="PRO 20:11">ቀጄላ ተኡንሳ ሆጂሳቲን ቤከመ።<verse eid="PRO 20:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 20:12"/>ጉረ ዸገኡፊ እጀ አርጉ፣</para>
  <para style="q2" vid="PRO 20:12">ለቸኑ <char style="nd">ዋቀዮቱ</char> ኡሜ።<verse eid="PRO 20:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 20:13"/>አከ ህንህዮምኔፍ፣ ህርበ ህንጃለትን፤</para>
  <para style="q2" vid="PRO 20:13">ምዻን አከ ቁፍቱፍ፣ ደመቂ ጅራዹ።<verse eid="PRO 20:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 20:14"/>ነምን ዋ ብተቱ፣ “ወን ኩን ጋሪ ምት፤ <optbreak/> ወን ኩን ጋሪ ምት!” ጄዸ፤</para>
  <para style="q2" vid="PRO 20:14">ኤርገሲሞ ዸቄ ዋኤ ዋን ብተቴ ሰና ቦነ።<verse eid="PRO 20:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 20:15"/>ወርቄን ንጅረ፤ ሉል ዲማንስ ባይእናን ጅረ፤</para>
  <para style="q2" vid="PRO 20:15">አረብን ቤኩምሰ ዱበቱ ገሩ ፋየ ገቲ ጉዳት።<verse eid="PRO 20:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 20:16"/>ነመ ነመ ኦርማቲፍ ወቢ ተኤራ ኡፈተሳ ፉዸዹ፤</para>
  <para style="q2" vid="PRO 20:16">ዮ እን ዱበርቲ ኦርማቲፍ ወቢ ተኤስ ኡፈተ ሰነ ቀብዲ ቀበዹ።<verse eid="PRO 20:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 20:17"/>ኛትን ጎዎምሳዻን አርገሜ ነመት ምኣወ፤</para>
  <para style="q2" vid="PRO 20:17">ዹመረት ገሩ አፋን ነመ ሰና ጭረቸቱ ጉተ።<verse eid="PRO 20:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 20:18"/>ጎርሳን ከሮረ ባፈዹ፤</para>
  <para style="q2" vid="PRO 20:18">ቀጄልፈመ ኦጉማቲን ወራነ በን።<verse eid="PRO 20:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 20:19"/>ሀመቱን እጪቲ ባፍት፤</para>
  <para style="q2" vid="PRO 20:19">ከናፉ ኦዴስቱ ወጅን ቶኩማ ህንቀባትን።<verse eid="PRO 20:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 20:20"/>ነምን ቶኮ ዮ አባሳ ዮካን ሃዸሳ አባሬ፣</para>
  <para style="q2" vid="PRO 20:20">እብሳንሳ ዱከነ ሀማ ኬሰት ዻመ።<verse eid="PRO 20:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 20:21"/>ዻል ጀልቀቡመት ደፌ አርገሜ</para>
  <para style="q2" vid="PRO 20:21">ዹምንሳ ኤበ ህንቀባቱ።<verse eid="PRO 20:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 20:22"/>አት፣ “የከ አት ሆጄቴ ከናፍ <optbreak/> አን ገቲኬ ሲፍን ኬነ!” ህንጄዽን፤</para>
  <para style="q2" vid="PRO 20:22">
    <char style="nd">ዋቀዮን</char> ኤገዹ፤ እን ስ ባሰ።<verse eid="PRO 20:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 20:23"/>
    <char style="nd">ዋቀዮ</char> መዳሊ ጀልኣ ንበልፈ፤</para>
  <para style="q2" vid="PRO 20:23">ሰፈርቱ ሶባትስ ህንገመዱ።<verse eid="PRO 20:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 20:24"/>አዴምስ ነማ <char style="nd">ዋቀዮን</char> ቀጄልፈመ።</para>
  <para style="q2" vid="PRO 20:24">ዮስ ነምን ከምዩ አከሚን ከራ ኦፊሳ ሁበቹ ደንደአሬ?<verse eid="PRO 20:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 20:25"/>ነምን ኡቱ እት ህንያድን፣ <optbreak/> “ወን ኩን ዋቃፍ ቁልቁሌፈሜረ” ጄዼ</para>
  <para style="q2" vid="PRO 20:25">ኤርገሲሞ ዋን ወሬጌ ሰነ ጋቤ ክዮ እሰት ተአ።<verse eid="PRO 20:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 20:26"/>ሞቲን ኦጌስ ሀሞተ ግንግልቼ አዳን ባሰ፤</para>
  <para style="q2" vid="PRO 20:26">ጌንጎ እቲን ምዻን ዸአንሌ እሳንረ ኦፈ።<verse eid="PRO 20:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 20:27"/>እብሳን <char style="nd">ዋቀዮ</char> ሀፉረ ነማ ሰከተአ፤</para>
  <para style="q2" vid="PRO 20:27">እን ኬሰ ነማሌ እሱማን ቆረ።<verse eid="PRO 20:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 20:28"/>ጃለሊፊ አመነሙማን ሞቲ ቶኮ ነጋን ጅራችሱ፤</para>
  <para style="q2" vid="PRO 20:28">ቴሶን ሞቱማሳስ ጃለላን ኤገመ።<verse eid="PRO 20:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 20:29"/>ኡልፍን ደርገጎታ ጀብነሳኒት፤</para>
  <para style="q2" vid="PRO 20:29">አሪን መታ ከበጀ ነመ ኡሙሪን ዼረቴት።<verse eid="PRO 20:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 20:30"/>አቦቴን ነመ መዴሱ ሀምነ ነመራ ቁልቁሌሰ፤</para>
  <para style="q2" vid="PRO 20:30">ገረፊንሞ ኬሰ ነማ ጌደረ።<verse eid="PRO 20:30"/></para>
  <para style="b"/>
  <chapter eid="PRO 20"/>
  <chapter number="21" style="c" sid="PRO 21"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 21:1"/>ያድን ሞቲ አኩመ ያኣ ብሻኒ ሀርከ <char style="nd">ዋቀዮ</char> ኬሰ ጅረ፤</para>
  <para style="q2" vid="PRO 21:1">እንስ ገሩመ ፌዼት ቀጄልቸ።<verse eid="PRO 21:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 21:2"/>ከራን ነማ ሁንድኑ እጀ ኦፊሳ ዱረት ቀጄላ እት ፈካተ፤</para>
  <para style="q2" vid="PRO 21:2">
    <char style="nd">ዋቀዮ</char> ገሩ ያደ ነማ መዳለ።<verse eid="PRO 21:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 21:3"/>ፉለ <char style="nd">ዋቀዮ</char> ዱረት ኣርሳ ጫላ፣</para>
  <para style="q2" vid="PRO 21:3">ዋን ቀጄላፊ ስሪ ተኤ ሆጄቹቱ ፉዸተመ ቀበ።<verse eid="PRO 21:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 21:4"/>እጅ ኦፍ ጀጁፊ ገራን ኦፍ ቱሉ ማሲ ሀሞታ</para>
  <para style="q2" vid="PRO 21:4">ከን ህንቆተምኒዸ፤ <optbreak/> እንስ ጩቡ ዸለ።<verse eid="PRO 21:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 21:5"/>ከሮር ነመ ተታፈቱ ቡኣ አርገምሲሰ፤</para>
  <para style="q2" vid="PRO 21:5">ነምን አሪፈቱ ገሩ ንህዮመ።<verse eid="PRO 21:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 21:6"/>ቀቤኝ አረበ ሶቡን አርገሙ፣</para>
  <para style="q2" vid="PRO 21:6">ኡሪ ብትናኤ በዱፊ ክዮ ዱኣት።<verse eid="PRO 21:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 21:7"/>ሰበቢ እሳን ዋን ቀጄላ ሆጄቹ ድደኒፍ፣</para>
  <para style="q2" vid="PRO 21:7">ፍንጭል ሀሞታ እሳኑመ በሌሰ።<verse eid="PRO 21:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 21:8"/>ከራን ነመ በሌሳ ቀቡ ጀልኣዸ፤</para>
  <para style="q2" vid="PRO 21:8">አመል ነመ ቁልቁሉ ገሩ ቀጄላዸ።<verse eid="PRO 21:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 21:9"/>ኒቲ ኘክፍቱ ወጅን መነ ቶኮ ኬሰ ጅራቹ መና፣</para>
  <para style="q2" vid="PRO 21:9">ጎሌ በንቲ መናረ ጅራቹ ወየ።<verse eid="PRO 21:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 21:10"/>ነምን ሀማን ጀልእነ ዸረአ፤</para>
  <para style="q2" vid="PRO 21:10">ኦላንሳ ገረ ላፍነ ቶኮዩ እሰራ ህንአርገቱ።<verse eid="PRO 21:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 21:11"/>ዬሮ ነምን ቆሱ ቶኮ አደበሙት፣ <optbreak/> ወላላን ኦጉማ አርገተ፤</para>
  <para style="q2" vid="PRO 21:11">ነምን ኦጌስ ዬሮ ጎርፈሙት ቤኩምሰ አርገተ።<verse eid="PRO 21:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 21:12"/>ነምን ቀጄላን መነ ሀሞታ ቀልቤፈቴ እላለ፤</para>
  <para style="q2" vid="PRO 21:12">ሀሞተስ ንበሌሰ።<verse eid="PRO 21:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 21:13"/>ነምን ቶኮ ዮ እየ ህዬሳቲፍ ጉረ ኬኑ ድዴ፣</para>
  <para style="q2" vid="PRO 21:13">እንስ ንእየ፤ ዴቢስ ህንአርገቱ።<verse eid="PRO 21:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 21:14"/>ወን ዾክሳዻን ነማፍ ኬነን ኣሪ ቀበኔሰ፤</para>
  <para style="q2" vid="PRO 21:14">መተኣን ሀርከ ቦባ ጀላቲን ኬነንስ <optbreak/> ዼከምሰ ጉዳ ገብ ጎዸ።<verse eid="PRO 21:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 21:15"/>ሙርቲ ቀጄላ ኬኑን ቀጄልቶታፍ ገመቹ ኬነ፤</para>
  <para style="q2" vid="PRO 21:15">ሀሞተትሞ ራፈመ ፍደ።<verse eid="PRO 21:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 21:16"/>ነምን ከራ ሁበትናራ በዱ ከምዩ</para>
  <para style="q2" vid="PRO 21:16">ወልዳ ወረ ዱአኒት ደበለመ።<verse eid="PRO 21:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 21:17"/>ነምን ቀነኒ ጃለቱ ንዴገ፤</para>
  <para style="q2" vid="PRO 21:17">ከን ዳዺ ወይኒቲፊ ዘይቲ ጃለቱሞ ህንሶሮሙ።<verse eid="PRO 21:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 21:18"/>ነምን ሀማን ነመ ቀጄላዻፍ፣</para>
  <para style="q2" vid="PRO 21:18">ከን ህንአመነምኔሞ ነመ ቶላዻፍ ፉሪ ተአ።<verse eid="PRO 21:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 21:19"/>ኒቲ ኘክፍቱፊ ከን ደፍቴ ኣርቱ ወጅን ጅራቹ መና፣</para>
  <para style="q2" vid="PRO 21:19">ገሞጂ ኬሰ ጅራቹ ወየ።<verse eid="PRO 21:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 21:20"/>መነ ነመ ኦጌሳ ኬሰ ቀቤኘ ገቲ ጉዳቲፊ ዘይቲቱ ጅረ፤</para>
  <para style="q2" vid="PRO 21:20">ጎዋን ገሩ ዋን ቀቡ ሁንደ ኛቴ ፍጠ።<verse eid="PRO 21:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 21:21"/>ነምን ቀጄሉማፊ ጃለለ ዱካ ቡኡ፣</para>
  <para style="q2" vid="PRO 21:21">ጅሬኘ፣ በዻዹማፊ ኡልፍነ አርገተ።<verse eid="PRO 21:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 21:22"/>ነምን ኦጌስ መጋላ ነመ ጀባት በኤ</para>
  <para style="q2" vid="PRO 21:22">ደኦ ጀባ እን አመነቱ ጀላ ዲገ።<verse eid="PRO 21:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 21:23"/>ነምን አፋንሳቲፊ አረበሳ ኤገቱ፣</para>
  <para style="q2" vid="PRO 21:23">በላራ ኦፍ ኤገ።<verse eid="PRO 21:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 21:24"/>ነመ ኦፍ ጀጁፊ ኦፍ ቱሉ መቃንሳ፣ “ቆስቱዸ፤”</para>
  <para style="q2" vid="PRO 21:24">እን አከ መሌ ኮረ።<verse eid="PRO 21:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 21:25"/>ሰበቢ ሀርክሳ ሆጂ ሆጄቹ ህንጃለኔፍ፣</para>
  <para style="q2" vid="PRO 21:25">ሀዊን ነመ ዽባኣ ዱአ እሰት ፍደ።<verse eid="PRO 21:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 21:26"/>እን ጉያ ጉቱ ከጄለ፤</para>
  <para style="q2" vid="PRO 21:26">ነምን ቀጄላን ገሩ ኡቱ ህንቁሰትን ኬነ።<verse eid="PRO 21:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 21:27"/>ኣርሳን ነመ ሀማ በልፈማዸ፤</para>
  <para style="q2" vid="PRO 21:27">ዮስ ዮ እን ያደ ሀማዻን ዽኤሴ <optbreak/> ሀመም ሰነ ጫላ ሃበልፈሙ ሬ!<verse eid="PRO 21:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 21:28"/>ዹገ ባቱን ሶባ ንበደ፤</para>
  <para style="q2" vid="PRO 21:28">ነምን እሰ ዸገኡ ከምዩስ በረ በራን በደ።<verse eid="PRO 21:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 21:29"/>ነምን ሀማን እጀ ጀባተ፤</para>
  <para style="q2" vid="PRO 21:29">ነምን ቶላን ገሩ ከራሳ ቀጄልፈተ።<verse eid="PRO 21:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 21:30"/>ኦጉማን፣ ሁበትናኒፊ ከሮር</para>
  <para style="q2" vid="PRO 21:30">
    <char style="nd">ዋቀዮን</char> ሞርሜ ምልካኡ ህንጅሩ።<verse eid="PRO 21:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 21:31"/>ፈርድ ጉያ ወራናቲፍ ቆጴፈመ፤</para>
  <para style="q2" vid="PRO 21:31">ሞእች ገሩ ከን <char style="nd">ዋቀዮት</char>።<verse eid="PRO 21:31"/></para>
  <para style="b"/>
  <chapter eid="PRO 21"/>
  <chapter number="22" style="c" sid="PRO 22"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 22:1"/>መቃን ጋሪን በዻዹማ ጉዳ ጫላ ፍለተማዸ፤</para>
  <para style="q2" vid="PRO 22:1">ከበጀሙንስ ሜቲፊ ወርቄ ጫለ።<verse eid="PRO 22:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 22:2"/>ወን ሶሬሳፊ ህዬሰ ወል ፈኬሱ ከናዸ፦</para>
  <para style="q2" vid="PRO 22:2">ኡማን ሁንደሳኒ <char style="nd">ዋቀዮዸ</char>።<verse eid="PRO 22:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 22:3"/>ነምን ሁበታን በላ አርጌ ጀላ ዾከተ፤</para>
  <para style="q2" vid="PRO 22:3">ወላላንሞ እቱመ ዴሜ አደበመ።<verse eid="PRO 22:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 22:4"/>ገድ ኦፍ ቀቢስኒፊ <char style="nd">ዋቀዮን</char> ሶዳቹን፣</para>
  <para style="q2" vid="PRO 22:4">ቀቤኘ፣ ኡልፍናፊ ጅሬኘ ነማ ኬኑ።<verse eid="PRO 22:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 22:5"/>ከራ ሀሞታረ ቆራቲፊ ክዮቱ ጅረ፤</para>
  <para style="q2" vid="PRO 22:5">ነምን ሉቡሳ ኤገቱ ገሩ <optbreak/> ዋን ከነራ ፈጋቴ ጅራተ።<verse eid="PRO 22:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 22:6"/>ዳእመ ቶኮ ከራ እንረ ዴሙ ቀቡ በርሲስ፤</para>
  <para style="q2" vid="PRO 22:6">እን ጋፈ ዱሎሜዩ ከራ ሰነራ ህንጀልአቱ።<verse eid="PRO 22:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 22:7"/>ሶሬስ ህዬሰ ቡልቸ፤</para>
  <para style="q2" vid="PRO 22:7">ልቄፈታን ገርብቸ ልቄስቱት።<verse eid="PRO 22:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 22:8"/>ነምን ሀምነ ፈጫሱ ረክነ ሃመተ፤</para>
  <para style="q2" vid="PRO 22:8">ኡሌን ኣሪሳስ ንሁራኣ።<verse eid="PRO 22:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 22:9"/>ነምን አርጃን ዋን ኛተሳ ህዬዪፍ ቆዱፍ</para>
  <para style="q2" vid="PRO 22:9">ኦፊሳቲ ንኤብፈመ።<verse eid="PRO 22:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 22:10"/>ቆስቱ ኦፍ ብራ አርእ፤ ሎል ንቀበናኣ፤</para>
  <para style="q2" vid="PRO 22:10">ወል ድዳፊ አረብሶንስ ህንጅራቱ።<verse eid="PRO 22:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 22:11"/>ነመ ቁልቁልነ ገራ ጃለቱፊ</para>
  <para style="q2" vid="PRO 22:11">ዱቢንሳ ነመት ቶሉ ሞቲን ምቹ እሳፍ ተአ።<verse eid="PRO 22:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 22:12"/>እጅ <char style="nd">ዋቀዮ</char> ጥዬፈቴ ቤኩምሰ እላለ፤</para>
  <para style="q2" vid="PRO 22:12">እን ገሩ ዱቢ ነመ ህንአመነምኔ ንቡሼሰ።<verse eid="PRO 22:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 22:13"/>ዽባኣን፣ “ሌንጭ አለ ጅረ!</para>
  <para style="q2" vid="PRO 22:13">አን ከራ ጉባት ነንአጄፈመ!” ጄዸ።<verse eid="PRO 22:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 22:14"/>አፋን ኤጅቱ ቦለ ገድ ፈጎዸ፤</para>
  <para style="q2" vid="PRO 22:14">ነምን ዼከምሰ <char style="nd">ዋቀዮ</char> ጀለ ጅሩ አች ኬሰ ቡአ።<verse eid="PRO 22:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 22:15"/>ጎዉማን ያደ ዳእማ ኬሰት ህዸሜረ፤</para>
  <para style="q2" vid="PRO 22:15">ኡሌን እቲን አደበን ገሩ እራ ፈጌሰ።<verse eid="PRO 22:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 22:16"/>ነምን ቀቤኘሳ ጉድፈቹፍ ጄዼ</para>
  <para style="q2" vid="PRO 22:16">ህዬሰ ሀጩጩፊ ከን ሶሬሳፍ ኬና ኬኑ ንዴገ።<verse eid="PRO 22:16"/></para>
  <para style="ms1">ጄቾተ ሶዶመን ነመ ኦጌሳ</para>
  <para style="s2">ጄቸ ቶኮፋ</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 22:17"/>ቀልቤፈዹቲ ዋን ነምን ኦጌስ ጄዹ ዸጌፈዹ፤</para>
  <para style="q2" vid="PRO 22:17">ያደኬስ ገረ ዋን አን በርሲሱት ዴብፈዹ፤<verse eid="PRO 22:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 22:18"/>ዮ አት ቀልቢት ቀበቴ <optbreak/> ሁንዱመሳ ህዺኬረት ቆጴፈቴ</para>
  <para style="q2" vid="PRO 22:18">ወን ኩን ነመ ገመቺሳቲ።<verse eid="PRO 22:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 22:19"/>አከ አብዲንኬ <char style="nd">ዋቀዮ</char> ተኡፍ</para>
  <para style="q2" vid="PRO 22:19">አን ሀርአ ሱመ መታ ኬዩ ነንበርሲሰ።<verse eid="PRO 22:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 22:20"/>አን ጄቸ ሶዶመ፣ ጄቸ ጎርሳቲፊ</para>
  <para style="q2" vid="PRO 22:20">ቤኩምሳ ሲፍ ህንበሬስኔ?<verse eid="PRO 22:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 22:21"/>ከነስ አን አከ አት ወረ ስ ኤርገኒፍ</para>
  <para style="q2" vid="PRO 22:21">ዴቢ ዹጋ ኬንቱፍ ዋን ቀጄላፊ</para>
  <para style="q2" vid="PRO 22:21">ዹጋ ስ አርግሲሱፍን በሬሴ ምቲ?<verse eid="PRO 22:21"/></para>
  <para style="s2">ጄቸ ለመፋ</para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 22:22"/>አት ሰበቢ እን ህዬሰ ተኤፍ ጄቴ ህዬሰ ህንሳምን፤</para>
  <para style="q2" vid="PRO 22:22">ረከታስ መነ ሙርቲት ህንጩንቁርስን፤<verse eid="PRO 22:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 22:23"/>
    <char style="nd">ዋቀዮ</char> ዱቢሳኒ ንእላላፍ፤</para>
  <para style="q2" vid="PRO 22:23">ጅሬኘ ወረ እሳን ሳመኒስ ንሳማቲ።<verse eid="PRO 22:23"/></para>
  <para style="s2">ጄቸ ሰደፋ</para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 22:24"/>ነመ ደፌ ኣሩ ምቹ ህንጎዸትን፤</para>
  <para style="q2" vid="PRO 22:24">ነመ አከ ሰልጳት ዼከሙ ወጅንስ <optbreak/> ቶኩማ ህንቀባትን፤<verse eid="PRO 22:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 22:25"/>ዮ ከነ ጎቴ ከራሳ በረተ፤</para>
  <para style="q2" vid="PRO 22:25">ኦፊኬስ ክዮት ገልችተ።<verse eid="PRO 22:25"/></para>
  <para style="s2">ጄቸ አፍረፋ</para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 22:26"/>ነመ ሀርከ ዸኤ ዋዳ ገሉ</para>
  <para style="q2" vid="PRO 22:26">ዮካን ነመ ልቂ ነማቲፍ ወቢ ተኡ ህንተእን፤<verse eid="PRO 22:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 22:27"/>ዮ አት ዋን ባፍቱ ዸብዴ፣</para>
  <para style="q2" vid="PRO 22:27">ስሬን ኬዩ ስ ጀላ ፉዸተመ።<verse eid="PRO 22:27"/></para>
  <para style="s2">ጄቸ ሸነፋ</para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 22:28"/>ዸጋ ዳሪ ዱሪ፣</para>
  <para style="q2" vid="PRO 22:28">ከን አቦቲንኬ ዻበን ህንዺብን።<verse eid="PRO 22:28"/></para>
  <para style="s2">ጄቸ ጀአፋ</para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 22:29"/>ነመ ሆጂሳ ኬሰት ኦጉማ ቀቡ አርግቴ?</para>
  <para style="q2" vid="PRO 22:29">እን ፉለ ሞቶታ ዱረ ዻበተ፤</para>
  <para style="q2" vid="PRO 22:29">ፉለ ነሞተ ካኒ ዱረ ገሩ ህንዻበቱ።<verse eid="PRO 22:29"/></para>
  <chapter eid="PRO 22"/>
  <chapter number="23" style="c" sid="PRO 23"/>
  <para style="s2">ጄቸ ቶርበፋ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 23:1"/>አት ዬሮ ዋ ኛቹፍ ቡልቻ ቶኮ ወጅን ቴሱት፣</para>
  <para style="q2" vid="PRO 23:1">ዋን ፉለኬ ዱረ ጅሩ ሁበዹ እላል፤<verse eid="PRO 23:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 23:2"/>አት ዮ ኛታፍ ፌዺ ጉዳ ቀባቴ፣</para>
  <para style="q2" vid="PRO 23:2">ቆንቆኬረ ብላ ካእ።<verse eid="PRO 23:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 23:3"/>ዋን ኛትን ሱን ነመ ጎዎምሱፍ፣</para>
  <para style="q2" vid="PRO 23:3">ምኣሳት ህንገገብን።<verse eid="PRO 23:3"/></para>
  <para style="s2">ጄቸ ሰዴተፋ</para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 23:4"/>ሶሮሙፍ ጄቴ ኦፍ ህንደዸብሲስን፤</para>
  <para style="q2" vid="PRO 23:4">ኦፍ ቀቡፍስ ኦጉማ ቀባዹ።<verse eid="PRO 23:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 23:5"/>ሶሩምን ዮሙ አት እጀ እረ ቡፈቱት ንበደ፤</para>
  <para style="q2" vid="PRO 23:5">እን ዹጉማን ባሌ ባፈቴ</para>
  <para style="q2" vid="PRO 23:5">አኩመ ርሳ ገረ ሰሚት ኦል በርሳቲ።<verse eid="PRO 23:5"/></para>
  <para style="s2">ጄቸ ሰግለፋ</para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 23:6"/>ቡዴነ ዶቅና ህንኛትን፤</para>
  <para style="q2" vid="PRO 23:6">ጭዸሳስ ህንከጄልን፤<verse eid="PRO 23:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 23:7"/>እን ዬሮ ሁንደ ዋኤ ገቲ ያዳቲ።</para>
  <para style="q2" vid="PRO 23:7">እን፣ “ኛዹ ዹግ” ሲን ጄዸ፤</para>
  <para style="q2" vid="PRO 23:7">ገራንሳ ገሩ ስ ወጅን ህንጅሩ።<verse eid="PRO 23:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 23:8"/>አት ዋኑመ ጥኖ ኛቴ ሰነ ንድድግደ፤</para>
  <para style="q2" vid="PRO 23:8">ዱቢኬ ጋሪ ሰነሌ ንዸብደ።<verse eid="PRO 23:8"/></para>
  <para style="s2">ጄቸ ኩርነፋ</para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 23:9"/>ሰበቢ እን ኦጉማ ዱቢኬቲ ቱፈቱፍ</para>
  <para style="q2" vid="PRO 23:9">አት ነመ ጎዋት ህንዱበትን።<verse eid="PRO 23:9"/></para>
  <para style="s2">ጄቸ ኩዸ ቶኮፋ</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 23:10"/>ዸጋ ዳንጋ ዱሪ ህንዺብን</para>
  <para style="q2" vid="PRO 23:10">ዮካን ለፈ ቆቲሳ እጆሌ አባ ህንቀብኔት ህንደርብን።<verse eid="PRO 23:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 23:11"/>ፉሪንሳኒ ጀባዻቲ፤</para>
  <para style="q2" vid="PRO 23:11">እን ገረሳኒ ጎሬ ስት ፈልመ።<verse eid="PRO 23:11"/></para>
  <para style="s2">ጄቸ ኩዸ ለመፋ</para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 23:12"/>ቀልቢኬ ገረ ጎርሳት፣ ጉረ ኬሞ</para>
  <para style="q2" vid="PRO 23:12">ገረ ዱቢ ቤኩምሳት ዴብፈዹ።<verse eid="PRO 23:12"/></para>
  <para style="s2">ጄቸ ኩዸ ሰደፋ</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 23:13"/>እጆሌኬ አደበቹ ህንዺስን፤</para>
  <para style="q2" vid="PRO 23:13">ዮ አት አርጩሜዻን አደብዴ እሳን ህንዱአን።<verse eid="PRO 23:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 23:14"/>አርጩሜዻን እሳን አደቢቲ</para>
  <para style="q2" vid="PRO 23:14">ሉቡሳኒ ዱአ ኦልች።<verse eid="PRO 23:14"/></para>
  <para style="s2">ጄቸ ኩዸ አፍረፋ</para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 23:15"/>ያ እልመኮ፣ ዮ ገራንኬ ኦጌሰ ተኤ፣</para>
  <para style="q2" vid="PRO 23:15">ገራንኮ ንገመደ፤<verse eid="PRO 23:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 23:16"/>ዮ አረብንኬ ዋን ቀጄላ ዱበቴ፣</para>
  <para style="q2" vid="PRO 23:16">ኬስኮ ባይኤ ገመደ።<verse eid="PRO 23:16"/></para>
  <para style="s2">ጄቸ ኩዸ ሸነፋ</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 23:17"/>ገራንኬ ጩበሞተት ህንህናፍን፤</para>
  <para style="q2" vid="PRO 23:17">ገሩ ዬሮ ሁንደ <char style="nd">ዋቀዮን</char> ሶዳዹ።<verse eid="PRO 23:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 23:18"/>አት ዹጉማን ገረ ፉልዱራት አብዲ ቀብደ፤</para>
  <para style="q2" vid="PRO 23:18">አብዲንኬስ ህንጭቱ።<verse eid="PRO 23:18"/></para>
  <para style="s2">ጄቸ ኩዸ ጀአፋ</para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 23:19"/>ያ እልመኮ፣ ዸጌፈዹ፤ ኦጌሰ ተእ፤</para>
  <para style="q2" vid="PRO 23:19">ቀልቢኬ ዳንዲ ቀጄላረ ቡፈዹ።<verse eid="PRO 23:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 23:20"/>ወረ ዳዺ ወይኒ ባይኤ ዹገንት</para>
  <para style="q2" vid="PRO 23:20">ዮካን ወረ ፎንት ገገበንት ህንመከምን፤<verse eid="PRO 23:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 23:21"/>መቾፍቱፊ አልባዼዪን ንህዮሙ፤</para>
  <para style="q2" vid="PRO 23:21">ህርበ ባይእሱንስ ሞፋ ነመ ኡፈቺሰ።<verse eid="PRO 23:21"/></para>
  <para style="s2">ጄቸ ኩዸ ቶርበፋ</para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 23:22"/>አባኬ ከን ስ ዸልቼ ዸገእ፤</para>
  <para style="q2" vid="PRO 23:22">ሃዸኬስ ዬሮ እሼን ጃርቱ ህንቱፈትን።<verse eid="PRO 23:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 23:23"/>ዹጋ ብተዹ መሌ ህንጉርጉርን፤</para>
  <para style="q2" vid="PRO 23:23">ኦጉማ፣ ቀጄልፈማፊ ሁበትናስ ብተዹ።<verse eid="PRO 23:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 23:24"/>አባን ነመ ቀጄላ ገመቹ ጉዳ ቀበ፤</para>
  <para style="q2" vid="PRO 23:24">ነምን እልመ ኦጌሰ ቀቡ እሰት ገመደ።<verse eid="PRO 23:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 23:25"/>አባንኬቲፊ ሃትኬ ሃገመደን፤</para>
  <para style="q2" vid="PRO 23:25">እሼን ስ ዴሴ ሱን ሃእልልችቱ!<verse eid="PRO 23:25"/></para>
  <para style="s2">ጄቸ ኩዸ ሰዴተፋ</para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 23:26"/>ያ እልመኮ፣ ገራኬ ና ኬን፤</para>
  <para style="q2" vid="PRO 23:26">እጅኬስ ከራኮ ሃእላሉ፤<verse eid="PRO 23:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 23:27"/>ሰጋገልቱን ቦለ ገድ ፈጎዻቲ፣</para>
  <para style="q2" vid="PRO 23:27">ኒቲን ገንደ ለቤንስ ቦለ ብሻኒ ዽጳዸ።<verse eid="PRO 23:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 23:28"/>እሼን አኩመ ሳምቱት ርጵጤ ነመ ኤገት፤</para>
  <para style="q2" vid="PRO 23:28">ነሞተ ግዱትስ ወረ ህንአመነምኔ ባይእፍት።<verse eid="PRO 23:28"/></para>
  <para style="s2">ጄቸ ኩዸ ሰግለፋ</para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 23:29"/>ኤኙቱ፣ “አናፍ ወዮ!” ጄዸ? ኤኙቱ ገደ ቀበ?</para>
  <para style="q2" vid="PRO 23:29">ኤኙቱ ሎለ ቀበ? ኤኙቱ ኮሚ ቀበ?</para>
  <para style="q2" vid="PRO 23:29">ኤኙቱ ሰበቢ መሌ መዳአ? ከን እጅሳ ዲመቱ ኤኙ?<verse eid="PRO 23:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 23:30"/>ወረ ዳዺ ወይኒ ዹጉረ አከ መሌ ቱረን፣</para>
  <para style="q2" vid="PRO 23:30">ወረ ዳዺ ወይኒ ወልመካ አፋኒን ቀቡ ዸቀኒዸ።<verse eid="PRO 23:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 23:31"/>ዬሮ እን ዲመቱት፣ ዬሮ እን ብልሌ ኬሰ ኦል ጥጥንቁት፣</para>
  <para style="q2" vid="PRO 23:31">ዬሮ እን ሱተ ጄዼ ገድ ቡኡት</para>
  <para style="q2" vid="PRO 23:31">ዳዺ ወይኒ እጀ እት ቀብዴ ህንእላልን።<verse eid="PRO 23:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 23:32"/>ዹመረት አኩመ ቦፋ ነመ እደ፤</para>
  <para style="q2" vid="PRO 23:32">አኩመ ቡቲስ ነመ ጭኒነ።<verse eid="PRO 23:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 23:33"/>እጅኬ ዋን ሃራ አርገ፤</para>
  <para style="q2" vid="PRO 23:33">ቀልቢንኬስ ጀልእነ ያደ።<verse eid="PRO 23:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 23:34"/>አት አኩመ ነመ ወለካ ገላነ ጉዳ ጪሱት፤</para>
  <para style="q2" vid="PRO 23:34">አኩመ ነመ ፊጤ ኡቱባ ዶኒረ ጪሱ ታተ።<verse eid="PRO 23:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 23:35"/>አት አከነ ጄተ፤ “እሳን ነ ዸአን፤</para>
  <para style="q2" vid="PRO 23:35">አን ገሩ ህንሚዸምኔ!</para>
  <para style="q1" vid="PRO 23:35">እሳን ነ ቱመን፤ ገሩ ነት ህንዸገአምኔ!</para>
  <para style="q2" vid="PRO 23:35">አን ዹጋቲ ብራ በርባደቹፍ ዮመን ደመቀ?”<verse eid="PRO 23:35"/></para>
  <chapter eid="PRO 23"/>
  <chapter number="24" style="c" sid="PRO 24"/>
  <para style="s2">ጄቸ ድግደመፋ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 24:1"/>ሀሞተት ህንህናፍን፤</para>
  <para style="q2" vid="PRO 24:1">ገሬሳኒ ተኡስ ህንሀውን፤<verse eid="PRO 24:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 24:2"/>ገራንሳኒ ሀምነ መለታቲ፤</para>
  <para style="q2" vid="PRO 24:2">ህዺንሳኒስ ረክነ ኦዴሰ።<verse eid="PRO 24:2"/></para>
  <para style="s2">ጄቸ ድግደሚ ቶኮፋ</para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 24:3"/>መን ኦጉማዻን እጃረመ፤</para>
  <para style="q2" vid="PRO 24:3">ሁበትናዻንስ ጀቤፈሜ ዻበመ፤<verse eid="PRO 24:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 24:4"/>ኩታወንሳስ፣ ቤኩምሳን፣ ቀቤኘ ገቲ ጉዳቲፊ</para>
  <para style="q2" vid="PRO 24:4">ሚዸጋዻን ጉተሙ።<verse eid="PRO 24:4"/></para>
  <para style="s2">ጄቸ ድግደሚ ለመፋ</para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 24:5"/>ኦጌስ ሁምነ ጉዳ ቀበ፤</para>
  <para style="q2" vid="PRO 24:5">ቤካን ነማሞ ጀብነ እት ደበለተ፤<verse eid="PRO 24:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 24:6"/>ወራነ በኑፍ ቀጄልፈመ፣</para>
  <para style="q2" vid="PRO 24:6">ሞአትና አርገቹዻፍሞ ጎርስቶተ ሄዱ ስ በርባችሰ።<verse eid="PRO 24:6"/></para>
  <para style="s2">ጄቸ ድግደሚ ሰደፋ</para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 24:7"/>ጎዋራ ኦጉማን አከ መሌ ኦል ፈጎዸ፤</para>
  <para style="q2" vid="PRO 24:7">እን ከረ ዱረት አፋንሳ ህንሳቀቱ።<verse eid="PRO 24:7"/></para>
  <para style="s2">ጄቸ ድግደሚ አፍረፋ</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 24:8"/>ነምን ሀምነ መሉ፣</para>
  <para style="q2" vid="PRO 24:8">“መልቴ” ጄዸመ።<verse eid="PRO 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 24:9"/>መል ጎዉማ ጩቡዸ፤</para>
  <para style="q2" vid="PRO 24:9">ነሞትንስ ቆስቱ ንበልፉ።<verse eid="PRO 24:9"/></para>
  <para style="s2">ጄቸ ድግደሚ ሸነፋ</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 24:10"/>አት ዮ ጋፈ ረክና ላፍቴ፣</para>
  <para style="q2" vid="PRO 24:10">ጀብንኬ ዹጉማኑ ጥናዸ!<verse eid="PRO 24:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 24:11"/>ወረ ገረ ዱኣት ጌፈማ ጅረን ዱአ ጀላ ባስ፤</para>
  <para style="q2" vid="PRO 24:11">ወረ አጄፈሙፍ ቆጴፈመንስ ኦልች።<verse eid="PRO 24:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 24:12"/>ዮ አት፣ “ኑ ዋን ከነ ሆማ ህንቤክኔ” ጄቴ፣</para>
  <para style="q2" vid="PRO 24:12">እን ያደ ነማ መዳሉ ሱን ህንሁበቱ?</para>
  <para style="q1" vid="PRO 24:12">ከን ሉቡኬ ኤጉ ሱን ዋን ከነ ህንቤኩ?</para>
  <para style="q2" vid="PRO 24:12">እን ነመ ሁንዳፍ አኩመ ሆጂሳት ገቲ ህንኬኑ?<verse eid="PRO 24:12"/></para>
  <para style="s2">ጄቸ ድግደሚ ጀአፋ</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 24:13"/>ያ እልመኮ፣ ደም ዋን ጋሪ ተኤፍ ኛዹ፤</para>
  <para style="q2" vid="PRO 24:13">ነዺን ደማ ስት ንምኣወ።<verse eid="PRO 24:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 24:14"/>አከ ኦጉማን ሉቡኬት ምኣዉሌ ቤክ፤</para>
  <para style="q2" vid="PRO 24:14">አት ዮ እሰ አርገቴ ፉል ዱረት አብዲ ቀብደ፤</para>
  <para style="q2" vid="PRO 24:14">አብዲንኬስ ህንጭቱ።<verse eid="PRO 24:14"/></para>
  <para style="s2">ጄቸ ድግደሚ ቶርበፋ</para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 24:15"/>አከ ነመ ሴራን ህንቡሌት መነ ነመ ቀጄላ <optbreak/> ርጵጤ ህንኤገትን፤</para>
  <para style="q2" vid="PRO 24:15">መነ ጅሬኘሳስ ህንሳምን።<verse eid="PRO 24:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 24:16"/>ነምን ቀጄላን ዬሮ ቶርበ ኩፉዩ፣ ዴብኤ ንከኣቲ፤</para>
  <para style="q2" vid="PRO 24:16">ነምን ሀማን ገሩ ዬሮ በላን እት ዹፉት ንጉፈተ።<verse eid="PRO 24:16"/></para>
  <para style="s2">ጄቸ ድግደሚ ሰዴተፋ</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 24:17"/>ዬሮ ዲንኬ ኩፉት ህንእልልችን፤</para>
  <para style="q2" vid="PRO 24:17">ዬሮ እን ጉፈቱትስ ገራንኬ ህንገመድን፤<verse eid="PRO 24:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 24:18"/>ዮ ከና አቺ <char style="nd">ዋቀዮ</char> ዋን ከነት ንገዳቲ፤</para>
  <para style="q2" vid="PRO 24:18">ዼከምሰሳስ እሰራ ዴብሰ።<verse eid="PRO 24:18"/></para>
  <para style="s2">ጄቸ ድግደሚ ሰግለፋ</para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 24:19"/>አት ሰበቢ ጀልኦታቲፍ ኣሪዻን ህንጉበትን፤</para>
  <para style="q2" vid="PRO 24:19">ሀሞተትስ ህንህናፍን።<verse eid="PRO 24:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 24:20"/>ነምን ጀልኣን ፉል ዱረት አብዲ ህንቀቡቲ፤</para>
  <para style="q2" vid="PRO 24:20">እብሳን ሀሞታስ ንዻመ።<verse eid="PRO 24:20"/></para>
  <para style="s2">ጄቸ ሶዶመፋ</para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 24:21"/>ያ እልመኮ፣ <char style="nd">ዋቀዮፊ</char> ሞቲ ሶዳዹ፤</para>
  <para style="q2" vid="PRO 24:21">ፍንጭልቶተትስ ህንመከምን፤<verse eid="PRO 24:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 24:22"/>በዲስን አኩመ ተሳ እሳንት ዹፋቲ፤</para>
  <para style="q2" vid="PRO 24:22">በላ እሳን ለቹ ፍደን ኤኙቱ ቤከ?<verse eid="PRO 24:22"/></para>
  <para style="ms1">ጄቸ ኦጌሳ ከን እት ፉፌ</para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 24:23"/>ኩኔንስ ጄቾተ ኦጌሳት፦</para>
  <para style="q1" vid="PRO 24:23">ሙርቲ ኬኑረት ነመ ወል ጫልችሱን ጋሪ ምት፦<verse eid="PRO 24:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 24:24"/>ከን ነመ የከ ቀቡን፣ “አት በሌሳ ህንቀብዱ”</para>
  <para style="q2" vid="PRO 24:24">ጄዹ ከምዩ ነምን እሰ አባረ፤ ሰብንስ እሰ በላሌፈተ።<verse eid="PRO 24:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 24:25"/>ወር ነመ የከ ሆጄቱ እፈተን ገሩ ንገመዱ፤</para>
  <para style="q2" vid="PRO 24:25">ኤብ ጉዳንስ ንዹፋፍ።<verse eid="PRO 24:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 24:26"/>ዴቢን ቀጄላን፣</para>
  <para style="q2" vid="PRO 24:26">አኩመ ህዺ ዹንገቹት።<verse eid="PRO 24:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 24:27"/>ሆጂኬ ከን ዲዳ ራወዹቲ</para>
  <para style="q2" vid="PRO 24:27">ለፈ ቆቲሳኬስ ቆጴፈዹ፤</para>
  <para style="q2" vid="PRO 24:27">ኤርገሲ መነኬ እጃረዹ።<verse eid="PRO 24:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 24:28"/>ሰበቢ ቶኮ መሌ ኦላኬት ዹጋ ህንበእን</para>
  <para style="q2" vid="PRO 24:28">ዮካን ህዺኬቲን ህንጎዎምስን።<verse eid="PRO 24:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 24:29"/>አት፣ “ዋኑመ እን ነ ጎዼ አንስ እሰ ነንጎዸ፤</para>
  <para style="q2" vid="PRO 24:29">ዋን እን ሆጄቴፍስ ገቲሳ ነንዴብሰ” ህንጄዽን።<verse eid="PRO 24:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 24:30"/>አን ለፈ ቆቲሳ ነመ ዽባኣ ኬሰ በኤ፣</para>
  <para style="q2" vid="PRO 24:30">እዶ ዻባ ወይኒ ነመ ቀልቢ ህንቀብኔ ኬሰስ ደርቤ፤<verse eid="PRO 24:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 24:31"/>ቆራቲን ለፈ ሁንደ ጉቴረ፤</para>
  <para style="q2" vid="PRO 24:31">ለፍትስ አረማዻን ፉዸተሜረ፤</para>
  <para style="q2" vid="PRO 24:31">ደላን ዸጋስ ዲገሜረ።<verse eid="PRO 24:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 24:32"/>አን አርጌን ዋን ሰነ ቀልቤፈዼ፤</para>
  <para style="q2" vid="PRO 24:32">ዋነን አርጌ ሰነራስ በሩምሰ ነንአርገዼ፦<verse eid="PRO 24:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 24:33"/>ህርበ ጥና፤ ሙጋቲ ጥና፤</para>
  <para style="q2" vid="PRO 24:33">ጥኖ ሀርከ ወልት መረቹ፤<verse eid="PRO 24:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 24:34"/>ህዩማንስ አኩመ ሀቱት፣</para>
  <para style="q2" vid="PRO 24:34">ዴጉማንስ አኩመ ሎልቱ ህዸቴት ስት ዹፈ።<verse eid="PRO 24:34"/></para>
  <chapter eid="PRO 24"/>
  <chapter number="25" style="c" sid="PRO 25"/>
  <para style="ms1">ፈኬኘ ሶሎሞን ደበለታ</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 25:1"/>ፈኬኘወን ኩኔን ፈኬኘወን ሶሎሞን ከኔን ነሞትን ህስቅያስ፣ ሞትቸ ይሁዳ ገረገልቸኒዸ፦<verse eid="PRO 25:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 25:2"/>ዋ ዾክሱን ዋቃፍ ኡልፍነሳት፤</para>
  <para style="q2" vid="PRO 25:2">ዋ ሰከተአኒ ብረ ገኡንሞ ኡልፍነ ሞቶታት።<verse eid="PRO 25:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 25:3"/>አኩመ ሰሚወን ኦል ዼረተኒ</para>
  <para style="q2" vid="PRO 25:3">ለፍትስ ገድ ፈጋቱ ሰነ፣ ያድን ሞቶታ ቆረተሜ ብረ ህንገአሙ።<verse eid="PRO 25:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 25:4"/>ሜቲራ ጡሪ ባስ፤</para>
  <para style="q2" vid="PRO 25:4">ኤርገሲ ቱምቱን ቆዳ ቶልቹ ደንደአ።<verse eid="PRO 25:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 25:5"/>ነመ ሀማ ፉለ ሞቲ ዱራ በሌስ፤</para>
  <para style="q2" vid="PRO 25:5">ኤርገሲ ቴሶንሳ ቀጄሉማዻን ንጀባተ።<verse eid="PRO 25:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 25:6"/>ፉለ ሞቲ ዱረት ኦል ኦፍ ህንቀብን፤</para>
  <para style="q2" vid="PRO 25:6">እዶ ነሞተ ጉርጉዳስ ህንዻበትን፤<verse eid="PRO 25:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 25:7"/>እን ፉለ ነሞተ ቤቤከሞ ዱረት ስ ሰልጵሱረ፣</para>
  <para style="q2" vid="PRO 25:7">ዮ እን፣ “አስ ኦል ኮቱ” ሲን ጄዼ ወያ።</para>
  <para style="b" vid="PRO 25:7"/>
  <para style="q1" vid="PRO 25:7">አት ዋን እጀኬቲን አርግቴ፣<verse eid="PRO 25:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="PRO 25:8"/>ደፍቴ መነ ሙርቲት ህንፍድን፤</para>
  <para style="q1" vid="PRO 25:8">ዮ ኦላንኬ ስ ቃኔሴ፣</para>
  <para style="q2" vid="PRO 25:8">ዹመረት አት ማል ጎቹ ደንዴሰ?<verse eid="PRO 25:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 25:9"/>ዽመኬ ኦላኬ ወጅን ፈልመዹ፤</para>
  <para style="q2" vid="PRO 25:9">እጭቲ ነመ ካኒሞ ህንባስን፤<verse eid="PRO 25:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 25:10"/>ዮ ከና አቺ ነምን ዋን ሰነ ዸገኤ ስ ቃኔሰ፤</para>
  <para style="q2" vid="PRO 25:10">መቃን ሀማን ሲፍ ኬነሜ ሱንስ ስራ ህንበኡ።<verse eid="PRO 25:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 25:11"/>ዱቢን ዬሮሳት ዱበተሜ፣</para>
  <para style="q2" vid="PRO 25:11">አኩመ ሁዻ ወርቄ ከን ሜቲረት ሆጄተሜት።<verse eid="PRO 25:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 25:12"/>እፈትን ነመ ኦጌሳ ጉረ ዸጌፈቱፍ፣</para>
  <para style="q2" vid="PRO 25:12">ሎቲ ወርቄ ዮካን ፋየ ወርቄ ቁልቁሉት።<verse eid="PRO 25:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 25:13"/>ኤርገማን አመነማን ቶኮ ወረ እሰ ኤርገተኒፍ</para>
  <para style="q2" vid="PRO 25:13">አኩመ ቀበነ ጨቢ ከን ዬሮ ምዻን ሃመኒት፤</para>
  <para style="q2" vid="PRO 25:13">እን ሀፉረ ጎፍቶተሳ ሃሮምሳቲ።<verse eid="PRO 25:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 25:14"/>ነምን ኬና ነማፍ ህንኬንኔን ቦኑ ቶኮ</para>
  <para style="q2" vid="PRO 25:14">አኩመ ዱሜሳፊ ቡቤ ቦካ ህንቀብኔት።<verse eid="PRO 25:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 25:15"/>ኦብሳን ቡልቻ ቶኮ ገራ ላፍፈቹን ንደንደአመ፤</para>
  <para style="q2" vid="PRO 25:15">ዱቢን መላን ዱበተሜ ለፌ ንጨብሰ።<verse eid="PRO 25:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 25:16"/>ደመ ዮ አርገቴ ሀመ ስ ገኡ ኛዹ፤</para>
  <para style="q2" vid="PRO 25:16">ዮ ባይእፍቴ ኛቴ ንድድግደ።<verse eid="PRO 25:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 25:17"/>መነ ኦላኬቲ ዸቁ ህንባይእስን፤</para>
  <para style="q2" vid="PRO 25:17">ዮ አት ሚለ እት ባይእፍቴ እን ስ ጅበ።<verse eid="PRO 25:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 25:18"/>ነምን ሶባን ኦላሳት ዹጋ በኡ፣ አኩመ ቦኩ ዮካን</para>
  <para style="q2" vid="PRO 25:18">ጎራዴ ዮካን ጥየ ቀረ ቀቡት።<verse eid="PRO 25:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 25:19"/>ነመ ህንአመነምኔ ቶኮ ዬሮ ረኮት አብደቹን</para>
  <para style="q2" vid="PRO 25:19">አኩመ እልካን ጨቤ ዮካን ሚለ ኦኮሉት።<verse eid="PRO 25:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 25:20"/>ነመ ገራንሳ ገዴፍ ስርበ ስርቡን</para>
  <para style="q2" vid="PRO 25:20">አኩመ ነመ ጉያ ዻሞቻ ወያ ኦፍራ ባሱ፣</para>
  <para style="q2" vid="PRO 25:20">ዮካን መዳረት ዸንገጋኣ ዸንገላሱት።<verse eid="PRO 25:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 25:21"/>ዮ ዲንኬ ቤለኤ ዋን እን ኛቱ ኬኒፍ፤</para>
  <para style="q2" vid="PRO 25:21">ዮ እን ዼቦቴስ ብሻን እን ዹጉ ኬኒፍ።<verse eid="PRO 25:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 25:22"/>ከነ ጎቹኬቲን በርበዳ እብዳ መታሳረ ቱልተ፤</para>
  <para style="q2" vid="PRO 25:22">
    <char style="nd">ዋቀዮስ</char> ስበዻሰ።<verse eid="PRO 25:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 25:23"/>አኩመ ቡቤን ካባ ቦካ ፍዱ፣</para>
  <para style="q2" vid="PRO 25:23">አረብን ሀመቱስ ፉለ ዼከሙ ፍደ።<verse eid="PRO 25:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 25:24"/>ኒቲ ኘክፍቱ ወጅን መነ ቶኮ ኬሰ ጅራቹ መና፣</para>
  <para style="q2" vid="PRO 25:24">ጎሌ በንቲ መናረ ጅራቹ ወየ።<verse eid="PRO 25:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 25:25"/>ኦዱን ጋሪን ብየ ፈጎቲ ዹፉ፣</para>
  <para style="q2" vid="PRO 25:25">አኩመ ብሻን ቀበናኣ ሉቡ ዼቦቴፍ ተኡት።<verse eid="PRO 25:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 25:26"/>ነምን ቀጄላን ፉለ ሀሞታ ዱረት ኩፉ፣</para>
  <para style="q2" vid="PRO 25:26">አኩመ ቡርቃ ዾቃኤ ዮካን ቦለ ብሻኒ ፋለሜ ቶኮት።<verse eid="PRO 25:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 25:27"/>ደመ ባይኤ ኛቹን ጋሪ ምት፤</para>
  <para style="q2" vid="PRO 25:27">ኡልፍነ መታ ኦፊ በርባዱንስ ኡልፍነ ምት።<verse eid="PRO 25:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 25:28"/>ነምን ኦፍ ህንቀብኔ፣</para>
  <para style="q2" vid="PRO 25:28">አኩመ መጋላ ደላንሳ ዲገሜት።<verse eid="PRO 25:28"/></para>
  <chapter eid="PRO 25"/>
  <chapter number="26" style="c" sid="PRO 26"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 26:1"/>አኩመ ጨቢ ዬሮ ቦና ዮካን ቦካ ዬሮ ሃማ፣</para>
  <para style="q2" vid="PRO 26:1">ነመ ጎዋፍ ኡልፍን ህንመሉ።<verse eid="PRO 26:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 26:2"/>አኩመ ስምብር በርፍቱ ዮካን ዳሎቴን በርፍቱ</para>
  <para style="q2" vid="PRO 26:2">አባርስ ሰበቢ መሌ ዹፉ ነመረ ህንቡኡ።<verse eid="PRO 26:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 26:3"/>አለንጋን ፈርዳፍ፣ ሉገምን ሀሬፍ፣</para>
  <para style="q2" vid="PRO 26:3">ኡሌንሞ ዱግደ ጎዋቲፍ መለ!<verse eid="PRO 26:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 26:4"/>ጎዋዻፍ አከ ጎዉማሳት ህንዴብስን፤</para>
  <para style="q2" vid="PRO 26:4">ዮ አከስ ጎቴ አት መታንኬዩ አኩመሳ ታተ።<verse eid="PRO 26:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 26:5"/>ጎዋዻፍ ዴቢ ጎዉማሳቲፍ መሉ ኬን፤</para>
  <para style="q2" vid="PRO 26:5">ዮ ከና አቺ እን ኦጌሰ ኦፍ ሴኣ።<verse eid="PRO 26:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 26:6"/>ሀርከ ነመ ጎዋት ኤርጋ ኤርገቹን፣</para>
  <para style="q2" vid="PRO 26:6">አኩመ ሚለ ኦፊራ ሙሩ ዮካን ሱሚ ዹጉት።<verse eid="PRO 26:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 26:7"/>አፋን ነመ ጎዋ ኬሰት፣</para>
  <para style="q2" vid="PRO 26:7">ፈኬኝ አኩመ ሚለ ናፋት።<verse eid="PRO 26:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 26:8"/>ነምን ጎዋዻፍ ኡልፍነ ኬኑ፣</para>
  <para style="q2" vid="PRO 26:8">አኩመ ነመ ፉርሳት ዸጋ ጉዱንፉት።<verse eid="PRO 26:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 26:9"/>ፈኬኝ አፋን ጎዋ ኬሰት</para>
  <para style="q2" vid="PRO 26:9">አኩመ ቆራቲ ሀርከ ነመ መቻኤ ኬሳት።<verse eid="PRO 26:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 26:10"/>ነምን ጎዋ ዮካን ከረ ዴማ ቀጠረቱ</para>
  <para style="q2" vid="PRO 26:10">አኩመ አደምሳ ነመ ሁንደ ጥያን መዴሱት።<verse eid="PRO 26:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 26:11"/>አኩመ ሰሬን ድድገሼት ዴብቱ ሰነ፣</para>
  <para style="q2" vid="PRO 26:11">ጎዋን ጎዉማሳረ ዴዴብአ።<verse eid="PRO 26:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 26:12"/>አት ነመ አከ እላልቸ ኦፊሳት ኦጌሰ ተኤ አርግታ?</para>
  <para style="q2" vid="PRO 26:12">እሳረ ጎዋቱ አብዲ ጫሉ ቀበ።<verse eid="PRO 26:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 26:13"/>ዽባኣን፣ “ሌንጭ ከራረ ጅረ፤</para>
  <para style="q2" vid="PRO 26:13">ሌንጭ ሶዳችሳን ዳንዲረ ጅረ!” ጄዸ።<verse eid="PRO 26:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 26:14"/>አኩመ ሳንቃን ሙቾሳረ ናነኡ፣</para>
  <para style="q2" vid="PRO 26:14">ዽባኣን ስሬ ኦፊረ ገገረገለ<verse eid="PRO 26:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 26:15"/>ዽባኣን ሀርከሳ ወጪቲ ኬሰ ካአ፤</para>
  <para style="q2" vid="PRO 26:15">ገረ አፋንሳት ዴብፈቹፍ ንዽባአ።<verse eid="PRO 26:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 26:16"/>ዽባኣን ነሞተ ሁበትናዻን</para>
  <para style="q2" vid="PRO 26:16">ዴቢ ኬነን ቶርበ ጫላ ኦጌሰ ኦፍ ሴአ።<verse eid="PRO 26:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 26:17"/>ነምን ሎለ ነመ ብራ ኬሰ ሴኑ፣</para>
  <para style="q2" vid="PRO 26:17">አኩመ ነመ ሀርካን ጉረ ሰሬ ቀቡት።<verse eid="PRO 26:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 26:18"/>አኩመ መራቱ እብደ ዮካን ጥየ</para>
  <para style="q2" vid="PRO 26:18">ነመት ገድ ዺሱ ቶኮ<verse eid="PRO 26:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 26:19"/>ነምን፣ “አን ነንቆሴ!” ጄዼ</para>
  <para style="q2" vid="PRO 26:19">ኦላሳ ጎዎምሱስ አከሱመ።<verse eid="PRO 26:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 26:20"/>እብድ ዮ ቆራን ዸቤ ንዻመ፤</para>
  <para style="q2" vid="PRO 26:20">ሀሚን ዮ ህንጅራትኔ፣ ሎል ንቀበናአ።<verse eid="PRO 26:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 26:21"/>አኩመ ጭሌን በርበዳ እብዳ ቦቤሴ <optbreak/> ቆራን እብደ ቀብሲሱ ሰነ</para>
  <para style="q2" vid="PRO 26:21">ነምን ሎለ ጃለቱ ሎለ ከካሰ።<verse eid="PRO 26:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 26:22"/>ዱቢን ሀመቱ አኩመ ጉርሻ ምኣዉት፤</para>
  <para style="q2" vid="PRO 26:22">ገረ ኩታ ገራትስ ገድ ቡአ።<verse eid="PRO 26:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 26:23"/>ዱቢን ጋሪን ገራ ሀማ ኬሳ በኡ</para>
  <para style="q2" vid="PRO 26:23">አኩመ ኦኮቴ ሜቲንረ ድበሜት።<verse eid="PRO 26:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 26:24"/>ነምን መቃ ነማ በሌሱ ቶኮ <optbreak/> አረቡመ ኦፊቲን ነመ ቶላ ኦፍ ፈኬሰ፤</para>
  <para style="q2" vid="PRO 26:24">ገራሳ ኬሰትሞ ጎዎምሳ ጉዱንፈተ።<verse eid="PRO 26:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 26:25"/>ዮ ዱቢንሳ ስት ምኣዌዩ እሰ ህንአመንን፤</para>
  <para style="q2" vid="PRO 26:25">ወን ጅብሲሳን ቶርበ ገራሳ ጉቴራቲ።<verse eid="PRO 26:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 26:26"/>ጀልእንሳ ሶባን ሀጉገሜ ዾክፈሙ ደንደአ፤</para>
  <para style="q2" vid="PRO 26:26">ሀምንሳ ገሩ ፉለ ወልዳ ዱረት እፈት በአ።<verse eid="PRO 26:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 26:27"/>ነምን ቦለ ቆቱ ቦለ ኬሰ ቡአ፤</para>
  <para style="q2" vid="PRO 26:27">ነመ ዸጋ ገንገልቹስ፣ <optbreak/> ዸጋን ሱን እሱመት ዴብአ።<verse eid="PRO 26:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 26:28"/>አረብን ሶቡ ቶኮ ወሩመ ሚዹ ሰነ ጅበ፤</para>
  <para style="q2" vid="PRO 26:28">አፋን ሳዱ ቶኮስ በዲሰ ፍደ።<verse eid="PRO 26:28"/></para>
  <para style="b"/>
  <chapter eid="PRO 26"/>
  <chapter number="27" style="c" sid="PRO 27"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 27:1"/>አት ዋኤ ቦሪቲን ህንቦንን፤</para>
  <para style="q2" vid="PRO 27:1">ዋን ጉያን ፍዱ ህንቤክቱቲ።<verse eid="PRO 27:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 27:2"/>ነምን ብራ ስ ሃጀጁ መሌ አት አፋንኬቲን ኦፍ ህንጀጅን፤</para>
  <para style="q2" vid="PRO 27:2">ነምን ካን ስ ሃጀጁ መሌ ህዺንኬ ስ ህንጀጅን።<verse eid="PRO 27:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 27:3"/>ዸጋን ንኡልፋተ፤ ጭረችስ በኣዸ፤</para>
  <para style="q2" vid="PRO 27:3">ቱቱቃን ጎዋ ገሩ ለቹ ጫላ ኡልፋተ።<verse eid="PRO 27:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 27:4"/>ዼከምስ ገረ ጀቤሰ፤ ኣሪንስ ጉቴ ዸንገለአ፤</para>
  <para style="q2" vid="PRO 27:4">ህናፋ ዱረ ገሩ ኤኙቱ ዻበቹ ደንደአ?<verse eid="PRO 27:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 27:5"/>ጃለለ ዾክፈሜ መና</para>
  <para style="q2" vid="PRO 27:5">እፈትና እፈት በኤ ወየ።<verse eid="PRO 27:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 27:6"/>መዳን ምቹን ነመ መዴሱ አመነማዸ፤</para>
  <para style="q2" vid="PRO 27:6">ዹንገቹን ዲና ገሩ ጎዎምሳዸ።<verse eid="PRO 27:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 27:7"/>ነምን ቁፌ ደመሌ ንበልፈ፤</para>
  <para style="q2" vid="PRO 27:7">ከን ቤለኤ ገሩ ወን ሀዻኡዩ እት ምኣወ።<verse eid="PRO 27:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 27:8"/>ነምን መነሳቲ በዱ ቶኮ፣</para>
  <para style="q2" vid="PRO 27:8">አኩመ ስምብሮ መንኤሼቲ በዱት።<verse eid="PRO 27:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 27:9"/>ሽቶፊ እጣን ገራ ነመ ገመቺሱ፤</para>
  <para style="q2" vid="PRO 27:9">ጎርስ ምቹስ ገራ ነመ ጪብሰ።<verse eid="PRO 27:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 27:10"/>ምቾተኬቲፊ ምቾተ አባኬቲ ህንገትን፤</para>
  <para style="q2" vid="PRO 27:10">ዮ በላን ስት ዹፌ መነ ኦቦሌሰኬቲ ህንዸቅን፤</para>
  <para style="q2" vid="PRO 27:10">ኦቦሌሰ ፈጎ ጅሩረ ኦላ ዽኦ ጅሩ ወየ።<verse eid="PRO 27:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 27:11"/>ያ እልመኮ፣ ኦጌሰ ተኢቲ ገራኮ ገመቺስ፤</para>
  <para style="q2" vid="PRO 27:11">ኤርገሲ አን ነመ ነ ቱፈቱ ሁንዳፍ <optbreak/> ዴቢ ኬኑ ነንደንደአ።<verse eid="PRO 27:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 27:12"/>ነምን ሁበታን በላ አርጌ ጀላ ዾከተ፤</para>
  <para style="q2" vid="PRO 27:12">ወላላንሞ እቱመ ዴሜ አደበመ።<verse eid="PRO 27:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 27:13"/>ነመ ነመ ኦርማቲፍ ወቢ ተኤራ ኡፈተሳ ፉዸዹ፤</para>
  <para style="q2" vid="PRO 27:13">ዮ እን ዱበርቲ ኦርማቲፍ ወቢ ተኤስ ኡፈተ ሰነ ቀብዲ ቀበዹ።<verse eid="PRO 27:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 27:14"/>ነምን ቶኮ ገነማን ሰገሌ ኦል ፉዸቴ <optbreak/> ኦላሳ ዮ ኤብሴ</para>
  <para style="q2" vid="PRO 27:14">ወን ሱን አከ አባርሳት ፉዸተመ።<verse eid="PRO 27:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 27:15"/>ኒቲን ኘክፍቱን፣ አኩመ ቦካ ጉያ ሮባ</para>
  <para style="q2" vid="PRO 27:15">ዽምሳ ኦሉት፤<verse eid="PRO 27:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 27:16"/>እሼ እትሱን አኩመ ቡቤ እትሱት</para>
  <para style="q2" vid="PRO 27:16">ዮካን አኩመ ዘይቲ ሀርካን ቀቡት።<verse eid="PRO 27:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 27:17"/>አኩመ ስቢል ስቢለ ቀሩ፣</para>
  <para style="q2" vid="PRO 27:17">ነምን ቶኮ ነመ ካን ቀረ።<verse eid="PRO 27:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 27:18"/>ነምን ሙከ ሀርቡ ኤገቱ ቶኮ እጀሳ ኛተ፤</para>
  <para style="q2" vid="PRO 27:18">ነምን ጎፍታሳ ኤገቱስ ኡልፍነ አርገተ።<verse eid="PRO 27:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 27:19"/>አኩመ ብሻን ፉለ ነማ አርግሲሱ ሰነ</para>
  <para style="q2" vid="PRO 27:19">ገራን ነመ ቶኮ ኤኙማ ነምቻ አርግሲሰ።<verse eid="PRO 27:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 27:20"/>ዱኣፊ በዲስን ጎንኩማ ህንቁፈን፤</para>
  <para style="q2" vid="PRO 27:20">እጅ ነማስ አከሱመ።<verse eid="PRO 27:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 27:21"/>ኦኮቴን ዋ እት በቅሰን ሜቲፍ፤</para>
  <para style="q2" vid="PRO 27:21">ቦል እብዳሞ ወርቄፍ፤</para>
  <para style="q2" vid="PRO 27:21">ነምንሞ ኡልፍነ አርገቱን ቆረመ።<verse eid="PRO 27:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 27:22"/>ጎዋ ሞዬ ኬሰት ዮ ቱምቴዩ፣</para>
  <para style="q2" vid="PRO 27:22">አኩመ ምዻኒት ሙከ ሞዬቲን እሰ ቡሌስቴዩ፣</para>
  <para style="q2" vid="PRO 27:22">አት ጎዉማ እሰራ ህንበሌስቱ።<verse eid="PRO 27:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 27:23"/>ሃለ ቡሻዬንኬ ኬሰ ጅረን ስሪት ቤክ፤</para>
  <para style="q2" vid="PRO 27:23">ሎንኬቲፍስ ጥዬፈትና ኬን፤<verse eid="PRO 27:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 27:24"/>ሶሩምን በረ በራን እት ህንፉፉቲ፤</para>
  <para style="q2" vid="PRO 27:24">ጎንፎንስ ዸሎተራ ዸሎተት ህንደርቡ።<verse eid="PRO 27:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 27:25"/>ዬሮ ኦካን ሃመሜ ብቅላ ሃራን ጀላን ብቅሌ</para>
  <para style="q2" vid="PRO 27:25">መርግ ቱሉራ ወልት ቀበሙት፣<verse eid="PRO 27:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 27:26"/>ጦባላወኒን ዳረ ባተ፤</para>
  <para style="q2" vid="PRO 27:26">ሬኦትንሞ ገቲ ለፈ ቆቲሳ ሲፍ ተኡ።<verse eid="PRO 27:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 27:27"/>አት ኦፊኬቲፊ ማቲኬ፣ <optbreak/> ጦምቦሬወንኬስ እቲን ጅራችሱፍ</para>
  <para style="q2" vid="PRO 27:27">ኣነን ሬኦታ ባይኤ ንቀባተ።<verse eid="PRO 27:27"/></para>
  <para style="b"/>
  <chapter eid="PRO 27"/>
  <chapter number="28" style="c" sid="PRO 28"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 28:1"/>ነምን ሀማን ኡቱ ነምን ቶኮዩ እሰ ህንአርእን በቀተ፤</para>
  <para style="q2" vid="PRO 28:1">ቀጄልቶትን ገሩ አኩመ ሌንጫ እጀ ጀባቱ።<verse eid="PRO 28:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 28:2"/>ብየ ፍንጭሉ ኬሰ ቡልችቶተ ሄዱቱ ጅረ፤</para>
  <para style="q2" vid="PRO 28:2">ቡልቻን ሁበታኒፊ ቤካን ገሩ ሴረ ኤግስሰ።<verse eid="PRO 28:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 28:3"/>ቡልቻን ህዬሰ ሀጩጩ ቶኮ</para>
  <para style="q2" vid="PRO 28:3">አኩመ ቦካ ጀባ ምዻን ለፈራ በሌሱት።<verse eid="PRO 28:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 28:4"/>ወር ሴረ ድደን ሀሞተ ጀጁ፤</para>
  <para style="q2" vid="PRO 28:4">ወር ሴረ ኤገን ገሩ እሳኒን ሞርሙ።<verse eid="PRO 28:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 28:5"/>ጀልኦትን ሙርቲ ቀጄላ ህንሁበተን፤</para>
  <para style="q2" vid="PRO 28:5">ወር <char style="nd">ዋቀዮን</char> በርባደንሞ <optbreak/> ጉቱማን ጉቱት ሁበቱ።<verse eid="PRO 28:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 28:6"/>ሶሬሰ ከራንሳ ጀልኣ ተኤ መና</para>
  <para style="q2" vid="PRO 28:6">ህዬሰ አዴምስሳ ሙዳ ህንቀብኔ ወየ።<verse eid="PRO 28:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 28:7"/>ነምን ሴረ ኤጉ እልመ ኦጌሰ፤</para>
  <para style="q2" vid="PRO 28:7">ምቹን አልባዼሳሞ አባሳ ቃኔሰ።<verse eid="PRO 28:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 28:8"/>ነምን ዸላፊ ሂቂዻን ቀቤኘሳ ጉድፈቱ ከምዩ፣</para>
  <para style="q2" vid="PRO 28:8">ነመ ህዬሳፍ ገራ ላፉፍ ወልት ቀበ።<verse eid="PRO 28:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 28:9"/>ነመ ሴራፍ ጉረ ኬኑ ድዱ ከምዩ፣</para>
  <para style="q2" vid="PRO 28:9">ከዸናንሳ በልፈማዸ።<verse eid="PRO 28:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 28:10"/>ነምን ነመ ቶላ ከራ ጀልኣረ አዴምስሱ ከምዩ</para>
  <para style="q2" vid="PRO 28:10">ክዮ ኦፊሳ ኬሰ ሴነ፤</para>
  <para style="q2" vid="PRO 28:10">ነምን በሌሳ ህንቀብኔ ገሩ ዻለ ጋሪ አርገተ።<verse eid="PRO 28:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 28:11"/>ነምን ሶሬስ ኦጌሰ ኦፍ ሴአ፤</para>
  <para style="q2" vid="PRO 28:11">ህዬስ ሁበትና ቀቡ ገሩ እሰ ቆሬ ብረ ገአ።<verse eid="PRO 28:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 28:12"/>ዬሮ ነምን ቀጄላን ሞአቱት ገመቹ ጉዳቱ ተአ፤</para>
  <para style="q2" vid="PRO 28:12">ዬሮ ነምን ሀማን ኣንጎ ቀበቱት ገሩ <optbreak/> ነሞትን ንዾከቱ።<verse eid="PRO 28:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 28:13"/>ነምን ጩቡ ኦፊ ዾክፈቱ ህንምልካኡ፤</para>
  <para style="q2" vid="PRO 28:13">ከን ጩቡሳ ህመቴራ ዴብኡ ገሩ አራረ አርገተ።<verse eid="PRO 28:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 28:14"/>ነምን ዬሮ ሁንደ <char style="nd">ዋቀዮን</char> ሶዳቱ ኤብፈማዸ፤</para>
  <para style="q2" vid="PRO 28:14">ከን መታ ጀባቱ ገሩ ረኮ ኬሰት ኩፈ።<verse eid="PRO 28:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 28:15"/>ነምን ሀማን ህዬዪ ቡልቹ፣</para>
  <para style="q2" vid="PRO 28:15">አኩመ ሌንጨ ኣዱ ዮካን አማኬተ ወይት አሪፈቱት።<verse eid="PRO 28:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 28:16"/>ቡልቻን አከ መሌ ነመ ጩንቁርሱ ሁበትና ህንቀቡ፤</para>
  <para style="q2" vid="PRO 28:16">ከን ቡኣ ከራ ህንመሌን አርገሙ ጅቡ ገሩ በረ ዼራ ጅራተ።<verse eid="PRO 28:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 28:17"/>ነምን የክ ዺገ ነማ ዸንገላሱ እሰረ ጅሩ፣</para>
  <para style="q2" vid="PRO 28:17">ቦለት በቀተ፤</para>
  <para style="q2" vid="PRO 28:17">ነምን ቶኮዩ እሰ ህንገርጋርን።<verse eid="PRO 28:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 28:18"/>ነምን አዴምስሳ ሙዳ ህንቀብኔ ነጉማን ጅራተ፤</para>
  <para style="q2" vid="PRO 28:18">ከን ከራንሳ ጀልኣ ተኤ ገሩ ቦለት ኩፈ።<verse eid="PRO 28:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 28:19"/>ነምን ለፈሳ ቆተቱ ኛተ ጉዳ አርገተ፤</para>
  <para style="q2" vid="PRO 28:19">ከን ያደ ፋይዳ ህንቀብኔ ዱካ ቡኡ ገሩ <optbreak/> ህዩማን ጉተመ።<verse eid="PRO 28:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 28:20"/>ነምን አመነማን ኤበ ቁፈ፤</para>
  <para style="q2" vid="PRO 28:20">ከን ሶሮሙት ገገቡ ገሩ አደቢ ጀላ ህንበኡ።<verse eid="PRO 28:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 28:21"/>ነመ ወል ጫልችሱን ጋሪ ምት፤</para>
  <para style="q2" vid="PRO 28:21">ነምን ገሩ ሙራ ቡዴና አርገቹፍ ጄዼ የከ ሆጄተ።<verse eid="PRO 28:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 28:22"/>ነምን ዋ ከጄሉ ሶሮሙፍ ጀርጀረ፤</para>
  <para style="q2" vid="PRO 28:22">እን አከ ህዩማን እሰ ኤገቱ ህንቤኩ።<verse eid="PRO 28:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 28:23"/>ነምን ነመ እፈቱ ዹመረት</para>
  <para style="q2" vid="PRO 28:23">ነመ አረባን ነመ ሳዱ ጫላ ሱራ አርገተ።<verse eid="PRO 28:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 28:24"/>ነምን አባ ዮካን ሃዸሳ ሳሜ፣</para>
  <para style="q2" vid="PRO 28:24">“ኩን በሌሳ ምት” ጄዹ</para>
  <para style="q2" vid="PRO 28:24">ገሬ ነመ ዋ በሌሱት።<verse eid="PRO 28:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 28:25"/>ነምን ወይት ገገቡ ሎለ ከካሰ፤</para>
  <para style="q2" vid="PRO 28:25">ከን <char style="nd">ዋቀዮን</char> አመነቱ ገሩ ንበዻዸ።<verse eid="PRO 28:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 28:26"/>ነምን ኦፍ አመነቱ ጎዋዸ፤</para>
  <para style="q2" vid="PRO 28:26">ከን ኦጉማዻን ዴሙሞ ነጋዻን ጅራተ።<verse eid="PRO 28:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 28:27"/>ነምን ህዬሳፍ ኬኑ ዋን ቶኮሌ ህንዸቡ፤</para>
  <para style="q2" vid="PRO 28:27">ከን እጀ ዱኑንፈቱ ገሩ አባርሰ ባይኤ አርገተ።<verse eid="PRO 28:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 28:28"/>ዬሮ ነምን ሀማን ኣንጎ ቀበቱት <optbreak/> ነሞትን ንዾከቱ፤</para>
  <para style="q2" vid="PRO 28:28">ዬሮ ነምን ሀማን በዱት ገሩ ቀጄልቶትን ንባይአቱ።<verse eid="PRO 28:28"/></para>
  <para style="b"/>
  <chapter eid="PRO 28"/>
  <chapter number="29" style="c" sid="PRO 29"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 29:1"/>ነምን እፈትና ባይኤ ቦዴ</para>
  <para style="q2" vid="PRO 29:1">መታ ጀባቱ ከምዩ አኩመ ተሳ ጨበ፤ ህንፈዩስ።<verse eid="PRO 29:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 29:2"/>ዮሙ ነምን ቀጄላን ኣንጎ ቀበቱት፣ ሰብን ንእልልቸ፤</para>
  <para style="q2" vid="PRO 29:2">ዮሙ ነምን ሀማን ቡልቹ ገሩ ሰብን ንጉንጉመ።<verse eid="PRO 29:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 29:3"/>ነምን ኦጉማ ጃለቱ አባሳ ገመቺሰ፤</para>
  <para style="q2" vid="PRO 29:3">ሚልቶትን ሰጋገልቱ ገሩ ቀቤኘሳ በርበዴሰ።<verse eid="PRO 29:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 29:4"/>ሞቲን ሙርቲ ቀጄላዻን ብያፍ ነጋ ቡሰ፤</para>
  <para style="q2" vid="PRO 29:4">ከን መተኣፍ ገገቡሞ ብየ ገርገር ቆቆደ።<verse eid="PRO 29:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 29:5"/>ነምን ኦላሳ ጀጁ፣</para>
  <para style="q2" vid="PRO 29:5">ሚሉመሳቲፍ ክዮ ካአ።<verse eid="PRO 29:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 29:6"/>ነምን ሀማን ጩቡ ኦፊሳቲን ቀበመ፤</para>
  <para style="q2" vid="PRO 29:6">ቀጄላን ገሩ ንፋርፈተ፤ ንእልልቸስ።<verse eid="PRO 29:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 29:7"/>ነምን ቀጄላን ምርገ ህዬሳቲፍ ዻበተ፤</para>
  <para style="q2" vid="PRO 29:7">ነምን ሀማን ገሩ ዽመ አከና ህንቀቡ።<verse eid="PRO 29:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 29:8"/>ቆስቶትን መጋላ ጄቁ፤</para>
  <para style="q2" vid="PRO 29:8">ኦጌዪን ገሩ ኣሪ ቀበኔሱ።<verse eid="PRO 29:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 29:9"/>ዮ ኦጌስ ጎዋ ወጅን መነ ሙርቲ ዸቄ፣</para>
  <para style="q2" vid="PRO 29:9">ጎዋን ሱን ንኣረ ዮካን ንኮልፈ፤ ነጋንስ ህንጅራቱ።<verse eid="PRO 29:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 29:10"/>ነሞትን ዺገ ዼቦተን፣ ነመ አመነማ ጅቡ፤</para>
  <para style="q2" vid="PRO 29:10">ነመ ቶላስ አጄሱ በርባዱ።<verse eid="PRO 29:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 29:11"/>ጎዋን ጉቱማን ጉቱት ኣሪት ኦፍ ኬነ፤</para>
  <para style="q2" vid="PRO 29:11">ኦጌስ ገሩ ኦፍ ቀበ።<verse eid="PRO 29:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 29:12"/>ዮ ቡልቻን ቶኮ ሶበ ዸጌፈቴ፣</para>
  <para style="q2" vid="PRO 29:12">ቆንዳልቶትንሳ ሁንድ ንሀማቱ።<verse eid="PRO 29:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 29:13"/>ህዬሳፊ ነምን ነመ ጩንቁርሱ ዋን ከናን ወል ፈካቱ፦</para>
  <para style="q2" vid="PRO 29:13">
    <char style="nd">ዋቀዮ</char> እጀ ለቸን እሳኒቲፉ አገርቱ ኬነ።<verse eid="PRO 29:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 29:14"/>ዮ ሞቲን ቶኮ ወል ቅጡማዻን <optbreak/> ህዬዪፍ ሙርቲ ኬኔ፣</para>
  <para style="q2" vid="PRO 29:14">ቴሶንሳ በረ በራን ጀባቴ ዻበተ።<verse eid="PRO 29:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 29:15"/>ኡሌፊ እፈትናን ኦጉማ ኬኑ፤ ዳእምን አከሱመት</para>
  <para style="q2" vid="PRO 29:15">ገድ ዺፈሜ ገሩ ሃዸሳ ሰልጵሰ።<verse eid="PRO 29:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 29:16"/>ዮሙ ሀሞን ኣንጎ ቀበተን፣ ጩቡቱ ባይአተ፤</para>
  <para style="q2" vid="PRO 29:16">ቀጄልቶትን ገሩ ኩፋቲ ጀራ አርጉ።<verse eid="PRO 29:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 29:17"/>እልመኬ አደበዹ፣ እን ነጋ ሲፍ ኬነ፤</para>
  <para style="q2" vid="PRO 29:17">ሉቡኬስ ንገመቺሰ።<verse eid="PRO 29:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 29:18"/>እዶ ሙልአትን ህንጅሬት ሰብን ገድ ዺሲ ተአ፤</para>
  <para style="q2" vid="PRO 29:18">ነምን ሴረ ኤጉ ገሩ ኤብፈማዸ።<verse eid="PRO 29:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 29:19"/>ገርብች ዱቢ አፋኒ ቆፋን ህንስሬፈሙ፤</para>
  <para style="q2" vid="PRO 29:19">እን ዮ ሁበቴሌ ዴቢ ህንኬኑቲ።<verse eid="PRO 29:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 29:20"/>አት ነመ ጀርጀርሱን ዱበቱ አርግቴ?</para>
  <para style="q2" vid="PRO 29:20">እሳረ ጎዋቱ አብዲ ጫሉ ቀበ።<verse eid="PRO 29:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 29:21"/>ነመ ገርብቸ ኦፊሳ <optbreak/> እጆሉማሳቲ ጀልቀቤ ቀነንሲሱ፣</para>
  <para style="q2" vid="PRO 29:21">ገልገልሳ ረክነ።<verse eid="PRO 29:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 29:22"/>ነምን ኣሩ ሎለ ከካሰ፤</para>
  <para style="q2" vid="PRO 29:22">ከን ደፌ ኣሩስ ጩቡ ሄዱ ሆጄተ።<verse eid="PRO 29:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 29:23"/>ኦፍ ቱሉማን ነማ እሱመ ገድ ዴብሰ፤</para>
  <para style="q2" vid="PRO 29:23">ነምን ሀፉራን ገድ ኦፍ ቀቡ ገሩ ኡልፍነ አርገተ።<verse eid="PRO 29:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 29:24"/>ነምን ሀቱ ወጅን ቆደቱ ሉቡ ኦፊሳ ጅበ፤</para>
  <para style="q2" vid="PRO 29:24">እን ንከከተ፤ ገሩ ዋን ቶኮሌ ህንህሙ።<verse eid="PRO 29:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 29:25"/>ነመ ሶዳቹን ክዮ ነመት ተአ፤</para>
  <para style="q2" vid="PRO 29:25">ከን <char style="nd">ዋቀዮን</char> አመነቱ ገሩ ነጋዻን ጅራተ።<verse eid="PRO 29:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 29:26"/>ነምን ሄዱን ቡልቻ ብረት ሱራ አርገቹ በርባደ፤</para>
  <para style="q2" vid="PRO 29:26">ሙርቲን ቀጄላን ገሩ <char style="nd">ዋቀዮ</char> ብራ ዹፈ።<verse eid="PRO 29:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 29:27"/>ቀጄላን ሶብዱ ጥሬፈተ፤</para>
  <para style="q2" vid="PRO 29:27">ሀማንሞ ነመ ቶላ ጅበ።<verse eid="PRO 29:27"/></para>
  <chapter eid="PRO 29"/>
  <chapter number="30" style="c" sid="PRO 30"/>
  <para style="ms1">ጄቸ አጉር</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1"/>ጄቸ አጉር እልመ ያቄ።</para>
  <para style="q1" vid="PRO 30:1">ዱቢን ነመ ከና አከነ ጄዼ ኢቲኤሊት ዱበተሜ፦</para>
  <para style="b" vid="PRO 30:1"/>
  <para style="q2" vid="PRO 30:1">“እንስ ኢቲኤሊቲፊ ኡካልት ዱበቴ፦<verse eid="PRO 30:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 30:2"/>አን ዹጉማን ዶፋ ነመ ሁንዳ ገዲት፤</para>
  <para style="q2" vid="PRO 30:2">አን ሁበትና ነምን ቀቡ ህንቀቡ።<verse eid="PRO 30:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 30:3"/>አን ኦጉማ ህንበረትኔ ዮካን ቤኩምሰ</para>
  <para style="q2" vid="PRO 30:3">እሰ ቁልቁሉ ሰና ህንቀቡ።<verse eid="PRO 30:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 30:4"/>ኤኙቱ ሰሚት ኦል በኤ ዴብኤ ዹፌ?</para>
  <para style="q2" vid="PRO 30:4">ከን ሀርክሳ ቡቤ ወልት ቀቤ ኤኙ?</para>
  <para style="q1" vid="PRO 30:4">ነምን ብሻን ኡፈታን መሬ ኤኙ?</para>
  <para style="q2" vid="PRO 30:4">ከን ዳሪ ለፋ ሁንደ ጀቤሴ ዻቤ ኤኙ?</para>
  <para style="q1" vid="PRO 30:4">መቃንሳቲፊ መቃን እልመሳ ኤኙ?</para>
  <para style="q2" vid="PRO 30:4">ሜ ዮ ቤክቴ ነት ህም!<verse eid="PRO 30:4"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 30:5"/>“ዱቢን ዋቃ ሁንድኑ ህርእነ ህንቀቡ፤</para>
  <para style="q2" vid="PRO 30:5">ወረ እሰት ኮሉ ገለኒፍ፣ እን ጋቸነ።<verse eid="PRO 30:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 30:6"/>ዱቢሳት ሆማ ህንደበልን፤</para>
  <para style="q2" vid="PRO 30:6">ዮ ከና አቺ እን ስ እፈተ፤ አትስ ሶብዱ ታቴ አርገምተ።<verse eid="PRO 30:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 30:7"/>“ያ <char style="nd">ዋቀዮ</char> አን ወንቶተ ለመ ስን ከዸዸ፤</para>
  <para style="q2" vid="PRO 30:7">እሳንስ ኡቱ ሀመን ጅሩት አነ ህንዾወትን።<verse eid="PRO 30:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 30:8"/>ጎዎምሳፊ ሶበ ነራ ፈጌስ፤</para>
  <para style="q2" vid="PRO 30:8">ህዩማ ዮካን ሶሩመ ናፍ ህንኬንን፤</para>
  <para style="q2" vid="PRO 30:8">ገሩ ቡዴነኮ ጉያ ጉያን ናፍ ኬን።<verse eid="PRO 30:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 30:9"/>ዮ ከና አቺ አን አከ መሌ ቁፌ ስ ገኔ</para>
  <para style="q2" vid="PRO 30:9">‘<char style="nd">ዋቀዮ</char> ኤኙዸ?’ ነንጄዸ፤</para>
  <para style="q1" vid="PRO 30:9">ዮካን ህዮሜ ሀቴ፣</para>
  <para style="q2" vid="PRO 30:9">አከሲን መቃ ዋቀኮ ነንሰልጵሰ።<verse eid="PRO 30:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 30:10"/>“ገርብቸ ቶኮ ጎፍታሳ ብረት ህንሀመትን፣</para>
  <para style="q2" vid="PRO 30:10">ዮ ከና አቺ እን ስ አባራ፤ አትስ ዋን ከነት ንጋፈተምተ።<verse eid="PRO 30:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 30:11"/>“ዸሎተ አባሳ አባሩ</para>
  <para style="q2" vid="PRO 30:11">ከን ሃዸሳሌ ህንኤብፍኔቱ ጅረ፤<verse eid="PRO 30:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 30:12"/>ዸሎተ ቁልቁሉ ኦፍ ሴኡ፣</para>
  <para style="q2" vid="PRO 30:12">ከን ጡሪሳራ ህንቁልቁሌፈምንቱ ጅሩ፤<verse eid="PRO 30:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 30:13"/>ዸሎተ እጅሳ አከ መሌ ኦፍ ቱሉ፣</para>
  <para style="q2" vid="PRO 30:13">ከን ባሌን እጀሳስ ነመ ቱፈቱቱ ጅረ፤<verse eid="PRO 30:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 30:14"/>ዸሎተ ህዬዪ ለፈራ ፍጡፍ</para>
  <para style="q2" vid="PRO 30:14">ረከቶተሌ ግዱ ነማቲ በሌሱፍ</para>
  <para style="q1" vid="PRO 30:14">እልካንሳ ጎራዴ፣</para>
  <para style="q2" vid="PRO 30:14">ሀኦንሳሞ ብላ ተኤ ጅረ።<verse eid="PRO 30:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 30:15"/>“ዹላንዹል እንተለን፣</para>
  <para style="q2" vid="PRO 30:15">‘ኬን! ኬን!’ ጄዸኒ እየን ለመ ቀብድ።</para>
  <para style="b" vid="PRO 30:15"/>
  <para style="li1" vid="PRO 30:15">“ወንቶተ ጎንኩማ ህንቁፍኔ ሰዲቱ ጅረ፤</para>
  <para style="li2" vid="PRO 30:15">ከኔን ጎንኩማ፣ ‘ኑ ገኤ!’ ህንጄኔሞ አፉርቱ ጅረ፦<verse eid="PRO 30:15"/></para>
  <para style="li3">
    <verse number="16" style="v" sid="PRO 30:16"/>እሳንስ ሲኦል፣</para>
  <para style="li3" vid="PRO 30:16">ገደሜሰ መሴኔ፣</para>
  <para style="li3" vid="PRO 30:16">ለፈ ጎንኩማ ብሻን ህንቁፍኔፊ</para>
  <para style="li3" vid="PRO 30:16">እብደ ጎንኩማ፣ ‘ነ ገኤ!’ ህንጄኔዸ።<verse eid="PRO 30:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 30:17"/>“እጀ አባት ቆሱ፣</para>
  <para style="q2" vid="PRO 30:17">ከን አጀጀ ሃዻ ቱፈቱ</para>
  <para style="q1" vid="PRO 30:17">አራጌሰ ሱሉላቲን ባፈመ፤</para>
  <para style="q2" vid="PRO 30:17">ጆብራንስ ንኛተመ።<verse eid="PRO 30:17"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="18" style="v" sid="PRO 30:18"/>“ወንቶትን አከ መሌ ነ ድንቅሲሰን ሰዲቱ ጅረ፤</para>
  <para style="li2" vid="PRO 30:18">አፉርሞ አን ህንሁበዹ፤ ኩንስ፦<verse eid="PRO 30:18"/></para>
  <para style="li3">
    <verse number="19" style="v" sid="PRO 30:19"/>ከራን ርሳ ሰሚረ፣</para>
  <para style="li3" vid="PRO 30:19">ከራን ቦፋ ከታረ፣</para>
  <para style="li3" vid="PRO 30:19">ከራን ዶኒ ገላነ ጉዳረ፣</para>
  <para style="li3" vid="PRO 30:19">ከራን ዺራሞ ዱበርቲ ወጅን ተኡሳት።<verse eid="PRO 30:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 30:20"/>“ከራን ኤጅቱ ከነ፦</para>
  <para style="q2" vid="PRO 30:20">እሼን ዋ ኛቴ አፋን ሀቀት፤</para>
  <para style="q2" vid="PRO 30:20">ኤርገሲሞ፣ ‘አን ሆማ ህንበሌስኔ’ ጄት።<verse eid="PRO 30:20"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="21" style="v" sid="PRO 30:21"/>“ለፍት ዋን ሰዲ ጀለት ሆለት፤</para>
  <para style="li2" vid="PRO 30:21">አፉርሞ ባቹ ህንደንዴሱ፤ ኩንስ፦<verse eid="PRO 30:21"/></para>
  <para style="li3">
    <verse number="22" style="v" sid="PRO 30:22"/>ገርብቸ ሞቲ ተኡ፣</para>
  <para style="li3" vid="PRO 30:22">ጎዋ ኛቴ ቁፉ፣<verse eid="PRO 30:22"/></para>
  <para style="li3">
    <verse number="23" style="v" sid="PRO 30:23"/>ዱበርቲን ጅበምቴ ዬሮ ዽርሰ አርገቱ፣</para>
  <para style="li3" vid="PRO 30:23">ገርብቲ ጊፍቲሼ ዻልቱ።<verse eid="PRO 30:23"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="24" style="v" sid="PRO 30:24"/>“ወንቶትን ጥጥኖን አፉር ለፈረ ጅሩ፤</para>
  <para style="li2" vid="PRO 30:24">ተኡሌ እሳን አከ መሌ ኦጌዪዸ፤ እሳንስ፦<verse eid="PRO 30:24"/></para>
  <para style="li2">
    <verse number="25" style="v" sid="PRO 30:25"/>ጎንዳወን ቱተ ጀብነ ህንቀብኔዸ፤</para>
  <para style="li3" vid="PRO 30:25">ተኡስ እሳን ዬሮ ቦና ኛተሳኒ ወልት ቀበን፤<verse eid="PRO 30:25"/></para>
  <para style="li2">
    <verse number="26" style="v" sid="PRO 30:26"/>ኦሶሌወን ኡመመወን ሁምነ ህንቀብኔዸ፤</para>
  <para style="li3" vid="PRO 30:26">ገሩ ከታ ኬሰ ጅራቱ፤<verse eid="PRO 30:26"/></para>
  <para style="li2">
    <verse number="27" style="v" sid="PRO 30:27"/>ሀዋንስን ሞቲ ህንቀቡ፤</para>
  <para style="li3" vid="PRO 30:27">ገሩ ተሬ ገሌ ያአ፤<verse eid="PRO 30:27"/></para>
  <para style="li2">
    <verse number="28" style="v" sid="PRO 30:28"/>ሎጩን ሀርካን ቀበሙ ደንዴስ፤</para>
  <para style="li3" vid="PRO 30:28">ገሩ መሰራ ሞቲ ኬሰት አርገምት።<verse eid="PRO 30:28"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="29" style="v" sid="PRO 30:29"/>“ወንቶተ ዴምሰ ቶለን ሰዲቱ ጅረ፤</para>
  <para style="li2" vid="PRO 30:29">ከኔን ተርካንፊ በሬደንስ አፉርቱ ጅረ፤ እሳንስ፦<verse eid="PRO 30:29"/></para>
  <para style="li3">
    <verse number="30" style="v" sid="PRO 30:30"/>ሌንጨ ብኔንሰ ሁንደ ኬሳ ጀባ፣ ከን ዋን ቶኮሌ ሶዳቴ ዱበት ህንዴብኔ፤<verse eid="PRO 30:30"/></para>
  <para style="li3">
    <verse number="31" style="v" sid="PRO 30:31"/>ኮርመ እንዳንቆ ከን ኮራ ዴሙ፣</para>
  <para style="li3" vid="PRO 30:31">ኮርቤሰ ሬኤቲፊ፣</para>
  <para style="li3" vid="PRO 30:31">ሞቲ ሎልቶተሳ ዱረ ዴሙ።<verse eid="PRO 30:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 30:32"/>“አት ዮ ኦፍ ጀጁዻን ጎዎምቴ፣</para>
  <para style="q2" vid="PRO 30:32">ዮካን ዮ ሀምነ መለቴ፣</para>
  <para style="q2" vid="PRO 30:32">ሀርከኬ አፋንኬረ ካአዹ!<verse eid="PRO 30:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 30:33"/>አኩመ ኣነን ራሱን ዸዻ ባሱ፣</para>
  <para style="q2" vid="PRO 30:33">ፉኛን ምጪሩንስ ዺገ ባሱ ሰነ፣</para>
  <para style="q2" vid="PRO 30:33">ኣሪ ከካሱን ሎለ ፍደ።”<verse eid="PRO 30:33"/></para>
  <chapter eid="PRO 30"/>
  <chapter number="31" style="c" sid="PRO 31"/>
  <para style="ms1">ጄቸ ልሙኤል ሞትቻ</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1"/>ጄቸ ሌሙኤል ሞትቻ ከን ሃትሳ እሰ በርሲፍቴ፦<verse eid="PRO 31:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 31:2"/>“ማል ያ እልመኮ፣ ማል ያ እልመ ገደሜሰኮ፣</para>
  <para style="q2" vid="PRO 31:2">ማል ያ እልመ ወሬገኮ፣<verse eid="PRO 31:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 31:3"/>ሁምነኬ ዱበርቶተረት፣</para>
  <para style="q2" vid="PRO 31:3">ጀብነኬ ወረ ሞቶተ በሌሰንረት ህንፍጥን።<verse eid="PRO 31:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 31:4"/>“ያ ሌሙኤል፣ ወን ኩን ሞቶታፍ ህንመሉ፤</para>
  <para style="q2" vid="PRO 31:4">ዳዺ ወይኒ ዹጉን ሞቶታፍ ህንመሉ፤</para>
  <para style="q2" vid="PRO 31:4">ዹጋቲ ጭማት ገገቡንስ ቡልችቶታፍ ህንመሉ፤<verse eid="PRO 31:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 31:5"/>ኩንስ አከ እሳን ዹገኒ ዋን ሴር ጄዹ ደገተኒ</para>
  <para style="q2" vid="PRO 31:5">ወረ ሀጩጨመን ሁንደ ምርገሳኒ ህንዾወኔፍ።<verse eid="PRO 31:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 31:6"/>ወረ በዱፍ ጅረኒፍ ዹጋቲ ጭማ፣</para>
  <para style="q2" vid="PRO 31:6">ወረ ጅሬኝ እት ሀዻኤፍ ዳዺ ወይኒ ኬን፤<verse eid="PRO 31:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 31:7"/>እሳን ዹገኒ ህዩማሳኒ ሃእራንፈተን፤</para>
  <para style="q2" vid="PRO 31:7">ረክነሳኒስ ዴብአኒ ህንያደትን።<verse eid="PRO 31:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 31:8"/>“ወረ ኦፊሳኒቲፍ ዱበቹ ህንደንዴኜፍ፣</para>
  <para style="q2" vid="PRO 31:8">ምርገ ወረ ገተመኒቲፍስ ፈልም።<verse eid="PRO 31:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 31:9"/>አፋንኬ በነዹ፤ ሙርቲ ቀጄላስ ኬን፤</para>
  <para style="q2" vid="PRO 31:9">ምርገ ህዬዪቲፊ ረከቶታቲፍ ፈልም።”<verse eid="PRO 31:9"/></para>
  <para style="ms1">ጡሙረ፦ ኒቲ አመለ ጋሪ ቀብዱ</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 31:10"/>ኒቲ አመለ ጋሪ ቀብዱ ኤኙቱ አርገቹ ደንደአ?</para>
  <para style="q2" vid="PRO 31:10">እሼን ሉለ ዲማ ጫላ ገት ቀቤቲዸ።<verse eid="PRO 31:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 31:11"/>ዽርስሼ ጉድሴ እሼ አመነተ፤</para>
  <para style="q2" vid="PRO 31:11">እን ዋን ፋይዳ ቀቡ ቶኮሌ ህንዸቡ።<verse eid="PRO 31:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 31:12"/>እሼን በረ ጅሬኘሼ ጉቱ</para>
  <para style="q2" vid="PRO 31:12">ዋን ጋሪ እሳፍ ፍድ መሌ እሰ ህንሚቱ።<verse eid="PRO 31:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 31:13"/>እሼን ሱፊፊ ቁንጬ ተልባ በርባዴ</para>
  <para style="q2" vid="PRO 31:13">ሀርከሼ ከን ሆጂ ጃለቱን ፎት።<verse eid="PRO 31:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 31:14"/>እሼን አኩመ ዶኒ ደልደላት</para>
  <para style="q2" vid="PRO 31:14">ለፈ ፈጎዻ ኛተሼ ፍደት።<verse eid="PRO 31:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 31:15"/>እሼን ኡቱ ለፍት ህንበርእን ህርባ ካቴ</para>
  <para style="q2" vid="PRO 31:15">ማቲ እሼቲፍ ኛተ ኬንት፤</para>
  <para style="q2" vid="PRO 31:15">ጦምቦሬወን እሼፍስ ሆጂ ቆድ።<verse eid="PRO 31:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 31:16"/>እሼን ለፈ ቆቲሳ ሁበቴ እላልቴ ብት፤</para>
  <para style="q2" vid="PRO 31:16">ዋን ሆጄቴ አርገቱ ኬሳ ወይኒ ዻብድ።<verse eid="PRO 31:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 31:17"/>እሼን ጀብናን ሙዺሼ ህዸቴ</para>
  <para style="q2" vid="PRO 31:17">ሆጂዻፍ እሬሼ ጀቤፈት።<verse eid="PRO 31:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 31:18"/>እሼን አከ ደልደልሼ ቡኣ ቀቡ ሁበት፤</para>
  <para style="q2" vid="PRO 31:18">እብሳንሼስ ሀልከኒን ህንዻሙ።<verse eid="PRO 31:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 31:19"/>ሙክን እት ጅርቢ መረን ሀርከሼ ኬሰ ጅረ፤</para>
  <para style="q2" vid="PRO 31:19">ቁበሼቲንሞ ጨሊ ቀበት።<verse eid="PRO 31:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 31:20"/>እሼን ህዬሳፍ ሀርከ ሂጠት፤</para>
  <para style="q2" vid="PRO 31:20">ዸባዻፍሌ ሀርከ በልእፍት።<verse eid="PRO 31:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 31:21"/>ዮ ጨቢን ቡኤሌ እሼን ማቲሼቲፍ ህንያዶፍቱ፤</para>
  <para style="q2" vid="PRO 31:21">እሳን ሁንድኑ ኡፈተ ብልዲማ ኡፈተኒሩቲ።<verse eid="PRO 31:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 31:22"/>እሼን ወያ ስሬ ዸአት፤</para>
  <para style="q2" vid="PRO 31:22">ኡፈተ ዺልጌ ቁንጬ ተልባ ሀጲራ <optbreak/> ሆጄተሜስ ኡፈት።<verse eid="PRO 31:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 31:23"/>ዽርስሼ ዮሙ ከረ መጋላ ዱረ፣</para>
  <para style="q2" vid="PRO 31:23">ጃርሶሊ ብያ ግዱ ታኡ ንከበጀመ።<verse eid="PRO 31:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 31:24"/>እሼን ወያ ቁንጬ ተልባ ዾፍቴ ጉርጉርት፤</para>
  <para style="q2" vid="PRO 31:24">ደልደልቶታፍስ ሰበተ ዽኤስት።<verse eid="PRO 31:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 31:25"/>እሼን ጀብናፊ ኡልፍነ ኡፈት፤</para>
  <para style="q2" vid="PRO 31:25">በረ ዹፋ ጅሩትስ ኮልፉ ደንዴስ።<verse eid="PRO 31:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 31:26"/>አፋንሼ ኦጉማዻን በነት፤</para>
  <para style="q2" vid="PRO 31:26">ጎርስ ገረ ላፍናስ አረበሼረ ጅረ።<verse eid="PRO 31:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 31:27"/>እሼን መነሼ ቶአት፤</para>
  <para style="q2" vid="PRO 31:27">እሼን ቡዴነ ዽባኡማስ ህንኛቱ።<verse eid="PRO 31:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 31:28"/>እጆሌንሼ ከአኒ፣ ኤብፈምቱ ጄዹን፤</para>
  <para style="q2" vid="PRO 31:28">ዽርስሼስ አከሱመ ጄዻን፤ አከነ ጄዼስ እሼ ጀጀ፦<verse eid="PRO 31:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 31:29"/>“ዱበርቶትን ሄዱን ዋን ጋሪ ሆጄቱ፤</para>
  <para style="q2" vid="PRO 31:29">አት ገሩ እሳን ሁንደ ጫልተ።”<verse eid="PRO 31:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 31:30"/>ስምቦን ነመ ጎዎምሰ፤ ሚዸግንስ ንደርበ፤</para>
  <para style="q2" vid="PRO 31:30">ዱበርቲን <char style="nd">ዋቀዮን</char> ሶዳቱ ገሩ ገለቴፈምቱዸ።<verse eid="PRO 31:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 31:31"/>ቡኣ ሀርከሼ ኬናፊ፤</para>
  <para style="q2" vid="PRO 31:31">ሆጂንሼ ከረ መጋላ ዱረት እሼ ሃጀጁ።<verse eid="PRO 31:31"/></para>
  <chapter eid="PRO 31"/>
</usx>
