<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PHP" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">ፊልጵስዩስ</para>
  <para style="toc1">ፊልጵስዩስ</para>
  <para style="toc2">ፊልጵስዩስ</para>
  <para style="toc3">ፊል</para>
  <para style="mt1">ፊልጵስዩስ</para>
  <chapter number="1" style="c" sid="PHP 1"/>
  <para style="s1">ነጋ ጋፈቹ</para>
  <para style="po">
    <verse number="1" style="v" sid="PHP 1:1"/>ጳዉሎሲፊ ጢሞቴዎስ ተጃጅልቶተ ክርስቶስ ዬሱስራ።</para>
  <para style="po" vid="PHP 1:1">ገረ ወረ ከራ ክርስቶስ ዬሱሲን ቁልቁሎተ ተአን ከኔን ጳጳሶታፊ ዳቆኖተ ወጅን ፊልጵስዩስ ኬሰ ጅራተን ሁንዳት።<verse eid="PHP 1:1"/></para>
  <para style="po">
    <verse number="2" style="v" sid="PHP 1:2"/>አባኬኘ ዋቃፊ ዬሱስ ክርስቶስ ጎፍታ ብራ አያኒፊ ነጋን እስኒፍ ሃተኡ።<verse eid="PHP 1:2"/></para>
  <para style="s1">ገለታፊ ከዸትና</para>
  <para style="p">
    <verse number="3" style="v" sid="PHP 1:3"/>አን ዬሮ እስን ያደዹ ሁንደ ዋቀኮ ነንገለቴፈዸ። <verse eid="PHP 1:3"/><verse number="4" style="v" sid="PHP 1:4"/>አን ከዸትና ሁንደኬሰኒፍ ከዸዹ ኬሰት ዬሮ ሁንደ ገመቹን ነንከዸዸ፤ <verse eid="PHP 1:4"/><verse number="5" style="v" sid="PHP 1:5"/>እስን ጉያ ጀልቀባቲ ሀመ አማት ወንጌለ ለለቡ ኬሰት ህርማተኒርቱቲ፤ <verse eid="PHP 1:5"/><verse number="6" style="v" sid="PHP 1:6"/>እን ሆጂ ጋሪ እስን ኬሰት ጀልቀቤ ሱን ሀመ ጉያ ክርስቶስ ዬሱስት አከ ራወቱ ነንአመነ።<verse eid="PHP 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PHP 1:7"/>ዋን እስን ገራኮ ኬሰ ጅርተኒፍ አን ዋኤ ሁንደኬሰኒ አከነት ያዱንኮ አናፍ ስሪዸ፤ ህዸሙኮ ኬሰትስ ተኡ ዮካን ወንጌላፍ ፈልሙኮቲፊ አከ ወንጌል ጭሜ ዻበቱ ጎቹኮ ኬሰት ሁንድኬሰን ነ ወጅን አያነ ዋቃ ኬሰት ህርማቱቲ። <verse eid="PHP 1:7"/><verse number="8" style="v" sid="PHP 1:8"/>አከ አን ጃለለ ክርስቶስ ዬሱሲን ሀመም ሁንደኬሰን ያዱ ዋቀዮ ዹገ ባቱኮት።<verse eid="PHP 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PHP 1:9"/>ከዸትናንኮ ከናዸ፦ ኩንስ አከ ጃለልኬሰን ቤኩምሳፊ ሁበትና ሁንዳን እቱመ ፉፌ ባይአቱ፣ <verse eid="PHP 1:9"/><verse number="10" style="v" sid="PHP 1:10"/>አከ እስን እሰ ዋን ሁንዱማ ጫሉ አዳን ባፍተኒ ቤኩ ደንዴሰኒፊ አከ እስን ሀመ ጉያ ክርስቶስትስ ቁልቁሎታፊ ወረ ሙዳ ህንቀብኔ ታተኒፍ፣ <verse eid="PHP 1:10"/><verse number="11" style="v" sid="PHP 1:11"/>አከ ኡልፍናፊ ገለተ ዋቃቲፍስ እጅ ቀጄልና ከን ከራ ዬሱስ ክርስቶሲን አርገሙን ጉተምተኒፍ።<verse eid="PHP 1:11"/></para>
  <para style="s1">ህዸሙን ጳዉሎስ ወንጌለ በበልእሴ</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 1:12"/>ያ ኦቦሎተ፣ ወንት ነረ ገኤ ኩን ዹጉማን ወንጌለ በበልእሱፍ ገርጋሩሳ አከ ቤክተን ነንበርባደ። <verse eid="PHP 1:12"/><verse number="13" style="v" sid="PHP 1:13"/>ከናንስ ክርስቶሲፍ ጄዼ ህዸሙንኮ ጉቱማ መሰራቲፊ ነሞተ ካን ሁንደ ብረት ቤከሜረ። <verse eid="PHP 1:13"/><verse number="14" style="v" sid="PHP 1:14"/>ሰበቢ አን ህዸሜፍስ ኦቦሎተ ኬሳ ገር ጫላን ጎፍታ አመነተኒ፣ ዱቢ ዋቃ ሶዳ መሌ ዱበቹፍ እጀ ጀብነ ጉዳ አርገተኒሩ።<verse eid="PHP 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 1:15"/>ነሞትን ቶኮ ቶኮ ዹጉማን ዌኖፊ ሞርኪዻን ክርስቶስን ለለቡ፤ ወር ካን ገሩ ያደ ጋሪዻን ለለቡ። <verse eid="PHP 1:15"/><verse number="16" style="v" sid="PHP 1:16"/>ወር ያደ ጋሪዻን ለለበን ኩኔን፣ አከ አን ወንጌላፍ ፈልሙፍ ጄዼ አስ ካአሜ ቤከኒ ጃለላን ለለቡ። <verse eid="PHP 1:16"/><verse number="17" style="v" sid="PHP 1:17"/>ወር ዌኖፊ ሞርኪዻን ለለበንሞ ኡቱ ገራ ቁልቁሉን ህንተእን፣ መነ ህዻ ኬሰት ረክነ ነት ጭምሱፍ ጄዸኒ ፌዺ ኦፍቱማቲን ክርስቶስን ለለቡ። <verse eid="PHP 1:17"/><verse number="18" style="v" sid="PHP 1:18"/>ዮስ ወን ኩን ማል ቀበሬ? ወን በርባችሳን ፈኬሱንስ ተኡ ዮካን ዹጋን ከራ ከምዩ ክርስቶስ ለለበሙሳት። ሰበቢ ከናፍ አን አከ መሌ ገመደ።</para>
  <para style="p" vid="PHP 1:18">ኤዬ አን እቱመ ፉፌ ነንገመደ፤ <verse eid="PHP 1:18"/><verse number="19" style="v" sid="PHP 1:19"/>አከ ወን ነረ ገኤ ኩን ከራ ከዸትናኬሰኒቲፊ ከራ ገርጋርሰ ሀፉረ ዬሱስ ክርስቶሲን ገረ ፉረማት ናፍ ጌደረሙ ነንቤካቲ። <verse eid="PHP 1:19"/><verse number="20" style="v" sid="PHP 1:20"/>አን አኩመ ዬሮ ካኒ አመስ ጅሬኛንስ ተኡ ዮካን ዱኣን እጀ ጀብናን ዱበቹንኮ አከ ክርስቶስ ዸግነኮ ኬሰት ኡልፍነ አርገቱፍ መሌ ከራ ከሚንዩ አከ ህንቃኖፍኔፍ ባይእሴ ነንሀወ፤ ነንአብደዸስ። <verse eid="PHP 1:20"/><verse number="21" style="v" sid="PHP 1:21"/>አናፍ ጅራቹን ክርስቶስ፤ ዱኡንስ ቡኣዸ። <verse eid="PHP 1:21"/><verse number="22" style="v" sid="PHP 1:22"/>አን ዮ ፎኒን ጅራዼ ኩን አናፍ ሆጂ ቡአ ቀቤሰ፤ ገሩ ማለን ፍለዸ? አን ህንቤኩ! <verse eid="PHP 1:22"/><verse number="23" style="v" sid="PHP 1:23"/>አን ያደ ከነ ለማን ግዱት ረረኤረ፤ አን ዴሜ ክርስቶስ ወጅን ጅራቹ ነንሀወ፤ ኩን ዋን ሁንደ ጫላቲ፤ <verse eid="PHP 1:23"/><verse number="24" style="v" sid="PHP 1:24"/>እስኒፍ ገሩ ፎኒን ቱሩንኮ ጫላ በርባችሳዸ። <verse eid="PHP 1:24"/><verse number="25" style="v" sid="PHP 1:25"/>አንስ ከነ አመነዼ አከ እስን አመንቲን ጉደተኒፊ አከ እስን ገመደኒፍ ሁንደኬሰን ብረ አከ ቱሩ፣ እስን ወጅንስ አከ ጅራዹን ቤከ። <verse eid="PHP 1:25"/><verse number="26" style="v" sid="PHP 1:26"/>ኩንስ አን አመስ እስን ብረት አርገሙኮቲን ኦፍ ጀጁን እስን ክርስቶስ ዬሱስት ቀብደን ሰበቢኮቲን አከ ባይአቱፍ።<verse eid="PHP 1:26"/></para>
  <para style="s1">ጅሬኘ ወንጌላፍ መሉ ጅራቹ</para>
  <para style="p">
    <verse number="27" style="v" sid="PHP 1:27"/>ዋን ፌዼዩ ተኡ አከ ወንጌለ ክርስቶሲፍ መሉት ጅራዻ። ዮስ አን ዹፌ እስን አርጉንስ ተኡ ዮካን ፈጎ ታኤ ዋኤኬሰን ዸገኡ ቆፋን፣ አከ እስን አመንቲ ወንጌላቲፍ ጄተኒ አኩመ ነመ ቶኮት ተታፈቹን ሀፉረ ቶኮን ጀባተኒ ዻበተን ነንቤከ። <verse eid="PHP 1:27"/><verse number="28" style="v" sid="PHP 1:28"/>እስን ዋኑመ ቶኮንሌ ሞርምቶተኬሰኒን ህንራፈምና። ኩን እሳኒፍ መለቶ በዲሳት፤ እስኒፍሞ መለቶ ፈይናት፤ ኩንስ ሆጂ ዋቃት። <verse eid="PHP 1:28"/><verse number="29" style="v" sid="PHP 1:29"/>እስን አከ ክርስቶስት አመንተን ቆፈ ኡቱ ህንተእን አከ እሳፍ ጄተኒ ዽጰተኒፍስ ኩን እሳፍ ጄቻ እስኒ ኬነሜራቲ፤ <verse eid="PHP 1:29"/><verse number="30" style="v" sid="PHP 1:30"/>ኩንስ ወልኣንሶ አን ኬሰ ቱሬ እሰ አርግተን ሰናፊ እሰ አን አመዩ ኬሰ ጅሩ ከን ዸጌሰን ከነ ኬሰ ደርቡት ዋን ጅርተኒፊዸ።<verse eid="PHP 1:30"/></para>
  <chapter eid="PHP 1"/>
  <chapter number="2" style="c" sid="PHP 2"/>
  <para style="s1">ገድ ኦፍ ቀቡ ክርስቶስ ዱካ ቡኡ</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 2:1"/>ከናፉ ጎርሰ ክርስቶሲን ቀብደን ከምዩ ታናን፣ ጃለላን ወል ጀጀቤሱ ከምዩ ታናን፣ ቶኩማ ሀፉራ ከምዩ ታናን፣ አራራፊ ገረ ላፍነ ከምዩ ታናን፣ <verse eid="PHP 2:1"/><verse number="2" style="v" sid="PHP 2:2"/>ገመቹኮ ናፍ ጉታ፤ ያዳን ቶኮ ተኣ፤ ጃለለ ቶኮ ቀባዻ፤ ሀፉራፊ ካዮን ቶኮ ተኣ። <verse eid="PHP 2:2"/><verse number="3" style="v" sid="PHP 2:3"/>እስን ገድ ኦፍ ቀቡዻን አከ ዋን ወር ካን እስን ጫለኒት እላላ መሌ ፌዺ ኦፍቱማቲን ዮካን ኦፍ ቱሉማቲን ዋኑመ ቶኮሌ ህንሆጄትና። <verse eid="PHP 2:3"/><verse number="4" style="v" sid="PHP 2:4"/>ቶኮን ቶኮንኬሰን ዋን ወረ ካኒፍስ ተኡ መሌ ዋን እስን ቆፋፍ ተኡ ህንእላልና።<verse eid="PHP 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PHP 2:5"/>ያድን ክርስቶስ ዬሱስ ኬሰ ቱሬ ሱን እስን ኬሰስ ሃጅራቱ።<verse eid="PHP 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PHP 2:6"/>እን ኡቱመ ብፈ ዋቃቲን ጅሩ፣</para>
  <para style="q2" vid="PHP 2:6">ወል ቅጡማ ዋቀ ወጅን ቀቡ አከ ዋን እራ ፉዸተሜት ህንለኮፍኔ።<verse eid="PHP 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PHP 2:7"/>ቆደ ከና እን ብፈ ገርባ ኡፈቴ</para>
  <para style="q2" vid="PHP 2:7">ፈካቲ ነማ ፉዸቹዻን ዱዋ ኦፍ ጎዼ።<verse eid="PHP 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PHP 2:8"/>ብፈ ነማ ኡፈቴ አርገሙዻንስ፣</para>
  <para style="q2" vid="PHP 2:8">ገድ ኦፍ ዴብሴ፤</para>
  <para style="q3" vid="PHP 2:8">ዱኣፍ ጄቹንስ ዱአ ፈኖ እራቲፍዩ ንአጀጀሜ!<verse eid="PHP 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PHP 2:9"/>ከናፉ ዋቅን አከ መሌ ኦል እሰ ቀቤ፤</para>
  <para style="q2" vid="PHP 2:9">መቃ መቃ ሁንደ ጫሉስ እሳፍ ኬኔ።<verse eid="PHP 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PHP 2:10"/>ኩንስ አከ ጅልብ ሁንድኑ ሰሚፊ ለፈረት፣</para>
  <para style="q2" vid="PHP 2:10">ለፈ ጀለትስ፣ መቃ ዬሱሲፍ ጅልቤንፈቱፍ።<verse eid="PHP 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PHP 2:11"/>አከ አረብን ሁንድኑስ <optbreak/> ኡልፍነ ዋቀ አባቲፍ ጄዼ</para>
  <para style="q2" vid="PHP 2:11">ዬሱስ ክርስቶስ ጎፍታ ተኡሳ ዹጋ በኡፍ።<verse eid="PHP 2:11"/></para>
  <para style="s1">ዋን ሁንደ ጉንጉሚ መሌ ሆጄቹ</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 2:12"/>ከናፉ ያ ጃለተሞ፣ አኩመ ዬሮ ሁንደ አጀጀምተን ሰነ፣ ዬሮ አን እስን ብረ ጅሩ ቆፈ ኡቱ ህንተእን አመ ዬሮ አን እስን ብረ ህንጅሬት ጫልችሳቲ ሶዳፊ ሆለትናን ፈይነኬሰን ፊጣን ባሱፍ እት ፉፋ፤ <verse eid="PHP 2:12"/><verse number="13" style="v" sid="PHP 2:13"/>አኩመ ካዮሳ ጋሪ ሰናት ፌዹፊ ሆጄቹ እስን ኬሰት ከን ራወቱ ዋቃቲ።<verse eid="PHP 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 2:14"/>ዋን ሁንደ ጉንጉሚፊ ፈልሚ መሌ ሆጄዻ፤ <verse eid="PHP 2:14"/><verse number="15" style="v" sid="PHP 2:15"/>ኩንስ አከ እስን ዸሎተ ምጪረማፊ ጀልኣ ከነ ግዱት አኩመ እፋ አዱኛ ኬሰት እብስተኒፍ፣ አከ ወረ ሙዳ ህንቀብኔፊ ቁልቁላኦ፣ እጆሌ ዋቃ ወረ የከ ህንቀብኔስ ታተኒፍ፣ <verse eid="PHP 2:15"/><verse number="16" style="v" sid="PHP 2:16"/>ዮ እስን ዱቢ ጅሬኛ ጀቤስተኒ ቀበተን አን አከሱማን አከ ህንፊግን ዮካን አከሱማን አከ ህንደዸብን ጉያ ክርስቶስት ኦፍ ጀጁ ነንደንደአ። <verse eid="PHP 2:16"/><verse number="17" style="v" sid="PHP 2:17"/>አን ኡቱ ኣርሳፊ ተጃጅለ አመንቲኬሰኒረት አከ ዽባዩት ዸንገላፈሜዩ ነንገመደ፤ ሁንደኬሰን ወጅንስ ነንገመደ። <verse eid="PHP 2:17"/><verse number="18" style="v" sid="PHP 2:18"/>ከናፉ እስንስ ነ ወጅን ገመዱፊ እልልቹ ቀብዱ።<verse eid="PHP 2:18"/></para>
  <para style="s1">ጢሞቴዎሲፊ አፍሮዲጡ</para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 2:19"/>አን ኦዱ ዋኤኬሰኒ ዸገኤ ገመዱፍ፣ አከ አን ደፌ ጢሞቴዎስን ገረኬሰንት ኤርጉ ደንደኡ ጎፍታ ዬሱስን ነንአብደዸ። <verse eid="PHP 2:19"/><verse number="20" style="v" sid="PHP 2:20"/>አን ነመ ብራ ከን አከሳ ዋኤኬሰን ገራ ቁልቁሉን ያዱ ቶኮሌ ህንቀቡ። <verse eid="PHP 2:20"/><verse number="21" style="v" sid="PHP 2:21"/>ሰበቢንሳስ ወር ካን ሁንድ ኡቱ ፌዺ ዬሱስ ክርስቶሲፍ ህንተእን ፌዺ መታሳኒቲፍ ያዱቲ። <verse eid="PHP 2:21"/><verse number="22" style="v" sid="PHP 2:22"/>ጢሞቴዎስ ገሩ አኩመ እልም አባሳ ተጃጅሉት ሆጂ ወንጌላ ኬሰት ነ ወጅን ተጃጅሉሳ አከ ኦፍ ምርከኔሴ እስኑ ቤክቱ። <verse eid="PHP 2:22"/><verse number="23" style="v" sid="PHP 2:23"/>ከናፍ አን አኩመ ሃለኮ ሁበዼን እሰ ኤርጉፍ ነንአብደዸ። <verse eid="PHP 2:23"/><verse number="24" style="v" sid="PHP 2:24"/>አን መታንኮዩ ደፌ ዹፉፍ ጎፍታ ነንአመነዸ።<verse eid="PHP 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PHP 2:25"/>አን ገሩ ኦቦሌሰኮ ኤጰፍሮዲጡ ሆጄታ ህዸተኮ ተኤፊ ሎልቱ ህዸተኮ ተኤ፣ ኤርገማኬሰን ከን እስን አከ እን ዋን ነ በርባችሱን ነ ተጃጅሉፍ ኤርግተን ሰነ ዴብሴ ገረኬሰን ኤርጉን በርባችሳ ነት ፈካተ። <verse eid="PHP 2:25"/><verse number="26" style="v" sid="PHP 2:26"/>እን ሁንደኬሰን ያዳቲ፤ እስን አከ እን ዹኩብሰቴ ቱሬ ዋን ዸጌሰኒፍስ ዽጰቻ ጅረ። <verse eid="PHP 2:26"/><verse number="27" style="v" sid="PHP 2:27"/>እን ዹጉማን ዹኩብሰቴ ዱኡ ገኤ ቱሬ። ዋቅን ገሩ እሰ ማሬረ፤ ኡቱ እሰ ቆፈ ህንተእን አከ ገድ ገደረት ነት ህንደበለምኔፍ አነስ በራሬረ። <verse eid="PHP 2:27"/><verse number="28" style="v" sid="PHP 2:28"/>ከናፉ እስን አከ ዮሙ ለመተ እሰ አርግተንት ገመደኒፊ አከ ያዶንኮስ ናፍ ሰልጰቱፍ ደፌ ገረኬሰንት እሰ ኤርጉ ጉዳ ነንሀወ። <verse eid="PHP 2:28"/><verse number="29" style="v" sid="PHP 2:29"/>እስንስ ጎፍታዻን ገመቹ ጉዳን እሰ ስመዻ፤ ነሞተ አከሲስ ከበጃ፤ <verse eid="PHP 2:29"/><verse number="30" style="v" sid="PHP 2:30"/>እን ገርጋርሰ እስን ናፍ ኬኑ ህንደንደእን ናፍ ኬኑፍ፣ ጅሬኘሳሌ ደበርሴ ኬኑን፣ ሆጂ ክርስቶሲፍ ጄዼ ዱኡዩ ገኤ ቱሬቲ።<verse eid="PHP 2:30"/></para>
  <chapter eid="PHP 2"/>
  <chapter number="3" style="c" sid="PHP 3"/>
  <para style="s1">ፎን አመነቹ ዺሱ</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 3:1"/>ዹመረትስ ያ ኦቦሎተኮ፣ ጎፍታት ገመዳ! አን ዋኑመ ከናን ዱራረ ዴብኤ እስኒ በሬሱን ነ ህንዽቡ፤ ኩን እስኒፍ ኤጉምሰ። <verse eid="PHP 3:1"/><verse number="2" style="v" sid="PHP 3:2"/>ሰሮተራ ኦፍ ኤገዻ፤ ነሞተ ሀምነ ሆጄተንራ ኦፍ ኤገዻ፤ ዸግነ ቀባ ሶባራስ ኦፍ ኤገዻ። <verse eid="PHP 3:2"/><verse number="3" style="v" sid="PHP 3:3"/>ሰበቢንሳ ኑ ወር ሀፉረ ዋቃቲን ዋቄፈትኑ፣ ወር ክርስቶስ ዬሱሲን ኦፍ ጀጅኑፊ ወር ፎን ህንአመነኔ ዸግነ ቀበትኔራቲ፤ <verse eid="PHP 3:3"/><verse number="4" style="v" sid="PHP 3:4"/>ተኡስ አን መታንኮ አመነቹ አከናቲፍ ሰበቢ ቀበ።</para>
  <para style="p" vid="PHP 3:4">ነምን ብራ ከምዩ ፎን አመነቹፍ ዋን ሰበቢ ቀቡ ዮ ኦፍ ሴኤ፣ አንሞ እሰ ጫላ ቀበ፦ <verse eid="PHP 3:4"/><verse number="5" style="v" sid="PHP 3:5"/>አን ዸለዼ ጉያ ሰዴተፋን ዸግነ ቀበዼ፤ ሰኚ እስራኤል ኬሳስ ጎሰ ቤንያምራ ዸለዼ፤ ወረ እብሮታ ኬሳስ እብርቸ ቶኮዸ፤ አከ ሴራትስ አን ፈሪሶተ ኬሳ ቶኮዸ፤ <verse eid="PHP 3:5"/><verse number="6" style="v" sid="PHP 3:6"/>ዋኤ ህናፋ፣ አን ወልዳ ክርስታና አርአቻን ቱሬ፤ ዋኤ ቀጄሉማ ሴረ ኤጉን አርገሙስ አን ሙዳ ህንቀቡ ቱሬ።<verse eid="PHP 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PHP 3:7"/>ገሩ ዋን ነ ፈየዳ ቱሬ አመ ክርስቶሲፍ ጄዼ አከ ዋን ገቲ ህንቀብኔት ነንእላለ። <verse eid="PHP 3:7"/><verse number="8" style="v" sid="PHP 3:8"/>ዹጉማኑ ሰበቢ ጎፍታኮ ክርስቶስ ዬሱስ እሰ ዋን ሁንዱማ ጫሉ ሰነ ቤኩቲፍ አን ዋን ሁንዱማ አከ ዋን ገቲ ህንቀብኔት ነንእላለ። አን እሳፍ ጄዼ ዋን ሁንዱማ ዸቤረ፤ ክርስቶስን አርገቹፍስ ዋን ሁንዱማ አከ ኮሲት ነንእላለ፤ <verse eid="PHP 3:8"/><verse number="9" style="v" sid="PHP 3:9"/>ኩንስ ቀጄሉማ መታኮ ከን ሴረ ኤጉን አርገሙ ኡቱ ህንተእን ቀጄሉማ ክርስቶስት አመኑን አርገሙ ጄቹንስ አከ አን ቀጄሉማ ዋቀ ብራ አመንቲዻን ዹፉ ቀባዼ እሰ ኬሰ ጅራዹፍ። <verse eid="PHP 3:9"/><verse number="10" style="v" sid="PHP 3:10"/>አን ክርስቶሲፊ ሁምነ ዱኣ ከኡሳ ቤኩ፣ ዽጵነሳ ኬሰት ህርማቹፊ ዱአሳቲንስ እሰ ፈካቹ ነንበርባደ፤ <verse eid="PHP 3:10"/><verse number="11" style="v" sid="PHP 3:11"/>አከሲንስ አን ዱኣ ከኡ ወረ ዱአኒ አርገቹ ነንደንደአ።<verse eid="PHP 3:11"/></para>
  <para style="s1">እዶ ያደሜ ገኡፍ ፊጉ</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 3:12"/>ክርስቶስ ዬሱስ ዋን ከን ኦፊሳ ነ ጎዸቴፍ አንስ ዋን ከነ ሀርከት ገልፈቹፍ ነንፊገ ጄቹዸ መሌ ዋን ከነ ሁንደ አርገዼረ ዮካን ነመ ህርእነ ህንቀብኔ ተኤረ ጄቹ ምት። <verse eid="PHP 3:12"/><verse number="13" style="v" sid="PHP 3:13"/>ያ ኦቦሎተ፣ አን አከ ዋን ሀርከት እሰ ገልፈዼት ህንእላሉ። ዋን ቶኮ ገሩ ነንጎዸ፦ ዋን ነ ዱበ ጅሩ እራንፈዼ ገረ ዋን ፉለኮ ዱረ ጅሩት ነንሂጠዸ፤ <verse eid="PHP 3:13"/><verse number="14" style="v" sid="PHP 3:14"/>በዻሰ ዋቅን ክርስቶስ ዬሱሲን ኦል ሰሚት እት ነ ዋሜ ሰነ አርገቹፍ ገረ ካዮ ሰናት ነንፊገ።<verse eid="PHP 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 3:15"/>ኑ ወር ብልቻቶን ሁንድኑ ዋን አከና ሃያድኑ። ዮ ዋን ቶኮ ቶኮረት ያደ ገራ ገራ ቀባተን ገሩ ከነስ ዋቅን እስኒ እብሰ። <verse eid="PHP 3:15"/><verse number="16" style="v" sid="PHP 3:16"/>ተኡስ ዋኑመ ከናን ዱረ እረ ጌኜ ሰናን ሃጅራትኑ።<verse eid="PHP 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 3:17"/>ያ ኦቦሎተ፣ ፈኬኘኮ ዱካ ቡኡዻን ወረ ካኒን ቶኮ ተኣ፤ ወረ ፈኬኘ ኑ እስኒ ኬንኔን ጅራተንስ ሁበዻ። <verse eid="PHP 3:17"/><verse number="18" style="v" sid="PHP 3:18"/>አኩመ አን ዬሮ ሄዱ እስንት ህሜፊ አኩመ አን አመሌ እምማኒንዩ እስንት ህሙ፣ ነሞትን ባይኤን ዲኖተ ፈኖ ክርስቶስ ተአኒ ጅራቱቲ። <verse eid="PHP 3:18"/><verse number="19" style="v" sid="PHP 3:19"/>ዹምንሳኒ በዲሰ፤ ዋቅንሳኒ ገራሳኒት፤ ኡልፍንሳኒ ሰልጵነሳኒቲን። ያድንሳኒስ ዋኑመ ለፋረት ሁንዴፈመ። <verse eid="PHP 3:19"/><verse number="20" style="v" sid="PHP 3:20"/>ኑ ገሩ ብይኬኘ ሰሚረ። ፈይሳ አቺ ዹፉ፣ ጎፍታ ዬሱስ ክርስቶስ ኤገትነ፤ <verse eid="PHP 3:20"/><verse number="21" style="v" sid="PHP 3:21"/>እንስ ሁምነ ዋን ሁንደ ኦፍ ጀለ ገልፈቹ እሰ ደንዴስሱ ሰናን አከ ዸግንኬኘ እን ደዸባን ዸግነሳ ኡልፍነ ቀቤሰ ሰነ ፈካቱፍ ዸግነኬኘ ንጌደረ።<verse eid="PHP 3:21"/></para>
  <chapter eid="PHP 3"/>
  <chapter number="4" style="c" sid="PHP 4"/>
  <para style="s1">ጀባተኒ ጅራቹፊ ቶኩማ</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 4:1"/>ከናፉ ያ ኦቦሎተኮ፣ እስን ወር አን ጃለዹፊ ወር አን ያዱ፣ ወር ገመቹኮቲፊ ጎንፎኮስ ታተን፣ ያ ምቾተኮ አከነት ጎፍታት ጀባዻ ዻበዻ!<verse eid="PHP 4:1"/></para>
  <para style="s1">ጎርሰ</para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 4:2"/>አን አከ እሳን ጎፍታዻን ያደ ቶኮ ቀባተኒፍ ኤዎድያንን ነንከዸዸ፤ ስንጤኪኒንስ ነንከዸዸ። <verse eid="PHP 4:2"/><verse number="3" style="v" sid="PHP 4:3"/>ያ ህዸተ ዹጋ፣ ዱበርቶትን ኩኔን ቀሌምንጦሲፊ ወረ ነ ወጅን ሆጄተን ከኔን መቃንሳኒ ክታበ ጅሬኛ ኬሰት በሬፈሜ ካን ወጅን ዋን ሆጂ ወንጌላ ኬሰት ነ ወጅን ደዸበኒፍ አከ አት እሳን ገርጋርቱፍ ስን ከዸዸ።<verse eid="PHP 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PHP 4:4"/>እስን ዬሮ ሁንደ ጎፍታት ገመዳ። አመስ አን እረ ዴብኤ ነንጄዸ፣ ገመዳ! <verse eid="PHP 4:4"/><verse number="5" style="v" sid="PHP 4:5"/>ገራሙማንኬሰን ነመ ሁንዱማ ብረት ሃቤከሙ። ጎፍታን ዽኦ ጅረ። <verse eid="PHP 4:5"/><verse number="6" style="v" sid="PHP 4:6"/>ዋን ሁንዱማ ኬሰት ዋቀ ከዸቹፊ ዋመታን፣ ገለተ ወጅንስ ጋፊኬሰን ዋቀት ዽኤፈዻ መሌ ዋን ቶኮሌ ህንያደእና። <verse eid="PHP 4:6"/><verse number="7" style="v" sid="PHP 4:7"/>ነጋን ዋቃ ከን ሁበትና ሁንዳ ኦል ተኤ ሱን ከራ ክርስቶስ ዬሱሲን ቀልቢፊ ያደኬሰን ንኤገ።<verse eid="PHP 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PHP 4:8"/>ዹመረትስ ያ ኦቦሎተ፣ ወን ዹጋ ተኤ ከምዩ፣ ወን ኡልፍነ ቀቤሰ ተኤ ከምዩ፣ ወን ቀጄላ ተኤ ከምዩ፣ ወን ቁልቁሉ ተኤ ከምዩ፣ ወን ጃለተማ ተኤ ከምዩ፣ ወን ጉረ ነማት ቶሉ ከምዩ፣ ወን ጋሪ ተኤ ዮካን ገለቴፈማ ተኤ ከምዩ ዮ ጅራቴ እስን ዋን አከና ያዳ። <verse eid="PHP 4:8"/><verse number="9" style="v" sid="PHP 4:9"/>እስን ዋን ነራ በረተን ዮካን ነራ አርገተን ዮካን ነራ ዸጌሰን ዮካን ነረት አርግተን ሁንደ እስንስ አከሱመ ጎዻ። ዋቅን ነጋ እስን ወጅን ንተአ።<verse eid="PHP 4:9"/></para>
  <para style="s1">ኬና እሳኒቲፍ ገለቴፈቹሳ</para>
  <para style="p">
    <verse number="10" style="v" sid="PHP 4:10"/>ሰበቢ እስን ዹመረት ዴብተኒ ናፍ ያዱ ጀልቀብደኒፍ አን ጎፍታት ባይኤ ነንገመደ። ዹጉማኑ ጨራ እቲን አርግሲፍተን ዸብደኒት መሌ እስን ዱሩማኑ ናፍ ያዳ ቱርተን። <verse eid="PHP 4:10"/><verse number="11" style="v" sid="PHP 4:11"/>አን ዋን ዋ ዸቤፍ አከነ ጄቻ ህንጅሩ፤ ሃለ ከምዩ ኬሰት ነ ገአ ጄቹ በረዼራቲ። <verse eid="PHP 4:11"/><verse number="12" style="v" sid="PHP 4:12"/>አን ዸቡን ማል አከ ተኤ ቤከ፤ ባይኤ ቀባቹንስ ማል አከ ተኤ ነንቤከ። ሃለ ከምዩ ኬሰት፣ ዋን ሁንደ ኬሰትስ እጪቲ ቁፉቲፊ ቤለኡ፣ ባይኤ ቀባቹቲፊ ዸቡ በረዼረ። <verse eid="PHP 4:12"/><verse number="13" style="v" sid="PHP 4:13"/>አን እሰ ሁምነ ናፍ ኬኑ ሰናን ዋን ሁንደ ጎቹ ነንደንደአ።<verse eid="PHP 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 4:14"/>ሃተኡ መሌ ረክነኮ ኬሰት ህርማቹንኬሰን ዋን ጋሪ ጎቹኬሰን ቱሬ። <verse eid="PHP 4:14"/><verse number="15" style="v" sid="PHP 4:15"/>ከነ መሌስ እስን ወር ፊልጵስዩስ አኩመ ቤክተን፣ ጀልቀበት ዬሮ አን ወንጌለ እስንት ለለቤት፣ ዬሮ አን መቄዶንያዻ ከኤት እስን ቆፈ መሌ ወልዳን ክርስታና ቶኮዩ ዋኤ ኬኑፊ ፉዸቹ ኬሰት ነ ወጅን ህንህርማትኔ። <verse eid="PHP 4:15"/><verse number="16" style="v" sid="PHP 4:16"/>ዬሮ አን ተሰሎኒቄ ቱሬትሌ ዮሙ አን ረከዼት እስን ዬሮ ቶኮ ኦል ገርጋርሰ ናፍ ኤርግተኒቱቲ። <verse eid="PHP 4:16"/><verse number="17" style="v" sid="PHP 4:17"/>ኩንስ አከ ቡኣን እስኒፍ ባይአቱ በርባዴን መሌ አን ኬናኬሰን በርባዴ ምት። <verse eid="PHP 4:17"/><verse number="18" style="v" sid="PHP 4:18"/>አን ከፈልቲ ጉቱ አርገዼ ጫላዩ ቀባዼረ፤ ኬና እስን ኤርግተንስ ኤጰፍሮዲጡ ሀርካ ፉዸዼ ሀመ ነ ገኡ አርገዼረ። ኩንስ ኬና ኡርጋኣፊ ቀልመ ፉዸተማ ዋቀ ገመቺሱዸ። <verse eid="PHP 4:18"/><verse number="19" style="v" sid="PHP 4:19"/>ዋቅንኮስ አኩመ በዻዹማሳ ኡልፍነ ቀቤሰ ሰናት ዋን እስን በርባችሱ ሁንደ ክርስቶስ ዬሱሲን እስኒፍ ጉተ።<verse eid="PHP 4:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="PHP 4:20"/>ዋቀኬኛፊ አባኬኛፍ በረ በራ ሀመ በረ በራት ኡልፍን ሃተኡ። አሜን።<verse eid="PHP 4:20"/></para>
  <para style="b"/>
  <para style="s1">ዻምሰ ነጋ ጡሙራ</para>
  <para style="p">
    <verse number="21" style="v" sid="PHP 4:21"/>ክርስቶስ ዬሱሲን ቁልቁሎተ ሁንደት ነጋ ናፍ ህማ።</para>
  <para style="p" vid="PHP 4:21">ኦቦሎትን ነ ወጅን ጅረንስ ነጋ እስኒ ዻሙ።<verse eid="PHP 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PHP 4:22"/>ቁልቁሎትን ሁንድኑ፣ ኬሱመቱ ወር መነ ቄሳር ጅራተን ነጋ እስኒ ዻሙ።<verse eid="PHP 4:22"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="23" style="v" sid="PHP 4:23"/>አያን ጎፍታኬኘ ዬሱስ ክርስቶስ ሀፉረኬሰን ወጅን ሃተኡ። አሜን።<verse eid="PHP 4:23"/></para>
  <chapter eid="PHP 4"/>
</usx>
