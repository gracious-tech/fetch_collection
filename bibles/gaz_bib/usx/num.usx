<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="NUM" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">ለኮብሰ</para>
  <para style="toc1">ሴረ ለኮብሳ</para>
  <para style="toc2">ለኮብሰ</para>
  <para style="toc3">ለኮ</para>
  <para style="mt2">ሴረ</para>
  <para style="mt1">ለኮብሳ</para>
  <chapter number="1" style="c" sid="NUM 1"/>
  <para style="s1">ለኮብሰ ሰባ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 1:1"/>ኤርገ ሰብን እስራኤል ብየ ግብጢቲ በኤ ቦዴ ወጋ ለመፋ ኬሳ፣ ጉያ ጀልቀበ ጅአ ለመፋት <char style="nd">ዋቀዮ</char> ዱንካነ ወል ገኢ ኬሰት፣ ገሞጂ ሲና ኬሰት ሙሴት ዱበቴ። እንስ አከነ ጄዼን፤ <verse eid="NUM 1:1"/><verse number="2" style="v" sid="NUM 1:2"/>“ወልዳ ሰበ እስራኤል ሁንደ ለካኣቲ በልበለ በልበላኒፊ ማቲ ማቲዻን መቃ ዺሮታ ቶኮ ቶኮን በሬሳ። <verse eid="NUM 1:2"/><verse number="3" style="v" sid="NUM 1:3"/>ነሞተ እስራኤል ኬሳ ዺሮተ ኡሙሪንሳኒ ወጋ ድግደማቲፊ ሀመሲ ኦሊ ከኔን ሎለ ዸቁ ደንደአን ሁንደ አቲፊ አሮን ኩታ ኩታ እሳኒቲን ለካኣ። <verse eid="NUM 1:3"/><verse number="4" style="v" sid="NUM 1:4"/>ቶኮ ቶኮ ጎሳ ኬሳ ነምን ሀንገፈ ማቲ ኦፊሳ ተኤ እስን ገርጋሩ ቀበ።<verse eid="NUM 1:4"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="5" style="v" sid="NUM 1:5"/>“መቃን ነሞተ እስን ገርጋሩ ቀበኒ ከኔኒዸ፦</para>
  <para style="b" vid="NUM 1:5"/>
  <para style="li1" vid="NUM 1:5">“ጎሰ ሩቤን ኬሳ ኤሊዙር እልመ ሼዴኡር፤<verse eid="NUM 1:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="NUM 1:6"/>ጎሰ ስምኦን ኬሳ ሽሉሚኤል እልመ ዙሪሸዳይ፤<verse eid="NUM 1:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="NUM 1:7"/>ጎሰ ይሁዳ ኬሳ ነህሾን እልመ አሚናዳብ፤<verse eid="NUM 1:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="NUM 1:8"/>ጎሰ ይሳኮር ኬሳ ናትናኤል እልመ ዙዋር፤<verse eid="NUM 1:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="NUM 1:9"/>ጎሰ ዜቡሎን ኬሳ ኤሊያብ እልመ ሄሎን፤<verse eid="NUM 1:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="NUM 1:10"/>እልማን ዮሴፍ ኬሳ፦</para>
  <para style="li2" vid="NUM 1:10">ጎሰ ኤፍሬም ኬሳ ኤሊሻማ እልመ አሚሁድ፤</para>
  <para style="li2" vid="NUM 1:10">ጎሰ ምናሴ ኬሳ ገማልኤል እልመ ጴዳሱር፤<verse eid="NUM 1:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="NUM 1:11"/>ጎሰ ቤንያም ኬሳ አቢዳን እልመ ጋዴዮን፣<verse eid="NUM 1:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="NUM 1:12"/>ጎሰ ዳን ኬሳ አሂኤዜር እልመ አሚሸዳይ፤<verse eid="NUM 1:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="NUM 1:13"/>ጎሰ ኣሼር ኬሳ ፈግኤል እልመ ኦክራን፤<verse eid="NUM 1:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="NUM 1:14"/>ጎሰ ጋድ ኬሳ ኤልያሳፍ እልመ ዴኡኤል፤<verse eid="NUM 1:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="NUM 1:15"/>ጎሰ ንፍታሌም ኬሳ አሂራ እልመ ኤናን።”<verse eid="NUM 1:15"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="16" style="v" sid="NUM 1:16"/>ነሞትን ኩኔን ወረ ዱረ ቡኦተ ጎሶተ አቦቲሳኒ ተአኒ ወልዳ ሰነ ኬሳ ፍለተመኒዸ። እሳንስ ሀንገፎተ በልበለወን እስራኤል ቱረን።<verse eid="NUM 1:16"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="17" style="v" sid="NUM 1:17"/>ሙሴፊ አሮን ነሞተ መቃንሳኒ ኤረሜ ከኔን ፉዸተኒ፣ <verse eid="NUM 1:17"/><verse number="18" style="v" sid="NUM 1:18"/>ጉያ ጀልቀበ ጅአ ለመፋት ወልዳ ሁንደ ወልት ዋመን። ነሞትን ሱንስ አኩመ በልበላፊ ማቲሳኒት ህደ ዸሎተሳኒ ህመተን፤ ዺሮትን ኡሙሪንሳኒ ወጋ ድግደማቲፊ ሀመሲ ኦሊ መቃንሳኒ ቶኮ ቶኮን ገልሜፈሜ፤ <verse eid="NUM 1:18"/><verse number="19" style="v" sid="NUM 1:19"/>እንስ አኩመ <char style="nd">ዋቀዮ</char> ሙሴ አጀጄት ገሞጂ ሲና ኬሰት ሰበ ሰነ ለካኤ።<verse eid="NUM 1:19"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="20" style="v" sid="NUM 1:20"/>ሰኚ ሩቤን እልመ እስራኤል ሀንገፍትቻ ኬሳ፦</para>
  <para style="li2" vid="NUM 1:20">ዺሮትን ኡሙሪንሳኒ ወጋ ድግደማቲፊ ሀመሲ ኦሊ ከኔን ሎለ ዸቁ ደንደአን ሁንድኑ አኩመ ገልሜ በልበላፊ ማቲሳኒት ቶኮ ቶኮን መቃ መቃዻን በሬፈመን። <verse eid="NUM 1:20"/><verse number="21" style="v" sid="NUM 1:21"/>ባይእን ጎሰ ሩቤን ነመ 46,500 ቱሬ።<verse eid="NUM 1:21"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="22" style="v" sid="NUM 1:22"/>ሰኚ ስምኦን ኬሳ፦</para>
  <para style="li2" vid="NUM 1:22">ዺሮትን ኡሙሪንሳኒ ወጋ ድግደማቲፊ ሀመሲ ኦሊ ከኔን ሎለ ዸቁ ደንደአን ሁንድኑ አኩመ ገልሜ በልበላፊ ማቲሳኒት ቶኮ ቶኮን መቃ መቃዻን በሬፈመን። <verse eid="NUM 1:22"/><verse number="23" style="v" sid="NUM 1:23"/>ባይእን ጎሰ ስምኦን ነመ 59,300 ቱሬ።<verse eid="NUM 1:23"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="24" style="v" sid="NUM 1:24"/>ሰኚ ጋድ ኬሳ፦</para>
  <para style="li2" vid="NUM 1:24">ዺሮትን ኡሙሪንሳኒ ወጋ ድግደማቲፊ ሀመሲ ኦሊ ከኔን ሎለ ዸቁ ደንደአን ሁንድኑ አኩመ ገልሜ በልበላፊ ማቲሳኒት መቃ መቃዻን በሬፈመን። <verse eid="NUM 1:24"/><verse number="25" style="v" sid="NUM 1:25"/>ባይእን ጎሰ ጋድ ነመ 45,650 ቱሬ።<verse eid="NUM 1:25"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="26" style="v" sid="NUM 1:26"/>ሰኚ ይሁዳ ኬሳ፦</para>
  <para style="li2" vid="NUM 1:26">ዺሮትን ኡሙሪንሳኒ ወጋ ድግደማቲፊ ሀመሲ ኦሊ ከኔን ሎለ ዸቁ ደንደአን ሁንድኑ አኩመ ገልሜ በልበላፊ ማቲሳኒት መቃ መቃዻን በሬፈመን። <verse eid="NUM 1:26"/><verse number="27" style="v" sid="NUM 1:27"/>ባይእን ጎሰ ይሁዳ ነመ 74,600 ቱሬ።<verse eid="NUM 1:27"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="28" style="v" sid="NUM 1:28"/>ሰኚ ይሳኮር ኬሳ፦</para>
  <para style="li2" vid="NUM 1:28">ዺሮትን ኡሙሪንሳኒ ወጋ ድግደማቲፊ ሀመሲ ኦሊ ከኔን ሎለ ዸቁ ደንደአን ሁንድኑ አኩመ ገልሜ በልበላፊ ማቲሳኒት መቃ መቃዻን በሬፈመን። <verse eid="NUM 1:28"/><verse number="29" style="v" sid="NUM 1:29"/>ባይእን ጎሰ ይሳኮር ነመ 54,400 ቱሬ።<verse eid="NUM 1:29"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="30" style="v" sid="NUM 1:30"/>ሰኚ ዜቡሎን ኬሳ፦</para>
  <para style="li2" vid="NUM 1:30">ዺሮትን ኡሙሪንሳኒ ወጋ ድግደማቲፊ ሀመሲ ኦሊ ከኔን ሎለ ዸቁ ደንደአን ሁንድኑ አኩመ ገልሜወን በልበላፊ ማቲሳኒት መቃ መቃዻን በሬፈመን። <verse eid="NUM 1:30"/><verse number="31" style="v" sid="NUM 1:31"/>ባይእን ጎሰ ዜቡሎን ነመ 57,400 ቱሬ።<verse eid="NUM 1:31"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="32" style="v" sid="NUM 1:32"/>እልማን ዮሴፍ ኬሳ፦</para>
  <para style="li1" vid="NUM 1:32">ሰኚ ኤፍሬም ኬሳ፦</para>
  <para style="li2" vid="NUM 1:32">ዺሮትን ኡሙሪንሳኒ ወጋ ድግደማቲፊ ሀመሲ ኦሊ ከኔን ሎለ ዸቁ ደንደአን ሁንድኑ አኩመ ገልሜ በልበላፊ ማቲሳኒት መቃ መቃዻን በሬፈመን። <verse eid="NUM 1:32"/><verse number="33" style="v" sid="NUM 1:33"/>ባይእን ጎሰ ኤፍሬም ነመ 40,500 ቱሬ።<verse eid="NUM 1:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="NUM 1:34"/>ሰኚ ምናሴ ኬሳ፦</para>
  <para style="li2" vid="NUM 1:34">ዺሮትን ኡሙሪንሳኒ ወጋ ድግደማቲፊ ሀመሲ ኦሊ ከኔን ሎለ ዸቁ ደንደአን ሁንድኑ አኩመ ገልሜ በልበላፊ ማቲሳኒት መቃ መቃዻን በሬፈመን። <verse eid="NUM 1:34"/><verse number="35" style="v" sid="NUM 1:35"/>ባይእን ጎሰ ምናሴ ነመ 32,200 ቱሬ።<verse eid="NUM 1:35"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="36" style="v" sid="NUM 1:36"/>ሰኚ ቤንያም ኬሳ፦</para>
  <para style="li2" vid="NUM 1:36">ዺሮትን ኡሙሪንሳኒ ወጋ ድግደማቲፊ ሀመሲ ኦሊ ከኔን ሎለ ዸቁ ደንደአን ሁንድኑ አኩመ ገልሜ በልበላፊ ማቲሳኒት መቃ መቃዻን በሬፈመን። <verse eid="NUM 1:36"/><verse number="37" style="v" sid="NUM 1:37"/>ባይእን ጎሰ ቤንያም ነመ 35,400 ቱሬ።<verse eid="NUM 1:37"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="38" style="v" sid="NUM 1:38"/>ሰኚ ዳን ኬሳ፦</para>
  <para style="li2" vid="NUM 1:38">ዺሮትን ኡሙሪንሳኒ ወጋ ድግደማቲፊ ሀመሲ ኦሊ ከኔን ሎለ ዸቁ ደንደአን ሁንድኑ አኩመ ገልሜ በልበላፊ ማቲሳኒት መቃ መቃዻን በሬፈመን። <verse eid="NUM 1:38"/><verse number="39" style="v" sid="NUM 1:39"/>ባይእን ጎሰ ዳን ነመ 62,700 ቱሬ።<verse eid="NUM 1:39"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="40" style="v" sid="NUM 1:40"/>ሰኚ ኣሼር ኬሳ፦</para>
  <para style="li2" vid="NUM 1:40">ዺሮትን ኡሙሪንሳኒ ወጋ ድግደማቲፊ ሀመሲ ኦሊ ከኔን ሎለ ዸቁ ደንደአን ሁንድኑ አኩመ ገልሜ በልበላፊ ማቲሳኒት መቃ መቃዻን በሬፈመን። <verse eid="NUM 1:40"/><verse number="41" style="v" sid="NUM 1:41"/>ባይእን ጎሰ ኣሼር ነመ 41,500 ቱሬ።<verse eid="NUM 1:41"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="42" style="v" sid="NUM 1:42"/>ሰኚ ንፍታሌም ኬሳ፦</para>
  <para style="li2" vid="NUM 1:42">ዺሮትን ኡሙሪንሳኒ ወጋ ድግደማቲፊ ሀመሲ ኦሊ ከኔን ሎለ ዸቁ ደንደአን ሁንድኑ አኩመ ገልሜ በልበላፊ ማቲ እሳንት መቃ መቃዻን በሬፈመን። <verse eid="NUM 1:42"/><verse number="43" style="v" sid="NUM 1:43"/>ባይእን ጎሰ ንፍታሌም ነመ 53,400 ቱሬ።<verse eid="NUM 1:43"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="44" style="v" sid="NUM 1:44"/>ዺሮትን ኩኔን ወረ ሙሴፊ አሮን ሀንገፎተ እስራኤል ኩዸ ለማኒን ለካአመን ቱረን፤ ሀንገፎትን ኩኔንስ ቶኮን ቶኮንሳኒ እዶ ቡኦተ ማቲሳኒ ቱረን። <verse eid="NUM 1:44"/><verse number="45" style="v" sid="NUM 1:45"/>እስራኤሎን ኡሙሪንሳኒ ወጋ ድግደማቲፊ ሀመሲ ኦሊ ከኔን እስራኤል ኬሰት ሎላፍ በኡ ደንደአን ሁንድኑ አኩመ ማቲሳኒት ለካአመን። <verse eid="NUM 1:45"/><verse number="46" style="v" sid="NUM 1:46"/>ወሉማ ገለት ባይእን ነማ 603,550 ቱሬ።<verse eid="NUM 1:46"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="47" style="v" sid="NUM 1:47"/>ሌዎትን ገሩ አከ ጎሰ አቦቲሳኒት ወረ ካን ወጅን ህንለካአምኔ። <verse eid="NUM 1:47"/><verse number="48" style="v" sid="NUM 1:48"/><char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ ቱሬ፦ <verse eid="NUM 1:48"/><verse number="49" style="v" sid="NUM 1:49"/>“አት ጎሰ ሌዊ ህንለካእን ዮካን ለኮብሰ ሰበ እስራኤሎተ ካኒት ህንደበልን። <verse eid="NUM 1:49"/><verse number="50" style="v" sid="NUM 1:50"/>ቆደ ከና አከ ሌዎትን እት ጋፈተምቶተ ዱንካነ ዹገ በኡምሳ፣ ምአሳ ሁንዳፊ ዋን እን ቀቡ ሁንዳ ተአኒፍ እሳን ሙድ። እሳንስ ዱንካነ ቁልቁሉፊ ምአሳ ሁንደ ሃባተን፤ ዱንካንቸ ሃተጃጅለን፤ ናኖሳስ ሃቁበተን። <verse eid="NUM 1:50"/><verse number="51" style="v" sid="NUM 1:51"/>ዬሮ ዱንካን ቁልቁሉን ዴሙ ቀቡት ሌዎትን ዱንካነ ሰነ ሃቡቅሰን፤ ዬሮ ዱንካንች ዻበሙስ ሌዎትን ሃዻበን። ነምን ዱንካንቸት ዽኣቱ ብራ ሃአጄፈሙ። <verse eid="NUM 1:51"/><verse number="52" style="v" sid="NUM 1:52"/>እስራኤሎንስ ቶኮን ቶኮን ነማ ቁበተሳ ኬሳፊ ፋጂሳ ጀለት ኩታ ኩታዻን ዱንካነሳኒ ሃዻበተን። <verse eid="NUM 1:52"/><verse number="53" style="v" sid="NUM 1:53"/>ተኡስ ሌዎትን አከ ዼከምስ <char style="nd">ዋቀዮ</char> ወልዳ እስራኤልት ገድ ህንቡኔፍ ዱንካኖተሳኒ ናኖ ዱንካነ ዹገ በኡምሳ ሃዸዻበተን። ሌዎትን ኤጉምሰ ዱንካነ ዹገ በኡምሳት እት ጋፈተምቶተ ተኡ ቀቡ።”<verse eid="NUM 1:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="NUM 1:54"/>እስራኤሎን አኩመ <char style="nd">ዋቀዮ</char> ሙሴ አጀጄ ሰነት ዋን ከነ ሁንደ ሆጄተን።<verse eid="NUM 1:54"/></para>
  <chapter eid="NUM 1"/>
  <chapter number="2" style="c" sid="NUM 2"/>
  <para style="s1">ጎሰ ጎሳን ቁበቹሳኒ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 2:1"/>
    <char style="nd">ዋቀዮ</char> ሙሴፊ አሮኒን አከነ ጄዼ፦ <verse eid="NUM 2:1"/><verse number="2" style="v" sid="NUM 2:2"/>“እስራኤሎንስ ቶኮን ቶኮን ነማ ፋጂ ኦፊሳኒ ጀለት ፋጂ ማቲሳ ወጅን ዱንካነራ ጥኑመ ፈጋቴ ናኖ ዱንካነ ወል ገኢ ሃቁበቱ።”<verse eid="NUM 2:2"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="3" style="v" sid="NUM 2:3"/>ገመ በኣቲን፣ ከራ በአ ቢፍቱቲን፦</para>
  <para style="li1" vid="NUM 2:3">ኩታወን ቁበተ ይሁዳ ፋጂሳኒ ጀለ ሃቁበተን። ሆገናን እጆሌ ይሁዳ ነህሾን እልመ አሚናዳቢት። <verse eid="NUM 2:3"/><verse number="4" style="v" sid="NUM 2:4"/>ለኮብስ ኩታሳስ ነሞተ 74,600።<verse eid="NUM 2:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="NUM 2:5"/>ጎስት ይሳኮር እሳንት ኣኔ ሃቁበቱ። ሆገናን እጆሌ ይሳኮር ናትናኤል እልመ ዙዋር ቱሬ። <verse eid="NUM 2:5"/><verse number="6" style="v" sid="NUM 2:6"/>ለኮብስ ኩታሳስ ነሞተ 54,400።<verse eid="NUM 2:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="NUM 2:7"/>ጎስት ዜቡሎን ከነት ሃኣኑ። ሆገናን እጆሌ ዜቡሎን ኤሊያብ እልመ ሄሎኒት። <verse eid="NUM 2:7"/><verse number="8" style="v" sid="NUM 2:8"/>ለኮብስ ኩታሳስ ነሞተ 57,400።<verse eid="NUM 2:8"/></para>
  <para style="lf">
    <verse number="9" style="v" sid="NUM 2:9"/>ነሞትን ቁበተ ይሁዳት ለካአመን ሁንድስ አኩመ ኩታ ኩታሳኒት 186,400 ቱረን። እሳንስ ዱራን ዱርሰኒ ቀጄሉ።<verse eid="NUM 2:9"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="10" style="v" sid="NUM 2:10"/>ገመ ክባቲን፦</para>
  <para style="li1" vid="NUM 2:10">ኩታወን ቁበተ ሩቤን ፋጂሳኒ ጀላን ሃቁበተን። ሆገናን እጆሌ ሩቤን ኤሊዙር እልመ ሼዴኡሪት። <verse eid="NUM 2:10"/><verse number="11" style="v" sid="NUM 2:11"/>ለኮብስ ኩታሳስ ነሞተ 46,500።<verse eid="NUM 2:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="NUM 2:12"/>ጎስት ስምኦን እሳንት ኣኔ ሃቁበቱ። ሆገናን ጎሰ ስምኦን ሽሉሚኤል እልመ ዙሪሸዳዪት። <verse eid="NUM 2:12"/><verse number="13" style="v" sid="NUM 2:13"/>ለኮብስ ኩታሳስ ነሞተ 59,300።<verse eid="NUM 2:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="NUM 2:14"/>ጎስት ጋድ እሳንት ሃኣኑ። ሆገናን ጎሰ ጋድ ኤልያሳፍ እልመ ዴኡኤሊት። <verse eid="NUM 2:14"/><verse number="15" style="v" sid="NUM 2:15"/>ለኮብስ ኩታሳስ ነሞተ 45,650።<verse eid="NUM 2:15"/></para>
  <para style="lf">
    <verse number="16" style="v" sid="NUM 2:16"/>ነሞትን ቁበተ ሩቤንት ለካአመን ሁንድስ አኩመ ኩታ ኩታሳኒት 151,450 ቱረን። እሳን ኩኔንስ ወረ ዱራት ኣነኒ ዴሙ።<verse eid="NUM 2:16"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="17" style="v" sid="NUM 2:17"/>ኤርገሲስ ዱንካን ወል ገኢቲፊ ቁበን ሌዎታ ቁበተወን ግዱ ሃዴመን። እሳንስ አኩመ ቶረ ቁበተሳኒት ቶኮን ቶኮንሳኒ እዶሳኒ ኤገተኒ ፋጂሳኒ ጀለ ሃዴመን።<verse eid="NUM 2:17"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="18" style="v" sid="NUM 2:18"/>ገመ ዽኣቲን ገሬን ቁበተ ኤፍሬም ፋጂሳኒ ጀላን ሃቁበተን።</para>
  <para style="li1" vid="NUM 2:18">ሆገናን እልማን ኤፍሬም ኤሊሻማ እልመ አሚሁዲት። <verse eid="NUM 2:18"/><verse number="19" style="v" sid="NUM 2:19"/>ለኮብስ ኩታሳስ ነሞተ 40,500፦<verse eid="NUM 2:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="NUM 2:20"/>ጎስት ምናሴ እሳንት ሃኣኑ። ሆገናን እጆሌ ምናሴ ገማልኤል እልመ ጴዳሱሪት። <verse eid="NUM 2:20"/><verse number="21" style="v" sid="NUM 2:21"/>ለኮብስ ኩታሳስ ነሞተ 32,200።<verse eid="NUM 2:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="NUM 2:22"/>ጎስት ቤንያም እት ሃኣኑ። ሆገናን እልማን ቤንያም አቢዳን እልመ ጋዴዮኒት። <verse eid="NUM 2:22"/><verse number="23" style="v" sid="NUM 2:23"/>ለኮብስ ኩታሳስ ነሞተ 35,400፦<verse eid="NUM 2:23"/></para>
  <para style="lf">
    <verse number="24" style="v" sid="NUM 2:24"/>ነሞትን ቁበተ ኤፍሬምት ለካአመን ሁንድስ ኩታ ኩታሳኒት 108,100 ቱረን። እሳን ኩኔንሞ ኩታ ሰደፋ ተአኒ ዴመን።<verse eid="NUM 2:24"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="25" style="v" sid="NUM 2:25"/>ገመ ካባቲን ኩታወን ቁበተ ዳን ፋጂሳኒ ጀላን ሃቁበተን።</para>
  <para style="li1" vid="NUM 2:25">ሆገናን ጎሰ ዳን አሂኤዜር እልመ አሚሸዳዪት። <verse eid="NUM 2:25"/><verse number="26" style="v" sid="NUM 2:26"/>ለኮብስ ኩታሳስ ነሞተ 62,700።<verse eid="NUM 2:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="NUM 2:27"/>ጎስት ኣሼር እሳንት ኣኔ ሃቁበቱ። ሆገናን እጆሌ አሴር ፈግኤል እልመ ኦክራኒት። <verse eid="NUM 2:27"/><verse number="28" style="v" sid="NUM 2:28"/>ለኮብስ ኩታሳስ ነሞተ 41,500፦<verse eid="NUM 2:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="NUM 2:29"/>ጎስት ንፍታሌም እት ሃኣኑ። ሆገናን እጆሌ ንፍታሌም አሂራ እልመ ኤናኒት። <verse eid="NUM 2:29"/><verse number="30" style="v" sid="NUM 2:30"/>ለኮብስ ኩታሳስ ነሞተ 53,400፦<verse eid="NUM 2:30"/></para>
  <para style="lf">
    <verse number="31" style="v" sid="NUM 2:31"/>ነሞትን ቁበተ ዳኒት ለካአመን ሁንድስ 157,600 ቱረን። እሳንስ ዹመረት ፋጂሳኒ ጀላን ሃዴመን።<verse eid="NUM 2:31"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="32" style="v" sid="NUM 2:32"/>ነሞትን ኩኔን ሰበ እስራኤል ወረ አኩመ ማቲሳኒት ለካአመኒዸ። ለኮብስ ወረ ቁበተ ኬሳ ከኔን ኩታ ኩታሳኒቲን ለካአመን ሁንዳ 603,550። <verse eid="NUM 2:32"/><verse number="33" style="v" sid="NUM 2:33"/>ሌዎትን ገሩ አኩመ <char style="nd">ዋቀዮ</char> ሙሴ አጀጄ ሰነት እስራኤሎተ ካን ወጅን ህንለካአምኔ።<verse eid="NUM 2:33"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="34" style="v" sid="NUM 2:34"/>አከሲን እስራኤሎን ዋን <char style="nd">ዋቀዮ</char> ሙሴ አጀጄ ሁንደ ሆጄተን፤ እሳንስ ሃሉመ ከናን ፋጂሳኒ ጀለ ሃቁበተን፤ ሃሉመ ከናንስ ቶኮን ቶኮንሳኒ በልበላፊ ማቲሳኒ ወጅን በአኒ ሃዴመን።<verse eid="NUM 2:34"/></para>
  <chapter eid="NUM 2"/>
  <chapter number="3" style="c" sid="NUM 3"/>
  <para style="s1">ሌዎተ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 3:1"/>ዬሮ <char style="nd">ዋቀዮ</char> ቱሉ ሲናረት ሙሴት ዱበቴት ሴናን ሰኚ አሮኒፊ ሙሴ ከናዸ።<verse eid="NUM 3:1"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="2" style="v" sid="NUM 3:2"/>መቃን እልማን አሮን፦ ናዳብ ሀንገፍትቸ፣ አቢሁ፣ ኤሌኣዛሪፊ ኢታማር። <verse eid="NUM 3:2"/><verse number="3" style="v" sid="NUM 3:3"/>ኩኔን መቃወን እልማን አሮን ጄቹንስ ሉቦተ ሙደመን ከኔን አከ ሉቦተ ተአኒ ተጃጅለኒፍ ድበመን ሰናት። <verse eid="NUM 3:3"/><verse number="4" style="v" sid="NUM 3:4"/>ናዳቢፊ አቢሁ ገሩ ዬሮ ገሞጂ ሲና ኬሰት እብደ ህንኤየመምን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዽኤሰንት ፉሉመሳ ዱረት ዱአን። እሳን እልማን ቶኮሌ ህንቀበን ቱሬ። ከናፉ ኤሌኣዛሪፊ ኢታማር በረ አባንሳኒ አሮን ሉቡን ጅራቴት ሉቦተ ተአኒ ተጃጅለን።<verse eid="NUM 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 3:5"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ <verse eid="NUM 3:5"/><verse number="6" style="v" sid="NUM 3:6"/>“ጎሰ ሌዊ ፍዲቲ አከ እሳን አሮን ሉብቸ ገርጋረኒፍ እሰ ዱረ ዻብ። <verse eid="NUM 3:6"/><verse number="7" style="v" sid="NUM 3:7"/>እሳንስ ሆጂ ዱንካነ ቁልቁሉ ሆጄቹዻን ዋን እሰራ በርባደሙፊ ዋን ወልዳ ሁንደራ በርባደሙ ፉለ ዱንካነ ወል ገኢ ዱረት ሃራወተን። <verse eid="NUM 3:7"/><verse number="8" style="v" sid="NUM 3:8"/>እሳን ሆጂ ዱንካነ ቁልቁሉ ሆጄተኒ ድርቀመ እስራኤሎታ ጉቱዻን ምአ ዱንካነ ወል ገኢ ሁንደ ሃኤገን። <verse eid="NUM 3:8"/><verse number="9" style="v" sid="NUM 3:9"/>ሌዎተ ሰነ አሮኒፊ እልማንሳት ኬን፤ እሳን ወረ ሰበ እስራኤል ኬሳ ጉቱማን ጉቱት እሰት ኬነመኒዸ። <verse eid="NUM 3:9"/><verse number="10" style="v" sid="NUM 3:10"/>አት አከ እሳን ሉቦተ ተአኒ ተጃጅለኒፍ አሮኒፊ እልማንሳ ሙድ፤ ነምን ብራ ከን እዶ ቁልቁሉ ሰነት ዽኣቱ ገሩ አጄፈሙ ቀበ።”<verse eid="NUM 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 3:11"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ <verse eid="NUM 3:11"/><verse number="12" style="v" sid="NUM 3:12"/>“ኩኖ አን እስራኤሎተ ኬሳ ቆደ ዺረ ሀንገፈ ዱበርቶተ እስራኤል ሁንዳ ሌዎተ ፉዸዼረ። ሌዎትን ከንኮት፤ <verse eid="NUM 3:12"/><verse number="13" style="v" sid="NUM 3:13"/>ሀንገፍት ሁንድኑ ከንኮቲ። አን ዬሮ ብየ ግብጥ ኬሰት ሀንገፈ ሁንደ አጄሴት ሀንገፈ እስራኤል ሁንደ ጄቹንስ ነመስ ተኡ ሆሪ ኦፊኮቲፍ አዳን ባፈዼረ። እሳን ከንኮ ተአን። አን <char style="nd">ዋቀዮ</char>።”<verse eid="NUM 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 3:14"/>
    <char style="nd">ዋቀዮ</char> ገሞጂ ሲና ኬሰት ሙሴዻን አከነ ጄዼ፤ <verse eid="NUM 3:14"/><verse number="15" style="v" sid="NUM 3:15"/>“ሌዎተ ማቲሳኒቲፊ በልበለሳኒቲን ለካእ። ዺረ ጅአ ቶኮ ዮካን ሀመሲ ኦሊ ሁንደ ለካእ።” <verse eid="NUM 3:15"/><verse number="16" style="v" sid="NUM 3:16"/>ሙሴን አኩመ ዱቢን <char style="nd">ዋቀዮ</char> እሰ አጀጄት እሳን ለካኤ።<verse eid="NUM 3:16"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="17" style="v" sid="NUM 3:17"/>ኩኔን መቃወን እልማን ሌዊት፦</para>
  <para style="li2" vid="NUM 3:17">ጌርሾን፣ ቆሃቲፊ ሜራሪ።<verse eid="NUM 3:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="NUM 3:18"/>ኩኔን መቃወን እልማን ጌርሾኒት፦</para>
  <para style="li2" vid="NUM 3:18">ሎቤኒፊ ሽሜኢ።<verse eid="NUM 3:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="NUM 3:19"/>በልበለወን ቆሃቶታ፦</para>
  <para style="li2" vid="NUM 3:19">አምራም፣ ይዝሃር፣ ኬብሮኒፊ ኡዚኤል።<verse eid="NUM 3:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="NUM 3:20"/>በልበለወን ሜራሮታ፦</para>
  <para style="li2" vid="NUM 3:20">መህሊፊ ሙሲ።</para>
  <para style="b" vid="NUM 3:20"/>
  <para style="lf" vid="NUM 3:20">ኩኔን አኩመ ማቲሳኒት በልበለወን ሌዎታት።<verse eid="NUM 3:20"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="21" style="v" sid="NUM 3:21"/>በልበለወን ሊብኒፊ ሽሜኢ ከን ጌርሾን ቱረን፤ እሳንስ በልበለወን ጌርሾኖታት።<verse eid="NUM 3:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="NUM 3:22"/>ባይእን ዺሮተ ኡሙሪንሳኒ ጅአ ቶኮፊ ሀመሲ ኦሊ ከኔን ለካአመን ሁንዳ 7,500 ቱሬ።<verse eid="NUM 3:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="NUM 3:23"/>በልበለወን ጌርሾኖታ ከራ ልጠ ቢፍቱቲን ዱንካነ ቁልቁሉ ዱግደ ዱባን ቁበተን።<verse eid="NUM 3:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="NUM 3:24"/>ሆገናን በልበለወን ጌርሾኖታስ ኤልያሳፍ እልመ ላኤል ቱሬ።<verse eid="NUM 3:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="NUM 3:25"/>እት ጋፈተምን ጌርሾኖትን ዱንካነ ወል ገኢ ኬሰት ቀበንስ ዱንካነ ቁልቁሉ፣ ዱንካናፊ እረ ቡሳሳ፣ ጎልጋ በልበለ ዱንካነ ወል ገኢረ ጅሩ፣ <verse eid="NUM 3:25"/><verse number="26" style="v" sid="NUM 3:26"/>ጎልጋወን ኦብዲ፣ ጎልጋ በልበለ ደላ ከን ዱንካነ ቁልቁሉፊ እዶ ኣርሳት ናነኤ ጅሩ፣ ፉኞፊ ተጃጅለ አከና ኬኑ ሁንደ ኤጉ ቱሬ።<verse eid="NUM 3:26"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="27" style="v" sid="NUM 3:27"/>በልበለወን አምራሞታ፣ ይዝሃሮታ፣ ኬብሮኖታፊ ኡዚኤሎታ በልበለወን ቆሃቲት፤ እሳንስ በልበለወን ቆሃቶታ ቱረን።<verse eid="NUM 3:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="NUM 3:28"/>ባይእን ዺሮተ ጅአ ቶኮፊ ሀመሲ ኦሊ ሁንዳ 8,600 ቱሬ።</para>
  <para style="li1" vid="NUM 3:28">ቆሃቶትን እዶ ቁልቁሉ ሰነ ኤጉት እት ጋፈተምቶተ ቱረን።<verse eid="NUM 3:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="NUM 3:29"/>በልበለወን ቆሃቶታ ከራ ክበ ዱንካነ ቁልቁሉቲን ቁበተን።<verse eid="NUM 3:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="NUM 3:30"/>ሆገናን ማቲወን በልበለወን ቆሃቶታስ ኤሊሳፋን እልመ ኡዚኤል ቱሬ።<verse eid="NUM 3:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="NUM 3:31"/>እሳንስ ታቦተ፣ ምንጃለ፣ ባቱ እብሳ፣ እዶወን ኣርሳ፣ ምአ እዶ ቁልቁሉ እቲን ተጃጅለን፣ ጎልጋፊ ወንቶተ ተጃጅለ አከና ኬነን ሁንደ ኤጉት እት ጋፈተምቶተ ቱረን።<verse eid="NUM 3:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="NUM 3:32"/>ሆገናን ሌዎታ ሀንገፍት ኤሌኣዛር እልመ አሮን ሉብቻ ቱሬ። እንስ ወረ እት ጋፈተምቶተ ኤጉምሰ እዶ ቁልቁሉ ቱረን ሰነረት ድበሜ።<verse eid="NUM 3:32"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="33" style="v" sid="NUM 3:33"/>በልበለወን መሄሎታፊ ሙሶታ ከን ሜራሪ ቱረን፤ እሳንስ በልበለወን ሜራሮታት።<verse eid="NUM 3:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="NUM 3:34"/>ባይእን ዺሮተ ኡሙሪንሳኒ ጅአ ቶኮፊ ሀመሲ ኦሊ ከኔን ለካአመን ሁንዳ 6,200 ቱሬ።<verse eid="NUM 3:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="NUM 3:35"/>ሆገናን ማቲወን በልበለወን ሜራሮታስ ዙሪኤል እልመ አቢሃይሊት፤</para>
  <para style="li1" vid="NUM 3:35">እሳንስ ከራ ካበ ዱንካነ ቁልቁሉማቲን ቁበተን።<verse eid="NUM 3:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="NUM 3:36"/>ሜራሮንስ ቱጌወን ዱንካነ ቁልቁሉ፣ ደገሌወንሳ፣ ኡቱባወንሳ፣ ሚለወንሳ፣ ምአሳ ሁንዳፊ ወንቶተ ተጃጅለ አከና ኬነን ሁንደ፣ <verse eid="NUM 3:36"/><verse number="37" style="v" sid="NUM 3:37"/>አከሱመስ ኡቱባወን ኦብዲ ሰነት ናነአኒ ጅረን፣ ሚለወንሳኒ፣ ቆፎ ዱንካናፊ ፉኞወንሳ ኤጉፍ ሙደመን።<verse eid="NUM 3:37"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="38" style="v" sid="NUM 3:38"/>ሙሴን፣ አሮኒፊ እልማን አሮን ዱንካነ ቁልቁሉራ ከራ በኣ፣ ቅጠ በአ ቢፍቱቲን ፉለ ዱንካነ ወል ገኢ ዱረ ቁበተን።</para>
  <para style="li1" vid="NUM 3:38">እሳንስ እዶ እስራኤሎታ ቡአኒ እዶ ቁልቁሉ ኤጉት እት ጋፈተምቶተ ቱረን።</para>
  <para style="li1" vid="NUM 3:38">ነምን ብራ ከን እዶ ቁልቁሉ ሰነት ዽኣቱ ሃአጄፈሙ።<verse eid="NUM 3:38"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="39" style="v" sid="NUM 3:39"/>ሌዎትን ለካአመን ሁንድ ከኔን ሙሴፊ አሮን አጀጀ <char style="nd">ዋቀዮቲን</char> አኩመ በልበለ በልበለሳኒት ለካአን፣ ዺሮትን ጅአ ቶኮፊ ሀመሲ ኦሊ ሁንድ 22,000 ቱረን።<verse eid="NUM 3:39"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="40" style="v" sid="NUM 3:40"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ “ዺሮተ እስራኤል ሀንገፎተ ከኔን ጅአ ቶኮቲፊ ሀመሲ ኦሊ ሁንደ ለካኢ መቃሳኒ በሬስ። <verse eid="NUM 3:40"/><verse number="41" style="v" sid="NUM 3:41"/>ቆደ እጆሌ እስራኤል ከኔን ሀንገፈ ተአን ሁንዳ ሌዎተ ና ፉዸዹ፤ ቆደ እልማን ሀንገፈ ሆሪ እስራኤሎታ ሁንዳስ ሆሪ ሌዎታ ና ፉዸዹ። አን <char style="nd">ዋቀዮ</char>።”<verse eid="NUM 3:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 3:42"/>ሙሴን አኩመ <char style="nd">ዋቀዮ</char> እሰ አጀጄት ሀንገፎተ እስራኤል ሁንደ ለካኤ። <verse eid="NUM 3:42"/><verse number="43" style="v" sid="NUM 3:43"/>ዺሮትን ሀንገፎትን ጅአ ቶኮፊ ሀመሲ ኦሊ ከኔን መቃ መቃን በሬፈመን ሁንዲ 22,273 ቱረን።<verse eid="NUM 3:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 3:44"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ <verse eid="NUM 3:44"/><verse number="45" style="v" sid="NUM 3:45"/>“ቆደ እጆሌ እስራኤል ከኔን ሀንገፈ ተአን ሁንዳ ሌዎተ ፉዸዹ፤ ቆደ ሆሪ እስራኤሎታስ ሆሪ ሌዎታ ፉዸዹ። ሌዎትን ከንኮት። አን <char style="nd">ዋቀዮ</char>። <verse eid="NUM 3:45"/><verse number="46" style="v" sid="NUM 3:46"/>እስራኤሎተ ሀንገፎተ 273 ከኔን ባይእነ ሌዎታ ጫለን ፉሩፍ፣ <verse eid="NUM 3:46"/><verse number="47" style="v" sid="NUM 3:47"/>ቶኮ ቶኮሳኒቲፍ አኩመ መዳሊ ሰቅሊ እዶ ቁልቁሉት ሰቅሊ ሸን ሸን ፉዽ፤ ሰቅሊን ቶኮ ጌራ ድግደመ። <verse eid="NUM 3:47"/><verse number="48" style="v" sid="NUM 3:48"/>ማለቀ እስራኤሎተ ደበለመን ፉሩፍ ፉዸሜ ሰነስ አሮኒፊ እልማንሳት ኬን።”<verse eid="NUM 3:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="NUM 3:49"/>ሙሴን ማለቀ ሰነ እስራኤሎተ ለኮብሳን ወረ ሌዎታን ፉረመኒን ኦል ተአን ሰነራ ፉዼ። <verse eid="NUM 3:49"/><verse number="50" style="v" sid="NUM 3:50"/>እንስ አከ መዳሊ ሰቅሊ እዶ ቁልቁሉት ሜቲ ሰቅሊ 1,365 ኡልፋቱ እስራኤሎተ ሀንገፈራ ፉዼ። <verse eid="NUM 3:50"/><verse number="51" style="v" sid="NUM 3:51"/>ሙሴንስ አኩመ ዱቢ <char style="nd">ዋቀዮት</char>፣ አኩመ ዋቅን ሙሴ አጀጄት ማለቀ ፉሪ ሰነ አሮኒፊ እልማንሳት ኬኔ።<verse eid="NUM 3:51"/></para>
  <chapter eid="NUM 3"/>
  <chapter number="4" style="c" sid="NUM 4"/>
  <para style="s1">ቆሃቶተ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 4:1"/>
    <char style="nd">ዋቀዮ</char> ሙሴፊ አሮኒን አከነ ጄዼ፦ <verse eid="NUM 4:1"/><verse number="2" style="v" sid="NUM 4:2"/>“ሌዎተ ኬሳ ጎሰ ቆሃቶታ በልበለ በልበላፊ ማቲ ማቲሳኒቲን ለካእ። <verse eid="NUM 4:2"/><verse number="3" style="v" sid="NUM 4:3"/>ዺሮተ ኡሙሪንሳኒ ወጋ ሶዶማ ሀመ ሸንተማ ከኔን ሆጂ ዱንካነ ወል ገኢ ሆጄቹፍ ዹፈን ሁንደ ለካእ።<verse eid="NUM 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 4:4"/>“ሆጂን ቆሃቶትን ወንቶተ ዋን ሁንደ ጫላ ቁልቁሉ ተአኒን ወል ቀበቴ ዱንካነ ወል ገኢ ኬሰት ሆጄተን ከናዸ። <verse eid="NUM 4:4"/><verse number="5" style="v" sid="NUM 4:5"/>ዮሙ ቁበን ዴሙፍ ከኡት አሮኒፊ እልማንሳ ኦል ገለኒ ጎልጋ ደኤሱ ሰነ ገድ ሃቡሰን፤ ጎልጋ ሰናንስ ታቦተ ከኩ ሴራት ሃሀጉገን። <verse eid="NUM 4:5"/><verse number="6" style="v" sid="NUM 4:6"/>ዋን ከነትስ ጎጋ ዱገሜ ኡፍሰኒ ሁጩ ብፍትሳ ጉቱማን ጉቱት ጩቁሊሰ ተኤ እራን ሃአፈን። ደንቀራወንስ እዶ እዶሳኒ ኬሰ ሃገልቸን።<verse eid="NUM 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 4:7"/>“እሳንስ ሁጩ ብፈ ጩቁሊሳ ቶኮ ምንጃለ ቡዴነ እላልቻት ኡፍሰኒ ገበቴ፣ ጫቢፊ ወጪቲ አከሱመስ ኦኮቴ እቲን ዽባዩ ዽኤሰን እሰረ ሃካአን፤ ቡዴን ዬሮ ሁንደ አቺ ህንዸበምኔ ሱንስ እሰረ ሃካአሙ። <verse eid="NUM 4:7"/><verse number="8" style="v" sid="NUM 4:8"/>ሁጩ ብልዲማ እሳንረ ሃድሪርሰን፤ ጎጋ ዱገሜ እት ሃኡውሰን፤ ደንቀራወንሳስ እዶሳኒ ኬሰ ሃገልቸን።<verse eid="NUM 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 4:9"/>“ሁጩ ብፍትሳ ጩቁሊሳ ፉዸኒ ባቱ እብሳ ከን እብሱፍ ቶልቸሜ እብሳሳ ወጅን፣ ዋን እቲን ፎኣ እብሳ ኩተኒፊ ባቱ ዳራ፣ ሜሻወን ዘይቲ ከኔን ሆጂ ከናፍ ኦለን ሁንደስ እቲን ሃሀጉገን። <verse eid="NUM 4:9"/><verse number="10" style="v" sid="NUM 4:10"/>ኤርገሲስ ዋን ከናፊ ምአሳ ሁንደ ጎጋ ዱገሜን መረኒ ወሳሳ እቲን ዋ ባተንረ ሃካአን።<verse eid="NUM 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 4:11"/>“ሁጩ ብፍቲሳ ጩቁሊሰ ተኤስ እዶ ኣርሳ ከን ወርቄራ ሆጄተሜት ኡፍሰኒ ጎጋ ዱገሜ እት ሃሀጉገን፤ ደንቀራወንሳስ እዶሳኒ ኬሰ ሃገልቸን።<verse eid="NUM 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 4:12"/>“ሜሻወን እቲን እዶ ቁልቁሉ ኬሰ ተጃጅለን ሁንደስ ፉዸኒ ሁጩ ብፈ ጩቁሊሳቲን መረኒ ጎጋ ዱገሜን ሀጉገኒ ወሳሳ እቲን ዋ ባተንረ ሃካአን።<verse eid="NUM 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 4:13"/>“እሳንስ እዶ ኣርሳራ ዳራ ሀረኒ ሁጩ ዲማ ዺልጌ እት ሃኡፍሰን። <verse eid="NUM 4:13"/><verse number="14" style="v" sid="NUM 4:14"/>ኤርገሲስ ምአ እዶ ኣርሳ እቲን ተጃጅለን ሁንደ፣ ባቱ እብዳ፣ ቀብዱወን ፎኒ፣ ሜሻ እቲን ዳራ ሀማረኒፊ ወጪቲ እሰረ ሃካአን። ጎጋ ዱገሜ እሰ እራን ሃአፈን፤ ደንቀራወንሳስ እዶሳኒ ኬሰ ሃገልቸን።<verse eid="NUM 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 4:15"/>“ኤርገ አሮኒፊ እልማንሳ ሜሻወን ቁልቁሉ ሰናፊ ምአ ቁልቁሉ ሁንደ ሀጉገኒ ፍጠኒ ቦዴ ዬሮ ቁበን ሱን ጎዳኑፍ ከኡት ቆሃቶትን ምአ ከነ ባቹዻፍ ሃዹፈን። እሳን ገሩ ምአ ቁልቁሉ ሰነ ህንቱቅን፤ ዮ ቱቀን ንዱኡቲ። ቆሃቶትን ዋን ዱንካነ ወል ገኢ ኬሰ ጅሩ ሁንደ ሃባተን።<verse eid="NUM 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 4:16"/>“ኤሌኣዛር እልም አሮን ሉብቻ እት ጋፈተማ ዘይቲ እብሳ፣ እጣነ ኡርጋኣ፣ ኬና ምዻኒ ከን ዬሮ ባይኤ ዽኤፈሙፊ ዘይቲ እቲን ድበኒ ሃተኡ። እን ዱንካነ ቁልቁሉ ሁንዳፊ ዋን እሰ ኬሰ ጅሩ ሁንደት፣ ምኣፊ ሜሻወንሳ ቁልቁሉትስ እት ጋፈተማ ሃተኡ።”<verse eid="NUM 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 4:17"/>
    <char style="nd">ዋቀዮ</char> ሙሴፊ አሮኒን አከነ ጄዼ፤ <verse eid="NUM 4:17"/><verse number="18" style="v" sid="NUM 4:18"/>“በልበለወን ጎሰ ቆሃቲ ሌዎተ ኬሳ ህንበሌስና። <verse eid="NUM 4:18"/><verse number="19" style="v" sid="NUM 4:19"/>አከ እሳን ዮሙ ወንቶተ ዋን ሁንደ ጫላ ቁልቁሉ ተአንት ዽኣተንት፣ አከ ሉቡን ጅራተን መሌ ህንዱኔፍ ዋን ከነ እሳኒፍ ጎዻ፦ አሮኒፊ እልማንሳ እዶ ቁልቁሉ ሴነኒ ዋን ቶኮን ቶኮን ነማ ሆጄቱፊ ባቱ ሃቆቆደን። <verse eid="NUM 4:19"/><verse number="20" style="v" sid="NUM 4:20"/>ቆሃቶትን ገሩ አከ ህንዱኔፍ ዬሮ ጥናፍሌ ወንቶተ ቁልቁሉ እላሉዻፍ ኦል ሴኑ ህንቀበን።”<verse eid="NUM 4:20"/></para>
  <para style="s1">ጌርሾኖተ</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 4:21"/>
    <char style="nd">ዋቀዮ</char> ሙሴን አከነ ጄዼ፤ <verse eid="NUM 4:21"/><verse number="22" style="v" sid="NUM 4:22"/>“ጌርሾኖተስ ማቲ ማቲሳኒፊ በልበለ በልበለሳኒቲን ለካእ። <verse eid="NUM 4:22"/><verse number="23" style="v" sid="NUM 4:23"/>ዺሮተ ኡሙሪንሳኒ ወጋ ሶዶማ ሀመ ሸንተማ ከኔን ሆጂ ዱንካነ ወል ገኢ ሆጄቹ ዹፈን ሁንደ ለካእ።<verse eid="NUM 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 4:24"/>“ተጃጅል በልበለወን ጌርሾኖታ ሆጂ ሆጄቹፊ በኣ ባቹዻን ተጃጅለን ከናዸ፦ <verse eid="NUM 4:24"/><verse number="25" style="v" sid="NUM 4:25"/>እሳን ጎልጋ ዱንካነ ቁልቁሉ፣ ዱንካነ ወል ገኢ፣ ኡፈተሳፊ እረ ቡሳሳ ከን ጎጋ ዱገሜራ ሆጄተሜ፣ ጎልጋ በልበለ ዱንካነ ወል ገኢ፣ <verse eid="NUM 4:25"/><verse number="26" style="v" sid="NUM 4:26"/>ጎልጋወን ደላ ዱንካነ ቁልቁሉፊ እዶ ኣርሳት ናነኤ ጅሩ ሰና፣ ጎልጋ በልበለሳ፣ ፉኞፊ ምአ ተጃጅለ ከናፍ ፈየዱ ሁንደ ባቱ። ጌርሹኖትን ዋን ወንቶተ ከናን ሆጄተሙ ቀቡ ሁንደ ሃሆጄተን። <verse eid="NUM 4:26"/><verse number="27" style="v" sid="NUM 4:27"/>ተጃጅል ጌርሾኖታ ሁንድ በኣ ባቹስ ተኡ ሆጂን ብራ አጀጀ አሮኒፊ እልማንሳ ኬነኒን ሃአዴምስፈሙ። ዋን እሳን ባቹ ቀበን ሁንደስ አኩመ እት ጋፈተመሳኒት ቆቆዳፊ። <verse eid="NUM 4:27"/><verse number="28" style="v" sid="NUM 4:28"/>ተጃጅል በልበለወን ጌርሾኖታ ዱንካነ ወል ገኢት ኬነን ከናዸ። ሆጂንሳኒስ ኢታማር እልመ አሮን ሉብቻቲን ሃቀጄልፈሙ።<verse eid="NUM 4:28"/></para>
  <para style="s1">ሜራሮተ</para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 4:29"/>“ሜራሮተ በልበለ በልበላፊ ማቲ ማቲሳኒቲን ለካእ። <verse eid="NUM 4:29"/><verse number="30" style="v" sid="NUM 4:30"/>ዺሮተ ኡሙሪንሳኒ ወጋ ሶዶማ ሀመ ሸንተማ ከኔን ሆጂ ዱንካነ ወል ገኢ ሆጄቹፍ ዹፈን ሁንደ ለካእ። <verse eid="NUM 4:30"/><verse number="31" style="v" sid="NUM 4:31"/>ወን እሳን ዬሮ ሆጂ ዱንካነ ወል ገኢ ሆጄተንት ጎዸን ከናዸ፦ ኩንስ ቱጌወን ዱንካነ ቁልቁሉ፣ ደገሌወንሳ፣ ኡቱቦታፊ ሚለወንሳኒ፣ <verse eid="NUM 4:31"/><verse number="32" style="v" sid="NUM 4:32"/>ኡቱቦተ ኦብዲት ናነአኒ ጅረን ሚለወንሳኒ ወጅን፣ ቆፎወን ዱንካና፣ ፉኞወን፣ ምአሳኒ ሁንዳፊ ወንቶተ ሆጂ ከናፍ ፈየደን ሁንደ ባቹዸ። እስንስ ዋን ቶኮን ቶኮን ነማ ባቱ አዳን ባሳቲ ረመዳፊ። <verse eid="NUM 4:32"/><verse number="33" style="v" sid="NUM 4:33"/>ተጃጅል በልበለወን ሜራሮታ ቀጄልፈመ ኢታማር እልመ አሮን ሉብቻ ጀለ ዱንካነ ወል ገኢ ኬሰት ኬነን ከናዸ።”<verse eid="NUM 4:33"/></para>
  <para style="s1">ለካአሙ ጎሰ ሌዎታ</para>
  <para style="li1">
    <verse number="34" style="v" sid="NUM 4:34"/>ሙሴን፣ አሮኒፊ ሆገንቶትን ወልዳስ ቆሃቶተ በልበለ በልበላፊ ማቲ ማቲሳኒቲን ለካአን።<verse eid="NUM 4:34"/></para>
  <para style="li2">
    <verse number="35" style="v" sid="NUM 4:35"/>ዺሮትን ኡሙሪንሳኒ ወጋ ሶዶማ ሀመ ሸንተማ ከኔን ሆጂ ዱንካነ ወል ገኢ ኬሳ ሰነ ኬሰ ሆጄቹፍ ዹፈን ሁንድ <verse eid="NUM 4:35"/><verse number="36" style="v" sid="NUM 4:36"/>በልበለ በልበላን ለካአመኒ 2,750 ቱረን። <verse eid="NUM 4:36"/><verse number="37" style="v" sid="NUM 4:37"/>ኩን ለኮብሰ በልበለወን ቆሃቶተ ወረ ዱንካነ ወል ገኢ ኬሰ ሆጄቻ ቱረኒት። ሙሴፊ አሮን አኩመ አጀጀ <char style="nd">ዋቀዮ</char> ከን ከራ ሙሴቲን ኬነሜቲን እሳን ለካአን።<verse eid="NUM 4:37"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="38" style="v" sid="NUM 4:38"/>ጌርሾኖትን በልበለ በልበላፊ ማቲ ማቲሳኒቲን ለካአመን።<verse eid="NUM 4:38"/></para>
  <para style="li2">
    <verse number="39" style="v" sid="NUM 4:39"/>ዺሮትን ኡሙሪንሳኒ ወጋ ሶዶማ ሀመ ሸንተማ ከኔን ሆጂ ዱንካነ ወል ገኢ ኬሰ ሆጄቹፍ ዹፈን ሁንድ <verse eid="NUM 4:39"/><verse number="40" style="v" sid="NUM 4:40"/>በልበለ በልበላፊ ማቲ ማቲሳኒቲን ለካአመኒ 2,630 ቱረን። <verse eid="NUM 4:40"/><verse number="41" style="v" sid="NUM 4:41"/>በልበለወን ጌርሾኖታ፣ ወር ሆጂ ዱንካነ ወል ገኢ ኬሰ ሆጄተን ከኔን ሙሴፊ አሮን አኩመ አጀጀ <char style="nd">ዋቀዮት</char> ለካአን ሁንድ ከኔኒዸ።<verse eid="NUM 4:41"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="42" style="v" sid="NUM 4:42"/>ሜራሮንስ በልበለ በልበላፊ ማቲ ማቲሳኒቲን ለካአመን።<verse eid="NUM 4:42"/></para>
  <para style="li2">
    <verse number="43" style="v" sid="NUM 4:43"/>ዺሮትን ኡሙሪንሳኒ ወጋ ሶዶማ ሀመ ሸንተማ ከኔን ሆጂ ዱንካነ ወል ገኢ ኬሰ ተጃጅሉ ዹፈን ሁንድ <verse eid="NUM 4:43"/><verse number="44" style="v" sid="NUM 4:44"/>በልበለ በልበለሳኒቲን ለካአመኒ 3,200 ቱረን። <verse eid="NUM 4:44"/><verse number="45" style="v" sid="NUM 4:45"/>ወር በልበለወን ሜራሮታ ኬሳ ለካአመን ከኔን ሙሴፊ አሮን አኩመ አጀጀ <char style="nd">ዋቀዮ</char> ከን ከራ ሙሴቲን ኬነሜ ሰናት ለካአን ከኔኒዸ።<verse eid="NUM 4:45"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="46" style="v" sid="NUM 4:46"/>ሙሴን፣ አሮኒፊ ሆገንቶትን እስራኤል ሌዎተ ሁንደ በልበለ በልበላፊ ማቲ ማቲሳኒቲን ለካአን። <verse eid="NUM 4:46"/><verse number="47" style="v" sid="NUM 4:47"/>ዺሮትን ኡሙሪንሳኒ ወጋ ሶዶማ ሀመ ሸንተማ ከኔን ሆጂ ተጃጅላ ሆጄቹፊ ዱንካነ ወል ገኢ ባቹ ዹፈኒ <verse eid="NUM 4:47"/><verse number="48" style="v" sid="NUM 4:48"/>ለካአመን ሁንድ 8,580 ቱረን። <verse eid="NUM 4:48"/><verse number="49" style="v" sid="NUM 4:49"/>እሳንስ አኩመ አጀጀ <char style="nd">ዋቀዮ</char> ከን ከራ ሙሴቲን ኬነሜቲን ቶኮን ቶኮንሳኒ ዋን ሆጄቹ ቀበንት ረመደመን፤ ወን እሳን ባቹ ቀበንስ እሳንት ህመሜ።</para>
  <para style="b" vid="NUM 4:49"/>
  <para style="p" vid="NUM 4:49">አከሲን እሳን አኩመ <char style="nd">ዋቀዮ</char> ሙሴ አጀጄት ለካአመን።<verse eid="NUM 4:49"/></para>
  <chapter eid="NUM 4"/>
  <chapter number="5" style="c" sid="NUM 5"/>
  <para style="s1">ቁልቁልነ ቁበታ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 5:1"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ <verse eid="NUM 5:1"/><verse number="2" style="v" sid="NUM 5:2"/>“ነመ ዹኩበ ጎጋ ከን ነመት ደርቡ ቀቡ ዮካን ነመ ዸንገለኣ ዸግና ቀቡ ዮካን ነመ ሰበቢ ዋን ዱኤ ቶኮቲን ጡራኣ ተኤ ከምዩ አከ ቁበተ ኬሳ ባሰኒፍ ሰበ እስራኤል አጀጅ። <verse eid="NUM 5:2"/><verse number="3" style="v" sid="NUM 5:3"/>ዺረስ ዱበርቲስ ገድ ባሳ፤ አከ እሳን ቁበተሳኒ እዶ አን ግዱሳኒ ጅራዹ ሰነ ህንጡሬስኔፍ ቁበተ ኬሳ እሳን ባሳ።” <verse eid="NUM 5:3"/><verse number="4" style="v" sid="NUM 5:4"/>እስራኤሎንስ አከኑመ ጎዸኒ ቁበተ ኬሳ እሳን ባሰን። እሳንስ አኩመ <char style="nd">ዋቀዮ</char> ሙሴት ህሜ ሰነ ጎዸን።<verse eid="NUM 5:4"/></para>
  <para style="s1">ኪሲ የካፍ ባፈሙ</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 5:5"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ <verse eid="NUM 5:5"/><verse number="6" style="v" sid="NUM 5:6"/>“ወረ እስራኤሊን አከነ ጄዽ፦ ‘ዮ ዺር ዮካን ዱበርቲን ቶኮ ከራ ከሚንዩ ነመ ካንት በሌሰ ሆጄቹዻን <char style="nd">ዋቀዮ</char> ዱረት አመነሙማ ዸቤ፣ ነምን ሱን የከማዸ፤ <verse eid="NUM 5:6"/><verse number="7" style="v" sid="NUM 5:7"/>ጩቡ ሆጄቴስ ህመቹ ቀበ። የከሳቲፍስ ጉቱማን ጉቱት ሃኪሱ። ኪሲ ሰነረትስ ሀርከ ሸን ኬሳ ሀርከ ቶኮ ደበሌ ነምቸ ሚዸሜ ሰናፍ ሃኬኑ። <verse eid="NUM 5:7"/><verse number="8" style="v" sid="NUM 5:8"/>ነምን የክ እሰረት ሆጄተሜ ሱን ዮ ፍረ ኣንቴ ከን ኪሲ ሰነ እሳፍ ፉዹ ቀባቹ ባቴ ገሩ ኪሲን ሱን ከን <char style="nd">ዋቀዮት</char>፤ ኮርቤሰ ሆላ እቲን አራር እሳፍ ቡፈሙ ወጅን ሉባፍ ሃኬነሙ። <verse eid="NUM 5:8"/><verse number="9" style="v" sid="NUM 5:9"/>ቡሲወን ቁልቁሉን እስራኤሎን ሉበት ፍደን ሁንድ ከንሳት። <verse eid="NUM 5:9"/><verse number="10" style="v" sid="NUM 5:10"/>ወንቶትን ቁልቁሉን ከኑመ አቦቲሳኒት፤ ወን እሳን ሉብቻፍ ኬነን ገሩ ከኑመ ሉብቻት።’ ”<verse eid="NUM 5:10"/></para>
  <para style="s1">ኒቲ ዽርሳፍ ህንአመነምኔ</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 5:11"/>ኤርገሲ <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ <verse eid="NUM 5:11"/><verse number="12" style="v" sid="NUM 5:12"/>“አከነ ጄዺቲ ሰበ እስራኤልት ዱበዹ፦ ‘ዮ ኒቲን ነመ ከሚዩ ከራራ በዱዻን እሳፍ አመነሙ ባቴ <verse eid="NUM 5:12"/><verse number="13" style="v" sid="NUM 5:13"/>ዺረ ብራ ወጅን ጪፍቴ፣ ዮ ዽርስሼስ ዋን ከነ ቤኩ ባቴ፣ ዮ ጡራኡማንሼ አኩመ ዾከቴት ሀፌ፣ ዮ ነምንሼረት ዹጋ በኡ ህንአርገምን፣ እሼን ዮ ዋን ከነረት ህንቀበምን፣ <verse eid="NUM 5:13"/><verse number="14" style="v" sid="NUM 5:14"/>ዮ ዽርሰሼ ሀፉር ህናፋ ቀበቴ እን ኒቲሳ ሸኬ፣ ዮ እሼን ጡሮፍቱ ታቴ ዮካን ዮ እን ህናፌ እሼ ሸኬ እሼን ጡሮፍቱ ህንተእን፣ <verse eid="NUM 5:14"/><verse number="15" style="v" sid="NUM 5:15"/>እን ኒቲሳ ሉበት ሃጌሱ። አከሱመስ እን ኬና ዳኩ ገርቡ ኢፊ<note caller="+" style="f"><char style="fr" closed="false">5፥15 </char><char style="ft" closed="false">ኢፊን ቶኮ ኪሎ ግራሚ 1.6።</char></note> ሀርከ ኩዸን ኬሳ ሀርከ ቶኮ ቆደሼ ሃጌሱ። ኬናን ምዻኒ ከን ሰበቢ ህናፋቲፍ ዽኤፈሙ ኩን ዋን ኬና ያደኖ ከን የከ ያደቺሱ ተኤፍ፣ እን ዘይቲፊ እጣነ እት ነቁ ህንቀቡ።<verse eid="NUM 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 5:16"/>“ ‘ሉብችስ እሼ ፍዴ ፉለ <char style="nd">ዋቀዮ</char> ዱረ እሼ ሃዻቡ። <verse eid="NUM 5:16"/><verse number="17" style="v" sid="NUM 5:17"/>ኤርገሲ እን ብሻን ቁልቁሉ ኦኮቴ ሱጴት ሃነቁ፤ ለፈ ዱንካነ ቁልቁሉራ ብዮ ፉዼ ብሻን ሰነ ኬሰ ሃቡሱ። <verse eid="NUM 5:17"/><verse number="18" style="v" sid="NUM 5:18"/>ሉብችስ ኤርገ ዱበርቲ ሰነ ፉለ <char style="nd">ዋቀዮ</char> ዱረ ዻቤ ቦዴ ርፌንሰ መታሼ ሂኬ ኬና ያደኖ ጄቹንስ ኬና ምዻኒ ከን ህናፋፍ ዽኤፈሙ ሰነ ሀርከሼ ኬሰ ካአ፤ ብሻን ሀዻኣ አባርሰ ፍዱ ሰነስ ሀርከ ኦፊት ቀበተ። <verse eid="NUM 5:18"/><verse number="19" style="v" sid="NUM 5:19"/>ሉብችስ ዱበርቲ ሰነ ንከከቺሰ፤ አከነስ ጄዻን፤ “ዮ ኡቱ አት ዽርሰ ቀብዱ ነምን ብራ ስ ወጅን ህንጪስኒፊ ዮ አት ከራራ በዴ ህንጡራእን ብሻን ሀዻኣን አባርሰ ፍዱ ኩን ስ ህንሚዽን። <verse eid="NUM 5:19"/><verse number="20" style="v" sid="NUM 5:20"/>ገሩ አት ዮ ከራራ በዴ ኡቱ ዽርሰ ቀብዱ ነመ ዽርሰኬ ህንተእን ወጅን ጪፍቴ ኦፍ ጡሬስቴ አርገምቴ፤” <verse eid="NUM 5:20"/><verse number="21" style="v" sid="NUM 5:21"/>ከነረት ሉብች ከካ አባርሳ እሼ ከከቺሰ፤ አከነስ ጄዻን፤ “<char style="nd">ዋቀዮ</char> ጉዴደኬ ቶርቶርሴ ገራኬሌ ቦኮክሴ ሰበኬ ግዱት ከካፊ አባርሳፍ ስ ሃጎዹ። <verse eid="NUM 5:21"/><verse number="22" style="v" sid="NUM 5:22"/>አከ ገራንኬ ቦኮኩፊ አከ ጉዴድንኬ ቶርቶሩፍ ብሻን አባርሰ ፍዱ ኩን ዸግነኬ ሃሴኑ።”</para>
  <para style="p" vid="NUM 5:22">“ ‘ዱበርቲን ሱንስ፣ “አሜን፣ አሜን” ሃጄቱ።<verse eid="NUM 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 5:23"/>“ ‘ሉብችስ አባርሰወን ሰነ ክታበ መረማረት ሃበሬሱ፤ ኤርገሲስ ብሻን ሀዻኣ ሰነትራ ሃዽቁ። <verse eid="NUM 5:23"/><verse number="24" style="v" sid="NUM 5:24"/>እንስ አከ ዱበርቲን ሱን ብሻን ሀዻኣ አባርሰ ፍዱ ሰነ ዹግዱ ሃጎዹ፤ ብሻን አባርሳፊ ዽጵነ ሀማ ፍዱ ሱንስ እሼ ሴነ። <verse eid="NUM 5:24"/><verse number="25" style="v" sid="NUM 5:25"/>ሉብችስ ኬና ምዻኒ ከን ህናፋ ሰነ እሼ ሀርካ ፉዼ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ሶቾሴ ገረ እዶ ኣርሳ ፍደ። <verse eid="NUM 5:25"/><verse number="26" style="v" sid="NUM 5:26"/>ሉብን ሱንስ ኬና ምዻኒ ሰነራ ኮኜ ቶኮ ኬና ያደኖቲፍ ፉዼ እዶ ኣርሳረት ሃጉቡ፤ ኤርገሲስ አከ ዱበርቲን ሱን ብሻን ሰነ ዹግዱ ሃጎዹ። <verse eid="NUM 5:26"/><verse number="27" style="v" sid="NUM 5:27"/>ዮ እሼን ኦፍ ጡሬስቴ ዽርሰሼቲፍ አመነሙ ባቴ፣ ዮሙ እሼን ብሻን አባርሰ ፍዱ ሰነ ዹግዱት ብሻን ሱን እሼ ሴኔ ዽጵነ ሀማ እሼት ፍደ፤ ገራንሼ ንቦኮከ፤ ጉዴድንሼ ንቶርቶረ፤ እሼንስ ሰበሼ ብረት አባረምቱ ታት። <verse eid="NUM 5:27"/><verse number="28" style="v" sid="NUM 5:28"/>ገሩ ዮ ዱበርቲን ሱን ኦፍ ጡሬሱ ባቴፊ ዮ ቁልቁሉ ታቴ እሼን የከራ ብልሰ ታት፤ ደኡስ ንደንዴስ።<verse eid="NUM 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 5:29"/>“ ‘ዮ ዱበርቲን ኡቱመ ዽርሰ ቀብዱ ከራራ ጎርቴ ኦፍ ጡሬስቴ <verse eid="NUM 5:29"/><verse number="30" style="v" sid="NUM 5:30"/>ዮካን ዮ ዺር ሰበቢ ኒቲ ኦፊ ሸኩፍ ሀፉር ህናፋ እሰ ቀበቴ፣ ሴር ህናፋፍ ኬነሜ ከናዸ። ሉብች ዱበርቲ ሰነ ፉለ <char style="nd">ዋቀዮ</char> ዱረ ዻቤ ሴረ ከነ ሁንደሼረት ሃራወቱ። <verse eid="NUM 5:30"/><verse number="31" style="v" sid="NUM 5:31"/>ዽርስ ሱን በሌሳራ ብልሰ ተአ፤ ዱበርቲን ሱን ገሩ ገቲ ጩቡሼ አርገት።’ ”<verse eid="NUM 5:31"/></para>
  <chapter eid="NUM 5"/>
  <chapter number="6" style="c" sid="NUM 6"/>
  <para style="s1">ሴረ ናዝሩማ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 6:1"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ <verse eid="NUM 6:1"/><verse number="2" style="v" sid="NUM 6:2"/>“አከነ ጄዺ ሰበ እስራኤልት ዱበዹ፦ ‘ዺር ዮካን ዱበርቲን ቶኮ ዮ <char style="nd">ዋቀዮፍ</char> አዳን ኦፍ ባሱፍ ወሬገ አዳ ዮካን ወሬገ ናዝሩማ ወሬገን፣ <verse eid="NUM 6:2"/><verse number="3" style="v" sid="NUM 6:3"/>ዳዺ ወይኒፊ ዹጋቲ ነመ መቼሱራ ኦፍ ሃኤገተን፤ ነምን ሱን ዸንገጋኣ ዳዺ ወይኒራ ሆጄተሜ ዮካን ዸንገጋኣ ዹጋቲ ነመ መቼሱ ብራ ህንዹግን። እን ጩንፋ ጉማ ወይኒ ዹጉ ዮካን እጀ ወይኒ አሼቲ ዮካን ጎጎጋሳ ኛቹ ህንቀቡ። <verse eid="NUM 6:3"/><verse number="4" style="v" sid="NUM 6:4"/>እንስ በረ ናዝሩማሳ ሁንደ ኬሰ ዋን ጉማ ወይኒራ አርገሙ ከምዩ ሰኚሳስ ተኡ ቆለሳ ኛቹ ህንቀቡ።<verse eid="NUM 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 6:5"/>“ ‘በረ ወሬገ አዳን ባፈሙሳ ሁንደ ኬሰ ቀረባን ቶኮዩ መታሳ ህንቱቅን። ሀመ ዬሮን እን እት <char style="nd">ዋቀዮፍ</char> አዳን ባፈሜ ሱን ጡሙረሙት እን ቁልቁሉ ሃተኡ፤ አከ ርፌንስ መታሳ ጉደቱፍስ ገድ ሃዺሱ።<verse eid="NUM 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 6:6"/>“ ‘ናዝርች በረ <char style="nd">ዋቀዮፍ</char> አዳን ኦፍ ባሴ ሁንደ ኬሰ ሬፈት ዽኣቹ ህንቀቡ። <verse eid="NUM 6:6"/><verse number="7" style="v" sid="NUM 6:7"/>ሰበቢ መለቶን እን እቲን <char style="nd">ዋቀዮፍ</char> አዳን ባፈሜ መታሳረ ጅሩፍ ዮ አባንሳ ዮካን ሃትሳ፣ ኦቦሌስሳ ዮካን ኦቦሌቲንሳ ዱአንሌ እሳኒፍ ጄዼ አከ ሴራት ኦፍ ህንጡሬስን። <verse eid="NUM 6:7"/><verse number="8" style="v" sid="NUM 6:8"/>እን በረ እት አዳን ባፈሜ ሰነ ሁንደ ኬሰ ከን <char style="nd">ዋቀዮፍ</char> ቁልቁሌፈሜዸ።<verse eid="NUM 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 6:9"/>“ ‘ዮ ነምን ቶኮ እዶ ናዝርች ጅሩት አከ ተሳ ዱኤ አከሲን ርፌንሰ እን አዳን ባሴ ሰነ ጡሬሴ፣ እን ጉያ እት ቁልቁሌፈሙት ጄቹንስ ጉያ ቶርበፋት መታሳ ሃሃደቱ። <verse eid="NUM 6:9"/><verse number="10" style="v" sid="NUM 6:10"/>ኤርገሲስ እን ጉያ ሰዴተፋት ጉጌ ለመ ዮካን ጉጌ ሶሶኬ ለመ በልበለ ዱንካነ ወል ገኢረት ሉበት ሃፍዱ። <verse eid="NUM 6:10"/><verse number="11" style="v" sid="NUM 6:11"/>ሰበቢ እን እዶ ሬፍ ጅሩት አርገሙዻን ጩቡ ሆጄቴፍ ሉብች እሰ ቶኮ ኣርሳ ጩቡ፣ እሰ ካንሞ ኣርሳ ጉበሙ ጎዼ አራረ ቡሱፍ ሃዽኤሱፍ። ጉዩመ ሰነስ ርፌንሰ መታሳ አዳን ሃባሱ። <verse eid="NUM 6:11"/><verse number="12" style="v" sid="NUM 6:12"/>እን ዬሮ እት አዳን ባፈሜ ኬሰ አመስ <char style="nd">ዋቀዮፍ</char> አዳን ኦፍ ሃባሱ፤ ጦባላ ሆላ ከን ኡሙሪንሳ ወጋ ቶኮ ተኤስ ኣርሳ የካ ጎዼ ሃፍዱ። ገሩ ሰበቢ እን ዬሮ አዳን በኢሰሳ ኬሰ ጡሬፈሜፍ ጉዮትን ደርበን ህንለካአመን።<verse eid="NUM 6:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 6:13"/>“ ‘ኤጋ ዬሮ አዳን በኡምስሳ ጡሙረሙት ሴር ናዝርቻ ከናዸ፦ እን ገረ ከረ ዱንካነ ወል ገኢት ሃፍደሙ። <verse eid="NUM 6:13"/><verse number="14" style="v" sid="NUM 6:14"/>አችት ኣርሳሳ <char style="nd">ዋቀዮፍ</char> ሃዽኤሱ፤ ኩንስ ጦባላ ኮርቤሰ ሆላ ህርእነ ህንቀብኔ ከን ኡሙሪንሳ ወጋ ቶኮ ተኤ ኣርሳ ጉበሙፍ፣ ጦባላ ሆላ ዸልቱ ህርእነ ህንቀብኔ ከን ኡሙሪንሼ ወጋ ቶኮ ተኤ ኣርሳ ጩቡቲፍ፣ ኮርቤሰ ሆላ ህርእነ ህንቀብኔ ኣርሳ ነጋቲፍ፣ <verse eid="NUM 6:14"/><verse number="15" style="v" sid="NUM 6:15"/>ከነ ወጅንስ መጥኖ ጉንዶ ቶኮ፣ መጥኖ ዳኩ ቡላኣራ ቶልፈሜ ከን ዘይቲዻን ሱኩመሜ፣ ብጥሌ ዘይቲን እረ ድበሜ አከሱመስ ኬና ምዻኒፊ ዽባዩሳኒ ሃዽኤሱ።<verse eid="NUM 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 6:16"/>“ ‘ሉብችስ ፉለ <char style="nd">ዋቀዮ</char> ዱረት እሳን ፍዴ ኣርሳ ጩቡቲፊ ኣርሳ ጉበሙ ሃዽኤሱ። <verse eid="NUM 6:16"/><verse number="17" style="v" sid="NUM 6:17"/>እንስ ኮርቤሰ ሆላ ሰነ መጥኖ ጉንዶረ ጅሩ ሰነ ወጅን ኣርሳ ነጋ ጎዼ <char style="nd">ዋቀዮፍ</char> ሃዽኤሱ፤ አከሱመስ ሉብች ኬና ምዻኒቲፊ ዽባዩሳ ሃዽኤሱ።<verse eid="NUM 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 6:18"/>“ ‘ኤርገሲ ናዝርች በልበለ ዱንካነ ወል ገኢ ዱረት ርፌንሰ አዳን ባሴ ሰነ ሃሃደቱ። ርፌንሰ ሰነስ ፉዼ እብደ ኣርሳ ነጋ ጀላን ጅሩ ሰነ ኬሰ ሃቡሱ።<verse eid="NUM 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 6:19"/>“ ‘ኤርገ ናዝርች ርፌንሰ እቲን አዳን ባፈሜ ሰነ ሃደቴ ቦዴ ሉብን ሱን ፎን ገቲቲ ኮርቤሰ ሆላ ከን አፌለሜፊ መጥኖፊ ብጥሌ ህንቡካእን ጉንዶ ሰነራ ፉዼ ሀርከ ነምቻረ ሃካኡ። <verse eid="NUM 6:19"/><verse number="20" style="v" sid="NUM 6:20"/>ኤርገሲስ ሉብች ኣርሳ ሶቾፈሙ ጎዼ ፉለ <char style="nd">ዋቀዮ</char> ዱረት እሳን ሃሶቾሱ፤ እሳንስ ሀንደራፈ ሶቾፈሜፊ ተፈ ዽኤፈሜ ሰነ ወጅን ሉብቻፍ ከን ቁልቁሌፈመኒዸ። ኤርገሲ ናዝርች ዳዺ ወይኒ ዹጉ ንደንደአ።<verse eid="NUM 6:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 6:21"/>“ ‘ሴር ናዝርቸ ዋን ኬኑ ደንደኡ ካን ደበለቴ አኩመ አዳን በኡምሰሳት ኬናሳ <char style="nd">ዋቀዮፍ</char> ወሬጉ ቶኮ ከናዸ። እንስ አኩመ ሴረ ናዝርቻት ዋን ወሬጌ ሰነ ራወቹ ቀበ።’ ”<verse eid="NUM 6:21"/></para>
  <para style="s1">ኤበ ሉቦታ</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 6:22"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ <verse eid="NUM 6:22"/><verse number="23" style="v" sid="NUM 6:23"/>“አሮኒፊ እልማንሳት አከነ ጄዺ ህም፤ ‘አክ እስን እት እስራኤሎተ ኤብፍተን ከናዸ። አከነ ጄዻኒ፦<verse eid="NUM 6:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 6:24"/>“ ‘ “<char style="nd">ዋቀዮ</char> ስ ሃኤብሱ፤</para>
  <para style="q2" vid="NUM 6:24">ስ ሃኤጉስ፤<verse eid="NUM 6:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="NUM 6:25"/>
    <char style="nd">ዋቀዮ</char> ፉለሳ ሲፍ ሃእብሱ፤</para>
  <para style="q2" vid="NUM 6:25">ገራ ሲፍ ሃላፉ።<verse eid="NUM 6:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="NUM 6:26"/>
    <char style="nd">ዋቀዮ</char> ፉለሳ ገረኬት ሃዴብሱ፤</para>
  <para style="q2" vid="NUM 6:26">ነጋስ ሲፍ ሃኬኑ።” ’<verse eid="NUM 6:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 6:27"/>“አከስት እሳን መቃኮ ሰበ እስራኤልራ ካኡ፤ አንስ እሳን ነንኤብሰ።”<verse eid="NUM 6:27"/></para>
  <chapter eid="NUM 6"/>
  <chapter number="7" style="c" sid="NUM 7"/>
  <para style="s1">ስርነ ኤበ ዱንካነ ቁልቁሉ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 7:1"/>ሙሴን ኤርገ ዱንካነ ቁልቁሉ ሰነ ዻቤ ፍጠቴ ቦዴ፣ ዱንካንቻፊ ምአሳ ሁንደ ድቤ፤ ንቁልቁሌሴስ። አከሱመስ እዶ ኣርሳቲፊ ምአሳ ሁንደ ድቤ ቁልቁሌሴ። <verse eid="NUM 7:1"/><verse number="2" style="v" sid="NUM 7:2"/>ኤርገሲ ሆገንቶትን እስራኤል፣ ሀንገፎትን ማቲወኒ ከኔን ሆገንቶተ ጎሶታ ተአኒ ወረ ለካአመን ሰነ ቀጄልቸንስ ኬና ዽኤሰን። <verse eid="NUM 7:2"/><verse number="3" style="v" sid="NUM 7:3"/>እሳንስ ጋሪወን ሀጉገመን ጀኣፊ ሰንጎተ ኩዸ ለመ ጄቹንስ ቶኮ ቶኮ ሆገንቶታራ ሰንጋ ቶኮ፣ ለመ ለመ ተአኒሞ ጋሪ ቶኮ ኬና ኦፊ ጎዸኒ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ፍደን። ኬናወን ከኔንስ ዱንካነ ቁልቁሉ ሰነ ዱረት ዽኤሰን።<verse eid="NUM 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 7:4"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ <verse eid="NUM 7:4"/><verse number="5" style="v" sid="NUM 7:5"/>“አከ እሳን ሆጂ ዱንካነ ወል ገኢ ሆጄቹ ኬሰት ፈየደኒፍ ኬናወን ከኔን እሳን ሀርካ ፉዽ። ዋን ከነ አኩመ ሆጂን ቶኮ ቶኮ ነማ በርባዱት ሌዎተት ኬን።”<verse eid="NUM 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 7:6"/>ሙሴንስ ጋሪወኒፊ ሰንጎተ ሰነ ፉዼ ሌዎተት ኬኔ። <verse eid="NUM 7:6"/><verse number="7" style="v" sid="NUM 7:7"/>እንስ አኩመ ሆጂሳኒቲፍ መሉት ጋሪወን ለማፊ ሰንጎተ አፉር እልማን ጌርሾንት ኬኔ፤ <verse eid="NUM 7:7"/><verse number="8" style="v" sid="NUM 7:8"/>ጋሪወን አፉሪፊ ሰንጎተ ሰዴት አኩመ ሆጂሳኒቲፍ መሉት እልማን ሜራርት ኬኔ። እሳን ሁንድኑ ቀጄልፈመ ኢታማር እልመ አሮን ሉብቻ ጀለ ቱረን። <verse eid="NUM 7:8"/><verse number="9" style="v" sid="NUM 7:9"/>እልማን ቆሃት ገሩ ሰበቢ ምአ ቁልቁሉ ገቲቲት ባቹን ሆጂሳኒ ተኤፍ ሙሴን ሆማ እሳኒት ህንኬንኔ።<verse eid="NUM 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 7:10"/>ዬሮ እዶን ኣርሳ ድበሜት ሆገንቶትን ኬናወንሳኒ ኤበ እዶ ኣርሳቲፍ ፍደኒ እዶ ኣርሳ ዱረት ዽኤሰን። <verse eid="NUM 7:10"/><verse number="11" style="v" sid="NUM 7:11"/><char style="nd">ዋቀዮ</char> ሙሴዻን፣ “ዱረ ቡኣን ቶኮ ጉዩመ ቶኮ ኬናሳ ስርነ ኤበ እዶ ኣርሳ ሰናቲፍ ሃዽኤሱ” ጄዼ ቱሬቲ።<verse eid="NUM 7:11"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="12" style="v" sid="NUM 7:12"/>ነምን ጉያ ጀልቀባት ኬና ኦፊ ፍዴ ነህሾን እልመ አሚናዳብ ከን ጎሰ ይሁዳ ቱሬ።<verse eid="NUM 7:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="NUM 7:13"/>ኬናንሳስ</para>
  <para style="li2" vid="NUM 7:13">ገበቴ ሜቲ ከን አከ መዳሊ ሰቅሊ እዶ ቁልቁሉት ሰቅሊ ዽበ ቶኮፊ ሶዶመ ኡልፋቱ ቶኮፊ ወጪቲ ሜቲ ከን አከ መዳሊ ሰቅሊ እዶ ቁልቁሉት ሰቅሊ ቶርባተመ ኡልፋቱ ከን ቶኮን ቶኮንሳኒ አከ ኬና ምዻኒት ዳኩ ቡላኣ ዘይቲዻን ሱኩመሜን ጉተመን፣<verse eid="NUM 7:13"/></para>
  <para style="li2">
    <verse number="14" style="v" sid="NUM 7:14"/>ጭልፋ ወርቄ ከን ሰቅሊ ኩዸን ኡልፋቴ እጣናን ጉተሜ ቶኮ፣<verse eid="NUM 7:14"/></para>
  <para style="li2">
    <verse number="15" style="v" sid="NUM 7:15"/>ኣርሳ ጉበሙፍስ ድብቸ ሎኒ ቶኮ፣ ኮርቤሰ ሆላ ቶኮፊ ጦባላ ሆላ ከን ኡሙሪንሳ ወጋ ቶኮ ተኤ ቶኮ፣<verse eid="NUM 7:15"/></para>
  <para style="li2">
    <verse number="16" style="v" sid="NUM 7:16"/>ኣርሳ ጩቡቲፍሞ ኮርቤሰ ሬኤ ቶኮ፣<verse eid="NUM 7:16"/></para>
  <para style="li2">
    <verse number="17" style="v" sid="NUM 7:17"/>ኣርሳ ነጋቲፍ ቀሉፍስ ሰንጎተ ለመ፣ ኮርቤዪ ሆላ ሸን፣ ኮርቤዪ ሬኤ ሸኒፊ ጦባላወን ሆላ ሸን ከኔን ኡሙሪንሳኒ ወጋ ቶኮ ቶኮ ተኤ ቱሬ።</para>
  <para style="lf" vid="NUM 7:17">ኬናን ነህሾን እልም አሚናዳብ ዽኤሴ ከነ ቱሬ።<verse eid="NUM 7:17"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="18" style="v" sid="NUM 7:18"/>ጉያ ለመፋትስ ናትናኤል እልመ ዙዋር ዱረ ቡኣ ይሳኮርቱ ኬናሳ ፍዴ።<verse eid="NUM 7:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="NUM 7:19"/>ኬናን እን ፍዴስ ገበቴ ሜቲ ከን አከ መዳሊ ሰቅሊ እዶ ቁልቁሉት ሰቅሊ ዽበ ቶኮፊ ሶዶመ ኡልፋቱ ቶኮ፣</para>
  <para style="li2" vid="NUM 7:19">ወጪቲ ሜቲ ከን አከ መዳሊ ሰቅሊ እዶ ቁልቁሉት ሰቅሊ ቶርባተመ ኡልፋቱ ቶኮ ከን ቶኮን ቶኮንሳኒ አኩመ ኬና ምዻኒት ዳኩ ቡላኣ ዘይቲዻን ሱኩመሜን ጉተመን፣<verse eid="NUM 7:19"/></para>
  <para style="li2">
    <verse number="20" style="v" sid="NUM 7:20"/>ጫቢ ወርቄ ከን ሰቅሊ ኩዸን ኡልፋቴ እጣናን ጉተሜ ቶኮ፣<verse eid="NUM 7:20"/></para>
  <para style="li2">
    <verse number="21" style="v" sid="NUM 7:21"/>ኣርሳ ጉበሙፍስ ድብቸ ሎኒ ቶኮ፣ ኮርቤሰ ሆላ ቶኮፊ ጦባላ ሆላ ከን ኡሙሪንሳ ወጋ ቶኮ ተኤ ቶኮ፣<verse eid="NUM 7:21"/></para>
  <para style="li2">
    <verse number="22" style="v" sid="NUM 7:22"/>ኣርሳ ጩቡቲፍሞ ኮርቤሰ ሬኤ ቶኮ፣<verse eid="NUM 7:22"/></para>
  <para style="li2">
    <verse number="23" style="v" sid="NUM 7:23"/>ኣርሳ ነጋቲፍ ቀሉፍስ ሰንጎተ ለመ፣ ኮርቤዪ ሆላ ሸን፣ ኮርቤዪ ሬኤ ሸኒፊ ጦባላወን ሆላ ሸን ከኔን ኡሙሪንሳኒ ወጋ ቶኮ ቶኮ ቱሬ።</para>
  <para style="lf" vid="NUM 7:23">ኬናን ናትናኤል እልመ ዙዋር ከነ ቱሬ።<verse eid="NUM 7:23"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="24" style="v" sid="NUM 7:24"/>ጉያ ሰደፋት ኤሊያብ እልመ ሄሎን ሀንገፈ እጆሌ ዜቡሎንቱ ኬናሳ ፍዴ።<verse eid="NUM 7:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="NUM 7:25"/>ኬናንሳስ</para>
  <para style="li2" vid="NUM 7:25">ገበቴ ሜቲ ከን አከ መዳሊ ሰቅሊ እዶ ቁልቁሉት ሰቅሊ ዽበ ቶኮፊ ሶዶመ ኡልፋቱ ቶኮ፣ ወጪቲ ሜቲ ከን አከ መዳሊ ሰቅሊ እዶ ቁልቁሉት ሰቅሊ ቶርባተመ ኡልፋቱ ቶኮ ከኔን ቶኮን ቶኮንሳኒ አኩመ ኬና ምዻኒት ዳኩ ቡላኣ ዘይቲዻን ሱኩመሜን ጉተመን፣<verse eid="NUM 7:25"/></para>
  <para style="li2">
    <verse number="26" style="v" sid="NUM 7:26"/>ጡዌ ወርቄ ከን ሰቅሊ ኩዸን ኡልፋቴ እጣናን ጉተሜ ቶኮ፣<verse eid="NUM 7:26"/></para>
  <para style="li2">
    <verse number="27" style="v" sid="NUM 7:27"/>ኣርሳ ጉበሙፍስ ድብቸ ሎኒ ቶኮ፣ ኮርቤሰ ሆላ ቶኮ፣ ጦባላ ሆላ ኡሙሪንሳ ወጋ ቶኮ ተኤ ቶኮ፣<verse eid="NUM 7:27"/></para>
  <para style="li2">
    <verse number="28" style="v" sid="NUM 7:28"/>ኣርሳ ጩቡቲፍሞ ኮርቤሰ ሬኤ ቶኮ፣<verse eid="NUM 7:28"/></para>
  <para style="li2">
    <verse number="29" style="v" sid="NUM 7:29"/>ኣርሳ ነጋቲፍ ቀሉፍስ ሰንጎተ ለመ፣ ኮርቤዪ ሆላ ሸን፣ ኮሮሚ ሬኤ ሸኒፊ ጦባላ ኮርቤዪ ሆላ ሸን ከኔን ኡሙሪንሳኒ ወጋ ቶኮ ቶኮ ቱሬ።</para>
  <para style="lf" vid="NUM 7:29">ኤጋ ኬናን ኤሊያብ እልመ ሄሎን ከነ ቱሬ።<verse eid="NUM 7:29"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="30" style="v" sid="NUM 7:30"/>ጉያ አፉረፋት ኤሊዙር እልመ ሼዴኡር ዱረ ቡኣ እጆሌ ሩቤንቱ ኬናሳ ፍዴ።<verse eid="NUM 7:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="NUM 7:31"/>ኬናንሳስ</para>
  <para style="li2" vid="NUM 7:31">ገበቴ ሜቲ ከን አከ መዳሊ ሰቅሊ እዶ ቁልቁሉት ሰቅሊ ዽበ ቶኮፊ ሶዶመ ኡልፋቱ ቶኮ፣ ወጪቲ ሜቲ ከን አከ መዳሊ ሰቅሊ እዶ ቁልቁሉት ሰቅሊ ቶርባተመ ኡልፋቱ ቶኮ ከን ቶኮ ቶኮንሳኒ አኩመ ኬና ምዻኒት ዳኩ ቡላኣ ዘይቲዻን ሱኩመሜን ጉተመን፣<verse eid="NUM 7:31"/></para>
  <para style="li2">
    <verse number="32" style="v" sid="NUM 7:32"/>ጡዌ ወርቄ ከን ሰቅሊ ኩዸን ኡልፋቴ እጣናን ጉተሜ ቶኮ፣<verse eid="NUM 7:32"/></para>
  <para style="li2">
    <verse number="33" style="v" sid="NUM 7:33"/>ኣርሳ ጉበሙፍስ ድብቸ ሎኒ ቶኮ፣ ኮርቤሰ ሆላ ቶኮ፣ ጦባላ ሆላ ኡሙሪንሳ ወጋ ቶኮ ተኤ ቶኮ፣<verse eid="NUM 7:33"/></para>
  <para style="li2">
    <verse number="34" style="v" sid="NUM 7:34"/>ኣርሳ ጩቡቲፍሞ ኮርቤሰ ሬኤ ቶኮ፣<verse eid="NUM 7:34"/></para>
  <para style="li2">
    <verse number="35" style="v" sid="NUM 7:35"/>ኣርሳ ነጋቲፍ ቀሉፍስ ሰንጎተ ለመ፣ ኮርቤዪ ሆላ ሸን፣ ኮርቤዪ ሬኤ ሸኒፊ ጦባላ ኮርቤዪ ሆላ ሸን ከኔን ኡሙሪንሳኒ ወጋ ቶኮ ቶኮ ቱሬ።</para>
  <para style="lf" vid="NUM 7:35">ኤጋ ኬናን ኤሊዙር እልመ ሼዴኡር ከነ ቱሬ።<verse eid="NUM 7:35"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="36" style="v" sid="NUM 7:36"/>ጉያ ሸነፋት ሽሉሚኤል እልመ ዙሪሸዳይ ሆገና እጆሌ ስምኦንቱ ኬናሳ ፍዴ።<verse eid="NUM 7:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="NUM 7:37"/>ኬናንሳስ</para>
  <para style="li2" vid="NUM 7:37">ገበቴ ሜቲ ከን አከ መዳሊ ሰቅሊ እዶ ቁልቁሉት ሰቅሊ ዽበ ቶኮፊ ሶዶመ ኡልፋቱ ቶኮ፣ ወጪቲ ሜቲ ከን አከ መዳሊ ሰቅሊ እዶ ቁልቁሉት ሰቅሊ ቶርባተመ ኡልፋቱ ቶኮ፣ ከኔን ቶኮን ቶኮንሳኒ አኩመ ኬና ምዻኒት ዳኩ ቡላኣ ዘይቲዻን ሱኩመሜን ጉተመን፣<verse eid="NUM 7:37"/></para>
  <para style="li2">
    <verse number="38" style="v" sid="NUM 7:38"/>ጡዌ ወርቄ ከን ሰቅሊ ኩዸን ኡልፋቴ እጣናን ጉተሜ ቶኮ፣<verse eid="NUM 7:38"/></para>
  <para style="li2">
    <verse number="39" style="v" sid="NUM 7:39"/>ኣርሳ ጉበሙፍስ ድብቸ ሎኒ ቶኮ፣ ኮርቤሰ ሆላ ቶኮ፣ ጦባላ ሆላ ከን ኡሙሪንሳ ወጋ ቶኮ ተኤ ቶኮ፣<verse eid="NUM 7:39"/></para>
  <para style="li2">
    <verse number="40" style="v" sid="NUM 7:40"/>ኣርሳ ጩቡቲፍሞ ኮርቤሰ ሬኤ ቶኮ፣<verse eid="NUM 7:40"/></para>
  <para style="li2">
    <verse number="41" style="v" sid="NUM 7:41"/>ኣርሳ ነጋቲፍ ቀሉፍስ ሰንጎተ ለመ፣ ኮርቤዪ ሆላ ሸን፣ ኮርቤዪ ሬኤ ሸኒፊ ጦባላወን ሆላ ሸን ከኔን ኡሙሪንሳኒ ወጋ ቶኮ ቶኮ ቱሬ።</para>
  <para style="lf" vid="NUM 7:41">ኤጋ ኬናን ሽሉሚኤል እልመ ዙሪሸዳይ ከነ ቱሬ።<verse eid="NUM 7:41"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="42" style="v" sid="NUM 7:42"/>ጉያ ጀአፋት ኤልያሳፍ እልመ ዴኡኤል ዱረ ቡኣ እጆሌ ጋድቱ ኬናሳ ፍዴ።<verse eid="NUM 7:42"/></para>
  <para style="li1">
    <verse number="43" style="v" sid="NUM 7:43"/>ኬናንሳስ</para>
  <para style="li2" vid="NUM 7:43">ገበቴ ሜቲ ከን አከ መዳሊ ሰቅሊ እዶ ቁልቁሉት ሰቅሊ ዽበ ቶኮፊ ሶዶመ ኡልፋቱ ቶኮ፣ ወጪቲ ሜቲ ከነ አከ መዳሊ ሰቅሊ እዶ ቁልቁሉት ሰቅሊ ቶርባተመ ኡልፋቱ ቶኮ ከኔን ቶኮን ቶኮንሳኒ አኩመ ኬና ምዻኒት ዳኩ ቡላኣ ዘይቲዻን ሱኩመሜን ጉተመን፣<verse eid="NUM 7:43"/></para>
  <para style="li2">
    <verse number="44" style="v" sid="NUM 7:44"/>ጡዌ ወርቄ ከን ሰቅሊ ኩዸን ኡልፋቴ እጣናን ጉተሜ ቶኮ፣<verse eid="NUM 7:44"/></para>
  <para style="li2">
    <verse number="45" style="v" sid="NUM 7:45"/>ኣርሳ ጉበሙፍስ ድብቸ ሎኒ ቶኮ፣ ኮርቤሰ ሆላ ቶኮ፣ ጦባላ ሆላ ከን ኡሙሪንሳ ወጋ ቶኮ ተኤ ቶኮ፣<verse eid="NUM 7:45"/></para>
  <para style="li2">
    <verse number="46" style="v" sid="NUM 7:46"/>ኣርሳ ጩቡቲፍሞ ኮርቤሰ ሬኤ ቶኮ፣<verse eid="NUM 7:46"/></para>
  <para style="li2">
    <verse number="47" style="v" sid="NUM 7:47"/>ኣርሳ ነጋቲፍ ቀሉፍስ ሰንጎተ ለመ፣ ኮርቤዪ ሆላ ሸን፣ ኮሮሚ ሬኤ ሸኒፊ ጦባላወን ሆላ ሸን ከኔን ኡሙሪንሳኒ ወጋ ቶኮ ቶኮ ቱሬ።</para>
  <para style="lf" vid="NUM 7:47">ኤጋ ኬናን ኤልያሳፍ እልመ ዴኡኤል ከነ ቱሬ።<verse eid="NUM 7:47"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="48" style="v" sid="NUM 7:48"/>ጉያ ቶርበፋት ኤሊሻማ እልመ አሚሁድ ዱረ ቡኣ እጆሌ ኤፍሬምቱ ኬናሳ ፍዴ።<verse eid="NUM 7:48"/></para>
  <para style="li1">
    <verse number="49" style="v" sid="NUM 7:49"/>ኬናንሳስ</para>
  <para style="li2" vid="NUM 7:49">ገበቴ ሜቲ ከን አከ መዳሊ ሰቅሊ እዶ ቁልቁሉት ሰቅሊ ዽበ ቶኮፊ ሶዶመ ኡልፋቱ ቶኮ፣ ወጪቲ ሜቲ ከን አከ መዳሊ ሰቅሊ እዶ ቁልቁሉት ሰቅሊ ቶርባተመ ኡልፋቱ ቶኮ ከኔን ቶኮን ቶኮንሳኒ አኩመ ኬና ምዻኒት ዳኩ ቡላኣ ዘይቲዻን ሱኩመሜን ጉተመን፣<verse eid="NUM 7:49"/></para>
  <para style="li2">
    <verse number="50" style="v" sid="NUM 7:50"/>ጡዌ ወርቄ ከን ሰቅሊ ኩዸን ኡልፋቴ እጣናን ጉተሜ ቶኮ፣<verse eid="NUM 7:50"/></para>
  <para style="li2">
    <verse number="51" style="v" sid="NUM 7:51"/>ኣርሳ ጉበሙፍስ ድብቸ ሎኒ ቶኮ፣ ኮርቤሰ ሆላ ቶኮ፣ ጦባላ ሆላ ከን ኡሙሪንሳ ወጋ ቶኮ ተኤ ቶኮ፣<verse eid="NUM 7:51"/></para>
  <para style="li2">
    <verse number="52" style="v" sid="NUM 7:52"/>ኣርሳ ጩቡቲፍሞ ኮርቤሰ ሬኤ ቶኮ፣<verse eid="NUM 7:52"/></para>
  <para style="li2">
    <verse number="53" style="v" sid="NUM 7:53"/>ኣርሳ ነጋቲፍ ቀሉፍስ ሰንጎተ ለመ፣ ኮርቤዪ ሆላ ሸን፣ ኮርቤዪ ሬኤ ሸኒፊ ጦባላወን ሆላ ሸን ከኔን ኡሙሪንሳኒ ወጋ ቶኮ ቶኮ ቱሬ።</para>
  <para style="lf" vid="NUM 7:53">ኤጋ ኬናን ኤሊሻማ እልመ አሚሁድ ከነ ቱሬ።<verse eid="NUM 7:53"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="54" style="v" sid="NUM 7:54"/>ጉያ ሰዴተፋት ገማልኤል እልመ ጴዳሱር ሆገና እጆሌ ምናሴቱ ኬናሳ ፍዴ።<verse eid="NUM 7:54"/></para>
  <para style="li1">
    <verse number="55" style="v" sid="NUM 7:55"/>ኬናንሳስ</para>
  <para style="li2" vid="NUM 7:55">ገበቴ ሜቲ ከን አከ መዳሊ ሰቅሊ እዶ ቁልቁሉት ሰቅሊ ዽበ ቶኮፊ ሶዶመ ኡልፋቱ ቶኮ፣ ወጪቲ ሜቲ ከን አከ መዳሊ ሰቅሊ እዶ ቁልቁሉት ሰቅሊ ቶርባተመ ኡልፋቱ ቶኮ ከኔን ቶኮን ቶኮንሳኒ አኩመ ኬና ምዻኒት ዳኩ ቡላኣ ዘይቲዻን ሱኩመሜን ጉተመን፣<verse eid="NUM 7:55"/></para>
  <para style="li2">
    <verse number="56" style="v" sid="NUM 7:56"/>ጡዌ ወርቄ ከን ሰቅሊ ኩዸን ኡልፋቴ እጣናን ጉተሜ፣<verse eid="NUM 7:56"/></para>
  <para style="li2">
    <verse number="57" style="v" sid="NUM 7:57"/>ኣርሳ ጉበሙፍስ ድብቸ ሎኒ ቶኮ፣ ኮርቤሰ ሆላ ቶኮ፣ ጦባላ ሆላ ከን ኡሙሪንሳ ወጋ ቶኮ ተኤ፣<verse eid="NUM 7:57"/></para>
  <para style="li2">
    <verse number="58" style="v" sid="NUM 7:58"/>ኣርሳ ጩቡቲፍሞ ኮርቤሰ ሬኤ ቶኮ፣<verse eid="NUM 7:58"/></para>
  <para style="li2">
    <verse number="59" style="v" sid="NUM 7:59"/>ኣርሳ ነጋቲፍ ቀሉፍስ ሰንጎተ ለመ፣ ኮርቤዪ ሆላ ሸን፣ ኮሮሚ ሬኤ ሸኒፊ ጦባላወን ሆላ ሸን ከኔን ኡሙሪንሳኒ ወጋ ቶኮ ቶኮ ቱሬ።</para>
  <para style="lf" vid="NUM 7:59">ኤጋ ኬናን ገማልኤል እልመ ጴዳሱር ከነ ቱሬ።<verse eid="NUM 7:59"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="60" style="v" sid="NUM 7:60"/>ጉያ ሰግለፋት አቢዳን እልመ ጋዴዮን ዱረ ቡኣ እጆሌ ቤንያምቱ ኬናሳ ፍዴ።<verse eid="NUM 7:60"/></para>
  <para style="li1">
    <verse number="61" style="v" sid="NUM 7:61"/>ኬናንሳስ</para>
  <para style="li2" vid="NUM 7:61">ገበቴ ሜቲ ከን አከ መዳሊ ሰቅሊ እዶ ቁልቁሉት ሰቅሊ ዽበ ቶኮፊ ሶዶመ ኡልፋቱ ቶኮ፣ ወጪቲ ሜቲ ከን አከ መዳሊ ሰቅሊ እዶ ቁልቁሉት ሰቅሊ ቶርባተመ ኡልፋቱ ቶኮ ከኔን ቶኮን ቶኮንሳኒ አኩመ ኬና ምዻኒት ዳኩ ቡላኣ ዘይቲዻን ሱኩመሜን ጉተመን፣<verse eid="NUM 7:61"/></para>
  <para style="li2">
    <verse number="62" style="v" sid="NUM 7:62"/>ጡዌ ወርቄ ከን ሰቅሊ ኩዸን ኡልፋቴ እጣናን ጉተሜ፣<verse eid="NUM 7:62"/></para>
  <para style="li2">
    <verse number="63" style="v" sid="NUM 7:63"/>ኣርሳ ጉበሙፍስ ድብቸ ሎኒ ቶኮ፣ ኮርቤሰ ሆላ ቶኮ፣ ጦባላ ሆላ ከን ኡሙሪንሳ ወጋ ቶኮ ተኤ ቶኮ፣<verse eid="NUM 7:63"/></para>
  <para style="li2">
    <verse number="64" style="v" sid="NUM 7:64"/>ኣርሳ ጩቡቲፍሞ ኮርቤሰ ሬኤ ቶኮ፣<verse eid="NUM 7:64"/></para>
  <para style="li2">
    <verse number="65" style="v" sid="NUM 7:65"/>ኣርሳ ነጋቲፍ ቀሉፍስ ሰንጎተ ለመ፣ ኮርቤዪ ሆላ ሸን፣ ኮርቤዪ ሬኤ ሸኒፊ ጦባላወን ሆላ ሸን ከኔን ኡሙሪንሳኒ ወጋ ቶኮ ቶኮ ቱሬ።</para>
  <para style="lf" vid="NUM 7:65">ኤጋ ኬናን አቢዳን እልመ ጋዴዮን ከነ ቱሬ።<verse eid="NUM 7:65"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="66" style="v" sid="NUM 7:66"/>ጉያ ኩዸነፋት አሂኤዜር እልመ አሚሸዳይ ዱረ ቡኣ እጆሌ ዳንቱ ኬናሳ ፍዴ።<verse eid="NUM 7:66"/></para>
  <para style="li1">
    <verse number="67" style="v" sid="NUM 7:67"/>ኬናንሳስ</para>
  <para style="li2" vid="NUM 7:67">ገበቴ ሜቲ ከን አከ መዳሊ ሰቅሊ እዶ ቁልቁሉት ሰቅሊ ዽበ ቶኮፊ ሶዶመ ኡልፋቱ ቶኮ፣ ወጪቲ ሜቲ ከን አከ መዳሊ ሰቅሊ እዶ ቁልቁሉት ሰቅሊ ቶርባተመ ኡልፋቱ ቶኮ ከኔን ቶኮን ቶኮንሳኒ አኩመ ኬና ምዻኒት ዳኩ ቡላኣ ዘይቲዻን ሱኩመሜን ጉተመን፣<verse eid="NUM 7:67"/></para>
  <para style="li2">
    <verse number="68" style="v" sid="NUM 7:68"/>ጡዌ ወርቄ ከን ሰቅሊ ኩዸን ኡልፋቴ እጣናን ጉተሜ፣<verse eid="NUM 7:68"/></para>
  <para style="li2">
    <verse number="69" style="v" sid="NUM 7:69"/>ኣርሳ ጉበሙፍስ ድብቸ ሎኒ ቶኮ፣ ኮርቤሰ ሆላ ቶኮ፣ ጦባላ ሆላ ከን ኡሙሪንሳ ወጋ ቶኮ ተኤ ቶኮ፣<verse eid="NUM 7:69"/></para>
  <para style="li2">
    <verse number="70" style="v" sid="NUM 7:70"/>ኣርሳ ጩቡቲፍሞ ኮርቤሰ ሬኤ ቶኮ፣<verse eid="NUM 7:70"/></para>
  <para style="li2">
    <verse number="71" style="v" sid="NUM 7:71"/>ኣርሳ ነጋቲፍ ቀሉፍስ ሰንጎተ ለመ፣ ኮርቤዪ ሆላ ሸን፣ ኮርቤዪ ሬኤ ሸኒፊ ኮርቤዪ ሆላ ጥጥና ሸን ከኔን ኡሙሪንሳኒ ወጋ ቶኮ ቶኮ ቱሬ።</para>
  <para style="lf" vid="NUM 7:71">ኤጋ ኬናን አሂኤዜር እልመ አሚሸዳይ ከነ ቱሬ።<verse eid="NUM 7:71"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="72" style="v" sid="NUM 7:72"/>ጉያ ኩዸ ቶኮፋት ፈግኤል እልመ ኦክራን ሆገና እጆሌ ኣሼርቱ ኬናሳ ፍዴ።<verse eid="NUM 7:72"/></para>
  <para style="li1">
    <verse number="73" style="v" sid="NUM 7:73"/>ኬናንሳስ</para>
  <para style="li2" vid="NUM 7:73">ገበቴ ሜቲ ከን አከ መዳሊ ሰቅሊ እዶ ቁልቁሉት ሰቅሊ ዽበ ቶኮፊ ሶዶመ ኡልፋቱ ቶኮ፣ ወጪቲ ሜቲ ከን አከ መዳሊ ሰቅሊ እዶ ቁልቁሉት ሰቅሊ ቶርባተመ ኡልፋቱ ቶኮ ከኔን ቶኮን ቶኮንሳኒ አኩመ ኬና ምዻኒት ዳኩ ቡላኣ ዘይቲዻን ሱኩመሜን ጉተመን፣<verse eid="NUM 7:73"/></para>
  <para style="li2">
    <verse number="74" style="v" sid="NUM 7:74"/>ጡዌ ወርቄ ከን ሰቅሊ ኩዸን ኡልፋቴ እጣናን ጉተሜ፣<verse eid="NUM 7:74"/></para>
  <para style="li2">
    <verse number="75" style="v" sid="NUM 7:75"/>ኣርሳ ጉበሙፍስ ድብቸ ሎኒ ቶኮ፣ ኮርቤሰ ሆላ ቶኮ፣ ጦባላ ሆላ ከን ኡሙሪንሳ ወጋ ቶኮ ተኤ ቶኮ፣<verse eid="NUM 7:75"/></para>
  <para style="li2">
    <verse number="76" style="v" sid="NUM 7:76"/>ኣርሳ ጩቡቲፍሞ ኮርቤሰ ሬኤ ቶኮ፣<verse eid="NUM 7:76"/></para>
  <para style="li2">
    <verse number="77" style="v" sid="NUM 7:77"/>ኣርሳ ነጋቲፍ ቀሉፍስ ሰንጎተ ለመ፣ ኮርቤዪ ሆላ ሸን፣ ኮርቤዪ ሬኤ ሸኒፊ ጦባላወን ሆላ ሸን ከኔን ኡሙሪንሳኒ ወጋ ቶኮ ቶኮ ቱሬ።</para>
  <para style="lf" vid="NUM 7:77">ኤጋ ኬናን ፈግኤል እልመ ኦክራን ከነ ቱሬ።<verse eid="NUM 7:77"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="78" style="v" sid="NUM 7:78"/>ጉያ ኩዸ ለመፋት አሂራ እልመ ኤናን ሆገና እጆሌ ንፍታሌምቱ ኬናሳ ፍዴ።<verse eid="NUM 7:78"/></para>
  <para style="li1">
    <verse number="79" style="v" sid="NUM 7:79"/>ኬናንሳስ</para>
  <para style="li2" vid="NUM 7:79">ገበቴ ሜቲ ከን አከ መዳሊ ሰቅሊ እዶ ቁልቁሉት ሰቅሊ ዽበ ቶኮፊ ሶዶመ ኡልፋቱ ቶኮ፣ ወጪቲ ሜቲ ከን አከ መዳሊ ሰቅሊ እዶ ቁልቁሉት ሰቅሊ ቶርባተመ ኡልፋቱ ቶኮ ከኔን ቶኮን ቶኮንሳኒ አኩመ ኬና ምዻኒት ዳኩ ቡላኣ ዘይቲዻን ሱኩመሜን ጉተመን፣<verse eid="NUM 7:79"/></para>
  <para style="li2">
    <verse number="80" style="v" sid="NUM 7:80"/>ጡዌ ወርቄ ከን ሰቅሊ ኩዸን ኡልፋቴ እጣናን ጉተሜ ቶኮ፣<verse eid="NUM 7:80"/></para>
  <para style="li2">
    <verse number="81" style="v" sid="NUM 7:81"/>ኣርሳ ጉበሙፍስ ድብቸ ሎኒ ቶኮ፣ ኮርቤሰ ሆላ ቶኮ፣ ጦባላ ሆላ ከን ኡሙሪንሳ ወጋ ቶኮ ተኤ ቶኮ፣<verse eid="NUM 7:81"/></para>
  <para style="li2">
    <verse number="82" style="v" sid="NUM 7:82"/>ኣርሳ ጩቡቲፍሞ ኮርቤሰ ሬኤ ቶኮ፣<verse eid="NUM 7:82"/></para>
  <para style="li2">
    <verse number="83" style="v" sid="NUM 7:83"/>ኣርሳ ነጋቲፍ ቀሉፍስ ሰንጎተ ለመ፣ ኮርቤዪ ሆላ ሸን፣ ኮርቤዪ ሬኤ ሸኒፊ ጦባላወን ሆላ ሸን ከኔን ኡሙሪንሳኒ ወጋ ቶኮ ቶኮ ቱሬ።</para>
  <para style="lf" vid="NUM 7:83">ኤጋ ኬናን አሂራ እልመ ኤናን ከነ ቱሬ።<verse eid="NUM 7:83"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="84" style="v" sid="NUM 7:84"/>ኬናን ሆገንቶትን እስራኤል ጋፈ እዶን ኣርሳ ድበሜ ሰነ ስርነ ኤባቲፍ ዽኤሰን ከነ ቱሬ፤</para>
  <para style="li2" vid="NUM 7:84">እሳንስ ገበቴ ሜቲ ኩዸ ለመ፣ ወጪቲ ሜቲ ኩዸ ለማፊ ጡዌ ወርቄ ኩዸ ለመ፦ <verse eid="NUM 7:84"/><verse number="85" style="v" sid="NUM 7:85"/>ቶኮን ቶኮንሳኒ ሜቲ ሰቅሊ ዽበ ቶኮፊ ሶዶመ ኡልፋቱ ቱሬ፤ ቶኮን ቶኮን ወጪቲ ሜቲ ሰቅሊ ቶርባተመ ኡልፋተ ቱሬ። ምእ ሜቲ ኩን አከ መዳሊ ሰቅሊ እዶ ቁልቁሉት ወሉማ ገለት ሰቅሊ ኩመ ለማፊ ዽባ አፉር ኡልፋተ ቱሬ። <verse eid="NUM 7:85"/><verse number="86" style="v" sid="NUM 7:86"/>ጡዌወን ወርቄ ኩዸ ለማን ከኔን እጣናን ጉተመንስ ቶኮን ቶኮንሳኒ አከ መዳሊ ሰቅሊ እዶ ቁልቁሉት ሰቅሊ ኩዸን ኡልፋቱ ቱረን። ጡዌወን ወርቄ ወሉማ ገለት ሰቅሊ ዽበ ቶኮፊ ድግደመ ኡልፋቱ ቱረን።<verse eid="NUM 7:86"/></para>
  <para style="li2">
    <verse number="87" style="v" sid="NUM 7:87"/>ባይእን ሆሪ ኣርሳ ጉበሙፍ ዽኤፈመኒ ወሉማ ገለት ጅቦተ ሎኒ ኩዸ ለመ፣ ኮርቤዪ ሆላ ኩዸ ለመ፣ ጦባላወን ሆላ ከኔን ኡሙሪንሳኒ ወጋ ቶኮ ተኤ ኩዸ ለመ ቱሬ፤ ኬናን ምዻኒስ እሳን ወጅን ዽኤፈሜረ። ኮርቤዪን ሬኤ ኩዸ ለመ ኣርሳ ጩቡቲፍ ዽኤፈመኒ ቱረን።<verse eid="NUM 7:87"/></para>
  <para style="li2">
    <verse number="88" style="v" sid="NUM 7:88"/>ባይእን ሆሪ ኣርሳ ነጋቲፍ ዽኤፈመኒ ወሉማ ገለት ሰንጎተ ድግደሚ አፉር፣ ኮርቤዪ ሆላ ጃተመ፣ ኮርቤዪ ሬኤ ጃተማፊ ጦባላወን ሆላ ከኔን ኡሙሪንሳኒ ወጋ ቶኮ ቱሬ።</para>
  <para style="b" vid="NUM 7:88"/>
  <para style="lf" vid="NUM 7:88">ኬናወን ኤርገ እዶን ኣርሳ ድበሜ ቦዴ ስርነ ኤበሳቲፍ ዽኤፈመን ከኔን ቱረን።<verse eid="NUM 7:88"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="89" style="v" sid="NUM 7:89"/>ሙሴን ዮሙ <char style="nd">ዋቀዮ</char> ወጅን ዱበቹፍ ዱንካነ ወል ገኢ ኦል ሴኔት ቴሶ አራራ ከን ታቦተ ከኩ ሴራረ ጅሩን ኦልት ኪሩቤሊ ለማን ግዱዻ ሰገሌ እሰት ዱበቱ ዸገኤ። <char style="nd">ዋቀዮ</char> እሰ ወጅን ዱበቴ።<verse eid="NUM 7:89"/></para>
  <chapter eid="NUM 7"/>
  <chapter number="8" style="c" sid="NUM 8"/>
  <para style="s1">እብሳወን ካኡ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 8:1"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ <verse eid="NUM 8:1"/><verse number="2" style="v" sid="NUM 8:2"/>“አሮንት አከነ ጄዺ ዱበዹ፤ ‘ዬሮ አት እብሳወን ቶርበን ቀብሲፍቱት እሳን እዶ ባቱ እብሳ ፉለ ዱረ ጅሩ ሃእብሰን።’ ”<verse eid="NUM 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 8:3"/>አሮንስ አከሱመ ጎዼ፤ እንስ አኩመ <char style="nd">ዋቀዮ</char> ሙሴ አጀጄት አከ እሳን ፉለ ባቱ እብሳ ዱራን እፈ ኬነኒፍ እብሳወን ሰነ ቀብሲሴ። <verse eid="NUM 8:3"/><verse number="4" style="v" sid="NUM 8:4"/>አክ እት ባቱን እብሳ ቶልፈሜ አከነ፦ ሚለሳራ ጀልቀቤ ሀመ ደራራሳት ወርቄ ቱመሜራ ሆጄተሜ። ባቱን እብሳ ሱን አኩመ ፈኬኘ <char style="nd">ዋቀዮ</char> ሙሴት አርግሲሴ ሰናት ሆጄተሜ።<verse eid="NUM 8:4"/></para>
  <para style="s1">አዳን ባፈሙ ሌዎታ</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 8:5"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፦ <verse eid="NUM 8:5"/><verse number="6" style="v" sid="NUM 8:6"/>“ሰበ እስራኤል ኬሳ ሌዎተ ፉዺ ቁልቁሌስ። <verse eid="NUM 8:6"/><verse number="7" style="v" sid="NUM 8:7"/>እሳን ቁልቁሌሱፍስ ዋን ከነ ጎዽ፦ ብሻን ቁልቁላኡማ እሳንት ፈጫስ፤ አከ እሳን ዸግነሳኒ ጉቱ ሃደተኒ አከሲን ኡፈተ ኦፊ ሚጨተኒ ኦፍ ቁልቁሌሰን ጎዽ። <verse eid="NUM 8:7"/><verse number="8" style="v" sid="NUM 8:8"/>እሳንስ ድብቸ ሎኒ ቶኮ ኬና ምዻኒ ከን ዳኩ ቡላኣ ዘይቲዻን ሱኩመሜ ወጅን ሃፉዸን፤ አትስ ድብቸ ሎኒ ለመፋ ኣርሳ ጩቡቲፍ ፉዽ። <verse eid="NUM 8:8"/><verse number="9" style="v" sid="NUM 8:9"/>ሌዎተ ፉለ ዱንካነ ወል ገኢ ዱረት ዽኤሲቲ ወልዳ እስራኤሎታ ጉቱ ወልት ቀብ። <verse eid="NUM 8:9"/><verse number="10" style="v" sid="NUM 8:10"/>ሌዎተስ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዽኤስ፤ ሰብን እስራኤል ሀርከሳኒ ሌዎተረ ሃካአን። <verse eid="NUM 8:10"/><verse number="11" style="v" sid="NUM 8:11"/>አሮንስ አከ ሌዎትን <char style="nd">ዋቀዮ</char> ተጃጅሉ ደንደአኒፍ ሰበ እስራኤል ኬሳ ኣርሳ ሶቾፈሙ ጎዼ ፉለ <char style="nd">ዋቀዮ</char> ዱረት እሳን ሃዽኤሱ።<verse eid="NUM 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 8:12"/>“ኤርገ ሌዎትን ሀርከሳኒ መታ ጅቦተ ሰናረ ካአኒ ቦዴ አት ሌዎታፍ አራራ ቡሱዻፍ ድብቸ ቶኮ ኣርሳ ጩቡ፣ ካንሞ ኣርሳ ጉበሙ ጎዺቲ <char style="nd">ዋቀዮፍ</char> ዽኤስ። <verse eid="NUM 8:12"/><verse number="13" style="v" sid="NUM 8:13"/>አከ ሌዎትን ፉለ አሮኒፊ ፉለ እልማንሳ ዱረ ዻበተን ጎዽ፤ ኤርገሲስ ኣርሳ ሶቾፈሙ ጎዺቲ <char style="nd">ዋቀዮት</char> እሳን ዽኤስ። <verse eid="NUM 8:13"/><verse number="14" style="v" sid="NUM 8:14"/>ሃለ ከናን እስራኤሎተ ካን ኬሳ ሌዎተ አዳን ባስ፤ ሌዎትንስ ከንኮ ሃተአን።<verse eid="NUM 8:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 8:15"/>“ኤርገ አት ሌዎተ ቁልቁሌስቴ ኣርሳ ሶቾፈሙ ጎቴ እሳን ዽኤስቴ ቦዴስ እሳን ሆጂ ዱንካነ ወል ገኢ ሆጄቹፍ ሃዹፈን። <verse eid="NUM 8:15"/><verse number="16" style="v" sid="NUM 8:16"/>እሳን እስራኤሎተ ኬሳ ጉቱማን ጉቱት ናፍ ኬነሙ ቀቡ። አን ቆደ ሀንገፈ ሰበ እስራኤል ከን ገደሜሰ ሳቁ ሁንዳ ሌዎተ ኦፊኮቲፍ ፉዸዼረ። <verse eid="NUM 8:16"/><verse number="17" style="v" sid="NUM 8:17"/>እስራኤል ኬሳ ዺር ሀንገፍን ሁንድ ነመስ ተኡ ሆሪን ከንኮት። አን ዬሮን ብየ ግብጥ ኬሰት ሀንገፈ ሁንደ አጄሴ ሰነ ኦፊኮቲፈን አዳን እሳን ባፈዼ። <verse eid="NUM 8:17"/><verse number="18" style="v" sid="NUM 8:18"/>አን ቆደ እልማን እስራኤል ሀንገፎተ ሁንዳ ሌዎተ ፉዸዼረ። <verse eid="NUM 8:18"/><verse number="19" style="v" sid="NUM 8:19"/>ዮሙ እስራኤሎን እዶ ቁልቁሉት ዽኣተንት አከ ዸእች እሳን ህንአርገኔፍ፣ አከ እሳን እስራኤሎታፍ አራረ ቡሰኒፊ አከ እሳን ተጃጅለ እስራኤሎታ ዱንካነ ወል ገኢ ኬሰት ራወተኒፍ አን ሌዎተ ሰበ እስራኤል ሁንደ ኬሳ አሮኒፊ እልማንሳቲፍ ኬና ጎዼ ኬኔረ።”<verse eid="NUM 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 8:20"/>ሙሴን፣ አሮኒፊ ወልዳን እስራኤል ጉቱን አኩመ <char style="nd">ዋቀዮ</char> ሙሴ አጀጄ ሰነ ሌዎተስ ጎዸን። <verse eid="NUM 8:20"/><verse number="21" style="v" sid="NUM 8:21"/>ሌዎትንስ ኦፍ ቁልቁሌሰኒ ወያ ኦፊ ሚጨተን። አሮንስ አኩመ ኣርሳ ሶቾፈሙት ፉለ <char style="nd">ዋቀዮ</char> ዱረት እሳን ዽኤሴ፤ እሳን ቁልቁሌሱፍስ አራረ እሳኒፍ ቡሴ። <verse eid="NUM 8:21"/><verse number="22" style="v" sid="NUM 8:22"/>ኤርገሲ ሌዎትን ቀጄልቸ አሮኒፊ እልማንሳቲን ሆጂ ዱንካነ ወል ገኢ ሆጄቹዻፍ ዹፈን። እሳንስ አኩመ <char style="nd">ዋቀዮ</char> ሙሴ አጀጄ ሰነ ሌዎተስ ጎዸን።<verse eid="NUM 8:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 8:23"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ <verse eid="NUM 8:23"/><verse number="24" style="v" sid="NUM 8:24"/>“ኩን ሴረ ሌዎታፍ ኬነሜዸ፦ ዺሮትን ኡሙሪንሳኒ ወጋ ድግደሚ ሸኒፊ ሀመሲ ኦሊ ሆጂ ዱንካነ ወል ገኢ ኬሰት ህርማቹፍ ሃዹፈን፤ <verse eid="NUM 8:24"/><verse number="25" style="v" sid="NUM 8:25"/>ኡሙሪ ወጋ ሸንተማት ገሩ ተጃጅለሳኒ ሃዻበን፤ ዴብአኒስ ህንተጃጅልን። <verse eid="NUM 8:25"/><verse number="26" style="v" sid="NUM 8:26"/>ሆጂ ዱንካነ ወል ገኢረት ኦቦሎተ ኦፊ ገርጋሩ ንደንደኡ፤ ኦፊሳኒቲ ገሩ ሆጂ ሰነ ህንሆጄትን። ኤጋ ኩን ሃለ እት አት እት ጋፈተመ ሌዎታ ረመዱዸ።”<verse eid="NUM 8:26"/></para>
  <chapter eid="NUM 8"/>
  <chapter number="9" style="c" sid="NUM 9"/>
  <para style="s1">ፋሲካ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 9:1"/>
    <char style="nd">ዋቀዮ</char> ኤርገ እሳን ግብጢ በአኒ ቦዴ ጅአ ጀልቀባ ከን ወጋ ለመፋት ገሞጂ ሲና ኬሰት አከነ ጄዼ ሙሴት ዱበቴ፤ <verse eid="NUM 9:1"/><verse number="2" style="v" sid="NUM 9:2"/>“እስራኤሎን ዬሮ ሙርታኤት ፋሲካ ሃአያኔፈተን። <verse eid="NUM 9:2"/><verse number="3" style="v" sid="NUM 9:3"/>እስን አኩመ ሴራፊ ደምቢ አያነ ከና ሁንዳት ዬሮ ሙርታኤት ጅአ ሰነ ኬሰ፣ ድምምሰ ገልገለ ጉያ ኩዸ አፉረፋት አያኔፈዻ።”<verse eid="NUM 9:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 9:4"/>ሙሴን አከ እሳን ፋሲካ አያኔፈተን እስራኤሎተት ህሜ፤ <verse eid="NUM 9:4"/><verse number="5" style="v" sid="NUM 9:5"/>እሳንስ ጅአ ጀልቀባ ኬሰ ድምምሰ ገልገለ ጉያ ኩዸ አፉረፋት ገሞጂ ሲና ኬሰት አያኔፈተን። ሰብን እስራኤል አኩመ <char style="nd">ዋቀዮ</char> ሙሴ አጀጄት ዋን ሁንደ ጎዼ።<verse eid="NUM 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 9:6"/>እሳን ኬሳ ነሞትን ቶኮ ቶኮ ሰበቢ ሬፈ ቱቀኒ ጡራአኒፍ ጉያ ሰነ ፋሲካ አያኔፈቹ ህንደንዴኜ። እሳን ጉዩመ ሰነ ገረ ሙሴፊ አሮኒ ዹፈኒ፣ <verse eid="NUM 9:6"/><verse number="7" style="v" sid="NUM 9:7"/>ሙሴዻን አከነ ጄዸን፤ “ኑ ሰበቢ ሬፈ ነማ ቱቅኔፍ ጡሮፍኔረ፤ ገሩ ማሊፍ ዬሮ ሙርታኤ ሰነት እስራኤሎተ ካን ወጅን ኣርሳ <char style="nd">ዋቀዮ</char> ዽኤሱ ዾወምኔ?”<verse eid="NUM 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 9:8"/>ሙሴንስ፣ “ሀመ አን ዋን <char style="nd">ዋቀዮ</char> ዋኤኬሰን አጀጁ ዸገኡት ቱራ” ጄዼን።<verse eid="NUM 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 9:9"/>
    <char style="nd">ዋቀዮስ</char> ሙሴዻን አከነ ጄዼ፤ <verse eid="NUM 9:9"/><verse number="10" style="v" sid="NUM 9:10"/>“እስራኤሎታን አከነ ጄዽ፦ ‘እስን ኬሳ ዮካን እልማንኬሰን ኬሳ ነምን ቶኮ ዮ ሬፈ ቱቄ ጡራኤ ዮካን ከራ ፈጎ ዴሜ፣ እን አመዩ ፋሲካ <char style="nd">ዋቀዮ</char> አያኔፈቹ ንደንደአ። <verse eid="NUM 9:10"/><verse number="11" style="v" sid="NUM 9:11"/>እሳንስ ጅአ ለመፋ ኬሰ ጉያ ኩዸ አፉረፋ ድምምሰ ገልገለ ፋሲካ ሃአያኔፈተን። ፋሲካ ሰነስ መጥኖፊ ባለ ሀዻኣ ወጅን ሃኛተን። <verse eid="NUM 9:11"/><verse number="12" style="v" sid="NUM 9:12"/>እሳንስ ወንቶተ ከኔን ኬሳ ቶኮዩ ሀመ ገነማት ሀምብሱ ዮካን ለፌሳ ኬሳ ቶኮዩ ጨብሱ ህንቀበን። እሳን ዮሙ ፋሲካ አያኔፈተንት ደምቢወን ሁንደ ዱካ ቡኡ ቀቡ። <verse eid="NUM 9:12"/><verse number="13" style="v" sid="NUM 9:13"/>ገሩ ነምን ቁልቁሉ ተኤ ከራ ህንዴምን ዮ ፋሲካ አያኔፈቹ ባቴ እን ሰበቢ ዬሮ ሙርታኤት ኣርሳ <char style="nd">ዋቀዮ</char> ህንዽኤስኒፍ ሰበሳ ኬሳ ሃበሌፈሙ። ነምች ሱን ገቲ ጩቡሳ ንአርገተ።<verse eid="NUM 9:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 9:14"/>“ ‘አለጋን እስን ግዱ ጅራቱ ከን ፋሲካ <char style="nd">ዋቀዮ</char> አያኔፈቹ ፌዹ ቶኮ አኩመ ሴራፊ ደምቢ ፋሲካት ሃአያኔፈቱ። እስንስ አለጋፊ ዸለታ ብያቲፍ ሴሩመ ቶክቸ ቀባዻ።’ ”<verse eid="NUM 9:14"/></para>
  <para style="s1">ዱሜሰ ዱንካነ ቁልቁሉዻን ኦሊ</para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 9:15"/>ጋፈ ዱንካን ቁልቁሉን ዻበሜ ሰነ ዱሜስ ዱንካነ ሰነ ጄቹንስ ዱንካነ ዹገ በኡምሳ ሀጉጌ። ዱሜስ ዱንካነ ቁልቁሉዻን ኦሊ ሱንስ ገልገላ ሀመ ገነማት እብደ ፈካተ ቱሬ። <verse eid="NUM 9:15"/><verse number="16" style="v" sid="NUM 9:16"/>ወን ኩንስ ዬሮ ሁንደ አከኑመ ቱሬ፤ ጉያ ዱሜስ እሰ ሀጉገ ቱሬ፤ ሀልከንሞ ዱሜስ ሱን እብደ ፈካተ ቱሬ። <verse eid="NUM 9:16"/><verse number="17" style="v" sid="NUM 9:17"/>ዬሮ ዱሜስ ሱን ዱንካነራ ከኡ እስራኤሎን ከአኒ ዴሙ ቱረን፤ ለፈ ዱሜስ ቡኡሞ እስራኤሎን ንቁበቱ። <verse eid="NUM 9:17"/><verse number="18" style="v" sid="NUM 9:18"/>እስራኤሎን አጀጀ <char style="nd">ዋቀዮቲን</char> ከአኒ ዴሙ፤ አጀጁመሳቲንስ ቁበቱ። ዬሮ ዱሜስ ዱንካነ ቁልቁሉን ኦል ጅሩ እሳንስ ቁበተ ኬሰ ቱረን። <verse eid="NUM 9:18"/><verse number="19" style="v" sid="NUM 9:19"/>ዮ ዱሜስ ሱን ጉያ ሄዱ ዱንካነ ጉባ ቱሬስ እስራኤሎን ሴረ <char style="nd">ዋቀዮቲፍ</char> ዋን አጀጀመኒፍ እዶ ሰና ከአኒ ህንዴመን ቱሬ። <verse eid="NUM 9:19"/><verse number="20" style="v" sid="NUM 9:20"/>ዬሮ ቶኮ ቶኮ ዱሜስ ሱን ጉያ ጥናዻፍ ዱንካነ ቁልቁሉ ጉባ ኦሌ ቡለ ቱሬ፤ እሳንስ አጀጀ <char style="nd">ዋቀዮቲን</char> ቁበቱ፤ አጀጁመሳቲንስ ከአኒ ዴሙ። <verse eid="NUM 9:20"/><verse number="21" style="v" sid="NUM 9:21"/>ዬሮ ቶኮ ቶኮ ዱሜስ ሱን ገልገላ ሀመ ገነማት ጅራተ ቱሬ፤ ዮሙ ዱሜስ ገነማን ከኡ እሳንስ ከአኒ ዴሙ። ጉያስ ተኡ ሀልከን፣ ዬሮ ዱሜስ ከኡ እሳንስ ከአኒ ዴሙ። <verse eid="NUM 9:21"/><verse number="22" style="v" sid="NUM 9:22"/>ዬሮ ዱሜስ ሱን ጉያ ለመስ ተኡ ጅአ ቶኮ ዮካን ወጋ ቶኮ ዱንካነ ቁልቁሉረ ቱሩት እስራኤሎን ቁበቱመ ኬሰ ቱሩ መሌ ከአኒ ህንዴመን ቱሬ፤ ዬሮ ዱሜስች ከኡት ገሩ ከአኒ ዴሙ። <verse eid="NUM 9:22"/><verse number="23" style="v" sid="NUM 9:23"/>እሳን አጀጀ <char style="nd">ዋቀዮቲን</char> ቁበቱ፤ አጀጁመ <char style="nd">ዋቀዮቲንስ</char> ከአኒ ዴሙ። አኩመ አጀጀ <char style="nd">ዋቀዮ</char> ከራ ሙሴቲን ኬኔ ሰናትስ ሴረ እሳቲፍ አጀጀሙ።<verse eid="NUM 9:23"/></para>
  <chapter eid="NUM 9"/>
  <chapter number="10" style="c" sid="NUM 10"/>
  <para style="s1">መለከተወን ሜቲ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 10:1"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፦ <verse eid="NUM 10:1"/><verse number="2" style="v" sid="NUM 10:2"/>“ሜቲ ቱመሜራ መለከተ ለመ ቶልፈዹቲ ሀዋሰ ወልት ዋሙፊ አከ ቁበን ከኤ ዴሙ ጎቹፍ እት ፈየደም። <verse eid="NUM 10:2"/><verse number="3" style="v" sid="NUM 10:3"/>ዬሮ መለከትን ለማን አፉፈመንት ሀዋስን ሁንድ በልበለ ዱንካነ ወል ገኢት ፉለኬ ዱረት ወልት ሃቀበሙ። <verse eid="NUM 10:3"/><verse number="4" style="v" sid="NUM 10:4"/>ዮ መለከትን ቶኮ ቆፍት አፉፈሜ ገሩ ሆገንቶትን ጄቹንስ አቦቲን ጎሶተ እስራኤል ፉለኬ ዱረት ወልት ሃቀበመን። <verse eid="NUM 10:4"/><verse number="5" style="v" sid="NUM 10:5"/>ዬሮ መለከትን አፉፈሙት ጎሶትን ገመ በአ ቢፍቱቲን ቁበተን ከአኒ ሃዴመን። <verse eid="NUM 10:5"/><verse number="6" style="v" sid="NUM 10:6"/>ዬሮ መለከትን ስአ ለመፋ አፉፈሙትሞ ጎሶትን ገመ ክባቲን ቁበተን ከአኒ ሃዴመን። መለከትን አፉፈሙ ሱን መለቶ እሳን እቲን ቁበተ ኬሳ በአኒዸ። <verse eid="NUM 10:6"/><verse number="7" style="v" sid="NUM 10:7"/>ሀዋሰ ወልት ቀቡዻፍ መለከተ አፉፍ፤ ገሩ መለቶ ወል ፈካቱን ህንአፉፍን።<verse eid="NUM 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 10:8"/>“እልማን አሮን ሉቦትን መለከተወን ሰነ ሃአፉፈን። ኩንስ እስኒፊ ዸሎተ ዹፉፍ ሴረ በረ በራ ሃተኡ። <verse eid="NUM 10:8"/><verse number="9" style="v" sid="NUM 10:9"/>እስን ዮሙ ብየኬሰን ኬሰት ዲነ እስን ጩንቁርሱ ቶኮት ዱሉፍ ባተንት መለከተወን ሰነ አፉፋ። ዮስ <char style="nd">ዋቀዮ</char> ዋቅንኬሰን እስን ያደቴ ዲነኬሰን ጀላ እስን ባሰ። <verse eid="NUM 10:9"/><verse number="10" style="v" sid="NUM 10:10"/>አከሱመስ ጉያ ገመቹኬሰኒ ጄቹንስ ጋፈ አያነ ቤከማፊ አያነ ባቲ ሃራት ኣርሳኬሰን ከን ጉበሙፊ ኣርሳኬሰን ከን ነጋረት መለከተወን አፉፋ፤ ወን ኩንስ ፉለ ዋቀኬሰኒ ዱረት ያደኖ እስኒፍ ተአ። አን <char style="nd">ዋቀዮ</char> ዋቀኬሰን።”<verse eid="NUM 10:10"/></para>
  <para style="s1">እስራኤሎትን ሲናዻ በአን</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 10:11"/>ጅአ ለመፋ ወጋ ለመፋ ኬሰ ጉያ ድግደመፋት ዱሜስ ሱን ዱንካነ ዹገ በኡምሳራ ከኤ። <verse eid="NUM 10:11"/><verse number="12" style="v" sid="NUM 10:12"/>እስራኤሎንስ ገሞጂ ሲናቲ ከአኒ ሀመ ዱሜስ ሱን ገሞጂ ጳራኒ ኬሰ ቁበቱት እዶ ቶኮራ ገረ እዶ ብራት ዴመን። <verse eid="NUM 10:12"/><verse number="13" style="v" sid="NUM 10:13"/>እሳን ዬሮ ጀልቀባ ከነት አጀጀ <char style="nd">ዋቀዮ</char> ከራ ሙሴቲን ኬኔን ከአኒ ዴመን።<verse eid="NUM 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 10:14"/>ኩታን ቁበተ እጆሌ ይሁዳ ፋጂሳኒ ጀላን ጀልቀበት ዴመን። ነህሾን እልም አሚናዳብ አጀጃሳኒ ቱሬ። <verse eid="NUM 10:14"/><verse number="15" style="v" sid="NUM 10:15"/>ናትናኤል እልም ዙዋር አጀጃ ኩታ ጎሰ ይሳኮር ቱሬ፤ <verse eid="NUM 10:15"/><verse number="16" style="v" sid="NUM 10:16"/>ኤሊያብ እልም ሄሎን አጀጃ ኩታ ጎሰ ዜቡሎን ቱሬ። <verse eid="NUM 10:16"/><verse number="17" style="v" sid="NUM 10:17"/>ዱንካን ቁልቁሉን ሱንስ አቺ ቡቅፈሜ፤ አከሲን ጌርሾኖትኒፊ ሜራሮን ወር ዱንካነ ባተን ከአኒ ዴመን።<verse eid="NUM 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 10:18"/>ኩታን ቁበተ ሩቤንስ ፋጂሳኒ ጀላን እት ኣነኒ ዴመን። ኤሊዙር እልም ሼዴኡር አጀጃሳኒ ቱሬ። <verse eid="NUM 10:18"/><verse number="19" style="v" sid="NUM 10:19"/>ሽሉሚኤል እልም ዙሪሸዳይ አጀጃ ኩታ ጎሰ ስምኦን ቱሬ፤ <verse eid="NUM 10:19"/><verse number="20" style="v" sid="NUM 10:20"/>ኤልያሳፍ እልም ዴኡኤል አጀጃ ኩታ ጎሰ ጋድ ቱሬ። <verse eid="NUM 10:20"/><verse number="21" style="v" sid="NUM 10:21"/>ኤርገሲ ቆሃቶትን ምአ ቁልቁሉ ባተኒ ከአኒ ዴመን። ዱንካን ቁልቁሉን ሱንሞ ኡቱ እሳን አች ህንገእን ዻበሜ ቱሬ።<verse eid="NUM 10:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 10:22"/>ኩታን ቁበተ ኤፍሬምስ ፋጂሳኒ ጀላን እት ኣነኒ ዴመን። ኤሊሻማን እልም አሚሁድ አጀጃሳኒ ቱሬ። <verse eid="NUM 10:22"/><verse number="23" style="v" sid="NUM 10:23"/>ገማልኤል እልም ጴዳሱር አጀጃ ኩታ ጎሰ ምናሴ ቱሬ፤ <verse eid="NUM 10:23"/><verse number="24" style="v" sid="NUM 10:24"/>አቢዳን እልም ጋዴዮን አጀጃ ኩታ ጎሰ ቤንያም ቱሬ።<verse eid="NUM 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 10:25"/>ዹመረት ኩታን ቁበተ ዳን ኤግዱ ከራ ዱባ ከን ኩታወን ሁንዳ ተአኒ ፋጂሳኒ ጀላን ከአኒ ዴመን። አሂኤዜር እልም አሚሸዳይ አጀጃሳኒ ቱሬ። <verse eid="NUM 10:25"/><verse number="26" style="v" sid="NUM 10:26"/>ፈግኤል እልም ኦክራን አጀጃ ኩታ ጎሰ ኣሼር ቱሬ፤ <verse eid="NUM 10:26"/><verse number="27" style="v" sid="NUM 10:27"/>አሂራን እልም ኤናን አጀጃ ኩታ ጎሰ ንፍታሌም ቱሬ። <verse eid="NUM 10:27"/><verse number="28" style="v" sid="NUM 10:28"/>ኤጋ ኩታወን ሰበ እስራኤል ዮሙ ከአኒ ዴመንት ተርቲበ ከናን ሶቾአን።<verse eid="NUM 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 10:29"/>ኤርገሲ ሙሴን ሆባብ እልመ ሬኡኤል፣ ነምቸ ምድያን አባ ኒቲ ሙሴ ሰናን አከነ ጄዼ፤ “ኑ ብየ <char style="nd">ዋቀዮ</char>፣ ‘አን እስኒ ኬነ’ ኑን ጄዼ ሰነ ዸቁፍ ዴማ ጅረ። ኑ ዋን ጋሪ ሲፍ ጎናቲ ኮቱ ኑ ወጅን ዴም፤ <char style="nd">ዋቀዮ</char> ዋን ጋሪ እስራኤሎታፍ ከከቴራቲ።”<verse eid="NUM 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 10:30"/>እንሞ፣ “ለክ አን ህንዴሙ፤ አን ብዩመኮት ገረ ሰበኮት ነንዴብአ” ጄዼ ዴብሴ።<verse eid="NUM 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 10:31"/>ሙሴን ገሩ አከነ ጄዼን፤ “ማሎ ኑ ዺስቴ ህንዴምን። አት ገሞጂ ኬሰት እዶ ኑ ቁበትኑ ንቤክተ፤ እጀስ ኑ ተኡ ደንዴሰ። <verse eid="NUM 10:31"/><verse number="32" style="v" sid="NUM 10:32"/>ዮ አት ኑ ወጅን ዴምቴ ኑ ዋን ጋሪ <char style="nd">ዋቀዮ</char> ኑ ኬኑ ስ ወጅን ቆደትነ።”<verse eid="NUM 10:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 10:33"/>እሳን ቱሉ ዋቀዮራ ከአኒ ጉያ ሰዲ ዴመን። ታቦትን ከኩ <char style="nd">ዋቀዮስ</char> እዶ እሳን ቦቆተን እሳኒፍ በርባዱፍ ጄዼ ጉያ ሰደኑ እሳን ዱረ ዴሜ። <verse eid="NUM 10:33"/><verse number="34" style="v" sid="NUM 10:34"/>ዱሜስ <char style="nd">ዋቀዮ</char> ሱን ዬሮ እሳን ቁበተ ኬሳ በአን ጉያ ጉያ እሳንረ ቱሬ።<verse eid="NUM 10:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 10:35"/>ዬሮ ታቦትን ሱን ከኤ ዴሙ ሙሴን አከነ ጄዸ ቱሬ፤</para>
  <para style="q1" vid="NUM 10:35">“ያ <char style="nd">ዋቀዮ</char>፣ ከእ!</para>
  <para style="q2" vid="NUM 10:35">ዲኖትንኬ ሃብትኔፈመን፤</para>
  <para style="q2" vid="NUM 10:35">ወር ስ ጅበንስ ፉለኬ ዱራ ሃበቀተን።”<verse eid="NUM 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 10:36"/>ዬሮ እን ቦቆቹፍ ዹፉ አከነ ጄዸ ቱሬ፤</para>
  <para style="q1" vid="NUM 10:36">“ያ <char style="nd">ዋቀዮ</char>፣</para>
  <para style="q2" vid="NUM 10:36">ገረ ኩማተመ እስራኤል ሄዱት ዴብእ።”<verse eid="NUM 10:36"/></para>
  <chapter eid="NUM 10"/>
  <chapter number="11" style="c" sid="NUM 11"/>
  <para style="s1">እብደ <char style="nd">ዋቀዮ</char> ብራ ገድ ቡኤ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 11:1"/>ሰብን ሱን ኡቱመ <char style="nd">ዋቀዮ</char> እሰ ዸገኡ ዋኤ ረክነሳ ጉንጉሜ፤ እንስ ዮሙ ዋን ከነ ዸገኤት ንኣሬ። ከነረት እብድ <char style="nd">ዋቀዮ</char> እሳን ግዱት ቦበኤ ቀርቀረ ቁበተሳኒ ጉቤ። <verse eid="NUM 11:1"/><verse number="2" style="v" sid="NUM 11:2"/>ሰብን ሙሴት እዬ፤ ሙሴንሞ <char style="nd">ዋቀዮን</char> ከዸቴ እብድ ሱን ዻሜ። <verse eid="NUM 11:2"/><verse number="3" style="v" sid="NUM 11:3"/>ሰበቢ እብድ <char style="nd">ዋቀዮ</char> ብራ ገድ ቡኤ ግዱሳኒት ቦበኤፍ፣ እዶን ሱን “ተቤራ”<note caller="+" style="f"><char style="fr" closed="false">11፥3 </char><char style="fq" closed="false">ተቤራ </char><char style="ft" closed="false">ተቤራ ጄቹን </char><char style="fqa" closed="false">ቦበኡ </char><char style="ft" closed="false">ጄቹ።</char></note> ጄዸሜ ዋመሜ።<verse eid="NUM 11:3"/></para>
  <para style="s1">ድምብርቄ <char style="nd">ዋቀዮ</char> ኬኔ</para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 11:4"/>ሰብን ወል መካን እሳን ወጅን ቱሬስ ኛተ ብራ ዸረኤ፤ እስራኤሎን አመስ አከነ ጄዸኒ ቦኡ ጀልቀበን፤ “ኑ ኡቱ ፎን ኛትኑ አርገትኔ! <verse eid="NUM 11:4"/><verse number="5" style="v" sid="NUM 11:5"/>ኑ ብየ ግብጥ ኬሰት ቁርጡሚ ቶሉመ ኛትኔ፤ አከሱመስ ደባቁለ፣ ሀባቢ፣ ጎደሬ፣ ቁሉቢ ዲማፊ ቁሉቢ አዲ ኛትኔ ሰነ ንያደትነ። <verse eid="NUM 11:5"/><verse number="6" style="v" sid="NUM 11:6"/>አመ ገሩ ፌዺን ኛታ ኑራ በዴረ፤ መና ከነ መሌስ ዋን ቶኮሌ ህንአርግኑ!”<verse eid="NUM 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 11:7"/>መናን ሱን አከ ሰኚ ድንብላላ ተኤ ብፍትሳ ሀጴ ፈካተ ቱሬ። <verse eid="NUM 11:7"/><verse number="8" style="v" sid="NUM 11:8"/>ነሞትንስ መና ሰነ ነናነአኒ ወልት ቀበኒ ዸጋ ዳኩት ዳከቻ ዮካን ሞዬት ቱመቻ ቱረን። እሳንስ መና ሰነ ኦኮቴት አፌሉ ዮካን መጥኖሳ ቶልፈቱ ቱረን። እንስ አከ ዋን ዘይቲ ኤጄርሳቲን ቆጴፈሜት ምኣወ ቱሬ። <verse eid="NUM 11:8"/><verse number="9" style="v" sid="NUM 11:9"/>ገልገለ ዮሙ ፍጤንስ ቁበተረ ቡኤት መናን ሱንስ ገድ ቡኤ።<verse eid="NUM 11:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 11:10"/>ሙሴን ኡቱ ነሞትን ማቲ ሁንዳ በልበለ ዱንካነ ኦፊሳ ዱረት ቦአኑ ዸገኤ። <char style="nd">ዋቀዮስ</char> አከ መሌ ኣሬ፤ ሙሴንሞ ንዽጰቴ። <verse eid="NUM 11:10"/><verse number="11" style="v" sid="NUM 11:11"/>እንስ አከነ ጄዼ <char style="nd">ዋቀዮን</char> ጋፈቴ፤ “አት ማሊፍ ዽጵነ ከነ ገርብቸኬት ፍዴ? አት ከን በኣ ሰበ ከና ሁንደ ነረ ኬሴ አን ማል በሌሴ ስ ገድሲሴት? <verse eid="NUM 11:11"/><verse number="12" style="v" sid="NUM 11:12"/>ሰበ ከነ ሁንደ አነቱ ኡልፋኤ? አነቱ እሳን ደኤ? አት ማሊፍ አከ አን አኩመ ጉድፍቱን ዳእመ ባቱት ገረ ብየ አት አቦቲሳኒቲፍ ከኩዻን ዋዳ ገልቴት እሬኮት ባዼ እሳን ጌሱዻፍ ነ አጀጀ? <verse eid="NUM 11:12"/><verse number="13" style="v" sid="NUM 11:13"/>አን ሰበ ከነ ሁንዳፍ ፎን ኤሳን አርገዸ? እሳን፣ ‘ፎን ኛትኑ ኑ ኬን!’ ጄዸኒ ነት ቦኡ። <verse eid="NUM 11:13"/><verse number="14" style="v" sid="NUM 11:14"/>አን ኮጳኮ ሰበ ከነ ሁንደ ባቹ ህንደንደኡ፤ በኣን ኩን አከ መሌ ነት ኡልፋተ። <verse eid="NUM 11:14"/><verse number="15" style="v" sid="NUM 11:15"/>አት ዮ አከነ ነ ጎተ ተኤ፣ ዮ አን ፉለኬ ዱረት ፉዸተመ አርገዼ ጅራዼ፣ ማሎ አሙመ ነ አጄስ፤ አከ አን ግድራ ነት ዹፉ አርጉስ ነ ህንጎዽን።”<verse eid="NUM 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 11:16"/>
    <char style="nd">ዋቀዮስ</char> ሙሴዻን አከነ ጄዼ፤ “ማንጉዶተ እስራኤል ኬሳ ነመ ቶርባተመ ከኔን ሆገንቶታፊ ቆንዳልቶተ ሰባ ተኡሳኒ ቤክቱ ና ፍድ። አከ እሳን ገረ ዱንካነ ወል ገኢ ዹፈኒ ስ ወጅን አች ዸዻበተን ጎዽ። <verse eid="NUM 11:16"/><verse number="17" style="v" sid="NUM 11:17"/>አን ገድ ቡኤ አችት ስ ወጅን ነንዱበዸ፤ ሀፉረ ስረ ጅሩራስ ፉዼ እሳንረ ነንካአ፤ እሳንስ አከ አት ኮጳኬ በኣ ሰነ ህንባኔፍ በኣ ሰበ ሰና ስ ወጅን ባቱ።<verse eid="NUM 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 11:18"/>“ሰበ ከናን አከነ ጄዽ፦ ‘እስን ቦር ፎን ኛቱቲ ኦፍ ቁልቁሌሳ ቆጳኣ። <char style="nd">ዋቀዮ</char> ዬሮ እስን፣ “ኑ ኡቱ ፎኑመ ኛትኑ አርገትኔ! ዬሮ ኑ ብየ ግብጥ ኬሰ ጅሩ ኑ ወየ ቱሬ!” ጄተኒ ቦሰን ዸገኤራቲ። <char style="nd">ዋቀዮ</char> አመ ፎን እስኒ ኬነ፤ እስንስ ንኛቱ። <verse eid="NUM 11:18"/><verse number="19" style="v" sid="NUM 11:19"/>እስን ሀመ ጉያ ቶኮ፣ ዮካን ለማ፣ ዮካን ሸኒ፣ ኩዸኒ፣ ዮካን ድግደማ ቆፈ ህንኛተን፤ <verse eid="NUM 11:19"/><verse number="20" style="v" sid="NUM 11:20"/>ገሩ ጅአ ቶኮ ጉቱ ሀመ ፉኛኒን እስን በኡት፣ ሀመ ኑፍተንትስ ኛቱ፤ እስን <char style="nd">ዋቀዮ</char> ግዱኬሰን ጅሩ ሰነ ድደኒ፣ “ኑ ማሊፍ ብየ ግብጥ ኬሳ ባኔ?” ጄተኒ ፉለሳ ዱረት ቦሰኒ ቱርተኒቲ።’ ”<verse eid="NUM 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 11:21"/>ሙሴን ገሩ አከነ ጄዼ፤ “ኩኖ አን ነሞተ ለፎ ኩመ ዽበ ጀአ ግዱን ጅረ፤ አትሞ፣ ‘አን ፎን እሳን ጅአ ጉቱ ኛተን ኬናፍ!’ ጄተ። <verse eid="NUM 11:21"/><verse number="22" style="v" sid="NUM 11:22"/>ኡቱመ ቡሻዬፊ ከር ሎኒ እሳኒፍ ቀለመኒዩ ገኣ ላተ? ኡቱመ ቁርጡሚን ገላነ ኬሳ ሁንድሳኒ ቀበሜዩ ገኣ ላተ?”<verse eid="NUM 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 11:23"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ “ሀርክ <char style="nd">ዋቀዮ</char> ገባባዻ? አት አከ ወን አን ሲን ጄዹ ሲፍ ጉተሙፊ አከ ሲፍ ህንጉተምኔ አመ ንአርግተ።”<verse eid="NUM 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 11:24"/>ሙሴን ዸቄ ዋን <char style="nd">ዋቀዮ</char> ጄዼ ሰነ ሰበት ህሜ። እንስ ሰበ ሰነ ኬሳ ማንጉዶተ ቶርባተመ ወልት ቀቤ አከ እሳን ናኖ ዱንካና ዸዻበተን ጎዼ። <verse eid="NUM 11:24"/><verse number="25" style="v" sid="NUM 11:25"/>ኤርገሲስ <char style="nd">ዋቀዮ</char> ዱሜሳን ገድ ቡኤ እሰት ዱበቴ፤ ሀፉረ እሰረ ጅሩስ ፉዼ ማንጉዶተ ቶርባተመን ሰነረ ቡሴ። እሳንስ ዬሮ ሀፉር ሱን እሳንረ ቦቆቴት ራጂ ዱበተን፤ ኤርገሲሞ ዴብአኒ ራጂ ሰነ ህንዱበትኔ።<verse eid="NUM 11:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 11:26"/>ተኡሌ ነሞትን ለመ ከኔን መቃንሳኒ ኤልዳዲፊ ሜዳድ ጄዸመን ቁበተ ኬሰት ሀፈኒ ቱረን። እሳንስ ማንጉዶተ ሰነ ኬሰት ገልሜፈመኒ ቱረን መሌ ገድ በአኒ ገረ ዱንካና ህንዸቅኔ ቱሬ። ሀፉርሞ እሳንረሌ ቡኤ፤ እሳንስ ቁበተ ኬሰት ራጂ ዱበተን። <verse eid="NUM 11:26"/><verse number="27" style="v" sid="NUM 11:27"/>ደርገጌስ ቶኮ ፊጌ ዸቄ፣ “ኤልዳዲፊ ሜዳድ ራጂ ዱበቹት ጅሩ” ጄዼ ሙሴት ህሜ።<verse eid="NUM 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 11:28"/>እያሱን እልም ኑን ከን እጆሉማ ኦፊቲ ጀልቀቤ ገርጋርቱ ሙሴ ቱሬ ሱን ከኤ፣ “ያ ሙሴ፣ ያ ጎፍታኮ፣ እሳን ዾው!” ጄዼ ዱበቴ።<verse eid="NUM 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 11:29"/>ሙሴን ገሩ አከነ ጄዼ ዴብሴ፤ “አት አናፍ ህናፍታ? አን ኡቱ ሰብን <char style="nd">ዋቀዮ</char> ሁንድኑ ራጆተ ተአኒ <char style="nd">ዋቀዮስ</char> ሀፉረሳ እሳንረ ካኤ ነንሀወ!” <verse eid="NUM 11:29"/><verse number="30" style="v" sid="NUM 11:30"/>ኤርገሲስ ሙሴፊ ማንጉዶትን እስራኤል ገረ ቁበታት ዴብአን።<verse eid="NUM 11:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 11:31"/>ቡቤን ቶኮስ <char style="nd">ዋቀዮ</char> ብራ በኤ ገላነ ኬሳ ድምብርቄ ገረ ቁበታት ኦፌ። ቡቤን ሱንስ ድምብርቄ ሰነ ናኖ ቁበተ ሰናት ገመ ሁንዳን ሀመ ዴምሰ ጉያ ቶኮ ፈጋቱ ሀርጫሴ ሀመ ዹንዹመ ለማ ኦል ቱሌ። <verse eid="NUM 11:31"/><verse number="32" style="v" sid="NUM 11:32"/>ጉያ ሰነ ጉቱፊ ሀልከን ሰነ ጉቱ፣ ጉያ እት ኣኑ ጉቱስ ሰብን ሱን ገድ በኤ ድምብርቄ ሰነ ወልት ቀበቴ፤ እሳን ኬሳስ ነምን ሆሜሪ ኩዸኒ ገድ ወልት ቀበቴ ህንቱሬ። ኤርገሲ ድምብርቄ ሰነ ናኖ ቁበተ ሰና አፈተን። <verse eid="NUM 11:32"/><verse number="33" style="v" sid="NUM 11:33"/>ገሩ ኡቱመ ፎን ሱን አመሌ ግዱ እልካንሳኒ ጅሩ፣ ኡቱ ህንአለንፈትን <char style="nd">ዋቀዮ</char> እሳንት ኣሬ ዸእቸ ሀማዻን እሳን ዸኤ። <verse eid="NUM 11:33"/><verse number="34" style="v" sid="NUM 11:34"/>ሰበቢ እሳን ነሞተ ኛተ ብራ ዸረአን አችት አዋለኒፍ መቃን እዶ ሰና፣ “ቂብሮት ሃታአባ”<note caller="+" style="f"><char style="fr" closed="false">11፥34 </char><char style="fq" closed="false">ቂብሮት ሃታአባ </char><char style="ft" closed="false">ጄቹን </char><char style="fqa" closed="false">አዋለ ዸራቶታ </char><char style="ft" closed="false">ጄቹዸ።</char></note> ጄዸሜ።<verse eid="NUM 11:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 11:35"/>ሰብን ሱንስ ቂብሮት ሃታአባዻ ከኤ ገረ ሀጤሮት ዸቄ አች ጅራቴ።<verse eid="NUM 11:35"/></para>
  <chapter eid="NUM 11"/>
  <chapter number="12" style="c" sid="NUM 12"/>
  <para style="s1">ማርያሚፊ አሮን ሙሴዻን ሞርመን</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 12:1"/>ሚርያሚፊ አሮን ሰበቢ ሙሴን ዱበርቲ እቶጵያ ፉዼፍ እሳን ሞርሙዻን ዱበቹ ጀልቀበን፤ እን ዱበርቲ እቶጵያ ፉዼ ቱሬቲ። <verse eid="NUM 12:1"/><verse number="2" style="v" sid="NUM 12:2"/>እሳንስ፣ “<char style="nd">ዋቀዮ</char> ከራ ሙሴ ቆፋን ዱበቴ? እን ከራኬኛንስ ዱበቴ ቱሬ ምቲ?” ጄዸን። <char style="nd">ዋቀዮስ</char> ዱቢ ከነ ዸገኤ።<verse eid="NUM 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 12:3"/>ሙሴን ነሞተ ለፈረ ጅራተን ሁንደ ጫላ ነመ አከ መሌ ገድ ኦፍ ቀቡ ቱሬ።<verse eid="NUM 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 12:4"/>
    <char style="nd">ዋቀዮስ</char> ዮሙሱመ ሙሴን፣ አሮኒፊ ሚርያሚን፣ “እስን ሰደኑ ገረ ዱንካነ ወል ገኢት ገድ በኣ” ጄዼ። እሳን ሰደኑስ ገድ በአን። <verse eid="NUM 12:4"/><verse number="5" style="v" sid="NUM 12:5"/>ኤርገሲ <char style="nd">ዋቀዮ</char> ኡቱባ ዱሜሳ ኬሳን ገድ ቡኤ በልበለ ዱንካናረ ዻበቴ አሮኒፊ ሚርያምን ዋሜ። ጀር ለቹ እሰት ዽኣናን፣ <verse eid="NUM 12:5"/><verse number="6" style="v" sid="NUM 12:6"/>እን አከነ ጄዼን፤ “ዱቢኮ ዸገኣ፦</para>
  <para style="q1" vid="NUM 12:6">“ዮ ራጂን <char style="nd">ዋቀዮ</char> ግዱኬሰን ጅራቴ፣</para>
  <para style="q2" vid="NUM 12:6">አን ሙልአተ ኬሰ እሰት ኦፍ ነንሙልእሰ፤</para>
  <para style="q2" vid="NUM 12:6">አብጁዻንስ እሰት ነንዱበዸ።<verse eid="NUM 12:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="NUM 12:7"/>ገሩ ገርብችኮ ሙሴን አከነ ምት፤</para>
  <para style="q2" vid="NUM 12:7">እን መነኮ ሁንደ ኬሰት አመነማዸ።<verse eid="NUM 12:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 12:8"/>አን ኡቱ ዾክሳዻን ህንተእን፣</para>
  <para style="q2" vid="NUM 12:8">እፋን እፈት እሰት ነንዱበዸ፤</para>
  <para style="q2" vid="NUM 12:8">እን ብፈ <char style="nd">ዋቀዮ</char> ንአርገ።</para>
  <para style="q1" vid="NUM 12:8">ዮስ እስን ማሊፍ</para>
  <para style="q2" vid="NUM 12:8">ገርብቸኮ ሙሴዻን ሞርሙዻን ዱበቹ ህንሶዳትኔሬ?”<verse eid="NUM 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 12:9"/>ኣሪን <char style="nd">ዋቀዮስ</char> እሳንረት ቦበኤ፤ እንስ እሳን ዺሴ ዴሜ።<verse eid="NUM 12:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 12:10"/>ዮሙ ዱሜስ ሱን ዱንካነ ጉባዻ ኦል ከኤት ኩኖ፣ ሚርያም ለምጦፍቴ አኩመ ጨቢ አዳቴ ቱርቴ። አሮንስ ገረሼት ገረገሌ አከ እሼን ለምጢ ቀብዱ አርጌ፤ <verse eid="NUM 12:10"/><verse number="11" style="v" sid="NUM 12:11"/>እንስ ሙሴዻን አከነ ጄዼ፤ “ማሎ ያ ጎፍታኮ፣ ጩቡ ኑ ጎዉማዻን ሆጄትኔ ሰነ ኑት ህንለካእን። <verse eid="NUM 12:11"/><verse number="12" style="v" sid="NUM 12:12"/>አከ ገተተ ፎንሳ ገሪን ኛተሜ ገደሜሰ ሃዸሳ ኬሳ በኡ ቶኮ እሼ ህንጎዽን።”<verse eid="NUM 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 12:13"/>ሙሴን <char style="nd">ዋቀዮት</char> ቦኤ፣ “ያ <char style="nd">ዋቀዮ</char>፣ ማሎ እሼ ፈይስ!” ጄዼ።<verse eid="NUM 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 12:14"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዼ ሙሴዻፍ ዴቢ ኬኔ፤ “ኡቱ አባንሼ ፉለሼት ቱፌ ስላ እሼን ቡልቲ ቶርበ ሰልጵነ ኬሰ ቱርት ምቲሬ? እሼን ቡልቲ ቶርበ ቁበታን አለ ሃቱርቱ፤ ኤርገሲ ዴብቴ ዹፉ ደንዴስ።” <verse eid="NUM 12:14"/><verse number="15" style="v" sid="NUM 12:15"/>ሚርያም ቡልቲ ቶርበ ቁበታን አለ ቱርቴ፤ ሰብን ሱንስ ሀመ እሼን ዴብቱት ዴምሰ እት ህንፉፍኔ።<verse eid="NUM 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 12:16"/>ኤርገሲ ሰብን ሱን ሀጤሮቲ ከኤ ገሞጂ ጳራን ኬሰ ቁበቴ።<verse eid="NUM 12:16"/></para>
  <chapter eid="NUM 12"/>
  <chapter number="13" style="c" sid="NUM 13"/>
  <para style="s1">በሳስቶትን ገረ ከነኣንት ኤርገመን</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 13:1"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ <verse eid="NUM 13:1"/><verse number="2" style="v" sid="NUM 13:2"/>“አከ እሳን ዸቀኒ ብየ ከነኣን እሼ አን እስራኤሎታፍ ኬኑፍ ጅሩ ሰነ በሳሰኒፍ ነሞተ ኤርግ። ቶኮ ቶኮ አቦቲ ጎሳ ኬሳ ሆገና ቶኮ ኤርግ።”<verse eid="NUM 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 13:3"/>ሙሴን አጀጀ <char style="nd">ዋቀዮቲን</char> ገሞጂ ጳራን ኬሳ እሳን ኤርጌ። ሁንድሳኒ ሆገንቶተ እስራኤሎታ ቱረን።<verse eid="NUM 13:3"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="4" style="v" sid="NUM 13:4"/>መቃንሳኒ ከኔኒዸ፦</para>
  <para style="b" vid="NUM 13:4"/>
  <para style="li1" vid="NUM 13:4">ጎሰ ሩቤን ኬሳ ሸሙኣ እልመ ዘኩር፤<verse eid="NUM 13:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="NUM 13:5"/>ጎሰ ስምኦን ኬሳ ሻፋጥ እልመ ሆሪ፤<verse eid="NUM 13:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="NUM 13:6"/>ጎሰ ይሁዳ ኬሳ ካሌብ እልመ ዬፉኔ፤<verse eid="NUM 13:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="NUM 13:7"/>ጎሰ ይሳኮር ኬሳ ይግኣል እልመ ዮሴፍ፤<verse eid="NUM 13:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="NUM 13:8"/>ጎሰ ኤፍሬም ኬሳ ሆሼኣ እልመ ኑን፤<verse eid="NUM 13:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="NUM 13:9"/>ጎሰ ቤንያም ኬሳ ጳልቲ እልመ ራጱ፤<verse eid="NUM 13:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="NUM 13:10"/>ጎሰ ዜቡሎን ኬሳ ገዲኤል እልመ ሶዲ፤<verse eid="NUM 13:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="NUM 13:11"/>ጎሰ ምናሴ ጄቹንስ ጎሰ ዮሴፍ ኬሳ ገዲ እልመ ሱስ፤<verse eid="NUM 13:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="NUM 13:12"/>ጎሰ ዳን ኬሳ አሚኤል እልመ ጌማል፤<verse eid="NUM 13:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="NUM 13:13"/>ጎሰ ኣሼር ኬሳ ሴጡር እልመ ሚካኤል፤<verse eid="NUM 13:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="NUM 13:14"/>ጎሰ ንፍታሌም ኬሳ ናህቢ እልመ ዎፍሲ፤<verse eid="NUM 13:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="NUM 13:15"/>ጎሰ ጋድ ኬሳ ጌኡኤል እልመ ማኪት።<verse eid="NUM 13:15"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="16" style="v" sid="NUM 13:16"/>ኤጋ መቃወን ኩኔን መቃወን ነሞተ አከ እሳን ብየ ሰነ በሳሰኒፍ ጄዼ ሙሴን ኤርጌዸ። ሙሴንስ ሆሼኣ እልመ ኑን ሰነ፣ “እያሱ” ጄዼ ሞጋሴ።<verse eid="NUM 13:16"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="17" style="v" sid="NUM 13:17"/>ሙሴን ዮሙ አከ እሳን ብየ ከነኣኒ በሳሰኒፍ እሳን ኤርጌት አከነ ጄዼን፤ “ከራ ኔጌብ ደርባቲ ገረ ብየ ጋራት ኦል በኣ። <verse eid="NUM 13:17"/><verse number="18" style="v" sid="NUM 13:18"/>ብይ ሱን ማል አከ ፈካቱ፣ ነሞትን አች ጅራተንስ ጀጀቦ ዮካን ደዸቦ፣ ሙራሰ ዮካን ሄዱ ተኡሳኒ እላላ። <verse eid="NUM 13:18"/><verse number="19" style="v" sid="NUM 13:19"/>እሳን ብየ አከሚ ኬሰ ጅራቱ? ጋሪ ዮካን ገዼ? መጋላወን አከሚ ኬሰ ጅራቱ? ደላ ዸጋ ህንቀበንሞ ደኦ ጀባ ቀቡ? <verse eid="NUM 13:19"/><verse number="20" style="v" sid="NUM 13:20"/>ለፍትሳ ገበታዸሞ ገበታ ምት? ሙከ ቀበሞ ህንቀቡ። ጀባዻቲ እጀ ብየቲ ኬሳ ሙራሰ ፍዳ።” ወቅቲን ሱን ዬሮ እጅ ወይኒ ከን ጀልቀባ እት ብልቻቱ ቱሬ።<verse eid="NUM 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 13:21"/>እሳን ኦል በአኒ ገሞጂ ሲንራ ጀልቀበኒ ሀመ ሬሆብት ገረ ሌቦ ሀማትት ብየቲ በሳሰን። <verse eid="NUM 13:21"/><verse number="22" style="v" sid="NUM 13:22"/>እሳንስ ከራ ኔጌብ ኦል በአኒ ገረ ኬብሮን ለፈ አሂመን፣ ሼሻዪፊ ተልማይ እልማን አናቅ ሱን ጅራተኒት ዹፈን። ኬብሮን ኩንስ ኡቱ ዞኣን እሼን ብየ ግብጥ ሱን ህንእጃረምን ወጋ ቶርባን ዱረ እጃረምቴ። <verse eid="NUM 13:22"/><verse number="23" style="v" sid="NUM 13:23"/>እሳንስ ዮሙ ሱሉለ ኤሽኮል ገአንት ሁርቡ እጀ ወይኒ ቶኮ ኩተን። ወይኒ ሰነስ ሮማኒፊ ሀርቡ ወጅን ነመ ለመ ተአኒ ደንቀራዻን ባተን። <verse eid="NUM 13:23"/><verse number="24" style="v" sid="NUM 13:24"/>እዶን ሱን ሰበቢ ሁርቡ እጀ ወይኒ ከን ወር እስራኤል ኩተን ሰናቲፍ ሱሉለ ኤሽኮል ጄዸሜ። <verse eid="NUM 13:24"/><verse number="25" style="v" sid="NUM 13:25"/>ጀርስ ዹመ ቡልቲ አፉርተማት ብየ ሰነ በሳሰኒ ዴብአን።<verse eid="NUM 13:25"/></para>
  <para style="s1">ገባሰ በሳስቶትን ፍደን</para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 13:26"/>እሳንስ ገረ ቃዴሽ እሼ ገሞጂ ጳራን ኬሳ ገረ ሙሴፊ አሮን፣ ገረ ወልዳ እስራኤል ጉቱ ዴብአኒ ዹፈን። አችትስ ገባሰ እሳኒፍ ዽኤሰን፤ እጀ ብየቲስ እሳን አርግሲሰን። <verse eid="NUM 13:26"/><verse number="27" style="v" sid="NUM 13:27"/>እሳንስ አከነ ጄዸኒ ሙሴት ህመን፦ “ኑ ገረ ብየ አት እት ኑ ኤርግቴ ሰና ዸቅኔረ፤ ብየቲን ኣነኒፊ ደመ ባፍት! እጅሼስ ኩኖ ከነ። <verse eid="NUM 13:27"/><verse number="28" style="v" sid="NUM 13:28"/>ገሩ ነሞትን አች ጅራተን ጀጀቦዸ፤ መጋላወንሼ ደላ ጀባ ቀቡ፤ ጉርጉዳ ዸስ። ኑ ሰኚ አናቅዩ አችት አርግኔረ። <verse eid="NUM 13:28"/><verse number="29" style="v" sid="NUM 13:29"/>አማሌቆትን ኔጌብ ኬሰ ጅራቱ፤ ሄቶትን፣ ዬቡሶትኒፊ አሞሮትን ብየ ጋራ ኬሰ ጅራቱ፤ ከነኣኖትንሞ ገላነ ብራፊ ቀርቀረ ዮርዳኖስ ጅራቱ።”<verse eid="NUM 13:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 13:30"/>ካሌብስ ፉለ ሙሴ ዱረት ሰበ ጨልእሲሴ፣ “ኑ ደፍኔ ኦል ባኔ ብየቲ ሃዻሉ፤ ሞአቹ ንደንዴኛቲ” ጄዼ።<verse eid="NUM 13:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 13:31"/>ነሞትን እሰ ወጅን ኦል በአኒ ቱረን ገሩ፣ “ኑ ወረ ሰነ ዸኡ ህንደንዴኙ፤ እሳን ኑረ ጀጀቦዸ” ጄዸን። <verse eid="NUM 13:31"/><verse number="32" style="v" sid="NUM 13:32"/>እሳንስ ዋኤ ብየ በሳሰን ሰና ሰበ እስራኤል ግዱት ኦዱ ገዼ ተምሳሰን። አከነስ ጄዸን፤ “ብይ ኑ በሳስኔ ሱን ብየ ወረ እሼ ኬሰ ጅራቱዩ ኛቱዸ። ነሞትን ኑ አችት አርግኔ ሁንድኑ ዼዼሮዸ። <verse eid="NUM 13:32"/><verse number="33" style="v" sid="NUM 13:33"/>አችት ኔፊሊሞተ አርግኔ፤ እልማን አናቅ ኔፊሊሞተራ ዹፈን። ኑ ኦፉመኬኘትዩ ኮሮጵሰ ፈካትኔ፤ ፉለሳኒ ዱረትስ አከሱመ ታኔ።”<verse eid="NUM 13:33"/></para>
  <chapter eid="NUM 13"/>
  <chapter number="14" style="c" sid="NUM 14"/>
  <para style="s1">ሰብን ፍንጭሉሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 14:1"/>ሀልከን ሰነ ነሞትን ወልዳ ሰና ሁንድኑ ሰገሌሳኒ ኦል ፉዸተኒ ቦአን። <verse eid="NUM 14:1"/><verse number="2" style="v" sid="NUM 14:2"/>እስራኤሎን ሁንድኑ ሙሴፊ አሮንት ጉንጉመን፤ ወልዳን ጉቱንስ አከነ እሳኒን ጄዼ፤ “ኑ ኡቱ ብዩመ ግብጥት ዹምኔ ጅራትኔ! ዮካን ኡቱ ገሞጂ ከነ ኬሰት ዹምኔ ጅራትኔ! <verse eid="NUM 14:2"/><verse number="3" style="v" sid="NUM 14:3"/><char style="nd">ዋቀዮ</char> ማሊፍ አከ ኑ ጎራዴዻን ዹምኑፍ ጄዼ ብየ ከነት ኑ ፍደ? ኒቶትንኬኛፊ እጆሌንኬኘ ንቦጅአሙ። ብየ ግብጥት ዴብኡን ኑ ህንወዩ?” <verse eid="NUM 14:3"/><verse number="4" style="v" sid="NUM 14:4"/>እሳንስ፣ “አመ ሆገና ፍለትኔ ብየ ግብጥት ሃዴብኑ” ወሊን ጄዸን።<verse eid="NUM 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 14:5"/>ከነረት ሙሴፊ አሮን ፉለ ጉቱማ ያኢ እስራኤል ከኔን አችት ወልት ቀበመኒ ዱረት አዳን ለፈት ጎምብፈመን። <verse eid="NUM 14:5"/><verse number="6" style="v" sid="NUM 14:6"/>ጀሬን ብየቲ ኬሰ ዴመኒ በሳሰን ኬሳ እያሱን እልም ኑኒቲፊ ካሌብ እልም ዬፉኔ ኡፈተ ኦፊ ተርሳሰኒ፣ <verse eid="NUM 14:6"/><verse number="7" style="v" sid="NUM 14:7"/>ጉቱማ ያኢ እስራኤሎታቲን አከነ ጄዸን፤ “ብይ ኑ ኬሰ ዴምኔ በሳስኔ ሱን አከ መሌ ጋሪዸ። <verse eid="NUM 14:7"/><verse number="8" style="v" sid="NUM 14:8"/><char style="nd">ዋቀዮ</char> ዮ ኑት ገመዴ ብየ ሰነት ኑ ገልቼ ብየቲ ኣነኒፊ ደመ ባፍቱ ሰነ ኑ ኬነ። <verse eid="NUM 14:8"/><verse number="9" style="v" sid="NUM 14:9"/>እስን ገሩ <char style="nd">ዋቀዮት</char> ህንፍንጭልና። ዋን ኑ እሳን ልልቅምስኑፍ ነሞተ ብየ ሰና ህንሶዳትና። ጋድስን እሳንራ ከኤረ፤ <char style="nd">ዋቀዮ</char> ኑ ወጅን ጅረ። እሳን ህንሶዳትና።”<verse eid="NUM 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 14:10"/>ወልዳን ጉቱን ገሩ ዸጋን እሳን ቱሙዻፍ መርአቴ። ኡልፍን <char style="nd">ዋቀዮስ</char> ፉለ ዱንካነ ወል ገኢ ዱረት እስራኤሎተ ሁንደት ሙልአቴ። <verse eid="NUM 14:10"/><verse number="11" style="v" sid="NUM 14:11"/><char style="nd">ዋቀዮስ</char> ሙሴዻን አከነ ጄዼ፤ “ሰብን ኩን ሀመ ዮሚት አከነ ነ ቱፈተ? ኡቱመ አን መለቶወን ከኔን ሁንደ ግዱሳኒት ሆጄዹ እሳን ሀመ ዮሚት ነ አመኑ ድዱ? <verse eid="NUM 14:11"/><verse number="12" style="v" sid="NUM 14:12"/>አን ጎልፋዻን ዸኤ እሳን ነንበሌሰ፤ ስእ ገሩ ሰበ እሳን ጫላ ጉዳፊ ጀባ ስን ጎዸ።”<verse eid="NUM 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 14:13"/>ሙሴን <char style="nd">ዋቀዮን</char> አከነ ጄዼ፤ “ወር ግብጥ ዋኤ ዋን ከና ንዸገኡ! አት ሁምነኬቲን ሰበ ከነ ግዱሳኒቲ ባፍቴ ፍዴርታቲ። <verse eid="NUM 14:13"/><verse number="14" style="v" sid="NUM 14:14"/>እሳንስ ዋኤ ዋን ከና ሰበ ብየ ሰነ ኬሰ ጅራቱት ንኦዴሱ። ያ <char style="nd">ዋቀዮ</char>፣ እሳን አከ አት ሰበ ከነ ግዱ ጅርቱ ዸገአኒሩ፤ ያ <char style="nd">ዋቀዮ</char> እሳን አከ አት ፉሉመ እሳኒት ሙልአቱ፣ አከ ዱሜስኬ እሳኒን ኦል ጅሩፊ አከ አት ጉያ ኡቱባ ዱሜሳቲን፣ ሀልከንሞ ኡቱባ እብዳቲን እሳን ዱረ ዴምቱ ዸገአኒ ጅሩ። <verse eid="NUM 14:14"/><verse number="15" style="v" sid="NUM 14:15"/>ዮ አት ሰበ ከነ ዬሩመ ቶኮት በርበዴስቴ፣ ሰቦትን ኦዱ ዋኤኬቲ ዸገአን፣ <verse eid="NUM 14:15"/><verse number="16" style="v" sid="NUM 14:16"/>‘<char style="nd">ዋቀዮ</char> ብየ ከኩዻን ዋዳ እሳኒፍ ገሌ ሰነት ሰበ ከነ ገልቹ ህንደንዴኜ፤ እን ከኑማፍ ገሞጂ ኬሰት እሳን ጎጎረኤ’ ጄዹ።<verse eid="NUM 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 14:17"/>“ኤጋ አኩመ አት አከነ ጄቴ ዱበቴ ሰነት ጀብን ጎፍታ ሃአርግሲፈሙ፦ <verse eid="NUM 14:17"/><verse number="18" style="v" sid="NUM 14:18"/>‘<char style="nd">ዋቀዮ</char> ደፌ ህንኣሩ፤ ጃለልሳሞ ጉዳዸ፤ እን ጩቡፊ ፍንጭለ ነማፍ ዺሰ። ተኡሌ እን ነመ የከ ሆጄቱ አደቡ መሌ ህንዺሱ፤ እን ሀመ ዸሎተ ሰደፋፊ አፉረፋት ሰበቢ ጩቡ አቦቲሳኒቲፍ ጄዼ እጆሌ ንአደበ።’ <verse eid="NUM 14:18"/><verse number="19" style="v" sid="NUM 14:19"/>አኩመ ዬሮ እሳን ብየ ግብጢ በአኒ ጀልቀብዴ ሀመ አማት ዺፈመ እሳኒፍ ጎቴ ሰነ አኩመ ጃለለኬ ጉዳ ሰናት ጩቡ ሰበ ከና ዺሲፍ።”<verse eid="NUM 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 14:20"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዼ ዴብሴፍ፤ “አን አኩመ አት ከዸቴ ሰነ እሳኒፍ ዺሴረ። <verse eid="NUM 14:20"/><verse number="21" style="v" sid="NUM 14:21"/>ተኡሌ አኩመ አን ዹጉማን ጅራታ ተኤፊ አኩመ ኡልፍን <char style="nd">ዋቀዮ</char> ዹጉማን ለፈ ሁንደ ጉቴ ሰነ፣ <verse eid="NUM 14:21"/><verse number="22" style="v" sid="NUM 14:22"/>ነሞተ ኡልፍነኮ አርገኒ፣ መለቶወን አን ብየ ግብጢቲፊ ገሞጂ ኬሰት ሆጄዼ አርገኒ ገሩ ና አጀጀሙ ድደኒ ዬሮ ኩዸን ነ ቆረን ሰነ ኬሳ ነምን ቶኮዩ፣ <verse eid="NUM 14:22"/><verse number="23" style="v" sid="NUM 14:23"/>ቶኮንሳኒ ብየ አን ከኩዻን አቦቲሳኒቲፍ ዋዳ ገሌ ሰነ ህንአርገን። ነምን ነ ቱፈቴ ቶኮ ብየ ሰነ ህንአርጉ። <verse eid="NUM 14:23"/><verse number="24" style="v" sid="NUM 14:24"/>ገርብቸኮ ካሌብ ገሩ ሰበቢ እን ሀፉረ አዳ ቀቡፊ ሰበቢ ገራ ጉቱዻን ነ ዱካ ቡኣ ጅሩፍ፣ አን ብየ እን ዸቄ ሰነት እሰ ገልቸ፤ ሰኚንሳስ ብየ ሰነ ንዻለ። <verse eid="NUM 14:24"/><verse number="25" style="v" sid="NUM 14:25"/>ሰበቢ አማሌቆትኒፊ ከነኣኖትን ሱሉሎተ ኬሰ ጅራተኒፍ፣ እስን ቦር ዴብኣቲ ከራ ገላነ ዲማቲን ገሞጂት ቀጄላ።”<verse eid="NUM 14:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 14:26"/>
    <char style="nd">ዋቀዮ</char> ሙሴፊ አሮኒን አከነ ጄዼ፦ <verse eid="NUM 14:26"/><verse number="27" style="v" sid="NUM 14:27"/>“ወልዳን ሀማን ኩን ሀመ ዮሚት ነት ጉንጉመ? አን ጉንጉሚ እስራኤሎተ ጉንጉምቶተ ሰና ዸገኤረ። <verse eid="NUM 14:27"/><verse number="28" style="v" sid="NUM 14:28"/>አከነ ጄዺ እሳንት ህም፤ ‘<char style="nd">ዋቀዮ</char> አከነ ጄዸ፤ አን ጅራታዻቲ፣ አኩመ እስን ጉረኮት ዱበተን ሰነ አንስ እስንት ጎዸ፦ <verse eid="NUM 14:28"/><verse number="29" style="v" sid="NUM 14:29"/>ሬፍኬሰን ጄቹንስ ሬፍ ወረ ኡሙሪንሳኒ ወጋ ድግደማፊ ድግደማ ኦሊ ከኔን ለኮብሰ ኡመታ ኬሰት ለካአመኒ ነት ጉንጉመን ሁንዳ ገሞጂ ከነ ኬሰት ሀርጨኤ ሀፈ። <verse eid="NUM 14:29"/><verse number="30" style="v" sid="NUM 14:30"/>ካሌብ እልመ ዬፉኔቲፊ እያሱ እልመ ኑን መሌ ቶኮንኬሰንዩ ብየ አን ኬሰ እስን ቁበቺሱፍ ከከዼ ሰነት ህንገልተን። <verse eid="NUM 14:30"/><verse number="31" style="v" sid="NUM 14:31"/>አን ገሩ እጆሌኬሰን ወረ እስን ንቦጅአሙ ጄተን ሰነ እት ነንገልቸ፤ እሳንስ ብየ እስን ቱፈተን ሰነ ንቤኩ። <verse eid="NUM 14:31"/><verse number="32" style="v" sid="NUM 14:32"/>እስን ገሩ፣ ሬፍኬሰን ገሞጁመ ከነ ኬሰት ሀርጨአ። <verse eid="NUM 14:32"/><verse number="33" style="v" sid="NUM 14:33"/>እጆሌንኬሰን ወጋ አፉርተመ ገሞጂ ከነ ኬሰ ንጆሩ፤ ሀመ እስን ሁንድ ገሞጂ ኬሰት ዹምተንት እሳን ሰበቢ አመነሙማ ዸቡኬሰኒቲፍ አችት ረከቱ። <verse eid="NUM 14:33"/><verse number="34" style="v" sid="NUM 14:34"/>እስን አኩመ ቡልቲ አፉርተመ ብየ ሰነ በሳስተን፣ አከሱመ ቡልቲን ቶኮ አከ ወጋ ቶኮት ለካአሜ ወጋ አፉርተመ ጩቡኬሰኒፍ ዽጰቱ፤ ዬሮ ሰነ እስን አከ አን እስኒን ሞርሙ ንቤክቱ።’ <verse eid="NUM 14:34"/><verse number="35" style="v" sid="NUM 14:35"/>አን <char style="nd">ዋቀዮ</char> ዋን ከነ ዱበዼን ጅረ፤ አን ዹጉማን ዋን ከነ ወልዳ ሀማ ናን ሞርሙፍ ወልት ጉርማኤ ከነ ጉቱት ነንፍደ። እሳን ገሞጂ ከነ ኬሰት ዹሙ፤ አሱመትስ ንዱኡ።”<verse eid="NUM 14:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 14:36"/>ነሞትን ሙሴን አከ እሳን ብየቲ በሳሰኒፍ ኤርጌ ዮሙ አቺ ዴብአንት ዋኤ ብየ ሰና ገባሰ ሀማ ወልዳት ገባሰኒ አከ ወልዳን ሙሴት ጉንጉሙ ጎዸን ጄቹንስ <verse eid="NUM 14:36"/><verse number="37" style="v" sid="NUM 14:37"/>ነሞትን ዋኤ ብየቲ ገባሰ ሀማ ገባሱት ጋፈተመን ሱን ዸእቻን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዹመን። <verse eid="NUM 14:37"/><verse number="38" style="v" sid="NUM 14:38"/>ነሞተ ብየቲ በሳሱ ዸቀን ኬሳ እያሱ እልመ ኑንቲፊ ካሌብ እልመ ዬፉኔ ቆፈቱ ዱአ ኦሌ።<verse eid="NUM 14:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 14:39"/>ሙሴን ዋን ከነ ሁንደ እስራኤሎተት ህምናን እሳን አከ መሌ ቦአን። <verse eid="NUM 14:39"/><verse number="40" style="v" sid="NUM 14:40"/>እሳንስ ጉያ እት ኣኑ ገነማን ፊጤ ብየ ጋራት ኦል በአኒ፣ “ኑ ጩቡ ሆጄትኔረ፤ ኑ አመ ገረ ለፈ <char style="nd">ዋቀዮ</char> ዋዳ ኑ ገሌ ሰና ዸቅነ” ጄዸን።<verse eid="NUM 14:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 14:41"/>ሙሴን ገሩ አከነ ጄዼ፤ “እስን ማሊፍ አጀጀ <char style="nd">ዋቀዮ</char> ጨብስቱ? ወን ኩን እስኒፍ ህንምልካኡ! <verse eid="NUM 14:41"/><verse number="42" style="v" sid="NUM 14:42"/>አከ ዲኖተኬሰኒን ህንሞአተምኔፍ ኦል ህንበእና፤ <char style="nd">ዋቀዮ</char> እስን ወጅን ህንጅሩቲ፤ <verse eid="NUM 14:42"/><verse number="43" style="v" sid="NUM 14:43"/>አማሌቆትኒፊ ከነኣኖትን አችት እስንት ዹፉቲ። ሰበቢ እስን ዋቀዮራ ገረገልተኒፍ እን እስን ወጅን ህንጅራቱ፤ ጎራዴዻን በርበዴፈምቱ።”<verse eid="NUM 14:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 14:44"/>እሳን ገሩ ኡቱ ሙሴፊ ታቦትን ከኩ <char style="nd">ዋቀዮ</char> ቁበተ ኬሳ ገድ ህንበእን ያዱመሳኒቲን ከአኒ ፊጤ ብየ ጋራት ኦል በአን። <verse eid="NUM 14:44"/><verse number="45" style="v" sid="NUM 14:45"/>ዮሙስ አማሌቆትኒፊ ከነኣኖትን ጋረ ሰነረ ጅራተን ገድ ቡአኒ እሳን ዸአኒ ሀመ ሆርማት እሳን አርአን።<verse eid="NUM 14:45"/></para>
  <chapter eid="NUM 14"/>
  <chapter number="15" style="c" sid="NUM 15"/>
  <para style="s1">ኣርሳ ደበለማ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 15:1"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ <verse eid="NUM 15:1"/><verse number="2" style="v" sid="NUM 15:2"/>“ሰበ እስራኤልት አከነ ጄዺ ዱበዹ፦ ‘ዮሙ ብየ አን አከ እስን ኬሰ ጅራተኒፍ እስኒፍ ኬኑ ሰነ ሴንተኒ <verse eid="NUM 15:2"/><verse number="3" style="v" sid="NUM 15:3"/>ኣርሳ እብዳን ዽኤፈሙ ከን ኡርጋንሳ <char style="nd">ዋቀዮት</char> ቶሉ፣ ሎን ኬሳ ዮካን ቡሻዬ ኬሳ ፉተኒ ኣርሳ ጉበሙ ዮካን ቀልመ ወሬገ አዳቲፍ ዮካን ኣርሳ ፌዺኬሰኒ ዮካን ኣርሳ አያነ ወጋ <char style="nd">ዋቀዮፍ</char> ዽኤስቱ፣ <verse eid="NUM 15:3"/><verse number="4" style="v" sid="NUM 15:4"/>ነምን ኣርሳ ዽኤሱ ሱን ዳኩ ቡላኣ ኢፊ<note caller="+" style="f"><char style="fr" closed="false">15፥4 </char><char style="ft" closed="false">ኢፊን ቶኮ ኪሎ ግራሚ 22።</char></note> ሀርከ ኩዸን ኬሳ ሀርከ ቶኮ ከን ዘይቲ ኢኒ<note caller="+" style="f"><char style="fr" closed="false">15፥4 </char><char style="ft" closed="false">ኢኒን ቶኮ ሊትሪ 4።</char></note> ሀርከ አፉር ኬሰ ሀርከ ቶኮቲን ሱኩመሜ ኬና ምዻኒ ጎዼ <char style="nd">ዋቀዮፍ</char> ሃዽኤሱ። <verse eid="NUM 15:4"/><verse number="5" style="v" sid="NUM 15:5"/>ቶኮ ቶኮ ጦባላ ሆላ ከን ኣርሳ ጉበሙፍ ዮካን ቀልማፍ ዽኤፈሙ ወጅንስ ዳዺ ወይኒ ኢኒ ሀርከ አፉር ኬሳ ሀርከ ቶኮ ዽባዩዻፍ ቆጴስ።<verse eid="NUM 15:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 15:6"/>“ ‘ኮርቤሰ ሆላ ቶኮ ወጅንስ ዳኩ ቡላኣ ኢፊ ሀርከ ኩዸን ኬሳ ሀርከ ለመ ከን ዘይቲ ኢኒ ሀርከ ሰዲ ኬሳ ሀርከ ቶኮን ሱኩመሜን ኬና ምዻኒ ቆጴስ። <verse eid="NUM 15:6"/><verse number="7" style="v" sid="NUM 15:7"/>ዳዺ ወይኒ ኢኒ ሀርከ ሰዲ ኬሳ ሀርከ ቶኮ ዽባዩ ኡርጋንሳ <char style="nd">ዋቀዮት</char> ቶሉ ጎዺ ዽኤስ።<verse eid="NUM 15:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 15:8"/>“ ‘አት ዮሙ ድብቸ ሎኒ ቶኮ ኣርሳ ጉበሙ ዮካን ቀልመ ወሬገ አዳቲፍ ዮካን ኣርሳ ነጋቲፍ <char style="nd">ዋቀዮፍ</char> ቆጴስቱት፣ <verse eid="NUM 15:8"/><verse number="9" style="v" sid="NUM 15:9"/>ድብቸ ሰነ ወጅን ኬና ምዻኒ ፍድ፤ ኬናን ሱንስ ዳኩ ቡላኣ ኢፊ ሀርከ ኩዸን ኬሳ ሀርከ ሰዲ ከን ዘይቲ ወለካ ኢኒቲን ሱኩመሜ ሃተኡ። <verse eid="NUM 15:9"/><verse number="10" style="v" sid="NUM 15:10"/>አከሱመስ ዳዺ ወይኒ ኢኒ ወለካ ዽባዩ ጎዺ ፍድ። ወን ኩንስ ኣርሳ እብዳን ዽኤፈሙ ከን ኡርጋንሳ <char style="nd">ዋቀዮት</char> ቶሉ ተአ። <verse eid="NUM 15:10"/><verse number="11" style="v" sid="NUM 15:11"/>ቶኮን ቶኮን ድብቸ ሎኒ ዮካን ኮርቤሰ ሆላ፣ ቶኮን ቶኮን ጦባላ ሆላ ዮካን ኮርቤሰ ሬኤ ጥና ሃሉመ ከናን ሃቆጴፈመን። <verse eid="NUM 15:11"/><verse number="12" style="v" sid="NUM 15:12"/>አኩመ ባይእነ ዋን ቆጴስተን ሰናት አኩመ ለኮብሰሳኒት፣ ቶኮ ቶኮሳኒቲፍ አከኑመ ጎዻ።<verse eid="NUM 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 15:13"/>“ ‘ነምን ዸለታ ብየ ሰና ተኤ ሁንድኑ ዬሮ ኣርሳ እብዳን ዽኤፈሙ ከን ኡርጋንሳ <char style="nd">ዋቀዮት</char> ቶሉ ፍዱት ወንቶተ ከኔን ሃሉመ ከናን ሃሆጄቱ። <verse eid="NUM 15:13"/><verse number="14" style="v" sid="NUM 15:14"/>ዸሎተ ዹፉ ኬሰትስ አለጋን ዮካን ነምን ግዱኬሰን ጅራቱ ዬሮ ኣርሳ እብዳን ዽኤፈሙ ከን ኡርጋንሳ <char style="nd">ዋቀዮት</char> ቶሉ ዽኤሱት አኩመ እስን ጎተን ከነ ሃጎዹ። <verse eid="NUM 15:14"/><verse number="15" style="v" sid="NUM 15:15"/>ያኢን ሱን እስኒፊ አለጋ እስን ግዱ ጅራቱፍሌ ሴሩመ ቶኮ ሃቀባቱ፤ ኩንስ ዸሎተ ዹፉፍ ሴረ በረ በራት። አቲፊ አለጋን ሱን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ወል ቅጤዸ። <verse eid="NUM 15:15"/><verse number="16" style="v" sid="NUM 15:16"/>እስኒፍስ አለጋ እስን ግዱ ጅራቱፍስ ሴሪፊ ደምቢን ቶኩመ ሃተኡ።’ ”<verse eid="NUM 15:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 15:17"/>
    <char style="nd">ዋቀዮስ</char> ሙሴዻን አከነ ጄዼ፤ <verse eid="NUM 15:17"/><verse number="18" style="v" sid="NUM 15:18"/>“አከነ ጄዺ እስራኤሎተት ዱበዹ፦ ‘እስን ዬሮ ብየ አን እት እስን ገልቹ ሰነ ሴንተኒ <verse eid="NUM 15:18"/><verse number="19" style="v" sid="NUM 15:19"/>ምዻንሼ ኛተንት፣ ኛተ ሰነራ <char style="nd">ዋቀዮፍ</char> ኬና ዽኤሳ። <verse eid="NUM 15:19"/><verse number="20" style="v" sid="NUM 15:20"/>ቡኮኬሰን ከን ጀልቀባራ መጥኖ ቶኮ ኬና ዽኤሳ፤ እሰስ አከ ኣርሳ ኦብዲራ ፉዸሜት ዽኤሳ። <verse eid="NUM 15:20"/><verse number="21" style="v" sid="NUM 15:21"/>ዸሎተ ዹፉ ሁንዱማ ኬሰት ቡኮኬሰን ከን ጀልቀባራ <char style="nd">ዋቀዮፍ</char> ኬና ኬኑ ቀብዱ።<verse eid="NUM 15:21"/></para>
  <para style="s1">ኣርሳ ጩቡ ተሰ ሆጄተሜ</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 15:22"/>“ ‘ዮ እስን ኡቱ ህንቤክን አጀጀወን <char style="nd">ዋቀዮ</char> ሙሴት ኬኔ ከኔን ኬሳ ቶኮሌ <verse eid="NUM 15:22"/><verse number="23" style="v" sid="NUM 15:23"/>ጄቹንስ ዮ እስን አጀጀ <char style="nd">ዋቀዮ</char> ከን ጋፈ <char style="nd">ዋቀዮ</char> አጀጀ ከነ ኬኔ ጀልቀቤ ዸሎተ ዹፉ ኬሰሌ እቱመ ፉፉዻን ከራ ሙሴቲን እስን አጀጄ ከምዩ ጨብስተን፣ <verse eid="NUM 15:23"/><verse number="24" style="v" sid="NUM 15:24"/>ዮ ወንት ኩን ዶጎጎራን ኡቱ ወልዳን ህንቤክን ሆጄተሜ ጅራቴ ወልዳን ሱን ሁንድ ድብቸ ሎኒ ኣርሳ ጉበሙ ከን ኡርጋንሳ <char style="nd">ዋቀዮት</char> ቶሉ፣ ኬና ምዻኒቲፊ ዽባዩ አጀጀሜ ወጅን፣ ኣርሳ ጩቡቲፍሞ ኮርቤሰ ሬኤ ሃዽኤሰን። <verse eid="NUM 15:24"/><verse number="25" style="v" sid="NUM 15:25"/>ሉብንስ ወልዳ ሰበ እስራኤል ሁንዳፍ አራረ ሃቡሱ፤ እሳንስ ዋን ኡቱ ህንቤክን ጩቡ ሆጄተኒፍ፣ በሌሳሳኒቲፍስ ዋን ኣርሳ እብዳን ዽኤፈሙፊ ኣርሳ ጩቡ <char style="nd">ዋቀዮፍ</char> ፍደኒፍ ዺፈመ ንአርገቱ። <verse eid="NUM 15:25"/><verse number="26" style="v" sid="NUM 15:26"/>ሰበቢ ሰብን ሁንድ በሌሳ ዶጎጎራን ሆጄተሜ ሰነ ኬሰት ህርማቴፍስ ወልዳን ሰበ እስራኤል ሁንዲፊ አለጋወን እሳን ግዱ ጅራተን ዺፈመ ንአርገቱ።<verse eid="NUM 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 15:27"/>“ ‘ገሩ ዮ ነምን ቶኮ ቆፍት ኡቱ ህንቤክን ጩቡ ሆጄቴ እን ጎሮምቲ ሬኤ ከን ኡሙሪንሼ ወጋ ቶኮ ኣርሳ ጩቡቲፍ ሃፍዱ። <verse eid="NUM 15:27"/><verse number="28" style="v" sid="NUM 15:28"/>ሉብን ሱንስ ነምቸ ኡቱ እት ህንያድን ጩቡ ሆጄቴ ሰናፍ ፉለ <char style="nd">ዋቀዮ</char> ዱረት አራረ ሃቡሱ፤ ኤርገ አራር እሳፍ ቡኤ ቦዴሞ ነምች ሱን ዺፈመ ንአርገተ። <verse eid="NUM 15:28"/><verse number="29" style="v" sid="NUM 15:29"/>ዸለታ እስራኤሊፍስ ተኡ ዮካን አለጋ እስን ግዱ ጅራቱፍ፣ ነመ ኡቱ እት ህንያድን ጩቡ ሆጄቴ ሁንዳፍ ሴር ቶኩመ ሃተኡ።<verse eid="NUM 15:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 15:30"/>“ ‘ገሩ ዸለታ ብያስ ተኡ ዮካን አለጋን፣ ነምን ቤካ ጩቡ ሆጄቱ <char style="nd">ዋቀዮን</char> አረብሱሳት፤ ነምች ሱን ሰበሳ ኬሳ ሃበሌፈሙ። <verse eid="NUM 15:30"/><verse number="31" style="v" sid="NUM 15:31"/>ነምች ሱን ሰበቢ ዱቢ <char style="nd">ዋቀዮ</char> ቱፈቴፊ ሰበቢ አጀጀሳ ጨብሴፍ እን ሃበሌፈሙ፤ በሌሳ እሳትስ እሰቱ ጋፈተመ።’ ”<verse eid="NUM 15:31"/></para>
  <para style="s1">ነምን ሰንበተ ጨብሴ ቶኮ አጄፈሜ</para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 15:32"/>ዬሮ ሰብን እስራኤል ገሞጂ ኬሰ ቱሬት፣ ነምን ቶኮ ኡቱ ጉያ ሰንበታቲን ቆራን ወልት ቀበቱ አርገሜ። <verse eid="NUM 15:32"/><verse number="33" style="v" sid="NUM 15:33"/>ወር ኡቱ እን ቆራን ወልት ቀበቱ አርገንስ ሙሴት፣ አሮኒቲፊ ወልዳ ጉቱት እሰ ጌሰን፤ <verse eid="NUM 15:33"/><verse number="34" style="v" sid="NUM 15:34"/>ሰበቢ ወን እሰ ጎዸን ህንቤከምኒፍ ህዸኒ እሰ ቱርሰን። <verse eid="NUM 15:34"/><verse number="35" style="v" sid="NUM 15:35"/><char style="nd">ዋቀዮ</char> ሙሴዻን፣ “ነምች ዱኡ ቀበ። ወልዳን ሱን ጉቱን ቁበታን አለት ዸጋዻን እሰ ሃቱሙ” ጄዼ። <verse eid="NUM 15:35"/><verse number="36" style="v" sid="NUM 15:36"/>ወልዳን ሱን አኩመ <char style="nd">ዋቀዮ</char> ሙሴ አጀጄት ነምቸ ሰነ ቁበተ ኬሳ ገድ ባሴ ዸጋዻን ቱሜ አጄሴ።<verse eid="NUM 15:36"/></para>
  <para style="s1">ሀንዳረ ወያ</para>
  <para style="p">
    <verse number="37" style="v" sid="NUM 15:37"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ <verse eid="NUM 15:37"/><verse number="38" style="v" sid="NUM 15:38"/>“አከነ ጄዺ እስራኤሎተት ዱበዹ፦ ‘ዸሎተ ዹፉ ሁንደ ኬሰ ቀርቀረ ወያኬሰኒረት ሀንዳረ ቶልፈዻ፤ ቶኮን ቶኮን ሀንዳረ ሰናስ ፎኣ ብፈ ጩቁሊሳ ሃቀባቱ። <verse eid="NUM 15:38"/><verse number="39" style="v" sid="NUM 15:39"/>እስን ሀንዳረ ከነ እላልተኒ አጀጀ <char style="nd">ዋቀዮ</char> ሁንደ ያደቱ፤ ኩንስ አከ አጀጀ ከነ ኤግደኒ ሀዊ ገራኬሰኒቲፊ ሀዊ እጀኬሰኒ ዱካ ቡኡዻን ህንሰጋገሌፍ። <verse eid="NUM 15:39"/><verse number="40" style="v" sid="NUM 15:40"/>ዮስ እስን አጀጀኮ ሁንደ ያደተኒ ንኤግዱ፤ ዋቀኬሰኒፍስ ቁልቁሎተ ንታቱ። <verse eid="NUM 15:40"/><verse number="41" style="v" sid="NUM 15:41"/>አን <char style="nd">ዋቀዮ</char> ዋቀኬሰን ከን ዋቀ እስኒ ተኡፍ ጄዼ ብየ ግብጢ እስን ባሴዸ። አን <char style="nd">ዋቀዮ</char> ዋቀኬሰን።’ ”<verse eid="NUM 15:41"/></para>
  <chapter eid="NUM 15"/>
  <chapter number="16" style="c" sid="NUM 16"/>
  <para style="s1">ቆራህ፣ ዳታኒፊ አቤሮን</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 16:1"/>ቆራህ እልም ይዝሃር፣ እልም ቆሃት፣ እልም ሌዊ፣ ጎሰ ሩቤን ኬሳሞ እልማን ኤሊያብ፣ ዳታኒፊ አቢራም አከሱመስ ኦን እልም ጴሌት ከአኒ <verse eid="NUM 16:1"/><verse number="2" style="v" sid="NUM 16:2"/>ሙሴዻን ሞርመን። እሳን ወጅንስ ነሞተ እስራኤል ጄቹንስ ሆገንቶተ ወልዳ ቤቤከሞ ከኔን ምሴንሰ ያኢ ተአኒ ሙደመኒ ቱረን 250 ገአንቱ ቱሬ። <verse eid="NUM 16:2"/><verse number="3" style="v" sid="NUM 16:3"/>እሳንስ ሙሴፊ አሮኒን ሞርሙፍ ጄዸኒ ቶኩማዻን ወልት ቀበመኒ ዹፈኒ አከነ እሳኒን ጄዸን፤ “እስን ዱቢ ባይእፍተኒርቱ! ወልዳን ኩን ጉቱማት ቶኮን ቶኮንሳኒዩ ቁልቁሉዸ፤ <char style="nd">ዋቀዮስ</char> እሳን ወጅን ጅረ። ዮስ እስን ማሊፍ ወልዳ <char style="nd">ዋቀዮረት</char> ኦፍ ቱልቱሬ?”<verse eid="NUM 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 16:4"/>ሙሴን ዱቢ ከነ ዸጌኛን አዳን ለፈት ጎምብፈሜ። <verse eid="NUM 16:4"/><verse number="5" style="v" sid="NUM 16:5"/>ኤርገሲስ ቆራሂፊ ወረ እሰ ዱካ ቡአን ሁንዳን አከነ ጄዼ፦ “ቦር ገነመ <char style="nd">ዋቀዮ</char> ነመ ከንሳ ተኤፊ ነመ ቁልቁሉ ተኤ ንአርግሲሰ፤ አከ ነምን ሱን ገረሳት ዽኣቱሌ ንጎዸ። እን ነመ ፍለቴ ሰነ አከ እን እት ዽኣቱ ጎዸ። <verse eid="NUM 16:5"/><verse number="6" style="v" sid="NUM 16:6"/>ቆራህ፣ አቲፊ ወር ስ ዱካ ቡአን ሁንድ ዋን ከነ ጎዻ፦ ግርግራወን ፉዸዻቲ <verse eid="NUM 16:6"/><verse number="7" style="v" sid="NUM 16:7"/>ቦር ፉለ <char style="nd">ዋቀዮ</char> ዱረት እብዳፊ እጣነ እት ነቃ። ነምን <char style="nd">ዋቀዮ</char> ፍለቱ እን ነመ ቁልቁሉ ተአ። እስን ሌዎትን ዱቢ ባይእፍተኒርቱ!”<verse eid="NUM 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 16:8"/>ሙሴንስ ቆራሂዻን አከነ ጄዼ፤ “እስን ሌዎትን ሜ ዸገኣ! <verse eid="NUM 16:8"/><verse number="9" style="v" sid="NUM 16:9"/>ዋቅን እስራኤል ወልዳ እስራኤል ካን ኬሳ እስን ፍለቴ አከ እስን ሆጂ ዱንካነ ቁልቁሉ <char style="nd">ዋቀዮ</char> ሆጄተኒፊ አከ እስን ፉለ ወልዳ ዱረ ዻበተኒ እሳን ተጃጅልተኒፍ ጄዼ ኦፍት እስን ዽኤሱንሳ እስን ህንገኡ? <verse eid="NUM 16:9"/><verse number="10" style="v" sid="NUM 16:10"/>እን ስኢፊ ሌዎተ ስ ወጅን ጅረን ሁንደ ኦፍት ዽኤሴረ፤ እስን ገሩ ሉቡማሌ ፉዸቹ በርባደን። <verse eid="NUM 16:10"/><verse number="11" style="v" sid="NUM 16:11"/>ከናፉ አቲፊ ሚልቶትንኬ ሁንድኑ ወልት ቀበምተኒ <char style="nd">ዋቀዮን</char> ሞርምተን። አሮን እስን እት ጉንጉምተን ኩን ኤኙዸ?”<verse eid="NUM 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 16:12"/>ሙሴንስ ኤርገሲ እልማን ኤሊያብ ዳታኒፊ አቢራም ዋምስሴ። እሳን ገሩ አከነ ጄዸን፤ “ኑ ህንዹፍኑ! <verse eid="NUM 16:12"/><verse number="13" style="v" sid="NUM 16:13"/>አት ገሞጂ ኬሰት ኑ ፍጡፍ ጄቴ ብየ ኣነኒፊ ደመ ባሱ ኬሳ ኑ ባሱንኬ ስ ህንገኡ? አመሞ ጎፍታ ኑት ተኡ ፌታ? <verse eid="NUM 16:13"/><verse number="14" style="v" sid="NUM 16:14"/>ከነ መሌዩ አት ብየ ኣነኒፊ ደመ ባሱት ኑ ህንገልችኔ ዮካን ዻለ ለፈ ቆቲሳቲፊ እዶ ዻባ ወይኒ ኑ ህንኬንኔ። አት እጀ ነሞተ ከና ንባፍታ? ለኪ፣ ኑ ህንዹፍኑ!”<verse eid="NUM 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 16:15"/>ሙሴን አከ መሌ ኣሬ <char style="nd">ዋቀዮን</char>፣ “ኣርሳሳኒ ህንፉዸትን። አን ሀሬ ቶኮሌ እሳንራ ህንፉዸትኔ ዮካን እሳን ኬሳ ነመ ቶኮሌ ህንሚኔ” ጄዼ።<verse eid="NUM 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 16:16"/>ሙሴን ቆራሂዻን አከነ ጄዼ፤ “አቲፊ ሚልቶትንኬ ሁንድኑ አከሱመስ አት፣ እሳኒፊ አሮን ቦር ፉለ <char style="nd">ዋቀዮ</char> ዱረት አርገማ። <verse eid="NUM 16:16"/><verse number="17" style="v" sid="NUM 16:17"/>ቶኮን ቶኮን ነማ ግርግራሳ ፉዸቴ፣ እጣነ እት ነቀቴ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ሃዽኤሱ፤ ግርግራወን ኩኔንስ ወሉማ ገለት 250 ተኡ። አከሱመስ አቲፊ አሮን ግርግራኬሰን ዽኤሱ ቀብዱ።” <verse eid="NUM 16:17"/><verse number="18" style="v" sid="NUM 16:18"/>ቶኮን ቶኮን ነማ ግርግራሳ ፉዸቴ፣ እብዳፊ እጣነ እት ነቀቴ ሙሴፊ አሮን ወጅን በልበለ ዱንካነ ወል ገኢ ዱረ ዻበቴ። <verse eid="NUM 16:18"/><verse number="19" style="v" sid="NUM 16:19"/>ዬሮ ቆራህ እሳኒን ሞርሙፍ ጄዼ ዱካ ቡቶተሳ ሁንደ በልበለ ዱንካነ ወል ገኢ ዱረት ወልት ቀቤት፣ ኡልፍን <char style="nd">ዋቀዮ</char> ወልዳ ጉቱት ሙልአቴ። <verse eid="NUM 16:19"/><verse number="20" style="v" sid="NUM 16:20"/><char style="nd">ዋቀዮ</char> ሙሴፊ አሮኒን አከነ ጄዼ፤ <verse eid="NUM 16:20"/><verse number="21" style="v" sid="NUM 16:21"/>“አከ አን ዬሩመ ቶኮን እሳን ፍጡፍ ወልዳ ከነራ ገርገር በኣ።”<verse eid="NUM 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 16:22"/>ሙሴፊ አሮን ገሩ አዳን ለፈት ጎምብፈመኒ አከነ ጄዸኒ እየን፤ “ያ <char style="nd">ዋቀዮ</char> ዋቀ ሀፉሮተ ሰኚ ነመ ሁንዳ፣ አት ዮ ነምን ቶኮ የኬ ወልዳ ጉቱት ዼከምታ?”<verse eid="NUM 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 16:23"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ <verse eid="NUM 16:23"/><verse number="24" style="v" sid="NUM 16:24"/>“ወልዳ ከናን፣ ‘ዱንካኖተ ቆራህ፣ ከን ዳታኒቲፊ አቢራምራ ፈጋዻ’ ጄዽ።”<verse eid="NUM 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 16:25"/>ሙሴንስ ከኤ ገረ ዳታኒፊ አቢራም ዸቄ፤ ማንጉዶትን እስራኤልስ እሰ ዱካ ቡአን። <verse eid="NUM 16:25"/><verse number="26" style="v" sid="NUM 16:26"/>እንስ ወልዳ ሰናን፣ “ዱንካነ ነሞተ ሀሞ ከኔኒራ ፈጋዻ! እስን አከ ሰበቢ ጩቡሳኒ ሁንዳን ህንበርበዴፈምኔፍ ዋን ከንሳኒ ተኤ ከምዩ ህንቱቅና” ጄዼ። <verse eid="NUM 16:26"/><verse number="27" style="v" sid="NUM 16:27"/>እሳን ዱንካኖተ ቆራህ፣ ከን ዳታኒፊ ከን አቢራሚስራ ፈጋተን። ዳታኒፊ አቢራሚስ ገድ በአኒ ኒቶተ፣ እጆሌፊ ዳእመንሳኒ ወጅን በልበለ ዱንካኖተሳኒ ዱረ ዸዻበቻ ቱረን።<verse eid="NUM 16:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 16:28"/>ኤርገሲ ሙሴን አከነ ጄዼ፤ “አን ወንቶተ ከኔን ሁንደ አከን ሆጄዹፍ <char style="nd">ዋቀዮ</char> አከ ነ ኤርጌ፣ ኩንስ ያደኮ አከ ህንተእን እስን ከናን ንቤክቱ፦ <verse eid="NUM 16:28"/><verse number="29" style="v" sid="NUM 16:29"/>ዮ ነሞትን ኩኔን ዱኡመ ኡመማን ዹፉ ዱአኒፊ ወን ነመ ሁንደት ዹፉ እሳንት ዹፌ <char style="nd">ዋቀዮ</char> ነ ህንኤርግኔ። <verse eid="NUM 16:29"/><verse number="30" style="v" sid="NUM 16:30"/>ገሩ ዮ <char style="nd">ዋቀዮ</char> ዋን ጉቱማን ጉቱት ሃራ ተኤ ቶኮ እሳንት ፍዴ ለፍት አፋን በንቴ ዋን እሳን ቀበን ሁንደ ወጅን እሳን ልቅምስቴ፣ ዮ እሳንስ ኡቱመ ሉቡን ጅረኑ ቦለ ቡአን፣ እስን አከ ነሞትን ኩኔን <char style="nd">ዋቀዮን</char> ቱፈተን ንቤክተን።”<verse eid="NUM 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 16:31"/>አኩመ እን ዋን ከነ ሁንደ ዱበቴ ፍጠቴን ለፍት እሳን ጀላ በቀቅጤ፤ <verse eid="NUM 16:31"/><verse number="32" style="v" sid="NUM 16:32"/>ለፍት ሱንስ አፋን በንቴ ወረ መነሳኒ፣ ነሞተ ቆራህ ሁንዳፊ ቀቤኘሳኒ ሁንደ ወጅን እሳን ልቅምስቴ። <verse eid="NUM 16:32"/><verse number="33" style="v" sid="NUM 16:33"/>እሳንስ ዋን ቀበን ሁንደ ወጅን ጅራት ቦለ ቡአን፤ ለፍትስ እሳንረት አፋን ወልት ዴብፈቴ፤ እሳንስ አከሲን ወልዳ ኬሳ በሌፈመን። <verse eid="NUM 16:33"/><verse number="34" style="v" sid="NUM 16:34"/>እሳን እይናን እስራኤሎን ናኖሳኒ ቱረን ሁንድኑ፣ “ለፍት ኩን ኑንስ ንልቅምስት!” ጄዸኒ እያ በቀተን።<verse eid="NUM 16:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 16:35"/>እብድ <char style="nd">ዋቀዮ</char> ብራ ገድ ቡኤ ነሞተ 250 ከኔን ኣርሳ እጣና ዽኤሳ ቱረን ሰነ ፍጤ።<verse eid="NUM 16:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 16:36"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ <verse eid="NUM 16:36"/><verse number="37" style="v" sid="NUM 16:37"/>“አከ እን ግርግራወን ሰነ ለፈ ጀር እት ጉበመኒ ፉዼ ጭሌሳኒ ከን ቦበኡ አች ፈጌሴ ኬሳ ብትኔሱፍ ኤሌኣዛር እልመ አሮን ሉብቻት ህም፤ ግርግራወን ሱን ቁልቁሉዻቲ። <verse eid="NUM 16:37"/><verse number="38" style="v" sid="NUM 16:38"/>ግርግራወን ኩኔንስ ግርግራወን ነሞተ ሉቡሳኒት ሙሩዻን ጩቡ ሆጄተኒት። ግርግራወን ሰነስ እዶ ኣርሳት ኡፍሱዻፍ ቱሚ ሀጵስ፤ እሳን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዽኤፈመኒ ቁልቁሉ ተአኒሩቲ። እሳንስ እስራኤሎታፍ መለቶ ሃተአን።”<verse eid="NUM 16:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 16:39"/>ኤሌኣዛር ሉብች ግርግራወን ናሲ ከኔን ነሞትን ጉበመን ሱን ዽኤሰን ሰነ እዶ ኣርሳት ኡፍሱዻፍ ጄዼ ወልት ቀቤ ቱሜ። <verse eid="NUM 16:39"/><verse number="40" style="v" sid="NUM 16:40"/>ከነስ አኩመ <char style="nd">ዋቀዮ</char> ከራ ሙሴቲን እሰ አጀጄት ሆጄቴ። ኩንስ አከ ሰኚ አሮን መሌ ነምን ቶኮዩ እጣነ ኣርሱፍ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ህንዽኣትኔ፣ ዮ ከና አቺ አከ እን አኩመ ቆራሂቲፊ ሚልቶተሳ ሰና ተኡ እስራኤሎተ ያደተኒፍ።<verse eid="NUM 16:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 16:41"/>ጉያ እት ኣኑት ወልዳን እስራኤል ሁንድ፣ “እስን ሰበ <char style="nd">ዋቀዮ</char> ፍጠን” ጄዸኒ ሙሴፊ አሮንት ጉንጉመን።<verse eid="NUM 16:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 16:42"/>ገሩ ዬሮ ወልዳን ሱን ሙሴፊ አሮኒን ሞርሙዻፍ ወልት ቀበሜ ገረ ዱንካነ ወል ገኢ እላሌት፣ ኩኖ ዱሜስ ዱንካነ ሰነ ሀጉጌ፤ ኡልፍን <char style="nd">ዋቀዮስ</char> ንሙልአቴ። <verse eid="NUM 16:42"/><verse number="43" style="v" sid="NUM 16:43"/>ሙሴፊ አሮን ገረ ፉልዱረ ዱንካነ ወል ገኢ ዸቀን፤ <verse eid="NUM 16:43"/><verse number="44" style="v" sid="NUM 16:44"/><char style="nd">ዋቀዮስ</char> ሙሴዻን አከነ ጄዼ፤ <verse eid="NUM 16:44"/><verse number="45" style="v" sid="NUM 16:45"/>“አከ አን ዮሙሱመ እሳን በሌሱፍ፣ ወልዳ ከነ ብራ ፈጋዹ።” እሳንስ አዳን ለፈት ጎምብፈመን።<verse eid="NUM 16:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="NUM 16:46"/>ኤርገሲ ሙሴን አሮኒን አከነ ጄዼ፤ “ግርግራኬ ፉዸዹቲ እዶ ኣርሳራ እጣነ እብደ ወጅን እት ነቀዹቲ አራረ እሳኒፍ ቡሱዻፍ ገረ ወልዳት ፊግ። ዼከምስ <char style="nd">ዋቀዮ</char> ብራ ዹፌረ፤ ዸእች ጀልቀቤረ።” <verse eid="NUM 16:46"/><verse number="47" style="v" sid="NUM 16:47"/>አሮን አኩመ ሙሴን ጄዼ ሰነ ፊጌ ግዱ ወልዳ ሴኔ። ዬሮ ከነት ዸእች ግዱ ወልዳት ጀልቀቤ ቱሬ። አሮን ገሩ እጣነ ዽኤሴ አራረ እሳኒፍ ቡሴ። <verse eid="NUM 16:47"/><verse number="48" style="v" sid="NUM 16:48"/>እንስ ወረ ጅሩፊ ወረ ዱኤ ግዱ እጃጄ፤ ዸእች ሱንስ ንዻበቴ። <verse eid="NUM 16:48"/><verse number="49" style="v" sid="NUM 16:49"/>ገሩ ነሞተ ሰበቢ ቆራሂቲፍ ዹመን መሌ ነሞተ 14,700 ገአንቱ ዸእቸ ሰናን ዹሜ። <verse eid="NUM 16:49"/><verse number="50" style="v" sid="NUM 16:50"/>አሮን ሰበቢ ዸእች ሱን ዻበቴፍ ገረ በልበለ ዱንካነ ወል ገኢ ገረ ሙሴት ዴብኤ።<verse eid="NUM 16:50"/></para>
  <chapter eid="NUM 16"/>
  <chapter number="17" style="c" sid="NUM 17"/>
  <para style="s1">ኡሌን አሮን ለቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 17:1"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ <verse eid="NUM 17:1"/><verse number="2" style="v" sid="NUM 17:2"/>“እስራኤሎተት ዱበዹቲ ሆገንቶተ ጎሰ አቦቲሳኒ ሀርካ ኡሌ ቶኮ ቶኮ፣ ወሉማ ገለት ኡሌወን ኩዸ ለመ ፉዽ። መቃ ቶኮ ቶኮ ነማስ ኡሌሳረት በሬስ። <verse eid="NUM 17:2"/><verse number="3" style="v" sid="NUM 17:3"/>ሰበቢ ቶኮ ቶኮ ሆገና ጎሰ አቦቲቲፍ ኡሌን ቶኮ ጅራቹ ቀቡፍ መቃ አሮን ኡሌ ሌዊረት በሬስ። <verse eid="NUM 17:3"/><verse number="4" style="v" sid="NUM 17:4"/>ኡሌወን ከኔንስ ዱንካነ ወል ገኢ ኬሰ ፉለ ታቦተ ከኩ ሴራ ዱረ እዶ አን እት እስኒን ወል አርጉ ሰነ ካእ። <verse eid="NUM 17:4"/><verse number="5" style="v" sid="NUM 17:5"/>ኡሌን ነመ አን ፍለዹ ንለተ፤ አንስ ጉንጉሚ እስራኤሎን ዬሮ ሁንደ እስንት ጉንጉመን ኦፍራ ነንኩተ።”<verse eid="NUM 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 17:6"/>ሙሴን እስራኤሎተት ዱበቴ፤ ሆገንቶትንሳኒስ ኡሌወን ኩዸ ለመ ጄቹንስ ሆገንቶተ ቶኮ ቶኮ ጎሰ አቦቲሳኒቲፍ ኡሌ ቶኮ ቶኮ እሰት ኬነን፤ ኡሌን አሮንስ ኡሌወን ሰነ ኬሰ ቱሬ። <verse eid="NUM 17:6"/><verse number="7" style="v" sid="NUM 17:7"/>ሙሴንስ ኡሌወን ሰነ ዱንካነ ዹገ በኡምሳ ኬሰ ፉለ <char style="nd">ዋቀዮ</char> ዱረ ካኤ።<verse eid="NUM 17:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 17:8"/>ጉያ እት ኣኑት ሙሴን ዱንካነ ዹገ በኡምሳ ሴኔ ኡሌን አሮን ከን ጎሰ ሌዊ እዶ ቡኡ ሱን እሳ ለቱ ቆፈ ኡቱ ህንተእን ሁዼ ደራሬ ለዉዚ ነቀቴ አርጌ። <verse eid="NUM 17:8"/><verse number="9" style="v" sid="NUM 17:9"/>ሙሴን ኡሌ ሰነ ሁንደ ፉለ <char style="nd">ዋቀዮ</char> ዱራ አለት ገድ ባሴ እስራኤሎተ ሁንደት ፍዴ። እሳንስ እላለኒ ቶኮን ቶኮን ነማ ኡሌ ኦፊሳ ፉዸቴ።<verse eid="NUM 17:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 17:10"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ “ኡሌ አሮን ፉዺቲ አከ እን ፍንጭልቶታፍ መለቶ ተኡፍ ፉለ ታቦተ ከኩ ሴራ ዱረ ዴብሲ ካእ። ኩን አከ እሳን ህንዹምኔፍ ነት ጉንጉሙሳኒ ሰነ ዻበቺሰ።” <verse eid="NUM 17:10"/><verse number="11" style="v" sid="NUM 17:11"/>ሙሴንስ አኩመ <char style="nd">ዋቀዮ</char> እሰ አጀጄ ሰነ ጎዼ።<verse eid="NUM 17:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 17:12"/>እስራኤሎን ሙሴዻን አከነ ጄዸን፤ “ኑ ንዱነ! ኑ በድኔረ፤ ኑ ሁንድኑ በድኔረ! <verse eid="NUM 17:12"/><verse number="13" style="v" sid="NUM 17:13"/>ነምን ዱንካነ ቁልቁሉ <char style="nd">ዋቀዮት</char> ዽኣቱ ከምዩ ንዱአ። ኑ አመ ዱኡፍ ጅራ?”<verse eid="NUM 17:13"/></para>
  <chapter eid="NUM 17"/>
  <chapter number="18" style="c" sid="NUM 18"/>
  <para style="s1">ሆጂ ሉቦታቲፊ ሌዎታ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 18:1"/>
    <char style="nd">ዋቀዮ</char> አሮኒን አከነ ጄዼ፤ “አት፣ እልማንኬቲፊ ማቲን አባኬቲ ስ ወጅን የከ እዶ ቁልቁሉት ሆጄተሜት ንጋፈተምቱ። የከ ሉቡማት ሆጄተሜ ስኢፊ እልማንኬ ቆፈቱ እት ጋፈተመ። <verse eid="NUM 18:1"/><verse number="2" style="v" sid="NUM 18:2"/>አከ እሳን ዬሮ አቲፊ እልማንኬ ፉለ ዱንካነ ዹገ በኡምሳ ዱረት ተጃጅልተንት ስት ደበለመኒ ስ ገርጋረኒፍ ኦቦሎተኬ ወረ ጎሰ ሌዊ፣ ወረ ጎሰ አባኬቲ ሰነ ፍድ። <verse eid="NUM 18:2"/><verse number="3" style="v" sid="NUM 18:3"/>እሳንስ አጀጀኬ ዸገኡዻን ሆጂወን ዱንካነ ኬሳ ሁንደ ሃሆጄተን፤ ገሩ ምአ እዶ ቁልቁሉት ዮካን እዶ ኣርሳት ዽኣቹ ህንቀበን። ዮ አከስ ተኤ እሳንስ፣ አትስ ንዱቱ። <verse eid="NUM 18:3"/><verse number="4" style="v" sid="NUM 18:4"/>እሳንስ ዱንካነ ወል ገኢ ኤጉዻፍ እስንት ደበለሙ ቀቡ፤ ሆጂ ዱንካነ ሰና ሁንደስ ሃሆጄተን። ነምን ብራ እዶ እስን ጅርተንት ዽኣቹ ህንቀቡ።<verse eid="NUM 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 18:5"/>“እስን አከ ዼከምስ አመስ እስራኤሎተረ ህንቡኔፍ ኤጉምሰ እዶ ቁልቁሉቲፊ ኤጉምሰ እዶ ኣርሳት ንጋፈተምቱ። <verse eid="NUM 18:5"/><verse number="6" style="v" sid="NUM 18:6"/>አን መታንኮ ኦቦሎተኬሰን ሌዎተ ኬናወን እስኒ ኬነመን ጎዼ ሰበ እስራኤል ኬሳ ፍለዼረ፤ እሳንስ አከ ሆጂ ዱንካነ ወል ገኢ ኬሳ ሆጄተኒፍ <char style="nd">ዋቀዮፍ</char> ኬነመኒ ጅሩ። <verse eid="NUM 18:6"/><verse number="7" style="v" sid="NUM 18:7"/>ገሩ ሆጂ እዶ ኣርሳቲፊ ሆጂ ጎልጋ ኬሳ ሁንደ ስኢፊ እልማንኬ ቆፈቱ ሆጄተ። አን ሆጂ ሉቡማ ኬና ጎዼ እስኒፍ ነንኬነ። ነምን ብራ ከን እዶ ቁልቁሉት ዽኣቱ ሃአጄፈሙ።”<verse eid="NUM 18:7"/></para>
  <para style="s1">ኬናወን ሉቦታፊ ሌዎታፍ ኬነመን</para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 18:8"/>
    <char style="nd">ዋቀዮ</char> አሮኒን አከነ ጄዼ፤ “አን መታንኮ እት ጋፈተማ ኣርሳወን ና ዽኤፈመኒ ስ ጎዼረ፤ አን ኣርሳወን ቁልቁሉ እስራኤሎን ናፍ ዽኤሰን ሁንደ አከ እሳን በረ በራን ቆዳፊ ገኤኬሰን ተአኒፍ ስኢፊ እልማንኬቲፍ ኬኔረ። <verse eid="NUM 18:8"/><verse number="9" style="v" sid="NUM 18:9"/>ኩንስ ኣርሳወን ዋን ሁንደ ጫላ ቁልቁሉ ተአን ከኔን እብድ ህንቱቅን ኬሳ ቆደኬ ተአ። ኬናወን እሳን ኣርሳወን ዋን ሁንደ ጫላ ቁልቁሉ ተአን ጎዸኒ ና ፍደን ጄቹንስ ኣርሳወን ምዻኒ ዮካን ኣርሳወን ጩቡ ዮካን ኣርሳወን የካ ሁንደ ኬሳ ቆድን ሱን ከንኬቲፊ ከን እልማንኬቲት። <verse eid="NUM 18:9"/><verse number="10" style="v" sid="NUM 18:10"/>እሰስ እዶ እዶ ሁንደ ጫላ ቁልቁሉ ተኤት ኛዹ፤ ዺር ሁንድ ሃኛቱ፤ እንስ ቁልቁሉ ሲፍ ሃተኡ።<verse eid="NUM 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 18:11"/>“ወን ኩንስ ከኑመኬት፤ ኣርሳን ሶቾፈሙ ከን ኬና ሰበ እስራኤል ሁንደራ አዳን ባፈሜ ከኑመኬት። አንስ ዋን ከነ ስኢፊ እልማንኬቲፊ እንተለንኬ ከኔን ስ ወጅን ጅራተኒፍ ቆደ በረ በራ ጎዼ ኬኔረ። መነኬ ኬሳ ነምን አከ ሴራት ቁልቁሉ ተኤ ከምዩ ዋን ከነ ኛቹ ንደንደአ።<verse eid="NUM 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 18:12"/>“ዘይቲ ኤጄርሳ ፍለተማ ሁንደ፣ ዳዺ ወይኒ ፍለተማ ሁንዳፊ ዋን ገልፈተን ኬሳ መታ ምዻኒ ከን እሳን <char style="nd">ዋቀዮፍ</char> ዽኤሰን ሲፍ ነንኬነ። <verse eid="NUM 18:12"/><verse number="13" style="v" sid="NUM 18:13"/>መታን ምዻኒ ከን እሳን ዋን ብየቲራ አርገተን ሁንደ ኬሳ <char style="nd">ዋቀዮፍ</char> ፍደን ከንኬ ሃተኡ፤ መነኬ ኬሳ ነምን አከ ሴራት ቁልቁሉ ተኤ ከምዩ ዋን ከነ ኛቹ ንደንደአ።<verse eid="NUM 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 18:14"/>“እስራኤል ኬሰት ወን ቁልቁሌፈሜ <char style="nd">ዋቀዮፍ</char> ኬነሜ ሁንድኑ ከንኬት። <verse eid="NUM 18:14"/><verse number="15" style="v" sid="NUM 18:15"/>ወን ገደሜሰ ሳቁ ከምዩ ነመስ ተኡ ሆሪን <char style="nd">ዋቀዮፍ</char> ዽኤፈሙ ሁንድ ከንኬት። አት ገሩ እልመ ሀንገፈ፣ ሆሪ ቁልቁሉ ህንተእን ኬሳሞ ኮርመ ሀንገፈ ፉሩ ቀብደ። <verse eid="NUM 18:15"/><verse number="16" style="v" sid="NUM 18:16"/>ዬሮ ኡሙሪንሳኒ ጅአ ቶኮ ተኡት አከ ሰቅሊ እዶ ቁልቁሉ ከን ጌራ ድግደመ ኡልፋቱ ሰናት ገቲ ፉሪ ሙርታኤ ሜቲ ሰቅሊ ሸኒን እሳን ፉር።<verse eid="NUM 18:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 18:17"/>“ገሩ ሰንጋ ሀንገፈ፣ ሆላ ሀንገፋፊ ሬኤ ሀንገፈ ህንፉርን፤ እሳን ቁልቁሉዸ። ዺገሳኒ እዶ ኣርሳረት ፈጫስ፤ ጮመሳኒሞ ኣርሳ እብዳን ዽኤፈሙ ከን ኡርጋንሳ <char style="nd">ዋቀዮት</char> ቶሉ ጎዺቲ ጉብ። <verse eid="NUM 18:17"/><verse number="18" style="v" sid="NUM 18:18"/>አኩመ ሀንደራፍን ኣርሳ ሶቾፈሙቲፊ ተፍን ምርጋ ከንኬ ተኤ ሰነ ፎንሳኒስ ከንኬ ተአ። <verse eid="NUM 18:18"/><verse number="19" style="v" sid="NUM 18:19"/>አን ዋን ኣርሳ ቁልቁሉ እስራኤሎን <char style="nd">ዋቀዮፍ</char> ዽኤሰንራ አዳን ባፈሜ ሁንደ ሲፍ፣ እልማንኬቲፊ እንተለንኬቲፍ ቆደ በረ በራ ጎዼ ነንኬነ። እንስ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ስኢፊ ሰኚኬቲፍ ከኩ ሶግዳ ከን በረ በራት።”<verse eid="NUM 18:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 18:20"/>
    <char style="nd">ዋቀዮ</char> አሮኒን አከነ ጄዼ፤ “አት ብየሳኒ ኬሰት ዻለ ቶኮሌ ዮካን ቆደ ቶኮሌ እሳን ግዱዻ ህንቀባቱ፤ አን ሰበ እስራኤል ኬሰት ቆደኬቲፊ ዻለኬት።<verse eid="NUM 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 18:21"/>“ኩኖ አን ኬና እስራኤል ኬሰ ጅሩ ኩዸን ኬሳ ቶኮ ሁንደ ዋን እሳን ተጃጅለ ዱንካነ ወል ገኢ ተጃጅለኒፍ ዻለ ጎዼ ሌዎታፍ ኬኔረ። <verse eid="NUM 18:21"/><verse number="22" style="v" sid="NUM 18:22"/>ስአች እስራኤሎን አከ ጩቡ ህንባትኔፊ አከ ህንዱኔፍ ዱንካነ ወል ገኢት ህንዽኣትን። <verse eid="NUM 18:22"/><verse number="23" style="v" sid="NUM 18:23"/>ከን ሆጂ ዱንካነ ወል ገኢ ሆጄቱፊ ከን እት ጋፈተመ የከ አችት ሆጄተሙ ፉዸቱ ሌዎቱመ። ኩንስ ዸሎተ ዹፉፍ ሴረ በረ በራት። እሳን ሰበ እስራኤል ኬሰት ዻለ ቶኮሌ ህንአርገተን። <verse eid="NUM 18:23"/><verse number="24" style="v" sid="NUM 18:24"/>ቆደ ከና አን ዋን እስራኤሎን ኩዸን ኬሳ ቶኮ ኣርሳ ጎዸኒ <char style="nd">ዋቀዮፍ</char> ዽኤሰን ሰነ ዻለሳኒ ጎዼ ሌዎታፍ ኬኔረ። ሰበቢን አን፣ ‘እሳን ሰበ እስራኤል ኬሰት ዻለ ቶኮሌ ህንቀባተን’ ጄዼ ዋኤሳኒ ዱበዼፍስ ከኑመ።”<verse eid="NUM 18:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 18:25"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ <verse eid="NUM 18:25"/><verse number="26" style="v" sid="NUM 18:26"/>“አከነ ጄዺ ሌዎተት ዱበዹ፦ ‘ዮሙ ኬና ሀርከ ኩዸን ኬሳ ሀርከ ቶኮ ከን አን ዻለኬሰን ጎዼ እስኒፍ ኬኔ ሰነ እስራኤሎተራ ፉዸተንት እስን ኬና ሰነ ሀርከ ኩዸን ኬሳ ሀርከ ቶኮ ኣርሳ <char style="nd">ዋቀዮ</char> ጎዻ ዽኤሳ። <verse eid="NUM 18:26"/><verse number="27" style="v" sid="NUM 18:27"/>ኣርሳንኬሰንስ አኩመ ምዻን ኦብዲራ ዮካን አኩመ ጩንፋ እዶ እጀ ወይኒ እት ጩንፈኒ ኬሳ በኤት እስኒፍ ሄሬገመ። <verse eid="NUM 18:27"/><verse number="28" style="v" sid="NUM 18:28"/>እስንስ ሃሉመ ከናን ኬና ሀርከ ኩዸን ኬሳ ሀርከ ቶኮ ከን እስራኤሎተራ አርገተን ሁንደ ኬሳ <char style="nd">ዋቀዮፍ</char> ኣርሳ ንዽኤስቱ፤ ኬናወን ከኔን ኬሳስ ዋን ቆደ <char style="nd">ዋቀዮ</char> ተኤ አሮን ሉብቻፍ ኬና። <verse eid="NUM 18:28"/><verse number="29" style="v" sid="NUM 18:29"/>ዋን እስኒ ኬነሜ ሁንደ ኬሳ ኩታ ዋን ሁንደ ጫላ ጋሪፊ ቁልቁሉ ተኤ ቆደ <char style="nd">ዋቀዮ</char> ጎዻቲ ዽኤሳ።’<verse eid="NUM 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 18:30"/>“ሌዎታን አከነ ጄዽ፦ ‘ዮሙ እስን ኩታ ዋን ሁንደ ጫላ ጋሪ ተኤ ዽኤስተንት ኩታን ሱን አከ ምዻን ኦብዲራ ዮካን አከ ጩንፋ እዶ እጀ ወይኒ እት ጩንፈን ኬሳ በኤት እስኒ ሄሬገመ። <verse eid="NUM 18:30"/><verse number="31" style="v" sid="NUM 18:31"/>ሰበቢ ወን ኩን ምንዳ ሆጂ ዱንካነ ወል ገኢ ከን እስን ሆጄተኒ ተኤፍ እስኒፊ ነሞትን መነኬሰን ጅራተን ዋን ሀፌ ሰነ እዶ በርባደን ከምትዩ ኛቹ ደንዴሱ። <verse eid="NUM 18:31"/><verse number="32" style="v" sid="NUM 18:32"/>ቆደሳ ከን ዋን ሁንደ ጫሉ ሰነ ዽኤሱዻን እስን ዋን ከነ ኬሰት የከ ህንቀባተን፤ ዮስ እስን ኣርሳ እስራኤሎታ ቁልቁሉ ሰነ ህንጡሬስተን፤ ህንዱተንስ።’ ”<verse eid="NUM 18:32"/></para>
  <chapter eid="NUM 18"/>
  <chapter number="19" style="c" sid="NUM 19"/>
  <para style="s1">ብሻን እቲን ቁልቁላአን</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 19:1"/>
    <char style="nd">ዋቀዮ</char> ሙሴፊ አሮኒን አከነ ጄዼ፦ <verse eid="NUM 19:1"/><verse number="2" style="v" sid="NUM 19:2"/>“ሴር <char style="nd">ዋቀዮ</char> አጀጄ ከነ፦ አከ እስራኤሎን ጎሮምሰ ዲምቱ ህርእነ ዮካን ሀንቅነ ህንቀብኔ ከን ተኩማ ዋንጆን ሞርመሼ ህንቱቅን ቶኮ ሲፍ ፍደን እት ህም። <verse eid="NUM 19:2"/><verse number="3" style="v" sid="NUM 19:3"/>ጎሮምሰ ሰነስ ኤሌኣዛር ሉብቸት ኬና፤ ራድ ሱንስ ቁበተ ኬሳ ገድ ባፈምቴ ፉለሳ ዱረት ሃቀለምቱ። <verse eid="NUM 19:3"/><verse number="4" style="v" sid="NUM 19:4"/>ኤሌኣዛር ሉብች ቁበሳቲን ዺገ ጎሮምሰ ሰናራ ጥኖ ፉዼ ዱንካነ ወል ገኢ ዱረት ዬሮ ቶርበ ሃፈጫሱ። <verse eid="NUM 19:4"/><verse number="5" style="v" sid="NUM 19:5"/>ኡቱመ እን እላሉ ጎጋን፣ ፎን፣ ዺግኒፊ ጩማን ጎሮምሰ ሰና ሃጉበሙ። <verse eid="NUM 19:5"/><verse number="6" style="v" sid="NUM 19:6"/>ሉብን ሱን ቆራን ብርብርሳ፣ ሂሶጲፊ ክሪ ብልዲማ ጎሮምሰ ጉበምቱ ሰነት ሃደርበቱ። <verse eid="NUM 19:6"/><verse number="7" style="v" sid="NUM 19:7"/>ሉብን ሱን ኤርገሲ ወያ ኦፊሳ ሚጨቴ ዸግነ ኦፊሳሌ ብሻኒን ዽቀቹ ቀበ። እንስ ቁበተት ገሉ ደንደአ፤ ገሩ ሀመ ገልገላት አከ ሴራት ጡራኣ ተኤ ቱረ። <verse eid="NUM 19:7"/><verse number="8" style="v" sid="NUM 19:8"/>ነምች ጎሮምሰ ሰነ ጉቡስ ወያሳ ሚጨቴ ዸግነሳ ብሻኒን ሃዽቀቱ፤ እንስ ሀመ ገልገላት ጡራኤ ቱረ።<verse eid="NUM 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 19:9"/>“ነምን ቁልቁሉን ቶኮ ዳራ ጎሮምሰ ሰና ወልት ሀሬ ቁበተ ኬሳ ባሴ እዶ ሴራን ቁልቁሉ ተኤ ቶኮ ሃካኡ። ዳራ ከነስ ወልዳን እስራኤል ብሻን እቲን ቁልቁሌሰን ወጅን እት ፈየደሙዻፍ ኦል ካአተ፤ እንስ ጩቡራ ቁልቁሌፈሙፍ ፈየደ። <verse eid="NUM 19:9"/><verse number="10" style="v" sid="NUM 19:10"/>ነምን ዳራ ጎሮምሰ ሰና ወልት ሀሩ ሱንስ ወያ ኦፊሳ ሚጨቹ ቀበ፤ እንስ አከሱመ ሀመ ገልገላት ጡራኣ ተአ። ኩንስ እስራኤሎታፊ አለጎተ ግዱሳኒ ጅራተኒፍ ሴረ በረ በራ ተአ።<verse eid="NUM 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 19:11"/>“ነምን ሬፈ ነመ ከሚዩ ቱቁ ቡልቲ ቶርበ ጡራኣ ተአ። <verse eid="NUM 19:11"/><verse number="12" style="v" sid="NUM 19:12"/>እን ጉያ ሰደፋፊ ጉያ ቶርበፋት ብሻኒን ኦፍ ቁልቁሌሱ ቀበ፤ ኤርገሲ ቁልቁሉ ተአ። ገሩ ዮ ጉያ ሰደፋፊ ቶርበፋት ኦፍ ቁልቁሌሱ ባቴ እን ህንቁልቁላኡ። <verse eid="NUM 19:12"/><verse number="13" style="v" sid="NUM 19:13"/>ነምን ሬፈ ነመ ከሚዩ ቱቄ ኦፍ ህንቁልቁሌስን ሁንድ ዱንካነ <char style="nd">ዋቀዮ</char> ቁልቁልቸ ሰነ ጡሬሰ። ነምን ሱን ሰበ እስራኤል ኬሳ ንበሌፈመ። ሰበቢ ብሻን እቲን ቁልቁሌሰን እሰት ህንፈጫፈምኒፍ እን ጡራኣዸ፤ ጡራኡማንሳስ እሱመረት ሀፈ።<verse eid="NUM 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 19:14"/>“ዬሮ ነምን ቶኮ ዱንካነ ኬሰት ዱኡት ሴር ከነ፦ ነምን ዱንካነ ሰነ ሴኑ ሁንዲፊ ነምን ዱንካነ ኬሰ ጅሩ ሁንድ ቡልቲ ቶርባፍ ጡራኣ ተአ፤ <verse eid="NUM 19:14"/><verse number="15" style="v" sid="NUM 19:15"/>ቆዳን አፋን በና ከን ቀዳድን ጀቤፈሜ እት ህንቀዳደምን ሁንድ ጡራኣ ተአ።<verse eid="NUM 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 19:16"/>“ነምን አለት ነመ ጎራዴዻን አጄፈሜ ዮካን ነመ ኦፉማን ዱኤ ቱቁ ከምዩ ዮካን ነምን ለፌ ነማ ዮካን አዋለ ቱቁ ከምዩ ቡልቲ ቶርባፍ ጡራኣ ተአ።<verse eid="NUM 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 19:17"/>“ነመ ጡራኣፍ ኣርሳ እቲን ቁልቁሌሱፍ ጉበሜ ሰነራ ዳራ ጥናሳ ፉዺ ኦኮቴ ቶኮት ነቂቲ ብሻን ያኡ እት ዸንገላስ። <verse eid="NUM 19:17"/><verse number="18" style="v" sid="NUM 19:18"/>ኤርገሲስ ነምን አከ ሴራት ቁልቁሉ ተኤ ሂሶጲ ጥናሳ ፉዼ ብሻን ሰነ ኬሰ ጩጴ ዱንካናፊ ምአሳ ሁንደት፣ ነሞተ አች ቱረንትስ ሃፈፈጫሱ። አከሱመስ ነመ ለፌ ነማ ዮካን አዋለ ዮካን ነመ አጄፈሜ ዮካን ነመ ኦፉማን ዱኤ ቱቄት ሃፈፈጫሱ። <verse eid="NUM 19:18"/><verse number="19" style="v" sid="NUM 19:19"/>ነምች ቁልቁሉን ሱን ጉያ ሰደፋፊ ቶርበፋት ነምቸ ጡራኣ ሰነት ሃፈፈጫሱ፤ ጉያ ቶርበፋትሞ እሰ ቁልቁሌሱ ቀበ። ነምች ቁልቁሌፈሙ ሱን ወያ ኦፊሳ ሚጨቹ፣ ዸግነ ኦፊሳስ ብሻኒን ዽቀቹ ቀበ፤ እንስ ገልገለ ሰነ ቁልቁሉ ተአ። <verse eid="NUM 19:19"/><verse number="20" style="v" sid="NUM 19:20"/>ገሩ ነምን ጡራኣን ዮ ኦፍ ቁልቁሌሱ ባቴ፣ እን ሰበቢ እዶ ቁልቁሉ <char style="nd">ዋቀዮ</char> ጡሬሴፍ ወልዳ ኬሳ ንበሌፈመ። ብሻን እቲን ቁልቁሌሰን ሱን እሰት ህንፈጫፈምኔቲ እን ጡራኣዸ። <verse eid="NUM 19:20"/><verse number="21" style="v" sid="NUM 19:21"/>ኩን እሳኒፍ ሴረ በረ በራት።</para>
  <para style="p" vid="NUM 19:21">“ነምች ብሻን እቲን ቁልቁሌሰን ፈፈጫሱ ሱን ወያ ኦፊሳ ሃሚጨቱ፤ ነምን ብሻን እቲን ቁልቁሌሰን ቱቁ ሀመ ገልገላት ጡራኣ ተአ። <verse eid="NUM 19:21"/><verse number="22" style="v" sid="NUM 19:22"/>ወን ነምን ጡራኣን ቶኮ ቱቁ ከምዩ ጡራኣ ተአ፤ ነምን ዋን ሰነ ቱቁ ሀመ ገልገላት ጡራኣ ተአ።”<verse eid="NUM 19:22"/></para>
  <chapter eid="NUM 19"/>
  <chapter number="20" style="c" sid="NUM 20"/>
  <para style="s1">ብሻን ከታ ኬሳ ቡርቄ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 20:1"/>ጅአ ጀልቀባት ወልዳን እስራኤሎታ ጉቱን ገሞጂ ሲን ገኤ፤ እሳንስ ቃዴሽ ኬሰ ቱረን። ሚርያምስ አችት ዱቴ አዋለምቴ።<verse eid="NUM 20:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 20:2"/>ወልዳን ሱን ብሻን ህንቀቡ ቱሬ፤ ከናፉ ወልዳን ሱን ሙሴፊ አሮኒን ሞርሙፍ ወልት ቀበሜ። <verse eid="NUM 20:2"/><verse number="3" style="v" sid="NUM 20:3"/>እሳንስ አከነ ጄዸኒ ሙሴፊ አሮኒን ሎለን፤ “ማሎ ኡቱ ኑስ ጋፉመ ኦቦሎትንኬኘ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዱአን ሰነ ዱኔ ጅራትኔ! <verse eid="NUM 20:3"/><verse number="4" style="v" sid="NUM 20:4"/>እስን ማሊፍ ወልዳ <char style="nd">ዋቀዮ</char> ገሞጂ ከነት ፍደን? አከ ኑፊ ሆሪንኬኘ አስት ዹምኑፊ? <verse eid="NUM 20:4"/><verse number="5" style="v" sid="NUM 20:5"/>ማሊፍ ብየ ግብጢቲ እዶ ሀማ ከነት ገድ ኑ ባፍተን? እዶን ኩን ምዻን ዮካን ሀርቡ ዮካን እጀ ወይኒ ዮካን ሮማኒ ህንቀቡ። ብሻን ዹጋቲስ ህንጅሩ!”<verse eid="NUM 20:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 20:6"/>ሙሴፊ አሮን ወልዳ ብራ ገረ በልበለ ዱንካነ ወል ገኢ ዴመኒ አዳን ለፈት ጎምብፈመን፤ ኡልፍን <char style="nd">ዋቀዮስ</char> እሳንት ሙልአቴ። <verse eid="NUM 20:6"/><verse number="7" style="v" sid="NUM 20:7"/><char style="nd">ዋቀዮስ</char> ሙሴዻን አከነ ጄዼ፤ <verse eid="NUM 20:7"/><verse number="8" style="v" sid="NUM 20:8"/>“ኡሌ ሰነ ፉዺቲ፣ አቲፊ ኦቦሌስኬ አሮንስ ወልዳ ወልት ቀባ። ፉሉመሳኒ ዱረትስ ከታ ሰነት ዱበዻ፤ ከታን ሱንስ ብሻን ባሰ። አትስ ከታ ሰነ ኬሳ ወልዳዻፍ ብሻን ባፍተ፤ አከሲን እሳኒፊ ሆሪንሳኒ ብሻን ዹጉ ደንደኡ።”<verse eid="NUM 20:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 20:9"/>ከናፉ ሙሴን አኩመ እን እሰ አጀጄ ሰነት ኡሌ ፉለ <char style="nd">ዋቀዮ</char> ዱረ ጅሩ ሰነ ፉዼ። <verse eid="NUM 20:9"/><verse number="10" style="v" sid="NUM 20:10"/>ሙሴፊ አሮን ከታ ሰነ ዱረት ወልዳ ወልት ቀበን፤ ሙሴንስ ወልዳ ሰናን፣ “ፍንጭልቶተነነ፣ ሜ ዸገኣ፤ ኑ ከታ ከነ ኬሳ ብሻን እስኒ ባሱ ቀብና?” ጄዼ። <verse eid="NUM 20:10"/><verse number="11" style="v" sid="NUM 20:11"/>ሙሴን ሀርከ ኦል ፉዸቴ ኡሌሳ ሰናን ዬሮ ለመ ከታ ሰነ ዸኤ። ብሻን አች ኬሳ ሎላናን ወልዳፊ ሆሪንሳኒ ዹገን።<verse eid="NUM 20:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 20:12"/>
    <char style="nd">ዋቀዮ</char> ገሩ ሙሴፊ አሮኒን አከነ ጄዼ፤ “ሰበቢ እስን ፉለ እስራኤሎታ ዱረት አከ ቁልቁሉማኮቲት ነ ከበጀኒ ነት አመኑ ድደኒፍ፣ እስን ብየ አን እሳኒ ኬኔ ሰነት ወልዳ ከነ ህንገልችተን።”<verse eid="NUM 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 20:13"/>ኩን ብሻን መሪባ፣ ለፈ እስራኤሎን እት <char style="nd">ዋቀዮን</char> ወል ዸበኒፊ ለፈ እን እት አከ ቁልቁሉ ተኤ ግዱሳኒት ኦፍ አርግሲሴት።<verse eid="NUM 20:13"/></para>
  <para style="s1">ኤዶም እስራኤልን ከራ ደርቡ ዾዌ</para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 20:14"/>ሙሴን አከነ ጄዼ ቃዴሽራ ሞቲ ኤዶሚት ኤርገሞተ ኤርጌ፦</para>
  <para style="pm" vid="NUM 20:14">“ኦቦሌስኬ እስራኤል አከነ ጄዸ፦ አት ዋኤ ረክነ ኑት ዹፌ ሁንዳ ንቤክተ። <verse eid="NUM 20:14"/><verse number="15" style="v" sid="NUM 20:15"/>አቦቲንኬኘ ግብጥት ገድ ቡአን፤ ኑስ ወጋ ሄዱ አች ጅራትኔ። ወር ግብጥስ ኑፊ አቦቲኬኘ ጩንቁርሰን፤ <verse eid="NUM 20:15"/><verse number="16" style="v" sid="NUM 20:16"/>ገሩ ኑ <char style="nd">ዋቀዮት</char> እየትናን፣ እን ኑ ዸገኤ ኤርገማሳ ኤርጌ ብየ ግብጢ ኑ ባሴ።</para>
  <para style="pm" vid="NUM 20:16">“ኑ አመ አስ ቃዴሽት ጄቹንስ መጋላ ዳሪ ብየኬቲረ ጅሩ ቶኮ ኬሰ ጅረ። <verse eid="NUM 20:16"/><verse number="17" style="v" sid="NUM 20:17"/>ማሎ ሜ አከ ብየኬ ኬሰ ባኔ ደበሩ ኑ ኤየም። ኑ ለፈ ቆቲሳ ዮካን እዶ ዻባ ወይኒ ቶኮ ኬሰዩ ህንያኑ ዮካን ብሻን ቦለ ብሻኒ ቶኮዩ ስ ዱራ ህንዹግኑ። ኑ ከራ ሞትቻረ ጎዳነ መሌ ሀመ ዳሪኬ ኬሳ ባኑት ብታ ምርገት ህንጎሩ።”<verse eid="NUM 20:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 20:18"/>ኤዶምሞ አከነ ጄዼ ዴቢ ኬኔ፦</para>
  <para style="pm" vid="NUM 20:18">“እስን አሲን ደርቡ ህንደንዴሰን፤ ዮ ደርቡ ያልተንሞ ኑ እስንት ካኔ ጎራዴዻን እስን ዾፍነ።”<verse eid="NUM 20:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 20:19"/>እስራኤሎንስ አከነ ጄዸኒ ዴቢ ኬነን፦</para>
  <para style="pm" vid="NUM 20:19">“ኑ ከሩመ ጉድቸረ ያነ፤ ዮ ኑ ዮካን ሆሪንኬኘ ብሻንኬሰን ከምዩ ዹጌ፣ ኑ ገቲ እስኒፍ ከፈለ። ኑ ሚለ ቆፋን ያኔ ደርቡ ፌነ፤ ከነ መሌ ዋን ብራ ህንፌኑ።”<verse eid="NUM 20:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 20:20"/>እሳን አመሌ አከነ ጄዸኒ ዴብሰን፦</para>
  <para style="pm" vid="NUM 20:20">“እስን አሲን ህንደበርተን።”</para>
  <para style="p" vid="NUM 20:20">ኤዶምስ ሎልቶተ ባይኤፊ ጀጀቦ ፉዸቴ እሳንት ገድ በኤ። <verse eid="NUM 20:20"/><verse number="21" style="v" sid="NUM 20:21"/>ሰበቢ ኤዶም ብየ ኦፊሳ ኬሳን ደርቡ እሳን ዾዌፍ እስራኤሎን እሳንራ ዴብአን።<verse eid="NUM 20:21"/></para>
  <para style="s1">አሮን ዱኡሳ</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 20:22"/>ሰብን እስራኤል ሁንድኑ ቃዴሺ ከኤ ቱሉ ሆር ገኤ። <verse eid="NUM 20:22"/><verse number="23" style="v" sid="NUM 20:23"/><char style="nd">ዋቀዮስ</char> ቱሉ ሆር ጭነት ዳንጋ ኤዶም ብረት ሙሴፊ አሮኒን አከነ ጄዼ፤ <verse eid="NUM 20:23"/><verse number="24" style="v" sid="NUM 20:24"/>“አሮን ገረ አቦቲሳት ወልት ቀበመ። ሰበቢ እስን ለቹ ብሻን መሪባ ብረት አጀጀኮት ፍንጭልተኒፍ፣ እን ብየ አን እስራኤሎታፍ ኬኑት ህንገሉ። <verse eid="NUM 20:24"/><verse number="25" style="v" sid="NUM 20:25"/>አሮኒፊ እልመሳ ኤሌኣዛር ፉዺቲ ቱሉ ሆርት ኦል ባስ። <verse eid="NUM 20:25"/><verse number="26" style="v" sid="NUM 20:26"/>አሮንራ ኡፈተሳ ባሲቲ እልመሳ ኤሌኣዛርት ኡፍስ፤ አሮን ገረ አቦቲሳት ወልት ቀበማቲ። እን አችት ዱአ።”<verse eid="NUM 20:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 20:27"/>ሙሴን አኩመ <char style="nd">ዋቀዮ</char> እሰ አጀጄ ሰነ ጎዼ፦ እሳንስ ኡቱመ ወልዳን እስራኤል ጉቱን እላሉ ቱሉ ሆርት ኦል በአን። <verse eid="NUM 20:27"/><verse number="28" style="v" sid="NUM 20:28"/>ሙሴንስ ኡፈተ አሮንራ ባሴ እልመሳ ኤሌኣዛርት ኡፍሴ። አሮንስ አቹመ ቱሉ ሰነ ጉባት ዱኤ። ሙሴፊ ኤሌኣዛርስ ቱሉ ሰነራ ገድ ቡአን፤ <verse eid="NUM 20:28"/><verse number="29" style="v" sid="NUM 20:29"/>ዮሙ ወልዳን እስራኤል ሁንድ አከ አሮን ዱኤ ዸገኤት መን እስራኤል ጉቱን ቡልቲ ሶዶመ ቦኤፍ።<verse eid="NUM 20:29"/></para>
  <chapter eid="NUM 20"/>
  <chapter number="21" style="c" sid="NUM 21"/>
  <para style="s1">ኣራድ በርበዶፍቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 21:1"/>ሞቲን ኣራድ ነምች ከነኣን ከን ኔጌብ ኬሰ ጅራቱ ሱን አከ እስራኤል ከራ አታሪምረ ዹፋ ጅሩ ዸጌኛን እስራኤሎተ ሎሌ እሳን ኬሳ ነመ ቶኮ ቶኮ ቦጅኤ። <verse eid="NUM 21:1"/><verse number="2" style="v" sid="NUM 21:2"/>እስራኤሎንስ፣ “ዮ አት ሰበ ከነ ደበርስቴ ሀርከኬኘት ኬንቴ፣ ኑ ጉቱማን ጉቱት መጋላሳኒ በርበዴስነ” ጄዸኒ <char style="nd">ዋቀዮፍ</char> ወሬገን። <verse eid="NUM 21:2"/><verse number="3" style="v" sid="NUM 21:3"/><char style="nd">ዋቀዮስ</char> እየ እስራኤል ዸገኤ ወረ ከነኣን ደበርሴ ሀርከሳኒት ኬኔ። እስራኤሎትንስ እሳኒፊ መጋላወንሳኒሌ ጉቱማን ጉቱት በርበዴሰን፤ ከናፉ እዶን ሱን ሆርማ ጄዸሜ ዋመሜ።<verse eid="NUM 21:3"/></para>
  <para style="s1">ቦፈ ናሲራ ሆጄተሜ</para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 21:4"/>እሳንስ ኤዶም ዱባን ደርበኒ ዴሙፍ ጄዸኒ ጋረ ሆሪ ከአኒ ከራ ገላነ ዲማት ጌሱረ ቀጄለን። ሰብን ሱን ገሩ ከሩመት ኦብሰ ፍጠቴ፤ <verse eid="NUM 21:4"/><verse number="5" style="v" sid="NUM 21:5"/>እሳንስ ዋቃፊ ሙሴዻን ሞርመኒ አከነ ጄቹዻን ዱበተን፤ “እስን ማሊፍ አከ ገሞጂ ኬሰት ዹምኑፍ ብየ ግብጢ ኑ ባፍተን? ቡዴን ህንጅሩ! ብሻን ህንጅሩ! ኑስ ኛተ በልፈማ ከነ ጅብኔረ!”<verse eid="NUM 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 21:6"/>
    <char style="nd">ዋቀዮስ</char> ቦፈወን ሀዻ ቀበን ግዱሳኒት ኤርጌ፤ ቦፈወን ሱንስ እሳን እደኒ እስራኤሎን ባይኤን ዹመን። <verse eid="NUM 21:6"/><verse number="7" style="v" sid="NUM 21:7"/>ሰብን ሱንስ ገረ ሙሴ ዹፌ አከነ ጄዼ፤ “ኑ ዬሮ <char style="nd">ዋቀዮፊ</char> ስት አፋን ደበሬ ሰነ ጩቡ ሆጄትኔ። አከ <char style="nd">ዋቀዮ</char> ቦፈወን ከኔን ኑራ ፈጌሱፍ ኑፍ ከዸዹ።” ሙሴን ሰበ ሰናፍ ከዸቴ።<verse eid="NUM 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 21:8"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ “ቦፈ ቶኮ ቶልቺቲ ኡቱባት ፈንስ፤ ነምን ቦፍን እዴ ከምዩ ቦፈ አት ቶልችቴ ሰነ እላሌ ጅራቹ ደንደአ።” <verse eid="NUM 21:8"/><verse number="9" style="v" sid="NUM 21:9"/>ሙሴን ቦፈ ናሲ ቶኮ ቶልቼ ኡቱባት ፈንሴ። ኤርገሲስ ነምን ቦፍት እዴ ከምዩ ዬሮ ቦፈ ናሲ ሰነ እላሉ ንጅራተ ቱሬ።<verse eid="NUM 21:9"/></para>
  <para style="s1">እስራኤሎትን ብየ ሞኣብት ቀጄለን</para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 21:10"/>እስራኤሎን ፉለ ዱረት ቀጄለኒ ኦቦት ኬሰ ቁበተን። <verse eid="NUM 21:10"/><verse number="11" style="v" sid="NUM 21:11"/>ኤርገሲስ ኦቦቲ ከአኒ እዬ አባሪም ለፈ ከራ በአ ቢፍቱቲን ፉሌ ሞኣብት ገሞጂ ኬሰት አርገሙ ቁበተን። <verse eid="NUM 21:11"/><verse number="12" style="v" sid="NUM 21:12"/>አቺስ ከአኒ ሱሉለ ዜሬድ ኬሰ ቁበተን። <verse eid="NUM 21:12"/><verse number="13" style="v" sid="NUM 21:13"/>አቺ ከአኒስ ዳሪ አርኖን ለፈ ገሞጂ ኬሳ ከን ቡልቺንሰ አሞሮታ ኬሰ ሴንቱ ሰነረ ቁበተን። አርኖን ለፈ ዳሪ ሞኣብራ ከን ሞኣቢፊ አሞር ግዱ ጅርቱዸ። <verse eid="NUM 21:13"/><verse number="14" style="v" sid="NUM 21:14"/>ሰበቢን ክታብን ወራነ <char style="nd">ዋቀዮ</char> አከነ ጄዹፍ ከነ፦</para>
  <para style="q1" vid="NUM 21:14">“ዋሄብ ሱፋ ኬሳፊ ለጌን፣</para>
  <para style="q2" vid="NUM 21:14">አርኖኒፊ <verse eid="NUM 21:14"/><verse number="15" style="v" sid="NUM 21:15"/>እራን-ገዴ ሱሉላ</para>
  <para style="q1" vid="NUM 21:15">ከን ገረ ኣርት ጌሱፊ</para>
  <para style="q2" vid="NUM 21:15">ዳሪ ሞኣብ እረት አርገሙ።”<verse eid="NUM 21:15"/></para>
  <para style="m">
    <verse number="16" style="v" sid="NUM 21:16"/>አቺ ከአኒ ገረ ብኤር ቦለ ብሻኒ ከን <char style="nd">ዋቀዮ</char> ሙሴዻን፣ “ሰበ ወልት ቀብ፤ አን ብሻን ኬናፊ” ጄዼ ሰና ከራሳኒ እት ፉፈን።<verse eid="NUM 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 21:17"/>እስራኤልስ ፋርፈትና ከነ ፋርፈቴ፦</para>
  <para style="q1" vid="NUM 21:17">“ያ ቦለ ብሻኒነነ፣ ቡርቅ!</para>
  <para style="q2" vid="NUM 21:17">እስንስ ዋኤሳ ፋርፈዻ፤<verse eid="NUM 21:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="NUM 21:18"/>ቦለ ብሻኒ እልማን ሞቲ ቆተን፣</para>
  <para style="q2" vid="NUM 21:18">ከን ከበጀሞን ሰባ፣</para>
  <para style="q2" vid="NUM 21:18">ቀጄልቸ ወረ ሴረ ኬኑቲን ኡሌሳኒቲን ቆተን ፋርፈዻ።”</para>
  <para style="m" vid="NUM 21:18">እሳን ኤርገሲ ገሞጂ ሰነ ኬሳ በአኒ መታና ዸቀን፤ <verse eid="NUM 21:18"/><verse number="19" style="v" sid="NUM 21:19"/>መታናዻ ከአኒ ነሃልኤል ዸቀን፤ ነሃልኤሊ ከአኒ ባሞት ዸቀን፤ <verse eid="NUM 21:19"/><verse number="20" style="v" sid="NUM 21:20"/>ባሞቲሞ ከአኒ ሱሉለ ሞኣብ፣ እዶ እት ፊጤን ጵስጋ ገሞጂት ገረገልቱ ቁበተን።<verse eid="NUM 21:20"/></para>
  <para style="s1">ሞአተሙ ስሆኒቲፊ ኦግ</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 21:21"/>እስራኤልስ ስሆን ሞትቸ አሞሮታቲን አከነ ጄቹፍ ኤርገሞተ ኤርገቴ፦<verse eid="NUM 21:21"/></para>
  <para style="pm">
    <verse number="22" style="v" sid="NUM 21:22"/>“አከ ኑ ብየኬ ኬሳን ደርብኑ ኑፍ ኤየም። ኑ ለፈ ቆቲሳ ዮካን እዶ ዻባ ወይኒ ቶኮትዩ ህንጎሩ ዮካን ብሻን ቦለ ብሻኒ ቶኮሌ ህንዹግኑ። ኑ ሀመ ብየኬ ኬሳ ባኑት ከራ ሞትቻረ ያነ።”<verse eid="NUM 21:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 21:23"/>ስሆን ገሩ አከ እስራኤል ብየሳ ኬሰ በኤ ደርቡ ህንኤየምኔ። እንስ ሎልቶተ ኦፊ ጉቱ ወልት ቀበቴ እስራኤልን ሎሉፍ ገሞጂት ገድ በኤ። ዮሙ ያሀዝ ገኤትስ እስራኤሊን ወል ሎሌ። <verse eid="NUM 21:23"/><verse number="24" style="v" sid="NUM 21:24"/>እስራኤል ገሩ ጎራዴዻን እሰ አጄሴ አርኖኒ ጀልቀቤ ሀመ ያቦቅ ገኡት ብየሳ ቀበቴ፤ ገሩ ሰበቢ ደላን ዳንጋ አሞሮታ ጀባ ቱሬፍ እን ሀመ ዳንጋ አሞኖታ ቆፈት ዴሙ ደንደኤ። <verse eid="NUM 21:24"/><verse number="25" style="v" sid="NUM 21:25"/>እስራኤልስ መጋላወን አሞሮታ ሁንደ፣ ሄሽቦኒፊ ቁበተወን ናኖሼ ጅረን ሁንደ ቀበቴ ኬሰ ቁበቴ። <verse eid="NUM 21:25"/><verse number="26" style="v" sid="NUM 21:26"/>ሄሽቦን ኩን መጋላ ስሆን ሞቲ አሞሮታ እሰ ሞትቸ ሞኣብ ከን ዱራ ሎሌ ብየሳ ሁንደ ሀመ አርኖንትራ ፉዸቴ ሰና ቱሬ።<verse eid="NUM 21:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 21:27"/>ሰበቢን ዌልስቶትን አከነ ጄዸኒፍ ከነ፦</para>
  <para style="q1" vid="NUM 21:27">“ገረ ሄሽቦን ኮታ፤ እሼን ዴብቴ ሃእጃረምቱ፤</para>
  <para style="q2" vid="NUM 21:27">መጋላን ስሆንስ ሃሃሮምፈምቱ።<verse eid="NUM 21:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="NUM 21:28"/>“ሄሽቦን ኬሳ እብድ፣</para>
  <para style="q2" vid="NUM 21:28">መጋላ ስሆን ኬሳ አረብን እብዳ በኤ።</para>
  <para style="q1" vid="NUM 21:28">እብድ ሱን ኣር መጋላ ሞኣብ፣</para>
  <para style="q2" vid="NUM 21:28">ጅራቶተ ጋረ አርኖኒስ ጉቤ በርበዴሴ።<verse eid="NUM 21:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="NUM 21:29"/>ያ ሞኣብ፣ ሲፍ ወዮ!</para>
  <para style="q2" vid="NUM 21:29">ያ ወረ ኬሞሽ፣ እስን በርበዶፍተኒርቱ!</para>
  <para style="q1" vid="NUM 21:29">እን እልማንሳ አከ በቀቶታት፣</para>
  <para style="q2" vid="NUM 21:29">እንተለንሳሞ አከ ቦጅአምቶታት፣</para>
  <para style="q2" vid="NUM 21:29">ስሆን ሞቲ አሞሮታት ደበርሴ ኬኔረ።<verse eid="NUM 21:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="NUM 21:30"/>“ኑ ገሩ እሳን ገረገልችኔረ፤</para>
  <para style="q2" vid="NUM 21:30">ሄሽቦን ሀመ ዲቦንት በርበዶፍቴርት።</para>
  <para style="q1" vid="NUM 21:30">ኑስ ሀመ ኖፋ እሼ ገረ ሜዴባት ድሪርቱ ሰናት</para>
  <para style="q2" vid="NUM 21:30">እሳን በርበዴስኔረ።”<verse eid="NUM 21:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 21:31"/>አከሲን እስራኤል ብየ አሞር ኬሰ ቁበቴ።<verse eid="NUM 21:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 21:32"/>ሙሴን የእዜርት በሳስቶተ ኤርጌ፤ እሳንስ ቁበተወን ናኖሼ ቀበተኒ አሞሮተ አች ኬሰ ጅራቻ ቱረን አርአኒ ባሰን። <verse eid="NUM 21:32"/><verse number="33" style="v" sid="NUM 21:33"/>እሳንስ ኤርገሲ ዴብአኒ ከራ ባሻን ቀበተኒ ኦል በአን፤ ኦግ ሞትች ባሻኒቲፊ ሎልቶትንሳ ጉቱን ኤድሬዪት እሳኒን ወል ሎሉፍ እት ገድ በአን።<verse eid="NUM 21:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 21:34"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ “ሰበቢ አን ጉቱ ሎልቶተሳቲፊ ብየሳሌ ደበርሴ ሀርከኬት ኬኔፍ እሰ ህንሶዳትን። ዋኑመ ስሆን ሞቲን አሞሮታ ከን ሄሽቦን ቡልቻ ቱሬ ሰነ ጎቴ እሰሌ ጎዽ።”<verse eid="NUM 21:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 21:35"/>እሳን እሰ፣ እልማንሳቲፊ ሎልቶተሳ ሁንደ ኡቱ ነመ ቶኮሌ ህንሀምብስኒፍ ዸአኒ ብየሳሌራ ፉዸተን።<verse eid="NUM 21:35"/></para>
  <chapter eid="NUM 21"/>
  <chapter number="22" style="c" sid="NUM 22"/>
  <para style="s1">ባላቅ በለኣምን ዋሜ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 22:1"/>እስራኤሎን ገረ ድሬ ሞኣብት ቀጄለኒ ዬርኮን ገመ ቀርቀረ ዮርዳኖስ ቁበተን።<verse eid="NUM 22:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 22:2"/>ባላቅ እልም ዝጶር ዋን እስራኤል አሞሮተት ሆጄቴ ሁንደ አርጌ፤ <verse eid="NUM 22:2"/><verse number="3" style="v" sid="NUM 22:3"/>ሞኣብስ ዋን ሰብን ሱን አከ መሌ ባይኤ ተኤፍ ንሶዳቴ። ሞኣብስ ሰበቢ እስራኤሎታቲፍ ራፈሜ።<verse eid="NUM 22:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 22:4"/>ወር ሞኣብስ ማንጉዶተ ምድያኒን፣ “ነሞትን ባይኤን ኩኔን አኩመ ቆትዮን መርገ በኬ ዼዴ ፍጡ ሰነ ዋን ናኖኬኘ ጅሩ ዼዴ ፍጠ” ጄዸን።</para>
  <para style="p" vid="NUM 22:4">ከነረት ባላቅ እልም ዝጶር ከን ዬሮ ሰነ ሞቲ ሞኣብ ቱሬ ሱን፣ <verse eid="NUM 22:4"/><verse number="5" style="v" sid="NUM 22:5"/>አከ እሳን በለኣም እልመ ቤኦር ከን ብዩመ እት ዸለቴ ኬሰ ለገ ኤፍራጢስ ብረ ጴቶር ኬሰ ጅራቻ ቱሬ ሰነ ዋመኒፍ ኤርገሞተ ኤርጌ። ባላቅስ አከነ ጄዼ፦</para>
  <para style="pm" vid="NUM 22:5">“ኩኖ፣ ሰብን ቶኮ ብየ ግብጢ በኤ ዹፌረ፤ ኩኖ እሳን ለፈ ጉተኒ ነት ኣነኒ ቁበተኒሩ። <verse eid="NUM 22:5"/><verse number="6" style="v" sid="NUM 22:6"/>ሰበቢ እሳን ነ ጫላ ሁምነ ቀበኒፍ አመ ኮቱቲ እሳን አባር። ዮስ አን እሳን ሞአዼ ብየ ኬሳ አርኤ እሳን ባሱ ነንደንደአ ተአ። አን አከ ወር አት ኤብፍቱ ኤብፈመን፣ ወር አት አባርቱስ አባረመን ነንቤካቲ።”<verse eid="NUM 22:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 22:7"/>ማንጉዶትን ሞኣቢፊ ምድያን ሱን ከአኒ ከፈልቲ ሞርቱ ሰና ፉዸተኒ ዴመን። እሳንስ ዮሙ በለኣም ብረ ገአንት ዋን ባላቅ ጄዼን ሰነ እት ህመን።<verse eid="NUM 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 22:8"/>በለኣምስ፣ “ሀልከን ከነ አሱመ ቡላ፤ አንስ ዴቢ <char style="nd">ዋቀዮ</char> ናፍ ኬኑ እስንት ነንህመ” ጄዼን። ቆንዳልቶትን ሞኣብ ሱን እሱመ ብረ ቱረን።<verse eid="NUM 22:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 22:9"/>ዋቅን ገረ በለኣም ዹፌ፣ “ነሞትን ስ ወጅን ጅረን ኩኔን ኤኙ?” ጄዼ ጋፈቴ።<verse eid="NUM 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 22:10"/>በለኣምስ አከነ ጄዼ ዋቃፍ ዴቢ ኬኔ፤ “ባላቅ እልም ዝጶር፣ ሞትች ሞኣብ አከነ ጄዼ ኤርጋ ከነ ነት ኤርጌ፦ <verse eid="NUM 22:10"/><verse number="11" style="v" sid="NUM 22:11"/>‘ኩኖ፣ ሰብን ብየ ግብጢ በኤ ዹፌ ቶኮ ለፈ ጉቴረ፤ አት አመ ኮቱቲ እሳን ናፍ አባር። ዮስ አን እሳን ሎሌ አርኤ ብያ ባሱ ነንደንደአ ተኣቲ።’ ”<verse eid="NUM 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 22:12"/>ዋቀዮ ገሩ በለኣሚን፣ “እሳን ወጅን ህንዴምን። ሰበቢ እሳን ኤብፈሞ ተአኒፍ አት ሰበ ሰነ ህንአባርን” ጄዼ።<verse eid="NUM 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 22:13"/>በለኣም ገነመ እት ኣኑ ከኤ ቆንዳልቶተ ባላቂን፣ “ሰበቢ <char style="nd">ዋቀዮ</char> እስን ወጅን ዴሙ ነ ዾዌፍ፣ እስን አመ ከኣ ብየኬሰንት ዴብኣ” ጄዼ።<verse eid="NUM 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 22:14"/>ቆንዳልቶትን ሞኣብ ገረ ባላቅት ዴብአኒ፣ “በለኣም ኑ ወጅን ዹፉ ድዴ” ጄዸኒን።<verse eid="NUM 22:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 22:15"/>ባላቅስ ቆንዳልቶተ ወረ ዱራ ሰነ ጫላ ባይኤፊ ጫላ ቤቤከሞ ከን ብራ ኤርጌ። <verse eid="NUM 22:15"/><verse number="16" style="v" sid="NUM 22:16"/>እሳንስ ዹፈኒ በለኣሚን አከነ ጄዸን፦</para>
  <para style="pm" vid="NUM 22:16">“ወን ባላቅ እልም ዝጶር ጄዹ ኩኖ ከነ፦ ‘ማሎ ወን ቶኮዩ ገረኮ ዹፉ ስ ህንዾውን፤ <verse eid="NUM 22:16"/><verse number="17" style="v" sid="NUM 22:17"/>አን ኡልፍነ ጉዳ ሲፍ ነንኬናቲ፤ ዋን አት ጄቱ ሁንደስ ነንጉተ። ኮቱ ሰበ ከነ ና አባር።’ ”<verse eid="NUM 22:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 22:18"/>በለኣም ገሩ አከነ ጄዼ ዴብሴፍ፤ “ኡቱ ባላቅ መሰራሳ ከን ሜቲፊ ወርቄን ጉተሜ ሰነ ናፍ ኬኔሌ፣ አን አጀጀ <char style="nd">ዋቀዮ</char> ዋቀኮቲን አለት ዋን ጥና ዮካን ጉዳ ቶኮሌ ሆጄቹ ህንደንደኡ። <verse eid="NUM 22:18"/><verse number="19" style="v" sid="NUM 22:19"/>አከ አን ዋን <char style="nd">ዋቀዮ</char> ነት ህሙ ከን ብራ ቤኩ ደንደኡፍ እስንስ አኩመ ወረ ካኒ አስ ቡላ።”<verse eid="NUM 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 22:20"/>ሀልከን ሰነ ዋቀዮ ገረ በለኣም ዹፌ፣ “ሰበቢ ነሞትን ኩኔን ዋሙ ዹፈኒፍ፣ እሳን ወጅን ዴም፤ ገሩ ዋኑመ አን ስት ህሙ ቆፈ ሆጄዹ” ጄዼን።<verse eid="NUM 22:20"/></para>
  <para style="s1">ሀሬ በለኣም</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 22:21"/>በለኣም ገነማን ከኤ ሀሬሳረ ኮራ ካአቴ ቆንዳልቶተ ሞኣብ ሰነ ወጅን ዴሜ። <verse eid="NUM 22:21"/><verse number="22" style="v" sid="NUM 22:22"/>ዋቅን ገሩ እን ዴምናን እት ኣሬ፤ ኤርገማን <char style="nd">ዋቀዮ</char> ቶኮስ እሳን ሞርሙፍ ጄዼ ከራረ ዻበቴ። በለኣምስ ሀሬሳ ያበቴ ዴማ ቱሬ፤ ተጃጅልቶትንሳ ለማን እሰ ወጅን ቱረን። <verse eid="NUM 22:22"/><verse number="23" style="v" sid="NUM 22:23"/>ሀሬን ሱንሞ ኤርገማ <char style="nd">ዋቀዮ</char> ከን ጎራዴ ሉቅፈቴ ሀርከት ቀበቴ ከራረ ዻበቱ አርግናን ኦፍረ ገረ ገልቴ ከራራ ጎርቴ ለፈ ቆቲሳ ሴንቴ። በለኣምስ ከራት እሼ ዴብሱዻፍ ሀሬ ሰነ ሩኩቴ።<verse eid="NUM 22:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 22:24"/>ኤርገማን <char style="nd">ዋቀዮ</char> ሱን ገሩ ዳንዲ ዽጶ፣ እዶ ዻባ ወይኒ ለመ ከኔን ገመ ለማን ደላ ቀበን ግዱ ባቱረ ዻበቴ። <verse eid="NUM 22:24"/><verse number="25" style="v" sid="NUM 22:25"/>ሀሬን ሱን ኤርገማ <char style="nd">ዋቀዮ</char> አርግናን፣ ደላት መጠንቴ ሚለ በለኣም ደላት ቡፍቴ። እን አመስ ሀሬ ሰነ ሩኩቴ።<verse eid="NUM 22:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 22:26"/>ኤርገማን <char style="nd">ዋቀዮስ</char> ፉለ ዱረት ሂቄ ዳንዲ ዽጳ እዶ እቲን ምርገት ዮካን ብታት ጎረን ህንቀብኔ ቶኮረ ዻበቴ። <verse eid="NUM 22:26"/><verse number="27" style="v" sid="NUM 22:27"/>ሀሬን ሱን ኤርገማ <char style="nd">ዋቀዮ</char> አርግናን በለኣም ጀላ ገድ ጪፍቴ፤ እንስ ኣሬ ኡሌ ኦፊቲን ሀሬ ሰነ ሩኩቴ። <verse eid="NUM 22:27"/><verse number="28" style="v" sid="NUM 22:28"/>ከነረት <char style="nd">ዋቀዮ</char> አፋን ሀሬ ሰና በኔ ሀሬን ሱን በለኣሚን፣ “አን ማል ስ የክናን አት አከስ ዬሮ ሰዲ ነ ሩኩቴ?” ጄቴ።<verse eid="NUM 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 22:29"/>በለኣምስ ሀሬ ሰናን፣ “አት ነ ጎዎምስቴ፤ አን ኡቱ ጎራዴ ኦፍ ሀርካ ቀባዼ ስላ አሙመን ስ አጄሰ” ጄዼ።<verse eid="NUM 22:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 22:30"/>ሀሬን ሱን አመሌ በለኣሚን አከነ ጄቴ፤ “አን ሀሬኬ ከን አት ሀመ ሀርኣት ጉያ ሁንደ ያበቱ ምቲ? አን ተኩማ ዋን አከሲ ስት ሆጄዼ ቤካ?”</para>
  <para style="p" vid="NUM 22:30">እንስ፣ “ለኪ” ጄዼ ዴብሴፍ።<verse eid="NUM 22:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 22:31"/>ዮሙስ <char style="nd">ዋቀዮ</char> እጀ በለኣም በኔ፤ በለኣምስ ኤርገማ <char style="nd">ዋቀዮ</char> ከን ጎራዴ ሉቅፈቴ ከራረ ዻበቱ አርጌ። ከነረት እን አዳን ለፈት ጎምብፈሜ ሰገዴ።<verse eid="NUM 22:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 22:32"/>ኤርገማን <char style="nd">ዋቀዮ</char> ሱን አከነ ጄዼ እሰ ጋፈቴ፤ “አት ማሊፍ ዬሮ ሰደን ከነ ሀሬኬ ሩኩቴ? ኩኖ አን ዋን ከራንኬ ፉለኮ ዱረት ጀልኣ ተኤፍ ሲን ሞርሙዻፈን ዹፌ። <verse eid="NUM 22:32"/><verse number="33" style="v" sid="NUM 22:33"/>ሀሬን ኩን ነ አርግቴ ዬሮ ከነ ሰደኑ ነራ ጎርቴ። ኡቱ እሼን ነራ ጎሩ ባቴ ስላ አን ዮነ ስ አጄሴ እሼሞ ሀምብሰ ቱሬ።”<verse eid="NUM 22:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 22:34"/>በለኣምስ ኤርገማ <char style="nd">ዋቀዮቲን</char>፣ “አን ጩቡ ሆጄዼረ። አን አከ አት ናን ሞርሙፍ ጄቴ ከራረ ዻበቴ ህንሁበትኔ። አመስ ዮ ስት ህንቶልን አን ነንዴብአ” ጄዼ።<verse eid="NUM 22:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 22:35"/>ኤርገማን <char style="nd">ዋቀዮ</char> ሱንስ በለኣሚን፣ “ነሞተ ከነ ወጅን ዴም፤ ገሩ ዋኑመ አን ስት ህሙ ቆፈ ዱበዹ” ጄዼ። አከሲን በለኣም ቆንዳልቶተ ባላቅ ሰነ ወጅን ዴሜ።<verse eid="NUM 22:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 22:36"/>ባላቅስ አከ በለኣም ዹፋ ጅሩ ዸጌኛን፣ መጋላ ሞኣብ ከን ዳሪ አርኖንረት አርገምቱት እሰ ስመቹዻፍ ከኤ ዴሜ። <verse eid="NUM 22:36"/><verse number="37" style="v" sid="NUM 22:37"/>ባላቅስ በለኣሚን አከነ ጄዼ፤ “አን ዻምሰ አሪፈቺሳ ስት ህንኤርግኔ? አት ማሊፍ ነ ብረ ህንዹፍኔ? አን ዹጉማን ኡልፍነ ሲፍ ኬኑ ህንደንደኡ?”<verse eid="NUM 22:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 22:38"/>በለኣምስ፣ “ኩኖ አን ስ ብረ ዹፌረ። ገሩ አን ዋኑመን አርጌ ዱበቹ ነንደንደኣ? አን ዋኑመ ዋቅን አፋንኮ ኬሰ ካኡ ቆፈን ዱበቹ ቀበ” ጄዼ ዴብሴ።<verse eid="NUM 22:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 22:39"/>በለኣምስ ከኤ ባላቅ ወጅን ቂርያት ሀጦት ዸቄ። <verse eid="NUM 22:39"/><verse number="40" style="v" sid="NUM 22:40"/>ባላቅ ሎኒፊ ሆላ ኣርሳ ዽኤሴ ገረ ቶኮ በለኣሚፊ ቆንዳልቶተ እሰ ወጅን ቱረኒፍ ኬኔ። <verse eid="NUM 22:40"/><verse number="41" style="v" sid="NUM 22:41"/>ገነመ እት ኣኑስ ባላቅ፣ በለኣምን ባሞት በኣልት ኦል ባሴ፤ እንስ አች ዻበቴ ሰበ እስራኤል ወረ ዳንጋ ገማረ ጅረን አርጌ።<verse eid="NUM 22:41"/></para>
  <chapter eid="NUM 22"/>
  <chapter number="23" style="c" sid="NUM 23"/>
  <para style="s1">ኤርጋ በለኣም ከን ጀልቀባ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 23:1"/>በለኣምስ ባላቂን፣ “እዶ ኣርሳ ቶርበ አስት ናፍ እጃር፤ አመሌ ኮሮሚ ሎኒ ቶርባፊ ኮርቤዪ ሆላ ቶርበ ና ቆጴስ” ጄዼ። <verse eid="NUM 23:1"/><verse number="2" style="v" sid="NUM 23:2"/>ባላቅስ አኩመ በለኣም ጄዼ ሰነ ጎዼ፤ እሳን ለማን ቶኮ ቶኮ እዶ ኣርሳረት ኮርመ ሎኒቲፊ ኮርቤሰ ሆላ ቶኮ ቶኮ ኣርሳ ዽኤሰን።<verse eid="NUM 23:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 23:3"/>ኤርገሲ በለኣም ባላቂን አከነ ጄዼ፤ “አን ጥኖ አች ስራ ነንስቀ፤ አትሞ አሱመ ኣርሳኬ ብረ ቱር። ተሪ <char style="nd">ዋቀዮ</char> አና ወጅን ወል አርጉፍ ንዹፈ ተአ። ዋን እን ነት ሙልእሱ ከምዩ አን ስትን ህመ።” እንስ ገረ ጋረ ቶኮ ዸቄ።<verse eid="NUM 23:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 23:4"/>ዋቀዮ እሳን ወል አርግናን በለኣም፣ “አን እዶ ኣርሳ ቶርበ ቆጴሴ ቶኮ ቶኮሳረት ኮርመ ሎኒ ቶኮፊ ኮርቤሰ ሆላ ቶኮ ቆጴሴረ” ጄዼ።<verse eid="NUM 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 23:5"/>
    <char style="nd">ዋቀዮ</char> ኤርጋ ቶኮ አፋን በለኣም ኬሰ ካኤ፣ “ባላቅት ዴብኢቲ ኤርጋ ከነ እት ህም” ጄዼን።<verse eid="NUM 23:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 23:6"/>በለኣም ባላቅት ዴብኤ እሳ ቆንዳልቶተ ሞኣብ ወጅን ኣርሳሳ ብረ ዻበቱ አርጌ። <verse eid="NUM 23:6"/><verse number="7" style="v" sid="NUM 23:7"/>በለኣም ኤርጋሳ አከነ ጄዼ ዱበቴ፦</para>
  <para style="q1" vid="NUM 23:7">“ባላቅ አራምራ፣</para>
  <para style="q2" vid="NUM 23:7">ሞትች ሞኣብ ጋረን በኣራ ነ ፍዴ።</para>
  <para style="q1" vid="NUM 23:7">እንስ፣ ‘ኮቱቲ ያቆብን ና አባር፤</para>
  <para style="q2" vid="NUM 23:7">ኮቱቲ እስራኤልን ና በላሌፈዹ’ ጄዼ።<verse eid="NUM 23:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 23:8"/>አን አከምተን ወረ ዋቅን ህንአባርን</para>
  <para style="q2" vid="NUM 23:8">አባሩ ደንደአ?</para>
  <para style="q1" vid="NUM 23:8">አን አከምተን ወረ <char style="nd">ዋቀዮ</char> ህንበላሌፈትን</para>
  <para style="q2" vid="NUM 23:8">በላሌፈቹ ደንደአ?<verse eid="NUM 23:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="NUM 23:9"/>ፊጤ ጋረኒራ አን እሰ ነንአርገ፤</para>
  <para style="q2" vid="NUM 23:9">ቱሉወንራስ እሰ ነንእላለ።</para>
  <para style="q1" vid="NUM 23:9">ሰበ ኮጳሳ ጅራቱ፣</para>
  <para style="q2" vid="NUM 23:9">ከን ሰበ ካን ኬሰት ኦፍ ህንለኮፍኔ ነንአርገ።<verse eid="NUM 23:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="NUM 23:10"/>ኤኙቱ አዋረ ያቆብ ለካኡ ደንደአ?</para>
  <para style="q2" vid="NUM 23:10">ኤኙቱ እስራኤል ኬሳ ኩርማነሳሌ ለካአ?</para>
  <para style="q1" vid="NUM 23:10">አን ዱአ ነመ ቀጄላ ሃዱኡ፤</para>
  <para style="q2" vid="NUM 23:10">ዹምንኮስ አኩመ ዹመሳ ሃተኡ!”<verse eid="NUM 23:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 23:11"/>ባላቅስ በለኣሚን፣ “ወን አት ነ ጎቴ ኩን ማል? አን አከ አት ዲነኮ ና አባርቱፍን ስ ፍዴ፤ አት ኩኖ እሳን ኤብፍቴ መሌ ዋን ቶኮዩ እሳን ህንጎኔ!” ጄዼ።<verse eid="NUM 23:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 23:12"/>እንስ፣ “አን ዋን <char style="nd">ዋቀዮ</char> አፋንኮ ኬሰ ካኡ ህንዱበዹ?” ጄዼ ዴቢ ኬኔፍ።<verse eid="NUM 23:12"/></para>
  <para style="s1">ኤርጋ በለኣም ከን ለመፋ</para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 23:13"/>ባላቅ፣ “ሜ ገረ ለፈ እት እሳን አርጉ ደንዴሱ ብራ ነ ወጅን ኮቱ፤ አት ገረ ቶኮ ቆፈ መሌ ሁንዱመሳኒ አርጉ ህንደንዴሱ። አቺስ እሳን ና አባር” ጄዼን። <verse eid="NUM 23:13"/><verse number="14" style="v" sid="NUM 23:14"/>እን ገረ ድሬ ጦፊም ከን ፊጤ ጵስጋረት አርገሙት እሰ ጌሴ፤ አችትስ እዶ ኣርሳ ቶርበ እጃሬ ቶኮ ቶኮ እዶ ኣርሳ ሰናረት ኮርመ ሎኒ ቶኮፊ ኮርቤሰ ሆላ ቶኮ ኣርሳ ዽኤሴ።<verse eid="NUM 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 23:15"/>በለኣምስ ባላቂን፣ “አት ሀመ አን አች ስቄ ዋቀ ወጅን ወል አርጉት አሱመ ኣርሳኬ ብረ ቱር” ጄዼ።<verse eid="NUM 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 23:16"/>
    <char style="nd">ዋቀዮ</char> በለኣም ወጅን ወል አርጌ ኤርጋ ቶኮ አፋንሳ ኬሰ ካኤ፣ “ባላቅት ዴብኢቲ ኤርጋ ከነ እት ህም” ጄዼን።<verse eid="NUM 23:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 23:17"/>በለኣም ባላቅ ብረ ዸቄ እሳ ቆንዳልቶተ ሞኣብ ወጅን ኣርሳሳ ብረ ዻበቱ አርጌ። ባላቅስ፣ “<char style="nd">ዋቀዮ</char> ማል ጄዼ?” ጄዼ በለኣሚን ጋፈቴ።<verse eid="NUM 23:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 23:18"/>በለኣም አከነ ጄዼ ኤርጋሳ ዱበቴ፦</para>
  <para style="q1" vid="NUM 23:18">“ያ ባላቅ፣ ከኢቲ ዸጌፈዹ፤</para>
  <para style="q2" vid="NUM 23:18">ያ እልመ ዝጶር ነ ዸገእ።<verse eid="NUM 23:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="NUM 23:19"/>ዋቅን ነመ ምት፤ እን ህንሶቡ፤</para>
  <para style="q2" vid="NUM 23:19">ዮካን ጋቡዻፍ እን እልመ ነማ ምት።</para>
  <para style="q1" vid="NUM 23:19">እን ዋ ዱበቴ ኤርገሲ ህንሆጄቱ?</para>
  <para style="q2" vid="NUM 23:19">እን ዋ አብደቺሴ ኤርገሲ ህንራወቱ?<verse eid="NUM 23:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="NUM 23:20"/>ኩኖ አን ኤብሱዻፍ አጀጀ አርገዼረ፤</para>
  <para style="q2" vid="NUM 23:20">እን ኤብሴረ፤ አንስ ጌደሩ ህንደንደኡ።<verse eid="NUM 23:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="NUM 23:21"/>“እን ያቆብ ኬሰት ደበ ህንአርግኔ፤</para>
  <para style="q2" vid="NUM 23:21">ረክነ ቶኮሌ እስራኤል ኬሰት ህንአርግኔ።</para>
  <para style="q1" vid="NUM 23:21">
    <char style="nd">ዋቀዮ</char> ዋቅንሳኒ እሳን ወጅን ጅረ፤</para>
  <para style="q2" vid="NUM 23:21">እልሌን ሞቲ እሳን ወጅን ጅረ።<verse eid="NUM 23:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="NUM 23:22"/>ዋቀዮ ብየ ግብጢቲ እሳን ባሴ፤</para>
  <para style="q2" vid="NUM 23:22">እን ጀብነ አከ ጀብነ ገፈርሳ ቀበ።<verse eid="NUM 23:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="NUM 23:23"/>ያቆብረት ፈልፈል ቶኮዩ ህንሆጄቱ፤</para>
  <para style="q2" vid="NUM 23:23">እስራኤልረትስ ቶልች ቶኮዩ ህንሆጄቱ።</para>
  <para style="q1" vid="NUM 23:23">አመ ያቆቢፊ እስራኤሊን፣</para>
  <para style="q2" vid="NUM 23:23">‘ዋን ዋቅን ሆጄቴ እላላ!’ ጄዸመ።<verse eid="NUM 23:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 23:24"/>ኩኖ ሰብን ሱን አከ ሌንጨ ዸላት ከአ፤</para>
  <para style="q2" vid="NUM 23:24">አኩመ ሌንጫትስ ኦል ጄዸ፤</para>
  <para style="q1" vid="NUM 23:24">እን ሀመ ዋን አደምሰቴ ኛቴ ፍጡት፣</para>
  <para style="q2" vid="NUM 23:24">ሀመ ዺገ ዋን አጄፈቴ ሰና ዹጉትስ ህንጪሱ።”<verse eid="NUM 23:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 23:25"/>ባላቅ በለኣሚን፣ “አት ጎንኩማ እሳን ህንአባርን ዮካን እሳን ህንኤብስን” ጄዼ።<verse eid="NUM 23:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 23:26"/>በለኣምስ፣ “አን አከ ዋን <char style="nd">ዋቀዮ</char> ጄዹ ከምዩ ሆጄዹ ስት ህንህምኔ?” ጄዼ ባላቂፍ ዴብሴ።<verse eid="NUM 23:26"/></para>
  <para style="s1">ኤርጋ በለኣም ከን ሰደፋ</para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 23:27"/>ኤርገሲ ባላቅ በለኣሚን፣ “ሜ ኮቱ አመሌ አን እዶ ብራ ስን ጌሳ። ተሪ አቺ ጀረ ናፍ አባሩንኬ ዋቀ ገመቺሰ ተኣቲ” ጄዼ። <verse eid="NUM 23:27"/><verse number="28" style="v" sid="NUM 23:28"/>ባላቅስ በለኣምን ፊጤ ቱሉ ጴኦር ከን እረ ዻበተኒ ገሞጂ ሰነ ገድ እላለንት ኦል ባሴ።<verse eid="NUM 23:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 23:29"/>በለኣምስ ባላቂን፣ “እዶ ኣርሳ ቶርበ አስት ናፍ እጃር፤ አመስ ኮሮሚ ሎኒ ቶርባፊ ኮርቤዪ ሆላ ቶርበ ናፍ ቆጴስ” ጄዼ። <verse eid="NUM 23:29"/><verse number="30" style="v" sid="NUM 23:30"/>ባላቅስ አኩመ በለኣም ጄዼን ሰነ ጎዼ፤ ቶኮ ቶኮ እዶ ኣርሳረትስ ኮርመ ሎኒ ቶኮፊ ኮርቤሰ ሆላ ቶኮ ኣርሳ ዽኤሴ።<verse eid="NUM 23:30"/></para>
  <chapter eid="NUM 23"/>
  <chapter number="24" style="c" sid="NUM 24"/>
  <para style="p">
    <verse number="1" style="v" sid="NUM 24:1"/>በለኣም ዬሮ አከ እስራኤልን ኤብሱን <char style="nd">ዋቀዮን</char> ገመቺሴ አርጌት አከ ዬሮ ካኒ ፈልፈለ በርባቸ ህንዸቅኔ፤ ገሩ ፉለሳ ገረ ገሞጂት ዴብፈቴ። <verse eid="NUM 24:1"/><verse number="2" style="v" sid="NUM 24:2"/>ዮሙ በለኣም ኦል ምልአቴ አከ እስራኤል ጎሰ ጎሳን ቁበቴ አርጌት ሀፉር ዋቃ እሰረ ቡኤ፤ <verse eid="NUM 24:2"/><verse number="3" style="v" sid="NUM 24:3"/>እንስ አከነ ጄዼ ኤርጋሳ ዱበቴ፦</para>
  <para style="q1" vid="NUM 24:3">“ኤርጋ በለኣም እልመ ቤኦር፣</para>
  <para style="q2" vid="NUM 24:3">ኤርጋ ነመ እጅሳ ስሪት አርጉ፣<verse eid="NUM 24:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="NUM 24:4"/>ኤርጋ ነመ ዱቢ ዋቃ ዸገኡ</para>
  <para style="q2" vid="NUM 24:4">እሰ ዋቀ ዋን ሁንደ ደንደኡራ ሙልአተ አርጉ</para>
  <para style="q2" vid="NUM 24:4">ከን ኩፌ እጅሳ በነሙ ሰና፦<verse eid="NUM 24:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="NUM 24:5"/>“ያ ያቆብ፣ ዱንካኖትንኬ፣</para>
  <para style="q2" vid="NUM 24:5">ያ እስራኤል፣ እዶን አት ጅራቱ አከም ሚዸገ!<verse eid="NUM 24:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="NUM 24:6"/>“እሳን አኩመ ሱሉለ ድሪራ፣</para>
  <para style="q2" vid="NUM 24:6">አኩመ እዶ ብቅልቱ ከን አፋን ለጋ፣</para>
  <para style="q1" vid="NUM 24:6">አኩመ አርጌሰ <char style="nd">ዋቀዮ</char> ዻቤ፣</para>
  <para style="q2" vid="NUM 24:6">አኩመ ብርብርሳ ቀርቀረ ብሻኒት።<verse eid="NUM 24:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="NUM 24:7"/>ኦኮሌሳ ኬሳ ብሻንቱ ሎለአ፤</para>
  <para style="q2" vid="NUM 24:7">ሰኚንሳ ብሻን ባይኤ አርገተ።</para>
  <para style="b" vid="NUM 24:7"/>
  <para style="q1" vid="NUM 24:7">“ሞቲንሳ አጋግ ጫለ፤</para>
  <para style="q2" vid="NUM 24:7">ሞቱማንሳ ንከበጀመ።<verse eid="NUM 24:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 24:8"/>“ዋቀዮ ግብጢ እሰ ባሴ፤</para>
  <para style="q2" vid="NUM 24:8">እን ጀብነ አከ ጀብነ ገፈርሳ ቀበ።</para>
  <para style="q1" vid="NUM 24:8">እን ሰበ ዲኖተሳ ተኤ ኛተ፤</para>
  <para style="q2" vid="NUM 24:8">ለፌሳኒ ንጨጨብሰ፤</para>
  <para style="q2" vid="NUM 24:8">ጥየ ኦፊሳቲን እሳን ወራነ።<verse eid="NUM 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="NUM 24:9"/>እን አኩመ ሌንጫ ጪሴረ፤</para>
  <para style="q2" vid="NUM 24:9">አኩመ ሌንጨ ዸላስ ጪሴረ፤ ኤኙቱ እሰ ደመቅሰ?</para>
  <para style="b" vid="NUM 24:9"/>
  <para style="q1" vid="NUM 24:9">“ወር ስ ኤብሰን ሃኤብፈመን፤</para>
  <para style="q2" vid="NUM 24:9">ወር ስ አባረንስ ሃአባረመን!”<verse eid="NUM 24:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 24:10"/>ባላቅ በለኣምት ኣሬ። እንስ ሀርከ ኦፊሳ ወልት ሩሩኩቴ በለኣሚን አከነ ጄዼ፤ “አን አከ አት ዲነኮ አባርቱፈን ስ ዋመዼ፤ አት ኩኖ ዬሮ ሰደን ከነ እሳን ኤብፍቴ። <verse eid="NUM 24:10"/><verse number="11" style="v" sid="NUM 24:11"/>አመ ደፊ አሲ ዴሚ መነኬት ገል! አን ኡልፍነ ጉዳ ሲፍ ነንኬነ ጄዼን ቱሬ፤ አመ ገሩ <char style="nd">ዋቀዮ</char> አከ አት ኡልፍነ ህንአርገትኔ ስ ጎዼረ።”<verse eid="NUM 24:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 24:12"/>በለኣምስ ባላቂን አከነ ጄዼ፤ “አን ኤርገሞተ አት ነት ኤርግቴ ሰነት አከነ ጄዼን ህሜ ምቲ? <verse eid="NUM 24:12"/><verse number="13" style="v" sid="NUM 24:13"/>‘ኡቱ ባላቅ መሰራ ሜቲፊ ወርቄን ጉተሜ ሰነ ናፍ ኬኔዩ፣ አን ዋኑመ <char style="nd">ዋቀዮ</char> ጄዼ ቆፈን ዱበዸ መሌ አጀጀ <char style="nd">ዋቀዮቲን</char> አለት ዋን ያደኮ ጋሪ ዮካን ሀማ ቶኮዩ ሆጄቹ ህንደንደኡ።’ <verse eid="NUM 24:13"/><verse number="14" style="v" sid="NUM 24:14"/>ኩኖ አን አመ ሰበኮት ነንዴብአ፤ ገሩ ሜ ኮቱ አን ዋን ሰብን ኩን በረ ዹፉ ኬሰ ሰበኬቲፍ ጎዹ ስን ቤክስሳ።”<verse eid="NUM 24:14"/></para>
  <para style="s1">ኤርጋ በለኣም ከን አፉረፋ</para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 24:15"/>እን አከነ ጄዼ ኤርጋሳ ዱበቴ፦</para>
  <para style="q1" vid="NUM 24:15">ኤርጋ በለኣም እልመ ቤኦር፣</para>
  <para style="q2" vid="NUM 24:15">ኤርጋ ነመ እጅሳ ስሪት አርጉ፣<verse eid="NUM 24:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="NUM 24:16"/>ኤርጋ ነመ ዱቢ ዋቃ ዸገኡ</para>
  <para style="q2" vid="NUM 24:16">ከን ቤኩምሰ ዋቀ ዋን ሁንዳ ኦሊ ቀቡ</para>
  <para style="q1" vid="NUM 24:16">ከን ዋቀ ዋን ሁንደ ደንደኡራ ሙልአተ አርጉ</para>
  <para style="q2" vid="NUM 24:16">ከን ኩፌ ድሪሩ፣ እጅሳስ ከን በነሙ ሰና፦<verse eid="NUM 24:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="NUM 24:17"/>“አን እሰ ነንአርገ፤ ገሩ አመ ምት፤</para>
  <para style="q2" vid="NUM 24:17">አን እሰ ነንእላለ፤ ገሩ ዽኦት ምት።</para>
  <para style="q1" vid="NUM 24:17">ያቆብ ኬሳ ኡርጂን ቶኮ ንበአ፤</para>
  <para style="q2" vid="NUM 24:17">እስራኤል ኬሳ ቦኩን ቶኮ ኦል ከአ።</para>
  <para style="q1" vid="NUM 24:17">እን አደ ወረ ሞኣብ፣</para>
  <para style="q2" vid="NUM 24:17">ቡቄ መታ እልማን ሴት ሁንዳስ ንጨጨብሰ።<verse eid="NUM 24:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="NUM 24:18"/>ኤዶም ንሞአተመ፤</para>
  <para style="q2" vid="NUM 24:18">ሴኢር፣ ዲንሳ ንሞአተመ፤</para>
  <para style="q2" vid="NUM 24:18">እስራኤል ገሩ ጀባቻ ዴመ።<verse eid="NUM 24:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="NUM 24:19"/>ያቆብ ኬሳ ቡልቻን ቶኮ ንከአ፤</para>
  <para style="q2" vid="NUM 24:19">ወረ መጋላ ሰነ ኬሰት ሉቡዻን ሀፈንስ ንበርበዴሰ።”<verse eid="NUM 24:19"/></para>
  <para style="s1">ኤርጋ በለኣም ከን ዹማ</para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 24:20"/>ኤርገሲስ በለኣም አማሌቅን አርጌ አከነ ጄዼ ኤርጋ ኦፊ እሰ ዱበቴ፦</para>
  <para style="q1" vid="NUM 24:20">“አማሌቅ ሰቦተ ኬሳ ከን ጀልቀባ ቱሬ፤</para>
  <para style="q2" vid="NUM 24:20">ዹምንሳ ገሩ በርበዳኡዸ።”<verse eid="NUM 24:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 24:21"/>ኤርገሲ ቄኖተ አርጌ አከነ ጄዼ ኤርጋ ኦፊሳ እት ዱበቴ፦</para>
  <para style="q1" vid="NUM 24:21">“እዶን አት ጅራቱ ጀባዸ፤</para>
  <para style="q2" vid="NUM 24:21">መንኬስ ከታ ኬሰት እጃረሜ፤<verse eid="NUM 24:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="NUM 24:22"/>ተኡስ እስን ወር ቄኖታ፣</para>
  <para style="q2" vid="NUM 24:22">ጋፈ አሶር እስን ቦጅኡ ንበዱ።”<verse eid="NUM 24:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 24:23"/>እንስ አከነ ጄዼ ኤርጋሳ እት ዱበቴ፦</para>
  <para style="q1" vid="NUM 24:23">“ወዮ! ዬሮ ዋቀዮ ዋን ከነ ሆጄቱ <optbreak/> ኤኙቱ ጅራቹ ደንደአ?<verse eid="NUM 24:23"/></para>
  <para style="q2">
    <verse number="24" style="v" sid="NUM 24:24"/>ዶኒወን ቀርቀረ ክቲምራ ንዹፉ፤</para>
  <para style="q1" vid="NUM 24:24">እሳንስ አሶሪፊ ኤቤርን ንቀበቱ፤</para>
  <para style="q2" vid="NUM 24:24">ገሩ እሳንስ ንበርበዴፈሙ።”<verse eid="NUM 24:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 24:25"/>ኤርገሲ በለኣም ከኤ መነ ኦፊሳት ዴብኤ፤ ባላቅሞ ከራ ኦፊሳ ቀጄሌ።<verse eid="NUM 24:25"/></para>
  <chapter eid="NUM 24"/>
  <chapter number="25" style="c" sid="NUM 25"/>
  <para style="s1">ሞኣብ እስራኤልን ጎዎምሴ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 25:1"/>እስራኤሎን ዬሮ ሽጢም ኬሰ ቱረንት ዺሮንሳኒ ዱበርቶተ ሞኣብ ወጅን ሰጋገሉ ጀልቀበን። <verse eid="NUM 25:1"/><verse number="2" style="v" sid="NUM 25:2"/>ዱበርቶትን ኩኔንስ ገረ ቀልመ ዋቆተሳኒት ሰበ ሰነ አፌራን፣ ሰብን ሱን ቀልመ ሰነ ኛቴ ዋቆተ ሰናፍ ሰገዴ። <verse eid="NUM 25:2"/><verse number="3" style="v" sid="NUM 25:3"/>እስራኤል በኣል ጴኦር ዱካ ቡኤ። ዼከምስ <char style="nd">ዋቀዮስ</char> እሳንት ቦበኤ።<verse eid="NUM 25:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 25:4"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ “አከ ዼከምስ <char style="nd">ዋቀዮ</char> ጀባን ሱን ሰበ እስራኤልራ ዴብኡፍ፣ ሀንገፎተ ሰበ ሰና ሁንደ ፉዺቲ ጉያ አዲዻን ፉለ <char style="nd">ዋቀዮ</char> ዱረት እሳን ፈንስ።”<verse eid="NUM 25:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 25:5"/>ሙሴን አቦቲ ሙርቲ እስራኤሊን፣ “ቶኮን ቶኮንኬሰን ነሞተኬሰን ከኔን በኣል ጴኦር ዱካ ቡአን ፍጣ” ጄዼ።<verse eid="NUM 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 25:6"/>ኩኖ ነምች እስራኤል ቶኮ ኡቱመ እሳን በልበለ ዱንካነ ወል ገኢ ዱረት ቦኣ ጅረኑ ፉለ ሙሴቲፊ ፉለ ወልዳ እስራኤል ጉቱ ዱረት ዱበርቲ ምድያን ቶኮ ገረ ማቲ ኦፊሳት ፍደቴ። <verse eid="NUM 25:6"/><verse number="7" style="v" sid="NUM 25:7"/>ፊኔሃስ እልም ኤሌኣዛር እልመ አሮን ሉብቻ ዋን ከነ አርግናን ወልዳ ሰነ ኬሳ በኤ ኤቦ ሀርከት ቀበቴ <verse eid="NUM 25:7"/><verse number="8" style="v" sid="NUM 25:8"/>ነምቸ እስራኤል ሰነ ዱካ ቡኤ ዱንካነ ሴኔ፤ ነምቸ እስራኤሊፊ ዱበርትቲስ ወልት ወራኔ ዸግነሼት ፉላሴ። አከሲን ዸእች እስራኤልት ዹፌ ሱን ንዾወሜ። <verse eid="NUM 25:8"/><verse number="9" style="v" sid="NUM 25:9"/>ገሩ ባይእን ነሞተ ዸእቸ ሰናን ዹመኒ 24,000 ገኤ ቱሬ።<verse eid="NUM 25:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 25:10"/>
    <char style="nd">ዋቀዮስ</char> ሙሴዻን አከነ ጄዼ፤ <verse eid="NUM 25:10"/><verse number="11" style="v" sid="NUM 25:11"/>“ፊኔሃስ እልም ኤሌኣዛር እልመ አሮን ሉብቸ ሰና ዼከምሰኮ እስራኤሎተራ ዴብሴረ፤ እን አከ አን ህናፋኮቲን እሳን ህንበሌስኔፍ፣ አኩመ አን ኡልፍነኮቲፍ እሳን ግዱት ህናፉ ሰነ እንስ ህናፌራቲ። <verse eid="NUM 25:11"/><verse number="12" style="v" sid="NUM 25:12"/>ከናፉ ኩኖ አከ አን ከኩኮ ከን ነጋ እሰ ወጅን ጎዸዹ እት ናፍ ህም። <verse eid="NUM 25:12"/><verse number="13" style="v" sid="NUM 25:13"/>ሰበቢ እን ኡልፍነ ዋቀሳቲፍ ህናፌ እስራኤሎታፍ አራረ ቡሴፍ፣ እኒፊ ሰኚንሳ ከኩ ሉቡማ ከን በረ በራ ቀባቱ።”<verse eid="NUM 25:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 25:14"/>መቃን ነምቸ እስራኤል ከን ዱበርቲ ምድያን ወጅን አጄፈሜ ሰና ዝምሪ እልመ ሳሉት፤ እንስ ሆገና ማቲ ስምኦን። <verse eid="NUM 25:14"/><verse number="15" style="v" sid="NUM 25:15"/>መቃን ዱበርቲ ምድያን ከን አጄፈምቴ ሰና ኮዝቢ እንተለ ዙር ሀንገፈ ማቲ ምድያን ቶኮት።<verse eid="NUM 25:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 25:16"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ <verse eid="NUM 25:16"/><verse number="17" style="v" sid="NUM 25:17"/>“ምድያኖተ አከ ዲናት እላሊቲ አጄስ፤ <verse eid="NUM 25:17"/><verse number="18" style="v" sid="NUM 25:18"/>ኩንስ ዋን እሳን ሰበቢ ጴኦሪቲፊ ኦቦሌቲሳኒ ኮዝቢ እንተለ ሆገና ወረ ምድያን፣ ዱበርቲ ጉያ ሰበቢ ጴኦሪቲን ዸእች ዹፌ ሰነ አጄፈምቴ ሰናረት እስን ጎዎምሰን ሰነ አከ ዲናት እስን እላለኒፍ።”<verse eid="NUM 25:18"/></para>
  <chapter eid="NUM 25"/>
  <chapter number="26" style="c" sid="NUM 26"/>
  <para style="s1">ሰብን ዬሮ ለመፋ ለካአሜ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 26:1"/>ዸእቸ ሰነ ቦዴ <char style="nd">ዋቀዮ</char> ሙሴፊ ኤሌኣዛር እልመ አሮን ሉብቻቲን አከነ ጄዼ፤ <verse eid="NUM 26:1"/><verse number="2" style="v" sid="NUM 26:2"/>“ወልዳ ሰበ እስራኤል ወረ ኡሙሪንሳኒ ወጋ ድግደማፊ ሀመሲ ኦል ተኤ ከኔን ሎልቶተ እስራኤል ኬሰ ተጃጅሉ ደንደአን ሁንደ ማቲ ማቲዻን ለካኣ።” <verse eid="NUM 26:2"/><verse number="3" style="v" sid="NUM 26:3"/>ሙሴፊ ኤሌኣዛር ሉብች ድሬወን ሞኣብረት፣ ዮርዳኖስ ብረት፣ ዬርኮ ገመት አከነ ጄዸኒ እሳን ወጅን ዱበተን፤ <verse eid="NUM 26:3"/><verse number="4" style="v" sid="NUM 26:4"/>“አኩመ <char style="nd">ዋቀዮ</char> ሙሴ አጀጄት ነሞተ ኡሙሪንሳኒ ወጋ ድግደማቲፊ ሀመሲ ኦሊ ለካኣ።”</para>
  <para style="b" vid="NUM 26:4"/>
  <para style="lh" vid="NUM 26:4">ጀር ኩኔን እስራኤሎተ ብየ ግብጢቲ በአኒዸ፦<verse eid="NUM 26:4"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="5" style="v" sid="NUM 26:5"/>እልማን ሩቤን እልመ እስራኤል ሀንገፍትቻ፦</para>
  <para style="li2" vid="NUM 26:5">ከራ ሄኖኪቲን፣ በልበለ ሀኖኮታ፤</para>
  <para style="li2" vid="NUM 26:5">ከራ ፈሉቲን፣ በልበለ ፈሉዎታ፤<verse eid="NUM 26:5"/></para>
  <para style="li2">
    <verse number="6" style="v" sid="NUM 26:6"/>ከራ ሄዝሮኒቲን፣ በልበለ አስሮኖታ፤</para>
  <para style="li2" vid="NUM 26:6">ከራ ከርሚቲን፣ በልበለ ከርሞታ።<verse eid="NUM 26:6"/></para>
  <para style="lf">
    <verse number="7" style="v" sid="NUM 26:7"/>ጀር ኩኔን በልበለወን ሩቤን፤ ባይእንሳኒስ 43,730 ቱሬ።<verse eid="NUM 26:7"/></para>
  <para style="li2">
    <verse number="8" style="v" sid="NUM 26:8"/>እልም ፈሉስ ኤሊያብ፤ <verse eid="NUM 26:8"/><verse number="9" style="v" sid="NUM 26:9"/>እልማን ኤሊያብስ ኔሙኤል፣ ዳታኒፊ አቤሮን። ዳታኒፊ አቢራም ኩኔን ቆንዳልቶተ ወልዳ ከኔን ሙሴፊ አሮንት ፍንጭለኒዸ፤ እሳን ዬሮ ቆራሂፊ ዱካ ቡቶትንሳ <char style="nd">ዋቀዮት</char> ፍንጭለን ሰነስ አች ኬሰ ቱረን። <verse eid="NUM 26:9"/><verse number="10" style="v" sid="NUM 26:10"/>ለፍትስ አፋን በነቴ ቆራሂፊ እሳንሌ ልቅምስቴ፤ ወር ገሬ ቆራህሞ ዬሮ እብዲ ነሞተ 250 ፍጤ ሰነ ዹመን። እሳንስ መለቶ ነሞትን እቲን ኦፍ ኤገተን ተአን። <verse eid="NUM 26:10"/><verse number="11" style="v" sid="NUM 26:11"/>እልማን ቆራህ ገሩ ህንዱኔ።<verse eid="NUM 26:11"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="12" style="v" sid="NUM 26:12"/>እልማን ስምኦን አኩመ በልበለ በልበለሳኒት ከኔኒዸ፦</para>
  <para style="li2" vid="NUM 26:12">ከራ ኔሙኤል፣ በልበለ ኔሙኤሎታ፤</para>
  <para style="li2" vid="NUM 26:12">ከራ ያሚን፣ በልበለ ያሚኖታ፤</para>
  <para style="li2" vid="NUM 26:12">ከራ ያኪን፣ በልበለ ያኪኖታ፤<verse eid="NUM 26:12"/></para>
  <para style="li2">
    <verse number="13" style="v" sid="NUM 26:13"/>ከራ ዜራን፣ በልበለ ዜሮታ፤</para>
  <para style="li2" vid="NUM 26:13">ከራ ሻዉል፣ በልበለ ሻዉሎታት።<verse eid="NUM 26:13"/></para>
  <para style="lf">
    <verse number="14" style="v" sid="NUM 26:14"/>ጀር ኩኔን በልበለወን ስምኦኒት፤ እሳንስ ነሞተ 22,200 ቱረን።<verse eid="NUM 26:14"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="15" style="v" sid="NUM 26:15"/>እልማን ጋድ አኩመ በልበለ በልበለሳኒት ከኔኒዸ፦</para>
  <para style="li2" vid="NUM 26:15">ከራ ዜፎን፣ በልበለ ዜፎኖታ፤</para>
  <para style="li2" vid="NUM 26:15">ከራ ሀጊ፣ በልበለ ሀጎታ፤</para>
  <para style="li2" vid="NUM 26:15">ከራ ሹኒ፣ በልበለ ሹኖታ፤<verse eid="NUM 26:15"/></para>
  <para style="li2">
    <verse number="16" style="v" sid="NUM 26:16"/>ከራ ኦዝኒ፣ በልበለ ኦዝኖታ፤</para>
  <para style="li2" vid="NUM 26:16">ከራ ኤሪ፣ በልበለ ኤሮታ፤<verse eid="NUM 26:16"/></para>
  <para style="li2">
    <verse number="17" style="v" sid="NUM 26:17"/>ከራ አሮድ፣ በልበለ አሮዶታ፤</para>
  <para style="li2" vid="NUM 26:17">ከራ አርኤል፣ በልበለ አርኤሎታት።<verse eid="NUM 26:17"/></para>
  <para style="lf">
    <verse number="18" style="v" sid="NUM 26:18"/>ጀር ኩኔን በልበለወን ጋዲት፤ ባይእንሳኒስ 40,500 ቱሬ።<verse eid="NUM 26:18"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="19" style="v" sid="NUM 26:19"/>ኤሪፊ ኦናን እልማን ይሁዳት፤ እሳን ገሩ ከነኣን ኬሰት ዱአን።<verse eid="NUM 26:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="NUM 26:20"/>እልማን ይሁዳ አኩመ በልበለ በልበለሳኒት ከኔኒዸ፦</para>
  <para style="li2" vid="NUM 26:20">ከራ ሼላ፣ በልበለ ሼላኖታ፤</para>
  <para style="li2" vid="NUM 26:20">ከራ ፋሬስ፣ በልበለ ፋሬሶታ፤</para>
  <para style="li2" vid="NUM 26:20">ከራ ዛራ፣ በልበለ ዛሮታት።<verse eid="NUM 26:20"/></para>
  <para style="li2">
    <verse number="21" style="v" sid="NUM 26:21"/>እልማን ፋሬስስ ከኔኒዸ፦</para>
  <para style="li3" vid="NUM 26:21">ከራ ሄዝሮን፣ በልበለ ሄዝሮኖታ፤</para>
  <para style="li3" vid="NUM 26:21">ከራ ሀሙል፣ በልበለ ሀሙሎታት።<verse eid="NUM 26:21"/></para>
  <para style="lf">
    <verse number="22" style="v" sid="NUM 26:22"/>ጀር ኩኔን በልበለወን ይሁዳት፤ ባይእንሳኒስ 76,500 ቱሬ።<verse eid="NUM 26:22"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="23" style="v" sid="NUM 26:23"/>እልማን ይሳኮር አኩመ በልበለ በልበለሳኒት ከኔኒዸ፦</para>
  <para style="li2" vid="NUM 26:23">ከራ ቶላ፣ በልበለ ቶሎታ፤</para>
  <para style="li2" vid="NUM 26:23">ከራ ፉዋ፣ በልበለ ፉዎታ፤<verse eid="NUM 26:23"/></para>
  <para style="li2">
    <verse number="24" style="v" sid="NUM 26:24"/>ከራ ያሹብ፣ በልበለ ያሹቦታ፤</para>
  <para style="li2" vid="NUM 26:24">ከራ ሽምሮን፣ በልበለ ሽምሮኖታት።<verse eid="NUM 26:24"/></para>
  <para style="lf">
    <verse number="25" style="v" sid="NUM 26:25"/>ጀር ኩኔን በልበለወን ይሳኮር፤ ባይእንሳኒስ 64,300 ቱሬ።<verse eid="NUM 26:25"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="26" style="v" sid="NUM 26:26"/>እልማን ዜቡሎን አኩመ በልበለ በልበለሳኒት ከኔኒዸ፦</para>
  <para style="li2" vid="NUM 26:26">ከራ ሴሬድ፣ በልበለ ሴሬዶታ፤</para>
  <para style="li2" vid="NUM 26:26">ከራ ኤሎን፣ በልበለ ኤሎኖታ፤</para>
  <para style="li2" vid="NUM 26:26">ከራ የህልኤል፣ በልበለ የህልኤሎታት።<verse eid="NUM 26:26"/></para>
  <para style="lf">
    <verse number="27" style="v" sid="NUM 26:27"/>ጀር ኩኔን በልበለወን ዜቡሎን፤ ባይእንሳኒስ 60,500 ቱሬ።<verse eid="NUM 26:27"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="28" style="v" sid="NUM 26:28"/>እልማን ዮሴፍ አኩመ በልበለ በልበለሳኒት፦ ምናሴፊ ኤፍሬም።<verse eid="NUM 26:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="NUM 26:29"/>እልማን ምናሴ፦</para>
  <para style="li2" vid="NUM 26:29">ከራ ማኪር፣ በልበለ ማኪሮታ፤ ማኪር ኩን አባ ግልኣድ፤</para>
  <para style="li2" vid="NUM 26:29">ከራ ግልኣድ፣ በልበለ ግልኣዶታት።<verse eid="NUM 26:29"/></para>
  <para style="li2">
    <verse number="30" style="v" sid="NUM 26:30"/>እልማን ግልኣድ እሳን ከኔኒዸ፦</para>
  <para style="li3" vid="NUM 26:30">ከራ ኢኤዜር፣ በልበለ ኢኤዜሮታ፤</para>
  <para style="li3" vid="NUM 26:30">ከራ ሄሌቅ፣ በልበለ ሄሌቆታ፤<verse eid="NUM 26:30"/></para>
  <para style="li3">
    <verse number="31" style="v" sid="NUM 26:31"/>ከራ አስርኤል፣ በልበለ አስሪኤሎታ፣</para>
  <para style="li3" vid="NUM 26:31">ከራ ሼኬም፣ በልበለ ሼኬሞታ፤<verse eid="NUM 26:31"/></para>
  <para style="li3">
    <verse number="32" style="v" sid="NUM 26:32"/>ከራ ሼሚዳ፣ በልበለ ሼሚዳ፤</para>
  <para style="li3" vid="NUM 26:32">ከራ ሄፌር፣ በልበለ ሄፌሮታት።<verse eid="NUM 26:32"/></para>
  <para style="li3">
    <verse number="33" style="v" sid="NUM 26:33"/>ዜሎፌሃድ እልም ሄፌር እልማን ህንቀቡ ቱሬ፤ እን እንተለን ቆፈ ቀበ ቱሬ፤ መቃንሳኒስ መህላ፣ ኖሂ፣ ሆግላ፣ ሚልካፊ ቲርዛዸ።<verse eid="NUM 26:33"/></para>
  <para style="lf">
    <verse number="34" style="v" sid="NUM 26:34"/>ጀር ኩኔን በልበለወን ምናሴት፤ ባይእንሳኒስ 52,700 ቱሬ።<verse eid="NUM 26:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="NUM 26:35"/>እልማን ኤፍሬም አኩመ በልበለ በልበለሳኒት ከኔኒዸ፦</para>
  <para style="li2" vid="NUM 26:35">ከራ ሹቴላ፣ በልበለ ሹቴሎታ፤</para>
  <para style="li2" vid="NUM 26:35">ከራ ቤኬር፣ በልበለ ቤኬሮታ፤</para>
  <para style="li2" vid="NUM 26:35">ከራ ታሀን፣ በልበለ ታሀኖታት።<verse eid="NUM 26:35"/></para>
  <para style="li2">
    <verse number="36" style="v" sid="NUM 26:36"/>እልማን ሹቴላ እሳን ከኔኒዸ፦</para>
  <para style="li3" vid="NUM 26:36">ከራ ኤራን፣ በልበለ ኤራኖታት።<verse eid="NUM 26:36"/></para>
  <para style="lf">
    <verse number="37" style="v" sid="NUM 26:37"/>ጀር ኩኔን በልበለወን ኤፍሬም፤ ባይእንሳኒስ 32,500 ቱሬ።</para>
  <para style="lf" vid="NUM 26:37">እሳን ኩኔን እልማን ዮሴፍ ወረ አኩመ በልበለ በልበለሳኒት ለካአመኒዸ።<verse eid="NUM 26:37"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="38" style="v" sid="NUM 26:38"/>እልማን ቤንያም አኩመ በልበለ በልበለሳኒት ከኔኒዸ፦</para>
  <para style="li2" vid="NUM 26:38">ከራ ቤላ፣ በልበለ ቤላኦታ፤</para>
  <para style="li2" vid="NUM 26:38">ከራ አሽቤል፣ በልበለ አስቤሎታ፤</para>
  <para style="li2" vid="NUM 26:38">ከራ አሂራም፣ በልበለ አሂራሞታ፤<verse eid="NUM 26:38"/></para>
  <para style="li2">
    <verse number="39" style="v" sid="NUM 26:39"/>ከራ ሼፉፋም፣ በልበለ ሼፉፋሞታ፤</para>
  <para style="li2" vid="NUM 26:39">ከራ ሁፋም፣ በልበለ ሁፋሞታት።<verse eid="NUM 26:39"/></para>
  <para style="li2">
    <verse number="40" style="v" sid="NUM 26:40"/>እልማን ቤላ፣ ከራ አርዲፊ ነአማን፦</para>
  <para style="li3" vid="NUM 26:40">ከራ አርዲ፣ በልበለ አርዶታ፤</para>
  <para style="li3" vid="NUM 26:40">ከራ ነአማን፣ በልበለ ነአማኖታት።<verse eid="NUM 26:40"/></para>
  <para style="lf">
    <verse number="41" style="v" sid="NUM 26:41"/>ጀር ኩኔን በልበለወን ቤንያም፤ ባይእንሳኒስ 45,600 ቱሬ።<verse eid="NUM 26:41"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="42" style="v" sid="NUM 26:42"/>እልማን ዳን አኩመ በልበለ በልበለሳኒት ከኔኒዸ፦</para>
  <para style="li2" vid="NUM 26:42">ከራ ሹሃም፣ በልበለ ሹሃሞታት።</para>
  <para style="lf" vid="NUM 26:42">ጀር ኩኔን በልበለወን ዳን፦ <verse eid="NUM 26:42"/><verse number="43" style="v" sid="NUM 26:43"/>እሳን ሁንድኑ በልበለወን ሹሃሞታት፤ ባይእንሳኒስ 64,400 ቱሬ።<verse eid="NUM 26:43"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="44" style="v" sid="NUM 26:44"/>እልማን ኣሼር አኩመ በልበለ በልበለሳኒት ከኔኒዸ፦</para>
  <para style="li2" vid="NUM 26:44">ከራ ይምና፣ በልበለ ዩምኖታ፤</para>
  <para style="li2" vid="NUM 26:44">ከራ ይሽዊ፣ በልበለ ይሽዊዮታ፤</para>
  <para style="li2" vid="NUM 26:44">ከራ ቤሪያ፣ በልበለ ቤሪዮታ፤<verse eid="NUM 26:44"/></para>
  <para style="li2">
    <verse number="45" style="v" sid="NUM 26:45"/>ከራ እልማን ቤሪያሞ፦</para>
  <para style="li3" vid="NUM 26:45">ከራ ሄቤር፣ በልበለ ሄቤሮታ፤</para>
  <para style="li3" vid="NUM 26:45">ከራ መልኪኤል፣ በልበለ መልኪኤሎታት።<verse eid="NUM 26:45"/></para>
  <para style="lf">
    <verse number="46" style="v" sid="NUM 26:46"/>ኣሼር እንተለ ሴራ ጄዸምቱ ቶኮ ቀበ ቱሬ።<verse eid="NUM 26:46"/></para>
  <para style="lf">
    <verse number="47" style="v" sid="NUM 26:47"/>ጀር ኩኔን በልበለወን ኣሼር፤ ባይእንሳኒስ 53,400 ቱሬ።<verse eid="NUM 26:47"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="48" style="v" sid="NUM 26:48"/>እልማን ንፍታሌም አኩመ በልበለ በልበለሳኒት ከኔኒዸ፦</para>
  <para style="li2" vid="NUM 26:48">ከራ የህዜል፣ በልበለ የህዜሎታ፣</para>
  <para style="li2" vid="NUM 26:48">ከራ ጉኒ፣ በልበለ ጉኖታ፤<verse eid="NUM 26:48"/></para>
  <para style="li2">
    <verse number="49" style="v" sid="NUM 26:49"/>ከራ ዬጤር፣ በልበለ ዬጥሮታ፤</para>
  <para style="li2" vid="NUM 26:49">ከራ ሺሌም፣ በልበለ ሺሌሞታት።<verse eid="NUM 26:49"/></para>
  <para style="lf">
    <verse number="50" style="v" sid="NUM 26:50"/>ጀር ኩኔን በልበለወን ንፍታሌም፤ ባይእንሳኒስ 45,400 ቱሬ።<verse eid="NUM 26:50"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="51" style="v" sid="NUM 26:51"/>ወሉማ ገለት ባይእን ዺረ እስራኤል 601,730 ቱሬ።<verse eid="NUM 26:51"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="52" style="v" sid="NUM 26:52"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ <verse eid="NUM 26:52"/><verse number="53" style="v" sid="NUM 26:53"/>“ብይ ሱን አኩመ ባይእነ መቃ ነማት ዻለ ተኤ እሳን ከኔኒፍ ሃቆደሙ። <verse eid="NUM 26:53"/><verse number="54" style="v" sid="NUM 26:54"/>በልበለ ጉዳዻፍ ዻለ ጉዳ፣ በልበለ ጥናዻፍሞ ዻለ ጥና ኬን፤ ቶኮን ቶኮን በልበላ አኩመ ባይእነ ነሞተ ገልሜፈመኒት ዻለሳ ሃአርገቱ። <verse eid="NUM 26:54"/><verse number="55" style="v" sid="NUM 26:55"/>ገሩ ብይ ሱን እጣዻን ሃቆቆደምቱ። እሳንስ አኩመ መቃወን ጎሶተ አቦቲሳኒት ንዻሉ። <verse eid="NUM 26:55"/><verse number="56" style="v" sid="NUM 26:56"/>ቶኮን ቶኮን ዻለ ሰና ገሬ ጉዳፊ ገሬ ጥና ግዱት እጣዻን ሃቆደሙ።”<verse eid="NUM 26:56"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="57" style="v" sid="NUM 26:57"/>ሌዎትን በልበለ በልበላን ለካአመን ከኔኒዸ፦</para>
  <para style="li2" vid="NUM 26:57">ከራ ጌርሾን፣ በልበለ ጌርሾኖታ፤</para>
  <para style="li2" vid="NUM 26:57">ከራ ቆሃት፣ በልበለ ቆሃቶታ፤</para>
  <para style="li2" vid="NUM 26:57">ከራ ሜራሪ፣ በልበለ ሜራሮታት።<verse eid="NUM 26:57"/></para>
  <para style="li1">
    <verse number="58" style="v" sid="NUM 26:58"/>ጀር ኩኔንስ በልበለወን ሌዎታት፦</para>
  <para style="li2" vid="NUM 26:58">በልበለ ሊብኖታ፣</para>
  <para style="li2" vid="NUM 26:58">በልበለ ኬብሮኖታ፣</para>
  <para style="li2" vid="NUM 26:58">በልበለ መሄሎታ፣</para>
  <para style="li2" vid="NUM 26:58">በልበለ ሙሶታ፣</para>
  <para style="li2" vid="NUM 26:58">በልበለ ቆራሆታ።</para>
  <para style="li2" vid="NUM 26:58">ቆሃት አባ አምራም፤ <verse eid="NUM 26:58"/><verse number="59" style="v" sid="NUM 26:59"/>መቃን ኒቲ አምራም ዮኬቤድ። እሼን እንተለ ሌዊ ከን ብየ ግብጥት ሌዊፍ ዸለቴዸ። አምራሚፍስ አሮን፣ ሙሴፊ ኦቦሌቲሳኒ ሚርያም ዴሴ። <verse eid="NUM 26:59"/><verse number="60" style="v" sid="NUM 26:60"/>አሮን አባ ናዳብ፣ አቢሁ፣ ኤሌኣዛሪፊ ኢታማር። <verse eid="NUM 26:60"/><verse number="61" style="v" sid="NUM 26:61"/>ናዳቢፊ አቢሁ ገሩ ዬሮ እብደ ህንኤየመምን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዽኤሰን ሰነ ዱአን።<verse eid="NUM 26:61"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="62" style="v" sid="NUM 26:62"/>ዺሮትን ኡሙሪንሳኒ ጅአ ቶኮፊ ሀመሲ ኦል ተኤ ከኔን ለካአመን ሁንድ 23,000 ቱረን። እሳንስ ሰበቢ ግዱሳኒት ዻለ ህንአርገትኒፍ እስራኤሎተ ካን ወጅን ህንለካአምኔ።<verse eid="NUM 26:62"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="63" style="v" sid="NUM 26:63"/>እሳን ኩኔን ወረ ዬሮ ሙሴፊ ኤሌኣዛር ሉብች ድሬወን ሞኣብረት፣ ዮርዳኖስ ብረት፣ ዬርኮ ገመት እስራኤሎተ ለካአን ሰነ ለካአመኒዸ። <verse eid="NUM 26:63"/><verse number="64" style="v" sid="NUM 26:64"/>ነሞተ ከራ ሙሴቲፊ አሮን ሉብቻን ገሞጂ ሲና ኬሰት ለካአመን ኬሳ ነምን ቶኮዩ እሳን ግዱ ህንቱሬ። <verse eid="NUM 26:64"/><verse number="65" style="v" sid="NUM 26:65"/>ሰበቢ <char style="nd">ዋቀዮ</char> ዋኤሳኒ፣ “እሳን ገሞጂ ኬሰት ንዹሙ” ጄዼ ዱበቴ ቱሬፍ፣ ካሌብ እልመ ዬፉኔፊ እያሱ እልመ ኑን መሌ እሳን ኬሳ ነምን ቶኮዩ ህንሀፍኔ።<verse eid="NUM 26:65"/></para>
  <chapter eid="NUM 26"/>
  <chapter number="27" style="c" sid="NUM 27"/>
  <para style="s1">እንተለን ሰለጰኣድ</para>
  <para style="r">
    <ref loc="NUM 27:1-11">27፥1‑11</ref> ኩወፈ – <char style="xt"><ref loc="NUM 36:1-12">ለኮ 36፥1‑12</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 27:1"/>በልበለ ምናሴ እልመ ዮሴፍ ኬሳስ እንተለን ዜሎፌሃድ እልመ ሄፌር፣ እልመ ግልኣድ፣ እልመ ማኪሪፊ እልመ ምናሴቱ ዽኣቴ። መቃን እንተለን ሰናስ መህላ፣ ኖሂ፣ ሆግላ፣ ሚልካፊ ቲርዛዸ። <verse eid="NUM 27:1"/><verse number="2" style="v" sid="NUM 27:2"/>እሳንስ በልበለ ዱንካነ ወል ገኢ ዱረ፣ ፉለ ሙሴፊ ኤሌኣዛር ሉብቻ ዱረ፣ ፉለ ሆገንቶታቲፊ ወልዳ ሁንዳ ዱረ ዻበተኒ አከነ ጄዸን፤ <verse eid="NUM 27:2"/><verse number="3" style="v" sid="NUM 27:3"/>“አባንኬኘ ገሞጂ ኬሰት ዱኤ። እን ሆገንቶተ ቆራህ ከኔን <char style="nd">ዋቀዮት</char> ፍንጭለን ሰነ ኬሰ ህንቱሬ። ገሩ እን ጩቡዹመ ኦፊሳቲን ዱኤ። እልማንስ ህንቀቡ ቱሬ። <verse eid="NUM 27:3"/><verse number="4" style="v" sid="NUM 27:4"/>ማሊፍ መቃን አባኬኛ ሰበቢ እን እልመ ህንቀብኔፍ በልበለሳ ኬሳ በደ? ፍሮተ አባኬኛ ግዱት ዻለ ኑ ኬን።”<verse eid="NUM 27:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 27:5"/>ሙሴን ዱቢሳኒ ሰነ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዽኤሴ፤ <verse eid="NUM 27:5"/><verse number="6" style="v" sid="NUM 27:6"/><char style="nd">ዋቀዮስ</char> አከነ ጄዼን፤ <verse eid="NUM 27:6"/><verse number="7" style="v" sid="NUM 27:7"/>“ወን እንተለን ዜሎፌሃድ ጄዸን ኩን ስሪዸ። አትስ ፍሮተ አባሳኒ ግዱት ዻለ ኬኒፍ፤ ዻለ አባሳኒስ እሳኒፍ ደበርስ።<verse eid="NUM 27:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 27:8"/>“እስራኤሎታን አከነ ጄዽ፤ ‘ዮ ነምን ኡቱ እልመ ህንዸልችን ዱኤ፣ ዻለሳ እንተለሳቲፍ ደበርሳ። <verse eid="NUM 27:8"/><verse number="9" style="v" sid="NUM 27:9"/>ዮ እን እንተለስ ቀባቹ ባቴ ዻለሳ ኦቦሎተሳቲፍ ኬና። <verse eid="NUM 27:9"/><verse number="10" style="v" sid="NUM 27:10"/>ዮ እን ኦቦሎተ ቀባቹ ባቴ ዻለሳ ኦቦሎተ አባሳቲፍ ኬና። <verse eid="NUM 27:10"/><verse number="11" style="v" sid="NUM 27:11"/>ዮ አባንሳ ኦቦሎተ ቀባቹ ባቴሞ ዻለሳ በልበለሳ ኬሳ ፍረ ኣንቴፍ ኬና፤ ፍር ሱን ሃዻሉ። ኩንስ አኩመ <char style="nd">ዋቀዮ</char> ሙሴ አጀጄ ሰነት ሰበ እስራኤሊፍ ስርነ ሴረ ቀቤሰ ሃተኡ።’ ”<verse eid="NUM 27:11"/></para>
  <para style="s1">እያሱን እዶ ሙሴ ቡኡሳ</para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 27:12"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ “ቱሉ አባሪም ከነት ኦል በኢቲ ብየ አን ሰበ እስራኤሊፍ ኬኔ እላል። <verse eid="NUM 27:12"/><verse number="13" style="v" sid="NUM 27:13"/>ኤርገ ብየ ሰነ አርግቴ ቦዴ አትስ አኩመ ኦቦሌሰኬ አሮን ገረ ሰበኬቲት ወልት ቀበምተ፤ <verse eid="NUM 27:13"/><verse number="14" style="v" sid="NUM 27:14"/>ዬሮ ወልዳን ገሞጂ ሲን ኬሰት ነት ፍንጭሌት እስን ለቸኑስ አጀጀኮት ፍንጭልተኒ ቱርተኒቲ። እስን ብሻኖተ ሰነ ብረት ፉለሳኒ ዱረት ቁልቁልነኮ ህንሙልእፍኔ።” ብሻኖትን ኩኔንስ ብሻኖተ መሪባ ቃዴሽ ከን ገሞጂ ሲን ኬሰ ጅረኒዸ።<verse eid="NUM 27:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 27:15"/>ሙሴንስ <char style="nd">ዋቀዮን</char> አከነ ጄዼ፤ <verse eid="NUM 27:15"/><verse number="16" style="v" sid="NUM 27:16"/>“<char style="nd">ዋቀዮ</char> ዋቅን ሀፉሮተ ነመ ሁንዳ ወልዳ ከነረት ነመ ቶኮ ሃሙዱ፤ <verse eid="NUM 27:16"/><verse number="17" style="v" sid="NUM 27:17"/>ነምች ኩንስ አከ ሰብን <char style="nd">ዋቀዮ</char> አኩመ ሆሎተ ትክሴ ህንቀብኔ ህንታኔፍ ከን እሳን ዱረ ገድ በኡፊ ኦል ገሉ፣ ከን ገድ እሳን ባሱፊ ኦል እሳን ገልቹዸ።”<verse eid="NUM 27:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 27:18"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ “እያሱ እልመ ኑን፣ ነምቸ ሀፉር ኬሰ ጅሩ ሰነ ፉዺ ሀርከኬ እሰረ ካእ። <verse eid="NUM 27:18"/><verse number="19" style="v" sid="NUM 27:19"/>አከ እን ፉለ ኤሌኣዛር ሉብቻቲፊ ፉለ ወልዳ እስራኤል ሁንዳ ዱረ ዻበቱ ጎዽ፤ ፉሉመሳኒ ዱረትስ እሰ ሙድ። <verse eid="NUM 27:19"/><verse number="20" style="v" sid="NUM 27:20"/>አከ ሰብን እስራኤል ሁንድ እሳፍ አጀጀሙፍ ኣንጎኬራ ኬኒፍ። <verse eid="NUM 27:20"/><verse number="21" style="v" sid="NUM 27:21"/>እንስ ፉለ ኤሌኣዛር ሉብቻ ከን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ኡሪሚዻን ጋፈቴ ሙርቲ እሳፍ ኬኑ ዱረ ዻበቹ ቀበ። እኒፊ ወልዳን እስራኤሎታ ሁንድ አጀጀሳቲን በኡ፤ አጀጁመሳቲንስ ገሉ።”<verse eid="NUM 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 27:22"/>ሙሴን አኩመ <char style="nd">ዋቀዮ</char> እሰ አጀጄ ሰነ ጎዼ። እንስ እያሱ ጌሴ አከ እን ፉለ ኤሌኣዛር ሉብቻቲፊ ፉለ ወልዳ እስራኤል ሁንዳ ዱረ ዻበቱ ጎዼ። <verse eid="NUM 27:22"/><verse number="23" style="v" sid="NUM 27:23"/>ኤርገሲስ አኩመ <char style="nd">ዋቀዮ</char> ከራ ሙሴቲን አጀጄ ሰነ ሀርከ ኦፊሳ እሰረ ካኤ እሰ ሙዴ።<verse eid="NUM 27:23"/></para>
  <chapter eid="NUM 27"/>
  <chapter number="28" style="c" sid="NUM 28"/>
  <para style="s1">ኣርሳ ጉዩመ ጉያን ዽኤፈሙ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 28:1"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ <verse eid="NUM 28:1"/><verse number="2" style="v" sid="NUM 28:2"/>“አጀጀ ከነ እስራኤሎታፍ ኬን፤ አከነስ ጄዺን፦ ‘ኣርሳ ኛታ ከን እብዳን አናፍ ዽኤፈሙ ከን ፎሊንሳ ነት ቶሉ ሰነ ዬሮ ሙርታኤት ና ዽኤሱኬሰን ምርከኔፈዻ።’ <verse eid="NUM 28:2"/><verse number="3" style="v" sid="NUM 28:3"/>አከነ እሳኒን ጄዽ፤ ‘ኣርሳን እስን እብዳን <char style="nd">ዋቀዮፍ</char> ዽኤስተን እሰ ከነ፦ ጦባላወን ሆላ ለመ ከኔን ኡሙሪንሳኒ ወጋ ቶኮ ቶኮቲፊ ከኔን ህርእነ ህንቀብኔ ኣርሳ ጉበሙ ከን ዬሮ ሁንደ ጉዩመ ጉያን ዽኤፈሙ ጎዻ ዽኤሳ። <verse eid="NUM 28:3"/><verse number="4" style="v" sid="NUM 28:4"/>ጦባላ ሆላ ቶኮ ገነመ፣ ካንሞ ገልገለ ዽኤስ። <verse eid="NUM 28:4"/><verse number="5" style="v" sid="NUM 28:5"/>ከነ ወጅንስ ኬና ምዻኒ ከን ዳኩ ቡላኣ ኢፊ<note caller="+" style="f"><char style="fr" closed="false">28፥5 </char><char style="ft" closed="false">ኢፊን ቶኮ ኪሎ ግራሚ 22።</char></note> ቶኮራ ሀርከ ኩዸን ኬሳ ሀርክ ቶኮ ዘይቲ ኤጄርሳ ከን ጩንፈሜ ኢኒ<note caller="+" style="f"><char style="fr" closed="false">28፥5 </char><char style="ft" closed="false">ኢኒን ቶኮ ሊትሪ 3.8።</char></note> ቶኮ ሀርከ አፉር ኬሳ ሀርከ ቶኮን ሱኩመሜ ዽኤስ። <verse eid="NUM 28:5"/><verse number="6" style="v" sid="NUM 28:6"/>ኩንስ ኣርሳ ዬሮ ሁንደ ጉበሙ ከን ፎሊንሳ ቶሉፊ ከን እብዳን <char style="nd">ዋቀዮፍ</char> ዽኤፈሙ ከን ቱሉ ሲናረት አጀጀሜዸ። <verse eid="NUM 28:6"/><verse number="7" style="v" sid="NUM 28:7"/>ዽባዩን ቶኮ ቶኮ ጦባላ ሆላ ወጅን ዽኤፈሙስ ዹጋቲ ጭማ ኢኒ ቶኮራ ሀርከ አፉር ኬሳ ሀርከ ቶኮ ሃተኡ፤ ዽባዩ ሰነስ እዶ ቁልቁሉ ኬሰት <char style="nd">ዋቀዮፍ</char> ዸንገላስ። <verse eid="NUM 28:7"/><verse number="8" style="v" sid="NUM 28:8"/>ጦባላ ሆላ ካንሞ አኩመ ኬና ምዻኒቲፊ ከን ዽባዩ ወጅን ገነመ ዽኤስቴ ሰና ገልገለስ ዽኤስ። ኩንስ ኣርሳ እብዳን ዽኤፈሙ ከን ፎሊንሳ <char style="nd">ዋቀዮት</char> ቶሉዸ።<verse eid="NUM 28:8"/></para>
  <para style="s1">ኣርሳ ጉያ ሰንበታ</para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 28:9"/>“ ‘ጉያ ሰንበታ ጦባላወን ሆላ ለመ ከኔን ኡሙሪንሳኒ ወጋ ቶኮ ተኤፊ ህርእነ ህንቀብኔ ኣርሳ ዽባዩቲፊ ኬና ምዻኒ አከሱመስ ኬና ምዻኒ ከን ዳኩ ቡላኣ ኢፊ ቶኮራ ሀርከ ኩዸን ኬሳ ሀርክ ለመ ዘይቲዻን ሱኩመሜ ወጅን ዽኤስ። <verse eid="NUM 28:9"/><verse number="10" style="v" sid="NUM 28:10"/>ኩንስ ኣርሳ ጉበሙ ከን ኣርሳ ዬሮ ሁንደ ጉበሙፊ ዽባዩሳት ደበለሜ ሰንበተ ሰንበታን ዽኤፈሙዸ።<verse eid="NUM 28:10"/></para>
  <para style="s1">ኣርሳ ጅአ ጅኣን ዽኤፈሙ</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 28:11"/>“ ‘ጀልቀበ ጅኦተኬሰኒ ሁንደት ጅቦተ ሎኒ ለመ፣ ኮርቤሰ ሆላ ቶኮ፣ ጦባላወን ሆላ ቶርበ ከኔን ኡሙሪንሳኒ ወጋ ቶኮ ተኤፊ ከኔን ህርእነ ህንቀብኔ ኣርሳ ጉበሙ ጎዻቲ <char style="nd">ዋቀዮፍ</char> ዽኤሳ። <verse eid="NUM 28:11"/><verse number="12" style="v" sid="NUM 28:12"/>ቶኮ ቶኮ ጅቦተ ሎኒ ወጅን ኬና ምዻኒ ከን ዳኩ ቡላኣ ኢፊ ቶኮራ ሀርከ ኩዸን ኬሳ ሀርክ ሰዲ ዘይቲዻን ሱኩመሜ፣ ኮርቤሰ ሆላ ሰነ ወጅንስ ኬና ምዻኒ ከን ዳኩ ቡላኣ ኢፊ ቶኮራ ሀርከ ኩዸን ኬሳ ሀርክ ለመ ዘይቲዻን ሱኩመሜ ዽኤፈሙ ቀበ፤ <verse eid="NUM 28:12"/><verse number="13" style="v" sid="NUM 28:13"/>ቶኮ ቶኮ ጦባላ ሆላ ወጅንስ ኬናን ምዻኒ ከን ዳኩ ቡላኣ ኢፊ ቶኮራ ሀርከ ኩዸን ኬሳ ሀርክ ቶኮ ዘይቲዻን ሱኩመሜ ዽኤፈሙ ቀበ። ኩንስ ኣርሳ ጉበሙ ከን እብዳን <char style="nd">ዋቀዮፍ</char> ዽኤፈሙፊ ፎሊንሳ ቶሉዸ። <verse eid="NUM 28:13"/><verse number="14" style="v" sid="NUM 28:14"/>ቶኮ ቶኮ ድብቸ ሎኒ ወጅን ዽባዩ ዳዺ ወይኒ ኢኒ ቶኮራ ወለካሳ፣ ቶኮ ቶኮ ጦባላ ሆላ ወጅን ኢኒ ቶኮራ ሀርከ ሰዲ ኬሳ ሀርከ ቶኮ፣ ኮርቤሰ ሆላ ሰነ ወጅንስ ኢኒ ቶኮራ ሀርከ አፉር ኬሳ ሀርክ ቶኮ ሃዽኤፈሙ። ኩንስ ኣርሳ ጉበሙ ከን ወጋ ኬሰት ባቲ ሃራት ዽኤፈሙዸ። <verse eid="NUM 28:14"/><verse number="15" style="v" sid="NUM 28:15"/>አከሱመስ ኣርሳ ጩቡቲፍ ኮርቤሰ ሬኤ ቶኮ <char style="nd">ዋቀዮፍ</char> ዽኤሳ፤ እንስ ኣርሳ ዬሮ ሁንደ ጉበሙፊ ዽባዩሳት ደበለሜ ዽኤፈመ።<verse eid="NUM 28:15"/></para>
  <para style="s1">ፋሲካ</para>
  <para style="r">
    <ref loc="NUM 28:16-25">28፥16‑25</ref> ኩወፈ – <char style="xt"><ref loc="EXO 12:14-20">በኡ 12፥14‑20</ref>፤ <ref loc="LEV 23:4-8">ሌዎ 23፥4‑8</ref>፤ <ref loc="DEU 16:1-8">ኬዴ 16፥1‑8</ref></char></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 28:16"/>“ ‘ቡልቲ ኩዸ አፉረፋ ጅአ ጀልቀባት ፋሲካን <char style="nd">ዋቀዮ</char> አያኔፈሙ ቀበ። <verse eid="NUM 28:16"/><verse number="17" style="v" sid="NUM 28:17"/>ቡልቲ ኩዸ ሸነፋ ጅአ ከናት አያነቱ ጅረ፤ እስንስ ጉያ ቶርበ መጥኖ ኛቱ። <verse eid="NUM 28:17"/><verse number="18" style="v" sid="NUM 28:18"/>ጉያ ጀልቀባት ወል ገኢ ቁልቁሉ ቀባዻ፤ ሆጂ እድሌስ ህንሆጄትና። <verse eid="NUM 28:18"/><verse number="19" style="v" sid="NUM 28:19"/>ጅቦተ ሎኒ ለመ፣ ኮርቤሰ ሆላ ቶኮ፣ ጦባላወን ሆላ ቶርበ ከኔን ኡሙሪንሳኒ ወጋ ቶኮ ቶኮ ተኤፊ ከኔን ሁንድሳኒ ህርእነ ህንቀብኔ ኣርሳ ጉበሙ ጎዻቲ እብዳን <char style="nd">ዋቀዮፍ</char> ዽኤሳ። <verse eid="NUM 28:19"/><verse number="20" style="v" sid="NUM 28:20"/>ቶኮ ቶኮ ድብቸ ሎኒ ወጅንስ ኬና ምዻኒ ከን ዳኩ ቡላኣ ኢፊ ቶኮራ ሀርከ ኩዸን ኬሳ ሀርክ ሰዲ ዘይቲዻን ሱኩመሜ፣ ኮርቤሰ ሆላ ወጅን ኢፊ ቶኮራ ሀርከ ኩዸን ኬሳ ሀርከ ለመ፣ <verse eid="NUM 28:20"/><verse number="21" style="v" sid="NUM 28:21"/>ጦባላወን ሆላ ቶርበን ወጅን ቶኮ ቶኮ ጦባላ ሆላቲፍ ኢፊ ቶኮራ ሀርከ ኩዸን ኬሳ ሀርከ ቶኮ ዽኤስ። <verse eid="NUM 28:21"/><verse number="22" style="v" sid="NUM 28:22"/>አከሱመስ አከ አራር እስኒ ቡኡፍ ኮርቤሰ ሬኤ ቶኮ ኣርሳ ጩቡቲፍ ዽኤስ። <verse eid="NUM 28:22"/><verse number="23" style="v" sid="NUM 28:23"/>ከነስ ኣርሳ ጉበሙ ከን ዬሮ ሁንደ ገነመ ገነመ ዽኤፈሙት ደበላቲ ዽኤሳ። <verse eid="NUM 28:23"/><verse number="24" style="v" sid="NUM 28:24"/>ሃሉመ ከናን ኛተ ኣርሳ እብዳን ዽኤፈሙ ከን ፎሊንሳ <char style="nd">ዋቀዮት</char> ቶሉ ሰነ ቡልቲ ቶርባፍ ጉዩመ ጉያን ዽኤሳ፤ እንስ ኣርሳ ጉበሙፊ ዽባዩሳ ከን ዬሮ ሁንደ ዽኤፈሙት ደበለሜ ሃዽኤፈሙ። <verse eid="NUM 28:24"/><verse number="25" style="v" sid="NUM 28:25"/>ቡልቲ ቶርበፋት ወል ገኢ ቁልቁሉ ቀባዻ፤ ሆጂ እድሌስ ህንሆጄትና።<verse eid="NUM 28:25"/></para>
  <para style="s1">አያነ ቶርበኖታ</para>
  <para style="r">
    <ref loc="NUM 28:26-31">28፥26‑31</ref> ኩወፈ – <char style="xt"><ref loc="LEV 23:15-22">ሌዎ 23፥15‑22</ref>፤ <ref loc="DEU 16:9-12">ኬዴ 16፥9‑12</ref></char></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 28:26"/>“ ‘አያነ ቶርበኖታ ኬሰ ጉያ አያነ መታ ምዻኒት ዬሮ ኬና ምዻን ሃራ <char style="nd">ዋቀዮፍ</char> ዽኤስተን ሰነ ወል ገኢ ቁልቁሉ ጎዸዻ፤ ሆጂ እድሌስ ህንሆጄትና። <verse eid="NUM 28:26"/><verse number="27" style="v" sid="NUM 28:27"/>ጅቦተ ሎኒ ለመ፣ ኮርቤሰ ሆላ ቶኮፊ ጦባላወን ሆላ ቶርበ ከኔን ኡሙሪንሳኒ ወጋ ቶኮ ቶኮ ተኤ ኣርሳ ጉበሙ ከን ፎሊንሳ <char style="nd">ዋቀዮት</char> ቶሉ ዽኤሳ። <verse eid="NUM 28:27"/><verse number="28" style="v" sid="NUM 28:28"/>ቶኮ ቶኮ ድብቸ ሎኒ ወጅንስ ኬናን ምዻኒ ከን ዳኩ ቡላኣ ኢፊ ቶኮራ ሀርከ ኩዸን ኬሳ ሀርክ ሰዲ ዘይቲዻን ሱኩመሜ ሃዽኤፈሙ። ኮርቤሰ ሆላ ወጅን ኢፊ ቶኮራ ሀርከ ኩዸን ኬሳ ሀርክ ለመ፣ <verse eid="NUM 28:28"/><verse number="29" style="v" sid="NUM 28:29"/>ጦባላወን ሆላ ቶርበን ሰነ ወጅንስ ኢፊ ቶኮራ ሀርከ ኩዸን ኬሳ ሀርክ ቶኮ ሃዽኤፈሙ። <verse eid="NUM 28:29"/><verse number="30" style="v" sid="NUM 28:30"/>አከሱመስ አከ አራር እስኒ ቡኡፍ ኮርቤሰ ሬኤ ቶኮ እት ደበላ ዽኤሳ። <verse eid="NUM 28:30"/><verse number="31" style="v" sid="NUM 28:31"/>ኣርሳወን ከኔን ዽባዩሳኒ ወጅን፣ ኣርሳ ጉበሙ ከን ዬሮ ሁንደ ዽኤፈሙፊ ኬና ምዻንሳት ደበላቲ ዽኤሳ፤ ሆሪን ሱንስ ከን ህርእነ ህንቀብኔ ተኡሳኒ ምርከኔፈዻ።<verse eid="NUM 28:31"/></para>
  <chapter eid="NUM 28"/>
  <chapter number="29" style="c" sid="NUM 29"/>
  <para style="s1">አያነ መለከታ</para>
  <para style="r">
    <ref loc="NUM 29:1-6">29፥1‑6</ref> ኩወፈ – <char style="xt"><ref loc="LEV 23:23-25">ሌዎ 23፥23‑25</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 29:1"/>“ ‘ጉያ ጀልቀበ ጅአ ቶርበፋት ወል ገኢ ቁልቁሉ ጎዸዻ፤ ጋፈስ ሆጂ እድሌ ህንሆጄትና። ጉያን ኩን ጉያ እስን እት መለከተ አፉፍተኒዸ። <verse eid="NUM 29:1"/><verse number="2" style="v" sid="NUM 29:2"/>ድብቸ ሎኒ ቶኮ፣ ኮርቤሰ ሆላ ቶኮፊ ጦባላወን ሆላ ቶርበ ከኔን ኡሙሪንሳኒ ወጋ ቶኮ ቶኮ ተኤፊ ከኔን ሁንድሳኒ ህርእነ ህንቀብኔ ኣርሳ ጉበሙ ከን ፎሊንሳ <char style="nd">ዋቀዮት</char> ቶሉ ዽኤሳ። <verse eid="NUM 29:2"/><verse number="3" style="v" sid="NUM 29:3"/>ድብቸ ሰነ ወጅንስ ኬና ምዻኒ ከን ዳኩ ቡላኣ ኢፊ<note caller="+" style="f"><char style="fr" closed="false">29፥3 </char><char style="ft" closed="false">ኢፊን ቶኮ ኪሎ ግራሚ 22።</char></note> ቶኮራ ሀርከ ኩዸን ኬሳ ሀርከ ሰዲ ዘይቲዻን ሱኩመሜ ዽኤሳ። ኮርቤሰ ሆላ ወጅንስ ኢፊ ቶኮራ ሀርከ ኩዸን ኬሳ ሀርከ ለመ፣ <verse eid="NUM 29:3"/><verse number="4" style="v" sid="NUM 29:4"/>ጦባላወን ሆላ ቶርበን ሰነ ወጅንስ ኢፊ ቶኮ ሀርከ ኩዸን ኬሳ ሀርከ ቶኮ ዽኤሳ። <verse eid="NUM 29:4"/><verse number="5" style="v" sid="NUM 29:5"/>አከሱመስ አከ አራር እስኒ ቡፈሙፍ ኮርቤሰ ሬኤ ቶኮ እት ደበላቲ ኣርሳ ጩቡቲፍ ዽኤሳ። <verse eid="NUM 29:5"/><verse number="6" style="v" sid="NUM 29:6"/>ኣርሳወን ኩኔን አኩመ አመለሳኒት ኣርሳወን ጉበመን ከኔን ጅአ ጅአቲፊ ጉያ ጉያት ዽኤፈመኒፊ ኬናወን ምዻኒቲፊ ዽባዩሳኒት ደበለመኒ ዽኤፈመኒዸ። እሳንስ ኣርሳወን እብዳን <char style="nd">ዋቀዮፍ</char> ዽኤፈመን ከኔን ፎሊንሳኒ ቶሉዸ።<verse eid="NUM 29:6"/></para>
  <para style="s1">ጉያ አራር እት ቡፈሙ</para>
  <para style="r">
    <ref loc="NUM 29:7-11">29፥7‑11</ref> ኩወፈ – <char style="xt"><ref loc="LEV 16:2-34">ሌዎ 16፥2‑34</ref>፤ <ref loc="LEV 23:26-32">23፥26‑32</ref></char></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 29:7"/>“ ‘ቡልቲ ኩርነፋ ጅአ ቶርበፋ ከናት ወል ገኢ ቁልቁሉ ጎዸዻ፤ እስንስ ገድ ኦፍ ዴብሳ፤ ሆጂ ቶኮሌስ ህንሆጄትና። <verse eid="NUM 29:7"/><verse number="8" style="v" sid="NUM 29:8"/>ድብቸ ሎኒ ቶኮ፣ ኮርቤሰ ሆላ ቶኮፊ ጦባላወን ሆላ ቶርበ ከኔን ኡሙሪንሳኒ ወጋ ቶኮ ቶኮ ተኤ ከኔን ሁንድሳኒ ህርእነ ህንቀብኔ ኣርሳ ጉበሙ ከን ፎሊንሳ <char style="nd">ዋቀዮት</char> ቶሉ ጎዻ ዽኤሳ። <verse eid="NUM 29:8"/><verse number="9" style="v" sid="NUM 29:9"/>ድብቸ ሰነ ወጅንስ ኬና ምዻኒ ከን ዳኩ ቡላኣ ኢፊ ቶኮራ ሀርከ ኩዸን ኬሳ ሀርክ ሰዲ ዘይቲዻን ሱኩመሜ ዽኤሳ፤ ኮርቤሰ ሆላ ወጅንስ ኢፊ ቶኮራ ሀርከ ኩዸን ኬሳ ሀርከ ለመ፣ <verse eid="NUM 29:9"/><verse number="10" style="v" sid="NUM 29:10"/>ጦባላወን ሆላ ቶርበን ሰነ ወጅንስ ኢፊ ቶኮራ ሀርከ ኩዸን ኬሰ ሀርከ ቶኮ ዽኤሳ። <verse eid="NUM 29:10"/><verse number="11" style="v" sid="NUM 29:11"/>አከሱመስ ኣርሳ ጩቡ ከን አራራ ቡሱፍ ዽኤፈሙፊ ኣርሳ ጉበሙ ከን ዬሮ ሁንደ ዽኤፈሙ፣ ኬና ምዻንሳቲፊ ዽባዩሳት ደበላቲ ኮርቤሰ ሬኤ ቶኮ ኣርሳ ጩቡቲፍ ዽኤሳ።<verse eid="NUM 29:11"/></para>
  <para style="s1">አያነ ዱንካነ ቁልቁሉ</para>
  <para style="r">
    <ref loc="NUM 29:12-39">29፥12‑39</ref> ኩወፈ – <char style="xt"><ref loc="LEV 23:33-43">ሌዎ 23፥33‑43</ref>፤ <ref loc="DEU 16:13-17">ኬዴ 16፥13‑17</ref></char></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 29:12"/>“ ‘ቡልቲ ኩዸ ሸነፋ ጅአ ቶርበፋት ወል ገኢ ቁልቁሉ ጎዸዻ፤ ሆጂ እድሌ ህንሆጄትና። <char style="nd">ዋቀዮፍስ</char> ቡልቲ ቶርበ አያነ አያኔፈዻ። <verse eid="NUM 29:12"/><verse number="13" style="v" sid="NUM 29:13"/>ጅቦተ ሎኒ ኩዸ ሰዲ፣ ኮርቤዪ ሆላ ለማፊ ጦባላወን ሆላ ኩዸ አፉር ከኔን ኡሙሪንሳኒ ወጋ ቶኮ ቶኮ ተኤፊ ከኔን ሁንድሳኒ ህርእነ ህንቀብኔ ኣርሳ ጉበሙ ከን ፎሊንሳ <char style="nd">ዋቀዮት</char> ቶሉፊ ከን እብዳን ዽኤፈሙ ዽኤሳ። <verse eid="NUM 29:13"/><verse number="14" style="v" sid="NUM 29:14"/>ቶኮ ቶኮ ጅቦተ ኩዸ ሰደኒ ወጅንስ ኬና ምዻኒ ከን ዳኩ ቡላኣ ኢፊ ቶኮራ ሀርከ ኩዸን ኬሳ ሀርክ ሰዲ ዘይቲዻን ሱኩመሜ ዽኤሳ፤ ቶኮ ቶኮ ኮርቤዪ ሆላ ለማን ሰና ወጅንስ ኢፊ ቶኮራ ሀርከ ኩዸን ኬሳ ሀርከ ለመ፣ <verse eid="NUM 29:14"/><verse number="15" style="v" sid="NUM 29:15"/>ቶኮ ቶኮ ጦባላወን ሆላ ኩዸ አፍረን ሰና ወጅንስ ኢፊ ቶኮራ ሀርከ ኩዸን ኬሳ ሀርከ ቶኮ ዽኤሳ። <verse eid="NUM 29:15"/><verse number="16" style="v" sid="NUM 29:16"/>አከሱመስ ኣርሳ ጉበሙ ከን ዬሮ ሁንደ ዽኤፈሙ ኬና ምዻን እሳቲፊ ዽባዩሳት ደበላቲ ኮርቤሰ ሬኤ ቶኮ ኣርሳ ጩቡቲፍ ዽኤሳ።<verse eid="NUM 29:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 29:17"/>“ ‘ቡልቲ ለመፋት ጅቦተ ሎኒ ኩዸ ለመ፣ ኮርቤዪ ሆላ ለማፊ ጦባላወን ሆላ ኩዸ አፉር ከኔን ኡሙሪንሳኒ ወጋ ቶኮ ቶኮ ተኤፊ ከኔን ሁንድሳኒ ህርእነ ህንቀብኔ ዽኤሳ። <verse eid="NUM 29:17"/><verse number="18" style="v" sid="NUM 29:18"/>አከ ለኮብሰ ሙርታኤቲፊ አኩመ አመለሳኒት ጅቦተ ሎኒ፣ ኮርቤዪ ሆላቲፊ ጦባላወን ሆላ ሰነ ወጅን ኬና ምዻንሳኒቲፊ ዽባዩሳኒ ዽኤሳ። <verse eid="NUM 29:18"/><verse number="19" style="v" sid="NUM 29:19"/>አከሱመስ ኣርሳ ጉበሙ ከን ዬሮ ሁንደ ዽኤፈሙ፣ ኬና ምዻንሳቲፊ ዽባዩሳኒት ደበላቲ ኮርቤሰ ሬኤ ቶኮ ኣርሳ ጩቡቲፍ ዽኤሳ።<verse eid="NUM 29:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 29:20"/>“ ‘ቡልቲ ሰደፋት ጅቦተ ሎኒ ኩዸ ቶኮ፣ ኮርቤዪ ሆላ ለማፊ ጦባላወን ሆላ ኩዸ አፉር ከኔን ኡሙሪንሳኒ ወጋ ቶኮ ቶኮ ተኤፊ ከኔን ሁንድሳኒ ህርእነ ህንቀብኔ ዽኤሳ። <verse eid="NUM 29:20"/><verse number="21" style="v" sid="NUM 29:21"/>አከ ለኮብሰ ሙርታኤቲፊ አኩመ አመለሳኒት ጅቦተ ሎኒ፣ ኮርቤዪ ሆላ ሰናፊ ጦባላወን ሆላ ሰነ ወጅንስ ኬና ምዻንሳኒቲፊ ዽባዩሳኒ ዽኤሳ። <verse eid="NUM 29:21"/><verse number="22" style="v" sid="NUM 29:22"/>አከሱመስ ኣርሳ ጉበሙ ከን ዬሮ ሁንደ ዽኤፈሙ፣ ኬና ምዻንሳቲፊ ዽባዩሳት ደበላቲ ኮርቤሰ ሬኤ ቶኮ ኣርሳ ጩቡቲፍ ዽኤሳ።<verse eid="NUM 29:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 29:23"/>“ ‘ቡልቲ አፉረፋት ጅቦተ ሎኒ ኩዸን፣ ኮርቤዪ ሆላ ለማፊ ጦባላወን ሆላ ኩዸ አፉር ከኔን ኡሙሪንሳኒ ወጋ ቶኮ ቶኮ ተኤፊ ከኔን ሁንድሳኒ ህርእነ ህንቀብኔ ዽኤሳ። <verse eid="NUM 29:23"/><verse number="24" style="v" sid="NUM 29:24"/>አከ ለኮብሰ ሙርታኤቲፊ አኩመ አመለሳኒት ጅቦተ ሎኒ፣ ኮርቤዪ ሆላ ሰናፊ ጦባላወን ሆላ ሰነ ወጅን ኬና ምዻንሳኒቲፊ ዽባዩሳኒ ዽኤሳ። <verse eid="NUM 29:24"/><verse number="25" style="v" sid="NUM 29:25"/>አከሱመስ ኣርሳ ጉበሙ ከን ዬሮ ሁንደ ዽኤፈሙ፣ ኬና ምዻን እሳቲፊ ዽባዩሳት ደበላቲ ኮርቤሰ ሬኤ ቶኮ ኣርሳ ጩቡቲፍ ዽኤሳ።<verse eid="NUM 29:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 29:26"/>“ ‘ቡልቲ ሸነፋት ጅቦተ ሎኒ ሰገል፣ ኮርቤዪ ሆላ ለማፊ ጦባላወን ሆላ ኩዸ አፉር ከኔን ኡሙሪንሳኒ ወጋ ቶኮ ቶኮ ተኤፊ ከኔን ሁንድሳኒ ህርእነ ህንቀብኔ ዽኤሳ። <verse eid="NUM 29:26"/><verse number="27" style="v" sid="NUM 29:27"/>አከ ለኮብሰ ሙርታኤቲፊ አኩመ አመለሳኒት ጅቦተ ሎኒ፣ ኮርቤዪ ሆላ ሰናፊ ጦባላወን ሆላ ሰነ ወጅን ኬና ምዻንሳኒቲፊ ዽባዩሳኒ ዽኤሳ። <verse eid="NUM 29:27"/><verse number="28" style="v" sid="NUM 29:28"/>አከሱመስ ኣርሳ ጉበሙ ከን ዬሮ ሁንደ ዽኤፈሙ፣ ኬና ምዻንሳቲፊ ዽባዩሳት ደበላቲ ኮርቤሰ ሬኤ ቶኮ ኣርሳ ጩቡቲፍ ዽኤሳ።<verse eid="NUM 29:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 29:29"/>“ ‘ቡልቲ ጀአፋት ጅቦተ ሎኒ ሰዴት፣ ኮርቤዪ ሆላ ለማፊ ጦባላወን ሆላ ኩዸ አፉር ከኔን ኡሙሪንሳኒ ወጋ ቶኮ ቶኮ ተኤፊ ከኔን ሁንድሳኒ ህርእነ ህንቀብኔ ዽኤሳ። <verse eid="NUM 29:29"/><verse number="30" style="v" sid="NUM 29:30"/>አከ ለኮብሰ ሙርታኤቲፊ አኩመ አመለሳኒት ጅቦተ ሎኒ፣ ኮርቤዪ ሆላ ሰናፊ ጦባላወን ሆላ ሰነ ወጅን ኬና ምዻንሳኒቲፊ ዽባዩሳኒ ዽኤሳ። <verse eid="NUM 29:30"/><verse number="31" style="v" sid="NUM 29:31"/>አከሱመስ ኣርሳ ጉበሙ ከን ዬሮ ሁንደ ዽኤፈሙ፣ ኬና ምዻንሳቲፊ ዽባዩሳት ደበላቲ ኮርቤሰ ሬኤ ቶኮ ኣርሳ ጩቡቲፍ ዽኤሳ።<verse eid="NUM 29:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 29:32"/>“ ‘ቡልቲ ቶርበፋት ጅቦተ ሎኒ ቶርበ፣ ኮርቤዪ ሆላ ለማፊ ጦባላወን ሆላ ኩዸ አፉር ከኔን ኡሙሪንሳኒ ወጋ ቶኮ ቶኮ ተኤፊ ከኔን ሁንድሳኒ ህርእነ ህንቀብኔ ዽኤሳ። <verse eid="NUM 29:32"/><verse number="33" style="v" sid="NUM 29:33"/>አከ ለኮብሰ ሙርታኤቲፊ አኩመ አመለሳኒት ጅቦተ ሎኒ፣ ኮርቤዪ ሆላ ሰናፊ ጦባላወን ሆላ ሰነ ወጅን ኬና ምዻኒቲፊ ዽባዩሳኒ ዽኤሳ። <verse eid="NUM 29:33"/><verse number="34" style="v" sid="NUM 29:34"/>አከሱመስ ኣርሳ ጉበሙ ከን ዬሮ ሁንደ ዽኤፈሙ፣ ኬና ምዻንሳቲፊ ዽባዩሳት ደበላቲ ኮርቤሰ ሬኤ ቶኮ ኣርሳ ጩቡቲፍ ዽኤሳ።<verse eid="NUM 29:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 29:35"/>“ ‘ቡልቲ ሰዴተፋት ወል ገኢ ቁልቁሉ ጎዸዻ፤ ሆጂ እድሌ ህንሆጄትና። <verse eid="NUM 29:35"/><verse number="36" style="v" sid="NUM 29:36"/>ድብቸ ሎኒ ቶኮ፣ ኮርቤሰ ሆላ ቶኮፊ ጦባላወን ሆላ ቶርበ ከኔን ኡሙሪንሳኒ ወጋ ቶኮ ቶኮ ተኤፊ ከኔን ሁንድሳኒ ህርእነ ህንቀብኔ ኣርሳ ጉበሙ ከን እብዳን ዽኤፈሙፊ ከን ፎሊንሳ <char style="nd">ዋቀዮት</char> ቶሉ ዽኤሳ። <verse eid="NUM 29:36"/><verse number="37" style="v" sid="NUM 29:37"/>አከ ለኮብሰ ሙርታኤቲፊ አኩመ አመለሳኒት ድብቸ ሎኒ፣ ኮርቤሰ ሆላ ሰናፊ ጦባላወን ሆላ ሰነ ወጅን ኬና ምዻንሳኒቲፊ ዽባዩሳኒ ዽኤሳ። <verse eid="NUM 29:37"/><verse number="38" style="v" sid="NUM 29:38"/>አከሱመስ ኣርሳ ጉበሙ ከን ዬሮ ሁንደ ዽኤፈሙ፣ ኬና ምዻንሳቲፊ ዽባዩሳት ደበላቲ ኮርቤሰ ሬኤ ቶኮ ኣርሳ ጩቡቲፍ ዽኤሳ።<verse eid="NUM 29:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 29:39"/>“ ‘ኣርሳኬሰን ከን ጉበሙ፣ ኬና ምዻንኬሰኒ፣ ዽባዩኬሰኒፊ ኣርሳኬሰን ከን ነጋ፣ ከን ወሬገኬሰኒቲፊ ኣርሳ ፌዺኬሰኒን ዽኤስተንት ደበላቲ አያነኬሰን ቤከማ ሰነረት <char style="nd">ዋቀዮፍ</char> ዽኤሳ።’ ”<verse eid="NUM 29:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 29:40"/>ሙሴንስ ዋን <char style="nd">ዋቀዮ</char> እሰ አጀጄ ሁንደ እስራኤሎተት ህሜ።<verse eid="NUM 29:40"/></para>
  <chapter eid="NUM 29"/>
  <chapter number="30" style="c" sid="NUM 30"/>
  <para style="s1">ወሬገወን</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 30:1"/>ሙሴን አቦቲ ጎሶተ እስራኤሊን አከነ ጄዼ፦ “ወን <char style="nd">ዋቀዮ</char> አጀጄ ከናዸ፦ <verse eid="NUM 30:1"/><verse number="2" style="v" sid="NUM 30:2"/>ነምን ቶኮ ዮ <char style="nd">ዋቀዮፍ</char> ዋ ወሬጌ ዮካን አከ ዋን ቶኮ ሆጄቱ ኦፉማሳቲን ዮ ከከቴ፣ እን ከኩ ኦፊ ሰነ ህንጨብስን፤ ቆደ ከና ዋን ዱበቴ ሁንደ ጉቱ ቀበ።<verse eid="NUM 30:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 30:3"/>“ዮ እንተል ቶኮ ኡቱመ መነ አባሼ ጅርቱ <char style="nd">ዋቀዮፍ</char> ወሬገ ወሬግዴ ዮካን ዋን ቶኮ ጎቹዻፍ ድርቀመ ኬሰ ሴንቴ፣ <verse eid="NUM 30:3"/><verse number="4" style="v" sid="NUM 30:4"/>ዮ አባንሼስ ዋኤ ወሬገሼ ዮካን ድርቀመ ኬሰ ሴኑሼ ዸገኤ ሆማ እሼን ጄቹ ባቴ ወሬግንሼቲፊ ድርቀምን እሼን ሴንቴ ሱን ሁንድ ህንጌደረሙ። <verse eid="NUM 30:4"/><verse number="5" style="v" sid="NUM 30:5"/>ዮ አባንሼ ዋን ከነ ዸገኤ እሼ ዾዌ ገሩ ወሬገሼ ዮካን ከኩ እሼን እቲን ድርቀመ ሴንቴ ኬሳ ቶኮዩ ህንጉተሙ፤ ሰበቢ አባንሼ እሼ ዾዌፍ <char style="nd">ዋቀዮ</char> እሼ ንብልሶምሰ።<verse eid="NUM 30:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 30:6"/>“ዮ እሼን ኤርገ ወሬገ ሴንቴ ቦዴ ዮካን ኤርገ ዱቢ ኡቱ እት ህንያድን ዱበቴን ድርቀመ ሴንቴ ቦዴ ሄሩምቴ፣ <verse eid="NUM 30:6"/><verse number="7" style="v" sid="NUM 30:7"/>ዽርስሼስ ዮ ዋን ከነ ዸገኤ ሆማ እሼን ጄቹ ባቴ ወሬግንሼ ዮካን ድርቀምን እሼን ሴንቴ ሱን ህንጌደረሙ። <verse eid="NUM 30:7"/><verse number="8" style="v" sid="NUM 30:8"/>ገሩ ዽርስሼ ዮ ዬሮ ዋን ከነ ዸገኡት እሼ ዾዌ፣ ወሬገሼ ከን ድርቀመ ኬሰ እሼ ገልቹ ዮካን ዋዳ እሼን ኡቱ እት ህንያድን ድርቀመ ኬሰ ኦፍ ገልችቴ ሰነ እሼ ጀላ ዲገ፤ <char style="nd">ዋቀዮስ</char> እሼ ብልሶምሰ።<verse eid="NUM 30:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 30:9"/>“ወሬግን ሃዸ ህዬሳ ዮካን ዱበርቲ ዽርሰ ጀላ ባቴ፣ ድርቀምን እሼን ሴንቴ ከምዩ እሼ ቀበተ።<verse eid="NUM 30:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 30:10"/>“ዮ ዱበርቲን ዽርሰሼ ወጅን ጅራቱ ቶኮ ወሬገ ቶኮ ወሬግዴ ዮካን ዋን ቶኮ ጎቹዻፍ ከኩዻን ድርቀመ ኬሰ ኦፍ ገልችቴ፣ <verse eid="NUM 30:10"/><verse number="11" style="v" sid="NUM 30:11"/>ዽርስሼስ ዮ ዋን ከነ ዸገኤ ሆማ እሼዻን ጄቹ ባቴ ዮካን ዮ እሼ ዾዉ ባቴ ወሬግንሼ ዮካን ዋዳን እሼን እቲን ድርቀመ ኬሰ ኦፍ ገልችቴ ሱን ሁንድ ህንጌደረሙ። <verse eid="NUM 30:11"/><verse number="12" style="v" sid="NUM 30:12"/>ገሩ ዮ ዽርስሼ ዬሮ ዋን ከነ ዸገኡት እሼ ጀላ ዲጌ፣ ወሬገሼ ዮካን ዋዳ አፋንሼቲ በኤ ኬሳ ቶኮዩ ሆጂረ ህንኦሉ፤ ሰበቢ ዽርስሼ እሼ ጀላ ዲጌፍ፣ <char style="nd">ዋቀዮ</char> እሼ ብልሶምሰ። <verse eid="NUM 30:12"/><verse number="13" style="v" sid="NUM 30:13"/>ዽርስሼ ወሬገ እሼን ወሬግዱ ዮካን ዋዳ እሼን ገድ ኦፍ ቀቡፍ ከኩዻን ሴንቱ ከምዩ ፉዸቹ ዮካን ዲጉ ንደንደአ። <verse eid="NUM 30:13"/><verse number="14" style="v" sid="NUM 30:14"/>ገሩ ዮ ዽርስሼ ጉዩመ ጉያን ሆማ እሼን ጄቹ ባቴ፣ እን ወሬገ እሼ ዮካን ድርቀመ እሼረ ጅሩ ሁንደ ፉዸቴረ ጄቹዸ። እን ሰበቢ ጋፈ ዋኤ ዋን ከና ዸገኤ ሰነ ሆማ እሼዻን ህንጄዽኒፍ ዋን ሰነ ፉዸቴረ። <verse eid="NUM 30:14"/><verse number="15" style="v" sid="NUM 30:15"/>ተኡስ እን ዮ ኤርገ ዋኤ ዋን ከና ዸገኤ ቦዴ ዋዳ ሰነ ዲጌ የከሼት ንጋፈተመ።”<verse eid="NUM 30:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 30:16"/>እሳን ኩኔን ሴረወን ዽርሳፊ ኒቲ ግዱ አከሱመስ አባፊ እንተለሳ ከን ዬሮ እጆሉማሼት መነሳ ጅርቱ ግዱ ጅራቹ ቀቡ ከን <char style="nd">ዋቀዮ</char> ሙሴ አጀጄዸ።<verse eid="NUM 30:16"/></para>
  <chapter eid="NUM 30"/>
  <chapter number="31" style="c" sid="NUM 31"/>
  <para style="s1">ምድያኖተረት ሃሎ በኡ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 31:1"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ <verse eid="NUM 31:1"/><verse number="2" style="v" sid="NUM 31:2"/>“ሰበ እስራኤሊፍ ጄዺቲ ወረ ምድያንረት ሃሎ በእ። ኤርገሲ አት ገረ ሰበኬቲት ወልት ቀበምተ።”<verse eid="NUM 31:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 31:3"/>ከነረት ሙሴን ሰበ ሰናን አከነ ጄዼ፤ “አከ እሳን ወረ ምድያንት ዱለኒ ሃሎ <char style="nd">ዋቀዮ</char> እሳንረት በአኒፍ ነሞተኬሰን ኬሳ ሙራሰ ህዸቺሳ። <verse eid="NUM 31:3"/><verse number="4" style="v" sid="NUM 31:4"/>ቶኮ ቶኮ ጎሰ እስራኤል ኬሳ ነመ ኩመ ቶኮ ቶኮ ዱለት ኤርጋ።” <verse eid="NUM 31:4"/><verse number="5" style="v" sid="NUM 31:5"/>አከስት ቶኮ ቶኮ ጎሰ እስራኤል ኬሳ ነሞትን ኩምን ቶኮ ቶኮ ወልት ቡፈመኒ ነምን ኩምን ኩዸ ለመ ሎላፍ ህዸቴ። <verse eid="NUM 31:5"/><verse number="6" style="v" sid="NUM 31:6"/>ሙሴንስ ቶኮ ቶኮ ጎሳ ኬሳ ነመ ኩመ ቶኮ ቶኮ ፊኔሃስ እልመ ኤሌኣዛር ሉብቻ እሰ ምአ እዶ ቁልቁሉቲፊ መለከተ አፉፈሙ ሀርከት ቀበቴ ሰነ ወጅን ገረ ወራናት ኤርጌ።<verse eid="NUM 31:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 31:7"/>እሳንስ አኩመ <char style="nd">ዋቀዮ</char> ሙሴ አጀጄ ሰነት ወረ ምድያን ሎለኒ ዺረ ሁንደ አጄሰን። <verse eid="NUM 31:7"/><verse number="8" style="v" sid="NUM 31:8"/>ሞቶትን ምድያን ሸነን ጄቹንስ ኤዊ፣ ሬቄም፣ ዙር፣ ሁሪፊ ሬባንስ ወረ አጄፈመን ኬሰ ቱረን። አከሱመስ በለኣም እልመ ቤኦር ጎራዴዻን አጄሰን። <verse eid="NUM 31:8"/><verse number="9" style="v" sid="NUM 31:9"/>እስራኤሎን ዱበርቶታፊ እጆሌ ወረ ምድያን ቦጅአን፤ ሎን፣ ቡሻዬፊ ቀቤኘሳኒ ሁንደስ ንሳመን። <verse eid="NUM 31:9"/><verse number="10" style="v" sid="NUM 31:10"/>መጋላወን ምድያኖትን ኬሰ ጅራተን ሁንዳፊ ቁበተወንሳኒ ሁንደ እብዳን ጉበን። <verse eid="NUM 31:10"/><verse number="11" style="v" sid="NUM 31:11"/>እሳንስ ዋን ቦጅአኒፊ ዋን ሳመን ሁንደ ነማፊ ሆሪሌ ፉዸኒ <verse eid="NUM 31:11"/><verse number="12" style="v" sid="NUM 31:12"/>ወረ ቦጅአን፣ ዋን ቀበተኒፊ ዋን ሳመን ገረ እዶ ቁበተሳኒ ከን ፉለ ዬርኮ ዱረ፣ ዮርዳኖስ ጭነ፣ ድሬወን ሞኣብ ኬሰ ጅሩት ገረ ሙሴት፣ ገረ ኤሌኣዛር ሉብቻቲፊ ገረ ወልዳ እስራኤልት ፍደን።<verse eid="NUM 31:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 31:13"/>ሙሴን፣ ኤሌኣዛር ሉብቺፊ ሆገንቶትን ወልዳ ሁንድ ቁበታን አለት እሳን ስመቹፍ ገድ በአን። <verse eid="NUM 31:13"/><verse number="14" style="v" sid="NUM 31:14"/>ሙሴንስ አጀጁወን ሎልቶታ ጄቹንስ አጀጁወን ኩማቲፊ አጀጁወን ዽባ ከኔን ሎላ ገለንት ኣሬ።<verse eid="NUM 31:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 31:15"/>እንስ አከነ ጄዼ እሳን ጋፈቴ፤ “እስን ማሊፍ ዱበርቶተ ሁንደ ሀምብፍተን? <verse eid="NUM 31:15"/><verse number="16" style="v" sid="NUM 31:16"/>ኩኖ ወር ዋን ጴኦርት ተኤ ሰነ ኬሰት ጎርሰ በለኣም ፉዸቹዻን አከ ዸእች ሰበ ዋቀዮረ ቡኡፍ እስራኤሎተ ዋቀዮራ ዴብሰን እሳን ቱረን። <verse eid="NUM 31:16"/><verse number="17" style="v" sid="NUM 31:17"/>አመስ እልማን ዺራ ሁንደ ፍጣ፤ አከሱመስ ዱበርቲ ዺረ ወጅን ጪፍቴ ሁንደ አጄሳ። <verse eid="NUM 31:17"/><verse number="18" style="v" sid="NUM 31:18"/>ገሩ ዱበረ ተኩማ ዺረ ወጅን ህንጪስን ኦፊኬሰኒፍ ሀምብፈዻ።<verse eid="NUM 31:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 31:19"/>“እስን ኬሳ ነምን ነመ አጄሴ ከምዩ ዮካን ነምን ነመ አጄፈሜ ቱቄ ከምዩ ቡልቲ ቶርበ ቁበታን አለ ሃቱሩ። ቡልቲ ሰደፋፊ ቡልቲ ቶርበፋትስ ኦፊኬሰኒፊ ቦጁኬሰን ቁልቁሌሳ። <verse eid="NUM 31:19"/><verse number="20" style="v" sid="NUM 31:20"/>ኡፈተ ሁንደ አከሱመስ ዋን ጎጋራ፣ ርፌንሰ ሬኤራ ዮካን ሙከራ ሆጄተሜ ሁንደ ቁልቁሌሳ።”<verse eid="NUM 31:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 31:21"/>ኤርገሲስ ኤሌኣዛር ሉብች ሎልቶተ ዱለ ዸቀኒ ቱረን ሰናን አከነ ጄዼ፤ “ቀጄልፈምን ሴራ ከን <char style="nd">ዋቀዮ</char> ሙሴፍ ኬኔ ከናዸ፦ <verse eid="NUM 31:21"/><verse number="22" style="v" sid="NUM 31:22"/>ወርቄ፣ ሜቲ፣ ናሲ፣ ስቢለ፣ ቆርቆሮ፣ ድላሊፊ <verse eid="NUM 31:22"/><verse number="23" style="v" sid="NUM 31:23"/>ወን እብደራ ሀፉ ደንደኡ ከምዩ እብደ ኬሰ ደበርፈሜ ቁልቁላኡ ቀበ። ገሩ ወን ሱን ብሻን ቁልቁላኡማቲንስ ቁልቁሌፈሙ ቀበ። ወን እብደረ ሀፉ ህንደንዴኜ ከምዩ ብሻን ሰናን ቁልቁሌፈመ። <verse eid="NUM 31:23"/><verse number="24" style="v" sid="NUM 31:24"/>ጉያ ቶርበፋት ኡፈተኬሰን ሚጨዻ፤ እስንስ ንቁልቁሌፈምቱ። ኤርገሲ ቁበተት ገሉ ደንዴሱ።”<verse eid="NUM 31:24"/></para>
  <para style="s1">ቦጁ ቆደቹ</para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 31:25"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ <verse eid="NUM 31:25"/><verse number="26" style="v" sid="NUM 31:26"/>“አት፣ ኤሌኣዛር ሉብቺፊ አቦቲን ማቲ ወልዳ ሰና ነሞታፊ ሆሪ ቦጅአመን ለካኣ። <verse eid="NUM 31:26"/><verse number="27" style="v" sid="NUM 31:27"/>ቦጁ ሰነስ ሎልቶተ ዱለ ዸቀኒ ቱረኒፊ ወልዳ ሁንደ ግዱት እዶ ለመት ቆድ። <verse eid="NUM 31:27"/><verse number="28" style="v" sid="NUM 31:28"/>ሎልቶተ ዱለንራ ነመስ ተኡ ሎን፣ ሀሮተ፣ ሆሎተ ዮካን ሬኦተ ዽበ ሸን ኬሳ ቶኮ <char style="nd">ዋቀዮፍ</char> ግብረ ፉዽ። <verse eid="NUM 31:28"/><verse number="29" style="v" sid="NUM 31:29"/>ግብረ ሰነስ ወለካ ቆደሳኒራ ፉዺ ቆደ <char style="nd">ዋቀዮ</char> ጎዺቲ ኤሌኣዛር ሉብቸት ኬን። <verse eid="NUM 31:29"/><verse number="30" style="v" sid="NUM 31:30"/>ወለካ ቆደ ሰበ እስራኤል እራሞ ነመስ ተኡ ሎን፣ ሀሮተ፣ ሆሎተ፣ ሬኦተ ዮካን ሆሪ ብራ ሸንተመ ኬሳ ቶኮ ፉዺቲ ሌዎተ ወረ እት ጋፈተምቶተ ዱንካነ <char style="nd">ዋቀዮ</char> ተአንት ኬን።” <verse eid="NUM 31:30"/><verse number="31" style="v" sid="NUM 31:31"/>ሙሴፊ ኤሌኣዛር ሉብች አኩመ <char style="nd">ዋቀዮ</char> ሙሴ አጀጄ ሰነ ጎዸን።<verse eid="NUM 31:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 31:32"/>ወንት ቦጁ ሎልቶትን ፉዸተንራ ሀፌ ሆሎተ 675,000፣ <verse eid="NUM 31:32"/><verse number="33" style="v" sid="NUM 31:33"/>ሎን 72,000፣ <verse eid="NUM 31:33"/><verse number="34" style="v" sid="NUM 31:34"/>ሀሮተ 61,000፣ <verse eid="NUM 31:34"/><verse number="35" style="v" sid="NUM 31:35"/>ዱበርቶትን ተኩማ ዺረ ወጅን ህንጪስን 32,000 ቱረን።<verse eid="NUM 31:35"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="36" style="v" sid="NUM 31:36"/>ቆድን ወለካ ከን ወረ ዱለኒፍ ቆደሜ፦</para>
  <para style="b" vid="NUM 31:36"/>
  <para style="li1" vid="NUM 31:36">ሆሎተ 337,500 <verse eid="NUM 31:36"/><verse number="37" style="v" sid="NUM 31:37"/>ኬሳ ግብር <char style="nd">ዋቀዮ</char> 675 ቱሬ፤<verse eid="NUM 31:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="NUM 31:38"/>ሎን 36,000 ኬሳ ግብር <char style="nd">ዋቀዮ</char> 72 ቱሬ፤<verse eid="NUM 31:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="NUM 31:39"/>ሀሮተ 30,500 ኬሳ ግብር <char style="nd">ዋቀዮ</char> 61 ቱሬ፤<verse eid="NUM 31:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="NUM 31:40"/>ነመ 16,000 ኬሳ ግብር <char style="nd">ዋቀዮ</char> 32 ቱሬ።<verse eid="NUM 31:40"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="41" style="v" sid="NUM 31:41"/>ሙሴን አኩመ <char style="nd">ዋቀዮ</char> እሰ አጀጄ ሰነት ግብረ ሰነ ቆደ <char style="nd">ዋቀዮ</char> ጎዼ ኤሌኣዛር ሉብቸት ኬኔ።<verse eid="NUM 31:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 31:42"/>ቆደ ወለካ ከን ሙሴን ወረ ዱለንራ እስራኤሎታፍ ቆዴ፦ <verse eid="NUM 31:42"/><verse number="43" style="v" sid="NUM 31:43"/>ወለካን ቦጁ ከን ወልዳ ሰና ሆሎተ 337,500፣ <verse eid="NUM 31:43"/><verse number="44" style="v" sid="NUM 31:44"/>ሎን 36,000፣ <verse eid="NUM 31:44"/><verse number="45" style="v" sid="NUM 31:45"/>ሀሮተ 30,500፣ <verse eid="NUM 31:45"/><verse number="46" style="v" sid="NUM 31:46"/>ነመ 16,000 ቱሬ። <verse eid="NUM 31:46"/><verse number="47" style="v" sid="NUM 31:47"/>ሙሴን አኩመ <char style="nd">ዋቀዮ</char> እሰ አጀጄ ሰነት ወለካ ሰበ እስራኤልራ ነማፊ ሆሪ ሸንተመ ኬሳ ቶኮ ፉዼ ሌዎተ ወረ እት ጋፈተምቶተ ዱንካነ <char style="nd">ዋቀዮ</char> ተአንት ኬኔ።<verse eid="NUM 31:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 31:48"/>ኤርገሲስ አጀጁወን ሎልቶተ ኩማተመረት ኣንጎ ቀበን ጄቹንስ አጀጁወን ኩማቲፊ አጀጁወን ዽባ ገረ ሙሴ ዸቀኒ <verse eid="NUM 31:48"/><verse number="49" style="v" sid="NUM 31:49"/>አከነ ጄዸኒን፤ “ኑ ገርቦንኬ ሎልቶተ አጀጀኬኘ ጀለ ጅረን ለኮፍኔረ፤ ነምን ቶኮዩ ህንህርአትኔ። <verse eid="NUM 31:49"/><verse number="50" style="v" sid="NUM 31:50"/>ከናፉ ኑ ዋን ቶኮን ቶኮንኬኘ አርገትኔ ጄቹንስ ምአ ወርቄ፣ አርቦረ፣ ብተዎ፣ ቁቤላ ቻፓ፣ ሎቲፊ አመርቲ ሞርማ አከ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ኣርሳ አራረ ኑ ቡሱፍ ኬና <char style="nd">ዋቀዮፍ</char> ዽኤፈሙ ጎኔ ፍድኔረ።”<verse eid="NUM 31:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="NUM 31:51"/>ሙሴፊ ኤሌኣዛር ሉብችስ ወርቄፊ ፋየወን ሀርካን ቶልፈመን ሁንደ እሳን ሀርካ ፉዸን። <verse eid="NUM 31:51"/><verse number="52" style="v" sid="NUM 31:52"/>ወርቄን አጀጁወን ኩማቲፊ አጀጁወን ዽባ ኬነን ከኔን ሙሴፊ ኤሌኣዛር አከ ኬናት <char style="nd">ዋቀዮፍ</char> ዽኤሰን ሁንድ ሰቅሊ 16,750 ኡልፋቱ ቱሬ። <verse eid="NUM 31:52"/><verse number="53" style="v" sid="NUM 31:53"/>ቶኮን ቶኮን ሎልቶታ ኦፊሳኒቲፍ ቦጁ ፉዸተኒ ቱረን። <verse eid="NUM 31:53"/><verse number="54" style="v" sid="NUM 31:54"/>ሙሴፊ ኤሌኣዛር ሉብችስ ወርቄ ሰነ አጀጁወን ኩማቲፊ አጀጁወን ዽባ ሀርካ ፉዸኒ አከ እስራኤሎን ፉለ <char style="nd">ዋቀዮ</char> ዱረት እቲን ያደተመኒፍ ዱንካነ ወል ገኢት ኦል ገልቸን።<verse eid="NUM 31:54"/></para>
  <chapter eid="NUM 31"/>
  <chapter number="32" style="c" sid="NUM 32"/>
  <para style="s1">ጎሶተ ዮርዳኖስ ገማ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 32:1"/>እልማን ሩቤኒፊ እልማን ጋድ ወር ሎኒፊ ቡሻዬ ሄዱ ቀበን አከ ብይ የእዜሪፊ ብይ ግልኣድ ሆሪሳኒቲፍ ቶሉ አርገን። <verse eid="NUM 32:1"/><verse number="2" style="v" sid="NUM 32:2"/>እሳን ገረ ሙሴ፣ ገረ ኤሌኣዛር ሉብቻቲፊ ገረ ሆገንቶተ ወልዳ ዹፈኒ አከነ ጄዸን፤ <verse eid="NUM 32:2"/><verse number="3" style="v" sid="NUM 32:3"/>“አጣሮት፣ ዲቦን፣ የእዜር፣ ኒምራ፣ ሄሽቦን፣ ኤሌኣሌ፣ ሴባማ፣ ኔቦፊ ቤኦን፣ <verse eid="NUM 32:3"/><verse number="4" style="v" sid="NUM 32:4"/>ብይ <char style="nd">ዋቀዮ</char> ፉለ ወልዳ እስራኤል ዱረት ሩኩቴ ሱን ሆሪፍ ቶላዸ፤ ኑ ተጃጅልቶትንኬስ ሆሪ ቀብነ። <verse eid="NUM 32:4"/><verse number="5" style="v" sid="NUM 32:5"/>ዮ ኑ ፉለኬ ዱረት ፉዸተመ አርገትኔ ጅራትኔ ብይ ኩን ኑ ተጃጅልቶተኬቲፍ ሀንዹራ ተኤ ሃኬነሙ። አከ ኑ ዮርዳኖስ ገመ ጬኑስ ህንጎዽን።”<verse eid="NUM 32:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 32:6"/>ሙሴንስ እልማን ጋዲፊ እልማን ሩቤኒን አከነ ጄዼ፤ “ኦቦሎትንኬሰን ዱለ ዸቀኒ እስንሞ አስ ቴሱ? <verse eid="NUM 32:6"/><verse number="7" style="v" sid="NUM 32:7"/>እስን ማሊፍ አከ እስራኤሎን ብየ <char style="nd">ዋቀዮ</char> እሳኒ ኬኔ ሰነት ጬአኒ ህንገሌፍ አብዲ እሳን ኩተቺፍቱ? <verse eid="NUM 32:7"/><verse number="8" style="v" sid="NUM 32:8"/>ኩን ዋኑመ አቦቲንኬሰን ጋፈ አን አከ እሳን ብየቲ እላለኒፍ ጄዼ ቃዴሽ በርኔራ እሳን ኤርጌ ሰነ ሆጄተኒዸ። <verse eid="NUM 32:8"/><verse number="9" style="v" sid="NUM 32:9"/>እሳንስ ኤርገ ገረ ሱሉለ ኤሽኮል ዸቀኒ ብየ ሰነ አርገኒ ቦዴ አከ እስራኤሎን ብየ <char style="nd">ዋቀዮ</char> እሳኒፍ ኬኔት ህንገሌፍ አብዲ እሳን ኩተቺሰን። <verse eid="NUM 32:9"/><verse number="10" style="v" sid="NUM 32:10"/>ዼከምስ <char style="nd">ዋቀዮስ</char> ጉዩመ ሰነ ቦበኤ፤ እንስ አከነ ጄዼ ከከቴ፤ <verse eid="NUM 32:10"/><verse number="11" style="v" sid="NUM 32:11"/>‘ዋን እሳን ገራ ጉቱዻን ነ ፋነ ዴሙ ድደኒፍ፣ ነሞተ ወጋ ድግደማቲፊ ሀመሲ ኦሊ ከኔን ብየ ግብጢቲ በአኒ ዹፈን ኬሳ ነምን ቶኮዩ ብየ አን አብረሃሚፍ፣ ይስሃቂፊ ያቆቢፍ ዋዳ ገሌ ሰነ ህንአርጉ። <verse eid="NUM 32:11"/><verse number="12" style="v" sid="NUM 32:12"/>ካሌብ እልመ ዬፉኔ ከን ጎሰ ቄኔዚፊ እያሱ እልመ ኑን መሌ ነምን ቶኮዩ ህንአርጉ፤ እሳን ለማን ገራ ጉቱዻን <char style="nd">ዋቀዮ</char> ዱካ ቡአኒሩቲ።’ <verse eid="NUM 32:12"/><verse number="13" style="v" sid="NUM 32:13"/>ዼከምስ <char style="nd">ዋቀዮ</char> እስራኤልረት ቦበኤ፤ እንስ ሀመ ዸሎትን ፉለሳ ዱረት ዋን ሀማ ሆጄቴ ሱን ሁንድ ዹሙት አከ እሳን ወጋ አፉርተመ ገሞጂ ኬሰ ጆረን ጎዼ።<verse eid="NUM 32:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 32:14"/>“ያ ሰኚ ጩበሞታነነ፣ እስን ኩኖ ዼከምሰ <char style="nd">ዋቀዮ</char> ከን እስራኤልረት ቦበኤ ሰነ እቱመ ጫልችሱፍ እዶ አቦቲኬሰኒ ቡተኒርቱ። <verse eid="NUM 32:14"/><verse number="15" style="v" sid="NUM 32:15"/>ዮ እስን እሰ ዱካ ቡኡራ ገረገልተን እን አመስ ገሞጂ ከነ ኬሰት ሰበ ከነ ሁንደ ንዺሰ፤ እስንስ ኡመተ ከነ ንበሌስቱ።”<verse eid="NUM 32:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 32:16"/>እሳን ገረሳ ዹፈኒ አከነ ጄዸኒን፤ “ኑ አስት ሆሪኬኛፍ ደላ፣ ዱበርቶታፊ እጆሌኬኛፍሞ መጋላወን እጃረ። <verse eid="NUM 32:16"/><verse number="17" style="v" sid="NUM 32:17"/>ኑ ገሩ ሀመ ለፈ እሳኒቲን እሳን ጌኙት ህዸትኔ እስራኤል ዱረ ዴሙፍ ቆጳኦዸ። ዬሮ ከነት አከ ጅራቶትን ብየቲ እሳን ህንቱቅኔፍ ዱበርቶትኒፊ እጆሌንኬኘ መጋላወን ደላ ጀባ ቀበን ኬሰ ሃጅራተን። <verse eid="NUM 32:17"/><verse number="18" style="v" sid="NUM 32:18"/>ሀመ ቶኮን ቶኮን እስራኤሎታ ዻለ ኦፊሳኒ አርገተንት ኑ መነኬኘት ህንዴብኑ። <verse eid="NUM 32:18"/><verse number="19" style="v" sid="NUM 32:19"/>ሰበቢ ዻልኬኘ ለገ ዮርዳኖስራ ገረ በኣት ኑፍ ኬነሜፍ ኑ ዮርዳኖስራ ገመ ካኒን እሳን ወጅን ዋን ዻሉ ህንቀብኑ።”<verse eid="NUM 32:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 32:20"/>ሙሴንስ አከነ እሳኒን ጄዼ፤ “ዮ እስን ዋን ከነ ጎተን፣ ዮ እስን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ህዸተኒ ዱላፍ ካተን፣ <verse eid="NUM 32:20"/><verse number="21" style="v" sid="NUM 32:21"/>ዮ እስን ሁንድኑ ሀመ እን ዲኖተ ኦፊሳ ፉለ ኦፊሳ ዱራ አርኤ ባሱት ህዸተኒ ፉለ <char style="nd">ዋቀዮ</char> ዱረ ዮርዳኖስን ጬተን፣ <verse eid="NUM 32:21"/><verse number="22" style="v" sid="NUM 32:22"/>ዬሮ ብየቲን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ሞአተምቱት እስን እት ጋፈተመ <char style="nd">ዋቀዮፊ</char> ሰበ እስራኤሊፍ ቀብደንራ ንብልሶምቱ። ብይ ሱንስ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዻለኬሰን ተአ።<verse eid="NUM 32:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 32:23"/>“ገሩ እስን ዮ ዋን ከነ ጎቹ ባተን፣ ኩኖ <char style="nd">ዋቀዮት</char> ጩቡ ሆጄቹኬሰን፤ አከ ጩቡንኬሰን እስን አርገቱሌ ቤከዻ። <verse eid="NUM 32:23"/><verse number="24" style="v" sid="NUM 32:24"/>ዱበርቶታፊ እጆሌኬሰኒፍ መጋላወን፣ ቡሻዬኬሰኒፍሞ ደላ እጃራ፤ እስን ገሩ ዋን ዋዳ ገልተን ሰነ ጉታ።”<verse eid="NUM 32:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 32:25"/>እልማን ጋዲፊ እልማን ሩቤን ሙሴዻን አከነ ጄዸን፤ “ኑ ገርቦንኬ አኩመ ጎፍታንኬኘ ኑ አጀጁ ጎነ። <verse eid="NUM 32:25"/><verse number="26" style="v" sid="NUM 32:26"/>እጆሌንኬኛፊ ኒቶትንኬኘ፣ ቡሻዬንኬኛፊ ሎንኬኘ፣ አሱመ መጋላወን ግልኣድት ሃሀፈን። <verse eid="NUM 32:26"/><verse number="27" style="v" sid="NUM 32:27"/>ኑ ገርቦንኬ ገሩ ቶኮን ቶኮንኬኘ አኩመ ጎፍታንኬኘ ጄዼ ሰነ ዱላፍ ቆጶፍኔ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዱሉፍ ንጬነ።”<verse eid="NUM 32:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 32:28"/>ኤርገሲስ ሙሴን ዋኤሳኒ ኤሌኣዛር ሉብቻፍ፣ እያሱ እልመ ኑንቲፊ አቦቲ ማቲ ጎሶተ እስራኤሊፍ አጀጀ ኬኔ። <verse eid="NUM 32:28"/><verse number="29" style="v" sid="NUM 32:29"/>እንስ አከነ እሳኒን ጄዼ፤ “ዮ እልማን ጋዲፊ እልማን ሩቤን፣ ነምን ወራናፍ ህዸቴ ሁንድ ፉለ <char style="nd">ዋቀዮ</char> ዱረት እስን ወጅን ዮርዳኖስ ጬኤ፣ ዮሙ ብየቲን እስን ሀርከ ገልቱት ብየ ግልኣድ ሰነ ኬናፊ። <verse eid="NUM 32:29"/><verse number="30" style="v" sid="NUM 32:30"/>ገሩ እሳን ዮ ዱላፍ ህዸተኒ እስን ወጅን ጬኡ ባተን፣ ከነኣን ኬሰት እስን ወጅን ለፈ ሃአርገተን።”<verse eid="NUM 32:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 32:31"/>እልማን ጋዲፊ እልማን ሩቤንስ አከነ ጄዸኒ ዴቢ ኬነን፤ “ኑ ገርቦንኬ ዋን <char style="nd">ዋቀዮ</char> ጄዼ ንጎነ። <verse eid="NUM 32:31"/><verse number="32" style="v" sid="NUM 32:32"/>ኑ ምአ ሎላ ህዸትኔ ፉለ <char style="nd">ዋቀዮ</char> ዱረ ጬኔ ከነኣን ሴነ፤ ገሩ ቀቤኝ ኑ ዻሉ ዮርዳኖሲን ገመት ኑፍ ሃሀፉ።”<verse eid="NUM 32:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 32:33"/>ሙሴንስ ሞቱማ ስሆን ሞቲ አሞሮታፊ ሞቱማ ኦግ ሞቲ ባሻን ጄቹንስ ብየ ሰነ ጉቱ መጋላወንሳኒቲፊ ቡልቺንሰ ናኖሳኒ ጅሩ ሰነ እልማን ጋዲቲፍ፣ እልማን ሩቤኒቲፊ ወለካ ጎሰ ምናሴ እልመ ዮሴፊፍ ኬኔ።<verse eid="NUM 32:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 32:34"/>እልማን ጋድስ መጋላወን ዲቦን፣ አጣሮት፣ አሮኤር፣ <verse eid="NUM 32:34"/><verse number="35" style="v" sid="NUM 32:35"/>አትሮት ሾፋን፣ የእዜር፣ ዮግብሃ፣ <verse eid="NUM 32:35"/><verse number="36" style="v" sid="NUM 32:36"/>ቤት ኒምራፊ ቤት ሃራን መጋላወን ጀጀቦ ጎዸኒ እጃረን። ቡሻዬሳኒቲፍስ ደላ እጃረተን። <verse eid="NUM 32:36"/><verse number="37" style="v" sid="NUM 32:37"/>እልማን ሩቤንስ መጋላወን ሄሽቦን፣ ኤሌኣሌኒፊ ክርያታይም፣ <verse eid="NUM 32:37"/><verse number="38" style="v" sid="NUM 32:38"/>አከሱመስ ኔቦፊ በኣል ሜኦን ጄቹንስ መጋላወን መቃንሳኒ ጌደረሜፊ ስብማ ዴብሰኒ እጃረን። እሳንስ መጋላወን ዴብሰኒ እጃረን ሰናፍ መቃ ባሰን።<verse eid="NUM 32:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 32:39"/>እጆሌን ማኪር እልመ ምናሴስ ገረ ግልኣድ ዸቀኒ ብየቲ ቀበተኒ አሞሮተ አች ቱረን አርአኒ ባሰን። <verse eid="NUM 32:39"/><verse number="40" style="v" sid="NUM 32:40"/>ሙሴንስ ግልኣድን እጆሌ ማኪር ሰኚ ምናሴቲፍ ኬኔ፤ እሳንስ አች ቁበተን። <verse eid="NUM 32:40"/><verse number="41" style="v" sid="NUM 32:41"/>ያኢር እልም ምናሴስ ዸቄ ገንዶተሳኒ ፉዸቴ ገንዶተ ያኢሮታ ጄዼ ሞጋሴ። <verse eid="NUM 32:41"/><verse number="42" style="v" sid="NUM 32:42"/>ኖባንሞ ቄናቲፊ ገንዶተ ናኖሳ ጅረን ቀበቴ ኖባ ጄዼ መቃ ኦፊ እሳቲን ዋሜ።<verse eid="NUM 32:42"/></para>
  <chapter eid="NUM 32"/>
  <chapter number="33" style="c" sid="NUM 33"/>
  <para style="s1">አዴምሰ እስራኤሎታ</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 33:1"/>ሰደርካሌን አዴምሰ ሰበ እስራኤል ከን ዬሮ እሳን ኩታ ኩታዻን ቀጄልፈመ ሙሴቲፊ አሮን ጀለት ብየ ግብጢ በአኒ ከነ። <verse eid="NUM 33:1"/><verse number="2" style="v" sid="NUM 33:2"/>ሙሴን አጀጀ <char style="nd">ዋቀዮቲን</char> ሰደርካሌ አዴምሰሳኒ ገልሜሴ። አዴምስሳኒስ ሰደርካ ሰደርካዻን ኩኖት፦<verse eid="NUM 33:2"/></para>
  <para style="b"/>
  <para style="pi1">
    <verse number="3" style="v" sid="NUM 33:3"/>እስራኤሎን ጅአ ጀልቀባ ኬሰ ጉያ ኩዸ ሸነፋት ጉያ ፋሲካት ኣኑ ራምሴዻ ከአኒ ቀጄለን። እሳንስ ኡቱመ ወር ግብጢ ሁንድ እሳን አርገኑ እሬ ጀባዻን ዴመን፤ <verse eid="NUM 33:3"/><verse number="4" style="v" sid="NUM 33:4"/>ዬሮ ከነ ወር ግብጥ እልማን ሀንገፈሳኒ ከኔን <char style="nd">ዋቀዮ</char> እሳን ግዱዻ ፍጤ ሁንደ አዋለቻ ቱረን፤ ዋቆተ ወረ ግብጥት <char style="nd">ዋቀዮ</char> ሙሬ ቱሬቲ።<verse eid="NUM 33:4"/></para>
  <para style="pi1">
    <verse number="5" style="v" sid="NUM 33:5"/>እስራኤሎንስ ራምሴዻ ከአኒ ሱኮት ቁበተን።<verse eid="NUM 33:5"/></para>
  <para style="pi1">
    <verse number="6" style="v" sid="NUM 33:6"/>ሱኮቲ ከአኒ ኤታም እሼ ቀርቀረ ገሞጂት አርገምቱ ኬሰ ቁበተን።<verse eid="NUM 33:6"/></para>
  <para style="pi1">
    <verse number="7" style="v" sid="NUM 33:7"/>ኤታሚ ከአኒ ገረ ጲ ሀሂሮት ከን ገመ በአ በኣል ዜፎኒት አርገምቱት ገረ ገለኒ ምግዶል ብረ ቁበተን።<verse eid="NUM 33:7"/></para>
  <para style="pi1">
    <verse number="8" style="v" sid="NUM 33:8"/>ፊሀሂሮቲ ከአኒ ገላነ ኬሰ ደርበኒ ገሞጂ ሴነን፤ እሳንስ ገሞጂ ኤታሚ ኬሰ ቡልቲ ሰዲ ዴመኒ ማራ ቁበተን።<verse eid="NUM 33:8"/></para>
  <para style="pi1">
    <verse number="9" style="v" sid="NUM 33:9"/>ማራዻ ከአኒ ኤልም ለፈ ቡርቃ ኩዸ ለማፊ ሙከ ሜጢ ቶርባተመ ቀቡ ሰነ ዸቀኒ አች ቁበተን።<verse eid="NUM 33:9"/></para>
  <para style="pi1">
    <verse number="10" style="v" sid="NUM 33:10"/>ኤልሚ ከአኒ ገላነ ዲማ ጭነ ቁበተን።<verse eid="NUM 33:10"/></para>
  <para style="pi1">
    <verse number="11" style="v" sid="NUM 33:11"/>ገላነ ዲማዻ ከአኒ ገሞጂ ሲን ኬሰ ቁበተን።<verse eid="NUM 33:11"/></para>
  <para style="pi1">
    <verse number="12" style="v" sid="NUM 33:12"/>ገሞጂ ሲኒቲ ከአኒ ዶፍቃ ቁበተን።<verse eid="NUM 33:12"/></para>
  <para style="pi1">
    <verse number="13" style="v" sid="NUM 33:13"/>ዶፍቃዻ ከአኒ ኣሉሽ ቁበተን።<verse eid="NUM 33:13"/></para>
  <para style="pi1">
    <verse number="14" style="v" sid="NUM 33:14"/>ኣሉሺ ከአኒ ሬፊዲም ለፈ ብሻን ነምን ዹጉ ህንጅሬ ቁበተን።<verse eid="NUM 33:14"/></para>
  <para style="pi1">
    <verse number="15" style="v" sid="NUM 33:15"/>ሬፊዲሚ ከአኒ ገሞጂ ሲና ኬሰ ቁበተን።<verse eid="NUM 33:15"/></para>
  <para style="pi1">
    <verse number="16" style="v" sid="NUM 33:16"/>ገሞጂ ሲናቲ ከአኒ ቂብሮት ሀታባ ቁበተን።<verse eid="NUM 33:16"/></para>
  <para style="pi1">
    <verse number="17" style="v" sid="NUM 33:17"/>ቂብሮት ሀታባዻ ከአኒ ሀጤሮት ቁበተን።<verse eid="NUM 33:17"/></para>
  <para style="pi1">
    <verse number="18" style="v" sid="NUM 33:18"/>ሀጤሮቲ ከአኒ ሪትማ ቁበተን።<verse eid="NUM 33:18"/></para>
  <para style="pi1">
    <verse number="19" style="v" sid="NUM 33:19"/>ሪትማዻ ከአኒ ርሞን ጴሬዝ ቁበተን።<verse eid="NUM 33:19"/></para>
  <para style="pi1">
    <verse number="20" style="v" sid="NUM 33:20"/>ርሞን ጴሬዚ ከአኒ ልብና ቁበተን።<verse eid="NUM 33:20"/></para>
  <para style="pi1">
    <verse number="21" style="v" sid="NUM 33:21"/>ልብናዻ ከአኒ ሪሳ ቁበተን።<verse eid="NUM 33:21"/></para>
  <para style="pi1">
    <verse number="22" style="v" sid="NUM 33:22"/>ሪሳዻ ከአኒ ቄሄላታ ቁበተን።<verse eid="NUM 33:22"/></para>
  <para style="pi1">
    <verse number="23" style="v" sid="NUM 33:23"/>ቄሄላታዻ ከአኒ ጋረ ሻፌር ብረ ቁበተን።<verse eid="NUM 33:23"/></para>
  <para style="pi1">
    <verse number="24" style="v" sid="NUM 33:24"/>ጋረ ሻፌር ብራ ከአኒ ሀራዳ ቁበተን።<verse eid="NUM 33:24"/></para>
  <para style="pi1">
    <verse number="25" style="v" sid="NUM 33:25"/>ሀራዳ ከአኒ መቅሄሎት ቁበተን።<verse eid="NUM 33:25"/></para>
  <para style="pi1">
    <verse number="26" style="v" sid="NUM 33:26"/>መቅሄሎቲ ከአኒ ተሃት ቁበተን።<verse eid="NUM 33:26"/></para>
  <para style="pi1">
    <verse number="27" style="v" sid="NUM 33:27"/>ተሃቲ ከአኒ ታራ ቁበተን።<verse eid="NUM 33:27"/></para>
  <para style="pi1">
    <verse number="28" style="v" sid="NUM 33:28"/>ታራዻ ከአኒ ሚትቃ ቁበተን።<verse eid="NUM 33:28"/></para>
  <para style="pi1">
    <verse number="29" style="v" sid="NUM 33:29"/>ሚትቃዻ ከአኒ ሀሽሞና ቁበተን።<verse eid="NUM 33:29"/></para>
  <para style="pi1">
    <verse number="30" style="v" sid="NUM 33:30"/>ሀሽሞናዻ ከአኒ ሞሴሮት ቁበተን።<verse eid="NUM 33:30"/></para>
  <para style="pi1">
    <verse number="31" style="v" sid="NUM 33:31"/>ሞሴሮቲ ከአኒ ቤኔ ያአካን ቁበተን።<verse eid="NUM 33:31"/></para>
  <para style="pi1">
    <verse number="32" style="v" sid="NUM 33:32"/>ቤኔ ያአካኒ ከአኒ ሆር ሀግድጋድ ቁበተን።<verse eid="NUM 33:32"/></para>
  <para style="pi1">
    <verse number="33" style="v" sid="NUM 33:33"/>ሆር ሀግድጋዲ ከአኒ ዮጥባታ ቁበተን።<verse eid="NUM 33:33"/></para>
  <para style="pi1">
    <verse number="34" style="v" sid="NUM 33:34"/>ዮጥባታዻ ከአኒ አብሮና ቁበተን።<verse eid="NUM 33:34"/></para>
  <para style="pi1">
    <verse number="35" style="v" sid="NUM 33:35"/>አብሮናዻ ከአኒ ኤዝዮን ጌቤር ቁበተን።<verse eid="NUM 33:35"/></para>
  <para style="pi1">
    <verse number="36" style="v" sid="NUM 33:36"/>ኤዝዮን ጌቤሪ ከአኒ ገሞጂ ሲን ኬሰ ቃዴሽ ቁበተን።<verse eid="NUM 33:36"/></para>
  <para style="pi1">
    <verse number="37" style="v" sid="NUM 33:37"/>ቃዴሺ ከአኒ ዳሪ ብየ ኤዶምራ ቱሉ ሆር ብረ ቁበተን። <verse eid="NUM 33:37"/><verse number="38" style="v" sid="NUM 33:38"/>አሮን ሉብችስ አጀጀ <char style="nd">ዋቀዮቲን</char> ቱሉ ሆሪት ኦል በኤ፤ እንስ ኤርገ እስራኤሎን ብየ ግብጢቲ በአኒ ቦዴ ወጋ አፉርተመፋት ጉያ ጀልቀበ ጅአ ሸነፋት አችት ዱኤ። <verse eid="NUM 33:38"/><verse number="39" style="v" sid="NUM 33:39"/>አሮን ዮሙ ቱሉ ሆርረት ዱኤ ሰነ ኡሙሪንሳ ወጋ ዽበ ቶኮፊ ድግደሚ ሰዲ ቱሬ።<verse eid="NUM 33:39"/></para>
  <para style="pi1">
    <verse number="40" style="v" sid="NUM 33:40"/>ሞቲን ኣራድ ነምች ከነኣን ከን ኔጌብ ኬሰ ጅራቻ ቱሬ ሱን አከ ሰብን እስራኤል ዹፋ ጅሩ ዸገኤ።<verse eid="NUM 33:40"/></para>
  <para style="pi1">
    <verse number="41" style="v" sid="NUM 33:41"/>እሳንስ ቱሉ ሆሪቲ ከአኒ ዘልሞና ቁበተን።<verse eid="NUM 33:41"/></para>
  <para style="pi1">
    <verse number="42" style="v" sid="NUM 33:42"/>ዘልሞናዻ ከአኒ ጱኖን ቁበተን።<verse eid="NUM 33:42"/></para>
  <para style="pi1">
    <verse number="43" style="v" sid="NUM 33:43"/>ጱኖኒዻ ከአኒ ኦቦት ቁበተን።<verse eid="NUM 33:43"/></para>
  <para style="pi1">
    <verse number="44" style="v" sid="NUM 33:44"/>ኦቦቲ ከአኒ ዳሪ ሞኣብረ እዬ አባሪም ቁበተን።<verse eid="NUM 33:44"/></para>
  <para style="pi1">
    <verse number="45" style="v" sid="NUM 33:45"/>እዪሚ ከአኒ ዲቦንጋድ ቁበተን።<verse eid="NUM 33:45"/></para>
  <para style="pi1">
    <verse number="46" style="v" sid="NUM 33:46"/>ዲቦንጋዲ ከአኒ አልሞን ዲብላተይም ቁበተን።<verse eid="NUM 33:46"/></para>
  <para style="pi1">
    <verse number="47" style="v" sid="NUM 33:47"/>አልሞን ዲብላተይሚ ከአኒ ኔቦ ቱሉወን አባሪም ብረ ቁበተን።<verse eid="NUM 33:47"/></para>
  <para style="pi1">
    <verse number="48" style="v" sid="NUM 33:48"/>ቱሉወን አባሪሚቲ ከአኒ ድሬወን ሞኣብራ፣ ዮርዳኖስ ብረ፣ ዬርኮ ገመ ቁበተን። <verse eid="NUM 33:48"/><verse number="49" style="v" sid="NUM 33:49"/>እሳንስ ድሬወን ሞኣብ ከን ዮርዳኖስ ጭነ ቤት የሺሞቲ ጀልቀቤ ሀመ አቤል ሽጢሚት ጅሩ ሰነረ ቁበተን።<verse eid="NUM 33:49"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="50" style="v" sid="NUM 33:50"/>
    <char style="nd">ዋቀዮስ</char> ድሬወን ሞኣብረት፣ ዮርዳኖስ ብረት፣ ዬርኮ ገመት ሙሴዻን አከነ ጄዼ፤ <verse eid="NUM 33:50"/><verse number="51" style="v" sid="NUM 33:51"/>“አከነ ጄዺ ሰበ እስራኤልት ዱበዹ፤ ‘እስን ዮሙ ዮርዳኖስ ጬተኒ ከነኣንት ገልተንት፣ <verse eid="NUM 33:51"/><verse number="52" style="v" sid="NUM 33:52"/>ጅራቶተ ብየ ሰና ኦፍ ዱራ አርኣ ባሳ። ፈኪወንሳኒ ከኔን ሶፈመኒ ሆጄተመኒፊ ዋቆተሳኒ ከኔን በቅፈመኒ ቶልፈመን ሁንደ በርበዴሳ፤ ጋረን ሰገዳሳኒ ሁንደስ ዲጋ። <verse eid="NUM 33:52"/><verse number="53" style="v" sid="NUM 33:53"/>ሰበቢ አን ብየቲ ሀንዹራ ጎዼ እስኒ ኬኔፍ፣ ብየቲ ዹንፈዻ ኬሰ ጅራዻ። <verse eid="NUM 33:53"/><verse number="54" style="v" sid="NUM 33:54"/>ብየ ሰነስ ማቲወንኬሰኒፍ ዻለ ጎዻቲ እጣዻን ገርገር ቆዳ፤ ማቲ ባይኤዻፍ ዻለ ጉዳ፣ ማቲ ሙራሳፍሞ ዻለ ጥና ኬና። እዶን እጣዻንሳኒ በኤ ከንሳኒ ተአ። እስንስ አኩመ ጎሶተ አቦቲኬሰኒት ዻላ።<verse eid="NUM 33:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="NUM 33:55"/>“ ‘ገሩ ዮ እስን ወረ ብየ ሰነ ጅራተን አቺ ባሱ ባተን፣ ወር እስን አከ እሳን አች ጅራተኒፍ ዺፍተን ሱን አከ ሁበ እጀ ኬሳቲፊ አከ ቆራቲ ጭናቸ ኬሳ እስንት ተኡ። ብየ እስን ኬሰ ጅራተን ኬሰትስ እስን ረክሱ። <verse eid="NUM 33:55"/><verse number="56" style="v" sid="NUM 33:56"/>አንስ ዋነን እሳን ጎቹ ያዴ ሰነ እስንት ነንፍደ።’ ”<verse eid="NUM 33:56"/></para>
  <chapter eid="NUM 33"/>
  <chapter number="34" style="c" sid="NUM 34"/>
  <para style="s1">ዳንጋወን ከነኣን</para>
  <para style="lh">
    <verse number="1" style="v" sid="NUM 34:1"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ <verse eid="NUM 34:1"/><verse number="2" style="v" sid="NUM 34:2"/>“አከነ ጄዺ እስራኤሎተ አጀጅ፦ ‘ዬሮ እስን ከነኣን ሴንተንት ብይ አከ ዻላት እስኒ ኬነምቱ ሱን ዳንጋወን ከኔን ቀባት፦<verse eid="NUM 34:2"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="3" style="v" sid="NUM 34:3"/>“ ‘ዳንጋንኬሰን ከን ገመ ክባ ገሞጂ ሲን ከን ቀርቀረ ኤዶምረ ጅርቱራ ጀልቀበ፤ ከራ በኣቲን ዳንጋንኬሰን ከን ክባ ዹመ ገላነ ሶግዳራ ጀልቀበ፤ <verse eid="NUM 34:3"/><verse number="4" style="v" sid="NUM 34:4"/>ዳንጋንኬሰን ክበራ ገረ ተበ አቅረቢምት ዴብኤ፣ ገረ ሲንት ጬኤ ሀመ ክበ ቃዴሽ በርኔት ዴመ። ኤርገሲስ ገረ ሀዘር አዳርት እቱመ ፉፌ ገረ አዝሞንት ደርበ። <verse eid="NUM 34:4"/><verse number="5" style="v" sid="NUM 34:5"/>ዳንጋን ሱንስ አዝሞንራ ገረ ለገ ግብጥት ዴብኤ ገላነ ገኤ ዹመ።<verse eid="NUM 34:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="NUM 34:6"/>ዳንጋንኬሰን ከን ገመ ዽኣሞ ቀርቀረ ገላነ ጉድቻት። ኩንስ ገመ ዽኣቲን ዳንጋኬሰን ተአ።<verse eid="NUM 34:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="NUM 34:7"/>ዳሪኬሰን ከን ካባቲፍ ገላነ ጉዳዻ ሀመ ቱሉ ሁርት፣ <verse eid="NUM 34:7"/><verse number="8" style="v" sid="NUM 34:8"/>ቱሉ ሁሪቲ ሀመ ሌቦ ሀማቲት መለቶ ቶልቻ። ዳሪን ሱንስ ሀመ ዜዳድት ዴሜ <verse eid="NUM 34:8"/><verse number="9" style="v" sid="NUM 34:9"/>ሀመ ዚፍሮንት እት ፉፌ ሀዘር ኤናንረት ዹመ። ኩንስ ዳሪኬሰን ከን ካባ ተአ።<verse eid="NUM 34:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="NUM 34:10"/>ዳሪኬሰን ከን በኣቲፍስ ሀዘር ኤናኒ ጀልቀባቲ ሀመ ሼፋማት መለቶ ቶልቻ። <verse eid="NUM 34:10"/><verse number="11" style="v" sid="NUM 34:11"/>ዳሪን ሱንስ ሼፋማ ጀልቀቤ ከራ በአ ኣይኒቲን ሀመ ሪብላት ገድ ቡአ፤ እት ፉፌስ ሀመ ኤዴደ ገመ በኣ ገላነ ክኔሬትት አርገሙት ዴመ። <verse eid="NUM 34:11"/><verse number="12" style="v" sid="NUM 34:12"/>ዳሪን ኩንስ ዮርዳኖስት ገድ ቡኤ ገላነ ሶግዳ ገኤ ዻበተ።</para>
  <para style="b" vid="NUM 34:12"/>
  <para style="lf" vid="NUM 34:12">“ ‘ኤጋ ብይ ገመ ሁንዳን ዳሪ ቀቡ ኩንኬሰን ተአ።’ ”<verse eid="NUM 34:12"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="13" style="v" sid="NUM 34:13"/>ሙሴን አከነ ጄዼ እስራኤሎተ አጀጄ፦ “ብየ ከነ ዻለ ጎዸዻቲ እጣዻን ቆደዻ፤ <char style="nd">ዋቀዮ</char> አከ ብይ ኩን ጎሰ ሰገሊፊ ወለካዻፍ ኬነሙ አጀጄረ፤ <verse eid="NUM 34:13"/><verse number="14" style="v" sid="NUM 34:14"/>ማቲወን ጎሰ ሩቤን፣ ከን ጎሰ ጋዲፊ ወለካን ጎሰ ምናሴ ዻለ ኦፊ ፉዸተኒሩቲ። <verse eid="NUM 34:14"/><verse number="15" style="v" sid="NUM 34:15"/>ጎሶትን ለማኒፊ ወለካን ጎሰ ቶኮ ዮርዳኖስ ገማ፣ ፉሌ ዬርኮቲ ገረ በአ ቢፍቱት ከራ በኣቲን ዻለሳኒ አርገተኒሩ።”<verse eid="NUM 34:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 34:16"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ <verse eid="NUM 34:16"/><verse number="17" style="v" sid="NUM 34:17"/>“መቃን ነሞተ አከ ዻላት ለፈ ከነ እስኒ ቆደኒስ ኤሌኣዛር ሉብቻፊ እያሱ እልመ ኑኒት። <verse eid="NUM 34:17"/><verse number="18" style="v" sid="NUM 34:18"/>እስንስ አከ እሳን ለፈ ዻላ ቆደኒፍ ቶኮ ቶኮ ጎሳ ኬሳ ሆገና ቶኮ ፍለዻ።<verse eid="NUM 34:18"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="19" style="v" sid="NUM 34:19"/>“መቃንሳኒስ ከኔኒዸ፦</para>
  <para style="b" vid="NUM 34:19"/>
  <para style="li1" vid="NUM 34:19">“ጎሰ ይሁዳ ኬሳ፣ ካሌብ እልመ ዬፉኔ፤<verse eid="NUM 34:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="NUM 34:20"/>ጎሰ ስምኦን ኬሳ፣ ሼሙኤል እልመ አሚሁድ፤<verse eid="NUM 34:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="NUM 34:21"/>ጎሰ ቤንያም ኬሳ፣ ኤሊዳድ እልመ ክስሎን፤<verse eid="NUM 34:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="NUM 34:22"/>ጎሰ ዳን ኬሳ ሆገናን፣ ቡኪ እልመ ዮግሊ፤<verse eid="NUM 34:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="NUM 34:23"/>ጎሰ ምናሴ እልመ ዮሴፍ ኬሳ ሆገናን፣ ሀኒኤል እልመ ኤፎድ፤<verse eid="NUM 34:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="NUM 34:24"/>ጎሰ ኤፍሬም እልመ ዮሴፍ ኬሳ ሆገናን፣ ቀሙኤል እልመ ሺፍጣን፤<verse eid="NUM 34:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="NUM 34:25"/>ጎሰ ዜቡሎን ኬሳ ሆገናን፣ ኤሊሳፋን እልመ ጳርናክ፤<verse eid="NUM 34:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="NUM 34:26"/>ጎሰ ይሳኮር ኬሳ ሆገናን፣ ጳልቲኤል እልመ አዛን፤<verse eid="NUM 34:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="NUM 34:27"/>ጎሰ ኣሼር ኬሳ ሆገናን፣ አሂሁድ እልመ ሼሎሚ፤<verse eid="NUM 34:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="NUM 34:28"/>ጎሰ ንፍታሌም ኬሳ ሆገናን፣ ጴዳኤል እልመ አሚሁድ።”<verse eid="NUM 34:28"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="29" style="v" sid="NUM 34:29"/>ነሞትን ኩኔን ወረ <char style="nd">ዋቀዮ</char> አከ እሳን ብየ ከነኣን ኬሰት እስራኤሎታፍ ዻለ ህረኒፍ እሳን አጀጄዸ።<verse eid="NUM 34:29"/></para>
  <chapter eid="NUM 34"/>
  <chapter number="35" style="c" sid="NUM 35"/>
  <para style="s1">መጋላወን ሌዎታፍ ኬነመን</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 35:1"/>
    <char style="nd">ዋቀዮስ</char> ድሬወን ሞኣብረት፣ ዮርዳኖስ ብረት፣ ዬርኮ ገመት ሙሴዻን አከነ ጄዼ፤ <verse eid="NUM 35:1"/><verse number="2" style="v" sid="NUM 35:2"/>“እስራኤሎን ዻለ ኦፊሳኒቲ አርገቹፍ ጅረን ኬሳ መጋላወን ሌዎትን ኬሰ ጅራተን አከሳኒ ኬነን እስራኤሎተ አጀጅ። ለፈ ሆሪ እት ቦባፈተንስ ናኖ መጋላወኒት ሃኬነኒፍ። <verse eid="NUM 35:2"/><verse number="3" style="v" sid="NUM 35:3"/>እሳንስ መጋላወን ኬሰ ጅራተኒፊ ለፈ እት ሎንሳኒቲፊ ሆሪሳኒ ካን ሁንደ ቦባፈተን ንቀባቱ።<verse eid="NUM 35:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 35:4"/>“ለፍት ሆሪን እት ቦበኡ ከን እስን ናኖ መጋላወኒት ሌዎታፍ ኬንተን ሱን ደላ መጋላራ ጀልቀቤ ገመ ሁንዳን ዹንዹመ ኩመ ቶኮ አች በልአተ። <verse eid="NUM 35:4"/><verse number="5" style="v" sid="NUM 35:5"/>መጋላ ሰነ ግዱት ሀምብሱዻን ከራ አላቲን ገመ በኣቲን ዹንዹመ ኩመ ለመ፣ ገመ ክባቲን ዹንዹመ ኩመ ለመ፣ ገመ ዽኣቲን ዹንዹመ ኩመ ለመ፣ ገመ ካባቲንሞ ዹንዹመ ኩመ ለመ ሰፈራ። እዶወን ኩኔን መጋላወን ሰናፍ እዶወን እት ሆሪ ቦባፈተን ተኡ።<verse eid="NUM 35:5"/></para>
  <para style="s1">መጋላወን እት በቀተን</para>
  <para style="r">
    <ref loc="NUM 35:6-34">35፥6‑34</ref> ኩወእ – <char style="xt"><ref loc="DEU 4:41-43">ኬዴ 4፥41‑43</ref>፤ <ref loc="DEU 19:1-14">19፥1‑14</ref>፤ <ref loc="JOS 20:1-9">እያ 20፥1‑9</ref></char></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 35:6"/>“መጋላወን ጀአን እስን ሌዎታፍ ኬንተን መጋላወን እት በቀተን ከኔን ነምን ነመ አጄሴ እት በቀቱ ተኡ። መጋላወን አፉርተሚ ለመስ ከነት ደበላቲ እሳኒ ኬና። <verse eid="NUM 35:6"/><verse number="7" style="v" sid="NUM 35:7"/>ወሉማ ገለት መጋላወን አፉርተሚ ሰዴት ከኔን ለፈ ትከ ኦፊሳኒ ቀበን ሌዎታፍ ኬና። <verse eid="NUM 35:7"/><verse number="8" style="v" sid="NUM 35:8"/>መጋላወን እስን ለፈ እስራኤሎን ዻለንራ ሌዎታፍ ኬንተን፣ አኩመ ቆደ ዻለ ቶኮ ቶኮ ጎሳት ሃተኡ፤ ጎሰ ዻለ ባይኤ ቀቡራ መጋላወን ባይኤ፣ ጎሰ ዻለ ሙራሰ ቀቡራሞ መጋላወን ጥኖ ፉዻ።”<verse eid="NUM 35:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 35:9"/>
    <char style="nd">ዋቀዮስ</char> ሙሴዻን አከነ ጄዼ፦ <verse eid="NUM 35:9"/><verse number="10" style="v" sid="NUM 35:10"/>“እስራኤሎተት ዱበዹ፤ አከነስ ጄዺን፦ ‘እስን ዮሙ ዮርዳኖስን ጬተኒ ከነኣንት ገልተንት፣ <verse eid="NUM 35:10"/><verse number="11" style="v" sid="NUM 35:11"/>አከ እስን መጋላወን እት በቀተን ከኔን ነምን ተሰ ነመ አጄሴ እት በቀቱ እስኒ ተአኒፍ መጋላወን ፍለዻ። <verse eid="NUM 35:11"/><verse number="12" style="v" sid="NUM 35:12"/>መጋላወን ኩኔንስ አከ ነምን ነመ አጄሱዻን ህመተሜ ኡቱ ሙርቲ አርገቹፍ ወልዳ ዱረት ህንዽኣትን ህንዱኔፍ እዶ እን እት ነመ ሃሎ እሰ በኡ ጀላ በቀቱ ተኡ። <verse eid="NUM 35:12"/><verse number="13" style="v" sid="NUM 35:13"/>መጋላወን እስን ኬንተን ጀአን ኩኔንስ መጋላወን እት በቀተን እስኒ ተኡ። <verse eid="NUM 35:13"/><verse number="14" style="v" sid="NUM 35:14"/>ዮርዳኖስ ገመናን መጋላወን ሰዲ፣ ከነኣን ኬሳሞ መጋላወን ሰዲ፣ መጋላወን እት በቀተን ጎዻ ኬና። <verse eid="NUM 35:14"/><verse number="15" style="v" sid="NUM 35:15"/>መጋላወን ጀአን ኩኔን አከ ነምን ተሰ ነመ አጄሴ ከምዩ እት በቀቱፍ እስራኤሎታፍ፣ አለጎታፊ ሰበ እሳን ግዱ ጅራቱፍ እዶ እት በቀተን ተኡ።<verse eid="NUM 35:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 35:16"/>“ ‘ነምን ቶኮ ዮ ሜሻ ስቢላቲን ነመ ዸኤ ነምች ሱን ዱኤ፣ እን አጄሴ ሱን ነመ ጉማት፤ ነምች አጄሴ ሱን አጄፈሙ ቀበ። <verse eid="NUM 35:16"/><verse number="17" style="v" sid="NUM 35:17"/>ዮካን ነምን ቶኮ ዮ ዸጋ ነመ አጄሱ ደንደኡ ሀርከት ቀበቴ ነመ ዸኤ አጄሴ፣ እን ነመ ጉማት፤ ነምች ነመ አጄሴ ሱን አጄፈሙ ቀበ። <verse eid="NUM 35:17"/><verse number="18" style="v" sid="NUM 35:18"/>ዮካን ነምን ቶኮ ዮ ሜሻ ሙካ ከን ነመ አጄሱ ደንደኡ ሀርከት ቀበቴ ነመ ዸኤ ነምች ሱን ዱኤ፣ እን አጄሴ ሱን ነመ ጉማት፤ ነምች ነመ አጄሴ ሱን አጄፈሙ ቀበ። <verse eid="NUM 35:18"/><verse number="19" style="v" sid="NUM 35:19"/>ነምች ሃሎ ዺጋ በኡ ሱን ነምቸ ነመ አጄሴ ሰነ ሃአጄሱ፤ እን ዮሙ አርገቱት እሰ ሃአጄሱ። <verse eid="NUM 35:19"/><verse number="20" style="v" sid="NUM 35:20"/>ነምን ቶኮ ዮ ጅባን ነመ ደርበቴ ለፋን ዸኤ ዮካን ቤካ ዋ እት ደርበቹዻን እሰ አጄሴ፣ <verse eid="NUM 35:20"/><verse number="21" style="v" sid="NUM 35:21"/>ዮካን ዮ ዲኑማዻን ከኤ ሀርካን እሰ ዸኤ ነምች ሱን ዱኤ፣ እን ነመ አጄሴ ሱን አጄፈሙ ቀበ፤ እን ነመ ጉማት። ነምች ሃሎ ዺጋ በኡ ሱን ነምቸ ነመ አጄሴ ሰነ ዬሮ አርገቱት እሰ ሃአጄሱ።<verse eid="NUM 35:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 35:22"/>“ ‘ገሩ እን ዮ ኡቱ ዲኑማ ህንቀባትን ተሰ ነመ ደርበቴ ለፋን ዸኤ ዮካን ኡቱ ህንቤክን ዋን ቶኮ እሰት ደርበቴ <verse eid="NUM 35:22"/><verse number="23" style="v" sid="NUM 35:23"/>ዮካን ኡቱ እሰ ህንአርግን ዸጋ እሰ አጄሱ ደንደኡ እት ገድ ዺሴ ነምች ሱን ዱኤ፣ እን ዋን ዲነሳ ህንተእኒፊ እሰ ሚዹፍ ህንያድኒፍ <verse eid="NUM 35:23"/><verse number="24" style="v" sid="NUM 35:24"/>ወልዳን ሱን አኩመ ሴረ ከኔኒት ነምቸ ነመ አጄሴ ሰናፊ እሰ ሃሎ ዺጋ በኡ ሰነ ግዱት ሙርቲ ሃኬኑ። <verse eid="NUM 35:24"/><verse number="25" style="v" sid="NUM 35:25"/>ወልዳን ሱን ነምቸ ነመ አጄሱዻን ህመተሜ ሰነ ሀርከ ነምቸ ሃሎ ዺጋ በኡ ሰና ጀላ ባሴ መጋላ እን እት በቀቴ ቱሬ ሰነት ዴብሴ እሰ ሃኤርጉ። እንስ ሀመ ሉብን ኦል ኣናን ዘይቲ ቁልቁሉዻን ድበሜ ሱን ዱኡት አቹመ ሃቱሩ።<verse eid="NUM 35:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 35:26"/>“ ‘ተኡስ ዮ ነምች ነመ አጄሴ ሱን ዳሪ መጋላ እት በቀቴ ሰና ኬሳ በኤ <verse eid="NUM 35:26"/><verse number="27" style="v" sid="NUM 35:27"/>ነምች ሃሎ ዺጋ በኡ ሱን መጋላ ሰናን አለት እሰ አርገቴ፣ ነምች ሃሎ ዺጋ በኡ ሱን ነምቸ ህመተሜ ሰነ አጄሱ ደንደአ፤ የከ አጄቻ ሰናትስ ህንጋፈተሙ። <verse eid="NUM 35:27"/><verse number="28" style="v" sid="NUM 35:28"/>ነምች ነመ አጄሴ ሱን ሀመ ሉብን ኦል ኣናን ሱን ዱኡት መጋላ እት በቀቴ ኬሰ ቱሩ ቀበ፤ እን ኤርገ ሉብች ኦል ኣናን ዱኤ ቦዴ ገረ ቀቤኘሳት ዴብኡ ደንደአ።<verse eid="NUM 35:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 35:29"/>“ ‘እሳን ኩኔንስ ዸሎተ ዹፉ ኬሰት ለፈ እስን ጅራተን ከምትዩ ሴራፊ ቀጄልፈመ እስኒፍ ሃተአን።<verse eid="NUM 35:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 35:30"/>“ ‘ነምን ከምዩ ዮ ነመ አጄሴ ነምች ሱን ረጋ ዹጋ ባቶትን ኬነኒን አጄፈመ። ተኡስ ነምን ከምዩ ዹገ በኡምሰ ነመ ቶኮ ቆፋን ህንአጄፈምን።<verse eid="NUM 35:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 35:31"/>“ ‘ነምቸ ነመ አጄሴ ዱት እሳፍ መሉ ቶኮራ ጉማ ሉቡ ህንፉዸትና። እን አጄፈሙ ቀበ።<verse eid="NUM 35:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 35:32"/>“ ‘አከ እን ኡቱ ሉብች ኦል ኣናን ህንዱእን ዱረ ብየ ኦፊሳት ዴብኤ አች ጅራቱ ኤየሙፍ ጄተኒ ነመ ገረ መጋላ እት በቀተኒት በቀቴ ከሚፍዩ ጉማ ህንፉዸትና።<verse eid="NUM 35:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 35:33"/>“ ‘ሰበቢ ዸንገላፈሙን ዺጋ ብየ ጡሬሱፍ፣ እስን ብየ ኬሰ ጅራተን ሰነ ህንጡሬስና፤ ዺጉመ ነምቸ ዺገ ዸንገላሴ ሰናቲን መሌስ ብየ ዺግን እት ዸንገላፈሜ ሰናፍ አራር ህንቡፈሙ። <verse eid="NUM 35:33"/><verse number="34" style="v" sid="NUM 35:34"/>ብየ እስን ኬሰ ጅርተን እዶ አን ጅራዹ ሰነ ህንጡሬስና። አን <char style="nd">ዋቀዮ</char> እስራኤሎተ ግዱ ነንጅራዻቲ።’ ”<verse eid="NUM 35:34"/></para>
  <chapter eid="NUM 35"/>
  <chapter number="36" style="c" sid="NUM 36"/>
  <para style="s1">ዻለ እንተለን ዜሎፌሃድ</para>
  <para style="r">
    <ref loc="NUM 36:1-12">36፥1‑12</ref> ኩወፈ – <char style="xt"><ref loc="NUM 27:1-11">ለኮ 27፥1‑11</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 36:1"/>አቦቲን ማቲ እልማን ግልኣድ እልመ ማኪር፣ እልመ ምናሴ ከኔን ማቲወን እልማን ዮሴፍ ኬሳ ዹፈን ሱን ፉለ ሙሴቲፊ ፉለ ሆገንቶተ አቦቲ ማቲወን ሰበ እስራኤል ዱረት ዽኣተኒ ዱበተን፤ <verse eid="NUM 36:1"/><verse number="2" style="v" sid="NUM 36:2"/>አከነስ ጄዸን፤ “አከ አት ብየቲ ዻለ ጎቴ እጣዻን ሰበ እስራኤሊፍ ኬንቱፍ <char style="nd">ዋቀዮ</char> ጎፍታኮ አጀጄረ፤ አከሱመስ አከ አት ዻለ ኦቦሌስኬኘ ዜሎፌሃድ እንተለንሳቲፍ ኬንቱ እን ስ አጀጄረ። <verse eid="NUM 36:2"/><verse number="3" style="v" sid="NUM 36:3"/>ገሩ ዮ እሳን እልማን ጎሶተ ሰበ እስራኤል ካንት ሄሩመን ዻልሳኒ ዻለ አቦቲኬኛ ኬሳ ፉዸሜ ዻለ ጎሰ እሳን እት ሄሩመኒት ደበለመ። ዮስ ዻለ እጣዻን ኑ ቆደሜራ ገሪንሳ ንፉዸመ። <verse eid="NUM 36:3"/><verse number="4" style="v" sid="NUM 36:4"/>ዮሙ ወጋን እዮቤልዩ ከን ሰበ እስራኤል ዹፉት ዻልሳኒ ሱን ዻለ ጎሰ እሳን እት ሄሩመኒት ደበለመ፤ ዻልሳኒስ ዻለ ጎሰ አቦቲኬኛራ ፉዸተመ።”<verse eid="NUM 36:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 36:5"/>ከነረት ሙሴን አኩመ <char style="nd">ዋቀዮ</char> ዱበቴ ሰነ አከነ ጄዼ ሰበ እስራኤል አጀጄ፦ “ወን ጎስት እልማን ዮሴፍ ጄዹ ስሪዸ። <verse eid="NUM 36:5"/><verse number="6" style="v" sid="NUM 36:6"/>ወን <char style="nd">ዋቀዮ</char> ዋኤ እንተለን ዜሎፌሃድ አጀጄ ከናዸ፦ እሳን ጎሰ አባሳኒ ቆፈ ኬሳ ሃተኡ መሌ ነመ ጃለተንት ሃሄሩመን። <verse eid="NUM 36:6"/><verse number="7" style="v" sid="NUM 36:7"/>ሰበቢ ቶኮን ቶኮን እልማን እስራኤል ዻለ ጎሰ አባሳራ አርገቱ ጀቤሴ ቀበቱፍ፣ ዻል እልማን እስራኤል ጎሰ ቶኮራ ጎሰ ካንት ህንደርብን። <verse eid="NUM 36:7"/><verse number="8" style="v" sid="NUM 36:8"/>አከ ቶኮን ቶኮን እልማን እስራኤል ዻለ አቦቲሳ አርገቱፍ፣ ጎሰ እልማን እስራኤል ኬሳ እንተል ዻለ አርገቱ ከምዩ ጎሰ አባሼ ኬሳ ነመ ቶኮት ሄሩሙ ቀብድ። <verse eid="NUM 36:8"/><verse number="9" style="v" sid="NUM 36:9"/>ሰበቢ ቶኮን ቶኮን ጎሰ እልማን እስራኤል ዻለ ኦፊሳ ጀቤሴ ቀበቱፍ፣ ዻል ቶኮዩ ጎሰ ቶኮራ ጎሰ ካንት ህንደርብን።”<verse eid="NUM 36:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 36:10"/>እንተለን ዜሎፌሃድ አኩመ <char style="nd">ዋቀዮ</char> ሙሴ አጀጄ ሰነ ጎዸን። <verse eid="NUM 36:10"/><verse number="11" style="v" sid="NUM 36:11"/>እንተለን ዜሎፌሃድ መህላን፣ ቲርዛን፣ ሆግላን፣ ሚልካፊ ኖህ እልማን ኦቦሎተ አባሳኒት ሄሩመን። <verse eid="NUM 36:11"/><verse number="12" style="v" sid="NUM 36:12"/>እሳንስ ማቲወን እልማን ምናሴ እልመ ዮሴፍ ኬሰት ዋን ሄሩመኒፍ ዻልሳኒ ጎሰ ማቲ አባሳኒ ሀርከት ሀፌ።<verse eid="NUM 36:12"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="13" style="v" sid="NUM 36:13"/>አጀጀወኒፊ ሙርቲወን <char style="nd">ዋቀዮ</char> ድሬወን ሞኣብረት፣ ዮርዳኖስ ብረት፣ ዬርኮ ገመት ከራ ሙሴቲን እልማን እስራኤሊፍ ኬኔ ከኔኒዸ።<verse eid="NUM 36:13"/></para>
  <chapter eid="NUM 36"/>
</usx>
