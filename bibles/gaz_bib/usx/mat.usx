<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">ማቴዎስ</para>
  <para style="toc1">ወንጌለ ማቴዎስ</para>
  <para style="toc2">ማቴዎስ</para>
  <para style="toc3">ማቴ</para>
  <para style="mt2">ወንጌለ</para>
  <para style="mt1">ማቴዎስ</para>
  <chapter number="1" style="c" sid="MAT 1"/>
  <para style="s1">ህደ ዸሎተ ዬሱስ ክርስቶስ</para>
  <para style="r">
    <ref loc="MAT 1:1-17">1፥1‑17</ref> ኩወፈ – <char style="xt"><ref loc="LUK 3:23-38">ሉቃ 3፥23‑38</ref></char></para>
  <para style="r">
    <ref loc="MAT 1:3-6">1፥3‑6</ref> ኩወፈ – <char style="xt"><ref loc="RUT 4:18-22">ሩት 4፥18‑22</ref></char></para>
  <para style="r">
    <ref loc="MAT 1:7-11">1፥7‑11</ref> ኩወፈ – <char style="xt"><ref loc="1CH 3:10-17">1ሴና 3፥10‑17</ref></char></para>
  <para style="lh">
    <verse number="1" style="v" sid="MAT 1:1"/>ህድ ዸሎተ ዬሱስ ክርስቶስ እሰ ሰኚ ዳዊት፣ ሰኚ አብረሃም ተኤ ሰና ከናዸ፦<verse eid="MAT 1:1"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="2" style="v" sid="MAT 1:2"/>አብረሃም ይስሃቅን ዸልቼ፤</para>
  <para style="li1" vid="MAT 1:2">ይስሃቅ ያቆብን ዸልቼ፤</para>
  <para style="li1" vid="MAT 1:2">ያቆብ ይሁዳፊ ኦቦሎተሳ ዸልቼ፤<verse eid="MAT 1:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="MAT 1:3"/>ይሁዳን ታማርራ ፋሬሲፊ ዜራ ዸልቼ፤</para>
  <para style="li1" vid="MAT 1:3">ፋሬስ ሄዝሮንን ዸልቼ፤</para>
  <para style="li1" vid="MAT 1:3">ሄዝሮን አራምን ዸልቼ፤<verse eid="MAT 1:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="MAT 1:4"/>አራም አሚናዳብን ዸልቼ፤</para>
  <para style="li1" vid="MAT 1:4">አሚናዳብ ነህሾንን ዸልቼ፤</para>
  <para style="li1" vid="MAT 1:4">ነህሾን ሰልሞንን ዸልቼ፤<verse eid="MAT 1:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="MAT 1:5"/>ሰልሞን ረሃብራ ቦኤዝን ዸልቼ፤</para>
  <para style="li1" vid="MAT 1:5">ቦኤዝ ሩትራ ዮቤድን ዸልቼ፤</para>
  <para style="li1" vid="MAT 1:5">ዮቤድ እሴይን ዸልቼ፤<verse eid="MAT 1:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="MAT 1:6"/>እሴይ ዳዊት ሞትቸ ዸልቼ።</para>
  <para style="b" vid="MAT 1:6"/>
  <para style="li1" vid="MAT 1:6">ዳዊት ኒቲ ኡርያራ ሶሎሞንን ዸልቼ።<verse eid="MAT 1:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="MAT 1:7"/>ሶሎሞን ሬሆቦኣምን ዸልቼ፤</para>
  <para style="li1" vid="MAT 1:7">ሬሆቦኣም አብያ ዸልቼ፤</para>
  <para style="li1" vid="MAT 1:7">አብያን አሳፍን ዸልቼ፤<verse eid="MAT 1:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="MAT 1:8"/>አሳፍ ዬሆሻፋጥን ዸልቼ፤</para>
  <para style="li1" vid="MAT 1:8">ዬሆሻፋጥ ዬሆራምን ዸልቼ፤</para>
  <para style="li1" vid="MAT 1:8">ዬሆራም ኦዝያን ዸልቼ፤<verse eid="MAT 1:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="MAT 1:9"/>ኦዝያን ዮታምን ዸልቼ፤</para>
  <para style="li1" vid="MAT 1:9">ዮታም አካዝን ዸልቼ፤</para>
  <para style="li1" vid="MAT 1:9">አካዝ ህዝቅያስን ዸልቼ፤<verse eid="MAT 1:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="MAT 1:10"/>ህዝቅያስ ምናሴ ዸልቼ፤</para>
  <para style="li1" vid="MAT 1:10">ምናሴን አሞንን ዸልቼ፤</para>
  <para style="li1" vid="MAT 1:10">አሞን ዮስያስን ዸልቼ፤<verse eid="MAT 1:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="MAT 1:11"/>ዮስያስ በረ ቦጁ ባብሎን ኬሰ፣ ዬኮንያኒፊ ኦቦሎተሳ ዸልቼ።<verse eid="MAT 1:11"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="12" style="v" sid="MAT 1:12"/>ቦጁ ባብሎን ቦዴ፣</para>
  <para style="li1" vid="MAT 1:12">ዬኮንያን ሰላትያልን ዸልቼ፤</para>
  <para style="li1" vid="MAT 1:12">ሰላትያል ዘሩባቤልን ዸልቼ፤<verse eid="MAT 1:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="MAT 1:13"/>ዘሩባቤል አብዩድን ዸልቼ፤</para>
  <para style="li1" vid="MAT 1:13">አብዩድ ኤልያቄምን ዸልቼ፤</para>
  <para style="li1" vid="MAT 1:13">ኤሊያቄም አዞርን ዸልቼ፤<verse eid="MAT 1:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="MAT 1:14"/>አዞር ዛዶቅን ዸልቼ፤</para>
  <para style="li1" vid="MAT 1:14">ዛዶቅ አኪምን ዸልቼ፤</para>
  <para style="li1" vid="MAT 1:14">አኪም ኤልዩድን ዸልቼ፤<verse eid="MAT 1:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="MAT 1:15"/>ኤልዩድ ኤሌኣዛርን ዸልቼ፤</para>
  <para style="li1" vid="MAT 1:15">ኤሌኣዛር ማታንን ዸልቼ፤</para>
  <para style="li1" vid="MAT 1:15">ማታን ያቆብን ዸልቼ፤<verse eid="MAT 1:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="MAT 1:16"/>ያቆብ ዮሴፍን ዸልቼ፤ ዮሴፍ ኩንስ ዽርሰ ማርያም እሼ ዬሱስ እሰ ክርስቶስ ጄዸሙ ዴሴ ሰናት።<verse eid="MAT 1:16"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="17" style="v" sid="MAT 1:17"/>ኤጋ ወሉመት አብረሃሚ ሀመ ዳዊትት ዸሎተ ኩዸ አፉር፣ ዳዊቲ ሀመ ቦጁ ባብሎንት ዸሎተ ኩዸ አፉር፣ ቦጁ ባብሎኒ ሀመ ክርስቶስት ዸሎተ ኩዸ አፉርቱ ቱሬ።<verse eid="MAT 1:17"/></para>
  <para style="s1">ዸለቹ ዬሱስ ክርስቶስ</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18"/>ዸለቹን ዬሱስ ክርስቶስ አከነ ቱሬ፦ ሃትሳ ማርያም ካዽመ ዮሴፍ ቱርቴ፤ እሼንስ ኡቱ ዮሴፍ ወጅን ወል ብረ ህንገእን ሀፉረ ቁልቁሉዻን ኡልፎፍቴ አርገምቴ። <verse eid="MAT 1:18"/><verse number="19" style="v" sid="MAT 1:19"/>ዮሴፍ ካዽምንሼ ሱንስ ነመ ቀጄላ ዋን ቱሬፍ፣ ዾክሳዻን እሼ ዺሱ ሙርቴሴ መሌ ኡመተ ዱረት እሼ ቃኔሱ ህንበርባድኔ።<verse eid="MAT 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 1:20"/>ኡቱ እን ዋን ከነ ያዳ ጅሩ፣ ኤርገማን ጎፍታ አብጁ ኬሰ እት ሙልአቴ አከነ ጄዼን፤ “ያ ዮሴፍ እልመ ዳዊት፣ ካዽምንኬ ማርያም ሀፉረ ቁልቁሉዻን ዋን ኡልፎፍቴፍ እሼ ፉዹ ህንሶዳትን። <verse eid="MAT 1:20"/><verse number="21" style="v" sid="MAT 1:21"/>እሼን እልመ ዴስ፤ አትስ መቃሳ ዬሱስ ጄቴ ንሞጋፍተ፤ እን ሰበሳ ጩቡሳኒራ ንፈይሳቲ።”<verse eid="MAT 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22"/>ኩን ሁንድኑ አከ ወን ጎፍታን ከራ ራጅቻቲን ዱበቴ ሱን ራወተሙፍ ተኤ። <verse eid="MAT 1:22"/><verse number="23" style="v" sid="MAT 1:23"/>እንስ፣ “ኩኖ፣ ዱርብ ቶኮ ንኡልፎፍት፤ እልመ ንዴስ፤ መቃሳስ አማኑኤል ጄዹ”<note caller="+" style="f"><char style="fr" closed="false">1፥23 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 7:14">እሳ 7፥14</ref></char></char></note> ጄዸ። አማኑኤል ጄቹንስ፣ “ዋቅን ኑ ወጅን ጅረ” ጄቹዸ።<verse eid="MAT 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24"/>ዮሴፍስ ህርባ ደመቄ አኩመ ኤርገማን ጎፍታ እሰ አጀጄት ማርያምን ኒቱማዻን መነሳት ፉዸቴ። <verse eid="MAT 1:24"/><verse number="25" style="v" sid="MAT 1:25"/>ገሩ እን ሀመ እሼን እልመ ዴሱት እሼ ብረ ህንጌኜ። መቃሳስ፣ “ዬሱስ” ጄዼ ሞጋሴ።<verse eid="MAT 1:25"/></para>
  <chapter eid="MAT 1"/>
  <chapter number="2" style="c" sid="MAT 2"/>
  <para style="s1">ቤክቶትን ክርስቶስን ዳወተን</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1"/>በረ ሄሮድስ ሞትቻ ኬሰ፣ ኤርገ ዬሱስ መጋላ ቤትልሄም ይሁዳት አርገምቱ ኬሰት ዸለቴ ቦዴ፣ ቤክቶትን በአ ቢፍቱቲ ገረ ዬሩሳሌም ዹፈን፤ <verse eid="MAT 2:1"/><verse number="2" style="v" sid="MAT 2:2"/>እሳንስ፣ “ሞቲን ይሁዶታ እን ዸለቴ ሱን ኤሰ ጅረ? ኑ ኡርጂሳ በአ ቢፍቱት አርግኔ እሳፍ ሰገዱ ዹፍኔረ” ጄዸኒ ጋፈተን።<verse eid="MAT 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3"/>ሄሮድስ ሞትች ዮሙ ዋን ከነ ዸገኤት ንጄቀሜ፤ ዬሩሳሌምስ ጉቱማት እሰ ወጅን ጄቀምቴ። <verse eid="MAT 2:3"/><verse number="4" style="v" sid="MAT 2:4"/>እንስ ሉቦተ ሀንገፎታፊ በርሲስቶተ ሴራ ሁንደ ሰበ ኬሳ ወልት ቀቤ፣ ክርስቶስ ኤሰት አከ ዸለቱ እሳን ጋፈቴ። <verse eid="MAT 2:4"/><verse number="5-6" style="v" sid="MAT 2:5-6"/>እሳንስ አከነ ጄዸኒ ዴብሰኒፍ፤ “ቤትልሄም ይሁዳት ዸለተ፤ ኩንስ ዱቢ ራጅች፣</para>
  <para style="q1" vid="MAT 2:5-6">“ ‘ያ ቤትልሄም እሼ ብየ ይሁዳ፣</para>
  <para style="q2" vid="MAT 2:5-6">አት ጎንኩማ ቡልችቶተ ይሁዳቲ ገድ ምት፤</para>
  <para style="q1" vid="MAT 2:5-6">ቡልቻን ሰበኮ እስራኤልን ትክሱ</para>
  <para style="q2" vid="MAT 2:5-6">ስ ኬሳ ንበኣቲ’<note caller="+" style="f"><char style="fr" closed="false">2፥5‑6 </char><char style="ft" closed="false"><char style="xt"><ref loc="MIC 5:2">ሚክ 5፥2</ref>፣<ref loc="MIC 5:4">4</ref></char></char></note></para>
  <para style="m" vid="MAT 2:5-6">ጄዼ በሬሴ ሰናዸ።”<verse eid="MAT 2:5-6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7"/>ኤርገሲ ሄሮድስ ቤክቶተ ሰነ ዾክሳት ዋሜ ዬሮ እት ኡርጂን ሱን ሙልአቴ እሳንራ ሁበቴ። <verse eid="MAT 2:7"/><verse number="8" style="v" sid="MAT 2:8"/>እንስ፣ “ዸቃቲ ጀቤሳ ሙጭቸ በርባዳ። ዬሮ አርግተንትሞ አከ አንስ ዹፌ እሳፍ ሰገዱፍ ነት ህማ” ጄዼ ቤትልሄምት እሳን ኤርጌ።<verse eid="MAT 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9"/>እሳንስ ኤርገ ዋን ሞትች ጄዼ ሰነ ዸገአኒ ቦዴ ከራሳኒ እት ፉፈን፤ ኡርጂን እሳን በአ ቢፍቱት አርገን ሱንስ ሀመ እዶ ሙጭች ቱሬ ገኤ ዻበቱት እሳን ዱረ ዴሜ። <verse eid="MAT 2:9"/><verse number="10" style="v" sid="MAT 2:10"/>እሳንስ ዬሮ ኡርጂ ሰነ አርገንት አከ መሌ ገመደን። <verse eid="MAT 2:10"/><verse number="11" style="v" sid="MAT 2:11"/>አኩመ መነ ኦል ሴነኒንስ ሙጭቸ፣ ሃዸሳ ማርያም ወጅን አርገን፤ ኩፈኒስ ሰገደኒፍ። ቆርጢሳኒስ በነኒ ኬና ወርቄ፣ እጣናፊ ቁምቢ ዽኤሰኒፍ። <verse eid="MAT 2:11"/><verse number="12" style="v" sid="MAT 2:12"/>ቤክቶትንስ አከ ገረ ሄሮድስት ህንዴብኔፍ ዋን አብጁዻን ኦፍ ኤገቺስን እሳኒፍ ኬነሜፍ ከራ ብራቲን ብየሳኒት ዴብአን።<verse eid="MAT 2:12"/></para>
  <para style="s1">ግብጥት በቀቹሳኒ</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13"/>ዮሙ ቤክቶትን ሱን ዴመንት፣ ኩኖ ኤርገማን ጎፍታ አብጁዻን ዮሴፍት ሙልአቴ፣ “ሰበቢ ሄሮድስ ሙጭቸ አጄሱ በርባዱፍ ከኢቲ ሙጭቻፊ ሃዸሳ ፉዸዹቲ ግብጥት በቀዹ። ሀመ አን ዬሮ አት እት ዴብቱ ስት ህሙት አቹመ ቱር” ጄዼን።<verse eid="MAT 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14"/>ከናፉ ዮሴፍ ከኤ ሙጭቻፊ ሃዸሳ ሀልከኒን ፉዸቴ ግብጥት ቀጄሌ፤ <verse eid="MAT 2:14"/><verse number="15" style="v" sid="MAT 2:15"/>ሀመ ሄሮድስ ዱኡትስ አች ጅራቴ። ኩንስ አከ ወን ጎፍታን ከራ ራጅቻቲን፣ “አን ግብጢ እልመኮ ዋሜረ”<note caller="+" style="f"><char style="fr" closed="false">2፥15 </char><char style="ft" closed="false"><char style="xt"><ref loc="HOS 11:1">ሆሴ 11፥1</ref></char></char></note> ጄዼ ሱን ራወተሙፍ ተኤ።<verse eid="MAT 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16"/>ሄሮድስ ዮሙ አከ ቤክቶትን ሱን እሰ ጎዎምሰን ሁበቴት አከ መሌ ኣሬ፤ እንስ አከ ዬሮ ቤክቶተ ሰነራ በሬት፣ እጆሌ ዺራ ወረ ኡሙሪንሳኒ ወጋ ለማፊ ሀመሲ ገድ ተኤ ከኔን ቤትልሄሚፊ ናኖሼ ኬሰ ጅራተን ሁንደ ነመ እት ኤርጌ ፍጭሲሴ። <verse eid="MAT 2:16"/><verse number="17" style="v" sid="MAT 2:17"/>ከናንስ ወን ኤርምያስ ራጅች ዱበቴ ንራወተሜ። እንስ አከነ ጄዸ፦<verse eid="MAT 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18"/>“ሰገሌን ቦእቻቲፊ ወዋትና ጉዳን ቶኮ</para>
  <para style="q2" vid="MAT 2:18">ራማ ኬሳ ዸገአሜ፤</para>
  <para style="q1" vid="MAT 2:18">ሰበቢ እሳን ህንጅሬፍ፣</para>
  <para style="q2" vid="MAT 2:18">ራሄል እጆሌሼቲፍ ቦኣ ጅርት፤</para>
  <para style="q2" vid="MAT 2:18">ጀጀባቹስ ንድዴ።”<note caller="+" style="f"><char style="fr" closed="false">2፥18 </char><char style="ft" closed="false"><char style="xt"><ref loc="JER 31:15">ኤር 31፥15</ref></char></char></note><verse eid="MAT 2:18"/></para>
  <para style="s1">ናዝሬትት ዴብኡሳኒ</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19"/>ኤርገ ሄሮድስ ዱኤ ቦዴ፣ ኤርገማን ጎፍታ ቶኮ ግብጥት አብጁዻን ዮሴፍት ሙልአቴ፣ <verse eid="MAT 2:19"/><verse number="20" style="v" sid="MAT 2:20"/>“ወር ሉቡ ሙጭቻ በርባደን ዋን ዱአኒፍ ከኢቲ ሙጭቸ ሃዸሳ ወጅን ፉዸዹቲ ብየ እስራኤል ዸቅ” ጄዼን።<verse eid="MAT 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21"/>ከናፉ ዮሴፍ ከኤ ሙጭቻፊ ሃዸሳ ፉዸቴ ብየ እስራኤል ዸቄ። <verse eid="MAT 2:21"/><verse number="22" style="v" sid="MAT 2:22"/>ገሩ ዮሙ አከ አርኬላዎስ እዶ አባሳ፣ እዶ ሄሮድስ ይሁዳረት ሞኤ ዸገኤት አች ዸቁ ሶዳቴ፤ አብጁዻንስ ዋን ኦፍ ኤገቺስን እሳፍ ኬነሜፍ ገረ ኣና ገሊላ ዴሜ፤ <verse eid="MAT 2:22"/><verse number="23" style="v" sid="MAT 2:23"/>አችስ ዸቄ መጋላ ናዝሬት ጄዸምቱ ኬሰ ጅራቴ። ኩንስ ዱቢን፣ “እን ናዝርቸ ጄዸሜ ንዋመመ” ጄዸሜ ከራ ራጆታቲን ዱበተሜ ሱን አከ ራወተሙፍ ተኤ።<verse eid="MAT 2:23"/></para>
  <chapter eid="MAT 2"/>
  <chapter number="3" style="c" sid="MAT 3"/>
  <para style="s1">ለለበ ዮሀንስ ጩጳ</para>
  <para style="r">
    <ref loc="MAT 3:1-12">3፥1‑12</ref> ኩወፈ – <char style="xt"><ref loc="MRK 1:3-8">ማር 1፥3‑8</ref>፤ <ref loc="LUK 3:2-17">ሉቃ 3፥2‑17</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1"/>በረ ሰነ ዮሀንስ ጩጳን ገሞጂ ይሁዳ ኬሰት ለለባ ዹፌ፤ <verse eid="MAT 3:1"/><verse number="2" style="v" sid="MAT 3:2"/>እንስ፣ “ሞቱማን ሰሚ ዽኣቴራቲ ቀልቢ ጅጂረዻ” ጄዼ። <verse eid="MAT 3:2"/><verse number="3" style="v" sid="MAT 3:3"/>ኩንስ እሰ ዋኤንሳ ከራ እሳያስ ራጅቻቲን፣</para>
  <para style="q1" vid="MAT 3:3">“ሰገሌ ነመ፣ ‘ጎፍታዻፍ ከራ ቆጴሳ፤</para>
  <para style="q1" vid="MAT 3:3">ዳንዲ ቀጄላስ እሳፍ ሆጄዻ’</para>
  <para style="q2" vid="MAT 3:3">ጄዼ ገሞጂ ኬሳ እዩ ቶኮ”<note caller="+" style="f"><char style="fr" closed="false">3፥3 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 40:3">እሳ 40፥3</ref></char></char></note></para>
  <para style="m" vid="MAT 3:3">ጄዸሜ፣ ዱበተሜ ሰናዸ።<verse eid="MAT 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4"/>ኡፈትን ዮሀንስ ርፌንሰ ጋላራ ሆጄተሜ፤ እንስ ሙዺሳት ሰበተ ቴጳ ህዸተ ቱሬ። ኛትንሳሞ ሀዋንሳፊ ደመ ቦሶና ቱሬ። <verse eid="MAT 3:4"/><verse number="5" style="v" sid="MAT 3:5"/>ነሞትንስ ዬሩሳሌምራ፣ ይሁዳ ሁንዳፊ ብየ ናኖ ዮርዳኖስ ጉቱራ ገረሳ ዸቃ ቱረን። <verse eid="MAT 3:5"/><verse number="6" style="v" sid="MAT 3:6"/>ጩቡሳኒስ ህመቻ፣ ለገ ዮርዳኖስ ኬሰት እሳን ጩጰማ ቱረን።<verse eid="MAT 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7"/>እን ገሩ ዮሙ ፈሪሶታፊ ሰዱቆተ ኬሳ ባይኤንሳኒ ኡቱ ገረ እዶ እን እት ጩጳ ቱሬ ዹፈኑ አርጌት አከነ ጄዼን፤ “እስን እጆሌ ቡቲነነ! ዼከምሰ ዹፉ ጀላ አከ በቀተኒፍ ኤኙቱ እስንት ህሜ? <verse eid="MAT 3:7"/><verse number="8" style="v" sid="MAT 3:8"/>ኤጋ እጀ ቀልቢ ጅጂረትና ምርከኔሱ ነቀዻ። <verse eid="MAT 3:8"/><verse number="9" style="v" sid="MAT 3:9"/>እስን፣ ‘አባንኬኘ አብረሃሚዸ’ ኦፊን ጄቹ ዋን ደንዴሰን ህንሴእና። ዋቅን ዸጎተ ከኔንራ አብረሃሚፍ እጆሌ ካሱ አከ ደንደኡ አን እስንት ነንህማቲ። <verse eid="MAT 3:9"/><verse number="10" style="v" sid="MAT 3:10"/>ቆቶን አመዩ ህደ ሙኬኒረ ካአሜረ፤ ሙክት እጀ ጋሪ ህንነቀትኔ ሁንድኑስ ሙረሜ እብደት ደርበተመ።<verse eid="MAT 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11"/>“አን ቀልቢ ጅጂረትናዻፍን ብሻኒን እስን ጩጰ። እን ነ ዱባን ዹፉ ገሩ ነ ጫላ ጀባዸ፤ አን ኮጴሳዩ ባቹፍ ህንመሉ። እን ሀፉረ ቁልቁሉፊ እብዳን እስን ጩጰ። <verse eid="MAT 3:11"/><verse number="12" style="v" sid="MAT 3:12"/>እን አፈርሳ እቲን ምዻን ቁሌሱ ኦፍ ሀርካ ቀበ፤ ቀመዲሳ ጎምብሳት ነቀተ፤ ኦብዲሳ ንቁልቁሌሰ፤ ሀበቂ ገሩ እብደ ህንዻምኔን ጉበ።”<verse eid="MAT 3:12"/></para>
  <para style="s1">ጩጰሙ ዬሱስ</para>
  <para style="r">
    <ref loc="MAT 3:13-17">3፥13‑17</ref> ኩወፈ – <char style="xt"><ref loc="MRK 1:9-11">ማር 1፥9‑11</ref>፤ <ref loc="LUK 3:21">ሉቃ 3፥21</ref>፣<ref loc="LUK 3:22">22</ref>፤ <ref loc="JHN 1:31-34">ዮሀ 1፥31‑34</ref></char></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13"/>ዬሱስ ኤርገሲ ዮሀንሲን ጩጰሙፍ ገሊላዻ ገረ ለገ ዮርዳኖስ ዹፌ። <verse eid="MAT 3:13"/><verse number="14" style="v" sid="MAT 3:14"/>ዮሀንስ ገሩ፣ “አን ሲን ጩጰሙ ነ በርባችሰ፤ አትሞ ገረኮ ዹፍታ?” ጄዼ እሰ ዾዌ።<verse eid="MAT 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15"/>ዬሱስስ ዴብሴ፣ <char style="wj">“አማፍ አከኑመ ሃተኡ ዺስ፤ ኑ ቀጄሉማ ሁንደ ራወቹዻፍ ዋን ከነ ጎቹ ቀብናቲ”</char> ጄዼን። ዮሀንስስ እሰ ዾዉ ዺሴ።<verse eid="MAT 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16"/>ዬሱስስ አኩመ ጩጰሜን ብሻን ኬሳ ኦል በኤ። እንስ ዮሙሱመ ሰሚን በነሜ፣ ኡቱ ሀፉር ዋቃ አኩመ ጉጌት ገድ ቡኤ እሰረስ ቁበቱ አርጌ። <verse eid="MAT 3:16"/><verse number="17" style="v" sid="MAT 3:17"/>ሰገሌን ቶኮስ ሰሚራ፣ “ኩን እልመኮ እሰ አን ጃለዹዸ፤ እሰት ባይኤ ነንገመደ” ጄዼ።<verse eid="MAT 3:17"/></para>
  <chapter eid="MAT 3"/>
  <chapter number="4" style="c" sid="MAT 4"/>
  <para style="s1">ዬሱስ ቆረሙሳ</para>
  <para style="r">
    <ref loc="MAT 4:1-11">4፥1‑11</ref> ኩወፈ – <char style="xt"><ref loc="MRK 1:12-13">ማር 1፥12‑13</ref>፤ <ref loc="LUK 4:1-13">ሉቃ 4፥1‑13</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1"/>ኤርገሲ ዬሱስ አከ ዲያብሎሲን ቆረሙፍ ሀፉራን ገሞጂት ጌፈሜ። <verse eid="MAT 4:1"/><verse number="2" style="v" sid="MAT 4:2"/>እንስ ኤርገ ጉያ አፉርተማፊ ሀልከን አፉርተመ ሶሜ ቦዴ ንቤለኤ። <verse eid="MAT 4:2"/><verse number="3" style="v" sid="MAT 4:3"/>እን ነመ ቆሩ ሱን ገረሳ ዹፌ፣ “አት ዮ እልመ ዋቃ ታቴ፣ አከ ዸጎትን ኩኔን ቡዴነ ተአን አጀጅ” ጄዼን።<verse eid="MAT 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4"/>ዬሱስሞ ዴብሴ፣ <char style="wj">“ ‘ነምን ዱቢ አፋን ዋቀዮቲ በኡ ሁንዳን መሌ ቡዴነ ቆፋን ህንጅራቱ’</char><note caller="+" style="f"><char style="fr" closed="false">4፥4 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 8:3">ኬዴ 8፥3</ref></char></char></note> <char style="wj">ጄዸሜ በሬፈሜረ”</char> ጄዼን።<verse eid="MAT 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5"/>ኤርገሲ ዲያብሎስ ገረ መጋላ ቁልቁሉት እሰ ጌሴ ፊጤ መነ ቁልቁሉማረ ዻበቺሴ። <verse eid="MAT 4:5"/><verse number="6" style="v" sid="MAT 4:6"/>አከነስ ጄዼን፤ “አት ዮ እልመ ዋቃ ታቴ፣ ገድ ኦፍ ደርበዹ። አከነ ጄዸሜ በሬፈሜራቲ፦</para>
  <para style="q1" vid="MAT 4:6">“ ‘እን ኤርገሞተሳ ሲፍ ንአጀጀ፤</para>
  <para style="q2" vid="MAT 4:6">እሳንስ አከ አት ሚለኬቲን ዸጋት ህንቡኔፍ፣</para>
  <para style="q2" vid="MAT 4:6">ሀርከሳኒቲን ኦል ስ ፉዹ።’<note caller="+" style="f"><char style="fr" closed="false">4፥6 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 91:11">ፋር 91፥11</ref>፣<ref loc="PSA 91:12">12</ref></char></char></note>”<verse eid="MAT 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7"/>ዬሱስሞ ዴብሴ፣ <char style="wj">“ ‘ዋቀኬ ጎፍትቸ ህንቆርን’</char><note caller="+" style="f"><char style="fr" closed="false">4፥7 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 6:16">ኬዴ 6፥16</ref></char></char></note> <char style="wj">ጄዸሜ በሬፈሜረ”</char> ጄዼን።<verse eid="MAT 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8"/>አመስ ዲያብሎስ ቱሉ አከ መሌ ኦል ዼራ ቶኮት ኦል እሰ ባሴ ሞቱሞተ አዱኛ ሁንዳፊ ኡልፍነሳኒ እሰት አርግሲሴ። <verse eid="MAT 4:8"/><verse number="9" style="v" sid="MAT 4:9"/>አከነስ ጄዼን፤ “ዮ አት ገድ ጄቴ ናፍ ሰገዴ፣ ዋን ከነ ሁንዱማ ሲፍን ኬነ።”<verse eid="MAT 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10"/>ዬሱስስ፣ <char style="wj">“ሴጠነነነ፣ ነራ ፈጋዹ! ‘ዋቀኬ ጎፍትቻፍ ሰገድ፤ እሱመ ቆፈ ተጃጅል’</char><note caller="+" style="f"><char style="fr" closed="false">4፥10 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 6:13">ኬዴ 6፥13</ref></char></char></note> <char style="wj">ጄዸሜ በሬፈሜራቲ”</char> ጄዼን።<verse eid="MAT 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11"/>ዲያብሎስስ እሰ ዺሴ ዴሜ፤ ኤርገሞትንሞ ዹፈኒ እሰ ተጃጅለን።<verse eid="MAT 4:11"/></para>
  <para style="s1">ዬሱስ ለለበ ጀልቀቡሳ</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12"/>ዬሱስ ዮሙ አከ ዮሀንስ መነ ህዻት ገልፈሜ ዸገኤት ገሊላት ዴብኤ። <verse eid="MAT 4:12"/><verse number="13" style="v" sid="MAT 4:13"/>እንስ ናዝሬቲ በኤ ገረ ቅፍርናሆም እሼ ብየ ዜቡሎኒፊ ንፍታሌም ኬሰት ቀርቀረ ገላናት አርገምቱ ሰና ዸቄ አች ጅራቴ፤ <verse eid="MAT 4:13"/><verse number="14" style="v" sid="MAT 4:14"/>ኩንስ አከ ዱቢን ከራ እሳያስ ራጅቻቲን ዱበተሜ ሱን ራወተሙፍ ተኤ፤ ዱብችስ አከነ ጄዸ፦<verse eid="MAT 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15"/>“ብይ ዜቡሎኒፊ ብይ ንፍታሌም</para>
  <para style="q2" vid="MAT 4:15">ከኔን ዮርዳኖስ ገመ፣</para>
  <para style="q1" vid="MAT 4:15">ቀርቀረ ዳንዲ ገላናረ ጅረን፣</para>
  <para style="q2" vid="MAT 4:15">ገሊላን ነሞተ ኦርማስ፣<verse eid="MAT 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16"/>ሰብን ዱከነ ኬሰ ጅራቱ፣</para>
  <para style="q2" vid="MAT 4:16">እፈ ጉዳ አርጌረ፤</para>
  <para style="q1" vid="MAT 4:16">ወረ ብየ ጋድዱ ዱኣ ኬሰ ጅራተኒፍስ፣</para>
  <para style="q2" vid="MAT 4:16">እፍን በኤረ።”<note caller="+" style="f"><char style="fr" closed="false">4፥16 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 9:1">እሳ 9፥1</ref>፣<ref loc="ISA 9:2">2</ref></char></char></note><verse eid="MAT 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17"/>ዬሱስ ዬሮ ሰና ጀልቀቤ፣ <char style="wj">“ሞቱማን ሰሚ ዽኣቴራቲ ቀልቢ ጅጂረዻ”</char> ጄዼ ለለቡት ከኤ።<verse eid="MAT 4:17"/></para>
  <para style="s1">ዋመሙ በረቶተ ጀልቀባ</para>
  <para style="r">
    <ref loc="MAT 4:18-22">4፥18‑22</ref> ኩወፈ – <char style="xt"><ref loc="MRK 1:16-20">ማር 1፥16‑20</ref>፤ <ref loc="LUK 5:2-11">ሉቃ 5፥2‑11</ref>፤ <ref loc="JHN 1:35-42">ዮሀ 1፥35‑42</ref></char></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18"/>ዬሱስ ኡቱ ቀርቀረ ገላነ ገሊላረ ዴማ ጅሩ፣ ኦቦሎተ ለመ ጄቹንስ ስሞን እሰ ጴጥሮስ ጄዸሙፊ ኦቦሌሰሳ እንድሪያስን አርጌ። እሳንስ ቁርጡሚ ቀብዶተ ዋን ተአኒፍ ክዮ ገላነት ደርበቻ ቱረን። <verse eid="MAT 4:18"/><verse number="19" style="v" sid="MAT 4:19"/>ዬሱስስ፣ <char style="wj">“ኮታ፣ ነ ዱካ ቡኣ፤ አንስ አከ እስን ቀብዱ ነሞታ ታተኒፍ እስን ነንኤርገ”</char> ጄዼን። <verse eid="MAT 4:19"/><verse number="20" style="v" sid="MAT 4:20"/>እሳንስ ዮሙሱመ ክዮሳኒ ዺሰኒ እሰ ዱካ ቡአን።<verse eid="MAT 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21"/>እንስ ኡቱ አቺ ከኤ ዴሙ ኦቦሎተ ገረ ብራ ለመ ጄቹንስ ያቆብ እልመ ዘብዴዎሲፊ ኦቦሌሰሳ ዮሀንስን አርጌ። እሳንስ አባሳኒ ዘብዴዎስ ወጅን ክዮሳኒ ቆጴፈቻ ብድሩ ኬሰ ቱረን። ዬሱስስ እሳን ዋሜ፤ <verse eid="MAT 4:21"/><verse number="22" style="v" sid="MAT 4:22"/>እሳንስ ዮሙሱመ ብድሩ ሰናፊ አባሳኒ ዺሰኒ እሰ ዱካ ቡአን።<verse eid="MAT 4:22"/></para>
  <para style="s1">ዬሱስ ዹኩብሰቶተ ፈይሱሳ</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23"/>ዬሱስ መኔን ሰገዳሳኒ ኬሰት በርሲሳ፣ ወንጌለ ሞቱማ ለለባ፣ ዽቤፊ ዹኩበ ሰበ ኬሰ ጅሩ ሁንደ ፈይሳ ገሊላ ጉቱ ኬሰ ዴሜ። <verse eid="MAT 4:23"/><verse number="24" style="v" sid="MAT 4:24"/>ኦዱን ዋኤሳስ ሶርያ ሁንደ ኬሰት ዸገአሜ፤ ነሞትንስ ወረ ዹኩበ ገራ ገራቲን ቀበመን፣ ወረ ዹኩበ ሀማን ዽጰተን፣ ወረ ሀፉረ ሀማን ቀበመን፣ ወረ ዹኩበ ገገብዶቲን ዽጰተኒፊ ወረ ዸግን እረት ዱኤ እሰት ፍደን፤ እንስ እሳን ፈይሴ። <verse eid="MAT 4:24"/><verse number="25" style="v" sid="MAT 4:25"/>ቱትን ነሞተ ባይኤስ ገሊላዻ፣ መጋላ ኩርነኒ፣ ዬሩሳሌሚ፣ ይሁዳፊ ብየ ዮርዳኖስ ገማቲ እሰ ዱካ ቡኤ።<verse eid="MAT 4:25"/></para>
  <chapter eid="MAT 4"/>
  <chapter number="5" style="c" sid="MAT 5"/>
  <para style="s1">ወረ ኤብፈሞ</para>
  <para style="r">
    <ref loc="MAT 5:3-12">5፥3‑12</ref> ኩወፈ – <char style="xt"><ref loc="LUK 6:20-23">ሉቃ 6፥20‑23</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1"/>ዬሱስ ዮሙ ነሞተ ባይኤ አርጌት፣ ቱሉት ኦል በኤ ታኤ። በረቶትንሳስ ገረሳ ዹፈን፤ <verse eid="MAT 5:1"/><verse number="2" style="v" sid="MAT 5:2"/>እንስ እሳን በርሲሱ ጀልቀቤ። አከነስ ጄዼ፦<verse eid="MAT 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3"/>
    <char style="wj">“ወር ሀፉራን ህዬዪ ተአን ኤብፈሞዸ፤</char></para>
  <para style="q2" vid="MAT 5:3">
    <char style="wj">ሞቱማን ሰሚ ከንሳኒቲ።</char><verse eid="MAT 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4"/>
    <char style="wj">ወር ገደን ኤብፈሞዸ፤</char></para>
  <para style="q2" vid="MAT 5:4">
    <char style="wj">ጀጀብነ ንአርገቱቲ።</char><verse eid="MAT 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5"/>
    <char style="wj">ወር ገራሚን ኤብፈሞዸ፤</char></para>
  <para style="q2" vid="MAT 5:5">
    <char style="wj">ለፈ ንዻሉቲ።</char><verse eid="MAT 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6"/>
    <char style="wj">ወር ቀጄሉማ ቤለአኒፊ ዼቦተን ኤብፈሞዸ፤</char></para>
  <para style="q2" vid="MAT 5:6">
    <char style="wj">እሳን ንቁፉቲ።</char><verse eid="MAT 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7"/>
    <char style="wj">አራረ ቀቤዪን ኤብፈሞዸ፤</char></para>
  <para style="q2" vid="MAT 5:7">
    <char style="wj">አራረ ንአርገቱቲ።</char><verse eid="MAT 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8"/>
    <char style="wj">ወር ገራንሳኒ ቁልቁሉ ኤብፈሞዸ፤</char></para>
  <para style="q2" vid="MAT 5:8">
    <char style="wj">ዋቀ ንአርጉቲ።</char><verse eid="MAT 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9"/>
    <char style="wj">ወር ነጋ ቡሰን ኤብፈሞዸ፤</char></para>
  <para style="q2" vid="MAT 5:9">
    <char style="wj">እጆሌ ዋቃ ንጄዸሙቲ።</char><verse eid="MAT 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10"/>
    <char style="wj">ወር ቀጄሉማዻፍ ጄዸኒ አርአተመን ኤብፈሞዸ፤</char></para>
  <para style="q2" vid="MAT 5:10">
    <char style="wj">ሞቱማን ሰሚ ከንሳኒቲ።</char><verse eid="MAT 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11"/>
    <char style="wj">“ዮሙ ነሞትን ሰበቢኮቲፍ ጄዸኒ እስን አረብሰን፣ ዮሙ እስን አርአተኒፊ ዮሙ ዋን ሀማ ጎሰ ሁንዳ ሶባን እስንረት ዱበተን እስን ኤብፈሞዸ።</char> <verse eid="MAT 5:11"/><verse number="12" style="v" sid="MAT 5:12"/><char style="wj">ሰበቢ ገቲንኬሰን ሰሚ ኬሰት ጉዳ ተኤፍ እልልቻ፤ ገመዳስ፤ እሳን ራጆተ እስን ዱረ ቱረንስ ሃሉመ ከናን አርአተኒሩቲ።</char><verse eid="MAT 5:12"/></para>
  <para style="s1">ሶግዳፊ እፈ</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13"/>
    <char style="wj">“እስን ሶግደ ለፋት። ገሩ ሶግድ ዮ ምኣሳ ዸቤ፣ ምኣንሳ አከሚን ዴብፈሙ ደንደአ? ገድ ገተሜ ሚላን ዽዺተመ መሌ ስአች ዋን ቶኮሌ ህንፈየዱ።</char><verse eid="MAT 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14"/>
    <char style="wj">“እስን እፈ አዱኛት። መጋላን ጋረ ጉባ ጅሩ ቶኮ ዾከቹ ህንደንደኡ።</char> <verse eid="MAT 5:14"/><verse number="15" style="v" sid="MAT 5:15"/><char style="wj">ዮካን ነሞትን እብሳ ቀብሲሰኒ ጎምብሳ ጀለ ህንካአን። ቆደ ከና ባቱሳረ ካኡ፤ እብሳን ሱንስ ነሞተ መነ ኬሰ ጅረን ሁንዳፍ እፈ ኬነ።</char> <verse eid="MAT 5:15"/><verse number="16" style="v" sid="MAT 5:16"/><char style="wj">አከ ነሞትን ሆጂኬሰን እሰ ጋሪ አርገኒ አባኬሰን ከን ሰሚራቲፍ ኡልፍነ ኬነኒፍ እፍንኬሰንስ አከሱመ ፉለ ነሞታ ዱረት ሃእፉ።</char><verse eid="MAT 5:16"/></para>
  <para style="s1">ራወተሙ ሴራ</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17"/>
    <char style="wj">“እስን ዋን አን ሴረ ዮካን ራጆተ ዲጉ ዹፌ ህንሴእና፤ አን እሳን ራወቹፍ መሌ ዲጉፍ ህንዹፍኔ።</char> <verse eid="MAT 5:17"/><verse number="18" style="v" sid="MAT 5:18"/><char style="wj">አን ዹጉመን እስንት ህመ፤ ሀመ ሰሚፊ ለፍት ደርበንት፣ ሴር ጉቱማት ራወተመ መሌ ሴርቸ ኬሳ ቁቤን ቶኮዩ፣ ቱቃን ጥኖንሼዩ ጎንኩማ ህንበዱ።</char> <verse eid="MAT 5:18"/><verse number="19" style="v" sid="MAT 5:19"/><char style="wj">ከናፉ ነምን አጀጀወን ከኔን ኬሳ ጥናሳሌ ዲጉ፣ ከን አከ ወር ካንስ ዲገኒፍ በርሲሱ ከምዩ ሞቱማ ሰሚ ኬሰት ጥና ጄዸመ፤ ነምን አጀጀወን ከኔን ኤጉፊ ከን ወረ ካንስ በርሲሱ ከምዩ ገሩ ሞቱማ ሰሚ ኬሰት ጉዳ ጄዸመ።</char> <verse eid="MAT 5:19"/><verse number="20" style="v" sid="MAT 5:20"/><char style="wj">አን እስንትን ህመ፤ ቀጄሉማንኬሰን ቀጄሉማ ፈሪሶታቲፊ ቀጄሉማ በርሲስቶተ ሴራ ዮ ጫሉ ባቴ እስን ዹጉማን ሞቱማ ሰሚት ህንገልተን።</char><verse eid="MAT 5:20"/></para>
  <para style="s1">ነመ አጄሱ</para>
  <para style="r">
    <ref loc="MAT 5:25">5፥25</ref>፣<ref loc="MAT 5:26">26</ref> ኩወፈ – <char style="xt"><ref loc="LUK 12:58">ሉቃ 12፥58</ref>፣<ref loc="LUK 12:59">59</ref></char></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21"/>
    <char style="wj">“እስን አከ በረ ዼራን ዱረ ነሞታን፣ ‘ህንአጄስን፤ ነመ አጄሴ ከምትዩ ንሙረማ’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">5፥21 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="EXO 20:13">በኡ 20፥13</ref>
        </char>
      </char>
    </note> <char style="wj">ጄዸሜ ዸጌሰኒርቱ።</char> <verse eid="MAT 5:21"/><verse number="22" style="v" sid="MAT 5:22"/><char style="wj">አን ገሩ እስንትን ህመ፤ ነመ ኦቦሌሰሳት ዼከሙ ሁንዱማ ሙርቲቱ ኤገተ። ነምን ኦቦሌሰሳቲን <char style="tl">‘ራቱ’</char> ጄዹ ሁንድስ ሙርቲ ወልዳት ዽኣተ። ነመ ኦቦሌሰሳቲን ‘ዶፋነነ!’ ጄዹሞ እብደ ገሃነምቱ እሰ ኤገተ።</char><verse eid="MAT 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23"/>
    <char style="wj">“ከናፉ አት ዬሮ ኬናኬ እዶ ኣርሳት ዽኤስቱት ዮ አከ ኦቦሌስኬ ኮሚ ስራ ቀቡ ያደቴ፣</char> <verse eid="MAT 5:23"/><verse number="24" style="v" sid="MAT 5:24"/><char style="wj">ኬናኬ አቹመ እዶ ኣርሳ ዱረት ዺሲ ዸቂቲ ዱራን ዱርሲ ኦቦሌሰኬት አራረም፤ ኤርገሲ ኮቱቲ ኬናኬ ዽኤስ።</char><verse eid="MAT 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25"/>
    <char style="wj">“አመጃጂኬ እሰ መነ ሙርቲት ስ ጌሳ ጅሩ ወጅን ደፊ ወሊ ገል። ከነስ ኡቱመ እሰ ወጅን ከራ ጅርቱ ጎዽ፤ ዮ ከና አቺ አመጃጂንኬ ደበርሴ አባ ሴራት ስ ኬነ፤ አባን ሴራሞ ፖልሲት ስ ኬነ፤ አትስ መነ ህዻት ደርበተምተ።</char> <verse eid="MAT 5:25"/><verse number="26" style="v" sid="MAT 5:26"/><char style="wj">አን ዹጉመን ስት ህመ፤ አት ሀመ ሳንትመ እሼ ዹማ ባፍቱት አቺ ህንባቱ።</char><verse eid="MAT 5:26"/></para>
  <para style="s1">ኤጀ</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27"/>
    <char style="wj">“እስን አከ፣ ‘ህንኤጅን’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">5፥27 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="EXO 20:14">በኡ 20፥14</ref>
        </char>
      </char>
    </note> <char style="wj">ጄዸሜ ዸጌሰኒርቱ።</char> <verse eid="MAT 5:27"/><verse number="28" style="v" sid="MAT 5:28"/><char style="wj">አን ገሩ እስንትን ህመ፤ ነምን ሀዊዻን ዱበርቲ እላሉ ሁንድኑ ያደሳት እሼ ወጅን ኤጄረ።</char> <verse eid="MAT 5:28"/><verse number="29" style="v" sid="MAT 5:29"/><char style="wj">ዮ እጅኬ ምርጋ ስ ጉፈቺሴ፣ ኦፍ ኬሳ ባሲ ገት። ዸግንኬ ጉቱን ገሃነምት ደርበተሙረ፣ ኩታ ዸግነኬቲ ኬሳ ቶኮ ዸቡ ሲፍ ወያቲ።</char> <verse eid="MAT 5:29"/><verse number="30" style="v" sid="MAT 5:30"/><char style="wj">ዮ ሀርክኬ ምርጋ ስ ጉፈቺሴ ኦፍራ ሙሪ ገት። ዸግንኬ ጉቱን ገሃነምት ገሉረ፣ ኩታ ዸግነኬቲ ኬሳ ቶኮ ዸቡ ሲፍ ወየ።</char><verse eid="MAT 5:30"/></para>
  <para style="s1">ወል ሂኩ ዽርሳፊ ኒቲ</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31"/>
    <char style="wj">“ነምን ኒቲሳ ሂኩ ከምዩ፣ ‘ወረቃ ረጋ ሂካ ሃኬኑፍ’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">5፥31 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="DEU 24:1">ኬዴ 24፥1</ref>
        </char>
      </char>
    </note> <char style="wj">ጄዸሜረ።</char> <verse eid="MAT 5:31"/><verse number="32" style="v" sid="MAT 5:32"/><char style="wj">አን ገሩ እስንትን ህመ፤ ነምን ኡቱ እሼን ሀለሉማ ህንሆጄትን ኒቲሳ ሂኩ ከምዩ አከ እሼን ኤጅቱ እሼ ታስሰ፤ ነምን ዱበርቲ ሂከምቴ ፉዹ ከምዩስ ንኤጀ።</char><verse eid="MAT 5:32"/></para>
  <para style="s1">ከካ</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33"/>
    <char style="wj">“አመስ አከ ወረ ዱሪቲን፣ ‘ዋን ከከቴ ጎፍታዻፍ ጉት መሌ ሶባን ህንከከትን’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">5፥33 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="LEV 19:12">ሌዎ 19፥12</ref>፤ <ref loc="NUM 30:2">ለኮ 30፥2</ref></char>
      </char>
    </note> <char style="wj">ጄዸሜ ዸጌሰኒርቱ።</char> <verse eid="MAT 5:33"/><verse number="34" style="v" sid="MAT 5:34"/><char style="wj">አን ገሩ እስንትን ህመ፤ ጎንኩማ ህንከከትና፦ ሰሚዻን ህንከከትና፤ እን ቴሶ ዋቃቲ፤</char> <verse eid="MAT 5:34"/><verse number="35" style="v" sid="MAT 5:35"/><char style="wj">ዮካን ለፋን ህንከከትና፤ እሼን ኤጄተ ሚለሳቲ፤ ዮካን ዬሩሳሌሚን ህንከከትና፤ እሼን መጋላ ሞትቸ ጉዳቲ።</char> <verse eid="MAT 5:35"/><verse number="36" style="v" sid="MAT 5:36"/><char style="wj">መታኬቲንስ ህንከከትን፤ አት ርፌንሰ ቶኮሌ አዴሱ ዮካን ጉራቼሱ ህንደንዴሱቲ።</char> <verse eid="MAT 5:36"/><verse number="37" style="v" sid="MAT 5:37"/><char style="wj">ወን እስን ጄቹ ቀብደን፣ ‘ኤዬ’ ዮካን ‘ዋዉ’ ሃተኡ፤ ወን ከና አቺ ከምዩ እሰ ሀማ ሰነራ ዹፈ።</char><verse eid="MAT 5:37"/></para>
  <para style="s1">ቆደ እጃ፣ እጀ</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38"/>
    <char style="wj">“ ‘ቆደ እጃ፣ እጀ፤ ቆደ እልካኒሞ እልካን’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">5፥38 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="EXO 21:24">በኡ 21፥24</ref>፤ <ref loc="LEV 24:20">ሌዎ 24፥20</ref>፤ <ref loc="DEU 19:21">ኬዴ 19፥21</ref></char>
      </char>
    </note> <char style="wj">አከ ጄዸሜ ዸጌሰኒርቱ።</char> <verse eid="MAT 5:38"/><verse number="39" style="v" sid="MAT 5:39"/><char style="wj">አን ገሩ እስንትን ህመ። ነመ ሀማዻን ህንሞርከትና። ዮ ነምን ቶኮ መዲኬ ምርጋ ስ ከበሌ፣ ካንስ እት ቀብ።</char> <verse eid="MAT 5:39"/><verse number="40" style="v" sid="MAT 5:40"/><char style="wj">ዮ ነምን ቶኮ ስ ህመቴ ክታኬ ስራ ፉዸቴ፣ ኮቲኬስ ኬኒፍ።</char> <verse eid="MAT 5:40"/><verse number="41" style="v" sid="MAT 5:41"/><char style="wj">ዮ ነምን ቶኮ አከ አት ገረ ኪሎ ሜትረ ቶኮፊ ወለካ እሰ ወጅን ዴምቱ ስ ድርቅሲሴ፣ አትሞ ገረ ኪሎ ሜትረ ሰዲ እሰ ወጅን ዴም።</char> <verse eid="MAT 5:41"/><verse number="42" style="v" sid="MAT 5:42"/><char style="wj">ነመ ስ ከዸቱፍ ኬን፤ ነመ ስራ ልቄፈቹ በርባዱትስ ዱግደ ህንገረገልችን።</char><verse eid="MAT 5:42"/></para>
  <para style="s1">ዲነ ጃለቹ</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43"/>
    <char style="wj">“ ‘ኦላኬ ጃለዹ፤</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">5፥43 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="LEV 19:18">ሌዎ 19፥18</ref>
        </char>
      </char>
    </note> <char style="wj">ዲነኬ ጅብ’ አከ ጄዸሜ ዸጌሰኒርቱ።</char> <verse eid="MAT 5:43"/><verse number="44" style="v" sid="MAT 5:44"/><char style="wj">አን ገሩ እስንትን ህመ፤ ዲኖተኬሰን ጃለዻ፤ ወረ እስን አርአተኒፍስ ከዸዻ፤</char> <verse eid="MAT 5:44"/><verse number="45" style="v" sid="MAT 5:45"/><char style="wj">ከናንስ አባኬሰን ከን ሰሚራቲፍ እጆሌ ንታቱ። እን ወረ ሀሞፊ ወረ ገጋሪዻፍ አዱሳ ንባሰ፤ ቀጄልቶታፊ ጀልኦታፍስ ቦካ ንሮብሰ።</char> <verse eid="MAT 5:45"/><verse number="46" style="v" sid="MAT 5:46"/><char style="wj">እስን ዮ ወረ እስን ጃለተን ቆፈ ጃለተን ገቲ ማሊ አርገቱ? ከነሞ ቀረጦትንዩ ንጎዹ ምቲ?</char> <verse eid="MAT 5:46"/><verse number="47" style="v" sid="MAT 5:47"/><char style="wj">እስን ዮ ኦቦሎተኬሰን ቆፈ ነጋ ጋፈተን ወረ ካን ጫላ ማል ሆጄቹት ጅርቱ? ከነሞ ነሞትን ኦርማዩ ንጎዹ ምቲ?</char> <verse eid="MAT 5:47"/><verse number="48" style="v" sid="MAT 5:48"/><char style="wj">አኩመ አባንኬሰን እን ሰሚራ ሙዳ ህንቀብኔ ሰነ፣ እስንስ ወረ ሙዳ ህንቀብኔ ተኣ።</char><verse eid="MAT 5:48"/></para>
  <chapter eid="MAT 5"/>
  <chapter number="6" style="c" sid="MAT 6"/>
  <para style="s1">ረከታፍ ዋ ኬኑ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1"/>
    <char style="wj">“አከ እሳን እስን አርገኒፍ ጄተኒ ‘ሆጂ ቀጄሉማ ኬሰን ፉለ ነሞታ ዱረት አከ ህንሆጄትኔፍ ኦፍ ኤገዻ። ዮ አከስ ጎተን አባኬሰን ከን ሰሚራ ብራ ገቲ ህንቀባተኒቲ።</char><verse eid="MAT 6:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2"/>
    <char style="wj">“ከናፉ አት ዮሙ ወረ ረከተኒፍ ዋ ኬንቱት አከ ፈኬስቶትን ነሞተ ብረት ጀጀሙፍ ጄዸኒ መኔን ሰገዳ ኬሰቲፊ ከራረት ጎዸን ሰነ መለከታን ህንለብሰትን። አን ዹጉመን እስንት ህመ፤ እሳን ገቲሳኒ አርገተኒሩ።</char> <verse eid="MAT 6:2"/><verse number="3" style="v" sid="MAT 6:3"/><char style="wj">ዬሮ አት ረከቶታፍ ዋ ኬንቱት ገሩ ዋን ሀርክኬ ምርጋ ጎዹ፣ ሀርክኬ ብታ ህንቤክን፤</char> <verse eid="MAT 6:3"/><verse number="4" style="v" sid="MAT 6:4"/><char style="wj">ኩንስ አከ ኬናንኬ ዾክሳን ተኡፍ። አባንኬ እን ዋን ዾክሳት ሆጄተሙ አርጉ ሱን እፋን እፈት ገቲ ሲፍ ኬነ።</char><verse eid="MAT 6:4"/></para>
  <para style="s1">ከዸትና</para>
  <para style="r">
    <ref loc="MAT 6:9-13">6፥9‑13</ref> ኩወፈ – <char style="xt"><ref loc="LUK 11:2-4">ሉቃ 11፥2‑4</ref></char></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5"/>
    <char style="wj">“እስን ዮሙ ከዸተን አከ ፈኬስቶታ ህንተእና፤ እሳን ነመት ሙልአቹፍ ጄዸኒ መኔን ሰገዳ ኬሳፊ ጎሌ ከራረ ዻበተኒ ከዸቹ ጃለቱቲ። አን ዹጉመን እስንት ህመ፤ እሳን ገቲሳኒ አርገተኒሩ።</char> <verse eid="MAT 6:5"/><verse number="6" style="v" sid="MAT 6:6"/><char style="wj">አት ገሩ ዬሮ ከዸቱ መነኬት ኦል ገል፤ በልበለ ጩፈዹቲ አባኬ እሰ ህንሙልአትኔ ሰነ ከዸዹ። አባንኬ እን ዋን ዾክሳት ሆጄተሙ አርጉ ሱን እፋን እፈት ገቲ ሲፍ ኬነ።</char> <verse eid="MAT 6:6"/><verse number="7" style="v" sid="MAT 6:7"/><char style="wj">እስንስ ዮሙ ከዸተን አከ ነሞተ ኦርማ ዱቢ ፋይዳ ህንቀብኔ እረ ህንዴዴብእና፤ እሳን ባይእነ ዱቢሳኒቲን ዋን እሳኒፍ ዸገአሙ ሴኡ።</char> <verse eid="MAT 6:7"/><verse number="8" style="v" sid="MAT 6:8"/><char style="wj">እስን አከሳኒ ህንተእና፤ አባንኬሰን ኡቱመ እስን ህንከዸትንዩ ዋን እስን በርባችሱ ንቤካቲ።</char><verse eid="MAT 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9"/>
    <char style="wj">“ኤጋ አከነ ጄዻ ከዸዻ፦</char></para>
  <para style="q1" vid="MAT 6:9">
    <char style="wj">“ ‘ያ አባኬኘ ከን ሰሚረ ጅርቱ፣</char></para>
  <para style="q1" vid="MAT 6:9">
    <char style="wj">መቃንኬ ሃቁልቁላኡ፤</char><verse eid="MAT 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10"/>
    <char style="wj">ሞቱማንኬ ሃዹፉ፤</char></para>
  <para style="q1" vid="MAT 6:10">
    <char style="wj">ፌዺንኬ አኩመ ሰሚረት ተኤ ሰነ፣</char></para>
  <para style="q2" vid="MAT 6:10">
    <char style="wj">ለፈረትስ ሃተኡ።</char><verse eid="MAT 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11"/>
    <char style="wj">ቡዴነኬኘ ከን ጉዩመ ጉያ ሀርአ ኑ ኬን።</char><verse eid="MAT 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12"/>
    <char style="wj">አኩመ ኑ ወረ የከ ኑት ሆጄተኒፍ ዺፍኑ ሰነ፣</char></para>
  <para style="q2" vid="MAT 6:12">
    <char style="wj">አትስ የከኬኘ ኑፍ ዺስ።</char><verse eid="MAT 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13"/>
    <char style="wj">እሰ ሀማ ጀላ ኑ ባስ መሌ ቆረመት ኑ ህንገልችን።’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">6፥13 </char>
      <char style="ft" closed="false">አከ ግሪኮታት </char>
      <char style="fq" closed="false">ቆረመት </char>
      <char style="ft" closed="false">ጄቹን </char>
      <char style="fqa" closed="false">ቆርማተት ጄቹ።</char>
    </note></para>
  <para style="q2" vid="MAT 6:13">
    <char style="wj">ሞቱማን፣ ሁምን፣ ኡልፍንስ በረ በራን ከንኬት።</char></para>
  <para style="qr" vid="MAT 6:13">
    <char style="wj">አሜን።</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">6፥13 </char>
      <char style="ft" closed="false">ዮካን </char>
      <char style="fq" closed="false">እሰ ሀማ ጀላ </char>
      <char style="ft" closed="false">ሂካወን ዱሪ ቶኮ ቶኮ ጄቸ </char>
      <char style="fqa" closed="false">እሰ / ሞቱማን፣ ሁምን፣ ኡልፍንስ በረ በራን ከንኬት። አሜን </char>
      <char style="ft" closed="false">ጄዹ ህንቀበን።</char>
    </note><verse eid="MAT 6:13"/></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 6:14"/>
    <char style="wj">ዮ እስን ነሞታፍ ጩቡሳኒ ዺፍተን፣ አባንኬሰን እን ሰሚራስ አከሱመ እስኒ ዺሳቲ።</char> <verse eid="MAT 6:14"/><verse number="15" style="v" sid="MAT 6:15"/><char style="wj">ዮ እስን ነሞታፍ ጩቡሳኒ ዺሱ ባተን ገሩ፣ አባንኬሰንስ አከሱመ ጩቡኬሰን እስኒፍ ህንዺሱ።</char><verse eid="MAT 6:15"/></para>
  <para style="s1">ሶመ</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16"/>
    <char style="wj">“እስን ዮሙ ሶምተንት አከ ፈኬስቶታ ፉለ ህንዱከኔፈትና፤ እሳን አከ ሶሙት ጅረን አርግሲፈቹፍ ጄዸኒ ፉለሳኒ ሀሜሱ። አን ዹጉመን እስንት ህመ፤ እሳን ገቲሳኒ አርገተኒሩ።</char> <verse eid="MAT 6:16"/><verse number="17" style="v" sid="MAT 6:17"/><char style="wj">አት ገሩ ዬሮ ሶምቱ መታኬ ድበዹ፤ ፉለኬስ ዽቀዹ።</char> <verse eid="MAT 6:17"/><verse number="18" style="v" sid="MAT 6:18"/><char style="wj">ኩንስ አከ ሶመኬ ሰነ አባኬ እሰ ነመት ህንሙልአትኔ መሌ ነምን ህንቤክኔፊዸ። አባንኬ እን ዋን ዾክሳት ሆጄተሙ አርጉ ሱን ገቲኬ እፋን እፈት ሲፍ ኬነ።</char><verse eid="MAT 6:18"/></para>
  <para style="s1">በዻዹማ ሰሚራ</para>
  <para style="r">
    <ref loc="MAT 6:22-23">6፥22‑23</ref> ኩወፈ – <char style="xt"><ref loc="LUK 11:34-36">ሉቃ 11፥34‑36</ref></char></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19"/>
    <char style="wj">“እስን እዶ እት ብሊፊ ዳነኦን በሌስቱፊ እዶ እት ሀቱን ጨብስቴ ሀቱ ለፈረት በዻዹማ ኦፊኬሰኒፍ ህንኩፈትና።</char> <verse eid="MAT 6:19"/><verse number="20" style="v" sid="MAT 6:20"/><char style="wj">ገሩ እዶ እት ብሊፊ ዳነኦን ኛቴ ህንበሌስኔፊ እዶ እት ሀቱን ጨብስቴ ህንሀትኔ ሰሚረት በዻዹማ ኦፊኬሰኒፍ ኩፈዻ።</char> <verse eid="MAT 6:20"/><verse number="21" style="v" sid="MAT 6:21"/><char style="wj">እዱመ በዻዹማንኬ ጅሩ ሰነ ገራንኬስ ጅራቲ።</char><verse eid="MAT 6:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22"/>
    <char style="wj">“እጅ እብሳ ዸግናት። እጅኬ ፈያ ታናን፣ ዸግንኬ ጉቱን እፋን ጉተመ።</char> <verse eid="MAT 6:22"/><verse number="23" style="v" sid="MAT 6:23"/><char style="wj">ዮ እጅኬ ፈያ ህንተእን ገሩ፣ ዸግንኬ ጉቱን ንዱከናአ። ኤርገ እፍን ስ ኬሰ ጅሩ ሱን ዱከናኤ፣ ዱከን ሱን ሀመም ሃጀባቱሬ!</char><verse eid="MAT 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24"/>
    <char style="wj">“ነምን ጎፍቶተ ለመ ተጃጅሉ ደንደኡ ቶኮዩ ህንጅሩ። እሰ ቶኮ ጅብቴ እሰ ካን ጃለታቲ፤ ዮካን እሰ ቶኮፍ ኦፍ ኬንቴ እሰ ካንሞ ቱፈተ። እስንስ ዋቃፊ ማለቀ ተጃጅሉ ህንደንዴሰን።</char><verse eid="MAT 6:24"/></para>
  <para style="s1">ህንያደእና</para>
  <para style="r">
    <ref loc="MAT 6:25-33">6፥25‑33</ref> ኩወፈ – <char style="xt"><ref loc="LUK 12:22-31">ሉቃ 12፥22‑31</ref></char></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25"/>
    <char style="wj">“ከናፉ አን እስንትን ህመ፤ ‘ማል ኛትነ ዮካን ማል ዹግነ?’ ጄተኒ ዋኤ ጅሬኘኬሰኒ ህንያደእና፤ ዮካን ‘ማል ኡፈትነ?’ ጄተኒ ዋኤ ዸግነኬሰኒ ህንያደእና። ጅሬኝ ኛተ ህንጫሉ? ዸግንስ ኡፈተ ህንጫሉ?</char> <verse eid="MAT 6:25"/><verse number="26" style="v" sid="MAT 6:26"/><char style="wj">ሜ ስምብሮተ ሰሚ እላላ፤ እሳን ህንፈጫፈተን ዮካን ህንሃመተን ዮካን ጎምብሳት ህንገልፈተን፤ ተኡስ አባንኬሰን እን ሰሚራ እሳን ሶረ። እስንሞ እሳን ጫላ ገቲ ጉዳ ቀብዱ ምቲ?</char> <verse eid="MAT 6:26"/><verse number="27" style="v" sid="MAT 6:27"/><char style="wj">እስን ኬሳ ነምን ያደኡዻን ሆጃሳረት ዹንዹመ ቶኮ ደበለቹ ደንደኡ ኤኙ?</char><verse eid="MAT 6:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28"/>
    <char style="wj">“እስን ማሊፍ ዋኤ ኡፈታ ያዶፍቱ? ደራራወን ድሬ አከምት አከ ጉደተን ሜ እላላ። እሳን ህንዸመአን ዮካን ህንፎአን።</char> <verse eid="MAT 6:28"/><verse number="29" style="v" sid="MAT 6:29"/><char style="wj">አን ገሩ እስንትን ህመ፤ ሶሎሞንዩ ኡልፍነሳ ሁንደ ኬሰት፣ አከ ቶኮሳኒት ህንኡፈትኔ።</char> <verse eid="MAT 6:29"/><verse number="30" style="v" sid="MAT 6:30"/><char style="wj">እስን ያ ወረ አመንቲ ጥኖነነ። ዋቅን ኤርገ መርገ ድሬ ከን ሀርአ ጅሩፊ ከን ቦርሞ እብደት ነቀሙትዩ አከስት ኡፍሴ፣ እስንትሞ ጉዳ ጫልችሴ ህንኡፍሱሬ?</char> <verse eid="MAT 6:30"/><verse number="31" style="v" sid="MAT 6:31"/><char style="wj">ከናፉ፣ ‘ማል ኛትነ?’ ዮካን ‘ማል ዹግነ?’ ዮካን ‘ማል ኡፈትነ?’ ጄተኒ ህንያደእና።</char> <verse eid="MAT 6:31"/><verse number="32" style="v" sid="MAT 6:32"/><char style="wj">ከነ ሁንደ ኦርሞትንዩ ንበርባዱቲ፤ አባንኬሰን እን ሰሚራስ አከ ወን ኩን ሁንድኑ እስን በርባችሱ ንቤከ።</char> <verse eid="MAT 6:32"/><verse number="33" style="v" sid="MAT 6:33"/><char style="wj">ገሩ ዱራን ዱርሳቲ ሞቱማሳቲፊ ቀጄሉማሳ በርባዳ፤ ወን ኩን ሁንድኑ አከሱመ እስኒፍ ኬነመ።</char> <verse eid="MAT 6:33"/><verse number="34" style="v" sid="MAT 6:34"/><char style="wj">ከናፉ ዋኤ ቦሪቲፍ ህንያደእና፤ ቦር ኦፊሳቲፍ ንያደኣቲ። ሀምን ጉያ ሰና መታንሳ ጉይቸ ንገአ።</char><verse eid="MAT 6:34"/></para>
  <chapter eid="MAT 6"/>
  <chapter number="7" style="c" sid="MAT 7"/>
  <para style="s1">ነመ ካንት ሙሩ</para>
  <para style="r">
    <ref loc="MAT 7:3-5">7፥3‑5</ref> ኩወፈ – <char style="xt"><ref loc="LUK 6:41">ሉቃ 6፥41</ref>፣<ref loc="LUK 6:42">42</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1"/>
    <char style="wj">“አከ እስንት ህንሙረምኔፍ ነሞተ ካንት ህንሙርና።</char> <verse eid="MAT 7:1"/><verse number="2" style="v" sid="MAT 7:2"/><char style="wj">ሙርቲዹመ እስን ነመት ሙርተኒን እስንት ሙረማቲ፤ ሰፈርቱ እቲን ሰፈርተኒንስ እስኒፍ ሰፈረመ።</char><verse eid="MAT 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 7:3"/>
    <char style="wj">“አት ማሊፍ ጅርመ እጀኬ ኬሰ ጅሩ አርጉ ዺፍቴ ሁበ እጀ ኦቦሌሰኬቲ ኬሰ ጅሩ እላልተ?</char> <verse eid="MAT 7:3"/><verse number="4" style="v" sid="MAT 7:4"/><char style="wj">አት ኡቱ ጅርም እጀኬ ኬሰ ጅሩ አከምት ኦቦሌሰኬቲን፣ ‘ኮቱ ሜ አን ሁበ እጀኬ ኬሰ ጅሩ ሲፍ ነንባሰ’ ጄቹ ደንዴሰ?</char> <verse eid="MAT 7:4"/><verse number="5" style="v" sid="MAT 7:5"/><char style="wj">ፈኬስቱነነ፤ ዱራን ዱርሲቲ ጅርመ እጀኬ ኬሰ ጅሩ ባፈዹ፤ ኤርገሲስ ሁበ እጀ ኦቦሌሰኬቲ ኬሰ ጅሩ ባሱዻፍ ስሪት አርግተ።</char><verse eid="MAT 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6"/>
    <char style="wj">“ዋን ቁልቁሉ ሰሮታፍ ህንኬንና፤ ሉለኬሰንስ ቦዬ ዱረ ህንቡስና። ዮ ከነ ጎተን እሳን ሚለሳኒቲን ዽዺቱ፤ ገረ ገለንስ እስን ጭጭሩ።</char><verse eid="MAT 7:6"/></para>
  <para style="s1">ከዸዻ፣ በርባዳ፣ በልበለ ሩሩኩታ</para>
  <para style="r">
    <ref loc="MAT 7:7-11">7፥7‑11</ref> ኩወፈ – <char style="xt"><ref loc="LUK 11:9-13">ሉቃ 11፥9‑13</ref></char></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7"/>
    <char style="wj">“ከዸዻ፣ እስኒፍ ንኬነማ፤ በርባዳ፣ ንአርገቱ፤ ሩሩኩታ፣ በልበል እስኒፍ ንበነማ።</char> <verse eid="MAT 7:7"/><verse number="8" style="v" sid="MAT 7:8"/><char style="wj">ነምን ከዸቱ ሁንድ ንአርገታቲ፤ ነምን በርባዱ ንአርገተ፤ ነመ ሩሩኩቱፍስ በልበል ንበነመ።</char><verse eid="MAT 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 7:9"/>
    <char style="wj">“እስን ኬሳ ነምን ዮ እልምሳ ቡዴነ እሰ ከዸቴ፣ ዸጋ ኬኑፍ ኤኙ?</char> <verse eid="MAT 7:9"/><verse number="10" style="v" sid="MAT 7:10"/><char style="wj">ዮካን ዮ እን ቁርጡሚ እሰ ከዸቴ፣ ቦፈ ኬኑፍ ኤኙ?</char> <verse eid="MAT 7:10"/><verse number="11" style="v" sid="MAT 7:11"/><char style="wj">ኤርገ እስን ወር ሀሞንዩ ኬና ጋሪ እጆሌኬሰኒፍ ኬኑ ቤክተኒ፣ አባንኬሰን እን ሰሚራሞ ሀመም ጫልችሴ ወረ እሰ ከዸተኒፍ ኬና ጋሪ ሃኬኑሬ!</char> <verse eid="MAT 7:11"/><verse number="12" style="v" sid="MAT 7:12"/><char style="wj">ከናፉ ዋን አከ ነሞትን እስኒፍ ጎዸን በርባደን ሁንዱማ እስንስ አከሱመ እሳኒፍ ጎዻ፤ ሴርስ ራጆትንስ ከኑማቲ።</char><verse eid="MAT 7:12"/></para>
  <para style="s1">ከረ ዽጳፊ ከረ በልኣ</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13"/>
    <char style="wj">“ከረ ዽጳዻን ሴና። ከራን በዲሰት ጌሱ በልኣዻቲ፤ ከርሳስ በልኣዸ፤ ነሞትን እቲን ሴነንስ ባይኤዸ።</char> <verse eid="MAT 7:13"/><verse number="14" style="v" sid="MAT 7:14"/><char style="wj">ገሩ ከርሳ ዽጳዸ፤ ከራን ጅሬኘት ነመ ጌሱ ቀልኣዸ፤ ወር እሰ አርገተንስ ሙራሰ።</char><verse eid="MAT 7:14"/></para>
  <para style="s1">ሙካፊ እጀሳ</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15"/>
    <char style="wj">“ራጆተ ሶባ ወረ ከልኤ ሆላ ኡፈተኒ ገረኬሰን ዹፈን፣ ከኔን ኬስሳኒ ገሩ ዬዪ አከ መሌ ቤለኤ ዋ ጭጭረቱ ተኤራ ኦፍ ኤገዻ።</char> <verse eid="MAT 7:15"/><verse number="16" style="v" sid="MAT 7:16"/><char style="wj">እስን እጀሳኒቲን እሳን ቤክቱ። ነሞትን ቆራቲራ ወይኒ ዮካን ሶኮሩራ ሀርቡ ንጭሩ?</char> <verse eid="MAT 7:16"/><verse number="17" style="v" sid="MAT 7:17"/><char style="wj">አከሱመስ ሙክን ጋሪን ሁንዱምቱ እጀ ጋሪ ነቀተ፤ ሙክን ገዼንሞ እጀ ገዼ ነቀተ።</char> <verse eid="MAT 7:17"/><verse number="18" style="v" sid="MAT 7:18"/><char style="wj">ሙክን ጋሪን እጀ ገዼ ነቀቹ ህንደንደኡ፤ ሙክን ገዼንስ እጀ ጋሪ ነቀቹ ህንደንደኡ።</char> <verse eid="MAT 7:18"/><verse number="19" style="v" sid="MAT 7:19"/><char style="wj">ሙክን እጀ ጋሪ ህንነቀትኔ ሁንድ ሙረሜ እብደት ነቀመ።</char> <verse eid="MAT 7:19"/><verse number="20" style="v" sid="MAT 7:20"/><char style="wj">ከናፍ እስን እጀሳኒቲን እሳን ቤክቱ።</char><verse eid="MAT 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21"/>
    <char style="wj">“ነመ ፌዺ አባኮ እሰ ሰሚራ ራወቱ መሌ ነምን፣ ‘ያ ጎፍታ፣ ያ ጎፍታ’ ናን ጄዹ ሁንድ ሞቱማ ሰሚት ህንገሉ።</char> <verse eid="MAT 7:21"/><verse number="22" style="v" sid="MAT 7:22"/><char style="wj">ጉያ ሰነ ነሞትን ሄዱን፣ ‘ያ ጎፍታ፣ ያ ጎፍታ፣ ኑ መቃኬቲን ራጂ ዱበትኔረ ምቲ? መቃኬቲን ሀፉሮተ ሀሞ ባፍኔራ ምቲ? መቃኬቲን ድንቂ ሄዱ ሆጄትኔራ ምቲ?’ ናን ጄዹ።</char> <verse eid="MAT 7:22"/><verse number="23" style="v" sid="MAT 7:23"/><char style="wj">አንሞ፣ ‘ነራ ፈጋዻ! እስን ወረ ሀምነ ሆጄተን፣ አን ጎንኩማ እስን ህንቤክኔ’ ጄዼ እፋን እፈት እሳንት ነንህመ።</char><verse eid="MAT 7:23"/></para>
  <para style="s1">እጃርቶተ ኦጌዪፊ ጎዎተ</para>
  <para style="r">
    <ref loc="MAT 7:24-27">7፥24‑27</ref> ኩወፈ – <char style="xt"><ref loc="LUK 6:47-49">ሉቃ 6፥47‑49</ref></char></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24"/>
    <char style="wj">“ከናፉ ነምን ዱቢኮ ከነ ዸገኤ ሆጂዻን አርግሲሱ ሁንድ፣ ነመ ኦጌሰ መነሳ ከታረት እጃረቴ ፈካተ።</char> <verse eid="MAT 7:24"/><verse number="25" style="v" sid="MAT 7:25"/><char style="wj">ቦካን ሮቤ፣ ሎላን ሎለኤ፣ ቡቤንስ ቡብሴ መነ ሰነ ዸኤ፤ መንች ገሩ ዋን ከታረት ሁንዴፈሜፍ ህንጅግኔ።</char> <verse eid="MAT 7:25"/><verse number="26" style="v" sid="MAT 7:26"/><char style="wj">ነምን ዱቢኮ ከነ ዸገኤ ሆጂዻን ህንአርግሲፍኔ ሁንድ ገሩ ነመ ጎዋ መነሳ ጭረቸረት እጃረቴ ፈካተ።</char> <verse eid="MAT 7:26"/><verse number="27" style="v" sid="MAT 7:27"/><char style="wj">ቦካን ሮቤ፣ ሎላን ሎለኤ፣ ቡቤንስ ቡብሴ መንቸ ዸኤ፤ መን ሱንስ ንጅጌ፤ ጅጉንሳስ አከ መሌ ሀማ ቱሬ።”</char><verse eid="MAT 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28"/>ዮሙ ዬሱስ ዱቢ ከነ ዱበቴ ራወቴት ነሞትን በርሲሰሳ ንድንቅሲፈተን፤ <verse eid="MAT 7:28"/><verse number="29" style="v" sid="MAT 7:29"/>እን አከ በርሲስቶተ ሴራት ኡቱ ህንተእን፣ አከ ነመ ታይታ ቀቡ ቶኮት እሳን በርሲሰ ቱሬቲ።<verse eid="MAT 7:29"/></para>
  <chapter eid="MAT 7"/>
  <chapter number="8" style="c" sid="MAT 8"/>
  <para style="s1">ነምቸ ለምጣኣ</para>
  <para style="r">
    <ref loc="MAT 8:2-4">8፥2‑4</ref> ኩወፈ – <char style="xt"><ref loc="MRK 1:40-44">ማር 1፥40‑44</ref>፤ <ref loc="LUK 5:12-14">ሉቃ 5፥12‑14</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1"/>ዬሮ ዬሱስ ጋረራ ቡኤት፣ ቱተ ነሞተ ባይኤቱ እሰ ዱካ ቡኤ። <verse eid="MAT 8:1"/><verse number="2" style="v" sid="MAT 8:2"/>ኩኖ ነምች ለምጣኣን ቶኮስ ዹፌ፣ ፉለሳ ዱረት ጅልቤንፈቴ፣ “ያ ጎፍታ፣ ዮ ፌዺኬ ተኤ፣ አት ነ ቁልቁሌሱ ንደንዴሰ” ጄዼን።<verse eid="MAT 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3"/>ዬሱስስ ሀርከሳ ሂጠቴ ነምቸ ቀቀቤ፣ <char style="wj">“ፌዺኮት፤ ቁልቁላእ!”</char> ጄዼን። ለምጢንሳስ ዬሩመ ሰነ ቁልቁላኤ። <verse eid="MAT 8:3"/><verse number="4" style="v" sid="MAT 8:4"/>ኤርገሲስ ዬሱስ፣ <char style="wj">“ነመ ቶኮትሌ አከ ህንህምኔ ቤከዹ። ገሩ ዸቂቲ አከ እሳኒፍ ረጋ ተኡፍ ሉበት ኦፍ አርግሲስ፤ ኬና ሙሴን አጀጄ ሰነሌ ዽኤስ”</char> ጄዼን።<verse eid="MAT 8:4"/></para>
  <para style="s1">አመንቲ አጀጃ ዽባ</para>
  <para style="r">
    <ref loc="MAT 8:5-13">8፥5‑13</ref> ኩወፈ – <char style="xt"><ref loc="LUK 7:1-10">ሉቃ 7፥1‑10</ref></char></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5"/>ዬሮ ዬሱስ ቅፍርናሆም ሴኔት፣ አጀጃን ዽባ ቶኮ ገረሳ ዹፌ አከነ ጄዼ እሰ ከዸቴ፤ <verse eid="MAT 8:5"/><verse number="6" style="v" sid="MAT 8:6"/>“ያ ጎፍታ፣ ተጃጅላንኮ ዸግን እረት ዱኤ መነ ጪሰ፤ አከ መሌስ ዽጰቻ ጅረ።”<verse eid="MAT 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7"/>ዬሱስስ፣ <char style="wj">“አን ዹፌን እሰ ፈይሰ”</char> ጄዼን።<verse eid="MAT 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8"/>አጀጃን ዽባ ሱንሞ አከነ ጄዼ ዴብሴፍ፤ “ያ ጎፍታ፣ አት በንቲ መነኮቲ ጀለ ሴኑን ናፍ ህንመሉ። ገሩ ዱብቸ ቆፈ ዱበዹ፤ ተጃጅላንኮ ንፈያቲ። <verse eid="MAT 8:8"/><verse number="9" style="v" sid="MAT 8:9"/>አን መታንኮዩ ነመ ታይታ ጀለ ጅሩዸ፤ ሎልቶተስ ኦፍ ጀላ ቀበ። እሰ ቶኮን፣ ‘ዴም’ ነንጄዸ፤ እንስ ንዴመ፤ እሰ ካኒንሞ፣ ‘ኮቱ’ ነንጄዸ፤ እንስ ንዹፈ። ተጃጅላኮቲንስ፣ ‘ዋን ከነ ሆጄዹ’ ነንጄዸ፤ እንስ ንሆጄተ።”<verse eid="MAT 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10"/>ዬሱስ ዮሙ ዋን ከነ ዸገኤት ድንቅፈቴ ወረ እሰ ዱካ ቡኣ ቱረኒን አከነ ጄዼ፤ <char style="wj">“አን ዹጉመ እስንትን ህመ፤ አን እስራኤል ኬሰት ነመ አመንቲ ጉዳ አከና ቀቡ ቶኮሌ ህንአርገትኔ።</char> <verse eid="MAT 8:10"/><verse number="11" style="v" sid="MAT 8:11"/><char style="wj">አን እስንትን ህመ፤ ነሞትን ሄዱን በአ ቢፍቱቲፊ ልጠ ቢፍቱቲ ንዹፉ፤ እሳንስ አብረሃም፣ ይስሃቂፊ ያቆብ ወጅን ሞቱማ ሰሚ ኬሰት ማዲት ንዽኣቱ።</char> <verse eid="MAT 8:11"/><verse number="12" style="v" sid="MAT 8:12"/><char style="wj">እጆሌን ሞቱማ ገሩ ዱከነ አላት ገድ ደርበተሙ፤ አችት ቦኡፊ እልካን ቀሩቱ ተአ።”</char><verse eid="MAT 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13"/>ዬሱስስ ዴብሴ አጀጃ ዽባ ሰናን፣ <char style="wj">“አኩመ አመንቲኬቲ ሲፍ ሃተኡ፤ ዴም!”</char> ጄዼ። ተጃጅላንሳስ ዬሩመ ሰነ ፈዬ።<verse eid="MAT 8:13"/></para>
  <para style="s1">ዬሱስ ነመ ሄዱ ፈይሱሳ</para>
  <para style="r">
    <ref loc="MAT 8:14-16">8፥14‑16</ref> ኩወፈ – <char style="xt"><ref loc="MRK 1:29-34">ማር 1፥29‑34</ref>፤ <ref loc="LUK 4:38-41">ሉቃ 4፥38‑41</ref></char></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14"/>ዬሱስ ዮሙ መነ ጴጥሮስ ሴኔት፣ ሃት ኒቲ ጴጥሮስ ዹኩበ ዸግነ ጉባዻን ቀበምቴ ጪፍቴ አርጌ። <verse eid="MAT 8:14"/><verse number="15" style="v" sid="MAT 8:15"/>እንስ ሀርከሼ ቱቄ፤ ዸግነ ጉባን ሱንስ እሼ ዺሴ፤ እሼንስ ካቴ እሰ ተጃጅሉ ጀልቀብዴ።<verse eid="MAT 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16"/>ገልገለ ሰነስ ነሞተ ሀፉሮተ ሀሞን ቀበመን ሄዱ ገረሳ ፍደን፤ እንስ ጄቸ ቶኮን ሀፉሮተ ሰነ ባሴ፤ ዹኩብሰቶተ ሁንዱማ ንፈይሴ። <verse eid="MAT 8:16"/><verse number="17" style="v" sid="MAT 8:17"/>ኩንስ አከ ዱቢን ከራ እሳያስ ራጅቻቲን፣</para>
  <para style="q1" vid="MAT 8:17">“እን ዽቤኬኘ ኑራ ፉዼ፤</para>
  <para style="q2" vid="MAT 8:17">ዹኩበኬኘስ ንባቴ”<note caller="+" style="f"><char style="fr" closed="false">8፥17 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 53:4">እሳ 53፥4</ref></char></char></note></para>
  <para style="m" vid="MAT 8:17">ጄዸሜ ሱን ራወተሙፍ ተኤ።<verse eid="MAT 8:17"/></para>
  <para style="s1">ገቲ ዬሱስ ዱካ ቡኡን ነመ ባስሱ</para>
  <para style="r">
    <ref loc="MAT 8:19-22">8፥19‑22</ref> ኩወፈ – <char style="xt"><ref loc="LUK 9:57-60">ሉቃ 9፥57‑60</ref></char></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18"/>ዬሱስ ዮሙ ቱተ ነሞተ ባይኤ ናኖሳት አርጌት አከ ገመ ጬአኒፍ አጀጄ። <verse eid="MAT 8:18"/><verse number="19" style="v" sid="MAT 8:19"/>በርሲሳን ሴራ ቶኮስ ገረሳ ዹፌ፣ “ያ በርሲሳ፣ አን እዶ አት ዸቅጡ ሁንደት ስ ዱካ ነንቡአ” ጄዼ።<verse eid="MAT 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20"/>ዬሱስስ ዴብሴ፣ <char style="wj">“ዋንጎትን ቦለ ቀቡ፤ ስምብሮትንስ መንኤ ቀቡ፤ እልም ነማ ገሩ እዶ እት መታሳ እርክፈቱሌ ህንቀቡ”</char> ጄዼ።<verse eid="MAT 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21"/>በረቶተሳ ኬሳስ እን ቶኮ፣ “ያ ጎፍታ፣ ዱረ አከ አን ዸቄ አባኮ አዋለዹ ናፍ ኤየም!” ጄዼን።<verse eid="MAT 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22"/>ዬሱስ ገሩ፣ <char style="wj">“ወር ዱአን ዱኣሳኒ ሃአዋለተን፤ አትሞ ነ ዱካ ቡእ”</char> ጄዼን።<verse eid="MAT 8:22"/></para>
  <para style="s1">ዬሱስ ቡቤ ጀባ ገብ ጎቹሳ</para>
  <para style="r">
    <ref loc="MAT 8:23-27">8፥23‑27</ref> ኩወፈ – <char style="xt"><ref loc="MRK 4:36-41">ማር 4፥36‑41</ref>፤ <ref loc="LUK 8:22-25">ሉቃ 8፥22‑25</ref></char></para>
  <para style="r">
    <ref loc="MAT 8:23-27">8፥23‑27</ref> ኩወእ – <char style="xt"><ref loc="MAT 14:22-33">ማቴ 14፥22‑33</ref></char></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23"/>ዮሙ እን ብድሩ ያበቴትስ፣ በረቶትንሳ እሰ ዱካ ቡአን። <verse eid="MAT 8:23"/><verse number="24" style="v" sid="MAT 8:24"/>አኩመ ተሳ ቡቤን ሀማን ቶኮ ገላነረት ከኤ፤ ደምበሊንስ ብድሩ ሰነረ ገረ ገሌ። ዬሱስ ገሩ ረፋ ቱሬ። <verse eid="MAT 8:24"/><verse number="25" style="v" sid="MAT 8:25"/>በረቶትንሳ ገረሳ ዹፈኒ፣ “ያ ጎፍታ፣ ኑ ኦልች! ኑ ዹሙፊ” ጄዸኒ እሰ ደመቅሰን።<verse eid="MAT 8:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26"/>እንስ ዴብሴ፣ <char style="wj">“እስን ወረ አመንቲ ጥኖነነ፤ ማሊፍ አከነ ሶዳቱ?”</char> ጄዼን። ከኤስ ቡቤ ሰናፊ ገላነ ሰነ እፈቴ፤ ተስገቢን ጉዳንስ ንተኤ።<verse eid="MAT 8:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27"/>ነሞትንስ ድንቅፈተኒ፣ “ነምን ቡቤፊ ገላን አጀጀመኒፍ ኩን ነመ አከሚት?” ጄዸን።<verse eid="MAT 8:27"/></para>
  <para style="s1">ዬሱስ ነሞተ ሀፉረ ሀማን ቀበመን ፈይሱሳ</para>
  <para style="r">
    <ref loc="MAT 8:28-34">8፥28‑34</ref> ኩወፈ – <char style="xt"><ref loc="MRK 5:1-17">ማር 5፥1‑17</ref>፤ <ref loc="LUK 8:26-37">ሉቃ 8፥26‑37</ref></char></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28"/>ዮሙ ዬሱስ ገመ ጬኤ ብየ ገደሬን ገኤት፣ ነሞትን ሀፉረ ሀማን ቀበመን ለመ እዶ አዋላቲ በአኒ እት ዹፈን። እሳንስ ዋን አከ መሌ ሀሞ ቱረኒፍ ነምን ቶኮዩ ከራ ሰነረ ደርቡ ህንደንደኡ ቱሬ። <verse eid="MAT 8:28"/><verse number="29" style="v" sid="MAT 8:29"/>እሳንስ፣ “ያ እልመ ዋቃ፣ አት ማል ኑራ በርባደ? ኡቱ ዬሮን ሱን ህንገእን ኑ ዽጵሱ ዹፍቴሞ?” ጄዸኒ እየን።<verse eid="MAT 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30"/>ሆማን ቦዬ ጉዳንሳስ ጥኖ እሳንራ ፈጋቴ ዼዳ ቱሬ። <verse eid="MAT 8:30"/><verse number="31" style="v" sid="MAT 8:31"/>ሀፉሮትን ሀሞን ሱንስ፣ “ዮ ኑ ባፍቴ፣ ገረ ሆማ ቦዬ ሰናት ኑ ኤርግ” ጄዸኒ ዬሱስን ከዸተን።<verse eid="MAT 8:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32"/>እንስ፣ <char style="wj">“ዸቃ!”</char> ጄዼን። እሳንስ ነምቸ ኬሳ በአኒ ሆማ ቦዬ ሰነት ገለን፤ ሆማን ሱን ጉቱንስ ኤዴደ ሀለያራ ገድ ጉገቴ ገላነት ነምኤ ብሻን ኬሰት ዹሜ። <verse eid="MAT 8:32"/><verse number="33" style="v" sid="MAT 8:33"/>ወር ቦዬወን ትክሰን ሱንስ በቀተኒ መጋላ ሴነን፤ እሳንስ ዋን ሁንደ፣ ዋን ነሞተ ሀፉሮተ ሀሞን ቀበመኒ ቱረንረ ገኤስ ንኦዴሰን። <verse eid="MAT 8:33"/><verse number="34" style="v" sid="MAT 8:34"/>መጋላን ሱን ጉቱንስ ዬሱስን አርጉፍ በኤ። ዮሙ እሰ አርጌትስ አከ እን ብየሳኒ ኬሳ በኡፍ እሰ ከዸቴ።<verse eid="MAT 8:34"/></para>
  <chapter eid="MAT 8"/>
  <chapter number="9" style="c" sid="MAT 9"/>
  <para style="s1">ዬሱስ ነመ ዸግን እረት ዱኤ ፈይሱሳ</para>
  <para style="r">
    <ref loc="MAT 9:2-8">9፥2‑8</ref> ኩወፈ – <char style="xt"><ref loc="MRK 2:3-12">ማር 2፥3‑12</ref>፤ <ref loc="LUK 5:18-26">ሉቃ 5፥18‑26</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1"/>ዬሱስ ብድሩ ያበቴ ገላነ ጬኤ ገረ መጋላሳ ዹፌ። <verse eid="MAT 9:1"/><verse number="2" style="v" sid="MAT 9:2"/>ኩኖ፣ ጀር ቶኮ ነመ ዸግን እረት ዱኤ ስሬረ ጪሱ ቶኮ ገረሳ ፍደን። ዬሱስስ ዮሙ አመንቲሳኒ አርጌት ነምቻን፣ <char style="wj">“እልመኮ ጀባዹ፤ ጩቡንኬ ሲፍ ዺፈሜራቲ”</char> ጄዼ።<verse eid="MAT 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3"/>ከነረት በርሲስቶተ ሴራ ኬሳ ቶኮ ቶኮ ገራሳኒ ኬሰት፣ “ኩኖ፣ ነምች ኩን ዋቀ አረብሰ!” ጄዸን።<verse eid="MAT 9:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4"/>ዬሱስስ ያደሳኒ ቤኬ አከነ ጄዼ፤ <char style="wj">“እስን ማሊፍ ገራኬሰን ኬሰት ዋን ሀማ ያዱ?</char> <verse eid="MAT 9:4"/><verse number="5" style="v" sid="MAT 9:5"/><char style="wj">‘ጩቡንኬ ሲፍ ዺፈሜረ’ ጄቹሞ ‘ከኢ ዴም’ ጄቹቱ ሰልጳዸ?</char> <verse eid="MAT 9:5"/><verse number="6" style="v" sid="MAT 9:6"/><char style="wj">አን ገሩ አከ እልም ነማ ጩቡ ነማፍ ዺሱዻፍ ለፈረት ታይታ ቀቡ አከ ቤክተን ነንበርባደ።”</char> ከናፉ እን ነምቸ ዸግን እረት ዱኤ ሰናን፣ <char style="wj">“ከእ፤ ስሬኬ ፉዸዹቲ መነኬት ገል”</char> ጄዼ። <verse eid="MAT 9:6"/><verse number="7" style="v" sid="MAT 9:7"/>ነምችስ ከኤ መነሳት ገሌ። <verse eid="MAT 9:7"/><verse number="8" style="v" sid="MAT 9:8"/>ነሞትንስ ዮሙ ዋን ከነ አርገንት ንድንቅፈተን፤ ዋቀ ታይታ አከሲ ነማፍ ኬኔፍስ ኡልፍነ ኬነን።<verse eid="MAT 9:8"/></para>
  <para style="s1">ዋመሙ ማቴዎስ</para>
  <para style="r">
    <ref loc="MAT 9:9-13">9፥9‑13</ref> ኩወፈ – <char style="xt"><ref loc="MRK 2:14-17">ማር 2፥14‑17</ref>፤ <ref loc="LUK 5:27-32">ሉቃ 5፥27‑32</ref></char></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9"/>ዬሱስ አቺ ከኤ ኡቱ ዴሙ ነምቸ ማቴዎስ ጄዸሙ ቶኮ ኡቱ እን እዶ እት ቀረጠ ወልት ቀበን ታኡ አርጌ፣ <char style="wj">“ነ ዱካ ቡእ”</char> ጄዼን። ማቴዎስስ ከኤ እሰ ዱካ ቡኤ።<verse eid="MAT 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10"/>ዬሮ ዬሱስ መነ ማቴዎስት እርባተ ኛቻ ቱሬት፣ ቀረጦትኒፊ ጩበሞትን ባይኤን ዹፈኒ እሳፊ በረቶተሳ ወጅን ኛተን። <verse eid="MAT 9:10"/><verse number="11" style="v" sid="MAT 9:11"/>ፈሪሶትን ዮሙ ዋን ከነ አርገንት፣ “በርሲሳንኬሰን ማሊፍ ቀረጦታፊ ጩበሞተ ወጅን ኛተ?” ጄዸኒ በረቶተሳ ጋፈተን።<verse eid="MAT 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12"/>ዬሱስሞ ዋን ከነ ዸጌኛን አከነ ጄዼ፤ <char style="wj">“ኦጌስ ፈያ ወረ ዹኩብሰተኒፍ መሌ ወረ ፈያ ቀበኒፍ ህንበርባችሱ።</char> <verse eid="MAT 9:12"/><verse number="13" style="v" sid="MAT 9:13"/><char style="wj">ገሩ ዸቃቲ ዱቢን፣ ‘አን አራረን ፌዸ መሌ ኣርሳ ህንፌዹ’</char><note caller="+" style="f"><char style="fr" closed="false">9፥13 </char><char style="ft" closed="false"><char style="xt"><ref loc="HOS 6:6">ሆሴ 6፥6</ref></char></char></note> <char style="wj">ጄዹ ሱን ማል ጄቹ አከ ተኤ ሁበዻ። አን ጩበሞተ ዋሙፍን ዹፌ መሌ ቀጄልቶተ ዋሙፍ ህንዹፍኔቲ።”</char><verse eid="MAT 9:13"/></para>
  <para style="s1">ጋፊ ዋኤ ሶማ</para>
  <para style="r">
    <ref loc="MAT 9:14-17">9፥14‑17</ref> ኩወፈ – <char style="xt"><ref loc="MRK 2:18-22">ማር 2፥18‑22</ref>፤ <ref loc="LUK 5:33-39">ሉቃ 5፥33‑39</ref></char></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14"/>በረቶትን ዮሀንስ ዹፈኒ፣ “ሰበቢን ኡቱ ኑፊ ፈሪሶትን ሶምኑ፣ በረቶትንኬ ህንሶምኔፍ ማል?” ጄዸኒ እሰ ጋፈተን።<verse eid="MAT 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15"/>ዬሱስሞ አከነ ጄዼ ዴብሴ፤ <char style="wj">“ኬሱሞትን ምስርቻ አከሚን ኡቱ እን እሳን ወጅን ጅሩ ገዱ ደንደኡ? ዬሮን እት ምስርች እሳን ብራ ፉዸተሙ ንዹፈ፤ እሳንስ ዬሮ ሰነ ንሶሙ።</char><verse eid="MAT 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16"/>
    <char style="wj">“ነምን ኡፈተ ሞፋረት ኤርቤ ሃራ ኤርቡ ቶኮሌ ህንጅሩ፤ ኤርቤን ሱን ኡፈተ ሰነ እራ ተርሳሳቲ፤ ተርሰኣን ሱንስ እሰ ዱራ ንጫለ።</char> <verse eid="MAT 9:16"/><verse number="17" style="v" sid="MAT 9:17"/><char style="wj">አከሱመሞ ነሞትን ዳዺ ወይኒ ሃራ ቀልቀሎ ሞፋት ህንነቀን። ዮ እሳን እት ነቀን ቀልቀልች ንዾአ፤ ዳዺንስ ንዸንገለአ፤ ቀልቀሎንስ ሆሮማ በአ። ዳዺን ወይኒ ሃራን ገሩ ዮ ቀልቀሎ ሃራት ነቀሜ ለቸኑ ዬሮ ዼራ ቱሩ።”</char><verse eid="MAT 9:17"/></para>
  <para style="s1">እንተለ ዱቴፊ ዱበርቲ ዹኩብሰቴ</para>
  <para style="r">
    <ref loc="MAT 9:18-26">9፥18‑26</ref> ኩወፈ – <char style="xt"><ref loc="MRK 5:22-43">ማር 5፥22‑43</ref>፤ <ref loc="LUK 8:41-56">ሉቃ 8፥41‑56</ref></char></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18"/>ኡቱ እን ዋን ከነ ዱበቻ ጅሩ፣ ቡልቻን መነ ሰገዳ ቶኮ ዹፌ ፉለሳ ዱረት ጅልቤንፈቴ፣ “እንተልኮ አሙመ ነ ዱራ ዱቴ። ገሩ ኮቱቲ ሀርከኬ እሼረ ካእ፤ እሼንስ ንጅራቲ” ጄዼን። <verse eid="MAT 9:18"/><verse number="19" style="v" sid="MAT 9:19"/>ዬሱስ ከኤ በረቶተሳ ወጅን እሰ ዱካ ቡኤ።<verse eid="MAT 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20"/>ኩኖ፣ ዱበርቲን ዺግንሼ ወጋ ኩዸ ለመ ዸንገለኣ ቱሬ ቶኮ ዱግደ ዱባን ዹፍቴ ሀንዳረ ኡፈተሳ ቱቅጤ። <verse eid="MAT 9:20"/><verse number="21" style="v" sid="MAT 9:21"/>እሼንስ ገራሼ ኬሰት፣ “አን ዮን ኡፈቱመሳሌ ቱቄ ነንፈየ” ጄቴ ያዴ ቱርቴቲ።<verse eid="MAT 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22"/>ዬሱስስ ገረ ገሌ እሼ እላሌ፣ <char style="wj">“ያ እንተላ፣ አመንቲንኬ ስ ፈይሴራቲ ጀባዹ!”</char> ጄዼን። ዱበርቲን ሱንስ ዬሩመ ሰነ ፈይቴ።<verse eid="MAT 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23"/>ዬሱስስ ዮሙ መነ ቡልቻ መነ ሰገዳ ሰና ሴኔ ወረ ኡሉሌ አፉፈኒፊ ኡመተ ወጩ አርጌት፣ <verse eid="MAT 9:23"/><verse number="24" style="v" sid="MAT 9:24"/><char style="wj">“አሲ ዴማ! እንተለቲን ረፍቴርት መሌ ህንዱኔ”</char> ጄዼ። እሳን ገሩ እሰት ኮልፈን። <verse eid="MAT 9:24"/><verse number="25" style="v" sid="MAT 9:25"/>ኤርገ ነሞትን ገድ ባፈመኒ ቦዴስ እን ኦል ሴኔ ሀርከ እንተለቲ ቀቤ፤ እሼንስ ካቴ ዻበቴ። <verse eid="MAT 9:25"/><verse number="26" style="v" sid="MAT 9:26"/>ኦዱን ዋኤ ከናስ ብየ ሰነ ጉቱ ኬሰ ፈጨኤ።<verse eid="MAT 9:26"/></para>
  <para style="s1">ዬሱስ ጃሞተ ለመ ፈይሱሳ</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27"/>ዬሱስ ኡቱ አቺ ከኤ ዴማ ጅሩ፣ ጃሞትን ለመ እሰ ዱካ ቡአኒ፣ “ያ እልመ ዳዊት ኑ ማር!” ጄዸኒ እየን።<verse eid="MAT 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28"/>ዮሙ እን መነ ሴኔትስ ጃሞትን ሱን ገረሳ ዹፈን፤ እንስ፣ <char style="wj">“አከ አን ዋን ከነ ጎቹ ደንደኡ ንአመንቱሬ?”</char> ጄዼ እሳን ጋፈቴ።</para>
  <para style="p" vid="MAT 9:28">እሳንስ፣ “ኤዬ፣ ያ ጎፍታ!” ጄዸኒ ዴብሰኒፍ።<verse eid="MAT 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29"/>ዬሱስስ እጀሳኒ ቀቀቤ፣ <char style="wj">“አኩመ አመንቲኬሰኒ እስኒፍ ሃተኡ”</char> ጄዼን። <verse eid="MAT 9:29"/><verse number="30" style="v" sid="MAT 9:30"/>እጅሳኒስ ንበነሜ። ዬሱስስ፣ <char style="wj">“አከ ነምን ቶኮዩ ዋን ከነ ህንቤክኔ ኦፍ ኤገዻ”</char> ጄዼ ጀቤሴ እሳን አኬከቺሴ። <verse eid="MAT 9:30"/><verse number="31" style="v" sid="MAT 9:31"/>ጀር ገሩ አቺ በአኒ ብየ ሰነ ሁንደ ኬሰት ዋኤሳ ኦዴሰን።<verse eid="MAT 9:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32"/>ኡቱ እሳን ገድ በኡት ጅረኑ ጀር ቶኮ ነመ ሀፉረ ሀማዻን ቀበሜ ዱበቹ ህንደንዴኜ ቶኮ ዬሱስት ፍደን። <verse eid="MAT 9:32"/><verse number="33" style="v" sid="MAT 9:33"/>ነምች ሱንስ ኤርገ ሀፉር ሀማን እሰ ኬሳ ባፈሜ ቦዴ ንዱበቴ። ነሞትንስ፣ “ወን አከና ጎንኩማ እስራኤል ኬሰት ህንአርገምኔ” ጄዸኒ ድንቅፈተን።<verse eid="MAT 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34"/>ፈሪሶትን ገሩ፣ “እን ሀንገፈ ሀፉሮተ ሀሞቲን ሀፉሮተ ሀሞ ባሰ” ጄዸን።<verse eid="MAT 9:34"/></para>
  <para style="s1">ሆጄቶትን ሙራሰ</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35"/>ዬሱስ መኔን ሰገዳሳኒ ኬሰት በርሲሳ፣ ወንጌለ ሞቱማ ለለባ፣ አከሱመስ ዽቤፊ ዹኩበ ሁንደራ ነሞተ ፈይሳ መጋላወኒፊ ገንዶተ ሁንደ ኬሰ ዴሜ። <verse eid="MAT 9:35"/><verse number="36" style="v" sid="MAT 9:36"/>እንስ ዮሙ ቱተ ነሞታ አርጌት ገራ ላፌፍ፤ እሳን አኩመ ሆሎተ ትክሴ ህንቀብኔት ዽጰተኒ፣ ገተመኒስ ቱረኒቲ። <verse eid="MAT 9:36"/><verse number="37" style="v" sid="MAT 9:37"/>በረቶተሳቲንስ አከነ ጄዼ፤ <char style="wj">“ምዻን ወልት ቀበሙ ባይኤዸ፤ ሆጄቶትን ገሩ ሙራሰ።</char> <verse eid="MAT 9:37"/><verse number="38" style="v" sid="MAT 9:38"/><char style="wj">ከናፍ አከ ጎፍታን ምዻን ሰና ገረ ለፈ ቆቲሳ ምዻንሳት ሆጄቶተ ኤርጉፍ እሰ ከዸዻ።”</char><verse eid="MAT 9:38"/></para>
  <chapter eid="MAT 9"/>
  <chapter number="10" style="c" sid="MAT 10"/>
  <para style="s1">ዬሱስ በረቶተ ኩዸ ለማን ኤርጉሳ</para>
  <para style="r">
    <ref loc="MAT 10:2-4">10፥2‑4</ref> ኩወፈ – <char style="xt"><ref loc="MRK 3:16-19">ማር 3፥16‑19</ref>፤ <ref loc="LUK 6:14-16">ሉቃ 6፥14‑16</ref>፤ <ref loc="ACT 1:13">ሆጂ 1፥13</ref></char></para>
  <para style="r">
    <ref loc="MAT 10:9-15">10፥9‑15</ref> ኩወፈ – <char style="xt"><ref loc="MRK 6:8-11">ማር 6፥8‑11</ref>፤ <ref loc="LUK 9:3-5">ሉቃ 9፥3‑5</ref>፤ <ref loc="LUK 10:4-12">10፥4‑12</ref></char></para>
  <para style="r">
    <ref loc="MAT 10:19-22">10፥19‑22</ref> ኩወፈ – <char style="xt"><ref loc="MRK 13:11-13">ማር 13፥11‑13</ref>፤ <ref loc="LUK 21:12-17">ሉቃ 21፥12‑17</ref></char></para>
  <para style="r">
    <ref loc="MAT 10:26-33">10፥26‑33</ref> ኩወፈ – <char style="xt"><ref loc="LUK 12:2-9">ሉቃ 12፥2‑9</ref></char></para>
  <para style="r">
    <ref loc="MAT 10:34">10፥34</ref>፣<ref loc="MAT 10:35">35</ref> ኩወፈ – <char style="xt"><ref loc="LUK 12:51-53">ሉቃ 12፥51‑53</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1"/>ዬሱስ በረቶተሳ ኩዸ ለማን ኦፍት ዋሜ አከ እሳን ሀፉሮተ ጡራኦ ባሰኒፍ፣ ዽቤፊ ዹኩበ ሁንዱማ አከ ፈይሰኒፍ ታይታ ኬኔፍ።<verse eid="MAT 10:1"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="2" style="v" sid="MAT 10:2"/>መቃን ኤርገሞተ ኩዸ ለማኒስ ከነ፦</para>
  <para style="b" vid="MAT 10:2"/>
  <para style="li1" vid="MAT 10:2">ጀልቀበት ስሞን እሰ ጴጥሮስ ጄዸሙፊ ኦቦሌሰሳ እንድሪያስ፣</para>
  <para style="li1" vid="MAT 10:2">ያቆብ እልመ ዘብዴዎሲፊ ኦቦሌሰሳ ዮሀንስ፣<verse eid="MAT 10:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="MAT 10:3"/>ፊልጶስ፣ በርተሎሜዎስ፣</para>
  <para style="li1" vid="MAT 10:3">ቶማስ፣ ማቴዎስ እሰ ቀረጠ ወልት ቀቡ፣</para>
  <para style="li1" vid="MAT 10:3">ያቆብ እልመ እልፍዮሲፊ ታዴዎስ፣<verse eid="MAT 10:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="MAT 10:4"/>ስሞን ህናፍትቸ፣ ይሁዳ አስቆሮትቸ እሰ ዬሱስን ደበርሴ ኬኔ።<verse eid="MAT 10:4"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5"/>ዬሱስስ ወረ ኩዸ ለማን ከኔን ኤርጌ፤ አከነስ ጄዼ እሳን አጀጄ፤ <char style="wj">“ገረ ነሞተ ኦርማ ህንዸቅና፤ መጋላወን ሰማርያ ቶኮሌ ህንሴንና።</char> <verse eid="MAT 10:5"/><verse number="6" style="v" sid="MAT 10:6"/><char style="wj">ቆደ ከና ገረ ሆሎተ መነ እስራኤል ከኔን በደን ሰና ዸቃ።</char> <verse eid="MAT 10:6"/><verse number="7" style="v" sid="MAT 10:7"/><char style="wj">ዮሙ ዸቅጠንትስ፣ ‘ሞቱማን ሰሚ ዽኣቴረ’ ጄዻ ለለባ።</char> <verse eid="MAT 10:7"/><verse number="8" style="v" sid="MAT 10:8"/><char style="wj">ዹኩብሰቶተ ፈይሳ፤ ወረ ዱአን ካሳ፤ ወረ ለምጣአን ቁልቁሌሳ፤ ሀፉሮተ ሀሞ ባሳ። ቶለ ዋን አርገተኒፍ ቶሉመ ኬና።</char><verse eid="MAT 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 10:9"/>
    <char style="wj">“ሰበተኬሰንት ወርቄ ዮካን ሜቲ ዮካን ስቢለ ዲማ ህንቀበትና፤</char> <verse eid="MAT 10:9"/><verse number="10" style="v" sid="MAT 10:10"/><char style="wj">ከራኬሰኒፍ ኮሮጆ ዮካን ክታ ለመ ዮካን ኮጴ ዮካን ኡሌ ህንቀበትና፤ ሆጄታፍ ዋን እሰ በርባችሱ አርገቹን ንመላቲ።</char> <verse eid="MAT 10:10"/><verse number="11" style="v" sid="MAT 10:11"/><char style="wj">መጋላ ዮካን ገንደ ሴንተን ከምዩ ኬሰ ነመ መሉ በርባዳ፤ ሀመ አቺ ባተንትስ መኑመሳ ቱራ።</char> <verse eid="MAT 10:11"/><verse number="12" style="v" sid="MAT 10:12"/><char style="wj">ዮሙ መነ ሰነ ሴንተንትስ ነጋ ጋፈዻ።</char> <verse eid="MAT 10:12"/><verse number="13" style="v" sid="MAT 10:13"/><char style="wj">ነጋንኬሰን ዮ መነ ሰናፍ መሌ፣ መነ ሰናፍ ሃተኡ፤ ዮ እሳፍ ህንመልን ገሩ ነጋንኬሰን እስኒፍ ሃዴብኡ።</char> <verse eid="MAT 10:13"/><verse number="14" style="v" sid="MAT 10:14"/><char style="wj">ዮ ነምን ቶኮሌ እስን ስመቹ ባቴ ዮካን ዱቢኬሰን ዸገኡ ባቴ፣ ዬሮ መነ ዮካን መጋላ ሰና ባተንት አዋረ ሚለኬሰኒ ዸዸአዻ።</char> <verse eid="MAT 10:14"/><verse number="15" style="v" sid="MAT 10:15"/><char style="wj">አን ዹጉመ እስንትን ህመ፤ ጉያ ሙርቲት መጋላ ሰነረ ሶዶሚፊ ጎሞራፍ ንሰልጰተ።</char><verse eid="MAT 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16"/>
    <char style="wj">“ኩኖ፣ አን አከ ሆሎታ ገረ ግዱ ዬዪትን እስን ኤርገ። ከናፉ አከ ቦፋ ኦጌዪ፣ አከ ጉጌ ገራሚ ተኣ።</char> <verse eid="MAT 10:16"/><verse number="17" style="v" sid="MAT 10:17"/><char style="wj">ነሞተራ ኦፍ ኤገዻ፤ እስን ደበርፈምተኒ ያኢት ንኬነምቱ፤ መኔን ሰገዳ ኬሰትስ ንገረፈምቱ።</char> <verse eid="MAT 10:17"/><verse number="18" style="v" sid="MAT 10:18"/><char style="wj">እስንስ አከ እሳኒፊ ነሞተ ኦርማት ዹገ ባቶተ ታተኒፍ አናፍ ጄተኒ ፉለ ቡልችቶታቲፊ ሞቶታ ዱረት ንዽኤፈምቱ።</char> <verse eid="MAT 10:18"/><verse number="19" style="v" sid="MAT 10:19"/><char style="wj">ዮሙ ደበርሰኒ እስን ኬነንስ አከምት አከ ዱበተን ዮካን ማል አከ ዱበተን ህንያደእና። ወን እስን ዱበተን ዬሩመ ሰነት እስኒፍ ኬነመ፤</char> <verse eid="MAT 10:19"/><verse number="20" style="v" sid="MAT 10:20"/><char style="wj">ሀፉረ አባኬሰኒቱ እስን ኬሳ ዱበተ መሌ እስንቱ ዱበተ ምቲ።</char><verse eid="MAT 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21"/>
    <char style="wj">“ኦቦሌስ ደበርሴ ኦቦሌሰ ዱአት ኬነ፤ አባን ደበርሴ እጆሌሳ ዱአት ኬነ፤ እጆሌንስ ወረሳኒት ከአኒ እሳን አጄሱ።</char> <verse eid="MAT 10:21"/><verse number="22" style="v" sid="MAT 10:22"/><char style="wj">ነምን ሁንድኑ ሰበቢኮቲፍ እስን ጅበ፤ ከን ሀመ ዹማት ጀባቴ ዻበቱ ገሩ ንፈየ።</char> <verse eid="MAT 10:22"/><verse number="23" style="v" sid="MAT 10:23"/><char style="wj">ዮሙ መጋላ ቶኮ ኬሰት እስን አርአተንት፣ ገረ መጋላ ካኒት በቀዻ፤ አን ዹጉመ እስንትን ህመ፤ ሀመ እልም ነማ ዹፉት መጋላወን እስራኤል ሁንዱማ ኬሰ ናኖፍተኒ ወሊን ህንጌሰን።</char><verse eid="MAT 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24"/>
    <char style="wj">“በረታን በርሲሳሳቲ ኦል ምት፤ ገርብችስ ጎፍታሳቲ ኦል ምት።</char> <verse eid="MAT 10:24"/><verse number="25" style="v" sid="MAT 10:25"/><char style="wj">በረታን ቶኮ አከ በርሲሳሳ ተኡን፣ ገርብች ቶኮሞ አከ ጎፍታሳ ተኡን ንገአ። ኤርገ አባ መናቲን ‘ብኤልዜቡል’ ጄዸኒ፣ ወረ መነሳ ጅራተኒንሞ ሀመም ከነ ጫላ ሃጄዸንሬ!</char><verse eid="MAT 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26"/>
    <char style="wj">“ከናፉ እሳን ህንሶዳትና። ወን ሀጉገሜ ኡቱ ህንሙልእፈምን ሀፉ ዮካን ወን ዾክፈሜ ኡቱ ህንቤከምን ሀፉ ቶኮዩ ህንጅሩቲ።</char> <verse eid="MAT 10:26"/><verse number="27" style="v" sid="MAT 10:27"/><char style="wj">ዋን አን ዱከነ ኬሰት እስንት ህሙ ጉያ አዲን ኦዴሳ፤ ዋን ጉረት እስንት ሀሳሰን፣ በንቲ መናራ ለብሳ።</char> <verse eid="MAT 10:27"/><verse number="28" style="v" sid="MAT 10:28"/><char style="wj">ወረ ፎን መሌ ሉቡ አጄሱ ህንደንዴኜ ህንሶዳትና። ቆደ ከና እሰ ገሃነም ኬሰት ፎኒፊ ሉቡ በሌሱ ደንደኡ ሰነ ሶዳዻ።</char> <verse eid="MAT 10:28"/><verse number="29" style="v" sid="MAT 10:29"/><char style="wj">ዳሎቴን ለመ ሳንትመ ቶኮት ጉርጉረሙ ምቲ? እሳን ኬሳ ገሩ ቶኮዩ ፌዺ አባኬሰኒ መሌ ለፈ ህንቡቱ።</char> <verse eid="MAT 10:29"/><verse number="30" style="v" sid="MAT 10:30"/><char style="wj">ርፌንስ መታኬሰኒ ሁንድስ ለካአሜረ።</char> <verse eid="MAT 10:30"/><verse number="31" style="v" sid="MAT 10:31"/><char style="wj">ከናፍ ህንሶዳትና፤ እስን ዳሎቴ ሄዱ ጫላ ገቲ ቀብዱቲ።</char><verse eid="MAT 10:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32"/>
    <char style="wj">“ከናፉ ነመ ፉለ ነሞታ ዱረት ዹጋ ና በኡ ከሚፍዩ፣ አንስ ፉለ አባኮ እሰ ሰሚራ ዱረት ዹጋ ነንበአ።</char> <verse eid="MAT 10:32"/><verse number="33" style="v" sid="MAT 10:33"/><char style="wj">ነመ ፉለ ነሞታ ዱረት ነ ገኑ ከምዩ ገሩ አንስ ፉለ አባኮ እሰ ሰሚራ ዱረት ነንገነ።</char><verse eid="MAT 10:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34"/>
    <char style="wj">“እስን ዋን አን ለፈረት ነጋ ቡሱፍ ዹፌ ህንሴእና። አን ጎራዴ ፍዱፍ መሌ ነጋ ቡሱፍ ህንዹፍኔ።</char> <verse eid="MAT 10:34"/><verse number="35" style="v" sid="MAT 10:35"/><char style="wj">አን፣</char></para>
  <para style="q1" vid="MAT 10:35">
    <char style="wj">“ ‘ነመ አባሳት፣</char></para>
  <para style="q2" vid="MAT 10:35">
    <char style="wj">እንተለሞ ሃዸሼት፣</char></para>
  <para style="q1" vid="MAT 10:35">
    <char style="wj">ኒቲ እልማስ አማቲሼት ካሱፍ ዹፌራቲ፤</char><verse eid="MAT 10:35"/></para>
  <para style="q2">
    <verse number="36" style="v" sid="MAT 10:36"/>
    <char style="wj">ዲኖትን ነማ፣ ምሴንሶቱመ መነሳቲ።’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">10፥36 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="MIC 7:6">ሚክ 7፥6</ref>
        </char>
      </char>
    </note><verse eid="MAT 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37"/>
    <char style="wj">“ነምን አባሳ ዮካን ሃዸሳ ነ ጫልችሴ ጃለቱ ከምዩ ናፍ ህንመሉ፤ ነምን እልመሳ ዮካን እንተለሳ ነ ጫልችሴ ጃለቱ ከምዩ ናፍ ህንመሉ።</char> <verse eid="MAT 10:37"/><verse number="38" style="v" sid="MAT 10:38"/><char style="wj">ነምን ፈኖ ኦፊሳ ባዸቴ ነ ዱካ ህንቡኔ ከምዩ ናፍ ህንመሉ።</char> <verse eid="MAT 10:38"/><verse number="39" style="v" sid="MAT 10:39"/><char style="wj">ነምን ሉቡሳ ኦልፈቱ ከምዩ ሉቡሳ ንዸበ፤ ገሩ ነምን ናፍ ጄዼ ሉቡሳ ዸቡ ከምዩ ሉቡሳ ንአርገተ።</char><verse eid="MAT 10:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40"/>
    <char style="wj">“ነምን እስን ስመቱ ነ ስመተ፤ ነምን ነ ስመቱሞ እሰ ነ ኤርጌ ሰነ ስመተ።</char> <verse eid="MAT 10:40"/><verse number="41" style="v" sid="MAT 10:41"/><char style="wj">ነምን ራጂ ቶኮ ሰበቢ እን ራጂ ተኤፍ ስመቱ ከምዩ ገቲ ራጂ ንአርገተ፤ ነምን ነመ ቀጄላ ቶኮ ሰበቢ እን ነመ ቀጄላ ተኤፍ ስመቱ ገቲ ነመ ቀጄላ ቶኮ ንአርገተ።</char> <verse eid="MAT 10:41"/><verse number="42" style="v" sid="MAT 10:42"/><char style="wj">አን ዹጉመን እስንት ህመ፤ ነምን ከምዩ ዮ ወረ ጥጥና ከኔን ኬሳ እሰ ቶኮፍ ሰበቢ እን በረታኮ ተኤፍ ብሻን ቀበናኣ ቡዱቅሳ ቶኮሌ ኬኔ፣ እን ዹጉማን ገቲሳ ህንዸቡ።”</char><verse eid="MAT 10:42"/></para>
  <chapter eid="MAT 10"/>
  <chapter number="11" style="c" sid="MAT 11"/>
  <para style="s1">ዬሱሲፊ ዮሀንስ ጩጳ</para>
  <para style="r">
    <ref loc="MAT 11:2-19">11፥2‑19</ref> ኩወፈ – <char style="xt"><ref loc="LUK 7:18-35">ሉቃ 7፥18‑35</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1"/>ዬሱስ ኤርገ በረቶተሳ ኩዸ ለማኒፍ አጀጀ ኬኑ ራወቴ ቦዴ መጋላወን ገሊላ ኬሰት በርሲሱፊ ለለቡፍ ጄዼ አቺ ከኤ ከራሳ እት ፉፌ።<verse eid="MAT 11:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2"/>ዮሀንስ መነ ህዻ ታኤ ዮሙ ዋን ክርስቶስ ሆጄቻ ቱሬ ዸገኤት በረቶተሳ ኤርጌ፣ <verse eid="MAT 11:2"/><verse number="3" style="v" sid="MAT 11:3"/>“እን ዹፉፍ ጅሩ ሱን ስእሞ ዮካን ከን ብራ ኤገትነ?” ጄዼ እሰ ጋፈቴ።<verse eid="MAT 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4"/>ዬሱስስ አከነ ጄዼ ዴብሴፍ፤ <char style="wj">“ዴብኣቲ ዋን ዸጌሰኒፊ ዋን አርግተን ዮሀንስት ህማ፤</char> <verse eid="MAT 11:4"/><verse number="5" style="v" sid="MAT 11:5"/><char style="wj">ጃሞትን ንአርጉ፤ ወር ናፈተን ንዴሙ፤ ወር ለምጣአን ንቁልቁላኡ፤ ወር ዱደን ንዸገኡ፤ ወር ዱአን ንከኡ፤ ህዬዪፍስ ወንጌል ንለለበመ።</char> <verse eid="MAT 11:5"/><verse number="6" style="v" sid="MAT 11:6"/><char style="wj">ነምን ነት ህንጉፈትኔ ከምዩ ኤብፈማዸ።”</char><verse eid="MAT 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7"/>አኩመ በረቶትን ዮሀንስ በአኒ ቀጄለኒን፣ ዬሱስ አከነ ጄዼ ዋኤ ዮሀንስ ነሞተት ህሙ ጀልቀቤ፤ <char style="wj">“እስን ማል አርጉፍ ገሞጂት ገድ ባተን? ሸምበቆ ቅሌንስ ራሱሞ?</char> <verse eid="MAT 11:7"/><verse number="8" style="v" sid="MAT 11:8"/><char style="wj">ዮስ ማል አርጉ ባተንሬ? ነመ ኡፈተ ሚዸጋ ኡፈቴሞ? ለክ፣ ወር ኡፈተ ሚዸጋ ኡፈተን መሰራ ሞቶታ ጅሩ።</char> <verse eid="MAT 11:8"/><verse number="9" style="v" sid="MAT 11:9"/><char style="wj">ዮስ ማል አርጉ ባተንሬ? ራጂሞ? ኤዬ፤ አን እስንትን ህመ፤ ከን ራጂዩ ጫሉ።</char> <verse eid="MAT 11:9"/><verse number="10" style="v" sid="MAT 11:10"/><char style="wj">ኩንስ እሰ ዋኤንሳ አከነ ጄዸሜ በሬፈሜዸ።</char></para>
  <para style="q1" vid="MAT 11:10">
    <char style="wj">“ ‘ኩኖ፣ አን ኤርገማኮ እሰ ፉለኬ ዱራን</char></para>
  <para style="q2" vid="MAT 11:10">
    <char style="wj">ከራኬ ቆጴሱ፣ ስ ዱረ ነንኤርገ።’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">11፥10 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="MAL 3:1">ሚል 3፥1</ref>
        </char>
      </char>
    </note><verse eid="MAT 11:10"/></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 11:11"/>
    <char style="wj">አን ዹጉመ እስንትን ህመ፤ ነሞተ ዱበርቶተራ ዸለተን ኬሳ ነምን ዮሀንስ ጩጳ ጫሉ ቶኮዩ ህንካኔ፤ ነምን ሞቱማ ሰሚ ኬሰት ነመ ሁንዱማ ገድ ተኤ ከምዩ ገሩ እሰ ንጫለ።</char> <verse eid="MAT 11:11"/><verse number="12" style="v" sid="MAT 11:12"/><char style="wj">ሞቱማን ሰሚ በረ ዮሀንስ ጩጳቲ ጀልቀቤ ሀመ አማት ሁምናን ዺበቻ ጅረ፤ ነሞትን ዺበተንስ ሁምናን ሞቱማ ሰነ አርገቱ።</char> <verse eid="MAT 11:12"/><verse number="13" style="v" sid="MAT 11:13"/><char style="wj">ራጆትን ሁንድኑ፣ ሴርስ ሀመ ዮሀንስ ጩጳት ራጂ ዱበተኒሩቲ።</char> <verse eid="MAT 11:13"/><verse number="14" style="v" sid="MAT 11:14"/><char style="wj">እስንስ ከነ ፉዸቹፍ ዮ ፌዺ ቀባተን፣ እን ኤልያስ እሰ ዹፉፍ ጅሩዸ።</char> <verse eid="MAT 11:14"/><verse number="15" style="v" sid="MAT 11:15"/><char style="wj">ነምን ጉረ ዸገኡ ቀቡ ሃዸገኡ።</char><verse eid="MAT 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16"/>
    <char style="wj">“አን ዸሎተ ከነ ማሊነን ወል ፈኬሱ ደንደአ? እሳን አኩመ እጆሌ እዶ ገባ ታአኒ ወረ ካን ዋመኒ አከነ ጄዸኒት፦</char><verse eid="MAT 11:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17"/>
    <char style="wj">“ ‘ኑ ኡሉሌ እስኒ አፉፍኔ፤</char></para>
  <para style="q2" vid="MAT 11:17">
    <char style="wj">እስን ገሩ ህንስርብኔ፤</char></para>
  <para style="q1" vid="MAT 11:17">
    <char style="wj">ፋሩ ቦእቻስ ፋርስኔ፤</char></para>
  <para style="q2" vid="MAT 11:17">
    <char style="wj">እስን ገሩ ህንቦኜ።’</char><verse eid="MAT 11:17"/></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 11:18"/>
    <char style="wj">ዮሀንስ ዬሮ ዹፌት ህንኛቱ፣ ህንዹጉስ ቱሬቲ፤ እሳንሞ፣ ‘እን ሀፉረ ሀማ ቀበ’ ጄዹ።</char> <verse eid="MAT 11:18"/><verse number="19" style="v" sid="MAT 11:19"/><char style="wj">እልም ነማ ኛቻ፣ ዹጋስ ዹፌ፤ እሳንሞ፣ ‘ኩኖ አልባዼሳፊ መቻኣ፣ ምቹ ቀረጦታቲፊ ጩበሞታ’ ጄዹ። ኦጉማን ገሩ ሆጂሼቲን ምርከኔፈምት።”</char><verse eid="MAT 11:19"/></para>
  <para style="s1">መጋላወን ቀልቢ ህንጅጂረትኔፍ ወዮ</para>
  <para style="r">
    <ref loc="MAT 11:21-23">11፥21‑23</ref> ኩወፈ – <char style="xt"><ref loc="LUK 10:13-15">ሉቃ 10፥13‑15</ref></char></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20"/>ኤርገሲ ዬሱስ ሰበቢ መጋላወን እን እት ሆጂ ድንቂሳ ገረ ጫሉ ሆጄቴ ሱን ቀልቢ ህንጅጂረትኒፍ አከነ ጄዼ እሳን በላሌፈቹ ጀልቀቤ። <verse eid="MAT 11:20"/><verse number="21" style="v" sid="MAT 11:21"/><char style="wj">“ያ ኮራዝን ሲፍ ወዮ! ያ ቤተ ሳይዳ ሲፍ ወዮ! ሆጂን ድንቂ እስን ኬሰት ሆጄተሜ ሱን ኡቱ ጢሮሲፊ ሲዶና ኬሰት ሆጄተሜ ጅራቴ፣ እሳን ስላ ዬሮ ዼራን ዱረ ኡፈተ ገዳ ኡፈተኒ፣ ዳራስ ኦፍት ፍርፍርሰኒ ቀልቢ ጅጂረቱ ቱረን።</char> <verse eid="MAT 11:21"/><verse number="22" style="v" sid="MAT 11:22"/><char style="wj">አን ገሩ እስንትን ህመ፤ ጉያ ሙርቲት እስንረ ጢሮሲፊ ስዶናፍ ንሰልጰተ።</char> <verse eid="MAT 11:22"/><verse number="23" style="v" sid="MAT 11:23"/><char style="wj">አትስ ያ ቅፍርናሆም፣ ሀመ ሰሚት ኦል ካፈምታ? ለክ፣ ሲኦልት ገድ ቡተ። ሆጂን ድንቂ ከን ስ ኬሰት ሆጄተሜ ሱን ኡቱ ሶዶም ኬሰት ሆጄተሜ ጅራቴ፣ እሼን ስላ ሀመ ሀርኣት ንጅራት ቱርቴ።</char> <verse eid="MAT 11:23"/><verse number="24" style="v" sid="MAT 11:24"/><char style="wj">አን ገሩ ስትን ህመ፤ ጉያ ሙርቲት ስረ ሶዶሚፍ ንሰልጰተ።”</char><verse eid="MAT 11:24"/></para>
  <para style="s1">ቦቆና አብደቺፈሜ</para>
  <para style="r">
    <ref loc="MAT 11:25-27">11፥25‑27</ref> ኩወፈ – <char style="xt"><ref loc="LUK 10:21">ሉቃ 10፥21</ref>፣<ref loc="LUK 10:22">22</ref></char></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25"/>ዬሱስ ዬሮ ሰነ አከነ ጄዼ፤ <char style="wj">“ያ አባ፣ ጎፍታ ሰሚቲፊ ለፋ፣ ሰበቢ አት ወንቶተ ከኔን ኦጌዪፊ ሁበቶተ ጀላ ዾክስቴ ዳእመንት ሙልእፍቴፍ አን ስን ገለቴፈዸ።</char> <verse eid="MAT 11:25"/><verse number="26" style="v" sid="MAT 11:26"/><char style="wj">ኤዬ ያ አባ፣ አት ዋን ከነ ጎቹት ገመዴርታቲ።</char><verse eid="MAT 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27"/>
    <char style="wj">“አባንኮ ዋን ሁንደ ደበርሴ ነት ኬኔረ። አባ መሌ ነምን ቶኮዩ እልመ ህንቤኩ፤ እልማፊ ነመ እልም እሰ እት ሙልእሱ ፌዹ መሌ ነምን ቶኮዩ አባ ህንቤኩ።</char><verse eid="MAT 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28"/>
    <char style="wj">“እስን ደዸብዶትን፣ ወር በኣን እስንት ኡልፋቴ ሁንድኑ ገረኮ ኮታ፤ አን እስነን ቦቆቺሰ።</char> <verse eid="MAT 11:28"/><verse number="29" style="v" sid="MAT 11:29"/><char style="wj">ዋንጆኮ ባዻ፤ ነራስ በረዻ፤ ዋን አን ገራሚፊ ገድ ኦፍ ቀቤሰ ተኤፍ እስን ሉቡኬሰኒፍ ቦቆና ንአርገቱ።</char> <verse eid="MAT 11:29"/><verse number="30" style="v" sid="MAT 11:30"/><char style="wj">ዋንጆንኮ ላፋዸ፤ በኣንኮስ ሰልጳዸ።”</char><verse eid="MAT 11:30"/></para>
  <chapter eid="MAT 11"/>
  <chapter number="12" style="c" sid="MAT 12"/>
  <para style="s1">ጎፍታ ሰንበታ</para>
  <para style="r">
    <ref loc="MAT 12:1-8">12፥1‑8</ref> ኩወፈ – <char style="xt"><ref loc="MRK 2:23-28">ማር 2፥23‑28</ref>፤ <ref loc="LUK 6:1-5">ሉቃ 6፥1‑5</ref></char></para>
  <para style="r">
    <ref loc="MAT 12:9-14">12፥9‑14</ref> ኩወፈ – <char style="xt"><ref loc="MRK 3:1-6">ማር 3፥1‑6</ref>፤ <ref loc="LUK 6:6-11">ሉቃ 6፥6‑11</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1"/>ዬሱስ ዬሮ ሰነ ጉያ ሰንበታቲን ለፈ ቆቲሳ ምዻኒ ኬሰ ደርቤ። በረቶትንሳስ ቤለአኒ አሼቲ ምዻኒ ጭረተኒ ኛቹ ጀልቀበን። <verse eid="MAT 12:1"/><verse number="2" style="v" sid="MAT 12:2"/>ፈሪሶትን ዮሙ ዋን ከነ አርገንት፣ “እላ! በረቶትንኬ ዋን ጉያ ሰንበታቲን ሆጄቹን ሴራን ህንኤየመምኔ ሆጄቱ” ጄዸኒን።<verse eid="MAT 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3"/>እንስ አከነ ጄዼ ዴብሴ፤ <char style="wj">“ዬሮ ዳዊቲፊ ወር እሰ ወጅን ቱረን ቤለአንት ዋን ዳዊት ጎዼ እስን ህንዱብፍኔ?</char> <verse eid="MAT 12:3"/><verse number="4" style="v" sid="MAT 12:4"/><char style="wj">እን መነ ዋቃ ሴኔ፤ እኒፊ ወር እሰ ወጅን ቱረንስ ቡዴነ ኬና ኛተን፤ ቡዴን ሱንሞ ሉቦተ ቆፋፍ መሌ እሳኒፍ ህንኤየመሙ ቱሬ።</char> <verse eid="MAT 12:4"/><verse number="5" style="v" sid="MAT 12:5"/><char style="wj">ዮካን አከ ሉቦትን መነ ቁልቁሉማ ኬሳ ጉያ ሰንበታቲን ሰንበተ ጡሬሰን፣ ተኡስ አከ የከ ተኤ እሳንት ህንሄደምኔ እስን ሴረ ኬሰት ህንዱብፍኔ?</char> <verse eid="MAT 12:5"/><verse number="6" style="v" sid="MAT 12:6"/><char style="wj">አን እስንት ነንህመ፤ ከን መነ ቁልቁሉማ ጫሉ አስ ጅረ።</char> <verse eid="MAT 12:6"/><verse number="7" style="v" sid="MAT 12:7"/><char style="wj">እስን፣ ኡቱ ዱቢን፣ ‘አን አራረን ፌዸ መሌ ኣርሳ ህንፌዹ’</char><note caller="+" style="f"><char style="fr" closed="false">12፥7 </char><char style="ft" closed="false"><char style="xt"><ref loc="HOS 6:6">ሆሴ 6፥6</ref></char></char></note> <char style="wj">ጄዹ ሱን ማል ጄቹ አከ ተኤ ቤክተኒ ጅራተኒ ስላ ወረ የከ ህንቀብኔት ህንሙርተን ቱሬ።</char> <verse eid="MAT 12:7"/><verse number="8" style="v" sid="MAT 12:8"/><char style="wj">እልም ነማ ጎፍታ ሰንበታቲ።”</char><verse eid="MAT 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9"/>እንስ አቺ ከኤ መነ ሰገዳሳኒ ሴኔ፤ <verse eid="MAT 12:9"/><verse number="10" style="v" sid="MAT 12:10"/>ኩኖ ነምች ሀርክ እረት ጎጌ ቶኮስ አች ቱሬ። እሳንስ ሰበቢ እቲን ዬሱስን ህመተን በርባዳ ዋን ቱረኒፍ፣ “ጉያ ሰንበታቲን ነመ ፈይሱን ሴራ?” ጄዸኒ እሰ ጋፈተን።<verse eid="MAT 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11"/>ዬሱስሞ አከነ እሳኒን ጄዼ፤ <char style="wj">“እስን ኬሳ ነምን ሆላ ቶኮ ቀቡ፣ ዮ ሆላን ሱን ጉያ ሰንበታቲን ቦለ ኬሰ ቡኤ፣ ከን ሀርክሴ ህንባፈትኔ ጅራ?</char> <verse eid="MAT 12:11"/><verse number="12" style="v" sid="MAT 12:12"/><char style="wj">ነምንሞ ሀመም ሆላ ጫላ ገቲ ጉዳ ሃቀባቱሬ! ከናፉ ጉያ ሰንበታቲን ዋን ጋሪ ሆጄቹን ኤየመማዸ።”</char><verse eid="MAT 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 12:13"/>ነምቻንስ፣ <char style="wj">“ሀርከኬ ድሪርፈዹ”</char> ጄዼ። ነምችስ ሀርከ ድሪርፈቴ፤ ሀርክሳስ ጉቱማት ፈዬ አኩመ እሰ ካኒ ተኤ። <verse eid="MAT 12:13"/><verse number="14" style="v" sid="MAT 12:14"/>ፈሪሶትን ገሩ ገድ በአኒ አከ እቲን ዬሱስን አጄሰን መርአተን።<verse eid="MAT 12:14"/></para>
  <para style="s1">ተጃጅላ ዋቅን ፍለቴ</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15"/>ዬሱስ ዋን ከነ ቤኬ እዶ ሰና ከኤ ዴሜ። ነሞትን ባይኤንስ እሰ ዱካ ቡአን፤ እንስ ዹኩብሰቶተሳኒ ሁንደ ፈይሴ፤ <verse eid="MAT 12:15"/><verse number="16" style="v" sid="MAT 12:16"/>አከ እሳን አከ እን ቤከሙ ህንጎኔስ እሳን አጀጄ። <verse eid="MAT 12:16"/><verse number="17" style="v" sid="MAT 12:17"/>ኩንስ አከ ወን እሳያስ ራጅች ዱበቴ ሱን ራወተሙፍ ተኤ፤ እንስ አከነ ጄዸ፦<verse eid="MAT 12:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18"/>“ተጃጅላንኮ እን አን ፍለዼ፣</para>
  <para style="q2" vid="MAT 12:18">እን አን ጃለዹፊ እን አን እት ገመዱ እሰ ከነ፤</para>
  <para style="q1" vid="MAT 12:18">አን ሀፉረኮ እሰረ ነንካአ፤</para>
  <para style="q2" vid="MAT 12:18">እንስ ሰቦተት ሙርቲ ቀጄላ ንለብሰ።<verse eid="MAT 12:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19"/>እን ህንወጩ ዮካን ህንእዩ፤</para>
  <para style="q2" vid="MAT 12:19">ነምን ቶኮሌ ሰገሌሳ ከራረት ህንዸገኡ።<verse eid="MAT 12:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20"/>እን ሀመ አከ ሙርቲን ቀጄላን ሞኡ ጎዹት፣</para>
  <para style="q2" vid="MAT 12:20">ሸምበቆ ቡሩቄ ህንጨብሱ፤</para>
  <para style="q1" vid="MAT 12:20">ፎኣ እብሳ ከን ሴቁስ ህንዻምሱ።<verse eid="MAT 12:20"/></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21"/>ሰቦትንስ መቃሳ ንአብደቱ።”<note caller="+" style="f"><char style="fr" closed="false">12፥21 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 42:1-4">እሳ 42፥1‑4</ref></char></char></note><verse eid="MAT 12:21"/></para>
  <para style="s1">ዬሱሲፊ ብኤልዜቡል</para>
  <para style="r">
    <ref loc="MAT 12:25-29">12፥25‑29</ref> ኩወፈ – <char style="xt"><ref loc="MRK 3:23-27">ማር 3፥23‑27</ref>፤ <ref loc="LUK 11:17-22">ሉቃ 11፥17‑22</ref></char></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22"/>ዬሮ ሰነት ነምቸ ሀፉረ ሀማን ቀበሜ፣ ከን እጅሳ ጃሜ አረብንሳስ ዱበቹ ድዴ ቶኮ ገረሳ ፍደን፤ ዬሱስስ ነምቸ ሰነ ፈይሴ፤ ነምችስ ዱበቹፊ አርጉ ደንደኤ። <verse eid="MAT 12:22"/><verse number="23" style="v" sid="MAT 12:23"/>ነሞትን ሁንድኑስ ድንቅፈተኒ፣ “ኩን እልመ ዳዊት ተእና?” ጄዸን።<verse eid="MAT 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24"/>ፈሪሶትን ገሩ ዮሙ ከነ ዸገአንት፣ “ነምች ኩን ብኤልዜቡል፣ ሀንገፈ ሀፉሮተ ሀሞ ቆፋን ሀፉሮተ ሀሞ ባሰ” ጄዸን።<verse eid="MAT 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25"/>ዬሱስስ ያደሳኒ ቤኬ አከነ ጄዼን፤ <char style="wj">“ሞቱማን ገርገር ኦፍ ቆዱ ሁንድኑ ንዲገመ፤ መጋላን ዮካን ማቲን ገርገር ኦፍ ቆዱ ሁንድኑስ ህንዻበቱ።</char> <verse eid="MAT 12:25"/><verse number="26" style="v" sid="MAT 12:26"/><char style="wj">ሴጠንስ ሴጠነ ባፍናን፣ እን ገርገር ኦፍ ቆደ። ዮስ ሞቱማንሳ አከምት ዻበቹ ደንደአሬ?</char> <verse eid="MAT 12:26"/><verse number="27" style="v" sid="MAT 12:27"/><char style="wj">ኤርገ አን ብኤልዜቡሊን ሀፉሮተ ሀሞ ባሴ፣ እጆሌንኬሰንሞ ማሊን ባሱሬ? ከናፉ እሳን አቦቲ ሙርቲ እስንት ተኡ።</char> <verse eid="MAT 12:27"/><verse number="28" style="v" sid="MAT 12:28"/><char style="wj">ገሩ አን ሀፉረ ዋቃቲን ሀፉሮተ ሀሞ ባሰ ታናን፣ ዮስ ሞቱማን ዋቃ እስንት ዹፌረ።</char><verse eid="MAT 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29"/>
    <char style="wj">“ዮካን ነምን ከምዩ ዮ ዱራን ዱርሴ ነመ ጀባ ቶኮ ህዼ መሌ አከምት መነ ነመ ጀባ ሰና ሴኔ ቀቤኘሳ ሳሙ ደንደአ? ኤርገሲ እን መነሳ ሳሙ ደንደአ።</char><verse eid="MAT 12:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30"/>
    <char style="wj">“ነምን ነ ወጅን ህንጅሬ ከምዩ ናን ሞርመ፤ ነምን ነ ወጅን ወልት ህንቀብኔ ከምዩስ ንብትኔሰ።</char> <verse eid="MAT 12:30"/><verse number="31" style="v" sid="MAT 12:31"/><char style="wj">ከናፉ አን እስንትን ህመ፤ ጩቡፊ አረብሶን ሁንድኑ ነማፍ ንዺፈመ፤ ሀፉረ ቁልቁሉ አረብሱን ገሩ ህንዺፈሙ።</char> <verse eid="MAT 12:31"/><verse number="32" style="v" sid="MAT 12:32"/><char style="wj">ነመ እልመ ነማቲን ሞርሜ ጄቸ ቶኮ ዱበቱ ከሚፍዩ ንዺፈመ፤ ነመ ሀፉረ ቁልቁሉዻን ሞርሜ ዱበቱ ከሚፍዩ ገሩ፣ አዱኛ ከነረት ዮካን አዱኛ ዹፉፍ ጅሩረት ህንዺፈሙ።</char><verse eid="MAT 12:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33"/>
    <char style="wj">“ሙከ ጋሪ ቀባዻ፤ እጅሳ ጋሪ ተኣ፤ ሙከ ገዼ ቀባዻ፤ እጅሳ ገዼ ተኣ፤ ሙክን እጀሳቲን ቤከማቲ።</char> <verse eid="MAT 12:33"/><verse number="34" style="v" sid="MAT 12:34"/><char style="wj">እስን ያ እጆሌ ቡቲነነ፣ እስን ወር ሀሞን አከምት ዋን ጋሪ ዱበቹ ደንዴሱ? ዋን ገራ ጉቴ አፋን ዱበታቲ።</char> <verse eid="MAT 12:34"/><verse number="35" style="v" sid="MAT 12:35"/><char style="wj">ነምን ጋሪን ዋን ጋሪ ገራሳ ኬሰ ጅሩ ኬሳ ዋን ጋሪ ባሰ፤ ነምን ሀማንሞ ዋን ሀማ ገራሳ ኬሰ ጅሩ ኬሳ ዋን ሀማ ባሰ።</char> <verse eid="MAT 12:35"/><verse number="36" style="v" sid="MAT 12:36"/><char style="wj">አን ገሩ እስንትን ህመ፤ ጉያ ሙርቲት ነሞትን ዱቢ አኩመ አርገን ዱበተን ሁንዱመት ንጋፈተሙ።</char> <verse eid="MAT 12:36"/><verse number="37" style="v" sid="MAT 12:37"/><char style="wj">ዱቢኬቲን ቀጄላ ታስፈምታቲ፤ ዱቢኬቲንስ ስት ሙረመ።”</char><verse eid="MAT 12:37"/></para>
  <para style="s1">መለቶ ዮናስ</para>
  <para style="r">
    <ref loc="MAT 12:39-42">12፥39‑42</ref> ኩወፈ – <char style="xt"><ref loc="LUK 11:29-32">ሉቃ 11፥29‑32</ref></char></para>
  <para style="r">
    <ref loc="MAT 12:43-45">12፥43‑45</ref> ኩወፈ – <char style="xt"><ref loc="LUK 11:24-26">ሉቃ 11፥24‑26</ref></char></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38"/>ኤርገሲ በርሲስቶትን ሴራቲፊ ፈሪሶትን ቶኮ ቶኮ፣ “ያ በርሲሳ፣ ኑ መለቶ ስራ አርጉ በርባድነ” ጄዸኒን።<verse eid="MAT 12:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39"/>እንስ ዴብሴ አከነ እሳኒን ጄዼ፤ <char style="wj">“ዸሎትን ሀማፊ ኤጃን መለቶ በርባደ! ገሩ መለቶ ዮናስ ራጅቻ ሰነ መሌ መለቶን ቶኮዩ ህንኬነሙፍ።</char> <verse eid="MAT 12:39"/><verse number="40" style="v" sid="MAT 12:40"/><char style="wj">አኩመ ዮናስ ጉያ ሰዲፊ ሀልከን ሰዲ ገራ ቁርጡሚ ጉዳ ቶኮ ኬሰ ቱሬ ሰነ፣ እልም ነማስ ጉያ ሰዲፊ ሀልከን ሰዲ ገራ ለፋ ኬሰ ንቱራቲ።</char> <verse eid="MAT 12:40"/><verse number="41" style="v" sid="MAT 12:41"/><char style="wj">ነሞትን ነነዌ ጉያ ሙርቲት ዸሎተ ከነ ወጅን ከአኒ እት ሙሩ፤</char><note caller="+" style="f"><char style="fr" closed="false">12፥41 </char><char style="ft" closed="false"><char style="xt"><ref loc="JON 3:5">ዮና 3፥5</ref></char></char></note> <char style="wj">እሳን ለለበ ዮናሲን ቀልቢ ጅጂረተኒቲ፤ ኩኖ፣ ከን ዮናስን ጫሉ አስ ጅረ።</char> <verse eid="MAT 12:41"/><verse number="42" style="v" sid="MAT 12:42"/><char style="wj">ሞትቲን ክባ ጉያ ሙርቲት ዸሎተ ከነ ወጅን ካቴ እት ሙርት፤ እሼን ኦጉማ ሶሎሞን ዸገኡፍ ጄቴ ዳሪ ለፋቲ ዹፍቴቲ፤ ኩኖ፣ ከን ሶሎሞንን ጫሉ አስ ጅረ።</char><verse eid="MAT 12:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43"/>
    <char style="wj">“ሀፉር ጡራኣን ዮሙ ነመ ኬሳ በኡት፣ ቦቆና በርባቸ ለፈ ጎጋ ኬሰ ጆረ፤ ገሩ ህንአርገቱ።</char> <verse eid="MAT 12:43"/><verse number="44" style="v" sid="MAT 12:44"/><char style="wj">እንስ፣ ‘መነኮ እሰ አን ኬሳ በኤ ሰነት ነንዴብአ’ ጄዸ። ዮሙ አች ገኡትስ መንቸ ዱዋ ተኤ፣ ሀረሜ ቁልቁሌፈሜ፣ ቆጴፈሜስ አርገተ።</char> <verse eid="MAT 12:44"/><verse number="45" style="v" sid="MAT 12:45"/><char style="wj">ኤርገሲስ ዸቄ ሀፉሮተ ብራ ቶርበ ከኔን እሰ ጫላ ሀሞ ተአን ፉዸቴ ዹፈ፤ እሳንስ እት ገለኒ አች ጅራቱ። ሃል ነምቸ ሰና ከን ዹማ እሰ ጀልቀባ ጫላ ሀማተ። ዸሎትን ሀማን ኩንስ አከሱመ ተአ።”</char><verse eid="MAT 12:45"/></para>
  <para style="s1">ሃዻፊ ኦቦሎተ ዬሱስ</para>
  <para style="r">
    <ref loc="MAT 12:46-50">12፥46‑50</ref> ኩወፈ – <char style="xt"><ref loc="MRK 3:31-35">ማር 3፥31‑35</ref>፤ <ref loc="LUK 8:19-21">ሉቃ 8፥19‑21</ref></char></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46"/>ኡቱ ዬሱስ አመዩ ነሞተት ዱበቻ ጅሩ ኩኖ፣ ሃቲፊ ኦቦሎትንሳ እሰ ወጅን ሃሰኡ በርባደኒ አለ ዸዻበቻ ቱረን። <verse eid="MAT 12:46"/><verse number="47" style="v" sid="MAT 12:47"/>ነምን ቶኮስ፣ “ሃትኬቲፊ ኦቦሎትንኬ ስ ወጅን ሃሰኡ በርባደኒ አለ ዸዻበቱ” ጄዼ እሰት ህሜ።<verse eid="MAT 12:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48"/>እንስ ዴብሴፊ፣ <char style="wj">“ሃትኮ ኤኙ? ኦቦሎትንኮስ ኤኙ ፈእ?”</char> ጄዼን። <verse eid="MAT 12:48"/><verse number="49" style="v" sid="MAT 12:49"/>ሀርከሳስ ገረ በረቶተሳት ቀቤ አከነ ጄዼ፤ <char style="wj">“ሃትኮፊ ኦቦሎትንኮ ኩኖት።</char> <verse eid="MAT 12:49"/><verse number="50" style="v" sid="MAT 12:50"/><char style="wj">ነምን ፌዺ አባኮ እሰ ሰሚራ ጉቱ ከምዩ ኦቦሌሰኮት፤ ኦቦሌቲኮት፤ ሃዸኮትስ።”</char><verse eid="MAT 12:50"/></para>
  <chapter eid="MAT 12"/>
  <chapter number="13" style="c" sid="MAT 13"/>
  <para style="s1">ፈኬኘ ነምቸ ሰኚ ፈጫሱ</para>
  <para style="r">
    <ref loc="MAT 13:1-15">13፥1‑15</ref> ኩወፈ – <char style="xt"><ref loc="MRK 4:1-12">ማር 4፥1‑12</ref>፤ <ref loc="LUK 8:4-10">ሉቃ 8፥4‑10</ref></char></para>
  <para style="r">
    <ref loc="MAT 13:16">13፥16</ref>፣<ref loc="MAT 13:17">17</ref> ኩወፈ – <char style="xt"><ref loc="LUK 10:23">ሉቃ 10፥23</ref>፣<ref loc="LUK 10:24">24</ref></char></para>
  <para style="r">
    <ref loc="MAT 13:18-23">13፥18‑23</ref> ኩወፈ – <char style="xt"><ref loc="MRK 4:13-20">ማር 4፥13‑20</ref>፤ <ref loc="LUK 8:11-15">ሉቃ 8፥11‑15</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1"/>ጉዩመ ሰነ ዬሱስ መና በኤ ገላነ ብረ ታኤ። <verse eid="MAT 13:1"/><verse number="2" style="v" sid="MAT 13:2"/>ቱትን ነሞታ ጉዳን ናኖሳት ወልት ቀበሜ፤ ኡቱ ነሞትን ሁንድ ቀርቀረ ገላንቻ ዸዻበቻ ጅረኑ፣ እን ብድሩ ያበቴ ታኤ። <verse eid="MAT 13:2"/><verse number="3" style="v" sid="MAT 13:3"/>እንስ አከነ ጄዼ ዋን ባይኤ ፈኬኛን እሳንት ህሜ፤ <char style="wj">“ኩኖ፣ ነምች ሰኚ ፈጫሱ ቶኮ ሰኚ ፈጫፈቹ በኤ።</char> <verse eid="MAT 13:3"/><verse number="4" style="v" sid="MAT 13:4"/><char style="wj">ኡቱ እን ፈጫሳ ጅሩስ ሰኚን ቶኮ ቶኮ ከራረ ቡኤ፤ ስምብሮትንስ ዹፈኒ ኛተኒ ፍጠን።</char> <verse eid="MAT 13:4"/><verse number="5" style="v" sid="MAT 13:5"/><char style="wj">ካንሞ ለፈ ከታ፣ እዶ ብዮ ባይኤ ህንቀብኔረ ቡኤ። ሰኚን ሱንስ ሰበቢ ብዮን ሱን ገድ ፈጌኘ ህንቀባትኒፍ ደፌ ብቅሌ።</char> <verse eid="MAT 13:5"/><verse number="6" style="v" sid="MAT 13:6"/><char style="wj">ዮሙ አዱን ባቴት ገሩ ብቅልቱን ሱን ንጮለጌ፤ ዋን ህደ ህንቀባትኒፍስ ንጎጌ።</char> <verse eid="MAT 13:6"/><verse number="7" style="v" sid="MAT 13:7"/><char style="wj">ሰኚን ብራስ ቆራቲ ኬሰ ቡኤ፤ ቆራቲን ሱንስ ጉደቴ ብቅልቱ ሰነ ሁዼ።</char> <verse eid="MAT 13:7"/><verse number="8" style="v" sid="MAT 13:8"/><char style="wj">አመስ ሰኚን ካን ብዮ ጋሪረ ቡኤ አችት እጀ ነቀቴ፤ ገር ቶኮ ደቻ ዽበ፣ ካን ደቻ ጃተመ፣ ካንሞ ደቻ ሶዶመ ነቀቴ።</char> <verse eid="MAT 13:8"/><verse number="9" style="v" sid="MAT 13:9"/><char style="wj">ነምን ጉረ ቀቡ ከምዩ ሃዸገኡ።”</char><verse eid="MAT 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10"/>በረቶትንስ ገረሳ ዹፈኒ፣ “አት ማሊፍ ፈኬኛን ነሞተት ዱበተ?” ጄዸኒ እሰ ጋፈተን።<verse eid="MAT 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11"/>እንስ አከነ ጄዼ ዴብሴፍ፤ <char style="wj">“እጪቲ ሞቱማ ሰሚ ቤኩን እስኒፍ ኬነሜረ፤ እሳኒፍ ገሩ ህንኬነምኔ።</char> <verse eid="MAT 13:11"/><verse number="12" style="v" sid="MAT 13:12"/><char style="wj">ከን ቀቡ ከሚፍዩ እት ደበለሜ ንኬነመ፤ እራ ሀፋስ ንቀባተ። ከን ህንቀብኔ ገሩ ወን እን ቀቡዩ እራ ፉዸተመ።</char> <verse eid="MAT 13:12"/><verse number="13" style="v" sid="MAT 13:13"/><char style="wj">ወን አን አከነ ጄዼ ፈኬኛን እሳንት ዱበዹፍስ ከነ፦</char></para>
  <para style="q1" vid="MAT 13:13">
    <char style="wj">“እሳን ኡቱመ እላለኑ ህንአርገን፤</char></para>
  <para style="q2" vid="MAT 13:13">
    <char style="wj">ኡቱመ ዸጌፈተኑስ ህንዸገአን ዮካን ህንሁበተን።</char><verse eid="MAT 13:13"/></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 13:14"/>
    <char style="wj">ራጂን እሳያስ ዱበቴ ሱን እሳንረት ራወተሜረ፤ እንስ አከነ ጄዸ፦</char></para>
  <para style="q1" vid="MAT 13:14">
    <char style="wj">“ ‘ዸገኡ እኑመ ዸጌሱ፤ ገሩ ህንሁበተን፤</char></para>
  <para style="q2" vid="MAT 13:14">
    <char style="wj">እላሉስ እኑመ እላልቱ፤ ገሩ ህንቀልቤፈተን።</char><verse eid="MAT 13:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15"/>
    <char style="wj">ቀልቢን ሰበ ከና ዶሜራቲ፤</char></para>
  <para style="q2" vid="MAT 13:15">
    <char style="wj">ጉርሳኒ ስሪት ህንዸገኡ፤</char></para>
  <para style="q2" vid="MAT 13:15">
    <char style="wj">እጀሳኒስ ዱኑንፈተኒሩ።</char></para>
  <para style="q1" vid="MAT 13:15">
    <char style="wj">ኡቱ አከስ ተኡ ባቴ ስላ እጀሳኒቲን አርገኒ፣</char></para>
  <para style="q2" vid="MAT 13:15">
    <char style="wj">ጉረሳኒቲን ዸገአኒ፣</char></para>
  <para style="q2" vid="MAT 13:15">
    <char style="wj">ቀልቢሳኒቲንስ ሁበተኒ ንዴብኡ ቱረን፤</char></para>
  <para style="q1" vid="MAT 13:15">
    <char style="wj">አንስ እሳን ነንፈይሰ ቱሬ።’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">13፥15 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="ISA 6:9">እሳ 6፥9</ref>፣<ref loc="ISA 6:10">10</ref></char>
      </char>
    </note><verse eid="MAT 13:15"/></para>
  <para style="m">
    <verse number="16" style="v" sid="MAT 13:16"/>
    <char style="wj">እጅኬሰን ገሩ ዋን አርጉፍ ኤብፈማዸ፤ ጉርኬሰንስ ዋን ዸገኡፍ ኤብፈማዸ።</char> <verse eid="MAT 13:16"/><verse number="17" style="v" sid="MAT 13:17"/><char style="wj">አን ዹጉመ እስንትን ህማቲ፤ ራጆትኒፊ ቀጄልቶትን ባይኤን ዋን እስን አርግተን ከነ አርጉ ሀወን፤ ገሩ ህንአርግኔ፤ ዋን እስን ዸጌሰን ከነስ ዸገኡ ሀወን፤ ገሩ ህንዸጌኜ።</char><verse eid="MAT 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18"/>
    <char style="wj">“ኤጋ ፈኬኝ ነምቸ ሰኚ ፈጫሱ ማል አከ ተኤ ዸገኣ፦</char> <verse eid="MAT 13:18"/><verse number="19" style="v" sid="MAT 13:19"/><char style="wj">ዮ ነምን ከምዩ ዱቢ ሞቱምቻ ዸገኤ ሁበቹ ባቴ፣ እን ሀማን ሱን ዹፌ ዋን ገራሳ ኬሰት ፈጫፈሜ ሰነ ቡተተ። ኩን ሰኚ ከራረት ፈጫፈሜዸ።</char> <verse eid="MAT 13:19"/><verse number="20" style="v" sid="MAT 13:20"/><char style="wj">ሰኚን ለፈ ከታረት ፈጫፈሜ፣ ነመ ዱብቸ ዸገኤ ዮሙሱመ ገመቹን ፉዸቱዸ።</char> <verse eid="MAT 13:20"/><verse number="21" style="v" sid="MAT 13:21"/><char style="wj">ገሩ እን ዋን ሁንዴ ህንቀብኔፍ ዬሮ ገባባ ቆፈ ቱረ። ዬሮ ረክን ዮካን አርአተምን ሰበቢ ዱብቻቲፍ ዹፉት እን ደፌ ጉፈተ።</char> <verse eid="MAT 13:21"/><verse number="22" style="v" sid="MAT 13:22"/><char style="wj">ሰኚን ቆራቲ ኬሰት ፈጫፈሜ ሱንስ ነመ ዱብቸ ዸገኡ አርግሲሰ፤ ገሩ ያዶን አዱኛ ከናቲፊ ጎዎምሳን ቀቤኛ ዱብቸ ሁዼ እጀ ነቀቹ ዾወ።</char> <verse eid="MAT 13:22"/><verse number="23" style="v" sid="MAT 13:23"/><char style="wj">ሰኚን ብዮ ጋሪረት ፈጫፈሜ ገሩ ነመ ዱብቸ ዸገኤ ሁበቱ አርግሲሰ። እንስ እጀ ኬነ፤ ገር ቶኮ ዽበ፣ ካን ጃተመ፣ ካንሞ ሶዶመ ነቀተ።”</char><verse eid="MAT 13:23"/></para>
  <para style="s1">ፈኬኘ አረማ</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24"/>ዬሱስ አከነ ጄዼ ፈኬኘ ብራ እሳንት ህሜ፤ <char style="wj">“ሞቱማን ሰሚ ነመ ለፈ ቆቲሳሳ ኬሰት ሰኚ ጋሪ ፈጫፈቴ ቶኮ ፈካተ።</char> <verse eid="MAT 13:24"/><verse number="25" style="v" sid="MAT 13:25"/><char style="wj">ገሩ ኡቱ ነሞትን ረፈኑ ዲንሳ ዹፌ ቀመዲ ኬሰት እንክርዳደ ፈጫሴ ዴሜ።</char> <verse eid="MAT 13:25"/><verse number="26" style="v" sid="MAT 13:26"/><char style="wj">ዬሮ ቀመዲን ሱን ጉደቴ እጀ ነቀቴት እንክርዳድንስ ንሙልአቴ።</char><verse eid="MAT 13:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 13:27"/>
    <char style="wj">“ገርቦትን አባ ለፈ ቆቲሳ ሰናስ ገረሳ ዹፈኒ፣ ‘ጎፍታ፣ አት ለፈ ቆቲሳኬ ኬሰት ሰኚ ጋሪ ህንፈጫፍኔ? ዮስ እንክርዳድን ኤሳ ዹፌሬ?’ ጄዸኒን።</char><verse eid="MAT 13:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28"/>
    <char style="wj">“እንስ ዴብሴ፣ ‘ዲነቱ ከነ ሆጄቴ’ ጄዼ።</char></para>
  <para style="p" vid="MAT 13:28">
    <char style="wj">“ገርቦትንስ፣ ‘አከ ኑ ዸቅኔ ቡቅፍኑ ንበርባዳ?’ ጄዸኒ እሰ ጋፈተን።</char><verse eid="MAT 13:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29"/>
    <char style="wj">“ነምች ገሩ አከነ ጄዼ ዴብሴፍ፤ ‘ለክ፣ ኡቱ እንክርዳደ ቡቅፍተኑ፣ አከ እሰ ወጅን ቀመዲ ህንቡቅፍኔፍ ዺሳ።</char> <verse eid="MAT 13:29"/><verse number="30" style="v" sid="MAT 13:30"/><char style="wj">ሀመ ዬሮ ሃማት ለቸኑ ወሉማን ሃጉደተን። አንስ ዬሮ ሰነ ወረ ምዻን ሃመኒን፣ “ጀልቀበት እንክርዳደ ሰነ ቡቅሳ፤ አከ ጉበሙፍስ ብሲ ብሲዻን ህዻ፤ ቀመዲ ገሩ ወልት ቀባቲ ጎምብሳኮት ናፍ ነቃ” ጄዼ እሳንት ነንህመ።’ ”</char><verse eid="MAT 13:30"/></para>
  <para style="s1">ፈኬኘ ራጭቲቲፊ ሰኚ ሰናፍጫ</para>
  <para style="r">
    <ref loc="MAT 13:31">13፥31</ref>፣<ref loc="MAT 13:32">32</ref> ኩወፈ – <char style="xt"><ref loc="MRK 4:30-32">ማር 4፥30‑32</ref></char></para>
  <para style="r">
    <ref loc="MAT 13:31-33">13፥31‑33</ref> ኩወፈ – <char style="xt"><ref loc="LUK 13:18-21">ሉቃ 13፥18‑21</ref></char></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31"/>እንስ አከነ ጄዼ ፈኬኘ ብራ እሳንት ህሜ፤ <char style="wj">“ሞቱማን ሰሚ ሰኚ ሰናፍጫ ከን ነምን ፉዼ ለፈ ቆቲሳሳ ኬሰት ፈጫሴ ቶኮ ፈካተ።</char> <verse eid="MAT 13:31"/><verse number="32" style="v" sid="MAT 13:32"/><char style="wj">እን ዹጉማን ሰኚ ሁንደረ ጥናዸ፤ ኤርገ ጉደቴ ገሩ ብቅልቱ ሁንደ ጫሌ ሙከ ተአ፤ ስምብሮትንስ ዹፈኒ ደሜወንሳረ ጅራቱ።”</char><verse eid="MAT 13:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33"/>አመሌ አከነ ጄዼ ፈኬኘ ብራ እሳንት ህሜ፤ <char style="wj">“ሞቱማን ሰሚ ራጭቲ ዱበርቲን ቶኮ ፉቴ ሀመ እን ጉቱማት ቡኬሱት ዳኩ ሰፈርቱ ሰዲት መክቴ ፈካተ።”</char><verse eid="MAT 13:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34"/>ዬሱስ ዋን ከነ ሁንዱማ ፈኬኛን ነሞተት ዱበቴ፤ እንስ ፈኬኛን መሌ ዋን ቶኮሌ እሳንት ህንዱበትኔ። <verse eid="MAT 13:34"/><verse number="35" style="v" sid="MAT 13:35"/>ኩንስ አከ ወን ራጅች፣</para>
  <para style="q1" vid="MAT 13:35">“አን ፈኬኛን አፋንኮ ነንበነዸ፤</para>
  <para style="q2" vid="MAT 13:35">ዋን ጋፈ አዱኛን ኡመሜ ጀልቀቤ ዾክፈሜስ ነንዱበዸ”<note caller="+" style="f"><char style="fr" closed="false">13፥35 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 78:2">ፋር 78፥2</ref></char></char></note></para>
  <para style="m" vid="MAT 13:35">ጄዼ ሱን ራወተሙፍ ተኤ።<verse eid="MAT 13:35"/></para>
  <para style="s1">ሂካ ፈኬኘ እንክርዳዳ</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36"/>ዬሱስስ ቱተ ነሞታ አቹመት ዺሴ መነ ኦል ሴኔ። በረቶትንሳስ ገረሳ ዹፈኒ፣ “ሂካ ፈኬኘ እንክርዳደ ለፈ ቆቲሳ ኬሳ ሰነ ኑት ህም” ጄዸኒን።<verse eid="MAT 13:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37"/>እንስ አከነ ጄዼ ዴብሴ፤ <char style="wj">“ነምች ሰኚ ጋሪ ፈጫሴ ሱን እልመ ነማት።</char> <verse eid="MAT 13:37"/><verse number="38" style="v" sid="MAT 13:38"/><char style="wj">ለፍት ቆቲሳ ሱን አዱኛዸ፤ ሰኚን ጋሪንስ እጆሌ ሞቱምቻት። እንክርዳድን ሱን እጆሌ እሰ ሀማ ሰናት፤</char> <verse eid="MAT 13:38"/><verse number="39" style="v" sid="MAT 13:39"/><char style="wj">ዲን እንክርዳደ ፈጫሴሞ ዲያብሎስዸ። ሃማን ዹመ አዱኛት፤ ወር ሃመንሞ ኤርገሞተ ዋቃት።</char><verse eid="MAT 13:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 13:40"/>
    <char style="wj">“አኩመ እንክርዳድን ወልት ቀበሜ እብዳን ጉበሙ ሰነ፣ ዹመ አዱኛትስ አከሱመ ተአ።</char> <verse eid="MAT 13:40"/><verse number="41" style="v" sid="MAT 13:41"/><char style="wj">እልም ነማ ኤርገሞተሳ ንኤርገ፤ እሳንስ ዋን ጩቡት ነመ ጌሱ ሁንዳፊ ወረ ዋን ሀማ ሆጄተን ሁንደ ሞቱማሳ ኬሳ ባሰኒ ወልት ቀቡ።</char> <verse eid="MAT 13:41"/><verse number="42" style="v" sid="MAT 13:42"/><char style="wj">ቦለ እብዳትስ እሳን ደርበቱ፤ አችትስ ወዋትናፊ እልካን ቀሩቱ ተአ።</char> <verse eid="MAT 13:42"/><verse number="43" style="v" sid="MAT 13:43"/><char style="wj">ዬሮ ሰነ ቀጄልቶትን ሞቱማ አባሳኒ ኬሰት አከ አዱ ንእፉ። ነምን ጉረ ቀቡ ሃዸገኡ።</char><verse eid="MAT 13:43"/></para>
  <para style="s1">ፈኬኘ ቀቤኘ ዾክፈሜቲፊ ሉላ</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44"/>
    <char style="wj">“ሞቱማን ሰሚ ቀቤኘ ለፈ ቆቲሳ ኬሰ ዾክፈሜ ፈካተ። ነምን ቶኮስ ቀቤኘ ከነ አርገቴ ዴብሴ ዾክሴ፤ እንስ ዋን ገመዴፍ ዸቄ ዋን ቀቡ ሁንደ ጉርጉሬ ለፈ ቆቲሳ ሰነ ብተቴ።</char><verse eid="MAT 13:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45"/>
    <char style="wj">“አከሱመስ ሞቱማን ሰሚ ደልደላ ሉለ ጋሪ በርባዱ ቶኮ ፈካተ።</char> <verse eid="MAT 13:45"/><verse number="46" style="v" sid="MAT 13:46"/><char style="wj">ደልደላን ሱንስ ሉለ ገቲ ጉዳ ቶኮ አርገቴ፤ እንስ ዸቄ ዋን ቀቡ ሁንዱማ ጉርጉሬ ሉለ ሰነ ብተቴ።</char><verse eid="MAT 13:46"/></para>
  <para style="s1">ፈኬኘ ክዮ</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47"/>
    <char style="wj">“አከሱመስ ሞቱማን ሰሚ ክዮ ገላነት ደርበተሜ ቁርጡሚ ጎሰ ሁንዳ ወልት ቀቤ ፈካተ።</char> <verse eid="MAT 13:47"/><verse number="48" style="v" sid="MAT 13:48"/><char style="wj">ዬሮ ክዮን ሱን ጉተሜትስ ቁርጡሚ ቀብዶትን ገረ ቀርቀረ ገላናት እሰ ሀርክሰን። ኤርገሲስ ተታአኒ ቁርጡሚ ጋሪ ፍለኒ ቆዳሳኒት ነቀተን፤ ቁርጡሚ ገዼሞ ንገተን።</char> <verse eid="MAT 13:48"/><verse number="49" style="v" sid="MAT 13:49"/><char style="wj">ዹመ አዱኛትስ አከሱመ ተአ። ኤርገሞትን ዋቃ ዹፈኒ ወረ ሀሞ ወረ ቀጄልቶተራ ገርገር ባሱ፤</char> <verse eid="MAT 13:49"/><verse number="50" style="v" sid="MAT 13:50"/><char style="wj">ቦለ እብዳትስ እሳን ደርበቱ፤ አችትስ ወዋትናፊ እልካን ቀሩቱ ተአ።”</char><verse eid="MAT 13:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51"/>ዬሱስስ፣ <char style="wj">“ዋን ከነ ሁንደ ሁበተኒርቱ?”</char> ጄዼ እሳን ጋፈቴ።</para>
  <para style="p" vid="MAT 13:51">እሳንስ፣ “ኤዬ” ጄዸኒ ዴብሰን።<verse eid="MAT 13:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52"/>እንስ፣ <char style="wj">“ከናፉ በርሲሳን ሴራ ከን በረታ ሞቱማ ሰሚ ተኤ ከምዩ አባ መና ከን ቀቤኘ ሃራፊ ሞፋ መነ ምአሳ ኬሳ ገድ ባሱ ቶኮ ፈካተ”</char> ጄዼን።<verse eid="MAT 13:52"/></para>
  <para style="s1">ራጂ ቱፈተሜ</para>
  <para style="r">
    <ref loc="MAT 13:54-58">13፥54‑58</ref> ኩወፈ – <char style="xt"><ref loc="MRK 6:1-6">ማር 6፥1‑6</ref></char></para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53"/>ዬሱስ ኤርገ ፈኬኘ ከነ ዱበቴ ራወቴ ቦዴ አቺ ከኤ ዴሜ። <verse eid="MAT 13:53"/><verse number="54" style="v" sid="MAT 13:54"/>እንስ ገረ መጋላ እት ዸለቴ ዸቄ መነ ሰገዳሳኒ ኬሰት ነሞተ በርሲሱ ጀልቀቤ፤ እሳንስ ንድንቅሲፈተን። አከነ ጄዸኒስ ጋፈተን፤ “ነምች ኩን ኦጉማ ከናፊ ሆጂወን ድንቂ ከኔን ኤሳ አርገቴ? <verse eid="MAT 13:54"/><verse number="55" style="v" sid="MAT 13:55"/>እን እልመ ነምቸ ሙከ ሶፉ ሰና ምቲ? መቃን ሃዸሳስ ማርያም ምቲ? ኦቦሎትንሳስ ያቆብ፣ ዮሴፍ፣ ስምኦኒፊ ይሁዳ ምቲ? <verse eid="MAT 13:55"/><verse number="56" style="v" sid="MAT 13:56"/>ኦቦሌቶትንሳ ሁንድኑ ኑ ብረ ጅሩ ምቲ? ዮስ ነምች ኩን ዋን ከነ ሁንዱማ ኤሳ አርገቴ?” <verse eid="MAT 13:56"/><verse number="57" style="v" sid="MAT 13:57"/>እሳንስ እሰት ጉፈተን።</para>
  <para style="p" vid="MAT 13:57">ዬሱስ ገሩ፣ <char style="wj">“ራጂን መጋላ እት ዸለቴፊ መነሳት መሌ ከበጀ ህንዸቡ”</char> ጄዼን።<verse eid="MAT 13:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="MAT 13:58"/>እንስ ሰበቢ አመንቲ ዸቡሳኒቲፍ ሆጂ ድንቂ ሄዱ አችት ህንሆጄትኔ።<verse eid="MAT 13:58"/></para>
  <chapter eid="MAT 13"/>
  <chapter number="14" style="c" sid="MAT 14"/>
  <para style="s1">አጄፈሙ ዮሀንስ ጩጳ</para>
  <para style="r">
    <ref loc="MAT 14:1-12">14፥1‑12</ref> ኩወፈ – <char style="xt"><ref loc="MRK 6:14-29">ማር 6፥14‑29</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1"/>በረ ሰነ ሄሮድስ ቡልቻን ኦዱ ዋኤ ዬሱስ ዸገኤ፤ <verse eid="MAT 14:1"/><verse number="2" style="v" sid="MAT 14:2"/>እንስ ተጃጅልቶተሳቲን፣ “ኩን ዮሀንስ ጩጳዸ፤ እን ወረ ዱአን ኬሳ ካፈሜረ! ሰበቢን ሆጂን ድንቂ እሳን ሆጄተሙፍስ ከኑመ” ጄዼ።<verse eid="MAT 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3"/>ሄሮድስ ሰበቢ ኒቲ ኦቦሌሰሳ ፊልጶስ፣ ሰበቢ ሄሮድያዳቲፍ ጄዼ ዮሀንስን ቀቤ፣ ህዼ መነ ህዻት ገልቼ ቱሬቲ። <verse eid="MAT 14:3"/><verse number="4" style="v" sid="MAT 14:4"/>ኩንስ ሰበቢ ዮሀንስ ሄሮድሲን፣ “አት እሼ ፉዹንኬ ሴረ ምት” ጄቻ ቱሬፍ። <verse eid="MAT 14:4"/><verse number="5" style="v" sid="MAT 14:5"/>እንሞ ዮሀንስን አጄሱ በርባዴ፤ ገሩ ሰበቢ ነሞትን ዮሀንስን አከ ራጂት እላላ ቱረኒፍ እሳን ሶዳቴ።<verse eid="MAT 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6"/>እንተል ሄሮድያዳ ጉያ ዸሎተ ሄሮድስት ኬሱሞተ ዱረት ስርብቴ ሄሮድስን ገመቺፍቴ፤ <verse eid="MAT 14:6"/><verse number="7" style="v" sid="MAT 14:7"/>ከናፉ እን ዋን እሼን ጋፈቴ ከምዩ እሼፍ ኬኑፍ ከኩዻን ዋዳ ገሌ። <verse eid="MAT 14:7"/><verse number="8" style="v" sid="MAT 14:8"/>እሼንስ ሃዸሼቲን ጎርፈምቴ፣ “መታ ዮሀንስ ጩጳ ገበቴረ ካኢ ና ኬን” ጄቴ። <verse eid="MAT 14:8"/><verse number="9" style="v" sid="MAT 14:9"/>ሞትችስ ንገዴ፤ ገሩ ሰበቢ ከኩሳቲፊ ሰበቢ ወረ እሰ ወጅን ማዲት ዽኣተኒቲፍ ጄዼ አከ ወን እሼን በርባዴ ሱን እሼፍ ኬነሙ አጀጄ፤ <verse eid="MAT 14:9"/><verse number="10" style="v" sid="MAT 14:10"/>እንስ ነመ ኤርጌ መነ ህዻ ኬሰት መታ ዮሀንስ እሰራ ኩቴ። <verse eid="MAT 14:10"/><verse number="11" style="v" sid="MAT 14:11"/>መታንሳስ ገበቴረ ካአሜ ፍደሜ እንተለቲት ኬነሜ፤ እሼንስ ሃዸሼት ጌስቴ። <verse eid="MAT 14:11"/><verse number="12" style="v" sid="MAT 14:12"/>በረቶትን ዮሀንስስ ዹፈኒ ሬፈሳ ፉዸኒ አዋለን። እሳንስ ዸቀኒ ዬሱስት ህመን።<verse eid="MAT 14:12"/></para>
  <para style="s1">ዬሱስ ነመ ኩመ ሸን ሶሩሳ</para>
  <para style="r">
    <ref loc="MAT 14:13-21">14፥13‑21</ref> ኩወፈ – <char style="xt"><ref loc="MRK 6:32-44">ማር 6፥32‑44</ref>፤ <ref loc="LUK 9:10-17">ሉቃ 9፥10‑17</ref>፤ <ref loc="JHN 6:1-13">ዮሀ 6፥1‑13</ref></char></para>
  <para style="r">
    <ref loc="MAT 14:13-21">14፥13‑21</ref> ኩወእ – <char style="xt"><ref loc="MAT 15:32-38">ማቴ 15፥32‑38</ref></char></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13"/>ዬሱስ ዮሙ ዋን ከነ ዸገኤት አቺ ከኤ ኮጳሳ ብድሩዻን እዶ ነምን ህንጅሬ ቶኮ ዸቄ። ነሞትንስ ዮሙ ዋን ከነ ዸገአንት መጋላወኒ በአኒ ሚላን እሰ ዱካ ቡአን። <verse eid="MAT 14:13"/><verse number="14" style="v" sid="MAT 14:14"/>ዬሱስ ዮሙ ብድሩራ ቡኤት ቱተ ጉዳ ቶኮ አርጌ፤ እንስ ገራ ላፌፊ ዹኩብሰቶተሳኒ ፈይሴፍ።<verse eid="MAT 14:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15"/>ዮሙ ገልገላኤት በረቶትን ገረሳ ዹፈኒ፣ “እዶን ኩን ገሞጂዸ፤ አዱንስ ዺቴርት። ነሞትን ኩኔን ገረ ገንዶታ ዸቀኒ አከ ኛተ ብተተኒፍ እሳን ገድ ዺስ” ጄዸኒን።<verse eid="MAT 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16"/>ዬሱስ ገሩ፣ <char style="wj">“ዴሙን እሳን ህንበርባችሱ። እስኑ ዋን እሳን ኛተን ኬናፊ”</char> ጄዼ ዴብሴ።<verse eid="MAT 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17"/>እሳንስ፣ “ኑ ቡዴነ ሸኒፊ ቁርጡሚ ለመ ቆፈ አሲ ቀብነ” ጄዸኒ ዴብሰን።<verse eid="MAT 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18"/>ዬሱስስ፣ <char style="wj">“እሱመ ነት ፍዳ”</char> ጄዼ። <verse eid="MAT 14:18"/><verse number="19" style="v" sid="MAT 14:19"/>እንስ አከ ነሞትን መርገረ ተታአን አጀጄ ቡዴነ ሸነኒፊ ቁርጡሚ ለማን ሰነ ፉዼ፣ ገረ ሰሚ ኦል እላሌ ገለተ ገልቼ ቡዴነ ሰነ ጨጨብሴስ በረቶተት ኬኔ፤ በረቶትንሞ ነሞታፍ ኬነን። <verse eid="MAT 14:19"/><verse number="20" style="v" sid="MAT 14:20"/>እሳን ሁንድ ኛተኒ ቁፈን፤ በረቶትንስ ሁራኣ ሀምብፈሜ ጉንዶ ኩዸ ለመ ጉቱ ወልት ቀበን። <verse eid="MAT 14:20"/><verse number="21" style="v" sid="MAT 14:21"/>ወር ኛተንስ ዱበርቶታፊ እጆሌ መሌ ገረ ዺረ ኩመ ሸኒ ቱረን።<verse eid="MAT 14:21"/></para>
  <para style="s1">ዬሱስ ብሻንረ ዴሜ</para>
  <para style="r">
    <ref loc="MAT 14:22-33">14፥22‑33</ref> ኩወፈ – <char style="xt"><ref loc="MRK 6:45-51">ማር 6፥45‑51</ref>፤ <ref loc="JHN 6:15-21">ዮሀ 6፥15‑21</ref></char></para>
  <para style="r">
    <ref loc="MAT 14:34-36">14፥34‑36</ref> ኩወፈ – <char style="xt"><ref loc="MRK 6:53-56">ማር 6፥53‑56</ref></char></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22"/>ዬሱስ ዮሙሱመ አከ በረቶትን ብድሩ ያበተኒ ሀመ እን ቱተ ሰነ ኦፍራ ጌጌሱት እሰ ዱረ ገመት ደርበኒፍ እሳን ድርቅሲሴ። <verse eid="MAT 14:22"/><verse number="23" style="v" sid="MAT 14:23"/>እንስ ኤርገ ነሞተ ኦፍራ ጌጌሴ ቦዴ ከዸቹፍ ኮጳሳ ጋረት ኦል በኤ። ዮሙ ገልገላኤትስ ኮጳሳ አች ቱሬ፤ <verse eid="MAT 14:23"/><verse number="24" style="v" sid="MAT 14:24"/>ዬሮ ከነትሞ ብድሩን ሱን ለፈራ ጥኖ አች ሂቅጤ ቱርቴ፤ ሰበቢ ቡቤን ፉለ ዱራን እት ቡብሴፍ ብድሩን ሱን ደምበሊዻን አሲፊ አች ራፈማ ቱርቴ።<verse eid="MAT 14:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25"/>ዬሱስስ ሀልከን ኬሳ ኩታ አፉረፋት ገላነረ ዴማ ገረሳኒ ዹፌ። <verse eid="MAT 14:25"/><verse number="26" style="v" sid="MAT 14:26"/>በረቶትንስ ዮሙ ገላነረ ዴሙሳ አርገንት አከ መሌ ርፈተን። ሶዳተኒስ፣ “ኩን ኤኬራዸ” ጄዸኒ እየን።<verse eid="MAT 14:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27"/>ዬሱስ ገሩ ዮሙሱመ፣ <char style="wj">“ጀባዻ! አኑማቲ ህንሶዳትና”</char> ጄዼ እሳንት ዱበቴ።<verse eid="MAT 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28"/>ጴጥሮስሞ፣ “ያ ጎፍታ! ኤጋ ስ ታናን፣ አከ አን ብሻንረ ዴሜ ገረኬ ዹፉ ነ አጀጅ” ጄዼ ዴብሴፍ።<verse eid="MAT 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29"/>ዬሱስስ፣ <char style="wj">“ኮቱ”</char> ጄዼን።</para>
  <para style="p" vid="MAT 14:29">ጴጥሮስሞ ብድሩ ሰነራ ቡኤ ብሻንረ ዴማ ገረ ዬሱስ ዹፌ። <verse eid="MAT 14:29"/><verse number="30" style="v" sid="MAT 14:30"/>ዮሙ ቡቤ ጀባ ሰነ አርጌት ገሩ ንሶዳቴ፤ ልቅምፈሙ ጀልቀብናንስ፣ “ያ ጎፍታ ነ ኦልች!” ጄዼ እዬ።<verse eid="MAT 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31"/>ዬሱስ ዮሙሱመ ሀርከሳ ሂጠቴ እሰ ቀቤ፣ <char style="wj">“ያ ነምቸ አመንቲ ጥኖነነ፣ አት ማሊፍ መምቴ?”</char> ጄዼን።<verse eid="MAT 14:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32"/>ዮሙ እሳን ብድሩ ያበተንትስ ቡቤን ሱን ገብ ጄዼ። <verse eid="MAT 14:32"/><verse number="33" style="v" sid="MAT 14:33"/>ወር ብድሩ ሰነ ኬሰ ቱረንስ፣ “አት ዹጉመ እልመ ዋቃት!” ጄዸኒ እሳፍ ሰገደን።<verse eid="MAT 14:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34"/>እሳንስ ዮሙ ገመ ጬአንት ጌንሴሬጥት ብድሩራ ቡአን። <verse eid="MAT 14:34"/><verse number="35" style="v" sid="MAT 14:35"/>ነሞትን እዶ ሰናስ ዮሙ ዬሱስን ቤከንት ብየ ናኖ ሰና ሁንደት ዻምሰ ኤርገን። ነሞትንስ ዹኩብሰቶተሳኒ ሁንደ እሰት ፍደን፤ <verse eid="MAT 14:35"/><verse number="36" style="v" sid="MAT 14:36"/>አከ ዹኩብሰቶትን ሱን ሀንዳረ ወያሳሌ ቱቀኒፍ እሰ ከዸተን፤ ወር ሀንዳረ ወያሳ ቱቀን ሁንድኑስ ንፈየን።<verse eid="MAT 14:36"/></para>
  <chapter eid="MAT 14"/>
  <chapter number="15" style="c" sid="MAT 15"/>
  <para style="s1">ወንቶተ ነመ ጡሬሰን</para>
  <para style="r">
    <ref loc="MAT 15:1-20">15፥1‑20</ref> ኩወፈ – <char style="xt"><ref loc="MRK 7:1-23">ማር 7፥1‑23</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1"/>ኤርገሲ ፈሪሶትኒፊ በርሲስቶትን ሴራ ቶኮ ቶኮ ዬሩሳሌሚ ገረ ዬሱስ ዹፈኒ፣ <verse eid="MAT 15:1"/><verse number="2" style="v" sid="MAT 15:2"/>“በረቶትንኬ ማሊፍ ዱዻ ማንጉዶታ ጨብሱ? እሳን ዮሙ ቡዴነ ኛተንት ሀርከ ህንዽቀተኒቲ!” ጄዸን።<verse eid="MAT 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3"/>ዬሱስስ አከነ ጄዼ ዴብሴ፤ <char style="wj">“እስንስ ማሊፍ ዱዻኬሰኒፍ ጄተኒ አጀጀ ዋቃ ጨብስቱ?</char> <verse eid="MAT 15:3"/><verse number="4" style="v" sid="MAT 15:4"/><char style="wj">ዋቅን፣ ‘አባኬቲፊ ሃዸኬቲፍ ኡልፍነ ኬን፤</char><note caller="+" style="f"><char style="fr" closed="false">15፥4 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 20:12">በኡ 20፥12</ref>፤ <ref loc="DEU 5:16">ኬዴ 5፥16</ref></char></char></note> <char style="wj">ነምን አባሳ ዮካን ሃዸሳ አረብሱ ከምዩ ሃአጄፈሙ’</char><note caller="+" style="f"><char style="fr" closed="false">15፥4 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 21:17">በኡ 21፥17</ref>፤ <ref loc="LEV 20:9">ሌዎ 20፥9</ref></char></char></note> <char style="wj">ጄዼራቲ።</char> <verse eid="MAT 15:4"/><verse number="5" style="v" sid="MAT 15:5"/><char style="wj">እስን ገሩ ዮ ነምን ከምዩ አከ ወን ስላ አባሳቲፍ ዮካን ሃዸሳቲፍ ኬነሙ መሉ ‘ዋቃፍ ኬነሜረ’ ጄዼ ዱበቴ፣</char> <verse eid="MAT 15:5"/><verse number="6" style="v" sid="MAT 15:6"/><char style="wj">እን ዋን ሰናን አባሳቲፍ ዮካን ሃዸሳቲፍ ኡልፍነ ኬኑ ህንቀቡ ጄቱ። አከናንስ እስን ዱዻኬሰኒፍ ጄተኒ ዱቢ ዋቃ ቡሼስቱ።</char> <verse eid="MAT 15:6"/><verse number="7" style="v" sid="MAT 15:7"/><char style="wj">ያ ፈኬስቶተ! እሳያስ ዮሙ ዋኤኬሰን ራጂ ዱበቴት ስሪ ቱሬ፤ እንስ አከነ ጄዼ፦</char><verse eid="MAT 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8"/>
    <char style="wj">“ ‘ኡመትን ኩን ህዺሳቲን ነ ከበጀ፤</char></para>
  <para style="q2" vid="MAT 15:8">
    <char style="wj">ገራንሳ ገሩ ነራ ፈጎ ጅረ።</char><verse eid="MAT 15:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9"/>
    <char style="wj">እሳን አከኑማን ነ ዋቄፈቱ፤</char></para>
  <para style="q2" vid="MAT 15:9">
    <char style="wj">በርሲስንሳኒስ ስርኑመ ነማት።’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">15፥9 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="ISA 29:13">እሳ 29፥13</ref>
        </char>
      </char>
    </note>
    <char style="wj">”</char><verse eid="MAT 15:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10"/>ዬሱስስ ቱተ ሰነ ኦፍት ዋሜ አከነ ጄዼን፤ <char style="wj">“ዸገኣ፤ ሁበዻስ።</char> <verse eid="MAT 15:10"/><verse number="11" style="v" sid="MAT 15:11"/><char style="wj">ዋን አፋን ነማ ኬሳ በኡቱ ነመ ጡሬሰ መሌ ወን አፋን ነማ ሴኑ ነመ ህንጡሬሱ።”</char><verse eid="MAT 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12"/>ኤርገሲ በረቶትን ገረሳ ዹፈኒ፣ “አት አከ ፈሪሶትን ዱቢ ከነ ዸገአኒ ሙፈተን ቤክታ?” ጄዸኒ ጋፈተን።<verse eid="MAT 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13"/>እንስ ዴብሴ አከነ ጄዼ፤ <char style="wj">“ብቅልቱን አባንኮ እን ሰሚራ ህንዻብን ሁንድኑ ንቡቅፈመ።</char> <verse eid="MAT 15:13"/><verse number="14" style="v" sid="MAT 15:14"/><char style="wj">እሳን ዺሳ፤ እሳን ቀጄልችቶተ ጃሞተ። ጃማን ዮ ጃማ ቀጄልቼ፣ እሳን ለቹ ቦለ ኬሰ ቡኡ።”</char><verse eid="MAT 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15"/>ጴጥሮስስ፣ “ሜ ሂካ ፈኬኘ ከና ኑ እብስ” ጄዼን።<verse eid="MAT 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16"/>ዬሱስሞ አከነ ጄዼ እሳን ጋፈቴ፤ <char style="wj">“እስንስ ሀመ አማት ህንሁበተኒ?</char> <verse eid="MAT 15:16"/><verse number="17" style="v" sid="MAT 15:17"/><char style="wj">አከ ወን አፋን ሴኑ ከምዩ ገራ ሴኔ አቹማን ደርቤ ዸግነ ኬሳ በኡ ህንአርግተኒ?</char> <verse eid="MAT 15:17"/><verse number="18" style="v" sid="MAT 15:18"/><char style="wj">ወን አፋን ነማቲ በኡ ገሩ ነመ ኬሳ በአ፤ ነምቸስ ንጡሬሰ።</char> <verse eid="MAT 15:18"/><verse number="19" style="v" sid="MAT 15:19"/><char style="wj">ሰበቢንሳስ ያድን ሀማን ጄቹንስ አጄሱን፣ ኤጁማን፣ ሀለሉማን፣ ሀትን፣ ሶባን ዹጋ በኡን፣ መቃ ነመ በሌሱን ገራ ነማ ኬሳ በኣቲ።</char> <verse eid="MAT 15:19"/><verse number="20" style="v" sid="MAT 15:20"/><char style="wj">ወንቶተ ከኔንቱ ነመ ‘ጡሬሰ’ መሌ ኡቱ ሀርከ ህንዽቀትን ኛቹን ነመ ህንጡሬሱ።”</char><verse eid="MAT 15:20"/></para>
  <para style="s1">አመንቲ ዱበርቲ ከነኣን ቶኮ</para>
  <para style="r">
    <ref loc="MAT 15:21-28">15፥21‑28</ref> ኩወፈ – <char style="xt"><ref loc="MRK 7:24-30">ማር 7፥24‑30</ref></char></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21"/>ዬሱስስ እዶ ሰና ከኤ ገረ ብየ ጢሮሲፊ ሲዶናት ቀጄሌ። <verse eid="MAT 15:21"/><verse number="22" style="v" sid="MAT 15:22"/>ኩኖ፣ ዱበርቲን ከነኣን ቶኮ ናኖ ሰና ገረሳ ዹፍቴ እያ፣ “ያ ጎፍታ፣ ያ እልመ ዳዊት፣ እንተልኮ ሀፉረ ሀማዻን ቀበምቴ አከ መሌ ዽጰቻ ጅርት፤ ነ ማር!” ጄቴ።<verse eid="MAT 15:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23"/>ዬሱስ ገሩ ዴቢ ቶኮሌ ህንኬንኔፍ። በረቶትንሳስ ገረሳ ዹፈኒ፣ “ኩኖ እሼን እያ ኑ ፋነ ዴምቲቲ አች ዴብስ” ጄዸኒ እሰ ከዸተን።<verse eid="MAT 15:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24"/>እንሞ፣ <char style="wj">“አን ሆሎተ መነ እስራኤል ከኔን በደን ሰነ ቆፋፈን ኤርገሜ”</char> ጄዼ ዴብሴ።<verse eid="MAT 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25"/>ዱበርቲን ሱንስ ዹፍቴ ሰገዴፊ፣ “ያ ጎፍታ ነ ገርጋር!” ጄቴ።<verse eid="MAT 15:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26"/>እንስ፣ <char style="wj">“ቡዴነ እጆሌ ፉዸኒ ሰሮተ ዱረ ቡሱን ስሪ ምት”</char> ጄዼ ዴብሴ።<verse eid="MAT 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27"/>እሼንስ፣ “ኤዬ ያ ጎፍታ፣ ሰሮትንዩ ሀምባ ማዲ ጎፍቶተሳኒራ ሀርጨኡ ኛቱ” ጄቴ ዴብፍቴፍ።<verse eid="MAT 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28"/>ዬሱስስ፣ <char style="wj">“ዱበርቲነነ፣ አመንቲንኬ ጉዳዸ! አኩመ ፌዺኬቲ ሲፍ ሃተኡ”</char> ጄዼ ዴብሴ። እንተልሼስ ሰኣቲዹመ ሰነ ፈይቴ።<verse eid="MAT 15:28"/></para>
  <para style="s1">ዬሱስ ነመ ኩመ አፉር ሶሬ</para>
  <para style="r">
    <ref loc="MAT 15:29-31">15፥29‑31</ref> ኩወፈ – <char style="xt"><ref loc="MRK 7:31-37">ማር 7፥31‑37</ref></char></para>
  <para style="r">
    <ref loc="MAT 15:32-39">15፥32‑39</ref> ኩወፈ – <char style="xt"><ref loc="MRK 8:1-10">ማር 8፥1‑10</ref></char></para>
  <para style="r">
    <ref loc="MAT 15:32-39">15፥32‑39</ref> ኩወእ – <char style="xt"><ref loc="MAT 14:13-21">ማቴ 14፥13‑21</ref></char></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29"/>ዬሱስ አቺ ከኤ ገረ ገላነ ገሊላ ዸቄ። ጋረትስ ኦል በኤ ታኤ። <verse eid="MAT 15:29"/><verse number="30" style="v" sid="MAT 15:30"/>ነሞትን ሄዱንስ ወረ ኦኮለን፣ ወረ ጃመን፣ ወረ ናፈተን፣ ወረ አረብንሳኒ ዱበቹ ድዴፊ ከኔን ብራ ሄዱ ፍደኒ ሚለ ዬሱስ ጀለ ካአን፤ እንስ እሳን ፈይሴ። <verse eid="MAT 15:30"/><verse number="31" style="v" sid="MAT 15:31"/>ነሞትን ሱንስ ዮሙ አከ ወር አረብን ህንዱበትኔ ዱበተን፣ ወር ናፈተን ፈየን፣ ወር ኦኮለን ዴመን፣ ወረ ጃመኒፍሞ አከ እጅሳኒ በነሜ አርገንት ንድንቅፈተን። ዋቀ እስራኤሊፍስ ኡልፍነ ኬነን።<verse eid="MAT 15:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32"/>ዬሱስ በረቶተሳ ኦፍት ዋሜ፣ <char style="wj">“አን ነሞተ ከኔኒፍ ገራ ነንላፈ፤ እሳን ጉያ ሰዲ ነ ብረ ቱረን፤ ዋን ኛተን ቶኮሌ ህንቀበን። አከ እሳን ከራረት ህንገገብኔፍስ አን አገቡሳኒ ገድ እሳን ዺሱ ህንበርባዱ”</char> ጄዼ።<verse eid="MAT 15:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33"/>በረቶትንሳስ ዴብሰኒ፣ “ቡዴነ ቱተ ጉዳ አከና ገኡ ገሞጂ ከነ ኬሰት ኤሳ አርገቹ ደንዴኘ?” ጄዸን።<verse eid="MAT 15:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34"/>ዬሱስሞ፣ <char style="wj">“እስን ቡዴነ ሜቀ ቀብዱ?”</char> ጄዼ ጋፈቴ።</para>
  <para style="p" vid="MAT 15:34">እሳንስ ዴብሰኒ፣ “ቡዴነ ቶርባፊ ቁርጡሚ ጥጥኖ ሙራሰ ቀብነ” ጄዸን።<verse eid="MAT 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35"/>እንስ አከ ነሞትን ሱን ለፈ ተታአን እት ህሜ። <verse eid="MAT 15:35"/><verse number="36" style="v" sid="MAT 15:36"/>ኤርገሲ ቡዴነ ቶርበኒፊ ቁርጡሚ ሰነ ፉዼ ኤርገ ገለቴፈቴ ቦዴ ኩኩቴ በረቶተት ኬኔ፤ እሳንስ ነሞታፍ ኬነን። <verse eid="MAT 15:36"/><verse number="37" style="v" sid="MAT 15:37"/>እሳን ሁንድ ኛተኒ ቁፈን። ኤርገሲስ በረቶትን ሀምባ ጉንዶ ቶርበ ጉቱ ወልት ቀበን። <verse eid="MAT 15:37"/><verse number="38" style="v" sid="MAT 15:38"/>ባይእን ወረ ኛተኒስ እጆሌፊ ዱበርቶተ መሌ ዺረ ኩመ አፉር ቱሬ። <verse eid="MAT 15:38"/><verse number="39" style="v" sid="MAT 15:39"/>ዬሱስ ኤርገ ቱተ ሰነ ኦፍራ ጌጌሴ ቦዴ ብድሩ ያበቴ ናኖ መጌዶል ዸቄ።<verse eid="MAT 15:39"/></para>
  <chapter eid="MAT 15"/>
  <chapter number="16" style="c" sid="MAT 16"/>
  <para style="s1">መለቶን ጋፈተሙሳ</para>
  <para style="r">
    <ref loc="MAT 16:1-12">16፥1‑12</ref> ኩወፈ – <char style="xt"><ref loc="MRK 8:11-21">ማር 8፥11‑21</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1"/>ፈሪሶትኒፊ ሰዱቆትን ገረ ዬሱስ ዹፈኒ አከ እን ሰሚራ መለቶ እሳን አርግሲሱ ጋፈቹዻን እሰ ቆረን።<verse eid="MAT 16:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 16:2"/>እንስ አከነ ጄዼ ዴብሴ፤ <char style="wj">“እስን ዬሮ ለፍት ገልገላኡት፣ ‘ሰሚን ዲመቴረ፤ ጫመ ተአ’ ጄቱ፤</char> <verse eid="MAT 16:2"/><verse number="3" style="v" sid="MAT 16:3"/><char style="wj">ገነመሞ፣ ‘ሰሚን ዲመቴ ዱሜሳኤራቲ ሀርአ ቦካን ጀባን ንሮበ’ ጄቱ። እስን ብፈ ሰሚ አዳን ባሱ ንቤክቱ፤ ገሩ መለቶ በራ አዳን ባሱ ህንደንዴሰን።</char> <verse eid="MAT 16:3"/><verse number="4" style="v" sid="MAT 16:4"/><char style="wj">ዸሎትን ሀማፊ ኤጃን መለቶ በርባደ፤ ገሩ መለቶ ዮናስ መሌ መለቶን ህንኬነሙፍ።”</char> ዬሱስስ እሳን ዺሴ ዴሜ።<verse eid="MAT 16:4"/></para>
  <para style="s1">ራጭቲ ፈሪሶታቲፊ ሰዱቆታ</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5"/>በረቶትን ዮሙ ገላንቸ ጬአንት ቡዴነ ፉዸቹ እራንፈተን። <verse eid="MAT 16:5"/><verse number="6" style="v" sid="MAT 16:6"/>ዬሱስስ፣ <char style="wj">“ቤከዻ፤ ራጭቲ ፈሪሶታቲፊ ሰዱቆታራ ኦፍ ኤገዻ”</char> እሳኒን ጄዼ።<verse eid="MAT 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7"/>እሳንስ፣ “ኩን ሰበቢ ኑ ቡዴነ ህንፍደትኒፍ” ጄዸኒ ዋን ከነ ወሊ ወጅን ሃሰአን።<verse eid="MAT 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8"/>ዬሱስስ ዋን እሳን ሃሰአን ቤኬ አከነ ጄዼ ጋፈቴ፤ <char style="wj">“ያ ወረ አመንቲ ጥኖነነ፣ እስን ማሊፍ ዋኤ ቡዴነ ዸቡኬሰኒ ወሊ ወጅን ዱዱበቱ?</char> <verse eid="MAT 16:8"/><verse number="9" style="v" sid="MAT 16:9"/><char style="wj">እስን አመዩ ህንሁበተኒ? ቡዴን ሸን ነመ ኩመ ሸኒፍ ዽኤፈሜ ጉንዶ ሀመም ጉቱ አከ ወልት ቀብደን ህንያደተኒ?</char> <verse eid="MAT 16:9"/><verse number="10" style="v" sid="MAT 16:10"/><char style="wj">ዮካን ቡዴን ቶርበ ነመ ኩመ አፉሪፍ ዽኤፈሜ ሀምባ ጉንዶ ሀመም ጉቱ አከ ወልት ቀብደን ህንያደተኒ?</char> <verse eid="MAT 16:10"/><verse number="11" style="v" sid="MAT 16:11"/><char style="wj">አከ አን ዋኤ ቡዴና እስንት ዱበቻ ህንቱርን እስን አከምት ህንሁበትኔ? ገሩ ራጭቲ ፈሪሶታቲፊ ሰዱቆታራ ኦፍ ኤገዻ።”</char> <verse eid="MAT 16:11"/><verse number="12" style="v" sid="MAT 16:12"/>እሳንስ ኤርገሲ አከ እን አከ እሳን ራጭቲ ቡዴናራ ኦፍ ኤገተኒፍ ኡቱ ህንተእን አከ በርሲሰ ፈሪሶታቲፊ ሰዱቆታራ ኦፍ ኤገተኒፍ እሳንት ህማ ቱሬ ሁበተን።<verse eid="MAT 16:12"/></para>
  <para style="s1">ጴጥሮስ ኤኙማ ክርስቶስ ቤክስሴ</para>
  <para style="r">
    <ref loc="MAT 16:13-16">16፥13‑16</ref> ኩወፈ – <char style="xt"><ref loc="MRK 8:27-29">ማር 8፥27‑29</ref>፤ <ref loc="LUK 9:18-20">ሉቃ 9፥18‑20</ref></char></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13"/>ዬሱስ ዬሮ ገረ ብየ ፊልጶስ ቂሳርያ ዹፌት፣ <char style="wj">“ነሞትን እልመ ነማቲን ኤኙ ጄዹ?”</char> ጄዼ በረቶተሳ ጋፈቴ።<verse eid="MAT 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14"/>እሳንስ፣ “ነሞትን ቶኮ ቶኮ እን ዮሀንስ ጩጳዸ ጄዹ፤ ወር ካን እን ኤልያስ ጄዹ፤ ካንሞ እን ኤርምያስ ዮካን ራጆተ ኬሳ እሰ ቶኮዸ ጄዹ” ጄዸኒ ዴብሰን።<verse eid="MAT 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15"/>እንስ፣ <char style="wj">“እስንሆ? ኤኙ አናን ጄቱ?”</char> ጄዼ ጋፈቴ።<verse eid="MAT 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16"/>ስሞን ጴጥሮስስ፣ “አት ክርስቶስ፣ እልመ ዋቀ ጅራታት” ጄዼ ዴብሴ።<verse eid="MAT 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17"/>ዬሱስሞ አከነ ጄዼ ዴብሴፍ፤ <char style="wj">“ያ ስሞን እልመ ዮና፣ አት ኤብፈማዸ፤ ከነ አባኮ እሰ ሰሚራቱ ሲፍ እብሴ መሌ ነመ ምት።</char> <verse eid="MAT 16:17"/><verse number="18" style="v" sid="MAT 16:18"/><char style="wj">አን ስትን ህመ፤ አት ጴጥሮሲዸ፤ ከታ ከነረት ወልዳ ክርስታናኮ ነንእጃረ፤ ከር ገሃነምስ እሼ ህንሞአቱ።</char> <verse eid="MAT 16:18"/><verse number="19" style="v" sid="MAT 16:19"/><char style="wj">አን ፉርቱ ሞቱማ ሰሚ ሲፍን ኬነ፤ ወን አት ለፈረት ሂቱ ከምዩ ሰሚረት ንህዸመ፤ ወን አት ለፈረት ሂክቱ ከምዩ ሰሚረትስ ንሂከመ።”</char> <verse eid="MAT 16:19"/><verse number="20" style="v" sid="MAT 16:20"/>ኤርገሲስ አከ እሳን አከ እን ክርስቶስ ተኤ ነመ ቶኮትሌ ህንህምኔፍ በረቶተሳ አኬከቺሴ።<verse eid="MAT 16:20"/></para>
  <para style="s1">ዬሱስ ዱራን ዱርሴ ዋኤ ዱአሳ ዱበቴ</para>
  <para style="r">
    <ref loc="MAT 16:21-28">16፥21‑28</ref> ኩወፈ – <char style="xt"><ref loc="MRK 8:31-9:1">ማር 8፥31–9፥1</ref>፤ <ref loc="LUK 9:22-27">ሉቃ 9፥22‑27</ref></char></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21"/>ዬሱስ ዬሮ ሰና ጀልቀቤ አከ ዬሩሳሌም ዸቄ ሀርከ ማንጉዶታት፣ ሀርከ ሉቦተ ሀንገፎታቲፊ ሀርከ በርሲስቶተ ሴራት ዋን ሄዱን ዽጰቹ ቀቡ፣ አከ አጄፈሙ ቀቡፊ አከ ጉያ ሰደፋትሞ ዱኣ ካፈሙ በረቶተሳቲፍ እብሱ ጀልቀቤ።<verse eid="MAT 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22"/>ጴጥሮስስ ኮጳት ባሴ፣ “ያ ጎፍታ፣ ኩን ጎንኩማ ህንተእን! ኩን ስራ ሃፈጋቱ!” ጄዼ እሰ እፈቹ ጀልቀቤ።<verse eid="MAT 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23"/>ዬሱስ ገሩ ኦፍረ ገረገሌ ጴጥሮሲን፣ <char style="wj">“ያ ሴጠነነነ! ነ ዱበት ዴብእ! አት ጉፉ ነት ታቴርተ፤ አት ከን ነማ ያደ መሌ ከን ዋቃ ህንያዱቲ”</char> ጄዼ።<verse eid="MAT 16:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24"/>ኤርገሲ ዬሱስ በረቶተሳቲን አከነ ጄዼ፤ <char style="wj">“ነምን ከምዩ ዮ ነ ፋነ ዹፉ በርባዴ፣ እን ኦፍ ሃገኑ። ፈኖ ኦፊሳ ባዸቴስ ነ ዱካ ሃቡኡ።</char> <verse eid="MAT 16:24"/><verse number="25" style="v" sid="MAT 16:25"/><char style="wj">ነምን ሉቡሳ ኦልፈቹ በርባዱ ከምዩ ሉቡሳ ንዸባቲ፤ ገሩ ነምን ናፍ ጄዼ ሉቡሳ ዸቡ ከምዩ ሉቡሳ ንአርገተ።</char> <verse eid="MAT 16:25"/><verse number="26" style="v" sid="MAT 16:26"/><char style="wj">ነምን ዮ አዱኛ ጉቱ አርገቴ ሉቡሳሞ ዸቤ፣ ቡኣንሳ ማል? ዮካን ነምን ቆደ ሉቡሳ ማል ኬኑ ደንደአ?</char> <verse eid="MAT 16:26"/><verse number="27" style="v" sid="MAT 16:27"/><char style="wj">እልም ነማ ኡልፍነ አባሳቲን ኤርገሞተሳ ወጅን ዹፉፍ ጅራቲ፤ እንስ ዬሮ ሰነ ቶኮ ቶኮ ነማቲፍ አኩመ ሆጂሳት ገቲሳ ንኬነ።</char><verse eid="MAT 16:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 16:28"/>
    <char style="wj">“አን ዹጉመን እስንት ህመ፤ ወረ አስ ዸዻበቻ ጅረን ኬሳ ነሞትን ቶኮ ቶኮ ሀመ ኡቱ እልም ነማ ሞቱማሳቲን ዹፉ አርገንት ዱአ ህንዸንዸመን።”</char><verse eid="MAT 16:28"/></para>
  <chapter eid="MAT 16"/>
  <chapter number="17" style="c" sid="MAT 17"/>
  <para style="s1">ብፍት ዬሱስ ጌደረሙሳ</para>
  <para style="r">
    <ref loc="MAT 17:1-8">17፥1‑8</ref> ኩወፈ – <char style="xt"><ref loc="LUK 9:28-36">ሉቃ 9፥28‑36</ref></char></para>
  <para style="r">
    <ref loc="MAT 17:1-13">17፥1‑13</ref> ኩወፈ – <char style="xt"><ref loc="MRK 9:2-13">ማር 9፥2‑13</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1"/>ዬሱስ ጉያ ጀአ ቦዴ ጴጥሮስን፣ ያቆቢፊ ዮሀንስ ኦቦሌሰ ያቆብ ፉዸቴ ኮጳሳኒ ቱሉ ዼራ ቶኮት ኦል ባሴ። <verse eid="MAT 17:1"/><verse number="2" style="v" sid="MAT 17:2"/>እንስ አችት ፉለሳኒ ዱረት ጌደረሜ። ፉልሳ አከ አዱ እፌ፤ ኡፈትንሳስ አኩመ እፋ አዳቴ። <verse eid="MAT 17:2"/><verse number="3" style="v" sid="MAT 17:3"/>ኩኖ ሙሴፊ ኤልያስ ኡቱ ዬሱስ ወጅን ሃሰአኑ እሳንት ሙልአተን።<verse eid="MAT 17:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 17:4"/>ጴጥሮስስ ዬሱሲን፣ “ያ ጎፍታ፣ አስ ጅራቹን ኑፍ ጋሪዸ። ዮ ፌዺኬ ተኤ፣ አን ዳሲ ሰዲ ጄቹንስ ቶኮ ሲፍ፣ ቶኮ ሙሴፍ፣ ቶኮሞ ኤልያሲፍ አስት ነንእጃረ” ጄዼ።<verse eid="MAT 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5"/>ኡቱመ እን ዱበቻ ጅሩ ኩኖ፣ ዱሜስ እፋን ቶኮ እሳን ሀጉጌ፤ ዱሜስቸ ኬሳስ ሰገሌን ቶኮ፣ “ኩን እልመኮ እሰ አን ጃለዹዸ፤ አን እሰት ባይኤ ነንገመደ። እስንስ እሰ ዸገኣ!” ጄዼ።<verse eid="MAT 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6"/>በረቶትንስ ዮሙ ዋን ከነ ዸገአንት አከ መሌ ሶዳተኒ አደሳኒቲን ለፈት ጎምብፈመን። <verse eid="MAT 17:6"/><verse number="7" style="v" sid="MAT 17:7"/>ዬሱስ ገሩ እት ዽኣቴ እሳን ቱቄ፣ <char style="wj">“ከኣ! ህንሶዳትና”</char> ጄዼን። <verse eid="MAT 17:7"/><verse number="8" style="v" sid="MAT 17:8"/>እሳንስ ዮሙ ኦል ጄዸኒ እላለንት ዬሱስን መሌ ነመ ቶኮሌ ህንአርግኔ።<verse eid="MAT 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9"/>ኡቱ ቱሉ ሰነራ ቡኡት ጅረኑስ ዬሱስ፣ <char style="wj">“ሀመ እልም ነማ ወረ ዱአን ኬሳ ካፈሙት ዋን አርግተን ሰነ ነመ ቶኮትሌ ህንህምና”</char> ጄዼ እሳን ሴረቴ።<verse eid="MAT 17:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10"/>በረቶትንስ፣ “ዮስ በርሲስቶትን ሴራ ማሊፍ ኤልያስ አከ ዱራን ዱርሴ ዹፉ ቀቡ ዱበቱሬ?” ጄዸኒ እሰ ጋፈተን።<verse eid="MAT 17:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11"/>ዬሱስ አከነ ጄዼ ዴብሴ፤ <char style="wj">“ዹጉማን፣ ኤልያስ ዋን ሁንደ እዶት ዴብሱፍ ጄዼ ዱራን ዱርሴ ንዹፈ።</char> <verse eid="MAT 17:11"/><verse number="12" style="v" sid="MAT 17:12"/><char style="wj">አን ገሩ እስንትን ህመ፤ ኤልያስ አመዩ ዹፌረ፤ እሳንስ እሰ ህንሁበትኔ፤ ገሩ ዋኑመ ፌዸን ሁንደ እሰት ሆጄተን። እልም ነማስ አከሱመ ሀርከሳኒት ዽጰቹፍ ጅረ።”</char> <verse eid="MAT 17:12"/><verse number="13" style="v" sid="MAT 17:13"/>በረቶትንስ ኤርገሲ አከ ወን እን እሳንት ዱበቻ ቱሬ ሱን ዋኤ ዮሀንስ ጩጳ ተኤ ሁበተን።<verse eid="MAT 17:13"/></para>
  <para style="s1">ጉርባ ገገብዶዻን ቀበሜ ቶኮ</para>
  <para style="r">
    <ref loc="MAT 17:14-19">17፥14‑19</ref> ኩወፈ – <char style="xt"><ref loc="MRK 9:14-28">ማር 9፥14‑28</ref>፤ <ref loc="LUK 9:37-42">ሉቃ 9፥37‑42</ref></char></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14"/>ዮሙ እሳን ገረ ቱተ ሰና ዹፈንትስ ነምች ቶኮ ዬሱስት ዽኣቴ ፉለሳ ዱረት ጅልቤንፈቴ፤ <verse eid="MAT 17:14"/><verse number="15" style="v" sid="MAT 17:15"/>አከነስ ጄዼ፤ “ያ ጎፍታ፣ እልምኮ ገገብዶዻን ቀበሜ አከ መሌ ረከቻ ጅራቲ ናፍ ማር። ዬሮ ሄዱ እብደ ኬሰት ዮካን ብሻን ኬሰት ኩፈ። <verse eid="MAT 17:15"/><verse number="16" style="v" sid="MAT 17:16"/>አን በረቶተኬት እሰ ነንፍዴ፤ እሳን ገሩ እሰ ፈይሱ ህንደንዴኜ።”<verse eid="MAT 17:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17"/>ዬሱስስ ዴብሴ፣ <char style="wj">“እስን ዸሎተ ህንአመኔፊ ጀልኣነነ፤ አን ሀመ ዮሚትን እስን ወጅን ጅራዸ? ሀመ ዮሚትስ አን እስኒ ኦብሰ? ሜ ጉርብቸ አስ ነት ፍዳ!”</char> ጄዼ። <verse eid="MAT 17:17"/><verse number="18" style="v" sid="MAT 17:18"/>ዬሱስስ ሀፉረ ሀማ ሰነ እፈቴ፤ ሀፉር ሀማን ሱንስ ጉርባ ሰነ ኬሳ በኤ፤ ጉርብችስ ዮሙሱመ ፈዬ።<verse eid="MAT 17:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19"/>ኤርገሲስ በረቶትን ኮጳሳኒ ገረ ዬሱስ ዹፈኒ፣ “ኑ ማሊፍ ሀፉረ ሀማ ሰነ ባሱ ደዸብኔ?” ጄዸኒ እሰ ጋፈተን።<verse eid="MAT 17:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20"/>እንስ አከነ ጄዼ ዴብሴ፤ <char style="wj">“ሰበቢ አመንቲንኬሰን ጥናቴፊዸ። አን ዹጉመን እስንት ህመ፤ እስን ኡቱ አመንቲ ጥኖ ሀመ ሰኚ ሰናፍጫ ቀባተኒ ስላ ቱሉ ከናን፣ ‘አሲ ከኢ አች ደርብ’ ጄቹ ንደንዴሱ፤ እንስ ንደርበ። ወን እስኒፍ ህንደንደአምኔ ቶኮዩ ህንጅሩ።</char> [ <verse eid="MAT 17:20"/><verse number="21" style="v" sid="MAT 17:21"/><char style="wj">ሀፉር ሀማን አከና ገሩ ሶማፊ ከዸትናዻን መሌ ህንበኡ።”</char>]<note caller="+" style="f"><char style="fr" closed="false">17፥21 </char><char style="ft" closed="false">ወራብሌን ዱሪ ቶኮ ቶኮ ሉቅሳ 21 ህንቀበን።</char></note><verse eid="MAT 17:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22"/>ዬሮ እሳን ገሊላት ወልት ቀበመንት እን አከነ እሳኒን ጄዼ፤ <char style="wj">“እልም ነማ ደበርፈሜ ሀርከ ነሞታት ንኬነመ።</char> <verse eid="MAT 17:22"/><verse number="23" style="v" sid="MAT 17:23"/><char style="wj">እሳንስ እሰ ንአጄሱ፤ እንሞ ጉያ ሰደፋት ንካፈመ።”</char> በረቶትንስ አከ መሌ ገደን።<verse eid="MAT 17:23"/></para>
  <para style="s1">ግብረ መነ ቁልቁሉማ</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24"/>ዮሙ ዬሱሲፊ በረቶትንሳ ቅፍርናሆም ገአንት ቀረጦትን ገረ ጴጥሮስ ዹፈኒ፣ “በርሲሳንኬሰን ግብረ ህንከፈሉ?” ጄዸኒ ጋፈተን።<verse eid="MAT 17:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25"/>እንስ ዴብሴ፣ “ንከፈለ” ጄዼን።</para>
  <para style="p" vid="MAT 17:25">ዬሱስ ዮሙ ጴጥሮስ መነ ሴኔት ዱራን ዱርሴ፣ <char style="wj">“ያ ስሞን አት ማል ያደ? ሞቶትን ለፋ ኤኙራ ቀረጣፊ ግብረ ወልት ቀቡ? እጆሌሳኒራሞ ኬሱሞተራ ወልት ቀቡ?”</char> ጄዼ ጋፈቴ።<verse eid="MAT 17:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26"/>ጴጥሮስስ ዴብሴ፣ “ኬሱሞተራ ወልት ቀቡ” ጄዼ።</para>
  <para style="p" vid="MAT 17:26">ዬሱስስ አከነ ጄዼ ዴብሴፍ፤ <char style="wj">“ዮስ እጆሌንሳኒ ብልሰ።</char> <verse eid="MAT 17:26"/><verse number="27" style="v" sid="MAT 17:27"/><char style="wj">ገሩ ኑ አከ እሳን ህንሙፈቺፍኔፍ ዸቂቲ ኦኮ ገላነት ደርበዹ። ቁርጡሚ ጀልቀበት ቀብዱስ ፉዽ፤ ዮሙ አፋንሳ በንቱትስ ማለቀ አርገተ። ማለቀ ሰነስ ጌሲቲ አናፊ ኦፊኬቲፍ እሳንት ኬን።”</char><verse eid="MAT 17:27"/></para>
  <chapter eid="MAT 17"/>
  <chapter number="18" style="c" sid="MAT 18"/>
  <para style="s1">ነመ ሞቱማ ሰሚ ኬሰት ነመ ሁንደ ጫሉ</para>
  <para style="r">
    <ref loc="MAT 18:1-5">18፥1‑5</ref> ኩወፈ – <char style="xt"><ref loc="MRK 9:33-37">ማር 9፥33‑37</ref>፤ <ref loc="LUK 9:46-48">ሉቃ 9፥46‑48</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1"/>ዬሩመ ሰነ በረቶትን ገረ ዬሱስ ዹፈኒ፣ “ዮስ ሞቱማ ሰሚ ኬሰት ከን ሁንዱማ ጫሉ ኤኙ?” ጄዸኒ ጋፈተን።<verse eid="MAT 18:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2"/>እንስ ሙጫ ጥና ቶኮ ኦፍት ዋሜ እሳን ግዱ ዻቤ። <verse eid="MAT 18:2"/><verse number="3" style="v" sid="MAT 18:3"/>አከነስ ጄዼ፦ <char style="wj">“አን ዹጉመን እስንት ህመ፤ እስን ዮ ዴብተኒ አኩመ እጆሌ ታተን መሌ ጎንኩማ ሞቱማ ሰሚት ህንገልተን።</char> <verse eid="MAT 18:3"/><verse number="4" style="v" sid="MAT 18:4"/><char style="wj">ከናፍ ነምን አከ ዳእመ ከና ገድ ኦፍ ቀቡ ከምዩ ሞቱማ ሰሚ ኬሰት ነመ ሁንደ ጫለ።</char> <verse eid="MAT 18:4"/><verse number="5" style="v" sid="MAT 18:5"/><char style="wj">ነምን ዳእመ አከና ቶኮ መቃኮቲን ስመቱ ከምዩ ነ ስመተ።</char><verse eid="MAT 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6"/>
    <char style="wj">“ነምን ከምዩ ወረ ነት አመነን ጥጥና ከኔን ኬሳ ቶኮሌ ዮ ጉፈቺሴ፣ ዸጋን ዳኩ ጉዳንሳ ሞርመሳት ህዸሜ ቱጁበ ገላና ኬሰ ዽዽሙ እሳፍ ወየ ቱሬ።</char> <verse eid="MAT 18:6"/><verse number="7" style="v" sid="MAT 18:7"/><char style="wj">ሰበቢ ወንቶተ አከ ነሞትን ጉፈተን ጎዸን ሰናቲፍ አዱኛፍ ወዮ! ወንቶትን አከና ዹፉ ቀቡ፤ ገሩ ነመ ወንቶትን ኩኔን ከራሳቲን ዹፈን ሰናፍ ወዮ!</char> <verse eid="MAT 18:7"/><verse number="8" style="v" sid="MAT 18:8"/><char style="wj">ዮ ሀርክኬ ዮካን ሚልኬ ስ ጉፈቺሴ፣ ኦፍራ ኩቲ ገት። ሀርከ ለመ ዮካን ሚለ ለመ ቀባቴ እብደ በረ በራት ደርበተሙረ፣ ዶሉ ታቴ ዮካን ላምሾፍቴ ጅሬኘት ገሉ ሲፍ ወየ።</char> <verse eid="MAT 18:8"/><verse number="9" style="v" sid="MAT 18:9"/><char style="wj">ዮ እጅኬ ስ ጉፈቺሴ ኦፍ ኬሳ ባሲ ገት። እጀ ለመ ቀባቴ እብደ ገሃነሚት ደርበተሙረ እጀ ቶኮ ቀባቴ ጅሬኘት ገሉ ሲፍ ወየ።</char><verse eid="MAT 18:9"/></para>
  <para style="s1">ፈኬኘ ሆላ በዴ</para>
  <para style="r">
    <ref loc="MAT 18:12-14">18፥12‑14</ref> ኩወፈ – <char style="xt"><ref loc="LUK 15:4-7">ሉቃ 15፥4‑7</ref></char></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10"/>
    <char style="wj">“ወረ ጥጥና ከኔን ኬሳ ቶኮሌ አከ ህንቱፈትኔፍ ኦፍ ኤገዻ። አን እስንት ነንህመ፤ ኤርገሞትንሳኒ ሰሚረት ዬሮ ሁንደ ፉለ አባኮ እሰ ሰሚራ ንአርጉቲ።</char> [ <verse eid="MAT 18:10"/><verse number="11" style="v" sid="MAT 18:11"/><char style="wj">እልም ነማ እሰ በዴ ኦልቹዻፍ ዹፌቲ።</char>]<note caller="+" style="f"><char style="fr" closed="false">18፥11 </char><char style="ft" closed="false">ሂካወን ቶኮ ቶኮ ዱቢ <char style="xt"><ref loc="LUK 19:10">ሉቃ 19፥10</ref></char> እራ ጅሩ ደበለቱ።</char></note><verse eid="MAT 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12"/>
    <char style="wj">“እስን ማል ሴቱ? ነምን ቶኮ ዮ ሆሎተ ዽበ ቀባቴ ሆሎተ ሰነ ኬሳስ ቶኮ በዴ፣ ነምች ሱን ሰገልተሚ ሰገለን ሀፈን ካን ቱሉወንረት ዺሴ ቶክቸ በዴ ሰነ በርባዱ ህንዸቁ?</char> <verse eid="MAT 18:12"/><verse number="13" style="v" sid="MAT 18:13"/><char style="wj">አን ዹጉመን እስንት ህመ፤ እን ዮ ሆላ ሰነ አርገቴ፣ ሆሎተ ሰገልተሚ ሰገለን ህንበድንረ ሆላ ቶክቸ ሰነት ጫላ ንገመደ።</char> <verse eid="MAT 18:13"/><verse number="14" style="v" sid="MAT 18:14"/><char style="wj">አከሱመሞ እሳን ጥጥኖ ከኔን ኬሳ ቶኮዩ አከ በዱ ፌዺ አባኬሰን እሰ ሰሚራ ምት።</char><verse eid="MAT 18:14"/></para>
  <para style="s1">ጩቡ ወልት ሆጄቹ</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15"/>
    <char style="wj">“ዮ ኦቦሌስኬ ጩቡ ስት ሆጄቴ፣ ዸቂቲ እዶ እስን ለማን ቆፍት ጅርተንት በሌሳሳ እት ህም። ዮ እን ስዸገኤ አት ኦቦሌሰኬ ዴብፈቴርተ።</char> <verse eid="MAT 18:15"/><verse number="16" style="v" sid="MAT 18:16"/><char style="wj">ዮ ስ ዸገኡ ባቴ ገሩ ‘ዱቢን ሁንድኑ ዹገ ባቶተ ለማን ዮካን ሰዲን ዋን ምርከኔፈሙፍ’ ነመ ብራ ቶኮ ዮካን ነመ ለመ ፉዸዹ ዸቅ።</char> <verse eid="MAT 18:16"/><verse number="17" style="v" sid="MAT 18:17"/><char style="wj">ዮ እን ጀረ ዸገኡ ድዴ ወልዳ ክርስታናት ህም፤ ዮ እን ወልዳ ክርስታናዩ ዸገኡ ድዴ አከ ነመ ኦርማቲፊ አከ ቀረጡት እሰ ፉዸዹ።</char><verse eid="MAT 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18"/>
    <char style="wj">“አን ዹጉመን እስንት ህመ፤ ወን እስን ለፈረት ሂተን ከምዩ ሰሚረት ንህዸመ፤ ወን እስን ለፈረት ሂክተን ከምዩ ሰሚረትስ ንሂከመ።</char><verse eid="MAT 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19"/>
    <char style="wj">“አመስ አን እስንት ነንህመ፤ እስን ኬሳ ዮ ነሞትን ለመ ለፈረት ዋኤ ዋን ከዸተን ከሚዩ ወሊ ገለን አባንኮ እን ሰሚራ እሳኒፍ ታስሰ።</char> <verse eid="MAT 18:19"/><verse number="20" style="v" sid="MAT 18:20"/><char style="wj">እዶ እት ነሞትን ለመ ዮካን ሰዲ መቃኮቲን ወልት ቀበመንት አን ግዱሳኒት ነንአርገማቲ።”</char><verse eid="MAT 18:20"/></para>
  <para style="s1">ተጃጅላ ዺፈመ ህንጎኔ ቶኮ</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21"/>ኤርገሲ ጴጥሮስ ገረ ዬሱስ ዹፌ፣ “ያ ጎፍታ፣ ዮ ኦቦሌስኮ ጩቡ ነት ሆጄቴ አን ዬሮ ሀመም ዺሳፍ? ሀመ ዬሮ ቶርባቲ?” ጄዼ ጋፈቴ።<verse eid="MAT 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22"/>ዬሱስስ አከነ ጄዼ ዴብሴፍ፤ <char style="wj">“አን ስት ነንህመ፤ ዬሮ ቶርባተሚ ቶርበ መሌ ዬሮ ቶርበ ምት።</char><verse eid="MAT 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23"/>
    <char style="wj">“ከናፉ ሞቱማን ሰሚ ሞቲ ሄሬገ ገርቦተሳ ሀርከ ጅሩ ቶአቹ በርባዴ ቶኮ ፈካተ።</char> <verse eid="MAT 18:23"/><verse number="24" style="v" sid="MAT 18:24"/><char style="wj">አኩመ እን ሄሬገሳ ቶአቹ ጀልቀቤንስ ነመ ሞትች ታላንቲ ኩመ ኩዸን እራ ቀቡ ቶኮ እት ፍደን።</char> <verse eid="MAT 18:24"/><verse number="25" style="v" sid="MAT 18:25"/><char style="wj">ነምች ሱን ዋን ባሱ ዸብናን ጎፍታንሳ አከ እን፣ ኒቲንሳ፣ እጆሌንሳቲፊ ወን እን ቀቡ ሁንድኑ ጉርጉረመኒ ገቲን ሱን ከፈለሙ አጀጄ።</char><verse eid="MAT 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 18:26"/>
    <char style="wj">“ገርብች ሱንስ ሚለሳት ኩፌ፣ ‘ያ ጎፍታ፣ ናፍ ኦብስ፤ ሁንዱመሳዩ ሲፍ ነንከፈላ’ ጄዼ እሰ ከዸቴ።</char> <verse eid="MAT 18:26"/><verse number="27" style="v" sid="MAT 18:27"/><char style="wj">ጎፍታን ገርብቸ ሰናስ ገራ ላፌፍ፤ ገቲ እሰራ ቀቡስ ዺሴፊ ገድ እሰ ለክሴ።</char><verse eid="MAT 18:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28"/>
    <char style="wj">“ገርብች ሱን ገሩ አኩመ አቺ በኤን ገርብቸ አከሳ ከን ገቲ ዲናሪ</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">18፥28 </char>
      <char style="fq" closed="false">ዲናሪ </char>
      <char style="ft" closed="false">– ዲናሪን ምንዳ ጉያት ሆጄታ ቶኮፍ ከፈለሙ ቱሬ።</char>
    </note> <char style="wj">ዽባ እራ ቀቡ ቶኮ አርጌ። እንስ ሞርመ ነምቻ ሁዼ ቀቤ፣ ‘ዋን አን ስራ ቀቡ ናፍ ከፈል’ ጄዼን።</char><verse eid="MAT 18:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29"/>
    <char style="wj">“ገርብች አከሳ ሱንስ ሚለሳት ኩፌ፣ ‘ናፍ ኦብስ፤ ዋን ነረ ጅሩ ሲፍ ነንከፈላ’ ጄዼ እሰ ከዸቴ።</char><verse eid="MAT 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 18:30"/>
    <char style="wj">“እን ገሩ ንድዴ፤ ቆደ ከና ሀመ እን ገቲሳ ከፈሉት መነ ህዻት እሰ ገልችሲሴ።</char> <verse eid="MAT 18:30"/><verse number="31" style="v" sid="MAT 18:31"/><char style="wj">ገርቦትን ካን ዮሙ ዋን ተኤ ሰነ አርገንት አከ መሌ ገደን፤ ዸቀኒስ ዋን ተኤ ሁንዱማ ጎፍታሳኒት ህመን።</char><verse eid="MAT 18:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 18:32"/>
    <char style="wj">“ጎፍትችስ ገርብቸ ሰነ ኦፍት ዋሜ አከነ ጄዼን፤ ‘ያ ገርብቸ ሀማ! አን ሰበቢ አት ነ ከዸቴፍ ገቲ ስረ ቱሬ ሁንደ ሲፍ ዺሴ።</char> <verse eid="MAT 18:32"/><verse number="33" style="v" sid="MAT 18:33"/><char style="wj">አኩመ አን ገራ ሲፍ ላፌ ሰነ አትስ ገርብቸ አከኬቲቲፍ ገራ ላፉ ህንቀብዱ?’</char> <verse eid="MAT 18:33"/><verse number="34" style="v" sid="MAT 18:34"/><char style="wj">ጎፍታንሳስ ኣሪዻን ሀመ እን ገቲ ሰነ ሁንደ ከፈሉት ወረ እሰ ዽጵሰንት ደበርሴ እሰ ኬኔ።</char><verse eid="MAT 18:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35"/>
    <char style="wj">“እስንስ ዮ ገራኬሰን ጉቱዻን ኦቦሌሰኬሰኒፍ ዺሱ ባተን አባንኮ እን ሰሚራ ቶኮ ቶኮኬሰን አከኑመ ጎዸ።”</char><verse eid="MAT 18:35"/></para>
  <chapter eid="MAT 18"/>
  <chapter number="19" style="c" sid="MAT 19"/>
  <para style="s1">ወል ሂኩ ዽርሳፊ ኒቲ</para>
  <para style="r">
    <ref loc="MAT 19:1-9">19፥1‑9</ref> ኩወፈ – <char style="xt"><ref loc="MRK 10:1-12">ማር 10፥1‑12</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1"/>ዬሱስ ኤርገ ዱቢ ከነ ዱበቴ ፍጠቴ ቦዴ፣ ገሊላዻ ከኤ ገመ ዮርዳኖስ ገረ ብየ ይሁዳ ዸቄ። <verse eid="MAT 19:1"/><verse number="2" style="v" sid="MAT 19:2"/>ነሞትን ባይኤንስ እሰ ዱካ ቡአን፤ እንስ አችት እሳን ፈይሴ።<verse eid="MAT 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3"/>ፈሪሶትን ቶኮ ቶኮስ እሰ ቆሩፍ ገረሳ ዹፈኒ፣ “ነምን ቶኮ ዋኑመ አርጌን ኒቲሳ ሂኩን ንኤየመማ?” ጄዸኒ ጋፈተን።<verse eid="MAT 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4"/>ዬሱስስ አከነ ጄዼ ዴብሴ፤ <char style="wj">“እስን አከ እን ጀልቀበት እሳን ኡሜ ሱን፣ ‘ዺራፊ ዱበርቲ ታስሴ እሳን ኡሜ’</char><note caller="+" style="f"><char style="fr" closed="false">19፥4 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 1:27">ኡመ 1፥27</ref></char></char></note> <char style="wj">ህንዱብፍኔ?</char> <verse eid="MAT 19:4"/><verse number="5" style="v" sid="MAT 19:5"/><char style="wj">እን አከነ ጄዼ፤ ‘ሰበቢ ከናፍ ነምን አባፊ ሃዸሳ ዺሴ ኒቲሳት ንመጠነ፤ ለማንሳኒዩ ፎን ቶኮ ተኡ።’</char><note caller="+" style="f"><char style="fr" closed="false">19፥5 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 2:24">ኡመ 2፥24</ref></char></char></note> <verse eid="MAT 19:5"/><verse number="6" style="v" sid="MAT 19:6"/><char style="wj">ኤጋ እሳን ስአች ፎን ቶኮ መሌ ለመ ምት። ከናፉ ዋን ዋቅን ቶኮ ታስሴ ነምን ገርገር ህንባስን።”</char><verse eid="MAT 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7"/>እሳንስ፣ “ዮስ ሙሴን ማሊፍ አከ ነምን ቶኮ ወረቃ ረጋ ሂካ ኬኔፊ ኒቲሳ ኦፍራ ጌጌሱ አጀጄሬ?” ጄዸኒ እሰ ጋፈተን።<verse eid="MAT 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8"/>ዬሱስስ አከነ ጄዼ ዴብሴ፤ <char style="wj">“ሙሴን ሰበቢ መተ ጀብነኬሰኒቲፍ ጄዼ አከ እስን ኒቶተኬሰን ሂክተን እስኒፍ ኤየሜ። ጀልቀበት ገሩ አከነ ህንቱሬ።</char> <verse eid="MAT 19:8"/><verse number="9" style="v" sid="MAT 19:9"/><char style="wj">አን እስንትን ህመ፤ ነምን ኡቱ እሼን ሀለሉማ ህንሆጄትን ኒቲሳ ሂኬ ዱበርቲ ብራ ፉዹ ከምዩ ኤጀ ራወተ።”</char><verse eid="MAT 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10"/>በረቶትንሳስ፣ “ሃል ዽርሳፊ ኒቲ አከነ ታናን ፉዹ ዺሱ ወየ” ጄዸኒን።<verse eid="MAT 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11"/>ዬሱስስ አከነ ጄዼን፤ <char style="wj">“ዋን ከነ ወረ እሳኒፍ ኬነሜ ቆፈ መሌ ነምን ሁንድ ፉዸቹ ህንደንደኡ።</char> <verse eid="MAT 19:11"/><verse number="12" style="v" sid="MAT 19:12"/><char style="wj">ወር ጡኣሺ ተአኒ ገደሜሰ ሃዸሳኒቲ ዸለተን ጅሩቲ፤ ወር ሀርከ ነማቲን ጡኣሺ ተአንስ ጅሩ፤ ከኔን ሞቱማ ሰሚቲፍ ጄዸኒ ጡኣሺ ኦፍ ታስሰንስ ጅሩ፤ ነምን ከነ ፉዸቹ ደንደኡ ሃፉዸቱ።”</char><verse eid="MAT 19:12"/></para>
  <para style="s1">ዬሱስ ዳእመን ጥጥኖ ኤብሴ</para>
  <para style="r">
    <ref loc="MAT 19:13-15">19፥13‑15</ref> ኩወፈ – <char style="xt"><ref loc="MRK 10:13-16">ማር 10፥13‑16</ref>፤ <ref loc="LUK 18:15-17">ሉቃ 18፥15‑17</ref></char></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13"/>ኤርገሲ አከ እን ሀርከ እሳንረ ካኤ እሳኒፍ ከዸቱፍ እጆሌ ጥጥኖ ዬሱስት ፍደን። በረቶትን ገሩ እሳን እፈተን።<verse eid="MAT 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 19:14"/>ዬሱስስ፣ <char style="wj">“እጆሌን ጥጥኖን ገረኮ ሃዹፈኒቲ ህንዾውና፤ ሞቱማን ሰሚ ከን ወረ አከናቲ”</char> ጄዼ። <verse eid="MAT 19:14"/><verse number="15" style="v" sid="MAT 19:15"/>እንስ ኤርገ ሀርከሳ እሳንረ ካኤ ቦዴ አቺ ዴሜ።<verse eid="MAT 19:15"/></para>
  <para style="s1">ደርገጌሰ ሶሬሰ ቶኮ</para>
  <para style="r">
    <ref loc="MAT 19:16-29">19፥16‑29</ref> ኩወፈ – <char style="xt"><ref loc="MRK 10:17-30">ማር 10፥17‑30</ref>፤ <ref loc="LUK 18:18-30">ሉቃ 18፥18‑30</ref></char></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16"/>ኩኖ ነምች ቶኮ ገረ ዬሱስ ዹፌ፣ “ያ በርሲሳ፣ ጅሬኘ በረ በራ አርገቹፍ ወን ጋሪን አን ጎቹ ቀቡ ማል?” ጄዼ ጋፈቴ።<verse eid="MAT 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17"/>ዬሱስሞ፣ <char style="wj">“አት ማሊፍ ዋኤ ዋን ጋሪ ነ ጋፈተ? ጋሪን እሰ ቶክቸ ቆፈቱ ጅረ። አት ዮ ጅሬኘት ገሉ በርባዴ አጀጀወን ኤግ”</char> ጄዼ ዴብሴ።<verse eid="MAT 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18"/>ነምችስ፣ “አጀጀወን ከም?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="MAT 19:18">ዬሱስሞ አከነ ጄዼ ዴብሴ፤ <char style="wj">“ ‘ህንአጄስን፤ ህንኤጅን፤ ህንሀትን፤ ሶባን ዹጋ ህንበእን፤</char> <verse eid="MAT 19:18"/><verse number="19" style="v" sid="MAT 19:19"/><char style="wj">አባኬቲፊ ሃዸኬ ከበጅ፤</char><note caller="+" style="f"><char style="fr" closed="false">19፥19 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 20:12-16">በኡ 20፥12‑16</ref>፤ <ref loc="DEU 5:16-20">ኬዴ 5፥16‑20</ref></char></char></note> <char style="wj">ኦላኬ አኩመ ኦፊኬቲት ጃለዹ።’</char><note caller="+" style="f"><char style="fr" closed="false">19፥19 </char><char style="ft" closed="false"><char style="xt"><ref loc="LEV 19:18">ሌዎ 19፥18</ref></char></char></note><char style="wj">”</char><verse eid="MAT 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20"/>ደርገጌስ ሱንስ፣ “አን አጀጀወን ከኔን ሁንደ ኤጌረ። ዮስ ማልቱ አመዩ ነ ዱራ ህርአተሬ?” ጄዼን።<verse eid="MAT 19:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21"/>ዬሱስስ፣ <char style="wj">“አት ዮ ነመ ህርእነ ህንቀብኔ ተኡ በርባዴ፣ ዸቂቲ ዋን ቀብዱ ጉርጉሪ ህዬዪፍ ኬን፤ ሰሚ ኬሰት በዻዹማ ንቀባታ። ኤርገሲ ኮቱ ነ ዱካ ቡእ”</char> ጄዼ ዴብሴፍ።<verse eid="MAT 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22"/>ደርገጌስ ሱንስ ዮሙ ዋን ከነ ዸገኤት ገዴ አቺ ዴሜ፤ እን ቀቤኘ ጉዳ ቀበ ቱሬቲ።<verse eid="MAT 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23"/>ዬሱስስ በረቶተሳቲን አከነ ጄዼ፤ <char style="wj">“አን ዹጉመ እስንትን ህመ፤ ሞቱማ ሰሚት ገሉን ነመ ሶሬሳፍ ረክሳዸ።</char> <verse eid="MAT 19:23"/><verse number="24" style="v" sid="MAT 19:24"/><char style="wj">አመስ እስንትን ህመ፤ ነምን ሶሬስ ሞቱማ ዋቃት ገሉረ ቃወ ልልሞ ኬሰ በኡቱ ጋላፍ ሰልጰተ።”</char><verse eid="MAT 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25"/>በረቶትን ዮሙ ዋን ከነ ዸገአንት አከ መሌ ራጄፈተኒ፣ “ዮስ ኤኙቱ ፈዩ ደንደአሬ?” ጄዸኒ ጋፈተን።<verse eid="MAT 19:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26"/>ዬሱስስ እሳን እላሌ፣ <char style="wj">“ኩን ነማፍ ህንደንደአሙ፤ ዋቃፍ ገሩ ወን ሁንድኑ ንደንደአመ”</char> ጄዼ።<verse eid="MAT 19:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27"/>ከነረት ጴጥሮስ፣ “ኩኖ፣ ኑ ዋን ሁንደ ዺፍኔ ስ ዱካ ቡኔረ! ኤጋ ማል አርገትነሬ?” ጄዼ ዴብሴ።<verse eid="MAT 19:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28"/>ዬሱስሞ አከነ እሳኒን ጄዼ፤ <char style="wj">“አን ዹጉመ እስንትን ህመ፤ አዱኛ ሃራ ኬሰት፣ ዬሮ እልም ነማ ቴሶሳ ኡልፍነ ቀቤሰ ሰነረ ታኡት፣ እስን ወር ነ ዱካ ቡተንስ አከሱመ ቴሶወን ኩዸ ለመረ ቴሰኒ ጎሶተ እስራኤል ኩዸ ለማንት ሙርቱ።</char> <verse eid="MAT 19:28"/><verse number="29" style="v" sid="MAT 19:29"/><char style="wj">ነምን መቃኮቲፍ ጄዼ መኔን ዮካን ኦቦሎተ ዮካን ኦቦሌቶተ ዮካን አባ ዮካን ሃዸ ዮካን ኒቲ ዮካን እጆሌ ዮካን ለፈ ቆቲሳ ዺሴ ሁንድ ደቻ ዽበ ንአርገተ፤ ጅሬኘ በረ በራስ ንዻለ።</char> <verse eid="MAT 19:29"/><verse number="30" style="v" sid="MAT 19:30"/><char style="wj">ገሩ ወር ጀልቀባ ሄዱን ወረ ዹማ ንተኡ፤ ወር ዹማ ሄዱንሞ ወረ ጀልቀባ ንተኡ።</char><verse eid="MAT 19:30"/></para>
  <chapter eid="MAT 19"/>
  <chapter number="20" style="c" sid="MAT 20"/>
  <para style="s1">ፈኬኘ ወረ እዶ ዻበ ወይኒ ኬሰ ሆጄተኒ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1"/>
    <char style="wj">“ሞቱማን ሰሚስ አባ ለፋ ከን እዶ ዻበ ወይኒሳት ሆጄቶተ ቀጨረቹፍ ጄዼ በሪ ኦቦሮ መና በኤ ቶኮ ፈካተ።</char> <verse eid="MAT 20:1"/><verse number="2" style="v" sid="MAT 20:2"/><char style="wj">እንስ ጉያት ዲናሪ</char><note caller="+" style="f"><char style="fr" closed="false">20፥2 </char><char style="fq" closed="false">ዲናሪ </char><char style="ft" closed="false">– ዲናሪን ምንዳ ጉያት ሆጄታ ቶኮፍ ከፈለሙ ቱሬ።</char></note> <char style="wj">ቶኮ ቶኮ እሳኒ ከፈሉፍ ሆጄቶተ ሰናን ወሊ ገሌ ገረ እዶ ዻበ ወይኒሳት እሳን ኤርጌ።</char><verse eid="MAT 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3"/>
    <char style="wj">“ነምች ሱንስ ገረ ሰኣቲ ሰዲት ገድ በኤ ነሞተ ሆጂ መሌ እዶ ገባ ዸዻበተን ከኔን ብራ አርጌ።</char> <verse eid="MAT 20:3"/><verse number="4" style="v" sid="MAT 20:4"/><char style="wj">‘እስንስ ዸቃቲ እዶ ዻበ ወይኒኮቲ ኬሰ ሆጄዻ፤ አንስ ዋን እስኒፍ መሉ እስኒፍን ከፈላ’ ጄዼን።</char> <verse eid="MAT 20:4"/><verse number="5" style="v" sid="MAT 20:5"/><char style="wj">እሳንስ ንዸቀን።</char></para>
  <para style="p" vid="MAT 20:5">
    <char style="wj">“አመስ ገረ ሰኣቲ ጀኣፊ ገረ ሰኣቲ ሰገሊት ገድ በኤ አከሱመ ጎዼ።</char> <verse eid="MAT 20:5"/><verse number="6" style="v" sid="MAT 20:6"/><char style="wj">ናኖ ሰኣቲ ኩዸ ቶኮትስ ገድ በኤ ነሞተ ሆጂ መሌ ዸዻበተን ብራ አርጌ፣ ‘እስን ማሊፍ ጉያ ጉቱ ሆጂ መሌ አስ ዸዻበቱ?’ ጄዼ እሳን ጋፈቴ።</char><verse eid="MAT 20:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7"/>
    <char style="wj">“እሳንስ፣ ‘ሰበቢ ነምን ቶኮሌ ኑ ህንቀጨረትኒፍ’ ጄዸኒ ዴብሰን።</char></para>
  <para style="p" vid="MAT 20:7">
    <char style="wj">“እንሞ፣ ‘እስንስ ዸቃቲ እዶ ዻበ ወይኒኮቲ ኬሰ ሆጄዻ’ ጄዼን።</char><verse eid="MAT 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8"/>
    <char style="wj">“ዮሙ ለፍት ገልገላኤት አባን እዶ ዻበ ወይኒ ሰና ሆገና ሆጂሳቲን፣ ‘ሆጄቶተ ዋም፤ ወረ ገረ ዹማት ቀጨረመኒ ጀልቀቢ ሀመ ወረ ዱረ ቀጨረመኒት ምንዳሳኒ ከፈሊፍ’ ጄዼን።</char><verse eid="MAT 20:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 20:9"/>
    <char style="wj">“ወር ገረ ሰኣቲ ኩዸ ቶኮት ቀጨረመን ሱንስ ዹፈኒ ቶኮን ቶኮንሳኒ ዲናሪ ቶኮ ቶኮ ፉዸተን።</char> <verse eid="MAT 20:9"/><verse number="10" style="v" sid="MAT 20:10"/><char style="wj">ወር ጀልቀበት ቀጨረመን ዮሙ ዹፈንት ዋን ወረ ካን ጫላ አርገተን ሴአን። ገሩ ቶኮን ቶኮንሳኒ ዲናሪ ቶኮ ቶኮ ፉዸተን።</char> <verse eid="MAT 20:10"/><verse number="11" style="v" sid="MAT 20:11"/><char style="wj">እሳን ዮሙ ዲናሪ ሰነ ፉዸተንት አባ ለፋ ሰነት ጉንጉመን።</char> <verse eid="MAT 20:11"/><verse number="12" style="v" sid="MAT 20:12"/><char style="wj">እሳንስ፣ ‘ወር ገረ ዹማት ቀጨረመን ኩኔን ሰኣቲ ቶኮ ቆፈ ሆጄተን፤ አት ገሩ ኑ ወረ ደዸቢ ሆጅቻቲፊ ሆአ ጉያ ኦብስኔ እሳኒን ወል ቅጤስቴ’ ጄዸኒን።</char><verse eid="MAT 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13"/>
    <char style="wj">“እን ገሩ ሆጄቶተ ሰነ ኬሳ እሰ ቶኮን፣ ‘ያ ምቹኮ፣ አን ዋን ቶኮንሌ ስ ህንሚኔ። አት ዲናሪ ቶኮን ናን ወሊ ህንገሌ?</char> <verse eid="MAT 20:13"/><verse number="14" style="v" sid="MAT 20:14"/><char style="wj">ቆደኬ ፉዸዹ ዴም፤ አን ነምቸ እሰ ገረ ዹማ ከናፍስ ሀሙመ ሲፍ ኬኔ ሰነ ኬኑፊ ነንበርባደ።</char> <verse eid="MAT 20:14"/><verse number="15" style="v" sid="MAT 20:15"/><char style="wj">አን ቀርሺኮቲን ዋን በርባዴ ጎቹፍ ምርገ ህንቀቡ? ዮካን ሰበቢ አን አርጃ ተኤፍ ህናፍታ?’ ጄዼ።</char><verse eid="MAT 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16"/>
    <char style="wj">“አከሱመ ወር ዹማ ወረ ጀልቀባ ንተኡ፤ ወር ጀልቀባሞ ወረ ዹማ ንተኡ።”</char><verse eid="MAT 20:16"/></para>
  <para style="s1">ዬሱስ ዬሮ ሰደፋ ዋኤ ዱአሳ ዱራን ዱርሴ ዱበቴ</para>
  <para style="r">
    <ref loc="MAT 20:17-19">20፥17‑19</ref> ኩወፈ – <char style="xt"><ref loc="MRK 10:32-34">ማር 10፥32‑34</ref>፤ <ref loc="LUK 18:31-33">ሉቃ 18፥31‑33</ref></char></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17"/>ዬሱስ ኡቱ ዬሩሳሌምት ኦል በኣ ጅሩ በረቶተ ኩዸ ለማን ኮጳት ባሴ አከነ ጄዼን፦ <verse eid="MAT 20:17"/><verse number="18" style="v" sid="MAT 20:18"/><char style="wj">“ኩኖ ኑ ዬሩሳሌምት ኦል በኣ ጅረ፤ እልም ነማስ ደበርፈሜ ሉቦተ ሀንገፎተቲፊ በርሲስቶተ ሴራት ንኬነመ። እሳንስ ዱአ እት ሙሩ፤</char> <verse eid="MAT 20:18"/><verse number="19" style="v" sid="MAT 20:19"/><char style="wj">አከ እሳን እት ቆሰኒፍ፣ እሰ ገረፈኒፊ እሰ ፈንሰኒፍስ ደበርሰኒ ነሞተ ኦርማት እሰ ኬኑ። እንስ ጉያ ሰደፋት ዱኣ ንካፈመ!”</char><verse eid="MAT 20:19"/></para>
  <para style="s1">ጋፊ ሃዸ እልማን ዘብዴዎስ</para>
  <para style="r">
    <ref loc="MAT 20:20-28">20፥20‑28</ref> ኩወፈ – <char style="xt"><ref loc="MRK 10:35-45">ማር 10፥35‑45</ref></char></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20"/>ኤርገሲስ ሃት እልማን ዘብዴዎስ እልማንሼ ወጅን ገረ ዬሱስ ዹፍቴ ጅልቤንፈቴ ዋ እሰ ከዸቴ።<verse eid="MAT 20:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21"/>ዬሱስስ፣ <char style="wj">“አት ማል በርባደ?”</char> ጄዼን።</para>
  <para style="p" vid="MAT 20:21">እሼንስ፣ “አከ እልማንኮ ኩኔን ለማን ሞቱማኬ ኬሰት እን ቶኮ ምርገኬቲን፣ እን ካንሞ ብታኬቲን ታኡ ናፍ ጎዽ” ጄቴን።<verse eid="MAT 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22"/>ዬሱስሞ፣ <char style="wj">“እስን ዋን ከዸተን ህንቤክተን፤ ጦፎ አን ዹጉፍ ጅሩ ዹጉ ንደንዴሱ?”</char> ጄዼን።</para>
  <para style="p" vid="MAT 20:22">እሳንስ፣ “ንደንዴኘ” ጄዸኒ ዴብሰን።<verse eid="MAT 20:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23"/>ዬሱስስ፣ <char style="wj">“ዹጉማን ጦፎኮራሌ ንዹግዱ፤ ገሩ ምርገኮቲፊ ብታኮቲን ታኡ ከን ኬኑ አነ ምት። እዶን ኩን ከን ወረ አባንኮ እሳኒፍ ቆጴሴ ሰናት”</char> ጄዼን።<verse eid="MAT 20:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24"/>ወር ኩርነን ዮሙ ዋን ከነ ዸገአንት ኦቦሎተ ለማንት ኣረን። <verse eid="MAT 20:24"/><verse number="25" style="v" sid="MAT 20:25"/>ዬሱስስ ወልት እሳን ዋሜ አከነ ጄዼ፤ <char style="wj">“እስን አከ ቡልችቶትን ነሞተ ኦርማ እሳንረት ጎፍቱማ ሙልእሰን፣ ጉርጉዶትንሳኒስ አከ እሳንረት ታይታ አርግሲሰን ንቤክቱ።</char> <verse eid="MAT 20:25"/><verse number="26" style="v" sid="MAT 20:26"/><char style="wj">እስን ብረት አከስ ምት። ቆደ ከና ነምን እስን ኬሳ ነመ ጉዳ ተኡ በርባዱ ከምዩ ተጃጅላኬሰን ተኡ ቀበ፤</char> <verse eid="MAT 20:26"/><verse number="27" style="v" sid="MAT 20:27"/><char style="wj">ነምን ነመ ጀልቀባ ተኡ በርባዱ ከምዩ ገርብቸኬሰን ተኡ ቀበ፤</char> <verse eid="MAT 20:27"/><verse number="28" style="v" sid="MAT 20:28"/><char style="wj">እልም ነማዩ ተጃጅሉፊ ሉቡሳሞ ነሞተ ባይኤዻፍ ፉሪ ጎዼ ኬኑፍ ዹፌ መሌ ተጃጅለሙፍ ህንዹፍኔቲ።”</char><verse eid="MAT 20:28"/></para>
  <para style="s1">ጃሞትን ለመ ፈይፈሙሳኒ</para>
  <para style="r">
    <ref loc="MAT 20:29-34">20፥29‑34</ref> ኩወፈ – <char style="xt"><ref loc="MRK 10:46-52">ማር 10፥46‑52</ref>፤ <ref loc="LUK 18:35-43">ሉቃ 18፥35‑43</ref></char></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29"/>ኡቱ ዬሱሲፊ በረቶትንሳ ዬርኮዻ በኣ ጅረኑ፣ ቱትን ነሞታ ጉዳን እሰ ዱካ ቡኤ። <verse eid="MAT 20:29"/><verse number="30" style="v" sid="MAT 20:30"/>ኩኖ ጃሞትን ለመ ቀርቀረ ከራ ተታኣ ቱረን፤ እሳንስ ዮሙ አከ ዬሱስ አቺን ደርባ ጅሩ ዸገአንት እየኒ፣ “ጎፍታ፣ ያ እልመ ዳዊት ኑ ማር!” ጄዸን።<verse eid="MAT 20:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31"/>ቱትን ሱንስ አከ እሳን ጨልእሰኒፍ እሳን እፈቴ፤ እሳን ገሩ፣ “ያ ጎፍታ፣ ያ እልመ ዳዊት ኑ ማር!” ጄዸኒ እቱመ ጫልችሰኒ እየን።<verse eid="MAT 20:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32"/>ዬሱስስ ዻበቴ እሳን ዋሜ፣ <char style="wj">“አከ አን ማል እስኒ ጎዹ በርባዱ?”</char> ጄዼ እሳን ጋፈቴ።<verse eid="MAT 20:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33"/>እሳንሞ፣ “ያ ጎፍታ፣ አከ እጅኬኘ ኑፍ በነሙ በርባድነ” ጄዸኒ ዴብሰን።<verse eid="MAT 20:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34"/>ዬሱስስ ገራ ላፌፊ እጀሳኒ ቀቀቤ። እሳንስ ዬሩመ ሰነ አርገኒ እሰ ዱካ ቡአን።<verse eid="MAT 20:34"/></para>
  <chapter eid="MAT 20"/>
  <chapter number="21" style="c" sid="MAT 21"/>
  <para style="s1">ዬሱስ አከ ሞቲት ዬሩሳሌም ሴኑሳ</para>
  <para style="r">
    <ref loc="MAT 21:1-9">21፥1‑9</ref> ኩወፈ – <char style="xt"><ref loc="MRK 11:1-10">ማር 11፥1‑10</ref>፤ <ref loc="LUK 19:29-38">ሉቃ 19፥29‑38</ref></char></para>
  <para style="r">
    <ref loc="MAT 21:4-9">21፥4‑9</ref> ኩወፈ – <char style="xt"><ref loc="JHN 12:12-15">ዮሀ 12፥12‑15</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1"/>አኩመ እሳን ዬሩሳሌምት ዽኣተኒ ቤተ ፋጌ እሼ ጋረ ኤጄርሳራ ሰነ ገአኒን ዬሱስ በረቶተ ለመ ኤርጌ፤ <verse eid="MAT 21:1"/><verse number="2" style="v" sid="MAT 21:2"/>አከነስ እሳኒን ጄዼ፤ <char style="wj">“ገረ ገንደ ፉለኬሰን ዱረ ጅሩ ሰና ዸቃ፤ ዮሙሱመ ሀሬ ህዸምቴ ቶኮ እልሞሼ ወጅን ንአርገቱ። ለቸንሳኒ ሂካቲ ና ፍዳ።</char> <verse eid="MAT 21:2"/><verse number="3" style="v" sid="MAT 21:3"/><char style="wj">ዮ ነምን ቶኮዩ ዋን ቶኮ እስኒን ጄዼ፣ ‘ጎፍታቱ እሳን በርባደ’ ጄዻ፤ እንስ ዮሙሱመ ኤርገ።”</char><verse eid="MAT 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4"/>ኩንስ አከ ወን ከራ ራጅቻቲን ዱበተሜ ሱን ራወተሙፍ ተኤ፤ እንስ አከነ ጄዸ፦<verse eid="MAT 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5"/>“አከነ ጄዻ እንተለ ጥዮንት ህማ፤</para>
  <para style="q2" vid="MAT 21:5">‘ኩኖ፣ ሞቲንኬ ገድ ኦፍ ቀቤ፣ ሀሬ ያበቴ፣</para>
  <para style="q1" vid="MAT 21:5">ሀሬ ጥኖ ጄቹንስ እልሞ ሀሬ ያበቴ፣</para>
  <para style="q2" vid="MAT 21:5">ገረኬ ዹፈ።’ ”<note caller="+" style="f"><char style="fr" closed="false">21፥5 </char><char style="ft" closed="false"><char style="xt"><ref loc="ZEC 9:9">ዘካ 9፥9</ref></char></char></note><verse eid="MAT 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6"/>በረቶትንስ ዸቀኒ አኩመ ዬሱስ እሳን አጀጄ ጎዸን። <verse eid="MAT 21:6"/><verse number="7" style="v" sid="MAT 21:7"/>እሳንስ ሀሬፊ እልሞ ሀሬ ሰነ ፍደን፤ ኡፈተሳኒስ እሳንረ ቡሰን፤ ዬሱስስ እሳንረ ታኤ። <verse eid="MAT 21:7"/><verse number="8" style="v" sid="MAT 21:8"/>ነሞትን አከ መሌ ባይኤን ኡፈተሳኒ ከራረ አፈን፤ ወር ካንሞ ደሜወን ሙካ ኩኩተኒ ከራረ ቡቡሰን። <verse eid="MAT 21:8"/><verse number="9" style="v" sid="MAT 21:9"/>ነሞትን እሰ ዱረ ዴማ ቱረኒፊ ወር እሰ ዱካ ቡኣ ቱረን እየኒ፣</para>
  <para style="q1" vid="MAT 21:9">“ሆሳእና እልመ ዳዊቲፍ!”</para>
  <para style="b" vid="MAT 21:9"/>
  <para style="q1" vid="MAT 21:9">“እን መቃ ጎፍታቲን ዹፉ ኤብፈማዸ!”<note caller="+" style="f"><char style="fr" closed="false">21፥9 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 118:26">ፋር 118፥26</ref></char></char></note></para>
  <para style="b" vid="MAT 21:9"/>
  <para style="q1" vid="MAT 21:9">“ሆሳእና ኦል ጉባት!” ጄዸን።<verse eid="MAT 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10"/>ዮሙ ዬሱስ ዬሩሳሌም ሴኔት፣ መጋላን ሱን ጉቱማት ራፈምቴ፣ “ኩን ኤኙ?” ጄቴ።<verse eid="MAT 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11"/>ቱትን ሱንሞ፣ “ኩን ዬሱስ፣ ራጅቸ ናዝሬት ገሊላት” ጄዼ ዴብሴ።<verse eid="MAT 21:11"/></para>
  <para style="s1">ዬሱስ መነ ቁልቁሉማ ኬሰት</para>
  <para style="r">
    <ref loc="MAT 21:12-16">21፥12‑16</ref> ኩወፈ – <char style="xt"><ref loc="MRK 11:15-18">ማር 11፥15‑18</ref>፤ <ref loc="LUK 19:45-47">ሉቃ 19፥45‑47</ref></char></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12"/>ዬሱስ መነ ቁልቁሉማ ሴኔ ወረ መነ ቁልቁሉማ ኬሰት ብተተኒፊ ጉርጉረተን ሁንዱማ አርኤ። ምንጃለ ወረ ማለቀ ጌደረተኒቲፊ በርጩመ ወረ ጉጌ ጉርጉረተኒ ገረገልቼ። <verse eid="MAT 21:12"/><verse number="13" style="v" sid="MAT 21:13"/>እንስ፣ <char style="wj">“ ‘መንኮ መነ ከዸትና ጄዸመ’</char><note caller="+" style="f"><char style="fr" closed="false">21፥13 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 56:7">እሳ 56፥7</ref></char></char></note> <char style="wj">ጄዸሜ በሬፈሜረ፤ እስን ገሩ ሆልቀ ሳምቶታ ጎተኒርቱ”</char><note caller="+" style="f"><char style="fr" closed="false">21፥13 </char><char style="ft" closed="false"><char style="xt"><ref loc="JER 7:11">ኤር 7፥11</ref></char></char></note> እሳኒን ጄዼ።<verse eid="MAT 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14"/>ጃሞትኒፊ ወር ናፈተን መነ ቁልቁሉማ ኬሰት ገረሳ ዹፈን፤ እንስ እሳን ፈይሴ። <verse eid="MAT 21:14"/><verse number="15" style="v" sid="MAT 21:15"/>ሉቦትን ሀንገፎትኒፊ በርሲስቶትን ሴራ ዮሙ ሆጂ ድንቅሲሳ እን ሆጄቴ አርገኒ እጆሌ መነ ቁልቁሉማ ኬሰት፣ “ሆሳእና እልመ ዳዊቲፍ” ጄዸኒ እየን ዸገአንት ንኣረን።<verse eid="MAT 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 21:16"/>እሳንስ፣ “አት ዋን እጆሌን ኩኔን ጄዸን ዸጌሳ?” ጄዸኒ እሰ ጋፈተን።</para>
  <para style="p" vid="MAT 21:16">ዬሱስሞ፣ <char style="wj">“ኤዬ”፤ እስን ዋን፣</char></para>
  <para style="q1" vid="MAT 21:16">
    <char style="wj">“ ‘ያ ጎፍታ፣ አት አፋን ዳእመኒቲፊ ሙጮሊ ሀርመ ሆዸኒራ፣ <optbreak/> ገለተ ቆጴስቴርተ’</char></para>
  <para style="q2" vid="MAT 21:16">
    <char style="wj">ጄዹ ሰነ ተኩማ ህንዱብፍኔ?”</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">21፥16 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="PSA 8:2">ፋር 8፥2</ref>
        </char>
      </char>
    </note></para>
  <para style="m" vid="MAT 21:16">ጄዼ ዴብሴ።<verse eid="MAT 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17"/>እንስ እሳን ብራ ዴሜ መጋላ ሰና በኤ፤ ቢታንያ ዸቄ አች ቡሌ።<verse eid="MAT 21:17"/></para>
  <para style="s1">ሙክን ሀርቡ ጎጉሳ</para>
  <para style="r">
    <ref loc="MAT 21:18-22">21፥18‑22</ref> ኩወፈ – <char style="xt"><ref loc="MRK 11:12-14">ማር 11፥12‑14</ref>፣<ref loc="MRK 11:20-24">20‑24</ref></char></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18"/>ዬሱስ ገነመ በሪ ኡቱ ገረ መጋለቲት ዴብኡ ቤለኤ። <verse eid="MAT 21:18"/><verse number="19" style="v" sid="MAT 21:19"/>ሙከ ሀርቡ ቶኮስ ከራ ብረት አርጌ እት ጎሬ፤ ገሩ ባለ መሌ ዋ ቶኮሌ ህንአርገትኔ። እንስ፣ <char style="wj">“እጅ በረ በራን ስረት ህንአርገምን!”</char> ጄዼን። ሙክን ሱንስ ዬሩመ ሰነ ጎጌ።<verse eid="MAT 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20"/>በረቶትንስ ዮሙ ዋን ከነ አርገንት ንድንቅሲፈተን። እሳንስ፣ “ሀርቡን ሱን አከምት ዮሙሱመ ጎጌ?” ጄዸኒ ጋፈተን።<verse eid="MAT 21:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21"/>ዬሱስስ አከነ ጄዼ ዴብሴ፤ <char style="wj">“አን ዹጉመን እስንት ህመ፤ ዮ አመንቲ ቀባተን፣ ዮ መሙ ባተንስ፣ ዋን ሙከ ሀርቡ ሰነረት ተኤ ቆፈ ኡቱ ህንተእን፣ ቱሉ ከናንሌ፣ ‘ከእ! ገላነት ደርበተም!’ ዮ ጄተን ንተአ።</char> <verse eid="MAT 21:21"/><verse number="22" style="v" sid="MAT 21:22"/><char style="wj">እስን ዮ አመንቲ ቀባተን ዋን ከዸትናዻን ጋፈተን ሁንደ ንአርገቱ።”</char><verse eid="MAT 21:22"/></para>
  <para style="s1">ታይታን ዬሱስ ጋፊ ኡሜ</para>
  <para style="r">
    <ref loc="MAT 21:23-27">21፥23‑27</ref> ኩወፈ – <char style="xt"><ref loc="MRK 11:27-33">ማር 11፥27‑33</ref>፤ <ref loc="LUK 20:1-8">ሉቃ 20፥1‑8</ref></char></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23"/>ኡቱ ዬሱስ መነ ቁልቁሉማ ሴኔ በርሲሳ ጅሩ ሉቦትን ሀንገፎትኒፊ ማንጉዶትን ሰባ ገረሳ ዹፈኒ፣ “አት ታይታ ማሊቲን ወንቶተ ከኔን ሆጄተ? ኤኙቱ ታይታ ከነ ሲፍ ኬኔ?” ጄዸኒ ጋፈተን።<verse eid="MAT 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24"/>ዬሱስስ አከነ ጄዼ ዴብሴ፤ <char style="wj">“አንስ ጋፊ ቶኮን እስን ጋፈዸ፤ ዮ እስን ናፍ ዴብፍተን፣ አንስ ታይታ ማሊቲን ወንቶተ ከኔን አከን ሆጄዹ እስንትን ህመ።</char> <verse eid="MAT 21:24"/><verse number="25" style="v" sid="MAT 21:25"/><char style="wj">ጩጳን ዮሀንስ ኤሳ ዹፌ? ሰሚራሞ ነመ ብራ ዹፌ?”</char></para>
  <para style="p" vid="MAT 21:25">እሳንስ ወሊን መርአተኒ አከነ ጄዸን፤ “ዮ ኑ፣ ‘ሰሚራ ዹፌ’ ጄኔ፣ እንሞ፣ ‘ዮስ እስን ማሊፍ እሰ ህንአመንንሬ?’ ኑን ጄዸ። <verse eid="MAT 21:25"/><verse number="26" style="v" sid="MAT 21:26"/>ዮ ኑ፣ ‘ነመ ብራ ዹፌ’ ጄኔ ገሩ ነሞተ ሶዳትነ፤ እሳን ሁንድኑ ዮሀንስን አከ ራጂት እላሉቲ።”<verse eid="MAT 21:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 21:27"/>ከናፍ እሳን፣ “ህንቤክኑ!” ጄዸኒ ዬሱሲፍ ዴብሰን።</para>
  <para style="p" vid="MAT 21:27">እንሞ አከነ ጄዼ፤ <char style="wj">“አንስ ታይታ ማሊቲን አከን ወንቶተ ከኔን ሆጄዹ እስንት ህንህሙ።”</char><verse eid="MAT 21:27"/></para>
  <para style="s1">ፈኬኘ እልማን ለማኒ</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28"/>
    <char style="wj">“ማል ሴቱ? ነመ እልማን ለመ ቀቡ ቶኮቱ ቱሬ፤ እንስ ገረ እልመሳ ሀንገፋ ዸቄ፣ ‘ያ እልመኮ፣ ሀርአ ዸቂቲ እዶ ዻበ ወይኒ ኬሰ ሆጄዹ’ ጄዼን።</char><verse eid="MAT 21:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 21:29"/>
    <char style="wj">“እልም ሱንስ ዴብሴ፣ ‘አን ህንዸቁ’ ጄዼ፤ ኤርገሲ ገሩ ጋቤ ዸቄ።</char><verse eid="MAT 21:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 21:30"/>
    <char style="wj">“ነምችስ ገረ እልመሳ እሰ ካኒ ዸቄ አከሱመ ጄዼን። እልምሳ ሱንስ፣ ‘ያ ጎፍታ ነንዸቀ’ ጄዼ ዴብሴፍ፤ ገሩ ህንዸቅኔ።</char><verse eid="MAT 21:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 21:31"/>
    <char style="wj">“እልማን ለማን ኬሳ እሰ ከምቱ ፌዺ አባሳ ጉቴ?”</char></para>
  <para style="p" vid="MAT 21:31">እሳንስ፣ “እሰ ጀልቀባት” ጄዸን።</para>
  <para style="p" vid="MAT 21:31">ዬሱስስ አከነ እሳኒን ጄዼ፤ <char style="wj">“አን ዹጉመን እስንት ህመ፤ ቀረጦትኒፊ ሰጋገልቶትን እስን ዱረ ሞቱማ ዋቃት ንገሉ።</char> <verse eid="MAT 21:31"/><verse number="32" style="v" sid="MAT 21:32"/><char style="wj">ዮሀንስ ከራ ቀጄሉማ እስንት አርግሲሱ ዹፌቲ፤ እስንሞ እሰ ህንአመኔ። ቀረጦትኒፊ ሰጋገልቶትን ገሩ እሰ አመነን፤ እስን ኤርጉመ ዋን ከነ አርግተንሌ ቀልቢ ጅጂረተኒ እሰት ህንአመኔ።</char><verse eid="MAT 21:32"/></para>
  <para style="s1">ፈኬኘ ቆቱወኒ</para>
  <para style="r">
    <ref loc="MAT 21:33-46">21፥33‑46</ref> ኩወፈ – <char style="xt"><ref loc="MRK 12:1-12">ማር 12፥1‑12</ref>፤ <ref loc="LUK 20:9-19">ሉቃ 20፥9‑19</ref></char></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33"/>
    <char style="wj">“ፈኬኘ ብራ ቶኮ ዸገኣ፤ አባ ለፋ ከን እዶ ዻበ ወይኒረ ወይኒ ዻበቴ ቶኮቱ ቱሬ። እንስ ናኖሳት ደላ እጃሬ፣ አች ኬሰት ቦለ እት ወይኒ ጩንፈን ቆቴ ቆጢ ኤጉምሳ እጃሬ። ኤርገሲስ ለፈ ወይኒ ሰነ ቆናን ቡልቶተት ክራ ኬነቴ ብየ ፈጎ ዸቄ።</char> <verse eid="MAT 21:33"/><verse number="34" style="v" sid="MAT 21:34"/><char style="wj">እንስ ዬሮን እት ምዻን ወልት ቀበን ጌኛን አከ እሳን እጀሳ ፍደኒፊፍ ገርቦተሳ ቆቱወን ሰነት ኤርገቴ።</char><verse eid="MAT 21:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 21:35"/>
    <char style="wj">“ቆቱወን ሱንስ ገርቦተ ነምቻ ቀበኒ፣ እሰ ቶኮ ንዻነን፤ እሰ ካን ንአጄሰን፤ እሰ ሰደፋሞ ዸጋን ቱመን።</char> <verse eid="MAT 21:35"/><verse number="36" style="v" sid="MAT 21:36"/><char style="wj">አመስ ገርቦተ ወረ ዱራ ጫላ ባይአተን ብራ ኤርገቴ፤ ቆናን ቡልቶትን ሱንስ አኩመ ሰነ እሳን ጎዸን።</char> <verse eid="MAT 21:36"/><verse number="37" style="v" sid="MAT 21:37"/><char style="wj">ዹመረትስ እን፣ ‘እልመኮ ንከበጁ’ ጄዼ እልመሳ እሳንት ኤርገቴ።</char><verse eid="MAT 21:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 21:38"/>
    <char style="wj">“ቆናን ቡልቶትን ሱን ገሩ ዮሙ እልመ ሰነ አርገንት፣ ‘ዻልቱን እሰ ከነ። ኮታ እሰ አጄፍኔ ዻለሳ ፉዸትና!’ ወሊን ጄዸን።</char> <verse eid="MAT 21:38"/><verse number="39" style="v" sid="MAT 21:39"/><char style="wj">ከናፉ እሳን ፉዸኒ እዶ ዻበ ወይኒ ኬሳ ገድ ባሰኒ እሰ አጄሰን።</char><verse eid="MAT 21:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40"/>
    <char style="wj">“ኤጋ አባን እዶ ዻበ ወይኒ ሰና ዮሙ ዹፉት ቆቱወን ሰነ ማል ጎዽነ ላተ?”</char><verse eid="MAT 21:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41"/>እሳንስ፣ “እን ነሞተ ሀሞ ሰነ ሃለ ሀማዻን ንበሌሰ፤ እዶ ዻበ ወይኒ ሰነስ ቆቱወን ዬሮ ምዻን ወልት ቀበሙት ቆደ ምዻንሳ ኬነኒፍ ከኔን ብራት ደበርሴ ንኬነ” ጄዸኒ ዴብሰን።<verse eid="MAT 21:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42"/>ዬሱስስ አከነ እሳኒን ጄዼ፤ <char style="wj">“እስን ዱቢ ከተቢወን ቁልቁሉ ኬሰት፣</char></para>
  <para style="q1" vid="MAT 21:42">
    <char style="wj">“ ‘ዸጋን እጃርቶትን ቱፈተን፣</char></para>
  <para style="q2" vid="MAT 21:42">
    <char style="wj">ዸጋ ጎሌ ተኤረ፤</char></para>
  <para style="q1" vid="MAT 21:42">
    <char style="wj">ከነስ ጎፍታቱ ጎዼ፤</char></para>
  <para style="q2" vid="MAT 21:42">
    <char style="wj">ኩንሞ እጀኬኘት ድንቂዸ’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">21፥42 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="PSA 118:22">ፋር 118፥22</ref>፣<ref loc="PSA 118:23">23</ref></char>
      </char>
    </note> <char style="wj">ጄዹ ሰነ</char></para>
  <para style="q2" vid="MAT 21:42">
    <char style="wj">ጎንኩማ ህንዱብፍኔ?</char><verse eid="MAT 21:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43"/>
    <char style="wj">“ከናፉ አን እስንትን ህመ፤ ሞቱማን ዋቃ እስንራ ፉዸተሜ ሰበ እጀሳ ጎዸቱት ንኬነመ።</char> <verse eid="MAT 21:43"/><verse number="44" style="v" sid="MAT 21:44"/><char style="wj">ነምን ዸጋ ከነረት ኩፉ ከምዩ ጨጨቤ ቡቱተ፤ ነምን ዸግች እረት ኩፉ ከምዩ ንዳከመ።”</char><verse eid="MAT 21:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45"/>ሉቦትን ሀንገፎትኒፊ ፈሪሶትን ዮሙ ፈኬኘወን ዬሱስ ዸገአንት አከ እን ዋኤሳኒ ዱበቴ ቤከን። <verse eid="MAT 21:45"/><verse number="46" style="v" sid="MAT 21:46"/>እሳንስ እሰ ቀቡ በርባደን፤ ገሩ ሰበቢ ነሞትን ዬሱስን አከ ራጂት እላላ ቱረኒፍ ነሞተ ሰነ ሶዳተን።<verse eid="MAT 21:46"/></para>
  <chapter eid="MAT 21"/>
  <chapter number="22" style="c" sid="MAT 22"/>
  <para style="s1">ፈኬኘ ጭዸ ፉዻፊ ሄሩማ</para>
  <para style="r">
    <ref loc="MAT 22:2-14">22፥2‑14</ref> ኩወእ – <char style="xt"><ref loc="LUK 14:16-24">ሉቃ 14፥16‑24</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1"/>ዬሱስ አመስ አከነ ጄዼ ፈኬኛን ዴቢ ኬኔፍ፦ <verse eid="MAT 22:1"/><verse number="2" style="v" sid="MAT 22:2"/><char style="wj">“ሞቱማን ሰሚ ሞቲ እልመሳቲፍ ጭዸ ፉዻ ቆጴሴ ቶኮ ፈካተ።</char> <verse eid="MAT 22:2"/><verse number="3" style="v" sid="MAT 22:3"/><char style="wj">እንስ አከ እሳን ወረ ጭዸ ሰነት አፌረመን ዋመኒፍ ገርቦተሳ ኤርጌ፤ ወር ዋመመን ሱን ገሩ ዹፉ ህንበርባድኔ።</char><verse eid="MAT 22:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 22:4"/>
    <char style="wj">“አመስ አከነ ጄዼ ገርቦተ ብራ ኤርጌ፤ ‘ኩኖ አን እርባተኮ ቆጴሴረ፦ ሰንጎትንኮ፣ ሆሪንኮ ጮጮሞንስ ቀለመኒ ወን ሁንድኑ ቆጴፈሜረ። ገረ ጭዸ ፉዻፊ ሄሩማ ኮታ ጄዻቲ ወረ አፌረመን ሰነት ህማ።’</char><verse eid="MAT 22:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 22:5"/>
    <char style="wj">“እሳን ገሩ ቱፈተኒ፣ እን ቶኮ ገረ ለፈ ቆቲሳሳ፣ ካንሞ ገረ ደልደለሳ ዸቄ።</char> <verse eid="MAT 22:5"/><verse number="6" style="v" sid="MAT 22:6"/><char style="wj">ወር ሀፈንሞ ገርቦተሳ ቀበኒ ሰልጵሰን፤ ንአጄሰንስ።</char> <verse eid="MAT 22:6"/><verse number="7" style="v" sid="MAT 22:7"/><char style="wj">ሞትችስ ንኣሬ። ሎልቶተሳስ ኤርጌ ወረ ገርቦተሳ አጄሰን ሰነ በሌሴ፤ መጋላሳኒስ ንጉቤ።</char><verse eid="MAT 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 22:8"/>
    <char style="wj">“ኤርገሲ እን ገርቦተሳቲን አከነ ጄዼ፤ ‘ዸንጋን ጭዸ ፉዻ ቆጴፈሜረ፤ ወር አፌረመን ገሩ ጭዸ ከናፍ ህንመሌ።</char> <verse eid="MAT 22:8"/><verse number="9" style="v" sid="MAT 22:9"/><char style="wj">ከናፉ ገረ ቀጣሙረ ከራት በኣቲ ነመ አርግተን ሁንደ ገረ ጭዻት አፌራ።’</char> <verse eid="MAT 22:9"/><verse number="10" style="v" sid="MAT 22:10"/><char style="wj">ገርቦትን ሱንስ ከራት በአኒ ነመ አርገን ሁንደ፣ ሀማስ ጋሪስ ወልት ቀበን፤ ገልም ጭዻ ሱንስ ኬሱሞታን ጉተሜ።</char><verse eid="MAT 22:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11"/>
    <char style="wj">“ሞትች ዮሙ ኬሱሞተ እላሉፍ ኦል ሴኔት፣ ነመ ኡፈተ ጭዻ ህንኡፈትን ቶኮ አችት አርጌ።</char> <verse eid="MAT 22:11"/><verse number="12" style="v" sid="MAT 22:12"/><char style="wj">እንስ፣ ‘ያ ምቹኮ፣ አት አከምት ኡቱ ኡፈተ ጭዻ ህንኡፈትን አስ ሴንቴ?’ ጄዼ እሰ ጋፈቴ። ነምች ገሩ ዋን ዱበቱ ዸቤ።</char><verse eid="MAT 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 22:13"/>
    <char style="wj">“ሞትችስ ተጃጅልቶተሳቲን፣ ‘ነምቸ ከነ ሀርካፊ ሚለ ህዻቲ ዱከነ አላት ገድ ደርበዻ፤ አችትስ ቦኡፊ እልካን ቀሩቱ ተአ’ ጄዼ።</char><verse eid="MAT 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14"/>
    <char style="wj">“ወር አፌረመን ባይኤዻቲ፤ ወር ፍለተመን ገሩ ሙራሰ።”</char><verse eid="MAT 22:14"/></para>
  <para style="s1">ቄሳሪፍ ግብረ ከፈሉ</para>
  <para style="r">
    <ref loc="MAT 22:15-22">22፥15‑22</ref> ኩወፈ – <char style="xt"><ref loc="MRK 12:13-17">ማር 12፥13‑17</ref>፤ <ref loc="LUK 20:20-26">ሉቃ 20፥20‑26</ref></char></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15"/>ኤርገሲስ ፈሪሶትን ዋኑመ እን ዱበቱን እሰ ቀቡፍ ገድ በአኒ ዬሱስት መርአተን። <verse eid="MAT 22:15"/><verse number="16" style="v" sid="MAT 22:16"/>እሳንስ በረቶተሳኒ ገሬ ሄሮድስ ወጅን እሰት ኤርገን። አከነስ ጄዸን፤ “ያ በርሲሳ፣ አከ አት ነመ ዹጋ ታቴ፣ አከ አት ዹጋዻን ከራ ዋቃ በርሲፍቱ ቤክነ። አት ነመ ወል ህንጫልችፍቱ፤ ፉለ ነማስ ህንእላልቱ። <verse eid="MAT 22:16"/><verse number="17" style="v" sid="MAT 22:17"/>ኤጋ ሜ ኑት ህም፤ ያድንኬ ማል? ቄሳሪፍ ግብረ ከፈሉን ኤየመሜረሞ ህንኤየመምኔ?”<verse eid="MAT 22:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18"/>ዬሱስ ገሩ ሀምነሳኒ ቤኬ አከነ ጄዼ፤ <char style="wj">“ያ ፈኬስቶተነነ፣ እስን ማሊፍ ነ ቆርቱ?</char> <verse eid="MAT 22:18"/><verse number="19" style="v" sid="MAT 22:19"/><char style="wj">ሜ ማለቀ ግብረ ከፈልተን ነት አርግሲሳ።”</char> እሳንስ ዲናሪ ቶኮ እሰት ፍደን፤ <verse eid="MAT 22:19"/><verse number="20" style="v" sid="MAT 22:20"/>እንሞ፣ <char style="wj">“ፈኪን ኩን ከን ኤኙት? ከተቢን ኩንስ ከን ኤኙት?”</char> ጄዼ እሳን ጋፈቴ።<verse eid="MAT 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21"/>እሳንስ፣ “ከን ቄሳር” ጄዸኒ ዴብሰን።</para>
  <para style="p" vid="MAT 22:21">ከነረት እን፣ <char style="wj">“ዮስ ከን ቄሳር ቄሳሪፍ፣ ከን ዋቃሞ ዋቃፍ ኬና”</char> ጄዼን።<verse eid="MAT 22:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22"/>እሳንስ ዮሙ ዋን ከነ ዸገአንት ንድንቅፈተን። ከናፍ እሰ ዺሰኒ ቀጄለን።<verse eid="MAT 22:22"/></para>
  <para style="s1">ዋኤ ዱኣ ከኡ</para>
  <para style="r">
    <ref loc="MAT 22:23-33">22፥23‑33</ref> ኩወፈ – <char style="xt"><ref loc="MRK 12:18-27">ማር 12፥18‑27</ref>፤ <ref loc="LUK 20:27-40">ሉቃ 20፥27‑40</ref></char></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23"/>ጉዩመ ሰነ ሰዱቆትን ወር ዱኣ ከኡን ህንጅሩ ጄዸን ቶኮ ቶኮ ገረሳ ዹፈኒ ጋፊ እሰ ጋፈተን። <verse eid="MAT 22:23"/><verse number="24" style="v" sid="MAT 22:24"/>አከነስ ጄዸን፤ “ያ በርሲሳ፣ ሙሴን፣ ‘ነምን ቶኮ ኒቲ ፉዼ ኡቱ እጆሌ ህንዸልችን ዮ ዱኤ ኦቦሌስሳ ኒቲ ሰነ ዻሌ ኦቦሌሰሳቲፍ ሰኚ ሃዻቡ’ ጄዼ ኑት ህሜረ። <verse eid="MAT 22:24"/><verse number="25" style="v" sid="MAT 22:25"/>ኩኖ ኦቦሎተ ቶርበቱ ኑ ብረ ቱሬ። እን ጀልቀባ ኒቲ ፉዼ ኡቱ እጆሌ ህንቀባትን ኒቲሳ ኦቦሌሰሳት ዺሴ ዱኤ። <verse eid="MAT 22:25"/><verse number="26" style="v" sid="MAT 22:26"/>ኦቦሌሰ ለመፋፊ ሰደፋረት፣ ሀመ እሰ ቶርበፋትስ ዋኑመ ሰነቱ ተኤ። <verse eid="MAT 22:26"/><verse number="27" style="v" sid="MAT 22:27"/>ዹመረት ዱበርትቲንስ ንዱቴ። <verse eid="MAT 22:27"/><verse number="28" style="v" sid="MAT 22:28"/>ኤጋ ጉያ ዱኣ ከኡት፣ ቶርበንሳኒ ኬሳ እሼን ኒቲ እሰ ከሚ ታት? ሁንድሳኒዩ እሼ ፉዸኒሩቲ።”<verse eid="MAT 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29"/>ዬሱስሞ አከነ ጄዼ ዴብሴ፤ <char style="wj">“እስን ዋን ከተቢወን ቁልቁሉ ዮካን ሁምነ ዋቃ ህንቤክኔፍ ዶጎጎርቱ።</char> <verse eid="MAT 22:29"/><verse number="30" style="v" sid="MAT 22:30"/><char style="wj">ጉያ ዱኣ ከኡት ነሞትን አከ ኤርገሞተ ሰሚ ተኡ መሌ ህንፉዸን፤ ህንሄሩመንስ።</char> <verse eid="MAT 22:30"/><verse number="31" style="v" sid="MAT 22:31"/><char style="wj">ገሩ እስን ዋን ዋቅን ዋኤ ዱኣ ከኡ ወረ ዱአኒ እስኒን ጄዼ ህንዱብፍኔ? እንስ አከነ ጄዸ፤</char> <verse eid="MAT 22:31"/><verse number="32" style="v" sid="MAT 22:32"/><char style="wj">‘አን ዋቀ አብረሃም፣ ዋቀ ይስሃቂፊ ዋቀ ያቆብ።’</char><note caller="+" style="f"><char style="fr" closed="false">22፥32 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 3:6">በኡ 3፥6</ref></char></char></note> <char style="wj">እን ዋቀ ወረ ጅራተኒት መሌ ዋቀ ወረ ዱአኒ ምት።”</char><verse eid="MAT 22:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33"/>ነሞትን ዮሙ ዋን ከነ ዸገአንት፣ በርሲሰሳ ድንቅፈተን።<verse eid="MAT 22:33"/></para>
  <para style="s1">አጀጀ አጀጀወን ሁንደ ጫሉ</para>
  <para style="r">
    <ref loc="MAT 22:34-40">22፥34‑40</ref> ኩወፈ – <char style="xt"><ref loc="MRK 12:28-31">ማር 12፥28‑31</ref></char></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34"/>ፈሪሶትን ዮሙ አከ ዬሱስ ሰዱቆተ አፋን ቀበቺሴ ዸገአንት ወልት ቀበመን። <verse eid="MAT 22:34"/><verse number="35" style="v" sid="MAT 22:35"/>እሳን ኬሳስ ሀዩን ሴራ ቶኮ አከነ ጄዼ ጋፊ ከናን እሰ ቆሬ፦ <verse eid="MAT 22:35"/><verse number="36" style="v" sid="MAT 22:36"/>“ያ በርሲሳ፣ ሴረ ኬሳ አጀጅን ጉዳን እሰ ከም?”<verse eid="MAT 22:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37"/>ዬሱስስ አከነ ጄዼን፤ <char style="wj">“ዋቀኬ ጎፍትቸ ገራኬ ጉቱዻን፣ ሉቡኬ ጉቱዻን፣ ያደኬ ጉቱዻን ጃለዹ።</char><note caller="+" style="f"><char style="fr" closed="false">22፥37 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 6:5">ኬዴ 6፥5</ref></char></char></note> <verse eid="MAT 22:37"/><verse number="38" style="v" sid="MAT 22:38"/><char style="wj">ኩንስ አጀጀ ጀልቀባቲፊ ጉድቸ።</char> <verse eid="MAT 22:38"/><verse number="39" style="v" sid="MAT 22:39"/><char style="wj">አጀጅን ለመፋንስ እሱመ ፈካተ፦ ‘ኦላኬ አኩመ ኦፊኬቲት ጃለዹ’</char><note caller="+" style="f"><char style="fr" closed="false">22፥39 </char><char style="ft" closed="false"><char style="xt"><ref loc="LEV 19:18">ሌዎ 19፥18</ref></char></char></note> <char style="wj">ጄዸ።</char> <verse eid="MAT 22:39"/><verse number="40" style="v" sid="MAT 22:40"/><char style="wj">ሴሪፊ ራጆትን ሁንድኑ አጀጀወን ከኔን ለማንረት ሁንዴፈሙ።”</char><verse eid="MAT 22:40"/></para>
  <para style="s1">ክርስቶስ እልመ ኤኙት?</para>
  <para style="r">
    <ref loc="MAT 22:41-46">22፥41‑46</ref> ኩወፈ – <char style="xt"><ref loc="MRK 12:35-37">ማር 12፥35‑37</ref>፤ <ref loc="LUK 20:41-44">ሉቃ 20፥41‑44</ref></char></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41"/>ኡቱ ፈሪሶትን ወልት ቀበመኒ ጅረኑ ዬሱስ ጋፊ ቶኮ እሳን ጋፈቴ፤ <verse eid="MAT 22:41"/><verse number="42" style="v" sid="MAT 22:42"/>እንስ፣ <char style="wj">“እስን ዋኤ ክርስቶስ ማል ያዱ? እን እልመ ኤኙት?”</char> ጄዼ።</para>
  <para style="p" vid="MAT 22:42">እሳንስ፣ “እን እልመ ዳዊት” ጄዸኒ ዴብሰን።<verse eid="MAT 22:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43"/>እንስ አከነ እሳኒን ጄዼ፤ <char style="wj">“ዮስ ዳዊት አከምት ሀፉራን ጌጌፈሜ፣ ‘ጎፍታ’ እሳን ጄዸሬ? እን አከነ ጄዻቲ፦</char><verse eid="MAT 22:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44"/>
    <char style="wj">“ ‘ጎፍታን ጎፍታኮቲን፦</char></para>
  <para style="q2" vid="MAT 22:44">
    <char style="wj">“ሀመ አን ዲኖተኬ ሚለኬ ጀለ</char></para>
  <para style="q1" vid="MAT 22:44">
    <char style="wj">ሲፍ ገልቹት</char></para>
  <para style="q2" vid="MAT 22:44">
    <char style="wj">ገረ ምርገኮ ታእ”</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">22፥44 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="PSA 110:1">ፋር 110፥1</ref>
        </char>
      </char>
    </note> <char style="wj">ጄዼ።’</char><verse eid="MAT 22:44"/></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45"/>
    <char style="wj">ኤርገ ዳዊት፣ ‘ጎፍታ’ ጄዼ እሰ ዋሜ፣ ዮስ እን አከምት እልመሳ ተኡ ደንደአሬ?”</char> <verse eid="MAT 22:45"/><verse number="46" style="v" sid="MAT 22:46"/>ነምን ቶኮዩ ዋን ቶኮ እሳፍ ዴብሱ ህንደንዴኜ፤ ጋፈሲ ጀልቀቤ ነምን ቶኮዩ ዴብኤ ጋፊ እሰ ጋፈቹፍ እጀ ህንጀባትኔ።<verse eid="MAT 22:46"/></para>
  <chapter eid="MAT 22"/>
  <chapter number="23" style="c" sid="MAT 23"/>
  <para style="s1">አኬከቺሰ ዬሱስ ኬኔ</para>
  <para style="r">
    <ref loc="MAT 23:1-7">23፥1‑7</ref> ኩወፈ – <char style="xt"><ref loc="MRK 12:38">ማር 12፥38</ref>፣<ref loc="MRK 12:39">39</ref>፤ <ref loc="LUK 20:45">ሉቃ 20፥45</ref>፣<ref loc="LUK 20:46">46</ref></char></para>
  <para style="r">
    <ref loc="MAT 23:37-39">23፥37‑39</ref> ኩወፈ – <char style="xt"><ref loc="LUK 13:34">ሉቃ 13፥34</ref>፣<ref loc="LUK 13:35">35</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1"/>ዬሱስስ ኤርገሲ ኡመታፊ በረቶተሳቲን አከነ ጄዼ፦ <verse eid="MAT 23:1"/><verse number="2" style="v" sid="MAT 23:2"/><char style="wj">“በርሲስቶትን ሴራቲፊ ፈሪሶትን በርጩመ ሙሴረ ታአኒሩ።</char> <verse eid="MAT 23:2"/><verse number="3" style="v" sid="MAT 23:3"/><char style="wj">ከናፉ ዋን እሳን እስንት ህመን ሁንዱማ ጎዻ፤ ኤጋስ። ገሩ ዋን እሳን ሆጄተን ህንሆጄትና፤ እሳን ንዱበቱ መሌ ዋን ዱበተን ሰነ ህንሆጄተኒቲ።</char> <verse eid="MAT 23:3"/><verse number="4" style="v" sid="MAT 23:4"/><char style="wj">እሳን በኣ ኡልፋታ ህዸኒ ገቲቲ ነማረ ካኡ፤ ኦፊሳኒቲ ገሩ በኣ ሰነ ሶቾሱፍ ቁባንሌ ቱቁ ህንበርባደን።</char><verse eid="MAT 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 23:5"/>
    <char style="wj">“እሳን ዋን ሆጄተን ሁንዱማ ነሞተት ኦፍ አርግሲሱፍ ሆጄቱ፦ ኩዻመሳኒ ንበልእፈቱቲ፤ ሀንዳረ ኡፈተሳኒስ ንዼሬፈቱ።</char> <verse eid="MAT 23:5"/><verse number="6" style="v" sid="MAT 23:6"/><char style="wj">እዶ ጭዻት እዶ ኡልፍና፣ መኔን ሰገዳ ኬሰትሞ ታኡምሰ ኡልፍና ጃለቱ።</char> <verse eid="MAT 23:6"/><verse number="7" style="v" sid="MAT 23:7"/><char style="wj">ገባ ኬሰትስ አከ ነሞትን ነጋ እሳን ጋፈተኒፊ አከ ‘ያ በርሲሳ’ ጄዸኒ እሳን ዋመን ጃለቱ።</char><verse eid="MAT 23:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8"/>
    <char style="wj">“እስን ገሩ፣ ‘በርሲሳ’ ጄዸምተኒ ህንዋመምና፤ በርሲሳ ቶኮ ቆፈ ቀብዱቲ። እስን ሁንድስ ኦቦሎተ ወሊኬሰኒት።</char> <verse eid="MAT 23:8"/><verse number="9" style="v" sid="MAT 23:9"/><char style="wj">ለፈረት ነመ ቶኮንሌ ‘አባ’ ህንጄዽና፤ እስን አባ ቶኮ ቆፈ ቀብዱቲ፤ እንስ እሰ ሰሚራት።</char> <verse eid="MAT 23:9"/><verse number="10" style="v" sid="MAT 23:10"/><char style="wj">‘ጎፍቶተ’ ጄዸምተኒ ህንዋመምና፤ እስን ጎፍታ ቶኮ ቆፈ ቀብዱቲ፤ እንስ ክርስቶስ።</char> <verse eid="MAT 23:10"/><verse number="11" style="v" sid="MAT 23:11"/><char style="wj">እስን ኬሳ ነምን ሁንደኬሰን ጫሉ ተጃጅላኬሰን ሃተኡ።</char> <verse eid="MAT 23:11"/><verse number="12" style="v" sid="MAT 23:12"/><char style="wj">ነምን ኦል ኦፍ ቀቡ ከምዩ ገድ ቀበማቲ፤ ነምን ገድ ኦፍ ቀቡ ከምዩ ገሩ ኦል ቀበመ።</char><verse eid="MAT 23:12"/></para>
  <para style="s1">ወዮወን ቶርበ</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13"/>
    <char style="wj">“ያ በርሲስቶተ ሴራቲፊ ፈሪሶተ ፈኬስቶተነነ፣ እስኒፍ ወዮ! እስን ሞቱማ ሰሚ ነሞተ ዱራ ጩፍቱቲ። ኦፊኬሰኒ ህንሴንተን፤ ወረ ሴኑ ያለንስ አከ እሳን ሴነን ህንጎተን።</char></para>
  <para style="p" vid="MAT 23:13">[ <verse eid="MAT 23:13"/><verse number="14" style="v" sid="MAT 23:14"/><char style="wj">“ያ በርሲስቶተ ሴራቲፊ ፈሪሶተ ፈኬስቶተነነ፣ እስኒፍ ወዮ! መነ ሃዸ ህዬሳ ሳምተኒ ኦንስቱቲ፤ እት ፈኬሱፍ ከዸትና ንዼሬስቱ፤ ከናፉ ሙርቲ ጫሉቱ እስንት ሙረመ።</char>]<note caller="+" style="f"><char style="fr" closed="false">23፥14 </char><char style="ft" closed="false">ሂካወን ቶኮ ቶኮ ኩታ ከነ ህንደበለን።</char></note><verse eid="MAT 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15"/>
    <char style="wj">“ያ በርሲስቶተ ሴራቲፊ ፈሪሶተ ፈኬስቶተነነ፣ እስኒፍ ወዮ! ነመ ቶኮ አመንቲኬሰንት ገልፈቹፍ ጄተኒ ለፋፊ ገላነረ ጆርቱ፤ ዮሙ እን አመኑትስ አከ እን እስን ጫላ ደቻ ለመ እልመ ገሃነም ተኡ እሰ ጎቱ።</char><verse eid="MAT 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16"/>
    <char style="wj">“ቀጄልችቶተ ጃሞተነነ፣ እስኒፍ ወዮ! እስን፣ ‘ነምን ከምዩ ዮ መነ ቁልቁሉማቲን ከከቴ፣ ኩን ሆማ ምት፤ ነምን ከምዩ ዮ ወርቄ መነ ቁልቁሉማቲን ከከቴ ገሩ ከኩን ሱን እሰ ቀበ’ ጄቱ።</char> <verse eid="MAT 23:16"/><verse number="17" style="v" sid="MAT 23:17"/><char style="wj">እስን ጎዎታፊ ጃሞተነነ፣ ወርቄሞ መነ ቁልቁሉማ ከን ወርቄ ሰነ ቁልቁሌሱቱ ጫለ?</char> <verse eid="MAT 23:17"/><verse number="18" style="v" sid="MAT 23:18"/><char style="wj">አከሱመስ እስን፣ ‘ነምን ከምዩ ዮ እዶ ኣርሳቲን ከከቴ፣ ኩን ሆማ ምት፤ ዮ ኬና እዶ ኣርሳረ ጅሩ ሰናን ከከቴ ገሩ ከኩን ሱን እሰ ቀበ’ ጄቱ።</char> <verse eid="MAT 23:18"/><verse number="19" style="v" sid="MAT 23:19"/><char style="wj">እስን ጃሞተነነ፣ ኬና ሰነሞ እዶ ኣርሳ እሰ ኬና ሰነ ቁልቁሌሱቱ ጫለ?</char> <verse eid="MAT 23:19"/><verse number="20" style="v" sid="MAT 23:20"/><char style="wj">ከናፉ ነምን እዶ ኣርሳቲን ከከቱ፣ እዶ ኣርሳቲፊ ዋን እሰረ ጅሩ ሁንዱማን ንከከተ።</char> <verse eid="MAT 23:20"/><verse number="21" style="v" sid="MAT 23:21"/><char style="wj">ነምን መነ ቁልቁሉማቲን ከከቱ፣ መነ ቁልቁሉማቲፊ እሰ መነ ቁልቁሉማ ኬሰ ጅራቱን ከከተ።</char> <verse eid="MAT 23:21"/><verse number="22" style="v" sid="MAT 23:22"/><char style="wj">ነምን ሰሚዻን ከከቱ፣ ቴሶ ዋቃቲፊ እሰ ቴሶ ሰነረ ታኡን ከከተ።</char><verse eid="MAT 23:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23"/>
    <char style="wj">“ያ በርሲስቶተ ሴራቲፊ ፈሪሶተ ፈኬስቶተነነ፣ እስኒፍ ወዮ! እስን አበሱደ፣ እንስላላፊ ከሙኒ ኩዸን ኬሳ ቶኮ ንኬንቱ። ገሩ ሴረ ኬሳ ዋን ጫላት በርባችሳ ተኤ ጄቹንስ ሙርቲ ቀጄላ፣ አራራፊ አመነሙማ ዺፍተኒርቱ። ስላ ኡቱ እሰ ዱራ ህንዺስን እሰ ዱባ ሆጂረ ኦልቹ ቀብዱ ቱሬ።</char> <verse eid="MAT 23:23"/><verse number="24" style="v" sid="MAT 23:24"/><char style="wj">እስን ቀጄልችቶተ ጃሞተነነ! ቦኬ ንጨለልቱ፤ ጋለሞ ንልቅምስቱ።</char><verse eid="MAT 23:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25"/>
    <char style="wj">“ያ በርሲስቶተ ሴራቲፊ ፈሪሶተ ፈኬስቶተነነ፣ እስኒፍ ወዮ! ዱበ ጦፎቲፊ ጫቢ ንቁልቁሌስቱ፤ ኬስሳኒ ገሩ ሳምቻፊ ኦፍቱማዻን ጉተሜረ።</char> <verse eid="MAT 23:25"/><verse number="26" style="v" sid="MAT 23:26"/><char style="wj">ያ ፈሪስቸ ጃማነነ! ጀልቀበት ኬሰ ጦፎቲፊ ጫቢ ቁልቁሌስ፤ ኤርገሲ ዱብንሳስ ንቁልቁላኣ።</char><verse eid="MAT 23:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27"/>
    <char style="wj">“ያ በርሲስቶተ ሴራቲፊ ፈሪሶተ ፈኬስቶተነነ፣ እስኒፍ ወዮ! እስን አኩመ አዋለ ኖራ ድበሜ ከን ዱብንሳ በሬዳ ፈካቴ ኬስሳሞ ለፌ ነሞተ ዱአኒቲን፣ ጡራኡማ ሁንዳንስ ጉተሜት።</char> <verse eid="MAT 23:27"/><verse number="28" style="v" sid="MAT 23:28"/><char style="wj">እስንስ አከሱመ ዱባን ቀጄልቶተ ፈካተኒ ነሞተት ሙልአቱ፤ ኬስኬሰን ገሩ ፈኬሱፊ ሀምናን ጉተሜረ።</char><verse eid="MAT 23:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29"/>
    <char style="wj">“ያ በርሲስቶተ ሴራቲፊ ፈሪሶተ ፈኬስቶተነነ፣ እስኒፍ ወዮ! እስን ራጆታፍ አዋለ እጃርቱቲ፤ ሶዱ ቀጄልቶታስ ንበሬችቱ።</char> <verse eid="MAT 23:29"/><verse number="30" style="v" sid="MAT 23:30"/><char style="wj">እስን፣ ‘ኑ ኡቱ በረ አቦቲኬኛ ሰነ ጅራትኔ ስላ ዺገ ራጆታ ዸንገላሱ ኬሰት እሳን ወጅን ህንህርማትኑ ቱሬ’ ጄቱ።</char> <verse eid="MAT 23:30"/><verse number="31" style="v" sid="MAT 23:31"/><char style="wj">ከናፉ እስን አከ ሰኚ ወረ ራጆተ አጄሰን ሰና ታተን ኦፉመኬሰንት ዹጋ ባቱ።</char> <verse eid="MAT 23:31"/><verse number="32" style="v" sid="MAT 23:32"/><char style="wj">ኤጋ ሰፈርቱ ጩቡ አቦቲኬሰኒ ጉታ!</char><verse eid="MAT 23:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33"/>
    <char style="wj">“ቦፎተነነ! እጆሌ ቡቲነነ! እስን አከምት ሙርቲ ገሃነም ጀላ በኡ ደንዴሱ?</char> <verse eid="MAT 23:33"/><verse number="34" style="v" sid="MAT 23:34"/><char style="wj">ከናፉ፣ ኩኖ አን ራጆታፊ ኦጌዪ፣ በርሲስቶተስ ገረኬሰንት ነንኤርገ። እስንስ እሳን ኬሳ ገር ቶኮ ንአጄፍቱ፤ ንፈንፍቱ፤ ወረ ካንሞ መኔን ሰገዳኬሰን ኬሰት ገረፍቱ፤ መጋላ ቶኮራ ገረ መጋላ ብራትስ እሳን አሪቱ።</char> <verse eid="MAT 23:34"/><verse number="35" style="v" sid="MAT 23:35"/><char style="wj">ከናፍ ዺገ አቤል ነመ ቀጄላ ሰናቲ ጀልቀቤ ሀመ ዺገ ዘካርያስ እልመ በራክዩ እሰ እስን መነ ቁልቁሉማቲፊ እዶ ኣርሳ ግዱት አጄፍተኒት፣ ዺገ ቁልቁሉ ለፈት ዸንገላፈሜ ሁንዱመት ንጋፈተምቱ።</char> <verse eid="MAT 23:35"/><verse number="36" style="v" sid="MAT 23:36"/><char style="wj">አን ዹጉመ እስንትን ህመ፤ ኩን ሁንድኑ ዸሎተ ከነት ንዹፈ።</char><verse eid="MAT 23:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37"/>
    <char style="wj">“ያ ዬሩሳሌም፣ ያ ዬሩሳሌም፣ አት ከን ራጆተ አጄፍቱ፣ ወረ ገረኬት ኤርገመንስ ከን ዸጋዻን ቱምቱ፣ አኩመ እንዳንቆን ጩጪሼ ቆቾሼ ጀለት ወልት ቀበቱ ሰነ አንስ እጆሌኬ ወልት ቀቡፍ ዬሮ ሜቀን ሀዌ! እስን ገሩ ህንበርባድኔ።</char> <verse eid="MAT 23:37"/><verse number="38" style="v" sid="MAT 23:38"/><char style="wj">ኩኖ፣ መንኬሰን ኦኔ እስኒ ሀፈ።</char> <verse eid="MAT 23:38"/><verse number="39" style="v" sid="MAT 23:39"/><char style="wj">አን እስንትን ህማቲ፤ እስን ሀመ፣ ‘እን መቃ ጎፍታቲን ዹፉ ሱን ኤብፈማዸ’ ጄተንት ለመተ ነ ህንአርግተን።”</char><verse eid="MAT 23:39"/></para>
  <chapter eid="MAT 23"/>
  <chapter number="24" style="c" sid="MAT 24"/>
  <para style="s1">መለቶ ዹመ በራ</para>
  <para style="r">
    <ref loc="MAT 24:1-51">24፥1‑51</ref> ኩወፈ – <char style="xt"><ref loc="MRK 13:1-37">ማር 13፥1‑37</ref>፤ <ref loc="LUK 21:5-36">ሉቃ 21፥5‑36</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1"/>ኡቱ ዬሱስ መነ ቁልቁሉማቲ በኤ ዴማ ጅሩ በረቶትንሳ ገሞወን መነ ቁልቁሉማ እሰት አርግሲሱፍ ገረሳ ዹፈን። <verse eid="MAT 24:1"/><verse number="2" style="v" sid="MAT 24:2"/>እንስ፣ <char style="wj">“ዋን ከነ ሁንደ አርግቱ? አን ዹጉመ እስንትን ህመ፤ አስት ዸጋን ዸጋረት ሀፉ ቶኮ ህንጅሩ፤ ሁንድሳዩ ንዲገመ”</char> ጄዼ ዴብሴፍ።<verse eid="MAT 24:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3"/>ኡቱ ዬሱስ ቱሉ ኤጄርሳረ ታኤ ጅሩ፣ በረቶትንሳ ኮጳሳኒ ገረሳ ዹፈኒ፣ “ሜ ኑት ህም፤ ወን ኩን ዮም ተአ? መለቶን ዹፈኬቲፊ መለቶን ዹመ በርቻ ማል?” ጄዸን።<verse eid="MAT 24:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4"/>ዬሱስስ አከነ ጄዼ ዴብሴፍ፤ <char style="wj">“አከ ነምን ቶኮዩ እስን ህንጎዎምስኔፍ ኦፍ ኤገዻ።</char> <verse eid="MAT 24:4"/><verse number="5" style="v" sid="MAT 24:5"/><char style="wj">ነሞትን ሄዱን፣ ‘አን ክርስቶስ’ ጄዸኒ መቃኮቲን ንዹፉቲ፤ ነመ ሄዱስ ንጎዎምሱ።</char> <verse eid="MAT 24:5"/><verse number="6" style="v" sid="MAT 24:6"/><char style="wj">እስን ዋኤ ወራናቲፊ ኦዱ ወራና ንዸጌሱ፤ ገሩ አከ ህንርፈትኔ ኦፍ ኤገዻ። ወን አከና ተኡ ቀባቲ፤ ዹምን ገሩ አመዩ ህንጌኜ።</char> <verse eid="MAT 24:6"/><verse number="7" style="v" sid="MAT 24:7"/><char style="wj">ሰብን ሰበት፣ ሞቱማንስ ሞቱማት ንከአ። ቤሊፊ ሶቺን ለፋ እዶ ገራ ገራት ንተአ።</char> <verse eid="MAT 24:7"/><verse number="8" style="v" sid="MAT 24:8"/><char style="wj">ገሩ ኩን ሁንድኑ ጀልቀበ ጭኒንሱ ደኡምሳት።</char><verse eid="MAT 24:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9"/>
    <char style="wj">“እሳን ደበርሰኒ ዽጵነት እስን ኬኑ፤ እስን አጄሱስ፤ ሰበቢ መቃኮቲፍስ ሰበ ሁንዳን ንጅበምቱ።</char> <verse eid="MAT 24:9"/><verse number="10" style="v" sid="MAT 24:10"/><char style="wj">ዬሮ ሰነት ነሞትን ባይኤን ንጉፈቱ፤ ደበርሰኒ ወል ኬኑ፤ ወል ጅቡስ፤</char> <verse eid="MAT 24:10"/><verse number="11" style="v" sid="MAT 24:11"/><char style="wj">ራጆትን ሶባ ሄዱን ንዹፉ፤ ነመ ሄዱስ ንጎዎምሱ።</char> <verse eid="MAT 24:11"/><verse number="12" style="v" sid="MAT 24:12"/><char style="wj">ሰበቢ ባይእነ ሀምናቲፍ ጃለል ነሞተ ባይኤ ንቀበናአ፤</char> <verse eid="MAT 24:12"/><verse number="13" style="v" sid="MAT 24:13"/><char style="wj">ነምን ሀመ ዹማት ጀባቴ ዻበቱ ገሩ ንፈየ።</char> <verse eid="MAT 24:13"/><verse number="14" style="v" sid="MAT 24:14"/><char style="wj">ወንጌል ሞቱማ ኩንስ አከ ሰበ ሁንዳፍ ዹገ በኡምሰ ተኡፍ አዱኛ ሁንደ ኬሰት ንለለበመ፤ ኤርገሲስ ዹምን ሱን ንዹፈ።</char><verse eid="MAT 24:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15"/>
    <char style="wj">“ከናፉ፣ ‘እስን ዮሙ ወን ጅብሲሳን በዲሰ ፍዱ’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">24፥15 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="DAN 9:27">ዳን 9፥27</ref>፤ <ref loc="DAN 11:31">11፥31</ref>፤ <ref loc="DAN 12:11">12፥11</ref></char>
      </char>
    </note> <char style="wj">ከን ዳንኤል ራጅች ዋኤሳ ዱበቴ ሱን እዶ ቁልቁሉ ዻበቴ አርግተንት፣ ነምን ዱብሱ ሃሁበቱ፤</char> <verse eid="MAT 24:15"/><verse number="16" style="v" sid="MAT 24:16"/><char style="wj">ዮሙስ ወር ይሁዳ ኬሰ ጅረን ቱሉወንት ሃበቀተን።</char> <verse eid="MAT 24:16"/><verse number="17" style="v" sid="MAT 24:17"/><char style="wj">ነምን በንቲ መናረ ጅሩ ቶኮዩ ዋን ቶኮሌ መነሳቲ ፉዸቹፍ ገድ ህንቡእን።</char> <verse eid="MAT 24:17"/><verse number="18" style="v" sid="MAT 24:18"/><char style="wj">ነምን ለፈ ቆቲሳ ኬሰ ጅሩ ቶኮዩ ኡፈተሳ ፉዸቹፍ ዱበት ህንዴብእን።</char> <verse eid="MAT 24:18"/><verse number="19" style="v" sid="MAT 24:19"/><char style="wj">በረ ሰነ ኬሰ ዱበርቶተ ኡልፋቲፊ ሃዾተ ሆስሰኒፍ ወዮ!</char> <verse eid="MAT 24:19"/><verse number="20" style="v" sid="MAT 24:20"/><char style="wj">ገሩ አከ በቀቹንኬሰን ገነ ኬሰ ዮካን ጉያ ሰንበታቲን ህንታኔፍ ከዸዻ።</char> <verse eid="MAT 24:20"/><verse number="21" style="v" sid="MAT 24:21"/><char style="wj">ዬሮ ሰነት ዽጵን ጉዳንሳ ንዹፋቲ፤ ዽጵን አከሲስ ኡመመ አዱኛቲ ጀልቀቤ ሀመ አማት ህንዹፍኔ፤ ስአችስ ጎንኩማ ህንዹፉ።</char><verse eid="MAT 24:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 24:22"/>
    <char style="wj">“ኡቱ ጉዮትን ሱን ገባበቹ ባተኒ ስላ ነምን ቶኮዩ ህንሀፉ ቱሬ፤ ገሩ ሰበቢ ፍለተምቶታቲፍ ጉዮትን ሱን ንገባበቱ።</char> <verse eid="MAT 24:22"/><verse number="23" style="v" sid="MAT 24:23"/><char style="wj">ዬሮ ሰነ ዮ ነምን ከምዩ፣ ‘እላ፣ ክርስቶስ አስ ጅረ!’ ዮካን ‘አች ጅረ!’ እስኒን ጄዼ፣ ህንአመንና።</char> <verse eid="MAT 24:23"/><verse number="24" style="v" sid="MAT 24:24"/><char style="wj">ክርስቶሶትን ሶባቲፊ ራጆትን ሶባ ንከኡቲ፤ እሳንስ ዮ ደንደአሜፍ ፍለተምቶተሌ ጎዎምሱፍ ጄዸኒ መለቶ ጉርጉዳፊ ድንቂ ንሆጄቱ።</char> <verse eid="MAT 24:24"/><verse number="25" style="v" sid="MAT 24:25"/><char style="wj">ኩኖ አን ዱራን ዱርሴ እስንት ህሜረ።</char><verse eid="MAT 24:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26"/>
    <char style="wj">“ከናፉ ዮ እሳን፣ ‘ኩኖ፣ እን ገሞጂ ኬሰ ጅረ’ እስኒን ጄዸን አች ህንዸቅና፤ ዮካን ዮ እሳን፣ ‘ኩኖ፣ መነ ኬሰ ጎለ ጅረ’ እስኒን ጄዸን ህንአመንና።</char> <verse eid="MAT 24:26"/><verse number="27" style="v" sid="MAT 24:27"/><char style="wj">አኩመ በከካን በአ ቢፍቱቲ ቡኤ ሀመ ልጠ ቢፍቱት ሙልአቱ ሰነ ዹፋቲን እልመ ነማስ አከሱመ ተአ።</char> <verse eid="MAT 24:27"/><verse number="28" style="v" sid="MAT 24:28"/><char style="wj">እዶ ረቅን ጅሩ ከምትዩ ጎጎጮሮወን ወልት ቀበሙ።</char><verse eid="MAT 24:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29"/>
    <char style="wj">“አኩመ ዽጵን በረ ሰና ደርቤን፣</char></para>
  <para style="q1" vid="MAT 24:29">
    <char style="wj">“ ‘አዱን ንዱከኖፍት፤</char></para>
  <para style="q2" vid="MAT 24:29">
    <char style="wj">ጅእስ እፈሼ ህንኬንቱ፤</char></para>
  <para style="q1" vid="MAT 24:29">
    <char style="wj">ኡርጂወን ሰሚራ ንሀርጨኡ፤</char></para>
  <para style="q2" vid="MAT 24:29">
    <char style="wj">ሁምኖትን ሰሚስ ንራፈሙ።’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">24፥29 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="ISA 13:10">እሳ 13፥10</ref>፤ <ref loc="ISA 34:4">34፥4</ref></char>
      </char>
    </note><verse eid="MAT 24:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30"/>
    <char style="wj">“ኤርገሲ መለቶን እልመ ነማ ሰሚረት ንሙልአተ፤ ሰቦትን አዱኛ ሁንድኑስ ንቦኡ። እሳንስ ኡቱ እልም ነማ ዱሜሰ ሰሚቲን ሁምናፊ ኡልፍነ ጉዳዻን ዹፉ ንአርጉ።</char> <verse eid="MAT 24:30"/><verse number="31" style="v" sid="MAT 24:31"/><char style="wj">እንስ ኤርገሞተሳ ሰገሌ መለከታ ጉዳሳቲን ኤርገ፤ እሳንስ ፍለተምቶተሳ ከኔን ሀንዳረ ሰሚወኒ ቶኮራ ሀመ እሰ ካኒት ጅረን ቡቤወን አፍረንራ ወልት ቀቡ።</char><verse eid="MAT 24:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32"/>
    <char style="wj">“ፈኬኘ ከነ ሙከ ሀርቡራ በረዻ፤ ዮሙ ደሜንሳ ለቴ ባለ ባፈቱት አከ ቦን ዽኣቴ ንቤክቱ።</char> <verse eid="MAT 24:32"/><verse number="33" style="v" sid="MAT 24:33"/><char style="wj">አከሱመ እስንስ ዮሙ ዋን ከነ ሁንደ አርግተንት አከ እን ዽኣቴ፣ አከ በልበለረስ ገኤ ንቤክቱ።</char> <verse eid="MAT 24:33"/><verse number="34" style="v" sid="MAT 24:34"/><char style="wj">አን ዹጉመ እስንትን ህመ፤ ሀመ ወን ኩን ሁንድ ተኡት ዸሎትን ኩን ህንደርቡ።</char> <verse eid="MAT 24:34"/><verse number="35" style="v" sid="MAT 24:35"/><char style="wj">ሰሚፊ ለፍት ንደርቡ፤ ዱቢንኮ ገሩ ጎንኩማ ህንደርቡ።</char><verse eid="MAT 24:35"/></para>
  <para style="s1">ጉያፊ ሰኣቲን ህንቤከሙ</para>
  <para style="r">
    <ref loc="MAT 24:37-39">24፥37‑39</ref> ኩወፈ – <char style="xt"><ref loc="LUK 17:26">ሉቃ 17፥26</ref>፣<ref loc="LUK 17:27">27</ref></char></para>
  <para style="r">
    <ref loc="MAT 24:45-51">24፥45‑51</ref> ኩወፈ – <char style="xt"><ref loc="LUK 12:42-46">ሉቃ 12፥42‑46</ref></char></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36"/>
    <char style="wj">“ዋኤ ጉያ ሰና ዮካን ዋኤ ሰኣቲ ሰና ገሩ አባ ቆፈቱ ቤከ መሌ ነምን ቶኮዩ ህንቤኩ፤ ኤርገሞትን ሰሚራዩ ህንቤከን፤ ዮካን እልምዩ ህንቤኩ።</char> <verse eid="MAT 24:36"/><verse number="37" style="v" sid="MAT 24:37"/><char style="wj">አኩመ በረ ኖህ ተኤ ሰነ ዬሮ ዹፋቲ እልመ ነማትስ አከሱመ ንተአ።</char> <verse eid="MAT 24:37"/><verse number="38" style="v" sid="MAT 24:38"/><char style="wj">በረ ብሻን በዲሳቲን ዱረ ቱሬ ሰነ፣ ሀመ ጋፈ ኖህ ዶኒ ሴኔት ነሞትን ኛቻ፣ ዹጋ፣ ፉዻ፣ ሄሩማስ ቱረኒቲ።</char> <verse eid="MAT 24:38"/><verse number="39" style="v" sid="MAT 24:39"/><char style="wj">እሳንስ ሀመ ብሻን በዲሳ ዹፌ ሁንደሳኒ ፉዸቴት ዋን ዹፉፍ ጅሩ ህንቤክኔ። ዬሮ እልም ነማ ዹፉትስ አከሱመ ተአ።</char> <verse eid="MAT 24:39"/><verse number="40" style="v" sid="MAT 24:40"/><char style="wj">ጋፈስ ነሞትን ለመ ለፈ ቆቲሳ ኬሰ ሆጄቱ፤ እን ቶኮ ንፉዸተመ፤ ካንሞ ንሀፈ።</char> <verse eid="MAT 24:40"/><verse number="41" style="v" sid="MAT 24:41"/><char style="wj">ዱበርቶትን ለመ ዸጋ ዳኩቲን ዳኩ፤ ቶኮ ንፉዸተምት፤ ካንሞ ንሀፍት።</char><verse eid="MAT 24:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42"/>
    <char style="wj">“ከናፉ እስን ደመቃ፤ ጎፍታንኬሰን ጉያ ከም አከ ዹፉ ህንቤክተኒቲ።</char> <verse eid="MAT 24:42"/><verse number="43" style="v" sid="MAT 24:43"/><char style="wj">ገሩ ዋን ከነ ሁበዻ፦ አብች መና ኡቱ ዬሮ ከምት አከ ሀቱን ዹፍቱ ቤኬ ስላ ደመቄ ኤገተ መሌ አከ መንሳ ጨብሰሜ ሴነሙ እት ህንዺሱ ቱሬ።</char> <verse eid="MAT 24:43"/><verse number="44" style="v" sid="MAT 24:44"/><char style="wj">ከናፉ እስንስ አከሱመ ቆጳኡ ቀብዱ፤ እልም ነማ ሰኣቲ እስን ህንኤግኔት ዹፋቲ።</char><verse eid="MAT 24:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45"/>
    <char style="wj">“ኤጋ ገርብች አመነማፊ ኦጌስ ከን ጎፍታንሳ አከ እን ኛተሳኒ ዬሮ መሉት እሳኒ ኬኑፍ ጄዼ ገርቦተ መነሳ ጅራተንረት ሙዱ ኤኙ?</char> <verse eid="MAT 24:45"/><verse number="46" style="v" sid="MAT 24:46"/><char style="wj">ገርብች ጎፍታንሳ ዮሙ ዴብኡት ኡቱ እን አከሱመ ሆጄቱ እሰ አርጉ ሱን ኤብፈማዸ።</char> <verse eid="MAT 24:46"/><verse number="47" style="v" sid="MAT 24:47"/><char style="wj">አን ዹጉመ እስንት ነንህመ፤ እን ቀቤኘሳ ሁንደረት እሰ ሙደ።</char> <verse eid="MAT 24:47"/><verse number="48" style="v" sid="MAT 24:48"/><char style="wj">ገርብች ሱን ገሩ ዮ ሀማ ተኤ፣ ‘ጎፍታንኮ ዬሮ ዼራ ቱረ’ ኦፊን ጄዼ</char> <verse eid="MAT 24:48"/><verse number="49" style="v" sid="MAT 24:49"/><char style="wj">ገርቦተ እሰ ወጅን ተጃጅለን ቱሙ፣ መቾፍቶተ ወጅንሞ ኛቹፊ ዹጉ ጀልቀበ።</char> <verse eid="MAT 24:49"/><verse number="50" style="v" sid="MAT 24:50"/><char style="wj">ጎፍታን ገርብቸ ሰና ጉያ እን እሰ ህንኤግኔፊ ሰኣቲ እን ህንቤክኔት ንዹፈ።</char> <verse eid="MAT 24:50"/><verse number="51" style="v" sid="MAT 24:51"/><char style="wj">እንስ እሰ ኩኩተ፤ ፈኬስቶተ ኬሰትስ እሰ ረመደ፤ አችትስ ቦእቻፊ እልካን ቀሩቱ ተአ።”</char><verse eid="MAT 24:51"/></para>
  <chapter eid="MAT 24"/>
  <chapter number="25" style="c" sid="MAT 25"/>
  <para style="s1">ፈኬኘ ዱበረን ኩርነኒ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1"/>
    <char style="wj">“ዬሮ ሰነት ሞቱማን ሰሚ ዱበረን ኩዸን ከኔን እብሳሳኒ ፉዸተኒ ምስርቸ ስመቹዻፍ ገድ በአን ፈካተ።</char> <verse eid="MAT 25:1"/><verse number="2" style="v" sid="MAT 25:2"/><char style="wj">እሳን ኬሳስ ሸን ጎዎተ፣ ሸንሞ ኦጌዪ ቱረን።</char> <verse eid="MAT 25:2"/><verse number="3" style="v" sid="MAT 25:3"/><char style="wj">ወር ጎዎትን እብሳሳኒ ፉዸተን መሌ ዘይቲ ህንፉዸትኔ።</char> <verse eid="MAT 25:3"/><verse number="4" style="v" sid="MAT 25:4"/><char style="wj">ወር ኦጌዪን ገሩ እብሳሳኒ ወጅን ዘይቲ ቆዳት ቀበተኒ ቱረን።</char> <verse eid="MAT 25:4"/><verse number="5" style="v" sid="MAT 25:5"/><char style="wj">ምስርች ሱን ቱራን ሁንዱምትሳኒ ሙገን፤ ንረፈንስ።</char><verse eid="MAT 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6"/>
    <char style="wj">“ሀልከን ወለካትስ ሰገሌን ጉዳን፣ ‘ኩኖ፣ ምስርች ዹፌረ! በኣቲ እሰ ስመዻ!’ ጄዹ ቶኮ ዸገአሜ።</char><verse eid="MAT 25:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7"/>
    <char style="wj">“ዱበር ሱን ሁንድኑስ ከአኒ እብሳሳኒ ቆጴፈተን።</char> <verse eid="MAT 25:7"/><verse number="8" style="v" sid="MAT 25:8"/><char style="wj">ወር ጎዎትን ሱን ወረ ኦጌዪዻን፣ ‘እብሳንኬኘ ኑ ዱራ ዻሙት ጅራቲ ዘይቲኬሰንራ ጥኖ ኑ ኬና’ ጄዸን።</char><verse eid="MAT 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9"/>
    <char style="wj">“ወር ኦጌዪንስ ዴብሰኒ፣ ‘ህንኬንኑ፤ ተሪ ወን ኑፊ እስን ገኡ ህንጅሩ ተኣቲ። ቆደ ከና ወረ ጉርጉረን ብረ ዸቃቲ ኦፊኬሰኒፍ ብተዻ’ ጄዸኒን።</char><verse eid="MAT 25:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 25:10"/>
    <char style="wj">“ገሩ ኡቱመ እሳን ዘይቲ ብተቹ ዸቁት ጅረኑ ምስርች ዹፌ። ዱበር ቆጳአንስ እሰ ወጅን ገልመ ጭዸ ፉዻት ኦል ገለን። በልበልስ ንጩፈሜ።</char><verse eid="MAT 25:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11"/>
    <char style="wj">“ኤርገሲ ዱበረን ካንስ ዹፈኒ፣ ‘ያ ጎፍታ፣ ያ ጎፍታ፣ በልበለ ኑፍ በን!’ ጄዸኒን።</char><verse eid="MAT 25:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12"/>
    <char style="wj">“እን ገሩ ዴብሴ፣ ‘ዹጉመን እስንት ህመ፤ አን እስን ህንቤኩ’ ጄዼን።</char><verse eid="MAT 25:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13"/>
    <char style="wj">“ከናፉ እስን ሰበቢ ጉያ ሰነ ዮካን ሰኣቲ ሰነ ህንቤክኔፍ ደመቃ።</char><verse eid="MAT 25:13"/></para>
  <para style="s1">ፈኬኘ ታላንቲ</para>
  <para style="r">
    <ref loc="MAT 25:14-30">25፥14‑30</ref> ኩወእ – <char style="xt"><ref loc="LUK 19:12-27">ሉቃ 19፥12‑27</ref></char></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14"/>
    <char style="wj">“አመስ ሞቱማን ሰሚ ነመ ብየ ፈጎ ዸቁ ቶኮ ፈካተ፤ ነምችስ ገርቦተሳ ዋሜ ቀቤኘሳ እማና እት ኬነቴ።</char> <verse eid="MAT 25:14"/><verse number="15" style="v" sid="MAT 25:15"/><char style="wj">ቶኮ ቶኮሳኒትስ አኩመ ደንዴቲሳኒት፣ እሰ ቶኮት ታላንቲ ሸን፣ እሰ ካንት ታላንቲ ለመ፣ እሰ ካንትሞ ታላንቲ ቶኮ ኬኔ ከኤ ዴሜ።</char> <verse eid="MAT 25:15"/><verse number="16" style="v" sid="MAT 25:16"/><char style="wj">ነምች ታላንቲ ሸን ፉዸቴ ሱን፣ ዬሮዹመ ሰነ ዸቄ እቲን ደልደሌ ታላንቲ ብራ ሸን እራ ቡፈቴ።</char> <verse eid="MAT 25:16"/><verse number="17" style="v" sid="MAT 25:17"/><char style="wj">እን ታላንቲ ለመ ፉዸቴስ አከሱመ ታላንቲ ብራ ለመ እራ ቡፈቴ።</char> <verse eid="MAT 25:17"/><verse number="18" style="v" sid="MAT 25:18"/><char style="wj">ነምች ታላንቲ ቶኮ ፉዸቴ ገሩ ዸቄ ለፈ ቆቴ ማለቀ ጎፍታሳ ዾክሴ።</char><verse eid="MAT 25:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19"/>
    <char style="wj">“ዬሮ ዼራ ቦዴ ጎፍታን ገርቦተ ሰና ዴብኤ ሄሬገ እሳን ብረ ጅሩ ሄሬገቴ።</char> <verse eid="MAT 25:19"/><verse number="20" style="v" sid="MAT 25:20"/><char style="wj">ነምች ታላንቲ ሸን ፉዸቴ ቱሬ ሱን ታላንቲ ብራ ሸን ፍዴ፣ ‘ያ ጎፍታ፣ አት ታላንቲ ሸን እማና ነት ኬንቴ ቱርቴ። አንሞ ኩኖ፣ ታላንቲ ሸን እራ ቡፈዼረ’ ጄዼን።</char><verse eid="MAT 25:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 25:21"/>
    <char style="wj">“ጎፍታንሳስ ዴብሴ፣ ‘ያ ገርብቸ ጋሪፊ አመነማ፣ ዋን ጋሪ ሆጄቴ! አት ዋን አከ መሌ ጥኖረት አመነማ ታቴርተ፤ አንሞ ዋን ባይኤረት ስን ሙደ። ኮቱቲ ገመቹ ጎፍታኬቲት ገል!’ ጄዼን።</char><verse eid="MAT 25:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22"/>
    <char style="wj">“ነምች ታላንቲ ለመ ፉዸቴ ቱሬስ ዹፌ፣ ‘ያ ጎፍታ፣ አት ታላንቲ ለመ እማና ነት ኬንቴ ቱርቴ፤ አንሞ ኩኖ፣ ታላንቲ ብራ ለመ እራ ቡፈዼረ’ ጄዼን።</char><verse eid="MAT 25:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 25:23"/>
    <char style="wj">“ጎፍታንሳስ ዴብሴ፣ ‘ያ ገርብቸ ጋሪፊ አመነማ፣ ዋን ጋሪ ሆጄቴ! አት ዋን ጥኖረት አመነማ ታቴርተ፤ አንሞ ዋን ባይኤረት ስን ሙደ። ኮቱቲ ገመቹ ጎፍታኬቲት ገል!’ ጄዼን።</char><verse eid="MAT 25:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24"/>
    <char style="wj">“ነምች ታላንቲ ቶክቸ ፉዸቴ ቱሬስ ዹፌ አከነ ጄዼ፤ ‘ያ ጎፍታ፣ አት ነመ ገረ ጀቤሰ እዶ እት ህንፈጫስኒ ገልፈቱ፣ እዶ እት ህንብትኔስኒስ ወልት ቀበቱ አከ ታቴ ነንቤከ።</char> <verse eid="MAT 25:24"/><verse number="25" style="v" sid="MAT 25:25"/><char style="wj">ከናፉ አን ሶዳዼ ዸቄን ታላንቲኬ ለፈ ኬሰ ዾክሴ። ታላንቲንኬ ኩኖት።’</char><verse eid="MAT 25:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26"/>
    <char style="wj">“ጎፍታንሳስ ዴብሴ አከነ ጄዼ፤ ‘ያ ገርብቸ ሀማ ዽባኣ! አት አከ አን እዶን እት ህንፈጫስኒ ገልፈዹ፣ እዶን እት ህንብትኔስኒስ ወልት ቀበዹ ቤክታ?</char> <verse eid="MAT 25:26"/><verse number="27" style="v" sid="MAT 25:27"/><char style="wj">ዮስ አከ አን ዮሙን ዴብኡት ዸለሳ ወጅን ፉዸዹፍ ስላ ማለቀኮ ወረ ባንኪ ብረ ናፍ ካኡ ቀብደ ቱሬ።</char><verse eid="MAT 25:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 25:28"/>
    <char style="wj">“ ‘ከናፍ ታላንትቸ እሰ ሀርካ ፉዻቲ ነምቸ ታላንቲ ኩዸን ቀቡፍ ኬና።</char> <verse eid="MAT 25:28"/><verse number="29" style="v" sid="MAT 25:29"/><char style="wj">ከን ቀቡ ከሚፍዩ እት ደበለሜ ንኬነመ፤ እራ ሀፋስ ንቀባታቲ። ከን ህንቀብኔ ገሩ ወን እን ቀቡዩ እራ ፉዸተመ።</char> <verse eid="MAT 25:29"/><verse number="30" style="v" sid="MAT 25:30"/><char style="wj">ገርብቸ ፋይዳ ህንቀብኔ ከነ ዱከነ አላት ገድ ደርበዻ፤ አችትስ ቦእቻፊ እልካን ቀሩቱ ተአ።’</char><verse eid="MAT 25:30"/></para>
  <para style="s1">ሆሎታፊ ሬኦተ</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31"/>
    <char style="wj">“እልም ነማ ዮሙ ኡልፍነሳቲን ኤርገሞተ ዋቃ ሁንደ ወጅን ዹፉት፣ ቴሶሳ ከን ኡልፍናረ ንታአ።</char> <verse eid="MAT 25:31"/><verse number="32" style="v" sid="MAT 25:32"/><char style="wj">ሰቦትን ሁንድኑ ፉለሳ ዱረት ወልት ቀበሙ፤ እንስ አኩመ ትክሴን ቶኮ ሆሎታፊ ሬኦተ ገርገር ፎቱ ሰነ ነሞተ ገርገር ንፎአ።</char> <verse eid="MAT 25:32"/><verse number="33" style="v" sid="MAT 25:33"/><char style="wj">እን ሆሎተ ከራ ምርገሳ፣ ሬኦተሞ ከራ ብታሳ ንዻበቺሰ።</char><verse eid="MAT 25:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34"/>
    <char style="wj">“ዬሮ ሰነ ሞትች ወረ ምርገሳ ጅረኒን አከነ ጄዸ፤ ‘እስን ወር አባንኮ ኤብሴ ኮታ ሞቱምቸ ኡመሙ አዱኛቲ ጀልቀቤ እስኒ ቆጴፈሜ ሰነ ዻላ።</char> <verse eid="MAT 25:34"/><verse number="35" style="v" sid="MAT 25:35"/><char style="wj">ሰበቢንሳስ አን ቤሎፍናን እስን ኛተ ናፍ ኬንተን፤ ዼቦትናን ዋን አን ዹጉ ናፍ ኬንተን፤ አን ኬሱማን ቱሬ፤ እስንሞ ነ ስመተን፤</char> <verse eid="MAT 25:35"/><verse number="36" style="v" sid="MAT 25:36"/><char style="wj">አን ዳራን ዳረ ነ ባፍተን፤ ዹኩብሰትናን ነ ጋፈተን፤ ህዸምናን ዹፍተኒ ነ እላልተን።’</char><verse eid="MAT 25:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37"/>
    <char style="wj">“ቀጄልቶትን ሱንስ ዴብሰኒ አከነ ጄዸኒን፤ ‘ያ ጎፍታ፣ ዮም ቤሎፍቴ ስ አርግኔ ዋን አት ኛቱ ሲፍ ኬንኔ? ዮካን ዮም ዼቦቴ ስ አርግኔ ዋን አት ዹግዱ ሲፍ ኬንኔ?</char> <verse eid="MAT 25:37"/><verse number="38" style="v" sid="MAT 25:38"/><char style="wj">ዮም ኬሱማ ተኡኬ አርግኔ ስ ስመትኔ? ዮካን ዮም ዳርቴ ስ አርግኔ ዳረ ስ ባፍኔ?</char> <verse eid="MAT 25:38"/><verse number="39" style="v" sid="MAT 25:39"/><char style="wj">ዮም ዹኩብሰቴ ዮካን ህዸምቴ ስ አርግኔ ዹፍኔ ስ እላሌ?’</char><verse eid="MAT 25:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 25:40"/>
    <char style="wj">“ሞቲን ሱንስ ዴብሴ፣ ‘አን ዹጉመን እስንት ህመ፤ ዋን ኦቦሎተኮ ወረ ነመ ሁንዱማ ገድ ተአን ከኔን ኬሳ እሰ ቶኮፍ ጎተን ከምዩ ናፍ ጎተን’ ጄዻን።</char><verse eid="MAT 25:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41"/>
    <char style="wj">“ኤርገሲስ ወረ ብታሳ ጅረኒን አከነ ጄዸ፤ ‘እስን ያ አባረሞ፣ ነ ዱራ በዳቲ እብደ በረ በራ እሰ ዲያብሎሲፊ ኤርገሞተሳቲፍ ቆጴፈሜት ገላ።</char> <verse eid="MAT 25:41"/><verse number="42" style="v" sid="MAT 25:42"/><char style="wj">አን ቤሎፍናን እስን ዋን አን ኛዹ ናፍ ህንኬንኔቲ፤ አን ዼቦትናን ዋን አን ዹጉ ናፍ ህንኬንኔቲ፤</char> <verse eid="MAT 25:42"/><verse number="43" style="v" sid="MAT 25:43"/><char style="wj">አን ኬሱማን ቱሬ፤ እስን ነ ህንስመትኔ፤ አን ዳራን እስን ዳረ ነ ህንባፍኔ፤ ዹኩብሰትናን ዮካን ህዸምናን ዹፍተኒ ነ ህንእላሌ።’</char><verse eid="MAT 25:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44"/>
    <char style="wj">“እሳንስ፣ ‘ያ ጎፍታ፣ አት ዮም ቤሎፍቴ ዮካን ዼቦቴ ዮካን ኬሱማ ታቴ ዮካን ዳርቴ ዮካን ዹኩብሰቴ ዮካን ህዸምቴ ስ አርግኔ ስ ገርጋሩ ድድኔ?’ ጄዸኒ ዴብሱ።</char><verse eid="MAT 25:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45"/>
    <char style="wj">“እንስ ዴብሴ፣ ‘አን ዹጉመን እስንት ህመ፤ ዋን ኦቦሎተኮ ወረ ነመ ሁንዳ ገድ ተአን ከኔን ኬሳ እሰ ቶኮፍ ህንጎዽን ናፍስ ህንጎኔ’ ጄዸ።</char><verse eid="MAT 25:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 25:46"/>
    <char style="wj">“እሳን ኩኔን አደቢ በረ በራት፣ ቀጄልቶትንሞ ጅሬኘ በረ በራት ገሉ።”</char><verse eid="MAT 25:46"/></para>
  <chapter eid="MAT 25"/>
  <chapter number="26" style="c" sid="MAT 26"/>
  <para style="s1">መሪ ዬሱስት መርአተሜ</para>
  <para style="r">
    <ref loc="MAT 26:2-5">26፥2‑5</ref> ኩወፈ – <char style="xt"><ref loc="MRK 14:1">ማር 14፥1</ref>፣<ref loc="MRK 14:2">2</ref>፤ <ref loc="LUK 22:1">ሉቃ 22፥1</ref>፣<ref loc="LUK 22:2">2</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1"/>ዬሱስ ኤርገ ዋን ከነ ሁንደ ዱበቴ ራወቴ ቦዴ በረቶተሳቲን አከነ ጄዼ፤ <verse eid="MAT 26:1"/><verse number="2" style="v" sid="MAT 26:2"/><char style="wj">“አኩመ እስን ቤክተን ፋሲካፍ ጉያ ለመቱ ሀፈ፤ እልም ነማስ ፈንፈሙፍ ደበርፈሜ ንኬነመ።”</char><verse eid="MAT 26:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3"/>ኤርገሲ ሉቦትን ሀንገፎትኒፊ ማንጉዶትን ኡመታ ደላ ሉበ ኦል ኣና እሰ ቀያፋ ጄዸሙ ኬሰት ወልት ቀበመን። <verse eid="MAT 26:3"/><verse number="4" style="v" sid="MAT 26:4"/>እሳንስ ሀጡማዻን ዬሱስን ቀቡፊ አጄሱፍ መርአተን። <verse eid="MAT 26:4"/><verse number="5" style="v" sid="MAT 26:5"/>እሳንስ፣ “ገሩ አከ ነሞተ ግዱት ጎሊን ህንካኔፍ ዬሮ አያናት ህንተእን” ጄዸን።<verse eid="MAT 26:5"/></para>
  <para style="s1">ዬሱስ ቢታንያት ሽቶ ድበሙሳ</para>
  <para style="r">
    <ref loc="MAT 26:6-13">26፥6‑13</ref> ኩወፈ – <char style="xt"><ref loc="MRK 14:3-9">ማር 14፥3‑9</ref></char></para>
  <para style="r">
    <ref loc="MAT 26:6-13">26፥6‑13</ref> ኩወእ – <char style="xt"><ref loc="LUK 7:37">ሉቃ 7፥37</ref>፣<ref loc="LUK 7:38">38</ref>፤ <ref loc="JHN 12:1-8">ዮሀ 12፥1‑8</ref></char></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6"/>ኡቱ ዬሱስ ቢታንያ ኬሰ መነ ስሞን እሰ ለምጣኣ ሰና ጅሩ፣ <verse eid="MAT 26:6"/><verse number="7" style="v" sid="MAT 26:7"/>ዱበርቲን ቶኮ ሽቶ ገቲንሳ አከ መሌ ጉዳ ተኤ ብልቃጢ አልባስጥሮስት ቀበቴ ገረሳ ዹፍቴ፤ አኩመ እን ማዲት ዽኣቴንስ ሽቶ ሰነ መታሳት ዸንገላፍቴ።<verse eid="MAT 26:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 26:8"/>በረቶትንስ ዮሙ ዋን ከነ አርገንት ኣረኒ አከነ ጄዸን፤ “ዋን ከነ በሌሱን ማሊፍ? <verse eid="MAT 26:8"/><verse number="9" style="v" sid="MAT 26:9"/>ስላ ሽቶን ኩን ገቲ ጉዳት ጉርጉረሜ ማለቀሳ ህዬዪፍ ኬኑን ንደንደአመ ቱሬቲ።”<verse eid="MAT 26:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10"/>ዬሱስስ ከነ ሁበቴ አከነ እሳኒን ጄዼ፤ <char style="wj">“እስን ማሊፍ ዱበርቲ ከነ ረክፍቱ? እሼን ዋን ጋሪ ናፍ ጎቴርት።</char> <verse eid="MAT 26:10"/><verse number="11" style="v" sid="MAT 26:11"/><char style="wj">ህዬዪ ዬሮ ሁንደ ኦፍ ብራ ቀብዱ፤ አነ ገሩ ዬሮ ሁንደ ኦፍ ብራ ህንቀብደን።</char> <verse eid="MAT 26:11"/><verse number="12" style="v" sid="MAT 26:12"/><char style="wj">ዱበርቲን ኩን ዮሙ ሽቶ ከነ ዸግነኮረት ዸንገላፍቴት አዋላፍ ነ ቆጴሱዻፍ ዋን ከነ ጎቴ።</char> <verse eid="MAT 26:12"/><verse number="13" style="v" sid="MAT 26:13"/><char style="wj">አን ዹጉመ እስንትን ህመ፤ አዱኛ ሁንደረት፣ እዶ ወንጌል ኩን እት ለለበሙ ከምትዩ ወን እሼን ጎቴስ ያደኖሼቲፍ ንኦዴፈመ።”</char><verse eid="MAT 26:13"/></para>
  <para style="s1">ይሁዳን ዬሱስን ደበርሴ ኬኑፍ ወሊ ገሉሳ</para>
  <para style="r">
    <ref loc="MAT 26:14-16">26፥14‑16</ref> ኩወፈ – <char style="xt"><ref loc="MRK 14:10">ማር 14፥10</ref>፣<ref loc="MRK 14:11">11</ref>፤ <ref loc="LUK 22:3-6">ሉቃ 22፥3‑6</ref></char></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14"/>ኤርገሲስ ወረ ኩዸ ለማን ኬሳ ነምች ይሁዳ አስቆሮቲ ጄዸሙ ቶኮ ገረ ሉቦተ ሀንገፎታ ዸቄ፣ <verse eid="MAT 26:14"/><verse number="15" style="v" sid="MAT 26:15"/>“ዮ አን እሰ ደበርሴ እስንት ኬኔ እስን ማል ናፍ ኬንቱ?” ጄዼ ጋፈቴ። እሳንስ ሜቲ ሶዶማን ወሊ ገለን። <verse eid="MAT 26:15"/><verse number="16" style="v" sid="MAT 26:16"/>ይሁዳንስ ዬሮ ሰና ጀልቀቤ ዬሱስን ደበርሴ ኬኑፍ ሃለ ምጃኣ ኤገቻ ቱሬ።<verse eid="MAT 26:16"/></para>
  <para style="s1">እርባተ ጎፍታ</para>
  <para style="r">
    <ref loc="MAT 26:17-19">26፥17‑19</ref> ኩወፈ – <char style="xt"><ref loc="MRK 14:12-16">ማር 14፥12‑16</ref>፤ <ref loc="LUK 22:7-13">ሉቃ 22፥7‑13</ref></char></para>
  <para style="r">
    <ref loc="MAT 26:20-24">26፥20‑24</ref> ኩወፈ – <char style="xt"><ref loc="MRK 14:17-21">ማር 14፥17‑21</ref></char></para>
  <para style="r">
    <ref loc="MAT 26:26-29">26፥26‑29</ref> ኩወፈ – <char style="xt"><ref loc="MRK 14:22-25">ማር 14፥22‑25</ref>፤ <ref loc="LUK 22:17-20">ሉቃ 22፥17‑20</ref>፤ <ref loc="1CO 11:23-25">1ቆሮ 11፥23‑25</ref></char></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17"/>ጉያ ጀልቀበ አያነ መጥኖት በረቶትን ገረ ዬሱስ ዹፈኒ፣ “አከ አት ፋሲካ ኛቱፍ ኤሰት አከ ሲፍ ቆጴስኑ በርባደ?” ጄዸኒ ጋፈተን።<verse eid="MAT 26:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18"/>እንስ ዴብሴ አከነ ጄዼ፤ <char style="wj">“መጋላ ሴናቲ ነመ ወዪቲን፣ ‘በርሲሳን፣ ዬሮንኮ ገኤረ፤ አን በረቶተኮ ወጅን አያነ ፋሲካ መነኬት ነንከበጀ ሲን ጄዸ’ ጄዻ።”</char> <verse eid="MAT 26:18"/><verse number="19" style="v" sid="MAT 26:19"/>በረቶትንስ አኩመ ዬሱስ እሳን አጀጄ ሰነ ጎዸን፤ ፋሲካስ ንቆጴሰን።<verse eid="MAT 26:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20"/>ዬሱስስ ዮሙ ገልገላኤት ወረ ኩዸ ለማን ወጅን ማዲት ዽኣቴ። <verse eid="MAT 26:20"/><verse number="21" style="v" sid="MAT 26:21"/>እንስ ኡቱመ ኛቻ ጅረኑ፣ <char style="wj">“አን ዹጉመ እስንት ነንህመ፤ እስን ኬሳ ቶኮ ደበርሴ ነ ኬነ”</char> ጄዼ።<verse eid="MAT 26:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22"/>እሳንስ አከ መሌ ገደኒ ቶኮ ቶኮን፣ “ያ ጎፍታ፣ ነ ተእና ላተ?” ጄዸኒ ጋፈቹ ጀልቀበን።<verse eid="MAT 26:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23"/>ዬሱስስ አከነ ጄዼ ዴብሴ፤ <char style="wj">“ነምች ነ ወጅን ገበቴ ኬሰ ሀርከ ካኤ ጩጰቴ ደበርሴ ነ ኬነ።</char> <verse eid="MAT 26:23"/><verse number="24" style="v" sid="MAT 26:24"/><char style="wj">እልም ነማ አኩመ ዋኤንሳ በሬፈሜ ሰነት ንዴመ። ገሩ ነምቸ ደበርሴ እልመ ነማ ኬኑ ሰናፍ ወዮ! እን ኡቱ ዸለቹ ባቴ እሳፍ ወየ ቱሬ።”</char><verse eid="MAT 26:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25"/>ይሁዳን እን ደበርሴ እሰ ኬኑፍ ጅሩ ሱንስ፣ “ያ በርሲሳ፣ ነ ተእና ላተ?” ጄዼ።</para>
  <para style="p" vid="MAT 26:25">ዬሱስስ፣ <char style="wj">“አቱ ጄቴካ!”</char> ጄዼ ዴብሴ።<verse eid="MAT 26:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26"/>ኡቱ ኛቻ ጅረኑስ ዬሱስ ቡዴነ ፉዼ ኤብሴ፤ ጨጨብሴስ፣ <char style="wj">“ፉዸዻቲ ኛዻ፤ ኩን ፎንኮት”</char> ጄዼ በረቶተሳቲፍ ኬኔ።<verse eid="MAT 26:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27"/>ጦፎስ ፉዼ ገለተ ገልቼ እሳኒፍ ኬኔ፤ አከነስ ጄዼ፤ <char style="wj">“ሁንድኬሰን ከነራ ዹጋ።</char> <verse eid="MAT 26:27"/><verse number="28" style="v" sid="MAT 26:28"/><char style="wj">ኩን ዺገኮ፣ ዺገ ከኩ ሃራ ከን ዺፈመ ጩቡ ነሞተ ባይኤቲፍ ዸንገላፈሙዸ።</char> <verse eid="MAT 26:28"/><verse number="29" style="v" sid="MAT 26:29"/><char style="wj">አን እስንት ነንህመ፤ አን ሀመን ጉያ እስን ወጅን ሞቱማ አባኮ ኬሰት ዴብኤ ዹጉት አማ ጀልቀቤ እጀ ወይኒ ከነራ ህንዹጉ።”</char><verse eid="MAT 26:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30"/>እሳንስ ኤርገ ፋርፈትና ፋርፈተኒ ቦዴ ቱሉ ኤጄርሳት ቀጄለን።<verse eid="MAT 26:30"/></para>
  <para style="s1">ዬሱስ አከ ጴጥሮስ እሰ ገኑ ዱራን ዱርሴ ዱበቴ</para>
  <para style="r">
    <ref loc="MAT 26:31-35">26፥31‑35</ref> ኩወፈ – <char style="xt"><ref loc="MRK 14:27-31">ማር 14፥27‑31</ref>፤ <ref loc="LUK 22:31-34">ሉቃ 22፥31‑34</ref></char></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31"/>ኤርገሲ ዬሱስ አከነ እሳኒን ጄዼ፤ <char style="wj">“ሁንድኬሰን ኤደነ ሰበቢኮቲፍ ንጉፈቱ፤ አከነ ጄዸሜ በሬፈሜራቲ፦</char></para>
  <para style="q1" vid="MAT 26:31">
    <char style="wj">“ ‘አን ትክሴ ነንሩኩተ፤</char></para>
  <para style="q2" vid="MAT 26:31">
    <char style="wj">ሆሎትን ከረ ሰናስ ንብትኔፈሙ።’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">26፥31 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="ZEC 13:7">ዘካ 13፥7</ref>
        </char>
      </char>
    </note><verse eid="MAT 26:31"/></para>
  <para style="m">
    <verse number="32" style="v" sid="MAT 26:32"/>
    <char style="wj">አን ገሩ ኤርገን ዱኣ ከኤ ቦዴ እስን ዱረ ገሊላ ነንዸቀ።”</char><verse eid="MAT 26:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33"/>ጴጥሮስሞ ዴብሴ፣ “ዮ ነምን ሁንድኑ ሰበቢኬቲፍ ጉፈቴዩ አን ጎንኩማ ህንጉፈዹ” ጄዼን።<verse eid="MAT 26:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34"/>ዬሱስሞ ዴብሴ፣ <char style="wj">“አን ዹጉመ ስት ነንህመ፤ አት ኤደነ ኡቱ እንዳንቆን ህንእይን ዬሮ ሰዲ ነ ገንተ”</char> ጄዼን።<verse eid="MAT 26:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35"/>ጴጥሮስ ገሩ፣ “አን ዮን ስ ወጅን ዱኡ ቀባዼሌ ጎንኩማ ስ ህንገኑ” ጄዼን። በረቶትን ሁንድኑስ አከሱመ ጄዸን።<verse eid="MAT 26:35"/></para>
  <para style="s1">ጌቴሴማኒ</para>
  <para style="r">
    <ref loc="MAT 26:36-46">26፥36‑46</ref> ኩወፈ – <char style="xt"><ref loc="MRK 14:32-42">ማር 14፥32‑42</ref>፤ <ref loc="LUK 22:40-46">ሉቃ 22፥40‑46</ref></char></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36"/>ኤርገሲስ ዬሱስ በረቶተሳ ወጅን እዶ ጌቴሴማኒ ጄዸሙ ቶኮ ዸቄ፤ እንስ፣ <char style="wj">“ሀመ አን አች ዸቄ ከዸዹት እስን አስ ታኣ”</char> ጄዼን። <verse eid="MAT 26:36"/><verse number="37" style="v" sid="MAT 26:37"/>እንስ ጴጥሮሲፊ እልማን ዘብዴዎስ ለማን ኦፍ ፋነ ፉዸቴ ዴሜ፤ ገዱፊ ያደኡስ ጀልቀቤ። <verse eid="MAT 26:37"/><verse number="38" style="v" sid="MAT 26:38"/>ኤርገሲስ እን፣ <char style="wj">“ሉቡንኮ አከ መሌ ገድቴ ዱኡ ጌሴርት። እስን አሱመ ቱራቲ ነ ወጅን ደመቃ”</char> ጄዼን።<verse eid="MAT 26:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39"/>እንስ ጥኖ አች ሂቄ አደሳቲን ለፈት ጎምብፈሜ፣ <char style="wj">“ያ አባኮ፣ ዮ ደንደአሜ ጦፎን ኩን ነረ ሃደርቡ። ገሩ አከ ፌዺኬቲ መሌ አከ ፌዺኮቲ ህንተእን”</char> ጄዼ ከዸቴ።<verse eid="MAT 26:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40"/>እንስ ገረ በረቶተሳት ዴብኤ ኡቱ ረፈኑ እሳን አርጌ። ጴጥሮሲንስ አከነ ጄዼ፤ <char style="wj">“ጀረነ፣ እስን ሰኣቲ ቶክትሌ ደመቅጠኒ ነ ወጅን ቱሩ ህንደንዴኜ?</char> <verse eid="MAT 26:40"/><verse number="41" style="v" sid="MAT 26:41"/><char style="wj">እስን አከ ቆሩምሰት ህንገሌፍ ደመቃ ከዸዻ። ሀፉር ቆጳኣዸ፤ ፎን ገሩ ደዸባዸ።”</char><verse eid="MAT 26:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42"/>አመስ ዬሮ ለመፋ አች ሂቄ፣ <char style="wj">“ያ አባኮ፣ ጦፎን ኩን ኡቱ አን ህንዹግን ዮ ነረ ደርቡ ህንደንዴኜ አኩመ ፌዺኬቲ ሃተኡ”</char> ጄዼ ከዸቴ።<verse eid="MAT 26:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 26:43"/>እን ዮሙ ዴብኤ ዹፌት፣ አመስ ኡቱ ረፈኑ እሳን አርጌ፤ እጅሳኒ እት ኡልፋቴ ቱሬቲ። <verse eid="MAT 26:43"/><verse number="44" style="v" sid="MAT 26:44"/>አመስ እሳን ዺሴ አች ሂቄ ወኑመ ከናን ዱረ ከዸቴ ሰነረ ዴብኤ ዬሮ ሰደፋ ከዸቴ።<verse eid="MAT 26:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 26:45"/>እንስ ገረ በረቶታት ዴብኤ አከነ ጄዼን፤ <char style="wj">“እስን አመዩ ረፍተኒ ቦቆቻ ጅርቱ? ኩኖ፣ ሰኣቲን ሱን ገኤረ፤ እልም ነማስ ደበርፈሜ ሀርከ ጩበሞታት ንኬነመ።</char> <verse eid="MAT 26:45"/><verse number="46" style="v" sid="MAT 26:46"/><char style="wj">ከኣ ንዴምና! ኩኖ፣ ነምች ደበርሴ ነ ኬኑ ሱን ዹፋ ጅረ።”</char><verse eid="MAT 26:46"/></para>
  <para style="s1">ዬሱስ ቀበሙሳ</para>
  <para style="r">
    <ref loc="MAT 26:47-56">26፥47‑56</ref> ኩወፈ – <char style="xt"><ref loc="MRK 14:43-50">ማር 14፥43‑50</ref>፤ <ref loc="LUK 22:47-53">ሉቃ 22፥47‑53</ref></char></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47"/>ኡቱመ እን አመዩ ዱበቻ ጅሩ፣ ይሁዳን ነምች ወረ ኩዸ ለማን ኬሳ ቶኮ ተኤ ሱን ዹፌ። ቱትን ሉቦተ ሀንገፎታፊ ማንጉዶተ ኡመታ ብራ ኤርገሜ ጉዳንስ ጎራዴፊ ቦኩ ቀበቴ እሰ ወጅን ዹፌ። <verse eid="MAT 26:47"/><verse number="48" style="v" sid="MAT 26:48"/>እን ደበርሴ ዬሱስን ኬኑ ሱንስ፣ “ነምች አን ዹንገዹ እሰ፤ እስንስ እሰ ቀባ” ጄዼ መለቶ ኬኔፊ ቱሬ። <verse eid="MAT 26:48"/><verse number="49" style="v" sid="MAT 26:49"/>ይሁዳንስ ዮሙሱመ ዬሱስት ዽኣቴ፣ “ነጉማ ያ በርሲሳ!” ጄዼ እሰ ዹንገቴ።<verse eid="MAT 26:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50"/>ዬሱስስ ዴብሴ፣ <char style="wj">“ያ ምቹኮ፣ ዋን ዹፍቴፍ ሰነ ራወዹ ካ!”</char> ጄዼ።</para>
  <para style="p" vid="MAT 26:50">ነሞትን ሱን እት ዽኣተኒ ዬሱስን ቀበኒ ህዸን። <verse eid="MAT 26:50"/><verse number="51" style="v" sid="MAT 26:51"/>ኩኖ፣ ወረ ዬሱስ ወጅን ቱረን ኬሳ እን ቶኮ ጎራዴሳ ሉቅፈቴ ገርብቸ ሉበ ኦል ኣና ዸኤ ጉረሳራ ኩቴ።<verse eid="MAT 26:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 26:52"/>ዬሱስሞ አከነ ጄዼን፤ <char style="wj">“ጎራዴኬ እዶሳት ዴብስ፤ ወር ጎራዴ ሉቅፈተን ሁንድኑ ጎራዴዻን በሌፈሙቲ።</char> <verse eid="MAT 26:52"/><verse number="53" style="v" sid="MAT 26:53"/><char style="wj">አት ዋን አን አባኮት እየቹ ህንደንዴኜ፣ ዋን እንስ ዬሩመ ሰነ ኤርገሞተ ዋቃ ሌጌዎኒ</char><note caller="+" style="f"><char style="fr" closed="false">26፥53 </char><char style="fq" closed="false">ሌጌዎኒ </char><char style="ft" closed="false">– ሌጌዎኒን ሮማ ቶክች ሎልቶተ 6,000 ቀበተ።</char></note> <char style="wj">ኩዸ ለማ ኦሊ ናፍ ህንኤርግኔ ሴታ?</char> <verse eid="MAT 26:53"/><verse number="54" style="v" sid="MAT 26:54"/><char style="wj">ኡቱ አከስ ተኤሞ ወን ከተቢወን ቁልቁሉን ከራ ከናን ተኡ ቀበ ጄዸን ሱን ስላ አከምት ራወተመሬ?”</char><verse eid="MAT 26:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55"/>ሰኣቲ ሰነት ዬሱስ ቱተ ሰናን አከነ ጄዼ፤ <char style="wj">“እስን ጎራዴፊ ቦኩ ቀበተኒ አከ ነመ ሀቱ ቀቡት ነ ቀቡ ዹፍተኒ? አን ጉዩመ ጉያን መነ ቁልቁሉማ ኬሰ ታኤ በርሲሳን ቱሬ፤ እስንስ ነ ህንቀብኔ።</char> <verse eid="MAT 26:55"/><verse number="56" style="v" sid="MAT 26:56"/><char style="wj">ኩን ሁንድኑ ገሩ አከ ከተቢወን ራጆታ ቁልቁሉን ራወተመኒፍ ተኤ።”</char> በረቶትን ሁንድኑስ እሰ ዺሰኒ በቀተን።<verse eid="MAT 26:56"/></para>
  <para style="s1">ዬሱስ ያኢ ይሁዶታ ዱረት</para>
  <para style="r">
    <ref loc="MAT 26:57-68">26፥57‑68</ref> ኩወፈ – <char style="xt"><ref loc="MRK 14:53-65">ማር 14፥53‑65</ref>፤ <ref loc="JHN 18:12">ዮሀ 18፥12</ref>፣<ref loc="JHN 18:13">13</ref>፣<ref loc="JHN 18:19-24">19‑24</ref></char></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57"/>ወር ዬሱስን ቀበን ሱንስ ገረ መነ ሉበ ኦል ኣና እሰ ቀያፋ ጄዸሙ እዶ በርሲስቶትን ሴራቲፊ ማንጉዶትን እት ወልት ቀበመኒት እሰ ጌሰን። <verse eid="MAT 26:57"/><verse number="58" style="v" sid="MAT 26:58"/>ጴጥሮስ ገሩ ሀመ ደላ መነ ሉብቸ ኦል ኣናት ፈጎት እሰ ዱካ ቡኤ። እንስ ዋን ተኡፍ ጅሩ አርጉፍ ጄዼ ኦል ልጤ ዋርድዮተ ወጅን ታኤ።<verse eid="MAT 26:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59"/>ሉቦትን ሀንገፎትኒፊ ያኢን ይሁዶታ ጉቱን ዬሱስን አጄሱፍ ጄዸኒ ረጋ ሶባ እሰት በርባዳ ቱረን። <verse eid="MAT 26:59"/><verse number="60" style="v" sid="MAT 26:60"/>እሳን ገሩ ዮ ዹገ ባቶትን ሶባ ሄዱን ዽኣተንሌ ሆማ ህንአርገትኔ።</para>
  <para style="p" vid="MAT 26:60">ዹመረት ዹገ ባቶትን ለመ ዹፈኒ፣ <verse eid="MAT 26:60"/><verse number="61" style="v" sid="MAT 26:61"/>“ነምች ኩን፣ ‘አን መነ ቁልቁሉማ ዋቃ ዲጉ፣ ጉያ ሰዲ ኬሰት ዴብሴ እጃሩ ነንደንደአ’ ጄዼረ” ጄዸን።<verse eid="MAT 26:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62"/>ሉብች ኦል ኣናንስ ከኤ ዻበቴ፣ “አት ዴቢ ቶኮሌ ህንኬንቱ? ወን ነሞትን ኩኔን ዹጋ ስት በአን ኩን ማል?” ጄዼ ዬሱስን ጋፈቴ። <verse eid="MAT 26:62"/><verse number="63" style="v" sid="MAT 26:63"/>ዬሱስ ገሩ እኑመ ጨልእሴ።</para>
  <para style="p" vid="MAT 26:63">ሉብች ኦል ኣናን፣ “አን ዋቀ ጅራታዻን ስን ከከቺሰ፦ አት ዮ ክርስቶስ እልመ ዋቃ ታቴ ሜ ኑት ህም” ጄዼን።<verse eid="MAT 26:63"/></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64"/>ዬሱስስ ዴብሴ፣ <char style="wj">“አቱ ጄቴርተ። አን ገሩ እስንት ነንህመ፤ እስን ስአች ኡቱ እልም ነማ ምርገ እሰ ሁምነ ቀቤሰ ሰናቲን ታኤ፣ ዱሜሰ ሰሚቲን ዹፉ ንአርግቱ”</char> ጄዼ።<verse eid="MAT 26:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65"/>ከነረት ሉብች ኦል ኣናን ኡፈተሳ ተርሳሴ አከነ ጄዼ፤ “እን ዋቀ አረብሴረ! ከነ ጫላ ዹገ ባቶተ ማሊ ኑ በርባችሰ? ኩኖ፣ ዋቀ አረብሱሳ እስንዩ አመ ዸጌሰኒርቱ። <verse eid="MAT 26:65"/><verse number="66" style="v" sid="MAT 26:66"/>ማል እስንት ፈካተ?”</para>
  <para style="p" vid="MAT 26:66">እሳንስ፣ “ዱአቱ እሳፍ መለ” ጄዸኒ ዴብሰን።<verse eid="MAT 26:66"/></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67"/>ኤርገሲ እሳን ፉለሳት ቱፈን፤ አቦቴንስ እሰ ሩኩተን። ወር ካንሞ እሰ ከበለኒ፣ <verse eid="MAT 26:67"/><verse number="68" style="v" sid="MAT 26:68"/>“ያ ክርስቶስ! ኤኙቱ ስ ሩኩቴ? ሜ ራጂ ኑት ዱበዹ” ጄዸኒን።<verse eid="MAT 26:68"/></para>
  <para style="s1">ጴጥሮስ ዬሱስን ገኑሳ</para>
  <para style="r">
    <ref loc="MAT 26:69-75">26፥69‑75</ref> ኩወፈ – <char style="xt"><ref loc="MRK 14:66-72">ማር 14፥66‑72</ref>፤ <ref loc="LUK 22:55-62">ሉቃ 22፥55‑62</ref>፤ <ref loc="JHN 18:16-18">ዮሀ 18፥16‑18</ref>፣<ref loc="JHN 18:25-27">25‑27</ref></char></para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69"/>ጴጥሮስስ ደላ ኬሰ አለ ታኣ ቱሬ፤ ጦምቦሬን ቶኮ እሰት ዽኣቴ፣ “አትስ ዬሱስ ነምቸ ገሊላ ሰነ ወጅን ቱርቴ!” ጄቴን።<verse eid="MAT 26:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70"/>እን ገሩ፣ “አን ዋን አት ዱበቹት ጅርቱ ህንቤኩ” ጄዼ ሁንዱመሳኒ ዱረት ገኔ።<verse eid="MAT 26:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71"/>ኡቱ እን ገረ ከረ ደላ ሰናት ዴማ ጅሩስ ጦምቦሬን ብራ ቶኮ እሰ አርግቴ፣ “ነምች ኩን ዬሱስ ነመ ናዝሬት ወጅን ቱሬ” ጄቴ ወረ አች ቱረንት ህምቴ።<verse eid="MAT 26:71"/></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72"/>እንስ ከከቴ፣ “አን ነምቸ ከነ ህንቤኩ!” ጄዼ አመስ ገኔ።<verse eid="MAT 26:72"/></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73"/>ዬሮ ጥኖ ቦዴ ወር አች ዸዻበቻ ቱረን ጴጥሮስት ዽኣተኒ፣ “አትስ ዹጉመዩ ጀረ ኬሳ ቶኮዸ፤ ሎቆድንኬ ስ ሳጥላቲ” ጄዸን።<verse eid="MAT 26:73"/></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74"/>ዮሙስ እን፣ “አን ነምቸ ከነ ህንቤኩ” ጄዼ ኦፍ አባሩፊ ከከቹ ጀልቀቤ።</para>
  <para style="p" vid="MAT 26:74">ዮሙሱመ እንዳንቆን እዬ። <verse eid="MAT 26:74"/><verse number="75" style="v" sid="MAT 26:75"/>ጴጥሮስስ ዱቢ ዬሱስ፣ <char style="wj">“አት ኡቱ እንዳንቆን ህንእይን ዬሮ ሰዲ ነ ገንተ”</char> ጄዼ ቱሬ ሰነ ያደቴ። ገድ በኤስ ህቅፈቴ ቦኤ።<verse eid="MAT 26:75"/></para>
  <chapter eid="MAT 26"/>
  <chapter number="27" style="c" sid="MAT 27"/>
  <para style="s1">ይሁዳን ኦፍ ፈንሱሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1"/>ገነመ በሪ ሉቦትን ሀንገፎትኒፊ ማንጉዶትን ሰባ ሁንድኑ ዬሱስን አጄሱፍ ወሊ ወጅን መርአተን። <verse eid="MAT 27:1"/><verse number="2" style="v" sid="MAT 27:2"/>እሳንስ እሰ ህዸኒ ጌሰኒ ጲላጦስ ቡልቻት ደበርሰኒ ኬነን።<verse eid="MAT 27:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3"/>ይሁዳን እን ዬሱስን ደበርሴ ኬኔ ሱን ዮሙ አከ ዬሱስት ሙረሜ አርጌት ንጋቤ፤ ሜቲ ሶዶመ ሰነስ ሉቦተ ሀንገፎተቲፊ ማንጉዶተት ዴብሴ። <verse eid="MAT 27:3"/><verse number="4" style="v" sid="MAT 27:4"/>እንስ፣ “አን ዺገ ቁልቁሉ ደበርሴ ኬኑዻን ጩቡ ሆጄዼረ” ጄዼ።</para>
  <para style="p" vid="MAT 27:4">እሳንስ ዴብሰኒ፣ “ማልቱ ኑ ዽቤሬ? ስቱ እት ጋፈተመ!” ጄዸኒን።<verse eid="MAT 27:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5"/>ይሁዳንስ ሜቲ ሰነ መነ ቁልቁሉማ ኬሰት ገቴ ገድ በኤ፤ ዸቄስ ኦፍ ፈንሴ።<verse eid="MAT 27:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6"/>ሉቦትን ሀንገፎትንስ ሜቲ ሰነ ፉዸኒ፣ “ሜቲን ኩን ዋን ገቲ ዺጋ ተኤፍ ሜቲ መነ ቁልቁሉማት ደበሉን ሴረ ምት” ጄዸን። <verse eid="MAT 27:6"/><verse number="7" style="v" sid="MAT 27:7"/>እሳንስ ወሊ ወጅን መርአተኒ አከ ነሞተ ብየ ኦርማቲፍ እዶ አዋላ ተኡፍ ሜቲ ሰናን ለፈ ነምቸ ሱጴ ዸኡ ቶኮ ብተን። <verse eid="MAT 27:7"/><verse number="8" style="v" sid="MAT 27:8"/>ከናፍ ለፍት ሱን ሀመ ሀርኣት፣ “ለፈ ዺጋ” ጄዸሜ ዋመመ። <verse eid="MAT 27:8"/><verse number="9" style="v" sid="MAT 27:9"/>ከናንስ ወን ኤርምያስ ራጅች ዱበቴ ሱን ንራወተሜ፦ እንስ አከነ ጄዸ፤ “እሳን ሜቲ ሶዶመን፣ ገቲሳ ከን እጆሌን እስራኤል እሰት ሸለገን ሰነ ፉዸኒ፣ <verse eid="MAT 27:9"/><verse number="10" style="v" sid="MAT 27:10"/>አኩመ ጎፍታን ነ አጀጄት ለፈ ነምቸ ሱጴ ዸኡ ሰና እቲን ብተን።”<note caller="+" style="f"><char style="fr" closed="false">27፥10 </char><char style="ft" closed="false"><char style="xt"><ref loc="ZEC 11:12">ዘካ 11፥12</ref>፣<ref loc="ZEC 11:13">13</ref>፤ <ref loc="JER 19:1-13">ኤር 19፥1‑13</ref>፤ <ref loc="JER 32:6-9">32፥6‑9</ref>።</char></char></note><verse eid="MAT 27:10"/></para>
  <para style="s1">ዬሱስ ፉለ ጲላጦስ ዱረት</para>
  <para style="r">
    <ref loc="MAT 27:11-26">27፥11‑26</ref> ኩወፈ – <char style="xt"><ref loc="MRK 15:2-15">ማር 15፥2‑15</ref>፤ <ref loc="LUK 23:2">ሉቃ 23፥2</ref>፣<ref loc="LUK 23:3">3</ref>፣<ref loc="LUK 23:18-25">18‑25</ref>፤ <ref loc="JHN 18:29-19:16">ዮሀ 18፥29–19፥16</ref></char></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11"/>ዬሮ ሰነት ዬሱስ ፉለ ቡልቻ ዱረ ዻበቴ፤ ቡልቻን ሱንስ፣ “አት ሞቲ ይሁዶታቲ?” ጄዼ እሰ ጋፈቴ።</para>
  <para style="p" vid="MAT 27:11">ዬሱስሞ፣ <char style="wj">“አቱ ጄቴካ!”</char> ጄዼ ዴብሴ።<verse eid="MAT 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12"/>እን ዬሮ ሉቦትን ሀንገፎትኒፊ ማንጉዶትን እሰ ህመተንትስ ዴቢ ቶኮሌ ህንኬንኔ። <verse eid="MAT 27:12"/><verse number="13" style="v" sid="MAT 27:13"/>ጲላጦስስ፣ “አት አከ እሳን ዋን ሜቀ ስረት ዹጋ በአን ህንዸጌሱ?” ጄዼ እሰ ጋፈቴ። <verse eid="MAT 27:13"/><verse number="14" style="v" sid="MAT 27:14"/>ዬሱስ ገሩ ህመተ ቶኮፍሌ ዴቢ ቶኮዩ ህንኬንኔ፤ ቡልቻን ሱንስ አከ መሌ ዋን ከነ ድንቅሲፈቴ።<verse eid="MAT 27:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15"/>ቡልቻን ሱን ነመ ህዸሜ ቶኮ አያናን አኩመ ፌዺ ሰባት ገድ ዺሱ በርቴ ጎዸቴ ቱሬ። <verse eid="MAT 27:15"/><verse number="16" style="v" sid="MAT 27:16"/>ዬሮ ሰነ ነምች በረባስ ጄዸሙ ቤከማን ቶኮ ህዸሜ ቱሬ። <verse eid="MAT 27:16"/><verse number="17" style="v" sid="MAT 27:17"/>ከናፉ ዮሙ እሳን ወልት ቀበመንት ጲላጦስ፣ “አከ አን እሰ ከም ገድ እስኒ ዺሱ በርባዱ? በረባስሞ ዬሱስ እሰ ክርስቶስ ጄዸሙ ሰነ?” ጄዼ እሳን ጋፈቴ። <verse eid="MAT 27:17"/><verse number="18" style="v" sid="MAT 27:18"/>አከ እሳን ህናፋዻን ዬሱስን ደበርሰኒ እሰት ኬነን ንቤከ ቱሬቲ።<verse eid="MAT 27:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19"/>ኡቱ ጲላጦስ በርጩመ ሙርቲረ ታኡ ኒቲንሳ፣ “ነምቸ ቀጄላ ሰነ ህንቱቅን፤ አን ኤደ ሰበቢሳቲፍ አብጁዻን አከ መሌ ዽጰዼራቲ” ጄቴ እት ዻምቴ።<verse eid="MAT 27:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20"/>ሉቦትን ሀንገፎትኒፊ ማንጉዶትን ገሩ አከ በረባስ ገድ ዺፈሜ፣ ዬሱስሞ አጄፈሙ አከ እሰ ከዸተኒፍ ነሞተ ሶሶበን።<verse eid="MAT 27:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21"/>ቡልቻን ሱን፣ “እሳን ለማን ከኔን ኬሳ አከ አን እሰ ከም ገድ እስኒ ዺሱ በርባዱ?” ጄዼ አመስ ጋፈቴ።</para>
  <para style="p" vid="MAT 27:21">እሳንስ፣ “በረባስን” ጄዸኒ ዴብሰን።<verse eid="MAT 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22"/>ጲላጦስስ፣ “ዬሱስ እሰ ክርስቶስ ጄዸሙሞ አን ማል ጎዹሬ?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="MAT 27:22">ሁንድሳኒስ፣ “እሰ ፈንስ!” ጄዸኒ ዴብሰን።<verse eid="MAT 27:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23"/>ጲላጦስሞ፣ “ማሊፍ? እን የከ ማሊ ሆጄቴ?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="MAT 27:23">እሳን ገሩ እቱመ ጫልችሰኒ፣ “እሰ ፈንስ!” ጄዸኒ እየን።<verse eid="MAT 27:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24"/>ጲላጦስ ዮሙ አከ ወን ኩን ጎሊ ካሱ መሌ ፋይዳ ቶኮሌ ህንቀብኔ አርጌት፣ “አን ዺገ ነመ ከናራ ቁልቁሉዸ፤ እስንቱ እት ጋፈተመ!” ጄዼ ብሻን ፉዸቴ ፉለ ነሞታ ዱረት ሀርከሳ ዽቀቴ።<verse eid="MAT 27:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25"/>ነሞትን ሁንድኑስ፣ “ዺግንሳ ኑፊ እጆሌኬኘረ ሃገኡ!” ጄዸኒ ዴብሰን።<verse eid="MAT 27:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26"/>ኤርገሲ እን በረባስን ገድ እሳኒፍ ዺሴ። ዬሱስን ገሩ ገረፍሲሴ አከ እን ፈንፈሙፍ ደበርሴ ኬኔ።<verse eid="MAT 27:26"/></para>
  <para style="s1">ሎልቶትን ዬሱስት ቆሱሳኒ</para>
  <para style="r">
    <ref loc="MAT 27:27-31">27፥27‑31</ref> ኩወፈ – <char style="xt"><ref loc="MRK 15:16-20">ማር 15፥16‑20</ref></char></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27"/>ኤርገሲ ሎልቶትን ቡልቻ ሰና ዬሱስን መነ ቡልቻት ኦል ገልቸን፤ ራያ ሎልቶታ ሁንደስ ናኖ ዬሱስት ወልት ቀበን። <verse eid="MAT 27:27"/><verse number="28" style="v" sid="MAT 27:28"/>እሳንስ ኡፈተሳራ ባሰኒ ኡፈተ ብልዲማ እት ኡፍሰን፤ <verse eid="MAT 27:28"/><verse number="29" style="v" sid="MAT 27:29"/>ጎንፎ ቆራቲ ምጪረኒ ዸአኒ መታሳረ ካአን። ሀርከሳ ምርጋ ኬሰስ ኡሌ ካአን። ፉለሳ ዱረትስ ጅልቤንፈተኒ፣ “አከምሬ፣ ያ ሞቲ ይሁዶታ!” ጄዸኒ እሰት ቆሰን። <verse eid="MAT 27:29"/><verse number="30" style="v" sid="MAT 27:30"/>እሳንስ እሰት ቱፈን፤ ኡሌ ሰነስ ፉዸኒ መታሳ ሩኩተን። <verse eid="MAT 27:30"/><verse number="31" style="v" sid="MAT 27:31"/>ኤርገ እት ቆሰኒ ቦዴ ኡፈተ ሰነ እራ ባሰኒ ወያሳ ዴብሰኒ እሰት ኡፍሰን። ፈንሱፍስ እሰ ፉዸኒ ዴመን።<verse eid="MAT 27:31"/></para>
  <para style="s1">ዬሱስ ፈንፈሙሳ</para>
  <para style="r">
    <ref loc="MAT 27:33-44">27፥33‑44</ref> ኩወፈ – <char style="xt"><ref loc="MRK 15:22-32">ማር 15፥22‑32</ref>፤ <ref loc="LUK 23:33-43">ሉቃ 23፥33‑43</ref>፤ <ref loc="JHN 19:17-24">ዮሀ 19፥17‑24</ref></char></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32"/>ኡቱ ገድ በአኑስ ነምቸ ቀሬና ከን ስሞን ጄዸሙ ቶኮ አርገኒ አከ እን ፈኖ ሰነ ባቱፍ እሰ ድርቅሲሰን። <verse eid="MAT 27:32"/><verse number="33" style="v" sid="MAT 27:33"/>እሳንስ እዶ ጎልጎታ ጄዸሙ ገአን፤ ጎልጎታ ጄቹን “እዶ ቡቄ መታ” ጄቹዸ። <verse eid="MAT 27:33"/><verse number="34" style="v" sid="MAT 27:34"/>አችትስ አከ እን ዹጉፍ ዳዺ ወይኒ ከን ሀዾፍቱን እት መከሜ ኬነኒፍ፤ እን ገሩ አፋኒን ቀቤ ዹጉ ድዴ። <verse eid="MAT 27:34"/><verse number="35" style="v" sid="MAT 27:35"/>እሳንስ ኤርገ እሰ ፈንሰኒ ቦዴ እጣ ቡፈተኒ ኡፈተሳ ገርገር ቆደተን። <verse eid="MAT 27:35"/><verse number="36" style="v" sid="MAT 27:36"/>እሳንስ አች ታአኒ እሰ ኤጋ ቱረን። <verse eid="MAT 27:36"/><verse number="37" style="v" sid="MAT 27:37"/>ከተቢን ዋን እን እቲን ህመተሜስ መታሳቲ ኦል ካአሜ ቱሬ፤ ከተቢን ሱንስ፣</para>
  <para style="pc" vid="MAT 27:37">ኩን ዬሱስ ሞትቸ ይሁዶታት፣</para>
  <para style="m" vid="MAT 27:37">ጄዸ።<verse eid="MAT 27:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 27:38"/>ሀቶትን ለመስ፣ እን ቶኮ ምርገሳቲን፣ ካንሞ ብታሳቲን እሰ ወጅን ፈንፈመን። <verse eid="MAT 27:38"/><verse number="39" style="v" sid="MAT 27:39"/>ወር አቺን ደርበንስ እሰ አረብሰን፤ መታሳኒስ ራሰኒ፣ <verse eid="MAT 27:39"/><verse number="40" style="v" sid="MAT 27:40"/>“አት ከን መነ ቁልቁሉማ ዲግዴ ጉያ ሰዲት እጃርቱ፣ ሜ ኦፍ ኦልች! አት ዮ እልመ ዋቃ ታቴ ፈኖራ ገድ ቡእ!” ጄዸን። <verse eid="MAT 27:40"/><verse number="41" style="v" sid="MAT 27:41"/>አከሱመስ ሉቦትን ሀንገፎትን፣ በርሲስቶትን ሴራቲፊ ማንጉዶትን እሰት ቆሰን። አከነስ ጄዸን፤ <verse eid="MAT 27:41"/><verse number="42" style="v" sid="MAT 27:42"/>“እን ወረ ካን ኦልቼረ፤ ኦፊሳ ገሩ ኦልቹ ህንደንደኡ! እን ዮ ሞቲ እስራኤል ተኤ አመ ፈኖራ ገድ ሃቡኡ፤ ኑስ እሰት ንአመናቲ። <verse eid="MAT 27:42"/><verse number="43" style="v" sid="MAT 27:43"/>እን ዋቀ አመነተ፤ ዋቅን ዮ እሰ ጃለቴ፣ ሜ አመ እሰ ሃኦልቹ፤ እን፣ ‘አን እልመ ዋቃት’ ጄዼራቲ።” <verse eid="MAT 27:43"/><verse number="44" style="v" sid="MAT 27:44"/>አከሱመ ሀቶትን እሰ ወጅን ፈንፈመንስ እሰ አረብሰን።<verse eid="MAT 27:44"/></para>
  <para style="s1">ዬሱስ ዱኡሳ</para>
  <para style="r">
    <ref loc="MAT 27:45-56">27፥45‑56</ref> ኩወፈ – <char style="xt"><ref loc="MRK 15:33-41">ማር 15፥33‑41</ref>፤ <ref loc="LUK 23:44-49">ሉቃ 23፥44‑49</ref></char></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45"/>ሰኣቲ ጀኣ ጀልቀቤ ሀመ ሰኣቲ ሰገሊት ዱከን ለፈ ሁንደረ ቡኤ። <verse eid="MAT 27:45"/><verse number="46" style="v" sid="MAT 27:46"/>ገረ ሰኣቲ ሰገሊት ዬሱስ ሰገሌ ጉዳዻን፣ <char style="tl"><char style="wj">“ኤሎሄ፣ ኤሎሄ፣</char></char><note caller="+" style="f"><char style="fr" closed="false">27፥46 </char><char style="ft" closed="false">ወራብሌን ቶኮ ቶኮ </char><char style="fqa" closed="false">ኤሊ፣ ኤሊ ጄዹ።</char></note> <char style="tl"><char style="wj">ላማ ሰበቅታኒ?”</char></char> ጄዼ እዬ፤ ሂካንሳስ፣ <char style="wj">“ያ ዋቀኮ፣ ያ ዋቀኮ፣ አት ማሊፍ ነ ዺፍቴ?”</char><note caller="+" style="f"><char style="fr" closed="false">27፥46 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 22:1">ፋር 22፥1</ref></char></char></note> ጄቹዸ።<verse eid="MAT 27:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47"/>ወረ አች ዸዻበተን ኬሳ ቶኮ ቶኮ ዮሙ ዋን ከነ ዸገአንት፣ “ነምች ኩን ኤልያስን ዋመ” ጄዸን።<verse eid="MAT 27:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 27:48"/>ዮሙሱመ እሳን ኬሳ ነምች ቶኮ ፊጌ ዸቄ እስፖንጂ ዳዺ ወይኒ ዸንገጋኣዻን ጉቴ፣ ኡሌት ካኤ፤ አከ እን ዹጉፍስ ዬሱሲፍ ኬኔ። <verse eid="MAT 27:48"/><verse number="49" style="v" sid="MAT 27:49"/>ወር ካን ገሩ፣ “ሜ እሰ ዺሳ። አከ ኤልያስ ዹፌ እሰ ኦልቹ አርግናቲ” ጄዸን።<verse eid="MAT 27:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50"/>ዬሱስ አመስ ሰገሌ ጉዳዻን እዬ ሀፉረሳ ኬኔ።<verse eid="MAT 27:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51"/>ዬሩመ ሰነ ጎልጋን መነ ቁልቁሉማ ኦሊ ሀመ ገዲት እዶ ለመት ተርሰኤ። ለፍት ንሶቾቴ፤ ከታወንስ ንበበቀቀን። <verse eid="MAT 27:51"/><verse number="52" style="v" sid="MAT 27:52"/>አዋሎትንስ በነመኒ ዸግነወን ቁልቁሎታ ከኔን ዱአኒ ቱረን ሄዱን ዱኣ ካፈመን። <verse eid="MAT 27:52"/><verse number="53" style="v" sid="MAT 27:53"/>እሳንስ ዱኣ ከኡ ዬሱስ ቦዴ አዋለ ኬሳ በአኒ መጋለቲ ቁልቁሉ ሴነን። ነሞተ ሄዱትስ ሙልአተን።<verse eid="MAT 27:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54"/>አጀጃን ዽባ ሱኒፊ ወር እሰ ወጅን ዬሱስን ኤጋ ቱረን ዮሙ ሶቺ ለፋቲፊ ዋን አችት ተኤ ሁንደ አርገንት አከ መሌ ሶዳተኒ፣ “ዹጉማኑ እን እልመ ዋቃ ቱሬ!” ጄዸን።<verse eid="MAT 27:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55"/>ዱበርቶትን ዬሱስን ተጃጅሉፍ ጄዸኒ ገሊላዻ እሰ ዱካ ቡአን ባይኤንስ ፈጎ ዻበተኒ እላላ ቱረን። <verse eid="MAT 27:55"/><verse number="56" style="v" sid="MAT 27:56"/>እሳን ኬሳስ ማርያም እሼ መግደላ፣ ማርያም ሃዸ ያቆቢፊ ዮሴፍ፣ አከሱመስ ሃዸ እልማን ዘብዴዎስ ቱረን።<verse eid="MAT 27:56"/></para>
  <para style="s1">ዬሱስ አዋለሙሳ</para>
  <para style="r">
    <ref loc="MAT 27:57-61">27፥57‑61</ref> ኩወፈ – <char style="xt"><ref loc="MRK 15:42-47">ማር 15፥42‑47</ref>፤ <ref loc="LUK 23:50-56">ሉቃ 23፥50‑56</ref>፤ <ref loc="JHN 19:38-42">ዮሀ 19፥38‑42</ref></char></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57"/>ዮሙ ገልገላኤትስ ነምች ሶሬስ ዮሴፍ ጄዸሙ ቶኮ አርማትያ ዹፌ፤ እን መታንሳስ በረታ ዬሱስ ቱሬ። <verse eid="MAT 27:57"/><verse number="58" style="v" sid="MAT 27:58"/>እንስ ገረ ጲላጦስ ዸቄ ሬፈ ዬሱስ ከዸቴ፤ ጲላጦስስ አከ ሬፍ ሱን እሳፍ ኬነሙ አጀጄ። <verse eid="MAT 27:58"/><verse number="59" style="v" sid="MAT 27:59"/>ዮሴፍስ ሬፈ ሰነ ፉዸቴ ሁጩ ቁንጬ ተልባራ ሆጄተሜ ቁልቁሉዻን ከፈኔ፤ <verse eid="MAT 27:59"/><verse number="60" style="v" sid="MAT 27:60"/>እንስ አዋለ ኦፊሳ ከን ገራ ከታ ኬሰት ቆተቴ ሃራ ቶኮ ኬሰ ካኤ። ዸጋ ጉዳ ቶኮስ በልበለ አዋለ ሰናት ገንገልቼ ብራ ዴሜ። <verse eid="MAT 27:60"/><verse number="61" style="v" sid="MAT 27:61"/>ማርያም እሼን መግደላቲፊ ማርያም እሼን ካን ፉሌ አዋለ ሰና ተታኣ ቱረን።<verse eid="MAT 27:61"/></para>
  <para style="s1">ኤግዱ አዋላ</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62"/>ጉያ እት ኣኑት ጄቹንስ ጉያ ቆጲ ቦዴ ሉቦትን ሀንገፎትኒፊ ፈሪሶትን ፉለ ጲላጦስ ዱረት ወልት ቀበመን። <verse eid="MAT 27:62"/><verse number="63" style="v" sid="MAT 27:63"/>እሳንስ አከነ ጄዸን፤ “ጎፍታ! አከ ነምች ጎዎምሳን ሱን ኡቱ ሉቡዻን ጅሩ፣ <char style="wj">‘አን ጉያ ሰዲ ቦዴ ዱኣ ነንከአ’</char> ጄዼ ኑ ንያደትነ። <verse eid="MAT 27:63"/><verse number="64" style="v" sid="MAT 27:64"/>ከናፉ አከ አዋል ሱን ሀመ ጉያ ሰደፋት ኤገሙ አጀጅ። ዮ ኩን ተኡ ባቴ በረቶትንሳ ዸቀኒ ሬፈሳ ሀተኒ፣ ‘እን ወረ ዱአን ኬሳ ከኤረ’ ጄዸኒ ነመት ኦዴሱ። ጎዎምሳን ዹማ ኩንሞ እሰ ዱራ ጫላ ንሀማተ።”<verse eid="MAT 27:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65"/>ጲላጦስስ ዴብሴ፣ “ዋርድያ ፉዸዻ ዸቃቲ አኩመ ቤክተንት አዋልቸ ኤግስፈዻ” ጄዼን። <verse eid="MAT 27:65"/><verse number="66" style="v" sid="MAT 27:66"/>ከናፍ እሳን ዸቀኒ ዸግቸረት መለቶ ጎዸን፤ ዋርድያስ ረመደኒ አዋለ ሰነ ኤግስሰን።<verse eid="MAT 27:66"/></para>
  <chapter eid="MAT 27"/>
  <chapter number="28" style="c" sid="MAT 28"/>
  <para style="s1">ዱኣ ከኡ ዬሱስ</para>
  <para style="r">
    <ref loc="MAT 28:1-8">28፥1‑8</ref> ኩወፈ – <char style="xt"><ref loc="MRK 16:1-8">ማር 16፥1‑8</ref>፤ <ref loc="LUK 24:1-10">ሉቃ 24፥1‑10</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1"/>ሰንበተ ቦዴ፣ ጉያ ጀልቀበ ቶርበን ሰና ማርያም እሼን መግደላቲፊ ማርያም እሼን ካን በሪ በራቃን አዋለ እላሉ ዸቀን።<verse eid="MAT 28:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 28:2"/>ኩኖ፣ ሰበቢ ኤርገማን ጎፍታ ሰሚራ ገድ ቡኤ ገረ አዋላ ዸቄ በልበለ አዋላራ ዸጋ ሰነ ገረገልቼ እረ ታኤፍ፣ ሶቺን ለፋ ጉዳን ተኤ። <verse eid="MAT 28:2"/><verse number="3" style="v" sid="MAT 28:3"/>ብፍትሳ እፋ አከ በከካ፣ ኡፈትንሳሞ አዲ አከ ጨቢ ቱሬ። <verse eid="MAT 28:3"/><verse number="4" style="v" sid="MAT 28:4"/>ዋርድዮትን ሱንስ ሰበቢ እሰ ሶዳተኒፍ ሆለተኒ አኩመ ነመ ዱኤ ተአን።<verse eid="MAT 28:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5"/>ኤርገማን ሱንስ ዱበርቶተ ሰናን አከነ ጄዼ፤ “ህንሶዳትና! አከ እስን ዬሱስ እሰ ፈንፈሜ ቱሬ ሰነ በርባደን አኑ ቤከ። <verse eid="MAT 28:5"/><verse number="6" style="v" sid="MAT 28:6"/>እን አስ ህንጅሩ፤ አኩመ ጄዼ ሰነ ዱኣ ከኤራቲ። ኮታቲ እዶ እን ጪሳ ቱሬ እላላ። <verse eid="MAT 28:6"/><verse number="7" style="v" sid="MAT 28:7"/>ኤጋ ደፋ ዸቃቲ አከነ ጄዻ በረቶተሳት ህማ፤ ‘እን ወረ ዱአን ኬሳ ከኤረ፤ ኩኖ፣ እን እስን ዱርሴ ገሊላ ንዸቀ። አችትስ እሰ ንአርግቱ።’ ኩኖ አን እስንት ህሜረ።”<verse eid="MAT 28:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8"/>ዱበርቶትን ሱንስ ሶዳተኒ፣ ተኡስ ገመቹ ጉዳን ጉተመኒ አሪቲዻን አዋለ ሰነ ብራ ዴመን፤ በረቶተሳት ህሙፍስ ፊገን። <verse eid="MAT 28:8"/><verse number="9" style="v" sid="MAT 28:9"/>ዬሩመ ሰነ ኩኖ ዬሱስ እሳንት ዹፌ፣ ነጋ እሳን ጋፈቴ። እሳንስ እሰት ዽኣተኒ ሚለሳ ቀበተኒ ሰገደኒፍ። <verse eid="MAT 28:9"/><verse number="10" style="v" sid="MAT 28:10"/>ዬሱስስ፣ <char style="wj">“ህንሶዳትና! ዸቃቲ አከ እሳን ገረ ገሊላ ዴመኒፍ ኦቦሎተኮት ህማ፤ እሳንስ አችት ነ አርጉ”</char> ጄዼን።<verse eid="MAT 28:10"/></para>
  <para style="s1">ገባሰ ዋርድዮታ</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11"/>ኡቱ ዱበርቶትን ሱን ከራ ጅረኑ ዋርድዮተ ሰነ ኬሳ ቶኮ ቶኮ መጋላ ሴነኒ ዋን ተኤ ሁንደ ሉቦተ ሀንገፎተት ህመን። <verse eid="MAT 28:11"/><verse number="12" style="v" sid="MAT 28:12"/>ሉቦትን ሀንገፎትንስ ኤርገ ማንጉዶተ ወጅን ወልት ቀበመኒ መርአተኒ ቦዴ ሎልቶታፍ ማለቀ ሄዱ ኬነን። <verse eid="MAT 28:12"/><verse number="13" style="v" sid="MAT 28:13"/>አከነስ ጄዸኒን፤ “ ‘ኡቱ ኑ ረፍኑ በረቶትንሳ ሀልከኒን ዹፈኒ እሰ ሀተን’ ጄዻቲ ነሞተት ህማ። <verse eid="MAT 28:13"/><verse number="14" style="v" sid="MAT 28:14"/>ዮ ወን ኩን ጉረ ቡልቻ ሴኔ ኑ እሰ አመንሲፍኔ ረክነ ጀላ እስን ባፍና።” <verse eid="MAT 28:14"/><verse number="15" style="v" sid="MAT 28:15"/>ሎልቶትንስ ማለቀ ሰነ ፉዸተኒ አኩመ አጀጀመን ጎዸን። ኦዱን ኩንስ ሀመ ሀርኣት ይሁዶተ ብረት ኦዴፈማ ጅረ።<verse eid="MAT 28:15"/></para>
  <para style="s1">ኤርገመ ጉድቸ</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16"/>በረቶትን ኩዸ ቶኮን ሱን ገረ ብየ ገሊላ፣ ገረ ቱሉ ዬሱስ ዸቃ እሳኒን ጄዼ ቱሬ ሰና ዸቀን። <verse eid="MAT 28:16"/><verse number="17" style="v" sid="MAT 28:17"/>እሳንስ ዮሙ እሰ አርገንት ንሰገደኒፍ፤ እሳን ኬሳ ቶኮ ቶኮ ገሩ ንመመን። <verse eid="MAT 28:17"/><verse number="18" style="v" sid="MAT 28:18"/>ዬሱስሞ እሳንት ዽኣቴ አከነ ጄዼ፤ <char style="wj">“ታይታን ሁንድኑ ሰሚፊ ለፈረት ናፍ ኬነሜረ።</char> <verse eid="MAT 28:18"/><verse number="19" style="v" sid="MAT 28:19"/><char style="wj">ከናፍ ዸቃቲ ሰበ ሁንዱማ መቃ አባት፣ መቃ እልማት፣ መቃ ሀፉረ ቁልቁሉትስ ጩጳቲ በረቶተ ታስሳ፤</char> <verse eid="MAT 28:19"/><verse number="20" style="v" sid="MAT 28:20"/><char style="wj">አከ ዋን አን እስን አጀጄ ሁንደ ኤገኒፍስ እሳን በርሲሳ። ኩኖ፣ አን ሀመ ዹመ አዱኛት ጉያ ሁንደ እስን ወጅነን ጅረ።”</char><verse eid="MAT 28:20"/></para>
  <chapter eid="MAT 28"/>
</usx>
