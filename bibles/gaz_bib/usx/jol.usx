<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JOL" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">ዮኤል</para>
  <para style="toc1">ራጂ ዮኤል</para>
  <para style="toc2">ዮኤል</para>
  <para style="toc3">ዮኤ</para>
  <para style="mt2">ራጂ</para>
  <para style="mt1">ዮኤል</para>
  <chapter number="1" style="c" sid="JOL 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JOL 1:1"/>ዱቢ <char style="nd">ዋቀዮ</char> ከን ገረ ዮኤል እልመ ጴቱኤል ዹፌ።<verse eid="JOL 1:1"/></para>
  <para style="b"/>
  <para style="s1">ዌረረ ሀዋንሳ</para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 1:2"/>ያ ማንጉዶተ፣ ዋን ከነ ዸገኣ፤</para>
  <para style="q2" vid="JOL 1:2">ወር ብየቲ ኬሰ ጅራተን ሁንድኑ ዸጌፈዻ።</para>
  <para style="q1" vid="JOL 1:2">ወን አከና ተኩማ በረኬሰን ኬሰ</para>
  <para style="q2" vid="JOL 1:2">ዮካን በረ አቦቲኬሰኒ ኬሰ ተኤ ቤካ?<verse eid="JOL 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 1:3"/>እስን ዋን ከነ እጆሌኬሰንት ህማ፤</para>
  <para style="q2" vid="JOL 1:3">እጆሌንኬሰንስ እጆሌ ኦፊሳኒት ሃህመን፤</para>
  <para style="q2" vid="JOL 1:3">እጆሌንሳኒሞ ዸሎተ እት ኣኑት ሃደበርሰን።<verse eid="JOL 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 1:4"/>ዋን ቱትን ሀዋንሳ ዺሴ፣</para>
  <para style="q2" vid="JOL 1:4">ሀዋንስን ጉዳን ፍጤ፤</para>
  <para style="q1" vid="JOL 1:4">ዋን ሀዋንስን ጉዳን ዺሴ፣</para>
  <para style="q2" vid="JOL 1:4">ሀዋንስን ጥጥናን ኛቴ ፍጤ፤</para>
  <para style="q1" vid="JOL 1:4">ዋን ሀዋንስን ጥጥናን ዺሴሞ</para>
  <para style="q2" vid="JOL 1:4">ሀዋንስን ብራ ዹፌ ኛቴ።<verse eid="JOL 1:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 1:5"/>ያ መቾፍቶተ፣ ከኣቲ ቦኣ!</para>
  <para style="q2" vid="JOL 1:5">እስን ወር ዳዺ ወይኒ ዹግደን <optbreak/> ሁንድኑ ወዋዻ፤</para>
  <para style="q1" vid="JOL 1:5">ሰበቢ ዳዺ ወይኒ ሃራቲፍ <optbreak/> ወዋዻ፤</para>
  <para style="q2" vid="JOL 1:5">እን አፋንኬሰንራ ቡተሜራቲ።<verse eid="JOL 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 1:6"/>ሰብን ጀባን አከ መሌ ባይኤን ቶኮ</para>
  <para style="q2" vid="JOL 1:6">ብየኮ ዌረሬረ፤</para>
  <para style="q1" vid="JOL 1:6">እን እልካን ሌንጫ፣</para>
  <para style="q2" vid="JOL 1:6">ቀርፋ ሌንጨ ዸላ ቀበ።<verse eid="JOL 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 1:7"/>እን ሙከ ወይኒኮ ኦንሴ</para>
  <para style="q2" vid="JOL 1:7">ሀርቡኮስ በርበዴሴረ።</para>
  <para style="q1" vid="JOL 1:7">እን ቆለሳኒራ ቁንጭሴ ለፈት ገቴ</para>
  <para style="q2" vid="JOL 1:7">ደሜሌሳኒ ዱዋ ሀምብሴ።<verse eid="JOL 1:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 1:8"/>እስን አኩመ ዱርበ ወያ ገዳ ኡፈቴ</para>
  <para style="q2" vid="JOL 1:8">ዽርሰ እጆሉማሼቲፍ ገድቱት ቦኣ።<verse eid="JOL 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 1:9"/>ኬናን ምዻኒቲፊ ዽባዩን</para>
  <para style="q2" vid="JOL 1:9">መነ <char style="nd">ዋቀዮራ</char> ጭተኒሩ።</para>
  <para style="q1" vid="JOL 1:9">ሉቦትን ፉለ <char style="nd">ዋቀዮ</char> ዱረ ተጃጅለን</para>
  <para style="q2" vid="JOL 1:9">ቦኣ ጅሩ።<verse eid="JOL 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 1:10"/>ለፍት ቆቲሳ ኦኔረ፤</para>
  <para style="q2" vid="JOL 1:10">ለፍትስ ጎጌረ፤</para>
  <para style="q1" vid="JOL 1:10">ምዻን በርበዳኤረ፤</para>
  <para style="q2" vid="JOL 1:10">ዳዺን ወይኒ ሃራን ዹሜረ፤</para>
  <para style="q2" vid="JOL 1:10">ዘይቲንስ ዸበሜረ።<verse eid="JOL 1:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 1:11"/>ያ ቆናን ቡልቶተ፣ እስን ራፈማ፤</para>
  <para style="q2" vid="JOL 1:11">ወር ወይኒ ዻበተን ቦኣ፤</para>
  <para style="q1" vid="JOL 1:11">ሰበቢ ምዻን ለፈ ቆቲሳኬሰኒ</para>
  <para style="q2" vid="JOL 1:11">በርበዳኤፍ ቀመዲፊ ገርቡዻፍ ቦኣ።<verse eid="JOL 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 1:12"/>ወይኒን ጎጌረ፤</para>
  <para style="q2" vid="JOL 1:12">ሀርቡንስ ጮለጌረ፤</para>
  <para style="q1" vid="JOL 1:12">ሮማኒን፣ ሜጢፊ ሁዻን፣</para>
  <para style="q2" vid="JOL 1:12">ሙኬን ለፈ ቆቲሳ ሁንድኑ ጎገኒሩ።</para>
  <para style="q1" vid="JOL 1:12">ዹጉማን ገመቹን እልማን ነማ</para>
  <para style="q2" vid="JOL 1:12">እራ በዴረ።<verse eid="JOL 1:12"/></para>
  <para style="s1">ዋምቸ ቀልቢ ጅጂረቹ</para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 1:13"/>ያ ሉቦተ፣ ወያ ገዳ ኡፈዻቲ ቦኣ፤</para>
  <para style="q2" vid="JOL 1:13">እስን ወር እዶ ኣርሳ ዱረ ተጃጅልተን ወዋዻ።</para>
  <para style="q1" vid="JOL 1:13">እስን ወር ፉለ ዋቀኮ ዱረ ተጃጅልተን</para>
  <para style="q2" vid="JOL 1:13">ኮታቲ ወያ ገዳ ኡፈዻ ቡላ፤</para>
  <para style="q1" vid="JOL 1:13">ኬናን ምዻኒቲፊ ዽባዩን</para>
  <para style="q2" vid="JOL 1:13">መነ ዋቃራ ሀምብፈመኒሩቲ።<verse eid="JOL 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 1:14"/>ሶመ ቁልቁሉ ለብሳ፤</para>
  <para style="q2" vid="JOL 1:14">ወልዳ ቁልቁሉ ዋማ።</para>
  <para style="q1" vid="JOL 1:14">ማንጉዶታፊ</para>
  <para style="q2" vid="JOL 1:14">ወረ ብየቲ ኬሰ ጅራተን ሁንደ</para>
  <para style="q1" vid="JOL 1:14">ገረ መነ <char style="nd">ዋቀዮ</char> ዋቀኬሰኒት ዋማቲ</para>
  <para style="q2" vid="JOL 1:14">
    <char style="nd">ዋቀዮት</char> ቦኣ።<verse eid="JOL 1:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 1:15"/>በድኔካ! ጉያን ሱን ዽኣቴረ።</para>
  <para style="q2" vid="JOL 1:15">ጉያን <char style="nd">ዋቀዮ</char> ገኤራቲ፤</para>
  <para style="q2" vid="JOL 1:15">እን አኩመ በዲሳት <optbreak/> ዋቀ ዋን ሁንደ ደንደኡ ብራ ዹፈ።<verse eid="JOL 1:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 1:16"/>እጁመኬኘ ዱረት</para>
  <para style="q2" vid="JOL 1:16">ኛትን ጭቴ፤</para>
  <para style="q1" vid="JOL 1:16">እልሌፊ ገመቹንስ</para>
  <para style="q2" vid="JOL 1:16">መነ ዋቀኬኛራ ህንጭትኔ?<verse eid="JOL 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 1:17"/>ሰኚን ለፈ ኬሰት</para>
  <para style="q2" vid="JOL 1:17">ቶርቶሬ ሀፌ።</para>
  <para style="q1" vid="JOL 1:17">መንኩስን ዲገሜረ፤</para>
  <para style="q2" vid="JOL 1:17">ጎምብሳን ጨጨቤረ፤</para>
  <para style="q2" vid="JOL 1:17">ምዻን ጎጌ ሀፌራቲ።<verse eid="JOL 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 1:18"/>ሎን አከም መርአቱ!</para>
  <para style="q2" vid="JOL 1:18">ከር ሎኒ ሰበቢ ዋን ዼዱ ዸቤፍ</para>
  <para style="q1" vid="JOL 1:18">አሲፊ አች ጆረ፤</para>
  <para style="q2" vid="JOL 1:18">ቡሻዬንስ ዽጰተኒሩ።<verse eid="JOL 1:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 1:19"/>ያ <char style="nd">ዋቀዮ</char> አን ስን ዋመዸ፤</para>
  <para style="q2" vid="JOL 1:19">እብድ ለፈ ዼዳ በርበዴሴ</para>
  <para style="q2" vid="JOL 1:19">አረብን እብዳሞ ሙኬን ዲዳ ሁንደ ጉቤ ፍጤራቲ።<verse eid="JOL 1:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 1:20"/>ብኔንሶትን ቦሶና ስት ገገቡ፤</para>
  <para style="q2" vid="JOL 1:20">ለግን ብሻኒ ጎጌረ፤</para>
  <para style="q2" vid="JOL 1:20">እብድስ ድሬ ዼዳ ጉቤ በሌሴረ።<verse eid="JOL 1:20"/></para>
  <chapter eid="JOL 1"/>
  <chapter number="2" style="c" sid="JOL 2"/>
  <para style="s1">ራያ ሀዋንሳ</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 2:1"/>ጥዮን ኬሰት መለከተ አፉፋ፤</para>
  <para style="q2" vid="JOL 2:1">ጋረኮ ቁልቁሉረት ሰገሌ <optbreak/> አኬከቺሳ ዸጌስሳ።</para>
  <para style="b" vid="JOL 2:1"/>
  <para style="q1" vid="JOL 2:1">ጉያን <char style="nd">ዋቀዮ</char> ዹፋ ጅራቲ፤</para>
  <para style="q2" vid="JOL 2:1">ወር ለፈረ ጅራተን ሁንድ ሃሆለተን።</para>
  <para style="q1" vid="JOL 2:1">ጉያን ሱን ዽኣቴረ፤<verse eid="JOL 2:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="JOL 2:2"/>ጉያን ዱከናቲፊ ድምምሳ፣</para>
  <para style="q2" vid="JOL 2:2">ጉያን ዱሜሳቲፊ ዱከነ ሀማ ንዹፈ።</para>
  <para style="q1" vid="JOL 2:2">ሰብን ጉዳፊ ጀባን ቶኮ</para>
  <para style="q2" vid="JOL 2:2">አኩመ እፈ ገነመ ቱሉወንረት በኡት ንዹፈ፤</para>
  <para style="q1" vid="JOL 2:2">ወን አከሲ ተኩማ በረ ዱሪ ኬሰ ተኤ ህንቤኩ</para>
  <para style="q2" vid="JOL 2:2">ዮካን ዸሎተ ዹፉፍ ጅሩ ኬሰትሌ ህንተኡ።<verse eid="JOL 2:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 2:3"/>ፉለሳኒ ዱራ እብድ ንበርበዴሰ፤</para>
  <para style="q2" vid="JOL 2:3">ዱግደሳኒ ዱባንሞ አረበ እብዳቱ ቦበአ።</para>
  <para style="q1" vid="JOL 2:3">ፉለሳኒ ዱራን ለፍት እዶ ብቅልቱ ኤዴን ፈካተ፤</para>
  <para style="q2" vid="JOL 2:3">ዱግደሳኒ ዱባንሞ ለፍት አኩመ ገሞጂ ኦኔት፤</para>
  <para style="q2" vid="JOL 2:3">ወን ቶኮዩ እሳን ዱራ ህንምልቁ።<verse eid="JOL 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 2:4"/>እሳን ብፈ ፈርዴኒ ቀቡ፤</para>
  <para style="q2" vid="JOL 2:4">አኩመ ፈርዴን ሎላስ ንጉሉፉ።<verse eid="JOL 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 2:5"/>እሳን ሰገሌ አከ ጋሪ ወራናቲን</para>
  <para style="q2" vid="JOL 2:5">ፊጤ ቱሉረ ኡታሉ፤</para>
  <para style="q1" vid="JOL 2:5">አኩመ እብደ ዬሮ ቀርሚ ጉቡት ጣጠኡ፣</para>
  <para style="q2" vid="JOL 2:5">አኩመ ወራነ ጀባ ሎላፍ በኤ ቶኮት።<verse eid="JOL 2:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 2:6"/>ሰቦትን ጀረ አርግኒ ዽጰቱ፤</para>
  <para style="q2" vid="JOL 2:6">ፉል ነመ ሁንዳስ ንጉራቸአ።<verse eid="JOL 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 2:7"/>እሳን አኩመ ነሞተ ጀጀቦ ፊጉ፤</para>
  <para style="q2" vid="JOL 2:7">አኩመ ሎልቶታ ደላ ያበተኒ ሴኑ።</para>
  <para style="q1" vid="JOL 2:7">ሁንድሳኒ ተሬ ገለኒ ዴሙ፤</para>
  <para style="q2" vid="JOL 2:7">እሳን ኬሳ ቶኮዩ ዳንዲሳራ ህንጀልአቱ።<verse eid="JOL 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 2:8"/>እሳን ወል ህንዺበን፤</para>
  <para style="q2" vid="JOL 2:8">ሁንድሳኒ ቀጄለኒ ፉለ ዱረት ዴሙ።</para>
  <para style="q1" vid="JOL 2:8">ኡቱ ቶረሳኒ ህንዺስን</para>
  <para style="q2" vid="JOL 2:8">እትሰ ጨብሰኒ ሴኑ።<verse eid="JOL 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 2:9"/>እሳን መጋላ ኬሰ አሲፊ አች ፊጉ፤</para>
  <para style="q2" vid="JOL 2:9">ደላረ ፊጉ።</para>
  <para style="q1" vid="JOL 2:9">እሳን መነ ያበቱ፤</para>
  <para style="q2" vid="JOL 2:9">አኩመ ሀቱስ ፎዳዻን ኦል ሴኑ።<verse eid="JOL 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 2:10"/>ፉለሳኒ ዱረት ለፍት ንሶቾት፤</para>
  <para style="q2" vid="JOL 2:10">ሰሚን ንራፈመ፤</para>
  <para style="q1" vid="JOL 2:10">አዱፊ ጅእ ንዱከናኡ፤</para>
  <para style="q2" vid="JOL 2:10">ኡርጂወን ዴብአኒ ህንእብሰን።<verse eid="JOL 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 2:11"/>
    <char style="nd">ዋቀዮ</char> ፉለ ሎልቶተሳ ዱረት</para>
  <para style="q2" vid="JOL 2:11">ሰገሌ ዸጌስሰ፤</para>
  <para style="q1" vid="JOL 2:11">ሎልቶትንሳ አከ መሌ ባይኤዸ፤</para>
  <para style="q2" vid="JOL 2:11">ወር አጀጀሳ ኤገን ጀጀቦዸ።</para>
  <para style="q1" vid="JOL 2:11">ጉያን <char style="nd">ዋቀዮ</char> ጉዳዸ፤</para>
  <para style="q2" vid="JOL 2:11">ጉያን ሱን አከ መሌ ነመ ሶዳችሰ።</para>
  <para style="q2" vid="JOL 2:11">ኤኙቱ ዱረ ዻበቹ ደንደአ?<verse eid="JOL 2:11"/></para>
  <para style="s1">ጩቡራ ዴብኣ</para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 2:12"/>“አመዩ ገራ ጉቱዻን፣</para>
  <para style="q2" vid="JOL 2:12">ሶማን፣ ቦእቻፊ ገዳን</para>
  <para style="q2" vid="JOL 2:12">ገረኮት ዴብኣ” ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="JOL 2:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 2:13"/>እስን ኡቱ ወያኬሰን ህንተእን</para>
  <para style="q2" vid="JOL 2:13">ገራኬሰን ተርሳሳ።</para>
  <para style="q1" vid="JOL 2:13">ገረ <char style="nd">ዋቀዮ</char> ዋቀኬሰኒት ዴብኣ፤</para>
  <para style="q2" vid="JOL 2:13">እን አርጃፊ ገረ ላፌሳቲ፤</para>
  <para style="q1" vid="JOL 2:13">እን ደፌ ህንኣሩ፤ ጃለልሳ ባይኤዸ፤</para>
  <para style="q2" vid="JOL 2:13">እን በዲሰ ኤርጉራ ኦፍ ቁሰተ።<verse eid="JOL 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 2:14"/>ማልቱ ቤከ? ተሪ እን ዴብኤ ጋቤ</para>
  <para style="q2" vid="JOL 2:14">ኤበ፣ ኬና ምዻኒቲፊ ኬና ዹጋቲ</para>
  <para style="q1" vid="JOL 2:14">ከን <char style="nd">ዋቀዮ</char> ዋቀኬሰኒፍ ተኡ</para>
  <para style="q2" vid="JOL 2:14">እስኒፍ ሀምብሰ ተአ።<verse eid="JOL 2:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 2:15"/>ጥዮን ኬሰት መለከተ አፉፋ፤</para>
  <para style="q2" vid="JOL 2:15">ሶመ ቁልቁሉ ለብሳ፤</para>
  <para style="q2" vid="JOL 2:15">ወልዳ ቁልቁሉ ዋማ።<verse eid="JOL 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 2:16"/>ሰበ ወልት ቀባ፤</para>
  <para style="q2" vid="JOL 2:16">ወልዳ ሰነ ቁልቁሌሳ፤</para>
  <para style="q1" vid="JOL 2:16">ማንጉዶተ ወልት ፍዳ፤</para>
  <para style="q2" vid="JOL 2:16">እጆሌ ወልት ቀባ፤</para>
  <para style="q2" vid="JOL 2:16">ዳእመን ሀርመ ሆዸንሌ ህንሀምብስና።</para>
  <para style="q1" vid="JOL 2:16">ምስርች ኩታሳ ኬሳ ሃበኡ፤</para>
  <para style="q2" vid="JOL 2:16">ምስርቲንስ ዲንቀሼቲ ሃባቱ።<verse eid="JOL 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 2:17"/>ሉቦትን ፉለ <char style="nd">ዋቀዮ</char> ዱረ ተጃጅለን</para>
  <para style="q2" vid="JOL 2:17">ገርዳፎፊ እዶ ኣርሳ ግዱት ሃቦአን።</para>
  <para style="q1" vid="JOL 2:17">እሳን አከነ ሃጄዸን፤ “ያ <char style="nd">ዋቀዮ</char> ሰበኬ በራር።</para>
  <para style="q2" vid="JOL 2:17">ሀንዹራኬ ዋን ቆሳ፣</para>
  <para style="q2" vid="JOL 2:17">ሰቦተ ግዱትስ ዋን ኮልፋ ህንጎዽን።</para>
  <para style="q1" vid="JOL 2:17">እሳን ማሊፍ ነሞተ ግዱት፣</para>
  <para style="q2" vid="JOL 2:17">‘ዋቅንሳኒ ኤሰ ጅረ?’ ጄዹ?”<verse eid="JOL 2:17"/></para>
  <para style="s1">ዴቢ <char style="nd">ዋቀዮ</char> ኬኔ</para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 2:18"/>
    <char style="nd">ዋቀዮ</char> ብየሳቲፍ ንህናፈ፤</para>
  <para style="q2" vid="JOL 2:18">ሰበሳቲፍስ ገራ ላፈ።<verse eid="JOL 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JOL 2:19"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዼ ዴቢ ኬናፍ፦</para>
  <para style="q1" vid="JOL 2:19">“አን ምዻን፣ ዳዺ ወይኒ ሃራፊ ዘይቲ ኤጄርሳ</para>
  <para style="q2" vid="JOL 2:19">ከን እስን ቁብሱ እስኒፍ ነንኤርገ፤</para>
  <para style="q1" vid="JOL 2:19">አን ለመተ ሰቦተ ግዱት</para>
  <para style="q2" vid="JOL 2:19">ዋን ቆሳ እስን ህንጎዹ።<verse eid="JOL 2:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 2:20"/>“አን ሎልቶተ ካባ እስን ዱራ በሌሴ</para>
  <para style="q2" vid="JOL 2:20">ገረ ለፈ ጎጋፊ ዱዋት እሳን አርአ፤</para>
  <para style="q1" vid="JOL 2:20">ሎልቶትን ፉለ ዱራን ያአን ገላነ በአ ቢፍቱ፣</para>
  <para style="q2" vid="JOL 2:20">ከኔን ዱግደ ዱባን ያአንሞ <optbreak/> ገላነ ገመ ልጠ ቢፍቱ ሴኑ።</para>
  <para style="q1" vid="JOL 2:20">ሬፍሳኒ ንጥራአ፤</para>
  <para style="q2" vid="JOL 2:20">ጥራንሳኒስ ኦል በአ።”</para>
  <para style="b" vid="JOL 2:20"/>
  <para style="q1" vid="JOL 2:20">ዹጉማን እን ዋን ጉዳ ሆጄቴረ!<verse eid="JOL 2:20"/></para>
  <para style="q2">
    <verse number="21" style="v" sid="JOL 2:21"/>ያ ብየ ይሁዳ፣ ህንሶዳትን፤</para>
  <para style="q2" vid="JOL 2:21">ገመዲቲ እልልች።</para>
  <para style="q1" vid="JOL 2:21">
    <char style="nd">ዋቀዮ</char> ዹጉማን ዋን ጉዳ ሆጄቴረ!<verse eid="JOL 2:21"/></para>
  <para style="q2">
    <verse number="22" style="v" sid="JOL 2:22"/>ያ ብኔንሶተ ቦሶና፣ እስንስ ህንሶዳትና፤</para>
  <para style="q2" vid="JOL 2:22">ድሬን ዼዳ ገበቻ ጅራቲ።</para>
  <para style="q1" vid="JOL 2:22">ሙኬን እጀ ነቀቻ፣</para>
  <para style="q2" vid="JOL 2:22">ሀርቡፊ ወይኒንስ እጀ ኬና ጅሩ።<verse eid="JOL 2:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOL 2:23"/>ያ ኡመተ ጥዮን ገመድ፤</para>
  <para style="q2" vid="JOL 2:23">
    <char style="nd">ዋቀዮ</char> ዋቀኬት ገመድ፤</para>
  <para style="q1" vid="JOL 2:23">እን ቀጄሉማዻን</para>
  <para style="q2" vid="JOL 2:23">ሮበ አርፋሳ ሲፍ ኬኔራቲ።</para>
  <para style="q1" vid="JOL 2:23">እን አኩመ ዱሪ ቦካ ባይኤ፣</para>
  <para style="q2" vid="JOL 2:23">ሮበ አርፋሳፊ ከን ብራ ሲፍ ኤርገ።<verse eid="JOL 2:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOL 2:24"/>ኦብዲን ምዻኒን ጉተመ፤</para>
  <para style="q2" vid="JOL 2:24">ቦል እት ወይኒ ጩንፈንስ ዳዺ ወይኒ ሃራፊ <optbreak/> ዘይቲዻን ጉተመኒ ዸንገላሱ።<verse eid="JOL 2:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="JOL 2:25"/>“አን ዋን በረ ሀዋንስን ኛቴ፣</para>
  <para style="q2" vid="JOL 2:25">ዋን ሀዋንስን ጉርጉዳፊ ጥጥናን ኛቴ፣</para>
  <para style="q2" vid="JOL 2:25">ዋን ሀዋንስን ካኒፊ ቱትን ሀዋንሳ</para>
  <para style="q1" vid="JOL 2:25">ጄቹንስ ሎልቶትንኮ ጀጀቦን አን ግዱኬሰንት ኤርጌ ሱን ኛተን <optbreak/> እዶ እስኒፍ ነንቡሰ።<verse eid="JOL 2:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOL 2:26"/>እስን ዋን ሀመ ቁፍተንት ኛተን ባይኤ ንቀባቱ፤</para>
  <para style="q2" vid="JOL 2:26">መቃ <char style="nd">ዋቀዮ</char> ዋቀኬሰኒ</para>
  <para style="q2" vid="JOL 2:26">ከን ዋን ድንቂ እስኒፍ ሆጄቴ ሰና ንገለቴፈቱ፤</para>
  <para style="q1" vid="JOL 2:26">ኡመትንኮ ለመተ ህንቃኔፈሙ።<verse eid="JOL 2:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOL 2:27"/>ኤርገሲ እስን አከ አን እስራኤል ኬሰ ጅሩ</para>
  <para style="q2" vid="JOL 2:27">አከ አን <char style="nd">ዋቀዮ</char> ዋቀኬሰን ተኤ፣</para>
  <para style="q2" vid="JOL 2:27">አከ አነ መሌ ዋቅን ብራ ህንጅሬ ንቤክቱ፤</para>
  <para style="q1" vid="JOL 2:27">ኡመትንኮ ለመተ ህንቃኔፈሙ።<verse eid="JOL 2:27"/></para>
  <para style="s1">ጉያ <char style="nd">ዋቀዮ</char></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOL 2:28"/>“አንስ ከነ ቦዴ፣</para>
  <para style="q2" vid="JOL 2:28">ሀፉረኮ ነመ ሁንደረት ነንዸንገላሰ።</para>
  <para style="q1" vid="JOL 2:28">እልማኒፊ እንተለንኬሰን ራጂ ዱበቱ፤</para>
  <para style="q2" vid="JOL 2:28">ጃርሶሊንኬሰን አብጁ አብጆቱ፤</para>
  <para style="q2" vid="JOL 2:28">ደርገጎትንኬሰን ሙልአተ አርጉ።<verse eid="JOL 2:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOL 2:29"/>በረ ሰነ ኬሰ፣ ገርቦተኮ</para>
  <para style="q2" vid="JOL 2:29">ወረ ዺራፊ ዱበርቲረትሌ</para>
  <para style="q2" vid="JOL 2:29">ሀፉረኮ ነንዸንገላሰ።<verse eid="JOL 2:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOL 2:30"/>አን ኦል ሰሚረት ድንቂ፣</para>
  <para style="q2" vid="JOL 2:30">ገድ ለፈረትስ ዺገ፣</para>
  <para style="q2" vid="JOL 2:30">እብዳፊ ሁሪ ኣራ ነንአርግሲሰ።<verse eid="JOL 2:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOL 2:31"/>ኡቱ ጉያን <char style="nd">ዋቀዮ</char> እን ጉድቺፊ</para>
  <para style="q2" vid="JOL 2:31">ሶዳችሳን ሱን ህንዹፍን ዱረ፣</para>
  <para style="q2" vid="JOL 2:31">አዱን ዱከነት ጌደረምት፤</para>
  <para style="q2" vid="JOL 2:31">ጅእሞ ዺገት ጌደረመ።<verse eid="JOL 2:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOL 2:32"/>ነምን መቃ <char style="nd">ዋቀዮ</char> ዋመቱ</para>
  <para style="q2" vid="JOL 2:32">ሁንድኑ ንፈየ፤</para>
  <para style="q1" vid="JOL 2:32">አኩመ <char style="nd">ዋቀዮ</char> ዱበቴትስ</para>
  <para style="q2" vid="JOL 2:32">ቱሉ ጥዮንራፊ</para>
  <para style="q2" vid="JOL 2:32">ዬሩሳሌም ኬሰ፣ ፉረመቱ ጅራተ፤</para>
  <para style="q1" vid="JOL 2:32">ሀምባ ግዱትስ ወር <char style="nd">ዋቀዮ</char></para>
  <para style="q2" vid="JOL 2:32">እሳን ዋሜ ንአርገሙ።<verse eid="JOL 2:32"/></para>
  <chapter eid="JOL 2"/>
  <chapter number="3" style="c" sid="JOL 3"/>
  <para style="s1">ሰቦተት ሙረሜ</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 3:1"/>“በረ ሰነ ኬሰ፣ ዬሮ ሰነት፣</para>
  <para style="q2" vid="JOL 3:1">አን ዮሙን ቦጁ ይሁዳቲፊ <optbreak/> ዬሩሳሌም ዴብሱት፣<verse eid="JOL 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 3:2"/>ሰቦተ ሁንደ ወልት ቀቤን</para>
  <para style="q2" vid="JOL 3:2">ገረ ሱሉለ ዬሆሻፋጥት <optbreak/> ገድ እሳን ነንቡሰ።</para>
  <para style="q1" vid="JOL 3:2">አንስ አችት ሰበቢ ዻለኮ፣</para>
  <para style="q2" vid="JOL 3:2">ሰበቢ እስራኤሊፍ እሳንት ነንሙረ፤</para>
  <para style="q1" vid="JOL 3:2">እሳን ሰቦተ ግዱት ሰበኮ</para>
  <para style="q2" vid="JOL 3:2">ብትኔሰኒ ብየኮስ ገርገር ቆደተኒሩቲ።<verse eid="JOL 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 3:3"/>እሳን ኡመተኮት እጣ ቡፈተኒ</para>
  <para style="q2" vid="JOL 3:3">እጆሌ ዺራስ ሰጋገሉማት ጌደረተኒሩ፤</para>
  <para style="q2" vid="JOL 3:3">አከ ዹገኒፍ ዱበረሌ ዳዺ ወይኒት ጉርጉረተን።<verse eid="JOL 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JOL 3:4"/>“ያ ጢሮሲፊ ሲዶና፣ እስን ኩታሌን ፍልስጤም ሁንድኑ፣ አመ ማል ነራ ቀብዱ? እስን ዋን አን ጎዼፍ ሃሎ ነ ባፈቻ ጅርቱ? ዮ እስን ሃሎ ነ ባፈቻ ጅርቱ ተኤ አን ደፌ አሪቲዻን ዋን እስን ሆጄተን ሰነ መቱመኬሰንት ዴብሰ። <verse eid="JOL 3:4"/><verse number="5" style="v" sid="JOL 3:5"/>እስን ሜቲፊ ወርቄኮ ጉረተኒ ቀቤኘኮ ፍለተማስ መነ ዋቄፈትናኬሰንት ጌፈተኒርቱቲ። <verse eid="JOL 3:5"/><verse number="6" style="v" sid="JOL 3:6"/>እስን ብየሳኒራ እሳን ፈጌስተኒ ኡመተ ይሁዳቲፊ ዬሩሳሌም ግሪኮተት ጉርጉረተን።<verse eid="JOL 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JOL 3:7"/>“ኩኖ፣ አን ብየ እስን እት እሳን ጉርጉረተን ኬሳ እሳን ባሴ ዋን እስን ሆጄተን ሰነ መቱመኬሰንት ነንዴብሰ። <verse eid="JOL 3:7"/><verse number="8" style="v" sid="JOL 3:8"/>አን እልማኒፊ እንተለንኬሰን ሰበ ይሁዳት ነንጉርጉረ፤ እሳንሞ ሰበ ፈጎ ጅሩ ከን ሳባ ጄዸሙት ደበርሰኒ እሳን ጉርጉረቱ።” <char style="nd">ዋቀዮ</char> ዱበቴራቲ።<verse eid="JOL 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 3:9"/>ዋን ከነ ሰቦተ ግዱት ለብሳ፦</para>
  <para style="q2" vid="JOL 3:9">ወራናፍ ቆጳኣ!</para>
  <para style="q1" vid="JOL 3:9">ጎቶተ ከካሳ!</para>
  <para style="q2" vid="JOL 3:9">ሎልቶትን ሁንድ ዽኣተኒ ሃሎለን።<verse eid="JOL 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 3:10"/>ማረሻኬሰን ቱማቲ ጎራዴ ጎዸዻ፤</para>
  <para style="q2" vid="JOL 3:10">ሃምቱኬሰንስ ቱማቲ ኤቦ ጎዸዻ።</para>
  <para style="q1" vid="JOL 3:10">ነምን ላፋን፣</para>
  <para style="q2" vid="JOL 3:10">“አን ጀባዸ!” ሃጄዹ።<verse eid="JOL 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 3:11"/>እስን ሰቦትን ቅጠ ሁንዳን ደፋ ኮታቲ</para>
  <para style="q2" vid="JOL 3:11">አችት ወልት ቀበማ።</para>
  <para style="b" vid="JOL 3:11"/>
  <para style="q1" vid="JOL 3:11">ያ <char style="nd">ዋቀዮ</char>፣ ሎልቶተኬ ገድ ኤርግ!<verse eid="JOL 3:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 3:12"/>“ሰቦትን ሃከአን፤</para>
  <para style="q2" vid="JOL 3:12">እሳን ደፈኒ ገረ ሱሉለ ዬሆሻፋጥ ሃዹፈን፤</para>
  <para style="q1" vid="JOL 3:12">አን ሰቦተ ገመ ሁንዳን ጅረንት ሙሩፍ</para>
  <para style="q2" vid="JOL 3:12">አች ነንታኣቲ።<verse eid="JOL 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 3:13"/>ምዻን ገኤራቲ</para>
  <para style="q2" vid="JOL 3:13">ሃምቱ እት ካኣ።</para>
  <para style="q1" vid="JOL 3:13">ኮታቲ እጀ ወይኒ ዽዺታ፤</para>
  <para style="q2" vid="JOL 3:13">ቦል እት ወይኒ ጩንፈን ጉቴራቲ፤</para>
  <para style="q2" vid="JOL 3:13">ሰበቢ ሀምንሳኒ ጉዳ ተኤፍ</para>
  <para style="q1" vid="JOL 3:13">ቦል እት ወይኒ ጩንፈን ጉቴረ ዸንገለኤረ!”<verse eid="JOL 3:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 3:14"/>ወልዳን ጉዳን፣ ወልዳን ነመ ባይኤ</para>
  <para style="q2" vid="JOL 3:14">ሱሉለ ሙርቲ ኬሰት ወል ገኤረ!</para>
  <para style="q1" vid="JOL 3:14">ጉያን <char style="nd">ዋቀዮ</char></para>
  <para style="q2" vid="JOL 3:14">ሱሉለ ሙርቲ ኬሰት ዹፉ ገኤራቲ።<verse eid="JOL 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 3:15"/>ቢፍቱፊ አዴስ ንዱከናኡ፤</para>
  <para style="q2" vid="JOL 3:15">ኡርጂወንስ ስአች እፈ ህንኬነን።<verse eid="JOL 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 3:16"/>
    <char style="nd">ዋቀዮ</char> ጥዮንራ ንእየ፤</para>
  <para style="q2" vid="JOL 3:16">ዬሩሳሌም ኬሳስ ሰገሌ ዸጌስሰ፤</para>
  <para style="q2" vid="JOL 3:16">ለፋፊ ሰሚን ንራፈሙ።</para>
  <para style="q1" vid="JOL 3:16">
    <char style="nd">ዋቀዮ</char> ገሩ ሰበሳቲፍ እዶ እት በቀተን፣</para>
  <para style="q2" vid="JOL 3:16">ሰበ እስራኤሊፍሞ ደኦ ንተአ።<verse eid="JOL 3:16"/></para>
  <para style="s1">ኤበ ሰበ ዋቃቲፍ ኬነሜ</para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 3:17"/>“ኤርገሲ እስን አከ አን <char style="nd">ዋቀዮ</char> ዋቅንኬሰን ጥዮን ኬሰ፣</para>
  <para style="q2" vid="JOL 3:17">ጋረኮ ቁልቁሉ ሰነረ ጅራዹ ንቤክቱ።</para>
  <para style="q1" vid="JOL 3:17">ዬሩሳሌም ቁልቁሉ ታት፤</para>
  <para style="q2" vid="JOL 3:17">ነሞትን ብየ አላ ጎንኩማ ለመተ እሼ ህንዌረረን።<verse eid="JOL 3:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 3:18"/>“ጋፈስ ቱሉወን ዳዺ ወይኒ ሃራ ንጮጮብሱ፤</para>
  <para style="q2" vid="JOL 3:18">ጋረንስ ኣነን ያሱ፤</para>
  <para style="q2" vid="JOL 3:18">ለጌን ይሁዳ ሁንድኑ ብሻኒን ጉተሙ።</para>
  <para style="q1" vid="JOL 3:18">ቡርቃን ቶኮ መነ <char style="nd">ዋቀዮ</char> ኬሳ</para>
  <para style="q2" vid="JOL 3:18">ቡርቄ ሱሉለ ሽጢም ንኦባሰ።<verse eid="JOL 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 3:19"/>ግብጥ ገሩ ንኦንት፤</para>
  <para style="q2" vid="JOL 3:19">ኤዶምስ ዱዋ ሀፍት፤</para>
  <para style="q1" vid="JOL 3:19">እሳን ዺገ ነመ የከ ህንቀብኔ ብየቲ ኬሰት <optbreak/> ዸንገላሱዻን</para>
  <para style="q2" vid="JOL 3:19">ሰበ ይሁዳት ደበ ሆጄተኒሩቲ።<verse eid="JOL 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 3:20"/>ይሁዳን በረ በራን፣</para>
  <para style="q2" vid="JOL 3:20">ዬሩሳሌምስ ዸሎተ ሁንዳፍ እዶ ጅሬኛ ንታት።<verse eid="JOL 3:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOL 3:21"/>አን ዺገሳኒ ከን የከ ህንቀብኔ ሰነ</para>
  <para style="q2" vid="JOL 3:21">ኡቱን ሃሎ ህንበእን ነንዺሳ?</para>
  <para style="q2" vid="JOL 3:21">ለኪ፣ ህንዺሱ።”</para>
  <para style="b" vid="JOL 3:21"/>
  <para style="qc" vid="JOL 3:21">
    <char style="nd">ዋቀዮ</char> ጥዮን ኬሰ ጅራተ!<verse eid="JOL 3:21"/></para>
  <chapter eid="JOL 3"/>
</usx>
