<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ISA" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">እሳያስ</para>
  <para style="toc1">ራጂ እሳያስ</para>
  <para style="toc2">እሳያስ</para>
  <para style="toc3">እሳ</para>
  <para style="mt2">ራጂ</para>
  <para style="mt1">እሳያስ</para>
  <chapter number="1" style="c" sid="ISA 1"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 1:1"/>ሙልአተ እሳያስ እልም አሞስ በረ ቡልቺንሰ ኡዝያን፣ በረ ዮታም፣ በረ ኣሃዚፊ በረ ህስቅያስ ኬሰ ዋኤ ይሁዳቲፊ ዬሩሳሌም አርጌ።<verse eid="ISA 1:1"/></para>
  <para style="b"/>
  <para style="s1">ሰበ ፍንጭላ ቶኮ</para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 1:2"/>ያ ሰሚወን ዸገኣ! ያ ለፈ ዸጌፈዹ!</para>
  <para style="q2" vid="ISA 1:2">
    <char style="nd">ዋቀዮ</char> አከነ ጄዼ ዱበቴራቲ፦</para>
  <para style="q1" vid="ISA 1:2">“አን እጆሌ ሆረዼን ጉድፈዼ፤</para>
  <para style="q2" vid="ISA 1:2">እሳን ገሩ ነት ፍንጭለኒሩ።<verse eid="ISA 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 1:3"/>ቆትዮን ጎፍታሳ፣</para>
  <para style="q2" vid="ISA 1:3">ሀሬንስ ጎለ ጎፍታሳ ንቤከ፤</para>
  <para style="q1" vid="ISA 1:3">እስራኤል ገሩ ህንቤኩ፤</para>
  <para style="q2" vid="ISA 1:3">ሰብንኮ ህንሁበቱ።”<verse eid="ISA 1:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 1:4"/>ያ ሰበ ጩበማ፣</para>
  <para style="q2" vid="ISA 1:4">ኡመተ በሌሳን እት ባይአቴ፣</para>
  <para style="q1" vid="ISA 1:4">እልማን ወረ ዋን ሀማ ሆጄቱ፣</para>
  <para style="q2" vid="ISA 1:4">እጆሌ ጡራኡማዻን ጉተምቴ እስኒፍ ወዮ!</para>
  <para style="q1" vid="ISA 1:4">እሳን <char style="nd">ዋቀዮን</char> ዺሰኒሩ፤</para>
  <para style="q2" vid="ISA 1:4">ቁልቁልቸ እስራኤል ሰነ ቱፈተኒ</para>
  <para style="q2" vid="ISA 1:4">ዱግደሳኒ እት ገረገልፈተኒሩ።<verse eid="ISA 1:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 1:5"/>እስን ስአች ማሊፍ ሩኩተምቱ?</para>
  <para style="q2" vid="ISA 1:5">ማሊፍ ፍንጭለ ኬሰ ጅራቱ?</para>
  <para style="q1" vid="ISA 1:5">መታንኬሰን ጉቱን ሚዸሜረ፤</para>
  <para style="q2" vid="ISA 1:5">ገራንኬሰን ጉቱንስ ደዸቤረ።<verse eid="ISA 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 1:6"/>ፋነ ሚለኬሰኒቲ ሀመ ጉቤ መታኬሰኒት፣</para>
  <para style="q2" vid="ISA 1:6">ፈያ ህንቀብደን፤</para>
  <para style="q1" vid="ISA 1:6">መዳፊ ድርመሙን፣ መዳን ዺጉ፣</para>
  <para style="q2" vid="ISA 1:6">ከን ህንቁልቁሎፍኔ ዮካን ህንመረምኔ</para>
  <para style="q2" vid="ISA 1:6">ዮካን ዘይቲዻን ህንላፍኔ።<verse eid="ISA 1:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 1:7"/>ብይኬሰን ዱዋ ሀፍቴርት፤</para>
  <para style="q2" vid="ISA 1:7">መጋላወንኬሰን እብዳን ጉበመኒሩ፤</para>
  <para style="q1" vid="ISA 1:7">አለጎን ፉሉመኬሰን ዱረት</para>
  <para style="q2" vid="ISA 1:7">ለፈ ቆቲሳኬሰን ሳሙ፤</para>
  <para style="q2" vid="ISA 1:7">አኩመ ዋን ኦርም እሼ ሳሜትስ ኦንት።<verse eid="ISA 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 1:8"/>እንተል ጥዮን አኩመ ደአትኖ እዶ</para>
  <para style="q2" vid="ISA 1:8">ዻባ ወይኒ ኬሳት፣</para>
  <para style="q1" vid="ISA 1:8">አኩመ ዳሲ ለፈ ቆቲሰ ቡቄ ኬሳት፣</para>
  <para style="q2" vid="ISA 1:8">አኩመ መጋላ መርፈሜ ቶኮት ዺፈምት።<verse eid="ISA 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 1:9"/>ኡቱ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ</para>
  <para style="q2" vid="ISA 1:9">ሀምባ ሙራሰ ኑፍ ሀምብሱ ባቴ፣</para>
  <para style="q1" vid="ISA 1:9">ኑ ስላ አኩመ ሶዶም ታኔ፣</para>
  <para style="q2" vid="ISA 1:9">ጎሞራስ ፈካትነ ቱሬ።<verse eid="ISA 1:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 1:10"/>ያ ቡልችቶተ ሶዶም</para>
  <para style="q2" vid="ISA 1:10">ዱቢ <char style="nd">ዋቀዮ</char> ዸገኣ፤</para>
  <para style="q1" vid="ISA 1:10">ያ ሰበ ጎሞራ፣</para>
  <para style="q2" vid="ISA 1:10">ሴረ ዋቀኬኛ ዸጌፈዻ!<verse eid="ISA 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 1:11"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፤</para>
  <para style="q2" vid="ISA 1:11">“ባይእን ኣርሳኬሰኒ አናፍ ማል?”</para>
  <para style="q2" vid="ISA 1:11">አን ኣርሳ ጉበሙ ከን ኮርቤዪ ሆላቲፊ <optbreak/> ሆሪ ገብፈመኒ ባይኤን ቀበ፤</para>
  <para style="q1" vid="ISA 1:11">አን ዺገ ኮሮሚ ሎኒት፣</para>
  <para style="q2" vid="ISA 1:11">ከን ጦባላወን ሆላቲፊ ሬኤት ህንገመዱ።<verse eid="ISA 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 1:12"/>እስን ዮሙ ፉለኮ ዱረት ሙልአቹፍ ዹፍተን፣</para>
  <para style="q2" vid="ISA 1:12">አከ ኦብዲኮ ዽዺተን</para>
  <para style="q2" vid="ISA 1:12">ኤኙቱ እስንራ በርባዴ?<verse eid="ISA 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 1:13"/>ኬና ፋይዳ ህንቀብኔ ፍዱ ዺሳ!</para>
  <para style="q2" vid="ISA 1:13">እጣንኬሰን ነ ጅብሲሰ።</para>
  <para style="q1" vid="ISA 1:13">አያነ ባቲ፣ ሰንበታፊ ያኢኬሰን</para>
  <para style="q2" vid="ISA 1:13">ጄቹንስ ወል ገኢኬሰን ሀማ ሰነ አን ህንፌዹ።<verse eid="ISA 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 1:14"/>አያነ ባቲኬሰኒፊ</para>
  <para style="q2" vid="ISA 1:14">አያኖተኬሰን ቤቤከሞ ሉቡንኮ ንጅብት።</para>
  <para style="q1" vid="ISA 1:14">እሳን በኣ ነት ተአኒሩ፤</para>
  <para style="q2" vid="ISA 1:14">አንስ ኦብሱ ደዸቤረ።<verse eid="ISA 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 1:15"/>ዬሮ እስን ከዸናፍ ሀርከኬሰን በልእፈተን፣</para>
  <para style="q2" vid="ISA 1:15">አን እጀኮ እስነን ዾክፈዸ፤</para>
  <para style="q2" vid="ISA 1:15">ዮ እስን ከዻ ባይኤ ከዸተንሌ አን ህንዸጌፈዹ።</para>
  <para style="b" vid="ISA 1:15"/>
  <para style="q1" vid="ISA 1:15">ሀርክኬሰን ዺጋን ጉተሜረ!<verse eid="ISA 1:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 1:16"/>ዽቀዻቲ ኦፍ ቁልቁሌሳ።</para>
  <para style="q2" vid="ISA 1:16">ሆጂኬሰን ሀማ ሰነ ፉለኮ ዱራ በሌሳ!</para>
  <para style="q2" vid="ISA 1:16">የከ ሆጄቹስ ዺሳ፤<verse eid="ISA 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 1:17"/>ዋን ቀጄላ ሆጄቹ በረዻ!</para>
  <para style="q2" vid="ISA 1:17">ሙርቲ ቀጄላ በርባዳ፤</para>
  <para style="q1" vid="ISA 1:17">ወረ ሀጩጨሜ ጀጀቤሳ።</para>
  <para style="q2" vid="ISA 1:17">እጆሌ አባ ህንቀብኔፍ ፈልማ፤</para>
  <para style="q2" vid="ISA 1:17">ሃዸ ህዬሳቲፍ ዻበዻ።<verse eid="ISA 1:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 1:18"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፤</para>
  <para style="q2" vid="ISA 1:18">“ኮታ ወል ቆራ፤</para>
  <para style="q1" vid="ISA 1:18">ጩቡንኬሰን ዮ አከ ብልዲማ ተኤዩ፣</para>
  <para style="q2" vid="ISA 1:18">እን አዳቴ አከ ጨቢ ንተአ፤</para>
  <para style="q1" vid="ISA 1:18">ዮ አከ አለላ ዲመቴዩ፣</para>
  <para style="q2" vid="ISA 1:18">አከ ሱፊ ንአዳተ።<verse eid="ISA 1:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 1:19"/>እስን ዮ ፌዺ ቀባተኒ አጀጀምተን፣</para>
  <para style="q2" vid="ISA 1:19">ዋን ለፍት ባፍቱ ፍለተማ ንኛቱ፤<verse eid="ISA 1:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 1:20"/>ገሩ ዮ ድደኒ ፍንጭልተን ጎራዴቱ እስን ኛተ።”</para>
  <para style="q2" vid="ISA 1:20">አፋን <char style="nd">ዋቀዮ</char> ዋን ከነ ዱበቴራቲ።<verse eid="ISA 1:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 1:21"/>አከ መጋላን አመነምቱን ሱን</para>
  <para style="q2" vid="ISA 1:21">ሰጋገልቱ ታቴ እላላ!</para>
  <para style="q1" vid="ISA 1:21">እሼን ዱር ሙርቲ ቀጄላዻን ጉተምቴ</para>
  <para style="q2" vid="ISA 1:21">ቀጄሉማን እሼ ኬሰ ጅራተ ቱሬ፤</para>
  <para style="q2" vid="ISA 1:21">አመሞ ነሞተ ነመ አጄሰንቱ እሼ ኬሰ ጅራተ!<verse eid="ISA 1:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 1:22"/>ሜቲንኬ ልግዳኤረ፤</para>
  <para style="q2" vid="ISA 1:22">ዳዺን ወይኒኬ ፍለተማን ብሻኒን መከሜረ።<verse eid="ISA 1:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 1:23"/>ቡልችቶትንኬ ፍንጭልቶተ፤</para>
  <para style="q2" vid="ISA 1:23">ምቹ ሀቱወኒት፤</para>
  <para style="q1" vid="ISA 1:23">እሳን ሁንድኑ መተኣ ጃለቱ፤</para>
  <para style="q2" vid="ISA 1:23">ኬናስ አከ መሌ በርባዱ።</para>
  <para style="q1" vid="ISA 1:23">እሳን እጆሌ አባ ህንቀብኔፍ ህንፈልመን፤</para>
  <para style="q2" vid="ISA 1:23">ህመተ ሃዸ ህዬሳ ህንዸጌፈተን።<verse eid="ISA 1:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 1:24"/>ከናፉ ጎፍታን፣ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣</para>
  <para style="q2" vid="ISA 1:24">ጀባን እስራኤል ሱን አከነ ጄዸ፦</para>
  <para style="q1" vid="ISA 1:24">“አን አመጃጆተኮራ ቦቆና ነንአርገዸ፤</para>
  <para style="q2" vid="ISA 1:24">ዲኖተኮስ ሃሎ ነንባፈዸ።<verse eid="ISA 1:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 1:25"/>አን ሀርከኮ ስት ነንዴብሰ፤</para>
  <para style="q2" vid="ISA 1:25">ልግዳኡማኬስ አከ መሉት ስራ ነንሀቀ፤</para>
  <para style="q2" vid="ISA 1:25">ጡሪኬ ሁንደስ ስራ ነንበሌሰ።<verse eid="ISA 1:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 1:26"/>አን አኩመ በረ ዱሪ አቦቲ ሙርቲ እዶት፣</para>
  <para style="q2" vid="ISA 1:26">አኩመ ጀልቀባት ጎርስቶተኬሌ ሲፍን ዴብሰ።</para>
  <para style="q1" vid="ISA 1:26">ኤርገሲ አት መጋላ ቀጄሉማ፣</para>
  <para style="q2" vid="ISA 1:26">መጋላ አመነምቱ ጄዸምቴ ንዋመምተ።”<verse eid="ISA 1:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 1:27"/>ጥዮን ሙርቲ ቀጄላዻን፣</para>
  <para style="q2" vid="ISA 1:27">ቀልቢ ጅጂረቶትንሼሞ ቀጄሉማዻን ፉረሙ።<verse eid="ISA 1:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 1:28"/>ፍንጭልቶትኒፊ ጩበሞትን ገሩ ንጨጨቡ፤</para>
  <para style="q2" vid="ISA 1:28">ወር <char style="nd">ዋቀዮን</char> ዺሰንስ ንበዱ።<verse eid="ISA 1:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 1:29"/>“እስን ሰበቢ ሙከ ቅልጡ እት ገመደን ሰናቲፍ ንቃኖፍቱ፤</para>
  <para style="q2" vid="ISA 1:29">ሰበቢ እዶ ብቅልቱ ፍለተን ሰናቲፍሞ ንሰልጰቱ።<verse eid="ISA 1:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 1:30"/>እስን አከ ቅልጡ ባል እራ ሀርጨኤ፣</para>
  <para style="q2" vid="ISA 1:30">አከ እዶ ብቅልቱ ብሻን ህንቀብኔ ንታቱ።<verse eid="ISA 1:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 1:31"/>ነምን ጀባን አኩመ ሁባ፣</para>
  <para style="q2" vid="ISA 1:31">ሆጂንሳስ አኩመ ቃንቄ ተአ፤</para>
  <para style="q1" vid="ISA 1:31">እሳን ለቹ ወሉማን ጉበቱ፤</para>
  <para style="q2" vid="ISA 1:31">ነምን እብደ ሰነ ዻምሱስ ህንጅሩ።”<verse eid="ISA 1:31"/></para>
  <chapter eid="ISA 1"/>
  <chapter number="2" style="c" sid="ISA 2"/>
  <para style="s1">ቱሉ <char style="nd">ዋቀዮ</char></para>
  <para style="r">
    <ref loc="ISA 2:1-4">2፥1‑4</ref> ኩወፈ – <char style="xt"><ref loc="MIC 4:1-3">ሚክ 4፥1‑3</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 2:1"/>ወን እሳያስ እልም አሞስ ዋኤ ይሁዳቲፊ ዬሩሳሌም አርጌ ከናዸ፦<verse eid="ISA 2:1"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="2" style="v" sid="ISA 2:2"/>በረ ዹማ ኬሰ፣</para>
  <para style="q1" vid="ISA 2:2">ቱሉን መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char></para>
  <para style="q2" vid="ISA 2:2">ቱሉወን ሁንደ ኬሳ ኦል ዼረቴ ዻበተ፤</para>
  <para style="q1" vid="ISA 2:2">እን ቱሉወን ጫላ ኦል ኦል ጄዸ፤</para>
  <para style="q2" vid="ISA 2:2">ሰቦትን ሁንድኑ ገረሳት ያኡ።<verse eid="ISA 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 2:3"/>ነሞትን ባይኤን ዹፈኒ አከነ ጄዹ፤</para>
  <para style="q1" vid="ISA 2:3">“ኮታ ገረ ቱሉ <char style="nd">ዋቀዮ</char>፣</para>
  <para style="q2" vid="ISA 2:3">ገረ መነ ዋቀ ያቆብት ኦል ባና።</para>
  <para style="q1" vid="ISA 2:3">እን አከ ኑ ዳንዲሳረ ዴምኑፍ</para>
  <para style="q2" vid="ISA 2:3">ከራሳ ኑ በርሲሰ።”</para>
  <para style="q1" vid="ISA 2:3">ሴር ጥዮን ኬሳ፣</para>
  <para style="q2" vid="ISA 2:3">ዱቢን <char style="nd">ዋቀዮሞ</char> <optbreak/> ዬሩሳሌም ኬሳ ንበአ።<verse eid="ISA 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 2:4"/>እን ሰቦተ ግዱት ሙርቲ ኬነ፤</para>
  <para style="q2" vid="ISA 2:4">ነሞተ ሄዱዻፍስ ንሙርቴሰ።</para>
  <para style="q1" vid="ISA 2:4">እሳን ጎራዴሳኒ ቱመኒ ማረሻ ቶልፈቱ፤</para>
  <para style="q2" vid="ISA 2:4">ኤቦሳኒስ ቱመኒ ሃምቱ ቶልፈቱ።</para>
  <para style="q1" vid="ISA 2:4">ሰብን ቶኮ ሰበ ብራት ጎራዴ ህንሉቅፈቱ፤</para>
  <para style="q2" vid="ISA 2:4">ዮካን ሎላፍ ነመ ህንሌንጅፈተን።<verse eid="ISA 2:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 2:5"/>ያ መነ ያቆብ፣</para>
  <para style="q2" vid="ISA 2:5">ኮታ እፈ <char style="nd">ዋቀዮ</char> ኬሰ ዴዴብና።<verse eid="ISA 2:5"/></para>
  <para style="s1">ጉያ <char style="nd">ዋቀዮ</char></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 2:6"/>ከናፉ ሰበኬ፣</para>
  <para style="q2" vid="ISA 2:6">መነ ያቆብ ዺፍቴርተ።</para>
  <para style="q1" vid="ISA 2:6">እሳን በርቴ በአ ቢፍቱቲን ጉተመኒሩ፤</para>
  <para style="q2" vid="ISA 2:6">አኩመ ፍልስጤሞታ ፈልፈለ ሆጄቱ፤</para>
  <para style="q2" vid="ISA 2:6">ዱዻ ነሞተ ኦርማትስ ንጭቹ።<verse eid="ISA 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 2:7"/>ብይሳኒ ሜቲፊ ወርቄን ጉተምቴርት፤</para>
  <para style="q2" vid="ISA 2:7">ቀቤኝሳኒ ዹመ ህንቀቡ።</para>
  <para style="q1" vid="ISA 2:7">ብይሳኒ ፈርዴኒን ጉተምቴርት፤</para>
  <para style="q2" vid="ISA 2:7">ጋሪወንሳኒስ ዹመ ህንቀበን።<verse eid="ISA 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 2:8"/>ብይሳኒ ዋቆተ ቶልፈሞዻን ጉተምቴርት፤</para>
  <para style="q2" vid="ISA 2:8">እሳን ሆጂዹመ ሀርከሳኒ፣</para>
  <para style="q2" vid="ISA 2:8">ዋኑመ ቁብንሳኒ ቶልቼፍ ሰገዱ።<verse eid="ISA 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 2:9"/>ከናፉ ነምን ገድ ቀበመ፤</para>
  <para style="q2" vid="ISA 2:9">እልማን ነማ ገድ ዴብፈሙ፤</para>
  <para style="q2" vid="ISA 2:9">አት እሳኒፍ ህንዺስን።<verse eid="ISA 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 2:10"/>አርገሙ <char style="nd">ዋቀዮ</char> እሰ ሶዳችሳፊ</para>
  <para style="q2" vid="ISA 2:10">ሱራ ኡልፍነሳ ዱራ፣ ከታ ኬሰ ልጡ፤</para>
  <para style="q2" vid="ISA 2:10">ለፈ ኬሰስ ዾከዹ!<verse eid="ISA 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 2:11"/>እጅ ነመ ኦፍ ቱሉ ገድ ቀበመ፤</para>
  <para style="q2" vid="ISA 2:11">ኦፍ ጀጁን ነሞታስ ገድ ዴብፈመ፤</para>
  <para style="q1" vid="ISA 2:11">ጋፈስ <char style="nd">ዋቀዮ</char> ቆፈቱ ኦል ኦል ጄዸ።<verse eid="ISA 2:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 2:12"/>
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ</para>
  <para style="q2" vid="ISA 2:12">ወረ ኦፍ ጀጁፊ ወረ ኦፍ ቱሉ ሁንዳፍ፣</para>
  <para style="q1" vid="ISA 2:12">ወረ ኦል ኦል ጄዸን ሁንዳፍ ጉያ ቶኮ ቀበ፤</para>
  <para style="q2" vid="ISA 2:12">እሳንስ ገድ ዴብፈሙ።<verse eid="ISA 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 2:13"/>እን ብርብርሰ ልባኖን ዼራፊ</para>
  <para style="q2" vid="ISA 2:13">ጉዳ ሁንዳፍ፣ ቅልጡ ባሻን ሁንዳፍ፣<verse eid="ISA 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 2:14"/>ቱሉወን ኦል ዼዼሮ ሁንዳፍ፣</para>
  <para style="q2" vid="ISA 2:14">ጋረን ኦል ዼዼሮ ሁንዳፍ፣<verse eid="ISA 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 2:15"/>ገሞ ጉርጉዳ ሁንዳፍ፣</para>
  <para style="q2" vid="ISA 2:15">ደላ ዸጋዻን ጀቤፈሜ እጃረሜ ሁንዳፍ፣<verse eid="ISA 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 2:16"/>ዶኒ ደልደላ ሁንዳፊ ዋን ገቲ ጉዳ ቀቡ ሁንዳፍ</para>
  <para style="q2" vid="ISA 2:16">ጉያ ሙርቴፈቴ ቶኮ ቀበ።<verse eid="ISA 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 2:17"/>ኦፍ ቱሉማን ነማ ገድ ቀበመ፤</para>
  <para style="q2" vid="ISA 2:17">ኦፍ ጀጁን ነሞታስ ገድ ዴብፈመ፤</para>
  <para style="q1" vid="ISA 2:17">ጋፈስ <char style="nd">ዋቀዮ</char> ቆፈቱ ኦል ኦል ጄዸ፤<verse eid="ISA 2:17"/></para>
  <para style="q2">
    <verse number="18" style="v" sid="ISA 2:18"/>ዋቆትን ቶልፈሞን ጉቱማን ጉቱት ንበርበዴፈሙ።<verse eid="ISA 2:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 2:19"/>ነሞትን ዮሙ እን ለፈ ራሱፍ ከኡት፣</para>
  <para style="q2" vid="ISA 2:19">ሶዳችሰ <char style="nd">ዋቀዮቲፊ</char></para>
  <para style="q1" vid="ISA 2:19">ሱራሳ ኡልፍነ ቀቤሰ ሰነ ዱራ</para>
  <para style="q2" vid="ISA 2:19">ገረ ሆልቀ ከታ ኬሳቲፊ</para>
  <para style="q2" vid="ISA 2:19">ቦለ ለፈ ኬሳት ንበቀቱ።<verse eid="ISA 2:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 2:20"/>ጋፈስ ነሞትን ዋቆተሳኒ ቶልፈሞ</para>
  <para style="q2" vid="ISA 2:20">ከኔን ዋቄፈቹፍ ጄዸኒ</para>
  <para style="q1" vid="ISA 2:20">ሜቲፊ ወርቄራ ቶልፈተን ሰነ</para>
  <para style="q2" vid="ISA 2:20">ቱቃፊ ስምብረ ሀልከኒቲፍ ደርበቱ።<verse eid="ISA 2:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 2:21"/>እሳን ዮሙ እን ለፈ ራሱፍ ከኡት</para>
  <para style="q2" vid="ISA 2:21">ሶዳችሰ <char style="nd">ዋቀዮቲፊ</char></para>
  <para style="q1" vid="ISA 2:21">ሱራ ኡልፍነሳ ዱራ ገረ ሆልቀ ጉዳ</para>
  <para style="q2" vid="ISA 2:21">ከታወን ኬሳቲፊ በቀቃ ከታት ንበቀቱ።<verse eid="ISA 2:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 2:22"/>ነመ ዱአ ህንኦሌ፣</para>
  <para style="q2" vid="ISA 2:22">ከን ሀፉርሳ ፉኛንረ ጅሩ አብደቹ ዺሳ።</para>
  <para style="q2" vid="ISA 2:22">እን ማልት ለካአመ?<verse eid="ISA 2:22"/></para>
  <chapter eid="ISA 2"/>
  <chapter number="3" style="c" sid="ISA 3"/>
  <para style="s1">ሙርቲ ዬሩሳሌሚፊ ይሁዳ ኤገቱ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 3:1"/>ኩኖ ጎፍታን፣</para>
  <para style="q2" vid="ISA 3:1">
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ</para>
  <para style="q1" vid="ISA 3:1">ዬሩሳሌሚፊ ይሁዳራ</para>
  <para style="q2" vid="ISA 3:1">ኬናፊ ገርጋርሰሳ</para>
  <para style="q1" vid="ISA 3:1">ከን ምዻኒቲፊ ከን ብሻኒ ሁንደ እራ ፉዸተ፤<verse eid="ISA 3:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="ISA 3:2"/>ጎታፊ ሎልቱ፣</para>
  <para style="q1" vid="ISA 3:2">አባ ሙርቲቲፊ ራጂ፣</para>
  <para style="q2" vid="ISA 3:2">ሆደ ህማፊ ማንጉዶ፣<verse eid="ISA 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 3:3"/>አጀጃ ሸንተማቲፊ ነመ ኡልፍነ ቀቡ፣</para>
  <para style="q2" vid="ISA 3:3">ጎርስቱ፣ ኦጌሰ ሆጂ ሀርካቲፊ <optbreak/> ኦጌሰ ዋ ደዌሱ ቤኩራ ፉዸተ።<verse eid="ISA 3:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 3:4"/>“አን ደርገጎተ ቆንዳልቶተሳኒ ነንጎዸ፤</para>
  <para style="q2" vid="ISA 3:4">እጆሌን እሳን ቡልቹ።”<verse eid="ISA 3:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 3:5"/>ነሞትን ወል ሀጩጩ፤</para>
  <para style="q2" vid="ISA 3:5">ነምን ቶኮ ነመ ካንት፣ ኦላንስ፣ ኦላሳት ከአ።</para>
  <para style="q1" vid="ISA 3:5">ደርገጌስ ጃርሰት፣</para>
  <para style="q2" vid="ISA 3:5">ቱፈተማንስ ከበጀማት ከአ።<verse eid="ISA 3:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 3:6"/>ነምን ቶኮ መነ አባሳት፣</para>
  <para style="q2" vid="ISA 3:6">ኦቦሎተሳ ኬሳ ቶኮ ቀቤ፣</para>
  <para style="q1" vid="ISA 3:6">“አት ቆሎ ቀብደ፤ ከናፉ ቡልቻ ኑፍ ተእ፤</para>
  <para style="q2" vid="ISA 3:6">ቱላ ዋን ዲገሜ ከነትስ እት ጋፈተመ ፉዹ!” ጄዸ።<verse eid="ISA 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 3:7"/>እን ገሩ ጋፈስ፣</para>
  <para style="q2" vid="ISA 3:7">“አን ፉርማተ ተኡ ህንደንደኡ።</para>
  <para style="q1" vid="ISA 3:7">አን ኛተ ዮካን ኡፈተ ቶኮሌ መነኮቲ ህንቀቡ፤</para>
  <para style="q2" vid="ISA 3:7">ቡልቻ ሰባ ነ ህንታስስና” ጄዼ እየ።<verse eid="ISA 3:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 3:8"/>ዬሩሳሌም ገተንተራ ጅርት፤</para>
  <para style="q2" vid="ISA 3:8">ይሁዳንሞ ኩፍቴርት፤</para>
  <para style="q1" vid="ISA 3:8">ዱቢሳኒቲፊ ጎችሳኒ <char style="nd">ዋቀዮን</char> ሞርሙዻን</para>
  <para style="q2" vid="ISA 3:8">ኡልፍነ አርገሙሳ ጡሬሰ።<verse eid="ISA 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 3:9"/>ሃል ፉለሳኒ ዹጋ እሳንት በአ፤</para>
  <para style="q2" vid="ISA 3:9">እሳን አኩመ ሶዶም ጩቡሳኒ እፈ ባሱ፤</para>
  <para style="q2" vid="ISA 3:9">እሳን ጩቡሳኒ ህንዾክፈተን።</para>
  <para style="q1" vid="ISA 3:9">እሳኒፍ ወዮ!</para>
  <para style="q2" vid="ISA 3:9">እሳን በላ ጉዳ ኦፍት ፍደኒሩ።<verse eid="ISA 3:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 3:10"/>አከ ወን ኩን እሳኒፍ ቶሉ ቀጄልቶተት ህማ፤</para>
  <para style="q2" vid="ISA 3:10">እሳን ቡኣ ሆጂሳኒ ኛቱ።<verse eid="ISA 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 3:11"/>ሀማዻፍ ወዮ!</para>
  <para style="q2" vid="ISA 3:11">በዲስን እሰት ንዹፈ!</para>
  <para style="q1" vid="ISA 3:11">እን ገቲ ሀርከሳ ንአርገተ።<verse eid="ISA 3:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 3:12"/>ደርገጎትን ሰበኮ ጩንቁርሱ፤</para>
  <para style="q2" vid="ISA 3:12">ዱበርቶትን እሳን ቡልቹ።</para>
  <para style="q1" vid="ISA 3:12">ያ ሰበኮ፣ ቀጄልችቶትንኬሰን ከራራ እስን ጀልእሰኒሩ፤</para>
  <para style="q2" vid="ISA 3:12">እሳንራ እስን ጎርሰኒሩ።<verse eid="ISA 3:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 3:13"/>
    <char style="nd">ዋቀዮ</char> ሙርቲ ኬኑፍ ታኤረ፤</para>
  <para style="q2" vid="ISA 3:13">ሰበ እሳትስ ሙሩፍ ከኤረ።<verse eid="ISA 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 3:14"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዼ</para>
  <para style="q2" vid="ISA 3:14">ማንጉዶታፊ ሆገንቶተ ሰበሳት ሙረ፦</para>
  <para style="q1" vid="ISA 3:14">“ከን እዶ ዻባ ወይኒኮቲ በሌሴ እስን፤</para>
  <para style="q2" vid="ISA 3:14">ወን ህዬዪራ ሳመሜ መነኬሰን ጅረ።<verse eid="ISA 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 3:15"/>እስን ሰበኮ ጨጨብሱንኬሰን፣</para>
  <para style="q2" vid="ISA 3:15">ፉለ ህዬዪስ ቡቱቹንኬሰን ማል ጎቹኬሰን?” ጄዸ ጎፍታን፣</para>
  <para style="q2" vid="ISA 3:15">
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ።<verse eid="ISA 3:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 3:16"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፤</para>
  <para style="q2" vid="ISA 3:16">“ዱበርቶትን ጥዮን ኦፍ ቱሉ፤</para>
  <para style="q1" vid="ISA 3:16">እሳን ሞርመ ዼሬፈተኒ ያኡ፤</para>
  <para style="q2" vid="ISA 3:16">እጃንስ ንዋመቱ፤</para>
  <para style="q2" vid="ISA 3:16">ፋየ ሚለሳኒ ክልልሳ ጭላንፈቻ ዴሙ።<verse eid="ISA 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 3:17"/>ከናፉ ጎፍታን መታ እንተለን ጥዮንት ቃቄ ንፍደ፤</para>
  <para style="q2" vid="ISA 3:17">
    <char style="nd">ዋቀዮ</char> ጉቤ መታሳኒ ሞሌሰ።”<verse eid="ISA 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 3:18"/>ጋፈስ ጎፍታን ፋየ ሚዸግነሳኒ፦ አልቡ፣ መረተ መታ፣ ፋየ ሞርማ ከን ባቲ ፈካቱ፣ <verse eid="ISA 3:18"/><verse number="19" style="v" sid="ISA 3:19"/>አመርቲ ጉራ፣ ብተዎ፣ ሀጉጊ ፉላ፣ <verse eid="ISA 3:19"/><verse number="20" style="v" sid="ISA 3:20"/>መረተ መታ፣ ፋየ ሚላ፣ ሰበተ፣ ብልቃጢ ሽቶ፣ ኩዻመ፣ <verse eid="ISA 3:20"/><verse number="21" style="v" sid="ISA 3:21"/>ቁቤላ ቻፓ፣ አመርቲ ፉኛኒ <verse eid="ISA 3:21"/><verse number="22" style="v" sid="ISA 3:22"/>ወንደቦ ፍለተማ፣ ኮፍያ፣ ቆሎ፣ ኮሮጆ ሀርካ፣ <verse eid="ISA 3:22"/><verse number="23" style="v" sid="ISA 3:23"/>ኦፍ እላሌወን፣ ወያ ቁንጬ ተልባራ ሆጄተሜ፣ ጎንፎ ዱበርቶታቲፊ ኡፈተ ሞርማ እሳንራ ሙልቀ።<verse eid="ISA 3:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 3:24"/>ቆደ ኡርጋ፣ አጃ፤</para>
  <para style="q2" vid="ISA 3:24">ቆደ ሰበታ፣ ፉኞ፤</para>
  <para style="q1" vid="ISA 3:24">ቆደ መታ ስሪት ዸአሜ፣ ሞሉ፤</para>
  <para style="q2" vid="ISA 3:24">ቆደ ኡፈተ ሚዸጋ፣ ወያ ገዳ፤</para>
  <para style="q2" vid="ISA 3:24">ቆደ ሚዸግና ፎክሱቱ ዹፈ።<verse eid="ISA 3:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 3:25"/>ነሞትንኬሰን ጎራዴዻን፣</para>
  <para style="q2" vid="ISA 3:25">ሎልቶትንኬሰንስ ሎለ ኬሰት ዹሙ።<verse eid="ISA 3:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 3:26"/>ከር ጥዮን ፋርስቴ ቦስ፤</para>
  <para style="q2" vid="ISA 3:26">እሼን ኦንቴ ለፈ ቴስ።<verse eid="ISA 3:26"/></para>
  <chapter eid="ISA 3"/>
  <chapter number="4" style="c" sid="ISA 4"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 4:1"/>በረ ሰነ ኬሰ ዱበርቶትን ቶርበ</para>
  <para style="q2" vid="ISA 4:1">ነመ ቶክቸ ቀበተኒ፣</para>
  <para style="q1" vid="ISA 4:1">“ኑ ኛቱመኬኘ ኛትነ፤</para>
  <para style="q2" vid="ISA 4:1">ኡፈተኬኘ ኡፈትነ፤</para>
  <para style="q1" vid="ISA 4:1">ገሩ መቃኬቲን ሃዋመምኑ።</para>
  <para style="q2" vid="ISA 4:1">ሰልጵነኬኘ ኑራ ፈጌስ!” ጄዹን።<verse eid="ISA 4:1"/></para>
  <para style="s1">ደሜ <char style="nd">ዋቀዮ</char></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 4:2"/>በረ ሰነ ኬሰ ደሜን <char style="nd">ዋቀዮ</char> በሬዴ ኡልፍነ ቀባተ፤ እጅ ለፋስ ሀምባ እስራኤሊፍ ዋን እሳን እቲን ቦነኒፊ ኡልፍነ ተአ። <verse eid="ISA 4:2"/><verse number="3" style="v" sid="ISA 4:3"/>ወር ጥዮን ኬሰት ሀፈን፣ ወር ዬሩሳሌም ኬሰት ሀምብፈመን፣ ወር ነሞተ ዬሩሳሌም ኬሰ ጅራተን ኬሰት ገልሜፈመን ሁንድ ቁልቁሎተ ጄዸመኒ ንዋመሙ። <verse eid="ISA 4:3"/><verse number="4" style="v" sid="ISA 4:4"/>ጎፍታን ጡሪ ዱበርቶተ ጥዮን እራ ዽቀ፤ እን ዬሩሳሌምራ ሀፉረ ሙርቲቲፊ ሀፉረ እብዳቲን ዺገ ንቁልቁሌሰ። <verse eid="ISA 4:4"/><verse number="5" style="v" sid="ISA 4:5"/>ኤርገሲስ <char style="nd">ዋቀዮ</char> ጉቱማ ቱሉ ጥዮኒፊ ወረ አችት ወልት ቀበመን ሁንዳረት ጉያዻን ዱሜሰ ኣራ፣ ሀልከኒንሞ እፈ አረበ እብዳ ንኡመ፤ ኡልፍነ ሰነ ሁንደረ ዱንካነቱ ጅራተ። <verse eid="ISA 4:5"/><verse number="6" style="v" sid="ISA 4:6"/>እንስ ሆአ ጉያራ ደኦፊ ጋድሰ፣ እዶ ቡቤ ሀማፊ ቦካ ጀላ እት በቀተኒፊ እዶ እት ዾከተን ተአ።<verse eid="ISA 4:6"/></para>
  <chapter eid="ISA 4"/>
  <chapter number="5" style="c" sid="ISA 5"/>
  <para style="s1">ፋርፈትና እዶ ዻበ ወይኒ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 5:1"/>አን ነመን ጃለዹ ሰናፍ፣</para>
  <para style="q2" vid="ISA 5:1">ፋርፈትና ዋኤ እዶ ዻባ ወይኒሳ ነንፋርፈዸ፦</para>
  <para style="q1" vid="ISA 5:1">ምቹንኮ ጋረ ገበታራ</para>
  <para style="q2" vid="ISA 5:1">እዶ ዻባ ወይኒ ቀበ።<verse eid="ISA 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 5:2"/>እንስ ለፈ ሰነ ቆቴ እሰራ ዸጋ በሌሴ</para>
  <para style="q2" vid="ISA 5:2">ወይኒ ፍለተማ እሰረ ዻቤ።</para>
  <para style="q1" vid="ISA 5:2">ቆጢ ኤጉምሳ እሰ ኬሰት እጃሬ</para>
  <para style="q2" vid="ISA 5:2">ቦለ ወይኒ እት ጩንፈንሌ ቆቴ።</para>
  <para style="q1" vid="ISA 5:2">ኤርገሲ አከ ለፍት ቆቲሳ ሱን እጀ ጋሪ ኬኑ ኤገቴ፤</para>
  <para style="q2" vid="ISA 5:2">እን ገሩ እጀ ሀማ ቆፈ ኬኔ።<verse eid="ISA 5:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 5:3"/>“ያ ጅራቶተ ዬሩሳሌሚፊ ሰበ ይሁዳ፣</para>
  <para style="q2" vid="ISA 5:3">ሜ ዱቢ አናፊ እዶ ዻባ ወይኒኮ <optbreak/> ግዱ ጅሩፍ ሙርቲ ኬና።<verse eid="ISA 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 5:4"/>ዋን አን ጎዼፍ ከነ ጫላ</para>
  <para style="q2" vid="ISA 5:4">ወን እዶ ዻባ ወይኒኮቲፍ ጎዸሙ መሉ ማል?</para>
  <para style="q1" vid="ISA 5:4">ዬሮ አን እጀ ወይኒ ጋሪ በርባዴት</para>
  <para style="q2" vid="ISA 5:4">እን ማሊፍ እጀ ሀዻኣ ቆፈ ነቀቴ?<verse eid="ISA 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 5:5"/>አን አመ ዋነን እዶ ዻባ ወይኒኮ ጎቹፍ ጅሩ</para>
  <para style="q2" vid="ISA 5:5">እስንት ነንህመ፤</para>
  <para style="q1" vid="ISA 5:5">አን ደላሳ ነንዲገ፤</para>
  <para style="q2" vid="ISA 5:5">እንስ ንበደ፤</para>
  <para style="q1" vid="ISA 5:5">ደላሳ ዸጋ ነንጅግሰ፤</para>
  <para style="q2" vid="ISA 5:5">እንስ ገድ ዽዺተመ።<verse eid="ISA 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 5:6"/>አን እሰ ነንኦንሰ፤</para>
  <para style="q2" vid="ISA 5:6">ሙክን ወይኒሳስ ህንቆረሙ ዮካን ለፍትሳ ህንቆተሙ።</para>
  <para style="q1" vid="ISA 5:6">ሶኮሩፊ ቆራቲን አች ኬሰት ጉደተ።</para>
  <para style="q2" vid="ISA 5:6">አን አከ ቦካን እት ህንሮብኔፍ ዱሜሰ ነንአጀጀ።”<verse eid="ISA 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 5:7"/>እዶን ዻባ ወይኒ</para>
  <para style="q2" vid="ISA 5:7">
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ መነ እስራኤል፤</para>
  <para style="q1" vid="ISA 5:7">ነሞትን ይሁዳሞ</para>
  <para style="q2" vid="ISA 5:7">እዶ ብቅልቱ እን እት ገመዱዸ።</para>
  <para style="q1" vid="ISA 5:7">እን ሙርቲ ቀጄላ በርባዴ፤</para>
  <para style="q2" vid="ISA 5:7">ገሩ ዺገ ዸንገላፈሙ አርጌ፤</para>
  <para style="q1" vid="ISA 5:7">ቀጄሉማ በርባዴ፤</para>
  <para style="q2" vid="ISA 5:7">ገሩ እየ ወረ ሚዸሜ ዸገኤ።<verse eid="ISA 5:7"/></para>
  <para style="s1">ወዮፊ ሙርቲ</para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 5:8"/>እስን ወረ ሀመ እዶን</para>
  <para style="q2" vid="ISA 5:8">ቶኮዩ ህንሀፍኔት መነረት መነ፣</para>
  <para style="q1" vid="ISA 5:8">ለፈ ቆቲሳረት ለፈ ቆቲሳ ደበለተኒ</para>
  <para style="q2" vid="ISA 5:8">ኮጱመኬሰን ብየ ኬሰ ጅራተኒፍ ወዮ!<verse eid="ISA 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 5:9"/>
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ ኡቱመ አን ዸገኡ አከነ ጄዼ ዱበቴ፦</para>
  <para style="q1" vid="ISA 5:9">“ዹጉማን መኔን ሄዱን ንኦኑ፤</para>
  <para style="q2" vid="ISA 5:9">መኔን ጉርጉዳኒፊ በበሬዶን ነመ ኬሰ ጅራቱ ዸቡ።<verse eid="ISA 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 5:10"/>እዶ ዻባ ወይኒ ጭምዲ ኩዸንራ ዳዺ ወይኒ <optbreak/> ባዶሲ ቶኮ ቆፈቱ ገልፈመ፤</para>
  <para style="q2" vid="ISA 5:10">ሰኚ ቆሮሲ ቶኮራ ምዻን ኢፊ ቶኮ ቆፈቱ ገልፈመ።”<verse eid="ISA 5:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 5:11"/>ወረ ዹጋቲ በርባቻፍ ገነማን ከአን፣</para>
  <para style="q2" vid="ISA 5:11">ከኔን ሀመ ዳዺ ወይኒቲን መቻአንት</para>
  <para style="q2" vid="ISA 5:11">ሀልከን ዼሬፈተኒፍ ወዮ።<verse eid="ISA 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 5:12"/>እሳን ጭዸሳኒረት በገና፣ ክራራፊ ድቤ፣</para>
  <para style="q2" vid="ISA 5:12">ኡሉሌፊ ዳዺ ወይኒ ቀቡ፤</para>
  <para style="q1" vid="ISA 5:12">ገሩ ሆጂ <char style="nd">ዋቀዮቲፍ</char> ዽመ ህንቀበን፤</para>
  <para style="q2" vid="ISA 5:12">ሆጂ ሀርከሳቲፍስ ኡልፍነ ህንኬነን።<verse eid="ISA 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 5:13"/>ከናፉ ሰብንኮ</para>
  <para style="q2" vid="ISA 5:13">ሰበቢ ሁበትና ዸቤፍ ቦጅአመ፤</para>
  <para style="q1" vid="ISA 5:13">ነሞትንሳኒ ቤቤከሞን ቤላን፣</para>
  <para style="q2" vid="ISA 5:13">ኡመትንሳኒስ ዼቡዻን ዹሙ።<verse eid="ISA 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 5:14"/>ከናፉ ሲኦል ገራሳ በልእፈቴ</para>
  <para style="q2" vid="ISA 5:14">አፋን ኦፊሳሌ ሀመ መሌ በነተ፤</para>
  <para style="q1" vid="ISA 5:14">ነሞትንሳኒ ቤቤከሞኒፊ ኡመትንሳኒ</para>
  <para style="q2" vid="ISA 5:14">ወር ወጨኒፊ ወር ገመደን ሁንድስ አች ኬሰ ቡኡ።<verse eid="ISA 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 5:15"/>ከናፉ ነምን ገድ ቀበመ፤</para>
  <para style="q2" vid="ISA 5:15">እልማን ነማ ገድ ዴብፈሙ፤</para>
  <para style="q2" vid="ISA 5:15">እጅ ኦፍ ቱልቶታስ ለፈ እላለ።<verse eid="ISA 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 5:16"/>
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ ገሩ</para>
  <para style="q2" vid="ISA 5:16">ሙርቲ ቀጄላ ኦፊሳቲን ኦል ኦል ጄዸ፤</para>
  <para style="q1" vid="ISA 5:16">ዋቅን ቁልቁሉን ቀጄሉማ ኦፊሳቲን</para>
  <para style="q2" vid="ISA 5:16">አከ ቁልቁሉ ተኤ ኦፍ አርግሲሰ።<verse eid="ISA 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 5:17"/>ዬሮ ሰነት ሆሎትን አኩመ ዋን <optbreak/> ለፈ ዼደሳኒ ኬሰ ጅረኒት ንዼዱ፤</para>
  <para style="q2" vid="ISA 5:17">ጦባላወን ሆላስ እዶ ሶሬዪን እት በርበዳአን ኬሰ ዼዱ።<verse eid="ISA 5:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 5:18"/>ወረ ፉኞ ጎዎምሳቲን ጩቡ፣</para>
  <para style="q2" vid="ISA 5:18">ፉኞ ጋሪቲንስ ሀምነ ሀርክሰን፣<verse eid="ISA 5:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 5:19"/>ከኔን፣ “ዋቅን ሃአሪፈቱ፤</para>
  <para style="q2" vid="ISA 5:19">አከ ኑ አርግኑፍ እን ሆጂ ኦፊሳ ሃሰፍሲሱ፣</para>
  <para style="q1" vid="ISA 5:19">ወን ኩን ሃዽኣቱ፤</para>
  <para style="q2" vid="ISA 5:19">አከ ኑ ቤክኑፍስ</para>
  <para style="q2" vid="ISA 5:19">ከሮር ቁልቁልቸ እስራኤል ሃዹፉ” <optbreak/> ጄዸኒፍ ወዮ።<verse eid="ISA 5:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 5:20"/>ወረ ሀማዻን ጋሪ፣</para>
  <para style="q2" vid="ISA 5:20">ጋሪዻንሞ ሀማ ጄዸኒፍ፣</para>
  <para style="q1" vid="ISA 5:20">ከኔን እፋን ዱከነ፣</para>
  <para style="q2" vid="ISA 5:20">ዱከናንሞ እፈ ጄዸኒፍ፣</para>
  <para style="q1" vid="ISA 5:20">ወረ ምኣዋዻን ሀዻኣ፣</para>
  <para style="q2" vid="ISA 5:20">ሀዻኣዻንሞ ምኣዋ ጄዸኒፍ ወዮ።<verse eid="ISA 5:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 5:21"/>ወረ አከ ያደሳኒት ኦጌዪ፣</para>
  <para style="q2" vid="ISA 5:21">አከ እላልቸሳኒትሞ አብሻለ ኦፍ ሴአኒፍ ወዮ።<verse eid="ISA 5:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 5:22"/>ወረ ዳዺ ወይኒ ዹጉት ጀባ፣</para>
  <para style="q2" vid="ISA 5:22">ዹጋቲ ወልት መኩትስ ጎተ ተአኒፍ፣<verse eid="ISA 5:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 5:23"/>ወረ መተኣ ፉዸተኒ የከማ ገድ ለክሰኒፍ፣</para>
  <para style="q2" vid="ISA 5:23">ሙርቲ ነመ በሌሳ ህንቀብኔሞ ጀልእሰኒፍ ወዮ።<verse eid="ISA 5:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 5:24"/>ከናፉ አኩመ አረብን እብዳ ጭዲ ለፈራ አራቡ፣</para>
  <para style="q2" vid="ISA 5:24">አኩመ ኦካን እብዳን ጉበቴ በዱ ሰነ ህድሳኒ ንቶርቶረ፤</para>
  <para style="q2" vid="ISA 5:24">ደራራንሳኒስ አኩመ አዋራ ብትናኤ በደ፤</para>
  <para style="q1" vid="ISA 5:24">እሳን ሴረ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ ድደኒ</para>
  <para style="q2" vid="ISA 5:24">ዱቢ ቁልቁልቸ እስራኤል ቱፈተኒሩቲ።<verse eid="ISA 5:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 5:25"/>ከናፉ ዼከምስ <char style="nd">ዋቀዮ</char> ሰበሳት ንቦበአ፤</para>
  <para style="q2" vid="ISA 5:25">ሀርክሳ ኦል ከኤ እሳን ሩኩተ።</para>
  <para style="q1" vid="ISA 5:25">ቱሉወን ንራፈሙ፤</para>
  <para style="q2" vid="ISA 5:25">ሬፍሳኒስ አኩመ ኮሲ ዳንዲረት ገተሜ ተአ።</para>
  <para style="b" vid="ISA 5:25"/>
  <para style="q1" vid="ISA 5:25">ከነ ሁንዳንሌ ዼከምስሳ ህንቀበኖፍኔ፤</para>
  <para style="q2" vid="ISA 5:25">ሀርክሳስ አኩመ ኦል ካፈሜት ጅረ።<verse eid="ISA 5:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 5:26"/>እን ሰቦተ ፈጎ ጅረኒፍ ፋጂ ኦል ቀበ፤</para>
  <para style="q2" vid="ISA 5:26">ወረ ሞጋ ለፋ ጅረንት ንሲቅሰ።</para>
  <para style="q2" vid="ISA 5:26">እሳንስ ኩኖ አሪፈተኒ ደፈኒ ዹፉ።<verse eid="ISA 5:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 5:27"/>እሳን ኬሳ ነምን ቶኮዩ ህንደዸቡ ዮካን ህንጉፈቱ፤</para>
  <para style="q2" vid="ISA 5:27">ነምን ቶኮዩ ህንሙጉ ዮካን ህንረፉ፤</para>
  <para style="q1" vid="ISA 5:27">ሰበትን ሙዺሳኒ ህንላፉ፤</para>
  <para style="q2" vid="ISA 5:27">ህዻን ኮጴሳኒስ ህንጭቱ።<verse eid="ISA 5:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 5:28"/>ጥይሳኒ ቀረማዸ፤</para>
  <para style="q2" vid="ISA 5:28">እዳንሳኒ ሁንድ ቆጴፈሜረ፤</para>
  <para style="q1" vid="ISA 5:28">ኮቴን ፈርዴንሳኒ አኩመ ዸጋ ቀረ ቀቡት፤</para>
  <para style="q2" vid="ISA 5:28">ጎማን ጋሪሳኒስ አኩመ ቡቤ ሀማት።<verse eid="ISA 5:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 5:29"/>ኣዱንሳኒ አኩመ ኣዱ ሌንጫት፤</para>
  <para style="q2" vid="ISA 5:29">እሳን አኩመ ሳፌለ ሌንጫ ኣዱ፤</para>
  <para style="q1" vid="ISA 5:29">ዬሮ ዋን አደምሰተን ቀበተንት ንጉሩርኡ፤</para>
  <para style="q2" vid="ISA 5:29">እሳን ዋን ቀበተን ፉዸተኒ ዴሙ፤</para>
  <para style="q2" vid="ISA 5:29">ነምን እሳን ሀርካ ቡሱ ደንደኡስ ህንጅሩ።<verse eid="ISA 5:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 5:30"/>ጋፈስ እሳን አኩመ ሁርሳ ገላና</para>
  <para style="q2" vid="ISA 5:30">ዋን ሰነራ ሁርሱ።</para>
  <para style="q1" vid="ISA 5:30">ነምን ቶኮ ዮ ብየ ሰነ እላሌ፣</para>
  <para style="q2" vid="ISA 5:30">እን ዱከናፊ ረክነ አርገ፤</para>
  <para style="q2" vid="ISA 5:30">አዱንስ ዱሜሳን ዱከኔፈመ።<verse eid="ISA 5:30"/></para>
  <chapter eid="ISA 5"/>
  <chapter number="6" style="c" sid="ISA 6"/>
  <para style="s1">ኤርገመ እሳያስ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 6:1"/>በረ ኡዝያን ሞትች ዱኤ ኬሰ፣ አን ኡቱ ጎፍታን ቴሶ ኦል ዼራፊ ኡልፍነ ቀቤሰረ ታኤ፣ ሀንዳር ኡፈተሳ መነ ቁልቁሉማ ጉቴ ጅሩ ነንአርጌ። <verse eid="ISA 6:1"/><verse number="2" style="v" sid="ISA 6:2"/>እሳ ኦልትስ ሱራፌሎተ ቶኮን ቶኮንሳኒ ቆቾ ጀአ ጀአ ቀበንቱ ቱሬ፤ እሳንስ ቆቾ ለማን ፉለሳኒ ሀጉገቱ፤ ቆቾ ለማን ሚለሳኒ ሀጉገቱ፤ ቆቾ ለማንሞ ንበርሱ ቱረን። <verse eid="ISA 6:2"/><verse number="3" style="v" sid="ISA 6:3"/>እሳንስ፦</para>
  <para style="q1" vid="ISA 6:3">“<char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ <optbreak/> ቁልቁሉ፣ ቁልቁሉ፣ ቁልቁሉዸ፤</para>
  <para style="q2" vid="ISA 6:3">ለፍት ሁንድኑ ኡልፍነሳቲን ጉተምቴርት”</para>
  <para style="m" vid="ISA 6:3">ጄዸኒ ወልት ለለባ ቱረን። <verse eid="ISA 6:3"/><verse number="4" style="v" sid="ISA 6:4"/>ሰገሌሳኒቲን ሁንዴን ዻበ በልበላ ንራፈሜ፤ መን ቁልቁሉማስ ኣራን ጉተሜ።<verse eid="ISA 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 6:5"/>አንስ አከነ ጄዼን እዬ፤ “አናፍ ወዮ! አን በዴ! አን ነመ ህዺ ጡራኣ ከን ነሞተ ህዺ ጡራኣ ቀበን ግዱ ጅራቱዻቲ፤ እጅኮ ሞትቸ፣ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ አርጌራቲ።”<verse eid="ISA 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 6:6"/>ሱራፌሎተ ኬሳ እን ቶኮ ጭሌ ቦበኡ ከን ቀብዱዻን እዶ ኣርሳራ ፉዼ ቶኮ ሀርከት ቀበቴ ገረኮት በርሴ። <verse eid="ISA 6:6"/><verse number="7" style="v" sid="ISA 6:7"/>እንስ ጭሌ ሰናን አፋንኮ ቱቄ፣ “እላል፣ ወን ኩን ህዺኬ ቱቄረ፤ በሌሳንኬ ስራ ፉዸሜረ፤ ጩቡንኬስ ሲፍ ዺፈሜረ” ጄዼ።<verse eid="ISA 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 6:8"/>አንስ ሰገሌ ጎፍታ ከን፣ “አን ኤኙነን ኤርገዸ? ኤኙቱ ኑፍ ዴመ?” ጄዹ ነንዸገኤ።</para>
  <para style="p" vid="ISA 6:8">ከነረት አን፣ “ኩኖ አኑ ጅረ። ነ ኤርግ!” ነንጄዼ።<verse eid="ISA 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 6:9"/>እንስ፣ “ዸቂቲ አከነ ጄዺ ሰበ ከነት ህም፦</para>
  <para style="q1" vid="ISA 6:9">“ ‘ዸገኡ ንዸጌሱ፤ ገሩ ህንሁበተን፤</para>
  <para style="q2" vid="ISA 6:9">አርጉስ እኑመ አርግቱ፤ ገሩ ህንቀልቤፈተን!’<verse eid="ISA 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 6:10"/>ቀልቢ ሰበ ከና ዶምስ፤</para>
  <para style="q2" vid="ISA 6:10">ጉረሳኒ ጩቃል፤</para>
  <para style="q2" vid="ISA 6:10">እጀሳኒስ ጩፍ።</para>
  <para style="q1" vid="ISA 6:10">ዮ ከና አቺ እሳን እጀ ኦፊሳኒቲን አርገኒ</para>
  <para style="q2" vid="ISA 6:10">ጉረሳኒቲን ዸገአኒ</para>
  <para style="q2" vid="ISA 6:10">ቀልቢሳኒቲን ሁበተኒ ዴብአኒ ፈዩ።”<verse eid="ISA 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 6:11"/>አን፣ “ያ ጎፍታ፣ ወን ኩን ሀመ ዮሚት አከነ ተአ?” ነንጄዼ።</para>
  <para style="p" vid="ISA 6:11">እንስ አከነ ጄዼ ዴብሴ፦</para>
  <para style="q1" vid="ISA 6:11">“ሀመ መጋላወን ዲገመኒ</para>
  <para style="q2" vid="ISA 6:11">ነመ እሳን ኬሰ ጅራቱ ዸበንት፣</para>
  <para style="q1" vid="ISA 6:11">ሀመ መኔን ኦነኒ ለፍት ቆቲሳስ</para>
  <para style="q2" vid="ISA 6:11">በርበዳኤ ዱዋ ሀፉት፣<verse eid="ISA 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 6:12"/>ሀመ <char style="nd">ዋቀዮ</char> ነመ ሁንደ ፈጌሴ</para>
  <para style="q2" vid="ISA 6:12">ለፍት ሱን ጉቱማን ጉቱት ደገተሙት ተአ።<verse eid="ISA 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 6:13"/>ኩዸን ኬሳ ቶኮ ዮ ሀፌዩ፣</para>
  <para style="q2" vid="ISA 6:13">ብይ ሱን አመሌ ዴብቴ ኦንት።</para>
  <para style="q1" vid="ISA 6:13">ገሩ አኩመ ሙክን ላፍቶቲፊ ቅልጡ፣</para>
  <para style="q2" vid="ISA 6:13">ዮ ሙረን ጉፉንሳ ለቱ ሰነ</para>
  <para style="q2" vid="ISA 6:13">አከሱመ ሰኚን ቁልቁሉን ጉፉ ተኤ አችት ሀፈ።”<verse eid="ISA 6:13"/></para>
  <chapter eid="ISA 6"/>
  <chapter number="7" style="c" sid="ISA 7"/>
  <para style="s1">መለቶ አማኑኤል</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 7:1"/>በረ ኣሃዝ እልም ዮታም፣ እልም ኡዝያን ሞቲ ይሁዳ ቱሬት፣ ሬዚን ሞትች ሶርያቲፊ ጴቃን እልም ሬማልያ ሞትች እስራኤል ዬሩሳሌሚን ሎሉፍ እት ዱለን፤ ገሩ እሼ ሞአቹ ህንደንዴኜ።<verse eid="ISA 7:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 7:2"/>ዬሮ ከነትስ፣ “ሶርያን ኤፍሬም ወጅን ቶኩማ ኡመቴርት” ጄዸኒ መነ ዳዊትት ህመን፤ ከናፉ ገራን ኣሃዚቲፊ ገራን ሰበሳ አኩመ ሙክን ቦሶና ቡቤዻን ራፈሙ ሰነ ራፈሜ።<verse eid="ISA 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 7:3"/>ከነረት <char style="nd">ዋቀዮ</char> እሳያሲን አከነ ጄዼ፤ “አቲፊ እልምኬ ሼአር-ያሹብ ዹመ ጀልእሲ ሀሮ ኦል ኣኑ ከን ከራ ለፈ ቆቲሳ ነምቸ ወያ ሚጩት ጌሱ ሰነ ብረት ኣሃዝን ስመቹፍ ገድ በኣ። <verse eid="ISA 7:3"/><verse number="4" style="v" sid="ISA 7:4"/>አከነ ጄዺን፤ ‘ኦፍ ኤገዹ፤ ጨልእስ፤ ህንሶዳትን። አት ሰበቢ ጉፉወን ሙከ እብዳ ከኔን ሴቃ ጅረን ለማን ከኔኒቲፍ ጄቹንስ ሰበቢ ኣሪ ሬዚን ከን ሶርያቲፊ ኣሪ እልመ ሬማልያ ሀማ ሰናቲፍ ጄቴ አብዲ ህንኩተትን። <verse eid="ISA 7:4"/><verse number="5" style="v" sid="ISA 7:5"/>ሶርያን፣ ኤፍሬሚፊ እልም ሬማልያ አከነ ጄዸኒ በዲሰኬቲፍ መርአተኒሩ፤ <verse eid="ISA 7:5"/><verse number="6" style="v" sid="ISA 7:6"/>“ኮታ ይሁዳት ዱላ፤ ኮታ እሼ ኩኩትኔ ገርገር ቆደትና፤ እልመ ጣብኤልስ እሼረት ሞስፈትና።” <verse eid="ISA 7:6"/><verse number="7" style="v" sid="ISA 7:7"/>ተኡስ <char style="nd">ዋቀዮ</char> ጎፍታን አከነ ጄዸ፦</para>
  <para style="q1" vid="ISA 7:7">“ ‘ወን ኩን ህንራወቱ፤</para>
  <para style="q2" vid="ISA 7:7">ወን ኩን ህንተኡ፤<verse eid="ISA 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 7:8"/>መታን ሶርያ ደማስቆዻቲ፤</para>
  <para style="q2" vid="ISA 7:8">መታን ደማስቆሞ ሬዚኒዸ።</para>
  <para style="q1" vid="ISA 7:8">ወጋ ጃተሚ ሸን ኬሰት፣</para>
  <para style="q2" vid="ISA 7:8">ኤፍሬም ንብትናአ፤ ሰበ ቶኮ ተኡንሳስ ንሀፈ።<verse eid="ISA 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 7:9"/>መታን ኤፍሬም ሰማርያዸ፤</para>
  <para style="q2" vid="ISA 7:9">መታን ሰማርያሞ እልመ ሬማልያት።</para>
  <para style="q1" vid="ISA 7:9">እስን ዮ አመንቲኬሰኒን ጀባተኒ ዻበቹ ባተን፤</para>
  <para style="q2" vid="ISA 7:9">ዮምዩ ህንዻበተን።’ ”<verse eid="ISA 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 7:10"/>
    <char style="nd">ዋቀዮ</char> አመሌ አከነ ጄዼ ኣሃዝት ዱበቴ፤ <verse eid="ISA 7:10"/><verse number="11" style="v" sid="ISA 7:11"/>“ቅሌ አከ መሌ ገድ ፈጎ ኬሰት ዮካን ሰሚ አከ መሌ ኦል ፈጎ ኬሰት፣ <char style="nd">ዋቀዮን</char> ዋቀኬ መለቶ ጋፈዹ።”<verse eid="ISA 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 7:12"/>ኣሃዝ ገሩ፣ “አን ህንጋፈዹ፤ <char style="nd">ዋቀዮንስ</char> ህንቆሩ” ጄዼ።<verse eid="ISA 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 7:13"/>እሳያስስ አከነ ጄዼ፤ “ያ መነ ዳዊት ሜ ዸገኣ! እስን ኦብሰ ነማ ቆሩን እስን ሀንቀቴ ኦብሰ ዋቀኮ ቆርቱ? <verse eid="ISA 7:13"/><verse number="14" style="v" sid="ISA 7:14"/>ከናፉ ጎፍታን መታንሳ መለቶ እስኒፍ ኬነ፦ ኩኖ ዱርብ ቶኮ ንኡልፎፍት፤ እልመ ንዴስ፤ አማኑኤል ጄቴስ እሰ ሞጋፍት። <verse eid="ISA 7:14"/><verse number="15" style="v" sid="ISA 7:15"/>እን ዬሮ ዋን ሀማ ለገቴ ዋን ጋሪ ፍለቹ ቤኩት እትቱፊ ደመ ኛተ። <verse eid="ISA 7:15"/><verse number="16" style="v" sid="ISA 7:16"/>ገሩ ኡቱ ሙጫን ሱን ዋን ሀማ ለገቴ ዋን ጋሪ ፍለቹ ህንቤክን ዱረ ብይ ሞቶተ ለማን አት ሶዳቴ ሰና ንኦነ። <verse eid="ISA 7:16"/><verse number="17" style="v" sid="ISA 7:17"/><char style="nd">ዋቀዮ</char> ኤርገ ኤፍሬም ይሁዳራ ጭቴ ጀልቀቤ በረ ተኩማ ተኤ ህንቤክን ቶኮ ስት፣ ሰበኬቲፊ መነ አባኬቲት ንፍደ፤ ጄቹንስ ሞቲ አሶር ንፍደ።”<verse eid="ISA 7:17"/></para>
  <para style="s1">አሶር፣ ሜሻ <char style="nd">ዋቀዮ</char></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 7:18"/>በረ ሰነ ኬሰ <char style="nd">ዋቀዮ</char> ትሲሶተ ቡርቃ ለገ ግብጥ ኬሰ ጅረኒፊ ከኒሶተ ብየ አሶር ሲቅሴ ዋመ። <verse eid="ISA 7:18"/><verse number="19" style="v" sid="ISA 7:19"/>ሁንድሳኒ ዹፈኒ ዾቀ ለፋ ኬሰ፣ ሆልቀ ከታ ኬሰ፣ ደገለ ቆራቲቲፊ ቦለ ብሻኒ ሁንደ ኬሰ ቁበቱ። <verse eid="ISA 7:19"/><verse number="20" style="v" sid="ISA 7:20"/>በረ ሰነ ኬሰ ጎፍታን ሃዱ ለገ ገማ ክሬፈቴን ጄቹንስ ሞቲን አሶር ርፌንሰ መታኬሰኒ ርፌንሰ ሚለኬሰኒቲፊ አሬደኬሰን ንሃደ። <verse eid="ISA 7:20"/><verse number="21" style="v" sid="ISA 7:21"/>በረ ሰነ ኬሰ ነምን ቶኮ ጎሮምሰ ቶኮፊ ሆላ ለመ ቀባተ። <verse eid="ISA 7:21"/><verse number="22" style="v" sid="ISA 7:22"/>ሰበቢ ባይእነ ኣነን እሳን ኬነኒፍ፣ እን እትቱ ሶረቱ ቀባተ። ነምን ብየ ሰነት ሀፉ ሁንድኑ እትቱፊ ደመ ኛተ። <verse eid="ISA 7:22"/><verse number="23" style="v" sid="ISA 7:23"/>በረ ሰነ ኬሰ፣ ለፈ ሙኬን ወይኒ ኩምን ቶኮ ከኔን ሜቲ ሰቅሊ ኩመ ባሰን ጅረን ሁንደረ ሶኮሩፊ ቆራቲ ቆፈቱ ጅራተ። <verse eid="ISA 7:23"/><verse number="24" style="v" sid="ISA 7:24"/>ሰበቢ ለፍት ሱን ሶኮሩፊ ቆራቲን ጉተሜፍ፣ ነሞትን እዳፊ ጥየ ቀበተንዩ አች ዸቁ። <verse eid="ISA 7:24"/><verse number="25" style="v" sid="ISA 7:25"/>አት ሰበቢ ሶኮሩፊ ቆራቲ ሶዳቱፍ ስአች ገረ ጋረን ከናን ዱረ ገሶን ሶቀማ ቱረን ሰና ህንዸቅጡ፤ እሳን ለፈ ሎን እት ቦበአኒፊ ለፈ ሆሎትን ኬሰ ቡራቀን ተኡ።<verse eid="ISA 7:25"/></para>
  <chapter eid="ISA 7"/>
  <chapter number="8" style="c" sid="ISA 8"/>
  <para style="s1">እሳያሲፊ እጆሌሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 8:1"/>
    <char style="nd">ዋቀዮ</char> አከነ ናን ጄዼ፤ “ገበቴ ጉዳ ቶኮ ፉዺቲ እሰረት፣ ‘መሄር-ሻላል-ሃሽ-ባዝ’<note caller="+" style="f"><char style="fr" closed="false">8፥1 </char><char style="fq" closed="false">መሄር-ሻላል-ሃሽ-ባዝ </char><char style="ft" closed="false">ጄቹን </char><char style="fqa" closed="false">ደፊ ቦጅእ፤ አሪፈዹ ሳም </char><char style="ft" closed="false">ጄቹዸ።</char></note> ጄዺ ቁቤ ቤከማዻን በሬስ።” <verse eid="ISA 8:1"/><verse number="2" style="v" sid="ISA 8:2"/>አንስ አከ እሳን ዹገ ባቶተ አመነሞ ተአኒፍ ኡርያ ሉብቻፊ ዘካርያስ እልመ ዬቤሬክያ ነንዋመዸ። <verse eid="ISA 8:2"/><verse number="3" style="v" sid="ISA 8:3"/>አንስ ራጅቲ ብረ ነንገኤ፤ እሼንስ ኡልፎፍቴ እልመ ዴሴ። <char style="nd">ዋቀዮ</char> አከነ ናን ጄዼ፤ “መቃሳ መሄር-ሻላል-ሃሽ-ባዝ ጄዺ ሞጋስ። <verse eid="ISA 8:3"/><verse number="4" style="v" sid="ISA 8:4"/>ኡቱ ሙጫን ኩን ‘ኣቦ’ ዮካን ‘ኣዮ’ ጄቹ ህንቤክን ዱረ ቀቤኝ ደማስቆቲፊ ቦጁን ሰማርያ ሞቲ አሶሪን ፉዸተመ።”<verse eid="ISA 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 8:5"/>
    <char style="nd">ዋቀዮ</char> አመስ አከነ ጄዼ ነት ዱበቴ፦<verse eid="ISA 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 8:6"/>“ሰብን ኩን ብሻን ሽሎኣ</para>
  <para style="q2" vid="ISA 8:6">ከን ሱተ ያኡ ሰነ ዺሴ</para>
  <para style="q1" vid="ISA 8:6">ሬዚኒፊ እልመ ሬማልያት</para>
  <para style="q2" vid="ISA 8:6">ገመዴራቲ፤<verse eid="ISA 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 8:7"/>ከናፉ ጎፍታን፣</para>
  <para style="q2" vid="ISA 8:7">ሎላ ጉዳ ከን ለገ ኤፍራጢስ ጄቹንስ ሞቲ አሶር</para>
  <para style="q2" vid="ISA 8:7">ኡልፍነሳ ሁንደ ወጅን ሰበ ከነት ፍደ።</para>
  <para style="q1" vid="ISA 8:7">ሎላን ሱንስ ጉቴ ቦኦሳረ ያኤ</para>
  <para style="q2" vid="ISA 8:7">ኤዴደሳ ሁንደረ ዸንገለአ።<verse eid="ISA 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 8:8"/>ሎላን ሱንስ ሀመ ሞርመ ገኡት ጉቴ እረ ዸንገለኤ</para>
  <para style="q2" vid="ISA 8:8">ኬሰ ደርቡዻን ዋን ሁንዱማ ሀጣኤ ይሁዳት ጌሰ።</para>
  <para style="q1" vid="ISA 8:8">ያ አማኑኤል!<note caller="+" style="f"><char style="fr" closed="false">8፥8 </char><char style="fq" closed="false">አማኑኤል </char><char style="ft" closed="false">ጄቹን </char><char style="fqa" closed="false">ዋቅን ኑ ወጅን ጅረ </char><char style="ft" closed="false">ጄቹዸ።</char></note></para>
  <para style="q2" vid="ISA 8:8">ቆቾንሳ በልእፈሜ ጉቱማ ብየኬቲ ንሀጉገ።”<verse eid="ISA 8:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 8:9"/>ያ ሰቦተ፣ ቡርኩታኣ!</para>
  <para style="q2" vid="ISA 8:9">እስን ወር ብየ ፈጎ ጅርተን ሁንድ ዸጌፈዻ።</para>
  <para style="q1" vid="ISA 8:9">ወራናፍ ህዸዻ፤ ተኡስ ቡርኩታኣ!</para>
  <para style="q2" vid="ISA 8:9">ወራናፍ ህዸዻ፤ ተኡስ ቡርኩታኣ!<verse eid="ISA 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 8:10"/>መርአዻ፤ ገሩ ፋይዳ ህንቀቡ፤</para>
  <para style="q2" vid="ISA 8:10">ከሮርፈዻ፤ ገሩ ፊጣን ህንበኡ፤</para>
  <para style="q2" vid="ISA 8:10">ዋቅን ኑ ወጅን ጅራቲ።<verse eid="ISA 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 8:11"/>
    <char style="nd">ዋቀዮ</char> ሀርከሳ ጀባ ሰናን ነት ዱበቴ አከ አን ከራ ሰበ ከናረ ህንዴምኔፍ አከነ ጄዼ ነ አኬከቺሴራቲ፦<verse eid="ISA 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 8:12"/>“እስን ዋን ኡመትን ኩን ፍንጭለ ጄዹ</para>
  <para style="q2" vid="ISA 8:12">ሁንዳን ፍንጭለ ህንጄዽና፤</para>
  <para style="q1" vid="ISA 8:12">ዋን እሳን ሶዳተን ህንሶዳትና፤</para>
  <para style="q2" vid="ISA 8:12">ህንራፈምና።<verse eid="ISA 8:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 8:13"/>ከን እስን አከ ቁልቁሉት እላሉ ቀብደን <optbreak/> <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ ቶክቸ፤</para>
  <para style="q2" vid="ISA 8:13">ከን እስን ሶዳቹ ቀብደን እሱመ፤</para>
  <para style="q2" vid="ISA 8:13">ከን እስን ሆለቹፊ ቀብደንስ እሱመ።<verse eid="ISA 8:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 8:14"/>እን እዶ ቁልቁሉ ተአ፤</para>
  <para style="q2" vid="ISA 8:14">መኔን እስራኤል ለማኒፍ ገሩ</para>
  <para style="q1" vid="ISA 8:14">እን ዸጋ ነመ ጉፈቺሱ፣</para>
  <para style="q2" vid="ISA 8:14">ከታ ነመ ኩፍሱ ተአ።</para>
  <para style="q1" vid="ISA 8:14">ሰበ ዬሩሳሌምት ገሩ</para>
  <para style="q2" vid="ISA 8:14">እን ክዮፊ ፉታሳ ተአ።<verse eid="ISA 8:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 8:15"/>ሄዱንሳኒ ንጉፈቱ፤</para>
  <para style="q2" vid="ISA 8:15">እሳን ኩፈኒ ጨጨቡ፤</para>
  <para style="q2" vid="ISA 8:15">ፉታሳ ሴነኒ ቀበሙ።”<verse eid="ISA 8:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 8:16"/>ዹገ በኡምሰ ከነ ወልት ቀብሲስ፤</para>
  <para style="q2" vid="ISA 8:16">ሴረ ከነስ በረቶተኮ ግዱት ቻፓዻን ጩፍ።<verse eid="ISA 8:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 8:17"/>
    <char style="nd">ዋቀዮ</char> መነ ያቆብ ዱራ</para>
  <para style="q2" vid="ISA 8:17">ፉለሳ ዾክፈቴ ሰነ ነንኤገዸ።</para>
  <para style="q1" vid="ISA 8:17">አን እሰ ነንአመነዸ።<verse eid="ISA 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 8:18"/>አኒፊ እጆሌን <char style="nd">ዋቀዮ</char> ና ኬኔ ኩኖት። ኑ እስራኤል ኬሰት <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ ከን ቱሉ ጥዮንረ ጅራቱ ሰናፍ መለቶፊ ፈኬኘ።<verse eid="ISA 8:18"/></para>
  <para style="s1">ዱከን እፈት ጅጂረመ</para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 8:19"/>ዮሙ ነምን ቶኮ ዸቃቲ እላልቶታፊ ኤኬር ዱብስቶተ ከኔን ሀሳሰኒፊ ጉንጉመን ዋ ጋፈዻ እስኒን ጄዹት ሰብን ቶኮ ዋቀሳ ጎርሰ ጋፈቹ ህንቀቡ? እሳን ዋኤ ጅራቶታ ማሊፍ ወረ ዱአን ጋፈቱ? <verse eid="ISA 8:19"/><verse number="20" style="v" sid="ISA 8:20"/>አከ ሴራፊ ዹገ በኡምሰ ሰናት ጅራዻ! እሳን ዮ አከ ዱቢ ከናት ዱበቹ ባተን እፈ በሪ ህንቀበን ጄቹዸ። <verse eid="ISA 8:20"/><verse number="21" style="v" sid="ISA 8:21"/>እሳን ረክነ ጉዳፊ ቤላን ብየ ኬሰ ጆሩ፤ ዮሙ ቤለአንትስ አከ መሌ ኣረኒ፣ ኦል እላለኒ ሞቲሳኒቲፊ ዋቀሳኒ አባሩ። <verse eid="ISA 8:21"/><verse number="22" style="v" sid="ISA 8:22"/>ኤርገሲስ ገረ ለፋ እላለኒ ረክነ ጉዳ፣ ዱከናፊ ሁሪ ሶዳችሳ አርጉ፤ እሳንስ ዱከነ ሀማት ደርበተሙ።<verse eid="ISA 8:22"/></para>
  <chapter eid="ISA 8"/>
  <chapter number="9" style="c" sid="ISA 9"/>
  <para style="s1">ሙጫን ኑፍ ዸለቴረ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 9:1"/>ወር ረክነ ጉዳ ኬሰ ቱረን ገሩ ስአች ገደ ኬሰ ህንጅራተን። እን ዱራን ብየ ዜቡሎኒፊ ብየ ንፍታሌም ገድ ዴብሴ፤ ገረ ፉልዱራት ገሩ ገሊላ ነሞተ ኦርማ ከን ዮርዳኖሲን ገመ፣ ቀርቀረ ዳንዲ ገላናረ ጅረን ሰነ ንከበጀ።<verse eid="ISA 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 9:2"/>ሰብን ዱከነ ኬሰ ጅራቱ እፈ ጉዳ አርጌረ፤</para>
  <para style="q2" vid="ISA 9:2">ወረ ብየ ዱከነ ልምጢ ኬሰ ጅራተኒፍስ እፍን በኤረ።<verse eid="ISA 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 9:3"/>አት ሰበ ባይእፍቴ</para>
  <para style="q2" vid="ISA 9:3">ገመቹሳኒሌ ጉድፍቴርተ፤</para>
  <para style="q1" vid="ISA 9:3">እሳን አኩመ ኡመትን ዬሮ</para>
  <para style="q2" vid="ISA 9:3">ምዻን ሃመሙት ገመዱ ሰነ፣</para>
  <para style="q1" vid="ISA 9:3">አኩመ ነሞትን ዬሮ ቦጁ ቆደተንት</para>
  <para style="q2" vid="ISA 9:3">ገመደን ሰነ ፉለኬ ዱረት ንእልልቹ።<verse eid="ISA 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 9:4"/>አት አኩመ በረ ምድያን ሞአተሜ ሰና፣</para>
  <para style="q2" vid="ISA 9:4">ዋንጆ እሳንት ኡልፋቴ</para>
  <para style="q1" vid="ISA 9:4">ሶማ ገቲቲሳኒራ</para>
  <para style="q2" vid="ISA 9:4">ኡሌ ጩንቁርሳሳኒሌ ጨጨብስቴርተ።<verse eid="ISA 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 9:5"/>ኮጴን ሎልቱን እቲን ዱልቴ ሁንድ፣</para>
  <para style="q2" vid="ISA 9:5">ኡፈትን ዺገ ኬሰ ጩጰሜ ሁንድ</para>
  <para style="q1" vid="ISA 9:5">እብዳን ጉበመ፤</para>
  <para style="q2" vid="ISA 9:5">ቆራን እብዳስ ተአ።<verse eid="ISA 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 9:6"/>ሙጫን ኑፍ ዸለቴረ፤</para>
  <para style="q2" vid="ISA 9:6">እልም ኑፍ ኬነሜረ፤</para>
  <para style="q2" vid="ISA 9:6">ሞቱማን ገቲቲሳረ ጅራተ።</para>
  <para style="q1" vid="ISA 9:6">እንስ ጎርሳ ድንቅሲሳ፣ ዋቀ ጀባ፣</para>
  <para style="q2" vid="ISA 9:6">አባ በረ በራ፣ ሞቲ ነጋ</para>
  <para style="q2" vid="ISA 9:6">ጄዸሜ ንዋመመ።<verse eid="ISA 9:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 9:7"/>በበልእን ሞቱማሳቲፊ</para>
  <para style="q2" vid="ISA 9:7">ነጋንሳ ዹመ ህንቀቡ።</para>
  <para style="q1" vid="ISA 9:7">እንስ ሙርቲ ቀጄላፊ ቀጄሉማዻን</para>
  <para style="q2" vid="ISA 9:7">ሁንዴሴ ጀቤሴ ዻቡዻን</para>
  <para style="q1" vid="ISA 9:7">ዬሮ ሰና ጀልቀቤ በረ በራን</para>
  <para style="q2" vid="ISA 9:7">ቴሶ ዳዊትረ ታኤ ሞቱማሳ ቡልቸ።</para>
  <para style="q1" vid="ISA 9:7">ህናፋን <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡስ</para>
  <para style="q2" vid="ISA 9:7">ዋን ከነ ንራወተ።<verse eid="ISA 9:7"/></para>
  <para style="s1">
    <char style="nd">ዋቀዮ</char> እስራኤልት ዼከሜ</para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 9:8"/>ጎፍታን ዻምሰ ቶኮ ያቆብት ኤርጌረ፤</para>
  <para style="q2" vid="ISA 9:8">ኩንስ እስራኤልረ ቡአ።<verse eid="ISA 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 9:9"/>ኡመትን ሁንድ፣</para>
  <para style="q2" vid="ISA 9:9">ኤፍሬሚፊ ጅራቶትን ሰማርያ ዋን ከነ ንቤኩ፤</para>
  <para style="q2" vid="ISA 9:9">እሳንስ ኦፍ ቱሉፊ ገራ ኦፍ ጀጁን አከነ ጄዹ፤<verse eid="ISA 9:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 9:10"/>“ጡቢወን ዲገመኒሩ፤</para>
  <para style="q2" vid="ISA 9:10">ኑ ገሩ ዸጋ ሶፈሜን ዴብስኔ እጃረ፤</para>
  <para style="q1" vid="ISA 9:10">ሙኬን ሀርቡ ሙርሙረመኒሩ፤</para>
  <para style="q2" vid="ISA 9:10">ኑ ገሩ ብርብርሰ እዶ ቡስነ።”<verse eid="ISA 9:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 9:11"/>ከናፉ <char style="nd">ዋቀዮ</char> አመጃጆተ ሬዚን እሳንት ጀቤሴ፤</para>
  <para style="q2" vid="ISA 9:11">ዲኖተሳኒሌ እሳንት ከካሴ።<verse eid="ISA 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 9:12"/>ወር ሶርያ ገመ በኣቲን፣ <optbreak/> ፍልስጤሞትንሞ ገመ ልጣቲን</para>
  <para style="q2" vid="ISA 9:12">አፋን በነተኒ እስራኤልን ልቅምሰን።</para>
  <para style="b" vid="ISA 9:12"/>
  <para style="q1" vid="ISA 9:12">ከነ ሁንዳንሌ ዼከምስሳ ህንቀበኖፍኔ፤</para>
  <para style="q2" vid="ISA 9:12">ሀርክሳስ አመዩ አኩመ ኦል ካፈሜት ጅረ።<verse eid="ISA 9:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 9:13"/>ሰብን ሱን ገሩ ገረ እሰ እሳን ዸኤ ሰናት ህንዴብኔ</para>
  <para style="q2" vid="ISA 9:13">ዮካን <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ ህንበርባደትኔ።<verse eid="ISA 9:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 9:14"/>ከናፉ <char style="nd">ዋቀዮ</char> እስራኤልራ መታፊ ኤጌ ኩተ፤</para>
  <para style="q2" vid="ISA 9:14">ደሜ ሜጢቲፊ ሸምበቆ ጉዩመ ቶኮን በሌሰ፤<verse eid="ISA 9:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 9:15"/>ማንጉዶትኒፊ ከበጀሞትን መታዸ፤</para>
  <para style="q2" vid="ISA 9:15">ራጆትን ሶበ በርሲሰንሞ ኤጌዸ።<verse eid="ISA 9:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 9:16"/>ነሞትን ሰበ ከነ ቀጄልቸን እሳን ዶጎጎርሱ፤</para>
  <para style="q2" vid="ISA 9:16">ወር እሳኒን ቀጄልፈመንስ ከራራ በዱ።<verse eid="ISA 9:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 9:17"/>ከናፉ ጎፍታን ደርገጎተት ህንገመዱ</para>
  <para style="q2" vid="ISA 9:17">ዮካን እጆሌ አባ ህንቀብኔፊ <optbreak/> ሃዾተ ህዬሳቲፍ ህንነኡ፤</para>
  <para style="q1" vid="ISA 9:17">ነምን ሁንድኑ ከን ዋቀ ህንሶዳትኔፊ ሀማዻቲ፤</para>
  <para style="q2" vid="ISA 9:17">አፋን ሁንድኑስ ሀማ ዱበተ።</para>
  <para style="b" vid="ISA 9:17"/>
  <para style="q1" vid="ISA 9:17">ከነ ሁንዳንሌ ዼከምስሳ ህንቀበኖፍኔ፤</para>
  <para style="q2" vid="ISA 9:17">ሀርክሳስ አመዩ አኩመ ኦል ካፈሜት ጅረ።<verse eid="ISA 9:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 9:18"/>ሀምን ዹጉማን አከ እብዳ ቦበአ፤</para>
  <para style="q2" vid="ISA 9:18">እን ሶኮሩፊ ቆራቲሌ ጉቤ በሌሰ፣</para>
  <para style="q1" vid="ISA 9:18">ቦሶነ ጎቡስ ንቀበተ፤</para>
  <para style="q2" vid="ISA 9:18">አኩመ ኣረ ኦል በኡትስ ኦል በአ።<verse eid="ISA 9:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 9:19"/>ዼከምሰ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡቲን <optbreak/> ለፍት ንጉበት፤</para>
  <para style="q2" vid="ISA 9:19">ነሞትንስ ቆራን እብዳ ተኡ፤</para>
  <para style="q2" vid="ISA 9:19">ነምን ከምዩ ኦቦሌሰሳ ኦልቹ ህንደንደኡ።<verse eid="ISA 9:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 9:20"/>ከራ ምርጋቲን ንቡተቱ፤</para>
  <para style="q2" vid="ISA 9:20">ገሩ ቤለ ህንበአን፤</para>
  <para style="q1" vid="ISA 9:20">ከራ ብታቲን ንኛቱ፤</para>
  <para style="q2" vid="ISA 9:20">ገሩ ህንቁፈን።</para>
  <para style="q1" vid="ISA 9:20">ቶኮን ቶኮንሳኒ ፎን ኣንቴሳ ኛተ፤<verse eid="ISA 9:20"/></para>
  <para style="q2">
    <verse number="21" style="v" sid="ISA 9:21"/>ምናሴን ኤፍሬምን ኛተ፤ ኤፍሬምስ ምናሴ ኛተ፤</para>
  <para style="q2" vid="ISA 9:21">እሳን ቶኩማዻን ይሁዳት ገረገሉ።</para>
  <para style="b" vid="ISA 9:21"/>
  <para style="q1" vid="ISA 9:21">ከነ ሁንዳንሌ ዼከምስሳ ህንቀበኖፍኔ፤</para>
  <para style="q2" vid="ISA 9:21">ሀርክሳስ አመዩ አኩመ ኦል ካፈሜት ጅረ።<verse eid="ISA 9:21"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 9"/>
  <chapter number="10" style="c" sid="ISA 10"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 10:1"/>ወረ ሴረ ጀልኣ ባሰን፣</para>
  <para style="q2" vid="ISA 10:1">ከኔን ለብሲ ጩንቁርሳ ለብሰኒፍ ወዮ፤<verse eid="ISA 10:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 10:2"/>እሳን ሙርቲ ረከቶታ ጀልእሱ፤</para>
  <para style="q2" vid="ISA 10:2">ምርገ ህዬዪ ሰበኮስ ንዺቡ፤</para>
  <para style="q1" vid="ISA 10:2">ሃዾተ ህዬሳ ቦጁ ጎዸቱ፤</para>
  <para style="q2" vid="ISA 10:2">እጆሌ አባ ህንቀብኔስ ንሳሙ።<verse eid="ISA 10:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 10:3"/>እስን ዬሮ በዲስን ፈጎዻ ዹፉ</para>
  <para style="q2" vid="ISA 10:3">ጉያ አደቢት ማል ጎቱ?</para>
  <para style="q1" vid="ISA 10:3">ገርጋርሰ አርገቹፍ ኤኙት በቀቱ?</para>
  <para style="q2" vid="ISA 10:3">ቀቤኘኬሰን ኤሰት ዺፍቱ?<verse eid="ISA 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 10:4"/>ወረ ቦጅአመን ጀለ ጉጉፉ</para>
  <para style="q2" vid="ISA 10:4">ዮካን ወረ አጄፈመን ጀለት ኩፉ መሌ ሆምቱ ህንሀፉ።</para>
  <para style="b" vid="ISA 10:4"/>
  <para style="q1" vid="ISA 10:4">ከነ ሁንዳንሌ ዼከምስሳ ህንቀበኖፍኔ፤</para>
  <para style="q2" vid="ISA 10:4">ሀርክሳስ አመዩ አኩመ ኦል ካፈሜት ጅረ።<verse eid="ISA 10:4"/></para>
  <para style="s1">ሙርቲ ዋቅን አሶርት ሙርቴሴ</para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 10:5"/>“አሶርቸ እሰ ኡሌ ኣሪኮቲ ተኤፍ፣</para>
  <para style="q2" vid="ISA 10:5">እሰ ቦኩን ዼከምሰኮቲ ሀርከሳ ጅሩፍ ወዮ!<verse eid="ISA 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 10:6"/>አን አከ እን እሳን ሳሙፊ ቦጅኡፍ</para>
  <para style="q2" vid="ISA 10:6">አከ እን አኩመ ዾቄ ከራራ ለፈት እሳን ዽዺቱፍ</para>
  <para style="q1" vid="ISA 10:6">ሰበ ዋቀት ህንቡሌት እሰ ነንኤርገ፤</para>
  <para style="q2" vid="ISA 10:6">ኡመተ ነ ኣርሱትስ እሰ ነንአጀጀ።<verse eid="ISA 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 10:7"/>ገሩ ኩን ዋን እን ያዱ ምት፤</para>
  <para style="q2" vid="ISA 10:7">ያድን አከሲስ ገራሳ ኬሰ ህንጅሩ፤</para>
  <para style="q1" vid="ISA 10:7">ካዮንሳ በርበዴሱዸ፤</para>
  <para style="q2" vid="ISA 10:7">ሰበ ባይኤስ ፍጡዸ።<verse eid="ISA 10:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 10:8"/>እንስ አከነ ጄዸ፤ ‘አጀጆትንኮ ሁንድኑ ሞቶተ ምቲ?<verse eid="ISA 10:8"/></para>
  <para style="q2">
    <verse number="9" style="v" sid="ISA 10:9"/>ካልኖትን አኩመ ከርኬሚሽ ምቲ?</para>
  <para style="q1" vid="ISA 10:9">ሀማት አኩመ አርፋድ ምቲ?</para>
  <para style="q2" vid="ISA 10:9">ሰማርያንስ አኩመ ደማስቆ ምቲ?<verse eid="ISA 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 10:10"/>አኩመ ሀርክኮ ሞቱሞተ ዋቆተ ቶልፈሞ</para>
  <para style="q2" vid="ISA 10:10">ከኔን ፈኪወን ሶፈሞ ከን ዬሩሳሌሚፊ <optbreak/> ሰማርያ ጫለን ቀቤ ሰነ፣<verse eid="ISA 10:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 10:11"/>አን ዋነን ሰማርያፊ ፈኪወንሼ ጎዼ ሰነ</para>
  <para style="q2" vid="ISA 10:11">ዬሩሳሌሚፊ ዋቆተሼ ቶልፈሞ ህንጎዹ?’ ”<verse eid="ISA 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 10:12"/>ጎፍታን ዬሮ ቱሉ ጥዮንረቲፊ ዬሩሳሌም ኬሰት ሆጂሳ ሁንደ ፍጠቱት አከነ ጄዸ፤ “አን ሰበቢ ኦፍ ጀጁ ገራሳቲፊ እላልቸሳ ከን ኦፍ ቱሉማን ጉተሜ ሰናቲፍ ጄዼ ሞትቸ አሶር ነንአደበ። <verse eid="ISA 10:12"/><verse number="13" style="v" sid="ISA 10:13"/>እን አከነ ጄዻቲ፦</para>
  <para style="q1" vid="ISA 10:13">“ ‘አን ጀብነ ሀርከኮቲን ዋን ከነ ሆጄዼረ፤</para>
  <para style="q2" vid="ISA 10:13">አን ሰበቢን ሁበትና ቀቡፍ፣ <optbreak/> ኦጉማኮቲን ሆጄዼረ።</para>
  <para style="q1" vid="ISA 10:13">አን ዳንጋ ሰቦታ እዶዻ ቡቅሴረ፤</para>
  <para style="q2" vid="ISA 10:13">ቀቤኘሳኒሌ ሳሜረ።</para>
  <para style="q2" vid="ISA 10:13">አኩመ ነመ ጀባ ቶኮ አን ሞቶተሳኒ <optbreak/> ኦፍ ጀለ ገልፈዼረ።<verse eid="ISA 10:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 10:14"/>አኩመ ነምን ቶኮ መንኤ ስምብራ ኬሰ ሀርከ ካኡ ሰነ</para>
  <para style="q2" vid="ISA 10:14">አንስ ሀርከኮ ቀቤኘ ሰቦታ ኬሰ ነንካአ፤</para>
  <para style="q1" vid="ISA 10:14">አኩመ ነሞትን ሀንቃቁ ደገተሜ</para>
  <para style="q2" vid="ISA 10:14">ወልት ቀበን ሰነ፣ አንስ ብየ ሁንደ ወልት ነንቀቤ፤</para>
  <para style="q1" vid="ISA 10:14">ከን ቆቾ ሁርጉፈቴ፣</para>
  <para style="q2" vid="ISA 10:14">ዮካን ወጩፍ አፋን በነቴ ቶኮዩ ህንቱሬ።’ ”<verse eid="ISA 10:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 10:15"/>ቆቶን ነመ እቲን ዋ ሙሩት ንኮራ?</para>
  <para style="q2" vid="ISA 10:15">ዮካን ወን እቲን ዋ ሙረን ነመ እት ፈየደሙት ኦፍ ጀጃ?</para>
  <para style="q1" vid="ISA 10:15">ኩንስ አከ ዋን ኡሌን ቶኮ ነመ እሰ ቀበቱት ኦፍ ምርምርሱት፤</para>
  <para style="q2" vid="ISA 10:15">ዮካን አኩመ ቦኩን ቶኮ አከ ዋን ሙከ ህንተእኒት ኦል ኦፍ ጉድሱት!<verse eid="ISA 10:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 10:16"/>ከናፉ ጎፍታን፣ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣</para>
  <para style="q2" vid="ISA 10:16">ሎልቶተ ገገበተን ከነት ዹኩበ ነመ ሁቅሱ ንኤርገ፤</para>
  <para style="q1" vid="ISA 10:16">ኡልፍነሳ ጀላንስ እብድ ቶኮ</para>
  <para style="q2" vid="ISA 10:16">አኩመ አረበ እብዳ ንቀብሲፈመ።<verse eid="ISA 10:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 10:17"/>እፍን እስራኤል እብደ፣</para>
  <para style="q2" vid="ISA 10:17">ቁልቁልችሳኒ ሱንስ አረበ እብዳ ተአ፤</para>
  <para style="q1" vid="ISA 10:17">እብድ ሱን ጉዩመ ቶኮን</para>
  <para style="q2" vid="ISA 10:17">ቆራቲሳቲፊ ሶኮሩሳ ጉቤ በሌሰ።<verse eid="ISA 10:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 10:18"/>አኩመ ነምን ቶኮ ዬሮ ዹኩብሰቱ ሁቀቱ ሰነ፣</para>
  <para style="q2" vid="ISA 10:18">እብድ ሱን ኡልፍነ ቦሶናሳቲፊ ለፈ ቆቲሳ ገበታ፣</para>
  <para style="q2" vid="ISA 10:18">ሉቡፊ ፎንስ ንበርበዴሰ።<verse eid="ISA 10:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 10:19"/>ሙኬን ቦሶነሳ ኬሰት ሀፈን ዋን አከ መሌ ሙራሰ ተአኒፍ</para>
  <para style="q2" vid="ISA 10:19">ሙጫን ቶኮ ገልሜሱ ንደንደአ።<verse eid="ISA 10:19"/></para>
  <para style="s1">ሀምባ እስራኤል</para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 10:20"/>በረ ሰነ ኬሰ ሀምባን እስራኤል፣</para>
  <para style="q2" vid="ISA 10:20">መነ ያቆብ ኬሳ ወር ሀፈን፣</para>
  <para style="q1" vid="ISA 10:20">ዹጉማን <char style="nd">ዋቀዮ</char> ቁልቁልቸ እስራኤል አብደቱ መሌ</para>
  <para style="q2" vid="ISA 10:20">ለመተ እሰ እሳን ዸኤ ሰነ ህንአብደተን።<verse eid="ISA 10:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 10:21"/>ሀምባን ቶኮ፣ ሀምባን ያቆብ</para>
  <para style="q2" vid="ISA 10:21">ገረ ዋቀ ጀባ ሰናት ንዴብአ።<verse eid="ISA 10:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 10:22"/>ያ እስራኤል፣ ዮ ሰብንኬ</para>
  <para style="q2" vid="ISA 10:22">አኩመ ጭረቸ ቀርቀረ ገላና ተኤዩ፣ <optbreak/> ሀምባ ቆፈቱ ዴብአ።</para>
  <para style="q2" vid="ISA 10:22">በዲስን ቀጄሉማዻን ጉተሜ ለብሰሜረ።<verse eid="ISA 10:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 10:23"/>ጎፍታን፣ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ</para>
  <para style="q2" vid="ISA 10:23">በዲሰ ለፈ ሁንደት ለብሰሜ ንራወተ።<verse eid="ISA 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ISA 10:24"/>ከናፉ ጎፍታን፣ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ አከነ ጄዸ፦</para>
  <para style="q1" vid="ISA 10:24">“ያ ሰበኮ ወር ጥዮን ኬሰ ጅራተን፣</para>
  <para style="q2" vid="ISA 10:24">ወረ አሶር ከኔን ኡሌዻን እስን ሩኩተን፣</para>
  <para style="q2" vid="ISA 10:24">ከኔን አኩመ ወረ ግብጥ ቦኩ ኦል እስንት ፉዸተን ህንሶዳትና።<verse eid="ISA 10:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 10:25"/>ኣሪን አን እስንት ኣሬ ደፌ ቀበናአ፤</para>
  <para style="q2" vid="ISA 10:25">ዼከምስኮስ እሳን በሌሱፍ እት ገረገለ።”<verse eid="ISA 10:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 10:26"/>
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ ሱን፣</para>
  <para style="q2" vid="ISA 10:26">አኩመ ከታ ሄሬብ ብረት ምድያንን ቀጬን ገረፌ ሰነ፣</para>
  <para style="q1" vid="ISA 10:26">አኩመ ብየ ግብጥ ኬሰት ጎዼ ሰነ፣</para>
  <para style="q2" vid="ISA 10:26">ኡሌሳ ብሻንረት ኦል ፉዸተ።<verse eid="ISA 10:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 10:27"/>ጋፈስ በኣንሳኒ ገቲቲኬሰንራ፣</para>
  <para style="q2" vid="ISA 10:27">ዋንጆንሳኒስ ሞርመኬሰንራ ፉዸመ፤</para>
  <para style="q2" vid="ISA 10:27">ዋን እስን አከ መሌ ገበተኒፍ ዋንጆን ንጨጨበ።<verse eid="ISA 10:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 10:28"/>እሳን ገረ አየት ሴነን፤</para>
  <para style="q2" vid="ISA 10:28">ምግሮን ኬሰ በአን፤</para>
  <para style="q2" vid="ISA 10:28">ኛታፊ ህዸተሳኒስ ምክማስ ኬሰት ኩፍተን።<verse eid="ISA 10:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 10:29"/>እሳን ከራ ቀልኣረ በአኒ፣</para>
  <para style="q2" vid="ISA 10:29">“ኑ ጌባ ቁበትኔ ቡለ” ጄዸን።</para>
  <para style="q1" vid="ISA 10:29">ራማን ንሶዳት፤</para>
  <para style="q2" vid="ISA 10:29">ግቤኣን ሳኦልስ ንበቀት።<verse eid="ISA 10:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 10:30"/>ያ እንተለ ገሊም፣ እይ!</para>
  <para style="q2" vid="ISA 10:30">ያ ላይሻ ዸጌፈዹ!</para>
  <para style="q2" vid="ISA 10:30">ያ አናቶት ዴቢ እሼፍ ኬን!<verse eid="ISA 10:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 10:31"/>ማድሜናን በቀታ ጅርት፤</para>
  <para style="q2" vid="ISA 10:31">ኡመትን ጌቢምስ በቀቹፍ ወልት ቀበመ።<verse eid="ISA 10:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="ISA 10:32"/>እሳን ሀርአ ኖብ ገኡ፤</para>
  <para style="q2" vid="ISA 10:32">እሳን ቱሉ እንተለ ጥዮንት፣</para>
  <para style="q2" vid="ISA 10:32">ጋረ ዬሩሳሌምት ሀርከሳኒ ራሱ።<verse eid="ISA 10:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="ISA 10:33"/>ኩኖ ጎፍታን፣ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣</para>
  <para style="q2" vid="ISA 10:33">ሁምነ ጉዳዻን ደሜወን ሙርሙረ፤</para>
  <para style="q1" vid="ISA 10:33">ሙኬን ጉርጉዳን ንጭጭረሙ፤</para>
  <para style="q2" vid="ISA 10:33">ሙኬን ዼዼሮንስ ገድ ቀበሙ።<verse eid="ISA 10:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="ISA 10:34"/>እን ቦሶነ ጎቡ ቆቶዻን ጭረ፤</para>
  <para style="q2" vid="ISA 10:34">ልባኖንስ ፉለ ዋቀ ጀባ ዱረት ኩፈ።<verse eid="ISA 10:34"/></para>
  <chapter eid="ISA 10"/>
  <chapter number="11" style="c" sid="ISA 11"/>
  <para style="s1">ደሜ እሴይ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 11:1"/>ለታን ቶኮ ጅርመ እሴይራ ንለተ፤</para>
  <para style="q2" vid="ISA 11:1">ህደሳራስ ደሜን ቶኮ እጀ ነቀተ።<verse eid="ISA 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 11:2"/>ሀፉር <char style="nd">ዋቀዮ</char>፣</para>
  <para style="q2" vid="ISA 11:2">ሀፉር ኦጉማቲፊ ሁበትና፣</para>
  <para style="q2" vid="ISA 11:2">ሀፉር ጎርሳቲፊ ሁምና፣</para>
  <para style="q2" vid="ISA 11:2">ሀፉር ቤኩምሳቲፊ ከን <char style="nd">ዋቀዮን</char> ሶዳቹ እሰረ ቁበተ፤<verse eid="ISA 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 11:3"/>እን <char style="nd">ዋቀዮን</char> ሶዳቹት ንገመደ።</para>
  <para style="b" vid="ISA 11:3"/>
  <para style="q1" vid="ISA 11:3">እን ዋኑመ እጅሳ አርጉን ሙርቲ ህንኬኑ፤</para>
  <para style="q2" vid="ISA 11:3">ዮካን ዋኑመ ጉረሳቲን ዸገኡን ህንሙርቴሱ፤<verse eid="ISA 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 11:4"/>ገሩ ነመ ረከታፍ ቀጄሉማዻን ሙርቴሰ፤</para>
  <para style="q2" vid="ISA 11:4">ህዬዪ ለፈራቲፍስ ሙርቲ ቀጄላዻን ሙርቲ ኬነ።</para>
  <para style="q1" vid="ISA 11:4">እን ኡሌ አፋንሳቲን ለፈ ሩኩተ፤</para>
  <para style="q2" vid="ISA 11:4">ሀፉረ አፋንሳቲ በኡን ሀሞተ ንፍጠ።<verse eid="ISA 11:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 11:5"/>ቀጄሉማን ቴጰ ሙዺሳት፤</para>
  <para style="q2" vid="ISA 11:5">አመነሙማንሞ ሰበተ ሙዺሳት።<verse eid="ISA 11:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 11:6"/>ዬዪን ጦባላ ሆላ ወጅን ጅራተ፤</para>
  <para style="q2" vid="ISA 11:6">ቄረንስ እልሞ ሬኤ ብረ ጪሰ፤</para>
  <para style="q1" vid="ISA 11:6">ጀቢን፣ ሌንጪፊ ሆሪን ገበታን ወሊ ወጅን ቦበኡ፤</para>
  <para style="q2" vid="ISA 11:6">ሙጫን ጥናን እሳን ቦባሰ።<verse eid="ISA 11:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 11:7"/>ሳን አማኬተ ወጅን ሶረተ፤</para>
  <para style="q2" vid="ISA 11:7">እልማንሳኒ ወል ጭነ ጭጪሱ፤</para>
  <para style="q2" vid="ISA 11:7">ሌንጭስ አከ ሰንጋ ጭዲ ኛተ።<verse eid="ISA 11:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 11:8"/>ዳእምን ቦለ ቦፋረ ተጰተ፤</para>
  <para style="q2" vid="ISA 11:8">ሙጫን ጥናን ቦለ ቡቲ ኬሰ ሀርከ ካአ።<verse eid="ISA 11:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 11:9"/>እሳን ቱሉወንኮ ቁልቁሎተ ሁንደረት</para>
  <para style="q2" vid="ISA 11:9">ዋ ህንሚዸን ዮካን ዋ ህንበሌሰን፤</para>
  <para style="q1" vid="ISA 11:9">አኩመ ብሻን ገላነ ጉቱ ሰነ</para>
  <para style="q2" vid="ISA 11:9">ለፍት <char style="nd">ዋቀዮን</char> ቤኩዻን ጉተምቲቲ።<verse eid="ISA 11:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 11:10"/>በረ ሰነ ኬሰ ህድ እሴይ አኩመ ፋጂት ኡመታፍ ዻበተ፤ ሰቦትን ገረሳት ወልት ቀበሙ፤ ለፍት እን ቦቆቱስ ኡልፍነ ቀቤሰ ተአ። <verse eid="ISA 11:10"/><verse number="11" style="v" sid="ISA 11:11"/>ጋፈስ ጎፍታን ዬሮ ለመፋፍ ሀርከሳ ድሪርሴ አሶርራ፣ ግብጥ ገዲራ፣ ግብጥ ኦሊራ፣ እቶጵያራ፣ ኤላምራ፣ ባብሎንራ፣ ሀማቲፊ ብዮተ ብሻን ግዱ ገላናራ ሀምባወን ሰበሳ ወልት ቀበተ።<verse eid="ISA 11:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 11:12"/>እን ሰቦታፍ ፋጂ ኦል ካሴ</para>
  <para style="q2" vid="ISA 11:12">ቦጅአምቶተ እስራኤል ወልት ቀበ፤</para>
  <para style="q1" vid="ISA 11:12">እን ሮገ ለፋ አፍረንራ</para>
  <para style="q2" vid="ISA 11:12">ሰበ ይሁዳ ከን ብትናኤ ቱሬ ወልት ቀበ።<verse eid="ISA 11:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 11:13"/>ህናፋን ኤፍሬም ንበደ፤</para>
  <para style="q2" vid="ISA 11:13">ዲኖትን ይሁዳስ ንበርበዴፈሙ፤</para>
  <para style="q1" vid="ISA 11:13">ኤፍሬም ጋፈስ ይሁዳት ህንህናፉ፤</para>
  <para style="q2" vid="ISA 11:13">ዮካን ይሁዳን ኤፍሬምት ህንሀማቱ።<verse eid="ISA 11:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 11:14"/>እሳን ከራ ልጠ ቢፍቱቲን ገቲቲ ፍልስጤምት ገድ ቡኡ፤</para>
  <para style="q2" vid="ISA 11:14">ቶኮ ተአኒስ ኡመተ በአ ቢፍቱ ሳሙ።</para>
  <para style="q1" vid="ISA 11:14">እሳን ኤዶሚፊ ሞኣብን ቀበቱ፤</para>
  <para style="q2" vid="ISA 11:14">ወር አሞንስ እሳን ጀለት ቡሉ።<verse eid="ISA 11:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 11:15"/>
    <char style="nd">ዋቀዮ</char> ጉቱማን ጉቱት፣</para>
  <para style="q2" vid="ISA 11:15">ገሎ ገላነ ግብጥ ንጎግሰ፤</para>
  <para style="q1" vid="ISA 11:15">እን ቡቤሳ ከን ነመ ወጠሉን</para>
  <para style="q2" vid="ISA 11:15">ሀርከሳ ለገ ኤፍራጢስረ ሶቾሰ።</para>
  <para style="q1" vid="ISA 11:15">አከ ነሞትን ኮጴን ጬአኒፍስ</para>
  <para style="q2" vid="ISA 11:15">እን ለገ ቶርበት ገርገር እሰ ቆደ።<verse eid="ISA 11:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 11:16"/>አኩመ ጋፈ እሳን ግብጢ በአን <optbreak/> እስራኤሊፍ ተኤ ሰነ፣</para>
  <para style="q2" vid="ISA 11:16">ሀምባ ሰበሳ ከን አሶርራ ሀፌፍ</para>
  <para style="q2" vid="ISA 11:16">ከራን ጉዳን ንአርገመ።<verse eid="ISA 11:16"/></para>
  <chapter eid="ISA 11"/>
  <chapter number="12" style="c" sid="ISA 12"/>
  <para style="s1">ፋርፈትና ገለታ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 12:1"/>አት ጋፈስ አከነ ጄተ፦</para>
  <para style="q1" vid="ISA 12:1">“ያ <char style="nd">ዋቀዮ</char>፣ አት ነት ኣርቴ ቱርቴ፤</para>
  <para style="q2" vid="ISA 12:1">ኣሪንኬስ ነራ ዴብኤረ፤</para>
  <para style="q2" vid="ISA 12:1">ነ ጀጀቤስቴርታቲ ስን ገለቴፈዸ።<verse eid="ISA 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 12:2"/>ዹጉማን ዋቅን ፈይነኮት፤</para>
  <para style="q2" vid="ISA 12:2">አን እሰ ነንአብደዸ፤ ህንሶዳዹስ።</para>
  <para style="q1" vid="ISA 12:2">
    <char style="nd">ዋቀዮ</char>፣ <char style="nd">ዋቀዮ</char> መታንሳ፣</para>
  <para style="q2" vid="ISA 12:2">ጀብናፊ ፋርፈትናኮት፤ <optbreak/> እን ፈይነኮ ተኤረ።”<verse eid="ISA 12:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 12:3"/>እስን ቡርቃ ፈይና ኬሳ</para>
  <para style="q2" vid="ISA 12:3">ገመቹዻን ብሻን ወራበቱ።<verse eid="ISA 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 12:4"/>እስን በረ ሰነ ኬሰ አከነ ጄቱ፦</para>
  <para style="q1" vid="ISA 12:4">“<char style="nd">ዋቀዮፍ</char> ገለተ ገልቻ፤ መቃሳ ዋመዻ፤</para>
  <para style="q2" vid="ISA 12:4">ዋን እን ሆጄቴ ሰቦተት ቤክስሳ፤</para>
  <para style="q2" vid="ISA 12:4">አከ መቃንሳ ኦል ኦል ጄዼ ለለባ።<verse eid="ISA 12:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 12:5"/>እን ዋን ኡልፍነ ቀቡ ሆጄቴራቲ <char style="nd">ዋቀዮን</char> ፋርፈዻ፤</para>
  <para style="q2" vid="ISA 12:5">ወን ኩን አዱኛ ሁንደ ኬሰት ሃቤከሙ።<verse eid="ISA 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 12:6"/>ያ ሰበ ጥዮን፣ ቁልቁልች እስራኤል <optbreak/> እስን ግዱት ጉዳዻቲ</para>
  <para style="q2" vid="ISA 12:6">ሰገሌ ኦል ፉዸዻቲ ገመቹዻን ፋርፈዻ።”<verse eid="ISA 12:6"/></para>
  <chapter eid="ISA 12"/>
  <chapter number="13" style="c" sid="ISA 13"/>
  <para style="s1">ራጂ ባብሎኒን ሞርሙ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 13:1"/>ራጂ ዋኤ ባብሎን ከን እሳያስ እልም አሞስ አርጌ፦<verse eid="ISA 13:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 13:2"/>ቱሉ ሆማ እት ህንብቅልንረት</para>
  <para style="q2" vid="ISA 13:2">ፋጂ ኦል ካሳቲ እሳንት እያ፤</para>
  <para style="q1" vid="ISA 13:2">አከ እሳን ከረ ነሞተ</para>
  <para style="q2" vid="ISA 13:2">ቤቤከሞቲን ኦል ገለኒፍ ሀርካን እት ህማ።<verse eid="ISA 13:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 13:3"/>አን ቁልቁሎተኮ አጀጄረ፤</para>
  <para style="q2" vid="ISA 13:3">አከ እሳን ዼከምሰኮ ሆጂረ ና ኦልቸኒፍ</para>
  <para style="q2" vid="ISA 13:3">አን ሎልቶተኮ ከኔን ሞአትኖኮት ገመደን <optbreak/> ዋመዼረ።<verse eid="ISA 13:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 13:4"/>ወጨ ቱሉወንራ፣</para>
  <para style="q2" vid="ISA 13:4">ከን አከ ቱተ ጉዳ ቶኮ ዸጌፈዻ!</para>
  <para style="q1" vid="ISA 13:4">ጉንጉሚ ሞቱሞታ</para>
  <para style="q2" vid="ISA 13:4">ከን ሰቦተ ወልት ቀበመኒ ዸጌፈዻ!</para>
  <para style="q1" vid="ISA 13:4">
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ</para>
  <para style="q2" vid="ISA 13:4">ሎላፍ ጄዼ ሎልቶተ ቆጴፈቻ ጅረ!<verse eid="ISA 13:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 13:5"/>እሳን ብየ ፈጎዻ</para>
  <para style="q2" vid="ISA 13:5">ዳሪ ሰሚወኒቲ ዹፈን፤</para>
  <para style="q1" vid="ISA 13:5">
    <char style="nd">ዋቀዮፊ</char> ምአ ሎላ ከን ዼከምሰሳቲን</para>
  <para style="q2" vid="ISA 13:5">ጉቱማ ብየቲ በሌሱፍ ዹፉ።<verse eid="ISA 13:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 13:6"/>ዋን ጉያን <char style="nd">ዋቀዮ</char> ዽኣቴፍ ቦኣ፤</para>
  <para style="q2" vid="ISA 13:6">ጉያን ሱን አኩመ በዲሰ</para>
  <para style="q2" vid="ISA 13:6">ዋቀ ዋን ሁንደ ደንደኡ ብራ ኤርገሜት ንዹፈ።<verse eid="ISA 13:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 13:7"/>ከናፉ ሀርክ ሁንድኑ ንላምሸአ፤</para>
  <para style="q2" vid="ISA 13:7">ኦኔን ነመ ሁንዳስ ንበቀ።<verse eid="ISA 13:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 13:8"/>ሶዳን እሳን ቀበተ፤</para>
  <para style="q2" vid="ISA 13:8">ዹኩቢፊ ገድ እሳን ቀበተ፤</para>
  <para style="q2" vid="ISA 13:8">አኩመ ዱበርቲ ጭኒንሱን ቀቤት ውጥርፈቱ።</para>
  <para style="q1" vid="ISA 13:8">እሳን ርፈተኒ ወል እላሉ፤</para>
  <para style="q2" vid="ISA 13:8">ፉልሳኒ አከ እብዳ ዲመተ።<verse eid="ISA 13:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 13:9"/>ኩኖ ጉያን <char style="nd">ዋቀዮ</char>፣</para>
  <para style="q2" vid="ISA 13:9">ጉያን ሀማን፣ ዼከምሳፊ ኣሪ ሶዳችሳዻን፣</para>
  <para style="q1" vid="ISA 13:9">ለፈ ኦንሱፊ ጩበሞተ እሼ ኬሰ ጅራተን</para>
  <para style="q2" vid="ISA 13:9">በርበዴሱፍ ንዹፈ።<verse eid="ISA 13:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 13:10"/>ኡርጂወን ሰሚቲፊ ቱትንሳኒ</para>
  <para style="q2" vid="ISA 13:10">እፈሳኒ ህንኬነን።</para>
  <para style="q1" vid="ISA 13:10">አዱን ባቱ ንዱከኖፍት፤</para>
  <para style="q2" vid="ISA 13:10">ጅእስ እፈሼ ህንኬንቱ።<verse eid="ISA 13:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 13:11"/>አን አዱኛ ከነ ሰበቢ ጀልእነሳቲፍ፣</para>
  <para style="q2" vid="ISA 13:11">ሀሞተ ሰበቢ ጩቡሳኒቲፍ ነንአደበ።</para>
  <para style="q1" vid="ISA 13:11">አን ኦፍ ቱሉማ ኦፍ ጀጆታ ነንበሌሰ፤</para>
  <para style="q2" vid="ISA 13:11">ኦፍ ጉድሱ ገረ ጀቤዪሌ ገድን ዴብሰ።<verse eid="ISA 13:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 13:12"/>አን አከ ነምን ወርቄ ቁልቁሉ ጫላ ገት ቀቤሰ፣</para>
  <para style="q2" vid="ISA 13:12">ወርቄ ኦፊር ጫላስ ሙራሰ ተኡ ነንጎዸ።<verse eid="ISA 13:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 13:13"/>ከናፉ አን አከ ሰሚወን ሆለተን ነንጎዸ፤</para>
  <para style="q2" vid="ISA 13:13">ጋፈ ኣሪንሳ ቦበኡት</para>
  <para style="q1" vid="ISA 13:13">ዼከምሰ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡቲን</para>
  <para style="q2" vid="ISA 13:13">ለፍት እዶሼቲ ንራፈምት።<verse eid="ISA 13:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 13:14"/>ነምን ሁንድኑ አኩመ ኩሩጴ አደምሰምቱ፣</para>
  <para style="q2" vid="ISA 13:14">አኩመ ሆሎተ ትክሴ ህንቀብኔ</para>
  <para style="q1" vid="ISA 13:14">ገረ ሰበሳት ዴብአ፤</para>
  <para style="q2" vid="ISA 13:14">ነምን ከምዩ ብየሳት በቀተ።<verse eid="ISA 13:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 13:15"/>ነምን ቦጅአሜ ሁንድኑ ንወራነመ፤</para>
  <para style="q2" vid="ISA 13:15">ከን ቀበሜ ከምዩ ጎራዴዻን ዱአ።<verse eid="ISA 13:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 13:16"/>ዳእመንሳኒ ፉሉመሳኒ ዱረት ንጭጭረሙ፤</para>
  <para style="q2" vid="ISA 13:16">መኔንሳኒ ንሳመሙ፤ <optbreak/> ኒቶትንሳኒስ ሁምናን ጉዴደሙ።<verse eid="ISA 13:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 13:17"/>ኩኖ አን ወረ ሜዴ</para>
  <para style="q2" vid="ISA 13:17">ከኔን ሜቲራ ዽመ ህንቀብኔ</para>
  <para style="q2" vid="ISA 13:17">ወረ ወርቄን ህንገመቺፍኔ ጀረትን ከካሰ።<verse eid="ISA 13:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 13:18"/>እዳንሳኒ ደርገጎተ ፍጥ፤</para>
  <para style="q2" vid="ISA 13:18">እሳን ዳእመኒፍ ህንነአን፤</para>
  <para style="q2" vid="ISA 13:18">እጆሌፍስ ገራ ህንላፈን።<verse eid="ISA 13:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 13:19"/>ባብሎን ኡልፍን ሞቶታ፣</para>
  <para style="q2" vid="ISA 13:19">ሚዸግን ኦፍ ጀጀ ወረ ባብሎን</para>
  <para style="q1" vid="ISA 13:19">አኩመ ሶዶሚፊ ጎሞራ</para>
  <para style="q2" vid="ISA 13:19">እሬ ዋቃቲን ገረገልፈምት።<verse eid="ISA 13:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 13:20"/>ነምን እሼ ኬሰ ህንቁበቱ፤</para>
  <para style="q2" vid="ISA 13:20">ዮካን ዸሎተ ሁንደ ኬሰት <optbreak/> ነምን እሼ ኬሰ ህንጅራቱ፤</para>
  <para style="q1" vid="ISA 13:20">ነምን አረባ ቶኮዩ ዱንካነሳ አች ህንዻበቱ፤</para>
  <para style="q2" vid="ISA 13:20">ትክሴን ቶኮዩ ቡሻዬሳ አች ህንቦቆቺፈቱ።<verse eid="ISA 13:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 13:21"/>ገሩ ብኔንሶትን ቦሶና አች ጭጪሱ፤</para>
  <para style="q2" vid="ISA 13:21">ዋንጎወን መነሼ ንጉቱ፤</para>
  <para style="q1" vid="ISA 13:21">ኡሩንጉን አች ጅራት፤</para>
  <para style="q2" vid="ISA 13:21">ሬኤን ዲዳ አች ኬሰ ቡቡራቅጥ።<verse eid="ISA 13:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 13:22"/>ወራቤስ ደአኖወንሼ ኬሳ ዩሰ፤</para>
  <para style="q2" vid="ISA 13:22">ዋንጎንስ መኔንሼ ምሚዸጎ ከን ሞቱማ <optbreak/> ኬሳ እይት።</para>
  <para style="q1" vid="ISA 13:22">ዬሮንሼ ገኤረ፤</para>
  <para style="q2" vid="ISA 13:22">በርሼስ ህንዼረቱ።<verse eid="ISA 13:22"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 13"/>
  <chapter number="14" style="c" sid="ISA 14"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 14:1"/>
    <char style="nd">ዋቀዮ</char> ያቆቢፍ ገራ ንላፈ፤</para>
  <para style="q2" vid="ISA 14:1">እን አመሌ እስራኤልን ፍለቴ</para>
  <para style="q2" vid="ISA 14:1">ብየሳኒ ኬሰ እሳን ቁበቺሰ።</para>
  <para style="q1" vid="ISA 14:1">ኦርሞትን እሳንት ደበለሙ፤</para>
  <para style="q2" vid="ISA 14:1">መነ ያቆብ ወጅንስ ቶኮ ተኡ።<verse eid="ISA 14:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 14:2"/>ሰቦትን እሳን ፉዸቱ፤</para>
  <para style="q2" vid="ISA 14:2">እዶ ኦፊሳኒት እሳን ዴብሱ።</para>
  <para style="q1" vid="ISA 14:2">መን እስራኤልሞ አኩመ ሆጄቶተ ዺራፊ ዱበርቲት</para>
  <para style="q2" vid="ISA 14:2">ለፈ <char style="nd">ዋቀዮ</char> ኬሰት ዻለ ጎዸኒ እሳን ፉዸቱ።</para>
  <para style="q1" vid="ISA 14:2">እሳን ቦጅቶተሳኒ ቦጅአኒ</para>
  <para style="q2" vid="ISA 14:2">ወረ እሳን ሀጩጨንስ ቡልቹ።<verse eid="ISA 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 14:3"/>ጉያ <char style="nd">ዋቀዮ</char> እት ዽጵነ፣ ረክናፊ ሆጂ ሀማ እስን እት ገርቦምፈምተኒ ቱርተን ሰነ ጀላ እስን ቦቆቺሱት፣ <verse eid="ISA 14:3"/><verse number="4" style="v" sid="ISA 14:4"/>አከነ ጄቴ ሞቲ ባብሎንት ንቆስተ፦</para>
  <para style="q1" vid="ISA 14:4">ጩንቁርስች አከምት በዴ!</para>
  <para style="q2" vid="ISA 14:4">ኣሪንሳስ አከምት እሰራ ገሌ!<verse eid="ISA 14:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 14:5"/>
    <char style="nd">ዋቀዮ</char> ኡሌ ሀሞታቲፊ</para>
  <para style="q2" vid="ISA 14:5">ቦኩ ቡልችቶታ፣<verse eid="ISA 14:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 14:6"/>ከን ዼከምሰ ወልራ ህንጭኔቲን</para>
  <para style="q2" vid="ISA 14:6">ኡመተ ሩኩቴ፤</para>
  <para style="q1" vid="ISA 14:6">ከን ገረ ላፍነ ቶኮ መሌ አርኤ</para>
  <para style="q2" vid="ISA 14:6">ሰቦተ ዸኤ ሰነ ጨጨብሴረ።<verse eid="ISA 14:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 14:7"/>ለፍት ሁንድ ቦቆናፊ ነጋ አርገት፤</para>
  <para style="q2" vid="ISA 14:7">ፋርፈቹትስ ካት።<verse eid="ISA 14:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 14:8"/>ጋትራወኒፊ ብርብርሰወን</para>
  <para style="q2" vid="ISA 14:8">ልባኖንዩ እስንት ቡራቀኒ፣</para>
  <para style="q1" vid="ISA 14:8">“አመ አት ኩፍቴርተ፤</para>
  <para style="q2" vid="ISA 14:8">ነምን ቶኮዩ ኑ ሙሩፍ ህንዹፉ” ጄዹ።<verse eid="ISA 14:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 14:9"/>ሲኦል እሼን ገዲ ዬሮ አት ዹፍቱት ስ ስመቹፍ ካት፤</para>
  <para style="q2" vid="ISA 14:9">እሼን አከ እሳን ስ ዱብሰኒፍ ሀፉሮተ ወረ ዱአኒ፣</para>
  <para style="q1" vid="ISA 14:9">ወረ አዱኛረት ሆገንቶተ</para>
  <para style="q2" vid="ISA 14:9">ቱረኒ ሁንደ ደመቅስቴርት፤</para>
  <para style="q1" vid="ISA 14:9">እሼን ወረ ሞቶተ ሰቦታ ቱረን ሁንደ</para>
  <para style="q2" vid="ISA 14:9">ቴሶሳኒራ ካፍት።<verse eid="ISA 14:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 14:10"/>እሳን ሁንድኑ ዴብሰኒ አከነ ጄዹ፤</para>
  <para style="q2" vid="ISA 14:10">“አትስ አኩመኬኘ ደዸብዴርተ፤</para>
  <para style="q2" vid="ISA 14:10">አኩመኬኘ ታቴርተ።”<verse eid="ISA 14:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 14:11"/>ኡልፍንኬ ሁንድኑ፣ ሰገሌ በገናኬቲ ወጅን</para>
  <para style="q2" vid="ISA 14:11">አዋለ ኬሰ ቡፈሜረ፤</para>
  <para style="q1" vid="ISA 14:11">እልማን ራሞ ስ ጀለ አፈመኒ</para>
  <para style="q2" vid="ISA 14:11">ራሞን ስ ሀጉግድ።<verse eid="ISA 14:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 14:12"/>ያ በከልቸ በሪ፣ እልመ በሪ በራቃ፣</para>
  <para style="q2" vid="ISA 14:12">አት አከምት ሰሚራ ለፈ ዾፍቴ!</para>
  <para style="q1" vid="ISA 14:12">አት ከን ዱራን ሰቦተ ገድ ቀብዴ፣</para>
  <para style="q2" vid="ISA 14:12">ለፈት ገድ ደርበተምቴርተ!<verse eid="ISA 14:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 14:13"/>አት ገራኬት አከነ ጄቴ፤</para>
  <para style="q2" vid="ISA 14:13">“አን ሰሚት ኦልን በአ፤</para>
  <para style="q1" vid="ISA 14:13">አን ኡርጂወን ዋቃቲ ኦልት</para>
  <para style="q2" vid="ISA 14:13">ቴሶኮ ኦልን ባፈዸ፤</para>
  <para style="q1" vid="ISA 14:13">አን ቱሉ ወል ገኢረ፣</para>
  <para style="q2" vid="ISA 14:13">ፊጤ ቱሉ ቁልቁልቻረ ቴሶረ ነንታአ።<verse eid="ISA 14:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 14:14"/>አን ፊጤ ዱሜሶታ ገረራት ኦል ነንበአ፤</para>
  <para style="q2" vid="ISA 14:14">አን አከ ዋቀ ዋን ሁንዳ ኦሊ ኦፍን ታስሰ።”<verse eid="ISA 14:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 14:15"/>ገሩ አት ሲኦል ኬሰ፣</para>
  <para style="q2" vid="ISA 14:15">ቦለ ቅሌ ኬሰ ቡፈምቴርተ።<verse eid="ISA 14:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 14:16"/>ወር ስ አርገን እጀ በባሰኒ ስ እላሉ፤</para>
  <para style="q2" vid="ISA 14:16">አከነ ጄዸኒስ ድንቅሲፈቱ፦</para>
  <para style="q1" vid="ISA 14:16">“ኩን ነምቹመ ለፈ ሶቾሴ</para>
  <para style="q2" vid="ISA 14:16">አከ ሞቱሞን ራፈመን ጎዼ፣<verse eid="ISA 14:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 14:17"/>ነምቸ አዱኛ ከነ ገሞጂ ጎዼ፣</para>
  <para style="q2" vid="ISA 14:17">ከን መጋላወንሼ ገገረገልቼ</para>
  <para style="q2" vid="ISA 14:17">አከ ወር ቦጅአመን መነሳኒት ህንዴብኔ ጎዼ ሰና?”<verse eid="ISA 14:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 14:18"/>ሞቶትን ሰቦታ ሁንድ፣</para>
  <para style="q2" vid="ISA 14:18">ኡልፍናን አዋለሳኒ ኬሰ ጭጪሰኒሩ።<verse eid="ISA 14:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 14:19"/>አት ገሩ አኩመ ደሜ ጅበሜ ቶኮት፣</para>
  <para style="q2" vid="ISA 14:19">አዋለኬ ኬሳ ባፈምቴ ገተምቴርተ፤</para>
  <para style="q1" vid="ISA 14:19">አት ወረ አጄፈመኒን፣</para>
  <para style="q2" vid="ISA 14:19">ወረ ጎራዴን ወራነመኒን፣</para>
  <para style="q2" vid="ISA 14:19">ወረ ገረ ዸጋ ቦላት ገድ ቡአኒን ሀጉገምቴርተ።</para>
  <para style="q1" vid="ISA 14:19">አኩመ ሬፋ ሚላን ዽዺተምቴርተ፤<verse eid="ISA 14:19"/></para>
  <para style="q2">
    <verse number="20" style="v" sid="ISA 14:20"/>አት ሰበቢ ብየኬ በሌስቴ</para>
  <para style="q1" vid="ISA 14:20">ነሞተኬ ፍጤፍ፣</para>
  <para style="q2" vid="ISA 14:20">እሳን ግዱት ህንአዋለምቱ።</para>
  <para style="b" vid="ISA 14:20"/>
  <para style="b" vid="ISA 14:20"/>
  <para style="q1" vid="ISA 14:20">መቃን ሰኚ ሀሞታ</para>
  <para style="q2" vid="ISA 14:20">ለመተ ህንዸአሙ።<verse eid="ISA 14:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 14:21"/>ሰበቢ ጩቡ አቦቲሳኒቲፍ</para>
  <para style="q2" vid="ISA 14:21">እዶ እልማንሳ እት ቀለመን ቆጴሳ፤</para>
  <para style="q1" vid="ISA 14:21">እሳን ብየ ዻሉዻፍ፣</para>
  <para style="q2" vid="ISA 14:21">መጋላወንሳኒቲንስ ለፈ ጉቱፍ ህንከአን።<verse eid="ISA 14:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 14:22"/>“አን እሳንት ነንከአ፣”</para>
  <para style="q2" vid="ISA 14:22">ጄዸ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ።</para>
  <para style="q1" vid="ISA 14:22">“አን ባብሎን ኬሳ መቃሼቲፊ ሀምባሼ፣</para>
  <para style="q2" vid="ISA 14:22">እልማንሼቲፊ ሰኚሼ ነንበሌሰ”</para>
  <para style="q2" vid="ISA 14:22">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="ISA 14:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 14:23"/>“አን እዶ ኡሩንጉን ኬሰ ጅራቱፊ</para>
  <para style="q2" vid="ISA 14:23">ለፈ ጨፌ እሼ ነንጎዸ፤</para>
  <para style="q1" vid="ISA 14:23">አን ሀርቱ በዲሳቲን እሼ ነንሀጣአ”</para>
  <para style="q2" vid="ISA 14:23">ጄዸ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ።<verse eid="ISA 14:23"/></para>
  <para style="s1">ራጂ አሶሪን ሞርሙ</para>
  <para style="p">
    <verse number="24" style="v" sid="ISA 14:24"/>
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ አከነ ጄዼ ከከቴረ፤</para>
  <para style="q1" vid="ISA 14:24">“ዹጉማን አኩመ አን ዱራን ከሮርፈዼ ሰነ<optbreak/> ወን ኩን ንተአ፤</para>
  <para style="q2" vid="ISA 14:24">አኩመ አን ያዴ ሰነስ ንዻበተ።<verse eid="ISA 14:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 14:25"/>አን ብየኮ ኬሰት አሶሮተ ነንበርበዴሰ፤</para>
  <para style="q2" vid="ISA 14:25">ቱሉወንኮረት አን እሰ ገድን ዽዺተ።</para>
  <para style="q1" vid="ISA 14:25">ዋንጆንሳ ሰበኮራ ንፉዸመ፤</para>
  <para style="q2" vid="ISA 14:25">በኣንሳስ ገቲቲሳኒራ ንቡአ።”<verse eid="ISA 14:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 14:26"/>ከሮር ጉቱማ አዱኛቲፍ ሙርታኤ ከናዸ፤</para>
  <para style="q2" vid="ISA 14:26">ኩን ሀርከ ሰቦተ ሁንደረት ድሪርፈሜዸ።<verse eid="ISA 14:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 14:27"/>
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ</para>
  <para style="q2" vid="ISA 14:27">ዋን ከነ ያዴራቲ፣ ኤኙቱ እሰ ገረ ገልቸ?</para>
  <para style="q1" vid="ISA 14:27">ሀርክሳ ድሪርፈሜራ፤</para>
  <para style="q2" vid="ISA 14:27">ኤኙቱ ዱበት እሰ ዴብሱ ደንደአ?<verse eid="ISA 14:27"/></para>
  <para style="s1">ራጂ ፍልስጤሞታን ሞርሙ</para>
  <para style="p">
    <verse number="28" style="v" sid="ISA 14:28"/>ራጂን ኩን በረ ኣሃዝ ሞትች ዱኤ ኬሰ ዹፌ፦<verse eid="ISA 14:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 14:29"/>ያ ፍልስጤሞተ፣ ኡሌን እስን ዸኤ ዋን ጨቤፍ፣</para>
  <para style="q2" vid="ISA 14:29">እስን ሁንድኑ ህንገመድና፤</para>
  <para style="q1" vid="ISA 14:29">ህደ ቦፈ ሰና ኬሳ ቡቲቱ በአ፤</para>
  <para style="q2" vid="ISA 14:29">እጅሳ ቦፈ ደርበተማ ሱሚ ቀቡ ንተአ።<verse eid="ISA 14:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 14:30"/>ህዬስ ገደደማን እዶ እት ቦበኡ አርገተ፤</para>
  <para style="q2" vid="ISA 14:30">ረከታንስ ነጋዻን ጪሰ።</para>
  <para style="q1" vid="ISA 14:30">ህደኬ ገሩ አን ቤላን ነንበርበዴሰ፤</para>
  <para style="q2" vid="ISA 14:30">ቤልስ ሀምባኬ ንፍጠ።<verse eid="ISA 14:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 14:31"/>ያ ከረ፣ አት ቦእ! ያ መጋላ፣ እይ!</para>
  <para style="q2" vid="ISA 14:31">ፍልስጤሞትን ሁንድ በቃቲ በዳ!</para>
  <para style="q1" vid="ISA 14:31">ዱሜስ ኣራ ቶኮ ከራ ካባቲን ንዹፈ፤</para>
  <para style="q2" vid="ISA 14:31">ራያ ወራነሳ ኬሰስ ከን ጭቴ ሀፉ ቶኮዩ ህንጅሩ።<verse eid="ISA 14:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="ISA 14:32"/>ኤርገሞተ ሰበ ሰናቲፍ</para>
  <para style="q2" vid="ISA 14:32">ዴቢ አከሚቱ ኬነሙ መለ?</para>
  <para style="q1" vid="ISA 14:32">“<char style="nd">ዋቀዮ</char> ጀቤሴ ጥዮንን ዻቤረ፤</para>
  <para style="q2" vid="ISA 14:32">እሼ ኬሰትስ ነሞትንሳ ከኔን ሚዸመን <optbreak/> ደአትኖ ንአርገቱ።”<verse eid="ISA 14:32"/></para>
  <chapter eid="ISA 14"/>
  <chapter number="15" style="c" sid="ISA 15"/>
  <para style="s1">ራጂ ሞኣቢን ሞርሙ</para>
  <para style="r">
    <ref loc="ISA 16:6-12">16፥6‑12</ref> ኩወፈ – <char style="xt"><ref loc="JER 48:29-36">ኤር 48፥29‑36</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 15:1"/>ራጂ ዋኤ ሞኣብ፦</para>
  <para style="q1" vid="ISA 15:1">ኣር እሼን ሞኣብ ኬሳ ዲገምቴርት፤</para>
  <para style="q2" vid="ISA 15:1">ሀልከኑመ ቶኮትስ በዴርት!</para>
  <para style="q1" vid="ISA 15:1">ቂር እሼን ሞኣብ ኬሳ ዲገምቴርት፤</para>
  <para style="q2" vid="ISA 15:1">ሀልከኑመ ቶኮትስ በዴርት!<verse eid="ISA 15:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 15:2"/>ዲቦን ገረ መነ ቁልቁሉማት፣</para>
  <para style="q2" vid="ISA 15:2">እዶወን ኦል ከኣት ቦኡፍ ኦል በአ፤</para>
  <para style="q2" vid="ISA 15:2">ሞኣብስ ኔቦፊ ሜዴባፍ ንቦአ።</para>
  <para style="q1" vid="ISA 15:2">መታን ሁንድኑ ሃደማዸ፤</para>
  <para style="q2" vid="ISA 15:2">አሬድን ሁንድኑስ ጭጭረማዸ።<verse eid="ISA 15:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 15:3"/>እሳን ዳንዲረት ወያ ገዳ ኡፈቱ፤</para>
  <para style="q2" vid="ISA 15:3">በንቲ መናቲፊ ወልተጂ ሰባረት</para>
  <para style="q1" vid="ISA 15:3">ሁንድሳኒ ንቦኡ፤</para>
  <para style="q2" vid="ISA 15:3">እምማንሳኒስ ንዸንገላሱ።<verse eid="ISA 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 15:4"/>ሄሽቦኒፊ ኤሌኣሌን ንእዩ፤</para>
  <para style="q2" vid="ISA 15:4">ሰገሌንሳኒስ ሀመ ያሀዚት ፈጋቴ ዸገአሜ።</para>
  <para style="q1" vid="ISA 15:4">ከናፉ ሎልቶትን ሞኣብ ንእዩ፤</para>
  <para style="q2" vid="ISA 15:4">ሉቡንሳኒስ ንሮምእቴ።<verse eid="ISA 15:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 15:5"/>ገራንኮ ሞኣቢፍ እየ፤</para>
  <para style="q2" vid="ISA 15:5">ኮሉ ገልቶትንሼ ሀመ ዞኣሪት፣</para>
  <para style="q2" vid="ISA 15:5">ሀመ ኤግላት ሼልሽያት በቀቱ።</para>
  <para style="q1" vid="ISA 15:5">እሳን ቦኣ፣ ገረ ሉሂትት ኦል በኡ፤</para>
  <para style="q2" vid="ISA 15:5">ከራ ሆሮናይምረትስ፣</para>
  <para style="q2" vid="ISA 15:5">ዋኤ በዲሳኒ ፋርሰኒ ቦኡ።<verse eid="ISA 15:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 15:6"/>ብሻኖትን ኒምሪም ጎገኒሩ፤</para>
  <para style="q2" vid="ISA 15:6">መርግስ ጮለጌረ፤</para>
  <para style="q1" vid="ISA 15:6">ብቅልቱወን ለፋ በደኒሩ፤</para>
  <para style="q2" vid="ISA 15:6">ወን መገሪስን ቶኮዩ ህንሀፍኔ።<verse eid="ISA 15:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 15:7"/>ከናፉ እሳን ቀቤኘ አርገተኒ ኩፈተን ሰነ</para>
  <para style="q2" vid="ISA 15:7">ለገ አለልቱ እራን ባተኒ ደበርፈቱ።<verse eid="ISA 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 15:8"/>እይሳኒ ሀመ ዳሪ ሞኣብት ዸገአሜ፤</para>
  <para style="q2" vid="ISA 15:8">ወዋቹንሳኒ ሀመ ኤግለዪምት</para>
  <para style="q2" vid="ISA 15:8">ፋሩን ቦእቸሳኒስ ሀመ ቤኤር ኤሊሚንት ዸገአሜ።<verse eid="ISA 15:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 15:9"/>ብሻኖትን ዲሞን ዺጋን ጉተመኒሩ፤</para>
  <para style="q2" vid="ISA 15:9">አንሞ ዋን ከነ ጫሉዩ ዲሞንት ነንፍደ፤</para>
  <para style="q1" vid="ISA 15:9">ወረ ሞኣብ ኬሳ በቀተን</para>
  <para style="q2" vid="ISA 15:9">ከኔን ብየ ሰነት ሀፈንት ሌንጨ ነንኤርገ።<verse eid="ISA 15:9"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 15"/>
  <chapter number="16" style="c" sid="ISA 16"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 16:1"/>ሴላ፣ ገሞጂ ገመ ጅርቱ ሰነራ</para>
  <para style="q2" vid="ISA 16:1">ቡልቻ ብየቲቲፍ፣</para>
  <para style="q1" vid="ISA 16:1">ገረ ቱሉ እንተለ ጥዮንት</para>
  <para style="q2" vid="ISA 16:1">ጦባላወን ሆላ ግብረ ኤርጋ።<verse eid="ISA 16:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 16:2"/>አኩመ ስምብረ መንኤሼ ኬሳ አርአምቴ</para>
  <para style="q2" vid="ISA 16:2">አሲፊ አች ፊግዱ ዱበርቶትን ሞኣብስ</para>
  <para style="q2" vid="ISA 16:2">መልካ ለገ አርኖንት አከሱመ ተኡ።<verse eid="ISA 16:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 16:3"/>“ጎርሰ ኑፍ ኬና፤ ሙርቲ ሙርቴሳ።</para>
  <para style="q2" vid="ISA 16:3">ጉያ ሳፋዻን ጋድዱኬሰን</para>
  <para style="q2" vid="ISA 16:3">አኩመ ሀልከኒ ዱከኔሳ።</para>
  <para style="q1" vid="ISA 16:3">በቀቶተስ ዾክሳ፤</para>
  <para style="q2" vid="ISA 16:3">ኮሉ ገልቶተ ህንገንና።<verse eid="ISA 16:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 16:4"/>በቀቶትን ሞኣብ እስን ወጅን ሃጅራተን፤</para>
  <para style="q2" vid="ISA 16:4">በሌስቱራ ደኦ እሳኒፍ ተኣ።”</para>
  <para style="b" vid="ISA 16:4"/>
  <para style="q1" vid="ISA 16:4">ጩንቁርሳን ንበደ፤</para>
  <para style="q2" vid="ISA 16:4">በዲስንስ ንሀፈ፤</para>
  <para style="q2" vid="ISA 16:4">ወር ነመ ሚዸን ለፈራ በዱ።<verse eid="ISA 16:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 16:5"/>ቴሶን ጃለላን ሁንዴፈመ፤</para>
  <para style="q2" vid="ISA 16:5">መነ ዳዊት ኬሳ ነምን ሙርቲ ኬኑረት</para>
  <para style="q2" vid="ISA 16:5">ሙርቲ ቀጄላ በርባዱ፣</para>
  <para style="q1" vid="ISA 16:5">ከን ዋን ቀጄላ ሆጄቹፍ አሪፈቱ ቶኮ</para>
  <para style="q2" vid="ISA 16:5">አመነሙማዻን ቴሶ ሰነረ ንታአ።<verse eid="ISA 16:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 16:6"/>ኑ ኦፍ ቱሉማ ሞኣብ፣</para>
  <para style="q2" vid="ISA 16:6">ኦፍ ጉድሱፊ ኮሩሼ፣</para>
  <para style="q1" vid="ISA 16:6">ኦፍ ቱሉፊ አደጌ ተኡሼ ዸጌኜረ፤</para>
  <para style="q2" vid="ISA 16:6">ኦፍ ጀጁንሼ ገሩ ፋይዳ ህንቀቡ።<verse eid="ISA 16:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 16:7"/>ከናፉ ሞኣቦን ንቦኡ፤</para>
  <para style="q2" vid="ISA 16:7">እሳን ቶኩማዻን ሞኣቢፍ ቦኡ።</para>
  <para style="q1" vid="ISA 16:7">ነሞተ ቂር ሀሬሼቲፍ</para>
  <para style="q2" vid="ISA 16:7">ፋርሰኒ ቦኡዻን ገዱ።<verse eid="ISA 16:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 16:8"/>ለፍት ቆቲሳ ሄሽቦን፣</para>
  <para style="q2" vid="ISA 16:8">ሙክን ወይኒ ስብማስ ጮለጌረ።</para>
  <para style="q1" vid="ISA 16:8">ቡልችቶትን ሰቦታ</para>
  <para style="q2" vid="ISA 16:8">ሙኬን ወይኒ ፍለተሞ</para>
  <para style="q1" vid="ISA 16:8">ከኔን ዱራን የእዜርን ገአኒ</para>
  <para style="q2" vid="ISA 16:8">ገረ ገሞጂት በበልአተን ዽዺተኒሩ።</para>
  <para style="q2" vid="ISA 16:8">ለታንሳኒ ዼረቴ ሀመ ገላናት ድሪሬ።<verse eid="ISA 16:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 16:9"/>ከናፉ አን አኩመ የእዜር ቦሴ ሰነ፣</para>
  <para style="q2" vid="ISA 16:9">ሙኬን ወይኒ ስብማቲፍ ነንቦአ።</para>
  <para style="q1" vid="ISA 16:9">ያ ሄሽቦን፣ ያ ኤሌኣሌ፣</para>
  <para style="q2" vid="ISA 16:9">አን እምማንኮቲን ስን ጂሰ!</para>
  <para style="q1" vid="ISA 16:9">እልሌን ዬሮ ምዻን ሲፍ ገኤቲፊ</para>
  <para style="q2" vid="ISA 16:9">ገመቹን ዬሮ ምዻን ሲፍ <optbreak/> ሃመሙ ቱሬ ሱን ሀፌረ።<verse eid="ISA 16:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 16:10"/>እልልቹፊ ገመዱን እዶ ብቅልቱ ኬሳ በደኒሩ፤</para>
  <para style="q2" vid="ISA 16:10">ነምን ቶኮዩ እዶ ዻባ ወይኒ ኬሰት <optbreak/> ህንፋርፈቱ ዮካን ህንእልልቹ፦</para>
  <para style="q1" vid="ISA 16:10">ሰበቢ አን እልሌ በሌሴፍ</para>
  <para style="q2" vid="ISA 16:10">ነምን እዶ ወይኒ እት ጩንፈንት ወይኒ ዽዺቱ ቶኮ ህንጅሩ።<verse eid="ISA 16:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 16:11"/>ገራንኮ አኩመ በገና ፋርሴ ሞኣቢፍ ቦአ፤</para>
  <para style="q2" vid="ISA 16:11">ኬስኮስ ቂር ሀሬሼቲፍ ቦአ።<verse eid="ISA 16:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 16:12"/>ሞኣብ ዮ እዶ ኦል ከኣት ሙልአቴ፣</para>
  <para style="q2" vid="ISA 16:12">እሼን ኦፉመ ደዸብሲፍት፤</para>
  <para style="q1" vid="ISA 16:12">ዮ ከዸናፍ ገረ እዶ ቁልቁሉሼ ዸቅጤ</para>
  <para style="q2" vid="ISA 16:12">ኩንስ ፋይዳ ቶኮሌ ህንቀቡ።<verse eid="ISA 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 16:13"/>ኩን ዱቢ <char style="nd">ዋቀዮ</char> ዱራኑ ዋኤ ሞኣብ ዱበቴዸ። <verse eid="ISA 16:13"/><verse number="14" style="v" sid="ISA 16:14"/><char style="nd">ዋቀዮ</char> ገሩ አመ አከነ ጄዸ፦ “ወጋ ሰዲ ኬሰት፣ ኡልፍን ሞኣቢፊ ነሞትንሼ ሄዱን ሁንድ አኩመ ሆጄታን ቶኮ ጉያሳ ለካአቱ ሰነ ንቱፈተሙ፤ ከኔን ሀፈንስ አከ መሌ ሙራሳፊ ደዸቦ ተኡ።”<verse eid="ISA 16:14"/></para>
  <chapter eid="ISA 16"/>
  <chapter number="17" style="c" sid="ISA 17"/>
  <para style="s1">ራጂ ደማስቆዻን ሞርሙ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 17:1"/>ራጂ ደማስቆዻን ሞርሙ፦</para>
  <para style="q1" vid="ISA 17:1">“ኩኖ፣ ደማስቆን ቱላ ዲገምቴ ታት መሌ</para>
  <para style="q2" vid="ISA 17:1">ስአች መጋላ ህንታቱ።<verse eid="ISA 17:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 17:2"/>መጋላወን አሮኤር ንኦኑ፤</para>
  <para style="q2" vid="ISA 17:2">ቡሻዬን አች ጭጪሱ፤</para>
  <para style="q2" vid="ISA 17:2">ወን እሳን ሶዳችሱ ቶኮዩ ህንጅሩ።<verse eid="ISA 17:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 17:3"/>መጋላን ጀቤፈምቴ እጃረምቴ ኤፍሬም ኬሳ፣</para>
  <para style="q2" vid="ISA 17:3">ሁምን ሞቱማስ ደማስቆ ኬሳ ንበደ፤</para>
  <para style="q1" vid="ISA 17:3">ሀምባን ሶርያ አከ ኡልፍነ እስራኤሎታ ተአ”</para>
  <para style="q2" vid="ISA 17:3">ጄዸ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ።<verse eid="ISA 17:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 17:4"/>“በረ ሰነ ኬሰ ኡልፍን ያቆብ ገድ ዴብአ፤</para>
  <para style="q2" vid="ISA 17:4">ፉርድን ዸግነሳስ ንሁቀተ።<verse eid="ISA 17:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 17:5"/>አኩመ ነምን ምዻን ሃሙ ቶኮ፣</para>
  <para style="q2" vid="ISA 17:5">ምዻን ዻበቱ ወልት ቀቤ እሬሳቲን ሃሙ ሰነ</para>
  <para style="q1" vid="ISA 17:5">ኩንስ አኩመ ዬሮ ነምን ቶኮ</para>
  <para style="q2" vid="ISA 17:5">ሱሉለ ሬፋይም ኬሳ ቀርሚ ፉናኑ ንተአ።<verse eid="ISA 17:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 17:6"/>ተኡስ አኩመ ዬሮ ሙክን ኤጄርሳ ዸአሙት፣</para>
  <para style="q2" vid="ISA 17:6">ቀርሚ ጉሩን አመዩ ጅረ፤</para>
  <para style="q1" vid="ISA 17:6">ፊጤ ኦል ኣኑረት ጉማ ለመ ዮካን ሰዲቱ ሀፈ፤</para>
  <para style="q2" vid="ISA 17:6">ደሜ ገድ ኣኑረት ጉማ አፉር ዮካን ሸንቱ ሀፈ”</para>
  <para style="q2" vid="ISA 17:6">ጄዸ <char style="nd">ዋቀዮ</char>፣ ዋቅን እስራኤል።<verse eid="ISA 17:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 17:7"/>ጋፈስ ነሞትን ገረ ኡማሳኒ እላሉ፤</para>
  <para style="q2" vid="ISA 17:7">እጀሳኒስ ገረ ቁልቁልቸ እስራኤል ዴብፈቱ።<verse eid="ISA 17:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 17:8"/>እሳን ገረ እዶ ኣርሳ፣</para>
  <para style="q2" vid="ISA 17:8">ገረ ሆጂ ሀርከሳኒ ህንእላለን፤</para>
  <para style="q1" vid="ISA 17:8">እሳን ገልመ ዋቄፈትና ኣሼራ፣</para>
  <para style="q2" vid="ISA 17:8">እዶ ኣርሳ እጣና ከን ቁበሳኒቲን ቶልቸንስ <optbreak/> ወይቱ ህንለካአን።<verse eid="ISA 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 17:9"/>ጋፈስ መጋላወን ጀጀቦን እሳን ሰበቢ እስራኤሎታቲፍ ኬሳ በአን ሱን አኩመ ለፈ ቦሶነ ኬሳ ከን ነምን ዺሴ ዴሜ ተኡ። ሁንድ ንኦኑ።<verse eid="ISA 17:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 17:10"/>አት ፈይሳኬ፣ ዋቀ እራንፈቴርተ፤</para>
  <para style="q2" vid="ISA 17:10">አት ከታ፣ ደኦኬ ህንያደትኔ።</para>
  <para style="q1" vid="ISA 17:10">ከናፉ ዮ ብቅልቱ አከ መሌ ጋሪ ዻበቴ</para>
  <para style="q2" vid="ISA 17:10">ሙከ ወይኒ ከን አላ ዹፌ ብቅልፈቴዩ፣<verse eid="ISA 17:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 17:11"/>ዮ ጉዩመ ዻብዴ ሰነ አከ እን ብቅሉ ጎቴዩ</para>
  <para style="q2" vid="ISA 17:11">ገነመ ዬሮ ዻብዴት አከ እን ደራሩ ጎተ፤</para>
  <para style="q1" vid="ISA 17:11">ገሩ ጉያ ዹኩባፊ ዽቤ ህንፈይኔት</para>
  <para style="q2" vid="ISA 17:11">ወይንች ሆማ ህንፈየዱ።<verse eid="ISA 17:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 17:12"/>ሰቦተ ባይኤ ከኔን ኣረኒፍ ወዮ!</para>
  <para style="q2" vid="ISA 17:12">እሳን አኩመ ገላነ ኣሩት ኣሩ!</para>
  <para style="q1" vid="ISA 17:12">ሰቦተ ወጨኒፍ ወዮ!</para>
  <para style="q2" vid="ISA 17:12">እሳን አኩመ ብሻን ጉዳን ሁርሱት ሁርሱ።<verse eid="ISA 17:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 17:13"/>ሰቦትን አኩመ ሁርሳ ብሻን ጨብሴ ዴሙ</para>
  <para style="q2" vid="ISA 17:13">ዮ ሁርሴዩ ዮሙ እን እሳንት ዼከሙ <optbreak/> እሳን በቀተኒ በዱ፤</para>
  <para style="q1" vid="ISA 17:13">አኩመ ሀበቂን ቱሉራ ፉለ ቡቤ ዱረ አርአሙ፣</para>
  <para style="q2" vid="ISA 17:13">አኩመ አዋር ፉለ ቡቤ ሀማ ዱራ ብትናኡ <optbreak/> እሳን ንብትናኡ።<verse eid="ISA 17:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 17:14"/>ገልገለ ሶዳን አኩመ ተሳ እሳን ቀበት!</para>
  <para style="q2" vid="ISA 17:14">እሳን ኡቱ ለፍት ህንበርእን ንዸበሙ!</para>
  <para style="q1" vid="ISA 17:14">ኩን ቆደ ወረ ኑ ቦጅኤ፣</para>
  <para style="q2" vid="ISA 17:14">ህሬ ወረ ኑ ሳሜት።<verse eid="ISA 17:14"/></para>
  <chapter eid="ISA 17"/>
  <chapter number="18" style="c" sid="ISA 18"/>
  <para style="s1">ራጂ እቶጵያዻን ሞርሙ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 18:1"/>ብየ ለጌን እቶጵያቲን ገማ</para>
  <para style="q2" vid="ISA 18:1">ከን ቆቾሼቲን ሻክፍቱፍ ወዮ፤<verse eid="ISA 18:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 18:2"/>እሼን ገላነረ፣</para>
  <para style="q2" vid="ISA 18:2">ብድሩ ዸላዱቲን ኤርገሞተ ብሻንረ ኤርግት።</para>
  <para style="b" vid="ISA 18:2"/>
  <para style="q1" vid="ISA 18:2">ያ ኤርገሞተ አሪፈቶተ፣</para>
  <para style="q1" vid="ISA 18:2">ገረ ሰበ ዼዼሮ ከኔን ጎጋንሳኒ ለላፉ፣</para>
  <para style="q2" vid="ISA 18:2">ገረ ሰበ ፈጎፊ ዽኦትስ ሶዳተሙ፣</para>
  <para style="q1" vid="ISA 18:2">ሰበ ጀባፊ አፋንሳ ህንቤከምኔ</para>
  <para style="q2" vid="ISA 18:2">ከን ብይሳኒ ለጌኒን ገርገር ቆደምቴ ሰና ዸቃ።<verse eid="ISA 18:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 18:3"/>እስን ኡመትን አዱኛ ሁንድ፣</para>
  <para style="q2" vid="ISA 18:3">ወር ለፈረ ጅራተን ዬሮ መለቶን ጋረረት <optbreak/> ኦል ቀበሙ ንአርግቱ፤</para>
  <para style="q2" vid="ISA 18:3">ዬሮ መለከትን አፉፈሙስ <optbreak/> እኑመ ዸጌሱ።<verse eid="ISA 18:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 18:4"/>
    <char style="nd">ዋቀዮ</char> አከነ ናን ጄዼ፦</para>
  <para style="q2" vid="ISA 18:4">“አን አኩመ ሆአ እፈ አዱ ኬሰት ጨለቅሱ፣</para>
  <para style="q1" vid="ISA 18:4">አኩመ ዱሜሰ ፍጤንሳ ከን ሆአ ዬሮ ምዻን ገልቸኒት</para>
  <para style="q2" vid="ISA 18:4">ጨልእሴ እዶ ጅሬኘኮቲ ነንእላለ።”<verse eid="ISA 18:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 18:5"/>ሃማ ምዻኒቲን ዱረ፣ ዬሮ ሁዻን ደራሬ</para>
  <para style="q2" vid="ISA 18:5">ደራራን ሱንስ እጀ ወይኒ ብልቻቴ ተኡት</para>
  <para style="q1" vid="ISA 18:5">እን ብላ እቲን ቆረኒን ለታሳ ንጭጭረ፤</para>
  <para style="q2" vid="ISA 18:5">ደሜ በበልአቴስ እራ ሙርሙሬ ንበሌሰ።<verse eid="ISA 18:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 18:6"/>እሳን ሁንድኑ አላቲ ቱሉ ከን ዋ አደምሱፊ</para>
  <para style="q2" vid="ISA 18:6">ብኔንሶተ ቦሶናቲፍ ዺፈሙ፤</para>
  <para style="q1" vid="ISA 18:6">አላቲን ቦነ ጉቱ፣</para>
  <para style="q2" vid="ISA 18:6">ብኔንሶትን ቦሶናስ ገነ ጉቱ እሳን ኛቱ።<verse eid="ISA 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 18:7"/>ጋፈስ ሰበ ዼዼሮ ከኔን ጎጋንሳኒ ለላፉራ፣</para>
  <para style="q1" vid="ISA 18:7">ሰበ ፈጎፊ ዽኦትስ ሶዳተሙራ፣</para>
  <para style="q2" vid="ISA 18:7">ሰበ ጀባፊ አፋንሳ ህንቤከምኔ</para>
  <para style="q1" vid="ISA 18:7">ከን ብይሳኒ ለጌኒን ገርገር ቆደምቴራ</para>
  <para style="q2" vid="ISA 18:7">
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡፍ ኬናን ንፍደመ፤</para>
  <para style="m" vid="ISA 18:7">ኬናን ሱንስ ገረ ቱሉ ጥዮን፣ እዶ መቃን <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ ጅራቱት ንፍደመ።<verse eid="ISA 18:7"/></para>
  <chapter eid="ISA 18"/>
  <chapter number="19" style="c" sid="ISA 19"/>
  <para style="s1">ራጂ ግብጢን ሞርሙ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 19:1"/>ራጂ ግብጢን ሞርሙ፦</para>
  <para style="q1" vid="ISA 19:1">ኩኖ <char style="nd">ዋቀዮ</char> ዱሜሰ</para>
  <para style="q2" vid="ISA 19:1">ሰፍሳ ያበቴ ገረ ግብጥ ዹፋ ጅረ።</para>
  <para style="q1" vid="ISA 19:1">ዋቆትን ግብጥ ቶልፈሞን ፉለሳ ዱረት ሆለቱ፤</para>
  <para style="q2" vid="ISA 19:1">ገራን ወረ ግብጥስ እሳን ኬሰት በቀ።<verse eid="ISA 19:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 19:2"/>“አን ወረ ግብጥ ወልት ነንነቀ፤</para>
  <para style="q2" vid="ISA 19:2">ኦቦሌስ ኦቦሌሰሳ፣ ኦላን ኦላሳ፣</para>
  <para style="q2" vid="ISA 19:2">መጋላን ቶኮ መጋላ ካን፣</para>
  <para style="q2" vid="ISA 19:2">ሞቱማንስ ሞቱማ ካን ሎለ።<verse eid="ISA 19:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 19:3"/>ሀፉር ወረ ግብጥ እሳን ኬሰት ጄቀመ፤</para>
  <para style="q2" vid="ISA 19:3">አንስ ከሮረሳኒ ነንፈሸሌሰ፤</para>
  <para style="q1" vid="ISA 19:3">እሳንስ ዋቆተ ቶልፈሞፊ ሀፉሮተ ወረ ዱአኒ፣</para>
  <para style="q2" vid="ISA 19:3">እላልቶታፊ ኤኬር ዱብስቶተ ጎርሰ ጋፈቱ።<verse eid="ISA 19:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 19:4"/>አንስ ደበርሴ ወረ ግብጥ</para>
  <para style="q2" vid="ISA 19:4">ሁምነ ጎፍታ ገራ ጀባቱ ቶኮት ነንኬነ፤</para>
  <para style="q1" vid="ISA 19:4">ሞቲን ሀማን ቶኮስ እሳን ንቡልቸ” ጄዸ ጎፍታን፣</para>
  <para style="q2" vid="ISA 19:4">
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ።<verse eid="ISA 19:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 19:5"/>ብሻኖትን ገላና ንጎጉ፤</para>
  <para style="q2" vid="ISA 19:5">ለግንሳስ ንህርአተ፤ ንጎገስ።<verse eid="ISA 19:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 19:6"/>ቡርቃወንሳ ንአጃኡ፤</para>
  <para style="q2" vid="ISA 19:6">ለጌን ግብጢስ ቀልአተኒ ጎጉ።</para>
  <para style="q1" vid="ISA 19:6">ሸምበቆፊ ዸላዱን ንጮለጉ፤<verse eid="ISA 19:6"/></para>
  <para style="q2">
    <verse number="7" style="v" sid="ISA 19:7"/>ብቅልቱወን ኤዴደ አበያ፣</para>
  <para style="q2" vid="ISA 19:7">ከኔን ቀርቀረ ለግቻ ጅረንስ ንጮለጉ።</para>
  <para style="q1" vid="ISA 19:7">ወን ለገ አበያ ብረት ፈጫፈሜ ሁንድ ንጎገ፤</para>
  <para style="q2" vid="ISA 19:7">ቡቤዻን ፉዸተመ፤ ዴብኤስ ህንአርገሙ።<verse eid="ISA 19:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 19:8"/>ቁርጡሚ ቀብዶትን፣</para>
  <para style="q2" vid="ISA 19:8">ወር ሆኮ አበያ ኬሰ ቡሰን <optbreak/> ሁንድ ኣደኒ ቦኡ፤</para>
  <para style="q2" vid="ISA 19:8">ወር ክዮ ብሻንት ደርበተንስ ንደዸቡ።<verse eid="ISA 19:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 19:9"/>ወር ቁንጬ ተልባ እደሜ ቆጴሰን፣</para>
  <para style="q2" vid="ISA 19:9">ወያ ዾፍቶትንስ አብዲ ኩተቱ።<verse eid="ISA 19:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 19:10"/>ወር ወያ ዸአን መታ ቡሱ፤</para>
  <para style="q2" vid="ISA 19:10">ወር ምንዳዻን ሆጄተን ሁንድስ ንገዱ።<verse eid="ISA 19:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 19:11"/>ቆንዳልቶትን ዞኣን ጎዎተ፤</para>
  <para style="q2" vid="ISA 19:11">ጎርስቶትን ፈረኦን ኦጌዪንስ <optbreak/> ጎርሰ ፋይዳ ህንቀብኔ ኬኑ።</para>
  <para style="q1" vid="ISA 19:11">እስን አከምት ፈረኦኒን፣</para>
  <para style="q2" vid="ISA 19:11">“አን ነሞተ ኦጌዪ ኬሳ ቶኮዸ፤</para>
  <para style="q2" vid="ISA 19:11">አን በረታ ሞቶተ ዱሪት” ጄቹ ደንዴሱ?<verse eid="ISA 19:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 19:12"/>ነሞትንኬሰን ኦጌዪን አመ ኤሰ ጅሩ?</para>
  <para style="q2" vid="ISA 19:12">ሜ እሳን ዋን <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ</para>
  <para style="q1" vid="ISA 19:12">ግብጢን ሞርሙዻን ከሮርፈቴ፤</para>
  <para style="q2" vid="ISA 19:12">እስንት ሃህመን፤ ሃቤክስሰንስ።<verse eid="ISA 19:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 19:13"/>ቆንዳልቶትን ዞኣን ጎዎተ ተአኒሩ፤</para>
  <para style="q2" vid="ISA 19:13">ቡልችቶትን ሜምፊስ ጎዎምፈመኒሩ፤</para>
  <para style="q1" vid="ISA 19:13">ጉርጉዶትን ሰበሼ</para>
  <para style="q2" vid="ISA 19:13">ግብጢን ከራራ ጀልእሰኒሩ።<verse eid="ISA 19:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 19:14"/>
    <char style="nd">ዋቀዮ</char> ሀፉረ ነመ ሀዶቹ እሳንት ዸንገላሴረ፤</para>
  <para style="q2" vid="ISA 19:14">እሳን አኩመ መቻኣን ቶኮ ሆቅሳ ገተንተሩ ሰነ</para>
  <para style="q2" vid="ISA 19:14">ብየ ግብጥ ዋን እሼን ሆጄቱ ሁንደ ኬሰት <optbreak/> ገተንተርሰን።<verse eid="ISA 19:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 19:15"/>ወን መታን ዮካን ኤጌን፣ ደሜን ሜጢ <optbreak/> ዮካን ሸምበቆን፣</para>
  <para style="q2" vid="ISA 19:15">ግብጢፍ ጎቹ ደንደአን ቶኮዩ ህንጅሩ።<verse eid="ISA 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 19:16"/>በረ ሰነ ወር ግብጥ አከ ዱበርቲ ተኡ። ሀርከ ኦል ከኤ ከን <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ እሳንት ኦል ፉዸቱ ሰነ አርገኒ ሶዳን ንሆለቱ። <verse eid="ISA 19:16"/><verse number="17" style="v" sid="ISA 19:17"/>ብይ ይሁዳስ ወረ ግብጥ ንናስሰ፤ ነምን መቃን ይሁዳ ብረት ዸአሙ ሁንድኑ ሰበቢ ዋን <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ እሳንት ከሮርፈቻ ጅሩ ሰናቲፍ ንነአ።<verse eid="ISA 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 19:18"/>ጋፈስ ብየ ግብጥ ኬሰት መጋላወን ሸን አፋን ከነኣን ዱበቱ፤ እሳንስ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡፍ አመነሞ ተኡፍ ንከከቱ። እሳን ኬሳ ቶኮ መጋላ በዲሳ ጄዸምት።<verse eid="ISA 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 19:19"/>ጋፈስ ዊርቱ ግብጥ ኬሰት እዶን ኣርሳ ቶኮ <char style="nd">ዋቀዮፍ</char> ንሆጄተመ፤ ዳንጋ ብየቲረትስ ሲዳን ቶኮ <char style="nd">ዋቀዮፍ</char> ንዻበመ። <verse eid="ISA 19:19"/><verse number="20" style="v" sid="ISA 19:20"/>ኩንስ ብየ ግብጥ ኬሰት <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡፍ መለቶፊ ዹገ በኡምሰ ተአ። ዬሮ እሳን ሰበቢ ጩንቁርስቶተሳኒቲፍ ገረ <char style="nd">ዋቀዮት</char> እየተንት፣ እን ፈይሳፊ በራራ ቶኮ ኤርጌፊ እሳን ኦልቸ። <verse eid="ISA 19:20"/><verse number="21" style="v" sid="ISA 19:21"/>ከናፉ <char style="nd">ዋቀዮ</char> ወረ ግብጥት ኦፍ ቤክስሰ፤ እሳንስ ጋፈስ <char style="nd">ዋቀዮን</char> ንቤኩ። እሳንስ ቀልማፊ ኬና ምዻኒቲን ዋቄፈቱ፤ <char style="nd">ዋቀዮፍስ</char> ንወሬጉ፤ ወሬገ ሰነስ ንባፈቱ። <verse eid="ISA 19:21"/><verse number="22" style="v" sid="ISA 19:22"/><char style="nd">ዋቀዮ</char> ብየ ግብጥ ንሩኩተ፤ ሩኩቴስ ንፈይሰ። እሳን ገረ <char style="nd">ዋቀዮት</char> ንዴብኡ፤ እንስ ከዸትናሳኒቲፍ ዴቢ ኬኔ እሳን ፈይሰ።<verse eid="ISA 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ISA 19:23"/>ጋፈስ ግብጢ ሀመ አሶርት ከራ ጉዳ ቶኮቱ ጅራተ። ወር አሶር ገረ ግብጥ፣ ወር ግብጥስ ገረ አሶር ንዸቁ። ወር ግብጢፊ ወር አሶር ወሊ ወጅን ንዋቄፈቱ። <verse eid="ISA 19:23"/><verse number="24" style="v" sid="ISA 19:24"/>እስራኤል በረ ሰነ ኬሰ ግብጢፊ አሶርት ደበለምቴ ሰደፋ ታት፤ ኩንስ ለፈረት ኤበ ተአ። <verse eid="ISA 19:24"/><verse number="25" style="v" sid="ISA 19:25"/><char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡስ፣ “ግብጥ ሰብንኮ፣ አሶር ሆጂን ሀርከኮቲፊ እስራኤል ዻልኮ ሃኤብፈመን” ጄዼ እሳን ኤብሰ።<verse eid="ISA 19:25"/></para>
  <chapter eid="ISA 19"/>
  <chapter number="20" style="c" sid="ISA 20"/>
  <para style="s1">ራጂ ግብጢፊ እቶጵያዻን ሞርሙ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 20:1"/>በረ አጀጃን ሙምች ሰርጎን ሞትቸ አሶሪን ኤርገሜ ሱን ገረ አሽዶድ ዹፌ ሎሌ እሼ ቀበቴ ሰነ ኬሰ፣ <verse eid="ISA 20:1"/><verse number="2" style="v" sid="ISA 20:2"/>ዬሮዹመ ሰነት <char style="nd">ዋቀዮ</char> ከራ እሳያስ እልመ አሞሲቲን ዱበቴ። እንስ፣ “ኡፈተ ገዳ ዸግነኬራ፣ ኮጴስ ሚለኬራ ባስ” ጄዼን። እንስ አከሱመ ጎዼ፤ ቁላፊ ሚለ ዱዋ አሲፊ አች ዴሜ።<verse eid="ISA 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 20:3"/>ከነረት <char style="nd">ዋቀዮ</char> አከነ ጄዼ፤ “አኩመ ገርብችኮ እሳያስ፣ አከ ግብጢፊ እቶጵያፍ መለቶፊ አኬከቺሰ ተኡፍ ጄዼ ወጋ ሰዲ ቁላፊ ሚለ ዱዋ ዴሜ ሰነ፣ <verse eid="ISA 20:3"/><verse number="4" style="v" sid="ISA 20:4"/>አከሱመ ሞቲን አሶር ቦጅአምቶተ ግብጢፊ በቀቶተ እቶጵያ ደርገጌሳፊ ጃርሰ፣ ቁላፊ ሚለ ዱዋ ሀምብሴ ቴሱመሳኒሌ ቁላ ጎዼ ፉዸቴ ዴሜ፤ ኩን ወረ ግብጢቲፍ ቃኒዸ። <verse eid="ISA 20:4"/><verse number="5" style="v" sid="ISA 20:5"/>ወር እቶጵያ አመነተኒ ግብጢን ቦነን ንሶዳቱ፤ ንቃነኡስ። <verse eid="ISA 20:5"/><verse number="6" style="v" sid="ISA 20:6"/>ጋፈስ ወር ቀርቀረ ገላናረ ጅራተን አከነ ጄዹ፤ ‘ወረ ኑ እት እርከትኔ፣ ወረ ሞትቸ አሶር ጀላ ኑ ባሱ ጄኔ ገርጋርሳፍ እት በቀትኔ ሰነረ ዋን ገኤ ሜ እላላ! ዮስ ኑ አከምት ጀላ በኡ ደንዴኘ?’ ”<verse eid="ISA 20:6"/></para>
  <chapter eid="ISA 20"/>
  <chapter number="21" style="c" sid="ISA 21"/>
  <para style="s1">ራጂ ባብሎኒን ሞርሙ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 21:1"/>ራጂ ገሞጂ ገላነ ብረ ጅርቱን ሞርሙ፦</para>
  <para style="q1" vid="ISA 21:1">አኩመ ቡቤን ሀማን ብየ ክባ ሀጣኡ ሰነ፣</para>
  <para style="q2" vid="ISA 21:1">ዌረራን ቶኮ ገሞጂዻ፣</para>
  <para style="q2" vid="ISA 21:1">ብየ ሶዳችሳ ኬሳ ንዹፈ።<verse eid="ISA 21:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 21:2"/>ሙልአትን ሀማን ቶኮ ነት ሙልአቴረ፦</para>
  <para style="q2" vid="ISA 21:2">ገንቱን ንገንት፤ ሳምቱንስ ንሳምት።</para>
  <para style="q1" vid="ISA 21:2">ያ ኤላም፣ ኦል በእ! ያ ሜዴ መርሲ ቀብ!</para>
  <para style="q2" vid="ISA 21:2">አን ኣዱ እሼን ፍዴ ሁንደ ነንጡሙረ።<verse eid="ISA 21:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 21:3"/>ከነረት ዱግድ ነ ጭቴ፤</para>
  <para style="q2" vid="ISA 21:3">አኩመ ዱበርቲ ጭኒንስፈቱ ሙደምን ነ ቀቤ፤</para>
  <para style="q1" vid="ISA 21:3">አን ዋነን ዸገኤን ነንሆለዼ፤</para>
  <para style="q2" vid="ISA 21:3">ዋነን አርጌንስ ነንራፈሜ።<verse eid="ISA 21:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 21:4"/>ቀልቢንኮ ንራፈሜ፤</para>
  <para style="q2" vid="ISA 21:4">ሶዳን ነ ሆለቺሴ፤</para>
  <para style="q1" vid="ISA 21:4">ድምምስን አን ሀዌ ሱን</para>
  <para style="q2" vid="ISA 21:4">ሶዳት ነ ጀላ ጌደረሜ።<verse eid="ISA 21:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 21:5"/>እሳን ማዲ ቆጴሱ፤</para>
  <para style="q2" vid="ISA 21:5">አፋ ድሪርሱ፤</para>
  <para style="q2" vid="ISA 21:5">ንኛቱ፣ ንዹጉ!</para>
  <para style="q1" vid="ISA 21:5">እስን ቆንዳልቶትን ከኣ፤</para>
  <para style="q2" vid="ISA 21:5">ጋቸነስ ዘይቲ ድባ።<verse eid="ISA 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 21:6"/>ጎፍታን አከነ ናን ጄዸ፦</para>
  <para style="q1" vid="ISA 21:6">“ዸቂቲ ኤግዱ ቶኮ ረመድ፤</para>
  <para style="q2" vid="ISA 21:6">እንስ ዋን አርጉ ሃህሙ።<verse eid="ISA 21:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 21:7"/>እን ዮሙ ወረ ፈርደ ያበተን</para>
  <para style="q2" vid="ISA 21:7">ከኔን ለመ ለማን ያአን፣</para>
  <para style="q1" vid="ISA 21:7">ወረ ሀሬ ያበተን</para>
  <para style="q2" vid="ISA 21:7">ዮካን ወረ ጋለ ያበተን አርጉት፣</para>
  <para style="q1" vid="ISA 21:7">ሃደመቁ፤</para>
  <para style="q2" vid="ISA 21:7">ጉቱማን ጉቱት ሃደመቁ።”<verse eid="ISA 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 21:8"/>ኤግዱን ሱንስ አከነ ጄዼ እዬ፤</para>
  <para style="q1" vid="ISA 21:8">“ያ ጎፍታኮ፣ አን ጉዩመ ጉያን</para>
  <para style="q2" vid="ISA 21:8">ቆጢ ኤጉምሳረ ነንዻበዸ፤</para>
  <para style="q2" vid="ISA 21:8">ሀልከን ሁንደስ አን ሆጂኮረ ነንቱረ።<verse eid="ISA 21:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 21:9"/>ኩኖ፣ ወር ፈርደ ያበተን፣</para>
  <para style="q2" vid="ISA 21:9">ለመ ለማን ዹፋ ጅሩ፤</para>
  <para style="q1" vid="ISA 21:9">እን አከነ ጄዼ ዴብሴ፦</para>
  <para style="q2" vid="ISA 21:9">‘ባብሎን ጅግዴርት፤ ጅግዴርት!</para>
  <para style="q1" vid="ISA 21:9">ፈኪወን ዋቆተሼ ሁንድኑ</para>
  <para style="q2" vid="ISA 21:9">ቡርኩታአኒ ለፈ ዸአኒሩ!’ ”<verse eid="ISA 21:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 21:10"/>ያ ሰበኮ ወረ ኦብዲ ምዻኒረት ዸአምተን፣</para>
  <para style="q2" vid="ISA 21:10">አን ዋን <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣</para>
  <para style="q2" vid="ISA 21:10">ዋቀ እስራኤልራ ዸገኤ እስንትን ህመ።<verse eid="ISA 21:10"/></para>
  <para style="s1">ራጂ ኤዶሚን ሞርሙ</para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 21:11"/>ራጂ ዱማን ሞርሙ፦</para>
  <para style="q1" vid="ISA 21:11">ነምን ቶኮ ሴኢሪ ነ ዋሜ፣</para>
  <para style="q2" vid="ISA 21:11">“ያ ኤግዱ፣ ሀልከን ኩን በርኡፍ ሀመምቱ ሀፌ?</para>
  <para style="q2" vid="ISA 21:11">ያ ኤግዱ፣ ሀልከን ኩን በርኡፍ ሀመምቱ ሀፌ?” ጄዼ።<verse eid="ISA 21:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 21:12"/>ኤግዱን ሱንስ፣</para>
  <para style="q2" vid="ISA 21:12">“በርኡ ገኤረ፤ ገሩ ዴብኤ ዽአ።</para>
  <para style="q1" vid="ISA 21:12">ዮ ጋፈቹ በርባደን ጋፈዻ፤</para>
  <para style="q2" vid="ISA 21:12">ገሩ ዴብኣ ኮታ” ጄዼ ዴብሰ።<verse eid="ISA 21:12"/></para>
  <para style="s1">ራጂ ብየ አረባቲን ሞርሙ</para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 21:13"/>ራጂ ብየ አረባቲን ሞርሙ፦</para>
  <para style="q1" vid="ISA 21:13">እስን እመልቶትን ዴዳን</para>
  <para style="q2" vid="ISA 21:13">ከኔን ቦሶነ አረባ ኬሰ ቁበተን፣<verse eid="ISA 21:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="ISA 21:14"/>ወረ ዼቦቴፍ ብሻን ፍዳ፤</para>
  <para style="q1" vid="ISA 21:14">እስን ወር ቴማ ኬሰ ጅራተን፣</para>
  <para style="q2" vid="ISA 21:14">በቀቶታፍ ዋን ኛተን ፍዳ።<verse eid="ISA 21:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 21:15"/>እሳን ጎራዴ ጀላ፣</para>
  <para style="q2" vid="ISA 21:15">ጎራዴ ሉቅፈሜ ጀላ፣</para>
  <para style="q1" vid="ISA 21:15">ጥየ አጋመሜ ጀላ፣</para>
  <para style="q2" vid="ISA 21:15">ሆአ ወራና ጀላ በቀተኒሩቲ።<verse eid="ISA 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 21:16"/>ጎፍታን አከነ ናን ጄዼ፦ “አኩመ ወጎተ ሆጄታ ቀጠረማ ቶኮት ኡልፍን ቄዳር ሁንድኑ ወጋ ቶኮ ኬሰት ንዹመ። <verse eid="ISA 21:16"/><verse number="17" style="v" sid="ISA 21:17"/>ወረ ጥየ ደርበተን ኬሳ ከኔን ሀፈን፣ ጎቶትን ቄዳር ሙራሰ ተኡ።” <char style="nd">ዋቀዮ</char> ዋቅን እስራኤል ዱበቴራቲ።<verse eid="ISA 21:17"/></para>
  <chapter eid="ISA 21"/>
  <chapter number="22" style="c" sid="ISA 22"/>
  <para style="s1">ራጂ ዋኤ ዬሩሳሌም</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 22:1"/>ራጂ ዋኤ ሱሉለ ሙልአታ፦</para>
  <para style="q1" vid="ISA 22:1">አመ ማልቱ እስን ረክሴ</para>
  <para style="q2" vid="ISA 22:1">እስን ሁንድ ፊጤ መናት ኦል ባተን?<verse eid="ISA 22:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 22:2"/>ያ መጋላ ወጫን ጉተምቴ፣</para>
  <para style="q2" vid="ISA 22:2">ያ መጋላ ጄቀምቱፊ ፈንደለልቱ፣</para>
  <para style="q1" vid="ISA 22:2">ነሞትን ስ ጀላ ቀለመን ጎራዴዻን ህንአጄፈምኔ</para>
  <para style="q2" vid="ISA 22:2">ዮካን ወራነ ኬሰት ህንዹምኔ።<verse eid="ISA 22:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 22:3"/>ሆገንቶትንኬ ሁንድ ወሉማን በቀተን፤</para>
  <para style="q2" vid="ISA 22:3">እሳን ኡቱመ ጥየ ህንደርበትን ቀበመን።</para>
  <para style="q1" vid="ISA 22:3">እስን ኡቱመ ዲን ፈጎ ጅሩ በቀተንዩ</para>
  <para style="q2" vid="ISA 22:3">ወር ቀበምተን ሁንድ ወሉማን መነ ህዻት ገልፈምተኒርቱ።<verse eid="ISA 22:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 22:4"/>ከናፉ አን፣ “አነራ ገረገላ፤</para>
  <para style="q2" vid="ISA 22:4">አን ህቅፈዼ ነንቦአ።</para>
  <para style="q1" vid="ISA 22:4">በዲሰ ሰበኮረት</para>
  <para style="q2" vid="ISA 22:4">ነ ጀጀቤሱ ህንያልና” ነንጄዼ።<verse eid="ISA 22:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 22:5"/>ጎፍታን፣ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣</para>
  <para style="q2" vid="ISA 22:5">ሱሉለ ሙልአታ ኬሰት፣ ጉያ ጄቁምሳ፣</para>
  <para style="q2" vid="ISA 22:5">ዽዺተሙቲፊ ቡርጃጂ፣</para>
  <para style="q1" vid="ISA 22:5">አከሱመስ ጉያ እት ደላ ዲጉቲፊ</para>
  <para style="q2" vid="ISA 22:5">ቱሉወንትስ እዩ ቀበ።<verse eid="ISA 22:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 22:6"/>ኤላም መንኤ ጥያ ቀበቴ</para>
  <para style="q2" vid="ISA 22:6">ጋሪወኒፊ አቦቲ ፈርዳ ፉዸቴ ባት፤</para>
  <para style="q2" vid="ISA 22:6">ቂርስ ጋቸነሼ ቀበት።<verse eid="ISA 22:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 22:7"/>ሱሉለወንኬ ፍለተሞን ጋሪወኒን ጉተመኒሩ፤</para>
  <para style="q2" vid="ISA 22:7">አቦቲን ፈርዳስ ከረ መጋለቲረት ረመደመኒሩ።<verse eid="ISA 22:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 22:8"/>ጎፍታን እትሰ ይሁዳ እራ ሙልቄረ።</para>
  <para style="q2" vid="ISA 22:8">አትስ ጋፈስ ምአ ሎላ ከን መሰራ ቦሶና</para>
  <para style="q2" vid="ISA 22:8">ኬሰ ጅሩ ሰነ አብደተ።<verse eid="ISA 22:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 22:9"/>ደላን መጋላ ዳዊት</para>
  <para style="q2" vid="ISA 22:9">ከራ ባይኤ አከ ኡረሜ አርግተኒርቱ፤</para>
  <para style="q1" vid="ISA 22:9">ሀሮ ገድ ኣና ኬሰትስ</para>
  <para style="q2" vid="ISA 22:9">ብሻን ኩፈተኒርቱ።<verse eid="ISA 22:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 22:10"/>እስን መኔን ዬሩሳሌም ለኮፍተን፤</para>
  <para style="q2" vid="ISA 22:10">ደላሼ ዸጋ ጀቤሱፍ ጄተኒስ መኔን ሰነ ዲግደን።<verse eid="ISA 22:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 22:11"/>ብሻን ሀሮ ሞፋቲፍ ደላ ለማን ግዱት</para>
  <para style="q2" vid="ISA 22:11">ኩሳ ብሻኒ ቶልችተን፤</para>
  <para style="q1" vid="ISA 22:11">ገሩ እስን ገረ እሰ ዋን ሰነ ሆጄቴ ህንእላሌ፤</para>
  <para style="q2" vid="ISA 22:11">ዮካን እሰ በረ ዼራን ዱረ ዋን ሰነ ከሮርሴፍ <optbreak/> ኡልፍነ ህንኬንኔ።<verse eid="ISA 22:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 22:12"/>ጎፍታን፣ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣</para>
  <para style="q2" vid="ISA 22:12">አከ አት ቦሴ ወዋቱፍ፣</para>
  <para style="q1" vid="ISA 22:12">አከ አት ርፌንሰ መታኬቲ ኦፍራ ጭርቴ</para>
  <para style="q2" vid="ISA 22:12">ወያ ገዳ ኡፈቱፍ ጉያ ሰነ ስ ዋሜ።<verse eid="ISA 22:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 22:13"/>ቆደ ከና ገሩ ገመቹፊ ፈንደለሉ፣</para>
  <para style="q2" vid="ISA 22:13">ሎን ጎረኡፊ ሆሎተ ቀሉ፣</para>
  <para style="q2" vid="ISA 22:13">ፎን ኛቹፊ ዳዺ ወይኒ ዹጉቱ ጅረ!</para>
  <para style="q1" vid="ISA 22:13">እስን፣ “ኮታ ንኛትና፤ ንዹግነስ፤</para>
  <para style="q2" vid="ISA 22:13">ቦር ንዱናቲ!” ጄቱ።<verse eid="ISA 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 22:14"/>
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ ኡቱመ ጉርኮ ዸገኡ ዋን ከነ ና እብሴ፦ “ሀመ ጉያ ዱአኬሰኒት ጩቡን ኩን እስንራ ህንሀቀሙ” ጄዸ ጎፍታን፣ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ።<verse eid="ISA 22:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 22:15"/>ጎፍታን፣ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ አከነ ጄዸ፦</para>
  <para style="q1" vid="ISA 22:15">“ዸቂቲ እት ጋፈተማ ከናን፣</para>
  <para style="q2" vid="ISA 22:15">ሼብና፣ ቡልቻ መሰራ ሞቱማቲን አከነ ጄዽ፦<verse eid="ISA 22:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 22:16"/>አት ማል አሲ ሆጄተ?</para>
  <para style="q2" vid="ISA 22:16">አከ አት እዶ ከነት እዶ አዋላ ቆጴፈቱ፣</para>
  <para style="q1" vid="ISA 22:16">አከ እዶ ኦል ከኣረት ቦለ አዋለኬቲ ቆተቱ፣</para>
  <para style="q2" vid="ISA 22:16">አከ ከታ ኬሰት እዶ ቦቆናኬቲ ቶልቸቱ <optbreak/> ኤኙቱ ኤየመ ሲፍ ኬኔ?<verse eid="ISA 22:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 22:17"/>“ያ ነመ ጀባ ኩኖ፣</para>
  <para style="q2" vid="ISA 22:17">
    <char style="nd">ዋቀዮ</char> ጀቤሴ ቀቤ ስ ደርበቹፍ ጅረ።<verse eid="ISA 22:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 22:18"/>እን አኩመ ኩባ ፉሩርሴ</para>
  <para style="q2" vid="ISA 22:18">ብየ በልኣ ቶኮ ኬሰ ስ ቡሰ።</para>
  <para style="q1" vid="ISA 22:18">ያ ሰልጵነ መነ ጎፍታኬቲ፣ አት አችት ዱተ፤</para>
  <para style="q2" vid="ISA 22:18">ጋሪወንኬ ምሚዸጎንስ አችት ሀፉ!<verse eid="ISA 22:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 22:19"/>አን ኣንጎኬራ ስን ቡሰ፤</para>
  <para style="q2" vid="ISA 22:19">አትስ ታይታኬራ ንአርአምተ።<verse eid="ISA 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ISA 22:20"/>“አን ጋፈስ ገርብቸኮ ኤሊያቂምን እልመ ህልቅያ ነንዋመ። <verse eid="ISA 22:20"/><verse number="21" style="v" sid="ISA 22:21"/>አን ኡፈተኬ እሰት ነንኡፍሰ፤ ሰበተኬ ሙዺሳት ነንህዸ፤ ኣንጎኬስ ደበርሴ እሳፍ ነንኬነ። እን ወረ ዬሩሳሌም ኬሰ ጅራተኒፊ መነ ይሁዳቲፍ አባ ንተአ። <verse eid="ISA 22:21"/><verse number="22" style="v" sid="ISA 22:22"/>አን ፉርቱ መነ ዳዊት ገቲቲሳረ ነንካአ፤ ዋን እን በኑ ነምን ቶኮዩ ጩፉ ህንደንደኡ፤ ዋን እን ጩፉስ ነምን ቶኮዩ በኑ ህንደንደኡ። <verse eid="ISA 22:22"/><verse number="23" style="v" sid="ISA 22:23"/>አን አኩመ ፈኖ ዋ እት ፈንሰን ቶኮት እዶ ጀባረ እሰ ነንዻበ፤ እንስ መነ አባሳቲፍ ቴሶ ኡልፍና ንተአ። <verse eid="ISA 22:23"/><verse number="24" style="v" sid="ISA 22:24"/>እሳንስ ከበጀ መነ አባሳ ሁንደ፣ እጆሌሳቲፊ እጆሌ እጆሌሳ፣ ምአ ጥጥና ከን ወጪቲዻ ጀልቀቤ ሀመ ኦኮቴት ጅሩ ሁንደ እሰት ፈንሱ።”<verse eid="ISA 22:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ISA 22:25"/>
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ አከነ ጄዸ፤ “ጋፈስ ቆፎን እዶ ጀባ ዻበሜ ሱን ንቡቀአ፤ ሙረሜ ለፈ ቡአ፤ በኣን እሰት ፈንፈሜ ሱን ሀርጨኤ ጨጨበ።” <char style="nd">ዋቀዮ</char> ዋን ከነ ዱበቴራቲ።<verse eid="ISA 22:25"/></para>
  <chapter eid="ISA 22"/>
  <chapter number="23" style="c" sid="ISA 23"/>
  <para style="s1">ራጂ ዋኤ ጢሮስ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 23:1"/>ራጂ ዋኤ ጢሮስ፦</para>
  <para style="q1" vid="ISA 23:1">ያ ዶኒወን ተርሺሽ ወዋዻ!</para>
  <para style="q2" vid="ISA 23:1">ጢሮስ በርበዶፍቴ</para>
  <para style="q2" vid="ISA 23:1">መነ ዮካን ቡፈተ ዶኒ መሌ ሀፍቴርቲ።</para>
  <para style="q1" vid="ISA 23:1">ብየ ቆጵሮሲ</para>
  <para style="q2" vid="ISA 23:1">ኦዱን እሳን ቀቀቤረ።<verse eid="ISA 23:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 23:2"/>እስን ጅራቶትን ቀርቀረ ገላናቲፊ</para>
  <para style="q2" vid="ISA 23:2">ደልደልቶትን ሲዶና፣ ወር ገላነረ መርማረን</para>
  <para style="q2" vid="ISA 23:2">እስን ሶሮምሰን ጨልእሳ።<verse eid="ISA 23:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 23:3"/>ምዻን ሽሆር</para>
  <para style="q2" vid="ISA 23:3">ብሻኖተ ጉርጉዳ እራን ዹፌ፤</para>
  <para style="q1" vid="ISA 23:3">ኦምሽን አበያ ጢሮሲፍ ገሊ ቱሬ፤</para>
  <para style="q2" vid="ISA 23:3">እሼንስ ለፈ ገባ ከን ሰቦታ ታቴ።<verse eid="ISA 23:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 23:4"/>ያ ሲዶና፣ ያ ደአትኖ ገላና ቃነእ፤</para>
  <para style="q2" vid="ISA 23:4">ገላን አከነ ጄዼ ዱበቴራቲ፦</para>
  <para style="q1" vid="ISA 23:4">“አን ህንጭኒንስፈትኔ ዮካን ህንዴኜ፤</para>
  <para style="q2" vid="ISA 23:4">እልማን ህንሆረትኔ ዮካን እንተለን ህንጉድፈትኔ።”<verse eid="ISA 23:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 23:5"/>ዬሮ ኦዱን ገረ ግብጥ ዹፉት</para>
  <para style="q2" vid="ISA 23:5">እሳን ገባሰ ጢሮስራ ዹፉን ንዽጰቱ።<verse eid="ISA 23:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 23:6"/>እስን ገረ ተርሺሽት ጬኣ፤</para>
  <para style="q2" vid="ISA 23:6">ያ ወረ ቀርቀረ ገላና ጅራተን ወዋዻ።<verse eid="ISA 23:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 23:7"/>መጋላ ዱሎምቱን ዱሪ፣</para>
  <para style="q2" vid="ISA 23:7">ከን ሚልሼ እሼ ፉዼ፣</para>
  <para style="q1" vid="ISA 23:7">አከ እሼን ብየ ፈጎ ኬሰ ቁበቱፍ እሼ ጌሴ ኩን፣</para>
  <para style="q2" vid="ISA 23:7">መጋላኬ እሼ ፈንደለልቱዻ?<verse eid="ISA 23:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 23:8"/>ጢሮስ እሼ ጎንፎ ነመ ጎንፈቺፍቱ</para>
  <para style="q2" vid="ISA 23:8">ከን ደልደልቶትንሼ እልማን ሞቶታ ተአን</para>
  <para style="q1" vid="ISA 23:8">ከን ደልደልቶትንሼ ለፈረት ከበጀሞ ተአንት</para>
  <para style="q2" vid="ISA 23:8">ኤኙቱ ዋን ከነ ከሮርፈቴ?<verse eid="ISA 23:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 23:9"/>
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ</para>
  <para style="q2" vid="ISA 23:9">ኦፍ ጀጀሼ ከን ኡልፍነሼ ሁንደ ኬሰ ጅሩ ገድ ዴብሱፊ</para>
  <para style="q2" vid="ISA 23:9">ወረ ለፈረት ከበጀመን ሁንደ ሰልጵሱፍ <optbreak/> ዋን ከነ ከሮርፈቴረ።<verse eid="ISA 23:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 23:10"/>ያ እንተለ ተርሺሽ፣</para>
  <para style="q2" vid="ISA 23:10">አት ስአች ቡፈተ ዶኒ ህንቀባቱቲ፣</para>
  <para style="q2" vid="ISA 23:10">ለፈኬ ሀመ አበያ ብረ ገኡት ቆተዹ።<verse eid="ISA 23:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 23:11"/>
    <char style="nd">ዋቀዮ</char> ሀርከሳ ገላነረ ቀቤ</para>
  <para style="q2" vid="ISA 23:11">ሞቱሞተ ሆለቺሴረ።</para>
  <para style="q1" vid="ISA 23:11">እን አከ ደአኖወንሼ ዲገመኒፍ</para>
  <para style="q2" vid="ISA 23:11">ዋኤ ከነኣን አጀጀ ኬኔረ።<verse eid="ISA 23:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 23:12"/>እንስ አከነ ጄዸ፤ “ያ ዱርበ ሲዶና፣</para>
  <para style="q2" vid="ISA 23:12">አት ከነ ጫላ ህንፈንደለልቱ!</para>
  <para style="b" vid="ISA 23:12"/>
  <para style="q1" vid="ISA 23:12">“ከኢቲ ገረ ቆጵሮስት ጬእ፤</para>
  <para style="q2" vid="ISA 23:12">አት አችትዩ ቦቆና ህንአርገቱ።”<verse eid="ISA 23:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 23:13"/>ሜ ብየ ባብሎኖታ እላል፤</para>
  <para style="q2" vid="ISA 23:13">ኡመትን ኩን አመ ሴና ህንቀቡ!</para>
  <para style="q1" vid="ISA 23:13">ወር አሶር አከ እሼን</para>
  <para style="q2" vid="ISA 23:13">እዶ ጅሬኘ ኡመመወን ገሞጂ ታቱ ጎዸን፤</para>
  <para style="q1" vid="ISA 23:13">እሳን ስሬ ኤጉምሳ እጃረተን፤</para>
  <para style="q2" vid="ISA 23:13">ደአኖወንሼ ቁላ ሀምብሰን፤</para>
  <para style="q2" vid="ISA 23:13">እሼስ ንበርበዴሰን።<verse eid="ISA 23:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 23:14"/>ያ ዶኒወን ተርሺሽ ወዋዻ፤</para>
  <para style="q2" vid="ISA 23:14">ደአኖንኬሰን በርበዴፈሜራቲ!<verse eid="ISA 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 23:15"/>ዬሮ ሰና ጀልቀቤ ጢሮስ ሀመ ወጋ ቶርባተማት ንደገተምት፤ ኩንስ በረ ጅሬኘ ሞቲ ቶኮት። ዹመ ወጋ ቶርባተመን ሰናት ገሩ አኩመ ስርበ ሰጋገልቱ ቶኮፍ ስርበሜ ሰናት ጢሮስረ ገአ፦<verse eid="ISA 23:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 23:16"/>“ያ ሰጋገልቱ እራንፈተምቱ፣</para>
  <para style="q2" vid="ISA 23:16">በገና ቀበዹቲ መጋላ ኬሰ ናነእ፤</para>
  <para style="q1" vid="ISA 23:16">አት አከ ያደተምቱፍ በገና ስሪት ሩኩት፤</para>
  <para style="q2" vid="ISA 23:16">ስርበ ባይኤ ስርብ።”<verse eid="ISA 23:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 23:17"/>ዹመ ወጋ ቶርባተማት <char style="nd">ዋቀዮ</char> ጢሮስን ንያደተ፤ እሼንስ ገረ ደልደለሼት ዴብቴ ሞቱሞተ ፉለ ለፋረ ጅረን ሁንደ ወጅን ሰጋገልት። <verse eid="ISA 23:17"/><verse number="18" style="v" sid="ISA 23:18"/>ተኡስ ቡኣንሼቲፊ ወን እሼን አርገቱ <char style="nd">ዋቀዮፍ</char> አዳን ባፈመ፤ ህንኩፈሙ፤ ወልትስ ህንቀበሙ። ቡኣንሼስ ወረ ፉለ ዋቃ ዱረ ጅራተኒፍ ኛተ ገኣፊ ኡፈተ በበሬዳ ተአ።<verse eid="ISA 23:18"/></para>
  <chapter eid="ISA 23"/>
  <chapter number="24" style="c" sid="ISA 24"/>
  <para style="s1">
    <char style="nd">ዋቀዮ</char> ለፈ ንበርበዴሰ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 24:1"/>ኩኖ፣ <char style="nd">ዋቀዮ</char> ለፈ ንኦንሰ፤</para>
  <para style="q2" vid="ISA 24:1">እሼስ ንበርበዴሰ፤</para>
  <para style="q1" vid="ISA 24:1">እን እሼ ገገረገልቼ</para>
  <para style="q2" vid="ISA 24:1">ወረ እሼረ ጅራተን ብትኔሰ፤<verse eid="ISA 24:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 24:2"/>ከን ሰበረ ገኡ ሉበረ፣</para>
  <para style="q2" vid="ISA 24:2">ከን ገርብቸረ ገኡ ጎፍታረ፣</para>
  <para style="q2" vid="ISA 24:2">ከን ገርብቲረ ገኡ ጊፍቲረ፣</para>
  <para style="q2" vid="ISA 24:2">ከን ብተታረ ገኡ ጉርጉረታረ፣</para>
  <para style="q2" vid="ISA 24:2">ከን እሰ ኤርግፈቱረ ገኡ፣ እሰ ኤርግሱረ፣</para>
  <para style="q2" vid="ISA 24:2">ከን ልቄፈታረ ገኡ፣ እሰ ልቄሱ ንገኣቲ።<verse eid="ISA 24:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 24:3"/>ለፍት ጉቱማን ጉቱት ንኦንት፤</para>
  <para style="q2" vid="ISA 24:3">ጉቱማን ጉቱትስ ንሳመምት።</para>
  <para style="q1" vid="ISA 24:3">
    <char style="nd">ዋቀዮ</char> ዋን ከነ ዱበቴራቲ።<verse eid="ISA 24:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 24:4"/>ለፍት ንጎግድ፤ ብፍትሼስ ንጌደረመ፤</para>
  <para style="q2" vid="ISA 24:4">አዱኛን ንቡቱት፤ ብፍትሼስ ንጌደረመ፤</para>
  <para style="q2" vid="ISA 24:4">ጉርጉዶትን ሰበ ለፋስ ንቡቱቱ።<verse eid="ISA 24:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 24:5"/>ለፍት ሰበሼቲን ጡሮፍቴርት፤</para>
  <para style="q2" vid="ISA 24:5">እሳን ሴራፍ አጀጀሙ ድደን፤</para>
  <para style="q1" vid="ISA 24:5">ስርናን ቡሉ ድደኒ</para>
  <para style="q2" vid="ISA 24:5">ከኩ በረ በራ ሰነ ጨብሰኒሩ።<verse eid="ISA 24:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 24:6"/>ከናፉ አባርስ ለፈ በሌሰ፤</para>
  <para style="q2" vid="ISA 24:6">ሰብንሼስ በሌሳሳቲፍ አደበመ።</para>
  <para style="q1" vid="ISA 24:6">ከናፉ ጅራቶትን ለፋ ንጉበቱ፤</para>
  <para style="q2" vid="ISA 24:6">ነመ ሙራሰቱ ሀፈ።<verse eid="ISA 24:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 24:7"/>ዳዺን ወይኒ ሃራን ንጎገ፤</para>
  <para style="q2" vid="ISA 24:7">ሙክን ወይኒስ ንጮለገ፤</para>
  <para style="q2" vid="ISA 24:7">ወር ገመደን ሁንድኑ ንኣዱ።<verse eid="ISA 24:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 24:8"/>ድቤን ሰገሌንሳ ነመት ቶሉ ንጨልእሰ፤</para>
  <para style="q2" vid="ISA 24:8">ወጭን ፈንደለልቶታ ቀበናኤረ፤</para>
  <para style="q2" vid="ISA 24:8">በገናን ነመ ገመቺሱስ ጨልእሴረ።<verse eid="ISA 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 24:9"/>እሳን ስአች ስርባ ዳዺ ወይኒ ህንዹገን፤</para>
  <para style="q2" vid="ISA 24:9">ዹጋቲን ጀባን ወረ እሰ ዹገንት ንሀዻአ።<verse eid="ISA 24:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 24:10"/>መጋላን ዲገምቴ ሱን ኦንቴ ሀፍት፤</para>
  <para style="q2" vid="ISA 24:10">አከ ነምን ቶኮዩ ኦል ህንሴኔፍ መን ሁንድ ንጩፈመ።<verse eid="ISA 24:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 24:11"/>እሳን ዳዺ ወይኒ ዸበኒ ዳንዲረት ቦኡ፤</para>
  <para style="q2" vid="ISA 24:11">ገመቹን ሁንድ ገደት ጌደረመ፤</para>
  <para style="q2" vid="ISA 24:11">እልልቹን ሁንድስ ለፈራ ዸበመ።<verse eid="ISA 24:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 24:12"/>መጋላን ሱን ዲገምቴ ሀፍት፤</para>
  <para style="q2" vid="ISA 24:12">ከርሼስ ንጨጨበ።<verse eid="ISA 24:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 24:13"/>አኩመ ዬሮ ሙክን ኤጄርሳ ዸአሙፊ</para>
  <para style="q2" vid="ISA 24:13">አኩመ ዬሮ ወይኒን ገልፈሙት ቀርሚን ሀፉ ተኡ ሰነ፣</para>
  <para style="q1" vid="ISA 24:13">ለፈረት ሰቦተ ግዱትስ</para>
  <para style="q2" vid="ISA 24:13">አከሱመ ንተአ።<verse eid="ISA 24:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 24:14"/>እሳን ሰገሌ ኦል ፉዸተኒ ገመቹን እዩ፤</para>
  <para style="q2" vid="ISA 24:14">ገመ ልጠ ቢፍቱት ኡልፍነ <char style="nd">ዋቀዮ</char> ለብሱ።<verse eid="ISA 24:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 24:15"/>ከናፉ እስን በአ ቢፍቱራ <char style="nd">ዋቀዮፍ</char> ኡልፍነ ኬና፤</para>
  <para style="q2" vid="ISA 24:15">ቀርቀረ ገላናትስ መቃ <char style="nd">ዋቀዮ</char></para>
  <para style="q2" vid="ISA 24:15">ዋቀ እስራኤል ሌልሳ።<verse eid="ISA 24:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 24:16"/>ኑ ሞጋ ለፋራ ፋርፈትና፣</para>
  <para style="q2" vid="ISA 24:16">“እሰ ቀጄላ ሰናፍ ኡልፍን ሃተኡ” ጄዹ ዸጌኘ።</para>
  <para style="b" vid="ISA 24:16"/>
  <para style="q1" vid="ISA 24:16">አን ገሩ አከነን ጄዼ፤</para>
  <para style="q2" vid="ISA 24:16">“አን በዴ፣ አን በዴ! አናፍ ወዮ!</para>
  <para style="q1" vid="ISA 24:16">ገንቶትን ንገኑ!</para>
  <para style="q2" vid="ISA 24:16">ገንቶትን ገንቱማሳኒቲን ገኑ!”<verse eid="ISA 24:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 24:17"/>ያ ኡመተ ለፈራ፣</para>
  <para style="q2" vid="ISA 24:17">ሶዳን፣ ቅሌፊ ክዮን ስ ኤገቱ።<verse eid="ISA 24:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 24:18"/>ነምን ሰገሌ ጎሊ በቀቱ ከምዩ</para>
  <para style="q2" vid="ISA 24:18">ቅሌ ኬሰ ቡአ፤</para>
  <para style="q1" vid="ISA 24:18">ነምን ቅሌ ኬሳ ኦል በኡ ከምዩ</para>
  <para style="q2" vid="ISA 24:18">ክዮዻን ቀበመ።</para>
  <para style="b" vid="ISA 24:18"/>
  <para style="q1" vid="ISA 24:18">ፎዳን ሰሚወኒ በነሜራቲ</para>
  <para style="q2" vid="ISA 24:18">ሁንዴወን ለፋ ንራፈሙ።<verse eid="ISA 24:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 24:19"/>ለፍት በቀቅጤርት፤</para>
  <para style="q2" vid="ISA 24:19">ለፍት ገርገር ባቴርት፤</para>
  <para style="q2" vid="ISA 24:19">ለፍት አከ መሌ ራፈምቴርት፤<verse eid="ISA 24:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 24:20"/>ለፍት አኩመ ነመ መቻኤ ገተንተርት፤</para>
  <para style="q2" vid="ISA 24:20">እሼን አኩመ ዳሲ ቡቤዻን ራፈምት፤</para>
  <para style="q1" vid="ISA 24:20">የክ ፍንጭለሼ አከ መሌ እት ኡልፋቴረ፤</para>
  <para style="q2" vid="ISA 24:20">እሼን ንጅግድ፤ ዴብቴስ ህንካቱ።<verse eid="ISA 24:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 24:21"/>
    <char style="nd">ዋቀዮ</char> ጋፈስ</para>
  <para style="q2" vid="ISA 24:21">ሁምኖተ ሰሚ፣ ሰሚረት፣</para>
  <para style="q2" vid="ISA 24:21">ሞቶተ ለፋሞ ለፈረት ንአደበ።<verse eid="ISA 24:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 24:22"/>እሳን አኩመ ህዸምቶታ</para>
  <para style="q2" vid="ISA 24:22">ቦለ ኬሳት ወልት ቀበሙ፤</para>
  <para style="q1" vid="ISA 24:22">መን ህዻ እት ጩፈሜ</para>
  <para style="q2" vid="ISA 24:22">ጉያ ሄዱ ቦዴ አደበሙ።<verse eid="ISA 24:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 24:23"/>ጅእ ንቡርጃጆፍት፤ አዱንስ ንቃኖፍት፤</para>
  <para style="q2" vid="ISA 24:23">
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣</para>
  <para style="q1" vid="ISA 24:23">ቱሉ ጥዮንረቲፊ ዬሩሳሌም ኬሰት</para>
  <para style="q2" vid="ISA 24:23">ፉለ ማንጉዶታ ዱረት ኡልፍናን ንሞኣቲ።<verse eid="ISA 24:23"/></para>
  <chapter eid="ISA 24"/>
  <chapter number="25" style="c" sid="ISA 25"/>
  <para style="s1">
    <char style="nd">ዋቀዮፍ</char> ገለተ ገልቹ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 25:1"/>ያ <char style="nd">ዋቀዮ</char>፣ አት ዋቀኮት፤</para>
  <para style="q2" vid="ISA 25:1">ዋን አት አመነሙማኬ ከን ሙዳ ህንቀብኔን</para>
  <para style="q1" vid="ISA 25:1">ወንቶተ ድንቅሲሶ</para>
  <para style="q2" vid="ISA 25:1">በረ ዼራን ዱረ ከሮርፈሜ ሆጄቴፍ፣</para>
  <para style="q2" vid="ISA 25:1">አን ኡልፍነ ሲፍ ነንኬነ፤ መቃኬስ ነንሌልሰ።<verse eid="ISA 25:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 25:2"/>አት መጋላ ሰነ ቱላ ዸጋ፣</para>
  <para style="q2" vid="ISA 25:2">መጋላ ደላ ጀጀባ ቀብዱሞ ዲገማ ጎቴ፤</para>
  <para style="q1" vid="ISA 25:2">መጋላን ደአትኖ ነሞተ ኦርማ ቱርቴ ሱን <optbreak/> ስአች ህንጅራቱ፤</para>
  <para style="q2" vid="ISA 25:2">እሼን ጎንኩማ ዴብቴ ህንእጃረምቱ።<verse eid="ISA 25:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 25:3"/>ከናፉ ነሞትን ጀጀቦን ስ ከበጁ፤</para>
  <para style="q2" vid="ISA 25:3">መጋላወን ሰቦተ ገረ ጀቤዪ ስ ሶዳቱ።<verse eid="ISA 25:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 25:4"/>አት ህዬዪፍ ለፈ እት በቀተን፣</para>
  <para style="q2" vid="ISA 25:4">ረከታፍሞ ዽጵነሳ ኬሰት ደኦ፣</para>
  <para style="q1" vid="ISA 25:4">ቡቤ ሀማ ጀላ እዶ እት በቀቱ፣</para>
  <para style="q2" vid="ISA 25:4">ሆአ ጀላሞ እዶ እት ቀበኔፈቱ ቱርቴ።</para>
  <para style="q1" vid="ISA 25:4">ሀፉር ገረ ጀቤዪን ባፈተን፣</para>
  <para style="q2" vid="ISA 25:4">አኩመ ቡቤ ሀማ ደላ ዸጋ ዸኡቲፊ<verse eid="ISA 25:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="ISA 25:5"/>አኩመ ሆአ ገሞጂት።</para>
  <para style="q1" vid="ISA 25:5">አት ወጨ አለጎታ ንጨልእሲፍተ፤</para>
  <para style="q2" vid="ISA 25:5">አኩመ ሆእ ጋድሰ ዱሜሳቲን ቀበናኡ ሰነ፣</para>
  <para style="q2" vid="ISA 25:5">ስርብ ገረ ጀቤዪስ ንቀበናአ።<verse eid="ISA 25:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 25:6"/>
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ</para>
  <para style="q2" vid="ISA 25:6">ቱሉ ከነረት ኡመተ ሁንዳፍ ጭዸ ኛተ ጋሪ፣</para>
  <para style="q1" vid="ISA 25:6">አፌራ ዳዺ ወይኒ ጎጌ፣</para>
  <para style="q2" vid="ISA 25:6">ፎን ጮማፊ ዳዺ ወይኒ ፍለተማ ንቆጴሰ።<verse eid="ISA 25:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 25:7"/>እን ቱሉ ከነረት፣</para>
  <para style="q2" vid="ISA 25:7">ሀጉጊ ኡመተ ሁንደት ሀጉገሜ፣</para>
  <para style="q1" vid="ISA 25:7">ጎልጋ ሰበ ሁንደት ጎልገሜ ንበሌሰ፤<verse eid="ISA 25:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="ISA 25:8"/>እን በረ በራን ዱአ ንልቅምሰ።</para>
  <para style="q1" vid="ISA 25:8">
    <char style="nd">ዋቀዮ</char> ጎፍታን ፉለ ሁንደራ እምማን ንሀቀ፤</para>
  <para style="q2" vid="ISA 25:8">እን ለፈ ሁንደረት ሰልጵነ ሰበሳ ንበሌሰ።</para>
  <para style="q2" vid="ISA 25:8">
    <char style="nd">ዋቀዮ</char> ዋን ከነ ዱበቴራቲ።<verse eid="ISA 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 25:9"/>እሳን ጋፈስ አከነ ጄዹ፤</para>
  <para style="q1" vid="ISA 25:9">“ዹጉማን ኩን ዋቀኬኘ፤</para>
  <para style="q2" vid="ISA 25:9">ኑ እሰ አመነትኔ፤ እንስ ኑ ኦልቼ።</para>
  <para style="q1" vid="ISA 25:9">ኩን <char style="nd">ዋቀዮዸ</char>፤ ኑ እሰ አመነትኔ፤</para>
  <para style="q2" vid="ISA 25:9">ኮታ ፈይሱሳት ገመድና፤ ንእልልችነስ።”<verse eid="ISA 25:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 25:10"/>ሀርክ <char style="nd">ዋቀዮ</char> ቱሉ ከነረ ንቦቆተ፤</para>
  <para style="q2" vid="ISA 25:10">ሞኣብ ገሩ አኩመ ጭዲን ድኬ ኬሰት ዽዺተሙ ሰነ</para>
  <para style="q2" vid="ISA 25:10">እሰ ጀለት ዽዺተመ።<verse eid="ISA 25:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 25:11"/>እንስ አኩመ ነምን ብሻን ዳኩ ቶኮ ዳኩፍ ሀርከ በልእፈቱ ሰነ፣</para>
  <para style="q2" vid="ISA 25:11">ጋረ ሰነረት ሀርከሳ ንበልእፈተ።</para>
  <para style="q1" vid="ISA 25:11">ዋቅንስ ኦፍ ቱሉማሳኒ፣</para>
  <para style="q2" vid="ISA 25:11">ኦጉማ ሀርከሳኒ ወጅን ገድ ዴብሰ።<verse eid="ISA 25:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 25:12"/>እን ደላኬ ኦል ዼራ ዸጋን እጃረሜ ሰነ፣</para>
  <para style="q2" vid="ISA 25:12">አከ እን ዱፉ ጎዸ፤</para>
  <para style="q2" vid="ISA 25:12">ለፈት ገድ ጅግሴስ ብዮት ደበለ።<verse eid="ISA 25:12"/></para>
  <chapter eid="ISA 25"/>
  <chapter number="26" style="c" sid="ISA 26"/>
  <para style="s1">ፋርፈትና ገለታ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 26:1"/>በረ ሰነ ፋርፈናን ኩን ብየ ይሁዳ ኬሰት ፋርፈተመ፦</para>
  <para style="q1" vid="ISA 26:1">ኑ መጋላ ጀባ ቀብነ፤</para>
  <para style="q2" vid="ISA 26:1">ዋቅንስ ፈይነ፣</para>
  <para style="q2" vid="ISA 26:1">ደላ ኤጉምሰሼቲፊ ደአትኖሼ ታስሰ።<verse eid="ISA 26:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 26:2"/>አከ ሰብን ቀጄላን፣</para>
  <para style="q2" vid="ISA 26:2">ሰብን አመነሙማዻን ጅራቱ ኦል ሴኑፍ፣</para>
  <para style="q2" vid="ISA 26:2">ከረወን በና።<verse eid="ISA 26:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 26:3"/>እን ስት እርከቴራቲ፣</para>
  <para style="q2" vid="ISA 26:3">ነመ ያድን ገራሳ ስ ወጅን ጅሩ፣</para>
  <para style="q2" vid="ISA 26:3">አት ነጋ ህርእነ ህንቀብኔን እሰ ኤግደ።<verse eid="ISA 26:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 26:4"/>ሰበቢ <char style="nd">ዋቀዮ</char>፣ <char style="nd">ዋቀዮ</char> መታንሳ፣</para>
  <para style="q2" vid="ISA 26:4">ከታ በረ በራ ተኤፍ፣ በረ በራን <char style="nd">ዋቀዮን</char> አመነዻ።<verse eid="ISA 26:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 26:5"/>እን ወረ እዶ ኦል ከኣረ ጅራተን ገድ ቀበ፤</para>
  <para style="q2" vid="ISA 26:5">መጋላ ተበረ ጅርቱ ገድ ቡሰ፤</para>
  <para style="q2" vid="ISA 26:5">ለፈት ገቴስ አዋረት እሼ መከ።<verse eid="ISA 26:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 26:6"/>ሚል፣ ሚል ወረ ሀጩጨሜ፣</para>
  <para style="q2" vid="ISA 26:6">ፋን ህዬዪሼ ዽዺተ።<verse eid="ISA 26:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 26:7"/>ዳንዲን ነመ ቀጄላ ወል ቅጣታዸ፤</para>
  <para style="q2" vid="ISA 26:7">ያ እሰ ቶላ፣ አት ቀጄልቶታፍ ከራ ባፍተ።<verse eid="ISA 26:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 26:8"/>ያ <char style="nd">ዋቀዮ</char>፣</para>
  <para style="q2" vid="ISA 26:8">ኑ ከራ ሴረኬቲረ ዴማ ስ ኤገትነ፣</para>
  <para style="q1" vid="ISA 26:8">መቃንኬቲፊ ቤከሙንኬ</para>
  <para style="q2" vid="ISA 26:8">ሀዊ ገራኬኛት።<verse eid="ISA 26:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 26:9"/>ሀልከን ሉቡንኮ ስ ያድ፤</para>
  <para style="q2" vid="ISA 26:9">ገነመስ ሀፉርኮ ባይእሴ ስ በርባደ።</para>
  <para style="q1" vid="ISA 26:9">ዬሮ ሙርቲንኬ ገረ ለፋ ዹፉት፣</para>
  <para style="q2" vid="ISA 26:9">ኡመትን አዱኛ ቀጄሉማ በረተ።<verse eid="ISA 26:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 26:10"/>ነምን ሀማን ገረ ላፍን ጎዸሙፍዩ፣</para>
  <para style="q2" vid="ISA 26:10">ቀጄሉማ ህንበረቱ፤</para>
  <para style="q1" vid="ISA 26:10">ብየ ቀጄሉማን ጅሩትዩ እን እቱመ ፉፌ ጀልእነ ሆጄተ፤</para>
  <para style="q2" vid="ISA 26:10">ሱራ <char style="nd">ዋቀዮስ</char> ህንሁበቱ።<verse eid="ISA 26:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 26:11"/>ያ <char style="nd">ዋቀዮ</char>፣ ሀርክኬ ኦል ካፈሜረ፤</para>
  <para style="q2" vid="ISA 26:11">እሳን ገሩ እሰ ህንአርገን።</para>
  <para style="q1" vid="ISA 26:11">እሳን ህናፋ አት ሰበኬቲፍ ቀብዱ አርገኒ ሃቃነአን፤</para>
  <para style="q2" vid="ISA 26:11">እብድ ዲኖተኬቲፍ ኩፈሜ ሱን እሳን ሃበሌሱ።<verse eid="ISA 26:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 26:12"/>ያ <char style="nd">ዋቀዮ</char>፣ አት ነጋ ኑፍ ኬንቴርተ፤</para>
  <para style="q2" vid="ISA 26:12">አት ሆጂኬኘ ሁንደ ኑፍ ሆጄቴርታቲ።<verse eid="ISA 26:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 26:13"/>ያ <char style="nd">ዋቀዮ</char> ዋቀኬኘ፣</para>
  <para style="q2" vid="ISA 26:13">ስ መሌ ጎፍቶትን ብራ ኑ ቡልቸኒሩ፤</para>
  <para style="q2" vid="ISA 26:13">ኑ ገሩ መቃኬ ቆፈ ኡልፌስነ።<verse eid="ISA 26:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 26:14"/>እሳን አመ ዱአኒሩ፤ ስአች ህንጅራተን፤</para>
  <para style="q2" vid="ISA 26:14">እሳን ጋድዱዸ፤ ዴብአኒስ ህንከአን።</para>
  <para style="q1" vid="ISA 26:14">አት እሳን አደብዴ፤ እሳን በሌስቴስ፤</para>
  <para style="q2" vid="ISA 26:14">ያደኖሳኒ ሁንደስ ንበርበዴስቴ።<verse eid="ISA 26:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 26:15"/>ያ <char style="nd">ዋቀዮ</char>፣ አት ሰበ ባይእስቴርተ፤</para>
  <para style="q2" vid="ISA 26:15">አት ሰበ ባይእስቴርተ፤</para>
  <para style="q1" vid="ISA 26:15">አት ኦፊኬቲፍ ኡልፍነ አርገቴርተ፤</para>
  <para style="q2" vid="ISA 26:15">ዳሪ ብያ ሁንደ በልእፍቴርተ።<verse eid="ISA 26:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 26:16"/>ያ <char style="nd">ዋቀዮ</char>፣ እሳን ዬሮ ዽጵናት ስ በርባደተን፤</para>
  <para style="q2" vid="ISA 26:16">ዬሮ አት እሳን አደብዴት</para>
  <para style="q2" vid="ISA 26:16">እሳን ከዸትና ገድ ሮብሰን።<verse eid="ISA 26:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 26:17"/>አኩመ ዱበርቲን ኡልፋ ዬሮ ደኡ ጌሱት፣</para>
  <para style="q2" vid="ISA 26:17">ጭኒንሱዻን ውጥርፈቴ እይቱ ሰነ፣</para>
  <para style="q2" vid="ISA 26:17">ያ <char style="nd">ዋቀዮ</char>፣ ኑስ ፉለኬ ዱረት አከሱመ ታኔረ።<verse eid="ISA 26:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 26:18"/>ኑ ኡልፎፍኔ፣ ጭኒንሱዻን ውጥርፈትኔ፤</para>
  <para style="q2" vid="ISA 26:18">ኑ ገሩ ቡቤ ዴኜ።</para>
  <para style="q1" vid="ISA 26:18">ኑ ለፋፍ ፈይነ ህንፍድኔ፤</para>
  <para style="q2" vid="ISA 26:18">ኑ ኡመተ አዱኛ ህንዴኜ።<verse eid="ISA 26:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 26:19"/>ገሩ ነሞትንኬ ከኔን ዱአን ንጅራቱ፤</para>
  <para style="q2" vid="ISA 26:19">ዸግንሳኒስ ዱኣ ንከአ።</para>
  <para style="q1" vid="ISA 26:19">እስን ወር ብዮ ኬሰ ጅራተን፣</para>
  <para style="q2" vid="ISA 26:19">ደመቃቲ ገመቹዻን እልልቻ።</para>
  <para style="q1" vid="ISA 26:19">ፍጤንስኬ አኩመ ፍጤንሰ ገነማት፤</para>
  <para style="q2" vid="ISA 26:19">ለፍትስ ወረ ዱአን ኦፍ ኬሳ ባፍት።<verse eid="ISA 26:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 26:20"/>ያ ሰበኮ፣ ኩታ መነኬት ኦል ገሊቲ</para>
  <para style="q2" vid="ISA 26:20">ዱባን በልበለ ኦፍት ጩፍ፤</para>
  <para style="q1" vid="ISA 26:20">ሀመ ዼከምስሳ ደርቡት፣</para>
  <para style="q2" vid="ISA 26:20">ዬሮ ሙራሳፍ ኦፍ ዾክስ።<verse eid="ISA 26:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 26:21"/>ኩኖ፣ <char style="nd">ዋቀዮ</char> ሰበቢ ጩቡሳኒቲፍ</para>
  <para style="q2" vid="ISA 26:21">ኡመተ ለፈራ አደቡፍ <optbreak/> እዶ ጅሬኘሳቲ በኤ ዹፋ ጅረ።</para>
  <para style="q1" vid="ISA 26:21">ለፍት ዺገ እሼረት ዸንገላፈሜ ሰነ እፈ ባፍት፤</para>
  <para style="q2" vid="ISA 26:21">ስአች ወረ እሼረት ቀለመን ህንዾክስቱ።<verse eid="ISA 26:21"/></para>
  <chapter eid="ISA 26"/>
  <chapter number="27" style="c" sid="ISA 27"/>
  <para style="s1">ፉረሙ እስራኤል</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 27:1"/>በረ ሰነ፣</para>
  <para style="q1" vid="ISA 27:1">
    <char style="nd">ዋቀዮ</char> ጎራዴሳቲን፣</para>
  <para style="q2" vid="ISA 27:1">ጎራዴሳ ሶዳችሳ፣ ጉዳፊ ጀባ ሰናን፣</para>
  <para style="q1" vid="ISA 27:1">ሌዋታን ቦፍቸ ምርምርፈሙ፣</para>
  <para style="q2" vid="ISA 27:1">ሌዋታን ቦፍቸ መርመረሙ ሰነ ንአደበ፤</para>
  <para style="q1" vid="ISA 27:1">እን ጀዌ ገላነ ኬሰ ጅራቱ ንኩኩተ።<verse eid="ISA 27:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 27:2"/>በረ ሰነ አከነ ጄዸመ፤</para>
  <para style="q1" vid="ISA 27:2">“ዋኤ እዶ ዻባ ወይኒ ከን ነመት ቶሉ ሰና ፋርፈዻ፤<verse eid="ISA 27:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="ISA 27:3"/>አን <char style="nd">ዋቀዮ</char> እሰ ነንኤገ፤</para>
  <para style="q2" vid="ISA 27:3">አን ዬሮ ሁንደ ብሻን ነንኦባሰ፤</para>
  <para style="q1" vid="ISA 27:3">አከ ነምን ቶኮዩ እሰ ህንሚኔፍ</para>
  <para style="q2" vid="ISA 27:3">አን ሀልከኒፊ ጉያ እሰ ነንኤገ።<verse eid="ISA 27:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="ISA 27:4"/>አን ህንኣሩ።</para>
  <para style="q1" vid="ISA 27:4">ሶኮሩፊ ቆራቲን ወራናፍ ኡቱ ነት በአኒ!</para>
  <para style="q2" vid="ISA 27:4">አን ስላ እሳንት ነንዱለ፤</para>
  <para style="q2" vid="ISA 27:4">ወልት ቀቤስ እሳን ነንጉበ።<verse eid="ISA 27:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 27:5"/>ዮ ከና አቺ እሳን ኮሉ ነት ሃገለን፤</para>
  <para style="q2" vid="ISA 27:5">እሳን ነ ወጅን ነጋ ሃኡመን፤</para>
  <para style="q2" vid="ISA 27:5">ኤዬ፣ እሳን ነ ወጅን ነጋ ሃኡመን።”<verse eid="ISA 27:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 27:6"/>በረ ዹፉፍ ጅሩ ኬሰ ያቆብ ህደ ባሰ፤</para>
  <para style="q2" vid="ISA 27:6">እስራኤል ለቴ ደራረ፤</para>
  <para style="q2" vid="ISA 27:6">እጃንስ አዱኛ ሁንደ ጉተ።<verse eid="ISA 27:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 27:7"/>
    <char style="nd">ዋቀዮ</char> አኩመ ወረ እሼ ሩኩተን ሰነ ሩኩቴ፣</para>
  <para style="q2" vid="ISA 27:7">እሼሌ ሩኩቴራ?</para>
  <para style="q1" vid="ISA 27:7">አኩመ ወር እሼ አጄሰን ሱን አጄፈመን፣</para>
  <para style="q2" vid="ISA 27:7">እሼንስ አጄፈምቴርቲ?<verse eid="ISA 27:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 27:8"/>አት ወራኑፊ አርኡዻን እሼዻን ወል ፈልምቴ፤</para>
  <para style="q2" vid="ISA 27:8">እን ጉያ ቡቤን በኣ ቡብሱት፣</para>
  <para style="q2" vid="ISA 27:8">ቡቤሳ ሶዳችሳ ሰናን እሼ በሌሰ።<verse eid="ISA 27:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 27:9"/>ዮሙ እን ዸጎተ እዶ ኣርሳ ሁንደ</para>
  <para style="q2" vid="ISA 27:9">አኩመ ዸጋ ኖራ ጨጨብሰሜ ጎዹት፣</para>
  <para style="q1" vid="ISA 27:9">ሲዳን አሼራ ዮካን እዶን ኣርሳ እጣና ቶኮዩ <optbreak/> ዻበቴ ህንሀፉ።</para>
  <para style="q2" vid="ISA 27:9">አከሲንስ በሌሳን ያቆብ ንሀቀማፍ፤</para>
  <para style="q2" vid="ISA 27:9">ኩንስ ጩቡንሳ ጉቱማን ጉቱት ሀቀሙሳ ምርከኔሰ።<verse eid="ISA 27:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 27:10"/>መጋላን ደላ ጀባ ቀብዱ ንኦንት፤</para>
  <para style="q2" vid="ISA 27:10">አከ ገሞጂ ገተምቴቲፊ ዺፈምቴ ታት፤</para>
  <para style="q1" vid="ISA 27:10">ጀቦትን አች ዼድ፤</para>
  <para style="q2" vid="ISA 27:10">አችስ ንጭጪፍት፤</para>
  <para style="q2" vid="ISA 27:10">ጀቦትን ደሜሼ ቆርቀኒ ቁላ ሀምብሱ።<verse eid="ISA 27:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 27:11"/>ደሜንሼ ዬሮ ጎጉት እራ ጨጨበ፤</para>
  <para style="q2" vid="ISA 27:11">ዱበርቶትንስ ዹፈኒ እብደት ነቀቱ።</para>
  <para style="q1" vid="ISA 27:11">ኡመትን ኩን ሁበትና ህንቀቡቲ፤</para>
  <para style="q2" vid="ISA 27:11">ከናፉ ቶልቻንሳኒ ገራ ህንላፉፍ፤</para>
  <para style="q2" vid="ISA 27:11">ኡማንሳኒስ እሳኒፍ ህንአራረሙ።<verse eid="ISA 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 27:12"/>በረ ሰነ <char style="nd">ዋቀዮ</char> ለገ ኤፍራጢሲ ሀመ ለገ ግብጥት ምዻን ዸአ፤ ያ እስራኤሎተ፣ እስን ቶኮ ቶኮን ወልት ንቀበምቱ። <verse eid="ISA 27:12"/><verse number="13" style="v" sid="ISA 27:13"/>በረ ሰነ መለከትን ጉዳን ቶኮ ንአፉፈመ። ወር አሶር ኬሰት በደኒ ቱረኒፊ ወር ግብጥ ኬሰት ፈፈጨአኒ ቱረን ዹፈኒ ቱሉ ቁልቁሉረት ዬሩሳሌም ኬሰት <char style="nd">ዋቀዮን</char> ዋቄፈቱ።<verse eid="ISA 27:13"/></para>
  <chapter eid="ISA 27"/>
  <chapter number="28" style="c" sid="ISA 28"/>
  <para style="s1">ሆገንቶተ ኤፍሬሚፍ ወዮ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 28:1"/>ጎንፎ ኦፍ ቱሉማ ከን መቾፍቶተ ኤፍሬም ሰናፍ፣</para>
  <para style="q2" vid="ISA 28:1">ደራራ ጮለጉ ከን ኡልፍነ ሚዸግነሳኒቲፍ፣</para>
  <para style="q1" vid="ISA 28:1">ከን መታ ሱሉለ ገበታረ ጅሩፍ፣</para>
  <para style="q2" vid="ISA 28:1">መጋላ ወረ ዳዺ ወይኒቲን ፉዸተመን <optbreak/> ሰናቲፍ ወዮ!<verse eid="ISA 28:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 28:2"/>ኩኖ፣ ጎፍታን እሰ ሁምነ ቀቤሳፊ ጀባ ቶኮ ቀበ።</para>
  <para style="q2" vid="ISA 28:2">እን አኩመ ጨቢቲፊ ቡቤ ዋ በሌሱ፣</para>
  <para style="q1" vid="ISA 28:2">አኩመ ቦካ ጀባቲፊ ብሻን ጉቴ እረ ዸንገለኡ፣</para>
  <para style="q2" vid="ISA 28:2">ሁምናን ለፈት ገድ እሼ ደርበተ።<verse eid="ISA 28:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 28:3"/>ጎንፎን ኦፍ ቱሉማ፣</para>
  <para style="q2" vid="ISA 28:3">መቾፍቶትን ኤፍሬም ሚለ ጀለት ዽዺተሙ።<verse eid="ISA 28:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 28:4"/>ደራራን ሀርጨኡ፣ ሚዸግንሳ ከበጀማን፣</para>
  <para style="q2" vid="ISA 28:4">ከን መታ ሱሉለ ገበታረ ጅሩ ሱን፣</para>
  <para style="q1" vid="ISA 28:4">አኩመ ሙከ ሀርቡ ኡቱ ቦን ህንገእን ብልቻቱ ሰና ተአ፤</para>
  <para style="q2" vid="ISA 28:4">ነምን እሰ አርጉ ሁንድ አኩመ እሰ ሀርከ ኬሰ ገልፈቴን <optbreak/> እሰ ኛቴ ፍጠ።<verse eid="ISA 28:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 28:5"/>በረ ሰነ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ</para>
  <para style="q2" vid="ISA 28:5">ሀምባ ሰበሳቲፍ፣</para>
  <para style="q1" vid="ISA 28:5">ጎንፎ ኡልፍና፣</para>
  <para style="q2" vid="ISA 28:5">ምአ ሚዸግና ንተአ።<verse eid="ISA 28:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 28:6"/>እን ነመ ሙርቲ ኬኑፍ ታኡፍ ሀፉረ ሙርቲ ቀጄላ ተአ፤</para>
  <para style="q2" vid="ISA 28:6">ወረ ከረራ ወራነ ዴብሰኒፍሞ <optbreak/> መደ ጀብና ተአ።<verse eid="ISA 28:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 28:7"/>ጀር ኩን ዳዺ ወይኒቲን ገተንተሩ፤</para>
  <para style="q2" vid="ISA 28:7">ዹጋቲ ጀባዻን ዶጎጎሩ፤</para>
  <para style="q1" vid="ISA 28:7">ሉቦትኒፊ ራጆትን ዹጋቲ ጀባዻን ገተንተሩ፤</para>
  <para style="q2" vid="ISA 28:7">ዳዺ ወይኒቲን ፉዸተሙ፤</para>
  <para style="q1" vid="ISA 28:7">እሳን ዹጋቲ ጀባዻን ከራራ በዱ፤</para>
  <para style="q2" vid="ISA 28:7">ዬሮ ሙልአተ አርገንትስ ንዶጎጎሩ፤</para>
  <para style="q2" vid="ISA 28:7">ዬሮ ሙርቲ ኬነንትስ ንዶጎጎሩ።<verse eid="ISA 28:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 28:8"/>ማዲን ሁንድኑ ድድጋን ጉተሜረ፤</para>
  <para style="q2" vid="ISA 28:8">እዶን ህንጡሬፈምን ቶኮዩ ህንጅሩ።<verse eid="ISA 28:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 28:9"/>“ነምን እን ዋ በርሲሱ ያሉ ኩን ኤኙ?</para>
  <para style="q2" vid="ISA 28:9">እን ኤኙፍ ኤርጋሳ እብሳ ጅረ?</para>
  <para style="q1" vid="ISA 28:9">እጆሌ ኣነን ዺፍቴፍሞ</para>
  <para style="q2" vid="ISA 28:9">እጆሌ ሀርመ ጉቴፍ?<verse eid="ISA 28:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 28:10"/>አጀጀረት አጀጀ፤ አጀጀረት አጀጀ፤</para>
  <para style="q2" vid="ISA 28:10">ስርነረት ስርነ፤ ስርነረት ስርነ፤</para>
  <para style="q2" vid="ISA 28:10">አስት ሙራሰ፤ አችት ሙራሰ” ተኣቲ።<verse eid="ISA 28:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 28:11"/>ዮስ ዋቅን አፋን አለጎታቲን፣</para>
  <para style="q2" vid="ISA 28:11">አፋን ህንቤከምኔንስ ሰበ ከነት ንዱበተ፤<verse eid="ISA 28:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 28:12"/>እን አከነ እሳኒን ጄዼ፤</para>
  <para style="q2" vid="ISA 28:12">“ኩን እዶ ቦቆናት፤ ወር ደዸበን ሃቦቆተን፤</para>
  <para style="q1" vid="ISA 28:12">ኩን እዶ ኣረ ገልፈትናት።”</para>
  <para style="q2" vid="ISA 28:12">እሳን ገሩ ዸገኡ ድደን።<verse eid="ISA 28:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 28:13"/>ዮ አከሲ ዱቢን <char style="nd">ዋቀዮ</char> አከነ እሳንት ተአ፤</para>
  <para style="q2" vid="ISA 28:13">አጀጀረት አጀጀ፤ አጀጀረት አጀጀ፤</para>
  <para style="q1" vid="ISA 28:13">ስርነረት ስርነ፤ ስርነረት ስርነ፤</para>
  <para style="q2" vid="ISA 28:13">አስት ሙራሰ፤ አችት ሙራሰ፤</para>
  <para style="q1" vid="ISA 28:13">ኩንስ አከ እሳን ዸቀኒ ዱግደ ዱበት ኩፈኒፊ</para>
  <para style="q2" vid="ISA 28:13">አከ እሳን ጨጨበኒ ክዮዻን ቀበመኒፍ።<verse eid="ISA 28:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 28:14"/>ከናፉ እስን ቆስቶትን</para>
  <para style="q2" vid="ISA 28:14">ወር ኡመተ ዬሩሳሌም ቡልችተን ዱቢ <optbreak/> <char style="nd">ዋቀዮ</char> ዸገኣ።<verse eid="ISA 28:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 28:15"/>እስን አከነ ጄተኒ ኦፍ ቱልቱ፤ “ኑ ዱአ ወጅን ከኩ ገሌረ፤</para>
  <para style="q2" vid="ISA 28:15">ሲኦል ወጅንስ ወሊ ገልቴ ጎኔረ።</para>
  <para style="q1" vid="ISA 28:15">ሰበቢ ኑ ሶበ ደኦ ጎዸትኔ፣</para>
  <para style="q2" vid="ISA 28:15">ሶበስ እዶ እት ዾከትኑ ጎዸኔፍ፣</para>
  <para style="q1" vid="ISA 28:15">በላን ሀማን ዬሮ ዹፌ ለፈ በሌሱት</para>
  <para style="q2" vid="ISA 28:15">ኑ ቱቁ ህንደንደኡ።”<verse eid="ISA 28:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 28:16"/>ከናፉ <char style="nd">ዋቀዮ</char> ጎፍታን አከነ ጄዸ፤</para>
  <para style="q1" vid="ISA 28:16">“ኩኖ አን ዸጋ ቶኮ፣ ዸጋ ቆረተሜ፣</para>
  <para style="q2" vid="ISA 28:16">ዸጋ ጎሌ ገት ጀቤሰ ቶኮ</para>
  <para style="q1" vid="ISA 28:16">ሁንዴ ምርከናኣዻፍ ጥዮን ኬሰ ነንካአ፤</para>
  <para style="q2" vid="ISA 28:16">ነምን አመኑ ከምዩ ህንቃነኡ።<verse eid="ISA 28:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 28:17"/>አን ሙርቲ ቀጄላ ፉኞ እቲን ሰፈረን፣</para>
  <para style="q2" vid="ISA 28:17">ቀጄሉማሞ መዳሊ ነንጎዸዸ፤</para>
  <para style="q1" vid="ISA 28:17">ሶበ እስን ደኦ ጎዸተን ሰነ ቦካን ጀባን ንበሌሰ፤</para>
  <para style="q2" vid="ISA 28:17">ብሻንስ ለፈ እስን እት ዾከተን ኬሰ ንሎለአ።<verse eid="ISA 28:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 28:18"/>ከኩን እስን ዱአ ወጅን ጎዸተን ንዲገመ፤</para>
  <para style="q2" vid="ISA 28:18">ወሊ ገልቴን እስን ሲኦል ወጅን ጎዸተንስ <optbreak/> ንበርበዴፈመ።</para>
  <para style="q1" vid="ISA 28:18">ዬሮ በላን ሀማን ዹፌ ለፈ በሌሱት</para>
  <para style="q2" vid="ISA 28:18">እስን ለፈት ገድ ዽዺተምቱ።<verse eid="ISA 28:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 28:19"/>እን ዬሮ ዹፉ ሁንደ እስን ፉዸቴ ዴመ፤</para>
  <para style="q2" vid="ISA 28:19">ገነመ ገነመ ሀልከኒፊ ጉያስ፣ <optbreak/> እን ዋ በሌሰ።”</para>
  <para style="b" vid="ISA 28:19"/>
  <para style="q1" vid="ISA 28:19">ኤርጋ ከነ ሁበቹን</para>
  <para style="q2" vid="ISA 28:19">ናሱ ጉዳ ነመት ፍደ።<verse eid="ISA 28:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 28:20"/>ስሬን እረት ድሪርፈቹፍ ባይኤ ገባባዸ፤</para>
  <para style="q2" vid="ISA 28:20">ኡፈተ ሀልከኒ ኦፍት መረቹፍ ባይኤ ዽጳዸ።<verse eid="ISA 28:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 28:21"/>
    <char style="nd">ዋቀዮ</char> ሆጂሳ፣ ሆጂሳ ሃራ ሰነ ሆጄቹፍ፣</para>
  <para style="q2" vid="ISA 28:21">ጎቸሳ፣ ጎቸሳ ከን ህንቤከምኔ ሰነ ሆጄቹፍ፣</para>
  <para style="q1" vid="ISA 28:21">አኩመ ቱሉ ጴራዚም ኬሰት ጎዼ ሰነ ንከአ፤</para>
  <para style="q2" vid="ISA 28:21">አኩመ ሱሉለ ግቤኦንት ጎዼ ሰነ ንከአ።<verse eid="ISA 28:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 28:22"/>አመ ቆሳኬሰን ዺሳ፤</para>
  <para style="q2" vid="ISA 28:22">ዮ አከስ ህንተእን ፎንጫንኬሰን እስንት ጀባተ፤</para>
  <para style="q1" vid="ISA 28:22">ጎፍታን፣ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣</para>
  <para style="q2" vid="ISA 28:22">ለብሲ ጉቱማ ብየቲ በሌሱፍ ለብሴ ነት ህሜረ።<verse eid="ISA 28:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 28:23"/>ዸጌፈዻቲ ሰገሌኮ ዸገኣ፤</para>
  <para style="q2" vid="ISA 28:23">ቀልቤፈዻቲ ዋን አን ዱበዹ ዸገኣ።<verse eid="ISA 28:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 28:24"/>ቆናን ቡላን ቶኮ ዬሮ ሰኚ ፈጫሱፍ ለፈ ቆተቱት፣ <optbreak/> እቱመ ፉፌ ቆታ?</para>
  <para style="q2" vid="ISA 28:24">እን እቱመ ፉፌ ብዮ ጨጨብሴ ቡሌሳ?<verse eid="ISA 28:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 28:25"/>እን ዬሮ ለፈ ወል ቅጤሱት</para>
  <para style="q2" vid="ISA 28:25">ድምብላላፊ ከሙኒ ህንፈጫሱ?</para>
  <para style="q1" vid="ISA 28:25">እን ቀመዲ ቶረ ቶራን፣</para>
  <para style="q2" vid="ISA 28:25">ገርቡ እዶሳረት፣</para>
  <para style="q2" vid="ISA 28:25">ሆንቦሪስ ለፈ ቆቲሳሳረት ህንፈጫሱ?<verse eid="ISA 28:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 28:26"/>ዋቅንሳ እሰ በርሲሰ፤</para>
  <para style="q2" vid="ISA 28:26">ከራ ቀጄላረስ እሰ ቡሰ።<verse eid="ISA 28:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 28:27"/>አበሱድን ገንገልቻዻን ህንዸአሙ፤</para>
  <para style="q2" vid="ISA 28:27">ከሙኒ እረስ ጎማን ጋሪ ህንኦፈሙ፤</para>
  <para style="q1" vid="ISA 28:27">አበሱድን ኡሌዻን፣</para>
  <para style="q2" vid="ISA 28:27">እንስላልሞ ሽመላን ዸአመ።<verse eid="ISA 28:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 28:28"/>ምዻን ቡዴነ ቶልቹፍ ዳከሙ ቀበ፤</para>
  <para style="q2" vid="ISA 28:28">ከናፉ ነምን ቶኮ በረ በራን ምዻን ህንዸኡ።</para>
  <para style="q1" vid="ISA 28:28">እን ጎማ ጋሪ ከን ምዻን ዸኡ ምዻን ሰነረ ኦፉዩ</para>
  <para style="q2" vid="ISA 28:28">ፈርዴንሳ ምዻንቸ ህንቡሌሰን።<verse eid="ISA 28:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 28:29"/>ወን ኩን ሁንድኑ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣</para>
  <para style="q2" vid="ISA 28:29">እሰ መሪዻን ድንቅሲሳ፣</para>
  <para style="q2" vid="ISA 28:29">ኦጉማዻንስ ጉዳ ተኤ ብራ ዹፈ።<verse eid="ISA 28:29"/></para>
  <chapter eid="ISA 28"/>
  <chapter number="29" style="c" sid="ISA 29"/>
  <para style="s1">መጋላ ዳዊቲፍ ወዮ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 29:1"/>ያ አሪኤል፣ ያ አሪኤል፣</para>
  <para style="q2" vid="ISA 29:1">መጋላ ዳዊት ኬሰ ጅራቴ፣ ሲፍ ወዮ!</para>
  <para style="q1" vid="ISA 29:1">ወጋረት ወጋ ደበላ፤</para>
  <para style="q2" vid="ISA 29:1">አያኖትን ወጋስ እቱመ ሃፉፈን።<verse eid="ISA 29:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 29:2"/>ተኡስ አን አሪኤልን መርሴ ነንቀበ፤</para>
  <para style="q2" vid="ISA 29:2">እሼን ቦሴ ንወዋት፤</para>
  <para style="q2" vid="ISA 29:2">እሼን አናፍ አከ አሪኤል ታት።<verse eid="ISA 29:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 29:3"/>አን ከራ ሁንዳን ናኖኬ ነንቁበዸ፤</para>
  <para style="q2" vid="ISA 29:3">ገሞወኒንስ ስን መርሰ፤</para>
  <para style="q2" vid="ISA 29:3">ቱላ ብዮስ ስት ናኔሴ ነንዻበ።<verse eid="ISA 29:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 29:4"/>አት ገድ ዴብፈምቴ ለፈራ ንዱበተ፤</para>
  <para style="q2" vid="ISA 29:4">ሃሳንኬ ብዮ ኬሳ ጉንጉመ።</para>
  <para style="q1" vid="ISA 29:4">ሰገሌንኬ አከ ሰገሌ ኤኬራ ለፈ ኬሳ በአ፤</para>
  <para style="q2" vid="ISA 29:4">ሃሳንኬስ ብዮ ኬሳ ሀሳሰ።<verse eid="ISA 29:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 29:5"/>ዲኖትንኬ ሄዱን ገሩ አከ አዋረ ቡላኤ፣</para>
  <para style="q2" vid="ISA 29:5">ገረ ጀቤዪን ባይኤንስ አከ ሀበቂ ቡቤን ፉዸቴ ተኡ።</para>
  <para style="q1" vid="ISA 29:5">አኩመ ተሳ ኡቱ ህንቤከምንስ፣<verse eid="ISA 29:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="ISA 29:6"/>
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣</para>
  <para style="q1" vid="ISA 29:6">በከካዻን፣ ሶቺ ለፋቲፊ ወጨ ጉዳዻን፣</para>
  <para style="q2" vid="ISA 29:6">ቡቤዻን፣ ቡቤ ሀማፊ አረበ እብደ ዋ ፍጡቲን ንዹፈ።<verse eid="ISA 29:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 29:7"/>ኤርገሲ ቱትን ሰቦተ ሁንዳ ከን አሪኤሊን ሎሉ፣</para>
  <para style="q2" vid="ISA 29:7">ከን እሼፊ ደኦሼ ጀጀቦ ዸኤ መርሴ ቀቡ፣</para>
  <para style="q1" vid="ISA 29:7">አኩመ አብጁ፣</para>
  <para style="q2" vid="ISA 29:7">አኩመ ሙልአተ ሀልከን ኬሳ ተአ፤<verse eid="ISA 29:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 29:8"/>ኩንስ አኩመ ነምን ቤለኤ ቶኮ አከ ዋ ኛቻ ጅሩ አብጁዻን አርጌ</para>
  <para style="q2" vid="ISA 29:8">ዬሮ ደመቁት ገሩ አመሌ ቤለ ቀቡ ሰነ፣</para>
  <para style="q1" vid="ISA 29:8">ዮካን አኩመ ነምን ዼቦቴ ቶኮ አከ ዋ ዹጋ ጅሩ አብጁዻን አርጌ</para>
  <para style="q2" vid="ISA 29:8">ዬሮ ደመቁት ገሩ አመሌ ዼቡዻን ገገቡ ሰነ ተአ።</para>
  <para style="q1" vid="ISA 29:8">ቱተ ሰቦተ ሁንዳ</para>
  <para style="q2" vid="ISA 29:8">ከን ቱሉ ጥዮን ሎሉረትስ አከሱመ ተአ።<verse eid="ISA 29:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 29:9"/>ርፈዻ፤ ድንቅሲፈዻስ፤</para>
  <para style="q2" vid="ISA 29:9">ኦፍ ጃምሳቲ ነመ ዋ ህንአርግኔ ተኣ፤</para>
  <para style="q1" vid="ISA 29:9">መቻኣ፤ ገሩ ዳዺ ወይኒቲን ህንተእን፤</para>
  <para style="q2" vid="ISA 29:9">ገተንተራ፤ ገሩ ዹጋቲ ጀባዻን ህንተእን።<verse eid="ISA 29:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 29:10"/>
    <char style="nd">ዋቀዮ</char> ህርበ ጭማ እስንት ቡሴረ፤</para>
  <para style="q2" vid="ISA 29:10">እጀኬሰን ራጆተ፣ ጩፌረ፤</para>
  <para style="q2" vid="ISA 29:10">መታኬሰን እላልቶተስ፣ ሀጉጌረ።<verse eid="ISA 29:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 29:11"/>ሙልአትን ኩን ሁንድ እስኒፍ ዱቢ ክታበ መረማረት ቻፔፈሜ መሌ ሆማ ምት። ዮ እስን ክታበ ከነ ነመ ዱብሱ ደንደኡ ቶኮት ኬንተኒ፣ “ማሎ ሜ ዋን ከነ ዱብስ” ጄተኒን እን፣ “ሰበቢ ክታብች ቻፔፈሜፍ አን ዱብሱ ህንደንደኡ” ጄዼ ዴብሰ። <verse eid="ISA 29:11"/><verse number="12" style="v" sid="ISA 29:12"/>ዮካን ዮ እስን ክታበ መረማ ከነ ነመ ዱብሱ ህንደንዴኜ ቶኮት ኬንተኒ፣ “ማሎ ሜ ዋን ከነ ዱብስ” ጄተኒን እን፣ “አን አከምት አከን ዱብሱ ህንቤኩ” ጄዼ ዴብሰ።<verse eid="ISA 29:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 29:13"/>ጎፍታን አከነ ጄዸ፦</para>
  <para style="q1" vid="ISA 29:13">“ኡመትን ኩን አፋንሳቲን ነት ዽኣተ፤</para>
  <para style="q2" vid="ISA 29:13">ህዺሳቲንስ ነ ከበጀ፤</para>
  <para style="q2" vid="ISA 29:13">ገራንሳ ገሩ ነራ ፈጎ ጅረ።</para>
  <para style="q1" vid="ISA 29:13">ዋቄፈትናን እሳን ነ ዋቄፈተንስ</para>
  <para style="q2" vid="ISA 29:13">ሴረ ነምን በርሲሱ ቆፋን ቶልፈሜ።<verse eid="ISA 29:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 29:14"/>ከናፉ አን አመሌ ድንቂረት ድንቂ ደበሌ</para>
  <para style="q2" vid="ISA 29:14">ኡመተ ከነ ነንድንቅሲሰ፤</para>
  <para style="q1" vid="ISA 29:14">ኦጉማን ነመ ኦጌሳ ንበደ፤</para>
  <para style="q2" vid="ISA 29:14">ሁበትናን ሁበቶታስ ንዾከተ።”<verse eid="ISA 29:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 29:15"/>ወረ ከሮረሳኒ</para>
  <para style="q2" vid="ISA 29:15">
    <char style="nd">ዋቀዮ</char> ዱራ ዾክፈቹፍ ጄዸኒ <optbreak/> ቅሌት ገድ ቡአኒፍ፣</para>
  <para style="q1" vid="ISA 29:15">ወረ ሆጂሳኒ ዱከነ ኬሰት ሆጄተኒ፣</para>
  <para style="q2" vid="ISA 29:15">“ኤኙቱ ኑ አርገ? ኤኙቱ ቤከ?” <optbreak/> ጄዸኒ ያደኒፍ ወዮ!<verse eid="ISA 29:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 29:16"/>ኩን ጀልእነኬሰን፣</para>
  <para style="q2" vid="ISA 29:16">ሱጴ ዾፍቱ አከ ሱጴት እላልቱ!</para>
  <para style="q1" vid="ISA 29:16">ወን ቶልቸሜ ቶኮ ነመ እሰ ቶልቼን</para>
  <para style="q2" vid="ISA 29:16">“እን ነ ህንቶልችኔ” ጄዻ?</para>
  <para style="q1" vid="ISA 29:16">ኦኮቴን ቶኮ ሱጴ ዾፍቱዻን፣</para>
  <para style="q2" vid="ISA 29:16">“እን ሆማ ህንቤኩ” ጄቹ ደንደኣ?<verse eid="ISA 29:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 29:17"/>ልባኖን ዬሮ ገባባ ኬሰት <optbreak/> ለፈ ቆቲሳ ገበቴ ህንታቱ?</para>
  <para style="q2" vid="ISA 29:17">ለፍት ቆና ገበታን ሱንስ ቦሶነ ህንፈካቱ?<verse eid="ISA 29:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 29:18"/>ጋፈስ ዱዳን ዱቢ ክታበ መረማ ንዸገአ፤</para>
  <para style="q2" vid="ISA 29:18">እጅ ነመ ጃማ ድምምሳፊ ዱከነ ኬሰት ንአርገ።<verse eid="ISA 29:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 29:19"/>ነምን ገድ ኦፍ ቀቡ አመስ <char style="nd">ዋቀዮት</char> ንገመደ፤</para>
  <para style="q2" vid="ISA 29:19">ረከቶትንስ ቁልቁልቸ እስራኤል ሰናን ንገመዱ።<verse eid="ISA 29:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 29:20"/>ገረ ጀቤዪን ንበዱ፤</para>
  <para style="q2" vid="ISA 29:20">ወር ነመት ቆሰን ንበርበዳኡ፤</para>
  <para style="q2" vid="ISA 29:20">ወር ሀምነ ሆጄቹ ጃለተን ሁንድኑ ንበሌፈሙ፤<verse eid="ISA 29:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 29:21"/>ወር ዱቢን የከማ ነመ ጎዸን፣</para>
  <para style="q2" vid="ISA 29:21">ወር ነምቸ መነ ሙርቲት ነማፍ ፈልሙ ዱረ ክዮ ካአኒ</para>
  <para style="q1" vid="ISA 29:21">ሶባን ዹጋ በኡዻን</para>
  <para style="q2" vid="ISA 29:21">ሙርቲ ቀጄላ ነመ የከ ህንቀብኔ ጀልእሰን ንበሌፈሙ።<verse eid="ISA 29:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 29:22"/>ከናፉ <char style="nd">ዋቀዮ</char> እን አብረሃምን ፉሬ ሱን መነ ያቆቢን አከነ ጄዸ፦</para>
  <para style="q1" vid="ISA 29:22">“ያቆብ ስአች ዴብኤ ህንቃነኡ፤</para>
  <para style="q2" vid="ISA 29:22">ፉልሳስ ስአች ህንዱከናኡ።<verse eid="ISA 29:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 29:23"/>እሳን ዬሮ ግዱሳኒት እጆሌሳኒ</para>
  <para style="q2" vid="ISA 29:23">ሆጂ ሀርከኮቲ ሰነ አርገንት፣</para>
  <para style="q1" vid="ISA 29:23">መቃኮ ንቁልቁሌሱ፤</para>
  <para style="q2" vid="ISA 29:23">እሳን ቁልቁሉማ ቁልቁልቸ ያቆብ ንቤኩ፤</para>
  <para style="q2" vid="ISA 29:23">ዋቀ እስራኤልስ ሶዳቹዻን ንጅራቱ።<verse eid="ISA 29:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 29:24"/>ወር ዶጎጎረን ሁበትና ንአርገቱ፤</para>
  <para style="q2" vid="ISA 29:24">ወር ጉንጉመንስ ቀጄልፈመ ንፉዸቱ።”<verse eid="ISA 29:24"/></para>
  <chapter eid="ISA 29"/>
  <chapter number="30" style="c" sid="ISA 30"/>
  <para style="s1">ሰበ ፍንጭላዻፍ ወዮ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 30:1"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q2" vid="ISA 30:1">“እጆሌ ፍንጭለን፣</para>
  <para style="q1" vid="ISA 30:1">ከኔን ከሮረ ከሮረኮ ህንተእን ዱካ ቡአን፣</para>
  <para style="q2" vid="ISA 30:1">ከኔን ፌዺኮቲን አለት ወሊ ገልቴ ኡመን፣</para>
  <para style="q2" vid="ISA 30:1">ከኔን ጩቡረት ጩቡ ደበለኒፍ ወዮ፤<verse eid="ISA 30:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 30:2"/>ከኔን ኡቱ አናን ህንመርአትን ግብጥት ገድ ቡአን፣</para>
  <para style="q2" vid="ISA 30:2">ከኔን ጋድሰ ግብጥ ደኦፍ፣</para>
  <para style="q1" vid="ISA 30:2">ኤጉምሰ ፈረኦንሞ</para>
  <para style="q2" vid="ISA 30:2">ገርጋርሳፍ አብደተኒፍ ወዮ።<verse eid="ISA 30:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 30:3"/>ኤጉምስ ፈረኦን ገሩ ቃኒ እስንት ተአ፤</para>
  <para style="q2" vid="ISA 30:3">ጋድስን ግብጥስ ሰልጵነ እስንት ፍደ።<verse eid="ISA 30:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 30:4"/>እሳን ዮ ዞኣን ኬሰት ቆንዳልቶተ ቀባተንዩ፣</para>
  <para style="q2" vid="ISA 30:4">ዮ ኤርገሞትንሳኒስ ሃኔስ ገአንዩ፣<verse eid="ISA 30:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 30:5"/>ቶኮን ቶኮንሳኒ ሰበቢ ኡመተ እሳን ህንፈየድኔ</para>
  <para style="q2" vid="ISA 30:5">ከኔን ቃኒፊ ሰልጵነ መሌ</para>
  <para style="q1" vid="ISA 30:5">ገርጋርሰ ዮካን ቡኣ ህንኬንኔ</para>
  <para style="q2" vid="ISA 30:5">ሰናቲፍ ንቃኔፈሙ።”<verse eid="ISA 30:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 30:6"/>ራጂ ዋኤ ብኔንሶተ ኔጌብ ዱበተሜ፦</para>
  <para style="q1" vid="ISA 30:6">ኤርገሞትን ቀቤኘሳኒ ሀሬት፣</para>
  <para style="q2" vid="ISA 30:6">ሜሻሳኒ ጋለት ፌአተኒ</para>
  <para style="q2" vid="ISA 30:6">ብየ ሌንጭ ኮርሚፊ ሌንጭ ዸላን፣</para>
  <para style="q1" vid="ISA 30:6">ቦፍት ሱሚ ቀቡፊ ቦፍት ደርበተሙ ጅራተን፣</para>
  <para style="q2" vid="ISA 30:6">ለፈ ረክናፊ ዽጵናን ጉቴ ኬሰ በአኒ</para>
  <para style="q1" vid="ISA 30:6">ገረ ብየ ሆማ ህንፈየድኔ<verse eid="ISA 30:6"/></para>
  <para style="q2">
    <verse number="7" style="v" sid="ISA 30:7"/>ገረ ግብጥ ከን ገርጋርስሼ ጎንኩማ ቡኣ ህንቀብኔ ሰና ዸቁ።</para>
  <para style="q1" vid="ISA 30:7">ከናፉ አን፣ “ረኣብ፣ ከን ሆማ ህንፈየድኔ”</para>
  <para style="q2" vid="ISA 30:7">ጄዼ እሼ ነንዋመ።<verse eid="ISA 30:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 30:8"/>አመ ዸቂቲ ገበቴረት በሬሲፍ፤</para>
  <para style="q2" vid="ISA 30:8">ክታበ መረማረት ከተቢፍ፤</para>
  <para style="q1" vid="ISA 30:8">ኩንስ አከ በሮተ ዹፉፍ ጅረን ኬሰ</para>
  <para style="q2" vid="ISA 30:8">ዹገ በኡምሰ በረ በራ ተኡፍ።<verse eid="ISA 30:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 30:9"/>ጀር ኩኔን ኡመተ ፍንጭላ፣ እጆሌ ሶብዱዸ፤</para>
  <para style="q2" vid="ISA 30:9">እጆሌ ሴረ <char style="nd">ዋቀዮ</char> ዸገኡፍ ፌዺ ህንቀብኔዸ።<verse eid="ISA 30:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 30:10"/>እሳን ሙልአተ አርግቶታን፣</para>
  <para style="q2" vid="ISA 30:10">“ስአች ሙልአተ ቶኮሌ ህንአርግና!” ጄዹ፤</para>
  <para style="q1" vid="ISA 30:10">ራጆታንስ አከነ ጄዹ፤</para>
  <para style="q2" vid="ISA 30:10">“እስን ስአች ሙልአተ ቀጄላ ተኤ ኑት ህንህምና!</para>
  <para style="q1" vid="ISA 30:10">ዋን ነመ ገመቺሱ ኑት ህማ፤</para>
  <para style="q2" vid="ISA 30:10">ጎዎምሳ ኑፍ ራጃ።<verse eid="ISA 30:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 30:11"/>ከራ ከነ ገድ ዺሳ፤</para>
  <para style="q2" vid="ISA 30:11">ዳንዲ ከነራ ጀልአዻ፤</para>
  <para style="q1" vid="ISA 30:11">ቁልቁልቸ እስራኤል ፉለኬኘ ዱራ</para>
  <para style="q2" vid="ISA 30:11">ዸበምሲሳ!” ጄዹ።<verse eid="ISA 30:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 30:12"/>ከናፉ ቁልቁልች እስራኤል አከነ ጄዸ፦</para>
  <para style="q1" vid="ISA 30:12">“ሰበቢ እስን ኤርጋ ከነ ድደኒ</para>
  <para style="q2" vid="ISA 30:12">ነመ ሀጩጩ አብደተኒ</para>
  <para style="q2" vid="ISA 30:12">ጎዎምሳት እርከተኒፍ፣<verse eid="ISA 30:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 30:13"/>ጩቡን ኩን፣ አኩመ ደላ ኦል ዼራ</para>
  <para style="q2" vid="ISA 30:13">ዸጋን እጃረሜ ከን በቀቄ ቦሶሴ</para>
  <para style="q2" vid="ISA 30:13">ከን ኡቱ ህንቤከምን ተሰ ጅጉ እስንት ተአ።<verse eid="ISA 30:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 30:14"/>ደላን ሱን አኩመ ምአ ሱጴት፣</para>
  <para style="q2" vid="ISA 30:14">ሀመ ወን እቲን ጭሌ ቦበኡ</para>
  <para style="q1" vid="ISA 30:14">እዶ እብዳቲ ፉዸንዩ ህንሀፍኔት</para>
  <para style="q2" vid="ISA 30:14">ዮካን ሀመ ወን እቲን ቦለ ብሻኒ ኬሳ</para>
  <para style="q2" vid="ISA 30:14">ብሻን ቡዱቅሰን ህንሀፍኔት አከ መሌ ጨጨቤ ቡርኩታአ።”<verse eid="ISA 30:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 30:15"/>
    <char style="nd">ዋቀዮ</char> ጎፍታን፣ ቁልቁልች እስራኤል አከነ ጄዸ፦</para>
  <para style="q1" vid="ISA 30:15">“ዴብኡፊ ቦቆቹዻን ንፈይቱ፤</para>
  <para style="q2" vid="ISA 30:15">ተስገባኡፊ አብደቹዻን ንጀባቱ፤</para>
  <para style="q2" vid="ISA 30:15">እስን ገሩ ከነ ህንጎኔ።<verse eid="ISA 30:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 30:16"/>እስንስ፣ ‘ለክ፣ ኑ ፈርዴኒን ንበቀትነ’ ጄቱ።</para>
  <para style="q2" vid="ISA 30:16">ከናፉ እስን ንበቀቱ!</para>
  <para style="q1" vid="ISA 30:16">እስን፣ ‘ኑ ፈርዴን አሪፈተኒ ፊገኒን ንጉሉፍነ’ ጄቱ።</para>
  <para style="q2" vid="ISA 30:16">ከናፉ ወር እስን ጉግሰን ንሰፍሱ!<verse eid="ISA 30:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 30:17"/>ዶርስሰ ነመ ቶኮቲን፣ ኩመቱ በቀተ፤</para>
  <para style="q2" vid="ISA 30:17">ዶርስሰ ነመ ሸኒቲንሞ፣</para>
  <para style="q2" vid="ISA 30:17">እስን ሀመ አኩመ ሙከ አላባ ፊጤ ቱሉረ ጅሩ፣</para>
  <para style="q1" vid="ISA 30:17">አኩመ ፋጂ ጋረረ ጅሩ ታተኒ ሀፍተንት</para>
  <para style="q2" vid="ISA 30:17">ሁንድኬሰን ንበቀቱ።”<verse eid="ISA 30:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 30:18"/>ተኡስ <char style="nd">ዋቀዮ</char> እስኒፍ አርጆሙ በርባደ፤</para>
  <para style="q2" vid="ISA 30:18">እስኒፍ ነኡፍስ ንከአ፦</para>
  <para style="q1" vid="ISA 30:18">
    <char style="nd">ዋቀዮ</char> ዋቀ ሙርቲ ቀጄላት።</para>
  <para style="q2" vid="ISA 30:18">ወር እሰ ኤገተን ሁንድ ኤብፈሞዸ።<verse eid="ISA 30:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 30:19"/>ያ ሰበ ጥዮን፣ ወር ዬሩሳሌም ኬሰ ጅራተን፣ እስን ስአች ህንቦሰን። ዬሮ እስን ገርጋርሰ በርባቻፍ ገረሳት እየተንት እን ዹጉማን እስኒፍ አርጆመ! አኩመ ዸገኤንስ ዴቢ እስኒፍ ኬነ። <verse eid="ISA 30:19"/><verse number="20" style="v" sid="ISA 30:20"/>ጎፍታን ቡዴነ ረክናቲፊ ብሻን ዽጵና ሲፍ ኬኑሌ በርሲሳንኬ ስአች ህንዾከቱ፤ አት እጁመኬቲን እሰ አርግተ። <verse eid="ISA 30:20"/><verse number="21" style="v" sid="ISA 30:21"/>አት ዬሮ ገረ ምርጋት ዮካን ገረ ብታት ጎርቱት፣ ዱግደኬ ዱባን ሰገሌ፣ “ከራን ከነ፤ እሰረ ዴም” ጄዹ ቶኮ ጉርኬ ንዸገአ። <verse eid="ISA 30:21"/><verse number="22" style="v" sid="ISA 30:22"/>አት ኤርገሲ ዋቆተኬ ቶልፈሞ ከኔን ሜቲን እረ ድበሜፊ ፈኪወንኬ ከኔን ወርቄን እት ኡፍፈሜ ሰነ ንጡሬስተ፤ አኩመ ሁጩ ጡራኡማስ ኦፍራ እሳን ደርበቴ፣ “አሲ በዳ!” ጄታን።<verse eid="ISA 30:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ISA 30:23"/>እን ሰኚ አት ለፈት ፈጫፈቱፍ ቦካ ሲፍ ኬነ፤ ምዻን ለፍት ባፍቱስ ከን ምሴፊ ከን አከ መሌ ባይአቴ ተአ። በረ ሰነ ኬሰ ሎንኬ ለፈ ዼዳ በልኣረት ቦበኡ። <verse eid="ISA 30:23"/><verse number="24" style="v" sid="ISA 30:24"/>ቆትዮፊ ሀሬን ቆቲሳ ኦካ ፍለተማ ቆርቢፊ አፈርሳዻን ቁልቁሌፈሜ ኛቱ። <verse eid="ISA 30:24"/><verse number="25" style="v" sid="ISA 30:25"/>ጉያ በዲሰ ጉዳት፣ ዬሮ ቆጢወን ኤጉምሳ ጅጅገንት ያአወን ብሻኒ ቱሉወኒፊ ጋረን ኦል ዼዼሮ ሁንደረ ያኡ። <verse eid="ISA 30:25"/><verse number="26" style="v" sid="ISA 30:26"/>ጋፈ <char style="nd">ዋቀዮ</char> ጨባ ሰበሳ ህዼ ወረ መዴሴሌ ፈይሱት ጅእ አኩመ አዱ እፈ፤ እፍን አዱስ አኩመ እፈ ጉያ ቶርባ ደቻ ቶርበ ንእፈ።<verse eid="ISA 30:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 30:27"/>ኩኖ መቃን <char style="nd">ዋቀዮ</char> ኣሪ ቦበኡፊ</para>
  <para style="q2" vid="ISA 30:27">ዱሜሰ ጎቡ ኣራቲን ፈጎዻ ዹፋ ጅረ፤</para>
  <para style="q1" vid="ISA 30:27">አፋንሳ ዼከምሳን፣</para>
  <para style="q2" vid="ISA 30:27">አረብንሳስ እብደ ጉቤ በሌሱን ጉተሜረ።<verse eid="ISA 30:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 30:28"/>ሀፉር እን ባፈቱ አኩመ ለገ ጉቴ</para>
  <para style="q2" vid="ISA 30:28">ሀመ ሞርመ ገኡት ኦል ከኡት።</para>
  <para style="q1" vid="ISA 30:28">እን ግንግልቻ በዲሳቲን ሰቦተ ግንግልቸ፤</para>
  <para style="q2" vid="ISA 30:28">እን ሉገመ ከራራ እሳን በሌሱ</para>
  <para style="q2" vid="ISA 30:28">ሀኦ ሰቦታ ኬሰ ካአ።<verse eid="ISA 30:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 30:29"/>እስን አኩመ ሀልከን አያነ ቁልቁሉ አያኔፈተንት፣</para>
  <para style="q2" vid="ISA 30:29">ፋርፈትና ንፋርፈቱ፤</para>
  <para style="q1" vid="ISA 30:29">ገራንኬሰን</para>
  <para style="q2" vid="ISA 30:29">አኩመ ዬሮ ነሞትን ኡሉሌ አፉፋ</para>
  <para style="q1" vid="ISA 30:29">ገረ ቱሉ <char style="nd">ዋቀዮት</char>፣</para>
  <para style="q2" vid="ISA 30:29">ገረ ከታ እስራኤልት ኦል በአን ሰና ንገመደ።<verse eid="ISA 30:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 30:30"/>
    <char style="nd">ዋቀዮ</char> አከ ነሞትን ሰገሌሳ ሱረ ቀቤሰ ሰነ ዸገአን ንጎዸ፤</para>
  <para style="q2" vid="ISA 30:30">እን አከ እሳን እሬሳ</para>
  <para style="q1" vid="ISA 30:30">ከን ኣሪ ጉዳፊ እብደ ጉቤ በሌሱን፣</para>
  <para style="q2" vid="ISA 30:30">ቦካ ሀማዻን፣ በከካፊ ጨቢዻን <optbreak/> ዹፋ ጅሩ አርገን ንጎዸ።<verse eid="ISA 30:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 30:31"/>ሰገሌን <char style="nd">ዋቀዮ</char> አሶርን ንጨጨብሰ፤</para>
  <para style="q2" vid="ISA 30:31">ቦኩሳቲንስ እሳን በርበዴሰ።<verse eid="ISA 30:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="ISA 30:32"/>አደቢን ኡሌ ከን <char style="nd">ዋቀዮ</char></para>
  <para style="q2" vid="ISA 30:32">እሳንረ ቡሱ ሁንድ ሰገሌ ድቤቲፊ</para>
  <para style="q1" vid="ISA 30:32">ሰገሌ ክራራ ኦፍ ኬሳ ቀበ፤</para>
  <para style="q2" vid="ISA 30:32">እንስ ሩኩታ እሬሳቲን ወራነ ኬሰት እሳን ሎለ።<verse eid="ISA 30:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="ISA 30:33"/>ቶፌት ዱር ቆጴፈሜ፤</para>
  <para style="q2" vid="ISA 30:33">እን ሞትቻፍ ቆጴፈሜ።</para>
  <para style="q1" vid="ISA 30:33">ቦል እብዳሳ ገድ ፈጌፈሜ በልእፈሜ ሆጄተሜ፤</para>
  <para style="q2" vid="ISA 30:33">እንስ እብዳፊ ቆራኒን ጉተሜረ፤</para>
  <para style="q1" vid="ISA 30:33">ሀፉር አፋን <char style="nd">ዋቀዮቲ</char> በኡስ</para>
  <para style="q2" vid="ISA 30:33">አኩመ ድኚ ዸንገለኡ አከ እን ቦበኡ ጎዸ።<verse eid="ISA 30:33"/></para>
  <chapter eid="ISA 30"/>
  <chapter number="31" style="c" sid="ISA 31"/>
  <para style="s1">ወረ ግብጥን አብደተኒፍ ወዮ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 31:1"/>ወረ ገርጋርሰ በርባቸ ገረ ግብጥት ገድ ቡአኒፍ፣</para>
  <para style="q2" vid="ISA 31:1">ወረ ፈርዴን አብደተኒፍ</para>
  <para style="q1" vid="ISA 31:1">ወረ ጋሪወንሳኒቲፊ</para>
  <para style="q2" vid="ISA 31:1">ጀብነ አቦቲ ፈርዴንሳኒ አመነተኒ</para>
  <para style="q1" vid="ISA 31:1">ገሩ ገረ ቁልቁልቸ እስራኤል ህንእላሌ</para>
  <para style="q2" vid="ISA 31:1">ዮካን ገርጋርሰ <char style="nd">ዋቀዮ</char> ህንበርባኔፍ ወዮ።<verse eid="ISA 31:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 31:2"/>ተኡስ እን ኦጌሰ፤ በላስ ፍዱ ደንደአ፤</para>
  <para style="q2" vid="ISA 31:2">እን ዋን ጄዼራ ዱበት ህንዴብኡ።</para>
  <para style="q1" vid="ISA 31:2">እን መነ ሀሞታት፣</para>
  <para style="q2" vid="ISA 31:2">ወረ ነሞተ ሀምነ ሆጄተን ገርጋረኒት ንከአ።<verse eid="ISA 31:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 31:3"/>ወር ግብጥ ነሞቱመ መሌ ዋቀ ምት፤</para>
  <para style="q2" vid="ISA 31:3">ፈርዴንሳኒስ ፎኑመ መሌ ሀፉረ ምት።</para>
  <para style="q1" vid="ISA 31:3">ዬሮ <char style="nd">ዋቀዮ</char> ሀርከሳ ድሪርፈቱት፣</para>
  <para style="q2" vid="ISA 31:3">እን ገርጋሩ ንጉፈተ፤</para>
  <para style="q2" vid="ISA 31:3">እን ገርጋረሙስ ንኩፈ፤</para>
  <para style="q2" vid="ISA 31:3">እሳን ለቹ ወሊ ወጅን በዱ።<verse eid="ISA 31:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 31:4"/>
    <char style="nd">ዋቀዮ</char> አከነ ናን ጄዸ፦</para>
  <para style="q1" vid="ISA 31:4">“አኩመ ሌንጭ፣</para>
  <para style="q2" vid="ISA 31:4">ሌንጭ ጉዳን ቶኮ ዋን ቀበቴረት ኣዱ ሰነ፣</para>
  <para style="q2" vid="ISA 31:4">ቱትን ትክሶታ ጉቱን እሰት ወል ዋመተንዩ፣</para>
  <para style="q1" vid="ISA 31:4">እን እየሳኒ ህንሶዳቱ፤</para>
  <para style="q2" vid="ISA 31:4">ዮካን ወጨሳኒቲን ህንራፈሙ፤</para>
  <para style="q1" vid="ISA 31:4">አከሱመ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ</para>
  <para style="q2" vid="ISA 31:4">ቱሉ ጥዮንረት ወራነ በኑፍ ገድ ቡአ።<verse eid="ISA 31:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 31:5"/>አኩመ ስምብሮትን መታ ነማረ ናኖፍቱ ሰነ</para>
  <para style="q2" vid="ISA 31:5">
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ <optbreak/> ዬሩሳሌሚፍ ጋቸነ ተአ፤</para>
  <para style="q1" vid="ISA 31:5">እን ጋቸነ ተኤፊ እሼ በራረ፤</para>
  <para style="q2" vid="ISA 31:5">እሼ ብረ ደርበ፤ እሼ ኦልቸስ።”<verse eid="ISA 31:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 31:6"/>ያ ሰበ እስራኤል፣ ገረ እሰ አከ መሌ እት ፍንጭልተን ሰናት ዴብኣ። <verse eid="ISA 31:6"/><verse number="7" style="v" sid="ISA 31:7"/>በረ ሰነ ቶኮን ቶኮንኬሰን ዋቆተ ቶልፈሞ ሀርክኬሰን ጩበማን ሱን ሜቲፊ ወርቄራ ሆጄቴ ቱሬ ሰነ ንገቱቲ።<verse eid="ISA 31:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 31:8"/>“አሶር ጎራዴ ከን ነማ ህንተእኒን ኩፍት፤</para>
  <para style="q2" vid="ISA 31:8">ጎራዴን ነመ ዱአ ህንኦሌስ እሳን ፍጠ።</para>
  <para style="q1" vid="ISA 31:8">እሳን ጎራዴ ዱራ በቀቱ፤</para>
  <para style="q2" vid="ISA 31:8">ደርገጎንሳኒስ ድርቀማን ሆጂ ሁምና ሆጄቱ።<verse eid="ISA 31:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 31:9"/>ደኦንሳኒ ሰበቢ ሶዳቲፍ ንጅገ፤</para>
  <para style="q2" vid="ISA 31:9">አጀጆትንሳኒስ ፋጂ ወራና አርገኒ ሆለቱ”</para>
  <para style="q1" vid="ISA 31:9">ጄዸ <char style="nd">ዋቀዮ</char>፣ እን እብድሳ ጥዮን ኬሰ፣</para>
  <para style="q2" vid="ISA 31:9">ከን ቦል እብደሳሞ ዬሩሳሌም ኬሰ ጅሩ ሱን።<verse eid="ISA 31:9"/></para>
  <chapter eid="ISA 31"/>
  <chapter number="32" style="c" sid="ISA 32"/>
  <para style="s1">ሞቱማ ቀጄሉማ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 32:1"/>ኩኖ ሞቲን ቀጄሉማዻን ሞአ፤</para>
  <para style="q2" vid="ISA 32:1">ቡልችቶትንስ ሙርቲ ቀጄላዻን ቡልቹ።<verse eid="ISA 32:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 32:2"/>ቶኮን ቶኮን ነማ አኩመ ደአትኖ ቡቤ ጀላ እት ደአተኒ፣</para>
  <para style="q2" vid="ISA 32:2">አኩመ እዶ እት ጀባ ጀላ በቀተኒት፣</para>
  <para style="q1" vid="ISA 32:2">አኩመ ብሻን ገሞጂ ኬሰ ያኡቲፊ</para>
  <para style="q2" vid="ISA 32:2">አኩመ ጋድሰ ከታ ጉዳ ከን ለፈ ጎጋ ኬሳ ንተአ።<verse eid="ISA 32:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 32:3"/>ኤርገሲስ እጅ ወረ ዋ አርጉ ህንዱኑንፈቱ፤</para>
  <para style="q2" vid="ISA 32:3">ጉር ወረ ዋ ዸገኡስ ንዸጌፈተ።<verse eid="ISA 32:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 32:4"/>ቀልቢን ነመ ጀርጀሩ ቶኮ ንቤከ፤ ንሁበተ፤</para>
  <para style="q2" vid="ISA 32:4">አረብን ጊንጌስ ቀጄልቼ ቁልቁሌሴ ዱበተ።<verse eid="ISA 32:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 32:5"/>ስአች ጎዋን ኡልፍነ ቀቤሰ ህንጄዸሙ፤</para>
  <para style="q2" vid="ISA 32:5">አደጌንስ ባይኤ ህንከበጀሙ።<verse eid="ISA 32:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 32:6"/>ጎዋን ሰበቢ ጎዉማ ዱበቱፍ</para>
  <para style="q2" vid="ISA 32:6">ቀልቢንሳ ሀምነ ሆጄተ፤</para>
  <para style="q1" vid="ISA 32:6">እን ዋን ዋቅን ህንጃለትኔ ሆጄተ፤</para>
  <para style="q2" vid="ISA 32:6">ዋኤ <char style="nd">ዋቀዮስ</char> ዶጎጎረ ኦዴሰ፤</para>
  <para style="q1" vid="ISA 32:6">እን ነመ ቤለኤ ቤለ ህንባሱ፤</para>
  <para style="q2" vid="ISA 32:6">ነመ ዼቦቴሌ ብሻን ዾወተ።<verse eid="ISA 32:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 32:7"/>መል አደጌ ሀምነ፤</para>
  <para style="q2" vid="ISA 32:7">እን ኡቱመ እየን ረከቶታ ቀጄላ ተኤ ጅሩ</para>
  <para style="q2" vid="ISA 32:7">ሶቡማን ህዬዪ በሌሱፍ ጄዼ ጀልእነ ያደ።<verse eid="ISA 32:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 32:8"/>ነምን ኡልፍነ ቀቤስ ገሩ ከሮረ ኡልፋታ ባሰ፤</para>
  <para style="q2" vid="ISA 32:8">ሆጂ ኡልፍነ ቀቤሰ ሰነትስ ንጀባተ።<verse eid="ISA 32:8"/></para>
  <para style="s1">ዱበርቶተ ዬሩሳሌም</para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 32:9"/>ያ ዱበርቶተ አከ መሌ ቦንተን</para>
  <para style="q2" vid="ISA 32:9">ከኣቲ ነ ዸጌፈዻ፤</para>
  <para style="q1" vid="ISA 32:9">ያ እንተለን ዋን ነጋ ቀብደን ኦፍ ሴተን</para>
  <para style="q2" vid="ISA 32:9">ዋን አን ጄዹ ዸገኣ!<verse eid="ISA 32:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 32:10"/>እስን ወር ዋን ነጋ ቀብደን ኦፍ ሴተን</para>
  <para style="q2" vid="ISA 32:10">ኤርገ ወጋን ቶኮ ጥኑመ ደርቤ ቦዴ ንሆለቱ፤</para>
  <para style="q1" vid="ISA 32:10">ወይኒን እጀ ህንኬኑ፤</para>
  <para style="q2" vid="ISA 32:10">ዬሮን እት እጅ ወልት ቀበሙስ ህንዹፉ።<verse eid="ISA 32:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 32:11"/>ያ ዱበርቶተ ቦንቱወን እስን ሆለዻ፤</para>
  <para style="q2" vid="ISA 32:11">እንተለን ዋን ነጋ ቀብደን ኦፍ ሴተንስ ራፈማ!</para>
  <para style="q1" vid="ISA 32:11">ኡፈተኬሰን ኦፍራ ባሳቲ</para>
  <para style="q2" vid="ISA 32:11">ወያ ገዳ ሙዺኬሰንት ህዸዻ።<verse eid="ISA 32:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 32:12"/>ለፈ ቆቲሳ ጋሪፍ፣</para>
  <para style="q2" vid="ISA 32:12">ሙከ ወይኒ እጀ ነቀቱፍስ ለጴኬሰን ዸኣ፤<verse eid="ISA 32:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 32:13"/>ለፈ ኡመተኮ ከን ቆራቲፊ</para>
  <para style="q2" vid="ISA 32:13">ሶኮሩን እረት ጉደቱፍ ለጴኬሰን ዸኣ፤</para>
  <para style="q1" vid="ISA 32:13">ዹጉማን መኔን ገመቹ ሁንዳፊ</para>
  <para style="q2" vid="ISA 32:13">መጋላ ፈንደለልቱ ከናፍ ቦኣ።<verse eid="ISA 32:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 32:14"/>ደአኖን ንኦነ፤</para>
  <para style="q2" vid="ISA 32:14">መጋላን ነምን ኬሰ ጉቴስ ዱዋ ሀፍት፤</para>
  <para style="q1" vid="ISA 32:14">መጋላን ጀብዱኒፊ ቆጢን ኤጉምሳ በረ በራን ንኦኑ፤</para>
  <para style="q2" vid="ISA 32:14">እዶ ሀሬን ዲዳ ኬሰ ቡራቅጡፊ እዶ ቡሻዬን እት ቦበአን ተኡ፤<verse eid="ISA 32:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 32:15"/>ኩንስ ሀመ ሀፉር ቁልቁሉን <optbreak/> ጉባዻ ኑረት ዸንገላፈሙፊ</para>
  <para style="q2" vid="ISA 32:15">ሀመ ገሞጂን ለፈ ቆቲሳ ገበታ ተኤ</para>
  <para style="q2" vid="ISA 32:15">ለፍት ቆቲሳ ገበታንሞ ቦሶነ ፈካቱት ተአ።<verse eid="ISA 32:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 32:16"/>ሙርቲ ቀጄላን ገሞጂ ኬሰ ጅራተ፤</para>
  <para style="q2" vid="ISA 32:16">ቀጄሉማንሞ ለፈ ቆቲሳ ገበታ ኬሰ ጅራተ።<verse eid="ISA 32:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 32:17"/>ቡኣን ቀጄሉማ ነጋዸ፤</para>
  <para style="q2" vid="ISA 32:17">ፋይዳን ቀጄሉማሞ ኡቱ ህንብርአትን</para>
  <para style="q2" vid="ISA 32:17">ተስገቢን በረ በራን ጅራቹዸ።<verse eid="ISA 32:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 32:18"/>ሰብንኮ እዶ ጅሬኛ ነጋ ቀቡ፣</para>
  <para style="q2" vid="ISA 32:18">መኔን ቡልቲ ሶዳ ህንቀብኔ</para>
  <para style="q2" vid="ISA 32:18">እዶ ቦቆና ጄቁምስ ህንጅሬ ኬሰ ጅራተ።<verse eid="ISA 32:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 32:19"/>ዮሙ ጨቢን ቦሶነረት ቡኡ፣</para>
  <para style="q2" vid="ISA 32:19">መጋለቲን ጉቱማን ጉቱት ገድ ዴብት፤<verse eid="ISA 32:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 32:20"/>እስን ወር ቀርቀረ ለገ ሁንዳት ሰኚ ፈጫፈተኒ</para>
  <para style="q2" vid="ISA 32:20">ሎንኬሰኒፊ ሀሮተኬሰን</para>
  <para style="q2" vid="ISA 32:20">ነጋን ቦባፈተን አከም ኤብፈሞዸ።<verse eid="ISA 32:20"/></para>
  <chapter eid="ISA 32"/>
  <chapter number="33" style="c" sid="ISA 33"/>
  <para style="s1">ዽጵናፊ ገርጋርሰ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 33:1"/>ያ በርበዴሳ፣</para>
  <para style="q2" vid="ISA 33:1">አት ከን ህንበርበዴፈምን ሲፍ ወዮ!</para>
  <para style="q1" vid="ISA 33:1">ያ ገንቱ፣ አት ከን ህንገነምን ሲፍ ወዮ!</para>
  <para style="q2" vid="ISA 33:1">አት ዮሙ በርበዴሱ ዺፍቱት ንበርበዴፈምተ፤</para>
  <para style="q2" vid="ISA 33:1">ዮሙ ገኑ ዺፍቱትስ ንገነምተ።<verse eid="ISA 33:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 33:2"/>ያ <char style="nd">ዋቀዮ</char>፣ ኑ ማር፤ ኑ ስ ኤገትና።</para>
  <para style="q2" vid="ISA 33:2">አት ገነመ ገነመ ጀብነኬኘ፣</para>
  <para style="q2" vid="ISA 33:2">ዬሮ ዽጵናትሞ ፈይነኬኘ ኑፍ ተእ።<verse eid="ISA 33:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 33:3"/>ሰገሌ ከከዌኬቲቲን፣ ነሞትን በቀቱ፤</para>
  <para style="q2" vid="ISA 33:3">ዬሮ አት ኦል ካቱት፣ ሰቦትን ንብትናኡ።<verse eid="ISA 33:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 33:4"/>ያ ሰቦተ፣ አኩመ ሀዋንስን ወልት ቀበሙ ሰነ</para>
  <para style="q2" vid="ISA 33:4">ቦጁንኬሰን ወልት ቀበመ፤</para>
  <para style="q2" vid="ISA 33:4">ነሞትንስ አኩመ ቱተ ሀዋንሳረ ኡኡታሉ።<verse eid="ISA 33:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 33:5"/>
    <char style="nd">ዋቀዮ</char> ኦል ኦል ጄዸ፤ እን ኦል ጉባ ጅራታቲ፤</para>
  <para style="q2" vid="ISA 33:5">እን ሙርቲ ቀጄላፊ ቀጄሉማዻን ጥዮንን ጉተ።<verse eid="ISA 33:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 33:6"/>እን በረኬቲፍ ሁንዴ አመንሲሳ፣ ኩሳ ፈይና፣</para>
  <para style="q2" vid="ISA 33:6">ከን ኦጉማቲፊ ከን ቤኩምሳ ተአ፤</para>
  <para style="q2" vid="ISA 33:6">
    <char style="nd">ዋቀዮን</char> ሶዳቹን ፉርቱ በዻዹማ ከናት።<verse eid="ISA 33:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 33:7"/>ኩኖ ጎቶትንሳኒ ሰገሌ ኦል ፉዸተኒ ዳንዲረት እዩ፤</para>
  <para style="q2" vid="ISA 33:7">ኤርገሞትን ነጋስ ህቅፈተኒ ቦኡ።<verse eid="ISA 33:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 33:8"/>ከራወን ጉርጉዳን ኦነኒሩ፤</para>
  <para style="q2" vid="ISA 33:8">ነምን ከራረ ዴሙ ህንጅሩ።</para>
  <para style="q1" vid="ISA 33:8">ወሊ ገልቴን ዲገሜረ፤</para>
  <para style="q2" vid="ISA 33:8">ዹገ ባቶትንሼ ቱፈተመኒሩ፤</para>
  <para style="q2" vid="ISA 33:8">ነምን ቶኮዩ ህንከበጀሙ።<verse eid="ISA 33:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 33:9"/>ለፍት ንቦስ፤ ንበርበዶፍት፤</para>
  <para style="q2" vid="ISA 33:9">ልባኖን ንቃኖፍት፤ ንጮለግድ፤</para>
  <para style="q1" vid="ISA 33:9">ሻሮን አከ ገሞጂ ታት፤</para>
  <para style="q2" vid="ISA 33:9">ባሻኒፊ ቀርሜሎስ ባለሳኒ ሀርጫፈቱ።<verse eid="ISA 33:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 33:10"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፤ “አን አመ ነንከአ፤</para>
  <para style="q2" vid="ISA 33:10">አን አመ ኦል ኦል ነንጄዸ፤</para>
  <para style="q2" vid="ISA 33:10">አን አመ ነንከበጀመ።<verse eid="ISA 33:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 33:11"/>እስን ሀበቂ ኡልፎፍቱ፤ ጭዲ ዴሱ፤</para>
  <para style="q2" vid="ISA 33:11">ሀፉር እስን ባፈተን እብደ ጉቤ እስን ፍጡዸ።<verse eid="ISA 33:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 33:12"/>ነሞትን አኩመ ኖራ ጉበሙ፤</para>
  <para style="q2" vid="ISA 33:12">አኩመ ቆራቲ ጭረሜትስ እብድ እት ቀብሲፈመ።”<verse eid="ISA 33:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 33:13"/>እስን ወር ፈጎ ጅርተን ዋን አን ሆጄዼ ዸገኣ፤</para>
  <para style="q2" vid="ISA 33:13">ወር ዽኦ ጅርተንስ ሁምነኮ ቤካ!<verse eid="ISA 33:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 33:14"/>ጩበሞትን ጥዮን ኬሳ ንሶዳቱ፤</para>
  <para style="q2" vid="ISA 33:14">ወር ዋቀት ህንቡሌስ ሆለቻ፣</para>
  <para style="q2" vid="ISA 33:14">“ኑ ኬሳ ኤኙቱ እብደ ዋ በሌሱ ወጅን ጅራቹ ደንደአ?</para>
  <para style="q1" vid="ISA 33:14">ኑ ኬሳ ኤኙቱ</para>
  <para style="q2" vid="ISA 33:14">እብደ በረ በራን ህንዻምኔ ወጅን ጅራቹ ደንደአ?” ጄዹ።<verse eid="ISA 33:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 33:15"/>ነምን ቀጄሉማን ጅራቴ ዹጋ ዱበቱ፣</para>
  <para style="q2" vid="ISA 33:15">ከን ፋይዳ ከራ ደባቲን አርገሙ ለገቴ</para>
  <para style="q2" vid="ISA 33:15">ሀርከሳ መተኣ ፉዸቹራ ኤገቱ፣</para>
  <para style="q1" vid="ISA 33:15">ነምን መሪ ነመ አጄሱራ ጉረሳ ጩቃለቴ</para>
  <para style="q2" vid="ISA 33:15">ጀልእነ እላሉራ እጀሳ ዱኑንፈቱ፣<verse eid="ISA 33:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 33:16"/>እዶ ኦል ከኣረ ጅራተ፤</para>
  <para style="q2" vid="ISA 33:16">ደአኖንሳስ ከታ ጀባ ተአ።</para>
  <para style="q1" vid="ISA 33:16">ቡዴን እሳፍ ንኬነመ፤</para>
  <para style="q2" vid="ISA 33:16">ብሻንስ እሰት ህንህርአቱ።<verse eid="ISA 33:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 33:17"/>እጅኬ ሞትቸ ሚዸጉማሳቲን አርገ፤</para>
  <para style="q2" vid="ISA 33:17">ብየ ፈጎ ጅርቱሌ ንእላለ።<verse eid="ISA 33:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 33:18"/>አትስ አከነ ጄቴ ገራኬት ራፈመ ዱሪ ሰነ ያደ፦</para>
  <para style="q2" vid="ISA 33:18">“አጀጃን ኦል ኣናን ሱን ኤሰ ጅረ?</para>
  <para style="q1" vid="ISA 33:18">ነምች ግብረ ፉዹ ሱን ኤሰ ጅረ?</para>
  <para style="q2" vid="ISA 33:18">አጀጃን እት ጋፈተማን ገሞወኒ ኤሰ ጅረ?”<verse eid="ISA 33:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 33:19"/>አት ስአች ሰበ ሀማ፣</para>
  <para style="q2" vid="ISA 33:19">ከን ሃሳንሳ ነማፍ ህንገሌ፣</para>
  <para style="q2" vid="ISA 33:19">ከን አፋንሳ ሃራ ተኤፊ ህንሁበተምኔ ህንአርግቱ።<verse eid="ISA 33:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 33:20"/>ጥዮን፣ መጋላ አያነኬኛ ሁበዹ እላል፤</para>
  <para style="q2" vid="ISA 33:20">እጅኬ ዬሩሳሌምን፣ እዶ ጅሬኛ ነጋ ቀቡ፣</para>
  <para style="q2" vid="ISA 33:20">ዱንካነ ህንቡቅፈምኔ አርገ፤</para>
  <para style="q1" vid="ISA 33:20">ቆፎንሼ ህንቡቅፈሙ፤</para>
  <para style="q2" vid="ISA 33:20">ዮካን ፉኞንሼ ቶኮዩ ህንጭቱ።<verse eid="ISA 33:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 33:21"/>
    <char style="nd">ዋቀዮ</char> አችት ሁምነኬኘ ተአ።</para>
  <para style="q2" vid="ISA 33:21">እዶን ሱንስ አኩመ ለጌን ጉርጉዳቲፊ ቡርቃወኒ ተአ።</para>
  <para style="q1" vid="ISA 33:21">ዶኒን ወራና ከን በቶዻን ኦፈሙ ቶኮዩ</para>
  <para style="q2" vid="ISA 33:21">እሳንረ ህንዴሙ፤</para>
  <para style="q2" vid="ISA 33:21">ዶኒን ጀባን ቶኮዩ እሳንረ ህንቀጣሙሩ።<verse eid="ISA 33:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 33:22"/>
    <char style="nd">ዋቀዮ</char> አባ ሙርቲኬኛቲ፤</para>
  <para style="q2" vid="ISA 33:22">
    <char style="nd">ዋቀዮ</char> ሴረ ኑፍ ኬነ፤</para>
  <para style="q1" vid="ISA 33:22">
    <char style="nd">ዋቀዮ</char> ሞቲኬኘ፤</para>
  <para style="q2" vid="ISA 33:22">እን ኑ ፈይሰ።<verse eid="ISA 33:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 33:23"/>ፉኞንኬ ላፌረ፤</para>
  <para style="q2" vid="ISA 33:23">ኡቱባንሳ ጀባቴ ህንዻበምኔ፤</para>
  <para style="q2" vid="ISA 33:23">ሸራንስ ህንድሪርፈምኔ።</para>
  <para style="q1" vid="ISA 33:23">ኤርገሲ ቦጁን ባይኤን ንቆደመ፤</para>
  <para style="q2" vid="ISA 33:23">ኦኮላንዩ ቦጁ ንፉዸተ።<verse eid="ISA 33:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 33:24"/>ነምን ጥዮን ኬሰ ጅራቱ ከምዩ፣ “ነ ዹኩበ” ህንጄዹ፤</para>
  <para style="q2" vid="ISA 33:24">ጩቡን ወረ አች ጅራተንስ ንዺፈማፍ።<verse eid="ISA 33:24"/></para>
  <chapter eid="ISA 33"/>
  <chapter number="34" style="c" sid="ISA 34"/>
  <para style="s1">ሙርቲ ሰቦተ ኤገቱ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 34:1"/>ያ ሰቦተ፣ እስን አስ ዽኣዻቲ ዸጌፈዻ፤</para>
  <para style="q2" vid="ISA 34:1">ያ ነሞተ፣ እስንስ ቀልቤፈዻ!</para>
  <para style="q1" vid="ISA 34:1">ለፍት ሃዸጌሱ፤ ከን እሼ ኬሰ ጅራቱ ሁንድስ፣</para>
  <para style="q2" vid="ISA 34:1">አዱኛፊ ወን እሼ ኬሳ በኡ ሁንድኑ ሃዸገአን!<verse eid="ISA 34:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 34:2"/>
    <char style="nd">ዋቀዮ</char> ሰቦተ ሁንደት ኣሬረ፤</para>
  <para style="q2" vid="ISA 34:2">ዼከምስሳ ሎልቶተሳኒ ሁንደረ ቡኤረ።</para>
  <para style="q1" vid="ISA 34:2">እን ጉቱማን ጉቱት እሳን በርበዴሰ፤</para>
  <para style="q2" vid="ISA 34:2">እን አከ ቀለመኒፍ ደበርሴ እሳን ኬነ።<verse eid="ISA 34:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 34:3"/>እሳን ኬሳ ወር ዱአን አለት ገድ ደርበተመን፤</para>
  <para style="q2" vid="ISA 34:3">ሬፍሳኒ ንአጃአ፤</para>
  <para style="q2" vid="ISA 34:3">ቱሉወን ዺገሳኒቲን ቶርቶሩ።<verse eid="ISA 34:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 34:4"/>ራያወን ሰሚ ሁንድኑ ንበቁ፤</para>
  <para style="q2" vid="ISA 34:4">ሰሚንስ አኩመ ክታበ መረማ ንመርመረመ፤</para>
  <para style="q1" vid="ISA 34:4">ራያን ኡርጂወኒ ሁንድኑ አኩመ ባለ ወይኒ ጮለጌ፣</para>
  <para style="q2" vid="ISA 34:4">አኩመ ሀርቡ ሙከ ሀርቡራ ሀርጨኡት ሀርጨኡ።<verse eid="ISA 34:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 34:5"/>ጎራዴንኮ ሰሚ ኬሰት ሀመ ቁፉት ዹጌረ፤</para>
  <para style="q2" vid="ISA 34:5">ኩኖ እን ኤዶምት ሙሩፍ፣</para>
  <para style="q2" vid="ISA 34:5">ገረ ሰበ አን ጉቱማን ጉቱት በርበዴሴት ገድ ቡኤረ።<verse eid="ISA 34:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 34:6"/>ጎራዴን <char style="nd">ዋቀዮ</char> ዺገ ኬሰ ጩጰሜረ፤</para>
  <para style="q2" vid="ISA 34:6">እን ጮማን፣ ዺገ ጦባላወን ሆላቲፊ ሬኦታቲን፣</para>
  <para style="q2" vid="ISA 34:6">ሞረ ከሌ ኮርቤዪ ሆላቲን ሀጉገሜረ።</para>
  <para style="q1" vid="ISA 34:6">
    <char style="nd">ዋቀዮ</char> ቦዝራ ኬሰት ኣርሳ፣</para>
  <para style="q2" vid="ISA 34:6">ኤዶም ኬሰትሞ ቀልመ ጉዳ ቆጴሴራቲ።<verse eid="ISA 34:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 34:7"/>ገፈርስ እሳን ወጅን፣</para>
  <para style="q2" vid="ISA 34:7">ጅቦንስ ኮሮሚ ጉርጉዳ ወጅን ዹሙ።</para>
  <para style="q1" vid="ISA 34:7">ለፍትሳኒ ዺጋን ጂት፤</para>
  <para style="q2" vid="ISA 34:7">ብዮንሳኒስ ሞረ ቁፈ።<verse eid="ISA 34:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 34:8"/>
    <char style="nd">ዋቀዮ</char> ጉያ እት ሃሎ በኡ፣</para>
  <para style="q2" vid="ISA 34:8">ወጋ እት ዋኤ ጥዮን ፈልሙ ቀባቲ።<verse eid="ISA 34:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 34:9"/>ቡርቃወን ኤዶም ሌሌት፣</para>
  <para style="q2" vid="ISA 34:9">ብዮንሼስ ድኚ ቦበኡት ጌደረመ፤</para>
  <para style="q2" vid="ISA 34:9">ለፍትሼሞ ሌሌ ቦበኡ ተአ!<verse eid="ISA 34:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 34:10"/>እን ሀልከን ዮካን ጉያ ህንዻሙ፤</para>
  <para style="q2" vid="ISA 34:10">ኣርሳስ በረ በራን ኦል በአ።</para>
  <para style="q1" vid="ISA 34:10">ለፍት ሱን ዸሎታ ሀመ ዸሎታት ኦንቴ ሀፍት፤</para>
  <para style="q2" vid="ISA 34:10">ነምን ቶኮዩ ዴብኤ እሼ ኬሳን ህንደርቡ።<verse eid="ISA 34:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 34:11"/>ጩሉሌን ገሞጂቲፊ ዸዴን ለፈ ሰነ ንፉዸቱ፤</para>
  <para style="q2" vid="ISA 34:11">ኡሩንጉፊ አራጌስ መነሳኒ አችት እጃረቱ።</para>
  <para style="q1" vid="ISA 34:11">ዋቅን ኤዶምራ፣ ፉኞ ጄቁምሳቲፊ</para>
  <para style="q2" vid="ISA 34:11">መዳሊ በዲሳ ንድሪርሰ።<verse eid="ISA 34:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 34:12"/>ጉርጉዶትንሼ ዋን ሞቱማ ጄዸሜ ዋመሙ <optbreak/> አቺ ህንቀባተን፤</para>
  <para style="q2" vid="ISA 34:12">እልማን ሞቶተሼ ሁንድ ንበዱ።<verse eid="ISA 34:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 34:13"/>መሰራሼ ቆራቲ፣</para>
  <para style="q2" vid="ISA 34:13">ደአትኖሼ ዶቢፊ ሶኮሩቱ ዻለ።</para>
  <para style="q1" vid="ISA 34:13">እሼን ቦለ ዋንጎ፣</para>
  <para style="q2" vid="ISA 34:13">እዶ ኡሩንጉን ጅራቱ ንታት።<verse eid="ISA 34:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 34:14"/>ኡመመወን ገሞጂ ወራቤሰ ወጅን ወል ገኡ፤</para>
  <para style="q2" vid="ISA 34:14">ሀፉሮትን ሀሞ ሬኤ ዲዳ ፈካተን ወል ዋሙ፤</para>
  <para style="q1" vid="ISA 34:14">ኡመመወን ሀልከኒ አች ቦቆተን፤</para>
  <para style="q2" vid="ISA 34:14">ኦፊሳኒቲፍስ እዶ ኣረ ገልፈትና አርገቱ።<verse eid="ISA 34:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 34:15"/>ኡሩንጉን አችት መንኤ እጃረቴ ሀንቃቁ ሀንቃቅጥ፤</para>
  <para style="q2" vid="ISA 34:15">ጩጪ ያፍቴስ ቆቾ ጀለት ኩኑንፈት፤</para>
  <para style="q2" vid="ISA 34:15">አላቲንስ ዽርሳፊ ኒቲ ታቴ አችት ወልት ቀበምት።<verse eid="ISA 34:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 34:16"/>ክታበ <char style="nd">ዋቀዮ</char> ኬሳ እላላቲ ከን አከነ ጄዹ ዱብፈዻ፦</para>
  <para style="q1" vid="ISA 34:16">እሳን ከኔን ኬሳ ቶኮዩ ህንዸበሙ፤</para>
  <para style="q2" vid="ISA 34:16">ቶክቲንዩ ዽርሰሼ ህንዸብዱ።</para>
  <para style="q1" vid="ISA 34:16">አፋን ዋቃ አጀጄራቲ፤</para>
  <para style="q2" vid="ISA 34:16">ሀፉርሳስ ወልት እሳን ቀበ።<verse eid="ISA 34:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 34:17"/>እሰቱ ቆደሳኒ ህራፍ፤</para>
  <para style="q2" vid="ISA 34:17">ሀርክሳ ሰፈርቱዻን እሳኒፍ ቆደ።</para>
  <para style="q1" vid="ISA 34:17">እሳን በረ በራን ቆደ ከነ ንቀባቱ፤</para>
  <para style="q2" vid="ISA 34:17">ዸሎታ ሀመ ዸሎታትስ አች ጅራቱ።<verse eid="ISA 34:17"/></para>
  <chapter eid="ISA 34"/>
  <chapter number="35" style="c" sid="ISA 35"/>
  <para style="s1">ገመቹ ወረ ፉረመኒ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 35:1"/>ገሞጂፊ ለፍት ጎጋን ንገመዱ፤</para>
  <para style="q2" vid="ISA 35:1">ለፍት ኦናን ንእልልቸ፤ ንደራረስ።</para>
  <para style="q1" vid="ISA 35:1">አከ አርፋሴ፣ <verse eid="ISA 35:1"/><verse number="2" style="v" sid="ISA 35:2"/>ባይእናን ደራረ፤</para>
  <para style="q2" vid="ISA 35:2">አከ መሌ ገመዴስ እልልቸ።</para>
  <para style="q1" vid="ISA 35:2">ኡልፍን ልባኖን፣ ሱራን ቀርሜሎሲፊ</para>
  <para style="q2" vid="ISA 35:2">ሻሮን ንኬነማፍ፤</para>
  <para style="q1" vid="ISA 35:2">እሳን ኡልፍነ <char style="nd">ዋቀዮ</char>፣</para>
  <para style="q2" vid="ISA 35:2">ሱራ ዋቀኬኛስ ንአርጉ።<verse eid="ISA 35:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 35:3"/>ሀርከ ደዸቤ ጀጀቤሳ፤</para>
  <para style="q2" vid="ISA 35:3">ጅልበ ላፌስ ጭምሳ፤<verse eid="ISA 35:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 35:4"/>ወረ ገራንሳኒ ሶዳቱን አከነ ጄዻ፦</para>
  <para style="q2" vid="ISA 35:4">“ጀባዻ፤ ህንሶዳትና፤</para>
  <para style="q1" vid="ISA 35:4">ዋቅንኬሰን ንዹፈ፤</para>
  <para style="q2" vid="ISA 35:4">እን ሃሎ ባሱፍ ዹፈ፤</para>
  <para style="q1" vid="ISA 35:4">ገቲ መሉ ቀበቴ</para>
  <para style="q2" vid="ISA 35:4">እስን ኦልቹፍ ንዹፈ።”<verse eid="ISA 35:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 35:5"/>ኤርገሲ እጅ ነመ ጃማ ንበነመ፤</para>
  <para style="q2" vid="ISA 35:5">ጉር ነመ ዱዳስ ንዸገአ።<verse eid="ISA 35:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 35:6"/>ጋፈስ ነምን ናፍት አኩመ ገደምሳ ኡታለ፤</para>
  <para style="q2" vid="ISA 35:6">አረብን ህዸማንስ ገመቹዻን ፋርፈተ።</para>
  <para style="q1" vid="ISA 35:6">ብሻን ገሞጂ ኬሳ፣</para>
  <para style="q2" vid="ISA 35:6">ቡርቃንስ ገሞጂ ኬሳ ጨብሴ በአ።<verse eid="ISA 35:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 35:7"/>ለፍት ነመ ጉቡ ሀሮ፣</para>
  <para style="q2" vid="ISA 35:7">ለፍት ጎጋንሞ ቡርቃ ብሻኒ ተአ።</para>
  <para style="q1" vid="ISA 35:7">ቦለ ዱራን ዋንጎትን ኬሰ ጪሰንረት መርገ፣</para>
  <para style="q2" vid="ISA 35:7">ሸምበቆፊ ዸላዱቱ ብቅለ።<verse eid="ISA 35:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 35:8"/>ከራን ጉዳን ቶኮ አች ንጅራተ፤</para>
  <para style="q2" vid="ISA 35:8">እንስ፣ ከራ ቁልቁልና ጄዸሜ ዋመመ፤</para>
  <para style="q1" vid="ISA 35:8">እን ወረ ከራ ሰነረ ዴመኒፍ ተአ።</para>
  <para style="q2" vid="ISA 35:8">“ጡራኦን” እሰረ ህንዴመን፤</para>
  <para style="q2" vid="ISA 35:8">ጎዎትን አቺኑ ህንበአን።<verse eid="ISA 35:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 35:9"/>ሌንጭ አችት ህንአርገሙ፤</para>
  <para style="q2" vid="ISA 35:9">ዮካን ብኔንስ ሀማን አችረ ህንበኡ፤</para>
  <para style="q2" vid="ISA 35:9">እሳን አችት ህንአርገመን።</para>
  <para style="q1" vid="ISA 35:9">ገሩ ወረ ፉረመን ቆፈቱ አችረ ዴመ፤<verse eid="ISA 35:9"/></para>
  <para style="q2">
    <verse number="10" style="v" sid="ISA 35:10"/>ወር <char style="nd">ዋቀዮ</char> እሳን ፉሬ ንዴብኡ።</para>
  <para style="q1" vid="ISA 35:10">እሳን ፋርፈናዻን ጥዮን ሴኑ፤</para>
  <para style="q2" vid="ISA 35:10">ገመቹን በረ በራ መታሳኒረ ጅራተ።</para>
  <para style="q1" vid="ISA 35:10">እሳን ገመቹፊ እልሌዻን ጉተሙ፤</para>
  <para style="q2" vid="ISA 35:10">ገዲፊ ቦእች እሳንራ ፈጋቱ።<verse eid="ISA 35:10"/></para>
  <chapter eid="ISA 35"/>
  <chapter number="36" style="c" sid="ISA 36"/>
  <para style="s1">ሴናሄሪብ ዬሩሳሌምን ዶርስሴ</para>
  <para style="r">
    <ref loc="ISA 36:1-22">36፥1‑22</ref> ኩወፈ – <char style="xt"><ref loc="2KI 18:13">2ሞቶ 18፥13</ref>፣<ref loc="2KI 18:17-37">17‑37</ref>፤ <ref loc="2CH 32:9-19">2ሴና 32፥9‑19</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 36:1"/>በረ ሞቱማ ህስቅያስ ሞትቻ ኬሰ ወጋ ኩዸ አፉረፋት ሴናሄሪብ ሞትች አሶር መጋላወን ይሁዳ ከኔን ደላ ጀባ ቀበን ሁንደ ሎሌ ንቀበቴ። <verse eid="ISA 36:1"/><verse number="2" style="v" sid="ISA 36:2"/>ኤርገሲ ሞትች አሶር፣ ራፋስቂስ አጀጃ ወራነሳ ሎልቶተ ሄዱ ወጅን ላኪሺ ገረ ዬሩሳሌም፣ ህስቅያስ ሞትቸት ኤርጌ። አጀጃን ሱንስ ጀልእሲ ሀሮ ኦል ኣኑ ከን ከረ ለፈ ቆቲሳ ነምቸ ወያ ሚጩት ጌሱ ብረ ገኤ ዻበቴ፤ <verse eid="ISA 36:2"/><verse number="3" style="v" sid="ISA 36:3"/>ኤሊያቂም እልም ህልቅያ ቡልቻን መሰራ ሞቱማ፣ ሼብና በሬሳኒፊ ዮኣ እልም አሳፍ ገልሜሳን ገረሳት ገድ በአን።<verse eid="ISA 36:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 36:4"/>አጀጃን ወራና ሱንስ አከነ እሳኒን ጄዼ፤ “አከነ ጄዻ ህስቅያስት ህማ፦</para>
  <para style="pm" vid="ISA 36:4">“ ‘ሞቲን ጉዳን፣ ሞትች አሶር አከነ ጄዸ፦ ኦፍ አመነቹኬ ከነ ማልረት ሁንዴፈቴ? <verse eid="ISA 36:4"/><verse number="5" style="v" sid="ISA 36:5"/>አት፣ “አን ቶፍታፊ ጀብነ ወራና ቀበ” ጄተ፤ ገሩ ዱቢ ፋይዳ ህንቀብኔ ዱበተ። አት ኤኙን አብደቴ ነት ፍንጭልተ? <verse eid="ISA 36:5"/><verse number="6" style="v" sid="ISA 36:6"/>ኩኖ አት ግብጥን ጄቹንስ ኡሌ ሸምበቆ ጨጨባ ሀርከ ነመ እሰት እርከቱ ከሚዩ ወራኔ መዴሱ ሰነ አብደቴርተ! ፈረኦን ሞትች ግብጥስ ነመ እሰ አብደቱ ሁንዳፍ አከሱመ። <verse eid="ISA 36:6"/><verse number="7" style="v" sid="ISA 36:7"/>ዮ አት፣ “ኑ <char style="nd">ዋቀዮ</char> ዋቀኬኘ አብደትነ” ናን ጄቴ፣ እን እሱመ ህስቅያስ እዶወን ሰገዳሳቲፊ እዶወን ኣርሳሳ ዲጌ ይሁዳፊ ዬሩሳሌሚን፣ “እስን ፉለ እዶ ኣርሳ ከና ዱረት ዋቄፈቹ ቀብዱ” ጄዼ ሰነ ምቲ?<verse eid="ISA 36:7"/></para>
  <para style="pm">
    <verse number="8" style="v" sid="ISA 36:8"/>“ ‘አመ ኮቱቲ ጎፍታኮ ሞትቸ አሶር ወጅን ዱበዹ፤ አንስ ዮ አት ነሞተ ፈርደ ያበተን ቆጴፈቹ ደንዴሴ ፈርዴን ኩመ ለመ ሲፍን ኬነ! <verse eid="ISA 36:8"/><verse number="9" style="v" sid="ISA 36:9"/>ዮስ አት ዮ ጋሪወኒፊ አቦቲ ፈርዳቲፍ ጄቴ ግብጥን አብደቴዩ፣ አከሚን ቆንዳልቶተ ጎፍታኮቲ ኬሳ አጀጃ ገድ ኣናሳሌ ኦፍራ ዴብሱ ደንዴሰ? <verse eid="ISA 36:9"/><verse number="10" style="v" sid="ISA 36:10"/>አት ዋን አን ዱቢ <char style="nd">ዋቀዮ</char> መሌ ብየ ከነ ሎሌ በርበዴሱፍ ዹፌ ሴታ? <char style="nd">ዋቀዮ</char> መታንሳ አከ አን ብየ ከነት ዱሌ እሼ በርበዴሱ ነት ዱበቴረ።’ ”<verse eid="ISA 36:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 36:11"/>ከነረት ኤሊያቂም፣ ሼብናፊ ዮኣ አጀጃ ወራና ሰናን፣ “ማሎ ዋን ኑ ዸጌኙፍ አፋን ወረ አራማይኪቲን ገርቦተኬት ዱበዹ። ኡቱመ ነሞትን ደላረ ጅረን ዸገአኒ አፋን እብሮታቲን ኑት ህንዱበትን” ጄዸን።<verse eid="ISA 36:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 36:12"/>አጀጃን ወራና ሱን ገሩ አከነ ጄዼ ዴብሴ፤ “ነምን ጎፍታንኮ አከ አን ዋን ከነ እት ህሙፍ እት ነ ኤርጌ ጎፍታኬሰኒፊ እስን ቆፋ? ነሞተ ደላረ ተታአን ወረ አኩመኬሰን ኡዳን ኦፊሳኒ ኛተኒ ፍንጫን ኦፊሳኒ ዹጉ ቀበኒፍስ ምቲ?”<verse eid="ISA 36:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 36:13"/>ኤርገሲ አጀጃን ወራና ሱን ኦል ከኤ አፋን እብሮታቲን አከነ ጄዼ፤ “ዱቢ ሞትቸ ጉዳ፣ ዱቢ ሞቲ አሶር ዸገኣ! <verse eid="ISA 36:13"/><verse number="14" style="v" sid="ISA 36:14"/>ሞትች አከነ ጄዸ፦ ህስቅያስ እስን ህንጎዎምስን። እን እስን ባሱ ህንደንደኡ! <verse eid="ISA 36:14"/><verse number="15" style="v" sid="ISA 36:15"/>ህስቅያስ፣ ‘<char style="nd">ዋቀዮ</char> ዹጉማን ኑ ባሰ፤ መጋላን ኩንስ ደበርፈምቴ ሀርከ ሞትቸ አሶርት ህንኬነምቱ’ ጄቹዻን አከ እስን <char style="nd">ዋቀዮን</char> አመነተኒፍ እስን ህንሶሶብን።<verse eid="ISA 36:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 36:16"/>“ህስቅያስን ህንዸጌፈትና። ሞቲን አሶር አከነ ጄዸ፦ አነ ወጅን ነጋ ቡሳቲ ገረኮ ኮታ። ኤርገሲ ቶኮን ቶኮንኬሰን ሙከ ወይኒቲፊ ሙከ ሀርቡኬሰንራ ንኛቱ፤ ቦለ ብሻንኬሰኒ ኬሳስ ንዹግዱ፤ <verse eid="ISA 36:16"/><verse number="17" style="v" sid="ISA 36:17"/>ኩንስ ሀመ አን ዹፌ ገረ ብየ አኩመ ብየኬሰኒ ጅርቱ፣ ገረ ብየ ምዻኒፊ ዳዺ ወይኒ ሃራት፣ ብየ ቡዴናፊ እዶ ዻባ ወይኒት እስን ጌሱት ተአ።<verse eid="ISA 36:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 36:18"/>“ህስቅያስ፣ ‘<char style="nd">ዋቀዮ</char> ኑ በራረ’ ጄዼ እስን ህንዶጎጎርስን፤ ዋቅን ሰቦተ ከሚዩ ተኩማ ሀርከ ሞትቸ አሶር ኬሳ ብየ ኦፊ ባፈቴ ቤካ? <verse eid="ISA 36:18"/><verse number="19" style="v" sid="ISA 36:19"/>ዋቆትን ሀማቲፊ ዋቆትን አርፋድ ኤሰ ጅሩ? ዋቆትን ሴፈርዋይም ኤሰ ጅሩ? እሳን ሀርከኮ ኬሳ ሰማርያ ባሰኒሩ? <verse eid="ISA 36:19"/><verse number="20" style="v" sid="ISA 36:20"/>ዋቆተ ብዮተ ከኔኒ ሁንደ ኬሳ ከምቱ ብዮተሳኒ ሀርከኮ ኬሳ ባሱ ደንደኤ? ዮስ <char style="nd">ዋቀዮ</char> አከሚን ሀርከኮ ኬሳ ዬሩሳሌምን ባሱ ደንደአሬ?”<verse eid="ISA 36:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 36:21"/>ነሞትን ገሩ ሰበቢ ሞትች፣ “ዴቢ ህንኬንናፊ” ጄዼ አጀጄፍ እኑመ ጨልእሰን መሌ ዴቢ ቶኮዩ ህንኬንኔ።<verse eid="ISA 36:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 36:22"/>ከነረት ኤሊያቂም እልም ህልቅያ ቡልቻን መሰራ ሞቱማ፣ ሼብና በሬሳኒፊ ዮኣ እልም አሳፍ ገልሜሳን፣ ኡፈተሳኒ ተተርሳሰኒ ገረ ህስቅያስ ዸቀኒ ዋን አጀጃን ወራና ሱን ጄዼ እት ንህመን።<verse eid="ISA 36:22"/></para>
  <chapter eid="ISA 36"/>
  <chapter number="37" style="c" sid="ISA 37"/>
  <para style="s1">ብልሶሙን ዬሩሳሌም ህመሜ</para>
  <para style="r">
    <ref loc="ISA 37:1-13">37፥1‑13</ref> ኩወፈ – <char style="xt"><ref loc="2KI 19:1-13">2ሞቶ 19፥1‑13</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 37:1"/>ህስቅያስ ሞትች ዮሙ ዋን ከነ ዸገኤት፣ ኡፈተሳ ተርሳሴ ወያ ገዳስ ኡፈቴ መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ሴኔ። <verse eid="ISA 37:1"/><verse number="2" style="v" sid="ISA 37:2"/>እንስ ኤሊያቂም ቡልቻ መሰራ ሞቱማ፣ ሼብና በሬሳፊ ሉቦተ ዱረ ቡኦተ ሁንድሳኒ ወያ ገዳ ኡፈተን እሳያስ ራጅቸ እልመ አሞስ ሰነት ኤርጌ። <verse eid="ISA 37:2"/><verse number="3" style="v" sid="ISA 37:3"/>እሳንስ አከነ ጄዸኒ እሰት ህመን፤ “ህስቅያስ አከነ ጄዸ፦ ጉያን ኩን አኩመ ዬሮ ዳእምን ቶኮ ዸለቹ ገኤ ገሩ ዱበርቲን ሁምነ እቲን ጭኒንስፈቴ ዴሱ ዸብዱት ጉያ ሉበሙ፣ ከን ዼከምሳቲፊ ከን ሰልጵናት። <verse eid="ISA 37:3"/><verse number="4" style="v" sid="ISA 37:4"/><char style="nd">ዋቀዮ</char> ዋቅንኬ ዱቢ አጀጃ ወራና ከን ጎፍታንሳ ሞትች አሶር አከ እን ዋቀ ጅራታት ቆሱፍ ኤርጌ ሰና ዸገኤ ዱቢ <char style="nd">ዋቀዮ</char> ዋቅንኬ ዸገኤ ሰናፍ ጄዼ እሰት ዼከመ ተአ። ከናፉ አት ሀምባወን ሀመ አማት ጅረኒፍ ከዸዹ።”<verse eid="ISA 37:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 37:5"/>ዮሙ ቆንዳልቶትን ህስቅያስ ሞትቻ ገረ እሳያስ ዹፈንት፣ <verse eid="ISA 37:5"/><verse number="6" style="v" sid="ISA 37:6"/>እሳያስ አከነ እሳኒን ጄዼ፤ “አከነ ጄዻ ጎፍታኬሰንት ህማ፤ ‘<char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ አት ዋን ዸጌሴ ጄቹንስ ዱቢ ገርቦን ሞቲ አሶር እቲን ነ አረብሰን ሰነ ህንሶዳትን። <verse eid="ISA 37:6"/><verse number="7" style="v" sid="ISA 37:7"/>ዸጌፈዻ! አን አከ እን ኦዱ ወዪ ዸገኤ ገረ ብየ ኦፊሳት ዴብኡፍ ሀፉረ ቶኮ እሰ ኬሰ ነንካአ፤ አችትስ አከ እን ጎራዴዻን አጄፈሙ ነንጎዸ።’ ”<verse eid="ISA 37:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 37:8"/>አጀጃን ወራናስ ዮሙ አከ ሞቲን አሶር ላኪሺ በኤ ዴሜ ዸገኤት፣ ዱበት ዴብኤ ኡቱ ሞትች ልብና ሎላ ጅሩ አርገቴ።<verse eid="ISA 37:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 37:9"/>ሴናሄሪብስ አከ ቲርሃቅ ሞትች እቶጵያ ሱን እሰ ሎሉፍ ዹፋ ጅሩ ዸገኤ። እንስ ዮሙ ዋን ከነ ዸገኤት፣ አከነ ጄዼ ህስቅያስት ኤርገሞተ ኤርጌ፦ <verse eid="ISA 37:9"/><verse number="10" style="v" sid="ISA 37:10"/>“ህስቅያስ ሞትቸ ይሁዳቲን አከነ ጄዻ፦ ዋቅን አት አብደቱ ሱን፣ ‘ዬሩሳሌም ደበርፈምቴ ሀርከ ሞቲ አሶርት ህንኬነምቱ’ ጄዼ ስ ህንጎዎምስን። <verse eid="ISA 37:10"/><verse number="11" style="v" sid="ISA 37:11"/>አት ዋን ሞቶትን አሶር ጉቱማን ጉቱት እሳን በሌሱዻን ብዮተ ሁንደ ጎዸን ዸጌሴርተ። አትሞ ንሀፍታሬ? <verse eid="ISA 37:11"/><verse number="12" style="v" sid="ISA 37:12"/>ዋቆትን ሰቦተ አቦቲንኮ በርበዴሰን ሰና ጄቹንስ ዋቆትን ጎዛን፣ ዋቆትን ካራን፣ ዋቆትን ሬዜፊፊ ዋቆትን ነሞተ ኤዴን ከኔን ቴላሳር ኬሰ ቱረን ሰና እሳን ኦልቸኒሩ? <verse eid="ISA 37:12"/><verse number="13" style="v" sid="ISA 37:13"/>ሞቲን ሀማት ዮካን ሞቲን አርፋድ ኤሰ ጅረ? ሞቲን መጋላ ሴፈርዋይም፣ ሞቲን ሄና ዮካን ሞቲን እዋ ኤሰ ጅረ?”<verse eid="ISA 37:13"/></para>
  <para style="s1">ከዸትና ህስቅያስ</para>
  <para style="r">
    <ref loc="ISA 37:14-20">37፥14‑20</ref> ኩወፈ – <char style="xt"><ref loc="2KI 19:14-19">2ሞቶ 19፥14‑19</ref></char></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 37:14"/>ህስቅያስስ ኤርገሞተ ሰነ ሀርካ ጠለያ ፉዼ ዱብፈቴ። ኤርገሲስ ገረ መነ ቁልቁሉማ <char style="nd">ዋቀዮት</char> ኦል በኤ ጠለያ ሰነ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ድሪርሴ። <verse eid="ISA 37:14"/><verse number="15" style="v" sid="ISA 37:15"/>ህስቅያስ አከነ ጄዼ <char style="nd">ዋቀዮን</char> ከዸቴ፦ <verse eid="ISA 37:15"/><verse number="16" style="v" sid="ISA 37:16"/>“ያ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንዴሱ፣ ዋቀ እስራኤል፣ ከን ኪሩቤል ግዱ ቴሶረ ጅርቱ፣ ስቆፈቱ ሞቱሞተ ለፋ ሁንደረት ዋቀ። አት ሰሚፊ ለፈ ኡምቴርተ። <verse eid="ISA 37:16"/><verse number="17" style="v" sid="ISA 37:17"/>ያ <char style="nd">ዋቀዮ</char>፣ ጉረኬ አስ ቀቢቲ ዸገእ፤ ያ <char style="nd">ዋቀዮ</char>፣ እጀኬስ በነዹ እላል፤ ዱቢ ሴናሄሪብ ከን እን ዋቀ ጅራታ አረብሱፍ ኤርጌ ከነ ሁንደ ዸጌፈዹ።<verse eid="ISA 37:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 37:18"/>“ያ <char style="nd">ዋቀዮ</char>፣ ሞቶትን አሶር ኡመተ ከነ ሁንዳፊ ብዮተሳኒ በሌሱን ዹጋዸ። <verse eid="ISA 37:18"/><verse number="19" style="v" sid="ISA 37:19"/>እሳን ዋቆተ ጀራ እብደት ነቀኒ በርበዴሰኒሩ፤ ዋቆትን ሱን ሙካፊ ዸጋ ሀርከ ነማቲን ሶፈመን ቱረን መሌ ዋቆተ ህንቱሬቲ። <verse eid="ISA 37:19"/><verse number="20" style="v" sid="ISA 37:20"/>ከናፉ ያ <char style="nd">ዋቀዮ</char> ዋቀኬኘ፣ አከ ሞቱሞን ለፋ ሁንድኑ አከ አት ቆፍት <char style="nd">ዋቀዮ</char> ዋቀ ታቴ ቤከኒፍ፣ ሀርከሳቲ ኑ ባስ።”<verse eid="ISA 37:20"/></para>
  <para style="s1">ኩፋቲ ሴናሄሪብ</para>
  <para style="r">
    <ref loc="ISA 37:21-38">37፥21‑38</ref> ኩወፈ – <char style="xt"><ref loc="2KI 19:20-37">2ሞቶ 19፥20‑37</ref>፤ <ref loc="2CH 32:20-21">2ሴና 32፥20‑21</ref></char></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 37:21"/>ሰነ ቦዴ እሳያስ እልም አሞስ አከነ ጄዼ ህስቅያስት ኤርጋ ኤርጌ፤ “<char style="nd">ዋቀዮ</char> ዋቅን እስራኤል አከነ ጄዸ፦ ሰበቢ አት ዋኤ ሴናሄሪብ ሞትቸ አሶር ነ ከዸቴፍ፣ <verse eid="ISA 37:21"/><verse number="22" style="v" sid="ISA 37:22"/>ዱቢን <char style="nd">ዋቀዮ</char> እሳን ሞርሙዻን ዱበቴ ኩኖ ከናዸ፦</para>
  <para style="q1" vid="ISA 37:22">“እንተል ጥዮን ዱርብ ቁልቁልቲን</para>
  <para style="q2" vid="ISA 37:22">ስ ቱፈቴ ስት ቆስት።</para>
  <para style="q1" vid="ISA 37:22">እንተል ዬሩሳሌም</para>
  <para style="q2" vid="ISA 37:22">ዬሮ አት በቀቱት መታሼ ስት ራፍት።<verse eid="ISA 37:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 37:23"/>ከን አት እት ቆስቴ አረብስቴ ሱን ኤኙ?</para>
  <para style="q2" vid="ISA 37:23">አት ኤኙት ሰገሌኬ ኦል ፉዸቴ</para>
  <para style="q1" vid="ISA 37:23">ኦፍ ቱሉማዻን እጀ ኦል ቀበቴ?</para>
  <para style="q2" vid="ISA 37:23">ቁልቁልቹመ እስራኤል ሰነት ምቲ!<verse eid="ISA 37:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 37:24"/>አት ከራ ኤርገሞተኬቲቲን፣</para>
  <para style="q2" vid="ISA 37:24">ጎፍታት ቆስቴርተ።</para>
  <para style="q1" vid="ISA 37:24">አት አከነስ ጄቴርተ፤</para>
  <para style="q2" vid="ISA 37:24">‘አን ጋሪወንኮ ሄዱዻን</para>
  <para style="q1" vid="ISA 37:24">ፊጤ ቱሉወኒት፣</para>
  <para style="q2" vid="ISA 37:24">ፊጤ ልባኖን ከን አከ መሌ ኦል ዼረቱትስ ኦል በኤረ።</para>
  <para style="q1" vid="ISA 37:24">አን ብርብርሰወንሳ አከ መሌ ዼዼሮ፣</para>
  <para style="q2" vid="ISA 37:24">ጋትራወንሳ ፍለተሞ ሰነስ ጭጭሬረ።</para>
  <para style="q1" vid="ISA 37:24">አን ፊጤወንሳ ከኔን አከ መሌ ኦል ፈጎ፣</para>
  <para style="q2" vid="ISA 37:24">ቦሶኖተ አከ መሌ ምሚዸጎ ቀቀቤረ።<verse eid="ISA 37:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 37:25"/>አን ብየ ኦርማት ቦለ ብሻኒ ቆተዼ</para>
  <para style="q2" vid="ISA 37:25">አችት ብሻን ዹጌረ።</para>
  <para style="q1" vid="ISA 37:25">አን ፋነ ሚለኮቲን</para>
  <para style="q2" vid="ISA 37:25">ለጌን ግብጥ ሁንደ ጎግሴረ።’<verse eid="ISA 37:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 37:26"/>“አት ዋን ከነ ህንዸጌኜ?</para>
  <para style="q2" vid="ISA 37:26">በረ ዼራን ዱረ አነቱ ዋን ከነ ሆጄቴ።</para>
  <para style="q1" vid="ISA 37:26">አን በረ ዱሪ ኬሰ ዋን ከነ ነንከሮርፈዼ፤</para>
  <para style="q2" vid="ISA 37:26">አመሞ ሆጂረ ኦልፈዼረ፤</para>
  <para style="q1" vid="ISA 37:26">ኩንስ አከ አት መጋላወን</para>
  <para style="q2" vid="ISA 37:26">ደላ ጀባ ቀበን ዲግዴ ቱላ ዸጋ ጎቱዸ።<verse eid="ISA 37:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 37:27"/>ነሞትንሳኒ ሁምነ ዸበኒ</para>
  <para style="q2" vid="ISA 37:27">አብዲ ኩተተኒስ ቃነአን።</para>
  <para style="q1" vid="ISA 37:27">እሳን አኩመ ብቅልቱ ዲዳ፣</para>
  <para style="q2" vid="ISA 37:27">አኩመ ብቅልቱ ክቹ ቶኮ፣</para>
  <para style="q1" vid="ISA 37:27">አኩመ መርገ መነ ጉባት ብቅሉ</para>
  <para style="q2" vid="ISA 37:27">ከን ኡቱ ህንጉደትን ጉበቴት።<verse eid="ISA 37:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 37:28"/>“አን ገሩ ለፈ አት ጅርቱ፣</para>
  <para style="q2" vid="ISA 37:28">ዮም አከ ዹፍቱፊ ዮም አከ ዴምቱ፣</para>
  <para style="q2" vid="ISA 37:28">አከ አት አከ መሌ ነት ኣርቱሌ ነንቤከ።<verse eid="ISA 37:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 37:29"/>ሰበቢ አት አከ መሌ ነት ኣርቴ</para>
  <para style="q2" vid="ISA 37:29">ኦፍ ቱሉማንኬስ ጉረኮ ሴኔፍ፣</para>
  <para style="q1" vid="ISA 37:29">አን ፉኛንኬት ሆኮኮ፣</para>
  <para style="q2" vid="ISA 37:29">አፋንኬትሞ ሉገመኮ ካኤ</para>
  <para style="q2" vid="ISA 37:29">አከ አት ከሩመ ዹፍቴ ሰናን ዴብቱ ስን ጎዸ።<verse eid="ISA 37:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ISA 37:30"/>“ያ ህስቅያስ ኩን መለቶ ሲፍ ተአ፦</para>
  <para style="q1" vid="ISA 37:30">“እስን ወጋ ከነ ዋን ኦፉማን ብቅሉ፣</para>
  <para style="q2" vid="ISA 37:30">ወጋ ለመፋትሞ ዋኑመ እሰራ ለቱ ኛቱ።</para>
  <para style="q1" vid="ISA 37:30">ወጋ ሰደፋት ገሩ ፈጫፈዻ ገልፈዻ፤</para>
  <para style="q2" vid="ISA 37:30">ሙከ ወይኒስ ዻበዻቲ እጀሳ ኛዻ።<verse eid="ISA 37:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 37:31"/>አመስ ሀምባን ሞቱማ ይሁዳ ቶኮ፣</para>
  <para style="q2" vid="ISA 37:31">ጀላን ህደ ባፈቴ ጉባንሞ እጀ ነቀተ።<verse eid="ISA 37:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="ISA 37:32"/>ዬሩሳሌም ኬሳ ሀምባን ቶኮ፣</para>
  <para style="q2" vid="ISA 37:32">ቱሉ ጥዮኒቲሞ <optbreak/> ገሬን ወረ በዲሰ ጀላ በኤ ቶኮ ንዹፈ።</para>
  <para style="q1" vid="ISA 37:32">ህናፋን <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ</para>
  <para style="q2" vid="ISA 37:32">ዋን ከነ ንራወተ።<verse eid="ISA 37:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ISA 37:33"/>“ከናፉ <char style="nd">ዋቀዮ</char> ዋኤ ሞትቸ አሶር አከነ ጄዸ፦</para>
  <para style="q1" vid="ISA 37:33">“እን መጋላ ከነ ህንሴኑ፣</para>
  <para style="q2" vid="ISA 37:33">ዮካን ጥየ ቶኮሌ አስት ህንደርበቱ።</para>
  <para style="q1" vid="ISA 37:33">እን ጋቸነ ቀበቴ ፉለሳ ዱረት ህንዽኣቱ</para>
  <para style="q2" vid="ISA 37:33">ዮካን ቱላ ብዮ እት ህንመርሱ።<verse eid="ISA 37:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="ISA 37:34"/>እን ከሩመ ዹፌ ሰናን ንዴብአ፤</para>
  <para style="q2" vid="ISA 37:34">መጋላ ከነስ ህንሴኑ”</para>
  <para style="q2" vid="ISA 37:34">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="ISA 37:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="ISA 37:35"/>“አንስ ሰበቢ ኦፊኮቲፊ ሰበቢ ገርብቸኮ ዳዊቲፍ ጄዼ</para>
  <para style="q2" vid="ISA 37:35">መጋላ ከነ ነንኤገ፤ ነንኦልቸስ!”<verse eid="ISA 37:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ISA 37:36"/>ኤርገሲ ኤርገማን <char style="nd">ዋቀዮ</char> ገድ በኤ ቁበተ ወረ አሶር ኬሰት ነመ ኩመ ዽበ ቶኮፊ ሰዴተሚ ሸን ፍጤ። ዮሙ ነሞትን ጉያ እት ኣኑ ገነመ በሪን ከአንት ኩኖ ሬፍ ነማ ለፈ ጉቴ ቱሬ። <verse eid="ISA 37:36"/><verse number="37" style="v" sid="ISA 37:37"/>ከናፉ ሴናሄሪብ ሞትች አሶር ቁበተ ሰነ ኬሳ በኤ በቀቴ፤ ነነዌት ዴብኤስ አች ጅራቴ።<verse eid="ISA 37:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ISA 37:38"/>ጋፍ ቶኮ ኡቱ እን መነ ሰገዳ ዋቀሳ ንስሮክ ጄዸሙ ኬሰት ዋቄፈቻ ጅሩ እልማንሳ አድረሜሌኪፊ ሸሬዜር ጎራዴዻን እሰ አጄሰኒ ገረ ብየ አራራትት በቀተን። እልምሳ ኤሰርሀዶንስ እዶሳ ቡኤ ሞቲ ተኤ።<verse eid="ISA 37:38"/></para>
  <chapter eid="ISA 37"/>
  <chapter number="38" style="c" sid="ISA 38"/>
  <para style="s1">ህስቅያስ ዹኩብሰቹሳ</para>
  <para style="r">
    <ref loc="ISA 38:1-8">38፥1‑8</ref> ኩወፈ – <char style="xt"><ref loc="2KI 20:1-11">2ሞቶ 20፥1‑11</ref>፤ <ref loc="2CH 32:24-26">2ሴና 32፥24‑26</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 38:1"/>በረ ሰነ ኬሰ ህስቅያስ ዹኩብሰቴ ዱኡ ገኤ ቱሬ። እሳያስ እልም አሞስ ራጅች ገረሳ ዸቄ፣ “<char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ መነኬ ቶቶልፈዹ፤ አት ንዱተ መሌ ህንፈይቱቲ” ጄዼን።<verse eid="ISA 38:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 38:2"/>ህስቅያስስ ፉለሳ ገረ ኬኘን መናት ገረገልፈቴ አከነ ጄዼ <char style="nd">ዋቀዮን</char> ከዸቴ፤ <verse eid="ISA 38:2"/><verse number="3" style="v" sid="ISA 38:3"/>“ያ <char style="nd">ዋቀዮ</char>፣ አከ አን አመነሙማፊ ገራ ቶኮን ፉለኬ ዱረ ጅራዼ ዋን ፉለኬ ዱረት ጋሪ ተኤስ ሆጄዼ ያደዹ።” ህስቅያስስ ህቅፈቴ ንቦኤ።<verse eid="ISA 38:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 38:4"/>ኤርገሲስ ዱቢን <char style="nd">ዋቀዮ</char> አከነ ጄዼ ገረ እሳያስ ዹፌ፦ <verse eid="ISA 38:4"/><verse number="5" style="v" sid="ISA 38:5"/>“ዸቂቲ አከነ ጄዺ ህስቅያስት ህም፤ ‘<char style="nd">ዋቀዮ</char> ዋቅን አባኬ ዳዊት አከነ ጄዸ፦ አን ከዸትናኬ ዸገኤረ፤ እምማንኬስ አርጌረ፤ አን ኡሙሪኬረት ወጋ ኩዸ ሸን ሲፈን ደበለ። <verse eid="ISA 38:5"/><verse number="6" style="v" sid="ISA 38:6"/>አን ስኢፊ መጋላ ከነ ሀርከ ሞትቸ አሶሪቲ ነንባሰ። አን መጋላ ከነ ነንኤገ።<verse eid="ISA 38:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 38:7"/>“ ‘ኩን መለቶ <char style="nd">ዋቀዮ</char> ከን አከ እን ዋን ዋዳ ገሌ ሰነ ጉቱ ምርከኔሱፍ <char style="nd">ዋቀዮ</char> ብራ ሲፍ ኬነሜዸ፦ <verse eid="ISA 38:7"/><verse number="8" style="v" sid="ISA 38:8"/>አን አከ ጋድዱን አዱ ተርካንፊ ኩርነን ጉለንታ ኣሃዝ እራን ገድ ቡኤ ሰነ ዱግደ ዱበት ዴብኡ ነንጎዸ።’ ” ከናፉ ጋድዱን ተርካንፊ ኩርነን ገድ ቡኤ ቱሬ ሱን ዱግደ ዱበት ዴብኤ።<verse eid="ISA 38:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 38:9"/>በሬፈመ ህስቅያስ ሞትች ይሁዳ ኤርገ ዹኩብሰቴ ፈዬ ቦዴ በሬሴ፦<verse eid="ISA 38:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 38:10"/>አንስ፣ “ወለካ ኡሙሪኮቲት፣</para>
  <para style="q2" vid="ISA 38:10">አን ሲኦል ሴኑን ቀባ?</para>
  <para style="q2" vid="ISA 38:10">በረ ጅሬኘኮ ከን ሀፌስ ዸቡን ቀባ?” ነንጄዼ።<verse eid="ISA 38:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 38:11"/>አን አከነን ጄዼ፤ “አን ብየ ጅራቶታ ኬሰት፣</para>
  <para style="q2" vid="ISA 38:11">ለመተ <char style="nd">ዋቀዮን</char> ህንአርጉ፤</para>
  <para style="q1" vid="ISA 38:11">አን ስአች ሰኚ ነማ ህንእላሉ፣</para>
  <para style="q2" vid="ISA 38:11">ዮካን ወረ አዱኛ ከነረ ጅራተን ወጅን ህንጅራዹ።<verse eid="ISA 38:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 38:12"/>መንኮ አኩመ ዱንካነ ትክሶታ</para>
  <para style="q2" vid="ISA 38:12">ቡቅፈሜ ነራ ፉዸተሜረ።</para>
  <para style="q1" vid="ISA 38:12">አን አኩመ ወያ ዾፍቱ ጅሬኘኮ መርመሬረ፤</para>
  <para style="q2" vid="ISA 38:12">እን ምአ ወያ ዾፍቱራ ነ ኩቴረ፤</para>
  <para style="q2" vid="ISA 38:12">አት ሀልከኒ ጉያ ነ በሌስተ።<verse eid="ISA 38:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 38:13"/>አን ሀመ በሪት ኦብሳን ነንኤገዼ፤</para>
  <para style="q2" vid="ISA 38:13">እን ገሩ አከ ሌንጫ ለፌኮ ሁንደ ጨጨብሴ፤</para>
  <para style="q2" vid="ISA 38:13">አት ሀልከኒ ጉያስ ነ በሌስተ።<verse eid="ISA 38:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 38:14"/>አን አከ ስምብሮ ዮካን አኩመ ዳሎቴ ነንወጬ፤</para>
  <para style="q2" vid="ISA 38:14">አከ ጉጌ ቦሱስ ነንኣዴ፤</para>
  <para style="q1" vid="ISA 38:14">እጅኮ ገረ ሰሚ እላሉዻን ደዸቤ፤</para>
  <para style="q2" vid="ISA 38:14">ያ ጎፍታ አን ረከዼራ ኮቱ ነ ገርጋር!”<verse eid="ISA 38:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 38:15"/>አን ገሩ ማል ጄቹን ደንደአ?</para>
  <para style="q2" vid="ISA 38:15">እን ነት ዱበቴ፤ እን መታንሳስ ዋን ከነ ጎዼ።</para>
  <para style="q1" vid="ISA 38:15">አን ዋኤ ዽጵና ሉቡኮቲፍ</para>
  <para style="q2" vid="ISA 38:15">ኡሙሪኮ ጉቱ ገድ ኦፍ ቀቤ ነንጅራዸ።<verse eid="ISA 38:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 38:16"/>ያ ጎፍታ፣ ነሞትን</para>
  <para style="q2" vid="ISA 38:16">ዋኑመ አከሲቲን ጅራቱ፤</para>
  <para style="q1" vid="ISA 38:16">ሀፉርኮስ እሳኑማን ጅሬኘ አርገተ።</para>
  <para style="q2" vid="ISA 38:16">አት ነ ፈይፍቴ ሉቡዻንስ ነ ጅራችፍቴ።<verse eid="ISA 38:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 38:17"/>ዹጉማን አከስ ዽጰቹንኮ ፋይዳኮቲፍ።</para>
  <para style="q2" vid="ISA 38:17">አት ጃለለኬቲን ቦለ በዲሳራ ነ ኤግዴ፤</para>
  <para style="q2" vid="ISA 38:17">ጩቡኮ ሁንደስ፣ ዱግደኬ ዱበት ገቴ።<verse eid="ISA 38:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 38:18"/>ሲኦል ስ ገለቴፈቹ ህንደንደኡቲ፤</para>
  <para style="q2" vid="ISA 38:18">ዱትስ ስ ጀጀቹ ህንደንደኡ።</para>
  <para style="q1" vid="ISA 38:18">ወር ቅሌት ገድ ቡአን፣</para>
  <para style="q2" vid="ISA 38:18">አመነሙማኬ አብደቹ ህንደንደአን።<verse eid="ISA 38:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 38:19"/>እሳን አኩመ አን ሀርአ ጎቻ ጅሩ ከነ ያ ጅራታ፣</para>
  <para style="q2" vid="ISA 38:19">ያ ጅራታ ጄዸኒ ስ ጀጀቱ፤</para>
  <para style="q1" vid="ISA 38:19">አቦቲን ዋኤ አመነሙማኬቲ</para>
  <para style="q2" vid="ISA 38:19">እጆሌሳኒት ንኦዴሱ።<verse eid="ISA 38:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 38:20"/>
    <char style="nd">ዋቀዮ</char> ነ በራረ፤</para>
  <para style="q2" vid="ISA 38:20">ኑስ በረ ጅሬኘኬኛ ጉቱ፣</para>
  <para style="q1" vid="ISA 38:20">መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ኬሰት</para>
  <para style="q2" vid="ISA 38:20">ምአ ርቡራ ሆጄተሜን ፋርፈትነ።<verse eid="ISA 38:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 38:21"/>እሳያስ፣ “መጥኖ ሀርቡ ቶልቻቲ ዹላሳረ ካኣ፤ እንስ ንፈያ” ጄዼ ቱሬ።<verse eid="ISA 38:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 38:22"/>ህስቅያስስ፣ “አከ አን ገረ መነ ቁልቁሉማ <char style="nd">ዋቀዮት</char> ኦል በኡፍ ማልቱ መለቶ ተአ?” ጄዼ ጋፈቴ።<verse eid="ISA 38:22"/></para>
  <chapter eid="ISA 38"/>
  <chapter number="39" style="c" sid="ISA 39"/>
  <para style="s1">ኤርገሞተ ባብሎኒ ዹፈን</para>
  <para style="r">
    <ref loc="ISA 39:1-8">39፥1‑8</ref> ኩወፈ – <char style="xt"><ref loc="2KI 20:12-19">2ሞቶ 20፥12‑19</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 39:1"/>ዬሮ ሰነት ሜሮደክ በለዳን እልም በለዳን ሞቲን ባብሎን ሰበቢ አከ ህስቅያስ ዹኩብሰቴ ፈዬ ዸገኤፍ ጠለዮታፊ ኬና ኤርጌፍ። <verse eid="ISA 39:1"/><verse number="2" style="v" sid="ISA 39:2"/>ህስቅያስስ ኤርገሞተ ሰነ ገመቹዻን ስመቴ ዋን መንኩሰሳ ኬሰ ቱሬ ሜቲ፣ ወርቄ፣ ኡርጎፍቱ፣ ዘይቲ ቁልቁሉ አከሱመስ ኩሳ ምአ ሎላሳ ጉቱፊ ዋን መንኩሰሳ ኬሰት አርገሙ ሁንደ እሳንት አርግሲሴ። ወን ህስቅያስ መሰራ ሞቱማሳ ኬሳ ዮካን ሞቱማሳ ሁንደ ኬሳ እሳንት ህንአርግሲስን ቶኮዩ ህንቱሬ።<verse eid="ISA 39:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 39:3"/>ከነረት እሳያስ ራጅች ገረ ህስቅያስ ሞትቻ ዸቄ፣ “ነሞትን ሱን ማል ጄዸን? እሳን ኤሳ ዹፈን?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="ISA 39:3">ህስቅያስስ፣ “እሳን ባብሎኒ ብየ ፈጎዻ ነ ብረ ዹፈን” ጄዼ ዴብሴ።<verse eid="ISA 39:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 39:4"/>ራጅች፣ “ጀር መሰራ ሞቱማኬቲ ኬሰት ማል አርገን?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="ISA 39:4">ህስቅያስሞ፣ “እሳን ዋን መሰራ ሞቱማኮ ኬሰ ጅሩ ሁንደ አርገን፤ ወን አን መንኩሰኮ ኬሳ እሳንት ህንአርግሲስን ቶኮዩ ህንጅሩ” ጄዼን።<verse eid="ISA 39:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 39:5"/>እሳያስስ ከነረት ህስቅያሲን አከነ ጄዼ፤ “ዱቢ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ ዸገእ፦ <verse eid="ISA 39:5"/><verse number="6" style="v" sid="ISA 39:6"/>ዬሮን እት ወን መሰራ ሞቱማኬቲ ኬሰ ጅሩ ሁንዲፊ ወን አቦቲንኬ ሀመ ሀርኣት ኩሰን ሁንድኑ ሳመሜ ገረ ባብሎንት ጌፈሙ ቶኮ ዹጉማን ንዹፈ። ወን ቶኮዩ ህንሀፉ፣ ጄዸ <char style="nd">ዋቀዮ</char>። <verse eid="ISA 39:6"/><verse number="7" style="v" sid="ISA 39:7"/>ሰኚኬ ኬሳ ነሞትን ቶኮ ቶኮ፣ ፎኒፊ ዺግንኬ ከኔን ሲፍ ዸለተን ቦጅአመኒ መሰራ ሞቱማ ሞትቸ ባብሎን ኬሰት ጡኣሺወን ተኡ።”<verse eid="ISA 39:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 39:8"/>ህስቅያስስ፣ “ዱቢን <char style="nd">ዋቀዮ</char> ከን አት ዱበቴ ኩን ጋሪዸ” ጄዼ ዴብሴ። እን፣ “በረ ጅሬኘኮ ኬሰ ነጋፊ ተስገቢን ንጅራተ” ጄዼ ያዴ ቱሬቲ።<verse eid="ISA 39:8"/></para>
  <chapter eid="ISA 39"/>
  <chapter number="40" style="c" sid="ISA 40"/>
  <para style="s1">ሰብን ዋቃ ጀጀቤፈሜ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 40:1"/>ጀጀቤሳ፤ ሰበኮ ጀጀቤሳ፤</para>
  <para style="q2" vid="ISA 40:1">ጄዸ ዋቅንኬሰን።<verse eid="ISA 40:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 40:2"/>ገራ ዬሩሳሌምት ዱበዻ፤</para>
  <para style="q2" vid="ISA 40:2">ሆጂን ገርቡማሼ አከ ዹሜ፣</para>
  <para style="q1" vid="ISA 40:2">ገቲን ጩቡሼ አከ ባፈሜፍ፣</para>
  <para style="q2" vid="ISA 40:2">እሼን ጩቡሼ ሁንዳፍ</para>
  <para style="q1" vid="ISA 40:2">ሀርከ <char style="nd">ዋቀዮቲ</char> አደቢ ደቻ</para>
  <para style="q2" vid="ISA 40:2">አከ ፉዸቴ እሼት ለብሳ።<verse eid="ISA 40:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 40:3"/>ሰገሌ አከነ ጄዼ እዩ ቶኮ፦</para>
  <para style="q1" vid="ISA 40:3">“ገሞጂ ኬሰት</para>
  <para style="q2" vid="ISA 40:3">
    <char style="nd">ዋቀዮፍ</char> ከራ ቆጴሳ፤</para>
  <para style="q1" vid="ISA 40:3">ገሞጂ ኬሰት ዋቀኬኛፍ</para>
  <para style="q2" vid="ISA 40:3">ከራ ጉድቸ ቀጄልቻ።<verse eid="ISA 40:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 40:4"/>ሱሉል ሁንድ ንጉተመ፤</para>
  <para style="q2" vid="ISA 40:4">ቱሉፊ ጋር ሁንድኑስ ገድ ዴብፈመ፤</para>
  <para style="q1" vid="ISA 40:4">ለፍት ወል ጫሉ፣ ወል ቅጤፈመ፤</para>
  <para style="q2" vid="ISA 40:4">ለፍት ቡኣ በኢንስ ድሬ ተአ።<verse eid="ISA 40:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 40:5"/>ኡልፍን <char style="nd">ዋቀዮ</char> ንሙልአተ፤</para>
  <para style="q2" vid="ISA 40:5">ሰኚን ነማ ሁንድኑስ ቶኩማዻን ንአርገ።</para>
  <para style="q1" vid="ISA 40:5">አፋን <char style="nd">ዋቀዮ</char> ዱበቴራቲ።”<verse eid="ISA 40:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 40:6"/>ሰገሌን ቶኮ “እይ” ጄዸ።</para>
  <para style="q2" vid="ISA 40:6">አንስ፣ “ማል ጄዼን እየ?” ነንጄዼ።</para>
  <para style="b" vid="ISA 40:6"/>
  <para style="q1" vid="ISA 40:6">“ነምን ሁንድ አኩመ መርጋት፤</para>
  <para style="q2" vid="ISA 40:6">ኡልፍንሳ ሁንድስ አኩመ ደራራ ድሬት።<verse eid="ISA 40:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 40:7"/>ሰበቢ ሀፉር <char style="nd">ዋቀዮ</char> ባፈቱ እሳንት ቡብሱፍ መርግ</para>
  <para style="q2" vid="ISA 40:7">ንጮለገ፤ ደራራንስ ንሀርጨአ።</para>
  <para style="q2" vid="ISA 40:7">ዹጉማን ነምን መርጉመ።<verse eid="ISA 40:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 40:8"/>መርግ ንጮለገ፤ ደራራንስ ንሀርጨአ፤</para>
  <para style="q2" vid="ISA 40:8">ዱቢን ዋቀኬኛ ገሩ በረ በራን ንጅራተ።”<verse eid="ISA 40:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 40:9"/>አት ከን ጥዮኒፍ ኦዱ ጋሪ ፍዱ፣</para>
  <para style="q2" vid="ISA 40:9">ቱሉ ዼራት ኦል በእ።</para>
  <para style="q1" vid="ISA 40:9">አት ከን ዬሩሳሌሚፍ ኦዱ ጋሪ ፍዱ፣</para>
  <para style="q2" vid="ISA 40:9">ሰገሌኬ ኦል ፉዹቲ እይ፤</para>
  <para style="q1" vid="ISA 40:9">ኦል ፉዸዹ እይ፤ ህንሶዳትን፤</para>
  <para style="q2" vid="ISA 40:9">መጋላወን ይሁዳቲንስ፣</para>
  <para style="q2" vid="ISA 40:9">“ዋቅንኬሰን ኩኖት!” ጄዽ።<verse eid="ISA 40:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 40:10"/>ኩኖ፣ <char style="nd">ዋቀዮ</char> ጎፍታን ሁምናን ንዹፈ፤</para>
  <para style="q2" vid="ISA 40:10">እሬንሳ ጀባዻንስ ንቡልቸ።</para>
  <para style="q1" vid="ISA 40:10">ኩኖ፣ ገቲንሳ እሰ ወጅን ጅረ፤</para>
  <para style="q2" vid="ISA 40:10">ገቲን እን ነማፍ ኬኑ እሱመ ሀርከ ጅረ።<verse eid="ISA 40:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 40:11"/>እን አኩመ ትክሴ ቶኮት ቡሻዬሳ ትክፈተ፤</para>
  <para style="q2" vid="ISA 40:11">ጦባላወን ሆላስ እሬሳቲን ወልት ቀበ፤</para>
  <para style="q1" vid="ISA 40:11">ኦፍት ቀቤስ ቆመሳት ሀመተ፤</para>
  <para style="q2" vid="ISA 40:11">ሃዾተ ሆሎታ ወረ ሆስሰንስ ሱቱመ ኦፈ።<verse eid="ISA 40:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 40:12"/>ብሻኖተ ኮኜሳቲን ከን ሰፈሬ</para>
  <para style="q2" vid="ISA 40:12">ዮካን ሰሚወን ታኩሳቲን ከን ሰፈሬ ኤኙ?</para>
  <para style="q1" vid="ISA 40:12">ብዮ ለፋ ሰፈርቱዻን ወልት ከን ቀቤ</para>
  <para style="q2" vid="ISA 40:12">ዮካን ቱሉወን መዳሊዻን</para>
  <para style="q2" vid="ISA 40:12">ጋረንሞ መዳሊዻን ከን መዳሌ ኤኙ?<verse eid="ISA 40:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 40:13"/>ኤኙቱ ሀፉረ <char style="nd">ዋቀዮ</char> ቀጄልቹ ደንደኤ?</para>
  <para style="q2" vid="ISA 40:13">ዮካን ነምን ጎርሳሳ ተኤ እሰ በርሲሴ ኤኙ?<verse eid="ISA 40:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 40:14"/>
    <char style="nd">ዋቀዮ</char> ሁበትና አርገቹፍ ኤኙን ጎርሰ ጋፈቴ?</para>
  <para style="q2" vid="ISA 40:14">ዳንዲ ቀጄላስ ኤኙቱ እሰ በርሲሴ?</para>
  <para style="q1" vid="ISA 40:14">ኤኙቱ ቤኩምሰ እሳፍ ኬኔ</para>
  <para style="q2" vid="ISA 40:14">ዮካን ዳንዲ ሁበትና እሰ አርግሲሴ?<verse eid="ISA 40:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 40:15"/>ዹጉማን ሰቦትን አኩመ ጮጰ ባልዲ ኬሳት፤</para>
  <para style="q2" vid="ISA 40:15">እሳን አኩመ አዋረ መዳሊረ ጅሩት እላለሙ፤</para>
  <para style="q2" vid="ISA 40:15">እን ብዮተ ብሻን ግዱሌ አኩመ ብዮ ቡላኣት መዳለ።<verse eid="ISA 40:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 40:16"/>ልባኖን ቆራን እዶ ኣርሳቲፍ ገኡ ህንቀብዱ፣</para>
  <para style="q2" vid="ISA 40:16">ዮካን ሆሪንሼ ኣርሳ ጉበሙፍ ህንገአን።<verse eid="ISA 40:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 40:17"/>ፉለሳ ዱረት ሰቦትን ሁንድኑ ወይቱ ህንለካአመን፤</para>
  <para style="q2" vid="ISA 40:17">እሳን አከ እላልቸሳት ሆማቱ ህንሄደመን፤</para>
  <para style="q2" vid="ISA 40:17">ገቲስ ህንቀበን።<verse eid="ISA 40:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 40:18"/>ዮስ ዋቀ ኤኙት ፈኬስቱ?</para>
  <para style="q2" vid="ISA 40:18">ፈኪ ከም ወጅን እሰ ወል ብረ ቀብዱ?<verse eid="ISA 40:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 40:19"/>ዋቀ ቶልፈማ ቱምቱ ስቢላቱ በቅሴ ቶልቸ፤</para>
  <para style="q2" vid="ISA 40:19">ቱምቱን ወርቄስ ወርቄ እት ኡፍሰ፤</para>
  <para style="q2" vid="ISA 40:19">ፎንጫ ሜቲቲንስ ንሚዸግሰ።<verse eid="ISA 40:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 40:20"/>ህዬስ ኣርሳ አከሲ ዽኤሱ</para>
  <para style="q2" vid="ISA 40:20">ህንደንዴኜ ቶኮ ሙከ ህንቶርቶሬ ፍለተ።</para>
  <para style="q1" vid="ISA 40:20">ዋቀ ቶልፈማ ህንጅግኔ ዻቡፍስ</para>
  <para style="q2" vid="ISA 40:20">ነመ ኦጉማ ሆጂ ሀርካ ቀቡ በርባደተ።<verse eid="ISA 40:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 40:21"/>እስን ህንቤክተኒ?</para>
  <para style="q2" vid="ISA 40:21">እስን ህንዸጌኜ?</para>
  <para style="q1" vid="ISA 40:21">ወን ኩን ጀልቀቡማ ካሴ እስንት ህንህመምኔ?</para>
  <para style="q2" vid="ISA 40:21">እስን ኤርገ ለፍት ሁንዴፈምቴ ጀልቀቤ ህንሁበትኔ?<verse eid="ISA 40:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 40:22"/>እን ጌንጎ ለፋቲ ኦል ታአ፤</para>
  <para style="q2" vid="ISA 40:22">ኡመትን ለፋስ አኩመ ኮሮጵሳት።</para>
  <para style="q1" vid="ISA 40:22">እን ሰሚወን አኩመ ጎልጋት ድሪርሰ፤</para>
  <para style="q2" vid="ISA 40:22">አከ ዱንካነ ኬሰ ጅራተኒትስ እሳን ድሪርሰ።<verse eid="ISA 40:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 40:23"/>እን እልማን ሞቶታ ፋይዳ ዸብሲሰ፤</para>
  <para style="q2" vid="ISA 40:23">ቡልችቶተ አዱኛስ ሀርከ ዱዋ ሀምብሰ።<verse eid="ISA 40:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 40:24"/>አኩመ እሳን ዻበመኒን፣</para>
  <para style="q2" vid="ISA 40:24">አኩመ እሳን ፈጫፈመኒን፣</para>
  <para style="q2" vid="ISA 40:24">አኩመ እሳን ለፈ ኬሰት ህደ ያፈተኒን፣ <optbreak/> እን እሳንት ቡብሴ፤</para>
  <para style="q1" vid="ISA 40:24">እሳንስ ንጮለገን፤</para>
  <para style="q2" vid="ISA 40:24">ኦቦምቦሌቲንስ አኩመ ሀበቂት እሳን ሀጣኤ።<verse eid="ISA 40:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 40:25"/>“እስን ኤኙት ነ ፈኬስቱ?</para>
  <para style="q2" vid="ISA 40:25">ዮካን ኤኙቱ አናን ቅጣተ?” ጄዸ ቁልቁልች።<verse eid="ISA 40:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 40:26"/>እጀኬሰን ኦል ፉዸዻቲ ሰሚወን እላላ፦</para>
  <para style="q2" vid="ISA 40:26">ኤኙቱ ከኔን ሁንደ ኡሜ?</para>
  <para style="q1" vid="ISA 40:26">እሰ ቱተ ኡርጂወኒ ቶኮ ቶኮን ፍዴ</para>
  <para style="q2" vid="ISA 40:26">ቶኮ ቶኮሳኒ መቃ መቃዻን ዋሙ ሰናዸ።</para>
  <para style="q1" vid="ISA 40:26">ሰበቢ ሁምነሳ ጭማ ሰናቲፊ ጀብነሳ ጉዳ ሰናቲፍ</para>
  <para style="q2" vid="ISA 40:26">እሳን ኬሳ ቶኮዩ ህንዸበሙ።<verse eid="ISA 40:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 40:27"/>ያ ያቆብ፣ ያ እስራኤል፣ አት ማሊፍ፣</para>
  <para style="q2" vid="ISA 40:27">“ከራንኮ <char style="nd">ዋቀዮ</char> ዱራ ዾከቴረ፤</para>
  <para style="q1" vid="ISA 40:27">ሃጃንኮስ ፉለ ዋቀኮ ዱረት</para>
  <para style="q2" vid="ISA 40:27">ቱፈተሜረ” ጄቴ ጉንጉምተ?<verse eid="ISA 40:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 40:28"/>አት ህንቤክቱ?</para>
  <para style="q2" vid="ISA 40:28">አት ህንዸጌኜ?</para>
  <para style="q1" vid="ISA 40:28">
    <char style="nd">ዋቀዮ</char> ዋቀ በረ በራት፤</para>
  <para style="q2" vid="ISA 40:28">እን ኡማ ሀንዳረ ለፋት።</para>
  <para style="q1" vid="ISA 40:28">እን ህንደዸቡ ዮካን ሃረ ህንገልፈቱ፤</para>
  <para style="q2" vid="ISA 40:28">ሁበትናሳስ ከን ቆሬ ብረ ገኡ ህንጅሩ።<verse eid="ISA 40:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 40:29"/>እን ደዸብዶታፍ ጀብነ ኬነ፤</para>
  <para style="q2" vid="ISA 40:29">ነመ ላፋፍሞ ሁምነ ደበለ።<verse eid="ISA 40:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 40:30"/>እጆሌንዩ ንደዸቡ፤ ንቡቱቱስ፤</para>
  <para style="q2" vid="ISA 40:30">ደርገጎንስ ጉፈተኒ ኩፉ፤<verse eid="ISA 40:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 40:31"/>ወር <char style="nd">ዋቀዮን</char> አብደተን ገሩ</para>
  <para style="q2" vid="ISA 40:31">ሁምነሳኒ ንሃሮምፈቱ።</para>
  <para style="q1" vid="ISA 40:31">እሳን አኩመ ርሳ ቆቾዻን በርሱ፤</para>
  <para style="q2" vid="ISA 40:31">ንፊጉ፤ ህንደዸበን፤</para>
  <para style="q2" vid="ISA 40:31">ንዴሙ፤ ህንቡቱተን።<verse eid="ISA 40:31"/></para>
  <chapter eid="ISA 40"/>
  <chapter number="41" style="c" sid="ISA 41"/>
  <para style="s1">ገርጋራ እስራኤል</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 41:1"/>ዋቀዮ አከነ ጄዸ፤</para>
  <para style="q2" vid="ISA 41:1">“ያ ብዮተ ብሻን ግዱ፣ ፉለኮ ዱረት ጨልእሳ!</para>
  <para style="q1" vid="ISA 41:1">ሰቦትን ጀብነሳኒ ሃሃሮምፈተን!</para>
  <para style="q2" vid="ISA 41:1">እሳን ፉለ ዱረት በአኒ ሃዱበተን፤</para>
  <para style="q2" vid="ISA 41:1">ወሊ ወጅን ሙርቲዻፍ ሃዽኣትኑ።<verse eid="ISA 41:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 41:2"/>“ከን በአ ቢፍቱቲ ነመ ቶኮ ከካሴ</para>
  <para style="q2" vid="ISA 41:2">ቀጄሉማዻን ተጃጅለሳቲፍ እሰ ዋሜ ኤኙ?</para>
  <para style="q1" vid="ISA 41:2">እን ሰቦተ ደበርሴ ሀርከሳት ኬነ፤</para>
  <para style="q2" vid="ISA 41:2">ሞቶተስ እሰ ጀለት ቡልቸ።</para>
  <para style="q1" vid="ISA 41:2">እን ጎራዴሳቲን ዳራ፣</para>
  <para style="q2" vid="ISA 41:2">ጥየሳቲንስ ሀበቂ ቡቤዻን <optbreak/> ብትናኡ እሳን ጎዸ።<verse eid="ISA 41:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 41:3"/>እን እሳን አርኤ፣</para>
  <para style="q2" vid="ISA 41:3">ዳንዲ ሚልሳረ ዴሜ ህንቤክኔረ ነጋን ደርበ።<verse eid="ISA 41:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 41:4"/>ጀልቀባ ካሴ ዸሎተ ዋሜ</para>
  <para style="q2" vid="ISA 41:4">ዋን ከነ ከን ቶልቼፊ ሆጄቴ ኤኙ?</para>
  <para style="q1" vid="ISA 41:4">አን <char style="nd">ዋቀዮ</char> እሰ ዱራት፤</para>
  <para style="q2" vid="ISA 41:4">እሰ ዹማቲፍስ አን እሱመ።”<verse eid="ISA 41:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 41:5"/>ብዮትን ብሻን ግዱ አርገኒ ሶዳቱ፤</para>
  <para style="q2" vid="ISA 41:5">ዳሪወን ለፋ ንሆለቱ።</para>
  <para style="q1" vid="ISA 41:5">እሳንስ ንዽኣቱ፤ ገረ ፉለ ዱራትስ ዹፉ፤<verse eid="ISA 41:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="ISA 41:6"/>ቶኮን ቶኮን ነማ ወል ገርጋረ፤</para>
  <para style="q2" vid="ISA 41:6">ኦቦሌሰሳቲንስ፣ “ጀባዹ!” ጄዸ።<verse eid="ISA 41:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 41:7"/>ቱምቱን ስቢላ ቱምቱ ወርቄ ንጀጀቤሰ፤</para>
  <para style="q2" vid="ISA 41:7">እን ቡሩሳን ወል ቅጤሱስ፣</para>
  <para style="q2" vid="ISA 41:7">እሰ ጌሞረት ስቢለ ቱሙ ጀጀቤሰ።</para>
  <para style="q1" vid="ISA 41:7">ዋኤ ስቢለ ወልት በቅሱ፣ “ወን ኩን ጋሪዸ” ጄዸ።</para>
  <para style="q2" vid="ISA 41:7">አከ እን ህንሶቾኔፍስ ዋቀ ቶልፈማ ሰነ<optbreak/> ምስማራን ወልት ቀብሲሰ።<verse eid="ISA 41:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 41:8"/>“አት ገሩ፣ ያ ገርብቸኮ እስራኤል፣</para>
  <para style="q2" vid="ISA 41:8">ያ ያቆብ ከን አን ፍለዼ፣</para>
  <para style="q2" vid="ISA 41:8">ሰኚ አብረሃም ምቹኮቲ፣<verse eid="ISA 41:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 41:9"/>አን ሀንዳረ ለፋቲ ስ ፉዸዼ፤</para>
  <para style="q2" vid="ISA 41:9">ጎሌ ፈጎዻን ስ ዋመዼ።</para>
  <para style="q1" vid="ISA 41:9">አን፣ ‘አት ገርብቸኮት’ ሲን ጄዼ፤</para>
  <para style="q2" vid="ISA 41:9">አን ስ ፍለዼረ፤ ስ ህንገኔስ፣<verse eid="ISA 41:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 41:10"/>ከናፉ አት ህንሶዳትን፤ አን ስ ወጅን ጅራቲ፤</para>
  <para style="q2" vid="ISA 41:10">ህንራፈምን፤ አን ዋቀኬቲ።</para>
  <para style="q1" vid="ISA 41:10">አን ስን ጀቤሰ፤ ስን ገርጋረስ፤</para>
  <para style="q2" vid="ISA 41:10">አን ሀርከኮ ምርጋ ቀጄላ ሰናን ህርክሴ ኦል ስን ቀበ።<verse eid="ISA 41:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 41:11"/>“ኩኖ፣ ወር ስት ኣረን ሁንድ፣</para>
  <para style="q2" vid="ISA 41:11">ንቃነኡ፤ ንሰልጰቱስ፤</para>
  <para style="q2" vid="ISA 41:11">ወር ሲን ሞርመን አከ ዋን ህንጅሬ ተኡ፤ ንበዱስ።<verse eid="ISA 41:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 41:12"/>አት ዲኖተኬ በርባዱዩ፣ እሳን ህንአርገቱ።</para>
  <para style="q2" vid="ISA 41:12">ወር ወራነ ስት በነን፣</para>
  <para style="q2" vid="ISA 41:12">ጉቱማን ጉቱት አከ ዋን ህንጅሬ ተአን።<verse eid="ISA 41:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 41:13"/>አን <char style="nd">ዋቀዮ</char> ዋቅንኬ</para>
  <para style="q2" vid="ISA 41:13">ሀርከኬ ምርጋ ነንቀባቲ፤</para>
  <para style="q1" vid="ISA 41:13">እን፣ ‘ህንሶዳትን፤</para>
  <para style="q2" vid="ISA 41:13">አን ስን ገርጋራ’ ሲን ጄዹስ አኑመ።<verse eid="ISA 41:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 41:14"/>ያ ያቆብ ራሞነነ፣</para>
  <para style="q2" vid="ISA 41:14">ያ እስራኤል ጥኖነነ ህንሶዳትን፤</para>
  <para style="q1" vid="ISA 41:14">አን መታንኮ ስን ገርጋራቲ” ጄዸ <char style="nd">ዋቀዮ</char>፣</para>
  <para style="q2" vid="ISA 41:14">ፉራንኬ፣ ቁልቁልች እስራኤል ሱን።<verse eid="ISA 41:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 41:15"/>“አን ኩኖ፣ ሜሻ እቲን ምዻን ዸአን፣</para>
  <para style="q2" vid="ISA 41:15">ሜሻ ሃራፊ ቀረማ ከን እልካን ባይኤ ቀቡ ስን ታስሰ።</para>
  <para style="q1" vid="ISA 41:15">አት ቱሉወን ዾፍቴ ጨጨብስተ፤</para>
  <para style="q2" vid="ISA 41:15">ጋረንሞ አከ ሀበቂ ጎተ።<verse eid="ISA 41:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 41:16"/>አት ጀረ ንአፈርስተ፤ ቅሌንስስ ኦል እሳን ፉዸተ፤</para>
  <para style="q2" vid="ISA 41:16">ቡቤን ጀባን እሳን ብትኔሰ።</para>
  <para style="q1" vid="ISA 41:16">አት ገሩ <char style="nd">ዋቀዮት</char> ንገመደ፤</para>
  <para style="q2" vid="ISA 41:16">ቁልቁልቸ እስራኤልንስ ኡልፍነ አርገተ።<verse eid="ISA 41:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 41:17"/>“ህዬዪፊ ረከቶትን ብሻን በርባዱ፤</para>
  <para style="q2" vid="ISA 41:17">ገሩ ሆማ ህንአርገተን፤</para>
  <para style="q2" vid="ISA 41:17">አረብንሳኒ ዼቡዻን ጎጎጌረ።</para>
  <para style="q1" vid="ISA 41:17">አን <char style="nd">ዋቀዮ</char> ገሩ ዴቢ ነንኬናፍ፤</para>
  <para style="q2" vid="ISA 41:17">አን ዋቅን እስራኤል ጀረ ህንገቱ።<verse eid="ISA 41:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 41:18"/>ለፈ ኦል ከኣ ቁላረ ለጌን ነንያሰ፤</para>
  <para style="q2" vid="ISA 41:18">ሱሉሎተ ኬሰሞ ቡርቃ ነንቡርቅሲሰ።</para>
  <para style="q1" vid="ISA 41:18">ገሞጂ ሀሮ ብሻኒት፣</para>
  <para style="q2" vid="ISA 41:18">ለፈ ጎጌስ ቡርቃ ብሻኒት ነንጌደረ።<verse eid="ISA 41:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 41:19"/>ገሞጂ ኬሰት</para>
  <para style="q2" vid="ISA 41:19">ጋትራ፣ ላፍቶ፣ ኩሳዬፊ ኤጄርሰ ነንብቅልቸ።</para>
  <para style="q1" vid="ISA 41:19">ለፈ ኦና ኬሰትሞ፣</para>
  <para style="q2" vid="ISA 41:19">ብርብርሰ፣ ቀረሮፊ ሀዼሰ ወል ፋነ ነንዻበ።<verse eid="ISA 41:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 41:20"/>ኩንስ አከ ነሞትን</para>
  <para style="q2" vid="ISA 41:20">አከ ሀርክ <char style="nd">ዋቀዮ</char> ዋን ከነ ሆጄቴ፣</para>
  <para style="q1" vid="ISA 41:20">አከ ቁልቁልች እስራኤል ዋን ከነ ኡሜ አርገኒ ቤከኒፍ፣</para>
  <para style="q2" vid="ISA 41:20">አከሱመስ አከ ሁንድሳኒ ዋን ከነ ቀልቤፈተኒ ሁበተኒፍ።<verse eid="ISA 41:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 41:21"/>“ዽመኬሰን ዽኤፈዻ” ጄዸ <char style="nd">ዋቀዮ</char>፤</para>
  <para style="q2" vid="ISA 41:21">“ረጋኬሰን ፍደዻ” ጄዸ ሞቲን ያቆብ።<verse eid="ISA 41:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 41:22"/>“አከ እሳን ዋን ተኡፍ ጅሩ ኑት ህመኒፍ፣</para>
  <para style="q2" vid="ISA 41:22">ዋቆተኬሰን ቶልፈሞ ፍደዻ።</para>
  <para style="q1" vid="ISA 41:22">አከ ኑ እሳን ሁበትኔ</para>
  <para style="q2" vid="ISA 41:22">ዋን እሳን ዹመረት ተአን ቤክኑፍ፣</para>
  <para style="q1" vid="ISA 41:22">ወንቶትን በረ ዱር ማል አከ ቱረን ኑት ህማ።</para>
  <para style="q2" vid="ISA 41:22">ዮካን ወንቶተ ዹፉፍ ጅረን ኑት ኦዴሳ፤<verse eid="ISA 41:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 41:23"/>አከ ኑ አከ እስን ዋቆተ ታተን ቤክኑፍ፣</para>
  <para style="q2" vid="ISA 41:23">ዋን ፉል ዱረት ተኡፍ ጅሩ ኑት ህማ።</para>
  <para style="q1" vid="ISA 41:23">አከ ኑ ርፈትኔ ሶዳን ጉተምኑፍ፣</para>
  <para style="q2" vid="ISA 41:23">ዋን ጋሪ ዮካን ዋን ሀማ ሆጄዻ።<verse eid="ISA 41:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 41:24"/>ኩኖ እስን ወይቱ ህንሄደምተን፤</para>
  <para style="q2" vid="ISA 41:24">ሆጂንኬሰንስ ጎንኩማ ገቲ ህንቀቡ፤</para>
  <para style="q2" vid="ISA 41:24">ከን እስን ፍለቱ ከምዩ ጅብሲሳዸ።<verse eid="ISA 41:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 41:25"/>“አን ነመ ቶኮ ካባ ነንካሴ፤ እንስ ዹፈ፤</para>
  <para style="q2" vid="ISA 41:25">እን በአ ቢፍቱቲ ዹፉስ መቃኮ ንዋመተ።</para>
  <para style="q1" vid="ISA 41:25">እን አኩመ ሱጴ ዾፍቱን ሱጴ ዽዺቱ ሰነ፣</para>
  <para style="q2" vid="ISA 41:25">ቡልችቶተ አከ ዾቄት ዽዺተ።<verse eid="ISA 41:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 41:26"/>አከ ኑ ቤኩ ደንዴኙፍ</para>
  <para style="q2" vid="ISA 41:26">ኤኙቱ ጀልቀቡማ ካሴ ዋን ከነ ዱበቴ?</para>
  <para style="q1" vid="ISA 41:26">ዮካን አከ ኑ፣ ‘እን ስሪዸ’ ጄቹ ደንዴኙፍ</para>
  <para style="q2" vid="ISA 41:26">ኤኙቱ ዱራን ዱርሴ ዋን ከነ ዱበቴ?</para>
  <para style="q1" vid="ISA 41:26">ኤኙዩ ዋን ከነ ህንህምኔ፤</para>
  <para style="q2" vid="ISA 41:26">ነምን ቶኮዩ ዱራን ዱርሴ ህንህምኔ፤</para>
  <para style="q2" vid="ISA 41:26">ነምን ቶኮዩ ዱቢኬሰን ህንዸጌኜ።<verse eid="ISA 41:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 41:27"/>ነምን ጀልቀበት፣ ‘ኩኖ እሳን አስ ጅሩ!’</para>
  <para style="q2" vid="ISA 41:27">ጄዼ ጥዮንት ህሜ አነ ቱሬ።</para>
  <para style="q2" vid="ISA 41:27">አን ነመ ኦዱ ጋሪ ህሙ ቶኮ ዬሩሳሌሚፍ ኬኔረ።<verse eid="ISA 41:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 41:28"/>አን ነንእላሌ፤ ገሩ ሆምቱ ህንቱሬ፤</para>
  <para style="q2" vid="ISA 41:28">እሳን ኬሳ ነምን ጎርሰ ኬኑ ቶኮዩ ህንጅሩ፤</para>
  <para style="q2" vid="ISA 41:28">ዮሙ አን እሳን ጋፈዹስ ነምን ዴቢ ኬኑ ቶኮዩ ህንጅሩ።<verse eid="ISA 41:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 41:29"/>ኩኖ፣ ሁንድሳኒ ፋይዳ ህንቀበን!</para>
  <para style="q2" vid="ISA 41:29">ሆጂንሳኒስ ገቲ ህንቀቡ፤</para>
  <para style="q2" vid="ISA 41:29">ፈኪወንሳኒስ ቅሌንሱመ ዱዋዸ።<verse eid="ISA 41:29"/></para>
  <chapter eid="ISA 41"/>
  <chapter number="42" style="c" sid="ISA 42"/>
  <para style="s1">ገርብቸ <char style="nd">ዋቀዮ</char></para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 42:1"/>“ተጃጅላንኮ እን አን ኡቱቤ ዻቡ፣</para>
  <para style="q2" vid="ISA 42:1">ፍለተማንኮ ከን አን እት ገመዱ እሰ ከነ፤</para>
  <para style="q1" vid="ISA 42:1">አን ሀፉረኮ እሰረ ነንካአ፤</para>
  <para style="q2" vid="ISA 42:1">እን ሰቦታፍ ሙርቲ ቀጄላ ንኬነ።<verse eid="ISA 42:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 42:2"/>እን ህንወጩ ዮካን ህንዩ፤</para>
  <para style="q2" vid="ISA 42:2">ዮካን ዳንዲረት ሰገሌሳ ህንዸጌስሱ።<verse eid="ISA 42:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 42:3"/>ሸምበቆ ቡሩቄ ህንጨብሱ፤</para>
  <para style="q2" vid="ISA 42:3">ፎኣ እብሳ ከን ሴቁስ ህንዻምሱ።</para>
  <para style="q1" vid="ISA 42:3">እን አመነሙማዻን ሙርቲ ቀጄላ ንፍደ፤<verse eid="ISA 42:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="ISA 42:4"/>ሀመ ሙርቲ ቀጄላ ለፈረት ፍዱት፣</para>
  <para style="q1" vid="ISA 42:4">እን ህንደዸቡ፤ አብዲስ ህንኩተቱ።</para>
  <para style="q2" vid="ISA 42:4">ብዮትን ብሻን ግዱ ሴረሳ ንአብደቱ።”<verse eid="ISA 42:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 42:5"/>
    <char style="nd">ዋቀዮ</char> ዋቅን ሰሚወን ኡሜ ድሪርሴ፣</para>
  <para style="q1" vid="ISA 42:5">እን ለፋፊ ወንቶተ እሼ ኬሰ ጅረን ሁንደ ሆጄቴ፣</para>
  <para style="q2" vid="ISA 42:5">እን ሰበ እሼቲፍ ሀፉረ ባፈተን ኬኔ</para>
  <para style="q2" vid="ISA 42:5">ወረ እሼረ ጅራተኒፍስ</para>
  <para style="q2" vid="ISA 42:5">ጅሬኘ ኬኔ ሱን አከነ ጄዸ፦<verse eid="ISA 42:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 42:6"/>“አን <char style="nd">ዋቀዮ</char> ቀጄሉማዻን ስ ዋሜረ፤</para>
  <para style="q2" vid="ISA 42:6">ሀርከኬስ ነንቀበ።</para>
  <para style="q1" vid="ISA 42:6">አን ስ ኤጌ ሰቦታፍ ከኩ፣</para>
  <para style="q2" vid="ISA 42:6">ነሞተ ኦርማቲፍሞ እፈ ስን ታስሰ፤<verse eid="ISA 42:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 42:7"/>አትስ እጀ ጃሞታ ንበንተ፤</para>
  <para style="q2" vid="ISA 42:7">መነ ህዻቲ ቦጅአምቶተ ንሂክተ፤</para>
  <para style="q2" vid="ISA 42:7">ወረ ዱከነ ኬሰ ጅራተንስ ህዻዻ ንባፍተ።<verse eid="ISA 42:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 42:8"/>“አን <char style="nd">ዋቀዮ</char>፤ መቃንኮስ ከናዸ!</para>
  <para style="q2" vid="ISA 42:8">አን ኡልፍነኮ ከን ብራቲፍ፣</para>
  <para style="q2" vid="ISA 42:8">ገለተኮስ ዋቆተ ቶልፈሞፍ ደበርሴ ህንኬኑ።<verse eid="ISA 42:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 42:9"/>ኩኖ ወን ዱራኒ ራወተሜረ፤</para>
  <para style="q2" vid="ISA 42:9">አንስ ዋን ሃራ ነንዱበዸ፤</para>
  <para style="q1" vid="ISA 42:9">ኡቱ እሳን ህንብቅልን፣</para>
  <para style="q2" vid="ISA 42:9">አን ዋኤሳኒ ስት ነንኦዴሰ።”<verse eid="ISA 42:9"/></para>
  <para style="s1">ፋርፈትና ገለታ</para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 42:10"/>እስን ወር ገላነ ቡተኒፊ ወንቶትን አች ኬሰ ጅራተን ሁንድ፣</para>
  <para style="q2" vid="ISA 42:10">ብዮትን ብሻን ግዱፊ ወር አች ኬሰ ጅራተን ሁንድ፣</para>
  <para style="q1" vid="ISA 42:10">ፋርፈትና ሃራ <char style="nd">ዋቀዮፍ</char> ፋርፈዻ፤</para>
  <para style="q2" vid="ISA 42:10">ሀንዳረ ለፋቲስ ገለተሳ ፋርፈዻ።<verse eid="ISA 42:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 42:11"/>ገሞጂፊ መጋላወንሼ ሰገሌሳኒ ኦል ሃፉዸተን፤</para>
  <para style="q2" vid="ISA 42:11">ገንዶትን ቄዳር ኬሰ ጅራተን ሃገመደን።</para>
  <para style="q1" vid="ISA 42:11">ነሞትን ሴላ ገመቹዻን ሃፋርፈተን፤</para>
  <para style="q2" vid="ISA 42:11">ፊጤ ቱሉወኒራ ሃእየን።<verse eid="ISA 42:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 42:12"/>እሳን <char style="nd">ዋቀዮፍ</char> ኡልፍነ ሃኬነን፤</para>
  <para style="q2" vid="ISA 42:12">ብዮተ ብሻን ግዱ ኬሰትስ ገለተሳ ሃለብሰን።<verse eid="ISA 42:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 42:13"/>
    <char style="nd">ዋቀዮ</char> አከ ነመ ጀባ ቶኮት ንዱለ፤</para>
  <para style="q2" vid="ISA 42:13">አከ ጎተ ቶኮትስ ኦኔሳ ከካሰ፤</para>
  <para style="q1" vid="ISA 42:13">ሰገሌ ኦል ፉዸቴስ ንዻደተ፤</para>
  <para style="q2" vid="ISA 42:13">ዲኖተሳረትስ ኦል ኣንቱማ አርገተ።<verse eid="ISA 42:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 42:14"/>“አን ዬሮ ዼራፍ ጨልእሴረ፤</para>
  <para style="q2" vid="ISA 42:14">አን አፋን ቀበዼ ኦፍ ዾዌረ።</para>
  <para style="q1" vid="ISA 42:14">አመ ገሩ አከ ዱበርቲ ጭኒንሱን ቀቤት ነንእየ፤</para>
  <para style="q2" vid="ISA 42:14">ነንአርገነ፤ ሀፉርስ ነ ጭተ።<verse eid="ISA 42:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 42:15"/>አን ቱሉወኒፊ ጋረን ነንኦንሰ፤</para>
  <para style="q2" vid="ISA 42:15">ብቅልቱወንሳኒ ሁንደስ ነንጎግሰ፤</para>
  <para style="q1" vid="ISA 42:15">አን ለጌን ብዮተ ብሻን ግዱት ነንጌደረ፤</para>
  <para style="q2" vid="ISA 42:15">ሀሮወንስ ነንጎግሰ።<verse eid="ISA 42:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 42:16"/>አን ጃሞተ ከራ እሳን ህንቤክኔረ ነንቀጄልቸ፤</para>
  <para style="q2" vid="ISA 42:16">ዳንዲ ዱራን ህንቤከምንረ ነንዴምስሰ፤</para>
  <para style="q1" vid="ISA 42:16">አን ዱከነ ፉለሳኒ ዱረ ጅሩ እፈት ነንጌደረ፤</para>
  <para style="q2" vid="ISA 42:16">ለፈ ቡኣ በዪስ ወል ነንቅጤሰ።</para>
  <para style="q1" vid="ISA 42:16">ወን አን ሆጄዹ ከኔኒዸ፤</para>
  <para style="q2" vid="ISA 42:16">አን እሳን ህንዺሱ።<verse eid="ISA 42:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 42:17"/>ወር ዋቆተ ቶልፈሞ አመነተን፣</para>
  <para style="q2" vid="ISA 42:17">ከኔን ፈኪወኒን፣ ‘እስን ዋቆተኬኘ’ ጄዸን ገሩ</para>
  <para style="q2" vid="ISA 42:17">ዱበት ዴብኡ፤ ንሰልጰቱስ።<verse eid="ISA 42:17"/></para>
  <para style="s1">እስራኤል ጃማፊ ዱዳዸ</para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 42:18"/>“እስን ዱዶተነነ፣ ዸገኣ፤</para>
  <para style="q2" vid="ISA 42:18">ጃሞተነነ፣ እላላ፤ አርጋስ!<verse eid="ISA 42:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 42:19"/>ተጃጅላኮ መሌ ጃማን ኤኙ?</para>
  <para style="q2" vid="ISA 42:19">ዱዳን አከ ኤርገማ አን ኤርጉ ሰናስ ኤኙ?</para>
  <para style="q1" vid="ISA 42:19">ጃማን አከ ነመ አናፍ ኦፍ ኬኔ፣</para>
  <para style="q2" vid="ISA 42:19">ጃማን አከ ገርብቸ <char style="nd">ዋቀዮ</char> ኤኙ?<verse eid="ISA 42:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 42:20"/>አት ዋን ባይኤ አርግቴ፤ ገሩ ህንቀልቤፈትኔ፤</para>
  <para style="q2" vid="ISA 42:20">ጉርኬ በናዸ፤ ገሩ አት ዋን ቶኮዩ ህንዸጌሱ።”<verse eid="ISA 42:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 42:21"/>ዋኤ ቀጄሉማሳቲፍ ጄዼ</para>
  <para style="q2" vid="ISA 42:21">ሴረሳ ጉድሱፊ ኡልፍነ ቀቤሰ ጎቹን</para>
  <para style="q2" vid="ISA 42:21">
    <char style="nd">ዋቀዮን</char> ገመቺሴረ።<verse eid="ISA 42:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 42:22"/>ሰብን ኩን ገሩ ሰበ ሳመሜ ቦጅአሜዸ፤</para>
  <para style="q2" vid="ISA 42:22">ሁንዲሳኒ ቦለ ኬሰት ክዮዻን ቀበመኒሩ፤</para>
  <para style="q2" vid="ISA 42:22">መነ ህዻ ኬሰስ ዾክፈመኒሩ።</para>
  <para style="q1" vid="ISA 42:22">እሳን ፉዸተመኒሩ፤</para>
  <para style="q2" vid="ISA 42:22">ከን እሳን በራሩስ ህንጅሩ፤</para>
  <para style="q1" vid="ISA 42:22">እሳን ቦጅአመኒሩ፤</para>
  <para style="q2" vid="ISA 42:22">ነምን፣ “እሳን ዴብሳ” ጄዹስ ህንጅሩ።<verse eid="ISA 42:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 42:23"/>እስን ኬሳ ኤኙቱ ዋን ከነ ዸጌፈተ?</para>
  <para style="q2" vid="ISA 42:23">በረ ዹፉፍ ጅሩ ኬሰስ ኤኙቱ ቀልቤፈቴ ዸገአ?<verse eid="ISA 42:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 42:24"/>ኤኙቱ ያቆብን ቦጁፍ፣</para>
  <para style="q2" vid="ISA 42:24">እስራኤልንስ ሳምቶተት ደበርሴ ኬኔ?</para>
  <para style="q1" vid="ISA 42:24">ከን ኑ ጩቡ እት ሆጄትኔ፣ <char style="nd">ዋቀዮ</char> ምቲ?</para>
  <para style="q2" vid="ISA 42:24">እሳን ሰበቢ ከራሳ ዱካ ህንቡኔፍ፣</para>
  <para style="q2" vid="ISA 42:24">ሴረሳቲፍ ህንአጀጀምኔ።<verse eid="ISA 42:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 42:25"/>ከናፉ እን ዼከምሰሳ ቦበኣ ሰነ፣</para>
  <para style="q2" vid="ISA 42:25">ወራነ ሀማስ እሳንት ኤርጌ።</para>
  <para style="q1" vid="ISA 42:25">አረበ እብዳቲን እሳን መርሴ፤ እሳን ገሩ ህንሁበትኔ፤</para>
  <para style="q2" vid="ISA 42:25">እብድ ሱንስ እሳን ጉቤ፤ እሳን ገሩ ህንቀልቤፈትኔ።<verse eid="ISA 42:25"/></para>
  <chapter eid="ISA 42"/>
  <chapter number="43" style="c" sid="ISA 43"/>
  <para style="s1">ፈይሳ እስራኤል ቶክቸ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 43:1"/>አመ ገሩ ያ ያቆብ፣ <char style="nd">ዋቀዮ</char> እን ስ ኡሜ፣</para>
  <para style="q2" vid="ISA 43:1">ያ እስራኤል፣ እን ስ ቶልቼ አከነ ጄዸ፦</para>
  <para style="q1" vid="ISA 43:1">“አን ስ ፉሬራቲ ህንሶዳትን፤</para>
  <para style="q2" vid="ISA 43:1">አን መቃኬቲን ስ ዋሜረ፤ አት ከንኮት።<verse eid="ISA 43:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 43:2"/>ዮሙ አት ብሻን ኬሰ ደበርቱ፣</para>
  <para style="q2" vid="ISA 43:2">አን ስ ወጅነን ጅረ፤</para>
  <para style="q2" vid="ISA 43:2">ዮሙ አት ለጌን ጬቱስ፣ እሳን ስ ህንልቅምሰን።</para>
  <para style="q1" vid="ISA 43:2">ዮሙ እብደ ኬሰ ዴምቱ፣</para>
  <para style="q2" vid="ISA 43:2">አት ህንጉበቱ፤</para>
  <para style="q2" vid="ISA 43:2">አረብን እብዳስ ስ ህንጉቡ።<verse eid="ISA 43:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 43:3"/>አን <char style="nd">ዋቀዮ</char> ዋቅንኬ፣</para>
  <para style="q2" vid="ISA 43:3">ቁልቁልች እስራኤል ፈይሳ ኬት፤</para>
  <para style="q1" vid="ISA 43:3">አን ብየ ግብጥ ፉሪኬቲፍ፣</para>
  <para style="q2" vid="ISA 43:3">ቆደ ኬሞ ኩሺፊ ሳባ ነንኬነ።<verse eid="ISA 43:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 43:4"/>ዋን አት እጀኮ ዱረት ጃለተማፊ ከበጀማ ታቴፍ፣</para>
  <para style="q2" vid="ISA 43:4">አንስ ዋነን ስጃለዹፍ፣</para>
  <para style="q1" vid="ISA 43:4">ቆደኬ ነሞተ</para>
  <para style="q2" vid="ISA 43:4">ቆደ ሉቡኬቲሞ ሰቦተ ነንኬነ።<verse eid="ISA 43:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 43:5"/>አን ስ ወጅነን ጅራቲ ህንሶዳትን፤</para>
  <para style="q2" vid="ISA 43:5">አን እጆሌኬ በአ ቢፍቱቲ ነንፍደ፤</para>
  <para style="q2" vid="ISA 43:5">ልጠ ቢፍቱቲስ ወልት ስን ቀበ።<verse eid="ISA 43:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 43:6"/>አን ካባን፣ ‘እሳን ገድ ዺስ!’</para>
  <para style="q2" vid="ISA 43:6">ክባንሞ ‘እሳን ህንዾውን’ ነንጄዸ።</para>
  <para style="q1" vid="ISA 43:6">እልማንኮ ፈጎዻ፣</para>
  <para style="q2" vid="ISA 43:6">እንተለንኮሞ ሀንዳረ ለፋቲ ፍድ፤<verse eid="ISA 43:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 43:7"/>ከን መቃኮቲን ዋመሜ ሁንደ፣</para>
  <para style="q2" vid="ISA 43:7">ከኔን አን ኡልፍነኮቲፍ ኡሜ፣</para>
  <para style="q2" vid="ISA 43:7">ወረ አን ቶልቼፊ ሆጄዼ ሰነ ፍዳ።”<verse eid="ISA 43:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 43:8"/>ወረ ኡቱ እጀ ቀበኑ ጃመኒ</para>
  <para style="q2" vid="ISA 43:8">ኡቱ ጉረ ቀበኑ ዱደን ገድ ባስ።<verse eid="ISA 43:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 43:9"/>ሰብን ሁንድ ቶኩማዻን ወልት ሃቀበሙ፤</para>
  <para style="q2" vid="ISA 43:9">ነሞትንስ ወል ሃገአን።</para>
  <para style="q1" vid="ISA 43:9">እሳን ኬሳ ነምን ዱራን ዱርሴ ዋን ከነ ኑት ህሜ</para>
  <para style="q2" vid="ISA 43:9">ወንቶተ ዱራስ ኑፍ ለብሴ ኤኙ?</para>
  <para style="q1" vid="ISA 43:9">አከ ወር ካን ዸገአኒ፣ “ኩን ዹጋዸ” ጄዸኒፍ፣</para>
  <para style="q2" vid="ISA 43:9">አከ ዹጋ ቀቤዪ ተኡንሳኒ ምርከኔፈሙፍ</para>
  <para style="q2" vid="ISA 43:9">እሳን ዹገ ባቶተሳኒ ሃዽኤፈተን።<verse eid="ISA 43:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 43:10"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፤</para>
  <para style="q2" vid="ISA 43:10">“አከ እስን ቤክተኒ ነ አመንተኒፍ</para>
  <para style="q1" vid="ISA 43:10">አከ አን እሰ ተኤስ አከ ሁበተኒፍ</para>
  <para style="q2" vid="ISA 43:10">እስን ዹገ ባቶተኮ፣ ገርብቸኮ ከን አን ፍለዼዸ።</para>
  <para style="q1" vid="ISA 43:10">አናን ዱረ ዋቅን ህንሆጄተምኔ፤</para>
  <para style="q2" vid="ISA 43:10">አናን ቦዴስ ህንጅራቱ።<verse eid="ISA 43:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 43:11"/>አነ፣ አኑመ ቆፈቱ <char style="nd">ዋቀዮ</char>፤</para>
  <para style="q2" vid="ISA 43:11">አነ መሌስ ፈይሳን ብራ ህንጅሩ።<verse eid="ISA 43:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 43:12"/>አን ሙልእሴረ፤ ፈይሴረ፤ ለብሴረስ፤</para>
  <para style="q2" vid="ISA 43:12">አነ መሌ ዋቅን ኦርማ ግዱኬሰን ህንቱሬ።</para>
  <para style="q1" vid="ISA 43:12">አከ አን ዋቀ ተኤ፣ እስን ዹገ ባቶተኮት” <optbreak/> ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="ISA 43:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="ISA 43:13"/>“በረ ዱሪቲ ጀልቀቤ አን እሱመ።</para>
  <para style="q1" vid="ISA 43:13">ነምን ቶኮዩ ሀርከኮቲ ዋ ባሱ ህንደንደኡ።</para>
  <para style="q2" vid="ISA 43:13">አን ነንሆጄዸ፤ ኤኙቱ ዾዉ ደንደአ?”<verse eid="ISA 43:13"/></para>
  <para style="s1">አራረ ዋቃቲፊ አመነሙማ ዸቡ እስራኤል</para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 43:14"/>
    <char style="nd">ዋቀዮ</char> ፉሪንኬ፣</para>
  <para style="q2" vid="ISA 43:14">ቁልቁልች እስራኤል አከነ ጄዸ፦</para>
  <para style="q1" vid="ISA 43:14">“አን እስኒፍ ጄዼ ባብሎንት ሎልቶተ ኤርጌ</para>
  <para style="q2" vid="ISA 43:14">ዶኒወን እሳን እቲን ቦነኒን</para>
  <para style="q2" vid="ISA 43:14">ነሞተ ባብሎን ሁንደ ቦጅኤ ነንፍደ።<verse eid="ISA 43:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 43:15"/>አን <char style="nd">ዋቀዮ</char>፣ ቁልቁልቸኬሰን፣</para>
  <para style="q2" vid="ISA 43:15">ኡማ እስራኤል፣ ሞቲኬሰኒዸ።”<verse eid="ISA 43:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 43:16"/>
    <char style="nd">ዋቀዮ</char> እን፣ ገላነ ኬሳን ከራ፣</para>
  <para style="q2" vid="ISA 43:16">ብሻኖተ ጀጀቦ ኬሳንሞ ዳንዲ ቶልቼ አከነ ጄዸ፤<verse eid="ISA 43:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 43:17"/>እን ጋሪወኒፊ ፈርዴን፣ ሎልቶታፊ ገርጋርቶተሳኒ</para>
  <para style="q2" vid="ISA 43:17">ቶኩማዻን አርኤ ባሴ አከነ ጄዸ፤</para>
  <para style="q1" vid="ISA 43:17">እሳን አቹመ ጭጪሱ፤ ለመተስ ህንከአን፤</para>
  <para style="q2" vid="ISA 43:17">አኩመ ፎኣ እብሳትስ ዻመኒ በዱ፤<verse eid="ISA 43:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 43:18"/>“ወንቶተ ዱሪ እራንፈዻ፤</para>
  <para style="q2" vid="ISA 43:18">ዋን ደርቤትስ ህንጭችና።<verse eid="ISA 43:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 43:19"/>ኩኖ፣ አን ዋን ሃራ ቶኮ ነንሆጄዻ!</para>
  <para style="q2" vid="ISA 43:19">እንስ አመ ንብቅለ፤ እስን ህንሁበተኒ?</para>
  <para style="q1" vid="ISA 43:19">አን ገሞጂ ኬሰት ከራ ነንቆጴሰ፤</para>
  <para style="q2" vid="ISA 43:19">ለፈ ኦና ኬሰትስ ቡርቃ ነንቡርቅሲሰ።<verse eid="ISA 43:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 43:20"/>ብኔንሶትን ቦሶና፣</para>
  <para style="q2" vid="ISA 43:20">ዋንጎወኒፊ ጉቺወን ኡልፍነ ናፍ ኬኑ፤</para>
  <para style="q1" vid="ISA 43:20">አከ ሰብንኮ ከን አን ፍለዼ ዹጉፍ፣</para>
  <para style="q2" vid="ISA 43:20">አን ገሞጂ ኬሰት ብሻን፣</para>
  <para style="q2" vid="ISA 43:20">ለፈ ኦና ኬሰትስ ቡርቃ ነንኬናቲ፤<verse eid="ISA 43:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 43:21"/>ሰብን አን ኦፊኮቲፍ ፍለዼ</para>
  <para style="q2" vid="ISA 43:21">አከ ነ ገለቴፈቱፍ ቱሬ።<verse eid="ISA 43:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 43:22"/>“ያ ያቆብ፣ አት ገሩ ነ ህንዋመትኔ፤</para>
  <para style="q2" vid="ISA 43:22">ያ እስራኤል፣ አት ፉለኮ ዱረት ደዸብዴርተ።<verse eid="ISA 43:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 43:23"/>አት ኣርሳ ጉበሙፊ ሆሎተ ናፍ ህንፍድኔ፤</para>
  <para style="q2" vid="ISA 43:23">ዮካን ኣርሳኬቲን ኡልፍነ ናፍ ህንኬንኔ።</para>
  <para style="q1" vid="ISA 43:23">አን ኣርሳ ምዻኒቲን ስ ህንረክፍኔ፤</para>
  <para style="q2" vid="ISA 43:23">ዮካን ኣርሳ እጣና ጋፈቹዻን ስ ህንደዸብሲፍኔ።<verse eid="ISA 43:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 43:24"/>አት ቁንዺ ኡርጋ ጋሪ ቀቡ ና ህንብትኔ፤</para>
  <para style="q2" vid="ISA 43:24">ዮካን ጮመ ቀልመኬቲቲን ነ ህንቁብስኔ።</para>
  <para style="q1" vid="ISA 43:24">ገሩ በኣ ጩቡኬቲ ነት ፌቴ፤</para>
  <para style="q2" vid="ISA 43:24">የከኬቲንስ ነ ደዸብሲፍቴ።<verse eid="ISA 43:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 43:25"/>“ከን ኦፊኮቲፍ ጄዼ የከኬ ስራ ሀቄ</para>
  <para style="q2" vid="ISA 43:25">ጩቡኬስ ዴብኤ ህንያደትኔ፣ አን አኑመ።<verse eid="ISA 43:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 43:26"/>ሜ ዋን ደርቤረ ና ዴብእ፤</para>
  <para style="q2" vid="ISA 43:26">ወልት ዹፍኔ ዱቢ ከነረት ሃፈልምኑ፤</para>
  <para style="q2" vid="ISA 43:26">ዱቢኬ ዽኤፈዹቲ ቀጄላ ተኡኬ ምርከኔፈዹ።<verse eid="ISA 43:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 43:27"/>አባንኬ ከን ጀልቀባ ጩቡ ሆጄቴ፤</para>
  <para style="q2" vid="ISA 43:27">በርሲስቶትንኬ ነት ፍንጭለን።<verse eid="ISA 43:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 43:28"/>ከናፉ አን እት ጋፈተምቶተ <optbreak/> መነ ቁልቁሉማኬቲ ነንሰልጵሰ፤</para>
  <para style="q2" vid="ISA 43:28">ያቆብን በዲሳፍ፣</para>
  <para style="q2" vid="ISA 43:28">እስራኤልንሞ ቱፊፍ ደበርሴ ነንኬነ።<verse eid="ISA 43:28"/></para>
  <chapter eid="ISA 43"/>
  <chapter number="44" style="c" sid="ISA 44"/>
  <para style="s1">እስራኤል ሰበ ፍለተማ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 44:1"/>“አመ ገሩ ያ ያቆብ ገርብቸኮ፣</para>
  <para style="q2" vid="ISA 44:1">ያ እስራኤል ከን አን ስ ፍለዼ፣ ዸጌፈዹ።<verse eid="ISA 44:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 44:2"/>
    <char style="nd">ዋቀዮ</char> እን ስ ኡሜ፣</para>
  <para style="q2" vid="ISA 44:2">ከን ገደሜሰ ኬሰት ስ ቶልቼ፣</para>
  <para style="q2" vid="ISA 44:2">እን ስ ገርጋሩ ሱን አከነ ጄዸ፦</para>
  <para style="q1" vid="ISA 44:2">ያ ገርብቸኮ ያቆብ፣</para>
  <para style="q2" vid="ISA 44:2">ያ ይሹሩን ከን አን ስ ፍለዼ ህንሶዳትን።<verse eid="ISA 44:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 44:3"/>አን ለፈ ዼቦቴረት ብሻን፣</para>
  <para style="q2" vid="ISA 44:3">ለፈ ጎጋረት ቡርቃ ነንዸንገላሳቲ፤</para>
  <para style="q1" vid="ISA 44:3">አን እጆሌኬረት ሀፉረኮ፣</para>
  <para style="q2" vid="ISA 44:3">ሰኚኬረትሞ ኤበኮ ነንዸንገላሰ።<verse eid="ISA 44:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 44:4"/>እሳን አኩመ መርገ ብሻን ግዱቲፊ</para>
  <para style="q2" vid="ISA 44:4">አከ ሙከ አለልቱ ከን ቀርቀረ ለጋ ጅሩት ንለልሱ።<verse eid="ISA 44:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 44:5"/>ነምን ቶኮ፣ ‘አን ከን <char style="nd">ዋቀዮት</char>’ ኦፊን ጄዸ፤</para>
  <para style="q2" vid="ISA 44:5">ከን ብራ መቃ ያቆቢን ኦፍ ዋመ፤</para>
  <para style="q1" vid="ISA 44:5">ካንሞ ሀርከሳረት፣ ‘አን ከን <char style="nd">ዋቀዮት</char>’ <optbreak/> ጄዼ በሬፈተ፤</para>
  <para style="q2" vid="ISA 44:5">መቃ እስራኤሊንስ ኦፍ ዋመ።<verse eid="ISA 44:5"/></para>
  <para style="s1">
    <char style="nd">ዋቀዮ</char> ቶክቹመ</para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 44:6"/>“<char style="nd">ዋቀዮ</char> ሞቲፊ ፉሪን እስራኤል</para>
  <para style="q2" vid="ISA 44:6">
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ አከነ ጄዸ፦</para>
  <para style="q1" vid="ISA 44:6">አን ከን ጀልቀባት፤ አን ከን ዹማትስ፤</para>
  <para style="q2" vid="ISA 44:6">አነ መሌ ዋቅን ብራ ህንጅሩ።<verse eid="ISA 44:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 44:7"/>ዮስ ከን አከኮ ኤኙ? ሜ እን ሀፉረ ሃባፈቱ።</para>
  <para style="q2" vid="ISA 44:7">እን ዋን ኤርገ አን ሰበኮ ከን ዱሪ ሁንዴሴ አስ ተኤ፣</para>
  <para style="q1" vid="ISA 44:7">ዋን ሀመ አማት ህንተእን ሃዱበቱ፤</para>
  <para style="q2" vid="ISA 44:7">ፉለኮ ዱረትስ ሃእብሱ፤</para>
  <para style="q2" vid="ISA 44:7">ዋን ገረ ፉልዱራት ተኡሌ ዱራን ዱርሴ ሃህሙ።<verse eid="ISA 44:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 44:8"/>ህንርፈትና፤ ህንሶዳትና።</para>
  <para style="q2" vid="ISA 44:8">አን ዋን ከነ ለብሴ በረ ዼራን ዱረ ስት ህንህምኔ?</para>
  <para style="q1" vid="ISA 44:8">እስን ዹገ ባቶተኮት። አነ መሌ ዋቅን ብራ ጅራ?</para>
  <para style="q2" vid="ISA 44:8">ለኪ፣ ከታን ብራ ህንጅሩ፤ አን ቶኮዩ ህንቤኩ።”<verse eid="ISA 44:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 44:9"/>ወር ዋቆተ ቶልፈሞ ቶልቸን ሁንድ ገቲ ህንቀበን፤</para>
  <para style="q2" vid="ISA 44:9">ወን እሳን ሀወን ፋይዳ ህንቀቡ።</para>
  <para style="q1" vid="ISA 44:9">ወር እሳኒፍ ፈልመንስ ጃሞተ፤</para>
  <para style="q2" vid="ISA 44:9">እሳን ቤኩምሰ ህንቀበን፤ ከናፉ ንቃኔፈሙ።<verse eid="ISA 44:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 44:10"/>ኤኙቱ ዋቀ ቶልፈማፊ</para>
  <para style="q2" vid="ISA 44:10">ፈኪ ሆማ እሰ ህንፈየድኔ ቶልቸ?<verse eid="ISA 44:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 44:11"/>እሳፊ ነምን አከሳ ንቃኔፈመ፤</para>
  <para style="q2" vid="ISA 44:11">ኦጌዪን ሆጂ ሀርካስ ነሞቱመ መሌ ሆማ ምት።</para>
  <para style="q1" vid="ISA 44:11">እሳን ሁንድ ወልት ቀበመኒ እዶ ቶኮ ሃዻበተን፤</para>
  <para style="q2" vid="ISA 44:11">እሳን ንነኡ፤ ንሰልጰቱስ።<verse eid="ISA 44:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 44:12"/>ቱምቱን ሜሻ እቲን ዋ ቱሙ ሀርከት ቀበቴ</para>
  <para style="q2" vid="ISA 44:12">ጭሌ ቦበኡረት እቲን ሆጄተ፤</para>
  <para style="q1" vid="ISA 44:12">እን ቡሩሳን ዋቀ ቶልፈማ ቶልቸ፤</para>
  <para style="q2" vid="ISA 44:12">እሬሳ ጀባዻንስ ንሚዸግሰ።</para>
  <para style="q1" vid="ISA 44:12">እን ንቤለአ፤ ሁምነስ ንዸበ፤</para>
  <para style="q2" vid="ISA 44:12">ብሻን ህንዹጉ፤ ንገገበስ።<verse eid="ISA 44:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 44:13"/>ነምን ሙከ ሶፉ ፉኞዻን ሰፈረ</para>
  <para style="q2" vid="ISA 44:13">ጭላቲዻን መለቶ እት ጎዸ፤</para>
  <para style="q1" vid="ISA 44:13">ቅርጢዻን ቅሪጤ</para>
  <para style="q2" vid="ISA 44:13">ሰፈርቱዻን መለቶ እት ጎዸ።</para>
  <para style="q1" vid="ISA 44:13">ፈኪ ነማቲን ሆጄተ፤</para>
  <para style="q2" vid="ISA 44:13">አከ እን ገልመ ዋቄፈትና ኬሰ ጅራቱፍስ</para>
  <para style="q2" vid="ISA 44:13">ሚዸግነ ነማ እት ቶልቸ።<verse eid="ISA 44:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 44:14"/>እን ብርብርሰ ሙረ፤</para>
  <para style="q2" vid="ISA 44:14">ጋትራ ዮካን ቅልጡ ፍለተ።</para>
  <para style="q1" vid="ISA 44:14">አከ እን ሙኬን ቦሶና ኬሰት ጉደቱፍ ንዺሰ፤</para>
  <para style="q2" vid="ISA 44:14">ዮካን ሀዼሰ ዻበ፤ ቦካንስ እሰ ጉድሰ።<verse eid="ISA 44:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 44:15"/>ሙክን ሱን ቆራን ቦቤፈሙ ተአ፤</para>
  <para style="q2" vid="ISA 44:15">ነምን ሙራሰሳ ፉዸቴ ቦቤሴ ቀቃመተ፤</para>
  <para style="q2" vid="ISA 44:15">እብደ ቀብሲሴ ቡዴነ እቲን ቶልፈተ።</para>
  <para style="q1" vid="ISA 44:15">ዋቀ ሶባስ ቶልፈቴ ዋቄፈተ፤</para>
  <para style="q2" vid="ISA 44:15">ዋቀ ቶልፈማስ ቶልፈቴ ገድ ጄዼ ሰገዳፍ።<verse eid="ISA 44:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 44:16"/>ገርቶኬ ሙኬን ሰና ንቦቤሰ፤</para>
  <para style="q2" vid="ISA 44:16">እሰረት ኛተ ብልቼፈተ፤</para>
  <para style="q2" vid="ISA 44:16">ፎንስ እረት ዋደቴ ሀመ ቁፉት ኛተ።</para>
  <para style="q1" vid="ISA 44:16">እብደ ቀቃመቻስ፣</para>
  <para style="q2" vid="ISA 44:16">“እሾ! እብድ ነት ሆኤ፤ እብደ ነንአርገ” ጄዸ።<verse eid="ISA 44:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 44:17"/>ሙኬን ሀፈኒንሞ ዋቀ ሶባ፣ <optbreak/> ዋቀሳ ቶልፈማ ቶልፈተ፤</para>
  <para style="q2" vid="ISA 44:17">ገድ ጄዼስ ንሰገዳፍ።</para>
  <para style="q1" vid="ISA 44:17">እሰ ከዸቴስ፣</para>
  <para style="q2" vid="ISA 44:17">“ስቱ ዋቀኮት፤ ነ በራር” ጄዻን።<verse eid="ISA 44:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 44:18"/>እሳን ሆማ ህንቤከን፤ ሆማ ህንሁበተንስ፤</para>
  <para style="q2" vid="ISA 44:18">አከ አርጉ ህንደንዴኜፍ እጅሳኒ ሀጉገሜረ፤</para>
  <para style="q2" vid="ISA 44:18">አከ ህንሁበኔፍስ ቀልቢንሳኒ ጩፈሜረ።<verse eid="ISA 44:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 44:19"/>ነምን ቶኮዩ እት ህንያዱ፤</para>
  <para style="q2" vid="ISA 44:19">ነምን ቶኮዩ አከነ ጄቹፍ ቤኩምሰ <optbreak/> ዮካን ሁበትና ህንቀቡ፤</para>
  <para style="q1" vid="ISA 44:19">“አን ወለካሳ ቆራን ጎዸዼረ፤</para>
  <para style="q2" vid="ISA 44:19">ጭሌሳረት ቡዴነ ቶልፈዼ</para>
  <para style="q2" vid="ISA 44:19">ፎን እቲን ዋደዼ ኛዼረ።</para>
  <para style="q1" vid="ISA 44:19">አን አመ ዋን ሀፌ ከናን ዋን ጅብሲሳ ነንሆጄዻ?</para>
  <para style="q2" vid="ISA 44:19">አን ገድ ጄዼ ጅርማፍ ሰገዱ ቀባ?”<verse eid="ISA 44:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 44:20"/>እን ዳራ ኛተ፤ ገራን ጎዎምፈሜስ ከራራ እሰ ጀልእሴረ፤</para>
  <para style="q2" vid="ISA 44:20">እን ኦፍ ኦልቹ ዮካን፣</para>
  <para style="q2" vid="ISA 44:20">“ወን ሀርከኮ ምርጋ ኬሰ ጅሩ ኩን ሶበ ምቲ?” <optbreak/> ጄቹ ህንደንደኡ።<verse eid="ISA 44:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 44:21"/>“ያ ያቆብ፣ አት ዋን ከነ ያደዹ፤</para>
  <para style="q2" vid="ISA 44:21">ያ እስራኤል፣ አት ገርብቸኮት።</para>
  <para style="q1" vid="ISA 44:21">አን ስ ቶልቼረ፤ አትስ ገርብቸኮት፤</para>
  <para style="q2" vid="ISA 44:21">ያ እስራኤል፣ አን ስ ህንደገዹ።<verse eid="ISA 44:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 44:22"/>አን የከኬ አኩመ ዱሜሳ፣</para>
  <para style="q2" vid="ISA 44:22">ጩቡኬስ አኩመ ሁሪ ገነማ ሀጣኤ በሌሴረ።</para>
  <para style="q1" vid="ISA 44:22">አን ስ ፉሬራቲ፣</para>
  <para style="q2" vid="ISA 44:22">አት ገረኮት ዴብእ።”<verse eid="ISA 44:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 44:23"/>ያ ሰሚወን፣ <char style="nd">ዋቀዮ</char> ዋን ከነ ጎዼራቲ <optbreak/> ገመቹዻን ፋርፈዻ፤</para>
  <para style="q2" vid="ISA 44:23">ያ ቅሌወን ለፋ፣ ገመቹዻን እያ።</para>
  <para style="q1" vid="ISA 44:23">እስን ያ ቱሉወን፣ ቦሶኖትኒፊ ሙኬንኬሰን ሁንድ እልልቻ፤</para>
  <para style="q2" vid="ISA 44:23">
    <char style="nd">ዋቀዮ</char> ያቆብን ፉሬ እስራኤል ኬሰት ኡልፍነሳ እብሴራቲ።<verse eid="ISA 44:23"/></para>
  <para style="s1">ዬሩሳሌም ለፈ ጅሬኛ ንታት</para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 44:24"/>“<char style="nd">ዋቀዮ</char> ፉሪንኬ፣</para>
  <para style="q2" vid="ISA 44:24">ከን ገደሜሰ ኬሰት ስ ቶልቼ አከነ ጄዸ፦</para>
  <para style="b" vid="ISA 44:24"/>
  <para style="q1" vid="ISA 44:24">አን <char style="nd">ዋቀዮ</char> ቶልቻን ዋን ሁንዳ</para>
  <para style="q2" vid="ISA 44:24">እሰ ሰሚወን ድሪርሴ፣</para>
  <para style="q2" vid="ISA 44:24">እሰ ኦፉመኮቲን ለፈሌ ድሪርሴዸ፤<verse eid="ISA 44:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 44:25"/>እሰ መለቶ ራጆተ ሶባ</para>
  <para style="q2" vid="ISA 44:25">ቡሼሴ እላልቶተ ራቴሱ፣</para>
  <para style="q1" vid="ISA 44:25">እሰ ኦጌዪ ዱበት ዴብሴ</para>
  <para style="q2" vid="ISA 44:25">ቤኩምሰሳኒ ፋይዳ ዸብሲሱዸ፤<verse eid="ISA 44:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 44:26"/>እሰ ዱቢ ገርቦተሳ ምርከኔሴ</para>
  <para style="q2" vid="ISA 44:26">ራጂ ኤርገሞተሳ ፊጣን ባሱ፣</para>
  <para style="b" vid="ISA 44:26"/>
  <para style="q1" vid="ISA 44:26">እሰ፣ ‘እሼን እዶ ጅሬኛ ንታት’ ጄዼ</para>
  <para style="q2" vid="ISA 44:26">ዋኤ ዬሩሳሌም ዱበቴ፣ እሰ፣ ‘እሳን ንእጃረሙ፣</para>
  <para style="q2" vid="ISA 44:26">ዲገማሳኒስ ነንሃሮምሰ’ ጄዼ</para>
  <para style="q2" vid="ISA 44:26">ዋኤ መጋላወን ይሁዳ ዱበቱዸ፤<verse eid="ISA 44:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 44:27"/>እሰ ቱጁባን፣ ‘አት ጎግ፤</para>
  <para style="q2" vid="ISA 44:27">አን ለጌንኬ ነንጎግሰ’ ጄዹ፣<verse eid="ISA 44:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 44:28"/>እሰ ቂሮስን፣ ‘እን ትክሴኮት፤</para>
  <para style="q2" vid="ISA 44:28">ፌዺኮ ሁንደስ ንራወተ፤</para>
  <para style="q2" vid="ISA 44:28">እን ዋኤ ዬሩሳሌም፣ “እሼን ዴብፈምቴ ሃእጃረምቱ”</para>
  <para style="q1" vid="ISA 44:28">ዋኤ መነ ቁልቁሉማሞ፣ “ሁንዴንሳ ሃሁንዴፈሙ”</para>
  <para style="q2" vid="ISA 44:28">ጄዼ ዱበቱ ሱን አኑመ።’<verse eid="ISA 44:28"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 44"/>
  <chapter number="45" style="c" sid="ISA 45"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 45:1"/>“<char style="nd">ዋቀዮ</char> ድበማሳ ቂሮስ፣</para>
  <para style="q2" vid="ISA 45:1">ከን አን ሰቦተ እሰ ጀለት ቡልቹፊ</para>
  <para style="q1" vid="ISA 45:1">ህዸትና ሞቶታ ሂክስሱፍ ጄዼ</para>
  <para style="q2" vid="ISA 45:1">ሀርከሳ ምርጋ ቀቤ</para>
  <para style="q1" vid="ISA 45:1">አከ ከረወን ህንጩፈምኔፍ፣</para>
  <para style="q2" vid="ISA 45:1">በልበለወን በኑፍ ሰናን አከነ ጄዸ፦<verse eid="ISA 45:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 45:2"/>አን ፉለኬ ዱረ ዴሜ</para>
  <para style="q2" vid="ISA 45:2">ቱሉወን ወል ነንቅጤሰ፤</para>
  <para style="q1" vid="ISA 45:2">ከረወን ናሲ ነንጨጨብሰ፤</para>
  <para style="q2" vid="ISA 45:2">ደንቀራወን ስቢላስ ነንኩኩተ።<verse eid="ISA 45:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 45:3"/>አት አከ አን <char style="nd">ዋቀዮ</char></para>
  <para style="q2" vid="ISA 45:3">ዋቀ እስራኤል እሰ መቃኬቲን ስ ዋሙ ተኤ አከ ቤክቱፍ፣</para>
  <para style="q1" vid="ISA 45:3">አን በዻዹማ ዱከነ ኬሳ፣</para>
  <para style="q2" vid="ISA 45:3">ቀቤኘ ለፈ ዾክሳት ኩፈሜስ ሲፍ ነንኬነ።<verse eid="ISA 45:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 45:4"/>አት ነ ቤኩ ባቱዩ፣</para>
  <para style="q2" vid="ISA 45:4">አን ገርብቸኮ ያቆቢፍ፣</para>
  <para style="q1" vid="ISA 45:4">እስራኤል ፍለተማኮቲፍ ጄዼ</para>
  <para style="q2" vid="ISA 45:4">መቃኬቲን ስ ዋሜረ፤</para>
  <para style="q2" vid="ISA 45:4">መቃ ኡልፍናስ ሲፍ ኬኔረ።<verse eid="ISA 45:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 45:5"/>አን <char style="nd">ዋቀዮ</char>፤ አነ መሌ ከን ብራ ህንጅሩ፤</para>
  <para style="q2" vid="ISA 45:5">አነ መሌ ዋቅን ቶኮዩ ህንጅሩ።</para>
  <para style="q2" vid="ISA 45:5">አት ነ ቤኩ ባቱዩ፣ አን ስን ጀቤሰ፤<verse eid="ISA 45:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 45:6"/>ኩንስ አከ ነሞትን በአ ቢፍቱቲ ሀመ ልጠ ቢፍቱት፣</para>
  <para style="q2" vid="ISA 45:6">አነ መሌ ከን ብራ አከ ህንጅሬ ቤከኒፍ።</para>
  <para style="q1" vid="ISA 45:6">አን <char style="nd">ዋቀዮ</char>፤ አነ መሌ</para>
  <para style="q2" vid="ISA 45:6">ቶኮዩ ህንጅሩ።<verse eid="ISA 45:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 45:7"/>አን እፈ ነንቶልቸ፤ ዱከነስ ነንኡመ፤</para>
  <para style="q2" vid="ISA 45:7">በዻዹማ ነንፍደ፤ በላስ ነንኡመ፤</para>
  <para style="q2" vid="ISA 45:7">አን <char style="nd">ዋቀዮ</char> ወንቶተ ከኔን ሁንደ ነንጎዸ።<verse eid="ISA 45:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 45:8"/>“ያ ሰሚወን፣ እስን ኦል ጉባዻ ቀጄሉማ ሮብሳ፤</para>
  <para style="q2" vid="ISA 45:8">ዱሜሶንስ ገድ ጮጮብሳ።</para>
  <para style="q1" vid="ISA 45:8">ለፍት ሃበነምቱ፤</para>
  <para style="q2" vid="ISA 45:8">ፈይን ሃብቅሉ፤</para>
  <para style="q1" vid="ISA 45:8">ቀጄሉማንስ እሰ ወጅን ሃጉደቱ፤</para>
  <para style="q2" vid="ISA 45:8">አን <char style="nd">ዋቀዮ</char> ዋን ከነ ኡሜረ።<verse eid="ISA 45:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 45:9"/>“ቅራጪ ቅራጪዹመ ለፋ ተኤ</para>
  <para style="q2" vid="ISA 45:9">ኡማሳቲን ወል ሎሉፍ ወዮ።</para>
  <para style="q1" vid="ISA 45:9">ሱጴን፣ ሱጴ ዾፍቱዻን፣</para>
  <para style="q2" vid="ISA 45:9">‘አት ማል ሆጄቻ ጅርተ?’ ጄዻ?</para>
  <para style="q1" vid="ISA 45:9">ሆጂን አት ሆጄቱስ፣</para>
  <para style="q2" vid="ISA 45:9">‘እን ሀርከ ህንቀቡ’ ሲን ጄዻ?<verse eid="ISA 45:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 45:10"/>ነመ አባዻን፣ ‘አት ማል ዸልችቴ?’</para>
  <para style="q2" vid="ISA 45:10">ዮካን ሃዻን፣ ‘አት ማል ዴሴ?’ ጄዹፍ ወዮ።<verse eid="ISA 45:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 45:11"/>“<char style="nd">ዋቀዮ</char>፣ ቁልቁልች እስራኤል</para>
  <para style="q2" vid="ISA 45:11">ኡማንሼ ሱን አከነ ጄዸ፦</para>
  <para style="q1" vid="ISA 45:11">እስን ዋኤ ወንቶተ ዹፉፍ ጅረኒ ጄቹንስ፣</para>
  <para style="q2" vid="ISA 45:11">‘ዋኤ እጆሌኮ ነ ጋፈዻ፤</para>
  <para style="q2" vid="ISA 45:11">ዮካን ዋኤ ሆጂ ሀርከኮ ነ አጀጃ።’<verse eid="ISA 45:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 45:12"/>ከን ለፈ ቶልቼ ነመስሼረት ኡሜ አነ።</para>
  <para style="q2" vid="ISA 45:12">ሀርክኮ ሰሚወን ድሪርሴረ፤</para>
  <para style="q2" vid="ISA 45:12">ራያሳኒ ሁንደስ አጀጄረ።<verse eid="ISA 45:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 45:13"/>አን ቀጄሉማኮቲን ቂሮስን ኦል ነንካሰ፦</para>
  <para style="q2" vid="ISA 45:13">ከራሳ ሁንደስ ወል ነንቅጤሰ።</para>
  <para style="q1" vid="ISA 45:13">እን መጋላኮ ዴብሴ እጃረ፤</para>
  <para style="q2" vid="ISA 45:13">ቦጅአምቶተኮስ ብልሰ ባሰ፤</para>
  <para style="q1" vid="ISA 45:13">ገሩ ገቲዻን ዮካን በዻሳን ምት፣</para>
  <para style="q2" vid="ISA 45:13">ጄዸ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ።”<verse eid="ISA 45:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 45:14"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="ISA 45:14">“ቀቤኝ ግብጢፊ ደልደል እቶጵያ፣</para>
  <para style="q2" vid="ISA 45:14">ነሞትን ዼዼሮን ሳባ፣</para>
  <para style="q1" vid="ISA 45:14">ገረኬ ንዹፉ፤</para>
  <para style="q2" vid="ISA 45:14">ከንኬስ ንተኡ፤</para>
  <para style="q1" vid="ISA 45:14">እሳን ፎንጫዻን ህዸመኒ</para>
  <para style="q2" vid="ISA 45:14">ዱግደ ዱባን ስ ዱካ ቡኡ።</para>
  <para style="q1" vid="ISA 45:14">ፉለኬ ዱረትስ ገድ ጄዸኒ</para>
  <para style="q2" vid="ISA 45:14">‘ዹጉማን ዋቅን ስ ወጅን ጅረ፤ <optbreak/> እሰ መሌስ ቶኮዩ ህንጅሩ፤</para>
  <para style="q1" vid="ISA 45:14">እሰ መሌስ ዋቅን ብራ ህንጅሩ’</para>
  <para style="q2" vid="ISA 45:14">ጄዸኒ ስ ከዸቱ።”<verse eid="ISA 45:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 45:15"/>ያ ዋቅ፣ ፈይሳ እስራኤል፣</para>
  <para style="q2" vid="ISA 45:15">አት ዹጉማን ዋቀ ኦፍ ዾክስቱዸ።<verse eid="ISA 45:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 45:16"/>ወር ዋቆተ ቶልፈሞ ቶልቸን ሁንድኑ ንቃነኡ፤ ንሰልጰቱ፤</para>
  <para style="q2" vid="ISA 45:16">ወሊ ወጅንስ ሰልጵነ ኬሰ ቡኡ።<verse eid="ISA 45:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 45:17"/>እስራኤል ገሩ ፈይነ በረ በራቲን</para>
  <para style="q2" vid="ISA 45:17">
    <char style="nd">ዋቀዮ</char> ንፈይፈመ፤</para>
  <para style="q1" vid="ISA 45:17">እስን በረ በራን ህንቃኖፍተን፤</para>
  <para style="q2" vid="ISA 45:17">ዮካን ህንሰልጰተን።<verse eid="ISA 45:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 45:18"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፤</para>
  <para style="q1" vid="ISA 45:18">ከን ሰሚወን ኡሜ፣ እን ዋቀ፤</para>
  <para style="q2" vid="ISA 45:18">እን ለፈ ሚዸግሴ ቶልቼ እሼ ሁንዴሴ፤</para>
  <para style="q1" vid="ISA 45:18">እን አከ እሼን እዶ ጅሬኛ ታቱፍ እሼ ኡሜ መሌ</para>
  <para style="q2" vid="ISA 45:18">አከ እሼን ኦነ ታቱፍ እሼ ህንኡምኔ፤</para>
  <para style="q1" vid="ISA 45:18">እን አከነ ጄዸ፤</para>
  <para style="q2" vid="ISA 45:18">“አን <char style="nd">ዋቀዮ</char>፤ አነ መሌ ከን ብራ ህንጅሩ።<verse eid="ISA 45:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 45:19"/>አን ብየ ዱከና ኬሳ</para>
  <para style="q2" vid="ISA 45:19">ዾክሳዻን ህንዱበትኔ፤</para>
  <para style="q1" vid="ISA 45:19">አን ሰኚወን ያቆቢን፣</para>
  <para style="q2" vid="ISA 45:19">‘አከሱማን ነ በርባዳ’ ህንጄኔ።</para>
  <para style="q1" vid="ISA 45:19">አን <char style="nd">ዋቀዮ</char> ዹጋ ነንዱበዸ፤</para>
  <para style="q2" vid="ISA 45:19">ዋን ቀጄላስ ነንለብሰ።<verse eid="ISA 45:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 45:20"/>“ወልት ቀበማ ኮታ፤</para>
  <para style="q2" vid="ISA 45:20">እስን በቀቶትን ሰቦታ ወል ገኣ።</para>
  <para style="q1" vid="ISA 45:20">ወር ዋቀ ቶልፈማ ሙከራ ሆጄተሜ ባተን፣</para>
  <para style="q2" vid="ISA 45:20">ከኔን ዋቆተ ፈይሱ ህንደንዴኜ ከዸተን <optbreak/> ሆማ ቤኩምሰ ህንቀበን።<verse eid="ISA 45:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 45:21"/>ዋነን ተኡ ቀቡ ዱበዻ፤ ዽኤፈዻስ፤</para>
  <para style="q2" vid="ISA 45:21">እሳንስ ወሊ ወጅን ሃመርአተን።</para>
  <para style="q1" vid="ISA 45:21">ኤኙቱ ዋን ከነ ዱራን ዱርሴ በረ ዼራን ዱረ ህሜ?</para>
  <para style="q2" vid="ISA 45:21">ዱሩመዩ ኤኙቱ ለብሴ?</para>
  <para style="q1" vid="ISA 45:21">አኑመ <char style="nd">ዋቀዮ</char> ምቲ?</para>
  <para style="q2" vid="ISA 45:21">አነ መሌ ዋቅን ቀጄላፊ</para>
  <para style="q1" vid="ISA 45:21">ፈይሳን ቶኮዩ ህንጅሩ፤</para>
  <para style="q2" vid="ISA 45:21">አነ መሌ ቶኮሌ ህንጅሩ።<verse eid="ISA 45:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 45:22"/>“እስን ወር ሀንዳረ ለፋ ሁንድ፣</para>
  <para style="q2" vid="ISA 45:22">ገረኮት ዴብኣቲ ፈያ፤</para>
  <para style="q2" vid="ISA 45:22">አን ዋቀ፤ አነ መሌ ከን ብራ ህንጅሩቲ።<verse eid="ISA 45:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 45:23"/>አን መታኮቲን ከከዼረ፤</para>
  <para style="q2" vid="ISA 45:23">አፋንኮስ አከነ ጄዼ ቀጄሉማዻን</para>
  <para style="q2" vid="ISA 45:23">ዱቢ ህንጌደረምኔ ዱበቴረ፤</para>
  <para style="q1" vid="ISA 45:23">‘ጅልብ ሁንድ ፉለኮ ዱረት ንጅልቤንፈተ፤</para>
  <para style="q2" vid="ISA 45:23">አረብን ሁንድስ አናን ከከተ።’<verse eid="ISA 45:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 45:24"/>እሳንስ፣ ‘ቀጄሉማፊ ጀብን <char style="nd">ዋቀዮ</char> ቆፋን አርገመ’</para>
  <para style="q2" vid="ISA 45:24">ጄዸኒ ዋኤኮ ንዱበቱ።”</para>
  <para style="q1" vid="ISA 45:24">ወር ኣሪዻን እሰት ከአን ሁንድ፣</para>
  <para style="q2" vid="ISA 45:24">ገረሳ ዹፈኒ ንቃነኡ።<verse eid="ISA 45:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 45:25"/>ሰኚን እስራኤል ሁንድ ገሩ፣</para>
  <para style="q2" vid="ISA 45:25">
    <char style="nd">ዋቀዮን</char> ቀጄልቶተ ታስፈሙ፤</para>
  <para style="q2" vid="ISA 45:25">ንከበጀሙስ።<verse eid="ISA 45:25"/></para>
  <chapter eid="ISA 45"/>
  <chapter number="46" style="c" sid="ISA 46"/>
  <para style="s1">ዋቆተ ባብሎን</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 46:1"/>ቤል ገድ ጄዸ፤ ኔቦ አከ መሌ ጉጉፈ፤</para>
  <para style="q2" vid="ISA 46:1">ዋቆንሳኒ ቶልፈሞን ኮቴ ዱዳፊ ሆሪት ፌአመኒሩ፤</para>
  <para style="q1" vid="ISA 46:1">ፈኪወን እሳን ቀበተኒ ጆረን በኣዸ፤</para>
  <para style="q2" vid="ISA 46:1">ሆሪ ደዸቤፍ በኣዸ።<verse eid="ISA 46:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 46:2"/>እሳን ጉጉፈኒ ወሊ ወጅን ገድ ጄዹ፤</para>
  <para style="q2" vid="ISA 46:2">በኣ ሰነ ኦልቹ ህንደንደአን፤</para>
  <para style="q2" vid="ISA 46:2">እሳንዩ ንቦጅአሙ።<verse eid="ISA 46:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 46:3"/>“ያ መነ ያቆብ፣</para>
  <para style="q2" vid="ISA 46:3">እስን ሀምባን መነ እስራኤል ሁንድ፣</para>
  <para style="q1" vid="ISA 46:3">ወር አን ጋፈ እስን ገደሜሰ ኬሰት <optbreak/> ኡመምተኒ ጀልቀቤ ኦል እስን ቀቤ</para>
  <para style="q2" vid="ISA 46:3">ጋፈ ዸለተኒ ጀልቀቤስ እስን ባዼ ሁንድ ዸጌፈዻ።<verse eid="ISA 46:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 46:4"/>ሀመ ዱሎምተኒ አሪ ባፍተንት፣</para>
  <para style="q2" vid="ISA 46:4">አን እሰ፤ እሱመ እስን ጅራችሱዸ።</para>
  <para style="q1" vid="ISA 46:4">አን እስን ኡሜረ፤ እስነን ባዸስ፤</para>
  <para style="q2" vid="ISA 46:4">አን እስነን ጅራችሰ፤ እስነን በራረስ።<verse eid="ISA 46:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 46:5"/>“እስን ኤኙን ወል ብረ ነ ቀብዱ ዮካን ኤኙን ወል ነ ቅጤስቱ?</para>
  <para style="q2" vid="ISA 46:5">አከ ወል መዳሉፍስ ኤኙት ነ ፈኬስቱ?<verse eid="ISA 46:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 46:6"/>ነሞትን ቶኮ ቶኮ ኮሮጆሳኒ ኬሳ ወርቄ ገድ ነቀኒ</para>
  <para style="q2" vid="ISA 46:6">መዳሊዻን ሜቲ መዳሉ፤</para>
  <para style="q1" vid="ISA 46:6">ዋቀ ቶልፈማ ቶልቹፍ ጄዸኒ ቱምቱ ወርቄ ቀጨሩ፤</para>
  <para style="q2" vid="ISA 46:6">እሳንስ ገድ ጄዸኒ ሰገዱፍ።<verse eid="ISA 46:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 46:7"/>ኦል ፉዸኒ ገቲቲሳኒት ንባቱ፤</para>
  <para style="q2" vid="ISA 46:7">እዶሳት ንዴብሱ፤ እንስ አች ዻበተ።</para>
  <para style="q2" vid="ISA 46:7">እን እዶ ሰና ሶቾኡ ህንደንደኡ።</para>
  <para style="q1" vid="ISA 46:7">ዮ ነምን ገረሳት እዬዩ፣ እን ዴቢ ህንኬኑ፤</para>
  <para style="q2" vid="ISA 46:7">እን ረኮሳ ኬሳ እሰ ባሱ ህንደንደኡ።<verse eid="ISA 46:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 46:8"/>“ያ ፍንጭልቶተ፣ ዋን ከነ ያደዻ፤</para>
  <para style="q2" vid="ISA 46:8">ቀልቢትስ ቀበዻ፤ ገራኬሰን ኬሰስ ካአዻ።<verse eid="ISA 46:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 46:9"/>ወንቶተ ደርበን ከኔን በረ ዱሪ ያደዻ፤</para>
  <para style="q2" vid="ISA 46:9">አን ዋቀ፤ ከን ብራ ህንጅሩ፤</para>
  <para style="q2" vid="ISA 46:9">አን ዋቀ፤ ከን አከኮ ህንጅሩ።<verse eid="ISA 46:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 46:10"/>አን ዹመ ዋን ቶኮ ጀልቀቡመት ነንለብሰ፤</para>
  <para style="q2" vid="ISA 46:10">ዋን አመዩ ዹፉፍ ጅሩ፣ አን ዱሩማ ጀልቀቤ ዱበዼረ።</para>
  <para style="q1" vid="ISA 46:10">አን፣ ‘ካዮንኮ ጭሜ ጅራተ፤</para>
  <para style="q2" vid="ISA 46:10">ዋን ነ ገመቺሱ ሁንደስ ነንሆጄዸ’ ነንጄዸ።<verse eid="ISA 46:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 46:11"/>በአ ቢፍቱቲ አላቲ ዋ አደምስቱ፣</para>
  <para style="q2" vid="ISA 46:11">ለፈ ፈጎቲሞ ነመ ካዮኮ ፊጣን ባሱ ነንዋመ።</para>
  <para style="q1" vid="ISA 46:11">አን ዋነን ዱበዼ ነንጉተ፤</para>
  <para style="q2" vid="ISA 46:11">ዋነን ከሮርፈዼስ ነንራወዸ።<verse eid="ISA 46:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 46:12"/>ያ መተ ጀቤዪ፣</para>
  <para style="q2" vid="ISA 46:12">እስን ወር ቀጄሉማራ ፈጎ ጅርተን ነ ዸጌፈዻ።<verse eid="ISA 46:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 46:13"/>አን ቀጄሉማኮ ነንዽኤሰ፤</para>
  <para style="q2" vid="ISA 46:13">እንስ ፈጎ ህንጅሩ፤</para>
  <para style="q2" vid="ISA 46:13">ፈይሱንኮስ ህንበርፈቱ።</para>
  <para style="q1" vid="ISA 46:13">አን ጥዮኒፍ ፈይነ፣</para>
  <para style="q2" vid="ISA 46:13">እስራኤሊፍሞ ኡልፍነኮ ነንኬነ።<verse eid="ISA 46:13"/></para>
  <chapter eid="ISA 46"/>
  <chapter number="47" style="c" sid="ISA 47"/>
  <para style="s1">ኩፋቲ ባብሎን</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 47:1"/>“ያ እንተለ ባብሎን ዱርበ ቁልቁልቲ፣</para>
  <para style="q2" vid="ISA 47:1">ገድ ቡእ፤ አዋረረ ታእ፤</para>
  <para style="q1" vid="ISA 47:1">ያ እንተለ ባብሎኖታ፣</para>
  <para style="q2" vid="ISA 47:1">ቴሶ መሌ ለፈ ታእ!</para>
  <para style="q1" vid="ISA 47:1">አት ስአች በሬዱ</para>
  <para style="q2" vid="ISA 47:1">ዮካን ክቹ ጄዸምቴ ህንዋመምቱ።<verse eid="ISA 47:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 47:2"/>ዸጋ ዳኩ ፉዸዹቲ ምዻን ዳክ፤</para>
  <para style="q2" vid="ISA 47:2">ሀጉጊኬ ኦፍራ ፉዽ።</para>
  <para style="q1" vid="ISA 47:2">ወንደቦኬ ሶቆለዹ፤</para>
  <para style="q2" vid="ISA 47:2">ጉዴደኬ ሙልእስ፤ ለገ ጬእ።<verse eid="ISA 47:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 47:3"/>ቁላንኬ እፈት ንበአ፤</para>
  <para style="q2" vid="ISA 47:3">ቃኒንኬስ ህንዾከቱ።</para>
  <para style="q1" vid="ISA 47:3">አን ሃሎ ነንበአ፤</para>
  <para style="q2" vid="ISA 47:3">አን ነመ ቶኮዩ ህንዺሱ።”<verse eid="ISA 47:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 47:4"/>ፉሪንኬኘ መቃንሳ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡዸ፤</para>
  <para style="q2" vid="ISA 47:4">እን ቁልቁልቸ እስራኤል።<verse eid="ISA 47:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 47:5"/>“ያ እንተለ ባብሎኖታ፣</para>
  <para style="q2" vid="ISA 47:5">ጨልእሲ ታኢቲ ዱከነ ሴን፤</para>
  <para style="q1" vid="ISA 47:5">አት ስአች</para>
  <para style="q2" vid="ISA 47:5">ሞትቲ ሞቱሞታ ጄዸምቴ ህንዋመምቱ።<verse eid="ISA 47:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 47:6"/>አን ሰበኮት ዼከሜረ፤</para>
  <para style="q2" vid="ISA 47:6">ሀንዹራኮስ ጡሬሴረ፤</para>
  <para style="q1" vid="ISA 47:6">አን ደበርሴ ሀርከኬት እሳን ኬኔረ፤</para>
  <para style="q2" vid="ISA 47:6">አትስ ገራ ህንላፍኔፍ።</para>
  <para style="q1" vid="ISA 47:6">ወረ ዱሎመንረዩ</para>
  <para style="q2" vid="ISA 47:6">ዋንጆ ኡልፋታ ኬሴ።<verse eid="ISA 47:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 47:7"/>አት፣ ‘አን በረ በራን እት ፉፌ</para>
  <para style="q2" vid="ISA 47:7">ሞትቲ በረ በራ ነንተአ!’ ጄቴ።</para>
  <para style="q1" vid="ISA 47:7">አት ገሩ ወንቶተ ከነ ህንሁበትኔ</para>
  <para style="q2" vid="ISA 47:7">ዮካን ዹምንሳኒ ማል አከ ተኡ ህንያደትኔ።<verse eid="ISA 47:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 47:8"/>“አመስ ያ እሼ ቀነኒቱ፣</para>
  <para style="q2" vid="ISA 47:8">ከን ነጋን ጅራቴ</para>
  <para style="q1" vid="ISA 47:8">ገራኬ ኬሰትስ፣</para>
  <para style="q2" vid="ISA 47:8">‘አኑመ፤ አነ መሌ ቶኮዩ ህንጅሩ፤</para>
  <para style="q1" vid="ISA 47:8">አን ስአች ሃዸ ህዬሳ</para>
  <para style="q2" vid="ISA 47:8">ዮካን ነመ ዸሌ ዸቤ ህንተኡ’ ኦፊን ጄቱ ዸገእ።<verse eid="ISA 47:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 47:9"/>ወንቶትን ኩኔን ለማን፣</para>
  <para style="q2" vid="ISA 47:9">ዸለኒ ዸቡፊ ሃዸ ህዬሳ ተኡን</para>
  <para style="q2" vid="ISA 47:9">አኩመ ተሳ ጉዩመ ቶኮት ስት ዹፉ።</para>
  <para style="q1" vid="ISA 47:9">እሳን ባይእነ ፈልፈለኬቲቲፊ</para>
  <para style="q2" vid="ISA 47:9">ቶልቸኬ ጭማ ሰና ሁንደ እራንዩ</para>
  <para style="q2" vid="ISA 47:9">ሁምነሳኒ ጉቱዻን ስት ዹፉ።<verse eid="ISA 47:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 47:10"/>አት ሀምነኬ አመነቴ፣</para>
  <para style="q2" vid="ISA 47:10">‘ነምን ቶኮዩ ነ ህንአርጉ’ ጄቴ።</para>
  <para style="q1" vid="ISA 47:10">ዬሮ አት ገራኬ ኬሰት፣ ‘አነ፤</para>
  <para style="q2" vid="ISA 47:10">አነ መሌ ነምን ብራ ህንጅሩ’ ጄቱት፣</para>
  <para style="q2" vid="ISA 47:10">ኦጉማፊ ቤኩምስኬ ስ ዶጎጎርሱ።<verse eid="ISA 47:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 47:11"/>ወን ሀማን ስት ዹፈ፤</para>
  <para style="q2" vid="ISA 47:11">አትሞ ኤሳ አከ እን ዹፉ ህንቤክቱ።</para>
  <para style="q1" vid="ISA 47:11">በላን አት ኦፍራ እትሱ ህንደንዴኜ ቶኮ ስት ዹፈ፤</para>
  <para style="q2" vid="ISA 47:11">በዲስን አት ዱራን ዱርስቴ ህንቤክን አኩመ ተሳ ስት ዹፈ።<verse eid="ISA 47:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 47:12"/>“ዮስ አት ቶልቸኬቲፊ</para>
  <para style="q2" vid="ISA 47:12">ፈልፈለኬ ባይኤ እጆሉማኬቲ ጀልቀብዴ</para>
  <para style="q2" vid="ISA 47:12">እት ደዸብዴ ሰነ ጀቤሲ ኤግ።</para>
  <para style="q1" vid="ISA 47:12">ዮ አከስ ተኤ አት ንምልኮፍተ፤</para>
  <para style="q2" vid="ISA 47:12">ዮ አከስ ተኤ ነመ ንሶዳችፍተ ተአ።<verse eid="ISA 47:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 47:13"/>ጎርስ አት አርገቴ ሁንድ ደዸቢ ቆፈ ስት ፍዴ!</para>
  <para style="q2" vid="ISA 47:13">ኡርጂ ለኮፍቶትንኬ</para>
  <para style="q1" vid="ISA 47:13">ወር ጅአ ጅኣን ኡርጂ እላለኒ ራጀን ሱን፣</para>
  <para style="q2" vid="ISA 47:13">ሜ ዋን ስት ዹፉ ዱራ ስ ሃባሰን ካ።<verse eid="ISA 47:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 47:14"/>ዹጉማን እሳን አኩመ ጭዲት፤</para>
  <para style="q2" vid="ISA 47:14">እብድ እሳን ጉበ።</para>
  <para style="q1" vid="ISA 47:14">እሳን መታሳኒዩ፣</para>
  <para style="q2" vid="ISA 47:14">ሁምነ አረበ እብዳ ጀላ ባሱ ህንደንደአን።</para>
  <para style="q1" vid="ISA 47:14">በርበዳን እብዳ ከን ነምን ሆእፈቱ <optbreak/> ቶኮዩ ህንጅሩ፤</para>
  <para style="q2" vid="ISA 47:14">እብድ ብረ ታአንስ ህንአርገሙ።<verse eid="ISA 47:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 47:15"/>ወን ወር አት ወጅን ደዸብዴ</para>
  <para style="q2" vid="ISA 47:15">እጆሉማኬቲ ጀልቀብዴ ወጅን ደልደልቴ ሱን</para>
  <para style="q2" vid="ISA 47:15">ሲፍ ጎቹ ደንደአን ከኑመ።</para>
  <para style="q1" vid="ISA 47:15">ቶኮን ቶኮንሳኒ ዶጎጎረሳኒ እት ፉፈን፤</para>
  <para style="q2" vid="ISA 47:15">ከን ስ ባሱ ደንደኡ ቶኮዩ ህንጅሩ።<verse eid="ISA 47:15"/></para>
  <chapter eid="ISA 47"/>
  <chapter number="48" style="c" sid="ISA 48"/>
  <para style="s1">መታ ጀባቹ እስራኤል</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 48:1"/>“ያ መነ ያቆብ፣</para>
  <para style="q2" vid="ISA 48:1">እስን ወር መቃ እስራኤሊን ዋመምተን፣</para>
  <para style="q2" vid="ISA 48:1">ከኔን ሰኚ ይሁዳራ አርገምተን፣</para>
  <para style="q1" vid="ISA 48:1">እስን ወር መቃ <char style="nd">ዋቀዮቲን</char> ከከተኒ</para>
  <para style="q2" vid="ISA 48:1">ገሩ ዹጋዻን ዮካን ቀጄሉማዻን ኡቱ ህንተእን</para>
  <para style="q2" vid="ISA 48:1">መቃ ዋቀ እስራኤል ዾፍተን ዋን ከነ ዸጌፈዻ፤<verse eid="ISA 48:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 48:2"/>እስን ወር መቃ መጋላ ቁልቁልቲቲን ኦፍ ዋምተን፣</para>
  <para style="q2" vid="ISA 48:2">ከኔን ዋቀ እስራኤልት እርከተን፣ <optbreak/> ዋን ከነ ዸጌፈዻ፤</para>
  <para style="q2" vid="ISA 48:2">መቃንሳ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡዸ፦<verse eid="ISA 48:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 48:3"/>አን ወንቶተ ዱሪ ዱራን ዱርሴ ዱበዼረ፤</para>
  <para style="q2" vid="ISA 48:3">እሳን አፋንኮቲ በአን፤ 1 አንስ አከ እሳን ቤከመን ነንጎዼ፤</para>
  <para style="q2" vid="ISA 48:3">አንስ አኩመ ተሳ ሆጄዼ፤ እሳንስ ንራወተመን።<verse eid="ISA 48:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 48:4"/>አን አከ አት መተ ጀቤሰ ታቴ ቤኬን ቱሬቲ፤</para>
  <para style="q2" vid="ISA 48:4">ርቡን ሞርመኬቲ ስቢለ ቱሬ፤</para>
  <para style="q2" vid="ISA 48:4">አድኬ ናሲ ቱሬ።<verse eid="ISA 48:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 48:5"/>ከናፉ አን ወንቶተ ከኔን በረ ዼራን ዱረ ስት ህሜረ፤</para>
  <para style="q2" vid="ISA 48:5">አን አከ አት፣ ‘ዋቆተኮ ቶልፈሞቱ እሳን ሆጄቴ፤</para>
  <para style="q1" vid="ISA 48:5">ፈኪኮ ከን ሙከራ ሆጄተሜፊ</para>
  <para style="q2" vid="ISA 48:5">ዋቀ ስቢለራ ሆጄተሜቱ ሙርቴሴ’ <optbreak/> ጄቹ ህንደንዴኜፍ</para>
  <para style="q2" vid="ISA 48:5">ኡቱ እሳን ህንኡመምኒን ዱረ ስት ህሜረ።<verse eid="ISA 48:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 48:6"/>አት ወንቶተ ከኔን ዸጌሴርተ፤ እሳን ሁንደ እላል።</para>
  <para style="q2" vid="ISA 48:6">አት እሳን አመንቴ ህንፉዸቱ?</para>
  <para style="b" vid="ISA 48:6"/>
  <para style="q1" vid="ISA 48:6">“አን አማ ጀልቀቤ ዋን ሃራ፣</para>
  <para style="q2" vid="ISA 48:6">ዋን ዾክፈሜ ጅሩ ከን አት ህንቤክን ስት ነንህመ።<verse eid="ISA 48:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 48:7"/>እሳን አመ ኡመመን መሌ በረ ዼራን ዱረ ምት፤</para>
  <para style="q2" vid="ISA 48:7">አት ሀርኣን ዱረ ዋኤሳኒ ህንዸጌኜ።</para>
  <para style="q1" vid="ISA 48:7">ከናፉ አት፣</para>
  <para style="q2" vid="ISA 48:7">‘ኩኖ አን ዋኤሳኒ ቤኬን ቱሬ’ <optbreak/> ጄቹ ህንደንዴሱ።<verse eid="ISA 48:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 48:8"/>አት ተኩማ ዸጌሴ ዮካን ሁበቴ ህንቤክቱ፤</para>
  <para style="q2" vid="ISA 48:8">ጉርኬ ዱሩማ ጀልቀቤ ህንበነምኔ።</para>
  <para style="q1" vid="ISA 48:8">አን አከ አት ምጪረማ ታቴ ቤከ፤</para>
  <para style="q2" vid="ISA 48:8">አት ዸሎተኬቲ ጀልቀብዴ ፍንጭላ ጄዸምቴ ዋመምቴ።<verse eid="ISA 48:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 48:9"/>አን መቃኮቲፍ ጄዼ ዼከምሰኮ ነንቱርሲሰ፤</para>
  <para style="q2" vid="ISA 48:9">አን አከ ስ ህንበሌስኔፍ ገለተኮቲፍ ጄዼ</para>
  <para style="q2" vid="ISA 48:9">ዼከምሰኮ ዱበት ሀርክሰ።<verse eid="ISA 48:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 48:10"/>ኩኖ፣ አን ዮ አከ ሜቲት ተኡ ባቴዩ <optbreak/> ስ ቁልቁሌሴረ፤</para>
  <para style="q2" vid="ISA 48:10">እብደ ዽጵና ኬሰትስ ቆሬ ስ እላሌረ።<verse eid="ISA 48:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 48:11"/>አን ኦፊኮቲፍ ጄዼ፣ ኦፉመኮቲፍ ጄዼ ዋን ከነ ነንጎዸ።</para>
  <para style="q2" vid="ISA 48:11">መቃንኮ አከምት በዱ ደንደአ?</para>
  <para style="q2" vid="ISA 48:11">አን ኡልፍነኮ ደበርሴ ከን ብራቲፍ ህንኬኑ።<verse eid="ISA 48:11"/></para>
  <para style="s1">እስራኤል ብልሶምቴ</para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 48:12"/>“ያ ያቆብ፣ ያ እስራኤል ከን አን ስ ዋሜ፣</para>
  <para style="q2" vid="ISA 48:12">ነ ዸጌፈዹ፦</para>
  <para style="q1" vid="ISA 48:12">አን እሱመ፤ አን ከን ጀልቀባት፤</para>
  <para style="q2" vid="ISA 48:12">አን ከን ዹማት።<verse eid="ISA 48:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 48:13"/>ሀርክኮ ሁንዴወን ለፋ ዻቤ፤</para>
  <para style="q2" vid="ISA 48:13">ሀርክኮ ምርጋሞ ሰሚወን ድሪርሴ፤</para>
  <para style="q1" vid="ISA 48:13">ዮሙ አን እሳን ዋሙት፣</para>
  <para style="q2" vid="ISA 48:13">ሁንድሳኒ ወሊ ወጅን ዻበቱ።<verse eid="ISA 48:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 48:14"/>“ሁንድኬሰን ወልት ቀበማቲ ዸጌፈዻ፤</para>
  <para style="q2" vid="ISA 48:14">ዋቆተ ቶልፈሞ ኬሳ ከምቱ ዱራን ዱርሴ <optbreak/> ወንቶተ ከኔን ዱበቴ?</para>
  <para style="q1" vid="ISA 48:14">ምቹን <char style="nd">ዋቀዮ</char> ፍለተማን</para>
  <para style="q2" vid="ISA 48:14">ካዮ ዋቃ ባብሎንረት ፊጣን ባሰ፤</para>
  <para style="q2" vid="ISA 48:14">እሬንሳ ባብሎኖተት ከአ።<verse eid="ISA 48:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 48:15"/>አን፣ አን መታንኮ ዱበዼረ፤</para>
  <para style="q2" vid="ISA 48:15">ዹጉማን አን እሰ ዋሜረ።</para>
  <para style="q1" vid="ISA 48:15">አን እሰ ነንፍደ፤</para>
  <para style="q2" vid="ISA 48:15">እንስ ከራሳረት ንምልካአ።<verse eid="ISA 48:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 48:16"/>“ነት ዽኣዻቲ ዋን ከነ ዸገኣ፦</para>
  <para style="q1" vid="ISA 48:16">“አን ጀልቀቡማ ካሴ ዾክሳት ህንዱበትኔ፤</para>
  <para style="q2" vid="ISA 48:16">ዬሮ ወን ሱን ተኤትስ አን አቹመን ቱሬ።”</para>
  <para style="b" vid="ISA 48:16"/>
  <para style="q1" vid="ISA 48:16">አመስ <char style="nd">ዋቀዮ</char> ጎፍታኒፊ</para>
  <para style="q2" vid="ISA 48:16">ሀፉርሳ ነ ኤርገኒሩ።<verse eid="ISA 48:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 48:17"/>
    <char style="nd">ዋቀዮ</char> ፉሪንኬ፣</para>
  <para style="q2" vid="ISA 48:17">ቁልቁልች እስራኤል አከነ ጄዸ፦</para>
  <para style="q1" vid="ISA 48:17">“አን <char style="nd">ዋቀዮ</char> ዋቀኬ፣</para>
  <para style="q2" vid="ISA 48:17">ከን ዋን ሲፍ ቶሉ ስ በርሲሱ፣</para>
  <para style="q2" vid="ISA 48:17">ከን ከራ አት ዴሙ ቀብዱረ ስ ቀጄልቹዸ።<verse eid="ISA 48:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 48:18"/>አት ኡቱ አጀጀኮ ቀልቤፈቴ ጅራቴ፣</para>
  <para style="q2" vid="ISA 48:18">ነጋንኬ አከ ለጋ፣</para>
  <para style="q2" vid="ISA 48:18">ቀጄሉማን ኬሞ አከ ዸኣ ገላና ተአ ቱሬ።<verse eid="ISA 48:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 48:19"/>ሰኚንኬ አኩመ ጭረቻ፣</para>
  <para style="q2" vid="ISA 48:19">እጆሌንኬ አኩመ ብዮ ለፋ ባይአቱ ቱሬ፤</para>
  <para style="q1" vid="ISA 48:19">መቃንሳኒ ህንሀቀሙ፤</para>
  <para style="q2" vid="ISA 48:19">እሳንስ ፉለኮ ዱራ ህንዸበመን ቱሬ።”<verse eid="ISA 48:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 48:20"/>ባብሎን ኬሳ በኣ፤</para>
  <para style="q2" vid="ISA 48:20">ባብሎኖተ ዱራ በቀዻ!</para>
  <para style="q1" vid="ISA 48:20">ዋን ከነ እየ ገመቹቲን ቤክስሳ፤ ለብሳስ።</para>
  <para style="q2" vid="ISA 48:20">ሀመ ሀንዳረ ለፋት ደበርሳ፤</para>
  <para style="q2" vid="ISA 48:20">“<char style="nd">ዋቀዮ</char> ገርብቸሳ ያቆብን ፉሬረ” ጄዻ።<verse eid="ISA 48:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 48:21"/>እሳን ዮሙ እን ለፈ ገሞጂ ኬሰ እሳን ቀጄልቼት <optbreak/> ህንዼቦትኔ፤</para>
  <para style="q2" vid="ISA 48:21">እን ከታ ኬሳ ብሻን ቡርቅሲሴፍ፤</para>
  <para style="q1" vid="ISA 48:21">እን ከታ ዾሴ፣</para>
  <para style="q2" vid="ISA 48:21">ብሻንስ ሁምናን ጨብሴ በኤ።<verse eid="ISA 48:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 48:22"/>“ሀሞታፍ ነጋን ህንጅሩ” ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="ISA 48:22"/></para>
  <chapter eid="ISA 48"/>
  <chapter number="49" style="c" sid="ISA 49"/>
  <para style="s1">ተጃጅላ <char style="nd">ዋቀዮ</char></para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 49:1"/>ያ ብዮተ ብሻን ግዱ ነ ዸጌፈዻ፤</para>
  <para style="q2" vid="ISA 49:1">ያ ሰቦተ ፈጎ ጅራተን ዋን ከነ ዸገኣ፦</para>
  <para style="q1" vid="ISA 49:1">ኡቱ አን ህንዸለትን ዱረ <char style="nd">ዋቀዮ</char> ነ ዋሜ፤</para>
  <para style="q2" vid="ISA 49:1">ኡቱ አን ገደሜሰ ሃዸኮ ኬሰ ጅሩ መቃ ና ባሴ።<verse eid="ISA 49:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 49:2"/>እን አፋንኮ አከ ጎራዴ ቀረሜ ጎዼ፤</para>
  <para style="q2" vid="ISA 49:2">ጋድዱ ሀርከሳቲን ነ ዾክሴ፤</para>
  <para style="q1" vid="ISA 49:2">ጥየ ጩሉሉቅፈሜ ነ ጎዼ፣</para>
  <para style="q2" vid="ISA 49:2">መንኤ ጥየሳ ኬሰ ነ ካአቴ።<verse eid="ISA 49:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 49:3"/>እንስ፣ “ያ እስራኤል፣ አት ገርብቸኮ</para>
  <para style="q2" vid="ISA 49:3">ከን አን ኡልፍነኮ እሰረት ሙልእሱዸ” አናን ጄዼ።<verse eid="ISA 49:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 49:4"/>አን ገሩ፣ “አከሱማነን እት ደዸቤ፤</para>
  <para style="q2" vid="ISA 49:4">ሁምነኮስ ዋኑመ ፋይዳ ህንቀብኔተን ፍጤ።</para>
  <para style="q1" vid="ISA 49:4">ተኡስ ዹጋንኮ ሀርከ <char style="nd">ዋቀዮ</char>፣</para>
  <para style="q2" vid="ISA 49:4">ገቲንኮስ ዋቀ ብረ ጅረ” ነንጄዼ።<verse eid="ISA 49:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 49:5"/>ዋን አን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ኡልፍነ አርገዼ</para>
  <para style="q2" vid="ISA 49:5">ዋቅንኮ ጀብነ ና ተኤፍ፣</para>
  <para style="q1" vid="ISA 49:5">
    <char style="nd">ዋቀዮ</char> እን አከ አን ያቆብን ዴብሴ ገረሳት ፍዱፍ፣</para>
  <para style="q2" vid="ISA 49:5">እስራኤልን እሰ ብረት ወልት ቀቡፍ፣</para>
  <para style="q1" vid="ISA 49:5">አከ አን ገርብቸሳ ተኡፍ</para>
  <para style="q2" vid="ISA 49:5">ገደሜሰ ኬሰት ነ ቶልቼ ሱን አከነ ጄዸ፤<verse eid="ISA 49:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 49:6"/>እንስ፣ “አት ጎሶተ ያቆብ ዴብፍቴ ዻቡፍ፣</para>
  <para style="q2" vid="ISA 49:6">እስራኤሎተ አን ኤጌ ሰነስ ዴብፍቴ ፍዱፍ</para>
  <para style="q2" vid="ISA 49:6">ገርብቸኮ ተኡንኬ ሲፍ ባይኤ ሰልጳዸ።</para>
  <para style="q1" vid="ISA 49:6">አከ ፈይንኮ ቀርቀረ ለፋ ገኡፍ</para>
  <para style="q2" vid="ISA 49:6">አን ነሞተ ኦርማቲፍ እብሳ ስን ታስሰ” ጄዸ።<verse eid="ISA 49:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 49:7"/>
    <char style="nd">ዋቀዮ</char> ፉሪፊ ቁልቁልች እስራኤል፣</para>
  <para style="q2" vid="ISA 49:7">እሰ ነማን ቱፈተሜ ሰብንስ ጅቤ፣</para>
  <para style="q2" vid="ISA 49:7">ተጃጅላ ቡልችቶታ ሰናን አከነ ጄዸ፦</para>
  <para style="q1" vid="ISA 49:7">“ሰበቢ <char style="nd">ዋቀዮ</char> አመነማ</para>
  <para style="q2" vid="ISA 49:7">ቁልቁልቸ እስራኤል እሰ ስ ፍለቴ ሰናቲፍ</para>
  <para style="q1" vid="ISA 49:7">ጄዸኒ ሞቶትን ስ አርገኒ ኦል ከኡ፤</para>
  <para style="q2" vid="ISA 49:7">እልማን ሞቶታስ አርገኒ ሰገዱ።”<verse eid="ISA 49:7"/></para>
  <para style="s1">ዴብፈምቴ እጃረሙ እስራኤል</para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 49:8"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="ISA 49:8">“አን ዬሮ ፉዸተመ ቀቡት ሲፍን ዴብሰ፤</para>
  <para style="q2" vid="ISA 49:8">ጋፈ ፈይናትስ ስን ገርጋረ፤</para>
  <para style="q1" vid="ISA 49:8">አከ አት ዻለ አባ ህንቀብኔ</para>
  <para style="q2" vid="ISA 49:8">ዴብፍቴ ዻልችፍቱፍ፣</para>
  <para style="q1" vid="ISA 49:8">አን ስን ኤገ፤</para>
  <para style="q2" vid="ISA 49:8">አከ አት ሰባፍ ከኩ ታቱስ ስን ጎዸ፤<verse eid="ISA 49:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 49:9"/>አከ አት ወረ ቦጅአመኒን፣ ‘ኮታ በኣ’</para>
  <para style="q2" vid="ISA 49:9">ወረ ዱከነ ኬሰ ጅራተኒንሞ፣ ‘ብልሰ በኣ’ ጄቱ ስን ጎዸ።</para>
  <para style="b" vid="ISA 49:9"/>
  <para style="q1" vid="ISA 49:9">“እሳን ከራረት ዋ ኛቱ፤</para>
  <para style="q2" vid="ISA 49:9">ጋረ ቁልቁላኣረትስ እዶ ቁበታ አርገቱ።<verse eid="ISA 49:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 49:10"/>እሳን ህንቤለአን፤ ህንዼቦተንስ፤</para>
  <para style="q2" vid="ISA 49:10">ሆእ ገሞጂ ዮካን አዱን እሳን ህንጉቡ።</para>
  <para style="q1" vid="ISA 49:10">እን እሳኒፍ ገራ ላፉ እሳን ጌጌሰ፤</para>
  <para style="q2" vid="ISA 49:10">ቀርቀረ ቡርቃ ብሻኒረ እሳን ቀጄልቸ።<verse eid="ISA 49:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 49:11"/>ቱሉወንኮ ሁንደ ከራት ነንጌደረ፤</para>
  <para style="q2" vid="ISA 49:11">ዳንዲወንኮ ጉርጉዳንስ ወል ቅጤፈሙ።<verse eid="ISA 49:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 49:12"/>ኩኖ፣ እሳን ብየ ፈጎዻ ንዹፉ፤</para>
  <para style="q2" vid="ISA 49:12">ገሪን ካባ፣ ገሪን ዽኣ፣</para>
  <para style="q2" vid="ISA 49:12">ካንሞ ብየ አስዋኒቲ ንዹፉ።”<verse eid="ISA 49:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 49:13"/>ያ ሰሚወን፣ እልልቻ፤</para>
  <para style="q2" vid="ISA 49:13">ያ ለፈ ገመድ፤</para>
  <para style="q2" vid="ISA 49:13">ያ ቱሉወን፣ ጉድሳ ፋርፈዻ!</para>
  <para style="q1" vid="ISA 49:13">
    <char style="nd">ዋቀዮ</char> ሰበሳ ንጀጀቤሰ፤</para>
  <para style="q2" vid="ISA 49:13">ወረ ረከተኒፍስ ገራ ንላፋቲ።<verse eid="ISA 49:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 49:14"/>ጥዮን ገሩ፣ “<char style="nd">ዋቀዮ</char> ነ ገቴረ፤</para>
  <para style="q2" vid="ISA 49:14">ጎፍታንስ ነ እራንፈቴረ” ጄቴ።<verse eid="ISA 49:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 49:15"/>“ሃት ዳእመሼ ከን ሆስፍቱ</para>
  <para style="q2" vid="ISA 49:15">እራንፈቹ ንደንዴሲ?</para>
  <para style="q1" vid="ISA 49:15">ሙጫ ዴሴፍስ ገራ ህንላፍቱ?</para>
  <para style="q2" vid="ISA 49:15">ዮ እሼን እራንፈቴዩ አን ስ ህንእራንፈዹ!<verse eid="ISA 49:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 49:16"/>ኩኖ፣ አን በሩ ሀርከኮረት ስ ቅርጤረ፤</para>
  <para style="q2" vid="ISA 49:16">ደላወንኬ ዬሮ ሁንደ ፉለኮ ዱረ ጅሩ።<verse eid="ISA 49:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 49:17"/>እልማንኬ አሪቲዻን ንደቸኡ፤</para>
  <para style="q2" vid="ISA 49:17">ወር ስ ዲገንስ ስራ በቀቱ።<verse eid="ISA 49:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 49:18"/>እጀኬ ኦል ፉዸዹቲ ናኖኬ እላል፤</para>
  <para style="q2" vid="ISA 49:18">እልማንኬ ሁንድ ወልት ቀበመኒ ገረኬ ንዹፉ።</para>
  <para style="q1" vid="ISA 49:18">አን ጅራታዻቲ” ጄዸ <char style="nd">ዋቀዮ</char>።</para>
  <para style="q2" vid="ISA 49:18">“አት እሳን ከኔን ሁንደ አከ ፋያት ንኡፈተ፤</para>
  <para style="q2" vid="ISA 49:18">አከ ምስሮትስ እቲን ሚዸግፈምተ።<verse eid="ISA 49:18"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 49:19"/>“አት ዲገምቴ ኦንቴ</para>
  <para style="q2" vid="ISA 49:19">ብይኬ በርበዳኡዩ</para>
  <para style="q1" vid="ISA 49:19">አመ ሰበኬት ለፍት ንዽጰተ፤</para>
  <para style="q2" vid="ISA 49:19">ወር ስ ልቅምሰን ስራ ንፈጋቱ።<verse eid="ISA 49:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 49:20"/>እጆሌን አት ዬሮ ገደኬቲት ዴሴ፣</para>
  <para style="q2" vid="ISA 49:20">ኡቱመ ጉርኬ ዸገኡ፣</para>
  <para style="q1" vid="ISA 49:20">‘ለፍት ኩን ኑት ዽጰቴረ፤</para>
  <para style="q2" vid="ISA 49:20">ለፈረ ጅራትኑ ኑፍ ኬን’ ሲን ጄዹ።<verse eid="ISA 49:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 49:21"/>ኤርገሲ አት ገራኬት አከነ ጄተ፤</para>
  <para style="q2" vid="ISA 49:21">‘ኤኙቱ ጀረ ከኔን ና ደኤ?</para>
  <para style="q1" vid="ISA 49:21">አን ገድቱፊ መሴንቱን ቱሬ፤</para>
  <para style="q2" vid="ISA 49:21">አን በቀቱፊ ጅበምቱን ቱሬ።</para>
  <para style="q2" vid="ISA 49:21">እሳን ከኔን ኤኙቱ ጉድሴ?</para>
  <para style="q1" vid="ISA 49:21">አን ኮጳት ሀፌን ቱሬ፤</para>
  <para style="q2" vid="ISA 49:21">ዮስ፣ እሳን ኩኔን ኤሳ ዹፈንሬ?’ ”<verse eid="ISA 49:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 49:22"/>
    <char style="nd">ዋቀዮ</char> ጎፍታን አከነ ጄዸ፦</para>
  <para style="q1" vid="ISA 49:22">“ኩኖ አን ነሞተ ኦርማ ሀርካን ነንዋመ፤</para>
  <para style="q2" vid="ISA 49:22">ፋጂኮስ ኡመታፍ ኦል ነንቀበ፤</para>
  <para style="q1" vid="ISA 49:22">እሳን እልማንኬ ሀመተኒ ፍዱ፤</para>
  <para style="q2" vid="ISA 49:22">እንተለን ኬሞ ገቲቲሳኒት ባቱ።<verse eid="ISA 49:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 49:23"/>ሞቶትን አቦቲኬ ከኔን ስ ጉድሰን፣</para>
  <para style="q2" vid="ISA 49:23">ኒቶትንሳኒሞ ሃዾተኬ ከኔን ሀርመ ስ ሆስሰን ንተኡ።</para>
  <para style="q1" vid="ISA 49:23">እሳን አደሳኒቲን ለፈት ጎምብፈመኒ ሲፍ ሰገዱ፤</para>
  <para style="q2" vid="ISA 49:23">አዋረ ሚለኬቲሌ ንአራቡ።</para>
  <para style="q1" vid="ISA 49:23">ኤርገሲ አት አከ አን <char style="nd">ዋቀዮ</char> ተኤ ንቤክተ፤</para>
  <para style="q2" vid="ISA 49:23">ወር ነ አብደተን ህንሰልጰተን።”<verse eid="ISA 49:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 49:24"/>ጎቶተ ሀርካ ቦጁ ፉዸቹን፣</para>
  <para style="q2" vid="ISA 49:24">ገረ ጀቤዪ ሀርካስ ቦጁ ባሱን ንደንደአማ?<verse eid="ISA 49:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ISA 49:25"/>
    <char style="nd">ዋቀዮ</char> ገሩ አከነ ጄዸ፦</para>
  <para style="q1" vid="ISA 49:25">“ኤዬ፣ ጎቶተ ሀርካ ቦጅአምቶትን ንባፈሙ፤</para>
  <para style="q2" vid="ISA 49:25">ገረ ጀቤዪ ሀርካስ ቦጁን ንፉዸተመ፤</para>
  <para style="q1" vid="ISA 49:25">ወረ ሲን ፈልመኒን ነንፈልመ፤</para>
  <para style="q2" vid="ISA 49:25">እጆሌኬስ ነንበራረ።<verse eid="ISA 49:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 49:26"/>አን አከ ወር ስ ሀጩጨን ፎን ኦፊሳኒ ኛተን ነንጎዸ፤</para>
  <para style="q2" vid="ISA 49:26">እሳን አኩመ ነመ ዳዺ ወይኒቲን መቻኡ <optbreak/> ዺገ ኦፊሳኒቲን ንመቻኡ።</para>
  <para style="q1" vid="ISA 49:26">ኤርገሲ ሰኚን ነማ ሁንድ፣</para>
  <para style="q2" vid="ISA 49:26">አከ አን <char style="nd">ዋቀዮ</char>፣ ፈይሳንኬ፣</para>
  <para style="q2" vid="ISA 49:26">ፉሪንኬ፣ ጀባ ያቆብ ተኤ ንቤከ።”<verse eid="ISA 49:26"/></para>
  <chapter eid="ISA 49"/>
  <chapter number="50" style="c" sid="ISA 50"/>
  <para style="s1">ጩቡ እስራኤሊፊ አጀጀሙ ተጃጅልትቻ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 50:1"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="ISA 50:1">“ወረቃን ረጋ፣ ከን አን እቲን ሃዸኬሰን ሂኬ</para>
  <para style="q2" vid="ISA 50:1">ኦፍራ እቲን እሼ ጌጌሴ ሜሬ?</para>
  <para style="q1" vid="ISA 50:1">ዮካን ነምን ልቂ ነራ ቀቡ</para>
  <para style="q2" vid="ISA 50:1">ከን አን እት እስን ጉርጉሬ ኤኙ?</para>
  <para style="q1" vid="ISA 50:1">እስን ሰበቢ ጩቡኬሰኒፍ ጉርጉረምተኒርቱ፤</para>
  <para style="q2" vid="ISA 50:1">ሰበቢ የከኬሰኒቲፍስ ሃትኬሰን አርአምቴርት።<verse eid="ISA 50:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 50:2"/>ዬሮ አን ዹፌት ነምን ማሊፍ አች ህንጅራትን?</para>
  <para style="q2" vid="ISA 50:2">ዬሮ አን ዋሜት ነምን ኦዋቱ ማሊፍ አቺ ዸበሜ?</para>
  <para style="q1" vid="ISA 50:2">ሀርክኮ አከ ፉሩ ህንደንዴኜፍ ገባበቴራ?</para>
  <para style="q2" vid="ISA 50:2">አን እስን በራሩፍ ሁምነ ዸቤራ?</para>
  <para style="q1" vid="ISA 50:2">አን ዼከምሰ ቆፋን ገላነ ነንጎግሰ፤</para>
  <para style="q2" vid="ISA 50:2">ለጌንስ ገሞጂት ነንጌደረ፤</para>
  <para style="q1" vid="ISA 50:2">ቁርጡሚወንሳኒ ብሻን ዸበኒ አጃኡ፤</para>
  <para style="q2" vid="ISA 50:2">ዼቡዻንስ ንዹሙ።<verse eid="ISA 50:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 50:3"/>አን ሰሚት ዱከነ ነንኡፍሰ፤</para>
  <para style="q2" vid="ISA 50:3">ወያ ገዳስ እት ነንሀጉገ።”<verse eid="ISA 50:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 50:4"/>አከ አን ወረ ደዸበን ጀጀቤሱፍ፣</para>
  <para style="q2" vid="ISA 50:4">
    <char style="nd">ዋቀዮ</char> ጎፍታን አረበ በረቴ ና ኬኔረ።</para>
  <para style="q1" vid="ISA 50:4">እን ገነመ ገነመ ነ ደመቅሰ፤</para>
  <para style="q2" vid="ISA 50:4">አከ እን አኩመ በረታ ቶኮት ዸጌፈቱፍስ <optbreak/> ጉረኮ ደመቅሰ።<verse eid="ISA 50:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 50:5"/>
    <char style="nd">ዋቀዮ</char> ጎፍታን ጉረኮ ና በኔረ፤</para>
  <para style="q2" vid="ISA 50:5">አንስ ፍንጭላ ህንቱሬ፤</para>
  <para style="q2" vid="ISA 50:5">አን ዱግደ ዱበት ህንዴብኔ።<verse eid="ISA 50:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 50:6"/>አን ወረ ነ ሩኩተንት ዱግደኮ፣</para>
  <para style="q2" vid="ISA 50:6">ወረ አሬደ ነራ ቡቅሰንትሞ መዲኮ ነንኬኔ፤</para>
  <para style="q1" vid="ISA 50:6">ዬሮ እሳን ነት ቆሰኒ ሀንጩፈ ነት ቱፈንት፣</para>
  <para style="q2" vid="ISA 50:6">አን ፉለኮ እሳን ህንዾክፈትኔ።<verse eid="ISA 50:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 50:7"/>ሰበቢ <char style="nd">ዋቀዮ</char> ጎፍታን ነ ገርጋሩፍ፣</para>
  <para style="q2" vid="ISA 50:7">አን ህንሰልጵፈሙ።</para>
  <para style="q1" vid="ISA 50:7">ከናፉ አን ፉለኮ አኩመ ዸጋ ጉራቻ ጎዸዼረ፤</para>
  <para style="q2" vid="ISA 50:7">አን አከ ህንቃኔፈምኔሌ ነንቤከ።<verse eid="ISA 50:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 50:8"/>እን ዹጋ ናፍ ባሱ ዽኦ ጅረ።</para>
  <para style="q2" vid="ISA 50:8">ዮስ ኤኙቱ ነ ህመተሬ?</para>
  <para style="q2" vid="ISA 50:8">ሜ ወልት ገድ ሃባኑ!</para>
  <para style="q1" vid="ISA 50:8">ህመታንኮ ኤኙ?</para>
  <para style="q2" vid="ISA 50:8">እን ሜ ነት ገድ ሃበኡ!<verse eid="ISA 50:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 50:9"/>
    <char style="nd">ዋቀዮ</char> ጎፍታቱ ነ ገርጋረ።</para>
  <para style="q2" vid="ISA 50:9">ኤኙቱ ነት ሙረ?</para>
  <para style="q1" vid="ISA 50:9">እሳን ሁንድ አኩመ ወያ ሞፈኡ፤</para>
  <para style="q2" vid="ISA 50:9">ዾልዾሌንስ እሳን ኛት።<verse eid="ISA 50:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 50:10"/>እስን ኬሳ ከን <char style="nd">ዋቀዮን</char> ሶዳቴ</para>
  <para style="q2" vid="ISA 50:10">ዱቢ ገርብቸሳቲፍ አጀጀሙ ኤኙ?</para>
  <para style="q1" vid="ISA 50:10">ነምን ዱከነ ኬሰ ዴዴብኡ፣</para>
  <para style="q2" vid="ISA 50:10">ከን እፈ ህንቀብኔ፣</para>
  <para style="q1" vid="ISA 50:10">መቃ <char style="nd">ዋቀዮ</char> አመነቴ</para>
  <para style="q2" vid="ISA 50:10">ዋቀሳት ሃእርከቱ።<verse eid="ISA 50:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 50:11"/>አመ ገሩ እስን ወር እብደ ቦቤስተኒ</para>
  <para style="q2" vid="ISA 50:11">ጉጨ ቦበኣ ዴሙ ቀበተን ሁንድኑ</para>
  <para style="q1" vid="ISA 50:11">እፈ እብዳኬሰኒቲፊ እፈ ጉጨ</para>
  <para style="q2" vid="ISA 50:11">ቦቤስተኒ ኬሰ ዴማ።</para>
  <para style="q1" vid="ISA 50:11">ወን እስን ሀርከኮራ አርገተን ከናዸ፤</para>
  <para style="q2" vid="ISA 50:11">እስን ዽጵናን ንጭጪፍቱ።<verse eid="ISA 50:11"/></para>
  <chapter eid="ISA 50"/>
  <chapter number="51" style="c" sid="ISA 51"/>
  <para style="s1">ፈይነ በረ በራ ጥዮኒፍ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 51:1"/>“እስን ወር ቀጄሉማ ዱካ ቡተን፣</para>
  <para style="q2" vid="ISA 51:1">ወር <char style="nd">ዋቀዮን</char> በርባደን ነ ዸጌፈዻ፦</para>
  <para style="q1" vid="ISA 51:1">እስን ከታራ አርገምተን፣</para>
  <para style="q2" vid="ISA 51:1">ቦለ ኬሳ ባፈምተን ሰነ እላላ።<verse eid="ISA 51:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 51:2"/>አባኬሰን አብረሃሚፊ</para>
  <para style="q2" vid="ISA 51:2">ሳራ እሼ እስን ዴሴ ሰነ እላላ።</para>
  <para style="q1" vid="ISA 51:2">ዬሮ አን እሰ ዋሜት፣ እን ቶክቸ ቱሬ፤</para>
  <para style="q2" vid="ISA 51:2">አን እሰ ነንኤብሴ፤ ነንባይእሴስ።<verse eid="ISA 51:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 51:3"/>
    <char style="nd">ዋቀዮ</char> ዹጉማን ጥዮንን ንጀጀቤሰ፤</para>
  <para style="q2" vid="ISA 51:3">ዲገመሼ ሁንደስ ገረ ላፍናን ንእላለ፤</para>
  <para style="q1" vid="ISA 51:3">እን ገሞጂሼ ጎጎጋ አከ ኤዴን፣</para>
  <para style="q2" vid="ISA 51:3">ለፈ ኦናሼስ አከ እዶ ብቅልቱ <char style="nd">ዋቀዮ</char> ንጎዸ።</para>
  <para style="q1" vid="ISA 51:3">እልልቹፊ ገመዱን፣</para>
  <para style="q2" vid="ISA 51:3">ገለትኒፊ ሰገሌን ፋርፈትናሼ ኬሰት አርገመ።<verse eid="ISA 51:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 51:4"/>“ያ ኡመተኮ ነ ዸጌፈዻ፤</para>
  <para style="q2" vid="ISA 51:4">ያ ሰበኮ ነ ዸገኣ፤</para>
  <para style="q1" vid="ISA 51:4">ሴር ነ ብራ በአ፤</para>
  <para style="q2" vid="ISA 51:4">ሙርቲንኮስ ሰቦታፍ እፈ ተአ።<verse eid="ISA 51:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 51:5"/>ቀጄሉማንኮ ደፌ ዽኣተ፤</para>
  <para style="q2" vid="ISA 51:5">ፈይሱንኮስ ዹፋ ጅረ፤</para>
  <para style="q2" vid="ISA 51:5">እሬንኮ ሞቶታፍ ሙርቲ ቀጄላ ፍደ፤</para>
  <para style="q1" vid="ISA 51:5">ብዮትን ብሻን ግዱ ነ ኤገቱ፤</para>
  <para style="q2" vid="ISA 51:5">እሬኮስ ንአብደቱ።<verse eid="ISA 51:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 51:6"/>እጀኬሰን ገረ ሰሚወኒት ኦል ቀበዻ፤</para>
  <para style="q2" vid="ISA 51:6">ለፈስ ገድ እላላ፤</para>
  <para style="q1" vid="ISA 51:6">ሰሚወን አኩመ ኣራ ንበዱ፤</para>
  <para style="q2" vid="ISA 51:6">ለፍት አኩመ ወያ ሞፎፍት።</para>
  <para style="q2" vid="ISA 51:6">ጅራቶትንሼስ አኩመ ትሲሳ ንዱአን።</para>
  <para style="q1" vid="ISA 51:6">ፈይሱንኮ ገሩ በረ በራን ጅራተ፤</para>
  <para style="q2" vid="ISA 51:6">ቀጄሉማንኮስ ህንበዱ።<verse eid="ISA 51:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 51:7"/>“እስን ወር ዋን ቀጄላ ቤክተን</para>
  <para style="q2" vid="ISA 51:7">ነሞትን ሴረኮ ገራ ኬሳ ቀብደን ነ ዸገኣ፤</para>
  <para style="q1" vid="ISA 51:7">ቱፊ ነሞታ ህንሶዳትና፤</para>
  <para style="q2" vid="ISA 51:7">ዮካን አረብሶሳኒቲን ህንራፈምና።<verse eid="ISA 51:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 51:8"/>ብሊን አከ ወያት እሳን ኛት፤</para>
  <para style="q2" vid="ISA 51:8">ራሞንስ አኩመ ርፌንሰ ሆላት እሳን ፍጥ።</para>
  <para style="q1" vid="ISA 51:8">ገሩ ቀጄሉማንኮ በረ በራን፣</para>
  <para style="q2" vid="ISA 51:8">ፈይሱንኮስ ዸሎታ ገረ ዸሎታት እት ፉፈ።”<verse eid="ISA 51:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 51:9"/>ያ እሬ <char style="nd">ዋቀዮ</char>፣ ከእ፤ ከእ! ጀብነ ኡፈዹ፤</para>
  <para style="q2" vid="ISA 51:9">አኩመ በሮተ ደርበኒ፣</para>
  <para style="q2" vid="ISA 51:9">አኩመ ዸሎተ ዱሪ ኬሰት ተኤ ሰነ ከእ።</para>
  <para style="q1" vid="ISA 51:9">ከን ረኣብን ኩኩቴ፣</para>
  <para style="q2" vid="ISA 51:9">ከን ጀዌ ገላና ወራኔ ሱን ሱመ ምቲ?<verse eid="ISA 51:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 51:10"/>እን አከ ወር ፉረመን ጬአኒፍ፣ ገላንቸ፣</para>
  <para style="q2" vid="ISA 51:10">ብሻን ቱጁበ ጉድቻ ጎግሴ፣</para>
  <para style="q2" vid="ISA 51:10">ከን ዽዽመ ገላና ኬሳን ከራ ባሴ ሱመ ምቲ?<verse eid="ISA 51:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 51:11"/>ወር <char style="nd">ዋቀዮ</char> እሳን ፉሬ ንዴብኡ።</para>
  <para style="q2" vid="ISA 51:11">እሳን ፋርፈናዻን ጥዮን ሴኑ፤</para>
  <para style="q2" vid="ISA 51:11">ገመቹን በረ በራ መታሳኒረ ጅራተ።</para>
  <para style="q1" vid="ISA 51:11">እሳን ገመቹፊ እልሌዻን ጉተሙ፤</para>
  <para style="q2" vid="ISA 51:11">ገዲፊ ቦእች እሳንራ ፈጋቱ።<verse eid="ISA 51:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 51:12"/>“ከን እስን ጀጀቤሱ አነ፤ አኑመ።</para>
  <para style="q2" vid="ISA 51:12">ዮስ ማሊፍ ነሞተ ዱአ ህንኦሌ፣</para>
  <para style="q2" vid="ISA 51:12">እልማን ነማ ከኔን አኩመ መርጋ ተአን ሶዳቱሬ?<verse eid="ISA 51:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 51:13"/>አት ከን <char style="nd">ዋቀዮ</char> ቶልቻኬ፣</para>
  <para style="q2" vid="ISA 51:13">እሰ ሰሚወን ድሪርሴ</para>
  <para style="q2" vid="ISA 51:13">ሁንዴ ለፋ ቡሴ ሰነ ደገቱ ኤኙ?</para>
  <para style="q1" vid="ISA 51:13">አት ከን ሰበቢ ዼከምሰ ጩንቁርሳ</para>
  <para style="q2" vid="ISA 51:13">ዋ በሌሱፍ ቆጳኤ ሰናቲፍ</para>
  <para style="q2" vid="ISA 51:13">ኡቱ ገርገር ህንኩትን ጉያ ጉያን ሶዳቱ ኤኙ?</para>
  <para style="q1" vid="ISA 51:13">ዮስ ዼከምስ ጩንቁርሳ ሰና ሜሬ?<verse eid="ISA 51:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="ISA 51:14"/>ቦጅአምቶትን ህዸመን አሪቲዻን ገድ ዺፈሙ፤</para>
  <para style="q1" vid="ISA 51:14">እሳን ቦለ እት ህዸመን ኬሰት ህንዱአን</para>
  <para style="q2" vid="ISA 51:14">ዮካን ቡዴነ ህንዸበን።<verse eid="ISA 51:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 51:15"/>አን <char style="nd">ዋቀዮ</char> ዋቀኬ፣</para>
  <para style="q2" vid="ISA 51:15">ከን አከ ዸኣን ብሻኒ ሁርሱፍ ገላነ ራሱዸ፤</para>
  <para style="q2" vid="ISA 51:15">መቃንሳስ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡዸ።<verse eid="ISA 51:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 51:16"/>አን ከን ሰሚወን እዶሳኒ ካኤ፣</para>
  <para style="q2" vid="ISA 51:16">ከን ሁንዴ ለፋ ሁንዴሴ</para>
  <para style="q1" vid="ISA 51:16">ጥዮኒን፣ ‘አት ሰበኮት’ ጄዼ ሱን፣</para>
  <para style="q2" vid="ISA 51:16">ዱቢኮ አፋንኬ ኬሰ ካኤረ፤</para>
  <para style="q2" vid="ISA 51:16">ጋድዱ ሀርከኮቲንስ ስ ሀጉጌረ።”<verse eid="ISA 51:16"/></para>
  <para style="s1">ጦፎ ዼከምሰ <char style="nd">ዋቀዮ</char></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 51:17"/>ያ ዬሩሳሌም፣ አት ከን ሀርከ ዋቀዮራ፣</para>
  <para style="q2" vid="ISA 51:17">ጦፎ ዼከምሰሳ ኬሳ ዹግዴ፣</para>
  <para style="q2" vid="ISA 51:17">አት ከን ጦፎ ዹጋቲ ነመ ገተንተርሱ ኬሳ</para>
  <para style="q1" vid="ISA 51:17">ሲጮሳ ጡሩርፈቴ ዹግዴ፣</para>
  <para style="q2" vid="ISA 51:17">ደመቅ፣ ደመቅ! ኦል ከእ።<verse eid="ISA 51:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 51:18"/>እልማን እሼን ዴሴ ሁንደ ኬሳ፣</para>
  <para style="q2" vid="ISA 51:18">ከን እሼ ቀጄልቹ ቶኮዩ ህንቱሬ፤</para>
  <para style="q1" vid="ISA 51:18">እልማን እሼን ጉድፍቴ ሁንደ ኬሳስ፣</para>
  <para style="q2" vid="ISA 51:18">ከን ሀርከሼ ቀቡ ቶኮዩ ህንቱሬ።<verse eid="ISA 51:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 51:19"/>በላወን ኩኔን ደቻዻን ስት ዹፈኒሩ፤</para>
  <para style="q2" vid="ISA 51:19">ኤጋ ኤኙቱ ስ ጀጀቤሱ ደንደአ?</para>
  <para style="q1" vid="ISA 51:19">ዲገምኒፊ በዲስን፣ ቤሊፊ ጎራዴን ስት ዹፈኒሩ፤</para>
  <para style="q2" vid="ISA 51:19">ኤጋ ኤኙቱ ስ ጀጀቤሱ ደንደአ?<verse eid="ISA 51:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 51:20"/>እጆሌንኬ ገገበኒሩ፤</para>
  <para style="q2" vid="ISA 51:20">አኩመ ቦሮፈ ክዮን ቀበሜ ቶኮ፣</para>
  <para style="q2" vid="ISA 51:20">ሮገ ከራረ ጭጪሱ።</para>
  <para style="q1" vid="ISA 51:20">እሳን ዼከምሰ <char style="nd">ዋቀዮቲን</char>፣</para>
  <para style="q2" vid="ISA 51:20">እፈተ ዋቀኬቲንስ ጉተመኒሩ።<verse eid="ISA 51:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 51:21"/>ከናፉ ያ እሼ ሚዸምቴ፣</para>
  <para style="q2" vid="ISA 51:21">ከን ኡቱ ዳዺ ወይኒ ህንዹግን መቾፍቴ፣ <optbreak/> ዋን ከነ ዸገእ።<verse eid="ISA 51:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 51:22"/>
    <char style="nd">ዋቀዮ</char> ጎፍታንኬ፣</para>
  <para style="q2" vid="ISA 51:22">ዋቅንኬ እን ሰበሳ ኤጉ አከነ ጄዸ፦</para>
  <para style="q1" vid="ISA 51:22">“ኩኖ አን ጦፎ ዹጋቲ ነመ ገተንተርሱ</para>
  <para style="q2" vid="ISA 51:22">ሀርከኬቲ ፉዼረ፤</para>
  <para style="q1" vid="ISA 51:22">አት ስአች ጦፎ ዼከምሰኮ</para>
  <para style="q2" vid="ISA 51:22">ኬሳ ዴብቴ ህንዹግዱ።<verse eid="ISA 51:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 51:23"/>አንስ ጦፎ ሰነ ሀርከ ወረ ስ ዽጵሰን</para>
  <para style="q2" vid="ISA 51:23">ከኔን፣ ‘አከ ኑ ስረ ያኑፍ፣ ለፈረ ድሪርፈም’</para>
  <para style="q2" vid="ISA 51:23">ሲን ጄዸን ሰና ኬሰ ነንካአ።</para>
  <para style="q1" vid="ISA 51:23">አትሞ ዱግደኬ አኩመ ለፋ፣</para>
  <para style="q2" vid="ISA 51:23">አኩመ ዳንዲ ነምንረ ዴሙ ጎቴ።”<verse eid="ISA 51:23"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 51"/>
  <chapter number="52" style="c" sid="ISA 52"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 52:1"/>ያ ጥዮን፣ ደመቅ፣ ደመቅ፤</para>
  <para style="q2" vid="ISA 52:1">ጀብነኬ ኡፈዹ!</para>
  <para style="q1" vid="ISA 52:1">ያ ዬሩሳሌም፣ ያ መጋላ ቁልቁልቲ፣</para>
  <para style="q2" vid="ISA 52:1">ወያኬ ሚዸጋ ሰነ ኡፈዹ።</para>
  <para style="q1" vid="ISA 52:1">ነሞትን ዸግነ ህንቀበምኒፊ</para>
  <para style="q2" vid="ISA 52:1">ጡራኦን ለመፋ ስት ህንሴነን።<verse eid="ISA 52:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 52:2"/>ያ ዬሩሳሌም፣ አዋረ ኦፍራ ዸዸአዹ፤</para>
  <para style="q2" vid="ISA 52:2">ከኢቲ ቴሶረ ታእ።</para>
  <para style="q1" vid="ISA 52:2">ያ እንተለ ጥዮን ቦጅአምትቲ፣</para>
  <para style="q2" vid="ISA 52:2">ፎንጫ ሞርመኬቲ ኦፍራ ሂክ።<verse eid="ISA 52:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 52:3"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዻቲ፦</para>
  <para style="q1" vid="ISA 52:3">“እስን ገቲ መሌ ጉርጉረምተኒ ቱርተን፤</para>
  <para style="q2" vid="ISA 52:3">አመሞ ማለቀ መሌ ፉረምተን።”<verse eid="ISA 52:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 52:4"/>
    <char style="nd">ዋቀዮ</char> ጎፍታን አከነ ጄዻቲ፦</para>
  <para style="q1" vid="ISA 52:4">“ጀልቀበት ሰብንኮ ጅራቹፍ ጄዼ ግብጥት ገድ ቡኤ፤</para>
  <para style="q2" vid="ISA 52:4">ኤርገሲ አሶር ሰበቢ መሌ እሳን ጩንቁርሴ።<verse eid="ISA 52:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 52:5"/>“ዮስ አን አመ ማለን አሲ ቀበ?” ጄዸ <char style="nd">ዋቀዮ</char>።</para>
  <para style="q1" vid="ISA 52:5">“ሰብንኮ ሰበቢ መሌ ፉዸተሜረ፤</para>
  <para style="q2" vid="ISA 52:5">ወር እሳን ቡልቸንስ ንቆሱ” ጄዸ <char style="nd">ዋቀዮ</char>።</para>
  <para style="q1" vid="ISA 52:5">“ጉያ ጉቱስ፣</para>
  <para style="q2" vid="ISA 52:5">መቃንኮ እቱመ ፉፌ አረብሰመ።<verse eid="ISA 52:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 52:6"/>ከናፉ ሰብንኮ መቃኮ ንቤከ፤</para>
  <para style="q2" vid="ISA 52:6">ከናፉ እሳን ጋፈስ ከን ዱራን ዱርሴ ዋን ሰነ ዱበቴ</para>
  <para style="q1" vid="ISA 52:6">አከ አነ ተኤ ንቤኩ።</para>
  <para style="q2" vid="ISA 52:6">ኤዬ፣ እን አኑመ።”<verse eid="ISA 52:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 52:7"/>ሚል ወረ ወንጌለ ፍደኒ፣</para>
  <para style="q2" vid="ISA 52:7">ከን ነጋ ለብሰኒ፣</para>
  <para style="q1" vid="ISA 52:7">ከን ኦዱ ገመቺሳ ፍደኒ፣</para>
  <para style="q2" vid="ISA 52:7">ከን ፈይነ ለብሰኒ፣ ከን ጥዮኒን፣</para>
  <para style="q1" vid="ISA 52:7">“ዋቅንኬ ሞኤረ!” ጄዸኒ</para>
  <para style="q2" vid="ISA 52:7">ቱሉወንረት አከም ሚዸጋዸ!<verse eid="ISA 52:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 52:8"/>ዸጌፈዹ! ኤግዶንኬ ሰገሌሳኒ ኦል ፉዸተኒሩ፤</para>
  <para style="q2" vid="ISA 52:8">እሳን ቶኩማዻን ገመቹዻን እዩ።</para>
  <para style="q1" vid="ISA 52:8">ዬሮ <char style="nd">ዋቀዮ</char> ጥዮንት ዴብኡት፣</para>
  <para style="q2" vid="ISA 52:8">እሳን እጁመሳኒቲን ንአርጉ።<verse eid="ISA 52:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 52:9"/>ያ ዲገምቶተ ዬሩሳሌም</para>
  <para style="q2" vid="ISA 52:9">ቶኩማዻን ፋርፈትና ገመቹ ፋርፈዻ፤</para>
  <para style="q1" vid="ISA 52:9">
    <char style="nd">ዋቀዮ</char> ኡመተሳ ጀጀቤሴ</para>
  <para style="q2" vid="ISA 52:9">ዬሩሳሌምንስ ፉሬራ።<verse eid="ISA 52:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 52:10"/>
    <char style="nd">ዋቀዮ</char> ፉለ ሰቦተ ሁንዳ ዱረት፣</para>
  <para style="q2" vid="ISA 52:10">እሬሳ ቁልቁሉ ሰነ ንሙልእሰ፤</para>
  <para style="q1" vid="ISA 52:10">ሀንዳር ለፋ ሁንድስ</para>
  <para style="q2" vid="ISA 52:10">ፈይሱ ዋቀኬኛ ንአርጉ።<verse eid="ISA 52:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 52:11"/>እስን ወር ምአ <char style="nd">ዋቀዮ</char> ባተን፣ አዳን በኣ፤</para>
  <para style="q2" vid="ISA 52:11">አዳን በኣ፤ አቺ ፈጋዻ!</para>
  <para style="q1" vid="ISA 52:11">ዋን ጡራኣ ቶኮሌ ህንቱቅና!</para>
  <para style="q2" vid="ISA 52:11">እሼ ኬሳ በኣቲ ቁልቁሎተ ተአ።<verse eid="ISA 52:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 52:12"/>እስን ገሩ አሪቲዻን አቺ ህንባተን፤</para>
  <para style="q2" vid="ISA 52:12">ዮካን በቀተኒ ህንዴምተን፤</para>
  <para style="q1" vid="ISA 52:12">
    <char style="nd">ዋቀዮ</char> ፉለኬሰን ዱረ ዴማቲ፤</para>
  <para style="q2" vid="ISA 52:12">ዋቅን እስራኤል ዱግደ ዱባን እስን ኤገ።<verse eid="ISA 52:12"/></para>
  <para style="s1">ዽጵናፊ ኡልፍነ ገርብቸ ሰና</para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 52:13"/>ኩኖ፣ ገርብችኮ ኦጉማዻን ሆጄተ፤</para>
  <para style="q2" vid="ISA 52:13">እን ንከበጀመ፤ ኦል ካፈመ፤ ኡልፍነ ጉዳስ ንአርገተ።<verse eid="ISA 52:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 52:14"/>ነሞትን ባይኤን ዋኤሳ ሀመ ነአንት፣</para>
  <para style="q2" vid="ISA 52:14">ፉልሳ ነመ ሁንዱማ ጫላ ጎልጎላኤረ፤</para>
  <para style="q2" vid="ISA 52:14">ብፍትሳስ ነመ ሁንዱማ ጫላ በዴረ፤<verse eid="ISA 52:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 52:15"/>አከሲንስ እን ሰቦተ ሄዱ ድንቅሲፈቺሰ፤</para>
  <para style="q2" vid="ISA 52:15">ሞቶትን ሰበቢሳቲፍ አፋንሳኒ ቀበቱ።</para>
  <para style="q1" vid="ISA 52:15">እሳን ዋን እሳንት ህንህመምን አርጉቲ፤</para>
  <para style="q2" vid="ISA 52:15">ዋን ህንዸገእንስ ንሁበቱ።<verse eid="ISA 52:15"/></para>
  <para style="b"/>
  <chapter eid="ISA 52"/>
  <chapter number="53" style="c" sid="ISA 53"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 53:1"/>ኤርጋኬኘ ኤኙቱ አመኔ?</para>
  <para style="q2" vid="ISA 53:1">እሬን <char style="nd">ዋቀዮስ</char> ኤኙት ሙልአቴ?<verse eid="ISA 53:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 53:2"/>እን ፉለሳ ዱረት አኩመ ብቅልቱ ክቹ፣</para>
  <para style="q2" vid="ISA 53:2">አኩመ ህደ ለፈ ጎጋ ኬሳ በኡ ቶኮት ጉደቴ።</para>
  <para style="q1" vid="ISA 53:2">አከ ኑ እሰ እላሉፍ፣ እን ብፈ ህንቶሉ፣ <optbreak/> ዮካን ስምቦ ህንቀቡ፤</para>
  <para style="q2" vid="ISA 53:2">አከ ኑ እሰ ሀውኑፍስ ሚዸግነ ህንቀቡ።<verse eid="ISA 53:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 53:3"/>እን ነመ ብረት ቱፈተሜ ጅበሜ፤</para>
  <para style="q2" vid="ISA 53:3">እን ነመ ገዳፊ ገደደሙን ጅራቱዸ።</para>
  <para style="q1" vid="ISA 53:3">አኩመ ነመ ነሞትን ፉለሳኒራ ገረገልፈተኒ፣</para>
  <para style="q2" vid="ISA 53:3">እን ንቱፈተሜ፤ ኑስ ኡልፍነ ህንኬንኔፍ።<verse eid="ISA 53:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 53:4"/>ዹጉማን እን ዹኩበኬኘ ፉዸቴ፤</para>
  <para style="q2" vid="ISA 53:4">ገደኬኘስ ባቴ፤</para>
  <para style="q1" vid="ISA 53:4">ኑ ገሩ አከ ዋን ዋቅን እሰ ዸኤት፣</para>
  <para style="q2" vid="ISA 53:4">አከ ዋን እን ሩኩቴ እሰ ሚዼት እሰ ሄድኔ።<verse eid="ISA 53:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 53:5"/>እን ገሩ ሰበቢ የከኬኛቲፍ ወራነሜ፤</para>
  <para style="q2" vid="ISA 53:5">በሌሳኬኛፍስ ጨጨብሰሜ፤</para>
  <para style="q1" vid="ISA 53:5">ኑ አደበሙሳቲን ነጋ አርገትኔ፤</para>
  <para style="q2" vid="ISA 53:5">መዳኡሳቲንሞ ፈይኔ።<verse eid="ISA 53:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 53:6"/>ሁንድኬኘ አከ ሆላ</para>
  <para style="q2" vid="ISA 53:6">ከራራ በድኔ ቱሬ፤</para>
  <para style="q1" vid="ISA 53:6">ቶኮን ቶኮንኬኘ ገረ ከራኬኛት ጎሬ፤</para>
  <para style="q2" vid="ISA 53:6">
    <char style="nd">ዋቀዮስ</char> በሌሳ ሁንደኬኛ እሰረ ካኤ።<verse eid="ISA 53:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 53:7"/>እን ንጩንቁርፈሜ፤ ንዽጰቴስ፤</para>
  <para style="q2" vid="ISA 53:7">ገሩ አፋንሳ ህንሳቀትኔ፤</para>
  <para style="q1" vid="ISA 53:7">እን አኩመ እልሞ ሆላ ከን እዶ ቀልማት ጌፈሙ፣</para>
  <para style="q2" vid="ISA 53:7">አኩመ ሆላ ፉለ ነመ ርፌንሰራ ሙርሙሩ ዱረት ጨልእሱ፣</para>
  <para style="q2" vid="ISA 53:7">አከሱመ አፋንሳ ህንሳቀትኔ።<verse eid="ISA 53:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 53:8"/>እን ጩንቁርሳፊ ሙርቲዻን ፉዸተሜ።</para>
  <para style="q2" vid="ISA 53:8">ኤኙቱ ዋኤ ዸሎተሳ ዱበቹ ደንደአ?</para>
  <para style="q1" vid="ISA 53:8">እን ብየ ጅራቶታራ ኩተሜራቲ፤</para>
  <para style="q2" vid="ISA 53:8">ዶጎጎረ ሰበኮቲፍስ ሩኩተሜረ።<verse eid="ISA 53:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 53:9"/>እን ጎሊ ካሱ ባቱዩ፣</para>
  <para style="q2" vid="ISA 53:9">ዮካን ሶብን አፋንሳቲ በኡ ባቱዩ</para>
  <para style="q1" vid="ISA 53:9">አከ አዋልሳ ሀሞተ ወጅን</para>
  <para style="q2" vid="ISA 53:9">ዱትሳስ ሶሬዪ ወጅን ተኡ ጎዸን።<verse eid="ISA 53:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 53:10"/>ተኡስ እሰ ድርመሜሱፊ እሰ ዽጵሱን ፌዺ <char style="nd">ዋቀዮ</char> ቱሬ፤</para>
  <para style="q2" vid="ISA 53:10">
    <char style="nd">ዋቀዮ</char> ሉቡሳ ኣርሳ የካ ጎዹዩ</para>
  <para style="q1" vid="ISA 53:10">እን ሰኚሳ ንአርገ፤ ኡሙሪሳስ ንዼሬሰ፤</para>
  <para style="q2" vid="ISA 53:10">ፌዺን <char style="nd">ዋቀዮስ</char> ሀርከሳት ንራወተመ።<verse eid="ISA 53:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 53:11"/>እን ኤርገ ሉቡንሳ ዽጰቴ ቦዴ፣</para>
  <para style="q2" vid="ISA 53:11">እፈ ንአርገ፤ ንገመደስ፤</para>
  <para style="q1" vid="ISA 53:11">ገርብችኮ ቀጄላን ሱን ቤኩምሰሳቲን ነሞተ ባይኤ <optbreak/> ቀጄልቶተ ታስሰ፤</para>
  <para style="q2" vid="ISA 53:11">የከሳኒስ ንባተ።<verse eid="ISA 53:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 53:12"/>ከናፉ አን ጉርጉዶተ ግዱት ቆደ ነንኬናፍ፤</para>
  <para style="q2" vid="ISA 53:12">እንስ ጀጀቦተ ወጅን ቦጁ ንቆደተ፤</para>
  <para style="q1" vid="ISA 53:12">እን ሉቡሳ ዱኣፍ ኬኔ</para>
  <para style="q2" vid="ISA 53:12">የክቶተት ለካአሜራቲ።</para>
  <para style="q1" vid="ISA 53:12">ተኡስ እን ጩቡ ነመ ሄዱ ባቴ</para>
  <para style="q2" vid="ISA 53:12">የከምቶታፍ አራረ ቡሴረ።<verse eid="ISA 53:12"/></para>
  <chapter eid="ISA 53"/>
  <chapter number="54" style="c" sid="ISA 54"/>
  <para style="s1">ኡልፍነ ኤጌሬ ጥዮን</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 54:1"/>“ያ ዱበርቲ ዸብዱ፣</para>
  <para style="q2" vid="ISA 54:1">ከን ተኩማ ህንደእን፣ አመ ፋርፈዹ፤</para>
  <para style="q1" vid="ISA 54:1">አት ከን ተኩማ ጭኒንስፈቴ ህንቤክን እዪ ፋርፈዹ፤</para>
  <para style="q2" vid="ISA 54:1">ጉድሲቲ እልልች።</para>
  <para style="q1" vid="ISA 54:1">እጆሌ ዱበርቲ ዽርሰ ቀብዱ ጫላ</para>
  <para style="q2" vid="ISA 54:1">እጆሌን ዱበርቲ ገተምቴ ንባይአቱ”</para>
  <para style="q2" vid="ISA 54:1">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="ISA 54:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 54:2"/>“እዶ ዱንካነኬቲ በልእፈዹ፤</para>
  <para style="q2" vid="ISA 54:2">ጎልጋ ዱንካነኬቲ በልእሲ ድሪርስ፤</para>
  <para style="q2" vid="ISA 54:2">ወልት ህንደቻስን፤</para>
  <para style="q1" vid="ISA 54:2">ፉኞኬ ዼሬፈዹ፤</para>
  <para style="q2" vid="ISA 54:2">ቆፎኬስ ጀቤፈዹ።<verse eid="ISA 54:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 54:3"/>አት ገረ ምርጋቲፊ ገረ ብታት ንበበልአታቲ፤</para>
  <para style="q2" vid="ISA 54:3">ሰኚወንኬ ሰቦተ ንዻሉ፤</para>
  <para style="q2" vid="ISA 54:3">መጋላወንሳኒ ከኔን ዱዋ ሀፈን ኬሰስ ንቁበቱ።<verse eid="ISA 54:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 54:4"/>“ህንሶዳትን፤ አት ህንቃኖፍቱቲ።</para>
  <para style="q2" vid="ISA 54:4">ህንያደእን፤ አት ህንሰልጰቱቲ፤</para>
  <para style="q1" vid="ISA 54:4">ቃኒ እጆሉማኬቲ ንደገተ፤</para>
  <para style="q2" vid="ISA 54:4">ቱፊ ዽርስኬ ስራ ዱናን ስረ ገኤስ ስአች ህንያደቱ።<verse eid="ISA 54:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 54:5"/>ኡማንኬ ዽርሰኬት፤</para>
  <para style="q2" vid="ISA 54:5">መቃንሳስ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡዸ፤</para>
  <para style="q1" vid="ISA 54:5">ቁልቁልች እስራኤል ፉሪኬት፤</para>
  <para style="q2" vid="ISA 54:5">እንስ ዋቀ ጉቱማ ለፋ ጄዸመ።<verse eid="ISA 54:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 54:6"/>
    <char style="nd">ዋቀዮ</char> አከ ዋን አት</para>
  <para style="q2" vid="ISA 54:6">አኩመ ኒቲ ገተምቴ ገራንሼ ገዴ፣</para>
  <para style="q1" vid="ISA 54:6">አከ ኒቲ ደርገጌሳ ከን ጅበምቴት</para>
  <para style="q2" vid="ISA 54:6">ዴብሴ ኦፍት ስ ዋመ” ጄዸ ዋቅንኬ።<verse eid="ISA 54:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 54:7"/>“አን ዬሮ ሙራሳፈን ስ ዺሴ፤</para>
  <para style="q2" vid="ISA 54:7">ገሩ ገረ ላፍነ ጉዳዻን ዴብሴ ስን ፍደ።<verse eid="ISA 54:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 54:8"/>አን ዼከምሰ ጉዳዻን</para>
  <para style="q2" vid="ISA 54:8">ዬሮ ሙራሳፍ ፉለኮ ስ ዾክፈዼን ቱሬ፤</para>
  <para style="q1" vid="ISA 54:8">ገሩ ጃለለ በረ በራቲን፣</para>
  <para style="q2" vid="ISA 54:8">ገራ ሲፍን ላፈ”</para>
  <para style="q2" vid="ISA 54:8">ጄዸ <char style="nd">ዋቀዮ</char> ፉሪንኬ።<verse eid="ISA 54:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 54:9"/>“ወን ኩን አናፍ አኩመ በረ ኖህ፣</para>
  <para style="q2" vid="ISA 54:9">ዬሮ አን እት ብሻን ኖህ ዴብኤ ለፈረ ህንገረገሉ ጄዼ <optbreak/> ከከዼ ሰናት።</para>
  <para style="q1" vid="ISA 54:9">ከናፉ አን አከን ስት ህንኣሬ፣</para>
  <para style="q2" vid="ISA 54:9">ጎንኩማስ ለመተ አከን ስ ህንእፈትኔ ከከዼረ።<verse eid="ISA 54:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 54:10"/>ቱሉወን ራፈመኒ፣</para>
  <para style="q2" vid="ISA 54:10">ጋረን ቡቅፈመንዩ፣</para>
  <para style="q1" vid="ISA 54:10">ጃለል ህንጌደረምኔ ከን አን ሲፍ ቀቡ ገሩ ህንራፈሙ፤</para>
  <para style="q2" vid="ISA 54:10">ዮካን ከኩንኮ ከን ነጋ ህንዲገሙ”</para>
  <para style="q2" vid="ISA 54:10">ጄዸ <char style="nd">ዋቀዮ</char> እን ገራ ሲፍ ላፉ ሱን።<verse eid="ISA 54:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 54:11"/>“ያ መጋላ ሚዸምቴ ከን ደምበሊዻን ገረገልፈምቴ <optbreak/> ነመ ስ ጀጀቤሱ ዸብዴ፣</para>
  <para style="q2" vid="ISA 54:11">አን ዸጋ ገቲ ጉዳቲን ስ እጃሬ</para>
  <para style="q2" vid="ISA 54:11">ሰንፔሪዻንስ ስ ሁንዴሰ።<verse eid="ISA 54:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 54:12"/>አን ፊጤኬ ሉለ ዲማዻን፣</para>
  <para style="q2" vid="ISA 54:12">ከረወንኬ ዶቀ ጨለቅሱን፣</para>
  <para style="q2" vid="ISA 54:12">ደላኬ ሁንደሞ ዸጋወን ገት ጀቤዪዻን ነንእጃረ።<verse eid="ISA 54:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 54:13"/>
    <char style="nd">ዋቀዮ</char> እልማንኬ ሁንደ ንበርሲሰ፤</para>
  <para style="q2" vid="ISA 54:13">ነጋን እጆሌኬቲስ ጉዳ ተአ።<verse eid="ISA 54:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 54:14"/>አት ቀጄሉማዻን ሁንዴፈምተ፤</para>
  <para style="q1" vid="ISA 54:14">ጩንቁርፈሙን ስራ ፈጋተ፤</para>
  <para style="q2" vid="ISA 54:14">ወን ስ ሶዳችሱ ቶኮዩ ህንጅሩ።</para>
  <para style="q1" vid="ISA 54:14">ጎሊን ስራ ፈጌፈመ፤</para>
  <para style="q2" vid="ISA 54:14">ስትዩ ህንዽኣቱ።<verse eid="ISA 54:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 54:15"/>ዮ ነምን ቶኮዩ ሎለ ስት ካሴ አን ኬሳ ህንቀቡ፤</para>
  <para style="q2" vid="ISA 54:15">ነምን ሎለ ስት ካሱ ከምዩ ሀርከ ስት ኬነተ።<verse eid="ISA 54:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 54:16"/>“ኩኖ፣ ከን ቱምቱ ስቢላ ከን ጭሌ ቡፌ</para>
  <para style="q2" vid="ISA 54:16">እብደ ቦቤሴ ምአ ወራና ቱሜ</para>
  <para style="q2" vid="ISA 54:16">ሆጂሳቲፍ ምጄሱ ሰነ ኡሜ አኑመ።</para>
  <para style="q1" vid="ISA 54:16">ከን ነመ ዋ በሌሱ ቶኮ አከ እን በላ ቡሱፍ ኡሜስ አኑመ፤<verse eid="ISA 54:16"/></para>
  <para style="q2">
    <verse number="17" style="v" sid="ISA 54:17"/>ሜሻን ስ ሚዹፍ ቶልፈሜ ከምዩ ህንምልካኡ፤</para>
  <para style="q2" vid="ISA 54:17">አትስ አረበ ስ ህመቱ ሁንደ ኦፍራ ዴብፍተ።</para>
  <para style="q1" vid="ISA 54:17">ኩን ዻለ ተጃጅልቶተ <char style="nd">ዋቀዮት</char>፤</para>
  <para style="q2" vid="ISA 54:17">እንስ ቀጄሉማ እሳን ነራ አርገተኒዸ”</para>
  <para style="q2" vid="ISA 54:17">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="ISA 54:17"/></para>
  <chapter eid="ISA 54"/>
  <chapter number="55" style="c" sid="ISA 55"/>
  <para style="s1">አፌራ ወረ ዼቦተኒፍ ጎዸሜ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 55:1"/>“እስን ወር ዼቦተን ሁንድኑ ኮታ፤</para>
  <para style="q2" vid="ISA 55:1">ገረ ብሻኒ ኮታ፤</para>
  <para style="q1" vid="ISA 55:1">እስን ወር ማለቀ ህንቀብኔ፣</para>
  <para style="q2" vid="ISA 55:1">ኮታቲ ብተዻ፤ ኛዻስ!</para>
  <para style="q1" vid="ISA 55:1">ኮታቲ ማለቃፊ ገቲ መሌ</para>
  <para style="q2" vid="ISA 55:1">ዳዺ ወይኒቲፊ ኣነን ብተዻ።<verse eid="ISA 55:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 55:2"/>እስን ማሊፍ ዋን ቡዴነ ህንተእንት ማለቀ ባፍቱ?</para>
  <para style="q2" vid="ISA 55:2">ዋን ነመ ህንቁብስኔረትስ ማሊፍ ሁምነኬሰን ፍጡ?</para>
  <para style="q1" vid="ISA 55:2">ዸገኣ፤ ነ ዸገኣ፤ ዋን ጋሪ ኛዻ፤</para>
  <para style="q2" vid="ISA 55:2">ሉቡንኬሰንስ ጮማን ሃገመዱ።<verse eid="ISA 55:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 55:3"/>ጉረ ናፍ ኬናቲ ገረኮ ኮታ፤</para>
  <para style="q2" vid="ISA 55:3">አከ ሉቡንኬሰን ጅራቱፍስ ነ ዸገኣ።</para>
  <para style="q1" vid="ISA 55:3">አን ከኩ በረ በራ እስን ወጅን ነንገለ፤</para>
  <para style="q2" vid="ISA 55:3">እንስ ጃለለ አመነማ እሰ ዳዊት <optbreak/> አብደቺፈሜ ሰናዸ፤<verse eid="ISA 55:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 55:4"/>ኩኖ አን ሰቦታፍ ዹገ ባቱ እሰ ጎዼረ፤</para>
  <para style="q2" vid="ISA 55:4">ሆገናፊ አጀጃ ሰቦታስ እሰ ታስሴረ።<verse eid="ISA 55:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 55:5"/>ሰበቢ <char style="nd">ዋቀዮ</char> ዋቅንኬ፣</para>
  <para style="q2" vid="ISA 55:5">ቁልቁልች እስራኤል ሱን፣ ኡልፍነ ሲፍ ኬኔፍ፣</para>
  <para style="q1" vid="ISA 55:5">አት ዹጉማን ሰቦተ ህንቤክኔ ንዋምተ፤</para>
  <para style="q2" vid="ISA 55:5">ሰቦትን ስ ህንቤክኔስ አሪቲዻን ገረኬ ዹፉ።”<verse eid="ISA 55:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 55:6"/>ዬሮ እን አርገሙት <char style="nd">ዋቀዮን</char> በርባደዻ፤</para>
  <para style="q2" vid="ISA 55:6">ዬሮ እን ዽኦ ጅሩትስ እሰ ዋመዻ።<verse eid="ISA 55:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 55:7"/>ነምን ሀማን ከራሳ፣</para>
  <para style="q2" vid="ISA 55:7">ነምን ጀልኣንሞ ያደሳ ሃዺሱ።</para>
  <para style="q1" vid="ISA 55:7">እን ገረ <char style="nd">ዋቀዮት</char> ሃዴብኡ፤ እንስ ንአራረማፍ፤</para>
  <para style="q2" vid="ISA 55:7">ገረ ዋቀኬኛት ሃዴብኡ፤ ዺፈምንሳ ባይኤዻቲ።<verse eid="ISA 55:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 55:8"/>“ያድንኮ ያደኬሰን፣</para>
  <para style="q2" vid="ISA 55:8">ከራንኬሰንስ ከራኮ ምት”</para>
  <para style="q2" vid="ISA 55:8">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="ISA 55:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 55:9"/>“አኩመ ሰሚወን ለፈራ ኦል ፈጋተን ሰነ፣</para>
  <para style="q2" vid="ISA 55:9">ከራንኮ ከራኬሰንራ፣</para>
  <para style="q2" vid="ISA 55:9">ያድንኮስ ያደኬሰንራ ኦል ፈጎዸ።<verse eid="ISA 55:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 55:10"/>አኩመ ቦካፊ ጨቢን ሰሚዻ ሮቡ ሰነ፣</para>
  <para style="q2" vid="ISA 55:10">አከ ለፍት ብቅለ ብቅልችቴ እሰ ፈጫፈቱፍ ሰኚ፣</para>
  <para style="q1" vid="ISA 55:10">እሰ ኛቱፍሞ ቡዴነ ኬንቱፍ መሌ</para>
  <para style="q2" vid="ISA 55:10">ኡቱ እሼ ህንቁብስን ህንዴብኔ ሰነ፣<verse eid="ISA 55:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 55:11"/>ዱቢንኮ ከን አፋንኮቲ በኡስ</para>
  <para style="q2" vid="ISA 55:11">ፌዺኮ ራወተ፤</para>
  <para style="q1" vid="ISA 55:11">ካዮ አን እሰ ኤርጌፍስ ገልማን ገአ መሌ</para>
  <para style="q2" vid="ISA 55:11">ሀርከ ዱዋ ገረኮት ህንዴብኡ።<verse eid="ISA 55:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 55:12"/>እስን ገመቹዻን ባቱ፤</para>
  <para style="q2" vid="ISA 55:12">ነጋዻን ጌጌፈምቱ፤</para>
  <para style="q1" vid="ISA 55:12">ቱሉወኒፊ ጋረን፣</para>
  <para style="q2" vid="ISA 55:12">ፉለኬሰን ዱረት እልልቸኒ ፋርፈቱ፤</para>
  <para style="q1" vid="ISA 55:12">ሙኬን ድሬ ሁንድኑስ</para>
  <para style="q2" vid="ISA 55:12">ሀርከ ወልት ሩኩቱ።<verse eid="ISA 55:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 55:13"/>ቆደ ቆራቲ ብርብርስ፣</para>
  <para style="q2" vid="ISA 55:13">ቆደ ሶኮሩስ ኩሳዬን ንብቅለ።</para>
  <para style="q1" vid="ISA 55:13">ኩንስ <char style="nd">ዋቀዮፍ</char> ያደኖ፣</para>
  <para style="q2" vid="ISA 55:13">መለቶ በረ በራ ከን ህንበድኔ ተአ።”<verse eid="ISA 55:13"/></para>
  <chapter eid="ISA 55"/>
  <chapter number="56" style="c" sid="ISA 56"/>
  <para style="s1">ፈይነ ወረ ካኒፍ ኬነሜ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 56:1"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="ISA 56:1">ሰበቢ ፈይሱንኮ ዽኣቴፊ</para>
  <para style="q2" vid="ISA 56:1">ቀጄሉማንኮ ደፌ ሙልአቱፍ፣</para>
  <para style="q1" vid="ISA 56:1">“ሙርቲ ቀጄላ ኤጋ፤</para>
  <para style="q2" vid="ISA 56:1">ዋን ቀጄላስ ሆጄዻ።<verse eid="ISA 56:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 56:2"/>ነምን ዋን ከነ ሆጄቱ፣</para>
  <para style="q2" vid="ISA 56:2">ከን ዋን ከነትስ ጭሙ፣</para>
  <para style="q1" vid="ISA 56:2">ከን ሰንበተ ኡቱ ህንጡሬስን <optbreak/> ኤጉፊ ዋን ሀማ ከምዩ</para>
  <para style="q2" vid="ISA 56:2">ሆጄቹራ ሀርከሳ ኤገቱ ኤብፈማዸ።”<verse eid="ISA 56:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 56:3"/>አለጋን <char style="nd">ዋቀዮት</char> ጭቼ ቶኮ፣</para>
  <para style="q2" vid="ISA 56:3">“<char style="nd">ዋቀዮ</char> ዹጉማን <optbreak/> ሰበሳራ አዳን ነ ባሰ” ህንጄዽን።</para>
  <para style="q1" vid="ISA 56:3">ጡኣሺን ከምዩስ፣</para>
  <para style="q2" vid="ISA 56:3">“አን ሙኩመ ጎጋዸ” ኦፊን ህንጄዽን።<verse eid="ISA 56:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 56:4"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዻቲ፦</para>
  <para style="q1" vid="ISA 56:4">“ጡኣሺወን ሰንበቶተኮ ኤገን፣</para>
  <para style="q2" vid="ISA 56:4">ከኔን ዋን ነ ገመቺሱ</para>
  <para style="q2" vid="ISA 56:4">ፍለተኒፊ ከኩኮ ጀቤሰኒ ኤገኒፍ፣<verse eid="ISA 56:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 56:5"/>አን መነ ቁልቁሉማኮቲፊ</para>
  <para style="q2" vid="ISA 56:5">ደላሳ ኬሰት ያደኖፊ መቃ</para>
  <para style="q2" vid="ISA 56:5">እልማኒፊ እንተለን ጫሉ ቶኮ ነንኬናፍ፤</para>
  <para style="q1" vid="ISA 56:5">አን መቃ በረ በራ</para>
  <para style="q2" vid="ISA 56:5">ከን ህንሀቀምኔ እሳኒፍ ነንኬነ።<verse eid="ISA 56:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 56:6"/>አለጎተ እሰ ተጃጅሉፍ፣</para>
  <para style="q2" vid="ISA 56:6">መቃ <char style="nd">ዋቀዮ</char> ጃለቹፍ፣</para>
  <para style="q1" vid="ISA 56:6">እሰ ዋቄፈቹፍ</para>
  <para style="q2" vid="ISA 56:6">
    <char style="nd">ዋቀዮት</char> ጭቸን</para>
  <para style="q1" vid="ISA 56:6">ከኔን ሰንበተ ኡቱ ህንጡሬስን ኤገኒፊ</para>
  <para style="q2" vid="ISA 56:6">ከኩኮስ ጭምሰኒ ኤገን ሁንደ፣<verse eid="ISA 56:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 56:7"/>አን ገረ ቱሉኮ ቁልቁሉት እሳን ነንፍደ፤</para>
  <para style="q2" vid="ISA 56:7">መነ ከዸትናኮ ኬሰትስ ገመቹ እሳኒፍ ነንኬነ።</para>
  <para style="q1" vid="ISA 56:7">ኣርሳንሳኒ ከን ጉበሙፊ ቀልም፣</para>
  <para style="q2" vid="ISA 56:7">እዶ ኣርሳኮረት ፉዸተመ ንአርገተ፤</para>
  <para style="q1" vid="ISA 56:7">መንኮ ሰቦተ ሁንዳፍ፣</para>
  <para style="q2" vid="ISA 56:7">መነ ሰገዳ ጄዸሜ ዋመማቲ።”<verse eid="ISA 56:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 56:8"/>
    <char style="nd">ዋቀዮ</char> ጎፍታን፣</para>
  <para style="q2" vid="ISA 56:8">እን እስራኤሎተ ብትናአን ወልት ቀቡ ሱን አከነ ጄዸ፦</para>
  <para style="q1" vid="ISA 56:8">“አን ወረ ዱራን ወልት ቀበመን ብረት፣</para>
  <para style="q2" vid="ISA 56:8">ወረ ካንስ ገረ እሳኒት ወልት ነንቀበ።”<verse eid="ISA 56:8"/></para>
  <para style="s1">ዋቅን ዱረ ቡኦተ እስራኤል ህመቴ</para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 56:9"/>ብኔንሶትን ድሬ ሁንድ፣</para>
  <para style="q2" vid="ISA 56:9">ብኔንሶትን ቦሶና ሁንድስ ኮታቲ እት ገገባ ኛዻ!<verse eid="ISA 56:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 56:10"/>ኤግዶን እስራኤል ጃሞተ፣</para>
  <para style="q2" vid="ISA 56:10">እሳን ሁንድ ቤኩምሰ ህንቀበን፤</para>
  <para style="q1" vid="ISA 56:10">ሁንድሳኒ ሰሮተ ዱዳዸ፤</para>
  <para style="q2" vid="ISA 56:10">ዱቱስ ህንደንደአን፤</para>
  <para style="q1" vid="ISA 56:10">እሳን ጪሰኒ አብጆቱ፤</para>
  <para style="q2" vid="ISA 56:10">ረፉስ ንጃለቱ።<verse eid="ISA 56:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 56:11"/>እሳን ሰሮተ አልባዼዪዸ፤</para>
  <para style="q2" vid="ISA 56:11">ኛተኒስ ህንቁፈን።</para>
  <para style="q1" vid="ISA 56:11">እሳን ትክሶተ ሁበትና ህንቀብኔዸ፤</para>
  <para style="q2" vid="ISA 56:11">ሁንድሳኒ ዳንዲ ኦፊሳኒረ ዴሙ፤</para>
  <para style="q2" vid="ISA 56:11">ቶኮን ቶኮንሳኒ ፋይዳ ኦፊሳኒ በርባዱ።<verse eid="ISA 56:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 56:12"/>ቶኮን ቶኮንሳኒ አከነ ጄዹ፤ <optbreak/> “ኮታ ዳዺ ወይኒ ዹግና!</para>
  <para style="q2" vid="ISA 56:12">ኮታ ዹጋቲ ጭማ ዹግኔ ቁፍና!</para>
  <para style="q1" vid="ISA 56:12">ጉያን ቦሪ አኩመ ሀርኣ ተአ፤</para>
  <para style="q2" vid="ISA 56:12">ዮካን ጫሉዩ ንደንደአ።”<verse eid="ISA 56:12"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 56"/>
  <chapter number="57" style="c" sid="ISA 57"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 57:1"/>ነምን ቀጄላን ንዱአ፤</para>
  <para style="q2" vid="ISA 57:1">ከን ዋን ከነ ያደት ቀበቱ ቶኮዩ ህንጅሩ፤</para>
  <para style="q1" vid="ISA 57:1">ወር ዋቃፍ ኦፍ ኬነን ንፉዸተሙ፤</para>
  <para style="q2" vid="ISA 57:1">አከ ቀጄልቶትን</para>
  <para style="q1" vid="ISA 57:1">ዋን ሀማ ጀላ በራረሙፍ ፉዸተመን</para>
  <para style="q2" vid="ISA 57:1">ነምን ቶኮዩ ህንሁበቱ።<verse eid="ISA 57:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 57:2"/>ነምን ቀጄሉማዻን ጅራቱ፣</para>
  <para style="q2" vid="ISA 57:2">ገረ ነጋ ሴነ፤</para>
  <para style="q2" vid="ISA 57:2">እሳን ስሬሳኒረ ቦቆቱ።<verse eid="ISA 57:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 57:3"/>“እስን ገሩ ያ እልማን ፈልፈልትቲ፣</para>
  <para style="q2" vid="ISA 57:3">እስን ሰኚን ኤጅቱቲፊ ሰጋገልቱ አስ ኮታ!<verse eid="ISA 57:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 57:4"/>እስን ኤኙት ቆስቱ?</para>
  <para style="q2" vid="ISA 57:4">ኤኙት አፋን በነቱ?</para>
  <para style="q2" vid="ISA 57:4">ኤኙትስ አረበ ባፍቱ?</para>
  <para style="q1" vid="ISA 57:4">እስን እልማን ፍንጭልቶታ፣</para>
  <para style="q2" vid="ISA 57:4">ሰኚ ሶብዶታ ምቲ?<verse eid="ISA 57:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 57:5"/>እስን ሙኬን ቅልጡ ግዱት፣</para>
  <para style="q2" vid="ISA 57:5">ሙኬን ደጋገን ሁንደ ጀለት ሀዊ ሀማዻን ጉበተን፤</para>
  <para style="q1" vid="ISA 57:5">ሱሉሎተ ኬሰት፣</para>
  <para style="q2" vid="ISA 57:5">ሆልቀ ከታ ኬሰትስ እጆሌኬሰን ቀልተን።<verse eid="ISA 57:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 57:6"/>ዸጋወን ጩሉሉቆን ሱሉለ ኬሳ ቆደኬት፤</para>
  <para style="q2" vid="ISA 57:6">ዹጉማን ጨራንኬ እሳኑመ።</para>
  <para style="q1" vid="ISA 57:6">አት ዽባዩ እሳኒፍ ዸንገላፍቴ፤</para>
  <para style="q2" vid="ISA 57:6">ኣርሳ ምዻኒ እሳኒፍ ዽኤስቴርተ።</para>
  <para style="q2" vid="ISA 57:6">አን ወንቶተ ከኔን ጨልእሴ ነንእላላ?<verse eid="ISA 57:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 57:7"/>አት ስሬኬ ቱሉ ጉዳፊ ኦል ዼራረ ዻበቴርተ፤</para>
  <para style="q2" vid="ISA 57:7">ኣርሳኬ ዽኤፈቹፍስ አች ኦል ባቴ።<verse eid="ISA 57:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 57:8"/>አት ጩፋኬቲፊ ምችችለ ጩፋኬቲ ዱባን፣</para>
  <para style="q2" vid="ISA 57:8">ያደኖኬ ፈንፈቴርተ።</para>
  <para style="q1" vid="ISA 57:8">አነ ዺፍቴ ስሬኬ ሳቀቴ፤</para>
  <para style="q2" vid="ISA 57:8">ያብዴስ በልእፍቴ በነቴ ኬሰ ሴንቴ፤</para>
  <para style="q1" vid="ISA 57:8">አት ወረ ስሬሳኒ ጃለቴ</para>
  <para style="q2" vid="ISA 57:8">ወጅን ወሊ ገልቴ ሰነ ቁላሳኒ እላልቴ።<verse eid="ISA 57:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 57:9"/>አት ዘይቲ ኤጄርሳ ፉዸቴ ገረ ሞሌክ ዸቅጤ፤</para>
  <para style="q2" vid="ISA 57:9">ሽቶኬሌ ንባይእፈቴ።</para>
  <para style="q1" vid="ISA 57:9">ኤርገሞተኬ ብየ ፈጎት ኤርግቴ፤</para>
  <para style="q2" vid="ISA 57:9">ሲኦልትስ ገድ ኤርግቴ!<verse eid="ISA 57:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 57:10"/>ዼርነ ከራኬቲቲን ደዸብዴ ቱርቴ፤</para>
  <para style="q2" vid="ISA 57:10">አት ገሩ፣ ‘ወን ኩን ፋይዳ ህንቀቡ’ ህንጄኔ።</para>
  <para style="q1" vid="ISA 57:10">ጀብነ ሃሮምፈሜ አርገቴ፤</para>
  <para style="q2" vid="ISA 57:10">ከናፉ አት ህንደዸብኔ።<verse eid="ISA 57:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 57:11"/>“አት አከ ነ ሶብዱፍ</para>
  <para style="q2" vid="ISA 57:11">አከ ነ ህንያደትኔፍ፣</para>
  <para style="q1" vid="ISA 57:11">ዮካን አከ ዋን ከነ ገራት ህንቀበኔፍ፣</para>
  <para style="q2" vid="ISA 57:11">ኤኙን ሶዳቴ አከስ ናቴ?</para>
  <para style="q1" vid="ISA 57:11">አት ሰበቢ አን ዬሮ ዼራ ጨልእሴፍ፣</para>
  <para style="q2" vid="ISA 57:11">ነ ሶዳቹ ዺፍቴ ምቲ?<verse eid="ISA 57:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 57:12"/>አን ቀጄሉማኬቲፊ ሆጂኬ እፈት ነንባሰ፤</para>
  <para style="q2" vid="ISA 57:12">እሳን ገሩ ስ ህንፈየደን።<verse eid="ISA 57:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 57:13"/>ዬሮ አት ገርጋርሳፍ እይቱት፣</para>
  <para style="q2" vid="ISA 57:13">ሜ ዋቆትን ቶልፈሞን አት ወልት ቀበቴ ሱን ስ ሃባሰን!</para>
  <para style="q1" vid="ISA 57:13">ቡቤን ሁንደሳኒ ፉዸቴ በደ፤</para>
  <para style="q2" vid="ISA 57:13">ሀፉር ባፈተንዩ አፉፌ እሳን በሌሰ።</para>
  <para style="q1" vid="ISA 57:13">ነምን ደአትኖሳ አነ ጎዸቱ ገሩ <optbreak/> ብየቲ ንዻለ፤</para>
  <para style="q2" vid="ISA 57:13">ቱሉኮ ቁልቁሉ ሰነሌ ንዹንፈተ።”<verse eid="ISA 57:13"/></para>
  <para style="s1">አብዲ ወረ ገድ ቀበመኒፍ ኬነሜ</para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 57:14"/>አከነስ ንጄዸመ፦</para>
  <para style="q1" vid="ISA 57:14">“ቶልቻ፤ ቶልቻ፤ ዳንዲ ቆጴሳ!</para>
  <para style="q2" vid="ISA 57:14">ከራ ሰበኮቲራ ጉፉወን ቡቡቅሳ።”<verse eid="ISA 57:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 57:15"/>እን ጉዳኒፊ ኦል ኦል ጄዼ፣</para>
  <para style="q2" vid="ISA 57:15">ከን በረ በራን ጅራቱፊ <optbreak/> ከን መቃንሳ ቁልቁሉ ጄዸሙ ሱን አከነ ጄዸ፦</para>
  <para style="q1" vid="ISA 57:15">“አን እዶ ኦል ከኣፊ እዶ ቁልቁሉረ ነንጅራዸ፤</para>
  <para style="q2" vid="ISA 57:15">ሀፉረ ወረ ገድ ቀበመኒ በየነቺሱፍ፣</para>
  <para style="q1" vid="ISA 57:15">ገራ ወረ ገድ ኦፍ ቀበኒ ጀጀቤሱፍ ገራሚፊ</para>
  <para style="q2" vid="ISA 57:15">ከን ሀፉራን ገድ ቀበሜ ወጅንስ ነንጅራዸ።<verse eid="ISA 57:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 57:16"/>አን በረ በራን ነመት ህንፈልሙ፤</para>
  <para style="q2" vid="ISA 57:16">ዮካን ዬሮ ሁንደ ህንዼከሙ፤</para>
  <para style="q1" vid="ISA 57:16">ዮ አከስ ተኤ ሀፉር ነማ፣</para>
  <para style="q2" vid="ISA 57:16">ሀፉር ነምን አን ኡሜ ባፈቱ ንጭታቲ።<verse eid="ISA 57:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 57:17"/>አን ዸራሳ ከን ጩቡን ጉተሜ ሰነተን ዼከሜ፤</para>
  <para style="q2" vid="ISA 57:17">እሰ አደቤስ ኣሪዻን ፉለኮ እሰ ዱራ ነንዾክፈዼ፤</para>
  <para style="q2" vid="ISA 57:17">እን ገሩ ከሩመ ፌዺሳቲን እት ፉፌ።<verse eid="ISA 57:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 57:18"/>አን ከራሳ አርጌረ፤ ገሩ እሰ ነንፈይሰ፤</para>
  <para style="q2" vid="ISA 57:18">አን እሰ ነንቀጄልቸ፤ ዴብሴስ ነንጀጀቤሰ፤<verse eid="ISA 57:18"/></para>
  <para style="q2">
    <verse number="19" style="v" sid="ISA 57:19"/>አረበ ቦሱወን እስራኤል ኬሰ ጅራተኒረትስ <optbreak/> ገለተ ነንኡመ።</para>
  <para style="q1" vid="ISA 57:19">ወረ ፈጎ ጅራተኒፍ ነጋን፣ ወረ ዽኦ ጅራተኒፍስ ነጋን ሃተኡ።</para>
  <para style="q2" vid="ISA 57:19">አንስ እሳን ነንፈይሰ” ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="ISA 57:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 57:20"/>ነሞትን ሀሞን ገሩ አኩመ ገላነ ኦሊ ገድ ደደርበተሙ፣</para>
  <para style="q2" vid="ISA 57:20">ከን ቦቆቹ ህንደንዴኜ፣</para>
  <para style="q2" vid="ISA 57:20">ከን ደምበሊንሳ ላቂፊ ዾቄ ቱፉት።<verse eid="ISA 57:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 57:21"/>“ነሞተ ሀሞፍ ነጋን ህንጅሩ” ጄዸ ዋቅንኮ።<verse eid="ISA 57:21"/></para>
  <chapter eid="ISA 57"/>
  <chapter number="58" style="c" sid="ISA 58"/>
  <para style="s1">ሶመ ዋቅን እት ገመዱ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 58:1"/>“ጉድሲ እይ፤ ህንቁሰትን።</para>
  <para style="q2" vid="ISA 58:1">አኩመ መለከታ ሰገሌኬ ኦል ፉዸዹ።</para>
  <para style="q1" vid="ISA 58:1">ሰበኮት ፍንጭለሳኒ፣</para>
  <para style="q2" vid="ISA 58:1">መነ ያቆብትሞ ጩቡሳኒ ለብስ።<verse eid="ISA 58:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 58:2"/>እሳን ጉዩመ ጉያን ነ በርባዱቲ፤</para>
  <para style="q2" vid="ISA 58:2">እሳን አኩመ ሰበ ዋን ቀጄላ ሆጄቴ</para>
  <para style="q1" vid="ISA 58:2">አጀጀወን ዋቀሳ ህንዺስን ቶኮት</para>
  <para style="q2" vid="ISA 58:2">ዋን ከራኮ ቤኩ በርባደን ፈካቱ።</para>
  <para style="q1" vid="ISA 58:2">እሳን ሙርቲ ቀጄላ ነ ከዸቱ፤</para>
  <para style="q2" vid="ISA 58:2">አከ ዋቅን እሳንት ዽኣቱስ ዋን ሀወን ፈካቱ።<verse eid="ISA 58:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 58:3"/>እሳንስ፣ ‘ዮ አት ዋን ከነ ህንአርግኔ፣</para>
  <para style="q2" vid="ISA 58:3">ኑ ማሊፍ ሶምኔ?</para>
  <para style="q1" vid="ISA 58:3">ዮ አት ዋን ከነ ህንቀልቤፈትኔ</para>
  <para style="q2" vid="ISA 58:3">ኑ ማሊፍ ገድ ኦፍ ቀብኔ?’ ጄዹ።</para>
  <para style="b" vid="ISA 58:3"/>
  <para style="q1" vid="ISA 58:3">“ተኡስ እስን ጉያ ሶመኬሰኒ ዋን ፌተን ጎተን፤</para>
  <para style="q2" vid="ISA 58:3">ሆጄቶተኬሰን ሁንደስ ንሀጩጨን።<verse eid="ISA 58:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 58:4"/>ሶምንኬሰን ወል ሎሉፊ ወል ቆጮሉዻን፣</para>
  <para style="q2" vid="ISA 58:4">አቦቴ ሀምናቲን ወል ቱሙዻን ራወተ።</para>
  <para style="q1" vid="ISA 58:4">ሶምን እስን ሀርአ ሶማ ጅርተን ኩን፣</para>
  <para style="q2" vid="ISA 58:4">አከ ሰገሌንኬሰን ጉባት ዸገአሙ ህንጎዹ።<verse eid="ISA 58:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 58:5"/>ሶምን አን ፍለዼ ሶመ አከናቲ?</para>
  <para style="q2" vid="ISA 58:5">ነምን ቶኮ ጉዩመ ቶኮ ቆፋፍ ገድ ኦፍ ቀባ?</para>
  <para style="q1" vid="ISA 58:5">ወን ኩን አኩመ ዸላዱ መታ ገድ ቀበቹፊ</para>
  <para style="q2" vid="ISA 58:5">ወያ ገዳቲፊ ዳራረ ጪሱ ቆፋፊ?</para>
  <para style="q1" vid="ISA 58:5">ወን እስን ሶመ ጄተኒን</para>
  <para style="q2" vid="ISA 58:5">ጉያን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ፉዸተመ ቀቡ ከና?<verse eid="ISA 58:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 58:6"/>“ሶምን አን እት ገመዱ፣</para>
  <para style="q1" vid="ISA 58:6">ከን ፎንጫ ጀልእና ፉሩ፣</para>
  <para style="q2" vid="ISA 58:6">ከን ፉኞ ዋንጆ ሂኩ፣</para>
  <para style="q1" vid="ISA 58:6">ከን ጩንቁርፈምቶተ ብልሰ ባሱፊ</para>
  <para style="q2" vid="ISA 58:6">ዋንጆ ሁንደ ጨጨብሱ ምቲ?<verse eid="ISA 58:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 58:7"/>አከ አት ወረ ቤለአኒፍ ኛተኬ ቆዱፊ</para>
  <para style="q2" vid="ISA 58:7">አከ ህዬዪ መነ ህንቀብኔ መነኬት ስመቱ፣</para>
  <para style="q1" vid="ISA 58:7">አከ አት ዬሮ ነመ ዳሬ አርግቱት <optbreak/> ዳረ እሰ ባፍቱፊ</para>
  <para style="q2" vid="ISA 58:7">አከ ነመ ፎኒፊ ዺገኬ ተኤት <optbreak/> ዱግደ ህንገሌ ምቲ?<verse eid="ISA 58:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 58:8"/>ዮስ እፍንኬ አከ ቢፍቱ ገነማ ንበአ፤</para>
  <para style="q2" vid="ISA 58:8">ፈይንኬስ ደፌ ንዹፈ፤</para>
  <para style="q1" vid="ISA 58:8">ቀጄሉማንኬ ፉለኬ ዱረ ዴመ፤</para>
  <para style="q2" vid="ISA 58:8">ኡልፍን <char style="nd">ዋቀዮ</char>ሞ ዱባን ስ ኤገ።<verse eid="ISA 58:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 58:9"/>ዬሮ ሰነ አት ንዋመተ፤ <char style="nd">ዋቀዮስ</char> ዴቢ ሲፍ ኬነ፤</para>
  <para style="q2" vid="ISA 58:9">አት ገርጋርሰ በርባቸ እየተ፤ እንስ፣ ‘አን አሰን ጅረ’ ሲን ጄዸ።</para>
  <para style="b" vid="ISA 58:9"/>
  <para style="q1" vid="ISA 58:9">“አት ዮ ዋንጆ ጩንቁርሳ፣ ሃሰአ ሀምናቲፊ</para>
  <para style="q2" vid="ISA 58:9">ቁበ ነመት ቀቡ ኦፍራ ፈጌስቴ፣<verse eid="ISA 58:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 58:10"/>አት ዮ ወረ ቤለአኒፍ ኛተ ኬንቴ፣</para>
  <para style="q2" vid="ISA 58:10">ወረ ረከተንስ ረክና ባፍቴ፣</para>
  <para style="q1" vid="ISA 58:10">እፍንኬ ዱከነ ኬሰ ንእብሰ፤</para>
  <para style="q2" vid="ISA 58:10">ሀልከንኬስ አከ ጉያ ሳፋ ተአ።<verse eid="ISA 58:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 58:11"/>
    <char style="nd">ዋቀዮ</char> ዬሮ ሁንደ ስ ጌጌሰ፤</para>
  <para style="q2" vid="ISA 58:11">እን ለፈ አዱዻን ጉበቴ ኬሰትዩ <optbreak/> ፌዺኬ ሲፍ ጉተ፤</para>
  <para style="q2" vid="ISA 58:11">ለፌኬስ ንጀቤሰ።</para>
  <para style="q1" vid="ISA 58:11">አት አከ ለፈ ብቅልቱ ብሻን ቁፌ፣</para>
  <para style="q2" vid="ISA 58:11">አከ ቡርቃ ህንጎግኔስ ንታተ።<verse eid="ISA 58:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 58:12"/>ኡመትንኬ ዲገማ ዱሪ ዴብሴ ንእጃረ፤</para>
  <para style="q2" vid="ISA 58:12">አትስ ሁንዴ ዸሎተ ባይኤ ኦል ካስተ፤</para>
  <para style="q1" vid="ISA 58:12">አትስ፣ ሱጳ ደላወን ጅጅገኒ፣</para>
  <para style="q2" vid="ISA 58:12">ሃሮምሳ ዳንዲወን ጅሬኛ ጄዸምቴ ዋመምተ።<verse eid="ISA 58:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 58:13"/>“አት ዮ ሚለኬ ሰንበተ ጨብሱራ ኤገቴ</para>
  <para style="q2" vid="ISA 58:13">ጉያኮ ቁልቁሉ ዋን ጃለቱ ጎቹ ዺፍቴ፣</para>
  <para style="q1" vid="ISA 58:13">አት ዮ ሰንበታን፣ ‘ገመቹ’</para>
  <para style="q2" vid="ISA 58:13">ጉያ ቁልቁላኣ <char style="nd">ዋቀዮቲን</char>ሞ፣ ‘ከበጀማ’ ጄቴ፣</para>
  <para style="q1" vid="ISA 58:13">ዮ ዳንዲ ኦፊኬቲ ዴምቱፊ ዮ ዋን ፌቴ ጎቹ</para>
  <para style="q2" vid="ISA 58:13">ዮካን ሃሳ ፋይዳ ህንቀብኔ ሃሰኡ ባቴ <optbreak/> ሰንበተ ኡልፌስቴ፣<verse eid="ISA 58:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 58:14"/>ዬሮ ሰነ <char style="nd">ዋቀዮት</char> ንገመደ፤</para>
  <para style="q2" vid="ISA 58:14">አንስ አከ አት ለፈ ኦል ዼራረ ጉሉፍቱ፣</para>
  <para style="q2" vid="ISA 58:14">ዻለ አባኬ ያቆብ ኛቴ አከ ቁፍቱስ ስን ታስሰ።”</para>
  <para style="q1" vid="ISA 58:14">አፋን <char style="nd">ዋቀዮ</char> ዱበቴራቲ።<verse eid="ISA 58:14"/></para>
  <chapter eid="ISA 58"/>
  <chapter number="59" style="c" sid="ISA 59"/>
  <para style="s1">ጩቡ፣ በሌሳ ህመቹፊ ፉረመ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 59:1"/>ዹጉማን ሀርክ <char style="nd">ዋቀዮ</char> ፈይሱፍ ገባባ ምት፤</para>
  <para style="q2" vid="ISA 59:1">ዮካን ጉርሳ ዸገኡ ህንድድኔ።<verse eid="ISA 59:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 59:2"/>የክኬሰን ገሩ ዋቀኬሰኒን</para>
  <para style="q2" vid="ISA 59:2">ገርገር እስን ባሴረ፤</para>
  <para style="q1" vid="ISA 59:2">አከ እን እስን ህንዸጌኜፍ፣</para>
  <para style="q2" vid="ISA 59:2">ጩቡንኬሰን ፉለሳ እስን ዱራ ዾክሴረ።<verse eid="ISA 59:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 59:3"/>ሀርክኬሰን ዺጋን፣</para>
  <para style="q2" vid="ISA 59:3">ቁብንኬሰንሞ የካን ፋለሜራቲ።</para>
  <para style="q1" vid="ISA 59:3">አፋንኬሰን ሶበ ዱበተ፤</para>
  <para style="q2" vid="ISA 59:3">አረብንኬሰንሞ ዋን ሀማ ጉንጉመ።<verse eid="ISA 59:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 59:4"/>ነምን ሙርቲ ቀጄላ በርባዱ ህንጅሩ፤</para>
  <para style="q2" vid="ISA 59:4">ከን ህመተሳ አመነሙማዻን ዽኤፈቱ <optbreak/> ቶኮዩ ህንጅሩ።</para>
  <para style="q1" vid="ISA 59:4">እሳን ዋን ፋይዳ ህንቀብኔ አመነተን፤ ሶበ ዱበተን፤</para>
  <para style="q2" vid="ISA 59:4">ጎዎምሳ ኡልፋአኒ ሀምነ ዸለን።<verse eid="ISA 59:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 59:5"/>እሳን ሀንቃቁ ቡቲ ያሰን፤ መንኤ ሰሪቲ ፎአን።</para>
  <para style="q2" vid="ISA 59:5">ነምን ሀንቃቁሳኒ ኛቱ ከምዩ ንዱአ፤</para>
  <para style="q1" vid="ISA 59:5">ዮሙ ቶኮንሳ ጨቡት</para>
  <para style="q2" vid="ISA 59:5">ቡቲቱ ኬሳ በአ።<verse eid="ISA 59:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 59:6"/>ፎኣንሳኒ ኡፈተ ህንተኡ፤</para>
  <para style="q2" vid="ISA 59:6">ዋን ቶልቸኒንስ ዸግነሳኒ ሀጉገቹ ህንደንደአን።</para>
  <para style="q1" vid="ISA 59:6">ሆጂንሳኒ ሆጂ ሀምናት፤</para>
  <para style="q2" vid="ISA 59:6">ሀርከሳኒ ኬሰስ ሆጂ ፍንጭላቱ ጅረ።<verse eid="ISA 59:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 59:7"/>ሚልሳኒ ገረ ጩቡት ፊገ፤</para>
  <para style="q2" vid="ISA 59:7">እሳን ዺገ ቁልቁሉ ዸንገላሱፍ አሪፈተን።</para>
  <para style="q1" vid="ISA 59:7">ያድንሳኒ ጀልኣዸ፤</para>
  <para style="q2" vid="ISA 59:7">ዲጉፊ በርበዴሱን መለቶ ከራሳኒት።<verse eid="ISA 59:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 59:8"/>እሳን ከራ ነጋ ህንቤከን፤</para>
  <para style="q2" vid="ISA 59:8">ሙርቲን ቀጄላን ከራሳኒረ ህንጅሩ።</para>
  <para style="q1" vid="ISA 59:8">ዳንዲሳኒ ጀልእሰኒሩ፤</para>
  <para style="q2" vid="ISA 59:8">ነምን አችረ ዴሙ ቶኮዩ ነጋ ህንቤኩ።<verse eid="ISA 59:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 59:9"/>ከናፉ ሙርቲን ቀጄላን ኑራ ፈጋቴረ፤</para>
  <para style="q2" vid="ISA 59:9">ቀጄሉማንስ ኑ ብረ ህንገኡ።</para>
  <para style="q1" vid="ISA 59:9">ኑ እፈ በርባነ፤ ገሩ ሁንድኑ ዱከነ፤</para>
  <para style="q2" vid="ISA 59:9">እፈ ጉያ በርባነ፤ ገሩ ድምምሰ ኬሰ ዴምነ።<verse eid="ISA 59:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 59:10"/>ኑ አኩመ ጃማ ደላ ቀቀበቻ ዴምነ፤</para>
  <para style="q2" vid="ISA 59:10">አኩመ ወረ እጀ ህንቀብኔ ሀርካን ከራኬኘ በርባደትነ።</para>
  <para style="q1" vid="ISA 59:10">አከ ነመ ሀልከኒን ዴሙ ጉያ ሳፋዻን ጉጉፈትኔ፤</para>
  <para style="q2" vid="ISA 59:10">ነሞተ ጀጀቦ ግዱት አከ ወረ ዱአኒ ታኔረ።<verse eid="ISA 59:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 59:11"/>ኑ ሁንድ አከ አማኬታ ጉሩሪነ፤</para>
  <para style="q2" vid="ISA 59:11">አከ ጉጌስ ገዳን ኣድነ።</para>
  <para style="q1" vid="ISA 59:11">ሙርቲ ቀጄላ በርባነ፤ ገሩ ህንአርገኔ፤</para>
  <para style="q2" vid="ISA 59:11">ፈይነ በርባነ፤ እን ገሩ ኑራ ፈጋቴረ።<verse eid="ISA 59:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 59:12"/>የክኬኘ ፉለኬ ዱረት ባይአቴራቲ፤</para>
  <para style="q2" vid="ISA 59:12">ጩቡንኬኘስ ዹጋ ኑት በአ።</para>
  <para style="q1" vid="ISA 59:12">የክኬኘ ኑ ወጅን ጅራተ፤</para>
  <para style="q2" vid="ISA 59:12">ኑስ በሌሳኬኘ ንቤክነ፤<verse eid="ISA 59:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 59:13"/>ኑ ፍንጭሌ <char style="nd">ዋቀዮን</char> ሶብኔ፤</para>
  <para style="q2" vid="ISA 59:13">ዋቀኬኘ ዱካ ቡኡራ ገረገሌረ፤</para>
  <para style="q1" vid="ISA 59:13">ጎሊፊ ፍንጭለ ከካፍኔረ፤</para>
  <para style="q2" vid="ISA 59:13">ሶበ ገራንኬኘ ያዴስ ዱበኔረ።<verse eid="ISA 59:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 59:14"/>ከናፉ ሙርቲ ቀጄላን ዱበት ዴብፈሜረ፤</para>
  <para style="q2" vid="ISA 59:14">ቀጄሉማንስ ፈጎ ዻበተ፤</para>
  <para style="q1" vid="ISA 59:14">ዹጋን ከራት ጉፈቴ፤</para>
  <para style="q2" vid="ISA 59:14">ቶልስ ኦል ሴኑ ህንደንደኡ።<verse eid="ISA 59:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 59:15"/>ዹጋን ኤሱመቱ ህንአርገሙ፤</para>
  <para style="q2" vid="ISA 59:15">ነምን ጩቡራ ፈጋቱስ ዋን ሀማፍ ሳጥለመ።</para>
  <para style="b" vid="ISA 59:15"/>
  <para style="q1" vid="ISA 59:15">
    <char style="nd">ዋቀዮ</char> አከ ሙርቲ ቀጄላን ህንጅሬ አርጌ፤</para>
  <para style="q2" vid="ISA 59:15">ኩንስ እሰ ገድሲሴ።<verse eid="ISA 59:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 59:16"/>እን አከ ነምን ቶኮዩ ህንጅሬ አርጌ፤</para>
  <para style="q2" vid="ISA 59:16">ከን ገረሳት ከዸትና ዽኤሱ ዋን ዸበሜፍስ <optbreak/> ንድንቅሲፈቴ።</para>
  <para style="q1" vid="ISA 59:16">ከናፉ እሬንሳ ፈይነሳ ፍዴ፤</para>
  <para style="q2" vid="ISA 59:16">ቀጄሉማን ኦፊሳስ እሰ ኡቱቤ።<verse eid="ISA 59:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 59:17"/>ቀጄሉማ አከ ጋቸነ ቆማት ካአቴ</para>
  <para style="q2" vid="ISA 59:17">ጎንፎ ፈይናስ መታት ጎምብፈቴ፤</para>
  <para style="q1" vid="ISA 59:17">ወያ እቲን ሃሎ በኡ ኡፈቴ</para>
  <para style="q2" vid="ISA 59:17">አከ ነመ ዋሮ ኡፈቱትስ ህናፋ ኦፍት መረቴ።<verse eid="ISA 59:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 59:18"/>ከናፉ እን አኩመ ሆጂሳኒት፣</para>
  <para style="q2" vid="ISA 59:18">ዲኖተሳቲፍ ዼከምሰ፣</para>
  <para style="q1" vid="ISA 59:18">አመጃጆተሳኒቲፍሞ አደቢ መሉ ንኬነ፤</para>
  <para style="q2" vid="ISA 59:18">ብዮተ ብሻን ግዱቲፍስ ሆጂ ሀርከሳኒ ኬናፍ።<verse eid="ISA 59:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 59:19"/>ነሞትን ልጠ ቢፍቱ መቃ <char style="nd">ዋቀዮ</char> ሶዳቱ፤</para>
  <para style="q2" vid="ISA 59:19">ወር በአ ቢፍቱት አርገመንሞ ኡልፍነሳ ከበጁ።</para>
  <para style="q1" vid="ISA 59:19">እን አኩመ ሎላ፣</para>
  <para style="q2" vid="ISA 59:19">ከን ቡቤን <char style="nd">ዋቀዮ</char> ኦፉት ንዹፋቲ።<verse eid="ISA 59:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 59:20"/>“ፉራን ገረ ጥዮን፣ ገረ ወረ መነ ያቆብ ኬሳ</para>
  <para style="q2" vid="ISA 59:20">ቀልቢ ጅጂረተኒ ንዹፈ”</para>
  <para style="q2" vid="ISA 59:20">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="ISA 59:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 59:21"/>“ገመኮቲን ከኩንኮ ከን አን እሳን ወጅን ቀቡ ከነ” ጄዸ <char style="nd">ዋቀዮ</char>። “ሀፉርኮ ከን ስረ ጅሩ፣ ዱቢንኮ ከን አን አፋንኬ ኬሰ ካኤ ሱን አፋንኬቲ ዮካን አፋን እጆሌኬቲቲ ዮካን አፋን እጆሌ እጆሌሳኒቲ ሀርኣ ጀልቀቤ በረ በራን ህንበዱ” ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="ISA 59:21"/></para>
  <chapter eid="ISA 59"/>
  <chapter number="60" style="c" sid="ISA 60"/>
  <para style="s1">ኡልፍነ ጥዮን</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 60:1"/>“እፍንኬ ዹፌራቲ ከኢ እብስ፤</para>
  <para style="q2" vid="ISA 60:1">ኡልፍን <char style="nd">ዋቀዮ</char> ሲፍ በኤረ።<verse eid="ISA 60:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 60:2"/>ኩኖ፣ ዱከን ለፈ፣</para>
  <para style="q2" vid="ISA 60:2">ዱከን ሀማንሞ ኡመቶተ ሀጉገ፤</para>
  <para style="q1" vid="ISA 60:2">
    <char style="nd">ዋቀዮ</char> ገሩ ሲፍ ከኤረ፤</para>
  <para style="q2" vid="ISA 60:2">ኡልፍንሳስ ስራ ሙልአተ።<verse eid="ISA 60:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 60:3"/>ሰቦትን ገረ እፈኬቲ፣</para>
  <para style="q2" vid="ISA 60:3">ሞቶትንሞ ገረ እፈኬ እሰ በሪት ንዹፉ።<verse eid="ISA 60:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 60:4"/>“እጀኬ ኦል ፉዸዹቲ ናኖኬ እላል፤</para>
  <para style="q2" vid="ISA 60:4">ሁንድኑ ወል ገአኒ ገረኬ ንዹፉ፤</para>
  <para style="q1" vid="ISA 60:4">እልማንኬ ፈጎዻ፣</para>
  <para style="q2" vid="ISA 60:4">እንተለንኬስ ቆመት ባተመኒ ገረኬ ንዹፉ።<verse eid="ISA 60:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 60:5"/>ኤርገሲ ንእላልተ፤ ንጨለቅፍተስ፤</para>
  <para style="q2" vid="ISA 60:5">ለጴንኬ ንዸአተ፤ ገመቹዻንስ ንጉተመ፤</para>
  <para style="q1" vid="ISA 60:5">ቀቤኝ ገላኖታ ሁንድኑ ገረኬ ዹፉ፤</para>
  <para style="q2" vid="ISA 60:5">በዻዹማን ሰቦታስ ከንኬ ተአ።<verse eid="ISA 60:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 60:6"/>ጋል ባይኤን፣ እልማን ጋላ ከን ምድያኒፊ</para>
  <para style="q2" vid="ISA 60:6">ከን ኤፋ ብየኬ ንጉቱ።</para>
  <para style="q1" vid="ISA 60:6">ነሞትን ሁንድ ወርቄፊ እጣነ ፍደኒ፣</para>
  <para style="q2" vid="ISA 60:6">ገለተ <char style="nd">ዋቀዮ</char> ለብሳ</para>
  <para style="q2" vid="ISA 60:6">ብየ ሼባቲ ንዹፉ።<verse eid="ISA 60:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 60:7"/>ቡሻዬን ቄዳር ሁንድኑ ገረኬት ወልት ቀበሙ፤</para>
  <para style="q2" vid="ISA 60:7">ኮርቤዪን ሆላ ነባዮት ስ ተጃጅሉ፤</para>
  <para style="q1" vid="ISA 60:7">እሳን እዶ ኣርሳኮረት ኣርሳወን ፉዸተመ ቀበን ንተኡ፤</para>
  <para style="q2" vid="ISA 60:7">አንስ መነ ኡልፍነኮቲ ነንከበጀ።<verse eid="ISA 60:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 60:8"/>“ወር አኩመ ጉጌወኒ መኔንሳኒት በርሰን፣</para>
  <para style="q2" vid="ISA 60:8">ከኔን አከ ዱሜሳ ጉገተን ኩኔን ኤኙ ፈእ?<verse eid="ISA 60:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 60:9"/>ዹጉማን ብዮትን ብሻን ግዱ ነ አብደቱ፤</para>
  <para style="q2" vid="ISA 60:9">ሰበቢ እን ኡልፍነ ስት ኡፍሴፍ፣</para>
  <para style="q1" vid="ISA 60:9">መቃ <char style="nd">ዋቀዮ</char> ዋቀኬቲ፣</para>
  <para style="q2" vid="ISA 60:9">ቁልቁልቸ እስራኤሊቲፍ ጄዸኒ</para>
  <para style="q1" vid="ISA 60:9">ዶኒወን ተርሺሽ ዱርሰኒ፣</para>
  <para style="q2" vid="ISA 60:9">ሜቲፊ ወርቄሳኒ ወጅን</para>
  <para style="q2" vid="ISA 60:9">እልማንኬ ፈጎዻ ንፍዱ።<verse eid="ISA 60:9"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 60:10"/>“ነሞትን ኦርማ ደላኬ ንእጃሩ፤</para>
  <para style="q2" vid="ISA 60:10">ሞቶትንሳኒስ ስ ተጃጅሉ፤</para>
  <para style="q1" vid="ISA 60:10">አን ኣሪዻን ስ ዸኡሌ፣</para>
  <para style="q2" vid="ISA 60:10">ገረ ላፍነኮ ጃለላን ስት ነንአርግሲሰ።<verse eid="ISA 60:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 60:11"/>አከ ነሞትን በዻዽነ ሰቦታ ገረኬት ፍደኒፍ፣</para>
  <para style="q2" vid="ISA 60:11">አከ ሞቶትንሳኒስ ህሪራን ገረኬት ሴነኒፍ፣</para>
  <para style="q1" vid="ISA 60:11">ከረወንኬ ዬሮ ሁንደ በነማ ተኡ፤</para>
  <para style="q2" vid="ISA 60:11">እሳን ሀልከኒ ጉያ ጎንኩማ ህንጩፈመን፤<verse eid="ISA 60:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 60:12"/>ሰብን ዮካን ሞቱማን ስ ህንተጃጅሌ <optbreak/> ንበርበዳኡቲ፤</para>
  <para style="q2" vid="ISA 60:12">ጉቱማን ጉቱትስ ንበሌፈሙ።<verse eid="ISA 60:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 60:13"/>“ኡልፍን ልባኖን፣</para>
  <para style="q2" vid="ISA 60:13">ጋትራን፣ ቀረሮፊ ሀዼስ፣</para>
  <para style="q1" vid="ISA 60:13">ለፈ እዶ ቁልቁሉኮ ሚዸግሱፍ ገረኬ ንዹፉ፤</para>
  <para style="q2" vid="ISA 60:13">አንስ እዶ ሚልኮ ዻበቱ ነንከበጀ።<verse eid="ISA 60:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 60:14"/>እልማን ወረ ስ ጩንቁርሰኒ ሲፍ ሰገዳ ገረኬ ዹፉ፤</para>
  <para style="q2" vid="ISA 60:14">ወር ስ ቱፈተን ሁንድኑስ ሚለኬት ኩፉ፤</para>
  <para style="q1" vid="ISA 60:14">እሳንስ መጋላ <char style="nd">ዋቀዮ</char></para>
  <para style="q2" vid="ISA 60:14">ጥዮን ከን ቁልቁልቸ እስራኤል ጄዸኒ ስ ዋሙ።<verse eid="ISA 60:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 60:15"/>“ዮ አት ጅበምቴ ገተምቴ ነምን ቶኮዩ</para>
  <para style="q2" vid="ISA 60:15">ስ ኬሳን ደርቡ ለገቴዩ፣</para>
  <para style="q1" vid="ISA 60:15">አን ቦንቱ በረ በራቲፊ</para>
  <para style="q2" vid="ISA 60:15">ገመቹ ዸሎተ ሁንዳ ስን ታስሰ።<verse eid="ISA 60:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 60:16"/>አት ኣነን ሰቦታ ንዹግደ፤</para>
  <para style="q2" vid="ISA 60:16">ሀርመ ሞቶታስ ንሆተ።</para>
  <para style="q1" vid="ISA 60:16">ዮሙስ አን <char style="nd">ዋቀዮ</char> ጀባን ያቆብ፣</para>
  <para style="q2" vid="ISA 60:16">ፈይሳኬፊ ፉራኬ አከን ተኤ ንቤክተ።<verse eid="ISA 60:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 60:17"/>አን ቆደ ናሲ ወርቄ፣</para>
  <para style="q2" vid="ISA 60:17">ቆደ ስቢላሞ፣ ሜቲ ሲፍ ነንፍደ።</para>
  <para style="q1" vid="ISA 60:17">ቆደ ሙካ ናሲ፣</para>
  <para style="q2" vid="ISA 60:17">ቆደ ዸጋሞ፣ ስቢለ ሲፍ ነንፍደ።</para>
  <para style="q1" vid="ISA 60:17">ነጋ ሞቲኬ፣</para>
  <para style="q2" vid="ISA 60:17">ቀጄሉማሞ፣ ቡልቻኬ ነንጎዸ።<verse eid="ISA 60:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 60:18"/>ስአች ብየኬ ኬሰት ጎሊን፣</para>
  <para style="q2" vid="ISA 60:18">ዳሪኬ ኬሰትሞ ዲገምን ዮካን በዲስን <optbreak/> ህንዸገአሙ፤</para>
  <para style="q1" vid="ISA 60:18">አት ገሩ ደላኬ ፈይነ፣</para>
  <para style="q2" vid="ISA 60:18">ከረወን ኬሞ ገለተ ጄቴ ዋምተ።<verse eid="ISA 60:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 60:19"/>ስአች አዱን ጉያዻን፣</para>
  <para style="q2" vid="ISA 60:19">እፍን ጅኣስ ሀልከኒን እፈኬ ህንተኡ፤</para>
  <para style="q1" vid="ISA 60:19">
    <char style="nd">ዋቀዮ</char> እፈኬ በረ በራ ተኣቲ፤</para>
  <para style="q2" vid="ISA 60:19">ዋቅንኬ ኡልፍነኬ ንተአ።<verse eid="ISA 60:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 60:20"/>አዱንኬ ዴብቴ ህንዺቱ፤</para>
  <para style="q2" vid="ISA 60:20">ጅእኬ ህንበዱ፤</para>
  <para style="q1" vid="ISA 60:20">
    <char style="nd">ዋቀዮ</char> እፈኬ በረ በራ ንተአ፤</para>
  <para style="q2" vid="ISA 60:20">በር ገደኬስ ንራወተመ።<verse eid="ISA 60:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 60:21"/>ዮስ ኡመትንኬ ሁንድ ቀጄላ ንተአ፤</para>
  <para style="q2" vid="ISA 60:21">በረ በራንስ ለፈ ንዻለ።</para>
  <para style="q1" vid="ISA 60:21">እሳን ብቅልቱ አን ዻበዼዸ፤</para>
  <para style="q2" vid="ISA 60:21">ሆጂ ሀርከኮ፣ ከን አን እቲን ኡልፍነኮ ሙልእሱፍ <optbreak/> ጄዼ ሆጄዼዸ።<verse eid="ISA 60:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 60:22"/>ማቲን ሙራስን ኩመ፣</para>
  <para style="q2" vid="ISA 60:22">ገሬን ጥናንሞ ሰበ ጉዳ ተአ።</para>
  <para style="q1" vid="ISA 60:22">አን <char style="nd">ዋቀዮዸ</char>፤</para>
  <para style="q2" vid="ISA 60:22">ዋን ከነ ዬሮሳት ደፌ ነንሆጄዸ።”<verse eid="ISA 60:22"/></para>
  <chapter eid="ISA 60"/>
  <chapter number="61" style="c" sid="ISA 61"/>
  <para style="s1">በረ ቶለ <char style="nd">ዋቀዮ</char></para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 61:1"/>ሰበቢ <char style="nd">ዋቀዮ</char> አከ አን</para>
  <para style="q2" vid="ISA 61:1">ህዬዪት ኦዱ ጋሪ ለለቡፍ ነ ድቤፍ፣</para>
  <para style="q2" vid="ISA 61:1">ሀፉር <char style="nd">ዋቀዮ</char> ጎፍታ ነረ ጅረ።</para>
  <para style="q1" vid="ISA 61:1">እን አከ አን ገራ ጨቤ ፈይሱፍ፣</para>
  <para style="q2" vid="ISA 61:1">አከ አን ቦጅአምቶታፍ ብልሱማ፣</para>
  <para style="q2" vid="ISA 61:1">ወረ ህዸመኒፍሞ ሂከሙ ለለቡፍ ነ ኤርጌረ፤<verse eid="ISA 61:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 61:2"/>አከ አን በረ ቶለ <char style="nd">ዋቀዮቲፊ</char></para>
  <para style="q2" vid="ISA 61:2">ጉያ ሃሎ በኡ ዋቀኬኛ ለብሱፍ፣</para>
  <para style="q1" vid="ISA 61:2">አከ አን ወረ ቦአን ሁንደ ጀጀቤሱፍ፣<verse eid="ISA 61:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="ISA 61:3"/>አከ አን ወረ ጥዮን ኬሰት ገደኒፍ አርጆሜ፣</para>
  <para style="q1" vid="ISA 61:3">ቆደ ዳራ ሚዸግነ፣</para>
  <para style="q2" vid="ISA 61:3">ቆደ ቦእቻ፣ ዘይቲ ገመቹ፣</para>
  <para style="q1" vid="ISA 61:3">ቆደ አብዲ ኩተቹሞ፣</para>
  <para style="q2" vid="ISA 61:3">ወያ ገለታ ኬኑፍ ነ ኤርጌ።</para>
  <para style="q1" vid="ISA 61:3">እሳንስ ቅልጡ ቀጄሉማ፣ ብቅልቱ <char style="nd">ዋቀዮ</char>፣</para>
  <para style="q2" vid="ISA 61:3">ከን እን እቲን ከበጀሙ ጄዸመኒ ዋመመን።<verse eid="ISA 61:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 61:4"/>እሳን ዋን ዱር ዲገሜ ዴብሰኒ እጃሩ፤</para>
  <para style="q2" vid="ISA 61:4">እዶወን በረ ዼራን ዱረ ኦነኒ ቱረንስ <optbreak/> አከ ዱራት ዴብሱ፤</para>
  <para style="q1" vid="ISA 61:4">መጋላወን ዲገመን፣</para>
  <para style="q2" vid="ISA 61:4">ከኔን ዸሎተ ሄዱን ዱረ ኦነኒ ቱረን ንሃሮምሱ።<verse eid="ISA 61:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 61:5"/>አለጎን ቡሻዬኬሰን ንትክሱ፤</para>
  <para style="q2" vid="ISA 61:5">ኦርሞንስ ለፈ ቆቲሳፊ <optbreak/> እዶ ዻባ ወይኒኬሰኒ ኬሰ ንሆጄቱ።<verse eid="ISA 61:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 61:6"/>እስን ሉቦተ <char style="nd">ዋቀዮ</char> ጄዸምተኒ ንዋመምቱ፤</para>
  <para style="q2" vid="ISA 61:6">ተጃጅልቶተ ዋቀኬኛ ጄዸምተኒስ ንሞጋፈምቱ።</para>
  <para style="q1" vid="ISA 61:6">እስን ቀቤኘ ሰቦታ ንኛቱ፤</para>
  <para style="q2" vid="ISA 61:6">በዻዹማሳኒቲንሌ ንቦንቱ።<verse eid="ISA 61:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 61:7"/>ቆደ ቃኒኬሰኒ ህሬ ደቻ ንአርገቱ፤</para>
  <para style="q2" vid="ISA 61:7">ቆደ ሰልጵና እስን ዻለኬሰንት ንገመዱ፤</para>
  <para style="q1" vid="ISA 61:7">ከናፉ እስን ብየኬሰን ኬሰት ህሬ ደቻ ንዻልቱ፤</para>
  <para style="q2" vid="ISA 61:7">ገመቹን በረ በራስ ከንኬሰን።<verse eid="ISA 61:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 61:8"/>“አን <char style="nd">ዋቀዮ</char> ሙርቲ ቀጄላ ነንጃለዻቲ፤</para>
  <para style="q2" vid="ISA 61:8">ሳምቻፊ የከ ነንጅበ።</para>
  <para style="q1" vid="ISA 61:8">አን አመነሙማኮቲን እሳን ነንበዻሰ፤</para>
  <para style="q2" vid="ISA 61:8">ከኩ በረ በራስ እሳን ወጅን ነንገለ።<verse eid="ISA 61:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 61:9"/>ሰኚንሳኒ ሰቦተ ግዱት፣</para>
  <para style="q2" vid="ISA 61:9">እጆሌንሳኒሞ ኡመተ ግዱት ንቤከሙ።</para>
  <para style="q1" vid="ISA 61:9">ወር እሳን አርገን ሁንድ፣</para>
  <para style="q2" vid="ISA 61:9">አከ እሳን ሰበ <char style="nd">ዋቀዮ</char> ኤብሴ ተአን ንቤኩ።”<verse eid="ISA 61:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 61:10"/>አን <char style="nd">ዋቀዮ</char> እት ጉዳ ነንገመደ፤</para>
  <para style="q2" vid="ISA 61:10">ሉቡንኮስ አከ መሌ ዋቀኮት ገመድ።</para>
  <para style="q1" vid="ISA 61:10">እን አኩመ ምስርች አከ ሉባት መታሳ ሚዸግፈቱ፣</para>
  <para style="q2" vid="ISA 61:10">ምስርቲንሞ ፋያን ኦፍ በሬችቱ ሰነ፣</para>
  <para style="q1" vid="ISA 61:10">ወያ ፈይና ነት ኡፍሴረ</para>
  <para style="q2" vid="ISA 61:10">ኡፈተ ቀጄሉማ ነረ ቡሴራቲ።<verse eid="ISA 61:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 61:11"/>አኩመ ለፍት ብቅልቱ ብቅልችቴ</para>
  <para style="q2" vid="ISA 61:11">እዶን ብቅልቱሞ አከ ሰኚን ጉደቱ ጎዹ ሰነ</para>
  <para style="q1" vid="ISA 61:11">
    <char style="nd">ዋቀዮ</char> ጎፍታን አከ ቀጄሉማፊ</para>
  <para style="q2" vid="ISA 61:11">ገለን ፉለ ሰቦተ ሁንዳ ዱረት ብቅለን ንጎዸ።<verse eid="ISA 61:11"/></para>
  <chapter eid="ISA 61"/>
  <chapter number="62" style="c" sid="ISA 62"/>
  <para style="s1">መቃ ጥዮን ሃራ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 62:1"/>ሀመ ቀጄሉማንሼ አከ በሪ በራቃ፣</para>
  <para style="q2" vid="ISA 62:1">ፈይንሼ አከ ጉጨ ቦበኡ እፉት፣</para>
  <para style="q1" vid="ISA 62:1">አን ዋኤ ጥዮን ህንጨልእሱ፤</para>
  <para style="q2" vid="ISA 62:1">ዋኤ ዬሩሳሌምስ አፋን ህንቀበዹ።<verse eid="ISA 62:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 62:2"/>ሰቦትን ቀጄሉማኬ፣</para>
  <para style="q2" vid="ISA 62:2">ሞቶትን ሁንድኑስ ኡልፍነኬ ንአርጉ፤</para>
  <para style="q1" vid="ISA 62:2">አት መቃ ሃራ፣</para>
  <para style="q2" vid="ISA 62:2">ከን አፋን <char style="nd">ዋቀዮ</char> ሲፍ ባሱን ንዋመምተ።<verse eid="ISA 62:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 62:3"/>አት ሀርከ <char style="nd">ዋቀዮ</char> ኬሰት ጎንፎ ኡልፍና፣</para>
  <para style="q2" vid="ISA 62:3">ሀርከ ዋቀኬቲ ኬሰትስ መረተ ሞቲ ንታተ።<verse eid="ISA 62:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 62:4"/>አት ስአች፣ ገተምቱ ህንጄዸምቱ፣</para>
  <para style="q2" vid="ISA 62:4">ዮካን ብይኬ ኦንቱ ህንጄዸምቱ።</para>
  <para style="q1" vid="ISA 62:4">አት ገሩ፣ “አን እሼት ነንገመደ” ጄዸምተ፤</para>
  <para style="q2" vid="ISA 62:4">ብይኬስ “ከን ሄሩምቴ” ጄዸምት፤</para>
  <para style="q1" vid="ISA 62:4">
    <char style="nd">ዋቀዮ</char> ስት ገመዳቲ፣</para>
  <para style="q2" vid="ISA 62:4">ብይኬ ንሄሩምት።<verse eid="ISA 62:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 62:5"/>አኩመ ደርገጌስ ዱርበ ፉዹ፣</para>
  <para style="q2" vid="ISA 62:5">እልማንኬ ስ ፉዹ፤</para>
  <para style="q1" vid="ISA 62:5">አኩመ ምስርች ምስርቲት ገመዱ፣</para>
  <para style="q2" vid="ISA 62:5">ዋቅንኬስ ስት ገመደ።<verse eid="ISA 62:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 62:6"/>ያ ዬሩሳሌም፣ አን ደላወንኬረት <optbreak/> ኤግዶተ ረመዴረ፤</para>
  <para style="q2" vid="ISA 62:6">እሳን ጎንኩማ ሀልከኒፊ ጉያ ህንጨልእሰን።</para>
  <para style="q1" vid="ISA 62:6">እስን ወር <char style="nd">ዋቀዮን</char> ዋመተን፣</para>
  <para style="q2" vid="ISA 62:6">ኦፊኬሰኒፍ ቦቆና ህንኬንና፤<verse eid="ISA 62:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 62:7"/>ሀመ እን ዬሩሳሌምን ጭምሴ እጃሬ</para>
  <para style="q2" vid="ISA 62:7">አከ እሼን ለፈረት ሌልፈምቱ ታቱ ጎዹት <optbreak/> ቦቆና እሳፍ ህንኬንና።<verse eid="ISA 62:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 62:8"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዼ</para>
  <para style="q2" vid="ISA 62:8">ሀርከሳ ምርጋቲፊ እሬሳ ጀባ ሰናን ከከቴረ፤</para>
  <para style="q1" vid="ISA 62:8">“አን ለመተ ምዻንኬ</para>
  <para style="q2" vid="ISA 62:8">ኛተ ጎዼ ዲኖተኬቲፍ ህንኬኑ፤</para>
  <para style="q1" vid="ISA 62:8">ነሞትን ኦርማስ ለመተ ዳዺ ወይኒ ሃራ</para>
  <para style="q2" vid="ISA 62:8">ከን አት እት ደዸብዴ ህንዹገን፤<verse eid="ISA 62:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 62:9"/>ገሩ ወር ገልፈተን ምዻን ሰነ ንኛቱ፤</para>
  <para style="q2" vid="ISA 62:9">
    <char style="nd">ዋቀዮንስ</char> ንገለቴፈቱ፤</para>
  <para style="q1" vid="ISA 62:9">ወር እጀ ወይኒ ጉረተንስ</para>
  <para style="q2" vid="ISA 62:9">ኦብዲ እዶ ቁልቁሉኮ ኬሰት ንዹጉ።”<verse eid="ISA 62:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 62:10"/>ኬሰ ደርባ፤ ከረወን ኬሳን ደርባ!</para>
  <para style="q2" vid="ISA 62:10">ኡመታፍ ከራ ቆጴሳ።</para>
  <para style="q1" vid="ISA 62:10">ቶልቻ፤ ከራ ጉዳ ቶልቻ!</para>
  <para style="q2" vid="ISA 62:10">ዸጋወን ቡቡቅሳ።</para>
  <para style="q1" vid="ISA 62:10">ሰቦታፍስ ፋጂ ኦል ቀባ።<verse eid="ISA 62:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 62:11"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዼ</para>
  <para style="q2" vid="ISA 62:11">ሀመ ሞጋ ለፋት ለብሴረ፤</para>
  <para style="q1" vid="ISA 62:11">“እንተለ ጥዮኒን አከነ ጄዻ፦</para>
  <para style="q2" vid="ISA 62:11">‘ኩኖ ፈይሳንኬ ንዹፈ!</para>
  <para style="q1" vid="ISA 62:11">በዻስንሳ ኩኖ እሰ ሀርከ ጅረ፤</para>
  <para style="q2" vid="ISA 62:11">ቤኛን እን ነማፍ ባሱስ እሱመ ወጅን ጅረ።’ ”<verse eid="ISA 62:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 62:12"/>እሳንስ ሰበ ቁልቁሉ፣</para>
  <para style="q2" vid="ISA 62:12">ፉረምቶተ <char style="nd">ዋቀዮ</char> ጄዸመኒ ንዋመሙ፤</para>
  <para style="q1" vid="ISA 62:12">አትስ በርባደምቱ፣</para>
  <para style="q2" vid="ISA 62:12">መጋላ ስአች ህንኦኔ ንጄዸምተ።<verse eid="ISA 62:12"/></para>
  <chapter eid="ISA 62"/>
  <chapter number="63" style="c" sid="ISA 63"/>
  <para style="s1">ጉያ <char style="nd">ዋቀዮ</char> ሃሎ በኡ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 63:1"/>ከን ኡፈተሳ ሀሉ ዲማ ጩጴ</para>
  <para style="q2" vid="ISA 63:1">ኤዶም ኬሳ፣ ቦዝራዻ ዹፋ ጅሩ ኩን ኤኙ?</para>
  <para style="q1" vid="ISA 63:1">ከን ኡልፍነ ኡፈቴ ጉድነ ጀብነሳቲን</para>
  <para style="q2" vid="ISA 63:1">ፉለ ዱረት ዴማ ጅሩ ኩን ኤኙ?</para>
  <para style="b" vid="ISA 63:1"/>
  <para style="q1" vid="ISA 63:1">“እን አኑመ፣ ከን ቀጄሉማን ዱበቱ፣</para>
  <para style="q2" vid="ISA 63:1">ከን ኦልቹፍስ ሁምነ ቀቡ አናዸ።”<verse eid="ISA 63:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 63:2"/>ኡፈትንኬ ማሊፍ አኩመ ኡፈተ</para>
  <para style="q2" vid="ISA 63:2">ነመ ቦለ ወይኒ እት ጩንፈን ኬሰት <optbreak/> ወይኒ ዽዺቱ ቶኮ ዲመተ?<verse eid="ISA 63:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 63:3"/>“አን ኮጳኮ ቦለ እት ወይኒ ጩንፈን ኬሰት <optbreak/> ወይኒ ነንዽዺቴ፤</para>
  <para style="q2" vid="ISA 63:3">ሰቦተ ኬሳ ነምን ቶኮዩ ነ ወጅን ህንቱሬ።</para>
  <para style="q1" vid="ISA 63:3">አን ኣሪኮቲን እሳንረ ዻበዼ</para>
  <para style="q2" vid="ISA 63:3">ዼከምሰኮቲን ገድ እሳን ዽዺቴ፤</para>
  <para style="q1" vid="ISA 63:3">ዺግንሳኒ ወያኮት ፈፈጨኤ፤</para>
  <para style="q2" vid="ISA 63:3">ወያኮ ሁንደስ ንፋሌ።<verse eid="ISA 63:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 63:4"/>ጉያን ሃሎ በኡ ገራኮ ኬሰ ጅራቲ፤</para>
  <para style="q2" vid="ISA 63:4">ወጋን አን እት ነመ ፉሩስ ዹፌረ።<verse eid="ISA 63:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 63:5"/>አንስ ምልአዼ ነመ ነ ገርጋሩ ቶኮዩ ነንዸቤ፤</para>
  <para style="q2" vid="ISA 63:5">ገርጋርሰ ቶኮዩ ዸብናን ነንድንቅሲፈዼ፤</para>
  <para style="q1" vid="ISA 63:5">ከናፉ እሬንኮ ፈይነ ና ፍዴ፤</para>
  <para style="q2" vid="ISA 63:5">ዼከምስኮስ ነ ኡቱቤ።<verse eid="ISA 63:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 63:6"/>አን ኣሪኮቲን ሰቦተረ ነንዽዺቴ፤</para>
  <para style="q2" vid="ISA 63:6">ዼከምሰኮቲንስ እሳን ነንመቼሴ፤</para>
  <para style="q2" vid="ISA 63:6">ዺገሳኒ ለፈረ ነንሎላሴ።”<verse eid="ISA 63:6"/></para>
  <para style="s1">ገለቴፈትናፊ ከዸትና</para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 63:7"/>አኩመ ዋን እን ኑፍ ሆጄቴ ሁንዳት</para>
  <para style="q2" vid="ISA 63:7">አን ዋኤ ጃለለ <char style="nd">ዋቀዮ</char> <optbreak/> ከን ህንጌደረምኔ ሰና</para>
  <para style="q2" vid="ISA 63:7">ሆጂ እን እቲን ገለቴፈሙ ቀቡ ነንኦዴሰ፤</para>
  <para style="q1" vid="ISA 63:7">ወንቶተ ገጋሪ እን አኩመ ገረ ላፍናፊ</para>
  <para style="q2" vid="ISA 63:7">አርጁማሳ ሄዱ ሰናት መነ እስራኤሊፍ ሆጄቴ ባይኤ</para>
  <para style="q2" vid="ISA 63:7">አን ዹጉማን ነንኦዴሰ።<verse eid="ISA 63:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 63:8"/>እንስ፣ “እሳን ዹጉማን ሰበኮት፤</para>
  <para style="q2" vid="ISA 63:8">እጆሌ ህንሶብኔዸ” ጄዼ፤</para>
  <para style="q2" vid="ISA 63:8">ከናፉ እን ፈይሳሳኒ ተኤ።<verse eid="ISA 63:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 63:9"/>ዽጵነሳኒ ሁንደ ኬሰት፣ እንስ ንዽጰቴ፤</para>
  <para style="q2" vid="ISA 63:9">ኤርገማን ዋቀዮ ከን ፉለሳ ዱረ ዻበቱ እሳን በራሬ።</para>
  <para style="q1" vid="ISA 63:9">ጃለላፊ አራረሳቲን እሳን ፉሬ፤</para>
  <para style="q2" vid="ISA 63:9">በረ ዱሪ ሁንደ ኬሰ፣</para>
  <para style="q2" vid="ISA 63:9">እን ኦል ፉዼ እሳን ባቴ።<verse eid="ISA 63:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 63:10"/>እሳን ገሩ ፍንጭለኒ</para>
  <para style="q2" vid="ISA 63:10">ሀፉረሳ ቁልቁሉ ገድሲሰን።</para>
  <para style="q1" vid="ISA 63:10">ከናፉ እን ዴብኤ ዲነሳኒ ተኤ፤</para>
  <para style="q2" vid="ISA 63:10">እን መታንሳስ እሳን ሎሌ።<verse eid="ISA 63:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 63:11"/>ከነረት ሰብንሳ በረ ዱሪ፣</para>
  <para style="q2" vid="ISA 63:11">በረ ሙሴቲፊ ሰበሳ ያደቴ አከነ ጄዼ፦</para>
  <para style="q1" vid="ISA 63:11">እን ትክሴ ቡሻዬሳ ወጅን <optbreak/> ገላነ ኬሳ እሳን ባሴ ሱን ኤሰ ጅረ?</para>
  <para style="q2" vid="ISA 63:11">እን ሀፉረሳ ቁልቁሉ ግዱሳኒ ቡሴ፣<verse eid="ISA 63:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 63:12"/>ከን አከ እሬንሳ ኡልፍነ ቀቤስ ጀባን ሱን፣</para>
  <para style="q2" vid="ISA 63:12">ሀርከ ምርጋ ከን ሙሴ ወጅን ጅራቱፍ ኤርጌ፣</para>
  <para style="q1" vid="ISA 63:12">ከን መቃ በረ በራ ኦፊሳቲፍ ጎዸቹዻፍ</para>
  <para style="q2" vid="ISA 63:12">ፉለሳኒ ዱረት ብሻን ገርገር ቆዴ፣<verse eid="ISA 63:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 63:13"/>ከን ቱጁበ ኬሳን እሳን ቀጄልቼ ሱን ኤሰ ጅረ?</para>
  <para style="q2" vid="ISA 63:13">እሳን አኩመ ፈርደ ብየ በልኣ ኬሰ ጉሉፉ ቶኮ ህንጉፈትኔ፤<verse eid="ISA 63:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 63:14"/>አኩመ ሎን ድሬት ቦበአኒት፣</para>
  <para style="q2" vid="ISA 63:14">ሀፉር <char style="nd">ዋቀዮ</char> ቦቆና እሳኒፍ ኬኔ።</para>
  <para style="q1" vid="ISA 63:14">አክ አት እት መቃ ኡልፍነ ቀቡ ኦፊኬቲፍ ጎዸቹዻፍ ጄቴ</para>
  <para style="q2" vid="ISA 63:14">ሰበኬ ቀጄልችቴ ከናዸ።<verse eid="ISA 63:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 63:15"/>አት ሰሚራ፣ ቴሶኬ ቁልቁሉፊ</para>
  <para style="q2" vid="ISA 63:15">ኡልፍነ ቀቤሰ ሰነራ ገድ እላል።</para>
  <para style="q1" vid="ISA 63:15">ህናፋንኬቲፊ ጀብንኬ ኤሰ ጅሩ?</para>
  <para style="q2" vid="ISA 63:15">ጃለሊፊ ገረ ላፍንኬ ኑራ እትፈመኒሩ።<verse eid="ISA 63:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 63:16"/>ዮ አብረሃም ኑ ቤኩ ባቴ፣</para>
  <para style="q2" vid="ISA 63:16">ዮካን እስራኤል ኑ ያደቹ ባቴዩ፣</para>
  <para style="q2" vid="ISA 63:16">አት ዹጉማን አባኬኘ፤</para>
  <para style="q1" vid="ISA 63:16">ያ <char style="nd">ዋቀዮ</char>፣ አት አባኬኘ፤</para>
  <para style="q2" vid="ISA 63:16">ፉራንኬኘ ዱሩማ ጀልቀቤ መቃኬት።<verse eid="ISA 63:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 63:17"/>ያ <char style="nd">ዋቀዮ</char>፣ አት ማሊፍ አከ ኑ ከራኬራ በድኑፊ</para>
  <para style="q2" vid="ISA 63:17">አከ ገራንኬኘ ጀባቴ ኑ ስ ሶዳቹ ድድኑ ኑ ጎተ?</para>
  <para style="q1" vid="ISA 63:17">ሰበቢ ገርቦተኬ፣</para>
  <para style="q2" vid="ISA 63:17">ጎሶተ ሀንዹራኬ ተአኒቲፍ ጄዺ ዴብእ።<verse eid="ISA 63:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 63:18"/>ሰብንኬ ዬሮ የርቱፍ እዶኬ ቁልቁሉ ዻሌ ቱሬ፤</para>
  <para style="q2" vid="ISA 63:18">አመ ገሩ ዲኖትንኬኘ እዶኬ ቁልቁሉ <optbreak/> ገድ ዽዺታ ጅሩ።<verse eid="ISA 63:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 63:19"/>ኑ ዱሩማ ጀልቀብኔ ከኑመኬት፤</para>
  <para style="q2" vid="ISA 63:19">አት ገሩ እሳን ህንቡልችኔ፤</para>
  <para style="q2" vid="ISA 63:19">እሳንስ መቃኬቲን ህንዋመምኔ።<verse eid="ISA 63:19"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 63"/>
  <chapter number="64" style="c" sid="ISA 64"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 64:1"/>አከ ቱሉወን ፉለኬ ዱረት ራፈመኒፍ፣</para>
  <para style="q2" vid="ISA 64:1">ማሎ አት ኡቱ ሰሚወን ተርሳፍቴ ገድ ቡቴ!<verse eid="ISA 64:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 64:2"/>አኩመ እብድ ሀንጠጢ ጉቤ፣ ብሻን ደንፍሱ ሰነ፣</para>
  <para style="q2" vid="ISA 64:2">አከ መቃንኬ ዲኖተኬ ብረት ቤከሙፍ</para>
  <para style="q1" vid="ISA 64:2">ገድ ቡኢቲ አከ ሰቦትን ፉለኬ</para>
  <para style="q2" vid="ISA 64:2">ዱረት ሆለተን ጎዽ!<verse eid="ISA 64:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 64:3"/>አት ዬሮ ዋን ሶዳችሳ ኑ ህንያድን ሆጄቴት ገድ ቡቴ፤</para>
  <para style="q2" vid="ISA 64:3">ቱሉወንስ ፉለኬ ዱረት ሆለተን።<verse eid="ISA 64:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 64:4"/>ስ መሌ ዋቀ ወረ እሰ አብደተኒፍ ዻበቱ፣</para>
  <para style="q2" vid="ISA 64:4">በረ ዱሪቲ ጀልቀቤ ነምን ቶኮዩ ህንዸጌኜ፤</para>
  <para style="q1" vid="ISA 64:4">ዮካን ጉር ቶኮዩ ህንቀልቤፈትኔ፤</para>
  <para style="q2" vid="ISA 64:4">እጅ ቶኮዩ ህንአርግኔ።<verse eid="ISA 64:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 64:5"/>አት ወረ ገመቹዻን ዋን ቶላ ሆጄተን</para>
  <para style="q2" vid="ISA 64:5">ከኔን ከራኬ ያደተን ገርጋሩፍ ንዹፍተ።</para>
  <para style="q1" vid="ISA 64:5">ገሩ ዮሙ ኑ እቱመ ፉፍኔ</para>
  <para style="q2" vid="ISA 64:5">ጩቡ ሆጄትኔት አት ንዼከምቴ።</para>
  <para style="q2" vid="ISA 64:5">ዮስ ኑ አከምት ፈዩ ደንዴኘሬ?<verse eid="ISA 64:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 64:6"/>ሁንድኬኘ አከ ነመ ቁልቁልነ ህንቀብኔ ታኔረ፤</para>
  <para style="q2" vid="ISA 64:6">ሆጂን ቀጄሉማኬኛ ሁንድስ አከ ሁጩ ጡራኡማት፤</para>
  <para style="q1" vid="ISA 64:6">ሁንድኬኘ አኩመ ባላ ጮለግኔ፤</para>
  <para style="q2" vid="ISA 64:6">ጩቡንኬኘስ አኩመ ቡቤ ሀጣኤ ኑ ፉዸቴ።<verse eid="ISA 64:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 64:7"/>ነምን መቃኬ ዋመቱ ቶኮዩ ህንጅሩ፤</para>
  <para style="q2" vid="ISA 64:7">ዮካን ነምን ስ ቀበቹፍ ጨራቁ ህንጅሩ፤</para>
  <para style="q1" vid="ISA 64:7">አት ፉለኬ ኑ ዾክፈቴ</para>
  <para style="q2" vid="ISA 64:7">ሰበቢ ጩቡኬኛቲፍስ ኑ ፍጤርታቲ።<verse eid="ISA 64:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 64:8"/>ተኡስ ያ <char style="nd">ዋቀዮ</char>፣ አት አባኬኘ።</para>
  <para style="q2" vid="ISA 64:8">ኑ ሱጴዸ፤ አትሞ ዾፍቱ ሱጴት፤</para>
  <para style="q2" vid="ISA 64:8">ሁንድኬኘ ሆጂ ሀርከኬቲት።<verse eid="ISA 64:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 64:9"/>ያ <char style="nd">ዋቀዮ</char>፣ አት አከ መሌ ህንዼከምን፤</para>
  <para style="q2" vid="ISA 64:9">ጩቡኬኘስ በረ በራን ህንያደትን።</para>
  <para style="q1" vid="ISA 64:9">ማሎ ስ ከዸትና፣ ፉለኬ ኑፍ ዴብስ፤</para>
  <para style="q2" vid="ISA 64:9">ኑ ሁንድኑ ሰበኬቲ።<verse eid="ISA 64:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 64:10"/>መጋላወንኬ ቁልቁሎትን ኦነኒሩ፤</para>
  <para style="q2" vid="ISA 64:10">ጥዮንዩ ኦንቴርት፤ ዬሩሳሌምስ ዱዋ ሀፍቴርት።<verse eid="ISA 64:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 64:11"/>መን ቁልቁሉማኬኘ ቁልቁልቺፊ ኡልፍነ ቀቤስ፣</para>
  <para style="q2" vid="ISA 64:11">እዶን አቦቲንኬኘ እት ስ ገለቴፈተን ሱን እብዳን ጉበሜረ፤</para>
  <para style="q2" vid="ISA 64:11">ወን ኑ እት ገመትኑ ሁንድስ በርበዴፈሜረ።<verse eid="ISA 64:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 64:12"/>ያ <char style="nd">ዋቀዮ</char>፣ አት ወንቶተ ከኔን ሁንደ <optbreak/> ጨልኡመ ጄቴ እላልታ?</para>
  <para style="q2" vid="ISA 64:12">አት ጨልእስቴ አከ መሌ ኑ አደብዳ?<verse eid="ISA 64:12"/></para>
  <chapter eid="ISA 64"/>
  <chapter number="65" style="c" sid="ISA 65"/>
  <para style="s1">ሙርቲፊ ፈይነ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 65:1"/>“አን ወረ ነ ህንእያፈትንት ነንሙልአዼ፤</para>
  <para style="q2" vid="ISA 65:1">ወር ነ ህንበርባድንስ ነ አርገተን።</para>
  <para style="q1" vid="ISA 65:1">አን ሰበ መቃኮ ህንዋመትኒን፣</para>
  <para style="q2" vid="ISA 65:1">‘አን አሰን ጅረ፤ አን አሰን ጅረ’ ነንጄዼ።<verse eid="ISA 65:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 65:2"/>አን ጉያ ጉቱ ገረ ኡመተ ድዳ ተኤት፣</para>
  <para style="q2" vid="ISA 65:2">ከን ከራ ጋሪ ህንተእንረ ዴሙ፣</para>
  <para style="q1" vid="ISA 65:2">ከን ያደ ኦፊሳ ዱካ ቡኡፍ</para>
  <para style="q2" vid="ISA 65:2">ሀርከኮ ነንድሪርፈዼ፤<verse eid="ISA 65:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 65:3"/>እሳን ሰበ እዶ ብቅልቱ ኬሰት ኣርሳ ዽኤሱዻን፣</para>
  <para style="q2" vid="ISA 65:3">እዶ ኣርሳ ከን ጡቢረትስ እጣነ ኣርሱዻን፣</para>
  <para style="q1" vid="ISA 65:3">ኡቱ ገርገር ህንኩትን፣ ኡቱመ አን አርጉ</para>
  <para style="q2" vid="ISA 65:3">ዼከምሳፍ ነ ከካሰኒዸ፤<verse eid="ISA 65:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 65:4"/>እሳን ወረ አዋለ ግዱ ተታአኒ</para>
  <para style="q2" vid="ISA 65:4">ለፈ ዾክሳ ቡለኒዸ፤</para>
  <para style="q1" vid="ISA 65:4">ወረ ፎን ቦዬ ኛተኒ</para>
  <para style="q2" vid="ISA 65:4">ኦኮቴንሳኒ ብሻን ፎን ጡራኣ ባቱዸ፤<verse eid="ISA 65:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 65:5"/>እሳን ወረ፣ ‘አች ፈጋዹ፤ ነት ህንዽኣትን፤</para>
  <para style="q2" vid="ISA 65:5">አን ስ ጫላ ቁልቁሉዻቲ!’ ጄዸኒዸ።</para>
  <para style="q1" vid="ISA 65:5">ሰብን አከሲ ፉኛንኮ ኬሰት አኩመ ኣራ፣</para>
  <para style="q2" vid="ISA 65:5">አኩመ እብደ ጉያ ጉቱ ቦበኡት።<verse eid="ISA 65:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 65:6"/>“ኩኖ፣ ወን ኩን አከነ ጄዸሜ ፉለኮ ዱረት በሬፈሜረ፦</para>
  <para style="q2" vid="ISA 65:6">አን ህንጨልእሱ፤ ገሩ ገቲ ሆጂሳኒ ጉቱ ነንኬናፍ፤</para>
  <para style="q2" vid="ISA 65:6">ዹጉማንስ ቆመት እሳን ነንባችሰ።<verse eid="ISA 65:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 65:7"/>ኩንስ ጩቡኬሰኒፊ ጩቡ አቦቲኬሰኒት”</para>
  <para style="q2" vid="ISA 65:7">ጄዸ <char style="nd">ዋቀዮ</char>።</para>
  <para style="q1" vid="ISA 65:7">“እሳን ቱሉወንረት ኣርሳ ዽኤሰኒ፣</para>
  <para style="q2" vid="ISA 65:7">ጋረንረት ዋን ነ አረብሰኒፍ፣</para>
  <para style="q1" vid="ISA 65:7">አን ሆጂሳኒ ከን ዱሪቲፍ፣</para>
  <para style="q2" vid="ISA 65:7">ከፈልቲ ጉቱ እሳኒፍን ኬነ።”<verse eid="ISA 65:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 65:8"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="ISA 65:8">“አኩመ ዬሮ ሁርቡ ወይኒ ኬሰ ጩንፋን ጅሩት፣</para>
  <para style="q2" vid="ISA 65:8">ነሞትን፣ ‘አመዩ ኤበቱ ኬሰ ጅራቲ፣</para>
  <para style="q2" vid="ISA 65:8">ህንበሌስና’ ጄዸን ሰነ፣</para>
  <para style="q1" vid="ISA 65:8">አንስ ተጃጅልቶተኮቲፍ አከሱመ ነንጎዸ፤</para>
  <para style="q2" vid="ISA 65:8">እሳን ሁንደስ ህንበሌሱ።<verse eid="ISA 65:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 65:9"/>አንስ ያቆብ ኬሳ ሰኚ ቶኮ፣</para>
  <para style="q2" vid="ISA 65:9">ይሁዳ ኬሳሞ ወረ ቱሉወንኮ ዻለን ነንብቅልቸ፤</para>
  <para style="q1" vid="ISA 65:9">ሰብንኮ ፍለተማን ቱሉወን ሰነ ዻለ፤</para>
  <para style="q2" vid="ISA 65:9">ተጃጅልቶትንኮስ አች ንጅራቱ።<verse eid="ISA 65:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 65:10"/>ሰበኮ ከን ነ በርባዱፍ</para>
  <para style="q2" vid="ISA 65:10">ሻሮን ለፈ ቡሻዬን እት ቦበአን፣</para>
  <para style="q2" vid="ISA 65:10">ሱሉል ኣኮርሞ ለፈ ሎን ቦቆተን ንተአን።<verse eid="ISA 65:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 65:11"/>“ገሩ እስን ወረ <char style="nd">ዋቀዮን</char> ዺፍተኒ</para>
  <para style="q2" vid="ISA 65:11">ቱሉኮ ቁልቁሉ ደገተን፣</para>
  <para style="q1" vid="ISA 65:11">ከኔን ዋቀ ‘ምልኪ’ ጄዸሙፍ <optbreak/> ማዲ ቆጴስተኒ፣</para>
  <para style="q2" vid="ISA 65:11">ዋቀ፣ ‘ህሬ’ ጄዸሙፍሞ ዽባዩ ኩባያት ጉተን፣<verse eid="ISA 65:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 65:12"/>አን እርባተ ጎራዴ እስነን ጎዸ፤</para>
  <para style="q2" vid="ISA 65:12">እስን ሁንድስ ቀለሙፍ ገድ ጄቱ፤ አን እስን ዋሜን ቱሬ፤</para>
  <para style="q1" vid="ISA 65:12">እስን ገሩ ነ ጀላ ህንኦዋትኔ፤</para>
  <para style="q2" vid="ISA 65:12">አን ዱበዼን ቱሬ፤ እስን ገሩ ነ ህንዸጌፈትኔ።</para>
  <para style="q1" vid="ISA 65:12">እስን ፉሉመኮ ዱረት ዋን ሀማ ሆጄተኒ</para>
  <para style="q2" vid="ISA 65:12">ዋን ነ ህንገመቺፍኔ ፍለተን።”<verse eid="ISA 65:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 65:13"/>ከናፉ <char style="nd">ዋቀዮ</char> ጎፍታን አከነ ጄዸ፦</para>
  <para style="q1" vid="ISA 65:13">“ገርቦንኮ ንኛቱ፤</para>
  <para style="q2" vid="ISA 65:13">እስን ገሩ ንቤሎፍቱ፤</para>
  <para style="q1" vid="ISA 65:13">ገርቦንኮ ንዹጉ፤</para>
  <para style="q2" vid="ISA 65:13">እስን ገሩ ንዼቦቱ፤</para>
  <para style="q1" vid="ISA 65:13">ገርቦንኮ ንገመዱ፤</para>
  <para style="q2" vid="ISA 65:13">እስን ገሩ ንቃኖፍቱ።<verse eid="ISA 65:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 65:14"/>ገርቦንኮ</para>
  <para style="q2" vid="ISA 65:14">ገመቹ ገራራ መዴን ንፋርፈቱ፤</para>
  <para style="q1" vid="ISA 65:14">እስን ገሩ፣</para>
  <para style="q2" vid="ISA 65:14">ዋን ገራንኬሰን ሚዸሜፍ ንቦሱ፤</para>
  <para style="q2" vid="ISA 65:14">ዋን ሀፉርኬሰን ገዴፍ ንወዋቱ።<verse eid="ISA 65:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 65:15"/>ፍለተምቶትንኮ መቃ እስን ደበርፈተን ሰነ</para>
  <para style="q2" vid="ISA 65:15">አባርሳፍ እት ፈየደሙ፤</para>
  <para style="q1" vid="ISA 65:15">
    <char style="nd">ዋቀዮ</char> ጎፍታን እስን ፍጠ፤</para>
  <para style="q2" vid="ISA 65:15">ገርቦተሳቲፍ ገሩ መቃ ብራ ንኬነ።<verse eid="ISA 65:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 65:16"/>ነምን ለፈረት ኤብፈሙ ከምዩ፣</para>
  <para style="q2" vid="ISA 65:16">ዋቀ ዹጋቲን ኤብፈመ፤</para>
  <para style="q1" vid="ISA 65:16">ነምን ለፈረት ከከቱስ፣</para>
  <para style="q2" vid="ISA 65:16">ዋቀ ዹጋቲን ከከተ።</para>
  <para style="q1" vid="ISA 65:16">ረክን ዱሪ ንእራንፈተመ፤</para>
  <para style="q2" vid="ISA 65:16">እጀኮ ዱራስ ንዾከታቲ።<verse eid="ISA 65:16"/></para>
  <para style="s1">ሰሚወን ሃራፊ ለፈ ሃራ</para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 65:17"/>“ኩኖ አን፣ ሰሚወን ሃራፊ</para>
  <para style="q2" vid="ISA 65:17">ለፈ ሃራ ነንኡመ።</para>
  <para style="q1" vid="ISA 65:17">ወን ዱሪ ህንያደተሙ፤</para>
  <para style="q2" vid="ISA 65:17">ዮካን ቀልቢ ነማት ህንዹፉ።<verse eid="ISA 65:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 65:18"/>እስን ገሩ ዋን አን ኡሙት፣</para>
  <para style="q2" vid="ISA 65:18">በረ በራን ገመዳ እልልቻ፤</para>
  <para style="q1" vid="ISA 65:18">አን ዬሩሳሌምን ገመቹፍ፣</para>
  <para style="q2" vid="ISA 65:18">ሰበሼሞ እልሌፍ ነንኡማቲ።<verse eid="ISA 65:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 65:19"/>አን ዬሩሳሌምት ነንገመደ፤</para>
  <para style="q2" vid="ISA 65:19">ሰበኮትስ ነንገመደ፤</para>
  <para style="q1" vid="ISA 65:19">ስአች ሰገሌን ቦእቻቲፊ</para>
  <para style="q2" vid="ISA 65:19">እያ እሼ ኬሰት ህንዸገአሙ።<verse eid="ISA 65:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 65:20"/>“ስአች፣ ዳእምን ጉያ ሙራሰ ቆፈ ጅራቱ፣</para>
  <para style="q2" vid="ISA 65:20">ዮካን ጃርስ ኡሙሪንሳ ሀንቀቱ ቶኮዩ</para>
  <para style="q2" vid="ISA 65:20">እሼ ኬሰት ህንአርገሙ፤</para>
  <para style="q1" vid="ISA 65:20">ነምን ወጋ ዽበት ዱኡ፣</para>
  <para style="q2" vid="ISA 65:20">አከ ዋን ደርገጉማን ዱኤት ያደመ፤</para>
  <para style="q1" vid="ISA 65:20">ነምን ወጋ ዽበ ሀንቀቴ ቶኮ፣</para>
  <para style="q2" vid="ISA 65:20">አከ ዋን አባረሜት ሄደመ።<verse eid="ISA 65:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 65:21"/>ነሞትን መነ ንእጃረቱ፤ አች ኬሰስ ንጅራቱ፤</para>
  <para style="q2" vid="ISA 65:21">ወይኒ ዻበቱ፤ እጀሳስ ንኛቱ።<verse eid="ISA 65:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 65:22"/>ስአች እሳን መነ እጃረኒ ነሞትን ብራ ኬሰ ህንጅራተን፤</para>
  <para style="q2" vid="ISA 65:22">ዮካን እሳን ብቅልቱ ዻበኒ ነሞትን ብራ ህንኛተን።</para>
  <para style="q1" vid="ISA 65:22">ኡሙሪን ሰበኮ፣</para>
  <para style="q2" vid="ISA 65:22">አኩመ ኡሙሪ ሙካ ንተአ፤</para>
  <para style="q1" vid="ISA 65:22">ወር አን ፍለዼ፣</para>
  <para style="q2" vid="ISA 65:22">ሆጂ ሀርከሳኒቲን በረ ዼራ ንገመዱ።<verse eid="ISA 65:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 65:23"/>እሳን አከሱማን ህንደዸበን</para>
  <para style="q2" vid="ISA 65:23">ዮካን እጆሌ በላን ኤገቱ ህንዸልቸን፤</para>
  <para style="q1" vid="ISA 65:23">እሳን ሰኚሳኒ ወጅን</para>
  <para style="q2" vid="ISA 65:23">ሰበ <char style="nd">ዋቀዮ</char> ኤብሱ ንተኡ።<verse eid="ISA 65:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 65:24"/>አን ኡቱ እሳን ነ ህንዋመትን ነንዴብሳፍ፤</para>
  <para style="q2" vid="ISA 65:24">ኡቱ እሳን ዱበተኒ ህንፍጥንስ ነንዸገአ።<verse eid="ISA 65:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 65:25"/>ዬዪፊ ጦባላን ሆላ ወሊ ወጅን ኛቱ፤</para>
  <para style="q2" vid="ISA 65:25">ሌንጭ አከ ሰንጋ ኦካ ኛተ፤</para>
  <para style="q2" vid="ISA 65:25">ብዮን ገሩ ሶረ ቦፋ ተአ።</para>
  <para style="q1" vid="ISA 65:25">እሳን ቱሉኮ ቁልቁሉ ሁንደረት ሆማ ህንሚዸን</para>
  <para style="q2" vid="ISA 65:25">ዮካን ሆማ ህንበሌሰን”</para>
  <para style="q2" vid="ISA 65:25">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="ISA 65:25"/></para>
  <chapter eid="ISA 65"/>
  <chapter number="66" style="c" sid="ISA 66"/>
  <para style="s1">ሙርቲፊ አብዲ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 66:1"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="ISA 66:1">“ሰሚን ቴሶኮት፤</para>
  <para style="q2" vid="ISA 66:1">ለፍትስ ኤጄተ ሚለኮቲት።</para>
  <para style="q1" vid="ISA 66:1">መን እስን ናፍ እጃርተን ሜሬ?</para>
  <para style="q2" vid="ISA 66:1">ለፍት ቦቆናኮቲ ኤሰ?<verse eid="ISA 66:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 66:2"/>ዋን ከነ ሁንደ ሀርክኮ ህንሆጄትኔ?</para>
  <para style="q2" vid="ISA 66:2">ከናፉ ወንቶትን ኩኔን ሁንድ ከኑመኮት”</para>
  <para style="q2" vid="ISA 66:2">ጄዸ <char style="nd">ዋቀዮ</char>።</para>
  <para style="b" vid="ISA 66:2"/>
  <para style="q1" vid="ISA 66:2">“አን ገሩ ነመ ገድ ኦፍ ቀቡፊ</para>
  <para style="q2" vid="ISA 66:2">ከን ገራሳ ኬሰት ጋቤ</para>
  <para style="q2" vid="ISA 66:2">ዱቢኮቲን ሆለቱ ነንእላለ።<verse eid="ISA 66:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 66:3"/>ገሩ ነምን ኮርመ ቀሉ ከምዩ</para>
  <para style="q2" vid="ISA 66:3">አኩመ ነመ ነመ አጄሱ ቶኮት፤</para>
  <para style="q1" vid="ISA 66:3">ነምን ጦባላ ሆላ ቀሉ ከምዩ</para>
  <para style="q2" vid="ISA 66:3">አኩመ ነመ ሞርመ ሰሬ ጨብሱ ቶኮት፤</para>
  <para style="q1" vid="ISA 66:3">ነምን ኣርሳ ምዻኒ ዽኤሱ ከምዩ</para>
  <para style="q2" vid="ISA 66:3">አኩመ ነመ ዺገ ቦዬ ዽኤሱ ቶኮት፤</para>
  <para style="q1" vid="ISA 66:3">ነምን እጣነ ያደኖ ኣርሱ ከምዩስ</para>
  <para style="q2" vid="ISA 66:3">አኩመ ነመ ዋቀ ቶልፈማ ዋቄፈቱ ቶኮት።</para>
  <para style="q1" vid="ISA 66:3">እሳን ከራ ኦፊሳኒ ፍለተኒሩ፤</para>
  <para style="q2" vid="ISA 66:3">ሉቡንሳኒስ ጡራኡማሳኒት ገመድ።<verse eid="ISA 66:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 66:4"/>ከናፉ አን ግድራ እሳኒፍ ነንፍለ፤</para>
  <para style="q2" vid="ISA 66:4">ዋን እሳን አከ መሌ ሶዳተንስ እሳንት ነንፍደ።</para>
  <para style="q1" vid="ISA 66:4">ዬሮ አን ዋሜት ነምን ቶኮዩ ነ ጀላ ህንኦዋትኔ፤</para>
  <para style="q2" vid="ISA 66:4">ዬሮ አን ዱበዼት ነምን ቶኮዩ <optbreak/> ህንዸጌፈኔቲ።</para>
  <para style="q1" vid="ISA 66:4">እሳን ፉለኮ ዱረት ዋን ሀማ ሆጄተኒ</para>
  <para style="q2" vid="ISA 66:4">ዋን ነ ህንገመቺፍኔሌ ፍለተን።”<verse eid="ISA 66:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 66:5"/>ወር ዱቢሳቲን ሆለተን</para>
  <para style="q2" vid="ISA 66:5">ዱቢ <char style="nd">ዋቀዮ</char> ዸገኣ፦</para>
  <para style="q1" vid="ISA 66:5">“ኦቦሎትንኬሰን ወር ሰበቢ መቃኮቲፍ እስን ጅበኒ</para>
  <para style="q2" vid="ISA 66:5">እስን አርአን ሱን አከነ ጄዸን፤</para>
  <para style="q1" vid="ISA 66:5">‘አከ ኑ ገመቹኬሰን አርግኑፍ፣</para>
  <para style="q2" vid="ISA 66:5">ሜ <char style="nd">ዋቀዮ</char> ሃኡልፋቱ!’</para>
  <para style="q2" vid="ISA 66:5">ተኡስ እሳን ንቃነኡ።<verse eid="ISA 66:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 66:6"/>ሁርሳ መጋላ ኬሳ ሰነ ዸገኣ፤</para>
  <para style="q2" vid="ISA 66:6">ወጨ መነ ቁልቁሉማ ኬሳ ዸገኣ!</para>
  <para style="q1" vid="ISA 66:6">ወን ኩን ሰገሌ <char style="nd">ዋቀዮ</char> ከን ዬሮ እን</para>
  <para style="q2" vid="ISA 66:6">ገቲ ዲኖተሳ ሁንዳፍ መሉ እሳኒፍ ኬኑት።<verse eid="ISA 66:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 66:7"/>“እሼን ኡቱ ህንጭኒንስፈትን፣</para>
  <para style="q2" vid="ISA 66:7">ንዴስ፤</para>
  <para style="q1" vid="ISA 66:7">ኡቱ ሚጡን ደኡምሳ እሼ ህንቀበን፣</para>
  <para style="q2" vid="ISA 66:7">እልመ ዴስ።<verse eid="ISA 66:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 66:8"/>ኤኙቱ ተኩማ ዋን አከሲ ዸገኤ?</para>
  <para style="q2" vid="ISA 66:8">ዋን ተኩማ አከሲ ኤኙቱ አርጌ?</para>
  <para style="q1" vid="ISA 66:8">ብይ ቶኮ ጉዩመ ቶኮት ዸለቹ ደንዴሲ?</para>
  <para style="q2" vid="ISA 66:8">ዮካን ሰብን ዬሩመ ቶኮት ብቅሉ ደንደኣ?</para>
  <para style="q1" vid="ISA 66:8">ጥዮን ገሩ አኩመ ጭኒንስፈቴን፣</para>
  <para style="q2" vid="ISA 66:8">እጆሌሼ ዴሴ።<verse eid="ISA 66:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 66:9"/>አን ዬሮ ደኡምሳቲን ነመ ገኤ</para>
  <para style="q2" vid="ISA 66:9">ደኡ ነንዾዋ?”</para>
  <para style="q2" vid="ISA 66:9">ጄዸ <char style="nd">ዋቀዮ</char>።</para>
  <para style="q1" vid="ISA 66:9">“አን ደኡምሳን ገኤ</para>
  <para style="q2" vid="ISA 66:9">ገደሜሰ ነንጩፋ?”</para>
  <para style="q2" vid="ISA 66:9">ጄዸ ዋቅንኬ።<verse eid="ISA 66:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 66:10"/>“እስን ወር እሼ ጃለተን ሁንድ፣</para>
  <para style="q2" vid="ISA 66:10">ዬሩሳሌም ወጅን ገመዳ፤ እሼፍስ እልልቻ፤</para>
  <para style="q1" vid="ISA 66:10">እስን ወር እሼፍ ቦሰን ሁንድ፣</para>
  <para style="q2" vid="ISA 66:10">ጉድሳቲ እሼ ወጅን ገመዳ።<verse eid="ISA 66:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 66:11"/>እስን ሀርመሼ ከን ነመ</para>
  <para style="q2" vid="ISA 66:11">ጀጀቤሱ ሰነ ሆተኒ ንቁፍቱቲ፤</para>
  <para style="q1" vid="ISA 66:11">ኡልፍነሼ ጉዳ ሰነራስ</para>
  <para style="q2" vid="ISA 66:11">ገመቹዻን ንዹግዱ።”<verse eid="ISA 66:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 66:12"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዻቲ፦</para>
  <para style="q1" vid="ISA 66:12">“ኩኖ አን ነጋ አኩመ ብሻን ለጋ፣</para>
  <para style="q2" vid="ISA 66:12">በዻዹማ ሰቦታስ አኩመ ለገ ያኡ <optbreak/> እሼፍ ነንዸንገላሰ፤</para>
  <para style="q1" vid="ISA 66:12">እስን ንሆቱ፤ ሀርከሼረት ንባተምቱ፤</para>
  <para style="q2" vid="ISA 66:12">ጉዴደሼረሌ ንተጰቱ።<verse eid="ISA 66:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 66:13"/>አኩመ ሃት ዳእመሼ ኡሩርስቱ ሰነ፣</para>
  <para style="q2" vid="ISA 66:13">አንስ እስነን ኡሩርሰ፤</para>
  <para style="q2" vid="ISA 66:13">እስንስ ዬሩሳሌም ኬሰት ንኡሩርፈምቱ።”<verse eid="ISA 66:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 66:14"/>እስን ዮሙ ዋን ከነ አርግተንት ገራንኬሰን ንገመደ፤</para>
  <para style="q2" vid="ISA 66:14">ለፌንኬሰን አከ መርጋ ንሃሮምፈመ፤</para>
  <para style="q1" vid="ISA 66:14">ሀርክ <char style="nd">ዋቀዮ</char> አከ ገርቦተሳ ወጅን ጅሩስ ንቤከመ፤</para>
  <para style="q2" vid="ISA 66:14">ዼከምስሳ ገሩ አመጃጆተሳረት ንሙልእፈመ።<verse eid="ISA 66:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 66:15"/>ኩኖ፣ <char style="nd">ዋቀዮ</char> እብዳን ንዹፈ፤</para>
  <para style="q2" vid="ISA 66:15">ጋሪወንሳስ አኩመ ቡቤ ሀማት፤</para>
  <para style="q1" vid="ISA 66:15">እን ኣሪሳ ዸእቻን፣</para>
  <para style="q2" vid="ISA 66:15">እፈትናሳሞ አረበ እብዳቲን ገድ ቡሰ።<verse eid="ISA 66:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 66:16"/>
    <char style="nd">ዋቀዮ</char> እብዳፊ ጎራዴሳቲን</para>
  <para style="q2" vid="ISA 66:16">ነሞተ ሁንደረት ሙርቲ ራወታቲ፤</para>
  <para style="q2" vid="ISA 66:16">ነሞትን <char style="nd">ዋቀዮን</char> አጄፈመን ንባይአቱ።<verse eid="ISA 66:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 66:17"/>“ወር እዶ ብቅልቱ ሴኑፍ ጄዸኒ፣ እሰ ወረ ፎን ቦዬ፣ ፎን ሀንቱታቲፊ ወንቶተ ጅብሲሶ ብራ ኛተን ግዱት አርገሙ ዱካ ቡኡዻን አዳን ኦፍ ባሰኒ ኦፍ ቁልቁሌሰን ወጅን በርበዴፈሙ” ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="ISA 66:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 66:18"/>“አን ዋነን ሆጂፊ ያደሳኒ ቤኩፍ፣ ሰቦታፊ አፋኖተ ሁንደ ወልት ቀቡፍ ጄዼ ነንዹፈ፤ እሳንስ ዹፈኒ ኡልፍነኮ ንአርጉ።<verse eid="ISA 66:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 66:19"/>“አን ግዱሳኒ መለቶ ነንካአ፤ ሀምባወን ኬሳ ነሞተ ቶኮ ቶኮ ገረ ሰቦታ ጄቹንስ ገረ ተርሺሽ፣ ጱሊፊ ገረ ሉድ ወረ ጥያን ሎለን፣ ገረ ቱባሊፊ ያዋን አከሱመስ ገረ ብዮተ ብሻን ግዱ ፈጎ ጅረን ከኔን ዋኤኮ ህንዸገእኒ ዮካን ኡልፍነኮ ህንአርግኒት ነንኤርገ። እሳንስ ሰቦተ ግዱት ኡልፍነኮ ንለብሱ። <verse eid="ISA 66:19"/><verse number="20" style="v" sid="ISA 66:20"/>እሳንስ ሰቦተ ሁንደ ኬሳ ኦቦሎተኬሰን ሁንደ አኩመ ኣርሳ <char style="nd">ዋቀዮፍ</char> ዽኤፈሙ ቶኮት ፈርዴኒን፣ ጋሪወኒን፣ ሀሮታን፣ ጋንጎሊፊ ጋለወኒን ገረ ቱሉኮ ቁልቁሉት፣ ገረ ዬሩሳሌም ንፍዱ” ጄዸ <char style="nd">ዋቀዮ</char>። “እሳንስ አኩመ እስራኤሎን ምአ አከ ሴራት ቁልቁሉ ተኤን ኣርሳ ምዻንሳኒ ገረ መነ ቁልቁሉማ <char style="nd">ዋቀዮት</char> ፍደን ሰነት ጀረ ፍዱ። <verse eid="ISA 66:20"/><verse number="21" style="v" sid="ISA 66:21"/>አንስ እሳን ኬሳ ነሞተ ቶኮ ቶኮ አከ እሳን ሉቦታፊ ሌዎተ ተአኒፍ ነንፍለዸ” ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="ISA 66:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 66:22"/>“አኩመ ሰሚን ሃራኒፊ ለፍት ሃራን አን ኡሙ እት ፉፈኒ ፉለኮ ዱረ ጅራተን ሰነ መቃፊ ሰኚንኬሰን እት ፉፈኒ ጅራቱ” ጄዸ <char style="nd">ዋቀዮ</char>። <verse eid="ISA 66:22"/><verse number="23" style="v" sid="ISA 66:23"/>“አያነ ባቲ ቶኮ ሀመ አያነ ባቲ ካኒት፣ ሰንበተ ቶኮ ሀመ ሰንበተ ካኒትስ ሰኚን ነማ ሁንድ ዹፌ ፉለኮ ዱረት ንሰገደ” ጄዸ <char style="nd">ዋቀዮ</char>። <verse eid="ISA 66:23"/><verse number="24" style="v" sid="ISA 66:24"/>“እሳንስ ገድ በአኒ ሬፈ ወረ ነት ፍንጭለኒ ንእላሉ፤ ራሞንሳኒ ህንዱኡ፤ እብድሳኒስ ህንዻሙ፤ እሳንስ ሰኚ ነማ ሁንዳፍ ጅብሲሶ ተኡ።”<verse eid="ISA 66:24"/></para>
  <chapter eid="ISA 66"/>
</usx>
