<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="LUK" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">ሉቃስ</para>
  <para style="toc1">ወንጌለ ሉቃስ</para>
  <para style="toc2">ሉቃስ</para>
  <para style="toc3">ሉቃ</para>
  <para style="mt2">ወንጌለ</para>
  <para style="mt1">ሉቃስ</para>
  <chapter number="1" style="c" sid="LUK 1"/>
  <para style="s1">ሴንሰ</para>
  <para style="r">
    <ref loc="LUK 1:1-4">1፥1‑4</ref> ኩወእ – <char style="xt"><ref loc="ACT 1:1">ሆጂ 1፥1</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 1:1"/>ነሞትን ባይኤን ሴና ወንቶተ ኑ ግዱት ራወተሜ ሰና በሬሱ ያለኒሩ፤ <verse eid="LUK 1:1"/><verse number="2" style="v" sid="LUK 1:2"/>ኩንስ አከ ወር ጀልቀባ ካሰኒ እጃን አርገኒፊ ተጃጅልቶተ ዱብቻ ቱረን ሱን ኑት ደበርሰኒ ኬነንት። <verse eid="LUK 1:2"/><verse number="3" style="v" sid="LUK 1:3"/>ከናፉ ያ ቴዎፍሎስ ከበጀማ፣ አንስ ጀልቀቡማ ካሴ ዋን ሁንዱማ ስሪት ኤርገን ቆረዼ ቦዴ ሴና ሰነ ወል ዱራ ዱባን ሲፍ በሬሱን ዋን ጋሪ ነት ፈካቴረ። <verse eid="LUK 1:3"/><verse number="4" style="v" sid="LUK 1:4"/>ኩንስ አከ ወን አት በረቴ ሱን ዹጋ ተኤ አከ ቤክቱፍ።<verse eid="LUK 1:4"/></para>
  <para style="s1">ዸለቹ ዮሀንስ ጩጳ</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 1:5"/>በረ ሄሮድስ ሞቲ ይሁዳ ቱሬት ረመዲ ሉቡማ አብያ ኬሳ ሉበ ዘካርያስ ጄዸሙ ቶኮቱ ቱሬ፤ ኒቲንሳ ኤልሳቤጥስ ሰኚ ኣሮን። <verse eid="LUK 1:5"/><verse number="6" style="v" sid="LUK 1:6"/>ለማንሳኒዩ አጀጃፊ ሴረ ጎፍታ ሁንደ ሙዳ መሌ ኤጉዻን ፉለ ዋቃ ዱረት ቀጄልቶተ ቱረን። <verse eid="LUK 1:6"/><verse number="7" style="v" sid="LUK 1:7"/>ገሩ ኤልሳቤጥ ዋን ዸብዱ ቱርቴፍ እጆሌ ህንቀበን ቱሬ፤ ለማንሳኒዩ ዱሎመኒ ቱረን።<verse eid="LUK 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 1:8"/>ዘካርያስስ ደበሬን ገሬሳ ጌኛን ኡቱ ፉለ ዋቃ ዱረት ተጃጅለ ሉቡማሳ ኬና ጅሩ፣ <verse eid="LUK 1:8"/><verse number="9" style="v" sid="LUK 1:9"/>አኩመ ዱዻ ሉቡማት አከ መነ ቁልቁሉማ ጎፍታ ሴኔ እጣነ ኣርሱፍ እጣዻን ፍለተሜ። <verse eid="LUK 1:9"/><verse number="10" style="v" sid="LUK 1:10"/>ዬሮ እጣን ኣርፈሙትስ<note caller="+" style="f"><char style="fr" closed="false">1፥10 </char><char style="fq" closed="false">ዬሮ እጣን ኣርፈሙትስ </char><char style="ft" closed="false">– ዬሮ እት ኣርሳን ገልገላ ዽኤፈሙዸ። ዬሮንሳስ ጉያ ኬሳ ገረ ሰኣቲ ሰገሊት።</char></note> ነሞትን ባይኤን አለት ከዸቻ ቱረን።<verse eid="LUK 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 1:11"/>ኤርገማን ጎፍታስ እዶ ኣርሳ እጣናቲን ምርገ ዻበቴ ዘካርያስት ሙልአቴ። <verse eid="LUK 1:11"/><verse number="12" style="v" sid="LUK 1:12"/>ዘካርያስስ ዮሙ እሰ አርጌት ንርፈቴ፤ ሶዳንስ እሰ ቀበቴ። <verse eid="LUK 1:12"/><verse number="13" style="v" sid="LUK 1:13"/>ኤርገማን ሱን ገሩ አከነ እሳን ጄዼ፤ “ያ ዘካርያስ፣ ህንሶዳትን፤ ከዸትናንኬ ዸገአሜረ። ኒቲንኬ ኤልሳቤጥ እልመ ሲፍ ዴስ፤ አትስ መቃሳ ዮሀንስ ጄዺ ሞጋስ። <verse eid="LUK 1:13"/><verse number="14" style="v" sid="LUK 1:14"/>አት እልሌፊ ገመቹ ንቀባተ፤ ነሞትን ባይኤንስ ዸለቹሳት ንገመዱ፤ <verse eid="LUK 1:14"/><verse number="15" style="v" sid="LUK 1:15"/>እን ፉለ ጎፍታ ዱረት ጉዳ ተኣቲ። ዳዺ ወይኒ ዮካን ዹጋቲ ነመ መቼሱ ዹጉ ጎንኩማ ህንቀቡ፤<note caller="+" style="f"><char style="fr" closed="false">1፥15 </char><char style="fqa" closed="false">ዳዺ ወይኒ ዮካን ዹጋቲ ነመ መቼሱ ጎንኩማ ዹጉ ህንቀቡ </char><char style="ft" closed="false">– ኩን ድርቀመ አዳ ከን ነምን ከኩ ናዝሩማ ኦፍራ ቀቡ ቶኮ ጉቱ ቀቡዸ።</char></note> ኡቱመ ገራ ሃዸሳ ኬሰ ጅሩስ ሀፉረ ቁልቁሉዻን ንጉተመ። <verse eid="LUK 1:15"/><verse number="16" style="v" sid="LUK 1:16"/>ሰበ እስራኤል ኬሳስ ነሞተ ባይኤ ገረ ጎፍታ፣ ገረ ዋቀሳኒት ንዴብሰ። <verse eid="LUK 1:16"/><verse number="17" style="v" sid="LUK 1:17"/>እንስ ሰበ ጎፍታፍ ቆጳኤ ቶኮ ኩርፌሱፍ ጄዼ ገራ አቦቲ ገረ እጆሌሳኒት፣ ወረ ህንአጀጀምኔሞ ገረ ኦጉማ ቀጄልቶታት ዴብሱፍ ሀፉራፊ ሁምነ ኤልያሲን ፉለ ጎፍታ ዱረ ንዴመ።”<verse eid="LUK 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 1:18"/>ዘካርያስስ፣ “አን አከምን ከነ ቤከ? አን ዱሎሜረ፤ ኡሙሪን ኒቲኮቲስ ዴሜረ” ጄዼ ኤርገማ ሰነ ጋፈቴ።<verse eid="LUK 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 1:19"/>ኤርገማን ሱንስ አከነ ጄዼ ዴብሴፍ፤ “አን ገብርኤል እሰ ፉለ ዋቃ ዱረ ዻበቱዸ፤ አንስ ስት ዱበቹፊ ኦዱ ገመቺሳ ከነ ስት ህሙፍ ኤርገሜረ። <verse eid="LUK 1:19"/><verse number="20" style="v" sid="LUK 1:20"/>ኩኖ፣ አት ሰበቢ ዱቢኮ እሰ ዬሮሳት ምርከናኡ ህንአመንኒፍ ሀመ ጋፈ ወን ኩን ተኡት ንዱደ፤ ዱበቹስ ህንደንዴሱ።”<verse eid="LUK 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 1:21"/>ኡመትንስ ዬሮ ሰነ ሰበቢ ዘካርያስ ዬሮ አከስ ዼረቱ መነ ቁልቁሉማ ኬሰ ቱሬፍ ድንቅፈቻ እሰ ኤጋ ቱሬ። <verse eid="LUK 1:21"/><verse number="22" style="v" sid="LUK 1:22"/>ገሩ ዘካርያስ ዮሙ ገድ በኤት ዋን እሳንት ዱበቹ ህንደንደኢኒፍ እሳን አከ እን መነ ቁልቁሉማ ኬሰት ሙልአተ ወዪ አርጌ ሁበተን፤ እንስ መለቶን እሳንት ህማ ቱሬ መሌ ዱበቹ ህንደንዴኜ።<verse eid="LUK 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 1:23"/>እንስ ዮሙ ዬሮን ተጃጅለሳ ራወቴት ገረ መነሳት ዴብኤ። <verse eid="LUK 1:23"/><verse number="24" style="v" sid="LUK 1:24"/>ኤርገሲ ኒቲንሳ ኤልሳቤጥ ኡልፎፍቴ ሀመ ጅአ ሸኒት መና ህንባኔ። <verse eid="LUK 1:24"/><verse number="25" style="v" sid="LUK 1:25"/>እሼንስ፣ “ጎፍታን ሰልጵነ ነሞተ ግዱት ነረ ቱሬ ነራ ካሱፍ ጄዼ ጉያ አርጁማን ነ ያደቴት ዋን ከነ ናፍ ጎዼ” ጄቴ።<verse eid="LUK 1:25"/></para>
  <para style="s1">ዸለቹ ዬሱስ</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 1:26"/>ጅአ ጀአፋትስ ገብርኤል ኤርገምች ዋቀ ብራ ገረ መጋላ ናዝሬት እሼ ገሊላ ኬሰት አርገምቱት ኤርገሜ፤ <verse eid="LUK 1:26"/><verse number="27" style="v" sid="LUK 1:27"/>እንስ ገረ ዱርበ ነምች ሰኚ ዳዊትራ ዸለቴ ከን መቃንሳ ዮሴፍ ጄዸሙ ቶኮፍ ካዽመምቴ<note caller="+" style="f"><char style="fr" closed="false">1፥27 </char><char style="ft" closed="false">ካዽመ ቀባቹን አከ በርቴ ይሁዶታት አኩመ ነመ ወል ፉዼት ጭማዸ። እንተል ካዽመምቴ ቶኮ ነመ ብራ ወጅን ጪሱን ገሩ አኩመ ኤጃት እላለመ። ወሊ ገልቴ ካዽማ ዲጉንስ ኒቲ ኦፊ ዮካን ዽርሰ ኦፊ ሂኩ ወጅን ቶኩመ።</char></note> ዹፌ። መቃን ዱርበ ቁልቁልቲ ሰናስ ማርያም ቱሬ። <verse eid="LUK 1:27"/><verse number="28" style="v" sid="LUK 1:28"/>ኤርገማን ዋቃ ሱንስ ገረሼ ዸቄ፣ “ያ እሼ ሱራ አርገቴ፤ ነጋን ሲፍ ሃተኡ! ጎፍታን ስ ወጅን ጅረ” ጄዼ።<verse eid="LUK 1:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 1:29"/>ማርያም ገሩ ዱቢ ኤርገማ ሰናቲን አከ መሌ ጄቀምቴ፣ “ኩን ነጋ አከሚቲ?” ጄቴ ያዴ። <verse eid="LUK 1:29"/><verse number="30" style="v" sid="LUK 1:30"/>ኤርገምች ገሩ አከነ እሼዻን ጄዼ፤ “ያ ማርያም፣ ህንሶዳትን፤ አት ዋቀ ብራ ሱራ አርገቴርታቲ። <verse eid="LUK 1:30"/><verse number="31" style="v" sid="LUK 1:31"/>ኩኖ ንኡልፎፍተ፤ እልመስ ንዴሰ፤ መቃሳስ ዬሱስ ጄቴ ሞጋፍተ። <verse eid="LUK 1:31"/><verse number="32" style="v" sid="LUK 1:32"/>እንስ ጉዳ ንተአ፤ እልመ ዋቀ ዋን ሁንዳ ኦሊ ጄዸሜስ ንዋመመ። ዋቅን ጎፍታንስ ቴሶ አባሳ ዳዊት ንኬናፍ፤ <verse eid="LUK 1:32"/><verse number="33" style="v" sid="LUK 1:33"/>እን መነ ያቆብረት በረ በራን ንሞአ፤ ሞቱማንሳስ ዹመ ህንቀቡ።”<verse eid="LUK 1:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 1:34"/>ማርያምስ፣ “አን ዱርበ፤ ዮስ ወን ኩን አከምት ተኡ ደንደአሬ?” ጄቴ ኤርገማ ሰነ ጋፈቴ።<verse eid="LUK 1:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 1:35"/>ኤርገማን ሱንስ አከነ ጄዼ ዴብሴፍ፤ “ሀፉር ቁልቁሉን ስረ ቡአ፤ ሁምን ዋቀ ዋን ሁንዳ ኦሊስ ስጎልቦበ። ከናፍ እን ቁልቁሉን ዸለቱ ሱን እልመ ዋቃ ንጄዸመ። <verse eid="LUK 1:35"/><verse number="36" style="v" sid="LUK 1:36"/>ኩኖ፣ ፍርኬ ኤልሳቤጥዩ ዱሉመሼ ኬሰ እልመ ኡልፎፍቴርት፤ እሼን ዸብዱ ጄዸማ ቱርቴ ሱን ጅአ ጀአፋ ቀበቴርት። <verse eid="LUK 1:36"/><verse number="37" style="v" sid="LUK 1:37"/>ወን ዋቃፍ ህንደንደአምኔ ህንጅሩቲ።”<verse eid="LUK 1:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 1:38"/>ማርያምስ፣ “ኩኖ፣ አን ገርብቲ ጎፍታት። አኩመ አት ዱበቴ ናፍ ሃተኡ” ጄቴን። ኤርገምችስ እሼ ዺሴ ዴሜ።<verse eid="LUK 1:38"/></para>
  <para style="s1">ማርያም ኤልሳቤጥን ዱብሱ ዸቅጤ</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 1:39"/>ዬሮ ሰነ ማርያም ካቴ አሪቲዻን ገረ መጋላ በዳ ብየ ይሁዳ ቶኮ ዸቅጤ። <verse eid="LUK 1:39"/><verse number="40" style="v" sid="LUK 1:40"/>እሼንስ መነ ዘካርያስ ሴንቴ ኤልሳቤጥን ነጋ ጋፈቴ። <verse eid="LUK 1:40"/><verse number="41" style="v" sid="LUK 1:41"/>ኤልሳቤጥስ ዮሙ ነጋ ማርያም ዸጌሴት ሙጫን ሱን ገደሜሰሼ ኬሰ ኡኡታሌ። ኤልሳቤጥስ ሀፉረ ቁልቁሉዻን ንጉተምቴ። <verse eid="LUK 1:41"/><verse number="42" style="v" sid="LUK 1:42"/>እሼንስ ሰገሌሼ ኦል ፉዸቴ እይቴ አከነ ጄቴ፤ “አት ዱበርቶተ ኬሳ ኤብፈምቱዸ፤ ሙጫን አት ዴሱስ ኤብፈማዸ። <verse eid="LUK 1:42"/><verse number="43" style="v" sid="LUK 1:43"/>ገሩ አከ ሃት ጎፍታኮ ገረኮ ዹፍቱፍ አርጁማን አከና አከምት ና ጎዸሜ? <verse eid="LUK 1:43"/><verse number="44" style="v" sid="LUK 1:44"/>ኩኖ፣ አኩመ ሰገሌን ነጋኬቲ ጉረኮ ሴኔን ኡልፍ ገደሜሰኮ ኬሰ ጅሩ ገመቹዻን ኡታሌረ። <verse eid="LUK 1:44"/><verse number="45" style="v" sid="LUK 1:45"/>ወን ጎፍታን እሼት ዱበቴ አከ ራወተሙ ከን አመንቴ እሼን ኤብፈምቱዸ!”<verse eid="LUK 1:45"/></para>
  <para style="s1">ፋርፈትና ማርያም</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 1:46"/>ማርያምስ አከነ ጄቴ፦</para>
  <para style="q1" vid="LUK 1:46">“ሉቡንኮ ጎፍታዻፍ ኡልፍነ ኬንት፤<verse eid="LUK 1:46"/></para>
  <para style="q2">
    <verse number="47" style="v" sid="LUK 1:47"/>ሀፉርኮስ ፈይሳኮ ዋቀት ንገመደ፤<verse eid="LUK 1:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="LUK 1:48"/>እን ሰልጵነ ገርብቲሳ አርጌራቲ።</para>
  <para style="q2" vid="LUK 1:48">ኩኖ አማ ጀልቀቤ ዸሎትን ሁንድኑ ኤብፈምቱ ናን ጄዸ፤<verse eid="LUK 1:48"/></para>
  <para style="q2">
    <verse number="49" style="v" sid="LUK 1:49"/>እን ሁምነ ቀቤስ ሱን ዋን ጉዳ ናፍ ጎዼራቲ፤</para>
  <para style="q2" vid="LUK 1:49">መቃንሳ ቁልቁሉዸ።<verse eid="LUK 1:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="LUK 1:50"/>አራርሳስ ወረ እሰ ሶዳተኒፍ</para>
  <para style="q2" vid="LUK 1:50">ዸሎታ ሀመ ዸሎታት እት ፉፈ።<verse eid="LUK 1:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="LUK 1:51"/>እን እሬሳቲን ሆጂወን ጉርጉዳ ሆጄቴረ፤</para>
  <para style="q2" vid="LUK 1:51">ኦፍ ቱልቶተስ ያደ ገራሳኒቲን ብትኔሴረ።<verse eid="LUK 1:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="LUK 1:52"/>ቡልችቶተ ቴሶሳኒራ ቡሴረ፤</para>
  <para style="q2" vid="LUK 1:52">ገድ ኦፍ ቀቤዪ ገሩ ኦል ካሴረ።<verse eid="LUK 1:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="LUK 1:53"/>ወረ ቤለአን ዋን ጋሪዻን ቁፍሴረ፤</para>
  <para style="q2" vid="LUK 1:53">ሶሬዪ ገሩ ሀርከ ዱዋ ዴብሴረ።<verse eid="LUK 1:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="LUK 1:54"/>እን አራረ ቀቤሰ ተኡሳ ያደቻ</para>
  <para style="q2" vid="LUK 1:54">ገርብቸሳ እስራኤልን ገርጋሬረ፤<verse eid="LUK 1:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="LUK 1:55"/>ኩንስ አኩመ እን አቦቲኬኛፍ፣</para>
  <para style="q2" vid="LUK 1:55">አብረሃሚፊ ሰኚሳቲፍ በረ በራን ዋዳ ገሌት።”<verse eid="LUK 1:55"/></para>
  <para style="p">
    <verse number="56" style="v" sid="LUK 1:56"/>ማርያምስ ገረ ጅአ ሰዲ ኤልሳቤጥ ብረ ቱርቴ ገረ መነ ኦፊሼት ዴብቴ።<verse eid="LUK 1:56"/></para>
  <para style="s1">ዸለቹ ዮሀንስ ጩጳ</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 1:57"/>ኤልሳቤጥ ዬሮን ደኡምሰሼ ጌኛን እልመ ዴሴ። <verse eid="LUK 1:57"/><verse number="58" style="v" sid="LUK 1:58"/>ኦሎትንሼቲፊ ፍሮትንሼ አከ ጎፍታን አራረ ጉዳ እሼፍ ጎዼ ዸገአኒ እሼ ወጅን ገመደን።<verse eid="LUK 1:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 1:59"/>እሳንስ ጉያ ሰዴተፋት ዳእመ ሰነ ዸግነ ቀቡ ዹፈን፤ ዘካርያስ ጄዸኒስ መቃ አባሳቲን እሰ ሞጋሱ ፌዸን። <verse eid="LUK 1:59"/><verse number="60" style="v" sid="LUK 1:60"/>ሃትሳ ገሩ፣ “ለኪ! እን ዮሀንስ ጄዸሜ ዋመሙ ቀበ” ጄቴ።<verse eid="LUK 1:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 1:61"/>እሳንስ፣ “ፍሮተኬ ኬሰ ነምን መቃ አከና ቀቡ ቶኮዩ ህንጅሩ” ጄዸኒን።<verse eid="LUK 1:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="LUK 1:62"/>ነሞትን ሱንስ አከ ዘካርያስ ኤኙ ጄዼ ዳእመ ሰነ ዋሙ በርባዱ ቤኩፍ ጄዸኒ መለቶን እሰ ጋፈተን። <verse eid="LUK 1:62"/><verse number="63" style="v" sid="LUK 1:63"/>እንስ ገበቴ እረት በሬሱ ከዸቴ፣ “መቃንሳ ዮሀንስ” ጄዼ በሬሴ፤ ሁንድሳኒስ ንድንቅፈተን። <verse eid="LUK 1:63"/><verse number="64" style="v" sid="LUK 1:64"/>ዮሙሱመ አፋንሳ በነሜ አረብንሳ ሂከሜ፤ እንስ ዋቀ ገለቴፈቹዻን ዱበቹ ጀልቀቤ። <verse eid="LUK 1:64"/><verse number="65" style="v" sid="LUK 1:65"/>ኦሎትንሳኒ ሁንድኑ ሶዳዻን ጉተመን፤ ወን ኩንስ በዳ ብየ ይሁዳ ሁንደ ኬሰት ኦዴፈሜ። <verse eid="LUK 1:65"/><verse number="66" style="v" sid="LUK 1:66"/>ወር ከነ ዸገአን ሁንድኑስ፣ “ዮስ ዳእምን ኩን ነመ አከሚ ተእነ ላተ?” ጄዸኒ ገራሳኒት ድንቅፈተን። ሀርክ ጎፍታ እሰ ወጅን ቱሬቲ።<verse eid="LUK 1:66"/></para>
  <para style="s1">ፋርፈትና ዘካርያስ</para>
  <para style="p">
    <verse number="67" style="v" sid="LUK 1:67"/>ዘካርያስ አባን ዮሀንስ ሀፉረ ቁልቁሉዻን ጉተሜ አከነ ጄዼስ ራጂ ዱበቴ፦<verse eid="LUK 1:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="LUK 1:68"/>“ሰበቢ ዹፌ ሰበሳ ፉሬፍ ጎፍታን፣</para>
  <para style="q2" vid="LUK 1:68">ዋቅን እስራኤል ሃኤብፈሙ።<verse eid="LUK 1:68"/></para>
  <para style="q1">
    <verse number="69" style="v" sid="LUK 1:69"/>እን መነ ገርብቸሳ መነ ዳዊት ኬሰት</para>
  <para style="q2" vid="LUK 1:69">ጋንፈ ፈይና ኑፍ ካሴረ፤<verse eid="LUK 1:69"/></para>
  <para style="q1">
    <verse number="70" style="v" sid="LUK 1:70"/>አኩመ አፋን ራጆተሳ ቁልቁሎተ ዱሪቲን ዱበቴት<verse eid="LUK 1:70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="LUK 1:71"/>ዲኖተኬኘ ጀላ፣</para>
  <para style="q2" vid="LUK 1:71">ሀርከ ወረ ኑ ጅበን ሁንዱማ ኬሳስ ኑ ባሱፍ ጄዼ<verse eid="LUK 1:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="LUK 1:72"/>አራረ አቦቲኬኛፍ ዋዳ ገሌ ራወቹዻፍ፣</para>
  <para style="q2" vid="LUK 1:72">ከኩሳ ቁልቁሉ፣<verse eid="LUK 1:72"/></para>
  <para style="q2">
    <verse number="73" style="v" sid="LUK 1:73"/>እን አባኬኘ አብረሃሚፍ ከከቴ ያደቹዻፍ፣<verse eid="LUK 1:73"/></para>
  <para style="q1">
    <verse number="74" style="v" sid="LUK 1:74"/>ሀርከ ዲኖተኬኛ ኬሳ ኑ ባሱዻፍ፣</para>
  <para style="q2" vid="LUK 1:74">አከ ኑ ሶዳ መሌ እሰ ተጃጅሉ ኑ ደንዴስሱዻፍ፣<verse eid="LUK 1:74"/></para>
  <para style="q2">
    <verse number="75" style="v" sid="LUK 1:75"/>አከ ኑ በረ ጅሬኘኬኛ ጉቱ ቁልቁልናፊ ቀጄልናን፣</para>
  <para style="q2" vid="LUK 1:75">ፉለሳ ዱረት ተጃጅሉፍ ዋን ከነ ጎዼ።<verse eid="LUK 1:75"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="76" style="v" sid="LUK 1:76"/>“ያ ሙጫኮ፣ አት ራጂ ዋቀ ዋን ሁንዱማ ኦሊ ንጄዸምተ፤</para>
  <para style="q2" vid="LUK 1:76">አት ከራሳ ቆጴሱፍ ፉለ ጎፍታ ዱረ ንዴምታቲ፤<verse eid="LUK 1:76"/></para>
  <para style="q1">
    <verse number="77" style="v" sid="LUK 1:77"/>ኩንስ አከ አት ዺፈመ ጩቡ አርገቹሳኒቲን ቤኩምሰ ፈይና</para>
  <para style="q2" vid="LUK 1:77">ሰበሳቲፍ ኬንቱፍ፤<verse eid="LUK 1:77"/></para>
  <para style="q1">
    <verse number="78" style="v" sid="LUK 1:78"/>ሰበቢ አራረ ዋቀኬኛ ከን ገረ ላፍናን ጉተሜ</para>
  <para style="q2" vid="LUK 1:78">ከን በሪን ፈይና ሰሚራ እቲን ኑ በርኡ፣<verse eid="LUK 1:78"/></para>
  <para style="q1">
    <verse number="79" style="v" sid="LUK 1:79"/>ወረ ዱከነ ኬሰ፣</para>
  <para style="q2" vid="LUK 1:79">ጋድዱ ዱኣ ጀለ ጅረኒፍ አከ እፈ ኬኑፍ፤</para>
  <para style="q1" vid="LUK 1:79">ሚለኬኘስ ከራ ነጋረ ዴምስሱፍ።”<verse eid="LUK 1:79"/></para>
  <para style="p">
    <verse number="80" style="v" sid="LUK 1:80"/>ሙጭችስ ጉደቴ ሀፉራን ጀባቻ ዴሜ፤ ሀመ ጉያ ሰበ እስራኤልት ሙልአቴትስ ገሞጂ ኬሰ ጅራቴ።<verse eid="LUK 1:80"/></para>
  <chapter eid="LUK 1"/>
  <chapter number="2" style="c" sid="LUK 2"/>
  <para style="s1">ዸለቹ ዬሱስ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 2:1"/>በረ ሰነ ኬሰ አከ አዱኛን ሮማ ሁንድ ገልሜፈሙፍ አዉግስጦስ ቄሳር ብራ ለብሲን በኤ። <verse eid="LUK 2:1"/><verse number="2" style="v" sid="LUK 2:2"/>ለኮብስ ሰባ ኩንስ በረ ቄሬኔዎስ ቡልቻ ብየ ሶርያ ቱሬት ዬሮ ጀልቀባቲፍ ታስፈሜ። <verse eid="LUK 2:2"/><verse number="3" style="v" sid="LUK 2:3"/>ነምን ሁንድኑ ገልሜፈሙፍ ገረ መጋላ እት ዸለቴ ዸቄ።<verse eid="LUK 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 2:4"/>ዮሴፍስ መናፊ ሰኚ ዳዊት ኬሳ ዋን ዸለቴፍ መጋላ ናዝሬት እሼ ገሊላ ኬሳቲ ከኤ ገረ መጋላ ዳዊት እሼ ይሁዳ ኬሳ ከን ቤትልሄም ጄዸምቱት ኦል በኤ። <verse eid="LUK 2:4"/><verse number="5" style="v" sid="LUK 2:5"/>እንስ ካዽመሳ ማርያም እሼ ኡልፈ ቱርቴ ሰነ ወጅን ገልሜፈሙ ዸቄ። <verse eid="LUK 2:5"/><verse number="6" style="v" sid="LUK 2:6"/>ኡቱመ እሳን አች ጅረኑስ ዬሮን ደኡምሰሼ ገኤ። <verse eid="LUK 2:6"/><verse number="7" style="v" sid="LUK 2:7"/>እሼንስ እልመሼ እሰ ሀንገፈ ዴሴ። ዋን መነ ቡልቲ ኬሱሞታ ኬሰ እዶን ህንጅራትኒፍ ሁጩዻን መርቴ ብድሩ ኬሰ እሰ ጪብስቴ።<verse eid="LUK 2:7"/></para>
  <para style="s1">ትክሶታፊ ኤርገሞተ</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 2:8"/>ትክሶተ ሀልከን ሀልከን አለ ቡለኒ ቡሻዬሳኒ ትክፈተንቱ ብየ ሰነ ቱሬ። <verse eid="LUK 2:8"/><verse number="9" style="v" sid="LUK 2:9"/>ኤርገማን ጎፍታ እሳንት ሙልአቴ፤ ኡልፍን ጎፍታስ ናኖሳኒት እብሴ፤ እሳንስ አከ መሌ ሶዳተን። <verse eid="LUK 2:9"/><verse number="10" style="v" sid="LUK 2:10"/>ኤርገማን ሱን ገሩ አከነ እሳኒን ጄዼ፤ “ህንሶዳትና። ኩኖ፣ አን ኦዱ ጋሪ ባይኤ ነመ ገመቺሱ ከን ሰበ ሁንዱማፍ ተኡ እስኒ ፍዴራቲ። <verse eid="LUK 2:10"/><verse number="11" style="v" sid="LUK 2:11"/>ሀርአ መጋላ ዳዊት ኬሰት ፈይሳን እስኒፍ ዸለቴረ፤ እንስ ክርስቶስ ጎፍትቸ። <verse eid="LUK 2:11"/><verse number="12" style="v" sid="LUK 2:12"/>ኩንስ መለቶ እስኒ ተአ፦ ዳእመ ሁጩዻን መረሜ ብድሩ ኬሰ ጪሱ ቶኮ ንአርግቱ።”<verse eid="LUK 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 2:13"/>ኤርገማ ሰነ ወጅንስ ራያን ሰሚራ ባይኤን አኩመ ተሳ ሙልአተኒ ዋቀ ገለቴፈቻ አከነ ጄዸን፤<verse eid="LUK 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LUK 2:14"/>“ሰሚ ጉባት ኡልፍን ዋቃፍ፣</para>
  <para style="q2" vid="LUK 2:14">ለፈረትስ ነጋን ነሞተ እን እት ገመዱፍ ሃተኡ።”<verse eid="LUK 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 2:15"/>ኤርገ ኤርገሞትን ትክሶተ ዺሰኒ ገረ ሰሚት ኦል በአኒ ቦዴ ትክሶትን ሱን፣ “ኮታ ቤትልሄምን ዸቅኔ ዋን ተኤ ከን ጎፍታን ኑት ህሜ ከነ እላላ” ወሊን ጄዸን።<verse eid="LUK 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 2:16"/>እሳንስ ደፈኒ ዸቀኒ ማርያሚፊ ዮሴፍን፣ ዳእመ ብድሩ ኬሰ ጪሱስ አርገን። <verse eid="LUK 2:16"/><verse number="17" style="v" sid="LUK 2:17"/>ዮሙ እሰ አርገንት ዋን ዋኤ ሙጭቻ እሳንት ህመሜ ሰነ ኦዴሰን፤ <verse eid="LUK 2:17"/><verse number="18" style="v" sid="LUK 2:18"/>ወር ዋን ከነ ዸገአን ሁንድኑ ዋን ትክሶትን እሳንት ህመን ሰነ ንድንቅፈተን። <verse eid="LUK 2:18"/><verse number="19" style="v" sid="LUK 2:19"/>ማርያም ገሩ ዋን ከነ ሁንደ ገራት ቀበቴ እት ያዳ ቱርቴ። <verse eid="LUK 2:19"/><verse number="20" style="v" sid="LUK 2:20"/>ትክሶትንስ ሰበቢ ዋን ዸገአኒፊ አርገኒቲፍ ዋቃፍ ኡልፍነ ኬና፣ እሰ ጀጀቻስ ዴብአን፤ ወን ሁንድኑ አኩመ እሳንት ህመሜ ሰነ ቱሬቲ።<verse eid="LUK 2:20"/></para>
  <para style="s1">ዬሱስ መነ ቁልቁሉማት ጌፈሜ</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 2:21"/>እንስ ጉያ ሰዴተፋት፣ አኩመ ዬሮን ዸግነ ቀባሳ ገኤን መቃ ኡቱ ሃትሳዩ እሰ ህንኡልፋእኒን ዱረ ኤርገማን ዋቀዮ እሳፍ ባሴን ዬሱስ ጄዸሜ ሞጋፈሜ።<verse eid="LUK 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 2:22"/>አከ ሴረ ሙሴት ዬሮን ቁልቁላኡማሳኒ ጌኛን ዮሴፊፊ ማርያም ዳእመ ሰነ ጎፍታ ዱረት ዽኤሱፍ ጄዸኒ እሰ ፉዸተኒ ዬሩሳሌምት ኦል በአን። <verse eid="LUK 2:22"/><verse number="23" style="v" sid="LUK 2:23"/>አኩመ ሴረ ጎፍታ ኬሰት በሬፈሜት፣ “ዺር ሀንገፍን ሁንድኑ ጎፍታፍ ንቁልቁሌፈመ።”<note caller="+" style="f"><char style="fr" closed="false">2፥23 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 13:2">በኡ 13፥2</ref>፣<ref loc="EXO 13:12">12</ref></char></char></note> <verse eid="LUK 2:23"/><verse number="24" style="v" sid="LUK 2:24"/>እሳንስ አኩመ ሴር ጎፍታ ጄዹት፣ “ጉጌ ለመ ዮካን ጉጌ ሶሶኬ ለመ”<note caller="+" style="f"><char style="fr" closed="false">2፥24 </char><char style="ft" closed="false"><char style="xt"><ref loc="LEV 12:8">ሌዎ 12፥8</ref></char></char></note> ኣርሳ ዽኤሱ ዸቀን።<verse eid="LUK 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 2:25"/>ኩኖ፣ ነምች ቀጄላን ዋቀ ሶዳቱ ከን መቃንሳ ስሞን ጄዸሙ ቶኮ ዬሩሳሌም ኬሰ ቱሬ። እንስ ጀጀቤፈመ እስራኤል ኤገቻ ቱሬ፤ ሀፉር ቁልቁሉንስ እሰረ ቱሬ። <verse eid="LUK 2:25"/><verse number="26" style="v" sid="LUK 2:26"/>ሀፉር ቁልቁሉንስ አከ እን ኡቱ ክርስቶስ ጎፍትቸ ህንአርግን ህንዱኔ እሰት ሙልእሴ ቱሬ። <verse eid="LUK 2:26"/><verse number="27" style="v" sid="LUK 2:27"/>እንስ ሀፉራን ቀጄልፈሜ መነ ቁልቁሉማ ሴኔ። አባፊ ሃት ዬሱስ ዮሙ አከ ዱዻ ሴርቻት ዋን በርባችሱ እሳፍ ጉቱፍ ጄዸኒ ዬሱስ ሙጭቸ ባዸተኒ ኦል ሴነንት፣ <verse eid="LUK 2:27"/><verse number="28" style="v" sid="LUK 2:28"/>ስሞን ፉዼ እሰ ሀመቴ አከነ ጄዼ ዋቀ ገለቴፈቴ፦<verse eid="LUK 2:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="LUK 2:29"/>“ያ ጎፍታ፣ አኩመ ዱቢኬቲት፣</para>
  <para style="q2" vid="LUK 2:29">አት ገርብቸኬ አመ ነጋን ጌጌስ።<verse eid="LUK 2:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="LUK 2:30"/>እጅኮ ፈይነኬ እሰ አት<verse eid="LUK 2:30"/></para>
  <para style="q2">
    <verse number="31" style="v" sid="LUK 2:31"/>ሰበ ሁንዱማ ዱረት ቆጴስቴ አርጌራቲ፤<verse eid="LUK 2:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="LUK 2:32"/>እንስ ሙልአተ ነሞተ ኦርማቲፍ እፈ፤</para>
  <para style="q2" vid="LUK 2:32">ሰበኬ እስራኤሊፍሞ ኡልፍነ።”<verse eid="LUK 2:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 2:33"/>አባፊ ሃትሳስ ዋን ዋኤሳ ዱበተሜ ሰነ ንድንቅፈተን። <verse eid="LUK 2:33"/><verse number="34" style="v" sid="LUK 2:34"/>ስምኦንስ እሳን ኤብሴ፤ ሃዸ ዳእመ ሰና ማርያሚንስ አከነ ጄዼ፤ “ዳእምን ኩን እስራኤል ኬሰት ኩፋቲዻፊ ከኡምሰ ነሞተ ባይኤቲፍ ሰበቢ፣ ሞርሚ እሰረት ዱበተሙፍስ መለቶ አከ ተኡ ሙርቴፈሜረ፤ <verse eid="LUK 2:34"/><verse number="35" style="v" sid="LUK 2:35"/>ኩንስ አከ ያድን ገራ ነሞተ ባይኤ እፈት በኡፍ። ጎራዴን ሉቡኬ ንወራነ።”<verse eid="LUK 2:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 2:36"/>ጎሰ አሴር ኬሳስ ራጅቲ ሃና ጄዸምቱ ቶኮቱ ቱሬ። እሼንስ እንተለ ፋኑኤል ቱርቴ፤ ባይኤስ ጃርቴ ቱርቴ፤ ዽርሰሼ ከን ዱርቡማዻን እት ሄሩምቴ ወጅን ወጋ ቶርበ ጅራቴ፤ <verse eid="LUK 2:36"/><verse number="37" style="v" sid="LUK 2:37"/>እሼንስ ሀመ ኡሙሪንሼ ወጋ 84 ጉቴት ሃዸ ህዬሳ ታቴ ጅራቴ። ኡቱ መነ ቁልቁሉማቲ ህንዸበምንስ ሶማፊ ከዸትናዻን ሀልከኒ ጉያ ዋቄፈቻ ቱርቴ። <verse eid="LUK 2:37"/><verse number="38" style="v" sid="LUK 2:38"/>ዬሩመ ሰነስ እሳንት ዽኣቴ ዋቃፍ ገለተ ገልችቴ፤ ወረ ፉረመ ዬሩሳሌም ኤገቻ ቱረን ሁንደትስ ዋኤ ዳእመ ሰና ኦዴስቴ።<verse eid="LUK 2:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 2:39"/>ዮሴፊፊ ማርያምስ ዋን ሴር ጎፍታ አጀጁ ሁንደ ራወተኒ ገረ ገሊላት ገረ መጋላሳኒ ናዝሬትት ዴብአን። <verse eid="LUK 2:39"/><verse number="40" style="v" sid="LUK 2:40"/>ሙጭችስ ጉደቴ ጀባቻ ዴሜ፤ ኦጉማዻንስ ንጉተሜ፤ አያን ዋቃስ እሰረ ቱሬ።<verse eid="LUK 2:40"/></para>
  <para style="s1">ዬሱስ ሙጭች መነ ቁልቁሉማ ኬሰት</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 2:41"/>አባፊ ሃትሳ ወጉመ ወጋን አያነ ፋሲካቲፍ ጄዸኒ ዬሩሳሌም ዸቃ ቱረን። <verse eid="LUK 2:41"/><verse number="42" style="v" sid="LUK 2:42"/>ዮሙ ኡሙሪን ሙጫ ሰና ወጋ ኩዸ ለመ<note caller="+" style="f"><char style="fr" closed="false">2፥42 </char><char style="fq" closed="false">ወጋ ኩዸ ለመ </char><char style="ft" closed="false">– እጆሌን ዺራ ይሁዶታ ዮሙ ኡሙሪንሳኒ ወጋ ኩዸ ሰዲ ጉቱት እት ጋፈተመ ኦፊሳኒ ፉዸቱ። ተኡስ ዬሮ ሰናን ዱረ ኡቱ ገርጋርሰ ሃዻቲፊ አባ ህንበርባድን አጀጀወን ቶኮ ቶኮ ኤጉ ቀቡ። አጀጀወን ከኔን ኬሳስ ቶኮ ወጋ ወጋት ዬሩሳሌም ዸቀኒ ዋቄፈቹዸ።</char></note> ጉቴትስ አኩመ ስርነ አያንቻት ዬሩሳሌምት ኦል በአን። <verse eid="LUK 2:42"/><verse number="43" style="v" sid="LUK 2:43"/>ኤርገ አያንች ራወቴ ቦዴ ኡቱ አባፊ ሃትሳ ገረ መነሳኒት ዴብኣ ጅረኑ፣ ዬሱስ ሙጭች ዬሩሳሌምት እሳን ብራ ሀፌ፤ እሳን ገሩ ዋን ከነ ህንሁበትኔ። <verse eid="LUK 2:43"/><verse number="44" style="v" sid="LUK 2:44"/>እሳንስ ዋን እን ሚልቶሳኒ ወጅን ጅሩ ሴአኒ ጉያ ቶኮ ዴመን። ኤርገሲስ ፍሮተሳኒቲፊ ምቾተሳኒ ኬሰ እሰ በርባዱ ጀልቀበን። <verse eid="LUK 2:44"/><verse number="45" style="v" sid="LUK 2:45"/>ዮሙ እሰ ዸበንትስ፣ እሰ በርባዱፍ ዬሩሳሌምት ዴብአን። <verse eid="LUK 2:45"/><verse number="46" style="v" sid="LUK 2:46"/>ጉያ ሰዲ ቦዴ ኡቱ እን በርሲስቶተ ግዱ ታኤ እሳን ዸጌፈቱ፣ ጋፊስ እሳን ጋፈቱ መነ ቁልቁሉማ ኬሰት እሰ አርገተን። <verse eid="LUK 2:46"/><verse number="47" style="v" sid="LUK 2:47"/>ወር እሰ ዸገአን ሁንድኑስ ሁበትናሳቲፊ ዴቢ እን ኬኑ ንድንቅፈተን። <verse eid="LUK 2:47"/><verse number="48" style="v" sid="LUK 2:48"/>አባፊ ሃትሳስ ዮሙ እሰ አርገንት ንራጄፈተን። ሃትሳስ፣ “ጉርባ፣ ማሊፍ አከነ ኑ ጎቴ? ኩኖ፣ አኒፊ አባንኬ ያዶ ጉዳዻን ስበርባዳ ቱሬ!” ጄቴን።<verse eid="LUK 2:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 2:49"/>እንስ ዴብሴ፣ <char style="wj">“ማሊፍ ነ በርባደን? አከ አን መነ አባኮት አርገሙ ቀቡ ህንቤክኔሞ?”</char> እሳኒን ጄዼ። <verse eid="LUK 2:49"/><verse number="50" style="v" sid="LUK 2:50"/>እሳን ገሩ ዱቢ እን እሳንት ዱበቴ ህንሁበትኔ።<verse eid="LUK 2:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 2:51"/>እንስ እሳን ወጅን ናዝሬትት ገድ ቡኤ፤ እሳኒፍስ ንአጀጀመ ቱሬ። ሃትሳ ገሩ ዋን ከነ ሁንደ ገራት ቀበቴ። <verse eid="LUK 2:51"/><verse number="52" style="v" sid="LUK 2:52"/>ዬሱስስ ኦጉማዻን፣ ሆጃፊ ሱራዻን ፉለ ዋቃቲፊ ፉለ ነማ ዱረት ጉደቻ ዴሜ።<verse eid="LUK 2:52"/></para>
  <chapter eid="LUK 2"/>
  <chapter number="3" style="c" sid="LUK 3"/>
  <para style="s1">ለለበ ዮሀንስ ጩጳ</para>
  <para style="r">
    <ref loc="LUK 3:2-10">3፥2‑10</ref> ኩወፈ – <char style="xt"><ref loc="MAT 3:1-10">ማቴ 3፥1‑10</ref>፤ <ref loc="MRK 1:3-5">ማር 1፥3‑5</ref></char></para>
  <para style="r">
    <ref loc="LUK 3:16">3፥16</ref>፣<ref loc="LUK 3:17">17</ref> ኩወፈ – <char style="xt"><ref loc="MAT 3:11">ማቴ 3፥11</ref>፣<ref loc="MAT 3:12">12</ref>፤ <ref loc="MRK 1:7">ማር 1፥7</ref>፣<ref loc="MRK 1:8">8</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 3:1"/>ጥቤርዮስ ቄሳር ሞኤ ወጋ ኩዸ ሸነፋት ጄቹንስ ዮሙ ጶንጦስ ጲላጦስ ቡልቻ ይሁዳ ቱሬት፣ ሄሮድስ ቡልቻ ገሊላ ቱሬ፤ ኦቦሌስሳ ፊልጶስ ቡልቻ እጡርያሲፊ ጥራኮንዶስ፣ ልሳኒዮስሞ ቡልቻ አብሌኒስ ቱረን። <verse eid="LUK 3:1"/><verse number="2" style="v" sid="LUK 3:2"/>ዬሮ ሰነ ሃናፊ ቀያፋን ሉቦተ ኦል ኣንቶተ ቱረን። ዱቢን ዋቃ ገሞጂ ኬሰት ገረ ዮሀንስ እልመ ዘካርያስ ዹፌ። <verse eid="LUK 3:2"/><verse number="3" style="v" sid="LUK 3:3"/>እንስ ዺፈመ ጩቡቲፍ ጩጳ ቀልቢ ጅጂረትና ለለባ ብየ ናኖ ዮርዳኖስ ሁንደ ኬሰ ዴሜ። <verse eid="LUK 3:3"/><verse number="4" style="v" sid="LUK 3:4"/>ኩንስ እሰ ክታበ ዱቢ እሳያስ ራጅቻ ኬሰት አከነ ጄዸሜ በሬፈሜዸ፦</para>
  <para style="q1" vid="LUK 3:4">“ሰገሌ ነመ ገሞጂ ኬሳ እዩ ቶኮ፦</para>
  <para style="q1" vid="LUK 3:4">‘ከራ ጎፍታ ቆጴሳ፤</para>
  <para style="q2" vid="LUK 3:4">ዳንዲሳስ ቀጄልቻ።<verse eid="LUK 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LUK 3:5"/>ሱሉል ሁንድ ንጉተመ፤</para>
  <para style="q2" vid="LUK 3:5">ቱሉፊ ጋር ሁንድኑስ ገድ ዴብፈሙ።</para>
  <para style="q1" vid="LUK 3:5">ከራን ጀልኣን ንቀጄለ፤</para>
  <para style="q2" vid="LUK 3:5">ዳንዲን ቡኣ በኢንስ ወል ቅጤፈመ።<verse eid="LUK 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LUK 3:6"/>ሰኚን ነማ ሁንድኑስ ፈይሱ ዋቃ ንአርገ።’ ”<note caller="+" style="f"><char style="fr" closed="false">3፥6 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 40:3-5">እሳ 40፥3‑5</ref></char></char></note><verse eid="LUK 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 3:7"/>ዮሀንስስ ወረ ሀርከሳት ጩጰሙፍ ዹፈኒን አከነ ጄዼ፤ “እስን እጆሌ ቡቲነነ! ዼከምሰ ዹፉ ጀላ አከ በቀተኒፍ ኤኙቱ እስንት ህሜ? <verse eid="LUK 3:7"/><verse number="8" style="v" sid="LUK 3:8"/>ኤጋ እጀ ቀልቢ ጅጂረትና ምርከኔሱ ነቀዻ። እስን፣ ‘አባንኬኘ አብረሃሚዸ’ ኦፊን ጄቹ ህንጀልቀብና። ዋቅን ዸጎተ ከኔንራ አብረሃሚፍ እጆሌ ካሱ አከ ደንደኡ አን እስንት ነንህማቲ። <verse eid="LUK 3:8"/><verse number="9" style="v" sid="LUK 3:9"/>ቆቶን አመዩ ህደ ሙኬኒረ ካአሜረ፤ ሙክት እጀ ጋሪ ህንነቀትኔ ሁንድኑስ ሙረሜ እብደት ደርበተመ።”<verse eid="LUK 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 3:10"/>ነሞትን ሱንስ፣ “ዮስ ማል ሃጎኑሬ?” ጄዸኒ እሰ ጋፈተን።<verse eid="LUK 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 3:11"/>ዮሀንስስ ዴብሴ፣ “ነምን ኡፈተ ለመ ቀቡ እሰ ሆማ ህንቀብኔፍ ሃቆዱ፤ ከን ኛተ ቀቡስ አከሱመ ሃጎዹ” ጄዼን።<verse eid="LUK 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 3:12"/>ቀረጦትን ጩጰሙ ዹፈኒ፣ “ያ በርሲሳ፣ ኑ ሆ ማል ሃጎኑ?” ጄዸኒ እሰ ጋፈተን።<verse eid="LUK 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 3:13"/>እንስ፣ “ዋን አጀጀምተን ጫላ ወልት ህንቀብና” ጄዼን።<verse eid="LUK 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 3:14"/>ሎልቶትንስ አከሱመ፣ “ኑሞ ማል ሃጎኑሬ?” ጄዸኒ እሰ ጋፈተን።</para>
  <para style="p" vid="LUK 3:14">እንስ፣ “ሁምናን ነመራ ማለቀ ህንፉዸትና፤ ሶባን ነመ ህንህመትና፤ ምንዳንኬሰን እስን ሃገኡ” ጄዼን።<verse eid="LUK 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 3:15"/>ነሞትን ሱን ሀዊዻን ኤጋ ቱረን፤ ሁንድሳኒስ፣ “ዮሀንስ ኩን እን ክርስቶስ ተእና ላተ?” ጄዸኒ ገራሳኒት ያዳ ቱረን። <verse eid="LUK 3:15"/><verse number="16" style="v" sid="LUK 3:16"/>ዮሀንስ አከነ ጄዼ እሳን ሁንዳፍ ዴቢ ኬኔ፤ “አን ብሻኒን እስን ጩጰ። ገሩ ከን ነ ጫላ ጀባ ተኤ ቶኮ ንዹፈ፤ አን ህዻ ኮጴሳሌ ሂኩን ናፍ ህንመሉ። እን ሀፉረ ቁልቁሉፊ እብዳን እስን ጩጰ። <verse eid="LUK 3:16"/><verse number="17" style="v" sid="LUK 3:17"/>እንስ ኦብዲሳ ቁልቁሌሴ ጎምብሳሳት ቀመዲ ገልፈቹዻፍ አፈርሳንሳ ሀርከሳ ጅረ፤ ሀበቂ ገሩ እብደ ህንዻምኔን ጉበ።” <verse eid="LUK 3:17"/><verse number="18" style="v" sid="LUK 3:18"/>ዮሀንስስ ዱቢ ብራ ባይኤዻን ነሞተ ጎርሴ ወንጌለስ እሳንት ለለቤ።<verse eid="LUK 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 3:19"/>ሄሮድስ ቡልቻን ገሩ ዮሙ ሰበቢ እን ኒቲ ኦቦሌሰሳ ሄሮድያዳ ፉዼፊ ሰበቢ ሀምነ እን ሆጄቴ ቱሬ ካን ሁንዳቲፍ ዮሀንስ እሰ እፈቴ፣ <verse eid="LUK 3:19"/><verse number="20" style="v" sid="LUK 3:20"/>ሀምነሳ ሁንደረት ደበሌ ዮሀንስን መነ ህዻት ገልቼ እት ጩፌ።<verse eid="LUK 3:20"/></para>
  <para style="s1">ጩጰሙ ዬሱስ</para>
  <para style="r">
    <ref loc="LUK 3:21">3፥21</ref>፣<ref loc="LUK 3:22">22</ref> ኩወፈ – <char style="xt"><ref loc="MAT 3:13-17">ማቴ 3፥13‑17</ref>፤ <ref loc="MRK 1:9-11">ማር 1፥9‑11</ref></char></para>
  <para style="r">
    <ref loc="LUK 3:23-38">3፥23‑38</ref> ኩወፈ – <char style="xt"><ref loc="MAT 1:1-17">ማቴ 1፥1‑17</ref></char></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 3:21"/>ዬሮ ነሞትን ሁንድኑ ጩጰማ ቱረንት፣ ዬሱስስ ንጩጰሜ። ኡቱ እን ከዸቻ ጅሩ ሰሚን በነሜ፣ <verse eid="LUK 3:21"/><verse number="22" style="v" sid="LUK 3:22"/>ሀፉር ቁልቁሉን ብፈ ጉጌቲን ሙልአቴ እሰረት ገድ ቡኤ። ሰገሌን፣ “አት እልመኮ እሰ አን ጃለዹዸ፤ አን ስት ነንገመደ” ጄዹ ቶኮስ ሰሚራ ንዹፌ።<verse eid="LUK 3:22"/></para>
  <para style="s1">ህደ ዸሎተሳ</para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 3:23"/>ዬሱስ ዬሮ ተጃጅለሳ ጀልቀቤት ኡሙሪንሳ ገረ ወጋ ሶዶማ ቱሬ። እንስ አከ ዋን እልመ ዮሴፍ ቱሬት ያደማ ቱሬ፦</para>
  <para style="b" vid="LUK 3:23"/>
  <para style="li1" vid="LUK 3:23">እልመ ኤሊ፣ <verse eid="LUK 3:23"/><verse number="24" style="v" sid="LUK 3:24"/>እልመ ማታት፣</para>
  <para style="li1" vid="LUK 3:24">እልመ ሌዊ፣ እልመ ሚልኪ፣</para>
  <para style="li1" vid="LUK 3:24">እልመ ያና፣ እልመ ዮሴፍ፣<verse eid="LUK 3:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="LUK 3:25"/>እልመ ማታትዩ፣ እልመ አሞስ፣</para>
  <para style="li1" vid="LUK 3:25">እልመ ናሆም፣ እልመ አሲሊም፣</para>
  <para style="li1" vid="LUK 3:25">እልመ ናጌ፣ <verse eid="LUK 3:25"/><verse number="26" style="v" sid="LUK 3:26"/>እልመ ማኣት፣</para>
  <para style="li1" vid="LUK 3:26">እልመ ማታትዩ፣ እልመ ሴሜይ፣</para>
  <para style="li1" vid="LUK 3:26">እልመ ዮሴፍ፣ እልመ ዮዳ፣<verse eid="LUK 3:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="LUK 3:27"/>እልመ ዮናን፣ እልመ ሬስ፣</para>
  <para style="li1" vid="LUK 3:27">እልመ ዘሩባቤል፣ እልመ ሰላትያል፣</para>
  <para style="li1" vid="LUK 3:27">እልመ ኔር፣ <verse eid="LUK 3:27"/><verse number="28" style="v" sid="LUK 3:28"/>እልመ ሚልኪ፣</para>
  <para style="li1" vid="LUK 3:28">እልመ ሀዲ፣ እልመ ቆሳም፣</para>
  <para style="li1" vid="LUK 3:28">እልመ ኤልሞዳም፣ እልመ ኤር፣<verse eid="LUK 3:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="LUK 3:29"/>እልመ ዮሴእ፣ እልመ ኤሊኤዜር፣</para>
  <para style="li1" vid="LUK 3:29">እልመ ዮርም፣ እልመ ማጣት፣</para>
  <para style="li1" vid="LUK 3:29">እልመ ሌዊ፣ <verse eid="LUK 3:29"/><verse number="30" style="v" sid="LUK 3:30"/>እልመ ስምኦን፣</para>
  <para style="li1" vid="LUK 3:30">እልመ ይሁዳ፣ እልመ ዮሴፍ፣</para>
  <para style="li1" vid="LUK 3:30">እልመ ዮናን፣ እልመ ኤልያቄም፣<verse eid="LUK 3:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="LUK 3:31"/>እልመ ሜልያ፣ እልመ ማይናን፣</para>
  <para style="li1" vid="LUK 3:31">እልመ ማጣት፣ እልመ ናታን፣</para>
  <para style="li1" vid="LUK 3:31">እልመ ዳዊት፣ <verse eid="LUK 3:31"/><verse number="32" style="v" sid="LUK 3:32"/>እልመ እሴይ፣</para>
  <para style="li1" vid="LUK 3:32">እልመ ዮቤድ፣ እልመ ቦኤዝ፣</para>
  <para style="li1" vid="LUK 3:32">እልመ ሰልሞን፣ እልመ ነአሶን፣<verse eid="LUK 3:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="LUK 3:33"/>እልመ አሚናዳብ፣ እልመ ኣራም፣</para>
  <para style="li1" vid="LUK 3:33">እልመ ሄዝሮን፣</para>
  <para style="li1" vid="LUK 3:33">እልመ ፋሬስ፣ እልመ ይሁዳ፣ <verse eid="LUK 3:33"/><verse number="34" style="v" sid="LUK 3:34"/>እልመ ያቆብ፣</para>
  <para style="li1" vid="LUK 3:34">እልመ ይስሃቅ፣ እልመ አብረሃም፣</para>
  <para style="li1" vid="LUK 3:34">እልመ ታራ፣ እልመ ናሆር፣<verse eid="LUK 3:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="LUK 3:35"/>እልመ ሴሮህ፣ እልመ ራጋው፣</para>
  <para style="li1" vid="LUK 3:35">እልመ ፌሌግ፣ እልመ ኤቤር፣</para>
  <para style="li1" vid="LUK 3:35">እልመ ሳላ፣ <verse eid="LUK 3:35"/><verse number="36" style="v" sid="LUK 3:36"/>እልመ ቃይነም</para>
  <para style="li1" vid="LUK 3:36">እልመ አርፋክስኣድ፣ እልመ ሴም፣</para>
  <para style="li1" vid="LUK 3:36">እልመ ኖህ፣ እልመ ላሜህ፣<verse eid="LUK 3:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="LUK 3:37"/>እልመ ማቱሳላ፣ እልመ ሄኖክ፣</para>
  <para style="li1" vid="LUK 3:37">እልመ ያሬድ፣ እልመ መሀለሌል፣</para>
  <para style="li1" vid="LUK 3:37">እልመ ቃይናን፣ <verse eid="LUK 3:37"/><verse number="38" style="v" sid="LUK 3:38"/>እልመ ሄኖስ፣</para>
  <para style="li1" vid="LUK 3:38">እልመ ሴት፣ እልመ አዳም፣</para>
  <para style="li1" vid="LUK 3:38">እልመ ዋቃ።<verse eid="LUK 3:38"/></para>
  <chapter eid="LUK 3"/>
  <chapter number="4" style="c" sid="LUK 4"/>
  <para style="s1">ዬሱስ ቆረሙሳ</para>
  <para style="r">
    <ref loc="LUK 4:1-13">4፥1‑13</ref> ኩወፈ – <char style="xt"><ref loc="MAT 4:1-11">ማቴ 4፥1‑11</ref>፤ <ref loc="MRK 1:12">ማር 1፥12</ref>፣<ref loc="MRK 1:13">13</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 4:1"/>ዬሱስ ሀፉረ ቁልቁሉዻን ጉተሜ ዮርዳኖሲ ከኤ ሀፉሩመ ሰናን ገሞጂት ጌፈሜ፤ <verse eid="LUK 4:1"/><verse number="2" style="v" sid="LUK 4:2"/>አችትስ ጉያ አፉርተመ ዲያብሎሲን ቆረሜ። እንስ ጉዮተ ሰነ ኬሰ ሆማ ህንኛትኔ፤ ዹመረትስ ንቤለኤ።<verse eid="LUK 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 4:3"/>ዲያብሎስስ፣ “አት ዮ እልመ ዋቃ ታቴ፣ አከ ዸጋን ኩን ቡዴነ ተኡ አጀጅ” ጄዼን።<verse eid="LUK 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 4:4"/>ዬሱስሞ ዴብሴ፣ <char style="wj">“ ‘ነምን ቡዴነ ቆፋን ህንጅራቱ’</char><note caller="+" style="f"><char style="fr" closed="false">4፥4 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 8:3">ኬዴ 8፥3</ref></char></char></note> <char style="wj">ጄዸሜ በሬፈሜረ”</char> ጄዼን።<verse eid="LUK 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 4:5"/>ዲያብሎስስ ጋረ ዼራ ቶኮት ኦል እሰ ባሴ ሀመ ልጵሱ እጃት ሞቱሞተ አዱኛ ሁንደ እሰት አርግሲሴ። <verse eid="LUK 4:5"/><verse number="6" style="v" sid="LUK 4:6"/>አከነስ ጄዼን፤ “አን ታይታሳኒቲፊ ኡልፍነሳኒ ሁንዱማ ሲፍን ኬነ፤ ታይታፊ ኡልፍን ኩን ዋን ናፍ ኬነሜፍ አን አባን ኬኑፊ በርባዴፍ ኬኑ ነንደንደአ። <verse eid="LUK 4:6"/><verse number="7" style="v" sid="LUK 4:7"/>ዮ አት ናፍ ሰገዴ፣ ወን ኩን ሁንድኑ ከንኬ ተአ።”<verse eid="LUK 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 4:8"/>ዬሱስሞ፣ <char style="wj">“ ‘ዋቀኬ ጎፍትቻፍ ሰገድ፣ እሱመ ቆፈ ተጃጅል’</char><note caller="+" style="f"><char style="fr" closed="false">4፥8 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 6:13">ኬዴ 6፥13</ref></char></char></note> <char style="wj">ጄዸሜ በሬፈሜረ”</char> ጄዼ ዴብሴፍ።<verse eid="LUK 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 4:9"/>ዲያብሎስስ ዬሩሳሌምት እሰ ጌሴ፣ ፊጤ መነ ቁልቁሉማረ ዻበቺሴ። አከነስ ጄዼን፤ “አት ዮ እልመ ዋቃ ታቴ፣ አሲ ገድ ኦፍ ደርበዹ። <verse eid="LUK 4:9"/><verse number="10" style="v" sid="LUK 4:10"/>አከነ ጄዸሜ በሬፈሜራቲ፦</para>
  <para style="q1" vid="LUK 4:10">“ ‘እን አከ እሳን ስሪት ስኤገኒፍ፣</para>
  <para style="q2" vid="LUK 4:10">ኤርገሞተሳ ሲፍ ንአጀጀ፤<verse eid="LUK 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LUK 4:11"/>እሳንስ አከ አት ሚለኬቲን ዸጋት ህንቡኔፍ፣</para>
  <para style="q2" vid="LUK 4:11">ሀርከሳኒቲን ኦል ስ ፉዹ።’<note caller="+" style="f"><char style="fr" closed="false">4፥11 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 91:1">ፋር 91፥1</ref>፣<ref loc="PSA 91:12">12</ref></char></char></note>”<verse eid="LUK 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 4:12"/>ዬሱስሞ ዴብሴ፣ <char style="wj">“ ‘ዋቀኬ ጎፍትቸ ህንቆርን’</char><note caller="+" style="f"><char style="fr" closed="false">4፥12 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 6:16">ኬዴ 6፥16</ref></char></char></note> <char style="wj">ጄዸሜረ”</char> ጄዼን።<verse eid="LUK 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 4:13"/>ዲያብሎስሞ ኤርገ ቆሩምሰ ከነ ሁንደ ራወቴ ቦዴ ሀመ ዬሮ ምጃኣ አርገቱት እሰ ዺሴ ዴሜ።<verse eid="LUK 4:13"/></para>
  <para style="s1">ዬሱስ ናዝሬትት ፉዸተመ ዸቤ</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 4:14"/>ዬሱስ ሁምነ ሀፉራቲን ገሊላት ዴብኤ፤ ኦዱን ዋኤሳስ ባድያ ጉቱ ኬሰ ፈፈጨኤ። <verse eid="LUK 4:14"/><verse number="15" style="v" sid="LUK 4:15"/>እን መኔን ሰገዳሳኒ ኬሰት በርሲሳ ቱሬ፤ ነምን ሁንድኑስ እሰ ጀጄ።<verse eid="LUK 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 4:16"/>እንስ ናዝሬት እዶ እት ጉደቴ ዸቄ፤ ጉያ ሰንበታስ አኩመ አመለሳ መነ ሰገዳ ሴኔ። ክታበ ዱብሱፍስ ከኤ ዻበቴ፤ <verse eid="LUK 4:16"/><verse number="17" style="v" sid="LUK 4:17"/>ክታብን ራጅቸ እሳያስ እሰት ኬነሜ። እንስ ክታብቸ በኔ ኩታ አከነ ጄዸሜ በሬፈሜ አርገቴ፦<verse eid="LUK 4:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LUK 4:18"/>
    <char style="wj">“ሀፉር ጎፍታ ነረ ጅረ፤</char></para>
  <para style="q2" vid="LUK 4:18">
    <char style="wj">አከ አን ህዬዪት ኦዱ ጋሪ ለለቡፍ፣ <optbreak/> እን ነ ድቤራቲ።</char></para>
  <para style="q1" vid="LUK 4:18">
    <char style="wj">እን አከ አን አከ ወር ህዸመን ሂከመን፣</char></para>
  <para style="q2" vid="LUK 4:18">
    <char style="wj">አከ ወር ጃመን አርገን፣</char></para>
  <para style="q1" vid="LUK 4:18">
    <char style="wj">አከ ወር ጩንቁርፈመንስ ብልሰ በአን ለለቡፍ ነ ኤርጌረ፤</char><verse eid="LUK 4:18"/></para>
  <para style="q2">
    <verse number="19" style="v" sid="LUK 4:19"/>
    <char style="wj">እን አከ አን በረ ቶለ ጎፍታ ለብሱፍስ ነ ኤርጌረ።”</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">4፥19 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="ISA 61:1">እሳ 61፥1</ref>፣<ref loc="ISA 61:2">2</ref></char>
      </char>
    </note><verse eid="LUK 4:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 4:20"/>እንስ ክታብቸ ጩፌ ተጃጅልትቸት ዴብሴ ኬኔ ታኤ፤ ወር መነ ሰገዳ ሰነ ኬሰ ቱረን ሁንድኑስ ጥዬፈተኒ እሰ እላላ ቱረን። <verse eid="LUK 4:20"/><verse number="21" style="v" sid="LUK 4:21"/>እንስ፣ <char style="wj">“በሬፈምን ኩን ሀርአ ጉረኬሰንት ራወተሜ”</char> እሳኒን ጄቹ ጀልቀቤ።<verse eid="LUK 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 4:22"/>ሁንድሳኒ ዋኤሳ ዋን ጋሪ ዱበቻ ቱረን፤ ዱቢ አያነ ቀቤሰ አፋንሳቲ በኡስ ንድንቅሲፈተን። እሳንስ፣ “ኩን እልመ ዮሴፍ ምቲ?” ጄዸኒ ጋፈተን።<verse eid="LUK 4:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 4:23"/>ዬሱስስ፣ <char style="wj">“አከ እስን፣ ‘ያ አባ ቆርቻ፣ ኦፍ ፈይስ! ዋን ቅፍርናሆምት ሆጄቹኬ ዸጌኜ ሰነ አስ ብየኬትስ ሆጄዹ’ ጄተኒ ነት መማክተን አን ሸኪ ህንቀቡ”</char> እሳኒን ጄዼ።<verse eid="LUK 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 4:24"/>እንስ እት ፉፌ አከነ ጄዼ፤ <char style="wj">“አን ዹጉመ እስንት ነንህመ፤ ራጂን ቶኮዩ እዶ እት ዸለቴት ፉዸተመ ህንቀቡ።</char> <verse eid="LUK 4:24"/><verse number="25" style="v" sid="LUK 4:25"/><char style="wj">አን ዹጉመን እስኒን ጄዸ፤ በረ ኤልያስ ዬሮ ሰሚን ወጋ ሰዲፊ ወለካ ጩፈሜ ቤል ሀማን ቡኤት ሃዾተ ህዬሳ ባይኤቱ እስራኤል ኬሰ ቱሬ።</char> <verse eid="LUK 4:25"/><verse number="26" style="v" sid="LUK 4:26"/><char style="wj">ተኡስ ኤልያስ ገረ ሃዸ ህዬሳ ከን መጋላ ሰሬፕታ ብየ ሲዶን ኬሰ ጅራቱ ቶኮት ኤርገሜ መሌ ዱበርቶተ ሰነ ኬሳ ገረ ቶኮሳኒትሌ ህንኤርገምኔ።</char> <verse eid="LUK 4:26"/><verse number="27" style="v" sid="LUK 4:27"/><char style="wj">በረ ኤልሳእ ራጅቻስ ነሞተ ለምጣአን ሄዱቱ እስራኤል ኬሰ ቱሬ፤ ገሩ ነአማን፣ ነምቸ ሶርያ ቶክቸ ሰነ መሌ ወረ ካን ኬሳ ነምን ቶኮዩ ህንቁልቁሎፍኔ ቱሬ።”</char><verse eid="LUK 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 4:28"/>ነሞትን መንቸ ሰገዳ ኬሰ ቱረን ሁንድኑ ዮሙ ዋን ከነ ዸገአንት አከ መሌ ኣረን። <verse eid="LUK 4:28"/><verse number="29" style="v" sid="LUK 4:29"/>እሳንስ ከአኒ መጋላ ሰነ ኬሳ ገድ እሰ ባሰን፤ ገድ እሰ ደርበቹፍ ጄዸኒስ ኤዴደ ቱሉ መጋላንሳኒረት እጃረምቴት ኦል እሰ ባሰን። <verse eid="LUK 4:29"/><verse number="30" style="v" sid="LUK 4:30"/>እን ገሩ ግዱዹመሳኒ በኤ ዴሜ።<verse eid="LUK 4:30"/></para>
  <para style="s1">ዬሱስ ሀፉረ ጡራኣ ባሱሳ</para>
  <para style="r">
    <ref loc="LUK 4:31-37">4፥31‑37</ref> ኩወፈ – <char style="xt"><ref loc="MRK 1:21-28">ማር 1፥21‑28</ref></char></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 4:31"/>እንስ ገረ ቅፍርናሆም፣ መጋላ ገሊላ ኬሳት ገድ ቡኤ፤ ጉያ ሰንበታስ ነሞተ በርሲሴ። <verse eid="LUK 4:31"/><verse number="32" style="v" sid="LUK 4:32"/>እሳንስ ዋን ዱቢንሳ ታይታ ቀቡፍ በርሲሰሳ ንድንቅሲፈተን።<verse eid="LUK 4:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 4:33"/>ነምች ሀፉረ ሀማ ጡራኣዻን ቀበሜ ቶኮ መነ ሰገዳ ኬሰ ቱሬ። እንስ ሰገሌ ጉዳዻን እዬ አከነ ጄዼ፤ <verse eid="LUK 4:33"/><verse number="34" style="v" sid="LUK 4:34"/>“ኡፍ! ያ ዬሱስ ነመ ናዝሬት፣ አት ማል ኑራ ቀብደ? ኑ በሌሱ ዹፍቴሞ? አት ኤኙ አከ ታቴ አን ነንቤከ፣ ያ ቁልቁልቸ ዋቃ!”<verse eid="LUK 4:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 4:35"/>ዬሱስሞ፣ <char style="wj">“ጨልእሲ እሰ ኬሳ በእ!”</char> ጄዼ እፈቴ። ሀፉር ሀማን ሱንስ እሳን ሁንደ ዱረት ነምቸ ኩፍሴ ኡቱ ህንሚዽን እሰ ኬሳ በኤ።<verse eid="LUK 4:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 4:36"/>ነሞትን ሁንድኑ ድንቅፈተኒ፣ “ማል በርሲስን አከና! እን ታይታዻን፣ ሁምናንስ ሀፉሮተ ጡራኦ ንአጀጀ፤ እሳንስ ንበኡ” ወሊን ጄዸን። <verse eid="LUK 4:36"/><verse number="37" style="v" sid="LUK 4:37"/>ኦዱን ዋኤሳስ ብየ ናኖ ሰና ጉቱ ኬሰ ፈፈጨኤ።<verse eid="LUK 4:37"/></para>
  <para style="s1">ዬሱስ ነመ ባይኤ ፈይሴ</para>
  <para style="r">
    <ref loc="LUK 4:38-41">4፥38‑41</ref> ኩወፈ – <char style="xt"><ref loc="MAT 8:14-17">ማቴ 8፥14‑17</ref></char></para>
  <para style="r">
    <ref loc="LUK 4:38-43">4፥38‑43</ref> ኩወፈ – <char style="xt"><ref loc="MRK 1:29-38">ማር 1፥29‑38</ref></char></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 4:38"/>ዬሱስ መነ ሰገዳቲ በኤ መነ ስሞን ዸቄ። ሃት ኒቲ ስሞንስ ዹኩበ ዸግነ ጉባ ሀማዻን ቀበምቴ ዽጰቻ ቱርቴ፤ እሳንስ አከ ዬሱስ እሼ ገርጋሩ እሰ ከዸተን። <verse eid="LUK 4:38"/><verse number="39" style="v" sid="LUK 4:39"/>እንስ እሼት ገድ ጄዼ፣ ዸግነ ጉባ ሰነ እፈቴ፤ ዸግነ ጉባን ሱንስ እሼ ዺሴ። እሼንስ ዬሩመ ሰነ ካቴ እሳን ተጃጅሉ ጀልቀብዴ።<verse eid="LUK 4:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 4:40"/>ነሞትንስ ዬሮ አዱን ልጤት ነሞተ ዹኩበ ጎሰ ገራ ገራ ቀበን ሁንደ ገረ ዬሱስ ፍደን፤ እንስ ቶኮ ቶኮሳኒረ ሀርከሳ ካኤ እሳን ፈይሴ። <verse eid="LUK 4:40"/><verse number="41" style="v" sid="LUK 4:41"/>አከሱመስ ሀፉሮትን ሀሞን እየኒ፣ “አት እልመ ዋቃት!” ጄዸኒ ነሞተ ባይኤ ኬሳ በአን። እን ገሩ ሰበቢ እሳን አከ እን ክርስቶስ<note caller="+" style="f"><char style="fr" closed="false">4፥41 </char><char style="ft" closed="false">ዮካን </char><char style="fqa" closed="false">መሲሂ</char></note> ተኤ ቤከኒፍ እሳን እፈቴ፤ አከ እሳን ዱበተንስ ህንኤየምኔፍ።<verse eid="LUK 4:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 4:42"/>ዮሙ በሪቴትስ ዬሱስ አቺ በኤ፣ እዶ ነምን ህንጅሬ ቶኮ ዸቄ። ነሞትንስ እሰ በርባዳ ቱረን፤ ዮሙ ገረሳ ዹፈንትስ አከ እን እሳን ዺሴ ህንዴምኔፍ እሰ ዾዉ ያለን። <verse eid="LUK 4:42"/><verse number="43" style="v" sid="LUK 4:43"/>እን ገሩ፣ <char style="wj">“አን መጋላወን ካንትስ ወንጌለ ሞቱማ ዋቃ ለለቡን ቀበ፤ ሰበቢን አን ኤርገሜፍስ ከኑመ”</char> ጄዼ። <verse eid="LUK 4:43"/><verse number="44" style="v" sid="LUK 4:44"/>እንስ እቱመ ፉፌ መኔን ሰገዳ ይሁዳ ኬሰት ለለባ ቱሬ።<verse eid="LUK 4:44"/></para>
  <chapter eid="LUK 4"/>
  <chapter number="5" style="c" sid="LUK 5"/>
  <para style="s1">ዋመሙ በረቶተ ጀልቀባ</para>
  <para style="r">
    <ref loc="LUK 5:1-11">5፥1‑11</ref> ኩወፈ – <char style="xt"><ref loc="MAT 4:18-22">ማቴ 4፥18‑22</ref>፤ <ref loc="MRK 1:16-20">ማር 1፥16‑20</ref>፤ <ref loc="JHN 1:40-42">ዮሀ 1፥40‑42</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 5:1"/>ጋፍ ቶኮ ዬሱስ ኡቱ ሀሮ ጌንሴሬጥ ብረ ዻበቴ ጅሩ፣ ኡቱ ነሞትንስ እሰት ናነአኒ ዱቢ ዋቃ ዸገኣ ጅረኑ፣ <verse eid="LUK 5:1"/><verse number="2" style="v" sid="LUK 5:2"/>ብድሩወን ለመ ኤዴደ ብሻንቻረት አርጌ፤ ቁርጡሚ ቀብዶትን ገሩ ኬሳ በአኒ ክዮሳኒ ሚጨቻ ቱረን። <verse eid="LUK 5:2"/><verse number="3" style="v" sid="LUK 5:3"/>እንስ ብድሩወን ሰነ ግዱዻ እሼ ከን ስሞን ታቴ ቶኮ ያበቴ፤ አከ እን ቀርቀረ ለፋራ ገረ ግዱ ብሻኒት ጥኖ አች ቡቱስ እሰ ከዸቴ። ዬሱስስ ብድሩ ሰነረ ታኤ ነሞተ በርሲሱ ጀልቀቤ።<verse eid="LUK 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 5:4"/>እንስ ዮሙ ዱበቴ ፍጤት ስምኦኒን፣ <char style="wj">“ገረ ቱጁበ ብሻኒት አች ስቅ፤ ቁርጡሚ ቀቡፍስ ክዮኬሰን ደርበዻ”</char> ጄዼ።<verse eid="LUK 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 5:5"/>ስሞንስ ዴብሴ፣ “ያ በርሲሳ፣ ኑ ሀልከን ጉቱ አከ መሌ እት ደዸብኔ ዋ ቶኮሌ ህንቀብኔ። አን ገሩ ዋን አት ጄቴፍ ክዮ ነንደርበዸ” ጄዼ።<verse eid="LUK 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 5:6"/>እሳንስ ክዮሳኒ ደርበተኒ ሀመ ክዮንሳኒ ጭጭቱ ጀልቀቡት ቁርጡሚ አከ መሌ ባይኤ ቀበተን። <verse eid="LUK 5:6"/><verse number="7" style="v" sid="LUK 5:7"/>ከናፉ አከ ምቾትንሳኒ ወር ብድሩ ካን ኬሰ ቱረን ዹፈኒ እሳን ገርጋረኒፍ መለቶን ዋመተን፤ እሳንስ ዹፈኒ ብድሩ ለቹ ቁርጡሚዻን ጉተን፤ ብድሩወን ሱንስ ልቅምፈሙ ጀልቀበን።<verse eid="LUK 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 5:8"/>ስሞን ጴጥሮስስ ዮሙ ዋን ከነ አርጌት ጅልበ ዬሱስት ኩፌ፣ “ያ ጎፍታ፣ አን ነመ ጩበማዸ፤ ነራ ፈጋዹ!” ጄዼ። <verse eid="LUK 5:8"/><verse number="9" style="v" sid="LUK 5:9"/>ኩንስ ሰበቢ ቁርጡሚን ባይኤን ቀበሜ ሱን ስምኦኒፊ ወረ እሰ ወጅን ቱረን ሁንደ ድንቅሲሴፍ፤ <verse eid="LUK 5:9"/><verse number="10" style="v" sid="LUK 5:10"/>እልማን ዘብዴዎስ ወር ምቾተ ስሞን ቱረን ጄቹንስ ያቆቢፊ ዮሀንስ አከሱመ ድንቅሲፈተን።</para>
  <para style="p" vid="LUK 5:10">ዬሱስስ ስምኦኒን፣ <char style="wj">“ህንሶዳትን፤ አት አማ ጀልቀብዴ ቀብዱ ነሞታ ንታታ”</char> ጄዼ። <verse eid="LUK 5:10"/><verse number="11" style="v" sid="LUK 5:11"/>እሳንስ ብድሩወንሳኒ ገረ ቀርቀራት ኦል ባሰኒ ዋን ሁንደ ዺሰኒ እሰ ዱካ ቡአን።<verse eid="LUK 5:11"/></para>
  <para style="s1">ነምቸ ለምጣኣ ቶኮ</para>
  <para style="r">
    <ref loc="LUK 5:12-14">5፥12‑14</ref> ኩወፈ – <char style="xt"><ref loc="MAT 8:2-4">ማቴ 8፥2‑4</ref>፤ <ref loc="MRK 1:40-44">ማር 1፥40‑44</ref></char></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 5:12"/>ኡቱ ዬሱስ መጋላወን ሰነ ኬሳ እሰ ቶኮ ኬሰ ጅሩ ነምች ዸግንሳ ጉቱን ለምጣኤ ቶኮ ገረሳ ዹፌ። እንስ ዮሙ ዬሱስን አርጌት አደሳቲን ለፈት ጎምብፈሜ፣ “ያ ጎፍታ፣ ዮ ፌዺኬ ተኤ፣ አት ነ ቁልቁሌሱ ንደንዴሰ” ጄዼ እሰ ከዸቴ።<verse eid="LUK 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 5:13"/>ዬሱስስ ሀርከሳ ሂጠቴ ነምቸ ቀቀቤ፣ <char style="wj">“ፌዺኮት፤ ቁልቁላእ!”</char> ጄዼን፤ ለምጢን ሱንስ ዬሩመ ሰነ ነምቸራ በዴ።<verse eid="LUK 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 5:14"/>ዬሱስስ፣ <char style="wj">“ነመ ቶኮትሌ ህንህምን፤ ገሩ ዸቂቲ አከ እሳኒፍ ረጋ ተኡፍ ሉበት ኦፍ አርግሲስ፤ ቁልቁላኡኬቲፍስ ኣርሳወን ሙሴን አጀጄ ሰነ ዽኤስ”</char> ጄዼ እሰ አጀጄ።<verse eid="LUK 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 5:15"/>ሃተኡ መሌ ኦዱን ዋኤሳ እቱመ ጫሌ ፈጨኤ፤ ነሞትን ሄዱንስ እሰ ዸገኡፊ ዹኩበሳኒራ ፈዩፍ ጄዸኒ ገረሳ ዹፋ ቱረን። <verse eid="LUK 5:15"/><verse number="16" style="v" sid="LUK 5:16"/>ዬሱስ ገሩ ዬሮ ባይኤ ለፈ ነምን ህንጅሬ ዸቄ ከዸቻ ቱሬ።<verse eid="LUK 5:16"/></para>
  <para style="s1">ዬሱስ ነመ ላምሸኣ ቶኮ ፈይሱሳ</para>
  <para style="r">
    <ref loc="LUK 5:18-26">5፥18‑26</ref> ኩወፈ – <char style="xt"><ref loc="MAT 9:2-8">ማቴ 9፥2‑8</ref>፤ <ref loc="MRK 2:3-12">ማር 2፥3‑12</ref></char></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 5:17"/>ጋፍ ቶኮ ዬሱስ ኡቱ በርሲሳ ጅሩ፣ ፈሪሶትኒፊ በርሲስቶትን ሴራ ወር ገንዶተ ገሊላቲፊ ይሁዳ ሁንደ ኬሳ አከሱመስ ዬሩሳሌሚ ዹፈን አች ተታኣ ቱረን። አከ እን ዹኩብሰቶተ ፈይሱፍስ ሁምን ጎፍታ እሰ ወጅን ቱሬ። <verse eid="LUK 5:17"/><verse number="18" style="v" sid="LUK 5:18"/>ጀር ቶኮ ነመ ዸግን እረት ዱኤ ቶኮ ስሬዻን ባተኒ ዹፈን፤ እሳንስ ፉለ ዬሱስ ዱረ ካኡፍ ጄዸኒ መነት ኦል እሰ ገልቹ ያለን። <verse eid="LUK 5:18"/><verse number="19" style="v" sid="LUK 5:19"/>ሰበቢ ባይእነ ነማቲፍስ ከራ እቲን ኦል እሰ ገልቸን ዸብናን በንቲ መናት ኦል በአኒ ቀዳደ በንቲ መና ሳቀኒ ወለካ ነሞታቲን ፉለ ዬሱስ ዱረት ስሬሳቲን ገድ እሰ ቡሰን።<verse eid="LUK 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 5:20"/>ዬሱስስ ዮሙ አመንቲሳኒ አርጌት፣ <char style="wj">“ነምቾ፣ ጩቡንኬ ሲፍ ዺፈሜረ”</char> ጄዼ።<verse eid="LUK 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 5:21"/>ፈሪሶትኒፊ በርሲስቶትን ሴራስ፣ “ነምች ዋቀ አረብሱ ኩን ኤኙ? ዋቀ ቶክቸ መሌ ኤኙቱ ጩቡ ነማፍ ዺሱ ደንደአ?” ጄዸኒ ገራሳኒት ያዱ ጀልቀበን።<verse eid="LUK 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 5:22"/>ዬሱስስ ዋን እሳን ያዳ ቱረን ቤኬ አከነ ጄዼ ጋፈቴ፤ <char style="wj">“እስን ማሊፍ ገራኬሰን ኬሰት ዋን ከነ ያዱ?</char> <verse eid="LUK 5:22"/><verse number="23" style="v" sid="LUK 5:23"/><char style="wj">‘ጩቡንኬ ሲፍ ዺፈሜረ’ ጄቹሞ ‘ከኢ ዴም’ ጄቹቱ ሰልጳዸ?</char> <verse eid="LUK 5:23"/><verse number="24" style="v" sid="LUK 5:24"/><char style="wj">አን ገሩ አከ እልም ነማ ጩቡ ነማፍ ዺሱዻፍ ለፈረት ታይታ ቀቡ አከ ቤክተን ነንበርባደ።”</char> ከናፉ እን ነምቸ ዸግን እረት ዱኤ ሰናን፣ <char style="wj">“አን ስት ነንህመ፤ ከእ፤ ስሬኬ ፉዸዹቲ መነኬት ገል”</char> ጄዼ። <verse eid="LUK 5:24"/><verse number="25" style="v" sid="LUK 5:25"/>እንስ ዬሩመ ሰነ ከኤ ፉለሳኒ ዱረ ዻበቴ፤ ዋን እረ ጪሳ ቱሬስ ፉዸቴ ዋቀ ጀጀቻ መነ ኦፊሳት ቀጄሌ። <verse eid="LUK 5:25"/><verse number="26" style="v" sid="LUK 5:26"/>ሁንድሳኒስ ድንቅፈተኒ ዋቀ ጀጀን። ሶዳዻንስ ጉተመኒ፣ “ኑ ሀርአ ዋን ተኩማ ህንተእን አርግኔ” ጄዸን።<verse eid="LUK 5:26"/></para>
  <para style="s1">ዋመሙ ሌዊ</para>
  <para style="r">
    <ref loc="LUK 5:27-32">5፥27‑32</ref> ኩወፈ – <char style="xt"><ref loc="MAT 9:9-13">ማቴ 9፥9‑13</ref>፤ <ref loc="MRK 2:14-17">ማር 2፥14‑17</ref></char></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 5:27"/>ኤርገሲ ዬሱስ አቺ በኤ ቀረጡ ሌዊ ጄዸሙ ቶኮ ኡቱ እን እዶ እት ቀረጠ ወልት ቀበን ታኡ አርጌ። ዬሱስስ፣ <char style="wj">“ነ ዱካ ቡእ”</char> ጄዼን። <verse eid="LUK 5:27"/><verse number="28" style="v" sid="LUK 5:28"/>ሌዊንስ ዋን ሁንደ ዺሴ ከኤ እሰ ዱካ ቡኤ።<verse eid="LUK 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 5:29"/>ሌዊንስ መነሳት ጭዸ ጉዳ ዬሱሲፍ ቆጴሴ፤ ቀረጦትኒፊ ነሞትን ካን ባይኤንስ እሳን ወጅን ኛቻ ቱረን። <verse eid="LUK 5:29"/><verse number="30" style="v" sid="LUK 5:30"/>ፈሪሶትኒፊ በርሲስቶትን ሴራ ከኔን ገሬሳኒ ተአን ገሩ፣ “እስን ማሊፍ ቀረጦታፊ ጩበሞተ ወጅን ኛተኒ ዹግዱ?” ጄዸኒ በረቶተሳት ጉንጉመን።<verse eid="LUK 5:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 5:31"/>ዬሱስሞ ዴብሴ አከነ እሳኒን ጄዼ፤ <char style="wj">“ኦጌስ ፈያ ቶኮ ወረ ዹኩብሰተኒፍ መሌ ወረ ፈያ ቀበኒፍ ህንበርባችሱ።</char> <verse eid="LUK 5:31"/><verse number="32" style="v" sid="LUK 5:32"/><char style="wj">አን ጩበሞተ ገረ ቀልቢ ጅጂረትናት ዋሙፍን ዹፌ መሌ ቀጄልቶተ ዋሙፍ ህንዹፍኔ።”</char><verse eid="LUK 5:32"/></para>
  <para style="s1">ዬሱስ ዋኤ ሶማ ጋፈተሙሳ</para>
  <para style="r">
    <ref loc="LUK 5:33-39">5፥33‑39</ref> ኩወፈ – <char style="xt"><ref loc="MAT 9:14-17">ማቴ 9፥14‑17</ref>፤ <ref loc="MRK 2:18-22">ማር 2፥18‑22</ref></char></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 5:33"/>እሳንስ፣ “በረቶትን ዮሀንስ ዬሮ ባይኤ ንሶሙ፤ ንከዸቱስ፤ በረቶትን ፈሪሶታስ አከሱመ ጎዹ፤ በረቶትንኬ ገሩ ንኛቱ፤ ንዹጉስ” ጄዸኒን።<verse eid="LUK 5:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 5:34"/>ዬሱስሞ አከነ ጄዼ ዴብሴ፤ <char style="wj">“እስን ኡቱ እን እሳን ወጅን ጅሩ ምቾተ ምስርቻ ሶምስሱ ንደንዴሱ?</char> <verse eid="LUK 5:34"/><verse number="35" style="v" sid="LUK 5:35"/><char style="wj">ገሩ ዬሮን እት ምስርች እሳን ብራ ፉዸተሙ ንዹፈ፤ እሳንስ ዬሮ ሰነ ንሶሙ።”</char><verse eid="LUK 5:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 5:36"/>እንስ አከነ ጄዼ ፈኬኘ ከነ እሳንት ህሜ፤ <char style="wj">“ነምን ኡፈተ ሞፋ ኤርቡፍ ጄዼ ሁጩ ኡፈተ ሃራ ተርሳሱ ቶኮዩ ህንጅሩ። ዮ ኩን ጎዸሜ፣ እሳን ኡፈተ ሃራ ሰነ ተርሳሰኒሩ፤ ኤርቤን ሃራን ሱንስ ኡፈተ ሞፋ ወጅን ወል ህንፉዸቱ።</char> <verse eid="LUK 5:36"/><verse number="37" style="v" sid="LUK 5:37"/><char style="wj">ነምን ዳዺ ወይኒ ሃራ</char><note caller="+" style="f"><char style="fr" closed="false">5፥37 </char><char style="fq" closed="false">ዳዺ ወይኒ ሃራ </char><char style="ft" closed="false">– ዳዺ ወይኒ ከን አመሌ ደንፋ ጅሩ ዮካን ከን ህንብልቻትን ጄቹዸ።</char></note> <char style="wj">ቀልቀሎ ሞፋት ነቁ ቶኮዩ ህንጅሩ። ዮ እት ነቄሞ ዳዺን ሃራን ሱን ቀልቀሎ ሰነ ንዾሰ፤ ዳዺን ሱን ንዸንገለአ፤ ቀልቀልችስ ሆሮማ በአ።</char> <verse eid="LUK 5:37"/><verse number="38" style="v" sid="LUK 5:38"/><char style="wj">ቆደ ከና ዳዺን ወይኒ ሃራን ቀልቀሎ ዳዺ ወይኒ ሃራት ነቀሙ ቀበ።</char> <verse eid="LUK 5:38"/><verse number="39" style="v" sid="LUK 5:39"/><char style="wj">ነምን ከምዩ ኤርገ ዳዺ ወይኒ ከን ጎጌ ዹጌ ቦዴ ዳዺ ወይኒ ሃራ ህንበርባዱ፤ እሳን፣ ‘ዳዺ ወይኒ ከን ጎጌ ወየ’ ጄዹቲ።”</char><verse eid="LUK 5:39"/></para>
  <chapter eid="LUK 5"/>
  <chapter number="6" style="c" sid="LUK 6"/>
  <para style="s1">ዬሱስ ጎፍታ ሰንበታት</para>
  <para style="r">
    <ref loc="LUK 6:1-11">6፥1‑11</ref> ኩወፈ – <char style="xt"><ref loc="MAT 12:1-14">ማቴ 12፥1‑14</ref>፤ <ref loc="MRK 2:23-3:6">ማር 2፥23–3፥6</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 6:1"/>ጉያ ሰንበታ ቶኮ ዬሱስ ለፈ ቆቲሳ ምዻኒ ኬሰ ደርባ ቱሬ፤ በረቶትንሳስ አሼቲ ምዻኒ ጭረተኒ ሀርከሳኒቲን ሱኩመተኒ ኛቹ ጀልቀበን። <verse eid="LUK 6:1"/><verse number="2" style="v" sid="LUK 6:2"/>ፈሪሶተ ኬሳስ ቶኮ ቶኮ፣ “እስን ማሊፍ ዋን ሰንበታን ሆጄቹን ህንኤየመምኔ ሆጄቱ?” ጄዸኒ ጋፈተን።<verse eid="LUK 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 6:3"/>ዬሱስስ አከነ ጄዼ ዴብሴፍ፤ <char style="wj">“እስን ዋን ዳዊት ዬሮ እኒፊ ሚልቶትንሳ ቤለአንት ጎዼ ሰነ ተኩማ ህንዱብፍኔ?</char> <verse eid="LUK 6:3"/><verse number="4" style="v" sid="LUK 6:4"/><char style="wj">እን መነ ዋቃ ሴኔ ቡዴነ ቁልቁሌፈሜ</char><note caller="+" style="f"><char style="fr" closed="false">6፥4 </char><char style="fq" closed="false">ቡዴነ ቁልቁሌፈሜ </char><char style="ft" closed="false">– ቡዴነ ኩዸ ለማን ጉያ ሰንበታ መነ ዋቃ ኬሰ ጠረጴሳ ወርቄ ድበሜረ ካአሙዸ። ቡዴን ኩን አችት ጎፍታፍ ዽኤፈመ። ሰንበተ እት ኣኑትሞ ሉቦታፍ ኬነመ። ሉቦትንስ እዶ ቁልቁሉ ቶኮት ኛቹ ቀቡ።</char></note> <char style="wj">ከን ሉቦተ ቆፋፍ ኤየመሜ ፉዸቴ ኛቴ። ወረ እሰ ወጅን ጅረኒፍስ ኬኔ።”</char> <verse eid="LUK 6:4"/><verse number="5" style="v" sid="LUK 6:5"/>ዬሱስስ፣ <char style="wj">“እልም ነማ ጎፍታ ሰንበታት”</char> እሳኒን ጄዼ።<verse eid="LUK 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 6:6"/>ሰንበተ ብራስ እን መነ ሰገዳ ሴኔ በርሲሳ ቱሬ፤ ነምች ሀርክሳ ምርጋ እረት ጎጌ ቶኮስ አች ቱሬ። <verse eid="LUK 6:6"/><verse number="7" style="v" sid="LUK 6:7"/>ፈሪሶትኒፊ በርሲስቶትን ሴራ ዬሱስን ህመቹፍ ጄዸኒ ሰበበ በርባዳ ቱረን፤ ከናፉ አከ እን ሰንበታን ነመ ፈይሱ እላሉፍ እሰ ጋደን። <verse eid="LUK 6:7"/><verse number="8" style="v" sid="LUK 6:8"/>ዬሱስ ገሩ ዋን እሳን ያደን ቤኬ ነምቸ ሀርክ እረት ጎጌ ሰናን፣ <char style="wj">“ከኢ ፉለ ነመ ሁንዳ ዱረ ዻበዹ”</char> ጄዼ። እንስ ከኤ አች ዻበቴ።<verse eid="LUK 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 6:9"/>ዬሱስስ፣ <char style="wj">“አንስ እስነን ጋፈዸ፤ ሰንበታን እሰ ከምቱ ኤየመማዸ? ዋን ጋሪ ሆጄቹሞ ዋን ሀማ ሆጄቹ? ሉቡ ኦልቹሞ በሌሱ?”</char> እሳኒን ጄዼ።<verse eid="LUK 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 6:10"/>ገረ ገሌስ ሁንደሳኒ እላሌ ነምቻን፣ <char style="wj">“ሀርከኬ ድሪርፈዹ”</char> ጄዼ። እንስ አከሱመ ጎዼ፤ ሀርክሳስ ጉቱማን ጉቱት ፈዬ። <verse eid="LUK 6:10"/><verse number="11" style="v" sid="LUK 6:11"/>ፈሪሶትኒፊ በርሲስቶትን ሴራ ገሩ አከ መሌ ኣረኒ ዬሱስን ማል ጎቹ አከ ደንደአን ወሊን መርአቹ ጀልቀበን።<verse eid="LUK 6:11"/></para>
  <para style="s1">ኤርገሞተ ኩዸ ለማን</para>
  <para style="r">
    <ref loc="LUK 6:13-16">6፥13‑16</ref> ኩወፈ – <char style="xt"><ref loc="MAT 10:2-4">ማቴ 10፥2‑4</ref>፤ <ref loc="MRK 3:16-19">ማር 3፥16‑19</ref>፤ <ref loc="ACT 1:13">ሆጂ 1፥13</ref></char></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 6:12"/>ዬሱስስ ጉዮተ ሰነ ኬሳ ጋፍ ቶኮ ከዸትናዻፍ ቱሉት ኦል በኤ፤ ሀልከን ጉቱስ ዋቀ ከዸቻ ቡሌ። <verse eid="LUK 6:12"/><verse number="13" style="v" sid="LUK 6:13"/>እንስ ዮሙ ለፍት በርኤት በረቶተሳ ኦፍት ዋሜ ነመ ኩዸ ለመ እሳን ኬሳ ፍለቴ፤ ኤርገሞተ ጄዼስ እሳን ሞጋሴ።<verse eid="LUK 6:13"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="14" style="v" sid="LUK 6:14"/>እሳንስ ስሞን እሰ እን ጴጥሮስ ጄዼ ሞጋሴ፣ ኦቦሌሰሳ እንድሪያስ፣</para>
  <para style="li1" vid="LUK 6:14">ያቆብ፣</para>
  <para style="li1" vid="LUK 6:14">ዮሀንስ፣</para>
  <para style="li1" vid="LUK 6:14">ፊልጶስ፣</para>
  <para style="li1" vid="LUK 6:14">በርተሎሜዎስ፣<verse eid="LUK 6:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="LUK 6:15"/>ማቴዎስ፣</para>
  <para style="li1" vid="LUK 6:15">ቶማስ፣</para>
  <para style="li1" vid="LUK 6:15">ያቆብ እልመ እልፍዮስ፣</para>
  <para style="li1" vid="LUK 6:15">ስሞን እሰ ህናፍትቸ ጄዸሜ ዋመሜ፣<verse eid="LUK 6:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="LUK 6:16"/>ይሁዳ እልመ ያቆብ፣</para>
  <para style="li1" vid="LUK 6:16">ይሁዳ አስቆሮትቸ እሰ ዬሱስን ደበርሴ ኬኔ።<verse eid="LUK 6:16"/></para>
  <para style="s1">ኤባፊ ወዮወን</para>
  <para style="r">
    <ref loc="LUK 6:20-23">6፥20‑23</ref> ኩወፈ – <char style="xt"><ref loc="MAT 5:3-12">ማቴ 5፥3‑12</ref></char></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 6:17"/>እንስ እሳን ወጅን ገድ ቡኤ እዶ ድሪራ ቶኮረ ዻበቴ። ቱትን በረቶተሳ ጉዳንስ አች ቱሬ፤ ነሞትን ይሁዳ ሁንደ ኬሳ፣ ዬሩሳሌም ኬሳ፣ ብየ ቀርቀረ ገላና ከን ናኖ ጢሮሲፊ ሲዶናቲ ዹፈን ባይኤን፣ <verse eid="LUK 6:17"/><verse number="18" style="v" sid="LUK 6:18"/>ወር እሰ ዸገኡፊ ዹኩበሳኒራ ፈዩፍ ዹፈንስ አች ቱረን። ወር ሀፉሮተ ጡራኦን ዽጰቻ ቱረንስ ንፈየን፤ <verse eid="LUK 6:18"/><verse number="19" style="v" sid="LUK 6:19"/>ሰበቢ ሁምን እሰ ኬሳ በኤ ሁንዱመሳኒ ፈይሳ ቱሬፍ፣ ነሞትን ሁንድኑ እሰ ቱቁፍ ጨራቃ ቱረን።<verse eid="LUK 6:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 6:20"/>እንስ በረቶተሳ እላሌ አከነ ጄዼ፦</para>
  <para style="q1" vid="LUK 6:20">
    <char style="wj">“እስን ወር ህዬዪን ኤብፈሞዸ፤</char></para>
  <para style="q2" vid="LUK 6:20">
    <char style="wj">ሞቱማን ዋቃ ከንኬሰኒቲ።</char><verse eid="LUK 6:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LUK 6:21"/>
    <char style="wj">እስን ወር አመ ቤሎፍተን ኤብፈሞዸ፤</char></para>
  <para style="q2" vid="LUK 6:21">
    <char style="wj">ንቁፍቱቲ።</char></para>
  <para style="q1" vid="LUK 6:21">
    <char style="wj">እስን ወር አመ ቦሰን ኤብፈሞዸ፤</char></para>
  <para style="q2" vid="LUK 6:21">
    <char style="wj">ንኮልፍቱቲ።</char><verse eid="LUK 6:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="LUK 6:22"/>
    <char style="wj">ዮሙ ነሞትን ሰበቢ እልመ ነማቲፍ ጄዸኒ እስን ጅበን፣</char></para>
  <para style="q2" vid="LUK 6:22">
    <char style="wj">ዮሙ እሳን ኦፍ ኬሳ እስን ባሰኒፊ እስን አረብሰን፣</char></para>
  <para style="q2" vid="LUK 6:22">
    <char style="wj">ዮሙ እሳን መቃኬሰን አከ ዋን ሀማ ቶኮት ቱፈተን፣</char></para>
  <para style="q3" vid="LUK 6:22">
    <char style="wj">እስን ኤብፈሞዸ።</char><verse eid="LUK 6:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 6:23"/>
    <char style="wj">“ሰበቢ ገቲንኬሰን ሰሚ ኬሰት ጉዳ ተኤፍ ጋፈ ሰነ እልልቻቲ ገመቹዻን ቡቡራቃ። አቦቲንሳኒዩ አከሱመ ራጆተ ጎዸኒቲ።</char><verse eid="LUK 6:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="LUK 6:24"/>
    <char style="wj">“ገሩ ወር ሶሬዪን እስኒፍ ወዮ፤</char></para>
  <para style="q2" vid="LUK 6:24">
    <char style="wj">እስን ጀጀብነኬሰን አርገተኒርቱቲ።</char><verse eid="LUK 6:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="LUK 6:25"/>
    <char style="wj">ወር አመ ቁፍተን እስኒፍ ወዮ፣</char></para>
  <para style="q2" vid="LUK 6:25">
    <char style="wj">ቤለኡፍ ጅርቱቲ፣</char></para>
  <para style="q1" vid="LUK 6:25">
    <char style="wj">ወር አመ ኮልፍተን እስኒፍ ወዮ፤</char></para>
  <para style="q2" vid="LUK 6:25">
    <char style="wj">ወዋቹፊ ቦኡፍ ጅርቱቲ።</char><verse eid="LUK 6:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="LUK 6:26"/>
    <char style="wj">ዮሙ ነምን ሁንድኑ እስን ሳዱ እስኒፍ ወዮ፤</char></para>
  <para style="q2" vid="LUK 6:26">
    <char style="wj">አቦቲንሳኒዩ አከኑመ ራጆተ ሶባ ሳዳ ቱረኒቲ።</char><verse eid="LUK 6:26"/></para>
  <para style="s1">ዲነ ኦፊ ጃለቹ</para>
  <para style="r">
    <ref loc="LUK 6:29">6፥29</ref>፣<ref loc="LUK 6:30">30</ref> ኩወፈ – <char style="xt"><ref loc="MAT 5:39-42">ማቴ 5፥39‑42</ref></char></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 6:27"/>
    <char style="wj">“አን ገሩ እስን ወረ ነ ዸጌሰንት ነንህመ፤ ዲኖተኬሰን ጃለዻ፤ ወረ እስን ጅበኒፍ ዋን ጋሪ ሆጄዻ፤</char> <verse eid="LUK 6:27"/><verse number="28" style="v" sid="LUK 6:28"/><char style="wj">ወረ እስን አባረን ኤብሳ፤ ወረ እስን ሚዸኒፍስ ከዸዻ።</char> <verse eid="LUK 6:28"/><verse number="29" style="v" sid="LUK 6:29"/><char style="wj">ዮ ነምን ቶኮ መዲ ቶኮ ስ ከበሌ፣ መዲ ካንስ እት ቀብ። ዮ ነምን ቶኮ ኮቲኬ ስራ ባፈቴሞ፣ ክታኬሌ ህንዾወትን።</char> <verse eid="LUK 6:29"/><verse number="30" style="v" sid="LUK 6:30"/><char style="wj">ነመ ስ ከዸቱ ሁንዱማፍ ኬን፤ ዮ ነምን ከምዩ ዋን ከንኬ ተኤ ፉዸቴ፣ አከ ወን ሱን ሲፍ ዴብፈሙ ህንጋፈትን።</char> <verse eid="LUK 6:30"/><verse number="31" style="v" sid="LUK 6:31"/><char style="wj">እስንስ አኩመ ነሞትን ካን አከ እስኒፍ ጎዸን በርባደን ሰነ እሳኒፍ ጎዻ።</char><verse eid="LUK 6:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 6:32"/>
    <char style="wj">“እስን ወረ እስን ጃለተን ቆፈ ዮ ጃለተን፣ ኩን ገለተ ማሊ እስኒፍ ቀበ? ጩበሞትንዩ ወረ እሳን ጃለተን ንጃለቱቲ።</char> <verse eid="LUK 6:32"/><verse number="33" style="v" sid="LUK 6:33"/><char style="wj">እስን ዮ ወረ ዋን ጋሪ እስኒ ጎዸኒፍ ዋን ጋሪ ጎተን፣ ኩን ገለተ ማሊ እስኒፍ ቀበ? ከነሞ ጩበሞትንዩ ንጎዹቲ።</char> <verse eid="LUK 6:33"/><verse number="34" style="v" sid="LUK 6:34"/><char style="wj">ወሩመ አከ እስኒፍ ዴብሰን አብደተኒፍ ዮ ልቄስተን ገለተ ማሊ አርገቱ? ‘ጩበሞትንዩ’ ሀሙመ ልቄሰን ሰነ ዴብሰኒ አርገቹፍ ጄዸኒ ጩበሞታፍ ንልቄሱቲ።</char> <verse eid="LUK 6:34"/><verse number="35" style="v" sid="LUK 6:35"/><char style="wj">እስን ገሩ ዲኖተኬሰን ጃለዻ፤ ዋን ጋሪስ እሳኒፍ ሆጄዻ፤ ኡቱ ዋን እስኒ ዴብኡ ቶኮሌ ህንአብደትን እሳኒፍ ልቄሳ። ዮስ ገቲንኬሰን ጉዳ ንተአ፤ እስንስ እጆሌ ዋቀ ዋን ሁንዳ ኦሊ ንታቱ፤ እን ወረ ህንገለቴፈትኔፊ ሀሞታፍሌ አርጃዻቲ።</char> <verse eid="LUK 6:35"/><verse number="36" style="v" sid="LUK 6:36"/><char style="wj">አኩመ አባንኬሰን አራረ ቀቤሰ ተኤ ሰነ፣ እስንስ አራረ ቀቤዪ ተኣ።</char><verse eid="LUK 6:36"/></para>
  <para style="s1">ነመት ሙሩ</para>
  <para style="r">
    <ref loc="LUK 6:37-42">6፥37‑42</ref> ኩወፈ – <char style="xt"><ref loc="MAT 7:1-5">ማቴ 7፥1‑5</ref></char></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 6:37"/>
    <char style="wj">“ነመት ህንሙርና፤ እስንትስ ህንሙረሙቲ። ነመ ህንየክና፤ እስንስ ህንየከምተኒ። ዺፈመስ ጎዻ፤ ዺፈምን እስኒ ጎዸማቲ።</char> <verse eid="LUK 6:37"/><verse number="38" style="v" sid="LUK 6:38"/><char style="wj">ኬና፤ እስኒፍስ ንኬነማ። ሰፈርቱን ጋሪን እት ሁዱመሜ፣ ከን ሶቾፈሜፊ ጉተሜ እረ ዸንገለኤ ቦባኬሰንት እስኒ ነቀመ። ሰፈርቱ እቲን ሰፈርተኒንስ እስኒፍ ሰፈረማቲ።”</char><verse eid="LUK 6:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 6:39"/>እንስ አከነ ጄዼ ፈኬኘ ከነ እሳንት ህሜ፤ <char style="wj">“ጃማን ቶኮ ጃማ ቀጄልቹ ንደንደኣ? እሳን ለቹ ቦለ ኬሰ ህንቡአኒ?</char> <verse eid="LUK 6:39"/><verse number="40" style="v" sid="LUK 6:40"/><char style="wj">በረታን በርሲሳሳቲ ኦል ምት፤ ነምን ጉቱማን ጉቱት ሌንጅፈሜ ሁንድኑ ገሩ አከ በርሲሳሳ ንተአ።</char><verse eid="LUK 6:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 6:41"/>
    <char style="wj">“አት ማሊፍ ጅርመ እጀኬ ኬሰ ጅሩ አርጉ ዺፍቴ ሁበ እጀ ኦቦሌሰኬቲ ኬሰ ጅሩ እላልተ?</char> <verse eid="LUK 6:41"/><verse number="42" style="v" sid="LUK 6:42"/><char style="wj">አት ኡቱ ኦፊኬቲ ጅርመ እጀኬ ኬሰ ጅሩ አርጉ ህንደንደእን፣ አከምት ኦቦሌሰኬቲን፣ ‘ኦቦሌሳ፣ ኮቱ ሜ አን ሁበ እጀኬ ኬሰ ጅሩ ሲፍ ነንባሰ’ ጄቹ ደንዴሰ? ፈኬስቱነነ፣ ዱራን ዱርሲቲ ጅርመ እጀኬ ኬሰ ጅሩ ባፈዹ፤ ኤርገሲስ ሁበ እጀ ኦቦሌሰኬቲ ኬሰ ጅሩ ባሱዻፍ ስሪት አርግተ።</char><verse eid="LUK 6:42"/></para>
  <para style="s1">ሙካፊ እጀሳ</para>
  <para style="r">
    <ref loc="LUK 6:43">6፥43</ref>፣<ref loc="LUK 6:44">44</ref> ኩወፈ – <char style="xt"><ref loc="MAT 7:16">ማቴ 7፥16</ref>፣<ref loc="MAT 7:18">18</ref>፣<ref loc="MAT 7:20">20</ref></char></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 6:43"/>
    <char style="wj">“ሙክን ጋሪን እጀ ገዼ ነቀቱ ቶኮዩ ህንጅሩ፤ ሙክን ገዼንስ እጀ ጋሪ ህንነቀቱ።</char> <verse eid="LUK 6:43"/><verse number="44" style="v" sid="LUK 6:44"/><char style="wj">ቶኮን ቶኮን ሙካ እጀሳቲን ቤከመ። ነሞትን ሙከ ቆራቲራ ሀርቡ፣ ዮካን ሶኮሩራ ወይኒ ህንጭረን።</char> <verse eid="LUK 6:44"/><verse number="45" style="v" sid="LUK 6:45"/><char style="wj">ነምን ጋሪን ዋን ጋሪ ገራሳ ኬሰት ኩፈቴ ኬሳ ዋን ጋሪ ባሰ፤ ነምን ሀማንሞ ዋን ሀማ ገራሳ ኬሰት ኩፈቴ ኬሳ ዋን ሀማ ባሰ። ዋን ገራ ጉቴ አፋን ዱበታቲ።</char><verse eid="LUK 6:45"/></para>
  <para style="s1">እጃርቶተ መና ለማን</para>
  <para style="r">
    <ref loc="LUK 6:47-49">6፥47‑49</ref> ኩወፈ – <char style="xt"><ref loc="MAT 7:24-27">ማቴ 7፥24‑27</ref></char></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 6:46"/>
    <char style="wj">“እስን ዋን አን ጄዹ ህንሆጄተን፤ ዮስ ማሊፍ፣ ‘ያ ጎፍታ፣ ያ ጎፍታ’ ናን ጄቱ?</char> <verse eid="LUK 6:46"/><verse number="47" style="v" sid="LUK 6:47"/><char style="wj">ነምን ገረኮ ዹፉ፣ ከን ዱቢኮ ዸገኤ ሆጂዻን አርግሲሱ ሁንድ ማል አከ ፈካቱ አን እስንት ነንአገርሲሰ።</char> <verse eid="LUK 6:47"/><verse number="48" style="v" sid="LUK 6:48"/><char style="wj">እሳን ነመ መነ እጃሩ፣ ከን ቦለ ገድ ፈጌሴ ቆቴ ሁንዴ መነ ሰና ከታረ ዻቤ ቶኮ ፈካቱ። ሰበቢ መንች ስሪት እጃረሜፍ፣ ሎላን ዬሮ ሎለኤ ሁምናን እት ቡኤት መነ ሰነ ሶቾሱ ህንደንዴኜ።</char> <verse eid="LUK 6:48"/><verse number="49" style="v" sid="LUK 6:49"/><char style="wj">ነምን ዱቢኮ ዸገኤ ሆጂዻን ህንአርግሲፍኔ ገሩ ነመ ለፈረት መነ ሁንዴ ህንቀብኔ እጃረቱ ቶኮ ፈካተ። ዬሮ ሎላን ሁምናን እት ቡኤት መን ሱን ንጅጌ፤ ጉቱማን ጉቱትስ ዲገሜ።”</char><verse eid="LUK 6:49"/></para>
  <chapter eid="LUK 6"/>
  <chapter number="7" style="c" sid="LUK 7"/>
  <para style="s1">አመንቲ አጀጃ ዽባ</para>
  <para style="r">
    <ref loc="LUK 7:1-10">7፥1‑10</ref> ኩወፈ – <char style="xt"><ref loc="MAT 8:5-13">ማቴ 8፥5‑13</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 7:1"/>ዬሱስ ዬሮ ዋን ከነ ሁንዱማ ነሞተ እሰ ዸጌፈቻ ቱረንት ህሜ ፍጠቴት፣ ቅፍርናሆም ሴኔ። <verse eid="LUK 7:1"/><verse number="2" style="v" sid="LUK 7:2"/>አችስ ተጃጅላን አጀጃ ዽባ ከን ጎፍታንሳ አከ መሌ እሰ ጃለቱ ቶኮ ዹኩብሰቴ ዱኡ ገኤ ቱሬ። <verse eid="LUK 7:2"/><verse number="3" style="v" sid="LUK 7:3"/>አጀጃን ዽባ ሱንስ ዋኤ ዬሱስ ዸገኤ አከ እን ዹፌ ገርብቸሳ ፈይሱፍ ማንጉዶተ ይሁዶታ እሰት ኤርጌ ከዸቴ። <verse eid="LUK 7:3"/><verse number="4" style="v" sid="LUK 7:4"/>እሳንስ ዮሙ ገረ ዬሱስ ዹፈንት አከነ ጄዸኒ ጀቤሰኒ እሰ ከዸተን፤ “አት ዋን ከነ እሳፍ ጎቹን ነምቸ ከናፍ ንመለ፤ <verse eid="LUK 7:4"/><verse number="5" style="v" sid="LUK 7:5"/>እን ሰበኬኘ ንጃለታቲ፤ መነ ሰገዳስ ኑ እጃሬረ።” <verse eid="LUK 7:5"/><verse number="6" style="v" sid="LUK 7:6"/>ከናፉ ዬሱስ እሳን ወጅን ዴሜ።</para>
  <para style="p" vid="LUK 7:6">ዬሮ እን መንቸት ዽኣቴት አጀጃን ዽባ ሱን አከነ ጄዼ ምቾተሳ ዬሱስት ኤርጌ፤ “ያ ጎፍታ ኦፍ ህንረክስን፤ አት በንቲ መነኮ ጀለ ሴኑን ናፍ ህንመሉቲ። <verse eid="LUK 7:6"/><verse number="7" style="v" sid="LUK 7:7"/>ሰበቢን አን ኦፊኮ አከ ነመ ገረኬ ዹፉን መሉፍት ህንእላልኒፍዩ ከኑመ። ገሩ ዱብቸ ቆፈ ዱበዹ፤ ተጃጅላንኮ ንፈያቲ። <verse eid="LUK 7:7"/><verse number="8" style="v" sid="LUK 7:8"/>አን መታንኮዩ ነመ ታይታ ጀለ ጅሩዸ፤ ሎልቶተስ ኦፍ ጀላ ቀበ። እሰ ቶኮን፣ ‘ዴም’ ነንጄዸ፤ እንስ ንዴመ፤ እሰ ካኒንሞ፣ ‘ኮቱ’ ነንጄዸ፤ እንስ ንዹፈ። ተጃጅላኮቲንስ፣ ‘ዋን ከነ ሆጄዹ’ ነንጄዸ፤ እንስ ንሆጄተ።”<verse eid="LUK 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 7:9"/>ዬሱስ ዮሙ ዋን ከነ ዸገኤት እሰ ድንቅፈቴ፤ ነሞተ እሰ ዱካ ቡኣ ቱረንትስ ገረ ገሌ፣ <char style="wj">“አን እስንትን ህመ፤ አን አመንቲ ጉዳ አከና እስራኤል ኬሰትዩ ህንአርገትኔ”</char> ጄዼ። <verse eid="LUK 7:9"/><verse number="10" style="v" sid="LUK 7:10"/>ዮሙ ነሞትን ኤርገመኒ ቱረን መነት ዴብአንት ገርብች ሱን ፈዬ እሳን ኤጌ።<verse eid="LUK 7:10"/></para>
  <para style="s1">ዬሱስ እልመ ሃዸ ህዬሳ ዱኣ ካሴ</para>
  <para style="r">
    <ref loc="LUK 7:11-16">7፥11‑16</ref> ኩወእ – <char style="xt"><ref loc="1KI 17:17-24">1ሞቶ 17፥17‑24</ref>፤ <ref loc="2KI 4:32-37">2ሞቶ 4፥32‑37</ref>፤ <ref loc="MRK 5:21-24">ማር 5፥21‑24</ref>፣<ref loc="MRK 5:35-43">35‑43</ref>፤ <ref loc="JHN 11:1-44">ዮሀ 11፥1‑44</ref></char></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 7:11"/>ዬሱስ ኤርገሲ መጋላ ናይን ጄዸምቱ ቶኮ ዸቄ፤ በረቶትንሳቲፊ ነሞትን ባይኤንስ እሰ ወጅን ዸቀን። <verse eid="LUK 7:11"/><verse number="12" style="v" sid="LUK 7:12"/>ዮሙ እን ከረ መጋለቲት ዽኣቴት ጀር ቶኮ ነመ ዱኤ ቶኮ ባተኒ እሰት ዹፈን፤ ነምች ዱኤ ሱንስ ሃዸሳቲፍ እልመ ቶክቸ ቱሬ፤ ሃትሳስ ሃዸ ህዬሳ ቱርቴ። ነሞትን መጋለቲ ባይኤንስ እሼ ወጅን ቱረን። <verse eid="LUK 7:12"/><verse number="13" style="v" sid="LUK 7:13"/>ጎፍታንስ ዮሙ እሼ አርጌት ነኤፊ፣ <char style="wj">“ህንቦእን”</char> ጄዼን።<verse eid="LUK 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 7:14"/>እንስ እት ዽኣቴ ወሳሳ ሬፈ ሰና ቱቄ፤ ወር ሬፈ ባተንስ ንዻበተን። እንስ፣ <char style="wj">“ጉርበዮ፣ አን ሲን ነንጄዻ፣ ከእ!”</char> ጄዼን። <verse eid="LUK 7:14"/><verse number="15" style="v" sid="LUK 7:15"/>ጉርባን ዱኤ ሱንስ ከኤ ታኤ ዱበቹ ጀልቀቤ፤ ዬሱስስ ዴብሴ ሃዸሳት እሰ ኬኔ።<verse eid="LUK 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 7:16"/>ሁንድሳኒ ንሶዳተን፤ “ራጂን ጉዳን ኑ ኬሳ አርገሜረ። ዋቅንስ ሰበሳ ገርጋሩፍ ዹፌረ” ጄዸኒ ዋቃፍ ኡልፍነ ኬነን። <verse eid="LUK 7:16"/><verse number="17" style="v" sid="LUK 7:17"/>ኦዱን ዋኤ ዬሱስ ኩንስ ይሁዳ ጉቱፊ ብየ ናኖ ሰነ ጅሩ ሁንዱማ ኬሰ ፈፈጨኤ።<verse eid="LUK 7:17"/></para>
  <para style="s1">ዬሱሲፊ ዮሀንስ ጩጳ</para>
  <para style="r">
    <ref loc="LUK 7:18-35">7፥18‑35</ref> ኩወፈ – <char style="xt"><ref loc="MRK 11:2-19">ማር 11፥2‑19</ref></char></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 7:18"/>በረቶትን ዮሀንስ ዋኤ ዋን ከነ ሁንዳ እሰት ህመን። ዮሀንስስ እሳን ኬሳ ነመ ለመ ኦፍት ዋሜ፣ <verse eid="LUK 7:18"/><verse number="19" style="v" sid="LUK 7:19"/>“እን ዹፉፍ ጅሩ ስእሞ ዮካን ከን ብራ ኤገትነ?” ጄዼ ጋፈቹዻፍ ጎፍታት እሳን ኤርጌ።<verse eid="LUK 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 7:20"/>ነሞትን ሱንስ ዮሙ ገረ ዬሱስ ዹፈንት፣ “ዮሀንስ ጩጳን፣ ‘እን ዹፉፍ ጅሩ ሱን ስእሞ ዮካን ከን ብራ ኤገትነ?’ ጄዼ ጋፈቹዻፍ ስት ኑ ኤርጌረ” ጄዸኒን።<verse eid="LUK 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 7:21"/>ዬሱስስ ዬሩመ ሰነ ነሞተ ዽቤ፣ ዹኩባፊ ሀፉረ ሀማ ቀበን ሄዱ ፈይሴ፤ ወረ ጃማ ቱረን ባይኤዻፍስ አገርቱ ዴብሴ። <verse eid="LUK 7:21"/><verse number="22" style="v" sid="LUK 7:22"/>እንስ አከነ ጄዼ ኤርገሞተ ሰናፍ ዴቢ ኬኔ፤ <char style="wj">“ዴብኣቲ ዋን አርግተኒፊ ዋን ዸጌሰን ዮሀንስት ህማ፤ ጃሞትን ንአርጉ፤ ወር ናፈተን ንዴሙ፤ ወር ለምጣአን ንቁልቁላኡ፤ ወር ዱደን ንዸገኡ፤ ወር ዱአን ንከኡ፤ ህዬዪፍስ ወንጌል ንለለበመ።</char> <verse eid="LUK 7:22"/><verse number="23" style="v" sid="LUK 7:23"/><char style="wj">ነምን ነት ህንጉፈትኔ ከምዩ ኤብፈማዸ።”</char><verse eid="LUK 7:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 7:24"/>ኤርገ ኤርገሞትን ዮሀንስ በአኒ ቀጄለኒ ቦዴ ዬሱስ አከነ ጄዼ ዋኤ ዮሀንስ ነሞተት ህሙ ጀልቀቤ፤ <char style="wj">“እስን ማል አርጉፍ ገሞጂት ገድ ባተን? ሸምበቆ ቅሌንስ ራሱሞ?</char> <verse eid="LUK 7:24"/><verse number="25" style="v" sid="LUK 7:25"/><char style="wj">ዮስ ማል አርጉ ባተንሬ? ነመ ኡፈተ ሚዸጋ ኡፈቴሞ? ለክ፣ ወር ኡፈተ ሚዸጋ ኡፈተኒ ቀነኒዻን ጅራተን መሰራወን ኬሰ ጅሩ።</char> <verse eid="LUK 7:25"/><verse number="26" style="v" sid="LUK 7:26"/><char style="wj">ገሩ እስን ማል አርጉ ባተን? ራጂሞ? ኤዬ፤ አን እስንትን ህመ፤ ከን ራጂዩ ጫሉ።</char> <verse eid="LUK 7:26"/><verse number="27" style="v" sid="LUK 7:27"/><char style="wj">ኩንስ እሰ ዋኤንሳ አከነ ጄዸሜ በሬፈሜዸ፦</char></para>
  <para style="q1" vid="LUK 7:27">
    <char style="wj">“ ‘ኩኖ፣ አን ኤርገማኮ እሰ ፉለኬ ዱራን ከራኬ ቆጴሱ፣</char></para>
  <para style="q2" vid="LUK 7:27">
    <char style="wj">ፉለኬ ዱረ ነንኤርገ።’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">7፥27 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="MAL 3:1">ሚል 3፥1</ref>
        </char>
      </char>
    </note><verse eid="LUK 7:27"/></para>
  <para style="m">
    <verse number="28" style="v" sid="LUK 7:28"/>
    <char style="wj">አን እስንትን ህመ፤ ነሞተ ዱበርቶተራ ዸለተን ኬሳ ነምን ዮሀንስ ጩጳ ጫሉ ቶኮዩ ህንጅሩ፤ ነምን ሞቱማ ዋቃ ኬሰት ነመ ሁንዱማ ገድ ተኤ ገሩ እሰ ንጫለ።”</char><verse eid="LUK 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 7:29"/>ነሞትን ሁንድ፣ ቀረጦትንዩ ዋን ሀርከ ዮሀንስት ጩጰመኒ ቱረኒፍ ዮሙ ዱቢ ዬሱስ ዸገአንት፣ ከራን ዋቃ ቀጄላ ተኡሳ ምርከኔሰን።<verse eid="LUK 7:29"/></para>
  <para style="s1">ዬሱሲፊ ፈሪሶተ</para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 7:30"/>ፈሪሶትኒፊ ቤክቶትን ሴራ ገሩ ሰበቢ ሀርከ ዮሀንስት ህንጩጰምኒፍ ካዮ ዋቅን እሳኒፍ ቀቡ ፉዸቹ ድደን።<verse eid="LUK 7:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 7:31"/>ዬሱስ እት ፉፌ አከነ ጄዼ፤ <char style="wj">“ዮስ አን ነሞተ ዸሎተ ከና ማሊነን ወል ፈኬሱ ደንደአሬ? እሳን ማል ፈካቱ?</char> <verse eid="LUK 7:31"/><verse number="32" style="v" sid="LUK 7:32"/><char style="wj">እሳን አኩመ እጆሌ እዶ ገባ ታአኒ ወል ዋመኒ አከነ ጄዸኒት፦</char></para>
  <para style="q1" vid="LUK 7:32">
    <char style="wj">“ ‘ኑ ኡሉሌ እስኒ አፉፍኔ፤</char></para>
  <para style="q2" vid="LUK 7:32">
    <char style="wj">እስን ገሩ ህንስርብኔ፤</char></para>
  <para style="q1" vid="LUK 7:32">
    <char style="wj">ፋሩ ቦእቻስ ፋርስኔ፤</char></para>
  <para style="q2" vid="LUK 7:32">
    <char style="wj">እስን ገሩ ህንቦኜ።’</char><verse eid="LUK 7:32"/></para>
  <para style="m">
    <verse number="33" style="v" sid="LUK 7:33"/>
    <char style="wj">ዮሀንስ ጩጳን ዬሮ ዹፌት ቡዴነ ህንኛቱ፣ ዳዺ ወይኒስ ህንዹጉ ቱሬቲ፤ እስንሞ፣ ‘እን ሀፉረ ሀማ ቀበ’ ጄቱ።</char> <verse eid="LUK 7:33"/><verse number="34" style="v" sid="LUK 7:34"/><char style="wj">እልም ነማ ኛቻ፣ ዹጋስ ዹፌ፤ እስንሞ፣ ‘ኩኖ አልባዼሳፊ መቻኣ፣ ምቹ ቀረጦታቲፊ ጩበሞታ’ ጄቱ።</char> <verse eid="LUK 7:34"/><verse number="35" style="v" sid="LUK 7:35"/><char style="wj">ኦጉማን ገሩ እጆሌሼ ሁንዱማን ምርከኔፈምት።”</char><verse eid="LUK 7:35"/></para>
  <para style="s1">ዬሱስ ሽቶ ድበሙሳ</para>
  <para style="r">
    <ref loc="LUK 7:37-39">7፥37‑39</ref> ኩወእ – <char style="xt"><ref loc="MAT 26:6-13">ማቴ 26፥6‑13</ref>፤ <ref loc="MRK 14:3-9">ማር 14፥3‑9</ref>፤ <ref loc="JHN 12:1-8">ዮሀ 12፥1‑8</ref></char></para>
  <para style="r">
    <ref loc="LUK 7:41">7፥41</ref>፣<ref loc="LUK 7:42">42</ref> ኩወእ – <char style="xt"><ref loc="MAT 18:23-34">ማቴ 18፥23‑34</ref></char></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 7:36"/>ፈሪሶተ ኬሳ ነምች ቶኮ አከ እን እሰ ወጅን ኛቱፍ ዬሱስን አፌሬ፤ እንስ መነ ፈሪስቻ ዸቄ ማዲት ዽኣቴ። <verse eid="LUK 7:36"/><verse number="37" style="v" sid="LUK 7:37"/>ዱበርቲን ጩበምቱን መጋላ ሰና ቶኮስ ዮሙ አከ ዬሱስ መነ ፈሪስቻት ዋ ኛቻ ጅሩ በርቴት ብልቃጢ አልባስጥሮስት ሽቶ ቀበቴ ዹፍቴ። <verse eid="LUK 7:37"/><verse number="38" style="v" sid="LUK 7:38"/>እሼንስ ቦኣ ዱግደሳ ዱባን ሚለሳ ብረ ዻበቴ እምማንሼቲን ሚለሳ ጂሱ ጀልቀብዴ። ርፌንሰ መታሼቲንስ ሚለሳ ሀቅጤ፣ ዹንገቴስ ሚለሳ ሽቶ ድብዴ።<verse eid="LUK 7:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 7:39"/>ፈሪስች እሰ አፌሬ ሱንስ ዋን ከነ አርጌ፣ “ነምች ኩን ኡቱ ራጂ ተኤ፣ ዱበርቲን እሰ ቱቅጡ ኩን ኤኙ አከ ታቴ፣ ነመ አከሚስ አከ ታቴ ንቤከ ቱሬ፤ እሼን ጩበምቱዻቲ” ጄዼ ገራሳ ኬሰት ያዴ።<verse eid="LUK 7:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 7:40"/>ዬሱስሞ፣ <char style="wj">“ያ ስሞን፣ አን ዋነን ስት ህሙ ቶኮ ቀበ”</char> ጄዼን።</para>
  <para style="p" vid="LUK 7:40">እንስ፣ “ያ በርሲሳ ነት ህም” ጄዼ።<verse eid="LUK 7:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 7:41"/>ዬሱስስ አከነ ጄዼን፤ <char style="wj">“ነሞትን ለመ ነመ ማለቀ ልቄሱ ቶኮራ ማለቀ ልቄፈተን። እን ቶኮ ዲናሪ ዽበ ሸን ልቄፈቴ፤ ካንሞ ዲናሪ ሸንተመ ልቄፈቴ።</char> <verse eid="LUK 7:41"/><verse number="42" style="v" sid="LUK 7:42"/><char style="wj">ጀር ለቹ ዋን እሳፍ ከፈለን ዸብናን ዺሴፍ። ኤጋ ጀረ ለማን ኬሳ ከምቱ ጫላ እሰ ጃለተ?”</char><verse eid="LUK 7:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 7:43"/>ስሞንስ ዴብሴ፣ “እሰ ልቂን ጉዳን ዺፈሜፍ ሰነ ነት ፈካተ” ጄዼን።</para>
  <para style="p" vid="LUK 7:43">ዬሱስስ፣ <char style="wj">“አት ዹጋ ዱበቴ”</char> እሳን ጄዼ።<verse eid="LUK 7:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 7:44"/>እንስ ገረ ዱበርትቲት ገረገሌ ስሞኒን አከነ ጄዼ፤ <char style="wj">“ዱበርቲ ከነ አርግታ? አን መነኬ ነንዹፌ። አት ብሻን ሚላሌ ናፍ ህንኬንኔ፤ እሼን ገሩ እምማንሼቲን ሚለኮ ዽቅጤ ርፌንሰ መታሼቲን ሀቅጤ።</char> <verse eid="LUK 7:44"/><verse number="45" style="v" sid="LUK 7:45"/><char style="wj">አት ነ ህንዹንገትኔ፤ ዱበርቲን ኩን ገሩ ዬሮ አን ኦል ሴኔ ጀልቀብዴ ሚለኮ ዹንገቹ ህንዺፍኔ።</char> <verse eid="LUK 7:45"/><verse number="46" style="v" sid="LUK 7:46"/><char style="wj">አት ዘይቲዩ መታኮ ህንድብኔ፤ እሼን ገሩ ሚለኮ ሽቶ ድብዴ።</char> <verse eid="LUK 7:46"/><verse number="47" style="v" sid="LUK 7:47"/><char style="wj">ከናፉ አን ስትን ህመ፤ ሰበቢ ጃለልሼ ጉዳ ተኤፍ ጩቡንሼ ባይኤን ሱን እሼፍ ዺፈሜረ። ከን ጥኖን ዺፈሜፍ ገሩ ጃለልሳ ጥኖዸ።”</char><verse eid="LUK 7:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 7:48"/>ዬሱስስ ዱበርትቲዻን፣ <char style="wj">“ጩቡንኬ ሲፍ ዺፈሜረ”</char> ጄዼ።<verse eid="LUK 7:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 7:49"/>ወር እሰ ወጅን ማዲት ዽኣተኒ ቱረንስ፣ “ነምን ጩቡዩ ነማ ዺሱ ኩን ኤኙ?” ጄዸኒ ገራሳኒት ያዱ ጀልቀበን።<verse eid="LUK 7:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 7:50"/>ዬሱስስ ዱበርትቲዻን፣ <char style="wj">“አመንቲንኬ ስፈይሴረ፤ ነጋን ዴም”</char> ጄዼ።<verse eid="LUK 7:50"/></para>
  <chapter eid="LUK 7"/>
  <chapter number="8" style="c" sid="LUK 8"/>
  <para style="s1">ፈኬኘ ነምቸ ሰኚ ፈጫሱ</para>
  <para style="r">
    <ref loc="LUK 8:4-15">8፥4‑15</ref> ኩወፈ – <char style="xt"><ref loc="MAT 13:2-23">ማቴ 13፥2‑23</ref>፤ <ref loc="MRK 4:1-20">ማር 4፥1‑20</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 8:1"/>ዬሱስስ ኤርገሲ ወንጌለ ሞቱማ ዋቃ ለለባ መጋላ ቶኮራ ገረ መጋላ ብራት፣ ገንደ ቶኮራስ ገረ ገንደ ብራት ናነኣ ቱሬ። ወር ኩዸ ለማንስ እሰ ወጅን ቱረን፤ <verse eid="LUK 8:1"/><verse number="2" style="v" sid="LUK 8:2"/>ዱበርቶትን ሀፉሮተ ሀሞፊ ዽቤራ ፈይፈመን ቶኮ ቶኮስ እሰ ወጅን ቱረን፤ እሳንስ ማርያም እሼ መግደላ ከን ሀፉሮትን ሀሞን ቶርበ እሼ ኬሳ በአን፣ <verse eid="LUK 8:2"/><verse number="3" style="v" sid="LUK 8:3"/>ዮሃና ኒቲ ኩዛ እሰ ኤግዱ መነ ሄሮድስ ቱሬ፣ ሶስናፊ ዱበርቶተ ብራ ባይኤ ቱረን። ዱበርቶትን ኩኔንስ ዋን ቀበኒን ዬሱሲፊ በረቶተሳ ተጃጅላ ቱረን።<verse eid="LUK 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 8:4"/>ዬሮ ቱትን ጉዳን ወልት ቀበሜ ነሞትንስ መጋላ ገረ ገራቲ ገረሳ ዹፈንት ዬሱስ አከነ ጄዼ ፈኬኘ ከነ እሳንት ህሜ፦ <verse eid="LUK 8:4"/><verse number="5" style="v" sid="LUK 8:5"/><char style="wj">“ነምች ሰኚ ፈጫሱ ቶኮ ሰኚ ፈጫፈቹ በኤ። ኡቱ እን ፈጫሳ ጅሩስ ሰኚን ቶኮ ቶኮ ከራረ ቡኤ እረ ኤጄተሜ፤ ስምብሮትንስ ኛተኒ ፍጠን።</char> <verse eid="LUK 8:5"/><verse number="6" style="v" sid="LUK 8:6"/><char style="wj">ካንሞ ለፈ ከታረ ቡኤ፤ እንስ ዋን ጂዸ ህንቀብኔፍ ዬሮ ብቅሌት ንጎጌ።</char> <verse eid="LUK 8:6"/><verse number="7" style="v" sid="LUK 8:7"/><char style="wj">ሰኚን ብራስ ቆራቲ ኬሰ ቡኤ፤ ቆራቲን ሱንስ ብቅልቱ ሰነ ወጅን ጉደቴ እሰ ሁዼ።</char> <verse eid="LUK 8:7"/><verse number="8" style="v" sid="LUK 8:8"/><char style="wj">አመስ ሰኚን ካን ብዮ ጋሪረ ቡኤ። ንብቅሌ፤ እጀስ ደቻ ዽበ ነቀቴ።”</char></para>
  <para style="p" vid="LUK 8:8">እንስ ዮሙ ዋን ከነ ዱበቴት ለለቤ፣ <char style="wj">“ነምን ጉረ ዸገኡ ቀቡ ሃዸገኡ”</char> ጄዼ።<verse eid="LUK 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 8:9"/>በረቶትንሳስ ሂካን ፈኬኘ ከና ማል አከ ተኤ እሰ ጋፈተን። <verse eid="LUK 8:9"/><verse number="10" style="v" sid="LUK 8:10"/>እንስ አከነ ጄዼ፤ <char style="wj">“እጪቲ ሞቱማ ዋቃ ቤኩን እስኒ ኬነሜረ፤ ወረ ካንት ገሩ አን ፈኬኛን ነንዱበዸ፤ ኩንስ፣</char></para>
  <para style="q1" vid="LUK 8:10">
    <char style="wj">“ ‘አከ እሳን ኡቱመ እላለኑ ህንአርግኔፍ፣</char></para>
  <para style="q2" vid="LUK 8:10">
    <char style="wj">ኡቱመ ዸገአኑስ፣ ህንሁበትኔፍ።’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">8፥10 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="ISA 6:9">እሳ 6፥9</ref>
        </char>
      </char>
    </note><verse eid="LUK 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 8:11"/>
    <char style="wj">“ሂካን ፈኬኝቻ ከናዸ፦ ሰኚን ሱን ዱቢ ዋቃት።</char> <verse eid="LUK 8:11"/><verse number="12" style="v" sid="LUK 8:12"/><char style="wj">ሰኚን ከራራ ሱን ነሞተ ዱብቸ ዸገአኒ ገሩ አከ እሳን አመነኒ ህንፈይኔፍ ዲያብሎስ ዹፌ ዱብቸ ገራሳኒ ኬሳ ፉዸቱዸ።</char> <verse eid="LUK 8:12"/><verse number="13" style="v" sid="LUK 8:13"/><char style="wj">ሰኚን ለፈ ከታራ ሱንስ ወረ ዮሙ ዱብቸ ዸገአንት ገመቹዻን ፉዸተኒዸ፤ እሳን ገሩ ህደ ህንቀበን። ዬሮፍ አመኑ መሌ ዬሮ ቆሩምሳት ንገኑ።</char> <verse eid="LUK 8:13"/><verse number="14" style="v" sid="LUK 8:14"/><char style="wj">ሰኚን ቆራቲ ኬሰ ቡኤስ ወረ ዱብቸ ዸገአኒዸ፤ እሳንስ አኩመ ከራሳኒ እት ፉፈኒን ያዶ ጅሬኛቲን፣ በዻዹማፊ ቀነኒዻን ሁዸሙ፤ ህንብልቻተንስ።</char> <verse eid="LUK 8:14"/><verse number="15" style="v" sid="LUK 8:15"/><char style="wj">ሰኚን ብዮ ጋሪራ ገሩ ወረ ገራ ቶላፊ ጋሪዻን ዱብቸ ዸገአኒ ጀቤሰኒ ቀበተኒ ኦብሳን እጀ ነቀተን አርግሲሰ።</char><verse eid="LUK 8:15"/></para>
  <para style="s1">እብሳፊ ባቱሳ</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 8:16"/>
    <char style="wj">“ነምን ከምዩ እብሳ ቀብሲሴ ኦኮቴ ኬሰ ህንዾክሱ ዮካን ስሬ ጀለ ህንካኡ። ቆደ ከና አከ ወር ኦል ሴነን እፈ አርጉ ደንደአኒፍ ባቱ እብሳረ ካኡ።</char> <verse eid="LUK 8:16"/><verse number="17" style="v" sid="LUK 8:17"/><char style="wj">ወን ዾክፈሜ ኡቱ ህንሙልእፈምን ሀፉ፣ ወን ሀጉገሜ ኡቱ ህንቤከምን ሀፉ ዮካን ኡቱ እፈት ህንባፈምን ሀፉ ቶኮዩ ህንጅሩቲ።</char> <verse eid="LUK 8:17"/><verse number="18" style="v" sid="LUK 8:18"/><char style="wj">ከናፍ አከምት አከ ዸጌፈተን ቀልቤፈዻ። ከን ቀቡ ከሚፍዩ እት ደበለሜ ንኬነመ፤ ከን ህንቀብኔ ከምዩ ገሩ ወን እን ዋን ቀቡ ኦፍ ሴኡዩ እሰራ ፉዸተመ።”</char><verse eid="LUK 8:18"/></para>
  <para style="s1">ሃዸ ዬሱሲፊ ኦቦሎተሳ</para>
  <para style="r">
    <ref loc="LUK 8:19-21">8፥19‑21</ref> ኩወፈ – <char style="xt"><ref loc="MAT 12:46-50">ማቴ 12፥46‑50</ref>፤ <ref loc="MRK 3:31-35">ማር 3፥31‑35</ref></char></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 8:19"/>ሃቲፊ ኦቦሎትን ዬሱስ እሰ አርጉ ዹፈን፤ ገሩ ሰበቢ ባይእነ ነማቲፍ እሰ ብረ ገኡ ህንደንዴኜ። <verse eid="LUK 8:19"/><verse number="20" style="v" sid="LUK 8:20"/>ነምን ቶኮስ፣ “ሃትኬቲፊ ኦቦሎትንኬ ስ አርጉ በርባደኒ አለ ዸዻበተኒ ጅሩ” ጄዼ እሰት ህሜ።<verse eid="LUK 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 8:21"/>እንስ፣ <char style="wj">“ሃትኮፊ ኦቦሎትንኮ ወረ ዱቢ ዋቃ ዸገአኒ ሆጂረ ኦልቸኒዸ”</char> ጄዼ ዴብሴ።<verse eid="LUK 8:21"/></para>
  <para style="s1">ዬሱስ ቡቤ ገብ ጎቹሳ</para>
  <para style="r">
    <ref loc="LUK 8:22-25">8፥22‑25</ref> ኩወፈ – <char style="xt"><ref loc="MAT 8:23-27">ማቴ 8፥23‑27</ref>፤ <ref loc="MRK 4:36-41">ማር 4፥36‑41</ref></char></para>
  <para style="r">
    <ref loc="LUK 8:22-25">8፥22‑25</ref> ኩወእ – <char style="xt"><ref loc="MRK 6:47-52">ማር 6፥47‑52</ref>፤ <ref loc="JHN 6:16-21">ዮሀ 6፥16‑21</ref></char></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 8:22"/>ጋፍ ቶኮ ዬሱስ በረቶተሳቲን፣ <char style="wj">“ኮታ ገላነ ገመ ጬና”</char> ጄዼ። ከናፉ እሳን ብድሩ ያበተኒ ቀጄለን። <verse eid="LUK 8:22"/><verse number="23" style="v" sid="LUK 8:23"/>እን ኡቱ እሳን ብድሩዻን ዴማ ጅረኑ ህርብን ቀቤ ረፌ። ቡቤን ቶኮስ ገላነ ሰነረት ከኤ፣ ብድሩን ሱን ብሻኒን ጉተሙ ጀልቀቤ፤ እሳንስ በላ ጉዳ ኬሰ ሴነን።<verse eid="LUK 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 8:24"/>በረቶትንስ ዸቀኒ፣ “ያ ጎፍታ፣ ያ ጎፍታ፣ ኑ ዹሙፍ ጅረ!” ጄዸኒ እሰ ደመቅሰን።</para>
  <para style="p" vid="LUK 8:24">እንስ ከኤ ቡቤፊ ብሻን ራፈማ ቱሬ ሰነ እፈቴ፤ ቡቤን ሱንስ ገብ ጄዼ፤ ወን ሁንድኑስ ንተስገባኤ። <verse eid="LUK 8:24"/><verse number="25" style="v" sid="LUK 8:25"/>በረቶተሳስ፣ <char style="wj">“አመንቲንኬሰን ኤሰ ጅረ?”</char> ጄዼ ጋፈቴ።</para>
  <para style="p" vid="LUK 8:25">እሳንስ ሶዳፊ ድንቅፈትናዻን፣ “ነምች ቡቤፊ ብሻንሌ አጀጁ ኩን ኤኙ? እሳንስ ንአጀጀሙፍ” ጄዸኒ ወል ጋፈተን።<verse eid="LUK 8:25"/></para>
  <para style="s1">ዬሱስ ሀፉረ ሀማ ባሱሳ</para>
  <para style="r">
    <ref loc="LUK 8:26-37">8፥26‑37</ref> ኩወፈ – <char style="xt"><ref loc="MAT 8:28-34">ማቴ 8፥28‑34</ref></char></para>
  <para style="r">
    <ref loc="LUK 8:26-39">8፥26‑39</ref> ኩወፈ – <char style="xt"><ref loc="MRK 5:1-20">ማር 5፥1‑20</ref></char></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 8:26"/>እሳንስ ገረ ብየ ጌርጌሴኖን እሼ ገላናን ገመ ፉሌ ገሊላት አርገምቱት ብድሩዻን ጬአን። <verse eid="LUK 8:26"/><verse number="27" style="v" sid="LUK 8:27"/>ዮሙ ዬሱስ ቀርቀረ ገላናት ቡኤትስ ነምች መጋላ ሰና ከን ሀፉረ ሀማዻን ቀበሜ ቱሬ ቶኮ እሰት ዹፌ። ነምች ኩን ዬሮ ዼራዻፍ ኡፈተ ህንኡፈቱ ቱሬ፤ አዋለ ግዱ ጅራተ መሌ መነ ኬሰ ህንጅራቱ ቱሬ። <verse eid="LUK 8:27"/><verse number="28" style="v" sid="LUK 8:28"/>እንስ ዮሙ ዬሱስን አርጌት እዬ ሚለሳረት ኩፌ፤ ሰገሌ ኦል ፉዸቴ እዬስ፣ “ያ ዬሱስ እልመ ዋቀ ዋን ሁንዳ ኦሊ፣ አት ማል ነራ በርባደ? አን ስን ከዸዸ፤ ነ ህንዽጵስን!” ጄዼ። <verse eid="LUK 8:28"/><verse number="29" style="v" sid="LUK 8:29"/>ዬሱስ አከ ሀፉር ጡራኣን ሱን ነምቸ ኬሳ በኡ አጀጄ ቱሬቲ። ሀፉር ሱንስ ዬሮ ባይኤ እት ከኣ ቱሬ፤ ነምች ሱን ዮ ሀርካፊ ሚልሳ ፎንጫን ህዸሜ ኤገማ ቱሬዩ፣ ህዻሳ ኦፍራ ኩኩቴ፣ ሀፉረ ሀማ ሰናን ገረ ለፈ ነምን ህንጅሬት ጌፈማ ቱሬ።<verse eid="LUK 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 8:30"/>ዬሱስስ፣ <char style="wj">“መቃንኬ ኤኙ?”</char> ጄዼ እሰ ጋፈቴ።</para>
  <para style="p" vid="LUK 8:30">እንስ ሰበቢ ሀፉሮትን ሀሞን ባይኤን እሰት ገለኒ ቱረኒፍ፣ “ሌጌዎን” ጄዼ ዴብሴ። <verse eid="LUK 8:30"/><verse number="31" style="v" sid="LUK 8:31"/>ሀፉሮትን ሀሞን ሱንስ አከ እን አከ እሳን ቅሌ ኬሰ ቡአን እሳን ህንአጀጅኔፍ ዬሱስን ከዸተን።<verse eid="LUK 8:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 8:32"/>ሆማን ቦዬ ጉዳንሳስ ጋረረ አች ዼዳ ቱሬ። ሀፉሮትን ሀሞን ሱንስ አከ እን አከ እሳን ቦዬወን ሰነት ገለኒፍ እሳኒ ኤየሙ ዬሱስን ከዸተን፤ እንስ ንኤየሜፍ። <verse eid="LUK 8:32"/><verse number="33" style="v" sid="LUK 8:33"/>ዮሙ ሀፉሮትን ሀሞን ሱን ነምቸ ኬሳ በአኒ ቦዬወንት ገለንት፣ ሆማን ሱን ኤዴደ ሀለያራ ገድ ፉርጉግፈሜ ገላነት ነምኤ ልቅምፈሜ።<verse eid="LUK 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 8:34"/>ወር ቦዬወን ትክሰን ሱንስ ዮሙ ዋን ተኤ ሰነ አርገንት፣ በቀተኒ መጋላፊ ባድያት ዋን ከነ ኦዴሰን፤ <verse eid="LUK 8:34"/><verse number="35" style="v" sid="LUK 8:35"/>ነሞትንስ ዋን ተኤ ሰነ እላሉ በአን። እሳንስ ዮሙ ገረ ዬሱስ ዹፈንት ነምቸ ሀፉሮትን ሀሞን ኬሳ በአን ሰነ ወያ ኡፈቴ፣ ቀልቢሳትስ ዴብኤ ሚለ ዬሱስ ጀለ ታኤ አርገን፤ ንሶዳተንስ። <verse eid="LUK 8:35"/><verse number="36" style="v" sid="LUK 8:36"/>ወር ዋን ከነ አርገኒ ቱረንስ ነምች ሀፉረ ሀማን ቀበሜ ሱን አከምት አከ ፈዬ ነሞተት ኦዴሰን። <verse eid="LUK 8:36"/><verse number="37" style="v" sid="LUK 8:37"/>ከነረት ነሞትን ብየ ጌርጌሴኖን ሁንድኑ ዋን ሶዳዻን ጉተመኒፍ አከ ዬሱስ እሳን ብራ ዴሙ እሰ ከዸተን። እንስ ብድሩ ያበቴ አቺ ዴሜ።<verse eid="LUK 8:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 8:38"/>ነምች ሀፉሮትን ሀሞን ኬሳ በአን ሱን ዬሱስ ወጅን ዴሙፍ እሰ ከዸቴ፤ ዬሱስ ገሩ አከነ ጄዼ ኦፍ ብራ እሰ ዴብሴ፤ <verse eid="LUK 8:38"/><verse number="39" style="v" sid="LUK 8:39"/><char style="wj">“መነኬት ዴብኢቲ ወን ዋቅን ሲፍ ጎዼ ሀመም ጉዳ አከ ተኤ ኦዴስ።”</char> ነምችስ ዸቄ ወን ዬሱስ እሳፍ ጎዼ ሀመም ጉዳ አከ ተኤ መጋላ ሰነ ሁንደ ኬሰት ኦዴሴ።<verse eid="LUK 8:39"/></para>
  <para style="s1">ሙጨቲ ዱቴፊ ዱበርቲ ዹኩብሰቴ</para>
  <para style="r">
    <ref loc="LUK 8:40-56">8፥40‑56</ref> ኩወፈ – <char style="xt"><ref loc="MAT 9:18-26">ማቴ 9፥18‑26</ref>፤ <ref loc="MRK 5:22-43">ማር 5፥22‑43</ref></char></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 8:40"/>ዮሙ ዬሱስ ዴብኤት ነሞትን ባይኤን እሰ ስመተን። ሁንድሳኒ እሰ ኤገቻ ቱረኒቲ። <verse eid="LUK 8:40"/><verse number="41" style="v" sid="LUK 8:41"/>ነምች ያኢሮስ ጄዸሙ፣ ቡልቻን መነ ሰገዳ ቶኮ ዹፌ ሚለ ዬሱስረት ኩፌ አከ እን መነሳ ዸቁ እሰ ከዸቴ፤ <verse eid="LUK 8:41"/><verse number="42" style="v" sid="LUK 8:42"/>ሰበቢንሳስ እንተልሳ ቶክቲን፣ ዱርብ ኡሙሪንሼ ገረ ወጋ ኩዸ ለማ ተኡ ቶኮ ዱኡ ጌሴ ቱርቴ።</para>
  <para style="p" vid="LUK 8:42">ኡቱ ዬሱስ ዴማ ጅሩ ነሞትን ቅጠ ሁንዳን ዺበኒ ሀፉረ እሰ ኩቱ ገአን። <verse eid="LUK 8:42"/><verse number="43" style="v" sid="LUK 8:43"/>ዱበርቲን ዺግንሼ ወጋ ኩዸ ለመ ዸንገለኣ ቱሬ ቶኮስ አች ቱርቴ፤ ገሩ ነምን ቶኮዩ እሼ ፈይሱ ህንደንዴኜ። <verse eid="LUK 8:43"/><verse number="44" style="v" sid="LUK 8:44"/>እሼንስ ዱግደሳ ዱባን ዹፍቴ ሀንዳረ ኡፈተሳ ቱቅጤ፤ ዺግንሼስ ዮሙሱመ ጭቴ።<verse eid="LUK 8:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 8:45"/>ዬሱስስ፣ <char style="wj">“ኤኙቱ ነ ቱቄ?”</char> ጄዼ ጋፈቴ።</para>
  <para style="p" vid="LUK 8:45">ዮሙ ሁንድሳኒ ሃለንት ጴጥሮስ፣ “ያ በርሲሳ ነሞትን ቱተአኒ ስዺባ ጅሩ” ጄዼ።<verse eid="LUK 8:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 8:46"/>ዬሱስ ገሩ፣ <char style="wj">“ነምን ወዪ ነ ቱቄረ፤ አን አከ ሁምን ነ ኬሳ በኤ ነንቤካ”</char> ጄዼ።<verse eid="LUK 8:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 8:47"/>ዱበርትቲንስ አከ ኡቱ ህንቤከምን ዴሙ ህንደንዴኜ ሁበትናን ሆለቻ ዹፍቴ ሚለሳረት ኩፍቴ። እሼንስ ማሊፍ አከ እሰ ቱቅጤፊ አከምትስ አከ ዮሙሱመ ፈይቴ ነሞተ ሰነ ሁንደ ዱረት ዱበቴ። <verse eid="LUK 8:47"/><verse number="48" style="v" sid="LUK 8:48"/>ከነረት እን፣ <char style="wj">“ያ እንተላ፣ አመንቲንኬ ስፈይሴረ። ነጋን ዴም”</char> ጄዼን።<verse eid="LUK 8:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 8:49"/>ኡቱ ዬሱስ ዱበቻ ጅሩስ ነምን ቶኮ መነ ያኢሮስ ቡልቻ መነ ሰገዳቲ ዹፌ፣ “እንተልኬ ዱቴርት፤ አት ስአች በርሲስቸ ህንረክስን” ጄዼ።<verse eid="LUK 8:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 8:50"/>ዬሱስ ገሩ ዮሙ ዸገኤት ያኢሮሲን፣ <char style="wj">“አመን መሌ ህንሶዳትን፤ እሼን ንፈይቲ”</char> ጄዼ።<verse eid="LUK 8:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 8:51"/>እን ዮሙ መነ ያኢሮስ ገኤት ጴጥሮስ፣ ዮሀንሲፊ ያቆብ አከሱመስ አባፊ ሃዸ እንተለቲ መሌ አከ ነምን ቶኮዩ እሰ ወጅን ኦል ሴኑ ህንኤየምኔ። <verse eid="LUK 8:51"/><verse number="52" style="v" sid="LUK 8:52"/>ከነረት ነሞትን ሁንድኑ እሼፍ ወዋቻ፣ ፋርሳስ ቱረን። ዬሱስ ገሩ፣ <char style="wj">“ህንቦእና፤ እሼን ንረፍት መሌ ህንዱኔቲ”</char> ጄዼ።<verse eid="LUK 8:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 8:53"/>እሳንሞ አከ እሼን ዱቴ ዋን ቤከኒፍ እሰት ኮልፈን። <verse eid="LUK 8:53"/><verse number="54" style="v" sid="LUK 8:54"/>እን ገሩ ሀርከሼ ቀቤ፣ <char style="wj">“እንተለኮ፣ ከእ!”</char> ጄዼ። <verse eid="LUK 8:54"/><verse number="55" style="v" sid="LUK 8:55"/>ሀፉርሼስ ንዴብኤ፤ እሼንስ ዮሙሱመ ካቴ ዻበቴ። ኤርገሲ ዬሱስ አከ እሳን ዋን እሼን ኛቱ እሼፍ ኬነን እሳንት ህሜ። <verse eid="LUK 8:55"/><verse number="56" style="v" sid="LUK 8:56"/>አባፊ ሃትሼስ ንድንቅፈተን፤ እን ገሩ አከ እሳን ዋን ተኤ ሰነ ነመ ቶኮትሌ ህንህምኔ እሳን አጀጄ።<verse eid="LUK 8:56"/></para>
  <chapter eid="LUK 8"/>
  <chapter number="9" style="c" sid="LUK 9"/>
  <para style="s1">ዬሱስ በረቶተ ኩዸ ለማን ኤርጉሳ</para>
  <para style="r">
    <ref loc="LUK 9:3-5">9፥3‑5</ref> ኩወፈ – <char style="xt"><ref loc="MAT 10:9-15">ማቴ 10፥9‑15</ref>፤ <ref loc="MRK 6:8-11">ማር 6፥8‑11</ref></char></para>
  <para style="r">
    <ref loc="LUK 9:7-9">9፥7‑9</ref> ኩወፈ – <char style="xt"><ref loc="MAT 14:1">ማቴ 14፥1</ref>፣<ref loc="MAT 14:2">2</ref>፤ <ref loc="MRK 6:14-16">ማር 6፥14‑16</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 9:1"/>ዬሱስ ወረ ኩዸ ለማን ወልት ዋሜ፣ አከ እሳን ሀፉሮተ ሀሞ ሁንደ ባሰኒፊ አከ ዽቤወን ፈይሰኒፍ ሁምናፊ ታይታ ኬኔፍ፤ <verse eid="LUK 9:1"/><verse number="2" style="v" sid="LUK 9:2"/>እን አከ እሳን ሞቱማ ዋቃ ለብሰኒፊ አከ ዹኩብሰቶተ ፈይሰኒፍ እሳን ኤርጌ። <verse eid="LUK 9:2"/><verse number="3" style="v" sid="LUK 9:3"/>አከነስ እሳኒን ጄዼ፤ <char style="wj">“አዴምሰኬሰኒፍ ዋን ቶኮሌ ጄቹንስ ኡሌ ዮካን ኮሮጆ ዮካን ቡዴነ ዮካን ማለቀ አከኑመስ ክታ ለመ ህንቀበትና።</char> <verse eid="LUK 9:3"/><verse number="4" style="v" sid="LUK 9:4"/><char style="wj">መነ ሴንተን ከምዩ ኬሰ ሀመ መጋላ ሰና ባተንት አቹመ ቱራ።</char> <verse eid="LUK 9:4"/><verse number="5" style="v" sid="LUK 9:5"/><char style="wj">ዮ ነሞትን እስን ስመቹ ባተን፣ መጋላሳኒቲ በኣቲ አከ ረጋ እሳንት ተኡፍ አዋረ ሚለኬሰኒ ዸዸአዻ።”</char> <verse eid="LUK 9:5"/><verse number="6" style="v" sid="LUK 9:6"/>እሳንስ አቺ በአኒ እዶ ሁንደት ወንጌለ ለለባ፣ ነሞተ ስ ፈይሳ ገንደ ቶኮራ ገረ ገንደ ካኒ ዴማ ቱረን።<verse eid="LUK 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 9:7"/>ሄሮድስ ቡልቻን ዋኤ ዋን ተኣ ቱሬ ሁንዳ ዸገኤ። እንስ ዋን ነሞትን ቶኮ ቶኮ ዮሀንስ ጩጳን ወረ ዱአን ኬሳ ካፈሜረ ጄቻ ቱረኒፍ፣ <verse eid="LUK 9:7"/><verse number="8" style="v" sid="LUK 9:8"/>ወር ካንስ ኤልያስ ሙልአቴረ ጄቻ ዋን ቱረኒፍ፣ ወር ካንሞ ራጆተ ዱሪ ኬሳ እን ቶኮ ዱኣ ከኤረ ጄቻ ዋን ቱረኒፍ አከ መሌ ቡርጃጀኤ። <verse eid="LUK 9:8"/><verse number="9" style="v" sid="LUK 9:9"/>ሄሮድስ ገሩ፣ “አን ዮሀንስን መታሳ ኩቴን ቱሬ። ዮስ ነምች አን ዋኤሳ ዋን አከና ዸገኡ ኩን ኤኙሬ?” ጄዼ። ዬሱስን አርጉፍስ ንሀወ ቱሬ።<verse eid="LUK 9:9"/></para>
  <para style="s1">ዬሱስ ነመ ኩመ ሸን ሶሩሳ</para>
  <para style="r">
    <ref loc="LUK 9:10-17">9፥10‑17</ref> ኩወፈ – <char style="xt"><ref loc="MAT 14:13-21">ማቴ 14፥13‑21</ref>፤ <ref loc="MRK 6:32-44">ማር 6፥32‑44</ref>፤ <ref loc="JHN 6:5-13">ዮሀ 6፥5‑13</ref></char></para>
  <para style="r">
    <ref loc="LUK 9:13-17">9፥13‑17</ref> ኩወእ – <char style="xt"><ref loc="2KI 4:42-44">2ሞቶ 4፥42‑44</ref></char></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 9:10"/>ኤርገሞትንስ ዮሙ ዴብአንት ዋን ሆጄተኒ ቱረን ዬሱስት ህመን። እንስ ኦፍት እሳን ፉዸቴ፤ እሳንስ ኦፉማን ገረ መጋላ ቤተ ሳይዳ ጄዸምቱ ዸቀን፤ <verse eid="LUK 9:10"/><verse number="11" style="v" sid="LUK 9:11"/>ነሞትን ባይኤን ገሩ ዋን ከነ ቤከኒ እሰ ዱካ ቡአን። እንስ እሳን ስመቴ ዋኤ ሞቱማ ዋቃ እሳንት ህሜ፤ ወረ ፈዩን እሳን በርባችሴስ ንፈይሴ።<verse eid="LUK 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 9:12"/>ገረ ገልገላት ወር ኩዸ ለማን ገረሳ ዹፈኒ፣ “ዋን ኑ አስ ገሞጂ ኬሰ ጅሩፍ፣ አከ ነሞትን ኩኔን ገረ ገንዶታቲፊ ባድያ ናኖ ከነ ጅረኒ ዸቀኒ ዋን ኛተኒፊ እዶ ቡልቲ በርባደተኒፍ እሳን ገድ ዺስ” ጄዸኒን።<verse eid="LUK 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 9:13"/>እንሞ፣ <char style="wj">“እስኑ ዋን እሳን ኛተን ኬናፊ”</char> ጄዼ ዴብሴ።</para>
  <para style="p" vid="LUK 9:13">እሳንስ፣ “ነመ ከነ ሁንዳፍ ኛተ ዮ ዸቅኔ ብትኔ መሌ ኑ ቡዴነ ሸኒፊ ቁርጡሚ ለመ ቆፈ ቀብነ” ጄዸኒ ዴብሰን። <verse eid="LUK 9:13"/><verse number="14" style="v" sid="LUK 9:14"/>ዺረ ገረ ኩመ ሸኒቱ አች ቱሬ።</para>
  <para style="p" vid="LUK 9:14">እን ገሩ በረቶተሳቲን፣ <char style="wj">“ገሬ ቶኮን ቶኮንሳ ገረ ነመ ሸንተመ ሸንተማ ቀቡን እሳን ቴስሳ”</char> ጄዼ። <verse eid="LUK 9:14"/><verse number="15" style="v" sid="LUK 9:15"/>በረቶትንስ አከሱመ ጎዸን፤ ነምን ሁንድስ ንታኤ። <verse eid="LUK 9:15"/><verse number="16" style="v" sid="LUK 9:16"/>እንስ ቡዴነ ሸነኒፊ ቁርጡሚ ለማን ፉዼ፣ ገረ ሰሚ ኦል እላሌ ገለተ ገልቼ ጨጨብሴ። ኤርገሲ አከ እሳን ነሞታፍ ዽኤሰኒፍ በረቶተት ኬኔ። <verse eid="LUK 9:16"/><verse number="17" style="v" sid="LUK 9:17"/>እሳን ሁንድ ኛተኒ ቁፈን፤ በረቶትንስ ሁራኣ ሀምብፈሜ ጉንዶ ኩዸ ለመ ጉቱ ወልት ቀበን።<verse eid="LUK 9:17"/></para>
  <para style="s1">ጴጥሮስ ኤኙማ ክርስቶስ ቤክስሴ</para>
  <para style="r">
    <ref loc="LUK 9:18-20">9፥18‑20</ref> ኩወፈ – <char style="xt"><ref loc="MAT 16:13-16">ማቴ 16፥13‑16</ref>፤ <ref loc="MRK 8:27-29">ማር 8፥27‑29</ref></char></para>
  <para style="r">
    <ref loc="LUK 9:22-27">9፥22‑27</ref> ኩወፈ – <char style="xt"><ref loc="MAT 16:21-28">ማቴ 16፥21‑28</ref>፤ <ref loc="MRK 8:31-9:1">ማር 8፥31–9፥1</ref></char></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 9:18"/>ጋፍ ቶኮ ዬሱስ ኮጳሳ ከዸትናረ ቱሬ፤ በረቶትንሳስ እሰ ወጅን ቱረን። እንስ፣ <char style="wj">“ነሞትን አናን ኤኙ ጄዹ?”</char> ጄዼ እሳን ጋፈቴ።<verse eid="LUK 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 9:19"/>እሳንስ፣ “ነሞትን ቶኮ ቶኮ እን ዮሀንስ ጩጳዸ ጄዹ፤ ወር ካን እን ኤልያስ ጄዹ፤ ካንሞ ራጆተ ዱሪ ኬሳ እሰ ቶኮቱ ዱኣ ከኤ ጄዹ” ጄዸኒ ዴብሰን።<verse eid="LUK 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 9:20"/>እንስ፣ <char style="wj">“እስንሆ? ኤኙ አናን ጄቱ?”</char> ጄዼ ጋፈቴ።</para>
  <para style="p" vid="LUK 9:20">ጴጥሮስስ፣ “አት ክርስቶስ ዋቃት” ጄዼ ዴብሴ።<verse eid="LUK 9:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 9:21"/>ዬሱስስ አከ እሳን ዋን ከነ ነመ ቶኮትሌ ህንህምኔፍ ጀቤሴ እሳን አኬከቺሴ። <verse eid="LUK 9:21"/><verse number="22" style="v" sid="LUK 9:22"/>እንስ፣ <char style="wj">“እልም ነማ ዋን ሄዱን ዽጰቹ፣ ማንጉዶታን፣ ሉቦተ ሀንገፎታፊ በርሲስቶተ ሴራቲን ቱፈተሙ፣ አጄፈሙፊ ጉያ ሰደፋትሞ ዱኣ ከኡ ቀበ”</char> ጄዼ።<verse eid="LUK 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 9:23"/>ኤርገሲ እን ሁንዱመሳኒቲን አከነ ጄዼ፤ <char style="wj">“ነምን ከምዩ ዮ ነ ፋነ ዹፉ በርባዴ፣ እን ኦፍ ሃገኑ፤ ፈኖሳ ጉዩመ ጉያን ባዸቴስ ነ ዱካ ሃቡኡ።</char> <verse eid="LUK 9:23"/><verse number="24" style="v" sid="LUK 9:24"/><char style="wj">ነምን ሉቡሳ ኦልፈቹ በርባዱ ከምዩ ሉቡሳ ንዸባቲ፤ ገሩ ነምን ናፍ ጄዼ ሉቡሳ ዸቡ ከምዩ ሉቡሳ ንኦልፈተ።</char> <verse eid="LUK 9:24"/><verse number="25" style="v" sid="LUK 9:25"/><char style="wj">ነምን ዮ አዱኛ ጉቱ አርገቴ ኦፊሳሞ ዸቤ ዮካን ዮ ገተሜ እን ቡኣ ማሊ አርገተ?</char> <verse eid="LUK 9:25"/><verse number="26" style="v" sid="LUK 9:26"/><char style="wj">ነመ አነቲፊ ዱቢኮት ቃነኡ ከምዩ እልም ነማ ዮሙ ኡልፍነሳቲን፣ ኡልፍነ አባቲፊ ኡልፍነ ኤርገሞተ ቁልቁሉቲን ዹፉት እሰት ንቃነአ።</char><verse eid="LUK 9:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 9:27"/>
    <char style="wj">“አን ዹጉመን እስንት ህመ፤ ወረ አስ ዸዻበቻ ጅረን ኬሳ ነሞትን ቶኮ ቶኮ ኡቱ ሞቱማ ዋቃ ህንአርግን ዱአ ህንዸንዸመን።”</char><verse eid="LUK 9:27"/></para>
  <para style="s1">ብፍት ዬሱስ ጌደረሙሳ</para>
  <para style="r">
    <ref loc="LUK 9:28-36">9፥28‑36</ref> ኩወፈ – <char style="xt"><ref loc="MAT 17:1-8">ማቴ 17፥1‑8</ref>፤ <ref loc="MRK 9:2-8">ማር 9፥2‑8</ref></char></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 9:28"/>ዬሱስ ኤርገ ዋን ከነ ዱበቴ ገረ ጉያ ሰዴቲ ቦዴ ጴጥሮስ፣ ዮሀንሲፊ ያቆብን ፉዸቴ ከዸትናዻፍ ቱሉ ቶኮት ኦል በኤ። <verse eid="LUK 9:28"/><verse number="29" style="v" sid="LUK 9:29"/>ኡቱ እን ከዸቻ ጅሩስ ብፍት ፉለሳ ጌደረሜ፤ ኡፈትንሳስ አዲ ጨለቅሱ ተኤ። <verse eid="LUK 9:29"/><verse number="30" style="v" sid="LUK 9:30"/>ኩኖ ነሞትን ለመ ጄቹንስ ሙሴፊ ኤልያስ፣ ኡልፍነ ጉዳዻን ሙልአተኒ ዬሱስ ወጅን ሃሰኣ ቱረን። <verse eid="LUK 9:30"/><verse number="31" style="v" sid="LUK 9:31"/>እሳንስ ኡልፍናን ሙልአተኒ ዋኤ አዱኛ ከነራ ዴሙሳ ከን እን ዬሩሳሌምት ራወቹፍ ጅሩ ሰና ዱዱበቻ ቱረን። <verse eid="LUK 9:31"/><verse number="32" style="v" sid="LUK 9:32"/>ጴጥሮሲፊ ወር እሰ ወጅን ቱረን ገሩ አከ መሌ ሙገን፤ ዬሮ ደመቀንትሞ ኡልፍነ ዬሱሲፊ ነሞተ ዬሱስ ወጅን ዸዻበቻ ቱረን ለማን አርገን። <verse eid="LUK 9:32"/><verse number="33" style="v" sid="LUK 9:33"/>ጴጥሮስስ አኩመ ነሞትን ሱን ዬሱስ ብራ ዴሙ ጀልቀበኒን፣ “ያ ጎፍታ፣ አስ ጅራቹን ኑፍ ጋሪዸ። ዳሲ ሰዲ ጄቹንስ ቶኮ ሲፍ፣ ቶኮ ሙሴፍ፣ ቶኮሞ ኤልያሲፍ ንእጃረ” ጄዼ። እን ዋን ዱበቱ ህንቤኩ ቱሬ።<verse eid="LUK 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 9:34"/>ኡቱመ እን ዱበቻ ጅሩ ዱሜስ ቶኮ ዹፌ እሳን ሀጉጌ፤ እሳንስ ዮሙ ዱሜሰ ሰነ ኬሰ ሴነንት ንሶዳተን። <verse eid="LUK 9:34"/><verse number="35" style="v" sid="LUK 9:35"/>ሰገሌን፣ “ኩን እልመኮ እሰ አን ፍለዼዸ፤ እስንስ እሰ ዸገኣ” ጄዹ ቶኮ ዱሜስቸ ኬሳ ዹፌ። <verse eid="LUK 9:35"/><verse number="36" style="v" sid="LUK 9:36"/>ዮሙ ሰገሌን ሱን ዱበቴት፣ ዬሱስ ኮጳሳ አርገሜ። በረቶትንስ ንጨልእሰን መሌ ዋን አርገን ኬሳ ቶኮሌ ዬሮ ሰነት ነመ ቶኮቱ ህንህምኔ።<verse eid="LUK 9:36"/></para>
  <para style="s1">ዬሱስ ጉርባ ቶኮ ፈይሴ</para>
  <para style="r">
    <ref loc="LUK 9:37-45">9፥37‑45</ref> ኩወፈ – <char style="xt"><ref loc="MAT 17:14-18">ማቴ 17፥14‑18</ref>፣<ref loc="MAT 17:22">22</ref>፣<ref loc="MAT 17:23">23</ref>፤ <ref loc="MRK 9:14-27">ማር 9፥14‑27</ref>፣<ref loc="MRK 9:30-32">30‑32</ref></char></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 9:37"/>ጉያ እት ኣኑ፣ ዮሙ እሳን ቱሉራ ገድ ቡአንት ነሞትን ባይኤን እሰት ዹፈን። <verse eid="LUK 9:37"/><verse number="38" style="v" sid="LUK 9:38"/>ነሞተ ሰነ ኬሳስ ነምች ቶኮ እዬ አከነ ጄዼ፤ “ያ በርሲሳ አከ አት እልመኮ ናፍ እላልቱ ስን ከዸዸ፤ እን አናፍ ሙጫ ቶክቻቲ። <verse eid="LUK 9:38"/><verse number="39" style="v" sid="LUK 9:39"/>ሀፉር ወዪ እት ከአ፤ ጉርብችስ አኩመ ተሳ እየ፤ ሀፉር ሱን ለፋን ዸኤ እሰ ዽዺተቺሰ። ጉርብችስ ሆመቸ አፋኒን ባሰ፤ ሀፉርች ደፌ እራ ህንገሉ፤ ዬሮ ሁንደስ እሰ ሚዸ። <verse eid="LUK 9:39"/><verse number="40" style="v" sid="LUK 9:40"/>አን አከ ሀፉረ ሰነ ባሰኒፍ በረቶተኬ ነንከዸዼ፤ እሳን ገሩ ህንደንዴኜ።”<verse eid="LUK 9:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 9:41"/>ዬሱስስ ዴብሴ፣ <char style="wj">“እስን ዸሎተ ህንአመኔፊ ጀልኣ ነ፤ አን ሀመ ዮሚት እስን ወጅን ጅራዸ? ሀመ ዮሚትስ እስኒ ኦብሰ?”</char> ጄዼ። ነምቻንስ፣ <char style="wj">“ሜ እልመኬ አስ ፍድ”</char> ጄዼ።<verse eid="LUK 9:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 9:42"/>ኡቱመ ጉርባን ሱን ገረ ዬሱስ ዹፋ ጅሩስ፣ ሀፉር ሀማን ሱን ለፋን ዸኤ እሰ ዽዺተቺሴ። ዬሱስ ገሩ ሀፉረ ጡራኣ ሰነ እፈቴ፤ ጉርብቸስ ፈይሴ አባሳቲፍ ኬኔ። <verse eid="LUK 9:42"/><verse number="43" style="v" sid="LUK 9:43"/>ሁንዱምትሳኒስ ሁምነ ዋቃ እሰ ጀባ ሰነ ንድንቅፈተን።</para>
  <para style="p" vid="LUK 9:43">ኡቱ ሁንድሳኒ ዋን ዬሱስ ሆጄቴ ሰነ ድንቅሲፈቻ ጅረኑ እን በረቶተሳቲን አከነ ጄዼ፤ <verse eid="LUK 9:43"/><verse number="44" style="v" sid="LUK 9:44"/><char style="wj">“ዋን አን እስንት ህሙፍ ጅሩ ኦፍ ኤገትናዻን ዸጌፈዻ፦ እልም ነማ ደበርፈሜ ሀርከ ነሞታት ንኬነመ።”</char> <verse eid="LUK 9:44"/><verse number="45" style="v" sid="LUK 9:45"/>እሳን ገሩ ዱቢ ከነ ህንሁበትኔ። አከ እሳኒፍ ህንገሌፍስ እሳን ጀላ ዾክፈሜ ቱሬ፤ እሳን ዋኤ ዋን ከና እሰ ጋፈቹስ ንሶዳተን።<verse eid="LUK 9:45"/></para>
  <para style="s1">ነምን ነመ ሁንደ ጫሉ ኤኙ?</para>
  <para style="r">
    <ref loc="LUK 9:46-48">9፥46‑48</ref> ኩወፈ – <char style="xt"><ref loc="MAT 18:1-5">ማቴ 18፥1‑5</ref></char></para>
  <para style="r">
    <ref loc="LUK 9:46-50">9፥46‑50</ref> ኩወፈ – <char style="xt"><ref loc="MRK 9:33-40">ማር 9፥33‑40</ref></char></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 9:46"/>እሳን ኬሳ ነምን ነመ ሁንዱማ ጫሉ ኤኙ አከ ተኤ በረቶተ ግዱት ወል ፈልሚን ከኤ። <verse eid="LUK 9:46"/><verse number="47" style="v" sid="LUK 9:47"/>ዬሱስስ ዋን እሳን ገራት ያደን ቤኬ ሙጫ ጥና ቶኮ ፍዴ ኦፍ ብረ ዻቤ፤ <verse eid="LUK 9:47"/><verse number="48" style="v" sid="LUK 9:48"/>አከነስ እሳኒን ጄዼ፤ <char style="wj">“ነምን ሙጫ ጥና ከነ መቃኮቲን ስመቱ ከምዩ ነ ስመተ፤ ነምን ነ ስመቱስ እሰ ነ ኤርጌ ሰነ ስመተ፤ ነምን እስን ሁንዳ ገድ ተኤ እን ሁንደ ጫላቲ።”</char><verse eid="LUK 9:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 9:49"/>ዮሀንስስ፣ “ያ በርሲሳ፣ ኑ ኡቱ ነምን ቶኮ መቃኬቲን ሀፉሮተ ሀሞ ባሱ አርግኔ ዋን እን ኑ ዱካ ህንቡኔፍ እሰ ዾውኔ” ጄዼ።<verse eid="LUK 9:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 9:50"/>ዬሱስ ገሩ፣ <char style="wj">“እሰ ህንዾውና፤ ነምን እስኒን ህንሞርምኔ ከምዩ ገረኬሰን ጅራቲ”</char> ጄዼ።<verse eid="LUK 9:50"/></para>
  <para style="s1">ሞርሚ ወረ ሰማርያ</para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 9:51"/>ዬሱስስ ዮሙ ዬሮን እን እት ገረ ሰሚት ኦል ፉዸተሙ ገኤት ዬሩሳሌም ዸቁፍ ህዸቴ ከኤ። <verse eid="LUK 9:51"/><verse number="52" style="v" sid="LUK 9:52"/>እንስ ኤርገሞተ ኦፍ ዱረ ኤርጌ፤ እሳንስ ዋን እሰ በርባችሱ ቆጴሱዻፍ ገንደ ሰማርያ ቶኮ ሴነን። <verse eid="LUK 9:52"/><verse number="53" style="v" sid="LUK 9:53"/>ነሞትን ናኖ ሰና ገሩ ሰበቢ እን ፉለሳ ዬሩሳሌምት ዴብፈቴ ዴማ ቱሬፍ እሰ ህንስመትኔ። <verse eid="LUK 9:53"/><verse number="54" style="v" sid="LUK 9:54"/>በረቶትንሳ ጄቹንስ ያቆቢፊ ዮሀንስ ዮሙ ዋን ከነ አርገንት፣ “ያ ጎፍታ፣ አከ እን እሳን በሌሱፍ፣ አከ ኑ ሰሚራ እብደ ገድ ዋምኑ በርባዳ?” ጄዸን። <verse eid="LUK 9:54"/><verse number="55" style="v" sid="LUK 9:55"/>ዬሱስ ገሩ ገረገሌ እሳን እፈቴ። <verse eid="LUK 9:55"/><verse number="56" style="v" sid="LUK 9:56"/>እሳንስ ደርበኒ ገንደ ብራ ዸቀን።<verse eid="LUK 9:56"/></para>
  <para style="s1">ዬሱስ ዱካ ቡኡን ገቲ ነመ ባስሰ</para>
  <para style="r">
    <ref loc="LUK 9:57-60">9፥57‑60</ref> ኩወፈ – <char style="xt"><ref loc="MAT 8:19-22">ማቴ 8፥19‑22</ref></char></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 9:57"/>ኡቱ እሳን ከራ ዴማ ጅረኑስ ነምች ቶኮ ዬሱሲን፣ “አን እዶ አት ዸቅጡ ሁንደት ስ ዱካ ነንቡአ” ጄዼ።<verse eid="LUK 9:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 9:58"/>ዬሱስስ ዴብሴ፣ <char style="wj">“ዋንጎትን ቦለ ቀቡ፤ ስምብሮትንስ መንኤ ቀቡ፤ እልም ነማ ገሩ እዶ እት መታሳ እርክፈቱሌ ህንቀቡ”</char> ጄዼ።<verse eid="LUK 9:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 9:59"/>ነመ ብራቲንስ፣ <char style="wj">“ነ ዱካ ቡእ!”</char> ጄዼ።</para>
  <para style="p" vid="LUK 9:59">ነምች ገሩ፣ “ያ ጎፍታ፣ ዱረ አከ አን ዸቄ አባኮ አዋለዹ ናፍ ኤየም” ጄዼ ዴብሴ።<verse eid="LUK 9:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 9:60"/>ዬሱስስ፣ <char style="wj">“ወር ዱአን ዱኣሳኒ ሃአዋለተን፤ አት ገሩ ዸቂቲ ሞቱማ ዋቃ ለለብ”</char> ጄዼን።<verse eid="LUK 9:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 9:61"/>አመስ ነምን ብራ፣ “ያ ጎፍታ፣ አንስ ስ ዱካ ነንቡአ፤ ገሩ ዱረ አከ አን ዸቄ ማቲኮት ነጋ ዻመዹ ናፍ ኤየም” ጄዼ።<verse eid="LUK 9:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="LUK 9:62"/>ዬሱስስ ዴብሴ፣ <char style="wj">“ነምን ሀርካን ሆርዳ ቀበቴ ኦፍ ዱበ እላሉ ከምዩ ሞቱማ ዋቃቲፍ ህንመሉ”</char> ጄዼ።<verse eid="LUK 9:62"/></para>
  <chapter eid="LUK 9"/>
  <chapter number="10" style="c" sid="LUK 10"/>
  <para style="s1">ዬሱስ ነመ ቶርባተሚ ለመ ኤርጉሳ</para>
  <para style="r">
    <ref loc="LUK 10:4-12">10፥4‑12</ref> ኩወፈ – <char style="xt"><ref loc="LUK 9:3-5">ሉቃ 9፥3‑5</ref></char></para>
  <para style="r">
    <ref loc="LUK 10:13-15">10፥13‑15</ref>፣<ref loc="LUK 10:21">21</ref>፣<ref loc="LUK 10:22">22</ref> ኩወፈ – <char style="xt"><ref loc="MAT 11:21-23">ማቴ 11፥21‑23</ref>፣<ref loc="MAT 11:25-27">25‑27</ref></char></para>
  <para style="r">
    <ref loc="LUK 10:23">10፥23</ref>፣<ref loc="LUK 10:24">24</ref> ኩወፈ – <char style="xt"><ref loc="MAT 13:16">ማቴ 13፥16</ref>፣<ref loc="MAT 13:17">17</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 10:1"/>ከነ ቦዴ ጎፍታን ነሞተ ብራ 72 ሙዴ ገረ መጋላወኒፊ ለፈ ኦፊ ዸቁፍ ቱሬ ሁንዳት ለመ ለማን ኦፍ ዱረ እሳን ኤርጌ። <verse eid="LUK 10:1"/><verse number="2" style="v" sid="LUK 10:2"/>አከነስ እሳኒን ጄዼ፤ <char style="wj">“ምዻን ወልት ቀበሙ ባይኤዸ፤ ሆጄቶትን ገሩ ሙራሰ። ከናፍ አከ ጎፍታን ምዻን ሰና ገረ ለፈ ቆቲሳ ምዻንሳት ሆጄቶተ ኤርጉፍ እሰ ከዸዻ።</char> <verse eid="LUK 10:2"/><verse number="3" style="v" sid="LUK 10:3"/><char style="wj">ዴማ! አን አከ እልሞሌ ሆላ ገረ ግዱ ዬዪት እስን ኤርገ።</char> <verse eid="LUK 10:3"/><verse number="4" style="v" sid="LUK 10:4"/><char style="wj">ቦርሳ ዮካን ኮሮጆ ዮካን ኮጴ ህንቀበትና፤ ከራረትስ ነመ ቶኮሌ ነጋ ህንጋፈትና።</char><verse eid="LUK 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 10:5"/>
    <char style="wj">“ዬሮ መነ ቶኮ ሴንተንት ዱርሳቲ፣ ‘ነጋን መነ ከናፍ ሃተኡ’ ጄዻ።</char> <verse eid="LUK 10:5"/><verse number="6" style="v" sid="LUK 10:6"/><char style="wj">ዮ ነምን ነጋ አች ጅራቴ፣ ነጋንኬሰን እሳፍ ተአ፤ ዮ ከና አቺ ነጋንኬሰን እስኒፍ ዴብአ።</char> <verse eid="LUK 10:6"/><verse number="7" style="v" sid="LUK 10:7"/><char style="wj">ዋን እሳን እስኒ ኬነን ሁንደ ኛቻ፣ ዹጋስ አቹመ ቱራ፤ ሆጄታፍ ምንዳሳ አርገቹን ንመላቲ። መና ገረ መናት ህንለብና።</char><verse eid="LUK 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 10:8"/>
    <char style="wj">“ዬሮ መጋላ ቶኮ ሴንተኒ ስመተምተንት ዋኑመ እስኒ ዽኣቴ ኛዻ።</char> <verse eid="LUK 10:8"/><verse number="9" style="v" sid="LUK 10:9"/><char style="wj">ዹኩብሰቶተ አች ጅረን ፈይሳቲ፣ ‘ሞቱማን ዋቃ እስንት ዽኣቴረ’ ጄዻ እሳንት ህማ።</char> <verse eid="LUK 10:9"/><verse number="10" style="v" sid="LUK 10:10"/><char style="wj">ዮ መጋላ ቶኮ ሴንተኒ እስን ስመቹ ባተን ገሩ ገረ ዳንዲ መጋላት በኣቲ አከነ ጄዻ፤</char> <verse eid="LUK 10:10"/><verse number="11" style="v" sid="LUK 10:11"/><char style="wj">‘ኑ አከ አኬከቺሰ እስኒ ተኡፍ አዋረ መጋላኬሰኒሌ ሚለኬኘራ ዸዸአትነ። ተኡስ ዋን ከነ ቤካ፦ ሞቱማን ዋቃ ዽኣቴረ።’</char> <verse eid="LUK 10:11"/><verse number="12" style="v" sid="LUK 10:12"/><char style="wj">አን እስንትን ህመ፤ ጋፈስ መጋላ ሰነረ ሶዶሚፍ ንሰልጰተ።</char><verse eid="LUK 10:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 10:13"/>
    <char style="wj">“ያ ኮራዝን ሲፍ ወዮ! ያ ቤተ ሳይዳ ሲፍ ወዮ! ሆጂን ድንቂ ከን እስን ኬሰት ሆጄተሜ ሱን ኡቱ ጢሮሲፊ ሲዶና ኬሰት ሆጄተሜ ጅራቴ እሳን ስላ ዬሮ ዼራን ዱረ ኡፈተ ገዳ ኡፈተኒ፣ ዳራ ኬሰስ ተታአኒ ቀልቢ ጅጂረቱ ቱረን።</char> <verse eid="LUK 10:13"/><verse number="14" style="v" sid="LUK 10:14"/><char style="wj">ገሩ ጉያ ሙርቲት እስንረ ጢሮሲፊ ሲዶናፍ ንሰልጰተ።</char> <verse eid="LUK 10:14"/><verse number="15" style="v" sid="LUK 10:15"/><char style="wj">አትስ ያ ቅፍርናሆም፣ ሀመ ሰሚት ኦል ካፈምታ? ለክ፣ ሲኦልት ገድ ቡተ።</char><verse eid="LUK 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 10:16"/>
    <char style="wj">“ነምን እስን ዸገኡ ከምዩ ነ ዸገአ፤ ነምን እስን ዸገኡ ድዱ አነስ ዸገኡ ድደ፤ ነምን ነ ዸገኡ ድዱሞ እሰ ነ ኤርጌ ሰነ ዸገኡ ድደ።”</char><verse eid="LUK 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 10:17"/>ነሞትን ቶርባተሚ ለማን ሱንስ ገመቹዻን ዴብአኒ፣ “ያ ጎፍታ፣ ሀፉሮትን ሀሞንዩ መቃኬቲን ኑ አጀጀመኒሩ” ጄዸን።<verse eid="LUK 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 10:18"/>ዬሱስስ ዴብሴ አከነ ጄዼ፤ <char style="wj">“አን ኡቱ ሴጠን አኩመ በለቄት ሰሚራ ቡኡ ነንአርጌ።</char> <verse eid="LUK 10:18"/><verse number="19" style="v" sid="LUK 10:19"/><char style="wj">ኩኖ፣ አን አከ እስን ቦፋፊ ቶርባንቀባ ለፈት ዽዺተኒፊ አከ ሁምነ ዲና ሁንደስ ሞአተኒፍ ኣንጎ እስኒ ኬኔረ፤ ወን ከምዩ እስን ህንሚዹ።</char> <verse eid="LUK 10:19"/><verse number="20" style="v" sid="LUK 10:20"/><char style="wj">ገሩ ሰበቢ መቃንኬሰን ሰሚ ኬሰት በሬፈሜፍ ገመዳ መሌ ሰበቢ ሀፉሮትን እስኒ አጀጀመኒፍ ህንገመድና።”</char><verse eid="LUK 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 10:21"/>ዬሱስ ዬሮ ሰነ ሀፉረ ቁልቁሉዻን ገመቹን ጉተሜ አከነ ጄዼ፤ <char style="wj">“ያ አባ፣ ጎፍታ ሰሚቲፊ ለፋ፣ ሰበቢ አት ወንቶተ ከኔን ኦጌዪፊ ሁበቶተ ጀላ ዾክስቴ ዳእመንት ሙልእፍቴፍ አን ስን ገለቴፈዸ። ኤዬ ያ አባ፣ አት ዋን ከነ ጎቹት ገመዴርታቲ።</char><verse eid="LUK 10:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 10:22"/>
    <char style="wj">“አባንኮ ዋን ሁንደ ደበርሴ ነት ኬኔረ። አባ መሌ ነምን ቶኮዩ እልም ኤኙ አከ ተኤ ህንቤኩ፤ እልማፊ ነመ እልም እሰ እት ሙልእሱ ፌዹ መሌ ነምን ቶኮዩ አባን ኤኙ አከ ተኤ ህንቤኩ።”</char><verse eid="LUK 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 10:23"/>በረቶተ እሳትስ ገረገሌ ኮጳት አከነ ጄዼን፤ <char style="wj">“እጅ ዋን እስን አርግተን አርጉ ኤብፈማዸ።</char> <verse eid="LUK 10:23"/><verse number="24" style="v" sid="LUK 10:24"/><char style="wj">አን እስንትን ህማቲ ራጆትኒፊ ሞቶትን ባይኤን ዋን እስን አርግተን ከነ አርጉ በርባደን፤ ገሩ ህንአርግኔ። ዋን እስን ዸጌሰን ከነስ ዸገኡ በርባደን፤ ገሩ ህንዸጌኜ።”</char><verse eid="LUK 10:24"/></para>
  <para style="s1">ፈኬኘ ነምቸ ሰማርያ ቶኮ</para>
  <para style="r">
    <ref loc="LUK 10:25-28">10፥25‑28</ref> ኩወፈ – <char style="xt"><ref loc="MAT 22:34-40">ማቴ 22፥34‑40</ref>፤ <ref loc="MRK 12:28-31">ማር 12፥28‑31</ref></char></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 10:25"/>ጋፍ ቶኮ፣ ሀዩን ሴራ ቶኮ ዬሱስን ቆሩፍ ጄዼ ከኤ ዻበቴ። እንስ፣ “ያ በርሲሳ፣ አን ጅሬኘ በረ በራ ዻሉዻፍ ማል ጎቹን ቀበ?” ጄዼ ጋፈቴ።<verse eid="LUK 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 10:26"/>ዬሱስስ ዴብሴ፣ <char style="wj">“ሴረ ኬሰት ማልቱ በሬፈሜ? አትስ አከምት ዱብፍተ?”</char> ጄዼን።<verse eid="LUK 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 10:27"/>ነምችስ፣ “ ‘ዋቀኬ ጎፍትቸ ገራኬ ጉቱዻን፣ ሉቡኬ ጉቱዻን፣ ሁምነኬ ጉቱዻን፣ ያደኬ ጉቱዻን ጃለዹ፤<note caller="+" style="f"><char style="fr" closed="false">10፥27 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 6:5">ኬዴ 6፥5</ref></char></char></note> ኦላኬስ አኩመ ኦፊኬቲት ጃለዹ’<note caller="+" style="f"><char style="fr" closed="false">10፥27 </char><char style="ft" closed="false"><char style="xt"><ref loc="LEV 19:18">ሌዎ 19፥18</ref></char></char></note>” ጄዼ ዴብሴ።<verse eid="LUK 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 10:28"/>ዬሱስስ፣ <char style="wj">“ስሪት ዴብፍቴርተ፤ አትስ ከኑመ ጎዽ ንጅራታ”</char> ጄዼን።<verse eid="LUK 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 10:29"/>ነምች ሱን ገሩ ቀጄላ ኦፍ ጎቹ በርባዴ፣ “ኦላንኮ ኤኙ?” ጄዼ ዬሱስን ጋፈቴ።<verse eid="LUK 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 10:30"/>ዬሱስስ ዴብሴ አከነ ጄዼ፤ <char style="wj">“ነምች ቶኮ ኡቱ ዬሩሳሌሚ በኤ ዬርኮት ገድ ቡኣ ጅሩ ሀርከ ሳምቶታ ሴኔ። እሳንስ ኡፈተሳ እራ ባፈተኒ፣ ቱመኒ፣ ዱኣፊ ጅሬኘ ግዱት እሰ ዺሰኒ ዴመን።</char> <verse eid="LUK 10:30"/><verse number="31" style="v" sid="LUK 10:31"/><char style="wj">ሉብን ቶኮ ኡቱ አኩመ ተሳ ከራ ሰናን ገድ ቡኡ ነምቸ አርጌ እራ ጎሬ ደርቤ።</char> <verse eid="LUK 10:31"/><verse number="32" style="v" sid="LUK 10:32"/><char style="wj">አከሱመስ ነምች ጎሰ ሌዊ ቶኮ ዮሙ እዶ ሰነ ገኤት ነምቸ ሰነ አርጌ እራ ጎሬ ደርቤ።</char> <verse eid="LUK 10:32"/><verse number="33" style="v" sid="LUK 10:33"/><char style="wj">ነምች ሰማርያ ቶኮ ገሩ ኡቱ ዴማ ጅሩ እዶ ነምች ሱን ጅሩ ገኤ፤ ዮሙ እሰ አርጌትስ ገራ ላፌፍ።</char> <verse eid="LUK 10:33"/><verse number="34" style="v" sid="LUK 10:34"/><char style="wj">እንስ እት ዽኣቴ ዘይቲፊ ዳዺ ወይኒ መዳሳት ነቄ ህዼፍ፤ ሀሬሳረስ ካኤ፣ መነ ቦቆና ኬሱሞታት እሰ ጌሴ፤ አችትስ እሰ ገርጋሬ።</char> <verse eid="LUK 10:34"/><verse number="35" style="v" sid="LUK 10:35"/><char style="wj">ጉያ እት ኣኑት ዲናሪ ለመ ባሴ አባ መነ ቦቆና ሰናት ኬኔ፣ ‘ነምቸ ከነ እቲን ናፍ ወልኣን፤ ዮ ከነ ጫላ ባፍቴስ አን ዬሮን ዴብኤ ዹፉት ሲፍን ኬነ’ ጄዼን።</char><verse eid="LUK 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 10:36"/>
    <char style="wj">“ኤጋ ጀረ ሰደን ከኔን ኬሳ ኦላን ነምቸ ሀርከ ሳምቶታ ሴኔ ሰና እሰ ከም ሴተ?”</char><verse eid="LUK 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 10:37"/>ሀዩን ሴራ ሱንስ፣ “እሰ ገራ ላፌፍ ሰነ” ጄዼን።</para>
  <para style="p" vid="LUK 10:37">ዬሱስስ፣ <char style="wj">“አትስ ዸቂቲ አከሱመ ጎዽ”</char> ጄዼን።<verse eid="LUK 10:37"/></para>
  <para style="s1">ዬሱስ መነ ማርታቲፊ ማርያም ዸቁሳ</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 10:38"/>ኡቱ ከራ ዴማ ጅረኑ ዬሱስ ገንደ ቶኮ ሴኔ፤ ዱበርቲን ማርታ ጄዸምቱ ቶኮስ መነሼት እሰ ስመቴ። <verse eid="LUK 10:38"/><verse number="39" style="v" sid="LUK 10:39"/>እሼንስ ኦቦሌቲ ማርያም ጄዸምቱ ቶኮ ቀብድ ቱርቴ፤ ማርያምስ ሚለ ጎፍታ ጀለ ቴሴ ዋን እን ጄዹ ዸጌፈቻ ቱርቴ። <verse eid="LUK 10:39"/><verse number="40" style="v" sid="LUK 10:40"/>ማርታን ገሩ ባይእነ ሆጂቲን ዋን ደዸባ ቱርቴፍ ገረሳ ዹፍቴ፣ “ያ ጎፍታ፣ ኦቦሌቲንኮ አከ አን ሆጂ ሁንደ ኮጳኮ ሆጄዹ ነት ዺሱንሼ ስ ህንገድሲሱ? አከ እሼን ነ ገርጋርቱ እት ህም!” ጄቴ።<verse eid="LUK 10:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 10:41"/>ጎፍታንስ ዴብሴ አከነ ጄዼን፤ <char style="wj">“ያ ማርታ፣ ያ ማርታ፣ አት ዋኤ ዋን ባይኤ ያዶፍተ፤ ንራፈምተስ።</char> <verse eid="LUK 10:41"/><verse number="42" style="v" sid="LUK 10:42"/><char style="wj">ወን በርባችሱ ገሩ ዋኑመ ቶኮ ቆፈ፤ ማርያም እሰ ጫሉ ፍለቴርት፤ እንስ እሼራ ህንፉዸተሙ።”</char><verse eid="LUK 10:42"/></para>
  <chapter eid="LUK 10"/>
  <chapter number="11" style="c" sid="LUK 11"/>
  <para style="s1">ዬሱስ ዋኤ ከዸትና በርሲሱሳ</para>
  <para style="r">
    <ref loc="LUK 11:2-4">11፥2‑4</ref> ኩወፈ – <char style="xt"><ref loc="MAT 6:9-13">ማቴ 6፥9‑13</ref></char></para>
  <para style="r">
    <ref loc="LUK 11:9-13">11፥9‑13</ref> ኩወፈ – <char style="xt"><ref loc="MAT 7:7-11">ማቴ 7፥7‑11</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 11:1"/>ጋፍ ቶኮ ዬሱስ እዶ ቶኮት ከዸቻ ቱሬ፤ ዮሙ እን ፍጠቴትስ፣ በረቶተሳ ኬሳ ነምን ቶኮ፣ “ያ በርሲሳ፣ አኩመ ዮሀንስ በረቶተሳ በርሲሴ ሰነ፣ አትስ ከዸቹ ኑ በርሲስ” ጄዼን።<verse eid="LUK 11:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 11:2"/>እንስ አከነ እሳኒን ጄዼ፤ <char style="wj">“እስን ዮሙ ከዸተን አከነ ጄዻ፦</char></para>
  <para style="q1" vid="LUK 11:2">
    <char style="wj">“ ‘ያ አባ፣</char></para>
  <para style="q1" vid="LUK 11:2">
    <char style="wj">መቃንኬ ሃቁልቁላኡ፤</char></para>
  <para style="q1" vid="LUK 11:2">
    <char style="wj">ሞቱማንኬ ሃዹፉ።</char><verse eid="LUK 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LUK 11:3"/>
    <char style="wj">ቡዴነኬኘ ከን ጉዩመ ጉያ፣ <optbreak/> ጉዩመ ጉያን ኑ ኬን።</char><verse eid="LUK 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LUK 11:4"/>
    <char style="wj">አኩመ ኑስ ወረ ጩቡ ኑት ሆጄተኒፍ ዺፍኑ ሰነ</char></para>
  <para style="q2" vid="LUK 11:4">
    <char style="wj">አትስ ጩቡኬኘ ኑ ዺስ፤</char></para>
  <para style="q2" vid="LUK 11:4">
    <char style="wj">ቆረመት ኑ ህንገልችን።’ ”</char><verse eid="LUK 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 11:5"/>እንስ አከነ እሳኒን ጄዼ፤ <char style="wj">“ሜ እስን ኬሳ ነምን ቶኮ ምቹ ቀበ ሃጄኑ፤ እንስ ሀልከን ወለካ ምቹሳ ሰነ ብረ ዸቄ፣ ‘ያ ምቹኮ፣ ሜ ቡዴነ ሰዲ ና ልቄስ፤</char> <verse eid="LUK 11:5"/><verse number="6" style="v" sid="LUK 11:6"/><char style="wj">ምቹንኮ ከን ከራ ዴሙ ቶኮ ነት ጎሬራቲ፤ አንስ ዋነን ዽኤሱፍ ቶኮሌ ህንቀቡ’ ሃጄዹ።</char> <verse eid="LUK 11:6"/><verse number="7" style="v" sid="LUK 11:7"/><char style="wj">ነምች መነ ኬሳ ሱንስ፣ ‘ነ ህንረክስን፤ በልበል ጩፈሜረ፤ እጆሌንኮስ ነ ወጅን ስሬረ ጅሩ፤ አን ከኤ ዋን ቶኮሌ ሲፍ ኬኑ ህንደንደኡ’ ጄዻኒ?</char> <verse eid="LUK 11:7"/><verse number="8" style="v" sid="LUK 11:8"/><char style="wj">አን እስንትን ህመ፤ ሰበቢ እን ምቹሳ ተኤፍ ጄዼ ከኤ ቡዴነ ሰነ እሳፍ ኬኑ ባቱሌ፣ ሰበቢ እጀ ጀብነ ነምቸ ሰናቲፍ ጄዼ ከኤ ዋን እሰ በርባችሱ ሁንደ ንኬናፍ።</char><verse eid="LUK 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 11:9"/>
    <char style="wj">“ከናፉ አን እስንትን ህመ፦ ከዸዻ፣ እስኒፍ ንኬነማ፤ በርባዳ፣ ንአርገቱ፤ ሩሩኩታ፣ በልበል እስኒፍ ንበነማ።</char> <verse eid="LUK 11:9"/><verse number="10" style="v" sid="LUK 11:10"/><char style="wj">ነምን ከዸቱ ሁንድ ንአርገታቲ፤ ነምን በርባዱ ንአርገተ፤ ነመ ሩሩኩቱፍስ በልበል ንበነመ።</char><verse eid="LUK 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 11:11"/>
    <char style="wj">“ያ አቦቲ፣ እስን ኬሳ ነምን ዮ እልምሳ ቁርጡሚ እሰ ከዸቴ፣ ቆደ ቁርጡሚ ቦፈ ኬኑፍ ኤኙ?</char> <verse eid="LUK 11:11"/><verse number="12" style="v" sid="LUK 11:12"/><char style="wj">ዮካን ነምን ዮ እልምሳ ሀንቃቁ እሰ ከዸቴ ቶርባንቀባ ኬኑፍ ኤኙ?</char> <verse eid="LUK 11:12"/><verse number="13" style="v" sid="LUK 11:13"/><char style="wj">ኤርገ እስን ወር ሀሞንዩ ኬና ጋሪ እጆሌኬሰኒፍ ኬኑ ቤክተኒ፣ አባንኬሰን እን ሰሚራሞ ሀመም ጫልችሴ ወረ እሰ ከዸተኒፍ ሀፉረ ቁልቁሉ ሃኬኑሬ!”</char><verse eid="LUK 11:13"/></para>
  <para style="s1">ዬሱሲፊ ብኤልዜቡል</para>
  <para style="r">
    <ref loc="LUK 11:14">11፥14</ref>፣<ref loc="LUK 11:15">15</ref>፣<ref loc="LUK 11:17-22">17‑22</ref>፣<ref loc="LUK 11:24-26">24‑26</ref> ኩወፈ – <char style="xt"><ref loc="MAT 12:22">ማቴ 12፥22</ref>፣<ref loc="MAT 12:24-29">24‑29</ref>፣<ref loc="MAT 12:43-45">43‑45</ref></char></para>
  <para style="r">
    <ref loc="LUK 11:17-22">11፥17‑22</ref> ኩወፈ – <char style="xt"><ref loc="MRK 3:23-27">ማር 3፥23‑27</ref></char></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 11:14"/>ዬሱስስ ሀፉረ ሀማ አረብ-ድዳ ተኤ ቶኮ ባሳ ቱሬ። ዮሙ ሀፉር ሀማን ሱን በኤት አረብ-ድዳን ሱን ንዱበቴ፤ ነሞትንስ ንድንቅፈተን። <verse eid="LUK 11:14"/><verse number="15" style="v" sid="LUK 11:15"/>እሳን ኬሳ ነሞትን ቶኮ ቶኮ ገሩ፣ “እን ብኤልዜቡሊን፣ ሀንገፈ ሀፉሮተ ሀሞቲን ሀፉሮተ ሀሞ ባሳ ጅረ” ጄዸን። <verse eid="LUK 11:15"/><verse number="16" style="v" sid="LUK 11:16"/>ወር ካንሞ መለቶ ሰሚራ እሰ ጋፈቹዻን እሰ ቆረን።<verse eid="LUK 11:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 11:17"/>ዬሱስስ ያደሳኒ ቤኬ አከነ ጄዼን፤ <char style="wj">“ሞቱማን ገርገር ኦፍ ቆዱ ከምዩ ንዲገመ፤ መን ገርገር ኦፍ ቆዱስ ንጅገ።</char> <verse eid="LUK 11:17"/><verse number="18" style="v" sid="LUK 11:18"/><char style="wj">ሴጠን ዮ ገርገር ኦፍ ቆዴ፣ ሞቱማንሳ አከምት ዻበቹ ደንደአ? ወን አን አከነ ጄዹፍ ሰበቢ እስን አከ ዋን አን ብኤልዜቡሊን ሀፉሮተ ሀሞ ባሱ ዱበተኒፍ።</char> <verse eid="LUK 11:18"/><verse number="19" style="v" sid="LUK 11:19"/><char style="wj">ኤጋ ዮ አን ብኤልዜቡሊን ሀፉሮተ ሀሞ ባሴ፣ እልማንኬሰንሞ ማሊን ባሱሬ? ከናፉ እሳን አቦቲ ሙርቲ እስንት ተኡ።</char> <verse eid="LUK 11:19"/><verse number="20" style="v" sid="LUK 11:20"/><char style="wj">ገሩ አን ቁበ ዋቃቲን ሀፉሮተ ሀሞ ባሰ ታናን፣ ዮስ ሞቱማን ዋቃ እስንት ዹፌረ።</char><verse eid="LUK 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 11:21"/>
    <char style="wj">“ዮሙ ነምን ጀባን ጉቱማት ምአ ሎላ ህዸቴ ቶኮ መነሳ ኤገቱት፣ ቀቤኝሳ ነጋዻን ታኣፍ።</char> <verse eid="LUK 11:21"/><verse number="22" style="v" sid="LUK 11:22"/><char style="wj">ገሩ ነምን ጀብናን እሰ ጫሉ ቶኮ ዮ ሎሌ እሰ ሞአቴ፣ ምአ ሎላ ከን ነምች ሱን አመነቴ ሰነ እሰራ ፉዸቴ ቦጁሳስ ቆቆደ።</char><verse eid="LUK 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 11:23"/>
    <char style="wj">“ነምን ነ ወጅን ህንጅሬ ከምዩ ናን ሞርመ፤ ነምን ነ ወጅን ወልት ህንቀብኔ ከምዩስ ንብትኔሰ።</char><verse eid="LUK 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 11:24"/>
    <char style="wj">“ሀፉር ጡራኣን ዮሙ ነመ ኬሳ በኡት፣ ቦቆና በርባቸ ለፈ ጎጋ</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">11፥24 </char>
      <char style="ft" closed="false">ለፍት ጎጋን አከ ዋን ጅሬኘ ሀፉሮተ ሀሞቲፍ ምጃኣ ተኤት ሄሬገመ ቱሬ (<char style="xt"><ref loc="ISA 13:21-22">እሳ 13፥21‑22</ref>፤ <ref loc="ISA 34:14">34፥14</ref></char> እላላ)።</char>
    </note> <char style="wj">ኬሰ ጆረ፤ ገሩ ህንአርገቱ። እንስ፣ ‘መነኮ እሰ አን ኬሳ በኤ ሰነት ነንዴብአ’ ጄዸ።</char> <verse eid="LUK 11:24"/><verse number="25" style="v" sid="LUK 11:25"/><char style="wj">ዮሙ አች ገኡትስ መንቸ ሀረሜ ቁልቁሌፈሜ አርገተ።</char> <verse eid="LUK 11:25"/><verse number="26" style="v" sid="LUK 11:26"/><char style="wj">ኤርገሲስ ዸቄ ሀፉሮተ ብራ ቶርበ ከኔን እሰ ጫላ ሀሞ ተአን ፉዸቴ ዹፈ፤ እሳንስ እት ገለኒ አች ጅራቱ። ሃል ነምቸ ሰና ከን ዹማ እሰ ጀልቀባ ጫላ ሀማተ።”</char><verse eid="LUK 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 11:27"/>ኡቱ ዬሱስ ዋን ከነ ዱበቻ ጅሩ፣ ዱበርቲን ቶኮ ነሞተ ግዱዻ ሰገሌሼ ኦል ፉዸቴ፣ “ገራን ስባቴ፣ ሀርም አት ሆቴስ ኤብፈማዸ” ጄቴ።<verse eid="LUK 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 11:28"/>እን ገሩ ዴብሴ፣ <char style="wj">“ከነ ጫላዩ፣ ወር ዱቢ ዋቃ ዸገአኒ አጀጀመኒፍ ኤብፈሞዸ”</char> ጄዼ።<verse eid="LUK 11:28"/></para>
  <para style="s1">መለቶ ዮናስ</para>
  <para style="r">
    <ref loc="LUK 11:29-32">11፥29‑32</ref> ኩወፈ – <char style="xt"><ref loc="MAT 12:39-42">ማቴ 12፥39‑42</ref></char></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 11:29"/>አኩመ ባይእን ነሞታ ደበለሜን ዬሱስ አከነ ጄዼ፤ <char style="wj">“ዸሎትን ኩን ዸሎተ ሀማዸ። እን መለቶ በርባደ፤ ገሩ መለቶ ዮናስ መሌ መለቶን ቶኮዩ እሳፍ ህንኬነሙ።</char> <verse eid="LUK 11:29"/><verse number="30" style="v" sid="LUK 11:30"/><char style="wj">አኩመ ዮናስ መለቶ ሰበ ነነዌ ቱሬ ሰነ፣ እልም ነማስ መለቶ ዸሎተ ከና ንተኣቲ።</char> <verse eid="LUK 11:30"/><verse number="31" style="v" sid="LUK 11:31"/><char style="wj">ሞትቲን ክባ ጉያ ሙርቲት ነሞተ ዸሎተ ከና ወጅን ካቴ እሳንት ሙርት፤ እሼን ኦጉማ ሶሎሞን ዸገኡፍ ጄቴ ዳሪ ለፋቲ ዹፍቴቲ። ኩኖ ከን ሶሎሞንን ጫሉ አስ ጅረ።</char> <verse eid="LUK 11:31"/><verse number="32" style="v" sid="LUK 11:32"/><char style="wj">ነሞትን ነነዌ ጉያ ሙርቲት ዸሎተ ከነ ወጅን ከአኒ እት ሙሩ፤ እሳን ለለበ ዮናሲን ቀልቢ ጅጂረተኒቲ፤ ኩኖ ከን ዮናስን ጫሉ አስ ጅረ።</char><verse eid="LUK 11:32"/></para>
  <para style="s1">እብሳ ዸግና</para>
  <para style="r">
    <ref loc="LUK 11:34">11፥34</ref>፣<ref loc="LUK 11:35">35</ref> ኩወፈ – <char style="xt"><ref loc="MAT 6:22">ማቴ 6፥22</ref>፣<ref loc="MAT 6:23">23</ref></char></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 11:33"/>
    <char style="wj">“ነምን ከምዩ እብሳ ቀብሲሴ እዶ ህንሙልአትኔ ዮካን ጎምብሳ ጀለ ህንካኡ። ቆደ ከና አከ ወር ኦል ሴነን እፈሳ አርገኒፍ ባቱሳረ ካኡ።</char> <verse eid="LUK 11:33"/><verse number="34" style="v" sid="LUK 11:34"/><char style="wj">እጅኬ እብሳ ዸግነኬቲት። እጅኬ ፈያ ታናን፣ ዸግንኬ ጉቱን እፋን ጉተመ። ዮ እጅኬ ፈያ ህንተእን ገሩ ዸግንኬስ ዱከናን ጉተመ።</char> <verse eid="LUK 11:34"/><verse number="35" style="v" sid="LUK 11:35"/><char style="wj">ከናፉ አከ እፍን ስ ኬሳ ዱከነ ህንታኔፍ ኦፍ ኤገዹ።</char> <verse eid="LUK 11:35"/><verse number="36" style="v" sid="LUK 11:36"/><char style="wj">ኤጋ ዮ ዸግንኬ ሁንድኑ እፋን ጉተሜ፣ ዮ ኩታን ቶኮዩ ዱከነ ህንቀባትን፣ አኩመ ዋን እፍን እብሳ ቶኮ እፈሳቲን ሲፍ እብሱት ዸግንኬ ጉቱማት እፈ ንቀባተ።”</char><verse eid="LUK 11:36"/></para>
  <para style="s1">ፈሪሶትኒፊ በርሲስቶትን ሴራ እፈተመን</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 11:37"/>አኩመ ዬሱስ ሃሳሳ ፍጠቴን ፈሪሶተ ኬሳ ነምች ቶኮ አከ ዬሱስ እሰ ወጅን ኛተ ኛቱፍ መነሳት እሰ ዋሜ፤ ዬሱስስ ኦል ሴኔ ማዲት ዽኣቴ። <verse eid="LUK 11:37"/><verse number="38" style="v" sid="LUK 11:38"/>ፈሪስች ገሩ አከ ዬሱስ ኛታን ዱረ ህንዽቀትን አርጌ ድንቅሲፈቴ።<verse eid="LUK 11:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 11:39"/>ጎፍታንስ አከነ እሳን ጄዼ፤ <char style="wj">“እስን ፈሪሶትን ዱበ ጦፎቲፊ ጫቢ ንቁልቁሌስቱ፤ ኬስኬሰን ገሩ ሳምቻፊ ሀምናን ጉተሜረ።</char> <verse eid="LUK 11:39"/><verse number="40" style="v" sid="LUK 11:40"/><char style="wj">ያ ነሞተ ጎዎተ! እን ዱበሳ ኡሜ ሱን ኬሰሳሞ ህንኡምኔ?</char> <verse eid="LUK 11:40"/><verse number="41" style="v" sid="LUK 11:41"/><char style="wj">እስን ገሩ ዋን ጦፎፊ ጫቢ ኬሰ ጅሩ ህዬዪፍ ኬና፤ ዮስ ወን ሁንድኑ እስኒ ቁልቁላኣ።</char><verse eid="LUK 11:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 11:42"/>
    <char style="wj">“ፈሪሶተ ነነ እስኒፍ ወዮ! እስን እንስላለ፣ ጭላዳማፊ ብቅልቱ ጎሰ ሁንዳ ኩዸን ኬሳ ቶኮ ዋቃፍ ንኬንቱ፤ ሙርቲ ቀጄላፊ ጃለለ ዋቃ ገሩ ንቱፈቱ። ስላ ኡቱ እሰ ዱራ ህንዺስን እሰ ቦዴ ሆጂረ ኦልቹ ቀብዱ ቱሬ።</char><verse eid="LUK 11:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 11:43"/>
    <char style="wj">“ያ ፈሪሶተ፣ እስኒፍ ወዮ! እስን መኔን ሰገዳ ኬሰት ታኡምሰ ኡልፍና፣ ገባ ኬሰትስ ነጋ ጋፈተሙ ጃለቱ።</char><verse eid="LUK 11:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 11:44"/>
    <char style="wj">“እስን ሰበቢ አዋለ መለቶ ህንቀብኔ ከን ነሞትን ኡቱ ህንቤክንረ ዴመን ፈካተኒፍ እስኒ ወዮ!”</char><verse eid="LUK 11:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 11:45"/>ሀዮተ ሴራ ኬሳስ ቶኮ ዴብሴ፣ “ያ በርሲሳ፣ አት ዮሙ ዋን ከነ ጄቱት ኑስ አረብሳ ጅርተ!” ጄዼን።<verse eid="LUK 11:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 11:46"/>ዬሱስሞ አከነ ጄዼ ዴብሴ፤ <char style="wj">“ሀዮተ ሴራ፣ እስኒፍስ ወዮ! እስን በኣ ነምን ባቹ ህንደንዴኜ እሳንት ፌቱ፤ ኦፊኬሰኒ ገሩ እሳን ገርጋሩዻፍ ቁባንሌ ህንቱቅጠን።</char><verse eid="LUK 11:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 11:47"/>
    <char style="wj">“እስኒፍ ወዮ! እስን ራጆታፍ አዋለ እጃርቱቲ፤ ከን እሳን አጄሴስ አቦቱመኬሰን።</char> <verse eid="LUK 11:47"/><verse number="48" style="v" sid="LUK 11:48"/><char style="wj">ከናፉ እስን አከ ዋኑመ አቦቲንኬሰን ሆጄተን ሰነ ዴገርተን ዹጋ ባቱ፤ እሳን ራጆተ አጄሰን፤ እስንሞ አዋለ ራጆታ እጃርቱ።</char> <verse eid="LUK 11:48"/><verse number="49" style="v" sid="LUK 11:49"/><char style="wj">ሰበቢ ከናፍ ዋቅን ኦጉማሳቲን፣ ‘አን ራጆታፊ ኤርገሞተ እሳንትን ኤርገ፤ ነሞትን ሱንስ እሳን ኬሳ ቶኮ ቶኮ ንአጄሱ፤ ካንሞ ንአርአቱ’ ጄዼ።</char> <verse eid="LUK 11:49"/><verse number="50" style="v" sid="LUK 11:50"/><char style="wj">ከናፍ ዸሎትን ኩን ዺገ ራጆተ ሁንዳ ከን ኡመመ አዱኛቲ ጀልቀቤ ዸንገለኤት ንጋፈተመ፤</char> <verse eid="LUK 11:50"/><verse number="51" style="v" sid="LUK 11:51"/><char style="wj">ዺገ አቤልራ ጀልቀቤ ሀመ ዺገ ዘካርያስ እሰ እዶ ኣርሳቲፊ መነ ቁልቁሉማ ግዱት አጄፈሜ ሰናት ንጋፈተመ። ኤዬ አን እስንትን ህመ፤ ዸሎትን ኩን ዋን ከነ ሁንዱመት ንጋፈተመ።</char><verse eid="LUK 11:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 11:52"/>
    <char style="wj">“ያ ሀዮተ ሴራ፣ እስኒፍ ወዮ! እስን ፉርቱ ቤኩምሳ ፉዸተኒርቱ። ኦፊኬሰኒ ህንሴኔ፤ ወረ ሴና ቱረንስ ዾውተኒርቱ።”</char><verse eid="LUK 11:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 11:53"/>ዮሙ ዬሱስ አቺ ዴሜት፣ ፈሪሶትኒፊ በርሲስቶትን ሴራ ጀቤሰኒ እሳን ሞርሙ፣ አከ እን ዋን ባይኤ ዱበቱፍስ እሰ ቱቱቁ ጀልቀበን። <verse eid="LUK 11:53"/><verse number="54" style="v" sid="LUK 11:54"/>ዋን አፋንሳቲ በኡን እሰ ቀቡፍስ ኤገቻ ቱረን።<verse eid="LUK 11:54"/></para>
  <chapter eid="LUK 11"/>
  <chapter number="12" style="c" sid="LUK 12"/>
  <para style="s1">ኦፍ ኤገቺሰ</para>
  <para style="r">
    <ref loc="LUK 12:2-9">12፥2‑9</ref> ኩወፈ – <char style="xt"><ref loc="MAT 10:26-33">ማቴ 10፥26‑33</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 12:1"/>ግዱ ሰነ ዮሙ ቱትን ነሞተ ኩመ ሄዱ ቶኮ ሀመ እሳን ወልረ ኤጄተንት ወልት ቀበሜት፣ ዬሱስ ዱራን ዱርሴ በረቶተሳቲን አከነ ጄቹ ጀልቀቤ፤ <char style="wj">“ራጭቲ ፈሪሶታራ ኦፍ ኤገዻ፤ ኩንስ ፈኬስቱማዸ።</char> <verse eid="LUK 12:1"/><verse number="2" style="v" sid="LUK 12:2"/><char style="wj">ወን ሀጉገሜ ኡቱ ህንሙልእፈምን ሀፉ ዮካን ወን ዾክፈሜ ኡቱ ህንቤከምን ሀፉ ቶኮዩ ህንጅሩ።</char> <verse eid="LUK 12:2"/><verse number="3" style="v" sid="LUK 12:3"/><char style="wj">ወን እስን ዱከነ ኬሰት ዱበተን፣ እፈ ጉያቲን ዸገአመ፤ ወን እስን ጎለ ኬሰት ጉረት ሀሳስተንስ በንቲ መናራ ለብሰመ።</char><verse eid="LUK 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 12:4"/>
    <char style="wj">“ያ ምቾተኮ፣ አን እስንትን ህመ፤ ወረ ዸግነ አጄሰኒ ኤርገሲሞ ከነ ጫላ ሆማ ጎቹ ህንደንዴኜ ህንሶዳትና።</char> <verse eid="LUK 12:4"/><verse number="5" style="v" sid="LUK 12:5"/><char style="wj">አን ገሩ ከን እስን ሶዳቹ ቀብደን እስንትን አርግሲሰ፤ እሰ ኤርገ አጄሴ ቦዴ ገሃነምት ደርበቹዻፍ ታይታ ቀቡ ሰነ ሶዳዻ፤ ኤዬ፣ አን እስንትን ህመ፤ እሰ ሶዳዻ።</char> <verse eid="LUK 12:5"/><verse number="6" style="v" sid="LUK 12:6"/><char style="wj">ዳሎቴን ሸን ሳንትመ ለመት ጉርጉረሙ ምቲ? እሳን ኬሳ ገሩ ቶኮዩ ዋቅን ህንእራንፈቱ።</char> <verse eid="LUK 12:6"/><verse number="7" style="v" sid="LUK 12:7"/><char style="wj">ዹጉማኑ ርፌንስ መታኬሰኒ ሁንድ ለካአሜረ። ህንሶዳትና፤ እስን ዳሎቴ ሄዱ ጫላ ገቲ ቀብዱቲ።</char><verse eid="LUK 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 12:8"/>
    <char style="wj">“አን እስንትን ህመ፤ ነመ ፉለ ነሞታ ዱረት እፋን እፈት ዹጋ ናፍ በኡ ከሚፍዩ፣ እልም ነማስ ፉለ ኤርገሞተ ዋቃ ዱረት ዹጋ ንበአ።</char> <verse eid="LUK 12:8"/><verse number="9" style="v" sid="LUK 12:9"/><char style="wj">ነምን ፉለ ነሞታ ዱረት ነ ገኑ ከምዩ ገሩ ፉለ ኤርገሞተ ዋቃ ዱረት ንገነመ።</char> <verse eid="LUK 12:9"/><verse number="10" style="v" sid="LUK 12:10"/><char style="wj">ነመ እልመ ነማቲን ሞርሜ ጄቸ ቶኮ ዱበቱ ሁንዳፍ ንዺፈመ፤ ነመ ሀፉረ ቁልቁሉዻን ሞርሜ ዱበቱ ከሚፍዩ ገሩ ህንዺፈሙ።</char><verse eid="LUK 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 12:11"/>
    <char style="wj">“ዮሙ መኔን ሰገዳ፣ ቡልችቶታፊ አቦቲ ታይታ ዱረት ዽኤፈምተንት አከምት አከ ፈልመተን ዮካን ማል አከ ጄተን ህንያደእና።</char> <verse eid="LUK 12:11"/><verse number="12" style="v" sid="LUK 12:12"/><char style="wj">ሀፉር ቁልቁሉን ዬሩመ ሰነ ዋን እስን ጄቹ ቀብደን እስን በርሲሳቲ።”</char><verse eid="LUK 12:12"/></para>
  <para style="s1">ፈኬኘ ሶሬሰ ጎዋ</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 12:13"/>ቱተ ሰነ ኬሳ ነምች ቶኮ፣ “ያ በርሲሳ፣ አከ ኦቦሌስኮ ዻለ ናህሩፍ ማሎ እት ናፍ ዱበዹ” ጄዼን።<verse eid="LUK 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 12:14"/>ዬሱስ ገሩ ዴብሴ፣ <char style="wj">“ነመነ፣ ኤኙቱ እስን ግዱት አባ ሙርቲ ዮካን ህርቱ ዻላ ነ ጎዼ?”</char> ጄዼን። <verse eid="LUK 12:14"/><verse number="15" style="v" sid="LUK 12:15"/>እንስ፣ <char style="wj">“እላለዻ! ዶቅኑማ ሁንደራስ ኦፍ ኤጋ፤ ጅሬኝ ነመ ቶኮ ባይእነ ቀቤኘሳቲን ህንሙርቴፈሙቲ”</char> ጄዼን።<verse eid="LUK 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 12:16"/>እንስ አከነ ጄዼ ፈኬኘ ከነ እሳንት ህሜ፤ <char style="wj">“ለፍት ቆቲሳ ነምቸ ሶሬሰ ቶኮ ምዻን ጉዳ ኬኔፍ።</char> <verse eid="LUK 12:16"/><verse number="17" style="v" sid="LUK 12:17"/><char style="wj">ነምች ሱንስ፣ ‘አን ዋን ለፈን እት ምዻንኮ ገልፈዹ ህንቀብኔፍ ማል ጎቹ ናፍ ወየ?’ ጄዼ ገራሳት ያዴ።</char><verse eid="LUK 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 12:18"/>
    <char style="wj">“እንስ አከነ ጄዼ፤ ‘ወን አን ጎዹ ከነ፤ ጎምብሳኮ ዲጌ ጉዳሳ ነንእጃረዸ፤ ምዻንኮፊ ምአኮ ሁንደ አችን ኩፈዸ።</char> <verse eid="LUK 12:18"/><verse number="19" style="v" sid="LUK 12:19"/><char style="wj">ሉቡኮቲንስ፣ “ያ ሉቡኮ፣ አት ዋን ጋሪ ሄዱ ከን ወጋ ባይኤፍ ኩፈሜ ቀብደ፤ ቦቆዹ፤ ኛዹ፤ ዹግ፤ ገመድስ” ነንጄዸ።’</char><verse eid="LUK 12:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 12:20"/>
    <char style="wj">“ዋቅን ገሩ፣ ‘ያ ጎውቸ፣ ኤደኑመ ሉቡኬ ስራ ፉዸቹ በርባዱ፤ ኤጋ ወን አት ወልት ቀበቴ ሱን ከን ኤኙ ተአ?’ ጄዼን።</char><verse eid="LUK 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 12:21"/>
    <char style="wj">“ከናፉ ነምን ኦፊሳቲፍ በዻዹማ ኩፈቴ ፉለ ዋቃ ዱረትሞ ህንሶሮምን ከምዩ አከሱመ ተአ።”</char><verse eid="LUK 12:21"/></para>
  <para style="s1">ህንያደእና</para>
  <para style="r">
    <ref loc="LUK 12:22-31">12፥22‑31</ref> ኩወፈ – <char style="xt"><ref loc="MAT 6:25-33">ማቴ 6፥25‑33</ref></char></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 12:22"/>ዬሱስስ በረቶተሳቲን አከነ ጄዼ፤ <char style="wj">“ከናፉ አን እስንትን ህመ፤ ‘ማል ኛትነ?’ ጄተኒ ዋኤ ጅሬኘኬሰኒ ህንያደእና፤ ዮካን ‘ማል ኡፈትነ?’ ጄተኒ ዋኤ ዸግነኬሰኒ ህንያደእና።</char> <verse eid="LUK 12:22"/><verse number="23" style="v" sid="LUK 12:23"/><char style="wj">ጅሬኝ ኛተ ጫለ፤ ዸግንስ ኡፈተ ጫላቲ።</char> <verse eid="LUK 12:23"/><verse number="24" style="v" sid="LUK 12:24"/><char style="wj">ሜ አራጌዪ እላላ፦ እሳን ህንፈጫፈተን ዮካን ህንሃመተን፤ ጎምብሳ ዮካን ጉምቢ ህንቀበን፤ ተኡስ ዋቅን እሳን ሶረ። እስንሞ ሀመም ስምብሮተ ጫላ ገቲ ጉዳ ቀብዱ!</char> <verse eid="LUK 12:24"/><verse number="25" style="v" sid="LUK 12:25"/><char style="wj">እስን ኬሳ ነምን ያደኡዻን ሆጃሳረት ዹንዹመ ቶኮ ደበለቹ ደንደኡ ኤኙ?</char> <verse eid="LUK 12:25"/><verse number="26" style="v" sid="LUK 12:26"/><char style="wj">ዮስ እስን ኤርገ ዋን ጥኖ አከሲሌ ጎዸቹ ህንደንዴኜ፣ ማሊፍ ዋን ብራፍ ያዶፍቱሬ?</char><verse eid="LUK 12:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 12:27"/>
    <char style="wj">“ደራራወን ቦሶና አከምት አከ ጉደተን ሜ እላላ፤ እሳን ህንዸመአን ዮካን ህንፎአን። አን ገሩ እስንትን ህመ፤ ሶሎሞንዩ ኡልፍነሳ ሁንደ ኬሰት፣ አከ ቶኮሳኒት ህንኡፈትኔ።</char> <verse eid="LUK 12:27"/><verse number="28" style="v" sid="LUK 12:28"/><char style="wj">እስን ያ ወረ አመንቲ ጥኖነነ! ዋቅን ኤርገ መርገ ድሬ ከን ሀርአ ጅሩፊ ከን ቦርሞ እብደት ነቀሙትዩ አከስት ኡፍሴ፣ እስንትሞ ሀመም ከነ ጫላ ሃኡፍሱሬ።</char> <verse eid="LUK 12:28"/><verse number="29" style="v" sid="LUK 12:29"/><char style="wj">ቀልቢኬሰን ዋን ኛተንረ ዮካን ዋን ዹግደንረ ህንካአትና፤ ዋኤሳስ ህንያደእና።</char> <verse eid="LUK 12:29"/><verse number="30" style="v" sid="LUK 12:30"/><char style="wj">አዱኛን ኦርሞታ ዋን ከነ ሁንደ ንበርባዱቲ፤ አባንኬሰን አከ ወን ኩን ሁንድኑ እስን በርባችሱ ንቤከ።</char> <verse eid="LUK 12:30"/><verse number="31" style="v" sid="LUK 12:31"/><char style="wj">ገሩ ሞቱማሳ በርባዳ፤ ወን ኩን አከሱመ እስኒፍ ኬነመ።</char><verse eid="LUK 12:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 12:32"/>
    <char style="wj">“እስን ከረ ጥኖነነ፣ ህንሶዳትና፤ አባንኬሰን ሞቱማ እስኒ ኬኑ ጃለቴራቲ።</char> <verse eid="LUK 12:32"/><verse number="33" style="v" sid="LUK 12:33"/><char style="wj">ዋን ቀብደን ጉርጉራቲ ህዬዪፍ ኬና። ኮሮጆ ህንሞፎፍኔ፣ ቀቤኘ ዹመ ህንቀብኔስ ሰሚረት፣ እዶ ሀቱን እት ህንዽኣትኔፊ ብሊንስ ህንበሌስኔት ኦፊኬሰኒፍ ኩፈዻ።</char> <verse eid="LUK 12:33"/><verse number="34" style="v" sid="LUK 12:34"/><char style="wj">እዱመ በዻዹማንኬሰን ጅሩ ሰነ ገራንኬሰንስ ጅራቲ።</char><verse eid="LUK 12:34"/></para>
  <para style="s1">ቆጳአኒ ኤጉ</para>
  <para style="r">
    <ref loc="LUK 12:35">12፥35</ref>፣<ref loc="LUK 12:36">36</ref> ኩወፈ – <char style="xt"><ref loc="MAT 25:1-13">ማቴ 25፥1‑13</ref>፤ <ref loc="MRK 13:33-37">ማር 13፥33‑37</ref></char></para>
  <para style="r">
    <ref loc="LUK 12:39">12፥39</ref>፣<ref loc="LUK 12:40">40</ref>፣<ref loc="LUK 12:42-46">42‑46</ref> ኩወፈ – <char style="xt"><ref loc="MAT 24:43-51">ማቴ 24፥43‑51</ref></char></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 12:35"/>
    <char style="wj">“ተጃጅላፍ ህዸዻቲ ቆጳኣ፤ እብሳኬሰንስ እብሰዻ፤</char> <verse eid="LUK 12:35"/><verse number="36" style="v" sid="LUK 12:36"/><char style="wj">አኩመ ነሞተ ዮሙ ጎፍታንሳኒ ጭዸ ፉዻፊ ሄሩማቲ ገሌ በልበለ ዸዸኡት ደፈኒ እሳፍ በኑፍ ጄዸኒ ቆጳአኒ እሰ ኤገኒ ተኣ።</char> <verse eid="LUK 12:36"/><verse number="37" style="v" sid="LUK 12:37"/><char style="wj">ገርቦትን ጎፍታንሳኒ ዬሮ ገሉት እሳኒ ደመቀኒ ጅረን አርጉ ሱን ኤብፈሞዸ፤ አን ዹጉመን እስንት ህመ፤ እን መርጥፈቴ አከ እሳን ኛታፍ ታአን ንጎዸ፤ ዹፌስ እሳን ተጃጅለ።</char> <verse eid="LUK 12:37"/><verse number="38" style="v" sid="LUK 12:38"/><char style="wj">ገርቦትን ጎፍታንሳኒ ሀልከንቸ ኬሳ ኩታ ለመፋት ዮካን ኩታ ሰደፋት ዹፌ አከሱመ እሳኒ ደመቀኒ ጅረን እሳን አርጉ ሱን ኤብፈሞዸ።</char> <verse eid="LUK 12:38"/><verse number="39" style="v" sid="LUK 12:39"/><char style="wj">ገሩ ዋን ከነ ሁበዻ፦ አብች መና ኡቱ ሰኣቲ ከምት አከ ሀቱን ዹፍቱ ቤኬ፣ ስላ አከ መንሳ ጨብሰሜ ሴነሙ እት ህንዺሱ ቱሬ።</char> <verse eid="LUK 12:39"/><verse number="40" style="v" sid="LUK 12:40"/><char style="wj">እስንስ አከሱመ ቆጳኡ ቀብዱ፤ እልም ነማ ሰኣቲ እስን ህንኤግኔት ዹፋቲ።”</char><verse eid="LUK 12:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 12:41"/>ጴጥሮስስ፣ “ያ ጎፍታ፣ አት ፈኬኘ ከነ ኑ ቆፈትሞ ነመ ሁንዱመት ህምተ?” ጄዼ ጋፈቴ።<verse eid="LUK 12:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 12:42"/>ጎፍታንስ አከነ ጄዼ ዴብሴ፤ <char style="wj">“ኤጋ ሆጂ አዴምስሳን አመነማፊ ኦጌስ ከን ጎፍታንሳ አከ እን ኛተሳኒ ዬሮ መሉት እሳኒ ኬኑፍ ጄዼ ገርቦተሳረት እሰ ሙዱ ኤኙ?</char> <verse eid="LUK 12:42"/><verse number="43" style="v" sid="LUK 12:43"/><char style="wj">ገርብች ጎፍታንሳ ዮሙ ዴብኡት ኡቱ እን አከሱመ ሆጄቱ እሰ አርጉ ሱን ኤብፈማዸ።</char> <verse eid="LUK 12:43"/><verse number="44" style="v" sid="LUK 12:44"/><char style="wj">አን ዹጉመ እስንት ነንህመ፤ እን ቀቤኘሳ ሁንደረት እሰ ሙደ።</char> <verse eid="LUK 12:44"/><verse number="45" style="v" sid="LUK 12:45"/><char style="wj">ገርብች ሱን ገሩ ዮ፣ ‘ጎፍታንኮ ዹፉፍ ዬሮ ዼራ ቱረ’ ኦፊን ጄዼ፣ ገርቦተ ዺራቲፊ ዱበርቶታ ቱሙ ጀልቀቤ፣ ዮ ኛቴ ዹጌ መቻኤ፣</char> <verse eid="LUK 12:45"/><verse number="46" style="v" sid="LUK 12:46"/><char style="wj">ጎፍታን ገርብቸ ሰና ጉያ እን እሰ ህንኤግኔፊ ሰኣቲ እን ህንቤክኔት ንዹፈ። እንስ እሰ ኩኩተ፤ ወረ ህንአመኔ ኬሰትስ እሰ ረመደ።</char><verse eid="LUK 12:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 12:47"/>
    <char style="wj">“ገርብች ኡቱ ፌዺ ጎፍታሳ ቤኩ ህንቆጶፍኔ ዮካን ዋን ጎፍታንሳ በርባዱ ህንሆጄትኔ ሱን አከ መሌ ቱመመ።</char> <verse eid="LUK 12:47"/><verse number="48" style="v" sid="LUK 12:48"/><char style="wj">ነመ ኡቱ ህንቤክን ዋን እሰ አደበምሲሱ ሆጄቴ ገሩ አደበ ሰልጳቱ እሰረ ገአ። ነመ ወን ባይኤን እት ኬነሜ ሁንደራ ዋን ባይኤቱ ኤገመ፤ ነመ እማናን ጉዳን እት ኬነሜራሞ ከን ጫሉቱ በርባደመ።</char><verse eid="LUK 12:48"/></para>
  <para style="s1">ገርገር በኡ መሌ ነጋ ምት</para>
  <para style="r">
    <ref loc="LUK 12:51-53">12፥51‑53</ref> ኩወፈ – <char style="xt"><ref loc="MAT 10:34-36">ማቴ 10፥34‑36</ref></char></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 12:49"/>
    <char style="wj">“አን እብደ ለፈረ ቡሱፍን ዹፌ፤ ኡቱ እን አሙመዩ ቀበቴ አን አከመን ሀወ!</char> <verse eid="LUK 12:49"/><verse number="50" style="v" sid="LUK 12:50"/><char style="wj">ገሩ ጩጳ አን ጩጰሙ ቶኮቱ ጅረ፤ ሀመ እን ራወተሙት አን አከ መሌ ነንዽጰዸ!</char> <verse eid="LUK 12:50"/><verse number="51" style="v" sid="LUK 12:51"/><char style="wj">እስን ዋን አን ለፈረት ነጋ ቡሱፍ ዹፌ ሴቱ? አከስ ምት፤ አን እስንትን ህመ፤ አን ገርገር በኡ ፍዱፈን ዹፌ መሌ ነጋ ቡሱፍ ህንዹፍኔ።</char> <verse eid="LUK 12:51"/><verse number="52" style="v" sid="LUK 12:52"/><char style="wj">ስአች ማቲን ነመ ሸን ቀቡ ቶኮ ገርገር ቆደመ፤ ነምን ሰዲ ለመት ከአ፤ ነምን ለመሞ ነመ ሰዲት ከአ።</char> <verse eid="LUK 12:52"/><verse number="53" style="v" sid="LUK 12:53"/><char style="wj">አባን እልመት፣ እልም አባት፣ ሃት እንተለት፣ እንተል ሃዸት፣ አማቲን ኒቲ እልማት፣ ኒቲን እልማስ አማቲሼት ከኡዻን ገርገር በኡ።”</char><verse eid="LUK 12:53"/></para>
  <para style="s1">በረ እላለኒ ዋ ህሙ</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 12:54"/>ዬሱስስ ቱተ ሰናን አከነ ጄዼ፤ <char style="wj">“እስን ዮሙ ዱሜሰ ከራ ልጠ ቢፍቱቲን ኦል በኡ አርግተንት ዬሩመ ሰነ፣ ‘ቦካን ንሮበ’ ጄቱ፤ እንስ ንሮበ።</char> <verse eid="LUK 12:54"/><verse number="55" style="v" sid="LUK 12:55"/><char style="wj">ዮሙ ቡቤን ክባ ቡብሱትሞ፣ ‘ንሆአ’ ጄቱ፤ እንስ ንሆአ።</char> <verse eid="LUK 12:55"/><verse number="56" style="v" sid="LUK 12:56"/><char style="wj">ፈኬስቶተነነ! እስን ብፈ ለፋቲፊ ሰሚቲፍ ሂካ ኬኑ ንቤክቱ። በረ አማ ከናፍሞ ሂካ ኬኑ አከምት ወላልቱ?</char><verse eid="LUK 12:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 12:57"/>
    <char style="wj">“እስን ማሊፍ ኦፉመኬሰኒ ዋን ቀጄላ ህንሙርቴስኔ?</char> <verse eid="LUK 12:57"/><verse number="58" style="v" sid="LUK 12:58"/><char style="wj">አት ዮሙ አመጃጂኬ ወጅን ገረ አባ ሙርቲ ዸቅጡት፣ ከሩመረት እሳን ወልት አራረሙ ጭምሲ ያል፤ ዮ ከና አቺ አመጃጂንኬ አባ ሴራት ስ ጌሰ፤ አባን ሴራስ ደበርሴ ፖልሲት ስ ኬነ፤ ፖልሲንሞ መነ ህዻት ስደርበተ።</char> <verse eid="LUK 12:58"/><verse number="59" style="v" sid="LUK 12:59"/><char style="wj">አን ስት ነንህመ፤ አት ሀመ ሳንትመ እሼ ዹማ ኦፍራ ባፍቱት አቺ ህንባቱ።”</char><verse eid="LUK 12:59"/></para>
  <chapter eid="LUK 12"/>
  <chapter number="13" style="c" sid="LUK 13"/>
  <para style="s1">ቀልቢ ጅጂረቹ ዮካን በዱ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 13:1"/>ዬሮ ሰነ ነሞትን ዋኤ ወረ ገሊላ ከኔን ጲላጦስ ዺገሳኒ ኣርሳሳኒት መኬ ሰና ዬሱስት ህመን ቶኮ ቶኮ አች ቱረን። <verse eid="LUK 13:1"/><verse number="2" style="v" sid="LUK 13:2"/>ዬሱስስ ዴብሴ አከነ ጄዼን፤ <char style="wj">“ሰበቢን ነሞትን ገሊላ ኩኔን አከስ ዽጰተኒፍ ዋን እሳን ሰበ ገሊላ ካን ሁንደረ ጩበሞተ ቱረኒፍ ሴቱ?</char> <verse eid="LUK 13:2"/><verse number="3" style="v" sid="LUK 13:3"/><char style="wj">አን እስንትን ህመ፤ አከስ ምት፤ ገሩ እስንስ ቀልቢ ጅጂረቹ ባትናን ሁንድኬሰን አከሱመ በዱ።</char> <verse eid="LUK 13:3"/><verse number="4" style="v" sid="LUK 13:4"/><char style="wj">ዮካን ነሞትን ኩዸ ሰዴተን ገሞን ሰሊሆም እሳንረት ጅጌ እሳን ፍጤ ሱን ወረ ዬሩሳሌም ኬሰ ጅራተን ካን ሁንደረ ዋን የከ ሆጄተን ሴቱ?</char> <verse eid="LUK 13:4"/><verse number="5" style="v" sid="LUK 13:5"/><char style="wj">አን እስንትን ህመ፤ አከስ ምት። ገሩ እስንስ ቀልቢ ጅጂረቹ ባትናን፣ ሁንድኬሰን አከሱመ በዱ።”</char><verse eid="LUK 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 13:6"/>እንስ አከነ ጄዼ ፈኬኘ ከነ ዱበቴ፤ <char style="wj">“ነምች ቶኮ ሙከ ሀርቡ ከን እዶ ዻበ ወይኒሳ ኬሰ ዻበሜ ቶኮ ቀበ ቱሬ፤ እንስ ሙከ ሰነረ እጀ በርባዱ ዸቄ ዋን ቶኮሌ ዸቤ።</char> <verse eid="LUK 13:6"/><verse number="7" style="v" sid="LUK 13:7"/><char style="wj">እንስ ሆጄታ እዶ ዻበ ወይንቻቲን፣ ‘አን ወጋ ሰደን ደርበን ከነ ሙከ ሀርቡ ከነራ እጀ በርባደቹፍ ጄዼ መርማራን ቱሬ፤ ገሩ ዋን ቶኮሌ እራ ህንአርገትኔ፤ ሙሪቲ ገት! እን ማሊፍ ለፈ በሌሰ?’ ጄዼ።</char><verse eid="LUK 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 13:8"/>
    <char style="wj">“ነምች ሱንስ ዴብሴ አከነ ጄዼን፤ ‘ያ ጎፍታ፣ አኑ ናኖሳ ቆቴን ጣኦ እት ነቃቲ ሜ ወጉመ ቶኮ ሃቱሩ።</char> <verse eid="LUK 13:8"/><verse number="9" style="v" sid="LUK 13:9"/><char style="wj">ዮ እን ወጋ ዹፉ እጀ ነቀቴ፣ ጋሪዸ! ዮ ከና አቺ ሙርቴ ገቱ ደንዴሰ።’ ”</char><verse eid="LUK 13:9"/></para>
  <para style="s1">ዱበርቲን ዱግድሼ ጎጰቴ ቶኮ ፈይፈሙሼ</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 13:10"/>ዬሱስ ጉያ ሰንበታ ቶኮ መኔን ሰገዳ ኬሳ እሰ ቶኮት በርሲሳ ቱሬ። <verse eid="LUK 13:10"/><verse number="11" style="v" sid="LUK 13:11"/>ዱበርቲን ሀፉር ሀማን ወጋ ኩዸ ሰዴት ዱግደሼ ጎጴሴ ቶኮስ አች ቱርቴ፤ እሼንስ ዋን ገድ ጎግዴፍ ጎንኩማ ኦል ጄቹ ህንደንዴሱ ቱርቴ። <verse eid="LUK 13:11"/><verse number="12" style="v" sid="LUK 13:12"/>ዬሱስስ ዮሙ እሼ አርጌት ኦፍት እሼ ዋሜ፣ <char style="wj">“ዱበርቲነነ፣ አት ዹኩበኬራ ፈይቴርተ”</char> ጄዼን፣ <verse eid="LUK 13:12"/><verse number="13" style="v" sid="LUK 13:13"/>እንስ ሀርከሳ እሼረ ካኤ፤ እሼንስ ዬሩመ ሰነ ኦል ጄቴ ዋቀ ገለቴፈቴ።<verse eid="LUK 13:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 13:14"/>ቡልቻን መነ ሰገዳስ ሰበቢ ዬሱስ ጉያ ሰንበታቲን ነመ ፈይሴፍ ኣሬ ነሞታን፣ “ጉያን ሆጂ ጀአቱ ጅረ፤ ጉዮተ ሰነ ኮታቲ ፈይፈማ መሌ ጉያ ሰንበታ ህንዹፍና” ጄዼ።<verse eid="LUK 13:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 13:15"/>ጎፍታንሞ አከነ ጄዼ ዴብሴፍ፤ <char style="wj">“ያ ፈኬስቶተ! እስን ኬሳ ነምን ጉያ ሰንበታ ቆትዮሳ ዮካን ሀሬሳ ደላ ኬሳ ሂኬ ብሻን ኦባሱ ህንጌስኔ ጅራ?</char> <verse eid="LUK 13:15"/><verse number="16" style="v" sid="LUK 13:16"/><char style="wj">ዮስ ዱበርቲን ኩን እንተል አብረሃም ከን ሴጠን ወጋ ኩዸ ሰዴት ጉቱ ህዼ ቱሬ ኩን ጉያ ሰንበታቲን ህዻ ከነራ ሂከሙን እሼፍ ህንመሉ?”</char><verse eid="LUK 13:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 13:17"/>ዮሙ እን ዋን ከነ ዱበቴት ሞርምቶትንሳ ሁንድ ንቃነአን፤ ነሞትን ገሩ ሆጂወን ድንቂ ከኔን እን ሆጄቻ ቱሬ ሁንደት ንገመደን።<verse eid="LUK 13:17"/></para>
  <para style="s1">ፈኬኘ ሰኚ ሰናፍጫቲፊ ፈኬኘ ራጭቲ</para>
  <para style="r">
    <ref loc="LUK 13:18">13፥18</ref>፣<ref loc="LUK 13:19">19</ref> ኩወፈ – <char style="xt"><ref loc="MRK 4:30-32">ማር 4፥30‑32</ref></char></para>
  <para style="r">
    <ref loc="LUK 13:18-21">13፥18‑21</ref> ኩወፈ – <char style="xt"><ref loc="MAT 13:31-33">ማቴ 13፥31‑33</ref></char></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 13:18"/>ዬሱስስ አከነ ጄዼ ጋፈቴ፤ <char style="wj">“ሞቱማን ዋቃ ማል ፈካተ? አንስ ማሊነን ወል እሰ ፈኬሰ?</char> <verse eid="LUK 13:18"/><verse number="19" style="v" sid="LUK 13:19"/><char style="wj">ሞቱማን ዋቃ ሰኚ ሰናፍጫ ከን ነምን ቶኮ ፉዼ ለፈ ቆቲሳሳ ኬሰት ፈጫሴ ፈካተ። ሰኚን ሱንስ ጉደቴ ሙከ ተኤ፤ ስምብሮትንስ ደሜወንሳረ ጅራተን።”</char><verse eid="LUK 13:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 13:20"/>አመሌ አከነ ጄዼ ጋፈቴ፤ <char style="wj">“አን ሞቱማ ዋቃ ማሊነን ወል ፈኬሰ?</char> <verse eid="LUK 13:20"/><verse number="21" style="v" sid="LUK 13:21"/><char style="wj">እን ራጭቲ ዱበርቲን ቶኮ ፉቴ ሀመ እን ጉቱማት ቡኬሱት ዳኩ ሰፈርቱ ሰዲት መክቴ ፈካተ።”</char><verse eid="LUK 13:21"/></para>
  <para style="s1">በልበለ ዽጳ</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 13:22"/>ዬሱስስ ኡቱ ገረ ዬሩሳሌም ዴሙ ነሞተ በርሲሳ መጋላወኒፊ ገንዶተ ኬሰ ደርባ ቱሬ። <verse eid="LUK 13:22"/><verse number="23" style="v" sid="LUK 13:23"/>ነምች ቶኮስ፣ “ያ ጎፍታ ወር ፈይፈመን ነሞተ ሙራሰ ቆፋ?” ጄዼ እሰ ጋፈቴ።</para>
  <para style="p" vid="LUK 13:23">እንስ አከነ እሳኒን ጄዼ፤ <verse eid="LUK 13:23"/><verse number="24" style="v" sid="LUK 13:24"/><char style="wj">“በልበለ ዽጳዻን ሴኑፍ ተታፈዻ፤ አን እስንትን ህመ፤ ነሞትን ባይኤን ሴኑ ንያሉቲ፤ ገሩ ህንደንደአን።</char> <verse eid="LUK 13:24"/><verse number="25" style="v" sid="LUK 13:25"/><char style="wj">አባን መነ ሰና ተካ ከኤ በልበልቸ ጩፈትናን እስን አለ ዻበተኒ በልበለ ሩሩኩታ፣ ‘ያ ጎፍታ በልበለ ኑ በን’ ጄተኒ ከዸቱ።</char></para>
  <para style="p" vid="LUK 13:25">
    <char style="wj">“እን ገሩ ዴብሴ፣ ‘አን እስን ህንቤኩ ዮካን ኤሳ አከ ዹፍተን ህንቤኩ’ እስኒን ጄዸ።</char><verse eid="LUK 13:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 13:26"/>
    <char style="wj">“እስንሞ፣ ‘ኑ ስ ወጅን ኛትኔ ዹግኔረ፤ አትስ ዳንዲኬኘረት በርሲፍቴርተ’ ጄቱን።</char><verse eid="LUK 13:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 13:27"/>
    <char style="wj">“እን ገሩ ዴብሴ፣ ‘አን እስን ህንቤኩ ዮካን ኤሳ አከ ዹፍተን ህንቤኩ። እስን ወር ሀምነ ሆጄተን ሁንድኑ ነ ብራ በዳ!’ ጄዸ።</char><verse eid="LUK 13:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 13:28"/>
    <char style="wj">“ዮሙ አብረሃም፣ ይስሃቅ፣ ያቆቢፊ ራጆተ ሁንደ ሞቱማ ዋቃ ኬሰት አርግተኒ፣ ኦፊኬሰኒሞ ገድ ደርበተምተን፣ አችት ቦኡፊ እልካን ቀሩቱ ተአ።</char> <verse eid="LUK 13:28"/><verse number="29" style="v" sid="LUK 13:29"/><char style="wj">ነሞትንስ በአ ቢፍቱቲፊ ልጠ ቢፍቱቲ፣ ካባፊ ክባ ዹፈኒ ሞቱማ ዋቃ ኬሰት ማዲት ንዽኣቱ።</char> <verse eid="LUK 13:29"/><verse number="30" style="v" sid="LUK 13:30"/><char style="wj">ዹጉማኑ ከኔን ወረ ዹማ ተአን ኬሳ ከኔን ወረ ጀልቀባ፣ ከኔን ወረ ጀልቀባ ተአን ኬሳሞ ወረ ዹማ ተአን ጅሩ።”</char><verse eid="LUK 13:30"/></para>
  <para style="s1">ዬሱስ ዬሩሳሌሚፍ ገዱሳ</para>
  <para style="r">
    <ref loc="LUK 13:34">13፥34</ref>፣<ref loc="LUK 13:35">35</ref> ኩወፈ – <char style="xt"><ref loc="MAT 23:37-39">ማቴ 23፥37‑39</ref></char></para>
  <para style="r">
    <ref loc="LUK 13:34">13፥34</ref>፣<ref loc="LUK 13:35">35</ref> ኩወእ – <char style="xt"><ref loc="LUK 19:41">ሉቃ 19፥41</ref></char></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 13:31"/>ዬሮ ሰነ ፈሪሶተ ኬሳ ነሞትን ቶኮ ቶኮ ገረ ዬሱስ ዹፈኒ፣ “ሰበቢ ሄሮድስ ስ አጄሱ በርባዱፍ አሲ ዴሚ እዶ ብራ ዸቅ” ጄዸኒን።<verse eid="LUK 13:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 13:32"/>እንስ አከነ ጄዼ ዴብሴ፤ <char style="wj">“ዸቃቲ ዋንጎ ሰናን፣ ‘ኩኖ፣ አን ሀርኣፊ ቦር ሀፉሮተ ሀሞ ነንባሰ፤ ነሞተ ዹኩብሰተንስ ነንፈይሰ፤ ጉያ ሰደፋትሞ ሆጂኮ ነንፍጠዸ’ ጄዻ።</char> <verse eid="LUK 13:32"/><verse number="33" style="v" sid="LUK 13:33"/><char style="wj">ዋን ፌዼዩ ታናን፣ አን ሀርኣፊ ቦር፣ እፍታንስ አዴምሰኮ እት ፉፉቱ ናፍ መለ፤ ራጂን ዬሩሳሌሚን አለት ዱኡ ህንቀቡቲ!</char><verse eid="LUK 13:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 13:34"/>
    <char style="wj">“ያ ዬሩሳሌም፣ ያ ዬሩሳሌም፣ አት ከን ራጆተ አጄፍቱ፣ ወረ ገረኬት ኤርገመንስ ከን ዸጋዻን ቱምቱ፣ አኩመ እንዳንቆን ጩጪሼ ቆቾሼ ጀለት ወልት ቀበቱ ሰነ አንስ እጆሌኬ ወልት ቀቡፍ ዬሮ ሜቀን ሀዌ! እስን ገሩ ህንበርባድኔ።</char> <verse eid="LUK 13:34"/><verse number="35" style="v" sid="LUK 13:35"/><char style="wj">ኩኖ፣ መንኬሰን ኦኔ እስኒ ሀፈ። አን እስንትን ህመ፤ እስን ሀመ፣ ‘እን መቃ ጎፍታቲን ዹፉ ሱን ኤብፈማዸ’</char><note caller="+" style="f"><char style="fr" closed="false">13፥35 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 118:26">ፋር 118፥26</ref></char></char></note> <char style="wj">ጄተንት ለመተ ነ ህንአርግተን።”</char><verse eid="LUK 13:35"/></para>
  <chapter eid="LUK 13"/>
  <chapter number="14" style="c" sid="LUK 14"/>
  <para style="s1">ዬሱስ መነ ፈሪስቸ ቶኮት</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 14:1"/>ጉያ ሰንበታ ቶኮ ዮሙ ዬሱስ ቡዴነ ኛቹፍ መነ ፈሪስቸ ቤከማ ቶኮ ዸቄት፣ ነሞትን ጥዬፈተኒ እሰ እላላ ቱረን። <verse eid="LUK 14:1"/><verse number="2" style="v" sid="LUK 14:2"/>ነምች ዸግንሳ ዺተኤ ቶኮስ ፉለሳ ዱረ ቱሬ። <verse eid="LUK 14:2"/><verse number="3" style="v" sid="LUK 14:3"/>ዬሱስስ፣ <char style="wj">“ጉያ ሰንበታቲን ነመ ፈይሱን ንኤየመመሞ ህንኤየመሙ?”</char> ጄዼ ፈሪሶታፊ ሀዮተ ሴራ ጋፈቴ። <verse eid="LUK 14:3"/><verse number="4" style="v" sid="LUK 14:4"/>እሳን ገሩ ንጨልእሰን፤ እንስ ነምቸ ሀርካን ቀቀቤ ፈይሴ ገድ እሰ ለክሴ።<verse eid="LUK 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 14:5"/>እንስ፣ <char style="wj">“እስን ኬሳ ነምን ቶኮ ዮ እልመ ዮካን ቆትዮ ጉያ ሰንበታቲን ቦለ ኬሰ ቡኤ ቀባቴ፣ እን ዬሩመ ሰነ ሀርክሴ ቦለ ኬሳ ህንባሱ?”</char> ጄዼ እሳን ጋፈቴ። <verse eid="LUK 14:5"/><verse number="6" style="v" sid="LUK 14:6"/>እሳን ገሩ ዴቢ ኬኑ ህንደንዴኜ።<verse eid="LUK 14:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 14:7"/>እንስ ዮሙ አከ ኬሱሞትን ሱን እዶ ኡልፍና ፍለተን ሁበቴት አከነ ጄዼ ፈኬኘ ከነ እሳንት ህሜ፤ <verse eid="LUK 14:7"/><verse number="8" style="v" sid="LUK 14:8"/><char style="wj">“ዮ ነምን ቶኮ ጭዸ ፉዻፊ ሄሩማት ስዋሜ፣ እዶ ኡልፍና ህንታእን፤ ተሪ ነምን ስ ጫላ ኡልፍነ ቀቡ ቶኮ ዋመሜረ ተኣቲ።</char> <verse eid="LUK 14:8"/><verse number="9" style="v" sid="LUK 14:9"/><char style="wj">ነምች እስን ለማኑ ዋሜ ሱን ዹፌ፣ ‘ነምቸ ከናፍ ከእ’ ሲን ጄዸ፤ አትስ ቃኖፍቴ ዸቅጤ ለፈ እዶ ሁንዱማ ገድ ተኤ ቴሰ።</char> <verse eid="LUK 14:9"/><verse number="10" style="v" sid="LUK 14:10"/><char style="wj">አት ገሩ ዮሙ ዋመምቱ አከ ነምች ስዋሜ ሱን ዬሮ ዹፉት፣ ‘ያ ምቹኮ እዶ ኦል ኣኑት ሂቅ’ ሲን ጄዹፍ ዸቂ ለፈ እዶ ሁንዱማ ገድ ተኤ ታእ፤ ዮስ ፉለ ወረ ስ ወጅን ማዲት ዽኣተን ሁንዱማ ዱረት ኡልፍነ አርገታቲ።</char> <verse eid="LUK 14:10"/><verse number="11" style="v" sid="LUK 14:11"/><char style="wj">ነምን ኦል ኦፍ ቀቡ ሁንድኑ ገድ ቀበማቲ፤ ነምን ገድ ኦፍ ቀቡ ሁንድኑሞ ኦል ቀበመ።”</char><verse eid="LUK 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 14:12"/>ዬሱስስ ነምቸ እሰ ዋሜ ሰናን አከነ ጄዼ፤ <char style="wj">“አት ዮሙ ላቀነ ዮካን እርባተ ቆጴስቱ ምቾተኬ ዮካን ኦቦሎተኬ፣ ዮካን ፍሮተኬ፣ ዮካን ኦሎተኬ ወረ ሶሬዪ ህንዋምን፤ ዮ አከስ ጎቴ እሳንስ ዴብሰኒ ስ ዋሙ፤ ገቲንኬስ ሲፍ ዴብፈመ።</char> <verse eid="LUK 14:12"/><verse number="13" style="v" sid="LUK 14:13"/><char style="wj">ገሩ ዮሙ ጭዸ ቆጴስቱ ህዬዪ፣ ናፈ፣ ኦኮላፊ ጃማ ዋም።</char> <verse eid="LUK 14:13"/><verse number="14" style="v" sid="LUK 14:14"/><char style="wj">ሰበቢ እሳን ዋን ሲፍ ዴብሰን ህንቀብኔፍ አት ንኤብፈምተ፤ ገቲንኬ ጉያ ዱኣ ከኡ ቀጄልቶታት ሲፍ ዴብፈማቲ።”</char><verse eid="LUK 14:14"/></para>
  <para style="s1">ፈኬኘ ጭዸ ጉዳ</para>
  <para style="r">
    <ref loc="LUK 14:16-24">14፥16‑24</ref> ኩወእ – <char style="xt"><ref loc="MAT 22:2-14">ማቴ 22፥2‑14</ref></char></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 14:15"/>ወረ እሰ ወጅን ማዲት ዽኣተን ኬሳ ነምች ቶኮ ዮሙ ዋን ከነ ዸገኤት ዬሱሲን፣ “ነምን ሞቱማ ዋቃ ኬሰት ማዲት ዽኣቱ ኤብፈማዸ” ጄዼ።<verse eid="LUK 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 14:16"/>ዬሱስሞ አከነ ጄዼ ዴብሴ፤ <char style="wj">“ነምች ቶኮ ጭዸ ጉዳ ቆጴሴ ኬሱሞተ ሄዱ አፌሬ።</char> <verse eid="LUK 14:16"/><verse number="17" style="v" sid="LUK 14:17"/><char style="wj">ነምች ሱንስ ሰኣቲ ኛታት አከ እን፣ ‘ኩኖ፣ ወን ሁንድኑ ቆጴፈሜራቲ ኮታ’ ጄዼ ወረ አፌረመን ሰነት ህሙፍ ገርብቸሳ ኤርጌ።</char><verse eid="LUK 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 14:18"/>
    <char style="wj">“ገሩ እሳን ሁንድ ብፉመ ቶኮን ሰበበ ዽኤፈቹ ጀልቀበን፤ እን ጀልቀባ፣ ‘አን ለፈ ቆቲሳ ብተዼረ፤ ከናፉ ዸቄን እላሉ ቀባቲ ማሎ ነ ህንኮመትን’ ጄዼን።</char><verse eid="LUK 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 14:19"/>
    <char style="wj">“እን ካን፣ ‘አን ቆትዮ ጭምዲ ሸን ብተዼረ፤ እሳን ሌንጅሱፍ ዴሙን ጅራቲ፣ ማሎ ነ ህንኮመትን’ ጄዼን።</char><verse eid="LUK 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 14:20"/>
    <char style="wj">“አመሌ እን ካን፣ ‘አን ዽኦን ኒቲ ፉዼ፤ ከናፉ ዹፉ ህንደንደኡ’ ጄዼን።</char><verse eid="LUK 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 14:21"/>
    <char style="wj">“ገርብች ሱንስ ዴብኤ ዋን ከነ ጎፍታሳት ህሜ። አባን መነ ሰናስ ኣሬ፣ ‘ደፊ ከራ ጉዳፊ ዳንዲ ቀልኣ መጋላት አች በኢቲ ህዬዪ፣ ናፈ፣ ጃማፊ ኦኮላ ፍዲ ኦል ሴንስስ’ ጄዼ ገርብቸሳ አጀጄ።</char><verse eid="LUK 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 14:22"/>
    <char style="wj">“ገርብች ሱንስ፣ ‘ያ ጎፍታ፣ ወን አት አጀጄ ሁንድ ራወቴረ፤ ገሩ አመሌ እዶን ጅረ’ ጄዼን።</char><verse eid="LUK 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 14:23"/>
    <char style="wj">“ጎፍትችስ ገርብቸሳቲን አከነ ጄዼ፤ ‘አከ መንኮ ጉተሙፍ ከራ ጉዳፊ ዳንዲ ባድያት አች በኢቲ አከ እሳን ኦል ገለን ድርቅሲስ።</char> <verse eid="LUK 14:23"/><verse number="24" style="v" sid="LUK 14:24"/><char style="wj">አን እስንትን ህመ፤ ነሞተ ዋመመን ሰነ ኬሳ ነምን ቶኮዩ ማዲኮራ አፋኒን ህንቀቡ።’ ”</char><verse eid="LUK 14:24"/></para>
  <para style="s1">ገቲ በረታ ዬሱስ ተኡን ነመ ባስሱ</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 14:25"/>ነሞትን ባይኤን ዬሱስ ወጅን ዴማ ቱረን፤ እንስ ገረገሌ አከነ እሳኒን ጄዼ፤ <verse eid="LUK 14:25"/><verse number="26" style="v" sid="LUK 14:26"/><char style="wj">“ነምን ገረኮ ዹፉ ከምዩ ዮ አባሳቲፊ ሃዸሳ፣ ኒቲሳቲፊ እጆሌሳ፣ ኦቦሎተሳቲፊ ኦቦሌቶተሳ አከሱመስ ሉቡሳሌ ህንጅብኔ እን በረታኮ ተኡ ህንደንደኡ።</char> <verse eid="LUK 14:26"/><verse number="27" style="v" sid="LUK 14:27"/><char style="wj">ነምን ፈኖ ኦፊሳ ባዸቴ ነ ዱካ ህንቡኔ ከምዩስ በረታኮ ተኡ ህንደንደኡ።</char><verse eid="LUK 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 14:28"/>
    <char style="wj">“ሜ እስን ኬሳ ነምን ቶኮ ገሞ እጃረቹ በርባደ ሃጄኑ፤ ነምች ሱን ገሞ ሰነ እጃሬ ፍጡፍ ሆሪ ገኣ ቀባቹፊ ቀባቹ ባቹሳ ቤኩፍ ዱራን ዱርሴ ታኤ ገቲሳ ህንሄሬገቱ?</char> <verse eid="LUK 14:28"/><verse number="29" style="v" sid="LUK 14:29"/><char style="wj">ዮ ከና አቺ ዮሙ እን ሁንዴ ካኤ ፍጡ ደዸቡት፣ ነሞትን አርገን ሁንድ እት ቆሱ።</char> <verse eid="LUK 14:29"/><verse number="30" style="v" sid="LUK 14:30"/><char style="wj">እሳንስ፣ ‘ነምች ኩን እጃሩ ጀልቀቤ ፍጡ ደዸቤ’ ጄዹ።</char><verse eid="LUK 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 14:31"/>
    <char style="wj">“ዮካን ሜ ሞቲን ቶኮ ሞቲ ብራ ሎሉ ዸቀ ሃጄኑ፤ እን ሞቲ ሎልቶተ ኩመ ድግደማን እሰት ዹፉ ቶኮ ሎልቶተ ኩመ ኩዸኒን ኦፍራ ሎሉ ደንደኡፊ ደንደኡ ባቹሳ ዱራን ዱርሴ ታኤ እት ህንያዱ?</char> <verse eid="LUK 14:31"/><verse number="32" style="v" sid="LUK 14:32"/><char style="wj">ዮ ህንደንዴኜሞ ኡቱ ሞትች ካን እሰራ ፈጎ ጅሩ በከ ቡኦተ እት ኤርጌ አከ ነጋን ቡኡ ከዸተ።</char> <verse eid="LUK 14:32"/><verse number="33" style="v" sid="LUK 14:33"/><char style="wj">አከኑመስ እስን ኬሳ ነምን ዋን ቀቡ ሁንደ ህንዺፍኔ ከምዩ በረታኮ ተኡ ህንደንደኡ።</char><verse eid="LUK 14:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 14:34"/>
    <char style="wj">“ሶግድ ጋሪዸ፤ ገሩ ዮ እን ምኣሳ ዸቤ፣ ምኣንሳ አከሚን ዴብፈሙ ደንደአ?</char> <verse eid="LUK 14:34"/><verse number="35" style="v" sid="LUK 14:35"/><char style="wj">እን ብዮፍ ዮካን ቱላ ኮሲቲፍ ፋይዳ ህንቀቡ፤ እን ገድ ገተመ።</char></para>
  <para style="p" vid="LUK 14:35">
    <char style="wj">“ነምን ጉረ ዸገኡ ቀቡ ከምዩ ሃዸገኡ።”</char><verse eid="LUK 14:35"/></para>
  <chapter eid="LUK 14"/>
  <chapter number="15" style="c" sid="LUK 15"/>
  <para style="s1">ፈኬኘ ሆላ በዴ</para>
  <para style="r">
    <ref loc="LUK 15:4-7">15፥4‑7</ref> ኩወፈ – <char style="xt"><ref loc="MAT 18:12-14">ማቴ 18፥12‑14</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 15:1"/>ጋፍ ቶኮ ወር ቀረጠ ፉዸኒፊ ጩበሞትን ሁንድ ዬሱስን ዸጌፈቹዻፍ እሰ ብረት ወልት ቀበማ ቱረን። <verse eid="LUK 15:1"/><verse number="2" style="v" sid="LUK 15:2"/>ፈሪሶትኒፊ በርሲስቶትን ሴራ ገሩ፣ “ነምች ኩን ጩበሞተ ስመተ፤ እሳን ወጅንስ ንኛተ” ጄዸኒ ጉንጉመን።<verse eid="LUK 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 15:3"/>ዬሱስስ አከነ ጄዼ ፈኬኘ ከነ እሳንት ህሜ፤ <verse eid="LUK 15:3"/><verse number="4" style="v" sid="LUK 15:4"/><char style="wj">“እስን ኬሳ ነምን ሆሎተ ዽበ ቀቡ ቶኮ ዮ ሆላን ቶኮ ጀላ በዴ፣ ሆሎተ ሰገልተሚ ሰገለን ካን ለፈ ትካት ዺሴ ሀመ ሆላ በዴ ሰነ አርገቱት ከን በርባዱ ህንዴምኔ ኤኙ?</char> <verse eid="LUK 15:4"/><verse number="5" style="v" sid="LUK 15:5"/><char style="wj">ዮሙ አርገቱስ ገመዴ ገቲቲሳረት ባቴ፣</char> <verse eid="LUK 15:5"/><verse number="6" style="v" sid="LUK 15:6"/><char style="wj">መነሳት ገለ። እንስ ምቾተሳቲፊ ኦሎተሳ ወልት ዋሜ፣ ‘አን ሆላኮ ከን በዴ ሰነ አርገዼራቲ ነ ወጅን ገመዳ’ ጄዸ።</char> <verse eid="LUK 15:6"/><verse number="7" style="v" sid="LUK 15:7"/><char style="wj">አን እስንትን ህመ፤ ሰበቢ ቀጄልቶተ ቀልቢ ጅጂረቹን እሳን ህንበርባችፍኔ ሰገልተሚ ሰገሊረ ሰበቢ ጩበማ ቀልቢ ጅጂረቱ ቶኮቲፍ ሰሚ ኬሰት ገመቹን ጉዳን አከሱመ ንተአ።</char><verse eid="LUK 15:7"/></para>
  <para style="s1">ፈኬኘ ሳንትመ በዴ</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 15:8"/>
    <char style="wj">“ዮካን ሜ ዱበርቲ ሳንትመ ሜቲ ኩዸን ቀብዱ ጀላ ቶኮ በዴረ ሃጄኑ፤ እሼን እብሳ ቀብሲፈቴ፣ መነስ ሀርቴ ሀመ ሳንትመ ሰነ አርገቱት ጀቤስቴ ህንበርባደቱ?</char> <verse eid="LUK 15:8"/><verse number="9" style="v" sid="LUK 15:9"/><char style="wj">እሼንስ ዮሙ አርገቱት ምቾተሼቲፊ ኦሎተሼ ወልት ዋምቴ፣ ‘አን ሳንትመኮ ከን በዴ ሰነ አርገዼራቲ ነ ወጅን ገመዳ’ ጄት።</char> <verse eid="LUK 15:9"/><verse number="10" style="v" sid="LUK 15:10"/><char style="wj">አን እስንትን ህመ፤ ሰበቢ ጩበማ ቀልቢ ጅጂረቱ ቶኮቲፍ ኤርገሞትን ዋቃ አከሱመ ንገመዱ።”</char><verse eid="LUK 15:10"/></para>
  <para style="s1">ፈኬኘ እልመ በዴ</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 15:11"/>ዬሱስ እቱመ ፉፌ አከነ ጄዼ፤ <char style="wj">“ነምቸ እልማን ለመ ቀቡ ቶኮቱ ቱሬ።</char> <verse eid="LUK 15:11"/><verse number="12" style="v" sid="LUK 15:12"/><char style="wj">እልም ቁጥሱን አባሳቲን ‘ያ አባኮ፣ ቀቤኘኬራ ቆደ ነ ገኡ ናፍ ኬን’ ጄዼ። አባንስ ቀቤኘሳ ለማንሳኒቲፍ ንህሬ።</char><verse eid="LUK 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 15:13"/>
    <char style="wj">“እልም ቁጥሱን ሱንስ ኡቱ ህንቱርን ዋን ቀቡ ሁንደ ወልት ቀበቴ ብየ ፈጎ ዸቄ፤ አችትስ ቀቤኘሳ ጅሬኘ በሸነኑረት ንበሌሴ።</char> <verse eid="LUK 15:13"/><verse number="14" style="v" sid="LUK 15:14"/><char style="wj">ኤርገ እን ዋን ሁንደ ፍጤ ቦዴ ቤል ሀማን ብየ ሰነት ቡኤ፤ እንስ ረከቹ ጀልቀቤ።</char> <verse eid="LUK 15:14"/><verse number="15" style="v" sid="LUK 15:15"/><char style="wj">ከናፉ ዸቄ ለሚወን ብየሲ ኬሳ እሰ ቶኮት ገሌ፤ ነምች ሱንስ አከ እን ቦዬ ትክሱፍ ለፈ ትካት እሰ ኤርጌ።</char> <verse eid="LUK 15:15"/><verse number="16" style="v" sid="LUK 15:16"/><char style="wj">ጉርብችስ ቆለ ቦዬን ኛቱ ሰነ ኛቴ ገራ ጉተቹ ከጄለ ቱሬ፤ ገሩ ነምን ቶኮዩ ዋ እሰት ህንኬኑ ቱሬ።</char><verse eid="LUK 15:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 15:17"/>
    <char style="wj">“እንስ ዮሙ ኦፍ ቤኬት አከነ ጄዼ፤ ‘ተጃጅልቶትን መነ አባኮት ቀጨረመን ሀመምቱ ቡዴነ ገኤ እራ ሀፉ ቀበ! አን ገሩ አስት ቤላን ነንዱአ።</char> <verse eid="LUK 15:17"/><verse number="18" style="v" sid="LUK 15:18"/><char style="wj">አን ከኤን አባኮት ዴብኤ አከነ ጄዻን፤ “ያ አባኮ፣ አን ሰሚፊ ስት ጩቡ ሆጄዼረ።</char> <verse eid="LUK 15:18"/><verse number="19" style="v" sid="LUK 15:19"/><char style="wj">ስአች እልመኬ ጄዸሙን ናፍ ህንመሉ፤ ተጃጅልቶተኬ ኬሳ አከ እሰ ቶኮት ነ እላል።” ’</char> <verse eid="LUK 15:19"/><verse number="20" style="v" sid="LUK 15:20"/><char style="wj">እንስ ከኤ ገረ አባሳ ዸቄ።</char></para>
  <para style="p" vid="LUK 15:20">
    <char style="wj">“ገሩ ኡቱ እን ፈጎ ጅሩ አባንሳ እሰ አርጌ አከ መሌ ገራ ላፌፍ፤ ገረ እልመሳትስ ፊጌ እት መርሜ ዹንገቴ።</char><verse eid="LUK 15:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 15:21"/>
    <char style="wj">“ጉርብችስ፣ ‘ያ አባኮ፣ አን ሰሚፊ ስት ጩቡ ሆጄዼረ፤ ስአች እልመኬ ጄዸሙን ናፍ ህንመሉ’ ጄዼን።</char><verse eid="LUK 15:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 15:22"/>
    <char style="wj">“አባንሳ ገሩ ገርቦተሳቲን አከነ ጄዼ፤ ‘ደፋቲ ኡፈተ ኡፈተ ሁንደ ጫሉ ፍዳ እሰት ኡፍሳ፤ ቁበሳት ቁቤላ፣ ሚለ እሳትስ ኮጴ ካኣ።</char> <verse eid="LUK 15:22"/><verse number="23" style="v" sid="LUK 15:23"/><char style="wj">ድብቸ ገበታ ፍዳቲ ቀላ፤ ሃኛትኑ፤ ሃገመድኑስ።</char> <verse eid="LUK 15:23"/><verse number="24" style="v" sid="LUK 15:24"/><char style="wj">እልምኮ ኩን ዱኤ ቱሬቲ፤ አመሞ ጅሬኘት ዴብኤራ። በዴስ ቱሬ፤ አመሞ አርገሜረ።’ እሳንስ ገመዱ ጀልቀበን።</char><verse eid="LUK 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 15:25"/>
    <char style="wj">“ዬሮ ሰነት እልም እን ሀንገፍት ለፈ ቆቲሳ ቱሬ፤ እንስ ዬሮ ዹፌ መነት ዽኣቴት ሙዚቃፊ ስርበ ዸገኤ።</char> <verse eid="LUK 15:25"/><verse number="26" style="v" sid="LUK 15:26"/><char style="wj">ከናፉ ተጃጅልቶተ ኬሳ ነመ ቶኮ ዋሜ ዋን ተኣ ጅሩ ጋፈቴ።</char> <verse eid="LUK 15:26"/><verse number="27" style="v" sid="LUK 15:27"/><char style="wj">ተጃጅላን ሱንስ ዴብሴ፣ ‘ኦቦሌስኬ ገሌረ፤ አባንኬስ ዋን እልመሳ ነጋፊ ፈያዻን አርገቴፍ ድብቸ ገበታ ቀሌ’ ጄዼን።</char><verse eid="LUK 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 15:28"/>
    <char style="wj">“ኦቦሌስ ሀንገፍን ገሩ ኣሬ ኦል ሴኑ ድዴ፤ ከናፍ አባንሳ ገድ በኤ እሰ ከዸቴ።</char> <verse eid="LUK 15:28"/><verse number="29" style="v" sid="LUK 15:29"/><char style="wj">እንሞ ዴብሴ አባሳቲን አከነ ጄዼ፤ ‘እላ አን ወጎተ ከኔን ሁንደ አኩመ ገርባት ሲፍ ሆጄቻን ቱሬ፤ አጀጀኬሌ ድዴ ህንቤኩ። አት ገሩ አከ አን ምቾተኮ ወጅን ገመዱፍ ተኩማ እልሞ ሬኤ ቶኮሌ ናፍ ህንኬንኔ።</char> <verse eid="LUK 15:29"/><verse number="30" style="v" sid="LUK 15:30"/><char style="wj">ገሩ እልምኬ እን ሰጋገልቶተ ወጅን ቀቤኘኬ በሌሴ ኩን ዴብኤ መነት ገላን ድብቸ ገበታ ቀልቴፍ!’</char><verse eid="LUK 15:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 15:31"/>
    <char style="wj">“አባንሳስ አከነ ጄዼን፤ ‘ያ እልመኮ አት ዬሮ ሁንደ አኑመ ወጅን ጅርተ፤ ወን አን ቀቡ ሁንድኑስ ከኑመኬት።</char> <verse eid="LUK 15:31"/><verse number="32" style="v" sid="LUK 15:32"/><char style="wj">ገሩ ኦቦሌስኬ እን ዱኤ ቱሬ ኩን ዋን ጅሬኘት ዴብኤፍ ኑ ገመዱፊ እልልቹ ቀብነ። እን በዴ ቱሬ፤ አመሞ አርገሜረ።’ ”</char><verse eid="LUK 15:32"/></para>
  <chapter eid="LUK 15"/>
  <chapter number="16" style="c" sid="LUK 16"/>
  <para style="s1">ፈኬኘ ሆጂ አዴምስሳ አብሻለ ቶኮ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 16:1"/>ዬሱስ በረቶተሳቲን አከነ ጄዼ፤ <char style="wj">“ነምቸ ሶሬሰ ነመ ሆጂሳ አዴምስሱፍ ቀቡ ቶኮቱ ቱሬ፤ አከ ሆጂ አዴምስሳን ሱን ቀቤኘሳ ጀላ በሌሳ ጅሩስ ሶሬሰ ሰነት ህመን።</char> <verse eid="LUK 16:1"/><verse number="2" style="v" sid="LUK 16:2"/><char style="wj">ሶሬስ ሱንስ ሆጂ አዴምስሳ ሰነ ኦፍት ዋሜ፣ ‘ወን አን ዋኤኬ ዸገኡ ኩን ማሊ? አት ስአች ዋን ሆጂ አዴምስሳ ተኡ ህንደንዴኜፍ፣ ሆጂ አዴምስሳ ቱርቴ ሰነረት ገባሰ ናፍ ዽኤስ’ ጄዼን።</char><verse eid="LUK 16:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 16:3"/>
    <char style="wj">“ሆጂ አዴምስሳን ሱንስ ገራሳ ኬሰት አከነ ጄዼ፤ ‘ዋን ጎፍታንኮ ሆጂ ኬሳ ነ ባሱፍ፣ ማል ናፍ ወየ? ለፈ ቆቱፍ ሁምነ ህንቀቡ፤ ከዸቹሞ ነንቃነአ።</char> <verse eid="LUK 16:3"/><verse number="4" style="v" sid="LUK 16:4"/><char style="wj">አከ ዬሮ አን ሆጂ ኬሳ አርአሙት ነሞትን መነሳኒት ነ ስመተኒፍ ዋነን ጎዹ አኑ ቤከ።’</char><verse eid="LUK 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 16:5"/>
    <char style="wj">“እንስ ወረ ገቲን ጎፍታሳረ ጅሩ ቶኮ ቶኮን ዋሜ፣ እሰ ጀልቀባቲን፣ ‘እዳን ጎፍታኮ ሀመምቱ ስረ ጅረ?’ ጄዼ ጋፈቴ።</char><verse eid="LUK 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 16:6"/>
    <char style="wj">“ነምችስ፣ ‘ዘይቲ ኤጄርሳ ሁቦ ዽበ ሰዴት’ ጄዼ ዴብሴ።</char></para>
  <para style="p" vid="LUK 16:6">
    <char style="wj">“ሆጂ አዴምስሳን ሱንስ፣ ‘ወረቃ ወሊ ገልቴኬ ሆኡ፤ ደፊ ታኢቲ ዽበ ሀፉር ጄዺ በሬስ’ ጄዼን።</char><verse eid="LUK 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 16:7"/>
    <char style="wj">“እሰ ለመፋዻንስ፣ ‘ስረሞ ሀመምቱ ጅረ?’ ጄዼ ጋፈቴ።</char></para>
  <para style="p" vid="LUK 16:7">
    <char style="wj">“እንስ፣ ‘ቀመዲ ጉቦ ዽበ ቶኮ’ ጄዼን።</char></para>
  <para style="p" vid="LUK 16:7">
    <char style="wj">“ሆጂ አዴምስሳን ሱንስ፣ ‘ወረቃ ወሊ ገልቴኬ ሆኡቲ፣ 80 ጄዺ በሬስ’ ጄዼን።</char><verse eid="LUK 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 16:8"/>
    <char style="wj">“ሆጂ አዴምስሳን ህንአመነምኔ ሱን ዋን አብሻለ ተኤፍ ጎፍትች እሰ ጀጄ፤ ነሞትን አዱኛ ከና ወረ አከሳኒ ወጅን ሃጃሳኒ ጉተቹረት ነሞተ እፋ ጫላ አብሻሎታቲ።</char> <verse eid="LUK 16:8"/><verse number="9" style="v" sid="LUK 16:9"/><char style="wj">አን እስንትን ህመ፤ አከ እሳን ዬሮ ቀቤኝ ሱን ዹሙት መነ በረ በራት እስን ስመተኒፍ ቀቤኘ አዱኛቲን ኦፊኬሰኒፍ ምቾተ ሆረዻ።</char><verse eid="LUK 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 16:10"/>
    <char style="wj">“ነምን ዋን ጥኖት አመነሙ ከምዩ ዋን ባይኤትስ ንአመነመ፤ ነምን ዋን ጥኖት ህንአመነምኔ ከምዩሞ ዋን ባይኤትስ ህንአመነሙ።</char> <verse eid="LUK 16:10"/><verse number="11" style="v" sid="LUK 16:11"/><char style="wj">ዮስ እስን ዮ ቀቤኘ አዱኛት ህንአመነምኔ፣ ቀቤኘ ዹጋትሞ ኤኙቱ እስን አመነሬ?</char> <verse eid="LUK 16:11"/><verse number="12" style="v" sid="LUK 16:12"/><char style="wj">ዮ እስን ቀቤኘ ነመ ብራረት ህንአመነምኔ፣ ቀቤኘ መታኬሰኒሞ ኤኙቱ እስኒ ኬነሬ?</char><verse eid="LUK 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 16:13"/>
    <char style="wj">“ነምን ጎፍቶተ ለመ ተጃጅሉ ደንደኡ ቶኮዩ ህንጅሩ። እሰ ቶኮ ጅብቴ እሰ ካን ጃለታቲ፤ ዮካን እሰ ቶኮፍ ኦፍ ኬንቴ እሰ ካንሞ ቱፈተ። እስንስ ዋቃፊ ማለቀ ተጃጅሉ ህንደንዴሰን።”</char><verse eid="LUK 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 16:14"/>ፈሪሶትን ወር ማለቀ ጃለተን ዋን ከነ ሁንደ ዸገአኒ ዬሱስት ቆሰን። <verse eid="LUK 16:14"/><verse number="15" style="v" sid="LUK 16:15"/>እንስ አከነ እሳኒን ጄዼ፤ <char style="wj">“እስን ወረ ፉለ ነሞታ ዱረት ቀጄልቶተ ኦፍ ጎተኒዸ፤ ዋቅን ገሩ ገራኬሰን ቤከ። ወን ነመ ብረት አከ መሌ ከበጀሙ ፉለ ዋቃ ዱረት ጅብሲሳዻቲ።</char><verse eid="LUK 16:15"/></para>
  <para style="s1">በርሲሰ ደበለሜ</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 16:16"/>
    <char style="wj">“ሴሪፊ ራጆትን ሀመ ዮሀንስት ለብሰመን። ዬሮ ሰና ጀልቀቤ ወንጌል ሞቱማ ዋቃ ለለበማ ጅረ፤ ነምን ሁንድኑስ እት ገሉፍ ወል ዺበ።</char> <verse eid="LUK 16:16"/><verse number="17" style="v" sid="LUK 16:17"/><char style="wj">ሴረ ኬሳ ቱቃን ሁንዱማ ገዲ ዸበሙረ ሰሚፊ ለፍት ዸበሙቱ ሰልጰተ።</char><verse eid="LUK 16:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 16:18"/>
    <char style="wj">“ነምን ኒቲሳ ሂኬ ዱበርቲ ብራ ፉዹ ከምዩ ኤጀ ራወተ፤ ነምን ዱበርቲ ዽርሰሼ ሂክቴ ፉዹስ ኤጀ ራወተ።</char><verse eid="LUK 16:18"/></para>
  <para style="s1">ነምቸ ዱሬሳፊ አልኣዛር</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 16:19"/>
    <char style="wj">“ነምቸ ሶሬሰ ኡፈተ ዺልጌ ሀጲ ከን ቁንጬ ተልባራ ሆጄተሜ ኡፈቴ፣ ጉዩመ ጉያን ቀነኒዻን ጅራቱ ቶኮቱ ቱሬ።</char> <verse eid="LUK 16:19"/><verse number="20" style="v" sid="LUK 16:20"/><char style="wj">ከረሳ ዱረሞ ነምች ህዬስ አልኣዛር ጄዸሙ ከን ዸግንሳ ሁንድ መመዳኤ ቶኮ ጪሳ ቱሬ።</char> <verse eid="LUK 16:20"/><verse number="21" style="v" sid="LUK 16:21"/><char style="wj">እንስ ሀምባ ማዲ ሶሬሰ ሰናራ ሀርጨኡሌ ኛቹ ንከጄለ ቱሬ፤ ሰሮትንዩ ዹፈኒ መዳሳ አራቡ ቱረን።</char><verse eid="LUK 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 16:22"/>
    <char style="wj">“ጋፍ ቶኮ ነምች ህዬስ ሱን ዱናን ኤርገሞትን ዋቃ እሰ ባተኒ ገረ ቦባ አብረሃምት እሰ ጌሰን፤ ሶሬስችስ ዱኤ አዋለሜ።</char> <verse eid="LUK 16:22"/><verse number="23" style="v" sid="LUK 16:23"/><char style="wj">ኡቱ ሲኦል ኬሰት ዽጰቻ ጅሩስ ኦል ምልአቴ አብረሃምን ፈጎት፣ አልኣዛርንሞ ቦባ አብረሃም ኬሰት አርጌ።</char> <verse eid="LUK 16:23"/><verse number="24" style="v" sid="LUK 16:24"/><char style="wj">እንስ እዬ፣ ‘ያ አባኮ አብረሃም፣ ዋን አን እብደ ከነ ኬሰት ዽጰቻ ጅሩፍ ማሎ ገራ ናፍ ላፊቲ አከ እን ፊጤ ቁበሳ ብሻን ኬሰ ጩጴ አረበኮ ናፍ ቀበኔሱፍ አልኣዛርን ናፍ ኤርግ’ ጄዼን።</char><verse eid="LUK 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 16:25"/>
    <char style="wj">“አብረሃም ገሩ አከነ ጄዼ ዴብሴ፤ ‘ያ እልመኮ፣ አት በረ ጅሬኘኬቲት ዋን ጋሪ አከ አርገቴ፣ አልኣዛርሞ ዋን ሀማ አከ አርገቴ ያደዹ፤ አመ ገሩ አስት እሰት ቶሌረ፤ አትሞ ዽጰቻ ጅርተ።</char> <verse eid="LUK 16:25"/><verse number="26" style="v" sid="LUK 16:26"/><char style="wj">ዋን ከነ ሁንደረትስ፣ አከ ወር ኑ ብራ ገረኬሰን ዹፉ በርባደን ዹፉ ህንደንዴኜፍ ዮካን አከ ወር እስን ብራ ገረኬኘት ጬኡ ህንደንዴኜፍ ኑፊ እስን ግዱ ቦለ ጉዳቱ ጅረ።’</char><verse eid="LUK 16:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 16:27"/>
    <char style="wj">“ሶሬስ ሱንስ አከነ ጄዼ ዴብሴ፤ ‘ዮስ ያ አባ፣ አከ አት ገረ መነ አባኮት አልኣዛርን ናፍ ኤርግቱ ስን ከዸዸ፤</char> <verse eid="LUK 16:27"/><verse number="28" style="v" sid="LUK 16:28"/><char style="wj">አን ኦቦሎተ ሸን ቀባቲ፤ አከ እሳንስ እዶ ዽጵና ከነ ህንዹፍኔፍ እን ዸቄ እሳን ሃአኬከቺሱ።’</char><verse eid="LUK 16:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 16:29"/>
    <char style="wj">“አብረሃም ገሩ፣ ‘እሳን ሙሴፊ ራጆተ ቀቡ፤ እሳኑመ ሃዸገአን’ ጄዼ።</char><verse eid="LUK 16:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 16:30"/>
    <char style="wj">“ዱሬስችስ፣ ‘አከስ ምት፤ ያ አባኮ አብረሃም፤ ዮ ወረ ዱአን ኬሳ ነምን ቶኮ ገረሳኒ ዸቄ ገሩ፣ እሳን ቀልቢ ንጅጂረቱ’ ጄዼን።</char><verse eid="LUK 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 16:31"/>
    <char style="wj">“አብረሃምስ፣ ‘እሳን ዮ ሙሴፊ ራጆተ ህንዸጌኜ፣ ዮ ነምን ቶኮ ወረ ዱአን ኬሳ ከኤሌ ህንአመነን’ ጄዼን።”</char><verse eid="LUK 16:31"/></para>
  <chapter eid="LUK 16"/>
  <chapter number="17" style="c" sid="LUK 17"/>
  <para style="s1">ጩቡ፣ አመንቲ፣ ድርቀመ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 17:1"/>ዬሱስ በረቶተሳቲን አከነ ጄዼ፤ <char style="wj">“ወንቶትን አከ ነሞትን ጉፈተን ጎዸን ዹፉን ህንኦሉ፤ ገሩ ነመ ወንቶትን ኩኔን ከራሳቲን ዹፈኒፍ ወዮ!</char> <verse eid="LUK 17:1"/><verse number="2" style="v" sid="LUK 17:2"/><char style="wj">እን ወረ ጥጥና ከኔን ኬሳ ቶኮሌ ጉፈቺሱ መና ዸጋን ዳኩ ሞርመሳት ህዸሜ ገላነት ኡቱ ደርበተሜ እሳፍ ወየ ቱሬ።</char> <verse eid="LUK 17:2"/><verse number="3" style="v" sid="LUK 17:3"/><char style="wj">ከናፉ ኦፍ ኤገዻ።</char></para>
  <para style="p" vid="LUK 17:3">
    <char style="wj">“ዮ ኦቦሌስኬ የከ ስት ሆጄቴ እሰ እፈዹ፤ ዮ እን ቀልቢ ጅጂረቴሞ ዺፈመ ጎዺፍ።</char> <verse eid="LUK 17:3"/><verse number="4" style="v" sid="LUK 17:4"/><char style="wj">ዮ እን ጉያ ቶኮት ዬሮ ቶርበ ጩቡ ስት ሆጄቴ ዬሮ ቶርበኑ ስት ዴብኤ፣ ‘አን ቀልቢ ነንጅጂረዸ’ ሲን ጄዼ ዺፈመ ጎዺፍ።”</char><verse eid="LUK 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 17:5"/>ኤርገሞትንስ ጎፍታዻን፣ “አመንቲኬኘ ኑ ጉድስ” ጄዸን።<verse eid="LUK 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 17:6"/>እንስ አከነ ጄዼ ዴብሴ፤ <char style="wj">“እስን አመንቲ ጥኖ ሀመ እጀ ሰናፍጫሌ ዮ ቀባተን፣ ሙከ ቅልጡ ከናን፣ ‘ቡቀኢቲ ገላነ ኬሰ ዻበም!’ ጄቹ ደንዴሱ፤ እንስ እስኒ አጀጀመ።</char><verse eid="LUK 17:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 17:7"/>
    <char style="wj">“እስን ኬሳ ነምን ቶኮ ገርብቸ ለፈ ቆቱ ዮካን ከን ሆሎተ ትክሱ ቀበ ሃጄኑ፤ እን ዬሮ ገርብች ሱን አላ ገሉት፣ ‘ደፊ ኮቱቲ ታኢ ዋ ኛዹ’ ጄዻኒ?</char> <verse eid="LUK 17:7"/><verse number="8" style="v" sid="LUK 17:8"/><char style="wj">ቆደ ከና እን ገርብቸ ሰናን፣ ‘እርባተ ናፍ ቆጴስ፤ ሀመ አን ኛዼ ዹጉት መርጥፈዹቲ ነ ተጃጅል፤ ሰነ ቦዴ አት ንኛታ፤ ንዹግደስ’ ህንጄዹኒ?</char> <verse eid="LUK 17:8"/><verse number="9" style="v" sid="LUK 17:9"/><char style="wj">ነምችስ ሰበቢ ገርብች ሱን ዋን አጀጀሜ ሰነ ራወቴፍ እሰ ንገለቴፈታ?</char> <verse eid="LUK 17:9"/><verse number="10" style="v" sid="LUK 17:10"/><char style="wj">ከናፉ እስንስ ዮሙ ዋን አጀጀምተን ሁንደ ራወተንት፣ ‘ኑ ገርቦተ ፋይዳ ህንቀብኔዸ፤ ዋኑመ ሆጄቹ ቀብኑ ቆፈ ሆጄትኔ’ ጄዻ።”</char><verse eid="LUK 17:10"/></para>
  <para style="s1">ለምጣኦትን ኩዸን ፈዩሳኒ</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 17:11"/>ዬሱስ ኡቱ ዬሩሳሌም ዸቁ ሰማርያፊ ገሊላ ግዱ ደርባ ቱሬ። <verse eid="LUK 17:11"/><verse number="12" style="v" sid="LUK 17:12"/>አኩመ እን ገንደ ቶኮ ሴኔንስ፣ ነሞትን ለምጣአን ኩዸን እሰት ዹፈን። እሳንስ ፈጎ ዸዻበተኒ፣ <verse eid="LUK 17:12"/><verse number="13" style="v" sid="LUK 17:13"/>ሰገሌሳኒ ኦል ፉዸተኒ፣ “ዬሱስ ያ ጎፍታ፣ ኑ ነእ!” ጄዸን።<verse eid="LUK 17:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 17:14"/>እንስ ዮሙ እሳን አርጌት፣ <char style="wj">“ዸቃቲ ሉቦተት ኦፍ አርግሲሳ!”</char> ጄዼን፤ እሳንስ ኡቱመ ዴማ ጅረኑ ቁልቁላአን።<verse eid="LUK 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 17:15"/>እሳን ኬሳስ እን ቶኮ ዮሙ ፈዩሳ አርጌት ሰገሌ ጉዳዻን ዋቃፍ ኡልፍነ ኬና ዴብኤ ዹፌ። <verse eid="LUK 17:15"/><verse number="16" style="v" sid="LUK 17:16"/>አደሳቲንስ ሚለ ዬሱስረት ጎምብፈሜ እሰ ገለቴፈቴ፤ እንስ ነመ ሰማርያ ቱሬ።<verse eid="LUK 17:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 17:17"/>ዬሱስስ አከነ ጄዼ ጋፈቴ፤ <char style="wj">“ኩርነኑ ቁልቁላአኒሩ ምቲ? ዮስ ወር ሀፈን ሰገለን ኤሰ ዸቀን?</char> <verse eid="LUK 17:17"/><verse number="18" style="v" sid="LUK 17:18"/><char style="wj">ነመ ኦርማ ከነ መሌ ነምን ዴብኤ ዋቃፍ ገለተ ገልቹ ቶኮዩ ህንአርገምኔ?”</char> <verse eid="LUK 17:18"/><verse number="19" style="v" sid="LUK 17:19"/>ዬሱስስ፣ <char style="wj">“ከኢ ዴም፤ አመንቲንኬ ስ ፈይሴራቲ”</char> ጄዼን።<verse eid="LUK 17:19"/></para>
  <para style="s1">ዹፋቲ ሞቱማ ዋቃ</para>
  <para style="r">
    <ref loc="LUK 17:26">17፥26</ref>፣<ref loc="LUK 17:27">27</ref> ኩወፈ – <char style="xt"><ref loc="MAT 24:37-39">ማቴ 24፥37‑39</ref></char></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 17:20"/>ፈሪሶትንስ ሞቱማን ዋቃ ዮም አከ ዹፉ ዬሱስን ጋፈተን፤ እንስ አከነ ጄዼ ዴብሴፍ፤ <char style="wj">“ሞቱማን ዋቃ ነመት ሙልአቻ ህንዹፉ፤</char> <verse eid="LUK 17:20"/><verse number="21" style="v" sid="LUK 17:21"/><char style="wj">ነሞትንስ፣ ‘ሞቱማን ዋቃ ኩኖ አስ ጅረ’ ዮካን ‘ኩኖ አች ጅረ’ ህንጄዸን፤ ሞቱማን ዋቃ እስን ግዱ ጅራቲ።”</char><verse eid="LUK 17:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 17:22"/>እንስ በረቶተሳቲን አከነ ጄዼ፤ <char style="wj">“ዬሮን እስን እት ጉዮተ እልመ ነማ ኬሳ እሰ ቶኮ አርጉ ሀውተን ንዹፈ፤ ገሩ ህንአርግተን።</char> <verse eid="LUK 17:22"/><verse number="23" style="v" sid="LUK 17:23"/><char style="wj">ነሞትን፣ ‘እን ኩኖ አች ጅረ!’ ዮካን ‘ኩኖ አስ ጅረ’ እስኒን ጄዹ፤ እስን ገሩ ህንዸቅና፤ እሳን ዱካስ ህንቡእና።</char> <verse eid="LUK 17:23"/><verse number="24" style="v" sid="LUK 17:24"/><char style="wj">እልም ነማ ጉያሳት አኩመ በለቄስ በለቄሰኤ ገመ ቶኮ ሀመ ገመ ካኒት ሰሚ እብሱ ንተኣቲ።</char> <verse eid="LUK 17:24"/><verse number="25" style="v" sid="LUK 17:25"/><char style="wj">እን ገሩ ዱራን ዱርሴ አከ መሌ ዽጰቹፊ ዸሎተ ከናን ቱፈተሙ ቀበ።</char><verse eid="LUK 17:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 17:26"/>
    <char style="wj">“አኩመ በረ ኖህ ተኤ ሰነ፣ ዬሮ እልመ ነማትስ አከሱመ ንተአ።</char> <verse eid="LUK 17:26"/><verse number="27" style="v" sid="LUK 17:27"/><char style="wj">ሀመ ጋፈ ኖህ ዶኒ ሴኔት ነሞትን ኛቻ፣ ዹጋ፣ ፉዻ፣ ሄሩማስ ቱረን። ብሻን በዲሳስ ዹፌ ሁንደሳኒ በሌሴ።</char><verse eid="LUK 17:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 17:28"/>
    <char style="wj">“በረ ሎጥስ አከሱመ ቱሬ፤ ነሞትን ኛቻ፣ ዹጋ፣ ብተቻ፣ ጉርጉረቻ፣ ብቅልቱ ዻበቻ፣ መነስ እጃረቻ ቱረን።</char> <verse eid="LUK 17:28"/><verse number="29" style="v" sid="LUK 17:29"/><char style="wj">ጉያ ሎጥ ሶዶሚ በኤት ገሩ እብዲፊ ድኚን ሰሚራ ሮቤ ሁንደሳኒ በሌሴ።</char><verse eid="LUK 17:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 17:30"/>
    <char style="wj">“ጉያ እልም ነማ ሙልአቱትስ አከሱመ ተአ።</char> <verse eid="LUK 17:30"/><verse number="31" style="v" sid="LUK 17:31"/><char style="wj">ጉያ ሰነ ነምን በንቲ መናረ ጅሩ ከን መነ ኬሳ ምአ ቀቡ ምአ ሰነ ፉዸቹፍ ገድ ቡኡ ህንመሉ። አከሱመሞ ነምን ለፈ ቆቲሳ ኬሰ ጅሩ ቶኮዩ ዋን ቶኮፍሌ መነት ህንዴብእን።</char> <verse eid="LUK 17:31"/><verse number="32" style="v" sid="LUK 17:32"/><char style="wj">ኒቲ ሎጥ ያደዻ!</char> <verse eid="LUK 17:32"/><verse number="33" style="v" sid="LUK 17:33"/><char style="wj">ነምን ሉቡሳ ኤገቹ ያሉ ከምዩ ሉቡሳ ንዸበ፤ ነምን ሉቡሳ ዸቡ ከምዩ ሉቡሳ ንቱርፈተ።</char> <verse eid="LUK 17:33"/><verse number="34" style="v" sid="LUK 17:34"/><char style="wj">አን እስንትን ህመ፤ ሀልከን ሰነ ነሞትን ለመ ስሬ ቶኮረ ንረፉ፤ እን ቶኮ ንፉዸተመ፤ ካንሞ ንሀፈ።</char> <verse eid="LUK 17:34"/><verse number="35" style="v" sid="LUK 17:35"/><char style="wj">ዱበርቶትን ለመ ወሊ ወጅን ምዻን ዳኩ፤ እሼን ቶኮ ንፉዸተምት፤ ካንሞ ንሀፍት።</char> [ <verse eid="LUK 17:35"/><verse number="36" style="v" sid="LUK 17:36"/><char style="wj">ነሞትን ለመ ለፈ ቆቲሳ ኬሰ ጅሩ፤ ቶኮ ንፉዸተመ፤ ካንሞ ንሀፈ።”</char>]<note caller="+" style="f"><char style="fr" closed="false">17፥36 </char><char style="ft" closed="false">ወራብሌን ቶኮ ቶኮ ሉቅሳ 36 ህንቀበን።</char></note><verse eid="LUK 17:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 17:37"/>እሳንስ፣ “ያ ጎፍታ፣ ኤሰት?” ጄዸኒ ጋፈተን።</para>
  <para style="p" vid="LUK 17:37">እንስ፣ <char style="wj">“እዶ ረቅን ጅሩት ጎጎጮሮወን ወልት ቀበሙ”</char> ጄዼ ዴብሴፍ።<verse eid="LUK 17:37"/></para>
  <chapter eid="LUK 17"/>
  <chapter number="18" style="c" sid="LUK 18"/>
  <para style="s1">ፈኬኘ ሃዸ ህዬሳ ቶኮ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 18:1"/>ዬሱስስ አከ እሳን ዬሮ ሁንደ ከዸቹ ቀበኒፊ አከ እሳን አብዲ ህንኩተትኔ እሳን በርሲሱፍ ጄዼ ፈኬኘ ቶኮ በረቶተሳት ህሜ። <verse eid="LUK 18:1"/><verse number="2" style="v" sid="LUK 18:2"/>እንስ አከነ ጄዼ፤ <char style="wj">“መጋላ ቶኮ ኬሰ አባ ሙርቲ ከን ዋቀ ህንሶዳትኔ፣ ነመስ ከን ህንከበጅኔ ቶኮቱ ቱሬ።</char> <verse eid="LUK 18:2"/><verse number="3" style="v" sid="LUK 18:3"/><char style="wj">ሃት ህዬሳ ቶኮስ መጋላ ሰነ ኬሰ ቱርቴ፤ እሼንስ፣ ‘ዲነኮረት ሙርቲ ቀጄላ ናፍ ኬን’ ጄቴ እሰት ዴዴብኣ ቱርቴ።</char><verse eid="LUK 18:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 18:4"/>
    <char style="wj">“እንስ ዬሮ ገባባፍ ድዴ ቱሬ፤ ኤርገሲ ገሩ አከነ ጄዼ ገራሳት ያዴ፤ ‘አን ዮን ዋቀ ህንሶዳትኔሌ፣ ዮን ነመስ ህንከበጅኔሌ፣</char> <verse eid="LUK 18:4"/><verse number="5" style="v" sid="LUK 18:5"/><char style="wj">ሰበቢ ኒቲን ኩን ዴዴብቴ ነ ረክፍቱፍ ሙርቲ ቀጄላ ነንኬናፍ፤ ዮ ከና አቺ ዴዴብቴ ነ ደዸብሲፍት።’ ”</char><verse eid="LUK 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 18:6"/>ጎፍታንስ አከነ ጄዼ፤ <char style="wj">“ኤጋ ዋን አብቺ ሙርቲ ደባን ሱን ጄዹ ዸገኣ፤</char> <verse eid="LUK 18:6"/><verse number="7" style="v" sid="LUK 18:7"/><char style="wj">ዋቅንሞ ፍለተምቶተሳ ወረ ሀልከኒ ጉያ ገረሳት እየተኒፍ ሙርቲ ቀጄላ ህንኬኑ? እሳን ዱራ ቱርሳሬ?</char> <verse eid="LUK 18:7"/><verse number="8" style="v" sid="LUK 18:8"/><char style="wj">አን እስንትን ህመ፤ እን ደፌ ሙርቲ ቀጄላ ኬናፍ፤ ገሩ እልም ነማ ጋፈ ዹፉ ለፈረት አመንቲ ንአርገታ?”</char><verse eid="LUK 18:8"/></para>
  <para style="s1">ፈኬኘ ፈሪስቻቲፊ ነምቸ ቀረጠ ወልት ቀቡ</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 18:9"/>ዬሱስስ ነሞተ ቀጄሉማ ኦፊት አመነኒ ወረ ካንሞ ቱፈተንት አከነ ጄዼ ፈኬኘ ከነ ህሜ። <verse eid="LUK 18:9"/><verse number="10" style="v" sid="LUK 18:10"/><char style="wj">“ነሞትን ለመ ዋቀ ከዸቹፍ ገረ መነ ቁልቁሉማት ኦል በአን፤ እሳንስ ፈሪስቸ ቶኮፊ ነመ ቀረጠ ወልት ቀቡ ቶኮ ቱረን።</char> <verse eid="LUK 18:10"/><verse number="11" style="v" sid="LUK 18:11"/><char style="wj">ፈሪስች ከኤ ዻበቴ፣ ዋኤ መታሳ አከነ ጄዼ ከዸቴ፤ ‘ያ ዋቀዮ፣ አን አከ ነሞተ ካኒ ጄቹንስ አከ ሳምቶታ፣ ጀልኦታፊ ሰጋገልቶታ ኬሱመቱ ዋን አከ ነምቸ ቀረጠ ወልት ቀቡ ከና ህንተእኒፍ ስን ገለቴፈዸ።</char> <verse eid="LUK 18:11"/><verse number="12" style="v" sid="LUK 18:12"/><char style="wj">አን ቶርበንት ዬሮ ለመ ነንሶመ፤ ዋነን አርገዹ ሁንዱማራስ ሀርከ ኩዸን ኬሳ ቶኮ ነንኬነ።’</char><verse eid="LUK 18:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 18:13"/>
    <char style="wj">“ነምች ቀረጠ ወልት ቀቡ ሱን ገሩ ፈጎ ዻበቴ፣ ቆመሳ ዸዸኣ፣ ‘ያ ዋቀዮ፣ አን ነመ ጩበማዻቲ ና ነእ!’ ጄዼ መሌ እጀሳቲንሌ ኦል ጄዼ ገረ ሰሚ ህንእላሌ።</char><verse eid="LUK 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 18:14"/>
    <char style="wj">“አን እስንትን ህመ፤ ነምች ኩን ነምቸ ዱራረ ፉለ ዋቃ ዱረት ቀጄላ ተኤ መነሳት ገሌ። ነምን ኦል ኦፍ ቀቡ ሁንድኑ ገድ ቀበማቲ፤ ነምን ገድ ኦፍ ቀቡ ገሩ ኦል ቀበመ።”</char><verse eid="LUK 18:14"/></para>
  <para style="s1">ዬሱሲፊ እጆሌ ጥጥኖ</para>
  <para style="r">
    <ref loc="LUK 18:15-17">18፥15‑17</ref> ኩወፈ – <char style="xt"><ref loc="MAT 19:13-15">ማቴ 19፥13‑15</ref>፤ <ref loc="MRK 10:13-16">ማር 10፥13‑16</ref></char></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 18:15"/>ነሞትን አከ እን ሀርከ እሳንረ ካኤ እሳኒፍ ከዸቱፍ ዳእመንስ ዬሱስት ፍዳ ቱረን። በረቶትን ገሩ ዮሙ ዋን ከነ አርገንት እሳን እፈተን። <verse eid="LUK 18:15"/><verse number="16" style="v" sid="LUK 18:16"/>ዬሱስ ገሩ እጆሌ ሰነ ኦፍት ዋሜ አከነ ጄዼ፤ <char style="wj">“እጆሌን ጥጥኖን ገረኮ ሃዹፈኒቲ ህንዾውና፤ ሞቱማን ዋቃ ከን ወረ አከናቲ።</char> <verse eid="LUK 18:16"/><verse number="17" style="v" sid="LUK 18:17"/><char style="wj">አን ዹጉመን እስንት ህመ፤ ነምን አኩመ እጆሌት ሞቱማ ዋቃ ህንስመትኔ ከምዩ ጎንኩማ እት ህንገሉ።”</char><verse eid="LUK 18:17"/></para>
  <para style="s1">ፈኬኘ ዱሬሳቲፊ ሞቱማ ዋቃ</para>
  <para style="r">
    <ref loc="LUK 18:18-30">18፥18‑30</ref> ኩወፈ – <char style="xt"><ref loc="MAT 19:16-29">ማቴ 19፥16‑29</ref>፤ <ref loc="MRK 10:17-30">ማር 10፥17‑30</ref></char></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 18:18"/>ቡልቻን ቶኮ፣ “ያ በርሲሳ ጋሪ፣ አን ጅሬኘ በረ በራ ዻሉፍ ማል ጎቹን ቀበ?” ጄዼ እሰ ጋፈቴ።<verse eid="LUK 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 18:19"/>ዬሱስስ አከነ ጄዼ ዴብሴ፤ <char style="wj">“አት ማሊፍ ጋሪ ናን ጄተ? ዋቀ ቶክቸ መሌ ጋሪን ህንጅሩ።</char> <verse eid="LUK 18:19"/><verse number="20" style="v" sid="LUK 18:20"/><char style="wj">አት አጀጀወን ንቤክተ፤ ‘ህንኤጅን፤ ህንአጄስን፤ ህንሀትን፤ ሶባን ዹጋ ህንበእን፤ አባኬቲፊ ሃዸኬቲፍ ኡልፍነ ኬን።’</char><note caller="+" style="f"><char style="fr" closed="false">18፥20 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 20:12">በኡ 20፥12</ref>፤ <ref loc="DEU 5:16-20">ኬዴ 5፥16‑20</ref></char></char></note><char style="wj">”</char><verse eid="LUK 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 18:21"/>ነምችስ፣ “አን እጆሉማኮቲ ጀልቀቤ አጀጀወን ከኔን ሁንደ ኤጌረ” ጄዼ።<verse eid="LUK 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 18:22"/>ዬሱስስ ዮሙ ዋን ከነ ዸገኤት፣ <char style="wj">“አመሌ ዋን ቶኮቱ ስ ዱራ ህርአተ፤ ዋን ቀብዱ ሁንደ ጉርጉሪ ህዬዪፍ ኬን፤ ሰሚ ኬሰት በዻዹማ ንቀባታ። ኤርገሲ ኮቱ ነ ዱካ ቡእ”</char> ጄዼን።<verse eid="LUK 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 18:23"/>እን ዮሙ ዋን ከነ ዸገኤት ባይኤ ገዴ፤ አከ መሌ ሶሬሰ ቱሬቲ። <verse eid="LUK 18:23"/><verse number="24" style="v" sid="LUK 18:24"/>ዬሱስስ እሰ እላሌ አከነ ጄዼ፤ <char style="wj">“ሞቱማ ዋቃት ገሉን ሶሬዪፍ አከም ረክሳዸ!</char> <verse eid="LUK 18:24"/><verse number="25" style="v" sid="LUK 18:25"/><char style="wj">ዹጉማን ነምን ሶሬስ ሞቱማ ዋቃት ገሉረ ቃወ ልልሞ ኬሰ በኡቱ ጋላፍ ሰልጰተ።”</char><verse eid="LUK 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 18:26"/>ወር ዋን ከነ ዸገአንስ፣ “ዮስ ኤኙቱ ፈዩ ደንደአሬ?” ጄዸኒ ጋፈተን።<verse eid="LUK 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 18:27"/>ዬሱስስ፣ <char style="wj">“ወን ነማፍ ህንደንደአምኔ፣ ዋቃፍ ንደንደአመ”</char> ጄዼ ዴብሴ።<verse eid="LUK 18:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 18:28"/>ጴጥሮስስ፣ “ኩኖ፣ ኑ ዋን ቀብኑ ሁንደ ዺፍኔ ስ ዱካ ቡኔረ” ጄዼን።<verse eid="LUK 18:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 18:29"/>ዬሱስሞ አከነ እሳኒን ጄዼ፤ <char style="wj">“አን ዹጉመን እስንት ህመ፤ ነምን ሰበቢ ሞቱማ ዋቃቲፍ ጄዼ መነ ዮካን ኒቲ ዮካን ኦቦሎተ ዮካን ሃዻፊ አባ ዮካን እጆሌ ዺሴ፣</char> <verse eid="LUK 18:29"/><verse number="30" style="v" sid="LUK 18:30"/><char style="wj">በረ ከነ ኬሰ ደቻ ባይኤ፣ በረ ዹፉፍ ጅሩ ኬሰሞ ጅሬኘ በረ በራ ኡቱ ህንአርገን ሀፉ ቶኮዩ ህንጅሩ።”</char><verse eid="LUK 18:30"/></para>
  <para style="s1">ዬሱስ ዬሮ ሰደፋ ዋኤ ዱአሳ ዱበቴ</para>
  <para style="r">
    <ref loc="LUK 18:31-33">18፥31‑33</ref> ኩወፈ – <char style="xt"><ref loc="MAT 20:17-19">ማቴ 20፥17‑19</ref>፤ <ref loc="MRK 10:32-34">ማር 10፥32‑34</ref></char></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 18:31"/>ዬሱስ ወረ ኩዸ ለማን ኮጳት ባሴ አከነ ጄዼን፤ <char style="wj">“ኩኖ ኑ ዬሩሳሌምት ኦል በኣ ጅረ፤ ወን ራጆትን ዋኤ እልመ ነማ በሬሰን ሁንድኑስ ንራወተመ።</char> <verse eid="LUK 18:31"/><verse number="32" style="v" sid="LUK 18:32"/><char style="wj">እን ደበርፈሜ ነሞተ ኦርማት ንኬነመ። እሳንስ እሰት ቆሱ፤ እሰ አረብሱ፤ እሰት ቱፉ፤ እሰ ገረፉ፤ እሰ አጄሱስ።</char> <verse eid="LUK 18:32"/><verse number="33" style="v" sid="LUK 18:33"/><char style="wj">እንስ ጉያ ሰደፋት ዱኣ ንከአ።”</char><verse eid="LUK 18:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 18:34"/>በረቶትን ገሩ ዋን ከነ ሁንደ ኬሳ ቶኮሌ ህንሁበትኔ፤ ሂካንሳስ እሳን ዱራ ዾክፈሜ ቱሬ። እን ማል አከ ዱበቻ ቱሬስ እሳኒፍ ህንገሌ።<verse eid="LUK 18:34"/></para>
  <para style="s1">ነምች ጃማን ቶኮ ፈይፈሙሳ</para>
  <para style="r">
    <ref loc="LUK 18:35-43">18፥35‑43</ref> ኩወፈ – <char style="xt"><ref loc="MAT 20:29-34">ማቴ 20፥29‑34</ref>፤ <ref loc="MRK 10:46-52">ማር 10፥46‑52</ref></char></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 18:35"/>ዬሮ ዬሱስ ዬርኮት ዽኣቴት፣ ነምች ጃማን ቶኮ ቀርቀረ ከራ ታኤ ከዸቻ ቱሬ። <verse eid="LUK 18:35"/><verse number="36" style="v" sid="LUK 18:36"/>እንስ አከ ቱትን ነሞታ ከራ ሰነ ደርባ ጅሩ ዸጌኛን፣ ዋን ተኣ ቱሬ ጋፈቴ። <verse eid="LUK 18:36"/><verse number="37" style="v" sid="LUK 18:37"/>እሳንስ፣ “ዬሱስ ነመ ናዝሬትቱ አሲን ደርባ ጅረ” ጄዸኒ እሰት ህመን።<verse eid="LUK 18:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 18:38"/>እንስ፣ “ዬሱስ፣ ያ እልመ ዳዊት፣ ነ ማር!” ጄዼ እዬ።<verse eid="LUK 18:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 18:39"/>ነሞትን ፉለ ዱረ ዴማ ቱረንስ አከ እን ጨልእሱፍ እሰ እፈተን፤ እን ገሩ፣ “ያ እልመ ዳዊት ነ ማር!” ጄዼ እቱመ ጫልችሴ እዬ።<verse eid="LUK 18:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 18:40"/>ዬሱስስ ዻበቴ አከ እሳን ነምቸ ገረሳ ፍደን አጀጄ። ዮሙ እን ገረሳት ዽኣቴት ዬሱስ አከነ ጄዼ እሰ ጋፈቴ፤ <verse eid="LUK 18:40"/><verse number="41" style="v" sid="LUK 18:41"/><char style="wj">“አከ አን ማል ሲፍ ጎዹ በርባደ?”</char></para>
  <para style="p" vid="LUK 18:41">ነምችስ፣ “ያ ጎፍታ፣ አን አርጉን በርባደ” ጄዼ ዴብሴ።<verse eid="LUK 18:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 18:42"/>ዬሱስስ፣ <char style="wj">“አርግ፤ አመንቲንኬ ስፈይሴራ”</char> ጄዼን። <verse eid="LUK 18:42"/><verse number="43" style="v" sid="LUK 18:43"/>እንስ ዬሩመ ሰነ አርጌ ዋቀ ጀጀቻ ዬሱስ ዱካ ቡኤ። ነሞትን ሁንድኑስ ዮሙ ዋን ከነ አርገንት ዋቀ ጀጀን።<verse eid="LUK 18:43"/></para>
  <chapter eid="LUK 18"/>
  <chapter number="19" style="c" sid="LUK 19"/>
  <para style="s1">ዬሱሲፊ ዘኬዎስ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 19:1"/>ዬሱስ ዬርኮ ሴኔ አች ኬሰ ደርባ ቱሬ። <verse eid="LUK 19:1"/><verse number="2" style="v" sid="LUK 19:2"/>ነምች ዘኬዎስ ጄዸሙ ቶኮስ አች ቱሬ፤ እንስ ሀንገፈ ወረ ቀረጠ ወልት ቀበኒቲፊ ሶሬሰ ቱሬ። <verse eid="LUK 19:2"/><verse number="3" style="v" sid="LUK 19:3"/>እንስ ዬሱስ ነመ አከሚ አከ ተኤ አርጉ በርባዴ፤ ገሩ ገባባ ዋን ቱሬፍ፣ ሰበቢ ባይእነ ነሞታቲፍ እሰ አርጉ ህንደንዴኜ። <verse eid="LUK 19:3"/><verse number="4" style="v" sid="LUK 19:4"/>ዬሱስ ዋን ከራ ሰነረ ደርባ ቱሬፍ፣ ዘኬዎስ እሰ አርጉፍ ጄዼ ፊጌ ዱረ ደርቤ ሙከ ቅልጡ ቶኮ ያበቴ።<verse eid="LUK 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 19:5"/>ዬሱስ ዮሙ እዶ ሰነ ገኤት ኦል ምልአቴ፣ <char style="wj">“ያ ዘኬዎስ፣ ሀርአ መነኬ ኦሉን ነረ ጅራቲ ደፊ ገድ ቡእ”</char> ጄዼን። <verse eid="LUK 19:5"/><verse number="6" style="v" sid="LUK 19:6"/>እንስ ዮሙሱመ ገድ ቡኤ ገመቹዻን እሰ ስመቴ።<verse eid="LUK 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 19:7"/>ነሞትን ሁንድኑ ዮሙ ዋን ከነ አርገንት፣ “እን ኬሱማ ‘ነመ ጩበማ’ ተኡ ዸቄ!” ጄዸኒ ጉንጉሙ ጀልቀበን።<verse eid="LUK 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 19:8"/>ዘኬዎስ ገሩ ከኤ ዻበቴ ጎፍታዻን፣ “ያ ጎፍታ ኩኖ፣ አን ወለካ ቀቤኘኮ ህዬዪፍ ነንኬነ፤ አን ዮን ነመ ቶኮሌ ጎዎምሴ ሳሜ ጅራዼ፣ ዋነን ፉዸዼ ሰነ ሀርከ አፉር ጎዼ ነንዴብሰ” ጄዼ።<verse eid="LUK 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 19:9"/>ዬሱስ ዴብሴ አከነ ጄዼን፤ <char style="wj">“ነምች ኩንስ ዋን እልመ አብረሃም ተኤፍ፣ ሀርአ ፈይን መነ ከናፍ ዹፌረ።</char> <verse eid="LUK 19:9"/><verse number="10" style="v" sid="LUK 19:10"/><char style="wj">እልም ነማ እሰ በዴ በርባዱፊ ፈይሱዻፍ ዹፌቲ።”</char><verse eid="LUK 19:10"/></para>
  <para style="s1">ፈኬኘ ምናኒ ኩዸነኒ</para>
  <para style="r">
    <ref loc="LUK 19:12-27">19፥12‑27</ref> ኩወእ – <char style="xt"><ref loc="MAT 25:14-30">ማቴ 25፥14‑30</ref></char></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 19:11"/>ዬሱስስ ኡቱመ እሳን ዋን ከነ ዸገኣ ጅረኑ እት ፉፌ፣ ፈኬኘ ቶኮ እሳንት ህሜ፤ ከነስ ሰበቢ እን ዬሩሳሌምት ዽኣቴፊ ሰበቢ ነሞትን ዋን ሞቱማን ዋቃ ዬሩመ ሰነ ሙልአቱ ሴአኒፍ ዱበቴ። <verse eid="LUK 19:11"/><verse number="12" style="v" sid="LUK 19:12"/>እንስ አከነ ጄዼ፤ <char style="wj">“ነምች ሰኚ ሞቲ ቶኮ ሙደሜ ሞቲ ተኤ ዴብኡፍ ብየ ፈጎ ዸቄ።</char> <verse eid="LUK 19:12"/><verse number="13" style="v" sid="LUK 19:13"/><char style="wj">ነምች ሱንስ ገርቦተሳ ኬሳ ነመ ኩዸን ዋሜ፣ ‘ሀመ አን ዴብኡት ማለቀ ከናን ደልደላ’ ጄዼ ምናኒ ኩዸን እሳንት ኬኔ።</char><verse eid="LUK 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 19:14"/>
    <char style="wj">“ነሞትን ብየሳ ገሩ እሰ ጅበኒ፣ ‘አከ ነምች ኩን ኑረት ሞቲ ተኡ ህንፌኑ!’ ጄዸኒ በከ ቡኦተሳኒ እሰ ዱባን ኤርገተን።</char><verse eid="LUK 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 19:15"/>
    <char style="wj">“እንስ ኤርገ ሙደሜ ሞቲ ተኤ ዴብኤ ቦዴ ገርቦትን እን ማለቀ እት ኬኔ ቱሬ ሱን እቲን ደልደለኒ ማል አከ አርገተን ቤኩፍ ጄዼ ነመ እት ኤርጌ እሳን ዋምስሴ።</char><verse eid="LUK 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 19:16"/>
    <char style="wj">“ገርብች ጀልቀባ ዹፌ፣ ‘ያ ጎፍታ፣ ምናኒንኬ ምናኒ ገረ ብራ ኩዸን ዸሌረ’ ጄዼን።</char><verse eid="LUK 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 19:17"/>
    <char style="wj">“ጎፍታንሳስ ዴብሴ፣ ‘ያ ገርብቸ ጋሪ፣ አት ዋን ጋሪ ሆጄቴ። ሰበቢ አት ዋን አከ መሌ ጥኖረት አመነማ ታቴፍ፣ መጋላ ኩዸንረት ታይታ ቀባዹ’ ጄዼን።</char><verse eid="LUK 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 19:18"/>
    <char style="wj">“ገርብች ለመፋንስ ዹፌ፣ ‘ያ ጎፍታ፣ ምናኒንኬ ምናኒ ገረ ብራ ሸን ዸሌረ’ ጄዼን።</char><verse eid="LUK 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 19:19"/>
    <char style="wj">“ጎፍታንሳስ ዴብሴ፣ ‘አትስ መጋላ ሸንረት ሞእ’ ጄዼን።</char><verse eid="LUK 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 19:20"/>
    <char style="wj">“እን ሰደፋንሞ ዹፌ አከነ ጄዼ፤ ‘ያ ጎፍታ፣ ምናኒንኬ ኩኖት፤ አን ሁጩዻን መሬ ዾክሴን ቱሬ።</char> <verse eid="LUK 19:20"/><verse number="21" style="v" sid="LUK 19:21"/><char style="wj">አት ገረ ጀቤሰ ዋን ታቴፍ አን ስን ሶዳዼ፤ አት ዋን ህንካአወትን ፉዸተ፤ ዋን ህንፈጫስንስ ሃመተ።’</char><verse eid="LUK 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 19:22"/>
    <char style="wj">“ጎፍታንሳስ ዴብሴ አከነ ጄዼ፤ ‘ያ ገርብቸ ሀማነነ፤ አን ዱቡመ አፋንኬቲቲን ስትን ሙረ፤ አት አከ አን ነመ ደባ ዋን ህንካአወትን ፉዸቱ፣ ዋን ህንፈጫስንስ ሃመቱ ተኤ ቤክተ ምቲ?</char> <verse eid="LUK 19:22"/><verse number="23" style="v" sid="LUK 19:23"/><char style="wj">ዮስ አከ አን ዮሙን ዴብኡት ዸለሳ ወጅን ፉዸዹፍ ማሊፍ ማለቀኮ መነ ባንኪ ናፍ ህንካእንሬ?’</char><verse eid="LUK 19:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 19:24"/>
    <char style="wj">“ጎፍትችስ ወረ አች ዸዻበተኒን፣ ‘ምናኒ ሰነ እሰ ሀርካ ፉዻቲ ነምቸ ምናኒ ኩዸን ቀቡፍ ኬና’ ጄዼ።</char><verse eid="LUK 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 19:25"/>
    <char style="wj">“እሳንስ ዴብሰኒ፣ ‘ያ ጎፍታ፣ እን ዱራኑ ምናኒ ኩዸን ቀበ’ ጄዸኒን።</char><verse eid="LUK 19:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 19:26"/>
    <char style="wj">“እንሞ ዴብሴ አከነ ጄዼ፤ ‘አን እስንትን ህመ፤ ከን ቀቡ ሁንዳፉ እት ደበለሜ ንኬነመ፤ ከን ህንቀብኔ ገሩ ወን እን ቀቡዩ እራ ፉዸተመ፤</char> <verse eid="LUK 19:26"/><verse number="27" style="v" sid="LUK 19:27"/><char style="wj">ዲኖተኮ ከኔን አከ አን እሳንረት ሞቲ ተኡ ህንበርባድንሞ አስ ፍዳቲ ፉለኮ ዱረት እሳን ጎጎረኣ።’ ”</char><verse eid="LUK 19:27"/></para>
  <para style="s1">ዬሱስ አከ ሞቲት ዬሩሳሌም ሴኑሳ</para>
  <para style="r">
    <ref loc="LUK 19:29-38">19፥29‑38</ref> ኩወፈ – <char style="xt"><ref loc="MAT 21:1-9">ማቴ 21፥1‑9</ref>፤ <ref loc="MRK 11:1-10">ማር 11፥1‑10</ref></char></para>
  <para style="r">
    <ref loc="LUK 19:35-38">19፥35‑38</ref> ኩወፈ – <char style="xt"><ref loc="JHN 12:12-15">ዮሀ 12፥12‑15</ref></char></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 19:28"/>ዬሱስ ኤርገ ዋን ከነ ዱበቴ ቦዴ ዬሩሳሌምት ኦል በኡፍ እሳን ዱረ ዴማ ቱሬ። <verse eid="LUK 19:28"/><verse number="29" style="v" sid="LUK 19:29"/>እንስ አኩመ ቤተ ፋጌፊ ቢታንያ ከኔን ቱሉ ጋረ ኤጄርሳ ጄዸሙ ብራ ሰነት ዽኣቴን በረቶተሳ ኬሳ ለመ ኤርጌ፤ <verse eid="LUK 19:29"/><verse number="30" style="v" sid="LUK 19:30"/>አከነስ እሳኒን ጄዼ፤ <char style="wj">“ገረ ገንደ ፉለኬሰን ዱረ ጅሩ ሰና ዸቃ፤ አኩመ አች ሴንተኒንስ፣ እልሞ ሀሬ ከን ነምን ቶኮዩ ተኩማ ህንያበትን ቶኮ አችት ህዸሜ ጅሩ ንአርገቱ። እሰ ሂካቲ አስ ፍዳ።</char> <verse eid="LUK 19:30"/><verse number="31" style="v" sid="LUK 19:31"/><char style="wj">ዮ ነምን ቶኮዩ፣ ‘እስን ማሊፍ ሂክቱ?’ ጄዼ እስን ጋፈቴ፣ ‘ጎፍታቱ እሰ በርባደ’ ጄዻ።”</char><verse eid="LUK 19:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 19:32"/>ወር ኤርገመንስ ዸቀኒ ዋን ሁንደ አኩመ እን እሳንት ህሜት አርገተን። <verse eid="LUK 19:32"/><verse number="33" style="v" sid="LUK 19:33"/>ኡቱ እሳን እልሞ ሀሬ ሰነ ሂካ ጅረኑስ ወር ሀሬ ሰና፣ “እልሞ ሀሬ ከነ ማሊፍ ሂክቱ?” ጄዸኒ እሳን ጋፈተን።<verse eid="LUK 19:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 19:34"/>እሳንስ፣ “ጎፍታቱ እሰ በርባደ” ጄዸኒ ዴብሰን።<verse eid="LUK 19:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 19:35"/>እልሞ ሀሬ ሰነስ ዬሱስት ፍደን፤ ኡፈተሳኒስ ሀሬ ሰነረ ቡሰን፤ ዬሱስንስ እረ ቴስሰን። <verse eid="LUK 19:35"/><verse number="36" style="v" sid="LUK 19:36"/>ኡቱ እን ዴሙስ ነሞትን ኡፈተሳኒ ከራረ አፈን።<verse eid="LUK 19:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 19:37"/>ዬሮ እን ዳንዲ ቱሉ ኤጄርሳራ ገድ ቡኡት ዽኣቴትስ፣ በረቶትን ሁንድ ሆጂ ድንቂ አርገኒ ቱረን ሁንደት ገመደኒ፣ ሰገሌ ጉዳዻን አከነ ጄዸኒ ዋቀ ገለቴፈቹ ጀልቀበን።<verse eid="LUK 19:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="LUK 19:38"/>“ሞቲን መቃ ጎፍታቲን ዹፉ ኤብፈማዸ!”<note caller="+" style="f"><char style="fr" closed="false">19፥38 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 118:26">ፋር 118፥26</ref></char></char></note></para>
  <para style="b" vid="LUK 19:38"/>
  <para style="q1" vid="LUK 19:38">“ነጋን ሰሚረት፣ ኡልፍንስ ኦል ጉባት!”<verse eid="LUK 19:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 19:39"/>ነሞተ አች ቱረን ኬሳስ ፈሪሶትን ቶኮ ቶኮ ዬሱሲን፣ “ያ በርሲሳ፣ በረቶተኬ እፈዹ!” ጄዸን።<verse eid="LUK 19:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 19:40"/>እንስ ዴብሴ፣ <char style="wj">“አን እስንትን ህመ፤ ዮ እሳን ጨልእሰንሌ ዸጎትን ንእዩ”</char> ጄዼን።<verse eid="LUK 19:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 19:41"/>ዬሱስስ ዮሙ ዬሩሳሌምት ዽኣቴ መጋለቲ አርጌት ንቦኤፍ፤ <verse eid="LUK 19:41"/><verse number="42" style="v" sid="LUK 19:42"/>አከነስ ጄዼ፤ <char style="wj">“ኡቱ አቱምት ዋን ሀርአ ነጋ ሲፍ ኬኑ ቤክቴ ጋሪ ቱሬ! አመ ገሩ እጀኬ ዱራ ዾክፈሜረ።</char> <verse eid="LUK 19:42"/><verse number="43" style="v" sid="LUK 19:43"/><char style="wj">ጉዮትን እት ዲኖትንኬ ኮቢ ስት እጃረኒ፣ ስመርሰኒ፣ ከራ ሁንዳንስ በኡ ስዾወን ስት ንዹፉቲ።</char> <verse eid="LUK 19:43"/><verse number="44" style="v" sid="LUK 19:44"/><char style="wj">ዲኖትን ስኢፊ እጆሌኬ ወረ ደላኬ ኬሰ ጅራተን ብዮት መኩ። እሳን ዸጋ ቶኮ ዸጋ ካንረት ህንዺሰን፤ አት ዬሮ እት ዋቅን ገረኬ ዹፉ ህንቤክኔቲ።”</char><verse eid="LUK 19:44"/></para>
  <para style="s1">ዬሱስ መነ ቁልቁሉማ ኬሰት</para>
  <para style="r">
    <ref loc="LUK 19:45">19፥45</ref>፣<ref loc="LUK 19:46">46</ref> ኩወፈ – <char style="xt"><ref loc="MAT 21:12-16">ማቴ 21፥12‑16</ref>፤ <ref loc="MRK 11:15-18">ማር 11፥15‑18</ref>፤ <ref loc="JHN 2:13-16">ዮሀ 2፥13‑16</ref></char></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 19:45"/>ዬሱስ መነ ቁልቁሉማ ሴኔ ወረ ጉርጉረቻ ቱረን አርኡ ጀልቀቤ። <verse eid="LUK 19:45"/><verse number="46" style="v" sid="LUK 19:46"/>እንስ፣ <char style="wj">“ ‘መንኮ መነ ከዸትና ተአ’ ጄዸሜ በሬፈሜረ፤ እስን ገሩ ‘ሆልቀ ሳምቶታ’ ጎተኒርቱ”</char><note caller="+" style="f"><char style="fr" closed="false">19፥46 </char><char style="ft" closed="false"><char style="xt"><ref loc="JER 7:11">ኤር 7፥11</ref></char></char></note> እሳኒን ጄዼ።<verse eid="LUK 19:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 19:47"/>ጉዩመ ጉያንስ መነ ቁልቁሉማ ኬሰት በርሲሳ ቱሬ፤ ሉቦትን ሀንገፎትን፣ በርሲስቶትን ሴራቲፊ ዱረ ቡኦትን ሰባ ገሩ እሰ አጄሱዻፍ ጀቤሰኒ በርባዳ ቱረን። <verse eid="LUK 19:47"/><verse number="48" style="v" sid="LUK 19:48"/>ተኡስ እሳን ከራ እቲን እሰ አጄሰን ህንአርገትኔ፤ ነሞትን ሁንድኑ ያደ ቶኮን ዋን እን ዱበቴ ዸጌፈቻ ቱረኒቲ።<verse eid="LUK 19:48"/></para>
  <chapter eid="LUK 19"/>
  <chapter number="20" style="c" sid="LUK 20"/>
  <para style="s1">ታይታን ዬሱስ ጋፊ ኡሜ</para>
  <para style="r">
    <ref loc="LUK 20:1-8">20፥1‑8</ref> ኩወፈ – <char style="xt"><ref loc="MAT 21:23-27">ማቴ 21፥23‑27</ref>፤ <ref loc="MRK 11:27-33">ማር 11፥27‑33</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 20:1"/>ጋፍ ቶኮ ኡቱ ዬሱስ መነ ቁልቁሉማ ኬሰት ነሞተ በርሲሱ፣ ኡቱ ወንጌለስ ለለቡ ሉቦትን ሀንገፎትኒፊ በርሲስቶትን ሴራ ማንጉዶተ ወጅን ገረሳ ዹፈን። <verse eid="LUK 20:1"/><verse number="2" style="v" sid="LUK 20:2"/>እሳንስ፣ “አት አከ ታይታ ማሊቲን ዋን ከነ ሆጄቱ ኑት ህም። ኤኙቱ ታይታ ከነ ሲፍ ኬኔ” ጄዸን።<verse eid="LUK 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 20:3"/>እንስ አከነ ጄዼ ዴብሴ፤ <char style="wj">“አንስ ጋፊ ቶኮን እስን ጋፈዸ። እስንሞ ነት ህማ፦</char> <verse eid="LUK 20:3"/><verse number="4" style="v" sid="LUK 20:4"/><char style="wj">ጩጳን ዮሀንስ ሰሚራ ዹፌሞ ነመ ብራ ዹፌ?”</char><verse eid="LUK 20:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 20:5"/>እሳንስ ወሊን መርአተኒ አከነ ጄዸን፤ “ዮ ኑ፣ ‘ሰሚራ ዹፌ’ ጄኔ እንሞ፣ ‘እስን ማሊፍ እሰ ህንአመንንሬ?’ ጄዼ ኑ ጋፈተ። <verse eid="LUK 20:5"/><verse number="6" style="v" sid="LUK 20:6"/>ዮ ኑ፣ ‘ነመ ብራ ዹፌ’ ጄኔ ገሩ ነሞትን ሁንድኑ አከ ዮሀንስ ራጂ ተኤ ዋን አመነኒፍ ዸጋዻን ኑ ቱሙ።”<verse eid="LUK 20:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 20:7"/>ከናፍ እሳን፣ “እን ኤሳ አከ ዹፌ ኑ ህንቤክኑ” ጄዸን።<verse eid="LUK 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 20:8"/>ዬሱስሞ፣ <char style="wj">“አንስ ታይታ ማሊቲን አከን ዋን ከነ ሆጄዹ እስንት ህንህሙ”</char> ጄዼን።<verse eid="LUK 20:8"/></para>
  <para style="s1">ፈኬኘ ቆቱወኒ</para>
  <para style="r">
    <ref loc="LUK 20:9-19">20፥9‑19</ref> ኩወፈ – <char style="xt"><ref loc="MAT 21:33-46">ማቴ 21፥33‑46</ref>፤ <ref loc="MRK 12:1-12">ማር 12፥1‑12</ref></char></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 20:9"/>እንስ አከነ ጄዼ ፈኬኘ ከነ ነሞተት ህሙ ጀልቀቤ፤ <char style="wj">“ነምች ቶኮ እዶ ዻበ ወይኒረ ወይኒ ዻበቴ፣ ቆናን ቡልቶተት ክራ ኬነቴ ብየ ፈጎ ዸቄ ዬሮ ዼራ ቱሬ።</char> <verse eid="LUK 20:9"/><verse number="10" style="v" sid="LUK 20:10"/><char style="wj">እንስ ዬሮ ምዻን ወልት ቀበሙት አከ እሳን እጀ እዶ ዻበ ወይኒራ ዋ ኬነኒፍ ገርብቸ ቶኮ ቆቱወን ሰነት ኤርገቴ። ቆቱወን ሱን ገሩ ቱመኒ ሀርከ ዱዋ ኦፍራ እሰ ዴብሰን።</char> <verse eid="LUK 20:10"/><verse number="11" style="v" sid="LUK 20:11"/><char style="wj">እንስ ገርብቸ ብራ ኤርገቴ፤ እሳን ገሩ እሰስ ቱመኒ፣ ቃኔሰኒስ ሀርከ ዱዋ ኦፍራ እሰ ዴብሰን።</char> <verse eid="LUK 20:11"/><verse number="12" style="v" sid="LUK 20:12"/><char style="wj">አመሌ ገርብቸ ሰደፋ ኤርገቴ፤ እሳንሞ እሰስ መዴሰኒ ገድ እሰ ደርበተን።</char><verse eid="LUK 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 20:13"/>
    <char style="wj">“ኤርገሲ አብች እዶ ዻበ ወይኒ፣ ‘ማል ጎቹ ናፍ ወየ? ከኤን እልመኮ ጃለተማ እት ኤርገ፤ ተሪ እሰ ንከበጁ ተኣቲ’ ጄዼ።</char><verse eid="LUK 20:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 20:14"/>
    <char style="wj">“ቆቶትን ሱን ገሩ ዮሙ እሰ አርገንት፣ ‘ዻልቱን እሰ ከነ፤ ኮታ እሰ አጄፍና፤ ዻል ሱን ከንኬኘ ተኣቲ’ ጄዸኒ ወሊ ወጅን ዱዱበተን።</char> <verse eid="LUK 20:14"/><verse number="15" style="v" sid="LUK 20:15"/><char style="wj">ከናፉ እሳን እዶ ዻበ ወይኒ ኬሳ ገድ ባሰኒ እሰ አጄሰን።</char></para>
  <para style="p" vid="LUK 20:15">
    <char style="wj">“ኤጋ አባን እዶ ዻበ ወይኒ ሰና ማል እሳን ጎዽነ ላተ?</char> <verse eid="LUK 20:15"/><verse number="16" style="v" sid="LUK 20:16"/><char style="wj">እን ዹፌ ቆቱወን ሰነ ንአጄሰ፤ እዶ ዻበ ወይኒ ሰነስ ነሞተ ብራት ኬነተ።”</char></para>
  <para style="p" vid="LUK 20:16">ነሞትንስ ዮሙ ዋን ከነ ዸገአንት፣ “ዋቅን ዋን ከነ ህንፍድን!” ጄዸን።<verse eid="LUK 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 20:17"/>ዬሱስስ እሳን እላሌ፣ አከነ ጄዼ፤ <char style="wj">“ኤጋ እን፣</char></para>
  <para style="q1" vid="LUK 20:17">
    <char style="wj">“ ‘ዸጋን እጃርቶትን ቱፈተን</char></para>
  <para style="q2" vid="LUK 20:17">
    <char style="wj">ዸጋ ጎሌ ተኤረ ጄዸሜ በሬፈሜ ማል ጄቹሳትሬ’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">20፥17 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="PSA 118:22">ፋር 118፥22</ref>
        </char>
      </char>
    </note>
    <char style="wj">?</char><verse eid="LUK 20:17"/></para>
  <para style="m">
    <verse number="18" style="v" sid="LUK 20:18"/>
    <char style="wj">ነምን ዸጋ ሰነረት ኩፉ ሁንድኑ ጨጨቤ ቡቱተ፤ ነምን ዸግች እረት ኩፉ ከምዩ ንዳከመ።”</char><verse eid="LUK 20:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 20:19"/>በርሲስቶትን ሴራቲፊ ሉቦትን ሀንገፎትን አከ እን ፈኬኘ ከነ እሳኒን ሞርሙዻን ዱበቴ ዋን ቤከኒፍ ዬሩመ ሰነ እሰ ቀቡ በርባደን። ገሩ ነሞተ ሰነ ሶዳተን።<verse eid="LUK 20:19"/></para>
  <para style="s1">ቄሳሪፍ ግብረ ከፈሉ</para>
  <para style="r">
    <ref loc="LUK 20:20-26">20፥20‑26</ref> ኩወፈ – <char style="xt"><ref loc="MAT 22:15-22">ማቴ 22፥15‑22</ref>፤ <ref loc="MRK 12:13-17">ማር 12፥13‑17</ref></char></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 20:20"/>ጀርስ እሰ ጋዳ፣ አከ እሳን ዋን እን ዱበቱን እሰ ቀበኒ ደበርሰኒ ሁምናፊ ታይታ ቡልቻት እሰ ኬነኒፍ ጄዸኒ በሳስቶተ ነመ ነጋ ኦፍ ፈኬሰን ኤርገን። <verse eid="LUK 20:20"/><verse number="21" style="v" sid="LUK 20:21"/>በሳስቶትን ሱንስ አከነ ጄዸኒ እሰ ጋፈተን፤ “ያ በርሲሳ፣ ኑ አከ አት ዋን ቀጄላ ዱበቱፊ ዋኑመ ቀጄላ በርሲፍቱ፣ አከሱመስ አከ አት ዹጋዻን ከራ ዋቃ በርሲሱ መሌ ነመ ወል ህንጫልችፍኔ ቤክነ። <verse eid="LUK 20:21"/><verse number="22" style="v" sid="LUK 20:22"/>ቄሳሪፍ ግብረ ከፈሉን ኤየመሜረሞ ህንኤየመምኔ?”<note caller="+" style="f"><char style="fr" closed="false">20፥22 </char><char style="fq" closed="false">ቄሳሪፍ ግብረ ከፈሉን </char><char style="ft" closed="false">– ሞቱማን ሮማ ብየሳኒ ቀበቹሳ ይሁዶትን ህንቤከን ቱሬ። ኡቱ ዬሱስ ህንዹፍን ወጋ ድግደሚ ሸኒን ዱረ፣ ሰበቢ ግብረ ከፈሉቲን ሞቱማ ሮማት ሞርሚን ጉዳን ቶኮ ከኤ ቱሬ። ከናፍ ጋፊን ኩን ጋፊ ምጪረማዸ። ዬሱስ ዮ ከፈልቲ ግብራ ዴገሬ፣ ፉዸተመ ነመ ብረት ቀቡ ሰነ ዸበ። ዮ ከፈልቲ ግብራ ሞርሜሞ ደበርፈሜ አቦቲ ኣንጎ ሞቱማት ኬነመ።</char></note><verse eid="LUK 20:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 20:23"/>እን ገሩ ሀጡማሳኒ አርጌ አከነ እሳኒን ጄዼ፤ <verse eid="LUK 20:23"/><verse number="24" style="v" sid="LUK 20:24"/><char style="wj">“ሜ ዲናሪ ቶኮ ነት አርግሲሳ። ፈኪፊ ከተቢ ኤኙቱ እሰረ ጅረ?”</char></para>
  <para style="p" vid="LUK 20:24">እሳንስ፣ “ከን ቄሳር” ጄዸኒ ዴብሰን።<verse eid="LUK 20:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 20:25"/>ከነረት እን፣ <char style="wj">“ዮስ ከን ቄሳር ቄሳሪፍ፣ ከን ዋቃሞ ዋቃፍ ኬና”</char> ጄዼን።<verse eid="LUK 20:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 20:26"/>እሳንስ ዋን እን ዱበቴን ፉለ ነሞታ ዱረት እሰ ቀቡ ህንደንዴኜ። ዴቢሳስ ድንቅሲፈተኒ ጨልእሰን።<verse eid="LUK 20:26"/></para>
  <para style="s1">ጋፊ ዋኤ ዱኣ ከኡ</para>
  <para style="r">
    <ref loc="LUK 20:27-40">20፥27‑40</ref> ኩወፈ – <char style="xt"><ref loc="MAT 22:23-33">ማቴ 22፥23‑33</ref>፤ <ref loc="MRK 12:18-27">ማር 12፥18‑27</ref></char></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 20:27"/>ሰዱቆተ ዱኣ ከኡን ህንጅሩ ጄዸን ኬሳ ቶኮ ቶኮ ዋ ጋፈቹፍ ጄዸኒ ገረ ዬሱስ ዹፈን፤ <verse eid="LUK 20:27"/><verse number="28" style="v" sid="LUK 20:28"/>አከነስ ጄዸን፤ “ያ በርሲሳ ዮ ኦቦሌስ ነመ ቶኮ ኒቲ ፉዼ ኡቱ እጆሌ ህንዸልችን ዱኤ፣ አከ ነምች ሱን ኒቲ ሰነ ዻሌ እጆሌ ዸልቼ ኦቦሌሰሳቲፍ ሰኚ ደበርሱ ሙሴን ኑ በሬሴረ። <verse eid="LUK 20:28"/><verse number="29" style="v" sid="LUK 20:29"/>ኩኖ ኦቦሎተ ቶርበቱ ቱሬ። እን ሀንገፍን ኒቲ ፉዼ እጆሌ መሌ ዱኤ። <verse eid="LUK 20:29"/><verse number="30" style="v" sid="LUK 20:30"/>እን ለመፋን፣ <verse eid="LUK 20:30"/><verse number="31" style="v" sid="LUK 20:31"/>እን ሰደፋንስ እሼ ፉዸን፤ ሃሉመ ወል ፈካቱን እሳን ቶርበኑ ኡቱ እጆሌ ህንዸልችን ዱአን። <verse eid="LUK 20:31"/><verse number="32" style="v" sid="LUK 20:32"/>ዹመረት ዱበርትቲንስ ንዱቴ። <verse eid="LUK 20:32"/><verse number="33" style="v" sid="LUK 20:33"/>ኤጋ ጉያ ዱኣ ከኡት እሼን ኒቲ እሰ ከሚ ታት? ቶርበንሳኒዩ እሼ ፉዸኒሩቲ።”<verse eid="LUK 20:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 20:34"/>ዬሱስስ አከነ ጄዼ ዴብሴፍ፤ <char style="wj">“ነሞትን አዱኛ ከና ንፉዹ፤ ንሄሩሙስ።</char> <verse eid="LUK 20:34"/><verse number="35" style="v" sid="LUK 20:35"/><char style="wj">ወር አዱኛ ዹፉፍ ጅሩፊ ዱኣ ከኡ ኬሰት ህርማቹን እሳኒ መሉ ገሩ ህንፉዸን፤ ህንሄሩመንስ።</char> <verse eid="LUK 20:35"/><verse number="36" style="v" sid="LUK 20:36"/><char style="wj">እሳን ዋን አከ ኤርገሞታ ተአኒፍ ዴብአኒ ህንዱአን፤ ዋን እጆሌ ዱኣ ከኡ ተአኒፍስ እሳን እጆሌ ዋቃት።</char> <verse eid="LUK 20:36"/><verse number="37" style="v" sid="LUK 20:37"/><char style="wj">ገሩ ሙሴንዩ ሴና ዋኤ ደገላ ኬሰት አከ ወር ዱአን ዱኣ ከአን አርግሲሴረ፤ እን ጎፍታዻን፣ ‘ዋቀ አብረሃም፣ ዋቀ ይስሃቂፊ ዋቀ ያቆብ’</char><note caller="+" style="f"><char style="fr" closed="false">20፥37 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 3:6">በኡ 3፥6</ref></char></char></note> <char style="wj">ጄዼ ዋማቲ።</char> <verse eid="LUK 20:37"/><verse number="38" style="v" sid="LUK 20:38"/><char style="wj">እን ዋቀ ወረ ጅራተኒት መሌ ዋቀ ወረ ዱአኒ ምት፤ ሁንድኑ እሳፍ ጅራቶዻቲ።”</char><verse eid="LUK 20:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 20:39"/>በርሲስቶተ ሴራ ኬሳ ቶኮ ቶኮ፣ “ያ በርሲሳ፣ ዹጋ ጄቴ!” ጄዸኒ ዴብሰን። <verse eid="LUK 20:39"/><verse number="40" style="v" sid="LUK 20:40"/>ነምን ቶኮዩ ዴብኤ ጋፊ እሰ ጋፈቹፍ እጀ ህንጀባትኔ።<verse eid="LUK 20:40"/></para>
  <para style="s1">ክርስቶስ እልመ ኤኙት?</para>
  <para style="r">
    <ref loc="LUK 20:41-47">20፥41‑47</ref> ኩወፈ – <char style="xt"><ref loc="MAT 22:41-23:7">ማቴ 22፥41–23፥7</ref>፤ <ref loc="MRK 12:35-40">ማር 12፥35‑40</ref></char></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 20:41"/>ዬሱስስ አከነ እሳኒን ጄዼ፤ <char style="wj">“እሳን አከምት ክርስቶስ</char><note caller="+" style="f"><char style="fr" closed="false">20፥41 </char><char style="ft" closed="false">ዮካን </char><char style="fqa" closed="false">መሲህች</char></note> <char style="wj">እልመ ዳዊት ጄቹ ደንደኡ?</char> <verse eid="LUK 20:41"/><verse number="42" style="v" sid="LUK 20:42"/><char style="wj">ዳዊት መታንሳዩ ክታበ ፋርፈትና ኬሰት አከነ ጄዸ፤</char></para>
  <para style="q1" vid="LUK 20:42">
    <char style="wj">“ ‘ጎፍትች ጎፍታኮቲን አከነ ጄዼ፤</char></para>
  <para style="q2" vid="LUK 20:42">
    <char style="wj">“ከራ ምርገኮ ታእ፤</char><verse eid="LUK 20:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="LUK 20:43"/>
    <char style="wj">ሀመ አን ዲኖተኬ፣</char></para>
  <para style="q2" vid="LUK 20:43">
    <char style="wj">ኤጄተ ሚለኬቲ ሲፍ ጎዹት።” ’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">20፥43 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="PSA 110:1">ፋር 110፥1</ref>
        </char>
      </char>
    </note><verse eid="LUK 20:43"/></para>
  <para style="m">
    <verse number="44" style="v" sid="LUK 20:44"/>
    <char style="wj">ዳዊት ‘ጎፍታ’ ጄዼ እሰ ዋመ። ዮስ እን አከምት እልመሳ ተኡ ደንደአሬ?”</char><verse eid="LUK 20:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 20:45"/>ኡቱ ነሞትን ሁንድኑ እሰ ዸገኣ ጅረኑ፣ ዬሱስ በረቶተሳቲን አከነ ጄዼ፤ <verse eid="LUK 20:45"/><verse number="46" style="v" sid="LUK 20:46"/><char style="wj">“በርሲስቶተ ሴራራ ኦፍ ኤገዻ። እሳን ኡፈተ ዼዼራ ኡፈተኒ ነናነኡፊ ገባ ኬሰትስ ነጋ ጋፈተሙ፣ መኔን ሰገዳ ኬሰት ታኡምሰ ኡልፍና፣ ለፈ ጭዻትሞ እዶ ኡልፍና ጃለቱ።</char> <verse eid="LUK 20:46"/><verse number="47" style="v" sid="LUK 20:47"/><char style="wj">እሳንስ መነ ሃዸ ህዬሳ ሳመኒ ኦንሱ፤ ኦፍ አርግሲሱፍ ጄዸኒስ ከዸትና ዼሬሱ። ነሞትን ኩኔን አደበ ጉዳ አደበሙ።”</char><verse eid="LUK 20:47"/></para>
  <chapter eid="LUK 20"/>
  <chapter number="21" style="c" sid="LUK 21"/>
  <para style="s1">ቡሲ ሃዸ ህዬሳ ቶኮ</para>
  <para style="r">
    <ref loc="LUK 21:1-4">21፥1‑4</ref> ኩወፈ – <char style="xt"><ref loc="MRK 12:41-44">ማር 12፥41‑44</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 21:1"/>ዬሱስስ ኦል ምልአቴ ሶሬዪ ኬናሳኒ ምአ ቡሲ ኬሰ ቡሳ ጅረን አርጌ። <verse eid="LUK 21:1"/><verse number="2" style="v" sid="LUK 21:2"/>አከሱመስ ሃዸ ህዬሳ ህዬቲ ቶኮ ሳንትመ ስቢለ ዲማ ጥጥኖ ለመ ቡሱሼ አርጌ። <verse eid="LUK 21:2"/><verse number="3" style="v" sid="LUK 21:3"/>እንስ አከነ ጄዼ፤ <char style="wj">“አን ዹጉመን እስንት ህመ፤ ሃት ህዬሳ ህዬቲን ኩን ወረ ካን ሁንደ ጫላ ቡፍቴርት።</char> <verse eid="LUK 21:3"/><verse number="4" style="v" sid="LUK 21:4"/><char style="wj">ነሞትን ኩኔን ሁንድ ቀቤኘሳኒራ ኬነን፤ እሼን ገሩ ህዩመሼ ኬሳ ዋን እቲን ጅራቱ ሁንደ ኬንቴ።”</char><verse eid="LUK 21:4"/></para>
  <para style="s1">መለቶ ዹመ በራ</para>
  <para style="r">
    <ref loc="LUK 21:5-36">21፥5‑36</ref> ኩወፈ – <char style="xt"><ref loc="MAT 24">ማቴ 24</ref>፤ <ref loc="MRK 13">ማር 13</ref></char></para>
  <para style="r">
    <ref loc="LUK 21:12-17">21፥12‑17</ref> ኩወፈ – <char style="xt"><ref loc="MAT 10:17-22">ማቴ 10፥17‑22</ref></char></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 21:5"/>በረቶተሳ ኬሳስ ቶኮ ቶኮ ዋኤ መነ ቁልቁሉማ፣ ሃለ መን ቁልቁሉማ ሱን ዸጋወን በበሬደኒፊ ኬናወን ዋቃፍ ኬነመኒን እት ሚዸግፈሜ ዱዱበቻ ቱረን። ዬሱስ ገሩ አከነ ጄዼ፤ <verse eid="LUK 21:5"/><verse number="6" style="v" sid="LUK 21:6"/><char style="wj">“ዬሮን እት ወን እስን እላልተን ኩን ሁንድኑ፣ ኡቱ ዸጋን ቶኮዩ ወልረት ህንሀፍን ዲገሙ ቶኮ ንዹፈ።”</char><verse eid="LUK 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 21:7"/>እሳንስ፣ “ያ በርሲሳ፣ ወን ኩን ዮም ተአ? መለቶን ዬሮ ወን ኩን እት ፊጣን በኡ ገኡ ማል?” ጄዸኒ ጋፈተን።<verse eid="LUK 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 21:8"/>እንስ አከነ ጄዼ ዴብሴ፤ <char style="wj">“እስን አከ ህንጎዎምፈምኔፍ ኦፍ ኤገዸ። ነሞትን ሄዱን፣ ‘አን እሰ፤ ዬሮን ሱን ዽኣቴረ’ ጄቻ መቃኮቲን ንዹፉቲ። እስን ገሩ እሳን ዱካ ህንቡእና።</char> <verse eid="LUK 21:8"/><verse number="9" style="v" sid="LUK 21:9"/><char style="wj">ዮሙ ዋኤ ወራናቲፊ ዋኤ ፍንጭላ ዸጌሰንት፣ ህንሶዳትና። ወን ኩን ዱራን ዱርሴ ተኡ ቀባቲ፤ ዹምን ገሩ ዬሩመ ሰነ ህንተኡ።”</char><verse eid="LUK 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 21:10"/>እንስ አከነ እሳኒን ጄዼ፤ <char style="wj">“ሰብን ሰበት፣ ሞቱማንስ ሞቱማት ንከአ።</char> <verse eid="LUK 21:10"/><verse number="11" style="v" sid="LUK 21:11"/><char style="wj">እዶ ገራ ገራት ሶቺን ለፋ ጉዳን፣ ቤሊፊ ጎልፋን ንተአ፤ ሰሚረትስ ወን ሶዳችሳኒፊ መለቶን ጉርጉዳን ንተአ።</char><verse eid="LUK 21:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 21:12"/>
    <char style="wj">“ከነ ሁንደ ዱረ ገሩ እሳን እስን ቀቡ፤ እስን አርአቱስ። ደበርሰኒ መኔን ሰገዳት እስን ኬኑ፤ መነ ህዻ ኬሰስ እስን ቡሱ፤ እስን መቃኮቲፍ ጄተኒ ፉለ ሞቶታቲፊ ቡልችቶታ ዱረት ንዽኤፈምቱ።</char> <verse eid="LUK 21:12"/><verse number="13" style="v" sid="LUK 21:13"/><char style="wj">አከሲን እስን አናፍ ዹጋ ባቱ።</char> <verse eid="LUK 21:13"/><verse number="14" style="v" sid="LUK 21:14"/><char style="wj">እስን ገሩ አከምት አከ ፈልመተን ዱራን ዱርስተኒ አከ ህንያዶፍኔ ያደት ቀበዻ።</char> <verse eid="LUK 21:14"/><verse number="15" style="v" sid="LUK 21:15"/><char style="wj">አኑ አፋኒፊ ኦጉማ ዲኖትንኬሰን ቶኮዩ ደንደአኒ ዱረ ህንዻበትኔ ዮካን ህንሞርምኔ እስኒፍ ነንኬናቲ።</char> <verse eid="LUK 21:15"/><verse number="16" style="v" sid="LUK 21:16"/><char style="wj">አባፊ ሃት፣ ኦቦሎትን፣ ፍሮትኒፊ ምቾትን ደበርሰኒ እስን ኬኑ፤ እስን ኬሳስ ቶኮ ቶኮ ንአጄሱ።</char> <verse eid="LUK 21:16"/><verse number="17" style="v" sid="LUK 21:17"/><char style="wj">ነምን ሁንድኑ ሰበቢ መቃኮቲፍ እስን ጅበ።</char> <verse eid="LUK 21:17"/><verse number="18" style="v" sid="LUK 21:18"/><char style="wj">ገሩ ርፌንስ መታኬሰኒ ቶኮዩ ህንበዱ።</char> <verse eid="LUK 21:18"/><verse number="19" style="v" sid="LUK 21:19"/><char style="wj">እስን ጀባዻ ዻበዻ፤ ዮስ ሉቡኬሰን ንኦልፈቱ።</char><verse eid="LUK 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 21:20"/>
    <char style="wj">“እስን ዮሙ ዬሩሳሌም ሎልቶታን መርፈምቴ አርግተንት አከ በዲንሼ ዽኣቴ ቤካ።</char> <verse eid="LUK 21:20"/><verse number="21" style="v" sid="LUK 21:21"/><char style="wj">ዮሙስ ወር ይሁዳ ኬሰ ጅረን ጋረንት ሃበቀተን፤ ወር መጋላ ኬሰ ጅረንስ አቺ ሃበአን፤ ወር ባድያ ጅረንሞ መጋላ ህንሴንን።</char> <verse eid="LUK 21:21"/><verse number="22" style="v" sid="LUK 21:22"/><char style="wj">አከ ወን በሬፈሜ ሁንድኑ ራወተሙፍ ዬሮን ኩን ዬሮ ሃሎ ባሱቲ።</char> <verse eid="LUK 21:22"/><verse number="23" style="v" sid="LUK 21:23"/><char style="wj">በረ ሰነ ኬሰ ዱበርቶተ ኡልፋቲፊ ሃዾተ ሆስሰኒፍ ወዮ! ለፈረት ዽጵን ጉዳን፣ ሰበ ከነትሞ ዼከምስ ንዹፋቲ።</char> <verse eid="LUK 21:23"/><verse number="24" style="v" sid="LUK 21:24"/><char style="wj">እሳንስ ጎራዴዻን አጄፈሙ፤ ቦጅአመኒስ ብዮተ ኦርማ ሁንደት ንጌፈሙ፤ ሀመ በር ነሞተ ኦርማ ዹሙት ዬሩሳሌም ነሞተ ኦርማቲን ዽዺተምት።</char><verse eid="LUK 21:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 21:25"/>
    <char style="wj">“አዱረት፣ ጅአረት፣ ኡርጂወንረትስ መለቶን ንተአ። ለፈረትስ ሰበቢ ሁርሳቲፊ ዸኣ ገላናቲፍ ሰቦትን ንሙደሙ፤ ዋን ተአንስ ንወላሉ።</char> <verse eid="LUK 21:25"/><verse number="26" style="v" sid="LUK 21:26"/><char style="wj">ነሞትንስ ሰበቢ ሁምኖትን ሰሚራ ራፈመኒፍ፣ ዋን አዱኛ ከነት ዹፉፍ ጅሩ ያደአኒ ሶዳዻን ንገገቡ።</char> <verse eid="LUK 21:26"/><verse number="27" style="v" sid="LUK 21:27"/><char style="wj">እሳንስ ዬሮ ሰነ ኡቱ እልም ነማ ሁምናፊ ኡልፍነ ጉዳዻን ዱሜሳን ዹፉ ንአርጉ።</char> <verse eid="LUK 21:27"/><verse number="28" style="v" sid="LUK 21:28"/><char style="wj">ዮሙ ወን ኩን ተኡ ጀልቀቡት መታኬሰን ኦል ቀበዻ፤ ኦልስ እላላ፤ ፉረሙንኬሰን ዽኣቴራቲ።”</char><verse eid="LUK 21:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 21:29"/>እንስ አከነ ጄዼ ፈኬኘ ከነ እሳንት ህሜ፤ <char style="wj">“ሜ ሙከ ሀርቡቲፊ ሙከ ሁንደ እላላ።</char> <verse eid="LUK 21:29"/><verse number="30" style="v" sid="LUK 21:30"/><char style="wj">ዮሙ እሳን ባለ ባፈተንት እስን መታንኬሰንዩ እላልተኒ አከ ቦን ዽኣቴ ቤኩ ደንዴሱ።</char> <verse eid="LUK 21:30"/><verse number="31" style="v" sid="LUK 21:31"/><char style="wj">አከሱመ እስንስ ዮሙ ወን ኩን ራወተሙሳ አርግተንት አከ ሞቱማን ዋቃ ዽኣቴ ንቤክቱ።</char><verse eid="LUK 21:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 21:32"/>
    <char style="wj">“አን ዹጉመ እስንትን ህመ፤ ሀመ ወን ኩን ሁንድ ተኡት ዸሎትን ኩን ህንደርቡ።</char> <verse eid="LUK 21:32"/><verse number="33" style="v" sid="LUK 21:33"/><char style="wj">ሰሚፊ ለፍት ንደርቡ፤ ዱቢንኮ ገሩ ጎንኩማ ህንደርቡ።</char><verse eid="LUK 21:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 21:34"/>
    <char style="wj">“እስን ኦፍ ኤገዻ፤ ዮ ከና አቺ ቀልቢንኬሰን ቀነኒዻን፣ መቺፊ ያዶ ጅሬኛቲን ፉዸተሜ ጉያን ሱንስ ኡቱ እስን ህንቤክን አኩመ ክዮ እስን ቀበተ።</char> <verse eid="LUK 21:34"/><verse number="35" style="v" sid="LUK 21:35"/><char style="wj">ጉያን ሱን ወረ ለፈረ ጅራተን ሁንደት ንዹፋቲ።</char> <verse eid="LUK 21:35"/><verse number="36" style="v" sid="LUK 21:36"/><char style="wj">ከናፉ አከ ዋን ዹፉፍ ጅሩ ሁንደ ጀላ ባተኒፍ፣ አከ ፉለ እልመ ነማ ዱረስ ዻበቹ ደንዴሰኒፍ ዬሮ ሁንደ ደመቃ፤ ከዸዻስ።”</char><verse eid="LUK 21:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 21:37"/>ዬሱስ ጉዩመ ጉያን መነ ቁልቁሉማ ኬሰት በርሲሳ ቱሬ፤ ሀልከን ሀልከንሞ ቱሉ ጋረ ኤጄርሳ ጄዸሙረ ቡለ ቱሬ። <verse eid="LUK 21:37"/><verse number="38" style="v" sid="LUK 21:38"/>ነሞትን ሁንድኑስ እሰ ዸጌፈቹፍ ጄዸኒ በሪ በራቃን መነ ቁልቁሉማ ዹፉ ቱረን።<verse eid="LUK 21:38"/></para>
  <chapter eid="LUK 21"/>
  <chapter number="22" style="c" sid="LUK 22"/>
  <para style="s1">ይሁዳን ዬሱስን ደበርሴ ኬኑሳ</para>
  <para style="r">
    <ref loc="LUK 22:1">22፥1</ref>፣<ref loc="LUK 22:2">2</ref> ኩወፈ – <char style="xt"><ref loc="MAT 26:2-5">ማቴ 26፥2‑5</ref>፤ <ref loc="MRK 14:1">ማር 14፥1</ref>፣<ref loc="MRK 14:2">2</ref>፣<ref loc="MRK 14:10">10</ref>፣<ref loc="MRK 14:11">11</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 22:1"/>ዬሮ ሰነ አያን መጥኖ ከን ፋሲካ ጄዸሙ ዽኣቴ ቱሬ፤ <verse eid="LUK 22:1"/><verse number="2" style="v" sid="LUK 22:2"/>ሉቦትን ሀንገፎትኒፊ በርሲስቶትን ሴራ ዋን ነሞተ ሶዳተኒፍ፣ መለ እቲን ዬሱስን አጄሰን በርባዳ ቱረን። <verse eid="LUK 22:2"/><verse number="3" style="v" sid="LUK 22:3"/>ኤርገሲስ ሴጠን ነምቸ ይሁዳ አስቆሮትቸ ጄዸሙ ከን ጀረ ኩዸ ለማን ኬሳ ቶኮ ቱሬ ሰነት ገሌ። <verse eid="LUK 22:3"/><verse number="4" style="v" sid="LUK 22:4"/>ይሁዳንስ ገረ ሉቦተ ሀንገፎታቲፊ አጀጆተ ዋርድያ መነ ቁልቁሉማ ዸቄ ሃለ እቲን ዬሱስን ደበርሴ ኬኑረት እሳን ወጅን መርአቴ። <verse eid="LUK 22:4"/><verse number="5" style="v" sid="LUK 22:5"/>እሳንስ ገመደኒ ማለቀ እሳፍ ኬኑፍ ወሊ ገለን። <verse eid="LUK 22:5"/><verse number="6" style="v" sid="LUK 22:6"/>እንስ ቶሌ ጄዼ ዬሮ ነሞትን ህንጅሬት ዬሱስን ደበርሴ እሳንት ኬኑዻፍ ሃለ ምጃኣ ኤገቻ ቱሬ።<verse eid="LUK 22:6"/></para>
  <para style="s1">እርባተ ጎፍታ</para>
  <para style="r">
    <ref loc="LUK 22:7-13">22፥7‑13</ref> ኩወፈ – <char style="xt"><ref loc="MAT 26:17-19">ማቴ 26፥17‑19</ref>፤ <ref loc="MRK 14:12-16">ማር 14፥12‑16</ref></char></para>
  <para style="r">
    <ref loc="LUK 22:17-20">22፥17‑20</ref> ኩወፈ – <char style="xt"><ref loc="MAT 26:26-29">ማቴ 26፥26‑29</ref>፤ <ref loc="MRK 14:22-25">ማር 14፥22‑25</ref>፤ <ref loc="1CO 11:23-25">1ቆሮ 11፥23‑25</ref></char></para>
  <para style="r">
    <ref loc="LUK 22:21-23">22፥21‑23</ref> ኩወፈ – <char style="xt"><ref loc="MAT 26:21-24">ማቴ 26፥21‑24</ref>፤ <ref loc="MRK 14:18-21">ማር 14፥18‑21</ref>፤ <ref loc="JHN 13:21-30">ዮሀ 13፥21‑30</ref></char></para>
  <para style="r">
    <ref loc="LUK 22:25-27">22፥25‑27</ref> ኩወፈ – <char style="xt"><ref loc="MAT 20:25-28">ማቴ 20፥25‑28</ref>፤ <ref loc="MRK 10:42-45">ማር 10፥42‑45</ref></char></para>
  <para style="r">
    <ref loc="LUK 22:33">22፥33</ref>፣<ref loc="LUK 22:34">34</ref> ኩወፈ – <char style="xt"><ref loc="MAT 26:33-35">ማቴ 26፥33‑35</ref>፤ <ref loc="MRK 14:29-31">ማር 14፥29‑31</ref>፤ <ref loc="JHN 13:37">ዮሀ 13፥37</ref>፣<ref loc="JHN 13:38">38</ref></char></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 22:7"/>ጉያን አያነ መጥኖ ከን ሆላን ፋሲካ እት ቀለሙ ቀቡ ገኤ ቱሬ። <verse eid="LUK 22:7"/><verse number="8" style="v" sid="LUK 22:8"/>ዬሱስስ፣ <char style="wj">“አከ ፋሲካ ኛትኑፍ ዸቃቲ ኑ ቆጴሳ”</char> ጄዼ ጴጥሮሲፊ ዮሀንስን ኤርጌ።<verse eid="LUK 22:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 22:9"/>እሳንስ፣ “አከ ኑ ኤሰት ቆጴስኑ በርባደ?” ጄዸኒ እሰ ጋፈተን።<verse eid="LUK 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 22:10"/>እንሞ ዴብሴ አከነ ጄዼ፤ <char style="wj">“አኩመ እስን መጋላ ሴንተኒን፣ ነምች ኦኮቴ ብሻኒ ባቱ ቶኮ እስንት ዹፈ። ገረ መነ እን ሴኑት እሰ ዱካ ቡኣቲ፣</char> <verse eid="LUK 22:10"/><verse number="11" style="v" sid="LUK 22:11"/><char style="wj">አባ መነ ሰናቲን፣ ‘በርሲሳን፣ “መን ኬሱማ፣ እዶን አን እት በረቶተኮ ወጅን ፋሲካ ኛዹ ኤሳ?” ሲን ጄዸ’ ጄዻ።</char> <verse eid="LUK 22:11"/><verse number="12" style="v" sid="LUK 22:12"/><char style="wj">አባን መና ሱንስ ደርቢ በልኣ ምአ መናቲን ጉተሜ ቶኮ እስንት አርግሲሰ። እስንስ አችት ቆጴሳ።”</char><verse eid="LUK 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 22:13"/>እሳንስ ዸቀኒ አኩመ ዬሱስ እሳንት ህሜ ሰነት አርገተን። ፋሲካስ ንቆጴሰን።<verse eid="LUK 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 22:14"/>ዮሙ ሰኣቲን ሱን ገኤት ዬሱሲፊ ኤርገሞትንሳ ማዲት ዽኣተን። <verse eid="LUK 22:14"/><verse number="15" style="v" sid="LUK 22:15"/>እንስ አከነ እሳኒን ጄዼ፤ <char style="wj">“አን ኡቱ ህንዽጰትኒን ዱረ እስን ወጅን ፋሲካ ከነ ኛቹ አከ መሌ ሀዌን ቱሬ።</char> <verse eid="LUK 22:15"/><verse number="16" style="v" sid="LUK 22:16"/><char style="wj">አን እስንትን ህማቲ፤ ሀመ ፋሲካን ኩን ሞቱማ ዋቃ ኬሰት ራወተሙት አን ዴብኤ እሰ ህንኛዹ።”</char><verse eid="LUK 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 22:17"/>እንስ ኤርገ ጦፎ ፉዼ ገለተ ገልቼን ቦዴ አከነ ጄዼ፤ <char style="wj">“ከነ ፉዸዻቲ ገርገር ቆደዻ።</char> <verse eid="LUK 22:17"/><verse number="18" style="v" sid="LUK 22:18"/><char style="wj">አን እስንት ነንህማቲ፤ አን ሀመ ሞቱማን ዋቃ ዹፉት እጀ ወይኒ ከነራ ዴብኤ ህንዹጉ”</char> ጄዼ።<verse eid="LUK 22:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 22:19"/>እንስ ቡዴነ ፉዼ ገለተ ገልቼ፣ ጨጨብሴ እሳኒፍ ኬኔ፣ <char style="wj">“ኩን ፎንኮ ከን እስኒፍ ኬነሙዸ፤ ከነስ ያደኖኮቲፍ ጎዸዻ”</char> ጄዼን።<verse eid="LUK 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 22:20"/>አከሱመስ እርባተ ቦዴ ጦፎ ሰነ ፉዼ አከነ ጄዼ፤ <char style="wj">“ጦፎን ኩን ከኩ ሃራ ዺገኮ ከን እስኒፍ ዸንገላፈሙን ተኡዸ።</char> <verse eid="LUK 22:20"/><verse number="21" style="v" sid="LUK 22:21"/><char style="wj">ገሩ ሀርክ ነምቸ ደበርሴ ነ ኬኑ ሰና ኩኖ ሀርከኮ ወጅን ማዲረ ጅረ።</char> <verse eid="LUK 22:21"/><verse number="22" style="v" sid="LUK 22:22"/><char style="wj">እልም ነማ አኩመ ሙርቴፈሜ ሰነት ንዴመ። ገሩ ነምቸ ደበርሴ እሰ ኬኑ ሰናፍ ወዮ!”</char> <verse eid="LUK 22:22"/><verse number="23" style="v" sid="LUK 22:23"/>እሳንስ ነምን እሳን ኬሳ ዋን ከነ ጎቹፍ ጅሩ ኤኙ አከ ተኤ ወል ገጋፈቹ ጀልቀበን።<verse eid="LUK 22:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 22:24"/>አከሱመስ እሳን ኬሳ ነምን አከ ነመ ነመ ሁንዱማ ጫሉት እላለሙ ኤኙ አከ ተኤረት ወል ፈልሚን ግዱሳኒት ከኤ። <verse eid="LUK 22:24"/><verse number="25" style="v" sid="LUK 22:25"/>ዬሱስስ አከነ እሳኒን ጄዼ፤ <char style="wj">“ሞቶትን ነሞተ ኦርማ እሳንረት ጎፍቱማ ሙልእሱ፤ ወር እሳንረት ታይታ አርግሲሰንሞ ገርጋርቶተ ኦፊን ጄዹ።</char> <verse eid="LUK 22:25"/><verse number="26" style="v" sid="LUK 22:26"/><char style="wj">እስን ገሩ አከስ ተኡ ህንቀብደን። ቆደ ከና እስን ኬሳ ነምን ነመ ሁንደ ጫሉ፣ አከ ቁጥሱ ነመ ሁንዳ፣ ቡልቻንሞ አከ ተጃጅላ ሃተኡ።</char> <verse eid="LUK 22:26"/><verse number="27" style="v" sid="LUK 22:27"/><char style="wj">ኤኙቱ ጉዳዸ? ነመ ማዲት ዽኣቱሞ ነመ ተጃጅሉ? ነመ ማዲት ዽኣቱ ምቲ? አን ገሩ እስን ግዱት አከ ተጃጅላ ቶኮት።</char> <verse eid="LUK 22:27"/><verse number="28" style="v" sid="LUK 22:28"/><char style="wj">እስንሞ ወረ ዬሮ ቆረመኮ ነ ወጅን ቱርተኒዸ።</char> <verse eid="LUK 22:28"/><verse number="29" style="v" sid="LUK 22:29"/><char style="wj">አኩመ አባንኮ ሞቱማ ነት ኬኔ፣ አንስ አከሱመ እስንትን ኬነ፤</char> <verse eid="LUK 22:29"/><verse number="30" style="v" sid="LUK 22:30"/><char style="wj">ኩንስ አከ እስን ሞቱማኮ ኬሰት ማዲኮራ ኛተኒፊ ዹግደን፣ አከ ቴሶወንረ ቴሰኒ ጎሶተ እስራኤል ኩዸ ለማንት ሙርተኒፍ።</char><verse eid="LUK 22:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 22:31"/>
    <char style="wj">“ያ ስሞን፣ ያ ስሞን፤ ኩኖ፣ ሴጠን አኩመ ቀመዲት እስን ግንግልቹፍ ከዸቴረ።</char> <verse eid="LUK 22:31"/><verse number="32" style="v" sid="LUK 22:32"/><char style="wj">ያ ስሞን፣ አን ገሩ አከ አመንቲንኬ ህንደዸብኔፍ ሲፍ ከዸዼረ፤ አትስ ዮሙ ዴብቱት፣ ኦቦሎተኬ ጀጀቤስ።”</char><verse eid="LUK 22:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 22:33"/>ስምኦን ገሩ ዴብሴ፣ “ያ ጎፍታ፣ አን ስ ወጅን ህዸሙፊ ዱኡፍሌ ቆጳኤረ” ጄዼ።<verse eid="LUK 22:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 22:34"/>ዬሱስ፣ <char style="wj">“ያ ጴጥሮስ፣ አን ስት ነንህመ፤ አት ሀርአ ኡቱ እንዳንቆን ህንእይን አኩመ ነ ቤክቱሌ ዬሮ ሰዲ ንገንተ”</char> ጄዼ ዴብሴ።<verse eid="LUK 22:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 22:35"/>ዬሱስስ፣ <char style="wj">“ዬሮ አን ቦርሳ፣ ኮሮጆ ዮካን ኮጴ መሌ እስን ኤርጌ ሰነ ዋ እስን ዱራ ህርአቴራ?”</char> ጄዼ እሳን ጋፈቴ።</para>
  <para style="p" vid="LUK 22:35">እሳንስ ዴብሰኒ፣ “ወን ቶኮዩ ህንህርአትኔ” ጄዸን።<verse eid="LUK 22:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 22:36"/>እንሞ አከነ እሳኒን ጄዼ፤ <char style="wj">“አመ ገሩ ዮ ቦርሳ ቀባተን ፉዸዻ፤ ዮ ኮሮጆ ቀባተንስ ፉዸዻ፤ ዮ ጎራዴ ህንቀባትኔስ ኡፈተኬሰን ጉርጉራቲ ጎራዴ ብተዻ።</char> <verse eid="LUK 22:36"/><verse number="37" style="v" sid="LUK 22:37"/><char style="wj">ወን፣ ‘እን የክቶተት ለካአሜ’</char><note caller="+" style="f"><char style="fr" closed="false">22፥37 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 53:12">እሳ 53፥12</ref></char></char></note> <char style="wj">ጄዸሜ በሬፈሜ ሱን አከ ነረት ራወተሙ ቀቡ አን እስንትን ህመ፤ ወን ዋኤኮ በሬፈሜ ራወተሙ ገኤራቲ።”</char><verse eid="LUK 22:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 22:38"/>በረቶትንስ፣ “ያ ጎፍታ፣ ኩኖ ጎራዴ ለመቱ አስ ጅረ” ጄዸን።</para>
  <para style="p" vid="LUK 22:38">እንስ፣ <char style="wj">“ንገአ”</char> ጄዼ ዴብሴፍ።<verse eid="LUK 22:38"/></para>
  <para style="s1">ዬሱስ ቱሉ ኤጄርሳረት ከዸቹሳ</para>
  <para style="r">
    <ref loc="LUK 22:40-46">22፥40‑46</ref> ኩወፈ – <char style="xt"><ref loc="MAT 26:36-46">ማቴ 26፥36‑46</ref>፤ <ref loc="MRK 14:32-42">ማር 14፥32‑42</ref></char></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 22:39"/>ዬሱስስ አቺ በኤ፣ አኩመ አመለሳ ገረ ቱሉ ኤጄርሳ ዸቄ፤ በረቶትንሳስ እሰ ዱካ ቡአን። <verse eid="LUK 22:39"/><verse number="40" style="v" sid="LUK 22:40"/>እንስ አኩመ እዶ ሰነ ገኤን፣ <char style="wj">“እስን አከ ቆሩምሰት ህንገሌፍ ከዸዻ”</char> እሳኒን ጄዼ። <verse eid="LUK 22:40"/><verse number="41" style="v" sid="LUK 22:41"/>እንስ ሀመ ደርበተ ዸጋ ቶኮ አች ሂቄ፣ ጅልቤንፈቴስ አከነ ጄዼ ከዸቴ፤ <verse eid="LUK 22:41"/><verse number="42" style="v" sid="LUK 22:42"/><char style="wj">“ያ አባ፣ ዮ ፌዺኬ ተኤ፣ ጦፎ ከነ ነራ ፉዽ፤ ገሩ አከ ፌዺኬቲ መሌ አከ ፌዺኮቲ ህንተእን።”</char> <verse eid="LUK 22:42"/><verse number="43" style="v" sid="LUK 22:43"/>ኤርገማን ዋቃ ቶኮስ ሰሚራ እሰት ሙልአቴ እሰ ጀጀቤሴ። <verse eid="LUK 22:43"/><verse number="44" style="v" sid="LUK 22:44"/>እንስ ሉበሜ ጀቤሴ ከዸቴ፤ ደፍቅሳስ አከ ጮጮጰ ዺጋ ለፈት ጮጳ ቱሬ።<verse eid="LUK 22:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 22:45"/>እንስ ዮሙ ከዸትናራ ከኤ ገረ በረቶታት ዴብኤት፣ እሳኒ ገዳን ቡቱተኒ ረፋ ጅረን አርጌ። <verse eid="LUK 22:45"/><verse number="46" style="v" sid="LUK 22:46"/>እንስ፣ <char style="wj">“እስን ማሊፍ ረፍቱ? እስን አከ ቆሩምሰት ህንገሌፍ ከኣቲ ከዸዻ”</char> እሳኒን ጄዼ።<verse eid="LUK 22:46"/></para>
  <para style="s1">ዬሱስ ቀበሙሳ</para>
  <para style="r">
    <ref loc="LUK 22:47-53">22፥47‑53</ref> ኩወፈ – <char style="xt"><ref loc="MAT 26:47-56">ማቴ 26፥47‑56</ref>፤ <ref loc="MRK 14:43-50">ማር 14፥43‑50</ref>፤ <ref loc="JHN 18:3-11">ዮሀ 18፥3‑11</ref></char></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 22:47"/>ኡቱመ እን አመዩ ዱበቻ ጅሩስ፣ ቱትን ነሞታ ቶኮ ዹፌ፤ ነምች ይሁዳ ጄዸሙ ከን ወረ ኩዸ ለማን ኬሳ ቶኮ ተኤ ሱንስ እሳን ዱረ ዴማ ቱሬ። እንስ ዬሱስን ዹንገቹፍ እት ዽኣቴ፤ <verse eid="LUK 22:47"/><verse number="48" style="v" sid="LUK 22:48"/>ዬሱስ ገሩ፣ <char style="wj">“ያ ይሁዳ፣ አት ዹንጎዻን እልመ ነማ ደበርስቴ ኬንታ?”</char> ጄዼ ጋፈቴ።<verse eid="LUK 22:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 22:49"/>ወር እሰ ወጅን ቱረንስ ዮሙ ዋን ተኡፍ ጅሩ አርገንት፣ “ያ ጎፍታ፣ ጎራዴዻን እሳን ዾፍኑ?” ጄዸን። <verse eid="LUK 22:49"/><verse number="50" style="v" sid="LUK 22:50"/>እሳን ኬሳስ ነምን ቶኮ ገርብቸ ሉበ ኦል ኣና ዸኤ ጉረሳ ምርጋ እራ ኩቴ።<verse eid="LUK 22:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 22:51"/>ዬሱስስ ዴብሴ፣ <char style="wj">“ዺሳ! ዋን አከና እት ህንዴብእና”</char> ጄዼ፤ ጉረ ነምቻስ ቱቱቄ ፈይሴ።<verse eid="LUK 22:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 22:52"/>ኤርገሲስ ዬሱስ ሉቦተ ሀንገፎተ፣ ዱረ ቡኦተ መነ ቁልቁሉማቲፊ ማንጉዶተ እሰ ቀቡ ዹፈኒን አከነ ጄዼ፤ <char style="wj">“እስን ጎራዴፊ ቦኩ ቀበተኒ አከ ነመ ሀቱ ቀቡት ዹፍተኒ?</char> <verse eid="LUK 22:52"/><verse number="53" style="v" sid="LUK 22:53"/><char style="wj">አን ጉዩመ ጉያን መነ ቁልቁሉማ ኬሰ እስን ወጅነን ቱሬ፤ እስን ሀርካኑ ነ ህንቱቅኔ። ገሩ ሰኣቲን ኩን ሰኣቲኬሰን፤ እንስ ዬሮ እት ዱከን ሞኡዸ።”</char><verse eid="LUK 22:53"/></para>
  <para style="s1">ጴጥሮስ ዬሱስን ገኑሳ</para>
  <para style="r">
    <ref loc="LUK 22:55-62">22፥55‑62</ref> ኩወፈ – <char style="xt"><ref loc="MAT 26:69-75">ማቴ 26፥69‑75</ref>፤ <ref loc="MRK 14:66-72">ማር 14፥66‑72</ref>፤ <ref loc="JHN 18:16-18">ዮሀ 18፥16‑18</ref>፣<ref loc="JHN 18:25-27">25‑27</ref></char></para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 22:54"/>እሳንስ እሰ ቀበኒ ፉዸኒ ዴመን፤ ፍደኒስ መነ ሉበ ኦል ኣና ኦል እሰ ሴንስሰን። ጴጥሮስሞ ፈጎት ዱካ ቡኣ ቱሬ። <verse eid="LUK 22:54"/><verse number="55" style="v" sid="LUK 22:55"/>ዮሙ እሳን ወለካ ለፈ ደላ ኬሳት እብደ ቀብሲሰኒ ወሊ ወጅን ተታአንት ጴጥሮስስ እሳን ወጅን ታኤ። <verse eid="LUK 22:55"/><verse number="56" style="v" sid="LUK 22:56"/>ጦምቦሬን ቶኮስ ኡቱ እን እፈ እብዳ ኬሰ ታኤ ጅሩ እሰ አርግቴ። እሼንስ ሁበቴ እሰ እላልቴ፣ “ነምች ኩንስ እሰ ወጅን ቱሬ” ጄቴ።<verse eid="LUK 22:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 22:57"/>እን ገሩ፣ “ዱበርቲነነ፣ አን እሰ ህንቤኩ” ጄዼ ገኔ።<verse eid="LUK 22:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 22:58"/>ዬሮ ጥኖ ቦዴ ነምን ብራ እሰ አርጌ፣ “አትስ ጀረ ኬሳ ቶኮዸ” ጄዼ።</para>
  <para style="p" vid="LUK 22:58">ጴጥሮስ ገሩ፣ “ነምቾ፣ አነ ምት” ጄዼ ዴብሴ።<verse eid="LUK 22:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 22:59"/>ገረ ሰኣቲ ቶኮ ቦዴ ነምን ብራ፣ “ነምች ኩንስ ዋን ነመ ገሊላ ተኤፍ ዹጉመዩ እሰ ወጅን ቱሬ” ጄዼ ጀቤሴ ዱበቴ።<verse eid="LUK 22:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 22:60"/>ጴጥሮስሞ ዴብሴ፣ “ነምቾ፣ አን ዋን አት ጄቱ ከነ ህንቤኩ” ጄዼ። ኡቱመ እን ዱበቻ ጅሩስ እንዳንቆን እዬ። <verse eid="LUK 22:60"/><verse number="61" style="v" sid="LUK 22:61"/>ጎፍታንስ ገረገሌ ጴጥሮስን እላሌ። ጴጥሮስስ ዋን ጎፍታን፣ <char style="wj">“አት ሀርአ ኡቱ እንዳንቆን ህንእይን ዬሮ ሰዲ ነ ገንተ”</char> እሳን ጄዼ ቱሬ ሰነ ያደቴ። <verse eid="LUK 22:61"/><verse number="62" style="v" sid="LUK 22:62"/>እንስ ገድ በኤ ህቅፈቴ ቦኤ።<verse eid="LUK 22:62"/></para>
  <para style="s1">ኤግዶትን ዬሱስት ቆሱሳኒ</para>
  <para style="r">
    <ref loc="LUK 22:63-65">22፥63‑65</ref> ኩወፈ – <char style="xt"><ref loc="MAT 26:67">ማቴ 26፥67</ref>፣<ref loc="MAT 26:68">68</ref>፤ <ref loc="MRK 14:65">ማር 14፥65</ref>፤ <ref loc="JHN 18:22">ዮሀ 18፥22</ref>፣<ref loc="JHN 18:23">23</ref></char></para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 22:63"/>ነሞትን ዬሱስን ኤጋ ቱረን ሱን እሰት ቆሱፊ እሰ ቱሙ ጀልቀበን። <verse eid="LUK 22:63"/><verse number="64" style="v" sid="LUK 22:64"/>እሳንስ እሰ ሀጉገኒ፣ “ሜ ራጂ ዱበዹ! ኤኙቱ ስ ሩኩቴ?” ጄዸኒ እሰ ጋፈተን። <verse eid="LUK 22:64"/><verse number="65" style="v" sid="LUK 22:65"/>እሳንስ እሰ አረብሳ ዋን ሄዱ እሳን ጄዸን።<verse eid="LUK 22:65"/></para>
  <para style="s1">ዬሱስ ያኢ ይሁዶታ ዱረት ዽኣቹሳ</para>
  <para style="r">
    <ref loc="LUK 22:67-71">22፥67‑71</ref> ኩወፈ – <char style="xt"><ref loc="MAT 26:63-66">ማቴ 26፥63‑66</ref>፤ <ref loc="MRK 14:61-63">ማር 14፥61‑63</ref>፤ <ref loc="JHN 18:19-21">ዮሀ 18፥19‑21</ref></char></para>
  <para style="r">
    <ref loc="LUK 23:2">23፥2</ref>፣<ref loc="LUK 23:3">3</ref> ኩወፈ – <char style="xt"><ref loc="MAT 27:11-14">ማቴ 27፥11‑14</ref>፤ <ref loc="MRK 15:2-5">ማር 15፥2‑5</ref>፤ <ref loc="JHN 18:29-37">ዮሀ 18፥29‑37</ref></char></para>
  <para style="r">
    <ref loc="LUK 23:18-25">23፥18‑25</ref> ኩወፈ – <char style="xt"><ref loc="MAT 27:15-26">ማቴ 27፥15‑26</ref>፤ <ref loc="MRK 15:6-15">ማር 15፥6‑15</ref>፤ <ref loc="JHN 18:39-19:16">ዮሀ 18፥39–19፥16</ref></char></para>
  <para style="p">
    <verse number="66" style="v" sid="LUK 22:66"/>ዮሙ ለፍት በርኤትስ ያኢን ማንጉዶተ ሰባ አከሱመስ ሉቦትን ሀንገፎትኒፊ በርሲስቶትን ሴራ ወልት ቀበመን፤ ያእሳኒ ዱረትስ ዬሱስን ዽኤሰኒ፣ <verse eid="LUK 22:66"/><verse number="67" style="v" sid="LUK 22:67"/>“አት ዮ ክርስቶስ ታቴ ሜ ኑት ህም” ጄዸኒን።</para>
  <para style="p" vid="LUK 22:67">ዬሱስስ አከነ ጄዼ ዴብሴ፤ <char style="wj">“ዮ አን እስንት ህሜ እስን ነ ህንአመንተን፤</char> <verse eid="LUK 22:67"/><verse number="68" style="v" sid="LUK 22:68"/><char style="wj">ዮ አን እስን ጋፈዼስ ህንዴብፍተን።</char> <verse eid="LUK 22:68"/><verse number="69" style="v" sid="LUK 22:69"/><char style="wj">ገሩ ስአች እልም ነማ ከራ ምርገ ሁምነ ዋቃቲን ንታአ።”</char><verse eid="LUK 22:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="LUK 22:70"/>ሁንድሳኒስ፣ “ዮስ አት እልመ ዋቃቲሬ?” ጄዸኒ ጋፈተን።</para>
  <para style="p" vid="LUK 22:70">እንስ ዴብሴ፣ <char style="wj">“አከ አነ ተኤ እስኑ ንዱበቱ!”</char> ጄዼ።<verse eid="LUK 22:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="LUK 22:71"/>ከነረት እሳን፣ “ከነ ጫላ ዹገ በኡምሰ ማሊ ኑ በርባችሰ? ኑ መታንኬኘዩ አፋኑመሳራ ዸጌኜራቲ” ጄዸን።<verse eid="LUK 22:71"/></para>
  <chapter eid="LUK 22"/>
  <chapter number="23" style="c" sid="LUK 23"/>
  <para style="p">
    <verse number="1" style="v" sid="LUK 23:1"/>ኤርገሲ ያኢን ሱን ጉቱን ከኤ ዬሱስን ገረ ጲላጦስት ጌሴ። <verse eid="LUK 23:1"/><verse number="2" style="v" sid="LUK 23:2"/>እሳንስ፣ “ኑ ኡቱ ነምች ኩን ሰበኬኘ ከራራ ጀልእሱ፣ ኡቱ እን አከ ግብር ቄሳሪፍ ህንባፈምኔ ጎዹ፣ አከሱመስ ኡቱ እን አከ መታንሳ ክርስቶስ ሞትቸ ተኤ ዱበቱ አርግኔረ” ጄዸኒ እሰ ህመቹ ጀልቀበን።<verse eid="LUK 23:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 23:3"/>ከናፉ ጲላጦስ፣ “አት ሞቲ ይሁዶታቲ?” ጄዼ ዬሱስን ጋፈቴ።</para>
  <para style="p" vid="LUK 23:3">ዬሱስሞ፣ <char style="wj">“አቱ ጄቴካ!”</char> ጄዼ ዴብሴ።<verse eid="LUK 23:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 23:4"/>ጲላጦስስ ሉቦተ ሀንገፎታፊ ቱተ ነሞታቲን፣ “አን ነምቸ ከነረት የከ ቶኮሌ ህንአርገትኔ” ጄዼ።<verse eid="LUK 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 23:5"/>እሳን ገሩ እቱመ ጫልችሰኒ፣ “እን ገሊላራ ጀልቀቤ ይሁዳ ሁንደ ኬሰት በርሲሰሳቲን ሰበ ጄቃ ሀመ አሲትሌ ዹፌረ” ጄዸን።<verse eid="LUK 23:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 23:6"/>ጲላጦስስ ዮሙ ዋን ከነ ዸገኤት፣ “ነምች ኩን ነመ ገሊላቲ?” ጄዼ ጋፈቴ። <verse eid="LUK 23:6"/><verse number="7" style="v" sid="LUK 23:7"/>እንስ ዮሙ አከ ዬሱስ ነመ ኩታ ሄሮድስ ቡልቹ ተኤ ቤኬት ሄሮድስት እሰ ኤርጌ፤ ሄሮድስስ ዬሮ ሰነ ዬሩሳሌም ኬሰ ቱሬ።<verse eid="LUK 23:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 23:8"/>ሄሮድስ ዮሙ ዬሱስን አርጌት አከ መሌ ገመዴ፤ እን ሰበቢ ዋኤ ዬሱስ ዸገኣፊ ሆጂ ድንቂ ከን እን ሆጄቱ ቶኮ ቶኮ አከ አርጉ አብደቻ ቱሬፍ ዬሮ ዼራፍ እሰ አርጉ በርባዳ ቱሬ። <verse eid="LUK 23:8"/><verse number="9" style="v" sid="LUK 23:9"/>እንስ ጋፊ ባይኤ እሰ ጋፈቴ፤ ዬሱስ ገሩ ዴቢ ቶኮሌ ህንኬንኔፍ። <verse eid="LUK 23:9"/><verse number="10" style="v" sid="LUK 23:10"/>ሉቦትን ሀንገፎትኒፊ በርሲስቶትን ሴራ አች ዸዻበተኒ ጭምሰኒ እሰ ህመቻ ቱረን። <verse eid="LUK 23:10"/><verse number="11" style="v" sid="LUK 23:11"/>ሄሮድሲፊ ሎልቶትንሳ እሰ ቱፈተን፤ እሰት ቆሰንስ። እሳንስ ኡፈተ ሚዸጋ እሰት ኡፍሰኒ ዴብሰኒ ጲላጦስት እሰ ኤርገን። <verse eid="LUK 23:11"/><verse number="12" style="v" sid="LUK 23:12"/>ጉዩመ ሰነ ሄሮድሲፊ ጲላጦስ ወልት ምቾመን፤ እሳን ዱራን ዲነ ወሊ ቱረኒቲ።<verse eid="LUK 23:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 23:13"/>ጲላጦስስ ሉቦተ ሀንገፎተ፣ ቡልችቶታፊ ሰበ ወልት ዋሜ፣ <verse eid="LUK 23:13"/><verse number="14" style="v" sid="LUK 23:14"/>አከነ እሳኒን ጄዼ፤ “እስን ነምች ኩን፣ ‘ከራራ ሰበ ጀልእሰ’ ጄተኒ እሰ ነት ፍደን፤ አንስ ፉሉመኬሰን ዱረት እሰ ቆሬ አከ እን ዋን እስን እቲን እሰ ህመተን ሰነ ኬሳ ቶኮሌ ሆጄቴ ህንአርግኔ። <verse eid="LUK 23:14"/><verse number="15" style="v" sid="LUK 23:15"/>ሄሮድስስ ዋን ቶኮሌ እሰረት ህንአርግኔ፤ እን ዴብሴ እሰ ኑት ኤርጌራቲ። አኩመ እስን አርግተን ከነ ነምች ኩን ዋን ዱኣን እሰ ገኡ ቶኮሌ ህንሆጄትኔ። <verse eid="LUK 23:15"/><verse number="16" style="v" sid="LUK 23:16"/>ከናፉ አን ነምቸ ከነ አደቤን ገድ እሰ ዺሰ።” [ <verse eid="LUK 23:16"/><verse number="17" style="v" sid="LUK 23:17"/>ጲላጦስስ ጉያ አያናቲን ነመ ቶኮ መነ ህዻቲ ገድ እሳኒ ዺሱን ድርቀመ ቱሬ።]<note caller="+" style="f"><char style="fr" closed="false">23፥17 </char><char style="ft" closed="false">ወራብሌን ዱሪ ቶኮ ቶኮ ሉቅሳ ከነ ህንደበለተን።</char></note><verse eid="LUK 23:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 23:18"/>እሳን ገሩ ሰገሌ ቶኮን እየኒ፣ “ነምቸ ከነ በሌስ! በረባስን ገድ ኑ ዺስ!” ጄዸን። <verse eid="LUK 23:18"/><verse number="19" style="v" sid="LUK 23:19"/>በርባን ሰበቢ ፍንጭለ መጋላ ኬሰት ከኤቲፊ አጄቻ ነማቲን መነ ህዻ ኬሰ ቡፈሜ ቱሬ።<verse eid="LUK 23:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 23:20"/>ጲላጦስስ ዬሱስን ገድ ዺሱ በርባዴ አመሌ እሳንት ዱበቴ። <verse eid="LUK 23:20"/><verse number="21" style="v" sid="LUK 23:21"/>እሳን ገሩ፣ “እሰ ፈንስ! እሰ ፈንስ!” ጄዸኒ እያ ቱረን።<verse eid="LUK 23:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 23:22"/>እንስ ዬሮ ሰደፋ፣ “ማሊፍ? ነምች ኩን የከ ማሊ ሆጄቴ? አን የከ ዱኣን እሰ ገኡ እሰረት ህንአርገትኔ። ከናፉ አን እሰ አደቤን ገድ እሰ ዺሰ” እሳኒን ጄዼ።<verse eid="LUK 23:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 23:23"/>እሳን ገሩ አከ እን ፈንፈሙፍ ሰገሌ ጉዳዻን እቱመ ጭቸኒ ጋፈተን፤ እይሳኒስ እቱመ ጀባቴ። <verse eid="LUK 23:23"/><verse number="24" style="v" sid="LUK 23:24"/>ከናፍ ጲላጦስ ዋን እሳን ከዸተን ሰነ እሳኒፍ ኬኑ ሙርቴሴ። <verse eid="LUK 23:24"/><verse number="25" style="v" sid="LUK 23:25"/>እንስ ነምቸ ሰበቢ ፍንጭላቲፊ ሰበቢ አጄቻ ነማቲን መነ ህዻ ኬሰ ቡፈሜ ከን እሳን አከ እን ሂከሙፍ ከዸተን ሰነ ገድ ዺሴ፤ ዬሱስንሞ ደበርሴ ፌዺሳኒት ኬኔ።<verse eid="LUK 23:25"/></para>
  <para style="s1">ዬሱስ ፈንፈሙሳ</para>
  <para style="r">
    <ref loc="LUK 23:33-43">23፥33‑43</ref> ኩወፈ – <char style="xt"><ref loc="MAT 27:33-44">ማቴ 27፥33‑44</ref>፤ <ref loc="MRK 15:22-32">ማር 15፥22‑32</ref>፤ <ref loc="JHN 19:17-24">ዮሀ 19፥17‑24</ref></char></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 23:26"/>እሳንስ ኡቱ ዬሱስን ጌሳ ጅረኑ ስሞን ነምቸ ቀሬና ቶኮ ኡቱ እን ባድያዻ ዹፋ ጅሩ ቀበን፤ ፈኖ ሰነስ እሰረ ካአኒ አከ እን ባቴ ዬሱስ ዱባን ዴሙ እሰ ድርቅሲሰን። <verse eid="LUK 23:26"/><verse number="27" style="v" sid="LUK 23:27"/>ነሞትን ባይኤን፣ ዱበርቶተ ኬሳስ ወር እሳፍ ገዳፊ ቦኣ ቱረን እሰ ዱካ ቡአን። <verse eid="LUK 23:27"/><verse number="28" style="v" sid="LUK 23:28"/>ዬሱስስ እሳንት ገረገሌ አከነ ጄዼ፤ <char style="wj">“ያ ዱርቦተ ዬሩሳሌም፣ ኦፊኬሰኒፊ እጆሌኬሰኒፍ ቦኣ መሌ ናፍ ህንቦእና።</char> <verse eid="LUK 23:28"/><verse number="29" style="v" sid="LUK 23:29"/><char style="wj">ኩኖ ጉዮትን እት ነሞትን፣ ‘ዱበርቶትን ዸብዶትን፣ ገራን ተኩማ ኡልፈ ህንባትኒፊ ሀርም ተኩማ ህንሆስስን ኤብፈሞዸ’ ጄዸን ንዹፉቲ።</char> <verse eid="LUK 23:29"/><verse number="30" style="v" sid="LUK 23:30"/><char style="wj">ዬሮ ሰነ፣</char></para>
  <para style="q1" vid="LUK 23:30">
    <char style="wj">“ ‘ነሞትን ጋረኒን፣ “ኑረት ጅጋ!”</char></para>
  <para style="q2" vid="LUK 23:30">
    <char style="wj">ቱሉወኒንሞ፣ “ኑ ዾክሳ!”</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">23፥30 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="HOS 10:8">ሆሴ 10፥8</ref>
        </char>
      </char>
    </note> <char style="wj">ንጄዹ።’</char><verse eid="LUK 23:30"/></para>
  <para style="m">
    <verse number="31" style="v" sid="LUK 23:31"/>
    <char style="wj">እሳን ኤርገ ሙከ ጂዻ አከነ ጎዸኒ ሙከ ጎጋሞ አከም ሃጎዸን?”</char><verse eid="LUK 23:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 23:32"/>ነሞትን ብራ ከኔን የክቶተ ቱረን ለመስ እሰ ወጅን አጄፈሙፍ ጌፈመን። <verse eid="LUK 23:32"/><verse number="33" style="v" sid="LUK 23:33"/>ዮሙ እዶ ቡቄ መታ ጄዸሙ ገአንት አችት እሰ ፈንሰን፤ የክቶተ ሰነስ፣ እሰ ቶኮ ምርገሳቲን፣ ካንሞ ብታሳቲን ፈንሰን። <verse eid="LUK 23:33"/><verse number="34" style="v" sid="LUK 23:34"/>ዬሱስስ፣ <char style="wj">“ያ አባ፣ እሳን ዋን ሆጄተን ህንቤከኒቲ እሳኒፍ ዺስ”</char> ጄዼ። እሳንስ እጣ ቡፈተኒ ኡፈተሳ ገርገር ቆደተን።<verse eid="LUK 23:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 23:35"/>ነሞትንስ አች ዸዻበተኒ እላላ ቱረን፤ ቡልችቶትን ገሩ፣ “እን ወረ ካን ኦልቼረ። እን ዮ ዹጉመ ክርስቶስ ዋቃ እሰ ፍለተማ ሰነ ተኤ ሜ ኦፍ ሃኦልቹ!” ጄዸኒ እሰት ቆሰን።<verse eid="LUK 23:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 23:36"/>ሎልቶትንስ እሰት ዽኣተኒ እት ቆሳ ዳዺ ወይኒ ዸንገጋኣ ኬነኒፊ፣ <verse eid="LUK 23:36"/><verse number="37" style="v" sid="LUK 23:37"/>“አት ዮ ሞቲ ይሁዶታ ታቴ ሜ ኦፍ ኦልች” ጄዸን።<verse eid="LUK 23:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 23:38"/>ከተቢን፣</para>
  <para style="pc" vid="LUK 23:38">ኩን ሞትቸ ይሁዶታት</para>
  <para style="m" vid="LUK 23:38">ጄዹ ቶኮስ መታሳቲ ኦል ቱሬ።<verse eid="LUK 23:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 23:39"/>የክቶተ አችት ፈንፈመን ኬሳ ቶኮ፣ “አት ክርስቶስ ምቲ? ሜ ኦፍ ኦልች፤ ኑሌ ኦልች!” ጄዼ እሰ አረብሴ።<verse eid="LUK 23:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 23:40"/>የክቱን ካን ገሩ አከነ ጄዼ እሰ እፈቴ፤ “አትስ ዋን ሙርቲ ወል ፈካቱ ጀለ ጅርቱፍ፣ ዋቀሌ ህንሶዳቱ? <verse eid="LUK 23:40"/><verse number="41" style="v" sid="LUK 23:41"/>ኑ አደቢ ስሪ አደበማ ጅረ፤ ገቲ ሆጂኬኛፍ መሉ አርገቻ ጅራቲ። ነምች ኩን ገሩ የከ ቶኮሌ ህንሆጄትኔ።”<verse eid="LUK 23:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 23:42"/>ዬሱሲንስ፣ “ያ ዬሱስ፣ ዬሮ ሞቱማኬቲን ዹፍቱት ነ ያደዹ” ጄዼ።<verse eid="LUK 23:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 23:43"/>ዬሱስስ ዴብሴ፣ <char style="wj">“አን ዹጉመን ስት ህመ፤ አት ሀርአ ነ ወጅን ጀነተት ንገልተ”</char> ጄዼን።<verse eid="LUK 23:43"/></para>
  <para style="s1">ዱኡ ዬሱስ</para>
  <para style="r">
    <ref loc="LUK 23:44-49">23፥44‑49</ref> ኩወፈ – <char style="xt"><ref loc="MAT 27:45-56">ማቴ 27፥45‑56</ref>፤ <ref loc="MRK 15:33-41">ማር 15፥33‑41</ref></char></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 23:44"/>ዬሮን ሱን ገረ ሰኣቲ ጀኣ ቱሬ፤ ሀመ ሰኣቲ ሰገሊት ዱከን ለፈ ሁንደረ ቡኤ፤ <verse eid="LUK 23:44"/><verse number="45" style="v" sid="LUK 23:45"/>አዱን እፈ ዾወቴቲ። ጎልጋን መነ ቁልቁሉማስ እዶ ለመት ንተርሰኤ። <verse eid="LUK 23:45"/><verse number="46" style="v" sid="LUK 23:46"/>ዬሱስስ ሰገሌ ጉዳዻን እዬ፣ <char style="wj">“ያ አባ፣ አን ሀፉረኮ ደበርሴ ሀርከኬትን ኬነዸ”</char> ጄዼ። ከነ ጄዼስ ሀፉረ ዹማ ባፈቴ።<verse eid="LUK 23:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 23:47"/>አጀጃን ዽባ ሱንስ ዮሙ ዋን ተኤ ሰነ አርጌት ዋቃፍ ኡልፍነ ኬኔ፣ “ዹጉማኑ ነምች ኩን ነመ ቀጄላ ቱሬ” ጄዼ። <verse eid="LUK 23:47"/><verse number="48" style="v" sid="LUK 23:48"/>ነሞትን ዋን ከነ እላሉፍ እዶ ሰነት ወልት ቀበመን ሁንድ ዮሙ ዋን ተኤ ሰነ አርገንት ቆመሳኒ ሩሩኩታ አቺ ዴመን። <verse eid="LUK 23:48"/><verse number="49" style="v" sid="LUK 23:49"/>ወር እሰ ቤከን ሁንድ፣ ዱበርቶትን ገሊላዻ እሰ ዱካ ቡአንስ ፈጎ ዻበተኒ ዋን ከነ እላላ ቱረን።<verse eid="LUK 23:49"/></para>
  <para style="s1">አዋለሙ ዬሱስ</para>
  <para style="r">
    <ref loc="LUK 23:50-56">23፥50‑56</ref> ኩወፈ – <char style="xt"><ref loc="MAT 27:57-61">ማቴ 27፥57‑61</ref>፤ <ref loc="MRK 15:42-47">ማር 15፥42‑47</ref>፤ <ref loc="JHN 19:38-42">ዮሀ 19፥38‑42</ref></char></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 23:50"/>ኩኖ ነምቸ ምሴንሰ ወልዳ ይሁዶታ ከን ዮሴፍ ጄዸሙ ቶኮቱ ቱሬ፤ እን ነመ ጋሪፊ ቀጄላ ቱሬ፤ <verse eid="LUK 23:50"/><verse number="51" style="v" sid="LUK 23:51"/>እንስ ሙርቲፊ ሆጂሳኒረት ጀራን ወሊ ህንገሌ። ዮሴፍ መጋላ ይሁዳ ከን አርማትያስ ጄዸምቱ ዹፌ፤ እንስ ሞቱማ ዋቃ ኤገቻ ቱሬ። <verse eid="LUK 23:51"/><verse number="52" style="v" sid="LUK 23:52"/>ነምች ኩን ገረ ጲላጦስ ዸቄ ሬፈ ዬሱስ ከዸቴ። <verse eid="LUK 23:52"/><verse number="53" style="v" sid="LUK 23:53"/>ሬፈ ሰነስ ገድ ቡሴ ሁጩ ቁንጬ ተልባራ ሆጄተሜን ከፈኔ አዋለ ገራ ከታ ኬሰት ቆተሜ ከን ነምን ቶኮዩ ዱራን እት ህንአዋለምን ቶኮ ኬሰ ካኤ። <verse eid="LUK 23:53"/><verse number="54" style="v" sid="LUK 23:54"/>ጉያን ሱን ጉያ ቆጲ ቱሬ፤ ሰንበትንስ ሴኑ ገኤረ።<verse eid="LUK 23:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 23:55"/>ዱበርቶትን ዬሱስ ወጅን ገሊላዻ ዹፈንስ ዮሴፍ ዱካ ቡአኒ አዋለ ሰናፊ አከ እት ሬፍ ዬሱስ አዋለ ኬሰ ካአሜ አርገን። <verse eid="LUK 23:55"/><verse number="56" style="v" sid="LUK 23:56"/>አቺ ዴብአኒስ ቀያፊ ኡርጎፍቱ ቆጴሰን። ጉያ ሰንበታ ገሩ ሴራፍ አጀጀሙፍ ጄዸኒ ቦቆተን።<verse eid="LUK 23:56"/></para>
  <chapter eid="LUK 23"/>
  <chapter number="24" style="c" sid="LUK 24"/>
  <para style="s1">ዬሱስ ዱኣ ከኡሳ</para>
  <para style="r">
    <ref loc="LUK 24:1-10">24፥1‑10</ref> ኩወፈ – <char style="xt"><ref loc="MAT 28:1-8">ማቴ 28፥1‑8</ref>፤ <ref loc="MRK 16:1-8">ማር 16፥1‑8</ref>፤ <ref loc="JHN 20:1-8">ዮሀ 20፥1‑8</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 24:1"/>ጉያ ጀልቀበ ቶርበን ሰና ገነመ በሪ፣ ዱበርቶትን ሱን ኡርጎፍቱ ቆጴሰን ሰነ ፉዸተኒ ገረ አዋላ ዸቀን። <verse eid="LUK 24:1"/><verse number="2" style="v" sid="LUK 24:2"/>እሳንስ ዸጋ ሰነ በልበለ አዋላራ ገረ ገልፈሜ አርገን፤ <verse eid="LUK 24:2"/><verse number="3" style="v" sid="LUK 24:3"/>ዮሙ ሴነንት ገሩ ሬፈ ጎፍታ ዬሱስ ህንአርገትኔ። <verse eid="LUK 24:3"/><verse number="4" style="v" sid="LUK 24:4"/>ኡቱመ እሳን ዋኤ ከና ድንቅሲፈቻ ጅረኑ፣ ነሞትን ኡፈተ ጨጨለቅሳ ኡፈተን ለመ እሳን ብረ ዸዻበተን። <verse eid="LUK 24:4"/><verse number="5" style="v" sid="LUK 24:5"/>ዱበርቶትን ሱንስ ሶዳተኒ መታ ቡሰኒ ለፈ እላለን፤ ነሞትን ሱን ገሩ አከነ እሳኒን ጄዸን፤ “እስን ማሊፍ ወረ ዱአን ኬሰ እሰ ጅራታ በርባዱ? <verse eid="LUK 24:5"/><verse number="6" style="v" sid="LUK 24:6"/>እን አስ ህንጅሩ፤ ከኤረ! ዋን እን ዬሮ እስን ወጅን ገሊላ ቱሬት እስንት ህሜ ሰነ ያደዻ። <verse eid="LUK 24:6"/><verse number="7" style="v" sid="LUK 24:7"/><char style="wj">‘እልም ነማ ደበርፈሜ ሀርከ ጩበሞታት ንኬነመ፤ ንፈንፈመ፤ ጉያ ሰደፋትሞ ንካፈመ’</char> ጄዼ ቱሬቲ።” <verse eid="LUK 24:7"/><verse number="8" style="v" sid="LUK 24:8"/>ዱበርቶትንስ ዱቢሳ ያደተን።<verse eid="LUK 24:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 24:9"/>እሳንስ ዮሙ እዶ አዋላቲ ዴብአንት ዋን ከነ ሁንደ በረቶተ ኩዸ ቶኮቲፊ ነሞተ ሀፈን ሁንደት ህመን። <verse eid="LUK 24:9"/><verse number="10" style="v" sid="LUK 24:10"/>ወር ዋን ከነ ኤርገሞተት ህመንስ ማርያም እሼ መግደላ፣ ዮሃና፣ ማርያም ሃዸ ያቆቢፊ ዱበርቶተ ብራ ወረ እሳን ወጅን ቱረኒዸ። <verse eid="LUK 24:10"/><verse number="11" style="v" sid="LUK 24:11"/>እሳን ገሩ ሰበቢ ዱብች ኦዱ ሶባ እት ፈካቴፍ ዱበርቶተ ሰነ ህንአመኔ። <verse eid="LUK 24:11"/><verse number="12" style="v" sid="LUK 24:12"/>ተኡስ ጴጥሮስ ከኤ ገረ አዋለ ሰናት ፊጌ። ዮሙ ገድ ጄዼ እላሌትስ ሁጩ ቁንጬ ተልባራ ሆጄተሜ ቆፈ አርጌ፤ እንስ ዋን አርጌ ሰነ ድንቅፈቻ ዴብኤ።<verse eid="LUK 24:12"/></para>
  <para style="s1">ከራ ገረ ኤማሁስ ጌሱረት</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 24:13"/>ጉዩመ ሰነ እሳን ኬሳ ነሞትን ለመ ገንደ ኤማሁስ ጄዸሙ ዸቃ ቱረን፤ ኤማሁስስ ዬሩሳሌምራ ገረ ኪሎ ሜትረ ኩዸ ቶኮ ፈጋተ። <verse eid="LUK 24:13"/><verse number="14" style="v" sid="LUK 24:14"/>እሳንስ ዋኤ ዋን ተኤ ሰነ ሁንዳ ወልት ዱዱበቻ ቱረን። <verse eid="LUK 24:14"/><verse number="15" style="v" sid="LUK 24:15"/>ኡቱመ እሳን ወልት ዱዱበቻፊ ወጅን ሃሰኣ ጅረኑስ ዬሱስ መታንሳ እት ዽኣቴ እሳን ወጅን ዴሙ ጀልቀቤ። <verse eid="LUK 24:15"/><verse number="16" style="v" sid="LUK 24:16"/>ገሩ አከ እሳን እሰ ህንሁበትኔፍ እጅሳኒ ቀበሜ ቱሬ።<verse eid="LUK 24:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 24:17"/>እንስ፣ <char style="wj">“ወን እስን ዱዱበቻ ዴምተን ኩን ማል?”</char> ጄዼ እሳን ጋፈቴ።</para>
  <para style="p" vid="LUK 24:17">እሳንስ ገደኒ አቹመ ዸዻበተን። <verse eid="LUK 24:17"/><verse number="18" style="v" sid="LUK 24:18"/>እሳን ኬሳ ነምች ቀለዮጳ ጄዸሙ ቶኮሞ ዴብሴ፣ “ዋን ግዱ ከነ አችት ተኤ ከን ህንቤክኔ አት ዬሩሳሌሚፍ ኬሱማዻ?” ጄዼን።<verse eid="LUK 24:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 24:19"/>እንስ፣ <char style="wj">“ማል ፋቱ ተኤ?”</char> ጄዼ ጋፈቴ።</para>
  <para style="p" vid="LUK 24:19">እሳንስ ዴብሰኒ አከነ ጄዸን፣ “ዋኤ ዬሱስ ነመ ናዝሬት፤ እን ራጂ ቱሬ፤ ፉለ ዋቃቲፊ ፉለ ነመ ሁንዳ ዱረትስ ዱቢፊ ሆጂዻን ጀባ ቱሬ። <verse eid="LUK 24:19"/><verse number="20" style="v" sid="LUK 24:20"/>ሉቦትን ሀንገፎትኒፊ ቡልችቶትንኬኘ አከ ዱት እት ሙረሙፍ ደበርሰኒ እሰ ኬነን፤ እሰ ፈንሰንስ። <verse eid="LUK 24:20"/><verse number="21" style="v" sid="LUK 24:21"/>ኑ ገሩ ነምን እስራኤልን ፉሩ እሰ ጄኔ አብደትኔ ቱሬ። ከነረትሞ ኤርገ ወን ኩን ሁንድ ተኤ ሀርአ ጉያ ሰደፋዸ። <verse eid="LUK 24:21"/><verse number="22" style="v" sid="LUK 24:22"/>አከሱመስ ዱበርቶተኬኘ ኬሳ ቶኮ ቶኮ ኑ ድንቅሲሰኒሩ፤ እሳንስ በሪ በራቃን ገረ አዋለ ሰና ዸቀኒ፣ <verse eid="LUK 24:22"/><verse number="23" style="v" sid="LUK 24:23"/>ሬፈሳ አቺ ዸበን። ዱበርቶትን ሱንስ ዴብአኒ አከ ኤርገሞትን እሳንት ሙልአተኒ፣ ዬሱስ ጅራታ ተኡሳ እሳንት ህመን ኑት ኦዴሰን። <verse eid="LUK 24:23"/><verse number="24" style="v" sid="LUK 24:24"/>ወረ ኑ ወጅን ቱረን ኬሳስ ነሞትን ቶኮ ቶኮ ገረ አዋላ ዸቀኒ አከ ወን ሱን አኩመ ዱበርቶትን ኑት ኦዴሰን ሰነ ተኤ አርገን፤ እሰ ገሩ ህንአርግኔ።”<verse eid="LUK 24:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 24:25"/>እንስ አከነ እሳኒን ጄዼ፤ <char style="wj">“እስን ያ ወረ ህንሁበትኔፊ ወረ ዋን ራጆትን ዱበተን ሁንደ አመኑትስ መታ ጀባተን!</char> <verse eid="LUK 24:25"/><verse number="26" style="v" sid="LUK 24:26"/><char style="wj">ክርስቶስ</char><note caller="+" style="f"><char style="fr" closed="false">24፥26 </char><char style="ft" closed="false">ዮካን </char><char style="fqa" closed="false">መሲህች</char></note> <char style="wj">ዋን ከነ ሁንዳን ዽጰቴ ኤርገሲሞ ኡልፍነሳት ገሉ ህንቀቡ ቱሬ?”</char> <verse eid="LUK 24:26"/><verse number="27" style="v" sid="LUK 24:27"/>እንስ ሙሴፊ ራጆተ ሁንደራ ጀልቀቤ ዋን ከተቢወን ቁልቁሉ ሁንደ ኬሰት ዋኤሳ ዱበተሜ እሳኒፍ እብሴ።<verse eid="LUK 24:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 24:28"/>ዮሙ ገንደ ዸቃ ቱረን ሰነት ዽኣተንትስ ዬሱስ ዋን ደርቤ ዴሙ ኦፍ ፈኬሴ። <verse eid="LUK 24:28"/><verse number="29" style="v" sid="LUK 24:29"/>እሳን ገሩ፣ “ሰበቢ ለፍት ገልገላኡ ገኤፊ ዱከናኣ ጅሩፍ፣ ኑ ብረ ቡል” ጄዸኒ ጀቤሰኒ እሰ ከዸተን። እንስ እሳን ብረ ቡሉፍ ጎሬ።<verse eid="LUK 24:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 24:30"/>እንስ ዮሙ እሳን ወጅን ማዲት ዽኣቴት ቡዴነ ፉዼ፣ ኤብሴ፣ ጨጨብሴስ እሳኒፍ ኬኔ። <verse eid="LUK 24:30"/><verse number="31" style="v" sid="LUK 24:31"/>እጅሳኒ ንበነሜ፤ እሰስ ንቤከን፤ እንስ እጀሳኒ ዱራ ዾከቴ። <verse eid="LUK 24:31"/><verse number="32" style="v" sid="LUK 24:32"/>እሳንስ፣ “ዬሮ እን ከራት ኑ ወጅን ዱበቻ ቱሬፊ ዬሮ እን ከተቢወን ቁልቁሉ ኑ እብሳ ቱሬ ሰነ፣ ገራንኬኘ ኑ ኬሰት ቦበኣ ህንቱሬ?” ጄዸኒ ወል ጋፈተን።<verse eid="LUK 24:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 24:33"/>ዬሩመ ሰነስ ከአኒ ዬሩሳሌምት ዴብአን፤ አችትሞ በረቶተ ኩዸ ቶኮፊ ነሞተ እሳን ወጅን ቱረን ሰነ ወልት ቀበመኒ አርገን። <verse eid="LUK 24:33"/><verse number="34" style="v" sid="LUK 24:34"/>ወር ወልት ቀበመን ሱንስ፣ “ዹጉማን ጎፍታን ዱኣ ከኤረ፤ ስሞንትስ ሙልአቴረ” ጄቻ ቱረን። <verse eid="LUK 24:34"/><verse number="35" style="v" sid="LUK 24:35"/>ነሞትን ለማን ሱንስ ዋን ከራረት ተኤ ሁንዱማፊ ዬሮ ዬሱስ ቡዴነ ጨጨብሴ ሰነ አከምት አከ እሰ ቤከን ኦዴሰን።<verse eid="LUK 24:35"/></para>
  <para style="s1">ዬሱስ በረቶተት ሙልአቹሳ</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 24:36"/>ኡቱ እሳን ዋን ከነ ዱዱበቻ ጅረኑ፣ ዬሱስ መታንሳ እሳን ግዱ ዻበቴ፣ <char style="wj">“ነጋን እስኒፍ ሃተኡ”</char> ጄዼን።<verse eid="LUK 24:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 24:37"/>እሳን ገሩ ዋን ኤኬራ አርገን ሴአኒ ነአን፤ ንሶዳተንስ። <verse eid="LUK 24:37"/><verse number="38" style="v" sid="LUK 24:38"/>እንስ አከነ እሳኒን ጄዼ፤ <char style="wj">“ማሊፍ ሶዳቱ? መሚንስ ማሊፍ ገራኬሰን ኬሰት ኡመመ?</char> <verse eid="LUK 24:38"/><verse number="39" style="v" sid="LUK 24:39"/><char style="wj">አከ አኑመ መታኮ ተኤ ሜ ሀርከኮፊ ሚለኮ እላላ! ቀቀበዻቲ ነ እላላ፤ ኤኬራን ፎኒፊ ለፌ ህንቀቡ፤ አን ገሩ አኩመ እስን አርግተን ከነ ፎኒፊ ለፌ ቀበ።”</char><verse eid="LUK 24:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 24:40"/>እንስ ዋን ከነ ዱበቴ ሀርከሳቲፊ ሚለሳ እሳንት አርግሲሴ። <verse eid="LUK 24:40"/><verse number="41" style="v" sid="LUK 24:41"/>ኡቱመ እሳን ሰበቢ ገመቹቲፊ ሰበቢ ድንቅፈትናቲፍ አመሌ ህንአመንን፣ <char style="wj">“እስን ዋን ኛተሙ አሲ ቀብዱ?”</char> ጄዼ እሳን ጋፈቴ። <verse eid="LUK 24:41"/><verse number="42" style="v" sid="LUK 24:42"/>እሳንስ ቁርጡሚ ዋደሜ ኬነኒፍ፤ <verse eid="LUK 24:42"/><verse number="43" style="v" sid="LUK 24:43"/>እንስ ፉዸቴ ፉሉመሳኒ ዱረት ኛቴ።<verse eid="LUK 24:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 24:44"/>እንስ፣ <char style="wj">“ዬሮ አን እስን ብረ ቱሬት፣ ‘ወን ሴረ ሙሴ ኬሰት፣ ክታቦተ ራጆታቲፊ ክታበ ፋርፈትና ኬሰት ዋኤኮ በሬፈሜ ሁንድ ራወተሙ ቀበ’ ጄዼ እስንት ህሜ ሱን እሰ ከነ”</char> ጄዼን።<verse eid="LUK 24:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 24:45"/>እንስ አከ እሳን ከተቢወን ቁልቁሉ ሁበተኒፍ ቀልቢሳኒ በኔፍ። <verse eid="LUK 24:45"/><verse number="46" style="v" sid="LUK 24:46"/>አከነስ እሳኒን ጄዼ፤ <char style="wj">“ወን በሬፈሜ አከነ ጄዸ፤ ‘ክርስቶስ ንዽጰተ፤ ጉያ ሰደፋትሞ ወረ ዱአን ኬሳ ንከአ፤</char> <verse eid="LUK 24:46"/><verse number="47" style="v" sid="LUK 24:47"/><char style="wj">መቃሳቲንስ ቀልቢ ጅጂረቹኒፊ ዺፈምን ጩቡ ዬሩሳሌሚ ጀልቀቤ ሰበ ሁንደት ንለለበመ።’</char> <verse eid="LUK 24:47"/><verse number="48" style="v" sid="LUK 24:48"/><char style="wj">እስንስ ዹገ ባቶተ ዋን ከናት።</char> <verse eid="LUK 24:48"/><verse number="49" style="v" sid="LUK 24:49"/><char style="wj">ኩኖ አን ዋን አባንኮ ዋዳ እስኒ ገሌ ሰነ እስኒፍ ነንኤርገ፤ እስን ገሩ ሀመ ኦሊ ሁምነ ኡፈተንት መጋላ ዬሩሳሌም ኬሰ ቱራ።”</char><verse eid="LUK 24:49"/></para>
  <para style="s1">ዬሱስ ሰሚት ኦል በኤ</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 24:50"/>እንስ አቺ ባሴ ሀመ ቢታንያት እሳን ጌሴ፤ ሀርከሳ ለማንስ ኦል ካፈቴ እሳን ኤብሴ። <verse eid="LUK 24:50"/><verse number="51" style="v" sid="LUK 24:51"/>ኡቱመ እሳን ኤብሳ ጅሩስ እሳን ዺሴ ሰሚት ኦል ፉዸተሜ። <verse eid="LUK 24:51"/><verse number="52" style="v" sid="LUK 24:52"/>እሳንስ እሳፍ ሰገደኒ ገመቹ ጉዳዻን ዬሩሳሌምት ዴብአን። <verse eid="LUK 24:52"/><verse number="53" style="v" sid="LUK 24:53"/>ዬሮ ሁንደስ መነ ቁልቁሉማ ኬሰት ዋቀ ገለቴፈቻ ቱረን።<verse eid="LUK 24:53"/></para>
  <chapter eid="LUK 24"/>
</usx>
