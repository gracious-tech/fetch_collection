<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2TH" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">2 ተሰሎኒቄ</para>
  <para style="toc1">ተሰሎኒቄ ለመፋ</para>
  <para style="toc2">2 ተሰሎኒቄ</para>
  <para style="toc3">2ተሰ</para>
  <para style="mt1">ተሰሎኒቄ</para>
  <para style="mt2">ለመፋ</para>
  <chapter number="1" style="c" sid="2TH 1"/>
  <para style="s1">ነጋ ጋፈቹ</para>
  <para style="po">
    <verse number="1" style="v" sid="2TH 1:1"/>ጳዉሎስ፣ ስልዋኖሲፊ ጢሞቴዎስራ።</para>
  <para style="po" vid="2TH 1:1">ገረ ወልዳ ክርስታና ወረ ተሰሎኒቄ ከን አባኬኘ ዋቃቲፊ ከን ጎፍታ ዬሱስ ክርስቶስ ታቴት።<verse eid="2TH 1:1"/></para>
  <para style="po">
    <verse number="2" style="v" sid="2TH 1:2"/>አያኒፊ ነጋን ዋቀ አባፊ ጎፍታ ዬሱስ ክርስቶስራ እስኒፍ ሃተኡ።<verse eid="2TH 1:2"/></para>
  <para style="s1">ገለታፊ ከዸትና</para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 1:3"/>ያ ኦቦሎተ፣ ሰበቢ አመንቲንኬሰን ባይኤ ጉደቻ፣ ጃለል ሁንድኬሰን ወሊኬሰኒፍ ቀብደንስ እቱመ ደበላ ጅሩፍ ኑ ዬሮ ሁንደ ዋኤኬሰኒፍ አከ መሉት ዋቀ ገለቴፈቹ ቀብነ። <verse eid="2TH 1:3"/><verse number="4" style="v" sid="2TH 1:4"/>ከናፉ ኑ ቆሩምሰ እስን ኦብስተን ሰናፍ፣ አርአተመ ሁንደ ኬሰት ጀባተኒ ዻበቹኬሰኒፊ አመንቲኬሰኒን ወልዶተ ክርስታና ዋቃ ኬሰት ሰበቢኬሰኒን ኦፍ ጀጅነ።<verse eid="2TH 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 1:5"/>ኩን ሁንድኑ አከ ሙርቲን ዋቃ ቀጄላ ተኤ ሙልእሰ፤ ሰበቢ ከናፍስ እስን ወረ ሞቱማሳ ከን ዽጰቻፊ ጅርተን ሰናፍ መልተን ንታቱ። <verse eid="2TH 1:5"/><verse number="6" style="v" sid="2TH 1:6"/>ዋቅን ቀጄላዸ፦ እን ወረ እስን ረክሰን ንረክሰ፤ <verse eid="2TH 1:6"/><verse number="7" style="v" sid="2TH 1:7"/>እስን ወረ ረከተኒፍ፣ ኑፍስ ቦቆና ንኬነ። ኩንስ ዮሙ ጎፍታን ዬሱስ እብደ በለልኡን ኤርገሞተሳ ሁምነ ቀቤዪ ወጅን ሰሚራ ሙልአቱት ተአ። <verse eid="2TH 1:7"/><verse number="8" style="v" sid="2TH 1:8"/>እን ወረ ዋቀ ህንቤክኔፊ ወረ ወንጌለ ጎፍታኬኘ ዬሱሲፍ ህንአጀጀምኔ ንአደበ። <verse eid="2TH 1:8"/><verse number="9" style="v" sid="2TH 1:9"/>እሳንስ ፉለ ጎፍታ ዱራፊ ኡልፍነ ሁምነሳራ ፈጌፈመኒ በዲሰ በረ በራቲን ንአደበሙ፤ <verse eid="2TH 1:9"/><verse number="10" style="v" sid="2TH 1:10"/>ኩንስ ጉያ እን ቁልቁሎተሳቲን ከበጀሙፊ ወረ አመነን ሁንዱማ ግዱት ድንቅሲፈተሙፍ ዹፉት ተአ። እስንስ ዋን ዹገ በኡምሰኬኘ አመንተኒፍ እሳንት ለካአምቱ።<verse eid="2TH 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 1:11"/>ኑስ ዋን ከነ ያደት ቀበቻ፣ አከ ዋቅንኬኘ ወረ ዋምቸሳቲፍ መለን እስን ጎዹፍ፣ ሁምነሳቲንስ ካዮኬሰን ጋሪ ሁንዳፊ አከ ሆጂ አመንቲኬሰኒ ሁንደ ፊጣን እስኒ ባሱፍ ኡቱ ገርገር ህንኩትን እስኒ ከዸትነ። <verse eid="2TH 1:11"/><verse number="12" style="v" sid="2TH 1:12"/>ኑስ አኩመ አያነ ዋቀኬኛቲፊ ጎፍታ ዬሱስ ክርስቶሲት አከ መቃን ጎፍታኬኘ ዬሱስ እስኒን ከበጀሙፊ አከ እስንስ እሳን ከበጀምተኒፍ ዋን ከነ ከዸትነ።<verse eid="2TH 1:12"/></para>
  <chapter eid="2TH 1"/>
  <chapter number="2" style="c" sid="2TH 2"/>
  <para style="s1">ነመ ፍንጭላ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 2:1"/>ያ ኦቦሎተ፣ ዋኤ ዹፋቲ ጎፍታኬኘ ዬሱስ ክርስቶሲፊ ዋኤ እሰ ብረት ወልት ቀበሙኬኛ ወን ኑ እስን ከዸትኑ ከነ፤ <verse eid="2TH 2:1"/><verse number="2" style="v" sid="2TH 2:2"/>ኩንስ ራጂ ዮካን ዱቢ ዮካን ጠለያ አከ ዋን ኑ ብራ ዹፌት ሄደሙን አከ እስን ጉያን ጎፍታ አሙመዩ ዹፌረ ጄተኒ ደፍተኒ ህንራፈምኔፍ ዮካን ህንጄቀምኔፍ። <verse eid="2TH 2:2"/><verse number="3" style="v" sid="2TH 2:3"/>ነምን ቶኮዩ ከራ ከሚንዩ እስን ህንጎዎምስን፤ ኡቱ ፍንጭል ዱርሴ ህንዹፍን፣ ነምን ጩቡ፣ እልም በዲሳ ሱን ኡቱ ህንሙልአትን ጉያን ሱን ህንዹፉቲ። <verse eid="2TH 2:3"/><verse number="4" style="v" sid="2TH 2:4"/>እንስ ዋን ዋቀ ጄዸሙ ዮካን ዋን ዋቄፈተሙ ሁንዱማን ሞርሜ እሳንረት ኦል ኦል ኦፍ ቀበ፤ “አን ዋቀ” ኦፊን ጄቹዻንስ መነ ቁልቁሉማ ዋቃ ኬሰ ታአ።<verse eid="2TH 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 2:5"/>እስን አከ አን ዬሮ እስን ብረ ቱሬት ዋን ከነ እስንት ህማ ቱሬ ህንያደተኒ? <verse eid="2TH 2:5"/><verse number="6" style="v" sid="2TH 2:6"/>አከ እን ዬሮ ሙርቴፈሜ ሰነት ሙልአቱፍስ ዋን አመ እሰ ዾዉ ንቤክቱ። <verse eid="2TH 2:6"/><verse number="7" style="v" sid="2TH 2:7"/>እጪቲን ሁምነ ፍንጭለ ሰና አመዩ ሆጂት ጅራቲ፤ ገሩ እን አመ ሁምነ ሰነ ዱበት ዴብሱ ሱን ሀመ ከራራ ፉዸሙት እቱመ ፉፌ እሰ ዾወ። <verse eid="2TH 2:7"/><verse number="8" style="v" sid="2TH 2:8"/>እን ሀማን ሱን ንሙልአተ፤ ዬሱስ ጎፍታንሞ ሀፉሩመ አፋን ኦፊሳቲን እሰ ገላፈተ፤ እፈ ዹፋቲሳቲንስ እሰ በርበዴሰ። <verse eid="2TH 2:8"/><verse number="9" style="v" sid="2TH 2:9"/>ዹፋቲን ነምቸ እሰ ሀማ ሰና አኩመ ሆጂ ሴጠናት ሁምነ ሁንዳፊ መለቶን፣ ድንቂ ሶባቲንስ ንተአ፤ <verse eid="2TH 2:9"/><verse number="10" style="v" sid="2TH 2:10"/>እንስ ጎዎምሳ ጎሰ ሁንዳ ከን ወረ በደን ሰነ እቲን ጎዎምሱን ሙልአተ። ወር በደን ሱንስ ሰበቢ ዹጋ ስላ እቲን ፈየን ሰነ ጃለቹ ድደኒፍ በዱ። <verse eid="2TH 2:10"/><verse number="11" style="v" sid="2TH 2:11"/>ከናፉ ዋቅን አከ እሳን ሶበ አመነኒፍ ዋን ነመ ወላልችሱ እሳንት ኤርገ፤ <verse eid="2TH 2:11"/><verse number="12" style="v" sid="2TH 2:12"/>ኩንስ አከ ወረ ዹጋት አመኑ ድደኒ ጀልእነት ገመደን ሁንደት ሙርታኡፍ።<verse eid="2TH 2:12"/></para>
  <para style="s1">ጀባዻቲ ዻበዻ</para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 2:13"/>ኑ ገሩ ያ ኦቦሎተ ጎፍታን ጃለተምተን፣ ሰበቢ ዋቅን ወረ ጀልቀባ ጎዼ አከ እስን ከራ ሀፉራን ቁልቁሌፈሙቲፊ ከራ ዹጋት አመኑቲን ፈይተኒፍ እስን ፍለቴፍ ዬሮ ሁንደ ዋቀ ገለቴፈቹ ቀብነ። <verse eid="2TH 2:13"/><verse number="14" style="v" sid="2TH 2:14"/>እንስ አከ እስን ኡልፍነ ጎፍታኬኘ ዬሱስ ክርስቶስ ኬሰት ህርማተኒፍ ከራ ወንጌለኬኛቲን ካዮ ከናፍ እስን ዋሜ።<verse eid="2TH 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2TH 2:15"/>ኤጋ ያ ኦቦሎተ፣ ጀባዻቲ ዻበዻ፤ በርሲሰ ኑ ከራ ዱቢ አፋኒቲን ዮካን ጠለያን እስን በርሲፍኔ ሰነ ጀቤሳቲ ቀበዻ።<verse eid="2TH 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 2:16"/>ጎፍታንኬኘ ዬሱስ ክርስቶስ መታንሳ፣ ዋቅን አባንኬኘ እን ኑ ጃለቴ ከራ አያነሳቲን ጀጀብነ በረ በራቲፊ አብዲ ጋሪ ኑ ኬኔ ሱን፣ <verse eid="2TH 2:16"/><verse number="17" style="v" sid="2TH 2:17"/>ሆጂፊ ዱቢ ጋሪ ሁንደ ኬሰት ገራኬሰን ሃጀጀቤሱ፤ እስን ሃጭምሱስ።<verse eid="2TH 2:17"/></para>
  <chapter eid="2TH 2"/>
  <chapter number="3" style="c" sid="2TH 3"/>
  <para style="s1">ኑፍ ከዸዻ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 3:1"/>ኤጋ ያ ኦቦሎተ፣ አከ ዱቢን ጎፍታ አኩመ እስን ብረት ተኤ ሰነ ደፌ እዶ ሁንደ ገኡፊ አከ ኡልፍነስ ቀባቱ ኑፍ ከዸዻ። <verse eid="2TH 3:1"/><verse number="2" style="v" sid="2TH 3:2"/>አከ ኑ ሀርከ ነሞተ ሀሞቲፊ ጀልኦታ ጀላ ባኑፍስ ኑፍ ከዸዻ፤ አመንቲ ከን ቀቡ ነመ ሁንደ ምቲ። <verse eid="2TH 3:2"/><verse number="3" style="v" sid="2TH 3:3"/>ጎፍታን ገሩ አመነማዸ፤ እን እስን ጭምሰ፤ እሰ ሀማራስ እስን ኤገ። <verse eid="2TH 3:3"/><verse number="4" style="v" sid="2TH 3:4"/>ኑ አከ እስን ዋን ኑ እስን አጀጅኔ ሰነ ሆጄቻ ጅርተን፣ አከ እቱመ ፉፍተኒስ ሆጄተን ጎፍታ ንአመነትነ። <verse eid="2TH 3:4"/><verse number="5" style="v" sid="2TH 3:5"/>ጎፍታን ገራኬሰን ገረ ጃለለ ዋቃቲፊ ገረ ኦብሰ ክርስቶስት ሃቀጄልቹ።<verse eid="2TH 3:5"/></para>
  <para style="s1">ድርቀመ ሆጂ ሆጄቹ</para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 3:6"/>ያ ኦቦሎተ፣ እስን ኦቦሌሰ ዽባኣፊ ከን አከ በርቴ እስን ኑራ አርገተን ሰናትስ ህንጅራትኔ ሁንደራ አከ ፈጋተኒፍ መቃ ጎፍታኬኘ ዬሱስ ክርስቶሲን እስን አጀጅነ። <verse eid="2TH 3:6"/><verse number="7" style="v" sid="2TH 3:7"/>እስን መታንኬሰን አከምት አከ ፈኬኘኬኘ ዱካ ቡኡ ቀብደን ንቤክቱቲ። ኑ ዬሮ እስን ብረ ቱሬት ዽባኦተ ህንቱሬ፤ <verse eid="2TH 3:7"/><verse number="8" style="v" sid="2TH 3:8"/>ኑስ አከ እስን ኬሳ ነመ ቶኮትሌ በኣ ህንታኔፍ ጄኔ፣ ደዸቢፊ ተታፊ ጉዳን ሀልከኒ ጉያ ሆጄቻ ቱሬ መሌ ቡዴነ ነመ ቶኮሌ ቶለ ህንኛትኔ። <verse eid="2TH 3:8"/><verse number="9" style="v" sid="2TH 3:9"/>ኑ ፈኬኘ እስኒ ተኡፍ ዋን ከነ ጎኔ መሌ ዋን ኣንጎ ህንቀብኔፍ ምት። <verse eid="2TH 3:9"/><verse number="10" style="v" sid="2TH 3:10"/>ኑ ዮሙ እስን ብረ ቱሬት አጀጀ፣ “ነምን ሆጄቹ ህንበርባድኔ ከምዩ ህንኛትን” ጄዹ እስኒ ኬንኔ ቱሬቲ።<verse eid="2TH 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 3:11"/>አከ እስን ኬሳ ነሞትን ቶኮ ቶኮ ዽባኦተ ተአኒ ጅራተን ዸጌኜራቲ። እሳን ዽመ ነመ ብራ ኬሰ ገሉ መሌ ኦፊሳኒቲ ዋን ቶኮሌ ህንሆጄተን። <verse eid="2TH 3:11"/><verse number="12" style="v" sid="2TH 3:12"/>ነሞትን አከና አከ ገብ ጄዸኒ ሆጂ ሆጄተኒፊ አከ ቡዴነ ኦፊሳኒ ኛተኒፍ ጎፍታ ዬሱስ ክርስቶሲን እሳን አጀጅነ፤ ንጎርስነስ። <verse eid="2TH 3:12"/><verse number="13" style="v" sid="2TH 3:13"/>እስን ገሩ ያ ኦቦሎተ፣ ዋን ጋሪ ሆጄቹት ህንላፍና።<verse eid="2TH 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2TH 3:14"/>ዮ ነምን ከምዩ ዱቢኬኘ ከን ጠለያ ከነ ኬሳቲፍ ህንአጀጀምኔ፣ ነመ ከነ ያደት ቀበዻ። አከ እን ቃነኡፍስ እሰ ወጅን ቶኩማ ህንቀባትና። <verse eid="2TH 3:14"/><verse number="15" style="v" sid="2TH 3:15"/>ተኡስ አከ ኦቦሌሳት እሰ ጎርሳ መሌ አከ ዲናት እሰ ህንእላልና።<verse eid="2TH 3:15"/></para>
  <para style="b"/>
  <para style="s1">ዻምሰ ነጋ ጡሙራ</para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 3:16"/>ጎፍታን ነጋ መታንሳስ ዬሮ ሁንደ፣ ከራ ሁንዳን ነጋ እስኒ ሃኬኑ። ጎፍታን ሁንዱመኬሰን ወጅን ሃተኡ።<verse eid="2TH 3:16"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="17" style="v" sid="2TH 3:17"/>አን ጳዉሎስ ጠለያ ከነ ሀርኩመኮቲን በሬሰ፤ ኩንስ መለቶ ጠለዮተኮ ሁንዳት። አክ አን እት በሬሱስ ከኑመ።<verse eid="2TH 3:17"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="18" style="v" sid="2TH 3:18"/>አያን ጎፍታኬኘ ዬሱስ ክርስቶስ እስን ሁንደ ወጅን ሃተኡ።<verse eid="2TH 3:18"/></para>
  <chapter eid="2TH 3"/>
</usx>
