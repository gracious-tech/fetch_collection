<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="NAM" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">ነሆም</para>
  <para style="toc1">ራጂ ነሆም</para>
  <para style="toc2">ነሆም</para>
  <para style="toc3">ናሆ</para>
  <para style="mt2">ራጂ</para>
  <para style="mt1">ናሆም</para>
  <chapter number="1" style="c" sid="NAM 1"/>
  <para style="p">
    <verse number="1" style="v" sid="NAM 1:1"/>ራጂ ዋኤ ነነዌ ዱበተሜ። ክታበ ሙልአተ ናሆም ኤልቆሽቸ።<verse eid="NAM 1:1"/></para>
  <para style="b"/>
  <para style="s1">ኣሪ <char style="nd">ዋቀዮ</char> ነነዌት ኣሬ</para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 1:2"/>
    <char style="nd">ዋቀዮ</char> ዋቀ ህናፉፊ ዋቀ ሃሎ በኡዸ፤</para>
  <para style="q2" vid="NAM 1:2">
    <char style="nd">ዋቀዮ</char> ሃሎ ንበአ፤ ዼከምሳንስ ጉተሜረ።</para>
  <para style="q1" vid="NAM 1:2">
    <char style="nd">ዋቀዮ</char> ዲኖተሳ ሃሎ ንበአ፤</para>
  <para style="q2" vid="NAM 1:2">ዼከምሰሳስ አመጃጆተሳቲፍ ንኩሰ።<verse eid="NAM 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 1:3"/>
    <char style="nd">ዋቀዮ</char> ዼከሙፍ ህንጀርጀሩ፤ ሁምንሳሞ ጉዳዸ፤</para>
  <para style="q2" vid="NAM 1:3">
    <char style="nd">ዋቀዮ</char> ነመ በሌሳ ቀቡ ኡቱ ህንአደብን ህንዺሱ።</para>
  <para style="q1" vid="NAM 1:3">ቡቤ ሀማፊ ዸኣ ገላና ኬሳስ ከራ ቀበ፤</para>
  <para style="q2" vid="NAM 1:3">ዱሜስሞ አዋረ ሚለሳት።<verse eid="NAM 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 1:4"/>እን ገላነት ዼከሜ ጎግሰ፤</para>
  <para style="q2" vid="NAM 1:4">አከ ለግን ሁንድኑ ጎጉ ጎዸ።</para>
  <para style="q1" vid="NAM 1:4">ባሻኒፊ ቀርሜሎስ ንጮለጉ፤</para>
  <para style="q2" vid="NAM 1:4">ደራራን ልባኖንስ ንሀርጨአ።<verse eid="NAM 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 1:5"/>ፉለሳ ዱረት ቱሉወን ንክርክሩ፤</para>
  <para style="q2" vid="NAM 1:5">ጋረንስ በቀኒ በዱ።</para>
  <para style="q1" vid="NAM 1:5">እዶ እን ጅሩት ለፍት ንሆለት፤</para>
  <para style="q2" vid="NAM 1:5">አዱኛፊ ወን አዱኛረ ጅራቱ ሁንድ ንሆለተ።<verse eid="NAM 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 1:6"/>ኤኙቱ ዼከምሰሳ ዱረ ዻበቹ ደንደአ?</para>
  <para style="q2" vid="NAM 1:6">ኤኙቱ ዼከምሰሳ ሶዳችሳ ሰነ ኦብሱ ደንደአ?</para>
  <para style="q1" vid="NAM 1:6">ዼከምስሳ አኩመ እብዳ ዸንገለአ፤</para>
  <para style="q2" vid="NAM 1:6">ፉለሳ ዱረት ከታወን ንቡርኩታኡ።<verse eid="NAM 1:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 1:7"/>
    <char style="nd">ዋቀዮ</char> ጋሪዸ፤</para>
  <para style="q2" vid="NAM 1:7">ዬሮ ረክናትስ ደኦዸ።</para>
  <para style="q1" vid="NAM 1:7">እን ወረ እሰ አመነተን ንቤከ፤<verse eid="NAM 1:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="NAM 1:8"/>ገሩ እን ሎላ ጀባዻን</para>
  <para style="q1" vid="NAM 1:8">ነነዌ ንበሌሰ፤</para>
  <para style="q2" vid="NAM 1:8">አመጃጆተሳስ አርኤ ዱከነት ገልቸ።<verse eid="NAM 1:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 1:9"/>ወን እስን <char style="nd">ዋቀዮት</char> ያደን ማል?</para>
  <para style="q2" vid="NAM 1:9">እን ጉቱማን ጉቱት ንበሌሰ፤</para>
  <para style="q2" vid="NAM 1:9">ረኮንስ ለመተ ህንዹፉ።<verse eid="NAM 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 1:10"/>እሳን ቆራቲ ኬሰት ጠጠመኒ</para>
  <para style="q2" vid="NAM 1:10">ዳዺ ወይኒሳቲን መቻኡ፤</para>
  <para style="q2" vid="NAM 1:10">አኩመ ጭዲ ጎጌት ጉበተኒ ዹሙ።<verse eid="NAM 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 1:11"/>ያ ነነዌ፣ ነምን <char style="nd">ዋቀዮት</char> ሀምነ መለቴ</para>
  <para style="q2" vid="NAM 1:11">ዋን ሀማ ከሮርፈቱ</para>
  <para style="q2" vid="NAM 1:11">ስ ኬሳ አርገሜረ።<verse eid="NAM 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NAM 1:12"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="NAM 1:12">“እሳን ጀብናፊ ባይእነ ዮ ቀባተንዩ</para>
  <para style="q2" vid="NAM 1:12">ንበርበዴፈሙ፤ ንበዱስ።</para>
  <para style="q1" vid="NAM 1:12">ያ ይሁዳ፣ አን ዮን ዱራን ስ ሚዼ ጅራዼዩ፣</para>
  <para style="q2" vid="NAM 1:12">ስአች ስ ህንሚዹ።<verse eid="NAM 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 1:13"/>አን አመ ዋንጆሳኒ ጉርሙኬሰንራ ነንጨብሰ፤</para>
  <para style="q2" vid="NAM 1:13">ሁዻኬስ ስራ ነንኩተ።”<verse eid="NAM 1:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="NAM 1:14"/>ያ ነነዌ፣ <char style="nd">ዋቀዮ</char> አከነ ጄዼ ዋኤኬ አጀጀ ኬኔ ጅረ፦</para>
  <para style="q2" vid="NAM 1:14">“አት ሰኚ መቃንኬ እቲን ዋመሙ ህንቀባቱ።</para>
  <para style="q1" vid="NAM 1:14">አን ፈኪወን ሶፈመኒፊ ዋቆተ ቶልፈሞ በቅፈመኒ ቶልፈመን</para>
  <para style="q2" vid="NAM 1:14">ከኔን ገልመወን ዋቆተኬቲ ኬሰ ጅረን ነንበርበዴሰ።</para>
  <para style="q1" vid="NAM 1:14">ዋን አት አከ መሌ በልፈማ ታቴፍ</para>
  <para style="q2" vid="NAM 1:14">አን አዋለ ሲፍ ነንቆጴሰ።”<verse eid="NAM 1:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="NAM 1:15"/>ኩኖ፣ ሚል ነመ ኦዱ ጋሪ ፍዱ፣</para>
  <para style="q2" vid="NAM 1:15">ከን ነጋ ለብሱ ቶኮ ቱሉወንረ ጅረ!</para>
  <para style="q1" vid="NAM 1:15">ያ ይሁዳ፣ አያኖተኬ አያኔፈዹ፤</para>
  <para style="q2" vid="NAM 1:15">ወሬገኬስ ባፈዹ።</para>
  <para style="q1" vid="NAM 1:15">ስአች ሀማን ስ ህንዌረሩ፤</para>
  <para style="q2" vid="NAM 1:15">እን ጉቱማን ጉቱት ንበርበዴፈመ።<verse eid="NAM 1:15"/></para>
  <chapter eid="NAM 1"/>
  <chapter number="2" style="c" sid="NAM 2"/>
  <para style="s1">ኩፋቲ ነነዌ</para>
  <para style="q1">
    <verse number="1" style="v" sid="NAM 2:1"/>ያ ነነዌ፣ ነምን ስ ሎሉ ስት ዹፌረ።</para>
  <para style="q2" vid="NAM 2:1">ደኦ ኤገዹ፤</para>
  <para style="q2" vid="NAM 2:1">ከራ እላለዹ።</para>
  <para style="q2" vid="NAM 2:1">ሙዺኬ ህዸዹ፤</para>
  <para style="q2" vid="NAM 2:1">ሁምነኬ ሁንደ ወልት ቀበዹ።<verse eid="NAM 2:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 2:2"/>ዮ በሌስቶትን እሳን ኦንሰኒ</para>
  <para style="q2" vid="NAM 2:2">ሙኬን ወይኒሳኒ በርበዴሰንዩ፣</para>
  <para style="q1" vid="NAM 2:2">
    <char style="nd">ዋቀዮ</char> አኩመ ኡልፍነ እስራኤል ዴብሴ ሰነ</para>
  <para style="q2" vid="NAM 2:2">ኡልፍነ ያቆብ እዶት ንዴብሰ።<verse eid="NAM 2:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 2:3"/>ጋቸነወን ሎልቶተሳ ድዲሞዸ፤</para>
  <para style="q2" vid="NAM 2:3">ጎቶትንስ ኡፈተ ብልዲማ ኡፈተኒሩ።</para>
  <para style="q1" vid="NAM 2:3">ጉያ እሳን እት ቆጴፈመን ሰነ፣</para>
  <para style="q2" vid="NAM 2:3">ስቢል ጋሪ ሎላረ ጅሩ ንጨለቅሰ፤</para>
  <para style="q2" vid="NAM 2:3">ኤቦንስ ጋትራንስ ንምርምርፈመ።<verse eid="NAM 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 2:4"/>ጋሪወን ሎላ ከራረ ደደርበተሙ፤</para>
  <para style="q2" vid="NAM 2:4">ኦብዲወን ኬሰስ አሲፊ አች ጉሉፉ።</para>
  <para style="q1" vid="NAM 2:4">እሳን ጉጨ ቦበኡ ፈካቱ፤</para>
  <para style="q2" vid="NAM 2:4">አኩመ በከካስ ንደርበተሙ።<verse eid="NAM 2:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 2:5"/>እን ጎቶተሳ ንያደተ፤</para>
  <para style="q2" vid="NAM 2:5">እሳን ገሩ ከራት ጉፈቱ።</para>
  <para style="q1" vid="NAM 2:5">እሳን ገረ ደላ መጋለቲት አሪፈቱ፤</para>
  <para style="q2" vid="NAM 2:5">ደኦንስ ቆጴፈሜፊ ጅረ።<verse eid="NAM 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 2:6"/>በልበል ለጌኒ በነማዸ፤</para>
  <para style="q2" vid="NAM 2:6">መሰራን ሞቱማስ ንጅገ።<verse eid="NAM 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 2:7"/>መጋለቲን ቁላት ሀፍቴ</para>
  <para style="q2" vid="NAM 2:7">አከ ቦጅአምቱ ሙርቴፈሜረ።</para>
  <para style="q1" vid="NAM 2:7">ጦምቦሬወንሼ</para>
  <para style="q2" vid="NAM 2:7">ቆመሳኒ ሩሩኩተኒ አከ ጉጌ ቦኡ።<verse eid="NAM 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 2:8"/>ነነዌን አኩመ ሀሮት፤</para>
  <para style="q2" vid="NAM 2:8">ብሻንሼስ ኬሳ ያኤ ዹመ።</para>
  <para style="q1" vid="NAM 2:8">እሳንስ፣ “ዻበዻ! ዻበዻ!” ጄዸኒ እዩ፤</para>
  <para style="q2" vid="NAM 2:8">ገሩ ነምን ቶኮዩ ዱግደ ዱበት ህንዴብኡ።<verse eid="NAM 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 2:9"/>ሜቲ ሳማ!</para>
  <para style="q2" vid="NAM 2:9">ወርቄ ሳማ!</para>
  <para style="q1" vid="NAM 2:9">መድሼ፣</para>
  <para style="q2" vid="NAM 2:9">በዻዹማን ኩሳ ቀቤኘሼ ሁንዳስ ዹመ ህንቀቡ!<verse eid="NAM 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 2:10"/>እሼን ዱዋ፣ ቁላፊ ኦነ ታቴርት!</para>
  <para style="q2" vid="NAM 2:10">ለጴን በቄረ፤ ጅልብ ላፌረ፤</para>
  <para style="q2" vid="NAM 2:10">ዸግን ሆለቴረ፤ ፉል ሁንድስ ጉራቸኤረ።<verse eid="NAM 2:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 2:11"/>ሆልቅ ሌንጮታ፣</para>
  <para style="q2" vid="NAM 2:11">እዶን እሳን እት እልማንሳኒ ሶረን፣</para>
  <para style="q1" vid="NAM 2:11">እዶን ሌንጭ ኮርማፊ ዸላን ኬሰ ያአን፣</para>
  <para style="q2" vid="NAM 2:11">ሳፌልሳኒስ ሶዳ መሌ ነጋዻን ጅራተን ኤሰ?<verse eid="NAM 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 2:12"/>ሌንጭ ዋን እልማንሳቲፍ ገኡ አጄፈቴ፤</para>
  <para style="q2" vid="NAM 2:12">ሌንጮተ ዸላሳቲፍስ ዋ ሁዼ አጄሴ፤</para>
  <para style="q1" vid="NAM 2:12">ቦለሳ ዋን አደምሴን፣</para>
  <para style="q2" vid="NAM 2:12">ሆልቀሳሞ ጉማ ፎኒቲን ጉተቴ።<verse eid="NAM 2:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 2:13"/>
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ አከነ ጄዸ፤</para>
  <para style="q2" vid="NAM 2:13">“አን ስት ከኤረ፤</para>
  <para style="q1" vid="NAM 2:13">አን ጋሪወንኬ ከኔን ወራና ጉቤ ዳራ ነንጎዸ፤</para>
  <para style="q2" vid="NAM 2:13">ጎራዴንስ ሌንጨኬ ሳፌለ ፍጠ።</para>
  <para style="q1" vid="NAM 2:13">አን ዋን አት አደምሰቱ ቶኮሌ</para>
  <para style="q2" vid="NAM 2:13">ለፈረት ሲፍ ህንሀምብሱ።</para>
  <para style="q1" vid="NAM 2:13">ሰገሌን ኤርገሞተኬቲ</para>
  <para style="q2" vid="NAM 2:13">ለመተ ህንዸገአሙ።”<verse eid="NAM 2:13"/></para>
  <chapter eid="NAM 2"/>
  <chapter number="3" style="c" sid="NAM 3"/>
  <para style="s1">ነነዌፍ ወዮ</para>
  <para style="q1">
    <verse number="1" style="v" sid="NAM 3:1"/>መጋለቲ ዺጋቲፍ፣</para>
  <para style="q2" vid="NAM 3:1">ከን ሶባን ጉተምቴፍ፣</para>
  <para style="q1" vid="NAM 3:1">ከን ሳምቻን ጉተምቴፍ፣</para>
  <para style="q2" vid="NAM 3:1">ከን ወር ሀምነ ሆጄተን ኬሳ <optbreak/> ህንዸበምኔ ሰናፍ ወዮ!<verse eid="NAM 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 3:2"/>እይ ቀጬ፣</para>
  <para style="q2" vid="NAM 3:2">ከከክሱን ጎማ፣</para>
  <para style="q1" vid="NAM 3:2">ጉሉፉን ፈርዳ፣</para>
  <para style="q2" vid="NAM 3:2">ድድቹን ጋሪ ሎላ ንዸገአመ!<verse eid="NAM 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 3:3"/>አባን ፈርዳ ንጉሉፈ፤</para>
  <para style="q2" vid="NAM 3:3">ጎራዴን ንበለቅሰ፤</para>
  <para style="q2" vid="NAM 3:3">ኤቦን ንጨለቅሰ!</para>
  <para style="q1" vid="NAM 3:3">በላ ሄዱን ነመረ ገኤረ፤</para>
  <para style="q2" vid="NAM 3:3">ነምን ባይኤን ዱኤረ፤</para>
  <para style="q1" vid="NAM 3:3">ሬፍ ለኮብሰ ህንቀቡ፤</para>
  <para style="q2" vid="NAM 3:3">ነሞትንስ ሬፈሳኒ ጉፈቱ፤<verse eid="NAM 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 3:4"/>ኩን ሁንድ ሰበቢ ባይእነ ሰጋገሉማ ሰጋገልቱቲን፣</para>
  <para style="q2" vid="NAM 3:4">ጊፍቲ ፈልፈልቶታ፣</para>
  <para style="q1" vid="NAM 3:4">ከን ሰጋገልቱማሼቲን ሰቦተ፣</para>
  <para style="q2" vid="NAM 3:4">ቶልቸሼቲንሞ ኡመተ ገርቦምፈቴ ሰናቲን ተኤ።<verse eid="NAM 3:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 3:5"/>
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ አከነ ጄዸ፦</para>
  <para style="q2" vid="NAM 3:5">“አን ስት ከኤን ጅረ።</para>
  <para style="q2" vid="NAM 3:5">አን ኡፈተኬ ፉለኬት ኦል ነንሶቆለ።</para>
  <para style="q1" vid="NAM 3:5">አን ሰቦተት ቁላኬ፣</para>
  <para style="q2" vid="NAM 3:5">ሞቱሞተትሞ ቃኒኬ ነንሙልእሰ።<verse eid="NAM 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 3:6"/>አን ጡሪዻን ስን ፋለ፤</para>
  <para style="q2" vid="NAM 3:6">አከ መሌ ስን ቱፈዸ፤</para>
  <para style="q2" vid="NAM 3:6">ዋን ኮልፋስ ስን ጎዸ።<verse eid="NAM 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 3:7"/>ነምን ስ አርጉ ሁንድ ስራ በቀቴ፣</para>
  <para style="q2" vid="NAM 3:7">‘ነነዌን በዱት ጅርት፤ ኤኙቱ ቦኣፍ?’ ሲን ጄዸ፤</para>
  <para style="q2" vid="NAM 3:7">አን ነመ ስ ጀጀቤሱ ቶኮሌ ኤሳን አርገዸ?”<verse eid="NAM 3:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 3:8"/>አት፣ ኖእ አሞን</para>
  <para style="q2" vid="NAM 3:8">ብየ ለገ አበያራ</para>
  <para style="q2" vid="NAM 3:8">ከን ብሻኒን መርፈምቴ ሰነ ጫልታ?</para>
  <para style="q1" vid="NAM 3:8">ለግን ደኦሼት፤</para>
  <para style="q2" vid="NAM 3:8">ብሻንስ ደላሼት።<verse eid="NAM 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 3:9"/>እቶጵያፊ ግብጥ ጀብነሼ ከን ዹመ ህንቀብኔዸ፤</para>
  <para style="q2" vid="NAM 3:9">ፉጢፊ ሊብያን ቱምስቶተሼት።<verse eid="NAM 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 3:10"/>ተኡስ እሼን ቦጅአምቴ</para>
  <para style="q2" vid="NAM 3:10">ብየ ኦርማት ጌፈምቴ።</para>
  <para style="q1" vid="NAM 3:10">ዳእመንሼ መታ ዳንዲ ሁንዳረት</para>
  <para style="q2" vid="NAM 3:10">ምጭርቅፈመኒ ዹመን።</para>
  <para style="q1" vid="NAM 3:10">ነሞተሼ ኡልፋቶት እጣ ቡፈተኒ</para>
  <para style="q2" vid="NAM 3:10">ነሞትንሼ ጉርጉዶትን ሁንድኑ <optbreak/> ፎንጫዻን ህዸመን።<verse eid="NAM 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 3:11"/>አትስ ንመቾፍተ፤ ንዾከተስ፤</para>
  <para style="q2" vid="NAM 3:11">ዲነ ጀላ በኡፍስ ደኦ በርባደተ።<verse eid="NAM 3:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 3:12"/>ደኦንኬ ሁንድ ሙኬን ሀርቡ</para>
  <para style="q2" vid="NAM 3:12">ከኔን እጀ ጀልቀበት ብልቻቴ ቀበን ፈካተ፤</para>
  <para style="q1" vid="NAM 3:12">ዬሮ ሙኬን ሱን ሁርጉፈመንት</para>
  <para style="q2" vid="NAM 3:12">እጅሳኒ አፋን ነመ ዋ ኛቱ ኬሰ ቡአ።<verse eid="NAM 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 3:13"/>ሜ ራያኬ እላል፤</para>
  <para style="q2" vid="NAM 3:13">እሳን ሁንድኑ ዱበርቶተ!</para>
  <para style="q1" vid="NAM 3:13">ከረወን ብየኬቲ</para>
  <para style="q2" vid="NAM 3:13">ዲኖተኬቲፍ በልአተኒ በነመኒሩ፤</para>
  <para style="q2" vid="NAM 3:13">እብድስ ደንቀራሳኒ ጉቤ ፍጤረ።<verse eid="NAM 3:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="NAM 3:14"/>ኡቱ ህንመርፈምን ብሻን ወራበዹ፤</para>
  <para style="q2" vid="NAM 3:14">ሁምነ እትሳኬ ጀጀቤፈዹ!</para>
  <para style="q1" vid="NAM 3:14">ሱጴ ቶልፈዹ፤</para>
  <para style="q2" vid="NAM 3:14">ዾቄ ሱጴ ዺተዹ፤</para>
  <para style="q2" vid="NAM 3:14">ጡቢ ቶልፈዹ።<verse eid="NAM 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="NAM 3:15"/>አችት እብድ ስ ፍጠ፤</para>
  <para style="q2" vid="NAM 3:15">ጎራዴንስ ስ ጭጭሬ</para>
  <para style="q2" vid="NAM 3:15">አኩመ ኮሮጵሳስ ስ በርበዴሰ።</para>
  <para style="q1" vid="NAM 3:15">አከ ኮሮጵሳ ሆር፤</para>
  <para style="q2" vid="NAM 3:15">አኩመ ሀዋንሳ ባይአዹ።<verse eid="NAM 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="NAM 3:16"/>አት ሀመ እሳን ኡርጂ ሰሚ ጫላ ባይአተንት</para>
  <para style="q2" vid="NAM 3:16">ደልደልቶተኬ ባይእፈቴርተ፤</para>
  <para style="q1" vid="NAM 3:16">እሳን ገሩ አኩመ ሀዋንሳ ብየቲ ቁላ ሀምብሰኒ</para>
  <para style="q2" vid="NAM 3:16">ኤርገሲ በርሰኒ ዴሙ።<verse eid="NAM 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="NAM 3:17"/>ኤግዶንኬ አኩመ ሀዋንሳት፤</para>
  <para style="q2" vid="NAM 3:17">ቆንዳልቶትንኬስ አኩመ ቱተ ሀዋንሳ</para>
  <para style="q2" vid="NAM 3:17">ከን ጉያ ቀበና ደላረ ቁበቱት፤</para>
  <para style="q1" vid="NAM 3:17">ዬሮ አዱን ባቱ ገሩ በርሰኒ በዱ፤</para>
  <para style="q2" vid="NAM 3:17">ነምን ቶኮዩ ገረ እሳን ዸቀን ህንቤኩ።<verse eid="NAM 3:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="NAM 3:18"/>ያ ሞቲ አሶር ትክስቶትንኬ ሙገኒሩ፤</para>
  <para style="q2" vid="NAM 3:18">ነሞትንኬ ኡልፋቶትን ቦቆቹፍ ገድ ጭጪሰኒሩ።</para>
  <para style="q1" vid="NAM 3:18">ነሞትንኬ ነመ ወልት እሳን ቀቡ ዸበኒ</para>
  <para style="q2" vid="NAM 3:18">ቱሉወንረት ብብትናአኒሩ።<verse eid="NAM 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="NAM 3:19"/>ወን ቶኮዩ መዳኬ ፈይሱ ህንደንደኡ፤</para>
  <para style="q2" vid="NAM 3:19">ሚዸምንኬስ ከን ዱኣን ስ ገኡዸ።</para>
  <para style="q1" vid="NAM 3:19">ነምን ኦዱ ዋኤኬቲ ዸገኡ ሁንድኑ</para>
  <para style="q2" vid="NAM 3:19">ኩፋቲኬት ሀርከ ወልት ሩሩኩተ፤</para>
  <para style="q1" vid="NAM 3:19">ገረ ጀብነኬ ከን ዹመ ህንቀብኔ ሰናን</para>
  <para style="q2" vid="NAM 3:19">ኤኙቱ ህንሚዸምን?<verse eid="NAM 3:19"/></para>
  <chapter eid="NAM 3"/>
</usx>
