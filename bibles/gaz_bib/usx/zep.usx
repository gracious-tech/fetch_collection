<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ZEP" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">ሴፋንያ</para>
  <para style="toc1">ራጂ ሴፋንያ</para>
  <para style="toc2">ሴፋንያ</para>
  <para style="toc3">ሴፋ</para>
  <para style="mt2">ራጂ</para>
  <para style="mt1">ሴፋንያ</para>
  <chapter number="1" style="c" sid="ZEP 1"/>
  <para style="p">
    <verse number="1" style="v" sid="ZEP 1:1"/>ዱቢን <char style="nd">ዋቀዮ</char> ከን በረ ዮስያስ እልም ኣሞን ሞቲ ይሁዳ ቱሬ ኬሰ ገረ ሴፋንያ እልመ ኩሺ፣ እልመ ጌዳልያስ፣ እልመ አመርያ፣ እልመ ህስቅያስ ዹፌ ከናዸ፦<verse eid="ZEP 1:1"/></para>
  <para style="b"/>
  <para style="s1">አኬከቺሰ ዋኤ በዲሰ ዹፋ ጅሩ</para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 1:2"/>“አን ፉለ ለፋራ</para>
  <para style="q2" vid="ZEP 1:2">ዋን ሁንደ ሀጣኤ ነንበሌሰ”</para>
  <para style="q2" vid="ZEP 1:2">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="ZEP 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 1:3"/>“አን ነማፊ ሆሪ ሀጣኤ ነንበሌሰ፤</para>
  <para style="q2" vid="ZEP 1:3">ስምብሮ ሰሚቲፊ</para>
  <para style="q2" vid="ZEP 1:3">ቁርጡሚ ገላና፣</para>
  <para style="q2" vid="ZEP 1:3">ዋቆተ ቶልፈሞ ነሞተ ሀሞ ጉፈቺሰንስ ሀጣኤ ነንበሌሰ።”</para>
  <para style="b" vid="ZEP 1:3"/>
  <para style="q1" vid="ZEP 1:3">“አን ሰኚ ነማ ለፈራ ነንበሌሰ”</para>
  <para style="q2" vid="ZEP 1:3">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="ZEP 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 1:4"/>“አን ይሁዳፊ</para>
  <para style="q2" vid="ZEP 1:4">ወረ ዬሩሳሌም ኬሰ ጅራተን ሁንደት ሀርከኮ ኦል ነንፉዸዸ።</para>
  <para style="q1" vid="ZEP 1:4">አን ሀምባ በኣል ሁንዳፊ <optbreak/> መቃ ሉቦተ ዋቆተ ቶልፈሞ ዋቄፈተኒ</para>
  <para style="q2" vid="ZEP 1:4">እዶ ከና ነንበሌሰ፤<verse eid="ZEP 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 1:5"/>ወረ ራያ ሰሚ ዋቄፈቹፍ</para>
  <para style="q2" vid="ZEP 1:5">ቅናጢ መናረት ሰገደን፣</para>
  <para style="q1" vid="ZEP 1:5">ወረ ሰገደኒፊ <char style="nd">ዋቀዮን</char> ከከተን፣</para>
  <para style="q2" vid="ZEP 1:5">ወረ ሞሌኪንስ ከከተን፣<verse eid="ZEP 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 1:6"/>ወረ <char style="nd">ዋቀዮን</char> ዱካ ቡኡ ዺሰኒ ዱበት ዴብአን፣</para>
  <para style="q2" vid="ZEP 1:6">ወረ <char style="nd">ዋቀዮን</char> ህንበርባድኔ <optbreak/> ዮካን ጎርሰሳ ህንጋፈትኔ ነንበሌሰ።”<verse eid="ZEP 1:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 1:7"/>ጉያን <char style="nd">ዋቀዮ</char> ዋን ዽኣቴፍ</para>
  <para style="q2" vid="ZEP 1:7">ፉለ <char style="nd">ዋቀዮ</char> ጎፍታ ዱረት ጨልእሳ።</para>
  <para style="q1" vid="ZEP 1:7">
    <char style="nd">ዋቀዮ</char> ቀልመ ቶኮ ቆጴሴረ፤</para>
  <para style="q2" vid="ZEP 1:7">እን ወረ አፌሬ ቁልቁሌሴረ።<verse eid="ZEP 1:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 1:8"/>“ጉያ ቀልመ <char style="nd">ዋቀዮት</char></para>
  <para style="q2" vid="ZEP 1:8">አን ቆንዳልቶተ እልማን ሞትቻቲፊ</para>
  <para style="q2" vid="ZEP 1:8">ወረ ወያ ኦርማ ኡፈተን ሁንደ ነንአደበ።<verse eid="ZEP 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 1:9"/>አን ጋፈስ ወረ ቡሳረ ኡታለን፣</para>
  <para style="q2" vid="ZEP 1:9">ከኔን ገልመ ዋቆተሳኒ</para>
  <para style="q2" vid="ZEP 1:9">ጄቁምሳፊ ጎዎምሳዻን ጉተን ነንአደበ።”<verse eid="ZEP 1:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 1:10"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፤</para>
  <para style="q2" vid="ZEP 1:10">“ጋፈስ ከረ ቁርጡሚራ እየ፣</para>
  <para style="q1" vid="ZEP 1:10">ወልተጂ ለመፋራ ወዋትና፣</para>
  <para style="q2" vid="ZEP 1:10">ጋረንራሞ</para>
  <para style="q2" vid="ZEP 1:10">ሰገሌ ዲገመ ጉዳቱ ዸጋአመ።<verse eid="ZEP 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 1:11"/>እስን ወር መክቴሽ ኬሰ ጅራተን ወዋዻ፤</para>
  <para style="q2" vid="ZEP 1:11">ደልደልቶትንኬሰን ሁንድ ለፈራ ሀጣአሙ፤</para>
  <para style="q2" vid="ZEP 1:11">ወር ሜቲ ደልደለን ሁንድኑስ ንበርበዳኡ።<verse eid="ZEP 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 1:12"/>አን ዬሮ ሰነ ዬሩሳሌምን እብሳዻን ነንሰከተአ፤</para>
  <para style="q2" vid="ZEP 1:12">ወረ ቀነኒዻን ጅራተን፣</para>
  <para style="q2" vid="ZEP 1:12">ከኔን አከ ዳዺ ወይኒ ሲጮ እረት ሀፌ ተአን፣</para>
  <para style="q1" vid="ZEP 1:12">ከኔን፣ ‘<char style="nd">ዋቀዮ</char> ዋን ቶላስ ተኡ ዋን ሀማ</para>
  <para style="q2" vid="ZEP 1:12">ሆማ ህንጎዹ’ ጄዸኒ ያደን ነንአደበ።<verse eid="ZEP 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 1:13"/>ቀቤኝሳኒ ንሳመመ፤</para>
  <para style="q2" vid="ZEP 1:13">መንሳኒ ንኦነ።</para>
  <para style="q1" vid="ZEP 1:13">እሳን መነ እጃረቱ፤</para>
  <para style="q2" vid="ZEP 1:13">ገሩ ኬሰ ህንጅራተን፤</para>
  <para style="q1" vid="ZEP 1:13">እሳን ብቅልቱ ወይኒ ንዻበቱ፤</para>
  <para style="q2" vid="ZEP 1:13">ገሩ ዳዺ ወይኒ ህንዹገን።”<verse eid="ZEP 1:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 1:14"/>ጉያን <char style="nd">ዋቀዮ</char> ጉድች ዽኣቴረ፤</para>
  <para style="q2" vid="ZEP 1:14">ዽኣቴስ ደፌ ዹፋ ጅረ።</para>
  <para style="q1" vid="ZEP 1:14">ዸገኣ! እይ ጉያ <char style="nd">ዋቀዮ</char> ሀዻኣዸ፤</para>
  <para style="q2" vid="ZEP 1:14">ጎትን አችት ሰገሌ ኦል ፉዸቴ እየ።<verse eid="ZEP 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 1:15"/>ጉያን ሱን ጉያ ዼከምሳ፣</para>
  <para style="q2" vid="ZEP 1:15">ጉያ ዽጵናፊ ገዳ፣</para>
  <para style="q3" vid="ZEP 1:15">ጉያ ረክናፊ በዲሳ፣</para>
  <para style="q2" vid="ZEP 1:15">ጉያ ዱከናፊ ድምምሳ፣</para>
  <para style="q3" vid="ZEP 1:15">ጉያ ዱሜሳቲፊ ዱከነ ሀማ ንተአ፤<verse eid="ZEP 1:15"/></para>
  <para style="q2">
    <verse number="16" style="v" sid="ZEP 1:16"/>መጋላወን ደላ ቀበኒፊ</para>
  <para style="q1" vid="ZEP 1:16">ገሞወን ኦል ዼዼሮረት</para>
  <para style="q2" vid="ZEP 1:16">ጉያ እት መለከተ አፉፈኒፊ እየ ወራና ተአ።<verse eid="ZEP 1:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ZEP 1:17"/>“ሰበቢ እሳን <char style="nd">ዋቀዮት</char> ጩቡ ሆጄተኒፍ፣</para>
  <para style="q2" vid="ZEP 1:17">አን አከ እሳን አኩመ ጃማት ዴመኒፍ</para>
  <para style="q2" vid="ZEP 1:17">ኡመተት ዽጵነ ነንፍደ።</para>
  <para style="q1" vid="ZEP 1:17">ዺግንሳኒ አኩመ አዋራ፣</para>
  <para style="q2" vid="ZEP 1:17">ምእ ገራሳኒስ አኩመ ኮሲ ገተመ።<verse eid="ZEP 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ZEP 1:18"/>ጉያ ዼከምሰ <char style="nd">ዋቀዮት</char></para>
  <para style="q2" vid="ZEP 1:18">ሜቲንሳኒ ዮካን ወርቄንሳኒ</para>
  <para style="q2" vid="ZEP 1:18">እሳን ኦልቹ ህንደንደኡ።”</para>
  <para style="b" vid="ZEP 1:18"/>
  <para style="q1" vid="ZEP 1:18">እብደ ህናፋሳቲን</para>
  <para style="q2" vid="ZEP 1:18">አዱኛን ሁንድ ንበርበዶፍት፤</para>
  <para style="q1" vid="ZEP 1:18">ወረ ለፈረ ጅራተን ሁንደት</para>
  <para style="q2" vid="ZEP 1:18">እን በዲሰ ተሳ ንፍዳቲ።<verse eid="ZEP 1:18"/></para>
  <chapter eid="ZEP 1"/>
  <chapter number="2" style="c" sid="ZEP 2"/>
  <para style="s1">ይሁዳፊ ዬሩሳሌም ሰቦተ ወሊን እት ሙርቴፈሜ</para>
  <para style="s2">ይሁዳን አከ ቀልቢ ጅጂረቱፍ አኬከቺፈሜ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ZEP 2:1"/>ያ ሰበ ቃኒ ህንቀብኔ፣</para>
  <para style="q2" vid="ZEP 2:1">ወልት ቀበማ፤ ወልት ቀበማ፤<verse eid="ZEP 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 2:2"/>ኡቱ ዬሮን ሙርታኤ ሱን ገኤ</para>
  <para style="q2" vid="ZEP 2:2">ጉያን ሱን አኩመ ሀበቂት እስን ህንሀጣእን፣</para>
  <para style="q1" vid="ZEP 2:2">ኡቱ ኣሪን <char style="nd">ዋቀዮ</char> እን ቦበኣን ሱን</para>
  <para style="q2" vid="ZEP 2:2">እስንት ህንዹፍን፣</para>
  <para style="q1" vid="ZEP 2:2">ኡቱ ጉያን ዼከምሰ <char style="nd">ዋቀዮ</char></para>
  <para style="q2" vid="ZEP 2:2">እስንት ህንዹፍን ወልት ቀበማ።<verse eid="ZEP 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 2:3"/>እስን ገራሞን ለፋ</para>
  <para style="q2" vid="ZEP 2:3">ከኔን ዋን እን አጀጁ ሆጄተን ሁንድ <optbreak/> <char style="nd">ዋቀዮን</char> በርባደዻ።</para>
  <para style="q1" vid="ZEP 2:3">ቀጄሉማ በርባዳ፤ ገድ ኦፍ ቀቢሰ በርባዳ፤</para>
  <para style="q2" vid="ZEP 2:3">እስን ጉያ ዼከምሰ <char style="nd">ዋቀዮት</char></para>
  <para style="q2" vid="ZEP 2:3">ንጎልቦበምቱ ተኣቲ።<verse eid="ZEP 2:3"/></para>
  <para style="s2">ፍልስጤም</para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 2:4"/>ጋዛን ዱዋ ሀፍት፤</para>
  <para style="q2" vid="ZEP 2:4">አሽቀሎንሞ ንኦንት።</para>
  <para style="q1" vid="ZEP 2:4">ሰብን አሽዶድ ጉዩመ ሳፋዻን አርአሜ በአ፤</para>
  <para style="q2" vid="ZEP 2:4">ኤቅሮንሞ ንቡቅፈምት።<verse eid="ZEP 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 2:5"/>ያ ኬሬቶተ ቀርቀረ ገላና ጅራተን፣</para>
  <para style="q2" vid="ZEP 2:5">እስኒፍ ወዮ፤</para>
  <para style="q1" vid="ZEP 2:5">ያ ከነኣን፣ ብየ ፍልስጤሞታ፣</para>
  <para style="q2" vid="ZEP 2:5">ዱቢን <char style="nd">ዋቀዮ</char> አከነ ጄዼ ስት ዹፌረ፤</para>
  <para style="q1" vid="ZEP 2:5">“አን ስን በርበዴሰ፤</para>
  <para style="q2" vid="ZEP 2:5">ነምን ቶኮዩ ህንሀፉ።”<verse eid="ZEP 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 2:6"/>ብይ ቀርቀረ ገላና፣</para>
  <para style="q2" vid="ZEP 2:6">እዶን ከሊቶትን ጅራተን፣</para>
  <para style="q2" vid="ZEP 2:6">እዶ ትክስቶትን ጅራተኒፊ ጎለ ቡሻዬ ተአ።<verse eid="ZEP 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 2:7"/>እንስ ሀንዹራ ሀምባ መነ ይሁዳ ተአ፤</para>
  <para style="q2" vid="ZEP 2:7">እሳን አችት ለፈ ዼዳ አርገቱ።</para>
  <para style="q1" vid="ZEP 2:7">እሳን ገልገለ ገልገለ</para>
  <para style="q2" vid="ZEP 2:7">መነ አሽቀሎን ኬሰ ጭጪሱ።</para>
  <para style="q1" vid="ZEP 2:7">
    <char style="nd">ዋቀዮ</char> ዋቅንሳኒ እሳን ትክሰ፤</para>
  <para style="q2" vid="ZEP 2:7">ቦጁሳኒስ ንዴብሳፍ።<verse eid="ZEP 2:7"/></para>
  <para style="s2">ሞኣቢፊ አሞን</para>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 2:8"/>“አን አረብሶ ሞኣቢፊ</para>
  <para style="q2" vid="ZEP 2:8">ቆሳ አሞኖታ፣</para>
  <para style="q1" vid="ZEP 2:8">ወረ ሰበኮ አረብሰኒፊ</para>
  <para style="q2" vid="ZEP 2:8">ብየሳኒ ዶርስሰን ሰና ዸገኤረ።<verse eid="ZEP 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 2:9"/>ከናፉ አኩመ አን ዹጉማን ጅራታ ተኤ ሰነ፣”</para>
  <para style="q2" vid="ZEP 2:9">ጄዸ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣</para>
  <para style="q2" vid="ZEP 2:9">ዋቅን እስራኤል አከነ ጄዸ፤</para>
  <para style="q1" vid="ZEP 2:9">“ሞኣብ ዹጉማን አኩመ ሶዶም፣</para>
  <para style="q2" vid="ZEP 2:9">አሞኖትንስ አከ ጎሞራ፣</para>
  <para style="q1" vid="ZEP 2:9">እዶ አረማቲፊ ቦለ ሶግዳ፣</para>
  <para style="q2" vid="ZEP 2:9">ለፈ በረ በራን ኦኔ ንተኡ።</para>
  <para style="q1" vid="ZEP 2:9">ሀፍቴን ኡመተኮቲ እሳን ሳሙ፤</para>
  <para style="q2" vid="ZEP 2:9">ወር ሰበኮ ኬሳ በዲ ጀላ በአን ብየሳኒ ንዻሉ።”<verse eid="ZEP 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 2:10"/>ኩን ገቲ እሳን ኦፍ ቱሉማሳኒቲፍ አርገተኒዸ፤</para>
  <para style="q2" vid="ZEP 2:10">እሳን ሰበ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ አረብሰኒ</para>
  <para style="q2" vid="ZEP 2:10">እት ቆሰኒሩቲ።<verse eid="ZEP 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 2:11"/>
    <char style="nd">ዋቀዮ</char> ዬሮ ዋቆተ ብየቲ ሁንደ በርበዴሱት፣</para>
  <para style="q2" vid="ZEP 2:11">አከ መሌ እሳን ሶዳችሰ።</para>
  <para style="q1" vid="ZEP 2:11">ሰቦትን ቀርቀረ ገላነ ሁንዳረ ጅራተን፣</para>
  <para style="q2" vid="ZEP 2:11">ነምን ብየሳ ኬሰ ጅራቱ ሁንድኑስ እሰ ዋቄፈተ።<verse eid="ZEP 2:11"/></para>
  <para style="s2">እቶጵያ</para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 2:12"/>“ያ ወረ እቶጵያ</para>
  <para style="q2" vid="ZEP 2:12">እስንስ ጎራዴኮቲን ንጎረአምቱ።”<verse eid="ZEP 2:12"/></para>
  <para style="s2">አሶር</para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 2:13"/>እን ካበት ሀርከ ኦል ፉዸተ፤</para>
  <para style="q2" vid="ZEP 2:13">አሶርንስ ንበርበዴሰ፤</para>
  <para style="q1" vid="ZEP 2:13">ነነዌ ጉቱማን ጉቱት ንኦንሰ፤</para>
  <para style="q2" vid="ZEP 2:13">አኩመ ገሞጂት ጎግሴ ሀምብሰ።<verse eid="ZEP 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 2:14"/>ቡሻዬፊ ሎን፣</para>
  <para style="q2" vid="ZEP 2:14">ኡመመወን ጎሰ ሁንዳ አች ጭጪሱ።</para>
  <para style="q1" vid="ZEP 2:14">ኡሩንጉፊ ዸዴን</para>
  <para style="q2" vid="ZEP 2:14">ኡቱባሼረ ቦቆቱ።</para>
  <para style="q1" vid="ZEP 2:14">ሰገሌንሳኒ ፎዳወን ኬሳን ዸገአመ፤</para>
  <para style="q2" vid="ZEP 2:14">ዲገምን በልበለሳኒ ዱረ ጅረ፤</para>
  <para style="q2" vid="ZEP 2:14">ዴምዴሞን ብርብርሳ ሁንድኑ ቁላ ሀፈ።<verse eid="ZEP 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 2:15"/>ኩን መጋላ ኦፍ ህንኤገትኔ</para>
  <para style="q2" vid="ZEP 2:15">ከን ገሩ ነጉማን ጅራቱዸ።</para>
  <para style="q1" vid="ZEP 2:15">መጋላን ኩን፣</para>
  <para style="q2" vid="ZEP 2:15">“አኑመ ቆፈ መሌ ከን ብራ ነ ብረ ህንጅሩ” ኦፊን ጄቴ።</para>
  <para style="q1" vid="ZEP 2:15">እሼን አከም አከስ ኦንቴ፣</para>
  <para style="q2" vid="ZEP 2:15">እዶ ብኔንስ ቦሶና ጅራቱ ታቴ!</para>
  <para style="q1" vid="ZEP 2:15">ነምን እሼ ብረ በኤ ደርቡ ሁንድኑ ንቆሰ፤</para>
  <para style="q2" vid="ZEP 2:15">ሀርከሳስ ንራሰ።<verse eid="ZEP 2:15"/></para>
  <chapter eid="ZEP 2"/>
  <chapter number="3" style="c" sid="ZEP 3"/>
  <para style="s2">ዬሩሳሌም</para>
  <para style="q1">
    <verse number="1" style="v" sid="ZEP 3:1"/>መጋላ ጩንቁርስቶታ፣</para>
  <para style="q2" vid="ZEP 3:1">ፍንጭልቱፊ ጡሮፍቱ ሰናፍ ወዮ!<verse eid="ZEP 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 3:2"/>እሼን ነመ ቶኮፍዩ ህንአጀጀምቱ፤</para>
  <para style="q2" vid="ZEP 3:2">ስሬፈመ ቶኮዩ ህንፉዸቱ።</para>
  <para style="q1" vid="ZEP 3:2">እሼን <char style="nd">ዋቀዮን</char> ህንአመነቱ፤</para>
  <para style="q2" vid="ZEP 3:2">ዋቀ እሼትስ ህንዽኣቱ።<verse eid="ZEP 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 3:3"/>ቆንዳልቶትንሼ ሌንጨ ኣዱዸ፤</para>
  <para style="q2" vid="ZEP 3:3">ቡልችቶትንሼ ዬዪ ገልገላ</para>
  <para style="q2" vid="ZEP 3:3">ከኔን ዋን ቶኮሌ ገነማፍ <optbreak/> ህንቡልፈኔዸ።<verse eid="ZEP 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 3:4"/>ራጆትንሼ ኦፍ ቱልቶተ፤</para>
  <para style="q2" vid="ZEP 3:4">እሳን ነሞተ ህንአመነምኔዸ።</para>
  <para style="q1" vid="ZEP 3:4">ሉቦትንሼ እዶ ቁልቁሉ ጡሬሰኒ</para>
  <para style="q2" vid="ZEP 3:4">ሴረስ ጨብሱ።<verse eid="ZEP 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 3:5"/>
    <char style="nd">ዋቀዮ</char> እን እሼ ኬሰ ጅሩ ቀጄላዸ፤</para>
  <para style="q2" vid="ZEP 3:5">እን ዶጎጎረ ቶኮሌ ህንሆጄቱ።</para>
  <para style="q1" vid="ZEP 3:5">እን ገነመ ገነመ ሙርቲ ቀጄላ ኬነ፤</para>
  <para style="q2" vid="ZEP 3:5">ጉያ ቶኮዩ ዋን ከነ ሆጄቹ ህንደዸቡ፤</para>
  <para style="q2" vid="ZEP 3:5">ጀልኦትን ገሩ ቃኒ ቶኮዩ ህንቤከን።<verse eid="ZEP 3:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 3:6"/>“አን ሰቦተ ነንበሌሰ፤</para>
  <para style="q2" vid="ZEP 3:6">ደአኖወንሳኒ ዲገመኒሩ።</para>
  <para style="q1" vid="ZEP 3:6">አከ ነምን ቶኮዩ አቺን ህንደበሬፍ</para>
  <para style="q2" vid="ZEP 3:6">አን ዳንዲወንሼ ኦንሴረ።</para>
  <para style="q1" vid="ZEP 3:6">መጋላወንሳኒ ኦነኒ</para>
  <para style="q2" vid="ZEP 3:6">ነመ መሌ፣ ዱዋ ሀፉ።<verse eid="ZEP 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 3:7"/>አን መጋላ ሰናን፣</para>
  <para style="q2" vid="ZEP 3:7">‘አት ዹጉማን ነ ሶዳተ፤</para>
  <para style="q2" vid="ZEP 3:7">ስሬፈመስ ንፉዸተ!’ ነንጄዼ።</para>
  <para style="q1" vid="ZEP 3:7">ኤርገሲ እዶን ጅሬኘሼ ህንበዱ</para>
  <para style="q2" vid="ZEP 3:7">ዮካን አደቢንኮ ሁንድኑ እሼት ህንዹፉ።</para>
  <para style="q1" vid="ZEP 3:7">እሳን ገሩ ዋን ሆጄተን ሁንደ ኬሰት</para>
  <para style="q2" vid="ZEP 3:7">ደበ ሆጄቹት ጭመን።<verse eid="ZEP 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 3:8"/>ከናፉ ጉያ አን እት ዹጋ በኡ ኤገዹ።”</para>
  <para style="q2" vid="ZEP 3:8">ጄዸ <char style="nd">ዋቀዮ</char>፤</para>
  <para style="q1" vid="ZEP 3:8">“አን ሰቦታፊ</para>
  <para style="q2" vid="ZEP 3:8">ሞቱሞተ ወልት ቀቤ</para>
  <para style="q1" vid="ZEP 3:8">ዼከምሰኮቲፊ</para>
  <para style="q2" vid="ZEP 3:8">ኣሪኮ ሶዳችሳ ሰነ ሁንደ</para>
  <para style="q2" vid="ZEP 3:8">እሳንት ዸንገላሱፍ ሙርቴሴረ።</para>
  <para style="q1" vid="ZEP 3:8">አዱኛን ጉቱን እብደ ህናፋኮቲን</para>
  <para style="q2" vid="ZEP 3:8">ጉበቴ በርበዶፍት።<verse eid="ZEP 3:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 3:9"/>“ኤርገሲ አን አከ ሁንድሳኒ <optbreak/> መቃ <char style="nd">ዋቀዮ</char> ዋመተኒፍ፣</para>
  <para style="q2" vid="ZEP 3:9">አከ ወሊ ገሉዻን እሰ ተጃጅለኒፍስ</para>
  <para style="q2" vid="ZEP 3:9">አፋን ነሞታ ነንቁልቁሌሰ።<verse eid="ZEP 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 3:10"/>ወር አናፍ ሰገደን፣ እንተለንኮ ከኔን ብትናአን</para>
  <para style="q2" vid="ZEP 3:10">ለጌን እቶጵያ ገማ</para>
  <para style="q2" vid="ZEP 3:10">ኬና ናፍ ፍዱ።<verse eid="ZEP 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 3:11"/>ሰበቢ አን ወረ ኦፍ ቱሉማሳኒት ገመደን</para>
  <para style="q2" vid="ZEP 3:11">መጋላ ከነ ኬሳ ባሱፍ፣</para>
  <para style="q1" vid="ZEP 3:11">ጋፈስ የከ አት ነት ሆጄቴ</para>
  <para style="q2" vid="ZEP 3:11">ሰነ ሁንዳፍ ሰልጵን ስት ህንዹፉ።</para>
  <para style="q1" vid="ZEP 3:11">አት ለመተ</para>
  <para style="q2" vid="ZEP 3:11">ጋረኮ ቁልቁሉረት ኦፍ ህንቱልቱ።<verse eid="ZEP 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 3:12"/>አን ገሩ ገራሞታፊ</para>
  <para style="q2" vid="ZEP 3:12">ገድ ኦፍ ቀቤዪ</para>
  <para style="q1" vid="ZEP 3:12">ከኔን መቃ <char style="nd">ዋቀዮ</char> አመነተን</para>
  <para style="q2" vid="ZEP 3:12">ስ ኬሰት ነንሀምብሰ።<verse eid="ZEP 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 3:13"/>ሀምባን እስራኤል</para>
  <para style="q2" vid="ZEP 3:13">የከ ቶኮሌ ህንሆጄተን።</para>
  <para style="q1" vid="ZEP 3:13">እሳን ሶበ ህንዱበተን</para>
  <para style="q2" vid="ZEP 3:13">ዮካን ጎዎምሳን አፋንሳኒ ኬሰት ህንአርገሙ።</para>
  <para style="q1" vid="ZEP 3:13">እሳን ኛተኒ ቦቆቱ፤</para>
  <para style="q2" vid="ZEP 3:13">ከን እሳን ሶዳችሱስ ይንጅሩ።”<verse eid="ZEP 3:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 3:14"/>ያ እንተለ ጥዮን አት ፋርፈዹ፤</para>
  <para style="q2" vid="ZEP 3:14">ያ እስራኤል ሰገሌ ኦል ፉዸዹ እይ!</para>
  <para style="q1" vid="ZEP 3:14">ያ እንተለ ዬሩሳሌም ገመዲቲ</para>
  <para style="q2" vid="ZEP 3:14">ገራኬ ጉቱዻን እልልች!<verse eid="ZEP 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 3:15"/>
    <char style="nd">ዋቀዮ</char> አደበኬ ስራ ፉዼረ፤</para>
  <para style="q2" vid="ZEP 3:15">እን ዲኖተኬ ስራ ዴብሴረ።</para>
  <para style="q1" vid="ZEP 3:15">
    <char style="nd">ዋቀዮ</char> ሞቲን እስራኤል፣ ስ ወጅን ጅረ፤</para>
  <para style="q2" vid="ZEP 3:15">አት ለመተ በላ ቶኮሌ ህንሶዳቱ።<verse eid="ZEP 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ZEP 3:16"/>እሳን ጋፈስ</para>
  <para style="q2" vid="ZEP 3:16">ዬሩሳሌሚን አከነ ንጄዹ፤</para>
  <para style="q1" vid="ZEP 3:16">“ያ ጥዮን ህንሶዳትን፤</para>
  <para style="q2" vid="ZEP 3:16">ሀርክኬስ ህንላፍን።<verse eid="ZEP 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ZEP 3:17"/>
    <char style="nd">ዋቀዮ</char> ዋቅንኬ</para>
  <para style="q2" vid="ZEP 3:17">እን ስ ወጅን ጅሩ ጀባዸ።</para>
  <para style="q1" vid="ZEP 3:17">እን ባይኤ ስት ገመደ፤</para>
  <para style="q2" vid="ZEP 3:17">እን ጃለለሳቲን ስ ቦቆቺሰ፤</para>
  <para style="q2" vid="ZEP 3:17">ፋርፈትናዻንስ ስት ገመደ።”<verse eid="ZEP 3:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ZEP 3:18"/>“አን ገደ አት አያኖተ ሙርቴፈመኒፍ ገድቱ</para>
  <para style="q2" vid="ZEP 3:18">ስራ ነንፉዸ፤</para>
  <para style="q2" vid="ZEP 3:18">እሳን ቦእቻፊ ሰልጵነ ስት ተኡ።<verse eid="ZEP 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ZEP 3:19"/>አን ዬሮ ሰነት</para>
  <para style="q2" vid="ZEP 3:19">ወረ ስ ጩንቁርሰን ሁንደ ነንአደበ፤</para>
  <para style="q1" vid="ZEP 3:19">አን ኦኮላ ነንበራረ፤</para>
  <para style="q2" vid="ZEP 3:19">ወረ ገተመንስ ወልት ነንቀበ።</para>
  <para style="q1" vid="ZEP 3:19">አን ብየ እሳን እት ቃኔፈመን ሁንደ ኬሰት</para>
  <para style="q2" vid="ZEP 3:19">መቃፊ ኡልፍነ እሳኒፍን ኬናፍ።<verse eid="ZEP 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ZEP 3:20"/>አን ዬሮ ሰነት ወልትን እስን ቀበ፤</para>
  <para style="q2" vid="ZEP 3:20">ዬሮ ሰነት አን ብየኬሰንት እስን ነንገልቸ።</para>
  <para style="q1" vid="ZEP 3:20">አን ዬሮ ኡቱመ እስን አርግተኒ</para>
  <para style="q2" vid="ZEP 3:20">ቦጁኬሰን ዴብሱት</para>
  <para style="q1" vid="ZEP 3:20">ሰበ ለፋ ሁንደ ግዱት</para>
  <para style="q2" vid="ZEP 3:20">ኡልፍናፊ መቃ እስኒፍን ኬነ”</para>
  <para style="q2" vid="ZEP 3:20">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="ZEP 3:20"/></para>
  <chapter eid="ZEP 3"/>
</usx>
