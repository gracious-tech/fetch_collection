<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="EXO" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">በኡ</para>
  <para style="toc1">ሴረ በኡ</para>
  <para style="toc2">በኡ</para>
  <para style="toc3">በኡ</para>
  <para style="mt2">ሴረ</para>
  <para style="mt1">በኡ</para>
  <chapter number="1" style="c" sid="EXO 1"/>
  <para style="s1">እስራኤሎትን ጩንቁርፈመን</para>
  <para style="lh">
    <verse number="1" style="v" sid="EXO 1:1"/>መቃን እልማን እስራኤል ከኔን ማቲሳኒ ቀበተኒ ያቆብ ወጅን ግብጥ ዸቀኒ ከናዸ፦<verse eid="EXO 1:1"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="2" style="v" sid="EXO 1:2"/>ሩቤን፣ ስምኦን፣ ሌዊፊ ይሁዳ፤<verse eid="EXO 1:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="EXO 1:3"/>ይሳኮር፣ ዜቡሎኒፊ ቤንያም፤<verse eid="EXO 1:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="EXO 1:4"/>ዳኒፊ ንፍታሌም፤</para>
  <para style="li1" vid="EXO 1:4">ጋዲፊ ኣሼር።<verse eid="EXO 1:4"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="5" style="v" sid="EXO 1:5"/>ነሞትን ሰኚ ያቆብራ ዸለተን ወሉማ ገለት ቶርባተመ ቱረን፤ ዮሴፍ ዱሩማኑ ግብጥ ቱሬ።<verse eid="EXO 1:5"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="6" style="v" sid="EXO 1:6"/>ዮሴፊፊ ኦቦሎተሳ ሁንድ፣ ዸሎትን ሱን ሁንድኑስ፣ ንዱአን። <verse eid="EXO 1:6"/><verse number="7" style="v" sid="EXO 1:7"/>እስራኤሎትን ገሩ ሆረኒ አከ መሌ ባይአተን፤ ባይአተኒስ አከ መሌ ጀባተን፤ ብየቲ ኬሰስ ንጉተን።<verse eid="EXO 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 1:8"/>ኤርገሲ ሞቲን ዋኤ ዮሴፍ ህንቤክን ሃራን ቶኮ ቡልቻ ግብጥ ተኤ። <verse eid="EXO 1:8"/><verse number="9" style="v" sid="EXO 1:9"/>እንስ ሰበሳቲን አከነ ጄዼ፤ “ኩኖ፣ እስራኤሎትን ኑ ጫላ ባይአተኒሩ፤ ኑ ጫላስ ጀባተኒሩ። <verse eid="EXO 1:9"/><verse number="10" style="v" sid="EXO 1:10"/>ኮታ አከ እሳን ከነ ጫላ ህንባይአኔፍ፣ ዮ ወራን ከኤስ ዲኖተኬኘ ገርጋረኒ አከ ኑ ህንወራኔፊ አከ ብየቲ ኬሳ በቀተኒ ህንባኔፍ ሀጡማዻን እሳን ቀብነ።”<verse eid="EXO 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 1:11"/>ከናፉ እት ጋፈተምቶተ እሳን ጩንቁርሰኒ ሆጂ ሁምና ሆጄቺሰን እሳንት ሙደን፤ እስራኤሎንስ ፊቶሚፊ ራምሴ መጋላወን ዋ እት ኩሰን ጎዸኒ ፈረኦኒፍ እጃረን። <verse eid="EXO 1:11"/><verse number="12" style="v" sid="EXO 1:12"/>እሳን ገሩ ሀመ ጩንቁርሳን እሳንት ጀባቻ ዴሜ ሰነ ባይአተኒ ለፈ ጉተን፤ ከነረት ወር ግብጥ ሰበ እስራኤል ሶዳተን። <verse eid="EXO 1:12"/><verse number="13" style="v" sid="EXO 1:13"/>ወር ግብጥስ እስራኤሎተት ገረ ጀብናን እሳን ሆጄቺፈተን። <verse eid="EXO 1:13"/><verse number="14" style="v" sid="EXO 1:14"/>እሳንስ ሱጴፊ ጡቢ ሆጄቺሱዻን፣ ለፈ ቆቲሳ ኬሰስ ሆጂ ገራ ገራ ሁንደ ሆጄቺሱዻን ሆጂ እት ጭምሰኒ ጅሬኘ እሳንት ሀዼሰን፤ ወር ግብጥ ሆጂ ጀባ ጀረ ሆጄቺሰን ሁንደ ኬሰት ገራ እሳኒፍ ህንላፈን ቱሬ።<verse eid="EXO 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 1:15"/>ሞቲን ግብጥ ዴስስቶተ እብሮታ ከኔን ሲፓራፊ ፉሃ ጄዸመኒን አከነ ጄዼ፤ <verse eid="EXO 1:15"/><verse number="16" style="v" sid="EXO 1:16"/>“እስን ዮሙ ዱበርቶተ እብሮታ ደኡምሰረት ገርጋርተኒፊ በርጩመ ደኡምሳረት እሳን አርግተን፣ ዮ ዺረ ተኤ አጄሳ፤ ዮ ዱርበ ታቴሞ ሃጅራቱ ዺሳ።” <verse eid="EXO 1:16"/><verse number="17" style="v" sid="EXO 1:17"/>ዴስስቶትን ሱን ገሩ ዋን ዋቀ ሶዳተኒፍ፣ ዋን ሞቲን ግብጥ እሳንት ህሜ ሰነ ህንጎኔ፤ እጆሌ ዺራስ አከ እሳን ጅራተኒፍ ዺሰን። <verse eid="EXO 1:17"/><verse number="18" style="v" sid="EXO 1:18"/>ሞቲን ግብጥስ ዴስስቶተ ሰነ ኦፍት ዋሜ፣ “እስን ማሊፍ ዋን ከነ ጎተን? ማሊፍስ እጆሌ ዺራ አከ እሳን ጅራተኒፍ ዺፍተን?” ጄዼ እሳን ጋፈቴ።<verse eid="EXO 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 1:19"/>ዴስስቶትን ሱንስ፣ “ዱበርቶትን እብሮታ አከ ዱበርቶተ ወረ ግብጥ ምት፤ እሳን ዋን ጀጀቦ ተአኒፍ ኡቱ ዴስስቶትን እሳን ብረ ህንገእን ደአኒ ነመ ኤጉ” ጄዸኒ ፈረኦኒፍ ዴብሰን።<verse eid="EXO 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 1:20"/>ዋቅንስ ዴስስቶተ ሰናፍ ዋን ጋሪ ጎዼ፤ እስራኤሎንስ ባይአተኒ አከ መሌ ጀባተን። <verse eid="EXO 1:20"/><verse number="21" style="v" sid="EXO 1:21"/>ሰበቢ እሳን ዋቀ ሶዳተኒፍ ዋቅን ዴስስቶተ ሰናፍ ማቲ ኦፊሳኒ ኬኔፍ።<verse eid="EXO 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 1:22"/>ከነረት ፈረኦን፣ “እልመ ዸለቱ ሁንደ ለገ አበያ ኬሰ ቡሳ፤ ዱርብ ሁንድ ገሩ ሃጅራቱ ዺሳ” ጄዼ ሰበሳ ሁንደ አጀጄ።<verse eid="EXO 1:22"/></para>
  <chapter eid="EXO 1"/>
  <chapter number="2" style="c" sid="EXO 2"/>
  <para style="s1">ዸለቹ ሙሴ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 2:1"/>ሰኚ ሌዊ ኬሳ ነምች ቶኮ እንተለ ሌዊ ቶኮ ፉዼ፤ <verse eid="EXO 2:1"/><verse number="2" style="v" sid="EXO 2:2"/>እሼንስ ኡልፎፍቴ እልመ ዴሴ። ዮሙ አከ እን በሬዳ ተኤ አርግቴት ጅአ ሰዲ እሰ ዾክስቴ። <verse eid="EXO 2:2"/><verse number="3" style="v" sid="EXO 2:3"/>ከነ ጫላ እሰ ዾክሱ አከ ህንደንዴኜ ዬሮ ቤክቴት ገሩ ጉቦ ዸላዱራ ሆጄተሜ ቶኮ ፉቴ ሀጴፊ ሌሌ እት ዾብዴ፤ ሙጫ ሰነ ጉቦ ኬሰ ጪብስቴ ቀርቀረ ለገ አበያ ሸምበቆ ኬሰ ኬሴ። <verse eid="EXO 2:3"/><verse number="4" style="v" sid="EXO 2:4"/>ኦቦሌቲንሳሞ ዋን ሙጭቸረ ገኡ እላሉፍ ጄቴ ፈጎ ዻበቻ ቱርቴ።<verse eid="EXO 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 2:5"/>ዬሮ ሰነ እንተል ፈረኦን ዸግነ ዽቀቹፍ ገረ ለገ አበያት ገድ ቡቴ፤ ዱበርቶትን እሼ ተጃጅለንስ ቀርቀረ ለገ ሰናረ አሲፊ አች ዴዴማ ቱረን። እሼንስ ጉቦ ሰነ ሸምበቆ ኬሰት አርግቴ አከ ዸቅጤ ፍዱፍ ገርብቲሼ ኤርግቴ። <verse eid="EXO 2:5"/><verse number="6" style="v" sid="EXO 2:6"/>እሼንስ ጉቦ በንቴ ሙጫ ሰነ አርግቴ፤ ኩኖ ሙጭችስ ቦኣ ቱሬ። እሼንስ ገራ ላፍቴፊ፣ “ኩን ዳእመን እብሮታ ኬሳ ቶኮዸ” ጄቴ።<verse eid="EXO 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 2:7"/>ኦቦሌቲን ሙጭቻስ እንተለ ፈረኦኒን፣ “አከ እሼን ሆስፍቴ ሲፍ ጉድፍቱፍ ዸቄ ዱበርቶተ እብሮታ ኬሳ ጉድፍቱ ቶኮ ሲፍ ዋሙ?” ጄቴ።<verse eid="EXO 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 2:8"/>እሼንስ፣ “ኤዬ፣ ዸቅ” ጄቴን። እንተል ሱንስ ዸቅጤ ሃዸ ሙጫ ሰና ዋምቴ። <verse eid="EXO 2:8"/><verse number="9" style="v" sid="EXO 2:9"/>እንተል ፈረኦንስ ዱበርትቲዻን፣ “ሙጫ ከነ ፉዺ ና ሆስስ፤ አን ምንዳኬ ሲፍን ኬና” ጄቴ። ዱበርቲን ሱንስ ዳእመ ሰነ ፉቴ ሆስፍቴ። <verse eid="EXO 2:9"/><verse number="10" style="v" sid="EXO 2:10"/>ሙጫን ሱን ጉደትናን እሼን እንተለ ፈረኦንት ፍዴ። እንስ እልመሼ ተኤ። እሼንስ፣ “አን ብሻን ኬሳ እሰ ነንባሴ” ጄቹዻን መቃሳ ሙሴ ጄቴ ሞጋፍቴ።<verse eid="EXO 2:10"/></para>
  <para style="s1">ሙሴን ገረ ምድያንት በቀቴ</para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 2:11"/>ሙሴን ኤርገ ጉደቴ ቦዴ ጋፈ ቶኮ ለፈ ሰብንሳ ቱሬ ዸቄ ኡቱ እሳን ሆጂ ደዸብሲሳ ሆጄተኑ አርጌ፤ ኡቱ ነምን ግብጥ ቶኮስ እብሮተ ሰበሳ ኬሳ ነመ ቶኮ ሩኩቱ አርጌ። <verse eid="EXO 2:11"/><verse number="12" style="v" sid="EXO 2:12"/>እንስ አሲፊ አች እላሌ አከ ነምን ቶኮዩ ህንጅሬ ምርከኔፈቴ፤ ነምቸ ግብጥ ሰነ አጄሴ ጭረቸ ኬሰ ዾክሴ። <verse eid="EXO 2:12"/><verse number="13" style="v" sid="EXO 2:13"/>ጉያ እት ኣኑትሞ ገድ በኤ ኡቱ እብሮትን ለመ ወል ሎለኑ አርጌ። እብርቸ በሌሳ ቀቡንስ፣ “አት ማሊፍ እብርቸ አከኬቲ ሩኩተ?” ጄዼ ጋፈቴ።<verse eid="EXO 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 2:14"/>ነምች ሱንስ፣ “ኤኙቱ ኑረት ቡልቻፊ አባ ሙርቲ ስ ጎዼ? አኩመ ነምቸ ግብጥ አጄፍቴ ሰነ አነሌ አጄሱ በርባዳ?” ጄዼን። ከነረት ሙሴን፣ “ዹጉማን ወን አን ሆጄዼ ሱን ቤከሜረ ጄቹዸ” ጄዼ ሶዳቴ።<verse eid="EXO 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 2:15"/>ፈረኦን ዮሙ ዋን ከነ ዸገኤት ሙሴ አጄሱ ያሌ፤ ሙሴን ገሩ ፈረኦን ጀላ ገረ ምድያንት በቀቴ፤ ዮሙ አች ገኤትስ ቦለ ቶኮ ብረ ታኤ። <verse eid="EXO 2:15"/><verse number="16" style="v" sid="EXO 2:16"/>ሉብን ምድያን ቶኮ እንተለን ቶርበ ቀበ ቱሬ፤ እሳንስ ዹፈኒ ቡሻዬ አባሳኒ ኦባሱፍ ብሻን ቡዱቅሰኒ ብድሩት ጉታ ቱረን። <verse eid="EXO 2:16"/><verse number="17" style="v" sid="EXO 2:17"/>ትክሶትንስ ዹፈኒ እሳን አርአን፤ ሙሴን ገሩ ከኤ እሳን ገርጋሬ ቡሻዬሳኒ ኦባሴፍ።<verse eid="EXO 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 2:18"/>ዬሮ ዱበር ሱን ገረ አባሳኒ ሬኡኤልት ዴብአንት፣ እን፣ “እስን ሀርአ አከሚን ደፍተኒ ዴብተን?” ጄዼ እሳን ጋፈቴ።<verse eid="EXO 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 2:19"/>እሳንስ፣ “ነምቸ ግብጥ ቶኮቱ ትክሶተ ጀላ ኑ ባሴ፤ እን ብሻንዩ ኑ ቡዱቅሴ ቡሻዬ ኑፍ ኦባሴ” ጄዸኒ ዴብሰን።<verse eid="EXO 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 2:20"/>እንሞ እንተለንሳቲን፣ “እን ኤሰ ጅረ? እስን ማሊፍ እሰ ዺፍተኒ ዹፍተን? አከ እን ዋ ኛቱፍስ ዸቃቲ ዋማ” ጄዼ።<verse eid="EXO 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 2:21"/>ሙሴንስ ነምቸ ብረ ጅራቹ ጃለቴ፤ ነምችስ እንተለሳ ዝጶራ ሙሴት ሄሩምሲሴ። <verse eid="EXO 2:21"/><verse number="22" style="v" sid="EXO 2:22"/>ሲፓራን እልመ ዴሴ፤ ሙሴንስ፣ “አን አለጋ ተኤ ብየ ኦርማ ጅራዼረ” ጄቹዻን መቃሳ ጌርሾም ጄዼ ሞጋሴ።<verse eid="EXO 2:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 2:23"/>በረ ዼራ ሰነ ኬሰ ሞቲን ግብጥ ንዱኤ። ነሞትን እስራኤልስ ሰበቢ ገርቡማ ኬሰ ቱረኒፍ ንኣደን፤ ንእየንስ፤ እይ እሳን ሰበቢ ገርቡማ ጀለ ቱረኒፍ ገርጋርሰ አርገቹፍ እየንስ ዋቀ ብረ ገኤ። <verse eid="EXO 2:23"/><verse number="24" style="v" sid="EXO 2:24"/>ዋቅንስ ኣዱሳኒ ዸገኤ ከኩሳ ከን አብረሃም፣ ይስሃቂፊ ያቆብ ወጅን ገሌ ሰነ ያደቴ። <verse eid="EXO 2:24"/><verse number="25" style="v" sid="EXO 2:25"/>ዋቅንስ ሰበ እስራኤል እላሌ፤ ዋቅን አከ እሳን እት ጅረን ቤኬ።<verse eid="EXO 2:25"/></para>
  <chapter eid="EXO 2"/>
  <chapter number="3" style="c" sid="EXO 3"/>
  <para style="s1">ሙሴፊ ደገለ ቦበኡ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 3:1"/>ሙሴን ቡሻዬ አባ ኒቲሳ ዬትሮ ሉብቸ ምድያን ሰና ትክሳ ቱሬ፤ እንስ ጋፍ ቶኮ ሀመ ዽአ ለፈ ገሞጂት ቡሻዬ ሰነ ኦፌ ገረ ቱሉ ዋቃ ገረ ኮሬብ ዹፌ። <verse eid="EXO 3:1"/><verse number="2" style="v" sid="EXO 3:2"/>አችትስ ኤርገማን <char style="nd">ዋቀዮ</char> ደገለ ቦበኡ ኬሳ አረበ እብዳ ኬሳን እሰት ሙልአቴ። ሙሴንስ ደገል ሱን ቦበኡሌ አከ ህንጉበትን አርጌ። <verse eid="EXO 3:2"/><verse number="3" style="v" sid="EXO 3:3"/>ሙሴንስ፣ “ደገል ኩን ማሊፍ ህንጉበቱ ላተ? አን እት ጎሬ ዋን ድንቅሲሳ ከነ እላሉ ቀበ” ጄዼ።<verse eid="EXO 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 3:4"/>
    <char style="nd">ዋቀዮስ</char> ዮሙ አከ ሙሴን እላሉፍ አች ጎሬ አርጌት፣ ዋቅን ደገለ ሰነ ኬሳ፣ “ሙሴ! ሙሴ!” ጄዼ እሰ ዋሜ።</para>
  <para style="p" vid="EXO 3:4">ሙሴንስ፣ “ኩኖ አን አሰን ጅረ” ጄዼ ዴብሴ።<verse eid="EXO 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 3:5"/>ዋቅንሞ፣ “አስ ህንዽኣትን፤ ሰበቢ እዶን አት ዻበቱ ኩን ቁልቁሉ ተኤፍ ኮጴኬ ባፈዹ” ጄዼን። <verse eid="EXO 3:5"/><verse number="6" style="v" sid="EXO 3:6"/>እት ፉፌስ፣ “አን ዋቀ አባኬቲ፣ ዋቀ አብረሃም፣ ዋቀ ይስሃቂፊ ዋቀ ያቆብ” ጄዼ። ከነረት ሙሴን ዋቀ እላሉ ዋን ሶዳቴፍ ፉለሳ ዾክፈቴ።<verse eid="EXO 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 3:7"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዼ፤ “አን ዹጉማን ዽጵነ ሰበኮ ወረ ግብጥ ኬሰ ጅራተንረ ገኡ አርጌረ። እየ እሳን ወረ ሁምናን እሳን ሆጄቺሰን ጀላ በኡፍ እየንስ ዸገኤረ፤ አን ረክነሳኒስ ነንቤከ። <verse eid="EXO 3:7"/><verse number="8" style="v" sid="EXO 3:8"/>ከናፉ አን ሀርከ ወረ ግብጢቲ እሳን ባሴ ገረ ብየ ጋሪፊ በልኣት፣ ብየ ኣነኒፊ ደም ኬሳ ቡርቁት ጄቹንስ ገረ ብየ ከነኣኖታት፣ ሄቶታት፣ አሞሮታት፣ ፌርዞታት፣ ሂዎታቲፊ ዬቡሶታት ኦል እሳን ባሱፍ ጄዼ ገድ ቡኤረ። <verse eid="EXO 3:8"/><verse number="9" style="v" sid="EXO 3:9"/>አመ ኩኖ እይ እስራኤሎታ ነ ብረ ገኤረ። አን ሃለ እት ወር ግብጥ እሳን ጩንቁርሰንስ አርጌረ። <verse eid="EXO 3:9"/><verse number="10" style="v" sid="EXO 3:10"/>ከናፉ አት አመ ዸቅ። አን አከ አት ሰበኮ እስራኤሎተ ግብጥ ኬሳ ባፍቱፍ ፈረኦንት ስን ኤርገ።”<verse eid="EXO 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 3:11"/>ሙሴን ገሩ ዋቃን፣ “ፈረኦን ብረ ዸቄ ግብጢ እስራኤሎተ ባሱፍ አን ኤኙ?” ጄዼ።<verse eid="EXO 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 3:12"/>ዋቅንስ አከነ ጄዼ፤ “አን ስ ወጅን ነንተአ። አት ሰበ ሰነ ግብጢ ዮሙ ባፍቱት እስን ቱሉ ከነረት ዋቀ ዋቄፈቱ። ስ ኤርጉኮቲፍስ ኩን መለቶ ሲፍ ተአ።”<verse eid="EXO 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 3:13"/>ሙሴንሞ ዋቃን፣ “ኩኖ አን ገረ እስራኤሎታ ዸቄ፣ ‘ዋቅን አባኬሰኒ ነ ኤርጌረ’ ዮሙን ጄዹት ዮ እሳን፣ ‘መቃንሳ ኤኙ?’ ጄዸኒ ነ ጋፈተን፣ አን ማል ጄዼን እሳንት ህመ?” ጄዼ።<verse eid="EXO 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 3:14"/>ዋቅንስ ሙሴዻን፣ “<char style="nd">አን አኑመ</char>፤ አት ሰበ እስራኤሊን፣ ‘እን <char style="nd">አን አኑመ</char> ጄዹ ሱን ገረኬሰንት ነ ኤርጌረ’ ጄዽ” ጄዼን።<verse eid="EXO 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 3:15"/>ዋቅን አመስ ሙሴዻን አከነ ጄዼ፤ “እስራኤሎታን አከነ ጄዽ፤ ‘<char style="nd">ዋቀዮ</char> ዋቅን አቦቲኬሰኒ፣ ዋቅን አብረሃም፣ ዋቅን ይስሃቅ፣ ዋቅን ያቆብ እስንት ነ ኤርጌረ።’</para>
  <para style="q1" vid="EXO 3:15">“መቃን ኩን በረ በራን መቃኮት፤</para>
  <para style="q2" vid="EXO 3:15">መቃ አን ዸሎታ ሀመ ዸሎታት</para>
  <para style="q2" vid="EXO 3:15">እቲን ያደተሙዸ።<verse eid="EXO 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 3:16"/>“ዸቂ ማንጉዶተ እስራኤል ወልት ቀቢቲ አከነ ጄዺን፤ ‘<char style="nd">ዋቀዮ</char> ዋቅን አቦቲኬሰኒ፣ ዋቅን አብረሃም፣ ከን ይስሃቂፊ ከን ያቆብ ነት ሙልአቴ አከነ ጄዼ፦ “አን እስን እላሌረ፤ ዋን ግብጥት እስንረ ገኤስ አርጌረ። <verse eid="EXO 3:16"/><verse number="17" style="v" sid="EXO 3:17"/>ከናፉ አን ረክነ ግብጥ ኬሳ እስን ባሴ ብየ ኣነኒፊ ደም ኬሳ ቡርቁ ጄቹንስ ብየ ከነኣኖታ፣ ሄቶታ፣ አሞሮታ፣ ፌርዞታ፣ ሂዎታቲፊ ብየ ዬቡሶታት እስን ጌሱፍ ሙርቴሴረ።” ’<verse eid="EXO 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 3:18"/>“ማንጉዶትን እስራኤል ስ ዸገኡ። አቲፊ ማንጉዶትን እስራኤል ሞቲ ግብጥ ብረ ዸቅጠኒ፣ ‘<char style="nd">ዋቀዮ</char> ዋቅን እብሮታ ኑት ሙልአቴረ፤ ኤጋ አመ አከ ኑ <char style="nd">ዋቀዮ</char> ዋቀኬኛፍ ኣርሳ ዽኤስኑፍ ገረ ገሞጂት ከራ ጉያ ሰዲ ኑ ኤየም’ ጄቱን። <verse eid="EXO 3:18"/><verse number="19" style="v" sid="EXO 3:19"/>ገሩ አከ ሞቲን ግብጥ ዮ እሬን ጀባን እሰ ድርቅሲሴ መሌ ዴሙፍ እስኒ ህንኤየምኔ አኑ ቤከ። <verse eid="EXO 3:19"/><verse number="20" style="v" sid="EXO 3:20"/>አን ድንቂ እሳን ግዱት ሆጄዹ ሁንዳን እሬኮ ሂጠዼ ነሞተ ግብጥ ነንዸአ። ኤርገሲ እን አከ ዴምተን እስኒፍ ኤየመ።<verse eid="EXO 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 3:21"/>“አንስ አከ ሰብን ኩን ፉለ ወረ ግብጥ ዱረት ሱራ አርገቱ ነንጎዸ፤ እስንስ ዮሙ ግብጢ ባተንት ሀርከ ዱዋ ህንባተን። <verse eid="EXO 3:21"/><verse number="22" style="v" sid="EXO 3:22"/>ቶኮን ቶኮን ዱበርቲ ምአ ሜቲ፣ ምአ ወርቄቲፊ ኡፈተ ጋፈቴ ኦላሼቲፊ ዱበርቲ መነሼ ጅራቱራ ሃፉዸቱ፤ ከናንስ እልማኒፊ እንተለንኬሰንት ኡፍፍቱ። አከሲንስ ቀቤኘ ወረ ግብጥ ቦጅተኒ ባቱ።”<verse eid="EXO 3:22"/></para>
  <chapter eid="EXO 3"/>
  <chapter number="4" style="c" sid="EXO 4"/>
  <para style="s1">መለቶ ሙሴዻፍ ኬነሜ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 4:1"/>ሙሴን፣ “ዮ እሳን፣ ‘<char style="nd">ዋቀዮ</char> ስት ህንሙልአትኔ’ ጄዸኒ ነ አመኑ ዮካን ነ ዸገኡ ድደንሆ?” ጄዼ ዴብሴ።<verse eid="EXO 4:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 4:2"/>ከነረት <char style="nd">ዋቀዮ</char>፣ “ወንት ሀርከኬ ኬሰ ጅሩ ሱን ማል?” ጄዼን።</para>
  <para style="p" vid="EXO 4:2">ሙሴንሞ፣ “ኡሌዸ” ጄዼ ዴብሴ።<verse eid="EXO 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 4:3"/>
    <char style="nd">ዋቀዮስ</char>፣ “ለፈ ቡስ” ጄዼን።</para>
  <para style="p" vid="EXO 4:3">ሙሴን ለፈ ቡፍናን ኡሌን ሱን ቦፈ ተኤ፤ እንስ እራ በቀቴ። <verse eid="EXO 4:3"/><verse number="4" style="v" sid="EXO 4:4"/><char style="nd">ዋቀዮ</char> ገሩ ሙሴዻን፣ “ሀርከኬ ሂጠዹቲ ኤጌሳ ቀብ” ጄዼ። ሙሴንስ ሂጠቴ ቦፈ ሰነ ቀቤ፤ ቦፍት ሱንስ ሀርከሳ ኬሰት ዴብኤ ኡሌ ተኤ። <verse eid="EXO 4:4"/><verse number="5" style="v" sid="EXO 4:5"/><char style="nd">ዋቀዮስ</char>፣ “ኩን አከ እሳን <char style="nd">ዋቀዮ</char> ዋቅን አቦቲሳኒ፣ ዋቅን አብረሃም፣ ዋቅን ይስሃቅ፣ ዋቅን ያቆብ ስት ሙልአቴ አከ አመነኒፍ” ጄዼ።<verse eid="EXO 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 4:6"/>
    <char style="nd">ዋቀዮስ</char> ሙሴዻን፣ “ሀርከኬ ቦባኬ ኬሰ ካአዹ” ጄዼ። ሙሴንስ ሀርከሳ ቦባሳ ኬሰ ካአቴ፤ ዮሙ እን ባፈቴትስ፣ ኩኖ ሀርክሳ ለምጢ አከ ጨቢ ተኤ።<verse eid="EXO 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 4:7"/>እንስ ሙሴዻን፣ “ሀርከኬ ዴብሲ ቦባኬ ኬሰ ካአዹ” ጄዼ፤ ሙሴንስ ዴብሴ ሀርከሳ ቦባሳ ኬሰ ካአቴ፤ ዮሙ እን ባፈቴትስ፣ ኩኖ ሀርክሳ ዴብኤ አኩመ ዸግነሳ እሰ ካኒ ተኤ።<verse eid="EXO 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 4:8"/>
    <char style="nd">ዋቀዮስ</char> አከነ ጄዼ፤ “እሳን ዮ ስ አመኑ ባተኒ መለቶ እሰ ጀልቀባ ፉዸቹ ድደን መለቶ ለመፋ ንአመኑ ተአ። <verse eid="EXO 4:8"/><verse number="9" style="v" sid="EXO 4:9"/>ዮ እሳን መለቶ ከነ ለማን አመኑ ባተኒ ስ ዸገኡ ድደን ብሻን ለገ አበያ ቡዱቅሲቲ ለፈ ጎጋረት ዸንገላስ። ብሻን አት ለግቸራ ቡዱቅስቴ ሱንስ ለፈ ጎጋረት ዺገ ተአ።”<verse eid="EXO 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 4:10"/>ሙሴንስ <char style="nd">ዋቀዮን</char>፣ “ያ ጎፍታ፣ አን ዱርስ ተኡ ዮካን ኤርገ አት ገርብቸኬት ዱበቹ ጀልቀብዴ አስ ነመ አረበ ቀጄሉ ምት። አን ነመ አፋንሳ ህዸሜ አረብንሳስ እት ኡልፋቱዸ” ጄዼ።<verse eid="EXO 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 4:11"/>
    <char style="nd">ዋቀዮስ</char> አከነ እሳን ጄዼ፤ “ከን አፋን ነማ ኡሜ ኤኙ? ከን አከ ነምን አረብ-ድዳ ተኡ ዮካን ዱዱ ጎዹ ኤኙ? ከን አገርቱ እጃ ነማፍ ኬኑ ዮካን ጃምሱ ኤኙ? አኑመ <char style="nd">ዋቀዮ</char> ምቲ? <verse eid="EXO 4:11"/><verse number="12" style="v" sid="EXO 4:12"/>አመ ዸቅ፤ አን አፋንኬ ወጅን ነንተአ፤ ዋን አት ጄቱስ ስን በርሲሰ።”<verse eid="EXO 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 4:13"/>ሙሴን ገሩ፣ “ያ ጎፍታ፣ ማሎ ነመ ብራ ኤርግ” ጄዼ።<verse eid="EXO 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 4:14"/>ዼከምስ <char style="nd">ዋቀዮስ</char> ሙሴረት ቦበኤ፤ እንስ አከነ ጄዼ፤ “ኦቦሌስኬ አሮን ሌዊች ጅረ ምቲ? አን አከ እን አከ ጋሪት ዱበቱ ነንቤከ። ኩኖ፣ እን ገረኬ ዹፉት ጅረ። እን ዮሙ ስ አርጉት ንገመደ። <verse eid="EXO 4:14"/><verse number="15" style="v" sid="EXO 4:15"/>አት እሰት ዱበቴ አፋንሳ ኬሰ ዱቢ ንኬሰ፤ አንስ አፋንኬቲፊ አፋንሳ ወጅን ነንተአ፤ ዋን እስን ሆጄተንስ እስን ነንበርሲሰ። <verse eid="EXO 4:15"/><verse number="16" style="v" sid="EXO 4:16"/>እን ኡመተት ሲፍ ዱበተ፤ እን አፋን ሲፍ ተአ፤ አትሞ እሳፍ አከ ዋቃ ንታተ። <verse eid="EXO 4:16"/><verse number="17" style="v" sid="EXO 4:17"/>አት ኡሌ እቲን መለቶ አርግሲፍቱ ከነ ሀርከት ቀበዹ።”<verse eid="EXO 4:17"/></para>
  <para style="s1">ሙሴን ግብጥት ዴብኤ</para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 4:18"/>ሙሴን ገረ አባ ኒቲሳ ገረ ዬትሮት ዴብኤ፣ “አከ አን ገረ ሰበኮ ወረ ግብጥ ጅራተንት ዴብኤ ሀመ አማት ሉቡን ጅራቹሳኒ አርጉፍ ማሎ ና ኤየም” ጄዼን።</para>
  <para style="p" vid="EXO 4:18">ዮቶርስ፣ “ነጋን ዸቅ” ጄዼን።<verse eid="EXO 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 4:19"/>
    <char style="nd">ዋቀዮ</char> ምድያንት ሙሴዻን፣ “ነሞትን ስ አጄሱ በርባደን ሁንድ ዱአኒሩቲ ግብጥት ዴብእ” ጄዼ ቱሬ። <verse eid="EXO 4:19"/><verse number="20" style="v" sid="EXO 4:20"/>ከናፉ ሙሴን ኒቲሳቲፊ እልማንሳ ፉዸቴ ሀሬረ ካኤ ግብጥት ዴብኤ። እንስ ኡሌ ዋቃ ሀርከት ቀበቴ ቱሬ።<verse eid="EXO 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 4:21"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ “አት ዬሮ ግብጥት ዴብቱት ድንቂወን አን አከ አት ሆጄቱፍ ሁምነ ሲፍ ኬኔ ሰነ ሁንደ ፉለ ፈረኦን ዱረት ሆጄዹ። አን ገሩ አከ እን ሰበ ሰነ ገድ ህንለክፍኔ መተ ጀቤሰ እሰ ነንጎዸ። <verse eid="EXO 4:21"/><verse number="22" style="v" sid="EXO 4:22"/>አት ፈረኦኒን አከነ ጄዽ፤ ‘<char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ እስራኤል እልመኮ ሀንገፈ፤ <verse eid="EXO 4:22"/><verse number="23" style="v" sid="EXO 4:23"/>አንስ፣ “አከ እልምኮ ነ ተጃጅሉፍ ገድ ለክስ” ጄዼ ስት ህሜረ። አት ገሩ እሰ ገድ ለክሱ ድዴ፤ ከናፉ፣ ኩኖ አን እልመኬ ሀንገፈ ነንአጄሰ።’ ”<verse eid="EXO 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 4:24"/>
    <char style="nd">ዋቀዮ</char> ከራረት እዶ ቡልቲት ሙሴት ዹፌ እሰ አጄሱ በርባዴ። <verse eid="EXO 4:24"/><verse number="25" style="v" sid="EXO 4:25"/>ዝጶራ ገሩ ዸጋ ቀረ ቀቡ ፉዸቴ ቆለ ዸግነ እልመሼ ኩቴ እቲን ሚለ ሙሴ ቱቅጤ። እሼንስ፣ “አት ዹጉማን አናፍ ምስርቸ ዺጋት” ጄቴ። <verse eid="EXO 4:25"/><verse number="26" style="v" sid="EXO 4:26"/><char style="nd">ዋቀዮስ</char> እሰ ዺሴ። ዬሮ ሰነ እሼን ዋኤ ዸግነ ቀባቲፍ፣ “ምስርቸ ዺጋት” ጄቴ።<verse eid="EXO 4:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 4:27"/>
    <char style="nd">ዋቀዮስ</char> አሮኒን፣ “አት ሙሴ ስመቹፍ ገረ ገሞጂ ዸቅ!” ጄዼ። እንስ ዸቄ ቱሉ ዋቃረት ሙሴ አርገቴ እሰ ዹንገቴ። <verse eid="EXO 4:27"/><verse number="28" style="v" sid="EXO 4:28"/>ዬሮ ሰነ ሙሴን ዱቢ <char style="nd">ዋቀዮ</char> አከ እን ዱበቱፍ እሰ ኤርጌ ሁንዳፊ መለቶወን አከ እን ሆጄቱፍ እሰ አጀጄ ሁንደ አሮንት ህሜ።<verse eid="EXO 4:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 4:29"/>ሙሴፊ አሮን ማንጉዶተ እስራኤል ሁንደ ወልት ቀበን፤ <verse eid="EXO 4:29"/><verse number="30" style="v" sid="EXO 4:30"/>አሮንስ ዋን <char style="nd">ዋቀዮ</char> ሙሴት ህሜ ሁንደ ጀረት ህሜ። መለቶወንስ ፉለ ነሞታ ዱረት ሆጄቴ፤ <verse eid="EXO 4:30"/><verse number="31" style="v" sid="EXO 4:31"/>እሳንስ ንአመነን። ጀርስ ዮሙ አከ <char style="nd">ዋቀዮ</char> ሰበ እስራኤል እላሌፊ አከ እን ረክነሳኒስ አርጌ ዸገአንት ገድ ጄዸኒ ሰገደን።<verse eid="EXO 4:31"/></para>
  <chapter eid="EXO 4"/>
  <chapter number="5" style="c" sid="EXO 5"/>
  <para style="s1">ጡቢ ጭዲ ህንቀብኔ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 5:1"/>ኤርገሲ ሙሴፊ አሮን ፈረኦን ብረ ዸቀኒ፣ “<char style="nd">ዋቀዮ</char> ዋቅን እስራኤል አከነ ጄዸ፤ ‘አከ እን ገሞጂት አያነ ና አያኔሱፍ ሰበኮ ገድ ዺስ።’ ”<verse eid="EXO 5:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 5:2"/>ፈረኦንሞ፣ “አከ አን እሳፍ አጀጀሜ እስራኤልን ገድ ዺሱፍ <char style="nd">ዋቀዮ</char> ኩን ኤኙ? አን <char style="nd">ዋቀዮ</char> ሰነ ህንቤኩ፤ እስራኤልንስ ገድ ህንዺሱ” ጄዼ።<verse eid="EXO 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 5:3"/>እሳንስ አከነ ጄዸን፤ “ዋቅን እብሮታ ኑት ዹፌረ። አከ ኑ <char style="nd">ዋቀዮ</char> ዋቀኬኛፍ ኣርሳ ዽኤስኑፍ ገረ ገሞጂት ከራ ጉያ ሰዲ ኑ ኤየም፤ አከስ ተኡ ባናን እን ዸእቻን ዮካን ጎራዴዻን ኑ ዸአ።”<verse eid="EXO 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 5:4"/>ሞቲን ግብጥ ገሩ፣ “ያ ሙሴፊ አሮን፣ እስን ማሊፍ ሰበ ከነ ሆጂ ዾውቱ? ሆጂኬሰንት ዴብኣ!” እሳኒን ጄዼ። <verse eid="EXO 5:4"/><verse number="5" style="v" sid="EXO 5:5"/>ፈረኦንስ እቱመ ፉፌ፣ “ኩኖ ሰብን ብየቲ አመ ባይአቴረ፤ እስንሞ ሆጂ እሳን ዾዋ ጅርቱ” ጄዼ።<verse eid="EXO 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 5:6"/>ጉዩመ ሰነ ፈረኦን አከነ ጄዼ እት ጋፈተምቶተ ሆጂቲፊ ቆንዳልቶተ ሰባ አጀጄ፤ <verse eid="EXO 5:6"/><verse number="7" style="v" sid="EXO 5:7"/>“ስአች ጡቢ ሆጄቹዻፍ ሰበ ከናፍ ጭዲ ህንኬንና፤ እሳን ኦፉመሳኒቲ ዸቀኒ ጭዲ ሃበርባደተን። <verse eid="EXO 5:7"/><verse number="8" style="v" sid="EXO 5:8"/>ገሩ አከ እሳን ለኮብሰ ጡቢ ከን ዱራን ሆጄቻ ቱረን ሰነ ሆጄተን ጎዻ፤ ሀመ እሳንት ረመደሜ ህንህርእስና። እሳን ዽባኦዸ፤ ከናፉ፣ ‘ኑ ዸቅኔ ዋቀኬኛፍ ኣርሳ ዽኤስነ’ ጄዸኒ እያ ጅሩ። <verse eid="EXO 5:8"/><verse number="9" style="v" sid="EXO 5:9"/>አከ እሳን ሆጂዻን ቀበመኒ ዱቢ ሶባቲፍ ጥዬፈኖ ህንኬንኔፍ ሆጂ እሳንት ጭምሳ።”<verse eid="EXO 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 5:10"/>እት ጋፈተምቶትን ሆጂቲፊ ቆንዳልቶትን ሰባ ገድ ያአኒ ሰበ ሰናን አከነ ጄዸን፤ “ፈረኦን አከነ ጄዸ፦ ‘አን ስአች ጭዲ እስኒ ህንኬኑ። <verse eid="EXO 5:10"/><verse number="11" style="v" sid="EXO 5:11"/>ለፈ እት አርገቹ ደንዴሰን ዸቃቲ ኦፊኬሰኒ ጭዲ በርባደዻ፤ ሆጂንኬሰን ገሩ ጎንኩማ ህንህርአቱ።’ ” <verse eid="EXO 5:11"/><verse number="12" style="v" sid="EXO 5:12"/>ሰብን ሱን ቆደ ጭዲ፣ ሃፈ ወልት ቀበቹፍ ጄዼ ብየ ግብጢ ጉቱ ኬሰ ፈፈጨኤ። <verse eid="EXO 5:12"/><verse number="13" style="v" sid="EXO 5:13"/>እት ጋፈተምቶትን ሱንስ፣ “እስን ሆጂኬሰን ከን ጉያ ጉያ አኩመ ዬሮ ጭዲን ቱሬ ሰናት ሆጄዻ ራወዻ” ጄዸኒ እሳን ጀርጀርሳ ቱረን። <verse eid="EXO 5:13"/><verse number="14" style="v" sid="EXO 5:14"/>እስራኤሎትን ቆንዳልቶተ ሆጂ ተአን ከኔን እት ጋፈተምቶተ ገርቦተ ፈረኦኒን ሙደመንስ ሬበመኒ፣ “እስን ከሌሳፊ ሀርአ ማሊፍ ቆደ ጡቢ ከን አከ ሆጄተኒፍ እስኒ ረመደሜ ሰነ አኩመ ዱሪት ህንጉተትኔ?” ጄዸመኒ ጋፈተማ ቱረን።<verse eid="EXO 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 5:15"/>እስራኤሎትን ቶአቶተ ሆጂ ተአንስ ዸቀኒ አከነ ጄዸኒ ፈረኦንት እየተን፤ “አት ማሊፍ ተጃጅልቶተኬ አከስ ጎተ? <verse eid="EXO 5:15"/><verse number="16" style="v" sid="EXO 5:16"/>ጭዲን ተጃጅልቶተኬቲፍ ህንኬነሙ፤ ተኡስ፣ ‘ጡቢ ሆጄዻ!’ ኑን ጄዸን። ኩኖ ተጃጅልቶትንኬ ሬበማ ጅሩ፤ በሌሳን ገሩ ከኑመ ሰበኬቲት።”<verse eid="EXO 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 5:17"/>ፈረኦንስ አከነ ጄዼ፤ “እስን ዽባኦዸ፤ እስን ዽባኦዸ! ከናፉ እስን፣ ‘ኑ ዸቅኔ <char style="nd">ዋቀዮፍ</char> ኣርሳ ዽኤስነ’ ጄተን። <verse eid="EXO 5:17"/><verse number="18" style="v" sid="EXO 5:18"/>አመ ዸቃቲ ሆጄዻ፤ ጭዲን እስኒፍ ህንኬነሙ፤ ገሩ ጡቢ እስንት ረመደሜ ሆጄተኒ ጉቱ ቀብዱ።”<verse eid="EXO 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 5:19"/>እስራኤሎትን ቶአቶተ ሆጂ ተአን ዮሙ፣ “እስን ለኮብሰ ጡቢ ከን ጉያ ጉያት አከ ሆጄተኒፍ እስንራ ኤገሙ ሰነ ህርእሱ ህንቀብደን” ጄዸሜ እሳንት ህመሜት አከ ረክነ ኬሰ ሴነን ሁበተን። <verse eid="EXO 5:19"/><verse number="20" style="v" sid="EXO 5:20"/>ዬሮ ፈረኦን ብራ ገድ በአንት ኡቱ ሙሴፊ አሮን እሳን ኤገኑ አርገተን፤ <verse eid="EXO 5:20"/><verse number="21" style="v" sid="EXO 5:21"/>እሳንስ፣ “ዋን እስን አከ ፈረኦኒፊ ቆንዳልቶትንሳ ኑ ጥሬፈተን ጎተኒ አከ እሳን ኑ አጄሰኒፍ ጎራዴ ሀርከሳኒ ኬሰኬሰኒፍ <char style="nd">ዋቀዮ</char> እስንት ሃእላሉ፤ እስንት ሃሙሩስ!” ጄዸን።<verse eid="EXO 5:21"/></para>
  <para style="s1">ዋቅን ፉረመ አብደቺሴ</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 5:22"/>ሙሴን ገረ <char style="nd">ዋቀዮት</char> ዴብኤ አከነ ጄዼ፤ “ያ ጎፍታ፣ አት ማሊፍ ሰበ ከነት ረክነ ፍዴ? አት ከናፍ ነ ኤርግቴ? <verse eid="EXO 5:22"/><verse number="23" style="v" sid="EXO 5:23"/>ጋፈ አን መቃኬቲን ዱበቹፍ ፈረኦን ብረ ዸቄ ጀልቀቤ እን ሰበኬት ረክኑመ ፍዳ ጅረ፤ አት ገሩ ጎንኩማ ሰበኬ ህንፉሬ።”<verse eid="EXO 5:23"/></para>
  <chapter eid="EXO 5"/>
  <chapter number="6" style="c" sid="EXO 6"/>
  <para style="p">
    <verse number="1" style="v" sid="EXO 6:1"/>
    <char style="nd">ዋቀዮስ</char> ሙሴዻን፣ “አመ ዋን አን ፈረኦንረት ሆጄዹ አት ንአርግተ፦ ሰበቢ እሬኮ ጀባ ሰናቲፍ ሞትች ገድ እሳን ዺሰ፤ ሰበቢ እሬኮ ጀባ ሰናቲፍስ ሞትች ብየሳ ኬሳ እሳን አርአ” ጄዼ።<verse eid="EXO 6:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 6:2"/>ዋቅን አመስ ሙሴዻን አከነ ጄዼ፤ “አን <char style="nd">ዋቀዮ</char>። <verse eid="EXO 6:2"/><verse number="3" style="v" sid="EXO 6:3"/>አን አከ ዋቀ ዋን ሁንደ ደንደኡተን አብረሃምት፣ ይስሃቅቲፊ ያቆብት ሙልአዼ፤ ገሩ መቃኮ <char style="nd">ዋቀዮን</char> እሳንት ኦፍ ህንቤክስፍኔ። <verse eid="EXO 6:3"/><verse number="4" style="v" sid="EXO 6:4"/>አከሱመስ አን ብየ ከነኣን ለፈ እሳን አከ አለጋት ኬሰ ጅራተን ሰነ እሳኒ ኬኑፍ ጄዼ እሳን ወጅን ከኩ ገሌረ። <verse eid="EXO 6:4"/><verse number="5" style="v" sid="EXO 6:5"/>ከነረትስ፣ አን ኣዱ ሰበ እስራኤል ከኔን ወረ ግብጢን ገርቦምፈመን ሰና ዸገኤ ከኩኮ ያደዼረ።<verse eid="EXO 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 6:6"/>“ከናፉ ሰበ እስራኤሊን አከነ ጄዽ፦ ‘አን <char style="nd">ዋቀዮ</char>፤ ዋንጆ ወረ ግብጥ ጀላ እስን ነንባሰ፤ አን ገርቡማሳኒ ጀላ እስን ነንባሰ፤ እሬ ድሪራፊ ሙርቲ ጀባዻንስ እስን ነንፉረ። <verse eid="EXO 6:6"/><verse number="7" style="v" sid="EXO 6:7"/>አን አከ ሰበ ኦፊኮት እስን ፉዸዸ፤ ዋቀኬሰን ነንተአ። ዬሮ ሰነ እስን አከ አን <char style="nd">ዋቀዮ</char> ዋቀኬሰን ከን ዋንጆ ወረ ግብጥ ጀላ እስን ባሴ ተኤ ንቤክቱ። <verse eid="EXO 6:7"/><verse number="8" style="v" sid="EXO 6:8"/>አን ብየ እሰን አብረሃሚፍ፣ ይስሃቂፊ ያቆቢፍ ኬኑፍ ሀርከኮ ኦል ቀበዼ ከከዼ ሰነት እስን ነንገልቸ። ዻለ ጎዼስ እስኒፍ ኬነ። አን <char style="nd">ዋቀዮ</char>።’ ”<verse eid="EXO 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 6:9"/>ሙሴንስ ዋን ከነ ሰበ እስራኤልት ህሜ፤ እሳን ገሩ ዋን አብዲ ኩተተኒፊ ገርቡማ ሀማ ኬሰ ቱረኒፍ እሰ ህንዸጌኜ።<verse eid="EXO 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 6:10"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ <verse eid="EXO 6:10"/><verse number="11" style="v" sid="EXO 6:11"/>“ዸቂቲ አከ እን ብየሳ ኬሳ እስራኤሎተ ገድ ለክሱፍ ፈረኦን ሞትቸ ግብጥት ህም።”<verse eid="EXO 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 6:12"/>ሙሴን ገሩ <char style="nd">ዋቀዮን</char>፣ “ኩኖ እስራኤሎትን ነ ህንዸጌኜ፤ ዮስ ፈረኦን አከምት ነ ዸገአሬ? አፋንኮ ቀጄልቼ ህንዱበተቱቲ” ጄዼ።<verse eid="EXO 6:12"/></para>
  <para style="s1">ህደ ዸሎተ ሙሴፊ አሮን</para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 6:13"/>
    <char style="nd">ዋቀዮ</char> ገሩ ዋኤ እስራኤሎታቲፊ ዋኤ ፈረኦን ሞትቸ ግብጥ ሙሴፊ አሮንት ዱበቴ አከ እሳን ሰበ እስራኤል ግብጢ ባሰን እሳን አጀጄ።<verse eid="EXO 6:13"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="14" style="v" sid="EXO 6:14"/>ሀንገፎትን በልበለወንሳኒ ከኔኒዸ፦</para>
  <para style="b" vid="EXO 6:14"/>
  <para style="li1" vid="EXO 6:14">እልማን ሩቤን እልመ እስራኤል ሀንገፍትቻ፦</para>
  <para style="li2" vid="EXO 6:14">ሄኖክ፣ ፈሉስ፣ ሄዝሮኒፊ ከርሚ።</para>
  <para style="lf" vid="EXO 6:14">ወር ኩኔን ጎሶተ ሩቤን።<verse eid="EXO 6:14"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="15" style="v" sid="EXO 6:15"/>እልማን ስምኦን፦</para>
  <para style="li2" vid="EXO 6:15">ዬሙኤል፣ ያሚን፣ ኦሀድ፣ ያኪን፣ ዞሀር፣ ሻዉል እልመ ዱበርትቲ ከነኣን።</para>
  <para style="lf" vid="EXO 6:15">እሳን ኩኔን ማቲወን ስምኦን።<verse eid="EXO 6:15"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="16" style="v" sid="EXO 6:16"/>መቃን እልማን ሌዊስ አኩመ ዸሎተሳኒት ከናዸ፦</para>
  <para style="li2" vid="EXO 6:16">ጌርሾን፣ ቆሃቲፊ ሜራሪ።</para>
  <para style="lf" vid="EXO 6:16">ሌዊን ወጋ 137 ጅራቴ።<verse eid="EXO 6:16"/></para>
  <para style="li2">
    <verse number="17" style="v" sid="EXO 6:17"/>እልማን ጌርሾን አኩመ ማቲሳኒት፦</para>
  <para style="li3" vid="EXO 6:17">ሎቤኒፊ ሽሜኢ።<verse eid="EXO 6:17"/></para>
  <para style="li2">
    <verse number="18" style="v" sid="EXO 6:18"/>እልማን ቆሃት፦</para>
  <para style="li3" vid="EXO 6:18">አምራም፣ ይዝሃር፣ ኬብሮኒፊ ኡዚኤል።</para>
  <para style="li2" vid="EXO 6:18">ቆሃት ወጋ 133 ጅራቴ።<verse eid="EXO 6:18"/></para>
  <para style="li2">
    <verse number="19" style="v" sid="EXO 6:19"/>እልማን ሜራሪ፦</para>
  <para style="li3" vid="EXO 6:19">መህሊፊ ሙሲ።</para>
  <para style="lf" vid="EXO 6:19">እሳን ኩኔንስ አኩመ ዸሎተሳኒት ማቲወን ሌዊት።<verse eid="EXO 6:19"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="20" style="v" sid="EXO 6:20"/>አምራም ኦቦሌቲ አባሳ ዮኬቤድን ፉዼ፤ እሼንስ አሮኒፊ ሙሴ ዴሴፍ።</para>
  <para style="lf" vid="EXO 6:20">(አምራም ወጋ 137 ጅራቴ።)<verse eid="EXO 6:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="EXO 6:21"/>እልማን ይዝሃር፦</para>
  <para style="li2" vid="EXO 6:21">ቆራህ፣ ናፌጊፊ ዝክሪ።<verse eid="EXO 6:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="EXO 6:22"/>እልማን ኡዚኤል፦</para>
  <para style="li2" vid="EXO 6:22">ሚሻኤል፣ ኤልዛፋኒፊ ስትሪ።<verse eid="EXO 6:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="EXO 6:23"/>አሮን እንተለ አሚናዳብ ኦቦሌቲ ነህሾን ኤሊሼባ ፉዼ፤ እሼንስ ናዳብ፣ አቢሁ፣ ኤሌኣዛሪፊ ኢታማርን ዴሴፍ።<verse eid="EXO 6:23"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="24" style="v" sid="EXO 6:24"/>እልማን ቆራህ፦</para>
  <para style="li2" vid="EXO 6:24">አሲር፣ ኤልቃናፊ አቢኣሳፍ።</para>
  <para style="lf" vid="EXO 6:24">እሳን ኩኔንስ ማቲወን ቆራሂት።<verse eid="EXO 6:24"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="25" style="v" sid="EXO 6:25"/>ኤሌኣዛር እልም አሮን እንተለን ፉትኤል ኬሳ ቶኮ ፉዼ፤ እሼንስ ፊኔሃስን ዴሴፍ።</para>
  <para style="b" vid="EXO 6:25"/>
  <para style="lf" vid="EXO 6:25">እሳን ኩኔንስ አኩመ ማቲወንሳኒት ሀንገፎተ በልበለ ሌዊት።<verse eid="EXO 6:25"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="26" style="v" sid="EXO 6:26"/>አሮኒፊ ሙሴን ወር <char style="nd">ዋቀዮ</char>፣ “እስን አኩመ ኩታ ኩታሳኒት ግብጥ ኬሳ እስራኤሎተ ባሳ” ጄዼን ሱን እሳኑመ ከነ። <verse eid="EXO 6:26"/><verse number="27" style="v" sid="EXO 6:27"/>እሳንስ ወረ ዋኤ ግብጥ ኬሳ እስራኤሎተ ባሱ ፈረኦን ሞትቸ ግብጥት ዱበተን ሰናዸ። ሙሴፊ አሮን እሳኑመ ከነ።<verse eid="EXO 6:27"/></para>
  <para style="s1">አሮን ቆደ ሙሴ ዱበቹሳ</para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 6:28"/>
    <char style="nd">ዋቀዮ</char> ዬሮ ግብጥ ኬሰት ሙሴት ዱበቴ ሰነ <verse eid="EXO 6:28"/><verse number="29" style="v" sid="EXO 6:29"/>አከነ ጄዼን፤ “አን <char style="nd">ዋቀዮዸ</char>። ዋን አን ስት ህሙ ሁንደ ፈረኦን ሞትቸ ግብጥት ህም።”<verse eid="EXO 6:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 6:30"/>ሙሴን ገሩ <char style="nd">ዋቀዮን</char>፣ “ኩኖ፣ አን ዋን አፋንኮ ቀጄልቼ ዱበቹ ህንደንዴኜፍ ፈረኦን አከሚን ነ ዸገአ?” ጄዼ።<verse eid="EXO 6:30"/></para>
  <chapter eid="EXO 6"/>
  <chapter number="7" style="c" sid="EXO 7"/>
  <para style="p">
    <verse number="1" style="v" sid="EXO 7:1"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ “እላ፣ አን ፈረኦኒፍ ዋቀ ስ ጎዼረ፤ ኦቦሌስኬ አሮንሞ ራጂ ሲፍ ተአ። <verse eid="EXO 7:1"/><verse number="2" style="v" sid="EXO 7:2"/>አት ዋን አን ስ አጀጁ ሁንደ ንዱበተ፤ ኦቦሌስኬ አሮንሞ አከ እን እስራኤሎተ ብየሳ ኬሳ ገድ ዺሱ ፈረኦንት ንህመ። <verse eid="EXO 7:2"/><verse number="3" style="v" sid="EXO 7:3"/>አን ገሩ ፈረኦንን መተ ጀቤሰ ነንጎዸ፤ ዮ አን ብየ ግብጥ ኬሰት መለቶወኒፊ ድንቂወንኮ ባይእሴዩ፣ <verse eid="EXO 7:3"/><verse number="4" style="v" sid="EXO 7:4"/>እን እስን ህንዸጌፈቱ። አን ሀርከኮ ግብጥረት ኦል ነንካሰ፤ ሙርቲ ጀባዻንስ ራያኮ፣ ሰበ እስራኤል ብየ ግብጥ ኬሳ ነንባሰ። <verse eid="EXO 7:4"/><verse number="5" style="v" sid="EXO 7:5"/>ወር ግብጥ ዮሙ አን ሀርከኮ ግብጥረት ኦል ካፈዼ ሰበ እስራኤል አች ኬሳ ባሱት አከ አን <char style="nd">ዋቀዮ</char> ተኤ ንቤኩ።”<verse eid="EXO 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 7:6"/>ሙሴፊ አሮንስ አኩመ <char style="nd">ዋቀዮ</char> እሳን አጀጄ ጎዸን። <verse eid="EXO 7:6"/><verse number="7" style="v" sid="EXO 7:7"/>ዬሮ ፈረኦንት ዱበተንት ሙሴን ነመ ወጋ ሰዴተመ ቱሬ፤ አሮንሞ ነመ ወጋ ሰዴተሚ ሰዲ ቱሬ።<verse eid="EXO 7:7"/></para>
  <para style="s1">ኡሌን አሮን ቦፈ ተኤ</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 7:8"/>
    <char style="nd">ዋቀዮስ</char> ሙሴፊ አሮኒን አከነ ጄዼ፤ <verse eid="EXO 7:8"/><verse number="9" style="v" sid="EXO 7:9"/>“ዮሙ ፈረኦን፣ ‘ድንቂ ሆጄዻ’ እስኒን ጄዹት፣ አትሞ አሮኒን፣ ‘ኡሌኬ ፉዺቲ ፉለ ፈረኦን ዱረት ለፈ ቡስ’ ጄተ፤ ኡሌን ሱንስ ቦፈ ተአ።”<verse eid="EXO 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 7:10"/>ሙሴፊ አሮን ፈረኦን ብረ ዸቀኒ አኩመ <char style="nd">ዋቀዮ</char> እሳን አጀጄ ሰነ ጎዸን። አሮን ፉለ ፈረኦኒፊ ቆንዳልቶተሳ ዱረት ኡሌሳ ለፈ ቡሴ፤ ኡሌን ሱንስ ቦፈ ታቴ። <verse eid="EXO 7:10"/><verse number="11" style="v" sid="EXO 7:11"/>ፈረኦንስ ቤክቶታፊ ፈልፈልቶተ ኦፍት ዋሜ፤ ቶልፈቶትን ግብጥ ኦጉማሳኒ ዾከታ ሰናን አከሱመ ጎዸን። <verse eid="EXO 7:11"/><verse number="12" style="v" sid="EXO 7:12"/>ቶኮን ቶኮንሳኒ ኡሌሳኒ ለፈ ቡሰን፤ ኡሌንሳኒስ ቦፈ ተኤ። ኡሌን አሮን ገሩ ኡሌሳኒ ልቅምስቴ። <verse eid="EXO 7:12"/><verse number="13" style="v" sid="EXO 7:13"/>ተኡስ ፈረኦን አኩመ <char style="nd">ዋቀዮ</char> ዱበቴ ሰነ መተ ጀቤሰ ተኤ እሳን ዸጌፈቹ ድዴ።<verse eid="EXO 7:13"/></para>
  <para style="s1">ዸእቸ ዺጋ</para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 7:14"/>ከነረት <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ “ፈረኦን መተ ጀቤሰ ተኤረ፤ ሰበ ሰነስ ገድ ዺሱ ድዴ። <verse eid="EXO 7:14"/><verse number="15" style="v" sid="EXO 7:15"/>ገነማን ገረ ፈረኦን ዸቅ፤ ኩኖ እን ብሻንት ገድ በአ። ኡሌ ቦፈት ጌደረምቴ ሰነ ሀርከት ቀበዹቲ ቀርቀረ ለገ አበያት እሰ ኤግ። <verse eid="EXO 7:15"/><verse number="16" style="v" sid="EXO 7:16"/>አከነስ ጄዺን፤ ‘<char style="nd">ዋቀዮ</char> ዋቅን እብሮታ አከነ ጄዼ ስት ነ ኤርጌረ፦ አከ ሰብንኮ ዸቄ ገሞጂ ኬሰት ናፍ ሰገዱፍ ገድ ለክስ። አት ገሩ ሀመ አማት አጀጀሙ ድዴርተ። <verse eid="EXO 7:16"/><verse number="17" style="v" sid="EXO 7:17"/><char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ አከ አን <char style="nd">ዋቀዮ</char> ተኤ አት ከናን ቤክተ፦ ኩኖ አን ኡሌ ሀርከኮ ኬሰ ጅሩ ከናን ብሻን አበያ ነንዸአ፤ ብሻን ሱንስ ዺገት ጌደረመ። <verse eid="EXO 7:17"/><verse number="18" style="v" sid="EXO 7:18"/>ቁርጡሚወን ለገ አበያ ኬሳ ንዱኡ፤ ለግን ሱንስ ንአጃአ፤ ወር ግብጥስ ብሻን ለገ ሰና ዹጉ ህንደንደአን።’ ”<verse eid="EXO 7:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 7:19"/>
    <char style="nd">ዋቀዮ</char>ሞ ሙሴዻን አከነ ጄዼ፤ “አሮኒን አከነ ጄዽ፤ ‘ኡሌኬ ቀበዹቲ ብሻኖተ ግብጥረት፣ ለጌንሳኒረት፣ ዶሎሎሳኒረት፣ ሀሮሳኒቲፊ ኩሳ ብሻኒ ሁንደረት ሀርከኬ ድሪርስ።’ እሳንስ ዺገት ጌደረሙ። ግብጥ ጉቱን ዺጋን ጉተመ፤ ቆዳን ሙካቲፊ ኦኮቴን ዸጋ ዺጋን ጉተመን።”<verse eid="EXO 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 7:20"/>ሙሴፊ አሮን አኩመ <char style="nd">ዋቀዮ</char> እሳን አጀጄ ሰነ ጎዸን። አሮን ኡሌሳ ኦል ፉዼ ፉለ ፈረኦኒቲፊ ቆንዳልቶተሳ ዱረት ብሻን አበያ ዸኤ፤ ብሻን ሱን ሁንድስ ዺገት ጌደረሜ። <verse eid="EXO 7:20"/><verse number="21" style="v" sid="EXO 7:21"/>ቁርጡሚወን አበያ ዱናን ለግች አጃኤ፤ ወር ግብጥስ ብሻንሳ ዹጉ ህንደንዴኜ። ግብጥ ጉቱንስ ዺጋን ጉተሜ።<verse eid="EXO 7:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 7:22"/>ገሩ ቶልፈቶትን ግብጥ ቶልቸሳኒቲን አከሱመ ሆጄተን፤ ፈረኦንስ መተ ጀቤሰ ተኤ። እንስ አኩመ <char style="nd">ዋቀዮ</char> ጄዼ ሰነ ሙሴፊ አሮን ዸገኡ ድዴ። <verse eid="EXO 7:22"/><verse number="23" style="v" sid="EXO 7:23"/>ፈረኦንስ ዴብኤ መሰራሳ ሴኔ፤ እንስ ዋን ከነ ያደትሌ ህንቀበትኔ። <verse eid="EXO 7:23"/><verse number="24" style="v" sid="EXO 7:24"/>ወር ግብጥ ሁንድ ዋን ብሻን ለገ ሰና ዹጉ ህንደንደእኒፍ ብሻን ዹጋቲ ባፈቹፍ ጄዸኒ ቀርቀረ አበያ ቆተተን።<verse eid="EXO 7:24"/></para>
  <para style="s1">ዸእቸ ፈቴ</para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 7:25"/>ኤርገ <char style="nd">ዋቀዮ</char> አበያን ዸኤ ጉያን ቶርበ ደርቤ።<verse eid="EXO 7:25"/></para>
  <chapter eid="EXO 7"/>
  <chapter number="8" style="c" sid="EXO 8"/>
  <para style="nb">
    <note caller="+" style="f">
      <char style="fr" closed="false">8 </char>
      <char style="ft" closed="false">ኩታን <char style="xt"><ref loc="EXO 8:1-4">8፥1‑4</ref></char> ክታበ አፋን እብራይስጢ ኬሰት 7፥26‑29 ጄዸሜ፣ ኩታን <char style="xt"><ref loc="EXO 8:5-32">8፥5‑32</ref></char> እሞ 8፥1‑28 ጄዸመ።</char>
    </note> <verse number="1" style="v" sid="EXO 8:1"/><char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ “ፈረኦን ብረ ዸቂ አከነ ጄዺን፤ ‘<char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ አከ ሰብንኮ ነ ተጃጅሉፍ ገድ ዺስ። <verse eid="EXO 8:1"/><verse number="2" style="v" sid="EXO 8:2"/>ዮ አት ገድ እሰ ዺሱ ድዴሞ ኩኖ አን ብየኬ ጉቱት ዸእቸ ፈቴ ነንኤርገ። <verse eid="EXO 8:2"/><verse number="3" style="v" sid="EXO 8:3"/>ለግን አበያ ፈቴዻን ጉቱመ፤ እሳንስ ኦል በአኒ መነኬት፣ ድንቀ ኬት፣ ስሬ ኬት፣ መነ ሆጄቶተኬቲት፣ ሰበኬት፣ እዶ እብዳ ኬት፣ ቆዳ ቡኮኬቲትስ ነምኡ። <verse eid="EXO 8:3"/><verse number="4" style="v" sid="EXO 8:4"/>ፈቴወን ኩኔን ስኢፊ ሰበኬ፣ ቆንዳልቶተኬ ሁንደስ ንያበቱ።’ ”<verse eid="EXO 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 8:5"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ “አሮኒን አከነ ጄዽ፤ ‘ኡሌኬ ቀበዹቲ ሀርከኬ ቡርቃወንረት፣ ለጌኒፊ ኩሳ ብሻኒረት ኦል ካፈዹቲ አከ ፈቴወን ብየ ግብጥት ዹፈን ጎዽ።’ ”<verse eid="EXO 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 8:6"/>አሮን ሀርከሳ ብሻኖተ ግብጥት ኦል ካፈቴ፤ ፈቴወንስ ኦል በአኒ ብየ ሰነ ጉተን። <verse eid="EXO 8:6"/><verse number="7" style="v" sid="EXO 8:7"/>ቶልፈቶትንስ ፈልፈለሳኒቲን አከሱመ ጎዸን፤ ብየ ግብጥትስ ፈቴወን ፍደን።<verse eid="EXO 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 8:8"/>ፈረኦንስ ሙሴፊ አሮንን ኦፍት ዋሜ፣ “አከ እን አናፊ ሰበኮራ ፈቴወን ፈጌሱፍ <char style="nd">ዋቀዮ</char> ከዸዻ፤ አንስ አከ ሰብንኬሰን ዸቄ <char style="nd">ዋቀዮፍ</char> ኣርሳ ዽኤሱፍ ገድን ዺሰ” ጄዼ።<verse eid="EXO 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 8:9"/>ሙሴንስ ፈረኦኒን፣ “አከ ፈቴወን ስኢፊ መኔንኬራ በደኒ ለገ አበያ ቆፈ ኬሰት ሀፈኒፍ ዬሮ አን እት ሲፍ፣ ቆንዳልቶተኬቲፊ ሰበኬቲፍሌ ዋቀ ከዸዹ አት ነ ቤክስስ” ጄዼ።<verse eid="EXO 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 8:10"/>ፈረኦንሞ፣ “ቦር” ጄዼን።</para>
  <para style="p" vid="EXO 8:10">ሙሴንስ አከነ ጄዼ ዴብሴ፤ “<char style="nd">ዋቀዮ</char> ዋቀኬኛ ፈካቱ ከን ቶኮዩ አከ ህንጅሬ አከ ቤክቱፍ አኩመ አት ጄቱ ተአ። <verse eid="EXO 8:10"/><verse number="11" style="v" sid="EXO 8:11"/>ፈቴወን ሱን ስኢፊ መኔንኬራ፣ ቆንዳልቶተኬቲፊ ሰበኬራ ንበዱ፤ ለገ አበያ ቆፈ ኬሰትስ ንሀፉ።”<verse eid="EXO 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 8:12"/>ሙሴፊ አሮን ኤርገ ፈረኦን ብራ ገድ በአኒ ቦዴ ሙሴን ዋኤ ፈቴወን ዋቅን ፈረኦንት ኤርጌ ሰና <char style="nd">ዋቀዮት</char> እዬ። <verse eid="EXO 8:12"/><verse number="13" style="v" sid="EXO 8:13"/><char style="nd">ዋቀዮስ</char> አኩመ ሙሴን ከዸቴ ጎዼ። ፈቴወን ሱንስ መነ ኬሰት፣ ኦብዲረት፣ ድሬረትስ ዹመን። <verse eid="EXO 8:13"/><verse number="14" style="v" sid="EXO 8:14"/>ፈቴወን ሱንስ ወልት ቀበመኒ ቱለመን፤ ብየቲንስ ንአጆፍቴ። <verse eid="EXO 8:14"/><verse number="15" style="v" sid="EXO 8:15"/>ፈረኦን ገሩ ዮሙ አከ ዸእች ሱን ቀበናኤ አርጌት አኩመ <char style="nd">ዋቀዮ</char> ዱበቴ ቱሬ ሰነ መተ ጀቤሰ ተኤ ሙሴፊ አሮንን ዸገኡ ድዴ።<verse eid="EXO 8:15"/></para>
  <para style="s1">ዸእቸ እንጅራኒ</para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 8:16"/>ኤርገሲስ <char style="nd">ዋቀዮ</char> ሙሴዻን፣ “አሮኒን፣ ‘ኡሌኬ ኦል ካሲቲ አዋረ ለፋ ዸእ’ ጄዽ፤ አዋር ሱንስ ብየ ግብጥ ጉቱ ኬሰት እንጅራን ተአ” ጄዼ። <verse eid="EXO 8:16"/><verse number="17" style="v" sid="EXO 8:17"/>እሳንስ አከሱመ ጎዸን። ዮሙ አሮን ሀርከሳ እሰ ኡሌ ቀበቴ ኦል ካፈቴ አዋረ ለፋ ዸኤት እንጅራን ነማፊ ሆሪት ዱዴ። አዋር ጉቱ ብየ ግብጥ ኬሰ ጅሩ ሁንድ እንጅራን ተኤ። <verse eid="EXO 8:17"/><verse number="18" style="v" sid="EXO 8:18"/>ቶልፈቶትን ገሩ ፈልፈለሳኒቲን እንጅራን ገድ ያሱ ያለኒ ደዸበን።</para>
  <para style="p" vid="EXO 8:18">እንጅራንስ ነማፊ ሆሪረ ቱሬ። <verse eid="EXO 8:18"/><verse number="19" style="v" sid="EXO 8:19"/>ቶልፈቶትንስ ፈረኦኒን፣ “ኩን ቁበ ዋቃት” ጄዸን። ፈረኦን ገሩ አኩመ <char style="nd">ዋቀዮ</char> ዱበቴ ሰነ መተ ጀቤሰ ተኤ ዸገኡ ድዴ።<verse eid="EXO 8:19"/></para>
  <para style="s1">ዸእቸ ትሲሳ</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 8:20"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ “ገነመ በሪ ከኢቲ ፉለ ፈረኦን ዱረት ዽኣዹ፤ ኩኖ እን ገረ ብሻንት ገድ በአ፤ አከነስ ጄዺን፤ ‘<char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ አከ እን ነ ተጃጅሉፍ ሰበኮ ገድ ዺስ። <verse eid="EXO 8:20"/><verse number="21" style="v" sid="EXO 8:21"/>ዮ አት ሰበኮ ገድ ዺሱ ድዴሞ ኩኖ፣ አን ቱተ ትሲሳ ስት፣ ቆንዳልቶተኬት፣ ሰበኬት፣ መኔንኬት ነንኤርገ። መኔን ወረ ግብጥ፣ ለፍት እሳን ጅራተንስ ትሲሳን ጉተሙ።<verse eid="EXO 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 8:22"/>“ ‘አን ገሩ ጉያ ሰነ እዶ ሰብንኮ ጅራቱ ጎሼንን ሃለ አዳቲን ነንእላለ፤ አከ አት አከ አን <char style="nd">ዋቀዮ</char> ብየ ከነ ኬሰ ጅሩ ቤክቱፍ ትሲስን ቶኮዩ አች ህንጅራቱ። <verse eid="EXO 8:22"/><verse number="23" style="v" sid="EXO 8:23"/>አን ሰበኮቲፊ ሰበኬ ግዱት ገራ ገሩማ ነንኡመ። መለቶን ኩንስ ቦር ተአ።’ ”<verse eid="EXO 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 8:24"/>
    <char style="nd">ዋቀዮስ</char> አከሱመ ጎዼ። ትሲስን ባይኤን መነ ፈረኦኒፊ መኔን ቆንዳልቶተሳት ዱዴ፤ ብይ ግብጥ ጉቱንስ ትሲሳን በሌፈሜ።<verse eid="EXO 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 8:25"/>ፈረኦንስ ሙሴፊ አሮንን ኦፍት ዋሜ፣ “ዸቃቲ ብዩመ ከነ ኬሰት ዋቀኬሰኒፍ ኣርሳ ዽኤሳ” ጄዼን።<verse eid="EXO 8:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 8:26"/>ሙሴንሞ ዴብሴ አከነ ጄዼ፤ “አከስ ጎቹን ቀጄላ ህንተኡ፤ ኣርሳን ኑ <char style="nd">ዋቀዮ</char> ዋቀኬኛፍ ዽኤስኑ ወረ ግብጥ ብረት ጅበማዸ። ኩኖ፣ ዮ ኑ ኣርሳ ፉለሳኒ ዱረት ጅበሙ ዽኤስኔ እሳን ዸጋዻን ኑ ህንቱመኒሬ? <verse eid="EXO 8:26"/><verse number="27" style="v" sid="EXO 8:27"/>አኩመ እን ኑ አጀጄት ኑ <char style="nd">ዋቀዮ</char> ዋቀኬኛፍ ኣርሳ ዽኤሱፍ ገረ ገሞጂ ከራ ጉያ ሰዲ ዴሙ ቀብነ።”<verse eid="EXO 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 8:28"/>ፈረኦንስ፣ “አን አከ እስን ገሞጂ ኬሰት <char style="nd">ዋቀዮ</char> ዋቀኬሰኒፍ ኣርሳ ዽኤስተኒፍ ገድን እስን ዺሰ፤ ገሩ ባይኤ ፈጋተን ህንዴምና። እስንስ ዋቀ ና ከዸዻ” ጄዼ።<verse eid="EXO 8:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 8:29"/>ሙሴንስ አከነ ጄዼ ዴብሴ፤ “ኩኖ፣ አን አኩመን ስ ብራ ዴሜን አከ ቦር ትሲስን ፈረኦንራ፣ ቆንዳልቶተሳቲፊ ሰበሳራ ከኡ <char style="nd">ዋቀዮ</char> ነንከዸዸ። ያ ፈረኦን አት ገሩ፣ አከ ሰብን ኩን <char style="nd">ዋቀዮፍ</char> ኣርሳ ዽኤሱፍ ገድ ዺሱ ድዴ አመስ ኑ ህንጎዎምስን።”<verse eid="EXO 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 8:30"/>ሙሴንስ ኤርገሲ ፈረኦን ብራ በኤ <char style="nd">ዋቀዮ</char> ከዸቴ፤ <verse eid="EXO 8:30"/><verse number="31" style="v" sid="EXO 8:31"/><char style="nd">ዋቀዮስ</char> አኩመ ሙሴን እሰ ከዸቴ ሰነ ጎዼ፤ ትሲስን ሱንስ ፈረኦንን፣ ቆንዳልቶተሳቲፊ ሰበሳ ገድ ዺሴ ዴሜ፤ ትሲስን ቶኮዩ ህንሀፍኔ። <verse eid="EXO 8:31"/><verse number="32" style="v" sid="EXO 8:32"/>ፈረኦን ገሩ አመስ መተ ጀቤሰ ተኤ፤ ሰበ ሰነስ ገድ ዺሱ ድዴ።<verse eid="EXO 8:32"/></para>
  <chapter eid="EXO 8"/>
  <chapter number="9" style="c" sid="EXO 9"/>
  <para style="s1">ዸእቸ ሆሪት ዹፌ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 9:1"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ “ፈረኦን ብረ ዸቂቲ አከነ ጄዺን፤ ‘<char style="nd">ዋቀዮ</char> ዋቅን እብሮታ አከነ ጄዸ፤ “አከ ሰብንኮ ነ ተጃጅሉፍ ገድ ዺስ።” <verse eid="EXO 9:1"/><verse number="2" style="v" sid="EXO 9:2"/>ዮ አት ገድ ዺሱ ድዴ እሳን ደንቅቴ፣ <verse eid="EXO 9:2"/><verse number="3" style="v" sid="EXO 9:3"/>ኩኖ ሀርክ <char style="nd">ዋቀዮ</char> ሆሪኬ ከኔን ድሬረ ኦለን ፈርዴን፣ ሀሮታፊ ጋለወን ኬት፣ ሎን፣ ሆሎታፊ ሬኦተኬት ዸእቸ ሀማ ንፍደ። <verse eid="EXO 9:3"/><verse number="4" style="v" sid="EXO 9:4"/><char style="nd">ዋቀዮ</char> ገሩ አከ ሆሪን ሰበ እስራኤል ቶኮዩ ህንዱኔፍ ሆሪ እስራኤሊፊ ሆሪ ወረ ግብጥ ግዱት ገራ ገሩማ ንኡመ።’ ”<verse eid="EXO 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 9:5"/>
    <char style="nd">ዋቀዮ</char> ዬሮ ሙርቴሴ፣ “<char style="nd">ዋቀዮ</char> ቦር ዋን ከነ ብየቲ ኬሰት ንሆጄተ” ጄዼ። <verse eid="EXO 9:5"/><verse number="6" style="v" sid="EXO 9:6"/><char style="nd">ዋቀዮስ</char> ጉያ እት ኣኑት ዋን ከነ ሆጄቴ፦ ሆሪን ወረ ግብጥ ሁንድ ንዹሜ፤ ሆሪ ወረ እስራኤል ኬሳ ገሩ ቶኮዩ ህንዱኔ። <verse eid="EXO 9:6"/><verse number="7" style="v" sid="EXO 9:7"/>ፈረኦንስ ነሞተ ቆረተን ኤርጌ፣ ኩኖ አከ ሆሪ ሰበ እስራኤል ኬሳ ቶኮሌ ህንዱእን ቤኬ። ተኡስ ፈረኦን መተ ጀቤሰ ተኤ ሰበ ሰነ ገድ ዺሱ ድዴ።<verse eid="EXO 9:7"/></para>
  <para style="s1">ዸእቸ ዹላ</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 9:8"/>
    <char style="nd">ዋቀዮ</char>ሞ ሙሴፊ አሮኒን አከነ ጄዼ፤ “ዳራ ሀርከ ጉቱ እዶ እብዳቲ ሀማራ፤ ሙሴንስ ዳራ ሰነ ፉለ ፈረኦን ዱረት ሰሚት ኦል ሃፈጫሱ። <verse eid="EXO 9:8"/><verse number="9" style="v" sid="EXO 9:9"/>እንስ ብየ ግብጥ ጉቱ ኬሰት አዋረ ተአ፤ ዹላን መላ ያሱ ነማፊ ሆሪ ጉቱ ብየቲ ኬሰ ጅረንት ያአ።”<verse eid="EXO 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 9:10"/>እሳን ቦለ እብዳራ ዳራ ሀማረተኒ ፉለ ፈረኦን ዱረ ዻበተን። ሙሴንስ ዳራ ሰነ ሰሚት ኦል ፈጫሴ፤ ዹላን መላ ያሱስ ነማፊ ሆሪት ያኤ። <verse eid="EXO 9:10"/><verse number="11" style="v" sid="EXO 9:11"/>ቶልፈቶትንስ ሰበቢ ዹላቲፍ ሙሴ ዱረ ዻበቹ ህንደንዴኜ፤ ዹላን ቶልፈቶታፊ ወረ ግብጥ ሁንደት ያኤ ቱሬቲ። <verse eid="EXO 9:11"/><verse number="12" style="v" sid="EXO 9:12"/>ገሩ <char style="nd">ዋቀዮ</char> አኩመ ሙሴት ህሜ ሰነ <char style="nd">ዋቀዮ</char> ፈረኦንን መተ ጀቤሰ ጎዼ፤ እንስ ሙሴፊ አሮንን ዸገኡ ድዴ።<verse eid="EXO 9:12"/></para>
  <para style="s1">ዸእቸ ጨቢ</para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 9:13"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ “ገነመ በሪ ከኢቲ ፉለ ፈረኦን ዱረ ዻበዹ፤ አከነስ ጄዺን፤ ‘<char style="nd">ዋቀዮ</char> ዋቅን እብሮታ አከነ ጄዸ፤ አከ ሰብንኮ ነ ተጃጅሉፍ ገድ ዺስ፤ <verse eid="EXO 9:13"/><verse number="14" style="v" sid="EXO 9:14"/>ዮ ከና አቺ አን አመ ዸእቸኮ ሁንደ ስት፣ ቆንዳልቶተኬቲፊ ሰበኬት ነንኤርገ፤ ኩንስ አከ አት አከ ዋቅን አከኮ ለፈ ሁንደረ ህንጅሬ ቤክቱፍ። <verse eid="EXO 9:14"/><verse number="15" style="v" sid="EXO 9:15"/>ስላ አመ አን ሀርከኮ ኦል ፉዸዼ ስኢፊ ሰበኬ ዹኩበ ሀማን ዸኡ ነንደንደአ ቱሬ፤ አትስ ለፈራ በደ ቱርቴ። <verse eid="EXO 9:15"/><verse number="16" style="v" sid="EXO 9:16"/>አን ገሩ ሁምነኮ ስረት አርግሲሱፊ አከ መቃንኮ ለፈ ሁንደረት ለብሰሙፍ ጄዼን ካዮ ከናፍ ስ ጅራችሴ። <verse eid="EXO 9:16"/><verse number="17" style="v" sid="EXO 9:17"/>አት አመዩ ሰበኮረት ኦል ኦል ኦፍ ቀብደ፤ ጀረስ ገድ ህንዺፍቱ። <verse eid="EXO 9:17"/><verse number="18" style="v" sid="EXO 9:18"/>ኩኖ አን ቦር ዬሮ አከናት ጨቢ ሀማ ኤርገ ግብጥ ሁንዴፈምቴ ጀልቀቤ ሀመ አማት ተኩማ ግብጥት ህንቡእን ቶኮ ነንቡሰ። <verse eid="EXO 9:18"/><verse number="19" style="v" sid="EXO 9:19"/>ኤጋ አመ ነመ ኤርጊቲ ሆሪኬቲፊ ዋን አላ ቀብዱ ሁንደ መነት ገልችሲስ፤ ጨቢን ሱንስ ነማፊ ሆሪ መነት ህንገልን ከኔን አለት ሀፈን ሁንደት ንቡአ፤ እሳንስ ንዹሙ።’ ”<verse eid="EXO 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 9:20"/>ቆንዳልቶተ ፈረኦን ኬሳ ወር ዱቢ <char style="nd">ዋቀዮ</char> ሶዳተን ገርቦተሳኒቲፊ ሆሪሳኒ መነት ገልፈቹፍ አሪፈተኒ ሶከን። <verse eid="EXO 9:20"/><verse number="21" style="v" sid="EXO 9:21"/>ወር ዱቢ <char style="nd">ዋቀዮቲፍ</char> ጥዬፈኖ ህንኬንንሞ ገርቦተሳኒቲፊ ሆሪሳኒ አለት ዺሰን።<verse eid="EXO 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 9:22"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን፣ “አከ ጨቢን ብየ ግብጥ ሁንደት ነመት፣ ሆሪፊ ብቅልቱ ለፈ ቆቲሳ ግብጥ ሁንደረት ቡኡፍ ሀርከኬ ገረ ሰሚት ድሪርስ” ጄዼ። <verse eid="EXO 9:22"/><verse number="23" style="v" sid="EXO 9:23"/>ዮሙ ሙሴን ኡሌሳ ገረ ሰሚት ድሪርሴትስ <char style="nd">ዋቀዮ</char> ከከዌፊ ጨቢ ኤርጌ፤ እብድስ ገረ ለፋት ገድ ቡኤ። <char style="nd">ዋቀዮስ</char> ብየ ግብጥት ጨቢ ሮብሴ፤ <verse eid="EXO 9:23"/><verse number="24" style="v" sid="EXO 9:24"/>ጨቢን ንቡኤ፤ እብድስ ጨቢ ወጅን ወል መኬ። ጨቢን ሀማን አከና ኤርገ ግብጥ ሰበ ታቴ ቤከምቴ አስ ተኩማ ጉቱ ብየቲት ህንቡኔ። <verse eid="EXO 9:24"/><verse number="25" style="v" sid="EXO 9:25"/>ጨቢን ሱንስ ብየ ግብጥ ኬሰት ዋን አለ ጅሩ ሁንደ ነመስ ሆሪስ ንዸኤ፤ ብቅልቱ ለፈ ቆቲሳ ሁንደስ ንበሌሴ፤ ሙከ ሁንደስ ንበርበዴሴ። <verse eid="EXO 9:25"/><verse number="26" style="v" sid="EXO 9:26"/>ለፍት ጨቢን እት ህንቡእን ብየ ጎሼን እዶ እስራኤሎትን ጅራተን ቆፈ ቱሬ።<verse eid="EXO 9:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 9:27"/>ፈረኦንስ ሙሴፊ አሮንን ኦፍት ዋሜ አከነ ጄዼን፤ “አን አመ ጩቡ ሆጄዼረ፤ <char style="nd">ዋቀዮ</char> ቀጄላዸ፤ አኒፊ ሰብንኮ ገሩ በሌሳ ሆጄትኔረ። <verse eid="EXO 9:27"/><verse number="28" style="v" sid="EXO 9:28"/>ሰበቢ በከካፊ ጨቢን ኑት ባይአቴፍ እስን <char style="nd">ዋቀዮን</char> ኑፍ ከዸዻ። አንስ ገድ እስን ነንዺሰ፤ እስን ሀመነ ጫላ አስ ቱሩ ህንቀብደን።”<verse eid="EXO 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 9:29"/>ሙሴንስ አከነ ጄዼ ዴብሴ፤ “አን ዮሙ መጋላ ከነ ኬሳ በኡት ሀርከኮ በልእሴ <char style="nd">ዋቀዮ</char> ነንከዸዸ። በከካን ንዾወመ፤ ጨቢንስ ስአች ህንጅራቱ፤ ከናንስ አት አከ ለፍት ከን <char style="nd">ዋቀዮ</char> ታቴ ንቤክተ። <verse eid="EXO 9:29"/><verse number="30" style="v" sid="EXO 9:30"/>አን ገሩ አከ አቲፊ ቆንዳልቶትንኬ አመዩ <char style="nd">ዋቀዮ</char> ዋቀ ህንሶዳትኔ ነንቤከ።”<verse eid="EXO 9:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 9:31"/>ዋን ተልባን ደራሬ፣ ገርቡንሞ ብልቻቴ ቱሬፍ ተልባፊ ገርቡን ንበደን። <verse eid="EXO 9:31"/><verse number="32" style="v" sid="EXO 9:32"/>ቀመዲፊ ሆንቦሪን ገሩ ዋን ቱረኒ ብልቻተኒፍ ህንበድኔ።<verse eid="EXO 9:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 9:33"/>ሙሴንስ ፈረኦን ብራ ዴሜ መጋላ ኬሳ ገድ በኤ፤ እንስ ሀርከሳ ገረ <char style="nd">ዋቀዮት</char> በልእሴ፤ በከካፊ ጨቢን ንዾወመን። ቦካንስ ዴብኤ ብየቲት ህንሮብኔ። <verse eid="EXO 9:33"/><verse number="34" style="v" sid="EXO 9:34"/>ፈረኦንስ ዮሙ አከ ቦካን፣ ጨቢፊ በከካን ዾወመን አርጌት አመስ ጩቡ ሆጄቴ፤ እኒፊ ቆንዳልቶትንሳ መተ ጀቤዪ ተአን። <verse eid="EXO 9:34"/><verse number="35" style="v" sid="EXO 9:35"/>አኩመ <char style="nd">ዋቀዮ</char> ከራ ሙሴቲን ዱበቴ ሰነ፣ ፈረኦን መተ ጀቤሰ ተኤ፤ ሰበ እስራኤልስ ገድ ዺሱ ድዴ።<verse eid="EXO 9:35"/></para>
  <chapter eid="EXO 9"/>
  <chapter number="10" style="c" sid="EXO 10"/>
  <para style="s1">ዸእቸ ሀዋንሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 10:1"/>
    <char style="nd">ዋቀዮስ</char> ሙሴዻን አከነ ጄዼ፤ “ፈረኦንት ኦል ሴን፤ አን አከ መለቶወንኮ ከኔን እሳን ግዱት ሆጄዹፍ ጄዼ ፈረኦኒፊ ቆንዳልቶተሳ መተ ጀቤዪ ጎዼረ፤ <verse eid="EXO 10:1"/><verse number="2" style="v" sid="EXO 10:2"/>ኩንስ አከ አት ዋን አን ወረ ግብጥ ጎዼ፣ መለቶ አን እሳን ግዱት አርግሲሴስ እጆሌኬቲፊ እጆሌ እጆሌኬቲት ህምቴ አከ አን <char style="nd">ዋቀዮ</char> ተኤ አከ ቤክተኒፍ ተኤ።”<verse eid="EXO 10:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 10:3"/>ሙሴፊ አሮንስ ፈረኦን ብረ ዸቀኒ አከነ ጄዸኒን፤ “<char style="nd">ዋቀዮ</char> ዋቅን እብሮታ አከነ ጄዸ፦ ‘አት ሀመ ዮሚት ፉለኮ ዱረት ገድ ኦፍ ቀቡ ድደ? አከ እሳን ነ ተጃጅለኒፍ ሰበኮ ገድ ዺስ። <verse eid="EXO 10:3"/><verse number="4" style="v" sid="EXO 10:4"/>ዮ አት ገድ እሳን ዺሱ ድዴ፣ ኩኖ አን ቦር ብየኬት ሀዋንሰ ነንፍደ። <verse eid="EXO 10:4"/><verse number="5" style="v" sid="EXO 10:5"/>ሀዋንስን ኩንስ ሀመ ነምን ቶኮዩ አርጉ ደዸቡት ለፈ ሀጉገ። እንስ ዋኑመ ጨቢራ እስኒ ሀፌሌ ንፍጠ፤ ሙኬን አለት እስኒ ጉደቻ ጅረንስ ኛቴ ፍጠ። <verse eid="EXO 10:5"/><verse number="6" style="v" sid="EXO 10:6"/>እን መነኬ፣ መነ ቆንዳልቶተኬቲ ሁንዳፊ መነ ወረ ግብጥ ሁንዱማ ጉተ፤ ኩንስ ዋን አቦቲንኬቲፊ አቦቲን አቦቲኬቲ ጋፈ ብየ ከነ ቁበተኒ ጀልቀበኒ ሀመ ሀርኣት ህንአርግኒዸ።’ ” ከነ ቦዴ ሙሴን ገረገሌ ፈረኦን ብራ በኤ።<verse eid="EXO 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 10:7"/>ቆንዳልቶትን ፈረኦንስ፣ “ነምች ኩን ሀመ ዮሚት ክዮ ኑት ተአ? ነሞትን ኩን አከ <char style="nd">ዋቀዮ</char> ዋቀሳኒ ተጃጅለኒፍ ገድ ዺስ። አከ ግብጥ በዴ አት አመሌ ህንሁበትኔ?” ጄዸኒን።<verse eid="EXO 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 10:8"/>ሙሴፊ አሮንን ዴብሰኒ ፈረኦንት ጌሰን፤ ፈረኦንስ፣ “ዸቃቲ <char style="nd">ዋቀዮ</char> ዋቀኬሰን ዋቄፈዻ! ገሩ ኤኙቱ ዴመ?” ጄዼን።<verse eid="EXO 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 10:9"/>ሙሴንስ፣ “ኑ ሰበቢ አያነ <char style="nd">ዋቀዮ</char> አያኔፈትኑፍ ደርገጎተኬኛፊ ማንጉዶተኬኘ፣ እልማኒፊ እንተለንኬኘ፣ ቡሻዬፊ ሎንኬኘ ቀበትኔ ዴምነ” ጄዼ ዴብሴ።<verse eid="EXO 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 10:10"/>ፈረኦንስ አከነ ጄዼ፤ “ዮ አን ዱበርቶተኬሰኒፊ እጆሌኬሰን እስን ወጅን ገድ ዺሴ፣ ሜ <char style="nd">ዋቀዮ</char> እስን ወጅን ሃተኡ! ኩኖ ዋን ሀማቱ እስን ዱረ ጅረ። <verse eid="EXO 10:10"/><verse number="11" style="v" sid="EXO 10:11"/>ኩን ህንተኡ! አከ ወር ዺራ ቆፍት ዸቀኒ <char style="nd">ዋቀዮ</char> ዋቄፈተን ጎዻ፤ እስን ከኑመ በርባደኒቲ።” እሳንስ ፉለ ፈረኦን ዱራ ገድ ባፈመን።<verse eid="EXO 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 10:12"/>
    <char style="nd">ዋቀዮስ</char> ሙሴዻን፣ “አከ ሀዋንስን ብየ ግብጥት ቡኤ ብቅልቱ ለፈ ቆቲሳ ሁንደ፣ ዋን ጨቢራ ሀፌ ሁንደስ ኛቱፍ ሀርከኬ ግብጥረት ድሪርስ” ጄዼ።<verse eid="EXO 10:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 10:13"/>ሙሴንስ ኡሌሳ ግብጥረት ድሪርስናን <char style="nd">ዋቀዮ</char> ጉያ ሰነ ጉቱፊ ሀልከን ሰነ ጉቱ አከ ቡቤን በአ ቢፍቱ ብየቲ ኬሰት ቡብሱ ጎዼ፤ ገነመ እት ኣኑስ ቡቤን ሱን ሀዋንሰ ፍዴ ዹፌ፤ <verse eid="EXO 10:13"/><verse number="14" style="v" sid="EXO 10:14"/>ሀዋንስን ሱንስ ግብጥ ጉቱ ዌረሬ፤ ብየ ሁንደ ኬሰስ ባይእናን ቁበቴ። ዸእች ሀዋንሳ ከን አከሲ ዱራን ተኩማ ቡኤ ህንቤኩ፤ ኤርገሲስ ተኩማ ዴብኤ ህንቡኔ። <verse eid="EXO 10:14"/><verse number="15" style="v" sid="EXO 10:15"/>ሀዋንስን ሱንስ ሀመ ለፍት ጉራቸኡት ለፈ ሁንደ ሀጉጌ፤ እንስ ዋን ጨቢራ ሀፌ ሁንደ፣ ዋን አለት ብቅሌ ሁንደ፣ እጀ ሙካሌ ንኛቴ። ብየ ግብጥ ሁንደ ኬሰት ወን ለልሳን ቶኮዩ ሙከረት ዮካን ብቅልቱረት ህንሀፍኔ።<verse eid="EXO 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 10:16"/>ፈረኦንስ ደፌ ሙሴፊ አሮንን ዋሜ አከነ ጄዼን፤ “አን <char style="nd">ዋቀዮ</char> ዋቀኬሰኒፊ እስንት ጩቡ ሆጄዼረ። <verse eid="EXO 10:16"/><verse number="17" style="v" sid="EXO 10:17"/>ኤጋ ሜ ጩቡኮ ና ዺሳ፤ አከ እን ዸእቸ ነመ አጄሱ ከነ ነራ ፉዹፍስ <char style="nd">ዋቀዮ</char> ዋቀኬሰን ና ከዸዻ።”<verse eid="EXO 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 10:18"/>ሙሴንስ ፈረኦን ብራ ገድ በኤ <char style="nd">ዋቀዮ</char> ከዸቴ። <verse eid="EXO 10:18"/><verse number="19" style="v" sid="EXO 10:19"/><char style="nd">ዋቀዮስ</char> ቡቤ ሰነ ገረ ቡቤ ልጠ ቢፍቱ ጀባት ጌደሬ፤ ቡቤን ሱንስ ሀዋንሰ ሰነ ፉዼ ገላነ ዲማት ነቄ። ግብጥ ኬሰት ሀዋንስን ቶኮዩ ህንሀፍኔ። <verse eid="EXO 10:19"/><verse number="20" style="v" sid="EXO 10:20"/><char style="nd">ዋቀዮ</char> ገሩ ፈረኦንን መተ ጀቤሰ ጎዼ፤ ፈረኦንስ እስራኤሎተ ገድ ህንዺፍኔ።<verse eid="EXO 10:20"/></para>
  <para style="s1">ዸእቸ ዱከና</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 10:21"/>
    <char style="nd">ዋቀዮ</char>ሞ ሙሴዻን፣ “አከ ዱከን ግብጥረ ቡኡፍ ሀርከኬ ገረ ሰሚት ድሪርስ” ጄዼ። <verse eid="EXO 10:21"/><verse number="22" style="v" sid="EXO 10:22"/>ሙሴን ሀርከሳ ገረ ሰሚት ድሪርሴ፤ ዱከን ልምጢንሳ ጉያ ሰዲ ግብጥ ጉቱ ሀጉጌ። <verse eid="EXO 10:22"/><verse number="23" style="v" sid="EXO 10:23"/>ጉያ ሰደን ሰነ ነምን ወል ህንአርጉ ቱሬ፤ ለፈ ጅሩስ ህንሶቾኡ ቱሬ። እስራኤሎትን ሁንድ ገሩ እዶ ጅራተንት እፈ ቀቡ ቱረን።<verse eid="EXO 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 10:24"/>ፈረኦንስ ሙሴ ኦፍት ዋሜ፣ “ዸቃቲ <char style="nd">ዋቀዮ</char> ዋቄፈዻ። ዱበርቶትኒፊ እጆሌንኬሰንስ እስን ወጅን ሃዴመን፤ ቡሻዬፊ ሎንኬሰን ቆፈ ዺሳ ዴማ” ጄዼን።<verse eid="EXO 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 10:25"/>ሙሴን ገሩ አከነ ጄዼ፤ “አት አከ ኑ <char style="nd">ዋቀዮ</char> ዋቀኬኛፍ ኣርሳፊ ቀልመ ጉበሙ ዽኤስኑፍ ኑ ኤየሙ ቀብደ። <verse eid="EXO 10:25"/><verse number="26" style="v" sid="EXO 10:26"/>ሆሪንኬኘስ ኑ ወጅን ዸቁ ቀበ፤ ኮቴን ቶኮዩ ህንሀፉ። <char style="nd">ዋቀዮ</char> ዋቀኬኘ ዋቄፈቹፍ እሳን ኬሳ ቶኮ ቶኮት ፈየደምነ፤ ሀመ አች ጌኙት <char style="nd">ዋቀዮ</char> ዋቄፈቹፍ ማልት አከ ፈየደምኑ ህንቤክኑ።”<verse eid="EXO 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 10:27"/>
    <char style="nd">ዋቀዮ</char> ገሩ ፈረኦንን መተ ጀቤሰ ጎዼ፤ እንስ ገድ እሳን ዺሱ ድዴ። <verse eid="EXO 10:27"/><verse number="28" style="v" sid="EXO 10:28"/>ፈረኦንስ ሙሴዻን፣ “ፉለኮ ዱራ በድ! ለመተ ፉለኮ አከ ህንአርግኔ ቤከዹ፤ አት ጋፈ ፉለኮ አርግቴ ንዱተ!” ጄዼ።<verse eid="EXO 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 10:29"/>ሙሴንስ ዴብሴ፣ “አኩመ አት ጄቴ፣ አን ለመተ ፉለኬት ህንሙልአዹ” ጄዼ።<verse eid="EXO 10:29"/></para>
  <chapter eid="EXO 10"/>
  <chapter number="11" style="c" sid="EXO 11"/>
  <para style="s1">ዸእቸ ሀንገፈረ ገኤ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 11:1"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ “አን አመሌ ዸእቸ ቶኮ ፈረኦኒፊ ግብጥት ነንፍደ። ኤርገሲ እን አሲ እስን ባሰ፤ ዬሮ አሲ እስን ባሱትሞ እን ጉቱማን ጉቱት እስን አርአ። <verse eid="EXO 11:1"/><verse number="2" style="v" sid="EXO 11:2"/>አከ ቶኮን ቶኮን ዺራቲፊ ቶኮን ቶኮን ዱበርቲ ኦላሳኒራ ምአ ሜቲቲፊ ምአ ወርቄ ኤርግፈተን ሰበ ከነት ህም።” <verse eid="EXO 11:2"/><verse number="3" style="v" sid="EXO 11:3"/><char style="nd">ዋቀዮ</char> አከ ሰብን እስራኤል ፉለ ወረ ግብጥ ዱረት ሱራ አርገተን ጎዼ፤ ከነ መሌስ ሙሴን ብየ ግብጥ ኬሰት፣ ፉለ ቆንዳልቶተ ፈረኦኒቲፊ ፉለ ሰበ ግብጥ ዱረት አከ መሌ ኡልፍነ ቀቤሰ ቱሬ።<verse eid="EXO 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 11:4"/>ሙሴን አከነ ጄዼ፤ “<char style="nd">ዋቀዮ</char> አከነ ጄዸ፤ ‘አን ገረ ሀልከን ወለካት ግብጥ ሁንደ ኬሰ ነንደርበ። <verse eid="EXO 11:4"/><verse number="5" style="v" sid="EXO 11:5"/>እልመ ፈረኦን ነምቸ ቴሶረ ታኡ ሰና ሀንገፋ ጀልቀቤ ሀመ እልመ ጦምቦሬሼ ምዻን ዳክቱ ሰና ሀንገፋት እልም ሀንገፍን ብየ ግብጥ ኬሳ ሁንድ ንዱአ፤ አከሱመስ ሀንገፍን ሆሪ ሁንድ ንዱአ። <verse eid="EXO 11:5"/><verse number="6" style="v" sid="EXO 11:6"/>ብየ ግብጥ ጉቱ ኬሰትስ ወዋቹ ጉዳን ተኩማ ዸገአሜ ህንቤክን ዮካን ዴብኤስ ህንዸገአምኔ ቶኮ ንዹፈ። <verse eid="EXO 11:6"/><verse number="7" style="v" sid="EXO 11:7"/>ገሩ ሰበ እስራኤል ኬሳ ነመ ቶኮትዩ ዮካን ሆሪ ቶኮትዩ ሰሬን ቶኮዩ ህንዱቱ።’ እስንስ ዋን ከናን አከ <char style="nd">ዋቀዮ</char> ግብጢፊ እስራኤል ግዱት ገራ ገሩማ ፍዱ ንቤክቱ። <verse eid="EXO 11:7"/><verse number="8" style="v" sid="EXO 11:8"/>ቆንዳልቶትንኬ ኩኔን ሁንድኑ ገረኮ ዹፈኒ ና ሰገደን፤ ‘አትስ፣ ነሞትን ስ ዱካ ቡአን ሁንድኑስ ዴማ!’ ጄዹ፤ አንስ ኤርገሲ ነንዴመ።” ሙሴንስ አከ መሌ ኣሬ ፈረኦን ብራ በኤ።<verse eid="EXO 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 11:9"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን፣ “አከ ድንቂንኮ ብየ ግብጥት ባይአቱፍ ፈረኦን እስን ዸገኡ ድደ” ጄዼ። <verse eid="EXO 11:9"/><verse number="10" style="v" sid="EXO 11:10"/>ሙሴፊ አሮንስ ድንቂወን ከኔን ሁንደ ፉለ ፈረኦን ዱረት ሆጄተን፤ <char style="nd">ዋቀዮ</char> ገሩ ፈረኦንን መተ ጀቤሰ ጎዼ፤ እንስ አከ እስራኤሎን ብየሳ ኬሳ ህንባኔ ዾዌ።<verse eid="EXO 11:10"/></para>
  <chapter eid="EXO 11"/>
  <chapter number="12" style="c" sid="EXO 12"/>
  <para style="s1">ፋሲካ</para>
  <para style="r">
    <ref loc="EXO 12:14-20">12፥14‑20</ref> ኩወፈ – <char style="xt"><ref loc="LEV 23:4-8">ሌዎ 23፥4‑8</ref>፤ <ref loc="NUM 28:16-25">ለኮ 28፥16‑25</ref>፤ <ref loc="DEU 16:1-8">ኬዴ 16፥1‑8</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 12:1"/>
    <char style="nd">ዋቀዮስ</char> ብየ ግብጥ ኬሰት ሙሴፊ አሮኒን አከነ ጄዼ፤ <verse eid="EXO 12:1"/><verse number="2" style="v" sid="EXO 12:2"/>“ጅእ ኩን ጅአ ጀልቀባ እስኒ ሃተኡ፤ እንስ ወጋ ኬሳ ጅአ ጀልቀባ እስኒ ሃተኡ። <verse eid="EXO 12:2"/><verse number="3" style="v" sid="EXO 12:3"/>ጅአ ከነ ኬሰ ቡልቲ ኩርነፋት ቶኮን ቶኮን ነማ ጦባላ ሆላ ቶኮ አኩመ መኔን አቦቲሳኒት ቶኮ ቶኮ መናቲፊ ጦባላ ሆላ ቶኮ አከ ፉዸቱ ጉቱማ ሀዋሰ እስራኤልት ህማ። <verse eid="EXO 12:3"/><verse number="4" style="v" sid="EXO 12:4"/>ዮ ወር መነ ቶኮ ጅራተን ሙራሰ ተአኒ ሆላ ቶኮ ጉቱማት ፍጡ ባተን፣ እሳን አኩመ ባይእነ ነሞተ አች ጅራተኒት ኦላ እሳንት ኣኑ ወጅን ሃቆደተን። እስንስ አኩመ ዋን ቶኮን ቶኮን ነማ ኛቹ ደንደኡት ጦባላ ሆላ ሀመም አከ በርባችሱ ሙርቴሱ ቀብዱ። <verse eid="EXO 12:4"/><verse number="5" style="v" sid="EXO 12:5"/>ጦባላንኬሰን እልሞ ሆላ ወጋ ቶኮ ከን ሙዳ ህንቀብኔ ተኡ ቀበ፤ ጦባላ ሰነስ ሆሎተ ኬሳ ዮካን ሬኦተ ኬሳ ፉዸቹ ደንዴሱ። <verse eid="EXO 12:5"/><verse number="6" style="v" sid="EXO 12:6"/>ጦባላ ሰነስ ሀመ ቡልቲ ኩዸ አፉረፋ ጅአ ከናት ኤጋ፤ ያኢን ወልዳ እስራኤል ጉቱንስ ገልገለ ሰነ ጦባላ ሰነ ሃቀለቱ። <verse eid="EXO 12:6"/><verse number="7" style="v" sid="EXO 12:7"/>ኤርገሲሞ ዺገ ሰነራ ጥኖ ፉዸኒ ምችችለ በልበላ ለማኒፊ ቡሳ በልበላ እሰ ኦል ኣኑ ከን መነ እት ጦባላ ሰነ ኛተኒ ሃድበን። <verse eid="EXO 12:7"/><verse number="8" style="v" sid="EXO 12:8"/>እሳንስ ሀልከኑመ ሰነ ፎን ሰነ እብዳን ዋደተኒ ብቅልቱ ሀዾፍቱፊ መጥኖን ሃኛተን። <verse eid="EXO 12:8"/><verse number="9" style="v" sid="EXO 12:9"/>እብዳን ዋደዻቲ ኛዻ መሌ ፎን ዼዺ ዮካን ከን ብሻኒን አፌለሜ ህንኛትና፤ መታሳ፣ ሉካፊ ምአ ገራ ወጅን ዋደዻቲ ኛዻ። <verse eid="EXO 12:9"/><verse number="10" style="v" sid="EXO 12:10"/>ሀመ ለፍት በሪቱት ሆማ ህንሀምብስና፤ ዋን ሀመ ገነማት እራ ሀፉ ገሩ ጉባ። <verse eid="EXO 12:10"/><verse number="11" style="v" sid="EXO 12:11"/>ሃል እስን እት ኛተንስ ኩኖት፤ ሙዺኬሰን ህዸዻ፤ ኮጴኬሰን ሚለት ካአዻ፤ ኡሌኬሰንሌ ሀርከት ቀበዻቲ ጀርጀርሱን ኛዻ፤ እን ፋሲካ <char style="nd">ዋቀዮት</char>።<verse eid="EXO 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 12:12"/>“አንስ ሀልከኑመ ሰነ ግብጥ ኬሰ ነንደርበ፤ ሀንገፈ ግብጥስ ነማፊ ሆሪ ነንዸአ፤ ዋቆተ ግብጥ ሁንደትስ ነንሙረ፤ አን <char style="nd">ዋቀዮ</char>። <verse eid="EXO 12:12"/><verse number="13" style="v" sid="EXO 12:13"/>ዺግን ሱንስ መኔን እስን ኬሰ ጅራተንረት መለቶ እስኒ ተአ፤ አን ዮሙን ዺገ ሰነ አርጉት እስንረ ነንደርበ። ዬሮ አን ብየ ግብጥ ዸኡትስ ዸእች በዲሳ ቶኮዩ እስን ህንቱቁ።<verse eid="EXO 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 12:14"/>“ጉያን ኩን ጉያ ያደኖ እስኒፍ ሃተኡ፤ አከ አያናት <char style="nd">ዋቀዮፍ</char> ንአያኔፈቱ፤ ዸሎተኬሰን ሁንደ ኬሰትስ ስርነ በረ በራ ጎዸተኒ ንኤግዱ። <verse eid="EXO 12:14"/><verse number="15" style="v" sid="EXO 12:15"/>እስን ቡልቲ ቶርበ መጥኖ ኛቹ ቀብዱ፤ ጉያ ጀልቀባት መነኬሰኒ ራጭቲ ባሳ ገታ፤ ነምን ከምዩ ጉያ ጀልቀባቲ ካሴ ሀመ ጉያ ቶርበፋት ዮ ቡዴነ ቡካኤ ኛቴ ሰበ እስራኤል ኬሳ ሃበሌፈሙ። <verse eid="EXO 12:15"/><verse number="16" style="v" sid="EXO 12:16"/>ጉያ ጀልቀባት ወል ገኢ ቁልቁሉ ቀባዻ፤ ወል ገኢ ቁልቁሉ ብራሞ ጉያ ቶርበፋት ቀባዻ። ዋን ነምን ሁንድ ኛቱ ቆጴሱ መሌ ጉዮተ ከኔን ሆጂ ቶኮዩ ህንሆጄትና፤ ወን እስን ሆጄቹ ደንዴሰን ከኑመ።<verse eid="EXO 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 12:17"/>“ሰበቢ ጉያን አን እት ራያኬሰን ግብጥ ኬሳ ባሴ ጉዩመ ከነ ተኤፍ አያነ መጥኖ ከነ አያኔፈዻ፤ ጉያ ከነስ ስርነ በረ በራ ጎዸዻቲ ዸሎተኬሰን ሁንደ ኬሰት አያኔፈዻ። <verse eid="EXO 12:17"/><verse number="18" style="v" sid="EXO 12:18"/>እስን ጅአ ጀልቀባ ኬሰ ገልገለ ቡልቲ ኩዸ አፉረፋዻ ሀመ ገልገለ ጉያ ድግደሚ ቶኮፋት መጥኖ ኛቱ። <verse eid="EXO 12:18"/><verse number="19" style="v" sid="EXO 12:19"/>ቡልቲ ቶርባፍ ራጭቲን ቶኮሌ መነኬሰንት ህንአርገምን፤ አለጋስ ተኡ ዸለታን ብያ፣ ነምን ዋን ራጭቲ ቀቡ ኛቱ ከምዩ ወልዳ እስራኤል ኬሳ ሃበሌፈሙ። <verse eid="EXO 12:19"/><verse number="20" style="v" sid="EXO 12:20"/>ዋን ራጭቲ ቀቡ ቶኮሌ ህንኛትና፤ ለፈ ጅራተን ሁንደት መጥኖ ኛዻ።”<verse eid="EXO 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 12:21"/>ሙሴን ማንጉዶተ እስራኤል ሁንደ ኦፍት ዋሜ አከነ ጄዼን፤ “ዸቃቲ ማቲኬሰኒፍ ጦባላ ፍለዻቲ ፋሲካ ቀላ። <verse eid="EXO 12:21"/><verse number="22" style="v" sid="EXO 12:22"/>ሂሶጲ ቀባ ቶኮ ፉዻ፤ ዺገ ወጪቲ ኬሰ ጅሩ ሰነ ኬሰ ጩጳቲ ምችችለ በልበላ ለማኒፊ ቡሳ በልበላ እሰ ኦል ኣኑ ድባ። እስን ኬሳ ነምን ቶኮዩ ሀመ ለፍት በሪቱት በልበለ መነ ኦፊሳቲ ገድ ህንበእን። <verse eid="EXO 12:22"/><verse number="23" style="v" sid="EXO 12:23"/><char style="nd">ዋቀዮ</char> ዬሮ ወረ ግብጥ ዸኡፍ ብየቲ ኬሰ ደርቡት ምችችለ በልበላ ለማንረቲፊ ቡሳ በልበላ እሰ ኦል ኣኑረት ዺገ ሰነ አርጌ በልበለ ሰነ ብረ ደርበ፤ አከ እን ዋ በሌሱ ሱን መነኬሰን ሴኔ እስን አጄሱስ ህንኤየሙፍ።<verse eid="EXO 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 12:24"/>“እስንስ ቀጄልፈመ ከነ አከ ሴረ በረ በራ ከን እስኒፊ ሰኚኬሰኒፍ ኬነሜት ከበጃ። <verse eid="EXO 12:24"/><verse number="25" style="v" sid="EXO 12:25"/>እስንስ ዬሮ ብየ <char style="nd">ዋቀዮ</char> አኩመ ዋዳ ገሌ ሰነት እስኒ ኬኑ ሴንተንት ስርነ ከነ ኤጋ። <verse eid="EXO 12:25"/><verse number="26" style="v" sid="EXO 12:26"/>ዮሙ እጆሌንኬሰን፣ ‘ስርን ኩን እስኒፍ ሂካ ማሊ ቀበ?’ ጄዸኒ እስን ጋፈተንት፣ <verse eid="EXO 12:26"/><verse number="27" style="v" sid="EXO 12:27"/>አከነ ጄዻ እሳንት ህማ፤ ‘ኩን ቀልመ ፋሲካ <char style="nd">ዋቀዮት</char>፤ እን ዬሮ ወረ ግብጥ ዸኤት መኔን እስራኤሎተ ግብጥ ኬሰ ቱረን ሰናረ ደርቤ መኔንኬኘ ኑፍ ኦልቼራቲ።’ ” ከነረት ነሞትን ገድ ጄዸኒ ዋቄፈተን። <verse eid="EXO 12:27"/><verse number="28" style="v" sid="EXO 12:28"/>እስራኤሎንስ አኩመ <char style="nd">ዋቀዮ</char> ሙሴፊ አሮንን አጀጄ ሰነ ጎዸን።<verse eid="EXO 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 12:29"/>ሀልከን ወለካት <char style="nd">ዋቀዮ</char> እልመ ፈረኦን ነምቸ ቴሶረ ታኡ ሀንገፋ ጀልቀቤ ሀመ እልመ ነምቸ ቦለ መነ ህዻ ኬሰ ጅሩ ሀንገፋት ሀንገፎተ ግብጥ ሁንደ ዸኤ፤ ሀንገፎተ ሆሪስ አከሱመ ዸኤ። <verse eid="EXO 12:29"/><verse number="30" style="v" sid="EXO 12:30"/>ፈረኦኒፊ ቆንዳልቶትንሳ ሁንድ፣ ወር ግብጥ ሁንድስ ሀልከኒን ከአን፤ ሰበቢ መን ነምን ኬሳ ህንዱእን ቶኮዩ ህንቱርኒፍ ቦእቸ ጉዳቱ ግብጥ ኬሰ ቱሬ።<verse eid="EXO 12:30"/></para>
  <para style="s1">ግብጢ በኡ</para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 12:31"/>ፈረኦንስ ሀልከን ሰናን ሙሴፊ አሮንን ኦፍት ዋሜ አከነ ጄዼ፤ “ከኣ! እስኒፊ እስራኤሎን ሰበኮ ኬሳ በኣ! አኩመ ጋፈተን ሰነ ዸቃቲ <char style="nd">ዋቀዮን</char> ዋቄፈዻ። <verse eid="EXO 12:31"/><verse number="32" style="v" sid="EXO 12:32"/>አኩመ ጄተን ሰነ ቡሻዬፊ ሎንኬሰን ፉዸዻቲ ዴማ፤ አነስ ኤብሳ።”<verse eid="EXO 12:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 12:33"/>ወር ግብጥስ አከ ሰብን ሱን ደፌ ብየ ሰና በኡ ጀርጀርሰን፤ እሳንስ፣ “ዮ ከና አቺ ኑ ሁንድ ንዹምና” ጄዸን። <verse eid="EXO 12:33"/><verse number="34" style="v" sid="EXO 12:34"/>ከናፉ ሰብን ሱን ቡኮሳኒ ኡቱ ህንቡካእን ፉዸተኒ፣ ቆዳ ቡኮሳኒስ ወያሳኒቲን መረኒ ገቲቲት ባዸተን። <verse eid="EXO 12:34"/><verse number="35" style="v" sid="EXO 12:35"/>እስራኤሎንስ አኩመ ሙሴን እሳንት ህሜ ሰነ ጎዸን፤ እሳንስ ምአ ሜቲቲፊ ወርቄ፣ ወያስ ወረ ግብጥ ጋፈተን። <verse eid="EXO 12:35"/><verse number="36" style="v" sid="EXO 12:36"/>ሰበቢ <char style="nd">ዋቀዮ</char> ፉለ ወረ ግብጥ ዱረት እስራኤሎታፍ ሱራ ኬኔፍ፣ ወር ግብጥ ዋን እሳን ጋፈተን ሁንደ ኬነኒፍ፤ እሳንስ አከሲን ቀቤኘ ወረ ግብጥ ቦጅአኒ በአን።<verse eid="EXO 12:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="EXO 12:37"/>እስራኤሎንስ ራምሴዻ ከአኒ ሱኮትት ቀጄለን። እሳንስ ነዼኒፊ እጆሌ መሌ ነሞተ ለፎ ገረ ኩመ ዽበ ጀአ ቱረን። <verse eid="EXO 12:37"/><verse number="38" style="v" sid="EXO 12:38"/>ኡመትን ወልት መከሜ ሄዱን፣ አከሱመስ ሆሪን ጄቹንስ ቡሻዬፊ ሎን ባይኤን እሳን ወጅን በአን። <verse eid="EXO 12:38"/><verse number="39" style="v" sid="EXO 12:39"/>እሳንስ ቡኮ ግብጥ ፉዸተኒ ዹፈን ሰነራ መጥኖ ቶልፈተን። ሰበቢ እሳን ጀርጀርሱዻን ግብጥ ኬሳ ባፈመኒ ዬሮ እት ኛተ ቆጴፈተንሌ ዸበኒፍ ቡኮን ሱን ራጭቲ ህንቀቡ ቱሬ።<verse eid="EXO 12:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="EXO 12:40"/>በር እስራኤሎን ግብጥ ኬሰ ጅራተን ወጋ 430 ቱሬ። <verse eid="EXO 12:40"/><verse number="41" style="v" sid="EXO 12:41"/>ዹመ ወጋ 430 ሰናት ጉዩመ ሰነ ራያን <char style="nd">ዋቀዮ</char> ሁንድ ብየ ግብጢቲ በኤ። <verse eid="EXO 12:41"/><verse number="42" style="v" sid="EXO 12:42"/><char style="nd">ዋቀዮ</char> ግብጥ ኬሳ እሳን ባሱዻፍ ደመቄ ሀልከን ሰነ ዋን እሳን ኤጌፍ፣ ሀልከን ኩን እስራኤሎተ ሁንዱማፍ ሀልከን እት <char style="nd">ዋቀዮፍ</char> ኡልፍነ ኬኑዻፍ ደመቀኒ ኤገኒዸ።<verse eid="EXO 12:42"/></para>
  <para style="s1">ሴረ ፋሲካ</para>
  <para style="p">
    <verse number="43" style="v" sid="EXO 12:43"/>
    <char style="nd">ዋቀዮስ</char> ሙሴፊ አሮኒን አከነ ጄዼ፤ “ሴር ፋሲካ ከናዸ፦</para>
  <para style="p" vid="EXO 12:43">“ኦርም ቶኮዩ እሰራ ህንኛትን። <verse eid="EXO 12:43"/><verse number="44" style="v" sid="EXO 12:44"/>ገርብች ብተሜ ከምዩ ኤርገ ዸግነ ቀብደኒ ቦዴ ሃኛቱ፤ <verse eid="EXO 12:44"/><verse number="45" style="v" sid="EXO 12:45"/>ኬሱማን ዮካን ነምን ሆጄታን ቀጨረሜ ገሩ ህንኛትን።<verse eid="EXO 12:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="EXO 12:46"/>“ሆላን ሱን መኑመ ቶኮ ኬሰት ሃኛተሙ፤ ፎንሳ ቶኮዩ መና ገድ ህንባስና። ለፌሳ ኬሳስ ቶኮዩ ህንጨብስና። <verse eid="EXO 12:46"/><verse number="47" style="v" sid="EXO 12:47"/>ወልዳን እስራኤል ሁንድስ አያነ ከነ ሃአያኔፈቱ።<verse eid="EXO 12:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="EXO 12:48"/>“ኦርም እስን ወጅን ጅራቱ ዮ ፋሲካ <char style="nd">ዋቀዮ</char> አያኔሱ በርባዴ እን ዺሮተ መነሳ ጅራተን ሁንደ ዸግነ ሃቀቡ፤ ኤርገሲስ አኩመ ዸለታ ብያት አያንቸ ሃአያኔሱ። ዺር ዸግነ ህንቀበትን ቶኮዩ ገሩ ሆላ ሰነ ህንኛትን። <verse eid="EXO 12:48"/><verse number="49" style="v" sid="EXO 12:49"/>ዸለታ ብያቲፍስ ተኡ ኦርመ እስን ግዱ ጅራቱፍ ሴር ቶኩመ።”<verse eid="EXO 12:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="EXO 12:50"/>እስራኤሎን ሁንድስ አኩመ <char style="nd">ዋቀዮ</char> ሙሴፊ አሮንን አጀጄ ሰነ ጎዸን። <verse eid="EXO 12:50"/><verse number="51" style="v" sid="EXO 12:51"/><char style="nd">ዋቀዮስ</char> ጋፉመ ሰነ ኩታ ኩታሳኒቲን እስራኤሎተ ብየ ግብጥ ኬሳ ባሴ።<verse eid="EXO 12:51"/></para>
  <chapter eid="EXO 12"/>
  <chapter number="13" style="c" sid="EXO 13"/>
  <para style="s1">ሀንገፍን ዋቃፍ አዳን ባፈሙሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 13:1"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ <verse eid="EXO 13:1"/><verse number="2" style="v" sid="EXO 13:2"/>“ዺረ ሀንገፈ ሁንደ አዳን ና ባስ፤ እስራኤሎተ ኬሳ ነመስ ተኡ ሆሪን ሀንገፍን ገደሜሰ በኑ ከምዩ ከንኮት።”<verse eid="EXO 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 13:3"/>ዮሙስ ሙሴን ኡመታን አከነ ጄዼ፤ “ሰበቢ <char style="nd">ዋቀዮ</char> እሬ ጀባዻን አቺ እስን ባሴፍ ጉያ እት መነ ገርቡማቲ ግብጥ ኬሳ ባተን ከነ ያደዻ። ዋን ራጭቲ ቀቡ ቶኮሌ ህንኛትና። <verse eid="EXO 13:3"/><verse number="4" style="v" sid="EXO 13:4"/>እስን ጅአ አቢቢ ኬሰ ጉያ ሀርኣ ባተን። <verse eid="EXO 13:4"/><verse number="5" style="v" sid="EXO 13:5"/>ዬሮ <char style="nd">ዋቀዮ</char> ገረ ብየ ከነኣኖታ፣ ሄቶታ፣ አሞሮታ፣ ብየ ሂዎታፊ ዬቡሶታት ጄቹንስ ብየ ኣነኒፊ ደመ ባሱ ከን እን አከ ሲፍ ኬኑ አቦቲኬቲፍ ከከቴ ሰነት ስ ገልቹት አት ጅአ ከነ ኬሰ አያነ ከነ አያኔፈተ፤ <verse eid="EXO 13:5"/><verse number="6" style="v" sid="EXO 13:6"/>አት ቡልቲ ቶርበ መጥኖ ኛተ፤ ጉያ ቶርበፋትሞ አያነ <char style="nd">ዋቀዮ</char> ተአ። <verse eid="EXO 13:6"/><verse number="7" style="v" sid="EXO 13:7"/>ጉያ ቶርበን ሰነ መጥኖ ኛዹ፤ ወን ራጭቲ ቀቡ ቶኮዩ ስ ብረት ህንአርገምን፤ ዳንጋኬ ሁንደ ኬሰትስ ራጭቲን ህንአርገምን። <verse eid="EXO 13:7"/><verse number="8" style="v" sid="EXO 13:8"/>ጋፈስ፣ ‘አን ዋን <char style="nd">ዋቀዮ</char> ዬሮ አን ግብጥ ኬሳ በኤት ና ጎዼ ሰናፍ ጄዼ ዋን ከነ ጎዸ’ ጄዺቲ እልመኬት ህም። <verse eid="EXO 13:8"/><verse number="9" style="v" sid="EXO 13:9"/>ስርን ኩንስ አከ ሴር <char style="nd">ዋቀዮ</char> አረበኬረ ጅራቱፍ ሀርከኬ እረት አከ መለቶ፣ አደኬረትሞ አከ ያደኖ ሲፍ ተአ። <char style="nd">ዋቀዮ</char> ሀርከሳ ጀባ ሰናን ግብጢ ስ ባሴቲ። <verse eid="EXO 13:9"/><verse number="10" style="v" sid="EXO 13:10"/>አትስ ስርነ ከነ ወጉመ ወጋን ዬሮሳት ኤጉ ቀብደ።<verse eid="EXO 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 13:11"/>“ዮሙ <char style="nd">ዋቀዮ</char> አኩመ ስኢፊ አቦቲኬቲፍ ከኩዻን ዋዳ ገሌ ሰነት ብየ ከነኣኖታት ስ ገልቼ ብየቲ ሲፍ ኬኑት፣ <verse eid="EXO 13:11"/><verse number="12" style="v" sid="EXO 13:12"/>አት ሀንገፈ ገደሜሰ በኑ ሁንደ <char style="nd">ዋቀዮፍ</char> ኬንተ። ኮርም ሆሪኬቲ ሀንገፍን ሁንድኑስ ከን <char style="nd">ዋቀዮት</char>። <verse eid="EXO 13:12"/><verse number="13" style="v" sid="EXO 13:13"/>ሀሬ ሀንገፈ ከምዩ እልሞ ሆላቲን ፉር፤ ዮ ፉሩ ባቴ ገሩ ሞርመሳ ጨብስ። እልማንኬ ኬሳስ ሀንገፈ ከምዩ ፉር።<verse eid="EXO 13:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 13:14"/>“በረ ዹፉፍ ጅሩ ኬሰ ዮ እልምኬ፣ ‘ኩን ማል ጄቹዸ?’ ጄዼ ስ ጋፈቴ አት አከነ ጄዺን፤ ‘<char style="nd">ዋቀዮ</char> ሀርከ ጀባዻን ግብጢ፣ መነ ገርቡማ ኬሳ ኑ ባሴ። <verse eid="EXO 13:14"/><verse number="15" style="v" sid="EXO 13:15"/>ዮሙ ፈረኦን መታ ጀባቴ ገድ ኑ ዺሱ ድዴት፣ <char style="nd">ዋቀዮ</char> ሀንገፈ ግብጥ ሁንደ ነማፊ ሆሪ አጄሴ። ሰበቢን አን ኮርመ ሀንገፈ ገደሜሰ በኑ ሁንደ <char style="nd">ዋቀዮፍ</char> ኣርሳ ዽኤሱፊ ሰበቢን አን እልማንኮ ኬሳ ሀንገፈ ሁንደ ፉሩፍ ከኑመ።’ <verse eid="EXO 13:15"/><verse number="16" style="v" sid="EXO 13:16"/><char style="nd">ዋቀዮ</char> እሬ ጀባዻን ግብጢ ኑ ባሱሳቲፍ ወን ኩን ሀርከኬረት መለቶ፣ አደኬረትስ መለቶ ተአ።”<verse eid="EXO 13:16"/></para>
  <para style="s1">ገላነ ጬኡ</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 13:17"/>ዬሮ ፈረኦን ሰበ ሰነ ገድ ዺሴት ከርች ገባባ ተኡዩ ዋቅን ከራ ብየ ፍልስጤምረ እሳን ህንቀጄልችኔ፤ ሰበቢንሳስ ዋቅን፣ “እሳን ዮ ወራን እሳን ሙደቴ ያደ ጌደረተኒ ግብጥት ዴብኡ ደንደአን” ጄዼት። <verse eid="EXO 13:17"/><verse number="18" style="v" sid="EXO 13:18"/>ከናፉ ዋቅን ከራ ናኖ ገሞጂቲን ገረ ገላነ ዲማት ሰበ ሰነ ቀጄልቼ። እስራኤሎንስ ወራናፍ ቆጳአኒ ብየ ግብጢቲ በአን።<verse eid="EXO 13:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 13:19"/>ሰበቢ ዮሴፍ፣ “ዋቅን ዹጉማን እስን ገርጋረ፤ እስንስ ጋፈስ ለፌኮ አሲ ፉዻ በኣ” ጄዼ እስራኤሎን ከከቺሴ ቱሬፍ ሙሴን ለፌ ዮሴፍ ፉዼ በኤ።<verse eid="EXO 13:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 13:20"/>እሳንስ ሱኮቲ ከአኒ ኤታም ኬሰ ቀርቀረ ገሞጂ ቁበተን። <verse eid="EXO 13:20"/><verse number="21" style="v" sid="EXO 13:21"/><char style="nd">ዋቀዮ</char> አከ እሳን ሀልከኒ ጉያ ዴሙ ደንደአኒፍ ጉያ ኡቱባ ዱሜሳቲን እሳን ዱረ ዴሜ ከራ እሳን አርግሲሴ፤ ሀልከንሞ እሳኒፍ እብሱፍ ጄዼ ኡቱባ እብዳቲን እሳን ዱረ ዴማ ቱሬ። <verse eid="EXO 13:21"/><verse number="22" style="v" sid="EXO 13:22"/>ኡቱባን ዱሜሳ ጉያ ጉያ፣ ኡቱባን እብዳሞ ሀልከን ሀልከን ኡመተ ዱራ ህንዸበምኔ ቱሬ።<verse eid="EXO 13:22"/></para>
  <chapter eid="EXO 13"/>
  <chapter number="14" style="c" sid="EXO 14"/>
  <para style="p">
    <verse number="1" style="v" sid="EXO 14:1"/>ኤርገሲ <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ <verse eid="EXO 14:1"/><verse number="2" style="v" sid="EXO 14:2"/>“አከ እሳን ኦፍረ ገረ ገለኒ ጲ ሀሂሮት ብረ፣ ምግዶሊፊ ገላነ ግዱ ቁበተን እስራኤሎተት ህም። እሳን ፉሌ በኣል ዜፎን፣ ገላነ ጭነ ቁበቹ ቀቡ። <verse eid="EXO 14:2"/><verse number="3" style="v" sid="EXO 14:3"/>ፈረኦንስ፣ ‘እስራኤሎን ቡርጃጀአኒ ብየ ኬሰ ጆራ ጅሩ፤ ገሞጂን እሳን መርሴረ’ ጄዼ ያዴ። <verse eid="EXO 14:3"/><verse number="4" style="v" sid="EXO 14:4"/>አንስ ገራ ፈረኦን ነንጀቤሰ፤ እን ፋነ ዸኤ እሳን ዱካ ቡአ። አንስ ከራ ፈረኦኒቲፊ ከራ ሎልቶተሳ ሁንዳቲን ኦፊኮቲፍ ኡልፍነ ነንአርገዸ፤ ወር ግብጥ አከ አን <char style="nd">ዋቀዮ</char> ተኤ ንቤኩ።” እስራኤሎንስ አከሱመ ጎዸን።<verse eid="EXO 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 14:5"/>ሞቲን ግብጥ አከ ሰብን ሱን በቀቴ በኤ ዮሙ እት ህመሜት ፈረኦኒፊ ቆንዳልቶትንሳ ያደ ዋኤ ሰበ ሰና ቀበን ጌደረተኒ፣ “አከ ሰብን እስራኤል ኑ ተጃጅሉ ዺሴ ዴሙፍ ገድ ዺሱንኬኘ ማል ጎቹኬኘ?” ጄዸን። <verse eid="EXO 14:5"/><verse number="6" style="v" sid="EXO 14:6"/>እንስ ጋሪሳ ቆጴፈቴ፣ ሎልቶተሳስ ፉዸቴ ከኤ። <verse eid="EXO 14:6"/><verse number="7" style="v" sid="EXO 14:7"/>ጋሪወን ፍለተሞ ዽበ ጀአ፣ ጋሪወን ግብጥ ብራ ሁንደ ከኔን አጀጁወን እሳን ሁንደረ ጅረን ፉዸቴ ከኤ። <verse eid="EXO 14:7"/><verse number="8" style="v" sid="EXO 14:8"/><char style="nd">ዋቀዮስ</char> ፈረኦን ሞትቸ ግብጥ መተ ጀቤሰ ጎዼ፤ ፈረኦንስ እስራኤሎተ ወረ ሶዳ መሌ በኣ ቱረን ሰነ ዱካ ቡኤ አርኤ። <verse eid="EXO 14:8"/><verse number="9" style="v" sid="EXO 14:9"/>ወር ግብጥስ ፈርዴኒፊ ጋሪወን ፈረኦን ሁንድ፣ አቦቲን ፈርዳቲፊ ሎልቶትን ለፎን እስራኤሎተ ዱካ ቡአኒ እሳኒ ጲ ሀሂሮት ብረ ፉሌ በኣል ዜፎን ቀርቀረ ገላና ቁበተኒ ጅረን ቀቀበን።<verse eid="EXO 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 14:10"/>ዬሮ ፈረኦን እት ዽኣቴትስ እስራኤሎን ኦል እላለኒ ኩኖ ወር ግብጥ ዱግደ ዱባን እሳን ፋነ ዹፈን አርገን። እሳንስ ሶዳተኒ <char style="nd">ዋቀዮት</char> እየተን። <verse eid="EXO 14:10"/><verse number="11" style="v" sid="EXO 14:11"/>እሳንስ ሙሴዻን አከነ ጄዸን፤ “አት ዋን እዶን አዋላ ግብጥ ህንጅሬፍ አከ ኑ ገሞጂ ኬሰት ዹምኑፍ አስ ኑ ፍዴ? አት ግብጥ ኑ ባሱንኬ ማል ኑ ጎቹኬት? <verse eid="EXO 14:11"/><verse number="12" style="v" sid="EXO 14:12"/>ኑ ግብጥ ኬሰት፣ ‘አከ ወረ ግብጥ ተጃጅሉፍ ኑ ዺስ’ ሲን ህንጄኔ? ገሞጂ ኬሰት ዹሙረ ወረ ግብጥ ተጃጅሉ ኑ ወየ ቱሬ!”<verse eid="EXO 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 14:13"/>ሙሴን አከነ ጄዼ ሰበ ሰናፍ ዴብሴ፤ “ህንሶዳትና፤ ጀባዻ ዻበዻ! ፈይሱ <char style="nd">ዋቀዮ</char> ከን እን ሀርአ እስኒ ጎዹ እላላ! ወረ ግብጥ ከን ሀርአ አርግተን ከነ ለመተ ዴብተኒ ህንአርግተን። <verse eid="EXO 14:13"/><verse number="14" style="v" sid="EXO 14:14"/><char style="nd">ዋቀዮ</char> እስኒፍ ሎለ፤ እስን ገብ ጄዻ።”<verse eid="EXO 14:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 14:15"/>
    <char style="nd">ዋቀዮስ</char> ሙሴዻን አከነ ጄዼ፤ “አት ማሊፍ ነት እይተ? አከ እሳን አዴምሰሳኒ እት ፉፈኒፍ እስራኤሎተት ህም። <verse eid="EXO 14:15"/><verse number="16" style="v" sid="EXO 14:16"/>ኡሌኬ ኦል ፉዺቲ ሀርከኬ ገላነረ ድሪርፈዹ፤ አከ እስራኤሎን ለፈ ጎጋረ ገላነ ግዱ ደርበኒፍ ብሻን ገርገር ቆድ። <verse eid="EXO 14:16"/><verse number="17" style="v" sid="EXO 14:17"/>አንሞ አከ እሳን ዱግደሳኒ ዱባን ሴነኒፍ ገራ ወረ ግብጥ ነንጀቤሰ። አንስ ፈረኦኒፊ ሎልቶተሳ ሁንደረት፣ ጋሪወንሳቲፊ አቦቲ ፈርዳሳረት ኡልፍነ ነንአርገዸ። <verse eid="EXO 14:17"/><verse number="18" style="v" sid="EXO 14:18"/>ዬሮ አን ፈረኦንረት፣ ጋሪወንሳቲፊ አቦቲ ፈርዳሳረት ኡልፍነ አርገዹት ወር ግብጥ አከ አን <char style="nd">ዋቀዮ</char> ተኤ ንቤኩ።”<verse eid="EXO 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 14:19"/>ዮሙስ ኤርገማን ዋቀዮ ከን ሰበ እስራኤል ዱረ ዴማ ቱሬ ሱን ከኤ ገረ ዱግደሳኒ ዱባት ደርቤ። ኡቱባን ዱሜሳ ሱንስ ፉለሳኒ ዱራ ከኤ እሳን ዱበ ዻበቴ፤ <verse eid="EXO 14:19"/><verse number="20" style="v" sid="EXO 14:20"/>ኡቱባን ሱንስ ሎልቶተ ግብጢፊ ሎልቶተ እስራኤል ግዱ ሴኔ። ዱሜስ ሱን ሀልከን ሰነ ገመ ቶኮት ዱከነ፣ ገመ ካንትሞ እፈ ፍዴ፤ ከናፉ ሀልከን ሰነ ጉቱ ገሬ ለማን ኬሳ ቶኮሌ ገሬ ካንት ህንዽኣትኔ።<verse eid="EXO 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 14:21"/>ሙሴንስ ሀርከሳ ገላነረ ድሪርፈቴ፤ <char style="nd">ዋቀዮስ</char> ሀልከን ሰነ ጉቱ ቡቤ በአ ቢፍቱ ጀባዻን ገላንቸ ገረ ዱባት ዴብሴ ገላንቸ ለፈ ጎጋ ጎዼ። ብሻን ሱንስ ገርገር ቆደሜ፤ <verse eid="EXO 14:21"/><verse number="22" style="v" sid="EXO 14:22"/>እስራኤሎንስ ገላንቸ ግዱ ለፈ ጎጋረ ደርበን፤ ብሻንችስ ከራ ምርጋሳኒቲፊ ከራ ብታሳኒ ኬኘን ተኤፍ።<verse eid="EXO 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 14:23"/>ወር ግብጥ እሳን ዱካ ቡአኒ ፈርዴን ፈረኦን፣ ጋሪወንሳቲፊ አቦቲን ፈርዳሳ ገላነ ሴነን። <verse eid="EXO 14:23"/><verse number="24" style="v" sid="EXO 14:24"/>ዮሙ ለፍት በርኤት <char style="nd">ዋቀዮ</char> ኡቱባ እብዳቲፊ ዱሜሳ ኬሳ ሎልቶተ ግብጥ ሰነ ገድ እላሌ ገረ እት ጎረን እሳን ወላልችሴ። <verse eid="EXO 14:24"/><verse number="25" style="v" sid="EXO 14:25"/>አከ እሳን ረክናን ኦፈኒፍስ ጎማ ጋሪወንሳኒ እራ ባሴ። ወር ግብጥስ፣ “ዋን <char style="nd">ዋቀዮ</char> ገመ እስራኤሎታ ዻበቴ ወረ ግብጥ ሎላ ጅሩፍ ኮታ እሳን ዱራ በቀትና” ጄዸን።<verse eid="EXO 14:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 14:26"/>
    <char style="nd">ዋቀዮስ</char> ሙሴዻን፣ “አከ ብሻኖትን ወረ ግብጥረ፣ ጋሪወኒፊ አቦቲ ፈርዳሳኒረ ገረገለኒፍ ሀርከኬ ገላነረት ድሪርስ” ጄዼ። <verse eid="EXO 14:26"/><verse number="27" style="v" sid="EXO 14:27"/>ሙሴንስ ሀርከሳ ገላንቸረት ድሪርሴ፤ ዬሮ ለፍት በርኤትስ ገላን ሱን እዶሳት ዴብኤ። ወር ግብጥስ ብሻን ሰነ ጀላ በቀተን፤ <char style="nd">ዋቀዮስ</char> ሀጣኤ ገላነት እሳን ነቄ። <verse eid="EXO 14:27"/><verse number="28" style="v" sid="EXO 14:28"/>ብሻን ሱን እዶሳት ዴብኤ ጋሪወኒፊ አቦቲ ፈርዳ ጄቹንስ ሎልቶተ ፈረኦን ከኔን እስራኤሎተ ዱካ ቡአኒ ገላነ ሴነን ሰነ ሁንደ ልቅምሴ። እሳን ኬሳስ ነምን ቶኮዩ ህንሀፍኔ።<verse eid="EXO 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 14:29"/>እስራኤሎን ገሩ ብሻንች ከራ ምርገሳኒቲፊ ከራ ብታሳኒቲን ኬኘን ተኤፊ ገላንቸ ኬሰ ለፈ ጎጋረ ደርበን። <verse eid="EXO 14:29"/><verse number="30" style="v" sid="EXO 14:30"/>ጋፈስ <char style="nd">ዋቀዮ</char> ሀርከ ወረ ግብጥ ጀላ እስራኤሎተ ባሴ፤ ወር እስራኤልስ ሬፈ ወረ ግብጥ ቀርቀረ ገላናት አርገን። <verse eid="EXO 14:30"/><verse number="31" style="v" sid="EXO 14:31"/>እስራኤሎንስ ዮሙ ሁምነ ጉዳ ከን <char style="nd">ዋቀዮ</char> ወረ ግብጥረት ሙልእሴ ሰነ አርገንት፣ <char style="nd">ዋቀዮን</char> ሶዳተን፤ እሳንስ <char style="nd">ዋቀዮፊ</char> ተጃጅላሳ ሙሴ አመነን።<verse eid="EXO 14:31"/></para>
  <chapter eid="EXO 14"/>
  <chapter number="15" style="c" sid="EXO 15"/>
  <para style="s1">ፋርፈትና ሙሴቲፊ ሚርያም</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 15:1"/>ዮሙስ ሙሴፊ እስራኤሎን ፋርፈትና ከነ <char style="nd">ዋቀዮፍ</char> ፋርፈተን፦</para>
  <para style="q1" vid="EXO 15:1">“አን <char style="nd">ዋቀዮፍ</char> ነንፋርፈዸ፤</para>
  <para style="q2" vid="EXO 15:1">እን ኦል ኦል ጄዼራቲ።</para>
  <para style="q1" vid="EXO 15:1">እን ፈርዳፊ ነምቸ ፈርደ ያበቴ</para>
  <para style="q2" vid="EXO 15:1">ገላነት ገድ ደርበቴረ።<verse eid="EXO 15:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="EXO 15:2"/>“<char style="nd">ዋቀዮ</char> ጀብነኮቲፊ ፋርፈትናኮት፤</para>
  <para style="q2" vid="EXO 15:2">እን ፈይነኮ ተኤረ።</para>
  <para style="q1" vid="EXO 15:2">እን ዋቀኮት፤ አንስ እሰ ነንጀጀዸ፤</para>
  <para style="q2" vid="EXO 15:2">እን ዋቀ አባኮቲት፤ አንስ እሰ ኦል ኦል ነንቀበ።<verse eid="EXO 15:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="EXO 15:3"/>
    <char style="nd">ዋቀዮ</char> ጎተ ወራናት፤</para>
  <para style="q2" vid="EXO 15:3">መቃንሳ <char style="nd">ዋቀዮ</char>።<verse eid="EXO 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="EXO 15:4"/>እን ጋሪወን ፈረኦኒፊ ሎልቶተሳ</para>
  <para style="q2" vid="EXO 15:4">ገላነት ገድ ደርበቴረ።</para>
  <para style="q1" vid="EXO 15:4">ቆንዳልቶተ ፈረኦን ኬሳ ፍለተምቶትን፣</para>
  <para style="q2" vid="EXO 15:4">ገላነ ዲማ ኬሰ ዽዽመኒሩ።<verse eid="EXO 15:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="EXO 15:5"/>ቱጁብን እሳንረ ገረ ገሌ፤</para>
  <para style="q2" vid="EXO 15:5">እሳንስ አኩመ ዸጋ ቱጁበት ገድ ዽዽመን።<verse eid="EXO 15:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="EXO 15:6"/>ያ <char style="nd">ዋቀዮ</char>፣</para>
  <para style="q2" vid="EXO 15:6">ሀርክኬ ምርጋ ሁምናን ኡልፍነ ቀቤሰ።</para>
  <para style="q1" vid="EXO 15:6">ያ <char style="nd">ዋቀዮ</char>፣</para>
  <para style="q2" vid="EXO 15:6">ሀርክኬ ምርጋ ዲነ ንሁሬሰ።<verse eid="EXO 15:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="EXO 15:7"/>“አት ጉድነ ኡልፍነኬቲቲን</para>
  <para style="q2" vid="EXO 15:7">ወረ ሲን ሞርመን ገድ ደርበቴ።</para>
  <para style="q1" vid="EXO 15:7">ኣሪኬ ቦበኣ ንኤርግቴ፤</para>
  <para style="q2" vid="EXO 15:7">እንስ አኩመ ሀበቂት ጉቤ እሳን ፍጤ።<verse eid="EXO 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="EXO 15:8"/>ሀፉረ ፉኛንኬቲቲን</para>
  <para style="q2" vid="EXO 15:8">ብሻኖትን ቱለመን።</para>
  <para style="q1" vid="EXO 15:8">ብሻን ያኡ አኩመ ኬኘኒት ኦል ዻበቴ፤</para>
  <para style="q2" vid="EXO 15:8">ቱጁቦንስ ወለካ ገላናት እትተን።<verse eid="EXO 15:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="EXO 15:9"/>ዲን፣ ‘አን ፋነ ቡኤ እሳን ቀቀበ።</para>
  <para style="q2" vid="EXO 15:9">ቦጁ ነንቆደዸ፤</para>
  <para style="q2" vid="EXO 15:9">አን እሳንረት ፌዺኮ ነንጉተዸ።</para>
  <para style="q1" vid="EXO 15:9">ጎራዴኮ ነንሉቅፈዸ፤</para>
  <para style="q2" vid="EXO 15:9">ሀርክኮ እሳን በርበዴሰ’ ጄዼ ነንዻደቴ።<verse eid="EXO 15:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="EXO 15:10"/>አት ገሩ ቡቤኬ እት ቡብፍቴ፤</para>
  <para style="q2" vid="EXO 15:10">ገላንሞ እሳንረ ገረ ገሌ።</para>
  <para style="q1" vid="EXO 15:10">እሳንስ አኩመ ስቢላ</para>
  <para style="q2" vid="EXO 15:10">ብሻኖተ ጀጀቦዻን ልቅምፈመን።<verse eid="EXO 15:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="EXO 15:11"/>ያ <char style="nd">ዋቀዮ</char>፣</para>
  <para style="q2" vid="EXO 15:11">ዋቆተ ኬሳ ኤኙቱ ስ ፈካተ?</para>
  <para style="q1" vid="EXO 15:11">ቁልቁልናን ስምቦ ቀቤስ፣</para>
  <para style="q2" vid="EXO 15:11">ኡልፍናን ሶዳችሳን፣</para>
  <para style="q1" vid="EXO 15:11">ሆጂ ድንቂ ሆጄቹትስ</para>
  <para style="q2" vid="EXO 15:11">ከን አከኬቲ ኤኙ?<verse eid="EXO 15:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="EXO 15:12"/>“አት ሀርከኬ ምርጋ ድሪርፈናን፣</para>
  <para style="q2" vid="EXO 15:12">ለፍት እሳን ልቅምስቴ።<verse eid="EXO 15:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="EXO 15:13"/>አት ሰበ ፉርቴ ሰነ፣</para>
  <para style="q2" vid="EXO 15:13">ጃለለኬ ህንጌደረምኔን ጌጌስተ።</para>
  <para style="q1" vid="EXO 15:13">ጀብነኬቲንስ</para>
  <para style="q2" vid="EXO 15:13">ገረ እዶ ጅሬኘኬቲ ቁልቁሉት እሳን ቀጄልችተ።<verse eid="EXO 15:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="EXO 15:14"/>ሰቦትን ዸገአኒ ሆለቱ፤</para>
  <para style="q2" vid="EXO 15:14">ሙደምሱንስ ሰበ ፍልስጤም ቀበቴ።<verse eid="EXO 15:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="EXO 15:15"/>ሀንገፎትን ኤዶም ንርፈቱ፤</para>
  <para style="q2" vid="EXO 15:15">ቡልችቶተ ሞኣብስ ናሱቱ ቀበተ፤</para>
  <para style="q1" vid="EXO 15:15">ወር ከነኣንስ ብሻኑመ ተኡ፤<verse eid="EXO 15:15"/></para>
  <para style="q2">
    <verse number="16" style="v" sid="EXO 15:16"/>ሶዳፊ አብዲ ኩተቹን እሳንረ ቡአ።</para>
  <para style="q1" vid="EXO 15:16">ያ <char style="nd">ዋቀዮ</char>፣ ሀመ ሰብንኬ ደርቡት፣</para>
  <para style="q2" vid="EXO 15:16">ሀመ ሰብን አት ብተቴ ሱን ደርቡት</para>
  <para style="q1" vid="EXO 15:16">ጀብነ ሀርከኬቲቲን</para>
  <para style="q2" vid="EXO 15:16">እሳን አኩመ ዸጋ ጨልእሱ።<verse eid="EXO 15:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="EXO 15:17"/>ያ <char style="nd">ዋቀዮ</char>፣ አት ገረ ቱሉ ዻለኬቲት፣</para>
  <para style="q2" vid="EXO 15:17">ገረ ለፈ እዶ ጅሬኘኬቲ ጎዸቹፍ ቶልፈቴት፣</para>
  <para style="q1" vid="EXO 15:17">ያ ጎፍታ አት ገረ እዶ ቁልቁሉ ሀርክኬ ሁንዴሴት</para>
  <para style="q2" vid="EXO 15:17">ኦል ገልችቴ እሳን ዻብደ።<verse eid="EXO 15:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="EXO 15:18"/>“<char style="nd">ዋቀዮ</char>፣</para>
  <para style="q2" vid="EXO 15:18">በረ በራ ሀመ በረ በራት ሞአ።”<verse eid="EXO 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 15:19"/>ዮሙ ፈርዴን፣ ጋሪወኒፊ አቦቲን ፈርዳ ከን ፈረኦን ገላነ ሴነንት <char style="nd">ዋቀዮ</char> ብሻኖተ እሳንረ ገረገልቼ፤ እስራኤሎን ገሩ ለፈ ጎጋረ ዴመኒ ገላነ ኬሰ ደርበን። <verse eid="EXO 15:19"/><verse number="20" style="v" sid="EXO 15:20"/>ሚርያም ኦቦሌቲን አሮን ራጅቲን ሱን ድቤ ሀርከት ቀበቴ ካቴ፤ ዱበርቶትን ሁንድኑስ ድቤሳኒ ፉዸተኒ ስርባ እሼ ፋነ ቡአን። <verse eid="EXO 15:20"/><verse number="21" style="v" sid="EXO 15:21"/>ሚርያምስ አከነ ጄቴ እሳኒፍ ፋርፈቴ፦</para>
  <para style="q1" vid="EXO 15:21">“<char style="nd">ዋቀዮ</char> ፋርፈዻ፤</para>
  <para style="q2" vid="EXO 15:21">እን ኡልፍናን ሞአቴራቲ።</para>
  <para style="q1" vid="EXO 15:21">እን ፈርዳፊ ነምቸ ፈርደ ያበቴ</para>
  <para style="q2" vid="EXO 15:21">ገላነት ገድ ደርበቴረ።”<verse eid="EXO 15:21"/></para>
  <para style="s1">ብሻን ማራቲፊ ብሻን ኤልም</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 15:22"/>ሙሴንስ ሰበ እስራኤል ገላነ ዲማ ብራ ፉዼ ቀጄልቼ፤ እሳንስ ገሞጂ ሹር ሴነን። እስራኤሎንስ ኡቱ ብሻን ህንአርገን ጉያ ሰዲ ገሞጂ ኬሰ ዴመን። <verse eid="EXO 15:22"/><verse number="23" style="v" sid="EXO 15:23"/>እሳንስ ዮሙ ማራ ገአንት ብሻንሳ ዹጉ ህንደንዴኜ፤ ብሻን ሱን ሀዻኣ ቱሬቲ። ወን እዶን ሱን ማራ ጄዸሜፍስ ከኑመ። <verse eid="EXO 15:23"/><verse number="24" style="v" sid="EXO 15:24"/>ጀር ሱንስ፣ “ኑ ማል ሃዹግኑ?” ጄዸኒ ሙሴት ጉንጉመን።<verse eid="EXO 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 15:25"/>ዮሙስ ሙሴን <char style="nd">ዋቀዮት</char> እይናን፣ <char style="nd">ዋቀዮ</char> ሙከ ቶኮ እሰ አርግሲሴ። እንስ ሙከ ሰነ ብሻንት ገድ ደርበቴ፤ ብሻን ሱንስ ንምኣዌ።</para>
  <para style="p" vid="EXO 15:25">
    <char style="nd">ዋቀዮስ</char> እዶ ሰነት ስርናፊ ሴረ እሳኒፍ ባሴ፤ አችትስ እሳን ቆሬ። <verse eid="EXO 15:25"/><verse number="26" style="v" sid="EXO 15:26"/>እንስ አከነ ጄዼ፤ “አት ዮ ሰገሌ <char style="nd">ዋቀዮ</char> ዋቀኬቲ ገራ ቶኮን ዸጌሴ፣ ዮ ዋን ፉለሳ ዱረት ቀጄላ ተኤ ሆጄቴ፣ ዮ አጀጀሳ ቀልቤፈቴፊ ዮ ሴረሳ ሁንደ ኤግዴ፣ አን ዹኩበ ወረ ግብጥት ፍዴ ሰነ ኬሳ ቶኮዩ ስት ህንፍዱ፤ አን <char style="nd">ዋቀዮ</char> ስ ፈይሱዻቲ።”<verse eid="EXO 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 15:27"/>እሳንስ ገረ ኤልም እዶ ቡርቃን ኩዸ ለማፊ ሙኬን ሜጢ ቶርባተምን ቱረን ዹፈኒ አች ብሻን ብረ ቁበተን።<verse eid="EXO 15:27"/></para>
  <chapter eid="EXO 15"/>
  <chapter number="16" style="c" sid="EXO 16"/>
  <para style="s1">መናፊ ድምብርቄ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 16:1"/>ወልዳን እስራኤል ሁንድ ብየ ግብጢቲ በአኒ ጅአ ለመፋት፣ ጅአ ሰነ ኬሳስ ጉያ ኩዸ ሸነፋት ኤሊሚ ከአኒ ገረ ገሞጂ ሲን እሰ ኤልሚፊ ሲና ግዱ ጅሩ ሰና ዸቀን። <verse eid="EXO 16:1"/><verse number="2" style="v" sid="EXO 16:2"/>ገሞጂ ኬሰትስ ሀዋስን ሱን ጉቱን ሙሴፊ አሮንት ጉንጉመን። <verse eid="EXO 16:2"/><verse number="3" style="v" sid="EXO 16:3"/>እስራኤሎንስ አከነ እሳኒን ጄዸን፤ “ኑ ብየ ግብጥት ዬሮ ኦኮቴ ፎኒ ብረ ቴኜ ሀመ ቁፍኑት ቡዴነ ኛቻ ቱሬ ሰነ ሀርከ <char style="nd">ዋቀዮት</char> ኡቱ ዱኔረ ተኤ! እስን ገሩ አከ ወልዳን ኩን ጉቱን ቤለኤ ዹሙ ጎቹፍ አቺ ኑ ባፍተኒ ገሞጂ ከነት ኑ ፍደኒርቱ።”<verse eid="EXO 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 16:4"/>
    <char style="nd">ዋቀዮ</char>ሞ ሙሴዻን አከነ ጄዼ፤ “ኩኖ፣ አን ሰሚራ ቡዴነ ገድ እስኒ ነንሮብሰ። ሰብን ሱንስ ጉዩመ ጉያን ገድ በኤ ዋን ጉያ ቶኮፍ እሰ ገኡ ወልት ሃቀበቱ። አንስ ከራ ከናን እሳን ቆሬ ሴረኮ ኤጉፊ ኤጉ ባቹሳኒ ነንእላለ። <verse eid="EXO 16:4"/><verse number="5" style="v" sid="EXO 16:5"/>እሳንስ ጉያ ጀአፋት ዋን ወልት ቀበተን ሰነ ሃቆጴፈተን፤ ወን ኩንስ ዋን እሳን ጉያ ብራ ወልት ቀበተንት ሀርከ ለመ ሃተኡ።”<verse eid="EXO 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 16:6"/>ሙሴፊ አሮን እስራኤሎተ ሁንዳን አከነ ጄዸን፤ “ከን ብየ ግብጢቲ እስን ባሴ <char style="nd">ዋቀዮ</char> አከ ተኤ ገልገለ ከነ ንቤክቱ። <verse eid="EXO 16:6"/><verse number="7" style="v" sid="EXO 16:7"/>ገነመሞ ኡልፍነ <char style="nd">ዋቀዮ</char> አርግቱ፤ እን አከ እስን እሰት ጉንጉምተን ዸገኤራቲ። ኑ ኤኙ ታናን እስን ኑት ጉንጉምቱ?” <verse eid="EXO 16:7"/><verse number="8" style="v" sid="EXO 16:8"/>ሙሴንስ አከነ ጄዼ፤ “ዬሮ እን አከ እስን ኛተኒፍ ገልገለ ፎን፣ ገነመሞ ቡዴነ እስን በርባደን ሁንደ እስኒ ኬኑት እስን አከ እን <char style="nd">ዋቀዮ</char> ተኤ ንቤክቱ፤ እን ጉንጉሚ እስን እሰት ጉንጉምተን ዸገኤራቲ። ኑ ኤኙዸ? እስን <char style="nd">ዋቀዮት</char> ጉንጉማ ጅርቱ መሌ ኑት ህንጉንጉምኔ።”<verse eid="EXO 16:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 16:9"/>ዮሙስ ሙሴን፣ “ወልዳ እስራኤል ሁንዳን፣ ‘ሰበቢ እን አከ እስን ጉንጉምተን ዸገኤፍ እስን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዽኣዻ’ ጄዽ” ጄዼ አሮንት ህሜ።<verse eid="EXO 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 16:10"/>ዬሮ አሮን ጉቱማ ወልዳ ሰበ እስራኤልት ዱበቻ ቱሬት እሳን ገረ ገሞጂ እላላ ቱረን፤ ኩኖ፣ ኡልፍን <char style="nd">ዋቀዮ</char> ዱሜሰ ኬሳን ሙልአቴ።<verse eid="EXO 16:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 16:11"/>
    <char style="nd">ዋቀዮስ</char> ሙሴዻን አከነ ጄዼ፤ <verse eid="EXO 16:11"/><verse number="12" style="v" sid="EXO 16:12"/>“አን ጉንጉሚ ሰበ እስራኤል ዸገኤረ። አትሞ፣ ‘እስን ዬሮ ለፍት ድምምሶፍቱት ፎን ኛቱ፤ ገነመሞ ቡዴነ ኛተኒ ቁፍቱ። እስንስ ዬሮ ሰነ አከ አን <char style="nd">ዋቀዮ</char> ዋቀኬሰን ተኤ ንቤክቱ’ ጄዺ እሳንት ህም።”<verse eid="EXO 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 16:13"/>ገልገሉመ ሰነ ድምብርቄን ዹፍቴ እዶ ቁበትና ሰነ ጉቴ፤ ጉያ እት ኣኑ ገነመሞ ፍጤንስ ናኖ ቁበትና ሰና ቱሬ። <verse eid="EXO 16:13"/><verse number="14" style="v" sid="EXO 16:14"/>ዮሙ ፍጤንስ ቡኤትስ፣ ኩኖ ወንቶትን ሀጲን አከ ቆራ ለፈራ አዳተን ድሬ ገሞጂረ ቡቡአን። <verse eid="EXO 16:14"/><verse number="15" style="v" sid="EXO 16:15"/>እስራኤሎንስ ዮሙ ዋን ከነ አርገንት፣ “ወን ኩን ማል?” ወሊን ጄዸን። እሳን ወን ሱን ማል አከ ተኤ ህንቤክኔ ቱሬቲ።</para>
  <para style="p" vid="EXO 16:15">ሙሴንስ አከነ እሳኒን ጄዼ፤ “ወን ኩን ቡዴነ አከ እስን ኛተኒፍ <char style="nd">ዋቀዮ</char> እስኒፍ ኬኔዸ። <verse eid="EXO 16:15"/><verse number="16" style="v" sid="EXO 16:16"/><char style="nd">ዋቀዮ</char> አከነ ጄዼ አጀጄረ፦ ‘ቶኮን ቶኮን ነማ ሀመ በርባዱ ወልት ሃቀበቱ። አኩመ ባይእነ ነመ ዱንካነኬሰን ኬሳት ቶኮ ቶኮ ነማቲፍ ጎሞሪ ቶኮ ፉዸዻ።’ ”<verse eid="EXO 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 16:17"/>እስራኤሎን አኩመ እሳንት ህመሜ ጎዸን፤ ገር ቶኮ ባይኤ፣ ወር ካንሞ ጥኖ ወልት ቀበተን። <verse eid="EXO 16:17"/><verse number="18" style="v" sid="EXO 16:18"/>ዮሙ እሳን ጎሞሪዻን ሰፈረንት እሰ ባይኤ ወልት ቀበቴራ ህንሀፍኔ፤ እሰ ጥኖ ወልት ቀበቴትስ ህንህርአትኔ። ቶኮን ቶኮን ነማ ሀሙመ በርባዱ ወልት ቀበቴ።<verse eid="EXO 16:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 16:19"/>ሙሴንስ፣ “ነምን ቶኮዩ ዋን ወልት ቀበቴ ኬሳ ቶኮሌ ገነማፍ ህንቡልፈትን” ጄዼን።<verse eid="EXO 16:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 16:20"/>ተኡስ እሳን ኬሳ ነሞትን ቶኮ ቶኮ ሙሴ ህንዸጌኜ፤ ዋን ወልት ቀበተን ኬሳስ ገርቶኮ ገነማፍ ቡልፈተን፤ እንስ ራመኤ አጃኤ። ከናፉ ሙሴን እሳንት ኣሬ።<verse eid="EXO 16:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 16:21"/>ቶኮን ቶኮን ነማ ገነመ ገነመ ሀሙመ በርባዱ ወልት ቀበቴ፤ እንስ ዮሙ አዱን ሆእቴት በቄ በዴ። <verse eid="EXO 16:21"/><verse number="22" style="v" sid="EXO 16:22"/>ጉያ ጀአፋት ጀር ሀርከ ለመ ጄቹንስ መተ መታት ጎሞሪ ለመ ወልት ቀበተን፤ ሆገንቶትን ወልድቻ ሁንድስ ዸቀኒ ሙሴት ህመን። <verse eid="EXO 16:22"/><verse number="23" style="v" sid="EXO 16:23"/>እንስ አከነ ጄዼን፤ “<char style="nd">ዋቀዮ</char> አከነ ጄዼ አጀጄ፦ ‘ቦር ጉያ ሰንበተ ቦቆና ተአ፤ እንስ ሰንበተ <char style="nd">ዋቀዮፍ</char> ቁልቁላኤዸ። ዋን ቶልፈቹ በርባደን ቶልፈዻ፤ ዋን አፌለቹ በርባደንስ አፌለዻ። ዋንራ ሀፉ ሁንደሞ ሀመ ገነማት ቱርፈዻ።’ ”<verse eid="EXO 16:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 16:24"/>ጀርስ አኩመ ሙሴን እሳን አጀጄት ሀመ ገነማት ቱርፈተን፤ ኛትን ሱንስ ህንአጆፍኔ ዮካን ህንራሞፍኔ። <verse eid="EXO 16:24"/><verse number="25" style="v" sid="EXO 16:25"/>ሙሴንስ አከነ ጄዼ፤ “ዋን ጉያን ሀርኣ ሰንበተ <char style="nd">ዋቀዮ</char> ተኤፍ ኛተ ከነ ሀርአ ኛዻ፤ እስን ሀርአ ድሬረት እሰ ህንአርገተን። <verse eid="EXO 16:25"/><verse number="26" style="v" sid="EXO 16:26"/>እስንስ ኛተ ሰነ ጉያ ጀአ ወልት ቀበዻ፤ ጉያ ቶርበፋት ጄቹንስ ጉያ ሰንበታቲን ገሩ ቶኮዩ ህንአርገሙ።”<verse eid="EXO 16:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 16:27"/>ጀረ ሰነ ኬሳ ነሞትን ቶኮ ቶኮሞ ጉያ ቶርበፋት ወልት ቀበቹፍ ገድ በአን፤ ገሩ ሆማ ህንአርገኔ። <verse eid="EXO 16:27"/><verse number="28" style="v" sid="EXO 16:28"/>ከነረት <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ “እስን ሀመ ዮሚት አጀጀኮፊ ቀጄልፈመኮ ኤጉ ድዱ? <verse eid="EXO 16:28"/><verse number="29" style="v" sid="EXO 16:29"/><char style="nd">ዋቀዮ</char> ሰንበተ አከ እስኒ ኬኔ ሁበዻ። ሰበቢን እን ጉያ ጀአፋት ቡዴነ ጉያ ለማፍ ተኡ እስኒ ኬኑፍስ ከኑመ። ነምን ሁንድኑ ጉያ ቶርበፋት እዱመ ጅሩ ሃቱሩ። ነምን ቶኮዩ ገድ ህንበእን።” <verse eid="EXO 16:29"/><verse number="30" style="v" sid="EXO 16:30"/>ሰብን ሱንስ ጉያ ቶርበፋት ንቦቆቴ።<verse eid="EXO 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 16:31"/>ሰብን እስራኤል ቡዴነ ሰነ “መና” ጄዼ ሞጋሴ። መናን ኩንስ ሰኚ ድንብላላ ፈካተ፤ አዲዸስ፤ ምኣንሳስ አከ ብጥሌ ደማን ቶልፈሜት። <verse eid="EXO 16:31"/><verse number="32" style="v" sid="EXO 16:32"/>ሙሴን አከነ ጄዼ፤ “<char style="nd">ዋቀዮ</char> አከነ ጄዼ አጀጄ፦ ‘አከ እን ዸሎተ ዹፉፍ ቱርፈሙፍ መና ጎሞሪ ቶኮ ፉዻ፤ ኩንስ አከ እሳን ቡዴነ አን ዬሮ ብየ ግብጥ ኬሳ እስን ባሴት አከ እስን ገሞጂ ኬሰት ኛተኒፍ እስኒ ኬኔ ሰነ አርገኒፍ።’ ”<verse eid="EXO 16:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 16:33"/>ሙሴን አሮኒን፣ “ኦኮቴ ቶኮ ፉዺቲ መና ጎሞሪ ቶኮ እት ነቅ፤ አከ መናን ኩን ዸሎተ ዹፉፍ ቱርፈሙፍ ፉለ <char style="nd">ዋቀዮ</char> ዱረ ካእ” ጄዼ።<verse eid="EXO 16:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="EXO 16:34"/>አሮንስ አኩመ <char style="nd">ዋቀዮ</char> ሙሴ አጀጄ ሰነት አከ መናን ሱን ቱርፈሙፍ ፉለ ዹጋ በኡ ዱረ ካኤ። <verse eid="EXO 16:34"/><verse number="35" style="v" sid="EXO 16:35"/>ሰብን እስራኤል ሀመ ብየ ኬሰ ቁበተሙ ሰነ ገአንት ወጋ አፉርተመ መና ኛተን፤ እሳንስ ሀመ ዳሪ ብየ ከነኣን ገአንት መና ኛተን።<verse eid="EXO 16:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="EXO 16:36"/>ጎሞሪን ቶኮ ሀርከ ኩርነፋ ኢፊ ቶኮት።<verse eid="EXO 16:36"/></para>
  <chapter eid="EXO 16"/>
  <chapter number="17" style="c" sid="EXO 17"/>
  <para style="s1">ብሻን ከታ ኬሳ ቡርቄ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 17:1"/>ወልዳን እጆሌ እስራኤል ሁንድ አኩመ <char style="nd">ዋቀዮ</char> አጀጄት ገሞጂ ሲኒቲ ከአኒ እዶ ቶኮራ ገረ እዶ ብራት ደርባ ዸቀኒ ሬፊዲም ቁበተን። ገሩ ሰብን ሱን ብሻን ዹጋቲ ህንአርገኔ። <verse eid="EXO 17:1"/><verse number="2" style="v" sid="EXO 17:2"/>ከናፉ እሳን፣ “ብሻን ዹግኑ ኑ ኬን” ጄዸኒ ሙሴ ሎለን።</para>
  <para style="p" vid="EXO 17:2">ሙሴንሞ ዴብሴ፣ “እስን ማሊፍ ነ ሎልቱ? <char style="nd">ዋቀዮስ</char> ማሊፍ ቆርቱ?” ጄዼን።<verse eid="EXO 17:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 17:3"/>ጀርስ ብሻን ዼቦተኒ ሙሴት ጉንጉመን፤ አከነስ ጄዸን፤ “አት ማሊፍ አከ ኑ፣ እጆሌንኬኛፊ ሆሪንኬኘ ዼቡን ዹምኑፍ ብየ ግብጢቲ ኑ ባፍቴ?”<verse eid="EXO 17:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 17:4"/>ከነረት ሙሴን ገረ <char style="nd">ዋቀዮት</char> እዬ፣ “አን ሰበ ከነ ማልን ጎዸ? እሳን ዸጋን ነ ቱሙፍ ጥኑመቱ ሀፌ” ጄዼ።<verse eid="EXO 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 17:5"/>
    <char style="nd">ዋቀዮ</char>ሞ አከነ ጄዼ ሙሴፍ ዴቢ ኬኔ፤ “ሰበ ከነ ዱረ ደርቢ ዴም። ማንጉዶተ እስራኤል ኬሳ ቶኮ ቶኮ ኦፍ ፋነ ፉዸዹቲ ኡሌ እቲን ለገ አበያ ዾፍቴ ሰነ ሀርከት ቀበዹ ዴም። <verse eid="EXO 17:5"/><verse number="6" style="v" sid="EXO 17:6"/>ኩኖ አን ከታ ኮሬብ ሰነ ብረ ፉለኬ ዱረ አች ነንዻበዸ፤ አከ ነሞትን ብሻን ዹገኒፍ አት ከታ ሰነ ዸእ፤ ብሻንስ እሰ ኬሳ ንበአ።” ከናፉ ሙሴን ፉለ ማንጉዶተ እስራኤል ዱረት አከሱመ ጎዼ። <verse eid="EXO 17:6"/><verse number="7" style="v" sid="EXO 17:7"/>ሰበቢ እስራኤሎን ሎለ ካሰኒፊ ሰበቢ እሳን፣ “<char style="nd">ዋቀዮ</char> ኑ ወጅን ጅረ ሞ ህንጅሩ?” ጄቹዻን <char style="nd">ዋቀዮን</char> ቆረኒፍ ሙሴን እዶ ሰነ ማሳሂፊ መሪባ ጄዼ ሞጋሴ።<verse eid="EXO 17:7"/></para>
  <para style="s1">አማሌቆትን ሞአተመን</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 17:8"/>አማሌቆትን ዹፈኒ ሬፊዲምት እስራኤሎተ ሎለን። <verse eid="EXO 17:8"/><verse number="9" style="v" sid="EXO 17:9"/>ሙሴንስ እያሱዻን፣ “ነሞተኬኘ ኬሳ ሙራሰ ፍለዹቲ ዸቂ አማሌቆተ ሎል። አን ቦር ኡሌ ዋቃ ሀርከኮት ቀበዼ ፊጤ ጋረረ ነንዻበዸ” ጄዼ።<verse eid="EXO 17:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 17:10"/>ዬሮ ሙሴን፣ አሮኒፊ ሁር ፊጤ ጋረት ኦል በአንት፣ እያሱን አኩመ ሙሴን አጀጄት አማሌቆተ ሎለ ቱሬ። <verse eid="EXO 17:10"/><verse number="11" style="v" sid="EXO 17:11"/>ዬሮ ሙሴን ሀርከሳ ኦል ቀበቱት እስራኤሎን ንሞአቱ ቱረን፤ ዬሮ እን ሀርከሳ ገድ ቡፈቱሞ አማሌቆትን ንሞአቱ ቱረን። <verse eid="EXO 17:11"/><verse number="12" style="v" sid="EXO 17:12"/>እሳንስ ዬሮ ሀርክ ሙሴ ደዸባ ዴሜት ዸጋ ቶኮ ፉዸኒ እሰ ጀለ ካአን፤ እንስ እረ ታኤ። አሮኒፊ ሁር እን ቶኮ ገረናን እን ካንሞ ገረሲን ጎረኒ አከ ሀርክሳ ሀመ አዱን ዺቱት ገድ ህንዴብኔፍ ኦል ቀበኒፍ። <verse eid="EXO 17:12"/><verse number="13" style="v" sid="EXO 17:13"/>አከሲን እያሱን ሎልቶተ አማሌቆታ ጎራዴዻን ሞአቴ።<verse eid="EXO 17:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 17:14"/>ኤርገሲ <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ “አከ ወን ኩን ያደተሙፍ ክታበት በሬስ፤ እያሱን ዋን ከነ ዸገኡሳ ምርከኔስ፤ አን ጉቱማን ጉቱት ያደኖ አማሌቆታ ሰሚ ጀላ ነንበሌሳቲ።”<verse eid="EXO 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 17:15"/>ሙሴንስ እዶ ኣርሳ እጃሬ፣ “<char style="nd">ዋቀዮ</char> ፋጂኮት” ጄዼ ሞጋሴ። <verse eid="EXO 17:15"/><verse number="16" style="v" sid="EXO 17:16"/>እንስ፣ “ሀርክ ገረ ቴሶ <char style="nd">ዋቀዮት</char> ኦል ካፈሜረ። <char style="nd">ዋቀዮስ</char> ዸሎተ ቶኮ ገረ ዸሎተ ካኒት አማሌቆተ ንሎለ” ጄዼ።<verse eid="EXO 17:16"/></para>
  <chapter eid="EXO 17"/>
  <chapter number="18" style="c" sid="EXO 18"/>
  <para style="s1">ዬትሮ ገረ ሙሴ ዹፌ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 18:1"/>ዬትሮ ሉብች ምድያኒቲፊ አባን ኒቲ ሙሴ ሱን ዋን ዋቅን ሙሴፊ ሰበሳ እስራኤሊፍ ጎዼ ሁንደ፣ አከሱመስ አከ <char style="nd">ዋቀዮ</char> እት እስራኤልን ግብጢ ባሴ ዸገኤ።<verse eid="EXO 18:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 18:2"/>ኤርገ ሙሴን ኒቲሳ ዝጶራ ኤርጌ ቦዴ ዬትሮ አባን ኒቲ ሙሴ፣ እሼፊ <verse eid="EXO 18:2"/><verse number="3" style="v" sid="EXO 18:3"/>እልማንሼ ለማን ስመቴ። መቃን እልመሳ ቶኮ ጌርሾም ጄዸሜ፤ ሙሴን፣ “አን ብየ ኦርማ ኬሰት አለጋ ተኤረ” ጄዼራቲ። <verse eid="EXO 18:3"/><verse number="4" style="v" sid="EXO 18:4"/>ካንሞ፣ “ዋቅን አባኮቲ ገርጋራኮት፤ እን ጎራዴ ፈረኦን ጀላ ነ ባሴረ” ጄቹዻን ኤሊኤዜር ጄዼ ሞጋሴ።<verse eid="EXO 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 18:5"/>ዬትሮን አባን ኒቲ ሙሴስ ኒቲ ሙሴቲፊ እልማን ሙሴ ወጅን ገሞጂ ኬሰት ገረ ቱሉ ዋቃ እዶ ሙሴን ቁበቴ ጅሩት እሰ ብረ ዹፌ። <verse eid="EXO 18:5"/><verse number="6" style="v" sid="EXO 18:6"/>ዬትሮንስ፣ “አን አባን ኒቲኬቲ ዬትሮን ኒቲኬቲፊ እልማንሼ ለማን ወጅን ገረኬ ዹፋን ጅረ” ጄዼ ዻምሰ እት ኤርጌ ቱሬ።<verse eid="EXO 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 18:7"/>ሙሴንስ አባ ኒቲሳ ስመቹፍ ገድ በኤ፤ ገድ ጄዼስ ሀርከ ፉዼ እሰ ዹንገቴ። እሳንስ ነጋ ወል ጋፈተኒ ዱንካነ ሴነን። <verse eid="EXO 18:7"/><verse number="8" style="v" sid="EXO 18:8"/>ሙሴን ዋን <char style="nd">ዋቀዮ</char> ሰበቢ ሰበ እስራኤሊፍ ጄዼ ፈረኦኒፊ ወረ ግብጥረት ሆጄቴ፣ ረክነ ከራረት እሳን ሙደቴ ሁንዳፊ አከ እት <char style="nd">ዋቀዮ</char> እሳን ኦልቼ አባ ኒቲሳት ህሜ።<verse eid="EXO 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 18:9"/>ዬትሮንስ ዋን ጋሪ <char style="nd">ዋቀዮ</char> ሀርከ ወረ ግብጥ ኬሳ እሳን ባሱዻን ሰበ እስራኤሊፍ ጎዼ ሁንዳፍ ንገመዴ። <verse eid="EXO 18:9"/><verse number="10" style="v" sid="EXO 18:10"/>እንስ አከነ ጄዼ፤ “<char style="nd">ዋቀዮ</char> ሀርከ ወረ ግብጢፊ ሀርከ ፈረኦን ኬሳ እስን ባሴፊ እን ሰበ ሰነ ሀርከ ወረ ግብጢቲ ባሴ ሱን ሃኤብፈሙ። <verse eid="EXO 18:10"/><verse number="11" style="v" sid="EXO 18:11"/>አን አመ አከ <char style="nd">ዋቀዮ</char> ዋቆተ ካን ሁንደ ጫላ ጉዳ ተኤ ነንቤከ፤ እን ወረ ኦፍ ቱሉማዻን እስራኤልን ረክሰንረት ዋን ከነ ራወቴራቲ።” <verse eid="EXO 18:11"/><verse number="12" style="v" sid="EXO 18:12"/>ዮሙስ ዬትሮን አባን ኒቲ ሙሴ ሱን ኣርሳ ጉበሙፊ ኣርሳ ብራ ዋቃፍ ፍዴ፤ አሮንስ ፉለ ዋቃ ዱረት ሙሴፊ አባ ኒቲ ሙሴ ወጅን ቡዴነ ኛቹፍ ማንጉዶተ እስራኤል ሁንደ ወጅን ዹፌ።<verse eid="EXO 18:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 18:13"/>ጉያ እት ኣኑት ሙሴን ሰባፍ ሙርቲ ኬኑፍ ታኤ፤ ሰብን ሱንስ ገነማ ሀመ ገልገላት ናኖሳ ዻበቴ። <verse eid="EXO 18:13"/><verse number="14" style="v" sid="EXO 18:14"/>አባን ኒቲሳስ ዮሙ ዋን ሙሴን ሰባፍ ሆጄቱ ሁንደ አርጌት፣ “ወን አት ሰባፍ ሆጄቱ ኩን ማል? አት ማሊፍ ኮጳኬ ቴሴ ሰብን ኩንሞ ገነማ ሀመ ገልገላት ናኖኬ ዸዻበተ?” ጄዼ።<verse eid="EXO 18:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 18:15"/>ሙሴንሞ አከነ ጄዼ ዴብሴፍ፤ “ሰብን ኩን ፌዺ ዋቃ በርባቸ ገረኮ ዹፋቲ። <verse eid="EXO 18:15"/><verse number="16" style="v" sid="EXO 18:16"/>እሳን ዮሙ ፈልሚ ቀባተንት ዽመሳኒ ነት ዽኤፈቱ፤ አንስ አቦቲ ዽማ ግዱት ሙርቲ ነንኬነ፤ ስርናፊ ሴረ ዋቃስ እሳንት ነንህመ።”<verse eid="EXO 18:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 18:17"/>አባን ኒቲ ሙሴ አከነ ጄዼ ዴብሴ፤ “ወን አት ጎቱ ኩን ጋሪ ምት። <verse eid="EXO 18:17"/><verse number="18" style="v" sid="EXO 18:18"/>አቲፊ ሰብን ስ ብረ ዹፉ ኩን አከሱማን ኦፍ ደዸብሲፍቱ። ሆጂን ኩንስ አከ መሌ ስት ኡልፋተ፤ አት ኮጳኬ ሆጄቹ ህንደንዴሱ። <verse eid="EXO 18:18"/><verse number="19" style="v" sid="EXO 18:19"/>አን ጎርሰ ሲፍን ኬናቲ አመ ነ ዸገእ፤ ዋቅን ስ ወጅን ሃተኡ። አት ፉለ ዋቃ ዱረት እዶ ቡኣ ሰባ ታቴ ዽመሳኒ ዋቀት ፍዱ ቀብደ። <verse eid="EXO 18:19"/><verse number="20" style="v" sid="EXO 18:20"/>ስርናፊ ሴረ እሳን በርሲስ፤ አከ እሳን እት ጅራቹ ቀበኒፊ ዋን እሳን ሆጄቹ ቀበን እሳንት አርግሲስ። <verse eid="EXO 18:20"/><verse number="21" style="v" sid="EXO 18:21"/>ከነ መሌስ አት ሰበ ሁንደ ኬሳ ነሞተ ደንዴቲ ቀበን ጄቹንስ፣ ነሞተ ዋቀ ሶዳተን፣ ነሞተ አመነሞ ከኔን መተኣ ጅበን ፍለዹቲ አጀጁወን ኩማ፣ አጀጁወን ዽባ፣ አጀጁወን ሸንተማቲፊ አጀጁወን ኩዸኒ ጎዺ ሙደዹ። <verse eid="EXO 18:21"/><verse number="22" style="v" sid="EXO 18:22"/>እሳን ዬሮ ሁንደ ሰባፍ ሙርቲ ሃኬነን፤ ዱቢ ጭማ ሁንደ ገሩ ስት ሃፍደን፤ ዱቢ ላዮሞ ኦፉማን ሃሙርቴሰን። ኩን በኣኬ ሲፍ ሰልጵሰ፤ እሳን ስ ወጅን በኣ ንባቱቲ። <verse eid="EXO 18:22"/><verse number="23" style="v" sid="EXO 18:23"/>ዮ አት ዋን ከነ ጎቴ፣ ዮ ዋቅንስ ዋኑመ ከነ ስ አጀጄ አት ጀባቴ ዻበቹ ደንዴሰ፤ ሰብን ኩን ሁንድስ ነጋዻን መነ ኦፊሳት ገለ።”<verse eid="EXO 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 18:24"/>ሙሴንስ አባ ኒቲሳ ዸገኤ ዋን እን ጄዼ ሁንደ ጎዼ። <verse eid="EXO 18:24"/><verse number="25" style="v" sid="EXO 18:25"/>እንስ እስራኤል ሁንደ ኬሳ ነሞተ ደንዴቲ ቀበን ፍለቴ ሆገንቶተ ሰባ፣ አጀጁወን ኩማ፣ አጀጁወን ዽባ፣ አጀጁወን ሸንተማቲፊ አጀጁወን ኩዸኒ እሳን ጎዸቴ። <verse eid="EXO 18:25"/><verse number="26" style="v" sid="EXO 18:26"/>እሳንስ አቦቲ ሙርቲ ተአኒ ዬሮ ሁንደ ሰበ ሰነ ተጃጅለን፤ ዱቢ ጀባ ሙሴት ፍደን፤ ዱቢ ላዮ ተኤ ሁንደሞ ኦፉማን ሙርቴሰን።<verse eid="EXO 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 18:27"/>ኤርገሲስ ሙሴን አባ ኒቲሳ ጌጌሴ፤ ዬትሮንስ ዴብኤ ብየሳት ገሌ።<verse eid="EXO 18:27"/></para>
  <chapter eid="EXO 18"/>
  <chapter number="19" style="c" sid="EXO 19"/>
  <para style="s1">ጋረ ሲና ብረት</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 19:1"/>እስራኤሎን ኤርገ ግብጢ በአኒ አስ ጅአ ሰደፋ ኬሰ ጉዩመ እት ግብጢ በአን ሰነ ገሞጂ ሲና ገአን። <verse eid="EXO 19:1"/><verse number="2" style="v" sid="EXO 19:2"/>እሳንስ ኤርገ ሬፊዲሚ ከአኒ ቦዴ ገሞጂ ሲና ሴነን፤ ሰብን እስራኤልስ ገሞጂ ሰነ ኬሰ ፉሌ ቱሉ ሰና ቁበተን።<verse eid="EXO 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 19:3"/>ሙሴንስ ገረ ዋቃት ኦል በኤ፤ <char style="nd">ዋቀዮስ</char> ቱሉራ እሰ ዋሜ አከነ ጄዼን፤ “አት መነ ያቆቢን አከነ ጄተ፤ ሰበ እስራኤልትስ ዋን ከነ ህም፦ <verse eid="EXO 19:3"/><verse number="4" style="v" sid="EXO 19:4"/>‘ዋን አን ወረ ግብጥ ጎዼፊ አከ አን እት ቆቾ ርሳረት እስን ባዼ ገረኮት እስን ፍዴ እስን መታንኬሰንዩ አርግተኒርቱ። <verse eid="EXO 19:4"/><verse number="5" style="v" sid="EXO 19:5"/>አመስ እስን ዮ ናፍ አጀጀምተን፣ ዮ ከኩኮ ኤግደን እስን ሰቦተ ሁንደ ኬሳ ቀቤኘ አዳ ናፍ ታቱ። ዮ ለፍት ሁንድኑ ከንኮ ተኤሌ፣ <verse eid="EXO 19:5"/><verse number="6" style="v" sid="EXO 19:6"/>እስን ሞቱማ ሉቦታቲፊ ሰበ ቁልቁሉ ናፍ ታቱ።’ ዱቢን አት ሰበ እስራኤልት ህሙ ቀብዱስ ከኑመ።”<verse eid="EXO 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 19:7"/>ሙሴን ዴብኤ ማንጉዶተ ሰባ ወልት ዋሜ፣ ዱቢ አከ እን ዱበቱፍ <char style="nd">ዋቀዮ</char> እሰ አጀጄ ሰነ ሁንደ ፉለሳኒ ዱረት ዽኤሴ። <verse eid="EXO 19:7"/><verse number="8" style="v" sid="EXO 19:8"/>ጀር ሁንድኑስ አፋን ቶኮን፣ “ኑ ዋን <char style="nd">ዋቀዮ</char> ጄዼ ሁንዱማ ንጎነ” ጄዸኒ ዴብሰን፤ ሙሴንሞ ዋን ጀር ጄዸን ዴብሴ <char style="nd">ዋቀዮት</char> ፍዴ።<verse eid="EXO 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 19:9"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ “አከ ሰብን ኩን አና ስ ወጅን ዱበቱ ዸገኤ ዬሮ ሁንደ ስ አመነቱፍ ኩኖ አን ዱሜሰ የቡ ኬሳን ገረኬ ነንዹፈ።” ኤርገሲስ ሙሴን ዋን ሰብን ሱን ጄዼ <char style="nd">ዋቀዮት</char> ህሜ።<verse eid="EXO 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 19:10"/>
    <char style="nd">ዋቀዮስ</char> ሙሴዻን አከነ ጄዼ፤ “ገረ ሰባ ዸቂቲ ሀርኣፊ ቦር እሳን ቁልቁሌስ። አከ እሳን ወያሳኒ ሚጨተኒ <verse eid="EXO 19:10"/><verse number="11" style="v" sid="EXO 19:11"/>ጉያ ሰደፋፍ ቆጳአን ጎዽ፤ ጋፈ ሰነ ኡቱመ ሰብን ሁንድ እላሉ <char style="nd">ዋቀዮ</char> ቱሉ ሲናረት ገድ ንቡኣቲ። <verse eid="EXO 19:11"/><verse number="12" style="v" sid="EXO 19:12"/>ናኖ ቱልቻት ሰበ ሰናፍ ዳንጋ ቶልቺቲ አከነ ጄዺን፤ ‘እስን አከ ቱሉ ሰነት ኦል ህንባኔ ዮካን አከ ቀርቀረሳሌ ህንቱቅኔ ኦፍ ኤገዻ። ነምን ቱሉ ሰነ ቱቁ ከምዩ ሃአጄፈሙ። <verse eid="EXO 19:12"/><verse number="13" style="v" sid="EXO 19:13"/>እን ዸጋዻን ሃቱመሙ ዮካን ጥያን ሃወራነሙ፤ ሀርክ ቶኮዩ እሰ ህንቱቅን፤ ሆሪስ ተኡ ነምን አከ ጅራቱ ህንኤየመሙፍ።’ እሳን ዬሮ መለከትን ኡቱ ገርገር ህንጭትን አፉፈሙ ቆፈ ቱሉት ኦል በኡ ደንደኡ።”<verse eid="EXO 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 19:14"/>ሙሴን ቱሉራ ገረ ሰባት ገድ ቡኤ ሰበ ሰነ ቁልቁሌሴ፤ እሳንስ ኡፈተሳኒ ሚጨተን። <verse eid="EXO 19:14"/><verse number="15" style="v" sid="EXO 19:15"/>እንስ ሰበ ሰናን፣ “ጉያ ሰደፋፍ ኦፍ ቆጴሳ፤ ዱበርቲ ብረስ ህንገእና” ጄዼ።<verse eid="EXO 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 19:16"/>ገነመ ጉያ ሰደፋ ሰነ ቱሉ ሰነረ በከካ፣ በለቄሳፊ ዱሜሰ የቡ፣ አከሱመስ ሰገሌ መለከታ ጉዳቱ ዸገአሜ። ወር እዶ ቁበታ ሰነ ኬሰ ጅራተን ሁንድስ ንሆለተን። <verse eid="EXO 19:16"/><verse number="17" style="v" sid="EXO 19:17"/>ሙሴንስ ሰበ ሰነ እዶ ቁበናቲ ባሴ ገረ ዋቃት ፍዴ፤ ጀርስ ሚለ ቱሉ ሰና ጀለ ዸዻበተን። <verse eid="EXO 19:17"/><verse number="18" style="v" sid="EXO 19:18"/>ቱሉን ሲና ሁንድስ ሰበቢ <char style="nd">ዋቀዮ</char> እብዳን እረት ገድ ቡኤፍ ኣራን ሀጉገሜ። ኣር ሱንስ አኩመ ኣረ ቦለ እብዳቲ በኡት ኦል በኤ፤ ቱሉን ሱንስ ጉቱማን ጉቱት አከ መሌ ራፈሜ፤ <verse eid="EXO 19:18"/><verse number="19" style="v" sid="EXO 19:19"/>ሰገሌን መለከታ እቱመ ጉደቻ ዴሜ። ሙሴንስ ንዱበቴ፤ ሰገሌን ዋቃስ ዴቢ ኬኔፍ።<verse eid="EXO 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 19:20"/>
    <char style="nd">ዋቀዮ</char> ፊጤ ቱሉ ሲናረት ገድ ቡኤ ሙሴ ገረ ፊጤ ቱሉ ሰናት ኦል ዋሜ። ሙሴንስ ኦል በኤ፤ <verse eid="EXO 19:20"/><verse number="21" style="v" sid="EXO 19:21"/><char style="nd">ዋቀዮ</char>ሞ አከነ እሳን ጄዼ፤ “አከ እሳን <char style="nd">ዋቀዮ</char> እላሉፍ ጄዸኒ ዳሪ ህንደበሬፊ አከ እሳን ኬሳስ ነምን ባይኤን ህንዱኔፍ ገድ ቡኢቲ እሳን አኬከቺስ። <verse eid="EXO 19:21"/><verse number="22" style="v" sid="EXO 19:22"/>አከ <char style="nd">ዋቀዮ</char> እሳን ህንበሌስኔፍ ሉቦትን <char style="nd">ዋቀዮት</char> ዽኣተንዩ ኦፍ ሃቁልቁሌሰን።”<verse eid="EXO 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 19:23"/>ሙሴንሞ <char style="nd">ዋቀዮን</char>፣ “ሰበቢ አት መታንኬ፣ ‘ናኖ ቱልቻት ዳንጋ ዻቢቲ እሰ ቁልቁሌሲቲ አዳን ባስ’ ጄቴ አኬከቺሰ ኑ ኬንቴፍ ሰብን ኩን ቱሉ ሲናት ኦል በኡ ህንደንደኡ” ጄዼ።<verse eid="EXO 19:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 19:24"/>
    <char style="nd">ዋቀዮስ</char>፣ “ገድ ቡኢቲ አሮንን ፍዲ ኮቱ። ገሩ ሉቦትኒፊ ኡመትን ገረ <char style="nd">ዋቀዮት</char> ኦል ዹፉፍ ጄዸኒ ዳንጋ ህንደርብን፤ ዮ ከና አቺ እን እሳን በሌሰ” ጄዼ ዴብሴ።<verse eid="EXO 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 19:25"/>ሙሴንስ ገድ ቡኤ ዋን ከነ ኡመተት ህሜ።<verse eid="EXO 19:25"/></para>
  <chapter eid="EXO 19"/>
  <chapter number="20" style="c" sid="EXO 20"/>
  <para style="s1">አጀጀወን ኩርነን</para>
  <para style="r">
    <ref loc="EXO 20:1-17">20፥1‑17</ref> ኩወፈ – <char style="xt"><ref loc="DEU 5:6-21">ኬዴ 5፥6‑21</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 20:1"/>ዋቅን አከነ ጄዼ ዱቢ ከነ ሁንደ ዱበቴ፦<verse eid="EXO 20:1"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="2" style="v" sid="EXO 20:2"/>“አን <char style="nd">ዋቀዮ</char> ዋቀኬ ከን ግብጢ፣ ብየ ገርቡማቲ ስ ባሴዸ።<verse eid="EXO 20:2"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="3" style="v" sid="EXO 20:3"/>“አት አነ መሌ ዋቆተ ብራ ቶኮሌ ህንቀባትን።<verse eid="EXO 20:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="EXO 20:4"/>አት ብፈ ዋን ኦል ሰሚ ጉባ ዮካን ገድ ለፈረ ዮካን ብሻን ለፈ ጀላ ኬሰ ጅሩ ከሚቲንዩ ዋቀ ቶልፈማ ኦፊኬቲፍ ህንቶልፈትን። <verse eid="EXO 20:4"/><verse number="5" style="v" sid="EXO 20:5"/>እሳኒፍ ህንሰገድን ዮካን እሳን ህንዋቄፈትን፤ አን <char style="nd">ዋቀዮ</char> ዋቅንኬ ዋቀ ህናፉ ከን ሰበቢ ጩቡ አቦቲቲፍ ጄዼ እጆሌ ወረ ነ ጅበኒ ሀመ ዸሎተ ሰዲፊ አፉሪት አደቤ <verse eid="EXO 20:5"/><verse number="6" style="v" sid="EXO 20:6"/>ወረ ነ ጃለተኒ አጀጀወንኮ ኤገንሞ ሀመ ዸሎተ ኩማት ጃለቱዸ።<verse eid="EXO 20:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="EXO 20:7"/>መቃ <char style="nd">ዋቀዮ</char> ዋቀኬቲ አከሱማን ህንዸእን፤ <char style="nd">ዋቀዮ</char> ወረ አኩመ አርገን መቃሳ ዸአን ኡቱ ህንአደብን ህንዺሱቲ።<verse eid="EXO 20:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="EXO 20:8"/>ጉያ ሰንበታ ቁልቁሌሱዻን ያደዹ። <verse eid="EXO 20:8"/><verse number="9" style="v" sid="EXO 20:9"/>ጉዮተ ጀአ ሆጄዹ፤ ሆጂኬ ሁንደስ ሆጄተዹ፤ <verse eid="EXO 20:9"/><verse number="10" style="v" sid="EXO 20:10"/>ጉያን ቶርበፋን ገሩ ሰንበተ <char style="nd">ዋቀዮ</char> ዋቀኬቲት። ጋፈስ ሆጂ ቶኮሌ ህንሆጄትን፤ አት ዮካን እልምኬ ዮካን እንተልኬ ዮካን ሆጄታንኬ ዮካን ጦምቦሬንኬ ዮካን ሆሪንኬ ዮካን አለጋን መጋላኬ ኬሰ ጅራቱ ቶኮዩ ሆማ ህንሆጄትን። <verse eid="EXO 20:10"/><verse number="11" style="v" sid="EXO 20:11"/><char style="nd">ዋቀዮ</char> ጉያ ጀአ ኬሰት ሰሚፊ ለፈ፣ ገላናፊ ዋን እሳን ኬሰ ጅሩ ሁንደ ኡሜ ጉያ ቶርበፋት ቦቆቴቲ። ከናፉ <char style="nd">ዋቀዮ</char> ሰንበተ ኤብሴ ቁልቁሌሴ።<verse eid="EXO 20:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="EXO 20:12"/>አከ ብየ <char style="nd">ዋቀዮ</char> ዋቅንኬ ሲፍ ኬኑ ኬሰ በረ ዼራ ጅራቱፍ አባኬቲፊ ሃዸኬቲፍ ኡልፍነ ኬን።<verse eid="EXO 20:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="EXO 20:13"/>ህንአጄስን።<verse eid="EXO 20:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="EXO 20:14"/>ህንኤጅን።<verse eid="EXO 20:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="EXO 20:15"/>ህንሀትን።<verse eid="EXO 20:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="EXO 20:16"/>ኦላኬት ሶባን ዹጋ ህንበእን።<verse eid="EXO 20:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="EXO 20:17"/>መነ ነማ ህንሀውን። ኒቲ ነማ ዮካን ሆጄታሳ ዮካን ጦምቦሬሳ ዮካን ቆትዮሳ ዮካን ሀሬሳ ዮካን ዋን ነማ ከምዩ ህንሀውን።”<verse eid="EXO 20:17"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="18" style="v" sid="EXO 20:18"/>ጀር ሁንድኑስ ዮሙ በከካፊ በለቄሰ፣ ሰገሌ መለከታቲፊ ቱሉ ኣሩ ሁበተንት ሶዳዻን ሆለተን። እሳን ፈጎ ዻበተኒ <verse eid="EXO 20:18"/><verse number="19" style="v" sid="EXO 20:19"/>ሙሴዻን፣ “አት መታንኬ ኑት ዱበዹ፤ ኑ ንዸጌፈትና። ገሩ ዋቅን ኑት ህንዱበትን። ዮ ከና አቺ ኑ ንዹምና” ጄዸን።<verse eid="EXO 20:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 20:20"/>ሙሴንሞ ሰበ ሰናን፣ “ህንሶዳትና። አከ ዋቀ ሶዳቹን እስን ወጅን ጅራቴ ጩቡ ሆጄቹራ እስን ኤጉፍ ጄዼ ዋቅን እስን ቆሩፍ ዹፌረ” ጄዼ።<verse eid="EXO 20:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 20:21"/>ዬሮ ሙሴን ዱከነ ልምጢ እዶ ዋቅን ቱሬት ዽኣቴት፣ ነሞትን ፈጎ ዻበተን።<verse eid="EXO 20:21"/></para>
  <para style="s1">ዋቆተ ቶልፈሞፊ እዶወን ኣርሳ</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 20:22"/>ኤርገሲ <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ “ሰበ እስራኤልት ዋን ከነ ህም፦ ‘አከ አን ሰሚራ እስንት ዱበዼ እስን መታንኬሰን አርግተኒርቱ፤ <verse eid="EXO 20:22"/><verse number="23" style="v" sid="EXO 20:23"/>አነ ብረት ዋቆተ ከምዩ ህንቶልፈትና። ዋቆተ ሜቲ ዮካን ዋቆተ ወርቄ ህንቶልፈትና።<verse eid="EXO 20:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 20:24"/>“ ‘ብዮ ለፋራ እዶ ኣርሳ ና ቶልቺቲ እሰረት ቀልመ ጉበሙ፣ ኣርሳ ነጋ፣ ሆሎተኬ፣ ሬኦተኬቲፊ ሎንኬ ኣርሳ ዽኤስ። አን እዶ አከ መቃንኮ እት ያደተሙ ጎዹ ሁንደት ገረኬ ዹፌ ስን ኤብሰ። <verse eid="EXO 20:24"/><verse number="25" style="v" sid="EXO 20:25"/>ዮ ዸጋራ እዶ ኣርሳ ና እጃርቴሞ ዸጋ ሶፈሜራ ህንእጃርን፤ ዮ ሜሻዻን እሰ ቱቅጤ ንጡሬስታቲ። <verse eid="EXO 20:25"/><verse number="26" style="v" sid="EXO 20:26"/>አከ ቁላንኬ እሰረት ህንሙልአኔፍ ጉለንታዻን እዶ ኣርሳኮት ኦል ህንበእን።’<verse eid="EXO 20:26"/></para>
  <chapter eid="EXO 20"/>
  <chapter number="21" style="c" sid="EXO 21"/>
  <para style="p">
    <verse number="1" style="v" sid="EXO 21:1"/>“ሴረወን አት እሳን ዱረ ኬሱ ከኔኒዸ፦<verse eid="EXO 21:1"/></para>
  <para style="s1">ሴረ ዋኤ ገርቦታ</para>
  <para style="r">
    <ref loc="EXO 21:2-6">21፥2‑6</ref> ኩወፈ – <char style="xt"><ref loc="DEU 15:12-18">ኬዴ 15፥12‑18</ref></char></para>
  <para style="r">
    <ref loc="EXO 21:2-11">21፥2‑11</ref> ኩወእ – <char style="xt"><ref loc="LEV 25:39-55">ሌዎ 25፥39‑55</ref></char></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 21:2"/>“አት ዮ እብሮተ ኬሳ ገርብቸ ብተቴ እን ወጋ ጀአ ሲፍ ሃሆጄቱ። ወጋ ቶርበፋት ገሩ እን ከፈልቲ መሌ ብልሰ ሃበኡ። <verse eid="EXO 21:2"/><verse number="3" style="v" sid="EXO 21:3"/>እን ዮ ኮጳሳ ዹፌ ጅራቴ ኮጳሳ ብልሶሜ ሃዴሙ፤ ዬሮ ዹፉት እን ዮ ኒቲ ቀባቴ እሼንስ እሰ ወጅን ሃዴምቱ። <verse eid="EXO 21:3"/><verse number="4" style="v" sid="EXO 21:4"/>ዮ ጎፍታንሳ ኒቲ እሰ ፉስሴ እሼንስ እልማን ዮካን እንተለን ዴሴፊ ጅራቴ፣ እሼፊ እጆሌንሼ ከን ጎፍታሼ ተኡ፤ ነምች ቆፍት ብልሰ ተኤ ሃዴሙ።<verse eid="EXO 21:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 21:5"/>“ገሩ ገርብች ሱን፣ ‘አን ጎፍታኮፊ ኒቲኮ፣ እጆሌኮስ ነንጃለዸ፤ አን ብልሰ በኤ ዴሙ ህንበርባዱ’ ዮ ጄዼ፣ <verse eid="EXO 21:5"/><verse number="6" style="v" sid="EXO 21:6"/>ጎፍታንሳ ፉለ አቦቲ ሙርቲ ዱረት እሰ ሃዽኤሱ፤ ገረ በልበላት ዮካን ገረ ምችችለ በልበላት ጌሴስ ሙታዻን ጉረሳ ሃኡሩ። ኤርገሲ እን በረ ጅሬኘሳ ጉቱ እሰ ተጃጅለ።<verse eid="EXO 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 21:7"/>“ነምን ዮ እንተለሳ አከ ገርብቲት ጉርጉረቴ፣ እሼን አከ ገርብች ቶኮ እት ብልሰ በኡት ብልሰ ህንበእን። <verse eid="EXO 21:7"/><verse number="8" style="v" sid="EXO 21:8"/>ዮ እሼን ጎፍትቸ ኦፊሳቲፍ እሼ ፍለቴ ሰነት ቶሉ ባቴ እን አከ እሼን ፉረምቱ ሃጎዹ። እን ዋን እሼፍ አመነሙ ዸቤፍ ደበርሴ ኦርመት እሼ ጉርጉሩፍ ምርገ ህንቀቡ። <verse eid="EXO 21:8"/><verse number="9" style="v" sid="EXO 21:9"/>ዮ እልመሳቲፍ እሼ ፍለቴሞ ምርገ እንተለ ኦፊሳቲፍ ኬኑ እሼፍስ ሃኬኑ። <verse eid="EXO 21:9"/><verse number="10" style="v" sid="EXO 21:10"/>ዮ ኒቲ ብራ ፉዼሞ ኒቲሳ ከን ጀልቀባ ሰነ ኛተ፣ ኡፈታፊ ምርገ ኒቲፍ መሉ እት ህንህርእስን። <verse eid="EXO 21:10"/><verse number="11" style="v" sid="EXO 21:11"/>ዮ እን ወንቶተ ሰደን ከኔን እሼፍ ጎቹ ድዴ ገሩ እሼን ከፈልቲ ማለቃ ቶኮ መሌ ብልሰ በኡ ቀብድ።<verse eid="EXO 21:11"/></para>
  <para style="s1">ሚዻ ነመ እራን ገኡ</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 21:12"/>“ነምን ነመ ሩኩቴ አጄሱ እንስ ሃአጄፈሙ። <verse eid="EXO 21:12"/><verse number="13" style="v" sid="EXO 21:13"/>እን ርጴ ኡቱ ህንኤገትን ዋቀቱ ሀርከሳ ቡሴ ዮ ተኤ ገሩ እዶ አን ረመዱት ሃበቀቱ። <verse eid="EXO 21:13"/><verse number="14" style="v" sid="EXO 21:14"/>ገሩ ዮ ነምን ቶኮ እቱመ ያዴ ደባን ነመ አጄሴ እዶ ኣርሳኮ ብራ ፉዻቲ አጄሳ።<verse eid="EXO 21:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 21:15"/>“ነምን አባሳ ዮካን ሃዸሳ ሩኩቱ ሃአጄፈሙ።<verse eid="EXO 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 21:16"/>“ነምን ነመ ሀቴ ዮ ጉርጉረቴ ዮካን ነምች ሀተሜ ሱን ሀርከሳት ዮ አርገሜ ሀትች ሃአጄፈሙ።<verse eid="EXO 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 21:17"/>“ነምን አባሳ ዮካን ሃዸሳ አረብሱ ሃአጄፈሙ።<verse eid="EXO 21:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 21:18"/>“ዮ ነሞትን ወል ሎለኒ እን ቶኮ እሰ ካን ዸጋዻን ዮካን አቦቴዻን ሩኩቴ ነምች ሩኩተሜ ሱን ዱኡ ባቴ ገሩ ስሬረት ሀፌ፣ <verse eid="EXO 21:18"/><verse number="19" style="v" sid="EXO 21:19"/>ኤርገሲሞ ዮ እን ከኤ ኡሌሳ ዸዻበቻ አሲፊ አች አለ ኬሰ ዴዴሜ ነምች እሰ ዸኤ ሱን እት ህንጋፈተሙ፤ ሰበቢ ዬሮ ነምቸ ሚዸሜ ሰና ጀላ በሌሴፍ ገሩ ገቲ ሃባሱ፤ ሀመ እን ጉቱማን ጉቱት ፈዩትስ እሰ ሃወልኣኑ።<verse eid="EXO 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 21:20"/>“ዮ ነምን ቶኮ ኡሌዻን ገርብቸሳ ዮካን ገርብቲሳ ዸኤ ገርብች ሱንስ ሀርከሳት ዱኤ ነምች ሃአደበሙ፤ <verse eid="EXO 21:20"/><verse number="21" style="v" sid="EXO 21:21"/>ገሩ ሰበቢ ገርብች ሱን ቀቤኘሳ ተኤፍ ዮ ገርብች ሱን ቡልቲ ቶኮ ዮካን ቡልቲ ለመ ቦዴ ከኤ፣ ነምች ህንአደበሙ።<verse eid="EXO 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 21:22"/>“ዮ ነሞትን ወል ሎላ ጅረን ዱበርቲ ኡልፎፍቴ ቶኮት ቡአኒ ኡልፊ ገራዻ በኤ ገሩ ሚዸምን ሀማን እሼ ህንቀቀብን፣ ነምች እሼ ሚዼ ሱን ዋን ዽርስ ዱበርትቲ እሰ ጋፈቴፊ ዋን አቦቲን ሙርቲ ሙርቴሰን ባሱ ቀበ። <verse eid="EXO 21:22"/><verse number="23" style="v" sid="EXO 21:23"/>ዮ ሚዸምን ሀማን ጅራቴ ገሩ፣ ቆደ ሉቡ፣ ሉቡ፤ <verse eid="EXO 21:23"/><verse number="24" style="v" sid="EXO 21:24"/>ቆደ እጃ፣ እጀ፤ ቆደ እልካኒ፣ እልካን፤ ቆደ ሀርካ፣ ሀርከ፤ ቆደ ሚላ፣ ሚለ፤ <verse eid="EXO 21:24"/><verse number="25" style="v" sid="EXO 21:25"/>ቆደ ጉቡ፣ ጉቡ፤ ቆደ መዳ፣ መዳ፤ ቆደ ቡሩቅሱ፣ ቡሩቅሱ ባፍተ።<verse eid="EXO 21:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 21:26"/>“ነምን ቶኮ ዮ እጀ ገርብቸሳ ዮካን እጀ ገርብቲሳ ሩኩቴ ጃምሴ፣ እን ቆደ እጀ ሰና ገርበ ሰነ ብልሰ ሃባሱ። <verse eid="EXO 21:26"/><verse number="27" style="v" sid="EXO 21:27"/>እን ዮ እልካን ገርብቸሳ ዮካን እልካን ገርብቲሳ ሩኩቴ ጨብሴ፣ ቆደ እልካን ሰና ገርበ ሰነ ብልሰ ሃባሱ።<verse eid="EXO 21:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 21:28"/>“ቆትዮን ቶኮ ዮ ዺረ ዮካን ዱበርቲ ወራኔ አጄሴ ቆትዮን ሱን ዸጋዻን ቱመሜ ሃአጄፈሙ፤ ፎንሳስ ህንኛተምን። ገሩ አባን ቆትዮ ሰና እት ህንጋፈተሙ። <verse eid="EXO 21:28"/><verse number="29" style="v" sid="EXO 21:29"/>ዮ ቆትዮን ሱን ዱሩማኑ አመለ ነመ ወራኑ ቀባቹንሳ ቤከሜ አባንሳስ አከ እሰ ኤገቱ ጎርፈሜ ገሩ ዋን እን እሰ ኤገቹ ድዴፍ ቆትዮን ሱን ዺረ ዮካን ዱበርቲ አጄሴ፣ ቆትዮን ሱን ዸጋዻን ሩኩተሜ ሃአጄፈሙ፤ አባን ቆትዮ ሰናስ ሃአጄፈሙ። <verse eid="EXO 21:29"/><verse number="30" style="v" sid="EXO 21:30"/>ተኡስ እን ዮ ጉማ ጋፈተሜ ዋን ጋፈተሜ ሁንደ ከፈሌ ሉቡሳ ሃኦልፈቱ። <verse eid="EXO 21:30"/><verse number="31" style="v" sid="EXO 21:31"/>ዮ ቆትዮን ሱን እልመ ዮካን እንተለ ቶኮ ወራኔሌ ሴሩመ ከነቱ ሆጄተ። <verse eid="EXO 21:31"/><verse number="32" style="v" sid="EXO 21:32"/>ዮ ቆትዮን ሱን ገርብቸ ዮካን ገርብቲ ወራኔ አባን ቆትዮ ሰና ጎፍታ ገርበ ሰናቲፍ ሜቲ ሰቅሊ<note caller="+" style="f"><char style="fr" closed="false">21፥32 </char><char style="ft" closed="false">ሰቅሊን ቶኮ ግራሚ 345።</char></note> ሶዶመ ሃከፈሉ፤ ቆትዮን ሱንስ ዸጋን ሩኩተሜ ሃአጄፈሙ።<verse eid="EXO 21:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 21:33"/>“ነምን ቶኮ ዮ ቦለ አፋን በና ዺሴ ዮካን ዮ ቦለ ቆቴ ኡቱ ህንዱችን ዺሴ ሰንጋን ዮካን ሀሬን ቦለ ሰነ ኬሰ ቡኤ፣ <verse eid="EXO 21:33"/><verse number="34" style="v" sid="EXO 21:34"/>አባን ቦለ ሰና አባ ሆሪ ሰናቲፍ ማለቀ ሃባሱ፤ ሆሪን ዱኤ ሱንሞ ከንሳ ሃተኡ።<verse eid="EXO 21:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 21:35"/>“ዮ ቆትዮን ነመ ቶኮ ቆትዮ ነመ ብራ ሚዼ ዱኣን ገኤ ጀር ቆትዮ ፈያ ሰነ ሃጉርጉረን፤ ገቲ ቆትዮ ሰናቲፊ ቆትዮ ዱኤ ሰነ ቅጤት ሃቆደተን። <verse eid="EXO 21:35"/><verse number="36" style="v" sid="EXO 21:36"/>ዮ ቆትዮን ሱን ዱሩማኑ አመለ ሆሪ ወራኑ ቀባቹንሳ ቤከሜ ገሩ ዋን አባንሳ እሰ ኤገቹ ድዴፍ አባን ቆትዮ ሰና ቆደ ቆትዮ፣ ቆትዮ ሃባሱ፤ ቆትዮን ዱኤ ሱንሞ ከንሳ ሃተኡ።<verse eid="EXO 21:36"/></para>
  <chapter eid="EXO 21"/>
  <chapter number="22" style="c" sid="EXO 22"/>
  <para style="s1">ኤጉምሰ ቀቤኛፍ ጎዸሙ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 22:1"/>“ነምን ቶኮ ዮ ሰንጋ ዮካን ሆላ ሀቴ ቀለቴ ዮካን ጉርጉረቴ፣ ቆደ ቆትዮ ቶኮ ሰንጋ ሸን፣ ቆደ ሆላ ቶኮሞ ሆላ አፉር ሃባሱ።<verse eid="EXO 22:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 22:2"/>“ሀቱን ቶኮ ኡቱ ጨብሴ ሴኑ ዮ ቀበሜ ቱመሜ ከኑማን ዱኤ፣ ነምች እሰ አጄሴ ሱን ዺገሳት የካን ህንጋፈተሙ፤ <verse eid="EXO 22:2"/><verse number="3" style="v" sid="EXO 22:3"/>ገሩ ዮ ወን ኩን ኤርገ አዱን ባቴ ተኤ፣ ነምች ዺገ ሰነት የካን ንጋፈተመ።</para>
  <para style="p" vid="EXO 22:3">“ሀቱን ዋን ሀቴ ሃዴብሱ፤ ሆማ ህንቀቡ ዮ ተኤ ገሩ ሀትነሳቲፍ ገቲ ባሱዻፍ ሃጉርጉረሙ። <verse eid="EXO 22:3"/><verse number="4" style="v" sid="EXO 22:4"/>ሆሪን ሀተሜ ሱን ሰንጋ ዮካን ሀሬ ዮካን ሆላ ታናን ዮ ኡቱ ሉቡን ጅሩ ሀርከሳት አርገሜ ሀቱን ሱን ደቻ ባሱ ቀበ።<verse eid="EXO 22:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 22:5"/>“ነምን ቶኮ ዮ ኡቱ ለፈ ቆቲሳ ዮካን ዻባ ወይኒ ኬሰ ሆሪ ትክፈቱ ሆሪሳ ገድ ለክሴ ሆሪን ሱን ዸቄ ከሎ ነመ ብራ ዼዴ፣ እን ለፈ ቆቲሳ ኦፊሳራ ዮካን ዻባ ወይኒ ኦፊሳራ ከን ዋን ሁንደ ጫሉ እዶ ሃቡሱፍ።<verse eid="EXO 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 22:6"/>“ዮ እብድ ከኤ ደገለ ሴኔ አከሲን ምዻን ቱለሜ ዮካን ምዻን ዻበቱ ዮካን ለፈ ቆቲሳ ጉቤ፣ ነምች እብደ ቀብሲሴ ሱን ገቲ ባሱ ቀበ።<verse eid="EXO 22:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 22:7"/>“ነምን ቶኮ ዮ ማለቀ ዮካን ምአ እማና ነመት ኬነቴ፣ ወን ሱን መነ ነምቻቲ ሀተሜ ሀቱን ሱን ቀበሜ፣ ሀትች ደቻ ከፈሉ ቀበ። <verse eid="EXO 22:7"/><verse number="8" style="v" sid="EXO 22:8"/>ዮ ሀቱን ሱን ህንአርገምን ገሩ አባን መነ ሰና አከ ምአ ነመ ካኒ ቱቄፊ አከ ህንቱቅን ምርከኔሱፍ ፉለ አቦቲ ሙርቲ ዱረት ሃዽኤፈሙ። <verse eid="EXO 22:8"/><verse number="9" style="v" sid="EXO 22:9"/>ነምን ቶኮ ዮ ቆትዮ፣ ሀሬ፣ ሆላ፣ ኡፈተ ዮካን ምአ በዴ ቶኮ ምልቅሴ ነምን ቶኮ ዹፌ፣ ‘ኩን ከንኮት’ ጄዼ፣ ፈልሚንሳኒ ፉለ አቦቲ ሙርቲ ዱረት ሃዽኤፈሙ። ነምች አቦቲን ሙርቲ እት ሙረን ሱንስ ኦላሳቲፍ ሀርከ ለመ ሃባሱ።<verse eid="EXO 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 22:10"/>“ዮ ነምን ቶኮ ኦላሳቲፍ ሀሬ፣ ቆትዮ፣ ሆላ ዮካን ሆሪ ብራ እማና ኬነቴ ሆሪን ሱን ኡቱ ነምን ህንአርግን ዱኤ ዮካን ሚዸሜ ዮካን ሀተሜ፣ <verse eid="EXO 22:10"/><verse number="11" style="v" sid="EXO 22:11"/>ነምች ሱን አከ ቀቤኘ ኦላሳ ህንቱቅን ምርከኔሱፍ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ሃከከቱ፤ አባን ቀቤኛ ሱንስ ከኩ ከነ ፉዸቹ ቀበ፤ ገቲስ ህንጋፈቱ። <verse eid="EXO 22:11"/><verse number="12" style="v" sid="EXO 22:12"/>ዮ ሆሪን ሱን እሰ ጀላ ሀተሜ ጅራቴ ገሩ ነምች አባ ሆሪ ሰናቲፍ ባሱ ቀበ። <verse eid="EXO 22:12"/><verse number="13" style="v" sid="EXO 22:13"/>ዮ ሆሪ ሰነ ብኔንሰቱ ኛቴ ተኤሞ አከ ረጋ ተኡፍ ዋን ብኔንሰራ ሀፌ ሃዽኤሱ መሌ ሆሪ ኛተሜ ሰናፍ ገቲ ህንባስን።<verse eid="EXO 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 22:14"/>“ነምን ቶኮ ዮ ኦላሳራ ሆሪ ኤርግፈቴ ሆሪን ሱን እዶ አባን ሆሪ ህንጅሬት ሚዸሜ ዮካን ዱኤ፣ ነምች ኤርግፈቴ ሱን ገቲ ሃባሱ። <verse eid="EXO 22:14"/><verse number="15" style="v" sid="EXO 22:15"/>ዮ አባን ሆሪ ሰና አች ጅራቴ ገሩ ነምች ኤርግፈቴ ሱን ገቲ ባሱ ህንቀቡ። ዮ ሆሪን ሱን ክሬፈሜ ጅራቴሞ ማለቅን ባፈሜ ሱን ክራ ሆሪ ዱኤ ሰና ሃተኡ።<verse eid="EXO 22:15"/></para>
  <para style="s1">እት ጋፈተመ ሀዋሱማ</para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 22:16"/>“ነምን ቶኮ ዮ ዱርበ ህንካዽመተምን ጎዎምሴ እሼ ወጅን ጪሴ፣ እን ገበረ ምስርቲፍ መሉ ባሴፊ እሼ ሃፉዹ። <verse eid="EXO 22:16"/><verse number="17" style="v" sid="EXO 22:17"/>ዮ አባንሼ እንተለቲ ነምቻፍ ኬኑ ድዴሞ ነምች ሱን ገበረ ዱርባፍ መሉ ባሱ ቀበ።<verse eid="EXO 22:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 22:18"/>“አት አከ ዱበርቲን ፈልፈልቱን ሉቡን ጅራቱ ህንኤየምን።<verse eid="EXO 22:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 22:19"/>“ነምን ሆሪ ወጅን ጪሱ ከምዩ አጄፈሙ ቀበ።<verse eid="EXO 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 22:20"/>“ነምን <char style="nd">ዋቀዮ</char> ቶክቻፍ መሌ ዋቀ ብራቲፍ ኣርሳ ዽኤሱ ገላፈተሙ ቀበ።<verse eid="EXO 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 22:21"/>“እስንስ ዋን ብየ ግብጢ ኬሰት አለጎተ ቱርተኒፍ አለጋት ደበ ህንሆጄትና፤ ህንጩንቁርስናስ።<verse eid="EXO 22:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 22:22"/>“ሃዸ ህዬሳቲፊ እጆሌ አባንራ ዱኤ ህንሀጩጭና። <verse eid="EXO 22:22"/><verse number="23" style="v" sid="EXO 22:23"/>ዮ እስን እሳን ሚተኒ እሳንሞ ነት ቦአን አን ዹጉማን ቦእቸሳኒ ነንዸገአ። <verse eid="EXO 22:23"/><verse number="24" style="v" sid="EXO 22:24"/>ኣሪንኮ ንቦበአ፤ አንስ ጎራዴዻነን እስን ፍጠ፤ ኒቶትንኬሰን ሃዾተ ህዬሳ ተኡ፤ እጆሌንኬሰንስ ከኔን አባ ህንቀብኔ ተኡ።<verse eid="EXO 22:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 22:25"/>“አት ዮ ሰበኮ ኬሳ ህዬሰ ስ ብረ ጅራቱ ቶኮፍ ማለቀ ልቄስቴ፣ አከ ነመ ሂቂ አርገቹፍ ኬኑ ህንተእን፤ ዸለስ ህንጋፈትን። <verse eid="EXO 22:25"/><verse number="26" style="v" sid="EXO 22:26"/>አት ዮ ወያ ነመ ብራ ቀብዲ ቀበቴ፣ ኡቱ አዱን ህንዽእን ዴብሲፍ፤ <verse eid="EXO 22:26"/><verse number="27" style="v" sid="EXO 22:27"/>ወን እን ዸግነሳት ኡፈቱ ወዩመ ሰናቲ። ወን እን ኡፈቴ ረፉ ብራ ማል? አን ዋነን ገረ ላፌሰ ተኤፍ፣ ዮ እን ነት ኦል እየቴ ነንዸገአ።<verse eid="EXO 22:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 22:28"/>“ዋቀ ህንአረብስን፤ ቡልቻ ሰበኬቲስ ህንአባርን።<verse eid="EXO 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 22:29"/>“መታ ምዻንኬቲቲፊ ዸንገለኣ ወይኒኬቲራ ኣርሳ ዽኤሱ ህንቱርስን።</para>
  <para style="p" vid="EXO 22:29">“እልማንኬ ኬሳስ ሀንገፈ ና ኬኑ ቀብደ። <verse eid="EXO 22:29"/><verse number="30" style="v" sid="EXO 22:30"/>ሎንኬቲፊ ሆሎተኬ አከኑመ ጎዽ። እሳንስ ቡልቲ ቶርበ ሃዸሳኒ ብረ ሃቱረን፤ ጉያ ሰዴተፋት ገሩ ና ኬን።<verse eid="EXO 22:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 22:31"/>“እስን ሰበኮ ቁልቁሉ ንታቱ። ከናፉ ፎን ሆሪ ብኔንስ አለት ጨብሴ ከምዩ ህንኛትና፤ ፎን አከና ሰሬ ዱረ ቡሳ።<verse eid="EXO 22:31"/></para>
  <chapter eid="EXO 22"/>
  <chapter number="23" style="c" sid="EXO 23"/>
  <para style="s1">ሴረ ሙርቲ ቀጄላፊ አራራ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 23:1"/>“ኦዱ ሶባ ህንኦዴስን፤ ዹገ በኡ ጀልኣ ኬኑዻን ነመ በሌሳ ሆጄቴ ህንገርጋርን።<verse eid="EXO 23:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 23:2"/>“ዋን ሀማ ሆጄቹፍ ጄቴ ነመ ባይኤ ፋነ ህንቡእን። ፉለ ሴራ ዱረት ዮሙ ዹጋ ባቱ፣ ገረ ነመ ባይኤ ጎርቴ ሙርቲ ህንጀልእስን፤ <verse eid="EXO 23:2"/><verse number="3" style="v" sid="EXO 23:3"/>ሙርቲረት ህዬሳፍ ህንሎግን።<verse eid="EXO 23:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 23:4"/>“ዮ ሰንጋ ዮካን ሀሬ ዲነኬቲ ከን በዱት ጅሩ አርግቴ ዴብሲ ጌሲፍ። <verse eid="EXO 23:4"/><verse number="5" style="v" sid="EXO 23:5"/>ዮ ሀሬ ነመ ስ ጅቡ ቶኮ ኡቱ እሼን በኣ ባቴ ኩፍቴ ጅርቱ አርግቴ አችት ህንዺስን፤ እሰ ገርጋሪ ኦል ካስ።<verse eid="EXO 23:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 23:6"/>“ሙርቲረት ህዬሰ ሰበኬቲ ጀላ ሙርቲ ህንደብስን። <verse eid="EXO 23:6"/><verse number="7" style="v" sid="EXO 23:7"/>ህመተ ሶባ ኬሰት ህንህርማትን፤ ዋን አን ነመ በሌሳ ሆጄቴ ህንቁልቁሌስኔፍ ነመ የከ ህንቀብኔ ዮካን ነመ ቀጄላ ህንአጄስን።<verse eid="EXO 23:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 23:8"/>“አት መተኣ ህንፉዸትን፤ መተኣን ኦጌዪ ንጃምሳቲ፤ ዱቢ ቀጄልቶታስ ጀልእሰ።<verse eid="EXO 23:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 23:9"/>“አለጋ ህንጩንቁርስን፤ እስን ዋን ብየ ግብጢት አለጋ ቱርተኒፍ አለጋ ተኡን ማል አከ ተኤ እስን መታንኬሰን ንቤክቱቲ።<verse eid="EXO 23:9"/></para>
  <para style="s1">ሴረ ሰንበታ</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 23:10"/>“ወጋ ጀአ ለፈ ቆቲሳኬ ፈጫፈዹ፤ ምዻንስ ገልፈዹ፤ <verse eid="EXO 23:10"/><verse number="11" style="v" sid="EXO 23:11"/>ወጋ ቶርበፋት ገሩ ለፈ ሰነ ቦቆቺስ መሌ ህንቆትን። አከሲን ህዬዪን ሰበኬቲ ለፍቸራ ኛተ አርገቱ፤ ዋን እሳንራ ሀፌሞ ብኔንስ ሃኛቱ። ሙከ ወይኒኬቲቲፊ ሙከ ኤጄርሰኬቲስ አከሱመ ጎዽ።<verse eid="EXO 23:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 23:12"/>“ጉያ ጀአ ሆጂኬ ሆጄተዹ፤ አከ ሰንጋንኬቲፊ ሀሬንኬ ቦቆተኒፍ፣ አከ ገርብች መነኬት ዸለቴፊ አለጋን ኣረ ገልፈተኒፍ ጉያ ቶርበፋት ህንሆጄትን።<verse eid="EXO 23:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 23:13"/>“ዋን አን እስንት ህሜ ሁንደ ኤጋ፤ መቃ ዋቆተ ብራ ህንዋመትና፤ አፋንኬሰኒዩ ህንበእን።<verse eid="EXO 23:13"/></para>
  <para style="s1">አያነ ወጋ ሰደን</para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 23:14"/>“አት ወጋት ዬሮ ሰዲ አያነ ና አያኔፈዹ።<verse eid="EXO 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 23:15"/>“አያነ መጥኖ አያኔፈዹ፤ አኩመ አን ስ አጀጄ ሰነ ቡልቲ ቶርበ መጥኖ ኛዹ። ዋን ከነስ ጅአ አቢቢ ኬሰ ዬሮ ሙርታኤት ጎዽ፤ አት ጅአ ሰነ ኬሰ ግብጢ ባቴቲ።</para>
  <para style="p" vid="EXO 23:15">“ነምን ቶኮዩ ሀርከ ዱዋ ፉለኮ ዱረት ህንዽኣትን።<verse eid="EXO 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 23:16"/>“መታ ምዻንኬቲ ከን ለፈ ቆቲሳኬት ፈጫፈቴን አያነ ገልቻ ምዻኒ አያኔፈዹ።</para>
  <para style="p" vid="EXO 23:16">“ዹመ ወጋት ዬሮ ምዻንኬ ለፈ ቆቲሳራ ወልት ቀበቱት አያነ ገልቻ ምዻኒ አያኔፈዹ።<verse eid="EXO 23:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 23:17"/>“ዺር ሁንድ ወጋት ዬሮ ሰዲ ፉለ <char style="nd">ዋቀዮ</char> ጎፍታ ዱረት ሃዽኣቱ።<verse eid="EXO 23:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 23:18"/>“ዺገ ኣርሳ ዋን ራጭቲ ቀቡ ወጅን ና ህንዽኤስን።</para>
  <para style="p" vid="EXO 23:18">“ጮምን ኣርሳ አያነኮስ ሀመ በሪት ህንቱርን።<verse eid="EXO 23:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 23:19"/>“መታ ምዻን ለፈኬቲ ኬሳ ፍለተማሳ ገረ መነ <char style="nd">ዋቀዮ</char> ዋቀኬቲ ፍድ።</para>
  <para style="p" vid="EXO 23:19">“እልሞ ሬኤ ኣነን ሃዸሼቲን ህንአፌልን።<verse eid="EXO 23:19"/></para>
  <para style="s1">ኤርገማን ዋቀዮ ከራ ቆጴሱሳ</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 23:20"/>“አከ እን ከራረት ስ ኤጌ እዶ አን ቆጴሴት ስ ገልቹፍ ኩኖ አን ፉለኬ ዱረ ኤርገማኮ ቶኮ ነንኤርገ። <verse eid="EXO 23:20"/><verse number="21" style="v" sid="EXO 23:21"/>ጥዬፈዹቲ ዋን እን ጄዹ ዸጌፈዹ። እሰት ህንፍንጭልን፤ እን ዋን መቃኮ ኦፍራ ቀቡፍ ፍንጭለኬ ሲፍ ህንዺሱቲ። <verse eid="EXO 23:21"/><verse number="22" style="v" sid="EXO 23:22"/>ዮ አት ዋን እን ጄዹ አከ ጋሪ ዸጌፈቴ ዋን አን ዱበዹ ሁንደ ጎቴ፣ አን ዲኖተኬት ዲነ ነንተአ፤ ወረ ሲን ሞርመኒንስ ነንሞርመ። <verse eid="EXO 23:22"/><verse number="23" style="v" sid="EXO 23:23"/>ኤርገማንኮስ ፉለኬ ዱረ ዴሜ ብየ አሞሮታት፣ ሄቶታት፣ ፌርዞታት፣ ከነኣኖታት፣ ሂዎታቲፊ ዬቡሶታት ስ ገልቸ፤ አንስ ጀረ ነንበሌሰ። <verse eid="EXO 23:23"/><verse number="24" style="v" sid="EXO 23:24"/>ዋቆተሳኒቲፍ ህንሰገድን፤ ህንዋቄፈትንስ፤ ሆጂሳኒ ፋነስ ህንቡእን። አት እሳን በሌስቴ ሶዱ ዋቄፈትናሳኒሌ ጨጨብሱ ቀብደ። <verse eid="EXO 23:24"/><verse number="25" style="v" sid="EXO 23:25"/><char style="nd">ዋቀዮ</char> ዋቀኬ ዋቄፈዹ፤ እንስ ምዻንኬቲፊ ብሻንኬ ንኤብሰ። ዹኩበስ እስን ግዱዻ ነንበሌሰ፤ <verse eid="EXO 23:25"/><verse number="26" style="v" sid="EXO 23:26"/>ብየኬ ኬሰት ዱበርቲን ኡልፍ እራ በኡ ዮካን ዸብዱን ቶኮዩ ህንአርገምቱ። ጅሬኘ ጉቱስ ሲፍ ነንኬነ።<verse eid="EXO 23:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 23:27"/>“አን ሶዳችሱኮ ስ ዱረ ኤርጌ ሰበ አት እት ዹፍቱ ሁንደ ነንቡርጃጄሰ። አከ ዲኖትንኬ ሁንድኑ ዱግደ ስት ገለኒ በቀተንስ ነንጎዸ። <verse eid="EXO 23:27"/><verse number="28" style="v" sid="EXO 23:28"/>አከ እን ሂዎተ፣ ከነኣኖታፊ ሄቶተ ከራኬራ አርኡፍ አን ስ ዱራን ሶንሰ ነንኤርገ። <verse eid="EXO 23:28"/><verse number="29" style="v" sid="EXO 23:29"/>አከ ለፍት ኦኔ ብኔንስ ወል ሆሬ ስት ህንባይአኔፍ አን ወጋ ቶኮ ኬሰት ሰበ ከነ ስ ዱራ አርኤ ህንባሱ። <verse eid="EXO 23:29"/><verse number="30" style="v" sid="EXO 23:30"/>ሀመ አት ባይአቴ ብየቲ ዻልቱት አን ጥኖ ጥኖን ፉለኬ ዱራ እሳን ነንባሰ።<verse eid="EXO 23:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 23:31"/>“አንስ ዳሪኬ ገላነ ዲማዻ ጀልቀቤ ሀመ ገላነ ፍልስጤሚት፣ ለፈ አሎቲ ጀልቀቤ ሀመ ለገ ኤፍራጢሲት ሲፍን ዻበ። ነሞተ ብየ ሰነ ጅራተንስ ደበርሴ ሀርከኬት ነንኬነ፤ አትሞ ኦፍ ዱራ አሪቴ እሳን ባፍተ። <verse eid="EXO 23:31"/><verse number="32" style="v" sid="EXO 23:32"/>አት እሳን ወጅን ዮካን ዋቆተሳኒ ወጅን ከኩ ቶኮሌ ህንገልን። <verse eid="EXO 23:32"/><verse number="33" style="v" sid="EXO 23:33"/>አከ እሳን ብየኬ ኬሰ ጅራተን ህንኤየመኒፍ፤ ዮ አከስ ተኤ እሳን አከ አት ጩቡ ነት ሆጄቱ ስ ጎዹ፤ አት ዋቆተሳኒ ዋቄፈትናን ኩን ዹጉማን ክዮ ስት ተኣቲ።”<verse eid="EXO 23:33"/></para>
  <chapter eid="EXO 23"/>
  <chapter number="24" style="c" sid="EXO 24"/>
  <para style="s1">ከኩን ጀቤፈሜ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 24:1"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ “አቲፊ አሮን፣ ናዳቢፊ አቢሁ፣ ማንጉዶተ እስራኤል ኬሳስ ነሞትን ቶርባተምን ገረ <char style="nd">ዋቀዮት</char> ኦል በኣ፤ አላለት ሰገዳ፤ <verse eid="EXO 24:1"/><verse number="2" style="v" sid="EXO 24:2"/>ገሩ ሙሴን ቆፍት <char style="nd">ዋቀዮት</char> ሃዽኣቱ፤ ወር ካንሞ ህንዽኣትን። ሰብን እሰ ወጅን ኦል ህንበእን።”<verse eid="EXO 24:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 24:3"/>ሙሴንስ ዸቄ ዱቢፊ ሴረ <char style="nd">ዋቀዮ</char> ሁንደ ሰበ ሰነት ህሜ፤ ሰብን ሱንስ፣ “ኑ ዋን <char style="nd">ዋቀዮ</char> ጄዼ ሁንደ ንጎነ” ጄዼ አፋን ቶኮን ዴብሴ። <verse eid="EXO 24:3"/><verse number="4" style="v" sid="EXO 24:4"/>ኤርገሲ ሙሴን ዋን <char style="nd">ዋቀዮ</char> ዱበቴ ሁንደ በሬሴ።</para>
  <para style="p" vid="EXO 24:4">ጉያ እት ኣኑ ገነማንስ ከኤ ሚለ ቱሉ ጀለት እዶ ኣርሳ እጃሬ፤ ኡቱባ ዸጋ ኩዸ ለመ ከኔን ጎሶተ እስራኤል ኩዸ ለማን እዶ ቡአንስ ዻቤ። <verse eid="EXO 24:4"/><verse number="5" style="v" sid="EXO 24:5"/>እንስ ደርገጎተ እስራኤል ኤርጌ፤ እሳንስ ኣርሳ ጉበሙፊ ጅቦተ ኣርሳ ነጋ ጎዸኒ <char style="nd">ዋቀዮፍ</char> ዽኤሰን። <verse eid="EXO 24:5"/><verse number="6" style="v" sid="EXO 24:6"/>ሙሴንስ ወለካ ዺገ ሰና ወጪቲት ነቄ፤ ወለካ ሀፌሞ እዶ ኣርሳረት ፈፈጫሴ። <verse eid="EXO 24:6"/><verse number="7" style="v" sid="EXO 24:7"/>እንስ ክታበ ከኩ ፉዼ ሰበ ሰናፍ ዱብሴ። እሳንስ፣ “ኑ ዋን <char style="nd">ዋቀዮ</char> ጄዼ ሁንደ ንጎነ፤ ንአጀጀምነስ” ጄዸኒ ዴብሰን።<verse eid="EXO 24:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 24:8"/>ዮሙስ ሙሴን ዺገ ሰነ ፉዼ ሰበት ፈፈጫሴ፣ “ኩኖ ኩን ዺገ ከኩ ከን <char style="nd">ዋቀዮ</char> አኩመ ዱቢ ከነ ሁንዳት እስኒ ዻቤዸ” ጄዼ።<verse eid="EXO 24:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 24:9"/>ሙሴፊ አሮን፣ ናዳቢፊ አቢሁ፣ ማንጉዶትን እስራኤል ቶርባተምንስ ኦል በአኒ <verse eid="EXO 24:9"/><verse number="10" style="v" sid="EXO 24:10"/>ዋቀ እስራኤል አርገን። ሚለሳ ጀለትስ ዋን አከ አፋ ዸጋ ሰንፔር ከን አኩመ ሰሚት ቁልቁላኤ ቶኮቱ አፈሜ ቱሬ። <verse eid="EXO 24:10"/><verse number="11" style="v" sid="EXO 24:11"/>ዋቅን ገሩ ቆንዳልቶተ ሰበ እስራኤል ከኔንት ሀርከሳ ኦል እት ህንካፍኔ፤ እሳን ዋቀ አርገን፤ ንኛተን፤ ንዹገንስ።<verse eid="EXO 24:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 24:12"/>
    <char style="nd">ዋቀዮስ</char> ሙሴዻን፣ “ገረኮት ቱሉት ኦል በእ፤ አስስ ቱር፤ አንስ ገበቴወን ዸጋ ከኔን አን አከ ቀጄልፈመሳኒ ተኡፍ ሴራፊ አጀጀወን እት በሬሴ ሲፍ ነንኬነ” ጄዼ።<verse eid="EXO 24:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 24:13"/>ኤርገሲ ሙሴን ገርጋራሳ እያሱ ወጅን ከኤ ዴሜ፤ ሙሴንስ ቱሉ ዋቃት ኦል በኤ። <verse eid="EXO 24:13"/><verse number="14" style="v" sid="EXO 24:14"/>እንስ ማንጉዶተ ሰናን አከነ ጄዼ፤ “ሀመ ኑ ገረኬሰንት ዴብኑት አስት ኑ ኤጋ። ኩኖ አሮኒፊ ሁር እስን ብረ ጅረን፤ ነምን ፈልሚ ቀቡ እሳን ብረ ዸቁ ደንደአ።”<verse eid="EXO 24:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 24:15"/>ዬሮ ሙሴን ቱሉት ኦል በኤት ዱሜስ ቱሉ ሰነ ሀጉጌ፤ <verse eid="EXO 24:15"/><verse number="16" style="v" sid="EXO 24:16"/>ኡልፍን <char style="nd">ዋቀዮስ</char> ቱሉ ሲናረ ቡኤ። ዱሜስ ሱንስ ጉያ ጀአ ቱሉ ሰነ ሀጉጌ፤ ጉያ ቶርበፋትሞ <char style="nd">ዋቀዮ</char> ዱሜስቸ ኬሳ ሙሴ ዋሜ። <verse eid="EXO 24:16"/><verse number="17" style="v" sid="EXO 24:17"/>ኡልፍን <char style="nd">ዋቀዮስ</char> እብደ ዋ ጉቡ ፈካቴ ፊጤ ቱሉራ ሰበ እስራኤልት ሙልአቻ ቱሬ። <verse eid="EXO 24:17"/><verse number="18" style="v" sid="EXO 24:18"/>ሙሴን ቱሉት ኦል በኤ ዱሜሰ ኬሰ ሴኔ። እንስ ጉያ አፉርተማፊ ሀልከን አፉርተመ ቱሉ ሰነረ ቱሬ።<verse eid="EXO 24:18"/></para>
  <chapter eid="EXO 24"/>
  <chapter number="25" style="c" sid="EXO 25"/>
  <para style="s1">ኬና ዱንካነ ቁልቁሉፍ ወልት ቀበሙ</para>
  <para style="r">
    <ref loc="EXO 25:1-7">25፥1‑7</ref> ኩወፈ – <char style="xt"><ref loc="EXO 35:4-9">በኡ 35፥4‑9</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 25:1"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ <verse eid="EXO 25:1"/><verse number="2" style="v" sid="EXO 25:2"/>“አከ እሳን ኬና ና ፍደኒፍ ሰበ እስራኤልት ህም። ነመ ገራሳ ጉቱዻን ኬኑ ፌዹ ሁንደ ሀርካ ኬና ና ፉዻ።<verse eid="EXO 25:2"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="3" style="v" sid="EXO 25:3"/>“ኬናን እሳን ሀርካ ፉተንስ፦</para>
  <para style="b" vid="EXO 25:3"/>
  <para style="li1" vid="EXO 25:3">“ወርቄ፣ ሜቲፊ ናሲ፤<verse eid="EXO 25:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="EXO 25:4"/>ክሪ ብፈ ጩቁሊሳ፣ ዺልጌ፣ ብልዲማፊ ወያ ሀጲ ቁንጬ ተልባራ ሆጄተሜ፤</para>
  <para style="li1" vid="EXO 25:4">ርፌንሰ ሬኤ፤<verse eid="EXO 25:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="EXO 25:5"/>ጎጋ ኮርቤሰ ሆላ ከን ሀሉ ዲማ ጩጰሜ፣ ጎጋ ዱገሜ፣</para>
  <para style="li1" vid="EXO 25:5">ሙከ ላፍቶ፣<verse eid="EXO 25:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="EXO 25:6"/>እብሳዻፍ፣ ዘይቲ ኤጄርሳ፣</para>
  <para style="li1" vid="EXO 25:6">ኡርጎፍቱወንሞ ዘይቲ ድበተሙፊ እጣነ ኡርጋኡፍ፤<verse eid="EXO 25:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="EXO 25:7"/>ዸጋወን ሰርዶንክሲ፣ ዶቀ ገት ጀቤሰ፣ ድረታፊ ቆሜረት ካአተሙዸ።<verse eid="EXO 25:7"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="8" style="v" sid="EXO 25:8"/>“ኤርገሲ አከ እሳን እዶ ቁልቁሉ ና ቆጴሰን ጎዽ፤ አንስ ግዱሳኒ ነንጅራዸ። <verse eid="EXO 25:8"/><verse number="9" style="v" sid="EXO 25:9"/>ዱንካነ ቁልቁሉ ከናፊ ምአሳ ሁንደ አኩመ ብፈ አን ስት አርግሲሱት ሆጄዻ።<verse eid="EXO 25:9"/></para>
  <para style="s1">ታቦተ</para>
  <para style="r">
    <ref loc="EXO 25:10-20">25፥10‑20</ref> ኩወፈ – <char style="xt"><ref loc="EXO 37:1-9">በኡ 37፥1‑9</ref></char></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 25:10"/>“እሳን ሙከ ላፍቶራ ታቦተ ሃቶልቸን፤ ታቦትን ሱንስ ዹንዹመ ለማፊ ወለካ ዼረተ፤ ዹንዹመ ቶኮፊ ወለካ በልአተ፤ ዹንዹመ ቶኮፊ ወለካ ኦል ዼረተ ቱሬ። <verse eid="EXO 25:10"/><verse number="11" style="v" sid="EXO 25:11"/>ኬሳፊ ዱበሳት ወርቄ ቁልቁሉ ኡፍስ፤ ናኖ እሳትስ መርሳ ፋየ ወርቄ ናኔሲ ቶልች። <verse eid="EXO 25:11"/><verse number="12" style="v" sid="EXO 25:12"/>ታቦተ ሰናፍስ ቁቤላ ወርቄ አፉር ቶልቺቲ ሚለሳ አፍረንት ጄቹንስ ለመ ገመ ቶኮን፣ ለመሞ ገመ ካኒን እት ካእ። <verse eid="EXO 25:12"/><verse number="13" style="v" sid="EXO 25:13"/>ሙከ ላፍቶራ ደንቀራወን ቶልቺቲ ወርቄ እት ኡፍስ። <verse eid="EXO 25:13"/><verse number="14" style="v" sid="EXO 25:14"/>ታቦትቸ እቲን ባቹዻፍ ደንቀራወን ሰነ ቁቤላወን ኬሰ ሎስ። <verse eid="EXO 25:14"/><verse number="15" style="v" sid="EXO 25:15"/>ደንቀራወን ኩኔን ቁቤላወን ታቦትቻ ኬሰ ሃቱረን፤ ኬሳ ባፈሙስ ህንቀበን። <verse eid="EXO 25:15"/><verse number="16" style="v" sid="EXO 25:16"/>አትስ ዹገ በኡምሰ አን ስት ኬኑ ታቦትቸ ኬሰ ካእ።<verse eid="EXO 25:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 25:17"/>“ወርቄ ቁልቁሉራ ቴሶ አራራ ቶልች፤ ዼርንሳስ ዹንዹመ ለማፊ ወለካ፣ በልእንሳሞ ዹንዹመ ቶኮፊ ወለካ ሃተኡ። <verse eid="EXO 25:17"/><verse number="18" style="v" sid="EXO 25:18"/>ሞጋ ለማን ቴሶ አራራረት ወርቄ ቱመሜራ ኪሩቤሊ ለመ ቶልች። <verse eid="EXO 25:18"/><verse number="19" style="v" sid="EXO 25:19"/>ኪሩቢ ቶኮ ሞጋ ቶኮረት፣ ኪሩቢ ለመፋሞ ሞጋ ካንረት ቶልች፤ ኪሩቤሊ ሰነስ ቴሶ አራራ ወጅን ኩታ ወርቄ ቶክቸራ ሞጋ ለማንረት ቶልች። <verse eid="EXO 25:19"/><verse number="20" style="v" sid="EXO 25:20"/>ኪሩቤሊን ሱን ቆቾሳኒ ኦል በልእፈተኒ ቴሶ አራራ እቲን ሃጋድሴሰን፤ ኪሩቤሊን ኩኔን ፉለሳኒ ወልት ገረገልፈተኒ ቴሶ አራራ ሃእላለን። <verse eid="EXO 25:20"/><verse number="21" style="v" sid="EXO 25:21"/>ቴሶ አራራ ሰነ ታቦትቸረ ካእ፤ ዹገ በኡ አን ስት ኬኑሞ ታቦትቸ ኬሰ ካእ። <verse eid="EXO 25:21"/><verse number="22" style="v" sid="EXO 25:22"/>አን አችት ስ አርገ፤ ቴሶ አራራራ፣ ኪሩቤሊ ለማን ታቦተ ከኩ ሴራረ ጅረን ግዱዻ ዋኤ አጀጀወን አን ሰበ እስራኤሊቲፍ ስት ኬኑ ሁንዳ ስትን ህመ።<verse eid="EXO 25:22"/></para>
  <para style="s1">ምንጃለ</para>
  <para style="r">
    <ref loc="EXO 25:23-29">25፥23‑29</ref> ኩወፈ – <char style="xt"><ref loc="EXO 37:10-16">በኡ 37፥10‑16</ref></char></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 25:23"/>“ሙከ ላፍቶራ ምንጃለ ዹንዹመ ለመ ደልገ ዼረቱ፣ ከን ዹንዹመ ቶኮ በልአቴ ኦል ዼርንሳሞ ዹንዹመ ቶኮፊ ወለካ ተኤ ቶልች። <verse eid="EXO 25:23"/><verse number="24" style="v" sid="EXO 25:24"/>ወርቄ ቁልቁሉ እት ኡፍሲቲ ናኖሳት መርሳ ወርቄ ቶልች። <verse eid="EXO 25:24"/><verse number="25" style="v" sid="EXO 25:25"/>ናኖሳረትስ ህዺ ሀመ በልእነ ሀርካ ገኡፊ ፋየ ወርቄ ቶልች። <verse eid="EXO 25:25"/><verse number="26" style="v" sid="EXO 25:26"/>ምንጃለ ከናፍስ ቁቤላ ወርቄ አፉር ሆጄዹቲ ጎሌወን አፍረንት እዶ ሚል አፍረን ጅረንት ካእ። <verse eid="EXO 25:26"/><verse number="27" style="v" sid="EXO 25:27"/>ቁቤላወን ኩኔንስ አከ ደንቀራ እቲን ምንጃለ ባተን ቀበተኒፍ ጥዮ ሰነት ዽኣቹ ቀቡ። <verse eid="EXO 25:27"/><verse number="28" style="v" sid="EXO 25:28"/>ሙከ ላፍቶራ ሎሰወን ቶልች፤ ወርቄ እት ኡፍሲቲ ምንጃለ ሰነ እቲን ባዹ። <verse eid="EXO 25:28"/><verse number="29" style="v" sid="EXO 25:29"/>ዽባዩ ዽኤሱፍስ ጫቢወንሳ፣ ወጪቲወንሳ፣ ኦኮቴወንሳቲፊ ወጪቲወንሳ ወርቄ ቁልቁሉራ ቶልች። <verse eid="EXO 25:29"/><verse number="30" style="v" sid="EXO 25:30"/>ቡዴነ እላልቻስ ዬሮ ሁንደ ፉለኮ ዱረ ምንጃለ ከነረ ካእ።<verse eid="EXO 25:30"/></para>
  <para style="s1">ባቱ እብሳ</para>
  <para style="r">
    <ref loc="EXO 25:31-39">25፥31‑39</ref> ኩወፈ – <char style="xt"><ref loc="EXO 37:17-24">በኡ 37፥17‑24</ref></char></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 25:31"/>“ባቱ እብሳስ ወርቄ ቁልቁሉራ ቶልች፤ ባቱን እብሳ ኩንስ ቱመሜ ሃቶልፈሙ፤ ሶማሳ፣ ደሜሳ፣ ወጪቲሳ፣ ሁዻሳቲፊ ደራራሳ ወርቄዹመ ሰነራ ቶልች። <verse eid="EXO 25:31"/><verse number="32" style="v" sid="EXO 25:32"/>ብታ ምርገ ባቱ እብሳ ሰነ ኬሳስ ደሜወን ጀአ ጄቹንስ ሰዲ ገመ ቶኮን፣ ሰዲሞ ገመ ካኒን ሃባፈመን። <verse eid="EXO 25:32"/><verse number="33" style="v" sid="EXO 25:33"/>ጦፎወን ለዉዚ ፈካተን ከኔን ቶኮን ቶኮንሳኒ ሁዻፊ ደራራ ቀበን ሰዲ ደሜ ቶኮረት፣ ወጪቲወን ለዉዚ ፈካተን ከኔን ቶኮን ቶኮንሳኒ ሁዻፊ ደራራ ቀበን ሰዲሞ ደሜ ካንረት ቶልች፤ ደሜወን ጀኣን ባቱ እብሳራ በበአን ሁንደረትስ አከሱመ ቶልች። <verse eid="EXO 25:33"/><verse number="34" style="v" sid="EXO 25:34"/>ጦፎወን ሁዻፊ ደራራ ቀበን ከኔን ብፈ ለዉዚቲን ሆጄተመን አፉር ባቱ እብሳ ሰነረ ሃጅራተን። <verse eid="EXO 25:34"/><verse number="35" style="v" sid="EXO 25:35"/>ሁዻን ቶኮ ጭምዲ ጀልቀባ ከን ደሜወን ባቱ እብሳራ በበአን ጀለ፣ ሁዻን ለመፋን ጭምዲ ለመፋ ጀለ፣ ሁዻን ሰደፋንሞ ጭምዲ ሰደፋ ጀለ ቱሬ። ወሉማ ገለት ደሜወን ጀአቱ ቱሬ። <verse eid="EXO 25:35"/><verse number="36" style="v" sid="EXO 25:36"/>ሁዻወኒፊ ደሜወን ሁንድኑ ባቱ እብሳ ሰነ ወጅን ወርቄዹመ ቁልቁሉ ቱመሜ ቶኮራ ሃቶልፈመን።<verse eid="EXO 25:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="EXO 25:37"/>“አትስ እብሳወን ቶርበ ቶልቺፍ፤ አከ ለፈ ፉለሳኒ ዱረ ጅሩ እብሰኒፍስ ባቱ እብሳረ እሳን ዸዻብ። <verse eid="EXO 25:37"/><verse number="38" style="v" sid="EXO 25:38"/>ወን እቲን ዳራሳ ዸዸአኒፊ ጫቢን ዳራ ሰነ ባቱ ወርቄ ቁልቁሉራ ሃሆጄተመን። <verse eid="EXO 25:38"/><verse number="39" style="v" sid="EXO 25:39"/>ባቱን እብሳቲፊ ምእሳ ሁንድ ወርቄ ቁልቁሉ ታላንቲ ቶኮቲን ሃሆጄተመን። <verse eid="EXO 25:39"/><verse number="40" style="v" sid="EXO 25:40"/>አትስ አኩመ ፈኬኘ ቱሉረት ስት አርግሲፈሜ ሰናት ሆጄቹኬ ምርከኔፈዹ።<verse eid="EXO 25:40"/></para>
  <chapter eid="EXO 25"/>
  <chapter number="26" style="c" sid="EXO 26"/>
  <para style="s1">ዱንካነ ቁልቁሉ</para>
  <para style="r">
    <ref loc="EXO 26:1-37">26፥1‑37</ref> ኩወፈ – <char style="xt"><ref loc="EXO 36:8-38">በኡ 36፥8‑38</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 26:1"/>“ጎልጋወን ኩዸን ከኔን ቁንጬ ተልባ ጋሪ ፎአሜፊ ከን ክሪ ብፈ ጩቁሊሳ፣ ዺልጌፊ ብልዲማራ ሆጄተመኒን ዱንካነ ቁልቁሉ ሆጄዹ፤ ጎልጋወን ሰነረትስ ኦጌስ ሀርከ ቀጄሉ ቶኮ ኪሩቤሊ ሃሆጄቱ። <verse eid="EXO 26:1"/><verse number="2" style="v" sid="EXO 26:2"/>ጎልጋወን ሁንድኑ ወል ቅጤ ሃተአን፤ ዼርን ቶኮ ቶኮ ጎልጋወኒ ዹንዹመ ድግደሚ ሰዴት፣ በልእንሳሞ ዹንዹመ አፉር ሃተኡ። <verse eid="EXO 26:2"/><verse number="3" style="v" sid="EXO 26:3"/>ጎልጋወን ሸን ወልት ቀብሲስ፤ ጎልጋወን ሀፈን ሸነን ካንሌ አከሱመ ወልት ቀብሲስ። <verse eid="EXO 26:3"/><verse number="4" style="v" sid="EXO 26:4"/>ጎልጋወን ወልት ቀብሲፈመን ከኔን ጀልቀባ ኬሳ ሀንዳረ እሰ ሞጋረት ሁጩ ብፈ ጩቁሊሳራ ጉሮወን ቶልች፤ ጎልጋወን ወልት ቀብሲፈመን ለመፋረትስ አከሱመ ቶልች። <verse eid="EXO 26:4"/><verse number="5" style="v" sid="EXO 26:5"/>ጉሮወን ሸንተመ ጎልጋ ቶኮረት ቶልች፤ ጉሮወን ሸንተመሞ ጎልጋወን ወልት ቀብሲፈመን ለመፋ ኬሳ ሞጋ እሰ ቶኮት ቶልች። ጉሮወን ሱንስ ገማ ገመነት ሃቶልፈመን። <verse eid="EXO 26:5"/><verse number="6" style="v" sid="EXO 26:6"/>አከ ዱንካን ቁልቁሉን ሱን ቶኮ ተኡፍስ ሆኮወን ወርቄ ሸንተመ ቶልቺቲ ጎልጋወን ሰነ እቲን ወልት ቀብሲስ።<verse eid="EXO 26:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 26:7"/>“ሀጉጊ ጉባ ዱንካነ ቁልቁሉረ ጅሩ ሀጉጉፍስ ጎልጋወን ርፌንሰ ሬኦታ ኩዸ ቶኮ ሆጄዹ። <verse eid="EXO 26:7"/><verse number="8" style="v" sid="EXO 26:8"/>ጎልጋወን ኩዸ ቶኮን ሱን ሁንድ ወል ቅጤ ሃተአን፤ ዼርንሳኒ ዹንዹመ ሶዶመ፣ በልእንሳኒሞ ዹንዹመ አፉር ሃተኡ። <verse eid="EXO 26:8"/><verse number="9" style="v" sid="EXO 26:9"/>ጎልጋወን ሸን እዶ ቶኮት ወልት ቀብሲስ፤ ጎልጋወን ጀአን ካንሞ እዶ ቶኮት ወልት ቀብሲስ፤ ጎልጋ ጀአፋ ሰነስ ፉለ ዱንካንቻ ዱራን እዶ ለመት ኦል ደቻስ። <verse eid="EXO 26:9"/><verse number="10" style="v" sid="EXO 26:10"/>ጎልጋወን ገመ ቶኮን ወልት ቀብሲፈመን ኬሳ ሀንዳረ እሰ ሞጋረት ጉሮወን ሸንተመ ቶልች፤ ጎልጋወን ገመ ካንረት ወልት ቀብሲፈመን ኬሳስ ሀንዳረ እሰ ሞጋረት ጉሮወን ሸንተመ ቶልች። <verse eid="EXO 26:10"/><verse number="11" style="v" sid="EXO 26:11"/>ኤርገሲስ ቀብዱወን ናሲ ሸንተመ ቶልች፤ ቀብዱወን ሰነስ አከ እን ቶኮ ተኡፍ እቲን ወልት ቀብሲሱፍ ጉሮወን ኬሰ ገልች። <verse eid="EXO 26:11"/><verse number="12" style="v" sid="EXO 26:12"/>ወን ጎልጋወን ዱንካንቻራ ሀፌ፣ ወለካን ጎልጋ ሀፌ ሰና ዱግደ ዱንካነ ቁልቁሉ እራን ገድ ሃረረኡ። <verse eid="EXO 26:12"/><verse number="13" style="v" sid="EXO 26:13"/>አከ ዱንካነ ቁልቁሉ ሰነ ሀጉጉፍስ ዼርነ ጎልጋወን ዱንካንቸራ ሀፌ ኬሳ ዹንዹምን ቶኮ ገመ ቶኮን፣ ዹንዹምን ቶኮሞ ገመ ካኒን ብታፊ ምርጋን ዱንካነ ቁልቁሉ እራን ገድ ሃረረኡ። <verse eid="EXO 26:13"/><verse number="14" style="v" sid="EXO 26:14"/>ዱንካነ ሰናፍስ እረ ቡሳ ከልዼ ኮርቤሰ ሆላ ከን ሀሉ ዲማ ጩጰሜ፣ እሰ እራንሞ እረ ቡሳ ጎጋ ዱገሜ ሆጄዹ።<verse eid="EXO 26:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 26:15"/>“ዱንካነ ቁልቁሉ ሰናፍስ ሙከ ላፍቶራ ቱጌወን ቀቀጄሎ ሆጄዹ። <verse eid="EXO 26:15"/><verse number="16" style="v" sid="EXO 26:16"/>ዼርን ቶኮ ቶኮ ቱጌወን ሰናስ ዹንዹመ ኩዸን፣ በልእንሳሞ ዹንዹመ ቶኮፊ ወለካ ሃተኡ፤ <verse eid="EXO 26:16"/><verse number="17" style="v" sid="EXO 26:17"/>ቶኮን ቶኮን ቱጌወን ሰናስ አከ ወል ኬሰ ገሉ ደንደኡፍ ሙቸ ለመ ለመ ሃቀባቱ፤ ቱጌወን ዱንካነ ቁልቁሉ ሰና ሁንደ አከስት ቶልች። <verse eid="EXO 26:17"/><verse number="18" style="v" sid="EXO 26:18"/>ገመ ክበ ዱንካነ ቁልቁሉ ሰናቲፍስ ቱጌወን ድግደመ ሆጄዹ፤ <verse eid="EXO 26:18"/><verse number="19" style="v" sid="EXO 26:19"/>ቱጌወን ድግደመን ሰነ ጀለት ሚለ ሜቲ አፉርተመ ጄቹንስ ቱጌ ቶኮ ጀለት ሚለ ለመ ጉረሳ ለማኒፍ፣ ቱጌ ካን ጀለትስ ሚለ ለመ ጉረሳ ለማኒፍ ቶልች። <verse eid="EXO 26:19"/><verse number="20" style="v" sid="EXO 26:20"/>ገመ ዱንካነ ቁልቁሉ ሰና ካኒፍስ ከራ ካባቲን ቱጌወን ድግደመ ቶልች፤ <verse eid="EXO 26:20"/><verse number="21" style="v" sid="EXO 26:21"/>ሚለ ሜቲስ አፉርተመ ጄቹንስ ቱጌ ቶኮ ጀለት ሚለ ለመ፣ ቱጌ ካን ጀለትስ ሚለ ለመ ቶልች። <verse eid="EXO 26:21"/><verse number="22" style="v" sid="EXO 26:22"/>ከራ ልጠ ቢፍቱቲን፣ ዱግደ ዱበ ዱንካነ ቁልቁሉ ሰናቲፍ ቱጌ ጀአ ቶልች፤ <verse eid="EXO 26:22"/><verse number="23" style="v" sid="EXO 26:23"/>ከራ ዱግደ ዱባስ ጎሌ ዱንካነ ቁልቁሉ ሰናቲፍ ኡቱባ ለመ ቶልች። <verse eid="EXO 26:23"/><verse number="24" style="v" sid="EXO 26:24"/>ቱጌወን ጎሌ ኩኔን ጀላ ሀመ ጉባት ወልት ፈይፈመኒ በንቲረት ቁቤላ ቶኮን ወልት ሃቀብሲፈመን፤ ቱጌወን ጎሌ ለማኒስ አከሱመ ተኡ ቀቡ። <verse eid="EXO 26:24"/><verse number="25" style="v" sid="EXO 26:25"/>ከናፉ ቱጌወን ሰዴት ከኔን ሚለ ሜቲ ኩዸ ጀአ ቀበንቱ ጅረ፤ ቶኮን ቶኮን ቱጌ ሰናስ ሚለ ለመ ለመ ቀበ።<verse eid="EXO 26:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 26:26"/>“አከሱመስ ሙከ ላፍቶራ ደገሌወን ቶልች፤ ቱጌወን ዱንካነ ቁልቁሉ ሰነረ ገመ ቶኮን ጅረኒፍ ደገሌወን ሸን፣ <verse eid="EXO 26:26"/><verse number="27" style="v" sid="EXO 26:27"/>ቱጌወን ገመ ካኒን ጅረኒፍ ደገሌወን ሸን፣ ሸን ቱጌወን ዱግደ ዱባን ከራ ልጠ ቢፍቱቲን ጅረኒፍሞ ደገሌወን ሸን ቶልች። <verse eid="EXO 26:27"/><verse number="28" style="v" sid="EXO 26:28"/>ደገሌ ወለካ ጅሩ ሰነ አከ እን ግዱ ቱጌወኒቲን ሞጋ ቶኮ ሀመ ሞጋ ካኒት ፉለኡ ጎዽ። <verse eid="EXO 26:28"/><verse number="29" style="v" sid="EXO 26:29"/>ቱጌወን ሰነረስ ወርቄ እት ኡፍስ። አከ ደገሌወን ባተኒፍ ቁቤላወን ወርቄ እት ቶልች፤ ደገሌወን ሰነስ አከሱመ ወርቄ እት ኡፍስ።<verse eid="EXO 26:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 26:30"/>“ዱንካነ ቁልቁሉ ከነ አኩመ ከሮረ ቱሉረት ስት አርግሲፈሜ ሰናት ዻብ።<verse eid="EXO 26:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 26:31"/>“ክሪ ብፈ ጩቁሊሳ፣ ዺልጌ፣ ብልዲማፊ ቁንጬ ተልባ ሀጲራ ጎልጋ ቱልች፤ ጎልጋ ከነረትስ ኦጌስ ሀርከ ቀጄሉ ቶኮ ፈኪ ኪሩቤሊ ሃቶልቹ። <verse eid="EXO 26:31"/><verse number="32" style="v" sid="EXO 26:32"/>ጎልጋ ከነ ሆኮ ወርቄቲን ኡቱባወን ሙከ ላፍቶ ከኔን ወርቄን እት ኡፍፈሜ ሚለ ሜቲ አፉርረ ዸዻበተን አፉርት ረራስ። <verse eid="EXO 26:32"/><verse number="33" style="v" sid="EXO 26:33"/>ጎልጋ ሰነ ሆኮወንት ረራሲቲ ታቦተ ከኩ ሴራሞ ዱግደሳ ዱባን ካእ። ጎልጋን ሱንስ እዶ ቁልቁሉ፣ እዶ እዶ ሁንደ ጫላ ቁልቁሉ ተኤ ሰነራ አዳን ባሰ። <verse eid="EXO 26:33"/><verse number="34" style="v" sid="EXO 26:34"/>ቴሶ አራራስ እዶ እዶ ሁንደ ጫላ ቁልቁሉ ተኤ ሰነ ኬሰ ታቦተ ከኩ ሴራረ ካእ። <verse eid="EXO 26:34"/><verse number="35" style="v" sid="EXO 26:35"/>ምንጃለ ሰነስ ጎልጋዻን አለ፣ ገመ ካበ ዱንካነ ቁልቁሉቲን ዻብ፤ ባቱ እብሳሞ ፉሌ ምንጃለ ሰና ገመ ክበ ዱንካንቸቲን ዻብ።<verse eid="EXO 26:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="EXO 26:36"/>“በልበለ ዱንካንቻቲፍሞ ጎልጋ ክሪ ብፈ ጩቁሊሳ፣ ዺልጌ፣ ብልዲማፊ ቁንጬ ተልባ ከን ቀልእፈሜ ፎአሜ ሀርካን እረት ሆዸሜ ቶኮ ፋዬሲ ቶልች። <verse eid="EXO 26:36"/><verse number="37" style="v" sid="EXO 26:37"/>ጎልጋ ከናፍስ ሆኮ ወርቄቲፊ ኡቱባ ሙከ ላፍቶ ከን ወርቄን እት ኡፍፈሜ ሸን ቶልች። ናሲ ቱሚቲ ሚለ ሸን ቶልቺፍ።<verse eid="EXO 26:37"/></para>
  <chapter eid="EXO 26"/>
  <chapter number="27" style="c" sid="EXO 27"/>
  <para style="s1">እዶ ኣርሳ ኬና ጉበሙ</para>
  <para style="r">
    <ref loc="EXO 27:1-8">27፥1‑8</ref> ኩወፈ – <char style="xt"><ref loc="EXO 38:1-7">በኡ 38፥1‑7</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 27:1"/>“ሙከ ላፍቶራ እዶ ኣርሳ ዹንዹመ ሰዲ ኦል ዼረቱ እጃር፤ እዶን ኣርሳ ኩንስ ዼርነ ዹንዹመ ሸኒፊ በልእነ ዹንዹመ ሸኒ ቀባቴ ገመ አፍረኒኑ ወል ቅጤ ሃተኡ። <verse eid="EXO 27:1"/><verse number="2" style="v" sid="EXO 27:2"/>ቶኮ ቶኮ ጎሌወን አፍረኒት ጋንፈ ቶልች፤ ጋንፋፊ እዶን ኣርሳ ሱን ሙኩመ ቶኮራ ሃተኡ፤ እዶ ኣርሳ ሰነረትስ ናሲ ኡፍስ። <verse eid="EXO 27:2"/><verse number="3" style="v" sid="EXO 27:3"/>ምአሳ ሁንደ ጄቹንስ ዋን እቲን ዳራ ሀረን፣ ዋን እቲን ዳራ ሀማረን፣ ወጪቲ፣ ሆኮ ፎኒቲፊ ባቱ እብዳ ናሲራ ቶልች። <verse eid="EXO 27:3"/><verse number="4" style="v" sid="EXO 27:4"/>ናሲ ወል ኬሰ ጠጠሜን ግንግልቻ ሆጄዹቲ ቶኮ ቶኮ ሮገወን ግንግልቻ ሰና አፍረኒፍ ቁቤላወን ናሲ ቶልች። <verse eid="EXO 27:4"/><verse number="5" style="v" sid="EXO 27:5"/>ግንግልቻ ሰነስ አከ እን ሀመ ወለካ እዶ ኣርሳት ኦል ከኡፍ ቀርቀረ እዶ ኣርሳ ጀላን ካእ። <verse eid="EXO 27:5"/><verse number="6" style="v" sid="EXO 27:6"/>እዶ ኣርሳ ሰናፍስ ደንቀራወን ሙከ ላፍቶ ቶልቺቲ ናሲ እት ኡፍስ። <verse eid="EXO 27:6"/><verse number="7" style="v" sid="EXO 27:7"/>ደንቀራወን ሱንስ አከ ዬሮ እዶን ኣርሳ ባተሙት ገመ ለማኒን ኦለኒፍ ቁቤላወን ኬሰ ሃሎፈመን። <verse eid="EXO 27:7"/><verse number="8" style="v" sid="EXO 27:8"/>አኩመ ቱሉረት ስት አርግሲፈሜ ሰነት እዶ ኣርሳ ከን ኬስሳ ዱዋ ተኤ ሳንቃራ ሆጄዹ።<verse eid="EXO 27:8"/></para>
  <para style="s1">ኦብዲ</para>
  <para style="r">
    <ref loc="EXO 27:9-19">27፥9‑19</ref> ኩወፈ – <char style="xt"><ref loc="EXO 38:9-20">በኡ 38፥9‑20</ref></char></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 27:9"/>“ዱንካነ ቁልቁሉ ሰናፍ ኦብዲ ሆጄዹ። ኦብድችስ ገመ ክባቲን ዹንዹመ ዽበ ቶኮ ሃዼረቱ፤ እንስ ጎልጋ ቁንጬ ተልባ ጋሪ ፎአሜራ ሆጄተሜ <verse eid="EXO 27:9"/><verse number="10" style="v" sid="EXO 27:10"/>ኡቱባወን ድግደማፊ ሚለ ናሲ ድግደመ ቀበን ሃቀባቱ፤ ሆኮወኒፊ ሶማወን ኡቱባወን ከኔንስ ሜቲራ ሃሆጄተመን። <verse eid="EXO 27:10"/><verse number="11" style="v" sid="EXO 27:11"/>ገመ ካባቲንስ አከሱመ ዹንዹመ ዽበ ቶኮ ዼረቴ ጎልጋወን ኡቱባወን ድግደማፊ ሚለ ናሲ ድግደመ ቀበን ሃቀባቱ፤ ሆኮወኒፊ ሶማወን ኡቱባወን ከናስ ሜቲራ ሃቶልፈመን።<verse eid="EXO 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 27:12"/>“ኦብዲን ኩን ገመ ልጣቲን ዹንዹመ ሸንተመ በልአቴ ጎልጋወን፣ ኡቱባ ኩዸኒፊ ሚለ ኩዸን ቀበን ሃቀባቱ። <verse eid="EXO 27:12"/><verse number="13" style="v" sid="EXO 27:13"/>ኦብዲን ኩን ፊጤ በኣቲን ከራ በአ ቢፍቱቲን አከሱመ ዹንዹመ ሸንተመ ሃበልአቱ። <verse eid="EXO 27:13"/><verse number="14" style="v" sid="EXO 27:14"/>ጎልጋወን ዹንዹመ ኩዸ ሸን ዼዼረተኒ ኡቱባ ሰዲፊ ሚለ ሰዲ ቀበንስ ከራ በልበለ ቶኮረ ሃጅራተን። <verse eid="EXO 27:14"/><verse number="15" style="v" sid="EXO 27:15"/>ጎልጋወን ዹንዹመ ኩዸ ሸን ዼዼረተኒ ኡቱባ ሰዲፊ ሚለ ሰዲ ቀበንስ ገመ ካኒን ሃጅራተን።<verse eid="EXO 27:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 27:16"/>“በልበለ ኦብዲ ሰናቲፍስ ጎልጋ ዹንዹመ ድግደመ ዼረቴ ኡቱባ አፉሪፊ ሚለ አፉር ቀቡ ከን ክሪ ብፈ ጩቁሊሳ፣ ዺልጌ፣ ብልዲማፊ ቁንጬ ተልባ ከን ቀልእፈሜ ፎአሜን ዸአሜረት ፋዬፈሜ ሆጄተሜ ቶኮ ቶልች። <verse eid="EXO 27:16"/><verse number="17" style="v" sid="EXO 27:17"/>ኡቱቦን ናኖ ኦብዲ ሰና ሁንድኑ ሶማወኒፊ ሆኮወን ሜቲቲፊ ሚለወን ናሲ ሃቀባተን። <verse eid="EXO 27:17"/><verse number="18" style="v" sid="EXO 27:18"/>ኦብዲን ሱን ዼርነ ዹንዹመ ዽበ ቶኮፊ በልእነ ዹንዹመ ሸንተማ ሃቀባቱ፤ ጎልጋ ቁንጬ ተልባ ጋሪ ፎአሜ ዹንዹመ ሸን ኦል ዼረቱፊ ሚለወን ናሲራ ሆጄተሜ ሃቀባቱ። <verse eid="EXO 27:18"/><verse number="19" style="v" sid="EXO 27:19"/>ምእ ተጃጅለ ዱንካነ ቁልቁሉ ሰናቲፍ ፈየዱ ብራ ሁንድ፣ ተጃጅለ ከምዩ ታናን፣ ቆፎ ዱንካንቻቲፊ ቆፎ ኦብዲ ሰና ሁንደ ደበለቴ ናሲራ ሃሆጄተሙ።<verse eid="EXO 27:19"/></para>
  <para style="s1">ዘይቲ ባቱ እብሳ</para>
  <para style="r">
    <ref loc="EXO 27:20-21">27፥20‑21</ref> ኩወፈ – <char style="xt"><ref loc="LEV 24:1-3">ሌዎ 24፥1‑3</ref></char></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 27:20"/>“አከ እብሳን እቱመ ፉፌ ቦበኡፍ አከ እሳን ዘይቲ ኤጄርሰ ጩንፈሜ ተሊለሳ እብሳዻፍ ሲፍ ፍደን ሰበ እስራኤል አጀጅ። <verse eid="EXO 27:20"/><verse number="21" style="v" sid="EXO 27:21"/>አሮኒፊ እልማንሳ ዱንካነ ወል ገኢ ኬሰት ጎልጋ ፉለ ታቦተ ከኩ ሴራ ዱረ ጅሩን አለት አከ እብሳን ሱን ገልገላ ሀመ ገነማት ፉለ <char style="nd">ዋቀዮ</char> ዱረት ቦበኡ ሃጎዸን። ወን ኩንስ ሰበ እስራኤል ኬሰት ዸሎተ ዹፉፍ ሴረ በረ በራ ሃተኡ።<verse eid="EXO 27:21"/></para>
  <chapter eid="EXO 27"/>
  <chapter number="28" style="c" sid="EXO 28"/>
  <para style="s1">ኡፈተ ሉቡማ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 28:1"/>“አከ እሳን ሉቦተ ተአኒ ነ ተጃጅለኒፍ ኦቦሌሰኬ አሮን፣ እሰ ወጅንስ እልማንሳ ናዳብ፣ አቢሁ፣ ኤሌኣዛሪፊ ኢታማርን ሰበ እስራኤል ኬሳ ኦፍት ዽኤስ። <verse eid="EXO 28:1"/><verse number="2" style="v" sid="EXO 28:2"/>አከ እን ኡልፍናፊ ሚዸግነ አርገቱፍስ ኦቦሌሰኬ አሮኒፍ ኡፈተ ቁልቁሉ ሆዽ። <verse eid="EXO 28:2"/><verse number="3" style="v" sid="EXO 28:3"/>አከ እን ሉበ ተኤ ነ ተጃጅሉፍ ነሞተ ቤኩምሰ ቀበን ከኔን አን ኦጉማ አከና ኬኔፍ ሁንደ አከ እሳን አከ እን አዳን ባፈሙፍ ጄዸኒ አሮኒፍ ኡፈተ ሆዸን እት ህም። <verse eid="EXO 28:3"/><verse number="4" style="v" sid="EXO 28:4"/>ኡፈትን እሳን ሆጄተንስ፦ ኪሲ ቆማ፣ ድረተ፣ ወንደቦ፣ ክታ ሚዸግፈሜ ዸወሜ፣ መረተ መታቲፊ ሰበታዸ። ጀርስ አከ እሳን ሉቦተ ተአኒ ነ ተጃጅለኒፍ ኦቦሌሰኬ አሮኒፊ እልማንሳቲፍ ኡፈተ ቁልቁሉ ከነ ሃሆጄተን። <verse eid="EXO 28:4"/><verse number="5" style="v" sid="EXO 28:5"/>ኦጌዪን ሱንስ ወርቄፊ ክሪ ብፈ ጩቁሊሳ፣ ዺልጌ፣ ብልዲማፊ ቁንጬ ተልባ ከን ቀልእፈሜ ፎአሜት ሃፈየደመን።<verse eid="EXO 28:5"/></para>
  <para style="s1">ኤፉዲ</para>
  <para style="r">
    <ref loc="EXO 28:6-14">28፥6‑14</ref> ኩወፈ – <char style="xt"><ref loc="EXO 39:2-7">በኡ 39፥2‑7</ref></char></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 28:6"/>“ኦጌሰ ሀርከ ቶሉ ቶኮ ወርቄ፣ ክሪ ብፈ ጩቁሊሳ፣ ዺልጌፊ ብልዲማፊ ቁንጬ ተልባ ከን ቀልእፈሜ ፎአሜን ድረተ ሆጄቺስ። <verse eid="EXO 28:6"/><verse number="7" style="v" sid="EXO 28:7"/>ድረን ኩንስ አከ ወልት ጉዱንፈሙ ደንደኡፍ ፉኞ ገቲቲ ለመ ከኔን ፊጤሳ ለማንት ረራፈመን ሃቀባቱ። <verse eid="EXO 28:7"/><verse number="8" style="v" sid="EXO 28:8"/>ሰበንሳ ከን ኦጉማዻን ዸአሜስ አኩመሳ ድረተ ወጅን ቶኮ ተኤ ወርቄዻን፣ ክሪ ብፈ ጩቁሊሳ፣ ዺልጌ፣ ብልዲማፊ ቁንጬ ተልባ ከን ቀልእፈሜ ፎአሜን ሃሆጄተሙ።<verse eid="EXO 28:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 28:9"/>“ዸጋወን ሰርዶንክሲ ለመ ፉዺቲ መቃ እልማን እስራኤል እሳንረት ሶፊ በሬስ። <verse eid="EXO 28:9"/><verse number="10" style="v" sid="EXO 28:10"/>አኩመ ቶረ ዸሎተሳኒት፣ መቃ ጀአ ዸጋ ቶኮረት፣ መቃ ጀኣን ሀፌስ ዸጋ ካንረት ሶፊ በሬስ። <verse eid="EXO 28:10"/><verse number="11" style="v" sid="EXO 28:11"/>አኩመ ኦጌስ ፋያ ቶኮ ቻፓ ሶፌ ሆጄቱ ሰነ አትስ ዸጋ ለማን ሰነረት መቃ እልማን እስራኤል ሶፊ በሬስ፤ ኤርገሲስ ፋየ ወርቄ እት ናኔሲቲ <verse eid="EXO 28:11"/><verse number="12" style="v" sid="EXO 28:12"/>አከ እን እልማን እስራኤሊፍ ዸጋ ያደኖ ተኡፍ ፉኞ ገቲቲ ድረተ ሰነት ቀብሲስ። አሮንስ መቃ ሰነ ያደኖ ጎዼ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ገቲቲሳ ለማንት ሃባቱ። <verse eid="EXO 28:12"/><verse number="13" style="v" sid="EXO 28:13"/>አትሞ ፋየ ወርቄ እት ናኔሲቲ <verse eid="EXO 28:13"/><verse number="14" style="v" sid="EXO 28:14"/>ፎንጫ ወርቄ ቁልቁሉ ከን አከ ፉኞት ፎአሜ ለመ ቶልች፤ ፎንጫ ፎአሜ ሰነሌ ፋየ ሰነት ቀብሲስ።<verse eid="EXO 28:14"/></para>
  <para style="s1">ኪሲ ቆማ</para>
  <para style="r">
    <ref loc="EXO 28:15-28">28፥15‑28</ref> ኩወፈ – <char style="xt"><ref loc="EXO 39:8-21">በኡ 39፥8‑21</ref></char></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 28:15"/>“ኦጌሰ ሀርከ ቶሉ ቶኮ ኪሲ ቆማ ከን ሙርቲ ሆጄቺስ፤ እሰስ አኩመ ድረተ ሰናት ወርቄዻን፣ ክሪ ብፈ ጩቁሊሳ፣ ዺልጌ፣ ብልዲማፊ ቁንጬ ተልባ ከን ቀልእፈሜ ፎአሜን ሆጄዹ። <verse eid="EXO 28:15"/><verse number="16" style="v" sid="EXO 28:16"/>ኪሲን ቆማ ኩን ገመ አፍረኒኑ ወል ቅጤፊ ደቻ ተኤ ዼርነ ታኩ ቶኮፊ በልእነ ታኩ ቶኮ ሃቀባቱ። <verse eid="EXO 28:16"/><verse number="17" style="v" sid="EXO 28:17"/>ዸጋወን ገት ጀቤዪስ ቶረ አፉሪንረት መጠንስ። ቶረ ጀልቀባረት ሰርድዮን፣ ቶጳዝዮኒፊ ቢረሌ፤ <verse eid="EXO 28:17"/><verse number="18" style="v" sid="EXO 28:18"/>ቶረ ለመፋረት በሉር፣ ሰንፔሪፊ አልማዝ፤ <verse eid="EXO 28:18"/><verse number="19" style="v" sid="EXO 28:19"/>ቶረ ሰደፋረት ያክንት፣ ኬልቄዶኒፊ ያክንት፣ <verse eid="EXO 28:19"/><verse number="20" style="v" sid="EXO 28:20"/>ቶረ አፉረፋረት ቢረሌ፣ ሰርዶንክሲፊ ያስጲድ መጠንስ። ዸጋወን ከኔንትስ መርሳ ፋየ ወርቄ ቶልች። <verse eid="EXO 28:20"/><verse number="21" style="v" sid="EXO 28:21"/>ዸጋወን ኩዸ ለመ ከኔን ቶኮ ቶኮሳኒረት መቃ ጎሶተ ኩዸ ለመ ኬሳ መቃን ቶኮ አኩመ ቻፓት ሶፈሜ ሃጅራተን፤ ቶኮን ቶኮን ዸጋወን ሰናስ መቃ እልማን እስራኤል ቶኮ ቶኮፍ ዻበተ።<verse eid="EXO 28:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 28:22"/>“ኪሲ ቆማቲፍስ ፎንጫ ወርቄ ቁልቁሉ አከ ፉኞት ፎአሜ ቶልች። <verse eid="EXO 28:22"/><verse number="23" style="v" sid="EXO 28:23"/>ኪሲ ቆማ ሰናፍስ ቁቤላ ወርቄ ለመ ቶልቺቲ ቁቤላ ወርቄ ለማን ሮገ ኪሲ ቆማ ለማንት ቀብሲስ። <verse eid="EXO 28:23"/><verse number="24" style="v" sid="EXO 28:24"/>ፎንጫ ወርቄ ሰነ ለማንስ ቁቤላወን ሮገወን ኪሲ ቆማ ሰነት ጉዱንፍ። <verse eid="EXO 28:24"/><verse number="25" style="v" sid="EXO 28:25"/>መታ ለማን ፎንጫ ለማን ሰና ካንሞ መርሳወን ፋያ ለማንት ጉዱንፊቲ ከራ ፉለ ዱራቲን ፎንጫ ድረታ ከን ገቲቲት ቀብሲስ። <verse eid="EXO 28:25"/><verse number="26" style="v" sid="EXO 28:26"/>ቁቤላወን ወርቄ ለመ ቶልቺቲ ሮገወን ኪሲ ቆማ ብራ ከኔን ከራ ሞጋ ኬሳቲን ድረተት ኣነኒ ጅረን ለማንት ካእ። <verse eid="EXO 28:26"/><verse number="27" style="v" sid="EXO 28:27"/>አመስ ቁቤላወን ወርቄ ለመ ብራ ቶልቺቲ ሰበተ ድረታቲን ኦልት ሆዻት ዽኤሲ ፉኞ ገቲቲ ለማን ፉለ ድረተ ዱራን ጅሩ ሰነ ጀላን እት ህዽ። <verse eid="EXO 28:27"/><verse number="28" style="v" sid="EXO 28:28"/>አከ ኪሲን ቆማ ድረተራ ህንሶሶቾኔፍ ቁቤላወን ኪሲ ቆማ ሱን ሰበተ ሙዺቲን ወልት ቀብሲፈመኒ ፉኞ ብፈ ጩቁሊሳቲን ቁቤላወን ድረተት ሃቀብሲፈመን።<verse eid="EXO 28:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 28:29"/>“አሮን ዬሮ እዶ ቁልቁሉ ኦል ሴኑ ሁንደ አከ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ያደኖ በረ በራ ተኡፍ ለጴሳረት ኪሲ ቆማ ከን ሙርቲቲን መቃ እልማን እስራኤል ንባተ። <verse eid="EXO 28:29"/><verse number="30" style="v" sid="EXO 28:30"/>አከ እሳን ዬሮ አሮን ፉለ <char style="nd">ዋቀዮ</char> ዱረ ዹፉ ሁንደ ለጴሳረ ጅራተኒፍ ኡሪሚፊ ቱሚሚ አከሱመ ኪሲ ቆማ ኬሰ ካእ። አከሲንስ አሮን ዬሮ ሁንደ ምአ እቲን እስራኤሎታፍ ሙርቲ ኬኑ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ለጴሳረት ባተ።<verse eid="EXO 28:30"/></para>
  <para style="s1">ኡፈተ ሉቡማ ካን</para>
  <para style="r">
    <ref loc="EXO 28:31-43">28፥31‑43</ref> ኩወፈ – <char style="xt"><ref loc="EXO 39:22-31">በኡ 39፥22‑31</ref></char></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 28:31"/>“ሁጩ ብፍትሳ ጉቱማን ጉቱት ጩቁሊሰ ተኤራ ወንደቦ ድረታ ቶልች፤ <verse eid="EXO 28:31"/><verse number="32" style="v" sid="EXO 28:32"/>ወለካ ጉባ እሳትስ አፋን እቲን መታ ሴንስፈተን ቶልች። አከ እን ህንተርሳኔፍስ ቀርቀረ አፋንሳረ ወን ፋዬፈሜ ቆጴፈሜ ሃጅራቱ። <verse eid="EXO 28:32"/><verse number="33" style="v" sid="EXO 28:33"/>ናኖ ጥዮ ወንደቦ ሰናትሞ ክሪ ብፈ ጩቁሊሳ፣ ዺልጌፊ ብልዲማዻን ሮማኒ ሆጄዹቲ ግዱሳትሞ ብልብለ ወርቄ ቶልች። <verse eid="EXO 28:33"/><verse number="34" style="v" sid="EXO 28:34"/>ብልብል ወርቄቲፊ ሮማኒን ሱን ወል ጀለ ደደርበኒ ናኖ ጥዮ ወንደቦ ሰናት ሃሆጄተመን። <verse eid="EXO 28:34"/><verse number="35" style="v" sid="EXO 28:35"/>አሮን ዬሮ ተጃጅሉ ወንደቦ ከነ ሃኡፈቱ፤ አከ እን ህንዱኔፍ ዮሙ እን ፉለ <char style="nd">ዋቀዮ</char> ዱረ እዶ ቁልቁሉ ሴኑፊ ዮሙ እን አቺ ገድ በኡት ሰገሌን ብልብለ ሰና ንዸገአመ።<verse eid="EXO 28:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="EXO 28:36"/>“ወርቄ ቁልቁሉራ ፋየ ቶልቺ፣</para>
  <para style="pc" vid="EXO 28:36">ከን <char style="nd">ዋቀዮፍ</char> ቁልቁሌፈሜ፣</para>
  <para style="m" vid="EXO 28:36">ጄዺቲ አኩመ ዋን ቻፓረት ሶፈሙት ሶፊ በሬስ። <verse eid="EXO 28:36"/><verse number="37" style="v" sid="EXO 28:37"/>ፋየ ሰነ መረተ መታቲን ወል ቀብሲሱፍ ፉኞ ብፈ ጩቁሊሳ እት ህዽ፤ እንስ መረተ መታ ፉለ ዱራን ሃተኡ። <verse eid="EXO 28:37"/><verse number="38" style="v" sid="EXO 28:38"/>ፋይ ኩንስ አደ አሮንረ ታአ፤ አሮንስ የከ ኬናወን ቁልቁሉ እልማን እስራኤል ዽኤሰን ኬሰት አርገሙ ሁንደ ንባተ። ኩንስ አከ እሳን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ፉዸተመ አርገተኒፍ አደ አሮንረ ጅራተ።<verse eid="EXO 28:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="EXO 28:39"/>“ቁንጬ ተልባ ከን ቀልእፈሜ ፎአሜ ዾፍስሲቲ ቆሜ ሆጄዹ፤ መረተ መታሌ ቁንጬ ተልባ ጋሪራ ቶልች። ሰበንስ ኦጌሰ ሀርከ ቀጄሉን ሃቶልፈሙ። <verse eid="EXO 28:39"/><verse number="40" style="v" sid="EXO 28:40"/>አከ እልማን አሮንስ ኡልፍናፊ ሚዸግነ አርገተኒፍ ቆሜ፣ ሰበታፊ መረተ መታ ቶልቺፍ። <verse eid="EXO 28:40"/><verse number="41" style="v" sid="EXO 28:41"/>ኤርገ ኡፈተ ከነ ኦቦሌሰኬ አሮንቲፊ እልማንሳት ኡፍፍቴ ቦዴ ድቢ እሳን ሙድ። አከ እሳን ሉቦተ ተአኒ ነ ተጃጅለኒፍስ እሳን ቁልቁሌስ።<verse eid="EXO 28:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="EXO 28:42"/>“ቁምጣ ወያ ጀላ ከን ሙዺዻ ጀልቀቤ ሀመ ጉዴዳት ቁላ ነማ ዾክሱ ቁንጬ ተልባራ ሆጄዹፍ። <verse eid="EXO 28:42"/><verse number="43" style="v" sid="EXO 28:43"/>አሮኒፊ እልማንሳ አከ በሌሳ ሆጄተኒ ህንዱኔፍ ዬሮ ዱንካነ ወል ገኢ ሴነን ዮካን እዶ ቁልቁሉ ሰነት ተጃጅለ ኬኑፍ እዶ ኣርሳት ዽኣተን ኡፈተ ከነ ኡፈቹ ቀቡ።</para>
  <para style="p" vid="EXO 28:43">“ኩንስ አሮኒፊ ሰኚ እሳቲፍ ስርነ በረ በራ ሃተኡ።<verse eid="EXO 28:43"/></para>
  <chapter eid="EXO 28"/>
  <chapter number="29" style="c" sid="EXO 29"/>
  <para style="s1">ቁልቁሌፈሙ ሉቦታ</para>
  <para style="r">
    <ref loc="EXO 29:1-37">29፥1‑37</ref> ኩወፈ – <char style="xt"><ref loc="LEV 8:1-36">ሌዎ 8፥1‑36</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 29:1"/>“አከ እሳን ሉቦተ ተአኒ ነ ተጃጅለኒፍ ወን አት እሳን ቁልቁሌሱፍ ጎቱ ከናዸ፤ ድብቸ ቶኮፊ ኮርቤዪ ሆላ ከኔን ሙዳ ህንቀብኔ ለመ ፉዽ። <verse eid="EXO 29:1"/><verse number="2" style="v" sid="EXO 29:2"/>ዳኩ ቀመዲ ፍለተማራ መጥኖ፣ መጥኖ ዘይቲዻን ሱኩመሜፊ ብጥሌ ዘይቲን እረ ድበሜ ቶልች። <verse eid="EXO 29:2"/><verse number="3" style="v" sid="EXO 29:3"/>እሳን ከነስ ጉንዶ ኬሰ ካኢቲ ድብቻፊ ኮርቤዪ ሆላ ወጅን ዽኤስ። <verse eid="EXO 29:3"/><verse number="4" style="v" sid="EXO 29:4"/>ኤርገሲሞ አሮኒፊ እልማንሳ ገረ በልበለ ዱንካነ ወል ገኢት ፍዲቲ ብሻኒን እሳን ዽቅ። <verse eid="EXO 29:4"/><verse number="5" style="v" sid="EXO 29:5"/>ኡፈተስ ፉዺቲ ቆሜ፣ ወንደቦ ድረታ፣ ድረታፊ ኪሲ ቆማ አሮንት ኡፍስ። ድረተ ሰነስ ሰበተ ኦጉማዻን ዸአሜን ህዽ። <verse eid="EXO 29:5"/><verse number="6" style="v" sid="EXO 29:6"/>መታሳት መረተ መር፤ መረተ ሰነትሞ ጎንፎ ቁልቁሉ ቀብሲስ። <verse eid="EXO 29:6"/><verse number="7" style="v" sid="EXO 29:7"/>ዘይቲ እቲን ድብዱ ፉዺቲ መታሳረት ዸንገላሱዻን እሰ ድብ። <verse eid="EXO 29:7"/><verse number="8" style="v" sid="EXO 29:8"/>እልማንሳ ፍዲ ቆሜ እሳንት ኡፍስ፤ <verse eid="EXO 29:8"/><verse number="9" style="v" sid="EXO 29:9"/>መታሳኒት መረተ መር። ኤርገሲሞ አሮኒፊ እልማንሳት ሰበተ ህዽ። ሉቡማንስ ሴረ በረ በራቲን ከንሳኒት።</para>
  <para style="p" vid="EXO 29:9">“አትስ አከሲን አሮኒፊ እልማንሳ ሙድ።<verse eid="EXO 29:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 29:10"/>“ድብቸ ሰነ ገረ ፉለ ዱንካነ ወል ገኢት ፍድ፤ አሮኒፊ እልማንሳሞ ሀርከሳኒ መታሳረ ሃካአን። <verse eid="EXO 29:10"/><verse number="11" style="v" sid="EXO 29:11"/>አትስ ፉለ <char style="nd">ዋቀዮ</char> ዱረት፣ በልበለ ዱንካነ ወል ገኢረት እሰ ቀል። <verse eid="EXO 29:11"/><verse number="12" style="v" sid="EXO 29:12"/>ዺገ ድብቸ ሰናራ ጥኖ ፉዺቲ ቁበኬቲን ጋንፈ እዶ ኣርሳ ድብ፤ ከን ሀፌሞ ሚለ እዶ ኣርሳረት ዸንገላስ። <verse eid="EXO 29:12"/><verse number="13" style="v" sid="EXO 29:13"/>ሞረ ምአ ገራት ሀጉገሜ ሁንደ፣ ሀጉጊ ትሩቲፊ ሞረ ከሌ ለማንት ሀጉገሜ ፉዺቲ እዶ ኣርሳረት ጉብ። <verse eid="EXO 29:13"/><verse number="14" style="v" sid="EXO 29:14"/>ፎን ድብቸ ሰና፣ ጎጋሳቲፊ ጩማሳ ገሩ ቁበተ ኬሳ ገድ ባሲ ጉብ። እን ኣርሳ ጩቡት።<verse eid="EXO 29:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 29:15"/>“ኮርቤዪ ሆላ ሰነ ኬሳ ቶኮ ፍድ፤ አሮኒፊ እልማንሳስ ሀርከሳኒ መታሳረ ሃካአን። <verse eid="EXO 29:15"/><verse number="16" style="v" sid="EXO 29:16"/>ኮርቤሰ ሆላ ሰነ ቀሊ ዺገሳ ፉዺቲ ገመ ሁንዳን እዶ ኣርሳት ፈጫስ። <verse eid="EXO 29:16"/><verse number="17" style="v" sid="EXO 29:17"/>ኮርቤሰ ሆላ ሰነ ገርገር ኩኩቲ ምአ ገራቲፊ ሉከሳ ሚጪቲ መታፊ ኩታወን ካን ወጅን ካእ። <verse eid="EXO 29:17"/><verse number="18" style="v" sid="EXO 29:18"/>ኮርቤሰ ሆላ ሰነ ጉቱማን ጉቱት እዶ ኣርሳረት ጉብ። ኩንስ ቀልመ <char style="nd">ዋቀዮፍ</char> ጉበሙ፣ ኣርሳ ኡርጋኣ እብዳን <char style="nd">ዋቀዮፍ</char> ዽኤፈሙዸ።<verse eid="EXO 29:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 29:19"/>“ኮርቤሰ ሆላ ካንሌ ፍድ፤ አሮኒፊ እልማንሳ ሀርከሳኒ መታሳረ ሃካአን። <verse eid="EXO 29:19"/><verse number="20" style="v" sid="EXO 29:20"/>ኮርቤሰ ሆላ ሰነ ቀል፤ ዺገሳራስ ፉዺቲ ፊጤ ጉረ አሮን ምርጋቲፊ ፊጤ ጉረ እልማንሳ ምርጋ ድብ፤ ቁበ አቡዱ ሀርከ ምርጋሳኒቲፊ ቁበ አቡዱ ሚለ ምርጋሳኒሌ ድብ። ዺገ ሀፌሞ ገመ ሁንዳን እዶ ኣርሳት ፈጫስ። <verse eid="EXO 29:20"/><verse number="21" style="v" sid="EXO 29:21"/>ዺገ እዶ ኣርሳረ ጅሩራ፣ ዘይቲ እቲን ድበንራስ ፉዺቲ አሮኒፊ ኡፈተሳት፣ እልማንሳቲፊ ኡፈተሳኒት ፈጫስ። አከሲን እኒፊ እልማንሳ፣ ኡፈትንሳኒስ ንቁልቁላኡ።<verse eid="EXO 29:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 29:22"/>“ኮርቤሰ ሆላ ከነራስ ጮመ፣ ዱቦ፣ ሞረ ምአ ገራ ሀጉጉ፣ ሀጉጊ ትሩ፣ ከሌ ለማኒፊ ሞረ እሳንት ጅሩ፣ አከሱመስ ተፈ ምርጋ ፉዺ። ኮርቤስ ሆላ ኩንስ ሆላ እቲን ሉቡማ ኬነኒዸ። <verse eid="EXO 29:22"/><verse number="23" style="v" sid="EXO 29:23"/>ጉንዶ መጥኖ ባቱ ከን ፉለ <char style="nd">ዋቀዮ</char> ዱረ ጅሩ ሰነራ መጥኖ ቶኮ፣ መጥኖ ዘይቲዻን ቶልፈሜ ቶኮፊ ብጥሌ ቶኮ ፉዽ። <verse eid="EXO 29:23"/><verse number="24" style="v" sid="EXO 29:24"/>ወንቶተ ከኔን ሁንደ ሀርከ አሮኒፊ ሀርከ እልማንሳ ኬሰ ካኢቲ ኣርሳ ሶቾፈሙ ጎዺ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ሶቾስ። <verse eid="EXO 29:24"/><verse number="25" style="v" sid="EXO 29:25"/>ኤርገሲሞ ሀርከሳኒቲ ፉዺ አከ ኡርጋ <char style="nd">ዋቀዮት</char> ቶሉ ተኡፍ ኣርሳ ጉበሙ ወጅን እዶ ኣርሳረት ጉብ፤ ኩንስ ኣርሳ እብዳን <char style="nd">ዋቀዮፍ</char> ዽኤፈሙዸ። <verse eid="EXO 29:25"/><verse number="26" style="v" sid="EXO 29:26"/>ኤርገ ሀንደራፈ ሆላ አሮን እቲን ሉበ ተኤ ሰነ ፉቴ ቦዴ ኣርሳ ሶቾፈሙ ጎዺቲ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ሶቾስ፤ ኩንስ ቆደኬት።<verse eid="EXO 29:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 29:27"/>“ሀንደራፈ ኣርሳ ሶቾፈሙ፣ ሉከ ኮርቤሰ ሆላ እሰ ከን አሮኒፊ እልማንሳ እሰ ዬሮ እሳን ሉበ ተአን ኣርሳ ተኤ ዽኣቴ ሰነ ቁልቁሌስ። <verse eid="EXO 29:27"/><verse number="28" style="v" sid="EXO 29:28"/>ኩንስ ቆደ በረ በራ ከን ሰብን እስራኤል ዬሮ ሁንደ አሮኒፊ እልማንሳቲፍ ኬኑዸ። እንስ ጉማቸ ሰብን እስራኤል ኣርሳ ነጋራ <char style="nd">ዋቀዮፍ</char> ኬኑዸ።<verse eid="EXO 29:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 29:29"/>“አከ እሳን እቲን ድበመኒ ሉበ ተአኒፍ ኡፈትን አሮን ቁልቁሉን ከን እልማንሳ ሃተኡ። <verse eid="EXO 29:29"/><verse number="30" style="v" sid="EXO 29:30"/>እልም እዶሳ ቡኤ ሉበ ተኡዻን እዶ ቁልቁሉ ኬሰ ተጃጅሉፍ ገረ ዱንካነ ወል ገኢ ዹፉ ቡልቲ ቶርበ ኡፈተ ከነ ሃኡፈቱ።<verse eid="EXO 29:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 29:31"/>“ኮርቤሰ ሆላ እሰ እቲን ሉበ ተአን ሰነ ፉዺቲ ፎንሳ እዶ ቁልቁሉት አፌል። <verse eid="EXO 29:31"/><verse number="32" style="v" sid="EXO 29:32"/>አሮኒፊ እልማንሳ ፎን ሆላ ሰናቲፊ ቡዴነ ጉንዶራ ሰነ በልበለ ዱንካነ ወል ገኢ ዱረት ሃኛተን። <verse eid="EXO 29:32"/><verse number="33" style="v" sid="EXO 29:33"/>እሳንስ ኣርሳ እሳን እቲን ሉበ ተአኒፊ ቁልቁሌፈሙሳኒቲፍ እቲን አራር ቡኤ ሃኛተን። ሰበቢ ኣርሳን ሱን ቁልቁሉ ተኤፍ ገሩ ነምን ካን ህንኛትን። <verse eid="EXO 29:33"/><verse number="34" style="v" sid="EXO 29:34"/>ዮ ፎን ኮርቤሰ ሆላ እቲን ሉበ ተአን ከምዩ ዮካን ቡዴን ከምዩ ሀፌ ቡሌ እብዳን ጉብ፤ ሰበቢ ቁልቁሉ ተኤፍ ኛተሙ ህንቀቡ።<verse eid="EXO 29:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 29:35"/>“ዋን አን ስአጀጄ ሁንደ አሮኒፊ እልማንሳቲፍ ጎዽ። ቡልቲ ቶርበ ጉቱ ሴረ ሉቡማ እሳኒፍ ራወዹ። <verse eid="EXO 29:35"/><verse number="36" style="v" sid="EXO 29:36"/>አከ አራር ቡኡፍስ ጉዩመ ጉያን ድብቸ ቀሊ ኣርሳ ጩቡ ዽኤስ። እዶ ኣርሳ ሰናፍ ኣርሳ አራራ ዽኤሱዻን ቁልቁሌስ፤ አዳን ባሱዻፍስ እሰ ድብ። <verse eid="EXO 29:36"/><verse number="37" style="v" sid="EXO 29:37"/>እዶ ኣርሳ ሰናፍስ ቡልቲ ቶርበ አራረ ቡሲቲ እሰ ቁልቁሌስ። ዮስ እዶን ኣርሳ ሱን ዋን ሁንደ ጫላ ቁልቁሉ ተአ፤ ወን እሰ ቱቁ ሁንድኑስ ንቁልቁሌፈመ።<verse eid="EXO 29:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="EXO 29:38"/>“ወን አት ዬሮ ሁንደ እዶ ኣርሳረት ጉያ ጉያን ዽኤስቱ ከናዸ፦ ጦባላወን ከኔን ኡሙሪንሳኒ ወጋ ቶኮ ቶኮ ተኤ ለመ፤ <verse eid="EXO 29:38"/><verse number="39" style="v" sid="EXO 29:39"/>ቶኮ ገነመ፣ ካንሞ ገልገለ ዽኤስ። <verse eid="EXO 29:39"/><verse number="40" style="v" sid="EXO 29:40"/>ጦባላ ጀልቀባ ሰነ ወጅንስ ዳኩ በኤሰሳ ኢፊ ቶኮራ ሀርከ ኩዸን ኬሳ ሀርክ ቶኮ ዘይቲ ኤጄርሳ ከን ጩንፈሜ ኢኒ ቶኮ ሀርከ አፉር ኬሳ ሀርከ ቶኮን ሱኩመሜ ዽኤስ፤ አከሱመስ ዳዺ ወይኒ ኢኒ ሀርከ አፉር ኬሳ ሀርከ ቶኮ ዽባዩ ጎዺ ዽኤስ። <verse eid="EXO 29:40"/><verse number="41" style="v" sid="EXO 29:41"/>ጦባላ ሆላ ካንሞ ኬና ምዻኒቲፊ ከን ዽባዩ ወጅን አኩመ እሰ ገነማ ሰናት ገልገለ ዽኤስ፤ ኩንስ ኣርሳ ኡርጋኣ እብዳን <char style="nd">ዋቀዮፍ</char> ዽኤፈሙዸ።<verse eid="EXO 29:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="EXO 29:42"/>“ቀልም ጉበሙ ኩን ዸሎተ ዹፉ ኬሰትስ ዬሮ ሁንደ በልበለ ዱንካነ ወል ገኢረት ፉለ <char style="nd">ዋቀዮ</char> ዱረት ሃዽኤፈሙ። አንስ ገረኬሰን ዹፌ አችት እስንት ነንዱበዸ፤ <verse eid="EXO 29:42"/><verse number="43" style="v" sid="EXO 29:43"/>ሰበ እስራኤል ወጅንስ አቹመት ወል አርግነ፤ እዶን ሱንስ ኡልፍነኮቲን ንቁልቁሌፈመ።<verse eid="EXO 29:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="EXO 29:44"/>“አን ዱንካነ ወል ገኢፊ እዶ ኣርሳ ሰነ ነንቁልቁሌሰ፤ አሮኒፊ እልማንሳስ አከ እሳን ሉቦተ ተአኒ ነ ተጃጅለኒፍ ነንቁልቁሌሰ። <verse eid="EXO 29:44"/><verse number="45" style="v" sid="EXO 29:45"/>አንስ ሰበ እስራኤል ኬሰ ነንጅራዸ፤ ዋቀሳኒስ ነንተአ። <verse eid="EXO 29:45"/><verse number="46" style="v" sid="EXO 29:46"/>እሳንስ አከ አን <char style="nd">ዋቀዮ</char> ዋቀሳኒ ከን ግዱሳኒ ጅራቹፍ ጄዼ ብየ ግብጢቲ ኬሳ እሳን ባሴ ተኤ ንቤኩ፤ አን <char style="nd">ዋቀዮ</char> ዋቀሳኒት።<verse eid="EXO 29:46"/></para>
  <chapter eid="EXO 29"/>
  <chapter number="30" style="c" sid="EXO 30"/>
  <para style="s1">እዶ ኣርሳ እጣና</para>
  <para style="r">
    <ref loc="EXO 30:1-5">30፥1‑5</ref> ኩወፈ – <char style="xt"><ref loc="EXO 37:25-28">በኡ 37፥25‑28</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 30:1"/>“እዶ ኣርሳ ከን እጣን እረት ኣርፈሙ ሙከ ላፍቶራ ቶልች። <verse eid="EXO 30:1"/><verse number="2" style="v" sid="EXO 30:2"/>እዶን ኣርሳ ኩንስ ደልገ ዼርነ ዹንዹመ ቶኮ፣ በልእነ ዹንዹመ ቶኮቲፊ ኦል ዼርነ ዹንዹመ ለማ ቀባቴ ገመ አፍረኒኑ ወል ቅጤ ሃተኡ፤ ጋንፈወንሳስ እዶ ኣርሳ ሰናን ወልት ዋኑመ ቶኮራ ሃቶልፈመን። <verse eid="EXO 30:2"/><verse number="3" style="v" sid="EXO 30:3"/>ጉባሳረ፣ ጭናቸሳ ሁንዱማፊ ጋንፈወንሳት ወርቄ ቁልቁሉ ኡፍሲቲ ናኖሳት መርሳ ወርቄ ናኔሲ ቶልች። <verse eid="EXO 30:3"/><verse number="4" style="v" sid="EXO 30:4"/>እዶ ኣርሳ ሰናፍስ መርሳወን ወርቄሳቲ ገድት ቁቤላወን ወርቄ ለመ ቶልች፤ ቁቤላወን ከነስ አከ እሳን ደንቀራወን እቲን እዶ ኣርሳ ባተን ቀበተኒፍ ገማ ገመናን ጭናቸ ለማንት ቶልች። <verse eid="EXO 30:4"/><verse number="5" style="v" sid="EXO 30:5"/>ደንቀራወን ሙከ ላፍቶ ቶልቺቲ ወርቄ እት ኡፍስ። <verse eid="EXO 30:5"/><verse number="6" style="v" sid="EXO 30:6"/>እዶ ኣርሳ ሰነስ ፉለ ጎልጋ ታቦተ ከኩ ሴራ ብረ ጅሩ ሰና ዱረ፣ ፉለ ቴሶ አራራ ከን ከኩ ሴራቲን ኦል ጅሩ ዱረ እዶ አን እት ስ አርጉ ሰነ ዻብ።<verse eid="EXO 30:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 30:7"/>“አሮን ዮሙ ገነመ ገነመ እብሳ ቆቆጴሱት እዶ ኣርሳረት እጣነ ኡርጋኣ ሃኣርሱ። <verse eid="EXO 30:7"/><verse number="8" style="v" sid="EXO 30:8"/>አከ እጣን ሱን ዸሎተ ዹፉ ኬሰትሌ ዬሮ ሁንደ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ኣሩፍ አሮን ዮሙ ገልገለ ገልገለ እብሳ ቀብሲሱት እጣነ ሃኣርሱ። <verse eid="EXO 30:8"/><verse number="9" style="v" sid="EXO 30:9"/>እዶ ኣርሳ ከነረት እጣነ ጎሰ ብራ ዮካን ቀልመ ጉበሙ ዮካን ኬና ምዻኒ ህንዽኤስን፤ ዽባዩስ እረት ህንዽባፈትን። <verse eid="EXO 30:9"/><verse number="10" style="v" sid="EXO 30:10"/>አሮንስ ወጋት ዬሮ ቶኮ ጋንፈወን እዶ ኣርሳረት ኣርሳ አራረ ቡሱ ሃዽኤሱ፤ ኣርሳን ወጋት ዽኤፈሙ ኩን ዺገ ኣርሳ ጩቡ ከን አራር እቲን አርገሙ ወጅን ዸሎተ ዹፉ ኬሰት ሃዽኤፈሙ። ኣርሳን ኩንስ <char style="nd">ዋቀዮፍ</char> ዋን ሁንዱማ ጫላ ቁልቁሉዸ።”<verse eid="EXO 30:10"/></para>
  <para style="s1">ማለቀ እቲን አራር ቡኡ</para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 30:11"/>ኤርገሲስ <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ <verse eid="EXO 30:11"/><verse number="12" style="v" sid="EXO 30:12"/>“ዮሙ አት ባይእነ ሰበ እስራኤል ለኮፍቱት ቶኮን ቶኮን ነማ ዬሮ ለካአሙት ፉሪ ሉቡሳ <char style="nd">ዋቀዮፍ</char> ሃኬኑ። ዮስ ዬሮ አት እሳን ለኮፍቱት ዸእች ቶኮዩ እሳን ህንአርገቱ። <verse eid="EXO 30:12"/><verse number="13" style="v" sid="EXO 30:13"/>ነምን ወረ ለካአመንት ደበለሙ ከምዩ አኩመ ሰቅሊ እዶ ቁልቁሉ ከን ጌራ ድግደማ ኡልፋቱ ሰናት ወለካ ሰቅሊ ሃኬኑ። ወለካን ሰቅሊ ኩንስ ኬና <char style="nd">ዋቀዮፍ</char> ዽኤፈሙዸ። <verse eid="EXO 30:13"/><verse number="14" style="v" sid="EXO 30:14"/>ወረ ለካአመን ኬሳ ከኔን ኡሙሪንሳኒ ወጋ ድግደመ ዮካንሳ ኦል ተኤ ሁንድኑ <char style="nd">ዋቀዮፍ</char> ኬና ሃዽኤሰን። <verse eid="EXO 30:14"/><verse number="15" style="v" sid="EXO 30:15"/>ዮሙ እስን ሉቡኬሰን ፉሩፍ ጄተኒ <char style="nd">ዋቀዮፍ</char> ኬና ዽኤስተንት ሶሬዪን ወለካ ሰቅሊቲ ኦል ህንኬንን፤ ህዬዪንስ ወለካ ሰቅሊቲ ገድ ህንኬንን። <verse eid="EXO 30:15"/><verse number="16" style="v" sid="EXO 30:16"/>ማለቀ ፉሪ ሰነስ እስራኤሎተ ሀርካ ፉዺቲ ተጃጅለ ዱንካነ ወል ገኢ ሰናረ ኦልች፤ ኩንስ ሉቡኬሰኒፍ ፉሪ ተኡፍ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ያደኖ ሰበ እስራኤል ተአ።”<verse eid="EXO 30:16"/></para>
  <para style="s1">ጫቢ እት ዽቀተን</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 30:17"/>ኤርገሲስ <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ <verse eid="EXO 30:17"/><verse number="18" style="v" sid="EXO 30:18"/>“ገበቴ ናሲ ከን ሚለ ናሲ ቀቡ ዽቀናዻፍ ቶልች። እሰስ ዱንካነ ወል ገኢቲፊ እዶ ኣርሳ ግዱ ካኢቲ ብሻን እት ነቅ። <verse eid="EXO 30:18"/><verse number="19" style="v" sid="EXO 30:19"/>አሮኒፊ እልማንሳ ብሻን ሰናን ሀርከሳኒቲፊ ሚለሳኒ ሃዽቀተን። <verse eid="EXO 30:19"/><verse number="20" style="v" sid="EXO 30:20"/>እሳንስ አከ ህንዱኔፍ ዬሮ ዱንካነ ወል ገኢ ሴነን ብሻኒን ዽቀቱ፤ አከሱመስ ዮሙ ኣርሳ እብዳን <char style="nd">ዋቀዮፍ</char> ዽኤፈሙ ጉቡዻፍ ተጃጅሉፍ እዶ ኣርሳት ዽኣተንት፣ <verse eid="EXO 30:20"/><verse number="21" style="v" sid="EXO 30:21"/>አከ ህንዱኔፍ ሀርከሳኒቲፊ ሚለሳኒ ሃዽቀተን። ኩንስ ዸሎተ ዹፉ ኬሰት አሮኒፊ ሰኚሳቲፍ ሴረ ዻበታ ተአ።”<verse eid="EXO 30:21"/></para>
  <para style="s1">ዘይቲ እቲን ድበመን</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 30:22"/>ኤርገሲስ <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ <verse eid="EXO 30:22"/><verse number="23" style="v" sid="EXO 30:23"/>“ኡርጎፍቱወን ኡርጎፍቱ ሁንደ ጫለን ጄቹንስ ቁምቢ ቁልቁሉ ሰቅሊ 500፣ ቀረፋ ኡርጋኣ ወለካሳ ጄቹንስ ሰቅሊ 250፣ መርገ ጭታ ኡርጋኣ ሰቅሊ 250፣ <verse eid="EXO 30:23"/><verse number="24" style="v" sid="EXO 30:24"/>ቡርጉዲ ሰቅሊ 500 ፉዸዹ፤ ሁንድሳዩ አኩመ ሰቅሊ እዶ ቁልቁሉት ሃተኡ፤ አከሱመስ ዘይቲ ኤጄርሳ ኢኒ ቶኮ ፉዸዹ። <verse eid="EXO 30:24"/><verse number="25" style="v" sid="EXO 30:25"/>ኡርጎፍቱወን ከኔኒንስ ዘይቲ እቲን ድበን ቁልቁሉሳ ጄቹንስ መካ ኡርጋኣ አኩመ ኦጌሰ ኡርጎፍቱ ቆጴሱ ቶኮት ቶልች። ኩንስ ዘይቲ እቲን ድበን ቁልቁሉሳ ተአ። <verse eid="EXO 30:25"/><verse number="26" style="v" sid="EXO 30:26"/>ዘይቲ ከናንስ ዱንካነ ወል ገኢ፣ ታቦተ ከኩ ሴራ፣ <verse eid="EXO 30:26"/><verse number="27" style="v" sid="EXO 30:27"/>ምንጃላፊ ምአሳ ሁንደ፣ ባቱ እብሳፊ ምአሳ፣ እዶ ኣርሳ እጣና፣ <verse eid="EXO 30:27"/><verse number="28" style="v" sid="EXO 30:28"/>እዶ ኣርሳ ቀልመ ጉበሙቲፊ ምአሳ ሁንደ፣ ገበቴ እት ዽቀተኒፊ ሚለሳ ድብ። <verse eid="EXO 30:28"/><verse number="29" style="v" sid="EXO 30:29"/>አከ እሳን ዋን ሁንደ ጫላ ቁልቁሉ ተአኒፍ እሳን ቁልቁሌስ፤ ወን እሳን ቱቁ ከምዩስ ንቁልቁላአ።<verse eid="EXO 30:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 30:30"/>“አከ እሳን ሉቦተ ተአኒ ነ ተጃጅለኒፍ አሮኒፊ እልማንሳ ድብ ቁልቁሌስ። <verse eid="EXO 30:30"/><verse number="31" style="v" sid="EXO 30:31"/>እስራኤሎታን አከነ ጄዽ፤ ‘ኩን ዘይቲን ቁልቁሉ እቲን ዸሎተ ዹፉፍ ጅሩ ድበን ናፍ ሃተኡ። <verse eid="EXO 30:31"/><verse number="32" style="v" sid="EXO 30:32"/>ዘይቲ ከነ ዸግነ ነመ ብራረት ህንዸንገላስን ዮካን ዘይቲ ከምዩ ከራ ከናን ህንቆጴስን። ዘይቲን ኩን ቁልቁሉዸ፤ እንስ እስኒፍ ቁልቁሉ ሃተኡ። <verse eid="EXO 30:32"/><verse number="33" style="v" sid="EXO 30:33"/>ነምን ሽቶ ሽቶ ሰነ ፈካቱ ሆጄቱ ከን ነመ ብራትስ ድቡ ሰበሳ ኬሳ ሃበሌፈሙ።’ ”<verse eid="EXO 30:33"/></para>
  <para style="s1">እጣነ</para>
  <para style="p">
    <verse number="34" style="v" sid="EXO 30:34"/>
    <char style="nd">ዋቀዮስ</char> ሙሴዻን አከነ ጄዼ፤ “ኡርጎፍቱ ጄቹንስ ሀምጴ ኡርጋኡ፣ ኤሌላን ኡርጋኡ፣ ኣነን ሙከ ኡርጋኡ፣ እጣነ መካ ህንቀብኔ ከን ሁንድሳዩ ባይእነ ወል ቅጤ ቀቡ ፉዸዹቲ፣ <verse eid="EXO 30:34"/><verse number="35" style="v" sid="EXO 30:35"/>አኩመ ነምን ኡርጎፍቱ ቆጴሱ ቶኮ ሆጄቱት እጣነ መከማ ኡርጋኡ ቶልች። እጣነ ከነትስ ሶግደ ነቂቲ ቁልቁሌስ፤ አከ ቁልቁሉ ተኡስ ጎዽ። <verse eid="EXO 30:35"/><verse number="36" style="v" sid="EXO 30:36"/>እሰ ኬሳስ ገርቶኮ ዳኪ ቡሌሲቲ ዱንካነ ወል ገኢ ኬሰ ፉለ ታቦተ ከኩ ሴራ ዱረ እዶ አን እት ስ አርጉ ሰነ ካእ። እንስ ከን ዋን ሁንደ ጫላ ቁልቁላኡ እስኒፍ ሃተኡ። <verse eid="EXO 30:36"/><verse number="37" style="v" sid="EXO 30:37"/>ሃለ ከናን እጣነ ኦፊኬሰኒፍ ህንቆጴፈትና፤ አከ እን <char style="nd">ዋቀዮፍ</char> ቁልቁሉ ተኤስ ሁበዹ። <verse eid="EXO 30:37"/><verse number="38" style="v" sid="EXO 30:38"/>ነምን ኡርጋሳት ገመዱፍ ጄዼ ዋን እሰ ፈካቱ ቶኮሌ ሆጄቱ ሰበ ኦፊ ኬሳ ሃበሌፈሙ።”<verse eid="EXO 30:38"/></para>
  <chapter eid="EXO 30"/>
  <chapter number="31" style="c" sid="EXO 31"/>
  <para style="s1">ቤዘልኤሊፊ ኦሆሊያብ</para>
  <para style="r">
    <ref loc="EXO 31:2-6">31፥2‑6</ref> ኩወፈ – <char style="xt"><ref loc="EXO 35:30-35">በኡ 35፥30‑35</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 31:1"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ <verse eid="EXO 31:1"/><verse number="2" style="v" sid="EXO 31:2"/>“እላ፣ አን ጎሰ ይሁዳ ኬሳ ቤዘልኤል እልመ ኡር፣ እልመ ሁር ፍለዼረ፤ <verse eid="EXO 31:2"/><verse number="3" style="v" sid="EXO 31:3"/>አን ሀፉረ ዋቃቲን፣ ኦጉማዻን፣ ደንዴቲፊ ቤኩምሰ ሆጂ ሀርካ ጎሰ ሁንዱማን እሰ ጉቴረ፤ <verse eid="EXO 31:3"/><verse number="4" style="v" sid="EXO 31:4"/>ኩንስ አከ እን ወርቄዻን፣ ሜቲፊ ናሲዻን ሆጂ ኦጉማ ሆጄቱፍ፤ <verse eid="EXO 31:4"/><verse number="5" style="v" sid="EXO 31:5"/>አከ እን ዸጋወን ሙሬ ቆጴሱፍ፣ አከ ሙከ ሶፉፊ አከ ሆጂ ኦጉማ ሀርካ ከን ጎሰ ሁንዳ ኬሰት ህርማቱፍ። <verse eid="EXO 31:5"/><verse number="6" style="v" sid="EXO 31:6"/>አከሱመስ አን ኩኖ አከ እን እሰ ገርጋሩፍ ኦሆሊያብ እልመ አሂሳማክ ከን ጎሰ ዳን ሰነ ሙዴረ።</para>
  <para style="b" vid="EXO 31:6"/>
  <para style="lh" vid="EXO 31:6">“አከ እሳን ዋን አን ስ አጀጄ ሁንደ ሆጄተኒፍ ኦጌዪ ሆጂ ሀርካ ሁንዳፍ ኦጉማ ኬኔረ።<verse eid="EXO 31:6"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="7" style="v" sid="EXO 31:7"/>“እሳንስ ዱንካነ ወል ገኢ፣</para>
  <para style="li1" vid="EXO 31:7">ታቦተ ከኩ ሴራቲፊ ቴሶ አራራ ከን ታቦተ ሰነረ ጅሩ፣</para>
  <para style="li1" vid="EXO 31:7">ምአ ዱንካነ ሰና ሁንደ ጄቹንስ<verse eid="EXO 31:7"/></para>
  <para style="li2">
    <verse number="8" style="v" sid="EXO 31:8"/>ምንጃላፊ ምአሳ፣</para>
  <para style="li2" vid="EXO 31:8">ባቱ እብሳ ከን ወርቄ ቁልቁሉራ ቶልፈሜፊ ምአሳ ሁንደ፣</para>
  <para style="li2" vid="EXO 31:8">እዶ ኣርሳ እጣና፣<verse eid="EXO 31:8"/></para>
  <para style="li2">
    <verse number="9" style="v" sid="EXO 31:9"/>እዶ ኣርሳ ቀልመ ጉበሙቲፊ ምአሳ ሁንደ፣</para>
  <para style="li2" vid="EXO 31:9">ገበቴ እት ዽቀተኒፊ ሚለሳ፣<verse eid="EXO 31:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="EXO 31:10"/>ወያወን ሚዸግፈመኒ ዸአመን፣</para>
  <para style="li2" vid="EXO 31:10">ወያወን አሮን ሉብቻፍ ቁልቁሌፈመኒፊ</para>
  <para style="li2" vid="EXO 31:10">ወያወን እልማንሳ ዬሮ ሉቡማዻን ተጃጅለን ኡፈተን፣<verse eid="EXO 31:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="EXO 31:11"/>እዶ ቁልቁሉ ሰናፍሞ ዘይቲ ድበታቲፊ እጣነ ኡርጋኡ ሃቆጴሰን።</para>
  <para style="b" vid="EXO 31:11"/>
  <para style="lf" vid="EXO 31:11">“እሳን አኩመ አን ስ አጀጄ ሰነት ሃሆጄተን።”<verse eid="EXO 31:11"/></para>
  <para style="s1">ሰንበተ</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 31:12"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ <verse eid="EXO 31:12"/><verse number="13" style="v" sid="EXO 31:13"/>“ሰበ እስራኤሊን አከነ ጄዽ፤ ‘እስን ሰንበቶተኮ ኤጋ። አን <char style="nd">ዋቀዮ</char> እሰ እስን ቁልቁሌሱ አከን ተኤ አከ ቤክተኒፍ ኩን ዸሎተ ዹፉ ኬሰት አናፊ እስን ግዱት መለቶ ተአ።<verse eid="EXO 31:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 31:14"/>“ ‘ዋን ሰንበትን እስኒፍ ቁልቁሉ ተኤፍ እሰ ኤጋ። ነምን ሰንበተ ጡሬሱ ሃአጄፈሙ፤ ነምን ጉያ ሰነ ሆጂ ሆጄቱ ከምዩ ሰበሳ ኬሳ ሃበሌፈሙ። <verse eid="EXO 31:14"/><verse number="15" style="v" sid="EXO 31:15"/>ጉያ ጀአ ሆጂን ሃሆጄተሙ፤ ጉያን ቶርበፋን ገሩ ሰንበተ ቦቆናት፤ ጉያን ኩን <char style="nd">ዋቀዮፍ</char> ቁልቁሉዸ። ነምን ጉያ ሰንበታ ሆጂ ሆጄቱ ከምዩ ሃአጄፈሙ። <verse eid="EXO 31:15"/><verse number="16" style="v" sid="EXO 31:16"/>እስራኤሎን ሰንበተ ከነ ከኩ በረ በራ ጎዸተኒ ዸሎተ ዹፉ ኬሰ ሃኤገን። <verse eid="EXO 31:16"/><verse number="17" style="v" sid="EXO 31:17"/>ኩንስ አናፊ እስራኤሎተ ግዱት መለቶ በረ በራ ተአ፤ <char style="nd">ዋቀዮ</char> ጉያ ጀአ ኬሰት ሰሚፊ ለፈ ኡሜ ጉያ ቶርበፋት ቦቆቴ ኣረ ገልፈቴራቲ።’ ”<verse eid="EXO 31:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 31:18"/>
    <char style="nd">ዋቀዮ</char> አኩመ ጋረ ሲናረት ሙሴት ዱበቴ ራወቴን ገበቴ ዹጋ ለማን ጄቹንስ ገበቴወን ዹገ በኡምሳ ከኔን ቁብን ዋቃረት በሬሴ ሰነ እሰት ኬኔ።<verse eid="EXO 31:18"/></para>
  <chapter eid="EXO 31"/>
  <chapter number="32" style="c" sid="EXO 32"/>
  <para style="s1">ጀቢ ወርቄራ ሆጄተሜ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 32:1"/>ሰብን ሱንስ ዮሙ አከ ሙሴን ቱሉረ ቱሬ አርጌት አሮንን መርሴ፣ “ሙሴ ነምቸ ብየ ግብጢቲ ባሴ ኑ ፍዴ ሰነ ዋን እን ተኤ ህንቤክኑቲ ከኢ ዋቆተ ኑ ዱረ ዴመን ኑ ቶልች” ጄዼ።<verse eid="EXO 32:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 32:2"/>አሮንሞ፣ “ወርቄ ጉራ ከን ኒቶትንኬሰን፣ እልማንኬሰኒፊ እንተለንኬሰን ኬየተንራ ባሳቲ ነት ፍዳ” ጄዼ ዴብሴፍ። <verse eid="EXO 32:2"/><verse number="3" style="v" sid="EXO 32:3"/>ነሞትን ሁንድኑ ወርቄ ጉረሳኒ ኦፍራ ባሰኒ አሮንት ፍደን። <verse eid="EXO 32:3"/><verse number="4" style="v" sid="EXO 32:4"/>እንስ ወርቄ ሰነ እሳን ሀርካ ፉዼ ምአ እቲን ሆጄተኒን በቅሴ ዋቀ ቶልፈማ ብፈ ጀቢቲን ሆጄተሜ ቶኮ ቶልቼ፤ እሳንስ፣ “ያ እስራኤል እሳን ኩኔን ዋቆተኬ ወረ ብየ ግብጢቲ ስ ባሰኒዸ” ጄዸን።<verse eid="EXO 32:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 32:5"/>አሮንስ ዮሙ ዋን ከነ አርጌት ፉለ ጀቢ ሰና ዱረት እዶ ኣርሳ እጃሬ፣ “ቦር <char style="nd">ዋቀዮፍ</char> አያን ንአያኔፈመ” ጄዼ ለብሴ። <verse eid="EXO 32:5"/><verse number="6" style="v" sid="EXO 32:6"/>እሳንስ ጉያ እት ኣኑ ገነመ በሪን ከአኒ፣ ኣርሳ ጉበሙ ዽኤሰኒ ኣርሳ ነጋስ ፍደን። ከነረት ኛቹፊ ዹጉፍ ተታአን፤ ስርቡፍስ ከአን።<verse eid="EXO 32:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 32:7"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ “ሰብንኬ ከን አት ብየ ግብጢቲ ባፍቴ ፍዴ ሱን ጡራኤራቲ ገድ ቡእ። <verse eid="EXO 32:7"/><verse number="8" style="v" sid="EXO 32:8"/>እሳን ደፈኒ ከራ አን እሳን አጀጄራ ጀልአተኒሩ፤ ዋቀ ቶልፈማ ብፈ ጀቢቲን በቅፈሜ ቆጴፈሜሌ ኦፊሳኒቲፍ ቶልፈተኒ ኣርሳ ዽኤሰኒፊ፣ ‘ያ እስራኤል እሳን ኩኔን ዋቆተኬ ወረ ብየ ግብጢቲ ስ ባሰኒዸ’ ጄዸኒ እሰ ዋቄፈተኒሩ።<verse eid="EXO 32:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 32:9"/>“<char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ ‘ኩኖ፣ አን አከ ሰብን ኩን መተ ጀቤሰ ተኤ አርጌረ። <verse eid="EXO 32:9"/><verse number="10" style="v" sid="EXO 32:10"/>ከናፉ አከ ኣሪንኮ እሳንት ቦበኡፊ አከ አን እሳን በሌሱፍ ነ ዺስ። ዮሙስ አን ሰበ ጉዳ ስ ታስሰ።’ ”<verse eid="EXO 32:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 32:11"/>ሙሴን ገሩ ፉለ ገርጋርሰ <char style="nd">ዋቀዮ</char> ዋቀሳ በርባደቴ፤ አከነስ ጄዼ፤ “ያ <char style="nd">ዋቀዮ</char>፣ ዼከምስኬ ማሊፍ ሰበኬ ወረ አት ሁምነ ጉዳፊ እሬ ጀባዻን ብየ ግብጢቲ ባፍቴ ሰነት ቦበአ? <verse eid="EXO 32:11"/><verse number="12" style="v" sid="EXO 32:12"/>ወር ግብጢ ማሊፍ፣ ‘እን ዱሩመዩ ያደ ሀማዻን ቱሉወንረት እሳን ፍጡፊ ለፈራ እሳን በሌሱፍ ግብጢ እሳን ባሴ?’ ጄዹ። ኣሪኬ ቦበኣ ሰነራ ዴብእ፤ ኦብስስ፤ ሰበ ኬትስ በዲሰ ህንፍድን። <verse eid="EXO 32:12"/><verse number="13" style="v" sid="EXO 32:13"/>ገርቦተኬ አብረሃም፣ ይስሃቂፊ እስራኤልን ወረ፣ ‘አን ሰኚኬ አከ ኡርጂወን ሰሚራ ነንባይእሰ፤ ለፈ አን ዋዳ እሳኒፍ ሴኔ ከነ ሁንደስ ሰኚኬሰኒፍ ነንኬነ፤ እሳንስ በረ በራን ለፈ ሰነ ንዻሉ’ ጄቴ መቃኬቲን ከከቴፍ ሰነ ያደዹ።” <verse eid="EXO 32:13"/><verse number="14" style="v" sid="EXO 32:14"/>ከነረት <char style="nd">ዋቀዮ</char> ያደ ጌደረቴ በዲሰ ሰበሳት ፍዱፍ ቱሬ ሰነ ዺሴ።<verse eid="EXO 32:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 32:15"/>ሙሴንስ ገበቴወን ከኩ ለማን ሰነ ሀርከት ቀበቴ ዴብኤ ቱሉራ ገድ ቡኤ። ገበቴ ሰነረትስ ከራ ለቹ፣ ዱራ ዱባን በሬፈሜ ቱሬ። <verse eid="EXO 32:15"/><verse number="16" style="v" sid="EXO 32:16"/>ገበቴወን ሰነስ ዋቀቱ ሆጄቴ፤ ከተቢን ሱንስ ከተቢ ዋቃ ከን ገበቴወን ሰነረት ሶፈሜ በሬፈሜዸ።<verse eid="EXO 32:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 32:17"/>እያሱንስ ዮሙ ወጨ ነሞታ ዸገኤት ሙሴዻን፣ “እዶ ቡፈታ ኬሰ ሰገሌ ወራናቱ ጅረ” ጄዼ።<verse eid="EXO 32:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 32:18"/>ሙሴንሞ አከነ ጄዼ ዴብሴ፦</para>
  <para style="q1" vid="EXO 32:18">“ሰገሌን አን ዸገኡ ኩን</para>
  <para style="q2" vid="EXO 32:18">ሰገሌ ስርባት መሌ ሰገሌ ሞኡ፣</para>
  <para style="q2" vid="EXO 32:18">ዮካን ሰገሌ ሞአተሙ ምት።”<verse eid="EXO 32:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 32:19"/>ሙሴንስ አኩመ እዶ ቁበታት ዽኣቴ ጀቢፊ ሹብሰ ሰነ አርጌን ኣሬ ጉበቴ፤ ገበቴወን ሰነ ሀርከሳራ ደርበቴ ቱሉ ሰነ ጀለት ጨጨብሴ። <verse eid="EXO 32:19"/><verse number="20" style="v" sid="EXO 32:20"/>እንስ ጀቢ ጀር ቶልቸን ሰነ ፉዼ እብዳን ጉቤ፤ ዳኬ ቡሌሴስ ብሻንት ፍርፍርሴ እስራኤሎተ ኦባሴ።<verse eid="EXO 32:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 32:21"/>ሙሴንስ አሮኒን፣ “ሰብን ኩን ማል ስ ጎናን አት ጩቡ ጉዳ አከሲ ኬሰ እሳን ቡፍቴ?” ጄዼ።<verse eid="EXO 32:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 32:22"/>አሮንሞ ዴብሴ አከነ ጄዼ፤ “ያ ጎፍታኮ፣ ኣርቴ ህንጉበትን፤ አከ ሰብን ኩን ገረ ሀምናት ጀልአቱ አቱ ቤክተ። <verse eid="EXO 32:22"/><verse number="23" style="v" sid="EXO 32:23"/>እሳን፣ ‘ሙሴ ነምቸ ግብጢ ባሴ ኑ ፍዴ ሰነ ዋን እን ተኤ ህንቤክኑቲ ዋቆተ ኑ ዱረ ዴመን ኑ ቶልች’ ናን ጄዸን። <verse eid="EXO 32:23"/><verse number="24" style="v" sid="EXO 32:24"/>አንስ፣ ‘ነምን ወርቄ ቀቡ ኦፍራ ሃባሱ’ ጄዼን፤ እሳንስ ወርቄ ሰነ ነት ኬነን፤ አንስ እብደ ኬሰ ነንቡሴ፤ እንሞ ጀቢ ተኤ በኤ!”<verse eid="EXO 32:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 32:25"/>ሙሴን አከ ሰብን ሱን ገድ ዺሲት ጅራቴ፣ አሮንስ አከ እሳን ቶአናዻን አለ ተአን አከ ጎዼፊ አከ እሳን ዲኖተሳኒ ብረትስ ዋን ኮልፋ ተአን አርጌ። <verse eid="EXO 32:25"/><verse number="26" style="v" sid="EXO 32:26"/>ከናፉ ሙሴን ከረ ቁበታ ዱረ ዻበቴ፣ “ሜ ወር ገረ <char style="nd">ዋቀዮ</char> ጎርተን ሁንድ ገረኮ ኮታ” ጄዼ። ሌዎትን ሁንድስ እሰ ብረት ወልት ቀበመን።<verse eid="EXO 32:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 32:27"/>ኤርገሲ እን አከነ እሳኒን ጄዼ፤ “<char style="nd">ዋቀዮ</char> ዋቅን እስራኤል አከነ ጄዸ፤ ‘ቶኮን ቶኮን ነማ ሙዺሳት ጎራዴ ሃህዸቱ፤ ቶኮን ቶኮን ነማስ ቁበተ ሰነ ኬሰ ከረ ቶኮራ ገረ ከረ ካኒት አሲፊ አች ዴሜ ኦቦሎተሳ፣ ምቾተሳቲፊ ኦላሳ ሃአጄሱ።’ ” <verse eid="EXO 32:27"/><verse number="28" style="v" sid="EXO 32:28"/>ሌዎትንስ አኩመ ሙሴን እሳን አጀጄ ጎዸን፤ ጉያ ሰነ ሰበ ሰነ ኬሳ ነመ ገረ ኩመ ሰዲቱ ዱኤ። <verse eid="EXO 32:28"/><verse number="29" style="v" sid="EXO 32:29"/>ሙሴንስ፣ “እስን ዋን እልማንኬሰኒፊ ኦቦሎተኬሰንት ካተኒፍ ሀርአ <char style="nd">ዋቀዮፍ</char> አዳን ባፈምተኒርቱ፤ እንስ ጉያ ሀርኣ እስን ኤብሴረ” ጄዼ።<verse eid="EXO 32:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 32:30"/>ሙሴን ጉያ እት ኣኑት ሰበ ሰናን፣ “እስን ጩቡ ጉዳ ሆጄተኒርቱ። ገሩ አን አመ ገረ <char style="nd">ዋቀዮት</char> ኦል ነንበአ፤ ተሪ አን ጩቡኬሰኒፍ አራረ ነንቡሰ ተአ” ጄዼ።<verse eid="EXO 32:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 32:31"/>ሙሴንስ ዴብኤ ገረ <char style="nd">ዋቀዮ</char> ዸቄ አከነ ጄዼ፤ “ወዮ! ሰብን ኩን ጩቡ አከም ጉዳ ሆጄቴ! እሳን ኦፊሳኒቲፍ ዋቆተ ወርቄ ቶልፈተኒሩ። <verse eid="EXO 32:31"/><verse number="32" style="v" sid="EXO 32:32"/>ተኡስ ማሎ አመ ጩቡሳኒ ዺሲፍ፤ ዮ ከና አች ክታበ በሬስቴ ሰነ ኬሳ መቃኮ ሀቅ።”<verse eid="EXO 32:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 32:33"/>
    <char style="nd">ዋቀዮ</char>ሞ ሙሴዻን አከነ ጄዼ፤ “አን ነመ ጩቡ ነት ሆጄቴ ክታበኮራ ነንሀቀ። <verse eid="EXO 32:33"/><verse number="34" style="v" sid="EXO 32:34"/>አመ ከኢቲ ገረ ለፈ አን ስት ህሜ ሰናት ሰበ ከነ ቀጄልች፤ ኩኖ ኤርገማንኮስ ፉለኬ ዱረ ንዴመ። ገሩ ጋፈ ዬሮን አን እሳን አደቡ ገኡት አን ጩቡሳኒቲፍ እሳን ነንአደበ።”<verse eid="EXO 32:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 32:35"/>ሰበቢ በሌሳ እሳን ጀቢ አሮን ቶልቼ ሰናን ሆጄተኒቲፍ <char style="nd">ዋቀዮ</char> በላዻን ሰበ ሰነ ዸኤ።<verse eid="EXO 32:35"/></para>
  <chapter eid="EXO 32"/>
  <chapter number="33" style="c" sid="EXO 33"/>
  <para style="p">
    <verse number="1" style="v" sid="EXO 33:1"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ “አቲፊ ሰብን አት ብየ ግብጢቲ ባፍቴ ፍዴ ኩን አሲ በኣቲ ገረ ብየ አን አብረሃሚፍ፣ ይስሃቂፊ ያቆቢፍ፣ ‘አን ሰኚኬቲፍ ነንኬነ’ ጄዼ ከከዼ ሰና ዸቃ። <verse eid="EXO 33:1"/><verse number="2" style="v" sid="EXO 33:2"/>አን ኤርገማኮ ፉለኬ ዱራን ኤርጌ ከነኣኖተ፣ አሞሮተ፣ ሄቶተ፣ ፌርዞተ፣ ሂዎታፊ ዬቡሶተ አርኤ ነንባሰ። <verse eid="EXO 33:2"/><verse number="3" style="v" sid="EXO 33:3"/>ገረ ብየ ኣነኒፊ ደም ኬሳ ቡርቁ ዸቅ። ገሩ ዋን አት ሰበ መተ ጀቤሰ ታቴፍ አን አከ ከራት ስ ህንበሌስኔፍ ስ ወጅን ህንዴሙ።”<verse eid="EXO 33:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 33:4"/>ጀር ዮሙ ኦዱ ሀማ ከነ ዸገአንት ገዱ ጀልቀበን፤ እሳን ኬሳስ ነምን ቶኮዩ ፋየ ቶኮሌ ህንካአትኔ። <verse eid="EXO 33:4"/><verse number="5" style="v" sid="EXO 33:5"/><char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼራቲ፤ “ሰበ እስራኤሊን አከነ ጄዽ፤ ‘እስን ሰበ መተ ጀቤዪዸ። አን ኡቱ ዬሩመ ሙራሰሌ እስን ወጅን ዴሜ ስላ እስን በሌሰ ቱሬ፤ እስን አመ ፋየወንኬሰን ኦፍራ ባሳ፤ አንስ ዋነን እስን ጎዹ ነንሙርቴሳ።’ ” <verse eid="EXO 33:5"/><verse number="6" style="v" sid="EXO 33:6"/>ከናፉ እስራኤሎን ጋረ ኮሬብ ብረት ፋየወንሳኒ ኦፍራ ባሰን።<verse eid="EXO 33:6"/></para>
  <para style="s1">ዱንካነ ወል ገኢ</para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 33:7"/>ሙሴን ዱንካነ ቶኮ ፉዼ እዶ ቁበታ ሰነ ኬሳ ባሴ አች ፈጌሴ ዻበ ቱሬ፤ ዱንካነ ሰነስ፣ “ዱንካነ ወል ገኢ” ጄዼ ሞጋሴ። ነምን <char style="nd">ዋቀዮን</char> በርባደቱ ሁንድኑ እዶ ቁበታ ሰነ ኬሳ በኤ ገረ ዱንካነ ወል ገኢ ሰና ዸቀ ቱሬ። <verse eid="EXO 33:7"/><verse number="8" style="v" sid="EXO 33:8"/>ዬሮ ሙሴን በኤ ገረ ዱንካነ ሰና ዸቁ ሁንደ ሰብን ሁንድኑ ከኤ በልበለ ዱንካነ ኦፊሳ ዱረ ዻበቴ ሀመ እን ዱንካንቸ ሴኑት እላለ ቱሬ። <verse eid="EXO 33:8"/><verse number="9" style="v" sid="EXO 33:9"/>ዬሮ ሙሴን ዱንካነ ሰነ ሴኑት ኡቱባን ዱሜሳ ገድ ቡኤ በልበለ ዱንካንቻ ዱረ ዻበተ ቱሬ፤ <char style="nd">ዋቀዮስ</char> ሙሴ ወጅን ዱበተ ቱሬ። <verse eid="EXO 33:9"/><verse number="10" style="v" sid="EXO 33:10"/>ሰብን ዬሮ ኡቱባ ዱሜሳ ከን በልበለ ዱንካና ዱረ ዻበቱ አርጉት ሁንድሳ ኦል ከኤ ቶኮን ቶኮን ነማ ዱንካነ ኦፊሳ ዱረት ሰገደ ቱሬ። <verse eid="EXO 33:10"/><verse number="11" style="v" sid="EXO 33:11"/><char style="nd">ዋቀዮስ</char> አኩመ ነመ ምቹሳ ወጅን ሃሰኡ ቶኮት እፉማን እፈት ሙሴት ዱበቻ ቱሬ። ኤርገሲስ ሙሴን እዶ ቁበታት ዴብአ ቱሬ፤ ገርጋራንሳ፣ እያሱን እልም ኑን ደርገጌስ ሱን ገሩ ዱንካነ ሰነ ብራ ህንዴሙ ቱሬ።<verse eid="EXO 33:11"/></para>
  <para style="s1">ሙሴፊ ኡልፍነ <char style="nd">ዋቀዮ</char></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 33:12"/>ሙሴን <char style="nd">ዋቀዮን</char> አከነ ጄዼ፤ “እላ፣ አት፣ ‘ሰበ ከነ ዱረ ቡኢ ባስ’ ናን ጄቴርተ፤ ገሩ አነ ወጅን ኤኙን አከ ኤርግቱ ነ ህንቤክስፍኔ። አት፣ ‘አን መቃዻን ስ ቤከ፤ አት ነ ብረት ፉዸተመ አርገቴርተ’ ጄቴ። <verse eid="EXO 33:12"/><verse number="13" style="v" sid="EXO 33:13"/>አመስ አን ፉለኬ ዱረት ሱራ አርገዼ ዮን ጅራዼ፣ አከ አን ስ ቤኩፊ አከ አን ፉለኬ ዱረት ሱራ አርገዹፍ ከራኬ ነ በርሲስ፤ አከ ሰብን ኩን ሰበኬ ተኤስ ያደዹ።”<verse eid="EXO 33:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 33:14"/>
    <char style="nd">ዋቀዮስ</char> ዴብሴ፣ “አን ስ ወጅን ነንዴመ፤ ቦቆናስ ሲፍን ኬነ” ጄዼ።<verse eid="EXO 33:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 33:15"/>ሙሴንሞ አከነ ጄዼን፤ “ዮ አት ኑ ወጅን ዴሙ ባቴ፣ አሲ ኑ ህንባስን። <verse eid="EXO 33:15"/><verse number="16" style="v" sid="EXO 33:16"/>አት ኑ ወጅን ዴሙ ባናን ነምን አከሚን አከ አት አናፊ ሰበኬት ገመዱ ቤከ? ወን አናፊ ሰበኬ ሰቦተ ለፈራ ካን ሁንደራ አዳን ባሱ ብራ ማልሬ?”<verse eid="EXO 33:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 33:17"/>
    <char style="nd">ዋቀዮ</char>ሞ ሙሴዻን፣ “አን ዋን አት አመ ከዸቴ ከነ ነንጎዸ፤ አት ፉለኮ ዱረት አያነ አርገቴርታቲ፤ አንስ መቃዻን ስ ቤከ” ጄዼ።<verse eid="EXO 33:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 33:18"/>ሙሴንስ፣ “ማሎ ኡልፍነኬ ነ አርግሲስ” ጄዼ።<verse eid="EXO 33:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 33:19"/>
    <char style="nd">ዋቀዮ</char>ሞ አከነ ጄዼ፤ “አን ጋሩማኮ ሁንዱማ ፉለኬ ዱረ ነንደበርሰ፤ መቃ <char style="nd">ዋቀዮ</char> ፉለኬ ዱረት ነንለብሰ። አን ከነን ማሩ ነንማረ፤ ከነን ገራ ላፉፊስ ገራ ነንላፈ። <verse eid="EXO 33:19"/><verse number="20" style="v" sid="EXO 33:20"/>ገሩ ዋን ነምን ፉለኮ አርጌ ጅራቹ ህንደንዴኜፍ አት ፉለኮ አርጉ ህንደንዴሱ።”<verse eid="EXO 33:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 33:21"/>ኤርገሲስ <char style="nd">ዋቀዮ</char> አከነ ጄዼ፤ “ኩኖ አስ ነ ብረ እዶን አት ከታረ ዻበቹ ደንዴሱ ጅረ። <verse eid="EXO 33:21"/><verse number="22" style="v" sid="EXO 33:22"/>አን ዬሮ ኡልፍንኮ ደርቡት ጅሩ ሆልቀ ከታ ኬሰ ስ ካኤ ሀመ አን ደርቡት ሀርከኮቲን ስ ደኤሰ። <verse eid="EXO 33:22"/><verse number="23" style="v" sid="EXO 33:23"/>ኤርገሲስ አን ሀርከኮ ነንፉዸዸ፤ አትስ ዱግደኮ ንአርግተ፤ ፉልኮ ገሩ አርገሙ ህንቀቡ።”<verse eid="EXO 33:23"/></para>
  <chapter eid="EXO 33"/>
  <chapter number="34" style="c" sid="EXO 34"/>
  <para style="s1">ገበቴወን ዸጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 34:1"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፤ “ገበቴወን ዸጋ ለመ አኩመ ከኔን ዱራ ሰናት ሶፍ፤ አንስ ዱቢ ገበቴወን አት ጨጨብስቴ ሰነረ ቱረን እሳንረት ነንበሬሰ። <verse eid="EXO 34:1"/><verse number="2" style="v" sid="EXO 34:2"/>አትስ ገነማን ቆጳዪቲ ቱሉ ሲናት ኦል በእ። አችት፣ ፊጤ ቱሉ ሰናረት ፉለኮ ዱረት ኦፍ ዽኤስ። <verse eid="EXO 34:2"/><verse number="3" style="v" sid="EXO 34:3"/>ነምን ቶኮዩ ስ ወጅን ህንዹፍን ዮካን ቱሉ ሰነረት ኤሱመቱ ህንሙልአትን። ቡሻዬፊ ሎንዩ ፉለ ቱሉ ሰና ዱረት ህንቦበእን።”<verse eid="EXO 34:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 34:4"/>ሙሴንስ ገበቴወን ዸጋ ለመ አኩመ ከኔን ጀልቀባት ሶፌ፤ እንስ ገበቴወን ለማንስ ሀርከት ቀበቴ አኩመ <char style="nd">ዋቀዮ</char> እሰ አጀጄት ገነመ በሪን ቱሉ ሲናት ኦል በኤ። <verse eid="EXO 34:4"/><verse number="5" style="v" sid="EXO 34:5"/><char style="nd">ዋቀዮ</char> ዱሜሳን ገድ ቡኤ እሰ ወጅን አች ዻበቴ፤ መቃ <char style="nd">ዋቀዮስ</char> ንለብሴ። <verse eid="EXO 34:5"/><verse number="6" style="v" sid="EXO 34:6"/>ዋቀዮ ፉለ ሙሴ ዱረ ደርቤ አከነ ጄዼ ለብሴ፤ “<char style="nd">ዋቀዮ</char>፣ <char style="nd">ዋቀዮ</char> ዋቀ ገረ ላፌሳፊ አርጃ፣ ከን ደፌ ህንኣሬ፣ ከን ጃለሊፊ አመነሙማንሳ ጉዳ፣ <verse eid="EXO 34:6"/><verse number="7" style="v" sid="EXO 34:7"/>ከን አራረሳ ዸሎተ ኩማተማፍ ቱርሱ፣ ከን ሀምነ፣ ፍንጭላፊ ጩቡ ነማፍ ዺሱዸ። ተኡሌ እን ነመ የከ ሆጄቱ አደቡ መሌ ህንዺሱ፤ እን ሀመ ዸሎተ ሰደፋፊ አፉረፋት ሰበቢ ጩቡ አቦቲሳኒቲፍ ጄዼ እጆሌሳኒቲፊ እጆሌ እጆሌሳኒ ንአደበ።”<verse eid="EXO 34:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 34:8"/>ሙሴን ዮሙሱመ ለፈት ገድ ጄዼ ሰገዴ። <verse eid="EXO 34:8"/><verse number="9" style="v" sid="EXO 34:9"/>እንስ፣ “ያ ጎፍታ፣ ዮ አን ፉለኬ ዱረት አያነ አርገዼ ጅራዼ፣ ጎፍታን ኑ ወጅን ሃዴሙ። ዮ ሰብን ኩን ሰበ መተ ጀቤሰ ተኤሌ ሀምነኬኛፊ ጩቡኬኘ ኑ ዺስ፤ ዻለኬስ ኑ ጎዸዹ” ጄዼ።<verse eid="EXO 34:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 34:10"/>ከነረት <char style="nd">ዋቀዮ</char> አከነ ጄዼ፤ “ኩኖ አን ስ ወጅን ከኩ ነንገለ። አን ፉለ ሰበኬ ሁንዳ ዱረት ድንቂወን ከናን ዱረ ሰበ ከምዩ ኬሰት፣ አዱኛ ሁንደ ኬሰት ተኩማ ህንሆጄተምን ነንሆጄዸ። ሰብን አት ኬሰ ጅራቱስ አከ ሆጂን አን <char style="nd">ዋቀዮ</char> ሲፍ ሆጄዹ ሀመም ሶዳችሳ ተኤ ንአርገ። <verse eid="EXO 34:10"/><verse number="11" style="v" sid="EXO 34:11"/>ዋን አን ሀርአ ስ አጀጁፍ አጀጀም። አንስ አሞሮተ፣ ከነኣኖተ፣ ሄቶተ፣ ፌርዞተ፣ ሂዎታፊ ዬቡሶተ ፉለኬ ዱራ አርኤ ነንባሰ። <verse eid="EXO 34:11"/><verse number="12" style="v" sid="EXO 34:12"/>አከ ወረ ብየ አት እት ገሉፍ ዴምቱ ሰነ ኬሰ ጅራተን ወጅን ከኩ ህንገሌፍ ኦፍ ኤገዹ፤ ዮ ከና አቺ እሳን ክዮ ስት ተኡ። <verse eid="EXO 34:12"/><verse number="13" style="v" sid="EXO 34:13"/>እዶወን ኣርሳሳኒ ዲጋ፤ ሲዳወን ዋቄፈትናሳኒ ጨጨብሳ፤ ኡቱባወን ኣሼራሳኒስ ጅጅግሳ። <verse eid="EXO 34:13"/><verse number="14" style="v" sid="EXO 34:14"/>ሰበቢ <char style="nd">ዋቀዮ</char> መቃንሳ ህናፋ ጄዸሙ ሱን ዋቀ ህናፉ ተኤፍ አት ዋቀ ብራ ህንዋቄፈትን።<verse eid="EXO 34:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 34:15"/>“አት አከ ወረ ብየ ሰነ ኬሰ ጅራተን ወጅን ከኩ ህንገሌፍ ኦፍ ኤገዹ። ሰበቢንሳ እሳን ዮሙ ዋቆተሳኒ ወጅን ሰጋገለኒፊ ዮሙ ዋቆተሳኒቲፍ ኣርሳ ዽኤሰንት ስ ዋሙ፤ አትስ ኣርሳሳኒ ንኛተ። <verse eid="EXO 34:15"/><verse number="16" style="v" sid="EXO 34:16"/>ዬሮ አት እልማንኬ እንተለንሳኒ ፉስፍቴ፣ እንተለንሳኒ ሱን ዋቆተሳኒ ወጅን ሰጋገለንት እሳን አከ እልማንኬስ አኩመሳኒ ሰጋገለን ጎዹ።<verse eid="EXO 34:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 34:17"/>“ዋቆተ ቶልፈሞ በቅፈመኒ ሆጄተመን ህንቶልፈትን።<verse eid="EXO 34:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 34:18"/>“አያነ መጥኖ አያኔፈዹ። አት ሰበቢ ጅአ አቢቢ ኬሰ ግብጢ ባቴፍ አኩመ አን ስ አጀጄ ሰነት ጅአ አቢቢ ኬሰ ዬሮ ሙርቴፈሜት ቡልቲ ቶርበ መጥኖ ኛዹ።<verse eid="EXO 34:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 34:19"/>“ከን ጀልቀበት ገደሜሰ ሳቄ በኡ ሁንድ ከንኮት፤ ኮርም ሆሪኬቲ ሀንገፍን ጄቹንስ ኮርም ሎኒቲፊ ኮርም ሆሎታ ሀንገፍንኮት። <verse eid="EXO 34:19"/><verse number="20" style="v" sid="EXO 34:20"/>ሀሬ ሀንገፈ ጦባላ ሆላቲን ፉር፤ ዮ ፉሩ ባቴሞ ሞርመሳ ጨብስ። እልማንኬ ሀንገፈ ሁንደስ ፉር።</para>
  <para style="p" vid="EXO 34:20">“ነምን ቶኮዩ ሀርከ ዱዋ ፉለኮ ዱረት ህንዽኣትን።<verse eid="EXO 34:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 34:21"/>“ጉያ ጀአ ሆጂ ሆጄዹ፤ ጉያ ቶርበፋት ገሩ ቦቆዹ። ዬሮ ቆናቲፊ ዬሮ ምዻን ገልፈሙት ቦቆዹ።<verse eid="EXO 34:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 34:22"/>“መታ ቀመዲ ጀልቀባረት አያነ ቶርበኖታ አያኔፈዹ፤ ዹመ ወጋረትሞ አያነ ገልቻ ምዻኒ አያኔፈዹ። <verse eid="EXO 34:22"/><verse number="23" style="v" sid="EXO 34:23"/>ዺርኬ ሁንድ ወጋት ዬሮ ሰዲ ፉለ <char style="nd">ዋቀዮ</char> ጎፍታ፣ ፉለ ዋቀ እስራኤል ዱረት ሃዽኣተን። <verse eid="EXO 34:23"/><verse number="24" style="v" sid="EXO 34:24"/>አን ነሞተ ኦርማ ስ ዱራ አርኤ ነንባሰ፤ ዳንጋኬ ነንበልእሰ፤ ዮ አት ወጋት ዬሮ ሰዲ <char style="nd">ዋቀዮ</char> ዋቀኬ ዱረት ዽኣቹ ዸቅጡስ ነምን ቶኮዩ ብየኬ ፉዸቹ ህንሀዉ።<verse eid="EXO 34:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 34:25"/>“ዺገ ኣርሳ ዋን ራጭቲ ቀቡ ወጅን ና ህንዽኤስን፤ ቀልም አያነ ፋሲካራ ሀፉስ ሀመ በሪት ህንቱርን።<verse eid="EXO 34:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 34:26"/>“መታ ምዻን ለፈኬቲ ኬሳ ፍለተማሳ ገረ መነ <char style="nd">ዋቀዮ</char> ዋቀኬቲ ፍድ።</para>
  <para style="p" vid="EXO 34:26">“እልሞ ሬኤ ኣነን ሃዸሼቲን ህንአፌልን።”<verse eid="EXO 34:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 34:27"/>
    <char style="nd">ዋቀዮስ</char> ሙሴዻን፣ “ዱቢ ከነ በሬስ፤ አን አኩመ ዱቢ ከናት ስኢፊ ሰበ እስራኤል ወጅን ከኩ ገሌራቲ” ጄዼ። <verse eid="EXO 34:27"/><verse number="28" style="v" sid="EXO 34:28"/>ሙሴንስ ኡቱ ቡዴነ ህንኛትን ዮካን ኡቱ ብሻን ህንዹግን ጉያ አፉርተማፊ ሀልከን አፉርተመ <char style="nd">ዋቀዮ</char> ብረ አች ቱሬ። እንስ ዱቢ ከኩ ሰነ ጄቹንስ አጀጀወን ኩርነን ገበቴወን ሰነረት በሬሴ።<verse eid="EXO 34:28"/></para>
  <para style="s1">ጨለቅሱ ፉለ ሙሴ</para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 34:29"/>ሙሴን ገበቴወን ዹገ በኡምሳ ለማን ሰነ ሀርከት ቀበቴ ቱሉ ሲናራ ገድ ቡኤ፤ እንስ ሰበቢ <char style="nd">ዋቀዮ</char> ወጅን ዱበቻ ቱሬፍ አከ ፉልሳ ጨለቅሱ ህንቤክኔ ቱሬ። <verse eid="EXO 34:29"/><verse number="30" style="v" sid="EXO 34:30"/>ዮሙ አሮኒፊ ሰብን እስራኤል ሁንድ ሙሴ አርገንት ኩኖ፣ ፉልሳ ጨለቅሳ ቱሬ፤ እሳንስ እሰት ዽኣቹ ሶዳተን። <verse eid="EXO 34:30"/><verse number="31" style="v" sid="EXO 34:31"/>ሙሴን ገሩ እሳን ዋሜ፤ አሮኒፊ ቡልችቶትን ሀዋስቻ ሁንድኑስ ገረሳት ዴብአን፤ እንስ እሳንት ዱበቴ። <verse eid="EXO 34:31"/><verse number="32" style="v" sid="EXO 34:32"/>ሰብን እስራኤል ሁንድ እሰት ዽኣቴ፤ እንስ ዋን <char style="nd">ዋቀዮ</char> ጋረ ሲናረት እሰት ዱበቴ ሁንደ እሳን አጀጄ።<verse eid="EXO 34:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 34:33"/>ሙሴን ዮሙ እሳንት ዱበቴ ፍጠቴት ፉለሳ ሀጉገቴ። <verse eid="EXO 34:33"/><verse number="34" style="v" sid="EXO 34:34"/>ዮሙ <char style="nd">ዋቀዮ</char> ወጅን ዱበቹዻፍ ፉለሳ ዱረት ኦል ሴኑ ገሩ ሀመ አቺ በኡት ሀጉጊ ሰነ ኦፍራ ፉዸ ቱሬ። ዮሙ እን አቺ በኤ ዋን አጀጀሜ ሰነ ሰበ እስራኤልት ህሙት፣ <verse eid="EXO 34:34"/><verse number="35" style="v" sid="EXO 34:35"/>እሳን አከ ፉልሳ ጨለቅሱ አርገን። ኤርገሲ ሙሴን ሀመ <char style="nd">ዋቀዮ</char> ወጅን ዱበቹፍ ኦል ገሉት ፉለሳ ዴብሴ ሀጉገተ ቱሬ።<verse eid="EXO 34:35"/></para>
  <chapter eid="EXO 34"/>
  <chapter number="35" style="c" sid="EXO 35"/>
  <para style="s1">ስርነ ሰንበታ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 35:1"/>ሙሴን ወልዳ እስራኤል ጉቱ ወልት ቀቤ አከነ ጄዼን፤ “ወን <char style="nd">ዋቀዮ</char> አከ እስን ሆጄተን እስን አጀጄ ከነ፦ <verse eid="EXO 35:1"/><verse number="2" style="v" sid="EXO 35:2"/>ጉያ ጀአ ሆጂን ሃሆጄተሙ፤ ጉያን ቶርበፋን ገሩ እስኒፍ ጉያ ቁልቁሉዸ፤ <char style="nd">ዋቀዮፍ</char>ሞ ሰንበተ ቦቆና ተአ። ነምን ጉያ ከነ ሆጂ ሆጄቱ ከምዩ ሃአጄፈሙ። <verse eid="EXO 35:2"/><verse number="3" style="v" sid="EXO 35:3"/>ጉያ ሰንበታቲን ለፈ ጅራተን ከምትዩ እብደ ህንቀብሲስና።”<verse eid="EXO 35:3"/></para>
  <para style="s1">ምአ ዱንካነ ቁልቁሉ</para>
  <para style="r">
    <ref loc="EXO 35:4-9">35፥4‑9</ref> ኩወፈ – <char style="xt"><ref loc="EXO 25:1-7">በኡ 25፥1‑7</ref></char></para>
  <para style="r">
    <ref loc="EXO 35:10-19">35፥10‑19</ref> ኩወፈ – <char style="xt"><ref loc="EXO 39:32-41">በኡ 39፥32‑41</ref></char></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 35:4"/>ሙሴንስ ወልዳ እስራኤል ጉቱዻን አከነ ጄዼ፤ “ወን <char style="nd">ዋቀዮ</char> አጀጄ ከነ፦ <verse eid="EXO 35:4"/><verse number="5" style="v" sid="EXO 35:5"/>ዋን ቀብደንራ <char style="nd">ዋቀዮፍ</char> ኬና ዽኤሳ። ነምን ፌዺ ቀቡ ሁንድኑ፦</para>
  <para style="b" vid="EXO 35:5"/>
  <para style="li1" vid="EXO 35:5">“ኬና ወርቄ፣ ሜቲፊ ናሲ <char style="nd">ዋቀዮፍ</char> ሃፍዱ።<verse eid="EXO 35:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="EXO 35:6"/>ክሪ ብፈ ጩቁሊሳ፣ ዺልጌ፣ ብልዲማፊ ቁንጬ ተልባ ጋሪ፣</para>
  <para style="li1" vid="EXO 35:6">ርፌንሰ ሬኤ፣<verse eid="EXO 35:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="EXO 35:7"/>ጎጋ ኮርቤሰ ሆላ ከን ሀሉ ዲማ ጩጰሜፊ ጎጋ ዱገሜ፣</para>
  <para style="li1" vid="EXO 35:7">ሙከ ላፍቶ፣<verse eid="EXO 35:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="EXO 35:8"/>እብሳዻፍ ዘይቲ ኤጄርሳ፣</para>
  <para style="li1" vid="EXO 35:8">ዘይቲ እቲን ድበኒፊ እጣነ ኡርጋኡፍሞ ኡርጎፍቱወን፣<verse eid="EXO 35:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="EXO 35:9"/>ዸጋወን ሰርዶንክሲ፣ ዶቀ ገት ጀቤሰ፣ ድረታፊ ቆሜረት ካአተሙ ከን ብራ ሃፍዱ።<verse eid="EXO 35:9"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="10" style="v" sid="EXO 35:10"/>“እስን ኬሳ ነሞትን ኦጌዪን ሁንድ ዹፈኒ ዋን <char style="nd">ዋቀዮ</char> አጀጄ ሁንደ ሃሆጄተን፦<verse eid="EXO 35:10"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="11" style="v" sid="EXO 35:11"/>“ኩንስ ዱንካነ ቁልቁሉ ዱንካነሳቲፊ እረ ቡሳሳ ወጅን፣ ሆኮወንሳ፣ ቱጌሳ፣ ደገሌሳ፣ ኡቱባሳ፣ ሚለሳ፣<verse eid="EXO 35:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="EXO 35:12"/>ታቦተ ደንቀራሳ ወጅን፣ ቴሶ አራራቲፊ ጎልጋ እሰ ዾክሱስ፣<verse eid="EXO 35:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="EXO 35:13"/>ምንጃለ ደንቀራሳቲፊ ምአሳ ሁንደ ወጅን፣ ቡዴነ እላልቻ፤<verse eid="EXO 35:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="EXO 35:14"/>ባቱ እብሳ ከን እፋፍ ተኡ ምአሳ ወጅን፣ እፈ ሰናፍስ እብሳፊ ዘይቲ፣<verse eid="EXO 35:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="EXO 35:15"/>እዶ ኣርሳ እጣና ደንቀራሳ ወጅን፣ ዘይቲ እቲን ድበኒፊ እጣነ ኡርጋኡ፣</para>
  <para style="li1" vid="EXO 35:15">ከረ እቲን ዱንካነ ቁልቁሉ ሴነኒፍስ ጎልጋ በልበላ፣<verse eid="EXO 35:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="EXO 35:16"/>እዶ ኣርሳ ከን ቀልመ ጉበሙ ግንግልቻሳ ከን ናሲራ ሆጄተሜ ወጅን፣ ደንቀራወንሳቲፊ ምአሳ ሁንደ፣</para>
  <para style="li1" vid="EXO 35:16">ጫቢ ናሲ ሚለሳ ወጅን፣<verse eid="EXO 35:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="EXO 35:17"/>ጎልጋወን ኦብዲ ኡቱባወኒፊ ሚለወንሳኒ ወጅን፣ ጎልጋ ከረ ኦብዲ ሰና፣<verse eid="EXO 35:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="EXO 35:18"/>ዱንካነ ቁልቁሉፊ ቆፎወን ኦብዲ ዱንካነ ቁልቁሉቲፊ ፉኞወንሳኒ፣<verse eid="EXO 35:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="EXO 35:19"/>ወያወን ፎአመኒ ዸአመን ከኔን እሳን ዬሮ እዶ ቁልቁሉ ኬሰ ተጃጅለን ኡፈተመን ጄቹንስ ወያወን አሮን ሉብቻፍ ቁልቁሌፈመኒፊ ወያወን እልማንሳ ዬሮ ሉቡማዻን ተጃጅለንት ኡፈተን ሃሆጄተን።”<verse eid="EXO 35:19"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="20" style="v" sid="EXO 35:20"/>ኤርገሲስ ሀዋስን እስራኤል ጉቱን ሙሴ ብራ በአኒ ዴመን፤ <verse eid="EXO 35:20"/><verse number="21" style="v" sid="EXO 35:21"/>ነምን ፌዺ ቀቡፊ ነምን ያድንሳ እሰ ከካሴ ሁንድ ዹፌ ሆጂ ዱንካነ ወል ገኢ ሰናቲፍ፣ ተጃጅለሳ ሁንዳፊ ሆጂ ወያወን ቁልቁሉ ሰናቲፍ ኬና <char style="nd">ዋቀዮፍ</char> ፍዴ። <verse eid="EXO 35:21"/><verse number="22" style="v" sid="EXO 35:22"/>ዺሪፊ ዱበርቲን ፌዺ ቀበን ሁንድ ምአ ወርቄራ ሆጄተሜ ከኔን ጎሰ ጎሳ ፍደን፤ ብተዎ፣ ሎቲ፣ ቁቤላፊ ፋየ ፍደን። ሁንድሳኒዩ ወርቄሳኒ ኣርሳ ሶቾፈሙ ጎዸኒ <char style="nd">ዋቀዮፍ</char> ዽኤሰን። <verse eid="EXO 35:22"/><verse number="23" style="v" sid="EXO 35:23"/>ነምን ክሪ ብፈ ጩቁሊሳ፣ ዺልጌ ዮካን ብልዲማ ዮካን ቁንጬ ተልባ በኤሰ ዮካን ርፌንሰ ሬኤ፣ ከልዼ ኮርቤሰ ሆላ ከን ሀሉ ዲማ ጩጰሜፊ ጎጋ ዱገሜ ቀቡ ሁንድ ንፍዴ። <verse eid="EXO 35:23"/><verse number="24" style="v" sid="EXO 35:24"/>ወር ኬና ሜቲ ዮካን ናሲ ዽኤሰን ኬና <char style="nd">ዋቀዮፍ</char> ዽኤፈሙ ጎዸኒ ፍደን። ነምን ሙከ ላፍቶ ከን ቆደ ሆጂ ሰና ከሚፍዩ ተኡ ቀቡ ሁንደስ ንፍዴ። <verse eid="EXO 35:24"/><verse number="25" style="v" sid="EXO 35:25"/>ዱበርቶትን ኦጌዪን ሁንድስ ሀርካን ፎአኒ ክሪ ብፈ ጩቁሊሳ፣ ዺልጌ፣ ብልዲማፊ ቁንጬ ተልባ በኤሰ ፎአን ሰነ ፍደን። <verse eid="EXO 35:25"/><verse number="26" style="v" sid="EXO 35:26"/>ዱበርቶትን ፌዺፊ ኦጉማ ቀበን ሁንድኑስ ርፌንሰ ሬኤ ፎአን። <verse eid="EXO 35:26"/><verse number="27" style="v" sid="EXO 35:27"/>ቡልችቶትን ዸጋወን ሰርዶንክሲፊ ዸጋወን ገት ጀቤዪ ብራ ድረታፊ ኪሲ ቆማት አከ ካአተሙፍ ፍደን። <verse eid="EXO 35:27"/><verse number="28" style="v" sid="EXO 35:28"/>አከሱመስ ኡርጎፍቱፊ ዘይቲ እብሳዻፍ፣ ዘይቲ እቲን ድበኒፊ እጣነ ኡርጋኡስ ፍደን። <verse eid="EXO 35:28"/><verse number="29" style="v" sid="EXO 35:29"/>ዺሮትኒፊ ዱበርቶትን እስራኤል ወር ፌዺ ቀበን ሁንድ ሆጂ አከ እሳን ሆጄተኒፍ <char style="nd">ዋቀዮ</char> ከራ ሙሴቲን እሳን አጀጄ ሰነ ሁንዳፍ ፌዺሳኒቲን <char style="nd">ዋቀዮፍ</char> ኬና ፍደን።<verse eid="EXO 35:29"/></para>
  <para style="s1">ቤዘልኤሊፊ ኦሆሊያብ</para>
  <para style="r">
    <ref loc="EXO 35:30-35">35፥30‑35</ref> ኩወፈ – <char style="xt"><ref loc="EXO 31:2-6">በኡ 31፥2‑6</ref></char></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 35:30"/>ዮሙስ ሙሴን ሰበ እስራኤሊን አከነ ጄዼ፤ “እላ <char style="nd">ዋቀዮ</char> ጎሰ ይሁዳ ኬሳ ቤዘልኤል እልመ ኡር እልመ ሁር ፍለቴረ፤ <verse eid="EXO 35:30"/><verse number="31" style="v" sid="EXO 35:31"/>ሀፉረ ዋቃቲን፣ ኦጉማዻን፣ ደንዴቲፊ ቤኩምሰ ሆጂ ሀርካ ጎሰ ሁንዱማን እሰ ጉቴረ። <verse eid="EXO 35:31"/><verse number="32" style="v" sid="EXO 35:32"/>ኩንስ አከ እን ወርቄዻን፣ ሜቲፊ ናሲዻን ሆጂ ኦጉማ ሆጄቱፍ፣ <verse eid="EXO 35:32"/><verse number="33" style="v" sid="EXO 35:33"/>አከ ዸጋወን ሙሬ ቆጴሱፍ፣ አከ ሙከ ሶፉፊ አከ ሆጂ ኦጉማ ሀርካ ከን ጎሰ ሁንዳ ኬሰት ህርማቱፍ። <verse eid="EXO 35:33"/><verse number="34" style="v" sid="EXO 35:34"/>ዋቅንስ ቤዘልኤሊፊ ኦሆሊያብ እልመ አሂሳማክ ከን ጎሰ ዳን ሰናፍ ደንዴቲ እሳን እቲን ወረ ካን በርሲሰን ኬኔ። <verse eid="EXO 35:34"/><verse number="35" style="v" sid="EXO 35:35"/>አከ እሳን ኦጌዪ ሆጂ ሀርካ፣ ብፈ ባስቶታፊ ወረ ክሪ ብፈ ጩቁሊሳቲን፣ ዺልጌን፣ ብልዲማፊ ቁንጬ ተልባ በኤሳን ሚዸግሰኒፊ ወያ ዾፍቶተ ሁንድሳኒ ኦጌዪ ሆጂ ሀርካቲፊ ብፈ ባስቶተ ተአኒፍ ኦጉማ ሆጂ ጎሰ ሁንዳ ሆጄቹቲን እሳን ጉቴ።<verse eid="EXO 35:35"/></para>
  <chapter eid="EXO 35"/>
  <chapter number="36" style="c" sid="EXO 36"/>
  <para style="nb">
    <verse number="1" style="v" sid="EXO 36:1"/>ቤዘልኤል፣ ኦሆሊያቢፊ ነምን <char style="nd">ዋቀዮ</char> ኦጉማፊ ደንዴቲ እሳን እቲን ሆጂ እጃርሰ እዶ ቁልቁሉ ሰና ሁንደ ቤከን ኬኔፍ ሁንድ አኩመ <char style="nd">ዋቀዮ</char> አጀጄት ሆጂ ከነ ሃሆጄተን።”<verse eid="EXO 36:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 36:2"/>ሙሴን ቤዘልኤል፣ ኦሆሊያቢፊ ኦጌሰ <char style="nd">ዋቀዮ</char> ደንዴቲ ኬኔፍ ከን ዹፌ ሆጂ ሰነ ሆጄቹፍ ፌዺ ቀቡ ሁንደ ዋሜ። <verse eid="EXO 36:2"/><verse number="3" style="v" sid="EXO 36:3"/>እሳንስ ኬናወን እስራኤሎን እጃርሰ እዶ ቁልቁሉ ሰናቲፍ ጄዸኒ ፍደን ሁንደ ሙሴ ሀርካ ፉዸን። ነሞትን እስራኤልስ ፌዺሳኒቲን ገነመ ገነመ ኬናሳኒ ፍዱ እት ፉፈን። <verse eid="EXO 36:3"/><verse number="4" style="v" sid="EXO 36:4"/>ኦጌዪን ሆጂ ሀርካ ከኔን እዶ ቁልቁሉ ሰነ ሆጄተን ሁንድ ሆጂሳኒ ዺሰኒ ዹፈኒ <verse eid="EXO 36:4"/><verse number="5" style="v" sid="EXO 36:5"/>ሙሴዻን፣ “ሰብን ኩን ዋን ሆጂ <char style="nd">ዋቀዮ</char> አከ ሆጄተሙፍ አጀጄ ሰናፍ በርባችሱ ጫላ ፍዳ ጅረ” ጄዸን።<verse eid="EXO 36:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 36:6"/>ሙሴንስ አጀጀ ኬኔ፤ እሳንስ፣ “ዺር ዮካን ዱበርቲን ቶኮዩ ዋን ብራ ቶኮሌ ኬና ጎዼ እዶ ቁልቁሉ ሰናፍ ህንዽኤስን” ጄዸኒ እዶ ቁበታ ሰነ ኬሰት ለብሰን። ከናፉ ነሞትን እት ፉፈኒ ዋ ፍዱ ዾወመን። <verse eid="EXO 36:6"/><verse number="7" style="v" sid="EXO 36:7"/>ወንት እሳን ዱራኑ ቀበን ሆጂ ሁንደ ሆጄቹፍ ገኣ እራ ሀፋ ቱሬቲ።<verse eid="EXO 36:7"/></para>
  <para style="s1">ዱንካነ ቁልቁሉ</para>
  <para style="r">
    <ref loc="EXO 36:8-38">36፥8‑38</ref> ኩወፈ – <char style="xt"><ref loc="EXO 26:1-37">በኡ 26፥1‑37</ref></char></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 36:8"/>ሆጄቶተ ሰነ ኬሳስ ኦጌዪን ሁንድ ጎልጋወን ኩዸን ከኔን ቁንጬ ተልባ ጋሪ ፎአሜፊ ከን ክሪ ብፈ ጩቁሊሳ፣ ዺልጌፊ ብልዲማራ ሆጄተመኒን ዱንካነ ቁልቁሉ ሃሆጄተን፤ ጎልጋወን ሰነረትስ ኦጌዪን ሀርከ ቀጄለን ኪሩቤሊ ሆጄተን። <verse eid="EXO 36:8"/><verse number="9" style="v" sid="EXO 36:9"/>ጎልጋወን ሱን ሁንድኑ ወል ቅጤ ተአኒ ቶኮን ቶኮንሳኒ ዼርነ ዹንዹመ ድግደሚ ሰዴቲቲፊ በልእነ ዹንዹመ አፉር ቀቡ ቱሬ። <verse eid="EXO 36:9"/><verse number="10" style="v" sid="EXO 36:10"/>እሳንስ ጎልጋወን ሸን ወልት ቀብሲሰን፤ ሸነን ካንሌ አከሱመ ወልት ቀብሲሰን። <verse eid="EXO 36:10"/><verse number="11" style="v" sid="EXO 36:11"/>እሳንስ ጎልጋወን ወልት ቀብሲፈመን ከኔን ጀልቀባ ኬሳ ሀንዳረ እሰ ሞጋረት ሁጩ ብፈ ጩቁሊሳራ ጉሮወን ቶልቸን፤ ጎልጋወን ወልት ቀብሲፈመን ለመፋረትስ አከሱመ ቶልፈመን። <verse eid="EXO 36:11"/><verse number="12" style="v" sid="EXO 36:12"/>እሳንስ ጎልጋ ቶኮረት ጉሮወን ሸንተመ ቶልቸን፤ ጉሮወን ሸንተመሞ ጎልጋወን ወልት ቀብሲፈመን ለመፋ ኬሳ እሰ ሞጋረት ቶልቸን፤ ጉሮወን ሱንስ ገማ ገመናን ቱረን። <verse eid="EXO 36:12"/><verse number="13" style="v" sid="EXO 36:13"/>አከ ዱንካን ቁልቁሉን ሱን ቶኮ ተኡፍስ ሆኮወን ወርቄ ሸንተመ ቶልቸኒ ጎልጋወን ሰነ እቲን ወልት ቀብሲሰን።<verse eid="EXO 36:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 36:14"/>እሳንስ ሀጉጊ ጉባ ዱንካነ ቁልቁሉ ሰናረ ጅሩ ሀጉጉፍ ጎልጋወን ርፌንሰ ሬኤ ኩዸ ቶኮ ሆጄተን። <verse eid="EXO 36:14"/><verse number="15" style="v" sid="EXO 36:15"/>ጎልጋወን ኩዸ ቶኮን ሱን ሁንድ ወል ቅጤ ቱረን፤ ዼርንሳኒ ዹንዹመ ሶዶመ፣ በልእንሳኒሞ ዹንዹመ አፉር ቱሬ። <verse eid="EXO 36:15"/><verse number="16" style="v" sid="EXO 36:16"/>እሳንስ ጎልጋወን ሸን እዶ ቶኮት ወልት ቀብሲሰን፤ ጎልጋወን ካን ጀኣንሞ እዶ ቶኮት ወልት ቀብሲሰን። <verse eid="EXO 36:16"/><verse number="17" style="v" sid="EXO 36:17"/>ኤርገሲስ ጎልጋወን ገመ ቶኮን ወልት ቀብሲፈመን ኬሳ ሀንዳረ እሰ ሞጋረት ጉሮወን ሸንተመ ቶልቸን፤ ጎልጋወን ገመ ካንረት ወልት ቀብሲፈመን ኬሳስ ሀንዳረ እሰ ሞጋረት ጉሮወን ሸንተመ ቶልቸን። <verse eid="EXO 36:17"/><verse number="18" style="v" sid="EXO 36:18"/>አከ ዱንካን ሱን ቶኮ ተኡፍ እቲን ወልት ቀብሲሱፍ ቀብዱወን ናሲ ሸንተመ ቶልቸን። <verse eid="EXO 36:18"/><verse number="19" style="v" sid="EXO 36:19"/>ዱንካነ ሰናፍስ እረ ቡሳ ከልዼ ኮርቤሰ ሆላ ከን ሀሉ ዲማ ጩጰሜ፣ እሰ እራንሞ እረ ቡሳ ጎጋ ዱገሜ ሆጄተን።<verse eid="EXO 36:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 36:20"/>ዱንካነ ቁልቁሉ ሰናፍስ ሙከ ላፍቶራ ቱጌወን ቀቀጄሎ ሆጄተን። <verse eid="EXO 36:20"/><verse number="21" style="v" sid="EXO 36:21"/>ዼርን ቶኮ ቶኮ ቱጌወን ሰናስ ዹንዹመ ኩዸን፣ በልእንሳሞ ዹንዹመ ቶኮፊ ወለካ ቱሬ። <verse eid="EXO 36:21"/><verse number="22" style="v" sid="EXO 36:22"/>ቶኮን ቶኮን ቱጌወን ሰናስ አከ ወል ኬሰ ገሉ ደንደኡፍ ሙቸ ለመ ለመ ቀበ ቱሬ። ቱጌወን ዱንካነ ቁልቁሉ ሰና ሁንደ አከስት ቶልቸን። <verse eid="EXO 36:22"/><verse number="23" style="v" sid="EXO 36:23"/>ገመ ክበ ዱንካነ ቁልቁሉ ሰናቲፍስ ቱጌወን ድግደመ ሆጄተን፤ <verse eid="EXO 36:23"/><verse number="24" style="v" sid="EXO 36:24"/>ቱጌወን ድግደመን ሰነ ጀለት ሚለ ሜቲ አፉርተመ ጄቹንስ ቱጌ ቶኮ ጀለት ሚለ ለመ ጉረሳ ለማኒፍ፣ ቱጌ ካን ጀለትስ ሚለ ለመ ጉረሳ ለማኒፍ ቶልቸን። <verse eid="EXO 36:24"/><verse number="25" style="v" sid="EXO 36:25"/>ገመ ዱንካነ ቁልቁሉ ሰና ካኒፍስ ከራ ካባቲን ቱጌወን ድግደመ ቶልቸን። <verse eid="EXO 36:25"/><verse number="26" style="v" sid="EXO 36:26"/>እሳኒፍስ ሚለ ሜቲስ አፉርተመ ጄቹንስ ቱጌ ቶኮ ጀለት ሚለ ለመ፣ ቱጌ ካን ጀለትስ ሚለ ለመ ቶልቸን። <verse eid="EXO 36:26"/><verse number="27" style="v" sid="EXO 36:27"/>ከራ ልጠ ቢፍቱቲን፣ ዱግደ ዱበ ዱንካነ ቁልቁሉ ሰናቲፍ ቱጌ ጀአ ሆጄተን። <verse eid="EXO 36:27"/><verse number="28" style="v" sid="EXO 36:28"/>ከራ ዱግደ ዱባስ ጎሌ ዱንካነ ቁልቁሉ ሰናቲፍ ኡቱባ ለመ ቶልቸን። <verse eid="EXO 36:28"/><verse number="29" style="v" sid="EXO 36:29"/>ቱጌወን ጎሌ ኩኔን ጀላ ሀመ ጉባት ወልት ፈይፈመኒ በንቲረት ቁቤላ ቶኮን ወልት ቀብሲፈመን፤ ቱጌወን ጎሌ ለማኒስ አከኑመ ሆጄተን። <verse eid="EXO 36:29"/><verse number="30" style="v" sid="EXO 36:30"/>ከናፉ ቱጌወን ሰዴት ከኔን ሚለ ሜቲ ኩዸ ጀአ ቀበንቱ ቱሬ፤ ቶኮን ቶኮን ቱጌ ሰናስ ሚለ ለመ ለመ ቀበ ቱሬ።<verse eid="EXO 36:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 36:31"/>አከሱመስ ሙከ ላፍቶራ ደገሌወን ቶልቸን፤ ቱጌወን ዱንካነ ቁልቁሉ ሰነረ ገመ ቶኮን ጅረኒፍ ደገሌወን ሸን፣ <verse eid="EXO 36:31"/><verse number="32" style="v" sid="EXO 36:32"/>ቱጌወን ገመ ካኒን ጅረኒፍ ሸን፣ ቱጌወን ዱግደ ዱባን ከራ ልጠ ቢፍቱቲን ጅረኒፍሞ ደገሌወን ሸን ቶልቸን። <verse eid="EXO 36:32"/><verse number="33" style="v" sid="EXO 36:33"/>ደገሌ ወለካ ጅሩ ሰነ አከ እን ግዱ ቱጌወኒቲን ሞጋ ቶኮ ሀመ ሞጋ ካኒት ፉለኡ ጎዸን። <verse eid="EXO 36:33"/><verse number="34" style="v" sid="EXO 36:34"/>ቱጌወን ሰነትስ ወርቄ ድበኒ አከ ደገሌወን ባተኒፍ ቁቤላወን ወርቄ እት ቶልቸን። ደገሌወን ሰናትስ አከሱመ ወርቄ ኡፍሰን።<verse eid="EXO 36:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 36:35"/>እሳንስ ክሪ ብፈ ጩቁሊሳ፣ ዺልጌ፣ ብልዲማፊ ቁንጬ ተልባ ሀጲራ ጎልጋ ቶልቸን፤ ጎልጋ ከነረትስ ኦጌስ ሀርከ ቀጄሉ ቶኮ ፈኪ ኪሩቤሊ ቶልቼ። <verse eid="EXO 36:35"/><verse number="36" style="v" sid="EXO 36:36"/>ጎልጋ ሰናፍስ ኡቱባወን ሙከ ላፍቶ አፉር ቶልቸኒ ወርቄ እት ኡፍሰን፤ ኡቱባ ሰናፍስ ሆኮወን ወርቄ ሆጄተኒ ሚለ ሜቲ አፉር እት ቶልቸን። <verse eid="EXO 36:36"/><verse number="37" style="v" sid="EXO 36:37"/>እሳንስ በልበለ ዱንካንቻቲፍ ጎልጋ ክሪ ብፈ ጩቁሊሳ፣ ዺልጌ፣ ብልዲማፊ ቁንጬ ተልባ ከን ቀልእፈሜ ፎአሜ ሀርካን እረት ሆዸሜ ቶኮ ፋዬሰኒ ቶልቸን። <verse eid="EXO 36:37"/><verse number="38" style="v" sid="EXO 36:38"/>እሳንስ ኡቱቦተ ሆኮ ቀበን ሸን ሆጄተኒ፣ ፊጤፊ ሶማወን ኡቱቦታት ወርቄ ኡፍሰን፤ ሚለሳኒ ሸነንስ ናሲራ ቶልቸን።<verse eid="EXO 36:38"/></para>
  <chapter eid="EXO 36"/>
  <chapter number="37" style="c" sid="EXO 37"/>
  <para style="s1">ታቦተ</para>
  <para style="r">
    <ref loc="EXO 37:1-9">37፥1‑9</ref> ኩወፈ – <char style="xt"><ref loc="EXO 25:10-20">በኡ 25፥10‑20</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 37:1"/>ቤዘልኤል ሙከ ላፍቶራ ታቦተ ቶልቼ፤ ታቦትን ሱንስ ዹንዹመ ለማፊ ወለካ ዼረተ፤ ዹንዹመ ቶኮፊ ወለካ በልአተ፤ ዹንዹመ ቶኮፊ ወለካ ኦል ዼረተ ቱሬ። <verse eid="EXO 37:1"/><verse number="2" style="v" sid="EXO 37:2"/>እንስ ኬሳፊ ዱበሳት ወርቄ ቁልቁሉ ኡፍሴ፤ ናኖ እሳትስ መርሳ ፋየ ወርቄ ናኔሴ ቶልቼ። <verse eid="EXO 37:2"/><verse number="3" style="v" sid="EXO 37:3"/>ቁቤላ ወርቄ አፉር ቶልቼፊ ሚለሳ አፍረንት ቀብሲሴ፤ ቁቤላ ለመ ገመ ቶኮን፣ ቁቤላ ካንሞ ገመ ካኒን እት ካኤ። <verse eid="EXO 37:3"/><verse number="4" style="v" sid="EXO 37:4"/>ኤርገሲስ ሙከ ላፍቶራ ደንቀራወን ቶልቼ ወርቄ እት ኡፍሴ። <verse eid="EXO 37:4"/><verse number="5" style="v" sid="EXO 37:5"/>እንስ ታቦተ ሰነ እቲን ባቹዻፍ ደንቀራወን ሰነ ቁቤላወን ኬሰ ሎሴ።<verse eid="EXO 37:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 37:6"/>እንስ ወርቄ ቁልቁሉራ ቴሶ አራራ ቶልቼ፤ ቴሶን ሱንስ ዼርነ ዹንዹመ ለማፊ ወለካፊ በልእነ ዹንዹመ ቶኮፊ ወለካ ቀበ ቱሬ። <verse eid="EXO 37:6"/><verse number="7" style="v" sid="EXO 37:7"/>ሞጋ ለማን ቴሶ አራራረት ወርቄ ቱመሜራ ኪሩቤሊ ለመ ቶልቼ። <verse eid="EXO 37:7"/><verse number="8" style="v" sid="EXO 37:8"/>እንስ ኪሩቢ ቶኮ ሞጋ ቶኮረት፣ ኪሩቢ ለመፋ ሞጋ ካንረት ቶልቼ፤ ኪሩቤሊ ለማን ሰነ ሞጋ ቴሶ አራራ ለማንረት ቴሶ አራራ ወጅን ሙኩመ ቶኮራ ቶልቼ። <verse eid="EXO 37:8"/><verse number="9" style="v" sid="EXO 37:9"/>ኪሩቤሊን ሱን ቆቾሳኒ ኦል በልእፈተኒ ቴሶ አራራ ሰነት ጋድሴሱ ቱረን። ኪሩቤሊን ኩኔን ፉለሳኒ ወልት ገረገልፈተኒ ገረ ቴሶ አራራ እላሉ ቱረን።<verse eid="EXO 37:9"/></para>
  <para style="s1">ምንጃለ</para>
  <para style="r">
    <ref loc="EXO 37:10-16">37፥10‑16</ref> ኩወፈ – <char style="xt"><ref loc="EXO 25:23-29">በኡ 25፥23‑29</ref></char></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 37:10"/>እሳንስ ሙከ ላፍቶራ ምንጃለ ደልገ ዼርንሳ ዹንዹመ ለመ፣ በልእንሳ ዹንዹመ ቶኮ፣ ኦል ዼርንሳ ዹንዹመ ቶኮፊ ወለካ ቶልቸን። <verse eid="EXO 37:10"/><verse number="11" style="v" sid="EXO 37:11"/>እሳንስ ወርቄ ቁልቁሉ እት ኡፍሰኒ ናኖሳት መርሳ ወርቄ ቶልቸን። <verse eid="EXO 37:11"/><verse number="12" style="v" sid="EXO 37:12"/>ናኖሳረትስ ህዺ ሀመ በልእነ ሀርካ ገኡፊ ፋየ ወርቄ ቶልቸን። <verse eid="EXO 37:12"/><verse number="13" style="v" sid="EXO 37:13"/>እሳንስ ቁቤላ ወርቄ አፉር ምንጃለ ሰናፍ ሆጄተኒ እዶ ሚል አፍረን ቱሬት ጎሌወን አፍረንት ቀብሲሰን። <verse eid="EXO 37:13"/><verse number="14" style="v" sid="EXO 37:14"/>ቁቤላወን ሱንስ አከ ደንቀራ ምንጃል ሱን እቲን ባተሙ ቀበኒፍ ጥዮ ሰነት ዽኤፈመኒ ካአመን። <verse eid="EXO 37:14"/><verse number="15" style="v" sid="EXO 37:15"/>ደንቀራወን ምንጃል እቲን ባተሙ ሱን ሙከ ላፍቶራ ሆጄተመኒ ወርቄን እት ኡፍፈሜ ቱሬ። <verse eid="EXO 37:15"/><verse number="16" style="v" sid="EXO 37:16"/>ምኦተ ምንጃለ ሰነረ ካአመን ጄቹንስ ጫቢወንሳ፣ ወጪቲወንሳ፣ ወጪቲወንሳቲፊ ኦኮቴወንሳ ከኔን እቲን ዽባዩ ዽባፈተን ወርቄ ቁልቁሉራ ቶልቸን።<verse eid="EXO 37:16"/></para>
  <para style="s1">ባቱ እብሳ</para>
  <para style="r">
    <ref loc="EXO 37:17-24">37፥17‑24</ref> ኩወፈ – <char style="xt"><ref loc="EXO 25:31-39">በኡ 25፥31‑39</ref></char></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 37:17"/>ባቱ እብሳ፣ ሶማሳቲፊ ደሜሳ ወጅን ወርቄ ቁልቁሉራ ቱመኒ ቶልቸን፤ ወጪቲሳ፣ ሁዻሳቲፊ ደራራሳሌ ወርቄዹመ ቶኮራ ቶልቸን። <verse eid="EXO 37:17"/><verse number="18" style="v" sid="EXO 37:18"/>ብታ ምርገ ባቱ እብሳ ሰነ ኬሳስ ደሜወን ጀአ ጄቹንስ ሰዲ ገመ ቶኮን ሰዲሞ ገመ ካኒን ባፈመን። <verse eid="EXO 37:18"/><verse number="19" style="v" sid="EXO 37:19"/>ጦፎወን ለዉዚ ፈካተን ከኔን ቶኮን ቶኮንሳኒ ሁዻፊ ደራራ ቀበን ሰዲ ደሜ ቶኮረት፣ ወጪቲወን ለዉዚ ፈካተን ከኔን ቶኮን ቶኮንሳኒ ሁዻፊ ደራራ ቀበን ሰዲሞ ደሜ ካንረት ቶልቸን። ደሜወን ጀኣን ባቱ እብሳራ በበአን ሁንደረትስ አከሱመ ቶልቸን። <verse eid="EXO 37:19"/><verse number="20" style="v" sid="EXO 37:20"/>ጦፎወን ሁዻፊ ደራራ ቀበን ከኔን ብፈ ለዉዚቲን ቶልፈመን አፉር ባቱ እብሳ ሰነረ ቱረን። <verse eid="EXO 37:20"/><verse number="21" style="v" sid="EXO 37:21"/>ሁዻን ቶኮ ጭምዲ ጀልቀባ ከን ደሜወን ባቱ እብሳራ በበአን ጀለ፣ ሁዻን ለመፋን ጭምዲ ለመፋ ጀለ፣ ሁዻን ሰደፋንሞ ጭምዲ ሰደፋ ጀለ ቱሬ፤ ወሉማ ገለት ደሜወን ጀአቱ ቱሬ። <verse eid="EXO 37:21"/><verse number="22" style="v" sid="EXO 37:22"/>ሁዻወኒፊ ደሜወን ሁንድኑ ባቱ እብሳ ሰነ ወጅን ወርቄዹመ ቁልቁሉ ቱመሜ ቶኮራ ቶልፈመን።<verse eid="EXO 37:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 37:23"/>እብሳ ቶርበን ሰነ፣ ዋን እቲን ዳራሳ ዸዸአኒፊ ባቱ ዳራ ሰነ ባቱሌ ወርቄ ቁልቁሉራ ቶልቸን። <verse eid="EXO 37:23"/><verse number="24" style="v" sid="EXO 37:24"/>ባቱ እብሳቲፊ ምአሳ ሁንደ ወርቄ ቁልቁሉ ታላንቲ ቶኮራ ቶልቸን።<verse eid="EXO 37:24"/></para>
  <para style="s1">እዶ ኣርሳ እጣና</para>
  <para style="r">
    <ref loc="EXO 37:25-28">37፥25‑28</ref> ኩወፈ – <char style="xt"><ref loc="EXO 30:1-5">በኡ 30፥1‑5</ref></char></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 37:25"/>እሳንስ ሙከ ላፍቶራ እዶ ኣርሳ እጣና ቶልቸን፤ እዶን ኣርሳ ኩንስ ደልገ ዼርነ ዹንዹመ ቶኮ፣ በልእነ ዹንዹመ ቶኮፊ ኦል ዼርነ ዹንዹመ ለማ ቀባቴ ገመ አፍረኒኑ ወል ቅጤ ቱሬ። ጋንፈወንሳስ እዶ ኣርሳ ሰናን ወሉመት ሆጄተመን። <verse eid="EXO 37:25"/><verse number="26" style="v" sid="EXO 37:26"/>እሳንስ ጉባሳረ፣ ጭናቸሳ ሁንዱማፊ ጋንፈወንሳት ወርቄ ቁልቁሉ ኡፍሰኒ ናኖሳት መርሳ ወርቄ ናኔሰኒ ቶልቸን። <verse eid="EXO 37:26"/><verse number="27" style="v" sid="EXO 37:27"/>እዶ ኣርሳ ሰናፍስ መርሳወን ወርቄሳቲ ገድት ቁቤላወን ወርቄ ለመ ቶልቸን፤ ቁቤላወን ከነስ አከ እሳን ደንቀራወን እቲን እዶ ኣርሳ ባተን ቀበተኒፍ ገማ ገመናን ጭናቸ ለማንት ቶልቸን። <verse eid="EXO 37:27"/><verse number="28" style="v" sid="EXO 37:28"/>እሳንስ ደንቀራወን ሙከ ላፍቶ ቶልቸኒ ወርቄ እት ኡፍሰን።<verse eid="EXO 37:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 37:29"/>አከሱመስ አኩመ ኦጌሰ ኡርጎፍቱ ቆጴሱ ቶኮት ዘይቲ እቲን ድበን ቁልቁሉፊ እጣነ ኡርጋኣ መካ ህንቀብኔ ቶልቸን።<verse eid="EXO 37:29"/></para>
  <chapter eid="EXO 37"/>
  <chapter number="38" style="c" sid="EXO 38"/>
  <para style="s1">እዶ ኣርሳ ቀልመ ጉበሙ</para>
  <para style="r">
    <ref loc="EXO 38:1-7">38፥1‑7</ref> ኩወፈ – <char style="xt"><ref loc="EXO 27:1-8">በኡ 27፥1‑8</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 38:1"/>እሳንስ ሙከ ላፍቶራ እዶ ኣርሳ ቀልመ ጉበሙ ከን ዹንዹመ ሰዲ ኦል ዼረቱ እጃረን፤ እዶን ኣርሳ ኩንስ ዼርነ ዹንዹመ ሸኒፊ በልእነ ዹንዹመ ሸኒ ቀባቴ ገመ አፍረኒኑ ወል ቅጤ ቱሬ። <verse eid="EXO 38:1"/><verse number="2" style="v" sid="EXO 38:2"/>ቶኮ ቶኮ ጎሌወን አፍረኒት ጋንፈ ቶልቸን፤ ጋንፋፊ እዶ ኣርሳ ሰነ ሙኩመ ቶኮራ ቶልቸን፤ እዶ ኣርሳ ሰነረትስ ናሲ ኡፍሰን። <verse eid="EXO 38:2"/><verse number="3" style="v" sid="EXO 38:3"/>እሳንስ ምአሳ ሁንደ ጄቹንስ ዋን እቲን ዳራ ሀረን፣ ዋን እቲን ዳራ ሀማረን፣ ወጪቲ፣ ሆኮ ፎኒቲፊ ባቱ እብዳ ናሲራ ቶልቸን። <verse eid="EXO 38:3"/><verse number="4" style="v" sid="EXO 38:4"/>እዶ ኣርሳ ሰናፍስ ናሲ ወል ኬሰ ጠጠሜን ግንግልቻ ሆጄተኒ አከ እን ሀመ ወለካ እዶ ኣርሳት ኦል በኤ መርሳሳ ጀላን ጅራቱ ጎዸን። <verse eid="EXO 38:4"/><verse number="5" style="v" sid="EXO 38:5"/>አከ እሳን ደንቀራወን ቀበተኒፍስ ጎሌወን ግንግልቻ ናሲ ሰና አፍረኒፍ ቁቤላወን ናሲ ሆጄተን። <verse eid="EXO 38:5"/><verse number="6" style="v" sid="EXO 38:6"/>ደንቀራወን ሙከ ላፍቶስ ቶልቸኒ ናሲ እት ኡፍሰን። <verse eid="EXO 38:6"/><verse number="7" style="v" sid="EXO 38:7"/>እዶ ኣርሳ ሰነ እቲን ባቹፍስ ደንቀራወን ሰነ ቁቤላወን ገማ ገመናን እዶ ኣርሳረ ጅረን ኬሰ ገልቸን። እዶ ኣርሳ ሰነስ ኬሰሳ ዱዋ ጎዸኒ ሳንቃራ ቶልቸን።<verse eid="EXO 38:7"/></para>
  <para style="s1">ገበቴ እት ዽቀተን</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 38:8"/>እሳንስ ገበቴ እት ዽቀተን ከን ናሲ ሚለሳ ከን ናሲራ ሆጄተሜ ወጅን ኦፍ እላሌወን ዱበርቶተ በልበለ ዱንካነ ወል ገኢ ዱረ ተጃጅለኒራ ቶልቸን።<verse eid="EXO 38:8"/></para>
  <para style="s1">ኦብዲ</para>
  <para style="r">
    <ref loc="EXO 38:9-20">38፥9‑20</ref> ኩወፈ – <char style="xt"><ref loc="EXO 27:9-19">በኡ 27፥9‑19</ref></char></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 38:9"/>ከነት ኣንሰኒ ኦብዲ ቶልቸን። ኦብድችስ ገመ ክባቲን ዹንዹመ ዽበ ቶኮ ዼረቴ ጎልጋ ቁንጬ ተልባ ከን ቀልእፈሜ ፎአሜራ ሆጄተሜስ ቀበ ቱሬ፤ <verse eid="EXO 38:9"/><verse number="10" style="v" sid="EXO 38:10"/>ኡቱባወን ድግደማፊ ሚለ ናሲ ድግደመ ቀበ ቱሬ፤ ኡቱባወን ኩኔንስ ሆኮወኒፊ ሶማወን ሜቲራ ሆጄተመን ቀቡ ቱሬ። <verse eid="EXO 38:10"/><verse number="11" style="v" sid="EXO 38:11"/>ገመ ካባቲንስ አከሱመ ዹንዹመ ዽበ ቶኮ ዼረቴ ኡቱባወን ድግደማፊ ሚለ ናሲ ድግደመ ቀበ ቱሬ፤ ኡቱባወን ሱንስ ሆኮወኒፊ ሶማወን ሜቲራ ቶልፈመን ቀቡ ቱረን።<verse eid="EXO 38:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 38:12"/>ገመ ልጣቲን ዹንዹመ ሸንተመ በልአቴ ጎልጋወን ኡቱባ ኩዸኒፊ ሚለ ኩዸን ቀበ ቱሬ፤ ሆኮወኒፊ ሶማወን ኡቱቦተ ሰናስ ሜቲራ ሆጄተመን። <verse eid="EXO 38:12"/><verse number="13" style="v" sid="EXO 38:13"/>ፊጤ በኣቲን፣ ከራ በአ ቢፍቱቲን ዹንዹመ ሸንተመ በልአተ ቱሬ። <verse eid="EXO 38:13"/><verse number="14" style="v" sid="EXO 38:14"/>ጎልጋወን ዹንዹመ ኩዸ ሸን ዼዼረተኒ ኡቱባ ሰዲፊ ሚለ ሰዲ ቀበንስ ከራ በልበለ ቶኮረ ቱረን። <verse eid="EXO 38:14"/><verse number="15" style="v" sid="EXO 38:15"/>ጎልጋወን ዹንዹመ ኩዸ ሸን ዼዼረተኒ ኡቱባ ሰዲፊ ሚለ ሰዲ ቀበንስ በልበለ ኦብዲ ሰነረ ገመ ካኒን ቱረን። <verse eid="EXO 38:15"/><verse number="16" style="v" sid="EXO 38:16"/>ጎልጋወን ናኖ ኦብዲ ሰና ሁንድ ቁንጬ ተልባ ከን ቀልዽፈሜ ፎአሜራ ቶልፈመን። <verse eid="EXO 38:16"/><verse number="17" style="v" sid="EXO 38:17"/>ሚለወን ኡቱቦተ ሰና ናሲራ ቶልፈመን። ሆኮወኒፊ ሶማወን ኡቱቦታሞ ሜቲራ ቶልፈመኒ ፊጤ ኡቱቦተ ሰናት ሜቲ ኡፍሰን። ኡቱቦን ኦብዲ ሰና ሁንድኑስ ሶማወን ሜቲ ቀቡ ቱረን።<verse eid="EXO 38:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 38:18"/>ጎልጋን በልበለ ኦብዲ ሰና ክሪ ብፈ ጩቁሊሳ፣ ዺልጌ፣ ብልዲማፊ ቁንጬ ተልባ ከን ቀልእፈሜ ፎአሜን ዸአሜረት ፋዬፈሜ ሆጄተሜ ቶልፈሜ። እንስ ዹንዹመ ድግደመ ደልገ ዼረቴ አኩመ ኦብድቻ ዹንዹመ ሸን ኦል ዼረተ ቱሬ፤ <verse eid="EXO 38:18"/><verse number="19" style="v" sid="EXO 38:19"/>ኡቱባ አፉሪፊ ሚለ ናሲ አፉርስ ቀበ ቱሬ። ሆኮወኒፊ ሶማወንሳኒ ሜቲራ ቶልፈመኒ ፊጤሳኒት ሜቲን ኡፍፈሜ ቱሬ። <verse eid="EXO 38:19"/><verse number="20" style="v" sid="EXO 38:20"/>ቆፎን ዱንካነ ቁልቁሉቲፊ ቆፎን ናኖ ኦብዲ ሰና ሁንድ ናሲራ ቶልፈመን።<verse eid="EXO 38:20"/></para>
  <para style="s1">ምአ ዱንካን እቲን ሆጄተሜ</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 38:21"/>ባይእን ምአ ዱንካን ቁልቁሉን ጄቹንስ ዱንካን ዹገ በኡምሳ እቲን ሆጄተሜ ከን ሌዎትን አጀጀ ሙሴቲን ቀጄልፈመ ኢታማር እልመ አሮን ሉብቻቲን ገልሜሰን ከናዸ። <verse eid="EXO 38:21"/><verse number="22" style="v" sid="EXO 38:22"/>ቤዘልኤል እልም ኡር ጄቹንስ እልም እልመ ሁር ነምች ጎሰ ይሁዳ ሱን ዋን <char style="nd">ዋቀዮ</char> ሙሴ አጀጄ ሁንደ ሆጄቴ። <verse eid="EXO 38:22"/><verse number="23" style="v" sid="EXO 38:23"/>ኦሆሊያብ እልም አሂሳማክ ነምች ጎሰ ዳን ሱንስ እሰ ወጅን ቱሬ፤ እንስ ኦጌሰ ሆጂ ሀርካ፣ ኦጌሰ ብፈ ባሱፊ ከን ክሪ ብፈ ጩቁሊሳ፣ ዺልጌ፣ ብልዲማፊ ቁንጬ ተልባ ከን ቀልእፈሜ ፎአሜን ዋ ፋዬሱ ቱሬ። <verse eid="EXO 38:23"/><verse number="24" style="v" sid="EXO 38:24"/>ባይእን ወርቄ ኣርሳ ሶቾፈሙ ከን ሆጂ እዶ ቁልቁሉ ሰና ሁንደረ ኦሌ ወሉማ ገለት አከ መዳሊ ሰቅሊ እዶ ቁልቁሉት ታላንቲ 29ፊ ሰቅሊ 730 ቱሬ።<verse eid="EXO 38:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 38:25"/>ሜቲን ነሞተ ወልዳ ኬሳ ለካአመንራ አርገሜስ አከ መዳሊ ሰቅሊ እዶ ቁልቁሉት ታላንቲ 100ፊ ሰቅሊ 1,775 ቱሬ። <verse eid="EXO 38:25"/><verse number="26" style="v" sid="EXO 38:26"/>ነሞትን ወረ ዱራን ለካአመኒ ጅረንት ደበለመን ከኔን ኡሙሪንሳኒ ወጋ ድግደመ ዮካን ሀመና ኦል ተኤ 603,550 ቱረን። እሳን ኩኔንስ አከ መዳሊ እዶ ቁልቁሉት መቱመ መታን ቤካ<note caller="+" style="f"><char style="fr" closed="false">38፥26 </char><char style="ft" closed="false">ቤካን ቶኮ ግራሚ 7።</char></note> ቶኮ ቶኮ ጄቹን ወለካ ሰቅሊ ቶኮ ቶኮ ባሰን። <verse eid="EXO 38:26"/><verse number="27" style="v" sid="EXO 38:27"/>ሜቲ ታላንቲ 100 ሰናን ሚለወን እዶ ቁልቁሉቲፊ ሚለወን ጎልጋቱ ሆጄተሜ፤ ታላንቲ 100ፊ ሚለ 100 ሆጄተሜ፤ ሚለ ቶኮፍ ታላንቲ ቶኮቱ በርባችሴ ጄቹዸ። <verse eid="EXO 38:27"/><verse number="28" style="v" sid="EXO 38:28"/>እሳንስ ሰቅሊ 1,775 ሰነ ሆኮ ኡቱባወኒ ቶልቹፍ፣ ፊጤ ኡቱባወኒት ኡፍሱፊ ሶማወንሳኒ ቶልቹፍ እት ፈየደመን።<verse eid="EXO 38:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 38:29"/>ናሲን ኣርሳ ሶቾፈሙስ ታላንቲ 70ፊ ሰቅሊ 2,400 ቱሬ። <verse eid="EXO 38:29"/><verse number="30" style="v" sid="EXO 38:30"/>እሰስ ሚለ በልበለ ዱንካነ ወል ገኢ፣ እዶ ኣርሳ ከን ናሲራ ሆጄተሜ፣ ግንግልቻሳ ከን ናሲራ ሆጄተሜፊ ምአሳ ሁንደ ቶልቹፍ እት ፈየደመን፤ <verse eid="EXO 38:30"/><verse number="31" style="v" sid="EXO 38:31"/>አከሱመስ ሚል ናኖ ኦብዲ፣ ሚል በልበለ ኦብዲ፣ ቆፎወን ዱንካነ ቁልቁሉ ሁንዲፊ ቆፎወን ናኖ ኦብዲ ሁንድ ናሲራ ሆጄተመን።<verse eid="EXO 38:31"/></para>
  <chapter eid="EXO 38"/>
  <chapter number="39" style="c" sid="EXO 39"/>
  <para style="s1">ኡፈተ ሉቡማ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 39:1"/>እሳንስ ኡፈተ ክሪ ብፈ ጩቁሊሳ፣ ዺልጌፊ ብልዲማን ዸአሜ ከን እዶ ቁልቁሉ ኬሰ ተጃጅሉፍ ፈየዱ ሆጄተን። አኩመ <char style="nd">ዋቀዮ</char> ሙሴ አጀጄትስ ኡፈተ ቁልቁሉ አሮኒፍ ሆጄተን።<verse eid="EXO 39:1"/></para>
  <para style="s1">ኤፉዲ</para>
  <para style="r">
    <ref loc="EXO 39:2-7">39፥2‑7</ref> ኩወፈ – <char style="xt"><ref loc="EXO 28:6-14">በኡ 28፥6‑14</ref></char></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 39:2"/>እሳንስ ወርቄፊ ክሪ ብፈ ጩቁሊሳ፣ ዺልጌ፣ ብልዲማፊ ቁንጬ ተልባ ከን ቀልእፈሜ ፎአሜን ድረተ ሆጄተን። <verse eid="EXO 39:2"/><verse number="3" style="v" sid="EXO 39:3"/>እሳንስ ክሪ ብፈ ጩቁሊሳ፣ ዺልጌ፣ ብልዲማፊ ቁንጬ ተልባ ቀልኣሳ ቶልቹፍ ጄዸኒ ወርቄ ሰነ ኦጉማ ሀርካቲን ቱመኒ አከ ባላት ሀጵሰኒ ፎኣ ፎኣት ገርገር ኩኩተን። <verse eid="EXO 39:3"/><verse number="4" style="v" sid="EXO 39:4"/>እሳንስ አከ እን ወልት ጉዱንፈሙ ደንደኡፍ ፉኞ ገቲቲ ከን ጎሌሳ ለማንት ህዸሜ ቱሬ ድረተ ሰናፍ ቶልቸን። <verse eid="EXO 39:4"/><verse number="5" style="v" sid="EXO 39:5"/>ሰበንሳ ከን ኦጉማዻን ዸአሜስ አኩመሳ ድረተ ወጅን ቶኮ ተኤ ወርቄዻን፣ ክሪ ብፈ ጩቁሊሳ፣ ዺልጌ፣ ብልዲማፊ ቁንጬ ተልባ ከን ቀልእፈሜ ፎአሜን አኩመ <char style="nd">ዋቀዮ</char> ሙሴ አጀጄት ሆጄተሜ።<verse eid="EXO 39:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 39:6"/>እሳንስ ዸጋወን ሰርዶንክሲ ቆጴሰኒ መርሳ ፋየ ወርቄ ናኖሳት ቶልቸን፤ መቃ እልማን እስራኤልስ አከ ቻፓት እሳንረት ሶፈን። <verse eid="EXO 39:6"/><verse number="7" style="v" sid="EXO 39:7"/>ኤርገሲስ አከ እልማን እስራኤሊፍ ዸጋ ያደኖ ተኡፍ አኩመ <char style="nd">ዋቀዮ</char> ሙሴ አጀጄት ዸጋወን ሰነ ፉኞ ገቲቲ ድረተ ሰነት ቀብሲሰን።<verse eid="EXO 39:7"/></para>
  <para style="s1">ኪሲ ቆማ</para>
  <para style="r">
    <ref loc="EXO 39:8-21">39፥8‑21</ref> ኩወፈ – <char style="xt"><ref loc="EXO 28:15-28">በኡ 28፥15‑28</ref></char></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 39:8"/>እሳንስ አኩመ ድረተ ሰናት ወርቄዻን፣ ክሪ ብፈ ጩቁሊሳ፣ ዺልጌ፣ ብልዲማፊ ቁንጬ ተልባ ከን ቀልእፈሜ ፎአሜን ኦጉማዻን ኪሲ ቆማ ቶልቸን። <verse eid="EXO 39:8"/><verse number="9" style="v" sid="EXO 39:9"/>ኪሲን ቆማ ኩን ገመ አፍረኒኑ ወል ቅጤ ቱሬ፤ እንስ ወልት ደቻ ተኤ ዼርነ ታኩ ቶኮፊ በልእነ ታኩ ቶኮ ቀበ ቱሬ። <verse eid="EXO 39:9"/><verse number="10" style="v" sid="EXO 39:10"/>ዸጋወን ገት ጀቤዪስ ቶረ አፉሪንረት መጠንሰን። ቶረ ጀልቀባረት ሰርድዮን፣ ቶጳዝዮኒፊ ቢረሌ፣ <verse eid="EXO 39:10"/><verse number="11" style="v" sid="EXO 39:11"/>ቶረ ለመፋረት በሉር፣ ሰንፔሪፊ አልማዝ፣ <verse eid="EXO 39:11"/><verse number="12" style="v" sid="EXO 39:12"/>ቶረ ሰደፋረት ያክንት፣ ኬልቄዶኒፊ ያክንት፣ <verse eid="EXO 39:12"/><verse number="13" style="v" sid="EXO 39:13"/>ቶረ አፉረፋረት ቢረሌ፣ ሰርዶንክሲፊ ያስጲድ መጠንሰን። ዸጋወን ከኔንትስ መርሳ ፋየ ወርቄ ቶልቸን። <verse eid="EXO 39:13"/><verse number="14" style="v" sid="EXO 39:14"/>ዸጋወን ኩዸ ለመ ከኔን ቶኮ ቶኮሳኒረት መቃ ጎሶተ ኩዸ ለመ ኬሳ መቃን ቶኮ አኩመ ቻፓት ሶፈሜ ቱረን፤ ቶኮን ቶኮን ዸጋወን ሰናስ መቃ እልማን እስራኤል ቶኮ ቶኮፍ ዻበቴ።<verse eid="EXO 39:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 39:15"/>ኪሲ ቆማቲፍስ ፎንጫ ወርቄ ቁልቁሉ አከ ፉኞት ፎአኒ ቶልቸን። <verse eid="EXO 39:15"/><verse number="16" style="v" sid="EXO 39:16"/>እሳንስ መርሳ ፋየ ወርቄ ለማፊ ቁቤላ ወርቄ ለመ ቶልቸኒ ቁቤላወን ሰነ ሮገወን ኪሲ ቆማ ኬሳ ለመት ጉዱንፈን። <verse eid="EXO 39:16"/><verse number="17" style="v" sid="EXO 39:17"/>ፎንጫ ወርቄ ሰነ ለማንስ ቁቤላወን ሮገወን ኪሲ ቆማ ሰነት ጉዱንፈን። <verse eid="EXO 39:17"/><verse number="18" style="v" sid="EXO 39:18"/>መታ ለማን ፎንጫ ለማን ሰና ካንሞ መርሳወን ፋያ ለማንት ጉዱንፈኒ ከራ ፉለ ዱራቲን ፎንጫ ድረታ ከን ገቲቲት ቀብሲሰን። <verse eid="EXO 39:18"/><verse number="19" style="v" sid="EXO 39:19"/>ቁቤላወን ወርቄ ለመ ቶልቸኒ ሮገወን ኪሲ ቆማ ብራ ከኔን ከራ ሞጋ ኬሳቲን ድረተት ኣነኒ ጅረን ለማንት ቀብሲሰን። <verse eid="EXO 39:19"/><verse number="20" style="v" sid="EXO 39:20"/>ኤርገሲስ ቁቤላወን ወርቄ ለመ ብራ ቶልቸኒ ሰበተ ሙዺቲ ኦልት ገርጀሌ ፉኞ ገቲቲ ለማን፣ ፉለ ድረታ ዱራን ጅሩ ሰናት ቀብሲሰን። <verse eid="EXO 39:20"/><verse number="21" style="v" sid="EXO 39:21"/>እሳንስ አከ ኪሲን ቆማ ድረተራ ህንሶሶቾኔፍ ቁቤላወን ኪሲ ቆማ ሰነ ሰበተ ሙዺቲን ወልት ቀብሲሰኒ አኩመ <char style="nd">ዋቀዮ</char> ሙሴ አጀጄት ፉኞ ብፈ ጩቁሊሳቲን ቁቤላወን ድረተት ቀብሲሰን።<verse eid="EXO 39:21"/></para>
  <para style="s1">ኡፈተ ሉቡማ ከን ብራ</para>
  <para style="r">
    <ref loc="EXO 39:22-31">39፥22‑31</ref> ኩወፈ – <char style="xt"><ref loc="EXO 28:31-43">በኡ 28፥31‑43</ref></char></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 39:22"/>እሳንስ ሁጩ ጉቱማን ጉቱት ብፍትሳ ጩቁሊሰ ተኤራ ወንደቦ ድረታ ቶልቸን፤ <verse eid="EXO 39:22"/><verse number="23" style="v" sid="EXO 39:23"/>ወለካ ጉባ ወንደቦ ሰናትስ አፋን እቲን መታ ሴንስፈተን ቶልቸን፤ አከ እን ህንተርሳኔፍስ ቀርቀረ አፋንሳረ ዋ ናኔሰኒ ሆዸን። <verse eid="EXO 39:23"/><verse number="24" style="v" sid="EXO 39:24"/>እሳንስ ጥዮ ወንደቦ ሰናት ክሪ ብፈ ጩቁሊሳ፣ ዺልጌ፣ ብልዲማፊ ቁንጬ ተልባ ከን ቀልእፈሜ ፎአሜን ሮማኒ ሆጄተን። <verse eid="EXO 39:24"/><verse number="25" style="v" sid="EXO 39:25"/>ወርቄ ቁልቁሉራስ ብልብለ ሆጄተኒ ሮማኖተ ግዱዻን ናኖ ጥዮ ወንደቦት ቀብሲሰን። <verse eid="EXO 39:25"/><verse number="26" style="v" sid="EXO 39:26"/>ብልብሊፊ ሮማኒን ሱን አኩመ <char style="nd">ዋቀዮ</char> ሙሴ አጀጄት ቶኮ ቶኮን ወል ኬሰ መከመኒ ናኖ ጥዮ ወንደቦ ተጃጅላፍ ኡፈተሙ ሰናት ቀብሲፈመን።<verse eid="EXO 39:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 39:27"/>አሮኒፊ እልማንሳቲፍሞ ክታ ቁንጬ ተልባ ከን ቀልእፈሜ ፎአሜን ዾፍስሰኒ ሆጄተን፤ <verse eid="EXO 39:27"/><verse number="28" style="v" sid="EXO 39:28"/>አከሱመስ ቁንጬ ተልባ ቀልኣሳቲን መረተ መታ፣ ቁንጬ ተልባቲን ጎንፎ፣ ቁንጬ ተልባ ከን ቀልእፈሜ ፎአሜንሞ ኡፈተ ወያ ጀላ ሆጄተኒፍ። <verse eid="EXO 39:28"/><verse number="29" style="v" sid="EXO 39:29"/>ሰበንስ ቁንጬ ተልባ ከን ቀልእፈሜ ፎአሜፊ ክሪ ብፈ ጩቁሊሳ፣ ዺልጌፊ ብልዲማን ፋዬፈሜ አኩመ <char style="nd">ዋቀዮ</char> ሙሴ አጀጄት ሆጄተሜ።<verse eid="EXO 39:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 39:30"/>እሳንስ ወርቄ ቁልቁሉራ ፋየ ጎንፎ ቁልቁሉ ቶልቸኒ አኩመ ዋን ቻፓረት ቅርጠሙት፦</para>
  <para style="pc" vid="EXO 39:30">ከን <char style="nd">ዋቀዮፍ</char> ቁልቁሌፈሜ፣</para>
  <para style="m" vid="EXO 39:30">ጄዸኒረት በሬሰን። <verse eid="EXO 39:30"/><verse number="31" style="v" sid="EXO 39:31"/>ኤርገሲስ ፋየ ሰነ መረተ መታቲን ወል ቀብሲሱፍ ጄዸኒ አኩመ <char style="nd">ዋቀዮ</char> ሙሴ አጀጄት ፉኞ ብፈ ጩቁሊሳ እት ህዸን።<verse eid="EXO 39:31"/></para>
  <para style="s1">ሙሴን ሆጂ ዱንካነ ቁልቁሉ ቶአቴ</para>
  <para style="r">
    <ref loc="EXO 39:32-41">39፥32‑41</ref> ኩወፈ – <char style="xt"><ref loc="EXO 35:10-19">በኡ 35፥10‑19</ref></char></para>
  <para style="p">
    <verse number="32" style="v" sid="EXO 39:32"/>አከሲን ሆጂን ዱንካነ ቁልቁሉ ከን ዱንካነ ወል ገኢ ሁንድ ጡሙረሜ። እስራኤሎንስ አኩመ <char style="nd">ዋቀዮ</char> ሙሴ አጀጄት ዋን ሁንደ ሆጄተን። <verse eid="EXO 39:32"/><verse number="33" style="v" sid="EXO 39:33"/>እሳንስ ዱንካነ ቁልቁሉ ሰነ ሙሴት ፍደን፦</para>
  <para style="b" vid="EXO 39:33"/>
  <para style="li1" vid="EXO 39:33">ዱንካናፊ ምአሳ ሁንደ፣ ሆኮወንሳ፣ ቱጌወንሳ፣ ደገሌወንሳ፣ ኡቱቦተሳቲፊ ሚለወንሳ፤<verse eid="EXO 39:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="EXO 39:34"/>እረ ቡሰ ከልኤ ኮርቤሰ ሆላ ከን ሀሉ ዲማ ጩጰሜ፣ እረ ቡሰ ጎጋ ዱገሜቲፊ ጎልጋ ደኤሱ፤<verse eid="EXO 39:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="EXO 39:35"/>ታቦተ ከኩ ሴራ፣ ደንቀራሳቲፊ ቴሶ አራራ ወጅን፤<verse eid="EXO 39:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="EXO 39:36"/>ምንጃለ ምአሳ ሁንዳፊ ቡዴነ እላልቻ ወጅን፤<verse eid="EXO 39:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="EXO 39:37"/>ባቱ እብሳ ከን ወርቄ ቁልቁሉራ ሆጄተሜ፣ እብሳወን ተሬ ገለኒፊ ምአሳ ሁንደ ወጅን፣ ዘይቲ እብሳ፤<verse eid="EXO 39:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="EXO 39:38"/>እዶ ኣርሳ ከን ወርቄራ ሆጄተሜ፣ ዘይቲ እቲን ድበን፣ እጣነ ኡርጋኡ፣ ጎልጋ በልበለ ዱንካና፤<verse eid="EXO 39:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="EXO 39:39"/>እዶ ኣርሳ ከን ናሲራ ሆጄተሜ፣ ግንግልቻሳ ከን ናሲራ ሆጄተሜ ወጅን፣</para>
  <para style="li1" vid="EXO 39:39">ደንቀራወንሳቲፊ ምአሳ ሁንደ፣ ጫቢ ሚለሳ ወጅን፤<verse eid="EXO 39:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="EXO 39:40"/>ጎልጋወን ኦብዲ ኡቱባወኒፊ ሚለወንሳኒ ወጅን፣</para>
  <para style="li1" vid="EXO 39:40">ጎልጋ ከረ ኦብዲ ሰና፣ ፉኞወኒፊ ቆፎወን ኦብዲ፣</para>
  <para style="li1" vid="EXO 39:40">ምአ ዱንካነ ቁልቁሉ ከን ዱንካነ ወል ገኢ ሁንደ፤<verse eid="EXO 39:40"/></para>
  <para style="li1">
    <verse number="41" style="v" sid="EXO 39:41"/>ወያወን ፎአመኒ ዸአመን ከኔን ዬሮ እዶ ቁልቁሉ ኬሰ ተጃጅለን ኡፈተመን፣ ጄቹንስ ወያወን አሮን ሉብቻፍ ቁልቁሌፈመኒፊ ወያወን እልማንሳ ዬሮ ሉቡማዻን ተጃጅለንት ኡፈተን ፌአ።<verse eid="EXO 39:41"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="42" style="v" sid="EXO 39:42"/>እስራኤሎንስ አኩመ <char style="nd">ዋቀዮ</char> ሙሴ አጀጄት ሆጂ ሁንደ ሆጄተን። <verse eid="EXO 39:42"/><verse number="43" style="v" sid="EXO 39:43"/>ሙሴንስ ሆጂ ሰነ ቶአቴ አኩመ <char style="nd">ዋቀዮ</char> አጀጄት ሆጄቹሳኒ አርጌ። ሙሴንስ እሳን ኤብሴ።<verse eid="EXO 39:43"/></para>
  <chapter eid="EXO 39"/>
  <chapter number="40" style="c" sid="EXO 40"/>
  <para style="s1">ዱንካነ ቁልቁሉ ዻቡ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 40:1"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን አከነ ጄዼ፦ <verse eid="EXO 40:1"/><verse number="2" style="v" sid="EXO 40:2"/>“ጉያ ጀልቀበ ጅአ ጀልቀባት ዱንካነ ቁልቁሉ ጄቹንስ ዱንካነ ወል ገኢ ዻብ። <verse eid="EXO 40:2"/><verse number="3" style="v" sid="EXO 40:3"/>ታቦተ ከኩ ሴራ እሰ ኬሰ ካኢቲ ታቦትቸ ጎልጋዻን ደኤስ። <verse eid="EXO 40:3"/><verse number="4" style="v" sid="EXO 40:4"/>ምንጃለ ኦል ገልቺቲ ምአሳ ቶቶልች። ኤርገሲስ ባቱ እብሳ ኦል ገልቺቲ እብሳሳረ ዻብ። <verse eid="EXO 40:4"/><verse number="5" style="v" sid="EXO 40:5"/>እዶ ኣርሳ እጣና ከን ወርቄራ ሆጄተሜ ፉለ ታቦተ ከኩ ሴራ ዱረ ዻቢቲ በልበለ ዱንካነ ቁልቁሉትሞ ጎልጋ ፈንስ።<verse eid="EXO 40:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 40:6"/>“እዶ ኣርሳ ቀልመ ጉበሙ ሰነስ ፉለ በልበለ ዱንካነ ቁልቁሉ ጄቹንስ ዱንካነ ወል ገኢ ዱረ ዻብ፤ <verse eid="EXO 40:6"/><verse number="7" style="v" sid="EXO 40:7"/>ገበቴ እት ዽቀተንስ ዱንካነ ወል ገኢቲፊ እዶ ኣርሳ ግዱ ዻቢቲ ብሻን እት ነቅ። <verse eid="EXO 40:7"/><verse number="8" style="v" sid="EXO 40:8"/>ናኖ እሳትስ ኦብዲ ሆጄዹቲ በልበለሳት ጎልጋ ካእ።<verse eid="EXO 40:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 40:9"/>“ዘይቲ እቲን ድበን ፉዺቲ ዱንካነ ቁልቁሉፊ ዋን እሰ ኬሰ ጅሩ ሁንደ ድብ፤ ዱንካንቻፊ ምአሳ ሁንደ ቁልቁሌስ፤ እንስ ንቁልቁላአ። <verse eid="EXO 40:9"/><verse number="10" style="v" sid="EXO 40:10"/>ኤርገሲስ እዶ ኣርሳ ቀልመ ጉበሙቲፊ ምአሳ ሁንደ ድብ፤ እዶ ኣርሳ ሰነ ቁልቁሌስ፤ እንስ ዋን ሁንደ ጫላ ቁልቁላኣ ተአ። <verse eid="EXO 40:10"/><verse number="11" style="v" sid="EXO 40:11"/>ገበቴ እት ዽቀተኒፊ ሚለሳ ድቢቲ እሳን ቁልቁሌስ።<verse eid="EXO 40:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 40:12"/>“አሮኒፊ እልማንሳ ገረ በልበለ ዱንካነ ወል ገኢት ፍዲቲ ብሻኒን እሳን ዽቅ። <verse eid="EXO 40:12"/><verse number="13" style="v" sid="EXO 40:13"/>ኤርገሲ አሮንት ወያ ቁልቁሉ ኡፍስ፤ አከ እን ሉቡማዻን ነ ተጃጅሉፍስ ድቢቲ እሰ ቁልቁሌስ። <verse eid="EXO 40:13"/><verse number="14" style="v" sid="EXO 40:14"/>እልማንሳስ ፍዲቲ ክታ እት ኡፍስ። <verse eid="EXO 40:14"/><verse number="15" style="v" sid="EXO 40:15"/>አከ እሳን ሉቡማዻን ነ ተጃጅለኒፍስ አኩመ አባሳኒ ድብዴ ሰነት እሳን ድብ፤ ድበሙንሳኒ ኩንስ ዸሎተ ዹፉ ሁንደ ኬሰት ሉቡማ እት ፉፉ ተአ።” <verse eid="EXO 40:15"/><verse number="16" style="v" sid="EXO 40:16"/>ሙሴንስ አኩመ <char style="nd">ዋቀዮ</char> እሰ አጀጄት ዋን ሁንደ ሆጄቴ።<verse eid="EXO 40:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 40:17"/>ከናፉ ዱንካን ቁልቁሉን ሱን ወጋ ለመፋ ኬሰ ጉያ ጀልቀባ ከን ጅአ ጀልቀባት ዻበሜ። <verse eid="EXO 40:17"/><verse number="18" style="v" sid="EXO 40:18"/>ሙሴን ዬሮ ዱንካነ ቁልቁሉ ሰነ ዻቤት ሚለወን ዱንካንቻ እት ካኤ፤ ቱጌወንሳ ዸዻቤ፤ ደገሌወንሳ ሎሴ፤ ኡቱቦተሳ ዸዻቤ። <verse eid="EXO 40:18"/><verse number="19" style="v" sid="EXO 40:19"/>እንስ አኩመ <char style="nd">ዋቀዮ</char> እሰ አጀጄት ዱንካነ ቁልቁሉ እራን ዱንካነ ድሪርሴ ዱንካነ ሰነትሞ እረ ቡሰ ኡፍሴ።<verse eid="EXO 40:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 40:20"/>ዹገ በኡምሰ ሰነ ፉዼ ታቦተ ኬሰ ካኤ፤ ደንቀራወንስ ታቦተት ህዼ፤ ቴሶ አራራሞ ታቦተ ጉባ ካኤ። <verse eid="EXO 40:20"/><verse number="21" style="v" sid="EXO 40:21"/>ሙሴን አኩመ <char style="nd">ዋቀዮ</char> እሰ አጀጄት ታቦተ ሰነ ዱንካነ ቁልቁሉት ኦል ገልቼ ጎልጋ ደኤሱ ፈንሴፍ፤ ታቦተ ከኩ ሴራ ሰነስ ደኤሴ።<verse eid="EXO 40:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 40:22"/>ሙሴንስ ምንጃለ ሰነ ገመ ካበ ዱንካነ ቁልቁሉቲን ዱንካነ ወል ገኢ ኬሰ ጎልጋ ሰናን አለ ካኤ። <verse eid="EXO 40:22"/><verse number="23" style="v" sid="EXO 40:23"/>አኩመ <char style="nd">ዋቀዮ</char> እሰ አጀጄትስ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ቡዴነ አችረ ካኤ።<verse eid="EXO 40:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 40:24"/>ባቱ እብሳሞ ገመ ክባ ዱንካነ ቁልቁሉቲን ዱንካነ ወል ገኢ ኬሰ ፉሌ ምንጃላቲን ካኤ። <verse eid="EXO 40:24"/><verse number="25" style="v" sid="EXO 40:25"/>አኩመ <char style="nd">ዋቀዮ</char> እሰ አጀጄትስ እብሳወን ሰነ ፉለ <char style="nd">ዋቀዮ</char> ዱረ ዸዻቤ።<verse eid="EXO 40:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 40:26"/>ሙሴንስ እዶ ኣርሳ ከን ወርቄራ ሆጄተሜ ሰነ ፉለ ጎልጋ ዱራን ዱንካነ ወል ገኢ ኬሰ ዻቤ። <verse eid="EXO 40:26"/><verse number="27" style="v" sid="EXO 40:27"/>አኩመ <char style="nd">ዋቀዮ</char> እሰ አጀጄትስ እጣነ ኡርጋኣ እሰረት ኣርሴ።<verse eid="EXO 40:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 40:28"/>በልበለ ዱንካነ ቁልቁሉረትስ ጎልጋ ፈንሴ። <verse eid="EXO 40:28"/><verse number="29" style="v" sid="EXO 40:29"/>እን አኩመ <char style="nd">ዋቀዮ</char> እሰ አጀጄት እዶ ኣርሳ ቀልመ ጉበሙ ሰነ በልበለ ዱንካነ ቁልቁሉ ከን ዱንካነ ወል ገኢ ብረ ዻቤ ቀልመ ጉበሙፊ ኬና ምዻኒ እሰረት ዽኤሴ።<verse eid="EXO 40:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 40:30"/>ገበቴ ሰነስ ዱንካነ ወል ገኢቲፊ እዶ ኣርሳ ግዱ ካኤ ብሻን ዽቀታ እት ነቄ፤ <verse eid="EXO 40:30"/><verse number="31" style="v" sid="EXO 40:31"/>ሙሴን፣ አሮኒፊ እልማን አሮኒስ ሀርከሳኒቲፊ ሚለሳኒ ዽቀቹፍ እት ፈየደሙ ቱረን። <verse eid="EXO 40:31"/><verse number="32" style="v" sid="EXO 40:32"/>እሳንስ አኩመ <char style="nd">ዋቀዮ</char> ሙሴ አጀጄት ዬሮ ዱንካነ ወል ገኢ ሴነን ዮካን ዬሮ እዶ ኣርሳት ዽኣተን ሁንደ ንዽቀቱ ቱረን።<verse eid="EXO 40:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 40:33"/>ሙሴንስ ናኖ ዱንካነ ቁልቁሉቲፊ እዶ ኣርሳት ኦብዲ ሆጄቴ በልበለ ወልተጅቻረ ጎልጋ ዻቤ፤ አከሲን ሙሴን ሆጂ ሰነ ሆጄቴ ፍጤ።<verse eid="EXO 40:33"/></para>
  <para style="s1">ኡልፍነ <char style="nd">ዋቀዮ</char></para>
  <para style="p">
    <verse number="34" style="v" sid="EXO 40:34"/>ኤርገሲስ ዱሜስ ዱንካነ ወል ገኢ ሀጉጌ፤ ኡልፍን <char style="nd">ዋቀዮስ</char> ዱንካነ ቁልቁሉ ሰነ ጉቴ። <verse eid="EXO 40:34"/><verse number="35" style="v" sid="EXO 40:35"/>ሙሴንስ ሰበቢ ዱሜስ ሱን ዱንካነ ወል ገኢረ ቡኤፊ ሰበቢ ኡልፍን <char style="nd">ዋቀዮ</char> ዱንካነ ቁልቁሉ ጉቴፍ ዱንካነ ወል ገኢ ሴኑ ህንደንዴኜ።<verse eid="EXO 40:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="EXO 40:36"/>እስራኤሎን ከራሳኒ ሁንደ ኬሰት ዮሙ ዱሜስ ዱንካነ ቁልቁሉራ ከኡ ሁንደ ከአኒ ዴምሰሳኒ እት ፉፉ ቱረን። <verse eid="EXO 40:36"/><verse number="37" style="v" sid="EXO 40:37"/>ዮ ዱሜስ እራ ከኡ ባቴ ገሩ ሀመ ጋፈ ዱሜስ ሱንራ ከኡት ህንዴመን ቱሬ። <verse eid="EXO 40:37"/><verse number="38" style="v" sid="EXO 40:38"/>ከናፉ ከራሳኒ ሁንደ ኬሰት ፉለ ሰበ እስራኤል ሁንዳ ዱረት ጉያ ጉያ ዱሜስ <char style="nd">ዋቀዮ</char> ዱንካነ ቁልቁሉረ ቱሬ፤ ሀልከን ሀልከንሞ እብድ ዱሜሰ ሰነ ኬሰ ቱሬ።<verse eid="EXO 40:38"/></para>
  <chapter eid="EXO 40"/>
</usx>
