<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JON" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">ዮናስ</para>
  <para style="toc1">ራጂ ዮናስ</para>
  <para style="toc2">ዮናስ</para>
  <para style="toc3">ዮና</para>
  <para style="mt2">ራጂ</para>
  <para style="mt1">ዮናስ</para>
  <chapter number="1" style="c" sid="JON 1"/>
  <para style="s1">ዮናስ <char style="nd">ዋቀዮ</char> ዱራ በቀቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 1:1"/>ዱቢን <char style="nd">ዋቀዮ</char> አከነ ጄዼ ገረ ዮናስ እልመ አምታይ ዹፌ፦ <verse eid="JON 1:1"/><verse number="2" style="v" sid="JON 1:2"/>“ሰበቢ ሀምንሼ ፉለኮ ዱረ ዹፌፍ፣ ገረ ነነዌ መጋላ ጉድቲ ዸቂቲ እሼዻን ሞርሙዻን እት ለለብ።”<verse eid="JON 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JON 1:3"/>ዮናስ ገሩ <char style="nd">ዋቀዮ</char> ዱራ በቀቴ ተርሺሽት ቀጄሌ። እንስ ዮጴት ገድ ቡኤ ዶኒ ገረ ተርሺሽ ዴሙ ቶኮ አርገቴ። ኤርገ ገቲ ጌጅባ ባሴ ቦዴ <char style="nd">ዋቀዮ</char> ዱራ ምልቁፍ ጄዼ ዶኒ ያበቴ ተርሺሽት እመሌ።<verse eid="JON 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JON 1:4"/>
    <char style="nd">ዋቀዮ</char> ቡቤ ጀባ ቶኮ ገላነት ኤርጌ፤ ደምበሊን አከ መሌ ጀባን ቶኮ ካናን ዶኒን ሱን ገርገር ጨጨቡ ገኤ። <verse eid="JON 1:4"/><verse number="5" style="v" sid="JON 1:5"/>ወር ዶኒ ሰነ ኦፈን ሁንድኑ አከ መሌ ሶዳተኒ ቶኮን ቶኮንሳኒ ዋቀሳኒት እየተን። እሳንስ በኣ ጥኔሱፍ ጄዸኒ ዶኒራ ፌኢሰ ገላነት ገድ ደደርበተን።</para>
  <para style="p" vid="JON 1:5">ዮናስ ገሩ ገራ ዶኒ ሴኔ ጪሴ አችት ህርብን ጉዳን እሰ ቀቤ። <verse eid="JON 1:5"/><verse number="6" style="v" sid="JON 1:6"/>አጀጃን ዶኒ ሰና ገረሳ ዹፌ፣ “አት አከም አከስ ረፉ ደንዴሰ? ከኢ ዋቀኬ ዋመዹ! ተሪ እን ኑ ዸገኤ ኑስ ዱአ ኦለ ተኣቲ” ጄዼን።<verse eid="JON 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JON 1:7"/>ወር ዶኒ ኦፈንስ፣ “ኮታ ነመ በላ ከነ ኑት ፍዴ ቤኩፍ እጣ ቡፈትናቲ” ወሊን ጄዸን። እሳን እጣ ቡፈናን እጣን ሱን ዮናስረ ቡኤ። <verse eid="JON 1:7"/><verse number="8" style="v" sid="JON 1:8"/>ከናፉ እሳን፣ “ሜ ኑት ህም፤ ነምን በላ ኑት ዹፌ ከነ ሁንዳፍ እት ጋፈተሙ ኤኙ? ሆጂንኬ ማል? አት ኤሳ ዹፍቴ? ብይኬ ኤሰ? አት ሰበ ከም ኬሳ ዸለቴ?” ጄዸኒ እሰ ጋፈተን።<verse eid="JON 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 1:9"/>እንስ፣ “አን እብርቸ <char style="nd">ዋቀዮ</char>፣ ዋቀ እሰ ሰሚ፣ ገላናፊ ለፈ ኡሜ ሰነ ዋቄፈቱዸ” ጄዼ ዴብሴ።<verse eid="JON 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 1:10"/>ወን ኩን እሳን ሶዳችስናን፣ “አት ማል ጎቴ?” ጄዸኒ እሰ ጋፈተን። እሳንስ ሰበቢ እን ዱራኑ እሳንት ህሜፍ አከ እን <char style="nd">ዋቀዮ</char> ዱራ ምልቁፍ በቀቹት ጅሩ ቤከን።<verse eid="JON 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JON 1:11"/>ገላን ሱንስ እቱመ ጫልችሴ ራፈማ ዹፌ። ከናፉ እሳን፣ “ኑ አመ ገላነ ከነ ተስገቤሱፍ ማል ስ ጎቹ ቀብነ?” ጄዸኒ እሰ ጋፈተን።<verse eid="JON 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JON 1:12"/>እንስ፣ “ኦል ነ ፉዻቲ ገላነት ነ ደርበዻ፤ ኤርገሲ ገላንች ገብ ጄዸ። አን አከ ዸኣን ገላና ሀማን ኩን ሰበቢ በሌሳኮቲቲፍ ዹፌ ነንቤከ” ጄዼ ዴብሴ።<verse eid="JON 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JON 1:13"/>ነሞትን ሱን ገሩ ቆደ ከና ዶኒ ሰነ ገረ ቀርቀራት ባሱፍ ዋን ደንደአን ሁንደ ያለን። እሳን ገሩ ገላን ሱን እቱመ ጫልችሴ ራፈማ ዋን ዹፌፍ ባሱ ህንደንዴኜ። <verse eid="JON 1:13"/><verse number="14" style="v" sid="JON 1:14"/>ከነረት እሳን፣ “ያ <char style="nd">ዋቀዮ</char>፣ አት ሰበቢ ሉቡ ነምቸ ከናቲፍ ጄቴ ኑ ህንፍጥን። ያ <char style="nd">ዋቀዮ</char> አት ዋን አኩመ ፌቴ ሆጄቴፍ የከ ሉቡ ነመ በሌሳ ህንቀብኔ አጄሱ ኑት ህንሄሬግን” ጄዸኒ ገረ <char style="nd">ዋቀዮት</char> እየተን። <verse eid="JON 1:14"/><verse number="15" style="v" sid="JON 1:15"/>አከሲን ዮናስን ፉዸኒ ዶኒራ ገድ ደርበተን፤ ገላን ራፈማ ቱሬ ሱንስ ገብ ጄዼ። <verse eid="JON 1:15"/><verse number="16" style="v" sid="JON 1:16"/>ከነረት ነሞትን ሱን አከ መሌ <char style="nd">ዋቀዮን</char> ሶዳተኒ ኣርሳ <char style="nd">ዋቀዮፍ</char> ዽኤሰን፤ ወሬገስ ወሬገኒፍ።<verse eid="JON 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JON 1:17"/>
    <char style="nd">ዋቀዮ</char> ገሩ አከ እን ዮናስን ልቅምሱፍ ቁርጡሚ ጉዳ ቶኮ ቆጴሴ፤ ዮናስስ ጉያ ሰዲፊ ሀልከን ሰዲ ገራ ቁርጡሚ ሰና ኬሰ ቱሬ።<verse eid="JON 1:17"/></para>
  <chapter eid="JON 1"/>
  <chapter number="2" style="c" sid="JON 2"/>
  <para style="s1">ከዸትና ዮናስ</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 2:1"/>ዮናስ ገራ ቁርጡሚ ኬሳ <char style="nd">ዋቀዮን</char> ዋቀሳ ከዸቴ። <verse eid="JON 2:1"/><verse number="2" style="v" sid="JON 2:2"/>እንስ አከነ ጄዼ፦</para>
  <para style="q1" vid="JON 2:2">“አን ረክነኮ ኬሰት <char style="nd">ዋቀዮን</char> ዋመዼ፤</para>
  <para style="q2" vid="JON 2:2">እንስ ዴቢ ናፍ ኬኔ።</para>
  <para style="q1" vid="JON 2:2">አን ገርጋርሰ በርባቸ ገራ ሲኦል ኬሳ ነንእዬ፤</para>
  <para style="q2" vid="JON 2:2">አትስ እየኮ ናፍ ዸጌሴ።<verse eid="JON 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JON 2:3"/>አት ቱጁበት፣</para>
  <para style="q2" vid="JON 2:3">ገራ ገላናት ገድ ነ ደርበቴ፤</para>
  <para style="q2" vid="JON 2:3">ሎላንስ ነ መርሴ፤</para>
  <para style="q1" vid="JON 2:3">ደምበሊፊ ዸኣንኬ</para>
  <para style="q2" vid="JON 2:3">ሁንድኑ ነረ ገረገለን።<verse eid="JON 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JON 2:4"/>አንስ፣ ‘ኩኖ አን ፉለኬ ዱራ በሌፈሜረ፤</para>
  <para style="q2" vid="JON 2:4">ተኡስ አን ዴብኤ ገረ መነ ቁልቁሉማኬቲ</para>
  <para style="q2" vid="JON 2:4">ቁልቁሉ ሰናን እላለ’ ነንጄዼ።<verse eid="JON 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JON 2:5"/>ብሻኖትን ነ ሀጉገን፤</para>
  <para style="q2" vid="JON 2:5">ቱጁብንሞ ነ መርሴ፤</para>
  <para style="q2" vid="JON 2:5">አረማን ገላናስ መታት ነ መረሜ።<verse eid="JON 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JON 2:6"/>አን ገረ ሁንዴ ቱሉወኒትን ገድ ልቅምፈሜ፤</para>
  <para style="q2" vid="JON 2:6">በልበል ለፈ ጀላስ በረ በራን ነት ጩፈሜ።</para>
  <para style="q1" vid="JON 2:6">ያ <char style="nd">ዋቀዮ</char> ዋቀኮ፣</para>
  <para style="q2" vid="JON 2:6">አት ገሩ ሉቡኮ ቦለ ኬሳ ኦል ባፍቴ።<verse eid="JON 2:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="JON 2:7"/>“ያ <char style="nd">ዋቀዮ</char>፣ ዬሮ ሉቡንኮ ደዸብዴት</para>
  <para style="q2" vid="JON 2:7">አን ስን ያደዼ፤</para>
  <para style="q1" vid="JON 2:7">ከዸናንኮስ ገረኬ</para>
  <para style="q2" vid="JON 2:7">ገረ መነ ቁልቁሉማኬ ቁልቁልቻት ኦል በኤ።<verse eid="JON 2:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JON 2:8"/>“ወር ዋቆተ ቶልፈሞ ፋይዳ ህንቀብኔት ጭቸን</para>
  <para style="q2" vid="JON 2:8">አራረ ዋቃራ ገረገሉ።<verse eid="JON 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JON 2:9"/>አን ገሩ ፋርፈትና ገለታቲን</para>
  <para style="q2" vid="JON 2:9">ኣርሳ ሲፍ ነንዽኤሰ።</para>
  <para style="q1" vid="JON 2:9">አን ወሬገን ወሬጌ ሰነስ ነንባሰ።</para>
  <para style="q2" vid="JON 2:9">አንስ፣ ‘ፈይን <char style="nd">ዋቀዮ</char> ብራ ዹፈ’ ” ነንጄዸ።<verse eid="JON 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 2:10"/>
    <char style="nd">ዋቀዮስ</char> ቁርጡሚ ሰነ አጀጄ፤ ቁርጡሚን ሱንስ ለፈ ጎጋረት ዮናስን ቱፌ።<verse eid="JON 2:10"/></para>
  <chapter eid="JON 2"/>
  <chapter number="3" style="c" sid="JON 3"/>
  <para style="s1">ዮናስ ነነዌ ዸቄ</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 3:1"/>ኤርገሲ ዱቢን <char style="nd">ዋቀዮ</char> አከነ ጄዼ ዬሮ ለመፋ ገረ ዮናስ ዹፌ፦ <verse eid="JON 3:1"/><verse number="2" style="v" sid="JON 3:2"/>“ገረ ነነዌ መጋላ ጉድቲ ሰና ዸቂቲ ኤርጋ አን ስት ህሙ ከነ እት ለለብ።”<verse eid="JON 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JON 3:3"/>ዮናስስ ዱቢ <char style="nd">ዋቀዮቲፍ</char> አጀጀሜ ነነዌ ዸቄ። ዬሮ ሰነት ነነዌን መጋላ አከ መሌ ጉዶ ቱርቴ፤ ኬሰ በአኒ ደርቡፍስ ጉያ ሰዲ ፉዸተ ቱሬ። <verse eid="JON 3:3"/><verse number="4" style="v" sid="JON 3:4"/>ዮናስ እመለ ጉያ ቶኮ ዴሙዻን መጋለቲት ገሌ። አከነ ጄዼስ ለለቤ፦ “ነነዌን ጉያ አፉርተመ ኬሰት ንገረገልፈምት።” <verse eid="JON 3:4"/><verse number="5" style="v" sid="JON 3:5"/>ወር ነነዌስ ዋቀት አመነን። ሶመስ ለብሰኒ ሁንድሳኒ ጥናፊ ጉዳን ኡፈተ ገዳ ኡፈተን።<verse eid="JON 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JON 3:6"/>ዮሙ ኦዱን ኩን ሞትቸ ነነዌ ገኤት እን ቴሶሳራ ከኤ ኡፈተ ሞቲ ኦፍራ ባሴ፤ ወያ ገዳስ ኡፈቴ ዳራ ኬሰ ታኤ። <verse eid="JON 3:6"/><verse number="7" style="v" sid="JON 3:7"/>ኤርገሲ አከነ ጄዼ ነነዌ ኬሰት ለብሲ ለብሴ፦</para>
  <para style="pmo" vid="JON 3:7">“አጀጅን ሞትቻቲፊ ቆንዳልቶተሳ ከናዸ፦</para>
  <para style="pm" vid="JON 3:7">አከ ነምን ዮካን ሆሪን ቶኮዩ፣ ከር ሎኒ ዮካን ቡሻዬን ዋን ቶኮዩ አፋኒን ቀቡ ህንኤየምና፤ አከ እሳን ዋ ኛተን ዮካን ዹገን ህንኤየምና። <verse eid="JON 3:7"/><verse number="8" style="v" sid="JON 3:8"/>ገሩ ነምንስ፣ ሆሪንስ ወያ ገዳ ሃኡፈተን። ነምን ሁንድኑ ደፌ ዋቀሳ ሃዋመቱ። እሳን ከራሳኒ ሀማ ሰናፊ የከ ሀርክሳኒ ሆጄቱራ ሃዴብአን። <verse eid="JON 3:8"/><verse number="9" style="v" sid="JON 3:9"/>ማልቱ ቤከ? ተሪ ዋቅን ጋቤ ገራ ኑ ላፌ ዼከምሰሳ ሶዳችሳ ሰነ ኑራ ዴብሴ፣ ኑስ በዲ ኦለ ተኣቲ።”<verse eid="JON 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 3:10"/>ዋቅንስ አከ እሳን ዋን ሀማራ ዴብአን ሆጂሳኒ አርጌ፤ ዋቅንስ ገራ ላፌፊ በላ እሳንት ኤርጉፍ ያዴ ሰነ እሳንት ፍዱ ዺሴ።<verse eid="JON 3:10"/></para>
  <chapter eid="JON 3"/>
  <chapter number="4" style="c" sid="JON 4"/>
  <para style="s1">ዮናስ ገረ ላፍነ <char style="nd">ዋቀዮት</char> ኣሬ</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 4:1"/>ወን ኩን ዮናስን ባይኤ ህንገመቺፍኔ፤ እን ንኣሬ። <verse eid="JON 4:1"/><verse number="2" style="v" sid="JON 4:2"/>አከነ ጄዼስ <char style="nd">ዋቀዮን</char> ከዸቴ፤ “ያ <char style="nd">ዋቀዮ</char> ወን አን ዬሮን ብየኮ ቱሬት ጄዼ ሱን ከኑመ ምቲ? ወን አን ተርሺሽት በቀቹፍ አሪፈዼፍስ ከነ። አን አከ አት ዋቀ አርጃፊ ገራ ላፌሰ፣ ከን ደፌ ህንኣሬፊ ከን ጃለልሳ ጉዳ ተኤ፣ ዋቀ በላ ቡሱራ ኦፍ ቁሰቱ ታቴ ነንቤከ። <verse eid="JON 4:2"/><verse number="3" style="v" sid="JON 4:3"/>ያ <char style="nd">ዋቀዮ</char> ጅራቹ መና ዱኡ ናፍ ወያቲ አመ ሉቡኮ ፉዸዹ።”<verse eid="JON 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JON 4:4"/>
    <char style="nd">ዋቀዮ</char> ገሩ፣ “አት ኣሩንኬ ስሪዻ?” ጄዼን።<verse eid="JON 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JON 4:5"/>ዮናስስ መጋለቲ ኬሳ በኤ ከራ በአ መጋለቲቲን ታኤ። እንስ አችት ዳሲ ቶኮ እጃረቴ ጋድሰሳ ጀለ ታኤ ዋን መጋለቲን ተኡፍ ጅርቱ አርጉፍ ኤጌ። <verse eid="JON 4:5"/><verse number="6" style="v" sid="JON 4:6"/><char style="nd">ዋቀዮ</char> ዋቅን ብቅልቱ ቆጴሴ አከ እን ዮናሲን ኦልት ጉደቴ መታሳረ ጋድሰ ቡሴ አከ ገድ እት ቀበናኡ ጎዼ፤ ዮናስስ ሰበቢ ብቅልቱ ሰናቲፍ ባይኤ ገመዴ። <verse eid="JON 4:6"/><verse number="7" style="v" sid="JON 4:7"/>ቦሩምታ በሪስ ዋቅን ብቅልቱን ሱን አከ ጎጉፍ ራሞ እሰ ኛቱ እት ኤርጌ። <verse eid="JON 4:7"/><verse number="8" style="v" sid="JON 4:8"/>ዬሮ ቢፍቱን ባቴትስ ዋቅን ቡቤ በአ ቢፍቱ ሆኣ ቶኮ ኤርጌ፤ አዱንስ አከ እን ገገቡፍ መታ ዮናስት ባቴ። እንስ ዱኡ በርባዴ፣ “ጅራቹ መና ዱኡ ናፍ ወየ” ጄዼ።<verse eid="JON 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 4:9"/>ዋቅን ገሩ፣ “አት ዋኤ ብቅልቱ ሰናቲፍ ኣሩንኬ ስሪዻ?” ጄዼን።</para>
  <para style="p" vid="JON 4:9">ዮናስስ፣ “ኤዬ። አን ሀመ ዱኣት ኡቱን ኣሬዩ ነንበርባደ” ጄዼ።<verse eid="JON 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 4:10"/>
    <char style="nd">ዋቀዮ</char> ገሩ አከነ ጄዼ፤ “አት ዮ ብቅልቱ ከነ ኤጉ ዮካን አከ እን ጉደቱ ጎቹ ባቴሌ ዋኤሳ ያዶፍቴርተ። ብቅልቱን ኩን ሀልከኑመ ቶኮን ጉደቴ ሀልከኑመ ቶኮን ዱኤ። <verse eid="JON 4:10"/><verse number="11" style="v" sid="JON 4:11"/>ነነዌን ገሩ ነሞተ ብታፊ ምርገሳኒዩ ገርገር ባሰኒ ህንቤክኔ ኩመ ዽበ ቶኮፊ ኩመ ድግደማፊ ሎን ሄዱ ቀብድ። አን መጋላ ጉዶ አከሲቲፍ ያዱ ህንቀቡሬ?”<verse eid="JON 4:11"/></para>
  <chapter eid="JON 4"/>
</usx>
