<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="AMO" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">አሞስ</para>
  <para style="toc1">ራጂ አሞስ</para>
  <para style="toc2">አሞስ</para>
  <para style="toc3">አሞ</para>
  <para style="mt2">ራጂ</para>
  <para style="mt1">አሞስ</para>
  <chapter number="1" style="c" sid="AMO 1"/>
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1"/>ኩን ሙልአተ አሞስ እን ትክሴወን ቴቆኣ ኬሳ ቶኮ ቱሬ ሱን በረ ኡዝያን ሞቲ ይሁዳ፣ ዬሮብኣም እልም ዮኣሽሞ ሞቲ እስራኤል ቱሬት፣ ኡቱ ሶቺን ለፋ ህንተእን ወጋ ለመ ዱረ ዋኤ እስራኤል አርጌዸ።<verse eid="AMO 1:1"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="p">
    <verse number="2" style="v" sid="AMO 1:2"/>እንስ አከነ ጄዼ፦</para>
  <para style="q1" vid="AMO 1:2">“<char style="nd">ዋቀዮ</char> ጥዮን ኬሳ እየ፤</para>
  <para style="q2" vid="AMO 1:2">ዬሩሳሌም ኬሳ ሰገሌ ዸጌስሰ፤</para>
  <para style="q1" vid="AMO 1:2">ድሬን ትክሶትን እት ቦባሰን ንጎገ፤</para>
  <para style="q2" vid="AMO 1:2">ፊጤን ጋረ ቀርሜሎስስ ንጮለገ።”<verse eid="AMO 1:2"/></para>
  <para style="s1">ሙርቲ ኦሎተ እስራኤልት ሙረሜ</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 1:3"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="AMO 1:3">“አን ጩቡ ደማስቆ ሰዲፍ፣</para>
  <para style="q2" vid="AMO 1:3">አፉሪፍስ ዼከምሰኮ ዱበት ህንዴብሱ።</para>
  <para style="q1" vid="AMO 1:3">ሰበቢ እሳን ሜሻ እቲን ምዻን ዸአን</para>
  <para style="q2" vid="AMO 1:3">ከን እልካን ስቢላ ቀቡን ግልኣድን ቱመኒፍ፣<verse eid="AMO 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 1:4"/>አን እብደ ደአትኖ ቤን-ሀዳድ</para>
  <para style="q2" vid="AMO 1:4">በርበዴሱ ቶኮ፣ መነ ሀዛኤልት ነንኤርገ።<verse eid="AMO 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 1:5"/>አን ከረ ደማስቆ ነንጨብሰ፤</para>
  <para style="q2" vid="AMO 1:5">ሞቲ ሱሉለ አዌን ኬሰ ጅሩፊ</para>
  <para style="q1" vid="AMO 1:5">እሰ ቤት ኤዴን ኬሰት ቦኩ ቀበቱ ነንበሌሰ።</para>
  <para style="q2" vid="AMO 1:5">ኡመትን ሶርያ ቦጅአሜ ቂርት ንጌፈመ”</para>
  <para style="q2" vid="AMO 1:5">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="AMO 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 1:6"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="AMO 1:6">“አን ጩቡ ጋዛ ሰዲፍ፣</para>
  <para style="q2" vid="AMO 1:6">አፉሪፍስ ዼከምሰኮ ዱበት ህንዴብሱ።</para>
  <para style="q1" vid="AMO 1:6">ሰበቢ እሼን ሀዋሰ ሁንደ ቦጅቴ</para>
  <para style="q2" vid="AMO 1:6">ኤዶምት ጉርጉረቴፍ፣<verse eid="AMO 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 1:7"/>አን እብደ ደአትኖሼ በርበዴሱ ቶኮ</para>
  <para style="q2" vid="AMO 1:7">ደላ ጋዛት ነንኤርገ።<verse eid="AMO 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 1:8"/>አን ሞቲ አሽዶዲፊ እሰ አሽቀሎን ኬሰት</para>
  <para style="q2" vid="AMO 1:8">ቦኩ ቀበቱ ሰነ ነንበሌሰ።</para>
  <para style="q1" vid="AMO 1:8">አን ሀመ ሀምባን ፍልስጤሞታ ዱኡት</para>
  <para style="q2" vid="AMO 1:8">ሀርከኮ ኤቅሮንት ነንዴብፈዸ”</para>
  <para style="q2" vid="AMO 1:8">ጄዸ <char style="nd">ዋቀዮ</char> ጎፍታን።<verse eid="AMO 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 1:9"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="AMO 1:9">“አን ጩቡ ጢሮስ ሰዲፍ፣</para>
  <para style="q2" vid="AMO 1:9">አፉሪፍስ ዼከምሰኮ ዱበት ህንዴብሱ።</para>
  <para style="q1" vid="AMO 1:9">ሰበቢ እሼን ወሊ ገልቴ ኦቦሉማ ጨብስቴ</para>
  <para style="q2" vid="AMO 1:9">ሀዋሰ ቦጅአሜ ጉቱ ኤዶምት ጉርጉረቴፍ<verse eid="AMO 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 1:10"/>አን እብደ ደአትኖሼ በርበዴሱ ቶኮ</para>
  <para style="q2" vid="AMO 1:10">ደላ ጢሮስት ነንኤርገ።”<verse eid="AMO 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 1:11"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="AMO 1:11">“አን ጩቡ ኤዶም ሰዲፍ፣</para>
  <para style="q2" vid="AMO 1:11">አፉሪፍስ ዼከምሰኮ ዱበት ህንዴብሱ።</para>
  <para style="q1" vid="AMO 1:11">ሰበቢ እን ገረ ላፍነ ሁንደ ገቴ</para>
  <para style="q2" vid="AMO 1:11">ኦቦሌሰሳ ጎራዴዻን አርኤፍ፣</para>
  <para style="q1" vid="AMO 1:11">ሰበቢ ኣሪንሳ እቱመ ፉፌ ሆኤ</para>
  <para style="q2" vid="AMO 1:11">ዼከምስሳስ ኡቱ ህንዾወምን ቦበኤፍ፣<verse eid="AMO 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 1:12"/>አን እብደ ደአትኖ ቦዝራ በርበዴሱ ቶኮ</para>
  <para style="q2" vid="AMO 1:12">ቴማንት ነንኤርገ።”<verse eid="AMO 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 1:13"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="AMO 1:13">“አን ጩቡ አሞን ሰዲፍ፣</para>
  <para style="q2" vid="AMO 1:13">አፉሪፍስ ዼከምሰኮ ዱበት ህንዴብሱ።</para>
  <para style="q1" vid="AMO 1:13">ሰበቢ እን ዳንጋሳ በበልእፈቹፍ ጄዼ</para>
  <para style="q2" vid="AMO 1:13">ዱበርቶተ ግልኣድ ከኔን ኡልፈ ቀበን በቀቅሴፍ<verse eid="AMO 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 1:14"/>አን ጉያ ሎላት ወጫን፣</para>
  <para style="q2" vid="AMO 1:14">ጉያ ቅሌንሰ ሀማትሞ ቡቤ ጀባዻን</para>
  <para style="q1" vid="AMO 1:14">እብደ ደአትኖሼ በርበዴሱ ቶኮ</para>
  <para style="q2" vid="AMO 1:14">ደላ ረባት ነንኤርገ።<verse eid="AMO 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 1:15"/>ሞቲንሼ ቦጅአሜ እኒፊ</para>
  <para style="q2" vid="AMO 1:15">ቆንዳልቶትንሳ ወጅን ንቦጅአሙ”</para>
  <para style="q2" vid="AMO 1:15">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="AMO 1:15"/></para>
  <chapter eid="AMO 1"/>
  <chapter number="2" style="c" sid="AMO 2"/>
  <para style="p">
    <verse number="1" style="v" sid="AMO 2:1"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="AMO 2:1">“አን ጩቡ ሞኣብ ሰዲፍ፣</para>
  <para style="q2" vid="AMO 2:1">አፉሪፍስ ዼከምሰኮ ዱበት ህንዴብሱ።</para>
  <para style="q1" vid="AMO 2:1">ሰበቢ እን ለፌ ሞቲ ኤዶም</para>
  <para style="q2" vid="AMO 2:1">ጉቤ ዳራ ጎዼፍ፣<verse eid="AMO 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 2:2"/>አን እብደ ደአትኖ ኬሪዮት በርበዴሱ ቶኮ</para>
  <para style="q2" vid="AMO 2:2">ሞኣብት ነንኤርገ።</para>
  <para style="q1" vid="AMO 2:2">ሞኣብ እየ ወራናቲፊ</para>
  <para style="q2" vid="AMO 2:2">ሰገሌ መለከታቲን ዱአ።<verse eid="AMO 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 2:3"/>አን ቡልቻሼ አጄሴ</para>
  <para style="q2" vid="AMO 2:3">ቆንዳልቶተሼ ሁንደስ እሰ ወጅንን ፍጠ”</para>
  <para style="q2" vid="AMO 2:3">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="AMO 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 2:4"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="AMO 2:4">“አን ጩቡ ይሁዳ ሰዲፍ፣</para>
  <para style="q2" vid="AMO 2:4">አፉሪፍስ ዼከምሰኮ ዱበት ህንዴብሱ።</para>
  <para style="q1" vid="AMO 2:4">ሰበቢ እሳን ሴረ <char style="nd">ዋቀዮ</char> ድደኒ</para>
  <para style="q2" vid="AMO 2:4">አጀጀሳስ ህንኤግኒፍ፣</para>
  <para style="q1" vid="AMO 2:4">ሰበቢ እሳን ዋቆተ ሶባ፣</para>
  <para style="q2" vid="AMO 2:4">ዋቆተ አቦቲንሳኒ ዱካ ቡአን ሰናን <optbreak/> ከራራ ጀልአተኒፍ፣<verse eid="AMO 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 2:5"/>አን እብደ ደአትኖ ዬሩሳሌም በርበዴሱ ቶኮ</para>
  <para style="q2" vid="AMO 2:5">ይሁዳት ነንኤርገ።”<verse eid="AMO 2:5"/></para>
  <para style="s1">ሙርቲ እስራኤልት ሙረሜ</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 2:6"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="AMO 2:6">“አን ጩቡ እስራኤል ሰዲፍ፣</para>
  <para style="q2" vid="AMO 2:6">አፉሪፍስ ዼከምሰኮ ዱበት ህንዴብሱ።</para>
  <para style="q1" vid="AMO 2:6">እሳን ቀጄልቶተ ሜቲት፣</para>
  <para style="q2" vid="AMO 2:6">ረከቶተሞ ኮጴ ጭምዲ ቶኮት ጉርጉረተን።<verse eid="AMO 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 2:7"/>እሳን አኩመ ብዮ ለፋት</para>
  <para style="q2" vid="AMO 2:7">መታ ህዬዪረ እጃጀኒ</para>
  <para style="q2" vid="AMO 2:7">ጩንቁርፈማስ ሙርቲ ቀጄላ ዾወተን።</para>
  <para style="q1" vid="AMO 2:7">አባፊ እልም ዱርበ ቶኮት ገለኒ</para>
  <para style="q2" vid="AMO 2:7">አከሲን መቃኮ ቁልቁሉ ጡሬሰን።<verse eid="AMO 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 2:8"/>እሳን ኡፈተ ቀብዲዻን ነመራ</para>
  <para style="q2" vid="AMO 2:8">ፉዸተን እረ እዶ ኣርሳ ሁንደ ብረ ጭጪሰን።</para>
  <para style="q1" vid="AMO 2:8">እሳን ዳዺ ወይኒ ከን ወረ አደበመን ብራ ዹፌ፣</para>
  <para style="q2" vid="AMO 2:8">መነ ዋቀሳኒ ኬሰት ዹጉ።<verse eid="AMO 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 2:9"/>“እን አኩመ ብርብርሳ ዼረቴ</para>
  <para style="q2" vid="AMO 2:9">አከ ቅልጡ ጀባቱዩ፣</para>
  <para style="q2" vid="AMO 2:9">አን ነምቸ አሞር ሰነ ፉለሳኒ ዱረት ገላፈዼረ።</para>
  <para style="q1" vid="AMO 2:9">አን ጉባዻ እጀሳ፣</para>
  <para style="q2" vid="AMO 2:9">ጀላንሞ ህደሳ በሌሴረ።<verse eid="AMO 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 2:10"/>“አን ብየ አሞሮታ እስኒፍ ኬኑፍ ጄዼ፣</para>
  <para style="q2" vid="AMO 2:10">ብየ ግብጢቲ እስን ባሴ</para>
  <para style="q2" vid="AMO 2:10">ወጋ አፉርተመ ገሞጂ ኬሰ እስነን ጌጌሴ።<verse eid="AMO 2:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 2:11"/>“አከሱመስ አን እልማንኬሰን ግዱዻ ራጆተ፣</para>
  <para style="q2" vid="AMO 2:11">ደርገጎተኬሰን ግዱዻሞ ናዝሮተ ካሴረ።</para>
  <para style="q1" vid="AMO 2:11">ያ ሰበ እስራኤል፣ ወን ኩን ዹጉመ ምቲ?”</para>
  <para style="q2" vid="AMO 2:11">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="AMO 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 2:12"/>“እስን ገሩ ናዝሮተ ዳዺ ወይኒ ኦባፍተኒ</para>
  <para style="q2" vid="AMO 2:12">አከ ራጆትንስ ራጂ ህንዱበትኔ አጀጀን።<verse eid="AMO 2:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 2:13"/>“አን አኩመ ጋሪን ዮሙ ምዻኒን ጉተሙ ጨጨቡ ሰነ፣</para>
  <para style="q2" vid="AMO 2:13">አመ እስነን ጨጨብሰ።<verse eid="AMO 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 2:14"/>ሰፍሳን ህንምልቁ፤</para>
  <para style="q2" vid="AMO 2:14">ነሞትን ጀጀቦን ሁምነሳኒ ህንጀቤፈተን፤</para>
  <para style="q2" vid="AMO 2:14">ሎልቱንስ ሉቡሳ ህንኦልፈቱ።<verse eid="AMO 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 2:15"/>አባን ጥያ ጀባቴ ዻበቹ ህንደንደኡ፤</para>
  <para style="q2" vid="AMO 2:15">ሎልቱን ሰፍሳን ፊጌ ጀላ ህንበኡ፤</para>
  <para style="q2" vid="AMO 2:15">አባን ፈርዳስ ሉቡሳ ኦልፈቹ ህንደንደኡ።<verse eid="AMO 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="AMO 2:16"/>ሎልቶትን አከ መሌ ጀጀቦንዩ</para>
  <para style="q2" vid="AMO 2:16">ጋፈስ ቁላሳኒ በቀቱ”</para>
  <para style="q2" vid="AMO 2:16">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="AMO 2:16"/></para>
  <chapter eid="AMO 2"/>
  <chapter number="3" style="c" sid="AMO 3"/>
  <para style="s1">ዹገ ባቶተ እስራኤልት ዹጋ በአን</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1"/>ያ ሰበ እስራኤል፣ ዱቢ <char style="nd">ዋቀዮ</char> እስኒን ሞርሙዻን፣ ማቲ አን ብየ ግብጢ ባሴ ፍዴ ሁንዳን ሞርሙዻን ዱበቴ ከነ ዸገኣ፦<verse eid="AMO 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 3:2"/>“አን ማቲወን ለፈረ ጅራተን</para>
  <para style="q2" vid="AMO 3:2">ሁንደ ኬሳ እስን ቆፈ ፍለዼረ፤</para>
  <para style="q1" vid="AMO 3:2">ከናፉ አን ጩቡኬሰን</para>
  <para style="q2" vid="AMO 3:2">ሁንዳፍ እስነን አደበ።”<verse eid="AMO 3:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 3:3"/>ዮ ወሊ ገለን መሌ</para>
  <para style="q2" vid="AMO 3:3">ነሞትን ለመ ወጅን ንዴሙ?<verse eid="AMO 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 3:4"/>ሌንጭ ቶኮ ዮ ዋን አደምሱ ህንአርገትን</para>
  <para style="q2" vid="AMO 3:4">ቦሶነ ኬሳ ንኣዳ?</para>
  <para style="q1" vid="AMO 3:4">እን ዮ ዋ ቀበቴ መሌ</para>
  <para style="q2" vid="AMO 3:4">ሆልቀሳ ኬሳ ንኣዳ?<verse eid="AMO 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 3:5"/>ስምብር ቶኮ ለፈ ክዮን ህንካአምንት</para>
  <para style="q2" vid="AMO 3:5">ክዮ ኬሰ ንሴንቲ?</para>
  <para style="q1" vid="AMO 3:5">ክዮን ቶኮ ዮ ወን ቀበሙ ህንጅሬ</para>
  <para style="q2" vid="AMO 3:5">አከሱመት ለፋ ንኡታላ?<verse eid="AMO 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 3:6"/>ዮ መጋላ ኬሰት መለከትን አፉፈሜ፣</para>
  <para style="q2" vid="AMO 3:6">ነሞትን ህንራፈመኒ?</para>
  <para style="q1" vid="AMO 3:6">በላን መጋላ ቶኮት ዮ ዹፌ፣</para>
  <para style="q2" vid="AMO 3:6">
    <char style="nd">ዋቀዮቱ</char> ዋን ሰነ ፍዴ ምቲ?<verse eid="AMO 3:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 3:7"/>ዹጉማን <char style="nd">ዋቀዮ</char> ጎፍታን</para>
  <para style="q2" vid="AMO 3:7">ኡቱ ተጃጅልቶተሳ ራጆተት ህንሙልእስን</para>
  <para style="q2" vid="AMO 3:7">ዋን ቶኮሌ ህንሆጄቱ።<verse eid="AMO 3:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 3:8"/>ሌንጭ ኣዴረ፤</para>
  <para style="q2" vid="AMO 3:8">ኤኙቱ ህንሶዳትኔሬ?</para>
  <para style="q1" vid="AMO 3:8">
    <char style="nd">ዋቀዮ</char> ጎፍታን ዱበቴረ፤</para>
  <para style="q2" vid="AMO 3:8">ዮስ ኤኙቱ ራጂ ህንዱበትኔሬ?<verse eid="AMO 3:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 3:9"/>ደአትኖ አሽዶዲቲፊ</para>
  <para style="q2" vid="AMO 3:9">ደአትኖ ግብጥት አከነ ጄዻ ለብሳ፦</para>
  <para style="q1" vid="AMO 3:9">“ቱሉወን ሰማርያረት ወልት ቀበማ፤</para>
  <para style="q2" vid="AMO 3:9">ጄቁምሰ ጉዳ እሼ ኬሰ ጅሩፊ</para>
  <para style="q2" vid="AMO 3:9">ጩንቁርሳ ኡመተሼ ኬሰ ጅሩ እላላ።”<verse eid="AMO 3:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 3:10"/>“ወር ደአትኖሳኒ ኬሰት ዋን ቦጅአሜፊ <optbreak/> ዋን ሳመሜ ኩፈተን</para>
  <para style="q2" vid="AMO 3:10">አከ እት ዋን ቀጄላ ሆጄተን ህንቤከን”</para>
  <para style="q2" vid="AMO 3:10">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="AMO 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 3:11"/>ከናፉ <char style="nd">ዋቀዮ</char> ጎፍታን አከነ ጄዸ፦</para>
  <para style="q1" vid="AMO 3:11">“ዲን ብየኬሰን መርሰ፤</para>
  <para style="q2" vid="AMO 3:11">ጀብነኬሰን ገድ ቡሰ፤</para>
  <para style="q2" vid="AMO 3:11">ደአኖወንኬሰንስ ንሳመ።”<verse eid="AMO 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 3:12"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="AMO 3:12">“አኩመ ትክሴን ቶኮ ለፌ ሚለ ለማኒ</para>
  <para style="q2" vid="AMO 3:12">ዮካን ፊጤ ጉራ ቆፈ አፋን ሌንጫቲ ቡሱ ሰነ፣</para>
  <para style="q1" vid="AMO 3:12">እስራኤሎን ሰማርያ ኬሰ፣ ቀርቀረ ስሬሳኒረ፣</para>
  <para style="q2" vid="AMO 3:12">ደማስቆ ኬሰስ ስሬሳኒ ድንኪረ ታአን</para>
  <para style="q2" vid="AMO 3:12">አከሱመ ንበራረሙ።”<verse eid="AMO 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 3:13"/>“ዋን ከነ ዸገኣቲ መነ ያቆብት ዹጋ በኣ” ጄዸ ጎፍታን፣ <char style="nd">ዋቀዮ</char> ዋቅን ዋን ሁንደ ደንደኡ።<verse eid="AMO 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 3:14"/>“ጉያ አን ጩቡ እሼቲፍ ጄዼ እስራኤልን አደቡት፣</para>
  <para style="q2" vid="AMO 3:14">እዶወን ኣርሳ ቤትኤል ነንበርበዴሰ፤</para>
  <para style="q1" vid="AMO 3:14">ጋንፈወን እዶ ኣርሳስ ጨጨበኒ</para>
  <para style="q2" vid="AMO 3:14">ለፈት ንሀርጨኡ።<verse eid="AMO 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 3:15"/>አን መነ ገናቲፊ</para>
  <para style="q2" vid="AMO 3:15">መነ ቦና ነንዲገ፤</para>
  <para style="q1" vid="AMO 3:15">መኔን እልከ አርባቲን ሚዸግፈመን ንዲገሙ፤</para>
  <para style="q2" vid="AMO 3:15">መኔን ጉርጉዳንስ ንበሌፈሙ”</para>
  <para style="q2" vid="AMO 3:15">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="AMO 3:15"/></para>
  <chapter eid="AMO 3"/>
  <chapter number="4" style="c" sid="AMO 4"/>
  <para style="s1">እስራኤል ገረ ዋቃት ህንዴብኔ</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 4:1"/>እስን ያ ሳወን ባሻን ከኔን ቱሉ ሰማርያረ ጅርተን፣</para>
  <para style="q2" vid="AMO 4:1">ያ ዱበርቶተ፣ እስን ወር ህዬዪፊ ረከቶተ ጩንቁርስተኒ</para>
  <para style="q2" vid="AMO 4:1">ዽርሶተኬሰኒን፣ “ዹጋቲ ኑፍ ፍዳ!” ጄተን <optbreak/> ዱቢ ከነ ዸገኣ።<verse eid="AMO 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 4:2"/>
    <char style="nd">ዋቀዮ</char> ጎፍታን አከነ ጄዼ <optbreak/> ቁልቁሉማሳቲን ከከቴረ፦</para>
  <para style="q2" vid="AMO 4:2">“ዬሮን እስን እት ሆኮዻን፣</para>
  <para style="q1" vid="AMO 4:2">እስን ኬሳ ነምን ዹማሞ ቀብዱ ቁርጡሚቲን</para>
  <para style="q2" vid="AMO 4:2">ቀበሙ ቶኮ ዹጉማን ንዹፈ።<verse eid="AMO 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 4:3"/>እስን ቶኮ ቶኮን ቀጄልተኒ</para>
  <para style="q2" vid="AMO 4:3">ቃወ ደላቲን ንባቱ፤</para>
  <para style="q1" vid="AMO 4:3">ገረ ሀርሞንትስ ንደርበተምቱ”</para>
  <para style="q2" vid="AMO 4:3">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="AMO 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 4:4"/>“ቤትኤል ዸቃቲ ጩቡ ሆጄዻ፤</para>
  <para style="q2" vid="AMO 4:4">ግልጋል ዸቃቲ ጩቡ ባይኤ ሆጄዻ።</para>
  <para style="q1" vid="AMO 4:4">ገነመ ገነመ ኣርሳኬሰን ዽኤሳ፤</para>
  <para style="q2" vid="AMO 4:4">ወጋ ሰዲ ሰዲትሞ ኬናኬሰን ሀርከ ኩዸን ኬሳ <optbreak/> ሀርከ ቶኮ ፍዳ።<verse eid="AMO 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 4:5"/>ቡዴነ ራጭቲ ቀቡ ኣርሳ ገለታ ጎዻቲ ጉባ፤</para>
  <para style="q2" vid="AMO 4:5">ኣርሳ ፌዺዻን ኬንተን ለብሳ፤ ቤክስሳስ፤</para>
  <para style="q1" vid="AMO 4:5">ያ እስራኤሎተ፣ ወን እስን ሆጄቹ ጃለተን ከናቲ፣</para>
  <para style="q2" vid="AMO 4:5">እቲን ቦና”</para>
  <para style="q2" vid="AMO 4:5">ጄዸ <char style="nd">ዋቀዮ</char> ጎፍታን።<verse eid="AMO 4:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 4:6"/>“አን መጋላ ሁንደ ኬሰት ገራ ዱዋ እስኒፍ ኬኔረ፤</para>
  <para style="q2" vid="AMO 4:6">መጋላ ሁንደ ኬሰትስ ቡዴነ እስን ዸብሲሴረ፤</para>
  <para style="q1" vid="AMO 4:6">እስን ገሩ ገረኮት ህንዴብኔ”</para>
  <para style="q2" vid="AMO 4:6">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="AMO 4:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 4:7"/>“አን ዬሮ ምዻን ሃመሙፍ ጅእ ሰዲ ሀፉት</para>
  <para style="q2" vid="AMO 4:7">ቦካ እስንራ ነንኩቴ።</para>
  <para style="q1" vid="AMO 4:7">አን መጋላ ቶኮት ቦካ ኤርጌ</para>
  <para style="q2" vid="AMO 4:7">ካንራሞ ነንዻቤ።</para>
  <para style="q1" vid="AMO 4:7">ለፍት ቆትና ቶኮ ቦካ አርገቴ</para>
  <para style="q2" vid="AMO 4:7">ካን ገሩ ሆማ ዸቤ ጎጌ።<verse eid="AMO 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 4:8"/>ኡመትን ብሻን በርባቸ መጋላዻ ገረ መጋላት ጆሬ፤</para>
  <para style="q2" vid="AMO 4:8">ገሩ ዋን ዹጋቲፍ እሰ ገኡ ህንአርገትኔ፤</para>
  <para style="q1" vid="AMO 4:8">ተኡስ እስን ገረኮት ህንዴብኔ”</para>
  <para style="q2" vid="AMO 4:8">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="AMO 4:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 4:9"/>“አን ዬሮ ሄዱ እዶ ብቅልቱቲፊ</para>
  <para style="q2" vid="AMO 4:9">ወይኒኬሰን ዋጊፊ አዋሮዻን ዸኤን በሌሴ።</para>
  <para style="q1" vid="AMO 4:9">ሀዋንስን ሀርቡፊ ኤጄርሰኬሰን በርበዴሴ፤</para>
  <para style="q2" vid="AMO 4:9">ተኡስ እስን ገረኮት ህንዴብኔ”</para>
  <para style="q2" vid="AMO 4:9">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="AMO 4:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 4:10"/>“አን አኩመን ብየ ግብጥ ጎዼ ሰነ</para>
  <para style="q2" vid="AMO 4:10">ዸእቸ እስንት ነንኤርጌ።</para>
  <para style="q1" vid="AMO 4:10">አን ፈርዴን እስን ቦጅተን ወጅን</para>
  <para style="q2" vid="AMO 4:10">ደርገጎተኬሰን ጎራዴዻን ነንፍጤ።</para>
  <para style="q1" vid="AMO 4:10">አጃ ቁበተኬሰኒቲን ፉኛንኬሰን ነንጉቴ፤</para>
  <para style="q2" vid="AMO 4:10">እስን ገሩ ገረኮት ህንዴብኔ”</para>
  <para style="q2" vid="AMO 4:10">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="AMO 4:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 4:11"/>“አን አኩመን ሶዶሚፊ ጎሞራ ገረገልቼ ሰነ</para>
  <para style="q2" vid="AMO 4:11">እስን ኬሳ ነመ ቶኮ ቶኮ ገረገልቼረ።</para>
  <para style="q1" vid="AMO 4:11">እስን አኩመ ሙከ ቦበኡ ከን እብደ ኬሳ ቡተሜት፤</para>
  <para style="q2" vid="AMO 4:11">ተኡስ እስን ገረኮት ህንዴብኔ”</para>
  <para style="q2" vid="AMO 4:11">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="AMO 4:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 4:12"/>“ከናፉ ያ እስራኤል፣ አን አከነን እስን ጎዸ፤</para>
  <para style="q2" vid="AMO 4:12">ሰበቢ አን አከነ እስን ጎዹፍ</para>
  <para style="q2" vid="AMO 4:12">ያ እስራኤል ዋቀኬ አርጉፍ ቆጳእ።”<verse eid="AMO 4:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 4:13"/>እን ቱሉወን ቶልቼ</para>
  <para style="q2" vid="AMO 4:13">ቡቤ ኡሜ ያደሳ ነመት ሙልእሱ ሱን፣</para>
  <para style="q1" vid="AMO 4:13">እን በሪ ዱከኔሴ</para>
  <para style="q2" vid="AMO 4:13">እዶወን ለፈ ኦል ከኦረ ኤጄቱ ሱን፣</para>
  <para style="q2" vid="AMO 4:13">መቃንሳ <char style="nd">ዋቀዮ</char>፣ <optbreak/> ዋቀ ዋን ሁንደ ደንደኡዸ።<verse eid="AMO 4:13"/></para>
  <chapter eid="AMO 4"/>
  <chapter number="5" style="c" sid="AMO 5"/>
  <para style="s1">ፋሩ ቦእቻቲፊ ዋምቸ ቀልቢ ጅጂረቹ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 5:1"/>ያ መነ እስራኤል ዱቢ ከነ፣ ፋሩ ቦእቻ ከን አን ዋኤኬሰኒፍ ቦኡ ከነ ዸገኣ፦<verse eid="AMO 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 5:2"/>“ዱርብ ቁልቁልቲን እስራኤል ኩፍቴርት፤</para>
  <para style="q2" vid="AMO 5:2">እሼን ለመተ ህንካቱ፤</para>
  <para style="q1" vid="AMO 5:2">ብዩመሼ ኬሰት ገተምቴ</para>
  <para style="q2" vid="AMO 5:2">ነመ ኦል እሼ ቀቡ ቶኮሌ ዸብዴ።”<verse eid="AMO 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 5:3"/>
    <char style="nd">ዋቀዮ</char> ጎፍታን አከነ ጄዸ፦</para>
  <para style="q1" vid="AMO 5:3">“መጋላ ሎልቶተ ኩመ ቶኮ እስራኤሊፍ ቦባፍቴፍ</para>
  <para style="q2" vid="AMO 5:3">ዽበ ቶኮ ቆፈቱ ሀፈ፤</para>
  <para style="q1" vid="AMO 5:3">መጋላ ሎልቶተ ዽበ ቶኮ ቦባፍቴፍ</para>
  <para style="q2" vid="AMO 5:3">ኩዸን ቆፈቱ ሀፈ።”<verse eid="AMO 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 5:4"/>
    <char style="nd">ዋቀዮ</char> መነ እስራኤሊን አከነ ጄዸ፦</para>
  <para style="q1" vid="AMO 5:4">“ነ በርባደዻቲ ጅራዻ፤<verse eid="AMO 5:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="AMO 5:5"/>ቤትኤልን ህንበርባደትና፤</para>
  <para style="q1" vid="AMO 5:5">ግልጋል ህንዸቅና፤</para>
  <para style="q2" vid="AMO 5:5">ቤርሼባትስ ህንጬእና።</para>
  <para style="q1" vid="AMO 5:5">ግልጋል ዹጉማን ንቦጅአምት፤</para>
  <para style="q2" vid="AMO 5:5">ቤትኤልስ ንዸበምት።”<verse eid="AMO 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 5:6"/>
    <char style="nd">ዋቀዮን</char> በርባደዻቲ ጅራዻ፤</para>
  <para style="q2" vid="AMO 5:6">ዮ ከና አቺ እን አኩመ እብዳ <optbreak/> መነ ዮሴፍ ኬሰ በኤ ሀጣኣ፤</para>
  <para style="q1" vid="AMO 5:6">እብድ ሱን እሼ ጉበ፤</para>
  <para style="q2" vid="AMO 5:6">ቤትኤልስ ነመ እራ ዻምሱ ቶኮዩ <optbreak/> ህንቀባቱ።<verse eid="AMO 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 5:7"/>እስን ወረ ሙርቲ ቀጄላ ሀዻት ጌደርተኒ</para>
  <para style="q2" vid="AMO 5:7">ቀጄሉማስ ለፈት ሀርጫፍተኒዸ።<verse eid="AMO 5:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 5:8"/>እን ኡርጂወን ቶርቢፊ ኡርጂወን ሰዴ ኡሜ፣</para>
  <para style="q2" vid="AMO 5:8">ከን ዱከነ በሪት ጌደሩ፣</para>
  <para style="q2" vid="AMO 5:8">እን ጉያ ዱከኔሴ ሀልከን ጎዹ፣</para>
  <para style="q1" vid="AMO 5:8">ከን ገላነ ኬሳ ብሻን ኦል ዋሜ</para>
  <para style="q2" vid="AMO 5:8">ፉለ ለፈ ጎጋረት ዸንገላሱ</para>
  <para style="q2" vid="AMO 5:8">መቃንሳ <char style="nd">ዋቀዮዸ</char>።<verse eid="AMO 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 5:9"/>እን ደኦ ጀባት በዲሰ ተሳ ፍደ፤</para>
  <para style="q2" vid="AMO 5:9">መጋላ ደላ ጀባ ቀብዱስ ንበርበዴሰ።<verse eid="AMO 5:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 5:10"/>እሳን ነመ ከረረት ነመ እፈቱ ንጅቡ፤</para>
  <para style="q2" vid="AMO 5:10">ከን ዹጋ ዱበቱስ ንበልፉ።<verse eid="AMO 5:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 5:11"/>እስን ህዬዪ ዽዺተኒ</para>
  <para style="q2" vid="AMO 5:11">አከ እሳን ምዻን እስኒ ኬነን ድርቅሲፍቱ።</para>
  <para style="q1" vid="AMO 5:11">ከናፉ እስን መኔን ዸጋ ዮ እጃረተንዩ</para>
  <para style="q2" vid="AMO 5:11">መኔን ሰነ ኬሰ ህንጅራተን፤</para>
  <para style="q1" vid="AMO 5:11">እስን እዶወን ቆቲሳ ጋሪ ኬሰ ወይኒ ዮ ዻበተንዩ</para>
  <para style="q2" vid="AMO 5:11">ዳዺ ወይኒሳኒ ህንዹግደን።<verse eid="AMO 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 5:12"/>በሌሳንኬሰን ሀመም አከ ባይአቱፊ</para>
  <para style="q2" vid="AMO 5:12">ጩቡንኬሰንስ ሀመም ጉዳ አከ ተኤ ነንቤካቲ።</para>
  <para style="b" vid="AMO 5:12"/>
  <para style="q1" vid="AMO 5:12">እሳን ቀጄልቶተ ሀጩጨኒ መተኣ እራ ፉዸቱ፤</para>
  <para style="q2" vid="AMO 5:12">ህዬዪስ መነ ሙርቲ ኬሰት ሙርቲ ቀጄላ ዾወቱ።<verse eid="AMO 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 5:13"/>ከናፉ ነምን ቀልቤፈታን ዬሮ አከሲት አፋን ቀበተ፤</para>
  <para style="q2" vid="AMO 5:13">በር ኩን በረ ሀማዻቲ።<verse eid="AMO 5:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 5:14"/>አከ ሉቡዻን ጅራተኒፍ</para>
  <para style="q2" vid="AMO 5:14">ዋን ሀማ ዺሳቲ ዋን ጋሪ በርባዳ።</para>
  <para style="q1" vid="AMO 5:14">ዮስ አኩመ እስን ጄተን ሰነ</para>
  <para style="q2" vid="AMO 5:14">
    <char style="nd">ዋቀዮ</char> ዋቅን ዋን ሁንደ ደንደኡ እስን ወጅን ተአ።<verse eid="AMO 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 5:15"/>ዋን ሀማ ጅባ፤ ዋን ጋሪ ጃለዻ፤</para>
  <para style="q2" vid="AMO 5:15">መነ ሙርቲ ኬሰት ሙርቲ ቀጄላ ጀቤሳ፤</para>
  <para style="q1" vid="AMO 5:15">
    <char style="nd">ዋቀዮ</char> ዋቅን ዋን ሁንደ ደንደኡ</para>
  <para style="q2" vid="AMO 5:15">ተሪ ሀምባ ዮሴፊፍ ገራ ላፈ ተኣቲ።<verse eid="AMO 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="AMO 5:16"/>ከናፉ ጎፍታን፣ <char style="nd">ዋቀዮ</char> ዋቅን ዋን ሁንደ ደንደኡ አከነ ጄዸ፦</para>
  <para style="q1" vid="AMO 5:16">“ዳንዲ ሁንደረ ቦእቸ፣</para>
  <para style="q2" vid="AMO 5:16">ኦብዲ ኡመታ ሁንደረሞ እየ ዽጵናቱ ጅረ።</para>
  <para style="q1" vid="AMO 5:16">ቆናን ቡልቶትን አከ ቦአኒፍ፣</para>
  <para style="q2" vid="AMO 5:16">ወር ቦአንሞ አከ ወዋተኒፍ ንዋመሙ።<verse eid="AMO 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="AMO 5:17"/>አን ግዱኬሰን ዋነን ደርቡፍ</para>
  <para style="q2" vid="AMO 5:17">እዶ ዻባ ወይኒ ሁንደ ኬሳ ቦእቸቱ ተአ”</para>
  <para style="q2" vid="AMO 5:17">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="AMO 5:17"/></para>
  <para style="s1">ጉያ <char style="nd">ዋቀዮ</char></para>
  <para style="q1">
    <verse number="18" style="v" sid="AMO 5:18"/>እስን ወረ ጉያ <char style="nd">ዋቀዮ</char></para>
  <para style="q2" vid="AMO 5:18">አርጉ ሀዊተኒፍ ወዮ!</para>
  <para style="q1" vid="AMO 5:18">እስን ማሊፍ ጉያ <char style="nd">ዋቀዮ</char> አርጉ ሀውቱ!</para>
  <para style="q2" vid="AMO 5:18">ጉያን ሱን ዱከነ መሌ እፈ ህንተኡቲ።<verse eid="AMO 5:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="AMO 5:19"/>ወን ኩን አኩመ ነመ ሌንጨ ጀላ በኤ</para>
  <para style="q2" vid="AMO 5:19">አፋን አማኬታ ቡኡ ቶኮት፤</para>
  <para style="q1" vid="AMO 5:19">ዮካን አከ ነመ መነሳ ሴኔ</para>
  <para style="q2" vid="AMO 5:19">ሀርከሳ ኬኘን መናረ ካአቴ</para>
  <para style="q2" vid="AMO 5:19">ቦፍት እሰ እዴ ቶኮት።<verse eid="AMO 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="AMO 5:20"/>ጉያን <char style="nd">ዋቀዮ</char> እፈ ኡቱ ህንተእን ዱከነ ምቲ?</para>
  <para style="q2" vid="AMO 5:20">ዱከነ ሀማ እፈ ቶኮሌ ኦፍ ኬሳ ህንቀብኔ ምቲ?<verse eid="AMO 5:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="AMO 5:21"/>“አን አያነ አመንታኬሰኒ ነንጅበ፤ ነንቱፈዸስ፤</para>
  <para style="q2" vid="AMO 5:21">ወልዳኬሰንትስ ህንገመዱ።<verse eid="AMO 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="AMO 5:22"/>ኡቱ እስን ኣርሳ ጉበሙፊ ኬና ምዻኒ ና ፍደኒዩ</para>
  <para style="q2" vid="AMO 5:22">አን ጃለዼ እስንራ ህንፉዸዹ።</para>
  <para style="q1" vid="AMO 5:22">ኡቱ እስን ኣርሳ ነጋ ፍለተማ ና ፍደኒዩ</para>
  <para style="q2" vid="AMO 5:22">አን ሆማቱ እሰ ህንለካኡ።<verse eid="AMO 5:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="AMO 5:23"/>ወጨ ፋርፈትናኬሰኒ አሲ በሌሳ!</para>
  <para style="q2" vid="AMO 5:23">አን ሙዚቃ በገናኬሰኒ ህንዸጌፈዹ።<verse eid="AMO 5:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="AMO 5:24"/>ገሩ ሙርቲን ቀጄላን አኩመ ለጋ፣</para>
  <para style="q2" vid="AMO 5:24">ቀጄሉማንስ አኩመ ቡርቃ ህንጎግኔ ሃያኡ!<verse eid="AMO 5:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="AMO 5:25"/>“ያ መነ እስራኤል እስን ወጋ አፉርተመ</para>
  <para style="q2" vid="AMO 5:25">ገሞጂ ኬሰት ተኩማ ኣርሳፊ ኬና ና ፍደኒርቱ?<verse eid="AMO 5:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="AMO 5:26"/>እስን ዋን ሀርኩመኬሰኒን ቶልፈተን</para>
  <para style="q2" vid="AMO 5:26">ጄቹንስ ገልመ ዋቄፈትና ሞቲኬሰኒ፣</para>
  <para style="q2" vid="AMO 5:26">ኡቱባ ዋቀኬሰን ቶልፈማቲፊ</para>
  <para style="q2" vid="AMO 5:26">ፈኪ ኡርጂ ዋቀኬሰኒ ኦል ፉተኒርቱ።<verse eid="AMO 5:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="AMO 5:27"/>ከናፉ አን አከ እስን ቦጅአምተኒፍ፣</para>
  <para style="q2" vid="AMO 5:27">ደማስቆዻን ገመት እስነን ኤርገ”</para>
  <para style="q2" vid="AMO 5:27">ጄዸ <char style="nd">ዋቀዮ</char> እን መቃንሳ <optbreak/> ዋቀ ዋን ሁንደ ደንደኡ ተኤ ሱን።<verse eid="AMO 5:27"/></para>
  <chapter eid="AMO 5"/>
  <chapter number="6" style="c" sid="AMO 6"/>
  <para style="s1">ወረ ያዶ መሌ ጅራተኒፍ ወዮ</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 6:1"/>ያ ወረ ያዶ መሌ ጥዮን ኬሰ ጅራተን፣</para>
  <para style="q2" vid="AMO 6:1">ከኔን ቱሉ ሰማርያረ ዋን ነጋዻን ጅራተን ሴተን፣</para>
  <para style="q1" vid="AMO 6:1">እሳን ነሞተ ኡልፋቶ ሰበ ዱሪ፣</para>
  <para style="q2" vid="AMO 6:1">ከኔን ሰብን እስራኤል ገረሳኒ ዹፉፍ ወዮ!<verse eid="AMO 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 6:2"/>ገረ ካልኔት ደርባቲ እላላ፤</para>
  <para style="q2" vid="AMO 6:2">አቺ ከኣቲ ገረ ሀማት ጉድቻ ዸቃ፤</para>
  <para style="q2" vid="AMO 6:2">ኤርገሲሞ ጋት ፍልስጤም ኬሳት ገድ ቡኣ።</para>
  <para style="q1" vid="AMO 6:2">እሳን ሞቱሞተኬሰን ለማን ጫሉ?</para>
  <para style="q2" vid="AMO 6:2">ብይሳኒ ብየኬሰን ጫላ በልአታ?<verse eid="AMO 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 6:3"/>እስን ጉያ ሀማ ፈጌስተኒ</para>
  <para style="q2" vid="AMO 6:3">ቡልቺንሰ ጄቁምሳ ፍዱ።<verse eid="AMO 6:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 6:4"/>እስን ስሬ እልከ አርባቲን ሚዸግፈሜረ ጪፍቱ፤</para>
  <para style="q2" vid="AMO 6:4">ስሬኬሰን ድንኪረ ቦቆቱ።</para>
  <para style="q1" vid="AMO 6:4">እስን ጦባላ ሆላ ፍለተሞፊ</para>
  <para style="q2" vid="AMO 6:4">ጀቢ ጮጮሞ ኛቱ።<verse eid="AMO 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 6:5"/>እስን ሰገሌ በገናቲን ዌዱ ፋይዳ ህንቀብኔ ዌድፍቱ፤</para>
  <para style="q2" vid="AMO 6:5">አኩመ ዳዊትስ ሜሻ ሙዚቃ ቀቀጄልፈቱ።<verse eid="AMO 6:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 6:6"/>እስን ጦፎ ኬሳ ዳዺ ወይኒ ዹግዱ፤</para>
  <para style="q2" vid="AMO 6:6">ድበተ አከ መሌ ጋሪ ድበቱ፤</para>
  <para style="q2" vid="AMO 6:6">ገሩ በዲሰ ዮሴፊፍ ህንገድተን።<verse eid="AMO 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 6:7"/>ከናፉ እስን ወረ ጀልቀበት ቦጅአመን ወጅን <optbreak/> ቦጅአምተኒ ፉዸተምቱ፤</para>
  <para style="q2" vid="AMO 6:7">ቡራቁፊ በሸነኑንኬሰን ንሀፈ።<verse eid="AMO 6:7"/></para>
  <para style="s1">
    <char style="nd">ዋቀዮ</char> ኦፍ ቱሉማ እስራኤል ጅበ</para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 6:8"/>
    <char style="nd">ዋቀዮ</char> ጎፍታን ኦፊሳቲን ከከቴረ፤ <char style="nd">ዋቀዮ</char> ዋቅን ዋን ሁንደ ደንደኡ አከነ ጄዸ፦</para>
  <para style="q1" vid="AMO 6:8">“አን ኦፍ ቱሉማ ያቆብ ነንበልፈ፤</para>
  <para style="q2" vid="AMO 6:8">ደአትኖሳስ ነንጅበ፤</para>
  <para style="q1" vid="AMO 6:8">አን መጋለቲፊ ዋን እሼ ኬሰ ጅሩ ሁንደ</para>
  <para style="q2" vid="AMO 6:8">ደበርሴ ነንኬነ።”<verse eid="AMO 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 6:9"/>ነሞትን ኩዸን ዮ መነ ቶኮ ኬሰት ሀፈን እሳንስ ንዹሙ። <verse eid="AMO 6:9"/><verse number="10" style="v" sid="AMO 6:10"/>ዮ ፍር ሬፈ ባሴ ጉቡ ቶኮ መነ ሰነ ኬሳ ባሱፍ ዹፌ ነመ ዾከቴ አች ጅሩ ከሚንዩ፣ “ነምን ቶኮዩ ስ ወጅን ጅራ?” ጄዼ ጋፈቴ ነምች ሱን፣ “ህንጅሩ” ጄዼን፣ እን “ጨልእስ! ኑ መቃ <char style="nd">ዋቀዮ</char> ዸኡ ህንቀብኑ” ጄዻን።<verse eid="AMO 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 6:11"/>ኩኖ <char style="nd">ዋቀዮ</char> አጀጀ ኬኔራቲ፣</para>
  <para style="q2" vid="AMO 6:11">መኔን ጉርጉዳን ንበርበዳኡ፤</para>
  <para style="q2" vid="AMO 6:11">መኔን ጥጥኖንስ ንጨጨቡ።<verse eid="AMO 6:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 6:12"/>ፈርዴን ከታወንረ ንፊጉ?</para>
  <para style="q2" vid="AMO 6:12">ነምን ቶኮ ቆትዮዻን አች ንቆታ?</para>
  <para style="q1" vid="AMO 6:12">እስን ገሩ ሙርቲ ቀጄላ ገረ ሱሚት፣</para>
  <para style="q2" vid="AMO 6:12">እጀ ቀጄሉማስ ገረ ሀዻት ጌደርተኒርቱ፤<verse eid="AMO 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 6:13"/>እስን ወረ ሎዴባር ሞአቹት ገመደኒ፣</para>
  <para style="q2" vid="AMO 6:13">“ኑ ሁምነኬኛን ቃርናይም ቀበትኔ ምቲ?” ጄተኒዸ።<verse eid="AMO 6:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 6:14"/>
    <char style="nd">ዋቀዮ</char> ዋቅን ዋን ሁንደ ደንደኡ አከነ ጄዻቲ፤</para>
  <para style="q2" vid="AMO 6:14">“ያ መነ እስራኤል፣ አን ሰበ ሌቦ ሀማቲ ጀልቀቤ</para>
  <para style="q1" vid="AMO 6:14">ሀመ ሱሉለ አረባት</para>
  <para style="q2" vid="AMO 6:14">ከራኬሰን ሁንደረት እስን ጩንቁርሱ ቶኮ እስንትን ካሰ።”<verse eid="AMO 6:14"/></para>
  <chapter eid="AMO 6"/>
  <chapter number="7" style="c" sid="AMO 7"/>
  <para style="s1">ሀዋንሰ፣ እብዳፊ ቱምቢ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1"/>
    <char style="nd">ዋቀዮ</char> ጎፍታን ዋን ከነ ነት አርግሲሴ፦ እን ኤርገ ቆድን ሞትቻ ሃመሜ ቦዴ፣ ኡቱመ ምዻን ለመፋን ገኣ ጅሩ ቱተ ሀዋንሳ ቆጴሴ። <verse eid="AMO 7:1"/><verse number="2" style="v" sid="AMO 7:2"/>አንስ ኤርገ ሀዋንስን ሱን ለፈ በርበዴሴ ቦዴ፣ “ያ <char style="nd">ዋቀዮ</char> ጎፍታ፣ ኑፍ አራረም! ያቆብ አከሚን ደንደኤ በዲሰራ ሀፈ? እን ዳእመ ጥናዸ!” ጄዼን እዬ።<verse eid="AMO 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 7:3"/>ከናፉ <char style="nd">ዋቀዮ</char> ንጋቤ።</para>
  <para style="p" vid="AMO 7:3">
    <char style="nd">ዋቀዮስ</char>፣ “ወን ኩን ህንተኡ” ጄዼ።<verse eid="AMO 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4"/>
    <char style="nd">ዋቀዮ</char> ጎፍታን ዋን ከነ ነት አርግሲሴ፤ <char style="nd">ዋቀዮ</char> ጎፍታን ሙርቲ ኬኑፍ እብደ ዋማ ቱሬ፤ እብድ ሱንስ ቱጁበ ጉዳ ጎግሴ ለፈስ ንበርበዴሴ። <verse eid="AMO 7:4"/><verse number="5" style="v" sid="AMO 7:5"/>ከነረት አን፣ “ያ <char style="nd">ዋቀዮ</char> ጎፍታ፣ አን ስን ከዸዻ፣ ዋን ከነ ኑራ ዻብ! ያቆብ አከሚን ዋን ከነራ ሀፈ? እን ዳእመ ጥናዸ!” ጄዼን እዬ።<verse eid="AMO 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 7:6"/>ከናፉ <char style="nd">ዋቀዮ</char> ንጋቤ።</para>
  <para style="p" vid="AMO 7:6">
    <char style="nd">ዋቀዮ</char> ጎፍታን፣ “ወን ኩንስ ህንተኡ” ጄዼ።<verse eid="AMO 7:6"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7"/>እን ዋን ከነ ነ አርግሲሴ፦ ጎፍታን ቱምቢ ሀርከት ቀበቴ ደላ ቱምቢዻን እጃረሜ ብረ ዻበቻ ቱሬ። <verse eid="AMO 7:7"/><verse number="8" style="v" sid="AMO 7:8"/><char style="nd">ዋቀዮስ</char>፣ “አሞስ፣ አት ማል አርጉት ጅርተ?” ጄዼ ነ ጋፈቴ።</para>
  <para style="p" vid="AMO 7:8">አንስ፣ “ቱምቢ ነንአርገ” ጄዼን ዴብሴ።</para>
  <para style="p" vid="AMO 7:8">ጎፍታንስ አከነ ናን ጄዼ፤ “ኩኖ አን ሰበኮ እስራኤል ግዱ ቱምቢ ቶኮ ነንካአ፤ አን ስአች እሳን ህንበራሩ።<verse eid="AMO 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 7:9"/>“እዶወን ሰገዳ ይስሃቅ ንበርበዳኡ፤</para>
  <para style="q2" vid="AMO 7:9">እዶን ቁልቁሉን እስራኤልስ ንኦነ፤</para>
  <para style="q2" vid="AMO 7:9">አን ጎራዴኮቲን መነ ዬሮብኣምት ነንከአ።”<verse eid="AMO 7:9"/></para>
  <para style="s1">አሞሲፊ አመስያ</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10"/>ኤርገሲ አመስያ ሉብን ቤትኤል አከነ ጄዼ ዬሮብኣም ሞትቸ እስራኤልት ኤርጋ ቶኮ ኤርጌ፤ “አሞስ ገራ እስራኤል ኬሰት ስት መለቴረ። ዱቢሳ ሁንደ ለፍትዩ ባቹ ህንደንዴሱ። <verse eid="AMO 7:10"/><verse number="11" style="v" sid="AMO 7:11"/>አሞስ አከነ ጄዼራቲ፦</para>
  <para style="q1" vid="AMO 7:11">“ ‘ዬሮብኣም ጎራዴዻን ዱአ፤</para>
  <para style="q2" vid="AMO 7:11">እስራኤልስ ዹጉማን ቦጅአሜ</para>
  <para style="q2" vid="AMO 7:11">ብየሳቲ ንፉዸተመ።’ ”<verse eid="AMO 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 7:12"/>ከነረት አመስያን አሞሲን አከነ ጄዼ፤ “ያ እላልቱነነ፣ ሶክ! ብየ ይሁዳት ዴብእ። አችት ቡዴነ ኛዹ፤ ራጂስ ዱበዹ። <verse eid="AMO 7:12"/><verse number="13" style="v" sid="AMO 7:13"/>ሰበቢ እን እዶ ቁልቁሉ ሞትቻቲፊ መነ ቁልቁሉማ ሞቱማ ተኤፍ አት ለመተ ቤትኤል ኬሰት ራጂ ህንዱበትን።”<verse eid="AMO 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 7:14"/>አሞስሞ አከነ ጄዼ አመስያፍ ዴብሴ፤ “አን ራጂ ዮካን እልመ ራጂ ምት፤ ገሩ አን ትክሴፊ ኤግዱ ሙከ ሀርቡን ቱሬ። <verse eid="AMO 7:14"/><verse number="15" style="v" sid="AMO 7:15"/><char style="nd">ዋቀዮ</char> ገሩ ትከ ቡሻዬ ኬሳ ነ ፉዼ፣ ‘ዸቂ ሰበኮ እስራኤልት ራጂ ዱበዹ’ ናን ጄዼ። <verse eid="AMO 7:15"/><verse number="16" style="v" sid="AMO 7:16"/>ኤጋ አመ ዱቢ <char style="nd">ዋቀዮ</char> ዸገእ። አት አከነ ጄተ፤</para>
  <para style="q1" vid="AMO 7:16">“ ‘አት እስራኤሊን ሞርሙዻን ራጂ ህንዱበትን፤</para>
  <para style="q2" vid="AMO 7:16">መነ ይስሃቅ ሞርሙዻን ለለቡ ዺስ።’<verse eid="AMO 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="AMO 7:17"/>“ከናፉ <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="AMO 7:17">“ ‘ኒቲንኬ መጋላ ኬሰት ሰጋገልቱ ታት፤</para>
  <para style="q2" vid="AMO 7:17">እልማንኬቲፊ እንተለንኬ ጎራዴዻን ዹሙ።</para>
  <para style="q1" vid="AMO 7:17">ብይኬ ሰፈረምቴ ገርገር ቆደምት፤</para>
  <para style="q2" vid="AMO 7:17">አት መታንኬዩ ብየ ኦርማት ዱተ።</para>
  <para style="q1" vid="AMO 7:17">እስራኤል ዹጉማን ቦጅአሜ</para>
  <para style="q2" vid="AMO 7:17">ብየሳቲ ንፉዸመ።’ ”<verse eid="AMO 7:17"/></para>
  <chapter eid="AMO 7"/>
  <chapter number="8" style="c" sid="AMO 8"/>
  <para style="s1">ጉቦ እጀ ብልቻቴን ጉተሜ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1"/>
    <char style="nd">ዋቀዮ</char> ጎፍታን ዋን ከነ ነት አርግሲሴ፦ ኩን ጉቦ እጀ ብልቻቴን ጉተሜዸ። <verse eid="AMO 8:1"/><verse number="2" style="v" sid="AMO 8:2"/>እንስ፣ “አሞስ፣ አት ማል አርጉት ጅርተ?” ጄዼ ነ ጋፈቴ።</para>
  <para style="p" vid="AMO 8:2">አንሞ፣ “ጉቦ እጀ ብልቻቴን ጉተሜ ቶኮ” ጄዼን ዴብሴፍ።</para>
  <para style="p" vid="AMO 8:2">ኤርገሲ <char style="nd">ዋቀዮ</char> አከነ ናን ጄዼ፤ “ሰበኮ እስራኤልት ዬሮን ዹፌረ፤ አን ስአች እሳን ህንበራሩ።”<verse eid="AMO 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 8:3"/>
    <char style="nd">ዋቀዮ</char> ጎፍታን አከነ ጄዸ፤ “ጋፈስ ፋርፈትናን መነ ቁልቁሉማ ኬሳ ቦእቸት ጌደረመ። ሬፍ አከ መሌ ሄዱን ለፈ ሁንደት ገተመ! ጨልእሱንስ ንተአ!”<verse eid="AMO 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 8:4"/>እስን ወር ረከቶተ ዽዺተኒ</para>
  <para style="q2" vid="AMO 8:4">ህዬዪ ብየቲ በሌስተን ዋን ከነ ዸገኣ፤<verse eid="AMO 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="AMO 8:5"/>እስን አከነ ጄቱ፤</para>
  <para style="q1" vid="AMO 8:5">“አከ ኑ ምዻን ጉርጉረኑፍ</para>
  <para style="q2" vid="AMO 8:5">ባቲን ሃራን ዮም ጎበነ?</para>
  <para style="q1" vid="AMO 8:5">አከ ኑ ቀመዲ ገባ ባፈትኑፍ</para>
  <para style="q2" vid="AMO 8:5">ሰንበትን ዮም ደርበ?”</para>
  <para style="q1" vid="AMO 8:5">እስን ወር ሰፈርቱ ጥኖት ፈየደምተኒ</para>
  <para style="q2" vid="AMO 8:5">ገቲሞ ኦል ካፍተን፣ መዳሊ ሶባቲን</para>
  <para style="q2" vid="AMO 8:5">ነመ ጎዎምስተኒ ሳምቱ፤<verse eid="AMO 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 8:6"/>ህዬዪ ሜቲዻን፣</para>
  <para style="q2" vid="AMO 8:6">ረከታሞ ኮጴ ሚለ ለማኒቲን ብተተኒ</para>
  <para style="q2" vid="AMO 8:6">ግርዲስ ቀመዲ ወጅን ጉርጉረቱ።<verse eid="AMO 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 8:7"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዼ ኡልፍነ ያቆቢን ከከቴረ፤ “አን ጎንኩማ ዋን እሳን ሆጄተን ቶኮሌ ህንእራንፈዹ።<verse eid="AMO 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 8:8"/>“ሰበቢ ከናፍ ለፍት ክርክርቴ</para>
  <para style="q2" vid="AMO 8:8">ነሞትን እሼ ኬሰ ጅራተን ሁንድ ህንቦአኒ?</para>
  <para style="q1" vid="AMO 8:8">ጉቱማን ብየ ሰና አኩመ ለገ አበያ ኦል ከአ፤</para>
  <para style="q2" vid="AMO 8:8">እሼን አኩመ ለገ ግብጥ</para>
  <para style="q2" vid="AMO 8:8">ኦል ደደርበተምቴ ልቅምፈምት።”<verse eid="AMO 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 8:9"/>
    <char style="nd">ዋቀዮ</char> ጎፍታን አከነ ጄዸ፤ “በረ ሰነ፣</para>
  <para style="q1" vid="AMO 8:9">“አን አከ አዱን ሳፋዻን ዺቴ</para>
  <para style="q2" vid="AMO 8:9">ለፍትስ ጉዩመ አዲዻን ዱከኖፍቱ ነንጎዸ።<verse eid="AMO 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 8:10"/>አን አያነ አመንቲኬሰኒ ገደት፣</para>
  <para style="q2" vid="AMO 8:10">ስርበኬሰን ሁንደስ ቦእቸት ነንጌደረ።</para>
  <para style="q1" vid="AMO 8:10">አን አከ እስን ሁንድ ወያ ገዳ ኡፈተኒ</para>
  <para style="q2" vid="AMO 8:10">መታኬሰን ሃደተን ነንጎዸ።</para>
  <para style="q1" vid="AMO 8:10">አን ዬሮ ሰነ አኩመ ቦእቸ እልመ ቶክቻ፣</para>
  <para style="q2" vid="AMO 8:10">ዹመሳስ አከ ጉያ ሀዻኣ ነንጎዸ።”<verse eid="AMO 8:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 8:11"/>
    <char style="nd">ዋቀዮ</char> ጎፍታን አከነ ጄዸ፤</para>
  <para style="q2" vid="AMO 8:11">“ዬሮን አን ብየቲት ቤለ ፍዱ ቶኮ ንዹፈ፤</para>
  <para style="q1" vid="AMO 8:11">እንስ ቤለ ዱቢ <char style="nd">ዋቀዮ</char> ዸገኡት መሌ</para>
  <para style="q2" vid="AMO 8:11">ቤለ ኛታ ዮካን ዼቡ ብሻኒ ምት።<verse eid="AMO 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 8:12"/>ነሞትን ዱቢ <char style="nd">ዋቀዮ</char> በርባቸ</para>
  <para style="q2" vid="AMO 8:12">ገላና ገረ ገላናት፣</para>
  <para style="q1" vid="AMO 8:12">ካባ ገረ በአ ቢፍቱት ንጆሩ፤</para>
  <para style="q2" vid="AMO 8:12">ገሩ ህንአርገተን።<verse eid="AMO 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 8:13"/>“በረ ሰነ</para>
  <para style="q1" vid="AMO 8:13">“ሸመረን በበሬዶፊ</para>
  <para style="q2" vid="AMO 8:13">ደርገጎትን ዺራ ጀጀቦን ዼቦተኒ ገገቡ።<verse eid="AMO 8:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 8:14"/>ወር ጩቡ ሰማርያቲን ከከተን</para>
  <para style="q2" vid="AMO 8:14">ዮካን ‘ያ ዳን ዹጋ ዋቀኬ ጅራታ’ ጄዸን፣</para>
  <para style="q2" vid="AMO 8:14">ዮካን ወር ‘ዹጋ ዋቀ ቤርሼባ’ ጄዸኒ</para>
  <para style="q2" vid="AMO 8:14">ከከተን አከ ለመተ ህንካኔፍ ንኩፉ።”<verse eid="AMO 8:14"/></para>
  <chapter eid="AMO 8"/>
  <chapter number="9" style="c" sid="AMO 9"/>
  <para style="s1">በርበዴፈሙ እስራኤል</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1"/>ኡቱ ጎፍታን እዶ ኣርሳ ብረ ዻበቱ ነንአርጌ፤ እንስ አከነ ጄዼ፦</para>
  <para style="q1" vid="AMO 9:1">“አከ ቡሳወን በልበላ ራፈመኒፍ</para>
  <para style="q2" vid="AMO 9:1">ፊጤ ኡቱባ ዸእ።</para>
  <para style="q1" vid="AMO 9:1">መታ ነመ ሁንዳረት ገድ እሳን ሀርጫስ፤</para>
  <para style="q2" vid="AMO 9:1">ወረ ሀፈንሞ አነቱ ጎራዴዻን ፍጠ።</para>
  <para style="q1" vid="AMO 9:1">ቶኮንሳኒዩ በቀተኒ ህንበአን፤</para>
  <para style="q2" vid="AMO 9:1">እሳን ኬሳ ነምን ቶኮዩ ህንምልቁ።<verse eid="AMO 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 9:2"/>ዮ እሳን ቦለ ቅሌ ቆተተንዩ</para>
  <para style="q2" vid="AMO 9:2">ሀርክኮ አቺ እሳን ፉዸ።</para>
  <para style="q1" vid="AMO 9:2">ዮ እሳን ሰሚት ኦል በአንዩ</para>
  <para style="q2" vid="AMO 9:2">አን አቺ ገድ እሳን ነንቡሰ።<verse eid="AMO 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 9:3"/>ዮ እሳን ፊጤ ቀርሜሎስረ</para>
  <para style="q2" vid="AMO 9:3">ዾከተንዩ፣ አን አቺ አደምሴ ቀቤ <optbreak/> ገድ እሳን ነንፍደ።</para>
  <para style="q1" vid="AMO 9:3">ዮ እሳን ገላነ ጀለ ነ ዾከተንዩ፣</para>
  <para style="q2" vid="AMO 9:3">አን አከ እን አችት እሳን እዱፍ ቦፈ እት ነንአጀጀ።<verse eid="AMO 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 9:4"/>ዮ ዲኖትንሳኒ ቦጅአኒ እሳን ፉዸተን፣</para>
  <para style="q2" vid="AMO 9:4">አችት ጎራዴ እሳን ፍጡ እት ነንአጀጀ።</para>
  <para style="b" vid="AMO 9:4"/>
  <para style="q1" vid="AMO 9:4">“አን ዋን ጋሪዻፍ ኡቱ ህንተእን</para>
  <para style="q2" vid="AMO 9:4">ዋን ሀማዻፍ እጀኮ እሳንረ ነንቡሰ።”<verse eid="AMO 9:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 9:5"/>ጎፍታን፣ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ ለፈ ንቱቀ፤</para>
  <para style="q1" vid="AMO 9:5">እሼንስ ንበቅጥ፤</para>
  <para style="q2" vid="AMO 9:5">ወን እሼረ ጅራቱ ሁንድኑ ንቦአ፤</para>
  <para style="q1" vid="AMO 9:5">ብየቲን ጉቱን አከ ለገ አበያ ኦል ካት፤</para>
  <para style="q2" vid="AMO 9:5">ኤርገሲስ አከ ለገ ግብጥ ገድ ገልት፤<verse eid="AMO 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 9:6"/>እን ደርቢሳ ኦል ዼራ ሰሚረት እጃረቴ</para>
  <para style="q2" vid="AMO 9:6">ሁንዴሳ ለፈረ ዻበቱ፣</para>
  <para style="q1" vid="AMO 9:6">እን ብሻኖተ ገላና ዋሜ</para>
  <para style="q2" vid="AMO 9:6">ፉለ ለፋረት ገድ ሮብሱ ሱን</para>
  <para style="q2" vid="AMO 9:6">መቃንሳ <char style="nd">ዋቀዮ</char>።<verse eid="AMO 9:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 9:7"/>“እስን እስራኤሎትን</para>
  <para style="q2" vid="AMO 9:7">አናፍ አኩመ ሰበ እቶጵያ ምቲ?”</para>
  <para style="q2" vid="AMO 9:7">ጄዸ <char style="nd">ዋቀዮ</char>።</para>
  <para style="q1" vid="AMO 9:7">“አን እስራኤሎተ ብየ ግብጢቲ፣</para>
  <para style="q2" vid="AMO 9:7">ፍልስጤሞተ ከፍቶሪ፣</para>
  <para style="q2" vid="AMO 9:7">ወረ ሶርያሞ ቂሪ ባሴ ህንፍድኔ?<verse eid="AMO 9:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 9:8"/>“ዹጉማን እጅ <char style="nd">ዋቀዮ</char> ጎፍታ</para>
  <para style="q2" vid="AMO 9:8">ሞቱማ ጩበማረ ጅረ።</para>
  <para style="q1" vid="AMO 9:8">አን ፉለ ለፋራ እሰ ነንበሌሰ፤</para>
  <para style="q2" vid="AMO 9:8">ተኡስ አን ጉቱማን ጉቱት መነ ያቆብ ህንበሌሱ”</para>
  <para style="q2" vid="AMO 9:8">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="AMO 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 9:9"/>“አን አጀጀ ኬኔ</para>
  <para style="q2" vid="AMO 9:9">አኩመ ምዻን ግንግልቻዻን</para>
  <para style="q2" vid="AMO 9:9">ግንግልፈሜ እጅ ቶኮዩ ለፈ ህንቡኔ ሰነ</para>
  <para style="q1" vid="AMO 9:9">ሰቦተ ሁንደ ግዱት</para>
  <para style="q2" vid="AMO 9:9">መነ እስራኤል ነንግንግልቸ።<verse eid="AMO 9:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 9:10"/>ጩበሞትን ሰበኮ ግዱ ጅራተን ሁንድ</para>
  <para style="q2" vid="AMO 9:10">ወር፣ ‘በላን ኑ ህንአርገቱ</para>
  <para style="q1" vid="AMO 9:10">ዮካን ኑት ህንዹፉ’ ጄዸን</para>
  <para style="q2" vid="AMO 9:10">ሁንድ ጎራዴዻን ዹሙ።<verse eid="AMO 9:10"/></para>
  <para style="s1">ሃሮምፈሙ እስራኤል</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 9:11"/>“አን በረ ሰነ ኬሰ ዱንካነ ዳዊት</para>
  <para style="q1" vid="AMO 9:11">“ከን ኩፌ ሰነ ዴብሴ ነንዻበ።</para>
  <para style="q2" vid="AMO 9:11">ከን ተርሰኤስ ወልት ነንሱጰ፤</para>
  <para style="q2" vid="AMO 9:11">ዲገማሳ እዶት ዴብሴ</para>
  <para style="q2" vid="AMO 9:11">አከ ዱራት ነንእጃረ፤<verse eid="AMO 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 9:12"/>ኩንስ አከ እሳን ሀምባ ኤዶሚፊ</para>
  <para style="q2" vid="AMO 9:12">ሰቦተ መቃኮቲን ዋመመን ሁንደ ዻለኒፍ”</para>
  <para style="q2" vid="AMO 9:12">ጄዸ <char style="nd">ዋቀዮ</char>፣ እን ዋን ከነ ሆጄቱ።<verse eid="AMO 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 9:13"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፤ “ኩኖ፣ በር እት ነምን ሃሙ ቶኮ እሰ ቆቱ ቀቀቡ፣</para>
  <para style="q1" vid="AMO 9:13">“ነምን ወይኒ ዻቡሞ</para>
  <para style="q2" vid="AMO 9:13">እሰ ጩንፉ ቀቀቡ ቶኮ ንዹፈ፤</para>
  <para style="q1" vid="AMO 9:13">ዳዺን ወይኒ ሃራን ቱሉወንራ ንጮጮጰ፤</para>
  <para style="q2" vid="AMO 9:13">ጋረን ሁንደ ኬሳስ ንያአ።<verse eid="AMO 9:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="AMO 9:14"/>አን ሰበኮ እስራኤልን ቦጁዻ ነንዴብሰ።</para>
  <para style="b" vid="AMO 9:14"/>
  <para style="q1" vid="AMO 9:14">“እሳንስ መጋላወን ዲገመን ዴብሰኒ እጃረኒ ኬሰ ንጅራቱ።</para>
  <para style="q2" vid="AMO 9:14">እሳን ወይኒ ዻበኒ፣ ዳዺ ወይኒሳኒ ንዹጉ፤</para>
  <para style="q2" vid="AMO 9:14">እሳን ብቅልቱ ዻበተኒ እጀሳ ንኛቱ።<verse eid="AMO 9:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 9:15"/>አን እስራኤሎተ ብየ ኦፊሳኒ ኬሰ ነንዻበ፤</para>
  <para style="q2" vid="AMO 9:15">እሳን ብየ አን እሳኒፍ ኬኔ ኬሳ</para>
  <para style="q2" vid="AMO 9:15">ለመተ ህንቡቅፈመን፣”</para>
  <para style="m" vid="AMO 9:15">ጄዸ <char style="nd">ዋቀዮ</char> ዋቅንኬ።<verse eid="AMO 9:15"/></para>
  <chapter eid="AMO 9"/>
</usx>
