<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">3 ዮሀንስ</para>
  <para style="toc1">ዮሀንስ ሰደፋ</para>
  <para style="toc2">3 ዮሀንስ</para>
  <para style="toc3">3ዮሀ</para>
  <para style="mt1">ዮሀንስ</para>
  <para style="mt2">ሰደፋ</para>
  <chapter number="1" style="c" sid="3JN 1"/>
  <para style="s1">ነጋ ጋፈቹ</para>
  <para style="po">
    <verse number="1" style="v" sid="3JN 1:1"/>ጃርስቸራ።</para>
  <para style="po" vid="3JN 1:1">ገረ ጋዮስ ምቹኮ፣ እሰ አን ዹጋዻን ጃለዹት።<verse eid="3JN 1:1"/></para>
  <para style="b"/>
  <para style="s1">ጋዮስን ገለቴፈቹሳ</para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2"/>ያ ምቹኮ፣ አኩመ ሉቡኬት ቶሌ ሰነ አከ ወን ሁንድኑ ስት ቶሉፊ አከ አት ፈያ ቀባቱፍ ነንከዸዸ። <verse eid="3JN 1:2"/><verse number="3" style="v" sid="3JN 1:3"/>ኦቦሎትን ቶኮ ቶኮ ዹፈኒ አከ አት ዹጋፍ አመነማ ታቴፊ አከ አት ዹጋዻን ጅራቱ ነት ህምናን አን አከ መሌ ገመዴ። <verse eid="3JN 1:3"/><verse number="4" style="v" sid="3JN 1:4"/>እጆሌንኮ ዹጋዻን ጅራቹሳኒ ዸገኡ ጫላ አን ገመቹ ጉዳ ህንቀቡ።<verse eid="3JN 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5"/>ያ ምቹኮ፣ ዮ እሳን ኬሱሞተ ስት ተአንሌ አት ዋን ኦቦሎታፍ ጎቱ ኬሰት አመነማዸ። <verse eid="3JN 1:5"/><verse number="6" style="v" sid="3JN 1:6"/>እሳን ዋኤ ጃለለኬቲ ወልዳ ክርስታናት ህመኒሩ። ማሎ ሃለ ዋቀት ቶሉን ከራሳኒረት እሳን ገርጋር። <verse eid="3JN 1:6"/><verse number="7" style="v" sid="3JN 1:7"/>እሳን መቃሳቲፍ ጄዸኒ ኡቱ ነሞተ ኦርማራ ገርጋርሰ ቶኮሌ ህንአርገን በአኒሩቲ። <verse eid="3JN 1:7"/><verse number="8" style="v" sid="3JN 1:8"/>ከናፉ ኑ አከ እሳን ወጅን ዹጋፍ ሆጄትኑፍ ነሞተ አከሲ ስመትኔ ገርጋሩ ቀብነ።<verse eid="3JN 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9"/>አን ወልዳ ክርስታናቲፍ በሬሴረ፤ ገሩ እሳን ኬሳ ዲዮጥራጢስ እን ዱሬ ተኡ በርባዱ ኑ ህንስመቱ። <verse eid="3JN 1:9"/><verse number="10" style="v" sid="3JN 1:10"/>ከናፉ አን ዮን ዹፌ ዋን እን መቃኬኘ በሌሱዻን ሆጄቻ ጅሩ እፈት ነንባሰ። አከ ዋን ወን ኩን እሰ ሀንቀቴት እን ኦቦሎተ ስመቹ ድደ። ወረ እሳን ስመቹ በርባደንስ ንዾወ፤ ወልዳ ክርስታና ኬሳስ እሳን አርአ።<verse eid="3JN 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11"/>ያ ምቹኮ፣ ዋን ጋሪ ዱካ ቡእ መሌ ዋን ሀማ ዱካ ህንቡእን። ነምን ዋን ጋሪ ሆጄቱ ከምዩ ከን ዋቃት። ነምን ዋን ሀማ ሆጄቱ ገሩ ተኩማ ዋቀ ህንአርግኔ። <verse eid="3JN 1:11"/><verse number="12" style="v" sid="3JN 1:12"/>ነምን ሁንድ ድሜጥሮሲፍ ዹጋ በአ፤ ዹጋን መታንሼዩ ዹጋ ባት። ኑስ ዹጋ ባናፍ፤ እስንስ አከ ዹገ በኡምስኬኘ ዹጋ ተኤ ንቤክቱ።<verse eid="3JN 1:12"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="s1">ኤበ ዹማቲፊ ነጋ ዻሙሳ</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13"/>አን ዋነን ሲፍ በሬሱ ባይኤ ቀበ፤ ገሩ ቢሪፊ ቀለሚዻን በሬሱ ህንበርባዱ። <verse eid="3JN 1:13"/><verse number="14" style="v" sid="3JN 1:14"/>ቆደ ከና አን ዽኦት ስአርጉፍ አብዲ ቀበ፤ ኑስ እፋን እፈት ንሃሶፍነ።<verse eid="3JN 1:14"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15"/>ነጋን ሲፍ ሃተኡ።</para>
  <para style="b" vid="3JN 1:15"/>
  <para style="p" vid="3JN 1:15">ምቾን አስ ጅረን ነጋ ሲፍ ዻሙ። አትስ ምቾተ አች ጅረን ቶኮ ቶኮን መቃ ዸኢቲ ነጋ እት ኑ ህም።<verse eid="3JN 1:15"/></para>
  <chapter eid="3JN 1"/>
</usx>
