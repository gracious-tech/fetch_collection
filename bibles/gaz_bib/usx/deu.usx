<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="DEU" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">ኬሰ ዴቢ</para>
  <para style="toc1">ሴረ ኬሰ ዴቢ</para>
  <para style="toc2">ኬሰ ዴቢ</para>
  <para style="toc3">ኬዴ</para>
  <para style="mt2">ሴረ</para>
  <para style="mt1">ኬሰ ዴቢ</para>
  <chapter number="1" style="c" sid="DEU 1"/>
  <para style="s1">አጀጀ አከ እስራኤሎትን ኮሬቢ በአኒፍ ኬነሜ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 1:1"/>ዱቢን ኩን ዱቢ ሙሴን ዬሮ እሳን ገሞጂ ገመ በአ ዮርዳኖስት፣ አረባ ፉሌ ሱፍት አርገሙ ሰነ ኬሰ፣ ጳራኒፊ ቶፌል፣ ላባን፣ ሀጤሮቲፊ ዲዛሃብ ግዱ ቱረንት እስራኤሎተ ሁንደት ዱበቴዸ። <verse eid="DEU 1:1"/><verse number="2" style="v" sid="DEU 1:2"/>ኮሬቢ ከራ ቱሉ ሴኢሪን ቃዴሽ በርኔ ገኡፍ ጉዮተ ኩዸ ቶኮ ፉዸተ።<verse eid="DEU 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="DEU 1:3"/>ሙሴንስ ወጋ አፉርተመፋ ኬሰ ጉያ ቶኮፋ ጅአ ኩዸ ቶኮፋት ዋን <char style="nd">ዋቀዮ</char> ዋኤሳኒ እሰ አጀጄ ሁንደ እስራኤሎተት ህሜ። <verse eid="DEU 1:3"/><verse number="4" style="v" sid="DEU 1:4"/>ኩንስ ኤርገ እን ስሆን ሞቲ አሞሮታ ከን ሄሽቦን ቡልቻ ቱሬ ሞአቴ ኦግ ሞቲ ባሻን ከን አሽታሮት ቡልቻ ቱሬሌ ኤድሬዪት ሞአቴ ቦዴዸ።<verse eid="DEU 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 1:5"/>በአ ዮርዳኖስት ብየ ሞኣብ ኬሰት ሙሴን አከነ ጄዼ ሴረ ከነ እብሱ ጀልቀቤ፦<verse eid="DEU 1:5"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="6" style="v" sid="DEU 1:6"/>
    <char style="nd">ዋቀዮ</char> ዋቅንኬኘ ኮሬብት አከነ ኑን ጄዼ፤ “እስን ቱሉ ከነ ብረ ዬሮ ዼራ ቱርተኒርቱ። <verse eid="DEU 1:6"/><verse number="7" style="v" sid="DEU 1:7"/>ቁበተ ቡቅሳ ከኣቲ ገረ ብየ ጋራ አሞሮታት ዴምሰኬሰን እት ፉፋ፤ ኤርገሲስ ሰቦተ ናኖ አረባት አርገመን ሁንደ ኬሰ፣ ብየ ቱሉወኒ ኬሰ፣ ብዮተ ገመ ዽኣቲን ጭነ ቱሉወኒት አርገመን ኬሰ፣ ኔጌቢፊ ቀርቀረ ገላና፣ ብየ ከነኣኖታቲፊ ልባኖን ኬሰ ሀመ ለገ ኤፍራጢስ ጉድቻት አርገመን ኬሰ ዴማ። <verse eid="DEU 1:7"/><verse number="8" style="v" sid="DEU 1:8"/>ኩኖ፣ አን ብየ ከነ እስኒፍ ኬኔረ። ብየ <char style="nd">ዋቀዮ</char> አቦቲኬሰኒፍ ጄቹንስ አብረሃሚፍ፣ ይስሃቂፍ፣ ያቆቢፊ ሰኚሳኒ ወረ እሳኒን ዱባቲፍ ኬኑፍ ከከቴ ሰነት ገላቲ ዻላ።”<verse eid="DEU 1:8"/></para>
  <para style="s1">ሙደሙ ሆገንቶታ</para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 1:9"/>አን ዬሮ ሰነት አከነን እስኒን ጄዼ፤ “አን ኮጳኮ እስን ባቹ ህንደንደኡ። <verse eid="DEU 1:9"/><verse number="10" style="v" sid="DEU 1:10"/><char style="nd">ዋቀዮ</char> ዋቅንኬሰን እስን ባይእሴረ፤ ኩኖ፣ እስን ሀርአ አኩመ ኡርጂወን ሰሚ ባይአተኒርቱ። <verse eid="DEU 1:10"/><verse number="11" style="v" sid="DEU 1:11"/><char style="nd">ዋቀዮ</char> ዋቅን አቦቲኬሰኒ ዬሮ ኩመ እስን ሃባይእሱ፤ አኩመ አብዲ ኬኔ ሰነትስ እስን ሃኤብሱ! <verse eid="DEU 1:11"/><verse number="12" style="v" sid="DEU 1:12"/>አን ገሩ አከምት ኮጳኮ ረክነኬሰን፣ በኣኬሰኒፊ ወል ሞርሚኬሰን ባቹ ደንደኣ? <verse eid="DEU 1:12"/><verse number="13" style="v" sid="DEU 1:13"/>ቶኮ ቶኮ ጎሶተኬሰኒ ኬሳ ነሞተ ኦጌዪ፣ ሁበቶታፊ ከበጀሞ ፍለዻ፤ አንስ እስንረት ቡልችቶተ እሳን ነንታስሰ።”<verse eid="DEU 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 1:14"/>እስንስ፣ “ወን አት ዽኤስቴ ጋሪዸ” ጄተኒ ናፍ ዴብፍተን።<verse eid="DEU 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 1:15"/>አን ሀንገፎተ ጎሶተኬሰኒ ጄቹንስ ነሞተ ኦጌዪፊ ከበጀሞ ፉዸዼ አከ እሳን አጀጁወን ኩማ፣ አጀጁወን ዽባ፣ አጀጁወን ሸንተማቲፊ አጀጁወን ኩዸኒ ተአኒ እስንረት ኣንጎ ቀባተን ነንሙዴ። <verse eid="DEU 1:15"/><verse number="16" style="v" sid="DEU 1:16"/>አንስ ዬሮ ሰነት አከነ ጄዼ አቦቲ ሙርቲኬሰን ነንአጀጄ፤ “ሞርሚ ኦቦሎተኬሰን ግዱት ከኡ ዸገኣ፤ ዮ ወል ሞርሚን ከኡ ሱን እስራኤሎተ ኦቦሎተ ግዱት ዮካን ነመ እስራኤል ቶኮፊ አለጋ ቶኮ ግዱት ተኤ ሙርቲ ቀጄላ ኬና። <verse eid="DEU 1:16"/><verse number="17" style="v" sid="DEU 1:17"/>ሙርቲ ኬኑ ኬሰት ነመ ወል ህንጫልችስና፤ ጉዳስ ጥናስ ወል ቅጤ ዸገኣ። ሰበቢ ሙርቲን ከን ዋቃ ተኤፍ ኤኙንዩ ህንሶዳትና። ዋን ሁምነኬሰኒ ኦል ተኤ ነት ፍዳ፤ አንስ ነንእላላ።” <verse eid="DEU 1:17"/><verse number="18" style="v" sid="DEU 1:18"/>አን ዬሮ ሰነት ዋን እስን ጎቹ ቀብደን ሁንደ እስን አጀጄረ።<verse eid="DEU 1:18"/></para>
  <para style="s1">በሳስቶትን ኤርገሙሳኒ</para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 1:19"/>ኑስ ኤርገሲ አኩመ <char style="nd">ዋቀዮ</char> ዋቅንኬኘ ኑ አጀጄት ኮሬቢ ካኔ ገሞጂ ጉዳፊ ሶዳችሳ እስን አርግተን ሰነ ኬሰ ደበሬ ገረ ብየ ጋራ አሞሮታ ዸቅኔ፤ አከሲንስ ቃዴሽ በርኔ ጌኜ። <verse eid="DEU 1:19"/><verse number="20" style="v" sid="DEU 1:20"/>አንስ አከነ እስኒን ጄዼ፤ “እስን ብየ ጋራ አሞሮታ ከን <char style="nd">ዋቀዮ</char> ዋቅንኬኘ ኑ ኬኑ ጌሰኒርቱ። <verse eid="DEU 1:20"/><verse number="21" style="v" sid="DEU 1:21"/>ኩኖ፣ <char style="nd">ዋቀዮ</char> ዋቅንኬሰን ብየቲ እስኒፍ ኬኔረ። ዸቃቲ አኩመ <char style="nd">ዋቀዮ</char> ዋቅን አቦቲኬሰኒ እስንት ህሜ ሰነት እሼ ዻላ፤ ህንሶዳትና፤ አብዲስ ህንኩተትና።”<verse eid="DEU 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 1:22"/>ኤርገሲስ ሁንድኬሰን ነ ብረ ዹፍተኒ፣ “አከ እሳን ብየቲ ኑ በሳሰኒፍ ዱራን ዱርስኔ ነሞተ ኤርገትነ፤ እሳንስ ዋኤ ከራ አች ኑ ጌሱቲፊ መጋላወን ኑ እት ዹፍኑ ኦዱ ኑ ፍዱ” ጄተን።<verse eid="DEU 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 1:23"/>ያድን ሱንስ ጋሪ ነት ፈካቴ፤ አን ኩዸ ለማንኬሰን ጄቹንስ ቶኮ ቶኮ ጎሳ ኬሳ ነመ ቶኮ ነንፍለዼ። <verse eid="DEU 1:23"/><verse number="24" style="v" sid="DEU 1:24"/>እሳንስ ከአኒ ብየ ጋራት ኦል በአኒ ሱሉለ ኤሽኮል ገአኒ ብየቲ በሳሰን። <verse eid="DEU 1:24"/><verse number="25" style="v" sid="DEU 1:25"/>እጀ ብየቲ ኬሳስ ዋ ፍደኒ ዹፈኒ፣ “ብይ <char style="nd">ዋቀዮ</char> ዋቅንኬኘ ኑፍ ኬኑ ኩን ጋሪዸ” ጄዸኒ ኑት ህመን።<verse eid="DEU 1:25"/></para>
  <para style="s1">
    <char style="nd">ዋቀዮት</char> ፍንጭሉ</para>
  <para style="p">
    <verse number="26" style="v" sid="DEU 1:26"/>እስን ገሩ ዸቁ ድደኒ አጀጀ <char style="nd">ዋቀዮ</char> ዋቀኬሰኒት ፍንጭልተን። <verse eid="DEU 1:26"/><verse number="27" style="v" sid="DEU 1:27"/>ዱንካነኬሰን ኬሰትስ አከነ ጄተኒ ጉንጉምተን፤ “<char style="nd">ዋቀዮ</char> ኑ ጅበ፤ ከናፉ ብየ ግብጢቲ ኑ ባሱን እሳቱ አከ እሳን ኑ በሌሰኒፍ ሀርከ አሞሮታት ደበርሴ ኑ ኬኑፍ። <verse eid="DEU 1:27"/><verse number="28" style="v" sid="DEU 1:28"/>ኤጋ ኑ ኤሰ ዸቁ ደንዴኘ? ኦቦሎትንኬኘ፣ ‘ጀር ኑ ጫላ ጀጀቦፊ ሆጃንሳኒ ዼዼራዸ፤ መጋላወንሳኒስ ጉርጉዳፊ ደላወን ሰሚ ገአኒን መርፈመኒሩ፤ ከነ ብረትሞ እልማን አናቅ አርግኔረ’ ጄዸኒ ኑ ሶዳችሰን።”<verse eid="DEU 1:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="DEU 1:29"/>አንስ አከነን እስኒን ጄዼ፤ “ህንርፈትና፤ እሳን ህንሶዳትና። <verse eid="DEU 1:29"/><verse number="30" style="v" sid="DEU 1:30"/><char style="nd">ዋቀዮ</char> ዋቅንኬሰን ከን ፉለኬሰን ዱረ ዴሙ ኩን አኩመ እጀኬሰን ዱረት ብየ ግብጥ ኬሰት እስኒ ጎዼ ሰነ እስኒፍ ንሎለ፤ <verse eid="DEU 1:30"/><verse number="31" style="v" sid="DEU 1:31"/>ገሞጂ ኬሰትስ አከሱመ። ሀመ አስ ጌሰንትስ ከራ ዴምተን ሁንደት አከምት አከ <char style="nd">ዋቀዮ</char> ዋቅንኬሰን አኩመ አባን እልመሳ ባቱት እስን ባቴ አርግተኒርቱ።”<verse eid="DEU 1:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="DEU 1:32"/>ተኡስ እስን <char style="nd">ዋቀዮ</char> ዋቀኬሰን <verse eid="DEU 1:32"/><verse number="33" style="v" sid="DEU 1:33"/>እሰ እዶ እስን ቁበተን በርባዱፊ ዳንዲ እስን ዴሙ ቀብደን እስን አርግሲሱዻፍ ጄዼ ሀልከን እብዳን፣ ጉያሞ ዱሜሳን እስን ዱረ ዴሜ እስን ቀጄልቻ ቱሬ ህንአመኔ።<verse eid="DEU 1:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="DEU 1:34"/>
    <char style="nd">ዋቀዮስ</char> ዮሙ ዋን እስን ጄተን ዸገኤት ዼከሜ አከነ ጄዼ ከከቴ፦ <verse eid="DEU 1:34"/><verse number="35" style="v" sid="DEU 1:35"/>“ዸሎተ ሀማ ከነ ኬሳ ነምን ቶኮዩ ብየ ጋሪ አን አከ አቦቲኬሰኒፍ ኬኑ ከኩ ገሌ ሰነ ህንአርጉ፤ <verse eid="DEU 1:35"/><verse number="36" style="v" sid="DEU 1:36"/>ካሌብ እልመ ዬፉኔ ሰነ መሌ ከን አርጉ ህንጅሩ። እን ብየ ሰነ ንአርገ፤ ሰበቢ እን ገራ ጉቱዻን <char style="nd">ዋቀዮ</char> ዱካ ቡኤፍ አን ለፈ እን ሚለሳረ ዻበቴ ሰነሳፊ ሰኚሳቲፍ ነንኬነ።”<verse eid="DEU 1:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="DEU 1:37"/>ሰበቢኬሰኒፍ <char style="nd">ዋቀዮ</char> ነትሌ ዼከሜ አከነ ጄዼ፤ “አትዩ እት ህንገልቱ። <verse eid="DEU 1:37"/><verse number="38" style="v" sid="DEU 1:38"/>ገርጋራንኬ እያሱን እልም ኑን ገሩ እት ገለ። እን ዋን እስራኤሎተ ብየቲ ዻልችሱፍ እሰ ጀጀቤስ። <verse eid="DEU 1:38"/><verse number="39" style="v" sid="DEU 1:39"/>ዳእመን እስን ንቦጅአመን ጄተን፣ እልማንኬሰን ከኔን ዋን ቶላፊ ሀማ ገርገር ባሰኒ ህንቤክኔ ብየ ሰነት ንገሉ። አን እሳኒፈን ኬነ፤ እሳንስ ንዻሉ። <verse eid="DEU 1:39"/><verse number="40" style="v" sid="DEU 1:40"/>እስን ገሩ ዱበት ዴብኣቲ ዳንዲ ገረ ገላነ ዲማት ጌሱ ቀበዻቲ ገሞጂት ቀጄላ።”<verse eid="DEU 1:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="DEU 1:41"/>እስንስ፣ “ኑ <char style="nd">ዋቀዮት</char> ጩቡ ሆጄትኔረ። ዸቅኔ አኩመ <char style="nd">ዋቀዮ</char> ዋቅንኬኘ ኑ አጀጄት ሎለ” ጄተኒ ዴብፍተን። ብየ ጋራ ዸቁን ዋን ሰልጳ እስንት ፈካቴ አከሲን ቶኮን ቶኮንኬሰን ምአ ሎላ ቀበተኒ ካተን።<verse eid="DEU 1:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="DEU 1:42"/>
    <char style="nd">ዋቀዮ</char> ገሩ፣ “ ‘ዋን አን እስን ወጅን ህንጅሬፍ ሎላፍ ህንበእና። እስን ዲኖተኬሰኒን ንሞአተምቱ’ ጄዺ እሳንት ህም” ናን ጄዼ።<verse eid="DEU 1:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="DEU 1:43"/>አንስ አከሱመን እስንት ህሜ፤ እስን ገሩ ነ ህንዸጌኜ። አጀጀ <char style="nd">ዋቀዮት</char> ፍንጭልተኒ ኦፍ ቱሉማኬሰኒን ብየ ጋራት ዱልተን። <verse eid="DEU 1:43"/><verse number="44" style="v" sid="DEU 1:44"/>አሞሮትን ጋረንረ ጅራተን እስንት ዹፈን፤ እሳንስ አኩመ ቱተ ከኒሳት በአኒ እስን ጉግሰን፤ ሴኢሪ ሀመ ሆርማት እስን ዸአን። <verse eid="DEU 1:44"/><verse number="45" style="v" sid="DEU 1:45"/>እስን ዴብተኒ ዹፍተኒ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ቦሰን፤ እን ገሩ ቦእቸኬሰን ህንዸጌኜ፤ ጉረሳስ እስኒፍ ህንኬንኔ። <verse eid="DEU 1:45"/><verse number="46" style="v" sid="DEU 1:46"/>አከ ዬሮ እስን አች ጅራተኒት፣ ጉዮትን እስን ቃዴሽ ኬሰ ጅራተን ባይኤዸ።<verse eid="DEU 1:46"/></para>
  <chapter eid="DEU 1"/>
  <chapter number="2" style="c" sid="DEU 2"/>
  <para style="s1">ገሞጂ ኬሰ ጆሩ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 2:1"/>ኤርገሲ አኩመ <char style="nd">ዋቀዮ</char> ነት ህሜት፣ ዱበት ዴብኔ ከራ ገላነ ዲማቲን ገረ ገሞጂት ቀጄሌ፤ ዬሮ ዼራዻፍስ ናኖ ብየ ጋራ ሴኢር ኬሰ ጆሬ።<verse eid="DEU 2:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="DEU 2:2"/>
    <char style="nd">ዋቀዮስ</char> አከነ ናን ጄዼ፤ <verse eid="DEU 2:2"/><verse number="3" style="v" sid="DEU 2:3"/>“ብየ ጋራ ከነ ናነኡን እስን ገአ፤ ገረ ካባት ገረገላ። <verse eid="DEU 2:3"/><verse number="4" style="v" sid="DEU 2:4"/>ሰበ ከነ አከነ ጄዺ አጀጅ፦ ‘እስን ብየ ኦቦሎተኬሰን ሰኚወን ኤሳዉ ከኔን ሴኢር ኬሰ ጅራተኒ ኬሰ ደርብቱ። እሳን እስን ሶዳቱ፤ እስን ገሩ ጀቤሳ ኦፍ ኤገዻ። <verse eid="DEU 2:4"/><verse number="5" style="v" sid="DEU 2:5"/>ሎላፍ እሳን ህንከካስና፤ አን ለፈሳኒራ እዶ እስን ሚለኬሰን እረ ዻበተንሌ እስኒፍ ህንኬኑቲ። አን ብየ ጋራ ሴኢር ዻለ ጎዼ ኤሳዉፍ ኬኔረ። <verse eid="DEU 2:5"/><verse number="6" style="v" sid="DEU 2:6"/>ኛተ አቺ ኛተኒፊ ብሻን ዹግደኒፍ ማለቀ ባፍቱፍ።’ ”<verse eid="DEU 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 2:7"/>
    <char style="nd">ዋቀዮ</char> ዋቅንኬሰን ዋን እስን ሆጄተን ሁንዳን እስን ኤብሴረ። እን ዴምሰ ዼራ እስን ገሞጂ በልኣ ከነ ኬሰ ዴምተንረት እስን ኤጌረ። <char style="nd">ዋቀዮ</char> ዋቅንኬሰን ወጎተ አፉርተመን ከኔን እስን ወጅን ቱሬ፤ እስንስ ዋን ቶኮሌ ህንዸብኔ።<verse eid="DEU 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 2:8"/>ኦቦሎተኬኘ እልማን ኤሳዉ ወረ ሴኢር ኬሰ ጅራተን ብረ ደበሬ ዴምኔ። ኑስ ዳንዲ አረባ ከን ኤላቲፊ ኤዝዮን ጌቤሪ ዹፉራ ገረገሌ ከራ ዳንዲ ገሞጂ ሞኣብ ዴምኔ።<verse eid="DEU 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 2:9"/>ኤርገሲስ <char style="nd">ዋቀዮ</char> አከነ ናን ጄዼ፤ “ዋን አን ለፈ ሞኣብራ እስኒፍ ህንኬንኔፍ አከሱማን እሳን ህንረክስና፤ ወራናፍስ እሳን ህንከካስና። አን ኣርን ዻለ ጎዼ ሰኚ ሎጢፍ ኬኔራቲ።”<verse eid="DEU 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 2:10"/>ኤሚሞን አች ጅራቻ ቱረን፤ እሳንስ ነሞተ ጀጀቦፊ ባይኤዸ፤ አኩመ አናቆታስ ዼዼሮ ቱረን። <verse eid="DEU 2:10"/><verse number="11" style="v" sid="DEU 2:11"/>እሳን ኩኔንስ አኩመ አናቆታ፣ ሬፋይሞተ ጄዸመኒ ሄደሙ ቱረን፤ ሞኣቦን ገሩ ኤሚሞተ ጄዹን። <verse eid="DEU 2:11"/><verse number="12" style="v" sid="DEU 2:12"/>ሁሮን ኩኔን ሴኢር ኬሰ ጅራቻ ቱረን፤ እልማን ኤሳዉ ገሩ አርአኒ አቺ እሳን ባሰን። እሳንስ አኩመ እስራኤሎን ብየ <char style="nd">ዋቀዮ</char> ዻለ እሳኒፍ ኬኔ ሰነ ኬሰት ጎዸን ሰነ ሆሮተ አቺ በሌሰኒ ኦፊሳኒቲ ብየ ጀራ ኬሰ ቁበተን።<verse eid="DEU 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 2:13"/>
    <char style="nd">ዋቀዮ</char>፣ “አሙመ ከኣቲ ለገ ዜሬድ ጬኣ” ኑን ጄዼ። ኑ ለገ ሰነ ጬኔ።<verse eid="DEU 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 2:14"/>ዬሮ ኑ ቃዴሽ በርኔ ካኔ ጀልቀቤ ሀመ ለገ ዜሬድ ጬኑት ወጋ ሶዶሚ ሰዴት ፉዸቴ። አኩመ <char style="nd">ዋቀዮ</char> እሳንት ከከቴት ዸሎትን ዺረ ወራና ሁንድ ዬሮ ሰነት ቁበተ ኬሳ ዹሜ። <verse eid="DEU 2:14"/><verse number="15" style="v" sid="DEU 2:15"/>ሀርክ <char style="nd">ዋቀዮስ</char> ቁበተ ኬሳ እሳን በሌሱዻፍ እሳንረ ቱሬ።<verse eid="DEU 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 2:16"/>ዬሮ ሎልቶትን ሁንድ ሰበ ኬሳ ዹመንት፣ <verse eid="DEU 2:16"/><verse number="17" style="v" sid="DEU 2:17"/><char style="nd">ዋቀዮ</char> አከነ ናን ጄዼ፤ <verse eid="DEU 2:17"/><verse number="18" style="v" sid="DEU 2:18"/>“አት ሀርአ ዳሪ ሞኣብ፣ ኣር ኬሰ ደበርተ። <verse eid="DEU 2:18"/><verse number="19" style="v" sid="DEU 2:19"/>ዮሙ አሞኖተት ዹፍተንት አከሱማን እሳን ህንረክስና ዮካን ወራናፍ እሳን ህንከካስና፤ አን ብየሳኒ ኬሳ ቶኮሌ ዻለ ጎዼ እስኒፍ ህንኬኑቲ። አን ብየሳኒ ሰኚ ሎጢፍ ሀንዹራ ጎዼ ኬኔረ።”<verse eid="DEU 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 2:20"/>ኩንስ ብየ ሬፋይሞተ አች ጅራቻ ቱረኒት ጄዸሜ ሄደመ፤ አሞኖትን ገሩ ዘምዙሞተ ጄዸኒ እሳን ዋሙ ቱሬ። <verse eid="DEU 2:20"/><verse number="21" style="v" sid="DEU 2:21"/>እሳንስ ነሞተ ጀጀቦፊ ባይኤዸ፤ አኩመ አናቆታ ዼዼሮ ቱረን። <char style="nd">ዋቀዮስ</char> ፉለ አሞኖተ አቺ እሳን ባሰኒ እዶሳኒ ቁበተን ሰና ዱራ እሳን በርበዴሴ። <verse eid="DEU 2:21"/><verse number="22" style="v" sid="DEU 2:22"/><char style="nd">ዋቀዮስ</char> ዮሙ ሆሮተ ፉለሳኒ ዱራ በሌሴት እልማን ኤሳዉ ከኔን ሴኢር ኬሰ ጅራቻ ቱረንስ አከሱመ ጎዼ። እሳንስ ጀረ አቺ ባሰኒ ሀመ ሀርኣት ብየሳኒ ኬሰ ጅራተን። <verse eid="DEU 2:22"/><verse number="23" style="v" sid="DEU 2:23"/>አዎተ ገንዶተ ሀመ ጋዛት ጅረን ኬሰ ጅራተንሞ ከፍቶሮትን ከፍቶሪ በአኒ ዹፈን ሱን በሌሰኒ እዶሳኒ ቁበተን።<verse eid="DEU 2:23"/></para>
  <para style="s1">ስሆን ሞቲን ሄሽቦን ሞአተሜ</para>
  <para style="p">
    <verse number="24" style="v" sid="DEU 2:24"/>“ከኣቲ ለገ አርኖን ጬኣ፤ አን ኩኖ፣ ስሆን አሞርቸ ሞቲ ሄሽቦኒቲፊ ብየሳሌ ደበርሴ ሀርከኬሰንት እስኒ ኬኔራቲ። ወራነ እት በናቲ ብየ ሰነ ቀበቹ ጀልቀባ። <verse eid="DEU 2:24"/><verse number="25" style="v" sid="DEU 2:25"/>አንስ ናስሱፊ ሶዳችሱኬሰን ሰቦተ ሰሚ ገድ ጅረን ሁንደት ቡሱ ሀርዹመ ነንጀልቀበ። እሳንስ ኦዱ ዋኤኬሰኒ ዸገአኒ ሰበቢኬሰኒፍ ሆለቱ፤ ናሱንስ እሳን ቀበተ።”<verse eid="DEU 2:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="DEU 2:26"/>አንስ አከነ ጄዼ ገሞጂ ቅዴሞት ኬሳ ስሆን ሞትቸ ሄሽቦኒት ኤርገሞተ ነጋ ነንኤርጌ፤ <verse eid="DEU 2:26"/><verse number="27" style="v" sid="DEU 2:27"/>“አከ ኑ ብየኬ ኬሳን ደርብኑ ኑ ኤየም። ኑ ከራ ጉድቸራ ህንጎሩ፤ ምርገትስ ገረ ብታትስ ህንጎሩ። <verse eid="DEU 2:27"/><verse number="28" style="v" sid="DEU 2:28"/>ዋን ኛትኑፊ ብሻን ዹግኑ ማለቃን ኑት ጉርጉር። አከ ሚለ ቆፋን አች ኬሰ ደበሩ ኑፍ ኤየም፤ <verse eid="DEU 2:28"/><verse number="29" style="v" sid="DEU 2:29"/>አኩመ እልማን ኤሳዉ ከኔን ሴኢር ኬሰ ጅራተኒፊ ሞኣቦን ኣር ኬሰ ጅራተን ኑፍ ጎዸን ሰነ አትስ ሀመ ኑ ገረ ብየ <char style="nd">ዋቀዮ</char> ዋቅንኬኘ ኑ ኬኑት ገሉፍ ለገ ዮርዳኖስ ጬኑት አከሱመ ኑፍ ጎዽ።” <verse eid="DEU 2:29"/><verse number="30" style="v" sid="DEU 2:30"/>ስሆን ሞቲን ሄሽቦን ገሩ አከ ኑ ደበሩ ኑፍ ኤየሙ ድዴ። <char style="nd">ዋቀዮ</char> ዋቅንኬሰን አኩመ አመ ጎዼ ከነ ደበርሴ ሀርከኬሰንት እሰ ኬኑፍ መታፊ ገራሳ ጀቤሴ ቱሬቲ።<verse eid="DEU 2:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="DEU 2:31"/>
    <char style="nd">ዋቀዮስ</char>፣ “ኩኖ፣ አን ስሆኒፊ ብየሳ ደበርሴ ሲፍ ኬኑ ጀልቀቤረ። አት ብየሳ ዻሉፍ ቀበቹ ጀልቀብ” ናን ጄዼ።<verse eid="DEU 2:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="DEU 2:32"/>ዮሙ ስሆኒፊ ጉቱማን ሎልቶተሳ ኑ ወራኑፍ ያሀዝት በአንት፣ <verse eid="DEU 2:32"/><verse number="33" style="v" sid="DEU 2:33"/><char style="nd">ዋቀዮ</char> ዋቅንኬኘ ደበርሴ ሀርከኬኘት እሰ ኑፍ ኬኔ፤ ኑስ እሰ፣ እልማንሳቲፊ ሎልቶተሳ ሁንደ ዾፍኔ። <verse eid="DEU 2:33"/><verse number="34" style="v" sid="DEU 2:34"/>ዬሮ ሰነትስ መጋላወንሳ ሁንደ ቀበትኔ ዺሮተ፣ ዱበርቶታፊ እጆሌ፣ ቶኮ ቶኮ መጋላወኒ ጉቱማን ጉቱት በርበዴስኔ። ነመ ቶኮሌ ህንሀምብፍኔ። <verse eid="DEU 2:34"/><verse number="35" style="v" sid="DEU 2:35"/>ገሩ ሆሪፊ ቦጁ መጋላወን ቀበትኔ ሰነ ኬሳ ቦጅኔ ኦፊኬኛፍ ፉዸትኔ። <verse eid="DEU 2:35"/><verse number="36" style="v" sid="DEU 2:36"/>መጋላ አሮኤር ከን ቀርቀረ ሱሉለ አርኖንት አርገሙፊ መጋላ ሱሉልቸ ኬሰት አርገሙ ጀልቀቤ መጋላ ሀመ ግልኣድት አርገሙ ኬሳ ቶኮዩ ኑ እትሱ ህንደንዴኜ። <char style="nd">ዋቀዮ</char> ዋቅንኬኘ ሁንደሳኒ ደበርሴ ኑፍ ኬኔ። <verse eid="DEU 2:36"/><verse number="37" style="v" sid="DEU 2:37"/>ገሩ አኩመ አጀጀ <char style="nd">ዋቀዮ</char> ዋቅንኬኘ ኑፍ ኬኔ ሰናት እስን ገረ ብዮተ አሞኖታ ቶኮትሌ ዮካን ገረ ብየ ቀርቀረ ለገ ያቦቅረት አርገሙ ዮካን ብዮተ ናኖ መጋላወን ጋረንረት አርገመኒት ህንደበሬ።<verse eid="DEU 2:37"/></para>
  <chapter eid="DEU 2"/>
  <chapter number="3" style="c" sid="DEU 3"/>
  <para style="s1">ኦግ ሞቲን ባሻን ሞአተሙሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 3:1"/>ኤርገሲስ ዴብኔ ከራ ባሻን ቀበትኔ ኦል ባኔ፤ ኦግ ሞትች ባሻንሞ ሎልቶተሳ ጉቱ ወጅን ኤድሬዪት ኑን ወል ሎሉፍ ገድ በኤ። <verse eid="DEU 3:1"/><verse number="2" style="v" sid="DEU 3:2"/><char style="nd">ዋቀዮስ</char>፣ “ዋን አን እሰ፣ ጉቱማ ሎልቶተሳቲፊ ብየሳሌ ደበርሴ ሀርከኬት ኬኔፍ እሰ ህንሶዳትን። አኩመ ስሆን ሞቲ አሞሮታ ከን ሄሽቦን ቡልቻ ቱሬ ሰነ ጎቴ እሰሌ ጎዽ” ናን ጄዼ።<verse eid="DEU 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="DEU 3:3"/>
    <char style="nd">ዋቀዮ</char> ዋቅንኬኘ ኦግ ሞቲ ባሻኒፊ ጉቱማ ሎልቶተሳ ደበርሴ ሀርከኬኘት ኬኔ። ኑስ ኡቱ ሆማ ህንሀምብስን እሳን በሌስኔ። <verse eid="DEU 3:3"/><verse number="4" style="v" sid="DEU 3:4"/>ዬሮ ሰነትስ መጋላወንሳ ሁንደ ቀበትኔ። መጋላወን ጃተመ ሞቱማ ኦግ ሞትቸ ባሻን ከኔን ኩታ ብየ አርጎብ ጀለ ቱረን ኬሳ ከን ኑ ህንቀበን ቶኮዩ ህንጅሩ። <verse eid="DEU 3:4"/><verse number="5" style="v" sid="DEU 3:5"/>መጋላወን ኩኔን ሁንድ ደላ ዸጋ ዼዼሮ፣ ከራፊ ደንቀራ ቀቡ ቱረን፤ አከሱመስ መጋላወን ደላ ህንቀብኔ ባይኤቱ ቱሬ። <verse eid="DEU 3:5"/><verse number="6" style="v" sid="DEU 3:6"/>ኑስ አኩመ ስሆን ሞቲ ሄሽቦን ጎኔ ሰነ ዺሮተ፣ ዱበርቶታፊ እጆሌ ቶኮ ቶኮ መጋላወኒ ጉቱማን ጉቱት በርበዴስኔ። <verse eid="DEU 3:6"/><verse number="7" style="v" sid="DEU 3:7"/>ሆሪፊ ቦጁ መጋላወንሳኒ ኬሳ ሳምኔ ሁንደ ገሩ ኦፊኬኛፍ ፉዸትኔ ገሌ።<verse eid="DEU 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 3:8"/>ዬሮ ሰነት ሞቶተ አሞሮታ ለማን ከነራ ከራ በአ ዮርዳኖስ ብየ ሱሉለ አርኖኒቲ ጀልቀቤ ሀመ ቱሉ ሄርሞንት ጅሩ ፉዸትኔ። <verse eid="DEU 3:8"/><verse number="9" style="v" sid="DEU 3:9"/>ሲዶኖትንስ ሄርሞን ከነ ሲርዮን ጄዸኒ ዋሙ፤ አሞሮትንሞ ሴኒር ጄዸኒ ዋሙ። <verse eid="DEU 3:9"/><verse number="10" style="v" sid="DEU 3:10"/>ኑስ መጋላወን ድሬረት አርገመን ሁንደ፣ ግልኣድ ሁንደ፣ ባሻኒ ሀመ ሰልካፊ ኤድሬዪት ጅሩ ሁንደ፣ መጋላወን ሞቱማ ኦግ ከኔን ባሻን ኬሰት አርገመን ሁንደ ቀበትኔ። <verse eid="DEU 3:10"/><verse number="11" style="v" sid="DEU 3:11"/>ጎሰ ሬፋይሞታ ኬሳ ኦግ ሞቲ ባሻን ቆፈቱ ሀፌ። ኩኖ ስሬንሳ ስቢለራ ሆጄተሜ ደልገ ዼርንሳ ዹንዹመ ሰገል በልእንሳሞ ዹንዹመ አፉር ቱሬ። ስሬን ኩንስ አመዩ ረባ አሞኖታ ኬሰት አርገመ።<verse eid="DEU 3:11"/></para>
  <para style="s1">ህረሙ ብየቲ</para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 3:12"/>አን ብየ ዬሮ ሰነት ቀበትኔ ኬሳ ብየ ከራ ካበ አሮኤሪቲን ቀርቀረ ሱሉለ አርኖን ጅሩት ደበሌ ወለካ ብየ ጋራ ግልኣድ መጋላወንሳ ወጅን ጎሰ ሩቤኒፊ ጋዲፍ ኬኔ። <verse eid="DEU 3:12"/><verse number="13" style="v" sid="DEU 3:13"/>ብየ ግልኣድ ከን ሀፌፊ ጉቱማ ባሻን ጄቹንስ ሞቱማ ኦግ ወለካ ጎሰ ምናሴቲፈን ኬኔ። ጉቱማን ኩታ አርጎብ ከን ባሻን ኬሳ ሱን ብየ ሬፋይሞታ ጄዸሜ ቤከመ ቱሬ። <verse eid="DEU 3:13"/><verse number="14" style="v" sid="DEU 3:14"/>ያኢር እልም ምናሴሞ ጉቱማ ኩታ አርጎብ ከን ሀመ ዳሪ ጌሹሮታቲፊ መአካቶታት ጅሩ ፉዸቴ፤ ብይ ሱንስ መቃሳቲን ሞጋፈሜ፤ ከናፉ ባሻን ሀመ ሀርኣት ሃቦት ያኢር ጄዸመ። <verse eid="DEU 3:14"/><verse number="15" style="v" sid="DEU 3:15"/>ግልኣድሞ ማኪሪፈን ኬኔ። <verse eid="DEU 3:15"/><verse number="16" style="v" sid="DEU 3:16"/>ወለካ ሱሉለሳ ገሩ ዳንጋ ጎቹዻን ግልኣዲ ጀልቀቤ ሀመ ሱሉለ አርኖንት፣ አቺሞ ቡልቺንሰ ዳንጋ አሞኖታ ከን ሀመ ለገ ያቦቅት ጅሩ ጎሰ ሩቤኒፊ ጋዲፈን ኬኔ። <verse eid="DEU 3:16"/><verse number="17" style="v" sid="DEU 3:17"/>ዳንጋንሳ ከራ ልጣቲን ዮርዳኖስ እሰ አረባ ኬሰት አርገሙ ሰናዸ፤ ኩንስ ክኔሬቲ ጀልቀቤ ሀመ ገላነ አረባ ከን ገላነ ሶግዳ ጄዸሙት ድሪሬ ተበ ጵስጋቲ ገድት አርገመ።<verse eid="DEU 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 3:18"/>አንስ ዬሮ ሰነት አከነ ጄዼን እስን አጀጄ፦ “<char style="nd">ዋቀዮ</char> ዋቅንኬሰን አከ ዻልተኒፍ ለፈ ከነ እስኒፍ ኬኔረ። ተኡስ ነሞትን ጀጀቦንኬሰን ሁንድ ወራናፍ ህዸተኒ ኦቦሎተኬሰን እስራኤሎተ ዱረ ገመት ጬኡ ቀብዱ። <verse eid="DEU 3:18"/><verse number="19" style="v" sid="DEU 3:19"/>ገሩ ኒቶትንኬሰን፣ እጆሌንኬሰኒፊ ሆሪንኬሰን መጋላወን አን እስኒፍ ኬኔ ኬሰ ሃቱረን፤ አን አከ እስን ሆሪ ባይኤ ቀብደን ቤካቲ። <verse eid="DEU 3:19"/><verse number="20" style="v" sid="DEU 3:20"/>ኩንስ ሀመ <char style="nd">ዋቀዮ</char> አኩመ እስን ቦቆቺሴ ሰነ ኦቦሎተኬሰን ቦቆቺሴ እሳኒንስ ለፈ <char style="nd">ዋቀዮ</char> ዋቅንኬሰን ዮርዳኖሲን ገመት እሳኒፍ ኬኑ ሰነ ዻለንት። ሰነ ቦዴ ቶኮን ቶኮንኬሰን ገረ ብየ አን ዻለ እስኒፍ ኬኔት ንዴብቱ።”<verse eid="DEU 3:20"/></para>
  <para style="s1">ሙሴን አከ ዮርዳኖስ ህንጬኔ ዾወሜ</para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 3:21"/>አንስ ዬሮ ሰነት አከነ ጄዼን እያሱ አጀጄ፦ “አት ዋን <char style="nd">ዋቀዮ</char> ዋቅንኬ ሞቶተ ከኔን ለማን ጎዼ ሁንደ እጀኬቲን አርግቴርተ። <char style="nd">ዋቀዮ</char>፣ ሞቱሞተ እስን እት ያተን ሁንደስ አከሱመ ንጎዸ። <verse eid="DEU 3:21"/><verse number="22" style="v" sid="DEU 3:22"/>እስን እሳን ህንሶዳትና፤ <char style="nd">ዋቀዮ</char> ዋቅንኬሰን መታንሳ እስኒፍ ሎላቲ።”<verse eid="DEU 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 3:23"/>ዬሮ ሰነት አን አከነ ጄዼ <char style="nd">ዋቀዮን</char> ነንከዸዼ፤ <verse eid="DEU 3:23"/><verse number="24" style="v" sid="DEU 3:24"/>“ያ <char style="nd">ዋቀዮ</char> ጎፍታ፣ አት ጉድነኬቲፊ ሀርከኬ ጀባ ሰነ ገርብቸኬት አርግሲሱ ጀልቀብዴርተ። ስላ ከን ሆጂ ጀባ አከሲ ከን አት ሆጄቱ ሆጄቹ ደንደኡ ዋቀ ከምቱ ሰሚረ ዮካን ለፈረ ጅረ? <verse eid="DEU 3:24"/><verse number="25" style="v" sid="DEU 3:25"/>አከ አን ጬኤ ብየቲ ጋሪ ዮርዳኖስ ገመ ጅርቱ ጄቹንስ ብየ ጋራ ጋሪ ሰናፊ ልባኖን አርጉ ና ኤየም።”<verse eid="DEU 3:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="DEU 3:26"/>
    <char style="nd">ዋቀዮ</char> ገሩ ዋን ሰበቢኬሰኒፍ ነት ዼከሜፍ፣ ነ ዸገኡ ድዴ። <char style="nd">ዋቀዮ</char> አከነ ናን ጄዼ፤ “ኩን ንገአ፤ ለመተ ዋኤ ዋን ከና ነት ህንዱበትን። <verse eid="DEU 3:26"/><verse number="27" style="v" sid="DEU 3:27"/>ፊጤ ጵስጋት ኦል በኢቲ ገረ ልጣፊ ካባ፣ ገረ ክባፊ በኣ እላል። አት ዋን ዮርዳኖስ ህንጬኔፍ ብየቲ እጁመኬቲን እላል። <verse eid="DEU 3:27"/><verse number="28" style="v" sid="DEU 3:28"/>ገሩ አከ እን ሰበ ከነ ቀጄልቼ ጬስሴ አከ እሳን ብየ አት እላልቱ ከነ ዻለን ጎዹፍ እያሱ አጀጅ፤ እሰ ጀጀቤስ፤ ጭምስስ።” <verse eid="DEU 3:28"/><verse number="29" style="v" sid="DEU 3:29"/>ኑ ሱሉለ ቤት ጴኦር ብረ ጅሩ ኬሰ ቱሬ።<verse eid="DEU 3:29"/></para>
  <chapter eid="DEU 3"/>
  <chapter number="4" style="c" sid="DEU 4"/>
  <para style="s1">ሴራፍ አጀጀሙ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 4:1"/>ያ እስራኤል፣ አጀጀወኒፊ ሴረወን አን እስን በርሲሱ ዸገኣ። አከ ጅራተኒፊ ዸቅጠኒ ብየ <char style="nd">ዋቀዮ</char> ዋቅን አቦቲኬሰኒ እስኒፍ ኬኑ ዻልተኒፍስ እሳን ዱካ ቡኣ። <verse eid="DEU 4:1"/><verse number="2" style="v" sid="DEU 4:2"/>አጀጀ <char style="nd">ዋቀዮ</char> ዋቀኬሰኒ ከን አን እስኒፍ ኬኑ ኤጋ መሌ ዋን ቶኮሌ እት ህንደበልና ዮካን እራ ህንህርእስና።<verse eid="DEU 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="DEU 4:3"/>እስን ዋን <char style="nd">ዋቀዮ</char> በኣል ጴኦርት ሆጄቴ እጁመኬሰኒን አርግተኒርቱ። <char style="nd">ዋቀዮ</char> ዋቅንኬሰን ወረ እስን ግዱዻ በኣል ጴኦር ዱካ ቡአን ሁንደ በሌሴረ፤ <verse eid="DEU 4:3"/><verse number="4" style="v" sid="DEU 4:4"/>እስን ወር <char style="nd">ዋቀዮ</char> ዋቀኬሰን ቀበተን ሁንድ ገሩ ሀመ ሀርኣት ሉቡዻን ጅራተን።<verse eid="DEU 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 4:5"/>ኩኖ፣ አከ እስን ብየ ዻሉፍ እት ገሉፍ ጅርተንት እሳን ዱካ ቡተኒፍ አን አኩመ <char style="nd">ዋቀዮ</char> ዋቅንኮ ነ አጀጄት አጀጀወኒፊ ሴረወን እስን በርሲሴረ። <verse eid="DEU 4:5"/><verse number="6" style="v" sid="DEU 4:6"/>ኩንስ አከ ሰቦትን ዋኤ አጀጀወን ከና ሁንደ ዸገአኒ፣ “ዹጉማን ሰብን ጉዳን ኩን ሰበ ኦጌሳፊ ሁበታዸ” ጄዸኒፍ ኦጉማፊ ሁበትናኬሰን ሰቦተት አርግሲሳቲ አከ ጋሪት እሳን ኤጋ። <verse eid="DEU 4:6"/><verse number="7" style="v" sid="DEU 4:7"/>ሰብን ጉዳን አከ ዬሮ ኑ <char style="nd">ዋቀዮ</char> ዋቀኬኘ ዋመኑት ኑት ዽኣቱ ሰነ ዋቆንሳኒ እት ዽኣተን ከን ብራ ከም? <verse eid="DEU 4:7"/><verse number="8" style="v" sid="DEU 4:8"/>ሰብን ጉዳን አጀጀወኒፊ ሴረ ቀጄላ አከ ሴረ አን ሀርአ ፉለኬሰን ዱረ ካኡ ከና ቀቡ ብራ ከም?<verse eid="DEU 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 4:9"/>አከ ዋን እጅኬ አርጌ ህንደገኔፍ ዮካን አከ ሀመ አት ሉቡዻን ጅርቱት ገራኬቲ ህንበድኔፍ ኦፉመ ኤገዹ፤ ጀባዹ ኦፍ ኤገዹ። ዋን ከነስ እጆሌኬቲፊ እጆሌ እጆሌ እጆሌኬቲ በርሲስ። <verse eid="DEU 4:9"/><verse number="10" style="v" sid="DEU 4:10"/>ጋፈ እስን ኮሬብት ፉለ <char style="nd">ዋቀዮ</char> ዋቀኬሰኒ ዱረ ዻበተን፣ ዬሮ እን፣ “አከ እሳን ሀመ ሉቡዻን ለፈረ ጅራተን ሁንደት ነ ሶዳቹ በረተኒ እጆሌ እጆሌሳኒሌ ነ ሶዳቹ በርሲሰኒፍ ዱቢኮ ሃዸገአኒቲ ነሞተ ወልት ቀብ” ናን ጄዼ ሰነ ያደዻ። <verse eid="DEU 4:10"/><verse number="11" style="v" sid="DEU 4:11"/>እስን ኡቱማ ቱሉን ሱን ቦበኣ እብደ ሀመ ዊርቱ ሰሚት ኦል በኤ ዱሜሰ ጉራቻፊ ዱከነ ልምጢዻን ሀጉገሜ ጅሩ እት ዽኣተኒ ሚለ ቱሉ ሰና ጀለ ዸዻበተን። <verse eid="DEU 4:11"/><verse number="12" style="v" sid="DEU 4:12"/>ኤርገሲስ <char style="nd">ዋቀዮ</char> እብደ ኬሳ እስንት ዱበቴ። እስንስ ሰገሌ ዱቢ ሰና መሌ ብፈ ቶኮሌ ህንአርግኔ፤ ሰገሌ ቶኮ ቆፈቱ ቱሬ። <verse eid="DEU 4:12"/><verse number="13" style="v" sid="DEU 4:13"/>እንስ ከኩሳ ጄቹንስ አጀጀወን ኩርነን አከ እስን እሳን ዱካ ቡተኒፍ እስን አጀጄ ሰነ እስኒፍ ለብሴ። ኤርገሲሞ ገበቴ ዸጋ ለመረት እሳን በሬሴ። <verse eid="DEU 4:13"/><verse number="14" style="v" sid="DEU 4:14"/><char style="nd">ዋቀዮስ</char> ዬሮ ሰነት አከ አን አጀጀወኒፊ ሴረወን ብየ እስን ዮርዳኖስ ጬተኒ ዻልተን ሰነ ኬሰት ዱካ ቡኡ ቀብደን እስን በርሲሱ ነ አጀጄ።<verse eid="DEU 4:14"/></para>
  <para style="s1">ዋቆተ ቶልፈሞ ዋቄፈቹን ዾዋዸ</para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 4:15"/>ጋፈ <char style="nd">ዋቀዮ</char> ኮሬብረት እብደ ኬሳ እስንት ዱበቴት እስን ብፈ ቶኮሌ ህንአርግኔ። ከናፉ ጀቤሳ ኦፍ ኤገዻ፤ <verse eid="DEU 4:15"/><verse number="16" style="v" sid="DEU 4:16"/>ኩንስ አከ እስን ህንጡሮፍኔ፣ አከ ዋቀ ቶልፈማ ብፈ ዺራቲን ዮካን ዱበርቲቲን ሶፈሜ ከምዩ ኦፊኬሰኒፍ ህንቶልፈትኔ <verse eid="DEU 4:16"/><verse number="17" style="v" sid="DEU 4:17"/>ዮካን ሆሪ ለፈረ ጅራቱ ዮካን ስምብረ ሰሚ ኬሰ በርሱ ከምዩ <verse eid="DEU 4:17"/><verse number="18" style="v" sid="DEU 4:18"/>ዮካን ኡመመ ለፈረ ሙኙቁ ከምዩ ዮካን ቁርጡሚ ለፈ ጀለ ብሻን ኬሰ ጅራቱ ከምዩ ህንቶልፈኔፍ። <verse eid="DEU 4:18"/><verse number="19" style="v" sid="DEU 4:19"/>አት ዮሙ ሰሚ ኦል እላልቴ አዱ፣ ጅአ፣ ኡርጂወኒፊ ራያ ሰሚ ሁንደ አርግቱት ጎዎምፈምቴ ፉለ ዋን <char style="nd">ዋቀዮ</char> ዋቅንኬ ሰቦተ ሰሚዻ ገዲ ሁንዳፍ ቆዴ ኬኔ ዱረት ገድ ጄቴ ህንሰገድን። <verse eid="DEU 4:19"/><verse number="20" style="v" sid="DEU 4:20"/><char style="nd">ዋቀዮ</char> ገሩ አከ እስን አኩመ አመ ጅርተን ከነ ዻለሳ ታተኒፍ በዳ ስቢለ እት በቅሰን ጄቹንስ ብየ ግብጢቲ ባሴ እስን ፍዴ።<verse eid="DEU 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 4:21"/>
    <char style="nd">ዋቀዮስ</char> ሰበቢኬሰኒፍ ነት ዼከሜ አከ አን ለገ ዮርዳኖስ ጬኤ ብየ ጋሪ ከን <char style="nd">ዋቀዮ</char> ዋቅንኬሰን ዻለ ጎዼ እስኒፍ ኬኑ ሰነ ህንሴኔ ከከቴ። <verse eid="DEU 4:21"/><verse number="22" style="v" sid="DEU 4:22"/>አን ብዩመ ከነት ነንዱአ፤ አን ዮርዳኖስን ህንጬኡ፤ እስን ገሩ ጬተኒ ብየ ጋሪ ሰነ ዻሉፍ ጅርቱ። <verse eid="DEU 4:22"/><verse number="23" style="v" sid="DEU 4:23"/>አከ ከኩ <char style="nd">ዋቀዮ</char> ዋቅንኬሰን እስን ወጅን ገሌ ሰነ ህንደገትኔ ኦፍ ኤገዻ፤ ዋቆተ ቶልፈሞ <char style="nd">ዋቀዮ</char> ዋቅንኬሰን እስን ዾዌ ብፈ ከሚንዩ ኦፊኬሰኒፍ ህንቶልፈትና። <verse eid="DEU 4:23"/><verse number="24" style="v" sid="DEU 4:24"/><char style="nd">ዋቀዮ</char> ዋቅንኬሰን እብደ ጉቤ በሌሱዻቲ፤ ዋቀ ህናፉዸስ።<verse eid="DEU 4:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DEU 4:25"/>እስን ኤርገ እጆሌፊ እጆሌ እጆሌኬሰኒ ሆርተኒ ብየ ሰነ ኬሰ በረ ዼራ ጅራተኒ ቦዴ፣ ዮ ጡሮፍተኒ ፈኪ ዋቆተ ቶልፈሞ ብፈ ከሚዩ ቶልችተኒ ፉለ <char style="nd">ዋቀዮ</char> ዋቀኬሰኒ ዱረት ዋን ሀማ ሆጄተኒ ዼከምሳፍ እሰ ከካፍተን፣ <verse eid="DEU 4:25"/><verse number="26" style="v" sid="DEU 4:26"/>አከ እስን ብየ ዮርዳኖስ ጬተኒ ዻልተንራ አሪቲዻን ዸበምተን አን ጉያ ሀርኣ ሰሚፊ ለፈ ዹጋ ባቶተ ጎዼ እስንት ነንዋመ። እዶ ሰነ ዬሮ ዼራ ህንጅራተን፤ እስን ጉቱማን ጉቱት በርበዶፍቱ። <verse eid="DEU 4:26"/><verse number="27" style="v" sid="DEU 4:27"/><char style="nd">ዋቀዮስ</char> ሰቦተ ኬሰ እስን ፈፈጫሰ፤ ሰቦተ ወረ <char style="nd">ዋቀዮ</char> እሳን ግዱት እስን ፈፈጫሴ ኬሰትስ ሙራሰ ታተኒ ሀፍቱ። <verse eid="DEU 4:27"/><verse number="28" style="v" sid="DEU 4:28"/>እስንስ አችት ዋቆተ ሀርከ ነማቲን ሙካፊ ዸጋራ ሆጄተመን ከኔን አርጉ ዮካን ዸገኡ ዮካን ኛቹ ዮካን ፉንፈቹ ህንደንዴኜ ዋቄፈቱ። <verse eid="DEU 4:28"/><verse number="29" style="v" sid="DEU 4:29"/>ገሩ ዮ አችትስ <char style="nd">ዋቀዮ</char> ዋቀኬሰን በርባደን ንአርገቱ፤ እስን ዮ ገራፊ ያደኬሰን ጉቱዻን እሰ በርባደን ንአርገቱ። <verse eid="DEU 4:29"/><verse number="30" style="v" sid="DEU 4:30"/>ዮሙ ዽጰቴ ወን ኩን ሁንድ ስት ዹፉት፣ በሮተ ዹፉፍ ጅረን ኬሰ ገረ <char style="nd">ዋቀዮ</char> ዋቀኬቲት ንዴብተ፤ እሳፍስ ንአጀጀምተ። <verse eid="DEU 4:30"/><verse number="31" style="v" sid="DEU 4:31"/><char style="nd">ዋቀዮ</char> ዋቅንኬ ዋቀ አራራት፤ እን ስ ህንገቱ ዮካን ስ ህንበሌሱ ዮካን ከኩ አቦቲኬቲፍ ከከቴ ሰነ ህንደገቱ።<verse eid="DEU 4:31"/></para>
  <para style="s1">
    <char style="nd">ዋቀዮ</char> ዋቀ</para>
  <para style="p">
    <verse number="32" style="v" sid="DEU 4:32"/>ዋኤ በሮተ ዱሪ ከን ኡቱ አት ህንዸለትን ዱረ ጋፈ ዋቀዮ ለፈረት ነመ ኡሜ ጀልቀቤ ቱሬ ሰነ እያፈዻ፤ ዳሪ ሰሚ ቶኮራ ሀመ ዳሪ ካኒት እያፈዻ። ወን ጉዳን አከና ተኩማ ኡመሜ ዮካን ወን አከና ተኩማ ዸገአሜ ቤካ? <verse eid="DEU 4:32"/><verse number="33" style="v" sid="DEU 4:33"/>ሰብን አከኬሰን ሰገሌ ዋቃ ከን እብደ ኬሳ ዱበቱ ዸገኤ ሉቡዻን ጅራቴ ከን ብራ ተኩማ አርገሜራ? <verse eid="DEU 4:33"/><verse number="34" style="v" sid="DEU 4:34"/>ዋቅን ከምዩ ተኩማ አከ <char style="nd">ዋቀዮ</char> ዋቅንኬሰን ኡቱመ እጅኬሰን አርጉ ብየ ግብጥት እስኒ ጎዼ ሰነ ሰበ ቶኮ ሰበ ብራ ኬሳ ቆሩምሳን፣ መለቶፊ ድንቂዻን፣ ወራናን፣ ሀርከ ጀባፊ እሬ ድሪርፈሜን፣ ዮካን ሆጂ ጉዳፊ ሶዳችሳዻን ባሴ ከን ኦፊሳ ጎዸቹ ያሌ ጅረ?<verse eid="DEU 4:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="DEU 4:35"/>እስንስ <char style="nd">ዋቀዮ</char> ዋቀ ተኡሳ አከ ቤክተኒፍ ወንቶትን ኩኔን እስንት አርግሲፈመን፤ እሰ መሌስ ከን ብራ ህንጅሩ። <verse eid="DEU 4:35"/><verse number="36" style="v" sid="DEU 4:36"/>እን ስ አደበቹፍ ጄዼ ሰሚዻ ሰገሌሳ ስ ዸጌስሴ። ለፈረት እብደሳ ጉድቸ ስት አርግሲሴ አትስ እብደ ኬሳ ዱቢሳ ዸጌሴ። <verse eid="DEU 4:36"/><verse number="37" style="v" sid="DEU 4:37"/>እን ዋን አቦቲኬ ጃለቴ እሳን ቦዴስ ሰኚወንሳኒ ፍለቴፍ ኦፊሳቲን ሁምነሳ ጉዳዻን ብየ ግብጢቲ ባሴ እስን ፍዴ፤ <verse eid="DEU 4:37"/><verse number="38" style="v" sid="DEU 4:38"/>ከነስ አከ ሀርአ ተኤ ጅሩ ከነ ሰቦተ ስ ጫላ ጉርጉዳፊ ጀጀቦ ስ ዱራ አርኤ ብየሳኒ ዻለ ጎዼ ሲፍ ኬኑፍ እት ስ ፍዴ።<verse eid="DEU 4:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="DEU 4:39"/>ሀርአ አከ <char style="nd">ዋቀዮ</char> ኦል ሰሚ ጉባት፣ ገድ ለፈረትስ ዋቀ ተኤ ቤክ፤ ገራ ኬትስ ቀበዹ። ከን ብራስ ህንጅሩ። <verse eid="DEU 4:39"/><verse number="40" style="v" sid="DEU 4:40"/>አከ ሲፊ እጆሌኬ ወረ ስኢን ዱባቲፍ ቶሉፊ አከ ብየ <char style="nd">ዋቀዮ</char> ዋቅንኬ በረ በራን ሲፍ ኬኑት ኡሙሪንኬ ዼረቱፍ ቀጄልቸወኒፊ አጀጀወንሳ ከኔን አን ሀርአ ሲፍ ኬኑ ኤግ።<verse eid="DEU 4:40"/></para>
  <para style="s1">መጋላወን እት ኮሉ ገለን</para>
  <para style="r">
    <ref loc="DEU 4:41-43">4፥41‑43</ref> ኩወእ – <char style="xt"><ref loc="NUM 35:6-34">ለኮ 35፥6‑34</ref>፤ <ref loc="DEU 19:1-14">ኬዴ 19፥1‑14</ref>፤ <ref loc="JOS 20:1-9">እያ 20፥1‑9</ref></char></para>
  <para style="p">
    <verse number="41" style="v" sid="DEU 4:41"/>ዬሮ ሰነት ሙሴን መጋላወን በአ ዮርዳኖስ ሰዲ አዳን ባፈቴ፤ <verse eid="DEU 4:41"/><verse number="42" style="v" sid="DEU 4:42"/>ኩንስ ለፈ ነምን ነመ አጄሴ ዮ ኡቱ እት ህንያድን ነመ አጄሴ እት በቀቱዸ። እንስ መጋላወን ከኔን ኬሳ ቶኮት በቀቴ ሉቡሳ ኦልፈቹ ደንደአ። <verse eid="DEU 4:42"/><verse number="43" style="v" sid="DEU 4:43"/>መጋላወን ሱንስ ከኔን ቱረን፦ ቤዜር ከን ገሞጂ ኬሰ ተበረ ጅርቱ ጎሰ ሩቤኒፍ፣ ራሞት ከን ግልኣድት አርገምቱ ጎሰ ጋዲፍ፣ ጎላን ከን ባሻንት አርገምቱሞ ጎሰ ምናሴፍ።<verse eid="DEU 4:43"/></para>
  <para style="s1">እብሰ ሴርቸረት ኬነሜ</para>
  <para style="p">
    <verse number="44" style="v" sid="DEU 4:44"/>ኩን ሴረ ሙሴን እስራኤሎተ ዱረ ካኤዸ። <verse eid="DEU 4:44"/><verse number="45" style="v" sid="DEU 4:45"/>ቀጄልች፣ አጀጅኒፊ ሴር ሙሴን ዮሙ እሳን ብየ ግብጢ በአንት እስራኤሎታፍ ኬኔ ከናዸ፤ <verse eid="DEU 4:45"/><verse number="46" style="v" sid="DEU 4:46"/>ኩንስ ዬሮ እሳን ሱሉለ ቤት ጴኦር ብየ በአ ዮርዳኖስት አርገምቱ ኬሰ ቱረንት ተኤ፤ ብይ ኩንስ ብየ ስሆን ሞቲ አሞሮታ ከን ሄሽቦን ኬሰ ጅራቻ ቱሬ ሙሴፊ እስራኤሎን ዬሮ ብየ ግብጢ በአንት እሰ ሞአተኒት። <verse eid="DEU 4:46"/><verse number="47" style="v" sid="DEU 4:47"/>እሳንስ ብየሳቲፊ ብየ ኦግ ሞትቸ ባሻን ጄቹንስ ብዮተ ሞቶተ አሞሪ ለማን በአ ዮርዳኖስት አርገመን ዻለ ጎዸኒ ፉዸተን። <verse eid="DEU 4:47"/><verse number="48" style="v" sid="DEU 4:48"/>ብይ ኩንስ አሮኤር ከን ዳሪ ሱሉለ አርኖኒ ጀልቀቤ ሀመ ጋረ ስሆንት ጄቹንስ ሀመ ሄርሞኒት በልአተ፤ <verse eid="DEU 4:48"/><verse number="49" style="v" sid="DEU 4:49"/>እንስ አረባ በአ ዮርዳኖሲ ሀመ ገላነ አረባት ጅሩ ከን ተበ ጵስጋቲ ገድት አርገሙ ሁንደ ደበለተ።<verse eid="DEU 4:49"/></para>
  <chapter eid="DEU 4"/>
  <chapter number="5" style="c" sid="DEU 5"/>
  <para style="s1">አጀጀወን ኩርነን</para>
  <para style="r">
    <ref loc="DEU 5:6-21">5፥6‑21</ref> ኩወፈ – <char style="xt"><ref loc="EXO 20:1-17">በኡ 20፥1‑17</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 5:1"/>ሙሴን እስራኤሎተ ሁንደ ወልት ቀቤ አከነ እሳኒን ጄዼ፦</para>
  <para style="p" vid="DEU 5:1">ያ እስራኤል አጀጀወኒፊ ሴረወን አን ሀርአ ኡቱመ እስን ዸጌሰኑ ለብሱ ከነ ዸገኣ። በረዻቲ ጀቤሳ እሳን ዱካ ቡኣ። <verse eid="DEU 5:1"/><verse number="2" style="v" sid="DEU 5:2"/><char style="nd">ዋቀዮ</char> ዋቅንኬኘ ኮሬብት ኑ ወጅን ከኩ ገሌ። <verse eid="DEU 5:2"/><verse number="3" style="v" sid="DEU 5:3"/><char style="nd">ዋቀዮ</char> ከኩ ከነ ኑ ወጅን፣ ኑ ወረ ሀርአ ሉቡዻን አስ ጅራትኑ ሁንደ ወጅን ገሌ መሌ አቦቲኬኘ ወጅን ህንገሌ። <verse eid="DEU 5:3"/><verse number="4" style="v" sid="DEU 5:4"/><char style="nd">ዋቀዮ</char> ቱሉረት እብደ ኬሳ እፋን እፈት እስንት ዱበቴ። <verse eid="DEU 5:4"/><verse number="5" style="v" sid="DEU 5:5"/>ዬሮ ሰነት ዋን እስን እብደ ሶዳተኒ ቱሉት ኦል ህንበእኒፍ አን ዱቢ <char style="nd">ዋቀዮ</char> እስንት ህሙፍ እስኒፊ <char style="nd">ዋቀዮ</char> ግዱን ዻበዼ።</para>
  <para style="p" vid="DEU 5:5">እንስ አከነ ጄዼ፦<verse eid="DEU 5:5"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="6" style="v" sid="DEU 5:6"/>“አን <char style="nd">ዋቀዮ</char> ዋቀኬ ከን ግብጢ፣ ብየ ገርቡማቲ ስ ባሴዸ።<verse eid="DEU 5:6"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="7" style="v" sid="DEU 5:7"/>“አት አነ መሌ ዋቆተ ብራ ቶኮሌ ህንቀባትን።<verse eid="DEU 5:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="DEU 5:8"/>አት ብፈ ዋን ኦል ሰሚ ጉባ ዮካን ገድ ለፈረ ዮካን ብሻን ለፈ ጀላ ኬሰ ጅሩ ዋቀ ቶልፈማ ከሚቲንዩ ኦፊኬቲፍ ህንቶልፈትን። <verse eid="DEU 5:8"/><verse number="9" style="v" sid="DEU 5:9"/>እሳኒፍ ህንሰገድን ዮካን እሳን ህንዋቄፈትን፤ አን <char style="nd">ዋቀዮ</char> ዋቅንኬ፣ ዋቀ ህናፉ ከን እጆሌ ወረ ነ ጅበኒ ሰበቢ ጩቡ አቦቲቲፍ ጄዼ ሀመ ዸሎተ ሰዲፊ አፉሪት አደቤ <verse eid="DEU 5:9"/><verse number="10" style="v" sid="DEU 5:10"/>ወረ ነ ጃለተኒ አጀጀወንኮ ኤገንሞ ሀመ ዸሎተ ኩማት ጃለቱዸ።<verse eid="DEU 5:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="DEU 5:11"/>መቃ <char style="nd">ዋቀዮ</char> ዋቀኬቲ አከሱማን ህንዸእን፤ <char style="nd">ዋቀዮ</char> ወረ አኩመ አርገን መቃሳ ዸአን ኡቱ ህንአደብን ህንዺሱቲ።<verse eid="DEU 5:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="DEU 5:12"/>አኩመ <char style="nd">ዋቀዮ</char> ዋቅንኬ ስ አጀጄት ጉያ ሰንበታ ቁልቁሌሱዻን ኤግ። <verse eid="DEU 5:12"/><verse number="13" style="v" sid="DEU 5:13"/>ጉዮተ ጀአ ሆጄዹ፤ ሆጂኬ ሁንደስ ሆጄተዹ፤ <verse eid="DEU 5:13"/><verse number="14" style="v" sid="DEU 5:14"/>ጉያን ቶርበፋን ገሩ ሰንበተ <char style="nd">ዋቀዮ</char> ዋቀኬቲት። ጋፈስ ሆጂ ቶኮሌ ህንሆጄትን፤ አት ዮካን እልምኬ ዮካን እንተልኬ ዮካን ሆጄታንኬ ዮካን ጦምቦሬንኬ ዮካን ቆትዮንኬ ዮካን ሀሬንኬ ዮካን ሆሪንኬ ከምዩ ዮካን አለጋን መጋላኬ ኬሰ ጅራቱ ቶኮዩ ሆማ ህንሆጄትን። ሆጄታንኬቲፊ ሆጄቱንኬ አኩመኬ ሃቦቆተን። <verse eid="DEU 5:14"/><verse number="15" style="v" sid="DEU 5:15"/>አከ አትስ ብየ ግብጥት ገርበ ቱርቴፊ ኤርገሲሞ <char style="nd">ዋቀዮ</char> ዋቅንኬ ሀርከ ጀባፊ እሬ ድሪርፈሜን አቺ ስ ባሴ ያደዹ። ከናፉ <char style="nd">ዋቀዮ</char> ዋቅንኬ አከ አት ሰንበተ ኤግዱ ስ አጀጄ።<verse eid="DEU 5:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="DEU 5:16"/>አከ ብየ <char style="nd">ዋቀዮ</char> ዋቅንኬ ሲፍ ኬኑ ኬሰ በረ ዼራ ጅራቱፊ አከ ስት ቶሉፍ አኩመ <char style="nd">ዋቀዮ</char> ዋቅንኬ ስ አጀጄት አባኬቲፊ ሃዸኬቲፍ ኡልፍነ ኬን።<verse eid="DEU 5:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="DEU 5:17"/>ህንአጄስን።<verse eid="DEU 5:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="DEU 5:18"/>ህንኤጅን።<verse eid="DEU 5:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="DEU 5:19"/>ህንሀትን።<verse eid="DEU 5:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="DEU 5:20"/>ኦላኬት ሶባን ዹጋ ህንበእን።<verse eid="DEU 5:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="DEU 5:21"/>ኒቲ ነማ ህንሀውን። መነ ነማ ዮካን ለፈ ቆቲሳ ዮካን ሆጄታ ዮካን ጦምቦሬሳ፣ ቆትዮሳ ዮካን ሀሬሳ፣ ዮካን ዋን ነማ ከምዩ ህንሀውን።”<verse eid="DEU 5:21"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="22" style="v" sid="DEU 5:22"/>አጀጀወን <char style="nd">ዋቀዮ</char> ቱሉ ጉባት፣ እብደ፣ ዱሜሳፊ ዱከነ ልምጢ ኬሰ ወልዳኬሰን ጉቱት ሰገሌ ጉዳዻን ለብሴ ከኔኒዸ፤ ወን እን እት ደበሌስ ህንጅሩ። ኤርገሲስ እን አጀጀወን ሰነ ገበቴወን ዸጋ ለመረት በሬሴ ነት ኬኔ።<verse eid="DEU 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 5:23"/>ዬሮ እስን ኡቱ ቱሉን ሱን እብዳን ቦበኡ ዱከነ ኬሳ ሰገሌ ሰነ ዸጌሰንት፣ ሆገንቶትን ጎሶተኬሰኒቲፊ ማንጉዶትንኬሰን ሁንድ ገረኮ ዹፈን። <verse eid="DEU 5:23"/><verse number="24" style="v" sid="DEU 5:24"/>እስንስ አከነ ጄተን፤ “ኩኖ <char style="nd">ዋቀዮ</char> ዋቅንኬኘ ኡልፍናፊ ጉድነሳ ኑ አርግሲሴረ፤ እብደ ኬሳስ ሰገሌሳ ኑ ዸጌስሴረ። ኑ ሀርአ አከ ነምን ዮ ዋቅን እሰት ዱበቴሌ ጅራቹ ደንደኡ አርግኔረ። <verse eid="DEU 5:24"/><verse number="25" style="v" sid="DEU 5:25"/>አመ ገሩ ኑ ማሊፍ ዱነ? ኑ ዮ ሰገሌ <char style="nd">ዋቀዮ</char> ዋቀኬኛ ዴብኔ ዸጌኜ ንዱነ፤ እብዲ ጉዳን ኩንስ ኑ በርበዴሰ። <verse eid="DEU 5:25"/><verse number="26" style="v" sid="DEU 5:26"/>ነመ ዱኣ ህንኦሌ ሁንደ ኬሳ ኤኙቱ ተኩማ ሰገሌ ዋቀ ጅራታ እብደ ኬሳ ዱበቱ ዸገኤ አከ ኑ ዸጌኜ ጅራትኔ ከነ ኡቱ ህንዱእን ሀፌ? <verse eid="DEU 5:26"/><verse number="27" style="v" sid="DEU 5:27"/>እት ዽኣዹቲ ዋን <char style="nd">ዋቀዮ</char> ዋቅንኬኘ ጄዹ ሁንደ ዸገእ። ኤርገሲሞ ዋን <char style="nd">ዋቀዮ</char> ዋቅንኬኘ ስት ህሙ ሁንደ ኑት ህም። ኑ ንዸጌፈትና፤ ንአጀጀምነስ።”<verse eid="DEU 5:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="DEU 5:28"/>
    <char style="nd">ዋቀዮ</char> ዮሙ እስን ነት ዱበተንት እስን ዸገኤረ፤ <char style="nd">ዋቀዮስ</char> አከነ ናን ጄዼ፤ “አን ዋን ነሞትን ኩኔን ሲን ጄዸን ዸገኤረ። ወን እሳን ጄዸን ሁንድኑ ጋሪዸ። <verse eid="DEU 5:28"/><verse number="29" style="v" sid="DEU 5:29"/>አከ ሀመ በረ በራት እሳኒፊ እጆሌ እሳኒት ቶሉፍ እሳን ኡቱ ዬሮ ሁንደ ገራ ነ ሶዳቴ አጀጀኮ ሁንደ ኤጉ ቀባተኒ አከም ጋሪ ቱሬ!<verse eid="DEU 5:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="DEU 5:30"/>“ዸቂቲ፣ ‘ዱንካነኬሰንት ዴብኣ’ ጄዺን። <verse eid="DEU 5:30"/><verse number="31" style="v" sid="DEU 5:31"/>አት ገሩ አሱመ ነ ብረ ቱር። አን አጀጀወን፣ ቀጄልፈመወኒፊ ሴረወን አት አከ እሳን ብየ አን ዻለ ጎዼ እሳኒፍ ኬኑ ኬሰት ኤገኒፍ እሳን በርሲፍቱ ሁንደ ስት ነንህመ።”<verse eid="DEU 5:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="DEU 5:32"/>ከናፉ ዋን <char style="nd">ዋቀዮ</char> ዋቅንኬሰን እስን አጀጄ ኦፍ ኤገናዻን ኤጋ፤ ምርገት ዮካን ብታት ህንጎርና። <verse eid="DEU 5:32"/><verse number="33" style="v" sid="DEU 5:33"/>አከ ብየ ዻልተን ኬሰ ጅራቹ ደንዴሰን፣ አከ እስንት ቶሌ ኡሙሪ ዼራሌ ቀባተኒፍ ከራ <char style="nd">ዋቀዮ</char> ዋቅንኬሰን እስን አጀጄ ሁንደረ ዴማ።<verse eid="DEU 5:33"/></para>
  <chapter eid="DEU 5"/>
  <chapter number="6" style="c" sid="DEU 6"/>
  <para style="s1">
    <char style="nd">ዋቀዮ</char> ዋቀኬ ጃለዹ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 6:1"/>አጀጀወን፣ ቀጄልፈመወኒፊ ሴር እስን ዬሮ ብየ ዮርዳኖስ ጬተኒ ዻልተንት ኤግደን ከኔን አከ አን እስን በርሲሱፍ <char style="nd">ዋቀዮ</char> ዋቅንኬሰን ነ አጀጄ ከኔኒዸ፤ <verse eid="DEU 6:1"/><verse number="2" style="v" sid="DEU 6:2"/>ኩንስ አከ በረ ጅሬኘኬሰኒ ጉቱ እስን፣ እጆሌንኬሰኒፊ እጆሌን እጆሌኬሰኒ ቀጄልፈመወኒፊ አጀጀወን አን እስኒፍ ኬኑ ሁንደ ኤጉዻን <char style="nd">ዋቀዮ</char> ዋቀኬሰን ሶዳተኒ ኡሙሪንኬሰን ዼረቱፍ። <verse eid="DEU 6:2"/><verse number="3" style="v" sid="DEU 6:3"/>ያ እስራኤል ዸገእ፤ አከ ብየ ኣነኒፊ ደም ኬሳ ቡርቁ ሰነ ኬሰት አኩመ <char style="nd">ዋቀዮ</char> ዋቅን አቦቲኬቲ ስ አብደቺሴ ሰነት ስት ቶሌ ጉዳ ባይአቱፍ አጀጀም።<verse eid="DEU 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="DEU 6:4"/>ያ እስራኤል ዸገእ፤ <char style="nd">ዋቀዮ</char> ዋቅንኬኘ <char style="nd">ዋቀዮ</char> ቶክቸ። <verse eid="DEU 6:4"/><verse number="5" style="v" sid="DEU 6:5"/>ገራኬ ጉቱዻን፣ ያደኬ ጉቱዻን፣ ሁምነኬ ጉቱዻን <char style="nd">ዋቀዮ</char> ዋቀኬ ጃለዹ። <verse eid="DEU 6:5"/><verse number="6" style="v" sid="DEU 6:6"/>አጀጀወን አን ሀርአ ሲፍ ኬኑ ኩኔን ገራኬ ኬሰ ሃጅራተን። <verse eid="DEU 6:6"/><verse number="7" style="v" sid="DEU 6:7"/>እጆሌኬስ ጭምሲ በርሲስ። ዬሮ መነ ቴሱ፣ ዬሮ ከራ ዴምቱ፣ ዬሮ ጪፍቱፊ ዬሮ ደመቅጡት ዋኤሳኒ ኦዴስ። <verse eid="DEU 6:7"/><verse number="8" style="v" sid="DEU 6:8"/>አከ መለቶት ሀርከት ህዸዹ፤ አደኬረትስ መጠንፈዹ። <verse eid="DEU 6:8"/><verse number="9" style="v" sid="DEU 6:9"/>ምችችለወን በልበለ መነኬቲቲፊ ከረወንኬረትስ እሳን በሬስ።<verse eid="DEU 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 6:10"/>ዬሮ <char style="nd">ዋቀዮ</char> ዋቅንኬ ብየ መጋላወን ጉርጉዳፊ በበሬዶ ከኔን አት ህንእጃርን ሲፍ ኬኑፍ ገረ ብየ አቦቲኬ ጄቹንስ አብረሃሚፍ፣ ይስሃቂፊ ያቆቢፍ ከከቴ ሰነት ስ ገልቹት፣ <verse eid="DEU 6:10"/><verse number="11" style="v" sid="DEU 6:11"/>ዬሮ መኔን ምአ ጎሰ ሁንዳ ከን አት ህንጉተትኒን ጉተሜ፣ ቦለ ብሻኒ ከን አት ህንቆትን፣ ሙኬን ወይኒቲፊ ኤጄርሳ ከኔን አት ህንዻብን ሲፍ ኬነመኒ አትስ ኛቴ ቁፍቱት፣ <verse eid="DEU 6:11"/><verse number="12" style="v" sid="DEU 6:12"/>አት አከ <char style="nd">ዋቀዮ</char> ብየ ግብጥ፣ ብየ ገርቡማቲ ስ ባሴ ሰነ ህንደገትኔ ኦፍ ኤገዹ።<verse eid="DEU 6:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 6:13"/>
    <char style="nd">ዋቀዮን</char> ዋቀኬ ሶዳዹ፤ እሱመ ቆፈ ተጃጅል፤ መቃሳቲንስ ከከዹ። <verse eid="DEU 6:13"/><verse number="14" style="v" sid="DEU 6:14"/>ዋቆተ ብራ ጄቹንስ ዋቆተ ሰቦተ ናኖኬቲ ዱካ ህንቡእን፤ <verse eid="DEU 6:14"/><verse number="15" style="v" sid="DEU 6:15"/>ሰበቢ <char style="nd">ዋቀዮ</char> ዋቅንኬ እን ግዱኬ ጅራቱ ሱን ዋቀ ህናፉ ተኤፍ፣ ኣሪንሳ ስረት ቦበኤ ለፈራ ስ በሌሰ። <verse eid="DEU 6:15"/><verse number="16" style="v" sid="DEU 6:16"/>አከ ማሳህ ኬሰት ጎተን ሰነ <char style="nd">ዋቀዮ</char> ዋቀኬሰን ህንቆርና። <verse eid="DEU 6:16"/><verse number="17" style="v" sid="DEU 6:17"/>አጀጀወን <char style="nd">ዋቀዮ</char> ዋቀኬሰኒ፣ ቀጄልፈመወኒፊ ሴረወን እን እስኒፍ ኬኔ አከ ጋሪት ኤጋ። <verse eid="DEU 6:17"/><verse number="18" style="v" sid="DEU 6:18"/>አከ ስት ቶሉፊ አከ ብየ ጋሪ <char style="nd">ዋቀዮ</char> አቦቲኬቲፍ ኬኑፍ ከከቴ ሰነ ሴንቴ ዻልቱፍ ዋን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ቀጄላፊ ጋሪ ተኤ ሆጄዹ። <verse eid="DEU 6:18"/><verse number="19" style="v" sid="DEU 6:19"/>አት አኩመ <char style="nd">ዋቀዮ</char> ጄዼ ሰነት ዲኖተኬ ሁንደ ፉለኬ ዱራ ንባፍተ።<verse eid="DEU 6:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 6:20"/>ገረ ፉል-ዱራት ዮ እልምኬ፣ “ሂካን ቀጄልቸወኒ፣ አጀጀወኒቲፊ ሴረወን <char style="nd">ዋቀዮ</char> ዋቅንኬኘ እስን አጀጄ ከና ማል?” ጄዼ ስ ጋፈቴ፣ <verse eid="DEU 6:20"/><verse number="21" style="v" sid="DEU 6:21"/>አከነ ጄዺ እት ህም፤ “ኑ ግብጥት ገርቦተ ፈረኦን ቱሬ፤ <char style="nd">ዋቀዮ</char> ገሩ ሀርከ ጀባዻን ግብጢ ባሴ ኑ ፍዴ። <verse eid="DEU 6:21"/><verse number="22" style="v" sid="DEU 6:22"/><char style="nd">ዋቀዮ</char> ፉሉመኬኘ ዱረት ብየ ግብጥት፣ ፈረኦኒፊ ነሞተ መነሳ ኬሰ ጅራተን ሁንደረት መለቶፊ ድንቂወን ሶዳችሳፊ ጉርጉዳ ሆጄቴ። <verse eid="DEU 6:22"/><verse number="23" style="v" sid="DEU 6:23"/>እን ገሩ ብየ አቦቲኬኛፍ ከኩዻን ዋዳ ገሌ ሰነት ኑ ገልቼ ኑ ዻልችሱፍ ጄዼ አቺ ባሴ ኑ ፍዴ። <verse eid="DEU 6:23"/><verse number="24" style="v" sid="DEU 6:24"/><char style="nd">ዋቀዮ</char> አከ ኑ አኩመ አመ ጅሩ ከነት ዬሮ ሁንደ ኑት ቶሌ ጅራኑፍ አከ ኑ አጀጀወን ከኔን ሁንደ ኤግኑፊ አከ <char style="nd">ዋቀዮ</char> ዋቀኬኘ ሶዳትኑ ኑ አጀጄ። <verse eid="DEU 6:24"/><verse number="25" style="v" sid="DEU 6:25"/>ኑ ዮ አኩመ እን ኑ አጀጄት ሴረ ከነ ሁንደ ፉለ <char style="nd">ዋቀዮ</char> ዋቀኬኛ ዱረት ኦፍ ኤገናዻን ኤግኔ፣ ሱን ቀጄሉማኬኘ ተአ።”<verse eid="DEU 6:25"/></para>
  <chapter eid="DEU 6"/>
  <chapter number="7" style="c" sid="DEU 7"/>
  <para style="s1">ሰቦተ ኦርማ አርአኒ ባሱ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 7:1"/>ዮሙ <char style="nd">ዋቀዮ</char> ዋቅንኬ ብየ አት ዻሉፍ እት ገላ ጅርቱ ከነት ስ ፍዴ ሰቦተ ሄዱ ጄቹንስ ሄቶተ፣ ግርጋሾተ፣ አሞሮተ፣ ከነኣኖተ፣ ፌርዞተ፣ ሂዎታፊ ዬቡሶተ ጄቹንስ ሰቦተ እስን ጫላ ጉርጉዳፊ ጀጀቦ ቶርበ ፉለኬ ዱራ አርኤ ባሱት፣ <verse eid="DEU 7:1"/><verse number="2" style="v" sid="DEU 7:2"/>ዮሙ <char style="nd">ዋቀዮ</char> ዋቅንኬ ደበርሴ እሳን ሲፍ ኬኔ አትስ እሳን ሞአቱት፣ ጉቱማን ጉቱት እሳን በርበዴስ። እሳን ወጅን ከኩ ቶኮሌ ህንሴንን፤ ገራስሳኒ ህንላፍን። <verse eid="DEU 7:2"/><verse number="3" style="v" sid="DEU 7:3"/>እሳንት ህንሶዶምን፤ እልማንሳኒቲፍ እንተለንኬ ህንኬንን ዮካን እንተለንሳኒ እልማንኬቲፍ ህንፍድን፤ <verse eid="DEU 7:3"/><verse number="4" style="v" sid="DEU 7:4"/>ሰበቢንሳስ እሳን እልማንኬ ነ ዱካ ቡኡራ ዴብሰኒ አከ እሳን ዋቆተ ብራ ተጃጅለን ጎዹ፤ ዼከምስ <char style="nd">ዋቀዮስ</char> ስት ቦበኤ ደፌ ስ በሌሰ። <verse eid="DEU 7:4"/><verse number="5" style="v" sid="DEU 7:5"/>ወን እስን እሳን ጎቹ ቀብደን ከነ፦ እዶወን ኣርሳሳኒ ዲጋ፤ ሲዳወን ዋቄፈትናሳኒ ጨጨብሳ፤ ኡቱባወን ኣሼራሳኒስ ጅጅግሳ፤ ዋቆተሳኒስ እብዳን ጉባ። <verse eid="DEU 7:5"/><verse number="6" style="v" sid="DEU 7:6"/>አት ሰበ <char style="nd">ዋቀዮ</char> ዋቀኬቲፍ ቁልቁሉ ታቴዸ። <char style="nd">ዋቀዮ</char> ዋቅንኬ አከ አት ሰበሳቲፊ ቀቤኘሳ ጃለተማ ታቱፍ ጄዼ ሰቦተ ለፈረ ጅራተን ሁንደ ኬሳ ስ ፍለቴ።<verse eid="DEU 7:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 7:7"/>ወን <char style="nd">ዋቀዮ</char> እስን ጃለቴ እስን ፍለቴፍ ዋን እስን ሰቦተ ካን ጫላ ባይኤ ታተኒፍ ምት፤ እስን ሰቦተ ሁንደ ጫላ ጥኖ ቱርተን። <verse eid="DEU 7:7"/><verse number="8" style="v" sid="DEU 7:8"/>ገሩ ወን <char style="nd">ዋቀዮ</char> ሀርከ ጀባዻን እስን ባሴ ብየ ገርቡማቲፊ እሬ ፈረኦን ሞትቸ ግብጥ ጀላ እስን ፉሬፍ ሰበቢ እስን ጃለቴ ከኩ አቦቲኬሰን ወጅን ገሌ ሰነ ኤጌፍ። <verse eid="DEU 7:8"/><verse number="9" style="v" sid="DEU 7:9"/>ከናፉ አከ <char style="nd">ዋቀዮ</char> ዋቅንኬ ዋቀ ተኤ ቤክ፤ እን ዋቀ አመነማ ወረ እሰ ጃለተኒ አጀጀሳስ ኤገኒፍ ከኩፊ አራረሳ ሀመ ዸሎተ ኩማት ኤጉዸ። <verse eid="DEU 7:9"/><verse number="10" style="v" sid="DEU 7:10"/>ወረ እሰ ጅበን ገሩ፣</para>
  <para style="q1" vid="DEU 7:10">በሌሱፍ ገቲሳኒ መታሳኒት ዴብሰ፤</para>
  <para style="q2" vid="DEU 7:10">ነመ እሰ ጅቡስ ገቲሳ መታሳት ዴብሱዻፍ <optbreak/> ለፈረ ህንሀርክፈቱ።<verse eid="DEU 7:10"/></para>
  <para style="m">
    <verse number="11" style="v" sid="DEU 7:11"/>ከናፉ አት አጀጀወን፣ ቀጄልቸወኒፊ ሴረወን አን ሀርአ ሲፍ ኬኑ ከኔን ኤግ።<verse eid="DEU 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 7:12"/>ዮ አት ሴረወን ከኔኒፍ ጥዬፈትና ኬንቴ ኦፍ ኤገናዻን ዱካ ቡቴ፣ <char style="nd">ዋቀዮ</char> ዋቅንኬ አኩመ አቦቲኬቲፍ ከከቴ ሰነ ከኩፊ አራረሳ ሲፍስ ንኤገ። <verse eid="DEU 7:12"/><verse number="13" style="v" sid="DEU 7:13"/>እን ስ ጃለተ፤ ስ ኤብሰ፤ ስ ባይእሰስ። ብየ ሲፍ ኬኑፍ አቦቲኬቲፍ ከኩ ገሌ ኬሰት እጀ ገራኬቲ፣ ኦምሸ ለፈኬቲ ጄቹንስ ምዻን፣ ወይኒ ሃራፊ ዘይቲ፣ ጀቢወን ሎንኬቲ፣ ጦባላወን ቡሻዬኬቲ ሲፍ ኤብሰ። <verse eid="DEU 7:13"/><verse number="14" style="v" sid="DEU 7:14"/>አት ሰቦተ ከምዩ ጫላ ንኤብፈምተ፤ ዺረ ዮካን ዱበርቲኬ ኬሳ ቶኮሌ እጆሌ ህንዸቡ ዮካን ሎንኬ ኬሳ ቶኮሌ ህንመሴኑ። <verse eid="DEU 7:14"/><verse number="15" style="v" sid="DEU 7:15"/><char style="nd">ዋቀዮ</char> ዹኩበ ሁንደ ስራ ፉዸ። እን ዹኩቦተ ሱከኔሳ አት ብየ ግብጥት አርግቴ ሰነ ወረ ስ ጅበንት ፍደ መሌ ስት ህንፍዱ። <verse eid="DEU 7:15"/><verse number="16" style="v" sid="DEU 7:16"/>አት ሰቦተ <char style="nd">ዋቀዮ</char> ዋቅንኬ ደበርሴ ስት ኬኑ ሁንደ በሌሱ ቀብደ። አት እሳኒፍ ገራ ህንላፍን፤ ኩን ክዮ ስት ተኣቲ ዋቆተሳኒ ህንዋቄፈትን።<verse eid="DEU 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 7:17"/>አት፣ “ሰቦትን ኩኔን ኑ ጫላ ጀጀቦዸ፤ ኑ አከምት እሳን ባፍነ?” ጄቴ ያደ ተአ። <verse eid="DEU 7:17"/><verse number="18" style="v" sid="DEU 7:18"/>ገሩ አት እሳን ህንሶዳትን፤ ዋን <char style="nd">ዋቀዮ</char> ዋቅንኬ ፈረኦኒፊ ጉቱማ ግብጥት ሆጄቴ ሰነ ያደዹ። <verse eid="DEU 7:18"/><verse number="19" style="v" sid="DEU 7:19"/>አት ቆርማተወን ጉርጉዳ፣ መለቶወኒፊ ድንቂወን፣ ሀርከ ጀባፊ እሬ ድሪርፈሜ ከን <char style="nd">ዋቀዮ</char> ዋቅንኬ እቲን ስ ባሴ ሰነ እጁመኬቲን አርግቴርተ። <char style="nd">ዋቀዮ</char> ዋቅንኬ ሰቦተ አት አመ ሶዳቱ ሁንደስ አከሱመ ጎዸ። <verse eid="DEU 7:19"/><verse number="20" style="v" sid="DEU 7:20"/>ከነ ጫላዩ <char style="nd">ዋቀዮ</char> ዋቅንኬ ሀመ ወር ሉቡዻን ሀፈኒ ስ ዱራ ዾከተንዩ በርበዳአንት ግዱሳኒት ሶንሰ ንኤርገ። <verse eid="DEU 7:20"/><verse number="21" style="v" sid="DEU 7:21"/>ሰበቢ <char style="nd">ዋቀዮ</char> ዋቅንኬ እን ግዱኬ ጅሩ ሱን ዋቀ ጉዳፊ ሶዳችሳ ተኤፍ እሳን ህንሶዳትን። <verse eid="DEU 7:21"/><verse number="22" style="v" sid="DEU 7:22"/><char style="nd">ዋቀዮ</char> ዋቅንኬ ሰቦተ ሰነ ጥኖ ጥኖዻን ፉለኬ ዱራ ንባሰ፤ አከ ብኔንሶትን ቦሶና ናኖኬት ህንባይአኔፍ ዬሩመ ቶኮት እሳን በሌሱን ሲፍ ህንኤየመሙ። <verse eid="DEU 7:22"/><verse number="23" style="v" sid="DEU 7:23"/><char style="nd">ዋቀዮ</char> ዋቅንኬ ገሩ ሀመ እሳን በደንት እሳን ራቴሱዻን ደበርሴ ሀርከኬት እሳን ኬነ። <verse eid="DEU 7:23"/><verse number="24" style="v" sid="DEU 7:24"/>ሞቶተሳኒስ ደበርሴ ስት ኬነ፤ አትስ መቃሳኒ ሰሚ ጀላ ንበሌስተ። ሀመ አት እሳን በሌስቱት ነምን ፉለኬ ዱረ ዻበቹ ደንደኡ ቶኮዩ ህንጅሩ። <verse eid="DEU 7:24"/><verse number="25" style="v" sid="DEU 7:25"/>ፈኪ ዋቆተሳኒ እብዳን ጉብ፤ ሜቲፊ ወርቄ እሳንረ ጅሩ ህንሀውን፤ ኦፊኬቲፍስ ህንፉዸትን፤ ዮ ከና አቺ እን ሰበቢ ፉለ <char style="nd">ዋቀዮ</char> ዋቀኬቲ ዱረት ጅብሲሳ ተኤፍ ክዮ ስት ተአ። <verse eid="DEU 7:25"/><verse number="26" style="v" sid="DEU 7:26"/>ዋን ጅብሲሳ ገረ መነኬቲት ህንገልችን፤ ዮ ከና አቺ አትስ አኩመሳ በዲሳፍ አዳን ባፈምተ። ዋን እን በዲሳፍ አዳን ባፈሜፍ አት ጉቱማን ጉቱት እሰ ጅብ፤ በልፍስ።<verse eid="DEU 7:26"/></para>
  <chapter eid="DEU 7"/>
  <chapter number="8" style="c" sid="DEU 8"/>
  <para style="s1">
    <char style="nd">ዋቀዮን</char> ህንደገትን</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 8:1"/>እስን አከ ሉቡን ጅራተን፣ አከ ባይአተኒፊ አከ ብየ <char style="nd">ዋቀዮ</char> ከኩዻን አቦቲኬሰን አብደቺሴ ሰነት ገልተኒ ዻልተኒፍ አጀጀ አን ሀርአ ሲፍ ኬኑ ሁንደ ኦፍ ኤገናዻን ዱካ ቡኣ። <verse eid="DEU 8:1"/><verse number="2" style="v" sid="DEU 8:2"/><char style="nd">ዋቀዮ</char> ዋቅንኬ ገድ ስ ቀቤ ስ ቆሩዻን ዋን ገራኬ ኬሰ ጅሩ ጄቹንስ አከ አት አጀጀወንሳ ኤግዱፊ ህንኤግኔ ቤኩፍ ከራ እን ወጎተ አፉርተመን ከኔን ጉቱ ገሞጂ ኬሰ ስ ቀጄልቼ ያደዹ። <verse eid="DEU 8:2"/><verse number="3" style="v" sid="DEU 8:3"/>እንስ ገድ ስ ዴብሴ ስ ቤሌሴ “መና” አት ዮካን አቦቲንኬ ህንቤክን ስ ሶሬ፤ ኩንስ አከ ነምን ዱቢ አፋን <char style="nd">ዋቀዮቲ</char> በኡ ሁንዳን መሌ ቡዴነ ቆፋን ህንጅራትኔ ስ በርሲሱፍ። <verse eid="DEU 8:3"/><verse number="4" style="v" sid="DEU 8:4"/>ወጎተ አፉርተመን ከኔን ኬሰ ኡፈትንኬ ህንዹምኔ፤ ሚልኬስ ህንኢቶፍኔ። <verse eid="DEU 8:4"/><verse number="5" style="v" sid="DEU 8:5"/>አከ <char style="nd">ዋቀዮ</char> ዋቅንኬ አኩመ አባን እልመሳ አደበቱ አከ ስ አደቡ ቤክ።<verse eid="DEU 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 8:6"/>ዳንዲወንሳረ ዴሙፊ እሰ ሶዳቹዻን አጀጀወን <char style="nd">ዋቀዮ</char> ዋቀኬቲ ኤግ። <verse eid="DEU 8:6"/><verse number="7" style="v" sid="DEU 8:7"/><char style="nd">ዋቀዮ</char> ዋቅንኬ ብየ ጋሪ ከን ለጌን፣ ሀሮወኒፊ ቡርቃወን ሱሉሎታፊ ጋረን ኬሳ ያአኒት ስ ገልቻቲ። <verse eid="DEU 8:7"/><verse number="8" style="v" sid="DEU 8:8"/>ብየ ቀመዲፊ ገርቡ፣ ወይኒፊ ሀርቡ፣ ሮማኒ፣ ዘይቲ ኤጄርሳቲፊ ደመ ባሱት፣ <verse eid="DEU 8:8"/><verse number="9" style="v" sid="DEU 8:9"/>ብየ አት ህርእነ መሌ ቡዴነ ኛቱፊ ብየ አት ኬሳ ሆማ ህንዸብኔ፣ ብየ ከታን ስቢለ ተኤ፣ ብየ አት ጋረን ኬሳ ስቢለ ዲማ ባሱ ደንዴሱዸ።<verse eid="DEU 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 8:10"/>ዬሮ ኛቴ ቁፍቱት፣ ሰበቢ <char style="nd">ዋቀዮ</char> ዋቅንኬ ብየ ጋሪ አከሲ ሲፍ ኬኔፍ እሰ ጀጀዹ። <verse eid="DEU 8:10"/><verse number="11" style="v" sid="DEU 8:11"/>አት አከ አጀጀወን፣ ቀጄልፈመወኒፊ ሴረወንሳ ከኔን አን ሀርአ ሲፍ ኬኑ ኤጉ ባቹዻን <char style="nd">ዋቀዮ</char> ዋቀኬ ህንደገትኔ ኦፍ ኤገዹ። <verse eid="DEU 8:11"/><verse number="12" style="v" sid="DEU 8:12"/>ዮ ከና አቺ ዮሙ ኛቴ ቁፍቱት፣ ዮሙ መነ ጋሪ እጃረቴ ኬሰ ጅራቱት፣ <verse eid="DEU 8:12"/><verse number="13" style="v" sid="DEU 8:13"/>ዮሙ ሎኒፊ ቡሻዬንኬ ወል ሆረኒ ሜቲፊ ወርቄንኬ ደበሉፊ ዮሙ ወን አት ቀብዱ ሁንድ ባይአቱት፣ <verse eid="DEU 8:13"/><verse number="14" style="v" sid="DEU 8:14"/>አት ኦፍ ቱልቴ <char style="nd">ዋቀዮ</char> ዋቀኬ እሰ ብየ ግብጥ፣ ብየ ገርቡማቲ ባሴ ስ ፍዴ ሰነ ንደገተ። <verse eid="DEU 8:14"/><verse number="15" style="v" sid="DEU 8:15"/>እን ገሞጂ በልኣፊ ሶዳችሳ፣ ብየ ዼቡቲፊ ከን ብሻን ህንቀብኔ፣ ብየ ቦፈ ሀዻ ቀቡፊ ቶርባንቀባን ኬሰ ጉቴ ሰነ ኬሰ ስ ዴምስሴ። ከታ ጀባ ኬሳስ ብሻን ሲፍ ቡርቅሲሴ። <verse eid="DEU 8:15"/><verse number="16" style="v" sid="DEU 8:16"/>አከ ዹመረት ስት ቶሉፍ ጄዼ ገድ ስ ቀቡፊ ስ ቆሩዻፍ፣ ዋን ተኩማ አቦቲንኬ ህንቤክን ገሞጂ ኬሰት “መና” አት ኛቱ ሲፍ ኬኔ። <verse eid="DEU 8:16"/><verse number="17" style="v" sid="DEU 8:17"/>አት፣ “ሁምነኮቲፊ ጀብነ ሀርከኮቱ ቀቤኘ ከነ ናፍ አርገምሲሴ ጄቴ” ያደ ተአ። <verse eid="DEU 8:17"/><verse number="18" style="v" sid="DEU 8:18"/>ገሩ <char style="nd">ዋቀዮ</char> ዋቀኬ ያደዹ፤ ከን አኩመ ሀርአ ጅሩ ከነት አከ አት ቀቤኘ ሆረቱፍ ደንዴቲ ሲፍ ኬኔ ዋዳ ከኩዻን አቦቲኬቲፍ ገሌ ሰነ ሲፍ ኤጌሳቲ።<verse eid="DEU 8:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 8:19"/>ዮ አት <char style="nd">ዋቀዮ</char> ዋቀኬ እራንፈቴ ዋቆተ ብራ ዱካ ቡቴ፣ ዮ እሳን ዋቄፈቴፊ እሳኒፍ ሰገዴ አከ እስን ዹጉማን በደን አን ሀርአ ዹጋ እስንት ነንበአ። <verse eid="DEU 8:19"/><verse number="20" style="v" sid="DEU 8:20"/>አኩመ ሰቦተ <char style="nd">ዋቀዮ</char> ፉለኬሰን ዱራ በሌሴ ሰና <char style="nd">ዋቀዮ</char> ዋቀኬሰኒፍ ዋን አጀጀሙ ድደኒፍ አከሱመ እስንስ ንበሌፈምቱ።<verse eid="DEU 8:20"/></para>
  <chapter eid="DEU 8"/>
  <chapter number="9" style="c" sid="DEU 9"/>
  <para style="s1">ሰበቢ ቀጄሉማ እስራኤሊፍ ምት</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 9:1"/>ያ እስራኤል ዸገእ። አት ሰቦተ ስ ጫላ ጉርጉዳፊ ሁምነ ቀቤዪ፣ መጋላወን ደላ ሰሚ ገኡን መርፈመን ቀበን አቺ ባፍቴ ዻሉፍ ዮርዳኖስ ጬኡፍ ጅርተ። <verse eid="DEU 9:1"/><verse number="2" style="v" sid="DEU 9:2"/>ነሞትን ሱን እልማን አናቅ ወረ ጀጀቦፊ ዼዼሮዸ! አትስ ዋኤሳኒ ንቤክተ፤ አከ፣ “ኤኙቱ አናቆተ ዱረ ዻበቹ ደንደአ?” ጄዸሙሌ ዸጌሴርተ። <verse eid="DEU 9:2"/><verse number="3" style="v" sid="DEU 9:3"/>ተኡስ ከን አኩመ እብደ ዋ ጉቤ ፍጡ ስ ዱረ ጬኡ <char style="nd">ዋቀዮ</char> ዋቀኬ ተኡሳ ሀርአ ቤክ። እን እሳን በሌሰ፤ ፉለኬ ዱረትስ ገድ እሳን ዴብሰ። አትስ አኩመ <char style="nd">ዋቀዮ</char> ስ አብደቺሴ ሰነት አሪቴ እሳን ባፍተ፤ ደፍቴስ እሳን ፍጠ።<verse eid="DEU 9:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="DEU 9:4"/>ኤርገ <char style="nd">ዋቀዮ</char> ዋቅንኬ ፉለኬ ዱራ አርኤ እሳን ባሴ ቦዴ አት ገራኬት፣ “<char style="nd">ዋቀዮ</char> ሰበቢ ቀጄሉማኮቲፍ አከ አን ብየ ከነ ዻሉ አስ ነ ፍዴ” ህንጄዽን። <char style="nd">ዋቀዮ</char> ሰበቢ ሀምነሳኒቲፍ ሰቦተ ከኔን ፉለኬ ዱራ አርኤ ባሰ። <verse eid="DEU 9:4"/><verse number="5" style="v" sid="DEU 9:5"/>አት ብየሳኒት ገልቴ ከን ዻልቱ ቀጄሉማኬቲን ዮካን ጋሩማ ገራኬቲቲን ኡቱ ህንተእን <char style="nd">ዋቀዮ</char> ከኩ አቦቲኬ አብረሃሚፍ፣ ይስሃቂፊ ያቆቢፍ ገሌ ሰነ ጉቱዻፍ ጄዼ <char style="nd">ዋቀዮ</char> ዋቅንኬ ሰቦተ ከኔን ሰበቢ ሀምነሳኒቲፍ ፉለኬ ዱራ አርኤ ባሰ። <verse eid="DEU 9:5"/><verse number="6" style="v" sid="DEU 9:6"/>ኤጋ <char style="nd">ዋቀዮ</char> ዋቅንኬ ከን ብየ ጋሪ ከነ አከ ዻልቱፍ ሲፍ ኬኑ ሰበቢ ቀጄሉማኬቲቲፍ አከ ህንተእን ሁበዹ፤ አት ሰበ መተ ጀቤሳቲ።<verse eid="DEU 9:6"/></para>
  <para style="s1">ጀቢ ወርቄ</para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 9:7"/>አት አከምት አከ ገሞጂ ኬሰት <char style="nd">ዋቀዮ</char> ዋቀኬ ዼከምሳፍ ከካፍቴ ያደዹ፤ ህንደገትንስ። አት ጋፈ ብየ ግብጢ ባቴ ጀልቀብዴ ሀመ አስ ጌሱት <char style="nd">ዋቀዮት</char> ፍንጭላ ቱርቴ። <verse eid="DEU 9:7"/><verse number="8" style="v" sid="DEU 9:8"/>እስን ኮሬብትዩ <char style="nd">ዋቀዮን</char> ዼከምሳፍ ከካስናን ዋቀዮ እስን በርበዴሱፍ እስንት ኣሬ። <verse eid="DEU 9:8"/><verse number="9" style="v" sid="DEU 9:9"/>አን ዬሮ ገበቴወን ዸጋ ጄቹንስ ገበቴወን ከኩ <char style="nd">ዋቀዮ</char> እስን ወጅን ገሌ ሰና ፉዹፍ ቱሉት ኦል በኤት ጉያ አፉርተማፊ ሀልከን አፉርተመ ቱሉ ሰነ እረን ቱሬ፤ አን ቡዴነ ቶኮሌ ህንኛትኔ፤ ብሻንሌ ህንዹግኔ። <verse eid="DEU 9:9"/><verse number="10" style="v" sid="DEU 9:10"/><char style="nd">ዋቀዮስ</char> ገበቴወን ዸጋ ለመ ከኔን ቁበ ዋቀዮቲን እረት በሬፈሜ ነት ኬኔ። አጀጀወን <char style="nd">ዋቀዮ</char> ዬሮ እስን ወልት ቀበምተንት ቱሉረት እብደ ኬሳ እስንት ለብሴ ሁንድ ገበቴወን ሰነረ ቱረን።<verse eid="DEU 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 9:11"/>ዹመ ጉያ አፉርተማቲፊ ሀልከን አፉርተማት <char style="nd">ዋቀዮ</char> ገበቴወን ዸጋ ለመ ጄቹንስ ገበቴወን ከኩ ነት ኬኔ። <verse eid="DEU 9:11"/><verse number="12" style="v" sid="DEU 9:12"/>ጋፈስ <char style="nd">ዋቀዮ</char> አከነ ናን ጄዼ፤ “ከኢ ደፊ ገድ ቡእ፤ ሰብንኬ ከን አት ብየ ግብጢቲ ባፍቴ ፍዴ ሱን ጡራኤራቲ። እሳን ዋን አን እሳን አጀጄራ ደፈኒ ገረ ገለኒ ኦፊሳኒቲፍ ዋቀ በቅፈሜ ሆጄተሜ ቶልፈተኒሩቲ።”<verse eid="DEU 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 9:13"/>
    <char style="nd">ዋቀዮ</char> አመስ አከነ ናን ጄዼ፤ “አን ሰበ ከነ አርጌረ፤ ኩኖ እን ሰበ መተ ጀቤሰ! <verse eid="DEU 9:13"/><verse number="14" style="v" sid="DEU 9:14"/>አከ አን እሳን በሌሴ መቃሳኒሌ ሰሚ ገዲ ሀቁፍ ነ ዺስ፤ ስእሞ እሳን ጫላ ሰበ ጉዳፊ ጀባ ነንጎዸ።”<verse eid="DEU 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 9:15"/>አንስ ኦፍረ ገረገሌ ኡቱመ ቱሉን ሱን ቦበኣ ጅሩ ቱሉራ ገድ ነንቡኤ። ገበቴወን ከኩ ለማን ሱንስ ነ ሀርከ ቱረን። <verse eid="DEU 9:15"/><verse number="16" style="v" sid="DEU 9:16"/>አንስ ነንአርጌ፤ ኩኖ እስን <char style="nd">ዋቀዮ</char> ዋቀኬሰንት ጩቡ ሆጄተኒ ቱርተን፤ እስን ብፈ ጀቢቲን ዋቀ በቅፈሜ ሆጄተሜ ኦፊኬሰኒፍ ቶልፈተኒ ቱርተን። እስን ደፍተኒ ከራ <char style="nd">ዋቀዮ</char> እስን አጀጄራ ጀልአተን። <verse eid="DEU 9:16"/><verse number="17" style="v" sid="DEU 9:17"/>ከናፉ አን ገበቴወን ለማን ሰነ ሀርከኮራ ደርበዼ እጁመኬሰን ዱረት ነንጨጨብሴ።<verse eid="DEU 9:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 9:18"/>ሰበቢ ጩቡ እስን ሆጄተን ሁንዳ ከን እስን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዋን ሀማ ሆጄቹዻን ዼከምሳፍ እሰ ከካፍተን ሰናቲፍ አን አመስ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ጎምብፈሜ ኡቱን ቡዴነ ህንኛትኒፊ ብሻን ህንዹግን ጉያ አፉርተማፊ ሀልከን አፉርተመን ቱሬ። <verse eid="DEU 9:18"/><verse number="19" style="v" sid="DEU 9:19"/>ሰበቢ እን እስን በሌሱፍ ኣሬ ቱሬፍ፣ አን ኣሪፊ ዼከምሰ <char style="nd">ዋቀዮ</char> ነንሶዳዼ። <char style="nd">ዋቀዮ</char> ገሩ አመሌ ነ ዸገኤ። <verse eid="DEU 9:19"/><verse number="20" style="v" sid="DEU 9:20"/><char style="nd">ዋቀዮ</char> አሮንን በሌሱፍ አከ መሌ እት ኣሬ ቱሬ፤ አን ገሩ ዬሮ ሰነ አሮኒፍስ ነንከዸዼ። <verse eid="DEU 9:20"/><verse number="21" style="v" sid="DEU 9:21"/>አከሱመስ አን ጩቡኬሰን ብፈ ጀቢ እስን ቶልፈተን ሰና ፉዼ እብዳን ነንጉቤ። ጨጨብሴስ ሀመ እን ቡላኣ አከ አዋራ ተኡት ቡሌሴ ቡርቃ ቱሉራ ገድ ያኡተን ፍርፍርሴ።<verse eid="DEU 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 9:22"/>እስንስ ተቤራት፣ ማሳሂፊ ቂብሮት ሀታዋት <char style="nd">ዋቀዮ</char> ዼከምሲፍተን።<verse eid="DEU 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 9:23"/>
    <char style="nd">ዋቀዮ</char> ዮሙ ቃዴሽ በርኔቲ እስን ባሴት፣ “ኦል በኣቲ ብየ አን እስኒፍ ኬኔ ሰነ ዻላ” እስኒን ጄዼ። እስን ገሩ አጀጀ <char style="nd">ዋቀዮ</char> ዋቀኬሰኒት ፍንጭልተን። እሰስ ህንአመኔ፤ ህንአጀጀምኔፍስ። <verse eid="DEU 9:23"/><verse number="24" style="v" sid="DEU 9:24"/>እስን ኤርገ አን እስን ቤኬ ጀልቀብደኒ <char style="nd">ዋቀዮት</char> ፍንጭልተኒርቱ።<verse eid="DEU 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DEU 9:25"/>ሰበቢ <char style="nd">ዋቀዮ</char> አከ እስን በሌሱ ዱበቴ ቱሬፍ አን ጉያ አፉርተማፊ ሀልከን አፉርተመን ሰነ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ለፈት ነንጎምብፈሜ። <verse eid="DEU 9:25"/><verse number="26" style="v" sid="DEU 9:26"/>አንስ አከነ ጄዼን <char style="nd">ዋቀዮን</char> ከዸዼ፤ “ያ <char style="nd">ዋቀዮ</char> ጎፍታ፣ አት ሰበኬ፣ ዻለኬ ከን ሁምነኬ ጉድቻፊ ሀርከኬ ጀባዻን ፉርቴ ብየ ግብጢ ባፍቴ ከነ ህንበሌስን። <verse eid="DEU 9:26"/><verse number="27" style="v" sid="DEU 9:27"/>ገርቦተኬ አብረሃም፣ ይስሃቂፊ ያቆብን ያደዹ። መተ ጀብነ ሰበ ከና፣ ሀምነሳቲፊ ጩቡሳ ህንእላልን። <verse eid="DEU 9:27"/><verse number="28" style="v" sid="DEU 9:28"/>ዮ ከና አቺ ብይ አት ኬሳ ኑ ባፍቴ ሱን፣ ‘<char style="nd">ዋቀዮ</char> ዋን ብየ ዋዳ እሳኒፍ ገሌ ሰነት እሳን ገልቹ ህንደንዴኜፊ ዋን እሳን ጅቤፍ ገሞጂ ኬሰት እሳን ፍጡፍ እሳን ባሴ’ ጄዸ። <verse eid="DEU 9:28"/><verse number="29" style="v" sid="DEU 9:29"/>እሳን ገሩ ሰበኬቲፊ ዻለኬ ከን አት ሁምነ ጀባፊ እሬ ድሪርፈሜን ባፍቴ ፍዴዸ።”<verse eid="DEU 9:29"/></para>
  <chapter eid="DEU 9"/>
  <chapter number="10" style="c" sid="DEU 10"/>
  <para style="s1">ገበቴወን ገበቴወን ጀልቀባ ፈካተን</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 10:1"/>ዬሮ ሰነስ <char style="nd">ዋቀዮ</char> አከነ ናን ጄዼ፤ “ገበቴወን ዸጋ ከኔን ገበቴወን ጀልቀባ ፈካተን ለመ ሶፊቲ ቱሉት ኦል በኢ ነ ብረ ኮቱ። ታቦተ ሙካስ ሆጄዹ። <verse eid="DEU 10:1"/><verse number="2" style="v" sid="DEU 10:2"/>አንስ ዱቢ ገበቴወን ጀልቀባ ከኔን አት ጨጨብስቴ ሰነረ ቱረን ገበቴወን ከኔንረት ነንበሬሰ። አትስ ታቦተ ኬሰ እሳን ኬሰ።”<verse eid="DEU 10:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="DEU 10:3"/>አን ሙከ ላፍቶራ ታቦተ ቶልቼ ገበቴወን ዸጋ ለመ አኩመ ከኔን ጀልቀባት ነንሶፌ፤ ገበቴወን ለማንስ ሀርከት ቀበዼ ቱሉ ሰነት ኦል ነንበኤ። <verse eid="DEU 10:3"/><verse number="4" style="v" sid="DEU 10:4"/><char style="nd">ዋቀዮ</char> ጉያ ወል ገኢ ሰነ ቱሉራ አጀጀወን ኩርነን እብደ ኬሳ እስንት ዱበቴ ሰነ አኩመ በሬፈመ ዱራት ገበቴወን ከኔንረት በሬሴ፤ <char style="nd">ዋቀዮስ</char> ገበቴወን ከኔን ነት ኬኔ። <verse eid="DEU 10:4"/><verse number="5" style="v" sid="DEU 10:5"/>አንስ ቱሉ ሰነራ ገድ ቡኤ አኩመ <char style="nd">ዋቀዮ</char> ነ አጀጄት ገበቴወን ሰነ ታቦተ እሰ አን ሆጄዼ ቱሬ ኬሰ ነንካኤ፤ እሳንስ አመ አች ጅሩ።<verse eid="DEU 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 10:6"/>እስራኤሎንስ ብኤሮት ቤኔ ያአካኒ ከአኒ ገረ ሞሴራት ቀጄለን። አሮንስ አችት ዱኤ አዋለሜ፤ እልምሳ ኤሌኣዛር እዶሳ ቡኤ ሉበ ተኤ። <verse eid="DEU 10:6"/><verse number="7" style="v" sid="DEU 10:7"/>አቺ ከአኒ ጉድጎዳ ዸቀን፤ ኤርገሲስ ገረ ዮጥባታ ብየ ብሻኖተ ያአን ቀብዱት ደርበን። <verse eid="DEU 10:7"/><verse number="8" style="v" sid="DEU 10:8"/>ዬሮ ሰነት <char style="nd">ዋቀዮ</char> ጎሰ ሌዊ አከ እን ታቦተ ከኩ <char style="nd">ዋቀዮ</char> ባቱፍ፣ አከ ፉለ <char style="nd">ዋቀዮ</char> ዱረ ዻበቴ እሰ ተጃጅሉፊ አከ መቃሳቲን ኤብሱፍ ሀመ ሀርኣት አዳን ባሴ። <verse eid="DEU 10:8"/><verse number="9" style="v" sid="DEU 10:9"/>ሰበቢን ጎስት ሌዊ አከ ኦቦሎተሳ ግዱት ቆደ ዮካን ዻለ ህንቀባትኔ ጎዸሜፍስ ከኑመ። አኩመን <char style="nd">ዋቀዮ</char> ዋቅንኬ እሳንት ህሜት፣ <char style="nd">ዋቀዮ</char> ዻለሳኒት።<verse eid="DEU 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 10:10"/>አመስ አን አኩመ ዬሮ ጀልቀባ ጎዼ ሰነ ጉያ አፉርተማፊ ሀልከን አፉርተመ ቱሉ ሰነ እረን ቱሬ፤ <char style="nd">ዋቀዮ</char> አመስ ነ ዸገኤ። እን ስ በሌሱዻፍ ፌዺ ህንቀቡ። <verse eid="DEU 10:10"/><verse number="11" style="v" sid="DEU 10:11"/><char style="nd">ዋቀዮስ</char>፣ “ዴም፤ አከ እሳን ብየ አን አቦቲሳኒቲፍ ኬኑዻፍ ከከዼ ሰነ ሴነኒ ዻለኒፍ ሰበ ከነ ዱረ ቡኢ ዴም” ናን ጄዼ።<verse eid="DEU 10:11"/></para>
  <para style="s1">
    <char style="nd">ዋቀዮን</char> ሶዳዹ</para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 10:12"/>ያ እስራኤል፣ ወን <char style="nd">ዋቀዮ</char> ዋቅንኬ ስራ በርባዱ ማል? አከ አት <char style="nd">ዋቀዮ</char> ዋቀኬ ሶዳቱ፣ አከ ዳንዲሳ ሁንደረ ዴምቱ፣ አከ እሰ ጃለቱ፣ አከ <char style="nd">ዋቀዮ</char> ዋቀኬ ገራኬ ጉቱፊ ሉቡኬ ጉቱዻን ተጃጅልቱ፣ <verse eid="DEU 10:12"/><verse number="13" style="v" sid="DEU 10:13"/>አከ ሲፍ ቶሉፍ፣ አከ አት አጀጀወኒፊ ቀጄልቸወን <char style="nd">ዋቀዮ</char> ከኔን አን ሀርአ ሲፍ ኬኑ ኤግዱ ምቲ?<verse eid="DEU 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 10:14"/>ኩኖ ሰሚን፣ ሰሚን ሰሚወኒ ኦሊ፣ ለፍቲፊ ወን እሼ ኬሰ ጅሩ ሁንድኑ ከን <char style="nd">ዋቀዮ</char> ዋቀኬቲት። <verse eid="DEU 10:14"/><verse number="15" style="v" sid="DEU 10:15"/>ተኡስ አኩመ ሀርአ ተኤ ጅሩ ከነ፣ <char style="nd">ዋቀዮ</char> ጃለላን ቀልቢሳ አቦቲኬሰንረ ቡፈቴ፤ እስን ወረ ሰኚሳኒ ታተንስ ሰቦተ ሁንደ ጫልችሴ ፍለቴ። <verse eid="DEU 10:15"/><verse number="16" style="v" sid="DEU 10:16"/>ከናፉ ቀልቢኬሰን ዸግነ ቀባ፤ ስ አችስ መታ ጀቤዪ ህንተእና። <verse eid="DEU 10:16"/><verse number="17" style="v" sid="DEU 10:17"/><char style="nd">ዋቀዮ</char> ዋቅንኬሰን ዋቀ ዋቆታ፣ ጎፍታ ጎፍቶታ፣ ዋቀ ጉዳ፣ ጀባፊ ሶዳችሳ፣ ከን ነመ ወል ህንጫልችፍኔፊ ከን መተኣ ህንፉዸኔዻቲ። <verse eid="DEU 10:17"/><verse number="18" style="v" sid="DEU 10:18"/>እን እጆሌ አቦቲ ህንቀብኔፊ ኒቶተ ዽርሶትንሳኒራ ዱአኒፍ ንፈልመ፤ አለጎተስ ኛታፊ ኡፈተሳኒ ኬኑዻን ጃለተ። <verse eid="DEU 10:18"/><verse number="19" style="v" sid="DEU 10:19"/>አለጎተ ጃለዻ፤ እስን መታንኬሰን ብየ ግብጥት አለጎተ ቱርተኒቲ። <verse eid="DEU 10:19"/><verse number="20" style="v" sid="DEU 10:20"/><char style="nd">ዋቀዮ</char> ዋቀኬ ሶዳዹ፤ እሰ ተጃጅልስ። እሰት መጠን፤ መቃሳቲንስ ከከዹ። <verse eid="DEU 10:20"/><verse number="21" style="v" sid="DEU 10:21"/>እን ኡልፍነኬት፤ እን ዋቀኬ ከን ድንቂወን ጉርጉዳፊ ሶዳችሳ አት እጀኬቲን አርግቴ ሰነ ሲፍ ሆጄቴዸ። <verse eid="DEU 10:21"/><verse number="22" style="v" sid="DEU 10:22"/>አቦቲንኬ ወር ግብጥት ገድ ቡአን ነመ ቶርባተመ ቱረን፤ አመ ገሩ <char style="nd">ዋቀዮ</char> ዋቅንኬ አከ ኡርጂ ሰሚ ኬሳ ስባይእሴረ።<verse eid="DEU 10:22"/></para>
  <chapter eid="DEU 10"/>
  <chapter number="11" style="c" sid="DEU 11"/>
  <para style="s1">
    <char style="nd">ዋቀዮን</char> ጃለዹቲ አጀጀሚፍ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 11:1"/>
    <char style="nd">ዋቀዮ</char> ዋቀኬ ጃለዹ፤ ዬሮ ሁንደስ ፌዺሳ፣ ቀጄልቸወንሳ፣ ሴረወንሳቲፊ አጀጀወንሳ ኤግ። <verse eid="DEU 11:1"/><verse number="2" style="v" sid="DEU 11:2"/>ከን አደቢ <char style="nd">ዋቀዮ</char> ዋቀኬሰኒ፣ ሱራሳ፣ ሀርከሳ ጀባፊ እሬሳ ከን ድሪርፈሜ ቤኬ ዮካን አርጌ እስኑመ መሌ አከ እጆሌኬሰን ህንተእን ሀርአ ያደዻ። <verse eid="DEU 11:2"/><verse number="3" style="v" sid="DEU 11:3"/>መለቶወኒፊ ወንቶተ እን ግብጥ ኬሰት ፈረኦን ሞቲ ግብጢፊ ብየሳ ጉቱረት ሆጄቴ፣ <verse eid="DEU 11:3"/><verse number="4" style="v" sid="DEU 11:4"/>ዋን እን ሎልቶተ ግብጥ፣ ፈርዴኒፊ ጋሪወንስ ጎዼ፣ ኡቱመ እሳን እስን ዱካ ቡአኑ አከ እን ገላነ ዲማዻን እሳን ሀጉጌ፣ አከ እት <char style="nd">ዋቀዮ</char> በዲሰ በረ በራ እሳንት ፍዴ ያደዻ። <verse eid="DEU 11:4"/><verse number="5" style="v" sid="DEU 11:5"/>ዋን እን ሀመ እስን እዶ ከነ ጌሰንት ለፈ ገሞጂ ኬሰት እስኒፍ ጎዼ ከን አርጌ እጆሌኬሰን ምት፤ <verse eid="DEU 11:5"/><verse number="6" style="v" sid="DEU 11:6"/>እሳን ዋን እን ጋፈ ለፍት አፋንሼ በነቴ ጉቱማ እስራኤል ግዱት ዳታኒፊ አቢራም እልማን ኤሊያብ ነምቸ ጎሰ ሩቤን ሰነ ማቲሳኒ ወጅን፣ ዱንካኖተሳኒቲፊ ቀቤኘሳኒ ከን ሉቡ ቀቡ ሁንደ ልቅምስቴት እሳን ጎዼ ህንአርግኔ። <verse eid="DEU 11:6"/><verse number="7" style="v" sid="DEU 11:7"/>እጅኬሰን ገሩ ዋን ጉዳ <char style="nd">ዋቀዮ</char> ጎዼ ከኔን ሁንደ አርጌረ።<verse eid="DEU 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 11:8"/>ከናፉ እስን አከ ዮርዳኖሲን ጬተኒ ብየ ዻሉፍ ጅርተንት ገሉፍ ጀባተኒፍ አጀጀወን አን ሀርአ እስኒ ኬኑ ሁንደ ኤጋ፤ <verse eid="DEU 11:8"/><verse number="9" style="v" sid="DEU 11:9"/>ኩንስ አከ እስን ብየ <char style="nd">ዋቀዮ</char> አቦቲኬሰኒፊ ሰኚሳኒቲፍ ኬኑፍ ከከቴ ከን ኣነኒፊ ደመ ባሱ ሰነ ኬሰት በረ ዼራ ጅራተኒፍ። <verse eid="DEU 11:9"/><verse number="10" style="v" sid="DEU 11:10"/>ብይ አት ዻሉፍ እት ገላ ጅርቱ ኩን አከ ብየ ግብጥ ከን አት ኬሳ ባቴ ዹፍቴ ከን አት አኩመ ለፈ ብቅልቱት ሰኚኬ ፈጫፍቴ ሚለኬቲን ብሻን ኦባፍቴ ሰና ምት። <verse eid="DEU 11:10"/><verse number="11" style="v" sid="DEU 11:11"/>ብይ አት ዮርዳኖስ ጬቴ ዻልቱ ኩን ገሩ ብየ ቱሉወኒፊ ሱሉለወኒ ከን ሰሚዻ ቦካ አርገቱዸ። <verse eid="DEU 11:11"/><verse number="12" style="v" sid="DEU 11:12"/>ብይ ኩን ብየ <char style="nd">ዋቀዮ</char> ዋቅንኬ ኩኑንሱዸ፤ ጀልቀበ ወጋቲ ሀመ ዹመ ወጋትስ እጅ <char style="nd">ዋቀዮ</char> ዋቀኬቲ እሼራ ህንቡቀኡ።<verse eid="DEU 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 11:13"/>ዮ አጀጀወን አን ሀርአ እስኒፍ ኬኑ አመነሙማዻን ኤግደን ጄቹንስ ዮ እስን <char style="nd">ዋቀዮ</char> ዋቀኬሰን ጃለተኒ ገራኬሰን ጉቱፊ ሉቡኬሰን ጉቱዻን እሰ ተጃጅልተን፣ <verse eid="DEU 11:13"/><verse number="14" style="v" sid="DEU 11:14"/>አከ አት ምዻንኬ፣ ወይኒኬቲፊ ዘይቲኬ ገልፈቱፍ አን ዬሮሳት ቦካ ብራቲፊ ቦካ አርፋሳ ለፈኬት ነንሮብሰ። <verse eid="DEU 11:14"/><verse number="15" style="v" sid="DEU 11:15"/>ሎንኬቲፍ መርገ በኬ ነንኬነ፤ አትስ ኛቴ ቁፍተ።<verse eid="DEU 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 11:16"/>ኦፍ ኤገዻ! ዮ ከና አቺ እስን አከ ገረገልተኒ ዋቆተ ብራ ዋቄፈተኒፊ እሳኒፍስ ሰገደን ጎዎምፈምቱ። <verse eid="DEU 11:16"/><verse number="17" style="v" sid="DEU 11:17"/>ኤርገሲ ዼከምስ <char style="nd">ዋቀዮ</char> እስንት ቦበአ፤ እንስ አከ ቦካን ህንሮብኔ፣ ለፍትስ ኦምሸ ህንኬንኔፍ ሰሚወን ንጩፈ፤ እስንስ ብየ ጋሪ <char style="nd">ዋቀዮ</char> እስኒፍ ኬኑራ ደፍተኒ ንበዱ። <verse eid="DEU 11:17"/><verse number="18" style="v" sid="DEU 11:18"/>ዱቢወንኮ ከኔን ገራፊ ቀልቢኬሰንት ቀበዻ፤ አከ መለቶት ሀርከት ህዸዻ፤ አደኬሰንረትስ መጠንፈዻ። <verse eid="DEU 11:18"/><verse number="19" style="v" sid="DEU 11:19"/>እጆሌኬሰንስ በርሲሳ፤ ዬሮ መነ ቴሱ፣ ዬሮ ከራ ዴምቱ፣ ዬሮ ጪፍቱፊ ዬሮ ደመቅጡት ዋኤሳኒ ኦዴስ። <verse eid="DEU 11:19"/><verse number="20" style="v" sid="DEU 11:20"/>ምችችለወን በልበለ መነኬቲቲፊ ከረወንኬረትስ እሳን በሬስ፤ <verse eid="DEU 11:20"/><verse number="21" style="v" sid="DEU 11:21"/>ኩንስ አከ ኡሙሪንኬሰኒፊ ኡሙሪን እጆሌኬሰኒ ብየ <char style="nd">ዋቀዮ</char> አቦቲኬሰኒፍ ኬኑፍ ከከቴ ኬሰት አኩመ ኡሙሪ ሰሚወን ለፋ ኦል ጅረኒት ዼረቱፍ።<verse eid="DEU 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 11:22"/>ዮ እስን አጀጀወን አን እስኒፍ ኬኑ ከኔን ሁንደ ኦፍ ኤገኖዻን ዱካ ቡተን ጄቹንስ ዮ እስን <char style="nd">ዋቀዮ</char> ዋቀኬሰን ጃለተን፣ ከራሳ ሁንደረ ዴምተኒፊ እሰት መጠንተን፣ <verse eid="DEU 11:22"/><verse number="23" style="v" sid="DEU 11:23"/><char style="nd">ዋቀዮ</char> ሰቦተ ሁንደ ፉለኬሰን ዱራ አርኤ ንባሰ፤ እስንስ ሰቦተ እስን ጫላ ጉርጉዳፊ ጀጀቦ ንዻልቱ። <verse eid="DEU 11:23"/><verse number="24" style="v" sid="DEU 11:24"/>ለፍት ሚልኬሰን እረ ዻበቴ ሁንድኑኬሰን ተአ፤ ዳሪንኬሰንስ ገሞጂዻ ሀመ ልባኖንት፣ ለገ ኤፍራጢሲ ሀመ ገላነ ልጣት ንበልአተ። <verse eid="DEU 11:24"/><verse number="25" style="v" sid="DEU 11:25"/>ነምን ከምዩ ፉለኬሰን ዱረ ዻበቹ ህንደንደኡ። <char style="nd">ዋቀዮ</char> ዋቅንኬሰን አኩመ እስን አብደቺሴት ርፈቺሱፊ ሶዳችሱኬሰን ለፈ እስን ዸቅጠን ሁንደረ ንቡሰ።<verse eid="DEU 11:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="DEU 11:26"/>ኩኖ፣ አን ሀርአ ኤባፊ አባርሰ ፉለኬሰን ዱረ ነንካአ፤ <verse eid="DEU 11:26"/><verse number="27" style="v" sid="DEU 11:27"/>ኤብ ኩንስ ዮ እስን አጀጀወን <char style="nd">ዋቀዮ</char> ዋቀኬሰኒ ከኔን አን ሀርአ እስኒፍ ኬኑ ኤግደኒዸ። <verse eid="DEU 11:27"/><verse number="28" style="v" sid="DEU 11:28"/>አባርስሞ ዮ እስን አጀጀወን <char style="nd">ዋቀዮ</char> ዋቀኬሰኒ ዸገኡ ድደኒ ከራ አን ሀርአ እስን አጀጄራ ገረገልተኒ ዋቆተ ብራ ከኔን እስን ዱራን ህንቤክኔ ዱካ ቡተኒዸ። <verse eid="DEU 11:28"/><verse number="29" style="v" sid="DEU 11:29"/>ዮሙ <char style="nd">ዋቀዮ</char> ዋቅንኬ ብየ አት ዻሉፍ እት ገልቱ ከነት ስ ፍዱት ቱሉ ጌርዚምረት ኤበ፣ ቱሉ ኤባልረትሞ አባርሰ ለብስተ። <verse eid="DEU 11:29"/><verse number="30" style="v" sid="DEU 11:30"/>ቱሉወን ኩኔን ዮርዳኖስ ገመት፣ ከራ ገረ ልጠ ቢፍቱት ጌሱን ገመ ልጣት፣ ሙከ ሞሬ ጉድቸ ብረት፣ ብየ ከነኣኖተ አረባ ኬሰ ጅራተን ኬሰት ፉሌ ግልጋልት አርገሙ ምቲ? <verse eid="DEU 11:30"/><verse number="31" style="v" sid="DEU 11:31"/>እስን ብየ <char style="nd">ዋቀዮ</char> ዋቅንኬሰን እስኒፍ ኬኑ ሴንተኒ ዻሉፍ ዮርዳኖስን ጬኡዻፍ ጅርቱ፤ ዮሙ ለፈ ሰነ ዻልተኒ እረ ጅራተንት፣ <verse eid="DEU 11:31"/><verse number="32" style="v" sid="DEU 11:32"/>አጀጀወኒፊ ሴረወን አን ሀርአ ፉለኬሰን ዱረ ካኡ ሁንደ ኤጋ።<verse eid="DEU 11:32"/></para>
  <chapter eid="DEU 11"/>
  <chapter number="12" style="c" sid="DEU 12"/>
  <para style="s1">እዶ ዋቄፈትናዻፍ ፍለተሜ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 12:1"/>ስርነወኒፊ ሴረወን እስን በረ ለፈረ ጅራተን ጉቱ ብየ <char style="nd">ዋቀዮ</char> ዋቅን አቦቲኬሰኒ አከ እስን ዻልተኒፍ እስኒፍ ኬኔ ኬሰት ኦፍ ኤገናዻን ኤግደን ከኔኒዸ። <verse eid="DEU 12:1"/><verse number="2" style="v" sid="DEU 12:2"/>እዶወን ሰቦትን እስንራ ፉዸተን ዋቆተሳኒ እት ዋቄፈተን ከኔን ቱሉወን ኦል ዼዼሮፊ ጋረንራ፣ አከሱመስ ከኔን ሙከ ለልሳ ከምዩ ጀላ ሁንደ ጉቱማን ጉቱት በሌሳ፤ <verse eid="DEU 12:2"/><verse number="3" style="v" sid="DEU 12:3"/>እዶወን ኣርሳሳኒ ዲጋ፤ ኡቱባወንሳኒ ከኔን ሰገዳ ጨጨብሳ፤ ኣሼራሳኒ እብዳን ጉባ፤ ፈኪ ዋቆተሳኒ ኩኩታ ገታ፤ መቃሳኒሌ እዶ ሰና በሌሳ።<verse eid="DEU 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="DEU 12:4"/>እስን ሃለ እሳን ዋቄፈተኒን <char style="nd">ዋቀዮ</char> ዋቀኬሰን ህንዋቄፈትና። <verse eid="DEU 12:4"/><verse number="5" style="v" sid="DEU 12:5"/>ገሩ እዶ <char style="nd">ዋቀዮ</char> ዋቅንኬሰን መቃሳ አች ዻቡፍ ጄዼ እዶ ጅሬኘሳቲፍ ጎሶተኬሰን ሁንደ ኬሳ ፍለቱ በርባዳ። አችስ ዸቃ፤ <verse eid="DEU 12:5"/><verse number="6" style="v" sid="DEU 12:6"/>አችትስ ኣርሳ ጉበሙፊ ቀልመኬሰን፣ ኬናኬሰን ኩዸን ኬሳ ቶኮ፣ ኬና አዳ፣ ዋን ኬኑፍ ወሬግደኒፊ ኬና ፌዺዻን ኬንተን፣ ሎኒፊ ቡሻዬኬሰን ኬሳ ሀንገፈ ዽኤሳ። <verse eid="DEU 12:6"/><verse number="7" style="v" sid="DEU 12:7"/>አችትስ አቲፊ ወር መነኬ ጅራተን ፉለ <char style="nd">ዋቀዮ</char> ዋቀኬሰኒ ዱረት ንኛቱ፤ ሰበቢ <char style="nd">ዋቀዮ</char> ዋቅንኬሰን ሆጂ ሀርከኬሰኒ ሁንዳን እስን ኤብሴፍስ ንገመዱ።<verse eid="DEU 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 12:8"/>አከ ኑ ሀርአ ጎዻ ጅሩ ከነ፣ አከ ቶኮን ቶኮን ነማ ዋኑመ ቶላ እት ፈካቴ ጎዹ ከነ ህንጎዽና፤ <verse eid="DEU 12:8"/><verse number="9" style="v" sid="DEU 12:9"/>እስን አመዩ ቦቆናፊ ዻለ <char style="nd">ዋቀዮ</char> ዋቅንኬሰን እስኒፍ ኬኑ ህንጌኜቲ። <verse eid="DEU 12:9"/><verse number="10" style="v" sid="DEU 12:10"/>ገሩ ዮርዳኖስ ጬተኒ ብየ <char style="nd">ዋቀዮ</char> ዋቅንኬሰን ዻለ ጎዼ እስኒፍ ኬኑ ኬሰ ንቁበቱ፤ እንስ አከ እስን ነጋን ጅራተኒፍ ዲኖተ ናኖኬሰኒ ሁንደ ጀላ ቦቆና እስኒ ኬነ። <verse eid="DEU 12:10"/><verse number="11" style="v" sid="DEU 12:11"/>ኤርገሲስ ገረ <char style="nd">ዋቀዮ</char> ዋቅንኬሰን እዶ ጅሬኘ መቃሳቲፍ ፍለቱት ዋን አን እስን አጀጄ ሁንደ ፍዱ ቀብዱ፤ ኩንስ ኣርሳ ጉበሙፊ ቀልመኬሰን፣ ኬናኬሰን ኩዸን ኬሳ ቶኮ፣ ኬና አዳ፣ አከሱመስ ወሬገ ፍለተማ <char style="nd">ዋቀዮፍ</char> ኬኑፍ ወሬግደን ሁንዳዸ። <verse eid="DEU 12:11"/><verse number="12" style="v" sid="DEU 12:12"/>አችትስ እስን፣ እልማኒፊ እንተለንኬሰን፣ ሆጄታፊ ጦምቦሬንኬሰን፣ አከሱመስ ሌዎትን መጋላወንኬሰን ኬሰ ጅራተን ከኔን ቆደ ዮካን ዻለ መታሳኒ ህንቀብኔስ ፉለ <char style="nd">ዋቀዮ</char> ዋቀኬሰኒ ዱረት ገመዳ። <verse eid="DEU 12:12"/><verse number="13" style="v" sid="DEU 12:13"/>አከ ኣርሳኬሰን ከን ጉበሙ እዱመ አርግተን ሁንደት ህንዽኤስኔ ኦፍ ኤገዻ። <verse eid="DEU 12:13"/><verse number="14" style="v" sid="DEU 12:14"/>እዶ <char style="nd">ዋቀዮ</char> ጎሶተኬ ኬሳ ፍለቱ ቶኮ ቆፈት ኣርሳወን ጉበመን ዽኤስ፤ አችትስ ዋን አን ስ አጀጁ ሁንደ ኤግ።<verse eid="DEU 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 12:15"/>ተኡስ አኩመ ኤበ <char style="nd">ዋቀዮ</char> ዋቅንኬ ሲፍ ኬኑት፣ መጋላወንኬ ከምዩ ኬሰት ኩሩጴ ዮካን ገደምሰ ቀለዹቲ ሀመ ፌቴ ኛዹ፤ ወር አከ ሴራት ህንቁልቁላእኒፊ ወር ቁልቁላአንስ ፎን ከነ ኛቹ ንደንደኡ። <verse eid="DEU 12:15"/><verse number="16" style="v" sid="DEU 12:16"/>እስን ገሩ ዺገ ሰነ ህንኛትና፤ አኩመ ብሻኒት ለፈት ዸንገላሳ። <verse eid="DEU 12:16"/><verse number="17" style="v" sid="DEU 12:17"/>አት ምዻንኬ ዮካን ዳዺ ወይኒኬቲ ዮካን ዘይቲኬ ሀርከ ኩዸን ኬሳ ሀርከ ቶኮ ዮካን ኬና ሀንገፈ ሎንኬቲ ዮካን ከን ቡሻዬኬቲ ዮካን ዋን ኬኑፍ ወሬገ ጎቱ ከምዩ ዮካን ኬና ፌዺኬቲን ኬንቱ ዮካን ኬና አዳ መጋላወንኬ ኬሰት ህንኛትን። <verse eid="DEU 12:17"/><verse number="18" style="v" sid="DEU 12:18"/>ቆደ ከና እዶ <char style="nd">ዋቀዮ</char> ዋቅንኬ ፍለቱት አት፣ እልማንኬ፣ እንተለንኬ፣ ሆጄቶትንኬ ዺራ ዱበርቲን፣ ሌዎትን መጋላወንኬ ኬሰ ጅራተን ፉለ <char style="nd">ዋቀዮ</char> ዋቀኬቲ ዱረት ኛዻ፤ አትስ ዋን ሀርክኬ ሆጄቱ ሁንዳን ፉለ <char style="nd">ዋቀዮ</char> ዋቀኬቲ ዱረት ገመድ። <verse eid="DEU 12:18"/><verse number="19" style="v" sid="DEU 12:19"/>በረ ብየኬ ኬሰ ጅራቱ ጉቱ አከ ሌዎተ ህንደገትኔ ኦፍ ኤገዹ።<verse eid="DEU 12:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 12:20"/>ዮሙ <char style="nd">ዋቀዮ</char> ዋቅንኬ አኩመ ስ አብደቺሴት ብየኬ ሲፍ በልእሱት፣ አት ዮ ፎን ዸራቴ፣ “አን ፎን ኛቹ ፌዸ” ጄቴ፣ ሀመ ፌቴ ኛቹ ደንዴሰ። <verse eid="DEU 12:20"/><verse number="21" style="v" sid="DEU 12:21"/>ዮ እዶን <char style="nd">ዋቀዮ</char> ዋቅንኬ መቃሳ አች ዻበቹፍ ፍለቱ አከ መሌ ስራ ፈጎ ተኤ፣ አኩመ አን ስ አጀጄት ሎኒፊ ቡሻዬ <char style="nd">ዋቀዮ</char> ዋቅንኬ ሲፍ ኬኔ ኬሳ ቀለቹ፣ መጋላወንኬ ኬሰትስ ሀመ ፌቴ ኛቹ ደንዴሰ። <verse eid="DEU 12:21"/><verse number="22" style="v" sid="DEU 12:22"/>አኩመ ኩሩጴን ዮካን ገደምስ ኛተሙ ሰነ እሳን ኛዹ፤ ወር አከ ሴራት ህንቁልቁላእኒፊ ወር ቁልቁላአን ሁንድ ኛቹ ንደንደኡ። <verse eid="DEU 12:22"/><verse number="23" style="v" sid="DEU 12:23"/>ገሩ አከ ዺገ ህንኛትኔ ኦፍ ኤገዹ፤ ሰበቢንሳ ዺግን ዋን ሉቡ ተኤፍ አት ፎን ወጅን ሉቡ ህንኛትን። <verse eid="DEU 12:23"/><verse number="24" style="v" sid="DEU 12:24"/>አት ዺገ ህንኛትን፤ አኩመ ብሻኒ ለፈት ዸንገላስ። <verse eid="DEU 12:24"/><verse number="25" style="v" sid="DEU 12:25"/>አከ ስኢፊ እጆሌኬ ከኔን ስ ዱባን ዸለተኒፍ ቶሉፍ አት ዺገ ህንኛትን፤ አት ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዋን ቀጄላ ሆጄቻ ጅርታቲ።<verse eid="DEU 12:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="DEU 12:26"/>ገሩ ወንቶተኬ ቁልቁሉፊ ዋን ኬኑፍ ወሬግዴ ፉዸዹ እዶ <char style="nd">ዋቀዮ</char> ፍለቱ ዸቅ። <verse eid="DEU 12:26"/><verse number="27" style="v" sid="DEU 12:27"/>ፎኒፊ ዺገ ኣርሳኬ ከን ጉበሙ እዶ ኣርሳ <char style="nd">ዋቀዮ</char> ዋቀኬቲረት ዽኤስ። ዺግን ኣርሳኬቲ እዶ ኣርሳ <char style="nd">ዋቀዮ</char> ዋቀኬቲ ብረት ዸንገላፈሙ ቀበ፤ ፎንሳ ገሩ ኛቹ ደንዴሰ። <verse eid="DEU 12:27"/><verse number="28" style="v" sid="DEU 12:28"/>አከ ስኢፊ እጆሌኬ ከኔን ስ ዱበ ዸለተኒፍ ዬሮ ሁንደ ቶሉፍ ቀጄልቸወን አን ሲፍ ኬኑ ከኔን ሁንደ ኦፍ ኤገናዻን ኤግ፤ ሰበቢንሳ አት እጀ <char style="nd">ዋቀዮ</char> ዋቀኬቲ ዱረት ዋን ጋሪፊ ቀጄላ ሆጄቻ ጅርታቲ።<verse eid="DEU 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="DEU 12:29"/>
    <char style="nd">ዋቀዮ</char> ዋቅንኬ ሰቦተ አት ዌረርቴ ብያ ባሱፍ ጅርቱ ፉለኬ ዱራ ንበሌሰ። አት ገሩ ዮሙ አሪቴ እሳን ባፍቴ ለፈሳኒረ ቁበቱት፣ <verse eid="DEU 12:29"/><verse number="30" style="v" sid="DEU 12:30"/>ኤርገ እሳን ፉለኬ ዱራ በሌፈመኒ ቦዴስ፣ “ሰቦትን ኩኔን አከምት ዋቆተሳኒ ተጃጅሉ? አንስ አከሱመን ጎዸ” ጄቴ ዋኤ ዋቆተሳኒ ጋፈቹዻን ክዮ ኬሰ አከ ህንገሌ ኦፍ ኤገዹ። <verse eid="DEU 12:30"/><verse number="31" style="v" sid="DEU 12:31"/>እሳን ሰበቢ ዋቆተሳኒ ዋቄፈቹዻን ሆጂ ጅብሲሳ <char style="nd">ዋቀዮ</char> ጅቡ ሄዱ ሆጄተኒፍ፣ አት ሃለሳኒቲን <char style="nd">ዋቀዮ</char> ዋቀኬ ህንዋቄፈትን። እሳን እልማንሳኒቲፊ እንተለንሳኒሌ ዋቆተሳኒቲፍ ኣርሳ ጎዸኒ እብዳን ጉቡ።<verse eid="DEU 12:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="DEU 12:32"/>አት ዋን አን ስ አጀጁ ሁንደ ኤግ፤ እት ህንደበልን፤ እራስ ህንህርእስን።<verse eid="DEU 12:32"/></para>
  <chapter eid="DEU 12"/>
  <chapter number="13" style="c" sid="DEU 13"/>
  <para style="s1">ዋቆተ ብራ ዋቄፈቹ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 13:1"/>ዮ ራጂን ዮካን ነምን አብጁዻን ዋን ዹፋ ጅሩ ህሙ ቶኮ ግዱኬሰንት አርገሜ መለቶወን ዮካን ድንቂ እስንት ህሜ፣ <verse eid="DEU 13:1"/><verse number="2" style="v" sid="DEU 13:2"/>ዮ መለቶን ዮካን ድንቂ እን እስንት ህሜ ሱን ራወተሜ እንስ፣ “ኮቱ ዋቆተ ብራ ከኔን አት ዱራን ህንቤክኔ ዱካ ቡኔ ሃዋቄፈትኑ” ሲን ጄዼ፣ <verse eid="DEU 13:2"/><verse number="3" style="v" sid="DEU 13:3"/>አት ዱቢ ራጂ ዮካን ነመ አብጆቱ ሰና ህንዸጌፈትን፤ <char style="nd">ዋቀዮ</char> ዋቅንኬ አከ እስን ገራኬሰን ጉቱፊ ያደኬሰን ጉቱዻን እሰ ጃለተን ቆሩፍ ዋን ከነ ጎዻቲ። <verse eid="DEU 13:3"/><verse number="4" style="v" sid="DEU 13:4"/><char style="nd">ዋቀዮ</char> ዋቀኬሰን ዱካ ቡኣ፤ እሰ ሶዳዻ። አጀጀወንሳ ኤጋ፤ እሳፍ አጀጀማ፤ እሰ ተጃጅላ፤ እሰትስ መጠና። <verse eid="DEU 13:4"/><verse number="5" style="v" sid="DEU 13:5"/>ራጃን ዮካን ነምች አብጁ አብጆቱ ሱን፣ ሰበቢ አከ እስን <char style="nd">ዋቀዮ</char> ዋቀኬሰን ከን ብየ ግብጢቲ እስን ባሴ ብየ ገርቡማ ጀላ እስን ፉሬ ሰነት ፍንጭልተን ዱበቴፍ አጄፈሙ ቀበ፤ እን ከራ <char style="nd">ዋቀዮ</char> ዋቅንኬሰን አከ ዱካ ቡተን እስን አጀጄራ እስን ጀልእሱፍ ያሌረ፤ ሀማ ኦፍ ኬሳ በሌስ።<verse eid="DEU 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 13:6"/>ዮ ኦቦሌስኬ ዮካን እልምኬ ዮካን እንተልኬ ዮካን ኒቲንኬ ከን አት ጃለቱ ዮካን ምቹንኬ፣ “ኮቱ ዋቆተ ብራ ከኔን አትስ ታቱ አቦቲንኬ ህንቤክን ዋቄፈትና” ጄዼ ዾክሳዻን ስ ዶጎጎርሱ በርባዴ፣ <verse eid="DEU 13:6"/><verse number="7" style="v" sid="DEU 13:7"/>ዮ እን ዋቆተ ሰቦተ ናኖኬቲ፣ ከኔን ዽኦ ዮካን ፈጎ ጅረን፣ ወረ ዳሪ ለፋ ቶኮ ሀመ ዳሪ ለፋ ካኒት ጅረኒ ዋቄፈትነ፣ ሲን ጄዼ፣ <verse eid="DEU 13:7"/><verse number="8" style="v" sid="DEU 13:8"/>ቶሌ ህንጄዽኒፍ ዮካን እሰ ህንዸገእን። ህንነእኒፍ። እሳፍ ህንህልን ዮካን ሀርከ እረ ህንቀብን። <verse eid="DEU 13:8"/><verse number="9" style="v" sid="DEU 13:9"/>አት እሰ አጄሱ ቀብደ። እሰ አጄሱፍስ ጀልቀበት ሀርክኬ፣ እት ኣንሴስ ሀርክ ሰበ ሁንዳ ሃከኡ። <verse eid="DEU 13:9"/><verse number="10" style="v" sid="DEU 13:10"/>ዋን እን አከ አት <char style="nd">ዋቀዮ</char> ዋቀኬ ከን ግብጥ፣ ብየ ገርቡማቲ ስ ባሴ ሰነራ ገረገልቱ ጎዼፍ ዸጋዻን ቱሚ እሰ አጄስ። <verse eid="DEU 13:10"/><verse number="11" style="v" sid="DEU 13:11"/>ኤርገሲ እስራኤሎን ሁንድ ዸገአኒ ንሶዳቱ፤ ስ ግዱዻስ ኤኙዩ ዴብኤ ዋን ሀማ አከሲ ህንሆጄቱ።<verse eid="DEU 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 13:12"/>ዮ አት መጋላወን አከ አት ኬሰ ጅራቱፍ <char style="nd">ዋቀዮ</char> ዋቅንኬ ሲፍ ኬኑ ኬሳ ቶኮትዩ ኡቱ አከስ ጄዸሙ ዸጌሴ፣ <verse eid="DEU 13:12"/><verse number="13" style="v" sid="DEU 13:13"/>ዮ ነሞትን ሀሞን እስን ግዱዻ ከአኒ፣ “ኮታ ዋቆተ ብራ ከኔን እስን ህንቤክኔ ዋቄፈትና” ጄዸኒ ሰበ መጋላሳኒ ዶጎጎርሱ ተኤ፣ <verse eid="DEU 13:13"/><verse number="14" style="v" sid="DEU 13:14"/>ዱቢ ሰነ እያፈዹ፤ ቆረዹ፤ ስሪት ጋፈዹ። ኩኖ፣ ዮ ዱቢን ሱን ዹጋ ተኤ ወን ጅብሲሳን ኩን ግዱኬት ሆጄተሙንሳ ምርከናኤ፣ <verse eid="DEU 13:14"/><verse number="15" style="v" sid="DEU 13:15"/>አት ነሞተ መጋላ ሰነ ኬሰ ጅራተን ሁንደ ጎራዴዻን ፍጥ፤ መጋላ ሰነሌ ነሞተሼቲፊ ሆሪሼ ወጅን ጉቱማን ጉቱት በርበዴስ። <verse eid="DEU 13:15"/><verse number="16" style="v" sid="DEU 13:16"/>ምአ ቦጁ ከን መጋላ ሰና አርገሜ ሁንደ ወለካ ኦብዲሼት ወልት ቀቢቲ መጋላ ሰነ ጉቱ ቦጁሼ ወጅን <char style="nd">ዋቀዮ</char> ዋቀኬቲፍ ኣርሳ ጉቱማን ጉበሙ ጎዺቲ ጉብ። እሼን በረ በራን በርበዶፍቴ ሃሀፍቱ፤ ዴብቴስ ህንእጃረምን። <verse eid="DEU 13:16"/><verse number="17" style="v" sid="DEU 13:17"/>አከ <char style="nd">ዋቀዮ</char> ዼከምሰሳ ሶዳችሳራ ዴብኡፍ ወን አባረሜ ቶኮ ሀርከኬት ህንአርገምን፤ እን ሲፍ አራረመ፤ ገራ ሲፍ ላፈ፤ አኩመ አቦቲኬቲፍ ከከቴት ስ ባይእሰ፤ <verse eid="DEU 13:17"/><verse number="18" style="v" sid="DEU 13:18"/>ኩንስ ዋን አት አጀጀወንሳ ከኔን አን ሀርአ ሲፍ ኬኑ ሁንደ ኤግዴ ፉለሳ ዱረት ዋን ቀጄላ ሆጄቹዻን <char style="nd">ዋቀዮ</char> ዋቀኬቲፍ አጀጀምቱፍ።<verse eid="DEU 13:18"/></para>
  <chapter eid="DEU 13"/>
  <chapter number="14" style="c" sid="DEU 14"/>
  <para style="s1">ኛተ ቁልቁሉ ተኤፊ ቁልቁሉ ህንተእን</para>
  <para style="r">
    <ref loc="DEU 14:3-20">14፥3‑20</ref> ኩወፈ – <char style="xt"><ref loc="LEV 11:1-23">ሌዎ 11፥1‑23</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 14:1"/>እስን እጆሌ <char style="nd">ዋቀዮ</char> ዋቀኬሰኒት። ነመ ዱኤፍ ጄተኒ ኦፍ ህንሙርሙርና ዮካን ርፌንሰ አደኬሰኒን ኦል ጅሩ ህንሃደትና፤ <verse eid="DEU 14:1"/><verse number="2" style="v" sid="DEU 14:2"/>አት <char style="nd">ዋቀዮ</char> ዋቀኬቲፍ ሰበ ቁልቁሉዻቲ። <char style="nd">ዋቀዮ</char> አከ አት ቀቤኘሳ ጃለተማ ታቱፍ ጄዼ ሰቦተ ለፈረ ጅራተን ሁንደ ኬሳ ስ ፍለቴረ።<verse eid="DEU 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="DEU 14:3"/>አት ዋን ጅብሲሳ ቶኮሌ ህንኛትን። <verse eid="DEU 14:3"/><verse number="4" style="v" sid="DEU 14:4"/>ሆሪን እስን ኛቹ ደንዴሰን ከኔኒዸ፤ ሰንጋ፣ ሆላ፣ ሬኤ፣ <verse eid="DEU 14:4"/><verse number="5" style="v" sid="DEU 14:5"/>ገደምሰ፣ ኩሩጴ፣ ቦሮፈ፣ ሬኤ ዲዳ፣ ዋልያ፣ ሳላፊ ሆላ ቱሉ። <verse eid="DEU 14:5"/><verse number="6" style="v" sid="DEU 14:6"/>ሆሪ ኮቴንሳ በቀቄ እዶ ለመት ገርገር ቆደሜ ከን ሀለለ ጉሩ ኛቹ ንደንዴሱ። <verse eid="DEU 14:6"/><verse number="7" style="v" sid="DEU 14:7"/>ገሩ ወረ ሀለለ ጉረን ዮካን ወረ ኮቴ በቀቃ ቀበን ኬሳ ጋለ፣ እሌቲ፣ ዮካን ኦሶሌ ህንኛትና፤ እሳን ኩኔን ሀለለ ጉረንዩ ዋን ኮቴንሳኒ ዱዳ ተኤፍ እሳን አከ ሴራት እስኒፍ ቁልቁሉ ምት። <verse eid="DEU 14:7"/><verse number="8" style="v" sid="DEU 14:8"/>ቦዬንስ ቁልቁሉ ምት፤ ኮቴንሳ በቀቃ ተኡስ ቦዬን ሀለለ ህንጉሩ። እስን ፎንሳኒ ህንኛትና ዮካን ረቀሳኒ ህንቱቅና።<verse eid="DEU 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 14:9"/>ኡመመወን ብሻን ኬሰ ጅራተን ሁንደ ኬሳ ወረ ቆቾፊ ቆለ ቀበን ከምዩ ኛቹ ደንዴሱ። <verse eid="DEU 14:9"/><verse number="10" style="v" sid="DEU 14:10"/>ገሩ ወረ ቆቾፊ ቆለ ህንቀብኔ ከምዩ ህንኛትና፤ እሳን እስኒፍ ቁልቁሉ ምት።<verse eid="DEU 14:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 14:11"/>እስን ስምብረ ቁልቁሉ ከምዩ ኛቹ ደንዴሱ። <verse eid="DEU 14:11"/><verse number="12" style="v" sid="DEU 14:12"/>እሳን ከኔን ገሩ ህንኛትና፤ እሳንስ ርሳ፣ ሩምቸ፣ ሩምቸ ጉራቸ፣ <verse eid="DEU 14:12"/><verse number="13" style="v" sid="DEU 14:13"/>ጩሉሌ፣ ጩሉሌ ጉራቸ፣ ጩሉሌ ጎሰ ገራ ገራ፣ <verse eid="DEU 14:13"/><verse number="14" style="v" sid="DEU 14:14"/>አራጌሰ ጎሰ ገራ ገራ፣ <verse eid="DEU 14:14"/><verse number="15" style="v" sid="DEU 14:15"/>ጉቺ፣ ኡሩንጉ፣ አላቲ ብሻኒ፣ ጮሮፌ ጎሰ ገራ ገራ፣ <verse eid="DEU 14:15"/><verse number="16" style="v" sid="DEU 14:16"/>ኡሩንጉ ጥና፣ ኡሩንጉ ጉዳ፣ ኡሩንጉ አዲ፣ <verse eid="DEU 14:16"/><verse number="17" style="v" sid="DEU 14:17"/>ኡሩንጉ ገሞጂ፣ አባ ኮዳ፣ ኡሩንጉ ጉዳ፣ <verse eid="DEU 14:17"/><verse number="18" style="v" sid="DEU 14:18"/>ሁሞ፣ አላቲ ጎሰ ከሚዩ፣ ሃዸ ጋዬቲፊ ስምብረ ሀልከኒት።<verse eid="DEU 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 14:19"/>እልቢሶን በርሰን ሁንድኑ እስኒፍ ቁልቁሉ ምት፤ እሳን ህንኛትና። <verse eid="DEU 14:19"/><verse number="20" style="v" sid="DEU 14:20"/>ኡመመወን ቆቾ ቀበን ከኔን ቁልቁሉ ተአን ከምዩ ገሩ ኛቹ ደንዴሱ።<verse eid="DEU 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 14:21"/>ዋን ኦፊሳቲን ዱኤ ቶኮሌ ህንኛትን። አከ እን ኛቱፍ አለጋ መጋላኬ ኬሰ ጅራቱፍ ኬን ዮካን ነመ ኦርማ ቶኮት ጉርጉረዹ። አት ገሩ ሰበ <char style="nd">ዋቀዮ</char> ዋቀኬቲፍ ቁልቁሌፈምቴዸ።</para>
  <para style="p" vid="DEU 14:21">እልሞ ሬኤ ቶኮ ኣነን ሃዻሼቲን ህንአፌልን።<verse eid="DEU 14:21"/></para>
  <para style="s1">ኩዸን ኬሳ ሀርከ ቶኮ</para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 14:22"/>ዋን ለፍት ቆቲሳኬ ወጋት ኬኑ ሁንደ ኬሳ ኩዸን ኬሳ ቶኮ ኮጳት ባሲ ካእ። <verse eid="DEU 14:22"/><verse number="23" style="v" sid="DEU 14:23"/>አከ <char style="nd">ዋቀዮ</char> ዋቀኬ ሶዳቹ በረቱፍ እዶ እን አከ መቃንሳ አች ጅራቱፍ ፍለቱት ምዻንኬ፣ ወይኒኬ ሃራፊ ዘይቲኬ አከሱመስ ሀንገፈ ሎኒፊ ቡሻዬኬ ፉለ <char style="nd">ዋቀዮ</char> ዋቀኬቲ ዱረት ኛዹ። <verse eid="DEU 14:23"/><verse number="24" style="v" sid="DEU 14:24"/>ገሩ ዮ እዶን ሱን አከ መሌ ፈጋቴ፣ አትስ <char style="nd">ዋቀዮ</char> ዋቀኬቲን ኤብፈምቴ ሰበቢ እዶን <char style="nd">ዋቀዮ</char> አከ መቃንሳ አች ጅራቱፍ ፍለቱ ሱን ፈጎ ተኤፍ ኬናኬ ኩዸን ኬሳ ቶኮ ባቹ ደዸብዴ፣ <verse eid="DEU 14:24"/><verse number="25" style="v" sid="DEU 14:25"/>ኬናኬ ከን ኩዸን ኬሳ ቶኮ ሰነ ሜቲት ጌደሪቲ፣ ሜቲ ሰነ ቀበዹቲ እዶ <char style="nd">ዋቀዮ</char> ዋቅንኬ ፍለቱ ዸቅ። <verse eid="DEU 14:25"/><verse number="26" style="v" sid="DEU 14:26"/>ሜቲ ሰናንስ ዋኑመ ፌቴ ጄቹንስ፣ ሎን፣ ሆሎተ፣ ዳዺ ወይኒ ዮካን ዹጋቲ ጀባ፣ ዮካን ዋን በርባዴ ከምዩ ብት። ኤርገሲ አቲፊ ወር መነኬቲ ፉለ <char style="nd">ዋቀዮ</char> ዋቀኬቲ ዱረት ኛዻ ገመዳ። <verse eid="DEU 14:26"/><verse number="27" style="v" sid="DEU 14:27"/>ሌዎትን መጋላኬ ኬሰ ጅራተን ቆደ ዮካን ዻለ ኦፊሳኒ ዋን ህንቀብኔፍ አት እሳን ህንደገትን።<verse eid="DEU 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="DEU 14:28"/>ዬሮ ሁንደ ዹመ ወጋ ሰደፋት ዋን ወጋ ሰነ ኬሰ ገልፈቴ ኩዸን ኬሳ ቶኮ ፉዺቲ መጋላወን ኬሰት ኩስ። <verse eid="DEU 14:28"/><verse number="29" style="v" sid="DEU 14:29"/>ኩንስ አከ ሌዎትን ቆደ ዮካን ዻለ ኦፊሳኒ ህንቀብኔ፣ አለጎን፣ እጆሌን አባ ህንቀብኔፊ ኒቶትን ዽርሶትንሳኒራ ዱአን ወር መጋላወን ኬሰ ጅራተን ኛተኒ ቁፈኒፊ አከ <char style="nd">ዋቀዮ</char> ዋቅንኬ ሆጂ ሀርከኬቲ ሁንዳን ስ ኤብሱፍ።<verse eid="DEU 14:29"/></para>
  <chapter eid="DEU 14"/>
  <chapter number="15" style="c" sid="DEU 15"/>
  <para style="s1">ወጋ እት ገቲን ነማፍ ዺፈሙ</para>
  <para style="r">
    <ref loc="DEU 15:1-11">15፥1‑11</ref> ኩወእ – <char style="xt"><ref loc="LEV 25:8-38">ሌዎ 25፥8‑38</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 15:1"/>አት ዬሮ ሁንደ ዹመ ወጋ ቶርበፋት ገቲ ነማፍ ዺሱ ቀብደ። <verse eid="DEU 15:1"/><verse number="2" style="v" sid="DEU 15:2"/>ኩንስ አከነት ተአ፦ ነምን ልቂ ኬኑ ሁንዲ ልቂ ኦላሳ ነመ እስራኤሊፍ ልቄሴ ዺሱፊ ቀበ። ሰበቢ ዬሮን <char style="nd">ዋቀዮ</char> ከን እት ገቲን ነማፍ ዺፈሙ ለብሰሜፍ እን ኦላሳ ዮካን ኦቦሌሰሳ እስራኤልቸራ ዋን እሳፍ ልቄሴ ህንጋፈትን። <verse eid="DEU 15:2"/><verse number="3" style="v" sid="DEU 15:3"/>አት ዋን አለጋፍ ልቄስቴ ጋፈቹ ንደንዴሰ፤ ገሩ ዋን ኦቦሌስኬ ስራ ልቄፈቴ ዺሱፊ ቀብደ። <verse eid="DEU 15:3"/><verse number="4" style="v" sid="DEU 15:4"/>ተኡስ ዋን <char style="nd">ዋቀዮ</char> ዋቅንኬ ብየ አከ አት ዻልቱፍ ሲፍ ኬኑረት አከ መሌ ስ ኤብሱፍ ህዬስ ግዱኬት ህንአርገሙ፤ <verse eid="DEU 15:4"/><verse number="5" style="v" sid="DEU 15:5"/>ኩንስ ዮ አት ጉቱማን ጉቱት <char style="nd">ዋቀዮ</char> ዋቀኬቲፍ አጀጀምቴፊ ዮ አት አጀጀወን አን ሀርአ ሲፍ ኬኑ ከኔን ሁንደ ኤግዴ ቆፈ ተአ። <verse eid="DEU 15:5"/><verse number="6" style="v" sid="DEU 15:6"/>ዋን <char style="nd">ዋቀዮ</char> ዋቅንኬ አኩመ ስ አብደቺሴት ስ ኤብሱፍ አት ሰቦተ ባይኤዻፍ ልቄስተ መሌ ቶኮራዩ ህንልቄፈቱ። አት ሰቦተ ባይኤ ቡልችተ መሌ እሳን ስ ህንቡልቸን።<verse eid="DEU 15:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 15:7"/>መጋላወን <char style="nd">ዋቀዮ</char> ዋቅንኬ ሲፍ ኬኑ ኬሰት ዮ ኦቦሎተኬ ግዱ ህዬስ ጅራቴ ኦቦሌሰኬ ሰነረት ገራንኬ ህንጀባትን ዮካን እሰ ገርጋሩራ ሀርከኬ ህንዴብፈትን። <verse eid="DEU 15:7"/><verse number="8" style="v" sid="DEU 15:8"/>ቆደ ከና ሀርከኬ እሳፍ ድሪርሲቲ ዋን እሰ ገኡ ልቄሲፍ። <verse eid="DEU 15:8"/><verse number="9" style="v" sid="DEU 15:9"/>አከ ያድን ሀማን፣ “ወጋን ቶርበፋን፣ ወጋን እት ገቲን ነማፍ ዺፈሙ ሱን ዽኣቴረ” ጄዹ ስ ኬሰት ኩፈሜ አት አከሲን ኦቦሌሰኬ ረከታ እጀ ሀማዻን እላልቴ ገርጋሩ ህንዺፍኔ ኦፍ ኤገዹ። እን <char style="nd">ዋቀዮት</char> ኦል እየተ፤ ኩንስ ጩቡ ስት ተአ። <verse eid="DEU 15:9"/><verse number="10" style="v" sid="DEU 15:10"/>አት አርጁማዻን እሳፍ ኬን፤ ዮሙ ኬንቱፍስ ገራንኬ ህንጋብን፤ ሰበቢ ከናፍ <char style="nd">ዋቀዮ</char> ዋቅንኬ ሆጂኬ ሁንዳፊ ዋን ሀርክኬ ቀበቴ ሁንዳን ስ ኤብሰ። <verse eid="DEU 15:10"/><verse number="11" style="v" sid="DEU 15:11"/>ዮምዩ ታናን ህዬዪን ለፈረ ንጅራቱ። ከናፉ አን አከ አት ሀርከኬ ኦቦሎተኬቲፍ፣ ህዬዪፊ ረከቶተ ብየኬቲቲፍ ድሪርፈቱ ስን አጀጀ።<verse eid="DEU 15:11"/></para>
  <para style="s1">ገርቦተ ብልሶምሱ</para>
  <para style="r">
    <ref loc="DEU 15:12-18">15፥12‑18</ref> ኩወፈ – <char style="xt"><ref loc="EXO 21:2-6">በኡ 21፥2‑6</ref></char></para>
  <para style="r">
    <ref loc="DEU 15:12-18">15፥12‑18</ref> ኩወእ – <char style="xt"><ref loc="LEV 25:38-55">ሌዎ 25፥38‑55</ref></char></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 15:12"/>ዮ ነምን ጎሰ እብሮታ፣ ዺር ዮካን ዱበርቲን ስት ጉርጉረምቴ ወጋ ጀአ ሲፍ ሆጄቴ፣ ወጋ ቶርበፋት ብልሰ ባሲ ገድ ዺስ። <verse eid="DEU 15:12"/><verse number="13" style="v" sid="DEU 15:13"/>ዮሙ ገድ ዺፍቱትስ ሀርከ ዱዋ ህንጌጌስን። <verse eid="DEU 15:13"/><verse number="14" style="v" sid="DEU 15:14"/>ቡሻዬኬ ኬሳ፣ ኦብዲፊ እዶ ጩንፋ ወይኒኬቲራ አርጁማዻን ኬኒፍ። አኩመ <char style="nd">ዋቀዮ</char> ዋቅንኬ ስ ኤብሴት እሳፍ ኬን። <verse eid="DEU 15:14"/><verse number="15" style="v" sid="DEU 15:15"/>አከ አትስ ብየ ግብጥት ገርበ ቱርቴፊ አከ <char style="nd">ዋቀዮ</char> ዋቅንኬ ስ ፉሬ ያደዹ። ወን አን ሀርአ አጀጀ ከነ ሲፍ ኬኑፍስ ከኑመ።<verse eid="DEU 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 15:16"/>ገሩ ዮ ገርብችኬ ሱን ሰበቢ ስኢፊ ማቲኬ ጃለቱፍ ስ ወጅን ጅራቹን እት ቶሌ፣ “አን ስ ዺሴ ህንዴሙ” ሲን ጄዼ፣ <verse eid="DEU 15:16"/><verse number="17" style="v" sid="DEU 15:17"/>ሙታ ፉዺ በልበለረት ጉረሳ ኡር፤ እንስ በረ በራን ገርብቸኬ ተአ። ገርብቲኬስ አከሱመ ጎዽ።<verse eid="DEU 15:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 15:18"/>ገርብቸኬ ብልሶምሱን ዋን ኡልፋታ ስት ህንፈካትን፤ ተጃጅልሳ ከን ወጋ ጀኣ ሱን ገቲ ነመ ቀጠረሜ ሆጄቱ ቶኮት ሀርከ ለመ ቱሬቲ። <char style="nd">ዋቀዮ</char> ዋቅንኬ ዋን አት ሆጄቱ ሁንዳን ስ ኤብሰ።<verse eid="DEU 15:18"/></para>
  <para style="s1">ሆሪ ሀንገፈ</para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 15:19"/>ሎኒፊ ቡሻዬኬ ኬሳ ኮርመ ሀንገፈ ሁንደ <char style="nd">ዋቀዮ</char> ዋቀኬቲፍ አዳን ባስ፤ ቆትዮኬ ኬሳ ሀንገፋን ህንሆጄትን፤ ሀንገፈ ሆላኬቲራ ርፌንሰ ህንሙርን። <verse eid="DEU 15:19"/><verse number="20" style="v" sid="DEU 15:20"/>ወጋ ወጋዻን አቲፊ ማቲንኬ እዶ <char style="nd">ዋቀዮ</char> ዋቅንኬ ፍለቱት ፉለሳ ዱረት እሳን ኛቱ። <verse eid="DEU 15:20"/><verse number="21" style="v" sid="DEU 15:21"/>ዮ ሆሪን ሱን ህርእነ ቀባቴ ጄቹንስ ዮ እን ናፈ ዮካን ጃማ ዮካን ሙዳ ሀማ ከምዩ ቀባቴ፣ አት ሆሪ ሰነ ኣርሳ ጎቴ <char style="nd">ዋቀዮ</char> ዋቀኬቲፍ ህንዽኤስን። <verse eid="DEU 15:21"/><verse number="22" style="v" sid="DEU 15:22"/>አት መጋላኬ ኬሰት ኛዹ። አኩመ ዋን ሆሪን ሱን ኩሩጴ ዮካን ገደምሰ ተኤት ነምን አከ ሴራት ቁልቁሉ ህንተእኒፊ ከን ቁልቁሉ ተኤ ኛቹ ደንደአ። <verse eid="DEU 15:22"/><verse number="23" style="v" sid="DEU 15:23"/>አት ገሩ ዺገ ሰነ ህንኛትን፤ አኩመ ብሻኒት ለፈት ዸንገላስ።<verse eid="DEU 15:23"/></para>
  <chapter eid="DEU 15"/>
  <chapter number="16" style="c" sid="DEU 16"/>
  <para style="s1">ፋሲካ</para>
  <para style="r">
    <ref loc="DEU 16:1-8">16፥1‑8</ref> ኩወፈ – <char style="xt"><ref loc="EXO 12:14-20">በኡ 12፥14‑20</ref>፤ <ref loc="LEV 23:4-8">ሌዎ 23፥4‑8</ref>፤ <ref loc="NUM 28:16-25">ለኮ 28፥16‑25</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 16:1"/>ሰበቢ <char style="nd">ዋቀዮ</char> ዋቅንኬ ጅአ አቢቢ ኬሰ ሀልከኒን ግብጢ ስ ባሴፍ ጅአ አቢቢ ከበጅ፤ ፋሲካ <char style="nd">ዋቀዮ</char> ዋቀኬቲስ አያኔፈዹ። <verse eid="DEU 16:1"/><verse number="2" style="v" sid="DEU 16:2"/>እዶ <char style="nd">ዋቀዮ</char> ዋቅንኬ አከ መቃንሳ አች ጅራቱፍ ፍለቱት ቡሻዬኬ ዮካን ሎንኬ ኬሳ ፋሲካ ጎዺ <char style="nd">ዋቀዮ</char> ዋቀኬቲፍ ቀል። <verse eid="DEU 16:2"/><verse number="3" style="v" sid="DEU 16:3"/>አት አከ በረ ጅሬኘኬቲ ጉቱ ጉያ እት ግብጢ ባቴ ሰነ ያደቱፍ ፋሲካ ሰነ ቡዴነ ራጭቲ ቀቡ ወጅን ህንኛትን፤ ገሩ አት ሰበቢ አሪቲዻን ብየ ግብጢቲ ባቴፍ ቡልቲ ቶርበ መጥኖ ጄቹንስ ቡዴነ ረክና ኛዹ። <verse eid="DEU 16:3"/><verse number="4" style="v" sid="DEU 16:4"/>ጉቱማ ብየኬቲ ኬሰት ቡልቲ ቶርባፍ ራጭቲን ህንአርገምን። ፎን አት ገልገለ ጉያ ጀልቀባት ኣርሳ ጎቱ ሀመ በሪት ህንቱርን።<verse eid="DEU 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 16:5"/>አት መጋላ <char style="nd">ዋቀዮ</char> ዋቅንኬ ሲፍ ኬኑ ከምትዩ ፋሲካ ህንዽኤስን፤ <verse eid="DEU 16:5"/><verse number="6" style="v" sid="DEU 16:6"/>ገሩ ለፈ እን እዶ ጅሬኘ መቃሳቲፍ ፍለቱት ገልገለ ዬሮ ቢፍቱን ገድ ቡቱት ያደኖ ጉያ እት ብየ ግብጢቲ ባቴቲፍ ኣርሳ ፋሲካ ዽኤስ። <verse eid="DEU 16:6"/><verse number="7" style="v" sid="DEU 16:7"/>ኣርሳ ፋሲካ ሰነ ዋዲቲ እዶ <char style="nd">ዋቀዮ</char> ዋቅንኬ ፍለቱት ኛዹ። ኤርገሲስ ገነመ ገረ ዱንካነኬቲት ዴብእ። <verse eid="DEU 16:7"/><verse number="8" style="v" sid="DEU 16:8"/>ቡልቲ ጀአ መጥኖ ኛዹ፤ ቡልቲ ቶርበፋትሞ <char style="nd">ዋቀዮ</char> ዋቀኬቲፍ ወል ገኢ ቁልቁሉ ጎዽ፤ ሆጂሌ ህንሆጄትን።<verse eid="DEU 16:8"/></para>
  <para style="s1">አያነ ቶርበኖታ</para>
  <para style="r">
    <ref loc="DEU 16:9-12">16፥9‑12</ref> ኩወፈ – <char style="xt"><ref loc="LEV 23:15-22">ሌዎ 23፥15‑22</ref>፤ <ref loc="NUM 28:26-31">ለኮ 28፥26‑31</ref></char></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 16:9"/>ጋፈ ምዻንኬ ሃሙ ጀልቀብዴ ካሲ ቶርበኖተ ቶርበ ለካእ። <verse eid="DEU 16:9"/><verse number="10" style="v" sid="DEU 16:10"/>ኤርገሲስ አኩመ ባይእነ ኤበ <char style="nd">ዋቀዮ</char> ዋቅንኬ ሲፍ ኬኔት ኬና ፌዺዻን ኬንቱ ዽኤሱዻን አያነ ቶርበኖታ <char style="nd">ዋቀዮ</char> ዋቀኬቲፍ አያኔፈዹ። <verse eid="DEU 16:10"/><verse number="11" style="v" sid="DEU 16:11"/>አት፣ እልማኒፊ እንተለንኬ፣ ሆጄቶትንኬ ዺሮትኒፊ ዱበርቲን፣ ሌዎትን መጋላወንኬ ኬሰ ጅራተን፣ አለጎን፣ እጆሌን አባ ህንቀብኔፊ ኒቶትን ዽርሶትንሳኒራ ዱአን ከኔን እስን ግዱ ጅራተን አችት፣ እዶ <char style="nd">ዋቀዮ</char> ዋቅንኬ እዶ ጅሬኘ መቃሳቲፍ ፍለቱት ፉለሳ ዱረት ንገመዱ። <verse eid="DEU 16:11"/><verse number="12" style="v" sid="DEU 16:12"/>አት አከ ግብጥት ገርበ ቱርቴ ያደዹ፤ ሴረ ከነስ አከ ጋሪት ኤግ።<verse eid="DEU 16:12"/></para>
  <para style="s1">አያነ ዳሲ</para>
  <para style="r">
    <ref loc="DEU 16:13-17">16፥13‑17</ref> ኩወፈ – <char style="xt"><ref loc="LEV 23:33-43">ሌዎ 23፥33‑43</ref>፤ <ref loc="NUM 29:12-39">ለኮ 29፥12‑39</ref></char></para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 16:13"/>ኤርገ ኦብዲፊ እዶ ጩንፋ ወይኒኬቲራ ኦምሸኬ ገልፈቴ ቦዴ ጉያ ቶርባፍ አያነ ዳሲ አያኔፈዹ። <verse eid="DEU 16:13"/><verse number="14" style="v" sid="DEU 16:14"/>አት፣ እልማኒፊ እንተለንኬ፣ ተጃጅልቶትንኬ ዺሮትኒፊ ዱበርቶትን፣ ሌዎትን፣ አለጎን፣ እጆሌን አቦቲ ህንቀብኔፊ ዱበርቶትን ዽርሶትንሳኒራ ዱአን ከኔን መጋላወንኬ ኬሰ ጅራተን አያነኬረት ገመዳ። <verse eid="DEU 16:14"/><verse number="15" style="v" sid="DEU 16:15"/>አያነ ከነስ እዶ <char style="nd">ዋቀዮ</char> ፍለቱት ቡልቲ ቶርባፍ <char style="nd">ዋቀዮ</char> ዋቀኬቲፍ አያኔፈዹ። ሰበቢ <char style="nd">ዋቀዮ</char> ዋቅንኬ ኦምሸኬቲፊ ሆጂ ሀርከኬቲ ሁንዳን ስ ኤብሱፍ ገመቹንኬ ጉቱ ተአ።<verse eid="DEU 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 16:16"/>ዺርኬ ሁንድ ወጋት ዬሮ ሰዲ እዶ እን ፍለቱት ፉለ <char style="nd">ዋቀዮ</char> ዋቀኬቲ ዱረት ዽኣቹ ቀቡ፤ ኩንስ ዬሮ አያነ መጥኖ፣ ዬሮ አያነ ቶርበኖታቲፊ ዬሮ አያነ ዳሲት። ነምን ቶኮዩ ሀርከ ዱዋ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ህንዽኣትን፦ <verse eid="DEU 16:16"/><verse number="17" style="v" sid="DEU 16:17"/>ቶኮን ቶኮንኬሰን አኩመ ባይእነ ኤበ <char style="nd">ዋቀዮ</char> ዋቅንኬሰን እስኒፍ ኬኔት ኬና ፍዳ።<verse eid="DEU 16:17"/></para>
  <para style="s1">አቦቲ ሙርቲ</para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 16:18"/>መጋላወን <char style="nd">ዋቀዮ</char> ዋቅንኬ ሲፍ ኬኑ ሁንደቱ ጎሶተኬ ሁንዳፍ አቦቲ ሴራቲፊ ቆንዳልቶተ ሙድ፤ እሳንስ ዹጋዻን ነሞታፍ ሙርቲ ኬኑ። <verse eid="DEU 16:18"/><verse number="19" style="v" sid="DEU 16:19"/>አት ሙርቲ ህንጀልእስን ዮካን ነመ ወል ህንጫልችስን። መተኣ ህንፉዸትን፤ መተኣን እጀ ኦጌዪ ጃምሴ ዱቢ ቀጄልቶታስ ጀልእሰ። <verse eid="DEU 16:19"/><verse number="20" style="v" sid="DEU 16:20"/>አት አከ ሉቡዻን ጅራቴ ለፈ <char style="nd">ዋቀዮ</char> ዋቅንኬ ሲፍ ኬኑ ዻልቱፍ ሙርቲ ቀጄላ ቆፈ ዱካ ቡእ።<verse eid="DEU 16:20"/></para>
  <para style="s1">ዋቆተ ብራ ዋቄፈቹ</para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 16:21"/>እዶ ኣርሳ ከን <char style="nd">ዋቀዮ</char> ዋቀኬቲፍ ዻብዴ ብረ ሲዳ ኣሼራ ህንዻብን። <verse eid="DEU 16:21"/><verse number="22" style="v" sid="DEU 16:22"/>ሶዱ ዸጋ ከን <char style="nd">ዋቀዮ</char> ዋቅንኬ ጅቡ ኦፊኬቲፍ ህንዻበትን።<verse eid="DEU 16:22"/></para>
  <chapter eid="DEU 16"/>
  <chapter number="17" style="c" sid="DEU 17"/>
  <para style="p">
    <verse number="1" style="v" sid="DEU 17:1"/>ሰንጋ ዮካን ሆላ ፈፈ ዮካን ህርእነ ከምዩ ቀቡ <char style="nd">ዋቀዮ</char> ዋቀኬቲፍ ኣርሳ ህንዽኤስን፤ ወን አከሲ እሰ ብረት ጅብሲሳዻቲ።<verse eid="DEU 17:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="DEU 17:2"/>ዮ ዺር ዮካን ዱበርቲን መጋላወን <char style="nd">ዋቀዮ</char> ዋቅንኬ ሲፍ ኬኑ ኬሳ ቶኮ ኬሰ ግዱኬ ጅራቱ ቶኮ ከኩሳ ጨብሱዻን ፉለ <char style="nd">ዋቀዮ</char> ዋቀኬቲ ዱረት ዋን ሀማ ሆጄቴ አርገሜ፣ <verse eid="DEU 17:2"/><verse number="3" style="v" sid="DEU 17:3"/>ዮ አጀጀኮ ደርቤ ዋቆተ ኦርማ ዋቄፈቴ፣ ገድ ጄዼ ቢፍቱፍ ዮካን ጅኣፍ ዮካን ኡርጂወን ሰሚቲፍ ሰገዴ፣ <verse eid="DEU 17:3"/><verse number="4" style="v" sid="DEU 17:4"/>ዮ ወን ኩን ስት ህመሜ አትስ ዸጌሴ፣ ዱብቸ ገድ ቀቢ አከ ጋሪት ቆረዹ፤ ዮ ወን ጄዸሜ ሱን ዹጋ ተኤ ወን ጅብሲሳን አከሲ እስራኤል ኬሰት ሆጄተሙንሳ ምርከናኤ፣ <verse eid="DEU 17:4"/><verse number="5" style="v" sid="DEU 17:5"/>ነምቸ ዮካን ዱበርቲ ዋን ሀማ ከነ ሆጄቴ ገረ በልበለ መጋላ ሰናት ጌሲቲ ዸጋዻን ቱሚ አጄስ። <verse eid="DEU 17:5"/><verse number="6" style="v" sid="DEU 17:6"/>ነምን ዱት እሳፍ መሉ ቶኮ ዹገ በኡምሰ ነመ ለማ ዮካን ሰዲቲን ሃአጄፈሙ፤ ገሩ ዹገ በኡምሰ ነመ ቶኮ ቆፋን ነምን ከምዩ አጄፈሙ ህንቀቡ። <verse eid="DEU 17:6"/><verse number="7" style="v" sid="DEU 17:7"/>ዮሙ አጄፈሙስ ጀልቀበት ሀርክ ዹገ ባቶታ፣ እት ኣንሴሞ ከን ሰባ እሰረ ሃቡኡ፤ አት ዋን ሀማ ኦፍ ኬሳ ባሱ ቀብደ።<verse eid="DEU 17:7"/></para>
  <para style="s1">መነ ሙርቲ ሴራ</para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 17:8"/>ዮ ዱቢወን ሙርቴሱፍ ረክሳ ተአን መነ ሙርቲኬት ዽኣተን ጄቹንስ ከን አከ ዺገ ዸንገላሱ፣ ወል ሞርሚ ሴረ ቶኮቲፊ ከን ብራ፣ ዮካን ሚዻ ዸግነረ ገኡ ከን ገራ ገራ ግዱት ወን ሙርቲ ኬኑፍ ረክሱ ዮ ከኤ፣ አት ለፈ <char style="nd">ዋቀዮ</char> ዋቅንኬ ፍለቱት ጌስ። <verse eid="DEU 17:8"/><verse number="9" style="v" sid="DEU 17:9"/>ገረ ሌዎተ ወረ ሉቦተ ተአኒቲፊ ቆንዳልቶተ ዬሮ ሰነ ሆጂረ ቱረኒ ዸቅ። ዋኤ ዱቢ ሰና እሳኒን መርአዹ፤ እሳንስ ሙርቲሳ ስት ህሙ። <verse eid="DEU 17:9"/><verse number="10" style="v" sid="DEU 17:10"/>አትስ አኩመ ያደ እሳን ሲፍ ኬነን ሰናት እዶ <char style="nd">ዋቀዮ</char> ፍለቱት ሙርቲ ኬኑ ቀብደ። ዋን ሁንደ ቀጄልፈመ እሳን ሲፍ ኬነኒን ሆጄዹ። <verse eid="DEU 17:10"/><verse number="11" style="v" sid="DEU 17:11"/>አከ ሴረ እሳን ስ በርሲሰኒቲፊ አከ ቀጄልፈመ እሳን ሲፍ ኬነኒት ሆጄዹ። ዋን እሳን ስት ህመንራ ምርገት ዮካን ብታት ህንጎርን። <verse eid="DEU 17:11"/><verse number="12" style="v" sid="DEU 17:12"/>ነምን አባ ሴራ ዮካን ሉበ <char style="nd">ዋቀዮ</char> ዋቀኬ ተጃጅሉፍ አች ዻበቱ ቱፈቱ ሃአጄፈሙ። አት ዋን ሀማ እስራኤል ኬሳ ባሱ ቀብደ። <verse eid="DEU 17:12"/><verse number="13" style="v" sid="DEU 17:13"/>ሰብን ሁንድስ ዋን ከነ ዸገኤ ንሶዳተ፤ እት ዴብኤስ ህንቱፈቱ።<verse eid="DEU 17:13"/></para>
  <para style="s1">ሞቲ ሞስፈቹ</para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 17:14"/>አት ዮሙ ብየ <char style="nd">ዋቀዮ</char> ዋቅንኬ ሲፍ ኬኑት ገልቴ ዻልቱፊ ብየ ሰነ ኬሰ ቁበቴ፣ “አኩመ ሰቦተ ናኖኮ ጅራተኒት አንስ ሞቲ ኦፍ እረተን ሞስሰ” ጄቱት፣ <verse eid="DEU 17:14"/><verse number="15" style="v" sid="DEU 17:15"/>ሞቲ <char style="nd">ዋቀዮ</char> ዋቅንኬ ፍለቱ ኦፍ እረት ሞስስ። ነመ ኦቦሌሰኬ እስራኤል ተኤ ኬሳ መሌ ነመ ብየ አላ ኦፍ እረት ህንሞስስን። <verse eid="DEU 17:15"/><verse number="16" style="v" sid="DEU 17:16"/>ሰበቢ <char style="nd">ዋቀዮ</char>፣ “ለመተ ገረስ ህንዴብተን” ጄዼ ስት ህሜፍ፣ ሞትች ኦፊሳቲ ፈርዴን ህንባይእፈትን ዮካን ለኮብሰ ፈርዴኒ ባይእፈቹፍ ጄዼ ገረ ግብጥት ሰበ ህንዴብስን። <verse eid="DEU 17:16"/><verse number="17" style="v" sid="DEU 17:17"/>አከ ያድንሳ ህንበድኔፍ እን ኒቶተ ባይኤ ፉዹ ህንቀቡ፤ ሜቲፊ ወርቄ ባይእሴስ ወልት ቀበቹ ህንቀቡ።<verse eid="DEU 17:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 17:18"/>እን ዮሙ ቴሶ ሞቱማሳረ ታኡት ገረገልቻ ሴረ ከና ሉቦተ ሌዎተ ተአንራ ፉዸቴ ክታበ መረማረት ኦፊሳቲ ሃበሬፈቱ። <verse eid="DEU 17:18"/><verse number="19" style="v" sid="DEU 17:19"/>እን አከ <char style="nd">ዋቀዮ</char> ዋቀሳ ሶዳቹ በረቱፍ ዱቢ ሴረ ከና ሁንዳፊ አጀጀወን ከኔን ኦፍ ኤገናዻን ዱካ ቡኡፍ ክታብች እሰ ወጅን ሃቱሩ፤ እንስ በረ ጅሬኘሳ ጉቱ ሃዱብሱ፤ <verse eid="DEU 17:19"/><verse number="20" style="v" sid="DEU 17:20"/>ኩንስ አከ እን አከ ዋን ኦቦሎተሳ ጫሉት ኦፍ እላሌ ሴርቸራ ገረ ምርጋት ዮካን ብታት ህንጎሬፍ። አከሲንስ እኒፊ ሰኚንሳ ሞቱማሳረት እስራኤል ኬሰት በረ ዼራዻፍ ንሞኡ።<verse eid="DEU 17:20"/></para>
  <chapter eid="DEU 17"/>
  <chapter number="18" style="c" sid="DEU 18"/>
  <para style="s1">ቆደ ሉቦታቲፊ ሌዎታ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 18:1"/>ሉቦትን ወር ሌዎተ ተአን ጄቹንስ ጎስት ሌዊ ሁንድ እስራኤል ወጅን ቆደ ለፋ ዮካን ዻለ ህንአርገተን። እሳን ኣርሳ እብዳን <char style="nd">ዋቀዮፍ</char> ዽኣቱራ ሃኛተን፤ ኩን ቆደሳኒቲ። <verse eid="DEU 18:1"/><verse number="2" style="v" sid="DEU 18:2"/>እሳን ኦቦሎተሳኒ ግዱት ዻለ ቶኮዩ ህንቀባትን፤ አኩመ እን እሳን አብደቺሴት <char style="nd">ዋቀዮ</char> ዻለሳኒቲ።<verse eid="DEU 18:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="DEU 18:3"/>ቆድን ሉቦትን ሰበ ኣርሳ ኮርማ ዮካን ሆላ ዽኤሱራ አርገቹ መለን ፎን ሀርካ፣ ከን መንጋጋቲፊ ምአ ገራት። <verse eid="DEU 18:3"/><verse number="4" style="v" sid="DEU 18:4"/>መታ ምዻንኬቲ፣ ዳዺ ወይኒ ሃራፊ ዘይቲኬ ከን ጀልቀባ አከሱመስ ሱፊ ጀልቀባ ከን ሆላኬራ ሃዱሳኒ ኬኑ ቀብደ፤ <verse eid="DEU 18:4"/><verse number="5" style="v" sid="DEU 18:5"/>ኩንስ ሰበቢ <char style="nd">ዋቀዮ</char> ዋቅንኬ አከ እሳን ዬሮ ሁንደ ዻበተኒ መቃ <char style="nd">ዋቀዮቲን</char> ተጃጅለኒፍ ጎሶተኬ ሁንደ ኬሳ ሰኚሳኒ ፍለቴፍ።<verse eid="DEU 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 18:6"/>ሌውች ቶኮ ዮ መጋላወንኬ ከኔን ጉቱማ እስራኤል ኬሰት አርገመን ከምዩ ኬሳ እዶ ጅራቱ በኤ ገራ ጉቱዻን እዶ <char style="nd">ዋቀዮ</char> ዋቅን ፍለቱ ዹፌ፣ <verse eid="DEU 18:6"/><verse number="7" style="v" sid="DEU 18:7"/>እንስ አኩመ ሌዎተ ፉለ <char style="nd">ዋቀዮ</char> ዱረ ዻበተኒ ተጃጅለኒት አችት መቃ <char style="nd">ዋቀዮ</char> ዋቀሳቲን ሃተጃጅሉ። <verse eid="DEU 18:7"/><verse number="8" style="v" sid="DEU 18:8"/>እን ቀቤኘ ማቲሳ ከን ጉርጉረሙራ ማለቀ አርገቱሌ ሌዎተ ምቾተሳ ወጅን ፋይዳ አርገሙ ወል ቅጤ ህርማቹ ቀበ።<verse eid="DEU 18:8"/></para>
  <para style="s1">ሆጂወን ጅብሲሶ</para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 18:9"/>አት ዮሙ ብየ <char style="nd">ዋቀዮ</char> ዋቅንኬ ሲፍ ኬኑት ገልቱት፣ ሆጂ በልፈማ ሰቦትን አች ጅራተን ሆጄተን ሰነ ሆጄቹ ህንበረትን። <verse eid="DEU 18:9"/><verse number="10" style="v" sid="DEU 18:10"/>ነምን እልመሳ ዮካን እንተለሳ እብደት ኣርሳ ጎዹ፣ ነምን ዋ ህሙ ዮካን ፈልፈለ ሆጄቱ፣ ነምን ምልኪ እላሉ፣ ቶልፈቱን፣ <verse eid="DEU 18:10"/><verse number="11" style="v" sid="DEU 18:11"/>ዮካን ጥባርቱን፣ እላልቱን ዮካን ኤኬር ዱብስቱን ዮካን ነምን ነመ ዱኤ ወጅን ዱበቱ ቶኮዩ ግዱኬት ህንአርገምን። <verse eid="DEU 18:11"/><verse number="12" style="v" sid="DEU 18:12"/>ነምን ዋን አከሲ ሆጄቱ ከምዩ ፉለ <char style="nd">ዋቀዮ</char> ዱረት በልፈማዸ፤ ሰበቢ ሆጂ ጅብሲሳ ከናቲፍስ <char style="nd">ዋቀዮ</char> ዋቅን ፉለኬ ዱራ ሰቦተ አርኤ ንባሰ። <verse eid="DEU 18:12"/><verse number="13" style="v" sid="DEU 18:13"/>አት ፉለ <char style="nd">ዋቀዮ</char> ዋቀኬቲ ዱረት ህርእነ መሌ ጅራቹ ቀብደ።<verse eid="DEU 18:13"/></para>
  <para style="s1">ራጂ</para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 18:14"/>ሰቦትን አት ለፈሳኒራ ቡቅፍቱ ወረ ፈልፈለ ሆጄተን ዮካን ወረ እላለኒዸ። ገሩ አከ አት ዋን አከሲ ሆጄቱ <char style="nd">ዋቀዮ</char> ዋቅንኬ ሲፍ ህንኤየመምኔ። <verse eid="DEU 18:14"/><verse number="15" style="v" sid="DEU 18:15"/><char style="nd">ዋቀዮ</char> ዋቅንኬ ኦቦሎተኬ ኬሳ ራጂ አከኮቲ ቶኮ ሲፍ ካሰ። አትስ እሰ ዸገኡ ቀብደ። <verse eid="DEU 18:15"/><verse number="16" style="v" sid="DEU 18:16"/>ወን አት ጋፈ ወልዳን ኮሬብት ወልት ቀበሜ፣ “አን አከ ህንዱኔፍ ለመተ ሰገሌ <char style="nd">ዋቀዮ</char> ዋቀኮቲ ህንዸገኡ ዮካን እብደ ጉዳ ከነ ስአች ህንአርጉ” ጄቴ <char style="nd">ዋቀዮን</char> ዋቀኬ ከዸቴ ከናቲ።<verse eid="DEU 18:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 18:17"/>
    <char style="nd">ዋቀዮ</char> አከነ ናን ጄዼ፦ “ወን እሳን ጄዸን ጋሪዸ። <verse eid="DEU 18:17"/><verse number="18" style="v" sid="DEU 18:18"/>አን ራጂ አከኬቲ ኦቦሎተሳኒ ግዱዻ እሳኒፍ ነንካሰ፤ ዱቢኮ አፋንሳ ኬሰ ነንካአ፤ እንስ ዋን አን እሰ አጀጁ ሁንደ እሳንት ህመ። <verse eid="DEU 18:18"/><verse number="19" style="v" sid="DEU 18:19"/>ነመ ዱቢኮ ከን ራጂን መቃኮቲን ዱበቱ ዸገኡ ድዱ ከምዩ፣ አን መታንኮ እሰ ነንጋፈዸ። <verse eid="DEU 18:19"/><verse number="20" style="v" sid="DEU 18:20"/>ገሩ ራጂን ዋን መቃኮቲን ዱበቱ ፈኬሴ ዋን አን አከ እን ዱበቱ እሰ ህንአጀጅን ከምዩ ዱበቱ ዮካን ከን መቃ ዋቆተ ብራቲን ዱበቱ ሃአጄፈሙ።”<verse eid="DEU 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 18:21"/>አት ገራኬት፣ “ኑ ዱቢ <char style="nd">ዋቀዮ</char> ኑት ህንዱበትን አከምት ቤኩ ደንዴኘ?” ጄተ ተአ። <verse eid="DEU 18:21"/><verse number="22" style="v" sid="DEU 18:22"/>ዮ ወን ራጂን ቶኮ መቃ <char style="nd">ዋቀዮቲን</char> ዱበቴ ኡቱ ህንጉተምን ሀፌ፣ ዱቢን ሱን ዱቢ <char style="nd">ዋቀዮ</char> ህንዱበትኒዸ። ራጂን ሱን እት ፈኬሴ ዱበቴራቲ እሰ ህንሶዳትን።<verse eid="DEU 18:22"/></para>
  <chapter eid="DEU 18"/>
  <chapter number="19" style="c" sid="DEU 19"/>
  <para style="s1">መጋላወን እት በቀተን</para>
  <para style="r">
    <ref loc="DEU 19:1-14">19፥1‑14</ref> ኩወእ – <char style="xt"><ref loc="NUM 35:6-34">ለኮ 35፥6‑34</ref>፤ <ref loc="DEU 4:41-43">ኬዴ 4፥41‑43</ref>፤ <ref loc="JOS 20:1-9">እያ 20፥1‑9</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 19:1"/>ዮሙ <char style="nd">ዋቀዮ</char> ዋቅንኬ ሰቦተ ብየሳኒ ሲፍ ኬኑ በሌሱት፣ ዮሙ አት አሪቴ እሳን ባፍቴ መጋላወኒፊ መኔንሳኒ ኬሰ ቁበቱት፣ <verse eid="DEU 19:1"/><verse number="2" style="v" sid="DEU 19:2"/>ወለካ ብየ <char style="nd">ዋቀዮ</char> ዋቅንኬ አከ አት ዻልቱፍ ሲፍ ኬኑት ኦፊኬቲፍ መጋላወን ሰዲ አዳን ባፈዹ። <verse eid="DEU 19:2"/><verse number="3" style="v" sid="DEU 19:3"/>አከ ነምን ነመ አጄሴ ከምዩ እት በቀቱፍ ዳንዲወን ሆጄዹቲ ብየ <char style="nd">ዋቀዮ</char> ዋቅንኬ አከ ዻላት ሲፍ ኬኑ እዶ ሰዲት ቆድ።<verse eid="DEU 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="DEU 19:4"/>ሴር ዋኤ ነመ ነመ አጄሴ ሉቡሳ ባፈቹፍ አችት በቀቱ ጄቹንስ ከን ኡቱ ሀምነ እት ህንያድን አከ ተሳ ነመ ኦላሳ አጄሱ ቶኮ እላሉ ከናዸ። <verse eid="DEU 19:4"/><verse number="5" style="v" sid="DEU 19:5"/>ነምን ቶኮ ዮ ሙከ ሙረቹፍ ነምቸ ኦላሳ ወጅን ቦሶነ ሴኔ ኡቱ ሙከ ሙሩፍ ቆቶሳ ኦል ፉዸቱ አኩመ ተሳ ስቢል እራ ቡቀኤ ነምቸ ኦላሳ ሰነ ዸኤ አጄሴ፣ ነምን ሱን መጋላወን ከኔን ኬሳ እሰ ቶኮት በቀቴ ሉቡ ኦፊሳ ኦልፈቹ ደንደአ። <verse eid="DEU 19:5"/><verse number="6" style="v" sid="DEU 19:6"/>ዮ ከና አቺ ነምን ሃሎ ዺጋ ባሱ ቶኮ ዋን ነምች ነመ አጄሴ ሱን ኡቱ ዱራን ዱርሴ ሀምነ እት ህንያድን ኦላሳ አጄሴፍ ዮ አጄፈሙ ህንቀባትንሌ ፈጎ ተኡዩ እን ኣሪዻን ዱካ ቡኤ ቀቀቤ እሰ አጄሱ ደንደአ። <verse eid="DEU 19:6"/><verse number="7" style="v" sid="DEU 19:7"/>ሰበቢን አን አከ አት መጋላ ሰዲ ኦፊኬቲፍ አዳን ባፈቱ ስ አጀጄፍስ ከኑመ።<verse eid="DEU 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 19:8"/>ዮ <char style="nd">ዋቀዮ</char> ዋቅንኬ አኩመ አቦቲኬቲፍ ከኩዻን ዋዳ ገሌ ሰነት ብየኬ ሲፍ በልእሴ ብየ ዋዳ እሳኒፍ ገሌ ሰነ ጉቱማት ሲፍ ኬኔ፣ <verse eid="DEU 19:8"/><verse number="9" style="v" sid="DEU 19:9"/>አት <char style="nd">ዋቀዮን</char> ዋቀኬ አከ ጃለቹፊ ዬሮ ሁንደ ከራሳረ አከ ዴምቱፍ አጀጀወን አን ሀርአ ሲፍ ኬኑ ሁንደ አከ ጋሪት ዮ ኤግዴ፣ መጋላወን ከኔንረት መጋላወን ሰዲ ንደበለተ። <verse eid="DEU 19:9"/><verse number="10" style="v" sid="DEU 19:10"/>አከ ለፈኬ ከን <char style="nd">ዋቀዮ</char> ዋቅንኬ ዻለ ጎዼ ሲፍ ኬኑ ኬሰት ዺግን ነመ ቁልቁሉ ህንዸንገላኔፊ አትስ የከ ዺገ ዸንገላሱት አከ ህንጋፈተምኔፍ ዋን ከነ ጎዽ።<verse eid="DEU 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 19:11"/>ገሩ ዮ ነምን ቶኮ ነመ ኦላሳ ጅቤ ርጴ ኤገቹዻን ሚዻ እራን ገኤ እሰ አጄሴ ኤርገሲሞ መጋላወን ከኔን ኬሳ ቶኮት በቀቴ፣ <verse eid="DEU 19:11"/><verse number="12" style="v" sid="DEU 19:12"/>ማንጉዶትን መጋላ እን ኬሰ ጅራቻ ቱሬ ነመ እት ኤርገኒ መጋላ እን እት በቀቴ ሰና እሰ ሃፍችሲሰን፤ አከ እን አጄሱፍስ ነመ ሃሎ ዺጋ በኡት ደበርሰኒ እሰ ሃኬነን። <verse eid="DEU 19:12"/><verse number="13" style="v" sid="DEU 19:13"/>ገራ ህንላፍኒፍ፤ አከ ሲፍ ቶሉፍ የከ ዸንገላፈመ ዺገ ነመ ቁልቁሉ እስራኤል ኬሳ በሌስ።<verse eid="DEU 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 19:14"/>ብየ <char style="nd">ዋቀዮ</char> ዋቅንኬ አከ ዻልቱፍ ሲፍ ኬኑ ኬሰት ዻለ ደበርፈሜ ሲፍ ኬነሙረት ዸጋ መለቶ ዳንጋ ኦላኬቲ ከን ነሞትን ዱሪ ዻበን ህንሂቅስን።<verse eid="DEU 19:14"/></para>
  <para style="s1">ዹገ ባቶተ</para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 19:15"/>ነመ የከ ዮካን ሴረ ጨብሱ ከሚንዩ ህመተሜ ቶኮት ሙሩፍ ዹገ በኡምስ ነመ ቶኮ ገኣ ምት። ዱቢን ሱን ዹገ ባቶተ ለማን ዮካን ሰዲን ምርከኔፈሙ ቀበ።<verse eid="DEU 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 19:16"/>ዮ ዹገ ባቱን ጀልኣን ቶኮ ሶባን ነመ ቶኮት ዹጋ በኤ፣ <verse eid="DEU 19:16"/><verse number="17" style="v" sid="DEU 19:17"/>ነሞትን ወል ዸበን ለማን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ሉቦታፊ አቦቲ ሙርቲ ከኔን ዬሮ ሰነት ሆጂረ ጅረን ዱረ ሃዻበተን። <verse eid="DEU 19:17"/><verse number="18" style="v" sid="DEU 19:18"/>አቦቲን ሙርቲስ ዱብቸ ገድ ፈጌሰኒ ሃቆረን፤ ዮ ዹገ ባቱን ሱን ሶብዱ ተኡንሳ ምርከናኤ ኦቦሌሰሳረት ሶባን ዹጋ በኤ፣ <verse eid="DEU 19:18"/><verse number="19" style="v" sid="DEU 19:19"/>ዋኑመ እን ኦቦሌሰሳ ጎቹ ያዴ ሰነ እሰ ጎዻ። አት ሀማ ኦፍ ኬሳ ባሱ ቀብደ። <verse eid="DEU 19:19"/><verse number="20" style="v" sid="DEU 19:20"/>ነሞትን ሀፈን ዋን ከነ ዸገአኒ ንሶዳቱ፤ ወን ሀማን አከሲስ ለመተ ግዱኬት ህንሆጄተሙ። <verse eid="DEU 19:20"/><verse number="21" style="v" sid="DEU 19:21"/>አት ገረ ላፍነ ቶኮዩ ህንአርግሲስን፤ ቆደ ሉቡ ሉቡን፣ ቆደ እጃ እጅ፣ ቆደ እልካኒ እልካን፣ ቆደ ሀርካ ሀርክ፣ ቆደ ሚላስ ሚል ባፈሙ ቀበ።<verse eid="DEU 19:21"/></para>
  <chapter eid="DEU 19"/>
  <chapter number="20" style="c" sid="DEU 20"/>
  <para style="s1">ወራናፍ በኡ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 20:1"/>ሰበቢ <char style="nd">ዋቀዮ</char> ዋቅንኬ እን ብየ ግብጢቲ ስ ባሴ ሱን ስ ወጅን ጅሩፍ ዮሙ ዲኖተኬ ሎሉፍ ባቱት ፈርዴኒፊ ጋሪወን አከሱመስ ሁምነ ወራና ከን ሁምነ ወራናኬ ጫሉ አርግቱት ህንሶዳትን። <verse eid="DEU 20:1"/><verse number="2" style="v" sid="DEU 20:2"/>ዮሙ አት ወራነት ዽኣቱት ሉብን ፉለ ዱረት በኤ ሎልቶተት ሃዱበቱ። <verse eid="DEU 20:2"/><verse number="3" style="v" sid="DEU 20:3"/>እንስ አከነ ሃጄዹ፤ “ያ እስራኤል፣ እስን ሀርአ ዲኖተኬሰን ሎሉፍ ወራነት ሴኑፍ ጅርቱ። ገራንኬሰን ህንራፈምን ዮካን ህንሶዳትና፤ ህንነእና ዮካን ፉለ ዲኖተኬሰኒ ዱረት ህንሆለትና። <verse eid="DEU 20:3"/><verse number="4" style="v" sid="DEU 20:4"/>ከን ሞአትና እስኒፍ ኬኑፍ ጄዼ ዲኖተኬሰን እስኒፍ ሎሉፍ እስን ወጅን በኡ <char style="nd">ዋቀዮ</char> ዋቀኬሰኒቲ።”<verse eid="DEU 20:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 20:5"/>አጀጆትን ሎልቶታሞ ሎልቶታን አከነ ሃጄዸን፦ “ነምን መነ ሃራ እጃሬ ህንኤብሲስን ቶኮዩ ጅራ? እን ገረ መነሳት ሃዴብኡ፤ ዮ ከና አቺ እን ወራነረት ዱኤ ነምን ብራ መነሳ ኤብሰ። <verse eid="DEU 20:5"/><verse number="6" style="v" sid="DEU 20:6"/>ነምን ወይኒ ዻቤራ ህንኛትን ጅራ? እን ገረ መነሳ ሃዴሙ፤ ዮ ከና አቺ እን ሎለ ኬሰት ዱኤ ነምን ብራ ወይኒ ሰነ ኛተ። <verse eid="DEU 20:6"/><verse number="7" style="v" sid="DEU 20:7"/>ነምን ኒቲ ፉዹፍ ከዸቴ ኡቱ ህንፉዽን ዹፌ ጅራ? እን ገረ መነሳ ሃዴሙ፤ ዮ ከና አቺ እን ሎለረት ዱኤ ነምን ብራ እሼ ፉዸ።” <verse eid="DEU 20:7"/><verse number="8" style="v" sid="DEU 20:8"/>አጀጆትን ሎልቶታ አመስ፣ “ነምን ሶዳቱ ዮካን ከን ገራንሳ ራፈሙ ጅራ? አከ ገራን ኦቦሎተሳስ ህንራፈምኔፍ እን ገረ መነሳት ሃዴብኡ” ሃጄዸን። <verse eid="DEU 20:8"/><verse number="9" style="v" sid="DEU 20:9"/>አጀጆትን ዮሙ ሎልቶተት ዱበተኒ ራወተንት ሎልቶተረት አጀጆተ ሃሙደን።<verse eid="DEU 20:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 20:10"/>አት ዮሙ መጋላ ቶኮ ዸኡፍ ባቱት፣ ዱራን ዱርሲ ነሞተ መጋላ ሰነ ኬሰ ጅራተኒፍ ዋምቸ ነጋ ጎዽ። <verse eid="DEU 20:10"/><verse number="11" style="v" sid="DEU 20:11"/>ዮ እሳን ቶሌ ጄዸኒ በልበለ ሲፍ በነን፣ ነምን ሁንድ ሲፍ ሃቡሉ፤ ሆጄታኬስ ሃተኡ። <verse eid="DEU 20:11"/><verse number="12" style="v" sid="DEU 20:12"/>ዮ እሳን ዋምቸ ነጋ ፉዸቹ ድደኒ ወራናፍ ስት በአን አት መጋለቲ መርስ። <verse eid="DEU 20:12"/><verse number="13" style="v" sid="DEU 20:13"/>ዮሙ <char style="nd">ዋቀዮ</char> ዋቅንኬ ደበርሴ እሳን ስት ኬኑት ዺሮተ መጋለቲ ኬሰ ጅራተን ሁንደ ጎራዴዻን ፍጥ። <verse eid="DEU 20:13"/><verse number="14" style="v" sid="DEU 20:14"/>ገሩ ነዼኒፊ እጆሌ፣ ሆሪፊ ዋን መጋለቲ ኬሰት አርገሙ ሁንደ ቦጅኢቲ ኦፊኬቲ ፉዸዹ፤ አት ቦጁ <char style="nd">ዋቀዮ</char> ዋቅንኬ ዲኖተኬረት ሲፍ ኬኔት ፈየደሙ ንደንዴሰ። <verse eid="DEU 20:14"/><verse number="15" style="v" sid="DEU 20:15"/>አክ አት መጋላወን ሰቦተ ናኖኬቲ ህንተእን ከኔን አከ መሌ ፈጎ ተአን ጎቱስ ከኑመ።<verse eid="DEU 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 20:16"/>ተኡስ መጋላወን ሰቦተ <char style="nd">ዋቀዮ</char> ዋቅንኬ አከ ዻላት ሲፍ ኬኑ ኬሰት ዋን ሀፉረ ባፈቱ ቶኮሌ ህንሀምብስን። <verse eid="DEU 20:16"/><verse number="17" style="v" sid="DEU 20:17"/>አኩመ <char style="nd">ዋቀዮ</char> ዋቅንኬ ስ አጀጄት ጉቱማን ጉቱት እሳን በርበዴስ፤ እሳንስ ሄቶተ፣ አሞሮተ፣ ከነኣኖተ፣ ፌርዞተ፣ ሂዎታፊ ዬቡሶተ። <verse eid="DEU 20:17"/><verse number="18" style="v" sid="DEU 20:18"/>ዮ ከና አቺ አከ አት ዋን ጅብሲሳ እሳን ዋቆተሳኒ ዋቄፈቹዻን ሆጄተን ሰነ ዱካ ቡቱ ስ በርሲሱ፤ አትስ <char style="nd">ዋቀዮ</char> ዋቀኬት ጩቡ ሆጄተ።<verse eid="DEU 20:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 20:19"/>አት ዮሙ ዬሮ ዼራዻፍ መጋላ ሰነ መርስቴ ቀበቹዻፍ እሼ ወራንቱት፣ ሙኬንሼ ቆቶዻን ጭርቴ ህንበሌስን፤ አት ምዻንሳኒ ኛቹ ደንዴሳቲ እሳን ህንጭርን። አት ከን እሳን መርስቱ ሙኬን ቦሶና ነሞተ ተአኒቲ? <verse eid="DEU 20:19"/><verse number="20" style="v" sid="DEU 20:20"/>ገሩ ሀመ መጋላን ስ ወጅን ወል ሎልቱ ሱን ኩፍቱት ሙኬን አከ እሳን ጉማ ህንነቀትኔ ቤክቱ ሙርቴ ሆጂ እጃርሰ መርሱቲፍ እት ፈየደሙ ንደንዴሰ።<verse eid="DEU 20:20"/></para>
  <chapter eid="DEU 20"/>
  <chapter number="21" style="c" sid="DEU 21"/>
  <para style="s1">ኣርሳ አጄቻ ህንቤከምኔፍ ዽኤፈሙ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 21:1"/>ዮ ነምን ቶኮ ብየ <char style="nd">ዋቀዮ</char> ዋቅንኬ አከ ዻልቱፍ ሲፍ ኬኑ ኬሰት ዱኤ አርገሜ ነምን እሰ አጄሴ ህንቤከምን፣ <verse eid="DEU 21:1"/><verse number="2" style="v" sid="DEU 21:2"/>ማንጉዶትንኬቲፊ አቦቲን ሙርቲኬ ዸቀኒ ፈጌኘ እዶ እን እት ዱኤፊ መጋላወን እት ዽኣተን ግዱ ጅሩ ሃሰፈረን። <verse eid="DEU 21:2"/><verse number="3" style="v" sid="DEU 21:3"/>ኤርገሲስ ማንጉዶትን መጋላ ሬፍቸት ኣንቱ ኬሰ ጅራተን ጎሮምሰ ተኩማ ህንሆጄትን ከን ዋንጆ ህንባትን ፉዸኒ <verse eid="DEU 21:3"/><verse number="4" style="v" sid="DEU 21:4"/>ጎሮምሰ ሰነ ገረ ሱሉለ ህንቆተምን ዮካን ወን ቶኮዩ እረ ህንፈጫፈምን ከን ብሻን ያኡ ቀቡት ሃጌሰን። ሱሉለ ሰነ ኬሰትስ ሞርመ ጎሮምሰ ሰና ሃጨብሰን። <verse eid="DEU 21:4"/><verse number="5" style="v" sid="DEU 21:5"/>ሉቦትን ጄቹንስ እልማን ሌዊ ሰበቢ አከ ተጃጅለኒፊ አከ መቃ <char style="nd">ዋቀዮቲን</char> ኤብሰኒፍ፣ አከ ዱቢ ወል ዸቢሳቲፊ ሚዻ ዸግና ከምረትዩ ሙርቲ ኬነኒፍ <char style="nd">ዋቀዮ</char> ዋቀኬቲን ፍለተመኒፍ እሳን ፉልዱራት ሃዽኣተን። <verse eid="DEU 21:5"/><verse number="6" style="v" sid="DEU 21:6"/>ኤርገሲ ማንጉዶትን መጋላ ሬፍቸት ባይኤ ዽኣቱ ሁንድ ጎሮምሰ ሱሉለ ኬሰት ሞርም ጨብሰሜ ሰነረት ሀርከሳኒ ሃዽቀተን። <verse eid="DEU 21:6"/><verse number="7" style="v" sid="DEU 21:7"/>እሳንስ አከነ ሃጄዸን፦ “ሀርክኬኘ ዺገ ከነ ህንዸንገላፍኔ ዮካን ዮሙ ወን ኩን ሆጄተሜ እጅኬኘ ህንአርግኔ። <verse eid="DEU 21:7"/><verse number="8" style="v" sid="DEU 21:8"/>ያ <char style="nd">ዋቀዮ</char>፣ ኣርሳ አራራ ከነ ሰበኬ እስራኤል ከን ፉርቴ ሰናፍ ፉዸዹ፤ ዺገ ነመ ቁልቁሉ ከናስ ሰበኬት ህንሄሬግን። የኪ ዺገ ዸንገላፈሜስ እሳኒ ሃዺፈሙ። <verse eid="DEU 21:8"/><verse number="9" style="v" sid="DEU 21:9"/>አትስ ሰበቢ ዋን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ቀጄላ ተኤ ሆጄቴፍ የከ ዸንገላፈሙ ዺገ ነመ ቀጄላ አከሲን ግዱኬቲ ንበሌስተ።”<verse eid="DEU 21:9"/></para>
  <para style="s1">ዱበርቲ ቦጅአምቴ ፉዹ</para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 21:10"/>አት ዮሙ ዲኖተኬ ሎሉፍ ዱልቴ <char style="nd">ዋቀዮ</char> ዋቅንኬ ደበርሴ ሀርከኬት እሳን ሲፍ ኬኔ ቦጁ ፉዸቱት፣ <verse eid="DEU 21:10"/><verse number="11" style="v" sid="DEU 21:11"/>ዮ ወረ ቦጅአመን ኬሰት ዱበርቲ በሬዱ ቶኮ አርግቴ እሼ ጃለቴ ኒቲ ኦፊኬቲ ጎዸቴ እሼ ፉዹ ደንዴሰ። <verse eid="DEU 21:11"/><verse number="12" style="v" sid="DEU 21:12"/>መነኬት እሼ ገልች፤ እሼንስ መታሼ ሃሃደቱ፤ ቄንሰሼስ ሃቆረቱ፤ <verse eid="DEU 21:12"/><verse number="13" style="v" sid="DEU 21:13"/>ኡፈተ እሼን ዬሮ ቦጅአምቴት ኡፈቻ ቱርቴስ እራ ባስ። ኤርገ እሼን መነኬ ኬሰ ጅራቴ ጅአ ቶኮ ጉቱ አባፊ ሃዸ እሼቲፍ ቦሴ ቦዴ አት እሼ ወጅን ጪፍቴ ዽርሰሼ ተኡ ደንዴሰ፤ እሼንስ ኒቲኬ ንታት። <verse eid="DEU 21:13"/><verse number="14" style="v" sid="DEU 21:14"/>አት ዮ እሼት ገመዱ ባቴ አከ እሼን ገረ ፌቴ ዴምቱ ገድ ዺስ። አት ዋን እሼ ሰልጵፍቴፍ እሼ ጉርጉሩ ዮካን አከ ገርብቲት እሼ እላሉ ህንቀብዱ።<verse eid="DEU 21:14"/></para>
  <para style="s1">ምርገ ሀንገፋ</para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 21:15"/>ነምን ቶኮ ዮ ኒቶተ ለመ ቀባቴ እሼ ቶኮ ጃለቴ ገሩ ለማንሳኒዩ እልማን ደአኒፍ፣ ዮ እልም ሀንገፍን ኒቲ እን ህንጃለትኔ ሰነራ ዸለቴ፣ <verse eid="DEU 21:15"/><verse number="16" style="v" sid="DEU 21:16"/>ነምች ዮሙ ቀቤኘሳ እልማንሳቲፍ ቆዱት ምርገ ሀንገፉማ እልመ ኒቲ ጅቤ ሰና እልመ ኒቲ ጃለቱቲፍ ደበርሴ ኬኑ ህንቀቡ። <verse eid="DEU 21:16"/><verse number="17" style="v" sid="DEU 21:17"/>ገሩ እልመ ሀንገፍትቸ ኒቲ ህንጃለትኔ ሰነራ ዸልቼፍ ቆደ ዻለሳ ኬሳ ሀርከ ለመ ኬኑፊዻን እሰ ቤክስሱ ቀበ። እልም ሱን መለቶ ጀልቀባ ከን ጀብነ አባሳት። ምርግ ሀንገፉማ ከንሳት።<verse eid="DEU 21:17"/></para>
  <para style="s1">እልመ ህንአጀጀምኔ</para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 21:18"/>ነምን ቶኮ ዮ እልመ መተ ጀቤሳፊ ፍንጭላ አባፊ ሃዸሳቲፍ ህንአጀጀምኔፊ ከን ዮሙ እሰ አደበን ህንዸጌኜ ቀባቴ፣ <verse eid="DEU 21:18"/><verse number="19" style="v" sid="DEU 21:19"/>አባፊ ሃትሳ ቀበኒ በልበለ መጋላሳ ዱረት ማንጉዶተት እሰ ሃፍደን። <verse eid="DEU 21:19"/><verse number="20" style="v" sid="DEU 21:20"/>እሳንስ፣ “ጉርባንኬኘ ኩን መተ ጀቤሳፊ ፍንጭላዸ፤ ኑፍ ህንአጀጀሙ፤ እን አልባዼሳፊ መቾፍቱዸ” ጄዸኒ ማንጉዶተት ሃህመን። <verse eid="DEU 21:20"/><verse number="21" style="v" sid="DEU 21:21"/>ኤርገሲስ ነሞትን መጋላሳ ሁንድ ዸጋዻን ቱመኒ እሰ አጄሱ። አት ሀማ ኦፍ ግዱዻ ባሱ ቀብደ። እስራኤሎን ሁንድ ዋን ከነ ዸገአኒ ንሶዳቱ።<verse eid="DEU 21:21"/></para>
  <para style="s1">ሴረወን ገራ ገራ</para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 21:22"/>ዮ ነምን ቶኮ ጩቡ አደቢ ዱአ እሰት ሙርሲሱ ሆጄቴ አጄፈሜ ሬፍሳ ሙከት ፈንፈሜ፣ <verse eid="DEU 21:22"/><verse number="23" style="v" sid="DEU 21:23"/>አት ሬፈሳ ሙከረ ቡልቹ ህንቀብዱ። ዋን ነምን ሙከረት ፈንፈሙ አባርሰ ዋቃ ጀለ ጅሩፍ እሰ ጋፉመ ሰነ አዋል። አት ብየ <char style="nd">ዋቀዮ</char> ዋቅንኬ አከ ዻላት ሲፍ ኬኑ ህንጡሬስን።<verse eid="DEU 21:23"/></para>
  <chapter eid="DEU 21"/>
  <chapter number="22" style="c" sid="DEU 22"/>
  <para style="p">
    <verse number="1" style="v" sid="DEU 22:1"/>ኡቱ ሰንጋን ዮካን ሆላን ኦቦሌሰኬቲ በዳ ጅሩ ዮ አርግቴ፣ ዴብሲቲ እሰት ፍድ መሌ ጨልእፍቴ ብረ ህንደርብን። <verse eid="DEU 22:1"/><verse number="2" style="v" sid="DEU 22:2"/>ዮ ኦቦሌስ ሱን ስራ ፈጎ ጅራቴ ዮካን ዮ እሰ ቤኩ ባቴ ሰንጋ ዮካን ሆላ ሰነ ፉዺ ገሊቲ ሀመ እን በርባቸ ዹፉት ኦፍ ብረ ቱርስ። ኤርገሲ ዴብሲ እሳፍ ኬን። <verse eid="DEU 22:2"/><verse number="3" style="v" sid="DEU 22:3"/>ዮ ሀሬን ዮካን ወያን ዮካን ወን ፌዼዩ ኦቦሌሰኬ ጀላ በዴ አርግቴ አከሱመ ጎዽ መሌ ዺፍቴ ብረ ህንደርብን።<verse eid="DEU 22:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="DEU 22:4"/>ዮ ሀሬን ዮካን ሰንጋን ኦቦሌሰኬቲ ከራረት ኩፌ አርግቴ አከ እን ኦል ካሴ ሚለሳቲን ዻቡ ገርጋር መሌ ብረ ህንደርብን።<verse eid="DEU 22:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 22:5"/>ዱበርቲን ኡፈተ ዺራ ኡፈቹ ህንቀብዱ ዮካን ዺር ኡፈተ ዱበርቲ ኡፈቹ ህንቀቡ፤ <char style="nd">ዋቀዮ</char> ዋቅንኬ ነመ ዋን አከሲ ሆጄቱ ከምዩ ንጅባቲ።<verse eid="DEU 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 22:6"/>አት ዮ መነ ስምብራ ከን ሙከረ ዮካን ለፈ ጅሩ ኡቱ ሃት ጩጪሼ ዮካን አንቃቁሼ ሀመቴ ጅርቱ ከራ ጭነት አርግቴ ሃዸ ሰነ ጩጪሼ ወጅን ህንፉዸትን፤ <verse eid="DEU 22:6"/><verse number="7" style="v" sid="DEU 22:7"/>አት ጩጪሼ ፉዸቹ ንደንዴሰ፤ ገሩ አከ ሲፍ ቶሌ በረ ዼራ ጅራቱፍ አከ ሃዸ ገድ ዺፍቴ ምርከኔፈዹ።<verse eid="DEU 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 22:8"/>ዮሙ መነ ሃራ እጃርቱት አከ ነምን በንቲ መናራ ኩፌ መነኬት የከ ዸንገለኡ ዺጋ ህንፍድኔፍ ቀርቀረ በንቲሳት እትሰ ቶልች።<verse eid="DEU 22:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 22:9"/>እዶ ዻባ ወይኒኬቲ ኬሰ ሰኚ ጎሰ ለማ ህንፈጫስን፤ ዮ አት አከስ ጎቴ ሰኚ አት ፈጫፍቴ ሰነ ቆፈ ኡቱ ህንተእን እጅ እዶ ዻባ ወይኒኬቲስ ንበደ።<verse eid="DEU 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 22:10"/>ቆትዮፊ ሀሬ ወልት ጨመዴ እቲን ህንቆትን።<verse eid="DEU 22:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 22:11"/>ኡፈተ ሱፊፊ ቁንጬ ተልባ ከን ወልት ፎአሜ ዸአሜ ህንኡፈትን።<verse eid="DEU 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 22:12"/>ሮገ ወያ ኡፈቱ አፍረንረት ሀንዳረ ቶልች።<verse eid="DEU 22:12"/></para>
  <para style="s1">ረክነ ጋኤለ ኬሰት ኡመሙ</para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 22:13"/>ዮ ነምን ቶኮ ኒቲ ፉዼ ኤርገ እሼ ወጅን ጪሴ ቦዴ እሼ ጅቤ፣ <verse eid="DEU 22:13"/><verse number="14" style="v" sid="DEU 22:14"/>እሼስ ቃኔሴ መቃ በሌሱዻን፣ “አን ኒቲ ተነ ፉዼረ፤ ገሩ ዮሙ አን እሼ ወጅን ጪሴት ዋን ዱርቡማሼ ምርከኔሱ ህንአርገኔ” ጄዼ፣ <verse eid="DEU 22:14"/><verse number="15" style="v" sid="DEU 22:15"/>አባፊ ሃት እንተለቲ ረጋ ዱርቡማሼ ምርከኔሱ በልበለረት ማንጉዶተ መጋለቲት ሃዽኤሰን። <verse eid="DEU 22:15"/><verse number="16" style="v" sid="DEU 22:16"/>አባን እንተለቲስ ማንጉዶታን አከነ ሃጄዹ፤ “አን እንተለኮ ነመ ከነት ሄሩምሲሴረ፤ እን ገሩ እሼ ጅቤ። <verse eid="DEU 22:16"/><verse number="17" style="v" sid="DEU 22:17"/>መቃሼስ በሌሴ፣ ‘አን እንተለኬ ዱርቡማ እሼቲን ህንአርገኔ’ ጄዼ። ገሩ ረጋን ዱርቡማ እንተለኮቲ ምርከኔሱ ኩኖት።” ከነረት አባፊ ሃትሼ ፉለ ማንጉዶተ መጋለቲ ዱረት ወያ ሰነ ሃድሪርሰን፤ <verse eid="DEU 22:17"/><verse number="18" style="v" sid="DEU 22:18"/>ማንጉዶትን ሱንስ ነምቸ ሰነ ቀበኒ ሃአደበን። <verse eid="DEU 22:18"/><verse number="19" style="v" sid="DEU 22:19"/>እሳንስ ሰበቢ ነምች ኩን መቃ ዱርበ እስራኤል ቶኮ ጡሬሴፍ ሜቲ ሰቅሊ ዽበ ቶኮ ባስሰኒ አባ እንተለቲቲፍ ሃኬነን፤ እሼን ኒቲሳ ታቴ ሃጅራቱ፤ እንስ ሀመ ሉቡዻን ጅሩት እሼ ሂኩ ህንደንደኡ።<verse eid="DEU 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 22:20"/>ተኡስ ዮ ህመናን ዽኣቴ ሱን ዹጋ ተኤ ረጋን ዱርቡማ እንተለቲ ምርከኔሱ ህንአርገምን፣ <verse eid="DEU 22:20"/><verse number="21" style="v" sid="DEU 22:21"/>እሼን በልበለ መነ አባሼ ዱረት ፍደምቴ ነሞትን መጋላሼ ሀመ እሼን ዱቱት ዸጋዻን እሼ ሃቱመን፤ እሼን ኡቱመ መነ አባሼ ጅርቱ ሰጋገሉዻን ጎቸ እስራኤል ኬሰት ቃኒ ተኤ ሆጄቴርት። አት ግዱኬቲ ዋን ሀማ ባሱ ቀብደ።<verse eid="DEU 22:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 22:22"/>ዮ ነምን ቶኮ ኡቱ ኒቲ ነመ ብራ ወጅን ጪሱ አርገሜ ለማንሳኒዩ፣ ነምች እሼ ወጅን ጪሴፊ ዱበርቲን ሱን አጄፈሙ ቀቡ። አት እስራኤል ኬሳ ዋን ሀማ ባሱ ቀብደ።<verse eid="DEU 22:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 22:23"/>ዮ ነምን ቶኮ ዱርበ ካዽመምቴ መጋላት አርጌ እሼ ወጅን ጪሴ፣ <verse eid="DEU 22:23"/><verse number="24" style="v" sid="DEU 22:24"/>ዋን እሼን ኡቱ መጋላ ኬሰ ጅርቱ ነ ኦልቻ ጄቴ ህንእይኒፍ፣ ነምችሞ ዋን ኒቲ ነመ ብራ ሰልጵሴፍ፣ ለማንሳኒዩ ገረ በልበለ መጋላት ጌሳቲ ሀመ እሳን ዱአንት ዸጋዻን ቱማ። ዋን ሀማ ግዱኬሰኒ በሌሳ።<verse eid="DEU 22:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DEU 22:25"/>ገሩ ዮ ነምን ቶኮ ዱርበ ከዸተምቴ ቶኮ ባድያት አርጌ እሼ ጉዴዴ፣ ነምች ዋን ከነ ጎዼ ቆፍት ሃአጄፈሙ። <verse eid="DEU 22:25"/><verse number="26" style="v" sid="DEU 22:26"/>እንተለቲ ህንቱቅና፤ እሼን ጩቡ ዱኣን እሼ ገኡ ቶኮዩ ህንሆጄትኔቲ። ዱቢን አከሲ ነመ በላ ቡሴ ነምቸ ኦላሳ አጄሱን ወል ፈካተ፤ <verse eid="DEU 22:26"/><verse number="27" style="v" sid="DEU 22:27"/>ኩንስ ዋን ነምች ዱርበ ካዽመምቴ ሰነ ባድያት አርገቴ ዮ እይቴሌ ነምን እሼፍ ብርመቱ ህንአርገምኔፍ።<verse eid="DEU 22:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="DEU 22:28"/>ነምን ቶኮ ዮ ዱርበ ህንካዽመምን ቶኮ አርጌ ሁምናን እሼ ጉዴዴ ወን ኩን ቤከሜ፣ <verse eid="DEU 22:28"/><verse number="29" style="v" sid="DEU 22:29"/>እን አባሼቲፊ ሜቲ ሰቅሊ ሸንተመ ሃባሱ። እን ዋን ጉዴዴ ዱርቡማሼ በሌሴፍ እሼ ፉዹ ቀበ። ሀመ ሉቡን ጅሩትስ እሼ ሂኩ ህንደንደኡ።<verse eid="DEU 22:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="DEU 22:30"/>ነምን ቶኮ ኒቲ አባሳ ፉዹ ህንቀቡ፤ እን ስሬ አባሳ ህንጡሬስን።<verse eid="DEU 22:30"/></para>
  <chapter eid="DEU 22"/>
  <chapter number="23" style="c" sid="DEU 23"/>
  <para style="s1">ወልዳራ ዾወሙ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 23:1"/>ነምን ኮላፈሜ ዮካን ዸግን ሳለሳራ ሙረሜ ከምዩ ወልዳ <char style="nd">ዋቀዮ</char> ህንሴንን።<verse eid="DEU 23:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="DEU 23:2"/>ነምን ሀራሙዻን ዸለቴ ዮካን ሰኚንሳ ከምዩ ሀመ ዸሎተ ኩርነፋት ወልዳ <char style="nd">ዋቀዮ</char> ህንሴንን።<verse eid="DEU 23:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="DEU 23:3"/>ነምን ጎሰ አሞን ዮካን ጎሰ ሞኣብ ዮካን ሰኚንሳ ከምዩ ሀመ ዸሎተ ኩርነፋት ወልዳ <char style="nd">ዋቀዮ</char> ህንሴንን። <verse eid="DEU 23:3"/><verse number="4" style="v" sid="DEU 23:4"/>እሳን ዬሮ አት ግብጢ ባቴት ከራረት ቡዴናን ዮካን ብሻኒን ስ ህንስመትኔ፤ ቆደ ከና አከ እን ስ አባሩፍ በለኣም እልመ ቤኦር ነምቸ ብየ ጴቶር እሼ ጳዳን አራምት አርገምቱ ሰነ ኬሰ ጅራቱ ስት ብተን። <verse eid="DEU 23:4"/><verse number="5" style="v" sid="DEU 23:5"/>ተኡስ <char style="nd">ዋቀዮ</char> ዋቅንኬ አባርሰ ሰነ ኤበት ሲፍ ጌደሬ መሌ በለኣምን ህንዸጌኜ፤ <char style="nd">ዋቀዮ</char> ዋቅንኬ ስ ጃለታቲ። <verse eid="DEU 23:5"/><verse number="6" style="v" sid="DEU 23:6"/>አት ሀመ ሉቡዻን ጅርቱት አከ እሳን ነጌኛፊ በዻዹማ ቀባተን ህንበርባድን።<verse eid="DEU 23:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 23:7"/>ዋን እን ኦቦሌሰኬ ተኤፍ ነመ ጎሰ ኤዶም ህንቱፈትን። አት ሰበቢ አከ አለጋት ብየሳ ኬሰ ጅራቴፍ ነመ ግብጥ ህንቱፈትን። <verse eid="DEU 23:7"/><verse number="8" style="v" sid="DEU 23:8"/>እጆሌን ዸሎተ ሰደፋ ከኔን እሳኒፍ ዸለተን ወልዳ <char style="nd">ዋቀዮ</char> ሴኑ ንደንደኡ።<verse eid="DEU 23:8"/></para>
  <para style="s1">ቁልቁልነ ቁበታ ኤጉ</para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 23:9"/>ዮሙ ዲኖተኬ ሎሉፍ ባቱት ጡራኡማ ሁንደራ ኦፍ ኤግ። <verse eid="DEU 23:9"/><verse number="10" style="v" sid="DEU 23:10"/>ነምን ቶኮ ዮ ሀልከን አፌታ ዸንገላሱዻን ኦፍ ጡሬሴ እን ቁበተ ኬሳ ገድ በኤ አለ ሃቱሩ። <verse eid="DEU 23:10"/><verse number="11" style="v" sid="DEU 23:11"/>ገረ ገልገላ ገሩ ዽቀቴ ዬሮ አዱን ዺቱት ገረ ቁበታት ሃዴብኡ።<verse eid="DEU 23:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 23:12"/>አት ቁበታን አለት ለፈ እት ገድ ባቱ ቆጴፈዹ። <verse eid="DEU 23:12"/><verse number="13" style="v" sid="DEU 23:13"/>ሜሻኬ ኬሳ ዋን እቲን ለፈ ቆቱ ቀባዹ፤ አት ዮሙ ገድ ቴሴ ካቱት ቦለ ቆቲቲ ብዮ እት ዴብስ። <verse eid="DEU 23:13"/><verse number="14" style="v" sid="DEU 23:14"/><char style="nd">ዋቀዮ</char> ዋቅንኬ ስ ኤጉፊ ዲኖተኬ ደበርሴ ስት ኬኑዻፍ ቁበተኬ ኬሰ ዴዴብኣቲ፤ አከ እን ግዱኬት ዋን ጡራኣ አርጌ ስራ ህንዴብኔፍ ቁበንኬ ቁልቁሉ ተኡ ቀበ።<verse eid="DEU 23:14"/></para>
  <para style="s1">ሴረወን ገራ ገራ</para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 23:15"/>ዮ ገርብች ቶኮ ኮሉ ስት ገሌ፣ አት ደበርስቴ ጎፍታሳት እሰ ህንኬንን። <verse eid="DEU 23:15"/><verse number="16" style="v" sid="DEU 23:16"/>እን ግዱኬ ለፈ ጃለቴፊ መጋላ ፍለቴ ኬሰ ሃጅራቱ። አትስ እሰ ህንጩንቁርስን።<verse eid="DEU 23:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 23:17"/>ዺር ዮካን ዱበርቲን እስራኤል ከምዩ ሰጋገልቱ መነ ዋቀ ቶልፈማ ህንተእን። <verse eid="DEU 23:17"/><verse number="18" style="v" sid="DEU 23:18"/>ዱበርቲ ዮካን ዺረ ሰጋገሉ ቶኮራ አከ ገልቻት ኬና ፉቴ መነ <char style="nd">ዋቀዮ</char> ዋቀኬቲት ህንፍድን፤ ለቸንሳኒዩ ፉለ <char style="nd">ዋቀዮ</char> ዋቀኬቲ ዱረት ጅብሲሶዻቲ።<verse eid="DEU 23:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 23:19"/>አት ማለቀ ዮካን ኛተ ዮካን ዋን ዸለ አርገምሲሱ ከምዩ ዸላን ኦቦሌሰኬቲፍ ህንልቄስን። <verse eid="DEU 23:19"/><verse number="20" style="v" sid="DEU 23:20"/>አት ነመ ኦርማራ ዸለ ጋፈቹ ንደንዴሰ፤ ገሩ አከ <char style="nd">ዋቀዮ</char> ዋቅንኬ ብየ አት ዻሉፍ እት ገልቱት ዋን ሀርክኬ ቱቄ ሁንዳን ስ ኤብሱፍ ኦቦሌሰኬራ ዸለ ህንፉዸትን።<verse eid="DEU 23:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 23:21"/>አት ዮ <char style="nd">ዋቀዮ</char> ዋቀኬቲፍ ወሬገ ቶኮ ወሬግዴ፣ ሰበቢ <char style="nd">ዋቀዮ</char> ዋቅንኬ ጭምሴ ዋን ሰነ ስራ በርባዱፍ አከ ጩቡ ስት ህንታኔፍ ደፊቲ ኦፍራ ባስ መሌ ለፈረ ህንሀርክስን። <verse eid="DEU 23:21"/><verse number="22" style="v" sid="DEU 23:22"/>ዮ ወሬጉ ባቴ ገሩ አት ጩበማ ህንታቱ። <verse eid="DEU 23:22"/><verse number="23" style="v" sid="DEU 23:23"/>ዋን አረብንኬ ዱበቴ ጎቹፍ ኦፍ ኤገዹ፤ አፋኑመኬቲን ጃለቴ <char style="nd">ዋቀዮ</char> ዋቀኬቲፍ ወሬግዴርታቲ።<verse eid="DEU 23:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="DEU 23:24"/>አት ዮ እዶ ዻባ ወይኒ ኦላኬቲ ኬሰ ሴንቴ፣ እጀ ፌቴ ሁንደ ኛዹ፤ ገሩ ቶኮሌ ጉቦኬ ኬሰ ህንካአን። <verse eid="DEU 23:24"/><verse number="25" style="v" sid="DEU 23:25"/>ዮ ለፈ ቆቲሳ ምዻን ኦላኬቲ ኬሰ ሴንቴ፣ አሼቲ ጭረቹ ንደንዴሰ፤ ገሩ ምዻንሳ ከን ዻበቱት ሃምቱኬ ህንቡስን።<verse eid="DEU 23:25"/></para>
  <chapter eid="DEU 23"/>
  <chapter number="24" style="c" sid="DEU 24"/>
  <para style="p">
    <verse number="1" style="v" sid="DEU 24:1"/>ነምን ቶኮ ኤርገ ኒቲ ፉዼ ቦዴ ዮ ዋን ፈፋ እሼረት አርጌ እሼ ጅቤ፣ እን ወረቃ ረጋ ሂካ በሬሴ እት ኬኑዻን መነሳቲ ባሴ እሼ ሃጌጌሱ። <verse eid="DEU 24:1"/><verse number="2" style="v" sid="DEU 24:2"/>እሼን ኤርገ መነሳቲ ባቴ ቦዴ ዮ ኒቲ ነመ ብራ ታቴ፣ <verse eid="DEU 24:2"/><verse number="3" style="v" sid="DEU 24:3"/>ዮ ዽርስሼ ለመፋን እሼ ጅቤ ወረቃ ሂካ በሬሴ ኬኔፊ መነሳቲ እሼ ባሴ ዮካን ዮ እን ዱኤ፣ <verse eid="DEU 24:3"/><verse number="4" style="v" sid="DEU 24:4"/>ዽርስ እን ጀልቀባ ከን እሼ ሂኬ ሱን ኤርገ እሼን ጡሮፍቴ ቦዴ ዴብኤ እሼ ፉዹን እሳፍ ህንኤየመሙ። ወን ኩን ፉለ <char style="nd">ዋቀዮ</char> ዱረት በልፈማዸ። አት ብየ <char style="nd">ዋቀዮ</char> ዋቅንኬ አከ ዻላት ሲፍ ኬኑት ጩቡ ህንፍድን።<verse eid="DEU 24:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 24:5"/>ነምን ዽኤኘት ኒቲ ፉዼ ቶኮ ለፈ ወራናት ህንኤርገምን ዮካን አከ ሆጂ ብራ ሆጄቱ ህንድርቀምን፤ እን ወጋ ቶኮፍ መነ ኦፊሳ ሃቱሩ፤ ኒቲሳስ ሃገመቺሱ።<verse eid="DEU 24:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 24:6"/>አት ዸጋ ዳኩቲፊ መጂሳ ዮካን መጂሳ ቆፈሌ ታናን አከ ቀብዲት ህንፉዸትን፤ ኩን ሉቡ ነማ ቀብዲ ጎዸኒ ፉዸቹ ተኣቲ።<verse eid="DEU 24:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 24:7"/>ነምን ቶኮ ዮ ኦቦሌሰሳ ከን ጎሰ እስራኤል ቶኮ ሀቴ ገርብቸ ጎዸቴ ዮካን ጉርጉረቴ እን አጄፈሙ ቀበ። አት ዋን ሀማ ግዱኬቲ ባስ።<verse eid="DEU 24:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 24:8"/>ዋኤ ነመ ለምጣኤ ገሩ አኩመ ሌዎትን ሉቦተ ተአን ቀጄልቸ ሲፍ ኬነን ሰነት ሆጄቹኬ ቀልቤፈዹ። አት ዋን አን እሳን አጀጄ ኦፍ ኤገናዻን ዱካ ቡኡ ቀብደ። <verse eid="DEU 24:8"/><verse number="9" style="v" sid="DEU 24:9"/>ዋን <char style="nd">ዋቀዮ</char> ዋቅንኬ ኤርገ እስን ብየ ግብጢቲ ባተኒ ቦዴ ከራረት ሚርያምት ፍዴ ሰነ ያደዹ።<verse eid="DEU 24:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 24:10"/>ዮሙ ኦላኬቲፍ ልቂ ጎሰ ከሚዩ ኬንቱት ዋን እን አከ ቀብዲት ሲፍ ኬኑ ፉዸቹዻፍ መነሳ ህንሴንን። <verse eid="DEU 24:10"/><verse number="11" style="v" sid="DEU 24:11"/>አት አለ ቱሪቲ ነምች አት ዋ ልቄስቱፍ ሱን ቀብዲ ሲፍ ኬኑ ሰነ ሲፍ ሃፍዱ። <verse eid="DEU 24:11"/><verse number="12" style="v" sid="DEU 24:12"/>ዮ ነምን ሱን ህዬሰ ተኤ ቀብዲሳ ኦፍ ብረ ህንቡልችን። <verse eid="DEU 24:12"/><verse number="13" style="v" sid="DEU 24:13"/>አከ እን ኮቲሳ ኡፈቴ ቡሉፍ ኡቱ አዱን ህንዽእን ዴብሲፍ። እንስ ስ ኤብሰ፤ ወን ኩንሞ ፉለ <char style="nd">ዋቀዮ</char> ዋቀኬቲ ዱረት አከ ሆጂ ቀጄሉማት ሲፍ ሄደመ።<verse eid="DEU 24:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 24:14"/>ኦቦሌሰኬ ነመ ጎሰ እስራኤል ዮካን አለጋ መጋላወንኬ ቶኮ ኬሰ ጅራቱሌ ታናን ህዬሰ ዮካን ረከታ ቀጠረሜ ቶኮ ህንሳምን። <verse eid="DEU 24:14"/><verse number="15" style="v" sid="DEU 24:15"/>ገቲ እን እቲን ሆጄቴ ጋፉመ ሰነ ኡቱ አዱን ህንልጥን ኬኒፍ፤ ዋን ህዬሰ ተኤፍ እን አብዲዻን ኤገታቲ። ዮ ከና አቺ እን <char style="nd">ዋቀዮን</char> ስት ዋመቴ ወን ኩን ጩቡ ስት ተአ።<verse eid="DEU 24:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 24:16"/>አቦቲን ሰበቢ እጆሌሳኒቲፍ አጄፈሙ ህንቀበን ዮካን እጆሌን ሰበቢ አቦቲሳኒቲፍ አጄፈሙ ህንቀበን፤ ቶኮን ቶኮን ነማ ሰበቢ ጩቡ ኦፊሳቲፍ ዱአ።<verse eid="DEU 24:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 24:17"/>አት ሙርቲ አለጋ ዮካን እጆሌ አባ ህንቀብኔ ህንጀልእስን ዮካን ኡፈተ ሃዸ ህዬሳ ቀብዲ ህንፉዸትን። <verse eid="DEU 24:17"/><verse number="18" style="v" sid="DEU 24:18"/>አት አከ ብየ ግብጥት ገርብቸ ቱርቴፊ አከ <char style="nd">ዋቀዮ</char> ዋቅንኬ አቺ ስ ፉሬ ያደዹ። ወን አን አከ አት ዋን ከነ ሆጄቱፍ ስ አጀጁፍስ ከኑመ።<verse eid="DEU 24:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 24:19"/>ዮሙ ምዻን ለፈ ቆቲሳኬቲ ወልት ቀብዱት ዮ ብሲን ሀፌ ጅራቴ እሳፍ ጄቴ ዱበት ህንዴብእን፤ አከ <char style="nd">ዋቀዮ</char> ዋቅንኬ ሆጂ ሀርከኬቲ ሁንዳን ስ ኤብሱፍ አለጎተ፣ እጆሌ አባ ህንቀብኔፊ ሃዸ ህዬሳቲፍ ዺስ። <verse eid="DEU 24:19"/><verse number="20" style="v" sid="DEU 24:20"/>ዮሙ እጀ ሙከ ኤጄርሰኬቲ ሀርጫፍቱትስ ከን ሀፌ ፉናነቹፍ ጄቴ ህንዴብእን፤ ዋን ሀፌ ሰነ አለጋፍ፣ እጆሌ አባ ህንቀብኔፊ ሃዸ ህዬሳቲፍ ዺስ። <verse eid="DEU 24:20"/><verse number="21" style="v" sid="DEU 24:21"/>ዮሙ እጀ እዶ ዻባ ወይኒኬቲ ወልት ቀብዱትስ ዋን ሀፌ ፉናነቹዻፍ ህንዴብእን። ዋን ሀፌ ሰነ አለጋዻፍ፣ እጆሌ አባ ህንቀብኔፊ ሃዸ ህዬሳቲፍ ዺስ። <verse eid="DEU 24:21"/><verse number="22" style="v" sid="DEU 24:22"/>አት አከ ግብጥት ገርብቸ ቱርቴ ያደዹ። ወን አን አከ አት ዋን ከነ ጎቱ ስ አጀጁፍስ ከኑመ።<verse eid="DEU 24:22"/></para>
  <chapter eid="DEU 24"/>
  <chapter number="25" style="c" sid="DEU 25"/>
  <para style="p">
    <verse number="1" style="v" sid="DEU 25:1"/>ዮ ነሞትን ለመ ወል ዸበኒ ገረ መነ ሙርቲ ዹፈን፣ አቦቲን ሴራ እሰ ቁልቁሉ ገድ ዺሰኒ እሰ የከ ቀቡት ሙሩ ቀቡ። <verse eid="DEU 25:1"/><verse number="2" style="v" sid="DEU 25:2"/>ዮ ነምቸ በሌሳ ቀቡ ሰናፍ ገረፈሙን መሌ አባን ሙርቲ አከ እን ጪሱ ጎዼ ፉለ ነምቻ ዱረት ለኮብሰ የከሳቲፍ መሉን እሰ ሃገረፍሲሱ፤ <verse eid="DEU 25:2"/><verse number="3" style="v" sid="DEU 25:3"/>ተኡስ እን አፉርተመ ጫላ እሰ ህንገረፍሲስን። እን ከነ ጫላ ዮ ገረፈሜ ኦቦሌስኬ ፉለኬ ዱረት ንቃነአ።<verse eid="DEU 25:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="DEU 25:4"/>ቆትዮ ምዻን ስርብሲሱት ጅሩ አፋን ህንህዽን።<verse eid="DEU 25:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 25:5"/>ዮ ኦቦሎትን ወጅን ጅራተኒ እሳን ኬሳ ቶኮ ኡቱ እልመ ህንዸልችን ዱኤ፣ ኒቲንሳ ማቲዻ አለት ሄሩሙ ህንቀብዱ። ዋርሳንሼ እሼ ፉዼ ኒቲ ሃጎዸቱ፤ ዋን ዋርሳን ቶኮ ጉቱፊ ቀቡስ እሼዻፍ ሃጉቱ። <verse eid="DEU 25:5"/><verse number="6" style="v" sid="DEU 25:6"/>አከ መቃንሳ እስራኤል ግዱዻ ህንበድኔፍ እልም እሼን ዴሱ ሀንገፍን መቃ ኦቦሌሰ ዱኤ ሰናቲን ሃዋመሙ።<verse eid="DEU 25:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 25:7"/>ተኡስ ዮ ነምች ሱን ኒቲ ኦቦሌሰሳ ፉዹ ህንበርባድኔ እሼን ገረ በልበለ መጋላት ማንጉዶተ ብረ ዸቅጤ፣ “ዋርሳንኮ መቃ ኦቦሌሰሳ እስራኤል ኬሰት ዋምስሱ ድዴረ። እን ዋን ዋርሳን ቶኮ ጉቱ ቀቡ ናፍ ህንጉቱ” ሃጄቱን። <verse eid="DEU 25:7"/><verse number="8" style="v" sid="DEU 25:8"/>ኤርገሲ ማንጉዶትን መጋላሳቲ ዋመኒ እሰ ሃሃሶፍሲሰን። ዮ እን ያደሳ ጌደረቹ ድዴ፣ “አን እሼ ፉዹ ህንፌዹ” ጄዼ፣ <verse eid="DEU 25:8"/><verse number="9" style="v" sid="DEU 25:9"/>ኒቲን ኦቦሌሰሳ ሱን ፉለ ማንጉዶታ ዱረት ገረሳ ዸቅጤ ኮጴ ሚለሳ ቶኮራ ባፍት፤ ፉለ እሳትስ ቱፍቴ፣ “ነመ ኦቦሌሰሳቲፍ መነ ህንዻብኔረት ዋን አከናቱ ራወተመ” ሃጄቱ። <verse eid="DEU 25:9"/><verse number="10" style="v" sid="DEU 25:10"/>ሰኚን ነመ ሰናስ እስራኤል ኬሰት፣ “ማቲ ኮጴን እራ ባፈሜ” ጄዸሜ ዋመመ።<verse eid="DEU 25:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 25:11"/>ዮ ኡቱ ነሞትን ለመ ወል ሎለኒ፣ ኒቲን እሰ ቶኮ ዹፍቴ ዽርሰሼ ሀርከ ነምቸ እሰ ቱማ ጅሩ ሰናቲ ባሱፍ ሀርከሼ ሂጠቴ ሳለ ነምቻ ቀብዴ፣ <verse eid="DEU 25:11"/><verse number="12" style="v" sid="DEU 25:12"/>አት ሀርከሼራ ሙር። ገራ ህንላፍኒፍ።<verse eid="DEU 25:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 25:13"/>ኮሮጆኬ ኬሳ መዳሊወን ወል ጫለን ለመ ጄቹን ቶኮ ኡልፋታ ቶኮሞ ከን ህንኡልፋትኔ ህንቀባትን። <verse eid="DEU 25:13"/><verse number="14" style="v" sid="DEU 25:14"/>መነኬ ኬሳ ሰፈርቱወን ገራ ገራ ለመ ጄቹንስ ቶኮ ጉዳ ቶኮሞ ጥና ህንቀባትን። <verse eid="DEU 25:14"/><verse number="15" style="v" sid="DEU 25:15"/>አት አከ ብየ <char style="nd">ዋቀዮ</char> ዋቅንኬ ሲፍ ኬኑ ኬሰ በረ ዼራ ጅራቱፍ መዳሊፊ ሰፈርቱ ቀጄላፊ አመነማ ተኤ ቀባዹ። <verse eid="DEU 25:15"/><verse number="16" style="v" sid="DEU 25:16"/><char style="nd">ዋቀዮ</char> ዋቅንኬ ነመ ዋን አከሲ ሆጄቱ ከምዩ፣ ነመ ጀልእነ ሆጄቱ ከምዩስ ንበልፋቲ።<verse eid="DEU 25:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 25:17"/>ዋን አማሌቆትን ዬሮ አት ግብጢ ባቱ ከራረት ስ ጎዸን ሰነ ያደዹ። <verse eid="DEU 25:17"/><verse number="18" style="v" sid="DEU 25:18"/>እሳን ዬሮ አት ደዸብዴ ቡቱቴ ቱርቴት ከራረት ስ አርገተኒ ወረ ዱባን ትረቻ ቱረን ሁንደ አጄሰን፤ ዋቀስ ህንሶዳትኔ። <verse eid="DEU 25:18"/><verse number="19" style="v" sid="DEU 25:19"/>ዮሙ <char style="nd">ዋቀዮ</char> ዋቅንኬ ብየ ዻለ ጎዼ ሲፍ ኬኑ ኬሰት ዲኖተ ናኖኬቲራ ቦቆና ሲፍ ኬኑት፣ ያደኖ አማሌቅ ሰሚ ጀላ በሌስ። ዋን ከነ ህንደገትን!<verse eid="DEU 25:19"/></para>
  <chapter eid="DEU 25"/>
  <chapter number="26" style="c" sid="DEU 26"/>
  <para style="s1">እጀ ጀልቀባ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 26:1"/>አት ዮሙ ብየ <char style="nd">ዋቀዮ</char> ዋቅንኬ ዻለ ጎዼ ሲፍ ኬኑት ገልቴ ዻልቴ ኬሰ ቁበቱት፣ <verse eid="DEU 26:1"/><verse number="2" style="v" sid="DEU 26:2"/>ምዻን ለፈ ብየ <char style="nd">ዋቀዮ</char> ዋቅንኬ ሲፍ ኬኑራ አርገቱ ሁንደራ መታሳ ፉዺቲ ጉቦ ኬሰ ካእ። ኤርገሲስ እዶ <char style="nd">ዋቀዮ</char> ዋቅንኬ እዶ ጅሬኘ መቃሳቲፍ ፍለቱ ዸቅ፤ <verse eid="DEU 26:2"/><verse number="3" style="v" sid="DEU 26:3"/>ሉበ ዬሮ ሰነት ሆጂረ ጅሩን፣ “አን ብየ <char style="nd">ዋቀዮ</char> አከ ኑ ኬኑ አቦቲኬኛፍ ዋዳ ገሌት ዹፉኮ ሀርአ ፉለ <char style="nd">ዋቀዮ</char> ዋቀኬቲ ዱረት ነንለብሰ” ጄዽ። <verse eid="DEU 26:3"/><verse number="4" style="v" sid="DEU 26:4"/>ሉብን ሱንስ ጉቦ ሰነ ስ ሀርካ ፉዼ እዶ ኣርሳ <char style="nd">ዋቀዮ</char> ዋቀኬቲ ዱረ ንካአ። <verse eid="DEU 26:4"/><verse number="5" style="v" sid="DEU 26:5"/>አትስ <char style="nd">ዋቀዮ</char> ዋቀኬ ዱረት አከነ ጄቴ ንለብስተ፤ “አባንኮ ነመ ብየ አራም ከን አሲፊ አች ጎዳኑ ቱሬ፤ እንስ ነሞተ ጥኖ ፉዸቴ ግብጥት ገድ ቡኤ፤ አችስ ጅራቴ ሰበ ጉዳ፣ ሁምነ ቀቤሳፊ አከ መሌ ባይኤ ተኤ። <verse eid="DEU 26:5"/><verse number="6" style="v" sid="DEU 26:6"/>ወር ግብጥ ገሩ ኑ ሀጩጩፊ ኑ ዽጵሱዻን ሆጂ ጀባ ኑት ፌአን። <verse eid="DEU 26:6"/><verse number="7" style="v" sid="DEU 26:7"/>ኑ ኤርገሲ ገረ <char style="nd">ዋቀዮ</char> ዋቀ አቦቲኬኛት እየትኔ፤ <char style="nd">ዋቀዮስ</char> ሰገሌኬኘ ዸገኤ ረክነኬኘ፣ ደዸቢኬኛፊ ሀጩጨሙኬኘ አርጌ። <verse eid="DEU 26:7"/><verse number="8" style="v" sid="DEU 26:8"/>ከናፉ <char style="nd">ዋቀዮ</char> ሀርከ ጀባፊ እሬ ድሪርፈሜን፣ ሶዳችሰ ጉዳዻን፣ መለቶፊ ድንቂዻን ግብጢ ኑ ባሴ። <verse eid="DEU 26:8"/><verse number="9" style="v" sid="DEU 26:9"/>እዶ ከነትስ ኑ ፍዴ ብየ ኣነኒፊ ደመ ባፍቱ ከነ ኑፍ ኬኔ፤ <verse eid="DEU 26:9"/><verse number="10" style="v" sid="DEU 26:10"/>አመስ ያ <char style="nd">ዋቀዮ</char> ኩኖ፣ አን ምዻን ለፈ አት ና ኬንቴራ መታሳ ፍዴረ።” ጉቦ ሰነስ ፉለ <char style="nd">ዋቀዮ</char> ዋቀኬቲ ዱረ ካኢቲ ፉለሳ ዱረት ገድ ጄዺ ሰገድ። <verse eid="DEU 26:10"/><verse number="11" style="v" sid="DEU 26:11"/>አት፣ ሌዎትኒፊ አለጎትን ግዱኬ ጅራተን ዋን ጋሪ <char style="nd">ዋቀዮ</char> ዋቅንኬ ሲፊ ማቲኬቲፍ ኬኔ ሁንዳን ገመዳ።<verse eid="DEU 26:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 26:12"/>ዮሙ ወጋ ሰደፋት ጄቹንስ ወጋ እት ኬና ኩዸን ኬሳ ቶኮ ባፈሙት ምዻንኬራ ኤርገ ኬና ኩዸን ኬሳ ቶኮ ባፍቴ ራወቴ ቦዴ አከ እሳን መጋላወንኬ ኬሰት ኛተኒ ቁፈኒፍ ሌዎታፍ፣ አለጎታፍ፣ እጆሌ አባ ህንቀብኔፊ ሃዾተ ህዬሳቲፍ ኬን። <verse eid="DEU 26:12"/><verse number="13" style="v" sid="DEU 26:13"/>ኤርገሲ <char style="nd">ዋቀዮ</char> ዋቀኬቲን አከነ ጄዽ፤ “አን አኩመ አጀጀኬ ከን አት ነ አጀጄ ሁንዳት ቆደ ቁልቁሉ መነኮቲ ባሴ ሌዎታፍ፣ አለጎታፍ፣ እጆሌ አባ ህንቀብኔፊ ሃዾተ ህዬሳቲፍ ኬኔረ። አን አጀጀወንኬራ ህንጎሬ ዮካን ቶኮሳኒሌ ህንደገትኔ። <verse eid="DEU 26:13"/><verse number="14" style="v" sid="DEU 26:14"/>አን ዬሮን ገደረ ቱሬስ ኩታ ቁልቁሉ ሰነራ ሆማ ህንኛትኔ፤ ዮካን አን ዬሮን ጡራኤት እሰራ ዋን ቶኮሌ ህንፉኔ፤ ወረ ዱአኒፍስ ህንዽኤስኔ፤ አን <char style="nd">ዋቀዮ</char> ዋቀኮቲፍ አጀጀሜረ፤ ዋን አት ነ አጀጄ ሁንደስ ሆጄዼረ። <verse eid="DEU 26:14"/><verse number="15" style="v" sid="DEU 26:15"/>ሰሚራ፣ እዶ ጅሬኘኬቲ ቁልቁሉራ ገድ እላል፤ ሰበኬ እስራኤሊፊ ብየ አኩመ አቦቲኬኛፍ ዋዳ ገልቴት ኑ ኬንቴ ከን ኣነኒፊ ደም ኬሳ ቡርቁ ከነ ኤብስ።”<verse eid="DEU 26:15"/></para>
  <para style="s1">አጀጀወን <char style="nd">ዋቀዮ</char> ዱካ ቡኡ</para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 26:16"/>
    <char style="nd">ዋቀዮ</char> ዋቅንኬ አከ አት አጀጀወኒፊ ሴረወን ከኔን ኤግዱ ሀርአ ስ አጀጀ፤ አት አከ ገራኬ ጉቱፊ ሉቡኬ ጉቱዻን እሳን ኤግዱ ኦፍ ኤገዹ። <verse eid="DEU 26:16"/><verse number="17" style="v" sid="DEU 26:17"/>አት አከ <char style="nd">ዋቀዮ</char> ዋቀኬ ተኤፊ አከ ከራሳረ ዴዴብቱ፣ አከ ቀጄልቸወንሳ፣ አጀጀወኒፊ ሴረወንሳ ኤግዴ እሳፍ አጀጀምቱ ሀርአ ዱበቴርተ። <verse eid="DEU 26:17"/><verse number="18" style="v" sid="DEU 26:18"/><char style="nd">ዋቀዮስ</char> አኩመ አብደቺሴ ሰነት አከ አት ሰበሳቲፊ ቀቤኘሳ ታቴ አጀጀወንሳ ሁንደ ኤግዱ ሀርአ ዱበቴረ። <verse eid="DEU 26:18"/><verse number="19" style="v" sid="DEU 26:19"/>እን አከ ሰቦተ ኡሜ ሁንዳን ኦልት ገለታን፣ መቃፊ ኡልፍናን ኦል ስ ካሱፊ አኩመ ዋዳ ገሌ ሰናት አከ አት <char style="nd">ዋቀዮ</char> ዋቀኬቲፍ ሰበ ቁልቁሉ ታቱ ዱበቴረ።<verse eid="DEU 26:19"/></para>
  <chapter eid="DEU 26"/>
  <chapter number="27" style="c" sid="DEU 27"/>
  <para style="s1">እዶ ኣርሳ ከን ቱሉ ጌባልራ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 27:1"/>ሙሴፊ ማንጉዶትን እስራኤል አከነ ጄዸኒ ሰበ አጀጀን፤ “አጀጀወን አን ሀርአ እስኒፍ ኬኑ ከኔን ሁንደ ኤጋ። <verse eid="DEU 27:1"/><verse number="2" style="v" sid="DEU 27:2"/>ኤርገ ብየ <char style="nd">ዋቀዮ</char> ዋቅንኬ ሲፍ ኬኑት ገሉፍ ዮርዳኖስ ጬተኒ ቦዴ ዸጎተ ጉርጉዳ ዻቢቲ ኖራ ድብ። <verse eid="DEU 27:2"/><verse number="3" style="v" sid="DEU 27:3"/>ዮሙ አኩመ <char style="nd">ዋቀዮ</char> ዋቅን አቦቲኬቲ ስ አብደቺሴት ብየ ኣነኒፊ ደም ኬሳ ቡርቁ ከን <char style="nd">ዋቀዮ</char> ዋቅንኬ ሲፍ ኬኑት ገሉፍ ጬቱት ዱቢወን ሴረ ከና ሁንደ ዸጎተረት በሬስ። <verse eid="DEU 27:3"/><verse number="4" style="v" sid="DEU 27:4"/>አት ኤርገ ዮርዳኖስ ጬቴ ቦዴ አኩመ አን ሀርአ ስ አጀጁት ዸጎተ ከኔን ቱሉ ኤባልራ ዻቢ ኖራ ድብ። <verse eid="DEU 27:4"/><verse number="5" style="v" sid="DEU 27:5"/>አችትስ <char style="nd">ዋቀዮ</char> ዋቀኬቲፍ እዶ ኣርሳ ከን ዸጋራ ሆጄተሜ ዻብ፤ ምአ ስቢላ ቶኮዩ ህንፈየደምን። <verse eid="DEU 27:5"/><verse number="6" style="v" sid="DEU 27:6"/>እዶ ኣርሳ <char style="nd">ዋቀዮ</char> ዋቀኬቲ ዸጋ ህንሶፈምኒን ሆጄዹ፤ አችረትስ <char style="nd">ዋቀዮ</char> ዋቀኬቲፍ ኣርሳ ጉበሙ ዽኤስ። <verse eid="DEU 27:6"/><verse number="7" style="v" sid="DEU 27:7"/>አችትስ ኣርሳ ነጋ ቀሊ ኛዹቲ ፉለ <char style="nd">ዋቀዮ</char> ዋቀኬቲ ዱረት ገመድ። <verse eid="DEU 27:7"/><verse number="8" style="v" sid="DEU 27:8"/>ዸጎተረት ዱቢወን ሴረ ከና ሁንደ እብሲ በሬስ።”<verse eid="DEU 27:8"/></para>
  <para style="s1">አባርሰ ቱሉ ጌባልረት ለብሰሜ</para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 27:9"/>ሙሴፊ ሌዎትን ሉቦተ ተአን እስራኤሎተ ሁንዳን አከነ ጄዸን፤ “ያ እስራኤል፣ ጨልእሲ ዸገእ! አት ሀርአ ሰበ <char style="nd">ዋቀዮ</char> ዋቀኬቲ ታቴርተ። <verse eid="DEU 27:9"/><verse number="10" style="v" sid="DEU 27:10"/><char style="nd">ዋቀዮ</char> ዋቀኬቲፍ አጀጀሚቲ አጀጀወንሳቲፊ ቀጄልቸወን አን ሀርአ ሲፍ ኬኑ ዸገእ።”<verse eid="DEU 27:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 27:11"/>ሙሴንስ ጋፈሱመ አከነ ጄዼ ሰበ አጀጄ፦<verse eid="DEU 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 27:12"/>ዮሙ እስን ዮርዳኖስን ጬተንት ጎሶትን ስምኦን፣ ሌዊ፣ ይሁዳ፣ ይሳኮር፣ ዮሴፊፊ ከን ቤንያም ሰበ ኤብሱፍ ጋረ ጌርዚምራ ሃዻበተን። <verse eid="DEU 27:12"/><verse number="13" style="v" sid="DEU 27:13"/>ጎሶትን ሩቤን፣ ጋድ፣ ኣሼር፣ ዜቡሎን፣ ዳኒፊ ንፍታሌምሞ አባሩፍ ቱሉ ኤባልራ ሃዻበተን።<verse eid="DEU 27:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 27:14"/>ሌዎትን ሰገሌሳኒ ኦል ፉዸተኒ አከነ ጄዸኒ ሰበ እስራኤል ሁንደት ሃለብሰን፦<verse eid="DEU 27:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 27:15"/>“ነምን ፈኪ ሶፉ ዮካን በቅሴ ዋቀ ቶልፈማ ጄቹንስ ዋን ፉለ <char style="nd">ዋቀዮ</char> ዱረት በልፈማ ተኤ ሆጄቱ ከን ዋን ኦጉማ ሀርካቲን ሆጄተሜ ዾክሴ ኦል ዻቡ ሃአባረሙ።”</para>
  <para style="pr" vid="DEU 27:15">ኤርገሲስ ሰብን ሁንድ፣ “አሜን!” ሃጄዹ።<verse eid="DEU 27:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 27:16"/>“ነምን አባሳ ዮካን ሃዸሳ ቃኔሱ ሃአባረሙ።”</para>
  <para style="pr" vid="DEU 27:16">ኤርገሲስ ሰብን ሁንድ፣ “አሜን!” ሃጄዹ።<verse eid="DEU 27:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 27:17"/>“ነምን ዸጋ ዳሪ ኦላሳ ዺቡ ሃአባረሙ።”</para>
  <para style="pr" vid="DEU 27:17">ኤርገሲስ ሰብን ሁንድ፣ “አሜን!” ሃጄዹ።<verse eid="DEU 27:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 27:18"/>“ነምን ነመ ጃማ ከራራ ጀልእሱ ሃአባረሙ።”</para>
  <para style="pr" vid="DEU 27:18">ኤርገሲስ ሰብን ሁንድ፣ “አሜን!” ሃጄዹ።<verse eid="DEU 27:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 27:19"/>“ነምን ሙርቲ አለጋ፣ እጆሌ አባ ህንቀብኔቲፊ ኒቶተ ዽርሶትንሳኒራ ዱአኒ ጀልእሱ ሃአባረሙ።”</para>
  <para style="pr" vid="DEU 27:19">ኤርገሲስ ሰብን ሁንድ፣ “አሜን!” ሃጄዹ።<verse eid="DEU 27:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 27:20"/>“ነምን ኒቲ አባሳ ወጅን ጪሱ ሃአባረሙ፤ እን ስሬ አባሳ ጡሬሴራቲ።”</para>
  <para style="pr" vid="DEU 27:20">ኤርገሲስ ሰብን ሁንድ፣ “አሜን!” ሃጄዹ።<verse eid="DEU 27:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 27:21"/>“ነምን ሆሪ ከምዩ ወጅን ወል ብረ ገኡ ሃአባረሙ።”</para>
  <para style="pr" vid="DEU 27:21">ኤርገሲስ ሰብን ሁንድ፣ “አሜን!” ሃጄዹ።<verse eid="DEU 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 27:22"/>“ነምን ኦቦሌቲሳ እንተለ አባሳ ዮካን እንተለ ሃዸሳ ወጅን ጪሱ ሃአባረሙ።”</para>
  <para style="pr" vid="DEU 27:22">ኤርገሲስ ሰብን ሁንድ፣ “አሜን!” ሃጄዹ።<verse eid="DEU 27:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 27:23"/>“ነምን ሃዸ ኒቲሳ ወጅን ጪሱ ሃአባረሙ።”</para>
  <para style="pr" vid="DEU 27:23">ኤርገሲስ ሰብን ሁንድ፣ “አሜን!” ሃጄዹ።<verse eid="DEU 27:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="DEU 27:24"/>“ነምን ዾክሳዻን ኦላሳ አጄሱ ሃአባረሙ።”</para>
  <para style="pr" vid="DEU 27:24">ኤርገሲስ ሰብን ሁንድ፣ “አሜን!” ሃጄዹ።<verse eid="DEU 27:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DEU 27:25"/>“ነምን ነመ ቁልቁሉ አጄሱፍ ጄዼ መተኣ ፉዸቱ ሃአባረሙ።”</para>
  <para style="pr" vid="DEU 27:25">ኤርገሲስ ሰብን ሁንድ፣ “አሜን!” ሃጄዹ።<verse eid="DEU 27:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="DEU 27:26"/>“ነምን ዱቢወን ሴረ ከና ኤጉዻን ጀባቴ ህንዻበትኔ ሃአባረሙ።”</para>
  <para style="pr" vid="DEU 27:26">ኤርገሲስ ሰብን ሁንድ፣ “አሜን!” ሃጄዹ።<verse eid="DEU 27:26"/></para>
  <chapter eid="DEU 27"/>
  <chapter number="28" style="c" sid="DEU 28"/>
  <para style="s1">ኤበ አጀጀሙዻን አርገሙ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 28:1"/>ዮ አት ጉቱማን ጉቱት <char style="nd">ዋቀዮ</char> ዋቀኬቲፍ አጀጀምቴ አጀጀወንሳ ከኔን አን ሀርአ ሲፍ ኬኑ ኦፍ ኤገናዻን ዱካ ቡቴ፣ <char style="nd">ዋቀዮ</char> ዋቅንኬ ሰቦተ ለፈረ ጅራተን ሁንዳ ኦልት ኦል ስ ቀበ። <verse eid="DEU 28:1"/><verse number="2" style="v" sid="DEU 28:2"/>ዮ አት <char style="nd">ዋቀዮ</char> ዋቀኬቲፍ አጀጀምቴ ኤብ ኩን ሁንድ ሲፍ ተአ፤ ስ ፋነ ዴመስ፦<verse eid="DEU 28:2"/></para>
  <para style="pm">
    <verse number="3" style="v" sid="DEU 28:3"/>አት መጋላት ንኤብፈምተ፤ ባድያትስ ንኤብፈምተ።<verse eid="DEU 28:3"/></para>
  <para style="pm">
    <verse number="4" style="v" sid="DEU 28:4"/>እጅ ገደሜሰኬቲ፣ እጅ ለፈኬቲ፣ እጅ ሆሪኬቲ፣ ጀቢን ሎንኬቲቲፊ ኮርቤዪን ቡሻዬኬቲ ንኤብፈሙ።<verse eid="DEU 28:4"/></para>
  <para style="pm">
    <verse number="5" style="v" sid="DEU 28:5"/>ጉቦንኬቲፊ ምእ ቡኮኬቲ ንኤብፈሙ።<verse eid="DEU 28:5"/></para>
  <para style="pm">
    <verse number="6" style="v" sid="DEU 28:6"/>አት ዮሙ ገልቱ ንኤብፈምተ፤ ዮሙ ባቱስ ንኤብፈምተ።<verse eid="DEU 28:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 28:7"/>
    <char style="nd">ዋቀዮ</char> አከ ዲኖትንኬ ከኔን ስት ከአን ፉለኬ ዱረት ሞአተመን ንጎዸ። እሳን ከራ ቶኮን ስት ዹፉ፣ ገሩ ከራ ቶርባን ስ በቀቱ።<verse eid="DEU 28:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 28:8"/>
    <char style="nd">ዋቀዮ</char> ጎምብሳኬቲፊ ዋን ሀርክኬ ቀበቴ ሁንደት ኤበሳ ንኤርገ። <char style="nd">ዋቀዮ</char> ዋቅንኬ ብየ ሲፍ ኬኑ ኬሰት ስ ኤብሰ።<verse eid="DEU 28:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 28:9"/>ዮ አት አጀጀ <char style="nd">ዋቀዮ</char> ዋቀኬቲ ኤግዴ ከራሳረ ዴዴብቴ፣ <char style="nd">ዋቀዮ</char> አኩመ ከኩዻን ስ አብደቺሴት ሰበሳ ቁልቁሉ ጎዼ ስ ዻበ። <verse eid="DEU 28:9"/><verse number="10" style="v" sid="DEU 28:10"/>ኤርገሲ ሰቦትን ለፈረ ጅራተን ሁንድ አከ አት መቃ <char style="nd">ዋቀዮቲን</char> ዋመምቱ አርገኒ ስ ሶዳቱ። <verse eid="DEU 28:10"/><verse number="11" style="v" sid="DEU 28:11"/><char style="nd">ዋቀዮ</char> ብየ ሲፍ ኬኑፍ አቦቲኬቲፍ ከከቴ ኬሰት እጆሌዻን፣ ጀቦታፊ ምዻን ለፋቲን ሶሩመ እረ ዸንገለኣ ሲፍ ኬነ።<verse eid="DEU 28:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 28:12"/>
    <char style="nd">ዋቀዮ</char> ዬሮዻን ለፈኬት ቦካ ኤርጌ ሆጂ ሀርከኬቲ ሁንደ ኤብሱፍ ጎምብሳ በዻዹማሳ ጄቹንስ ሰሚወን ንበነ። አት ሰቦተ ሄዱዻፍ ንልቄስተ መሌ ቶኮሳኒራዩ ህንልቄፈቱ። <verse eid="DEU 28:12"/><verse number="13" style="v" sid="DEU 28:13"/><char style="nd">ዋቀዮ</char> መታ ስ ጎዸ መሌ ኤጌ ስ ህንጎዹ። አት ዮ አጀጀወን <char style="nd">ዋቀዮ</char> ዋቀኬቲ ከኔን አን ሀርአ ሲፍ ኬኑ ኦፍ ኤገናዻን ኤግዴ ዱካ ቡቴ፣ ዬሮ ሁንደ እረ ኣንተ መሌ ጀለ ህንኣንቱ። <verse eid="DEU 28:13"/><verse number="14" style="v" sid="DEU 28:14"/>አት ዋቆተ ብራ ዱካ ቡኡፊ ተጃጅሉዻን አጀጀወን አን ሀርአ ሲፍ ኬኑ ከኔንራ ምርገትስ ብታትስ ህንጎርን።<verse eid="DEU 28:14"/></para>
  <para style="s1">አባርሰ አጀጀሙ ድዱን ፍዱ</para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 28:15"/>ገሩ ዮ አት <char style="nd">ዋቀዮ</char> ዋቀኬቲፍ አጀጀሙ ባቴ አጀጀወንሳቲፊ ቀጄልቸወንሳ ከኔን አን ሀርአ ሲፍ ኬኑ ሁንደ ኦፍ ኤገናዻን ኤጉ ድዴ፣ አባርሰወን ኩኔን ሁንድ ስ ቀቀቡ፤ ስ ልቅምሱስ፦<verse eid="DEU 28:15"/></para>
  <para style="pm">
    <verse number="16" style="v" sid="DEU 28:16"/>አት መጋላት ንአባረምተ፤ ባድያትስ ንአባረምተ።<verse eid="DEU 28:16"/></para>
  <para style="pm">
    <verse number="17" style="v" sid="DEU 28:17"/>ጉቦንኬ ንአባረመ፤ ምእ ቡኮኬቲስ ንአባረመ።<verse eid="DEU 28:17"/></para>
  <para style="pm">
    <verse number="18" style="v" sid="DEU 28:18"/>እጅ ገደሜሰኬቲ፣ እጅ ለፈኬቲ፣ ጀቢን ሎንኬቲቲፊ ኮርቤዪን ቡሻዬኬቲ ንአባረሙ።<verse eid="DEU 28:18"/></para>
  <para style="pm">
    <verse number="19" style="v" sid="DEU 28:19"/>አት ዮሙ ገልቱ ንአባረምተ፤ ዮሙ ባቱሌ ንአባረምተ።<verse eid="DEU 28:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 28:20"/>አት ሰበቢ እሰ ዺፍቴ ዋን ሀማ ሆጄቴፍ <char style="nd">ዋቀዮ</char> ሀመ አት በርበዶፍቴ ደፍቴስ ለፈራ ዸበምቱት ዋን ሀርክኬ ሆጄቱ ሁንዳን አባርሰ፣ ጆንጀኡፊ ዼከምሰ ስት ኤርገ። <verse eid="DEU 28:20"/><verse number="21" style="v" sid="DEU 28:21"/><char style="nd">ዋቀዮ</char> ሀመ ብየ አት ዻሉፍ እት ገልቱራ ስ በሌሱት ዹኩባን ስ ዸአ። <verse eid="DEU 28:21"/><verse number="22" style="v" sid="DEU 28:22"/><char style="nd">ዋቀዮ</char> ሀመ አት ለፈራ ዸበምቱት፣ ዹኩበ ነመ ሁቅሱን፣ ዸግነ ጉባፊ ዹላዻን፣ ሆአ አዱቲፊ ቦነ ሀማዻን፣ ጮለጉፊ ዋጊዻን ስ ዸአ። <verse eid="DEU 28:22"/><verse number="23" style="v" sid="DEU 28:23"/>ሰሚን መታኬቲ ኦሊ ናሲ፣ ለፍት ሚለኬ ጀላ ስቢለ ተአ። <verse eid="DEU 28:23"/><verse number="24" style="v" sid="DEU 28:24"/><char style="nd">ዋቀዮ</char> ቦካ ለፈኬቲ አዋራፊ ዳራት ጌደረ፤ ኩንስ ሀመ አት በዱት ሰሚዻ ስት ገድ ሀርጨአ።<verse eid="DEU 28:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DEU 28:25"/>
    <char style="nd">ዋቀዮ</char> አከ አት ዲነኬ ዱረት ሞአተምቱ ጎዸ። አት ከራ ቶኮን እሳንት ዹፍተ፤ ገሩ ከራ ቶርባን እሳን ዱራ በቀተ፤ ሞቱሞተ ለፈረ ጅረን ሁንዳፍ ዋን ኮልፋ ታተ። <verse eid="DEU 28:25"/><verse number="26" style="v" sid="DEU 28:26"/>ሬፍኬ ስምብሮተ ሰሚ ሁንዳፊ ብኔንሶተ ለፋቲፍ ኛተ ተአ፤ ነምን ሶዳችሴ እሳን አርኡስ ህንጅራቱ። <verse eid="DEU 28:26"/><verse number="27" style="v" sid="DEU 28:27"/><char style="nd">ዋቀዮስ</char> ዹኩበ አት ህንፈይኔ ጄቹንስ ዹላ ብየ ግብጢቲን፣ ኢታን፣ መዳ መለኡፊ ጭቶዻን ስ ዽጵሰ። <verse eid="DEU 28:27"/><verse number="28" style="v" sid="DEU 28:28"/><char style="nd">ዋቀዮ</char> መራቱማዻን፣ ጃሙማፊ ቡርጃጀኡ ሰሙቲን ስ ዽጵሰ። <verse eid="DEU 28:28"/><verse number="29" style="v" sid="DEU 28:29"/>አት ጉያ ሳፋ አከ ጃማ ዱከነ ኬሰ ዋ ቀቀበቱት ዴምተ፤ ወን አት ሆጄቱ ሁንድኑ ሲፍ ህንምልካኡ፤ ጉዩመ ጉያን ጩንቁርፈምቴ ሳመምተ፤ ከን ስ ኦልቹስ ህንጅሩ።<verse eid="DEU 28:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="DEU 28:30"/>አት ኒቲ ካዽመተ፤ ገሩ ነመ ብራቱ እሼ ወጅን ጪሰ። መነ እጃረተ፤ ገሩ ኬሰ ህንጅራቱ። ወይኒ ዻበተ፣ ገሩ እጀሳ ህንኛቱ። <verse eid="DEU 28:30"/><verse number="31" style="v" sid="DEU 28:31"/>ሰንጋንኬ ፉለኬ ዱረት ቀለመ፤ ገሩ አት ፎንሳራ ሆማ ህንኛቱ። ሀሬንኬ ሁምናን ስራ ፉዸተመ፤ ሲፍ ህንዴብፈሙስ። ሆሎትንኬ ዲኖተኬቲፍ ኬነሙ፤ ነምን እሳን ሀርካ ቡሱስ ህንጅሩ። <verse eid="DEU 28:31"/><verse number="32" style="v" sid="DEU 28:32"/>እልማኒፊ እንተለንኬ ነሞተ ኦርማቲፍ ኬነሙ፤ እጅኬስ ጉዩመ ጉያን እሳን ኤጉዻን ፈጀጀ፤ አት ሀርከ ኦል ፉዸቹፍ ሁምነ ህንቀባቱ። <verse eid="DEU 28:32"/><verse number="33" style="v" sid="DEU 28:33"/>ኦምሸ ለፈኬቲቲፊ ሁምነኬቲ ሁንደ ነሞትን አት ህንቤክኔ ንኛቱ፤ አት በረ ጅሬኘኬቲ ጉቱ ጩንቁርፈምቴ ጅራቹ መሌ ሆማ ህንቀባቱ። <verse eid="DEU 28:33"/><verse number="34" style="v" sid="DEU 28:34"/>ወን አት አርግቱ ሁንድ ስ መራቸ። <verse eid="DEU 28:34"/><verse number="35" style="v" sid="DEU 28:35"/><char style="nd">ዋቀዮ</char> ፋነ ሚለኬቲቲ ጀልቀቤ ሀመ ጉባ መታኬቲ ገኡት መዳ ህንፈይኔ ከን ነመ ዽጵሱን ጅልባፊ ሚለኬ ንዸአ።<verse eid="DEU 28:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="DEU 28:36"/>
    <char style="nd">ዋቀዮ</char> ስኢፊ ሞቲ አት ኦፍረት ሞስፍቴ ሰቦተ አት ዮካን አቦቲንኬ ህንቤክንት ንኬነ። አትስ አችት ዋቆተ ብራ፣ ዋቆተ ሙካቲፊ ከን ዸጋ ንዋቄፈተ። <verse eid="DEU 28:36"/><verse number="37" style="v" sid="DEU 28:37"/>ሰቦተ <char style="nd">ዋቀዮ</char> እት ስ ጌሱ ሁንደ ኬሰት ዋን ቃኒ፣ ከን ኮልፋቲፊ ከን ቁበ እት ቀበን ንታተ።<verse eid="DEU 28:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="DEU 28:38"/>ለፈ ቆቲሳኬ ኬሰ ሰኚ ባይኤ ፈጫፈተ፤ ገሩ ሰበቢ ሀዋንስን ኛቴ ፍጡፍ ጥኖ ወልት ቀበተ። <verse eid="DEU 28:38"/><verse number="39" style="v" sid="DEU 28:39"/>አትስ ወይኒ ዻብዴ ኩኑንስተ፤ ገሩ ዋን ራሞን ኛቱፍ ዳዺሳ ህንዹግዱ ዮካን እጀሳ ህንጭረቱ። <verse eid="DEU 28:39"/><verse number="40" style="v" sid="DEU 28:40"/>ብየኬ ጉቱ ኬሳ ሙከ ኤጄርሳ ቀባተ፤ ገሩ ዋን እጅሳ ለፈት ሀርጨኡፍ አት ዘይቲሳት ህንፈየደምቱ። <verse eid="DEU 28:40"/><verse number="41" style="v" sid="DEU 28:41"/>አት እልማኒፊ እንተለን ቀባተ፤ ገሩ እሳን ዋን ቦጅአመኒፍ ከንኬ ህንተአን። <verse eid="DEU 28:41"/><verse number="42" style="v" sid="DEU 28:42"/>ሙካፊ ኦምሸ ለፈ ቆቲሳኬቲ ሁንደ ቱተ ሀዋንሳቱ ፍጠ።<verse eid="DEU 28:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="DEU 28:43"/>አለጋን ግዱኬ ጅራቱ ስ ጫላ ጉደተ፤ አት ገሩ ገድ ዴምተ። <verse eid="DEU 28:43"/><verse number="44" style="v" sid="DEU 28:44"/>እሰቱ ሲፍ ልቄሰ መሌ አት እሳፍ ህንልቄስቱ። እን መታ ተአ፤ አት ገሩ ኤጌ ታተ።<verse eid="DEU 28:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="DEU 28:45"/>አባርስ ኩን ሁንድኑ ስ ቀቀበ። አት ዋን <char style="nd">ዋቀዮ</char> ዋቀኬቲፍ ህንአጀጀምኔፊ ዋን አጀጀወኒፊ ቀጄልቸወን እን ሲፍ ኬኔ ህንኤግኒፍ ሀመ አት በዱት አባርስ ኩን ስ ብራ ህንሀፉ፤ ስ ፉዸተስ። <verse eid="DEU 28:45"/><verse number="46" style="v" sid="DEU 28:46"/>እሳን በረ በራን ስኢፊ ሰኚኬት መለቶፊ ድንቂ ተኡ። <verse eid="DEU 28:46"/><verse number="47" style="v" sid="DEU 28:47"/>አት ዋን ዬሮ ሶሮማት ገለታፊ ገመቹዻን <char style="nd">ዋቀዮ</char> ዋቀኬ ህንተጃጅልኒፍ፣ <verse eid="DEU 28:47"/><verse number="48" style="v" sid="DEU 28:48"/>ቤላፊ ዼቡዻን፣ ዳራፊ ህዩማ ሀማዻን ዲኖተ <char style="nd">ዋቀዮ</char> ስት ካሱ ንተጃጅልተ። እን ሀመ ስ በሌሱት ዋንጆ ስቢላ ሞርመኬት ካአ።<verse eid="DEU 28:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="DEU 28:49"/>
    <char style="nd">ዋቀዮ</char> ብየ አከ መሌ ፈጎራ፣ ዳሪ ለፋቲስ ሰበ አከ ርሳ ደፌ ገድ ቡኡ ከን አት አፋንሳ ህንቤክኔ ስት ካሰ፤ <verse eid="DEU 28:49"/><verse number="50" style="v" sid="DEU 28:50"/>እንስ ሰበ ጃርሳፍ ኡልፍነ ህንኬንኔ፣ ከን ዳእመኒፍ ገራ ህንላፍኔፊ ከን አከ መሌ ሶዳችሱዸ። <verse eid="DEU 28:50"/><verse number="51" style="v" sid="DEU 28:51"/>እሳንስ ሀመ አት በዱት እጀ ሎንኬቲቲፊ እጀ ለፈኬቲ ንኛቱ። ሀመ አት በርበዶፍቱት ምዻን ቶኮዩ፣ ዳዺ ወይኒ ሃራ ዮካን ዘይቲ፣ ጀቦተ ሎንኬቲቲፊ ኮርቤዪ ቡሻዬኬቲ ቶኮሌ ሲፍ ህንዺሰን። <verse eid="DEU 28:51"/><verse number="52" style="v" sid="DEU 28:52"/>እሳን መጋላ ብየኬቲ ሁንደ ሀመ ደላወን እትሳ ከኔን አት አመነቱ ጅጅገንት ንመርሱ፤ መጋላ ብየ <char style="nd">ዋቀዮ</char> ዋቅንኬ ሲፍ ኬኑ ኬሰ ጅረን ሁንደዩ ንመርሱ።<verse eid="DEU 28:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="DEU 28:53"/>አት ሰበቢ ዽጵነ ዲኖትንኬ ዬሮ ስ መርሰንት ስት ፍደኒቲፍ እጀ ጉዴደኬቲ፣ ፎን እልማኒፊ እንተለንኬቲ ከኔን <char style="nd">ዋቀዮ</char> ዋቅንኬ ሲፍ ኬኔ ንኛተ። <verse eid="DEU 28:53"/><verse number="54" style="v" sid="DEU 28:54"/>ነምን ግዱኬቲ አከ መሌ ገረ ላፌሳፊ ገራሚ ተኤዩ ኦቦሌሰሳቲፍ ዮካን ኒቲሳ ከን ጃለቱፍ ዮካን እጆሌሳ ወረ ሀፈኒፍ ገራ ህንላፉ፤ <verse eid="DEU 28:54"/><verse number="55" style="v" sid="DEU 28:55"/>እን ፎን እጆሌሳ ከን ኛቻ ጅሩራ ጥኖሼሌ ቶኮ እሳኒቲፍዩ ህንኬኑ። ሰበቢ ዽጵነ ዲኖትንኬ ዬሮ መጋላወንኬ ሁንደ መርሰንት ስራን ገአኒቲፍ ወን እሳፍ ሀፌ ከኑመ ቆፋቲ። <verse eid="DEU 28:55"/><verse number="56" style="v" sid="DEU 28:56"/>ኒቲን አርጃፊ ቦንቱን ግዱኬ ጅራቱ ከን ሰበቢ አከ መሌ አርጃፊ ቦንቱ ታቴፍ ሚለ እሼቲን ለፈ ህንቱቅኔዩ ዽርሰሼ ከን ጃለቱት፣ እልመሼቲፊ እንተለሼትሌ ንሀማት፤ <verse eid="DEU 28:56"/><verse number="57" style="v" sid="DEU 28:57"/>እሼን ሆባቲ ገራሼቲ በኡፊ እጆሌ ዴሱሌ ንጅብት። ሰበቢን እሼን ዋን ከነ ጎቱፍስ ዬሮ መርፈማፊ ረክናት፣ ዮሙ ዲኖትንኬ መጋላኬ ኬሰት ስ ዽጵሰንት ዾክስቴ ኛቹፍ ጄቴት።<verse eid="DEU 28:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="DEU 28:58"/>ዮ አት ኦፍ ኤገናዻን ዱቢወን ሴረ ከና ከኔን ክታበ ከነ ኬሰት በሬፈመን ሁንደ ዱካ ቡኡ ዺፍቴ መቃ <char style="nd">ዋቀዮ</char> ዋቀኬቲ ከበጀማፊ ሶዳችሳ ሰነ ሶዳቹ ባቴ፣ <verse eid="DEU 28:58"/><verse number="59" style="v" sid="DEU 28:59"/><char style="nd">ዋቀዮ</char> ስኢፊ ሰኚኬት ዸእቸ ሶዳችሳ፣ በላ ዽጵሳፊ ከን ዬሮ ዼራ ቱሩ፣ ዹኩበ አከ መሌ ሀማፊ ደፌ ህንፈይኔ ንኤርገ። <verse eid="DEU 28:59"/><verse number="60" style="v" sid="DEU 28:60"/>ዹኩቦተ ግብጥ ከኔን አት ሶዳቱስ ስት ፍደ፤ እሳንስ ጭኒነኒ ስት ቀበቱ። <verse eid="DEU 28:60"/><verse number="61" style="v" sid="DEU 28:61"/>አከሱመስ ሀመ አት ዸበምቱት <char style="nd">ዋቀዮ</char> ዹኩቦታፊ ረክኖተ ብራ ከኔን ክታበ ሴራ ከነ ኬሰት ህንበሬፈምን ስት ፍደ። <verse eid="DEU 28:61"/><verse number="62" style="v" sid="DEU 28:62"/>እስን ሰበቢ <char style="nd">ዋቀዮ</char> ዋቀኬሰኒፍ አጀጀሙ ድደኒፍ እስን ወረ አከ ኡርጂወን ሰሚ ባይአተኒ ቱርተን ኬሳ ጥኖቱ ሀፈ። <verse eid="DEU 28:62"/><verse number="63" style="v" sid="DEU 28:63"/>አኩመ እስን ሶሮምሱፊ እስን ባይእሱን <char style="nd">ዋቀዮ</char> ገመቺሱ ሰነ እስን በሌሱፊ እስን በርበዴሱንስ እሰ ገመቺሰ። እስን ብየ ዻሉፍ እት ገልተን ኬሳ ንቡቃቱ።<verse eid="DEU 28:63"/></para>
  <para style="p">
    <verse number="64" style="v" sid="DEU 28:64"/>ኤርገሲስ <char style="nd">ዋቀዮ</char> ዳሪ ለፋ ቶኮራ ሀመ ዳሪ ለፋ ካኒት ሰቦተ ሁንደ ግዱት ስ ብትኔሰ። አት አችት ዋቆተ ብራ፣ ዋቆተ ሙካቲፊ ከን ዸጋ ከኔን አቲፊ አቦቲንኬ ህንቤክን ንዋቄፈተ። <verse eid="DEU 28:64"/><verse number="65" style="v" sid="DEU 28:65"/>አት ሰቦተ ሰነ ግዱት ቦቆና ህንአርገቱ፤ ለፈ ኮጴ ሚለኬቲረ ኬየቱሌ ህንአርገቱ። አችትስ <char style="nd">ዋቀዮ</char> ሰሙ ዽጰቱ፣ እጀ ሀዊዻን ፈጀጁፊ ገራ አብዲ ኩተቱ ሲፍ ኬነ። <verse eid="DEU 28:65"/><verse number="66" style="v" sid="DEU 28:66"/>አት ሀልከኒ ጉያ ሶዳዻን ቀበምቴ ኡቱ ሉቡንኬ ወቢ ህንአርገን፣ ዬሮ ሁንደ ያዶዻን ጅራተ። <verse eid="DEU 28:66"/><verse number="67" style="v" sid="DEU 28:67"/>ሰበቢ ሶዳ ገራኬ ጉቱ ሰናቲፊ ዋን እጀኬቲን አርግቱ ሰናቲፍ ገነመ፣ “ኡቱ በርኡ ባቴ!” ገልገለሞ፣ “ኡቱ ዽኡ ባቴ!” ጄተ። <verse eid="DEU 28:67"/><verse number="68" style="v" sid="DEU 28:68"/>ከራ አን አት ለመተ አስ ህንዴብቱ ሲን ጄዼንስ <char style="nd">ዋቀዮ</char> ዶኒዻን ግብጥት ስ ዴብሰ። አችትስ አከ ገርቦተ ዺራ ዱበርቲት ዲኖተኬሰንት ጉርጉረሙፍ ኦፍ ዽኤስቱ፤ ገሩ ነምን ቶኮዩ እስን ህንብተቱ።<verse eid="DEU 28:68"/></para>
  <chapter eid="DEU 28"/>
  <chapter number="29" style="c" sid="DEU 29"/>
  <para style="s1">ከኩን ሃሮምፈሙሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 29:1"/>ዱቢን ከኩ ከን <char style="nd">ዋቀዮ</char> ከኩ ኮሬብት እሳን ወጅን ገሌ ሰነረት ደበሌ አከ እን ሞኣብ ኬሰት እስራኤሎተ ወጅን ገሉፍ ሙሴ አጀጄ ከናዸ።<verse eid="DEU 29:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="DEU 29:2"/>ሙሴን እስራኤሎተ ሁንደ ወልት ዋሜ አከነ ጄዼን፦</para>
  <para style="b" vid="DEU 29:2"/>
  <para style="p" vid="DEU 29:2">ዋን <char style="nd">ዋቀዮ</char> ግብጥ ኬሰት ፈረኦንረት፣ ቆንዳልቶተሳ ሁንዳፊ ጉቱማ ብየሳረት ሆጄቴ ሁንደ እጅኬሰን አርጌረ። <verse eid="DEU 29:2"/><verse number="3" style="v" sid="DEU 29:3"/>እስን ቆሩምሰወን ጉርጉዳ ሰነ፣ መለቶወኒፊ ድንቂወን ጉርጉዳ ሰነ እጁመኬሰኒን አርግተኒርቱ። <verse eid="DEU 29:3"/><verse number="4" style="v" sid="DEU 29:4"/><char style="nd">ዋቀዮ</char> ገሩ ሀመ ሀርኣት ቀልቢ ሁበቱ ዮካን እጀ አርግቱ ዮካን ጉረ ዸገኡ እስኒ ህንኬንኔ። <verse eid="DEU 29:4"/><verse number="5" style="v" sid="DEU 29:5"/>ዬሮ ወጎተ አፉርተመን አን ገሞጂ ኬሰ እስን ጌጌሴ ሰነት ኡፈትንኬሰን እስንረት ህንዹምኔ ዮካን ኮጴን ሚለኬሰንረት ህንጭጭትኔ። <verse eid="DEU 29:5"/><verse number="6" style="v" sid="DEU 29:6"/>እስን ቡዴነ ህንኛትኔ፤ ዳዺ ወይኒ ዮካን ዹጋቲ ነመ መቼሱ ህንዹግኔ። አን አከ እስን አከ አን <char style="nd">ዋቀዮ</char> ዋቀኬሰን ተኤ ቤክተኒፈን ዋን ከነ ጎዼ።<verse eid="DEU 29:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 29:7"/>ዮሙ እስን አስ ጌሰንት ስሆን ሞቲን ሄሽቦኒፊ ኦግ ሞቲን ባሻን ኑ ሎሉፍ ኑት በአን፤ ኑ ገሩ እሳን ሞአትኔ። <verse eid="DEU 29:7"/><verse number="8" style="v" sid="DEU 29:8"/>ብየሳኒስ ፉዸትኔ ጎሰ ሩቤኒፍ፣ ጎሰ ጋዲፊ ወለካ ጎሰ ምናሴቲፍ ዻለ ጎኔ ኬንኔ።<verse eid="DEU 29:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 29:9"/>እስን አከ ዋን ሆጄተን ሁንዳን ምልኮፍተኒፍ ዱቢወን ከኩ ከና ኦፍ ኤገናዻን ዱካ ቡኣ። <verse eid="DEU 29:9"/><verse number="10" style="v" sid="DEU 29:10"/>ሁንድኬሰን ጄቹንስ ቀጄልችቶትኒፊ ሆገንቶትንኬሰን፣ ማንጉዶትኒፊ ቆንዳልቶትንኬሰን አከሱመስ ነሞትን እስራኤል ከኔን ብራ ሁንድኑ ሀርአ ፉለ <char style="nd">ዋቀዮ</char> ዋቀኬሰኒ ዱረ ዻበተኒርቱ፤ <verse eid="DEU 29:10"/><verse number="11" style="v" sid="DEU 29:11"/>እጆሌንኬሰኒፊ ኒቶትንኬሰን አከሱመስ አለጎን ሙከኬ ጭራ፣ ብሻንኬስ ወራባ ቁበተኬ ኬሰ ጅራተን ስ ወጅን ዻበተኒሩ። <verse eid="DEU 29:11"/><verse number="12" style="v" sid="DEU 29:12"/>አትስ ከኩ <char style="nd">ዋቀዮ</char> ሀርአ ስ ወጅን ገሌ ከካዻን ሲፍ ምርከኔሱ ከነ <char style="nd">ዋቀዮ</char> ዋቀኬ ወጅን ገሉፍ አስ ዻበቴርተ፤ <verse eid="DEU 29:12"/><verse number="13" style="v" sid="DEU 29:13"/>እንስ አኩመ ስ አብደቺሴ አቦቲኬ አብረሃሚፍ፣ ይስሃቂፊ ያቆቢፍ ዋዳ ገሌ ሰነት አከ አት ሰበሳ ታቴ እንስ ዋቀኬ ተኡፍ ጀቤሴ ስ ዻቡፍ ዋን ከነ ጎዼ። <verse eid="DEU 29:13"/><verse number="14" style="v" sid="DEU 29:14"/>አንስ ከኩ ከካዻን ምርከናኤ ከነ እስን ቆፈ ወጅን ኡቱ ህንተእን፣ <verse eid="DEU 29:14"/><verse number="15" style="v" sid="DEU 29:15"/>ወረ ኑ ወጅን አስ ፉለ <char style="nd">ዋቀዮ</char> ዋቀኬኛ ዱረ ዻበተን ወረ ሀርአ አስ ህንጅሬ ወጅንስ ነንገለ።<verse eid="DEU 29:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 29:16"/>አከ ኑ እት ግብጥ ኬሰ ጅራትኔፊ ዮሙ አስ ዹፍኑስ አከ ኑ እት ብዮተ ኬሰ ደበሬ እስን መታን ኬሰኑ ንቤክቱ። <verse eid="DEU 29:16"/><verse number="17" style="v" sid="DEU 29:17"/>እስንስ ግዱሳኒት ፈኪወንሳኒ ጅብሲሶ፣ ዋቆተሳኒ ቶልፈሞ ከኔን ሙከ፣ ዸጋ፣ ሜቲፊ ወርቄራ ሆጄተመን አርግተኒርቱ። <verse eid="DEU 29:17"/><verse number="18" style="v" sid="DEU 29:18"/>አከ ዺር ዮካን ዱበርቲን በልበል ዮካን ጎስት ገራንሳ <char style="nd">ዋቀዮ</char> ዋቀኬኘራ ገረገሌ ዋቆተ ሰቦተ ሰና ፋነ ቡኤ እስን ግዱ ህንጅራትኔ ምርከኔፈዻ፤ አከ ህድ ሱሚ ሀዻኣ አከሲ ባሱ ቶኮዩ እስን ግዱ ህንጅራትኔ ቁልቁሌፈዻ።<verse eid="DEU 29:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 29:19"/>ነምን አከሲ ዮሙ ዱቢ ከኩ ከና ዸገኡት፣ ገራሳት ኦፍ ኤብሴ፣ “አን ዮን አከ ፌዺኮት ዴሜሌ ነጋ ቀበ” ጄዼ ያደ። ኩንሞ ለፈ ጂዻረትስ ተኡ ለፈ ጎጎጋረት በዲሰ ፍደ። <verse eid="DEU 29:19"/><verse number="20" style="v" sid="DEU 29:20"/><char style="nd">ዋቀዮ</char> ነመ ሰናፍ ጎንኩማ ዺፈመ ህንጎዹ፤ ዼከምስሳቲፊ ህናፋንሳ ነምቸ ሰነረት ቦበአ። አባርስ ክታበ ከነ ኬሰት በሬፈሜ ሁንድ እሰ ቀቀበ፤ <char style="nd">ዋቀዮስ</char> ሰሚ ጀላ መቃሳ ንዸበምሲሰ። <verse eid="DEU 29:20"/><verse number="21" style="v" sid="DEU 29:21"/>አኩመ ከኩ አባርሰ ክታበ ሴራ ከነ ኬሰት በሬፈሜ ሁንዳት፣ <char style="nd">ዋቀዮ</char> ጎሶተ እስራኤል ሁንደ ኬሳ በዲሳፍ ኮጳት እሰ ባሰ።<verse eid="DEU 29:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 29:22"/>ዸሎትን እት ኣኑ ጄቹንስ እጆሌንኬሰን ወር እስኒን ዱበ ዹፈን አከሱመስ ኬሱሞትን ብዮተ ፈጎቲ ዹፈን ዸእቸ ጉዳ ብየቲረ ገኤፊ ዹኩበ <char style="nd">ዋቀዮ</char> እቲን እሼ ዸኤ ንአርጉ። <verse eid="DEU 29:22"/><verse number="23" style="v" sid="DEU 29:23"/>ጉቱማን ብየቲ ገሞጂ ጉብዱ ከን ሶግዳፊ ድኚን ጉተምቴ ከን ወን ቶኮዩ እረ ህንዻበምኔ፣ ከን ወን ቶኮዩ እረት ህንብቅሌ፣ ከን ብቅልቱን ቶኮዩ እረት ህንጉደትኔ ታት። በዲስን እሼረ ገኡስ አከ በዲሰ ሶዶሚቲፊ ጎሞራ፣ አድማቲፊ ዜቦኢም ከኔን <char style="nd">ዋቀዮ</char> ዼከምሰ ጉዳዻን እሳን በርበዴሴ ሰና ንተአ። <verse eid="DEU 29:23"/><verse number="24" style="v" sid="DEU 29:24"/>ሰብን ሁንድኑ፣ “<char style="nd">ዋቀዮ</char> ማሊፍ ዋን አከሲ ብየ ከነት ፍዴ? ዼከምስ ሶዳችሳን ቦበኡ ኩንስ ማሊፍ ዹፌ?” ጄዸኒ ጋፈቱ።<verse eid="DEU 29:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DEU 29:25"/>ዴቢንሳስ ከነ ተአ፤ “ኩን ሰበቢ ሰብን ኩን ከኩ <char style="nd">ዋቀዮ</char> ዋቅን አቦቲሳኒ ዬሮ ግብጢ እሳን ባሴት እሳን ወጅን ገሌ ሰነ ዺሰኒፍ። <verse eid="DEU 29:25"/><verse number="26" style="v" sid="DEU 29:26"/>እሳንስ ዸቀኒ ዋቆተ ብራ፣ ከኔን ህንቤክኒፍ ዋቆተ እን እሳኒፍ ህንኬንን ዋቄፈተን፤ ገድ ጄዸኒስ ሰገደኒፍ። <verse eid="DEU 29:26"/><verse number="27" style="v" sid="DEU 29:27"/>ከናፉ ዼከምስ <char style="nd">ዋቀዮ</char> ብየ ከነት ቦበኤ አከ እን አባርሰ ክታበ ከነ ኬሰት በሬፈሜ ሁንደ እት ፍዱ ጎዼ። <verse eid="DEU 29:27"/><verse number="28" style="v" sid="DEU 29:28"/><char style="nd">ዋቀዮስ</char> ኣሪ ሶዳችሳፊ ዼከምሰ ጉዳዻን ብየሳኒቲ እሳን ቡቅሴ፤ አኩመ አመ ጅሩ ከነትስ ብየ ብራት እሳን ደርበቴ።”<verse eid="DEU 29:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="DEU 29:29"/>ወንት ዾክሳን ከን <char style="nd">ዋቀዮ</char> ዋቀኬኛት፤ ከን ሙልእፈሜ ገሩ አከ ኑ ዱቢ ሴረ ከና ሁንደ ኤግኑፍ በረ በራን ከንኬኛፊ ከን እጆሌኬኛት።<verse eid="DEU 29:29"/></para>
  <chapter eid="DEU 29"/>
  <chapter number="30" style="c" sid="DEU 30"/>
  <para style="s1">በዻዹማ ገረ <char style="nd">ዋቀዮት</char> ዴብኡዻን አርገሙ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 30:1"/>ዮሙ ኤቢፊ አባርስ አን ፉለኬ ዱረ ካኤ ኩን ሁንድ ስ አርገቴ አት ሰቦተ <char style="nd">ዋቀዮ</char> ዋቅንኬ ኬሰት ስ ብትኔሱ ሁንደ ግዱ ጅራቱት ዮ አት ዋን ሰነ ያደቱ፣ <verse eid="DEU 30:1"/><verse number="2" style="v" sid="DEU 30:2"/>ዮሙ አቲፊ እጆሌንኬ ገረ <char style="nd">ዋቀዮ</char> ዋቀኬቲት ዴብተኒ አኩመ ዋን አን ሀርአ እስን አጀጁ ሁንዳት ገራኬሰኒፊ ሉቡኬሰን ጉቱዻን እሳፍ አጀጀምተን፣ <verse eid="DEU 30:2"/><verse number="3" style="v" sid="DEU 30:3"/><char style="nd">ዋቀዮ</char> ዋቅንኬ ቦጁኬ ሲፍ ዴብሴ ገራ ሲፍ ላፉዻን ሰቦተ ግዱሳኒት ስ ብትኔሴ ሁንደ ኬሳ ዴብሴ ወልት ስ ቀበ። <verse eid="DEU 30:3"/><verse number="4" style="v" sid="DEU 30:4"/>ዮ አት ሰሚ ጀለት ለፈ አከ መሌ ፈጎት ጌፈምቴ ጅራቴሌ <char style="nd">ዋቀዮ</char> ዋቅንኬ ወልት ስ ቀበ፤ ዴብሴስ ስ ፍደ። <verse eid="DEU 30:4"/><verse number="5" style="v" sid="DEU 30:5"/>እን ብየ አቦቲኬቲት ስ ገልቸ፤ አትስ ንዻልተ። እን አቦቲኬ ጫላ ስ ሶሮምሰ፤ አከ መሌ ስ ባይእሰስ። <verse eid="DEU 30:5"/><verse number="6" style="v" sid="DEU 30:6"/>አከ አት ገራኬ ጉቱዻን፣ ሉቡኬ ጉቱዻን እሰ ጃለቴ ጅራቱፍ <char style="nd">ዋቀዮ</char> ዋቅንኬ ገራኬቲፊ ገራ ሰኚወንኬቲ ዸግነ ንቀበ። <verse eid="DEU 30:6"/><verse number="7" style="v" sid="DEU 30:7"/><char style="nd">ዋቀዮ</char> ዋቅንኬ አባርሰ ከነ ሁንደ ወረ ስ ጅበኒ ስ ረክሰንረ ንካአ። <verse eid="DEU 30:7"/><verse number="8" style="v" sid="DEU 30:8"/>አትስ ዴብቴ <char style="nd">ዋቀዮፍ</char> ንአጀጀምተ፤ አጀጀሳ ከኔን አን ሀርአ ስ አጀጁ ሁንደስ ንኤግደ። <verse eid="DEU 30:8"/><verse number="9" style="v" sid="DEU 30:9"/>ኤርገሲስ <char style="nd">ዋቀዮ</char> ዋቅንኬ ሆጂ ሀርከኬቲ ሁንዳፊ እጆሌ ጉዴደኬቲ በአኒን፣ ጀቦተኬቲፊ ምዻን ለፈ ቆቲሳኬቲቲን ስ ሶሮምሰ። <char style="nd">ዋቀዮ</char> አኩመ አቦቲኬት ገመዴ ሰነ ስትስ ገመዴ ስ ሶሮምሰ፤ <verse eid="DEU 30:9"/><verse number="10" style="v" sid="DEU 30:10"/>ኩንስ ዮ አት <char style="nd">ዋቀዮ</char> ዋቀኬቲፍ አጀጀምቴ አጀጀወኒፊ ቀጄልቸወንሳ ከኔን ክታበ ሴራ ከነ ኬሰት በሬፈመን ኤጉዻን ገራኬ ጉቱፊ ሉቡኬ ጉቱዻን ገረ <char style="nd">ዋቀዮ</char> ዋቀኬቲት ዴብቴ ተአ።<verse eid="DEU 30:10"/></para>
  <para style="s1">ጅሬኘ ዮካን ዱአ ፍለቹ</para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 30:11"/>ወን አን ሀርአ ስ አጀጁ ኩን ረክሳ ዮካን ከን ስራ ፈጋቴ ምት። <verse eid="DEU 30:11"/><verse number="12" style="v" sid="DEU 30:12"/>አከ አት፣ “አከ ኑ ዸጌኜ እሰ ኤግኑፍ ኤኙቱ ገረ ሰሚት ኦል በኤ ፍዴ ኑት ህመ?” ጄቴ ህንጋፈትኔፍ እን ኦል ሰሚ ጉባ ህንጅሩ። <verse eid="DEU 30:12"/><verse number="13" style="v" sid="DEU 30:13"/>ዮካን አከ አት፣ “አከ ኑ ዸጌኜ እሰ ኤግኑፍ ኤኙቱ ገላነ ጬኤ ፍዴ ኑት ህመ?” ጄቴ ህንጋፈትኔፍ እን ገላነ ገመ ህንጅሩ። <verse eid="DEU 30:13"/><verse number="14" style="v" sid="DEU 30:14"/>ዱቢን ሱን ገሩ ባይኤ ስት ዽኦ ጅረ፤ አከ አት እሰ ኤግዱፍስ እን አፋንኬቲፊ ገራኬ ኬሰ ጅረ።<verse eid="DEU 30:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 30:15"/>ኩኖ አን ሀርአ ጅሬኛፊ ኤበ፣ ዱኣፊ በዲሰ ፉለኬ ዱረ ካኤረ። <verse eid="DEU 30:15"/><verse number="16" style="v" sid="DEU 30:16"/>አን አከ አት <char style="nd">ዋቀዮ</char> ዋቀኬ ጃለቱ፣ አከ ከራሳረስ ዴምቱፊ አከ አት አጀጀወንሳ፣ ቀጄልቸወንሳቲፊ ሴረወንሳ ኤግዱ ስ አጀጀ፤ ኤርገሲስ አት ሉቡን ጅራቴ ንባይአተ፤ <char style="nd">ዋቀዮ</char> ዋቅንኬስ ብየ አት ዻሉፍ እት ገልቱት ስ ኤብሰ።<verse eid="DEU 30:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 30:17"/>ገሩ ዮ ያድንኬ ከራራ ጀልአቴ አት አጀጀሙ ባቴ፣ ዮ አት ዋቆተ ካን ዋቄፈቹፊ እሳን ተጃጅሉፍ ጄቴ ፉዸተምቴ፣ <verse eid="DEU 30:17"/><verse number="18" style="v" sid="DEU 30:18"/>አን አከ እስን ዹጉማን በደን ሀርአ እስንትን ህመ። እስን ዮርዳኖስን ጬተኒ ብየ እት ገልተኒ ዻልተን ኬሰስ በረ ዼራ ህንጅራተን።<verse eid="DEU 30:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 30:19"/>አን አከን ጅሬኛፊ ዱአ፣ ኤባፊ አባርሰ ፉለኬ ዱረ ካኤ ጅሩ ሀርአ ሰሚፊ ለፈ ረጋን ጎዼ ስት ዋመ። ኤጋ አቲፊ እጆሌንኬ አከ ጅራተኒፍ ጅሬኘ ፍለዹ፤ <verse eid="DEU 30:19"/><verse number="20" style="v" sid="DEU 30:20"/>ኩንስ አከ አት <char style="nd">ዋቀዮ</char> ዋቀኬ ጃለቱፍ፣ አከ ዱቢሳ ዸጌሴ እሰት መጠንቴ ጅራቱፍ። <char style="nd">ዋቀዮ</char> ሰበቢ ጅሬኘኬ ተኤፍ፣ ብየ አቦቲኬ አብረሃሚፍ፣ ይስሃቂፊ ያቆቢፍ ኬኑፍ ከከቴፍ ሰነ ኬሰት በረ ዼራ ሲፍ ኬነ።<verse eid="DEU 30:20"/></para>
  <chapter eid="DEU 30"/>
  <chapter number="31" style="c" sid="DEU 31"/>
  <para style="s1">እያሱን እዶ ሙሴ ቡኡሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 31:1"/>ኤርገሲስ ሙሴን ዸቄ ዱቢ ከነ እስራኤል ሁንደት ዱበቴ፦ <verse eid="DEU 31:1"/><verse number="2" style="v" sid="DEU 31:2"/>“አን አመ ነመ ወጋ ዽባፊ ድግደማት፤ ስአችስ እስን ሆገኑ ህንደንደኡ። <char style="nd">ዋቀዮ</char>፣ ‘አት ዮርዳኖስ ህንጬቱ’ ናን ጄዼረ። <verse eid="DEU 31:2"/><verse number="3" style="v" sid="DEU 31:3"/><char style="nd">ዋቀዮ</char> ዋቅንኬ መታንሳ ስ ዱረ ንጬአ። እን ሰቦተ ከኔን ፉለኬ ዱራ ንበርበዴሰ፤ አትስ ብየሳኒ ንዻልተ። አኩመ <char style="nd">ዋቀዮ</char> ጄዼት፣ እያሱንስ ስ ዱረ ንጬአ። <verse eid="DEU 31:3"/><verse number="4" style="v" sid="DEU 31:4"/><char style="nd">ዋቀዮ</char> አኩመ ስሆኒፊ ኦግ ሞቶተ አሞሮታ ሰነ ብየሳኒ ወጅን በሌሴ ሰነ እሳን ከኔንስ ንበሌሰ። <verse eid="DEU 31:4"/><verse number="5" style="v" sid="DEU 31:5"/><char style="nd">ዋቀዮ</char> ደበርሴ ሀርከኬሰንት እሳን ኬነ፤ እስንስ ዋን አን እስን አጀጄ ሁንደ እሳን ጎቹ ቀብዱ። <verse eid="DEU 31:5"/><verse number="6" style="v" sid="DEU 31:6"/>ጭማ፤ ጀባዻ። <char style="nd">ዋቀዮ</char> ዋቅንኬሰን እስን ወጅን ዴማቲ እስን ሰበቢሳኒቲፍ ጄተኒ ህንሶዳትና ዮካን ህንርፈትና፤ እን ጎንኩማ እስን ህንዺሱ ዮካን እስን ህንገቱ።”<verse eid="DEU 31:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 31:7"/>ከነረት ሙሴን እያሱ ኦፍት ዋሜ ፉለ እስራኤል ሁንዳ ዱረት አከነ ጄዼን፤ “አት ሰበቢ ብየ <char style="nd">ዋቀዮ</char> እሳኒፍ ኬኑፍ አቦቲሳኒቲፍ ከከቴት ገሉፍ ሰበ ከነ ወጅን ዴምቱፍ ጭም፤ ጀባዹስ፤ ብየቲስ አከ ዻለን ጎዽ። <verse eid="DEU 31:7"/><verse number="8" style="v" sid="DEU 31:8"/><char style="nd">ዋቀዮ</char> መታንሳ ስ ዱረ ንዴመ፤ ስ ወጅንስ ንጅራተ፤ እን ስ ህንዺሱ ዮካን ስ ህንገቱ። ህንሶዳትን፤ አብዲስ ህንኩተትን።”<verse eid="DEU 31:8"/></para>
  <para style="s1">ሴረ ዱብሱ</para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 31:9"/>ሙሴንስ ሴረ ከነ በሬሴ እልማን ሌዊ ከኔን ሉቦተ ተአኒ ታቦተ ከኩ <char style="nd">ዋቀዮ</char> ባተኒፊ ማንጉዶተ እስራኤል ሁንደት ኬኔ። <verse eid="DEU 31:9"/><verse number="10" style="v" sid="DEU 31:10"/>ኤርገሲስ ሙሴን አከነ ጄዼ እሳን አጀጄ፤ “ዹመ ወጋ ቶርበፋት፣ ዬሮ እት ገቲን ዺፈሙት፣ ዬሮ እት አያን ዳሲ አያኔፈሙት፣ <verse eid="DEU 31:10"/><verse number="11" style="v" sid="DEU 31:11"/>ዮሙ እስራኤል ሁንድ ፉለ <char style="nd">ዋቀዮ</char> ዋቀኬቲ ዱረት ሙልአቹፍ ለፈ እን ፍለቱ ዹፈንት አከ እሳን ዸገአኒፍ ፉለሳኒ ዱረት ሴረ ከነ እሳኒ ዱብፍተ። <verse eid="DEU 31:11"/><verse number="12" style="v" sid="DEU 31:12"/>አከ እሳን ዱቢ ሴረ ከና ሁንደ ዸገአኒ <char style="nd">ዋቀዮ</char> ዋቀኬ ሶዳቹ በረተኒፊ ኦፍ ኤገናዻን ፋነ ቡአኒፍ ነሞተ ጄቹንስ ዺሮተ፣ ዱበርቶተ፣ እጆሌፊ አለጎተ መጋላወንኬ ኬሰ ጅራተን ወልት ቀብ። <verse eid="DEU 31:12"/><verse number="13" style="v" sid="DEU 31:13"/>በረ እስን ብየ ዮርዳኖስ ጬተኒ ዻልተን ኬሰ ጅራተን ጉቱ እጆሌንሳኒ ከኔን ሴረ ከነ ህንቤክኔስ ዸገኡፊ <char style="nd">ዋቀዮ</char> ዋቀሳኒ ሶዳቹ በረቹ ቀቡ።”<verse eid="DEU 31:13"/></para>
  <para style="s1">እስራኤል ንፍንጭለ</para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 31:14"/>
    <char style="nd">ዋቀዮ</char> ሙሴዻን፣ “ዬሮን አት ዱቱ ዽኣቴረ። አከ አን ዋን እን ሆጄቹ መሉ እት ህሙፍ እያሱ ዋሚቲ ዱንካነ ወል ገኢ ብረት ዽኣዻ” ጄዼ። ሙሴፊ እያሱንስ ዹፈኒ ዱንካነ ወል ገኢ ዱረት ዽኣተን።<verse eid="DEU 31:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 31:15"/>
    <char style="nd">ዋቀዮ</char> ኡቱባ ዱሜሳቲን ዹፌ ዱንካንቸ ኬሰት ሙልአቴ፤ ዱሜስ ሱንስ በልበለ ዱንካንቻ ዱረ ዻበቴ። <verse eid="DEU 31:15"/><verse number="16" style="v" sid="DEU 31:16"/><char style="nd">ዋቀዮስ</char> ሙሴዻን አከነ ጄዼ፤ “አት አቦቲኬ ወጅን ንቦቆተ፤ ሰብን ኩንሞ ዮሙሱመ ብየ ዻሉፍ እት ገሉት ዋቆተ ነሞተ ኦርማ ዱካ ቡኤ ሰጋገሉ ጀልቀበ። እሳን ነ ዺሰኒ ከኩ አን እሳን ወጅን ገሌ ንጨብሱ። <verse eid="DEU 31:16"/><verse number="17" style="v" sid="DEU 31:17"/>ጋፈስ አን እሳንት ኣሬ እሳን ነንዺሰ፤ ፉለኮስ እሳን ዱራ ነንዾክሰ፤ እሳንስ ንበርበዴፈሙ። በዲሳፊ ረኮ ባይኤቱ እሳንት ዹፈ፤ እሳንስ ጋፈስ፣ ‘በዲስን ኩን ዋን ዋቅንኬኘ ኑ ወጅን ህንጅሬፍ ኑት ዹፌ ምቲ?’ ጄዸኒ ጋፈቱ። <verse eid="DEU 31:17"/><verse number="18" style="v" sid="DEU 31:18"/>ዋን እሳን ገረ ዋቆተ ብራት ገረገለኒፍ አን ሰበቢ ሀምነሳኒ ሁንዳቲፍ ጉቱማን ጉቱት ፉለኮ እሳን ዱራ ነንዾክፈዸ።<verse eid="DEU 31:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 31:19"/>“አከ እሳንት ረጋ ና ተኡፍ፣ ፋርፈትና ከነ በሬፈዹቲ አከ እሳን ፋርፈተኒፍ እስራኤሎተ በርሲስ። <verse eid="DEU 31:19"/><verse number="20" style="v" sid="DEU 31:20"/>ዮሙ አን ብየ ኣነኒፊ ደም ኬሳ ቡርቁ ከን አን አቦቲሳኒቲፍ ከኩዻን ዋዳ ገሌት እሳን ፍዱት እሳን ኛተኒ ቁፈኒ ነራ ገረገሉዻን ዋቆተ ብራ ዋቄፈቱ፤ ነ ዺሰኒስ ከኩኮ ንጨብሱ። <verse eid="DEU 31:20"/><verse number="21" style="v" sid="DEU 31:21"/>ፋርፈናን ኩንስ ዮሙ በዲስኒፊ ረክን እሳንት ዹፉት ረጋ እሳንት ተአ፤ ኩን ሰኚሳኒ ኬሰት ህንእራንፈተሙቲ። አን ኡቱ ብየ ከኩዻን ዋዳሳኒ ገሌት እሳን ህንፍድንዩ ዋን እሳን ጎቹፍ ያደን ነንቤካቲ።” <verse eid="DEU 31:21"/><verse number="22" style="v" sid="DEU 31:22"/>ከናፉ ሙሴን ጋፈስ ፋርፈትና ከነ በሬሴ እስራኤሎተ በርሲሴ።<verse eid="DEU 31:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 31:23"/>
    <char style="nd">ዋቀዮስ</char> እያሱ እልመ ኑኒቲፍ አጀጀ፣ “አት ሰበቢ ብየ አን ከኩዻን ዋዳሳኒ ገሌት እስራኤሎተ ገልችቱፍ ጭም፣ ጀባዹ፤ አን መታንኮ ስ ወጅን ጅራ” ጄዹ ኬኔ።<verse eid="DEU 31:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="DEU 31:24"/>ሙሴን ኤርገ ዱቢ ሴረ ከና ጀልቀባ ሀመ ዹማት ክታበረት በሬሴ ፍጤ ቦዴ፣ <verse eid="DEU 31:24"/><verse number="25" style="v" sid="DEU 31:25"/>ሌዎተ ታቦተ ከኩ <char style="nd">ዋቀዮ</char> ባተኒፍ አጀጀ ከነ ኬኔ፦ <verse eid="DEU 31:25"/><verse number="26" style="v" sid="DEU 31:26"/>“ክታበ ሴራ ከነ ፉዹቲ ታቦተ ከኩ <char style="nd">ዋቀዮ</char> ዋቀኬቲ ብረ ካእ። ኩንስ አከ እን አቹመ ታኤ ረጋ እስንት ተኡፍ። <verse eid="DEU 31:26"/><verse number="27" style="v" sid="DEU 31:27"/>አን አከ እስን ፍንጭልቶታፊ መተ ጀቤዪ ታተን ነንቤካቲ። እስን ዮ ኡቱመ አን ጅሩ <char style="nd">ዋቀዮት</char> ፍንጭልተን፣ ኤርገ አን ዱኤ ቦዴሞ ሀመም ጫላ ሃፍንጭልተን ሬ! <verse eid="DEU 31:27"/><verse number="28" style="v" sid="DEU 31:28"/>አከ አን አከ እሳን ዸገአኒፍ ዱቢ ከነ እሳንት ህሜ አከ እሳንት ረጋ ተኡፍ ሰሚፊ ለፈ ዋመቹ ደንደኡፍ ማንጉዶተ ጎሶተኬሰኒ ሁንዳፊ ቆንዳልቶተኬሰን ሁንደ ፉለኮ ዱረት ወልት ቀባ። <verse eid="DEU 31:28"/><verse number="29" style="v" sid="DEU 31:29"/>አን አከ እስን ኤርገ አን ዱኤ ቦዴ ጉቱማን ጉቱት ጡሮፍተኒ አጀጀ አን እስኒ ኬኔራ ገረገልተን ነንቤካቲ። በሮተ ዹፉፍ ጅረን ኬሰ ረክን እስንት ዹፈ፤ እስን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዋን ሀማ ሆጄተኒ ሆጂዹመ ሀርከኬሰኒቲን ዼከምሳፍ እሰ ከካፍቱቲ።”<verse eid="DEU 31:29"/></para>
  <para style="s1">ፋርፈትና ሙሴ</para>
  <para style="p">
    <verse number="30" style="v" sid="DEU 31:30"/>ሙሴንስ ጀልቀባ ሀመ ዹማት ዱቢ ፋርፈትና ከና ጉቱማ ወልዳ እስራኤልት አከነ ጄዼ ዸጌስሴ፦<verse eid="DEU 31:30"/></para>
  <chapter eid="DEU 31"/>
  <chapter number="32" style="c" sid="DEU 32"/>
  <para style="q1">
    <verse number="1" style="v" sid="DEU 32:1"/>ያ ሰሚወን፣ ዸገኣ፤ አን ነንዱበዸ፤</para>
  <para style="q2" vid="DEU 32:1">ያ ለፈ፣ አትስ ዱቢ አፋንኮቲ ዸገእ።<verse eid="DEU 32:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="DEU 32:2"/>በርሲስንኮ አከ ቦካ ሃሮቡ፤</para>
  <para style="q2" vid="DEU 32:2">ዱቢንኮስ አከ ፍጤንሳ ገድ ሃጮጮጱ፤</para>
  <para style="q1" vid="DEU 32:2">መርገረት አከ ቲፉ፣</para>
  <para style="q2" vid="DEU 32:2">ብቅልቱ ጮርቃረትስ አከ ቦካ ጉዳ ሃሮቡ።<verse eid="DEU 32:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="DEU 32:3"/>አን መቃ <char style="nd">ዋቀዮ</char> ነንለብሰ።</para>
  <para style="q2" vid="DEU 32:3">ጉድነ ዋቀኬኛ ጀጀዻ!<verse eid="DEU 32:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="DEU 32:4"/>እን ከታዸ፤ ሆጂንሳ ሙዳ ህንቀቡ፤</para>
  <para style="q2" vid="DEU 32:4">ዳንዲወንሳ ሁንድኑስ ቀጄላዸ።</para>
  <para style="q1" vid="DEU 32:4">እን ዋቀ አመነማ ህንዶጎጎሬ፣</para>
  <para style="q2" vid="DEU 32:4">ቶላፊ ቀጄላዸ።<verse eid="DEU 32:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="DEU 32:5"/>እሳን ሀምነ እሰት ሆጄተኒሩ፤</para>
  <para style="q2" vid="DEU 32:5">ስአች እሳን ሰበቢ ቃኒሳኒቲፍ እጆሌሳ ምት፤</para>
  <para style="q2" vid="DEU 32:5">እሳን ዸሎተ ጀልኣፊ ምጪረማዸ።<verse eid="DEU 32:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="DEU 32:6"/>ያ ሰበ ጎዋ፣ ከን ኦጉማ ህንቀብኔ፣</para>
  <para style="q2" vid="DEU 32:6">አት አከስት <char style="nd">ዋቀዮፍ</char> ዴቢ ኬንታ?</para>
  <para style="q1" vid="DEU 32:6">እን አባኬ፣ ኡማኬ፣</para>
  <para style="q2" vid="DEU 32:6">ከን ስ ሆጄቴፊ ስ ቶልቼ ምቲ?<verse eid="DEU 32:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="DEU 32:7"/>በሮተ ዱሪ ያደዹ፤</para>
  <para style="q2" vid="DEU 32:7">ዸሎተ ደርቤሌ ቀልቤፈዹ።</para>
  <para style="q1" vid="DEU 32:7">እን ሲፍ እብሳቲ አባኬ ጋፈዹ፤</para>
  <para style="q2" vid="DEU 32:7">ማንጉዶተኬስ ጋፈዹ፤ እሳን ስት ህሙቲ።<verse eid="DEU 32:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="DEU 32:8"/>ዋቅን ዋን ሁንዳ ኦሊ ዮሙ ሰቦታፍ ዻለ እሳኒፍ ኬኔት፣</para>
  <para style="q2" vid="DEU 32:8">ዮሙ ሰኚ ነማስ ገርገር ቆቆዴት፣</para>
  <para style="q1" vid="DEU 32:8">አኩመ ባይእነ እልማን እስራኤልት</para>
  <para style="q2" vid="DEU 32:8">ነሞታፍ ዳሪ ዻቤ።<verse eid="DEU 32:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="DEU 32:9"/>ቆድን <char style="nd">ዋቀዮ</char> ሰበሳት፤</para>
  <para style="q2" vid="DEU 32:9">ያቆብሞ ዻለ ዹንፋሳት።<verse eid="DEU 32:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="DEU 32:10"/>እን ለፈ ገሞጂ፣ ለፈ ኦናቲፊ</para>
  <para style="q2" vid="DEU 32:10">ገሞጂ ነመ ጉቡ ኬሰት እሰ አርገቴ።</para>
  <para style="q1" vid="DEU 32:10">እን ጋቸነ ተኤፊ እሰ ኤጌ፤</para>
  <para style="q2" vid="DEU 32:10">አከ ቀሮ እጀ እሳትስ እሰ ኤጌ፤<verse eid="DEU 32:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="DEU 32:11"/>አኩመ ርሳን መነሼ ዲግዴ</para>
  <para style="q2" vid="DEU 32:11">እልማንሼረ ቆቾ ቀብዱ፣</para>
  <para style="q1" vid="DEU 32:11">አኩመ ቆቾሼ በልእፍቴ ኦል እሳን ፉዸቱ፣</para>
  <para style="q2" vid="DEU 32:11">አኩመ ቆቾ እሼቲንስ እሳን ባቱ ሰነ፣<verse eid="DEU 32:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="DEU 32:12"/>
    <char style="nd">ዋቀዮ</char> ቆፈቱ እሰ ጌጌሴ፤</para>
  <para style="q2" vid="DEU 32:12">ዋቅን ኦርማ ቶኮዩ እሰ ወጅን ህንቱሬ።<verse eid="DEU 32:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="DEU 32:13"/>እን ለፈ ኦል ከኣረ እሰ ቡራቅስሴ፤</para>
  <para style="q2" vid="DEU 32:13">ምዻን ለፈ ቆቲሳ እሰ ሶሬ።</para>
  <para style="q1" vid="DEU 32:13">ከታ ኬሳ ደመ እሰ ኛችሴ፤</para>
  <para style="q2" vid="DEU 32:13">ዸጋ ጉራቸ ኬሳሞ ዘይቲ ኬኔፍ፤<verse eid="DEU 32:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="DEU 32:14"/>ዸዻፊ ኣነን ሳወኒፊ ቡሻዬ፣</para>
  <para style="q2" vid="DEU 32:14">ጦባላወኒፊ ሬኦተ ጮመን፣</para>
  <para style="q1" vid="DEU 32:14">ኮርቤዪ ሆላ ፍለተሞ ባሻን፣</para>
  <para style="q2" vid="DEU 32:14">እጀ ቀመዲ ጋሪስ እሰ ሶሬ።</para>
  <para style="q1" vid="DEU 32:14">አት ጩንፋ ዺገ ወይኒ ቁልቁሉስ ንዹግዴ።<verse eid="DEU 32:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="DEU 32:15"/>ይሹሩን ንገበቴ፤ ንዺቴ፤</para>
  <para style="q2" vid="DEU 32:15">ኛቴ ቁፌ፤ ንኡልፋቴ፤ ንጩሉሉቄ።</para>
  <para style="q1" vid="DEU 32:15">ዋቀ እሰ ኡሜ ንዺሴ፤</para>
  <para style="q2" vid="DEU 32:15">ከታ ፈይሳሳ ተኤስ ንቱፈቴ።<verse eid="DEU 32:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="DEU 32:16"/>እሳን ዋቆተ ኦርማቲን እሰ ህናፍስሰን፤</para>
  <para style="q2" vid="DEU 32:16">ዋቆተ ጅብሲሶ እሳኒቲንስ እሰ ዼከምሲሰን።<verse eid="DEU 32:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="DEU 32:17"/>እሳን ሀፉሮተ ሀሞ ዋቀ ህንተእኒፍ፣</para>
  <para style="q2" vid="DEU 32:17">ዋቆተ ህንቤክኒፍ፣</para>
  <para style="q2" vid="DEU 32:17">ዋቆተ ሬፉ ዹፈኒፍ፣</para>
  <para style="q2" vid="DEU 32:17">ዋቆተ አቦቲንኬሰን ህንሶዳቲኒፍ ኣርሳ ዽኤሰን።<verse eid="DEU 32:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="DEU 32:18"/>አት ከታ ስ ዸልቼ ገንቴ፤</para>
  <para style="q2" vid="DEU 32:18">ዋቀ ስ ኡሜ እራንፈቴ።<verse eid="DEU 32:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="DEU 32:19"/>
    <char style="nd">ዋቀዮ</char> ዋን ከነ አርጌ እሳን ቱፈቴ፤</para>
  <para style="q2" vid="DEU 32:19">እን እልማኒፊ እንተለን ኦፊሳት ኣሬራቲ።<verse eid="DEU 32:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="DEU 32:20"/>እንስ፣ “አን ፉለኮ እሳን ዱራ ነንዾክፈዸ፤</para>
  <para style="q2" vid="DEU 32:20">ዹመሳኒስ ነንአርገ” ጄዼ፤</para>
  <para style="q1" vid="DEU 32:20">እሳን ዸሎተ ጀልኣ፣</para>
  <para style="q2" vid="DEU 32:20">እጆሌ ህንአመነምኔዻቲ።<verse eid="DEU 32:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="DEU 32:21"/>እሳን ዋን ዋቀ ህንተእኒን ነ ህናፍስሰን፤</para>
  <para style="q2" vid="DEU 32:21">ዋቆተ ቶልፈሞሳኒ ከኔን ፋይዳ ህንቀብኔንስ ነ ኣርሰን።</para>
  <para style="q1" vid="DEU 32:21">አንስ ወረ ሰበ ህንተእኒን አከ እሳን ህናፈን ነንጎዸ፤</para>
  <para style="q2" vid="DEU 32:21">ሰበ ሁበትና ህንቀብኔንስ እሳን ነንኣርሰ።<verse eid="DEU 32:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="DEU 32:22"/>ዼከምሰኮቲን እብድ ቀብሲፈሜራቲ፤</para>
  <para style="q2" vid="DEU 32:22">እንስ ሀመ ሲኦልት ገድ ዽዽሜ ንቦበአ።</para>
  <para style="q1" vid="DEU 32:22">ለፋፊ ዋን እሼን ባፍቱ ንኛተ፤</para>
  <para style="q2" vid="DEU 32:22">ሁንዴ ቱሉወኒትሌ እብደ ቀብሲሰ።<verse eid="DEU 32:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="DEU 32:23"/>“አን ዋን ሀማ እሳንረ ነንቱለ፤</para>
  <para style="q2" vid="DEU 32:23">ጥየኮስ እሳንት ነንፍጠዸ።<verse eid="DEU 32:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="DEU 32:24"/>ቤለ ሀማ፣ ጎልፋ ኛቴ ነመ ፍጡፊ</para>
  <para style="q2" vid="DEU 32:24">ዸእቸ እሳንት ነንኤርገ፤</para>
  <para style="q1" vid="DEU 32:24">እልካን ብኔንሳ ቀረማሳ፣</para>
  <para style="q2" vid="DEU 32:24">ሀዻ ቡቲ ለፈረ ሎቱስ እሳንት ነንኤርገ።<verse eid="DEU 32:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="DEU 32:25"/>ከራ ጉዳረት ጎራዴን ወረ እጆሌ ህንቀብኔ እሳን ጎዸ፤</para>
  <para style="q2" vid="DEU 32:25">መነሳኒት ሶዳቱ ሞአ።</para>
  <para style="q1" vid="DEU 32:25">ደርገጎትኒፊ ደርገጌቲወን፣</para>
  <para style="q2" vid="DEU 32:25">ዳእመኒፊ ማንጉዶትን ንዹሙ።<verse eid="DEU 32:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="DEU 32:26"/>አንስ እሳን ነንብትኔሰ፤</para>
  <para style="q2" vid="DEU 32:26">ያደኖሳኒስ ሰኚ ነማ ኬሳ ነንበሌሰ።<verse eid="DEU 32:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="DEU 32:27"/>ገሩ አከ ዲኖትንሳኒ ኦፍ ቱለኒ፣</para>
  <para style="q2" vid="DEU 32:27">‘ሀርከኬኘቱ ሞአቴ መሌ፣</para>
  <para style="q1" vid="DEU 32:27">
    <char style="nd">ዋቀዮ</char> ዋን ከነ ሁንደ ህንጎኔ’ ህንጄኔ፣</para>
  <para style="q2" vid="DEU 32:27">አን ዻደትኖ ዲና ሶዳዼረ።”<verse eid="DEU 32:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="DEU 32:28"/>እሳን ሰበ ቀልቢ ህንቀብኔ፣</para>
  <para style="q2" vid="DEU 32:28">ከን ሁበትና ቶኮሌ ህንቀብኔዸ።<verse eid="DEU 32:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="DEU 32:29"/>እሳን ኡቱ ኦጌዪ ተአኒ ዋን ከነ ሁበተኒ</para>
  <para style="q2" vid="DEU 32:29">ስላ ዹመሳኒ ንቤኩ ቱረን!<verse eid="DEU 32:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="DEU 32:30"/>ዮ ከታንሳኒ እሳን ጉርጉሬ መሌ፣</para>
  <para style="q2" vid="DEU 32:30">ዮ <char style="nd">ዋቀዮ</char> ደበርሴ እሳን ኬኔ መሌ፣</para>
  <para style="q1" vid="DEU 32:30">አከምት ነምን ቶኮ ነመ ኩመ ቶኮ</para>
  <para style="q2" vid="DEU 32:30">ዮካን ነምን ለመ ነመ ኩመ ኩዸን ጉግሰ?<verse eid="DEU 32:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="DEU 32:31"/>ከታንሳኒ አከ ከታኬኛ ምት፤</para>
  <para style="q2" vid="DEU 32:31">ከነሞ ዲኖትንኬኘዩ ህንገነን።<verse eid="DEU 32:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="DEU 32:32"/>ወይኒንሳኒ ወይኒ ሶዶሚቲፊ</para>
  <para style="q2" vid="DEU 32:32">ለፈ ቆቲሳ ጎሞራራ ዹፈ።</para>
  <para style="q1" vid="DEU 32:32">እጅ ወይኒሳኒ ሱሚዻን፣</para>
  <para style="q2" vid="DEU 32:32">ሁርቡንሳኒስ ዋን ሀዻኡን ጉተሜረ።<verse eid="DEU 32:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="DEU 32:33"/>ወይኒንሳኒ ሀዻ ቦፋ፣</para>
  <para style="q2" vid="DEU 32:33">ሱሚ ቦፈ ሀዻንሳ ነመ አጄሱት።<verse eid="DEU 32:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="DEU 32:34"/>“ኩን ዋን ነ ብረት ኤገሜ፣</para>
  <para style="q2" vid="DEU 32:34">ከን ገልሜኮ ኬሰትስ ቻፓዻን ጩፈሜ ምቲ?<verse eid="DEU 32:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="DEU 32:35"/>ሃሎ ባሱን ከንኮት፤ አን ገቲ ነንዴብሰ።</para>
  <para style="q2" vid="DEU 32:35">ዬሮሳት ሚልሳኒ ንሙጩጫተ፤</para>
  <para style="q1" vid="DEU 32:35">ጉያን በዲሰሳኒ ዽኣቴረ፤</para>
  <para style="q2" vid="DEU 32:35">በዲስንሳኒስ እሳንት አሪፈቴረ።”<verse eid="DEU 32:35"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="36" style="v" sid="DEU 32:36"/>
    <char style="nd">ዋቀዮ</char> ዮሙ አከ እሳን ሁምነ ዸበን፣</para>
  <para style="q2" vid="DEU 32:36">አከ ገርብችስ ተኡ ነምን ብርመዱን ቶኮዩ ህንሀፍኔ አርጉት፣</para>
  <para style="q1" vid="DEU 32:36">ሰበሳቲፍ ንሙርቴሰ፤</para>
  <para style="q2" vid="DEU 32:36">ተጃጅልቶተሳቲፍስ ገራ ላፈ።<verse eid="DEU 32:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="DEU 32:37"/>እንስ አከነ ጄዸ፦ “ከታን እሳን እት ደአተን፣</para>
  <para style="q2" vid="DEU 32:37">ዋቆትን ቶልፈሞንሳኒ አመ ኤሰ ጅሩ?<verse eid="DEU 32:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="DEU 32:38"/>ዋቆትን ጮመ ቀልመሳኒ ኛተን፣</para>
  <para style="q2" vid="DEU 32:38">ከኔን ዽባዩ ዳዺ ወይኒሳኒ ዹገንስ ኤሰ ጅሩ?</para>
  <para style="q1" vid="DEU 32:38">ሜ ከአኒ እሳን ሃገርጋረን!</para>
  <para style="q2" vid="DEU 32:38">ሜ ደአትኖ ሃኬነኒፍ!<verse eid="DEU 32:38"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="39" style="v" sid="DEU 32:39"/>“አከ አን መታንኮ እሰ ተኤ ቤካ!</para>
  <para style="q2" vid="DEU 32:39">አነ መሌ ዋቅን ብራ ህንጅሩ።</para>
  <para style="q1" vid="DEU 32:39">አን ነንአጄሰ፤ ነንጅራችሰስ፤</para>
  <para style="q2" vid="DEU 32:39">ነንመዴሰ፤ ነንፈይሰስ፤</para>
  <para style="q2" vid="DEU 32:39">ነምን ሀርከኮቲ ባሱ ደንደኡ ቶኮዩ ህንጅሩ።<verse eid="DEU 32:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="DEU 32:40"/>አን ዹጉማን በረ በራን ጅራታዻቲ</para>
  <para style="q2" vid="DEU 32:40">ሀርከኮ ሰሚት ኦል ቀቤ ነንከከዸ፤<verse eid="DEU 32:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="DEU 32:41"/>አን ዮሙን ጎራዴኮ ጨለቅሳ ቀረዼ</para>
  <para style="q2" vid="DEU 32:41">ሀርክኮ ሙርቲዻፍ እሰ ቀበቱት፣</para>
  <para style="q1" vid="DEU 32:41">አን ዲኖተኮ ሃሎ ነንበአ፤</para>
  <para style="q2" vid="DEU 32:41">ወረ ነ ጅበኒፍሌ ዋን እሳኒፍ መሉ ነንኬነ።<verse eid="DEU 32:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="DEU 32:42"/>ዮሙ ጎራዴንኮ ፎን ኛቱት፣</para>
  <para style="q2" vid="DEU 32:42">አን አከ ጥይኮ ዺጋን መቻኡ ነንጎዸ፤</para>
  <para style="q1" vid="DEU 32:42">ዺግን ሱንስ ዺገ ወረ ቀለመኒቲፊ ቦጅአመኒ</para>
  <para style="q2" vid="DEU 32:42">ከን መታ ሆገንቶተ ዲናት።”<verse eid="DEU 32:42"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="43" style="v" sid="DEU 32:43"/>ሰበቢ እን ሃሎ ዺገ ተጃጅልቶተሳ በኡፍ፣</para>
  <para style="q2" vid="DEU 32:43">ያ ሰቦታ፣ ነሞተሳ ወጅን ገመዳ።</para>
  <para style="q1" vid="DEU 32:43">እን ዲኖተሳ ሃሎ በአ፤</para>
  <para style="q2" vid="DEU 32:43">ብያፊ ሰበሳቲፍ አራረ ንቡሰ።<verse eid="DEU 32:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="DEU 32:44"/>ሙሴንስ እያሱ እልመ ኑን ወጅን ዹፌ ዱቢወን ፋርፈትና ከነ ሁንደ ነሞተ ዸጌስሴ። <verse eid="DEU 32:44"/><verse number="45" style="v" sid="DEU 32:45"/>እንስ ዮሙ ዱቢወን ከኔን ሁንደ እስራኤሎተ ሁንደት ዱበቴ ፍጤት፣ <verse eid="DEU 32:45"/><verse number="46" style="v" sid="DEU 32:46"/>አከነ እሳኒን ጄዼ፤ “አከ እሳን ዱቢወን ሴረ ከና ሁንደ ኦፍ ኤገናዻን ኤገኒፍ አከ እስን እጆሌኬሰን አጀጀን፣ ዱቢወን አን ሀርአ እፈ ባሴ እስንት ህሙ ሁንደ ቀልቢት ቀበዻ። <verse eid="DEU 32:46"/><verse number="47" style="v" sid="DEU 32:47"/>እሳን እስኒፍ ጅሬኘ መሌ ዱቢ ፋይዳ ህንቀብኔ ምት። ዱቢወን ከናን ብየ ለገ ዮርዳኖስ ጬተኒ ዻልተን ኬሰ በረ ዼራ ንጅራቱ።”<verse eid="DEU 32:47"/></para>
  <para style="s1">ሙሴን ቱሉ ኔቦረት ዱኡሳ</para>
  <para style="p">
    <verse number="48" style="v" sid="DEU 32:48"/>ጋፈሱመ <char style="nd">ዋቀዮ</char> አከነ ጄዼ ሙሴት ህሜ፤ <verse eid="DEU 32:48"/><verse number="49" style="v" sid="DEU 32:49"/>“ብየ ሞኣብ ከን ፉሌ ዬርኮ ጅሩ፣ ቱሉወን አባሪም ኬሰ ቱሉ ኔቦት ኦል በኢቲ ብየ ከነኣን፣ ብየ አን እስራኤሎታፍ ዻለ ጎዼ ኬኑ ፉሌት እላል። <verse eid="DEU 32:49"/><verse number="50" style="v" sid="DEU 32:50"/>አኩመ ኦቦሌስኬ አሮን ቱሉ ሆርረት ዱኤ ገረ አቦቲሳት ወልት ቀበሜ ሰነ፣ አትስ ቱሉ ያበቱ ሰነረት ንዱተ፤ ገረ አቦቲኬቲትስ ወልት ቀበምተ። <verse eid="DEU 32:50"/><verse number="51" style="v" sid="DEU 32:51"/>ኩንስ ዋን እስን ለማኑ ገሞጂ ሲን፣ ቃዴሽ ኬሰት ብሻን መሪባ ብረት ፉለ እስራኤሎታ ዱረት ነ አመኑ ድደኒፊ ሰበቢ እስራኤሎተ ግዱት ቁልቁሉማኮ ህንኤግኒፍ። <verse eid="DEU 32:51"/><verse number="52" style="v" sid="DEU 32:52"/>ከናፉ አት ፈጎት አርግተ መሌ ብየ አን እስራኤሎታፍ ኬኑ ሰነት ህንገልቱ።”<verse eid="DEU 32:52"/></para>
  <chapter eid="DEU 32"/>
  <chapter number="33" style="c" sid="DEU 33"/>
  <para style="s1">ሙሴን ጎሶተ እስራኤል ኤብሱሳ</para>
  <para style="r">
    <ref loc="DEU 33:1-29">33፥1‑29</ref> ኩወእ – <char style="xt"><ref loc="GEN 49:1-28">ኡመ 49፥1‑28</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 33:1"/>ኤብ ሙሴን ነምን ዋቃ ሱን ኡቱ ህንዱእን ዱረ እቲን እስራኤሎተ ኤብሴ ከነ፤ <verse eid="DEU 33:1"/><verse number="2" style="v" sid="DEU 33:2"/>እንስ አከነ ጄዼ፦</para>
  <para style="q1" vid="DEU 33:2">“<char style="nd">ዋቀዮ</char> ቱሉ ሲናራ ዹፌ፤</para>
  <para style="q2" vid="DEU 33:2">እሳንረትስ ሴኢርራ አከ አዱ ገነማት በኤ፤</para>
  <para style="q2" vid="DEU 33:2">ቱሉ ጳራንራ እሳን ኤብሴ።</para>
  <para style="q1" vid="DEU 33:2">እን ቁልቁሎተሳ ኩማተመ ወጅን ዹፌ፤</para>
  <para style="q2" vid="DEU 33:2">ከራ ሀርከሳ ምርጋቲን እብደ ቦበኡቱ በኤ።<verse eid="DEU 33:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="DEU 33:3"/>ዹጉማን ስቱ ሰበ ጃለተ፤</para>
  <para style="q2" vid="DEU 33:3">ቁልቁሎትን ሁንድኑ ሀርከኬ ኬሰ ጅሩ።</para>
  <para style="q1" vid="DEU 33:3">ሁንድሳኒ ሚለኬ ጀለት ኩፉ፤</para>
  <para style="q2" vid="DEU 33:3">ቀጄልፈመስ ስራ አርገቱ፤<verse eid="DEU 33:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="DEU 33:4"/>ሙሴን ሴረ ኑ ኬኔረ፤</para>
  <para style="q2" vid="DEU 33:4">ኩንስ ዻለ ወልዳ ያቆብ።<verse eid="DEU 33:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="DEU 33:5"/>ዬሮ ሆገንቶትን ሰባ</para>
  <para style="q2" vid="DEU 33:5">ጎሶተ እስራኤል ወጅን ወልት ቀበመንት</para>
  <para style="q2" vid="DEU 33:5">እን ይሹሩንረት ሞቲ ቱሬ።<verse eid="DEU 33:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="DEU 33:6"/>“ሩቤን ሃጅራቱ መሌ ህንዱእን፤</para>
  <para style="q2" vid="DEU 33:6">ዮካን ባይእን ነሞተሳ ህንጥናትን።”<verse eid="DEU 33:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 33:7"/>ዋኤ ይሁዳስ አከነ ጄዼ፦</para>
  <para style="q1" vid="DEU 33:7">“ያ <char style="nd">ዋቀዮ</char>፣ እየ ይሁዳ ዸገእ፤</para>
  <para style="q2" vid="DEU 33:7">ገረ ሰበ እሳትስ እሰ ፍድ።</para>
  <para style="q1" vid="DEU 33:7">እን ሀርከ ኦፊሳቲን ኦፍ ሃኤጉ።</para>
  <para style="q2" vid="DEU 33:7">ዮሙ እን ዲኖተሳቲን ወል ሎሉት ገርጋራሳ ተእ!”<verse eid="DEU 33:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 33:8"/>እን ዋኤ ሌዊስ አከነ ጄዼ፦</para>
  <para style="q1" vid="DEU 33:8">“ቱሚሚፊ ኡሪሚንኬ</para>
  <para style="q2" vid="DEU 33:8">ተጃጅላኬ አመነማዻፍ ሃተኡ።</para>
  <para style="q1" vid="DEU 33:8">አት ለፈ ማሳህ ጄዸሙት እሰ ቆርቴ፤</para>
  <para style="q2" vid="DEU 33:8">ብሻን መሪባረት እሰ ሎልቴ።<verse eid="DEU 33:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="DEU 33:9"/>ዋኤ አባፊ ሃዸሳስ፣</para>
  <para style="q2" vid="DEU 33:9">‘አን እሰ ህንአርግኔ’ ጄዼ።</para>
  <para style="q1" vid="DEU 33:9">እን ኦቦሎተሳ አዳን ህንባፈትኔ፤</para>
  <para style="q2" vid="DEU 33:9">እጆሌሳስ ህንቤክኔ፤</para>
  <para style="q1" vid="DEU 33:9">እሳን ዱቢኬቲፍ አጀጀመኒ</para>
  <para style="q2" vid="DEU 33:9">ከኩኬ ኤገኒሩቲ።<verse eid="DEU 33:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="DEU 33:10"/>እን አጀጀኬ ያቆብን፣</para>
  <para style="q2" vid="DEU 33:10">ሴረ ኬሞ እስራኤልን ንበርሲሰ።</para>
  <para style="q1" vid="DEU 33:10">ፉለኬ ዱረት እጣነ፣</para>
  <para style="q2" vid="DEU 33:10">እዶ ኣርሳኬቲረትሌ ኣርሳ ጉበሙ ጉቱ ንዽኤሰ።<verse eid="DEU 33:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="DEU 33:11"/>ያ <char style="nd">ዋቀዮ</char>፣ ኦጉማሳ ሁንደ ኤብሲፍ፤</para>
  <para style="q2" vid="DEU 33:11">ዋን ሀርክሳ ሆጄቱትስ ገመድ።</para>
  <para style="q1" vid="DEU 33:11">ሞኦ ወረ እሰት ከአኒ ጨብስ፤</para>
  <para style="q2" vid="DEU 33:11">አከ እሳን ለመተ ህንካኔ ጎዺቲ ዲኖተሳ ዸእ።”<verse eid="DEU 33:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 33:12"/>ዋኤ ቤንያም አከነ ጄዼ፦</para>
  <para style="q1" vid="DEU 33:12">“ነምን <char style="nd">ዋቀዮ</char> እሰ ጃለቱ ኤጉምሰሳቲን ነጋን ሃጅራቱ፤</para>
  <para style="q2" vid="DEU 33:12">እን ጉያ ጉቱ እሰ ኤጋቲ፤</para>
  <para style="q2" vid="DEU 33:12">ነምን <char style="nd">ዋቀዮ</char> እሰ ጃለቱ ገቲቲሳ ግዱ ቦቆተ።”<verse eid="DEU 33:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 33:13"/>ዋኤ ዮሴፍ አከነ ጄዼ፦</para>
  <para style="q1" vid="DEU 33:13">“<char style="nd">ዋቀዮ</char> ብየሳ ሃኤብሱ፤</para>
  <para style="q2" vid="DEU 33:13">ፍጤንሰ ፍለተማ ሰሚዻ ቡሱዻን</para>
  <para style="q2" vid="DEU 33:13">ብሻን ቦለ ገድ ፈጎ ኬሳቲን፣<verse eid="DEU 33:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="DEU 33:14"/>ምዻን ፍለተማ አዱን ብቅልችቱን፣</para>
  <para style="q2" vid="DEU 33:14">ዋን አከ መሌ ጋሪ ከን ጅእ ኬኑን፣<verse eid="DEU 33:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="DEU 33:15"/>ኬናወን ፍለተሞ ቱሉወን ዱሪቲን፣</para>
  <para style="q2" vid="DEU 33:15">በዻዹማ ጋረን በረ በራቲን፣<verse eid="DEU 33:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="DEU 33:16"/>ኬና ፍለተማ ለፋቲፊ ጉቱማሳቲን፣</para>
  <para style="q2" vid="DEU 33:16">ሱራ እሰ ደገለ ቦበኡ ኬሰ ቱሬ ሰናቲን ሃኤብሱ።</para>
  <para style="q1" vid="DEU 33:16">እሳን ኩኔን ሁንድ መታ ዮሴፍ</para>
  <para style="q2" vid="DEU 33:16">ከን ኦቦሎተሳ ግዱት ቡልቻ ተኤ ሰናረ ሃቡአን።<verse eid="DEU 33:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="DEU 33:17"/>እን ኡልፍናን ኮርመ ሀንገፈ ፈካተ፤</para>
  <para style="q2" vid="DEU 33:17">ጋንፈወንሳ አከ ጋንፈወን ገፈርሳት።</para>
  <para style="q1" vid="DEU 33:17">እሳኒንስ ሀመ ዳሪ ለፋት</para>
  <para style="q2" vid="DEU 33:17">ሰቦተ ንወራነ።</para>
  <para style="q1" vid="DEU 33:17">እሳንስ ኩመ ኩርነን ኤፍሬም፣</para>
  <para style="q2" vid="DEU 33:17">አከሱመስ ኩማተመ ምናሴት።”<verse eid="DEU 33:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 33:18"/>ዋኤ ዜቡሎንስ አከነ ጄዼ፦</para>
  <para style="q1" vid="DEU 33:18">“ዜቡሎን አት ገድ በኡኬቲን፣</para>
  <para style="q2" vid="DEU 33:18">ይሳኮር አትስ ዱንካኖተኬ ኬሰት ገመድ።<verse eid="DEU 33:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="DEU 33:19"/>እሳን ሰቦተ ገረ ቱሉት ንዋሙ፤</para>
  <para style="q2" vid="DEU 33:19">አችትስ ኣርሳ ቀጄሉማ ንዽኤሱ፤</para>
  <para style="q1" vid="DEU 33:19">እሳን ሶሩመ እረ ዸንገለኣ ገላነ ኬሳቲን፣</para>
  <para style="q2" vid="DEU 33:19">ቀቤኘ ጭረቸ ኬሰ ዾክፈሜንስ ንገመዱ።”<verse eid="DEU 33:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 33:20"/>ዋኤ ጋድሞ አከነ ጄዼ፦</para>
  <para style="q1" vid="DEU 33:20">“ነምን ቡልቺንሰ ጋድ በልእሱ ኤብፈማዸ!</para>
  <para style="q2" vid="DEU 33:20">ጋድ እሬፊ መታ ጨጨብሳ</para>
  <para style="q2" vid="DEU 33:20">አከ ሌንጫት አች ጅራተ።<verse eid="DEU 33:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="DEU 33:21"/>እን ኦፊሳቲፍ ለፈ ገበታ ፍለቴ፤</para>
  <para style="q2" vid="DEU 33:21">ቆድን ሆገንቶታ እሳፍ ቱርፈሜ።</para>
  <para style="q1" vid="DEU 33:21">ዮሙ ሆገንቶትን ሰባ ወልት ቀበመንት፣</para>
  <para style="q2" vid="DEU 33:21">እን ፌዺ ቀጄሉመ <char style="nd">ዋቀዮቲፊ</char></para>
  <para style="q2" vid="DEU 33:21">ሙርቲ እስራኤልት ሙሬ ሰነ ፊጣን ባሴ።”<verse eid="DEU 33:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 33:22"/>ዋኤ ዳንስ እን አከነ ጄዼ፦</para>
  <para style="q1" vid="DEU 33:22">“ዳን አከ እልሞሌ ሌንጫ</para>
  <para style="q2" vid="DEU 33:22">ከን ባሻን ኬሳ ኡታሌ በኡት።”<verse eid="DEU 33:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 33:23"/>ዋኤ ንፍታሌምስ አከነ ጄዼ፦</para>
  <para style="q1" vid="DEU 33:23">“ንፍታሌም ሱራ ጎንፈቴረ፤</para>
  <para style="q2" vid="DEU 33:23">ኤበ <char style="nd">ዋቀዮቲንስ</char> ጉተሜረ፤</para>
  <para style="q2" vid="DEU 33:23">እን ብየ ከራ ልጣቲፊ ክባቲን ጅሩ ንዻለ።”<verse eid="DEU 33:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="DEU 33:24"/>ዋኤ ኣሼርሞ አከነ ጄዼ፦</para>
  <para style="q1" vid="DEU 33:24">“ኣሼር እልማን ሁንደ ጫላ ኤብፈማዸ፤</para>
  <para style="q2" vid="DEU 33:24">እን ኦቦሎተሳ ዱረት ፉዸተመ ሃአርገቱ፤</para>
  <para style="q2" vid="DEU 33:24">ሚለሳስ ዘይቲ ኬሰ ሃጩጰቱ።<verse eid="DEU 33:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="DEU 33:25"/>ደንቀራን በልበለኬቲ ስቢላፊ ናሲ ተአ፤</para>
  <para style="q2" vid="DEU 33:25">ጀብንኬስ አኩመ በሮተ ጅሬኘኬቲ ንተአ።<verse eid="DEU 33:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="DEU 33:26"/>“ዋቅን አከ ዋቀ ይሹሩን፣</para>
  <para style="q2" vid="DEU 33:26">ከን ስ ገርጋሩፍ ጄዼ ሰሚወንረ፣</para>
  <para style="q2" vid="DEU 33:26">ሱራሳቲንስ ዱሜሶተረ ጉሉፉ ቶኮሌ ህንጅሩ።<verse eid="DEU 33:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="DEU 33:27"/>ዋቅን በረ በራ እዶ ጅሬኛኬቲት፤</para>
  <para style="q2" vid="DEU 33:27">እሬን በረ በራስ ስ ጀላን ጅረ።</para>
  <para style="q1" vid="DEU 33:27">እን፣ ‘እሳን በሌስ!’ ጄዼ</para>
  <para style="q2" vid="DEU 33:27">ዲኖተኬ ፉለኬ ዱራ ንአርአ።<verse eid="DEU 33:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="DEU 33:28"/>ከናፉ እስራኤል ኮጳሳ ነጋዻን ጅራተ፤</para>
  <para style="q2" vid="DEU 33:28">ለፈ ፍጤንስ ሰሚ እት ጮጮጱት፣</para>
  <para style="q1" vid="DEU 33:28">ብየ ምዻኒፊ ወይኒ ሃራት</para>
  <para style="q2" vid="DEU 33:28">ነምን ቡርቃ ያቆብ ቱቁ ህንጅሩ።<verse eid="DEU 33:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="DEU 33:29"/>ያ እስራኤል፣ አት ኤብፈማዸ!</para>
  <para style="q2" vid="DEU 33:29">ሰብን <char style="nd">ዋቀዮ</char> እሰ ፈይሴ፣</para>
  <para style="q2" vid="DEU 33:29">ከን አከኬቲ ኤኙ?</para>
  <para style="q1" vid="DEU 33:29">እን ጋቸነኬቲፊ ገርጋራኬት፤</para>
  <para style="q2" vid="DEU 33:29">ጎራዴ ኡልፍነኬቲትስ።</para>
  <para style="q1" vid="DEU 33:29">ዲኖትንኬ ሶዳዻን ፉለኬ ዱራ ዱበት ዴብኡ፤</para>
  <para style="q2" vid="DEU 33:29">አትሞ እዶወን ዋቄፈትናሳኒረ ኤጄተ።”<verse eid="DEU 33:29"/></para>
  <chapter eid="DEU 33"/>
  <chapter number="34" style="c" sid="DEU 34"/>
  <para style="s1">ዱአ ሙሴ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 34:1"/>ሙሴንስ ድሬ ሞኣቢ ከኤ ፉሌ ፊጤ ጵስጋ ከን ዬርኮት አርገሙት፣ ጋረ ኔቦት ኦል በኤ። አችትስ <char style="nd">ዋቀዮ</char> ጉቱማ ብየቲ እሰት አርግሲሴ፤ ኩንስ ግልኣዲ ሀመ ዳንት፣ <verse eid="DEU 34:1"/><verse number="2" style="v" sid="DEU 34:2"/>ጉቱማ ንፍታሌም፣ ብየ ኤፍሬሚቲፊ ምናሴ፣ ጉቱማ ብየ ይሁዳ ከን ሀመ ገላነ ልጣት በልአቴ ጅሩ፣ <verse eid="DEU 34:2"/><verse number="3" style="v" sid="DEU 34:3"/>ኔጌቢፊ መጋላ ሜጢ ከን ሱሉለ ዬርኮቲ ጀልቀቤ ሀመ ዞኣሪት አርገሙዸ። <verse eid="DEU 34:3"/><verse number="4" style="v" sid="DEU 34:4"/>ኤርገሲ <char style="nd">ዋቀዮ</char>፣ “ኩን ብየ አን ዬሮ፣ ‘ሰኚኬቲፍ ነንኬነ’ ጄዼት ከኩዻን አብረሃሚፍ፣ ይስሃቂፊ ያቆቢፍ ዋዳ ገሌዸ። አን አከ አት እጀኬቲን አርግቱ ጎዼረ፤ አት ገሩ አች ህንጬቱ” ጄዼን።<verse eid="DEU 34:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 34:5"/>ሙሴን ገርብች <char style="nd">ዋቀዮስ</char> አኩመ <char style="nd">ዋቀዮ</char> እሳን ጄዼት አቹመ ሞኣብ ኬሰት ዱኤ። <verse eid="DEU 34:5"/><verse number="6" style="v" sid="DEU 34:6"/>እንስ ብየ ሞኣብት ሱሉለ ፉሌ ቤት ጴኦርት አርገሙ ኬሰት እሰ አዋሌ፤ ገሩ ሀመ ሀርኣት አዋልሳ ኤሰ አከ ጅሩ ነምን ቶኮዩ ህንቤኩ። <verse eid="DEU 34:6"/><verse number="7" style="v" sid="DEU 34:7"/>ሙሴን ዬሮ ዱኤት ነመ ወጋ ዽበ ቶኮፊ ድግደመ ቱሬ፤ ተኡስ እጅሳ ህንደዸብኔ፤ ሁምንሳስ ህንላፍኔ። <verse eid="DEU 34:7"/><verse number="8" style="v" sid="DEU 34:8"/>እስራኤሎን ሀመ ዬሮን ገዳ ራወቱት ድሬ ሞኣብረት ቡልቲ ሶዶመ ሙሴዻፍ ቦአን።<verse eid="DEU 34:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 34:9"/>ዋን ሙሴን ሀርከሳ እሰረ ካኤ ቱሬፍ እያሱን እልም ኑን ሀፉረ ኦጉማቲን ጉተሜ። ከናፉ እስራኤሎን እሰ ዸገአኒ ዋን <char style="nd">ዋቀዮ</char> ሙሴ አጀጄ ጎዸን።<verse eid="DEU 34:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 34:10"/>ኤርገሲ ራጂን አከ ሙሴ ከን እፋን እፈት <char style="nd">ዋቀዮን</char> ቤኩ ቶኮዩ እስራኤል ኬሰት ህንካኔ፤ <verse eid="DEU 34:10"/><verse number="11" style="v" sid="DEU 34:11"/>ከን <char style="nd">ዋቀዮ</char> አከ እን ፈረኦንረት፣ ቆንዳልቶተሳቲፊ ጉቱ ብየሳረት መለቶወኒፊ ድንቂወን ሰነ ሆጄቱፍ ግብጥት ኤርጌ ዋን ሰነ ሆጄቴ ቶኮዩ ህንጅሩ። <verse eid="DEU 34:11"/><verse number="12" style="v" sid="DEU 34:12"/>ነምን ቶኮዩ ተኩማ ሁምነ ጉዳ ዮካን ሆጂ አከ መሌ ሶዳችሳ ሙሴን ፉለ እስራኤሎተ ሁንዳ ዱረት አርግሲሴ ሰነ ህንአርግሲፍኔቲ።<verse eid="DEU 34:12"/></para>
  <chapter eid="DEU 34"/>
</usx>
