<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1PE" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">1 ጴጥሮስ</para>
  <para style="toc1">ጴጥሮስ ቶኮፋ</para>
  <para style="toc2">1 ጴጥሮስ</para>
  <para style="toc3">1ጴጥ</para>
  <para style="mt1">ጴጥሮስ</para>
  <para style="mt2">ቶኮፋ</para>
  <chapter number="1" style="c" sid="1PE 1"/>
  <para style="s1">ነጋ ጋፈቹ</para>
  <para style="po">
    <verse number="1" style="v" sid="1PE 1:1"/>ጴጥሮስ ኤርገማ ዬሱስ ክርስቶስራ።</para>
  <para style="po" vid="1PE 1:1">ገረ ፍለተምቶተ ጳንጦስ፣ ገላትያ፣ ቀጰዶቅያ፣ አስያፊ ቢታንያ ኬሰ ብብትናአን <verse eid="1PE 1:1"/><verse number="2" style="v" sid="1PE 1:2"/>ከኔን አከ ቤኩምሰ ዋቀ አባት፣ ከራ ሆጂ ቁልቁሌሱ ሀፉራቲን፣ አከ ዬሱስ ክርስቶሲፍ አጀጀመኒፊ አከ ዺግንሳ እሳንት ፈጫፈሙፍ ፍለተመኒት።</para>
  <para style="po" vid="1PE 1:2">አያኒፊ ነጋን እስኒፍ ሃባይአቱ።<verse eid="1PE 1:2"/></para>
  <para style="s1">አብዲ ጅራታዻፍ ዋቀ ገለቴፈቹ</para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 1:3"/>ዋቃፊ አባን ጎፍታኬኘ ዬሱስ ክርስቶስ ሃኤብፈሙ! እን አራረሳ ጉዳ ሰናን፣ ወረ ዱአን ኬሳ ከኡ ዬሱስ ክርስቶሲን አብዲ ጅራታዻፍ ለመተ ኑ ዸልቼ፤ <verse eid="1PE 1:3"/><verse number="4" style="v" sid="1PE 1:4"/>አከሱመስ ዻለ ህንበድኔ፣ ከን ህንጡሮፍኔ ዮካን ህንጌደረምኔት ኑ ገልቼ፤ ዻል ኩንስ ሰሚ ኬሰ እስኒ ካአሜረ፤ <verse eid="1PE 1:4"/><verse number="5" style="v" sid="1PE 1:5"/>እስን ወረ ከራ አመንቲቲን ሀመ ፈይነ በረ ዹማት ሙልአቹዻፍ ቆጳኤ ሰናት ሁምነ ዋቃቲን ኤገምተኒዸ። <verse eid="1PE 1:5"/><verse number="6" style="v" sid="1PE 1:6"/>እስንስ ዮ አመ ዬሮ ገባባፍ ቆሩምሰ ጎሰ ገራ ገራ ኬሰ ደርቡ ቀባተንዩ ዋን ከናን አከ መሌ ገመደን። <verse eid="1PE 1:6"/><verse number="7" style="v" sid="1PE 1:7"/>ወን ኩንስ አከ አመንቲንኬሰን ከን ወርቄ ዮ እብዳን ቁልቁሌፈሜዩ በዱ ሰነ ጫሉ ሱን ዹጋ ተኡንሳ ምርከኔፈሜ፣ ዬሮ እት ዬሱስ ክርስቶስ ሙልአቱት ገለተ፣ ኡልፍናፊ ከበጀ ፍዱፍ ተኤ። <verse eid="1PE 1:7"/><verse number="8" style="v" sid="1PE 1:8"/>እስን ኡቱ እሰ ህንአርግን እሰ ጃለቱ፤ አመ ዮ እሰ አርጉ ባተንዩ እሰት አመንቱ፤ ገመቹ እብሰሙ ህንደንዴኜፊ ኡልፍነ ቀቤሳንስ ጉተምተኒርቱ፤ <verse eid="1PE 1:8"/><verse number="9" style="v" sid="1PE 1:9"/>እስን ቡኣ አመንቲኬሰኒ ጄቹንስ ፈይነ ሉቡኬሰኒ አርገቻ ጅርቱቲ።<verse eid="1PE 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 1:10"/>ራጆትን ዋኤ አያነ እስኒ ኬነሙፍ ጅሩ ሰና ዱበተን ሱን እት ጀባተኒ ዋኤ ፈይነ ከና ቆረቻ፣ እያፈቻስ ቱረን፤ <verse eid="1PE 1:10"/><verse number="11" style="v" sid="1PE 1:11"/>እሳንስ ዮሙ ሀፉር ክርስቶስ እን እሳን ኬሰ ቱሬ ሱን ዋኤ ዽጵነ ክርስቶሲቲፊ ዋኤ ኡልፍነ እት ኣኑ ሰና ዱራን ዱርሴ ዱበቴት ዮሚፊ ሃለ አከሚ ኬሰ አከ ተኡ ቤኩፍ ያላ ቱረን። <verse eid="1PE 1:11"/><verse number="12" style="v" sid="1PE 1:12"/>ነሞትን ሀፉረ ቁልቁሉ እሰ ሰሚዻ ኤርገሜን ወንጌለ እስንት ለለበን ሱን ዋን አመ እስንት ህመን ኬሰት ኡቱ ኦፊሳኒ ህንተእን እስን አከ ተጃጅለን እፈ ንተኤፍ፤ ዋን ከነ ኤርገሞትንዩ ገድ ፈጌኛን አርጉ ሀዉ።<verse eid="1PE 1:12"/></para>
  <para style="s1">ቁልቁሎተ ተኣ</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 1:13"/>ከናፉ ሙዺ ቀልቢኬሰኒ ህዸዻ፤ ወረ ኦፍ ቀበን ተኣ፤ አብዲኬሰንስ ጉቱማን ጉቱት አያነ ዬሮ ዬሱስ ክርስቶስ ሙልአቱት እስኒ ኬነሙ ሰነረ ካአዻ። <verse eid="1PE 1:13"/><verse number="14" style="v" sid="1PE 1:14"/>አከ እጆሌ አጀጀመኒ ተኣ መሌ ሀዊ ሀማ በረ ወላሉማኬሰኒ ሰነ ዱካ ህንቡእና። <verse eid="1PE 1:14"/><verse number="15" style="v" sid="1PE 1:15"/>ቆደ ከና አኩመ እን እስን ዋሜ ሱን ቁልቁሉ ተኤ፣ እስንስ ዋን ሆጄተን ሁንዱማን ቁልቁሎተ ተኣ፤ <verse eid="1PE 1:15"/><verse number="16" style="v" sid="1PE 1:16"/>“አን ቁልቁሉዻቲ እስንስ ቁልቁሎተ ተኣ”<note caller="+" style="f"><char style="fr" closed="false">1፥16 </char><char style="ft" closed="false"><char style="xt"><ref loc="LEV 11:44">ሌዎ 11፥44</ref>፣<ref loc="LEV 11:45">45</ref>፤ <ref loc="LEV 19:2">19፥2</ref>፤ <ref loc="LEV 20:7">20፥7</ref></char></char></note> ጄዸሜ በሬፈሜራቲ።<verse eid="1PE 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 1:17"/>እስን ኤርገ እሰ ኡቱ ወል ህንጫልችስን ነመ ሁንደ አኩመ ሆጂሳት እት ሙሩ ሰነ “አባ” ጄተኒ ዋመተኒ በረ ኬሱሙማኬሰን እሰ ሶዳቻ ጅራዻ። <verse eid="1PE 1:17"/><verse number="18" style="v" sid="1PE 1:18"/>እስን አከ ጅሬኘ ፋይዳ ህንቀብኔ ከን አቦቲኬሰንራ ዻልተንራ ዋን በዱ ደንደኡ ከን አከ ሜቲቲፊ ወርቄቲን ህንፉረምን ቤክቱቲ። <verse eid="1PE 1:18"/><verse number="19" style="v" sid="1PE 1:19"/>ገሩ ዺገ ገቲ ጉዳ ቀቡ፣ ዺገ ክርስቶስ ጄቹንስ ሆላ ሙዳ ዮካን ሀንቅነ ህንቀብኔ ሰናቲን ፉረምተኒርቱ። <verse eid="1PE 1:19"/><verse number="20" style="v" sid="1PE 1:20"/>እን ኡቱ አዱኛን ህንኡመምን ዱራን ዱርሴ ቤከሜ፤ ገሩ እስኒፍ ጄዼ በረ ዹማ ከነ ኬሰ ሙልአቴ። <verse eid="1PE 1:20"/><verse number="21" style="v" sid="1PE 1:21"/>እስንስ ከራሳቲን ዋቀ ወረ ዱአን ኬሳ እሰ ካሴ ኡልፍነ እሳፍ ኬኔ ሰነት አመንቱ፤ ኩንስ አከ አመንቲፊ አብዲንኬሰን ዋቀዮ ተኡፍ።<verse eid="1PE 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1PE 1:22"/>ኤጋ እስን ዋን አከ ኦቦሎተኬሰኒፍ ጃለለ ዹጋ ቀባተኒፍ ጄተኒ ዹጋዻፍ አጀጀሙን ኦፍ ቁልቁሌስተኒፍ፣ ጭምሳቲ ገራ ቁልቁሉዻን ወል ጃለዻ። <verse eid="1PE 1:22"/><verse number="23" style="v" sid="1PE 1:23"/>እስን ከራ ዱቢ ዋቃ እሰ ጅራቱፊ ጭሜ ዻበቱ ሰናቲን ሰኚ ህንበድኔራ ለመተ ዸለተን መሌ ሰኚ በዱራ ምት።<verse eid="1PE 1:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="1PE 1:24"/>“ፎን ሁንድ አኩመ መርጋት፤</para>
  <para style="q2" vid="1PE 1:24">ኡልፍንሳ ሁንድስ አኩመ ደራራ መርጋት፤</para>
  <para style="q1" vid="1PE 1:24">መርግ ንጮለገ፤ ደራራንስ ንሀርጨአ፤<verse eid="1PE 1:24"/></para>
  <para style="q2">
    <verse number="25" style="v" sid="1PE 1:25"/>ዱቢን ጎፍታ ገሩ በረ በራን ንጅራተ።”<note caller="+" style="f"><char style="fr" closed="false">1፥25 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 40:6-8">እሳ 40፥6‑8</ref></char></char></note></para>
  <para style="m" vid="1PE 1:25">ዱቢን ኩንስ ወንጌለ እስንት ለለበሜ ሰነ።<verse eid="1PE 1:25"/></para>
  <chapter eid="1PE 1"/>
  <chapter number="2" style="c" sid="1PE 2"/>
  <para style="p">
    <verse number="1" style="v" sid="1PE 2:1"/>ከናፉ ሀምነ ሁንደ፣ ጎዎምሳ ሁንደ፣ እት ፈኬሱማ፣ ዌኖፊ መቃ ነመ በሌሱ ሁንደ ኦፍራ ፈጌሳ። <verse eid="1PE 2:1"/><verse number="2" style="v" sid="1PE 2:2"/>አከ እቲን ፈይነኬሰኒን ጉደተኒፍስ አኩመ ዳእመን ሬፉ ዸለተኒት ኣነን ሀፉራ ቁልቁላኣ ሰነ ጀቤሳ ዸረኣ፤ <verse eid="1PE 2:2"/><verse number="3" style="v" sid="1PE 2:3"/>እስን ጋሩማ ጎፍታ ዸንዸመተኒርቱቲ።<verse eid="1PE 2:3"/></para>
  <para style="s1">ዸጋ ጅራታፊ ሰበ ፍለተሜ</para>
  <para style="p">
    <verse number="4" style="v" sid="1PE 2:4"/>እስን ኤርገ ገረሳ፣ ገረ ዸጋ ጅራታ ነሞትን ቱፈተኒ ዋቅን ገሩ ፍለቴ ገት ጀቤሰ ሰና ዹፍተኒ፣ <verse eid="1PE 2:4"/><verse number="5" style="v" sid="1PE 2:5"/>እስንስ አኩመ ኣርሳ ሀፉራ ከን ከራ ዬሱስ ክርስቶሲን ዋቀ ብረት ፉዸተማ ተኤ ዽኤሱዻን ሉቦተ ቁልቁላኦ ተኡፍ አኩመ ዸጋወን ጅራቶት መነ ሀፉራ ታተኒ እጃረማ ጅርቱ። <verse eid="1PE 2:5"/><verse number="6" style="v" sid="1PE 2:6"/>ከተቢን ቁልቁሉን፣</para>
  <para style="q1" vid="1PE 2:6">“ኩኖ፣ አን ጥዮን ኬሰ፣ ዸጋ ቶኮ፣</para>
  <para style="q2" vid="1PE 2:6">ዸጋ ጎሌ ፍለተማ ገት ጀቤሰ ነንካአ፤</para>
  <para style="q1" vid="1PE 2:6">ነምን እሰ አመነቱ</para>
  <para style="q2" vid="1PE 2:6">ከምዩ ህንቃነኡ”<note caller="+" style="f"><char style="fr" closed="false">2፥6 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 28:16">እሳ 28፥16</ref></char></char></note></para>
  <para style="m" vid="1PE 2:6">ጄዻቲ። <verse eid="1PE 2:6"/><verse number="7" style="v" sid="1PE 2:7"/>ከናፉ ዸጋን ኩን እስን ወረ አመንተኒፍ ዸጋ ገት ጀቤሳዸ። ወረ ህንአመኔፍ ገሩ፣</para>
  <para style="q1" vid="1PE 2:7">“ዸጋን እጃርቶትን ቱፈተን፣</para>
  <para style="q2" vid="1PE 2:7">ዸጋ ጎሌ ተኤረ።”<note caller="+" style="f"><char style="fr" closed="false">2፥7 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 118:22">ፋር 118፥22</ref></char></char></note><verse eid="1PE 2:7"/></para>
  <para style="m">
    <verse number="8" style="v" sid="1PE 2:8"/>አከሱመስ፣</para>
  <para style="q1" vid="1PE 2:8">“ዸጋ ነመ ጉፈቺሱ፣</para>
  <para style="q2" vid="1PE 2:8">ከታ ነመ ኩፍሱ ተኤ”<note caller="+" style="f"><char style="fr" closed="false">2፥8 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 8:14">እሳ 8፥14</ref></char></char></note></para>
  <para style="m" vid="1PE 2:8">ጄዸሜረ። እሳንስ ዋን ዱቢ ሰናፍ አጀጀሙ ድደኒፍ ጉፈተን፤ ዹጉማኑ እሳን ከኑማፍ ረመደመን።<verse eid="1PE 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1PE 2:9"/>እስን ገሩ አከ ገለተ እሰ ዱከነ ኬሳ ገረ እፈሳ ድንቅሲሳት እስን ዋሜ ሰና ለብስተኒፍ ዸሎተ ፍለተሜ፣ ሉቦተ ሞቲ፣ ሰበ ቁልቁሉ፣ ሰበ ዋቃ ከን አዳ ታተኒርቱ። <verse eid="1PE 2:9"/><verse number="10" style="v" sid="1PE 2:10"/>እስን ዱር ሰበ ዋቃ ህንቱሬ፤ አመ ገሩ ሰበ ዋቃት፤ እስን ዱር አራረ ህንአርገትኔ፤ አመ ገሩ አራረ አርገተኒርቱ።<verse eid="1PE 2:10"/></para>
  <para style="s1">ጅሬኘ ዋቀት ቶሉ ጅራቹ</para>
  <para style="p">
    <verse number="11" style="v" sid="1PE 2:11"/>ያ ምቾተ ጃለተሞ፣ እስን ዋን አዱኛ ኬሰት አለጎታፊ ኬሱሞተ ታተኒፍ አከ ሀዊ ፎኒ ከን ሉቡኬሰን ሎሉራ ፈጋተን አን እስንን ጎርሰ። <verse eid="1PE 2:11"/><verse number="12" style="v" sid="1PE 2:12"/>አከ ኦርሞትን አከ ዋን እስን ሀምነ ሆጄተኒት መቃ እስን በሌሰን ሱን፣ ሆጂኬሰን እሰ ጋሪ አርገኒ ጉያ ዋቅን ኑ እላሉ ዹፉት ኡልፍነ እሳፍ ኬነኒፍ እሳን ግዱት አመለ ጋሪ ቀባዻ።<verse eid="1PE 2:12"/></para>
  <para style="s1">ቡልችቶታፍ ቡሉ</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 2:13"/>ጎፍታዻፍ ጄዻቲ ታይታ ነማ ሁንደ ጀለት ቡላ፤ ሞቲ ታይታ ኦል ኣና ቀቡ <verse eid="1PE 2:13"/><verse number="14" style="v" sid="1PE 2:14"/>ዮካን ቡልችቶተ እን አከ እሳን ነሞተ በሌሳ ሆጄተን አደበኒ ወረ ዋን ቀጄላ ሆጄተንሞ ገለቴፈተኒፍ ኤርጌ ሁንዱማ ጀለትስ ቡላ። <verse eid="1PE 2:14"/><verse number="15" style="v" sid="1PE 2:15"/>ዋቅን አከ እስን ዋን ጋሪ ሆጄቹዻን ሃሳ ወላሉማ ነሞተ ጎዋ አፋን ቀበቺፍተን ፌዻቲ። <verse eid="1PE 2:15"/><verse number="16" style="v" sid="1PE 2:16"/>አከ ወረ ብልሱማ ቀበኒት ጅራዻ፤ ብልሱማኬሰንሞ ሀምነ ዾክሱፍ እት ህንፈየደምና፤ ገሩ አከ ተጃጅልቶተ ዋቃት ጅራዻ። <verse eid="1PE 2:16"/><verse number="17" style="v" sid="1PE 2:17"/>ነመ ሁንደ ከበጃ፤ ኦቦሉማ አመንቶታ ጃለዻ፤ ዋቀ ሶዳዻ፤ ሞቲፍስ ኡልፍነ ኬና።<verse eid="1PE 2:17"/></para>
  <para style="s1">ጎፍቶሊዻፍ ቡሉ</para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 2:18"/>ያ ገርቦተ፣ እስንስ ጎፍቶተኬሰን ወረ ጋሪፊ ቶሎተ ቆፈ ኡቱ ህንተእን ወረ ጀልኦተስ ሶዳ ሁንዳን ጀለት ቡላ። <verse eid="1PE 2:18"/><verse number="19" style="v" sid="1PE 2:19"/>ነምን ቶኮ ዮ ዋቃፍ ጄዼ ዽጵነ ደባን እሰት ዹፌ ኦብሴ ገለተ ቀበ። <verse eid="1PE 2:19"/><verse number="20" style="v" sid="1PE 2:20"/>እስን ዮ ሰበቢ በሌሳ ሆጄተኒፍ ዻነምተኒ ኦብስተን ገለተ ማሊ አርገቱ? ገሩ ዮ ሰበቢ ዋን ቀጄላ ሆጄተኒፍ ዽጰተኒ ኦብስተን ኩን ፉለ ዋቃ ዱረት ገለተ ቀበ።<verse eid="1PE 2:20"/></para>
  <para style="s1">ፈኬኘ ክርስቶስ</para>
  <para style="p">
    <verse number="21" style="v" sid="1PE 2:21"/>ወን እስን ዋመምተኒፍስ ከኑመ። ክርስቶስ አከ እስን ፋነሳ ዱካ ቡተኒፍ ጄዼ እስኒፍ ዽጰቹዻን ፈኬኘ እስኒ ኬኔራቲ።<verse eid="1PE 2:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="1PE 2:22"/>“እን ጩቡ ህንሆጄትኔ፤</para>
  <para style="q2" vid="1PE 2:22">ሶብን አፋንሳቲ ህንባኔ።”<note caller="+" style="f"><char style="fr" closed="false">2፥22 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 53:9">እሳ 53፥9</ref></char></char></note><verse eid="1PE 2:22"/></para>
  <para style="m">
    <verse number="23" style="v" sid="1PE 2:23"/>ዬሮ እሳን እሰ አረብሰንት እን እሳን ህንአረብስኔ፤ ዬሮ ዽጰቴትስ ነመ ህንዶርስፍኔ። ገሩ እሰ ቀጄሉማን ሙሩ ሰነት እማና ኦፍ ኬኔ። <verse eid="1PE 2:23"/><verse number="24" style="v" sid="1PE 2:24"/>እን መታንሳ አከ ኑ ጩቡፍ ዱኔ ቀጄሉማፍሞ ጅራትኑፍ ጄዼ ዸግነሳቲን ጩቡኬኘ ፈኖረት ባቴ፤ እስንስ መዳሳቲን ፈይተኒርቱ። <verse eid="1PE 2:24"/><verse number="25" style="v" sid="1PE 2:25"/>እስን ዱር አኩመ ሆሎተ ከራራ በደኒ ቱርተን፤ አመ ገሩ ገረ ትክሴፊ ጳጳሲ ሉቡኬሰኒት ዴብተኒርቱ።<verse eid="1PE 2:25"/></para>
  <chapter eid="1PE 2"/>
  <chapter number="3" style="c" sid="1PE 3"/>
  <para style="s1">ኒቶትን ዽርሶታፍ ቡሉ</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 3:1"/>ያ ኒቶተ፣ ዮ ዽርሶትን ዱብቸ ህንአመኔ ቶኮ ቶኮ ጅራተን አከ እሳን ዱቢ ቶኮ መሌ አመሉመ ኒቶተሳኒቲን ቦጅአመኒፍ እስንስ አከሱመ ዽርሶተኬሰኒፍ አጀጀማ፤ <verse eid="1PE 3:1"/><verse number="2" style="v" sid="1PE 3:2"/>እሳንስ ዮሙ ቁልቁልናፊ ሶዳ እስን ጅሬኘኬሰን ኬሰት ቀብደን አርገንት ንቦጅአሙ። <verse eid="1PE 3:2"/><verse number="3" style="v" sid="1PE 3:3"/>ሚዸግንኬሰን ፋየ አላን ሙልአቱን ጄቹንስ ሹሩባ ዸአቹ፣ ወርቄ ካአቹፊ ኡፈተ በሬዳ ኡፈቹን ህንተእን፤ <verse eid="1PE 3:3"/><verse number="4" style="v" sid="1PE 3:4"/>ቆደ ከና ሚዸግንኬሰን ሚዸግነ ኬሰ ነሙማኬሰኒ ሃተኡ፤ እንስ ሚዸግነ ሀፉረ ገራሚፊ ተስገባኣ፣ ከን ህንበድኔ፣ ከን ፉለ ዋቃ ዱረት ገቲ ጉዳ ቀቡ ሃተኡ። <verse eid="1PE 3:4"/><verse number="5" style="v" sid="1PE 3:5"/>ዱበርቶትን ቁልቁሎትን ዱሪ ወር ዋቀ አብደተንስ አከሱመ ዽርሶተሳኒቲፍ አጀጀሙዻን ኦፍ ሚዸግሰን፤ <verse eid="1PE 3:5"/><verse number="6" style="v" sid="1PE 3:6"/>ሳራንስ አብረሃሚን “ጎፍታ” ጄቴ ዋማ እሳፍ አጀጀማ ቱርቴ። እስንስ ዮ ዋን ቀጄላ ሆጄተኒፊ ሶዳቹ ባተን እንተለንሼት።<verse eid="1PE 3:6"/></para>
  <para style="s1">ድርቀመ ዽርሶታ</para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 3:7"/>ያ ዽርሶተ፣ እስንስ አከሱመ አከ እሳን ደዸቦ ተአን ሁበዻቲ ኡልፍነ እሳኒፍ ኬኑዻን ኒቶተኬሰን ወጅን ጅራዻ፤ ከነስ ሰበቢ እሳንስ እስን ወጅን አያነ ጅሬኛ ዻለኒፍ አከ ወን ቶኮዩ ከዻኬሰን ህንጉፈቺፍኔፍ ጄዻቲ ጎዻ።<verse eid="1PE 3:7"/></para>
  <para style="s1">ሰበቢ ዋን ጋሪ ሆጄተኒፍ ዽጰቹ</para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 3:8"/>ዹመረት ሁንድኬሰን ያደ ቶኮ ቀባዻ፤ ወሊ ነኣ፤ አከ ኦቦሎታት ወል ጃለዻ፤ ገራ ላፎታፊ ወረ ገድ ኦፍ ቀበንስ ተኣ። <verse eid="1PE 3:8"/><verse number="9" style="v" sid="1PE 3:9"/>ሀማ፣ ሀማዻን ህንዴብስና፤ ዮካን አረብሶ፣ አረብሶዻን ህንዴብስና፤ ቆደ ከና ኤብሳ። እስንስ አከ ኤበ ዻልተኒፍ ከኑማፍ ዋመምተኒቲ።<verse eid="1PE 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="1PE 3:10"/>“ነምን ጅሬኘ ጃለቱ፣</para>
  <para style="q2" vid="1PE 3:10">ከን በረ ጋሪስ አርጉ ሀዉ ከምዩ፣</para>
  <para style="q1" vid="1PE 3:10">አረበሳ ሀምነራ፣</para>
  <para style="q2" vid="1PE 3:10">ህዺሳሞ ሶበ ዱበቹራ ሃኤገቱ።<verse eid="1PE 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="1PE 3:11"/>እን ሀምነራ ዴብኤ ጋሪ ሃሆጄቱ፤</para>
  <para style="q2" vid="1PE 3:11">ነጋ ሃበርባዱ፤ ዱካ ሃቡኡስ።<verse eid="1PE 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="1PE 3:12"/>እጅ ጎፍታ ቀጄልቶተረ ጅራቲ፤</para>
  <para style="q2" vid="1PE 3:12">ጉርሳስ ከዸተሳኒቲፍ በነማዸ፤</para>
  <para style="q1" vid="1PE 3:12">ገሩ ፉል ጎፍታ ወረ ሀማ ሆጄተንት ንሀማተ።”<note caller="+" style="f"><char style="fr" closed="false">3፥12 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 34:12-16">ፋር 34፥12‑16</ref></char></char></note><verse eid="1PE 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 3:13"/>እስን ጋሪ ሆጄቹፍ ዮ ህናፍተን፣ ኤኙቱ እስን ሚዸ? <verse eid="1PE 3:13"/><verse number="14" style="v" sid="1PE 3:14"/>ገሩ ዮ ቀጄሉማፍ ጄተኒ ዽጰተን እስን ኤብፈሞዸ። “ሶዳችሱሳኒ ህንሶዳትና፤ ህንጄቀምናስ።”<note caller="+" style="f"><char style="fr" closed="false">3፥14 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 8:12">እሳ 8፥12</ref></char></char></note> <verse eid="1PE 3:14"/><verse number="15" style="v" sid="1PE 3:15"/>ገሩ ገራኬሰን ኬሰት ክርስቶስ ጎፍትቻፍ ኡልፍነ ጉዳ ኬና። ነመ ሰበቢ አብዲ እስን ቀብደን ሰና እስን ጋፈቱ ከሚፍዩ ዴቢ ኬኑፍ ዬሮ ሁንደ ቆጳኣ። ዋን ከነሞ ገራሙማፊ ሶዳን ጎዻ፤ <verse eid="1PE 3:15"/><verse number="16" style="v" sid="1PE 3:16"/>እስንስ ዮሙ ነሞትን ዋኤኬሰን ዋን ሀማ ዱበተንት አከ ወር አመለ ጋሪ እስን ክርስቶስ ኬሰት ቀብደን ሰነ አረብሰን ቃነአኒፍ ያደ ጋሪ ቀባዻ። <verse eid="1PE 3:16"/><verse number="17" style="v" sid="1PE 3:17"/>ዽጰቹንኬሰን ፌዺ ዋቃ ዮ ተኤ፣ ሀማ ሆጄተኒ ዽጰቹረ ጋሪ ሆጄተኒ ዽጰቹ ወየ።<verse eid="1PE 3:17"/></para>
  <para style="s1">ፈኬኘ ክርስቶስ</para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 3:18"/>ክርስቶስስ ዋቀት እስን ፍዱፍ ጄዼ እን ቀጄላን፣ ወረ ቀጄልቶተ ህንተእኒፍ ስአ ቶኮ ጩቡፍ ዽጰቴራቲ። እን ፎኒን ንአጄፈሜ፤ ሀፉራን ገሩ ጅራታ ታስፈሜ፤ <verse eid="1PE 3:18"/><verse number="19" style="v" sid="1PE 3:19"/>ኤርገ ጅራታ ታስፈሜሞ ዸቄ ሀፉሮተ መነ ህዻ ጅረንት ለለቤ፤ <verse eid="1PE 3:19"/><verse number="20" style="v" sid="1PE 3:20"/>እሳንስ በረ ኖህ ኬሰ ኡቱ ዶኒን እጃረማ ጅሩ፣ ዬሮ ዋቅን ኦብሳን ኤጌት ወረ ህንአጀጀምኒዸ። ዶኒ ከናንስ ነመ ሙራሰ፣ ወሉመት ነመ ሰዴት ቆፈቱ በዲሰ ብሻኒ ጀላ በኤ፤ <verse eid="1PE 3:20"/><verse number="21" style="v" sid="1PE 3:21"/>ብሻን ኩን ፈኬኘ ጩጳ አመዩ እስን ፈይሱት፤ ኩንስ ዸግነራ ጡሪ ባሱ ኡቱ ህንተእን ቀልቢ ቁልቁሉን ዋቃፍ ዋዳ ገሉዸ። እንስ ዱኣ ከኡ ዬሱስ ክርስቶሲን እስን ፈይሰ፤ <verse eid="1PE 3:21"/><verse number="22" style="v" sid="1PE 3:22"/>ክርስቶስ ሰሚት ኦል በኤ ምርገ ዋቃ ጅረ፤ ኤርገሞትን ዋቃ፣ ኣንጎወኒፊ ሁምኖትን ሁንድኑ እሰ ጀለት ቡሉ።<verse eid="1PE 3:22"/></para>
  <chapter eid="1PE 3"/>
  <chapter number="4" style="c" sid="1PE 4"/>
  <para style="s1">ዋቃፍ ጅራቹ</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 4:1"/>ከናፉ ዋን ክርስቶስ ፎንሳቲን ዽጰቴፍ እስንስ ያዱመ አከሲቲን ህዸዻ፤ ሰበቢንሳስ እን ፎኒን ዽጰቴ ጩቡ ዺሴረ። <verse eid="1PE 4:1"/><verse number="2" style="v" sid="1PE 4:2"/>ከናፉ እን በረ ጅሬኘሳ ከን ፎኒ እሰ ሀፌ ሰነ አከ ፌዺ ዋቃት ጅራተ መሌ አከ ሀዊ ነማት ህንጅራቱ። <verse eid="1PE 4:2"/><verse number="3" style="v" sid="1PE 4:3"/>ዬሮን እስን ዱራን ዋን ነሞትን ኦርማ ሆጄቹ ጃለተን ሰነ ጄቹንስ ጅሬኘ ገድ ዺሲረት፣ ሀዊ ፎኒረት፣ መቺረት፣ አደጉማረት፣ ገር መሌ ዹጉፊ ዋቄፈትና ዋቆተ ቶልፈሞ ከን ጅብሲሳ ተኤረት በሌስተን ሱን ሃገኡ። <verse eid="1PE 4:3"/><verse number="4" style="v" sid="1PE 4:4"/>እሳንስ ሰበቢ እስን ገረ ጅሬኘ ገድ ዺሲ አከሲት እሳን ወጅን ህንፊግኔፍ ንድንቅሲፈቱ፤ እስን አረብሱስ። <verse eid="1PE 4:4"/><verse number="5" style="v" sid="1PE 4:5"/>ገሩ እሳን ዋቀ ወረ ጅረኒፊ ወረ ዱአንት ሙሩፍ ቆጳኤ ሰነ ዱረት ዴቢ ንኬኑ። <verse eid="1PE 4:5"/><verse number="6" style="v" sid="1PE 4:6"/>ከናፉ ከራ ፎኒቲን አኩመ ነማት አከ እሳንት ሙረሙፍ፣ ከራ ሀፉራቲንሞ አከ ዋቃት አከ ጅራተኒፍ ወንጌል ወረ ዱአኒ ጅረንትዩ ለለበሜረ።<verse eid="1PE 4:6"/></para>
  <para style="s1">ዹመ ዋን ሁንዱማ</para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 4:7"/>ዹምን ዋን ሁንዳ ዽኣቴረ። ከናፍ አከ ዋቀ ከዸቹ ደንዴሰኒፍ ደመቃ፤ ወረ ኦፍ ቀበንስ ተኣ። <verse eid="1PE 4:7"/><verse number="8" style="v" sid="1PE 4:8"/>ዋን ሁንደ ጫላት ጃለለ ሆኣ ወሊፍ ቀባዻ፤ ጃለል ጩቡ ባይኤ ዾክሳቲ። <verse eid="1PE 4:8"/><verse number="9" style="v" sid="1PE 4:9"/>ጉንጉሚ መሌ ወል ኬሱምሲሳ። <verse eid="1PE 4:9"/><verse number="10" style="v" sid="1PE 4:10"/>ቶኮን ቶኮን ነማ ኬና ወረ ካን ተጃጅሉፍ አርገቴ ከምዩ አኩመ አባ እማና አመነማ ከን አያነ ዋቃ ብፈ ገራ ጋራቲን ጅሩ ሰና ቶኮት እት ፈየደሙ ቀበ። <verse eid="1PE 4:10"/><verse number="11" style="v" sid="1PE 4:11"/>ነምን ዱበቱ ከምዩ አከ ነመ ዱቢ ዋቃ ዱበቱት ሃዱበቱ። ነምን ተጃጅሉ ከምዩ አከ ዋቅን ዋን ሁንደ ኬሰት ከራ ዬሱስ ክርስቶሲን ገለቴፈሙፍ ጄዼ ጀብነ ዋቅን እሳፍ ኬኔን ሃተጃጅሉ። ኡልፍኒፊ ሁምን በረ በራ ሀመ በረ በራት እሳፍ ሃተኡ። አሜን።<verse eid="1PE 4:11"/></para>
  <para style="s1">ሰበቢ ክርስታነ ተአኒፍ ዽጰቹ</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 4:12"/>ያ ምቾተ ጃለተሞ፣ ቆረመ አከ እብዳ ከን አመ እቲን ዽጰቻ ጅርተን ከነ አከ ዋን ወን ሃራን እስንት ዹፌት ህንድንቅሲፈትና። <verse eid="1PE 4:12"/><verse number="13" style="v" sid="1PE 4:13"/>ገሩ እስን ዬሮ ኡልፍንሳ ሙልአቱት አከ ባይኤ ገመደኒፍ ዋን ዽጵነ ክርስቶስ ኬሰት ቆደ ፉዸተኒፍ ገመዳ። <verse eid="1PE 4:13"/><verse number="14" style="v" sid="1PE 4:14"/>ዮ መቃ ክርስቶሲቲፍ ጄተኒ አረብሰምተን እስን ኤብፈሞዸ፤ ሀፉር ኡልፍናቲፊ ሀፉር ዋቃ እስንረ ቦቆታቲ። <verse eid="1PE 4:14"/><verse number="15" style="v" sid="1PE 4:15"/>እስን ኬሳ ነምን ከምዩ አከ ነመ ነመ አጄሱት ዮካን አከ ሀቱት ዮካን አከ ነመ የከ ሆጄቱት ዮካን አከ ነመ ዱቢ ነማ ኬሰ ሴኑት ህንዽጰትን። <verse eid="1PE 4:15"/><verse number="16" style="v" sid="1PE 4:16"/>ገሩ ነምን ቶኮ ዮ ሰበቢ ክርስታነ ተኤፍ ዽጰቴ መቃ ሰናን ዋቀ ሃገለቴፈቱ መሌ ህንቃነእን። <verse eid="1PE 4:16"/><verse number="17" style="v" sid="1PE 4:17"/>ዬሮን እት ሙርቲን መነ ዋቃቲ ጀልቀቡ ዽኣቴራቲ፤ ሙርቲን ኩን ዮ ኑረት ጀልቀበ ተኤ ዹምን ወረ ወንጌለ ዋቃቲፍ ህንአጀጀምኔ አከም ሃተኡሬ?<verse eid="1PE 4:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="1PE 4:18"/>“ኤርገ ቀጄልቶትን ፈዩን ረክሳ ተኤ፣</para>
  <para style="q2" vid="1PE 4:18">ነምን ዋቀት ህንቡሌፊ ጩበማን ማል ሃተኡሬ?”<note caller="+" style="f"><char style="fr" closed="false">4፥18 </char><char style="ft" closed="false"><char style="xt"><ref loc="PRO 11:31">ፈኬ 11፥31</ref></char></char></note><verse eid="1PE 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1PE 4:19"/>ከናፉ ወር አከ ፌዺ ዋቃት ዽጰተን ሉቡሳኒ ኡማሳኒ አመነማ ሰነት እማና ኬነተኒ ዋን ጋሪ ሆጄቹት ሃፉፈን።<verse eid="1PE 4:19"/></para>
  <chapter eid="1PE 4"/>
  <chapter number="5" style="c" sid="1PE 5"/>
  <para style="s1">ማንጉዶታፊ ከረ ሆሎታቲፍ</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 5:1"/>አን አከ ማንጉዶ አኩመሳኒ ቶኮት፣ አከ ዹገ ባቱ ዽጵነ ክርስቶሲፊ አከ ነመ ኡልፍነ ሙልአቹፍ ጅሩ ሰነ ኬሰት ቆደ ቀቡ ቶኮት አከነ ጄዼ ማንጉዶተ እስን ግዱ ጅረን ሰነ ነንጎርሰ፤ <verse eid="1PE 5:1"/><verse number="2" style="v" sid="1PE 5:2"/>ከረ ሆሎታ ዋቃ ከን ትከኬሰን ጀለ ጅሩ ኤጉዻን ትክሶተ ተኣ፤ ከነስ ሰበቢ ድርቀምተኒፍ ኡቱ ህንተእን ፌዺዹመኬሰኒን አከ ዋቅን አከ እስን ታተን በርባዱት፣ ቡኣ ነመ ቃኔሱ አርገቹፍ ኡቱ ህንተእን ሀዊ ጉዳ ተጃጅላፍ ቀብደኒን ጎዻ፤ <verse eid="1PE 5:2"/><verse number="3" style="v" sid="1PE 5:3"/>ከረ ሆሎታቲፍ ፈኬኘ ተኣ መሌ ወረ እማና እስንት ኬነመን ሰነ ሁምናን ህንቡልችና። <verse eid="1PE 5:3"/><verse number="4" style="v" sid="1PE 5:4"/>እስንስ ዮሙ ሀንገፍን ትክስቶታ ሙልአቱት ጎንፎ ኡልፍና ከን ሚዸግንሳራ ህንበድኔ አርገቱ።<verse eid="1PE 5:4"/></para>
  <para style="s1">ደርገጎታፍ</para>
  <para style="p">
    <verse number="5" style="v" sid="1PE 5:5"/>ያ ደርገጎተ፣ እስንስ አከሱመ ማንጉዶተ ጀለት ቡላ። ሁንድኬሰንስ ቶኮ ቶኮኬሰኒፍ ገድ ኦፍ ቀቢሰ አከ ወያት ኡፈዻ፤</para>
  <para style="q1" vid="1PE 5:5">“ዋቅን ኦፍ ቱልቶታን ንሞርመ፤</para>
  <para style="q2" vid="1PE 5:5">ወረ ገድ ኦፍ ቀበኒፍሞ አያነ ኬናቲ።”<note caller="+" style="f"><char style="fr" closed="false">5፥5 </char><char style="ft" closed="false"><char style="xt"><ref loc="PRO 3:34">ፈኬ 3፥34</ref></char></char></note><verse eid="1PE 5:5"/></para>
  <para style="m">
    <verse number="6" style="v" sid="1PE 5:6"/>ከናፉ አከ ዋቅን ዬሮ መሉት ኦል እስን ቀቡፍ፣ ሀርከሳ ሁምነ ቀቤሰ ሰነ ጀለት ገድ ኦፍ ቀባ። <verse eid="1PE 5:6"/><verse number="7" style="v" sid="1PE 5:7"/>እን እስኒፍ ዋን ያዱፍ፣ ያዶኬሰን ሁንደ እሰረ ካአዻ።<verse eid="1PE 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 5:8"/>ወረ ኦፍ ቀበን ተአ፤ ደመቃስ። ዲያብሎስ ዲንኬሰን ነመ ልቅምሱ በርባዴ አኩመ ሌንጨ ኣዱ ነናነኣቲ። <verse eid="1PE 5:8"/><verse number="9" style="v" sid="1PE 5:9"/>ሰበቢ አከ ኦቦሎትንኬሰን ወር አዱኛ ጉቱ ኬሰ ጅራተን ዽጵነ አከሲ ዽጰቻ ጅረን ቤክተኒፍ አመንቲት ጀባዻቲ እሳን ሞርማ።<verse eid="1PE 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 5:10"/>ዋቅን አያነ ሁንዳ ከራ ክርስቶሲን ገረ ኡልፍነሳ ከን በረ በራት እስን ዋሜ ሱን ኤርገ እስን ዬሮ ገባባፍ ዽጰተኒ ቦዴ እን መታንሳ ጉቱ እስን ታስሰ፤ እስን ዻበ፤ እስን ጀቤሰስ። <verse eid="1PE 5:10"/><verse number="11" style="v" sid="1PE 5:11"/>በረ በራ ሀመ በረ በራት ሁምን እሳፍ ሃተኡ። አሜን።<verse eid="1PE 5:11"/></para>
  <para style="b"/>
  <para style="s1">ዻምሰ ነጋ ጡሙራ</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 5:12"/>አንስ እስን ጀጀቤሱዻፍ፣ አከ ወን ኩን አያነ ዋቃ እሰ ዹጋ ተኤ ሰነ ዹጋ በኡፍ ሀርከ ሲላስ እሰ አን አከ ኦቦሌሰ አመነማት ሄዱ ሰናቲን ገባቡመት በሬሴ እስኒ ኤርጌረ። አያነ ከናን ጀባዻ ዻበዻ።<verse eid="1PE 5:12"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="13" style="v" sid="1PE 5:13"/>ወልዳን ክርስታና እሼን እስን ወጅን ፍለተምቴ ባብሎን ኬሰ ጅርቱ ሱን ነጋ እስኒ ዻምት፤ እልምኮ ማርቆስስ አከሱመ ነጋ እስኒ ዻመ።<verse eid="1PE 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1PE 5:14"/>ዹንጎ ጃለላቲን ነጋ ወል ጋፈዻ።</para>
  <para style="b" vid="1PE 5:14"/>
  <para style="p" vid="1PE 5:14">እስን ወረ ከን ክርስቶስ ታተን ሁንዳፍ ነጋን ሃተኡ።<verse eid="1PE 5:14"/></para>
  <chapter eid="1PE 5"/>
</usx>
