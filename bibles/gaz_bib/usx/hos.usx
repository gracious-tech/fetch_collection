<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="HOS" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">ሆሴኣ</para>
  <para style="toc1">ራጂ ሆሴኣ</para>
  <para style="toc2">ሆሴኣ</para>
  <para style="toc3">ሆሴ</para>
  <para style="mt2">ራጂ</para>
  <para style="mt1">ሆሴኣ</para>
  <chapter number="1" style="c" sid="HOS 1"/>
  <para style="p">
    <verse number="1" style="v" sid="HOS 1:1"/>ዱቢን <char style="nd">ዋቀዮ</char> ከን በረ ኡዝያን፣ ዮታም፣ ኣሃዚቲፊ ህስቅያስ ሞቶተ ይሁዳ ኬሰ፣ አከሱመስ በረ ዬሮብኣም እልመ ዮኣሽ ሞትቸ እስራኤል ኬሰ ገረ ሆሴኣ እልመ ብኤር ዹፌ ከናዸ፦<verse eid="HOS 1:1"/></para>
  <para style="b"/>
  <para style="s1">ኒቲፊ እጆሌ ሆሴኣ</para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 1:2"/>ዬሮ <char style="nd">ዋቀዮ</char> ከራ ሆሴኣቲን ዱበቹ ጀልቀቤት <char style="nd">ዋቀዮ</char> አከነ እሳን ጄዼ፤ “ሰበቢ ብየቲን <char style="nd">ዋቀዮራ</char> ጎርቴ የከ ሰጋገሉማ ጉዳሳ ሆጄቴፍ አት ዸቂቲ ኒቲ ሰጋገልቱፊ እጆሌ ህንአመነምኔ ኦፊኬቲፍ ፉዸዹ።” <verse eid="HOS 1:2"/><verse number="3" style="v" sid="HOS 1:3"/>ከናፉ እን ዸቄ ጎሜር እንተለ ድብላዪም ፉዼ፤ እሼንስ ኡልፎፍቴ እልመ ዴሴፍ።<verse eid="HOS 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 1:4"/>ከነረት <char style="nd">ዋቀዮ</char> ሆሴኣቲን አከነ ጄዼ፤ “አን ሰበቢ ዺገ ይዝርኤል ኬሰት ዸንገለኤ ሰናቲፍ ደፌ መነ ዬሁ ዋነን አደቡፍ ይዝርኤል ጄዺ እሰ ሞጋስ፤ አን ሞቱማ እስራኤል ነንበሌሰ። <verse eid="HOS 1:4"/><verse number="5" style="v" sid="HOS 1:5"/>ጋፈስ አን ሱሉለ ይዝርኤል ኬሰት እዳ እስራኤል ነንጨብሰ።”<verse eid="HOS 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HOS 1:6"/>ጎሜር አመሌ ኡልፎፍቴ እንተለ ዴሴ። <char style="nd">ዋቀዮ</char> ሆሴኣዻን አከነ ጄዼ፤ “ሰበቢ አን እሳኒፍ አራረሙፊ ስአችስ መነ እስራኤሊፍ ገራ ህንላፍኔፍ ሎ-ሩሃማ ጄዺ እሼ ሞጋስ። <verse eid="HOS 1:6"/><verse number="7" style="v" sid="HOS 1:7"/>ተኡስ አን መነ ይሁዳቲፍ ገራ ነንላፈ፤ አን ጥያን ዮካን ጎራዴዻን ዮካን ወራናን ዮካን ፈርዴኒን ዮካን አቦቲ ፈርዳቲን እሳን ህንኦልቹ፤ ገሩ አን <char style="nd">ዋቀዮ</char> ዋቅንሳኒ እሳን ነንኦልቸ።”<verse eid="HOS 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HOS 1:8"/>ጎሜር ኤርገ ሎ-ሩሃማ ሀርመ ጉስፍቴ ቦዴ ኡልፎፍቴ እልመ ዴሴ። <verse eid="HOS 1:8"/><verse number="9" style="v" sid="HOS 1:9"/>ኤርገሲስ <char style="nd">ዋቀዮ</char> አከነ ጄዼ፤ “እስን ዋን ሰበኮ ህንተእኒፊ አንስ ዋቀኬሰን ህንተእኒፍ ሎ-አሚ ጄዺ እሰ ሞጋስ።<verse eid="HOS 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="HOS 1:10"/>“ተኡስ እስራኤል አኩመ ጭረቸ ቀርቀረ ገላና ከን መዳለሙ ዮካን ሄደሙ ህንደንደአምኔ ተአ። እሳን እዶዹመ እት፣ ‘እስን ሰበኮ ምት’ እሳኒን ጄዸሜ ሰነት፣ ‘እልማን ዋቀ ጅራታ’ ጄዸመኒ ንዋመሙ። <verse eid="HOS 1:10"/><verse number="11" style="v" sid="HOS 1:11"/>ጉያን ይዝርኤል ዋን ጉዳ ተኡፍ፣ ሰብን ይሁዳቲፊ ሰብን እስራኤል ዴብአኒ ቶኮ ተኡ፤ እሳን ሆገና ቶኮ ሙደተኒ ብየ ሰነ ኬሳ ንበኡ።<verse eid="HOS 1:11"/></para>
  <chapter eid="HOS 1"/>
  <chapter number="2" style="c" sid="HOS 2"/>
  <para style="p">
    <verse number="1" style="v" sid="HOS 2:1"/>“ኦቦሎተኬሰኒን፣ ‘ሰበኮ’ ኦቦሌቶተኬሰኒንሞ፣ ‘ጃለተምቱኮ’ ጄዻ።<verse eid="HOS 2:1"/></para>
  <para style="s1">አደበሙፊ ሃሮምፈሙ እስራኤል</para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 2:2"/>“ሃዸኬሰንት ዼከማ፤ እሼት ዼከማ፤</para>
  <para style="q2" vid="HOS 2:2">እሼን ኒቲኮ ምቲቲ፤</para>
  <para style="q2" vid="HOS 2:2">አንስ ዽርሰሼ ምት።</para>
  <para style="q1" vid="HOS 2:2">እሼን ፉለሼራ እላልቸ ኤጁማ ሃበሌስቱ፤</para>
  <para style="q2" vid="HOS 2:2">አመነሙማ ዸቡስ ሀርመሼ ግዱዻ ሃበሌስቱ።<verse eid="HOS 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 2:3"/>ዮ ከና አቺ አን ወያ እሼራ ባሴ</para>
  <para style="q2" vid="HOS 2:3">አኩመ ጉያ እሼን ዸለቴ ሰና ቁላሼ ነንሀምብሳ፤</para>
  <para style="q1" vid="HOS 2:3">አኩመ ገሞጂ እሼ ነንጎዸ፤</para>
  <para style="q2" vid="HOS 2:3">ለፈ ጎጎጋት እሼ ነንጌደረ፤</para>
  <para style="q2" vid="HOS 2:3">ዼቡዻንስ እሼ ነንአጄሰ።<verse eid="HOS 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 2:4"/>እሳን እጆሌ ኤጁማ ዋን ተአኒፍ፣</para>
  <para style="q2" vid="HOS 2:4">አን እጆሌ እሼቲፍ ገራ ህንላፉ።<verse eid="HOS 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 2:5"/>ሃትሳኒ አመነሙማ ዸብዴ</para>
  <para style="q2" vid="HOS 2:5">ከራ ሰልጵናቲን እሳን ኡልፎፍቴ።</para>
  <para style="q1" vid="HOS 2:5">እሼን፣ ‘አን ወረ ነ ጃለቱ፣</para>
  <para style="q2" vid="HOS 2:5">ወረ ኛተኮፊ ብሻንኮ፣</para>
  <para style="q1" vid="HOS 2:5">ወረ ሱፊኮፊ ወያ ቁንጬ ተልባራ ሆጄተሜ፣</para>
  <para style="q2" vid="HOS 2:5">ወረ ድበታፊ ዹጋቲኮ ናፍ ኬነን</para>
  <para style="q2" vid="HOS 2:5">ዱካ ነንቡአ’ ጄቴ።<verse eid="HOS 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 2:6"/>ከናፉ አን ሃፈ ቆራቲቲን ዳንዲሼ ነንጩፈ፤</para>
  <para style="q2" vid="HOS 2:6">አከ እሼን ከራ እቲን ባቱ ህንአርገትኔፍ ደላ እት ነንእጃረ።<verse eid="HOS 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 2:7"/>እሼን ምቾተሼ ዱካ ቡት፤ ገሩ እሳን ህንቀቀብዱ፤</para>
  <para style="q2" vid="HOS 2:7">እሳን በርባድ፤ ገሩ ህንአርግቱ።</para>
  <para style="q1" vid="HOS 2:7">ኤርገሲ እሼን፣ ‘አን አኩመ ዱራ</para>
  <para style="q2" vid="HOS 2:7">ገረ ዽርሰኮት ነንዴብአ፤</para>
  <para style="q2" vid="HOS 2:7">አመ ጫላ ዬሮ ሰነ ወየ ቱሬቲ’ ጄት።<verse eid="HOS 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 2:8"/>እሼን አከ አን ምዻን፣</para>
  <para style="q2" vid="HOS 2:8">ዳዺ ወይኒ ሃራፊ ዘይቲ እሼዻፍ ኬኔ፣</para>
  <para style="q1" vid="HOS 2:8">ሜቲፊ ወርቄ እሳን በኣሊፍ ዽኤሰንስ</para>
  <para style="q2" vid="HOS 2:8">ከን እሼረት ዸንገላሴ አኑመ አከ ተኤ ህንቤክኔ።<verse eid="HOS 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 2:9"/>“ከናፉ አን ዬሮ እን ብልቻቱት ምዻንኮ፣</para>
  <para style="q2" vid="HOS 2:9">ዳዺ ወይኒኮ ሃራሌ ዬሮ እን ቆጳኡት <optbreak/> እራ ነንፉዸዸ።</para>
  <para style="q1" vid="HOS 2:9">አን ሱፊኮፊ ወያኮ ከን ቁንጬ ተልባራ ሆጄተሜ</para>
  <para style="q2" vid="HOS 2:9">ከነን ቁላሼ ዾክሱዻፍ ኬኔፍስ <optbreak/> አመ እሼራ ነንፉዸዸ።<verse eid="HOS 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 2:10"/>አን አመ እጁመ ምቾተሼ ዱረት</para>
  <para style="q2" vid="HOS 2:10">አደጉማሼ ነንሳጥለ፤</para>
  <para style="q2" vid="HOS 2:10">ነምን ቶኮዩ ሀርከኮ ኬሳ እሼ ህንባሱ።<verse eid="HOS 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 2:11"/>አን አያነሼ ሁንደ ጄቹንስ፣</para>
  <para style="q2" vid="HOS 2:11">አያነሼ ከን ወጋ፣ አያነሼ ከን ጋፈ ባቲ ሃራ፣</para>
  <para style="q1" vid="HOS 2:11">አያነሼ ከን ሰንበታቲፊ</para>
  <para style="q2" vid="HOS 2:11">አያኖተሼ ከኔን ሙርታአን ሁንደ ነንሀምብሰ።<verse eid="HOS 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 2:12"/>አን ሙከ ወይኒሼቲፊ ሙከ ሀርቡሼ</para>
  <para style="q2" vid="HOS 2:12">ከን እሼን ምቾተኮቱ ናፍ ኬኔ ጄቱ ሰነ ነንበርበዴሰ።</para>
  <para style="q1" vid="HOS 2:12">አን ደገለ እሳን ነንጎዸ፤</para>
  <para style="q2" vid="HOS 2:12">ብኔንስ ቦሶና እሳን ዼደ።<verse eid="HOS 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 2:13"/>አን ጉዮተ እሼን እት</para>
  <para style="q2" vid="HOS 2:13">በኣሊፍ እጣነ ኣርስቴ ሰናፍ እሼ ነንአደበ፤</para>
  <para style="q1" vid="HOS 2:13">እሼን ቁቤላፊ ፋየ ገራ ገራቲን</para>
  <para style="q2" vid="HOS 2:13">ኦፍ ሚዸግስቴ ምቾተሼ ዱካ ቡቴ ነ እራንፈቴ”</para>
  <para style="q2" vid="HOS 2:13">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="HOS 2:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 2:14"/>“ከናፉ አን አመ እሼ ነንሶሶበ፤</para>
  <para style="q2" vid="HOS 2:14">ገረ ለፈ ገሞጂት እሼ ጌሴ</para>
  <para style="q2" vid="HOS 2:14">ጃለላን እት ነንዱበዸ።<verse eid="HOS 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 2:15"/>አን እዶ ዻባ ወይኒሼ ዴብሴ ነንኬናፍ፤</para>
  <para style="q2" vid="HOS 2:15">ሱሉለ ኣኮርስ በልበለ አብዲ ነንጎዸ።</para>
  <para style="q1" vid="HOS 2:15">እሼን አችት አኩመ ጋፈ ሸመሩማሼት፣</para>
  <para style="q2" vid="HOS 2:15">አኩመ ጋፈ ብየ ግብጢ ባቴት ስርብት።<verse eid="HOS 2:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 2:16"/>“አት ጋፈ ሰነ” ጄዸ <char style="nd">ዋቀዮ</char>፤</para>
  <para style="q2" vid="HOS 2:16">“ ‘ዽርሰኮ’ ጄቴ ነ ዋምተ፤</para>
  <para style="q2" vid="HOS 2:16">አት ለመተ ዴብቴ፣ ‘ጎፍታኮ’ ናን ህንጄቱ።<verse eid="HOS 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 2:17"/>አን መቃወን በኣል አፋንሼቲ ነንበሌሰ፤</para>
  <para style="q2" vid="HOS 2:17">መቃንሳኒ ለመተ ህንዸአሙ።<verse eid="HOS 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="HOS 2:18"/>አን ጋፈስ ብኔንሰ ቦሶናቲፊ ስምብሮተ ሰሚ ወጅን፣</para>
  <para style="q2" vid="HOS 2:18">ኡመመወን ለፈረ ሙኙቀን ወጅን</para>
  <para style="q2" vid="HOS 2:18">እሳኒፍ ከኩ ነንገለ።</para>
  <para style="q1" vid="HOS 2:18">አን አከ እስን ነጋዻን ቡልተኒፍ</para>
  <para style="q2" vid="HOS 2:18">ጥየ፣ ጎራዴፊ ወራነ</para>
  <para style="q2" vid="HOS 2:18">ለፈራ ነንበሌሰ።<verse eid="HOS 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="HOS 2:19"/>አን በረ በራን ኦፊኮቲፍ ስን ካዽመዸ፤</para>
  <para style="q2" vid="HOS 2:19">አን ቀጄሉማፊ ዹጋዻን</para>
  <para style="q2" vid="HOS 2:19">ጃለላፊ ገረ ላፍናን ስን ካዽመዸ።<verse eid="HOS 2:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="HOS 2:20"/>አን አመነሙማዻን ስን ካዽመዸ፤</para>
  <para style="q2" vid="HOS 2:20">አትስ <char style="nd">ዋቀዮን</char> ንቤክተ።”<verse eid="HOS 2:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="HOS 2:21"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፤</para>
  <para style="q2" vid="HOS 2:21">“አን ጋፈስ ዴቢ ሲፍ ነንኬነ፤</para>
  <para style="q1" vid="HOS 2:21">አን ሰሚፍ ዴቢ ነንኬነ፤</para>
  <para style="q2" vid="HOS 2:21">ሰሚንስ ለፋፍ ዴቢ ንኬነ፤<verse eid="HOS 2:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="HOS 2:22"/>ለፍትስ ምዻኒፍ፣ ዳዺ ወይኒ ሃራፊ</para>
  <para style="q2" vid="HOS 2:22">ዘይቲፍ ዴቢ ኬንት፤</para>
  <para style="q2" vid="HOS 2:22">እሳንስ ይዝርኤሊፍ ዴቢ ኬኑ።<verse eid="HOS 2:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="HOS 2:23"/>አን ኦፊኮቲፍ ለፈረ እሼ ነንዻበዸ፤</para>
  <para style="q2" vid="HOS 2:23">አን ከነን፣ ‘አት ጃለሌኮ ምት’ ጄዼን ሰነ ነንጃለዸ።</para>
  <para style="q1" vid="HOS 2:23">አን ወረ፣ ‘እስን ሰበኮ ምት’ ጄዸመን ሰናን፣ ‘እስን ሰበኮት’ ነንጄዸ፤</para>
  <para style="q2" vid="HOS 2:23">እሳንስ፣ ‘አት ዋቀኮት’ ናን ጄዹ።”<verse eid="HOS 2:23"/></para>
  <chapter eid="HOS 2"/>
  <chapter number="3" style="c" sid="HOS 3"/>
  <para style="s1">ሆሴኣን ኒቲ ኦፊት አራረሜ</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 3:1"/>
    <char style="nd">ዋቀዮ</char> አከነ ናን ጄዼ፤ “ነምን ብራ እሼ ጃለቴ እሼን ሰጋገልቱ ታቱዩ፣ አት ዸቂቲ አመስ ኒቲኬት ጃለለኬ አርግሲስ። አኩመ <char style="nd">ዋቀዮ</char> ኡቱመ እሳን ዋቆተ ብራት ዴብአኒ ብጥሌ ወይኒ ጃለተኑ እስራኤሎተ ጃለቴ ሰነ አትስ እሼ ጃለዹ።”<verse eid="HOS 3:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 3:2"/>ከናፉ አን ሜቲ ሰቅሊ ኩዸ ሸኒን፣ ገርቡ ሆሜሪ ቶኮፊ ወለካቲን እሼ ነንብተዼ። <verse eid="HOS 3:2"/><verse number="3" style="v" sid="HOS 3:3"/>አን ኤርገሲ አከነ ነንጄዼን፤ “አት በረ ሄዱ ነ ወጅን ጅራቹ ቀብደ፤ አት ሰጋገልቱ ተኡ ዮካን ነመ ከምዩ ወጅን ቶኮ ተኡ ህንቀብዱ፤ አን ስ ወጅን ነንጅራዸ።”<verse eid="HOS 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 3:4"/>እስራኤሎትን ሞቲ ዮካን እልመ ሞቲ መሌ፣ ኣርሳ ዮካን ኡቱባ ዋቄፈትና መሌ ድረተ ዮካን ዋቆተ ቶልፈሞ መሌ በረ ባይኤ ንጅራቱቲ። <verse eid="HOS 3:4"/><verse number="5" style="v" sid="HOS 3:5"/>ኤርገሲሞ እስራኤሎትን ዴብአኒ <char style="nd">ዋቀዮ</char> ዋቀሳኒቲፊ ዳዊት ሞቲሳኒ በርባዱ። እሳን በረ ዹማ ኬሰ ሆለቻ ገረ <char style="nd">ዋቀዮቲፊ</char> ገረ ኤበሳ ንዹፉ።<verse eid="HOS 3:5"/></para>
  <chapter eid="HOS 3"/>
  <chapter number="4" style="c" sid="HOS 4"/>
  <para style="s1">ህመተሙ እስራኤል</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 4:1"/>ያ እስራኤሎተ፣ <char style="nd">ዋቀዮ</char> እስን ወረ ብየቲ ኬሰ ጅራተንረት</para>
  <para style="q2" vid="HOS 4:1">ህመተ ዽኤፈቱ ዋን ቀቡፍ</para>
  <para style="q2" vid="HOS 4:1">ዱቢ <char style="nd">ዋቀዮ</char> ዸገኣ፦</para>
  <para style="q1" vid="HOS 4:1">“ብየቲ ኬሰ አመነሙማን፣</para>
  <para style="q2" vid="HOS 4:1">ጃለሊፊ ዋቀ ቤኩን ህንጅሩ።<verse eid="HOS 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 4:2"/>አባሩ፣ ሶቡፊ አጄሱ፣</para>
  <para style="q2" vid="HOS 4:2">ሀትናፊ ኤጀ ቆፈቱ ጅረ፤</para>
  <para style="q1" vid="HOS 4:2">እሳን ከኩ ሁንደ ንጨብሱ፤</para>
  <para style="q2" vid="HOS 4:2">ዺገ ዸንገላሱቱ ባይአተ።<verse eid="HOS 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 4:3"/>ሰበቢ ከናፍ ብየቲን ንገድት፤</para>
  <para style="q2" vid="HOS 4:3">ወር እሼ ኬሰ ጅራተን ሁንድስ ንበዱ፤</para>
  <para style="q1" vid="HOS 4:3">ብኔንሶትን ቦሶና፣ ስምብሮትን ሰሚቲፊ</para>
  <para style="q2" vid="HOS 4:3">ቁርጡሚን ገላና ዹማ ጅሩ።<verse eid="HOS 4:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 4:4"/>“ገሩ ነምን ቶኮዩ ዱቢ ህንካስን፤</para>
  <para style="q2" vid="HOS 4:4">ነምን ቶኮዩ ነመ ካን ህንህመትን፤</para>
  <para style="q1" vid="HOS 4:4">ሰብንኬሰን</para>
  <para style="q2" vid="HOS 4:4">አኩመ ነመ ሉበ ህመቱ ቶኮት።<verse eid="HOS 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 4:5"/>አት ሀልከኒፊ ጉያ ጉፈተ፤</para>
  <para style="q2" vid="HOS 4:5">ራጆትንስ እስን ወጅን ጉፈቱ።</para>
  <para style="q1" vid="HOS 4:5">ከናፉ አን ሃዸኬ ነንበሌሰ፤<verse eid="HOS 4:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="HOS 4:6"/>ሰብንኮ ቤኩምሰ ዸቡዻን በዴረ።</para>
  <para style="b" vid="HOS 4:6"/>
  <para style="q1" vid="HOS 4:6">“ዋን አት ቤኩምሰ ቱፈቴፍ</para>
  <para style="q2" vid="HOS 4:6">አንስ አከ አት ሉበ ናፍ ህንታኔፍ ስ ቱፈዼረ፤</para>
  <para style="q1" vid="HOS 4:6">ሰበቢ አት ሴረ ዋቀኬቲ ገቴፍ</para>
  <para style="q2" vid="HOS 4:6">አንስ እልማንኬ ነንገተ።<verse eid="HOS 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 4:7"/>ሉቦትን አኩመ ባይአቻ ዴመኒን፣</para>
  <para style="q2" vid="HOS 4:7">አከሱመ ጩቡ ነት ሆጄቹ ባይእሰን፤</para>
  <para style="q2" vid="HOS 4:7">እሳን ኡልፍነሳኒ ሰልጵነት ጌደረኒሩ።<verse eid="HOS 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 4:8"/>እሳን ጩቡ ሰበኮቲ ኛቱ፤</para>
  <para style="q2" vid="HOS 4:8">ሀምነሳኒስ ንሀዉ።<verse eid="HOS 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 4:9"/>ወን ኩንስ አኩመ ሰባ፣ አኩመ ሉቦታ ተአ።</para>
  <para style="q2" vid="HOS 4:9">አንስ ሰበቢ ከራሳኒቲፍ <optbreak/> ለቸንሳኒዩ ነንአደበ፤</para>
  <para style="q2" vid="HOS 4:9">ሆጂሳኒስ እሳኑመት ነንዴብሰ።<verse eid="HOS 4:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 4:10"/>“እሳን ንኛቱ፤ ገሩ ህንቁፈን፤</para>
  <para style="q2" vid="HOS 4:10">ንሰጋገሉ፤ ገሩ ህንባይአተን፤</para>
  <para style="q1" vid="HOS 4:10">ኩንስ ሰበቢ እሳን <char style="nd">ዋቀዮን</char> ዺሰኒ</para>
  <para style="q2" vid="HOS 4:10">ደበርሰኒ <verse eid="HOS 4:10"/><verse number="11" style="v" sid="HOS 4:11"/>ሰጋገልቱማት፣</para>
  <para style="q1" vid="HOS 4:11">ዳዺ ወይኒ ሞፋፊ</para>
  <para style="q2" vid="HOS 4:11">ሃራ ሁበትናሳኒ ፉዸቴት ኦፍ ኬነኒፍ።<verse eid="HOS 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 4:12"/>ሰብንኮ ዋቀ ሙከራ ቶልፈሜ ጎርሰ ጋፈተ፤</para>
  <para style="q2" vid="HOS 4:12">ኡሌን ፈልፈልቱስ እሳንት ዱበተ።</para>
  <para style="q1" vid="HOS 4:12">ሀፉር ሰጋገልቱማ ከራራ እሳን ጀልእሰ፤</para>
  <para style="q2" vid="HOS 4:12">እሳን ዋቀሳኒቲፍ ህንአመነመን።<verse eid="HOS 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 4:13"/>እሳን ፊጤወን ቱሉረት ቀልመ፣</para>
  <para style="q2" vid="HOS 4:13">ኣርሳ ጉበሙሞ ጋረንረት፣</para>
  <para style="q1" vid="HOS 4:13">ቅልጡ ጀለት፣ አለልቱፊ ሆሚ</para>
  <para style="q2" vid="HOS 4:13">ጋድስንሳኒ ነመት ቶሉ ጀለት ዽኤሱ።</para>
  <para style="q1" vid="HOS 4:13">ከናፉ እንተለንኬሰን ሰጋገልቱማት ዴብኡ፤</para>
  <para style="q2" vid="HOS 4:13">ኒቶትን እልማንኬሰኒስ ኤጀት ዴብኡ።<verse eid="HOS 4:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 4:14"/>“ሰበቢ ወር ዺራዩ ሰጋገልቱማት ዴብአኒ</para>
  <para style="q2" vid="HOS 4:14">ገልመ ዋቄፈትና ኤጃት ቀልመ ዽኤሰኒፍ፣</para>
  <para style="q1" vid="HOS 4:14">ዮሙ እንተለንኬሰን</para>
  <para style="q2" vid="HOS 4:14">ሰጋገልቱማት ዴብአንት</para>
  <para style="q1" vid="HOS 4:14">ዮካን ዮሙ ኒቶትን እልማንኬሰኒ</para>
  <para style="q2" vid="HOS 4:14">ኤጀት ዴብአንት አን እሳን ህንአደቡ፤</para>
  <para style="q2" vid="HOS 4:14">ሰብን ሁበትና ህንቀብኔ ንበዳቲ!<verse eid="HOS 4:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 4:15"/>“ያ እስራኤል፣ አት ዮ ኤጀ ሆጄቴሌ</para>
  <para style="q2" vid="HOS 4:15">አከ ይሁዳን የከ ቀባቱ ህንጎዽን።</para>
  <para style="b" vid="HOS 4:15"/>
  <para style="q1" vid="HOS 4:15">“እስን ግልጋል ህንዸቅና፤</para>
  <para style="q2" vid="HOS 4:15">ቤት ኣዌንትስ ኦል ህንበእና።</para>
  <para style="q2" vid="HOS 4:15">‘ዹጋ <char style="nd">ዋቀዮ</char> ጅራታ!’ ጄተኒስ ህንከከትና።<verse eid="HOS 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 4:16"/>እስራኤሎትን አኩመ ጎሮምሰ</para>
  <para style="q2" vid="HOS 4:16">መታ ጀባቴ ቶኮ መታ ጀቤዪ ተአኒሩ።</para>
  <para style="q1" vid="HOS 4:16">ዮስ <char style="nd">ዋቀዮ</char> አከሚን አከ ጦባላወን ሆላት</para>
  <para style="q2" vid="HOS 4:16">ከሎ በልኣት እሳን ቦባሱ ደንደአሬ?<verse eid="HOS 4:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 4:17"/>ኤፍሬም ዋቆተ ቶልፈሞት ገሌረ፤</para>
  <para style="q2" vid="HOS 4:17">እሰ እቱመ ዺሳ!<verse eid="HOS 4:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="HOS 4:18"/>ዹጋቲንሳኒ ዮ ዹሜዩ</para>
  <para style="q2" vid="HOS 4:18">እሳን ሰጋገልቱማሳኒ እቱመ ፉፉ፤</para>
  <para style="q2" vid="HOS 4:18">ቡልችቶትንሳኒ ኡልፍነረ ቃኒ ጃለቱ።<verse eid="HOS 4:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="HOS 4:19"/>ቡቤን ሀማን ሀጣኤ እሳን በሌሰ፤</para>
  <para style="q2" vid="HOS 4:19">ኣርሳንሳኒስ ቃኒ እሳንት ፍደ።<verse eid="HOS 4:19"/></para>
  <chapter eid="HOS 4"/>
  <chapter number="5" style="c" sid="HOS 5"/>
  <para style="s1">ሙርቲ እስራኤልት ሙርቴፈሜ</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 5:1"/>“እስን ሉቦትን ዋን ከነ ዸገኣ!</para>
  <para style="q2" vid="HOS 5:1">እስራኤሎንስ ቀልቤፈዻ!</para>
  <para style="q1" vid="HOS 5:1">ያ መነ ሞቲ ዸጌፈዹ!</para>
  <para style="q2" vid="HOS 5:1">ሙርቲን ኩን እስንት ሙረመ፦</para>
  <para style="q1" vid="HOS 5:1">እስን ሚስጳት ክዮ፣</para>
  <para style="q2" vid="HOS 5:1">ታቦርረትሞ ጠጦ ድሪርሳ ቱርተን።<verse eid="HOS 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 5:2"/>ፍንጭልቶትን አጄቻት ጀባተኒሩ።</para>
  <para style="q2" vid="HOS 5:2">አን እሳን ሁንደ ነንአደበ።<verse eid="HOS 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 5:3"/>አን ዋኤ ኤፍሬም ሁንደ ቤከ፤</para>
  <para style="q2" vid="HOS 5:3">እስራኤልስ ነ ዱራ ህንዾከቱ።</para>
  <para style="q1" vid="HOS 5:3">ያ ኤፍሬም፣ አት አመ ሰጋገልቱማት ዴብቴርተ፤</para>
  <para style="q2" vid="HOS 5:3">እስራኤልስ ጡራኤረ።<verse eid="HOS 5:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 5:4"/>“ሆጂንሳኒ አከ እሳን ገረ ዋቀሳኒት</para>
  <para style="q2" vid="HOS 5:4">ዴብአን ህንኤየሙፍ።</para>
  <para style="q1" vid="HOS 5:4">ሀፉር ሰጋገልቱማ ገራሳኒ ኬሰ ጅረ፤</para>
  <para style="q2" vid="HOS 5:4">እሳን <char style="nd">ዋቀዮን</char> ህንቤከን።<verse eid="HOS 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 5:5"/>ኦፍ ቱሉማን እስራኤል ዹጋ እሳንት በአ፤</para>
  <para style="q2" vid="HOS 5:5">እስራኤሎትን፣ ኤፍሬም መታንሳዩ <optbreak/> ጩቡሳኒ ኬሰት ጉፈቱ፤</para>
  <para style="q2" vid="HOS 5:5">ይሁዳንስ እሳን ወጅን ጉፈተ።<verse eid="HOS 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 5:6"/>እሳን ዮሙ <char style="nd">ዋቀዮን</char> በርባዱዻፍ</para>
  <para style="q2" vid="HOS 5:6">ቡሻዬፊ ሎንሳኒ ፉዸተኒ ዴመንት፣</para>
  <para style="q1" vid="HOS 5:6">እሰ ህንአርገተን፤</para>
  <para style="q2" vid="HOS 5:6">እን እሳን ዺሴ ዴሜራቲ።<verse eid="HOS 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 5:7"/>እሳን <char style="nd">ዋቀዮፍ</char> አመነሞ ምት፤</para>
  <para style="q2" vid="HOS 5:7">ሴራን አለ እጆሌ ጎዸቱ።</para>
  <para style="q1" vid="HOS 5:7">ዬሮ እሳን አያነ ባቲ ሃራ አያኔፈተንት</para>
  <para style="q2" vid="HOS 5:7">እን ለፈ ቆቲሳሳኒ ንበሌሰ።<verse eid="HOS 5:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 5:8"/>“ግቤኣ ኬሰት መለከተ፣</para>
  <para style="q2" vid="HOS 5:8">ራማ ኬሰትሞ ጋንፈ አፉፋ።</para>
  <para style="q1" vid="HOS 5:8">ቤት ኣዌን ኬሰት እየ ሎላ ዸጌስሳ፤</para>
  <para style="q2" vid="HOS 5:8">ያ ቤንያም፣ አት ዱረ ቀጄል።<verse eid="HOS 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 5:9"/>ጉያ እፈትናት</para>
  <para style="q2" vid="HOS 5:9">ኤፍሬም ንኦነ።</para>
  <para style="q1" vid="HOS 5:9">አን ጎሶተ እስራኤል ግዱት</para>
  <para style="q2" vid="HOS 5:9">ዋን ምርከናኤ ነንለብሰ።<verse eid="HOS 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 5:10"/>ቡልችቶትን ይሁዳ</para>
  <para style="q2" vid="HOS 5:10">አኩመ ነመ ዸጋ ዳሪ ዺቡ ቶኮት።</para>
  <para style="q1" vid="HOS 5:10">አን አኩመ ሎላ ብሻኒ</para>
  <para style="q2" vid="HOS 5:10">ዼከምሰኮ እሳንት ገድ ነንሎላሰ።<verse eid="HOS 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 5:11"/>ኤፍሬም ሰበቢ ዋቆተ ቶልፈሞ</para>
  <para style="q2" vid="HOS 5:11">ዱካ ቡኡ ጃለቴፍ አከ መሌ ሀጩጨሜ</para>
  <para style="q2" vid="HOS 5:11">ሙርቲዻን ለፈት ዽዺተሜ።<verse eid="HOS 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 5:12"/>አን ኤፍሬምት አከ ብሊ፣</para>
  <para style="q2" vid="HOS 5:12">ይሁዳትሞ አከ ዳነኦት።<verse eid="HOS 5:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 5:13"/>“ዮሙ ኤፍሬም ዹኩበሳ፣</para>
  <para style="q2" vid="HOS 5:13">ይሁዳንስ መዳሳ አርጌት፣</para>
  <para style="q1" vid="HOS 5:13">ኤፍሬም ገረ አሶርት ገረገሌ</para>
  <para style="q2" vid="HOS 5:13">ሞትቸ ጉዳ ገርጋርሰ ከዸቹዻፍ <optbreak/> ነመ እት ኤርጌ።</para>
  <para style="q1" vid="HOS 5:13">እን ገሩ እስን ፈይሱ፣</para>
  <para style="q2" vid="HOS 5:13">መዳኬሰንስ ወዬሱ ህንደንደኡ።<verse eid="HOS 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 5:14"/>አን ኤፍሬምት አኩመ ሌንጫ፣</para>
  <para style="q2" vid="HOS 5:14">ይሁዳትስ አኩመ ሳፌለ ሌንጫ ነንተአ።</para>
  <para style="q1" vid="HOS 5:14">አን ገርገር እሳን ጭጭሬን ብራ ዴመ፤</para>
  <para style="q2" vid="HOS 5:14">አን እሳን ጉሬን ዴመ፤ ነምን እሳን ኦልቹስ ህንጅሩ።<verse eid="HOS 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 5:15"/>ኤርገሲ አን ሀመ እሳን</para>
  <para style="q2" vid="HOS 5:15">በሌሳሳኒ ፉዸተንት</para>
  <para style="q2" vid="HOS 5:15">እዶኮት ነንዴብአ።</para>
  <para style="q1" vid="HOS 5:15">እሳን ፉለኮ በርባደቱ፤</para>
  <para style="q2" vid="HOS 5:15">ረኮሳኒ ኬሰት ጀባተኒ ነ በርባደቱ።”<verse eid="HOS 5:15"/></para>
  <chapter eid="HOS 5"/>
  <chapter number="6" style="c" sid="HOS 6"/>
  <para style="s1">እስራኤል ቀልቢ ጅጂረቹ ድዴ</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 6:1"/>“ኮታ ገረ <char style="nd">ዋቀዮት</char> ዴብና።</para>
  <para style="q1" vid="HOS 6:1">እን ኑ ጭጭሬረ፤</para>
  <para style="q2" vid="HOS 6:1">ገሩ ኑ ፈይሰ፤</para>
  <para style="q1" vid="HOS 6:1">እን ኑ መዴሴረ፤</para>
  <para style="q2" vid="HOS 6:1">ገሩ መዳኬኘ ንወልዻነ።<verse eid="HOS 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 6:2"/>አከ ኑ ፉለሳ ዱረ ጅራኑፍ፣</para>
  <para style="q2" vid="HOS 6:2">ጉያ ለመ ቦዴ ኑ በየነቺሰ፤</para>
  <para style="q2" vid="HOS 6:2">ጉያ ሰደፋትሞ ዴብሴ ኑ ዻበ።<verse eid="HOS 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 6:3"/>ኮታ <char style="nd">ዋቀዮን</char> ሃቤክኑ፤</para>
  <para style="q2" vid="HOS 6:3">እሰ ቤኩፍስ ሃተታፈትኑ።</para>
  <para style="q1" vid="HOS 6:3">አኩመ አዱን ዹጉማን ባቱ ሰነ</para>
  <para style="q2" vid="HOS 6:3">እን ዹጉማን ንዹፈ፤</para>
  <para style="q1" vid="HOS 6:3">እን አኩመ ቦካ ገና፣</para>
  <para style="q2" vid="HOS 6:3">አኩመ ቦካ ብራ ከን ለፈ ቁብሱ ሰናት <optbreak/> ገረኬኘ ንዹፈ።<verse eid="HOS 6:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 6:4"/>“ያ ኤፍሬም፣ አን ማለን ስ ጎዸ?</para>
  <para style="q2" vid="HOS 6:4">ያ ይሁዳ፣ አን ማለን ስ ጎዸ?</para>
  <para style="q1" vid="HOS 6:4">ጃለልኬሰን አኩመ ሁሪ ገነማ፣</para>
  <para style="q2" vid="HOS 6:4">አኩመ ፍጤንሰ በሪ በዱት።<verse eid="HOS 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 6:5"/>ከናፉ አን ራጆተኮቲን እስን ጭጭሬ</para>
  <para style="q2" vid="HOS 6:5">ዱቢ አፋንኮቲን እስን ፍጤ፤</para>
  <para style="q2" vid="HOS 6:5">ሙርቲንኮስ አኩመ አዱ ንበአ።<verse eid="HOS 6:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 6:6"/>አን አራረን ፌዸ መሌ ኣርሳ ህንፌዹቲ፤</para>
  <para style="q2" vid="HOS 6:6">ኣርሳ ጉበሙ ጫላ ዋቀ ቤኩ ነንፌዸ።<verse eid="HOS 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 6:7"/>እሳን አኩመ አዳም ከኩ ጨብሰኒሩ፤</para>
  <para style="q2" vid="HOS 6:7">አችትስ አናፍ ህንአመነምኔ።<verse eid="HOS 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 6:8"/>ግልኣድ መጋላ ሀሞታ</para>
  <para style="q2" vid="HOS 6:8">ከን ዺጋን ፋለምቴዸ።<verse eid="HOS 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 6:9"/>አኩመ ሳምቱን ርጵጤ ነመ ኤገቱ ሰነ፣</para>
  <para style="q2" vid="HOS 6:9">ገሬን ሉቦታስ አከሱመ ጎዹ፤</para>
  <para style="q1" vid="HOS 6:9">እሳን የከ ቃኔሳ ሆጄቹዻን</para>
  <para style="q2" vid="HOS 6:9">ከራ ሼኬም እረት ነመ አጄሱ።<verse eid="HOS 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 6:10"/>አን መነ እስራኤል ኬሰት</para>
  <para style="q2" vid="HOS 6:10">ዋን ሱከኔሳ ቶኮ አርጌረ።</para>
  <para style="q1" vid="HOS 6:10">አችት ኤፍሬም ንሰጋገሌ፤</para>
  <para style="q2" vid="HOS 6:10">እስራኤልስ ንጡራኤ።<verse eid="HOS 6:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 6:11"/>“ያ ይሁዳ ስትስ</para>
  <para style="q2" vid="HOS 6:11">ሃመሙን ሙርቴፈሜረ።</para>
  <para style="b" vid="HOS 6:11"/>
  <para style="q1" vid="HOS 6:11">“ዬሮ አን ቦጁ ሰበኮ ዴብሱት፣<verse eid="HOS 6:11"/></para>
  <chapter eid="HOS 6"/>
  <chapter number="7" style="c" sid="HOS 7"/>
  <para style="q2">
    <verse number="1" style="v" sid="HOS 7:1"/>ዬሮ አን እስራኤልን ፈይሱት</para>
  <para style="q1" vid="HOS 7:1">ጩቡን ኤፍሬም ሳጥለሜ</para>
  <para style="q2" vid="HOS 7:1">የክ ሰማርያስ እፈት ባፈመ።</para>
  <para style="q1" vid="HOS 7:1">እሳን ነመ ጎዎምሱ፤</para>
  <para style="q2" vid="HOS 7:1">ሀቱን ጨብስቴ መነ ሴንት፤</para>
  <para style="q2" vid="HOS 7:1">ሳምቶትን ዳንዲረት ነመ ሳሙ፤<verse eid="HOS 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 7:2"/>እሳን ገሩ አከ አን ጀልእነሳኒ ሁንደ</para>
  <para style="q2" vid="HOS 7:2">ያደዹ ህንሁበተን።</para>
  <para style="q1" vid="HOS 7:2">ጩቡንሳኒ እሳን መርሴረ፤</para>
  <para style="q2" vid="HOS 7:2">ዬሮ ሁንደስ ፉለኮ ዱረ ጅረ።<verse eid="HOS 7:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 7:3"/>“እሳን ሀምነሳኒቲን ሞቲ፣</para>
  <para style="q2" vid="HOS 7:3">ሶበሳኒቲንሞ እልማን ሞቲ ገመቺሱ።<verse eid="HOS 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 7:4"/>እሳን ሁንድኑ ኤጅቶተ፣</para>
  <para style="q2" vid="HOS 7:4">አኩመ በዳ እብዳ</para>
  <para style="q1" vid="HOS 7:4">ከን ቶልችቱን ቶኮ ዬሮ ቡኮ ሱኩመኒ ጀልቀቤ</para>
  <para style="q2" vid="HOS 7:4">ሀመ እን ቡካኡት እት ቱቱቁ ህንበርባድኔት።<verse eid="HOS 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 7:5"/>ጉያ አያነ ሞቲኬኛት</para>
  <para style="q2" vid="HOS 7:5">እልማን ሞቶታ ዳዺ ወይኒቲን ፍኒነን፤</para>
  <para style="q2" vid="HOS 7:5">እንስ ቆስቶተ ወጅን ሀርከሳ ድሪርሰ።<verse eid="HOS 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 7:6"/>አኩመ በዳ እብዳት ገራሳኒ ቆጴሰኒሩ፤</para>
  <para style="q2" vid="HOS 7:6">እሳን ደባን ገረሳት ዽኣቱ።</para>
  <para style="q1" vid="HOS 7:6">ኣሪንሳኒ ሀልከን ጉቱ እራ ህንገሉ፤</para>
  <para style="q2" vid="HOS 7:6">ገነመሞ አኩመ አረበ እብዳ በለልአ።<verse eid="HOS 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 7:7"/>ሁንድሳኒ አኩመ በዳ እብዳ ሆኡ፤</para>
  <para style="q2" vid="HOS 7:7">ቡልችቶተሳኒስ ንፍጡ።</para>
  <para style="q1" vid="HOS 7:7">ሞቶትንሳኒ ሁንድኑ ንዹሙ፤</para>
  <para style="q2" vid="HOS 7:7">ቶኮንሳኒዩ ነ ህንዋመተን።<verse eid="HOS 7:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 7:8"/>“ኤፍሬም ሰቦታን ወልት መከመ፤</para>
  <para style="q2" vid="HOS 7:8">ኤፍሬም መጥኖ ገረ ህንገልፈምኒዸ።<verse eid="HOS 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 7:9"/>ነሞትን ኦርማ ሁምነሳ ኛተን፤</para>
  <para style="q2" vid="HOS 7:9">እን ገሩ ህንሁበቱ።</para>
  <para style="q1" vid="HOS 7:9">አሪን እሰት በኤ፤</para>
  <para style="q2" vid="HOS 7:9">እን ገሩ ህንቤኩ።<verse eid="HOS 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 7:10"/>ኦፍ ቱሉማን እስራኤል ዹጋ እሰት በአ፤</para>
  <para style="q2" vid="HOS 7:10">እን ገሩ ኡቱ ወን ኩን ሁንድ አከነ ተኤ ጅሩ፣</para>
  <para style="q1" vid="HOS 7:10">ገረ <char style="nd">ዋቀዮ</char> ዋቀሳት ህንዴብኡ</para>
  <para style="q2" vid="HOS 7:10">ዮካን እሰ ህንበርባደቱ።<verse eid="HOS 7:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 7:11"/>“ኤፍሬም አኩመ ጉጌ</para>
  <para style="q2" vid="HOS 7:11">ጎዋ ሰሙ ህንቀብኔት፤</para>
  <para style="q1" vid="HOS 7:11">እሳን ግብጥን ዋመቱ፤</para>
  <para style="q2" vid="HOS 7:11">እሳን ገረ አሶርት ዴብኡ።<verse eid="HOS 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 7:12"/>ዮሙ እሳን ዴመን አን ክዮኮ እሳንረ ነንቡሰ፤</para>
  <para style="q2" vid="HOS 7:12">አን አኩመ ስምብሮ ሰሚ ገድ እሳን ነንሀርክሰ።</para>
  <para style="q1" vid="HOS 7:12">አን ዮሙን አከ እሳን ወሊ ወጅን ያአን ዸገኡት፣</para>
  <para style="q2" vid="HOS 7:12">እሳን ነንቀበ።<verse eid="HOS 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 7:13"/>ዋን ነራ ጎረኒፍ</para>
  <para style="q2" vid="HOS 7:13">እሳኒፍ ወዮ!</para>
  <para style="q1" vid="HOS 7:13">ዋን ነት ፍንጭለኒፍ</para>
  <para style="q2" vid="HOS 7:13">በዲስን እሳኒፍ መለ!</para>
  <para style="q1" vid="HOS 7:13">አን እሳን ፉሩ ነንበርባደ፤</para>
  <para style="q2" vid="HOS 7:13">እሳን ገሩ ዋኤኮ ሶበ ዱበቱ።<verse eid="HOS 7:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 7:14"/>እሳን ገራሳኒ ጉቱዻን ገረኮት ህንእየተን፤</para>
  <para style="q2" vid="HOS 7:14">ገሩ ስሬሳኒረ ተታአኒ ቦኡ።</para>
  <para style="q1" vid="HOS 7:14">እሳን ምዻኒፊ ዳዺ ወይኒቲፍ ወልት ቀበሙ፤</para>
  <para style="q2" vid="HOS 7:14">ገሩ ነት ፍንጭሉ።<verse eid="HOS 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 7:15"/>አን ሌንጅሴን እሬሳኒ ጀጀቤሴ፤</para>
  <para style="q2" vid="HOS 7:15">እሳን ገሩ ዋን ሀማ ነት ያዱ።<verse eid="HOS 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 7:16"/>እሳን ገረ ዋቀ ዋን ሁንዳ ኦሊት ህንዴብአን፤</para>
  <para style="q2" vid="HOS 7:16">እሳን አኩመ ጥየ ጀልአቴት።</para>
  <para style="q1" vid="HOS 7:16">ሆገንቶትንሳኒ ሰበቢ ሶበ ዱበተኒፍ</para>
  <para style="q2" vid="HOS 7:16">ጎራዴዻን ዹሙ።</para>
  <para style="q1" vid="HOS 7:16">ሰበቢ ከናፍ እሳን ብየ ግብጥት</para>
  <para style="q2" vid="HOS 7:16">ንቱፈተሙ።<verse eid="HOS 7:16"/></para>
  <chapter eid="HOS 7"/>
  <chapter number="8" style="c" sid="HOS 8"/>
  <para style="s1">እስራኤል ቡቤ ሀማ ሃመተ</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 8:1"/>“መለከተ አፋንኬት ካአዹ!</para>
  <para style="q2" vid="HOS 8:1">ሰበቢ ነሞትን ከኩኮ ጨብሰኒ</para>
  <para style="q1" vid="HOS 8:1">ሴረኮት ፍንጭለኒፍ</para>
  <para style="q2" vid="HOS 8:1">ርሳን ቶኮ መነ <char style="nd">ዋቀዮቲን</char> ኦል ጅረ።<verse eid="HOS 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 8:2"/>እስራኤል፣ ‘ያ ዋቀኬኘ ኑ ስ ቤክነ!’ ጄዼ</para>
  <para style="q2" vid="HOS 8:2">ገረኮት እየቴ።<verse eid="HOS 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 8:3"/>ተኡዩ እስራኤል ዋን ጋሪ ድዴረ፤</para>
  <para style="q2" vid="HOS 8:3">ከናፉ ዲን እሰ አርአ።<verse eid="HOS 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 8:4"/>እሳን ወሊ ገልቴኮ መሌ ሞቶተ ሞስፈተን፤</para>
  <para style="q2" vid="HOS 8:4">ኡቱ አን ህንፉዸትኒፍ እልማን ሞቶታ ፍለተን።</para>
  <para style="q1" vid="HOS 8:4">እሳን ሜቲፊ ወርቄሳኒቲን</para>
  <para style="q2" vid="HOS 8:4">በዲሰሳኒቲፍ</para>
  <para style="q2" vid="HOS 8:4">ዋቆተ ቶልፈሞ ኦፊሳኒቲፍ ቶልፈተን።<verse eid="HOS 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 8:5"/>ያ ሰማርያ፣ ዋቀኬ ቶልፈማ ብፈ ጀቢ ሰነ ባሲ ገት!</para>
  <para style="q2" vid="HOS 8:5">ዼከምስኮ እሳንት ቦበአ።</para>
  <para style="q1" vid="HOS 8:5">እሳን ሀመ ዮሚት ቁልቁላኡ ደዸቡ?<verse eid="HOS 8:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="HOS 8:6"/>እሳን ወረ እስራኤል!</para>
  <para style="q1" vid="HOS 8:6">ጀቢ ከነ ኦጌሰ ሆጂ ሀርካቱ ቶልቼ፤</para>
  <para style="q2" vid="HOS 8:6">እን ዋቀ ምት።</para>
  <para style="q2" vid="HOS 8:6">ጀቢን ሰማርያ ንሁራአ።<verse eid="HOS 8:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 8:7"/>“እሳን ቡቤ ፈጫፈተኒ</para>
  <para style="q2" vid="HOS 8:7">ቡቤ ሀማ ሃመቱ።</para>
  <para style="q1" vid="HOS 8:7">ሙክንሳ መታ ህንቀቡ፤</para>
  <para style="q2" vid="HOS 8:7">ደራራስ ህንባሱ።</para>
  <para style="q1" vid="HOS 8:7">ኡቱ እን ምዻን ነቀቴ</para>
  <para style="q2" vid="HOS 8:7">ስላ ነሞትን ኦርማ ንኛቱ ቱሬ።<verse eid="HOS 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 8:8"/>እስራኤል ልቅምፈሜረ፤</para>
  <para style="q2" vid="HOS 8:8">እሳን አመ ሰቦተ ግዱት</para>
  <para style="q2" vid="HOS 8:8">አከ ዋን ፋይዳ ህንቀብኔ ቶኮት።<verse eid="HOS 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 8:9"/>እሳን አኩመ ሀሬ ዲዳ ከን አሲፊ</para>
  <para style="q2" vid="HOS 8:9">አች ኮጳ ጆሩ ገረ አሶሪት ኦል በአኒሩቲ፤</para>
  <para style="q2" vid="HOS 8:9">ኤፍሬምስ ምቾተት ኦፍ ጉርጉሬረ።<verse eid="HOS 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 8:10"/>እሳን ሰቦተ ግዱት ዮ ኦፍ ጉርጉረንዩ</para>
  <para style="q2" vid="HOS 8:10">አን አመ ወልት እሳን ነንቀበ።</para>
  <para style="q1" vid="HOS 8:10">እሳን ሀጩጫ ሞትቸ ጀባ ጀለት</para>
  <para style="q2" vid="HOS 8:10">ንሱኩመሙ።<verse eid="HOS 8:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 8:11"/>“ኤፍሬም ኣርሳ ጩቡቲፍ <optbreak/> እዶ ኣርሳ ሄዱ ዮ ሆጄቴዩ፣</para>
  <para style="q2" vid="HOS 8:11">ለፍት ሱን እዶ ኣርሳ እት ጩቡ ሆጄቹፍ <optbreak/> ቆጴሰን ተኤረ።<verse eid="HOS 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 8:12"/>አን ዋኤ ሴረኮ ዋን ባይኤ እሳኒፍ በሬሴረ፤</para>
  <para style="q2" vid="HOS 8:12">እሳን ገሩ አኩመ ዋን አላ ዹፌ ቶኮት እላሉ።<verse eid="HOS 8:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 8:13"/>እሳን ኣርሳ ናፍ ኬነሜ ዽኤሱ፤</para>
  <para style="q2" vid="HOS 8:13">ፎን ሰነስ ንኛቱ፤</para>
  <para style="q2" vid="HOS 8:13">
    <char style="nd">ዋቀዮ</char> ገሩ እሳንት ህንገመድኔ።</para>
  <para style="q1" vid="HOS 8:13">እን አመ ሀምነሳኒ ያደቴ</para>
  <para style="q2" vid="HOS 8:13">ጩቡሳኒ አደበ፦</para>
  <para style="q2" vid="HOS 8:13">እሳን ገረ ግብጥት ዴብኡ።<verse eid="HOS 8:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 8:14"/>እስራኤል ኡማሳ እራንፈቴ</para>
  <para style="q2" vid="HOS 8:14">መሰራወን ሞቱማ እጃሬ፤</para>
  <para style="q2" vid="HOS 8:14">ይሁዳን መጋላወን ሄዱት ደላ እጃሬ።</para>
  <para style="q1" vid="HOS 8:14">አን ገሩ እብደ ደአኖወንሳኒ</para>
  <para style="q2" vid="HOS 8:14">በርበዴሱ መጋላወንሳኒት ነንኤርገ።”<verse eid="HOS 8:14"/></para>
  <chapter eid="HOS 8"/>
  <chapter number="9" style="c" sid="HOS 9"/>
  <para style="s1">አደቢ እስራኤልት ዹፉ</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 9:1"/>ያ እስራኤል ህንእልልችን፤</para>
  <para style="q2" vid="HOS 9:1">አከ ሰቦተ ካኒ ህንገመድን።</para>
  <para style="q1" vid="HOS 9:1">አት ዋቀኬቲፍ አመነማ ህንቱሬቲ፤</para>
  <para style="q2" vid="HOS 9:1">አት ኦብዲ ሁንደረት ገቲ</para>
  <para style="q2" vid="HOS 9:1">ሰጋገልቱማዻፍ ባፈሙ ጃለቴርተ።<verse eid="HOS 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 9:2"/>ኦብዲወኒፊ እዶን ጩንፋ ወይኒ ሰበ ህንሶረን፤</para>
  <para style="q2" vid="HOS 9:2">ዳዺን ወይኒ ሃራን እሳኒፍ ህንቶሉ።<verse eid="HOS 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 9:3"/>እሳን ብየ <char style="nd">ዋቀዮ</char> ኬሰት ህንሀፈን፤</para>
  <para style="q2" vid="HOS 9:3">ኤፍሬም ገረ ግብጥት ዴብኤ</para>
  <para style="q2" vid="HOS 9:3">አሶር ኬሰት ኛተ ጡራኤ ኛተ።<verse eid="HOS 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 9:4"/>እሳን ዽባዩ ዳዺ ወይኒ <char style="nd">ዋቀዮፍ</char> ህንዽባፈተን፤</para>
  <para style="q2" vid="HOS 9:4">ዮካን ኣርሳንሳኒ እሰ ህንገመቺሱ።</para>
  <para style="q1" vid="HOS 9:4">ኣርሳን አከሲ አኩመ ቡዴነ ወረ ገዳ እሳንት ተአ፤</para>
  <para style="q2" vid="HOS 9:4">ነምን ቡዴነ ከነ ኛቱ ሁንድኑ ንጡራአ።</para>
  <para style="q1" vid="HOS 9:4">ኛትን ኩን ከኑመ መታሳኒ ተአ፤</para>
  <para style="q2" vid="HOS 9:4">መነ ቁልቁሉማ <char style="nd">ዋቀዮስ</char> ኦል ህንሴኑ።<verse eid="HOS 9:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 9:5"/>እስን ጉያ አያነኬሰን ሙርቴፈሜት፣</para>
  <para style="q2" vid="HOS 9:5">ጉዮተ አያነ <char style="nd">ዋቀዮ</char> ሰነት ማል ሆጄቱ?<verse eid="HOS 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 9:6"/>ዮ እሳን በዲሰ ጀላ በአንዩ</para>
  <para style="q2" vid="HOS 9:6">ግብጥ ወልት እሳን ቀብድ፤</para>
  <para style="q2" vid="HOS 9:6">ሜምፊስሞ እሳን አዋለ።</para>
  <para style="q1" vid="HOS 9:6">ቀቤኝ ሜቲሳኒ ሶኮሩዻን ልቅምፈመ፤</para>
  <para style="q2" vid="HOS 9:6">ዱንካነሳኒሞ ቆራቲቱ ሀጉገ።<verse eid="HOS 9:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 9:7"/>ጉዮትን አደቢ ዹፋ ጅሩ፤</para>
  <para style="q2" vid="HOS 9:7">ጉዮትን እት ገቲ ባሰን ዽኣተኒሩ።</para>
  <para style="q2" vid="HOS 9:7">እስራኤል ዋን ከነ ሃቤኩ።</para>
  <para style="q1" vid="HOS 9:7">ሰበቢ ጩቡንኬ አከ መሌ ባይአቴ</para>
  <para style="q2" vid="HOS 9:7">ሀምንኬስ አከ መሌ ጉዳ ተኤፍ፣</para>
  <para style="q1" vid="HOS 9:7">ራጂን አከ ራቱት እላለሜ፤</para>
  <para style="q2" vid="HOS 9:7">ነምን ሀፉረ ዋቃቲን ቀጄልፈሙሞ <optbreak/> አከ መራቱት ሄደሜ።<verse eid="HOS 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 9:8"/>ራጅች ዋቀኮ ወጅን</para>
  <para style="q2" vid="HOS 9:8">ኤግዱ ኤፍሬም ተኤ፤</para>
  <para style="q1" vid="HOS 9:8">ተኡስ ዳንዲሳ ሁንደረት ክዮን እሰ ኤገተ፤</para>
  <para style="q2" vid="HOS 9:8">መነ ዋቀሳ ኬሰትስ ጅብ እሰ ኤገተ።<verse eid="HOS 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 9:9"/>እሳን አኩመ በረ ግቤኣ ኬሰት ተኤ ሰነ</para>
  <para style="q2" vid="HOS 9:9">ጡራኡማ ኬሰ ዽዽመን።</para>
  <para style="q1" vid="HOS 9:9">ዋቅን ሀምነሳኒ ያደቴ</para>
  <para style="q2" vid="HOS 9:9">ሰበቢ ጩቡሳኒቲፍ እሳን አደበ።<verse eid="HOS 9:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 9:10"/>“ዬሮ አን እስራኤልን አርጌት፣</para>
  <para style="q2" vid="HOS 9:10">እን አኩመ እጀ ወይኒ ገሞጂ ኬሰት አርገሜ ቱሬ፤</para>
  <para style="q1" vid="HOS 9:10">ዬሮ አን አቦቲኬሰን አርጌት፣</para>
  <para style="q2" vid="HOS 9:10">እሳን አኩመ ዋን እጀ ጀልቀባ ሀርቡረት አርገሜ ቱረን።</para>
  <para style="q1" vid="HOS 9:10">እሳን ገሩ ዮሙ ገረ በኣል ጴኦር ዹፈንት፣</para>
  <para style="q2" vid="HOS 9:10">ዋቀ ቶልፈማ ቃኔሳ ሰናፍ ኦፍ ቁልቁሌሰኒ</para>
  <para style="q2" vid="HOS 9:10">አኩመ ዋን ጃለተን ሰና ጅብሲሶ ተአን።<verse eid="HOS 9:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 9:11"/>ኡልፍን ኤፍሬም አኩመ ስምብሮ በርሴ በደ፤</para>
  <para style="q2" vid="HOS 9:11">ዸልቹን፣ ገራት ባቹን፣ ኡልፋኡን ህንጅሩ።<verse eid="HOS 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 9:12"/>ዮ እሳን እጆሌ ጉድፈተንዩ</para>
  <para style="q2" vid="HOS 9:12">አን ጀላ ፍጤ እልማን መሌ እሳን ነንሀምብሰ።</para>
  <para style="q1" vid="HOS 9:12">ጋፈ አን እሳንራ ገረገሉ</para>
  <para style="q2" vid="HOS 9:12">እሳኒፍ ወዮ!<verse eid="HOS 9:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 9:13"/>አን ኤፍሬምን እሳ አኩመ ጢሮስ</para>
  <para style="q2" vid="HOS 9:13">ለፈ ነመት ቶሉረ ዻበቴ ጅሩ ነንአርጌ።</para>
  <para style="q1" vid="HOS 9:13">ሰብን ኤፍሬም ገሩ እጆሌሳ ገድ ባሴ</para>
  <para style="q2" vid="HOS 9:13">ወረ ጎጎረኡት ኬነ።”<verse eid="HOS 9:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 9:14"/>ያ <char style="nd">ዋቀዮ</char> እሳኒፍ ኬን፤</para>
  <para style="q2" vid="HOS 9:14">አት ማል እሳኒፍ ኬንተ?</para>
  <para style="q1" vid="HOS 9:14">ገደሜሰ ኡልፈ ህንባትኔፊ</para>
  <para style="q2" vid="HOS 9:14">ሀርመ ጎጎጋ ኬኒፍ።<verse eid="HOS 9:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 9:15"/>“ሰበቢ ሀምነሳኒ ከን ግልጋል ኬሰት ሆጄተሜ ሰነ ሁንዳቲፍ፣</para>
  <para style="q2" vid="HOS 9:15">አን አችት እሳን ነንጅቤ።</para>
  <para style="q1" vid="HOS 9:15">ሰበቢ ሆጂሳኒ ከን ጩቡዻን ጉተሜ ሰናቲፍ</para>
  <para style="q2" vid="HOS 9:15">አን መነኮ ኬሳ እሳን አርአ።</para>
  <para style="q1" vid="HOS 9:15">አን ስአች እሳን ህንጃለዹ፤</para>
  <para style="q2" vid="HOS 9:15">ቡልችቶትንሳኒ ሁንድኑ ፍንጭልቶተ።<verse eid="HOS 9:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 9:16"/>ኤፍሬም ሩኩተሜረ፤</para>
  <para style="q2" vid="HOS 9:16">ህድሳኒ ጎጎጌረ፤</para>
  <para style="q2" vid="HOS 9:16">እሳን እጀ ቶኮሌ ህንጎዸተን።</para>
  <para style="q1" vid="HOS 9:16">ዮ እሳን እጆሌ ጎዸተንዩ</para>
  <para style="q2" vid="HOS 9:16">አን ሰኚሳኒ ጃለተሞ እሳን ጀላ ነንቀለ።”<verse eid="HOS 9:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 9:17"/>ሰበቢ እሳን እሳፍ ህንአጀጀምኒፍ፣</para>
  <para style="q2" vid="HOS 9:17">ዋቅንኮ እሳን ድደ፤</para>
  <para style="q2" vid="HOS 9:17">እሳን ወረ አሲፊ አች ሰቦተ ግዱ ጆሩ ተኡ።<verse eid="HOS 9:17"/></para>
  <para style="b"/>
  <chapter eid="HOS 9"/>
  <chapter number="10" style="c" sid="HOS 10"/>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 10:1"/>እስራኤል ሙከ ወይኒ ደጋጌ ቱሬ፤</para>
  <para style="q2" vid="HOS 10:1">እን መቱመሳቲፍ እጀ ነቀተ።</para>
  <para style="q1" vid="HOS 10:1">አኩመ እጅሳ ባይአቴን</para>
  <para style="q2" vid="HOS 10:1">እን እዶ ኣርሳ ሄዱ እጃረቴ፤</para>
  <para style="q1" vid="HOS 10:1">አኩመ ለፍትሳ ገበቴን</para>
  <para style="q2" vid="HOS 10:1">ኡቱባወን ዋቄፈትናሳ ሚዸግፈቴ።<verse eid="HOS 10:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 10:2"/>ገራንሳኒ ጎዎምሳዻን ጉተሜረ፤</para>
  <para style="q2" vid="HOS 10:2">እሳን አመ የከሳኒ ባዸቹ ቀቡ።</para>
  <para style="q1" vid="HOS 10:2">
    <char style="nd">ዋቀዮ</char> እዶ ኣርሳሳኒ ንዲገ፤</para>
  <para style="q2" vid="HOS 10:2">ኡቱባወን ዋቄፈትናሳኒስ ንበርበዴሰ።<verse eid="HOS 10:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 10:3"/>ኤርገሲ እሳን አከነ ጄዹ፤</para>
  <para style="q2" vid="HOS 10:3">“ኑ ሰበቢ <char style="nd">ዋቀዮን</char> ሶዳቹ ድድኔፍ ሞቲ ህንቀብኑ።</para>
  <para style="q1" vid="HOS 10:3">ገሩ ኡቱ ሞቲ ቀባትኔዩ</para>
  <para style="q2" vid="HOS 10:3">እን ስላ ማል ኑፍ ጎዸ?”<verse eid="HOS 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 10:4"/>እሳን ዋን ሄዱ ዋዳ ገሉ፤</para>
  <para style="q2" vid="HOS 10:4">ከኩ ሶባስ ሴነኒ</para>
  <para style="q2" vid="HOS 10:4">ወሊ ገልቴ ኡመቱ፤</para>
  <para style="q1" vid="HOS 10:4">ከናፉ ሴረ ዸቤዪን</para>
  <para style="q2" vid="HOS 10:4">አኩመ አረማ ሱሚ ቀቡ ከን ለፈ ቆቲሳ ኬሳት ለቱ።<verse eid="HOS 10:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 10:5"/>ነሞትን ሰማርያ ኬሰ ጅራተን</para>
  <para style="q2" vid="HOS 10:5">ሰበቢ ዋቀ ቶልፈማ ፈኪ ጀቢ <optbreak/> ከን ቤት ኣዌን ኬሳ ሰናቲፍ ሶዳቱ።</para>
  <para style="q1" vid="HOS 10:5">ሰብንሼ እሼዻፍ ቦአ።</para>
  <para style="q2" vid="HOS 10:5">ሉቦትንሼ ኤጅቶትን</para>
  <para style="q1" vid="HOS 10:5">ወር ኡልፍነሼቲን ገመደን ሱንስ</para>
  <para style="q2" vid="HOS 10:5">ሰበቢ እሼን እሳንራ ቦጅአምቴፍ ንቦኡ።<verse eid="HOS 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 10:6"/>ጀብችስ አከ ሀርከ ፉዻት</para>
  <para style="q2" vid="HOS 10:6">ያሪም ሞትቻፍ አሶርት ጌፈመ።</para>
  <para style="q1" vid="HOS 10:6">ኤፍሬም ንሰልጵፈመ፤</para>
  <para style="q2" vid="HOS 10:6">እስራኤል ዋቆተሼ ከኔን ሙከራ ቶልፈመኒፍ ንቃኖፍት።<verse eid="HOS 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 10:7"/>ሰማርያፊ ሞቲንሼ</para>
  <para style="q2" vid="HOS 10:7">አኩመ ሆመቸ ብሻንራት ፉዸተመኒ በዱ።<verse eid="HOS 10:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 10:8"/>እዶወን ሰገዳ ከኔን አዌን ንበርበዴፈሙ፤</para>
  <para style="q2" vid="HOS 10:8">ኩንስ ጩቡ እስራኤል።</para>
  <para style="q1" vid="HOS 10:8">ቆራቲፊ ሶኮሩን እረት ብቅሌ</para>
  <para style="q2" vid="HOS 10:8">እዶ ኣርሳሳኒ ሀጉገ።</para>
  <para style="q1" vid="HOS 10:8">ዬሮ ሰነ ነሞትን ቱሉወኒን፣ “ኑረት ጅጋ!”</para>
  <para style="q2" vid="HOS 10:8">ጋረኒንሞ፣ “ኑ ዾክሳ!” ጄዹ።<verse eid="HOS 10:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 10:9"/>“ያ እስራኤል እስን በረ ግቤኣቲ ጀልቀብደኒ <optbreak/> ጩቡ ሆጄተኒርቱ፤</para>
  <para style="q2" vid="HOS 10:9">አመስ አቹመት ሀፍተኒርቱ።</para>
  <para style="q1" vid="HOS 10:9">ግቤኣ ኬሰት ወራን ከኤ</para>
  <para style="q2" vid="HOS 10:9">ጀልኦተ ህንፍጡ?<verse eid="HOS 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 10:10"/>አን ዮን ፌዼ እሳን ነንአደበ፤</para>
  <para style="q2" vid="HOS 10:10">ሰበቢ ጩቡሳኒ ደቻ ሰናቲፍ</para>
  <para style="q2" vid="HOS 10:10">ህዻ ኬሰ እሳን ቡሱፍ <optbreak/> ሰቦትን ናኖሳኒት ወልት ቀበሙ።<verse eid="HOS 10:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 10:11"/>ኤፍሬም ጎሮምሰ ሌንጅፈሜ</para>
  <para style="q2" vid="HOS 10:11">ከን ምዻን ስርብሲሱ ጃለቱዸ፤</para>
  <para style="q1" vid="HOS 10:11">ከናፉ አን ሞርመሼረ</para>
  <para style="q2" vid="HOS 10:11">ዋንጆ ነንካአ።</para>
  <para style="q1" vid="HOS 10:11">አን ኤፍሬምን ነንኦፈ፤</para>
  <para style="q2" vid="HOS 10:11">ይሁዳን ለፈ ቆቲሳ ቆቱ ቀበ፤</para>
  <para style="q2" vid="HOS 10:11">ያቆብስ ብዮ ቡሌሱ ቀበ።<verse eid="HOS 10:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 10:12"/>ኦፊኬሰኒፍ ቀጄሉማ ፈጫፈዻቲ</para>
  <para style="q2" vid="HOS 10:12">እጀ ጃለላ ከን ህንዹምኔ ሃመዻ፤</para>
  <para style="q1" vid="HOS 10:12">ለፈኬሰን ከን ህንቆተምንሌ በቀቅሳ፤</para>
  <para style="q2" vid="HOS 10:12">ዬሮን ኩን ዬሮ ሀመ እን ዹፌ</para>
  <para style="q1" vid="HOS 10:12">ቀጄሉማ እስንት ሮብሱት</para>
  <para style="q2" vid="HOS 10:12">
    <char style="nd">ዋቀዮን</char> በርባደተኒቲ።<verse eid="HOS 10:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 10:13"/>እስን ገሩ ሀምነ ፈጫፈተኒ</para>
  <para style="q2" vid="HOS 10:13">ጀልእነ ሃመተን፤</para>
  <para style="q2" vid="HOS 10:13">እስን እጀ ሶባ ኛተኒርቱ።</para>
  <para style="q1" vid="HOS 10:13">ሰበቢ አት ጀብነኬቲፊ</para>
  <para style="q2" vid="HOS 10:13">ሎልቶተኬ ባይኤ ሰነ አብደቴፍ፣<verse eid="HOS 10:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 10:14"/>አኩመ ሸልማን ጋፈ ሎላት ቤት አርቤልን በሌሴ</para>
  <para style="q2" vid="HOS 10:14">ሃዾተ እጆሌሳኒ ወጅን ብዮት መከመን ሰነ፣</para>
  <para style="q1" vid="HOS 10:14">ደአኖወንኬ ሁንድ ንበርበዳኡ፤</para>
  <para style="q2" vid="HOS 10:14">ሁርሳን ወራናስ ሰበኬት ንከአ።<verse eid="HOS 10:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 10:15"/>ያ ቤትኤል፣ ሰበቢ ሀምንኬ አከ መሌ ጉዳ ተኤፍ፣</para>
  <para style="q2" vid="HOS 10:15">ወን አከሲ ስትስ ንዹፍት።</para>
  <para style="q1" vid="HOS 10:15">ጋፈ ጉያን ሱን በርኡት</para>
  <para style="q2" vid="HOS 10:15">ሞቲን እስራኤል ጉቱማን ጉቱት ንበርበዴፈመ።<verse eid="HOS 10:15"/></para>
  <chapter eid="HOS 10"/>
  <chapter number="11" style="c" sid="HOS 11"/>
  <para style="s1">ጃለለ ዋቅን እስራኤሊፍ ቀቡ</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 11:1"/>“እስራኤል ዬሮ ዳእመ ቱሬት፣ አን እሰ ነንጃለዼ፤</para>
  <para style="q2" vid="HOS 11:1">አን ግብጢ እልመኮ ዋሜረ።<verse eid="HOS 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 11:2"/>ገሩ ሀሙመ አን እት ዴዴብኤ እሳን ዋሙ፣</para>
  <para style="q2" vid="HOS 11:2">እሳን ነራ ፈጋቻ ዴመን።</para>
  <para style="q1" vid="HOS 11:2">እሳን በኣሊፍ ኣርሳ ዽኤሰኒ</para>
  <para style="q2" vid="HOS 11:2">ፈኪወኒፍ እጣነ ኣርሰን።<verse eid="HOS 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 11:3"/>ከን እሬሳኒ ቀቤ ኤፍሬምን</para>
  <para style="q2" vid="HOS 11:3">ሚላን ዴሙ በርሲሴ አኑመ፤</para>
  <para style="q1" vid="HOS 11:3">እሳን ገሩ አከ አን</para>
  <para style="q2" vid="HOS 11:3">እሳን ፈይሴ ህንሁበትኔ።<verse eid="HOS 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 11:4"/>አን ፉኞ ገረ ላፍነ ነማቲን፣</para>
  <para style="q2" vid="HOS 11:4">ህዻ ጃለላቲንስ እሳን ነንሀርክሴ፤</para>
  <para style="q1" vid="HOS 11:4">አን ሞርመሳኒራ ዋንጆ ፉዼ</para>
  <para style="q2" vid="HOS 11:4">እሳን ሶሩፍ ገደን ጄዼ።<verse eid="HOS 11:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 11:5"/>“እሳን ቀልቢ ጅጂረቹ ዋን ድደኒፍ</para>
  <para style="q2" vid="HOS 11:5">ግብጥት ህንዴብአን፤</para>
  <para style="q2" vid="HOS 11:5">አሶር ገሩ እሳን ቡልቸ።<verse eid="HOS 11:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 11:6"/>ጎራዴን መጋላወንሳኒ ኬሰት በለቅሰ፤</para>
  <para style="q2" vid="HOS 11:6">ራጆተ ሶብዱሳኒ ንበርበዴሰ፤</para>
  <para style="q2" vid="HOS 11:6">ከሮረሳኒስ ንፈሸሌሰ።<verse eid="HOS 11:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 11:7"/>ሰብንኮ ነራ ዴብኡፍ ኩተቴረ።</para>
  <para style="q2" vid="HOS 11:7">ዮ እሳን ዋቀ ዋን ሁንዳ ኦሊ ዋመተንዩ</para>
  <para style="q2" vid="HOS 11:7">እን ጎንኩማ ኦል እሳን ህንቀቡ።<verse eid="HOS 11:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 11:8"/>“ያ ኤፍሬም አን አከሚነን ደንደኤ ስ ዺሰ?</para>
  <para style="q2" vid="HOS 11:8">ያ እስራኤል አን አከሚነን ደበርሴ ስ ኬነ?</para>
  <para style="q1" vid="HOS 11:8">አን አከሚነን ደንደኤ አከ አድማ ስ ጎዸ?</para>
  <para style="q2" vid="HOS 11:8">አከሚነን አከ ዜቦኢም ስ ጎዸ?</para>
  <para style="q1" vid="HOS 11:8">ገራንኮ ነ ኬሰት ጌደረሜረ፤</para>
  <para style="q2" vid="HOS 11:8">ገረ ላፍን አን ሲፍ ቀቡ ጉደቴረ።<verse eid="HOS 11:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 11:9"/>አን ዼከምሰኮ ሶዳችሳ ሰነ ገድ ህንዺሱ፤</para>
  <para style="q2" vid="HOS 11:9">ዮካን አን ዴብኤ ኤፍሬምን ህንበሌሱ።</para>
  <para style="q1" vid="HOS 11:9">አን ዋቀ መሌ ነመ ምት፤</para>
  <para style="q2" vid="HOS 11:9">አን እሰ ቁልቁሉ ግዱኬ ጅሩዸ።</para>
  <para style="q2" vid="HOS 11:9">አን ዼከምሳን ህንዹፉ።<verse eid="HOS 11:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 11:10"/>እሳን <char style="nd">ዋቀዮን</char> ዱካ ቡኡ፤</para>
  <para style="q2" vid="HOS 11:10">እን አኩመ ሌንጫ ኣደ፤</para>
  <para style="q1" vid="HOS 11:10">ዮሙ እን ኣዱት</para>
  <para style="q2" vid="HOS 11:10">እልማንሳ ሆለቻ ልጠ ቢፍቱቲ ዹፉ።<verse eid="HOS 11:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 11:11"/>እሳን አኩመ ስምብሮ ግብጥራ፣</para>
  <para style="q2" vid="HOS 11:11">አኩመ ጉጌ ኦለቻ</para>
  <para style="q2" vid="HOS 11:11">አሶርራ ዹፉ።</para>
  <para style="q1" vid="HOS 11:11">አን መነሳኒ ኬሰ እሳን ነንጅራችሰ”</para>
  <para style="q2" vid="HOS 11:11">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="HOS 11:11"/></para>
  <para style="s1">ጩቡ እስራኤል</para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 11:12"/>ኤፍሬም ሶባን፣ መን እስራኤልሞ</para>
  <para style="q2" vid="HOS 11:12">ጎዎምሳዻን ነ መርሴ።</para>
  <para style="q1" vid="HOS 11:12">ይሁዳንስ ዋቀት፣</para>
  <para style="q2" vid="HOS 11:12">አመነማ ቁልቁልቸ ሰነትዩ ፍንጭሌ።<verse eid="HOS 11:12"/></para>
  <chapter eid="HOS 11"/>
  <chapter number="12" style="c" sid="HOS 12"/>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 12:1"/>ኤፍሬም ቡቤ ኛተ፤</para>
  <para style="q2" vid="HOS 12:1">እን ጉያ ጉቱ ቡቤ በአ ቢፍቱ ዱካ ፊገ፤</para>
  <para style="q2" vid="HOS 12:1">ሶባፊ ጎሊስ ንባይእሰ።</para>
  <para style="q1" vid="HOS 12:1">እን አሶር ወጅን ወሊ ገልቴ ጎዸቴ</para>
  <para style="q2" vid="HOS 12:1">ብየ ግብጢት ዘይቲ ኤጄርሳ ኤርገ።<verse eid="HOS 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 12:2"/>
    <char style="nd">ዋቀዮ</char> ዋን ይሁዳ ህመቱ ቀበ፤</para>
  <para style="q2" vid="HOS 12:2">እን አኩመ አመለሳት ያቆብን አደበ፤</para>
  <para style="q2" vid="HOS 12:2">አኩመ ሆጂ እሳትስ ገቲሳ ኬናፍ።<verse eid="HOS 12:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 12:3"/>እን ገደሜሰ ኬሰት ኮሜ ኦቦሌሰሳ ቀቤ፤</para>
  <para style="q2" vid="HOS 12:3">ኤርገ ጉደቴሞ ዋቀ ወጅን ወልኣንሶ ቀቤ።<verse eid="HOS 12:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 12:4"/>እን ኤርገማ ዋቃ ወጅን ወልኣንሶ ቀቤ ሞአቴ፤</para>
  <para style="q2" vid="HOS 12:4">ቦኤስ ሱራ ከዸቴ።</para>
  <para style="q1" vid="HOS 12:4">እን ቤትኤልት እሰ አርገቴ</para>
  <para style="q2" vid="HOS 12:4">አችት እሰ ወጅን ሃሰኤ።<verse eid="HOS 12:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 12:5"/>
    <char style="nd">ዋቀዮ</char> ዋቀ ዋን ሁንደ ደንደኡ፣</para>
  <para style="q2" vid="HOS 12:5">መቃንሳ <char style="nd">ዋቀዮ</char>!<verse eid="HOS 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 12:6"/>አት ገሩ ዋቀኬት ዴብእ፤</para>
  <para style="q2" vid="HOS 12:6">ጃለላፊ ሙርቲ ቀጄላ ጀቤሲ</para>
  <para style="q2" vid="HOS 12:6">ዬሮ ሁንደ ዋቀኬ ኤገዹ።<verse eid="HOS 12:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 12:7"/>ደልደላን መዳሊ ሶባ ኦፍ ሀርካ ቀቡ</para>
  <para style="q2" vid="HOS 12:7">ነመ ጎዎምሱ ጃለተ።<verse eid="HOS 12:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 12:8"/>ኤፍሬም አከነ ጄዼ ቦነ፤</para>
  <para style="q2" vid="HOS 12:8">“አን አከ መሌ ሶሬሰ፤ ቀቤኘ ጉዳ አርገዼረ።</para>
  <para style="q1" vid="HOS 12:8">እሳን ቀቤኘኮ ከነ ሁንደ ኬሰትዩ</para>
  <para style="q2" vid="HOS 12:8">በሌሳ ዮካን ጩቡ ቶኮሌ <optbreak/> ነረት አርገቹ ህንደንደአን።”<verse eid="HOS 12:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 12:9"/>“አን <char style="nd">ዋቀዮ</char> ዋቀኬ</para>
  <para style="q2" vid="HOS 12:9">ከን ብየ ግብጢ ስ ባሴዸ፤</para>
  <para style="q1" vid="HOS 12:9">አን አከ አት አኩመ ጉያ አያኖተኬ <optbreak/> ከኔን ሙርቴፈመን ሰናት</para>
  <para style="q2" vid="HOS 12:9">ዴብቴ ዱንካነ ኬሰ ጅራቱ ስን ጎዸ።<verse eid="HOS 12:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 12:10"/>አን ራጆተት ዱበዼ</para>
  <para style="q2" vid="HOS 12:10">ሙልአተ ሄዱ ኬኔፊ</para>
  <para style="q2" vid="HOS 12:10">ከራሳኒቲን ፈኬኛን ነንዱበዼ።”<verse eid="HOS 12:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 12:11"/>ግልኣድ ሀማዻ?</para>
  <para style="q2" vid="HOS 12:11">ሰብንሼ ፋይዳ ህንቀቡ!</para>
  <para style="q1" vid="HOS 12:11">እሳን ግልጋል ኬሰት ኮርመ ቀሉ?</para>
  <para style="q2" vid="HOS 12:11">እዶን ኣርሳሳኒ አኩመ ቱላ ዸጋ እሰ ለፈ ቆቲሳ</para>
  <para style="q2" vid="HOS 12:11">ከን ቆተሜረ ጅሩ ንተአ።<verse eid="HOS 12:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 12:12"/>ያቆብ ገረ ሶርያት በቀቴ፤</para>
  <para style="q2" vid="HOS 12:12">እስራኤል ኒቲ አርገቹፍ ነመ ተጃጅሌ፤</para>
  <para style="q2" vid="HOS 12:12">ገበረሼ ባሱፍስ ሆሎተ ትክሴ።<verse eid="HOS 12:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 12:13"/>
    <char style="nd">ዋቀዮ</char> ብየ ግብጢቲ እስራኤልን ባሱፍ <optbreak/> ራጂት ፈየደሜ፤</para>
  <para style="q2" vid="HOS 12:13">እን ከሩመ ራጂ ሰናቲን እሰ ኩኑንሴ።<verse eid="HOS 12:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 12:14"/>ኤፍሬም ገሩ ኣሪሳ ጉድቸ ከካሴ፤</para>
  <para style="q2" vid="HOS 12:14">ጎፍታንሳ የከ ዺገ ነማ ዸንገላሱ ሰነ<optbreak/> እሱመት ዴብሰ፤</para>
  <para style="q2" vid="HOS 12:14">አረብሶሳስ መቱመሳት ዴብሰ።<verse eid="HOS 12:14"/></para>
  <chapter eid="HOS 12"/>
  <chapter number="13" style="c" sid="HOS 13"/>
  <para style="s1">
    <char style="nd">ዋቀዮ</char> እስራኤልት ዼከሜ</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 13:1"/>ዬሮ ኤፍሬም ዱበቴት ነሞትን ንሆለተን፤</para>
  <para style="q2" vid="HOS 13:1">እን እስራኤል ኬሰት ኦል ኦል ጄዼ ቱሬ።</para>
  <para style="q2" vid="HOS 13:1">ገሩ የከ በኣልን ዋቄፈቹቲን ዱኤ።<verse eid="HOS 13:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 13:2"/>እሳን አመስ እት ዴዴብአኒ ጩቡ ሆጄቱ፤</para>
  <para style="q2" vid="HOS 13:2">ሜቲ ኦፊሳኒቲን ዋቀ ቶልፈማ ቶልፈቱ፤</para>
  <para style="q1" vid="HOS 13:2">ፈኪ ምሚዸጋ ከኔን ሁንድሳኒ</para>
  <para style="q2" vid="HOS 13:2">ሀርከ ኦጌዪቲን ሆጄተመን።</para>
  <para style="q1" vid="HOS 13:2">ዋኤ ሰበ ከናስ፣</para>
  <para style="q2" vid="HOS 13:2">“እሳን ነመ ቀለኒ ኣርሳ ዽኤሱ፤</para>
  <para style="q2" vid="HOS 13:2">ዋቀ ቶልፈማ ጀቢስ ንዹንገቱ!” ጄዸሜ።<verse eid="HOS 13:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 13:3"/>ከናፉ እሳን አኩመ ሁሪ ገነማ፣</para>
  <para style="q2" vid="HOS 13:3">አኩመ ፍጤንሰ በሪ በዱ፣ አኩመ ሀበቂ</para>
  <para style="q2" vid="HOS 13:3">ኦብዲ ምዻን እት ዸአንራ ከኡ</para>
  <para style="q2" vid="HOS 13:3">አኩመ ኣረ ፎዳዻን በኡ ንተኡ።<verse eid="HOS 13:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 13:4"/>“አን ገሩ ዬሮ አት ግብጢ ባቴ ጀልቀቤ</para>
  <para style="q2" vid="HOS 13:4">
    <char style="nd">ዋቀዮ</char> ዋቀኬት።</para>
  <para style="q1" vid="HOS 13:4">አት አነ መሌ ዋቀ ቶኮሌ ቤኩ ህንቀብዱ፤</para>
  <para style="q2" vid="HOS 13:4">አነ መሌ ፈይሳ ቶኮሌ ህንቀብዱ።<verse eid="HOS 13:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 13:5"/>አን ገሞጂ ኬሰት፣</para>
  <para style="q2" vid="HOS 13:5">ብየ ሆአ ጉባ ኬሰት ስ ኩኑንሴረ።<verse eid="HOS 13:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 13:6"/>ዬሮ አን እሳን ሶሬት ንቁፈን፤</para>
  <para style="q2" vid="HOS 13:6">እሳን ዬሮ ቁፈንት ኦፍ ቱለን፤</para>
  <para style="q2" vid="HOS 13:6">ኤርገሲሞ ነ እራንፈተን።<verse eid="HOS 13:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 13:7"/>ከናፉ አን አኩመ ሌንጫ እሳንት ነንተአ፤</para>
  <para style="q2" vid="HOS 13:7">አኩመ ቄረንሳ ርጴ ዳንዲረት እሳን ነንኤገዸ።<verse eid="HOS 13:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 13:8"/>አን አኩመ አማኬተ እልማንሼ ጀላ ፉዸተመኒት</para>
  <para style="q2" vid="HOS 13:8">እሳን ሎሌ ገራሳኒ ነንበቀቅሰ።</para>
  <para style="q1" vid="HOS 13:8">አን አኩመ ሌንጫት ቆርቄ እሳን ነንኛዸ፤</para>
  <para style="q2" vid="HOS 13:8">ብኔንስ ቦሶና ገርገር እሳን ጭጭረ።<verse eid="HOS 13:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 13:9"/>“ያ እስራኤል፣ ዋን አነ ገርጋራኬ</para>
  <para style="q2" vid="HOS 13:9">ሞርምቴፍ አት በዴርተ።<verse eid="HOS 13:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 13:10"/>አከ ስ ኦልቹፍ ሞቲንኬ ኤሰ ጅረ?</para>
  <para style="q2" vid="HOS 13:10">ቡልችቶትንኬ ወር መጋላኬ ሁንደ ኬሳ</para>
  <para style="q1" vid="HOS 13:10">ከኔን አት፣ ‘ሞቲፊ እልማን ሞቶታ ናፍ ኬን’</para>
  <para style="q2" vid="HOS 13:10">ጄቴ ከዸቴ ሱን ኤሰ ጅሩ?<verse eid="HOS 13:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 13:11"/>አን ኣሪኮቲን ሞቲ ሲፈን ኬኔ፤</para>
  <para style="q2" vid="HOS 13:11">ዼከምሰኮቲንሞ እሰ ስራ ነንፉዸዼ።<verse eid="HOS 13:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 13:12"/>በሌሳን ኤፍሬም ወልት ኩፈሜ</para>
  <para style="q2" vid="HOS 13:12">ጩቡንሳስ ገልሜፈሜረ።<verse eid="HOS 13:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 13:13"/>ሚጡን አኩመ ዱበርቲ ጭኒንሱን ቀበቴት እሰት ዹፈ፤</para>
  <para style="q2" vid="HOS 13:13">እን ገሩ ዳእመ ወላላዸ፤</para>
  <para style="q1" vid="HOS 13:13">እን ዮሙ ዬሮን ገኡት፣</para>
  <para style="q2" vid="HOS 13:13">ገደሜሰ ኬሳ በኡ ህንፌዹ።<verse eid="HOS 13:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 13:14"/>“አን ሰበ ከነ ሁምነ አዋላ ጀላ ነንበራረ፤</para>
  <para style="q2" vid="HOS 13:14">ዱአ ጀላ እሳን ነንባሰ።</para>
  <para style="q1" vid="HOS 13:14">ያ ዱአ፣ ዸእችኬ ሜሬ?</para>
  <para style="q2" vid="HOS 13:14">ያ አዋለ፣ በሌሱንኬ ሜሬ?</para>
  <para style="b" vid="HOS 13:14"/>
  <para style="q1" vid="HOS 13:14">“አን ገረ ላፍነ ቶኮሌ ህንቀባዹ፤<verse eid="HOS 13:14"/></para>
  <para style="q2">
    <verse number="15" style="v" sid="HOS 13:15"/>ዮ እን ኦቦሎተ ኦፊ ግዱ ጅሬኘ ቶላ ጅራቴዩ፣</para>
  <para style="q1" vid="HOS 13:15">ቡቤን በኣ <char style="nd">ዋቀዮ</char> ብራ ንዹፈ፤</para>
  <para style="q2" vid="HOS 13:15">ለፈ ገሞጂ ኬሳ ንቡብሰ፤</para>
  <para style="q1" vid="HOS 13:15">ቡርቃንሳ ብሻን ዸበ፤</para>
  <para style="q2" vid="HOS 13:15">ቦል ብሻንሳስ ንጎገ።</para>
  <para style="q1" vid="HOS 13:15">መንኩስንሳ፣</para>
  <para style="q2" vid="HOS 13:15">ቀቤኝ እን ቀቡ ሁንድስ ንሳመመ።<verse eid="HOS 13:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 13:16"/>ሰብን ሰማርያ ዋን ዋቀሳት ፍንጭሌፍ</para>
  <para style="q2" vid="HOS 13:16">ገቲ በሌሳሳ ንአርገተ።</para>
  <para style="q1" vid="HOS 13:16">እሳን ጎራዴዻን ዹሙ፤</para>
  <para style="q2" vid="HOS 13:16">ዳእመንሳኒ ለፈት ሀርጫፈሙ፤</para>
  <para style="q2" vid="HOS 13:16">ዱበርቶትንሳኒ ከኔን <optbreak/> ኡልፈ ቀበንስ ንበቀቅፈሙ።”<verse eid="HOS 13:16"/></para>
  <chapter eid="HOS 13"/>
  <chapter number="14" style="c" sid="HOS 14"/>
  <para style="s1">ኤበ አርገቹዻፍ ቀልቢ ጅጂረቹ</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 14:1"/>ያ እስራኤል፣ ገረ <char style="nd">ዋቀዮ</char> ዋቀኬቲት ዴብእ።</para>
  <para style="q2" vid="HOS 14:1">አት ሰበቢ ጩቡኬቲቲፍ ጉፈቴቲ!<verse eid="HOS 14:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 14:2"/>ዱብቸ ፉዸዹቲ</para>
  <para style="q2" vid="HOS 14:2">ገረ <char style="nd">ዋቀዮ</char> ዴብእ።</para>
  <para style="q1" vid="HOS 14:2">አከነስ ጄዺን፦</para>
  <para style="q2" vid="HOS 14:2">“ጩቡኬኘ ሁንደ ኑፍ ዺስ፤</para>
  <para style="q1" vid="HOS 14:2">አከ ኑ እጀ አረበኬኛ ሲፍ ዽኤስኑፍ፣</para>
  <para style="q2" vid="HOS 14:2">አርጁማዻን ኑ ስመዹ።<verse eid="HOS 14:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 14:3"/>አሶር ኑ ኦልቹ ህንደንደኡ፤</para>
  <para style="q2" vid="HOS 14:3">ኑ ፈርዴን ሎላ ህንያበትኑ።</para>
  <para style="q1" vid="HOS 14:3">ኑ ስአች ዴብኔ፣ ዋን ሀርክኬኘ ሆጄቴን፣</para>
  <para style="q2" vid="HOS 14:3">‘ዋቆተኬኘ’ ህንጄኑ፤</para>
  <para style="q2" vid="HOS 14:3">ዳእመን አባ ህንቀብኔ ገረ ላፍነ ስራ አርገቱቲ።”<verse eid="HOS 14:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 14:4"/>“አን ገንቱማሳኒ ነንፈይሰ፣</para>
  <para style="q2" vid="HOS 14:4">ቶሉመን እሳን ጃለዸ፤</para>
  <para style="q2" vid="HOS 14:4">ኣሪንኮ እሳንራ ዴብኤራቲ።<verse eid="HOS 14:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 14:5"/>አን እስራኤልት አኩመ ፍጤንሳ ነንተአ፤</para>
  <para style="q2" vid="HOS 14:5">እን አኩመ ደራራ ንደራረ።</para>
  <para style="q1" vid="HOS 14:5">እን አኩመ ጋትራ ልባኖን</para>
  <para style="q2" vid="HOS 14:5">ህደሳ ገድ ፈጌፈተ፤<verse eid="HOS 14:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="HOS 14:6"/>ደሜንሳ ንጉደተ።</para>
  <para style="q1" vid="HOS 14:6">ሚዸግንሳ አኩመ ሙከ ኤጄርሳ ተአ፤</para>
  <para style="q2" vid="HOS 14:6">ኡርጋንሳ አኩመ ጋትራ ልባኖን።<verse eid="HOS 14:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 14:7"/>ነሞትን አመስ ዴብአኒ ጋድሰሳ ጀለ ጅራቱ።</para>
  <para style="q2" vid="HOS 14:7">እን አኩመ ምዻኒ ለልሰ።</para>
  <para style="q1" vid="HOS 14:7">አኩመ ሙከ ወይኒ ደጋገ፤</para>
  <para style="q2" vid="HOS 14:7">መቃንሳስ አኩመ ዳዺ ወይኒ ልባኖን ቤከመ።<verse eid="HOS 14:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 14:8"/>ያ ኤፍሬም፣ አን ከነ ጫላ <optbreak/> ዋቆተ ቶልፈሞ ወጅን ዽመ ማሊን ቀበ?</para>
  <para style="q2" vid="HOS 14:8">ከን ዴቢ ሲፍ ኬኔ ስ ኤጉ አኑመ።</para>
  <para style="q1" vid="HOS 14:8">አን አኩመ ሙከ ብርብርሰ ለልሳት፤</para>
  <para style="q2" vid="HOS 14:8">አመነሙማንኬ አነራ ዹፈ።”<verse eid="HOS 14:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 14:9"/>ነምን ኦጌስ ኤኙ? እን ዋን ከነ ንቤከ።</para>
  <para style="q2" vid="HOS 14:9">ቀልቢ ቀቤስ ኤኙ? እን ዋን ከነ ንሁበተ።</para>
  <para style="q1" vid="HOS 14:9">ከራን <char style="nd">ዋቀዮ</char> ቀጄላዸ፤</para>
  <para style="q2" vid="HOS 14:9">ነምን ቀጄላን እሰረ ዴመ፤</para>
  <para style="q2" vid="HOS 14:9">ፍንጭልቶትን ገሩ እሰረት ጉፈቱ።<verse eid="HOS 14:9"/></para>
  <chapter eid="HOS 14"/>
</usx>
