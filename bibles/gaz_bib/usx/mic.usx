<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MIC" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">ሚክያስ</para>
  <para style="toc1">ራጂ ሚክያስ</para>
  <para style="toc2">ሚክያስ</para>
  <para style="toc3">ሚክ</para>
  <para style="mt2">ራጂ</para>
  <para style="mt1">ሚክያስ</para>
  <chapter number="1" style="c" sid="MIC 1"/>
  <para style="p">
    <verse number="1" style="v" sid="MIC 1:1"/>በረ ዮታም፣ ኣሃዚፊ ህስቅያስ ሞቶተ ይሁዳ ቱረን ኬሰ ዱቢን <char style="nd">ዋቀዮ</char> ገረ ሚክያስ ነምቸ ሞሬሼት ዹፌ፤ ኩንስ ሙልአተ እን ዋኤ ሰማርያቲፊ ዋኤ ዬሩሳሌም አርጌዸ።<verse eid="MIC 1:1"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 1:2"/>ያ ነሞተ፣ እስን ሁንድኑ ዸገኣ፤</para>
  <para style="q2" vid="MIC 1:2">ለፋፊ ወንቶትን እሼረ ጅራተን ሁንድኑ ዸጌፈዻ፤</para>
  <para style="q1" vid="MIC 1:2">
    <char style="nd">ዋቀዮ</char> ጎፍትች፣</para>
  <para style="q2" vid="MIC 1:2">ጎፍታን መነ ቁልቁሉማሳ ቁልቁሉ ሰነ ኬሳ <optbreak/> ዹጋ እስንት በአ።<verse eid="MIC 1:2"/></para>
  <para style="s1">ሙርቲ ሰማርያፊ ዬሩሳሌምን ኤገቱ</para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 1:3"/>ኩኖ! <char style="nd">ዋቀዮ</char> እዶ ጅሬኘሳቲ ዹፋ ጅረ፤</para>
  <para style="q2" vid="MIC 1:3">እን ገድ ዹፌ እዶ ኦል ከኣ ለፋረ ንኤጄተ።<verse eid="MIC 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 1:4"/>አኩመ ገጋ ፉለ እብዳ ዱረ ጅሩ፣</para>
  <para style="q2" vid="MIC 1:4">አኩመ ብሻን ተበራ ገድ ያኡ</para>
  <para style="q1" vid="MIC 1:4">ቱሉወን እሰ ጀለት ንበቁ፤</para>
  <para style="q2" vid="MIC 1:4">ሱሉለወንስ ገርገር በቀቁ።<verse eid="MIC 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 1:5"/>ወን ኩን ሁንድ ሰበቢ ዶጎጎረ ያቆቢፍ፣</para>
  <para style="q2" vid="MIC 1:5">ሰበቢ ጩቡ መነ እስራኤሊፍ ተኤ።</para>
  <para style="q1" vid="MIC 1:5">ዶጎጎር ያቆብ ማል?</para>
  <para style="q2" vid="MIC 1:5">ሰማርያ ምቲ?</para>
  <para style="q1" vid="MIC 1:5">እዶን ሰገዳ ይሁዳ ማል?</para>
  <para style="q2" vid="MIC 1:5">ዬሩሳሌም ምቲ?<verse eid="MIC 1:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 1:6"/>“ከናፉ አን ሰማርያ ቱላ ዲገማ፣</para>
  <para style="q2" vid="MIC 1:6">ለፈ ወይኒ እት ዻበተን ነንጎዸ።</para>
  <para style="q1" vid="MIC 1:6">አን ዸጋወንሼ ሱሉለት ነቄ፣</para>
  <para style="q2" vid="MIC 1:6">ሁንዴሼ ቁላ ነንሀምብሰ።<verse eid="MIC 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 1:7"/>ዋቆትንሼ ቶልፈሞን ሁንድኑ ንሁሬፈሙ፤</para>
  <para style="q2" vid="MIC 1:7">ኬናወን መነ ቁልቁሉማሼ ሁንድኑ እብዳን ጉበሙ፤</para>
  <para style="q2" vid="MIC 1:7">አን ፈኪሼ ሁንደ ነንበርበዴሰ።</para>
  <para style="q1" vid="MIC 1:7">እሼን ገቲ ሰጋገልቶታራ ኬናሼ ወልት ዋን ቀበቴፍ፣</para>
  <para style="q2" vid="MIC 1:7">ኬናን ሱን አመስ ገቲ ሰጋገልቶታ ተኤ ንዴብአ።”<verse eid="MIC 1:7"/></para>
  <para style="s1">ቦኡፊ ገዱ</para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 1:8"/>ሰበቢ ዋን ከናቲፍ አን ቦኤ ነንወዋዸ፤</para>
  <para style="q2" vid="MIC 1:8">አን ሚለ ዱዋፊ ቁላ ነንዴመ።</para>
  <para style="q1" vid="MIC 1:8">አን አኩመ ዋንጎ እዬ፣</para>
  <para style="q2" vid="MIC 1:8">አኩመ ኡሩንጉ ነንኣደ።<verse eid="MIC 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 1:9"/>መዳንሼ ዋን ህንፈይኔፍ፣</para>
  <para style="q2" vid="MIC 1:9">ይሁዳትስ ደርቤረ።</para>
  <para style="q1" vid="MIC 1:9">ከረ ሰበኮ ዱረ ገኤረ፤</para>
  <para style="q2" vid="MIC 1:9">ዬሩሳሌምትስ ዹፌረ።<verse eid="MIC 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 1:10"/>እስን ዋን ከነ ጋት ኬሰት ህንዱበትና፤</para>
  <para style="q2" vid="MIC 1:10">ጎንኩማ ህንቦእና።</para>
  <para style="q1" vid="MIC 1:10">ቤት ሌአፍራት፣</para>
  <para style="q2" vid="MIC 1:10">አዋረ ኬሰ ገንገለዻ።<verse eid="MIC 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 1:11"/>እስን ወር ሻፊር ኬሰ ጅራተን፣</para>
  <para style="q2" vid="MIC 1:11">ቁላፊ ቃኒዻን ደርባ።</para>
  <para style="q1" vid="MIC 1:11">ወር ዘናን ኬሰ ጅራተን፣</para>
  <para style="q2" vid="MIC 1:11">ገድ ህንበአን።</para>
  <para style="q1" vid="MIC 1:11">ቤት ኤዜል ቦእቸረ ጅርት፤</para>
  <para style="q2" vid="MIC 1:11">ኤጉምስሼ እስንራ ፉዸሜረ።<verse eid="MIC 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 1:12"/>ሰበቢ በላን <char style="nd">ዋቀዮ</char> ብራ ዹፌ</para>
  <para style="q2" vid="MIC 1:12">ከረ ዬሩሳሌምዩ ገኤፍ፣</para>
  <para style="q1" vid="MIC 1:12">ወር ማሮት ኬሰ ጅራተን</para>
  <para style="q2" vid="MIC 1:12">ገርጋርሰ አርገቹፍ ውጥርፈቱ።<verse eid="MIC 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 1:13"/>አት ላኪሽ ኬሰ ከን ጅራቱ፣</para>
  <para style="q2" vid="MIC 1:13">ፈርዴን ጋሪት ህዸዹ።</para>
  <para style="q1" vid="MIC 1:13">አት እንተለ ጥዮኒፍ</para>
  <para style="q2" vid="MIC 1:13">ጀልቀበ ጩቡት፤</para>
  <para style="q1" vid="MIC 1:13">ዶጎጎር እስራኤል</para>
  <para style="q2" vid="MIC 1:13">ስእ ኬሰት አርገማቲ።<verse eid="MIC 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 1:14"/>ከናፉ አት ሞሬሼት ጋቲፍ</para>
  <para style="q2" vid="MIC 1:14">ኬና ኬንተ።</para>
  <para style="q1" vid="MIC 1:14">መኔን አክዚብ ሞቶተ እስራኤሊፍ</para>
  <para style="q2" vid="MIC 1:14">ጎዎምስቶተ ተኡ።<verse eid="MIC 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 1:15"/>አን ወረ ማሬሻ ኬሰ ጅራተንት</para>
  <para style="q2" vid="MIC 1:15">ሞአታ ቶኮ ነንፍደ።</para>
  <para style="q1" vid="MIC 1:15">እን ኡልፍነ እስራኤል ተኤ</para>
  <para style="q2" vid="MIC 1:15">ገረ አዱላም ንዹፈ።<verse eid="MIC 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 1:16"/>ሰበቢ ገደ እጆሌ እት ገመዱቲፍ ጄዺ</para>
  <para style="q2" vid="MIC 1:16">መታኬ ሃደዹ፤</para>
  <para style="q1" vid="MIC 1:16">አኩመ ጎጎጮሮ መታኬ ሞሌፈዹ፤</para>
  <para style="q2" vid="MIC 1:16">እሳን ቦጁዻን ስራ ፉዸተሙቲ።<verse eid="MIC 1:16"/></para>
  <chapter eid="MIC 1"/>
  <chapter number="2" style="c" sid="MIC 2"/>
  <para style="s1">ከሮረ ነማቲፊ ከሮረ ዋቃ</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 2:1"/>ወረ ደበ ከሮርፈተን</para>
  <para style="q2" vid="MIC 2:1">ከኔን ስሬሳኒረ <optbreak/> ጪሰኒ ሀምነ ያደኒፍ ወዮ!</para>
  <para style="q1" vid="MIC 2:1">ሰበቢ ዋን ከነ ሆጄቹን ሁምነሳኒ ጀለ ጅሩፍ</para>
  <para style="q2" vid="MIC 2:1">እሳን እፈ በሪቲን ከአኒ ዋን ሰነ ሆጄቱ።<verse eid="MIC 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 2:2"/>እሳን ለፈ ቆቲሳ ከጄለኒ ቀበቱ፤</para>
  <para style="q2" vid="MIC 2:2">መኔንስ አከሱመ ከጄለኒ ፉዸቱ።</para>
  <para style="q1" vid="MIC 2:2">እሳን ጎዎምሳዻን መነ ነማ፣</para>
  <para style="q2" vid="MIC 2:2">ዻለሳስ ንፉዸቱ።<verse eid="MIC 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MIC 2:3"/>ከናፉ <char style="nd">ዋቀዮ</char> አከነ ጄዸ፤</para>
  <para style="q1" vid="MIC 2:3">“ኩኖ አን በላ እስን ጀላ በኡ ህንደንዴኜ ቶኮ</para>
  <para style="q2" vid="MIC 2:3">ሰበ ከነት ፍዱፍ ከሮርፈዼን ጅረ።</para>
  <para style="q1" vid="MIC 2:3">እስን ስአች ኦፍ ቱሉማዻን ጅራቹ ህንደንዴሰን፤</para>
  <para style="q2" vid="MIC 2:3">ዬሮን ኩን ዬሮ ረክና ተኣቲ።<verse eid="MIC 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 2:4"/>በረ ሰነ ኬሰ ነሞትን እስንት ገእሱ፤</para>
  <para style="q2" vid="MIC 2:4">አከነ ጄዸኒስ ፋሩ ቦእቻ ከናን እስንት ቆሱ፤</para>
  <para style="q1" vid="MIC 2:4">‘ኑ ጉቱማን ጉቱት በርበዶፍኔረ፤</para>
  <para style="q2" vid="MIC 2:4">ቀቤኝ ሰበኮቲስ ገርገር ቆደተሜረ።</para>
  <para style="q1" vid="MIC 2:4">እን ነራ ፉዸተ!</para>
  <para style="q2" vid="MIC 2:4">ለፈ ቆቲሳኬኘ ወረ ኑ ሞአተኒፍ ኬነ።’ ”<verse eid="MIC 2:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 2:5"/>ከናፉ አት ነመ እጣዻን ለፈ ቆዱ ቶኮሌ</para>
  <para style="q2" vid="MIC 2:5">ወልዳ <char style="nd">ዋቀዮ</char> ኬሳ ህንቀባቱ።<verse eid="MIC 2:5"/></para>
  <para style="s1">ራጆተ ሶባ</para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 2:6"/>ራጆትንሳኒ፣ “እስን ራጂ ህንዱበትና፤</para>
  <para style="q2" vid="MIC 2:6">ዋኤ ዋን ከና ራጂ ህንዱበትና፤</para>
  <para style="q2" vid="MIC 2:6">ሰልጵን ኑት ህንዹፉ” ጄዹ።<verse eid="MIC 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 2:7"/>ያ መነ ያቆብ፣ “ወን ኩን አከነ ጄዸሙ ቀባ?</para>
  <para style="q2" vid="MIC 2:7">ሀፉር <char style="nd">ዋቀዮ</char> ኦብሰ ህንቀቡ?</para>
  <para style="q2" vid="MIC 2:7">እን ዋን አከሲ ንሆጄታ?”</para>
  <para style="b" vid="MIC 2:7"/>
  <para style="q1" vid="MIC 2:7">“ነመ ከራንሳ ቀጄላ ተኤፍ</para>
  <para style="q2" vid="MIC 2:7">ዱቢንኮ ዋን ጋሪ ህንሆጄቱ?<verse eid="MIC 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 2:8"/>ሰብንኮ አከ ዲናት ከኤረ።</para>
  <para style="q2" vid="MIC 2:8">እስን ነሞተ ያዶ መሌ አቺን ደርበን</para>
  <para style="q2" vid="MIC 2:8">ከኔን ዱላ ገላ ጅረንራ ኡፈተ ባፈቱ።<verse eid="MIC 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 2:9"/>እስን ዱበርቶተ ሰበኮቲ</para>
  <para style="q2" vid="MIC 2:9">መኔንሳኒ በበሬዶ ኬሳ አሪቱ።</para>
  <para style="q1" vid="MIC 2:9">ኤበኮስ በረ በራን</para>
  <para style="q2" vid="MIC 2:9">እጆሌሳኒራ ፉዸቱ።<verse eid="MIC 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 2:10"/>ከኣቲ አሲ ዴማ!</para>
  <para style="q2" vid="MIC 2:10">እዶን ኩን ለፈ ቦቆናኬሰኒ ምት፤</para>
  <para style="q2" vid="MIC 2:10">እሼን ጡሮፍቴ ዲገምቴ በዴርት።<verse eid="MIC 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 2:11"/>ነምን ሶባፊ ጎዎምሳን ቶኮ ዮ ዹፌ፣</para>
  <para style="q2" vid="MIC 2:11">‘አን ዋኤ ዳዺ ወይኒቲፊ</para>
  <para style="q2" vid="MIC 2:11">ዹጋቲ ጭማ ራጂ ሲፍ ነንዱበዸ’ ጄዼ፤</para>
  <para style="q2" vid="MIC 2:11">እን ራጂ ሰበ ከና ተአ!<verse eid="MIC 2:11"/></para>
  <para style="s1">ፉረምን ዋዳ ገለሜ</para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 2:12"/>“ያ ያቆብ፣ አን ዹጉማን</para>
  <para style="q2" vid="MIC 2:12">እስን ሁንደ ወልት ነንቀበ፤</para>
  <para style="q2" vid="MIC 2:12">አን ሀምባ እስራኤል ወልት ነንፍደ።</para>
  <para style="q1" vid="MIC 2:12">አን አኩመ ሆሎተ ጎለ ኬሳት፣</para>
  <para style="q2" vid="MIC 2:12">አኩመ ቡሻዬ ለፈ ዼዳ ጅረኒት ወልት እሳን ነንፍደ፤</para>
  <para style="q2" vid="MIC 2:12">ለፍት ሱንስ ቱተ ነማቲን ጉተምት።<verse eid="MIC 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 2:13"/>እን ጨብሴ ከራ ባሱ ፉለሳኒ ዱረ ዴመ፤</para>
  <para style="q2" vid="MIC 2:13">እሳን ጨብሰኒ ከራን በኡ።</para>
  <para style="q1" vid="MIC 2:13">ሞቲንሳኒ እሳን ዱረ በአ፤</para>
  <para style="q2" vid="MIC 2:13">
    <char style="nd">ዋቀዮ</char> ፉለሳኒ ዱረ ዴመ።”<verse eid="MIC 2:13"/></para>
  <chapter eid="MIC 2"/>
  <chapter number="3" style="c" sid="MIC 3"/>
  <para style="s1">ሆገንቶትኒፊ ራጆትን በላሌፈተመን</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 3:1"/>ኤርገሲ አን አከነን ጄዼ፤</para>
  <para style="q1" vid="MIC 3:1">“እስን ሆገንቶትን ያቆብ፣</para>
  <para style="q2" vid="MIC 3:1">ቡልችቶትን መነ እስራኤል ሜ ዸጌፈዻ።</para>
  <para style="q1" vid="MIC 3:1">እስን ሙርቲ ቀጄላ ቤኩ ህንቀብደኒ?<verse eid="MIC 3:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="MIC 3:2"/>እስን ወር ዋን ጋሪ ጅብተኒ ዋን ሀማ ጃለተን፣</para>
  <para style="q1" vid="MIC 3:2">ወር ሰበኮራ ጎጋ፣</para>
  <para style="q2" vid="MIC 3:2">ለፌሳኒራሞ ፎን ባፍተን፣<verse eid="MIC 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 3:3"/>ወር ፎን ሰበኮ ኛተን፣</para>
  <para style="q2" vid="MIC 3:3">ከኔን ጎጋሳኒ እራ ቁንጭፍተኒ <optbreak/> ለፌሳኒ ጨጨብስተን፣</para>
  <para style="q1" vid="MIC 3:3">እስን ወር አከ ፎን ኤሌት ዋደሙቲፊ</para>
  <para style="q2" vid="MIC 3:3">ኦኮቴት አፌለሙ እሳን ጭጭርተን</para>
  <para style="q2" vid="MIC 3:3">ሙርቲ ቀጄላ ቤኩ ህንቀብደኒ?”<verse eid="MIC 3:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 3:4"/>ኤርገሲ እሳን <char style="nd">ዋቀዮት</char> እየቱ፤</para>
  <para style="q2" vid="MIC 3:4">እን ገሩ ዴቢ ህንኬኑፍ።</para>
  <para style="q1" vid="MIC 3:4">ዬሮ ሰነት እን ሰበቢ ጩቡ</para>
  <para style="q2" vid="MIC 3:4">እሳን ሆጄተኒቲፍ ፉለሳ እሳን ዱራ ንዾክፈተ።<verse eid="MIC 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MIC 3:5"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦</para>
  <para style="q1" vid="MIC 3:5">“ዋኤ ራጆተ</para>
  <para style="q2" vid="MIC 3:5">ሰበኮ ከራራ ጀልእሰኒ፣</para>
  <para style="q1" vid="MIC 3:5">ዮ ነምን ቶኮ ኛተ ኬኔፍ</para>
  <para style="q2" vid="MIC 3:5">እሳን ‘ነጋ’ ለብሱ፤</para>
  <para style="q1" vid="MIC 3:5">ዮ እን አከስ ጎቹ ባቴሞ</para>
  <para style="q2" vid="MIC 3:5">ሎለ እሰት ካሱፍ ቆጳኡ።<verse eid="MIC 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 3:6"/>ከናፉ ኡቱ እስን ሙልአተ ህንአርግን ሀልከን፣</para>
  <para style="q2" vid="MIC 3:6">ኡቱ እስን ሆደ ህንዱበትንሞ ዱከን እስንት ዹፈ።</para>
  <para style="q1" vid="MIC 3:6">አዱን ራጆተት ዺት፤</para>
  <para style="q2" vid="MIC 3:6">ጉያንስ እሳንት ዱከናአ።<verse eid="MIC 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 3:7"/>እላልቶትን ንቃነኡ፤</para>
  <para style="q2" vid="MIC 3:7">ወር ሆደ ዱበተንስ ንሰልጵፈሙ።</para>
  <para style="q1" vid="MIC 3:7">ሰበቢ ዴቢን ቶኮዩ ዋቀ ብራ ህንዹፍኔፍ</para>
  <para style="q2" vid="MIC 3:7">እሳን ሁንድ ፉለ ሀጉገቱ።”<verse eid="MIC 3:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 3:8"/>አን ገሩ ያቆብት በሌሳሳ፣</para>
  <para style="q2" vid="MIC 3:8">እስራኤልትስ ጩቡሳ ህሙፍ</para>
  <para style="q2" vid="MIC 3:8">ሁምናን ጉተሜረ፤</para>
  <para style="q1" vid="MIC 3:8">ሀፉረ <char style="nd">ዋቀዮቲን</char></para>
  <para style="q2" vid="MIC 3:8">ሙርቲ ቀጄላፊ ጀብናን ጉተሜረ።<verse eid="MIC 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 3:9"/>እስን ሆገንቶትን መነ ያቆብ</para>
  <para style="q2" vid="MIC 3:9">ቡልችቶትን መነ እስራኤል</para>
  <para style="q1" vid="MIC 3:9">ወር ሙርቲ ቀጄላ ቱፈተኒ</para>
  <para style="q2" vid="MIC 3:9">ዋን ስሪ ተኤ ሁንደ ጀልእፍተን ዋን ከነ ዸገኣ፤<verse eid="MIC 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 3:10"/>ወር ዺገ ዸንገላሱዻን ጥዮንን፣</para>
  <para style="q2" vid="MIC 3:10">ሀምናንሞ ዬሩሳሌምን እጃርተን ዋን ከነ ዸገኣ።<verse eid="MIC 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 3:11"/>ሆገንቶትንሼ መተኣ ፉዸተኒ ሙርቲ ኬኑ፤</para>
  <para style="q2" vid="MIC 3:11">ሉቦትንሼ ገቲዻን በርሲሱ፤</para>
  <para style="q2" vid="MIC 3:11">ራጆትንሼስ ማለቀ ፉዸተኒ ሆደ ዱበቱ።</para>
  <para style="q1" vid="MIC 3:11">ተኡስ እሳን <char style="nd">ዋቀዮት</char> እርከተኒ፣</para>
  <para style="q2" vid="MIC 3:11">“<char style="nd">ዋቀዮ</char> ግዱኬኘ ጅረ ምቲ?</para>
  <para style="q2" vid="MIC 3:11">በላን ቶኮዩ ኑት ህንዹፉ” ጄዹ።<verse eid="MIC 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 3:12"/>ከናፉ ሰበቢኬሰኒፍ፣</para>
  <para style="q2" vid="MIC 3:12">ጥዮን አኩመ ለፈ ቆቲሳት ቆተምት፤</para>
  <para style="q1" vid="MIC 3:12">ዬሩሳሌምስ ቱላ ዋን ዲገሜ ታት፤</para>
  <para style="q2" vid="MIC 3:12">ጋር መነ ቁልቁሉማስ ተበ ደገላን ልቅምፈሜ ተአ።<verse eid="MIC 3:12"/></para>
  <chapter eid="MIC 3"/>
  <chapter number="4" style="c" sid="MIC 4"/>
  <para style="s1">ቱሉ <char style="nd">ዋቀዮ</char></para>
  <para style="r">
    <ref loc="MIC 4:1-3">4፥1‑3</ref> ኩወፈ – <char style="xt"><ref loc="ISA 2:1-4">እሳ 2፥1‑4</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 4:1"/>በረ ዹማ ኬሰ</para>
  <para style="q1" vid="MIC 4:1">ቱሉን መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char></para>
  <para style="q2" vid="MIC 4:1">ቱሉወን ሁንደ ኬሳ ኦል ዼረቴ ዻበተ፤</para>
  <para style="q1" vid="MIC 4:1">እን ጋረን ጫላ ኦል ኦል ጄዸ፤</para>
  <para style="q2" vid="MIC 4:1">ነሞትንስ እት ያኡ።<verse eid="MIC 4:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MIC 4:2"/>ሰቦትን ባይኤን ዹፈኒ አከነ ጄዹ፤</para>
  <para style="q1" vid="MIC 4:2">“ኮታ ገረ ቱሉ <char style="nd">ዋቀዮ</char>፣</para>
  <para style="q2" vid="MIC 4:2">ገረ መነ ዋቀ ያቆብ ኦል ባና።</para>
  <para style="q1" vid="MIC 4:2">እን አከ ኑ ዳንዲሳረ ዴምኑፍ</para>
  <para style="q2" vid="MIC 4:2">ከራሳ ኑ በርሲሰ።”</para>
  <para style="q1" vid="MIC 4:2">ሴር ጥዮን ኬሳ፣</para>
  <para style="q2" vid="MIC 4:2">ዱቢን <char style="nd">ዋቀዮሞ</char> ዬሩሳሌም ኬሳ ዹፈ።<verse eid="MIC 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 4:3"/>እን ነሞተ ሄዱ ግዱት ሙርቲ ኬኔ</para>
  <para style="q2" vid="MIC 4:3">ሰቦተ ጀጀቦ ገርገር ፈጎ ጅረንስ ወልት አራርሰ።</para>
  <para style="q1" vid="MIC 4:3">እሳን ጎራዴሳኒ ቱመኒ ማረሻ፣</para>
  <para style="q2" vid="MIC 4:3">ኤቦሳኒሌ ሃምቱ ቶልፈቱ።</para>
  <para style="q1" vid="MIC 4:3">ሰብን ቶኮ ሰበ ብራት ጎራዴ ህንሉቅፈቱ</para>
  <para style="q2" vid="MIC 4:3">ዮካን ወራናፍ ጄዸኒ ስአች ነመ ህንሌንጅሰን።<verse eid="MIC 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 4:4"/>ነምን ሁንድ ሙከ ወይኒሳቲፊ</para>
  <para style="q2" vid="MIC 4:4">ሙከ ሀርቡሳ ጀለ ታአ፤</para>
  <para style="q1" vid="MIC 4:4">
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ ዱበቴራቲ</para>
  <para style="q2" vid="MIC 4:4">ነምን እሳን ሶዳችሱ ቶኮዩ ህንጅሩ።<verse eid="MIC 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 4:5"/>ሰቦትን ሁንድኑ</para>
  <para style="q2" vid="MIC 4:5">መቃ ዋቆተሳኒቲን ዴዴብኡ፤</para>
  <para style="q1" vid="MIC 4:5">ኑሞ በረ በራ ሀመ በረ በራት</para>
  <para style="q2" vid="MIC 4:5">መቃ <char style="nd">ዋቀዮ</char> ዋቀኬኛቲን ዴዴብነ።<verse eid="MIC 4:5"/></para>
  <para style="s1">ከሮረ <char style="nd">ዋቀዮ</char></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 4:6"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፤</para>
  <para style="q2" vid="MIC 4:6">“አን በረ ሰነ ናፈ ወልትን ቀበ፤</para>
  <para style="q1" vid="MIC 4:6">ወረ ቦጅአመኒፊ</para>
  <para style="q2" vid="MIC 4:6">ወረ አን ገድሲሴስ ወልትን ቀበ።<verse eid="MIC 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 4:7"/>አን ወረ ናፈ ሀምባ፣</para>
  <para style="q2" vid="MIC 4:7">ወረ አርአሜሞ ሰበ ጀባ ነንጎዸ።</para>
  <para style="q1" vid="MIC 4:7">
    <char style="nd">ዋቀዮ</char> ጉያ ሰና ጀልቀቤ</para>
  <para style="q2" vid="MIC 4:7">ሀመ በረ በራት ቱሉ ጥዮንረት ቡልቻሳኒ ተአ።<verse eid="MIC 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 4:8"/>ያ ገሞ ኤጉምሰ ቡሻዬ፣</para>
  <para style="q2" vid="MIC 4:8">ያ ደኦ እንተለ ጥዮን፣</para>
  <para style="q1" vid="MIC 4:8">ኦል ኣንቱማን ዱሪ ሲፍ ንዴብፈመ፤</para>
  <para style="q2" vid="MIC 4:8">ሞቱማን እንተለ ዬሩሳሌም ንዹፈ።”<verse eid="MIC 4:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 4:9"/>አት አመ ማሊፍ አከነ እይቴ ቦሰ?</para>
  <para style="q2" vid="MIC 4:9">አት ሞቲ ህንቀብዱ?</para>
  <para style="q1" vid="MIC 4:9">ወን አት አከ ዱበርቲ ጭኒንሱን ቀቤ ሚጠቱፍ</para>
  <para style="q2" vid="MIC 4:9">ጎርሳንኬ በዴቲ?<verse eid="MIC 4:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 4:10"/>ያ እንተለ ጥዮን፣</para>
  <para style="q2" vid="MIC 4:10">አኩመ ዱበርቲ ጭኒንሱን ቀቤት ኣድ፤</para>
  <para style="q1" vid="MIC 4:10">አት አመ በኬ ኬሰ ቁበቹፍ</para>
  <para style="q2" vid="MIC 4:10">መጋላ ኬሳ በኡ ቀብዳቲ።</para>
  <para style="q1" vid="MIC 4:10">አት ባብሎን ዸቅጠ፤</para>
  <para style="q2" vid="MIC 4:10">አችት ንበራረምተ።</para>
  <para style="q1" vid="MIC 4:10">
    <char style="nd">ዋቀዮ</char> አችት</para>
  <para style="q2" vid="MIC 4:10">ሀርከ ዲነኬቲ ኬሳ ስፉረ።<verse eid="MIC 4:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 4:11"/>አመ ገሩ ሰቦትን ሄዱን ስ መርሰኒሩ።</para>
  <para style="q2" vid="MIC 4:11">እሳንስ፣ “እሼን ሃጡሮፍቱ፤</para>
  <para style="q1" vid="MIC 4:11">እጅኬኘ ጥዬፈቴ</para>
  <para style="q2" vid="MIC 4:11">ጥዮንን ሃእላሉ!” ጄዹ።<verse eid="MIC 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 4:12"/>እሳን ገሩ ያደ <char style="nd">ዋቀዮ</char> ህንቤከን፤</para>
  <para style="q2" vid="MIC 4:12">እሳን ከሮረሳ ከን እን አኩመ ብሲ</para>
  <para style="q2" vid="MIC 4:12">ኦብዲት ወልት ቀቤ ሰነ ህንሁበተን።<verse eid="MIC 4:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 4:13"/>“ያ እንተለ ጥዮን ከኢቲ ምዻን ዸእ፤</para>
  <para style="q2" vid="MIC 4:13">አን ጋንፈ ስቢላ ሲፍ ነንኬናቲ፤</para>
  <para style="q1" vid="MIC 4:13">አን ኮቴ ናሲ ሲፍ ነንኬነ፤</para>
  <para style="q2" vid="MIC 4:13">አትስ ሰቦተ ባይኤ ጨጨብስተ።”</para>
  <para style="q1" vid="MIC 4:13">አት ሆሪ እሳን ከራ ሀማዻን አርገተን <char style="nd">ዋቀዮፍ</char> ኬንተ፤</para>
  <para style="q2" vid="MIC 4:13">ቀቤኘሳኒስ ጎፍታ ለፈ ሁንዳቲፍ ኬንተ።<verse eid="MIC 4:13"/></para>
  <chapter eid="MIC 4"/>
  <chapter number="5" style="c" sid="MIC 5"/>
  <para style="s1">ቡልቻ ቤትልሄሚ ዹፉ</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 5:1"/>ያ መጋላ ራያ ወራና፣ ራያኬ ህሪርስ፤</para>
  <para style="q2" vid="MIC 5:1">ኑ መርፈምኔራቲ።</para>
  <para style="q1" vid="MIC 5:1">እሳን ኡሌዻን</para>
  <para style="q2" vid="MIC 5:1">መዲ ቡልቻ እስራኤል ዸኡ።<verse eid="MIC 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 5:2"/>“ገሩ ያ ቤትልሄም ኤፍራታ፣</para>
  <para style="q2" vid="MIC 5:2">አት ዮ በልበለ ይሁዳ ኬሳ ጥኖ ታቴዩ፣</para>
  <para style="q1" vid="MIC 5:2">ከን ቡልቻ እስራኤል ተኡ፣</para>
  <para style="q2" vid="MIC 5:2">ከን ጅራቹንሳ ዱሩማ፣</para>
  <para style="q1" vid="MIC 5:2">ከን በረ ዱሪቲ ጀልቀቤ ቱሬ ቶኮ</para>
  <para style="q2" vid="MIC 5:2">ስ ኬሳ በኤ ናፍ ዹፈ።”<verse eid="MIC 5:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 5:3"/>ከናፉ እስራኤል</para>
  <para style="q2" vid="MIC 5:3">ሀመ እሼን ጭኒንስፈቻ ጅርቱ ዴሴ</para>
  <para style="q1" vid="MIC 5:3">ኦቦሎትንሳ ወር ሀፈን</para>
  <para style="q2" vid="MIC 5:3">እስራኤሎተት መከሙፍ ዴብአንት ኮጳ ሀፍት።<verse eid="MIC 5:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 5:4"/>እን ጀብነ <char style="nd">ዋቀዮቲን</char></para>
  <para style="q2" vid="MIC 5:4">ሱራ መቃ <char style="nd">ዋቀዮ</char>፣ ዋቀሳቲን</para>
  <para style="q2" vid="MIC 5:4">ዻበቴ ቡሻዬሳ ትክፈተ።</para>
  <para style="q1" vid="MIC 5:4">ዬሮ ሰነት ሱራንሳ</para>
  <para style="q2" vid="MIC 5:4">ዋን ዳሪ ለፋ ገኡፍ እሳን ነጋዻን ጅራቱ።<verse eid="MIC 5:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 5:5"/>እን ነጋኬኘ ተአ፤</para>
  <para style="q2" vid="MIC 5:5">ዬሮ ወር አሶር ብየኬኘ ዌረረኒ</para>
  <para style="q2" vid="MIC 5:5">ደአትኖኬኘ ኬሰ በአንት</para>
  <para style="q1" vid="MIC 5:5">ኑ ትክሶተ ቶርባፊ</para>
  <para style="q2" vid="MIC 5:5">አጀጁወን ሰዴት እት ከካስነ።<verse eid="MIC 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 5:6"/>እሳን ብየ አሶር ጎራዴዻን</para>
  <para style="q2" vid="MIC 5:6">ብየ ናምሩድስ ጎራዴ ሉቅፈሜን ቡልቹ።</para>
  <para style="q1" vid="MIC 5:6">ዬሮ ወር አሶር ብየኬኘ ዌረረኒ</para>
  <para style="q2" vid="MIC 5:6">ዳሪኬኘ ኬሰ በአንት፣</para>
  <para style="q2" vid="MIC 5:6">እን ወረ አሶር ሰነ ጀላ ኑ ባሰ።<verse eid="MIC 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 5:7"/>ሀምባን ያቆብ</para>
  <para style="q2" vid="MIC 5:7">ነሞተ ሄዱ ግዱት</para>
  <para style="q1" vid="MIC 5:7">አኩመ ፍጤንሰ <char style="nd">ዋቀዮ</char> ብራ ዹፉ፣</para>
  <para style="q2" vid="MIC 5:7">አኩመ ቲፉ መርገራ</para>
  <para style="q1" vid="MIC 5:7">ከን ነመ ህንኤግኔ</para>
  <para style="q2" vid="MIC 5:7">ዮካን እልማን ነማ ህንኤገትኔ ተአ።<verse eid="MIC 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 5:8"/>ሀምባን ያቆብ ሰቦተ ግዱት፣</para>
  <para style="q2" vid="MIC 5:8">ኡመተ ሄዱ ግዱትስ፣</para>
  <para style="q1" vid="MIC 5:8">አኩመ ሌንጨ ብኔንሶተ ቦሶና ግዱ ጅሩ፣</para>
  <para style="q2" vid="MIC 5:8">አኩመ ሌንጨ ሳፌለ ቡሻዬ ግዱ ጅሩ</para>
  <para style="q1" vid="MIC 5:8">ከን እረ ኤጄቴ እሳን ጭጭሩቲፊ</para>
  <para style="q2" vid="MIC 5:8">ከን ነምን ቶኮዩ ሀርካ ቡሱ ህንደንዴኜ ተአ።<verse eid="MIC 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 5:9"/>ሀርክኬ ሞአናዻን ዲኖተኬት ከአ፤</para>
  <para style="q2" vid="MIC 5:9">አመጃጆንኬ ሁንድኑ ንበርበዴፈሙ።<verse eid="MIC 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MIC 5:10"/>
    <char style="nd">ዋቀዮ</char> አከነ ጄዸ፤</para>
  <para style="q1" vid="MIC 5:10">“ጋፈስ አን ፈርዴንኬሰን ግዱኬሰኒ ነንበሌሰ፤</para>
  <para style="q2" vid="MIC 5:10">ጋሪወንኬሰን ከን ወራናስ ነንበርበዴሰ።<verse eid="MIC 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 5:11"/>አን መጋላወን ብየኬሰኒ ነንበርበዴሰ፤</para>
  <para style="q2" vid="MIC 5:11">ደአኖወንኬሰን ሁንደስ ነንዲገ።<verse eid="MIC 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 5:12"/>አን ፈልፈልቶተኬሰን ነንበሌሰ፤</para>
  <para style="q2" vid="MIC 5:12">እስንስ ዴብተኒ ህንሞርተን።<verse eid="MIC 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 5:13"/>አን ፈኪወንኬ ሶፈሞፊ ኡቱባወን ዋቄፈትናኬቲ</para>
  <para style="q2" vid="MIC 5:13">ግዱኬቲ ነንበሌሰ፤</para>
  <para style="q1" vid="MIC 5:13">አት ስአች ገድ ጄቴ</para>
  <para style="q2" vid="MIC 5:13">ሆጂ ሀርከኬቲቲፍ ህንሰገዱ።<verse eid="MIC 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 5:14"/>አን ሲዳ ኣሼራ ግዱኬቲ ቡቅሴ</para>
  <para style="q2" vid="MIC 5:14">መጋላወንኬስ ነንበርበዴሰ።<verse eid="MIC 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 5:15"/>አን ሰቦተ ናፍ ህንአጀጀምንረት</para>
  <para style="q2" vid="MIC 5:15">ኣሪፊ ዼከምሳን ሃሎ ነንበአ።”<verse eid="MIC 5:15"/></para>
  <chapter eid="MIC 5"/>
  <chapter number="6" style="c" sid="MIC 6"/>
  <para style="s1">
    <char style="nd">ዋቀዮ</char> እስራኤልራ ዱቢ ቀበ</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 6:1"/>ዋን <char style="nd">ዋቀዮ</char> ጄዹ ዸጌፈዻ፦</para>
  <para style="q1" vid="MIC 6:1">“ኦል ከከኣቲ ፉለ ቱሉወኒ ዱረት ዱቢኬሰን ዽኤፈዻ፤</para>
  <para style="q2" vid="MIC 6:1">ጋረንስ ዋን እስን ጄተን ሃዸገአን።<verse eid="MIC 6:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 6:2"/>“ያ ቱሉወን ህመተ <char style="nd">ዋቀዮ</char> ዸገኣ፤</para>
  <para style="q2" vid="MIC 6:2">ሁንዴወን ለፋ ከኔን በረ በራ እስንስ ዸጌፈዻ።</para>
  <para style="q1" vid="MIC 6:2">
    <char style="nd">ዋቀዮ</char> ሰበሳራ ዱቢ ቀባቲ፤</para>
  <para style="q2" vid="MIC 6:2">እን እስራኤል ወጅን ፈልሚ ቀበ።<verse eid="MIC 6:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 6:3"/>“ያ ሰበኮ፣ አን ማለን ስ ጎዼ?</para>
  <para style="q2" vid="MIC 6:3">አን ማሊነን ስ ደዸብሲሴ? ሜ ዴቢ ናፍ ኬን።<verse eid="MIC 6:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 6:4"/>አን ብየ ግብጢ ስን ባሴ</para>
  <para style="q2" vid="MIC 6:4">ብየ ገርቡማ ኬሳ ስን ፉሬ።</para>
  <para style="q1" vid="MIC 6:4">አን አከ እን ስ ቀጄልቹፍ ሙሴ፣</para>
  <para style="q2" vid="MIC 6:4">አከሱመስ አሮኒፊ ሚርያምን ሲፈን ኤርጌ።<verse eid="MIC 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 6:5"/>ያ ሰበኮ፣ ሜ ጎርሰ ባላቅ ሞቲን ሞኣብ ጋፈቴፊ</para>
  <para style="q2" vid="MIC 6:5">ዴቢ በለኣም እልም ቤኦር ኬኔፍ ያደዹ።</para>
  <para style="q1" vid="MIC 6:5">አት አከ ሆጂ ቀጄሉማ <char style="nd">ዋቀዮ</char> ቤክቱፍ</para>
  <para style="q2" vid="MIC 6:5">ከራ አት ሽጢሚ ሀመ ግልጋልት ዴምቴ ሰነ ያደዹ።”<verse eid="MIC 6:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 6:6"/>አን ማሊነን ፉለ <char style="nd">ዋቀዮ</char> ዱረ ዹፌ</para>
  <para style="q2" vid="MIC 6:6">ፉለ ዋቀ ኦል ጉባ ጅሩ ዱረት ሰገደ?</para>
  <para style="q1" vid="MIC 6:6">አን ኣርሳ ጉበሙን፣</para>
  <para style="q2" vid="MIC 6:6">ጀቢ ወጋ ቶኮቲን ፉለሳ ዱረት ዽኣዹ?<verse eid="MIC 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 6:7"/>
    <char style="nd">ዋቀዮ</char> ኮርቤዪ ሆላ ኩመ ሄዱት፣</para>
  <para style="q2" vid="MIC 6:7">ዘይቲ ለገ ኩመ ኩዸኒት ንገመዳ?</para>
  <para style="q1" vid="MIC 6:7">አን እልመኮ ሀንገፈ፣ ሰበቢ የከኮቲቲፍ፣</para>
  <para style="q2" vid="MIC 6:7">ሰበቢ ጩቡ ሉቡኮቲቲፍስ ዸለ ገራኮ ኣርሳ ዽኤሱ?<verse eid="MIC 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 6:8"/>ያ ነመ፣ እን ዋን ጋሪ ስ አርግሲሴረ።</para>
  <para style="q2" vid="MIC 6:8">
    <char style="nd">ዋቀዮ</char> ማል ስራ በርባደ?</para>
  <para style="q1" vid="MIC 6:8">ሙርቲ ቀጄላ ኬኑፊ አራረ ጃለቹ፣</para>
  <para style="q2" vid="MIC 6:8">አከ አት ገድ ኦፍ ቀብዴ ዋቀኬ ወጅን ዴምቱ <optbreak/> ስራ በርባደ ምቲ?<verse eid="MIC 6:8"/></para>
  <para style="s1">የካፊ አደበሙ እስራኤል</para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 6:9"/>እስን ዸጌፈዻ! <char style="nd">ዋቀዮ</char> አከነ ጄዼ መጋለቲ ዋመ፦</para>
  <para style="q2" vid="MIC 6:9">መቃኬ ሶዳቹን ኦጉማዸ፤</para>
  <para style="q2" vid="MIC 6:9">“ኡሌፊ እሰ ኡሌ ሰነ ፍለቴ ቀልቤፈዻ።<verse eid="MIC 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 6:10"/>ያ መነ ሀማ፣ አን ቀቤኘ እስን ደባን አርገተኒፊ</para>
  <para style="q2" vid="MIC 6:10">መዳሊ ሶባ አባረማ ሰነ እራንፈዻ?<verse eid="MIC 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 6:11"/>አን ነመ መዳሊ ሶባቲን ሆጄቱፊ</para>
  <para style="q2" vid="MIC 6:11">ከን መዳሊ ሶባ ኮሮጆት ባቱ አከሱመት ዺሳ?<verse eid="MIC 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 6:12"/>ሶሬዪንሼ ጀልኦተ፤</para>
  <para style="q2" vid="MIC 6:12">ኡመትንሼ ሶብዶተ፤</para>
  <para style="q2" vid="MIC 6:12">አረብንሳኒስ ጎዎምሳ ዱበተ።<verse eid="MIC 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 6:13"/>ከናፉ አን ሰበቢ ጩቡኬሰኒቲፍ እስን ዲጌ፣</para>
  <para style="q2" vid="MIC 6:13">እስን በሌሱ ጀልቀቤረ።<verse eid="MIC 6:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 6:14"/>አት እኑመ ኛተ፤ ገሩ ህንቁፍቱ፤</para>
  <para style="q2" vid="MIC 6:14">ገራንኬ አመሌ ዱዋዸ።</para>
  <para style="q1" vid="MIC 6:14">አት ንካአተ፤ ገሩ ሆማ ሲፍ ህንኩፈሙ፤</para>
  <para style="q2" vid="MIC 6:14">ዋን አት ኩፈቱ ሰነ አን ጎራዴት ኬናቲ።<verse eid="MIC 6:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 6:15"/>አት ንፈጫፈተ፤ ገሩ ህንሃመቱ፤</para>
  <para style="q2" vid="MIC 6:15">ኤጄርሰ ንጩንፈተ፤ ገሩ ዘይቲሳ ህንድበቱ፤</para>
  <para style="q2" vid="MIC 6:15">እጀ ወይኒ ንጩንፈተ፤ ገሩ ዳዺ ወይኒ ህንዹግዱ።<verse eid="MIC 6:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 6:16"/>አት ስርነ ኦምሪቲፊ</para>
  <para style="q2" vid="MIC 6:16">ሆጂ መነ አሃብ ሁንደ ጀቤስቴርተ፤</para>
  <para style="q2" vid="MIC 6:16">ጎርሰሳኒስ ዱካ ቡቴርተ።</para>
  <para style="q1" vid="MIC 6:16">ከናፉ አን ስበሌሴ፣</para>
  <para style="q2" vid="MIC 6:16">ኡመተኬ ነንሰልጵሰ፤</para>
  <para style="q2" vid="MIC 6:16">እስን ቱፊ ሰቦታ ንባቱ።”<verse eid="MIC 6:16"/></para>
  <chapter eid="MIC 6"/>
  <chapter number="7" style="c" sid="MIC 7"/>
  <para style="s1">ዽጰቹ እስራኤል</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 7:1"/>አናፍ ወዮ!</para>
  <para style="q1" vid="MIC 7:1">አን አኩመ ነመ ዬሮ ቀርሚ ቦና ፉናነንት</para>
  <para style="q2" vid="MIC 7:1">ወይኒ ወልት ቀቡ ቶኮ ተኤረ፤</para>
  <para style="q1" vid="MIC 7:1">ሁርቡን ወይኒ ከን ኛተሙ ቶኮዩ ህንጅሩ፤</para>
  <para style="q2" vid="MIC 7:1">እጅ ሀርቡ ጀልቀባ ከን አን ዸረኡ ቶኮዩ ህንጅሩ።<verse eid="MIC 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 7:2"/>ነምን ጋሪን ለፈራ በዴረ፤</para>
  <para style="q2" vid="MIC 7:2">ነምን ቀጄላን ቶኮዩ ህንሀፍኔ።</para>
  <para style="q1" vid="MIC 7:2">ነሞትን ሁንድኑ ዺገ <optbreak/> ዸንገላሱፍ ርጰኒ ኤገቱ፤</para>
  <para style="q2" vid="MIC 7:2">ቶኮን ቶኮን ነማ <optbreak/> ክዮዻን ኦቦሌሰሳ ኤገተ።<verse eid="MIC 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 7:3"/>ሀርክ ለቹ ዋን ሀማ ሆጄቹ በረቴረ፤</para>
  <para style="q2" vid="MIC 7:3">ቡልቻን ኬና በርባደ፤</para>
  <para style="q1" vid="MIC 7:3">አባን ሙርቲስ መተኣ ፉዸተ፤</para>
  <para style="q2" vid="MIC 7:3">ነምን ሁምነ ቀቡ ዋኑመ ፌዼ ዱበተ፤</para>
  <para style="q2" vid="MIC 7:3">ሁንድሳኒ ወሊ ወጅን መለቱ።<verse eid="MIC 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 7:4"/>ከን እሳን ሁንደ ጫላ ጋሪ ተኤ አከ ሶኮሩት፤</para>
  <para style="q2" vid="MIC 7:4">እን አከ መሌ ቀጄላንሞ ደላ ቆራቲ ጫለ።</para>
  <para style="q1" vid="MIC 7:4">ጉያን ኤግዶተኬቲ፣</para>
  <para style="q2" vid="MIC 7:4">ጉያን እት ዋቅን ስ እላሉ ዹፌረ።</para>
  <para style="q2" vid="MIC 7:4">አመ ዬሮ እት እሳን ጆንጀአኒዸ።<verse eid="MIC 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 7:5"/>ኦላ ህንአመነትን፤</para>
  <para style="q2" vid="MIC 7:5">ምቹስ ህንአብደትን።</para>
  <para style="q1" vid="MIC 7:5">እሼ ሀመቴ ጪፍቱ ብረትዩ</para>
  <para style="q2" vid="MIC 7:5">አረበኬ ኤገዹ።<verse eid="MIC 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 7:6"/>እልም አባሳ ቱፈተ፤</para>
  <para style="q2" vid="MIC 7:6">እንተል ሃዸሼት፣</para>
  <para style="q1" vid="MIC 7:6">ኒቲን እልማስ አማቲሼት ካት፤</para>
  <para style="q2" vid="MIC 7:6">ዲኖትን ነማ ምሴንሶቱመ መነሳ ተኡቲ።<verse eid="MIC 7:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 7:7"/>አን ገሩ አብዲዻን <char style="nd">ዋቀዮን</char> ነንኤገዸ፤</para>
  <para style="q2" vid="MIC 7:7">ፈይሳኮ ዋቀ ነንኤገዸ፤</para>
  <para style="q2" vid="MIC 7:7">ዋቅንኮ ነ ዸገአ።<verse eid="MIC 7:7"/></para>
  <para style="s1">እስራኤል ንካት</para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 7:8"/>ያ ዲነኮ ነት ህንገመድን!</para>
  <para style="q2" vid="MIC 7:8">አን ዮን ኩፌዩ ነንከአ።</para>
  <para style="q1" vid="MIC 7:8">አን ዱከነ ኬሰ ታኡዩ</para>
  <para style="q2" vid="MIC 7:8">
    <char style="nd">ዋቀዮ</char> እፈ ናፍ ተአ።<verse eid="MIC 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 7:9"/>አን ሰበቢን ጩቡ እሰት ሆጄዼፍ፣</para>
  <para style="q2" vid="MIC 7:9">ሀመ እን ዱቢኮ እላሌ ናፍ ሙርቴሱት</para>
  <para style="q2" vid="MIC 7:9">ዼከምሰ ዋቀዮ ነንባዸ።</para>
  <para style="q1" vid="MIC 7:9">እን እፈት ነ ባሰ፤</para>
  <para style="q2" vid="MIC 7:9">አንስ ቀጄሉማሳ ነንአርገ።<verse eid="MIC 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 7:10"/>ኤርገሲ ዲንኮ እሼን፣</para>
  <para style="q2" vid="MIC 7:10">“<char style="nd">ዋቀዮ</char> ዋቅንኬ ኤሰ ጅረ?” ናን ጄቴ ሱን</para>
  <para style="q2" vid="MIC 7:10">ዋን ከነ አርግቴ ቃኒን ሀጉገምት።</para>
  <para style="q1" vid="MIC 7:10">እጅኮ ኩፋቲሼ ንአርገ፤</para>
  <para style="q2" vid="MIC 7:10">እሼን አመዩ ሚለ ጀለት</para>
  <para style="q2" vid="MIC 7:10">አኩመ ዾቄ ዳንዲራት ዽዺተምት።<verse eid="MIC 7:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 7:11"/>ጉያን እት ደላንኬ እጃረሙ፣</para>
  <para style="q2" vid="MIC 7:11">ጉያን እት ዳንጋንኬ በልእፈሙ ቶኮ ንዹፈ።<verse eid="MIC 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 7:12"/>ጋፈስ ነሞትን</para>
  <para style="q2" vid="MIC 7:12">አሶሪፊ መጋላወን ግብጥ፣</para>
  <para style="q1" vid="MIC 7:12">ግብጢ ሀመ ኤፍራጢስትዩ፣</para>
  <para style="q2" vid="MIC 7:12">ገላና ሀመ ገላናት፣</para>
  <para style="q2" vid="MIC 7:12">ቱሉዻ ሀመ ቱሉት ጅራተን ገረኬ ንዹፉ።<verse eid="MIC 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 7:13"/>ሰበቢ ጅራቶተሼቲፊ</para>
  <para style="q2" vid="MIC 7:13">ሰበቢ ዋን እሳን ሆጄተኒቲፍ ለፍት ንኦንት።<verse eid="MIC 7:13"/></para>
  <para style="s1">ከዸትናፊ ገለተ</para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 7:14"/>ኡመተኬ፣ ቡሻዬ ዻለኬቲ</para>
  <para style="q2" vid="MIC 7:14">ከኔን ኦፉማን ቦሶነ ኬሰ፣</para>
  <para style="q1" vid="MIC 7:14">ለፈ ዼዳ ገበታረ ጅራተን</para>
  <para style="q2" vid="MIC 7:14">ኡሌኬቲን ትክፈዹ።</para>
  <para style="q1" vid="MIC 7:14">እሳን አኩመ በረ ዱሪት</para>
  <para style="q2" vid="MIC 7:14">ባሻኒፊ ግልኣድ ኬሰ ሃቦበአን።<verse eid="MIC 7:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 7:15"/>“አን አኩመ ዬሮ አት ግብጢ ባቴ ዹፍቴ ሰና</para>
  <para style="q2" vid="MIC 7:15">ድንቂኮ እሳን ነንአርግሲሰ።”<verse eid="MIC 7:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 7:16"/>ሰቦትን አርገኒ ንቃነኡ፤</para>
  <para style="q2" vid="MIC 7:16">ሁምነ ኦፊ ሁንደዩ ንዸቡ።</para>
  <para style="q1" vid="MIC 7:16">እሳን አፋንሳኒ ቀበቱ፤</para>
  <para style="q2" vid="MIC 7:16">ጉርሳኒስ ንዱደ።<verse eid="MIC 7:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="MIC 7:17"/>እሳን አኩመ ቦፋ፣</para>
  <para style="q2" vid="MIC 7:17">አኩመ ኡመመወን ለፈረ ሎአኒ ብዮ አራቡ።</para>
  <para style="q1" vid="MIC 7:17">እሳን ሆለቻ ሆልቀ ኬሳ በአኒ ዹፉ፤</para>
  <para style="q2" vid="MIC 7:17">እሳን <char style="nd">ዋቀዮ</char> ዋቀኬኘ ሶዳቹዻን</para>
  <para style="q2" vid="MIC 7:17">ዴብአኒ ፉለኬ ዱረ ሶዳዻን ዻበቱ።<verse eid="MIC 7:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MIC 7:18"/>ዋቅን አከኬቲ ከን ጩቡ ነማ ብረ ደርቤ</para>
  <para style="q2" vid="MIC 7:18">በሌሳ ሀምባ ዻለሳ ዺሱፍ ኤኙ?</para>
  <para style="q1" vid="MIC 7:18">አት አራረ ጎቹት ገመደ መሌ</para>
  <para style="q2" vid="MIC 7:18">በረ በራን ህንዼከምቱ።<verse eid="MIC 7:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="MIC 7:19"/>አት ዴብቴ ገራ ኑ ላፍተ፤</para>
  <para style="q2" vid="MIC 7:19">ጩቡኬኘ ሚለኬ ጀለት ዽዺቴ</para>
  <para style="q2" vid="MIC 7:19">በሌሳኬኘ ሁንደስ ቱጁበ ገላናት <optbreak/> ገድ ደርበተ።<verse eid="MIC 7:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="MIC 7:20"/>አት አኩመ በረ ዱሪ</para>
  <para style="q2" vid="MIC 7:20">አቦቲኬኛፍ ከከቴ ሰነ</para>
  <para style="q1" vid="MIC 7:20">ያቆቢፍ አመነማ ታተ፤</para>
  <para style="q2" vid="MIC 7:20">አብረሃምትስ ጃለለ ንአርግሲፍተ።<verse eid="MIC 7:20"/></para>
  <chapter eid="MIC 7"/>
</usx>
