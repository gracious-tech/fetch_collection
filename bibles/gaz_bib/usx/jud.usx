<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JUD" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">ይሁዳ</para>
  <para style="toc1">ይሁዳ</para>
  <para style="toc2">ይሁዳ</para>
  <para style="toc3">ይሁ</para>
  <para style="mt1">ይሁዳ</para>
  <chapter number="1" style="c" sid="JUD 1"/>
  <para style="s1">ነጋ ጋፈቹ</para>
  <para style="po">
    <verse number="1" style="v" sid="JUD 1:1"/>ይሁዳ ኦቦሌሰ ያቆብ ገርብቸ ዬሱስ ክርስቶስራ።</para>
  <para style="po" vid="JUD 1:1">ገረ ወረ ዋመመኒ ዋቀ አባዻን ጃለተመን ከኔን ዬሱስ ክርስቶሲን ኤገመኒት።<verse eid="JUD 1:1"/></para>
  <para style="po">
    <verse number="2" style="v" sid="JUD 1:2"/>አራር፣ ነጋኒፊ ጃለል እስኒፍ ሃባይአቱ።<verse eid="JUD 1:2"/></para>
  <para style="s1">ጩቡፊ በዲሰ ወረ ዋቃፍ ህንቡሌ</para>
  <para style="p">
    <verse number="3" style="v" sid="JUD 1:3"/>ያ ምቾተ፣ አን ዋኤ ፈይነ ኑ ወሊ ወጅን ቆደኑ ከና እስኒፍ በሬሱፍ ጉድሴ ነንሀወን ቱሬ፤ ገሩ አከ እስን አመንቲ ዬሮ ቶኮ በረ በራን ቁልቁሎተ ዋቃት እማና ኬነሜ ሰናፍ ጀባተኒ ሎልተኒፍ እስኒፍ በሬሴ እስን ጎርሱን በርባችሳ ነት ፈካቴ። <verse eid="JUD 1:3"/><verse number="4" style="v" sid="JUD 1:4"/>ነሞትን በረ ዼራን ዱረ ሙርቲ ከናፍ ሙርቴፈመን ቶኮ ቶኮ ሎአኒ ግዱኬሰን ሴነኒሩቲ። እሳንስ ነሞተ ዋቃፍ ህንቡሌ፣ ወረ አያነ ዋቀኬኛ ገረ ሀለሉማት ጌደረን ከኔን ጎፍታ ኦል ኣና ቶክቸ ጄቹንስ ጎፍታኬኘ ዬሱስ ክርስቶስን ገነኒዸ።<verse eid="JUD 1:4"/></para>
  <para style="s1">ፈኬኘ ሙርቲ ገንቶተት ሙረሜ</para>
  <para style="p">
    <verse number="5" style="v" sid="JUD 1:5"/>ዮ እስን ዱራኑ ዋን ከነ ሁንደ ቤክተንሌ፣ አን አከ ጎፍታን ዬሮ ቶኮ ሰበሳ ግብጢ ባሴ ኤርገሲሞ ወረ ህንአመንን በሌሴ እስን ያደቺሱ ነንበርባደ። <verse eid="JUD 1:5"/><verse number="6" style="v" sid="JUD 1:6"/>እንስ ኤርገሞተ ሰደርካ ታይታሳኒረ ህንቱርን፣ ከኔን ለፈ ጅሬኘሳኒ ዺሰን ሰነ ፎንጫ በረ በራቲን ህዼ ሀመ ሙርቲ ጉያ ጉዳ ሰናት ዱከነ ኬሰ ቱርሴረ። <verse eid="JUD 1:6"/><verse number="7" style="v" sid="JUD 1:7"/>ሶዶሚፊ ጎሞራን፣ መጋላወን ናኖሳኒ ጅረንስ አከሱመ ሀለሉማፊ ሀዊ ፎኒ ከን ሃለ ኡመማቲን አለ ተኤት ደበርሰኒ ኦፍ ኬነኒሩ። እሳንስ ወረ አደበ እብደ በረ በራቲን አደበመኒፍ ፈኬኘ ተአኒሩ።<verse eid="JUD 1:7"/></para>
  <para style="s1">ገንቶተ በረ ይሁዳ</para>
  <para style="p">
    <verse number="8" style="v" sid="JUD 1:8"/>ሃሉመ ወል ፈካቱንስ ነሞትን አብጆተን ኩኔን ፎን ኦፊሳኒ ጡሬሱ፤ ጎፍቱማ ንቱፈቱ፤ ኡልፍነ ቀቤዪሌ ንአረብሱ። <verse eid="JUD 1:8"/><verse number="9" style="v" sid="JUD 1:9"/>ገሩ ሚካኤል ሀንገፍን<note caller="+" style="f"><char style="fr" closed="false">1፥9 </char><char style="fq" closed="false">ሀንገፍን </char><char style="fqa" closed="false">ኤርገማ ሀንገፈ ዮካን ቡልቻ ኤርገሞታ </char><char style="ft" closed="false">– ኤርገሞተ ከኔን ኬሳ ጀአ <char style="rq">1 ሄኖክ 20፥2‑7</char> ኬሰት ኤረመኒሩ። መቃንሳኒስ “ሩፋኤል፣ ራጉኤል፣ ሚካኤል፣ ሳራቄል፣ ገብርኤሊፊ ራማኤል” ፌአ። ሚካኤል ክታበ <char style="xt"><ref loc="DAN 12:1">ዳን 12፥1</ref></char> እረት አከ እስራኤሎተ ኤጉ እብሰሜረ። እን ጀልቀበት አከ ኤርገማ ሰበ እስራኤልራ ሁምነ ዲያብሎስ ኤጉ ቶኮት እላለመ ቱሬ። <char style="xt"><ref loc="REV 12:7">ሙል 12፥7</ref></char> እረት ሚካኤል አከ ወልዶተ ክርስታናራ ቦፍቸ ሴጠነ ጄዸሙ ሰነ ኤጉ እብሰሜረ።</char></note> ኤርገሞተ ዋቃዩ ዬሮ ዋኤ ሬፈ ሙሴረት<note caller="+" style="f"><char style="fr" closed="false">1፥9 </char><char style="fq" closed="false">ሬፈ ሙሴ </char><char style="ft" closed="false">– ኦዱን ኩን ከኩ ሞፋ ኬሰት ህንአርገሙ። ከኩን ሞፋን አከ ነምን ቶኮሌን ለፈ ሙሴን እት አዋለሜ ህንቤክኔ ዱበተ (<char style="xt"><ref loc="DEU 34:6">ኬዴ 34፥6</ref></char>)። ገሩ ዬሮ ሙሴን ዱኤት አከ እን ሬፈ ሙሴ አዋሉፍ አከ እት ጋፈተምን ሚካኤልት ኬነሜ ነምች ኦርጌን ጄዸሙ ቶኮ ወጋ አራራ ኬሰ ወጋ ጀልቀባት በሬሴ ቱሬ። ተኡስ ዲያብሎስ ዋን ቡልቻ አዱኛ ቱሬፍ ሬፈ ሙሴረት ጎፍቱማ ኦፊ አርግሲሱ ያሌ። ዮሙ ሚካኤል ሬፈ ሙሴ ኬኑፊ ድዴትሞ ሰበቢ ሙሴን ነመ ግብጥ ቶኮ አጄሴፍ እሰ ህመቹፍ ዱቢ በርባዴ (<char style="xt"><ref loc="EXO 2:12">በኡ 2፥12</ref></char>)። ሚካኤል ገሩ ሴጠነ አባሩዻን ዴቢ ህንኬንኔ፤ ቆደ ከና ሀርኩመ ኦፊቲን ሙሴ አዋሌ።</char></note> ዲያብሎሲን ወልት ፈልመንት፣ “ጎፍታን ስ ሃእፈቱ!” ጄዼ መሌ እሰ አረብሱዻን እት ሙሩፍ እጀ ህንጀባትኔ። <verse eid="JUD 1:9"/><verse number="10" style="v" sid="JUD 1:10"/>ነሞትን ኩኔን ገሩ ዋኑመ ህንሁበትኔ አረብሱ፤ ዋን እሳን አኩመ ብኔንሶተ ዋ ያዱ ህንደንዴኜት ሚራን ሁበተንቱ እሳን በሌሰ።<verse eid="JUD 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JUD 1:11"/>እሳኒፍ ወዮ! እሳን ከራ ቃይንረ ዴመን፤ ፋይዳ አርገቹፍ ጄዸኒ ዶጎጎረ በለኣም ኬሰ ኦፍ ቡሰን፤ ፍንጭለ ቆራሂቲንስ<note caller="+" style="f"><char style="fr" closed="false">1፥11 </char><char style="fq" closed="false">ፍንጭለ ቆራሂቲንስ </char><char style="ft" closed="false">– ቆራህ ተጃጅለ ሉቡማ ኬሰት ቆደ ቀባቹ ጄዼ ነሞተ ብራ 250 ወጅን ዱረ ቡኡማ ሙሴቲፊ አሮንረት ፍንጭሌ። ዹመረት ወር ፍንጭለን ሁንድኑ ምሴንሶተ ማቲሳኒ ሁንደ ወጅን ለፈ አፋን በነቴን ልቅምፈመን (<char style="xt"><ref loc="NUM 16:1-35">ለኮ 16፥1‑35</ref></char>)።</char></note> ንበርበዳአን።<verse eid="JUD 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JUD 1:12"/>ነሞትን ኩኔን ኡቱመ ጡራኦ ተአኒ ጅረኑ ቃኒ ቶኮ መሌ ጭዸ ጃለላ<note caller="+" style="f"><char style="fr" closed="false">1፥12 </char><char style="fq" closed="false">ጭዸ ጃለላ </char><char style="ft" closed="false">– ወልዳ ክርስታና ከን ዱሪ ኬሰት ዬሮ ምሴንሶትን ቶኩማሳኒ ከን ዋቃፊ ወሊሳኒቲፍ ቀበን እብሱፍ ወልት ዹፈንት እርባተ ሀልከኒቱ ቱሬ። “ጭዽ ጃለላ” ዬሮ ሁንደ እርባተ ቶኩማቲን ሆበአ።</char></note> እስን ወጅን ኛቱ፤ እሳን ትክሶተ ኦፉመሳኒ ቆፈ ሶረኒዸ። እሳን አኩመ ዱሜሰ ቦካ ህንቀብኔ ከን ቡቤን አሲፊ አች ኦፉት፤ አኩመ ሙከ ዬሮ እት እጀ ነቀቹ ቀቡት እጀ ዸቤ ቡቅፈሜ ደቻ ለመ ዱኤት። <verse eid="JUD 1:12"/><verse number="13" style="v" sid="JUD 1:13"/>እሳን ወረ አከ ደምበሊ ገላና ሆመቸ ቃኒሳኒ ባሰኒዸ፤ አኩመ ኡርጂወን አሲፊ አች ጆረን ከኔን ዱከን ልምጢን ሀመ በረ በራት እሳኒ ካአሜት።<verse eid="JUD 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JUD 1:14"/>ሄኖክ እን አዳምራ ጀልቀቤ ቶርበፋ ቱሬ ሱን አከነ ጄዼ ዋኤ ነሞተ ከና ራጂ ዱበቴረ፦ “ኩኖ፣ ጎፍታን ቁልቁሎተሳ ኩማተመ ወጅን ንዹፈ፤ <verse eid="JUD 1:14"/><verse number="15" style="v" sid="JUD 1:15"/>እንስ ነመ ሁንደት ሙሩፍ፣ ወረ ዋቃፍ ህንቡሌ ከኔን ከራ ዋቅን ህንጃለትኔን ዋን ዋቅን ህንጃለትኔ ሆጄተን ሁንዳፊ ዱቢ ሀማ ጩበሞትን ዋቃፍ ህንቡሌ ሁንድኑ እሰረት ዱበተን ሁንደት እሳን ጋፈቹፍ ንዹፈ።” <verse eid="JUD 1:15"/><verse number="16" style="v" sid="JUD 1:16"/>ነሞትን ኩኔን ዬሮ ሁንደ ንጉንጉሙ፤ ኮሚስ ንቀባቱ፤ ሀዊሳኒ እሰ ሀማ ዱካ ቡኡ፤ ኦፍ ጀጁ፤ ፋይዳ አርገቹፍ ጄዸኒስ ነመ ሳዱ።<verse eid="JUD 1:16"/></para>
  <para style="s1">ጀባተኒ ዻበቹ</para>
  <para style="p">
    <verse number="17" style="v" sid="JUD 1:17"/>ያ ምቾተ፣ እስን ገሩ ዋን ኤርገሞትን ጎፍታኬኘ ዬሱስ ክርስቶስ ዱራን ዱርሰኒ ህመን ሰነ ያደዻ። <verse eid="JUD 1:17"/><verse number="18" style="v" sid="JUD 1:18"/>እሳንስ፣ “ቆስቶትን ሀዊ ፌዺ ዋቃቲን አለ ተኤ ዱካ ቡአን በረ ዹማ ኬሰ ንዹፉ” እስኒን ጄዸን። <verse eid="JUD 1:18"/><verse number="19" style="v" sid="JUD 1:19"/>ነሞትን ኩኔን ወረ ገርገር በኡ ኡመን፣ ወረ ሀዊ ፎኒ ዱካ ቡአኒፊ ወረ ሀፉረ ቁልቁሉ ህንቀብኔዸ።<verse eid="JUD 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JUD 1:20"/>እስን ገሩ ያ ምቾተ፣ አመንቲኬሰን ከን ዋን ሁንደረ ቁልቁሉ ተኤ ሰነረት ኦፍ እጃራ፤ ሀፉረ ቁልቁሉዻንስ ከዸዻ። <verse eid="JUD 1:20"/><verse number="21" style="v" sid="JUD 1:21"/>አራር ጎፍታኬኘ ዬሱስ ክርስቶስ ጅሬኘ በረ በራት አከ እስን ጌሱ ኤገቻ ጃለለ ዋቃቲን ኦፍ ኤጋ።<verse eid="JUD 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JUD 1:22"/>ወረ ሸኪ ቀበኒፍ ገራ ላፋ፤ <verse eid="JUD 1:22"/><verse number="23" style="v" sid="JUD 1:23"/>ወረ ካን እብደ ኬሳ ቡታቲ ኦልቻ፤ ካንሞ ኡፈተ ሀዊ ፎኒቲን ጡሬፈሜዩ በልፋቲ ሶዳዻን እሳን ማራ።<verse eid="JUD 1:23"/></para>
  <para style="b"/>
  <para style="s1">ኤበ ጡሙራ</para>
  <para style="p">
    <verse number="24" style="v" sid="JUD 1:24"/>እሰ ጉፈቹ እስን ኦልቹ ደንደኡፊ እሰ ፉለ ኡልፍነሳ ዱረት ህርእነ መሌ፣ ገመቹ ጉዳዻን እስን ዽኤሱ ደንደኡ ሰናፍ፣ <verse eid="JUD 1:24"/><verse number="25" style="v" sid="JUD 1:25"/>ፈይሳኬኘ ዋቀ ቶክቻፍ ኡልፍን፣ ሱራን፣ ሁምኒፊ ታይታን ከራ ጎፍታኬኘ ዬሱስ ክርስቶሲን በረ ሁንዱማን ዱረ፣ አመ፣ በረ በራንስ ሃተኡ! አሜን።<verse eid="JUD 1:25"/></para>
  <chapter eid="JUD 1"/>
</usx>
