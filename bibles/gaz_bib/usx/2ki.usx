<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2KI" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">2 ሞቶተ</para>
  <para style="toc1">ክታበ ሞቶታ ለመፋ</para>
  <para style="toc2">2 ሞቶተ</para>
  <para style="toc3">2ሞቶ</para>
  <para style="mt2">ክታበ</para>
  <para style="mt1">ሞቶታ</para>
  <para style="mt3">ለመፋ</para>
  <chapter number="1" style="c" sid="2KI 1"/>
  <para style="s1">ሙርቲ <char style="nd">ዋቀዮ</char> አሃዝያት ሙሬ</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 1:1"/>ኤርገ አሃብ ዱኤ ቦዴ ሞኣብ እስራኤልት ፍንጭሌ። <verse eid="2KI 1:1"/><verse number="2" style="v" sid="2KI 1:2"/>አሃዝያንስ ቃወ ደርቢ መነሳ ከን ሰማርያ ኬሳን ኩፌ ሚዸሜ ቱሬ። ከናፉ እን፣ “አከ አን ሚዻ ከነራ ፈዩፊ ፈዩ ባቹኮ ቤኩፍ ዸቃቲ በኣል ዜቡል ዋቅቸ ኤቅሮን ሰነ ናፍ ጋፈዻ” ጄዼ ኤርገሞተ ኤርጌ።<verse eid="2KI 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 1:3"/>ኤርገማን <char style="nd">ዋቀዮ</char> ገሩ ኤልያስ ነምቸ ጎሰ ትሽቢ ሰናን አከነ ጄዼ፤ “ከኢቲ ገረ ኤርገሞተ ሞትቸ ሰማርያ ሰናት ኦል በኢቲ አከነ ጄዺ እሳን ጋፈዹ፤ ‘ወን እስን በኣል ዜቡል ዋቅቸ ኤቅሮን ሰነ ጎርሰ ጋፈቹ ዸቅጠኒፍ እስራኤል ኬሳ ዋቅን ዸበሜቲ?’ <verse eid="2KI 1:3"/><verse number="4" style="v" sid="2KI 1:4"/>ከናፉ <char style="nd">ዋቀዮ</char>፣ ‘አት ስሬ አመረ ጪፍቱ ከነራ ህንካቱ። አት ዹጉማን ንዱተ!’ ጄዸ።” ከነረት ኤልያስ ከኤ ዴሜ።<verse eid="2KI 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 1:5"/>ሞትችስ ዮሙ ኤርገሞትን ገረሳት ዴብአንት፣ “እስን ማሊፍ ዴብተን?” ጄዼ እሳን ጋፈቴ።<verse eid="2KI 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 1:6"/>እሳንስ አከነ ጄዸኒ ዴብሰን፤ “ነምቸ ቶኮቱ ከራት ኑት ዹፌ፣ ‘ገረ ሞትቸ እስን ኤርጌ ሰናት ዴብኣቲ አከነ ጄዻኒ’ ኑን ጄዼ፤ ‘<char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ ወን አት በኣል ዜቡል ዋቅቸ ኤቅሮን ሰነ ጎርሰ ጋፈቹፍ ነሞተ ኤርግቱፍ እስራኤል ኬሳ ዋቅን ዸበሜቲ? ከናፉ አት ስሬረ ጪፍቱ ከነራ ህንካቱ። አት ዹጉማን ንዱተ!’ ”<verse eid="2KI 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 1:7"/>ሞትች፣ “ነምች ከራት እስንት ዹፌ ዋን ከነ እስንት ህሜ ሱን ነመ አከሚት?” ጄዼ እሳን ጋፈቴ።<verse eid="2KI 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 1:8"/>እሳንስ፣ “እን ነመ ኡፈተ ርፌንሰራ ሆጄተሜ ኡፈቴ ሰበተ ጎጋ ሙዺሳት ህዸቱ ቶኮዸ” ጄዸኒ ዴብሰኒፍ።</para>
  <para style="p" vid="2KI 1:8">ሞትችስ፣ “እን ኤልያስ ነምቸ ትሽቢ ሰናዸ” ጄዼ።<verse eid="2KI 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 1:9"/>ከነረት ሞትች አጀጃ ወራና ቶኮ ነሞተ ሸንተመ ወጅን ኤልያስት ኤርጌ። አጀጃን ሱንስ ፊጤ ጋረ እንረ ታኣ ቱሬ ቶኮት ኤልያስት ኦል በኤ፣ “ያ ነመ ዋቃ፣ ሞትች ‘ገድ ኮቱ!’ ሲን ጄዸ” ጄዼን።<verse eid="2KI 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 1:10"/>ኤልያስሞ አጀጃ ሰናን፣ “ዮ አን ነመ ዋቃ ተኤ፣ እብድ ሰሚራ ገድ ቡኤ ስኢፊ ነሞተኬ ሸንተመን ሃፍጡ!” ጄዼ። ኤርገሲ እብድ ሰሚራ ገድ ቡኤ አጀጃ ሰናፊ ነሞተሳ ሁንደ ፍጤ።<verse eid="2KI 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 1:11"/>ከነረት ሞትች አመሌ አጀጃ ብራ ነሞተ ሸንተመ ወጅን ኤልያስት ኤርጌ። አጀጃን ሱንስ፣ “ያ ነመ ዋቃ፣ ሞትች፣ ‘ደፊ ገድ ቡኢቲ ኮቱ!’ ሲን ጄዸ” ጄዼን።<verse eid="2KI 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 1:12"/>ኤልያስ ገሩ፣ “ዮ አን ነመ ዋቃ ተኤ፣ እብድ ሰሚራ ገድ ቡኤ ስኢፊ ነሞተኬ ሸንተመኑ ሃፍጡ!” ጄዼ ዴብሴፍ። እብድ ዋቃስ ሰሚራ ገድ ቡኤ እሳፊ ነሞተሳ ሸንተመኑ ንፍጤ።<verse eid="2KI 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 1:13"/>ከናፉ ሞትች አመስ አጀጃ ሰደፋ ነሞተ ሸንተመ ወጅን ንኤርጌ። አጀጃን ሰደፋን ኩን ኦል በኤ ጅልበ ኦፊሳቲን ኤልያስ ዱረት ጅልቤንፈቴ አከነ ጄዼ እሰ ንከዸቴ፤ “ያ ነመ ዋቃ፣ ማሎ ሉቡንኮፊ ሉቡን ገርቦተኬ ሸንተመን ከኔኒ ገቲ ህንዸብን! <verse eid="2KI 1:13"/><verse number="14" style="v" sid="2KI 1:14"/>ኩኖ፣ እብድ ሰሚራ ገድ ቡኤ አጀጁወን ዱራ ለማኒፊ ነሞተሳኒ ሁንደ ፍጤረ። አመ ገሩ ሉቡንኮ ፉለኬ ዱረት ገቲ ሃቀባቱ!”<verse eid="2KI 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 1:15"/>ኤርገማን <char style="nd">ዋቀዮስ</char> ኤልያሲን፣ “እሳ ወጅን ገድ ቡእ፤ እሰ ህንሶዳትን” ጄዼ። ከናፉ ኤልያስ ከኤ እሰ ወጅን ገረ ሞትቻት ገድ ቡኤ።<verse eid="2KI 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 1:16"/>እንስ አከነ ጄዼ ሞትቸት ህሜ፤ “<char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ ወን አት በኣል ዜቡል ዋቅቸ ኤቅሮን ጎርሰ ጋፈቹዻፍ ኤርገሞተ ኤርግቴፍ እስራኤል ኬሳ ዋቅን ጎርሰ ጋፈተሙ ዸበሜቲ? አት ሰበቢ ዋን ከነ ሆጄቴፍ ስሬረ ጪፍቱ ከነራ ህንካቱ። አት ዹጉማን ንዱተ!” <verse eid="2KI 1:16"/><verse number="17" style="v" sid="2KI 1:17"/>ከናፉ እን አኩመ ዱቢ <char style="nd">ዋቀዮ</char> ከን ኤልያስ ዱበቴ ሰናት ዱኤ።</para>
  <para style="p" vid="2KI 1:17">ሰበቢ አሃዝያን እልመ ህንቀብኔፍ ኦቦሌስሳ ዬሆራም እዶሳ ቡኤ ሞቲ ተኤ፤ ኩንስ በረ ዬሆራም እልም ዬሆሻፋጥ ሞቲ ይሁዳ ቱሬ ኬሰ ወጋ ለመፋት ተኤ። <verse eid="2KI 1:17"/><verse number="18" style="v" sid="2KI 1:18"/>ወንቶትን በረ ሞቱማ አሃዝያ ኬሰ ሆጄተመን ከን ብራ ሁንዲፊ ወንት እን ሆጄቴ ክታበ ሴና ሞቶተ እስራኤል ኬሰት በሬፈመኒሩ ምቲ?<verse eid="2KI 1:18"/></para>
  <chapter eid="2KI 1"/>
  <chapter number="2" style="c" sid="2KI 2"/>
  <para style="s1">ኤልያስ ሰሚት ኦል ፉዸተሜ</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 2:1"/>ዬሮ <char style="nd">ዋቀዮ</char> ቡቤዻን ኤልያስን ገረ ሰሚት ኦል ፉዸቹ ገኤት ኤልያሲፊ ኤልሳእ ግልጋሊ ከአኒ ከራ ዴማ ቱረን። <verse eid="2KI 2:1"/><verse number="2" style="v" sid="2KI 2:2"/>ኤልያስስ ኤልሳኢን፣ “አት አሱመ ቱር፤ <char style="nd">ዋቀዮ</char> ቤትኤልት ነ ኤርጌራቲ” ጄዼ።</para>
  <para style="p" vid="2KI 2:2">ኤልሳእ ገሩ፣ “ዹጋ <char style="nd">ዋቀዮ</char> ጅራታ፣ አን ሉቡኬቲን ነንከከዸ፤ አን ገድ ስ ህንዺሱ” ጄዼን። ከናፉ እሳን ቤትኤልት ገድ ቡአን።<verse eid="2KI 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 2:3"/>ኤርገሲስ ወልዳን ራጆታ ከኔን ቤትኤል ቱረን ገረ ኤልሳእ ዹፈኒ፣ “አት አከ <char style="nd">ዋቀዮ</char> ሀርአ ጎፍታኬ ስ ብራ ፉዸቹፍ ጅሩ ቤክታ?” ጄዸኒ ንጋፈተን።</para>
  <para style="p" vid="2KI 2:3">ኤልሳእሞ፣ “ኤዬ፣ አን ነንቤከ፤ ገሩ እስን ዋኤሳ ህንዱበትና” ጄዼን።<verse eid="2KI 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 2:4"/>ኤልያስስ “ያ ኤልሳእ፣ አት አሱመ ቱር፤ <char style="nd">ዋቀዮ</char> ገረ ዬርኮት ነ ኤርጌራቲ” ጄዼን።</para>
  <para style="p" vid="2KI 2:4">እንስ፣ “ዹጋ <char style="nd">ዋቀዮ</char> ጅራታ፣ አን ሉቡኬቲን ነንከከዸ፤ አን ገድ ስ ህንዺሱ” ጄዼን። ከናፉ እሳን ገረ ዬርኮ ዴመን።<verse eid="2KI 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 2:5"/>ወልዳን ራጆታ ከኔን ዬርኮ ቱረን ሱን ገረ ኤልሳእ ዹፈኒ፣ “አት አከ <char style="nd">ዋቀዮ</char> ሀርአ ጎፍታኬ ስ ብራ ፉዸቹፍ ጅሩ ቤክታ?” ጄዸኒ ጋፈተን።</para>
  <para style="p" vid="2KI 2:5">እንስ፣ “ኤዬ ነንቤከ፤ እስን ገሩ ዋኤሳ ህንዱበትና” ጄዼን።<verse eid="2KI 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 2:6"/>ኤልያስስ፣ “አት አሱመ ቱር፤ <char style="nd">ዋቀዮ</char> ዮርዳኖስት ነ ኤርጌራቲ” ጄዼን።</para>
  <para style="p" vid="2KI 2:6">እንስ፣ “ዹጋ <char style="nd">ዋቀዮ</char> ጅራታ፣ አን ሉቡኬቲን ነንከከዸ፤ አን ገድ ስ ህንዺሱ” ጄዼን። ከናፉ እሳን ለማኑ ከአኒ ዴመን።<verse eid="2KI 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 2:7"/>እሳንስ ዮርዳኖስ ብረ ዻበተን፤ ወልዳ ራጆታ ኬሳ ነሞትን ሸንተምን ዸቀኒ እራ ፈጋተኒ ፉለሳኒ ዱረ ዸዻበተን። <verse eid="2KI 2:7"/><verse number="8" style="v" sid="2KI 2:8"/>ኤልያስስ ካባሳ ኦፍራ ባሴ ደደቻሴ እቲን ብሻን ዸኤ። ብሻን ሱንስ ምርጋፊ ብታት ገርገር ቆደሜ፤ እሳን ለማኑ ለፈ ጎጋረ ጬአን።<verse eid="2KI 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 2:9"/>ኤልያስስ ኤርገ ጬአኒ ቦዴ ኤልሳኢን፣ “ሜ ዋን አን ኡቱ ስ ብራ ህንፉዸተምን ሲፍ ጎቹ ደንደኡ ነት ህም” ጄዼ።</para>
  <para style="p" vid="2KI 2:9">ኤልሳእሞ፣ “ሀፉርኬ ደቻዻን ነረ ሃቡኡ” ጄዼ ዴብሴፍ።<verse eid="2KI 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 2:10"/>ኤልያስሞ፣ “አት ዋን ረክሳ ከዸቴ፤ ተኡስ ዮ አት ዬሮ አን ስ ብራ ፉዸተሙት ነ አርግቴ፣ ሀፉር ኩን ከንኬ ተአ፤ ዮ ከና አች ከንኬ ህንተኡ” ጄዼን።<verse eid="2KI 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 2:11"/>ኡቱመ እሳን ሃሰኣ ዴመኑ ጋሪን እብዳ ቶኮፊ ፈርዴን እብዳ አኩመ ተሳ ሙልአተኒ እሳን ለማን ገርገር ባሰን፤ ኤልያስስ ቡቤዻን ሰሚት ኦል ፉዸተሜ። <verse eid="2KI 2:11"/><verse number="12" style="v" sid="2KI 2:12"/>ኤልሳእ ዋን ከነ አርጌ፣ “ያ አባኮ! ያ አባኮ! ጋሪወኒፊ አቦቲ ፈርደ እስራኤል!” ጄዼ ሰገሌ ኦል ፉዸቴ እዬ። ኤልሳእ ኤርገሲ ዴብኤ እሰ ህንአርግኔ። እንስ ኡፈተሳ ቀቤ እዶ ለመት ገርገር ተርሳሴ።<verse eid="2KI 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 2:13"/>እንስ ካባ ኤልያስራ ቡኤ ሰነ ፉዼ ዴብኤ ቀርቀረ ለገ ዮርዳኖስ ዻበቴ። <verse eid="2KI 2:13"/><verse number="14" style="v" sid="2KI 2:14"/>ኤርገሲ ካባ ኤልያስራ ቡኤ ሰነ ፉዸቴ እቲን ብሻን ዸኤ፣ “<char style="nd">ዋቀዮ</char> ዋቅን ኤልያስ ሱን አመ ኤሰ ጅረ?” ጄዼ ጋፈቴ። ዮሙ እን ዸኤት ብሻን ሱን ምርጋፊ ብታት ገርገር ቆደሜ፤ ኤልሳእስ ንጬኤ።<verse eid="2KI 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 2:15"/>ወልዳን ራጆታ ከኔን ዬርኮዻ ዹፈኒ ዋን ከነ እላላ ቱረን፣ “ሀፉር ኤልያስ ኤልሳእረ ቡኡት ጅረ” ጄዸን። እሳንስ እሰ ስመቹዻፍ ዸቀኒ ፉለሳ ዱረት ለፈት ጎምብፈመን። <verse eid="2KI 2:15"/><verse number="16" style="v" sid="2KI 2:16"/>አከነስ ጄዸኒን፤ “ኩኖ፣ ኑ ተጃጅልቶትንኬ ነሞተ ጭጭሞ ሸንተመ ኦፍ ብራ ቀብነ። እሳን ዸቀኒ ጎፍታኬ ሃበርባደን። ሀፉር <char style="nd">ዋቀዮ</char> ኦል እሰ ፉዼ ቱሉ ወዪረ ዮካን ሱሉለ ወዪ ኬሰ እሰ ቡሴ ተኣቲ።”</para>
  <para style="p" vid="2KI 2:16">ኤልሳእሞ፣ “አከስ ምት፤ እሳን ህንኤርግና” ጄዼ ዴብሴ።<verse eid="2KI 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 2:17"/>እሳን ገሩ ሀመ እን እሳን ጀላ ድዱ ቃነኡት እሰ ድርቅሲሰን። ከነረት እን፣ “እሳን ኤርጋ” ጄዼ። እሳንስ ነመ ሸንተመ ንኤርገን፤ ነሞትን ሱንስ ቡልቲ ሰዲ በርባደኒ እሰ ዸበን። <verse eid="2KI 2:17"/><verse number="18" style="v" sid="2KI 2:18"/>እሳንስ ኡቱመ እን ዬርኮ ጅሩ ዴብአኒ ገረሳ ዹፈን፤ እንስ፣ “አን ህንዴምና እስኒን ህንጄኔ?” ጄዼን።<verse eid="2KI 2:18"/></para>
  <para style="s1">ብሻን ፈይፈሜ</para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 2:19"/>ነሞትን መጋላ ሰና ኤልሳኢን፣ “ኩኖ ያ ጎፍታኬኘ፣ አኩመ አት አርግቱ ከነ ሃል መጋላ ከና ነመት ቶለ፤ ገሩ ብሻንሼ ፋለማዸ፤ ለፍትሼስ ምዻን ህንባፍቱ” ጄዸን።<verse eid="2KI 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 2:20"/>እንስ፣ “ሜ ወጪቲ ሃራ ና ፍዳቲ ሶግደ እት ነቃ” ጄዼን። ከናፉ እሳን ወጪቲ ሰነ እት ፍደን።<verse eid="2KI 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 2:21"/>እንስ ገረ ቡርቃት ገድ ቡኤ፣ ሶግደ ሰነ እት ነቄ አከነ ጄዼ፤ “<char style="nd">ዋቀዮ</char> አከነ ጄዸ፤ ‘አን ብሻን ከነ ፈይሴረ። ብሻን ኩን ለመተ ዱአ ህንፍዱ ዮካን መሴኑማ ብየት ህንፍዱ።’ ” <verse eid="2KI 2:21"/><verse number="22" style="v" sid="2KI 2:22"/>ብሻን ሱንስ አኩመ ዱቢ ኤልሳእ ዱበቴ ሰናት ሀመ አማት ፈዬረ።<verse eid="2KI 2:22"/></para>
  <para style="s1">ኤልሳእት ቆሰሜ</para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 2:23"/>ኤርገሲ ኤልሳእ ከኤ ቤትኤል ዸቄ። ኡቱመ እን ከራ ዴሙ እጆሌን ቶኮ መጋላ ኬሳ ያቴ፣ “ነምቸ መታ ሞሉነነ ዴም አሲ! ነምቸ መታ ሞሉነነ ዴም አሲ!” ጄዸኒ እት ቆሰን። <verse eid="2KI 2:23"/><verse number="24" style="v" sid="2KI 2:24"/>እን ኦፍረ ገረገሌ እሳን ምልአቴ መቃ <char style="nd">ዋቀዮቲን</char> እሳን አባሬ። ዮሙስ አማኬትን ለመ ቦሶነ ኬሳ በአኒ እጆሌ ሰነ ኬሳ አፉርተሚ ለመ ጭጭረኒ ፍጠን። <verse eid="2KI 2:24"/><verse number="25" style="v" sid="2KI 2:25"/>ኤልሳእስ እቱመ ፉፌ ገረ ቱሉ ቀርሜሎስ ዸቄ፤ አቺ ከኤስ ሰማርያት ዴብኤ።<verse eid="2KI 2:25"/></para>
  <chapter eid="2KI 2"/>
  <chapter number="3" style="c" sid="2KI 3"/>
  <para style="s1">ሞኣብ ፍንጭሌ</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 3:1"/>ዬሆራም እልም አሃብ በረ ዬሆሻፋጥ ሞትቸ ይሁዳ ኬሰ ወጋ ኩዸ ሰዴተፋት ሰማርያ ኬሰት ሞቲ እስራኤል ተኤ ወጋ ኩዸ ለመ ቡልቼ። <verse eid="2KI 3:1"/><verse number="2" style="v" sid="2KI 3:2"/>ዬሆራም ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዋን ሀማ ሆጄቴ፤ ገሩ አከ አባፊ ሃትሳ ሆጄተን ሰነ ምት። እን ሲዳ በኣል ከን አባንሳ ሆጄቺሴ ሰነ በሌሴራቲ። <verse eid="2KI 3:2"/><verse number="3" style="v" sid="2KI 3:3"/>ተኡስ ጩቡ ዬሮብኣም እልመ ኔባት ከን እን ሰበ እስራኤል ሆጄቺሴ ሰነ ጭምሴ ቀበቴ መሌራ ህንዴብኔ።<verse eid="2KI 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 3:4"/>ዬሮ ከነት ሜሻን ሞትች ሞኣብ ሆሎተ ሆርሲሰ ቱሬ፤ እን ወጋ ወጋት ጦባላ ሆላ ኩመ ዽበ ቶኮፊ ርፌንሰ ኮርቤዪ ሆላ ኩመ ዽበ ቶኮ ሞቲ እስራኤሊፍ ግብረ ኬነ ቱሬ። <verse eid="2KI 3:4"/><verse number="5" style="v" sid="2KI 3:5"/>ኤርገ አሃብ ዱኤ ገሩ ሞትች ሞኣብ ሞቲ እስራኤልት ንፍንጭሌ። <verse eid="2KI 3:5"/><verse number="6" style="v" sid="2KI 3:6"/>ከናፉ ዬሮ ሰነት ዬሆራም ሞትች ሰማርያዻ ከኤ ሰበ እስራኤል ሁንደ ዱላፍ ህሪርሴ። <verse eid="2KI 3:6"/><verse number="7" style="v" sid="2KI 3:7"/>እንስ፣ “ሞቲን ሞኣብ ነት ፍንጭሌረ፤ ሞኣብን ሎሉዻፍ አት ነ ወጅን ንባታ?” ጄዼ ዬሆሻፋጥ ሞትቸ ይሁዳት ኤርጋ ኤርገቴ።</para>
  <para style="p" vid="2KI 3:7">ዬሆሻፋጥስ፣ “አን ስወጅን ነንበአ፤ አን አኩመኬት፤ ሰብንኮስ አኩመ ሰበኬቲት፤ ፈርዴንኮስ አኩመ ፈርዴንኬቲት” ጄዼ ዴብሴፍ።<verse eid="2KI 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 3:8"/>እንስ፣ “ከራ ከሚን ያነ?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="2KI 3:8">ዬሆራምሞ፣ “ከራ ገሞጂ ኤዶሚቲን” ጄዼ ዴብሴፍ።<verse eid="2KI 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 3:9"/>ከናፉ ሞቲን እስራኤል ሞቲ ይሁዳቲፊ ሞቲ ኤዶም ወጅን ከኤ ቀጄሌ። ኤርገ ጉያ ቶርበ እረ ነናነአኒ ቦዴ ሎልቶትን ሱን ኦፊሳኒቲፍ ዮካን ሆሪሳኒቲፍ ብሻን ቶኮሌ ህንቀበን ቱሬ።<verse eid="2KI 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 3:10"/>ከነረት ሞቲን እስራኤል፣ “ወዮ ካ! <char style="nd">ዋቀዮ</char> ኑ ሞቶተ ሰደኑ ደበርሴ ሞቲ ሞኣብት ኬኑዻፍ ወልት ኑ ዋሜ?” ጄዼ እዬ።<verse eid="2KI 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 3:11"/>ዬሆሻፋጥ ገሩ፣ “ራጂን <char style="nd">ዋቀዮ</char> ከን ኑ ከራሳቲን <char style="nd">ዋቀዮን</char> ዋ ጋፈትኑ ቶኮዩ አስ ህንጅሩ?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="2KI 3:11">ቆንዳል ሞቲ እስራኤል ቶኮስ፣ “ኤልሳእ እልም ሻፋጥ አስ ጅረ። እን ኤልያሲፍ ብሻን ሀርካ ቡሰ ቱሬ” ጄዼ ዴብሴ።<verse eid="2KI 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 3:12"/>ዬሆሻፋጥስ፣ “ዱቢን <char style="nd">ዋቀዮ</char> እሰ ብረ ጅረ” ጄዼ። ከናፉ ሞቲን እስራኤል፣ ዬሆሻፋጢፊ ሞቲን ኤዶም ገረ ኤልሳእት ገድ ቡአን።<verse eid="2KI 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 3:13"/>ኤልሳእ ሞቲ እስራኤሊን፣ “ኑ ማል ወልራ ቀብነ? አት ገረ ራጆተ አባኬቲቲፊ ገረ ራጆተ ሃዸኬቲ ዸቅ” ጄዼ።</para>
  <para style="p" vid="2KI 3:13">ሞቲን እስራኤል፣ “አከስ ምት፤ <char style="nd">ዋቀዮ</char> ኑ ሞቶተ ሰደኑ ደበርሴ ሞኣብት ኬኑዻፍ ወልት ኑ ዋሜራቲ” ጄዼ ዴብሴ።<verse eid="2KI 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 3:14"/>ኤልሳእሞ አከነ ጄዼ ዴብሴ፤ “ዹጋ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ ከን አን እሰ ተጃጅሉ ሰና፤ አን ኡቱ ዬሆሻፋጥ ሞትቸ ይሁዳቲፍ ኡልፍነ ኬኑ ባዼ ስላ ገረገሌ ስ ህንእላሉ ዮካን ወይቱ ስ ህንሄዱን ቱሬ። <verse eid="2KI 3:14"/><verse number="15" style="v" sid="2KI 3:15"/>አመ ገሩ ነመ በገና ተጰቱ ቶኮ ና ፍዳ።”</para>
  <para style="p" vid="2KI 3:15">ኡቱመ ነምች ሱን በገና ተጰቻ ጅሩ ሀርክ <char style="nd">ዋቀዮ</char> ኤልሳእረ ቡኤ፤ <verse eid="2KI 3:15"/><verse number="16" style="v" sid="2KI 3:16"/>እንስ አከነ ጄዼ፤ “<char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ ሱሉለ ከነ ኬሰት ቦለ ሄዱ ቆታ። <verse eid="2KI 3:16"/><verse number="17" style="v" sid="2KI 3:17"/><char style="nd">ዋቀዮ</char> አከነ ጄዻቲ፦ እስን ቡቤ ዮካን ቦካ ህንአርግተን፤ ተኡስ ሱሉል ኩን ብሻኒን ጉተመ፤ እስን፣ ሎንኬሰኒፊ ሆሪንኬሰን ካን ንዹግዱ። <verse eid="2KI 3:17"/><verse number="18" style="v" sid="2KI 3:18"/>ወን ኩን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዋን ሰልጳዸ፤ እን ሞኣብንስ ደበርሴ ሀርከኬሰንት ንኬነ። <verse eid="2KI 3:18"/><verse number="19" style="v" sid="2KI 3:19"/>እስን መጋላ ደላን እት እጃረሜ ሁንዳፊ መጋላወን ሁንደ ንሞአቱ። ሙከ ጋሪ ሁንደ ንሙርቱ፤ ቡርቃ ሁንደ ጎግስተኒ ለፈ ቆቲሳ ጋሪ ሁንደ ዸጋን በሌስቱ።”<verse eid="2KI 3:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 3:20"/>ጉያ እት ኣኑ ገነመ ገረ ሰኣቲ ኣርሳን እት ዽኤፈሙት ኩኖ ከራ ኤዶሚን ብሻን ገድ ንዸንገለኤ! ብይ ሱንስ ብሻኒን ጉተምቴ።<verse eid="2KI 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 3:21"/>ዬሮ ከነት ሞኣቦን ሁንድ አከ ሞቶትን ሱን እሳን ሎሉ ዹፈን ዸገአን፤ ከናፉ ደርገጌሰስ ተኡ ጃርስ ምአ ሎላ ባቹ ደንደኡ ሁንድ ወልት ዋመሜ ዳንጋረት ወልት ቀበሜ። <verse eid="2KI 3:21"/><verse number="22" style="v" sid="2KI 3:22"/>ዮሙ እሳን ገነመ በሪ ከአንት ቢፍቱን ብሻን ሰነረት በኣ ቱርቴ። ብሻን ሱንስ ሞኣቦተ ገመ ጅረንት አኩመ ዺጋ ዲመቴ ሙልአቴ። <verse eid="2KI 3:22"/><verse number="23" style="v" sid="2KI 3:23"/>እሳንስ፣ “ወን ሱን ዺገ! ሞቶትን ሱን ወል ሎለኒ ወል ፍጡንሳኒ ህንኦሉ። ከናፉ ያ ሞኣብ ቦጁዻፍ ከእ!” ጄዸን።<verse eid="2KI 3:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 3:24"/>ገሩ ዬሮ ሞኣቦን ቁበተ እስራኤል ገአንት፣ እስራኤሎን እት ከአኒ ሎለን፤ ጀር ሱንስ ንበቀተን። እስራኤሎንስ ብየ ሰነ ዌረረኒ ሞኣቦተ ጎጎረአን። <verse eid="2KI 3:24"/><verse number="25" style="v" sid="2KI 3:25"/>እሳንስ አከሲን መጋላወን በሌሰን፤ ቶኮን ቶኮን ነማስ ለፈ ቆቲሳ ገጋሪ ሁንደረት ዸጋ ደርበቴ ለፍት ቆቲሳ ሱን ዸጋዻን ጉተሜ። እሳን ቡርቃወን ሁንደ ጎግሰኒ ሙከ ገጋሪ ሁንደ ጭረን። ቂር ሀሬሼት ቆፈቱ ዸጋሼ ወጅን ሀፌ፤ ተኡስ ነሞትን ፉርሳ ቀበን መርሰኒ እሼ ዸአን።<verse eid="2KI 3:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 3:26"/>ሞቲን ሞኣብ ዮሙ አከ ሎል እሰት ጀባቴ አርጌት ሞትቸ ኤዶምት ጨብሴ ሴኑፍ ነሞተ ጎራዴ ህዸተን ዽበ ቶርበ ፉዸቴ ቀጄሌ፤ ጀር ገሩ ህንደንዴኜ። <verse eid="2KI 3:26"/><verse number="27" style="v" sid="2KI 3:27"/>እንስ እልመሳ ሀንገፈ ከን እዶሳ ቡኤ ሞቲ ተኡፍ ጅሩ ፉዸቴ ደላ መጋላ ሰናረት ኣርሳ ጉበሙ ጎዼ ዽኤሴ። ዼከምስ ጉዳንስ እስራኤልት ዹፌ። እሳንስ ዱግደ ዱበት ዴብአኒ ብየሳኒት ንገለን።<verse eid="2KI 3:27"/></para>
  <chapter eid="2KI 3"/>
  <chapter number="4" style="c" sid="2KI 4"/>
  <para style="s1">ዘይቲ ሃዸ ህዬሳ ቶኮ</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 4:1"/>ኒቲን ነምቸ እልማን ራጆታ ኬሳ ቶኮ ተኤ ቶኮ ሰገሌ ኦል ፉዸቴ ኤልሳኢን አከነ ጄቴ፤ “ዽርስኮ ገርብችኬ ዱኤረ፤ አከ እን <char style="nd">ዋቀዮን</char> ሶዳቻ ቱሬ አቱ ንቤክተ። ነምች ልቂ እሰራ ቀቡ ቶኮ ገሩ አመ እልማንኮ ለማን ፉዸቴ ገርቦምፈቹፍ ዹፋ ጅረ።”<verse eid="2KI 4:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 4:2"/>ኤልሳእስ፣ “አን አከምን ስ ገርጋሩ ደንደአ? ሜ ነት ህም፤ መነኬ ኬሳ ማል ቀብዳ?” ጄዼን።</para>
  <para style="p" vid="2KI 4:2">እሼንስ፣ “ገርብቲንኬ ዘይቲ ጥኖ ቶኮ መሌ ሆማ መና ህንቀብዱ” ጄቴ ዴብፍቴ።<verse eid="2KI 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 4:3"/>ኤልሳእ አከነ ጄዼን፤ “ዸቂቲ ወረ ኦላኬቲ ሁንደ ኦኮቴ ዱዋ ሄዱ ከዸዹ። ሙራሰ ህንከዸትን። <verse eid="2KI 4:3"/><verse number="4" style="v" sid="2KI 4:4"/>ኤርገሲ ኦል ገሊቲ ኦፊኬቲፊ እልማንኬት በልበለ ጩፍ። ኦኮቴ ሁንደት ዘይቲ ነቂቲ ዮሙ ቶኮን ቶኮንሳ ጉተሙት ጀላ ሂቅስ።”<verse eid="2KI 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 4:5"/>እሼንስ እሰ ብራ ዴምቴ ኦፊ እሼቲፊ እልማንሼት በልበለ ጩፍቴ። እልማንሼ ኦኮቴ ገረሼት ፍደን፤ እሼንሞ ዘይቲ እት ነቃ ቱርቴ። <verse eid="2KI 4:5"/><verse number="6" style="v" sid="2KI 4:6"/>ኦኮቴን ሁንድ ጉተምናን እሼን እልመ እሼቲን፣ “ከን ብራ ና ፍድ” ጄቴ።</para>
  <para style="p" vid="2KI 4:6">እንሞ፣ “ኦኮቴን ቶኮዩ ህንሀፍኔ” ጄዼ ዴብሴፍ። ከነረት ዘይቲን ሱን ያኡ ዺሴ።<verse eid="2KI 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 4:7"/>እሼን ዸቅጤ ነመ ዋቃ ሰነት ህምቴ፤ እንስ፣ “ዸቂ ዘይቲ ሰነ ጉርጉሪቲ ልቂኬ ባፈዹ። አቲፊ እልማንኬ ዋን ሀፌን ጅራቹ ንደንዴሱ” ጄዼ።<verse eid="2KI 4:7"/></para>
  <para style="s1">ሙጫን ዱበርቲ ሱነም ቶኮ ዱኣ ካፈሙሳ</para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 4:8"/>ጋፍ ቶኮ ኤልሳእ ከኤ ሱነም ዸቄ። ዱበርቲን ሶሬቲን ቶኮ አች ጅራት ቱርቴ፤ እሼንስ አከ እን ጎሬ ዋ ኛቱፍ ኤልሳእ ከዸቴ። ከናፉ እን ዬሮ ከራ ሰናን ደርቡ ሁንደ ጎሬ ዋ ኛተ ቱሬ። <verse eid="2KI 4:8"/><verse number="9" style="v" sid="2KI 4:9"/>እሼንስ ዽርሰ እሼቲን አከነ ጄቴ፤ “አን ነምች ዬሮ ሁንደ ከራኬኛን ደርቡ ኩን ቁልቁሉ ነመ ዋቃ አከ ተኤ ነንቤከ። <verse eid="2KI 4:9"/><verse number="10" style="v" sid="2KI 4:10"/>ኮቱ ሜ በንቲ መናረት ኩታ ጥና ቶኮ እጃሬ ስሬፊ ምንጃለ፣ በርጩማፊ እብሳ አች ኬሰ ሃኬኙፍ። ኤርገሲስ እን ዬሮ ኑ ብረ ዹፉ ሁንደ አች ጅራቹ ደንደአ።”<verse eid="2KI 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 4:11"/>ኤልሳእስ ጋፍ ቶኮ ዹፌ ኦል በኤ ኩታሳ ሰነ ኬሰ ጪሴ። <verse eid="2KI 4:11"/><verse number="12" style="v" sid="2KI 4:12"/>እንስ ተጃጅላሳ ጌሃዚን፣ “ሜ ዱበርቲ ሱነም ሰነ አስ ዋም” ጄዼ። ጌሃዝ እሼ ዋምናን እሼን ዹፍቴ ፉለ ኤልሳእ ዱረ ዻበቴ። <verse eid="2KI 4:12"/><verse number="13" style="v" sid="2KI 4:13"/>ኤልሳእሞ አከነ እሳን ጄዼ፤ “ ‘አት ኑፍ ጄቴ ባይኤ ደዸብዴርተ። አመ ማል ሲፍ ሃጎዹ? እዶኬ ቡኔ ሞትቸት ዮካን አጀጃ ሎልቶታት ሲፍ ዱበትኑ?’ ጄዺ እሼት ህም።”</para>
  <para style="p" vid="2KI 4:13">እሼሞ፣ “አን ሰበኮ ግዱን ጅራዸ” ጄቴ ዴብፍቴ።<verse eid="2KI 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 4:14"/>ኤልሳእስ፣ “ማልቱ እሼፍ ጎዸሙ ደንደአ?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="2KI 4:14">ጌሃዝሞ፣ “እሼን እልመ ህንቀብዱ፤ ዽርስሼስ ዱሎሜ ጅረ” ጄዼን።<verse eid="2KI 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 4:15"/>ኤልሳእስ፣ “እሼ ዋም” ጄዼን። ከናፉ እን እሼ ዋሜ፤ እሼንስ በልበለ ዱረ ዻበቴ። <verse eid="2KI 4:15"/><verse number="16" style="v" sid="2KI 4:16"/>ኤልሳእ፣ “አት ወጋ ዹፉ ኬሰ ዬሮ ከነት እልመ ንሀመተ” ጄዼን።</para>
  <para style="p" vid="2KI 4:16">እሼንሞ፣ “አከስ ምት ያ ጎፍታኮ፤ ያ ነመ ዋቃ፣ አት ገርብቲኬ ህንጎዎምስን!” ጄቴ።<verse eid="2KI 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 4:17"/>ዱበርቲን ሱን ገሩ ንኡልፎፍቴ፤ አኩመ ኤልሳእ እሼት ህሜ ሰነት ወጋ እት ኣኑ ኬሰ ዬሩመ ሰነት እልመ ዴሴ።<verse eid="2KI 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 4:18"/>ሙጫን ሱንስ ንጉደቴ፤ እንስ ጋፍ ቶኮ ገረ ወረ ምዻን ሃመኒ አባሳ ብረ ዸቄ። <verse eid="2KI 4:18"/><verse number="19" style="v" sid="2KI 4:19"/>እንስ አባሳቲን፣ “መታኮ! መታኮ!” ጄዼ።</para>
  <para style="p" vid="2KI 4:19">አባንሳሞ ሆጄታ ቶኮን፣ “ባዹቲ ገረ ሃዸሳት እሰ ጌስ” ጄዼ። <verse eid="2KI 4:19"/><verse number="20" style="v" sid="2KI 4:20"/>ኤርገ ሆጄታን ሱን ፉዼ ገረ ሃዸ እሳት እሰ ጌሴ ቦዴ ሙጫን ሱን ሀመ ሳፋት ጉዴደ ሃዸሳረ ታኤ ኤርገሲሞ ንዱኤ። <verse eid="2KI 4:20"/><verse number="21" style="v" sid="2KI 4:21"/>እሼን ኦል ባቴ ስሬ ነመ ዋቃ ሰናረ እሰ ጪብስቴ፤ መነ እት ጩፍቴስ ካቴ ብራ ዴምቴ።<verse eid="2KI 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 4:22"/>እሼን ዽርሰሼ ዋምቴ፣ “ሜ አከ አን ደፌ ገረ ነመ ዋቃ ዸቄ ዴብኡፍ ሆጄታ ቶኮፊ ሀሬ ቶኮ ናፍ ኤርግ” ጄቴን።<verse eid="2KI 4:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 4:23"/>እንሞ፣ “ሀርአ አያነ ባቲ ምት ዮካን ሰንበተ ምት። አት ማሊፍ ሀርአ ገረሳ ዸቅጠሬ?” ጄዼን።</para>
  <para style="p" vid="2KI 4:23">እሼን፣ “ነጉማፍን ዸቀ” ጄቴ።<verse eid="2KI 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 4:24"/>እሼንስ ሀሬሼረ ኮራ ካአቴ ሆጄታሼቲን፣ “ከራ ቀበዹ፤ ዮ አን ስት ህሜ መሌ አናፍ ጄቴ ሱተ ህንዴምስስን” ጄቴ። <verse eid="2KI 4:24"/><verse number="25" style="v" sid="2KI 4:25"/>ከናፉ እሼን ካቴ ገረ ቱሉ ቀርሜሎስ ነመ ዋቃ ሰነ ብረ ዸቅጤ።</para>
  <para style="p" vid="2KI 4:25">ነምን ዋቃ ሱን ፈጎት እሼ አርግናን ተጃጅላሳ ጌሃዚን አከነ ጄዼ፤ “እላ! ዱበርቲን ሱነም ሱን ኩኖት! <verse eid="2KI 4:25"/><verse number="26" style="v" sid="2KI 4:26"/>ፊጊ እሼ ስመዹቲ፣ ‘አት ፈዩማ? ዽርስኬ ፈዩማ? ሙጫንኬ ፈዩማ?’ ጄዺ ጋፈዹ።”</para>
  <para style="p" vid="2KI 4:26">እሼንስ፣ “ወን ሁንድኑ ነጉመ” ጄቴ ዴብፍቴ።<verse eid="2KI 4:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 4:27"/>እሼን ዮሙ ቱሉ ሰነረት ነመ ዋቃ ሰነ ብረ ጌሴት፣ ጀቤስቴ ሚለሳ ቀበቴ። ጌሃዝሞ ገድ ዺስሱፍ ዹፌ፤ ነምን ዋቃ ሱን ገሩ፣ “እሼ ህንቱቅን! እሼን ገደ ጉዳ ኬሰ ጅርት፤ <char style="nd">ዋቀዮ</char> ገሩ ዋን ከነ ነ ዾክሴ፤ ነትስ ህንህምኔ” ጄዼ።<verse eid="2KI 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 4:28"/>እሼንስ፣ “ያ ጎፍታኮ አን እልመ ስ ከዸዼራ? አን፣ ‘ነ ህንጎዎምስን’ ሲን ህንጄኔ?” ጄቴን።<verse eid="2KI 4:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 4:29"/>ከነረት ኤልሳእ ጌሃዚን አከነ ጄዼ፤ “ሰበታን ሙዺኬ ህዸዹቲ፣ ኡሌኮ ሀርከት ቀበዹቲ ፊግ። ነመ ከራት አርግቴ ቶኮሌ ህንዱብስን፤ ዮ ነምን ከምዩ ስ ዱብሴ ዴቢ ህንኬንኒፍ፤ ኡሌኮስ ፉለ ሙጫ ሰናረ ካእ።”<verse eid="2KI 4:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="2KI 4:30"/>ሃት ዳእመ ሰና ገሩ፣ “ዹጋ <char style="nd">ዋቀዮ</char> ጅራታ፣ አን ሉቡኬቲን ነንከከዸ፤ አን ስ ዺሴ ህንዴሙ” ጄቴ። ከናፉ እን ከኤ እሼ ዱካ ቡኤ።<verse eid="2KI 4:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="2KI 4:31"/>ጌሃዝ እሳን ዱረ ደርቤ ኡሌ ሰነ ፉለ ሙጫረ ካኤ፤ ገሩ ሰገሌን ዮካን መለቶን ቶኮዩ ህንቱሬ። ከናፍ ጌሃዝ ገረ ኤልሳእት ዴብኤ፣ “ሙጫን ህንደመቅኔ” ጄዼ እት ህሜ።<verse eid="2KI 4:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 4:32"/>ዮሙ ኤልሳእ መነ ገኤት ሙጫን ሱን ዱኤ ስሬሳረ ጪሳ ቱሬ። <verse eid="2KI 4:32"/><verse number="33" style="v" sid="2KI 4:33"/>ኤልሳእስ ኦል ሴኔ፣ ኦፊፊ ሙጫት በልበለ ጩፌ <char style="nd">ዋቀዮን</char> ከዸቴ። <verse eid="2KI 4:33"/><verse number="34" style="v" sid="2KI 4:34"/>ኤርገሲስ ስሬ ያበቴ፣ አፋንሳ አፋን ሙጫረ፣ እጀሳ እጀ ሙጫረ፣ ሀርከሳ ሀርከ ሙጫረ ካኤ ሙጭቸረ ጪሴ። አኩመ እን ሙጫ ሰነረት ድሪሬን ዸግን ሙጫ ሆኡ ጀልቀቤ። <verse eid="2KI 4:34"/><verse number="35" style="v" sid="2KI 4:35"/>ኤልሳእ አች ገረገሌ መነ ኬሰ አሲፊ አች ነናነኤ አመሌ ስሬ ያበቴ ሙጫረት ድሪሬ። ሙጫን ሱንስ ዬሮ ቶርበ ሀጥፈቴ እጀ በነቴ።<verse eid="2KI 4:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="2KI 4:36"/>ኤልሳእስ ጌሃዝን ዋሜ፣ “ዱበርቲ ሱነም ሰነ አስ ዋም” ጄዼ። እንስ እሼ ዋሜ። ኤልሳእ ዮሙ እሼን ገረሳ ዹፍቴት፣ “ኩኖ ሙጫኬ ፉዸዹ” ጄዼን። <verse eid="2KI 4:36"/><verse number="37" style="v" sid="2KI 4:37"/>እሼን ኦል ሴንቴ፣ ሚለሳረት ኩፍቴ አዳን ለፈት ጎምብፈምቴ። ኤርገሲስ ሙጫሼ ፉዸቴ ገድ ባቴ።<verse eid="2KI 4:37"/></para>
  <para style="s1">ዱአ ኦኮቴ ኬሳ</para>
  <para style="p">
    <verse number="38" style="v" sid="2KI 4:38"/>ኤልሳእስ ከኤ ግልጋልት ዴብኤ፤ ዬሮ ሰነት ብየ ሰነ ኬሰ ቤለቱ ቱሬ። እንስ ኡቱ ወልዳን ራጆታ ፉለሳ ዱረ ታኣ ጅረኒ ተጃጅላሳቲን፣ “ኦኮቴ ጉድቸ እብዳረ ካኢቲ ነሞተ ከናፍ እቶ ብልቼስ” ጄዼ።<verse eid="2KI 4:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="2KI 4:39"/>እሳን ኬሳ ነምን ቶኮ ራፉ ፉናነቹፍ ገድ በኤ ወይኒ ቦሶና ቶኮ አርጌ። ወይኒ ቦሶና ሰነራ ዊሌ ጭሬ ደቻ ኡፈተሳ ጉተቴ። ዬሮ ዴብኤትስ ቡቄ ሰነ ሙርሙሬ ኦኮቴ እቶ ሰነት ነቄ። ነምን ቶኮዩ ዋን ሰነ ህንቤኩ ቱሬቲ። <verse eid="2KI 4:39"/><verse number="40" style="v" sid="2KI 4:40"/>እቶን ሱንስ ጀራፍ ዽኤፈሜ፤ እሳን ገሩ አኩመ ኛቹ ጀልቀበኒን፣ “ያ ነመ ዋቃ፣ ኦኮቴ ከነ ኬሰ ዱአቱ ጅረ!” ጄዸኒ እየን። እሳንስ እቶ ሰነ ኛቹ ህንደንዴኜ።<verse eid="2KI 4:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="2KI 4:41"/>ኤልሳእ፣ “ዳኩ ወዪ ና ፍዳ” ጄዼ። ዳኩ ሰነስ ኦኮቴት ነቄ፣ “አከ ኛተኒፍ ነሞታፍ ዽኤሳ” ጄዼ። ኤርገሲ ወን ነመ ሚዹ ቶኮዩ ኦኮቴ ሰነ ኬሰት ህንአርገምኔ።<verse eid="2KI 4:41"/></para>
  <para style="s1">ኤልሳእ ነመ ዽበ ቶኮ ሶሬ</para>
  <para style="p">
    <verse number="42" style="v" sid="2KI 4:42"/>ነምች ቶኮ ቡዴነ ገርቡ ከን መታ ምዻን ብልቻቴራ ቶልፈሜ ድግደማፊ አሼቲ ምዻኒ ነመ ዋቃ ሰናፍ ፍዴ በኣል ሻሊሻዻ ዹፌ። ኤልሳእስ፣ “አከ እሳን ኛተኒፍ ነሞታፍ ኬን” ጄዼ።<verse eid="2KI 4:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="2KI 4:43"/>ተጃጅላንሳሞ፣ “አን አከሚነን ዋን ከነ ነመ ዽበ ቶኮ ዱረት ዽኤሱ ደንደአ?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="2KI 4:43">ኤልሳእ ገሩ፣ “አከ እሳን ኛተኒፍ ነሞታፍ ኬን። <char style="nd">ዋቀዮ</char> አከነ ጄዻቲ፤ ‘እሳን ኛተኒ ሀምባሌ ንቀባቱ’ ” ጄዼ ዴብሴ። <verse eid="2KI 4:43"/><verse number="44" style="v" sid="2KI 4:44"/>እንስ ፉዼ እሳን ዱረት ዽኤሴ፤ እሳንስ አኩመ ዱቢ <char style="nd">ዋቀዮ</char> ሰናት ኛተኒ ሀምባ ሀምብሰን።<verse eid="2KI 4:44"/></para>
  <chapter eid="2KI 4"/>
  <chapter number="5" style="c" sid="2KI 5"/>
  <para style="s1">ነአማን ለምጢራ ፈይፈሜ</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 5:1"/>ነአማን አጀጃ ሎልቶተ ሞትቸ ሶርያ ቱሬ። ሰበቢ <char style="nd">ዋቀዮ</char> ከራሳቲን ወረ ሶርያቲፍ ሞእቸ ኬኔፍ እን ፉለ ጎፍታሳ ዱረት ነመ ጉዳ አከ መሌ ኡልፍነ ቀቡ ቱሬ። እን ሎልቱ ጀግነ፤ ገሩ ለምጢ ቀበ ቱሬ።<verse eid="2KI 5:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 5:2"/>በረ ሰነ ኬሰ ቱትን ሎልቶተ ሶርያ ዸቄ እንተለ ደርገጌቲ ጎሰ እስራኤል ቶኮ ቦጅኤ፤ እሼንስ ኒቲ ነአማን ተጃጅላ ቱርቴ። <verse eid="2KI 5:2"/><verse number="3" style="v" sid="2KI 5:3"/>እሼንስ ጊፍቲ እሼቲን፣ “ጎፍታንኮ ኡቱ ራጅቸ ሰማርያ ጅሩ ሰነ ብረ ዸቄ ስላ እን ለምጢ ሰነራ እሰ ፈይሰ ቱሬ!” ጄቴ።<verse eid="2KI 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 5:4"/>ነአማን ዸቄ ዋን እንተል እስራኤል ጄቴን ሰነ ጎፍታሳት ንህሜ። <verse eid="2KI 5:4"/><verse number="5" style="v" sid="2KI 5:5"/>ሞቲን ሶርያስ፣ “ዋን ፌዼሌ ታናን አት ዸቅ፤ አን ሞቲ እስራኤልት ጠለያ ነንበሬሳቲ” ጄዼ ዴብሴፍ። ከናፉ ነአማን ሜቲ ታላንቲ ኩዸን፣ ወርቄ ሰቅሊ ኩመ ጀኣፊ ኡፈተራ ጀላ ኩዸን ፉዸቴ ቀጄሌ። <verse eid="2KI 5:5"/><verse number="6" style="v" sid="2KI 5:6"/>ጠለያን እን ሞቲ እስራኤልት ጌሴ ሱን አከነ ጄዸ፤ “አን አከ አት ለምጢራ እሰ ፈይፍቱፍ ጠለያ ከነ ወጅን ተጃጅላኮ ነአማንን ስት ኤርጌረ።”<verse eid="2KI 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 5:7"/>ሞቲን እስራኤልስ አኩመ ጠለያ ሰነ ዱብሴን ኡፈተ ኦፊ ተርሳሴ አከነ ጄዼ፤ “አን ዋቃ? አን ነመ አጄሱፊ ዴብሴ ጅራችሱ ነንደንደኣ? ነምች ኩን ማሊፍ አከ ለምጢንሳ ፈዩፍ ነመ ነት ኤርገ? ሜ አከ እን ሎለ ነት ካሱ በርባዱ እላላ!”<verse eid="2KI 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 5:8"/>ኤልሳእ ነምን ዋቃ ሱን አከ ሞቲን እስራኤል ኡፈተሳ ተርሳሴ ዸጌኛን ኤርጋ እት ኤርጌ፣ “አት ማሊፍ ኡፈተኬ ተርሳፍቴ? ነምቸ ሰነ ነት ኤርግ፤ እንስ አከ እስራኤል ኬሰ ራጂን ጅሩ ንቤካቲ” ጄዼን። <verse eid="2KI 5:8"/><verse number="9" style="v" sid="2KI 5:9"/>ከናፉ ነአማን ፈርዴንሳቲፊ ጋሪወንሳ ፉዸቴ ዸቄ በልበለ መነ ኤልሳእ ዱረ ዻበቴ። <verse eid="2KI 5:9"/><verse number="10" style="v" sid="2KI 5:10"/>ኤልሳእሞ፣ “ዸቂ ዮርዳኖስ ኬሰት ዬሮ ቶርበ ዽቀዹ፤ ፎንኬ ፈዬ አከ ዱራት ሲፍ ዴብአ፤ አትስ ንቁልቁሎፍታ” ጄዼ ነመ እት ኤርጌ።<verse eid="2KI 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 5:11"/>ነአማን ገሩ ኣሪዻን ከኤ ብራ ዴሜ አከነ ጄዼ፤ “አን ዋን እን ዹጉማን ገረኮ ዹፌ ዻበቴ መቃ <char style="nd">ዋቀዮ</char> ዋቀሳ ዋሜ እዶ ሰነረ ሀርከሳ ቀቤ ለምጢኮ ፈይሱን ሴኤ። <verse eid="2KI 5:11"/><verse number="12" style="v" sid="2KI 5:12"/>አባናፊ ፋርፋን ለጌን ደማስቆ ሱን ብሻኖተ እስራኤል ኬሳ ከምዩ ህንጫለኒ? አን እሳን ኬሰት ዽቀዼ ፈዩ ህንደንደኡ ቱሬ?” ከናፉ እን አከ መሌ ኣሬ ኦፍረ ገረገሌ ዴሜ።<verse eid="2KI 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 5:13"/>ተጃጅልቶትን ነአማንስ ገረሳ ዸቀኒ፣ “ያ አባኮ፣ አት ኡቱ ራጂን ኩን ዋን ጉዳ ቶኮ ሆጄዹ ሲን ጄዼ ንሆጄተ ምቲ? ዮ እን፣ ‘ዽቀዹቲ ቁልቁላእ’ ሲን ጄዼሞ ሀመም ጫልችፍቴ ህንሆጄቱሬ?” ጄዸኒን። <verse eid="2KI 5:13"/><verse number="14" style="v" sid="2KI 5:14"/>ከናፉ እን ዸቄ አኩመ ነምን ዋቃ ሱን ጄዼንት ዬሮ ቶርበ ዮርዳኖስ ኬሰ ሴኔ በኤ፤ ዸግንሳስ ፈዬ አኩመ ዱራት ዴብኤፊ አኩመ ዸግነ ሙጫ ጥና ቶኮት ቁልቁላኤፍ።<verse eid="2KI 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 5:15"/>ኤርገሲ ነአማኒፊ ተጃጅልቶትንሳ ሁንድ ገረ ነመ ዋቃ ሰናት ዴብአን። ንእማንስ ፉለሳ ዱረ ዻበቴ፣ “አን አከ እስራኤል ኬሰ መሌ አዱኛ ጉቱ ኬሰ ዋቅን ህንጅሬ አመ ቤኬረ። ከናፉ ማሎ ገርብቸኬራ ኬና ቶኮ ፉዸዹ” ጄዼ።<verse eid="2KI 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 5:16"/>ራጂን ሱንሞ፣ “ዹጋ <char style="nd">ዋቀዮ</char> ጅራታ አን እሰ ተጃጅሉ ሰና፣ አን ዋን ቶኮሌ ስራ ህንፉዸዹ” ጄዼ ዴብሴ። ዮ ነአማን ጭምሴ እሰ ከዸቴዩ እን ፉዸቹ ድዴ።<verse eid="2KI 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 5:17"/>ከነረት ነአማን አከነ ጄዼን፤ “ዮ ፉዸቹ ባቴሞ፣ ማሎ አከ ብዮን ጋንጎ ለማ አነ ገርብቸኬቲፍ ኬነሙ አጀጅ፤ ገርብችኬ ስአች ዴብኤ <char style="nd">ዋቀዮፍ</char> መሌ ዋቆተ ቶልፈሞ ብራቲፍ ኣርሳ ጉበሙፊ ቀልመ ህንዽኤሱቲ። <verse eid="2KI 5:17"/><verse number="18" style="v" sid="2KI 5:18"/>ገሩ <char style="nd">ዋቀዮ</char> ዋን ቶክቸ ከነ ገርብቸኬቲፍ ሃዺሱ፦ ጎፍታንኮ ዮሙ አችት ሰገዱፍ መነ ቁልቁሉማ ርሞን ሴኑት ነት እርከተ፤ አንስ ዮሙ እን ሰገዱት ነንሰገደ፤ <char style="nd">ዋቀዮ</char> ዋን ከነ አነ ገርብቸኬቲፍ ሃዺሱ።”<verse eid="2KI 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 5:19"/>ኤልሳእስ፣ “ነጋን ዴም” ጄዼን።</para>
  <para style="p" vid="2KI 5:19">ኤርገ ነአማን ጥኖ አች ፈጋቴ ቦዴ፣ <verse eid="2KI 5:19"/><verse number="20" style="v" sid="2KI 5:20"/>ጌሃዝ ተጃጅላን ኤልሳእ ነመ ዋቃ ሰና አከነ ኦፊን ጄዼ፤ “ጎፍታንኮ ኡቱ ኬና እን ፍዴ ሰነራ ህንፉዸን ነአማን ነምቸ ወረ አራም ከነ አከሱመት ገድ ለክሴ። ዹጋ <char style="nd">ዋቀዮ</char> ጅራታ፣ አን እሰ ፋነ ፊጌን ዋ እራ ፉዸዸ።”<verse eid="2KI 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 5:21"/>ከናፉ ጌሃዝ ደፌ ንእማን ዱካ ቡኤ። ነአማንስ ዮሙ አከ እን ገረሳት ፊጋ ጅሩ አርጌት እሰ ስመቹዻፍ ጋሪራ ቡኤ፣ “ወን ሁንድ ነጉማ?” ጄዼ እሰ ጋፈቴ።<verse eid="2KI 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 5:22"/>ጌሃዝስ አከነ ጄዼ ዴብሴፍ፤ “ወን ሁንድኑ ነጉመ። ጎፍታንኮ፣ ‘ኩኖ አሙመ ወልዳ ራጆታ ኬሳ ደርገጎትን ለመ ብየ ጋራ ኤፍሬምራ ነት ዹፈኒሩ። ማሎ ሜቲ ታላንቲ ቶኮፊ ኡፈተራ ጀላ ለመ ኬኒፍ’ አከን ሲን ጄዹፍ ነ ኤርጌ።”<verse eid="2KI 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 5:23"/>ነአማንሞ ጌሃዚን፣ “አኩመ ፌዼሌ ተኡ ታላንቲ ለመ ፉዸዹ” ጄዼ። እንስ አከ ጌሃዝ ዋን ሰነ ፉዸቱፍ ጭምሴ እሰ ከዸቴ፤ ኤርገሲስ ሜቲ ታላንቲ ለመ ቦርሳ ለመት ህዼ ኡፈተራ ጀላ ለመ ወጅን ተጃጅልቶተሳት ኬኔ። እሳንስ ባተኒ ጌሃዝ ዱረ ቀጄለን። <verse eid="2KI 5:23"/><verse number="24" style="v" sid="2KI 5:24"/>ጌሃዝስ ዮሙ ጋረ ብረ ገኤት ዋን ሰነ ሆጄቶተ ሰነ ሀርካ ፉዼ መነ ኬሰ ኦል ካኤ። ነሞተ ሰነስ ኦፍራ ጌጌሴ፤ እሳንስ ከአኒ ዴመን። <verse eid="2KI 5:24"/><verse number="25" style="v" sid="2KI 5:25"/>እንስ ኤርገሲ ዸቄ ፉለ ጎፍታሳ ኤልሳእ ዱረ ዻበቴ።</para>
  <para style="p" vid="2KI 5:25">ኤልሳእስ፣ “ጌሃዝ፣ አት ኤሰ ቱርቴ?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="2KI 5:25">ጌሃዝሞ፣ “አን ገርብችኬ ኤሰዩ ህንዴምኔ” ጄዼ ዴብሴ።<verse eid="2KI 5:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 5:26"/>ኤልሳእ ገሩ አከነ ጄዼን፤ “ዬሮ ነምች ሱን ስእ ስመቹፍ ጋሪሳራ ቡኤ ሰነት ሀፉርኮ ስ ወጅን ህንቱሬ? ዬሮን ኩን ዬሮ እት ማለቀ ዮካን ወያ፣ ለፈ ቆቲሳ ኤጄርሳ፣ እዶ ዻባ ወይኒ፣ ቡሻዬ፣ ከረ ሎኒ ዮካን ገርቦተ ዺራፊ ገርቦተ ነዼኒ ፉዸተኒዻ? <verse eid="2KI 5:26"/><verse number="27" style="v" sid="2KI 5:27"/>ለምጢን ነአማን ሱን ሀመ በረ በራት ስኢፊ ሰኚኬት ቀበቴ ሀፈ።” እንስ ለምጣኤ አኩመ ጨቢ አዳቴ ፉለ ኤልሳእ ዱራ በኤ ዴሜ።<verse eid="2KI 5:27"/></para>
  <chapter eid="2KI 5"/>
  <chapter number="6" style="c" sid="2KI 6"/>
  <para style="s1">ቆቶን ብሻንረ ዴሜ</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 6:1"/>እልማን ራጆታ ሱን ኤልሳኢን አከነ ጄዸን፤ “ኩኖ፣ እዶን ኑ ስ ወጅን ወል ጌኙ ኑት ዽጰቴረ። <verse eid="2KI 6:1"/><verse number="2" style="v" sid="2KI 6:2"/>አከ ኑ ዮርዳኖስ ዸቅኔ ቶኮን ቶኮንኬኘ ሙከ ጭረትኔ እዶ ጅራትኑ አችት እጃረኑፍ ኑ ኤየም።”</para>
  <para style="p" vid="2KI 6:2">እንስ፣ “ዸቃ” ጄዼን።<verse eid="2KI 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 6:3"/>እሳን ኬሳ ነምን ቶኮ፣ “ማሎ አት ኑ ገርቦተኬ ወጅን ህንዴምቱ?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="2KI 6:3">ኤልሳእሞ፣ “ነንዴመ” ጄዼ ዴብሴ። <verse eid="2KI 6:3"/><verse number="4" style="v" sid="2KI 6:4"/>እንስ እሳን ወጅን ዴሜ።</para>
  <para style="p" vid="2KI 6:4">እሳን ዮርዳኖስ ዸቀኒ ሙከ ጭረቹ ጀልቀበን። <verse eid="2KI 6:4"/><verse number="5" style="v" sid="2KI 6:5"/>እሳን ኬሳ ቶኮ ኡቱ ሙከ ሙሩት ጅሩ ቆቶትን ሙከሳራ ቡቀኤ ብሻን ኬሰ ቡኤ። ነምች ሱንስ፣ “ወዮ ካ፣ ያ ጎፍታኮ፤ ወን ኩን ዋን ኤርግፈተሜዸ!” ጄዼ እዬ።<verse eid="2KI 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 6:6"/>ነምን ዋቃ ሱንስ “ቆቶትን ኤሰ ቡኤ?” ጄዼ ጋፈቴ። ዮሙ እን እዶ ቆቶትን ሱን ቡኤ እሰ አርግሲሴት ኤልሳእ ሙከ ጥና ቶኮ ኩቴ አች ኬሰ ቡሴ አከ ስቢል ሱን ብሻን ጉባ ዴሙ ጎዼ። <verse eid="2KI 6:6"/><verse number="7" style="v" sid="2KI 6:7"/>እንስ፣ “ኦል ፉዸዹ” ጄዼን። ነምች ሱንስ ሀርከ ድሪርፈቴ ቆቶሳ ፉዸቴ።<verse eid="2KI 6:7"/></para>
  <para style="s1">ኤልሳእ ነሞተ ሶርያ ጃምሴ</para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 6:8"/>ዬሮ ሰነት ሞቲን ሶርያ እስራኤሊን ወል ሎላ ቱሬ። እንስ ኤርገ አጀጆተ ሎልቶተሳቲን መርአቴ ቦዴ፣ “አን ለፈ አከሲቲፊ ለፈ አከሲ ኬሰ ቁበተኮ ነንዻበዸ” ጄዼ።<verse eid="2KI 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 6:9"/>ነምን ዋቃ ሱንስ፣ “ሰበቢ ነሞትን ሶርያ አችት ገድ ቡኣ ጅረኒፍ አት አከ ከራ ሰናን ህንደበሬ ኦፍ ኤገዹ” ጄዼ ሞቲ እስራኤልት ኤርጋ ኤርጌ። <verse eid="2KI 6:9"/><verse number="10" style="v" sid="2KI 6:10"/>ከናፉ ሞቲን እስራኤል ገረ እዶ ነምን ዋቃ ሱን ዋኤሳ ዱበቴ ሰናት ነመ ኤርጌ ንቶአቴ። ኤልሳእስ አከ ሞትች እዶወን አከሲራ ኦፍ ኤገቱ አሙማ አመ እሰ አኬከቺሴ።<verse eid="2KI 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 6:11"/>ወን ኩን አከ መሌ ሞቲ ሶርያ ኣርሴ። እንስ አጀጆተ ሎልቶተሳ ወልት ዋሜ፣ “እስን አመ ነመ ኑ ኬሳ ሞቲ እስራኤሊፍ ሆጄቻ ጅሩ ነት ህንህምተኒ?” ጄዼ ጋፈቴ።<verse eid="2KI 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 6:12"/>አጀጆተ ሰነ ኬሳ ነምን ቶኮ አከነ ጄዼ፤ “ያ ጎፍታኮ ሞትቸ፣ ኑ ኬሳ ነምን አከሲ ህንጅሩ፤ ገሩ ኤልሳእ ራጅቸ እስራኤል ኬሰ ጅሩ ሰነቱ ዱቢ አት ዲንቀኬ ኬሰት ዱበቱ ሁንደ ሞቲ እስራኤልት ህመ።”<verse eid="2KI 6:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 6:13"/>ሞትች ሶርያስ፣ “አከ አን ነመ እት ኤርጌ እሰ ቀብሲሱ ደንደኡፍ ዸቃቲ ለፈ እን ጅሩ እላላ” ጄዼ አጀጄ። ኦዱን፣ “እን ዶታን ኬሰ ጅረ” ጄዹ ቶኮስ እሰት ህመሜ። <verse eid="2KI 6:13"/><verse number="14" style="v" sid="2KI 6:14"/>እንስ ኤርገሲ ፈርዴን፣ ጋሪወኒፊ ወራነ ጀባ አችት ንኤርጌ። እሳንስ ሀልከኒን ዸቀኒ መጋላ ሰነ መርሰን።<verse eid="2KI 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 6:15"/>ዮሙ ተጃጅላን ነመ ዋቃ ሰና ጉያ እት ኣኑ ገነመ በሪን ገድ በኤት ሁምን ወራና ቶኮ ፈርዴኒፊ ጋሪወኒን መጋላ ሰነ መርሴ ቱሬ። ተጃጅላን ሱንስ፣ “ወዮ ካ፣ ያ ጎፍታኮ፣ ማል ጎኑ?” ጄዼ ጋፈቴ።<verse eid="2KI 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 6:16"/>ራጂን ሱንሞ፣ “ህንሶዳትን፤ ወር ኑ ወጅን ጅረን ወረ እሳን ወጅን ጅረን ጫለኒቲ” ጄዼ ዴብሴ።<verse eid="2KI 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 6:17"/>ኤልሳእስ፣ “ያ <char style="nd">ዋቀዮ</char>፣ አከ እን አርጉ ደንደኡፍ እጀሳ በኒፍ” ጄዼ ከዸቴ። <char style="nd">ዋቀዮስ</char> እጀ ተጃጅላ ሰና ንበኔ፤ እንስ ምልአቴ አከ ጋረን ሱን ናኖ ኤልሳእት ፈርዴኒፊ ጋሪወን እብዳቲን ጉተመኒ ጅረን ንአርጌ።<verse eid="2KI 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 6:18"/>ዲን ሱን ገረሳት ገድ ቡናን ኤልሳእ፣ “ጀረ ከነ ጃምስ” ጄዼ <char style="nd">ዋቀዮን</char> ከዸቴ። ከናፉ ዋቅን አኩመ ኤልሳእ እሰ ከዸቴ ሰነ እሳን ጃምሴ።<verse eid="2KI 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 6:19"/>ኤልሳእስ፣ “ከራን ሱን ከነ ምት፤ መጋላን ሱንስ ከነ ምት። አመ ነ ዱካ ቡኣ፤ አንስ ነመ እስን በርባደንት እስነን ጌሰ” ጄዼን። እንስ አከሲን ሰማርያት እሳን ንጌሴ።<verse eid="2KI 6:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 6:20"/>ኤርገ እሳን መጋላ ሰነ ሴነኒ ቦዴ ኤልሳእ፣ “ያ <char style="nd">ዋቀዮ</char> አከ እሳን አርጉ ደንደአኒፍ እጀ ጀረ ከና በኒፍ” ጄዼ። <char style="nd">ዋቀዮስ</char> እጀሳኒ ንበኔፍ፤ እሳንስ አከ ሰማርያ ኬሰ ጅረን ንአርገን።<verse eid="2KI 6:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 6:21"/>ሞቲን እስራኤልስ እሳን አርግናን፣ “ያ አባኮ፣ አን እሳን ፍጡ? አን እሳን ፍጡ?” ጄዼ ኤልሳእን ንጋፈቴ።<verse eid="2KI 6:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 6:22"/>እንስ አከነ ጄዼ ዴብሴ፤ “እሳን ህንፍጥን፤ አት ነሞተ ቦጅቴ ጎራዴኬቲን ዮካን ጥየኬቲን ንአጄፍታ? አከ እሳን ኛተኒ ዹገኒ ገረ ጎፍታሳኒት ዴብአኒፍ ኛታፊ ዹጋቲ ዽኤሲፍ።” <verse eid="2KI 6:22"/><verse number="23" style="v" sid="2KI 6:23"/>ከናፉ እን ጭዸ ጉዳ ቆጴሴፊ ኤርገ እሳን ኛተኒ ዹገኒ ቦዴ ኦፍራ እሳን ጌጌሴ፤ እሳንስ ገረ ጎፍታሳኒት ዴብአን። ነሞትን ሶርያስ ኤርገሲ ዴብአኒ ብየ እስራኤል ህንዌረሬ።<verse eid="2KI 6:23"/></para>
  <para style="s1">ቤን-ሀዳድ ሰማርያ መርሴ</para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 6:24"/>ዬሮ ገባባ ቦዴ፣ ቤን-ሀዳድ ሞትች ሶርያ ሎልቶተሳ ሁንደ ወልት ቀበቴ ዸቄ ሰማርያ መርሴ። <verse eid="2KI 6:24"/><verse number="25" style="v" sid="2KI 6:25"/>ቤለ አከ መሌ ሀማቱ መጋላ ሰነ ኬሰ ቱሬ፤ ዋን መጋላን ሱን ዬሮ ዼራዻፍ መርፈምቴፍ፣ መታን ሀሬ ቶኮ ሜቲ ሰቅሊ ሰዴተመት፣ ኡዳን ጉጌ ኪሎን ቶኮ ሀርከ አፉር ኬሳ ሀርክ ቶኮ ሜቲ ሰቅሊ ሸንት ጉርጉረሜ።<verse eid="2KI 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 6:26"/>ኡቱ ሞቲን እስራኤል ደላ ዸጋ እራን ደርቡ ዱበርቲን ቶኮ፣ “ያ ጎፍታኮ ሞትቸ፣ ነ ገርጋር” ጄቴ እት እይቴ።<verse eid="2KI 6:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 6:27"/>ሞትችሞ አከነ ጄዼ ዴብሴፍ፤ “ዮ <char style="nd">ዋቀዮ</char> ስ ህንገርጋርን አን ኤሳን ገርጋርሰ ሲፍ አርገ? ኦብዲ ምዻኒራ ሞ? እዶ ወይኒ እት ጩንፈንራ?” <verse eid="2KI 6:27"/><verse number="28" style="v" sid="2KI 6:28"/>ኤርገሲ፣ “ረኮንኬ ማል?” ጄዼ እሼ ጋፈቴ።</para>
  <para style="p" vid="2KI 6:28">እሼንስ አከነ ጄቴ ዴብፍቴፍ፤ “ዱበርቲን ኩን፣ ‘አከ ኑ ሀርአ እሰ ኛኑፍ ሙጫኬ ኑ ኬን፤ ቦርሞ ሙጫኮ ኛትናቲ’ ናን ጄቴ። <verse eid="2KI 6:28"/><verse number="29" style="v" sid="2KI 6:29"/>ከናፍ ኑ ሙጫኮ ብልቼፈትኔ ኛትኔ። ጉያ እት ኣኑትሞ አን፣ ‘አከ ኑ እሰ ኛኑፍ ሙጫኬ ኑፍ ኬን’ ጄዼን። እሼን ገሩ ሙጫሼ ንዾክፈቴ።”<verse eid="2KI 6:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="2KI 6:30"/>ሞትች ዮሙ ዱቢ ዱበርቲ ሰና ዸገኤት ኡፈተሳ ተርሳሴ። ኡቱ እን ደላ ዸጋ እራን ደርባ ጅሩ ነሞትን አከ እን ዸግነሳት ኣንሴ ወያ ገዳ ኡፈቴ ጅሩ አርገን። <verse eid="2KI 6:30"/><verse number="31" style="v" sid="2KI 6:31"/>እንስ፣ “ዮ መታን ኤልሳእ እልመ ሻፋጥ፣ ኤደነ እሰረ ቡሌ፣ ዋቅን ነ ሃአደቡ፤ አደቢን ሱንስ አከ መሌ ነት ሃጭሙ!” ጄዼ።<verse eid="2KI 6:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 6:32"/>ዬሮ ከነት ኤልሳእ መነሳ ኬሰ ታኣ ቱሬ፤ ማንጉዶትንስ እሰ ወጅን ተታኣ ቱረን። ሞትች ኤርገማ ቶኮ ኦፍ ዱረ ኤርጌ፤ ገሩ ኡቱ ኤርገማን ሱን ህንዹፍኑ ኤልሳእ ማንጉዶታን አከነ ጄዼ፤ “እስን አከ ነምች ነመ አጄሱ ኩን መታ ነራ ኩቱፍ ነመ ኤርጌ አርግቱ? ኩኖ ዮ ኤርገማን ሱን ዹፌ በልበለ ጩፋቲ ኦል ሴኑ ዾዋ። ኮቴን ጎፍታሳ እሰ ዱባን ዸገአማ ጅረ ምቲ?” <verse eid="2KI 6:32"/><verse number="33" style="v" sid="2KI 6:33"/>ኡቱመ እን አመዩ እሳን ወጅን ሃሰኣ ጅሩ፣ ኤርገማን ሱን ገረሳ ዹፌ።</para>
  <para style="p" vid="2KI 6:33">ሞትችስ፣ “በላን ኩን <char style="nd">ዋቀዮ</char> ብራ ዹፌ። አን ስአች ማሊፍን <char style="nd">ዋቀዮን</char> ኤገ?” ጄዼ።<verse eid="2KI 6:33"/></para>
  <chapter eid="2KI 6"/>
  <chapter number="7" style="c" sid="2KI 7"/>
  <para style="p">
    <verse number="1" style="v" sid="2KI 7:1"/>ኤልሳእ፣ “ዱቢ <char style="nd">ዋቀዮ</char> ዸገኣ። <char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ ቦር ዮነ ከረ ሰማርያ ዱረት ዳኩን ሰፈርቱን ቶኮ ሰቅሊ ቶኮት፣ ገርቡን ሰፈርቱን ለመሞ ሰቅሊ ቶኮት ጉርጉረመ” ጄዼ።<verse eid="2KI 7:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 7:2"/>አጀጃን ሎልቶታ ከን ሞትች እሬሳት እርከቴ ሱን ነመ ዋቃ ሰናን፣ “ኡቱመ <char style="nd">ዋቀዮ</char> ከረ ቡርቃ ሰሚወኒ በኔዩ ወን ኩን ተኡ ደንደኣ?” ጄዼ።</para>
  <para style="p" vid="2KI 7:2">ኤልሳእሞ፣ “አት እጁመኬቲን አርግተ፤ ገሩ ቶኮሳሌ ህንኛቱ!” ጄዼ።<verse eid="2KI 7:2"/></para>
  <para style="s1">ወር ሶርያ በቀተን</para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 7:3"/>ዬሮ ከነት ነሞተ ለምጢ ቀበን አፉርቱ በልበለ እቲን መጋለቲ ሴነን ዱረ ቱሬ። እሳንስ አከነ ወሊን ጄዸን፤ “ኑ ማሊፍ ሀመ ዱኑት አስ ቴኘ? <verse eid="2KI 7:3"/><verse number="4" style="v" sid="2KI 7:4"/>ዮ ኑ፣ ‘ኮታ መጋላ ሴና’ ጄኔ፣ ቤል አች ጅረ፤ ኑስ ንዱነ። ዮ አስ ቱሬ ንዱነ። ከናፉ ኮታ ገረ ቁበተ ወረ ሶርያ ዸቅና። ዮ እሳን ኑ ማረን ንጅራትነ፤ ዮ እሳን ኑ ፍጠንሞ ንዹምነ።”<verse eid="2KI 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 7:5"/>እሳን ገልገለ ድምምሳን ከአኒ ገረ ቁበተ ወረ ሶርያ ንዸቀን። ዮሙ እሳን ቁበተ ሰነ ብረ ገአንት ነምን ቶኮዩ አች ህንቱሬ፤ <verse eid="2KI 7:5"/><verse number="6" style="v" sid="2KI 7:6"/>ኩንስ ሰበቢ ጎፍታን አከ ወር ሶርያ ድድቹ ጋሪወኒ፣ ፈርዴኒቲፊ ከን ወራነ ጉዳ ዸገአኒ፣ “ኩኖ፣ ሞቲን እስራኤል ኑ ዸኡፍ ጄዼ ሞቲ ሄቶታቲፊ ሞቲ ወረ ግብጥ ኑት ብተቴረ!” ወሊን ጄዸን ጎዼፍ። <verse eid="2KI 7:6"/><verse number="7" style="v" sid="2KI 7:7"/>ከናፉ እሳን ዱንካነሳኒ፣ ፈርዴኒፊ ሀሮተሳኒ ዺሰኒ ድምምሳን በቀተን። ቁበተሳኒስ አኩመ ጅሩት ዺሰኒ ሉቡሳኒ ኦልፈቹዻፍ ንበቀተን።<verse eid="2KI 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 7:8"/>ነሞትን ለምጢ ቀበን ሱን ዳሪ ቁበተ ሰና ብረ ገአኒ ዱንካነ ቶኮ ሴነን። እሳንስ ዋ ኛተኒ ዹገኒ ሜቲ፣ ወርቄፊ ወያ ጉረተኒ ዸቀኒ ዾክፈተን። አመሌ ዴብአኒ ዱንካነ ብራ ሴነኒ ዋ ኬሳ ጉረተኒ አከሱመ ዾክፈተን።<verse eid="2KI 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 7:9"/>ከነረት እሳን አከነ ወሊን ጄዸን፤ “ኑ ዋን ቀጄላ ሆጄቹት ህንጅሩ፤ ጉያን ኩን ጉያ ኦዱ ጋሪት፤ ኑ ገሩ እኑመ ጨልእፍኔ። ዮ ኑ ሀመ በርኡት ጨልእፍኔ አደቢቱ ኑ ኤገተ። ከናፉ ኮታ ደፍኔ ዸቅኔ ኦዱ ከነ መነ ሞቱማት ህምና።”<verse eid="2KI 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 7:10"/>እሳንስ ዸቀኒ ነሞተ ከረ መጋላ ኤገን ዋመኒ፣ “ኑ ገረ ቁበተ ወረ ሶርያ ንዸቅኔ፤ ነምን ቶኮሌ አች ህንቱሬ፤ ሰገሌን ነመ ቶኮዩ ህንዸገአምኔ። ፈርዴኒፊ ሀሮተ ህዸመኒፊ ዱንካነ አኩመ ዻበሜት ዺፈሜ ቆፈቱ ቱሬ” ጄዸን። <verse eid="2KI 7:10"/><verse number="11" style="v" sid="2KI 7:11"/>ወር ከረ ኤገን ሱንስ ኦዱ ከነ ንለብሰን፤ ኦዱን ሱንስ መሰራ ሞቱማ ኬሰት ንዸገአሜ።<verse eid="2KI 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 7:12"/>ሞትችስ ሀልከኒን ከኤ አጀጆተ ሎልቶተሳቲን አከነ ጄዼ፤ “አን ዋን ወር ሶርያ ኑት ሆጄተን እስንትን ህመ፤ እሳን አከ ኑ ቤላን ሚዸማ ጅሩ ቤኩ፤ ከናፉ እሳን፣ ‘ዹጉማን እሳን ገድ ንበኡ፤ ኤርገሲስ ኑ ኡቱመ ሉቡን ጅረኑ እሳን ቀብኔ መጋለቲ ሴነ’ ጄዸኒ ያዱዻን ባድያ ኬሰ ዾከቹዻፍ ቁበተ ዺሰኒ በአን።”<verse eid="2KI 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 7:13"/>አጀጆተ ሎልቶተሳ ኬሳ ቶኮ አከነ ጄዼ ዴብሴ፤ “ነሞትን ቶኮ ቶኮ ፈርዴን መጋላ ኬሰት ሀፈን ኬሳ ሸን ፉዸተኒ ሃዴመን። ረክንሳኒ አኩመ እስራኤሎተ አስት ሀፈን ሁንዳት፤ ዹጉማን እሳን አኩመ እስራኤሎተ ዹመን ሰነ ሁንዳ ንተኡ። ከናፉ ኮታ ዋን ተኤ ቤኩዻፍ እሳን ኤርግና።”<verse eid="2KI 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 7:14"/>ከናፉ እሳን ጋሪወን ለመ ፈርዴንሳኒ ወጅን ንፍለን፤ ሞትችስ፣ “ዸቃቲ እላላ” ጄዼ ሎልቶተ ሶርያ ዱባን እሳን ኤርጌ። <verse eid="2KI 7:14"/><verse number="15" style="v" sid="2KI 7:15"/>እሳንስ ሀመ ዮርዳኖስት እሳን ዱካ ቡአን፤ ኩኖ ከራን ሁንድ ኡፈታፊ ምአ ወር ሶርያ ዬሮ አሪቲዻን በቀተንት ደደርበተኒን ጉተሜ ቱሬ። ኤርገሞትን ሱንስ ዴብአኒ ሞትቸት ህመን። <verse eid="2KI 7:15"/><verse number="16" style="v" sid="2KI 7:16"/>ኤርገሲስ ነሞትን ገድ ያአኒ ቁበተ ወረ ሶርያ ንሳመን። ከናፉ አኩመ <char style="nd">ዋቀዮ</char> ዱበቴ ሰነ ዳኩን ሰፈርቱን ቶኮ ሰቅሊ ቶኮት፣ ገርቡን ሰፈርቱን ለመሞ ሰቅሊ ቶኮት ጉርጉረሜ።<verse eid="2KI 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 7:17"/>ሞትችስ ዬሮ ከነት አጀጃ ሎልቶታ ከን እሬሳት እርከቴ ቱሬ ሰነ እት ጋፈተማ ከራ ጎዼ ሙዴ፤ ነሞትንስ ከረ ዱረት እሰረ ያአን፤ እንስ አኩመ ነምን ዋቃ ዬሮ ሞትች መነሳ ዹፌት ዱበቴ ሰነ ንዱኤ። <verse eid="2KI 7:17"/><verse number="18" style="v" sid="2KI 7:18"/>ኩንስ አኩመ ነምን ዋቃ ሱን፣ “ቦር ዮነ ከረ ሰማርያ ዱረት ዳኩን ሰፈርቱን ቶኮ ሰቅሊ ቶኮት፣ ገርቡን ሰፈርቱን ለመሞ ሰቅሊ ቶኮት ንጉርጉረመ” ጄዼ ሞትቸት ህሜ ሰነ ተኤ።<verse eid="2KI 7:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 7:19"/>አጀጃን ሎልቶታ ሱንስ ነመ ዋቃ ሰናን “ኡቱመ <char style="nd">ዋቀዮ</char> ከረ ቡርቃ ሰሚወኒ በኔሌ ወን ኩን ተኡ ደንደኣ?” ጄዼ። ነምን ዋቃ ሱንሞ፣ “አት እጁመኬቲን አርግተ፤ ገሩ ቶክቸሳሌ ህንኛቱ!” ጄዼ። <verse eid="2KI 7:19"/><verse number="20" style="v" sid="2KI 7:20"/>ወን እሰረ ገኤስ ዹጉማን ከናዸ፤ እን ዋን ነሞትን ከረ ዱረት እሰረ ያአኒፍ ዱኤቲ።<verse eid="2KI 7:20"/></para>
  <chapter eid="2KI 7"/>
  <chapter number="8" style="c" sid="2KI 8"/>
  <para style="s1">ለፍት ዱበርቲ ሱነም ንዴብኤፍ</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 8:1"/>ዬሮ ከነት ኤልሳእ ዱበርቲ እልመሼ ዱኣ ካሴፍ ሰናን፣ “ሰበቢ <char style="nd">ዋቀዮ</char> ቤለ ወጋ ቶርበ ቱሩ ቶኮ ብየ ከነት አጀጄፍ፣ ማቲኬ ወጅን አሲ ዴሚቲ እዶ ጅራቹ ደንዴሱ ከምዩ ጅራዹ” ጄዼ። <verse eid="2KI 8:1"/><verse number="2" style="v" sid="2KI 8:2"/>ዱበርቲን ሱንስ ካቴ አኩመ ነምን ዋቃ ሱን ጄዼን ጎቴ። እሼፊ ማቲንሼ ዸቀኒ ብየ ፍልስጤሞታ ኬሰ ወጋ ቶርበ ጅራተን።<verse eid="2KI 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 8:3"/>እሼንስ ዹመ ወጋ ቶርባት ብየ ፍልስጤሞታቲ ዴብቴ መናፊ ለፈሼ ከዸቹፍ ገረ ሞትቻ ንዸቅጤ። <verse eid="2KI 8:3"/><verse number="4" style="v" sid="2KI 8:4"/>ሞትችስ፣ “ሜ ዋን ኤልሳእ ሆጄቴ ጉርጉዳ ነት ህም” ጄዼ ጌሃዝ ተጃጅላ ነመ ዋቃ ሰነ ወጅን ሃሰኣ ቱሬ። <verse eid="2KI 8:4"/><verse number="5" style="v" sid="2KI 8:5"/>ኡቱመ ጌሃዝ አከ ኤልሳእ ነመ ዱኤሌ ዱኣ ካሴ እሰት ህሙት ጅሩ ዱበርቲን ኤልሳእ እልመሼ ዱኣ ካሴፍ ሱን መናፊ ለፈሼ ከዸቹዻፍ ገረ ሞትቻ ዹፍቴ።</para>
  <para style="p" vid="2KI 8:5">ጌሃዝስ፣ “ያ ጎፍታኮ ሞትቸ፣ ዱበርቲን ኤልሳእ ሙጫሼ ዱኣ ካሴፍ ሱን ኩኖት” ጄዼ። <verse eid="2KI 8:5"/><verse number="6" style="v" sid="2KI 8:6"/>ሞትች ዋኤ ዋን ሰና ዱበርትቲ ጋፈቴ፤ እሼንስ እት ህምቴ።</para>
  <para style="p" vid="2KI 8:6">እንስ ኤርገሲ ቆንዳለ ቶኮ ዱቢሼት ረመዴ፣ “ገሊ ጉያ እሼን ብያ ባቴ ጀልቀቤ ለፈ ቆቲሳሼራ አርገሜ ሁንደ እት ደበሊቲ ዋን ከንሼ ቱሬ ሁንደ ዴብሲፍ” ጄዼን።<verse eid="2KI 8:6"/></para>
  <para style="s1">ሀዛኤል ቤን-ሀዳድን አጄሴ</para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 8:7"/>ኤልሳእ ደማስቆ ዸቄ፤ ቤን-ሀዳድ ሞትች ሶርያሞ ዹኩብሰቴ ቱሬ። ሞቲን ሱንስ ዮሙ፣ “ነምን ዋቃ ሱን አስ ዹፌ ጅረ” ጄዸኒ እት ህመንት፣ <verse eid="2KI 8:7"/><verse number="8" style="v" sid="2KI 8:8"/>ሀዛኤሊን አከነ ጄዼ፤ “ኬና ወዪ ፉዸዹቲ ዸቂ ነመ ዋቃ ሰነ ስመዹ። ከራሳቲንስ፣ ‘አን ዹኩበ ከነራ ነንሀፋ?’ ጄዺ <char style="nd">ዋቀዮን</char> ጋፈዹ።”<verse eid="2KI 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 8:9"/>ሀዛኤልስ ዋን ደማስቆ ኬሳ አከ መሌ ገጋሪ ተኤ ፉዸቴ ኬና ፌኢሰ ጋለ አፉርተማቲን ኤልሳእን ስመቹ ዸቄ። ኦል ሴኔስ ፉለሳ ዱረ ዻበቴ፣ “እልመኬ ቤን-ሀዳድ ሞትቸ ሶርያቱ፣ ‘አን ዹኩበ ከነራ ሀፋ?’ ጄዼ ስት ነ ኤርጌ” ጄዼን።<verse eid="2KI 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 8:10"/>ኤልሳእሞ፣ “ዸቂቲ፣ ‘አት ዹጉማንራ ሀፍተ’ ጄዺን፤ ገሩ <char style="nd">ዋቀዮ</char> አከ እን ዹጉማን ዱኡ ነ አርግሲሴረ” ጄዼ ዴብሴፍ። <verse eid="2KI 8:10"/><verse number="11" style="v" sid="2KI 8:11"/>ኤልሳእ ሀመ ሀዛኤል ቃነኡት ኡቱ እጀ እራ ህንቡቅፈትን እሰ እላሌ። ኤርገሲ ነምን ዋቃ ሱን ቦኡ ጀልቀቤ።<verse eid="2KI 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 8:12"/>ሀዛኤልስ፣ “ጎፍታንኮ ማሊፍ ቦአ?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="2KI 8:12">እንሞ አከነ ጄዼ ዴብሴ፤ “ሰበቢ አን ሚዻ አት እስራኤልት ፍዱ ቤኩፍ፤ አት ደአትኖሳኒት እብደ ነቅጠ፤ ደርገጎተሳኒ ጎራዴዻን ፍጠ፤ ዳእመንሳኒ ለፋን ዾፍቴ ምምጭርቅስተ፤ ዱበርቶተሳኒ ከኔን ኡልፋአን ገራ በቀቅስተ።”<verse eid="2KI 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 8:13"/>ሀዛኤል፣ “አን ገርብችኬ ሰሬን ኩን አከሚን ዋን ሀምቱ አከና ሆጄዸ?” ጄዼ።</para>
  <para style="p" vid="2KI 8:13">ኤልሳእሞ፣ “<char style="nd">ዋቀዮ</char> አከ አት ሞቲ ሶርያ ታቱ ነ አርግሲሴረ” ጄዼ ዴብሴፍ።<verse eid="2KI 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 8:14"/>ሀዛኤል ኤርገሲ ኤልሳእ ብራ በኤ ገረ ጎፍታሳት ዴብኤ። ዮሙ ቤን-ሀዳድ፣ “ኤልሳእ ማል ሲን ጄዼ?” ጄዼ ጋፈቴትስ፣ ሀዛኤል፣ “እን አከ አት ዹጉማንራ ሀፍቱ ነት ህሜ” ጄዼ ዴብሴ። <verse eid="2KI 8:14"/><verse number="15" style="v" sid="2KI 8:15"/>እን ገሩ ጉያ እት ኣኑ ወያ ፉርዳ ቶኮ ፉዼ ብሻን ኬሰ ጩጴ ፉለ ሞትቻ ሀጉጌ፤ አከሲን ሞትች ዱኤ። ኤርገሲ ሀዛኤል እዶሳ ቡኤ ሞቲ ተኤ።<verse eid="2KI 8:15"/></para>
  <para style="s1">ዬሆራም ሞትቸ ይሁዳ</para>
  <para style="r">
    <ref loc="2KI 8:16-24">8፥16‑24</ref> ኩወፈ – <char style="xt"><ref loc="2CH 21:5-10">2ሴና 21፥5‑10</ref>፣<ref loc="2CH 21:20">20</ref></char></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 8:16"/>በረ ዬሆራም እልመ አሃብ ሞትቸ እስራኤል ኬሰ ወጋ ሸነፋት ዮራም እልም ዬሆሻፋጥ ሞትቸ ይሁዳ ሱን ሞቲ ተኤ ቡልቹ ጀልቀቤ። <verse eid="2KI 8:16"/><verse number="17" style="v" sid="2KI 8:17"/>ዬሮ ሰነት ኡሙሪንሳ ወጋ ሶዶሚ ለመ ቱሬ፤ እንስ ዬሩሳሌም ኬሰ ታኤ ወጋ ሰዴት ንቡልቼ። <verse eid="2KI 8:17"/><verse number="18" style="v" sid="2KI 8:18"/>እንስ አኩመ መን አሃብ ጎዼ ቱሬ ሰነ ከራ ሞቶተ እስራኤል ዱካ ቡኤ፤ እንተለ አሃብ ፉዼ ቱሬቲ። ፉለ <char style="nd">ዋቀዮ</char> ዱረትስ ዋን ሀማ ሆጄቴ። <verse eid="2KI 8:18"/><verse number="19" style="v" sid="2KI 8:19"/>ተኡስ <char style="nd">ዋቀዮ</char> ሰበቢ ገርብቸሳ ዳዊቲፍ ጄዼ ይሁዳ በሌሱን ፌዺ <char style="nd">ዋቀዮ</char> ህንቱሬ። እን ዳዊቲፊ ሰኚሳቲፍ እብሳ በረ በራ ዻቡፍ ከኩ ገሌ ቱሬ።<verse eid="2KI 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 8:20"/>በረ ዮራም ኬሰ ኤዶም ይሁዳት ፍንጭሌ ሞቲ ኦፊሳ ሞስፈቴ። <verse eid="2KI 8:20"/><verse number="21" style="v" sid="2KI 8:21"/>ከናፉ ዮራም ጋሪወንሳ ሁንደ ወጅን ዛኢር ዸቄ። ወር ኤዶምስሳፊ አጀጆተ ጋሪወንሳ መርሰን፤ እን ገሩ ሀልከኒን ከኤ እሳን ንዸኤ፤ ሎልቶትንሳ ገሩ ገረ ብየሳኒት በቀተን። <verse eid="2KI 8:21"/><verse number="22" style="v" sid="2KI 8:22"/>ኤዶም ሀመ ሀርኣትሌ አኩመ ይሁዳት ፍንጭሌት ጅረ። ልብናንስ ዬሩመ ሰነት ፍንጭሌ።<verse eid="2KI 8:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 8:23"/>ወንቶትን በረ ሞቱማ ዮራም ኬሰ ሆጄተመን ከን ብራቲፊ ወን እን ሆጄቴ ሁንድ ክታበ ሴና ሞቶተ ይሁዳ ኬሰት በሬፈመኒሩ ምቲ? <verse eid="2KI 8:23"/><verse number="24" style="v" sid="2KI 8:24"/>ዮራም አቦቲ ኦፊ ወጅን ቦቆቴ መጋላ ዳዊት ኬሰት እሳን ብረት ንአዋለሜ። አሃዝያን እልምሳ እዶሳ ቡኤ ሞቲ ተኤ።<verse eid="2KI 8:24"/></para>
  <para style="s1">አሃዝያ ሞትቸ ይሁዳ</para>
  <para style="r">
    <ref loc="2KI 8:25-29">8፥25‑29</ref> ኩወፈ – <char style="xt"><ref loc="2CH 22:1-6">2ሴና 22፥1‑6</ref></char></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 8:25"/>በረ ዬሆራም እልመ አሃብ ሞትቸ እስራኤል ኬሰ ወጋ ኩዸ ለመፋት አሃዝያን እልም ዮራም ሞቲ ይሁዳ ተኤ ቡልቹ ጀልቀቤ። <verse eid="2KI 8:25"/><verse number="26" style="v" sid="2KI 8:26"/>አሃዝያን ዬሮ ሞቲ ተኤት ኡሙሪንሳ ወጋ ድግደሚ ለመ ቱሬ፤ እንስ ዬሩሳሌም ኬሰ ታኤ ወጋ ቶኮ ንቡልቼ። መቃን ሃዸሳ አታልያዸ፤ እሼንስ እንተለ እልመ ኦምሪ ሞትቸ እስራኤል ሰና ቱርቴ። <verse eid="2KI 8:26"/><verse number="27" style="v" sid="2KI 8:27"/>እንስ ከራ መነ አሃብ ዱካ ቡኤ፣ አኩመ መን አሃብ ጎዼ ሰነ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዋን ሀማ ሆጄቴ፤ እን ከራ ፉዻቲን ማቲ አሃብት ፍሮሜ ቱሬቲ።<verse eid="2KI 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 8:28"/>አሃዝያንስ ዮራም እልመ አሃብ ወጅን ሀዛኤል ሞትቸ አራም ሎሉዻፍ ራሞት ግልኣድት ዱሌ። ወር አራምስ ዮራምን ንመዴሰን፤ <verse eid="2KI 8:28"/><verse number="29" style="v" sid="2KI 8:29"/>ከናፉ ዬሆራም ሞትች መዳ ወር አራም ዬሮ እን ራማት ኬሰት ሀዛኤል ሞትቸ አራም ወጅን ወል ሎሌት እሰ መዴሰን ሰነ ፈዩፍ ጄዼ ይዝርኤልት ዴብኤ።</para>
  <para style="p" vid="2KI 8:29">ከነረት አሃዝያን እልም ዮራም ሞትች ይሁዳ ሰበቢ እን መዳኤ ቱሬፍ ዮራም እልመ አሃብ አርጉፍ ገረ ይዝርኤልት ገድ ቡኤ።<verse eid="2KI 8:29"/></para>
  <chapter eid="2KI 8"/>
  <chapter number="9" style="c" sid="2KI 9"/>
  <para style="s1">ዬሁን ሞቲ እስራኤል ተኤ ድበሜ</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 9:1"/>ኤልሳእ ራጅች እልማን ራጆታ ኬሳ ነመ ቶኮ ዋሜ አከነ ጄዼን፤ “ሙዺኬ ህዸዹቲ ብልቃጢ ዘይቲ ከነ ፉዺ ራሞት ግልኣድ ዸቅ። <verse eid="2KI 9:1"/><verse number="2" style="v" sid="2KI 9:2"/>ዬሮ አች ጌሱት ዬሁ እልመ ዬሆሻፋጥ እልመ ንምሺ ሰነ በርባድ። ገረሳ ዸቂቲ ሚልቶተሳ ብራ እሰ ፉዺቲ ዲንቀት እሰ ገልች። <verse eid="2KI 9:2"/><verse number="3" style="v" sid="2KI 9:3"/>ኤርገሲ ብልቃጢ ሰነ ፉዺ ዘይቲ ሰነ መታሳት ነቂቲ፣ ‘<char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ አን እስራኤልረት ሞቲ ጎዼ ስ ድቤረ።’ ኤርገሲ በልበለ በነዹቲ ፊግ መሌ ህንቱርን!”<verse eid="2KI 9:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 9:4"/>ከናፉ ራጅች ደርገጌስ ሱን ከኤ ራሞት ግልኣድ ዸቄ። <verse eid="2KI 9:4"/><verse number="5" style="v" sid="2KI 9:5"/>ዮሙ አች ገኤትስ አጀጆተ ሎልቶታ ከኔን ወልት ቀበመኒ ተታአን አርጌ። እንስ፣ “ያ አጀጃ፣ አን ኤርጋ ሲፍ ቀበ” ጄዼ።</para>
  <para style="p" vid="2KI 9:5">ዬሁንሞ፣ “ኑ ኬሳ፣ አት ኤኙፍ ኤርጋ ቀብደ?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="2KI 9:5">እንስ፣ “ያ አጀጃ፣ ስኢፍ” ጄዼ ዴብሴ።<verse eid="2KI 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 9:6"/>ዬሁን ከኤ መነ ኦል ሴኔ። ራጅች ሱን መታ ዬሁት ዘይቲ ነቄ አከነ ጄዼን፤ “<char style="nd">ዋቀዮ</char> ዋቅን እስራኤል አከነ ጄዸ፤ ‘አን ሰበ <char style="nd">ዋቀዮ</char>፣ እስራኤልረት ሞቲ ጎዼ ስን ድበ። <verse eid="2KI 9:6"/><verse number="7" style="v" sid="2KI 9:7"/>አት መነ ጎፍታኬቲ መነ አሃብ በሌሱ ቀብደ፤ አንስ ዺገ ገርቦተኮ ራጆታቲፊ ዺገ ገርቦተ <char style="nd">ዋቀዮ</char> ከኔን ኢዛቤል ዸንገላፍቴ ሁንደ ሃሎ ነንባሰ። <verse eid="2KI 9:7"/><verse number="8" style="v" sid="2KI 9:8"/>መን አሃብ ጉቱማን ጉቱት ንበደ። አን ዺረ ማቲ አሃብ ከኔን እስራኤል ኬሰት ሀፈን ሁንደ ገርበስ ተኡ ብርመዱ ነንበሌሰ። <verse eid="2KI 9:8"/><verse number="9" style="v" sid="2KI 9:9"/>አን መነ አሃብ አኩመ መነ ዬሮብኣም እልመ ኔባቲፊ አኩመ መነ በእሻን እልመ አሂያ ሰና ነንጎዸ። <verse eid="2KI 9:9"/><verse number="10" style="v" sid="2KI 9:10"/>ኢዛቤልንሞ ሰሮተቱ ብየ ይዝርኤል ኬሰት ኛተ፤ ነምን ቶኮዩ እሼ ህንአዋሉ።’ ” እንስ ኤርገሲ በልበለ በነቴ ፊጌ።<verse eid="2KI 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 9:11"/>ዬሁን ገረ አጀጁወን እሰ ወጅን ቱረን ሰናት ገድ ባናን እሳን ኬሳ ነምን ቶኮ፣ “ወን ሁንድ ነጉማ? ነምች መራቱን ኩን ማሊፍ ስ ብረ ዹፌ?” ጄዼ እሰ ጋፈቴ።</para>
  <para style="p" vid="2KI 9:11">ዬሁንስ፣ “አት ነምቻፊ ዋን እን ዱበቴ ንቤክተ” ጄዼ ዴብሴፍ።<verse eid="2KI 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 9:12"/>እሳንስ፣ “ኩን ዹጋ ምት! ኑት ህም” ጄዸኒን።</para>
  <para style="p" vid="2KI 9:12">ዬሁን፣ “ወን እን ነት ህሜ ከናዸ፤ ‘<char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ አን እስራኤልረት ሞቲ ጎዼ ስ ድቤረ’ ” ጄዼ ዴብሴፍ።<verse eid="2KI 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 9:13"/>እሳን ደፈኒ ወያሳኒ ኦፍራ ፉዸኒ ጉለንታወን ዱዋረ እሰ ጀለ አፈን። ኤርገሲሞ መለከተ አፉፈኒ፣ “ዬሁን ሞቲዸ!” ጄዸን።<verse eid="2KI 9:13"/></para>
  <para style="s1">ዬሁን ዬሆራሚፊ አሃዝያ አጄሴ</para>
  <para style="r">
    <ref loc="2KI 9:21-29">9፥21‑29</ref> ኩወፈ – <char style="xt"><ref loc="2CH 22:7-9">2ሴና 22፥7‑9</ref></char></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 9:14"/>ከናፉ ዬሁን እልም ዬሆሻፋጥ እልም ንምሺ ዮራምት መለቴ። ዬሮ ሰነት ዮራሚፊ እስራኤል ሁንድ ራሞት ግልኣድራ ሀዛኤል ሞትቸ ሶርያ ኤጋ ቱረን፤ <verse eid="2KI 9:14"/><verse number="15" style="v" sid="2KI 9:15"/>ዬሆራም ሞትች ገሩ መዳ ወር አራም ዬሮ እን ሀዛኤል ሞትቸ አራሚቲን ወል ሎሌት እሰ መዴሰን ሰናፍ ወልኣንሰ አርገቹፍ ጄዼ ይዝርኤልት ዴብኤ ቱሬ። ዬሁን፣ “ዮ ያድንኬ ከነ ተኤ፣ አከ ነምን ቶኮዩ መጋላ ኬሳ ገድ በኤ ዸቄ ኦዱ ከነ ይዝርኤል ኬሰት ኦዴሱ ህንኤየምን” ጄዼ። <verse eid="2KI 9:15"/><verse number="16" style="v" sid="2KI 9:16"/>እንስ ኤርገሲ ጋሪሳ ሴኔ ሰበቢ ዮራም አችት ቦቆቻ ጅሩፊ ሰበቢ አሃዝያ ሞትች ይሁዳ እሰ አርጉፍ ገድ ቡኤፍ ይዝርኤልት ቀጄሌ።<verse eid="2KI 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 9:17"/>ኤግዱን ገሞ ኤጉምሳ ከን ይዝርኤል ኬሳረ ዻበቻ ቱሬ ሱን ዮሙ ሎልቶተ ዬሁ ከኔን ዹፋ ጅረን አርጌት፣ “አን ሎልቶተ ዹፋ ጅረን ቶኮን አርገ” ጄዼ እዬ።</para>
  <para style="p" vid="2KI 9:17">ዬሆራምስ፣ “አባ ፈርዳ ቶኮ ዋሚቲ አከ እን እሳንት ገድ በኤ፣ ‘እስን ነጉመ ዹፍተኒ?’ ጄዼ እሳን ጋፈቱፍ እት ኤርግ” ጄዼ አጀጄ።<verse eid="2KI 9:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 9:18"/>አባን ፈርዳ ሱንስ ዬሁ አርጉፍ ጉሉፌ ዸቄ፣ “ሞትች፣ ‘እስን ነጉመ ዹፍተኒ?’ ጄዸ” ጄዼን።</para>
  <para style="p" vid="2KI 9:18">ዬሁንሞ፣ “አት ነጋራ ማል ቀብደ? ገረገሊቲ ነ ዱካ ቡእ” ጄዼ ዴብሴ።</para>
  <para style="p" vid="2KI 9:18">ኤግዱን ሱንስ፣ “ኤርገማን እሳን ብረ ገኤረ፤ ገሩ አስ ህንዴብኔ” ጄዼ ህሜ።<verse eid="2KI 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 9:19"/>ከናፉ ሞትች አባ ፈርዳ ለመፋ ኤርጌ። እንስ ገረሳኒ ዸቄ፣ “ሞትች፣ ‘እስን ነጉመ ዹፍተኒ?’ ጄዸ” ጄዼን።</para>
  <para style="p" vid="2KI 9:19">ዬሁንሞ፣ “አት ነጋራ ማል ቀብደ? ገረገሊቲ ነ ዱካ ቡእ” ጄዼ ዴብሴ።<verse eid="2KI 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 9:20"/>ኤግዱን ሱንስ፣ “እን እሳን ብረ ገኤረ፤ ገሩ አስ ህንዴብኔ። ኦፍችሳ አኩመ ኦፍቸ ዬሁ እልመ ንምሺ ሰናት፤ እን አኩመ ነመ መራቴ ቶኮት ኦፋቲ” ጄዼ ህሜ።<verse eid="2KI 9:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 9:21"/>ከነረት ዬሆራም፣ “ጋሪኮ ና ቆጴሳ” ጄዼ አጀጄ። ኤርገ ጋሪን ቆጴፈሜ ቦዴ ዬሆራም ሞትች እስራኤሊፊ አሃዝያን ሞትች ይሁዳ፣ ቶኮን ቶኮንሳኒ ጋሪሳኒ ያበተኒ ዬሁ ስመቹ ዸቀን። እሳንስ ለፈ ቆቲሳ ናቦት ነምቸ ይዝርኤል ሰና ኬሰት እሰ አርገተን። <verse eid="2KI 9:21"/><verse number="22" style="v" sid="2KI 9:22"/>ዬሆራም ዮሙ ዬሁ አርጌት፣ “እዩ፣ አት ነጉመ ዹፍቴ?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="2KI 9:22">ዬሁንሞ፣ “ሀመ ሰጋገሉማፊ ፈልፈል ሃዸኬ ኢዛቤል ብየ ጉቴ ጅሩት ነጋ ማልቱ ጅራቹ ደንደአ?” ጄዼ ዴብሴ።<verse eid="2KI 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 9:23"/>ዬሆራም ኦፍረ ገረገሌ አሃዝያዻን፣ “ያ አሃዝያ፣ ወን ኩን መልቱማዸ!” ጄዼ በቀቴ።<verse eid="2KI 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 9:24"/>ዬሁን ጥየሳ ደርበቴ ገቲቲ ዬሆራም ግዱ ወራኔ፤ ጥይ ሱንስ ኦኔሳ ኬሰ ፉለኤ፤ እንስ ጋሪሳ ኬሰት ኩፌ። <verse eid="2KI 9:24"/><verse number="25" style="v" sid="2KI 9:25"/>ዬሁንስ አጀጃ ጋሪሳ ብድቃሪን አከነ ጄዼ፤ “እሳ ፉዺቲ ለፈ ቆቲሳ ናቦት ነምቸ ይዝርኤል ሰና ኬሰት ገት። አከ <char style="nd">ዋቀዮ</char> ጋፈ አኒፊ አት ጋሪዻን አሃብ አባሳ ዱባን ጉሉፋ ቱሬ ሰነ አከነ ጄዼ ዋኤሳ ራጂ ዱበቴ ያደዹ፦ <verse eid="2KI 9:25"/><verse number="26" style="v" sid="2KI 9:26"/>‘አን ከሌሰ ዺገ ናቦቲቲፊ ዺገ እልማንሳ አርጌረ፣ ጄዸ <char style="nd">ዋቀዮ</char>፤ አን ዹጉማን አከ አት ገቲ ዺገ ሰና ለፈ ቆቲሳ ሰነረት ባፍቱ ነንጎዸ’ ጄዸ <char style="nd">ዋቀዮ</char>። ኤጋ አመ እሰ ፉዺቲ አኩመ ዱቢ <char style="nd">ዋቀዮት</char> ለፈ ቆቲሳ ሰነ ኬሰት እሰ ገት።”<verse eid="2KI 9:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 9:27"/>አሃዝያ ሞትች ይሁዳ ዮሙ ዋን ከነ አርጌት ከራ ቤት ሀጋንት ጌሱን በቀቴ። ዬሁን፣ “እሰስ አጄሳ!” ጄዼ እያ እሰ አርኤ። እሳንስ ከራ ጉርት ጌሱረት ይብሌኣም ብረት እሰ መዴሰን፤ እን ገሩ ሜግዶት በቀቴ አችት ዱኤ። <verse eid="2KI 9:27"/><verse number="28" style="v" sid="2KI 9:28"/>ተጃጅልቶትንሳ ጋሪዻን ዬሩሳሌምት እሰ ጌሰኒ አዋለሳ ከን መጋላ ዳዊት ኬሳት አቦቲሳ ብረት እሰ አዋለን። <verse eid="2KI 9:28"/><verse number="29" style="v" sid="2KI 9:29"/>በረ ዮራም እልመ አሃብ ኬሰ ወጋ ኩዸ ቶኮፋት አሃዝያን ሞቲ ይሁዳ ተኤ።<verse eid="2KI 9:29"/></para>
  <para style="s1">ኢዛቤል አጄፈምቴ</para>
  <para style="p">
    <verse number="30" style="v" sid="2KI 9:30"/>ኤርገሲ ዬሁን ከኤ ይዝርኤል ዸቄ። ኢዛቤል ዮሙ ዋን ከነ ዸጌሴት እጀሼ ኩለቴ መታ ዸአቴ ፎዳ ኬሳን አለ እላልቴ። <verse eid="2KI 9:30"/><verse number="31" style="v" sid="2KI 9:31"/>አኩመ ዬሁን ከራን ኦል ሴኔን ኢዛቤል፣ “ዝምሪ፣ አት ነምች ጎፍታኬ አጄፍቴ ነጉመ ዹፍቴ?” ጄቴን።<verse eid="2KI 9:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 9:32"/>እንስ ፎዳ ሰነ ኬሳን ኦል እላሌ፣ “ኤኙቱ ነ ብረ ጅረ? ኤኙዸ?” ጄዼ። ጡኣሺወን ለመ ዮካን ሰዲ ተአን ገረሳ ገድ እላለን። <verse eid="2KI 9:32"/><verse number="33" style="v" sid="2KI 9:33"/>ዬሁን፣ “እሼ ገድ ደርበዻ!” ጄዼን። ከናፉ እሳን ገድ እሼ ደርበተን፤ አከሲን ዺግንሼ ኬኘን መናቲፊ ፈርዴን ኮቴዻን እሼረ ያአን ሰነት ፈፈጨኤ።<verse eid="2KI 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="2KI 9:34"/>ዬሁን ኦል ሴኔ ዋ ኛቴ ዹጌ። እንስ፣ “ዱበርቲ አባረምቱ ከነ ፉዻቲ አዋላ፤ እሼን እንተለ ሞቲ ቱርቴቲ” ጄዼ። <verse eid="2KI 9:34"/><verse number="35" style="v" sid="2KI 9:35"/>እሳን ገሩ ዬሮ እሼ አዋሉፍ ገድ በአንት ቡቄ መታሼ፣ ሀርካፊ ሚለሼ መሌ ዋን ቶኮሌ ህንአርግኔ። <verse eid="2KI 9:35"/><verse number="36" style="v" sid="2KI 9:36"/>እሳንስ ዴብአኒ ዬሁት ህመን፤ እንስ አከነ ጄዼ፤ “ኩን ዱቢ <char style="nd">ዋቀዮ</char> ከራ ገርብቸሳ ኤልያስ ነምቸ ትሽቢ ሰናቲን አከነ ጄዼ ዱበቴዸ፦ ለፈ ቆቲሳ ይዝርኤል ኬሳ ቶኮረት ሰሮትን ፎን ኢዛቤል ንኛቱ። <verse eid="2KI 9:36"/><verse number="37" style="v" sid="2KI 9:37"/>ሬፍ ኢዛቤልስ አከ ነምን ቶኮዩ፣ ‘ኩን ኢዛቤል’ ጄቹ ህንደንዴኜፍ ለፈ ቆቲሳ ይዝርኤል ኬሳ ቶኮረት አኩመ ኮሲ ተአ።”<verse eid="2KI 9:37"/></para>
  <chapter eid="2KI 9"/>
  <chapter number="10" style="c" sid="2KI 10"/>
  <para style="s1">ማቲን አሃብ አጄፈመን</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 10:1"/>ዬሮ ሰነት አሃብ እልማን ቶርባተመ ሰማርያ ኬሳ ቀበ ቱሬ። ከናፉ ዬሁን ጠለዮተ በሬሴ ቆንዳልቶተ ይዝርኤልት፣ ማንጉዶተቲፊ ጉድፍቶተ እልማን አሃብት ገረ ሰማርያት ኤርጌ። እን አከነ ጄዼ፤ <verse eid="2KI 10:1"/><verse number="2" style="v" sid="2KI 10:2"/>“አኩመ ጠለያን ኩን እስን ገኤን፣ ዋን እልማን ጎፍታኬሰኒ እስን ብረ ጅረኒፊ ዋን እስንስ ጋሪወኒፊ ፈርዴን፣ መጋላ ጀቤፈሜ እጃረሜፊ ምአ ሎላ ቀብደኒፍ፣ <verse eid="2KI 10:2"/><verse number="3" style="v" sid="2KI 10:3"/>እልማን ጎፍታኬሰኒ ኬሳ ከን ወረ ካን ጫሉፊ ከን ንመለ ጄተኒ ያደን ፍለዻቲ ቴሶ አባሳረ ቴስሳ። ኤርገሲስ መነ አባኬሰኒቲፍ ሎላ።”<verse eid="2KI 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 10:4"/>እሳን ገሩ አከ መሌ ሶዳተኒ፣ “ዮ ሞቶትን ለመ እሰ ህንደንደእን ኑ አከሚን እሰ ደንዴኘ?” ወሊን ጄዸን።<verse eid="2KI 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 10:5"/>ከናፉ ቡልቻን መሰራ ሞቱማቲፊ ሹሚን መጋለቲ፣ ማንጉዶትኒፊ ጉድፍቶትን፣ “ኑ ገርቦተኬት፤ ዋን አት ጄቱ ሁንደ ንሆጄትነ። ኑ ነመ ቶኮሌ ሞቲ ጎኔ ህንፍለትኑ፤ አት መታንኬ ዋኑመ ጃለቴ ጎዽ” ጄዸኒ ኤርጋ ከነ ዬሁት ኤርገን።<verse eid="2KI 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 10:6"/>ዬሁንሞ፣ “እስን ዮ ገሬኮ ታተኒፊ ዮ ናአጀጀምተን፣ መታ እልማን ጎፍታኬሰኒ ኩኩታቲ ቦር ዬሮ ከነት ይዝርኤልት ና ፍዳ” ጄዼ ጠለያ ለመፋ በሬሴ።</para>
  <para style="p" vid="2KI 10:6">ዬሮ ከነት እልማን ሞቲ ቶርባተመኑ ነሞተ መጋላ ሰና ቤቤከሞ ከኔን እሳን ጉድሰን ብረ ቱረን። <verse eid="2KI 10:6"/><verse number="7" style="v" sid="2KI 10:7"/>ዮሙ ጠለያን ሱን እሳን ገኤት ነሞትን ኩኔን እልማን ሞቲ ቶርባተመን ሰነ ሁንዱማ ንጎጎረአን። መታሳኒስ ጉቦት ነቀኒ ገረ ይዝርኤልት ዬሁዻፍ ንኤርገን። <verse eid="2KI 10:7"/><verse number="8" style="v" sid="2KI 10:8"/>ኤርገምትች ዮሙ ዴብኤት፣ “እሳን መታ እልማን ሞቲ ፍደኒሩ” ጄዼ ዬሁት ህሜ።</para>
  <para style="p" vid="2KI 10:8">ዬሁንሞ፣ “ሜ በልበለ እቲን መጋለቲ ሴነን ዱረት እዶ ለመት ቱላቲ ሀመ ለፍት በሪቱት ቱርሳ” ጄዼ አጀጄ።<verse eid="2KI 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 10:9"/>ዬሁን ጉያ እት ኣኑ ገነማን ከኤ ገድ በኤ። ፉለ ነሞተ ሁንዳ ዱረ ዻበቴስ አከነ ጄዼ፤ “እስን የከ ህንቀብደን። ነምን ጎፍታኮት መለቴ እሰ አጄሴ አኑመ፤ ገሩ ወረ ከነ ሁንደ ኤኙቱ ፍጤ? <verse eid="2KI 10:9"/><verse number="10" style="v" sid="2KI 10:10"/>ከናፉ አከ ዱቢን <char style="nd">ዋቀዮ</char> መነ አሃብረት ዱበቴ ቶኮዩ ለፈ ህንቡኔ ቤካ። <char style="nd">ዋቀዮ</char> ዋን ከራ ገርብቸሳ ኤልያሲን ዱበቴ ሰነ ጉቴረ።” <verse eid="2KI 10:10"/><verse number="11" style="v" sid="2KI 10:11"/>ዬሁንስ አከሲን ነመ መነ አሃብ ኬሳ ይዝርኤል ኬሰት ሀፌ ከምዩ፣ ነሞተሳ ጉርጉዳ፣ ምቾተሳ ከኔን እት ዽኣተኒፊ ሉቦተሳ፣ ኡቱ ነመ ቶኮሌ ህንሀምብስን ሁንደሳኒ ፍጤ።<verse eid="2KI 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 10:12"/>ዬሁን ኤርገሲ ከኤ ሰማርያ ዸቄ። እንስ ዮሙ ቤት ኤከድ ገኤት፣ <verse eid="2KI 10:12"/><verse number="13" style="v" sid="2KI 10:13"/>ፍሮተ አሃዝያ ሞቲ ይሁዳ ኬሳ ነሞተ ቶኮ ቶኮ አርጌ፣ “እስን ኤኙ?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="2KI 10:13">እሳንስ፣ “ኑ ፍሮተ አሃዝያ፤ ኑ ማቲ ሞትቻቲፊ እልማን ሃዸ ሞትቻ ዱብሱ ዹፍኔ” ጄዸኒ ዴብሰን።<verse eid="2KI 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 10:14"/>እንስ፣ “ኡቱመ ሉቡዻን ጅረኑ እሳን ቀባ!” ጄዼ አጀጄ። ከናፉ ኡቱመ እሳን ሉቡን ጅረኑ ቀበኒ ቦለ ብሻኒ ቤት ኤከድ ብረት አፉርተሚ ለማንሳኒ ጎጎረአን። እን እሳን ኬሳ ነመ ቶኮሌ ህንሀምብፍኔ።<verse eid="2KI 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 10:15"/>ኤርገ አቺ ዴሜሞ ዬሆናዳብ እልመ ሬካብ ኡቱ እን ገረሳ ዹፉት ጅሩ አርጌ። ዬሁንስ እሰ ዱብሴ፣ “አኩመ አን ገረኬ ጅሩ አት ገረኮ ጅርተ ሞ?” ጄዼ እሰ ጋፈቴ።</para>
  <para style="p" vid="2KI 10:15">ዬሆናዳብስ፣ “አን ገረኬ ጅረ” ጄዼ ዴብሴ።</para>
  <para style="p" vid="2KI 10:15">ዬሁንስ፣ “ዮ አከስ ተኤ ሀርከኬ ነት ኬን” ጄዼን። እንስ ሀርከሳ እት ኬኔ። ዬሁንስ እሰ ገርጋሬ ጋሪት ኦል እሰ ባሴ። <verse eid="2KI 10:15"/><verse number="16" style="v" sid="2KI 10:16"/>ዬሁን፣ “ነ ወጅን ኮቱቲ ህናፋ አን <char style="nd">ዋቀዮፍ</char> ቀቡ እላል” ጄዼን። ኤርገሲስ ጋሪሳቲን እሰ ፉዸቴ ዴሜ።<verse eid="2KI 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 10:17"/>ዬሁን ዮሙ ሰማርያ ገኤት ማቲ አሃብ ኬሳ ከኔን አችት ሀፈን ሁንደ ፍጤ፤ እንስ አኩመ ዱቢ <char style="nd">ዋቀዮ</char> ኤልያስት ዱበቴ ሰናት እሳን በሌሴ።<verse eid="2KI 10:17"/></para>
  <para style="s1">ተጃጅልቶትን በኣል አጄፈመን</para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 10:18"/>ኤርገሲ ዬሁን ሰበ ሁንደ ወልት ዋሜ አከነ ጄዼን፤ “አሃብ ጥኑመ በኣልን ተጃጅሌ። ዬሁን ገሩ ጉድሴ እሰ ተጃጅለ። <verse eid="2KI 10:18"/><verse number="19" style="v" sid="2KI 10:19"/>ከናፉ አመ ራጆተ በኣል ሁንደ፣ ተጃጅልቶተሳ ሁንዳፊ ሉቦተሳ ሁንደ ወልት ዋማ። ዋን አን ቀልመ ጉዳሳ በኣሊፍ ዽኤሱፍ ቶኮንሳኒዩ ህንሀፍን። ነምን ሀፉ ከምዩ ስአች ሉቡዻን ህንጅራቱ።” ዬሁን ገሩ ተጃጅልቶተ በኣል በርበዴሱዻፍ ሶቤ አከስ ጄዼ።<verse eid="2KI 10:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 10:20"/>ዬሁን፣ “ኡልፍነ በኣሊፍ ጄዻቲ ያኢ ዋማ” ጄዼ። ከናፉ እሳን ንለብሰን። <verse eid="2KI 10:20"/><verse number="21" style="v" sid="2KI 10:21"/>ከነረት እን እስራኤል ጉቱ ኬሰ ኤርጋ ኤርጌ አከሲን ተጃጅልቶትን በኣል ሁንድኑ ንዹፈን፤ ቶኮንሳኒዩ ህንሀፍኔ። እሳንስ መነ ዋቄፈትና በኣልት ኦል ገለን፤ መን ሱንስ ገመ ቶኮ ሀመ ገመ ካኒት ጉተሜ። <verse eid="2KI 10:21"/><verse number="22" style="v" sid="2KI 10:22"/>ዬሁንስ ነምቸ ኡፈተ ኤጉን፣ “ተጃጅልቶተ በኣል ሁንዳፍ ኡፈተ ፍድ” ጄዼ። ከናፉ ነምች ሱን ወያ ፍዴፍ።<verse eid="2KI 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 10:23"/>ዬሁፊ ዬሆናዳብ እልም ሬካብ ሱን መነ ዋቄፈትና በኣል ኦል ሴነን። ዬሁንስ ተጃጅልቶተ በኣሊን፣ “ሜ አሲፊ አች እላላቲ አከ ተጃጅልቶተ በኣል መሌ ተጃጅልቶትን <char style="nd">ዋቀዮ</char> ቶኮዩ እስን ወጅን አስ ህንጅሬ ሁበዻ” ጄዼ። <verse eid="2KI 10:23"/><verse number="24" style="v" sid="2KI 10:24"/>ከናፉ እሳን ቀልማፊ ኣርሳ ጉበሙ ዽኤሱፍ ኦል ገለን። ዬሁን ዬሮ ሰነት ነመ ሰዴተመ አለ ዻቤ፣ “ነምን ወረ አን ሀርከኬሰንት ኬኑ ከኔን ኬሳ አከ ቶኮዩ ምልቁ ጎዹ ከምዩ ቆደ ሉቡ ነምቸ ሰና ሉቡሳ ዸበ” ጄዼ አኬከቺሴ ቱሬ።<verse eid="2KI 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 10:25"/>ዬሁን አኩመ ኣርሳ ጉበሙ ሰነ ዽኤሴ ራወቴን፣ “ኦል ሴናቲ እሳን ፍጣ፤ አከ ነምን ቶኮዩ ምልቁ ህንጎዽና” ጄዼ ኤግዶታፊ አጀጆተ ሰነ አጀጄ። ከናፉ እሳን ጎራዴዻን ወረ ሰነ ጭጭረን። ኤግዶታፊ አጀጆትን ሱን ሬፈሳኒ አለት ገድ ደደርበተኒ ኩታ መነ ዋቄፈትና በኣል ከን ገረ ኬሳት ኦል ገለን። <verse eid="2KI 10:25"/><verse number="26" style="v" sid="2KI 10:26"/>እሳንስ መነ በኣል ኬሳ ፈኪወን ገድ ባሰኒ ጉበን። <verse eid="2KI 10:26"/><verse number="27" style="v" sid="2KI 10:27"/>እሳን ፈኪ በኣል ጨጨብሰኒ መነ በኣልስ ዲገን። ነሞትንስ ሀመ ጉያ ሀርኣት ለፈ እት ቦባ በአን ጎዸተኒ እት ፈየደሙ።<verse eid="2KI 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 10:28"/>አከሲን ዬሁን እስራኤል ኬሳ ዋቄፈትና በኣል በሌሴ። <verse eid="2KI 10:28"/><verse number="29" style="v" sid="2KI 10:29"/>ተኡስ እንዩ ጩቡ ዬሮብኣም እልመ ኔባት ከን እን አከ ሰብን እስራኤል ሆጄቱ ጎዼ ሰነራ ህንዴብኔ፤ ጩቡን ኩንስ ፈኪ ጀቢ ወርቄራ ሆጄተሜ ቤትኤሊፊ ዳንት ዋቄፈቹሳኒት።<verse eid="2KI 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="2KI 10:30"/>
    <char style="nd">ዋቀዮስ</char> ዬሁዻን አከነ ጄዼ፤ “ሰበቢ አት ዋን ፉለኮ ዱረት ቀጄላ ተኤ ፊጣን ባሱ ኬሰት ዋን ጋሪ ሆጄቴፊ ዋን አን መነ አሃብረት ሆጄቹፍ ገራዻ ቀቡ ሁንደ ሆጄቴፍ ሰኚወንኬ ሀመ ዸሎተ አፉረፋት ቴሶ እስራኤልራ ንታኡ።” <verse eid="2KI 10:30"/><verse number="31" style="v" sid="2KI 10:31"/>ተኡስ ዬሁን ሴረ <char style="nd">ዋቀዮ</char> ዋቀ እስራኤል ገራ ጉቱዻን ኤጉፍ ኦፍ ኤገትኖ ህንጎኔ። እን ጩቡ ዬሮብኣም ከን እን አከ ሰብን እስራኤል ሆጄቱ ጎዼ ሰነራ ህንዴብኔ።<verse eid="2KI 10:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 10:32"/>በረ ሰነ ኬሰ <char style="nd">ዋቀዮ</char> ለፈ እስራኤልራ ኩኩቴ ጥኔሱ ጀልቀቤ። ሀዛኤልስ ጉቱማ ቡልቺንሰሳኒ ኬሰት እስራኤሎተ ሞአቴ፤ <verse eid="2KI 10:32"/><verse number="33" style="v" sid="2KI 10:33"/>ኩንስ ገመ በአ ዮርዳኖሲን ብየ ግልኣድ ሁንደ ጄቹንስ ብየ ጋድ፣ ብየ ሩቤኒፊ ብየ ምናሴ ከን አሮኤር ለገ አርኖን ብረት አርገምቱ ሰና ጀልቀቤ ግልኣዲ ሀመ ባሻኒት ጅሩዸ።<verse eid="2KI 10:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="2KI 10:34"/>ወንቶትን በረ ሞቱማ ዬሁ ኬሰ ሆጄተመን ብራ፣ ወን እን ሆጄቴ ሁንዲፊ ጀብንሳ ሁንድ ክታበ ሴና ሞቶተ እስራኤል ኬሰት በሬፈመኒሩ ምቲ?<verse eid="2KI 10:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="2KI 10:35"/>ዬሁን አቦቲሳ ወጅን ቦቆቴ ሰማርያ ኬሰት ንአዋለሜ። እልምሳ ዬሆኣሃዝ እዶሳ ቡኤ ሞቲ ተኤ። <verse eid="2KI 10:35"/><verse number="36" style="v" sid="2KI 10:36"/>ዬሁን ሰማርያ ኬሰ ታኤ ወጋ ድግደሚ ሰዴት እስራኤልን ቡልቼ።<verse eid="2KI 10:36"/></para>
  <chapter eid="2KI 10"/>
  <chapter number="11" style="c" sid="2KI 11"/>
  <para style="s1">አታልያፊ ዮኣሽ</para>
  <para style="r">
    <ref loc="2KI 11:1-21">11፥1‑21</ref> ኩወፈ – <char style="xt"><ref loc="2CH 22:10-23:21">2ሴና 22፥10–23፥21</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 11:1"/>አታልያን ሃት አሃዝያ ዮሙ አከ እልምሼ ዱኤ አርግቴት ካቴ ማቲ ሞቲ ጉቱማን ጉቱት በሌስቴ። <verse eid="2KI 11:1"/><verse number="2" style="v" sid="2KI 11:2"/>ዬሆሼባት እንተል ዮራም ሞትቻ ኦቦሌቲን አሃዝያ ሱን ገሩ እልማን ሞቶታ ከኔን አጄፈሙፍ ቱረን ኬሳ ዮኣሽ እልመ አሃዝያ ሀቴ ፉዸቴ። እሼንስ አታልያ ጀላ እሰ ዾክሱፍ ጄቴ እሳፊ ጉድፍቱሳ ኩታ ህርባ ኬሰ ቴስፍቴ። ከናፉ እን ህንአጄፈምኔ። <verse eid="2KI 11:2"/><verse number="3" style="v" sid="2KI 11:3"/>እንስ በረ አታልያን ብየ ቡልቻ ቱርቴ ሁንደ ጉድፍቱሳ ወጅን መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ኬሰት ዾክፈሜ ወጋ ጀአ ጅራቴ።<verse eid="2KI 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 11:4"/>ዬሆያዳን ወጋ ቶርበፋት አጀጁወን ዽባ፣ ነሞተ ካሪቲፊ ኤግዶተት ነመ ኤርጌ አከ እሳን መነ ቁልቁሉማ <char style="nd">ዋቀዮቲ</char> ገረሳ ዹፈን ጎዼ። እንስ መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ኬሰት እሳን ወጅን ከኩ ሴኔ። ኤርገሲስ እልመ ሞቲ እሳንት አርግሲሴ። <verse eid="2KI 11:4"/><verse number="5" style="v" sid="2KI 11:5"/>አከነ ጄዼስ እሳን አጀጄ፤ “ወን እስን ጎቹ ቀብደን እሰ ከነ፦ እስን ወር ገሬ ሰዲ ኬሰ ጅርተን ከኔን ጉያ ሰንበታቲን ሆጂት ቦባተን ሀርከ ሰዲ ኬሳ ሀርክ ቶኮ መነ ሞቲ፣ <verse eid="2KI 11:5"/><verse number="6" style="v" sid="2KI 11:6"/>ሀርከ ሰዲ ኬሳ ሀርኪ ቶኮ ከረ ሱር፣ ሀርከ ሰዲ ኬሳ ሀርኪ ቶኮሞ ከረ ኤግዶተ ደበሬ ደበሬዻን መነ ቁልቁሉማ ኤገን ዱግደ ዱባን ጅሩ ሃኤጉ፤ <verse eid="2KI 11:6"/><verse number="7" style="v" sid="2KI 11:7"/>እስን ወር ገሬ ለማን ካን ኬሰ ጅርተን ከኔን ጉያ ሰንበታቲን ሆጂራ ቦቆተን ሁንድኑሞ መነ ቁልቁሉማ ሞቲዻፍ ኤጉ ቀብዱ። <verse eid="2KI 11:7"/><verse number="8" style="v" sid="2KI 11:8"/>ቶኮን ቶኮንኬሰን ምአ ሎላ ሀርከት ቀበዻቲ ሞትቸት ናነኣ ዸዻበዻ። ነምን ናኖ እስን ጅርተንት ዽኣቱ ከምዩ ሃአጄፈሙ። ለፈ እን ዸቁ ሁንደት ሞትቸት ዽኦ ጅራዻ።”<verse eid="2KI 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 11:9"/>አጀጁወን ዽባ ሱንስ አኩመ ዬሆያዳን ሉብች አጀጄ ሰነ ንጎዸን። ቶኮን ቶኮንሳኒስ ነሞተሳኒ ወረ ጉያ ሰንበታቲን ሆጂት ቦበአኒፊ ወረ ሆጂራ ቦቆተን ፉዸተኒ ዬሆያዳ ሉብቸ ብረ ዹፈን። <verse eid="2KI 11:9"/><verse number="10" style="v" sid="2KI 11:10"/>እንስ ኤቦወኒፊ ጋቸነወን ዳዊት ሞትቻ ከኔን መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ኬሰ ቱረን አጀጆተ ሰናፍ ንኬኔ። <verse eid="2KI 11:10"/><verse number="11" style="v" sid="2KI 11:11"/>ኤግዶን ሱንስ፣ ቶኮን ቶኮንሳኒ ምአ ሎላ ሀርከት ቀበተኒ ከራ ክባቲፊ ከራ ካበ መነ ቁልቁሉማቲን እዶ ኣርሳቲፊ መነ ቁልቁሉማ ብረት ሞትቸት ናነአኒ ንዸዻበተን።<verse eid="2KI 11:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 11:12"/>ዬሆያዳንስ እልመ ሞትቻ ፍዴ መታሳረ ጎንፎ ካኤ፤ እን ገረ ገልቸ ከኩ እት ኬኔ፣ “እን ሞቲዸ” ጄዼ ለብሴ። እሳንስ እሰ ድበን፤ ሀርከ ዸአኒስ፣ “ሞትች በረ በራን ሃጅራቱ!” ጄዸኒ እየን።<verse eid="2KI 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 11:13"/>አታልያን ዮሙ ወጨ ኤግዶታቲፊ ነሞታ ዸጌሴት ገረ ነሞተ ሰና መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ዸቅጤ። <verse eid="2KI 11:13"/><verse number="14" style="v" sid="2KI 11:14"/>ዬሮ እሼን እላልቴት ሞትች አኩመ በረተሜ ሰነት ኡቱባ ብረ ዻበቴ ቱሬ። ቆንዳልቶትኒፊ ወር መለከተ አፉፈን ሞትቸ ብረ ቱረን፤ ነሞትን ብየ ሰና ሁንድኑስ ገመደኒ መለከተ አፉፋ ቱረን። ከነረት አታልያን ኡፈተሼ ተርሳፍቴ፣ “ኩን መልቱማዸ! ኩን መልቱማዸ!” ጄቴ እይቴ።<verse eid="2KI 11:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 11:15"/>ዬሆያዳን ሉብችስ፣ “ህሪረ ግዱዻ ባሳቲ እሼ ፍዳ፤ ነመ እሼረ ዹፉ ከምዩ ጎራዴዻን አጄሳ” ጄዼ አጀጁወን ዽባ ከኔን ኩታወን ሎልቶታ ሰነረት ረመደመን አጀጄ። ሉብች፣ “እሼን መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ኬሰት አጄፈሙ ህንቀብዱ” ጄዼ ቱሬቲ። <verse eid="2KI 11:15"/><verse number="16" style="v" sid="2KI 11:16"/>ከናፉ እሳን አኩመ እሼን በልበለ ፈርዴን እቲን መሰራ ሞቲ ሴነን ጌሴን እሼ ቀበኒ አቹመት እሼ ንአጄሰን።<verse eid="2KI 11:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 11:17"/>ኤርገሲስ ዬሆያዳን አከ እሳን ሰበ <char style="nd">ዋቀዮ</char> ተአኒፍ ጄዼ <char style="nd">ዋቀዮፊ</char> ሞቲፊ ሰበ ግዱት ከኩ ዻቤ። አከሱመስ ሞትቻፊ ሰበ ግዱት ከኩ ንዻቤ። <verse eid="2KI 11:17"/><verse number="18" style="v" sid="2KI 11:18"/>ሰብን ብየቲ ሁንድኑ ገረ ገልመ በኣል ዸቄ ዲጌ። እሳንስ እዶወን ኣርሳቲፊ ዋቆተ ቶልፈሞ ጨጨብሰኒ ሁሬሰኒ መታን ሉብቸ በኣል ሰነሌ እዶወን ኣርሳ ዱረት ንአጄሰን።</para>
  <para style="p" vid="2KI 11:18">ኤርገሲ ዬሆያዳን ሉብች መነ ቁልቁሉማ <char style="nd">ዋቀዮት</char> ኤግዶተ ንረመዴ። <verse eid="2KI 11:18"/><verse number="19" style="v" sid="2KI 11:19"/>እንስ አጀጁወን ዽባ፣ ወረ ካሪ፣ ኤግዶታፊ ነሞተ ብየቲ ሁንደ ፉዸቴ ዸቄ እሳን ወጅንስ መነ ቁልቁሉማ <char style="nd">ዋቀዮቲ</char> ሞትቸ ገድ ባሰኒ ፍደኒ ከራ ከረ ኤግዶታቲን መሰራ ሞቱማ ሴነን። ሞትችስ ቴሶ ሞቲረ ታኤ። <verse eid="2KI 11:19"/><verse number="20" style="v" sid="2KI 11:20"/>ሰቦትን ብየቲ ሁንድ ንእልልቸን። ሰበቢ አታልያን መሰራ ሞቱማ ኬሰት ጎራዴዻን አጄፈምቴፍ መጋላን ሱን ነጋ አርገቴ።<verse eid="2KI 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 11:21"/>ዮኣሽ ዬሮ ሞቲ ተኤ ቡልቹ ጀልቀቤት ነመ ኡሙሪንሳ ወጋ ቶርባ ቱሬ።<verse eid="2KI 11:21"/></para>
  <chapter eid="2KI 11"/>
  <chapter number="12" style="c" sid="2KI 12"/>
  <para style="s1">ዮኣሽ መነ ቁልቁሉማ ሃሮምሴ</para>
  <para style="r">
    <ref loc="2KI 12:1-21">12፥1‑21</ref> ኩወፈ – <char style="xt"><ref loc="2CH 24:1-14">2ሴና 24፥1‑14</ref>፤ <ref loc="2CH 24:23-27">24፥23‑27</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 12:1"/>በረ ሞቱማ ዬሁ ኬሰ ወጋ ቶርበፋት ዮኣሽ ሞቲ ተኤ፤ እን ዬሩሳሌም ኬሰ ታኤ ወጋ አፉርተመ ቡልቼ። መቃን ሃዸሳ ሳብያ ቱሬ፤ እሼንስ ነመ ቤርሼባ ቱርቴ። <verse eid="2KI 12:1"/><verse number="2" style="v" sid="2KI 12:2"/>ዮኣሽስ በረ ዬሆያዳን ሉብች እሰ ጎርሳ ቱሬ ሁንደ ዋን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ቀጄላ ተኤ ሆጄቻ ቱሬ። <verse eid="2KI 12:2"/><verse number="3" style="v" sid="2KI 12:3"/>ተኡስ እዶወን ሰገዳ ከኔን ጋረንራ ህንዲገምኔ ቱሬ፤ ነሞትንስ እቱመ ፉፈኒ ኣርሳ ዽኤሳ፣ እጣነስ አችት ኣርሳ ቱረን።<verse eid="2KI 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 12:4"/>ዮኣሽስ ሉቦታን አከነ ጄዼ፤ “ማለቀ ኬና ቁልቁሉ ጎዸሜ መነ ቁልቁሉማ <char style="nd">ዋቀዮት</char> ፍደሜ ሁንደ ጄቹንስ ማለቀ ዬሮ ኡመትን ለካአሜት ወልት ቀበሜ፣ ማለቀ ወሬገ ነሞታራ ወልት ቀበሜፊ ማለቀ ነሞትን ፌዺዻን መነ ቁልቁሉማት ፍደን ወልት ቀባ። <verse eid="2KI 12:4"/><verse number="5" style="v" sid="2KI 12:5"/>ቶኮን ቶኮን ሉባ ቀብዱ ሆሪራ ማለቀ ሃፉዹ፤ ማለቅን ኩንስ ዋን መነ ቁልቁሉማ ኬሳ ጨጨቤ ከምዩ ዴብሰኒ ሃሮምሱዻፍ ሆጂረ ሃኦሉ።”<verse eid="2KI 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 12:6"/>ገሩ በረ ዮኣሽ ሞትቻ ኬሰ ወጋ ድግደሚ ሰደፋት ሉቦትን ሱን አመሌ መነ ቁልቁሉማ ሰነ ህንሃሮምስኔ ቱሬ። <verse eid="2KI 12:6"/><verse number="7" style="v" sid="2KI 12:7"/>ከናፉ ዮኣሽ ሞትች ዬሆያዳ ሉብቻፊ ሉቦተ ካን ወልት ዋሜ፣ “እስን ማሊፍ ኩታ መነ ቁልቁሉማ ከን ዲገማ ጅሩ ሰነ ዴብፍተኒ ህንሃሮምስኔ? እስን ስአች ማለቀ ነሞተራ ጉርተን ኦፍ ሀርከ ህንቱርስና፤ ገሩ አከ መን ቁልቁሉማ እቲን ሃሮምፈሙፍ ደበርሳ ኬና።” <verse eid="2KI 12:7"/><verse number="8" style="v" sid="2KI 12:8"/>ሉቦትን ሱንስ አከ ለመተ ማለቀ ወልዳራ ወልት ህንቀብኔፊ አከ መነ ቁልቁሉማ ሰነሌ ኦፊሳኒቲን ህንሃሮምስኔ ወሊ ገለን።<verse eid="2KI 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 12:9"/>ዬሆያዳን ሉብች ሰንዱቀ ቶኮ ፉዼ ቀዳደሳ ኡሬ። ሰንዱቀ ሰነስ ከረ ነምን እቲን መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ሴኑን ከራ ምርጋቲን እዶ ኣርሳ ብረ ካኤ። ሉቦትን በልበለ ሰነ ኤገንስ ማለቀ መነ ቁልቁሉማ <char style="nd">ዋቀዮቲፍ</char> ፍደሙ ሁንደ ሰንዱቀ ሰነ ኬሰ ቡሱ ቱሬ። <verse eid="2KI 12:9"/><verse number="10" style="v" sid="2KI 12:10"/>ዮሙ ሰንዱቅን ሱን ጉቱትስ በሬሳን ሞቲቲፊ ሉብን ኦል ኣናን ዹፈኒ ማለቀ መነ ቁልቁሉማ <char style="nd">ዋቀዮት</char> ገልፈሜ ሰነ ለካአኒ ኮሮጆት ነቀን። <verse eid="2KI 12:10"/><verse number="11" style="v" sid="2KI 12:11"/>ኤርገ ባይእን ማለቀ ሰና ቤከሜ ቦዴ እሳን ወረ ሆጂ መነ ቁልቁሉማ ሰነ ቶአቹፍ ፍለተመንት ኬነን። ጀርስ ነሞተ ሆጂ መነ ቁልቁሉማ <char style="nd">ዋቀዮረት</char> ቦበአን ጄቹንስ ወረ ሙከ ሶፈኒፊ ወረ መነ እጃረኒፍ፣ <verse eid="2KI 12:11"/><verse number="12" style="v" sid="2KI 12:12"/>ወረ ዸጋዻን እጃረኒፊ ወረ ዸጋ ጨብሰኒፍ ከፈለን። አከሱመስ መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ሃሮምሱዻፍ ጄዸኒ ሙካፊ ዸጋ ሶፈሜ ብተኒ ባሲ እቲን መነ ቁልቁሉማ ሃሮምሰን ሁንደ ባሰን።<verse eid="2KI 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 12:13"/>ማለቅን መነ ቁልቁሉማት ፍደሜ ሱን ምአ ሜቲራ ሆጄተሜ ከን አከ ጫቢ፣ ዋን እቲን እብሳራ ዳራ ዸዸአን፣ ወጪቲ እቲን ዋ ፈፈጫሰን፣ መለከተ ዮካን ምአ ወርቄ ዮካን ሜቲራ መነ ቁልቁሉማ <char style="nd">ዋቀዮቲፍ</char> ሆጄተመን ብራ ከሚንዩ ቶልቹፍ ሆጂረ ህንኦሌ፤ <verse eid="2KI 12:13"/><verse number="14" style="v" sid="2KI 12:14"/>ማለቅን ሱንስ ነሞተ መነ ቁልቁሉማ ሰነ ሃሮምሰኒፍ ባፈሜ። <verse eid="2KI 12:14"/><verse number="15" style="v" sid="2KI 12:15"/>እሳን ሰበቢ ጀር አመነሙማ ጉቱዻን ዋን ከነ ሆጄተኒፍ ነሞተ አከ እሳን ወረ መነ ቁልቁሉማ ሃሮምሰኒፍ ከፈለኒፍ ማለቅን እት ኬነሜ ሰነራ ሄሬገ ቶአቹ ህንበርባድኔ። <verse eid="2KI 12:15"/><verse number="16" style="v" sid="2KI 12:16"/>ማለቅን ኣርሳ የካቲፊ ኣርሳ ጩቡቲፍ ገልፈሜ ቶኮዩ መነ ቁልቁሉማ <char style="nd">ዋቀዮት</char> ህንፍደምኔ፤ ኩን ቆደ ሉቦታቲ።<verse eid="2KI 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 12:17"/>ዬሩመ ከነ ኬሰ ሀዛኤል ሞቲን ሶርያ ጋትት ኦል በኤ ሎሌ እሼ ቀበቴ። ኤርገሲሞ ዬሩሳሌምንስ ሎሉፍ እት ገረ ገሌ። <verse eid="2KI 12:17"/><verse number="18" style="v" sid="2KI 12:18"/>ዮኣሽ ሞትች ይሁዳ ገሩ ምኦተ አቦቲንሳ ሞቶትን ይሁዳ ዬሆሻፋጥ፣ ዬሆራሚፊ አሃዝያን ዋቃፍ አዳን ባሰኒፊ ከን እን መታንሳ ዋቃፍ አዳን ባሴ፣ ወርቄ ኩሳ ቀቤኘ መነ ቁልቁሉማ <char style="nd">ዋቀዮቲፊ</char> ከን መሰራ ሞቱማ ሁንደ ወልት ቀቤ ሀዛኤል ሞትቸ ሶርያቲፍ ኬኔ፤ ሀዛኤልስ ኤርገሲ ዬሩሳሌሚ በኤ ዴሜ።<verse eid="2KI 12:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 12:19"/>ወንቶትን በረ ሞቱማ ዮኣሽ ኬሰ ሆጄተመን ከኔን ብራቲፊ ወን እን ሆጄቴ ሁንድኑ ክታበ ሴና ሞቶተ ይሁዳ ኬሰት በሬፈመኒሩ ምቲ? <verse eid="2KI 12:19"/><verse number="20" style="v" sid="2KI 12:20"/>ቆንዳልቶትንሳ እሰት መለተኒ ከራ ሲላት ገድ ቡኡረት ቤት ሚሎት እሰ አጄሰን። <verse eid="2KI 12:20"/><verse number="21" style="v" sid="2KI 12:21"/>ቆንዳልቶትን እሰ አጄሰንስ ዮዛካር እልመ ሽሜኣቲፊ ዬሆዛባድ እልመ ሾሜር ቱረን። እንስ ዱኤ አቦቲሳ ብረት መጋላ ዳዊት ኬሰት አዋለሜ። አመስያ እልምሳ እዶሳ ቡኤ ሞቲ ተኤ።<verse eid="2KI 12:21"/></para>
  <chapter eid="2KI 12"/>
  <chapter number="13" style="c" sid="2KI 13"/>
  <para style="s1">ዬሆኣሃዝ ሞትቸ እስራኤል</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 13:1"/>በረ ሞቱማ ዮኣሽ እልመ አሃዝያ ሞትቸ ይሁዳ ኬሰ ወጋ ድግደሚ ሰደፋት ዬሆኣሃዝ እልም ዬሁ ሰማርያ ኬሰት ሞቲ እስራኤል ተኤ ወጋ ኩዸ ቶርበ ቡልቼ። <verse eid="2KI 13:1"/><verse number="2" style="v" sid="2KI 13:2"/>እን ጩቡ ዬሮብኣም እልመ ኔባት ከን እን አከ ሰብን እስራኤል ሆጄቱ ጎዼ ሰነ ዱካ ቡኡዻን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዋን ሀማ ሆጄቴ፤ ጩቡ ሰነራስ ህንዴብኔ። <verse eid="2KI 13:2"/><verse number="3" style="v" sid="2KI 13:3"/>ከናፉ ዼከምስ <char style="nd">ዋቀዮ</char> ዋቃ እስራኤልት ንቦበኤ፤ እንስ ዬሮ ዼራዻፍ ደበርሴ ሀርከ ሀዛኤል ሞትቸ ሶርያቲፊ ሀርከ እልመሳ ቤን-ሀዳዲት እሳን ኬኔ።<verse eid="2KI 13:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 13:4"/>ዬሆኣሃዝ ፉለ <char style="nd">ዋቀዮ</char> በርባደቴ፤ <char style="nd">ዋቀዮስ</char> አከ ሞቲን ሶርያ ሱን አከ መሌ እስራኤልን ጩንቁርሴ አርጌ ከዻሳ ዸገኤፍ። <verse eid="2KI 13:4"/><verse number="5" style="v" sid="2KI 13:5"/><char style="nd">ዋቀዮስ</char> ነመ እሳን በራሩ ቶኮ እስራኤሊፍ ኬኔ፤ አከሲን እሳን ሀርከ ወረ ሶርያ ጀላ ንበአን። ከናፉ እስራኤሎን አኩመ ዱራት ዱንካነሳኒ ኬሰ ጅራተን። <verse eid="2KI 13:5"/><verse number="6" style="v" sid="2KI 13:6"/>እሳን ገሩ ጩቡ መነ ዬሮብኣም ከን እን አከ እስራኤል ሆጄቱ ጎዼ ሰነራ ህንዴብኔ፤ እቱመ ፉፈኒ ኬሰ ጅራተን። ሲዳን ኣሼራስ ሰማርያ ኬሰ ዻበቴ ሀፌ።<verse eid="2KI 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 13:7"/>ሎልቶተ ዬሆኣሃዝ ኬሳ ሎልቶተ ፈርዳ ሸንተመ፣ ጋሪወን ኩዸኒፊ ሎልቶተ ለፎ ኩመ ኩዸን መሌ ቶኮዩ ህንሀፍኔ፤ ሞቲን ሶርያ ወረ ካን ሁንደ በሌሴ አኩመ አዋረ ዬሮ ምዻን ዸአኒ እሳን ጎዼ ቱሬቲ።<verse eid="2KI 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 13:8"/>ወን በረ ሞቱማ ዬሆኣሃዝ ኬሰ ሆጄተሜ ብራ፣ ወን እን ሆጄቴ ሁንዲፊ ጀብንሳ ክታበ ሴና ሞቶተ እስራኤል ኬሰት በሬፈሜረ ምቲ? <verse eid="2KI 13:8"/><verse number="9" style="v" sid="2KI 13:9"/>ዬሆኣሃዝ አቦቲሳ ወጅን ቦቆቴ ሰማርያ ኬሰት ንአዋለሜ። ዮኣሽ እልምሳ እዶሳ ቡኤ ሞቲ ተኤ።<verse eid="2KI 13:9"/></para>
  <para style="s1">ዮኣሽ ሞትቸ እስራኤል</para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 13:10"/>በረ ዮኣሽ ሞትቸ ይሁዳ ኬሰ ወጋ ሶዶሚ ቶርበፋት ዮኣሽ እልም ዬሆኣሃዝ ሰማርያ ኬሰት ሞቲ እስራኤል ተኤ ወጋ ኩዸ ጀአ እሳን ቡልቼ። <verse eid="2KI 13:10"/><verse number="11" style="v" sid="2KI 13:11"/>እን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ጩቡ ሆጄቴ ጩቡ ዬሮብኣም እልመ ኔባት ከን እን አከ ሰብን እስራኤል ሆጄቱ ጎዼ ሰነ ኬሳ ቶኮራዩ ህንዴብኔ፤ እንስ እቱመ ፉፌ ጩቡ ኬሰ ጅራቴ።<verse eid="2KI 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 13:12"/>ወንቶትን በረ ሞቱማ ዮኣሽ ኬሰ ሆጄተመን ብራ፣ ወን እን ሆጄቴ ሁንዲፊ ጀብንሳ፣ ወራን እን አመስያ ሞትቸ ይሁዳረት ዴምስሴስ ክታበ ሴና ሞቶተ እስራኤል ኬሰት በሬፈመኒሩ ምቲ? <verse eid="2KI 13:12"/><verse number="13" style="v" sid="2KI 13:13"/>ዮኣሽ አቦቲሳ ወጅን ቦቆቴ ዬሮብኣም እዶሳ ቡኤ ቴሶረ ታኤ። ዮኣሽ ሰማርያ ኬሰት ሞቶተ እስራኤል ብረት ንአዋለሜ።<verse eid="2KI 13:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 13:14"/>ዬሮ ከነት ኤልሳእ ዹኩበ ዱኣን እሰ ገኡን ዽጰቻ ቱሬ። ዮኣሽ ሞትች እስራኤል እሰ እላሉ ገድ ቡኤ እሰት ቦኤ። እንስ፣ “ያ አባኮ! ያ አባኮ! ያ ጋሪወኒፊ ያ አቦቲ ፈርዳ እስራኤል!” ጄዼ እዬ።<verse eid="2KI 13:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 13:15"/>ኤልሳእ፣ “እዳፊ ጥየ ወዪ ፉዸዹ” ጄዼን፤ እንስ ንፉዸቴ። <verse eid="2KI 13:15"/><verse number="16" style="v" sid="2KI 13:16"/>ኤልሳእሞ ሞትቸ እስራኤሊን፣ “እዳ ሀርከት ቀበዹ” ጄዼ፤ እን ፉናን ኤልሳእ ሀርከ ኦፊሳ ፉዼ ሀርከ ሞትቻረ ካኤ።<verse eid="2KI 13:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 13:17"/>ኤልሳእ፣ “ፎዳ ከራ በአ ቢፍቱ በን” ጄዼን፤ እንስ ንበኔ። ኤልሳእ፣ “ጥየ ደርበዹ!” ጄዼ፤ ሞትችስ ንደርበቴ። ኤልሳእስ፣ “ጥየ ሞአትኖ <char style="nd">ዋቀዮ</char>፣ ጥየ ወረ ሶርያ ሞአቱ!” ጄዼ። ኤልሳእስ፣ “አት አፌቅት ወረ ሶርያ ጉቱማን ጉቱት ንበርበዴስተ” ጄዼ ለብሴ።<verse eid="2KI 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 13:18"/>እንስ ኤርገሲ፣ “ጥየ ፉዸዹ” ጄዼን፤ ሞትችስ ንፉዸቴ። ኤልሳእስ “ለፈ ሩኩት” ጄዼን፤ ሞትችስ ዬሮ ሰዲ ለፈ ሩኩቴ። <verse eid="2KI 13:18"/><verse number="19" style="v" sid="2KI 13:19"/>ነምን ዋቃ ሱንስ እሰት ኣሬ አከነ ጄዼ፤ “አት ዬሮ ሸን ዮካን ጀአ ለፈ ሩኩቱ ቀብደ፤ ስላ ወረ ሶርያ ሞአቴ ጉቱማን ጉቱት እሳን በሌስተ ቱርቴ። አመ ገሩ ዬሮ ሰዲ ቆፈ እሳን ሞአተ።”<verse eid="2KI 13:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 13:20"/>ኤልሳእ ዱኤ አዋለሜ።</para>
  <para style="p" vid="2KI 13:20">ዬሮ ሰነ ሞኣቦን ሳምቶትን ብራ ብራ ዹፈኒ ብየቲ ሳሙ ቱሬ። <verse eid="2KI 13:20"/><verse number="21" style="v" sid="2KI 13:21"/>ጋፍ ቶኮ ወር እስራኤል ኡቱ ነምቸ ዱኤ ቶኮ አዋሉት ጅረኑ ገሬ ሳምቶታ ቶኮ አርገን፤ ከናፉ ሬፈ ነምቻ አዋለ ኤልሳእት ደርበተን። ሬፍ ሱን ለፌ ኤልሳእ ቱቅናን ነምች ሱን ዱኣ ከኤ ሚሉመ ኦፊሳቲን ዻበቴ።<verse eid="2KI 13:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 13:22"/>ሀዛኤል ሞትች ሶርያ በረ ሞቱማ ዬሆኣሃዝ ጉቱ እስራኤልን ጩንቁርሴ። <verse eid="2KI 13:22"/><verse number="23" style="v" sid="2KI 13:23"/><char style="nd">ዋቀዮ</char> ገሩ ሰበቢ ከኩ አብረሃም፣ ይስሃቂፊ ያቆብ ወጅን ገሌ ቱሬ ሰናቲፍ ጄዼሳኒ አርጆሜ፤ ገራስ እሳኒፍ ላፌ ፉለሳ ገረሳኒት ዴብፈቴ። ሀመ ሀርኣትስ ፉለ ኦፊሳ ዱራ እሳን በርበዴሱ ዮካን ገቱ ህንፌኔ።<verse eid="2KI 13:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 13:24"/>ሀዛኤል ሞትች ሶርያ ዱኤ ቤን-ሀዳድ እልምሳ እዶሳ ቡኤ ሞቲ ተኤ። <verse eid="2KI 13:24"/><verse number="25" style="v" sid="2KI 13:25"/>ዮኣሽ እልም ዬሆኣሃዝ መጋላወን እን ወራነ ኬሰት አባሳ ዬሆኣሃዝራ ፉዸቴ ቱሬ ሁንደ ቤን-ሀዳድ እልመ ሀዛኤልራ ዴብሴ ፉዸቴ። የሆአስስ ዬሮ ሰዲ እሰ ሞአቴ አከሲን መጋላወን እስራኤል ዴብሴ።<verse eid="2KI 13:25"/></para>
  <chapter eid="2KI 13"/>
  <chapter number="14" style="c" sid="2KI 14"/>
  <para style="s1">አመስያ ሞትቸ ይሁዳ</para>
  <para style="r">
    <ref loc="2KI 14:1-7">14፥1‑7</ref> ኩወፈ – <char style="xt"><ref loc="2CH 25:1-4">2ሴና 25፥1‑4</ref>፣<ref loc="2CH 25:11-12">11‑12</ref></char></para>
  <para style="r">
    <ref loc="2KI 14:8-22">14፥8‑22</ref> ኩወፈ – <char style="xt"><ref loc="2CH 25:17-26:2">2ሴና 25፥17–26፥2</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 14:1"/>በረ ሞቱማ ዮኣሽ እልመ ዮኣሃዝ ሞትቸ እስራኤል ኬሰ ወጋ ለመፋት አመስያ እልም እዮአስ ሞቲ ይሁዳ ተኤ ቡልቹ ጀልቀቤ። <verse eid="2KI 14:1"/><verse number="2" style="v" sid="2KI 14:2"/>እን ዬሮ ሞቲ ተኤት ነመ ወጋ ድግደሚ ሸን ቱሬ፤ እንስ ዬሩሳሌም ኬሰ ታኤ ወጋ ድግደሚ ሰገል ንቡልቼ። መቃን ሃዸሳ ዮኣዳን ቱሬ፤ እሼንስ ነመ ዬሩሳሌም ቱርቴ። <verse eid="2KI 14:2"/><verse number="3" style="v" sid="2KI 14:3"/>እንስ ዋን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ቀጄላ ተኤ ንሆጄቴ። ገሩ አከ አባሳ ዳዊትት ምት። እን ዋን ሁንደ ኬሰት ፈኬኘ አባሳ ዮኣሽ ዱካ ቡኤ። <verse eid="2KI 14:3"/><verse number="4" style="v" sid="2KI 14:4"/>ተኡስ እዶወን ሰገዳ ከኔን ጋረንራ ህንዲገምኔ ቱሬ፤ ነሞትን እቱመ ፉፈኒ ኣርሳ ዽኤሳ፣ እጣነስ አችት ኣርሳ ቱረን።<verse eid="2KI 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 14:5"/>እን ኤርገ ጀቤሴ ሀርከሳት ሞቱማ ቀበቴ ቦዴ ቆንዳልቶተ አባሳ ሞትቸ አጄሰን ሰነ ፍጤ። <verse eid="2KI 14:5"/><verse number="6" style="v" sid="2KI 14:6"/>ተኡስ እን አከ ዋን ክታበ ሴረ ሙሴ ኬሰት በሬፈሜ ከን <char style="nd">ዋቀዮ</char>፣ “አቦቲን ሰበቢ እጆሌሳኒቲፍ አጄፈሙ ህንቀበን ዮካን እጆሌን ሰበቢ አቦቲሳኒቲፍ አጄፈሙ ህንቀበን፤ ቶኮን ቶኮን ነማ ሰበቢ ጩቡ ኦፊሳቲፍ ዱአ” ጄዼ አጀጄ ሰናት እልማን ወረ ነመ አጄሰን ሰና ህንፍጥኔ።<verse eid="2KI 14:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 14:7"/>ነምን ሱሉለ ሶግዳ ኬሰት ኤዶሞተ ኩመ ኩዸን ሞአቴ ወራናን ሴላ ቀበቴ ከን መቃ እሼን ሀመ ሀርኣት እቲን ዋመምቱ፣ ዮቅትኤል ጄዼ ሞጋሴስ እሱመ።<verse eid="2KI 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 14:8"/>አመስያንስ፣ “ኮቱ ሜ ወራነ ኬሰት ወል እላላ” ጄዼ ቆሴ ገረ ዮኣሽ እልመ ዬሆኣሃዝ፣ እልመ ዬሁ፣ ሞትቸ እስራኤልት ኤርገሞተ ኤርጌ።<verse eid="2KI 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 14:9"/>ዮኣሽ ሞትች እስራኤል ገሩ አከነ ጄዼ አመስያ ሞትቸ ይሁዳቲፍ ዴቢ ኬኔ፤ “ሶኮሩን ልባኖን ኬሳ ቶኮ ኤርጋ ኤርጌ ብርብርሳ ልባኖኒን፣ ‘እንተለኬ እልመኮት ሄሩምሲስ’ ጄዼ። ኤርገሲ ብኔንስ ቦሶነ ልባኖን ኬሳ ቶኮ ዹፌ ሶኮሩ ሰነረ ሚላን ዴሜ። <verse eid="2KI 14:9"/><verse number="10" style="v" sid="2KI 14:10"/>አት ዹጉማን ኤዶምን ሞአቴ አመ ኦፍ ቱላ ጅርተ። ሞአትኖኬቲን ገመድ፤ አመ ገሩ መነኬ ታእ! አት ማሊፍ ረክነ በርባዴ ኦፊኬቲፊ ይሁዳትስ ኩፋቲ ፍደ?”<verse eid="2KI 14:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 14:11"/>አመስያ ገሩ ዸገኡ ድዴ፤ ከናፉ ዮኣሽ ሞትች እስራኤል ከኤ ሎለ በኔ። እኒፊ አመስያ ሞትች ይሁዳ ኬሰት ቤት ሼሜሽት ወልት በአን። <verse eid="2KI 14:11"/><verse number="12" style="v" sid="2KI 14:12"/>ወር ይሁዳስ ወረ እስራኤሊን ሞአተመኒ ቶኮን ቶኮን ነማስ ገረ መነ ኦፊሳት በቀቴ። <verse eid="2KI 14:12"/><verse number="13" style="v" sid="2KI 14:13"/>ዮኣሽ ሞትች እስራኤል፣ አመስያ ሞትቸ ይሁዳ እልመ እዮአስ እልመ አሃዝያ ሰነ ቤት ሼሜሽት ቀቤ። እዮአስስ ገረ ዬሩሳሌም ዸቄ ከረ ኤፍሬሚቲ ጀልቀቤ ሀመ ከረ ጎሌት ደላ ዬሩሳሌም ከን ዸጋ ሰነ ዲጌ፤ ኩታን ዲገሜ ኩን ዹንዹመ ዽበ አፉር ለፈረ ዼረተ ቱሬ። <verse eid="2KI 14:13"/><verse number="14" style="v" sid="2KI 14:14"/>እንስ ወርቄፊ ሜቲ ሁንደ አከሱመስ ምአ መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ኬሰት አርገሙፊ ከን ኩሳ ቀቤኘ መሰራ ሞቱማ ኬሳ ጅሩ ሁንደ ፉዸቴ፤ ነሞተ ቦጅኤሌ ፉዸቴ ገረ ሰማርያት ዴብኤ።<verse eid="2KI 14:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 14:15"/>ወንቶትን በረ ሞቱማ ዮኣሽ ኬሰ ሆጄተመን ከኔን ብራ፣ ወን እን ሆጄቴፊ ጀብንሳ፣ ወራነ እን አመስያ ሞትቸ ይሁዳቲን ሎሌስ ደበለቴ ክታበ ሴና ሞቶተ እስራኤል ኬሰት በሬፈመኒሩ ምቲ? <verse eid="2KI 14:15"/><verse number="16" style="v" sid="2KI 14:16"/>ዮኣሽስ አቦቲሳ ወጅን ቦቆቴ ሞቶተ እስራኤል ብረት ሰማርያ ኬሰት አዋለሜ። እልምሳ ዬሮብኣም እዶሳ ቡኤ ሞቲ ተኤ።<verse eid="2KI 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 14:17"/>አመስያ እልም ዮኣሽ ሞትች ይሁዳ ኤርገ ዮኣሽ እልም ዬሆኣሃዝ ሞትች እስራኤል ዱኤ ቦዴ ወጋ ኩዸ ሸን ጅራቴ። <verse eid="2KI 14:17"/><verse number="18" style="v" sid="2KI 14:18"/>ወንቶትን በረ ሞቱማ አመስያ ኬሰ ሆጄተመን ከኔን ብራ ክታበ ሴና ሞቶተ ይሁዳ ኬሰት በሬፈመኒሩ ምቲ?<verse eid="2KI 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 14:19"/>እሳን ዬሩሳሌም ኬሰት እሰት መለተን፤ እንስ ገረ ላኪሽት በቀቴ፤ እሳንሞ ፋኑመሳ ላኪሽት ነሞተ ኤርገኒ አችት እሰ አጄሰን። <verse eid="2KI 14:19"/><verse number="20" style="v" sid="2KI 14:20"/>ሬፍሳስ ፈርደት ፌአሜ ዹፌ አቦቲሳ ብረት ዬሩሳሌም ኬሰት መጋላ ዳዊትት አዋለሜ።<verse eid="2KI 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 14:21"/>ኤርገሲ ወር ይሁዳ ሁንድኑ አዛርያ ሙጫ ወጋ ኩዸ ጀኣ ፉዸኒ እዶ አባ አመስያ ሰነ ሞቲ ጎዸተን። <verse eid="2KI 14:21"/><verse number="22" style="v" sid="2KI 14:22"/>ነምን ኤርገ አመስያ አቦቲሳ ወጅን ቦቆቴ ቦዴ ኤላትን ዴብሴ እጃሬ ወረ ይሁዳት ኬኔ እሰ።<verse eid="2KI 14:22"/></para>
  <para style="s1">ዬሮብኣም ለመፋ ሞትቸ እስራኤል</para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 14:23"/>በረ አመስያ እልመ ዮኣሽ ሞትቸ ይሁዳ ኬሰ ወጋ ኩዸ ሸነፋት ዬሮብኣም እልም እዮአስ ሞትቸ እስራኤል ሰማርያ ኬሰት ሞቲ ተኤ፤ እንስ ወጋ አፉርተሚ ቶኮ ቡልቼ። <verse eid="2KI 14:23"/><verse number="24" style="v" sid="2KI 14:24"/>እን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዋን ሀማ ሆጄቴ፤ ጩቡ ዬሮብኣም እልመ ኔባት ከን እን አከ ወር እስራኤል ሆጄተን ጎዼ ሰነራስ ህንዴብኔ። <verse eid="2KI 14:24"/><verse number="25" style="v" sid="2KI 14:25"/>ነምን አኩመ ዱቢ <char style="nd">ዋቀዮ</char> ዋቀ እስራኤል ከን እን ከራ ገርብቸሳ ዮናስ እልመ አምታይ፣ ራጅቸ ገት ሄፌሪ ዹፌ ሰናቲን ዱበቴት ዳሪ ብየ እስራኤል ሌቦ ሀማቲ ጀልቀቤ ሀመ ገላነ አረባት እዶት ዴብሴ እሰ ቱሬ።<verse eid="2KI 14:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 14:26"/>
    <char style="nd">ዋቀዮ</char> አከ ቶኮን ቶኮን ነመ እስራኤል ኬሰ ጅራቱ፣ ገርበስ ተኡ ብርመዱን አከ መሌ ረከቻ ጅሩ አርጌ፤ ነምን እሳን ገርጋሩ ቶኮዩ ህንቱሬ። <verse eid="2KI 14:26"/><verse number="27" style="v" sid="2KI 14:27"/><char style="nd">ዋቀዮስ</char> ዋን መቃ እስራኤል ሰሚ ጀላ ነንበሌሰ ህንጄዽኒፍ ሀርከ ዬሮብኣም እልመ ዮኣሺቲን እሳን ባሴ።<verse eid="2KI 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 14:28"/>ወንቶትን በረ ሞቱማ ዬሮብኣም ኬሰ ሆጄተመን ብራ፣ ወን እን ሆጄቴ ሁንድ፣ ጀብን ሎልቱማሳ፣ አከ እን እት ደማስቆፊ ሀማት ከኔን ዱራን ይሁዳ ጀለ ቱረን ሰነ እስራኤሊፍ ዴብሴ ደበለቴ ክታበ ሴና ሞቶተ እስራኤል ኬሰት በሬፈመኒሩ ምቲ? <verse eid="2KI 14:28"/><verse number="29" style="v" sid="2KI 14:29"/>ዬሮብኣም አቦቲሳ ሞቶተ እስራኤል ወጅን ቦቆቴ፤ እልምሳ ዘካርያስ እዶሳ ቡኤ ሞቲ ተኤ።<verse eid="2KI 14:29"/></para>
  <chapter eid="2KI 14"/>
  <chapter number="15" style="c" sid="2KI 15"/>
  <para style="s1">አዛርያ ሞትቸ ይሁዳ</para>
  <para style="r">
    <ref loc="2KI 15:1-7">15፥1‑7</ref> ኩወፈ – <char style="xt"><ref loc="2CH 26:3-4">2ሴና 26፥3‑4</ref>፣<ref loc="2CH 26:21-23">21‑23</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 15:1"/>በረ ሞቱማ ዬሮብኣም ሞትቸ እስራኤል ኬሰ ወጋ ድግደሚ ቶርበፋት፣ አዛርያ እልም አመስያ ሞትቸ ይሁዳ ሰና ሞቲ ተኤ። <verse eid="2KI 15:1"/><verse number="2" style="v" sid="2KI 15:2"/>እን ዬሮ ሞቲ ተኤት ነመ ወጋ ኩዸ ጀአ ቱሬ፤ እንስ ዬሩሳሌም ኬሰ ታኤ ወጋ ሸንተሚ ለመ ንቡልቼ። መቃን ሃዸሳ ዬኮልያ ቱሬ፤ እሼንስ ነመ ዬሩሳሌም ቱርቴ። <verse eid="2KI 15:2"/><verse number="3" style="v" sid="2KI 15:3"/>እንስ አኩመ አባሳ አመስያ ሰነ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዋን ቀጄላ ንሆጄቴ። <verse eid="2KI 15:3"/><verse number="4" style="v" sid="2KI 15:4"/>ተኡስ እዶወን ሰገዳ ከኔን ጋረንራ ህንዲገምኔ ቱሬ፤ ነሞትን እቱመ ፉፈኒ ኣርሳ ዽኤሳ፣ እጣነስ አችት ኣርሳ ቱረን።<verse eid="2KI 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 15:5"/>
    <char style="nd">ዋቀዮስ</char> ሀመ ጋፈ እን ዱኤት ሞትቸ ለምጢዻን ዸኤ፤ እንስ መነ ኮጳ ኬሰ ንጅራቴ። ዮታም እልም ሞትቻ እት ጋፈተመ መሰራ ሞቱማ ፉዸቴ ሰበ ብየቲ ቡልቼ።<verse eid="2KI 15:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 15:6"/>ወንቶትን በረ ሞቱማ አዛርያ ኬሰ ሆጄተመን ከን ብራቲፊ ወን እን ሆጄቴ ሁንድ ክታበ ሴና ሞቶተ ይሁዳ ኬሰት በሬፈመኒሩ ምቲ? <verse eid="2KI 15:6"/><verse number="7" style="v" sid="2KI 15:7"/>አዛርያ አቦቲሳ ወጅን ቦቆቴ እሳኑመ ብረት መጋላ ዳዊት ኬሰት ንአዋለሜ። እልምሳ ዮታም እዶሳ ቡኤ ሞቲ ተኤ።<verse eid="2KI 15:7"/></para>
  <para style="s1">ዘካርያስ ሞትቸ እስራኤል</para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 15:8"/>በረ ሞቱማ አዛርያ ሞትቸ ይሁዳ ኬሰ ወጋ ሶዶሚ ሰዴተፋት ዘካርያስ እልም ዬሮብኣም ሰማርያ ኬሰት ሞቲ እስራኤል ተኤ ጅአ ጀአ ቡልቼ። <verse eid="2KI 15:8"/><verse number="9" style="v" sid="2KI 15:9"/>እንስ አኩመ አባንሳ ሆጄቴ ሰነ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዋን ሀማ ሆጄቴ። እን ጩቡ ዬሮብኣም እልመ ኔባት ከን እን አከ ወር እስራኤል ሆጄተን ጎዼ ሰነራ ህንዴብኔ።<verse eid="2KI 15:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 15:10"/>ሸሉም እልም ያቤሽ ሱን ዘካርያስት ከኤ ፉሉመ ሰባ ዱረት እሰ አጄሴ እዶሳ ቀበቴ ሞቲ ተኤ። <verse eid="2KI 15:10"/><verse number="11" style="v" sid="2KI 15:11"/>ወንቶትን በረ ሞቱማ ዘካርያስ ኬሰ ሆጄተመን ከኔን ብራ ክታበ ሴና ሞቶተ እስራኤል ኬሰት በሬፈመኒሩ ምቲ? <verse eid="2KI 15:11"/><verse number="12" style="v" sid="2KI 15:12"/>አከሲንስ ዱቢን <char style="nd">ዋቀዮ</char> ከን እን “ሰኚወንኬ ሀመ ዸሎተ አፉረፋት ቴሶ እስራኤልራ ንታኡ” ጄዼ ዬሁት ዱበቴ ሱን ንራወተሜ።<verse eid="2KI 15:12"/></para>
  <para style="s1">ሸሉም ሞትቸ እስራኤል</para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 15:13"/>ሸሉም እልም ያቤሽ በረ ሞቱማ ኡዝያን ሞትቸ ይሁዳ ኬሰ ወጋ ሶዶሚ ሰግለፋት ሰማርያ ኬሰት ሞቲ እስራኤል ተኤ ጅአ ቶኮ ቡልቼ። <verse eid="2KI 15:13"/><verse number="14" style="v" sid="2KI 15:14"/>ሜናሄም እልም ጋዲስ ቲርዛዻ ከኤ ሰማርያ ዸቄ። እንስ ሸሉም እልመ ያቤሽ ሰነ ሎሌ ሰማርያ ኬሰት አጄሴ እዶሳ ቡኤ ሞቲ ተኤ።<verse eid="2KI 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 15:15"/>ወንቶትን በረ ሞቱማ ሸሉም ኬሰ ሆጄተመን ብራቲፊ ፍንጭል እን ሆጄቴ ክታበ ሴና ሞቶተ እስራኤል ኬሰት በሬፈመኒሩ።<verse eid="2KI 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 15:16"/>ዬሮ ሰነት፣ ሜናሄም ቲርዛ ከኤ ቲፍሳፊ ወረ መጋላ ሰነ ኬሳፊ ናኖሼ ጅራቱ ሁንደ ዸኤ፤ ኩንስ ሰበቢ እሳን ከረ በኑፊ ድደኒፍ። እንስ ቲፍሳ ሳሜ ዱበርቶተ ኡልፈ ቀበን ሁንደ ገራ በቀቅሴ።<verse eid="2KI 15:16"/></para>
  <para style="s1">ሜናሄም ሞትቸ እስራኤል</para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 15:17"/>በረ አዛርያ ሞትቸ ይሁዳ ኬሰ ወጋ ሶዶሚ ሰግለፋት ሜናሄም እልም ጋዲ ሞቲ እስራኤል ተኤ፤ እንስ ሰማርያ ኬሰ ጅራቴ ወጋ ኩዸን ቡልቼ። <verse eid="2KI 15:17"/><verse number="18" style="v" sid="2KI 15:18"/>እንስ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዋን ሀማ ሆጄቴ። በረ ብየ ቡልቻ ቱሬ ጉቱስ ጩቡ ዬሮብኣም እልመ ኔባት ከን እን አከ እስራኤል ሆጄቱ ጎዼ ሰነራ ህንዴብኔ።<verse eid="2KI 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 15:19"/>ኤርገሲስ ጱል ሞትች አሶር ብየቲት ንዱሌ፤ ሜናሄምሞ አከ ገርጋርሰሳ አርገቴ ኣንጎ ኦፊሳ ጀለት ሞቱማ ቱርፈቱፍ ሜቲ ታላንቲ ኩመ ቶኮ ኬኔፍ። <verse eid="2KI 15:19"/><verse number="20" style="v" sid="2KI 15:20"/>ሜናሄም ማለቀ ከነ ወሩመ እስራኤል ባስሴ። አከ ሞቲ አሶሪፍ ኬነሙፍ ነምን ሶሬስ ከምዩ ሜቲ ሰቅሊ ሸንተመ ባሱ ቀበ። ከናፉ ሞቲን አሶር ዱበት ዴብኤ መሌ ኤርገሲ ብየቲ ኬሰ ህንቱሬ።<verse eid="2KI 15:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 15:21"/>ወን በረ ሞቱማ ሜናሄም ኬሰ ሆጄተሜ ከን ብራ፣ ወን እን ሆጄቴ ሁንድስ ክታበ ሴና ሞቶተ እስራኤል ኬሰት በሬፈሜረ ምቲ? <verse eid="2KI 15:21"/><verse number="22" style="v" sid="2KI 15:22"/>ሜናሄምስ አቦቲሳ ወጅን ቦቆቴ። እልምሳ ጴቃያን እዶሳ ቡኤ ሞቲ ተኤ።<verse eid="2KI 15:22"/></para>
  <para style="s1">ጴቃያን ሞትቸ እስራኤል</para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 15:23"/>በረ አዛርያ ሞትቸ ይሁዳ ኬሰ ወጋ ሸንተመፋት ጴቃያን እልም ሜናሄም ሰማርያ ኬሰት ሞቲ እስራኤል ተኤ ወጋ ለመ ቡልቼ። <verse eid="2KI 15:23"/><verse number="24" style="v" sid="2KI 15:24"/>ጴቃያን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዋን ሀማ ሆጄቴ። እን ጩቡ ዬሮብኣም እልመ ኔባት ከን እን አከ እስራኤል ሆጄቱ ጎዼ ሰነራ ህንዴብኔ። <verse eid="2KI 15:24"/><verse number="25" style="v" sid="2KI 15:25"/>አጀጆተሳ ኦል ኣንቶተ ኬሳ ጴቃን እልም ሬማልያ እሰት መለቴ። እንስ ነሞተ ግልኣድ ኬሳ ነመ ሸንተመ ፉዸቴ ፊጤ መሰራ ሞቱማ ከን ሰማርያ ኬሳረት ጴቃያ፣ አርጎቢፊ አርዬ አጄሴ። ጴቃንስ አከሲን ጴቃያ አጄሴ እዶሳ ሞቲ ተኤ።<verse eid="2KI 15:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 15:26"/>ወን በረ ሞቱማ ጴቃያ ኬሰ ሆጄተሜ ከን ብራቲፊ ወን እን ሆጄቴ ሁንድ ክታበ ሴና ሞቶተ እስራኤል ኬሰት በሬፈሜረ ምቲ?<verse eid="2KI 15:26"/></para>
  <para style="s1">ጴቃ ሞትቸ እስራኤል</para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 15:27"/>በረ አዛርያ ሞትቸ ይሁዳ ኬሳ ወጋ ሸንተሚ ለመፋት፣ ጴቃን እልም ሬማልያ ሰማርያ ኬሰት ሞቲ እስራኤል ተኤ ወጋ ድግደመ ቡልቼ። <verse eid="2KI 15:27"/><verse number="28" style="v" sid="2KI 15:28"/>እንስ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዋን ሀማ ሆጄቴ። ጩቡ ዬሮብኣም እልመ ኔባት ከን እን አከ እስራኤል ሆጄቱ ጎዼ ሰነራ ህንዴብኔ።<verse eid="2KI 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 15:29"/>በረ ጴቃ ሞትቸ እስራኤል ኬሰ ቲግላት ጵሌሴር ሞትች አሶር ዹፌ ኢዮን፣ አቤል ቤት መኣካ፣ ያኖኣ፣ ቃዴሺፊ ሃዞር፣ ግልኣዲፊ ገሊላ፣ ብየ ንፍታሌም ሁንደስ ወሉመት ቀበቴ ነሞተ ስ ጉሬ አሶርት ጌሴ። <verse eid="2KI 15:29"/><verse number="30" style="v" sid="2KI 15:30"/>ኤርገሲስ ሆሼኣ እልም ኤላ፣ ጴቃ እልመ ሬማልያት መለቴ። እንስ ሎሌ እሰ አጄሴ በረ ሞቱማ ዮታም እልመ ኡዝያን ኬሳ ወጋ ድግደመፋት እዶሳ ሞቲ ተኤ።<verse eid="2KI 15:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="2KI 15:31"/>ወን በረ ሞቱማ ጴቃ ኬሰ ሆጄተሜ ብራፊ ወን እን ሆጄቴ ሁንድ ክታበ ሴና ሞቶተ እስራኤል ኬሰት በሬፈሜረ ምቲ?<verse eid="2KI 15:31"/></para>
  <para style="s1">ዮታም ሞትቸ ይሁዳ</para>
  <para style="r">
    <ref loc="2KI 15:33-38">15፥33‑38</ref> ኩወፈ – <char style="xt"><ref loc="2CH 27:1-4">2ሴና 27፥1‑4</ref>፣<ref loc="2CH 27:7-9">7‑9</ref></char></para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 15:32"/>በረ ጴቃ እልመ ሬማልያ ሞትቸ እስራኤል ኬሰ ወጋ ለመፋት ዮታም እልም ኡዝያን ሞትቸ ይሁዳ ሞቲ ተኤ ቡልቹ ጀልቀቤ። <verse eid="2KI 15:32"/><verse number="33" style="v" sid="2KI 15:33"/>እን ዬሮ ሞቲ ተኤት ነመ ወጋ ድግደሚ ሸን ቱሬ፤ ዬሩሳሌም ኬሰ ታኤ ወጋ ኩዸ ጀአ ንቡልቼ። መቃን ሃዸሳ የሩሳ ቱሬ፤ እሼንስ እንተለ ዛዶቅ ቱርቴ። <verse eid="2KI 15:33"/><verse number="34" style="v" sid="2KI 15:34"/>እንስ አኩመ አባንሳ ኡዝያን ጎዼ ሰነ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዋን ቀጄላ ንሆጄቴ። <verse eid="2KI 15:34"/><verse number="35" style="v" sid="2KI 15:35"/>ተኡስ እዶወን ሰገዳ ከኔን ጋረንራ ህንዲገምኔ ቱሬ። ነሞትንስ እቱመ ፉፈኒ ኣርሳ ዽኤሳ እጣነስ አችት ኣርሳ ቱረን። ዮታም ከረ መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ከን ኦል ኣኑ ዴብሴ እጃሬ።<verse eid="2KI 15:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="2KI 15:36"/>ወንቶትን በረ ሞቱማ ዮታም ኬሳ ሆጄተመን ከኔን ብራቲፊ ወንቶትን እን ሆጄቴ ክታበ ሴና ሞቶተ ይሁዳ ኬሰት በሬፈሜረ ምቲ? <verse eid="2KI 15:36"/><verse number="37" style="v" sid="2KI 15:37"/>በረ ሰነ ኬሰ <char style="nd">ዋቀዮ</char> ሬዚን ሞትቸ ሶርያቲፊ ጴቃ እልመ ሬማልያ ይሁዳት ከካሱ ጀልቀቤ። <verse eid="2KI 15:37"/><verse number="38" style="v" sid="2KI 15:38"/>ዮታም አቦቲሳ ወጅን ቦቆቴ መጋላ ዳዊት፣ መጋላ አባሳ ኬሰት እሳኑመ ብረት ንአዋለሜ። እልምሳ ኣሃዝ እዶሳ ቡኤ ሞቲ ተኤ።<verse eid="2KI 15:38"/></para>
  <chapter eid="2KI 15"/>
  <chapter number="16" style="c" sid="2KI 16"/>
  <para style="s1">ኣሃዝ ሞትቸ ይሁዳ</para>
  <para style="r">
    <ref loc="2KI 16:1-20">16፥1‑20</ref> ኩወፈ – <char style="xt"><ref loc="2CH 28:1-27">2ሴና 28፥1‑27</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 16:1"/>በረ ሞቱማ ጴቃ እልመ ሬማልያ ኬሰ ወጋ ኩዸ ቶርበፋት ኣሃዝ እልም ዮታም ሞትቸ ይሁዳ ሞቲ ተኤ ቡልቹ ጀልቀቤ። <verse eid="2KI 16:1"/><verse number="2" style="v" sid="2KI 16:2"/>ኣሃዝ ዬሮ ሞቲ ተኤት ነመ ወጋ ድግደማ ቱሬ፤ እንስ ዬሩሳሌም ኬሰ ታኤ ወጋ ኩዸ ጀአ ንቡልቼ። እን አከ አባሳ አከ ዳዊት ፉለ <char style="nd">ዋቀዮ</char> ዋቀሳ ዱረት ዋን ቀጄላ ህንሆጄትኔ። <verse eid="2KI 16:2"/><verse number="3" style="v" sid="2KI 16:3"/>እን ከራ ሞቶተ እስራኤል ዱካ ቡኤ ጎቸወን ጅብሲሶ ሰቦተ <char style="nd">ዋቀዮ</char> ፉለ እስራኤሎታ ዱራ አርኤ ባሴ ሰና ሆጄቹዻን እልመሳሌ ኣርሳ ጎዼ እብዳን ጉቤ። <verse eid="2KI 16:3"/><verse number="4" style="v" sid="2KI 16:4"/>እንስ እዶወን ሰገዳ ከኔን ጋረንራት፣ ፊጤ ጋረኒረቲፊ ሙከ ለልሳ ሁንደ ጀለት ቀልመ ዽኤሴ፣ እጣነስ ኣርሴ።<verse eid="2KI 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 16:5"/>ሬዚን ሞትች ሶርያቲፊ ጴቃን እልም ሬማልያ ሞትች እስራኤል ዬሩሳሌምን ሎሉፍ ኦል በአኒ ኣሃዝን መርሰን፤ ገሩ እሰ ሞአቹ ህንደንዴኜ። <verse eid="2KI 16:5"/><verse number="6" style="v" sid="2KI 16:6"/>ዬሮ ሰነት ሬዚን ሞትች ሶርያ ነሞተ ይሁዳ አርኤ ባሱዻን ኤላን ወረ ሶርያቲፍ ዴብሴ። ኤርገሲስ ኤዶሞን ኤላትት ጎዳነኒ ሀመ ሀርኣት አቹመ ጅራቱ።<verse eid="2KI 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 16:7"/>ኣሃዝስ አከነ ጄዼ ገረ ቲግላት ጵሌሴር ሞትቸ አሶርት ነመ ኤርጌ፤ “አን ገርብቻፊ እልመኬት። ኮቱቲ ሀርከ ሞቲ ሶርያቲፊ ሀርከ ሞቲ እስራኤል ከኔን ነት ዱለኒቲ ነ ባስ።” <verse eid="2KI 16:7"/><verse number="8" style="v" sid="2KI 16:8"/>ከነረት ኣሃዝ ሜቲፊ ወርቄ መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ኬሰ ጅሩፊ ከን መንኩሳ ቀቤኘ መሰራ ሞቱማ ኬሰት አርገሙ ባሴ ኬና ጎዼ ሞቲ አሶርቲፍ ንኤርጌ። <verse eid="2KI 16:8"/><verse number="9" style="v" sid="2KI 16:9"/>ሞቲን አሶር ሱንስ ከዻሳ ቶሌ ጄዼ ደማስቆ ሎሌ ቀበቴ። ጅራቶተሼስ ቦጅኤ ቂርት ጌሴ፤ ሬዚንንሞ ንአጄሴ።<verse eid="2KI 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 16:10"/>ኣሃዝ ሞትች ቲግላት ጵሌሴር ሞትቸ አሶር አርጉፍ ደማስቆ ዸቄ። እንስ እዶ ኣርሳ ቶኮ ደማስቆ ኬሰት አርጌ ፈኬኘሳቲፊ ከሮረ እቲን እጃረን ሁንደ በሬሴ ኡርያ ሉብቸት ኤርጌ። <verse eid="2KI 16:10"/><verse number="11" style="v" sid="2KI 16:11"/>ከናፉ ኡርያ ሉብች አኩመ ከሮረ ኣሃዝ ሞትች ደማስቆዻ ኤርጌፍ ሰነ ሁንዳት ኡቱ ኣሃዝ ሞትች ደማስቆዻ ህንዴብእን ዱረ እዶ ኣርሳ ሰነ እጃሬ ፍጤ። <verse eid="2KI 16:11"/><verse number="12" style="v" sid="2KI 16:12"/>ሞትችስ ዮሙ ደማስቆዻ ዴብኤ እዶ ኣርሳ ሰነ አርጌት እት ዽኣቴረት ኣርሳ ዽኤሴ። <verse eid="2KI 16:12"/><verse number="13" style="v" sid="2KI 16:13"/>እንስ ኣርሳ ጉበሙፊ ኬና ምዻኒ ዽኤሴ ዽባዩሌ ዽባፈቴ ዺገ ኣርሳ ነጋ ከን ኦፊሳስ እዶ ኣርሳ ሰነረት ንፈጫሴ። <verse eid="2KI 16:13"/><verse number="14" style="v" sid="2KI 16:14"/>እዶ ኣርሳ ናሲራ ሆጄተሜ ፉለ <char style="nd">ዋቀዮ</char> ዱረ ዻበቴ ቱሬ ሰነስ መነ ቁልቁሉማ ዱራ እዶ ኣርሳ ሃራፊ መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ግዱዻ ፍዴ ገመ ካባቲን እዶ ኣርሳ ሃራ ብረ ካኤ።<verse eid="2KI 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 16:15"/>ኤርገሲ ኣሃዝ ሞትች አከነ ጄዼ ኡርያ ሉብቸ አጀጄ፤ “እዶ ኣርሳ ጉድቸረት ኣርሳ ጉበሙ ከን ገነማቲፊ ኬና ምዻኒ ከን ገልገላ፣ ኣርሳ ሞትቻ ከን ጉበሙፊ ኬና ምዻኒ፣ ኣርሳ ነሞተ ብየቲ ሁንዳ ከን ጉበሙ፣ ኬናሳኒ ከን ምዻኒቲፊ ዽባዩሳኒ ዽኤስ። እዶ ኣርሳረት ዺገ ኣርሳ ጉበሙቲፊ ዺገ ቀልማ ሁንደ ፈጫስ። እዶ ኣርሳ ከን ናሲራ ሆጄተሜ ገሩ አነቱ እቲን ጎርሰ ጋፈተ።” <verse eid="2KI 16:15"/><verse number="16" style="v" sid="2KI 16:16"/>ኡርያን ሉብችስ አኩመ ኣሃዝ ሞትች አጀጄ ሰነ ጎዼ።<verse eid="2KI 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 16:17"/>ኣሃዝ ሞትች ባቱወን አሲፊ አች ሶቾፈመን ሰነራ መርሳወን ቡቅሴ ጫቢወን ዽቀትናሌ እራ ባሴ። ጋኒ ሰነ ባቱወን ፈኪ ጅቦታ ከኔን ናሲራ ሆጄተመንራ ፉዼ ዸጋ አፈማረ ካኤ። <verse eid="2KI 16:17"/><verse number="18" style="v" sid="2KI 16:18"/>እንስ ሞቲ አሶሪፍ ጄዼ ኦብዲ ጉያ ሰንበታቲፍ ሆጄተሜ እዶሳቲ ፉዼ ከረ አላ ከን ሞቶትን እቲን መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ሴነንስ ንቡቅሴ።<verse eid="2KI 16:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 16:19"/>ወን በረ ሞቱማ ኣሃዝ ኬሰ ሆጄተሜ ብራቲፊ ወን እን ሆጄቴ ክታበ ሴና ሞቶተ ይሁዳ ኬሰት በሬፈሜረ ምቲ? <verse eid="2KI 16:19"/><verse number="20" style="v" sid="2KI 16:20"/>ኣሃዝስ አቦቲሳ ወጅን ቦቆቴ እሳኑመ ብረት መጋላ ዳዊት ኬሰት ንአዋለሜ። እልምሳ ህስቅያስ እዶሳ ቡኤ ሞቲ ተኤ።<verse eid="2KI 16:20"/></para>
  <chapter eid="2KI 16"/>
  <chapter number="17" style="c" sid="2KI 17"/>
  <para style="s1">ሆሴኣ ሞትቸ እስራኤል ከን ዹማ</para>
  <para style="r">
    <ref loc="2KI 17:3-7">17፥3‑7</ref> ኩወፈ – <char style="xt"><ref loc="2KI 18:9-12">2ሞቶ 18፥9‑12</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 17:1"/>በረ ኣሃዝ ሞትቸ ይሁዳ ኬሰ ወጋ ኩዸ ለመፋት ሆሼኣ እልም ኤላ ሰማርያ ኬሰት ሞቲ እስራኤል ተኤ ወጋ ሰገል ቡልቼ። <verse eid="2KI 17:1"/><verse number="2" style="v" sid="2KI 17:2"/>እንስ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዋን ሀማ ሆጄቴ፤ ገሩ አከ ሞቶተ እስራኤል ከኔን እሳን ዱረ ቱረን ሰና ምት።<verse eid="2KI 17:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 17:3"/>ሸልመኔሴር ሞትች አሶር ሆሼኣ ሎሉፍ ኦል በኤ፤ ሆሼኣንስ ገርቦሜፊ ግብረ ባሴፍ። <verse eid="2KI 17:3"/><verse number="4" style="v" sid="2KI 17:4"/>ሞቲን አሶር ገሩ አከ ሆሼኣ ገንቱ ተኤ ሁበቴ፤ ሆሴኣ ሲጎር ሞትቸ ግብጥት ጃርሰ አራራ ኤርገቴ ኤርገሲ አከ ዱራን ወጉመ ወጋን ባሳ ቱሬ ሰነ ሞቲ አሶሪፍ ግብረ ባሱ ዺሴ። ከናፉ ስልምናሶር እሰ ቀቤ መነ ህዻ ኬሰ ቡሴ። <verse eid="2KI 17:4"/><verse number="5" style="v" sid="2KI 17:5"/>ኤርገሲስ ሞትች አሶር ጉቱማ ብየቲ ዌረሬ፤ ሰማርያትስ ዱሌ ወጋ ሰዲ መርሴ እሼ ቀበቴ። <verse eid="2KI 17:5"/><verse number="6" style="v" sid="2KI 17:6"/>በረ ሞቱማ ሆሼኣ ኬሰ ወጋ ሰግለፋት ሞቲን አሶር ሰማርያ ቀበቴ እስራኤሎተ ቦጅኤ አሶርት ጌሴ። እንስ ሀላ ኬሰ፣ ጎዛን ኬሰ፣ ጭነ ለገ ሃቦሪፊ መጋላወን ምድያን ኬሰ እሳን ቁበቺሴ።<verse eid="2KI 17:6"/></para>
  <para style="s1">ሰብን እስራኤል ሰበቢ ጩቡቲፍ ቦጅአሜ</para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 17:7"/>ወን ኩን ሁንድኑ ሰበቢ እስራኤሎን <char style="nd">ዋቀዮ</char> ዋቀሳኒ እሰ ግብጢ ሁምነ ፈረኦን ሞትቸ ግብጥ ጀላ እሳን ባሴ ሰነት ጩቡ ሆጄተኒፍ ተኤ፤ እሳን ዋቆተ ብራ ዋቄፈተኒ <verse eid="2KI 17:7"/><verse number="8" style="v" sid="2KI 17:8"/>ዋን ሰቦትን <char style="nd">ዋቀዮ</char> እሳን ዱራ አርኤ ባሴ ሱን ሆጄተን ዱካ ቡአኒ በርቴወን ሀማ ሞቶትን እስራኤል ፍደኒ እሳን በርሲሰንሌ ፉዸተን። <verse eid="2KI 17:8"/><verse number="9" style="v" sid="2KI 17:9"/>እስራኤሎን ዾክሳዻን ዋን ቀጄላ ህንተእን <char style="nd">ዋቀዮ</char> ዋቀሳኒት ሆጄተን። እሳን መጋላወንሳኒ ሁንደ ኬሰት ገሞ ኤጉምሳቲ ጀልቀበኒ ሀመ መጋላወን ደላ ጀባ ቀበኒት እዶወን ሰገዳ ከኔን ጋረንራ እጃረተን። <verse eid="2KI 17:9"/><verse number="10" style="v" sid="2KI 17:10"/>ጋረን ኦል ዼዼሮ ሁንደ ጉባቲፊ ሙከ ለልሳ ሁንደ ጀለት ፈኪወኒፊ ሲዳ ኣሼራ ዻበተን። <verse eid="2KI 17:10"/><verse number="11" style="v" sid="2KI 17:11"/>እሳን አኩመ ሰቦትን <char style="nd">ዋቀዮ</char> ፉለሳኒ ዱራ አርኤ ባሴ ጎዸን ሰነ እዶወን ሰገዳ ከኔን ጋረንራ ሁንደረት እጣነ ኣርሰን። ዋን ሀማ ኣሪዻፍ <char style="nd">ዋቀዮን</char> ከካሱሌ ንሆጄተን። <verse eid="2KI 17:11"/><verse number="12" style="v" sid="2KI 17:12"/><char style="nd">ዋቀዮስ</char>፣ “እስን ዋን ከነ ህንሆጄትና” ጄዹሌ እሳን ዋቆተ ቶልፈሞ ዋቄፈተን። <verse eid="2KI 17:12"/><verse number="13" style="v" sid="2KI 17:13"/><char style="nd">ዋቀዮ</char> አከነ ጄዼ ከራ ራጆታቲፊ እላልቶተሳ ሁንዳቲን እስራኤሊፊ ይሁዳ አኬከቺሴ፤ “ከራኬሰን ሀማ ከነራ ዴብኣ። አኩመ አጀጀወን አን አቦቲኬሰን አጀጄ ሁንዳቲፊ አኩመ ሴረ አን ከራ ገርቦተኮ ራጆታቲን እስኒፍ ኤርጌ ሰናት አጀጃፊ ሴረኮ ኤጋ።”<verse eid="2KI 17:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 17:14"/>እሳንሞ ዸጌፈቹ ድደኒ አኩመ አቦቲሳኒ ከኔን <char style="nd">ዋቀዮ</char> ዋቀሳኒ አመኑ ድደን ሰና መታ ጀባተን። <verse eid="2KI 17:14"/><verse number="15" style="v" sid="2KI 17:15"/>እሳን ሴራፊ ከኩ እን አቦቲሳኒ ወጅን ገሌ አከሱመስ አኬከቺሰ እን እሳኒፍ ኬኔሌ ፉዸቹ ድደን። እሳን ዋቆተ ቶልፈሞ ፋይዳ ህንቀብኔ ዱካ ቡአኒ እሳንስ ፋይዳ ዸበን። እሳን ኡቱመ <char style="nd">ዋቀዮ</char>፣ “ዋን ጀር ሆጄተን ህንሆጄትና” ጄዼ እሳን አጀጁ ሰቦተ ኦላሳኒ ዱካ ቡአኒ ዋን <char style="nd">ዋቀዮ</char> ሆጄቹ እሳን ዾዌ ንሆጄተን።<verse eid="2KI 17:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 17:16"/>እሳን አጀጀ <char style="nd">ዋቀዮ</char> ዋቀሳኒ ሁንደ ዺሰኒ ዋቆተ ቶልፈሞ በቅፈመኒ ብፈ ጀቢቲን ሆጄተመን ለማፊ ሲዳ ኣሼራ ቶልፈተን። ራያወን ሰሚ ሁንዳፍ ሰገደኒ በኣልንሌ ዋቄፈተን። <verse eid="2KI 17:16"/><verse number="17" style="v" sid="2KI 17:17"/>እልማንሳኒቲፊ እንተለንሳኒ ኣርሳ ጎዸኒ እብዳን ጉበን። ወረ ዋ ህሙ ጎርሰ ጋፈተን፤ ፈልፈለስ ሆጄተኒ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዋን ሀማ ሆጄቹት ደበርሰኒ ኦፍ ኬነኒ ዼከምሳፍ እሰ ከካሰን።<verse eid="2KI 17:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 17:18"/>ከናፉ <char style="nd">ዋቀዮ</char> አከ መሌ እስራኤልት ዼከሜ ፉለሳ ዱራ እሳን ቡቅሴ። ጎሰ ይሁዳ ቆፈቱ ሀፌ፤ <verse eid="2KI 17:18"/><verse number="19" style="v" sid="2KI 17:19"/>ይሁዳንዩ አጀጀ <char style="nd">ዋቀዮ</char> ዋቀሳኒ ህንኤግኔ። እሳንስ በርቴ እስራኤሎን እት ፍደን ዱካ ቡአን፤ <verse eid="2KI 17:19"/><verse number="20" style="v" sid="2KI 17:20"/>ከናፉ <char style="nd">ዋቀዮ</char> ሰበ እስራኤል ሁንደ ንገቴ፤ እን እሳን ሚዼ ሀመ ፉለሳ ዱራ እሳን ዸበምሲሱት ደበርሴ ሀርከ ሳምቶታት እሳን ኬኔ።<verse eid="2KI 17:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 17:21"/>ጋፈ እን መነ ዳዊትራ እስራኤል በቀቅሴት እሳን ዬሮብኣም እልመ ኔባት ሰነ ሞቲ ጎዸተን። ዬሮብኣምስ አከ እስራኤሎን ዋቀዮራ ገረ ገለኒ ጩቡ ጉዳ ሆጄተን ጎዼ። <verse eid="2KI 17:21"/><verse number="22" style="v" sid="2KI 17:22"/>እስራኤሎን ጩቡ ዬሮብኣም ሁንደ ኬሰ ጅራተን መሌ <verse eid="2KI 17:22"/><verse number="23" style="v" sid="2KI 17:23"/>ሀመ <char style="nd">ዋቀዮ</char> አኩመ ከራ ገርቦተሳ ራጆታቲን አኬከቺሴ ሰነት ፉለሳ ዱራ እሳን ቡቅሱትራ ህንዴብኔ። ከናፉ ሰብን እስራኤል ብየሳቲ ቦጁዻን ፉዸተሜ አሶርት ጌፈሜ፤ ሀመ ሀርኣትስ አቹመ ጅራተ።<verse eid="2KI 17:23"/></para>
  <para style="s1">አሶሮትን ሰማርያ ኬሰ ቁበተን</para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 17:24"/>ሞቲን አሶር ብየ ባብሎኒ፣ ኩታዻ፣ አዋዻ፣ ብየ ሀማቲፊ ሴፈርዋይሚ ነሞተ ፍዴ እዶ እስራኤሎታ ቡሱፍ ጄዼ መጋላወን ሰማርያ ኬሰ ቁበቺሴ። እሳንስ ሰማርያ ፉዸተኒ መጋላወንሼ ኬሰ ንጅራተን። <verse eid="2KI 17:24"/><verse number="25" style="v" sid="2KI 17:25"/>እሳን ዬሮ አች ጅራቹ ጀልቀበንት <char style="nd">ዋቀዮን</char> ህንዋቄፈትኔ፤ ከናፉ እን ግዱሳኒት ሌንጮተ ኤርጌ፤ ሌንጮትንስ እሳን ኬሳ ነሞተ ሙራሰ ገላፈተን። <verse eid="2KI 17:25"/><verse number="26" style="v" sid="2KI 17:26"/>ሞትቸ አሶርትስ አከነ ጄዸኒ ህመን፤ “ነሞትን አት ቦጅቴ መጋላወን ሰማርያ ኬሰ ቁበቺፍቴ ሱን ዋን ዋቅን ብየ ሰና ፌዹ ህንቤከን። እን ግዱሳኒት ሌንጮተ ኤርጌ፤ ሌንጮትንስ ሰበቢ ነሞትን ዋን ዋቅን ሱን ፌዹ ህንቤክኒፍ እሳን ፍጠን።”<verse eid="2KI 17:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 17:27"/>ከነረት ሞቲን አሶር፣ “ሉቦተ ቦጅተኒ ሰማርያዻ ፍደን ኬሳ ቶኮ አከ እን ዴብኤ አች ጅራቴ ዋን ዋቅን ብየ ሰና ፌዹ ነሞተ በርሲሱፍ አች ዴብሳ” ጄዼ አጀጀ ኬኔ። <verse eid="2KI 17:27"/><verse number="28" style="v" sid="2KI 17:28"/>ከናፉ ሉቦተ ሰማርያዻ ቦጅአመን ኬሳ ቶኮ ቤትኤል ኬሰ ጅራቴ አከ እሳን እት <char style="nd">ዋቀዮን</char> ዋቄፈተን በርሲሱ ዹፌ።<verse eid="2KI 17:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 17:29"/>ተኡስ ቶኮን ቶኮን ጎሳ መጋላ ኬሰ ጅራቱት ዋቆተ ኦፊሳ ቶልፈቴ እዶወን ሰገዳ ከኔን ወር ሰማርያ ጋረንረት ሆጄተኒ ቱረን ሰነረ ዻቤ። <verse eid="2KI 17:29"/><verse number="30" style="v" sid="2KI 17:30"/>ወር ባብሎኒ ዹፈን ዋቀ ቶልፈማ ሱኮት በኖት፣ ወር ኩታዻ ዹፈን ዋቀ ቶልፈማ ኔርጋል፣ ወር ሀማቲ ዹፈንሞ ዋቀ ቶልፈማ አሺማ ጄዸሙ ንቶልፈተን። <verse eid="2KI 17:30"/><verse number="31" style="v" sid="2KI 17:31"/>አዊሞትን ዋቆተ ቶልፈሞ ንብሃዚፊ ተርታቅ ጄዸመን ቶልፈተን፤ ሴፈርዋይሞንሞ ዋቆተ ቶልፈሞ ሴፈርዋይም ከኔን አድረሜሌኪፊ አናሜሌክ ጄዸመኒፍ እጆሌሳኒ ኣርሳ ጎዸኒ እብዳን ጉበን። <verse eid="2KI 17:31"/><verse number="32" style="v" sid="2KI 17:32"/>እሳን <char style="nd">ዋቀዮን</char> ዋቄፈተን፤ ገሩ አከ እሳን እዶወን ሰገዳ ከኔን ጋረንራት ሉቦተ ተአኒ ተጃጅለኒፍ ኦፉመ ግዱዻ ነሞተ ንፍለተን። <verse eid="2KI 17:32"/><verse number="33" style="v" sid="2KI 17:33"/>እሳን <char style="nd">ዋቀዮን</char> ዋቄፈተን፤ ገሩ አኩመ በርቴ ሰቦተ ኬሳ ፍደመን ሰናት ዋቆተ ኦፊሳኒ ተጃጅለን።<verse eid="2KI 17:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="2KI 17:34"/>እሳን ሀመ ሀርኣትሌ እቱመ ጭቸኒ በርቴሳኒ ከን ቀራ ሰነ ኬሰ ጅራቱ። እሳን <char style="nd">ዋቀዮን</char> ህንዋቄፈተን ዮካን ለብሲፊ ቀጄልፈመ፣ ሴራፊ አጀጀ <char style="nd">ዋቀዮ</char> ሰኚወን ያቆብ ከን እስራኤል ጄዼ ሞጋሴ ሰናፍ ኬኔስ ዱካ ህንቡአን። <verse eid="2KI 17:34"/><verse number="35" style="v" sid="2KI 17:35"/><char style="nd">ዋቀዮ</char> ጋፈ እስራኤሎተ ወጅን ከኩ ገሌት አከነ ጄዼ እሳን አጀጄ፦ “እስን ዋቀ ብራ ቶኮሌ ህንዋቄፈትና ዮካን ህንሰገድናፊ፤ እሳን ህንተጃጅልና ዮካን ኣርሳ እሳኒፍ ህንዽኤስና። <verse eid="2KI 17:35"/><verse number="36" style="v" sid="2KI 17:36"/>ገሩ <char style="nd">ዋቀዮ</char> እስን ዋቄፈቹ ቀብደን፣ እሰ ሁምነ ጀባፊ እሬ ድሪርፈሜን ግብጢ ባሴ እስን ፍዴ ሰናዸ። እስን እሳፍ ሰገደኒ ኣርሳ ዽኤሱፊ ቀብዱ። <verse eid="2KI 17:36"/><verse number="37" style="v" sid="2KI 17:37"/>እስን ዬሮ ሁንደ ለብሲፊ ቀጄልፈመ፣ ሴራፊ አጀጀ እን እስኒ በሬሴ ሰነ ኦፍ ኤገናዻን ኤጉ ቀብዱ። ዋቆተ ብራ ህንዋቄፈትና። <verse eid="2KI 17:37"/><verse number="38" style="v" sid="2KI 17:38"/>ከኩ አን እስን ወጅን ገሌ ሰነ ህንእራንፈትና፤ ዋቆተ ብራ ህንዋቄፈትና። <verse eid="2KI 17:38"/><verse number="39" style="v" sid="2KI 17:39"/>ቆደ ከና <char style="nd">ዋቀዮ</char> ዋቀኬሰን ዋቄፈዻ፤ ከን ሀርከ ዲነኬሰን ሁንዳ ኬሳ እስን ባሱ እሱማ።”<verse eid="2KI 17:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="2KI 17:40"/>ተኡስ እሳን እቱመ ጭቸኒ ዋኑመ ቀራ ሰነ ሆጄተን መሌ እሰ ህንዸጌኜ። <verse eid="2KI 17:40"/><verse number="41" style="v" sid="2KI 17:41"/>ዬሮ ነሞትን ኩኔን <char style="nd">ዋቀዮን</char> ዋቄፈቻ ጅረንትሌ እሳን ዋቆተ ቶልፈሞሳኒ ተጃጅላ ቱረን። ሀመ ጉያ ሀርኣትሌ እጆሌንሳኒቲፊ እጆሌን እጆሌሳኒ እቱመ ፉፈኒ አኩመ አቦቲንሳኒ ሆጄተን ሰነ ሆጄቻ ጅሩ።<verse eid="2KI 17:41"/></para>
  <chapter eid="2KI 17"/>
  <chapter number="18" style="c" sid="2KI 18"/>
  <para style="s1">ህስቅያስ ሞትቸ ይሁዳ</para>
  <para style="r">
    <ref loc="2KI 18:2-4">18፥2‑4</ref> ኩወፈ – <char style="xt"><ref loc="2CH 29:1-2">2ሴና 29፥1‑2</ref>፤ <ref loc="2CH 31:1">31፥1</ref></char></para>
  <para style="r">
    <ref loc="2KI 18:5-7">18፥5‑7</ref> ኩወፈ – <char style="xt"><ref loc="2CH 31:20-21">2ሴና 31፥20‑21</ref></char></para>
  <para style="r">
    <ref loc="2KI 18:9-12">18፥9‑12</ref> ኩወፈ – <char style="xt"><ref loc="2KI 17:3-7">2ሞቶ 17፥3‑7</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 18:1"/>በረ ሆሼኣ እልመ ኤላ ሞትቸ እስራኤል ኬሰ ወጋ ሰደፋት ህስቅያስ እልም ኣሃዝ ሞትቸ ይሁዳ ሞቲ ተኤ ቡልቹ ጀልቀቤ። <verse eid="2KI 18:1"/><verse number="2" style="v" sid="2KI 18:2"/>እን ዬሮ ሞቲ ተኤት ነመ ወጋ ድግደሚ ሸን ቱሬ፤ እንስ ዬሩሳሌም ኬሰ ታኤ ወጋ ድግደሚ ሰገል ቡልቼ። መቃን ሃዸሳ አቢያ ቱሬ፤ እሼንስ እንተለ ዘካርያስ። <verse eid="2KI 18:2"/><verse number="3" style="v" sid="2KI 18:3"/>እንስ አኩመ ዳዊት አባንሳ ጎዼ ሰነ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዋን ቀጄላ ሆጄቴ። <verse eid="2KI 18:3"/><verse number="4" style="v" sid="2KI 18:4"/>እን እዶወን ሰገዳ ከኔን ጋረንራ ዲጌ፤ ዸጋወን ዋቄፈትና ጨጨብሴ ሲዳወን ኣሼራሌ ቡርኩቴሴ። ሰበቢ እስራኤሎን ሀመ በረ ሰናት እጣነ ኣርሳፊ ቱረኒፍ እን ፈኪ ቦፋ ከን ሙሴን ናሲራ ሆጄቴ ሰነሌ ንጨጨብሴ። ፈኪን ቦፋ ሱን ኔሁሽታን ጄዸሜ ዋመመ ቱሬ።<verse eid="2KI 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 18:5"/>ህስቅያስ <char style="nd">ዋቀዮ</char> ዋቀ እስራኤል አመነቴ። ሞቶተ ይሁዳ ሁንደ ኬሳ ነምን አከሳ ቶኮዩ እሰ ዱራን ዮካን እሰ ዱባን ህንቱሬ። <verse eid="2KI 18:5"/><verse number="6" style="v" sid="2KI 18:6"/>እን ጀባቴ <char style="nd">ዋቀዮት</char> ሂቄ መሌ እሰ ዱካ ቡኡ ህንዺስኔ፤ ሴረ <char style="nd">ዋቀዮ</char> ሙሴፍ ኬኔ ሰነስ ንኤጌ። <verse eid="2KI 18:6"/><verse number="7" style="v" sid="2KI 18:7"/><char style="nd">ዋቀዮስ</char> እሰ ወጅን ቱሬ፤ እን ዋን ሆጄቴ ሁንደ ኬሰት ንምልካኤ። እን ሞቲ አሶርት ፍንጭሌ መሌ እሰ ህንተጃጅሌ። <verse eid="2KI 18:7"/><verse number="8" style="v" sid="2KI 18:8"/>እን ገሞ ኤጉምሳቲ ጀልቀቤ ሀመ መጋላ ደላ ጀባ ቀቡት፣ ሀመ ጋዛቲፊ ዳንጋሼት ፍልስጤሞተ ንሞአቴ።<verse eid="2KI 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 18:9"/>ወጋ አፉረፋ በረ ህስቅያስ ሞትቻ ኬሰ ጄቹንስ ወጋ ቶርበፋ በረ ሆሼኣ እልመ ኤላ ሞትቸ እስራኤል ኬሰ ሸልመኔሴር ሞትች አሶር ሰማርያት ዱሌ መርሴ እሼ ቀበቴ። <verse eid="2KI 18:9"/><verse number="10" style="v" sid="2KI 18:10"/>ዹመ ወጋ ሰደፋት አሶሮን እሼ ፉዸተን። አከሲንስ ሰማርያን ወጋ ጀአፋ በረ ሞቱማ ህስቅያስ ኬሰ፣ ወጋ ሰግለፋ በረ ሆሼኣ ሞትቸ እስራኤል ኬሰ ንፉዸተምቴ። <verse eid="2KI 18:10"/><verse number="11" style="v" sid="2KI 18:11"/>ሞቲን አሶርስ እስራኤሎተ ቦጅኤ አሶርት ጌሴ ሀላ ኬሰ፣ ጎዛን ኬሰ፣ ለገ ሃቦር ብራፊ መጋላወን ምድያን ኬሰ ንቁበቺሴ። <verse eid="2KI 18:11"/><verse number="12" style="v" sid="2KI 18:12"/>ወን ኩን ሰበቢ እሳን <char style="nd">ዋቀዮ</char> ዋቀሳኒቲፍ አጀጀሙ ድደኒ ከኩሳ፣ አጀጀ ሙሴን ገርብች <char style="nd">ዋቀዮ</char> እሳኒፍ ኬኔ ሁንደ ጨብሰኒፍ እሳንት ዹፌ። እሳን አጀጀ ሰነ ህንዸጌፈትኔ ዮካን ሆጂረ ህንኦልችኔ።<verse eid="2KI 18:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 18:13"/>በረ ሞቱማ ህስቅያስ ሞትቻ ኬሰ ወጋ ኩዸ አፉረፋት፣ ሴናሄሪብ ሞትች አሶር መጋላወን ይሁዳ ከኔን ደላ ጀባ ቀበን ሁንደ ሎሌ ንቀበቴ። <verse eid="2KI 18:13"/><verse number="14" style="v" sid="2KI 18:14"/>ከናፉ ህስቅያስ ሞትች ይሁዳ፣ “አን በሌሳ ሆጄዼረ። ብየኮ ኬሳ ና በእ፤ አን ዋን አት ነ ጋፈቱ ከምዩ ሲፍን ኬና” ጄዼ ገረ ላኪሽት ሞትቸ አሶርት ኤርጋ ኤርገቴ። ሞትች አሶርስ፣ “ሜቲ ታላንቲ ዽበ ሰዲፊ ወርቄ ታላንቲ ሶዶመ ና ኬን” ጄዼ ህስቅያስ ሞትቸ ይሁዳ ንጋፈቴ። <verse eid="2KI 18:14"/><verse number="15" style="v" sid="2KI 18:15"/>ከናፉ ህስቅያስ ሜቲ መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ኬሰቲፊ ከን መንኩሳ መሰራ ሞቱማ ኬሰት አርገሙ ሁንደ ጉሬ ኬኔፍ።<verse eid="2KI 18:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 18:16"/>ዬሮ ከነት ህስቅያስ ሞትች ይሁዳ ወርቄ በልበላፊ ዻበ በልበለ መነ ቁልቁሉማ <char style="nd">ዋቀዮት</char> ኡፍሴ ቱሬራ ባሴ ሞቲ አሶሪፍ ኬኔ።<verse eid="2KI 18:16"/></para>
  <para style="s1">ሰናክሬም ዬሩሳሌምን ዶርስሴ</para>
  <para style="r">
    <ref loc="2KI 18:13">18፥13</ref>፣<ref loc="2KI 18:17-37">17‑37</ref> ኩወፈ – <char style="xt"><ref loc="ISA 36:1-22">እሳ 36፥1‑22</ref></char></para>
  <para style="r">
    <ref loc="2KI 18:17-35">18፥17‑35</ref> ኩወፈ – <char style="xt"><ref loc="2CH 32:9-19">2ሴና 32፥9‑19</ref></char></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 18:17"/>ኤርገሲ ሞትች አሶር አጀጃ ወራናሳ ኦል ኣና፣ አጀጃ ሀንገፋፊ አጀጃ ወራነሳ ሎልቶተ ሄዱ ወጅን ላኪሺ ገረ ዬሩሳሌምት ህስቅያስ ሞትቸት ንኤርጌ። እሳንስ ዬሩሳሌም ዹፈኒ ቦኦ ሀሮ ኦል ኣኑ ብረ ከራ ለፈ ቆቲሳ ነምቸ ወያ ሚጩት ጌሱረ ዸዻበተን። <verse eid="2KI 18:17"/><verse number="18" style="v" sid="2KI 18:18"/>እሳን ሞትቸ ንዋምስፈተን፤ ኤሊያቂም እልም ህልቅያ ቡልቻን መሰራ ሞቱማ፣ ሼብና በሬሳኒፊ ዮኣ እልም አሳፍ ገልሜሳን እሳንት ገድ በአን።<verse eid="2KI 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 18:19"/>አጀጃን ወራና ሱንስ አከነ እሳኒን ጄዼ፤ “አከነ ጄዻ ህስቅያስት ህማ፦</para>
  <para style="pm" vid="2KI 18:19">“ ‘ሞቲን ጉዳን፣ ሞትች አሶር አከነ ጄዸ፦ ኦፍ አመነቹኬ ከነ ማልረት ሁንዴፈቴ? <verse eid="2KI 18:19"/><verse number="20" style="v" sid="2KI 18:20"/>አት፣ “አን ቶፍታፊ ጀብነ ወራና ቀበ” ጄተ፤ ገሩ ዱቢ ፋይዳ ህንቀብኔ ዱበተ። አት ኤኙን አብደቴ ነት ፍንጭልተ? <verse eid="2KI 18:20"/><verse number="21" style="v" sid="2KI 18:21"/>ኩኖ አት ግብጥን ጄቹንስ ኡሌ ሸምበቆ ጨጨባ ሀርከ ነመ እሰት እርከቱ ከሚዩ ወራኔ መዴሱ ሰነ አብደቴርተ! ፈረኦን ሞትች ግብጥስ ነመ እሰ አብደቱ ሁንዳፍ አከሱመ። <verse eid="2KI 18:21"/><verse number="22" style="v" sid="2KI 18:22"/>ዮ እስን፣ “ኑ <char style="nd">ዋቀዮ</char> ዋቀኬኘ አብደትነ” ናን ጄተን፣ እን እሱመ ህስቅያስ እዶወን ሰገዳሳቲፊ እዶወን ኣርሳሳ ዲጌ ይሁዳፊ ዬሩሳሌሚን፣ “እስን ፉለ እዶ ኣርሳ ከን ዬሩሳሌም ኬሳ ከነ ዱረት ዋቄፈቹ ቀብዱ” ጄዼ ሰነ ምቲ?<verse eid="2KI 18:22"/></para>
  <para style="pm">
    <verse number="23" style="v" sid="2KI 18:23"/>“ ‘አመ ኮቱቲ ጎፍታኮ ሞትቸ አሶር ወጅን ዱበዹ፤ አንስ ዮ አት ነሞተ ፈርደ ያበተን ቆጴፈቹ ደንዴሴ ፈርዴን ኩመ ለመ ሲፍን ኬነ! <verse eid="2KI 18:23"/><verse number="24" style="v" sid="2KI 18:24"/>አት ዮ ጋሪወኒፊ አቦቲ ፈርዳቲፍ ጄቴ ግብጥን አብደቴዩ አከሚን ቆንዳልቶተ ጎፍታኮቲ ኬሳ አጀጃ ገድ ኣናሳሌ ኦፍራ ዴብሱ ደንዴሰ? <verse eid="2KI 18:24"/><verse number="25" style="v" sid="2KI 18:25"/>አት ዋን አን ዱቢ <char style="nd">ዋቀዮ</char> መሌ እዶ ከነ ሎሌ በርበዴሱፍ ዹፌ ሴታ? <char style="nd">ዋቀዮ</char> መታንሳ አከ አን ብየ ከነት ዱሌ እሼ በርበዴሱ ነት ዱበቴረ።’ ”<verse eid="2KI 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 18:26"/>ከነረት ኤሊያቂም እልመ ህልቅያ፣ ሼብናፊ ዮኣ አጀጃ ወራና ሰናን፣ “ማሎ ዋን ኑ ዸጌኙፍ አፋን ወረ አራማይኪቲን ገርቦተኬት ዱበዹ። ኡቱመ ነሞትን ደላረ ጅረን ዸገአኒ አፋን እብሮታቲን ኑት ህንዱበትን” ጄዸን።<verse eid="2KI 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 18:27"/>አጀጃን ወራና ሱን ገሩ አከነ ጄዼ ዴብሴ፤ “ነምን ጎፍታንኮ አከ አን ዋን ከነ እት ህሙፍ እት ነ ኤርጌ ጎፍታኬሰኒፊ እስን ቆፋ? ነሞተ ደላረ ተታአን ወረ አኩመኬሰን ኡዳን ኦፊሳኒ ኛተኒ ፍንጫን ኦፊሳኒ ዹጉ ቀበኒፍስ ምቲ?”<verse eid="2KI 18:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 18:28"/>ኤርገሲ አጀጃን ወራና ሱን ኦል ከኤ አፋን እብሮታቲን አከነ ጄዼ፤ “ዱቢ ሞትቸ ጉዳ፣ ዱቢ ሞቲ አሶር ዸገኣ! <verse eid="2KI 18:28"/><verse number="29" style="v" sid="2KI 18:29"/>ሞትች አከነ ጄዸ፦ ህስቅያስ እስን ህንጎዎምስን። እን ሀርከኮቲ እስን ባሱ ህንደንደኡ። <verse eid="2KI 18:29"/><verse number="30" style="v" sid="2KI 18:30"/>ህስቅያስ፣ ‘<char style="nd">ዋቀዮ</char> ዹጉማን ኑ ባሰ፤ መጋላን ኩንስ ደበርፈምቴ ሀርከ ሞትቸ አሶርት ህንኬነምቱ’ ጄቹዻን አከ እስን <char style="nd">ዋቀዮን</char> አመነተኒፍ እስን ህንሶሶብን።<verse eid="2KI 18:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="2KI 18:31"/>“ህስቅያስን ህንዸጌፈትና። ሞቲን አሶር አከነ ጄዸ፦ አነ ወጅን ወሊ ገልቴ ነጋ ዻበዻቲ ነት ገድ በኣ። ኤርገሲ ቶኮን ቶኮንኬሰን ሙከ ወይኒቲፊ ሙከ ሀርቡኬሰንራ ንኛቱ፤ ቦለ ብሻንኬሰኒ ኬሳስ ንዹግዱ፤ <verse eid="2KI 18:31"/><verse number="32" style="v" sid="2KI 18:32"/>ኩንስ ሀመ አን ዹፌ ገረ ብየ አኩመ ብየኬሰኒ ጅርቱ፣ ገረ ብየ ምዻኒፊ ዳዺ ወይኒ ሃራት፣ ገረ ብየ ቡዴናፊ እዶ ዻባ ወይኒት፣ ገረ ብየ ሙከ ኤጄርሳቲፊ ደማት እስን ጌሱት ተአ። እስን ጅሬኘ ፍለዻ መሌ ዱአ ህንፍለትና!</para>
  <para style="p" vid="2KI 18:32">“ዋን እን፣ ‘<char style="nd">ዋቀዮ</char> ኑ በራረ’ ጄዼ እስን ዶጎጎርሱፍ ህስቅያስን ህንዸገእና። <verse eid="2KI 18:32"/><verse number="33" style="v" sid="2KI 18:33"/>ዋቅን ሰቦተ ከሚዩ ተኩማ ሀርከ ሞትቸ አሶር ኬሳ ብየ ኦፊ ባፈቴ ቤካ? <verse eid="2KI 18:33"/><verse number="34" style="v" sid="2KI 18:34"/>ዋቆትን ሀማቲፊ ዋቆትን አርፋድ ኤሰ ጅሩ? ዋቆትን ሴፈርዋይም፣ ዋቆትን ሄናቲፊ እዋ ኤሰ ጅሩ? እሳን ሀርከኮ ኬሳ ሰማርያ ባሰኒሩ? <verse eid="2KI 18:34"/><verse number="35" style="v" sid="2KI 18:35"/>ዋቆተ ብዮተ ከኔኒ ሁንደ ኬሳ ከምቱ ሀርከኮ ኬሳ ብየሳ ባሱ ደንደኤ? ዮስ <char style="nd">ዋቀዮ</char> አከሚን ሀርከኮ ኬሳ ዬሩሳሌምን ባሱ ደንደአሬ?”<verse eid="2KI 18:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="2KI 18:36"/>ነሞትን ገሩ ሰበቢ ሞትች፣ “ዴቢ ህንኬንናፊ” ጄዼ አጀጄፍ እኑመ ጨልእሰን መሌ ዴቢ ቶኮዩ ህንኬንኔ።<verse eid="2KI 18:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="2KI 18:37"/>ከነረት ኤሊያቂም እልም ህልቅያ ቡልቻን መሰራ ሞቱማ፣ ሼብና በሬሳኒፊ ዮኣ እልም አሳፍ ገልሜሳን ኡፈተሳኒ ተተርሳሰኒ ገረ ህስቅያስ ዸቀኒ ዋን አጀጃን ወራና ሱን ጄዼ እት ንህመን።<verse eid="2KI 18:37"/></para>
  <chapter eid="2KI 18"/>
  <chapter number="19" style="c" sid="2KI 19"/>
  <para style="s1">ፉረሙን ዬሩሳሌም ዱራን ዱርፈሜ ህመሜ</para>
  <para style="r">
    <ref loc="2KI 19:1-13">19፥1‑13</ref> ኩወፈ – <char style="xt"><ref loc="ISA 37:1-13">እሳ 37፥1‑13</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 19:1"/>ህስቅያስ ሞትች ዮሙ ዋን ከነ ዸገኤት ኡፈተሳ ተርሳሴ ወያ ገዳስ ኡፈቴ መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ሴኔ። <verse eid="2KI 19:1"/><verse number="2" style="v" sid="2KI 19:2"/>እንስ ኤሊያቂም ቡልቻ መሰራ ሞቱማ፣ ሼብና በሬሳፊ ሉቦተ ዱረ ቡኦተ ሁንድሳኒ ወያ ገዳ ኡፈተን እሳያስ ራጅቸ እልመ አሞስ ሰነት ኤርጌ። <verse eid="2KI 19:2"/><verse number="3" style="v" sid="2KI 19:3"/>እሳንስ አከነ ጄዸኒ እሰት ህመን፤ “ህስቅያስ አከነ ጄዸ፤ ጉያን ኩን አኩመ ዬሮ ዳእምን ቶኮ ዸለቹ ገኤ ገሩ ዱበርቲን ሁምነ እቲን ጭኒንስፈቴ ዴሱ ዸብዱት ጉያ ሉበሙ፣ ከን ዼከምሳቲፊ ከን ሰልጵናት። <verse eid="2KI 19:3"/><verse number="4" style="v" sid="2KI 19:4"/><char style="nd">ዋቀዮ</char> ዋቅንኬ ዱቢ አጀጃ ወራና ከን ጎፍታንሳ ሞትች አሶር አከ እን ዋቀ ጅራታት ቆሱፍ ኤርጌ ሰና ሁንደ ዸገኤ ዱቢ <char style="nd">ዋቀዮ</char> ዋቅንኬ ዸገኤ ሰናፍ ጄዼ እሰት ዼከመ ተአ። ከናፉ አት ሀምባወን ሀመ አማት ጅረኒፍ ከዸዹ።”<verse eid="2KI 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 19:5"/>ዮሙ ቆንዳልቶትን ህስቅያስ ሞትቻ ገረ እሳያስ ዹፈንት፣ <verse eid="2KI 19:5"/><verse number="6" style="v" sid="2KI 19:6"/>እሳያስ አከነ እሳኒን ጄዼ፤ “አከነ ጄዻ ጎፍታኬሰንት ህማ፤ ‘<char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ አት ዋን ዸጌሴ ጄቹንስ ዱቢ ገርቦን ሞቲ አሶር እቲን ነ አረብሰን ሰነ ህንሶዳትን። <verse eid="2KI 19:6"/><verse number="7" style="v" sid="2KI 19:7"/>ዸጌፈዻ! አን አከ እን ኦዱ ወዪ ዸገኤ ገረ ብየ ኦፊሳት ዴብኡፍ ሀፉረ ቶኮ እሰ ኬሰ ነንካአ፤ አችትስ አከ እን ጎራዴዻን አጄፈሙ ነንጎዸ።’ ”<verse eid="2KI 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 19:8"/>አጀጃን ወራናስ ዮሙ አከ ሞቲን አሶር ላኪሺ በኤ ዴሜ ዸገኤት፣ ዱበት ዴብኤ ኡቱ ሞትች ልብና ሎላ ጅሩ አርገቴ።<verse eid="2KI 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 19:9"/>ሴናሄሪብስ አከ ቲርሃቅ ሞትች እቶጵያ ሱን እሰ ሎሉፍ ዹፋ ጅሩ ዸገኤ። ከናፉ እን አከነ ጄዼ አመሌ ህስቅያስት ኤርገሞተ ኤርጌ፤ <verse eid="2KI 19:9"/><verse number="10" style="v" sid="2KI 19:10"/>“ህስቅያስ ሞትቸ ይሁዳቲን አከነ ጄዻ፦ ዋቅን አት አብደቱ ሱን፣ ‘ዬሩሳሌም ደበርፈምቴ ሀርከ ሞቲ አሶርት ህንኬነምቱ’ ጄዼ ስ ህንጎዎምስን። <verse eid="2KI 19:10"/><verse number="11" style="v" sid="2KI 19:11"/>አት ዋን ሞቶትን አሶር ጉቱማን ጉቱት እሳን በሌሱዻን ብዮተ ሁንደ ጎዸን ዸጌሴርተ። አትሞ ንሀፍታሬ? <verse eid="2KI 19:11"/><verse number="12" style="v" sid="2KI 19:12"/>ዋቆትን ሰቦተ አቦቲንኮ በርበዴሰን ሰና ጄቹንስ ዋቆትን ጎዛን፣ ዋቆትን ካራን፣ ዋቆትን ሬዜፊፊ ዋቆትን ነሞተ ኤዴን ከኔን ቴላሳር ኬሰ ቱረን ሰና እሳን ኦልቸኒሩ? <verse eid="2KI 19:12"/><verse number="13" style="v" sid="2KI 19:13"/>ሞቲን ሀማት፣ ሞቲን አርፋድ፣ ሞቲን መጋላ ሴፈርዋይም ዮካን ሞቲን ሄና ዮካን ሞቲን እዋ ኤሰ ጅረ?”<verse eid="2KI 19:13"/></para>
  <para style="s1">ከዻ ህስቅያስ</para>
  <para style="r">
    <ref loc="2KI 19:14-19">19፥14‑19</ref> ኩወፈ – <char style="xt"><ref loc="ISA 37:14-20">እሳ 37፥14‑20</ref></char></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 19:14"/>ህስቅያስስ ኤርገሞተ ሰነ ሀርካ ጠለያ ፉዼ ዱብፈቴ። ኤርገሲስ ገረ መነ ቁልቁሉማ <char style="nd">ዋቀዮት</char> ኦል በኤ ጠለያ ሰነ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ድሪርሴ። <verse eid="2KI 19:14"/><verse number="15" style="v" sid="2KI 19:15"/>ህስቅያስ አከነ ጄዼ <char style="nd">ዋቀዮን</char> ከዸቴ፤ “ያ <char style="nd">ዋቀዮ</char>፣ ዋቀ እስራኤል፣ ከን ኪሩቤል ግዱ ቴሶረ ጅርቱ፣ ስ ቆፈቱ ሞቱሞተ ለፋ ሁንደረት ዋቀ። አት ሰሚፊ ለፈ ኡምቴርተ። <verse eid="2KI 19:15"/><verse number="16" style="v" sid="2KI 19:16"/>ያ <char style="nd">ዋቀዮ</char>፣ ጉረኬ አስ ቀቢቲ ዸገእ፤ ያ <char style="nd">ዋቀዮ</char> እጀኬስ በነዹ እላል፤ ዱቢ ሴናሄሪብ ከን እን ዋቀ ጅራታ አረብሱፍ ኤርጌ ከነ ዸጌፈዹ።<verse eid="2KI 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 19:17"/>“ያ <char style="nd">ዋቀዮ</char> ሞቶትን አሶር ሰቦተ ከናፊ ብዮተሳኒ በሌሱን ዹጋዸ። <verse eid="2KI 19:17"/><verse number="18" style="v" sid="2KI 19:18"/>እሳን ዋቆተ ጀራ እብደት ነቀኒ በርበዴሰኒሩ፤ ዋቆትን ሱን ሙካፊ ዸጋ ሀርከ ነማቲን ሶፈመን ቱረን መሌ ዋቆተ ህንቱሬቲ። <verse eid="2KI 19:18"/><verse number="19" style="v" sid="2KI 19:19"/>ከናፉ ያ <char style="nd">ዋቀዮ</char> ዋቀኬኘ፣ አከ ሞቱሞን ለፋ ሁንድኑ ያ <char style="nd">ዋቀዮ</char>፣ አከ አት ቆፍት ዋቀ ታቴ ቤከኒፍ ሀርከሳቲ ኑ ባስ።”<verse eid="2KI 19:19"/></para>
  <para style="s1">ኩፋቲ ሰናክሬም</para>
  <para style="r">
    <ref loc="2KI 19:20-37">19፥20‑37</ref> ኩወፈ – <char style="xt"><ref loc="ISA 37:21-38">እሳ 37፥21‑38</ref></char></para>
  <para style="r">
    <ref loc="2KI 19:35-37">19፥35‑37</ref> ኩወፈ – <char style="xt"><ref loc="2CH 32:20-21">2ሴና 32፥20‑21</ref></char></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 19:20"/>ሰነ ቦዴ እሳያስ እልም አሞስ አከነ ጄዼ ህስቅያስት ኤርጋ ኤርጌ፦ “<char style="nd">ዋቀዮ</char> ዋቅን እስራኤል አከነ ጄዸ፦ አን ከዻኬ ከን አት ዋኤ ሴናሄሪብ ሞትቸ አሶር ከዸቴ ሰነ ዸገኤረ። <verse eid="2KI 19:20"/><verse number="21" style="v" sid="2KI 19:21"/>ዱቢን <char style="nd">ዋቀዮ</char> እሳን ሞርሙዻን ዱበቴ ኩኖ ከናዸ፦</para>
  <para style="q1" vid="2KI 19:21">“ ‘እንተል ጥዮን ዱርብ ቁልቁልቲን</para>
  <para style="q2" vid="2KI 19:21">ስ ቱፈቴ ስት ቆስት።</para>
  <para style="q1" vid="2KI 19:21">እንተል ዬሩሳሌም ዬሮ አት በቀቱት</para>
  <para style="q2" vid="2KI 19:21">መታሼ ስት ራፍት።<verse eid="2KI 19:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="2KI 19:22"/>ከን አት እት ቆስቴ አረብስቴ ሱን ኤኙ?</para>
  <para style="q2" vid="2KI 19:22">አት ኤኙት ሰገሌኬ ኦል ፉዸቴ</para>
  <para style="q1" vid="2KI 19:22">ኦፍ ቱሉማዻን እጀ ኦል ቀበቴ?</para>
  <para style="q2" vid="2KI 19:22">ቁልቁልቹመ እስራኤል ሰነት ምቲ!<verse eid="2KI 19:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="2KI 19:23"/>አት ከራ ኤርገሞተኬቲቲን</para>
  <para style="q2" vid="2KI 19:23">ጎፍታት ቆስቴርተ።</para>
  <para style="q1" vid="2KI 19:23">አት አከነስ ጄቴርተ፤</para>
  <para style="q2" vid="2KI 19:23">“አን ጋሪወንኮ ሄዱዻን</para>
  <para style="q1" vid="2KI 19:23">ፊጤ ቱሉወኒት፣</para>
  <para style="q2" vid="2KI 19:23">ፊጤ ልባኖን ከን አከ መሌ ኦል ዼረቱትስ ኦል በኤረ።</para>
  <para style="q1" vid="2KI 19:23">አን ብርብርሰወንሳ ከኔን አከ መሌ ዼዼሮ፣</para>
  <para style="q2" vid="2KI 19:23">ጋትራወንሳ ፍለተሞ ሰነስ ጭጭሬረ።</para>
  <para style="q1" vid="2KI 19:23">አን እዶወንሳ ከኔን አከ መሌ ኦል ፈጎ፣</para>
  <para style="q2" vid="2KI 19:23">ቦሶኖተሳ ኬሳ፣ ምሚዸጎ ቀቀቤረ።<verse eid="2KI 19:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="2KI 19:24"/>አን ብየ ኦርማት ቦለ ብሻኒ ቆተዼ</para>
  <para style="q2" vid="2KI 19:24">አችት ብሻን ዹጌረ።</para>
  <para style="q1" vid="2KI 19:24">አን ፋነ ሚለኮቲን</para>
  <para style="q2" vid="2KI 19:24">ለጌን ብየ ግብጥ ሁንደ ጎግሴረ።”<verse eid="2KI 19:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="2KI 19:25"/>“ ‘አት ዋን ከነ ህንዸጌኜ?</para>
  <para style="q2" vid="2KI 19:25">በረ ዼራን ዱረ አነቱ ዋን ከነ ሆጄቴ።</para>
  <para style="q1" vid="2KI 19:25">አን በረ ዱሪ ኬሰ ዋን ከነ ነንከሮርፈዼ፤</para>
  <para style="q2" vid="2KI 19:25">አመሞ ሆጂረ ኦልፈዼረ፤</para>
  <para style="q1" vid="2KI 19:25">ኩንስ አከ አት መጋላወን</para>
  <para style="q2" vid="2KI 19:25">ደላ ጀባ ቀበን ዲግዴ ቱላ ዸጋ ጌደርቱዸ።<verse eid="2KI 19:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="2KI 19:26"/>ነሞትንሳኒ ሁምነ ዸበኒ</para>
  <para style="q2" vid="2KI 19:26">አብዲ ኩተተኒስ ቃነአን።</para>
  <para style="q1" vid="2KI 19:26">እሳን አኩመ ብቅልቱ ዲዳ፣</para>
  <para style="q2" vid="2KI 19:26">አኩመ ብቅልቱ ክቹ ቶኮ፣</para>
  <para style="q1" vid="2KI 19:26">አኩመ መርገ መነ ጉባት ብቅሉ</para>
  <para style="q2" vid="2KI 19:26">ከን ኡቱ ህንጉደትን ጉበቴት።<verse eid="2KI 19:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="2KI 19:27"/>“ ‘አን ገሩ ለፈ አት ጅርቱ፣</para>
  <para style="q2" vid="2KI 19:27">ዮም አከ ዹፍቱፊ ዮም አከ ዴምቱ፣</para>
  <para style="q2" vid="2KI 19:27">አከ አት አከ መሌ ነት ኣርቱሌ ነንቤከ።<verse eid="2KI 19:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="2KI 19:28"/>ዋን አት አከ መሌ ነት ኣርቴ ጉጉበቴ</para>
  <para style="q2" vid="2KI 19:28">ኦፍ ቱሉማንኬ ጉረኮ ገኤፍ፣</para>
  <para style="q1" vid="2KI 19:28">አን ሆኮኮ ፉኛንኬ ኬሰ፣</para>
  <para style="q2" vid="2KI 19:28">ሉገመኮ አፋንኬ ኬሰ ካኤን</para>
  <para style="q1" vid="2KI 19:28">አከ አት ከሩመ ዹፍቴ ሰነ</para>
  <para style="q2" vid="2KI 19:28">ዴብቱ ስን ጎዸ።’<verse eid="2KI 19:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 19:29"/>“ያ ህስቅያስ ኩን መለቶ ሲፍ ተአ፦</para>
  <para style="q1" vid="2KI 19:29">“እስን ወጋ ከነ ዋን ኦፉማን ብቅሉ፣</para>
  <para style="q2" vid="2KI 19:29">ወጋ ለመፋትሞ ዋኑመ እሰራ ለቱ ኛቱ።</para>
  <para style="q1" vid="2KI 19:29">ወጋ ሰደፋት ገሩ ፈጫፈዻ ገልፈዻ፤</para>
  <para style="q2" vid="2KI 19:29">ሙከ ወይኒስ ዻበዻቲ እጀሳ ኛዻ።<verse eid="2KI 19:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="2KI 19:30"/>አመስ ሀምባን ሞቱማ ይሁዳ ቶኮ</para>
  <para style="q2" vid="2KI 19:30">ጀላን ህደ ባፈቴ ጉባንሞ እጀ ነቀተ።<verse eid="2KI 19:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="2KI 19:31"/>ዬሩሳሌም ኬሳ ሀምባን ቶኮ፣</para>
  <para style="q2" vid="2KI 19:31">ቱሉ ጥዮኒቲሞ ገሬን ወረ በዲሰ ጀላ በኤ ቶኮ ንዹፈ።</para>
  <para style="m" vid="2KI 19:31">ህናፋን <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ ዋን ከነ ንራወተ፦<verse eid="2KI 19:31"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="32" style="v" sid="2KI 19:32"/>“ከናፉ <char style="nd">ዋቀዮ</char> ዋኤ ሞትቸ አሶር አከነ ጄዸ፦</para>
  <para style="q1" vid="2KI 19:32">“ ‘እን መጋላ ከነ ህንሴኑ</para>
  <para style="q2" vid="2KI 19:32">ዮካን ጥየ ቶኮሌ አስት ህንደርበቱ።</para>
  <para style="q1" vid="2KI 19:32">እን ጋቸነ ቀበቴ ፉለሳ ዱረት ህንዽኣቱ</para>
  <para style="q2" vid="2KI 19:32">ዮካን ቱላ ብዮ እት ህንመርሱ።<verse eid="2KI 19:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="2KI 19:33"/>እን ከሩመ ዹፌ ሰናን ንዴብአ፤</para>
  <para style="q2" vid="2KI 19:33">መጋላ ከነስ ህንሴኑ፣</para>
  <para style="q2" vid="2KI 19:33">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="2KI 19:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="2KI 19:34"/>አንስ ሰበቢ ኦፊኮቲፊ ሰበቢ ገርብቸኮ ዳዊቲፍ ጄዼ፣</para>
  <para style="q2" vid="2KI 19:34">መጋላ ከነ ነንኤገ፤ ነንኦልቸስ።’ ”<verse eid="2KI 19:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="2KI 19:35"/>ሀልከኑመ ሰነ ኤርገማን <char style="nd">ዋቀዮ</char> ገድ በኤ ቁበተ ወረ አሶር ኬሰት ነመ ኩመ ዽበ ቶኮፊ ሰዴተሚ ሸን ፍጤ። ዮሙ ነሞትን ጉያ እት ኣኑ ገነመ በሪን ከአንት ኩኖ ሬፍ ነማ ለፈ ጉቴ ቱሬ! <verse eid="2KI 19:35"/><verse number="36" style="v" sid="2KI 19:36"/>ከናፉ ሴናሄሪብ ሞትች አሶር ቁበተ ሰነ ኬሳ በኤ በቀቴ፤ ነነዌት ዴብኤስ አች ጅራቴ።<verse eid="2KI 19:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="2KI 19:37"/>ጋፍ ቶኮ ኡቱ እን መነ ሰገዳ ዋቀሳ ንስሮክ ጄዸሙ ኬሰት ዋቄፈቻ ጅሩ እልማንሳ አድረሜሌኪፊ ሸሬዜር ጎራዴዻን እሰ አጄሰኒ ብየ አራራትት በቀተን። እልምሳ ኤሰርሀዶንስ እዶሳ ቡኤ ሞቲ ተኤ።<verse eid="2KI 19:37"/></para>
  <chapter eid="2KI 19"/>
  <chapter number="20" style="c" sid="2KI 20"/>
  <para style="s1">ዹኩበ ህስቅያስ</para>
  <para style="r">
    <ref loc="2KI 20:1-11">20፥1‑11</ref> ኩወፈ – <char style="xt"><ref loc="2CH 32:24-26">2ሴና 32፥24‑26</ref>፤ <ref loc="ISA 38:1-8">እሳ 38፥1‑8</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 20:1"/>በረ ሰነ ኬሰ ህስቅያስ ዹኩብሰቴ ዱኡ ገኤ ቱሬ። እሳያስ እልም አሞስ ራጅች ገረሳ ዸቄ፣ “<char style="nd">ዋቀዮ</char> አከነ ጄዸ፤ ‘መነኬ ቶቶልፈዹ፤ አት ንዱተ መሌ ህንፈይቱቲ’ ” ጄዼን።<verse eid="2KI 20:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 20:2"/>ህስቅያስስ ፉለሳ ገረ ኬኘን መናት ገረገልፈቴ አከነ ጄዼ <char style="nd">ዋቀዮን</char> ከዸቴ፤ <verse eid="2KI 20:2"/><verse number="3" style="v" sid="2KI 20:3"/>“ያ <char style="nd">ዋቀዮ</char>፣ አከ አን አመነሙማፊ ገራ ቶኮን ፉለኬ ዱረ ጅራዼ ዋን ፉለኬ ዱረት ጋሪ ተኤስ ሆጄዼ ያደዹ።” ህስቅያስስ ህቅፈቴ ንቦኤ።<verse eid="2KI 20:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 20:4"/>ኡቱ እሳያስ ኦብዲ ገረ ግዱ ጅሩ ሰነ ኬሳ ህንበእን ዱቢን <char style="nd">ዋቀዮ</char> አከነ ጄዼ ገረሳ ዹፌ፤ <verse eid="2KI 20:4"/><verse number="5" style="v" sid="2KI 20:5"/>“ዴብኢ ዸቂቲ አከነ ጄዺ ህስቅያስ ሆገና ሰበኮቲት ህም፤ ‘<char style="nd">ዋቀዮ</char> ዋቅን አባኬ ዳዊት አከነ ጄዸ፦ አን ከዸትናኬ ዸገኤረ፤ እምማንኬስ አርጌረ፤ አን ስን ፈይሰ። አት አማ ጀልቀብዴ ጉያ ሰደፋት ገረ መነ ቁልቁሉማ <char style="nd">ዋቀዮት</char> ኦል ባተ። <verse eid="2KI 20:5"/><verse number="6" style="v" sid="2KI 20:6"/>አን ኡሙሪኬረት ወጋ ኩዸ ሸን ሲፈን ደበለ። አን ስኢፊ መጋላ ከነ ሀርከ ሞትቸ አሶሪቲ ነንባሰ። አን ሰበቢኮቲፊ ሰበቢ ገርብቸኮ ዳዊቲፍ ጄዼ መጋላ ከነ ነንኤገ።’ ”<verse eid="2KI 20:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 20:7"/>ከነረት እሳያስ፣ “መጥኖ ሀርቡ ቶልቻ” ጄዼ። እሳንስ ቆጴሰኒ ዹላሳረ ካአኒፍ፤ እንስ ንፈዬ።<verse eid="2KI 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 20:8"/>ህስቅያስስ፣ “አከ <char style="nd">ዋቀዮ</char> ነ ፈይሱፊ አከ አን ጉያ ሰደፋት ገረ መነ ቁልቁሉማ <char style="nd">ዋቀዮት</char> ኦል በኡፍ ማልቱ መለቶ ተአ?” ጄዼ እሳያስን ጋፈቴ።<verse eid="2KI 20:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 20:9"/>እሳያስስ አከነ ጄዼ ዴብሴ፤ “አከ <char style="nd">ዋቀዮ</char> ዋን ዋዳ ገሌ ሰነ ሆጄቱፍ መለቶን <char style="nd">ዋቀዮ</char> ሲፍ ኬኑ ኩኖ ከናዸ፤ ጋድዱን ቶኮ ተርካንፊ ኩዸን ገረ ፉለ ዱራት ሃዴሙሞ ዮካን ተርካንፊ ኩዸን ገረ ዱግደ ዱባት ሃዴብኡ?”<verse eid="2KI 20:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 20:10"/>ህስቅያስሞ፣ “ተርካንፊ ኩዸን ገረ ፉለ ዱራት ዴሙን ጋድዱ ቶኮፍ ዋን ሰልጳዸ፤ ቆደ ከና አከ ጋድዱን ሱን ተርካንፊ ኩዸን ገረ ዱግደ ዱባት ዴብኡ ጎዽ” ጄዼ።<verse eid="2KI 20:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 20:11"/>ከነረት እሳያስ ራጅች እዬ <char style="nd">ዋቀዮን</char> ንከዸቴ፤ <char style="nd">ዋቀዮስ</char> አከ ጋድዱን ሱን ተርካንፊ ኩዸን ጉለንታ ኣሃዝራ ገረ ፉለ ዱራት ዴሜ ቱሬ ሰነራ ተርካንፊ ኩዸን ገረ ዱግደ ዱባት ዴብኡ ጎዼ።<verse eid="2KI 20:11"/></para>
  <para style="s1">ኤርገሞተ ባብሎን ዹፈን</para>
  <para style="r">
    <ref loc="2KI 20:12-19">20፥12‑19</ref> ኩወፈ – <char style="xt"><ref loc="ISA 39:1-8">እሳ 39፥1‑8</ref></char></para>
  <para style="r">
    <ref loc="2KI 20:20-21">20፥20‑21</ref> ኩወፈ – <char style="xt"><ref loc="2CH 32:32-33">2ሴና 32፥32‑33</ref></char></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 20:12"/>ዬሮ ሰነት ሜሮደክ በለዳን እልም በለዳን ሞቲን ባብሎን ሰበቢ አከ ህስቅያስ ዹኩብሰቴ ዸገኤፍ ጠለዮታፊ ኬና ኤርጌፍ። <verse eid="2KI 20:12"/><verse number="13" style="v" sid="2KI 20:13"/>ህስቅያስስ ኤርገሞተ ሰነ ስመቴ ዋን መንኩሰሳ ኬሰ ቱሬ ሁንደ ጄቹንስ ሜቲ፣ ወርቄ፣ ኡርጎፍቱፊ ዘይቲ ቁልቁሉ አከሱመስ ኩሳ ምአ ሎላሳፊ ዋን መንኩሰሳ ኬሰት አርገሙ ሁንደ እሳንት አርግሲሴ። ወን ህስቅያስ መሰራ ሞቱማሳ ኬሳ ዮካን ሞቱማሳ ሁንደ ኬሳ እሳንት ህንአርግሲስን ቶኮዩ ህንቱሬ።<verse eid="2KI 20:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 20:14"/>ከነረት እሳያስ ራጅች ገረ ህስቅያስ ሞትቻ ዸቄ፣ “ነሞትን ሱን ማል ጄዸን? እሳን ኤሳ ዹፈን?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="2KI 20:14">ህስቅያስስ፣ “እሳን ባብሎኒ ብየ ፈጎዻ ዹፈን” ጄዼ ዴብሴ።<verse eid="2KI 20:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 20:15"/>ራጅች፣ “ጀር መሰራ ሞቱማኬቲ ኬሰት ማል አርገን?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="2KI 20:15">ህስቅያስሞ፣ “እሳን ዋን መሰራ ሞቱማኮ ኬሰ ጅሩ ሁንደ አርገን። ወን አን መንኩሰኮ ኬሳ እሳንት ህንአርግሲስን ቶኮዩ ህንጅሩ” ጄዼን።<verse eid="2KI 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 20:16"/>እሳያስስ ከነረት ህስቅያሲን አከነ ጄዼ፤ “ዱቢ <char style="nd">ዋቀዮ</char> ዸገእ፦ <verse eid="2KI 20:16"/><verse number="17" style="v" sid="2KI 20:17"/>ዬሮን እት ወን መሰራ ሞቱማኬቲ ኬሰ ጅሩ ሁንዲፊ ወን አቦቲንኬ ሀመ ሀርኣት ኩሰን ሁንድኑ ሳመሜ ገረ ባብሎንት ጌፈሙ ቶኮ ዹጉማን ንዹፈ። ወን ቶኮዩ ህንሀፉ፣ ጄዸ <char style="nd">ዋቀዮ</char>። <verse eid="2KI 20:17"/><verse number="18" style="v" sid="2KI 20:18"/>ሰኚኬ ኬሳ ነሞትን ቶኮ ቶኮ፣ ፎኒፊ ዺግንኬ ከኔን ሲፍ ዸለተን ቦጅአመኒ መሰራ ሞቱማ ሞትቸ ባብሎን ኬሰት ጡኣሺወን ተኡ።”<verse eid="2KI 20:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 20:19"/>ህስቅያስስ፣ “ዱቢን <char style="nd">ዋቀዮ</char> ከን አት ዱበቴ ኩን ጋሪዸ” ጄዼ ዴብሴ። እን፣ “በረ ጅሬኘኮ ኬሰ ነጋፊ ተስገቢን ህንጅራቱ?” ጄዼ ያዴ ቱሬቲ።<verse eid="2KI 20:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 20:20"/>ወንቶትን በረ ሞቱማ ህስቅያስ ኬሰ ሆጄተመን ከኔን ብራ፣ ጀብንሳ ሁንዲፊ አክ እን እት ሀሮፊ ኡጁሞ እቲን ብሻን ሀርክሰኒ ገረ መጋላት ፍደን ሆጄቴስ ክታበ ሴና ሞቶተ ይሁዳ ኬሰት በሬፈመኒሩ ምቲ? <verse eid="2KI 20:20"/><verse number="21" style="v" sid="2KI 20:21"/>ህስቅያስስ አቦቲሳ ወጅን ቦቆቴ። እልምሳ ምናሴን እዶሳ ቡኤ ሞቲ ተኤ።<verse eid="2KI 20:21"/></para>
  <chapter eid="2KI 20"/>
  <chapter number="21" style="c" sid="2KI 21"/>
  <para style="s1">ምናሴ ሞትቸ ይሁዳ</para>
  <para style="r">
    <ref loc="2KI 21:1-10">21፥1‑10</ref> ኩወፈ – <char style="xt"><ref loc="2CH 33:1-10">2ሴና 33፥1‑10</ref></char></para>
  <para style="r">
    <ref loc="2KI 21:17-18">21፥17‑18</ref> ኩወፈ – <char style="xt"><ref loc="2CH 33:18-20">2ሴና 33፥18‑20</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 21:1"/>ምናሴን ዬሮ ሞቲ ተኤት ነመ ወጋ ኩዸ ለመ ቱሬ፤ እንስ ዬሩሳሌም ኬሰ ታኤ ወጋ ሸንተሚ ሸን ቡልቼ። መቃን ሃዸሳ ሄፍዚባ ቱሬ። <verse eid="2KI 21:1"/><verse number="2" style="v" sid="2KI 21:2"/>እንስ ዋን ጅብሲሳ ሰቦተ <char style="nd">ዋቀዮ</char> ፉለ እስራኤሎታ ዱራ አርኤ ባሴ ሰና ዱካ ቡኡዻን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዋን ሀማ ሆጄቴ። <verse eid="2KI 21:2"/><verse number="3" style="v" sid="2KI 21:3"/>እን እዶወን ሰገዳ ከኔን አባንሳ ህስቅያስ ዲጌ ቱሬ ሰነሌ ዴብሴ ንእጃሬ፤ አከሱመስ አኩመ አሃብ ሞትች እስራኤል ጎዼ ሰነ በኣሊፍ እዶወን ኣርሳ ቶልቼ ሲዳ ኣሼራስ ንዻቤ። ራያወን ሰሚ ሁንዳፍስ ንሰገዴ፤ እሳን ዋቄፈቴስ። <verse eid="2KI 21:3"/><verse number="4" style="v" sid="2KI 21:4"/>እንስ መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ከን <char style="nd">ዋቀዮ</char>፣ “አን መቃኮ ዬሩሳሌም ኬሰ ነንዻበ” ጄዼ ዋኤሳ ዱበቴ ሰነ ኬሰት እዶወን ኣርሳ ቶልቼ። <verse eid="2KI 21:4"/><verse number="5" style="v" sid="2KI 21:5"/>ኦብዲወን መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ለማኑ ኬሰትስ ራያወን ሰሚ ሁንዳፍ እዶወን ኣርሳ ንቶልቼ። <verse eid="2KI 21:5"/><verse number="6" style="v" sid="2KI 21:6"/>እን እልመ ኦፊሳ እብዳን ኣርሳ ጎዼ ዽኤሴ፤ ቶልቸ ሆጄቴ፣ ምልኪ እላለቴ፣ እላልቶታፊ ኤኬር ዱብስቶተ ጎርሰ ጋፈቴ። እን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ሀምነ ጉዳ ንሆጄቴ አከሲን ዼከምሳፍ እሰ ከካሴ።<verse eid="2KI 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 21:7"/>እንስ ፈኪ አሼራ ከን ሶፌ ሆጄቴ ሰነ ፉዼ መነ ቁልቁሉማ ከን <char style="nd">ዋቀዮ</char> አከነ ጄዼ ዋኤሳ ዳዊቲፊ እልመሳ ሶሎሞኒ ዱበቴ ቱሬ ሰነ ኬሰ ካኤ፤ “መነ ቁልቁሉማ ከነ ኬሳፊ ዬሩሳሌም እሼ አን ጎሶተ እስራኤል ሁንደ ኬሳ ፍለዼ ሰነ ኬሰ መቃኮ በረ በራን ነንዻበ። <verse eid="2KI 21:7"/><verse number="8" style="v" sid="2KI 21:8"/>ዮ እሳን ዋን አን እሳን አጀጄ ሁንደ ሆጄተኒ ሴረ ገርብችኮ ሙሴን እሳኒፍ ኬኔ ጉቱ ኤገን፣ አን ስአች አከ ሚል እስራኤሎታ ብየ አን አቦቲሳኒቲፍ ኬኔ ኬሳ በኤ ጆሩ ህንጎዹ።” <verse eid="2KI 21:8"/><verse number="9" style="v" sid="2KI 21:9"/>ነሞትን ገሩ ህንዸጌፈትኔ። ምናሴን ከራራ እሳን ጀልእሴ፤ ከናፉ እሳን ሰቦተ <char style="nd">ዋቀዮ</char> ፉለ እስራኤሎታ ዱራ በሌሴ ሰነ ጫላ ሀምነ ሆጄተን።<verse eid="2KI 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 21:10"/>
    <char style="nd">ዋቀዮ</char> ከራ ገርቦተሳ ራጆታቲን አከነ ጄዼ ዱበቴ፤ <verse eid="2KI 21:10"/><verse number="11" style="v" sid="2KI 21:11"/>“ምናሴን ሞትች ይሁዳ ጩቡ ጅብሲሳ ከኔን ሆጄቴረ። እንስ አሞሮተ እሳን ዱረ ጅራተን ጫላ ዋን ሀማ ሆጄቴ፤ ዋቆተ ቶልፈሞሳቲንስ ይሁዳ ጩቡ ሆጄቺሴ። <verse eid="2KI 21:11"/><verse number="12" style="v" sid="2KI 21:12"/>ከናፉ <char style="nd">ዋቀዮ</char> ዋቅን እስራኤል አከነ ጄዸ፦ አን ዋን ሀማ ነመ እሰ ዸገኡ ሁንደ ሱከኔሱ ቶኮ ዬሩሳሌሚፊ ይሁዳት ነንፍደ። <verse eid="2KI 21:12"/><verse number="13" style="v" sid="2KI 21:13"/>አን ፉኞ ሰማርያቲፊ ቱምቢ መነ አሃብ ሰነ ዬሩሳሌምረት ነንድሪርሰ። አኩመ ነምን ጫቢ ሀጣኤ ገድ ጎምብሱት አን ዬሩሳሌምን ሀጣኤ ነንጎምብሰ። <verse eid="2KI 21:13"/><verse number="14" style="v" sid="2KI 21:14"/>አን ሀምባ ዻለኮ ዺሴ ሀርከ ዲኖተሳኒት ደበርሴ ነንኬነ። እሳንስ ዲኖተሳኒ ሁንዳን ንሳመሙ፤ ንቦጅአሙስ። <verse eid="2KI 21:14"/><verse number="15" style="v" sid="2KI 21:15"/>እሳን ጋፈ አቦቲንሳኒ ግብጢ በአኒ ጀልቀቤ ሀመ ሀርኣት ፉለኮ ዱረት ዋን ሀማ ሆጄቹዻን ዼከምሳፍ ነ ከካሰኒሩቲ።”<verse eid="2KI 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 21:16"/>ከነ ጫላስ ምናሴን አከ ወር ይሁዳ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዋን ሀማ ሆጄተን ጎዼ ጩቡ እሳን ሆጄቺሱሳረዩ ዺገ ነሞተ በሌሳ ህንቀብኔ ባይኤ ዸንገላሴ አከ ዬሩሳሌም ዳንጋ ቶኮ ሀመ ዳንጋ ካኒት ዺጋን ጉተምቱ ጎዼረ።<verse eid="2KI 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 21:17"/>ወንቶትን በረ ሞቱማ ምናሴ ኬሰ ሆጄተመን ከኔን ብራ፣ ወን እን ሆጄቴ ሁንድ፣ ጩቡ እን ሆጄቴ ደበለቴ ሴና ሞቶተ ይሁዳ ኬሰት በሬፈመኒሩ ምቲ? <verse eid="2KI 21:17"/><verse number="18" style="v" sid="2KI 21:18"/>ምናሴን አቦቲሳ ወጅን ቦቆቴ እዶ ብቅልቱ መሰራ ሞቱማሳ ኬሰት፣ እዶ ብቅልቱ ኡዛ ኬሰት ንአዋለሜ። እልምሳ ኣሞንስ እዶሳ ቡኤ ሞቲ ተኤ።<verse eid="2KI 21:18"/></para>
  <para style="s1">ኣሞን ሞትቸ ይሁዳ</para>
  <para style="r">
    <ref loc="2KI 21:19-24">21፥19‑24</ref> ኩወፈ – <char style="xt"><ref loc="2CH 33:21-25">2ሴና 33፥21‑25</ref></char></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 21:19"/>ኣሞን ዬሮ ሞቲ ተኤት ኡሙሪንሳ ወጋ ድግደሚ ለመ ቱሬ፤ እንስ ዬሩሳሌም ኬሰ ታኤ ወጋ ለመ ቡልቼ። መቃን ሃዸሳ ሜሹሌሜት ቱሬ፤ እሼንስ እንተለ ሃሩስ ነመ ብየ ዮጥባ ቱርቴ። <verse eid="2KI 21:19"/><verse number="20" style="v" sid="2KI 21:20"/>እንስ አኩመ አባንሳ ምናሴን ሆጄቴ ቱሬ ሰነ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዋን ሀማ ሆጄቴ። <verse eid="2KI 21:20"/><verse number="21" style="v" sid="2KI 21:21"/>እንስ ከራ አባሳ ሁንደረ ዴሜ፤ ዋቆተ ቶልፈሞ አባንሳ ዋቄፈቴሌ ዋቄፈቴ እሳኒፍስ ሰገዴ። <verse eid="2KI 21:21"/><verse number="22" style="v" sid="2KI 21:22"/>እን <char style="nd">ዋቀዮ</char> ዋቀ አቦቲሳ ዺሴ፤ ከራ <char style="nd">ዋቀዮረስ</char> ህንዴምኔ።<verse eid="2KI 21:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 21:23"/>ቆንዳልቶትን ኣሞን እሰት መርአተኒ መሰሩመ ሞቱማሳ ኬሰት ሞትቸ ንአጄሰን። <verse eid="2KI 21:23"/><verse number="24" style="v" sid="2KI 21:24"/>ከነረት ነሞትን ብየ ሰና ወረ ኣሞን ሞትቸት መለተን ሁንደ ፍጠኒ እልመሳ ዮስያስንሞ እዶሳ ሞቲ ጎዸተን።<verse eid="2KI 21:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 21:25"/>ወን በረ ሞቱማ ኣሞን ኬሰ ሆጄተሜ ከን ብራ፣ ወን እን ሆጄቴስ ክታበ ሴና ሞቶተ ይሁዳ ኬሰት በሬፈሜረ ምቲ? <verse eid="2KI 21:25"/><verse number="26" style="v" sid="2KI 21:26"/>እንስ አዋለሳ ከን እዶ ብቅልቱ ኡዛ ኬሰት ንአዋለሜ። እልምሳ ዮስያስስ እዶሳ ቡኤ ሞቲ ተኤ።<verse eid="2KI 21:26"/></para>
  <chapter eid="2KI 21"/>
  <chapter number="22" style="c" sid="2KI 22"/>
  <para style="s1">ክታብን ሴራ አርገሜ</para>
  <para style="r">
    <ref loc="2KI 22:1-20">22፥1‑20</ref> ኩወፈ – <char style="xt"><ref loc="2CH 34:1-2">2ሴና 34፥1‑2</ref>፣<ref loc="2CH 34:8-28">8‑28</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 22:1"/>ዮስያስ ዬሮ ሞቲ ተኤት ነመ ወጋ ሰዴቲ ቱሬ፤ ዬሩሳሌም ኬሰ ታኤስ ወጋ ሶዶሚ ቶኮ ቡልቼ። መቃን ሃዸሳ ዬዲዳዸ፤ እሼንስ እንተለ አዳያ ነመ ብየ ቦዝቃቲት። <verse eid="2KI 22:1"/><verse number="2" style="v" sid="2KI 22:2"/>እን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዋን ቀጄላ ንሆጄቴ፤ ኡቱ ምርገት ዮካን ብታት ህንጎርንስ ከራ አባሳ ዳዊትራ ዴሜ።<verse eid="2KI 22:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 22:3"/>ዮስያስ ሞትች በረ ሞቱማሳ ኬሰ ወጋ ኩዸ ሰዴተፋት አከነ ጄዼ ሻፋን እልመ አዘልያ እልመ ሜሹላም በሬሳ ሰነ ገረ መነ ቁልቁሉማ <char style="nd">ዋቀዮት</char> ኤርጌ፦ <verse eid="2KI 22:3"/><verse number="4" style="v" sid="2KI 22:4"/>“ገረ ህልቅያ ሉብቸ ኦል ኣናት ኦል በኢቲ አከ እን ማለቀ ገረ መነ ቁልቁሉማ <char style="nd">ዋቀዮት</char> ፍደሜ ከን ወር በልበለ ኤገን ነሞተራ ወልት ቀበን ሰነ ለካኡ ጎዽ። <verse eid="2KI 22:4"/><verse number="5" style="v" sid="2KI 22:5"/>ማለቅን ኩንስ ነሞተ አከ ሆጂ መነ ቁልቁሉማ ቶአተኒፍ ሙደመንት እማና ሃኬነሙ። ነሞትን ኩኔንሞ ወረ መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ሃሮምሰኒፍ ጄቹንስ፣ <verse eid="2KI 22:5"/><verse number="6" style="v" sid="2KI 22:6"/>ወረ ሙከ ሶፈኒፍ፣ ወረ መነ እጃረኒፊ ወረ ዸጋ ሶፈኒፍ ሃከፈለን። አከሱመስ መነ ቁልቁሉማ ሃሮምሱፍ ሙካፊ ዸጋ ሶፈሜ እቲን ሃብተን። <verse eid="2KI 22:6"/><verse number="7" style="v" sid="2KI 22:7"/>እሳን ገሩ ሰበቢ አመነሙማዻን ሆጄተኒፍ፣ ማለቀ እማና እሳንት ኬነሜ ሰነ ቶአቹን ህንበርባችሱ።”<verse eid="2KI 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 22:8"/>ህልቅያ ሉብች ኦል ኣናን ሱንስ፣ ሻፋን በሬሳ ሰናን፣ “አን መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ኬሰት ክታበ ሴራ አርጌን ጅረ” ጄዼ። ክታብቸስ ሻፋንት ኬኔ፤ ሻፋንሞ ክታበ ሰነ ንዱብሴ። <verse eid="2KI 22:8"/><verse number="9" style="v" sid="2KI 22:9"/>ኤርገሲስ ሻፋን ገረ ሞትቻ ዸቄ፣ “ቆንዳልቶትንኬ ማለቀ መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ኬሰ ቱሬ ባሰኒ ሆጄቶታፊ ነሞተ ሆጂ መነ ቁልቁሉማ ቶአተንት እማና ኬነኒሩ” ጄዼ ህሜ። <verse eid="2KI 22:9"/><verse number="10" style="v" sid="2KI 22:10"/>ሻፋን በሬሳን ሱን፣ “ህልቅያ ሉብች ክታበ ቶኮ ነት ኬኔረ” ጄዼ ሞትቸት ህሜ። ሻፋንስ ፉለ ሞትቻ ዱረት ክታበ ሰነ ዱብሴ።<verse eid="2KI 22:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 22:11"/>ሞትችስ ዱቢ ክታበ ሴራ ሰነ ዸጌኛን ኡፈተሳ ንተርሳሴ። <verse eid="2KI 22:11"/><verse number="12" style="v" sid="2KI 22:12"/>እንስ አጀጀ ከነ ህልቅያ ሉብቸት፣ አሂቃም እልመ ሻፋንት፣ አክቦር እልመ ሚካያት፣ ሻፋን በሬስቻፊ አሳያ ተጃጅላ ሞትቻት ንኬኔ፤ <verse eid="2KI 22:12"/><verse number="13" style="v" sid="2KI 22:13"/>“ዸቃቲ ዋኤ ዋን ክታበ አርገሜ ከነ ኬሰት በሬፈሜ አናፍ፣ ሰባፊ ይሁዳ ሁንዳፍ <char style="nd">ዋቀዮን</char> ጋፈዻ። ሰበቢ ወር ኑን ዱራ ዱቢ ክታባ ከናቲፍ ህንአጀጀምኒፍ ዼከምስ <char style="nd">ዋቀዮ</char> ጉዳን ኑት ቦበኤረ፤ እሳን አከ ዋን ዋኤኬኘ በሬፈሜ ሰነ ሁንዳት ህንጅራትኔቲ።”<verse eid="2KI 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 22:14"/>ህልቅያ ሉብች፣ አሂቃም፣ አክቦር፣ ሻፋኒፊ አሳያን ሁልዳና ራጅቲ ጋፈቹ ዸቀን። ህልዳናን ኩን ኒቲ ሸሉም እልመ ትቅዋ፣ እልመ ሀርሃስ ከን ኤግዱ ኡፈታ ቱሬ ሰናት። እሼንስ ዬሩሳሌም ኬሰ ኣና ለመፋ ኬሰ ጅራት ቱርቴ።<verse eid="2KI 22:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 22:15"/>እሼንስ አከነ እሳኒን ጄቴ፤ “<char style="nd">ዋቀዮ</char> ዋቅን እስራኤል አከነ ጄዸ፦ ነምቸ ነት እስን ኤርጌ ሰነት አከነ ጄዻ ህማ። <verse eid="2KI 22:15"/><verse number="16" style="v" sid="2KI 22:16"/>‘<char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ አን አኩመ ዋን ክታበ ሞትች ይሁዳ ዱብሴ ሰነ ኬሰት በሬፈሜ ሁንዳት እዶ ከናፊ ሰበሳት በዲሰ ነንፍደ። <verse eid="2KI 22:16"/><verse number="17" style="v" sid="2KI 22:17"/>ሰበቢ እሳን ነ ዺሰኒ ዋቆተ ብራቲፍ እጣነ ኣርሱዻን ዋቆተ ቶልፈሞ ሀርክሳኒ ቶልቼ ሁንዳን ዼከምሳፍ ነ ከካሰኒፍ፣ ዼከምስኮ እዶ ከነረት ንቦበአ፤ ህንዻሙስ።’ <verse eid="2KI 22:17"/><verse number="18" style="v" sid="2KI 22:18"/>ሞቲ ይሁዳ ከን አከ እስን <char style="nd">ዋቀዮን</char> ጋፈተኒፍ እስን ኤርጌ ሰነት አከነ ጄዻቲ ህማ፤ ‘ዋኤ ዱቢ አት ዸጌሴ ሰና፣ <char style="nd">ዋቀዮ</char> ዋቅን እስራኤል አከነ ጄዸ፤ <verse eid="2KI 22:18"/><verse number="19" style="v" sid="2KI 22:19"/>“ሰበቢ አት ዬሮ ዋን አን ዋኤ እዶ ከናቲፊ ዋኤ ሰበሳ አከ እሳን አባረመኒ በርበዴፈመን ዋን ሀማ ዱበዼ ዸጌሴት ገራንኬ ቱቀሜ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ገድ ኦፍ ቀብዴፍ፣ ሰበቢ ኡፈተኬ ተርሳፍቴ ፉለኮ ዱረት ቦሴፍ፣ አን ስ ዸገኤረ” ጄዸ <char style="nd">ዋቀዮ</char>። <verse eid="2KI 22:19"/><verse number="20" style="v" sid="2KI 22:20"/>ከናፉ አን አቦቲኬ ብረት ወልትን ስ ቀበ፤ አትስ ነጉማን አዋለምተ። ዋን ሀማ አን እዶ ከነረት ፍዱፍ ጅሩ ሁንደ እጅኬ ህንአርጉ።’ ”</para>
  <para style="p" vid="2KI 22:20">እሳንስ ዴቢሼ ፉዸተኒ ገረ ሞትቻት ዴብአን።<verse eid="2KI 22:20"/></para>
  <chapter eid="2KI 22"/>
  <chapter number="23" style="c" sid="2KI 23"/>
  <para style="s1">ዮስያስ ከኩ ሃሮምሱሳ</para>
  <para style="r">
    <ref loc="2KI 23:1-3">23፥1‑3</ref> ኩወፈ – <char style="xt"><ref loc="2CH 34:29-32">2ሴና 34፥29‑32</ref></char></para>
  <para style="r">
    <ref loc="2KI 23:4-20">23፥4‑20</ref> ኩወእ – <char style="xt"><ref loc="2CH 34:3-7">2ሴና 34፥3‑7</ref>፣<ref loc="2CH 34:33">33</ref></char></para>
  <para style="r">
    <ref loc="2KI 23:21-23">23፥21‑23</ref> ኩወፈ – <char style="xt"><ref loc="2CH 35:1">2ሴና 35፥1</ref>፣<ref loc="2CH 35:18-19">18‑19</ref></char></para>
  <para style="r">
    <ref loc="2KI 23:28-30">23፥28‑30</ref> ኩወፈ – <char style="xt"><ref loc="2CH 35:20-36:1">2ሴና 35፥20–36፥1</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 23:1"/>ኤርገሲስ ሞትች ማንጉዶተ ይሁዳፊ ዬሩሳሌም ሁንደ ወልት ንዋሜ። <verse eid="2KI 23:1"/><verse number="2" style="v" sid="2KI 23:2"/>እንስ ነሞተ ይሁዳ፣ ጅራቶተ ዬሩሳሌም፣ ሉቦታፊ ራጆተ ወጅን ጄቹንስ ነመ ጥናፊ ጉዳ ሁንደ ወጅን ገረ መነ ቁልቁሉማ <char style="nd">ዋቀዮት</char> ኦል በኤ። ዱቢ ክታበ ከኩ ከን መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ኬሰት አርገሜ ሰና ሁንደስ አከ እሳን ዸገአንት ዱብሴፍ። <verse eid="2KI 23:2"/><verse number="3" style="v" sid="2KI 23:3"/>ሞትችስ ኡቱባ ብረ ዻበቴ አከ <char style="nd">ዋቀዮን</char> ዱካ ቡኡ፣ አከ ገራሳ ጉቱፊ ሉቡሳ ጉቱዻን አጀጀሳ፣ ደምቢወንሳቲፊ ለብሲወንሳ ኤጌ አከሲን ዱቢወን ከኩ ከኔን ክታበ ከነ ኬሰት በሬፈመን ሆጂረ ኦልቹ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ከኩ ንሃሮምሴ፤ ኤርገሲስ ሰብን ሁንድ ከኩ ንሃሮምሴ።<verse eid="2KI 23:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 23:4"/>ሞትችስ አከ እሳን ምኦተ በኣሊፍ፣ አሼራዻፊ ራያወን ሰሚቲፍ ሆጄተመን ሁንደ መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ኬሳ ባሰኒፍ ህልቅያ ሉብቸ ኦል ኣና፣ ሉቦተ ሰደርካን እሰት ኣነኒፊ ኤግዶተ በልበላ አጀጄ። እንስ ምኦተ ሰነ ዬሩሳሌም ኬሳ ባሴ ድሬ ሱሉለ ቄድሮንረት ጉቤ፤ ዳራሳስ ፉዼ ቤትኤልት ጌሴ። <verse eid="2KI 23:4"/><verse number="5" style="v" sid="2KI 23:5"/>ሉቦተ ዋቆተ ቶልፈሞ ከኔን አከ እሳን እዶወን ሰገዳ ከኔን መጋላወን ይሁዳቲፊ ናኖ ዬሩሳሌም ከኔን ጋረን እራቲፍ እጣነ ኣርሰኒፍ ሞቶትን ይሁዳ ሙደን ሰነ ጄቹንስ ወረ በኣሊፍ፣ አዱፊ ጅኣፍ፣ ቱተ ኡርጂቲፊ ራያወን ሰሚ ሁንዳፍ እጣነ ኣርሳ ቱረንስ ንበርበዴሴ። <verse eid="2KI 23:5"/><verse number="6" style="v" sid="2KI 23:6"/>ሲዳ ኣሼራስ መነ ቁልቁሉማ <char style="nd">ዋቀዮቲ</char> ፉዼ ዬሩሳሌም ኬሳ ባሴ ሱሉለ ቄድሮንት ጌሴ አችት ንጉቤ። እሰስ ዳኬ ቡሌሴ ዳራሳ አዋለ ነሞታረት ፍርፍርሴ። <verse eid="2KI 23:6"/><verse number="7" style="v" sid="2KI 23:7"/>እንስ መነ ዺሮተ መነ ሰገዳ ኬሰት ሰጋገለኒ ከን መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ኬሰ ጅሩ፣ እዶ እት ዱበርቶትን አሼራዻፍ ጎልጋ ሆጄተን ሰነ ንዲጌ።<verse eid="2KI 23:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 23:8"/>ዮስያስስ ሉቦተ ሁንደ መጋላወን ይሁዳቲ ንፍዴ፤ እንስ እዶወን ሰገዳ ከኔን ጌባዻ ሀመ ቤርሼባት ቱረን ከኔን ሉቦትን እጣነ እት ኣርሳ ቱረን ሰነ ንጡሬሴ። አከሱመስ ገልመወን ዋቄፈትና ከረወን ጭና ከኔን በልበለ ከረ እያሱ ቡልቻ መጋላ ሰና ዱረ ከራ ገመ ብታ መጋለቲን ቱረን ሰነ ንዲጌ። <verse eid="2KI 23:8"/><verse number="9" style="v" sid="2KI 23:9"/>ሉቦትን እዶወን ሰገዳ ኩኔን ዮ እዶ ኣርሳ <char style="nd">ዋቀዮ</char> ከን ዬሩሳሌም ኬሳረ ተጃጅሉ ባተንሌ እሳን ሉቦተ አከሳኒ ወጅን መጥኖ ኛተን ቱሬ።<verse eid="2KI 23:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 23:10"/>እንስ አከ ነምን ቶኮዩ እልመሳ ዮካን እንተለሳ ኣርሳ ጎዼ እብዳን ሞሌኪፍ ህንዽኤስኔፍ ቶፌት ከን ሱሉለ ቤን ህኖም ኬሰት አርገሙ ሰነ ንጡሬሴ። <verse eid="2KI 23:10"/><verse number="11" style="v" sid="2KI 23:11"/>አከሱመስ ፈርዴን ሞቶትን ይሁዳ አዱዻፍ ኬነን ሰነ በልበለ መነ ቁልቁሉማ <char style="nd">ዋቀዮት</char> ጌሱራ ፉዼ ንበሌሴ። ፈርዴን ሱን ኦብዲ ኩታ መነ ናታን-ሜሌክ ቆንዳልትቻ ብራ ኬሰ ቱረን። ኤርገሲስ ዮስያስ ጋሪወን አዱ ሰነ እብዳን ንጉቤ።<verse eid="2KI 23:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 23:12"/>ሞትችስ እዶወን ኣርሳ ሞቶትን ይሁዳ በንቲ መናረ፣ ኩታ መነ ኣሃዝ ከን ኦል ኣኑ ብረ ዻበኒፊ እዶወን ኣርሳ ምናሴን መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ኬሰ ኦብዲወን ለማን ኬሰ ዻቤ ሰነ ንቡቅሴ። እዶወን ኣርሳ ሰነስ አቺ ፉዼ ንጨጨብሴ፣ ጨጨባሳኒ ሱሉለ ቄድሮን ኬሰት ንገቴ። <verse eid="2KI 23:12"/><verse number="13" style="v" sid="2KI 23:13"/>አከሱመስ ሞትች እዶወን ሰገዳ ከኔን ገመ በአ ዬሩሳሌምት ከራ ክበ ጋረ ፋለሙቲን ቱረን ከኔን ሶሎሞን ሞትች እስራኤል አሽቶሬት ዋቅቲ ጡሮፍቱ ሲዶኖታ፣ ኬሞሽ ዋቅቸ ጡራኣ ሞኣቢፊ ሞሌክ ዋቅቸ ጡራኣ እጆሌ አሞኒቲፍ ሆጄቴ ሰነ ንጡሬሴ። <verse eid="2KI 23:13"/><verse number="14" style="v" sid="2KI 23:14"/>ዮስያስ ሶዱወን ዸጋ ጨጨብሴ ሲዳወን ኣሼራስ ዲጌ እዶ ሰነ ለፌ ነማቲን ጉቴ።<verse eid="2KI 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 23:15"/>አከሱመስ እዶ ኣርሳ ቤትኤል ኬሰ ቱሬ ሰናፊ እዶ ሰገዳ ከን ዬሮብኣም እልም ኔባት እን እስራኤልን ጩቡ ሆጄቺሴ ሱን እጃሬ እዶ ኣርሳ ሰናፊ እዶ ሰገዳ ንዲጌ። እዶ ሰገዳ ሰነስ ጨጨብሴ፣ ዳኬ ቡሌሴ፤ ሲዳ ኣሼራስ ንጉቤ። <verse eid="2KI 23:15"/><verse number="16" style="v" sid="2KI 23:16"/>ዮስያስስ ኦፍረ ገረገሌ አዋለወን ቱሉረ ጅረን አችት አርጌ፤ ነመ ኤርጌስ አዋለወን ሰነ ኬሳ ለፌወን ፍችሲሴ አኩመ ዱቢ <char style="nd">ዋቀዮ</char> ከን ነምን ዋቃ እን ዱራን ዱርሴ ዋን ከነ ዱበቴ ሱን ለብሴት እዶ ኣርሳረት ጉቤ እሰ ጡሬሴ።<verse eid="2KI 23:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 23:17"/>ሞትች፣ “ዸጋን አዋላ ከን አን አርጉት ጅሩ ኩን ማል?” ጄዼ ንጋፈቴ።</para>
  <para style="p" vid="2KI 23:17">ነሞትን መጋላ ሰናሞ፣ “እን አዋለ ነመ ዋቃ ከን ይሁዳዻ ዹፌ ዋኑመ አት እዶ ኣርሳ ቤትኤል ጎቴ ከነ ዱራን ዱርሴ ለብሴ ሰናት” ጄዸን።<verse eid="2KI 23:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 23:18"/>እንስ፣ “እሳ ዺሳ፤ ነምን ቶኮዩ ለፌሳ ህንቱቅን” ጄዼ። ከናፉ እሳን ለፌ እሳቲፊ ለፌ ራጅቸ ሰማርያዻ ዹፌ ሰናሌ ንዺሰን።<verse eid="2KI 23:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 23:19"/>ዮስያስ አኩመ ቤትኤልት ጎዼ ሰነ እዶወን ሰገዳ ከኔን ጋረንራ ከኔን ሞቶትን እስራኤል መጋላወን ሰማርያ ኬሰት እጃረኒ <char style="nd">ዋቀዮን</char> ዼከምሳፍ ከካሰን ሰነ ሁንደ ንዲጌ። <verse eid="2KI 23:19"/><verse number="20" style="v" sid="2KI 23:20"/>እንስ ሉቦተ እዶወን ሰገዳ ከኔን ጋረንራ ሁንደ እዶወን ኣርሳረት ቀሌ ለፌ ነማስ አቹመረት ንጉቤ። ኤርገሲስ ገረ ዬሩሳሌምት ንዴብኤ።<verse eid="2KI 23:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 23:21"/>ሞትችስ፣ “አኩመ ክታበ ከኩ ከነ ኬሰት በሬፈሜ ሰነት <char style="nd">ዋቀዮ</char> ዋቀኬሰኒፍ ፋሲካ አያኔፈዻ” ጄዼ ሰበ ሁንደ አጀጄ። <verse eid="2KI 23:21"/><verse number="22" style="v" sid="2KI 23:22"/>በረ አቦቲ ሙርቲ ከኔን እስራኤልን ቡልቻ ቱረኒቲ ጀልቀቤ ዮካን በረ ሞቶተ እስራኤል ሁንደ ኬሰ ዮካን ይሁዳ ኬሰ ፋሲካን አከሲ ተኩማ አያኔፈሜ ህንቤኩ። <verse eid="2KI 23:22"/><verse number="23" style="v" sid="2KI 23:23"/>ገሩ በረ ዮስያስ ሞትቻ ኬሰ ወጋ ኩዸ ሰዴተፋት ፋሲካን ኩን ዬሩሳሌምት <char style="nd">ዋቀዮፍ</char> አያኔፈማ ቱሬ።<verse eid="2KI 23:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 23:24"/>ከነ መሌስ ዮስያስ እላልቶታፊ ኤኬር ዱብስቶተ፣ ተራፍሚ፣ ዋቆተ ቶልፈሞፊ ወንቶተ ጅብሲሶ ከኔን ይሁዳፊ ዬሩሳሌም ኬሰት አርገመን ብራ ሁንደ በሌሴ። እንስ ሴረ ክታበ ህልቅያ ሉብች መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ኬሰት አርጌ ሰነረት በሬፈሜ ሆጂረ ኦልቹዻፍ ዋን ከነ ጎዼ። <verse eid="2KI 23:24"/><verse number="25" style="v" sid="2KI 23:25"/>ሞቲን አከ ዮስያስ ከን አከ ሴረ ሙሴ ሁንዳት ገራሳ ጉቱዻን፣ ሉቡሳ ጉቱፊ ሁምነሳ ጉቱዻን ገረ <char style="nd">ዋቀዮት</char> ዴብኤ ቶኮዩ እሳን ዱረስ እሳን ዱበስ ህንአርገምኔ።<verse eid="2KI 23:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 23:26"/>ተኡስ ሰበቢ ምናሴን ዋን ሆጄቴ ሁንዳን ዼከምሳፍ እሰ ከካሴፍ <char style="nd">ዋቀዮ</char> ዼከምሰሳ ጉዳፊ ሶዳችሳ ይሁዳረት ቦበኤ ሰነራ ህንዴብኔ። <verse eid="2KI 23:26"/><verse number="27" style="v" sid="2KI 23:27"/>ከናፉ <char style="nd">ዋቀዮ</char>፣ “አን አኩመ እስራኤልን በሌሴ ሰነ ይሁዳስ ፉለኮ ዱራ ነንበሌሰ፤ ዬሩሳሌም መጋላ አን ፍለዼፍ መነ ቁልቁሉማ ከን አን፣ ‘መቃንኮ አች ጅራተ’ ጄዼ ዋኤሳ ዱበዼ ከነ ነንዺሰ” ጄዼ።<verse eid="2KI 23:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 23:28"/>ወን በረ ሞቱማ ዮስያስ ኬሰ ሆጄተሜ ከን ብራቲፊ ወን እን ሆጄቴ ሁንድ ክታበ ሴና ሞቶተ ይሁዳ ኬሰት በሬፈሜረ ምቲ?<verse eid="2KI 23:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 23:29"/>በረ ዮስያስ ሞቲ ቱሬት፣ ፈረኦን ኔኮን ሞትች ግብጥ ሞቲ አሶር ገርጋሩፍ ጄዼ ገረ ለገ ኤፍራጢስት ኦል በኤ። ዮስያስ ሞትችስ ኦፍራ እሰ እትሱዻፍ እት ገድ በኤ። ኔኮን ገሩ እሰት ዹፌ ሜግዶት እሰ አጄሴ። <verse eid="2KI 23:29"/><verse number="30" style="v" sid="2KI 23:30"/>ገርቦን ዮስያስስ ጋሪዻን ሜግዶዻ ገረ ዬሩሳሌምት ሬፈሳ ፍደኒ አዋለሳ ኬሰት እሰ አዋለን። ኤርገሲስ ሰብን ብየ ሰና ዬሆኣሃዝ እልመ ዮስያስ ፉዸኒ ድበኒ እዶ አባሳ ቡሰኒ ሞቲ እሰ ጎዸን።<verse eid="2KI 23:30"/></para>
  <para style="s1">ዮአክስ ሞትቸ ይሁዳ</para>
  <para style="r">
    <ref loc="2KI 23:31-34">23፥31‑34</ref> ኩወፈ – <char style="xt"><ref loc="2CH 36:2-4">2ሴና 36፥2‑4</ref></char></para>
  <para style="p">
    <verse number="31" style="v" sid="2KI 23:31"/>ዬሆኣሃዝስ ዬሮ ሞቲ ተኤት ኡሙሪንሳ ወጋ ድግደሚ ሰዲ ቱሬ፤ እንስ ዬሩሳሌም ኬሰ ታኤ ጅአ ሰዲ ቡልቼ። መቃን ሃዸሳ ሀሙታል ቱሬ፤ እሼንስ እንተለ ኤርምያስ ከን ልብናዻ ዹፍቴ ቱርቴ። <verse eid="2KI 23:31"/><verse number="32" style="v" sid="2KI 23:32"/>እንስ አኩመ አቦቲንሳ ሆጄተን ሰነ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዋን ሀማ ሆጄቴ። <verse eid="2KI 23:32"/><verse number="33" style="v" sid="2KI 23:33"/>አከ እን ዬሩሳሌም ኬሰ ታኤ ህንቡልችኔፍ ፈረኦን ኔኮን ሀማት ኬሰት ሪብላት ፎንጫን እሰ ህዼ ይሁዳረትስ ግብረ ሜቲ ታላንቲ<note caller="+" style="f"><char style="fr" closed="false">23፥33 </char><char style="ft" closed="false">ታላንቲን ቶኮ ኪሎ ግራሚ 34።</char></note> ዽበ ቶኮፊ ወርቄ ታላንቲ ቶኮ ሙሬ። <verse eid="2KI 23:33"/><verse number="34" style="v" sid="2KI 23:34"/>ፈረኦን ኔኮን ኤሊያቂም እልመ ዮስያስ ሞትቻ እዶ ዮስያስ እዶ አባሳ ቡሴ ሞቲ ጎዼ፤ መቃ ኤሊያቂምስ ጌደሬ ዬሆያቂም ጄዼን። ዬሆኣሃዝን ገሩ ፉዼ ግብጥት ጌሴ፤ እንስ አችት ዱኤ። <verse eid="2KI 23:34"/><verse number="35" style="v" sid="2KI 23:35"/>ዬሆያቂምስ ሜቲፊ ወርቄ ፈረኦን ኔኮን ጋፈቴ ሰነ ንባሴ። ዋን ከነ ባሱፍስ ግብረ ብየት ሙሬ ነሞተ ብየቲራ አኩመ ገሊሳኒት ሜቲፊ ወርቄ ወልት ቀቤ።<verse eid="2KI 23:35"/></para>
  <para style="s1">ዬሆያቂም ሞትቸ ይሁዳ</para>
  <para style="r">
    <ref loc="2KI 23:36-24:6">23፥36–24፥6</ref> ኩወፈ – <char style="xt"><ref loc="2CH 36:5-8">2ሴና 36፥5‑8</ref></char></para>
  <para style="p">
    <verse number="36" style="v" sid="2KI 23:36"/>ዬሆያቂም ዬሮ ሞቲ ተኤት ኡሙሪንሳ ወጋ ድግደሚ ሸን ቱሬ፤ እንስ ዬሩሳሌም ኬሰ ታኤ ወጋ ኩዸ ቶኮ ቡልቼ። መቃን ሃዸሳ ዜቡዳ ቱሬ፤ እሼንስ እንተለ ጴዳያ ከን መጋላ ሩማቲ ዹፍቴ ቱርቴ። <verse eid="2KI 23:36"/><verse number="37" style="v" sid="2KI 23:37"/>እንስ አኩመ አቦቲንሳ ሆጄተን ሰነ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዋን ሀማ ሆጄቴ።<verse eid="2KI 23:37"/></para>
  <chapter eid="2KI 23"/>
  <chapter number="24" style="c" sid="2KI 24"/>
  <para style="p">
    <verse number="1" style="v" sid="2KI 24:1"/>በረ ሞቱማ ዬሆያቂም ኬሰ ኔቡከድኔዘር ሞትች ባብሎን ብየ ሰነ ንዌረሬ፤ ዬሆያቂምስ ወጋ ሰዲ እሳፍ ገርቦሜ። ኤርገሲ ገሩ ያደ ጌደረቴ ኔቡከድኔዘርት ፍንጭሌ። <verse eid="2KI 24:1"/><verse number="2" style="v" sid="2KI 24:2"/><char style="nd">ዋቀዮስ</char> ሳምቶተ ባብሎን፣ ሳምቶተ ሶርያ፣ ሳምቶተ ሞኣቢፊ ሳምቶተ አሞን እሰት ኤርጌ። እንስ አኩመ ዱቢ <char style="nd">ዋቀዮ</char> ከን ገርቦንሳ ራጆትን ዱበተን ሰናት ይሁዳ በሌሱዻፍ እሳን ኤርጌ። <verse eid="2KI 24:2"/><verse number="3" style="v" sid="2KI 24:3"/>ዹጉማን ወን ኩን ሰበቢ ጩቡ ምናሴቲፊ ዋን እን ሆጄቴ ሁንዳቲፍ ፉለሳ ዱራ እሳን በሌሱዻፍ አኩመ አጀጀ <char style="nd">ዋቀዮት</char> ይሁዳት ዹፌ፤ <verse eid="2KI 24:3"/><verse number="4" style="v" sid="2KI 24:4"/>አከሱመስ ሰበቢ እን ዺገ ነሞተ የከ ህንቀብኔ ዸንገላሴፊ ሰበቢ እን ዺገ ነሞተ የከ ህንቀብኔቲን ዬሩሳሌምን ጉቴፍ <char style="nd">ዋቀዮ</char> ዺሱፊ ህንበርባድኔ።<verse eid="2KI 24:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 24:5"/>ወንቶትን በረ ሞቱማ ዬሆያቂም ኬሰ ሆጄተመን ከኔን ብራቲፊ ወን እን ሆጄቴ ሁንድ ክታበ ሴና ሞቶተ ይሁዳ ኬሰት በሬፈመኒሩ ምቲ? <verse eid="2KI 24:5"/><verse number="6" style="v" sid="2KI 24:6"/>ዬሆያቂም አቦቲሳ ወጅን ንቦቆቴ። እልምሳ ዬሆያኪን እዶሳ ቡኤ ሞቲ ተኤ።<verse eid="2KI 24:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 24:7"/>ሰበቢ ሞትች ባብሎን ብየሳ ሁንደ፣ መልካ ግብጢ ጀልቀቤ ሀመ ለገ ኤፍራጢስት ቀበቴፍ ሞቲን ግብጥ ለመተ ዱላፍ ብየሳቲ ህንባኔ።<verse eid="2KI 24:7"/></para>
  <para style="s1">ዬሆያኪን ሞትቸ ይሁዳ</para>
  <para style="r">
    <ref loc="2KI 24:8-17">24፥8‑17</ref> ኩወፈ – <char style="xt"><ref loc="2CH 36:9-10">2ሴና 36፥9‑10</ref></char></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 24:8"/>ዬሆያኪን ዬሮ ሞቲ ተኤት ኡሙሪንሳ ወጋ ኩዸ ሰዴት ቱሬ፤ እንስ ዬሩሳሌም ኬሰ ታኤ ጅአ ሰዲ ቡልቼ። መቃን ሃዸሳ ኔሁሽታ ቱሬ፤ እሼንስ እንተለ ኤልናታን ነምቸ ዬሩሳሌም ሰናት። <verse eid="2KI 24:8"/><verse number="9" style="v" sid="2KI 24:9"/>እንስ አኩመ አባንሳ ሆጄቴ ሰነ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዋን ሀማ ሆጄቴ።<verse eid="2KI 24:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 24:10"/>ዬሩመ ሰነት ሎልቶትን ኔቡከድኔዘር ሞትቸ ባብሎን ዬሩሳሌምት ዱለኒ እሼ ንመርሰን፤ <verse eid="2KI 24:10"/><verse number="11" style="v" sid="2KI 24:11"/>ኡቱመ አጀጆትን ሎልቶተሳ እሼ መርሳ ጅረኑ ኔቡከድኔዘር መታንሳ ገረ መጋለቲ ንዹፌ። <verse eid="2KI 24:11"/><verse number="12" style="v" sid="2KI 24:12"/>ዬሆያኪን ሞትች ይሁዳ፣ ሃትሳ፣ ገርቦንሳ፣ ነሞትንሳ ቤቤከሞኒፊ ቆንዳልቶትንሳ ሁንድኑ ሞቲ ባብሎንት ሀርከ ኬነተን።</para>
  <para style="p" vid="2KI 24:12">ሞቲን ባብሎንስ ሞኤ ወጋ ሰዴተፋት ዬሆያኪንን ቦጅኤ ንፉዸቴ። <verse eid="2KI 24:12"/><verse number="13" style="v" sid="2KI 24:13"/>ኔቡከድኔዘርስ አኩመ <char style="nd">ዋቀዮ</char> ዱበቴ ቱሬ ሰነት ቀቤኘ መነ ቁልቁሉማ <char style="nd">ዋቀዮቲፊ</char> ከን መሰራ ሞቱማ ኬሰ ቱሬ ሁንደ ንፉዸቴ፤ ምአ ወርቄ ከን ሶሎሞን ሞትች እስራኤል መነ ቁልቁሉማ <char style="nd">ዋቀዮቲፍ</char> ቶልቼ ሁንደሳሞ ጨጨብሴ። <verse eid="2KI 24:13"/><verse number="14" style="v" sid="2KI 24:14"/>እን ወረ ዬሩሳሌም ኬሰ ጅራተን ሁንደ አጀጆተ ወራናቲፊ ሎልቶተ ሁንደ፣ ወረ ኦጉማ ሆጂ ሀርካ ቀበኒፊ ወረ ስቢለ ቱመን ሁንደ ወሉመት ነመ ኩመ ኩዸን ቦጅኤ ንፉዸቴ። ነሞተ አከ መሌ ህዬዪ ቆፈቱ ብየ ሰነት ሀፌ።<verse eid="2KI 24:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 24:15"/>ኔቡከድኔዘር ዬሆያኪንን ቦጅኤ ባብሎንት ንጌሴ። አከሱመስ ሃዸ ሞትቻ፣ ኒቶተሳ፣ ቆንዳልቶተሳቲፊ ነሞተ ብየ ሰና ቤቤከሞ ቦጅኤ ዬሩሳሌሚ ገረ ባብሎንት ንጌሴ። <verse eid="2KI 24:15"/><verse number="16" style="v" sid="2KI 24:16"/>ከነ መሌስ ሞትች ባብሎን ሁምነ ወራና ጉቱ ከን ነመ ኩመ ቶርበ ኦፍ ኬሳ ቀቡ፣ ወረ ኦጉማ ሆጂ ሀርካ ቀበኒፊ ወረ ስቢለ ቱመን ኩመ ቶኮ ቦጅኤ ባብሎንት ንጌሴ፤ እሳን ኩኔን ሁንድ ጀጀቦፊ ወረ ሎለ ደንደአን ቱረን። <verse eid="2KI 24:16"/><verse number="17" style="v" sid="2KI 24:17"/>እንስ መታንያ ኤሱመ ዬሆያኪን ሰነ እዶሳ ሞቲ ጎዼ፤ መቃሳስ ዜዴቅያት ንጌደሬ።<verse eid="2KI 24:17"/></para>
  <para style="s1">ዜዴቅያ ሞትቸ ይሁዳ</para>
  <para style="r">
    <ref loc="2KI 24:18-20">24፥18‑20</ref> ኩወፈ – <char style="xt"><ref loc="2CH 36:11-16">2ሴና 36፥11‑16</ref>፤ <ref loc="JER 52:1-3">ኤር 52፥1‑3</ref></char></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 24:18"/>ዜዴቅያ ዬሮ ሞቲ ተኤት ኡሙሪንሳ ወጋ ድግደሚ ቶኮ ቱሬ፤ እንስ ዬሩሳሌም ኬሰ ታኤ ወጋ ኩዸ ቶኮ ቡልቼ። መቃን ሃዸሳ ሀሙታል ቱሬ፤ እሼንስ እንተለ ኤርምያስ ከን መጋላ ልብናቲ ዹፍቴ ቱርቴ። <verse eid="2KI 24:18"/><verse number="19" style="v" sid="2KI 24:19"/>እንስ አኩመ ዬሆያቂም ሆጄቴ ሰነ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዋን ሀማ ንሆጄቴ። <verse eid="2KI 24:19"/><verse number="20" style="v" sid="2KI 24:20"/>ወን ኩን ሁንድ ሰበቢ ዼከምሰ <char style="nd">ዋቀዮቲፍ</char> ዬሩሳሌሚፊ ይሁዳረ ገኤ፤ ዹመረትስ እን ፉለሳ ዱራ እሳን በሌሴ።</para>
  <para style="s1" vid="2KI 24:20">ኩፋቲ ዬሩሳሌም</para>
  <para style="r" vid="2KI 24:20">
    <ref loc="2KI 25:1-12">25፥1‑12</ref> ኩወፈ – <char style="xt"><ref loc="JER 39:1-10">ኤር 39፥1‑10</ref></char></para>
  <para style="r" vid="2KI 24:20">
    <ref loc="2KI 25:1-21">25፥1‑21</ref> ኩወፈ – <char style="xt"><ref loc="2CH 36:17-20">2ሴና 36፥17‑20</ref>፤ <ref loc="JER 52:4-27">ኤር 52፥4‑27</ref></char></para>
  <para style="r" vid="2KI 24:20">
    <ref loc="2KI 25:22-26">25፥22‑26</ref> ኩወፈ – <char style="xt"><ref loc="JER 40:7-9">ኤር 40፥7‑9</ref>፤ <ref loc="JER 41:1-3">41፥1‑3</ref>፣<ref loc="JER 41:16-18">16‑18</ref></char></para>
  <para style="p" vid="2KI 24:20">ዜዴቅያ ሞትቸ ባብሎንት ፍንጭሌ።<verse eid="2KI 24:20"/></para>
  <chapter eid="2KI 24"/>
  <chapter number="25" style="c" sid="2KI 25"/>
  <para style="p">
    <verse number="1" style="v" sid="2KI 25:1"/>ከናፉ በረ ሞቱማ ዜዴቅያ ኬሰ ወጋ ሰግለፋት፣ ቡልቲ ኩርነፋ ጅአ ኩርነፋት፣ ኔቡከድኔዘር ሞቲን ባብሎን ጉቱማ ሎልቶተሳ ወጅን ዬሩሳሌምት ዱሌ። እንስ መጋለቲን አለ ቁበቴ ናኖሼ ሁንደት ቱላ ብዮ መርሴ። <verse eid="2KI 25:1"/><verse number="2" style="v" sid="2KI 25:2"/>መጋላን ሱንስ ሀመ ወጋ ኩዸ ቶኮፋ በረ ዜዴቅያ ሞትቻት አኩመ መርፈምቴት ቱርቴ።<verse eid="2KI 25:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 25:3"/>ቡልቲ ሰግለፋ ጅአ አፉረፋት፣ መጋለቲ ኬሰት ቤል አከ መሌ ሀማቴ ነምን ዋን ኛቱ ቶኮሌ ዸቤ። <verse eid="2KI 25:3"/><verse number="4" style="v" sid="2KI 25:4"/>ኤርገሲ ደላን መጋለቲ ጨብሰሜ ሎልቶትን ሁንድኑስ ኡቱመ ባብሎኖትን መጋላ ሰነ መርሰኒ ጅረኑ ከራ ከረ ደላ እዶ ብቅልቱ ሞትቻ ብረ ጅሩ ለማን ግዱ ባሱ ሰናቲን ሀልከኒን በአኒ በቀተን። እሳንስ አረባት በቀተን፤ <verse eid="2KI 25:4"/><verse number="5" style="v" sid="2KI 25:5"/>ሎልቶትን ባብሎን ገሩ ሞትቸ አርአኒ ድሬ ዬርኮረት እሰ ቀቀበን። ሎልቶትንሳ ሁንድስ እሰራ ገርገር በአኒ ብብትናአኒ ቱረን፤ <verse eid="2KI 25:5"/><verse number="6" style="v" sid="2KI 25:6"/>እንስ ንቀበሜ።</para>
  <para style="p" vid="2KI 25:6">ገረ ሞቲ ባብሎንት ሪብላት ጌፈሜ አችትስ እት ሙረሜ። <verse eid="2KI 25:6"/><verse number="7" style="v" sid="2KI 25:7"/>እሳንስ እጁመሳ ዱረት እልማን ዜዴቅያ ፍጠን፤ እሳንስ እጀሳ ኬሳ ባሰኒ ፎንጫ ናሲቲን ህዸኒ ባብሎንት እሰ ጌሰን።<verse eid="2KI 25:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 25:8"/>በረ ሞቱማ ኔቡከድኔዘር ሞትቸ ባብሎን ኬሰ ወጋ ኩዸ ሰግለፋት፣ ቡልቲ ቶርበፋ ጅአ ሸነፋት፣ ኔቡዘረዳን አጀጃን ኤጉምሰ ሞቱማ፣ ቆንዳል ሞቲ ባብሎን ሱን ገረ ዬሩሳሌም ዹፌ። <verse eid="2KI 25:8"/><verse number="9" style="v" sid="2KI 25:9"/>እንስ መነ ቁልቁሉማ <char style="nd">ዋቀዮት</char>፣ መሰራ ሞቱማቲፊ መኔን ዬሩሳሌም ሁንደት እብደ ቀብሲሴ። መኔን ጉርጉዳ ሁንደስ ንጉቤ። <verse eid="2KI 25:9"/><verse number="10" style="v" sid="2KI 25:10"/>ሎልቶትን ባብሎን ከኔን አጀጃ ኤጉምሰ ሞቱማ ጀለ ቱረን ሁንድ ደላወን ናኖ ዬሩሳሌም ቱረን ዲገን። <verse eid="2KI 25:10"/><verse number="11" style="v" sid="2KI 25:11"/>ኔቡዘረዳን አጀጃን ኤጉምሳ ሱን ነሞተ መጋላ ኬሰት ሀፈኒፊ ወረ በቀተኒ ሞቲ ባብሎንት ኮሉ ገለን ቦጅኤ ፉዸቴ። <verse eid="2KI 25:11"/><verse number="12" style="v" sid="2KI 25:12"/>አጀጃን ሱን ገሩ ህዬዪ ብየቲ ኬሳ ገሪን አከ ወይኒ ኩኑንሰኒፊ ለፈ ቆተኒፍ አችት ዺሴ።<verse eid="2KI 25:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 25:13"/>ባብሎኖትን ሱን ኡቱባወን ናሲ፣ ባቱወን እዶዻ ሶቾአኒፊ ጋኒ ናሲራ ሆጄተሜ መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ኬሰ ቱሬ ጨጨብሰኒ ናሲ ሰነሞ ባብሎንት ጌሰን። <verse eid="2KI 25:13"/><verse number="14" style="v" sid="2KI 25:14"/>አከሱመስ ኦኮቴወን፣ ዋን እቲን ዳራ ሀማረን፣ ዋን እቲን እብሳራ ዳራ ዸዸአን፣ ጫቢወኒፊ ምኦተ ናሲራ ሆጄተመን ከኔን ተጃጅለ መነ ቁልቁሉማቲፍ ኦለን ሁንደ ፉዸተን። <verse eid="2KI 25:14"/><verse number="15" style="v" sid="2KI 25:15"/>አጀጃን ኤጉምሳ ሱንስ ግርግራወኒፊ ወጪቲወን እቲን ዺገ ፈጫሰን ከኔን ሁንድሳኒ ወርቄ ቁልቁሉራ ዮካን ሜቲራ ሆጄተመን ፉዸቴ ዴሜ።<verse eid="2KI 25:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 25:16"/>ኡልፍን ናሲ ከን ሶሎሞን እቲን ኡቱባወን ለማን፣ ጋኒፊ ባቱወን እዶዻ ሶቾአኒን መነ ቁልቁሉማ <char style="nd">ዋቀዮቲፍ</char> ሆጄቴ ቱሬ ዋን መዳሊን መዳሉ ደንደኡ ኦል ቱረን። <verse eid="2KI 25:16"/><verse number="17" style="v" sid="2KI 25:17"/>ቶኮን ቶኮን ኡቱባ ሰና ዹንዹመ ኩዸ ሰዴት ኦል ዼረተ ቱሬ። ጉቱን ናሲ ከን ኡቱባ ቶኮራስ ዹንዹመ ሰዲ ኦል ዼረቴ ናኖንሳ ጉቱን ስቢለ ወል ኬሰ ሎፈሜ ቶልፈሜፊ ሮማኒ ናሲቲን ሚዸግፈሜ ቱሬ። ኡቱባን ካንስ ስቢለሳ ከን ወል ኬሰ ሎፈሜ ቶልፈሜ ወጅን ከኑመ ፈካተ ቱሬ።<verse eid="2KI 25:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 25:18"/>አጀጃን ኤጉምሳ ሱን፣ ሴራያ ሉብቸ ሀንገፈ፣ ሴፋንያ ሉብቸ ሰደርካን እሰት ኣኑፊ ኤግዶተ በልበላ ሰደን ህዼ ፉዼ ዴሜ። <verse eid="2KI 25:18"/><verse number="19" style="v" sid="2KI 25:19"/>ወረ አመሌ መጋላ ኬሰት ሀፈን ኬሳ አጀጃ ሎልቶታቲፊ ጎርስቶተ ሞቲ ሸን ፉዸቴ። አከሱመስ በሬሳ ቆንዳለ ኦል ኣና ቱሬ ከን ሰበ ኬሳ ሎልቱማፍ ነሞተ ፍለቱ ሰናፊ ነሞተሳ ከኔን መጋላ ኬሰት አርገመን ጃተመ ፉዸቴ። <verse eid="2KI 25:19"/><verse number="20" style="v" sid="2KI 25:20"/>ኔቡዘረዳን አጀጃን ሱን ሁንደሳኒ ጉሬ ሪብላት ገረ ሞትቸ ባብሎንት ጌሴ። <verse eid="2KI 25:20"/><verse number="21" style="v" sid="2KI 25:21"/>ሞትችስ አቹመ ሪብላት ብየ ሀማት ኬሰት እሳን ንፍጤ።</para>
  <para style="p" vid="2KI 25:21">ይሁዳንስ አከሲን ቦጅአምቴ ብየሼቲ ባቴ።<verse eid="2KI 25:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 25:22"/>ኔቡከድኔዘር ሞትች ባብሎን አከ እን ነሞተ ይሁዳት ሀምብሴ ሰነ ቡልቹፍ ጌዳልያስ እልመ አሂቃም እልመ ሻፋን ሰነ ሙዴ። <verse eid="2KI 25:22"/><verse number="23" style="v" sid="2KI 25:23"/>አጀጆትን ሎልቶታ ሁንዲፊ ነሞትንሳኒ ዬሮ አከ ሞትች ባብሎን ጌዳልያስን ቡልቻ ኩታ ብያ ጎዼ ሙዴ ዸገአንት ጌዳልያስ ብረ ሚስጳ ዹፈን፤ እሳንስ እሽማኤል እልመ ናታንያ፣ ዮሃናን እልመ ቃሬያ፣ ሴራያ እልመ ተንሁሜት ነምቸ ኔቶፍ ሰና፣ ያዘንያ እልመ ነምቸ መአካቲፊ ነሞተሳኒ ቱረን። <verse eid="2KI 25:23"/><verse number="24" style="v" sid="2KI 25:24"/>ጌዳልያስስ፣ “ቆንዳልቶተ ባብሎን ህንሶዳትና፤ ብየቲ ኬሰ ቁበዻቲ ሞትቸ ባብሎን ተጃጅላ፤ ዋን ጋሪቱ እስኒ ተኣቲ” ጄዼ እሳኒፊ ነሞተሳኒቲፍ ከከቴ።<verse eid="2KI 25:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 25:25"/>ገሩ ጅአ ቶርበፋ ኬሰ እሽማኤል እልም ናታንያ እልመ ኤሊሻማ ከን ሰኚ ሞቶታራ ዸለቴ ሱን ነሞተ ኩዸን ወጅን ዹፌ ጌዳልያስ፣ ነሞተ ይሁዳቲፊ ነሞተ ባብሎን ከኔን እሰ ወጅን ሚስጳ ቱረን ፍጤ። <verse eid="2KI 25:25"/><verse number="26" style="v" sid="2KI 25:26"/>ከነረት ነምን ሁንድ ጥናፊ ጉዳን፣ ባብሎኖተ ሶዳቴ አጀጆተ ወራና ወጅን ገረ ግብጥት በቀቴ።<verse eid="2KI 25:26"/></para>
  <para style="s1">ዬሆያኪን ገድ ዺፈሜ</para>
  <para style="r">
    <ref loc="2KI 25:27-30">25፥27‑30</ref> ኩወፈ – <char style="xt"><ref loc="JER 52:31-34">ኤር 52፥31‑34</ref></char></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 25:27"/>ዬሆያኪን ሞቲን ይሁዳ ቦጅአሜ ወጋ ሶዶሚ ቶርበፋሳት፣ ኤዊል መሮዳክ ሞቲ ባብሎን ተኤ፤ እንስ ወጉመ ሰነ ኬሰ ቡልቲ ድግደሚ ቶርበፋ ጅአ ኩዸ ለመፋት ዬሆያኪን ሞቲ ይሁዳ ሰነ መነ ህዻቲ ገድ ዺሴ። <verse eid="2KI 25:27"/><verse number="28" style="v" sid="2KI 25:28"/>አፋን ቶላዻንስ እሰት ዱበቴ በርጩመ ኡልፍና ከን በርጩመ ሞቶተ እሰ ወጅን ባብሎን ኬሰ ቱረን ካኒ ጫሉ ኬኔፍ። <verse eid="2KI 25:28"/><verse number="29" style="v" sid="2KI 25:29"/>ከናፉ ዬሆያኪን ኡፈተሳ ከን መነ ህዻት ኡፈቻ ቱሬ ሰነ ኦፍራ ባሴ በረ ጅሬኘሳ ጉቱ ዬሮ ሁንደ ማዲ ሞትቻራ ኛቴ። <verse eid="2KI 25:29"/><verse number="30" style="v" sid="2KI 25:30"/>ሞትችስ ሀመ እን ሉቡዻን ጅራቴት ጉዩመ ጉያዻን ዋን እሳፍ በርባችሱ ዬሆያኪኒፍ ኬና ቱሬ።<verse eid="2KI 25:30"/></para>
  <chapter eid="2KI 25"/>
</usx>
