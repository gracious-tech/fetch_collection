<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1PE" style="id">- Bhilali Standard Project</book>
  <para style="h">1 पतरस</para>
  <para style="toc3">1 पतरस</para>
  <para style="toc2">1 पतरस</para>
  <para style="toc1">पतरसेन पेहली चिट्‌ठी</para>
  <para style="mt2">पतरस की पहली पत्री</para>
  <para style="mt1">पतरसेन पेहली चिट्‌ठी</para>
  <para style="imt">1 पतरसेन बारामां</para>
  <para style="ip">1 पतरसेन चिट्‌ठी नेवताळान काम पतरसेन साहरे लिखी गुयलो हतलो। पतरस आपणी चिट्‌ठीन सुरुवात सी असु कह्‌वे की चु कुण हतलु ने कुणीक लिख रवलु। हीयु हीनु आखा ईसु पर भुरसु करन्‌या काजे चिट्‌ठी सी सीकाड़्‌यु जीनुक हयु अनजाण्‌या <char style="xt"><ref loc="1PE 1:1">1:1</ref>; <ref loc="1PE 1:17">1:17</ref>; <ref loc="1PE 2:11">2:11</ref></char> कह्‌वलो हतलो। चे आपणे भन्‌ने वाळा काजे काय कावा समज्‌यु दरसायु, काहाकी चे काय कतराक देसे मां रावण्‌या-तीवण्‌या हय रवला। काहाकी जी चिट्‌ठी थुड़ाक मायने मां ईफीसीया काजे लिखी गुय पोलुसेन चिट्‌ठी सी मेळतो-झुळतो छे, बेसका माणसे माने की 1 पतरस ईफीसीयान पछे मसीन पयदा हवणेन धड़े-वड़े सांठ ने पांच साल पछे लिखी गुयलु। पतरस हीनी चिट्‌ठी काजे रोम सी लिखलु तीनाक हीयुबाबुल <char style="xt"><ref loc="1PE 5:13">5:13</ref></char> कह्‌वलो हतलो।</para>
  <para style="ip">पतरस कह्‌वे की हीयु हीनी चिट्‌ठी काजे तुहुंंक हिम्‌मत बांदाड़ने ने हीनी वातेन गवा देणे वाटे लिखलु की ज्‌य भगवानेन खरली गीण-दया छे। <char style="xt"><ref loc="1PE 5:12">5:12</ref></char> <char style="xt"><ref loc="1PE 2:11">1 पतरस 2:11</ref>; <ref loc="1PE 3:7">3:7</ref>,</char> <char style="xt"><ref loc="EPH 5:18">ईफीसीयो 5:18</ref>; <ref loc="EPH 6:9">6:9</ref></char> ने <char style="xt"><ref loc="COL 3:18">कुलुस्‌यो 3:18</ref>; <ref loc="COL 4:6">4:6</ref></char> ईचमां बेसका एक जसा छे। जे तीनु भाग घरेन तसा रीस्‌तान ने हुकुमेन पाळनेन हकदार्‌यान बारामां आदेस देय। चु ईसु पर भुरसु करन्‌या काजे बी हिम्‌मत बांदाड़े की जत्‌यार दुख हवे ती काठा रवे काहाकी आकरी दाहड़ा धड़े छे। <char style="xt"><ref loc="1PE 4:1">4:1</ref></char></para>
  <para style="iot">बाहरती वात</para>
  <para style="io1">1. पतरस आपणी उळखाण देय ने आपणा भन्‌ने वाळा काजे सीकाड़े। <char style="ior"><ref loc="1PE 1:1-2">1:1-2</ref> </char></para>
  <para style="io1">2. अळतेन चु हीना छुटकारा वाटे भगवान काजे बेसकु वारु कह्‌वे जेरेसी चे आखा साजु करे ने हींद्‌रे जीवन वाटे मायने राखे। <char style="ior"><ref loc="1PE 1:3-2:10">1:3—2:10</ref></char></para>
  <para style="io1">3. हेरे पछेन चु ईसु पर भुरसु करन्‌या काजे आदेस देय की कसों हीनी कळी मां वारु तरा सी रवणु ने अदमी ने बायरी ने पावर्‌यु ने मालीकेन ईचमां बेसका रीस्‌ता काजे देखाड़े। <char style="ior"><ref loc="1PE 2:11-4:11">2:11—4:11</ref> </char></para>
  <para style="io1">4. हेरे पछेन पतरस हीनु काजे दुखेन दाहड़ा मां वेठणे करीन हिम्‌मत बांदाड़े। <char style="ior"><ref loc="1PE 4:12-5:11">4:12—5:11</ref> </char></para>
  <para style="io1">5. अळतेन चु आपणी चिट्‌ठी काजे पुरो करे। <char style="ior"><ref loc="1PE 5:12-14">5:12-14</ref></char></para>
  <chapter number="1" style="c" sid="1PE 1" />
  <para style="s">आव-भाव</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 1:1" />पतरस भीणी सी जु ईसु मसीन नेवताळु छे,</para>
  <para style="p" vid="1PE 1:1">हीनु परदेसेन नाव, जे पुन्‌तुस गलातीया, कप्‌पुदुक्‌या, आसीया, ने बीतुनीया, मां आखे रावण्‌या-तीवण्‌या रवे, <verse eid="1PE 1:1" /><verse number="2" style="v" sid="1PE 1:2" />ने भगवान बासेन आवणे वाळी वातेन अकलेन अनसारे, आत्‌मान चुखला करनेन साहरे हुकुम मान्‌ने ने ईसु मसीन लुही छीटणे करीन नेवाड़्‌लु छे।</para>
  <para style="p" vid="1PE 1:2">तुहुंंक गीण-दया ने सुक-सांती बेसकी जड़ती रवे।<verse eid="1PE 1:2" /></para>
  <para style="s">एक जीवतेली आस</para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 1:3" />हामरा मालीक ईसु मसीन भगवान ने बासेन बड़ाय हवे, जु ईसु मसी मरलाम सी जीवतु हवणे सी आपसान मटी दया सी हामुक जीवतेली आस वाटे नवली जीवाय आप्‌यु। <verse eid="1PE 1:3" /><verse number="4" style="v" sid="1PE 1:4" />मतलब कदी खत्‌तम नी हवणे वाळी ने; ने जलम रहणेन भाग वाटे जी तुंद्‌रे वाटे सरगे मां मेकली छे। <verse eid="1PE 1:4" /><verse number="5" style="v" sid="1PE 1:5" />ज्‌य तारे वाटे छे ज्‌य भुरसान साहरे भगवानेन ताकत सी हीना छुटकारा वाटे समाळीन मेकी जाय, ज्‌य आकरी टेम मां देखायणे वाटे तीयार छे।<verse eid="1PE 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1PE 1:6" />हेरे वजे सी तुहुंं खुसी हवु, मानु जरुड़ी छे की हय काय दाहड़ा लग काय तरान दुख झेलनु पड़ र्‌यो; <verse eid="1PE 1:6" /><verse number="7" style="v" sid="1PE 1:7" />ने जी हेरेसी छे की तुंद्‌रु पारख हवलु भुरसु, जे आकठा सी तय हवलो खत्‌तम हवण्‌या सना सी बी काही अदुस बेसको जरुड़ी छे, ईसु मसी देखता हवणे पर बड़ाय ने सेक-सींगार ने ईज्‌जतेन वजे बणे। <verse eid="1PE 1:7" /><verse number="8" style="v" sid="1PE 1:8" />तुहुंं ईसु काजे कदी नी देख्‌या, तेबी तुहुंं हेरसी परम राखु। तुहुंं हय बी हीनाक नी देखु तेबी हेरे पर भुरसु करु। ने भुरसु करीन असा खुसी हवु ने मुरखायु ज्‌य बीयान सी बाहार ने सेक-सींगार सी भरला छे; <verse eid="1PE 1:8" /><verse number="9" style="v" sid="1PE 1:9" />ने आपणा भुरसान दाहड़ीन फळ मतलब आत्‌मान छुटकारु जड़े।<verse eid="1PE 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 1:10" />हीना छुटकारान बारामां हीनु भगवानेन अघी सी आवणे वाळी वात देखान्‌यु कवण्‌या बेसका हेरी भाळने ने पारख कर्‌या जे हीना गीण-दयान बारामां जे तुंद्‌रे पर हवणु हतलो भगवानेन अघी सी आवणे वाळी वात देखान्‌यु करली हतली। <verse eid="1PE 1:10" /><verse number="11" style="v" sid="1PE 1:11" />चे ईनी वात काजे हेर्‌या की मसीन आत्‌मा जो हींद्‌रे मां हतली ने पेहल सी मसीन दुखेन ने हेरे पछेन हवणेवाळी सेक-सींगारेन गवाय आपली हतली चु कुण छे ने कसली घड़ी भीणी ईसारु करतेलु। <verse eid="1PE 1:11" /><verse number="12" style="v" sid="1PE 1:12" />हींद्‌रे पर ज्‌य देखाड़ी गीला छे की चे आपणी नी बाकुन तुंद्‌री चाकरी वाटे ची वात कह्‌या करतेला, तींद्‌रो खबर हय तुहुंं हींद्‌रे साहरे जड़लो जीनुक चुखली-आत्‌मान साहरे, जे सरग सी मकल्‌या गीला तुहुंं खुस-खबर सामळ्‌या; ने ईनी वात काजे सरग वाळा काहवाळ्‌या बी धी‌यान सी देखणेन लालच राखतेला।<verse eid="1PE 1:12" /></para>
  <para style="s">चुखलो जीवन जीवणेन बुलावु</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 1:13" />हेरेसी तुहुंं आपणे मनेन ताकत काजे काम करने वाटे तीयार करे ने खुद समळीन रय्‌न तीनी गीण-दया पर पुरी आसा मेकु, जी ईसु मसीन उजेंतो हवणेन टेमे तुहुंंक जड़ने वाळो छे। <verse eid="1PE 1:13" /><verse number="14" style="v" sid="1PE 1:14" />हुकुम मान्‌या पुर्‌यान तसा आपणी डेड़ अकलेन जुन्‌डली भुंडली लालुच करने वाळान तसा मां बणु। <verse eid="1PE 1:14" /><verse number="15" style="v" sid="1PE 1:15" />बाकुन जसा तुंद्‌रो बुलावणे वाळु चुखलु छे, असात तुहुंं बी आपणा आखा चाल-चलन मां चुखला बणु। <verse eid="1PE 1:15" /><verse number="16" style="v" sid="1PE 1:16" />काहाकी लिखलो छे, चुखला बणु। काहाकी मे चुखलु छे।<note caller="+" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="LEV 11:44">लेवयवेवस्‌था 11:44</ref>; <ref loc="LEV 19:2">19:2</ref>; <ref loc="LEV 20:7">20:7</ref> </char></note><verse eid="1PE 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 1:17" />ने जत्‌यार की तुहुंं ए बास कवीन हीनाक दुवा करो, जे काट छाट पाखुर आखा एक कामेन अनसारे नीयाव करे, ती आपणे परदेसी हवणेन घड़ी धाक सी बीतावु। <verse eid="1PE 1:17" /><verse number="18" style="v" sid="1PE 1:18" />काहाकी तुहुंं जाणु की तुंद्‌रा पापी चाल-चालन जो बास डुकरान टेम सी फालतु चाल छे, हेरसी तुंद्‌रु छुटकारु चांदी-सना मतलब खत्‌तम हवणे वाळी चीजेन साहरे नी हयो; <note caller="+" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="PSA 49:7-8">भजन सहीता 49:7-8</ref>; <ref loc="GAL 1:4">गलातीयो 1:4</ref>; <ref loc="ISA 52:3">यसाया 52:3</ref></char></note> <verse eid="1PE 1:18" /><verse number="19" style="v" sid="1PE 1:19" />बाकुन ईसु मसीन चुखला ने नी-गुनाळु लुहीन साहरे तुहुंंक छुड़ायु। चु ईसु मसी तीना चुखला गाडरान तसु छे तीना गाडरा काजे पुजारा मंदीरेम पापेन माफी वाटे मारीन चहड़ावतेला। <verse eid="1PE 1:19" /><verse number="20" style="v" sid="1PE 1:20" />कळी घड़ायणेन पेहलुत भगवानेन साहरे नेवाड़ी गुयलु, बाकुन हय तुंद्‌रे वाटे आकरी दाहड़ा मां, उजेंतु करलु छे। <verse eid="1PE 1:20" /><verse number="21" style="v" sid="1PE 1:21" />हेरे साहरे तुहुंं हीना भगवान पर भुरसु करजे जु हीनाक मरलाम सी जीवाड़्‌यु ने सेक-सींगार आप्‌यु की तुंद्‌रु भुरसु ने आस भगवान पर हवे।<verse eid="1PE 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1PE 1:22" />तुहुंं भगवानेन हुकुम मानीन खुस-खबर छाचाय काजे मानी रया, ने असा करीन तुहुंं आपसान जीव काजे चुखु कर र्‌या करीन, ईसु पर भुरसु करन्‌या भाय-बहणस्‌या वाटे, तुंद्‌रा मन मां चुखला परम वाटे जागु छे। हेरेसी हय तुहुंं खरले मने वारु मन लागाड़ीन एक-दीसराक परम करता रवणु चाहजे। <verse eid="1PE 1:22" /><verse number="23" style="v" sid="1PE 1:23" />काहाकी तुहुंंक जी नवली जीवाय जड़ली छे, ची ईतराक दाहड़ा वाटे नी हय तुहुंं काजे जी नवली जीवाय खत्‌तम हवण्‌या बीजेन तसों नी हय बाकुन अमर जीवन मतलब भगवानेन जीवतेला ने जलम रवणेवाळा बुलेन साहरे हवलु छे। <verse eid="1PE 1:23" /><verse number="24" style="v" sid="1PE 1:24" />काहाकी आखी कळीन माणसे खड़ेन तसा छे,</para>
  <para style="q1" vid="1PE 1:24">“ने तींद्‌री सुभा खड़ेन फुलेन तसी छे।</para>
  <para style="q2" vid="1PE 1:24">खड़ चीमाय जाय,</para>
  <para style="q1" vid="1PE 1:24">ने फुल सड़ी जाय,<verse eid="1PE 1:24" /></para>
  <para style="q2">
    <verse number="25" style="v" sid="1PE 1:25" />बाकुन मालीकेन बुल जलम पीड़ीडीट काठो रवसे।”</para>
  <para style="p" vid="1PE 1:25">ने जुत खुस-खबरेन बुल छे तुहुंंक सामळ्‌या गीलो हतलो।<note caller="+" style="x"><char style="xo" closed="false">1:25 </char><char style="xt" closed="false"><ref loc="LUK 16:17">लुका 16:17</ref>; <ref loc="1JN 1:1">1 युहन्‌ना 1:1</ref>; <ref loc="ISA 40:8">यसाया 40:8</ref></char></note><verse eid="1PE 1:25" /></para>
  <chapter eid="1PE 1" />
  <chapter number="2" style="c" sid="1PE 2" />
  <para style="s">जीवतेलु दगड़ु ने चुखला माणसे</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 2:1" />हेरेसी आखी भातीन काट-छाट ने झुट ने ढंगड़ा ने डाहवाय ने नाव-बद्‌दी काजे छेटा करीन, <verse eid="1PE 2:1" /><verse number="2" style="v" sid="1PE 2:2" />नवलो पयदा हवला पुर्‌यान तसा वारु जीव-आत्‌मान दुतेन लालच करु काहाकी हेरे साहरे छुटकारु जड़ने वाळा वाटे अदता जावु। <verse eid="1PE 2:2" /><verse number="3" style="v" sid="1PE 2:3" />काहाकी तुहुंं मालीकेन दयान सवाद चाखी लेदला छे।<note caller="+" style="x"><char style="xo" closed="false">2:3 </char><char style="xt" closed="false"><ref loc="PSA 34:8">भजन सहीता 34:8</ref></char></note><verse eid="1PE 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1PE 2:4" />हय तुहुंं ईसु धड़े आवला छे, जु जीवतेलु दगड़ु छे, तीनाक माणसे फालतु छे करीन छुड़ देदा बाकुन भगवान वाटे बेसको जरुड़ी ने नेवाड़लु छे। <verse eid="1PE 2:4" /><verse number="5" style="v" sid="1PE 2:5" />तुहुंं बी आपसात जीवतेला दगड़ान तसा जीव-आत्‌मान घर बणावता जावु, तेरसी पुजारान चुखला समाज बणीन असा जीव-आत्‌मान बादा चड़ावु जो ईसु मसीन साहरे भगवान काजे गमे। <verse eid="1PE 2:5" /><verse number="6" style="v" sid="1PE 2:6" />हेर वजे सी चुखला सास्‌तुर मां बी आवलो छे;</para>
  <para style="q1" vid="1PE 2:6">देखु मे सीयोन बयड़ा मां खुड़ान सीरेन नेवाड़ला ने बेसकु जरुड़ी दगड़ु मेको;</para>
  <para style="q2" vid="1PE 2:6">ने जे कुय हेरे पर भुरसु करसे,</para>
  <para style="q2" vid="1PE 2:6">चु काहानी बी रीत सी नाव-बद्‌दी नी हवे।<note caller="+" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="ISA 28:16">यसाया 28:16</ref></char></note><verse eid="1PE 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 2:7" />अळतेन तुंद्‌रे वाटे जे भुरसु करु चु ते बेसको जरुड़ी छे, बाकुन जे भुरसु नी करे हींद्‌रे वाटे,</para>
  <para style="q1" vid="1PE 2:7">तीना दगड़ा काजे मीस्‌तर्‌या फालतु ठेरावला हतला।</para>
  <para style="q2" vid="1PE 2:7">बाकुन हयुत खुणान खास दगड़ु हतलु।<note caller="+" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="PSA 118:22">भजन सहीता 118:22</ref>; <ref loc="DAN 2:34-35">दानीयल 2:34-35</ref></char></note><verse eid="1PE 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 2:8" />ने, “ठुकोर लागणेन दगड़ु ने ठुकर खाणेन चापर्‌या बण गुया।”</para>
  <para style="q1" vid="1PE 2:8">काहाकी चे ते बुल काजे नी मानीन ठुकर खाय,</para>
  <para style="q2" vid="1PE 2:8">ने ज्‌य डंड हींद्‌रे वाटे भगवानेन साहरे ठेरावलु छे।<note caller="+" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="1CO 1:23">1 कुरींथी 1:23</ref>; <ref loc="ISA 8:14">यसाया 8:14</ref>,<ref loc="ISA 8:15">15</ref></char></note><verse eid="1PE 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1PE 2:9" />बाकुन तुहुंं नेवाड़ला खानदानी छे, ने राज पाट वाळा पुजारा ने चुखला माणसेन टुळु छे, ने भगवानेन वारलु माणसे छे, हेरेसी की भगवान तुहुंं काजे आंदारला मां सी बेसका मटा वीजाळा मां बुलावलु छे हेरा गुण देखाड़ु।<note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="EXO 19:5">नीरगमन 19:5</ref>,<ref loc="EXO 19:6">6</ref>; <ref loc="DEU 7:6">वेवस्‌थावीवरन 7:6</ref>; <ref loc="DEU 14:2">वेवस्‌थावीवरन 14:2</ref>; <ref loc="ISA 9:2">यसाया 9:2</ref></char></note> <verse eid="1PE 2:9" /><verse number="10" style="v" sid="1PE 2:10" />तुहुंं पेहल ते काय बी नी हतला बाकुन हय भगवानेन माणसे छे तुंद्‌रे पर दया नी हवली हतली बाकुन हय तुंद्‌रे पर दया हवी।<note caller="+" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="HOS 1:10">होसे 1:10</ref>; <ref loc="HOS 2:23">होसे 2:23</ref></char></note><verse eid="1PE 2:10" /></para>
  <para style="s">भगवान वाटे जीवणु</para>
  <para style="p">
    <verse number="11" style="v" sid="1PE 2:11" />ए लाटेक्‌ला भायसे मे तुंद्‌रे सी लीलघायो की तुहुंं आपणे आप काजे दीसरे देस सी आवलु ने आवणे जाणे वाळु जाणीन हीनु कळीन डीलेन भुंडली लालच सी जे आत्‌मा सी लड़ाय करे बची रवु।<note caller="+" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="GAL 5:24">गलातीयो 5:24</ref>; <ref loc="1PE 4:2">1 पतरस 4:2</ref></char></note> <verse eid="1PE 2:11" /><verse number="12" style="v" sid="1PE 2:12" />आड़जात्‌या मां तुंद्‌रो चाल-चलन वारु हवणु चाहजे; काहाकी जीनु-जीनु वात मां चे तुहुंंक पापी जाणीन नाव-बद्‌दी करु चे तुंद्‌रो वारु काम काजे देखीन हयुत वजे सी, भगवानेन आवणे दाहड़े चे सेक-सींगार करे।<verse eid="1PE 2:12" /></para>
  <para style="s">आखा हकदार्‌यान ईज्‌जत करीन कुहराय छुड़ु ने भलाय करन्‌या बणु</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 2:13" />मालीक ईसु वाटे ठहरावला हरेक हक-जमाड़न्‌या आखा हकदार्‌यान हक मां रहु भले चु कळीन आखा देस पर राज-करन्‌यु मुख्‌यु राजु काहनी हय, <verse eid="1PE 2:13" /><verse number="14" style="v" sid="1PE 2:14" />भले चु एकेक राजवाड़ानम नीते एकेक जीलाम राज करन्‌यु हय। भगवान कुहर्‌याक डंड आपणे ने भलाय करन्‌याक वारु कर्‌या कहणे करीन तीनु राज करन्‌याक ठेरावलु छे। <verse eid="1PE 2:14" /><verse number="15" style="v" sid="1PE 2:15" />काहाकी भगवानेन जी मरजी छे की तुहुंं वारु काम करनेन साहरे डेड़-अकल्‌या माणसेन मुंहडा काजे बंद करु जे बे फालतु वात करता रवे। <verse eid="1PE 2:15" /><verse number="16" style="v" sid="1PE 2:16" />जी वात छाचली छे की, तुहुंं ईसुन लारे छुटला माणसे बण गुयला छे करीन हीना हक काजे नाव-बद्‌दी करन्‌या मां बणु, बाकुन आपसा काजे भगवानेन गुलाम पावर्‌यु जाणीन पापेम सी छुटला रवीन जीवु। <verse eid="1PE 2:16" /><verse number="17" style="v" sid="1PE 2:17" />आखान ईज्‌जत करु, भायस्‌यो सी परम राखु भगवान सी बीहु, राजान आव-भाव करु।<note caller="+" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="PRO 24:21">नीतीवचन 24:21</ref>; <ref loc="ROM 12:10">रोमीयो 12:10</ref></char></note><verse eid="1PE 2:17" /></para>
  <para style="s">ईसु मसीन दाखलु</para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 2:18" />ए पावर्‌या आखी तरान ईज्‌जत साते आपणा मालीकेन हक मां रहु नी सीरप हींद्‌रे जे वारुत ने नीचळा बाकुन भुंडा छे हींद्‌री बी ईज्‌जत करु। <verse eid="1PE 2:18" /><verse number="19" style="v" sid="1PE 2:19" />काहाकी कदी कुय भगवानेन वीच्‌यार करीन नी-नीयाव सी दुख हाकलीन पीड़ाक सेण करे ती चु वारु बड़ाय लायक छे। <verse eid="1PE 2:19" /><verse number="20" style="v" sid="1PE 2:20" />काहाकी कदी तुहुंं गुनु करीन सपाटा खादा ने दम धरीन रया तेरेमां काय बड़ायन वाते छे? बाकुन कदी वारु काम करीन दुख हाकलीन ने दम धरीन रवु ती जी भगवानेन बड़ाय लायक छे। <verse eid="1PE 2:20" /><verse number="21" style="v" sid="1PE 2:21" />ने तुहुंं हेरे वाटे बुलाय बी गुयला छे काहाकी मसी बी तुंद्‌रे वाटे दुख हाकलीन तुहुंं एक नमुनु आप देदलु छे की तुहुंं बी तेरेन तसा चाल सकु। <verse eid="1PE 2:21" /><verse number="22" style="v" sid="1PE 2:22" />नीते ईसु पाप कर्‌यु ने नी हेरे मुंहडा सी धुकान काय वात कर्‌यु।<note caller="+" style="x"><char style="xo" closed="false">2:22 </char><char style="xt" closed="false"><ref loc="ISA 53:9">यसाया 53:9</ref>; <ref loc="2CO 5:21">2 कुरींथी 5:21</ref></char></note> <verse eid="1PE 2:22" /><verse number="23" style="v" sid="1PE 2:23" />चु गाल सामळीन गाल नी देदु ने दुख हाकलीन काहना काजे बी धमकी नी देदु बाकुन आपणे आप काजे धरमी नीयाव करन्‌या भगवानेन हात मां सुपलु हतलु।<note caller="+" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="ISA 53:7">यसाया 53:7</ref>; <ref loc="1PE 4:19">1 पतरस 4:19</ref></char></note> <verse eid="1PE 2:23" /><verse number="24" style="v" sid="1PE 2:24" />मसी आपसुत हामरा पाप काजे आपणा डील पर लीन कुरुस पर चड़ गुयु तीनाक पापे वाटे मारीन धरम वाटे जीवन जीवतु हेरे मार खाणे सी तुहुंं वारु हय गुया।<note caller="+" style="x"><char style="xo" closed="false">2:24 </char><char style="xt" closed="false"><ref loc="ISA 53:4-5">यसाया 53:4-5</ref>,<ref loc="ISA 53:12">12</ref>; <ref loc="GAL 3:13">गलातीयो 3:13</ref></char></note> <verse eid="1PE 2:24" /><verse number="25" style="v" sid="1PE 2:25" />बाकुन हय गुवाळ्‌या ने आत्‌मान राखवाळी करने वाळा धड़ेत आया।<note caller="+" style="x"><char style="xo" closed="false">2:25 </char><char style="xt" closed="false"><ref loc="ISA 53:6">यसाया 53:6</ref>; <ref loc="EZK 34:5-6">यहेजकेल 34:5-6</ref></char></note><verse eid="1PE 2:25" /></para>
  <chapter eid="1PE 2" />
  <chapter number="3" style="c" sid="1PE 3" />
  <para style="s">अदमी ने बायरी</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 3:1" />ए बायरा आपणा-आपणा अदमीन हक मां रवु, जेरेसी की कदी हींद्‌रे मां सी कुय भगवानेन बुलेन हुकुम नी मानने वाळु हय ती बी तुहुंं काय बी नी कहुं तेबी चे आपणी-आपणी बायरीन सभावेन साहरे भुरसा मां आय जासे। <verse eid="1PE 3:1" /><verse number="2" style="v" sid="1PE 3:2" />काहाकी चे तुंद्‌री चुखली ने वारलु आव-भाव काजे देखता रवे। <verse eid="1PE 3:2" /><verse number="3" style="v" sid="1PE 3:3" />तुंद्‌रो बेसको जीर्‌ये देखायणु मुणका वाटे नी हवणु चाहजे मतलब कान्‌या गुथणु ने सनान रकम नीते भाती-भातीन पुथल्‌या पेहरनु। <verse eid="1PE 3:3" /><verse number="4" style="v" sid="1PE 3:4" />बाकुन तुंद्‌रो डुकायलो ने सातायलो माणुस नरम ने मनेन नीचळान कदी नी खत्‌तम हवणु चाहजे तसों बेसके जुरे देखायणु साप-सुतरो रवे काहाकी भगवानेन नींगा मां हेरी कीमत मटी छे। <verse eid="1PE 3:4" /><verse number="5" style="v" sid="1PE 3:5" />पेहली टेम मां चुखला बायरा बी ज भगवान पर आस राख तेला आपणे आप काजे ईनी रीत सी सवारे ने आपणा-आपणा अदमीन हक रवतेली। <verse eid="1PE 3:5" /><verse number="6" style="v" sid="1PE 3:6" />जसी सारा अब्‌राहमेन हुकुम मान तेली ने हीनाक मालीक कवतेली अळतेन तुहुंं बी कदी भलाय करु ने काहनीक तरा धाक सी बीहु नी ती हेरी पुरे बणसु।<verse eid="1PE 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 3:7" />असात ए अदमी तुहुंं अक्‌कल सी बायरा साते सवसार करु ने बायरी काजे लुली जाणीन हेरु आव-भाव करु ज समजीन की हामु दुयु जीवनेन दयान वाटाम हक मां छे जेरेसी तुंद्‌री दुवा रुकी नी जाय।<verse eid="1PE 3:7" /></para>
  <para style="s">भलाय करनेन वजे सी सताव</para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 3:8" />अळतेन आखान आखा एक मन ने दयाळा ने भायस-भायस सी परम राखणेवाळा ने गीण-दयाळा ने नरम बणु। <verse eid="1PE 3:8" /><verse number="9" style="v" sid="1PE 3:9" />कुहरायन बदले कुहराय मां करु ने गाळीन बदले गाळी मां देवु बाकुन हेरे उल्‌टा बरकत आपु काहाकी तुहुंं संयबरकत हकदार हवणे वाटे बुलाय गुयला छे <verse eid="1PE 3:9" /><verse number="10" style="v" sid="1PE 3:10" />काहाकी कुय,</para>
  <para style="q1" vid="1PE 3:10">जीवनेन मरजी राखे,</para>
  <para style="q2" vid="1PE 3:10">ने वारलु दाहड़ा देखणु चाहजे,</para>
  <para style="q2" vid="1PE 3:10">चु आपणी जीप काजे कुहराय सी,</para>
  <para style="q2" vid="1PE 3:10">ने आपणा हुटड़ा काजे धुकान वात करने सी रुकी रवलु।<verse eid="1PE 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1PE 3:11" />कुहरायन सात छुड़ देवु ने भलाय करु ने चु तीनी सांती काजे हेरे,</para>
  <para style="q2" vid="1PE 3:11">ने हेरीत कुसीस मां रवे।<verse eid="1PE 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1PE 3:12" />काहाकी मालीकेन डुळा धरमी माणसे पर लागला रवे,</para>
  <para style="q2" vid="1PE 3:12">ने हेरा कान्‌टा हींद्‌री लीलघाय भीणी लागला रवे</para>
  <para style="q2" vid="1PE 3:12">बाकुन मालीक कुहराय करने वाळा नी फीरे।<note caller="+" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="PSA 34:15">भजन सहीता 34:15</ref>,<ref loc="PSA 34:16">16</ref>; <ref loc="PRO 15:29">नीतीवचन 15:29</ref></char></note><verse eid="1PE 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 3:13" />कदी तुहुंं भलाय करनेन धुन मां रहु ती तुंद्‌री कुहराय करने वाळा पछेन कुण छे? <verse eid="1PE 3:13" /><verse number="14" style="v" sid="1PE 3:14" />कदी तुहुंं धरमेन वजे सी दुख बी हाकलु ती बरकतवाळा छे बाकुन माणसेन बीहायने सी मां बीहु ने मां घाबरावु। <verse eid="1PE 3:14" /><verse number="15" style="v" sid="1PE 3:15" />बाकुन मसी काजे मालीक जाणी आपणा-आपणा मन मां चुखला समजु जु कुय तुंद्‌रे सी तुंद्‌री आसेन बारामां काय पुछे हीनाक जपाप आपणे वाटे जलम तीयार रवु बाकुन नरम ने धाकेन साते रवु। <verse eid="1PE 3:15" /><verse number="16" style="v" sid="1PE 3:16" />बाकुन नरम ने ईज्‌जत साते मन काजे बी चुखो राखु हेरेसी सी की जीनु वातेन बारामां तुंद्‌री नाव-बद्‌दी हवे हींद्‌रे बारामां चे ईसु मसी मां तुंद्‌रे वारलु चाल चलनेन नाव-बद्‌दी करे चे लाजवाये। <verse eid="1PE 3:16" /><verse number="17" style="v" sid="1PE 3:17" />काहाकी कदी भगवानेन जी मरजी हवे की तुहुंं भलाय करनेन वजे सी दुख हाकले ती ज कुहराय करनेन वजे सी दुख हाकलने सी वारु छे। <verse eid="1PE 3:17" /><verse number="18" style="v" sid="1PE 3:18" />हेरेसी की मसी बी मतलब नी-धरम वाळा वाटे ईसु धरमी पापेन वजे सी एक कावा दुख हाकल्‌यु काहाकी हामु भगवान धड़े पुग्‌या च डीलेन भाव सी ते मार देदा बाकुन आत्‌मान भाव सी जीवाड़ी गुयु। <verse eid="1PE 3:18" /><verse number="19" style="v" sid="1PE 3:19" />आत्‌मान मां जाय्‌न बुजायली आत्‌मा काजे परचार कर्‌यु। <verse eid="1PE 3:19" /><verse number="20" style="v" sid="1PE 3:20" />चे हीनु माणसेन आत्‌मा हतली जीनुक भगवानेन हुकुम काजे पाळन नी कर्‌या, जत्‌यार चु नुहान दाहड़ा मां भगवान दम धरीन वाट देख रवलु ने ढंड्‌यो बन्‌ने बाजी रह्‌लो, तीनाम बठीन थुड़ाक माणसे मतलब आठ माणसे पाणीन साहरे बचाड़ी गुया। <verse eid="1PE 3:20" /><verse number="21" style="v" sid="1PE 3:21" />ईनात पाणी काजे दाखलु बी मतलब बपतीस्‌मा ईसु मसी जीवतु हवणेन साहरे हय तुहुंंक बचाड़ने। हेरेसी डीलेन मुयळ काजे छेटे करीन मतलब नी हय, बाकुन वारलु डीमाक सी भगवानेन हक मां हय जाणेन मतलब छे। <verse eid="1PE 3:21" /><verse number="22" style="v" sid="1PE 3:22" />चु सरग पर जाय्‌न भगवानेन जेवड़े आन्‌गे बठी गुयु ने सरगेन वाळा काहवाळ्‌या ने हकदार्‌या ने ताकत हेरे हक मां करला छे।<note caller="+" style="x"><char style="xo" closed="false">3:22 </char><char style="xt"><ref loc="EPH 1">ईफीसीयो</ref></char> <char style="xt" closed="false"><ref loc="EPH 1:20">1:20</ref>,<ref loc="EPH 1:21">21</ref>; <ref loc="PSA 110:1">भजन सहीता 110:1</ref></char></note><verse eid="1PE 3:22" /></para>
  <chapter eid="1PE 3" />
  <chapter number="4" style="c" sid="1PE 4" />
  <para style="s">बदलु जीवन</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 4:1" />जत्‌यार की मसी डील मां हयन दुख हाकल्‌यु ती तुहुंं बी हेना मनसा काजे हत्‌यारेन तसों धर लेवु, काहाकी जु डील मां दुख हाकल्‌या, चु पाप सी छुट गुयु, <verse eid="1PE 4:1" /><verse number="2" style="v" sid="1PE 4:2" />काहाकी आवणे वाळी घड़ी मां आपणा बचला डीलेन जीवन माणसेन लालुचेन अनसारे नी बाकुन भगवानेन मरजीन अनसारे जीवन जीवु। <verse eid="1PE 4:2" /><verse number="3" style="v" sid="1PE 4:3" />काहाकी नी-यहुदी मरजीन अनसारे काम करने, ने लुच्‌चायन भुंडली हर, दारकुट्‌या, भुंडलो काम, पीणेवाळा, ने बेकार मुरती पुजण्‌या मां जां लग हामु पेहल सी टेम जावाड़ देदा, चोन बेसको हयो। <verse eid="1PE 4:3" /><verse number="4" style="v" sid="1PE 4:4" />हय चे सुसवारे, की तुहुंं असा भारी लुच्‌चाय मां हींद्‌रो साते नी देवु, ने हेरेसी चे भुंडो वारु कवे। <verse eid="1PE 4:4" /><verse number="5" style="v" sid="1PE 4:5" />हीनुक जे हय जीवतेला छे ने मरीन सर गुया आपणा कामेन लेखु-जुखु हीना मसी काजे देणु पड़से जु हींद्‌रो नीयाव करने वाळु छे।<note caller="+" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="2TI 4:1">2 तीमुथीयुस 4:1</ref></char></note> <verse eid="1PE 4:5" /><verse number="6" style="v" sid="1PE 4:6" />काहाकी मरला काजे बी खुस-खबर हेरेसी सामळाय गुयो, की डील मां ते माणसेन अनसारे हींद्‌रो नीयाव हवे, बाकुन आत्‌मा मां चे भगवानेन अनसारे जीवता रवे।<verse eid="1PE 4:6" /></para>
  <para style="s">भगवानेन दान-वरदानेन वारु रीती सी देख-भाळ करने वाळा</para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 4:7" />आखी वातेन खात्‌मो तत्‌यारुत हवणे वाळो छे; हेरेसी जानकार हयन दुवा वाटे समळीन रवु।<note caller="+" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="JAS 5:8">याकुब 5:8</ref>; <ref loc="EPH 6:18">ईफीसीयो 6:18</ref></char></note> <verse eid="1PE 4:7" /><verse number="8" style="v" sid="1PE 4:8" />आखाम ती आखा सी वारु वात जी छे की एक दीसरा सी जादा परम राखु; काहाकी परम काय पाप काजे ढाक देय।<note caller="+" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="PRO 10:12">नीतीवचन 10:12</ref></char></note> <verse eid="1PE 4:8" /><verse number="9" style="v" sid="1PE 4:9" />कुड़-कुड़ करे पाखुर एक दीसरान मेजवानीन-खातरी करु। <verse eid="1PE 4:9" /><verse number="10" style="v" sid="1PE 4:10" />तीनाक जु वाटु जड़लो छे, चु हीनाक भगवानेन खास गीण-दयान वारु देख-रेख राखणेवाळान तसा एक दीसरान चाकरी मां लागाड़ु। <verse eid="1PE 4:10" /><verse number="11" style="v" sid="1PE 4:11" />कदी कुय कह्‌वे, ती असु कह्‌वे मानु भगवानेन बुल छे; कदी कुय चाकरी करे, ती हीनी ताकत सी करे जु भगवान आपे; जेरो आखी वात मां ईसु मसीन साहरे, भगवानेन सेक-सींगार उजेंती हवे। सेक-सींगार ने ताकत जलम पीड़ीडीट हेरोत छे। असोत हवतो रवे।<verse eid="1PE 4:11" /></para>
  <para style="s">मसीन दुखे मां साजल्‌या हवणु</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 4:12" />ए लाटेक्‌ला, भायस ने बहणस्‌या ज्‌य दुखेन रुप मां आकठो तुहुंंक पारखणे करीन तुंद्‌रे मां आवसे, हेरसी ज्‌य समजीन मां सुसवारु की कुय जसी-वसी वात तुंद्‌रे पर वीत रय। <verse eid="1PE 4:12" /><verse number="13" style="v" sid="1PE 4:13" />बाकुन जत्‌यार तुहुंं मसीन दुख मां साजल्‌या हवे, ती खुसी मानावु, जेरेसी हेरी सेक-सींगार उजेंती हवते टेमे बी तुहुंं खुसी ने धव हवु। <verse eid="1PE 4:13" /><verse number="14" style="v" sid="1PE 4:14" />अळतेन कदी मसीन नाव वाटे तुंद्‌री नाव-बद्‌दी करी जाय, ती बरकतवाळा छे; काहाकी सेक-सींगारेन आत्‌मा, जो भगवानेन आत्‌मा छे, तुंद्‌रे मां छावायली रहे। <verse eid="1PE 4:14" /><verse number="15" style="v" sid="1PE 4:15" />तुंद्‌रे मां सी कुय माणुस हत्‌या करन्‌यु नीते चुट्‌टु, नीते पापी हवणे, नीते दीसरा काम मां हात नाखेन वजे सी दुख नी हाकलनु चाहजे। <verse eid="1PE 4:15" /><verse number="16" style="v" sid="1PE 4:16" />बाकुन कदी मसी मां हवणेन वजे दुख जड़े, ती सरमायु मां, बाकुन हीनी वात वाटे भगवानेन नावेन सेक-सींगार करु।<verse eid="1PE 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 4:17" />काहाकी ची घड़ी आय गुयलु छे, की पेहल भगवानेन माणसेन नीयाव हवसे, ने जत्‌यार की नीयाव सुरु हामरे सी हवे ती हींद्‌रो आकरी कसों हवसे जो भगवानेन खुस-खबर काजे नी माने?<note caller="+" style="x"><char style="xo" closed="false">4:17 </char><char style="xt" closed="false"><ref loc="HEB 12:24">ईब्‌रानीयो 12:24</ref>,<ref loc="HEB 12:25">25</ref>; <ref loc="JER 25:29">यीरम्‌या 25:29</ref>; <ref loc="EZK 9:6">यहेजकेल 9:6</ref></char></note> <verse eid="1PE 4:17" /><verse number="18" style="v" sid="1PE 4:18" />ने कदी धरमी माणुस काजे काठाय सी छुटकारु जड़से,</para>
  <para style="q1" vid="1PE 4:18">“ती नी-भक्‌ती करने वाळा,</para>
  <para style="q2" vid="1PE 4:18">ने पापी माणसेन काय हवसे?”<note caller="+" style="x"><char style="xo" closed="false">4:18 </char><char style="xt" closed="false"><ref loc="PRO 11:31">नीतीवचन 11:31</ref></char></note><verse eid="1PE 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1PE 4:19" />हेरेसी जी भगवानेन मरजीन अनसारे दुख हाकले, चे भलाय करता जाय्‌न आपणा-आपणा जीव काजे भुरसान लायक कळ घड़न्‌यान हात मां सुप देय।<verse eid="1PE 4:19" /></para>
  <chapter eid="1PE 4" />
  <chapter number="5" style="c" sid="1PE 5" />
  <para style="s">भगवानेन माणसेन टुळु</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 5:1" />तुंद्‌रे मां जे मंडळीन डाहला छे, तीनु काजे मे समजाड़ीन जो कह्‌वो की, मे बी हींद्‌रेन तसु एक डाहलु छे, ने ईसु मसी जो दुख झेल्‌यु तीना दुखेन गवा छे, ने आवणे वाळा दाहड़ा मां उजेंता हवण्‌या ईसुन सेक-सींगार मां साजल्‌यु बी छे। <verse eid="1PE 5:1" /><verse number="2" style="v" sid="1PE 5:2" />तीनी ईसुन मंडळीन माणसेक भगवान तुंद्‌रे सुपरुत कर्‌यु, तीनु माणसेन तुहुंं वारु गुवाळी करु, जसा गुवाळ्‌या आपसा गाडरान राखवाळी करे। ने ज्‌य काम जबरान सी नी बाकुन भगवानेन मरजीन अनसारे वारु रीते करु। पयस्‌यान हायाळ्‌ळा बणी नी, बाकुन वारु खरला मन सी आपणा टुळान राखवाळी करु। <verse eid="1PE 5:2" /><verse number="3" style="v" sid="1PE 5:3" />ने तीनु माणसे काजे भगवान तुंद्‌रा हातेम सुप देदलु, तीनु माणसे पर तुहुंं जु करीन हक मां करु बाकुन भगवानेन गाडरा साय एक दाखलु बणीन जीवु। <verse eid="1PE 5:3" /><verse number="4" style="v" sid="1PE 5:4" />ने असा करसु ती मट्‌लु गुवाळ्‌यु ईसु मसी उजेंतु हवसे, तत्‌यार तुहुंं काजे सेक-सींगारेन पागड़ी आपसे, ची पागड़ी कदी चीमाये नी।<verse eid="1PE 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1PE 5:5" />हीनी रीते, ए जुवान्‌या तुहुंं बी पेहला माणसेन हक मां रवु। असा करीन आखान आखा, पुडार्‌या, जुवान्‌या, ने दीसरा बी, नीचळा हयन एक दीसरान सेवा चाकरी करने करीन तीयार रहु; काहाकी खरला सास्‌तुर मां लिखलो छे, “भगवान मटाय करन्‌यान वीरुद करतु रवे, बाकुन नीचळा माणसे पर गीण-दया करतु रवे।” <verse eid="1PE 5:5" /><verse number="6" style="v" sid="1PE 5:6" />हेरेसी तुहुंं भगवानेन ताकतवाळा हाते तळे नीचळा रवु, हेरेसी चु तुहुंंक सय टेम आवणे पर नानला ती मटा बणाय देसे। <verse eid="1PE 5:6" /><verse number="7" style="v" sid="1PE 5:7" />आपणी आखी फीकुरेन बुज भगवान पर मेक देवु। काहाकी चु तुंद्‌री फीकुर करे।<verse eid="1PE 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 5:8" />तुंद्‌रु वेरी भुतड़ु दाहड़ेन वाळा नाहरेन तसु, तुहुंंक फाड़ीन खाणे करीन हेर रयु; हेरेसी तुहुंं जागली करता रवु। <verse eid="1PE 5:8" /><verse number="9" style="v" sid="1PE 5:9" />ईसु पर भुरसु करन्‌या तुंद्‌रा भाय-बहणस्‌या, जे आखी कळी मां पुगला छे, चे बी तुंद्‌रेन तसा दुख झेल रया, जी वात हेर करीन भुरसा मां काठा रहु ने तीना भुतड़ान बराबरी करु। <verse eid="1PE 5:9" /><verse number="10" style="v" sid="1PE 5:10" />हय भगवान जु आखा गीण-दयान झोर छे, तीनाक तुहुंं ईसु मसी मां आपणी जलमेन सेक-सींगार वाटे बुलावला छे, तुहुंंक थुड़ीक वार लग दुख झेलनेन पछे आपसुत तुहुंंक पाक्‌कु ने काठु ने ताकत वाळु करसे। <verse eid="1PE 5:10" /><verse number="11" style="v" sid="1PE 5:11" />तेरोत ताकतवाळो राज जलम टेकलो रवे। आमीन।<verse eid="1PE 5:11" /></para>
  <para style="s">चिट्‌ठीन आकरी वात</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 5:12" />मे सीलवानुसेन हाते, तीनाक मे ईमानदार भायस छे करीन समजो, ईतरुक चिट्‌ठी मां लिखीन तुहुंंक समजाड़लु छे, ने जी गवाय देदलु छे की भगवान छाचलु गीण-दया जुत छे, हेरेमां काठा रवु।<verse eid="1PE 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 5:13" />जो बेबीलोन मां तुंद्‌रे अगळ नेवाड़ला माणसे छे, चु ने मसी मां मारु पुर्‌यु मरकुस बी तुहुंंक आवजु ने आवीस कह्‌वे। <verse eid="1PE 5:13" /><verse number="14" style="v" sid="1PE 5:14" />परम सी गुळा दीन एक दीसरा काजे आवजु ने आवीस कह्‌वु।</para>
  <para style="p" vid="1PE 5:14">तुहुंं आखा काजे जे ईसु मसी मां छे सांती जड़ती रवे।<verse eid="1PE 5:14" /></para>
  <chapter eid="1PE 5" />
</usx>