<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="HEB" style="id">- Bhilali Standard Project</book>
  <para style="h">ईब्‌रानी</para>
  <para style="toc3">ईब्‌रानी</para>
  <para style="toc2">ईब्‌रानी</para>
  <para style="toc1">ईब्‌रानी वाटे चिट्‌ठी</para>
  <para style="mt2">इब्रानियों के लिए पत्री</para>
  <para style="mt1">ईब्‌रानी वाटे चिट्‌ठी</para>
  <para style="imt">ईब्‌रानीन बारामां</para>
  <para style="ip">किताप एक हिम्‌मत बड़ावणेन चिट्‌ठी छे ज्‌य दरसावे की कसु ईसु जुन्‌डला नेमेन बेसकी भगवानेन अघी सी आवणेन वात काजे पुरी कर्‌यु। ज्‌य एक उपदेसेन तरा लिखी गुयो। ईब्‌रानी मां जुन्‌डला नेमेन 60 सी जादा दाखला छे ज्‌य साप रुप सी देखाड़े की कसु ईसु आवणे वाळी वात ने यहुदी मटला-पुजारान कामे काजे पुरो कर्‌या। हेरेसी जी किताप यहुदी ईसु पर भुरसु करन्‌या काजे हिम्‌मत बांदाड़ने वाळी हतली। ईब्‌रानी देखान्‌या की कसु ईसु कायदा काजे पुरु कर्‌यु काहाकी पुजारा काजे अळी कदी बादा नी आपणु पड़े। ईसु आखा पापे वाटे एक कावा ने जलम वाटे बादा हय गुयु। आपणा टेम मां ईसु पर भुरसु करन्‌या बी ईब्‌रानी काजे चिट्‌ठी मां हिम्‌मत जड़ सक्‌से की चे ईसु मसी पछळ चालता रवे, ज्‌य आपणे वाटे भगवान पर भुरसु करनु सय बणावे <char style="xt"><ref loc="HEB 12:2">12:2</ref></char> ने सातेत हीना पर भुरसु करतु रवणु।</para>
  <para style="ip">ईब्‌रानी काजे कुण लिख्‌यु ज्‌य कुय नी जाणे, बाकुन कायदा काजे जाणने वाळा नेवताळा पोलुस, लुका नीते बरनाबास जसु वीच्‌यार आप्‌या। लिखणेन तारीक बी हेर नी हय बाकुन बेसकान माननु छे की ज्‌य ईसु मसीन पयदा हवणेन 70 साल पेहल लिखी गुयलो। यरुसलेम काजे 70 मां खत्‌तम कर देदो, बाकुन हीनी चिट्‌ठी काजे लिखणे वाळु यरुसलेमेन बारामां वात करे जसु की ज्‌य हय लग खत्‌तम नी हयो। ईब्‌रानी काजे रोम सहर <char style="xt"><ref loc="HEB 13:24">13:24</ref></char> मां लिखी गुयलो ने सय बेसका मंडळ्‌या मां खबर फेलाया।</para>
  <para style="iot">बाहरती वात</para>
  <para style="io1">1. लिखणे वाळु देखाड़े की ईसु भगवानेन अघी आवणे वाळी वात बताड़न्‌या ने सरग वाळा काहवाळ्‌या सी माहान छे। <char style="ior"><ref loc="HEB 1:1-4:13">1:1—4:13</ref></char></para>
  <para style="io1">2. अळतेन चु देखाड़े की ईसु हीनु पुजारा सी माहान छे ज्‌य यरुसलेम मां भगवानेन मंदीर मां सेवा करे। <char style="ior"><ref loc="HEB 4:14-7:28">4:14—7:28</ref></char></para>
  <para style="io1">3. सातेत ईसु सेवान काम हीनी जुन्‌डला वायदा सी बी मटा छे ज्‌य भगवान आपणा माणसे साते हीना कायदान साहरे ज्‌य हीयु मुसा काजे आपली हतली। <char style="ior"><ref loc="HEB 8:1-10:31">8:1—10:31</ref> </char></para>
  <para style="io1">4. ज्‌य समजाड़णेन पछे ईसु आखी तरा सी माहान छे, लिखणे वाळु बेसकी वेहवारेन उपदेस देय। <char style="ior"><ref loc="HEB 10:32-13:17">10:32—13:17</ref></char></para>
  <para style="io1">5. आकरी मां लिखणे वाळु थुड़ाक हिम्‌मत देवाड़णे ने आव-भाव साते चिट्‌ठी काजे खत्‌तम करे। <char style="ior"><ref loc="HEB 13:18-25">13:18-25</ref></char></para>
  <chapter number="1" style="c" sid="HEB 1"/>
  <para style="s">भगवान हेरा पुर्‌यान साहरे आपणे सी वात करे</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1"/>पेहला युग मां भगवान, टेमे-टेमे ने ईतरीक-ईतरीक करीन, वारु रीते, आपसा बेसका भगवानेन अघली वात बताड़न्‌या माणसेन अनसारे आपणा डाहा-डाहा साते वात करलु। <verse eid="HEB 1:1"/><verse number="2" style="v" sid="HEB 1:2"/>बाकुन हय कळीन ईनु आकरी दाहड़ा मां भगवान आपसा पुर्‌यान साहरे आपणे साते वात कर रयु। चु ईना पुर्‌यान साहरे आखी कळजुग घड़्‌यु, ने ईना काजे आपसी आखी कळजुगेन हकदार्‌यु बी बणायु। <verse eid="HEB 1:2"/><verse number="3" style="v" sid="HEB 1:3"/>जु पुर्‌यु ते भगवानेन खरलु सीकु छे। चु आपसान ताकतवाळा बुलेन साहरे आखी चीजेक सामळे। ने चु हेरा खुन सी आपणा पापे काजे धुय देदु, ने सरगे जाय्‌न आखाम ताकतवाळा बास भगवानेन जेवड़्‌ये आंग्‌ये बठ गुयु।<verse eid="HEB 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 1:4"/>असु करीन भगवान तीनाक आपसी जागा आपीन सरग वाळा काहवाळ्‌या सी बेसकु मटु बणाय देदु। ने तीनाक तींद्‌रा नाव सी बी मटो नाव आप देदु।<verse eid="HEB 1:4"/></para>
  <para style="s">भगवान सरग वाळा काहवाळ्‌या सी बेसकु मटु छे</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 1:5"/>काहाकी भगवान काहना बी सरग वाळा काहवाळ्‌या काजे, कदी असु नी कह्‌यु,</para>
  <para style="q1" vid="HEB 1:5">“तु मारु पुर्‌यु छे,</para>
  <para style="q2" vid="HEB 1:5">ने हय सी मे, तारुत बास बण गुयलु छे।”</para>
  <para style="m" vid="HEB 1:5">ने काहनाक सरग वाळा काहवाळ्‌या काजे असु बी कह्‌यु,</para>
  <para style="q1" vid="HEB 1:5">“मेत तेरु बास बणीस;</para>
  <para style="q2" vid="HEB 1:5">ने चु मारु पुर्‌यु बणसे।”<verse eid="HEB 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 1:6"/>ने जत्‌यार भगवान आपसा पेहला खुळ्‌या काजे ईनी कळी मां लावलु, ती तीनु, सरग वाळा काहवाळ्‌या काजे कह्‌यु,</para>
  <para style="q1" vid="HEB 1:6">“ए मारा आखा सरग वाळा काहवाळ्‌या, तुहुं आखा हेरी भक्‌ती करु।”<verse eid="HEB 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 1:7"/>ने भगवानेन सरग वाळा काहवाळ्‌यान बारामां असो लिखलो छे,</para>
  <para style="q1" vid="HEB 1:7">जु आपसा आखा सरग वाळा काहवाळ्‌या काजे वाहळो बणावे,</para>
  <para style="q2" vid="HEB 1:7">ने आपसा चाकर्‌या काजे <note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="ft" closed="false">धधकती आग </char></note>आकठान लवळा बणावे।<verse eid="HEB 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 1:8"/>बाकुन भगवान आपसा पुर्‌यान बारामां कहवे:</para>
  <para style="q1" vid="HEB 1:8">“ए भगवान, तारी राजगादी जलम लग टेकली रवसे!</para>
  <para style="q2" vid="HEB 1:8">तारा राजेन डंड नीयावेन डंड छे।”<verse eid="HEB 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9"/>तु नीयाव सी परम कर्‌यु,</para>
  <para style="q1" vid="HEB 1:9">ने कुहराय सी रीस करे।</para>
  <para style="q2" vid="HEB 1:9">तेरेसी भगवान,</para>
  <para style="q2" vid="HEB 1:9">तुसेक तारा साते वाळा सी जादा <note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="ft" closed="false">हर्षरुपी तेल</char></note>खुसीन तेल चुपड़ीन नेवाड़ लेदलु छे।<verse eid="HEB 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 1:10"/>ने भगवानेन पुर्‌या काजे काहनुक कह्‌लु, चो खरला सास्‌तुर मां असो लिखलो छे,</para>
  <para style="q1" vid="HEB 1:10">“ए मालीक, तुत सुरु मां, धरतीक घड़्‌यु,</para>
  <para style="q2" vid="HEB 1:10">ने सरग बी तारेत हाते घड़ायलो छे।”<verse eid="HEB 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11"/>चे ते खत्‌तम हय जासे, बाकुन तु ते, तसुत रवसी;</para>
  <para style="q2" vid="HEB 1:11">आखी कळजुग पुथल्‌यान तसी जुन्‌ली हय जासे;<verse eid="HEB 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12"/>जसा माणसे जुन्‌ला पुथल्‌याक नाख दीन नवला पुथल्‌या पेहरे,</para>
  <para style="q2" vid="HEB 1:12">तसु तु जुन्‌ली कळजुग बणावसी। बाकुन तु ते, तसुत छे,</para>
  <para style="q1" vid="HEB 1:12">कदी नी बदले,</para>
  <para style="q2" vid="HEB 1:12">ने तु जलम जीवतेलु रवसी।<verse eid="HEB 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 1:13"/>भगवान, आपसा सरगदुत मायन कुय काजे बी असु कदी नी कह्‌यु:</para>
  <para style="q1" vid="HEB 1:13">“जत्‌यार लग मे, तारा वेरीक,</para>
  <para style="q2" vid="HEB 1:13">तारा पाय मेलनेन पयड़ी नी बणाय दम; तत्‌यार लग,</para>
  <para style="q2" vid="HEB 1:13">तु मारे जेवड़ये आंग्‌ये बठ।”<verse eid="HEB 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 1:14"/>वीच्‌यार करु! आखा सरग वाळा खबर-लावण्‌या ते, भगवानेन सेवा करन्‌या जीव-आत्‌मा अतरात छे। भगवान तीनुक छुटकारु हात करने वाळान सेवा-चाकरी करने करीन मकले।<verse eid="HEB 1:14"/></para>
  <chapter eid="HEB 1"/>
  <chapter number="2" style="c" sid="HEB 2"/>
  <para style="s">मट्‌लु छुटकारु</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1"/>तेरेमां आपणु काजे अळी वदु मन लागाड़ीन ईसुन बारामां सामेळ्‌ळी आखी वात पर पुरो मन लागाड़नु चाहजे, नीते कांखुर मायन आपणु छाचाय सी छेटा हय्‌न भटकी जासुन। <verse eid="HEB 2:1"/><verse number="2" style="v" sid="HEB 2:2"/>सरग वाळा काहवाळ्‌यान साहरे कह्‌वली खबर अतरे जुरे हतली, की तीनी वात काजे काटीन जु काहनुक तीनी वातेक नी पाळतेलु, तीना काजे डंड जड़तेलु। <verse eid="HEB 2:2"/><verse number="3" style="v" sid="HEB 2:3"/>वीच्‌यार करु! कदी आपणु ईसु मसीन साहरे जड़ला अतरा मटा छुटकारान नीकारु कर देसु, ती आपणु कसा काय बचसु? ईना छुटकारान बारामां आखान पेहले मालीक ईसु कह्‌लु, ने अळी जे सामळ्‌या चे हेरु पुरावु देदा। <verse eid="HEB 2:3"/><verse number="4" style="v" sid="HEB 2:4"/>ने भगवान बी आपसी मरजीन अनसारे गवा देण्‌या काजे चुखला जीव-आत्‌मान वाटु आपीन, तींद्‌रे साहरे सहलाणी, ने चकराड़े असा वारु काम, ने भाती-भातीन ताकतवाळा काम देखाड़ीन आपसी गवाय देतु रयु।<verse eid="HEB 2:4"/></para>
  <para style="s">हामुक छुड़ावने वाळु</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5"/>आवणे वाळी कळी काजे, तेरे बारामां आपणु वात करने बाजी रया, तीनी नवली कळजुग काजे भगवान, आपसा सरग वाळा चाकर्‌यान कब्‌जा मां करने करीन नक्‌खी नी कर्‌यु। <verse eid="HEB 2:5"/><verse number="6" style="v" sid="HEB 2:6"/>हेरे बारामां चुखला सास्‌तुर मां काहनेस जागे काहनुक असी गवा देदु,</para>
  <para style="q1" vid="HEB 2:6">“माणुस कुण कहवाये ने तीनाक तु हेर करे?</para>
  <para style="q2" vid="HEB 2:6">ने माणसेन पुर्‌यु कुण छे, तेरी तु फीकुर करे?<verse eid="HEB 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7"/>भगवानेन सरग वाळा चाकर्‌या सी थुड़ुक नानु छे।</para>
  <para style="q2" vid="HEB 2:7">तु तेरा मुणका पर हकेन ने <note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">ईज्‌जतेन पागड़ी</char></note>ईज्‌जतेन पागड़ी बांदीन, राजान आव-भाव करे, तसोत तेरो आव-भाव करलु छे।<verse eid="HEB 2:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 2:8"/>तु तारे अनसारे घड़ायली आखी चीजेक तेरा हक मां कर देदु।”</para>
  <para style="p" vid="HEB 2:8">आखो काय माणसेन हक मां कर देदु, तेरो मतलब जो छे की भगवान, असी काहनी बी चीज तेरा हक मां करे पाखुर नी छुड़्‌यु, बाकुन आपणु काजे हय लग आखो काय माणसेन हक मां देखाव नी पड़े। <verse eid="HEB 2:8"/><verse number="9" style="v" sid="HEB 2:9"/>बाकुन हामु ज देखजे की सरगदुत सी नानु बणावलु छे, काहाकी भगवान आखो काय घड़लु छे, ने तेरे वाटे आखो काय घड़ायलो छे। करीन तीनाक जत वारु लागे की तेरु पुर्‌यु ईसु मसी, जु छुटकारु आपण्‌यु छे, चु माणुस बणीन ईनी कळी मां आवे ने भगवानेन दया सी बेसका पुर्‌या काजे सेक-सींगार मां लावणे करीन कुरुस पर मरनेन दुख झेले। <verse eid="HEB 2:9"/><verse number="10" style="v" sid="HEB 2:10"/>असु करीन भगवान, ईसु मसी काजे ईतरीक वार लग सरग वाळा काहवाळ्‌या सी नानुस बणाय देदु, ने चु ईसु, भगवानेन गीण-दया सी आखा माणसे वाटे मुतेन दुख झेल्‌लु। ने असु करीन भगवान तीना काजे सेक-सींगारेन ने ईज्‌जतेन पागड़ी पेहराय देदु।<verse eid="HEB 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 2:11"/>काहाकी चुखु करन्‌यु ईसु, ने चुखा हवण्‌या आपणु एकुत कळीम सी छे। ने ईनी कळीन मुखी भगवान बास छे। हेरेसी ईसु आपणु भायस कहवायणे नी लाजवाये। <verse eid="HEB 2:11"/><verse number="12" style="v" sid="HEB 2:12"/>हेरेसी ईसु भगवानेक कह्‌यु;</para>
  <para style="q1" vid="HEB 2:12">“ए भगवान, मारा भायस्‌यो मां, हव मारा जाती भाय मां मे तारा नाव काजे सामळाया करीस,</para>
  <para style="q2" vid="HEB 2:12">हव तुसेक मान्‌या माणसेन टुळा मां तारीत बड़ाय कर्‌या करीस।”<verse eid="HEB 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 2:13"/>ने ईसु अळी कह्‌यु, “मे भगवान मालीक पर भुरसु करीस।” ने ईसु, अळी कह्‌यु, “मे अतरुत नी, बाकुन जे पुर्‌या-पारी भगवान मालीक मेसेक आपलु, चे बी मारे भेळता छे।”<verse eid="HEB 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14"/>जसा भगवानेन पुर्‌या-पारी मास ने लुही मां भेसकाय रया, ती ईसु आपसुत बी तींद्‌रेन तसु हींद्‌रु <note caller="+" style="f"><char style="fr" closed="false">2:14 </char><char style="ft" closed="false">साजल्‌यु </char></note>साजल्‌यु बण गुयु, काहाकी मुतेन साहरे हीनाक मुत पर ताकत जड़ली मतलब भुतड़ा काजे रीकामु कर देदु। <verse eid="HEB 2:14"/><verse number="15" style="v" sid="HEB 2:15"/>ने जतरा मुतेन डर सी जीवन भर गुलामी मां फसला छे, हीनुक छुड़ाय ले। <verse eid="HEB 2:15"/><verse number="16" style="v" sid="HEB 2:16"/>आपणु जाणजे की, ईसु, भगवानेन सरग वाळा चाकर्‌या काजे नी समाळे, बाकुन अब्‌राहमेन अवल्‌यात काजे समाळे। <verse eid="HEB 2:16"/><verse number="17" style="v" sid="HEB 2:17"/>हेरेसी असो हवणु हतलो की, ईसु आखी वातो मां आपसा मनख्‌या भायसेन तसु बणे; पापेन बादा छुटीन पापी माणसेक भगवान धड़े मेळ कराड़े ने असो करीन भगवान वगे सी एक दयाळु ने ईमानदार डाहलु मुखी पुजारु बणे। <verse eid="HEB 2:17"/><verse number="18" style="v" sid="HEB 2:18"/>काहाकी जत्‌यार पारख मां रय्‌न बी दुख झेले; ती चु तींद्‌री मदत कर सके तींद्‌री पारख हवे।<verse eid="HEB 2:18"/></para>
  <chapter eid="HEB 2"/>
  <chapter number="3" style="c" sid="HEB 3"/>
  <para style="s">ईसु मुसा सी मटु छे</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1"/>अळतेन आपणु ईसु काजे भगवानेन वगे सी मकेल्‌लु नेवताळु ने <note caller="+" style="f"><char style="fr" closed="false">3:1 </char><char style="ft" closed="false">मुखी पुजारु</char></note>मुखी पुजारु करीन मानजे ने हुकारजे। ए मारा भाय बहणस्‌या, भगवान तुहुंक सरगेन हकदार्‌या बणने करीन बुलावलु छे; ने तुहुं बी भगवानेन चुखला माणसे बण गुयला छे। हेरेसी ईना ईसु पर तुहुं पुरो मन लागाड़ु। <verse eid="HEB 3:1"/><verse number="2" style="v" sid="HEB 3:2"/>आपणु जाणजे की, जसु भगवानेन अघली वात बताड़न्‌यु मुसु भगवानेन घरना आखा माणसेन नफा वाटे, भगवान अगळ ईमानवाळु रय्‌न काम कर्‌यु, तसुत ईसु बी जु भगवान तीनाक नेवाड़लु, तेरे वाटे ईमानवाळु रय्‌न आपणेन करता काम करने बाजी रयु। <verse eid="HEB 3:2"/><verse number="3" style="v" sid="HEB 3:3"/>काहाकी ईसु मुसा सी अतरु बड़ीन सेक-सींगार लायक समजी गुयु की जतरु घर बणावणे वाळु घर सी बड़ीन ईज्‌जत राखे। <verse eid="HEB 3:3"/><verse number="4" style="v" sid="HEB 3:4"/>काहाकी हरेक घर काजे बणावणे वाळु रवे, बाकुन चु आखो काय बणायु चु भगवानुत छे <verse eid="HEB 3:4"/><verse number="5" style="v" sid="HEB 3:5"/>मुसु ते भगवानेन आखा घरना चाकर्‌यान तसु भुरसु करे असु रयु, की जीनी वात काजे समजाड़ने वाळु हतलु तीनी वातेन गवाय आप्‌यु। <verse eid="HEB 3:5"/><verse number="6" style="v" sid="HEB 3:6"/>बाकुन ईसु मसी ते भगवानेन पुर्‌यान रुप मां भगवानेन घरनान हकदार्‌यु छे, ने कदी आपणु हिम्‌मत राखीन भगवानेन साहरे आपली आस पर टेकला रवसु, ती आपणुत भगवानेन घरना माणसे छे।<verse eid="HEB 3:6"/></para>
  <para style="s">नी भुरसान वीरुद मां चेतावणी देणु</para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 3:7"/>तेरेमां चुखली जीव-आत्‌मा कह्‌वे,</para>
  <para style="q1" vid="HEB 3:7">“कदी आज तुहुं भगवानेन बुल सामळु,<verse eid="HEB 3:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 3:8"/>ती आपणा मन काजे काठो मां करु।</para>
  <para style="q2" vid="HEB 3:8">जसा तुंद्‌रा डाहा-डाहा उजाड़्‌या बयड़ा मां करला।<verse eid="HEB 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 3:9"/>तीनी टेमे तुंद्‌रा डाहा-डाहा मेसेक पारेखला,</para>
  <para style="q2" vid="HEB 3:9">ने चे चाळीस साल लग मारा वारु कामेक देखला।<verse eid="HEB 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 3:10"/>हेरेसी मे रीसवायन तीनी पीड़ीन माणसेन बारामां असु कह्‌लु,</para>
  <para style="q2" vid="HEB 3:10">जे ते मारी वाट काजे उळखीन बी,</para>
  <para style="q2" vid="HEB 3:10">मारे वाट्‌ये नी चाल्‌या, ‘ईनु माणसेन भटकायण्‌यो मन छे।’<verse eid="HEB 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 3:11"/>तत्‌यार मे मारी रीस मां आय्‌न सगुन खाय्‌न कह्‌यु,</para>
  <para style="q2" vid="HEB 3:11">‘छाचलीन चे मारा आरामेन जागा मां नी भराय सके।’”<verse eid="HEB 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12"/>ए भायस्‌यो ने बहणस्‌या, तुहुं चेतीन रवु, नीते तुंद्‌रो मन कुहर्‌यो ने भुरसु नी करने वाळो हय जासे, ने तुहुं जीवतेला भगवान सी छेटा हय जासु। <verse eid="HEB 3:12"/><verse number="13" style="v" sid="HEB 3:13"/>बाकुन तुहुं, जत्‌यार लग आजुन दाहड़ु छे, तत्‌यार लग एक दीसराक हिम्‌मत आपीन समजाड़ता रहु, नीते कांखुर तुंद्‌रे मायन काहनुक पाप मां पड़ीन डेड़ अकल्‌यु बण जासे। <verse eid="HEB 3:13"/><verse number="14" style="v" sid="HEB 3:14"/>काहाकी हामु ईसु मसीन हकेन हीस्‌सु लेसु। ती हामु आपणा पेहला भुरसा पर जलम लग बणीन टेकला रवसु।<verse eid="HEB 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 3:15"/>जसों लिखलो छे;</para>
  <para style="q1" vid="HEB 3:15">“कदी आज तुहुं भगवानेन बुल सामळु,</para>
  <para style="q2" vid="HEB 3:15">ती आपणा मन काजे काठो मां करु,</para>
  <para style="q2" vid="HEB 3:15">जसा तुंद्‌रा डाहा-डाहा उजाड़्‌या बयड़ा मां आपसान मन काठो करला।”<verse eid="HEB 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16"/>भगवानेन बुल सामळीन बी भगवानेन वीरुद करीन काहना माणसे तीना काजे रीसवाड़्‌या? हेर राख्‌जु की, तीनु माणसे काजे भगवान मुसान साहरे, मीसरे देस मां सी छुड़ायन लावलु चेत माणसे भगवानेन वीरुद करीन तीनाक रीसवाड़ला। हेरेसी तुहुं ईनी वात काजे कमजुर घुण समजु <verse eid="HEB 3:16"/><verse number="17" style="v" sid="HEB 3:17"/>ने भगवान चाळीस साल लग कुणी पर रीसवायलु? चु तीनु माणसे पर अतरुत रीसवायलु, जे माणसे पाप करला, तींद्‌रे पर भगवानेन डंड आयु, ने चे मरीन उजाड़्‌या बयड़ा मां पड़ी रया। <verse eid="HEB 3:17"/><verse number="18" style="v" sid="HEB 3:18"/>ने भगवान कुणीन <note caller="+" style="f"><char style="fr" closed="false">3:18 </char><char style="ft" closed="false">सगुन</char></note>सगुन खाय्‌न असु कह्‌लु की, जे मारा आरामेन जागा मां नी भराय सके? भगवान तींद्‌रेत बारामां असु कह्‌लु, जे तेरु हुकुम नी मान्‌या। <verse eid="HEB 3:18"/><verse number="19" style="v" sid="HEB 3:19"/>हेरेसी आपणु ज देखजे की, जे भगवान पर भुरसु नी कर्‌या, चेत आरामेन जागा मां नी भराया सके।<verse eid="HEB 3:19"/></para>
  <chapter eid="HEB 3"/>
  <chapter number="4" style="c" sid="HEB 4"/>
  <para style="s">भगवानेन माणसेन आराम</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1"/>हेरेसी भगवानेन साहरे आरामेन जागा मां भरायणेन वायदु हय बी पुरु नी हयु, अतरे चेतीन रहु। नीते तीना आरामेन जागा मां भरायणु रय जासु। <verse eid="HEB 4:1"/><verse number="2" style="v" sid="HEB 4:2"/>काहाकी हामुक तींद्‌रेन तसा खुस-खबर सामळावलो हतलो। बाकुन चे तीनी खुस-खबर काजे सामळीन भुरसु नी कर्‌या, हेरेसी तीनुक सामळ्‌ळा बुले सी काय बी नफु नी हयु; काहाकी आरामेन जागाम भरायणेन जीत खुस-खबर आपणुक बी सामळावलो छे। <verse eid="HEB 4:2"/><verse number="3" style="v" sid="HEB 4:3"/>बाकुन हामु भुरसु कर्‌या, हेरेसी आपणु काजे तीना आरामेन जागा मां भरायणेन मुखु जड़ गुयलु छे,</para>
  <para style="q1" vid="HEB 4:3">“बाकुन जे भुरसु नी कर्‌या तींद्‌रे बारामां चु असु कह्‌वलु:</para>
  <para style="q2" vid="HEB 4:3">मे कीचवायन जी सगुन खादु, की चे मारा आरामेन जागा मां भराय नी सके!”</para>
  <para style="p" vid="HEB 4:3">हेरेसी आपणुक ज मालुम पड़े की भगवान ते कळी घड़ायली ती सीत ईना आरामेन बारामां कह्‌यु। <verse eid="HEB 4:3"/><verse number="4" style="v" sid="HEB 4:4"/>काहाकी सातवा दाहड़ान बारामां ज कह्‌यु की “भगवान आपसो आखो काम पुरो करीन सातवे दाहड़े आराम कर्‌यु।” <verse eid="HEB 4:4"/><verse number="5" style="v" sid="HEB 4:5"/>ने उपर वाळा दाखला मां आपणु असा भणजे, “चे मारा आरामेन जागा मां नी भराय सके।” <verse eid="HEB 4:5"/><verse number="6" style="v" sid="HEB 4:6"/>तीनु माणसेक पेहले आरामेन जागान खुस-खबर सामळावलो, चे हुकुम नी मान्‌या करीन तीना आरामेन जागा मां नी भराय सक्‌या। <verse eid="HEB 4:6"/><verse number="7" style="v" sid="HEB 4:7"/>हेरेसी बेसका दाहड़ा हय गुया, ने अळी भगवान दावुदेन अनसारे असु कह्‌लु की,</para>
  <para style="q1" vid="HEB 4:7">आज तुहुंक भगवानेन बुल सामळनेन अळी मुखु जड़ रयु,</para>
  <para style="q2" vid="HEB 4:7">हेरेसी तुंद्‌रेन तसा तुहुं आपणी छाती काठी मां करु।<verse eid="HEB 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 4:8"/>यहोसु कदी ईस्‌रायेली माणसेक आरामेन जागा मां पुगाड़ देतु, ती भगवान पछला दाहड़ाम दीसरा आरामेन दाहड़ान वात नी करतु। <verse eid="HEB 4:8"/><verse number="9" style="v" sid="HEB 4:9"/>अतरे आपणु ज जाणजे की, भगवानेन असामी धड़े आरामेन जागा मां भरायणेन दाहड़ु हय बी टाकायलुत रय रयु। <verse eid="HEB 4:9"/><verse number="10" style="v" sid="HEB 4:10"/>जु तीना आरामेन जागा मां भराये, चु आपसो काम पुरो करीन तीना आरामेन जागा मां भराये, जसु भगवान बी हेरा काम काजे पुरो करीन आराम कर्‌यु। <verse eid="HEB 4:10"/><verse number="11" style="v" sid="HEB 4:11"/>ईस्‌रायेली माणसे हुकुम नी मान्‌ने सी सर गुया, तसा आपणुक नी हवणु चाहजे। नी ते आपणु आरामेन जागाम भरायणे रय जासु। हेरेसी आपणु काजे बी तीना आरामेन जागा मां जुर सी भरायणु चाहजे।<verse eid="HEB 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12"/>काहाकी भगवानेन बुले जीवतेला, ने ताकतवाळा, ने काहनी बी पाणी पावली दुय धारी तलवार सी बी अदु धारवाळा चर-चर छे। चे बुले हामरा जीवन उंडारा मां उतरी जाय, ने जीव-आत्‌मा मां भराय जाय, ने हाटकान गाठो मां भराय जाय, ने हाटकान गीर मां बी भराय जाय; ने माणसेन मनेम वाळी वात काजे ने वीच्‌यार काजे पारखी लेय। <verse eid="HEB 4:12"/><verse number="13" style="v" sid="HEB 4:13"/>ने भगवानेन साहरे घड़ायली ईनी कळी मां काहनी बी चीज भगवान सी सातायली नी हय, तेरे अगळ आखी चीज उगाड़ली छे। ईना भगवान अगळ आपणुक लेखु देणु पड़से।<verse eid="HEB 4:13"/></para>
  <para style="s">ईसु आपणु मट्‌लु पुजारु</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14"/>हेरेसी आपणु एक डाहलु मुखी पुजारु छे, मतलब भगवानेन पुर्‌यु ईसु, सरगे काजे वेणकीन गुयलु छे, अतरे ए भायस्‌यो ने बहणस्‌या! आवु, आपणु तीना भुरसा पर वारु टेकला रवजे। <verse eid="HEB 4:14"/><verse number="15" style="v" sid="HEB 4:15"/>आपणु मुखी पुजारु ईसु ते आपणी लुलखाय मां आपणे साते दुखी हये। चु ते आपणेन तसु पापेन साहरे पारखायलु ते खरु, बाकुन तेबी चु गुनाळु नी नीकळ्‌यु। <verse eid="HEB 4:15"/><verse number="16" style="v" sid="HEB 4:16"/>हेरेसी आवु, आपणु भुरसा भेळा गीण-दयान राजगादी अगळ जाजे, काहाकी आपणे पर गीण-दया हवे, ने गीण-दया जड़े, ने तीनी गीण-दयान साहरे आपणु काजे मदत जड़े।<verse eid="HEB 4:16"/></para>
  <chapter eid="HEB 4"/>
  <chapter number="5" style="c" sid="HEB 5"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1"/>हामु जाणजे की, भगवान एकेक मुखी पुजारा काजे हारुन्‌या पुजारान घराणाम सी नेवाड़े ने भगवानेन ने माणसेन ईचमां रय्‌न माणसे वाटे भगवानेन सेवा करने करीन तीनाक कामे लागाड़े। चु भगवान अगळ अळी-अळीन माणसेन पापेन माफी वाटे भगवान अगळ भाती-भातीन बादा चड़ावे। <verse eid="HEB 5:1"/><verse number="2" style="v" sid="HEB 5:2"/>ने चु डाहलु पुजारु आपसुत लुल्‌गाय सी घेरवायलु रवे, हेरेसी चु <note caller="+" style="f"><char style="fr" closed="false">5:2 </char><char style="ft" closed="false">डेड़-अकल्‌या</char></note>डेड़-अकल्‌या ने भुल्‌या भटक्‌या माणसे साते नीचळु वेहवार कर सके। <verse eid="HEB 5:2"/><verse number="3" style="v" sid="HEB 5:3"/>हेरेसी तीनाक ते आपसान पापेन माफी वाटे जनवार्‌या मारीन पापेन माफी वाटे बादा चड़ावणु पड़े। <verse eid="HEB 5:3"/><verse number="4" style="v" sid="HEB 5:4"/>मुखी पुजारु बणनेन वाटु ईज्‌जतेन वात छे, बाकुन कुय बी जु वाटु आपणे आप नी लेय; बाकुन भगवानुत एकेक जणा काजे डाहलु पुजारु बणावणे करीन नेवाड़े। जसु भगवान आपसुत, हारुन्‌या काजे मुखी पुजारु बणावणे वाटे नेवाड़्‌यु।<verse eid="HEB 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 5:5"/>हेरेसी ईसु मसी बी आपसा मन सी डाहलु मुखी पुजारु बणीन ईज्‌जत हात नी कर्‌यु,<figure style="fig" alt="High priest with his priestly clothes and censer" file="hk00267c.tif" size="col" copy="Horace Knowles ©" ref="5:5">मुख्‌यु पुजारु, पुजरान पुथल्‌या ने धुपदानी साते</figure></para>
  <para style="q1" vid="HEB 5:5">बाकुन भगवानुत तीना काजे पुजारु बणायु,</para>
  <para style="q2" vid="HEB 5:5">ने तीनाक कह्‌यु, “तु मारु पुर्‌यु छे, ने मे आज सी तारु बास बण गुयलु छे।”<verse eid="HEB 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 5:6"/>हेरेसी दीसरे जागे बी कहलो छे,</para>
  <para style="q1" vid="HEB 5:6">“तु मलीकीसीदेक्‌यान तसु,</para>
  <para style="q2" vid="HEB 5:6">जलम भगवानेन <note caller="+" style="f"><char style="fr" closed="false">5:6 </char><char style="ft" closed="false">पुजारु</char></note>पुजारु बणीन रवसी।”<verse eid="HEB 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7"/>ईसु मसी ईनी धरती पर डील मां रवणेन टेमे, आयड़ी-आयड़ीन ने रड़ी-रड़ीन ने आसा पाड़ी-पाड़ीन, मरने सी बचाड़न्‌या भगवान धड़े लीलघाय ने दुवा करतेलु। ने चु आपसा काजे भगवानेन मरजी पुरी करने करीन तेरा हातेम सुपीन, आपसी खरली भक्‌ती देखाड़्‌यु। हेरेसी भगवान तेरी दुवा सामळी लेदु। <verse eid="HEB 5:7"/><verse number="8" style="v" sid="HEB 5:8"/>चु भगवानेन पुर्‌यु हतलु, तेबी चु दुख झेल्‌यु ने दुख झेलीन हुकुम मान्‌ने सीक्‌यु। <verse eid="HEB 5:8"/><verse number="9" style="v" sid="HEB 5:9"/>ने चु हुकुम मानीन पाक्‌कु हय गुयु, असु करीन ईसु मसी हुकुम मान्‌ने वाळा वाटे जलमेन छुटकारान वजे बण गुयु। <verse eid="HEB 5:9"/><verse number="10" style="v" sid="HEB 5:10"/>ने भगवान तीना काजे मलीकीसीदेक्‌यान तसु मुखी पुजारान वाटु आप्‌यु।<verse eid="HEB 5:10"/></para>
  <para style="s">भुरसा सी अलग हय जाणेन फळ</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11"/>हेरे बारामां मेसेक बेसकी वात कह्‌णु छे। बाकुन ची वात समजणु काठो छे, काहाकी तुंद्‌रा कान्‌टा बेहरा हय गुया। <verse eid="HEB 5:11"/><verse number="12" style="v" sid="HEB 5:12"/>हय लग ते, तुहुं सीकाड़न्‌या बण जाणु हतलो, बाकुन आज लग ते, तुहुं काजे भगवानेन बुलेन सुरु वाळी वातुत, अळी सीकाड़नु पड़ रयो। असो लागे की आज लग तुहुं काजे नानला पुर्‌यान तसों दुत चाहजे, बाकुन खाणु नी चाहतो। <verse eid="HEB 5:12"/><verse number="13" style="v" sid="HEB 5:13"/>जो आज लग दुत पीया करे, च हाल पुर्‌योत छे, ने तीनाक धरमेन वचनेन बारामां कम समज मां आवे। <verse eid="HEB 5:13"/><verse number="14" style="v" sid="HEB 5:14"/>बाकुन वारलु खाणो ते तीनु मटला माणसे वाटे छे, चे तींद्‌रा जीवन मां वारलु भुंडा काजे उळखणे सीक गुया।<verse eid="HEB 5:14"/></para>
  <chapter eid="HEB 5"/>
  <chapter number="6" style="c" sid="HEB 6"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1"/>हेरेसी आवु आपणु ईसु मसीन सुरु वाळी सीकापण काजे पाळता जाय्‌न अळी अगा पुरा-पुरा पाक्‌का हवता जाजे, ने मरला काम सी मन फीरवीन भगवान पर भुरसु करजे, <verse eid="HEB 6:1"/><verse number="2" style="v" sid="HEB 6:2"/>ने अळी-अळीन बपतीस्‌मा लेणेन सीकापण लेणु, ने अळी-अळीन हात मेलीन वीन्‌ती करनेन सीकापण लेणु, अळी-अळीन मर्‌या-सर्‌याम सी जीवता हवणेन सीकापण लेणु, ने अळी अळीन आकरी नीयाव हवणेन ने अमर जीवनेन बारामां सीकापण लेणु। <verse eid="HEB 6:2"/><verse number="3" style="v" sid="HEB 6:3"/>ने कदी भगवान चाहे ती हामु चत करजे।<verse eid="HEB 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4"/>काहाकी जे एक कावा भगवानेन वीजाळो हात कर लेदा, ने सरगेन वाटु हात कर लेदा, ने चुखला जीव-आत्‌मान वाटु हात कर लेदा। <verse eid="HEB 6:4"/><verse number="5" style="v" sid="HEB 6:5"/>ने भगवानेन वारलु बुल हात कर लेदा, ने आवणे वाळी नवली कळीन ताकतेन बारामां जाण लेदा। <verse eid="HEB 6:5"/><verse number="6" style="v" sid="HEB 6:6"/>कदी चेत भुरसा सी छेटा हय्‌न भटकी जाय, ती तीनुक पाप भीणी सी मन फेरवीन भगवान भीणी वाळनु ने पछा भुरसा मां लावणु, बेसको काठो छे। काहाकी भगवानेन पुर्‌यु ईसु काजे आपसा वाटे एक कावा अळी कुरुस पर चड़ावे, ने तेरे पर उजेंतु गुनु लागाड़े।<verse eid="HEB 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 6:7"/>एक खेतेन दाखलान साहरे तुहुं जी वात अळी वारु जाण सक्‌सु। धुळु ते वरसातेन पाणी काजे अळी-अळीन चुसे, ने जे किरसाण हळ जुपीन तीना खेतेक सेडे ने वेरे तींद्‌रे वाटे च मेर लावे, असु करीन चो खेत किरसाण्‌या वाटे भगवानेन वगे सी संयबरकत लावे। <verse eid="HEB 6:7"/><verse number="8" style="v" sid="HEB 6:8"/>बाकुन कदी ची जागा पाणी काजे अळी-अळीन चुसे ने किरसाण्‌या तीना खेतेम वारु काम करे, तेबी चो खेत तींद्‌रे वाटे काटासळ्‌या झाड़का ने गखर्‌या उंगाड़े, ती चो खेत किरसाण्‌या वाटे रीकामो ने गरा वाळो छे, ने आकरी कावा तीना खेतेक चे धपाड़ देसे तसुत ईसुन भुरसु छुड़न्‌या माणसे काजे भगवान नरक आकठा मां डंड आपसे।<verse eid="HEB 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9"/>ए लाटेक्‌ला, हामरे उपर लिखली वात सामळीन भणीन भळ जीव करसे; तेबी हामु तुंद्‌रे वाटे वारलु आस कर रया। हामुक पाक्‌कु भुरसु छे की, भगवान तुहुंक छुटकारा पुठ्‌ये आवणी आखी, संयबरकत आपसे। <verse eid="HEB 6:9"/><verse number="10" style="v" sid="HEB 6:10"/>काहाकी भगवान बयमान नी हय। तुहुं ते भगवानेन नावे, भगवानेन चुखला माणसेन मदत करीन परम देखाड़्‌या। ने हय बी परम करने बाजी रया। भगवान ते तुंद्‌रा ईनु कामेक ने दीसरा वारलु काम काजे कदी नी भुले। <verse eid="HEB 6:10"/><verse number="11" style="v" sid="HEB 6:11"/>तेरसी हामरी जी हर छे की, तुंद्‌रे मायन एकेक जणु मरता लग असुत काठी मेहनत करनु चाहजे। ती तुहुं छाचलीन तेरी आस कर रया च तुहुं काजे जड़ जासे। <verse eid="HEB 6:11"/><verse number="12" style="v" sid="HEB 6:12"/>हामरी जी मरजी छे की, तुहुं उजग्‌या घुण टेवायु। बाकुन तुहुं तीनु माणसेन तसा चालु, जे भगवान पर भुरसु करीन ने गम खाय्‌न ची आखी बरकत हात करने वाळा छे, ची बरकत आपणेन वायदु भगवान करलु छे।<verse eid="HEB 6:12"/></para>
  <para style="s">भगवानेन आखा वायदा भुरसु करे असा छे</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13"/>जत्‌यार भगवान अब्‌राहम धड़े वायदु करलु तत्‌यार भगवान काजे सगुन खाणे वाटे तेरे सी मटु कुय नी जड़्‌यु। चु आपसुत सगुन खाय्‌न असु वायदु कर्‌यु। <verse eid="HEB 6:13"/><verse number="14" style="v" sid="HEB 6:14"/>भगवान कह्‌यु, “मे छाचलीन तुसेक संयबरकत आपीस, ने तुसेक बेसकी अवल्‌यात आपीस।” <verse eid="HEB 6:14"/><verse number="15" style="v" sid="HEB 6:15"/>ने अब्‌राहम बेसकु गम खादु ने अळतेन भगवानेन वायदु आपसान जीवन मां पुरु हवतेलु देख्‌यु। <verse eid="HEB 6:15"/><verse number="16" style="v" sid="HEB 6:16"/>माणसे ते आपसा सी मटान नावलीन सगुन खाया करतेला, तींद्‌रे मां सगुनेन साहरे वात पाक्‌की हवे, ने काहनी बी लड़ाय सर जाय। <verse eid="HEB 6:16"/><verse number="17" style="v" sid="HEB 6:17"/>जु वायदु भगवान करलु, तीना वायदाक चु कदी नी बदले। अळतेन भगवान जु वायदु पाक्‌कु करने करीन अब्‌राहम साते सगुन बी खादु हेरेन करीन की अब्‌राहम मर जाय ने अळतेन बी अब्‌राहमेन अवल्‌यात, जे भगवानेन वायदान हकदार्‌या छे, चे बी ईना वायदा पर पाक्‌कु भुरसु करे। <verse eid="HEB 6:17"/><verse number="18" style="v" sid="HEB 6:18"/>हेरेसी जां आखी दुय वात छे, भगवानेन वायदु ने भगवानेन अनसारे खादली सगुन जे दुयु कदी नी बदले। भगवान लुच्‌चाय करन्‌यु नी हय। हेरेन करीन की आपणु जे भगवानेन अनसारे आवला छे, ने जी आस चु आपणुक वायदान साहरे आपलु छे, आपणु तीना वायदा पर पाक्‌कु भुरसु करजे। <verse eid="HEB 6:18"/><verse number="19" style="v" sid="HEB 6:19"/>जी आस हामरा जीव वाटे ढंड्‌यान पाक्‌का ने टेकीन रवण्‌या हेकड़ान तसी छे, ने जी आस आपणु काजे पड़दा पछळ सरगेन मंदीरेम रहण्‌या भगवानेन्‌चां लग पुगाड़ देसे। <verse eid="HEB 6:19"/><verse number="20" style="v" sid="HEB 6:20"/>ईना मंदीर मां ईसु मलीकीसीदक्‌यान तसु जलम लग मुखी पुजारु बणीन आपणे वाटे मेळ करान्‌यु बणीन भराय गुयु।<verse eid="HEB 6:20"/></para>
  <chapter eid="HEB 6"/>
  <chapter number="7" style="c" sid="HEB 7"/>
  <para style="s">पुजारान पुजारु मलीकीसीदक्‌यु</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1"/>जु मलीकीसीदक्‌या सालेमन सहरेन राजा हतलु, ने जु आखाम ताकतवाळा भगवानेन पुजारु हतलु, जलम लग पुजारु बणीन रवसे। जत्‌यार अब्‌राहम राजा काजे मारीन पछु आवती रवे, ती मलीकीसीदक तीनाक भेळु हय्‌न संयबरकत आप्‌यु। <verse eid="HEB 7:1"/><verse number="2" style="v" sid="HEB 7:2"/>ईनात मलीकीसीदक्‌या काजे अब्‌राहम आखी चीजेन <note caller="+" style="f"><char style="fr" closed="false">7:2 </char><char style="ft" closed="false">दसवु वाटु</char></note>दसवु वाटु आप्‌यु, ने मलीकीसीदक्‌या नावेन पेहलो मतलब छे, “धरमेन राजा।” हेरेसी ईना नावेन दुसरो मतलब छे “सालेमन राजु” नीते “सांती आपण्‌यु राजु।” <verse eid="HEB 7:2"/><verse number="3" style="v" sid="HEB 7:3"/>मलीकीसीदक्‌यान नीते आयस ने नीते बास ने नीते खानदानी हय, तेरा जीवनेन नीते सुरुवात हय ने नी आकरी हय; बाकुन भगवानेन एक खुळ्‌या पुर्‌यान तसुत भगवानेन नींगाम जलम पुजारु बन्‌लु रयु।<verse eid="HEB 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4"/>हय जाराक वीच्‌यार ते करु! जु मलीकीसीदक्‌यु कतरु मटु हतलु, चु बेसकु मटु हतलु, हेरेसी तीना काजे आपणा <note caller="+" style="f"><char style="fr" closed="false">7:4 </char><char style="ft" closed="false">डाहा-डाहान डाहलु बास अब्‌राहम्‌यु</char></note>डाहा-डाहान डाहलु बास अब्‌राहम लग जो लुटीन लावलु, तीनी चीजे मायन महंग्‌ली चीजेन लग दसवु हीस्‌सु दान कर्‌यु। <verse eid="HEB 7:4"/><verse number="5" style="v" sid="HEB 7:5"/>भगवान जे हुकुम कायदा मुसा काजे आपलु, तीनु कायदान अनसारे लेव्‌या कुळीन माणसे काजे जु हक जड़लु की चे आपसा भाय-बेटा धड़े दसवु वाटु लेणु चाहजे, भले चे अब्‌राहमेन कुळी मां पयदा हया हय। <verse eid="HEB 7:5"/><verse number="6" style="v" sid="HEB 7:6"/>बाकुन मलीकीसीदक्‌या ते लेव्‌या कुळीन बी नी हतलु, तेबी लेव्‌या कुळीन पुजारान डाहलु बास अब्‌राहम मलीकीसीदक्‌या काजे दसवु हीस्‌सु आप्‌यु। ने चु दसवु हीस्‌सु लीन अब्‌राहम काजे संयबरकत आप्‌यु, भले अब्‌राहम साते भगवान पेहलेन वायदु करलु। <verse eid="HEB 7:6"/><verse number="7" style="v" sid="HEB 7:7"/>ईनी वातेम काय बी संका नी हय की, संयबरकत आपण्‌यु, चु संयबरकत देण्‌या सी मटु रवे। <verse eid="HEB 7:7"/><verse number="8" style="v" sid="HEB 7:8"/>लेव्‌या कुळीन माणसे जे दसवु हीस्‌सु लेय, चे ते एक ने एक दाहड़ु मरन्‌यात छे। बाकुन तीना मलीकीसीदक्‌यान बारामां जां तेरी गवा दी छांडी, चु ते जलम लग जीवतेलु रवे। <verse eid="HEB 7:8"/><verse number="9" style="v" sid="HEB 7:9"/>जां आपणु जो बी कय सकजे की लेव्‌यु जु दसवु वाटु लेण्‌या छे, चु लगुन जां तेरी अब्‌राहमेन साहरे दसवु वाटु आप्‌यु। <verse eid="HEB 7:9"/><verse number="10" style="v" sid="HEB 7:10"/>काहाकी तीनी टेमे जत्‌यार मलीकीसीदक्‌यु अब्‌राहम काजे भेळु हवलु, तत्‌यार लेव्‌यु पयदा बी नी हयु ने पेहलेन अब्‌राहमेन डीलेम रय्‌न मलीकीसीदक्‌या काजे भेळु हवलु।<verse eid="HEB 7:10"/></para>
  <para style="s">ईसु मलीकीसीदक्‌यान तसु छे</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11"/>ईनु लेवी कुळीन साहरेत, माणसे काजे भगवानेन साहरे आपला कायदा जड़ला। कदी भगवान लेव्‌या कुळीन माणसे काजे पुजारान वाटु आपीन तींद्‌रे अनसारे आपणुक पुरा-पुरा पाक्‌का बणाय देतु, ती आपणुक दीसरु पुजारु मलीकीसीदक्‌या रीतीन अनसारे जलम लग पुजारान वाटु हात करीन, ने हारुनेन रीती नी कवाये। <verse eid="HEB 7:11"/><verse number="12" style="v" sid="HEB 7:12"/>काहाकी जत्‌यार मलीकीसीदक्‌यान अनसारे पुजारान कामेन वाटु बदले, ती कायदा बी बदलनुत चाहजे। <verse eid="HEB 7:12"/><verse number="13" style="v" sid="HEB 7:13"/>काहाकी तीना मलीकीसीदक्‌यान बारामां वात कह्‌ली छे, चु दीसरी कुळीन छे, ने तीनी कुळीन आज लग काहनु चुखली वेदी पर भगवानेन सेवा नी कर्‌यु। <verse eid="HEB 7:13"/><verse number="14" style="v" sid="HEB 7:14"/>ईनी वात सी जी वात पाक्‌की हय की मालीक ईसु यहुदीयान कुळी मां पयदा हय्‌न आयु, बाकुन मुसु ईनी यहुदीया कुळीम सी एक पुजारु आवसे असु नी कह्‌यु।<verse eid="HEB 7:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 7:15"/>ने मे जो कह्‌यु ची वात वारु चुखीझण उजेंती हय गुय, की मलीकीसीदक्‌यान तसु एक अळी पुजारु पयदा हय गुयु। <verse eid="HEB 7:15"/><verse number="16" style="v" sid="HEB 7:16"/>भगवान ईना दीसरा पुजारा काजे मुसान साहरे लिखला नेम कायदान अनसारे नी, बाकुन खत्‌तम नी हवे तीना जीवनेन ताकुतेन अनसारे पुजारु बणायु। <verse eid="HEB 7:16"/><verse number="17" style="v" sid="HEB 7:17"/>काहाकी तेरे बारामां भगवान जी गवाय देदु की “तु मलीकीसीदक्‌यान तसु जलम लग पुजारु बणीन रवसी।” <verse eid="HEB 7:17"/><verse number="18" style="v" sid="HEB 7:18"/>ने तेर अनसारे कुय बी पाक्‌कु धरमी नी बणे। जे ते, लुल्‌ला ने फालतु छे। हेरेसी चे कायदा सर गुया। <verse eid="HEB 7:18"/><verse number="19" style="v" sid="HEB 7:19"/>हेरेसी भगवान आपणु काजे एक असी बेसकु वारु आस आप्‌यु, तेरे साहरे आपणु भगवानेन्‌चां पुग सकजे।<verse eid="HEB 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 7:20"/>भगवान पेहले सगुन खाये पाखुर दीसराक पुजारा बणायन कामे लागाड़तेलु। बाकुन ईसु मसी काजे सगुन खायलीन मुखी पुजारु बणायु। <verse eid="HEB 7:20"/><verse number="21" style="v" sid="HEB 7:21"/>ईसु काजे पुजारु बणावणेन टेमे भगवान, सगुन खायलीन हेरे बारामां असु कह्‌यु,</para>
  <para style="q1" vid="HEB 7:21">“तु जलम लग मुख्‌यु पुजारु रवसी।</para>
  <para style="q2" vid="HEB 7:21">हव असु कय्‌न भगवान मालीक सगुन खादलु;</para>
  <para style="q1" vid="HEB 7:21">ने चु आपसु वीच्‌यार नी बदले।”<verse eid="HEB 7:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 7:22"/>ईनी सगुनेन साहरे आपणु काजे जो मालुम पड़े की ईसु मसी भगवानेन ने माणसेन ईचमां एक वारलु ने पाक्‌का वायदान जामनी देण्‌यु बण गुयु।<verse eid="HEB 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23"/>तीना पुजारा काजे मुत झेलनेन दाहड़ा लग जीवणे नी देदली, हेरेसी तीने टेमे बेसका जणा काजे पुजारा बन्‌नु पड़तेलो। <verse eid="HEB 7:23"/><verse number="24" style="v" sid="HEB 7:24"/>बाकुन जु ईसु मसी जलम लग जीवतेलु रवे; तेरेमां तेरु पुजारान वाटु, थुड़ाक दाहड़ान नी रवे बाकुन जलम लग रवसे। <verse eid="HEB 7:24"/><verse number="25" style="v" sid="HEB 7:25"/>हेरे वजे सी जु पुजारु माणसे वाटे वीन्‌ती करने करीन जलम लग जीवतेलु छे। अळतेन जे बी माणसे ईना पुजारान साहरे भगवानेन्‌चां आवे, तीनु माणसेक जु पुजारु पुरु-पुरु छुटकारु आप सके।<verse eid="HEB 7:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 7:26"/>जु डाहलु मुखी पुजारु चुखलु, ने खरलु, ने नी-गुनाळु हतलु, ने पापी माणसेन तसु नी हतलु, ने सरगे सी बी उचु हाकलायलु हतलु। ने असलुत डाहलु मुखी पुजारु आपणु काजे चाहजे। <verse eid="HEB 7:26"/><verse number="27" style="v" sid="HEB 7:27"/>ने जु पुजारु आपसा डीलेन बादा चहड़ावीन एकुत कावा मां पापेन माफीन काम पुरो कर देदलु। हेरेसी ईना पुजाराक दाहड़ीन दीसरा डाहला पुजारान तसों आपसा पापेन माफी वाटे ने दीसरान पापेन माफी वाटे जनवार्‌या मारीन बादा नी चड़ावणु पड़े। <verse eid="HEB 7:27"/><verse number="28" style="v" sid="HEB 7:28"/>मुसान कायदु ते, लुल्‌ला माणसे काजे डाहला पुजारान काम सुपे; बाकुन भगवान सगुन खाय्‌न जु वायदु कर्‌यु, चु वायदु तीना पुर्‌या काजे पुजारान काम सुपे, जु जलमसीत पुरु-पुरु पाक्‌कु बण गुयु हय।<verse eid="HEB 7:28"/></para>
  <chapter eid="HEB 7"/>
  <chapter number="8" style="c" sid="HEB 8"/>
  <para style="s">ईसु नवली बुलीन मुख्‌यु पुजारु</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1"/>हामु जी वात कर र्‌या ची जी छे की आपणे वाटे एक बेसकु मटु पुजारु छे, जु सरग मां आखान ताकतवाळा भगवानेन <note caller="+" style="f"><char style="fr" closed="false">8:1 </char><char style="ft" closed="false">राजगादी</char></note>राजगादी पर भगवानेन जेवड़े आन्‌गे बठ रयु। <verse eid="HEB 8:1"/><verse number="2" style="v" sid="HEB 8:2"/>ने छाचला तम्‌बुन चुखला जागान चाकर्‌यु बण गुयु, जां भगवानेन छाचली भक्‌ती हवे। ईना तम्‌बु काजे काहनु बी माणुस उबु नी कर्‌यु, बाकुन मालीक भगवानुत उबु करलु छे।<verse eid="HEB 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 8:3"/>काहनु बी डाहलु मुखी पुजारु भेट ने जनवार्‌या मारीन बादा चहड़ावणे करीन नेवाड़लु रवे। तेरेमां ईना डाहला पुजारा धड़े बी काहींग चहड़ावणे वाटे हवणु चाहजे। <verse eid="HEB 8:3"/><verse number="4" style="v" sid="HEB 8:4"/>कदी चु धरती पर रवतु, ती कदी चु पुजारु नी बणतु, काहाकी जी मुसान कायदान अनसारे, ईनी धरती पर बादा चड़ावण्‌या पुजारा ते छेत। <verse eid="HEB 8:4"/><verse number="5" style="v" sid="HEB 8:5"/>कदी चु एक असा भक्‌ती करनेन जागा भक्‌ती करे चो छाचलीन सरग मां हवणी पुजा-पाटेन सहलाणी छे। जत्‌यार मुसु तम्‌बु बणावणे हींडतेलु, ती तीनाक भगवान जो कय्‌न चीतायु की “देख, मे बयड़ा पर तम्‌बुन जी <note caller="+" style="f"><char style="fr" closed="false">8:5 </char><char style="ft" closed="false">सहलाणी</char></note>सहलाणी देखाड़लु छे, तेरेत अनसारे तु तम्‌बु बणावजी।” <verse eid="HEB 8:5"/><verse number="6" style="v" sid="HEB 8:6"/>बाकुन जो सेवान काम ईसु काजे जड़्‌यो, चो तींद्‌रा सेवान काम सी जादा वारु छे। काहाकी चु तीना नवला कायदान मेळ करावण्‌यु, चु नवलु कायदु, जुन्‌ला कायदा सी वारु छे, ने वारु सी वारु, वायदान अनसारे बांदली छे।<verse eid="HEB 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7"/>कदी पेहली जुन्‌ला कायदाम कसर नी हतली, ती दीसरी नवलु कायदान जरुवत नी पड़तो। <verse eid="HEB 8:7"/><verse number="8" style="v" sid="HEB 8:8"/>बाकुन भगवान काजे जुन्‌ली बुली पाळन्‌या माणसे मां कसर देखाव पड़ी, हेरेसी चु कह्‌यु;</para>
  <para style="q1" vid="HEB 8:8">“सामळु! भगवान मालीक जुर सी कह्‌यु, ची टेम आवसे,</para>
  <para style="q2" vid="HEB 8:8">तीने टेमे मे ईस्‌रायेली ने यहुदी माणसे साते, एक नवली बुली करीस।<verse eid="HEB 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9"/>भगवान मालीक अळी कह्‌यु, ‘जी बुली तीनी बुलीन तसी नी हय,</para>
  <para style="q2" vid="HEB 8:9">जी बुली मे ईस्‌रायेली माणसेन आड़ा-बुड़ा साते तीने टेमे करलु,</para>
  <para style="q1" vid="HEB 8:9">तीने टेमे मे तीनु काजे मीसरे देसो मां सी हात धरीन नीकाळीन लावलु।</para>
  <para style="q2" vid="HEB 8:9">तेबी चे मारी बुली मां ईमानदार नी रया। हेरेसी मे आडु भाळ लेदु।’<verse eid="HEB 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10"/>अळी भगवान मालीक कह्‌यु:</para>
  <para style="q2" vid="HEB 8:10">‘मे जी बुली आवणेवाळा दाहड़ा मां ईस्‌रायेली माणसे साते करीस,</para>
  <para style="q1" vid="HEB 8:10">ची जी छे की, मे मारा कायदा काजे तींद्‌रा मनो मां मेल दीस,</para>
  <para style="q2" vid="HEB 8:10">ने मे तीनु कायदा काजे तींद्‌रा छाती मन मां लिख दीस,</para>
  <para style="q1" vid="HEB 8:10">ने मे तींद्‌रु भगवान कहवायीस,</para>
  <para style="q2" vid="HEB 8:10">ने चेत मारा माणसे कहवायसे।’<verse eid="HEB 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11"/>ने तत्‌यार काहनाक बी,</para>
  <para style="q2" vid="HEB 8:11">आपसा सातेवाळा काजे,</para>
  <para style="q2" vid="HEB 8:11">ने भाय-बहणस्‌या असो सीकाड़नु नी पड़े की,</para>
  <para style="q1" vid="HEB 8:11">‘तु मालीक भगवान काजे उळखी ले।’</para>
  <para style="q2" vid="HEB 8:11">काहाकी नानला मटा आखा मेसेक उळख्‌से।<verse eid="HEB 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12"/>काहाकी मे तींद्‌रा पापेन माफी आप दीस,</para>
  <para style="q2" vid="HEB 8:12">ने तींद्‌रा पापेक कदी हेर नी करो।”<verse eid="HEB 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 8:13"/>भगवान ईनी बुली काजे चु नवली कह्‌यु, हेरेसी जो मालुम पड़े की, पेहली बुली काजे चु जुन्‌ली ठेहराय देदु, जो जुन्‌लो हय जाय, चो जीरने बाजी जाय, चो सरने वाळो छे। हेरेसी पेहली बुली काजे सरनुत छे।<verse eid="HEB 8:13"/></para>
  <chapter eid="HEB 8"/>
  <chapter number="9" style="c" sid="HEB 9"/>
  <para style="s">जुन्‌ली बुलीन साहरे भगवानेन पुजा-पाटेन रीती</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1"/>भगवानेन जुन्‌ली बुली मां बी भगवानेन पुजा-पाट करनेन रीतीन नेम हतला, ने तीनी पुजा-पाट वाटे ईनी धरती पर खास जागा बी हतली, चां एक तम्‌बु तान्‌लु हतलु। <verse eid="HEB 9:1"/><verse number="2" style="v" sid="HEB 9:2"/>तीना तम्‌बुन दुय खुणा हतला, ने खुणा काजे अलग करन्‌यु पड़दु बी हतलु। ने तीना तम्‌बुन पेहला खंगरा मां भीत हतली, ने टेबल हतली, ने टेबल पर भेट चहड़ावला रुटा हतला। ने ईना खुणा काजे चुखलु जागु कवतेला। <verse eid="HEB 9:2"/><verse number="3" style="v" sid="HEB 9:3"/>पड़दा पछळ वाळु दीसरा पड़दा पछळ चु तम्‌बु हतलु चुखलु जागु कहवायतेलु। <verse eid="HEB 9:3"/><verse number="4" style="v" sid="HEB 9:4"/>तीनी जागा मां सनान पेटी <note caller="+" style="f"><char style="fr" closed="false">9:4 </char><char style="ft" closed="false">धुप देणी वेदी</char></note>धुप देणी वेदी हतली। ने चां सनान झाळ चहड़ावली पेटी बी हतली। जो बुलीन पेटी कहवायतेली। तीनी पेटी मां भगवानेन बुलीन डायरी हतली, चे दगड़ान बन्‌ला हतला, तीनी पेटी मां हारुनेन लाकड़ी बी हतली, तीनी लाकड़ी पर एक कावा कोवेळ्‌ळा डीरा बी फुटी आवला। ने तीनी पेटी मां एक सनान कवड्‌यु बी हतलु, ने तीना कवड्‌या मां सरगे सी भगवानेन साहरे आपलो मन्‌ना नावेन खाणो भरीन मेल्‌लो हतलो। <verse eid="HEB 9:4"/><verse number="5" style="v" sid="HEB 9:5"/>ने तीनी पेटीन ढाकणान नाव गीण-दयान राजगादी हतलो। ने पेटी पर भगवानेन सेक-सींगारेन सहलाणीन वेस मां करुब नावेन पाखड़ावाळा दुय सरग वाळा खबर लावण्‌यान मुरत्‌या जुड़ायला हतला, जे पसतावान पाखड़ा फेलायन तीनी गीण-दयान राजगादी पर छावायन साहळु करतेला। बाकुन हय आखा बीडारान बारामां बताड़नेन टेम नी हय।<figure style="fig" alt="Interior of tabernacle" file="bk00278c.tif" size="span" copy="Horace Knowles ©" ref="9:2">भक्‌तीन घरेन माहें वाळु हीस्‌सु</figure><verse eid="HEB 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6"/>जु असु आखु तज्‌बु हतलु, ने अळी भगवानेन पुजारा पेहला, तम्‌बा मां दाहड़ीत भरायन, भगवानेन पुजा-पाटेन रीत कर्‌या करतेला। <verse eid="HEB 9:6"/><verse number="7" style="v" sid="HEB 9:7"/>बाकुन माहीं वाळा कमरा मां मुखी पुजारु अतरुत सालेम एकुत कावा जनवार्‌यान लुही लीन जातलु। ने चु आपसा ने दीसरान भुल्‌या-चुक्‌या गुनान माफी वाटे चां आखो भगवान अगळ ईना लुहीन बादा चहड़ावतेलु। <verse eid="HEB 9:7"/><verse number="8" style="v" sid="HEB 9:8"/>ईनी वातेन साहरे चुखली जीव-आत्‌मा जो देखाड़े की जत्‌यार लग पेहलु तम्‌बु उबु छे, ती लग चुखला जागाम भरायणेन वाट उजेंती नी हये। <verse eid="HEB 9:8"/><verse number="9" style="v" sid="HEB 9:9"/>जु तम्‌बु आजुन टेम वाटे एक सहलाणी छे; तीना तम्‌बु मां असी भेट ने बादान जनवार्‌या चहड़ावतेला। तेरेमां भक्‌ती करने वाळान मन चुखो नी हय सके। <verse eid="HEB 9:9"/><verse number="10" style="v" sid="HEB 9:10"/>हेरेसी जे ते खाणे-पीणे ने भाती-भातीन तीहवारेन रीतीन डीलेन नेम छे, ने भाती-भाती धुवणेन रीती करनु। जे नेम, नवला कायदा जड़ता लग ठेहरावला छे।<verse eid="HEB 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11"/>बाकुन हय ईसु मसी ते भगवानेन मुखी पुजारु बणीन आवलु। चु अळी जादा वारु ने पुरा-पुरा पाक्‌का तम्‌बु मायन भगवानेन्‌चां पुग गुयलु छे। जु तम्‌बु ईनी कळीन चीजे करीन माणसेन हाते बणावलो नी हतलो। <verse eid="HEB 9:11"/><verse number="12" style="v" sid="HEB 9:12"/>ईसु मसी तीना सरग वाळा तम्‌बु मां बुकड़ान ने केवड़्‌यान लुही लीन नी भरायु, बाकुन एकुत कावा आपसा लुहीन जलम लग भेट आपीन, चुखली जागाम भराय गुयु। असु करीन चु आपणे वाटे भगवान धड़े जलम लग छुटकारु हात, करीन आपणु काजे आप देदु। <verse eid="HEB 9:12"/><verse number="13" style="v" sid="HEB 9:13"/>जुन्‌डला कायदान अनसारे, बुकड़ा ने बेलेन लुही ने <note caller="+" style="f"><char style="fr" closed="false">9:13 </char><char style="ft" closed="false">धपला केवड़ान रखड़ु</char></note>धपला केवड़ान रखड़ु मुयळ्‌या माणसे पर नाखणे सी ने लुही छाटणे सी डीलेन मुयळो छेटे हय जाय, <verse eid="HEB 9:13"/><verse number="14" style="v" sid="HEB 9:14"/>ती ते तेरे सी बी जादा, ने पुरो पाक्‌को ईसु मसीन लुही छे। ईसु मसी ईना आपसा लुही काजे भगवानेन जलमेन जीव-आत्‌मान साहरे एक पाक्‌की बादान रुप मां भगवान अगळ आपणे वाटे नी-गुनाळा हय्‌न भेट कर देदु। हेरेसी आपणु काजे जीवतेला भगवानेन सेवा भक्‌ती कराड़ने करीन ईसु मसीन लुही आपणा मन काजे तीनु कुहर्‌या काम सी छुड़ावसे, ने आपणुक चुखा करसे। जे कुहर्‌या कामे आपणु काजे मुत भीणी ली जाय।<verse eid="HEB 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15"/>हय सामळु, भगवान पेहले वायदु करलु, तीने टेमे बी माणसे पाप कर्‌या, तीनुक पापेम सी छुड़ावणे करीन ईसु मसी कुरुस पर मरीन आपसु जीव आप देदु। ने चु ईसु मसी एक नवला वायदान मेळ कराड़न्‌यु बण गुयु हेरेन करीन की चु तीनु काजे बुलावलु छे, चे अमर जीवनेन वारीस हात करे।<verse eid="HEB 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 9:16"/>जत्‌यार जागा नाव पर करनेन वायदान पावती तीयार हये, ती जागा नाव पर करन्‌यान मुतन बारामां गवा बी हवणु चाहजे। <verse eid="HEB 9:16"/><verse number="17" style="v" sid="HEB 9:17"/>काहाकी असी जागा वायदान पावती, जागा आपण्‌यु मरे तीत पाक्‌की हवी, ने जत्‌यार लग जागा नावे करन्‌यु जीवतेलु रवे, ती लग जागान पावती नी बणे। <verse eid="HEB 9:17"/><verse number="18" style="v" sid="HEB 9:18"/>हेरेसी जुन्‌डला वायदान पावती बी जनवार्‌या काजे मारीन भगवान अगळ लुही चहड़ावे तीत तीयार हवतेली। <verse eid="HEB 9:18"/><verse number="19" style="v" sid="HEB 9:19"/>तीना जमाना मां जत्‌यार मुसा, कायदान आखा हुकुम माणसे काजे सामळाय देदु, ती चु केवड़ान ने बुकड़ान लुही ठाहराम झेलीन पाणीम भेसकी देदु, ने रातला गाडरान कान्‌या ने जुफा झाड़कान डाळखे करीन चामड़ान बणला कायदान किताप पर ने आखा माणसे पर छाट देदु। <verse eid="HEB 9:19"/><verse number="20" style="v" sid="HEB 9:20"/>ने कह्‌यु, “ज तीना वायदान लुही छे, तीना वायदा काजे पुरो करीन पाळनेन हुकुम भगवान तुहुं काजे आपलु छे।” <verse eid="HEB 9:20"/><verse number="21" style="v" sid="HEB 9:21"/>असु करीन मुसु तम्‌बु ने पुजा-पाटेन आखी चीज पर लुही छाट्‌यु। <verse eid="HEB 9:21"/><verse number="22" style="v" sid="HEB 9:22"/>छाचलीन, कायदान अनसारे आखी चीज लुही सी चुखी हवे; ने लुही उहवाड़े पाखुर पापेन माफी नी जड़े।<verse eid="HEB 9:22"/></para>
  <para style="s">मसीन बादा चड़ावणेन साहरे पाप धुवाय जाय</para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23"/>हेरेसी ज जरुड़ी छे की ईनी धरती पर जी चीज सरगेन चीजेन सहलाणीन रुप मां छे, तीनी चीज काजे जनवार्‌यान लुही सी चुखी करनु चाहजे, बाकुन सरगेन चीज काजे ते जनवार्‌यान लुही सी बी जादा वारु लुही सी चुखी करनु चाहजे। <verse eid="HEB 9:23"/><verse number="24" style="v" sid="HEB 9:24"/>काहाकी ईसु मसी तीना हाते करीन बांदला चुखला जागा मां नी भरायु, बाकुन आपणे वाटे हय सरगे मां भगवान अगळ हजुर हवणे करीन, सरगेत मां भराय गुयु। हात सी बणावलु चुखलु जागु ते छाचला चुखला जागान सहलाणी अतरुत छे। <verse eid="HEB 9:24"/><verse number="25" style="v" sid="HEB 9:25"/>डाहलु मुखी पुजारु हर साल दीसरा जनवार्‌यान लुही लीन चुखला जागा मां भरायतेलु। बाकुन ईसु तीना मुखी पुजारान तसु अळी अळीन आपसा डीलेन बादा चहड़ावणे करीन चुखला जागा मां नी भरायु। <verse eid="HEB 9:25"/><verse number="26" style="v" sid="HEB 9:26"/>ईसु अळी-अळीन आपसा डीलेन बादा चहड़ावणे करीन चुखला जागा मां भरायतु, ती तीनाक अळी-अळीन दुख झेलनु पड़तो; बाकुन चु ईनी कळीन आकरी दाहड़ा मां आपसा डीलेन बादा चहड़ावीन आपणा पाप छेटा करने करीन एकुत कावा माणुस बणीन आयु ने उजेंतु हयु। <verse eid="HEB 9:26"/><verse number="27" style="v" sid="HEB 9:27"/>जसों माणसे काजे एकुत कावा मरनु ने अळतेन तेरु नीयाव हवणु जरुड़ी छे, <verse eid="HEB 9:27"/><verse number="28" style="v" sid="HEB 9:28"/>तसुत मसी बी बेसका माणसेन पाप काजे हाकली लेणे वाटे एक कावा बादा चहड़ी गुयु; ने माणसे हेरी वाट देख र्‌या हींद्‌रा छुटकारा वाटे दीसरी कावा पाप नी हाकले तेबी देखायसे।<verse eid="HEB 9:28"/></para>
  <chapter eid="HEB 9"/>
  <chapter number="10" style="c" sid="HEB 10"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1"/>मुसान साहरे आपला नेम कायदा आवणेवाळी भलायन साहळु अतरुत छे। भलाय ते खरान आवणे वाळी हतली। ईना नेम कायदान साहरे ते सालो डीट एक सारकी बादा वाटे जनवार्‌या मारीन चहड़ाया करे। तेबी बादान जनवार्‌या चहड़ावणे सी तीनु भक्‌ती करन्‌या काजे पुरा-पुरा चुखा करीन पाक्‌का नी बणाय सके। <verse eid="HEB 10:1"/><verse number="2" style="v" sid="HEB 10:2"/>कदी नेम-कायदु तीनु काजे पुरा-पुरा चुखा करीन पाक्‌का बणाय देतु, ती ते, जनवार्‌या मारीन बादा चहड़ावणु खत्‌तम हय जातो; काहाकी तत्‌यार ते, भक्‌ती करन्‌या जलम लग चुखा हय जाता ने तींद्‌रा मनेन सान तीनुक तींद्‌रा पापेन बारामां गुनु नी लागाड़ती। <verse eid="HEB 10:2"/><verse number="3" style="v" sid="HEB 10:3"/>बाकुन चो सालो डीट तींद्‌रा पापेक हेर कराड़ीन पापी ठेहरावे। <verse eid="HEB 10:3"/><verse number="4" style="v" sid="HEB 10:4"/>बाकुन हसो नी हवे; बेलेन ने बुकड़ान लुही पाप काजे छेटा नी करे।<verse eid="HEB 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 10:5"/>हेरेसी ईसु मसी कळीम आवणेन टेमे भगवान काजे असु कह्‌यु,</para>
  <para style="q1" vid="HEB 10:5">तु माणसे धड़े तींद्‌रा पापेन बादा छुटणे करीन बादान चहड़ावु ने भेट नी मांग्‌यु,</para>
  <para style="q2" vid="HEB 10:5">बाकुन तु माणसे वाटे तींद्‌रा पापेन बादा छुटणे करीन बादान करता मारे धड़े एक डील तीयार करलु छे।<verse eid="HEB 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6"/>तु बाळीन होम करली बादा सी बी तु खुस नी हयु,</para>
  <para style="q2" vid="HEB 10:6">ने पापेन माफी हात करनेन बादा सी बी खुस नी हयु।<verse eid="HEB 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7"/>तत्‌यार मे भगवान काजे अळी कह्‌यु,</para>
  <para style="q2" vid="HEB 10:7">“ए भगवान! मे आय गुयलु छे, जसों तारी डायरी मां मारा बारामां लिखलो छे,</para>
  <para style="q2" vid="HEB 10:7">तसुत मे तारी मरजी पुरी करने तीयार छे।”<verse eid="HEB 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 10:8"/>ईसु मसी पेहले भगवान काजे असु कह्‌लु की, “तुसेक भाती-भातीन बादा जसी पापेन बादा ने बाळीन होम करली बादा नी चाही, ने तीनु बादा सी तु खुस बी, नी हयु” भले ची आखी बादा मुसान कायदान अनसारेत चहड़ावता आय रवला। <verse eid="HEB 10:8"/><verse number="9" style="v" sid="HEB 10:9"/>अळी ईसु मसी भगवान काजे असो बी कह्‌यु, “ए भगवान, मे तारी मरजी पुरी करने तीयार छे, ने मे हय जां छे।” असु करीन भगवान पापेन बादा छुटणेन पेहला कायदा, छेटे करदीन, नवलु कायदु उबु करे। <verse eid="HEB 10:9"/><verse number="10" style="v" sid="HEB 10:10"/>ने भगवानेन मरजीन अनसारे ईसु मसीन डीलेन एकुत कावा बादा चहड़ावणे सीत आपणु चुखा हय गुयला छे।<figure style="fig" alt="Burnt offering on an altar" file="hk00256c.tif" size="col" copy="Horace Knowles ©" ref="10:10">वेदी पर बादा चड़ावला</figure><verse eid="HEB 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11"/>हरेक पुजारा मंदीर मां उबा रय्‌न दाहड़ीत भगवानेन सेवान रीती भाती करे, ने भाती-भातीन जनवार्‌यान बादा एक सारका अळी अळीन चड़ाया करे, जी बादा पाप काजे कदी छेटे नी कर सके। <verse eid="HEB 10:11"/><verse number="12" style="v" sid="HEB 10:12"/>बाकुन जु ईसु मसी ते पापेन माफी काजे एकुत कावा आपसा डीलेन जलमेन बादा चहड़ावीन भगवानेन जेवड़्‌ये आंग्‌ये जाय्‌न बस गुयु। <verse eid="HEB 10:12"/><verse number="13" style="v" sid="HEB 10:13"/>ने तीने टेमे सी चां रय्‌न जी वाट देख रयु की तारा वेरी तारा पायेन पयड़ी बण जाणु चाहजे। <verse eid="HEB 10:13"/><verse number="14" style="v" sid="HEB 10:14"/>काहाकी ईसु मसी एकुत कावा आपसा डीलेन जलमेन बादा चहड़ावीन आखा काजे चुखा कर देदु, ने जलमकात <note caller="+" style="f"><char style="fr" closed="false">10:14 </char><char style="ft" closed="false">पाक्‌का</char></note>पाक्‌का कर देदु।<verse eid="HEB 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 10:15"/>भगवानेन चुखली जीव-आत्‌मा बी नवली बुलीन साहरे आपणुक जड़नी बरकतेन गवा छे, सास्‌तुर लिखण्‌याम रय्‌न चु असु देखाड़े,<verse eid="HEB 10:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16"/>भगवान, मालीक असु कह्‌यु,</para>
  <para style="q2" vid="HEB 10:16">की जे दाहड़ा पुरा हय जासे ने अळी मे तींद्‌रे साते जी बुली करीस,</para>
  <para style="q1" vid="HEB 10:16">मे मारा कायदा काजे तींद्‌रा मनो मां मेल दीस,</para>
  <para style="q2" vid="HEB 10:16">ने मे तीनु कायदा काजे तींद्‌रा मन मां लिख दीस।<verse eid="HEB 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 10:17"/>ने चु अळी कह्‌यु, “मे तींद्‌रा पाप काजे, ने गुना काजे कदी हेर नी करो।” <verse eid="HEB 10:17"/><verse number="18" style="v" sid="HEB 10:18"/>हय आखा काजे ईसुन बादा साहरे पापेन माफी जड़ जाय, ती अळी पापेन माफी वाटे बादा चहड़ावणु जरुड़ी नी हय।<verse eid="HEB 10:18"/></para>
  <para style="s">भगवानेन्‌चां आवु</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19"/>ए भायस्‌यो ने बहणस्‌या, ने जत्‌यार तीना ईसुन लुहीन साहरे आपणे वाटे एक नवली ने जीवतेली वाट तीयार करलु छे, चो आपणे वाटे चुखला जागा मां ली जाणे करीन उघड़ी गुयो, हेरेसी आपणु काजे सरगेन नवली ने जीवतेली वाटे मायन चुखला जागाम भरायणेन हिम्‌मत आय गुयली छे। <verse eid="HEB 10:19"/><verse number="20" style="v" sid="HEB 10:20"/>ने ईसुन डील एक पड़दा सांय छे। ईसु आपणे वाटे कुरुस पर दुख झेलीन, आपसा डीलेन बादा चड़ायु, ने आपसो लुही उहवाड़्‌यु, <verse eid="HEB 10:20"/><verse number="21" style="v" sid="HEB 10:21"/>ने हय ईसु आपणे वाटे भगवानेन घराणान हकदार्‌यु मुखी पुजारु छे। <verse eid="HEB 10:21"/><verse number="22" style="v" sid="HEB 10:22"/>ईसु आपसो लुही आपणे गुनु लागाड़न्‌या मनो पर छाटीन आपणुक चुखा करलु छे। ने आपणु सहलाणीन तार पर चुखले मने बपतीस्‌मान रीत लीन आपणा डीलेक धुवी बी लेदु। हेरेसी चालु, आपणु पाक्‌कु भुरसु करीन खरले मने भगवानेन्‌चां जाजे। <verse eid="HEB 10:22"/><verse number="23" style="v" sid="HEB 10:23"/>वायदु करन्‌यु भगवान ते, ईमानदार छे, हेरेसी आपणु जी आस कर रया, तीनी आस काजे छुड़नु नी हय, बाकुन आस करीन जुड़ायला रह्‌वणु छे। <verse eid="HEB 10:23"/><verse number="24" style="v" sid="HEB 10:24"/>ने एक दीसराक परम करने करीन ने एक दीसरान भलो करने करीन एक दीसराक हिम्‌मत देवाड़ु। <verse eid="HEB 10:24"/><verse number="25" style="v" sid="HEB 10:25"/>काहना-काहना ईसु पर भुरसु करीन बी, ईसुन मंडळीन मां जाणु छुड़ देदला छे। तुहुं असला माणसेन चाल मां धरु। बाकुन एक दीसराक समजाड़ीन सांती आपता रहु। ने जसा-जसा ईसुन आवणेन दाहड़ा धड़े आवता जाय, तसा तुहुं अळी-अळीन भेळा हय्‌न भगवानेन वात सीकता रहु, ने भगवानेन सेवा भक्‌ती करता रहु।<verse eid="HEB 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26"/>काहाकी खरली वातेन उळखाण हात करनेन पछे कदी हामु जाणी बुजीन पाप करता रवसुन, ती पापे वाटे अळी कुय बादा चड़ावणु नी रय। <verse eid="HEB 10:26"/><verse number="27" style="v" sid="HEB 10:27"/>हव, हसो हय ती ते, असला माणसेक हय बीहाड़े असा नीयावेन दाहड़ान वाट देखणु ने उलाह्‌ये नी असली आकठीन वाट देखणु अतरोत रय रयो, जी आकठी भगवानेन वीरुद करन्‌या काजे खाय जासे। <verse eid="HEB 10:27"/><verse number="28" style="v" sid="HEB 10:28"/>जत्‌यार काहनुक मुसान कायदाक नी मान र्‌यु हय ती, दुय नीते तीन जणान गवाय पर, पाखुर दया करे मार देय, <verse eid="HEB 10:28"/><verse number="29" style="v" sid="HEB 10:29"/>ती सुची लेवु की चु कतरु अळी बी भारी डंडेन लायक ठेरसे, जु भगवानेन पुर्‌या काजे पाये सी लातायन कुचर्‌यु ने वायदान लुही काजे, जेरे साहरे चु चुखलु ठेराय गुयलु वीटेळ्‌ळु समजी गुयु ने गीण-दयान आत्‌मा काजे अपमान कर्‌यु। <verse eid="HEB 10:29"/><verse number="30" style="v" sid="HEB 10:30"/>डंड आपण्‌यु भगवान जो कह्‌यु, “बदलु लेणु मारो काम छे, मे बदलु लीस।” ने चु अळी ज बी कह्‌यु, “मालीक भगवान आपसा माणसेन नीयाव करसे।” ईना भगवान काजे आपणु जाणजे बी। <verse eid="HEB 10:30"/><verse number="31" style="v" sid="HEB 10:31"/>जीवतेला भगवानेन हाते डंड भुगतणु ते बेसकु बीहाड़े असो छे।<verse eid="HEB 10:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32"/>तुहुं तीनु पेहला दाहड़ाक हेर करु, तीनी टेम मां तुहुं खुस-खबरेन वीजाळो देखीन मान लेदला, ने बेसका दुख मां ने भुरसा मां टीकला रया। <verse eid="HEB 10:32"/><verse number="33" style="v" sid="HEB 10:33"/>तीनी टेमे माणसे, तुंद्‌रे मायन काहनुक आखा अगळ वात नीकाळ्‌यु ने वेला पाड़्‌या ने तुहुं तींद्‌री मान लेदा, ने तुंद्‌रे मायन काहनाक तीनु माणसे साते हतला सांती आपणे, तीनुक दीसरा माणसे वेला पाड़्‌या। <verse eid="HEB 10:33"/><verse number="34" style="v" sid="HEB 10:34"/>तुहुं ईसु पर भुरसु करन्‌या तीनु माणसे पर दया कर्‌या, तीनु काजे जेलेम कुंड देदला, ने वीरुद करन्‌या माणसे तुंद्‌रो माल धन हापकीन ली जाती रया, तेबी तुहुं खुस हतला; काहाकी तुहुं वीच्‌यार करतेला की भगवान हामरे वाटे ईनी धरती पर माल धन सी बी वारलु ने जलम टीकणेवाळो अमर जीवनेन माल धन सरगेम मेल रयु। <verse eid="HEB 10:34"/><verse number="35" style="v" sid="HEB 10:35"/>हेरेसी तुहुं हिम्‌मत घुण हारु। काहाकी तेरो काम बेसको मटो छे। <verse eid="HEB 10:35"/><verse number="36" style="v" sid="HEB 10:36"/>तुहुं गम खाय्‌न भगवानेन मरजी पुरी करसु, ती भगवान, तुहुंक जो आपणेन वायदु करलु छे, चो आपसे ने आपसे। <verse eid="HEB 10:36"/><verse number="37" style="v" sid="HEB 10:37"/>काहाकी चु आवणे वाळु छे,</para>
  <para style="q1" vid="HEB 10:37">“चु थुड़ीक टेम मां आवसे,</para>
  <para style="q2" vid="HEB 10:37">ने चु वार नी लागाड़े।<verse eid="HEB 10:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="HEB 10:38"/>मारो वारु काम करने वाळा माणसे,</para>
  <para style="q2" vid="HEB 10:38">भुरसा सी जीवन जीवसे,</para>
  <para style="q2" vid="HEB 10:38">ने जु कुय पछु हवसे तेरे सी मे खुस नी रव।”<verse eid="HEB 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 10:39"/>बाकुन हामु ते भुरसु छुड़ीन पछा सरेकण्‌या मायन नी हय, बाकुन हामु तीनु मायन छे, जे भगवानेन भुरसा पर टेकला रय्‌न आपसा जीव-आत्‌मा काजे बचाड़े।<verse eid="HEB 10:39"/></para>
  <chapter eid="HEB 10"/>
  <chapter number="11" style="c" sid="HEB 11"/>
  <para style="s">भुरसान दाखलु</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1"/>ती भुरसु काय छे? भुरसु जु छे की जो आपणु नी देख्‌या, ने तेरी आस आपणु कर रया, चत छे, ने भगवान चो आपणुक आपसे ने आपसे। असो मनेम पाक्‌को ठाणी लेणुत भुरसु छे। <verse eid="HEB 11:1"/><verse number="2" style="v" sid="HEB 11:2"/>काहाकी आपणा डाहा-बुड़ा भगवान पर पाक्‌कु भुरसु करला करीन भगवान तींद्‌रे बारामां वारु बताड़्‌यु।<verse eid="HEB 11:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 11:3"/>भुरसान साहरेत आपणु ज जाणजे की भगवानेन बुलेन साहरे आखी कळजुग घड़ायली छे। ने ज काय देखाये ने मालुम पड़े च आखो देखाये ने मालुम पड़े असली चीजेम सी घड़ायो।<verse eid="HEB 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4"/>भुरसु करीन आदमेन नानलु पुर्‌यु हाबील, आपसा मटला भायस केन्‌या सी वारु भेट चहड़ायु; ने भगवान तेरी बादा मानी लेदु। असु करीन चु हाबील भुरसान साहरेत भगवान वगे सी वारु गीणायु। हेरेसी चु मरीन बी हय लग आपणुक भगवान पर भुरसान बारामां सीकाड़तु रयु।<verse eid="HEB 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 11:5"/>भगवान पर भुरसु कर्‌यु करीन हनोक मरे पाखुर डील भेळु सरगे मां हाकलाय गुयु; ने चु अळी पछु काहनाक बी देखाव नी पड़्‌यु, काहाकी भगवान तीनाक हाकलीन ली जाती रवलु। हेरेसी जी वात चुखीझण छे की, भगवान तीनाक हाकलीन ली जाणेन पेहलेत, तेरे बारामां असी गवा देदु की, हयु मेसेक गमे असो काम करे। <verse eid="HEB 11:5"/><verse number="6" style="v" sid="HEB 11:6"/>भगवान पर भुरसु करे बीगुर कुय बी भगवान काजे खुस करनु काठो छे। जु भगवानेन्‌चां जाणेन हेर करे तीना काजे भुरसु करनु चाहजे की भगवान छे, ने चु तीनु आखा माणसेन भलो करे, ने आपणा हेरने वाळा काजे फळ आपे।<verse eid="HEB 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 11:7"/>भगवान पर भुरसु करीन नुह आवणेवाळी मुसळ धार पाणीन गरान बारामां भगवान धड़े सी खबर सामळीन आपसा घराणा काजे बचाड़ने करीन चकराय्‌न ढंड्‌यो बणायु। असलु मुसळ धार पाणी धरती पर कदी नी पड़्‌यु। तेबी हय लग देखणेम नी आयो तेरे बारामां भगवान कह्‌ली वात पर भुरसु कर्‌यु। नुहान भुरसु देखीन भगवान तीनाक धरमी गीण्‌यु, ने असु करीन चु खरला धरमेन हकदार्‌यु बण गुयु। बाकुन कळीन दीसरा माणसे ढंड्‌याम भरायन मरीन सर गुया, असु करीन नुह आखी कळीन माणसे काजे गुनाळु ठेहराय देदु।<verse eid="HEB 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8"/>जत्‌यार भगवान अब्‌राहम काजे अनजाण्‌या देस भीणी जाणे करीन बुलायु; ती चु, भगवान पर भुरसु करीन तेरु हुकुम मानीन तीना अनजाण्‌या देस भीणी चाल पड़्‌यु, जो देस तीनाक हक मां जड़ने वाळो हतलो, तीनाक जो नी मालुम हतलो की, चु कां जाणे बाजी रयु, तेबी चु भुरसु करीन चाल पड़्‌यु। <verse eid="HEB 11:8"/><verse number="9" style="v" sid="HEB 11:9"/>वायदु करला देसो मां पुग्‌यु, तत्‌यार बी चु तीना वायदान देसो मां जबरान हक जमाड़्‌यु, ने परदेसी माणसे मां वसी गुयु, ने एकुत वायदान हकदार्‌या आपसा पुर्‌या इसाक पुठ्‌ये ने इसाकेन पुर्‌या याकुप पुठ्‌ये खपड़ी बणायन रहणे बाजी गुयु। भगवान पर भुरसु करीन अब्‌राहम असु करलु। <verse eid="HEB 11:9"/><verse number="10" style="v" sid="HEB 11:10"/>चु ते तीना सरगेम वसला सहरेन वाट देख रवलु, ने तीना सहरेन पायु नाखीन घड़न्‌यु ने तीना सहरेक बणावणे वाळु भगवानुत छे।<verse eid="HEB 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 11:11"/>भगवान पर भुरसु करीन अब्‌राहमेन लाडी सारा बायरी डाहवारा मां बी भारपायेन ताकत हात करी; काहाकी ची असी मान लेदली की मे तुसेक पुर्‌यु आपीस करीन वायदु करन्‌यु भगवान छाचलु छे। <verse eid="HEB 11:11"/><verse number="12" style="v" sid="HEB 11:12"/>असो करीन मरला साय एकुत माणसेन साहरे सरगेन तारान तसी ने दर्‌या धड़ेन रेतळा तसी गीणाये नी असी अवल्‌यात हय गुय।<verse eid="HEB 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13"/>भुरसु करीन टेकला रय्‌न मर गुया। भगवान तीनुक ईनी कळी मां, जो-जो देख्‌यो ने बीन देख्‌यो आपणेन वायदा करलु, चो पुरो तीनुक नी आप्‌यु। चे मरनेन पेहले छेटेत रय्‌न भुरसु करीन चो देखीन खुस हय गुया, ने मान लेदा की, हामु ईनी कळी मां परदेसी ने वाटे चाला मुसाफीर्‌या छे; तेबी भगवान आपसा वायदा एक दाहड़े नीते दीसरे पुरा करसे ने करसे। असु करीन चे मरनेन पेहले छेटेत रय्‌न भुरसान डुळे भगवानेन वायदा पुरा हवतेला देख्‌या। <verse eid="HEB 11:13"/><verse number="14" style="v" sid="HEB 11:14"/>जे असी वात कह्‌वे, चे आपसी जीवाय साहरे ज चुखोझण देखाड़े की चे परदेसी देसेम रय्‌न आपसान देस काजे हेरने बाजी रया। <verse eid="HEB 11:14"/><verse number="15" style="v" sid="HEB 11:15"/>ने तीना देसेन वात सुचता ती, तीना देसेक हेर करीन पछा जाणेन वीच्‌यार करता, ती तीनुक तीना देसेम पछा जाणेन मुखु हतलु। <verse eid="HEB 11:15"/><verse number="16" style="v" sid="HEB 11:16"/>बाकुन चे तीना देसेम जाणेन वीच्‌यारुत नी कर्‌या। चे ते एक आखाम वारु देसेन, मतलब सरगेन देसेन हेरु पड़ रवला। हेरेसी भगवान, तीनु माणसेन भगवान कहवायणे नी लाजवाये; चु ते तींद्‌रे वाटे एक सहर बणावलु छे।<verse eid="HEB 11:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17"/>भगवान पर भुरसु करीन अब्‌राहम्‌यु पारखायणेन टेमे भगवानेन वायदा काजे छाचली मान लेदु, ने चु भगवानेन हुकुम मानीन इसाक काजे भगवान अगळ मारीन बादा चहड़ावणे तीयार हय गुयु। <verse eid="HEB 11:17"/><verse number="18" style="v" sid="HEB 11:18"/>हव तीना काजे भगवान असु कह्‌लु “इसाकेन साहरे तारी अवल्‌यात बड़से।” तीना इसाक काजे चु भगवान अगळ मारीन चहड़ावणे करीन तीयार हय गुयु। <verse eid="HEB 11:18"/><verse number="19" style="v" sid="HEB 11:19"/>काहाकी चु अब्‌राहम, भगवान पर असु पाक्‌कु भुरसु कर्‌यु की, भगवान मरला काजे बी मर्‌या-सर्‌याम सी जीवता करीन बठा कर सके ने एक कह्‌याम अब्‌राहम आपसा पुर्‌या इसाक काजे मर्‌या-सर्‌याम सी जीवतु हवलुत पछु हात कर लेदु।<verse eid="HEB 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 11:20"/>भगवान पर भुरसु करीन इसाक, मरनेन पेहले आपसा पुर्‌या याकुप ने एसाव काजे आवणेवाळा दाहड़ा वाटे संयबरकत आप्‌यु।<verse eid="HEB 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 11:21"/>भगवान पर भुरसु करीन याकुप मरने वेळाय युसुफेन दुयु पुर्‌या काजे एकेक करीन संयबरकत आप्‌यु, ने लाकड़ीन टेका लीन बी भगवानेन भक्‌ती कर्‌यु।<verse eid="HEB 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 11:22"/>भगवान पर भुरसु करीन युसुफ मरने वेळाय हुकुम आपीन असु कह्‌यु की, आपणा ईस्‌रायेली माणसे मीसरे देसेम सी छुटकारु हात करीन कनान देसेम जाती रवसे। बाकुन मे ते, मीसरे देसेम सी छुटकारु हात करे पाखुर मर जायस, हेरेसी तुहुं मारा हाटका लीन जाती रवजु।<verse eid="HEB 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23"/>जत्‌यार मुसु पयदा हवलु, तीन दाहड़ाम मीसर देसेन राजु असु हुकुम नीकाळ्‌यु की, ईस्‌रायेली जाती मां पयदा हवण्‌या आखा पुर्‌याक मार नाखु। मुसु बेसकु वारु हतलु, ने तेरा आयस बास समजी गुया की, जु एक खास पुर्‌यु छे हेरेसी मुसान आयस बास भगवान पर भुरसु करीन मीसर देसेन राजा सी बीहे बीगुर मुसा काजे तीन महना लग साताड़ी-साताड़ीन मटु कर्‌या।<verse eid="HEB 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24"/>भगवान पर भुरसु करीन, मुसु <note caller="+" style="f"><char style="fr" closed="false">11:24 </char><char style="ft" closed="false">हुस्‌यार </char></note>हुस्‌यार हय्‌न जु कय देदु की मे फीरोन राजान पुरेन पुर्‌यु नी हय। <verse eid="HEB 11:24"/><verse number="25" style="v" sid="HEB 11:25"/>मुसा काजे पाप मां थुड़ाक दाहड़ा लग मुजा लेणे सी भगवानेन माणसे पुठ्‌ये वेला करनु वारु लाग्‌यो। <verse eid="HEB 11:25"/><verse number="26" style="v" sid="HEB 11:26"/>मुसु ते भगवान धड़े जलमेन वाटान ईनाम हात करनेन वाट देख रवलु। हेरेसी तीनाक ते, मीसर देसेन धनेन मुजा लेणे सी भगवानेन मसीन नाव-बद्‌दी हवणु वारु लागे।<verse eid="HEB 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="HEB 11:27"/>मुसु ते वीन देख्‌या भगवान काजे देख्‌यु नी, बाकुन तेबी भुरसान साहरे देख रयु समजीन भगवानेन भुरसा पर टेक्‌लु रयु। हेरेसी भगवान पर भुरसु करीन मुसु राजान रीस काजे देखीन बी नी बीहु, ने मीसरे देस काजे छुड़दीन जाती रयु। <verse eid="HEB 11:27"/><verse number="28" style="v" sid="HEB 11:28"/>आखाम पेहले वाळा <note caller="+" style="f"><char style="fr" closed="false">11:28 </char><char style="ft" closed="false">पासका तीहवारेन दाहड़ाक</char></note>पासका तीहवारेन दाहड़ाक हेर करु, जत्‌यार माणसेन जीव लेणे आवण्‌यु सरग वाळु चाकर्‌यु, मीसर देसेम वाळा आखा माणसेन पेहले खुळ्‌या पुर्‌या काजे मारने हींडतेलु। तीने टेमे मुसु भगवान पर भुरसु करीन ईस्‌रायेली माणसेक जु हुकुम आप्‌यु, “तुहुं गाडरान पीला काजे मारीन तेरो लुही आपणा-आपणा घरेन बारकस पर चुपड़ी देवु, ती सरग वाळु तुंद्‌रु जीव नी लेय।”<verse eid="HEB 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="HEB 11:29"/>भगवान पर भुरसु करीन मुसान अगवाय मां ईस्‌रायेली माणसे, जसा सुकली जागाक वेणकीन जाय, तसात रातला दर्‌या काजे वेणकीन जाती रया। ने जत्‌यार मीसरे देसेन सीपायड़ा बी ईस्‌रायेली माणसेन तसा दर्‌या वेणकणे गुया, ती चे डुबीन मर गुया।<verse eid="HEB 11:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 11:30"/>भगवान पर भुरसु करीन ईस्‌रायेली जातीन माणसे, यरीहो सहरेन चारेमेर वाळा जाड्‌ला भीतड़ान सात दाहड़ा फेरा लागाड़्‌या, ने च सहरेन चारेमेर वाळो जाड्‌लो भीतड़ो उदरी गुयो। <verse eid="HEB 11:30"/><verse number="31" style="v" sid="HEB 11:31"/>यरीहो सहरेन राहाब, पेहल रंडी हतली, बाकुन अळी ची यहुदी माणसेन खरला भगवान पर भुरसु करी। ने थुड़ाक यहुदी माणसे राहाबी रहतेली तीना देसेम भेदु लेणे करीन आया, तत्‌यार ची भगवानेन भुरसे तीनु माणसेक आपसा घर मां आव-भाव करीन सात दीन साताड़ देदी। अळतेन ची आपसा सहरेन दीसरा माणसे भेळती नी सरी, जे भगवान पर भुरसु नी करतेला।<verse eid="HEB 11:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32"/>हय मे अळी अगु नी देखाड़तु। काहाकी मारे धड़े भगवान पर भुरसु करन्‌यान भुरसान बारामां एकेक करीन देखाड़नेन टेम नी हय। नीते मे गीद्‌यान, ने बाराकान, ने सीमसन, ने यीफत्‌यान, ने दावुदेन, ने समुएल ने भगवानेन अघली वात बताड़ने वाळा माणसेन भुरसान बारामां कय देतु। <verse eid="HEB 11:32"/><verse number="33" style="v" sid="HEB 11:33"/>चे भुरसु करीन बेसका ईलाकान राजा काजे जीत लेदा; ने वारु काम कर्‌या; भगवान तीनी चीजेक आपणेन वायदु करलु, तीनी चीजेक हात कर लेदा; ने नाहरेन मुंहडो बंद कर देदा; <verse eid="HEB 11:33"/><verse number="34" style="v" sid="HEB 11:34"/>भगवान पर भुरसु करीन आकठो उलवी देदा; तलवारेन धार सी बच गुया; लुल्‌गाय मां बी ताकतवाळा बण गुया; लड़ाय मां बी तेज नीकळ्‌या; वेरी माणसेन सीपायड़ा काजे रावण्‌या-तीवण्‌या कर देदा। <verse eid="HEB 11:34"/><verse number="35" style="v" sid="HEB 11:35"/>भगवान पर भुरसु करीन बायरा आपसा मरला सातेवाळा काजे जीवतेला हात कर लेदा; काहाकी भगवान तीनु काजे पछा जीवता कर देदलु।</para>
  <para style="p" vid="HEB 11:35">ने काहना ते भगवान पर भुरसु करीन दुख ने मुत सी छुटकारु हात करने नी हींड्‌या; चे हेरेसी असा करला काहाकी चे अमरेन जीवन वाटे, मर्‌या-सर्‌याम सी जीवता हवणेन आस कर रवला। <verse eid="HEB 11:35"/><verse number="36" style="v" sid="HEB 11:36"/>काय कतरा हासी उड़ाया; ने तीनुक सपाटा देदा; ने तींद्‌रे हात ने पाय मां कड़्‌या पेहरायन बांद देदा ने तीनुक जेलेम कुंड देदा। <verse eid="HEB 11:36"/><verse number="37" style="v" sid="HEB 11:37"/>काहनाक काजे दगड़ाया; ने जीवतेलात, लाकड़ा चीरनी आरी करीन चीरीन दुय टुकड़ा कर देदा; तीनु काजे पारख्‌या; असा करीन भगवान पर भुरसु करन्‌या गरीब हय्‌न, वेला करता जाय्‌न हीड़ा-पीड़ा झेलता जाय्‌न, गाडरान ने बुकड़ान खालड़ा पेहरी-पेहरीन अथान-अथा डंडवायता फीर्‌या। <verse eid="HEB 11:37"/><verse number="38" style="v" sid="HEB 11:38"/>ने चे बयड़ा मां, ने जंगल मां, ने ढाटान खंगरा मां, ने धरतीन खुबारामां अथान-अथा ढासता ने डंडवायता फीर्‌या। काहाकी ईनी कळी मां जे भगवान पर भुरसु नी करे, तींद्‌रे पुठ्‌ये रह्‌वणु, ईनु भुरसु करन्‌या वाटे बेसको काठो हतलो।<verse eid="HEB 11:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39"/>ने चे भगवान पर भुरसु कर्‌या, करीन भगवान तीनुक बेसकु वारु कय्‌न तींद्‌रे बारामां गवा देदु, तेबी भगवान तीनु काजे जो आपणेन वायदु करलु, च आज लग नी आप्‌यु। <verse eid="HEB 11:39"/><verse number="40" style="v" sid="HEB 11:40"/>काहाकी भगवान तीनु काजे आपणे पेहलुत सी पुरा-पुरा पाक्‌का करनेन एक खास युजना बणावलु।<verse eid="HEB 11:40"/></para>
  <chapter eid="HEB 11"/>
  <chapter number="12" style="c" sid="HEB 12"/>
  <para style="s">भगवान हामरु बास छे</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1"/>जत्‌यार भुरसान गवा पुरावा अतरी जबर आपणु काजे घेरी रया, ती चालु, आपणु भगवानेन वाट्‌ये रुकण्‌या आखी चीज काजे हेड़ीन छेटे कर देदा, ने गुचवाण मां नाखण्‌या पाप काजे छुड़ देदा ने तीनी दवड़ मां आपणु काजे अगा दवड़नु छे, तीनी दवड़ मां गम खाय्‌न अगा दवड़जे। <verse eid="HEB 12:1"/><verse number="2" style="v" sid="HEB 12:2"/>ईसु ते आपणा भुरसान पायु छे, ने पाक्‌कु करन्‌यु छे; हेरेसी तेरे भीणी एक हेट्‌या भाळीन जी भुरसान दवड़ दवड़जे। ने आपसा अगळ मेल्‌ली खुसी हात करने करीन लाजवाये पाखुर कुरुसेन दुख झेल्‌यु; ने दुख झेलीन भगवानेन राजगादी पर जेवड़्‌ये आंग्‌ये बस गुयु।<verse eid="HEB 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 12:3"/>हेरेसी ईना ईसु पर वीच्‌यार करु! ने तुंद्‌रु जीव फीकुर करीन हिम्‌मत नी हारनु चाहजे करीन चु पापी माणसेन वीरुद काजे वेठ लेदु। <verse eid="HEB 12:3"/><verse number="4" style="v" sid="HEB 12:4"/>बाकुन पाप साते लड़ाय करीन तुहुं काजे आज लग आपसो लुही उहवाड़नु नी पड़्‌यो। <verse eid="HEB 12:4"/><verse number="5" style="v" sid="HEB 12:5"/>तुहुं धरम सास्‌तुरेन जी सीकापण घुण ईसेरजु, तेरेमां तुहुंक बेटा करीन बुलाड़लु छे?</para>
  <para style="q1" vid="HEB 12:5">“ए मारा बेटा! मालीक तुसे काजे सुदारने करीन डंड आपे, तीनी वातेक कमजुर घुण समजे,</para>
  <para style="q2" vid="HEB 12:5">ने जत्‌यार चु तुसेक झीचकारे, ती हिम्‌मत हारीन हीयाव घुण छुड़े।<verse eid="HEB 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6"/>काहाकी भगवान तीनाक परम करे, तीनाक डंड बी आपे,</para>
  <para style="q2" vid="HEB 12:6">जसु तीना पुर्‌याक चु बेसकु जबर परम करे, तसु तीना पुर्‌याक डंड बी आपे।”<verse eid="HEB 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 12:7"/>तुंद्‌रे पर दुख आवे ती ज समजीन सेण कर लेजु की भगवान बास सुदारने करीन हामुक डंड आप रयु। काहाकी भगवान तुहुंक आपसा पुर्‌या समजीन तुंद्‌रे साते असु वेहवार करे। वीच्‌यार करु! असु काहनु बास हसे, चु आपसा पुर्‌याक सुदारने करीन डंड नी आप्‌यु हय? <verse eid="HEB 12:7"/><verse number="8" style="v" sid="HEB 12:8"/>कदी भगवान आपसा दीसरा पुर्‌याक सुदारने करीन डंड नी आपे, ती तुहुं बासेन खास पुर्‌यु नी हय, बाकुन दीसरान पुर्‌या कहवायसु। <verse eid="HEB 12:8"/><verse number="9" style="v" sid="HEB 12:9"/>आपणा धरती पर वाळा बासे आपणुक सुदारने करीन डंड आपतेला, तेबी आपणु तींद्‌री ईज्‌जत करतेला, ती वीच्‌यार करु! धरती पर वाळा बासेन ईज्‌जत करे, तेरे सी बी जादा आपणा जीव-आत्‌मान बासेन, ईज्‌जत नी करनु चाहजे काय? हेरेन करीन की तीना जीव-आत्‌मान बासेन हक मां रय्‌न आपणुक अमर जीवन जड़े। <verse eid="HEB 12:9"/><verse number="10" style="v" sid="HEB 12:10"/>ईनी कळीन बास ते दसो समज आवतेलो, तसु ईनी कळीम वाळी आपणा-आपणा जीवन काजे सुदारने करीन डंड आप्‌या करतेलु, बाकुन भगवान ते, आपणी जलमेन भलाय वाटे आपणुक डंड आपे। हेरेन करीन की आपणु तेरा चुखला साजल्‌या बण जाजे। <verse eid="HEB 12:10"/><verse number="11" style="v" sid="HEB 12:11"/>आपणुक सुदारने करीन डंड जड़े, तत्‌यार आपणुक वारु नी लागे, ने बेसको काठो लागे। बाकुन तेबी जे सुदारनेन डंड झेली-झेलीन पाक्‌का हय गुयला छे, तीनुक पेहली कावा चुखला धरमेन सांती आपण्‌यो फळ जड़से।<verse eid="HEB 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12"/>हेरेसी अळगा हात, ने कमजुर मांडा काजे काठा कर लेजु; <verse eid="HEB 12:12"/><verse number="13" style="v" sid="HEB 12:13"/>ने आपणा पाय वाटे सुदी वाट बणायन अगा जाता जावु, तेरे सी जे भुरसा मां लंगड़ा छे, चे डंडवाये नी, बाकुन वारका हय जासे।<verse eid="HEB 12:13"/></para>
  <para style="s">भगवानेक मां छुड़ु करीन समजाड़े</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14"/>हेरेसी आखा साते वारु रहु, ने चुखला रवणेन टेव पाड़ु। चुखला हये बीगुर काहनु बी भगवान काजे नी देख सके। <verse eid="HEB 12:14"/><verse number="15" style="v" sid="HEB 12:15"/>कुय बी भगवानेन गीण-दया सी आंग्‌ये नी रहणु चाहजे; हेरेन करीन चेतीन रहु। तुंद्‌री जीवाय मां काहना बी कड़वला ने नुकसाण करे असला झाड़कान तसी, कुहराय नी बड़नु चाहजे, जी आखा माणसे काजे बीगाड़ देय। <verse eid="HEB 12:15"/><verse number="16" style="v" sid="HEB 12:16"/>तुंद्‌रे मां कुय बी छीनाळ्‌यु नी हवणु चाहजे, ने एसावेन तसु भगवान पर भुरसु नी करन्‌यु, असु नी हवणु चाहजे, जु एकुत कावा खाणो खाणे वाटे आपसुत पेहलु हक वेच देदु। <verse eid="HEB 12:16"/><verse number="17" style="v" sid="HEB 12:17"/>तुहुं काजे मालम छे की चु अळी आपसा बास धड़े संयबरकत मांगणे करीन बेसकु हेर कर्‌यु, बाकुन ची संयबरकत तीनाक नी जड़ी। भले चु रड़ी-रड़ीन आपसा बास धड़े मेसेक संयबरकत आप दे कय्‌न वीन्‌ती कर्‌यु, तेबी तीना काजे संयबरकत आपणे करीन आपसा बासेन मन नी पीगळ्‌यो।<verse eid="HEB 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18"/>तुहुं असा बयड़ा साते नी आया, चु बयड़ु हाते करीन छीमाय जाय, ने जु आकठा मां हुड़ु-हुड़ु धपे, ने तेरे चारेमेर <note caller="+" style="f"><char style="fr" closed="false">12:18 </char><char style="ft" closed="false">काळ्‌ळा आदळान बळाह्‌वा रवे</char></note>काळ्‌ळा आदळान बळाह्‌वा रवे, ने तेरे चारेमेर आंदारो ने आंधी रवे, <verse eid="HEB 12:18"/><verse number="19" style="v" sid="HEB 12:19"/>ने जां फेप्‌यान अवाज रवे, ने जां बुलन्‌यान असु आकरी बुल रवे तीना बुलेक सामळन्‌या ईस्‌रायेली माणसे भगवान धड़े असी वीन्‌ती करने बाजी गुया की ए भगवान, हय अळी हामरे साते असी आकरी वात मां करे। <verse eid="HEB 12:19"/><verse number="20" style="v" sid="HEB 12:20"/>काहाकी भगवान असु हुकुम आपलु, की “कदी काहनो जनवार्‌या बी बयड़ा काजे टुचलसे ती, तीनाक दगड़ाटीन मार नाखु।” <verse eid="HEB 12:20"/><verse number="21" style="v" sid="HEB 12:21"/>चां अतरो बेसकु बीहाड़े असो देखायतेलो की मुसु कह्‌णे बाजी गुयु, “मे बेसकु बीही गुयु, मारेम कापणी भराय गुय।”<verse eid="HEB 12:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22"/>बाकुन तुहुं सीयोन बयड़ान्‌चां, आय रया जु बयड़ु जीवतेला भगवानेन सरग वाळा यरुसलेम सहर मां छे। ने चां लाखु करुड़ु सरग वाळा काहवाळ्‌या छे, चे खुसी मनावे <verse eid="HEB 12:22"/><verse number="23" style="v" sid="HEB 12:23"/>ने भगवान पर भुरसु करीन पेहेल मरन्‌या, मनार्‌यान बठक मां, ने ईसुन माणसेन्‌चां तींद्‌रा नावे सरगे मां लिखला छे, ने आखान नीयाव करन्‌या भगवानेन्‌चां, ने चुखोझण हय्‌न पाक्‌का हवण्‌या धरमीन जीव-आत्‌मान्‌चां आवला छे। <verse eid="HEB 12:23"/><verse number="24" style="v" sid="HEB 12:24"/>ने तुहुं मेळ कराड़न्‌या ईसुन्‌चां आवला छे, जु भगवानेन ने माणसेन ईचमां वायदु करीन मेळ कराड़े। ने ईसुन छीतेड़ला लुहीन्‌चां आवला छे, चो लुही हाबीलेन लुही सी जादा वारु कह्‌वे।<verse eid="HEB 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25"/>तुहुं चेतीन रहु। बुलने वाळा भगवानेन बुली काजे सामळीन, मन बेहरा मां बणु। जे धरती पर बुलने वाळान बुली सामळीन बी मन बेहरा हय गुयला, कदी चे नी बच्‌या, ती आपणु सरग वाळान बुली सामळीन बी मन बेहरा हय जासु, ती कसा काय बचसु, जु आपणु काजे कय्‌न चेतावु करे। <verse eid="HEB 12:25"/><verse number="26" style="v" sid="HEB 12:26"/>तीनी टेमे धरती पर बुलने वाळान बुली, धरती काजे हालाड़ी देदली; बाकुन चु हय ज बमदीन कह्‌यु की “एक कावा अळी, मे धरती काजे अतरुत नी; बाकुन सरगे काजे बी हालाड़ी दीस।” <verse eid="HEB 12:26"/><verse number="27" style="v" sid="HEB 12:27"/>एक कावा अळी ईना बुल सी जु ईसारु जड़े की ईनी कळीन तीनी चीज काजे हालाड़से, ची चीज सर जासे, ने तीनी चीज काजे नी हालाड़े ची जलम लग टेकली रवसे।<verse eid="HEB 12:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 12:28"/>आपणु काजे ज राज जड़लो छे, च कदी नी हाले, हेरेसी आपणु भगवान काजे तु बेसकु वारु छे कह्‌तात रवजे, ने तेरी मरजीन अनसारेत भक्‌ती ने भुरसु करीन तेरी सेवा चाकरी करजे। <verse eid="HEB 12:28"/><verse number="29" style="v" sid="HEB 12:29"/>काहाकी आपणु भगवान ते, धपीन भसम करन्‌यो आकठो छे।<verse eid="HEB 12:29"/></para>
  <chapter eid="HEB 12"/>
  <chapter number="13" style="c" sid="HEB 13"/>
  <para style="s">भगवानेन भक्‌तीन अनसारे जीवन जीवणु</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1"/>तुहुं ईसु मसी मां भाय-बहणस्‌या छे, हेरेसी एक दीसरा सी परम करता रहु। <verse eid="HEB 13:1"/><verse number="2" style="v" sid="HEB 13:2"/>जे माणसे तुंद्‌रे घर आवे, तींद्‌री मेजवानी करनु घुण भुलु; काहाकी थुड़ाक जणा अंजाण्‌या माणसेन मेजवानी कर्‌या, ने अळी तीनुक मालम पड़्‌यो की, हामु ते जाणे बीगुर भगवानेन सरग वाळा चाकर्‌यान मेजवानी कर देदला। <verse eid="HEB 13:2"/><verse number="3" style="v" sid="HEB 13:3"/>हामु बी जेल मां छे, असो समजीन ईसु पर भुरसु करन्‌या केदड़ान मदत करने घुण ईसेरजु। ने हामरो डील बी दुख झेलन्‌योत छे समजीन ईसु पर भुरसु करन्‌या काजे, दीसरा माणसे वेला पाड़े, ती तींद्‌री मदत करने घुण ईसेरजु।<verse eid="HEB 13:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 13:4"/>भगवान, छीनाळ्‌यान ने दीसरान बायरीक धरन्‌यान नीयाव करसे, ने डंड आपसे। हेरेसी आखा माणसे मां ईयाव ईज्‌जत सी हवणु चाहजे। ने दुयु माणसे काजे एक दीसरा पर भुरसु करे असु जीवन, जीवणु चाहजे।<verse eid="HEB 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 13:5"/>धनेन हाय मां करु, ने जो काय तुंद्‌रे धड़े छे तेरेत मां नीसरा रहु; काहाकी भगवान आपसुत कह्‌लु छे, “मे तुसेक कदी नी छुड़ो, ने कदी नी ईसरो।” <verse eid="HEB 13:5"/><verse number="6" style="v" sid="HEB 13:6"/>हेरेसी हामु बे फीकर्‌या हय्‌न भगवान पर भुरसु करीन कह्‌जे,</para>
  <para style="q1" vid="HEB 13:6">“मालीक भगवान मारे अगु छे,</para>
  <para style="q2" vid="HEB 13:6">मे नी बीहयो।</para>
  <para style="q1" vid="HEB 13:6">माणसे मारो काय बीगाड़ लेसे?”<verse eid="HEB 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7"/>जे तुहुं काजे भगवानेन खुस-खबर सामळायन तुंद्‌री अगवाय कर रया, तीनु काजे तुहुं हेर राखु; ने चे कसा भुरसान जीवन बेसकी वारु जीवीन पुरी कर्‌या; तसात तुहुं बी भगवान पर भुरसु करीन जीवु। <verse eid="HEB 13:7"/><verse number="8" style="v" sid="HEB 13:8"/>ईसु मसी वीतला टेम मां बी एक सारकु हतलु, ने आज बी तसुत छे, पीड़ीडीट जलम लग एक सारकु रवसे। <verse eid="HEB 13:8"/><verse number="9" style="v" sid="HEB 13:9"/>भाती-भातीन नवली सीकापण सामळीन मां बीखरायु; खाणे पीणेन पाळनी पाळनेन भुरसे मां रहु, काहाकी असो करने वाळान काय बी नफु नी हयु। तुंद्‌रो मन पाक्‌को करीन जीव-आत्‌मा मां बड़ने करीन, तुहुंक भगवानेन दया चाहजे।<verse eid="HEB 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 13:10"/>हामु ईसु पर भुरसु करन्‌या धड़े एक असी चुखली वेदी छे, तेरेमां सी खाणेन हक, तम्‌बु मां पुजा-पाट करन्‌याक नी हय। <verse eid="HEB 13:10"/><verse number="11" style="v" sid="HEB 13:11"/>जुन्‌ली बुलीन अनसारे मुखी पुजारु, सालोम एक कावा जनवार्‌या काजे मारीन, तींद्‌रो लुही तम्‌बुन चुखला जागा मां ली जाय्‌न, पापेन बादा करीन वेदी पर चड़ावे; तीनु जनवार्‌यान डील काजे तम्‌बा सी आंग्‌ये ली जाय्‌न धपाड़ देसे। <verse eid="HEB 13:11"/><verse number="12" style="v" sid="HEB 13:12"/>आपणुक असला पुजारा बणावणे करीन ईसु बी आपसे लुह्‌ये करीन आपणु काजे चुखा करने करीन यरुसलेम सहरेन बारना सी बाहर दुख झेल्‌यु। <verse eid="HEB 13:12"/><verse number="13" style="v" sid="HEB 13:13"/>हेरेसी चालु, आपणु ईसुन नाव-बद्‌दी आपणे पर बी ली लेजे, ने जुन्‌ली रीती-भातीन डेराक छुड़ीन ईसुन्‌चां जाजे। <verse eid="HEB 13:13"/><verse number="14" style="v" sid="HEB 13:14"/>ईनी कळी मां आपणे वाटे जलम लग रह्‌वणे वाटे सहर नी हय, बाकुन आपणु एक आवणेवाळा सहरेन वाट देख रया। <verse eid="HEB 13:14"/><verse number="15" style="v" sid="HEB 13:15"/>हेरेसी आपणु भगवान काजे ईसुन साहरे बड़ायन बादा चहड़ाया करजे। मतलब आपणु आपणे मुंहडे करीन तेरा नावेक तेरा गुणे गाया करजे। <verse eid="HEB 13:15"/><verse number="16" style="v" sid="HEB 13:16"/>ने भलाय करनु, ने दया देखाड़नु आपणुक नी ईसेरनु चाहजे; काहाकी भगवान काजे ते असलीत बादा सी खुसी हवे।<verse eid="HEB 13:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17"/>मंडळीन पुडार्‌या, तुंद्‌रा जीव वाटे रात दाहड़ु फीकुर करीन जागली करीन दुवा करता रवे, ने अगवाय करे। तीनुक ते तुंद्‌रो जीव सुदारनेन जो काम भगवान सुपलु तेरु हीसाब किताप भगवान काजे आपणु पड़से। हेरेसी तींद्‌री मानु; ने तींद्‌रे अनुसार चालु, ने तीनु काजे ज काम खुसी सी करने देवु, दुखी हय्‌न नी काहाकी दुखी हय्‌न जो काम करसे ती, तुंद्‌रा जीव काजे काय बी नफु नी हये।<verse eid="HEB 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18"/>हामरे वाटे भगवान धड़े दुवा करता रहु। हामुक पाक्‌कु भुरसु छे की, हामरो मन चुखलु छे; ने हामु आखी वातेम वारु काम करनेन हेर करजे। <verse eid="HEB 13:18"/><verse number="19" style="v" sid="HEB 13:19"/>तुहुं सी लीलघाय करीन कहो की, तुहुं मारे वाटे भगवान सी दुवा करु की मे मामार तुंद्‌रेन्‌चां आय सको।<verse eid="HEB 13:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20"/>सांती आपण्‌यु भगवान, मालीक ईसु मसी काजे आपसा जलमेन वायदु करला लुहीन गुणेन साहरे मर्‌या-सर्‌याम सी जीवतु करीन बठु कर देदलु छे। जु ईसुत आपसा माणसेन राखवाळी करन्‌यु छे। तेरा माणसे गाडरा साय छे। <verse eid="HEB 13:20"/><verse number="21" style="v" sid="HEB 13:21"/>जुत सांती आपण्‌यु भगवान तुहुं काजे आखी भली वात मां बड़ाया करे। तेरे सी तुहुं भगवानेन मरजी पुरी करु, ने ज काय भगवान काजे चाहजे च काम करु। भगवान आपणा जीव मां जो आखो काम ईसु मसीन साहरेत पुरो करे। ने ईना ईसुन बड़ाय जलम पीड़ीडीट हवती रहणु चाहजे। आमीन।<verse eid="HEB 13:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22"/>ए भायस्‌यो ने बहणस्‌या, मे तुंद्‌रे धड़े लीलघाया करो की तुहुं मारी ईनी सांती आपणी वात काजे मान लेवु। काहाकी मे तुहुंक जाराक वात मानने करीन लिखलु छे। <verse eid="HEB 13:22"/><verse number="23" style="v" sid="HEB 13:23"/>मे तुहुंक जी खबर सामळावणु छे की आपणु भायस तीमुथीयुस जेलेम सी छुट गुयलु छे। कदी चु मामार आवसे, ती मे तेरे पुठ्‌ये तुहुं काजे भेळु हवणे आवीस।<verse eid="HEB 13:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24"/>आपणा आखा अगवाय करन्‌या काजे ने चुखला माणसे काजे वारलु छे की पुछु? ईटली देस वाळा तुहुं काजे बी वारलु छे की? करीन पुछ रया।<verse eid="HEB 13:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25"/>तुहुं आखा काजे भगवानेन गीण-दया जड़ती रह्‌वणु चाहजे। आमीन।<verse eid="HEB 13:25"/></para>
  <chapter eid="HEB 13"/>
</usx>
