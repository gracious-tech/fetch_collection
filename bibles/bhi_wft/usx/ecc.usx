<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ECC" style="id">- Bhilali Standard Project</book>
  <para style="h">सभोपदेसक किताप</para>
  <para style="toc3">सभोपदेसक</para>
  <para style="toc2">सभोपदेसक</para>
  <para style="toc1">सभोपदेसक</para>
  <para style="mt2">सभोपदेशक</para>
  <para style="mt1">सभोपदेसक किताप</para>
  <para style="imt">सभोपदेसक कितापेन बारामां</para>
  <para style="ip">सभोपदेसक एक असी किताप छे, जी जीवन वाटे अक्‌कल सीकाड़े। कितापेन हीब्‌रु मां जो मतलब छे “हयो जो माणसे काजे भेळा करे।” घणा सास्‌तुर काजे जाणने वाळा माने की राजु सुलेमान, सभोपदेसक किताप काजे लिखणे वाळु हतलु, बाकुन दीसरा माणसे इनी वात काजे नी माने। कदी सुलेमान इनी किताप काजे लिखलु, ती जो 970-931 ईसु मसी सी पेहल लिखलो हतलो। जत्‌यार चु जीवतेलु हतलु तीं। दीसरा सास्‌तुर जान्‌ने वाळान मान्‌नु छे, की काहनाक दीसरान हाते लिखली छे, काहाकी कदी-कदी ऐरेम राजान तसी नी बाकुन पावर्‌यान हीसाबे बुली मां लिखलो छे। (<char style="xt"><ref loc="ECC 5:8-9">सभोपदेसक 5:8-9</ref></char>) ईनु सास्‌तुर काजे मान्‌नेवाळान मान्‌नु छे की सभोपदेसकेन किताप सुलेमानेन टेमेन हीसाब मां घणी पछळ लिखायली हतली, हय सके 400 ने 200 ईचमां</para>
  <para style="ip">ईसु मसी सी पेहेल। सभोपदेसक असु कय्‌न सुरु करे की आखों कांय एक दमेन तसी छे, जी तत्‌यारुत अंछाप हय जाय <char style="xt"><ref loc="ECC 1:2">1:2</ref></char>। तेरो मतलब जो छे की हामरो जीवन ने हामरो काम सदा नी हय ने ईनाक समजणु काठो छे। ऐरेम सी घणास माणसे काजे थुड़ाक टेमेन पछे वीसराय जासे। तेरी बेसकी वात आपणा बस सी बाहर छे। जीवन जसो छे तीनाक तसोत मान्‌नु ने जो आपसा धड़े छे तेरेत मां खुसी हेरनु वारु छे <char style="xt"><ref loc="ECC 9:9">9:9</ref></char>। जीवनेन आखा काठा कामे ने खुसी पर वीच्‌यार करता जाय्‌न कितापेन जो सीकणु छे, की भगवान सी बीहणु ने तेरी हुकुम काजे मान्‌नु छे। <char style="xt"><ref loc="ECC 12:13">12:13</ref></char> जी आखा सी मटी वात छे।</para>
  <para style="iot">बाहरती वात</para>
  <para style="io1">1. सभोपदेसकेन किताप काजे लिखणे वाळु ने तेरा जीवनेन थुड़ीक माहतीन बारामां बताड़े। <char style="ior"><ref loc="ECC 1:1-11">1:1-11</ref> </char></para>
  <para style="io1">2. जीवनेन मतलब पर वात करे।<char style="ior"><ref loc="ECC 1:12-6:9">1:12—6:9</ref> </char></para>
  <para style="io1">3. मास्‌तर्‌यान सीक बताड़े। <char style="ior"><ref loc="ECC 6:10-12:8">6:10—12:8</ref> </char></para>
  <para style="io1">4. कितापेन आकरी, असी कय्‌न पुरी करे की जीवनेन आखो काम भगवानेन बीहाणा काजे मानु ने तेरा हुकुम काजे मान्‌ने करीन कवे। <char style="xt" closed="false"><ref loc="ECC 12:9-14">12:9-14</ref></char></para>
  <chapter number="1" style="c" sid="ECC 1" />
  <para style="s">जीवाय फालतु छे</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 1:1" />जु दावुदेन पुर्‌यु सीकाड़न्‌यान बुल छे, जु यरुसलेमेन राजु हतलु।<verse eid="ECC 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 1:2" />सीकाड़न्‌यु असु कह्‌यु, फालतुत फालतु छे, “फालतुत फालतु! आखो कांय फालतुत छे।” <verse eid="ECC 1:2" /><verse number="3" style="v" sid="ECC 1:3" />माणसे काजे आपणा तीना आखा काठला काम काजे करीन काय हात कर लेय, जो दाहड़ान नेचे मेहनत करे। <verse eid="ECC 1:3" /><verse number="4" style="v" sid="ECC 1:4" />एक पीड़ी जाय ने दुसरी पीड़ी आवे, बाकुन धरती जलम तसीत बणीन रवे। <verse eid="ECC 1:4" /><verse number="5" style="v" sid="ECC 1:5" />दाहड़ु उंगे ने डुबे बी, ने आपसु दींखुर सी उंगे तींखुरुत पछु जाती रवे। <verse eid="ECC 1:5" /><verse number="6" style="v" sid="ECC 1:6" />वाहळी दखणाव भीणी जाय, ने अखण भीणी फीर जाय, ची हींडती-फीरती रवे, ने आपसान च्‌यारे मेर फीरीन पछी आय जाय। <verse eid="ECC 1:6" /><verse number="7" style="v" sid="ECC 1:7" />आखी नदी दर्‌याम जाय्‌न भेसकाय जाय, तेबी दर्‌यो भराये नी; तीना जागाम सी नदी नीकळे, तींखुरुत चे फीर जाय। <verse eid="ECC 1:7" /><verse number="8" style="v" sid="ECC 1:8" />आखी वात मेहनत सी भरली छे; माणुस ईनी वातेन बारामां वात नी कर सके; नी ते डुळा देखणे सी उप्‌ठा हय जाय, ने नी कान्‌टा सामळने सी भराय जाय। <verse eid="ECC 1:8" /><verse number="9" style="v" sid="ECC 1:9" />जो कांय हवलो, चो अळी पछो हवसे, ने जो कांय बणी गुयो, चोन पछो बणावासे; ने आखी धरती पर काय बी नवलो नी हय। <verse eid="ECC 1:9" /><verse number="10" style="v" sid="ECC 1:10" />काय असी वात छे, तेरे बारामां माणसे कय सके की देखु जी नवली छे? जो जां पेहलुत सी छे, ने घणो पेहेल सी छे, ने जो हामरा टेम सी पेहलुत सी जां हतलो। <verse eid="ECC 1:10" /><verse number="11" style="v" sid="ECC 1:11" />पेहला माणसे काजे कुय बी नी हेर करतेला, जां तक की आवणे वाळी पीड़ी काजे बी तीनु माणसेन साहरे बी हेर नी करे, जे तीनुक हेर करतेला।<verse eid="ECC 1:11" /></para>
  <para style="s">सीकाड़न्‌यान अक्‌कल फालतुत छे</para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 1:12" />मे सीकाड़ने वाळु यरुसलेम मां इस्‌राएलेन राजु हतलु। <verse eid="ECC 1:12" /><verse number="13" style="v" sid="ECC 1:13" />मे मारु मन लागाड़्‌यु की जों काय सरग तळे करे, तेरी सातायली वात अगळ सी सुची सुचीन मालुम करो;</para>
  <para style="p" vid="ECC 1:13">जो मटा दुखेन काम छे चो भगवान माणसे वाटे ठेहरावलु छे, की चो काम करता रहे। <verse eid="ECC 1:13" /><verse number="14" style="v" sid="ECC 1:14" />मे तीनु आखा काम काजे देख्‌यु, जे दाहड़ा तळे करे; चे आखा फालतु ने मानु वाहळा काजे धरनु छे। <verse eid="ECC 1:14" /><verse number="15" style="v" sid="ECC 1:15" />जों वाकलो छे चों सुदो नी हय सके, ने जों हय नी, चों गिन्‌तीम नी आय सके।<verse eid="ECC 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 1:16" />मे मन मां कह्‌यु, “देख, जतरा यरुसलेमेन सहर मां मार सी पेहेल राज करतेला, तींद्‌रे मां मे अदु अक्‌कल वाळु हय गुयु, ने मेसेक घणी अक्‌कल ने समजणेन माहती हय गुय।” <verse eid="ECC 1:16" /><verse number="17" style="v" sid="ECC 1:17" />मे मारु मन लागाड़्‌यु की अक्‌कलेन ढाकायली वात जाणो ने कम अक्‌कल ने गांडाय जाणों। तत्‌यार मेसेक मालुम पड़्‌यो की जो बी वाहळाक धरनेन तसो छे। <verse eid="ECC 1:17" /><verse number="18" style="v" sid="ECC 1:18" />काहाकी अदुस अक्‌कल सी अदुस पछतावु बी हवे, ने जे आपसान अक्‌कल बड़ावे चु आपसान दुख बी बड़ावे।<verse eid="ECC 1:18" /></para>
  <chapter eid="ECC 1" />
  <chapter number="2" style="c" sid="ECC 2" />
  <para style="s">सुकेन चीजे फालतुत छे</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 2:1" />मे मारा मन काजे कह्‌यु, “चाल, मे तुसेक तारी खुसी सी उळखीस; तेरेमां खुस हव ने मुरखाय।” बाकुन देखु, जो बी फालतु छे। <verse eid="ECC 2:1" /><verse number="2" style="v" sid="ECC 2:2" />मे हासणेन बारामां कह्‌यु, “ज ते गांडाय छे,” ने खुसीन बाराम, “तींद्‌रे सी काय जड़े?” <verse eid="ECC 2:2" /><verse number="3" style="v" sid="ECC 2:3" />मे अंगुरेन रस पीन खुद काजे खुस करनेन कुसीत ने गांडाय काजे गळे लागाड़नेन कुसीत कर्‌यु की मारू अक्‌कल हंय बी मेसेक माहती सी बताड़ी रयु। मे ज देखणे बाजी रयु की मारा जीवनेन थुड़ाक दाहड़ाम माणसे वाटे सरगेन हेटो काय करनु वारलु हतलो।<verse eid="ECC 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 2:4" />मे मटा-मटा काम कर्‌यु; मे मार वाटे घर बणाय लेदु ने मार वाटे अंगुरेन वाड़ी लगाड़ लेदु; <verse eid="ECC 2:4" /><verse number="5" style="v" sid="ECC 2:5" />मे मारा वाटे वाड़ी ने नानी-नानी वाड़ी लगाड़ लेदु, ने तेरेम भाती भातीन फळ लागण्‌या झाड़का लागाड़्‌यु। <verse eid="ECC 2:5" /><verse number="6" style="v" sid="ECC 2:6" />मे मार वाटे तळाव बणाय लेदु काहाकी तींद्‌रे सी जे वाड़्‌या पुसाय जाय, तींद्‌रेम झाड़का लागाड़ला हतला। <verse eid="ECC 2:6" /><verse number="7" style="v" sid="ECC 2:7" />मे पावर्‌या ने पावरनी काजे मुल लेदु, ने मारा घरेन बेसका पावर्‌या पयदा हय ज्‌या; ने जतरा मार सी पेहेल यरुसलेम मां हतला तींद्‌रे सी बेसका अदुस बेल ने गावड़ी ने गाडरा बुकड़ान मे मालीक हतलु।<note caller="+" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="1KI 4:23">1 राजा 4:23</ref></char></note> <verse eid="ECC 2:7" /><verse number="8" style="v" sid="ECC 2:8" />मे चांदी ने सनो ने राजाक ने आखा राज्‌येन महंगा सी महंगा चीजेक भेळु कर्‌यु; मे मार वाटे गावण्‌या ने गावणी काजे भेळु कर्‌यु, ने मार धड़े दीसरा अदमीन मन काजे जीतणे करीन बेसकी बायरी बी छे।<note caller="+" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="1KI 10:23-27">1 राजा 10:23-27</ref></char></note><verse eid="ECC 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 2:9" />तसु करीन मे मार सी पेहेल आखा यरुसलेम मां रहणेवाळा सी मे मटु ने माल धन वाळु बण गुयु<note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="1CH 29:25">1 ईतीहास 29:25</ref></char></note>; तेबी मारी अक्‌कल आज भी तसीत छे। <verse eid="ECC 2:9" /><verse number="10" style="v" sid="ECC 2:10" />ने जतरी चीजेक मे देखणेन हेर कर्‌यु, तीनु आखा काजे देखणे सी नी उबु रह्‌यु; मे मारो मन काहनी बी भातीन खुसी मनावणे सी नी रुक्‌यु काहाकी मारो मन मारा आखा मेहनतेन वजे सी खुसी हयो; ने मारा आखा मेहनत सी मेसेक जत भाग जड़्‌यो। <verse eid="ECC 2:10" /><verse number="11" style="v" sid="ECC 2:11" />तत्‌यार मे अळी मारा हातेन आखा काम काजे, ने मारा आखा मेहनत काजे देख्‌यु, तीं काय देख्‌यु की आखों कांय फालतुत ने वाहळा काजे धरनेन तसो छे, ने दाहड़ा तळे कांय बी फायदु नी।<verse eid="ECC 2:11" /></para>
  <para style="s">अक्‌कल ने गांडाय फालतु छे</para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 2:12" />अळी मे पछु मारा मन काजे ली गुयु की अक्‌कल, ढीलाय ने गांडायन कामेक देखों,</para>
  <para style="p" vid="ECC 2:12">काहाकी जु माणुस राजा पछळ आवसे, चु काय करसे? बस हयोत चो पेहेल सी हवतो आय रयो। <verse eid="ECC 2:12" /><verse number="13" style="v" sid="ECC 2:13" />तत्‌यार मे देख्‌यु की वीजाळो आंधारला सी जतरो वारु छे, तत्‌रो अक्‌कल बी गांडाय सी वारु छे। <verse eid="ECC 2:13" /><verse number="14" style="v" sid="ECC 2:14" />जु अक्‌कल वाळु छे, तेरा मुन्‌का मां डुळा रवे, बाकुन गांडु आंधारला मां चाले; तेबी जाण लेदु की दुयुन एकुत गती रवे। <verse eid="ECC 2:14" /><verse number="15" style="v" sid="ECC 2:15" />तत्‌यार मे मन मां कह्‌यु, “जसी गांडान गती रवसे, तसीत मारी बी रवसे; ती मे काहा अळी अदुस अक्‌कल वाळु हयु?” ने मे मन मां कह्‌यु की जो बी फालतुत छे। <verse eid="ECC 2:15" /><verse number="16" style="v" sid="ECC 2:16" />काहाकी नी ते अक्‌कल वाळान ने नी गांडान हेर सदा बणीन रवे, बाकुन आवणे वाळा दाहड़ाम बी आखों काय ईसराड़ी देसे। अक्‌कल वाळु कसु गांडान तसु मरे!<verse eid="ECC 2:16" /></para>
  <para style="s">मेहनत करनु फालतु छे</para>
  <para style="p">
    <verse number="17" style="v" sid="ECC 2:17" />तेरेमां मे मारी जीवाय काजे वारु नी समज्‌यु, काहाकी जो काम दुनीया मां करे चे मेसे भुंडा मालम पड़्‌या; काहाकी आखों काय फालतुत ने मानु वाहळा काजे धरनेन तसो छे।<verse eid="ECC 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 2:18" />मे मारा आखा मेहनतेन फळ तीनुक मे धरती पर कर्‌यु मेसेक नी भायो, काहाकी जी छाचली वात छे की तेरो फळ हीनु माणसे वाटे छुड़ जाम जे मार पछेन आवणेवाळा छे। <verse eid="ECC 2:18" /><verse number="19" style="v" sid="ECC 2:19" />जो कुण जाणे की चु माणुस अक्‌कल वाळु रवसे की गांडु? तेबी दाहड़ान हेटु जतरु मेहनत मे कर्‌यु, ने तेर वाटे अक्‌कल वापर्‌यु की तीना आखान हयुत हकवाळु रवसे। चो बी फालतुत छे। <verse eid="ECC 2:19" /><verse number="20" style="v" sid="ECC 2:20" />तत्‌यार मे मारो मन तीना आखा मेहनतेन बारामां जो मे दाहड़ा पर करलु छे तेरेसी मे दुखी हयु, <verse eid="ECC 2:20" /><verse number="21" style="v" sid="ECC 2:21" />काहाकी असु माणुस बी छे, तेरो काम मेहनत ने अक्‌कल ने माहती सी हवे ने वारु फळ बी जड़े, तेबी तीनाक असा माणुस वाटे छुड़ी देणु पड़े, जु तेरेम काय बी मेहनत नी कर्‌यु हय। ज बी फालतु ने बेसको भुंडो छे। <verse eid="ECC 2:21" /><verse number="22" style="v" sid="ECC 2:22" />माणुस जो दाहड़ान हेटु मन लागाड़ीन मेहनत करे तेरेसी तीनाक काय फायदु हवे? <verse eid="ECC 2:22" /><verse number="23" style="v" sid="ECC 2:23" />तेरा आखा दाहड़ा ते दुख सी भरला रवे, ने तेरा काम पछतावा सी हवे; रात्‌ये बी तेरो मन सुख सी नी रवे। <note caller="+" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="JOB 5:7">अय्‌युब 5:7</ref>; <ref loc="JOB 14:1">14:1</ref></char></note>जो बी फालतुत छे।<verse eid="ECC 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ECC 2:24" />माणसे वाटे खाणे-पीणेन ने मेहनत करता जाय्‌न आपसा जीव काजे सुखी राखणु छुड़ीन काय बी वारु नी हय। <note caller="+" style="x"><char style="xo" closed="false">2:24 </char><char style="xt" closed="false"><ref loc="ECC 3:13">सभोपदेसक 3:13</ref>; <ref loc="ECC 5:18">5:18</ref>; <ref loc="ECC 9:7">9:7</ref>; <ref loc="LUK 12:19">लुका 12:19</ref>; <ref loc="1CO 15:32">1 कुरींथी 15:32</ref></char></note>मे देख्‌यु की जो बी भगवान भीणी सीत जड़े; <verse eid="ECC 2:24" /><verse number="25" style="v" sid="ECC 2:25" />काहाकी कुण यहोवा भगवान सी छेटे रयन खाय पीये ने खुसी मनाय सके? <verse eid="ECC 2:25" /><verse number="26" style="v" sid="ECC 2:26" />जु माणुस यहोवा भगवानेन नींगाम वारु छे, तीनाक चु अक्‌कल ने माहती ने खुसी आपे; <note caller="+" style="x"><char style="xo" closed="false">2:26 </char><char style="xt" closed="false"><ref loc="JOB 32:8">अय्‌युब 32:8</ref></char></note>बाकुन पापी काजे चु दुख सी भरला कामुत आपे काहाकी चु तीनाक आपणे करीन भेळो करीन ढेर लागाड़े जो यहोवा भगवानेन नींगा मां वारु छे; जो बी फालतुत ने वाहळा काजे धरनेन तसो छे।<verse eid="ECC 2:26" /></para>
  <chapter eid="ECC 2" />
  <chapter number="3" style="c" sid="ECC 3" />
  <para style="s">आखो काय करने वाटे एक टेम ठेहरावलो छे</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 3:1" />हरेक वातेन एक खास टेम छे, ने हरेक कामेन एक टेम छे, जों दाहड़ान हेटो छे, एक टेम छे।<verse eid="ECC 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 3:2" />पयदा हवणेन टेम, ने मरनेन बी टेम; वेरनेन टेम;</para>
  <para style="q2" vid="ECC 3:2">ने वेरला काजे उखाळनेन बी टेम छे;<verse eid="ECC 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 3:3" />मारनेन बी टेम, ने वारु करनेन बी टेम;</para>
  <para style="q1" vid="ECC 3:3">उदारनेन बी टेम, ने बणावणेन बी टेम;<verse eid="ECC 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 3:4" />रन्‌नेन बी टेम, ने हासणेन बी टेम;</para>
  <para style="q1" vid="ECC 3:4">छाती ठुकणेन बी टेम ने नाचणेन बी टेम छे;<verse eid="ECC 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 3:5" />दगड़ा उराटणेन बी टेम ने दगड़ा भेळा करनेन बी टेम;</para>
  <para style="q1" vid="ECC 3:5">गळे लागाड़नेन बी टेम, ने गळे लागाड़ने सी रुकणेन बी टेम छे;<verse eid="ECC 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 3:6" />हेरनेन बी टेम, ने खुवणेन बी टेम; बचाड़ीन राखणेन बी टेम,</para>
  <para style="q1" vid="ECC 3:6">ने उराटी देणेन बी टेम छे;<verse eid="ECC 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 3:7" />फाड़नेन बी टेम, ने सीवणेन बी टेम,</para>
  <para style="q1" vid="ECC 3:7">ने हुगो रवणेन बी टेम, ने बुलनेन बी टेम छे;<verse eid="ECC 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 3:8" />परम करनेन बी टेम, ने बुराय करनेन बी टेम;</para>
  <para style="q1" vid="ECC 3:8">लड़ाय करनेन बी टेम, ने भेळा रवणे बी टेम छे।<verse eid="ECC 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 3:9" />काम करनेवाळा काजे आपसा मेहनत सी काय फायदु हवे? <verse eid="ECC 3:9" /><verse number="10" style="v" sid="ECC 3:10" />मे तीना दुख सी भरला काम काजे देख्‌यु जु भगवान माणसे वाटे ठेहरावलु छे, की चे तेरेम लागला रवे। <verse eid="ECC 3:10" /><verse number="11" style="v" sid="ECC 3:11" />चु आखो काय असो बणायु की आपसा टेम पर चे वारलु रवे; अळी चु माणसेन मन मां पेहलेन ने जलमेन टेमेन अक्‌कल पयदा कर्‌यु, तेबी जो काम भगवान करलु छे, चों पेहलुत सी जलम लग माणसेन समज मां नी आय सके। <verse eid="ECC 3:11" /><verse number="12" style="v" sid="ECC 3:12" />मे जाण लेदु की माणसे वाटे खुसी मनावणेन ने जीवन भर भलाय करनु ने तेर पाखुर अळी काय बी वारु नी हय; <verse eid="ECC 3:12" /><verse number="13" style="v" sid="ECC 3:13" />ने जो बी भगवानेन दान छे की माणुस खाय ने पीये ने आपसा आखा मेहनत मां सुखी रवे।<verse eid="ECC 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ECC 3:14" />मे जाणो की जो काय भगवान करे चो जलमको टेकलो रवसे; नी ते तेरेम काय बड़ाय सके ने नी काय घटाय सके; भगवान असु तेर सी करे की माणसे तेरो बीहाणो माने। <verse eid="ECC 3:14" /><verse number="15" style="v" sid="ECC 3:15" />जो काय हयो चो हेरेसी पेहेल बी हय चुक्‌यो; जो काय हवणे वाळो छे, चो बी हय चुक्‌यो; ने भगवान वीतली वात काजे अळी पछु पुछे।<verse eid="ECC 3:15" /></para>
  <para style="s">कळजुग मां नीयाव नी</para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 3:16" />अळी मे दाहड़ान हेटु काय देख्‌यु की नीयावेन जागा मां नीयाव नी, ने धरमेन जागा मां धरम नी हय। <verse eid="ECC 3:16" /><verse number="17" style="v" sid="ECC 3:17" />मे मन मां कह्‌यु, भगवान धरमी ने नी धरमीन दुयुन नीयाव करसे, “काहाकी तेरेन्‌चां एक-एकेक वात ने एक-एकेक कामेन टेम छे।” <verse eid="ECC 3:17" /><verse number="18" style="v" sid="ECC 3:18" />मे मन मां कह्‌यु, “जो असो करीन हवे की भगवान माणसे काजे पारखे की चे देख सके की चे जनवार्‌यान तसा छे।” <verse eid="ECC 3:18" /><verse number="19" style="v" sid="ECC 3:19" />काहाकी जसो माणसेन तसोत जनवार्‌यान बी दसा रवे; दुयुन दसा रवे, जसु एक मरे तसात दीसरा बी मरे। आखान सांस एक जसी छे, ने माणुस जनवार सी काय अदुस बड़ीन नी; आखों काय फालतुत छे। <verse eid="ECC 3:19" /><verse number="20" style="v" sid="ECC 3:20" />आखा एक जागाम जाय; आखा धुळा सी बन्‌ला छे, ने आखा धुळात मां भेसकाय जासे। <verse eid="ECC 3:20" /><verse number="21" style="v" sid="ECC 3:21" />काय माणसेन जीव उपर ने जनवारेन जीव हेटो जाय्‌न धुळा मां भेसकाय जाय? चो कुण जाणे? <verse eid="ECC 3:21" /><verse number="22" style="v" sid="ECC 3:22" />तेरेमा; मे असु देख्‌यु की हेरे सी अदुस काय वारु नी की माणुस आपसा काम मां खुसी सी रवे काहाकी तेरो भाग जोत छे; कुण तेर पछळ हवणेवाळी वात काजे देखणे करीन तीनाक पछु ली आवसे?<verse eid="ECC 3:22" /></para>
  <chapter eid="ECC 3" />
  <chapter number="4" style="c" sid="ECC 4" />
  <para style="s">दुख, मेहनत ने मेळ</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 4:1" />तत्‌यार मे जो आखो अन्‌याय देख्‌यु, जो दाहड़ान हेटो छे। ने असु देख्‌यु की तकलीप सेण करने वाळान आसळा पड़ी र्‌या, ने तीनुक कुय बी सांती देणेवाळो नी हय! अन्‌याय करने वाळान हातेम सक्‌ती हतली, बाकुन तीनुक कुय बी सांती देणेवाळु नी हतलु। <verse eid="ECC 4:1" /><verse number="2" style="v" sid="ECC 4:2" />तेरेमां मे मरला काजे जे मर गुयला, तीनुक जीवतेला सी हंय लग जीवला छे चो अदुस वारु कह्‌यु; <verse eid="ECC 4:2" /><verse number="3" style="v" sid="ECC 4:3" />बाकुन तींद्‌रे दुयु जणा सी अदुस वारु जो छे, की हंय लग हयो नी, ने नी जे भुंडा काम काजे देख्‌या जे धरती पर हवे।<verse eid="ECC 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 4:4" />तत्‌यार मे आखा मेहनतेन काम ने आखा बन्‌ला काम काजे देख्‌यु, जे माणसे आपसा धड़े वाळा सी रीसेन वजे करे। जो बी फालतुत ने मानु वाहळा काजे धरनेन तसो छे। <verse eid="ECC 4:4" /><verse number="5" style="v" sid="ECC 4:5" />गांडु माणुस छाती पर हात मेकी सुवे, ने मानु चु आपसात जीवन काजे नास करे। <verse eid="ECC 4:5" /><verse number="6" style="v" sid="ECC 4:6" />मुठ भरीन मनेन सांती दुय मुठ मेहनत सी वारु छे, चे मानु वाहळा काजे धरनेन तसो छे।<verse eid="ECC 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 4:7" />अळी मे धरती पर जी वात फालतु देख्‌यु। <verse eid="ECC 4:7" /><verse number="8" style="v" sid="ECC 4:8" />कदी काहनुक माणुस एखलुत रवे, ने तेरा पुर्‌या बी नी हय, ने नी भाय हय, ने चु दाहड़ी मेहनत करीन कमायेत, तेरा मेहनतेन काय बी छेव नी। ने तेरा डुळा धन दवलत सी आफरे नी, चु खुदेन बारामां वीच्‌यार नी करे, की मे जी मेहनत कुणी वाटे करने बाजी रयु, ने काहा खुद काजे सुख सांती सी छेटे करी रयु? “ज बी फालतुत छे, ने दुखी कामेन लेण देणु छे।”<verse eid="ECC 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 4:9" />एक सी दुय वारु छे, काहाकी तेरा मेहनत सी वारलु फळ जड़े। <verse eid="ECC 4:9" /><verse number="10" style="v" sid="ECC 4:10" />काहाकी कदी तेरेम सी एक हीटी पड़े, ती दीसरु तीनाक हाकलसे; बाकुन वारु नी तेरे पर जु एखलुत पड़े ने तीनाक काहनु बी हाकलने वाळु नी हय। <verse eid="ECC 4:10" /><verse number="11" style="v" sid="ECC 4:11" />अळी कदी दुय जणा भेळा सुवे ती चे हुप वाळा रवसे, बाकुन काहनुक एखलु कसु तातु रय सके? <verse eid="ECC 4:11" /><verse number="12" style="v" sid="ECC 4:12" />कदी काहनुक एखला काजे हाराड़े ती हाराड़ी देय, बाकुन दुय तेर अगळ लड़ाय कर सकसे। जी दुरी तीन दुरीन बणीन रह्‌वे ची छाटीस नी टुटे।<verse eid="ECC 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 4:13" />अकळ वाळु पुर्‌यु कमजुर हवणे पर बी असा डाहला ने गांडा राजा सी वारु छे, जु अळी सला काजे नी माने, <verse eid="ECC 4:13" /><verse number="14" style="v" sid="ECC 4:14" />कदी चु तेरा राज करने मां मालदार पयदा हयु, नीते जेल मां सी नीकळीन राजु बण्‌यु हय। <verse eid="ECC 4:14" /><verse number="15" style="v" sid="ECC 4:15" />मे देख्‌यु की आखा माणसे दाहड़ान हेटा रवणे वाळा ने चालने फीरने वाळा आखा माणसे राजान वारीसदार पुर्‌या पछल चालतेला। <verse eid="ECC 4:15" /><verse number="16" style="v" sid="ECC 4:16" />तेर पछळ चालने वाळा आखा माणसे गीणाये नी ततरा हतला, तींद्‌रे पर चु मुख्‌यु बन्‌लु। तेबी अगला दाहड़ा मां हवणे वाळा माणसे तेर वजे सी खुसी मां नी रवसे। तेरेमां छाचलीन जो बी फालतुत ने मानु वाहळा काजे धरनेन तसो छे।<verse eid="ECC 4:16" /></para>
  <chapter eid="ECC 4" />
  <chapter number="5" style="c" sid="ECC 5" />
  <para style="s">भगवान सी सगुन काजे पुरी करनु</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 5:1" />जत्‌यार तु यहोवा भगवानेन घर मां जाय, तत्‌यार धीयान सी चालजी; सामळने करीन धड़े जाणु गांडु चड़ावु चड़ावे तेर सी वारु छे; काहाकी चे नी जाणे की भुंडा करजे। <verse eid="ECC 5:1" /><verse number="2" style="v" sid="ECC 5:2" />वात करने मां उतवाळ नी करनु, ने नी आपसा मन काजे काहनीक वात उतवाळ मां भगवान अगळ कवणु, काहाकी भगवान सरग मां छे ने तु धरती पर छे; तेरेमां तारा बुल थुड़ाकुत रवे। <verse eid="ECC 5:2" /><verse number="3" style="v" sid="ECC 5:3" />काहाकी जसो अदुस कामेन वजे सी सपना देखाड़े, तसोन बेसकी वातेन वजे सी बुलने वाळु गांडु ठेहरे। <verse eid="ECC 5:3" /><verse number="4" style="v" sid="ECC 5:4" />जत्‌यार तु भगवान धड़े बादा लेय, तत्‌यार तीनाक पुरो करने मां वार घुण लागाड़े; काहाकी चु गांडा सी खुस नी हवे। जी बादा तु भगवान धड़े लेदु तीनाक पुरो करजी।<note caller="+" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="PSA 66:13">भजन सहीता 66:13</ref>,<ref loc="PSA 66:14">14</ref></char></note> <verse eid="ECC 5:4" /><verse number="5" style="v" sid="ECC 5:5" />बादा लीन पुरो नी करे, ती बादा लीन नी देय, ती बादा लेणु नी वारु हय। <verse eid="ECC 5:5" /><verse number="6" style="v" sid="ECC 5:6" />काहनुक आपसा मुंहडा सी बुल बुलीन आपसा काजे पाप मां नी पाड़नु, ने नी भगवानेन सरगेवाळा काहवाळ्‌या अगळ कवणु की जो असो भुल सी हयो; भगवान काहा तारो बुल सामळीन खुसी नी हवे, ने तारा हातेन काम काजे नास करे? <verse eid="ECC 5:6" /><verse number="7" style="v" sid="ECC 5:7" />काहाकी अधु सपना देखणेन वजे सी फालतु वात अधु हवे; बाकुन तु भगवानेन बीहाणो मान्‌जी।<verse eid="ECC 5:7" /></para>
  <para style="s">धन फालतुत छे</para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 5:8" />कदी तु काहनाक राज्‌य मां गरीब माणसे काजे वेला पाड़तेला ने नीयाव ने धरम काजे बीगड़ता देखु, ती तेरेसी चकराये घुण; काहाकी एक हकवाळा सी मटु दीसरु रवे, तीनाक ईनु वातेन हेर रवे, ने तेरेसी बी अळी अदुस मटु रवे।<verse eid="ECC 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 5:9" />धरतीन मेर आखा वाटे छे, बाकुन खेत सी राजान बी काम नीकळे।<verse eid="ECC 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 5:10" />पयस्‌या सी परम करनेवाळु पयस्‌या सी कदी उफ्‌टु नी हवे; ने नी असु माणुस, जीनाक धन सी परम छे, तीनान अधु सी अधु फायदा सी उफ्‌टु हय जाय; जो बी फालतुत छे। <verse eid="ECC 5:10" /><verse number="11" style="v" sid="ECC 5:11" />जत्‌यार पयस्‌या ने धन बड़े, ती तेरा खाणे वाळा बी बड़े, तत्‌यार तेरा मालीक काजे ईनाक छुड़ीन अळी काय फायदु हवे की तीनु धन दवलत काजे आपसा डुळा सी देखे? <verse eid="ECC 5:11" /><verse number="12" style="v" sid="ECC 5:12" />मेहनत करनेवाळु चाहे थुड़ाक खाय नीते अधु, तेबी तेरी नींद बेसकी आवे; बाकुन धनी माणसेन धन अधु हय जाणे सी तीनाक नींद नी आवे।<verse eid="ECC 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 5:13" />मे धरती पर एक मटी दुखेन बुराय देख्‌यु; बाकुन पलो धन, जीनाक मालीक आपसान नुकसान हवणे करीन मेकलु हय, <verse eid="ECC 5:13" /><verse number="14" style="v" sid="ECC 5:14" />ने चो काहनाक दीसरा भंडात काम उडी जाय, ने तेर घर मां पुर्‌यु पयदा हवे बाकुन तेर हात मां काय नी रवे। <verse eid="ECC 5:14" /><verse number="15" style="v" sid="ECC 5:15" />जसु चु आपसी मायन पेटेम सी पयदा हयु तसुत जाती रवसे; पुथल्‌या नी पेहरे, जसु चु आवलु, ने आपसान मेहनतेन बदले काय बी नी हात करसे तीनाक चु आपसा भेळे हातेम ली जाय सके। <verse eid="ECC 5:15" /><verse number="16" style="v" sid="ECC 5:16" />जी बी एक मटी बुराय छे, की जसु चु आयु, तसुत चु जासे; तीनाक आपसा मेहनत सी काय फायदु छे? <verse eid="ECC 5:16" /><verse number="17" style="v" sid="ECC 5:17" />बाकुन अतरोत की चु तेरा जीवन भर वारुस खावायो नी, ने बेसकु दुखी ने बेसकु मांदलु रयु ने रीसे बी करतु रह्‌यु?<verse eid="ECC 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 5:18" />सामळ, जी वारलु वात मे देख्‌यु, मतलब जी वारु बी छे, चो जो की माणुस खाय ने पीये ने आपसा मेहनत सी जु चु दाहड़ा पर करे, आपसा उमर भर ज भगवान तीनाक आपलु छे, सुख सी रहे; काहाकी तेरु जुत हीस्‌सु छे। <verse eid="ECC 5:18" /><verse number="19" style="v" sid="ECC 5:19" />मतलब हरेक माणसे काजे जीनाक भगवान धन ने आखो चीज आपलु हय, ने तींद्‌रे साते खुसी सी रवणु ने तेरेम सी आपसान हीस्‌सु लेणेन ने मेहनत करीन खुसी मनावणेन बी सक्‌ती आपली हय; जो भगवान भीणी सी असोंत आपलो छे। <verse eid="ECC 5:19" /><verse number="20" style="v" sid="ECC 5:20" />ईनु जीवणेन दाहड़ा तीनाक अदु हेर नी रवसे, काहाकी भगवान तेरी सामळी-सामळीन तेरा मन काजे मटी खुसी सी भरीन राखे।<verse eid="ECC 5:20" /></para>
  <chapter eid="ECC 5" />
  <chapter number="6" style="c" sid="ECC 6" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 6:1" />एक बुराय जी मे दाहड़ा पर देख्‌यु, च माणसे काजे बेसको भारो लागे: <verse eid="ECC 6:1" /><verse number="2" style="v" sid="ECC 6:2" />काहनाक माणुस काजे भगवान आखो भातीन धन ने आव-भाव जां तक आपे की जों काय तेरो मन चाहे तीनाक काय बी घटी नी हवे, तेबी भगवान तीनाक तेरेम सी खाणे नी देय, काहनुक दीसरुत तीनाक खाय जाय; जो फालतु ने बुरायन वात छे। <verse eid="ECC 6:2" /><verse number="3" style="v" sid="ECC 6:3" />कदी काहनाक माणसेन सव पुर्‌या हय, ने चु बेसका साल लग जीवतेलु रवे ने तेरी उमर अधु हय जाय, बाकुन नी ते तेरु जीव खुस रवे ने नी तीनाक आकरी मां वळावे, मे ते कहों की असला माणुस सी आधला टेमेन पयदा हवलो पुर्‌यो वारुस छे। <verse eid="ECC 6:3" /><verse number="4" style="v" sid="ECC 6:4" />काहाकी चु फालतुत आयु ने आंधारला मां जाती रयु, ने तेरो नाव आंधारला मां साताय गुयो; <verse eid="ECC 6:4" /><verse number="5" style="v" sid="ECC 6:5" />ने नी दाहड़ा काजे देख्‌यु, ने नी काहनीक चीज काजे उळखी सक्‌यु; तेबी तीनाक तीना माणुस सी अदुस आराम जड़्‌यु। <verse eid="ECC 6:5" /><verse number="6" style="v" sid="ECC 6:6" />हव, चाहे चु दुय हजार साल जीवतेलु रवे, ने काय बी सुख काजे हात नी कर्‌यु, ती तीनाक काय फायदु? काय आखा की आखा एकुत जागा पर नी जाय?<verse eid="ECC 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 6:7" />माणसेन आखी मेहनत तेरा पेट वाटे करे, तेबी तेरो मन नी भराये। <verse eid="ECC 6:7" /><verse number="8" style="v" sid="ECC 6:8" />जु अक्‌कल वाळु छे चु डेड़ अकल्‌या सी काहनी वात मां बड़ीन छे? ने गरीब जु की असु जाणे की ईना जीवन मां कसु चालनु चाहजे, च बी तीना सी काहनी वात मां बड़ीन छे? <verse eid="ECC 6:8" /><verse number="9" style="v" sid="ECC 6:9" />डुळा सी देख लेणु मनेन खुसी सी वारु छे; जो बी फालतुत ने मानु वाहळाक धरनेन तसो छे।<verse eid="ECC 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 6:10" />जो काय हवलो छे, तेरो नाव जलम पेहलुत सी पाड़लो छे, ने जो उजेंतो छे की चु माणुस छे, की चु आपसा सी अधु ताकुतवाळा सी लड़ाय नी कर सके। <verse eid="ECC 6:10" /><verse number="11" style="v" sid="ECC 6:11" />बेसकी असी वात छे तेरे वजे सी जीवन अळी बी फालतु रवतो ती अळी माणुस काजे काय फायदु छे? <verse eid="ECC 6:11" /><verse number="12" style="v" sid="ECC 6:12" />माणसेन आपसान थुड़ीक वारेन फालतु जीवनेन साहळान तसु रहे; तेरेमां कुण जाणे की तेर वाटे असला जीवन मां वारलु काय छे? माणुस काजे कुण बताड़ सके की तेरे मरनेन बात दाहड़ा तळे धरती पर काय हवसे?<verse eid="ECC 6:12" /></para>
  <chapter eid="ECC 6" />
  <chapter number="7" style="c" sid="ECC 7" />
  <para style="s">अक्‌कल</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 7:1" />वारलु नाव आखा कीमती इत्‌तर सी ने मरनेन दाहड़ु पयदा हवणेन दाहड़ा सी वदु वारु छे।<verse eid="ECC 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 7:2" />पंगत वाळा घर जाणे सी दुखेन घर जाणु वारु छे; काहाकी आखा माणसेन आकरी जीत छे; ने जु जीवतेलु छे, चु मन लागाड़ीन ईनी वात पर वीच्‌यार करसे।<verse eid="ECC 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 7:3" />हासणे सी दुख वारु छे, काहाकी मुंहडा परुन दुख सी मन सुदरे।<verse eid="ECC 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 7:4" />अक्‌कल वाळान मन दुख करनेवाळान घर भीणी लागलो रहे बाकुन वीन-अकल्‌यान मन खुसी मनावणे वाळान घर लागलो रहे।<verse eid="ECC 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ECC 7:5" />वीन-अकल्‌या माणसेन गीत सामळने सी अक्‌कल वाळान धमकी सामळनु वारु छे।<verse eid="ECC 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ECC 7:6" />काहाकी वीन-अकल्‌यान हासणु हांडी तळे धपतेला काटान चर-चर सामळायणेन तसो छे, जो बी फालतु छे।<verse eid="ECC 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 7:7" />छाचलीन लुच्‌चाई सी अक्‌कल वाळु बी वीन-अकल्‌यु हय जाय; ने कामेन अलग सी अळी अधु पयस्‌या लेणे सी अक्‌कल नास हय जाय।<verse eid="ECC 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 7:8" />गांडा माणसेन गीते सामळने सी वारु छे,</para>
  <para style="p" vid="ECC 7:8">की अक्‌कल वाळु लड़े तीना काजे सामळनु वारु छे।<verse eid="ECC 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 7:9" />आपणा मन मां उतवाळ सी रीसवायणु नी, काहाकी रीस वीन-अकल्‌यान जीव-आत्‌मा मां रवसे।<note caller="+" style="x"><char style="xo" closed="false">7:9 </char><char style="xt" closed="false"><ref loc="JAS 1:19">याकुब 1:19</ref></char></note><verse eid="ECC 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 7:10" />असो नी कवणु, “वीतला दाहड़ा हींद्‌रे सी काहा वारलु हतला?” काहाकी जी वात तु अक्‌कल वाळा काजे नी पुछे।<verse eid="ECC 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 7:11" />जसो वारीसदार मां माल-धन काजे हात करनु वारु छे, तसुत अक्‌कल काजे हात करनु बी वारु, जीवाय वाटे जो फायदा वाळो छे। <verse eid="ECC 7:11" /><verse number="12" style="v" sid="ECC 7:12" />धनवान माणसे सांय अक्‌कल बी राखवाळी करे, ने अक्‌कलेन ने माहतीन फायदु जु छे, की अक्‌कल, अक्‌कल वाळाक जीवतेलु राखे।<verse eid="ECC 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 7:13" />भगवानेन काम पर नींगा कर; तीनी चीजेक चु वाकु करलु हय तीनाक कुण सुदु कर सके? <verse eid="ECC 7:13" /><verse number="14" style="v" sid="ECC 7:14" />दुखेन दाहड़े दुख मान, ने सुकेन दाहड़ाम सुख; काहाकी भगवान दुह्‌यु काजे भेळु मकेलु छे, तेरेसी माणुस आपसे पछेन हवणेवाळी काहनी बी वात काजे समज नी सके।<verse eid="ECC 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 7:15" />मारा फालतु जीवन मां मे ज आखों काय देख्‌यु; कुय धरमी आपसा धरमेन काम करतु जाय्‌न नास हय जाय, ने भुंडु माणुस बुराय करतु जाय्‌न बेसकी उमर जीवे। <verse eid="ECC 7:15" /><verse number="16" style="v" sid="ECC 7:16" />आपसा काजे धरमी मां बणावे, ने नी आपसा काजे अधु अक्‌कल वाळु बणावे; तु काहा आपसान नासेन वजे बणे? <verse eid="ECC 7:16" /><verse number="17" style="v" sid="ECC 7:17" />अधु भुंडु बी मां बणे, ने नी वीन-अकल्‌यु बण; तु काहा आपसान टेमे सी पेहेल मरे? <verse eid="ECC 7:17" /><verse number="18" style="v" sid="ECC 7:18" />जो वारलु छे की तु ईनी वात काजे धरीन राख; ने तीनी वात सी बी हात मां नी हेड़े; काहाकी जु भगवानेन बीहाणो माने चु ईनी आखी गरा सी टळ जासे।<verse eid="ECC 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ECC 7:19" />अक्‌कल सी अक्‌कल वाळा माणसे काजे सहरेन दस हकवाळा सी अधु ताकुत हात करे।<verse eid="ECC 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ECC 7:20" />छाचलीन धरती पर काहनुक असु धरमी माणुस नी हय जु भलाय करतु हय, ने चु पाप नी कर्‌यु हय।<verse eid="ECC 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ECC 7:21" />जतरी वात माणसे कह्‌वे, तींद्‌रे आखा पर कांटा घुण लागाड़े, असो नी हवे की तु सामळे की तारु पावर्‌यु तुसेक सराप आपे; <verse eid="ECC 7:21" /><verse number="22" style="v" sid="ECC 7:22" />काहाकी तु तारा मन मां जाणे की तु बी बेसकी कावा दीसरा काजे सराप आपलु छे।<verse eid="ECC 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ECC 7:23" />जो आखो मे अक्‌कल सी पारखी लेदलु छे; मे कह्‌यु, “मे अक्‌कल वाळु हय जाय्‌स, बाकुन अक्‌कल मार सी छेटीत रय।” <verse eid="ECC 7:23" /><verse number="24" style="v" sid="ECC 7:24" />पलो जो छेटे ने बेसको उंडो छे, तेरी वात कुण जाणी सके? <verse eid="ECC 7:24" /><verse number="25" style="v" sid="ECC 7:25" />मे मारो मन लागाड़्‌यु की अक्‌कलेन बारामां जाणी लम; की हेरो ने तेरी वात जाणो, ने जो बी जाण लम की वीन-अकल्‌या भुंडो काम ने वीन-अक्‌कल गांडी छे।<verse eid="ECC 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ECC 7:26" />मे मर्‌या-सर्‌याम सी बी अदुस दुखेन एक चीज हेर्‌यु, मतलब पली बायरी तेरो मन फांद ने जाळ छे ने तेरे हातकड़्‌या लागला छे, तीना माणुस सी भगवान खुस छे हयुत तेरे सी बची जासे, बाकुन पापी ते नी बचे। <verse eid="ECC 7:26" /><verse number="27" style="v" sid="ECC 7:27" />देख, सीकाड़न्‌यु कह्‌यु, मे जांचणे वाटे मे आंग्‌ये-आंग्‌येन वात भेसक्‌यु, ने जी वात नीकाळ्‌यु, <verse eid="ECC 7:27" /><verse number="28" style="v" sid="ECC 7:28" />तीनाक मारो मन हंय लग हेरी र्‌यो, बाकुन नी जड़्‌यो। हजार मां सी मे एक माणुस काजे हेर्‌यु, बाकुन तींद्‌रेम बी एक बायर बी नी जड़ी। <verse eid="ECC 7:28" /><verse number="29" style="v" sid="ECC 7:29" />देखु, मे जी अतरी वात देख्‌यु की भगवान माणुस काजे सुदु बणायु, बाकुन ची बेसकी मटी युजना नीकाळ्‌यु।<verse eid="ECC 7:29" /></para>
  <chapter eid="ECC 7" />
  <chapter number="8" style="c" sid="ECC 8" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 8:1" />अक्‌कल वाळान तसु कुण छे? ने काहनीक वातेन मतलब कुण जाण सके? माणसेन अक्‌कलेन वजे सी तेरो मुंहडो चमके, ने तेरा मुंहडान काठाय छेटी हय जाय।<verse eid="ECC 8:1" /></para>
  <para style="s">राजान हुकुम मानु</para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 8:2" />मे बी तुसेक कह्‌वो की भगवानेन सगुनेन वजे सी राजान हुकुम मानु। <verse eid="ECC 8:2" /><verse number="3" style="v" sid="ECC 8:3" />राजा अगळ सी उतवाळ करीन पछु घुण आवे, ने नी भुंडा बुल पर धीयान देजी, काहाकी हयु जो चाहे चो करे। <verse eid="ECC 8:3" /><verse number="4" style="v" sid="ECC 8:4" />काहाकी राजान बुल मां ते ताकत रवे, ने कुण कय सके की तु असो काय करे? <verse eid="ECC 8:4" /><verse number="5" style="v" sid="ECC 8:5" />जु हुकुम काजे माने, चु परेसानी सी बची जासे, ने अक्‌कल वाळान मन टेम ने नीयावेन वात काजे जाणे। <verse eid="ECC 8:5" /><verse number="6" style="v" sid="ECC 8:6" />काहाकी हरेक वातेन टेम ने घड़ी रवे, तेबी माणसेन दुख तेरे वाटे बेसकी भारी रह्‌वे। <verse eid="ECC 8:6" /><verse number="7" style="v" sid="ECC 8:7" />हयु नी जाणे की काय हवणे वाळो छे, ने कत्‌यार हवसे? जो तीनाक कुण बताड़ सके? <verse eid="ECC 8:7" /><verse number="8" style="v" sid="ECC 8:8" />असु काहनु माणुस नी हय तेरु बस जीव पर रवे की चु तीनाक नीकळनेन टेमे रुकी लेय, ने नी कुय मरनेन दाहड़ा पर हक करे; ने नी तीनाक लड़ाय सी छुट्‌टी जड़ सके, ने नी भुंडा माणसे आपसा भुंडा कामे सी बची सकसे।<verse eid="ECC 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 8:9" />जतरा काम धरती पर हवे तीनु आखा काजे धीयान सी देखणे सी जो आखों काय मे देख्‌यु, ने असु बी देख्‌यु की एक माणुस दीसरा माणुस पर हक जमाड़ीन आपसा पर नुकसान लावे।<verse eid="ECC 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 8:10" />तत्‌यार मे भुंडला माणसे काजे मसाण मां गाड़तेला देख्‌यु; मतलब तींद्‌रो ते मसाण्‌यो ते बन्‌लो छे, बाकुन जे काहनाक वारु काम करला चे चुखला जागा सी नीकळी गुया ने तींद्‌रो हेर करनु बी सहर मां नी रह्‌यो; जो बी फालतुत छे।<verse eid="ECC 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 8:11" />भुंड्‌ला काम सी डंडेन हुकुम मामार नी देय; तेरेमां माणसेन मन भुंडा काम करनु मन मां भरलो रवे। <verse eid="ECC 8:11" /><verse number="12" style="v" sid="ECC 8:12" />चाहे पापी सोव कावा पाप करे ने आपसान दाहड़ा बी बड़ावे, तेबी मेसेक मालम छे की जु भगवान सी बीहे ने तीनाक आपसा अगळ छे करीन जाणीन बीहाणा सी चाले, तींद्‌रोत भलो हवसे; <verse eid="ECC 8:12" /><verse number="13" style="v" sid="ECC 8:13" />बाकुन भुंडला माणसेन भलो नी हवसे, ने नी तेरी उमर साहळान तसी लांबी हवसे, काहाकी चु भगवानेन बीहाणा काजे नी माने। <verse eid="ECC 8:13" /><verse number="14" style="v" sid="ECC 8:14" />एक फालतु वात धरती पर हवे, मतलब असा धरमी छे तींद्‌री ची हालत हवे जी भुंडला माणसेन हवणु चाहजे, ने असा भुंडला माणसे छे तींद्‌री ची हालत रह्‌वे जी धरमीन हवणु चाहजे। मे कह्‌यु जो बी फालतु छे।<verse eid="ECC 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 8:15" />तत्‌यार मे खुसीन बड़ाय कर्‌यु, काहाकी दाहड़ान नेचो माणसे वाटे खाणे-पीणेन ने खुसी रवणे छुड़ीन अळी दीसरो काय बी वारु नी हय, काहाकी जोत तेरा जीवन भर जों भगवान तेर वाटे धरती पर आपलु छे, तेरा मेहनत मां तेरे भेळे बणीन रवसे।<verse eid="ECC 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 8:16" />जत्‌यार मे अक्‌कल हात करने ने आखा काम देखणे वाटे धरती पर हवे आपसान मन लागाड़्‌यु, की कसु माणुस रात-दाहड़ु जागता रवे; <verse eid="ECC 8:16" /><verse number="17" style="v" sid="ECC 8:17" />तत्‌यार मे भगवानेन आखा काम देख्‌यु जो दाहड़ा तळे करे, तेरु पतु माणुस हेरी नी सके। चाहे माणुस तीनाक हेरने कतरु बी मेहनत करे, तेबी तीनाक जाणी नी सकसे, ने अळी अक्‌कल वाळु बी कवे की मे तीनाक समजी लीस, तेबी तीनाक पतु नी कर सकसे।<verse eid="ECC 8:17" /></para>
  <chapter eid="ECC 8" />
  <chapter number="9" style="c" sid="ECC 9" />
  <para style="s">आखान एकुत वाट छे</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 9:1" />जो आखो काय मे मन लागाड़ीन वीच्‌यार कर्‌यु की ईनु आखी ढाकायली वात काजे जाणो, की कसा धरमी माणसे ने अक्‌कल वाळा माणसे ने तींद्‌रा काम भगवानेन हातेम छे; माणसे अगळ आखी भातीन वात छे बाकुन चु नी जाणे की चो परम छे की बुराय। <verse eid="ECC 9:1" /><verse number="2" style="v" sid="ECC 9:2" />आखी वात आखा वाटे एक सारकी छे, धरमी हय नीते भुंडु, भुळा, चुखलु नीते नी चुखलु, चड़ावु करनेवाळु ने नी करनेवाळा, आखान हालत एक जसी रवे। जसी भलास्‌या माणसेन गती, तसीत पापी माणसेन हालत; जसी सगुन खाणेवाळा हालत, तसीत तेरी जु सगुन खाणे सी बीहे। <verse eid="ECC 9:2" /><verse number="3" style="v" sid="ECC 9:3" />जो काय दाहड़ान नेचो करे तेरेम एक गुनु छे की आखा माणसेन हालत एक जसी रवे, ने माणसेन मन मां बुराय भरली छे, ने जत्‌यार लग चे जीवतेला रवे तींद्‌रा मन मां गांडान तसी छे, ने तेर पछेन मरला भेळे भेसकाय जासे। <verse eid="ECC 9:3" /><verse number="4" style="v" sid="ECC 9:4" />बाकुन जु आखा जीवला मां छे, तीनाक आसा छे, काहाकी जीवतेलो कुतरो मरला नाहार सी बड़ीन छे। <verse eid="ECC 9:4" /><verse number="5" style="v" sid="ECC 9:5" />काहाकी जीवतेला ते अतरो जाणे की चे मरसे, बाकुन मरला काहनी वात बी नी जाणे, ने तीनुक अळी काहींग बदलु जड़ जासे, काहाकी तेरु हेर नास हय जाय। <verse eid="ECC 9:5" /><verse number="6" style="v" sid="ECC 9:6" />तींद्‌रा परम, बुराय ने तींद्‌री दुसमनी खत्‌तम हय गुयली छे, ने हय जो दाहड़ा तळे हवतेलो तेरेम जलम वाटे तींद्‌रु अळी वाटु नी रवसे।<verse eid="ECC 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 9:7" />आपसे वाट्‌ये चालतु जा, ने तारा रुटा खुसी सी खातु रव, ने मन मां सुख मानीन आपसान अंगुरेन रस पीया करे; काहाकी भगवान तारा काम सी खुस हय गुयलु छे। <verse eid="ECC 9:7" /><verse number="8" style="v" sid="ECC 9:8" />तारा पुथल्‌या जलम उजल्‌ळा रवे, ने तारा मुणका पर तेलेन कमी नी रवे। <verse eid="ECC 9:8" /><verse number="9" style="v" sid="ECC 9:9" />आपसा फालतु जीवनेन आखा दाहड़ा जे दाहड़ा तळे ठेहरावलो छे, आपसी घाटाळी बायर भेळे रह्‌वे, काहाकी तारो जीवन ने तारो मेहनत मां तीनु दाहड़ा तळे करे तारु जुत हीस्‌सु छे। <verse eid="ECC 9:9" /><verse number="10" style="v" sid="ECC 9:10" />जो काम तुसेक जड़े तीनाक आपसान ताकत सी करजी, काहाकी मरलान कळजुग मां जां तु जाणे वाळु छे, नीते काम ने नी युजना ने नी माहती ने नी अक्‌कल छे।<verse eid="ECC 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 9:11" />अळी मे दाहड़ा तळे देख्‌यु की नीते दवड़ मां छाटा दवड़ने वाळा ने नी लड़ाय मां ताकुतवाळा जीतसे; ने नी अक्‌कल वाळा माणसेक रुटा जड़से ने नी समज वाळाक धन, ने नी ईज्‌जत वाळा पर दया हवे; चे आखा टेम ने एक दीसरान वस मां छे। <verse eid="ECC 9:11" /><verse number="12" style="v" sid="ECC 9:12" />काहाकी माणुस आपसान टेम नी जाणे। जसा माछा दुखेन जाळ मां ने चिरला फांद मां फांदाये, तसात माणसे दुखेन टेम मां जो तींद्‌रे पर उच्‌कालुन आय जाय ने फस जाय।<verse eid="ECC 9:12" /></para>
  <para style="s">अक्‌कल ने वीन-अकल्‌यान बारामां वीच्‌यार</para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 9:13" />मे दाहड़ा तळे हीनी भाती अक्‌कलेन वात देख्‌यु, जी मेसेक मटी मालम पड़े। <verse eid="ECC 9:13" /><verse number="14" style="v" sid="ECC 9:14" />एक नानोस सहर हतलो, तेरेम थुड़ाकुत माणसे हतला, ने काहनुक मटु राजु तीना पर धीयान करीन घेरवी लेदु, ने तीनुक रुकणे करीन बेसका माणसे सी च्‌यारे मेर हय ज्‌यु। <verse eid="ECC 9:14" /><verse number="15" style="v" sid="ECC 9:15" />बाकुन तेरेम एक गरीब अक्‌कल वाळु माणुस जड़्‌यु, ने चु तीना सहर काजे आपसान अक्‌कल सी बचाड़्‌यु। तेबी काहनु बी तीना गरीब माणुस काजे हेर नी कर्‌या। <verse eid="ECC 9:15" /><verse number="16" style="v" sid="ECC 9:16" />तत्‌यार मे कह्‌यु, “कदी गरीबेन अक्‌कल फालतु समजी जाय ने तेरा बुल कुय बी नी सामळे तेबी ताकुत सी मटी ते अक्‌कल वारु छे।” <verse eid="ECC 9:16" /><verse number="17" style="v" sid="ECC 9:17" />अक्‌कल वाळान बुल जे धीरा रयन कवे चे वीन-अकल्‌यान ईचमां हक करनेवाळा सी आयड़ी-आयड़ीन कवणे सी अधु सामळे। <verse eid="ECC 9:17" /><verse number="18" style="v" sid="ECC 9:18" />लड़ायन बेसका हतीयार सी अक्‌कल वारु छे, बाकुन एक पापी बेसकी भलाय नास करे।<verse eid="ECC 9:18" /></para>
  <chapter eid="ECC 9" />
  <chapter number="10" style="c" sid="ECC 10" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 10:1" />मरला मखड़ा सी इत्‌तरेन तेल भुंडोत गंधायणे ने सड़ने बाजी जाय; ने थुड़ीकुत वीन-अक्‌कल ने मटा नाव काजे कम कर देय।<verse eid="ECC 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 10:2" />अक्‌कल वाळान मन वारलु वात भीणी ली जाय बाकुन वीन-अकल्‌यान मन तेर उल्‌टो रवे। <verse eid="ECC 10:2" /><verse number="3" style="v" sid="ECC 10:3" />ने जत्‌यार वीन-अकल्‌यु वाट्‌ये पर चाले, तत्‌यार तेरी समज काम नी देय, ने चु आखा सी कह्‌वे, “मे वीन-अकल्‌यु छे।”<verse eid="ECC 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 10:4" />कदी राज करन्‌यान रीस तार पर भड़के, ती आपसा जागाक घुण छुड़े, काहाकी गम खाणे सी मटा-मटा गुना रुकी जाय।<verse eid="ECC 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ECC 10:5" />एक बुराय छे जो मे दाहड़ान हेटु देख्‌यु, चो राज करन्‌यान भुल सी हवे: <verse eid="ECC 10:5" /><verse number="6" style="v" sid="ECC 10:6" />मतलब वीन-अकल्‌या माणसेक मटा नावेन जागाम बठाड़े, ने मालदार माणसेक नेचे बठे। <verse eid="ECC 10:6" /><verse number="7" style="v" sid="ECC 10:7" />मे गुलाम पावर्‌या काजे घुल्‌ला पर बसीन जातला देख्‌यु, ने राज करन्‌या गुलाम पावर्‌यान तसा धरती पर चालतेला देख्‌यु।<verse eid="ECC 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 10:8" />जु गड्‌डु खुदसे, चु तेरेत मां पड़से ने जु वाड़ीक तुड़े तेरे घड़सु झुलसे।<note caller="+" style="x"><char style="xo" closed="false">10:8 </char><char style="xt" closed="false"><ref loc="PSA 7:15">भजन सहीता 7:15</ref></char></note> <verse eid="ECC 10:8" /><verse number="9" style="v" sid="ECC 10:9" />जु दगड़ा काजे तुड़े, चु तींद्‌रे सी लीलघाय पड़से, ने जु लाकड़ा काजे काटे, तीनाक तीनात सी बीहाणो लागसे। <verse eid="ECC 10:9" /><verse number="10" style="v" sid="ECC 10:10" />कदी कुरहाड़ बुठड़ी हय ने माणुस तेरी धार काजे तीखी नी करे, ती अधु ताकुत लागाड़नु पड़से; बाकुन काम पुरो हवणे वाटे अक्‌कल सी फायदु हवे। <verse eid="ECC 10:10" /><verse number="11" style="v" sid="ECC 10:11" />कदी बड़वाय सी पेहेल घड़सु झुले, ती बड़वाय करने वाळा काजे काय बी फायदु नी हवे। <verse eid="ECC 10:11" /><verse number="12" style="v" sid="ECC 10:12" />अक्‌कल वाळा बुलेन वजे सी दया हवे, बाकुन वीन-अकल्‌यु आपसा बुल सी नास हय जासे। <verse eid="ECC 10:12" /><verse number="13" style="v" sid="ECC 10:13" />तेरी वातेन सुरुवात वीन-अकल्‌या, ने तेरो आकरी दुखेन गांडाय हवे। <verse eid="ECC 10:13" /><verse number="14" style="v" sid="ECC 10:14" />वीन-अकल्‌यु वात अदुस बुले, तेबी काहनु माणुस नी जाणे की काय हवसे,</para>
  <para style="p" vid="ECC 10:14">ने कुण बताड़ सके की तेर पछेन काय हवणे वाळो छे?<verse eid="ECC 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 10:15" />वीन-अकल्‌या काजे मेहनत सी उजगायुत आवे, अतरो बी की चु नी जाणे की सहर भीणी कसो जाणु।<verse eid="ECC 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 10:16" />ए देस, तार पर हाय जत्‌यार तारु राजु पुर्‌युत छे, ने तारा राज करन्‌या संदारे सीत खाय ने पीये! <verse eid="ECC 10:16" /><verse number="17" style="v" sid="ECC 10:17" />ए देस, तु वारु छे तारु राजु वारुस खानदानीन छे, ने तारा राज करन्‌यान टेम पर खाणो खाय, ने चु बी छाके नी, बाकुन ताकत बड़ावणे वाटे छे।<verse eid="ECC 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 10:18" />उजगाय करनेन वजे सी छतेन लाकड़ा वाका वळ जाय, ने हातेन ढीलाय सी घर उदरी जासे,<verse eid="ECC 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ECC 10:19" />खाणेन तीहवार हासी खुसी वाटे करे, ने अंगुरेन रस सी जीवन मां खुसी जड़े; ने पयस्‌या सी आखों काय जड़े।<verse eid="ECC 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ECC 10:20" />राजा काजे मन मां सराप घुण देवु, ने नी मालदार काजे आपसा सुवणेन खपड़ीम सी सराप देजु; काहाकी काहनीक सरगेन चिरली तारी बुली काजे ली जासे, ने काहनोक उडणेवाळो जनवार तीनी वात काजे उजेंतो कर देसे।<verse eid="ECC 10:20" /></para>
  <chapter eid="ECC 10" />
  <chapter number="11" style="c" sid="ECC 11" />
  <para style="s">अक्‌कल वाळान वेहवार</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 11:1" />आपणी रुटा पाणी पर नाख दे, काहाकी बेसका दाहड़ा पछेन तु तीनाक अळी पछु हात कर लेसी। <verse eid="ECC 11:1" /><verse number="2" style="v" sid="ECC 11:2" />सात नी ने आंठ काजे बी हीस्‌सु आप दे, काहाकी तु नी जाणे की धरती पर कसी गरा आय पड़से।<verse eid="ECC 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 11:3" />कदी वादळा पाणी भरला हय, तत्‌यार तीनाक धरती पर रेचवी दे; ने झाड़को चाहे दखणाव भीणी पड़े नीते धुराव भीणी, तेबी तीना जागा पर झाड़को पड़से, चांत पड़ी रवसे। <verse eid="ECC 11:3" /><verse number="4" style="v" sid="ECC 11:4" />जु किरसाण वाहळा भीणी तपासी रवसे चु बीज नी वेरी सकसे, ने जु वादळा काजे देखतु रवसे, चु मेर काटी नी सकसे। <verse eid="ECC 11:4" /><verse number="5" style="v" sid="ECC 11:5" />जसु तु वाहळाक चालनेन वाट नी जाणे ने कसी भारपाये वाळीन पेट मां हाटका अधे, असुत तु भगवानेन काम नी जाणे जु आखों काय करे।<verse eid="ECC 11:5" /></para>
  <para style="s">जुवानी मां आपणा बणावणे वाळा काजे हेर करु</para>
  <para style="p">
    <verse number="6" style="v" sid="ECC 11:6" />संदारे एगुत तारो बीज वेर, ने सांतु बी तारु हात मां रुके; काहाकी तु नी जाणे की कुण वारु काम करसे, जु की पलु, नीते दुह्‌यु की दुह्‌यु वारलु नीकळसे।<verse eid="ECC 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 11:7" />वीजाळो मन काजे भावे, ने तप काजे देखणे सी डुळा काजे वारु लागे। <verse eid="ECC 11:7" /><verse number="8" style="v" sid="ECC 11:8" />कदी माणुस बेसका साल लग जीवतेलु रवे, ती तीनुक आखा मां खुसी सी रवे; बाकुन जो बी हेर राख की आंधरलान दाहड़े बी बेसका पुर्‌या पारी रवसे। जो काय हवे चो फालतुत छे।<verse eid="ECC 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 11:9" />ए जुवान्‌या, तारी जुवानी मां खुसी कर, ने तारी जुवानीन दाहड़ाम मुरखायतु रवे; तारु मन तुसेक ली जाय, ने तारा डुळान अनसारे चाल। बाकुन असु जाणी जां की ईनु आखी वातेन बारामां भगवान तारु नीयाव करसे।<verse eid="ECC 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 11:10" />आपसा मन मां दुख ने आपसा डील सी दुख छेटे कर, काहाकी पुर्‌या ने जुवानी दुह्‌यु फालतु छे।<verse eid="ECC 11:10" /></para>
  <chapter eid="ECC 11" />
  <chapter number="12" style="c" sid="ECC 12" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 12:1" />आपसा जुवानीन दाहड़ा मां आपसा बणावणे वाळा भगवान काजे हेर कर, नीते ईनु दाहड़ा पछे चे दाहड़ा ने साल आवसे तत्‌यार तु कवसी, “हंय जीवन मां मेसे खुसी नी जड़ती।” <verse eid="ECC 12:1" /><verse number="2" style="v" sid="ECC 12:2" />तेरे सी पेहेल दाहड़ु ने वीजाळो ने चांद ने तारा आंधारला हय जासे, ने पाणी पड़नेन पछे वादळा पछा जाती रवसे; <verse eid="ECC 12:2" /><verse number="3" style="v" sid="ECC 12:3" />तीनी टेमे घरेन राखवाळी करन्‌या कापसे, ने ताकतवाळा नेचा हवसे, जे दळसे चे काम करनु छुड़ देसे काहाकी चे थुड़ाकुत रवसे, ने जे खीड़कीम सी छापीन देखणे वाळान डुळा आंधळा हय जासे। <verse eid="ECC 12:3" /><verse number="4" style="v" sid="ECC 12:4" />ने सयड़क भीणीन बारनो बंद हय जासे, ने चक्‌खी दळनेन अवाज धीरो हवसे, ने तु चिरलीन चो चोव करने सी बी नींद सी उठी जासी। <verse eid="ECC 12:4" /><verse number="5" style="v" sid="ECC 12:5" />अळतेन जे उंचा छे तींद्‌रे सी बीहाणो लाग्‌से, ने वाट्‌ये बीहाड़ने वाळी चीज मानायसे; ने बादामेन झाड़का फुलसे, ने टीड्‌डा बी वजन मां बड़से, ने भुक बड़ावणेन फळ अळी काम नी देसे;</para>
  <para style="p" vid="ECC 12:5">काहाकी माणुस आपसा सदान घर जासे, ने ठुसकीन-ठुसकीन र‌ड़नेवाळा सयड़के-सयड़के फीरसे। <verse eid="ECC 12:5" /><verse number="6" style="v" sid="ECC 12:6" />तीनी टेमे चांदीन तार दुय कुटका हय जासे ने सनान कटव्‌रु टुट जासे, ने झीर धड़्‌ये गुळो फुट्‌से, ने कुवा धड़ेन गड़गस टुट जासे, <verse eid="ECC 12:6" /><verse number="7" style="v" sid="ECC 12:7" />तत्‌यार धुळु धुळा मां भेसकाय जासे, ने आत्‌मा भगवान धड़े जाती रवसे जु तीनी काजे आपलु छे।<verse eid="ECC 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 12:8" />सीकाड़न्‌यु कवे, आखो फालतुत फालतु; आखो फालतुत छे।<verse eid="ECC 12:8" /></para>
  <para style="s">माणसेन आखो काम</para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 12:9" />सीकाड़न्‌यु जु अक्‌कल वाळु ते हतलु, चु माणसे काजे माहतीन वात बी सीकाड़तु रह्‌यु, ने धीयान लागाड़ीन ने जांची पारखीन बेसका दाहड़ा जीवणेन बारामां वात एक चोव सी बताड़तेलु। <verse eid="ECC 12:9" /><verse number="10" style="v" sid="ECC 12:10" />सीकाड़न्‌यु मन काजे भावे तसा बुल हेरे, ने छाचाय सी सीक देणेन बुल लिखी देदु। <verse eid="ECC 12:10" /><verse number="11" style="v" sid="ECC 12:11" />अक्‌कल वाळान बुल नरमायन तसा रवे, ने माणसेक सीकाड़ने वाळान बुल तीखली लाकड़ीन तसा छे, काहाकी एकुत गुवाळ्‌या भीणी सी छे।<verse eid="ECC 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 12:12" />ए मारा पुर्‌या पारी, हीनुत सी चेतीन रव। बेसकी किताप बणावणेन आकरी नी रवे, ने अदुस भन्‌ने सी डील काजे हाराड़ पड़े।<verse eid="ECC 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 12:13" />आखो काय सामळनेन आयो; आकरी वात जी छे भगवानेन बीहाणो मान ने तेरी हुकुम मान; काहाकी माणसेन आखो काय करनु कवे ती जोत छे। <verse eid="ECC 12:13" /><verse number="14" style="v" sid="ECC 12:14" />काहाकी भगवान आखा काम ने आखी ढाकायली वात, चाहे ची वारलु हय नीते भुंडी, नीयाव करसे।<verse eid="ECC 12:14" /></para>
  <chapter eid="ECC 12" />
</usx>