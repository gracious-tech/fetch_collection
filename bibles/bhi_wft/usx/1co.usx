<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CO" style="id">- Bhilali Standard Project</book>
  <para style="h">1 कुरींथी</para>
  <para style="toc3">1 कुरींथी</para>
  <para style="toc2">1 कुरींथी</para>
  <para style="toc1">कुरींथी वाटे पोलुसेन पेहली चिट्‌ठी</para>
  <para style="mt2">कुरिन्थियों के लिए पौलुस की पहली पत्री</para>
  <para style="mt1">कुरींथी वाटे पोलुसेन पेहली चिट्‌ठी</para>
  <para style="imt">पेहली कुरींथीन बारामां</para>
  <para style="ip">पेहली कुरींथी काजे नेवताळु मसीन पयदा धड़े-वड़े पचास साल पछेन <char style="xt"><ref loc="1CO 1:1">1:1</ref></char> लिखलो हतलो। हामरे धड़े जे दुय चिट्‌ठी छे, हींद्‌रे मां सी ज्‌य पेहलो छे तीनाक पोलुस कुरींथीन मंडळी काजे लिखलु, हीयु कांखुर मायन जी चिट्‌ठी ईफीसीयो मां आपणे जाणेन तत्‌यार मेसेडीया जाणेन ने जाणेन वाट मां कुरींथीन आपणे जाणेन इरादा सी पेहल लिखलो। <char style="xt"><ref loc="1CO 16:5-9">16:5-9</ref></char></para>
  <para style="ip">जी चिट्‌ठी हीनु सुचनान सामनु कराड़नी छे ज्‌य पोलुस काजे मंडळीन थुड़ाक जुड़ायला माणसे सी मंडळी मां आंग्‌ये वारु-नी हवे तेरे चाल चलनेन बारामां जड़ली जेरेमां आंग्‌ये-आंग्‌ये ने जबरान छीनाळो भेसकायलो छे पेहला कुरींथी सहर आपणी छीनाळो (जबरान छीनाळो) वाटे वारु रीत सी जाण जातलु हेरसी सुच मां पड़णेन वात नी हय की मंडळीन ईनु मुदान सामनु कर रवली। पेहला कुरींथी मां परम पर नामी पाठ बी भेसकालु छे। <char style="xt"><ref loc="1CO 13">13</ref></char></para>
  <para style="iot">बाहरती वात</para>
  <para style="io1">1. पोलुस कुरींथीन आव-भाव करे ने हींद्‌रे वाटे भगवान काजे तु बेसकु वारु करे। <char style="ior"><ref loc="1CO 1:1-9">1:1-9</ref> </char></para>
  <para style="io1">2. अळतेन चु कुरींथीन मंडळी मां आंग्‌ये हवणेन बारामां हात हवली सुचना काजे अगवाय करे। <char style="ior"><ref loc="1CO 1:10-4:21">1:10—4:21</ref> </char></para>
  <para style="io1">3. हेरे पछेन चु छीनाळो जबरान छीनाळो मे एक दीसरा काजे कुरुट-कचेरी मां ली जाणेन मुदा काजे अगवाय करे। <char style="ior"><ref loc="1CO 5-6">5—6</ref> </char></para>
  <para style="io1">4. हेरे पछेन चु ईयाव-मुरती बादा आखा भेळा हयन पुजा, आखो काय जाणनेन दान ने मरलाम सी पछा जीवता हवणेन मामला पर आदेस देय। <char style="ior"><ref loc="1CO 7-15">7—15</ref> </char></para>
  <para style="io1">5. आखा मां चु थुड़ाक वेहवारेन नातो ने खुदेन मामला साते सर जाय। <char style="ior"><ref loc="1CO 16">16</ref> </char></para>
  <chapter number="1" style="c" sid="1CO 1" />
  <para style="s">आव-भाव करनु</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 1:1" />पोलुस भीणी सी जु भगवानेन मरजी <note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="fq" closed="false">मरजी </char><char style="ft" closed="false">इच्छा</char></note>सी ईसु मसीन नेवताळु हवणे वाटे बुलाय गुयलु छे, ने भायस सोस्‌थीनेस भीणी सी बुलाय गुयलु छे,<verse eid="1CO 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 1:2" />भगवानेन ईनी मंडळीन नाव जे कुरींथीस मां छे, मतलब हींद्‌रो नाव जे ईसु मसी मां चुखला करला, ने चुखला हवणे वाटे बुलाय गुयला छे; ने हीनु आखान बी जे आखी जागा हामरे ने आपणा मालीक ईसु मसीन नाव सी दुवा करजे।<verse eid="1CO 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 1:3" />आपणा भगवान बास ने मालीक ईसु मसीन गीण-दया ने सुक-सांती तुहुंं आखा काजे जड़ती रहणु चाहजे।<verse eid="1CO 1:3" /></para>
  <para style="s">मसी मां बरकत</para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 1:4" />भगवानेन गीण-दया तुहुंं काजे ईसु मसीन साहरे जड़ली छे, हेरेसी मे तुंद्‌रे वाटे आपणा भगवान काजे जलम बेसकु वारु कह्‌या करो। <verse eid="1CO 1:4" /><verse number="5" style="v" sid="1CO 1:5" />की हेरे मां हयन तुहुंं आखी वात मां, मतलब आखा ने आखी अक्‌कल मां मालदार<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="fq" closed="false">मालदार </char><char style="ft" closed="false">धनी</char></note> बणावलु छे <verse eid="1CO 1:5" /><verse number="6" style="v" sid="1CO 1:6" />की मसीन गवाय तुंद्‌रे मां पाक्‌की नीकळी <verse eid="1CO 1:6" /><verse number="7" style="v" sid="1CO 1:7" />जां लग की काहाला बी भगवानेन वाटा मां कमी नी हय, ने तुहुंं हामरा मालीक ईसु मसीन देखायणेन वाट देखता रवु। <verse eid="1CO 1:7" /><verse number="8" style="v" sid="1CO 1:8" />चु तुहुंं काजे आकरी लग काठा बी करसे की तुहुंं हामरा मालीक ईसु मसीन दाहड़ा मां नी-गुनाळा रवु <verse eid="1CO 1:8" /><verse number="9" style="v" sid="1CO 1:9" />भगवान भुरसा वाळु छे, चु तुहुंं काजे आपणा पुर्‌या ने हामरा मालीक ईसु मसीन साजेदारी मां बुलावलु छे।<verse eid="1CO 1:9" /></para>
  <para style="s">मंडळी मां झगड़ा हवे</para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 1:10" />ए मारा भाय, बहणस्‌या मे तुंद्‌रे सी हामरा मालीक ईसु मसीन नाव सी लीलघाये की तुहुंं आखा एकुत वात कह्‌जु, ने तुंद्‌रे मां झगड़ा नी हवणु चाहजे, बाकुन एकुत मन ने एकुत हीया मां हयन मेळीन रवु। <verse eid="1CO 1:10" /><verse number="11" style="v" sid="1CO 1:11" />काहाकी ए मारा भाय-बहणस्‌या, खलोयेन घरेन माणसे मेसे तुंद्‌रे बारामां बताड़ला छे की तुंद्‌रे मां झगड़ा हय र्‌या। <verse eid="1CO 1:11" /><verse number="12" style="v" sid="1CO 1:12" />मारो कवणेन ज्‌य मतलब छे की तुंद्‌रे मां सी कुय ते आपसा काजे “पोलुसेन कह्‌वे” ने कुय अपुल्‌लोस कह्‌वे, कुय “केफान कह्‌वे” ती कुय-कुय “मसीन” कह्‌वे। <verse eid="1CO 1:12" /><verse number="13" style="v" sid="1CO 1:13" />काय मसी आटाय गुयु? काय पोलुस तुंद्‌रे वाटे कुरुस पर चड़ायु गुयु काय? नीते तुहुंं काजे पोलुसेन नाव सी बपतीस्‌मा जड़लो छे काय?<verse eid="1CO 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 1:14" />मे भगवान काजे तु बेसकु वारु छे करीन कह्‌वो की कीर्‌स्‌पुस ने गयुस काजे छुड़ीन मे तुंद्‌रे मां सी काहाला काजे बी बपतीस्‌मा नी आप्‌यु। <verse eid="1CO 1:14" /><verse number="15" style="v" sid="1CO 1:15" />नीते असो नी हवे की कुय कह्‌वे की तुहुंं काजे माणसे नाव पर बपतीस्‌मा जड़लो छे। <verse eid="1CO 1:15" /><verse number="16" style="v" sid="1CO 1:16" />ने हव, मे स्‌तीफनासेन घरन्‌या काजे बी बपतीस्‌मा देदलु छे; ईनु काजे छुड़ीन मे नी जानतु की मे अळी काहालाक काजे बपतीस्‌मा देदु। <verse eid="1CO 1:16" /><verse number="17" style="v" sid="1CO 1:17" />काहाकी मसी मेसे बपतीस्‌मा आपणे करीन नी, बाकुन खुस-खबर सामळणे करीन मकेल्‌लु छे, ने गुयो बी बुलेन अकलेन अनसारे नी, असो नी हवे की मसीन कुरुस फालतु रवे।<verse eid="1CO 1:17" /></para>
  <para style="s">मसी भगवानेन अक्‌कल ने ताकत छे</para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18" />काहाकी कुरुस सी खत्‌तम हवणेवाळा वाटे बेकार छे, बाकुन हीयु छुटकारु जड़ने वाळा वाटे भगवानेन ताकत छे। <verse eid="1CO 1:18" /><verse number="19" style="v" sid="1CO 1:19" />काहाकी लिखलो छे,</para>
  <para style="q1" vid="1CO 1:19">“मे अक्‌कल वाळान अक्‌कल काजे खत्‌तम करीस,</para>
  <para style="q2" vid="1CO 1:19">ने समज वाळान समज काजे बेकार कर दीस।”<note caller="+" style="x"><char style="xo" closed="false">1:19 </char><char style="xt" closed="false"><ref loc="ISA 29:14">यसाया 29:14</ref></char></note><verse eid="1CO 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 1:20" />काहा रया अक्‌कल वाळा? काहा रया यहुदी धरम सीकाड़न्‌या मास्‌तर्‌या? काहा रया ईनी कळीन माणसे वात मां जखड़ी पन्‌या? काय भगवान कळीन अक्‌कल काजे बेकार नी कर्‌यु? <verse eid="1CO 1:20" /><verse number="21" style="v" sid="1CO 1:21" />काहाकी जत्‌यार भगवानेन अकलेन अनसारे कळीन अक्‌कल सी भगवान काजे नी जाण्‌या, ती भगवान काजे ज्‌य वारु लाग्‌यो की ईनी परचारेन डेड़-अकल्‌यान साहरे भुरसु करने वाळा काजे छुटकारु देय। <verse eid="1CO 1:21" /><verse number="22" style="v" sid="1CO 1:22" />यहुदी माणसे ते सहलाणी चाहावे, ने युनानी माणसे अकलेन हेर मां रवे, <verse eid="1CO 1:22" /><verse number="23" style="v" sid="1CO 1:23" />बाकुन हामु ते हीना कुरुस पर चड़ाय गुयला मसीन परचार करजे, जे यहुदीया वाटे ठुकरेन वजे बणे ने नी-यहुदी वाटे डेड़-अकल्‌या छे; <verse eid="1CO 1:23" /><verse number="24" style="v" sid="1CO 1:24" />बाकुन जे बुलाय गुयला छे, काय यहुदी काय नी-यहुदी, हींद्‌रे साते मसी भगवानेन ताकत ने भगवानेन अक्‌कल छे। <verse eid="1CO 1:24" /><verse number="25" style="v" sid="1CO 1:25" />काहाकी भगवानेन डेड़ अक्‌कल माणसेन अक्‌कल सी अक्‌कल वाळा छे, ने भगवान लुल्‌ला माणसेन जुर सी बेसकु ताकतवाळु छे।<verse eid="1CO 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 1:26" />ए भायसे ने भणस्‌या, आपणे बुलाये जाणेन ते सुचु की नी डीलेन अनसारे बेसका अकलवाळा, ने नी बेसका ताकत, ने नी बेसका नावसाद्‌या बुलाय गुया। <verse eid="1CO 1:26" /><verse number="27" style="v" sid="1CO 1:27" />बाकुन भगवान कळीन डेड़-अकल्‌या काजे नेवाड़ लेदु की अकलवाळा काजे सरमाड़े, ने भगवान ईनी कळीन ताकतवाळा माणसेक लाजवाड़े करीन तीनु माणसेक नेवाड़ लेदु, तीनु काजे ईनी कळीन माणसे लुल्‌ला समजे। <verse eid="1CO 1:27" /><verse number="28" style="v" sid="1CO 1:28" />ने भगवान कळीन लुल्‌ला माणसे काजे ने बेकार काजे, बाकुन जे छे बी नी हीनु काजे बी नेवाड़ लेदु की हीनुक जे छे, फालतु<note caller="+" style="f"><char style="fr" closed="false">1:28 </char><char style="fq" closed="false">फालतु </char><char style="ft" closed="false">व्यर्थ</char></note> बणाय देय। <verse eid="1CO 1:28" /><verse number="29" style="v" sid="1CO 1:29" />काहाकी कुय जीव भगवान अगळ मटाय नी करनु चाहजे। <verse eid="1CO 1:29" /><verse number="30" style="v" sid="1CO 1:30" />बाकुन हेरेत भीणी सी तुहुंं ईसु मसी मां छे, जे भगवान भीणी सी हामरे वाटे अक्‌कल ठेहरे, मतलब धरम, ने चुखला, ने छुटकारु; <verse eid="1CO 1:30" /><verse number="31" style="v" sid="1CO 1:31" />काहाकी जसों लिखलो छे, असोत हवे, “जु मटाय करे चु मालीक मां मटाय करे।”<note caller="+" style="x"><char style="xo" closed="false">1:31 </char><char style="xt" closed="false"><ref loc="2CO 10:17">2 कुरींथी 10:17</ref> </char></note><verse eid="1CO 1:31" /></para>
  <chapter eid="1CO 1" />
  <chapter number="2" style="c" sid="1CO 2" />
  <para style="s">कुरुस पर चड़ाय गुयला मसीन बारामां</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1" />ए भायसे-भणस्‌या, जत्‌यार मे भगवानेन सातायली वात सामळीन तुंद्‌रे धड़े आयु, ती बुल नीते अकलेन मट्‌ली वात साते नी आयु। <verse eid="1CO 2:1" /><verse number="2" style="v" sid="1CO 2:2" />काहाकी मे ज्‌य नक्‌खी कर लेदलु छे की तुंद्‌रे ईचमां ईसु मसी ने कुरुस पर चड़ाय गुयला मसी काजे छुड़ीन काहाली बी वात काजे नी जाणो। <verse eid="1CO 2:2" /><verse number="3" style="v" sid="1CO 2:3" />मे लुलु ने बीही जाय्‌न, ने बेसकु कापतु जाय्‌न तुंद्‌रे साते रयु; <verse eid="1CO 2:3" /><verse number="4" style="v" sid="1CO 2:4" />ने मारो बुल ने मारो परचार मे अकलेन पटावणे वाळी<note caller="+" style="f"><char style="fr" closed="false">2:4 </char><char style="fq" closed="false">पटावणे वाळी </char><char style="ft" closed="false">लुभानेवाली</char></note> वात नी, बाकुन आत्‌मान ने ताकुतेन सबुत हतलु, <verse eid="1CO 2:4" /><verse number="5" style="v" sid="1CO 2:5" />हेरेसी की तुंद्‌रु भुरसु माणसेन अक्‌कल पर नी, बाकुन भगवानेन ताकत पर आसरु रवणु चाहजे।<verse eid="1CO 2:5" /></para>
  <para style="s">चुखली-आत्‌मान अक्‌कल</para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6" />ती बी चुखला पाक्‌का माणसे मां हामु अकलेन वात सामळावजे, बाकुन हीनी कळीन ने हीनी कळीन खत्‌तम हवणे वाळा हकदारीन अक्‌कल काजे नी; <verse eid="1CO 2:6" /><verse number="7" style="v" sid="1CO 2:7" />बाकुन हामु भगवानेन चु सातायलु अकल, काजे जे हाल लग उजेंती नी हवी तीनी अक्‌कल काजे उजेंती करजे तीनाक भगवान कळी बणावणे सी पेहलुत हामरा सेक-सींगार वाटे ठेरावलु। <verse eid="1CO 2:7" /><verse number="8" style="v" sid="1CO 2:8" />तेरेसी हीनी कळीन हकदार्‌या मां सी कुय बी नी जाण्‌यो, काहाकी कदी चे जाणता बी ती बेसकु उजाळा मालीक काजे कुरुस पर नी चड़ावता।<note caller="+" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="ACT 13:27">नेवताळान काम 13:27</ref></char></note> <verse eid="1CO 2:8" /><verse number="9" style="v" sid="1CO 2:9" />बाकुन जसों लिखलो छे,</para>
  <para style="q1" vid="1CO 2:9">“जी वात डुळा नी देख्‌या ने कान्‌टा नी सामळ्‌या,</para>
  <para style="q2" vid="1CO 2:9">ने जी वात माणसेन मन मां नी चड़ी,</para>
  <para style="q2" vid="1CO 2:9">चीत छे जु भगवान आपणा परम राखणेवाळा वाटे तीयार छे।”<verse eid="1CO 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 2:10" />बाकुन भगवान हीनुक आपणी आत्‌मान साहरे हामरे पर उजेंतु कर्‌यु, काहाकी आत्‌मा आखी वातो मां, बाकुन भगवानेन सातायली वात बी पारखे। <verse eid="1CO 2:10" /><verse number="11" style="v" sid="1CO 2:11" />माणसे मां सी कुण काहाली माणसेन वात जाणे, सीरप माणसेन आत्‌मा जी हींद्‌रे मां छे; असुत भगवानेन वात बी कुय नी जाणे, सीरप भगवानेन आत्‌मा जाणे।<note caller="+" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="PRO 20:27">नीतीवचन 20:27</ref></char></note> <verse eid="1CO 2:11" /><verse number="12" style="v" sid="1CO 2:12" />बाकुन हामु कळीन आत्‌मा नी, बाकुन ची आत्‌मा जड़ली छे जी भगवान भीणी सी छे की हामु हीनुत वात काजे जाणजे ज्‌य भगवान हामु काजे आपलु छे।<verse eid="1CO 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 2:13" />जीनु काजे हामु माणसेन अकलेन सीकाड़ली वातो मां नी, बाकुन आत्‌मान सीकाड़ली वातो मां, आत्‌मा मां भरायला वातो सी भेळा करी करीन समजाड़े। <verse eid="1CO 2:13" /><verse number="14" style="v" sid="1CO 2:14" />बाकुन डीलेन माणुस भगवानेन आत्‌मान वात काजे हुकारु नी भरे काहाकी चे हेरे देखणे मां डेड़-अकल्‌या वात छे, ने नी चु हीनुक जाण सके काहाकी हींद्‌री पारख आत्‌मा मां भरायला रीत सी हवे। <verse eid="1CO 2:14" /><verse number="15" style="v" sid="1CO 2:15" />आत्‌मा मां भरायला माणुस आखो काय पारखे, बाकुन आपसा काजे कुय बी नी पारख सके। <verse eid="1CO 2:15" /><verse number="16" style="v" sid="1CO 2:16" />“काहाकी मालीकेन</para>
  <para style="q1" vid="1CO 2:16">“मन मां कुण जाण्‌यो?</para>
  <para style="q2" vid="1CO 2:16">की हीनाक सीकाड़े?”</para>
  <para style="p" vid="1CO 2:16">बाकुन हामरे मां मसीन मन छे।<note caller="+" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="ISA 40:13">यसाया 40:13</ref></char></note><verse eid="1CO 2:16" /></para>
  <chapter eid="1CO 2" />
  <chapter number="3" style="c" sid="1CO 3" />
  <para style="s">मंडळी मां आंग्‌ये पंथ बणावणेन झगड़ा</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1" />ए भायसे ने भणस्‌या, मे तुंद्‌रे सी हीनी रीत सी वात नी कर सक्‌यु, जसों आत्‌मा मां भरायला माणसे सी, बाकुन जसों डीलेन माणसे सी, ने हींद्‌रे सी जे ईसु मसी मां पुर्‌या छे। <verse eid="1CO 3:1" /><verse number="2" style="v" sid="1CO 3:2" />मे तुहुंंक दुत पीवाड़्‌यु, अन नी खावाड़्‌यु; काहाकी तुहुंं हीनाक नी खाय सकतेला; बाकुन हय लग बी नी खाय सकता, <verse eid="1CO 3:2" /><verse number="3" style="v" sid="1CO 3:3" />काहाकी हय लग डीलेन छे। हेरेसी की जत्‌यार तुंद्‌रे मां रीस ने झगड़ा छे, ती काय तुहुंं डीलेन नी हय। ने काय माणसेन रीत पर नी चालु? <verse eid="1CO 3:3" /><verse number="4" style="v" sid="1CO 3:4" />काहाकी जत्‌यार एक कह्‌वे, “मे पोलुसेन छे,” ने दीसरु कह्‌वे, “मे अपुल्‌लोस छे,” ती काय तुहुंं डीलेन माणुस नी हय?<verse eid="1CO 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 3:5" />अपुल्‌लोस कुण छे? ने पोलुस कुण छे? सीरप चाकरी करन्‌यु छे, जेरे साहरे तुहुंं भुरसु कर्‌या, जसा आखा एकेक काजे मालीक आपलु छे। <verse eid="1CO 3:5" /><verse number="6" style="v" sid="1CO 3:6" />मे लागाड़्‌यु, अपुल्‌लोस देख-भाळ कर्‌यु, बाकुन भगवान अदाड़्‌यु। <verse eid="1CO 3:6" /><verse number="7" style="v" sid="1CO 3:7" />हेरेसी नी ते लागाड़ने वाळु कायबी नी हय ने नी अदाड़ने वाळु, बाकुन भगवान आखो काय छे जु अदाड़ने वाळु छे। <verse eid="1CO 3:7" /><verse number="8" style="v" sid="1CO 3:8" />लागाड़ने वाळु ने अदाड़ने वाळा दुयु एकुत छे; बाकुन आखा एक अदमी आपणात मेहनेतेन अनसारे आपणीत दाहड़की<note caller="+" style="f"><char style="fr" closed="false">3:8 </char><char style="fq" closed="false">दाहड़की </char><char style="ft" closed="false">मजदूरी</char></note> जड़ली छे। <verse eid="1CO 3:8" /><verse number="9" style="v" sid="1CO 3:9" />काहाकी हामु भगवानेन साजल्‌या छे।</para>
  <para style="p" vid="1CO 3:9">तुहुंं भगवानेन खेत ने भगवानेन घर रवे। <verse eid="1CO 3:9" /><verse number="10" style="v" sid="1CO 3:10" />भगवान हीना गीण-दयान अनसारे ज्‌य मेसे आपलो हतलो, मे अकलवाळु ने मीस्‌तरीन सारकु खुदीन नेवु नाखलु छे, बाकुन हीना पाया पर भीतड़ो ते दीसरात बांदे बाकुन आखा एक माणसे हुसीयार रवु की हेरे पर भीतड़ो कसों बांदणु चाहजे। <verse eid="1CO 3:10" /><verse number="11" style="v" sid="1CO 3:11" />काहाकी हीना नेहा काजे छुड़ीन जी पड़ली छे, ने चु ईसु मसी छे, कुय दीसरु नेवु नी नाख सकतु।<note caller="+" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="ISA 28:16">यसाया 28:16</ref> </char></note> <verse eid="1CO 3:11" /><verse number="12" style="v" sid="1CO 3:12" />कदी कुय हीना नेहा पर सनो नीते चांदी नीते बेसकु महंगु दगड़ु नीते लाकड़ो नीते खड़ नीते सुकलु चारान भीतड़ो बांदे, <verse eid="1CO 3:12" /><verse number="13" style="v" sid="1CO 3:13" />ती आखा एक जणान काम उजेंतो हय जासे; काहाकी चु दाहड़ु हीनाक बताड़से, हेरेसी की आकठा साते उजेंतु हवणे ने चो आकठो आखा एक-एक जणान काम पारखसे की कसु छे। <verse eid="1CO 3:13" /><verse number="14" style="v" sid="1CO 3:14" />जेरो काम हेरे पर बणीन रवसे, तीनाक ईनाम जड़से। <verse eid="1CO 3:14" /><verse number="15" style="v" sid="1CO 3:15" />कदी काहानाक ने काम धपी जासे, ती चु दुख हाकलसे; बाकुन चु आपसुत धपते-धपते बची जासे।<verse eid="1CO 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 3:16" />काय तुहुंं नी जाणता की तुहुंं भगवानेन मंदीर छे, ने भगवानेन आत्‌मा तुंद्‌रे मां वसे? <verse eid="1CO 3:16" /><verse number="17" style="v" sid="1CO 3:17" />कदी कुय भगवानेन मंदीर काजे खत्‌तम करसे, ती भगवान बी हीनाक खत्‌तम कर देसे; काहाकी भगवानेन मंदीर चुखलु छे, ने चे तुहुंं छे।<verse eid="1CO 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 3:18" />कुय आपसात काजे धुकु नी देय। कदी तुंद्‌रे मां सी कुय हीनी कळी मां आपसा काजे अक्‌कल वाळु समजे, ती डेड़ अकल्‌यु बणे की चु भगवान अगळ अकलवाळु बण जाय। <verse eid="1CO 3:18" /><verse number="19" style="v" sid="1CO 3:19" />काहाकी हीनी कळीन अक्‌कल भगवान धड़े डेड़-अकल्‌या छे, जसों चुखला सास्‌तुर मां लिखलो छे, “चु अकलवाळा<note caller="+" style="f"><char style="fr" closed="false">3:19 </char><char style="fq" closed="false">अकलवाळा </char><char style="ft" closed="false">ज्ञानियों</char></note> काजे हींद्‌री हुसारी मां फसाड़ देय” <note caller="+" style="x"><char style="xo" closed="false">3:19 </char><char style="xt" closed="false"><ref loc="JOB 5:13">अय्‌युब 5:13</ref></char></note> <verse eid="1CO 3:19" /><verse number="20" style="v" sid="1CO 3:20" />ने अळी, “मालीक अकलवाळान वीच्‌यार काजे जाणे की चे फालतु छे।”<note caller="+" style="x"><char style="xo" closed="false">3:20 </char><char style="xt" closed="false"><ref loc="PSA 94:11">भजन सहीता 94:11</ref></char></note> <verse eid="1CO 3:20" /><verse number="21" style="v" sid="1CO 3:21" />हेरेसी माणसे पर कुय बी मटाय नी करे, काहाकी आखो काय तुंद्‌रोत छे: <verse eid="1CO 3:21" /><verse number="22" style="v" sid="1CO 3:22" />काय पोलुस, काय अपुल्‌लोस, काय केफा, काय कळी, काय जीवन, काय मरनु, काय हयन घड़ी, काय आवणे वाळी वात, आखो तुंद्‌रोत छे, <verse eid="1CO 3:22" /><verse number="23" style="v" sid="1CO 3:23" />ने तुहुंं मसीन छे, ने मसी भगवानेन छे।<verse eid="1CO 3:23" /></para>
  <chapter eid="1CO 3" />
  <chapter number="4" style="c" sid="1CO 4" />
  <para style="s">मसीन नेवताळु सेवान काम</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1" />माणसे हामुक कम सी कम मसीन पावर्‌या ने भगवानेन सातायली वातेन हीसाब-किताप करन्‌यु समजे। <verse eid="1CO 4:1" /><verse number="2" style="v" sid="1CO 4:2" />पछेन जां हीसाब-किताप करन्‌या मां ज्‌य वात देखी जाय की चु भुरसा वाळु हवे। <verse eid="1CO 4:2" /><verse number="3" style="v" sid="1CO 4:3" />बाकुन मारे देखणे मां जी बेसकी नानली वात छे की तुहुंं नीते माणसेन कुय नीयाव करन्‌यु मेसे पारखे, बाकुन मे खुद आपणे आप काजे नी पारखतु। <verse eid="1CO 4:3" /><verse number="4" style="v" sid="1CO 4:4" />काहाकी मारो मन मेसे काजे काहाली बी वात मां गुनाळु नी ठेरावे, बाकुन हेरेसी मे नी-गुनाळु<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="fq" closed="false">नी-गुनाळु </char><char style="ft" closed="false">निर्दोष</char></note> नी ठेरावतु, काहाकी मेसे पारखणे वाळु मालीक छे।<note caller="+" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="PSA 19:12">भजन सहीता 19:12</ref> </char></note> <verse eid="1CO 4:4" /><verse number="5" style="v" sid="1CO 4:5" />हेरेसी जत्‌यार लग मालीक नी आवे, टेम सी पेहल काहाली बी वातेन नीयाव मां करु; हयुत आंदारला मां डुकायली वात<note caller="+" style="f"><char style="fr" closed="false">4:5 </char><char style="fq" closed="false">डुकायली वात </char><char style="ft" closed="false">छिपी बातें</char></note> उजाळा मां देखाड़से, ने मनेन इरादा<note caller="+" style="f"><char style="fr" closed="false">4:5 </char><char style="fq" closed="false">इरादा </char><char style="ft" closed="false">उद्देश्यों</char></note> काजे उजेंतु करे तत्‌यार भगवान एक-एक काजे तु बेसकु वारु छे करीन कह्‌वे।<verse eid="1CO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 4:6" />ए भायसे, मे हीनु वाते मां तुंद्‌रे वाटे आपणी ने अपुल्‌लोस खबर दाखलान रीत पर कर्‌यु, हेरेसी की तुहुंं हामरे साहरे गुयो सीकु की लिखला सी अगा घुण हवु, ने एकुन एळु ने दीसरान वीरुद मां खुस घुण हवे। <verse eid="1CO 4:6" /><verse number="7" style="v" sid="1CO 4:7" />काहाकी तारे मां ने दीसरा मां कुण संका कर सके? ने तारे धड़े काय छे जु तुसे दीसरा सी नी जड़्‌यो? ने जत्‌यार की तुसे दीसरा सी जड़्‌यो, ती असु मटाय काहा करे की मानु की नी जड़्‌यु? <verse eid="1CO 4:7" /><verse number="8" style="v" sid="1CO 4:8" />तुहुंं ते आफरी गुया, तुहुंं पयस्‌या वाळा हय गुया, तुहुंं हामरे पाखुर राज कर्‌या, बाकुन वारु हवतो की तुहुंं राज करता की हामु बी तुंद्‌रे साते राज करता। <verse eid="1CO 4:8" /><verse number="9" style="v" sid="1CO 4:9" />मारी समज मां भगवान हामु नेवताळान काम काजे आखान पछे हीनु माणसेन तसा ठेरायु, की तींद्‌री मरनेन हुकुम हय गुयो; हव काहाकी हामु कळीन ने सरग वाळा काहवाळ्‌यान ने माणसे वाटे एक तमासु बण गुया। <verse eid="1CO 4:9" /><verse number="10" style="v" sid="1CO 4:10" />हामु मसी वाटे डेड़-अकल्‌या छे, बाकुन तुहुंं ईसु मसी मां अकलवाळा छे; हामु लुल्‌ला छे, बाकुन तुहुंं ताकत वाळा छे। तुहुंं काजे माणसे आव-भाव करे, बाकुन हामु काजे कुय नी आव-भाव करे। <verse eid="1CO 4:10" /><verse number="11" style="v" sid="1CO 4:11" />हामु हीनी टेम लग भुकला पीसला ने नांगरला छे, ने मार खाजे ने मार्‌या-मार्‌या फीरजे; <verse eid="1CO 4:11" /><verse number="12" style="v" sid="1CO 4:12" />ने आपणात हात सी काम करीन मेहनत करजे। माणसे हामु काजे भुंडात कह्‌वे, हामु बरकत आपजे; ने चे एला-पाड़े, हामु सेण करजे। <verse eid="1CO 4:12" /><verse number="13" style="v" sid="1CO 4:13" />चे नाव-बद्‌दी करे, हामु लीलघायजे हामु आज लग कळीन कुहड़ु ने आखी चीजेन खुरचणेन तसा ठेहर्‌या।<verse eid="1CO 4:13" /></para>
  <para style="s">चेतीन रहु करीन कह्‌वे</para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 4:14" />मे तुहुंं काजे सरमाणने वाटे जी वात नी लिखतु, बाकुन आपणु लाटेक्‌लु पुर्‌यु जाणीन तुहुंंक चेतीन रहु करीन लिख रयु। <verse eid="1CO 4:14" /><verse number="15" style="v" sid="1CO 4:15" />काहाकी कदी मसी मां तुंद्‌रा सीकाड़ने वाळा दस हजार बी हवता, ती बी तुंद्‌रा बास बेसका नी हय; हेरेसी की ईसु मसी मां खुस-खबरेन साहरे मे तुंद्‌रु बास छे। <verse eid="1CO 4:15" /><verse number="16" style="v" sid="1CO 4:16" />हेरेसी मे तुंद्‌रे सी लीलघाय्‌न कह्‌वो की तुहुंं मारेन तसा चाल चालु। <verse eid="1CO 4:16" /><verse number="17" style="v" sid="1CO 4:17" />हेरेसी मे तीमुथीयुस काजे जु मालीक मां मारु लाटेक्‌लु ने भुरसा मां काठु पुर्‌यु छे, तुंद्‌रे धड़े मकल्‌यु। चु तुहुंं काजे ईसु मसी मां मारा वेहवारेन बारामां हेर कराड़से, जसों की मे आखी जागा आखी एक मंडळी मां परचार करो।<verse eid="1CO 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 4:18" />काहानाक ते असा फुगी गुया, की जाणु की मे तुंद्‌रे धड़े आवतु नी। <verse eid="1CO 4:18" /><verse number="19" style="v" sid="1CO 4:19" />बाकुन मालीक चाह्‌यु ती मे तुंद्‌रे धड़े छाटु आवीस, ने हीनु फुगलान वात काजे नी, बाकुन हींद्‌री ताकत काजे जाणी लीस। <verse eid="1CO 4:19" /><verse number="20" style="v" sid="1CO 4:20" />काहाकी भगवानेन राज वात मां नी बाकुन ताकत मां छे। <verse eid="1CO 4:20" /><verse number="21" style="v" sid="1CO 4:21" />तुहुंं काय चाहवु? काय मे लाकड़ी लीन तुंद्‌रे धड़े आवो, नीते परम ने नमरेन आत्‌मा साते आवो?<verse eid="1CO 4:21" /></para>
  <chapter eid="1CO 4" />
  <chapter number="5" style="c" sid="1CO 5" />
  <para style="s">मंडळी मां छीनाळो</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1" />जां लग सामळने मां आवे की तुंद्‌रे मां छीनाळो<note caller="+" style="f"><char style="fr" closed="false">5:1 </char><char style="fq" closed="false">छीनाळो </char><char style="ft" closed="false">व्यभिचार</char></note> हवे, बाकुन असो छीनाळो की ज्‌य नी-यहुदी मां बी नी हवे की एक माणुस आपणा बासेन बायरी काजे राखे। <verse eid="1CO 5:1" /><verse number="2" style="v" sid="1CO 5:2" />ने तुहुंं दुख<note caller="+" style="f"><char style="fr" closed="false">5:2 </char><char style="fq" closed="false">दुख </char><char style="ft" closed="false">शोक</char></note> ते नी करु, जेरेसी असा काम करने वाळा तुंद्‌रे ईचमां मां सी नीकळी जाय, बाकुन तुहुंं मटाय करु। <verse eid="1CO 5:2" /><verse number="3" style="v" sid="1CO 5:3" />मे ते डीलेन भाव सी छेटु हतलु, बाकुन आत्‌मान भाव सी तुंद्‌रे साते हयन मानु की जागे हुबु हवणेन टेम मां असा काम करने वाळान बारामां ज्‌य फेसलु आप देदु, <verse eid="1CO 5:3" /><verse number="4" style="v" sid="1CO 5:4" />की जत्‌यार तुहुंं ने मारी आत्‌मा, हामरा मालीक ईसुन ताकत साते भेळा हवु, ती असा माणसे हामरा मालीक ईसुन नाव सी, <verse eid="1CO 5:4" /><verse number="5" style="v" sid="1CO 5:5" />डीलेन नासेन वाटे भुतड़ा काजे आप देय, काहाकी हेरी आत्‌मा मालीक ईसुन दाहड़ा मां छुटकारु<note caller="+" style="f"><char style="fr" closed="false">5:5 </char><char style="fq" closed="false">छुटकारु </char><char style="ft" closed="false">उद्धार</char></note> जड़े।<verse eid="1CO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 5:6" />तुंद्‌रो मटाय करनु वारु नी हय; काय तुहुंं नी जाणु की ईतरोक खाण्‌यु-सुडु आखा गुंदला पीठा काजे आथुड़ कर देय। <verse eid="1CO 5:6" /><verse number="7" style="v" sid="1CO 5:7" />जुन्‌डला आथुड़ काजे नीकाळीन आपणे खुद काजे चुखा करु की नवलु गुंदलु पीठु बणी जावु; काहाकी तुहुंं आथुड़ वाळा नी हय। काहाकी हामरु बी तीहवार, जु मसी छे, बादान रुप मां चड़ गुयु। <verse eid="1CO 5:7" /><verse number="8" style="v" sid="1CO 5:8" />हेरेसी आवु, हामु खुसी मां खुसी मनावजे, नीते जुन्‌डला आथुड़ सी ने नी कुहराय ने भुंड्‌ला आथुड़ सी, बाकुन सय ने छाचाय्‌न आथुड़ पाकुर बन्‌नला रुटा सी।<verse eid="1CO 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 5:9" />मे मारी चिट्‌ठी मां तुहुंंक लिखलु छे की छीनाळ्‌यान संगत घुण करे। <verse eid="1CO 5:9" /><verse number="10" style="v" sid="1CO 5:10" />ज्‌य नी की तुहुंं सय मां हीनी कळीन छीनाळ्‌यान, नीते लालच्‌यान, नीते आंदारलो करने वाळान, नीते मुरती पुजणे वाळान संगत नी करनु चाहजे; काहाकी हीनी टेम मां ते तुहुंं काजे कळी मां सी नीकळीन जाणु पड़तो। <verse eid="1CO 5:10" /><verse number="11" style="v" sid="1CO 5:11" />बाकुन मारो कह्‌वणु ज्‌य छे की कदी कुय भायस कह्‌वाय, ने छीनाळ्‌यु, नीते लालच्‌यु, नीते मुरती पुजण्‌यु, नीते गाळी देण्‌यु, नीते दारु पीण्‌यु, नीते आंदारलो करने वाळु, ती तेरी संगत घुण करे; बाकुन असा माणुस साते रुटा बी घुण खाय।<verse eid="1CO 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 5:12" />काहाकी मेसे बाहार वाळान नीयाव करने सी काय काम? काय तुहुंं माहें वाळान नीयाव नी करु? <verse eid="1CO 5:12" /><verse number="13" style="v" sid="1CO 5:13" />बाकुन बाहार वाळान नीयाव भगवान करे। हेरेसी हीना पापी काजे आपणे ईचमां सी नीकाळ देवु।<verse eid="1CO 5:13" /></para>
  <chapter eid="1CO 5" />
  <chapter number="6" style="c" sid="1CO 6" />
  <para style="s">ईसु पर भुरसु करन्‌या मां मारा मारी</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1" />काय तुंद्‌रे मां सी काहालाक काजे जी हिम्‌मत छे की जत्‌यार दीसरा साते लड़ाय हय जाय ती नीयाव वाटे नी-भुरसु करने वाळा धड़े जाय, ने चुखला माणसे धड़े नी जाय? <verse eid="1CO 6:1" /><verse number="2" style="v" sid="1CO 6:2" />काय तुहुंं नी जाणु की चुखला माणसे कळीन नीयाव करसे? हेरेसी जत्‌यार तुहुंंक कळीन नीयाव करनु छे, ती काय तुहुंं नानला सी नानला बी झगड़ा नी सरे काय? <verse eid="1CO 6:2" /><verse number="3" style="v" sid="1CO 6:3" />काय तुहुंं नी जाणता की हामु सरग वाळा काहवाळ्‌यान नीयाव करसुन ती ईनी कळी मां हवणे वाळु नानुस झगड़ु भांगता नी आवड़े काय? <verse eid="1CO 6:3" /><verse number="4" style="v" sid="1CO 6:4" />कदी तुहुंंक कळीन वात काजे नीयाव करसे नीते सारनु हय, ती काय हीनुत काजे बठाड़सु काय जे मंडळी मां काय बी नी समजी जाय? <verse eid="1CO 6:4" /><verse number="5" style="v" sid="1CO 6:5" />मे तुहुंंक लाजवाड़ने<note caller="+" style="f"><char style="fr" closed="false">6:5 </char><char style="fq" closed="false">लाजवाड़ने </char><char style="ft" closed="false">लज्जित</char></note> करीन जी वात कह्‌वो। काय छाचलीन तुंद्‌रे मां एक बी अकलवाळु नी जड़े, जु तुंद्‌रु भायस्‌यान झगड़ु भांगे असु नी हय काय? <verse eid="1CO 6:5" /><verse number="6" style="v" sid="1CO 6:6" />तुंद्‌रे मां भायस-भायसेन ईचमां दावु हवे, ने चे बी नी भुरसु करन्‌यान अगळ।<verse eid="1CO 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 6:7" />बाकुन छाचलीन तुंद्‌रे मां मटुत वाक ते ज्‌य छे की आंबा-सांबा लड़ाय करु। बयमानी काजे काहानी सेण करता? आपणा दुख काजे काहानी सेण करता? <verse eid="1CO 6:7" /><verse number="8" style="v" sid="1CO 6:8" />बाकुन तुहुंं ते खुद बयमानी ने दुख पुगाड़ु, ने चे बी भायस्‌यो काजे। <verse eid="1CO 6:8" /><verse number="9" style="v" sid="1CO 6:9" />भुंड्‌ला माणसे सरग राजेन हकदार्‌या नी रवे, जी वात तुहुंंक मालुम नी हय काय? खुद काजे धुकु मां खावु नी। छीनाळ्‌या, नी मुरती पुजण्‌या, नी रंडी ने रंडीक राखण्‌या, नी लुच्‌चा नी अदमी साते गलत काम करन्‌या माणसे, <verse eid="1CO 6:9" /><verse number="10" style="v" sid="1CO 6:10" />चुट्‌टा, हीजेरला, दारकुट्‌या, गाळी देण्‌या, धुकु देण्‌या माणसे सरग राजेन हकदार्‌या नी रवे। <verse eid="1CO 6:10" /><verse number="11" style="v" sid="1CO 6:11" />ने तुंद्‌रे मां सी कतरा असात हतला, बाकुन तुहुंं मालीक ईसु मसीन नाव सी ने आपणा भगवानेन आत्‌मा सी धुवायला छे, ने चुखला हया ने धरमी ठहर्‌या।<verse eid="1CO 6:11" /></para>
  <para style="s">आपणो डील भगवानेन सेक-सींगार वाटे वाप्‌रु</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12" />आखी चीजे<note caller="+" style="f"><char style="fr" closed="false">6:12 </char><char style="fq" closed="false">चीजे </char><char style="ft" closed="false">वस्तुएँ</char></note> मारे वाटे सय ते छे, बाकुन आखी चीजे फायदान नी हय; आखी चीजे मारे वाटे वारु ते छे, बाकुन मे काहली बी वातेन हक मां नी हवे। <verse eid="1CO 6:12" /><verse number="13" style="v" sid="1CO 6:13" />खाणो पेट वाटे छे, ने पेट खाणा वाटे छे, बाकुन भगवान हीनी काजे ने हीना काजे दुयु काजे खत्‌तम<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="fq" closed="false">खत्‌तम </char><char style="ft" closed="false">नाश</char></note> करसे। बाकुन डील छीनाळा करने वाटे नी हय, बाकुन मालीक वाटे छे, ने मालीक डील वाटे छे। <verse eid="1CO 6:13" /><verse number="14" style="v" sid="1CO 6:14" />भगवान आपणी ताकत सी मालीक काजे मरलाम सी जीवाड़्‌यु, ने हामुक बी जीवाड़्‌यु।<verse eid="1CO 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 6:15" />काय तुहुंं नी समजता की तुंद्‌रु डील मसीन भाग छे? ती काय मे मसीन भाग लीन छीनाळान भाग बणावो? कदी नी। <verse eid="1CO 6:15" /><verse number="16" style="v" sid="1CO 6:16" />काय तुहुंं नी जानता की जे कुय माणुस छीनाळ्‌या सी संगत करे, चु हेरे साते एक जसु बणी जाय? काहाकी लिखलो छे, “चे दुयु एक डील हय जासे।” <verse eid="1CO 6:16" /><verse number="17" style="v" sid="1CO 6:17" />ने जे मालीकेन संगत मां रवे, चु तेरे साते एक आत्‌मा हय जाय।<verse eid="1CO 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 6:18" />छीनाळा सी बचीन रवु। जतरा आंग्‌ये-आंग्‌ये माणसे पाप करे चे डीलेन सी बाहार करे, बाकुन छीनाळो करने वाळु आपणात डीलेन वीरुद पाप करे। <verse eid="1CO 6:18" /><verse number="19" style="v" sid="1CO 6:19" />काय तुहुंं नी जाणु की तुंद्‌रु डील चुखली-आत्‌मान मंदीर छे, जु तुंद्‌रे मां बसलु छे ने तुहुंंक भगवान भीणी सी जड़लु छे; ने तुहुंं आपणा नी हय? <verse eid="1CO 6:19" /><verse number="20" style="v" sid="1CO 6:20" />काहाकी कीमत दीन मुल ली लेदला छे, हेरेसी आपणा डीलेन अनसारे भगवानेन सेक-सींगार करु।<verse eid="1CO 6:20" /></para>
  <chapter eid="1CO 6" />
  <chapter number="7" style="c" sid="1CO 7" />
  <para style="s">ईयावेन बारामां सवाल</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 7:1" />हीनु वातेन बारामां ज्‌य तुहुंं लिख्‌या, ज्‌य वारु छे, की अदमी बायरी काजे नी धरे<note caller="+" style="f"><char style="fr" closed="false">7:1 </char><char style="fq" closed="false">धरे </char><char style="ft" closed="false">छूए</char></note>। <verse eid="1CO 7:1" /><verse number="2" style="v" sid="1CO 7:2" />बाकुन छीनाळान धाक सी आखा अदमीन बायरी हवणु चाहजे, ने आखी बायरीन अदमी रवणु चाहजे। <verse eid="1CO 7:2" /><verse number="3" style="v" sid="1CO 7:3" />अदमी आपणी बायरीन हक पुरु करे; ने असोत बायरी बी आपणा अदमीन हक पुरु करे। <verse eid="1CO 7:3" /><verse number="4" style="v" sid="1CO 7:4" />बायरी काजे आपणा डील पर हक नी बाकुन हेरा अदमीन हक छे; असात अदमी काजे बी आपणा डील पर हक नी, बाकुन बायरीन छे। <verse eid="1CO 7:4" /><verse number="5" style="v" sid="1CO 7:5" />तुहुंं एक दीसरा सी आंग्‌ये मां रहु; बाकुन सीरप थुड़ीक टेम लग दुय जणान राजी मरजी सी की दुवा वाटे छुट्‌टी जड़े, ने अळतेन एक साते रहु; असो नी हवे की तुहुंं खुद नी हवणेन वजे सी भुतड़ु तुहुंं काजे पारखे।<verse eid="1CO 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 7:6" />बाकुन मे गुयो कह्‌वो चो माननेन<note caller="+" style="f"><char style="fr" closed="false">7:6 </char><char style="fq" closed="false">माननेन </char><char style="ft" closed="false">अनुमति</char></note> छे नी की हुकुम। <verse eid="1CO 7:6" /><verse number="7" style="v" sid="1CO 7:7" />मे ज्‌य चाहो की जसु मे छे, असुत आखा माणसे हवे; बाकुन आखा एक काजे भगवान भीणी सी खासकरीन वाटु जड़ला छे काहालाक काजे काहलाक रीती सी, ने; काहालाक काजे काहालीक रीत सी जड़लो छे।<verse eid="1CO 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 7:8" />बाकुन मे नी-ईयाव करला ने रांडायलान<note caller="+" style="f"><char style="fr" closed="false">7:8 </char><char style="fq" closed="false">रांडायलान </char><char style="ft" closed="false">विधवाओं</char></note> बारामां कह्‌वो की हींद्‌रे वाटे असोत रह्‌वणु वारु छे, जसु मे छे। <verse eid="1CO 7:8" /><verse number="9" style="v" sid="1CO 7:9" />बाकुन कदी चे खुद नी कर सके, ती ईयाव करे; काहाकी ईयाव करनु मन मां तरसायणे सी वारु छे।<verse eid="1CO 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 7:10" />तींद्‌रु ईयाव हय गुयु, हीनुक मे नी, बाकुन मालीक हुकुम आपे की बायरी आपणा अदमी सी छेटी नी रवणु चाहजे; <verse eid="1CO 7:10" /><verse number="11" style="v" sid="1CO 7:11" />ने कदी छेटा बी हय जाय, ती अळी दीसरा सी ईयाव घुण करु; नीते आपणा अदमी सी अळी मेळी जावु ने नी अदमी आपणी बायरी काजे छुड़े।<verse eid="1CO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 7:12" />दीसरा सी मालीक नी बाकुन मेत कय र्‌यु, कदी काहानाक भायसेन बायरी भुरसु नी राखे ने तेरे साते रह्‌वणे सी खुसी हवे, ती चु हीनीक नी छुड़े। <verse eid="1CO 7:12" /><verse number="13" style="v" sid="1CO 7:13" />जीनी बायरीन अदमी भुरसु नी राखे, ने हेरे साते रवणे सी खुसी हवे; ची अदमी काजे नी छुड़नु चाहजे। <verse eid="1CO 7:13" /><verse number="14" style="v" sid="1CO 7:14" />काहाकी असु अदमी जु भुरसु नी राखतु हय, चु बायरीन वजे सी चुखलु रवे; ने असी बायरी जी भुरसु नी राखे, अदमीन वजे सी चुखली रवसे; नी ते तुंद्‌रा पुर्‌या-पारी वीटेळ्‌ळा हवता, बाकुन हय चे चुखला छे। <verse eid="1CO 7:14" /><verse number="15" style="v" sid="1CO 7:15" />बाकुन जु अदमी भुरसु नी राखे, कदी चु आंग्‌ये हवे ती आंग्‌ये हवणी दे, असी टेम मां कुय भायस नीते बहणीस गुलाम नी हय। भगवान हामुक सांती मां रवणे करीन बुलावलु छे। <verse eid="1CO 7:15" /><verse number="16" style="v" sid="1CO 7:16" />काहाकी ए बायरी, तु काय जाणे की तु आपणा अदमीन छुटकारु कराड़ लेसी? ने ए अदमी, तु काय जाणे की तु आपणी बायरीन छुटकारु कराड़ लेसी?<verse eid="1CO 7:16" /></para>
  <para style="s">भगवानेन बुलावणेन अनसारे चालु</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 7:17" />जसु मालीक आखा एक जणा काजे आटलु छे, ने जसु भगवान आखा एक काजे बुलावलु छे, असात चे चाले। मे आखी मंडळी मां असुत ठेरावो। <verse eid="1CO 7:17" /><verse number="18" style="v" sid="1CO 7:18" />जु चामड़ी काटलु बुलाय गुयलु छे, चु पछु चामड़ी वाळु मां बणे। चु चामड़ी नी काटलु बुलाय गुयलु छे, चु चामड़ी मां काटाड़े। <verse eid="1CO 7:18" /><verse number="19" style="v" sid="1CO 7:19" />नी फतरी काटाड़न्‌यु काय छे ने नी फतरी काटाड़न्‌यु काय छे, बाकुन भगवानेन हुकुम काजे मान्‌नु आखो काय छे। <verse eid="1CO 7:19" /><verse number="20" style="v" sid="1CO 7:20" />आखा एक जणा जीनी टेमे बुलाय गुयला छे, हेरेन मां रवे। <verse eid="1CO 7:20" /><verse number="21" style="v" sid="1CO 7:21" />कदी तु पावर्‌यान टेम मां बुलाय गुयलु छे ती फीकुर मां करे; बाकुन कदी तु गुलामी मां सी छुटी जाय ती असुत काम करे। <verse eid="1CO 7:21" /><verse number="22" style="v" sid="1CO 7:22" />काहाकी जु पावर्‌यान घड़ी मां मालीक मां बुलाय गुयलु छे, चु मालीकेन गुलाम मां सी छुड़ावलु छे। असात जु गुलाम मां सी छुड़ावणेन घड़ी मां बुलाय गुयलु छे, चु मसीन पावर्‌यु छे। <verse eid="1CO 7:22" /><verse number="23" style="v" sid="1CO 7:23" />तुहुंं कीमत दीन मुल ली लेदला छे; माणसेन पावर्‌या मां बणु। <verse eid="1CO 7:23" /><verse number="24" style="v" sid="1CO 7:24" />ए भायस्‌यो ने बहणस्‌या, जे कुय जीनी घड़ी मां बुलाय गुयला छे, चु हेरेत मां भगवान साते रवे।<verse eid="1CO 7:24" /></para>
  <para style="s">ईयाव नी करला ने रांडायला</para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 7:25" />कुवारलीन बारामां मालीकेन कुय हुकुम मेसे नी जड़्‌यु, बाकुन भुरसा मां पाक्‌कु हवणे वाटे जसी दया मालीक मारे पर कर्‌यु, हेरेत अनसारे वात आपो।<verse eid="1CO 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 7:26" />हेरेसी मारी समज मां ज्‌य वारु छे की आज काल दुखेन वजे सी, माणुस जसु छे असुत रवे। <verse eid="1CO 7:26" /><verse number="27" style="v" sid="1CO 7:27" />हेरेसी कदी तारी बायरी छे, ती छेटु हवणेन वीच्‌यार मां करे; ने कदी तारी बायरी नी हय, ती बायरीन हेर मां करे। <verse eid="1CO 7:27" /><verse number="28" style="v" sid="1CO 7:28" />बाकुन कदी तु ईयाव बी करे, ती पाप नी हय; ने कदी कुवारली साते ईयाव हय जाय ती कुय पाप नी। बाकुन असला काजे डीलेन दुख हवसे, ने मे बचाड़ने चाहो।<verse eid="1CO 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 7:29" />ए भायसे, मे ज्‌य कह्‌वो की टेम कम कर देदलो छे, हेरेसी चाहजे की तींद्‌री बायरी रवे, चे असा हवे मानु की हींद्‌री बायरी नी हय; <verse eid="1CO 7:29" /><verse number="30" style="v" sid="1CO 7:30" />ने रड़ने वाळा असा हवे, की मानु रड़े नी; ने खुसी करने वाळा असा हवे, की मानु खुसी नी करे; ने मुल लेणे वाळा असा हवे, की मानु हींद्‌रे धड़े काय नी हय। <verse eid="1CO 7:30" /><verse number="31" style="v" sid="1CO 7:31" />ने हीनी कळी साते एहवार करने वाळा असो हवे, की कळीन ने ती हय जाय; काहाकी हीनी कळीन रीती ने एहवार बदलता जाय।<verse eid="1CO 7:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CO 7:32" />अळतेन मे ज्‌य चाहो की तुहुंंक फीकुर नी हवे। नी ईयाव करलु अदमी मालीकेन वातेन फीकुर मां रवे की मालीक काजे कसु खुस राखे। <verse eid="1CO 7:32" /><verse number="33" style="v" sid="1CO 7:33" />बाकुन ईयाव करलु माणुस कळीन वातेन फीकुर मां रवे की आपणी बायरी काजे काहाली रीत सी खुसी करे। <verse eid="1CO 7:33" /><verse number="34" style="v" sid="1CO 7:34" />ईयाव करला ने कुवारली मां बी छीट छे; कुवारली मालीकेन फीकुर मां रवे की चु डील ने आत्‌मा दुयु मां चुखला रवे, बाकुन ईयाव करली कळीन फीकुर मां रवे की आपणा अदमी काजे कसी खुस राखे।<verse eid="1CO 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 7:35" />मे जी वात तुंद्‌रेत फायदान वाटे कह्‌वो, नी की तुहुंंक फसाड़ने वाटे, बाकुन हेरेसी की जसु सुभु देय असो कर्‌यो जाय की, तुहुंं एक मन हयन मालीकेन सेवा मां लागी रवु।<verse eid="1CO 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 7:36" />कदी कुय ज्‌य समजे की मे आपणी हेनी कुवारीन हक काजे मारी र्‌यु, ती जेरो जुवानी ढळी रय, ने जरुड़ी बी छे, ती जसों चाहे असात करे, तेरेमां पाप नी हय, चु हेरु ईयाव हवणी देय। <verse eid="1CO 7:36" /><verse number="37" style="v" sid="1CO 7:37" />बाकुन जो मन मां नक्‌खी कर लेय, ने हीनाक जरुड़ी नी हय, बाकुन आपणी मरजी पर हक राखो, ने आपणा मन मां जी वात ठाणी ले की चु आपणी कुवारी पुरे काजे ईयाव नी हवणी देय, चु वारु करे। <verse eid="1CO 7:37" /><verse number="38" style="v" sid="1CO 7:38" />हेरेसी जु आपणी कुवारीन ईयाव कर देय, चु वारु करे, ने जे ईयाव नी करे, चु अळी बी वारु करे।<verse eid="1CO 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 7:39" />जत्‌यार लग काहालीक बायरीन अदमी जीवतु रवे, तत्‌यार लग चु हेरेसी बांदायली छे; बाकुन कदी तेरे अदमी मर जाय, ती जेरेसी चाहे ईयाव कर सके बाकुन सीरप मालीक मां। <verse eid="1CO 7:39" /><verse number="40" style="v" sid="1CO 7:40" />बाकुन जसी छे कदी असीत रवे, ती मारे वीच्‌यार मां अळी बी बेसकु वारु छे; ने मे समजो की भगवानेन आत्‌मा मारे मां बी छे।<verse eid="1CO 7:40" /></para>
  <chapter eid="1CO 7" />
  <chapter number="8" style="c" sid="1CO 8" />
  <para style="s">मुरती पर चड़ावलो परसात</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1" />हय मुरती अगळ बादा देदली चीजेन बारामां हामु जाणजे की हामु आखा काजे अक्‌कल छे। अक्‌कल मटाय काजे पयदा करे, बाकुन परम सी अगा बड़े। <verse eid="1CO 8:1" /><verse number="2" style="v" sid="1CO 8:2" />कदी कुय समजे की मे काय जाणो, ती जसों जाननु चाहजे असो हय लग नी जाणता। <verse eid="1CO 8:2" /><verse number="3" style="v" sid="1CO 8:3" />बाकुन कदी कुय भगवान सी परम करे ती भगवान तीनाक उळखे।<verse eid="1CO 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 8:4" />अळतेन मुरती लग बादा करली चीजेन खाणेन बारामां हामु जाणजे की मुरती कळी मां कुय चीज नी हय, ने एक काजे छुड़ीन ने कुय भगवान नी हय। <verse eid="1CO 8:4" /><verse number="5" style="v" sid="1CO 8:5" />तेबी सरगे मां ने कळी मां बेसका भगवान कह्‌वाये जसों की बेसका भगवान ने बेसका मालीक छे। <verse eid="1CO 8:5" /><verse number="6" style="v" sid="1CO 8:6" />तेबी हामरे वाटे ते एकुत भगवान छे; मतलब बास जेरे भीणी सी आखी चीजे छे, ने हामु हेरेत वाटे छे। ने एकुत मालीक छे, मतलब ईसु मसी जेरे साहरे आखी चीजे हवी, ने हामु बी हेरेत साहरे छे।<note caller="+" style="x"><char style="xo" closed="false">8:6 </char><char style="xt" closed="false"><ref loc="JHN 1:3">युहन्‌ना 1:3</ref></char></note><note caller="+" style="x"><char style="xo" closed="false">8:6 </char><char style="xt" closed="false"><ref loc="ROM 11:3">रोमीयो 11:3</ref></char></note><verse eid="1CO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 8:7" />बाकुन आखा काजे गुयु अक्‌कल नी हय, बाकुन ईतराक ते हय लग मुरती काजे काय समजणेन वजे सी मुरतीन अगळ बादा चड़ावली चीज काजे काय समजीन खाय, ने हींद्‌रो मन लुलो हवणेन वजे सी वीटळी<note caller="+" style="f"><char style="fr" closed="false">8:7 </char><char style="fq" closed="false">वीटळी </char><char style="ft" closed="false">अशुद्ध</char></note> जाय। <verse eid="1CO 8:7" /><verse number="8" style="v" sid="1CO 8:8" />खाणो हामुक भगवान धड़े नी पुगाड़े। कदी हामु नी खाजे ती आपणो काय नुकसाण<note caller="+" style="f"><char style="fr" closed="false">8:8 </char><char style="fq" closed="false">नुकसाण </char><char style="ft" closed="false">हानि</char></note> नी हय, ने कदी खाय ती काय फायदु नी।<verse eid="1CO 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 8:9" />बाकुन हुस्‌यार असो नी हवे की तुंद्‌री जी गुलाम मां सी छुटणेन काय लुला वाटे ठुकरेन वजे हय जाय। <verse eid="1CO 8:9" /><verse number="10" style="v" sid="1CO 8:10" />काहाकी कदी कुय तुसे अक्‌कल वाळा काजे मुरतीन मंदीर मां खाणो खात्‌ला देखे ने चु भुरसा मां लुलु माणुस हयती, काय हेरे जीव काजे मुरती अगळ बादा चड़ावली चीज खाणेन हिम्‌मत नी हय जाय? <verse eid="1CO 8:10" /><verse number="11" style="v" sid="1CO 8:11" />हीनी रीत सी तारा अकलेन वजे सी चु भुरसा मां लुलु भायस जेरे वाटे मसी मर्‌यु, खत्‌तम हय जासे। <verse eid="1CO 8:11" /><verse number="12" style="v" sid="1CO 8:12" />हीनी रीत सी भायस्‌यान वीरुद पाप करने सी ने हींद्‌रे लुलु मन काजे घाव पुगाड़ने सी, तुहुंं मसीन वीरुद पाप करु। <verse eid="1CO 8:12" /><verse number="13" style="v" sid="1CO 8:13" />हीनी वजे सी कदी खाणो, मारा भायस काजे ठुकर खावाड़े, ती मे कदी बी कसु बी सीकार<note caller="+" style="f"><char style="fr" closed="false">8:13 </char><char style="fq" closed="false">सीकार </char><char style="ft" closed="false">माँस</char></note> नी खाम। असो नी हवे की मे आपणा भायस वाटे ठुकरेन वजे बणो।<verse eid="1CO 8:13" /></para>
  <chapter eid="1CO 8" />
  <chapter number="9" style="c" sid="1CO 9" />
  <para style="s">नेवताळान हकेन काम</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1" />काय मे गुलाम<note caller="+" style="f"><char style="fr" closed="false">9:1 </char><char style="fq" closed="false">गुलाम </char><char style="ft" closed="false">स्वतंत्र नहीं</char></note> मां सी नी छुट्‌यु काय? काय मे नेवताळु नी हय? काय मे ईसु काजे जु आपणु मालीक छे, नी देख्‌या? काय तुहुंं मालीक मां मारा भणावला नी? <verse eid="1CO 9:1" /><verse number="2" style="v" sid="1CO 9:2" />कदी मे दीसरा वाटे नेवताळु नी हय, ती बी तुंद्‌रे वाटे ते छे; काहाकी तुहुंं मालीक मां मारा नेवताळान कामेन छाप छे।<verse eid="1CO 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 9:3" />जे मेसे पारखे, हींद्‌रे वाटे ज्‌य मारु जपाप छे। <verse eid="1CO 9:3" /><verse number="4" style="v" sid="1CO 9:4" />काय हामुक खाणे-पीणेन हक नी हय काय? <verse eid="1CO 9:4" /><verse number="5" style="v" sid="1CO 9:5" />काय हामुक ज्‌य हक नी हय, की काहालीक मसी बहणीस साते ईयाव करीन हीनीक लीन फीरे, जसों दीसरा नेवताळान काम ने मालीकेन भायस ने केफा करे? <verse eid="1CO 9:5" /><verse number="6" style="v" sid="1CO 9:6" />नीते सीरप मेसे ने बरनाबास काजे हक नी हय की कमाय करनु छुड़े? <verse eid="1CO 9:6" /><verse number="7" style="v" sid="1CO 9:7" />कुण कदी आपणी कमाय मां सी खाय्‌न सीपायड़ान काम करे? कुण अंगुरेन वाड़ी लागाड़ीन हेरो फळ नी खातु हय? कुण गाडरान<note caller="+" style="f"><char style="fr" closed="false">9:7 </char><char style="fq" closed="false">गाडरान </char><char style="ft" closed="false">भेड़ों</char></note> राखवाळी करीन हींद्‌रो दुत नी पीये? <verse eid="1CO 9:7" /><verse number="8" style="v" sid="1CO 9:8" />काय मे जी वात माणसेन रीत पर बुलो? <verse eid="1CO 9:8" /><verse number="9" style="v" sid="1CO 9:9" />काय मुसान लिखला सास्‌तुर मां बी ज्‌य नी कह्‌वे? काहाकी मुसान साहरे लिखला कायदा मां छे, “दावण गेरनेन टेम मां चालतेला बेलेन मुंहडो घुण बांदे।” काय भगवान बेलेन ने फीकुर करे? <verse eid="1CO 9:9" /><verse number="10" style="v" sid="1CO 9:10" />नीते हेरेसी हामरे वाटे कह्‌वे। हव, हामरे वाटे लिखी गुयलो छे, काहाकी सय छे की जुपणे वाळु आस सी जुपे ने दावण गेरनेवाळा साजल्‌या हवणेन आस सी दावणी गेरेन वाळु हवणु चाहजे। <verse eid="1CO 9:10" /><verse number="11" style="v" sid="1CO 9:11" />अळतेन जत्‌यार की हामु तुंद्‌रे वाटे आत्‌मा मां भरायला चीजे एर्‌या, ती काय जी मटी वात छे की तुंद्‌री डीलेन चीजेन फसल काटे। <verse eid="1CO 9:11" /><verse number="12" style="v" sid="1CO 9:12" />जत्‌यार दीसरान तुंद्‌रे पर ज्‌य हक छे, ती काय हेरेसी अदुस नी हवे? बाकुन हामु ज्‌य हकेन काम मां नी लाया बाकुन आखो काय सेण करजे की हामरे साहरे मसीन खुस-खबर मां थुड़ीक रुकावट नी हवे। <verse eid="1CO 9:12" /><verse number="13" style="v" sid="1CO 9:13" />काय तुहुंं नी जाणु की जे मंदीर मां चाकरी करे, चे मंदीर मां सी खाय; ने जे वेदीन चाकरी करे, चे वेदी साते साजल्‌या हवे?<note caller="+" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="LEV 6:16">लेवयवेवस्‌था 6:16</ref>,<ref loc="LEV 6:26">26</ref></char></note> <verse eid="1CO 9:13" /><verse number="14" style="v" sid="1CO 9:14" />हीनीत रीत सी मालीक बी ठेरायु की जे माणसे खुस-खबर सामळावे, हींद्‌रो जीवणेन सादन खुस-खबर सी हवे।<verse eid="1CO 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 9:15" />बाकुन मे हींद्‌रेम सी कायबी वात काम मां नी लायु, ने मे जी वात हेरेसी नी लिख्‌यु की मारे वाटे असो करे, काहाकी हेरसी ते मारो मरनुत वारु छे की कुय मारी मटाय काजे फालतु नी ठेरावे। <verse eid="1CO 9:15" /><verse number="16" style="v" sid="1CO 9:16" />कदी मे खुस-खबर सामळावो, ती मारे वाटे काय बी मटायन वात नी; काहाकी जो ते मारे वाटे जरुड़ी छे। कदी मे खुस-खबर नी सामळो, ती मारे पर हाय। <verse eid="1CO 9:16" /><verse number="17" style="v" sid="1CO 9:17" />काहाकी कदी आपणी मरजी सी ज्‌य करो ती दाहड़की मेसे जड़ती, ने कदी आपणी मरजी सी नी करो ती बी हीसाब-किताप करन्‌यु मेसे सुपी देदला छे। <verse eid="1CO 9:17" /><verse number="18" style="v" sid="1CO 9:18" />ती मारी काहली दाहड़की छे? ज्‌य की खुस-खबर सामळाणे मां मे मसीन खुस-खबर<note caller="+" style="f"><char style="fr" closed="false">9:18 </char><char style="fq" closed="false">खुस-खबर </char><char style="ft" closed="false">सुसमाचार</char></note> मुफत मां कर दम, जां लग की खुस-खबर मां जु मारु हक छे हीनाक बी मे पुरी रीत सी काम मां नी लावो।<verse eid="1CO 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 9:19" />काहाकी आखा सी आजाद हवणे पर बी मे आपणे आप काजे आखान गुलाम बणाय देदु की जादास माणसे काजे खेचीन लावो। <verse eid="1CO 9:19" /><verse number="20" style="v" sid="1CO 9:20" />मे यहुदीया वाटे यहुदी बण्‌यु की यहुदीया काजे खेचीन लावो जे माणसे मुसान लिखला कायदान हक मां नी रवणे सी बी मुसान लिखला कायदान हक मां बण्‌यु की हीनुक जे मुसान कायदान हक मां छे, खेचीन लावो। <verse eid="1CO 9:20" /><verse number="21" style="v" sid="1CO 9:21" />मुसान कायदाक नी जाणे हींद्‌रे वाटे मे जे भगवानेन कायदा सी दुर नी बाकुन मसीन कायदान हक मां छे मुसान साहरे लिखला कायदा नी माने हींद्‌रेन तसु बण्‌यु की मुसान कायदाक नी माने तीनु काजे खेची लावो। <verse eid="1CO 9:21" /><verse number="22" style="v" sid="1CO 9:22" />मे लुला वाटे लुलान तसु बण्‌यु की लुला काजे खेची लावो। मे आखा माणसे वाटे आखो काय बण्‌यु काहाला ने काहाली रीत सी काय एकेन छुटकारु कराड़ो।<verse eid="1CO 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 9:23" />मे ज्‌य आखो काय खुस-खबर वाटे करो की दीसरा साते हेरु साजल्‌यु बणी जाम।<verse eid="1CO 9:23" /></para>
  <para style="s">मसी मां दवड़नु</para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 9:24" />काय तुहुंं नी जाणु की दवड़णे मां ते आखा दवड़े, बाकुन ईनाम एकुत लीन जाय? तुहुंं असात दवड़ु ने की जीतु। <verse eid="1CO 9:24" /><verse number="25" style="v" sid="1CO 9:25" />एक ताकतवाळु आखो काय खुद करे; चे ते एक खत्‌तम हवणे वाळा मुकुट काजे हात करने वाटे ज्‌य आखो करे बाकुन हामु ते हीना मुकुट करीन करजे जु जलम रवे। <verse eid="1CO 9:25" /><verse number="26" style="v" sid="1CO 9:26" />हेरेसी मे हीनी रीत सी दवड़ो, बाकुन रवलो काम करने वाळु नी, मे बी हीनीत रीत सी धुमा सी लड़ायो, बाकुन हेरेन तसु नी जे वाहळा मां ठुक्‌ता जाय्‌न लड़ायो <verse eid="1CO 9:26" /><verse number="27" style="v" sid="1CO 9:27" />बाकुन मे आपणा डील काजे धुमाटीन मारा हक मां लावो, असो नी हवे की दीसरा काजे परचार करीन मे खुद काहालीक रीत सी पापी ठेहरो।<verse eid="1CO 9:27" /></para>
  <chapter eid="1CO 9" />
  <chapter number="10" style="c" sid="1CO 10" />
  <para style="s">ईस्‌रायेलेन हवला काम सी चेतावणी</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1" />ए भायसे, मे नी चाहतु की तुहुंं हीनी वात सी अनजाण्‌या<note caller="+" style="f"><char style="fr" closed="false">10:1 </char><char style="fq" closed="false">अनजाण्‌या </char><char style="ft" closed="false">अज्ञात</char></note> रवु की हामरा आखा डाहा बुड़ा वादळान नेचा हतला, ने आखा की आखा दरीयान ईचमां सी पार हयन गुया;<note caller="+" style="x"><char style="xo" closed="false">10:1 </char><char style="xt" closed="false"><ref loc="EXO 14:29">नीरगमन 14:29</ref></char></note> <verse eid="1CO 10:1" /><verse number="2" style="v" sid="1CO 10:2" />ने आखा वादळा मां ने दरीया मां, मुसान बपतीस्‌मा लेदा। <verse eid="1CO 10:2" /><verse number="3" style="v" sid="1CO 10:3" />ने आखा एकुत आत्‌मा मां भरायला खाणो खादा;<note caller="+" style="x"><char style="xo" closed="false">10:3 </char><char style="xt" closed="false"><ref loc="EXO 16:35">नीरगमन 16:35</ref></char></note> <verse eid="1CO 10:3" /><verse number="4" style="v" sid="1CO 10:4" />ने आखा एकुत आत्‌मा मां भरायला पाणी पीदा, काहाकी चे तीना आत्‌मा मां भरायला झीरा सी पाणी पीदला जे तेरे साते चालतेली, ने चु झीरु मसी हतलु।<note caller="+" style="x"><char style="xo" closed="false">10:4 </char><char style="xt" closed="false"><ref loc="EXO 17:6">नीरगमन 17:6</ref></char></note><note caller="+" style="x"><char style="xo" closed="false">10:4 </char><char style="xt" closed="false"><ref loc="NUM 20:11">गिन्‌ती 20:11</ref></char></note> <verse eid="1CO 10:4" /><verse number="5" style="v" sid="1CO 10:5" />बाकुन भगवान हींद्‌रे मां सी बेसका माणसे सी खुस नी हयु, हेरेसी बयड़ा मां ढीक हय गुया।<note caller="+" style="x"><char style="xo" closed="false">10:5 </char><char style="xt" closed="false"><ref loc="HEB 3:17">ईब्‌रानीयो 3:17</ref> </char></note><verse eid="1CO 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 10:6" />जी वात हामरे वाटे एक दाखलु<note caller="+" style="f"><char style="fr" closed="false">10:6 </char><char style="fq" closed="false">दाखलु </char><char style="ft" closed="false">दृष्टान्त</char></note> ठेर्‌यु, की जसा चे लालुच कर्‌या, असात आपणु बी भुंडली चीजेन लालुच मां करु; <verse eid="1CO 10:6" /><verse number="7" style="v" sid="1CO 10:7" />ने नी तुहुंं मुरती पुजण्‌या बणु, जसा की हींद्‌रे मां सी कतरा ते बणी गुया, जसों लिखलो छे, “माणसे खाणे पीणे बठ्‌या, ने खेलने कुदणे उठ्‌या।” <verse eid="1CO 10:7" /><verse number="8" style="v" sid="1CO 10:8" />ने नी आपणु छीनाळो करजे, जसा हींद्‌रे मां सी कतरा कर्‌या; ने एकुत दाहड़ाम बीस ने तीन हजार माणसे मर गुया।<note caller="+" style="x"><char style="xo" closed="false">10:8 </char><char style="xt" closed="false"><ref loc="EXO 25:1">नीरगमन 25:1</ref></char></note><note caller="+" style="x"><char style="xo" closed="false">10:8 </char><char style="xt" closed="false"><ref loc="NUM 25:9">गिन्‌ती 25:9</ref></char></note> <verse eid="1CO 10:8" /><verse number="9" style="v" sid="1CO 10:9" />ने नी आपणु मालीक काजे पारखे, जसा हींद्‌रे मां सी कतरा, माणसे कर्‌या ने घड़सान साहरे खत्‌तम हय गुया।<note caller="+" style="x"><char style="xo" closed="false">10:9 </char><char style="xt" closed="false"><ref loc="EXO 21:5">नीरगमन 21:5</ref>,<ref loc="EXO 21:6">6</ref></char></note> <verse eid="1CO 10:9" /><verse number="10" style="v" sid="1CO 10:10" />ने नी तुहुंं कुड़-कुड़ कर्‌या, जीनी रीत सी हींद्‌रे मां सी कतरा कुड़-कुड़ ने खत्‌तम करने वाळान साहरे खत्‌तम हय गुया।<note caller="+" style="x"><char style="xo" closed="false">10:10 </char><char style="xt" closed="false"><ref loc="2PE 2:9">2 पतरस 2:9</ref></char></note><verse eid="1CO 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 10:11" />बाकुन जी आखी वात, जी हींद्‌रे पर पड़ी दाखलान रीत पर हतली; ने चे हामरी चेतावणी वाटे जे कळीन आकरी टेम रवे लिखाय गुयली छे।<verse eid="1CO 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 10:12" />हेरेसी जु समजे, मे टणकु छे, चु चेतीन रवे की काय हीटी नी पड़े। <verse eid="1CO 10:12" /><verse number="13" style="v" sid="1CO 10:13" />तुहुंं काहाली असी पारख मां नी पड़्‌या, जे माणसेन सेण सी बाहार छे। ने भगवान भुरसा वाळु छे ने चु तुहुंं काजे ताकत सी बाहार पारख मां नी पड़नी देय, बाकुन पारखणेन साते नीकास बी करसे की तुहुंं सेण कर सकु।<verse eid="1CO 10:13" /></para>
  <para style="s">मुरती पुजण्‌यान वीरुद मां चेतावणी</para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 10:14" />एरे वजे सी, ए मारा लाटेक्‌ला, मुरतीन पुजा-पाट करने सी बची रवु। <verse eid="1CO 10:14" /><verse number="15" style="v" sid="1CO 10:15" />मे अकलवाळा<note caller="+" style="f"><char style="fr" closed="false">10:15 </char><char style="fq" closed="false">अकलवाळा </char><char style="ft" closed="false">बुद्धिमान</char></note> जाणीन तुंद्‌रे सी कह्‌वो; जो मे कह्‌वो, हीनाक तुहुंं पारखु। <verse eid="1CO 10:15" /><verse number="16" style="v" sid="1CO 10:16" />चु तु बेसकु वारुन कटवरु, जेरे पर हामु तु बेसकु वारु छे करीन कवजे; काय मसीन खुनेन साजेदारी नी हय? चु रुटु हामु तीनाक हामु तुड़जे, काय चु मसीन डीलेन साजेदारी<note caller="+" style="f"><char style="fr" closed="false">10:16 </char><char style="fq" closed="false">साजेदारी </char><char style="ft" closed="false">सहभागिता</char></note> नी हय? <verse eid="1CO 10:16" /><verse number="17" style="v" sid="1CO 10:17" />हेरेसी की एकुत रुटु छे, ती हामु बी जे बेसका छे एकुत डील छे, काहाकी हामु आखा ईनात मां साजल्‌या हवजे।<verse eid="1CO 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 10:18" />जे डील भाव सी ईस्‌रायेली छे, हीनुक देखु; काय बादा चड़ावला खाणे वाळा वेदीन साजल्‌या नी हय। <verse eid="1CO 10:18" /><verse number="19" style="v" sid="1CO 10:19" />अळतेन मे काय कह्‌वो? काय ज्‌य की मुरती पर चड़ाय गुयला बादा काय छे, नीते मुरती काय छे? <verse eid="1CO 10:19" /><verse number="20" style="v" sid="1CO 10:20" />नी, बाकुन ज्‌य की नी-यहुदी जे बादा देय; चे भगवान वाटे नी बाकुन भुतड़ान आत्‌मा वाटे बादा देय ने मे नी चाहतु की तु भुतड़ान आत्‌मान साजल्‌या हवे। <verse eid="1CO 10:20" /><verse number="21" style="v" sid="1CO 10:21" />तुहुंं मालीकेन कटेरु ने भुतड़ान आत्‌मान कटेरा दुयु मां सी नी पी सकु। तुहुंं मालीकेन भेसकायन ने भुतड़ान आत्‌मान भेसकायन दुयुन साजल्‌या नी हय सकु। <verse eid="1CO 10:21" /><verse number="22" style="v" sid="1CO 10:22" />काय हामुक मालीक काजे रीस देवाड़ु? काय हामु हेरसी जुर वाळा छे?<verse eid="1CO 10:22" /></para>
  <para style="s">आखो काय भगवानेन सेक-सींगार वाटे छे</para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23" />“आखी चीजे मारे वाटे सय ते छे, बाकुन आखी फायदान नी हय,” आखी चीजे मारे वाटे सय ते छे, बाकुन आखी चीजे सी अगो बड़ाये नी। <verse eid="1CO 10:23" /><verse number="24" style="v" sid="1CO 10:24" />कुय बी आपणीत भलाय काजे नी, बाकुन दीसरान भलाय काजे हेर बी करु।<verse eid="1CO 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 10:25" />ज्‌य काय हाटेम वेचाये, चो खावु ने मनेन वजे सी काय बी मां पुछु ने पारखु? <verse eid="1CO 10:25" /><verse number="26" style="v" sid="1CO 10:26" />“काहाकी कळी ने हेरी भरपाय मालीकेन छे।”<note caller="+" style="x"><char style="xo" closed="false">10:26 </char><char style="xt" closed="false"><ref loc="PSA 24:1">भजन सहीता 24:1</ref></char></note><verse eid="1CO 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 10:27" />कदी जे ईसु काजे नी जाणे असला मां सी कुय तुहुंं काजे नेवता देय, ने तुहुंं जाणे ने पारखणे चाहु, ती ज्‌य काय तुंद्‌रे अगळ मेक देय चोन खावु; ने मन वजेसी कुय मां पुछु। <verse eid="1CO 10:27" /><verse number="28" style="v" sid="1CO 10:28" />बाकुन कदी कुय तुंद्‌रे सी कह्‌वे, “ज्‌य ते मुरती काजे बादा करली चीज छे,” ती तीना बताड़ने वाळान वजे सी ने मनेन वजेसी घुण खावु। <verse eid="1CO 10:28" /><verse number="29" style="v" sid="1CO 10:29" />मारो मतलब तारु मन नी, बाकुन तीना दीसरान।</para>
  <para style="p" vid="1CO 10:29">भलो, मारु छुटकारु दीसरान वीच्‌यार सी काहा पारखी जाय? <verse eid="1CO 10:29" /><verse number="30" style="v" sid="1CO 10:30" />कदी मे तु बेसकु वारु छे करीन साजल्‌यु हवो ती जेरे पर मे तु बेसकु वारु छे करीन कह्‌वो, ती हेरे वजे सी मारी वाक नीकाळे? <verse eid="1CO 10:30" /><verse number="31" style="v" sid="1CO 10:31" />हेरेसी तुहुंं चाहे खावु, चाहे पीयु, चाहे जो काय करु, आखो काय भगवानेन सेक-सींगार वाटे करु। <verse eid="1CO 10:31" /><verse number="32" style="v" sid="1CO 10:32" />तुहुंं नीते यहुदीया, नीते नी-यहुदी, ने नी भगवानेन मंडळी वाटे ठुकरेन वजे बणु। <verse eid="1CO 10:32" /><verse number="33" style="v" sid="1CO 10:33" />जसु मे बी आखी वातो मां आखा काजे खुस राखो, ने आपणा नी बाकुन बेसकान फायदु हेरो की तीनुक छुटकारु जड़से।<verse eid="1CO 10:33" /></para>
  <chapter eid="1CO 10" />
  <chapter number="11" style="c" sid="1CO 11" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 11:1" />तुहुंं मारेन तसा चाल-चालो जसु मे मसीन तसु चाल-चालो।<verse eid="1CO 11:1" /></para>
  <para style="s">दुवा मां मुणको ढाकणु</para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 11:2" />ए भायसे, मे तुहुंंक भुरसु देवाड़ो की आखी वातो मां तुहुंं मेसे हेर करो; ने जे जुन्‌डली रीती मां तुहुंंक सुपलु छे, हीनुक राखवाळी करु। <verse eid="1CO 11:2" /><verse number="3" style="v" sid="1CO 11:3" />बाकुन मे चाहो की तुहुंं ज्‌य जाण लेवु की एक अदमीन मुणको मसी छे, ने बायरीन मुणको अदमी छे, ने मसीन मुणको भगवान छे। <verse eid="1CO 11:3" /><verse number="4" style="v" sid="1CO 11:4" />जु अदमी मुणको ढाकलु दुवा नीते भगवानेन अघी सी आवणे वाळी वात देखाड़े, चु आपणा मुणकान वाक नीकाळे। <verse eid="1CO 11:4" /><verse number="5" style="v" sid="1CO 11:5" />बाकुन जी बायरी उगाल्‌ला मुणकान दुवा नीते भगवानेन अघी सी आवणे वाळी वात देखाड़े ची आपणा मुणकान वाक नीकाळे, काहाकी ची भुमळी हवणे बराबर छे। <verse eid="1CO 11:5" /><verse number="6" style="v" sid="1CO 11:6" />कदी बायरी उंडणी नी पांगरे ती कान्‌या बी काटाड़ लेय; कदी बायरी वाटे कान्‌या काटान्‌यु नीते भुमळी करान्‌नु सरमेन वात छे, ती उंडणी पांगरे। <verse eid="1CO 11:6" /><verse number="7" style="v" sid="1CO 11:7" />हव, अदमी काजे आपणा मुणका काजे ढाकणु वारु नी हय, काहाकी चु भगवानेन सीकु ने सेक-सींगार छे; बाकुन बायरी अदमीन सेक-सींगार छे। <verse eid="1CO 11:7" /><verse number="8" style="v" sid="1CO 11:8" />काहाकी अदमी बायरी सी नी हयु, बाकुन बायरी अदमी सी हयी।<note caller="+" style="x"><char style="xo" closed="false">11:8 </char><char style="xt" closed="false"><ref loc="GEN 2:21-23">उबजाणनी किताप 2:21-23</ref></char></note> <verse eid="1CO 11:8" /><verse number="9" style="v" sid="1CO 11:9" />ने अदमी बायरी वाटे नी बणाय गुयु, बाकुन बायरी अदमी वाटे बणाय गुयलु छे।<note caller="+" style="x"><char style="xo" closed="false">11:9 </char><char style="xt" closed="false"><ref loc="GEN 2:18">उबजाणनी किताप 2:18</ref></char></note> <verse eid="1CO 11:9" /><verse number="10" style="v" sid="1CO 11:10" />हेरेसी सरग वाळा काहवाळ्‌यान वजे सी बायरी काजे सय छे की हकदार मां आपणा मुणका काजे ढाकणु वारु छे। <verse eid="1CO 11:10" /><verse number="11" style="v" sid="1CO 11:11" />ती बी मालीक मां नी ते बायरी पाखुर अदमी, ने नी अदमी पाखुर बायरी छे। <verse eid="1CO 11:11" /><verse number="12" style="v" sid="1CO 11:12" />काहाकी जसी बायरी अदमी सी छे, असुत अदमी बायरीन साहरे छे; बाकुन आखी चीजे भगवान सी छे।<verse eid="1CO 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 11:13" />तुहुंं आपसात वीच्‌यार करु, काय बायरी काजे उघाल्‌ले मुणको लीन भगवान सी दुवा करु सुभा देय? <verse eid="1CO 11:13" /><verse number="14" style="v" sid="1CO 11:14" />काय सभावेन रीत सी बी तुहुंं नी जाणु की कदी अदमी लांबला कान्‌या राखे, ती हेरे वाटे लाजेन वात छे। <verse eid="1CO 11:14" /><verse number="15" style="v" sid="1CO 11:15" />बाकुन कदी बायरी लांबला कान्‌या राखे ती हेरे वाटे सुभा देय, काहाकी कान्‌या हीनी काजे उडणी वाटे देदला छे। <verse eid="1CO 11:15" /><verse number="16" style="v" sid="1CO 11:16" />बाकुन कदी कुय बी वातेम जखड़ी पड़ने हींडे, ती ज्‌य जाणी लेय की नी हामरी ने नी भगवानेन मंडळी असी रीती छे।<verse eid="1CO 11:16" /></para>
  <para style="s">मालीकेन खाणान बारामां सीकापण</para>
  <para style="r">(<ref loc="MAT 26:26-29">मत्‌ती 26:26-29</ref>; <ref loc="MRK 14:22-25">मरकुस 14:22-25</ref>; <ref loc="LUK 22:14-20">लुका 22:14-20</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 11:17" />बाकुन ज्‌य हुकुम आपतु जाय्‌न, मे तुहुंंक नी भुरसु देवाड़तु, हेरेसी की तुंद्‌रे भेळा हवणे सी भलाय नी, बाकुन नुकसाण हवे। <verse eid="1CO 11:17" /><verse number="18" style="v" sid="1CO 11:18" />काहाकी पेहल ती मे ज्‌य सामळो, की जत्‌यार तुहुंं मंडळी मां भेळा हवु ती तुंद्‌रे मां झगड़ा हवे, ने मे हेरे पर काय-काय भुरसु बी करो। <verse eid="1CO 11:18" /><verse number="19" style="v" sid="1CO 11:19" />काहाकी कुहरायला बी तुंद्‌रे मां जरुड़ हवसे, हेरेसी की जे माणसे तुंद्‌रे मां खरला छे चे देखता हय जाय। <verse eid="1CO 11:19" /><verse number="20" style="v" sid="1CO 11:20" />अळतेन तुहुंं जे एक जागा मां भेळा हवु, ती ज्‌य मालीकेन खाणो खाणे वाटे नी हय। <verse eid="1CO 11:20" /><verse number="21" style="v" sid="1CO 11:21" />काहाकी खाणेन टेम मां एक दीसरा सी पेहल आपणो खाणो खाय लेय, हीनी तरा कुय ते भुकलु रवे ने कुय छाकी जाय। <verse eid="1CO 11:21" /><verse number="22" style="v" sid="1CO 11:22" />काय खाणे पीणे वाटे तुंद्‌रो घर नी हय? नीते भगवानेन मंडळी काजे कायनी जाणु, ने तींद्‌रे धड़े नी हय हीनुक सरमाणनु? मे तुंद्‌रे सी काय कह्‌वो? काय हीनी वात मां तुंद्‌री बड़ाय करो? नी मे बड़ाय<note caller="+" style="f"><char style="fr" closed="false">11:22 </char><char style="fq" closed="false">बड़ाय </char><char style="ft" closed="false">प्रशंसा</char></note> नी करो।<verse eid="1CO 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 11:23" />काहाकी जी वात मेसेक मालीक सी जड़ी, ने मे तुहुंंक बी बताड़ देदु। की मालीक ईसु तीनीन राते धरायणे वाळु हतलु, तीनीत राते रुटु धर्‌यु। <verse eid="1CO 11:23" /><verse number="24" style="v" sid="1CO 11:24" />ने तु बेसकु वारु छे करीन रुटाक तुड़्‌या ने कह्‌यु, “जु मारु डील छे, जु तुंद्‌रे वाटे छे। मारे हेर<note caller="+" style="f"><char style="fr" closed="false">11:24 </char><char style="fq" closed="false">हेर </char><char style="ft" closed="false">स्मरण</char></note> करने वाटे चत कर्‌या करु।” <verse eid="1CO 11:24" /><verse number="25" style="v" sid="1CO 11:25" />ने अळतेन ईसु हाते मां पीयालु धर्‌यु ने असु कह्‌यु, “जो पीयालो मारा लुहीन नवलु पीयालु छे। ने जत्‌यार बी तुहुंं पीयालु पीयु, ती मेसेक हेर करने करीन मारेन तसात कर्‌या करजु।”<note caller="+" style="x"><char style="xo" closed="false">11:25 </char><char style="xt" closed="false"><ref loc="LUK 22:20">लुका 22:20</ref></char></note><figure style="fig" alt="Jesus eating the Passover meal with his disciples" file="lb00320c.tif" size="span" copy="Horace Knowles ©" ref="11:23">ईसु चेला साते आकरी खाणो खाय</figure><verse eid="1CO 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 11:26" />काहाकी जत्‌यार कदी तुहुंं ज्‌य रुटु खावु ने हीना कटेरा मां सी पीयु, ती मालीकेन मुत काजे जत्‌यार लग चु नी आवे, तत्‌यार लग परचार करता रवु। <verse eid="1CO 11:26" /><verse number="27" style="v" sid="1CO 11:27" />हेरेसी जे कुय गलत रीत सी मालीकेन रुटु खाय नीते हेरा कटवरा मां सी पीये, चु मालीकेन डीलेन ने लुहीन गुना वाळु रवसे। <verse eid="1CO 11:27" /><verse number="28" style="v" sid="1CO 11:28" />हेरेसी माणुस आपणे आप काजे पारखी लेय, ने हीनी रीत सी हीना रुटा मां सी खाय ने हीना कटेरा मां सी पीये। <verse eid="1CO 11:28" /><verse number="29" style="v" sid="1CO 11:29" />काहाकी जे खाय ने पीये घड़ी मालीकेन डील काजे नी उळखे, चु हीना खाण सी ने पीणे सी आपणे उपर डंड लावे। <verse eid="1CO 11:29" /><verse number="30" style="v" sid="1CO 11:30" />हेरे वजे सी तुंद्‌रे मां बेसका माणसे लुला ने मांदा छे, ने थुड़ाक मरी बी गुया। <verse eid="1CO 11:30" /><verse number="31" style="v" sid="1CO 11:31" />कदी हामु आपणे आप काजे पारखजे ती डंड नी जड़तो। <verse eid="1CO 11:31" /><verse number="32" style="v" sid="1CO 11:32" />बाकुन मालीक हामुक डंड आपीन हामुक झीचकारतु रवसे, हेरेसी की हामु कळी साते गुनाळा नी ठेरजे।<verse eid="1CO 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 11:33" />हेरेसी, ए मारा भायसे, ने बहणस्‌या जत्‌यार तुहुंं खाणे वाटे भेळा हवु ती एक दीसरा वाटे ठेर्‌या करु। <verse eid="1CO 11:33" /><verse number="34" style="v" sid="1CO 11:34" />कदी कुय भुकलु हसे ती आपणा घर मां खाय लेय, जेरे सी तुंद्‌रो भेळो हवणे डंडेन वजे नी हवे। रवली वात काजे मे आवीन सय करीस।<verse eid="1CO 11:34" /></para>
  <chapter eid="1CO 11" />
  <chapter number="12" style="c" sid="1CO 12" />
  <para style="s">आत्‌मा भरायला भगवानेन वाटु</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1" />ए भायसे, बहणस्‌या मे नी चाहतु की तुहुंं आत्‌मा मां भरायला।</para>
  <para style="p" vid="1CO 12:1">भगवानेन वाटान बारामां अनजाण्‌या रवु। <verse eid="1CO 12:1" /><verse number="2" style="v" sid="1CO 12:2" />तुहुंं जाणु की जत्‌यार तुहुंं नी-यहुदी हतला, ती बुबड़ी मुरतीन पछळ जसा कवला असा चालतेला। गलातीयो 4:8 <verse eid="1CO 12:2" /><verse number="3" style="v" sid="1CO 12:3" />हेरेसी मे तुहुंंक चेतावणी आपो की जे कुय भगवानेन आत्‌मान अगवाय सी बुले, चु नी कह्‌वे की ईसु गरा वाळु छे; ने नी कुय चुखली-आत्‌मान पाखुर कुय कय सके की ईसु मालीक छे।<verse eid="1CO 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 12:4" />भगवानेन वाटा ते काय तरेन छे, बाकुन आत्‌मा एकुत छे; <verse eid="1CO 12:4" /><verse number="5" style="v" sid="1CO 12:5" />ने चाकरी बी काय तरेन छे, बाकुन मालीक एकुत छे; <verse eid="1CO 12:5" /><verse number="6" style="v" sid="1CO 12:6" />ताकतवाळा काम<note caller="+" style="f"><char style="fr" closed="false">12:6 </char><char style="fq" closed="false">ताकतवाळा काम </char><char style="ft" closed="false">प्रभावशाली कार्य</char></note> ते काय तरेन छे, बाकुन भगवान एकुत छे, जु आखा मां एक एकेन हिम्‌मत पयदा करे। <verse eid="1CO 12:6" /><verse number="7" style="v" sid="1CO 12:7" />बाकुन आखान फायदु पुगाड़ने वाटे एक आत्‌मान वीजाळो आप देय। <verse eid="1CO 12:7" /><verse number="8" style="v" sid="1CO 12:8" />काहाकी एक काजे आत्‌मान साहरे डीमाकेन वात आप देय, ने दीसरा काजे हीनीत आत्‌मान अनसारे अकलेन वात आप देय। <verse eid="1CO 12:8" /><verse number="9" style="v" sid="1CO 12:9" />काहालाक काजे हीनीत आत्‌मा सी भुरसु छे, ने काहालाक काजे हीनीत एक आत्‌मा सी वारु करनेन भगवानेन वाटु आप देय। <verse eid="1CO 12:9" /><verse number="10" style="v" sid="1CO 12:10" />पछेन काहानाक काजे ताकत काम करनेन जुरेन, ने काहानाक काजे भगवानेन अघी सी आवणे वाळी वात बताड़े, ने काहानाक काजे आत्‌मान पारख करने, ने काहानाक काजे काय तरेन बुली, ने काहालाक काजे बुलीन मतलब<note caller="+" style="f"><char style="fr" closed="false">12:10 </char><char style="fq" closed="false">मतलब </char><char style="ft" closed="false">अर्थ</char></note> बताड़ने ताकत आप्‌यु। <verse eid="1CO 12:10" /><verse number="11" style="v" sid="1CO 12:11" />बाकुन जे आखा ताकत वाळा काम चीत एक आत्‌मा कराड़े, ने तीनाक जो चाहजे चो वाटी देय।<verse eid="1CO 12:11" /></para>
  <para style="s">डील एक भाक तरान</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 12:12" />काहाकी जीने तरा डील ते एक छे ने हेरा भाक बेसका छे, ने हीना एक डीलेन आखा भाक बेसका रवणे पर आखा मेळीन एकुत डील छे, हीनीत तरा मसी बी एकुत छे। <verse eid="1CO 12:12" /><verse number="13" style="v" sid="1CO 12:13" />काहाकी हामु आखा काय यहुदी हवे काय नी-यहुदी, काय पावर्‌यु हवे काय आजाद, एकुत आत्‌मान साहरे एक डील हवणे वाटे बपतीस्‌मा लेदा, ने हामु आखा काजे एकुत आत्‌मा पीवाड़ देदली छे।<verse eid="1CO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 12:14" />हेरसी की डील मां एकुत भाक नी बाकुन बेसका भाक छे। <verse eid="1CO 12:14" /><verse number="15" style="v" sid="1CO 12:15" />कदी पाय कह्‌वे, “मे हात नी हय, हेरेसी डीलेन नी हय,” ती काय चु हेरे वजे सी डीलेन नी। <verse eid="1CO 12:15" /><verse number="16" style="v" sid="1CO 12:16" />ने कदी कान्‌टा कह्‌वे, “मे डुळु नी हय, हेरेसी डील नी हय,” ती काय चु हेनी वजे सी डीलेन नी हय? <verse eid="1CO 12:16" /><verse number="17" style="v" sid="1CO 12:17" />कदी आखो डील डुळात रवता ती सामळनु काहा रवतो? कदी आखो डील कान्‌टात रवता, ती सुंगणु काहा रवतो? <verse eid="1CO 12:17" /><verse number="18" style="v" sid="1CO 12:18" />बाकुन छाचलीन भगवान भाक काजे आपणी मरजीन अनसारे एक करीन डील मां मेक्‌यु। <verse eid="1CO 12:18" /><verse number="19" style="v" sid="1CO 12:19" />कदी चे आखा एकुत भाक रवता, ती डील काहा हवतो? <verse eid="1CO 12:19" /><verse number="20" style="v" sid="1CO 12:20" />बाकुन हय भाक ते बेसका छे, बाकुन डील एकुत छे।<verse eid="1CO 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 12:21" />डुळा हात सी नी कय सके, “मेसे तारी जरुवत नी हय” ने नी मुणको पाय सी कय सके, “मेसे तुंद्‌री जरुवत नी हय।” <verse eid="1CO 12:21" /><verse number="22" style="v" sid="1CO 12:22" />बाकुन डीलेन चे भाक जेत दीसरा सी लुला लागे, बेसको जरुवत छे; <verse eid="1CO 12:22" /><verse number="23" style="v" sid="1CO 12:23" />ने डील जीनु भाके काजे हामु आव-भाव लायेक नी समजे हीनु काजे हामु जादास आव-भाव देजे; ने हामरे‍ सुभे नी देय असला भाक अळी बी बेसका सुभु देय असा हय जाय, <verse eid="1CO 12:23" /><verse number="24" style="v" sid="1CO 12:24" />अळतेन बी आपणो सुभे असा भाके काजे हेरी जरुवत नी बाकुन भगवान डील काजे असु बणाय देदु की तीना भाक काजे आव-भाव मां कमी हतली हीना काजे अळी बी बेसका आव-भाव जड़्‌यो। <verse eid="1CO 12:24" /><verse number="25" style="v" sid="1CO 12:25" />काहाकी डील मां बेरजु नी पड़नु, चाहजे बाकुन भाक एक दीसरान बराबर फीकुर<note caller="+" style="f"><char style="fr" closed="false">12:25 </char><char style="fq" closed="false">फीकुर </char><char style="ft" closed="false">चिन्ता</char></note> करे। <verse eid="1CO 12:25" /><verse number="26" style="v" sid="1CO 12:26" />हेरेसी कदी एक भाक काजे दुख जड़े, ती आखा भाक हेरेसी ते जड़े; ने कदी एक भाकन बड़ाय हवे, ती हेरे साते आखा भाक खुसी मनावे।<verse eid="1CO 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 12:27" />असात तुहुंं आखा मेळीन मसीन डील छे, ने आंग्‌ये-आंग्‌ये हेरा भाक छे; <verse eid="1CO 12:27" /><verse number="28" style="v" sid="1CO 12:28" />ने भगवान मंडळी मां आंग्‌ये-आंग्‌ये माणसे ठेरावला छे; पेहलु नेवताळु, दीसरु भगवानेन अघी सी आवणे वाळी वात देखाड़न्‌यु, तीसरु मास्‌तर, अळतेन ताकुतेन काम करने वाळु, अळतेन वारु करने वाळा, ने भलाय करने वाळा, ने देख-भाळ करने वाळा, ने काय तरेन बुली बुलने वाळा। <verse eid="1CO 12:28" /><verse number="29" style="v" sid="1CO 12:29" />काय आखा नेवताळान काम छे? काय आखा भगवानेन अघी सी आवणे वाळी वात देखान्‌या छे? काय आखा परचार करन्‌या छे? काय आखा ताकुतेन काम करने वाळा छे? <verse eid="1CO 12:29" /><verse number="30" style="v" sid="1CO 12:30" />काय आखा काजे वारु करनेन भगवानेन वाटु जड़लु छे? काय आखा काय तरान बुली बुले? <verse eid="1CO 12:30" /><verse number="31" style="v" sid="1CO 12:31" />काय आखा बुल बदलेन काम करे काय? तुहुंं मटा सी मटा भगवानेन वाटु धुन मां रवु, बाकुन मे तुहुंंक अळी बी आखा सी वारु वाट देखाड़े।<verse eid="1CO 12:31" /></para>
  <chapter eid="1CO 12" />
  <chapter number="13" style="c" sid="1CO 13" />
  <para style="s">परम आखा सी मटु छे</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 13:1" />कदी मे माणसेन ने सरग वाळा काहवाळ्‌यान बुले बुलो ने परम नी राखो, ती मे ठण-ठणावती पीतळ, ने झणझणो करती झांझ छे। <verse eid="1CO 13:1" /><verse number="2" style="v" sid="1CO 13:2" />ने कदी मे भगवानेन अघी सी आवणे वाळी वात देखाड़ सको, ने आखा सातायली वातेन ने आखा तरान अक्‌कल काजे समजो, ने मेसे जां लग पुरु भुरसु हवे की मे बयड़ा काजे छेटु करदम, बाकुन परम नी राखो, ती मे काय बी नी हय। <verse eid="1CO 13:2" /><verse number="3" style="v" sid="1CO 13:3" />कदी मे आपणो पुरो धन तींद्‌रे झुणी कायनी हय तीनु काजे खावड़ दम, नीते आपणो डील धपाड़ने वाटे आप दम, ने परम नी राखो, ती मेसे काय बी फायदु नी हय।<verse eid="1CO 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 13:4" />परम दमधरे, ने कीर्‌पाळु छे; परम डाहवाय नी करे; परम आपणी बड़ाय नी करे, ने मटकाळु नी हय, <verse eid="1CO 13:4" /><verse number="5" style="v" sid="1CO 13:5" />चु गलत रीत सी नी चाले, चु आपणी भलाय नी चाहावे, झुंझलावे नी, बुरो नी माने। <verse eid="1CO 13:5" /><verse number="6" style="v" sid="1CO 13:6" />पाप सी खुसी नी हवे, बाकुन छाचाय सी खुसी हवे। <verse eid="1CO 13:6" /><verse number="7" style="v" sid="1CO 13:7" />चु आखी वात सेण कर लेय, आखी वातेन भुरसु करे, आखी वातेन आस राखे, आखी वात मां दमधरे।<verse eid="1CO 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 13:8" />परम कदी टळे नी; भगवानेन अघी सी आवणे वाळी वात हवसे, ती खत्‌तम हय जासे; बुली हसे, ती जाती रवसे; अक्‌कल हसे, ची सर जासे <verse eid="1CO 13:8" /><verse number="9" style="v" sid="1CO 13:9" />काहाकी हामरु अक्‌कल आधीत छे, ने हामरी भगवानेन अघी सी आवणे वाळी वात आधी छे; <verse eid="1CO 13:9" /><verse number="10" style="v" sid="1CO 13:10" />बाकुन जत्‌यार माहान चुखलु आवसे, ती अदेरु सर जासे।<verse eid="1CO 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 13:11" />जत्‌यार मे पुर्‌यु हतलु, ती मे पुर्‌यान तसु बुलतेलु, ने पुर्‌यान तसु वीच्‌यार हतलो, पुर्‌यान तसों मन हतलो, पुर्‌यान तसी समज हतली; बाकुन जत्‌यार मटु हय गुयु ती पुर्‌यान तसी वात छुड़ देदु। <verse eid="1CO 13:11" /><verse number="12" style="v" sid="1CO 13:12" />हय हामुक आरस्‌या मां धुंदळान तसों देखाये, बाकुन हेनी टेमे आंबा-सांबा देखसुन; हीनी टेमे मारु अक्‌कल अदेरु छे, बाकुन हीनी टेमे असु पुरी रीत सी उळखीस, जसु मे उळखाय गुयलु छे।<verse eid="1CO 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 13:13" />बाकुन हय भुरसु, आस, परम जे तीनु जलमेन छे, बाकुन हींद्‌रे मां आखा सी मटु परम छे।<verse eid="1CO 13:13" /></para>
  <chapter eid="1CO 13" />
  <chapter number="14" style="c" sid="1CO 14" />
  <para style="s">भगवानेन अघी सी आवणे वाळी वात देखाड़न्‌यु ने दीसरी बुली</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1" />परमेन हेर करु, ने आत्‌मा मां भरायलान वाटान झींग मां रवु, खास करीन ज्‌य की भगवानेन अघी सी आवणे वाळी वात देखाड़न्‌यु देखाड़ु। <verse eid="1CO 14:1" /><verse number="2" style="v" sid="1CO 14:2" />काहाकी जे दीसरी बुली मां वात करे चु माणसे सी नी बाकुन भगवान सी वात करे; हेरेसी की हेरी वात कुय नी समजे, काहाकी चु सातायली वात आत्‌मा मां हयन बुले। <verse eid="1CO 14:2" /><verse number="3" style="v" sid="1CO 14:3" />बाकुन जे भगवानेन अघी सी आवणे वाळी वात देखाड़े, चु माणसे सी अदु हवणे ने परचार ने सांतीन वात कह्‌वे। <verse eid="1CO 14:3" /><verse number="4" style="v" sid="1CO 14:4" />जु दीसरी बुली मां वात करे, चु आपणोत अदुस बरकत हात करे; बाकुन जु भगवानेन अघी सी आवणे वाळी वात कह्‌वे, चु मंडळीन भलो करसे।<verse eid="1CO 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 14:5" />मे चाहो की तुहुंं आखाक दीसरी बुली मां वात करो; बाकुन हेरे सी अदुस ज चाहो की भगवानेन अघी सी आवणे वाळी वात कहं, काहाकी कदी दीसरी बुली बुलने वाळी मंडळी अदुस हवणे वाटे बुली बदली नी करे, ती भगवानेन आवणे वाळी वात कह्‌णे वाळाक तेरे सी बड़ीन छे। <verse eid="1CO 14:5" /><verse number="6" style="v" sid="1CO 14:6" />हेरेसी ए भायस्‌यो, कदी मे तुंद्‌रे धड़े आवीन दीसरी बुली मां वात करो, ने वीजाळो नेते अक्‌कल नेते भगवानेन आवणे वाळी वात नीते परचारेन वात तींद्‌रे सी नी कहं, ती मार सी तुहुंंक काय फायदु हवसे? <verse eid="1CO 14:6" /><verse number="7" style="v" sid="1CO 14:7" />तसोत कदी तेरे मां जीव नी तीनी चीज बी तींद्‌री आवाज नीकळे, जसा पावळी<note caller="+" style="f"><char style="fr" closed="false">14:7 </char><char style="fq" closed="false">पावळी </char><char style="ft" closed="false">बाँसुरी</char></note> नीते फेप्‌या, कदी हींद्‌रे रेंग मां नी समजाये ती जे फुके नीते आजाड़्‌या, चु कसों उळखाय जासे? <verse eid="1CO 14:7" /><verse number="8" style="v" sid="1CO 14:8" />ने कदी फेप्‌यान आवाज चुखी नी नीकळे, ती कुण लड़ाय वाटे तीयार हवसे? <verse eid="1CO 14:8" /><verse number="9" style="v" sid="1CO 14:9" />असात तुहुंं बी कदी जीप सी चुखी-चुखी वात नी कहुं, ती जे काय कहें चो कसों समजायसे? तुहुंं ते हवा सी वात करने वाळा ठेरावसे। <verse eid="1CO 14:9" /><verse number="10" style="v" sid="1CO 14:10" />कळी मां कतरी बी तरान बुली काहानी हवे, बाकुन हींद्‌रे मां सी कुय बी बीना मतलबेन नी हवे। <verse eid="1CO 14:10" /><verse number="11" style="v" sid="1CO 14:11" />हेरेसी कदी मे काहालीक बुलीन मतलब नी समजे, ती बुलेन वाळान नींगा मां दीसरा देसेन रवसे ने बुलेन वाळा मारी नींगा मां दीसरा देसेन ठेरसे। <verse eid="1CO 14:11" /><verse number="12" style="v" sid="1CO 14:12" />हेरेसी तुहुंं बी जत्‌यार आत्‌मा मां भरायला भगवानेन वाटुेन धुन मां छे ती असा कुसीस करु की तुंद्‌रे भगवानेन वाटुेन अदु हवणे सी मंडळी अदु हवे।<figure style="fig" alt="musical instruments" file="hk00188c.tif" size="col" copy="Horace Knowles ©" ref="14:7">भात-भातीन वाजा</figure><verse eid="1CO 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 14:13" />हेरे वजे सी जे दीसरी बुली बुले, चु दुवा करे की हेरा बुली बदलनेन वाटु बी जड़णु चाहजे। <verse eid="1CO 14:13" /><verse number="14" style="v" sid="1CO 14:14" />हेरेसी कदी मे दीसरी बुली मां दुवा करो, ती मारी आत्‌मा दुवा करे बाकुन मारु डीमाक काम नी देय। <verse eid="1CO 14:14" /><verse number="15" style="v" sid="1CO 14:15" />अळतेन काय करनु चाहजे? मे आत्‌मा सी बी दुवा करो, ने डीमाक सी बी दुवा करो; मे आत्‌मा सी बी गावीस, ने डीमाक सी बी गावीस। <verse eid="1CO 14:15" /><verse number="16" style="v" sid="1CO 14:16" />नी ते कदी तु आत्‌मा सी तु बेसकु वारु छे करीन कह्‌वीस, ती अळतेन डेड़-अकल्‌या <note caller="+" style="f"><char style="fr" closed="false">14:16 </char><char style="fq" closed="false">डेड़-अकल्‌या </char><char style="ft" closed="false">अज्ञानी</char></note>तुसे तु बेसकु वारु छे कवसी ती असोत हवतो रवे करीन कसु कवसे? काहाकी चु तेबी जाणे की तु काय कह्‌वे? <verse eid="1CO 14:16" /><verse number="17" style="v" sid="1CO 14:17" />तु ते वारु रीती सी तु बेसकु वारु छे करीन कह्‌वे, बाकुन दीसरु अगु नी अदे।<verse eid="1CO 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 14:18" />मे आपणा भगवान काजे तु बेसकु वारु छे करीन कह्‌वे, की मे तुहुंं आखा सी जादास दीसरी बुली मां बुलो। <verse eid="1CO 14:18" /><verse number="19" style="v" sid="1CO 14:19" />बाकुन मंडळी मां दीसरी बुली मां दस हजार वात कह्‌वणे सी ज्‌य मेसे अळी बी वारु मालुम पड़े, की दीसरा काजे सीकाड़न्‌ने वाटे डीमाक सी पांच वात कह्‌वे।<verse eid="1CO 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 14:20" />ए भायसे, तुहुंं समज मां पुर्‌या मां बणु; कुहराय मां ते पुर्‌या रवु, बाकुन समज मां हुस्‌यार बणु। <verse eid="1CO 14:20" /><verse number="21" style="v" sid="1CO 14:21" />चुखला सास्‌तुर मां असो लिखलो छे,</para>
  <para style="q1" vid="1CO 14:21">की मालीक कह्‌वे,</para>
  <para style="q2" vid="1CO 14:21">“मे कुय नी जाणे असली बुली बुलने वाळान साहरे,</para>
  <para style="q1" vid="1CO 14:21">ने दीसरान मुंहडान साहरे,</para>
  <para style="q2" vid="1CO 14:21">ईनु माणसे सी वात करीस ती बी चे मारी नी सामळे।”<note caller="+" style="x"><char style="xo" closed="false">14:21 </char><char style="xt" closed="false"><ref loc="ISA 28:11">यसाया 28:11</ref>,<ref loc="ISA 28:12">12</ref> </char></note><verse eid="1CO 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 14:22" />हेरेसी दीसरी बुली ईसु पर भुरसु करन्‌या वाटे नी, बाकुन नी भुरसु करन्‌या वाटे सहलाणी छे; ने भगवानेन अघी सी आवणे वाळी वात ईसु पर नी भुरसु करन्‌या वाटे नी, बाकुन ईसु पर भुरसु करन्‌यान सहलाणी छे।<verse eid="1CO 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 14:23" />अळतेन कदी मंडळी एक जागा भेळी हवे, ने आखान आखा दीसरी बुली बुले, ने छेटे वाळा नीते ईसु पर नी भुरसु करन्‌या माणसे माहें जाय ती काय चे तुहुंं काजे गांडा करीन नी कह्‌वे? <verse eid="1CO 14:23" /><verse number="24" style="v" sid="1CO 14:24" />बाकुन कदी आखा भगवानेन अघी सी आवणे वाळी वात देखाड़न्‌यु कह्‌वणे लागे, ने कुय ईसु पर नी भुरसु करे नीते छेटे वाळा माणसे माहें आय जाय, ती आखा हीनाक आखा गुनाळु ठेराय देसे ने पारखी लेसे; <verse eid="1CO 14:24" /><verse number="25" style="v" sid="1CO 14:25" />ने हींद्‌रे मनेन सातायली वात देखाय जासे ने तत्‌यार चु मुंहडान भुरसे पड़ीन भगवान काजे आंधसे ने मान लेसे की छाचलीन भगवान तुंद्‌रे ईचमां छे।<verse eid="1CO 14:25" /></para>
  <para style="s">उपास करे चां नेमेन अनसारे चाले</para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 14:26" />हेरेसी ए भायसे, काय करनु चाहजे। जत्‌यार तुहुंं भेळा हवु, एक जणान मन मां गावता नीते परचार नीते दीसरी बुली नीते उजाळो नीते दीसरी बुलीन मतलब बताड़नु रवे। आखा काय आत्‌माम अदुस भरायला हवणु चाहजे। <verse eid="1CO 14:26" /><verse number="27" style="v" sid="1CO 14:27" />कदी दीसरी बुली मां वात करनु हय ती दुय नीते बेसका हवे ती तीन जणा वारी-वारी सी बुले, ने एक माणुस बुली बदल्‌या करे। <verse eid="1CO 14:27" /><verse number="28" style="v" sid="1CO 14:28" />बाकुन कदी बुली बदली करने वाळु नी हवे, ती दीसरी बुली बुलने वाळा मंडळी मां हुगा रवे, ने आपणा मन सी ने भगवान सी वाते करे। <verse eid="1CO 14:28" /><verse number="29" style="v" sid="1CO 14:29" />भगवानेन अघी सी आवणे वाळी वात देखान्‌या मां सी दुय नीते तीन जणा बुले, ने बचला माणसे तींद्‌रा बुल काजे पारखे। <verse eid="1CO 14:29" /><verse number="30" style="v" sid="1CO 14:30" />बाकुन कदी बसला दीसरा मायन काहनाक पर जु बठलु छे, काय भगवानेन उपर सी आपला वीजाळो हवे ती पेहलु हुगु रय जाय। <verse eid="1CO 14:30" /><verse number="31" style="v" sid="1CO 14:31" />काहाकी तुहुंं आखा एक-एक करीन भगवानेन अघी सी आवणे वाळी वात देखाड़न्‌यु देखाड़ सको, काहाकी आखा सीके ने आखाक सांती जड़े। <verse eid="1CO 14:31" /><verse number="32" style="v" sid="1CO 14:32" />ने भगवानेन अघी सी आवणे वाळी वात देखान्‌यान आत्‌मा भगवानेन अघी सी आवणे वाळी वात देखान्‌यान हक मां छे। <verse eid="1CO 14:32" /><verse number="33" style="v" sid="1CO 14:33" />काहाकी भगवान खडळ-वडळ करन्‌यु नी हय,</para>
  <para style="p" vid="1CO 14:33">बाकुन भगवान सांतीन भगवान छे जसों चुखला माणसेन आखी मंडळी मां छे। <verse eid="1CO 14:33" /><verse number="34" style="v" sid="1CO 14:34" />बायरा काजे मंडळी मां हुगा रहणु चाहजे, काहाकी हीनुक वात करनेन हुकुम नी हय, बाकुन हक मां रवणेन हुकुम छे, जसों मुसान कायदा मां लिखलो बी छे। <verse eid="1CO 14:34" /><verse number="35" style="v" sid="1CO 14:35" />कदी चे काय सीकणे चाहाये, ती घर मां आपणा-आपणा अदमी सी पुछे, काहाकी बायरी काजे मंडळी मां वात करनु लाजुणेन वात छे।<verse eid="1CO 14:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 14:36" />काय भगवानेन बुल तुंद्‌रे मां सी नीकळ्‌यो काय? नीते सीरप तुंद्‌रेत लग पुगलो छे? <verse eid="1CO 14:36" /><verse number="37" style="v" sid="1CO 14:37" />कदी कुय माणुस आपणे आप काजे भगवानेन अघी सी आवणे वाळी वात देखाड़न्‌यु नीते आत्‌मा भरायला जणु समजे, ती जाण लेय की जी वात मे तुहुंंक लिखो, चो मालीकेन हुकुम छे। <verse eid="1CO 14:37" /><verse number="38" style="v" sid="1CO 14:38" />बाकुन कदी कुय जी वात नी माने, ती हीनाक बी नी माने।<verse eid="1CO 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 14:39" />अळतेन ए भायसे, भगवानेन अघी सी आवणे वाळी वात देखान्‌यान धुन मां रवु ने दीसरी बुली सी नी करीन मां कह्‌वु; <verse eid="1CO 14:39" /><verse number="40" style="v" sid="1CO 14:40" />बाकुन जो आखो काम वारु ने सय सी करनु चाहजे।<verse eid="1CO 14:40" /></para>
  <chapter eid="1CO 14" />
  <chapter number="15" style="c" sid="1CO 15" />
  <para style="s">ईसु मसी मर्‌या-सर्‌याम सी पछु जीवतु हवे</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1" />ए भायसे ने भणस्‌या, हय मे तुहुंंक पेहलुत खुस-खबर बताड़ो जे पेहल सी सामळी लेदला छे, तीनाक तुहुंं हुकारी बी लेदला ने जेरे मां तुहुंं काठा<note caller="+" style="f"><char style="fr" closed="false">15:1 </char><char style="fq" closed="false">काठा </char><char style="ft" closed="false">स्थिर</char></note> बी छे। <verse eid="1CO 15:1" /><verse number="2" style="v" sid="1CO 15:2" />हेरेत साहरे तुंद्‌रु छुटकारु बी हयु, कदी हीना खुस-खबर काजे जु मे सामळलु हेर राखु, नीते तुंद्‌रु भुरसु करनु फालतु हवसे।<verse eid="1CO 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 15:3" />हेरे वजे सी मे आखा सी पेहल तुहुंंक चीत वात पुगाड़ देदु, जी मेसेक मालुम हतली की चुखला सास्‌तुरेन बुलेन अनसारे ईसु मसी आपणे पापे वाटे मर गुयु। <verse eid="1CO 15:3" /><verse number="4" style="v" sid="1CO 15:4" />ने गाड़ाय गुयु, ने चुखला सास्‌तुरेन<note caller="+" style="f"><char style="fr" closed="false">15:4 </char><char style="fq" closed="false">चुखला सास्‌तुरेन </char><char style="ft" closed="false">पवित्रशास्त्र </char></note> अनसारे तीन दाहड़ाम मरलाम सी जीवतु बी हय गुयु,<note caller="+" style="x"><char style="xo" closed="false">15:4 </char><char style="xt" closed="false"><ref loc="HOS 6:2">होसे 6:2</ref> </char></note> <verse eid="1CO 15:4" /><verse number="5" style="v" sid="1CO 15:5" />ने केफा काजे तत्‌यार बारे काजे देखाव पड़्‌यु। <verse eid="1CO 15:5" /><verse number="6" style="v" sid="1CO 15:6" />अळतेन चु पांच सोव सी अदुस भायसे काजे भेळा हतला देखाव पड़्‌यु, तींद्‌रे मां सी बेसका हय लग जीवतेला छे, बाकुन थुड़ाक सुय गुया। <verse eid="1CO 15:6" /><verse number="7" style="v" sid="1CO 15:7" />अळतेन चु याकुब काजे देखाव पड़्‌यु तत्‌यार आखा नेवताळान काम काजे देखाव पड़्‌यु।<verse eid="1CO 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 15:8" />आखान पछे मेसे काजे बी देखाव पड़्‌यु, जे मानु अधेरला दाहड़ान पयदा हवलु। <verse eid="1CO 15:8" /><verse number="9" style="v" sid="1CO 15:9" />काहाकी मे नेवताळान काम मां सी आखा सी नानलु छे, बाकुन नेवताळान काम कह्‌वायणेन लायक<note caller="+" style="f"><char style="fr" closed="false">15:9 </char><char style="fq" closed="false">लायक </char><char style="ft" closed="false">योग्य</char></note> बी नी हय, काहाकी मे भगवानेन मंडळी काजे बेसकु ठुक्‌यु मार्‌यु। <verse eid="1CO 15:9" /><verse number="10" style="v" sid="1CO 15:10" />बाकुन मे जो काय बी छे, भगवानेन गीण-दया सी छे हेरु गीण-दया मार पर हयु चु फालतु नी जाय; बाकुन मे हीनु आखा सी बड़ीन मेहनत बी कर्‌यु, ती बी गुयो मारे भीणी सी नी हयो बाकुन भगवानेन गीण-दया सी गुयो मार पर हतलो। <verse eid="1CO 15:10" /><verse number="11" style="v" sid="1CO 15:11" />हेरेसी चाहे मे छे, चाहे चे रवे हामु गुयो परचार करजे ने हेरे पर तुहुंं भुरसु बी कर्‌या।<verse eid="1CO 15:11" /></para>
  <para style="s">आपणु मर्‌या-सर्‌याम सी पछा जीवता हया</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 15:12" />हेरेसी जत्‌यार की मसीन ज्‌य परचार करे की ईसु मरलाम सी जीवतु हय गुयु, ती तुंद्‌रे मायन बेसका माणसे काहा कहें, की मरलाम सी पछा जीवता हवे नी? <verse eid="1CO 15:12" /><verse number="13" style="v" sid="1CO 15:13" />कदी मरलाम सी जीवता<note caller="+" style="f"><char style="fr" closed="false">15:13 </char><char style="fq" closed="false">मरलाम सी जीवता </char><char style="ft" closed="false">पुनरुत्थान </char></note> नी हवे, ती मसी बी नी जीवतु हय सके; <verse eid="1CO 15:13" /><verse number="14" style="v" sid="1CO 15:14" />ने कदी मसी मरलाम सी जीवतु नी हयु, ती हामरो परचार करनु बी फालतु छे, ने तुंद्‌रो ईसु पर भुरसु करनु बी फालतु छे। <verse eid="1CO 15:14" /><verse number="15" style="v" sid="1CO 15:15" />बाकुन हामु भगवानेन बारामां लुच्‌चाय मेकण्‌या ठेर्‌या काहाकी हामु भगवानेन बारामां जी गवाय देदला; की हीयु मसी काजे जीवाड़ देदलु, अळतेन नी जीवतु हवतु कदी मरलाम सी जीवतु नी हवतु। <verse eid="1CO 15:15" /><verse number="16" style="v" sid="1CO 15:16" />ने कदी मरलाम सी जीवता नी हवता, ती मसी बी नी जीवतु हवतु; <verse eid="1CO 15:16" /><verse number="17" style="v" sid="1CO 15:17" />ने कदी मसी मरलाम सी जीवतु नी हवतु, ती तुंद्‌रो भुरसु करनु फालतु छे, ने तुहुंं हय लग आपणा पाप मां भरायला छे। <verse eid="1CO 15:17" /><verse number="18" style="v" sid="1CO 15:18" />बाकुन जे ईसु मसी मां सुय गुया, चे बी खत्‌तम हय गुया। <verse eid="1CO 15:18" /><verse number="19" style="v" sid="1CO 15:19" />कदी हामु सीरप ईना जीवन मां ईसु मसी मां सी आस राखजे ती हामु आखा माणसे सी जादास दुख झेल्‌जे।<verse eid="1CO 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 15:20" />बाकुन छाचलीन मसी मरलाम सी जीवतु हय गुयु ने जे सुय गुया तींद्‌रे मां चु पेहलुत फळ हयु <verse eid="1CO 15:20" /><verse number="21" style="v" sid="1CO 15:21" />काहाकी जत्‌यार माणसेण साहरे मरनु आयो, ती माणसेन साहरे मरलाम सी पछा जीवता हया <verse eid="1CO 15:21" /><verse number="22" style="v" sid="1CO 15:22" />ने जसों आदम मां आखा मरे, ती असात मसी मां बी आखा जीवता हय गुया, <verse eid="1CO 15:22" /><verse number="23" style="v" sid="1CO 15:23" />बाकुन एकेक जणु आपणी-आपणी वारी मां सी, पेहलु फळ मसी, पछेन मसीन आवणे पर हेरा माणसे जीवाड़ी जासे। <verse eid="1CO 15:23" /><verse number="24" style="v" sid="1CO 15:24" />हेरे पछेन खत्‌तम हवसे। हीने टेमे चु आखी हकदारी, ने आखा हक, ताकत खत्‌तम करीन राज काजे भगवान बासेन हातेम सुप देसे।<note caller="+" style="x"><char style="xo" closed="false">15:24 </char><char style="xt" closed="false"><ref loc="DAN 2:44">दानीयल 2:44</ref></char></note> <verse eid="1CO 15:24" /><verse number="25" style="v" sid="1CO 15:25" />काहाकी जत्‌यार लग चु आपणा दुस्‌मन काजे आपणा पाय तळे नी लावे, तत्‌यार लग हेरो राज करनु जरुड़ी छे।<note caller="+" style="x"><char style="xo" closed="false">15:25 </char><char style="xt" closed="false"><ref loc="PSA 110:1">भजन सहीता 110:1</ref></char></note> <verse eid="1CO 15:25" /><verse number="26" style="v" sid="1CO 15:26" />आखा सी आकरीम दुस्‌मन चु खत्‌तम कर देसे, च मरलु छे। <verse eid="1CO 15:26" /><verse number="27" style="v" sid="1CO 15:27" />काहाकी “भगवान हेरे पाय तळे कर लेदु” बाकुन जत्‌यार चु कवे की आखो काय हेरे हक मां कर लेदलो छे उजेंतो छे, ज आखो काय हेरा हक मां कर देदु, आपसुत आन्‌गे रयु।<note caller="+" style="x"><char style="xo" closed="false">15:27 </char><char style="xt" closed="false"><ref loc="PSA 8:6">भजन सहीता 8:6</ref></char></note> <verse eid="1CO 15:27" /><verse number="28" style="v" sid="1CO 15:28" />ने जत्‌यार आखो काय हेरा हक मां हय जासे ती आपसु बी हेरा हक मां हय जासे ज आखो काय हेरा हक मां कर देदु काहाकी आखा मां भगवानुत आखो काय छे।<verse eid="1CO 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 15:29" />नीते जे माणसे मरला वाटे बपतीस्‌मा लेय चे काय करसे? कदी मरलाम सी जीवता नी हय ती पछेन काहा हींद्‌रे वाटे बपतीस्‌मा लेदु? <verse eid="1CO 15:29" /><verse number="30" style="v" sid="1CO 15:30" />ने हामु बी काहा आखी टेमे तकलीप मां पड़ता रवजे? <verse eid="1CO 15:30" /><verse number="31" style="v" sid="1CO 15:31" />ए भायसे ने भणस्‌या, मेसे हीनी मटायन सगुन तसों जे हामरा ईसु मसी मां ने मालीक मे तुंद्‌रे बारामां कव की मे दाहड़ीन मरो। <verse eid="1CO 15:31" /><verse number="32" style="v" sid="1CO 15:32" />कदी मे माणसेन रीत पर ईफीसुस मां झाड़का ढुरे सी लड़ाय करतु ती मेसेक काय फायदु हवतु? कदी मरलाम सी जीवता नी हवता, “ती आवु, खाजे ने पीजे काहाकी काल ते मरी जासुन।”<note caller="+" style="x"><char style="xo" closed="false">15:32 </char><char style="xt" closed="false"><ref loc="ISA 22:13">यसाया 22:13</ref> </char></note><verse eid="1CO 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 15:33" />धुकु मां खावु, “भुंडीत संगात वारलु चाल-चलन काजे बीगाड़ देय।” <verse eid="1CO 15:33" /><verse number="34" style="v" sid="1CO 15:34" />धरम वाटे जागी जावु ने पाप मां करु; काहाकी काय माणसे असात छे जे भगवान काजे नी जाणे। मे तुहुंं काजे सरमाड़ने करीन ज कव।<verse eid="1CO 15:34" /></para>
  <para style="s">पछु जीवतु हवणे डील</para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35" />हय कुय ज कवसे, “मरलाम सी जीवता काहनी रीत सी हय जाय, ने काहला डील साते आवे?” <verse eid="1CO 15:35" /><verse number="36" style="v" sid="1CO 15:36" />ए डेड़-अकल्‌या ज काय तु एरे, जत्‌यार लग च नी मरे जीवतो नी हवे <verse eid="1CO 15:36" /><verse number="37" style="v" sid="1CO 15:37" />ने ज तु एरे, च डील नी हय ज पयदा हवणे वाळु छे, बाकुन सीरप वारलु दाणा छे, चाहे गहुंन रवे चाहे काहलाक अळी अनाजेन हवे <verse eid="1CO 15:37" /><verse number="38" style="v" sid="1CO 15:38" />बाकुन भगवान आपणी मरजीन अनसारे हीनाक डील आपे, ने एकेक बीज काजे खास करीन डील आपे।<verse eid="1CO 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 15:39" />आखो डील एक तसों नी हय; माणसेन डील आन्‌गे छे, ने ढुरेन डील आन्‌गे छे; ने चिरलान डील आन्‌गे छे; ने माछान डील आन्‌गे छे।<verse eid="1CO 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="1CO 15:40" />सरगेन डील छे ने कळी सी पयदा हवणु वाळु डील बी छे। बाकुन सरगेन डीलेन सेक-सींगार आन्‌गे छे, ने कळी मां वाळु आन्‌गे छे। <verse eid="1CO 15:40" /><verse number="41" style="v" sid="1CO 15:41" />दाहड़ान उजाळो आन्‌गे छे, चांदेन उजाळो आन्‌गे छे, तारान उजाळो आन्‌गे छे, काहाकी एक तारा सी दीसरा तारा मां वीजाळो फरक छे।<verse eid="1CO 15:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="1CO 15:42" />मरलाम सी जीवतो हवणेन बी असोत छे। डील खत्‌तम हवणेन रीत मां एराय जाय ने कदी खत्‌तम नी हवणे वाळा सीका मां जीवतो हय जाय। <verse eid="1CO 15:42" /><verse number="43" style="v" sid="1CO 15:43" />चु आव-भाव नी हवे ने एराय जाय, ने तेरे साते जीवतु हय जाय; लुला साते एराय जाय, ताकत वाळा साते मरलाम सी जीवता हय जाय <verse eid="1CO 15:43" /><verse number="44" style="v" sid="1CO 15:44" />माणसेन जीवणु मरनु धड़ काजे धरती मां एराय जाय, ने आत्‌मा मां भरायला डील मरलाम सी जीवतो हय जाय; असो की धरती पर वाळा डील छे ती आत्‌मा मां भरायला डील बी छे। <verse eid="1CO 15:44" /><verse number="45" style="v" sid="1CO 15:45" />असोत लिखलो बी छे, की “पेहलो माणुस, मतलब आदम जीवतेलु जीव बण्‌यु” आकरी आदम, जीवेक आपण्‌यु आत्‌मा बण्‌यु। <verse eid="1CO 15:45" /><verse number="46" style="v" sid="1CO 15:46" />बाकुन पेहेल आत्‌मा मां भरायला नी हतलु, बाकुन धरती पर वाळा डीलेन सीकु हतलु, हेरे पछेन आत्‌मा मां भरायला हया <verse eid="1CO 15:46" /><verse number="47" style="v" sid="1CO 15:47" />पेहलो माणुस कळी सी मतलब धुळान हतलो; दीसरो माणुस सरगेन छे।<note caller="+" style="x"><char style="xo" closed="false">15:47 </char><char style="xt" closed="false"><ref loc="JHN 3:31">युहन्‌ना 3:31</ref></char></note> <verse eid="1CO 15:47" /><verse number="48" style="v" sid="1CO 15:48" />जसु चु धुळान हतलु, असात चे बी छे, जे धुळान छे; ने जसु चु सरगेन छे, असात चे बी छे जे सरगेन छे। <verse eid="1CO 15:48" /><verse number="49" style="v" sid="1CO 15:49" />ने जसा हामु हेरे सीका काजे बदल्‌या जो धुळान हतलो असात हीना सरगेन सीका काजे बी बदलसुन।<note caller="+" style="x"><char style="xo" closed="false">15:49 </char><char style="xt" closed="false"><ref loc="1JN 3:2">1 युहन्‌ना 3:2</ref></char></note><verse eid="1CO 15:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="1CO 15:50" />ए भायसे ने भणस्‌या, मे गुयो कह्‌वो की सीकार ने लुही भगवानेन राजेन हकदारी नी हय सके, ने नीते धरती पर वाळा सरन्‌या डील, हकदार्‌यु हय सके। <verse eid="1CO 15:50" /><verse number="51" style="v" sid="1CO 15:51" />सामळु, मे तुंद्‌रे सी सातायली वात कय सके, हामु आखा नी मरजे, बाकुन आखा बदली जासुन, <verse eid="1CO 15:51" /><verse number="52" style="v" sid="1CO 15:52" />ने जे पापण्‌या पटकारता वार मां, आकरी फेप्‌यो फुक्‌से ती हवसे। काहाकी फेप्‌यो फुक्‌से ने मरलाम सी जीवता जलमेन तसा उठाय जासे, ने हामु बदली जासुन। <verse eid="1CO 15:52" /><verse number="53" style="v" sid="1CO 15:53" />काहाकी जरुड़ी छे की ज्‌य खत्‌तमेन हवणेन डील कदी नी खत्‌तम हवणेन काजे पेहरी लेसे, ने ज्‌य मरलो डील जलमेन डील काजे पेहरी लेसे। <verse eid="1CO 15:53" /><verse number="54" style="v" sid="1CO 15:54" />ने जत्‌यार ज्‌य खत्‌तम हवणेन कदी नी खत्‌तम हवणेन काजे पेहरी लेसे, ने ज्‌य मरलो जलम काजे पेहरी लेय, ने तत्‌यार चो बुल जो लिखलो छे पुरो हय जासे: “ज्‌य ने मरण काजे गीळ गुयो।”<note caller="+" style="x"><char style="xo" closed="false">15:54 </char><char style="xt" closed="false"><ref loc="ISA 25:8">यसाया 25:8</ref></char></note><verse eid="1CO 15:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="1CO 15:55" />“ए मरनु, तारी ज्‌य काहा रय?</para>
  <para style="q1" vid="1CO 15:55">ए मरनु, तारु टच काहा रयु?”<note caller="+" style="x"><char style="xo" closed="false">15:55 </char><char style="xt" closed="false"><ref loc="ISA 13:14">यसाया 13:14</ref> </char></note><verse eid="1CO 15:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="1CO 15:56" />मरनेन घाव पाप छे, ने पापेन ताकत कायदु छे। <verse eid="1CO 15:56" /><verse number="57" style="v" sid="1CO 15:57" />बाकुन भगवान काजे तु बेसकु वारु छे करीन कह्‌वो जो हामरे मालीक ईसु मसीन साहरे हामुक जीत जड़े।<verse eid="1CO 15:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="1CO 15:58" />हेरेसी ए मारा लाटेक्‌ला भायसे, काठा ने टणका रवु, ने मालीकेन काम मां जलम बड़ता जावु, काहाकी ज्‌य जाणु की तुंद्‌री महनोत मालीक मां फालतु नी हय।<note caller="+" style="x"><char style="xo" closed="false">15:58 </char><char style="xt" closed="false"><ref loc="GAL 6:9">गलातीयो 6:9</ref></char></note><verse eid="1CO 15:58" /></para>
  <chapter eid="1CO 15" />
  <chapter number="16" style="c" sid="1CO 16" />
  <para style="s">ईसु पर भुरसु करन्‌या वाटे दान</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1" />हय हीना चंदान बारामां जे चुखला माणसे वाटे करलो छे, जसु हुकुम मे गलातीयान मंडळी काजे आपलु, असात तुहुंं बी आपो <verse eid="1CO 16:1" /><verse number="2" style="v" sid="1CO 16:2" />हाप्‌तान पेहले दाहड़े तुंद्‌रे मां सी एक-एक जणा आपणी धके तेरे अनसारे थुड़ाक आपणे धड़े मेकी रवजु की मारे आवणे पर चंदु नी करनु पड़े। <verse eid="1CO 16:2" /><verse number="3" style="v" sid="1CO 16:3" />ने जत्‌यार मे आवीस, ती तीनाक तुहुंं चाहु हीनुक मे चिट्‌ठी आपीन मकली दीस की तुंद्‌रो दान यरुसलेम मां पुगाड़ देसे। <verse eid="1CO 16:3" /><verse number="4" style="v" sid="1CO 16:4" />कदी मारो बी जाणु जरुड़ी हयो ती चे मारे साते जासे।<verse eid="1CO 16:4" /></para>
  <para style="s">पोलुसेन जाणेन बसोक</para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 16:5" />मे मकीदुनीया हयन तुंद्‌रे धड़े आवीस, काहाकी मेसे मकीदुनीया हयन जाणुत छे। <verse eid="1CO 16:5" /><verse number="6" style="v" sid="1CO 16:6" />बाकुन अनुमान छे की तुंद्‌रेन चांहान रय जाय ने सरदीन रीतु तुंद्‌रेन चांहान नीकळो, तत्‌यार जीनु भीणी मारो जाणु हेरसी हेरे भीणी तुहुंं मेसे पुगाड़ देजु। <verse eid="1CO 16:6" /><verse number="7" style="v" sid="1CO 16:7" />काहाकी मे हय वाट मां तुंद्‌रे सी मेळने नी चाहतु; बाकुन मेसे आस छे की कळी मालीक चाहे ती थुड़ीक टेमी लग तुंद्‌रे साते रवीस।<verse eid="1CO 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 16:8" />बाकुन मे पेन्‌तेकुस्‌तेन लग ईफीसुस मां रवीस, <verse eid="1CO 16:8" /><verse number="9" style="v" sid="1CO 16:9" />काहाकी मारे वाटे चां एक मटु ने काम मां आवणे वाळो बारनो उघल्‌लो छे ने वीरुदी बेसका छे।<verse eid="1CO 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 16:10" />कदी तीमुथीयुस आय जाय, ती देखजु की चु तुंद्‌रेन्‌चां चु नी बीहे रवसे; काहाकी चु मारेन तसु मालीकेन काम करे। <verse eid="1CO 16:10" /><verse number="11" style="v" sid="1CO 16:11" />हेरेसी कुय हीनाक गलत घुण जाणु, बाकुन हीनाक सांती सी ईनी धड़े पुगाड़ देजु, की मारे धड़े आय जाय काहाकी मे हेरी वाट देख र्‌यु की चु भायसे साते आवे।<verse eid="1CO 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 16:12" />भायस अपुल्‌लोस सी मे बेसकु लीलघायु ने कह्‌यु की तुंद्‌रे धड़े भायसे साते जाय; बाकुन हीयु हीनी टेमे जाणेन काय बी मरजी नी कर्‌यु, बाकुन जत्‌यार मुखु जड़से तत्‌यार आय जासे।<verse eid="1CO 16:12" /></para>
  <para style="s">आकरी आदेस ने आवीस ने आवजु कवणु</para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 16:13" />जागता रवु, भुरसु मां काठा रवु, हिम्‌मत राख्‌जु, ताकत वाळा<note caller="+" style="f"><char style="fr" closed="false">16:13 </char><char style="fq" closed="false">ताकत वाळा </char><char style="ft" closed="false">बलवन्त</char></note> बणु। <verse eid="1CO 16:13" /><verse number="14" style="v" sid="1CO 16:14" />जो काय करु चो परम सी करु।<note caller="+" style="x"><char style="xo" closed="false">16:14 </char><char style="xt" closed="false"><ref loc="EPH 6:10">ईफीसीयो 6:10</ref></char></note><verse eid="1CO 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 16:15" />ए भायसे, तुहुंं स्‌तीफनासेन घराणा काजे जाणु की चे अखायान पेहलो फळ छे, ने चुखला माणसेन चाकरी वाटे तीयार रवे असु लीलघायो। <verse eid="1CO 16:15" /><verse number="16" style="v" sid="1CO 16:16" />हेरेसी मे तुंद्‌रे सी लीलघायु करो की असात हक मां रवु, बाकुन एक-एक जणान जे हीना काम मां मेहनत ने साजल्‌या छे।<verse eid="1CO 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 16:17" />मे स्‌तीफनास ने फुरतुनास ने अखयकुसेन आवणे सी बेसकु खुसी हय र्‌यु, काहाकी जे तुंद्‌री कमी काजे पुरा कर्‌या। <verse eid="1CO 16:17" /><verse number="18" style="v" sid="1CO 16:18" />चे मारी ने तुंद्‌री आत्‌मा काजे सांती आप देदा, हेरेसी असा काजे मानु।<verse eid="1CO 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 16:19" />आसीयान मंडळी भीणी सी तुहुंं काजे आवजु ने आवीस कह्‌वो; अक्‌वीला ने परीस्‌कीला ने हींद्‌रे घरेन मंडळी काजे बी तुहुंंक मालीक मां बेसका-बेसका कावा आवजु ने आवीस कह्‌वो <verse eid="1CO 16:19" /><verse number="20" style="v" sid="1CO 16:20" />आखा भायसे काजे तुहुंंक आवजु ने आवीस।</para>
  <para style="p" vid="1CO 16:20">चुखला गुळा दीन आंबा-सांबा आवजु ने आवीस कह्‌वो।<verse eid="1CO 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 16:21" />मे पोलुस काजे आपणे हात काजे लिखलो छे, आवजु ने आवीस।<verse eid="1CO 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 16:22" />कदी कुय मालीक<note caller="+" style="f"><char style="fr" closed="false">16:22 </char><char style="fq" closed="false">मालीक </char><char style="ft" closed="false">प्रभु</char></note> सी परम नी राखे ती चु सराप वाळु छे।</para>
  <para style="p" vid="1CO 16:22">ए हामरा मालीक आव।<verse eid="1CO 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 16:23" />मालीक ईसुन गीण-दया तुंद्‌रे पर हवती रवे।<verse eid="1CO 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 16:24" />मारु परम ईसु मसी मां तुंद्‌रे आखा साते रवतु रवे।<verse eid="1CO 16:24" /></para>
  <chapter eid="1CO 16" />
</usx>