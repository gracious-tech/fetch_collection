<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GEN" style="id">- Bhilali Standard Project</book>
  <para style="h">उबजाणनी किताप</para>
  <para style="toc3">उबजाणनी किताप</para>
  <para style="toc2">उबजाणनी किताप</para>
  <para style="toc1">उबजाणनी किताप</para>
  <para style="mt2">उत्पत्ति</para>
  <para style="mt1">उबजाणनी किताप</para>
  <para style="imt">उबजाणनी कितापेन बारामां</para>
  <para style="ip">उबजाणनी बुलेन मतलब “सुरुवात” ने ज बाइबीलेन जुन्‌नला नेमेन पेहली किताप छे। पेहली ईब्‌रानी बुली “सुरुवात मां” बुली सी सुरु हवे। ज देखाड़े की आखो काय कां सी आयो ने खास करीन माणसे पुठ्‌ये भगवानेन वेहवार कसु सुरु हयु। आज अक्‌कल वाळा धड़े तीना माणसेन बारामां बेसका पाक्‌को मालुम छे जे उबजाणनी किताप लिखला ने ज बी की जी किताप कत्‌यार लिखला। थुड़ाक माणसेन मान्‌नु छे की हीनाक बेसका साल पेहेल पेहला जमाना मां कागद लिखलो हतलो। बेबोलोन मां दीसरा माणसे पेहलुत सी मान्‌ता आय रया की मुसान उबजाणनी किताप अळी दीसरी नीरगमन, लेवयवेवस्‌था, गिन्‌ती ने वेवस्‌थावीवरन ईनु किताप्‌या काजे 1300 नीते 1400 सालेक पेहेल लिखलु।</para>
  <para style="ip">उबजाणनी किताप मां बेसको जरुरी जानकारी छे भुरसु करन्‌या वाळा काजे बाइबीलेन दीसरा हीस्‌सान, जुन्‌ला ने नवला नेम दुयु काजे समजणे मां मदत करे। ज हामुक देखाड़े की पाप कळी मां कसु आयु ने माणसे काजे एक छुड़ावणे वाळान जरुवत छे। जां माणसे काजे बचाड़ने वाटे भगवानेन युजना देखाड़े। ईसुन बारामां भगवानेन अघी सी आवणे वाळी वात बताड़न्‌या <char style="xt"><ref loc="GEN 3:15">उबजाणनी किताप 3:15</ref></char> ने अब्‌राहम सी कळी पर आखी जाती काजे संयबरकत आपणे वाळा भगवानेन वायदान <char style="xt"><ref loc="GEN 12:3">उबजाणनी किताप 12:3</ref></char> मां लिखलो छे।</para>
  <para style="iot">बाहरती वात</para>
  <para style="io1">1. जसो की लिखलो छे, भगवान कळी ने आदम ने हवा काजे बणायु। <char style="ior"><ref loc="GEN 1-2">1—2</ref></char></para>
  <para style="io1">2. आदम ने हवा, तींद्‌रा पापेन बारामां ने तींद्‌री अवल्‌यातेन लिखलो छे। <char style="ior"><ref loc="GEN 3-5">3—5</ref></char></para>
  <para style="io1">3. नुह मट्‌ली नदीन बारामां बताड़्‌यु। <char style="ior"><ref loc="GEN 6-9">6—9</ref></char></para>
  <para style="io1">4. नुहान टेम मां अब्‌राहमेन टेमेन ईचमां काय हवलो, जेरे सी बाबेलेन खंबु बी तेरेमां छे। <char style="ior"><ref loc="GEN 10-11">10—11</ref></char></para>
  <para style="io1">5. अब्‌राहम हेरा घरन्‌यान ने इस्‌राएली जातीन सुरुवातेन बारामां छे। <char style="ior"><ref loc="GEN 12-50">12—50</ref></char></para>
  <para style="io2">(अ) अब्‌राहम ने हेरी घरवाळी सारान जीवनेन बारामां लिखलो छे। <char style="ior"><ref loc="GEN 12-25">12—25</ref></char></para>
  <para style="io2">(ब) इसाक ने हेरी घरवाळी रीबकान जीवनेन बारामां लिखलो छे<char style="ior"><ref loc="GEN 21-28">21—28</ref></char>, ने हेरो मरनेन बारामां लिखलो छे।<char style="ior"><ref loc="GEN 35">35</ref></char></para>
  <para style="io2">(स) याकुब, हेरा पुर्‌यान जीवनेन बारामां ने कनान सी मीसर देस लग हींद्‌रो अगो जाणेन बारामां लिखलो छे। <char style="ior"><ref loc="GEN 25-50">25—50</ref></char></para>
  <para style="io2">(द) याकुब हेरा लाटेकला पुर्‌यु जोसेफेन बारामां लिखलो छे ने चु मीसर देस मां कसु राजु बण्‌यु। <char style="ior"><ref loc="GEN 37-50">37—50</ref></char></para>
  <chapter number="1" style="c" sid="GEN 1" />
  <para style="s">भगवान कळी काजे बणायु</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 1:1" />सुरु मां भगवान सरग ने धरती काजे बणायु।<note caller="+" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="HEB 1:10">ईब्‌रानीयो 1:10</ref>; <ref loc="HEB 11:3">11:3</ref></char></note> <verse eid="GEN 1:1" /><verse number="2" style="v" sid="GEN 1:2" />सुरु मां धरतीन आकार वारु नी हतलो ने सुन्‌ली हतली। ने बेसका पाणी पर आंदारलो हतलो, ने भगवानेन जीव-आत्‌मा पाणी पर फीरतेलो।<note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="2CO 4:6">2 कुरींथी 4:6</ref></char></note> <verse eid="GEN 1:2" /><verse number="3" style="v" sid="GEN 1:3" />तत्‌यार भगवान कह्‌यु, “वीजाळो हय जा” ने वीजाळो हय गुयो। <verse eid="GEN 1:3" /><verse number="4" style="v" sid="GEN 1:4" />ने भगवान वीजाळा काजे देखीन कह्‌यु। ज वारु छे। ने जा-जा वीजाळो हयो चां-चां सी आंधारो छेटे हय गुयो असु करीन भगवान आंधारा काजे वीजाळाम सी छेटे कर देदु। <verse eid="GEN 1:4" /><verse number="5" style="v" sid="GEN 1:5" />ने भगवान वीजाळा काजे दाहड़ु कह्‌यु ने आंदारला काजे रात कह्‌यु तत्‌यार सांतेलो हयो ने पेहलु दाहड़ु हय गुयु।<verse eid="GEN 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 1:6" />अळतेन भगवान कह्‌यु, “पाणीन ईचमां एक असु जागु हय जाय की दुय हीस्‌सा मां वाटाय जाय।”<note caller="+" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="2PE 3:5">2 पतरस 3:5</ref></char></note> <verse eid="GEN 1:6" /><verse number="7" style="v" sid="GEN 1:7" />तत्‌यार भगवान जागु बणायन तेर नेचु पाणी ने तेर उपर पाणी काजे आंग्‌ये कर्‌यु ने तसोत हय ज्‌यो। <verse eid="GEN 1:7" /><verse number="8" style="v" sid="GEN 1:8" />ने भगवान तीनी जागा काजे सरग कह्‌यु। ने तत्‌यार सांतो हयो ने संदारो बी हयो। ने अळतेन दीसरु दाहड़ु हय गुयु।<verse eid="GEN 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 1:9" />पछेन भगवान कह्‌यु, “सरगेन नेचो कळी परुन पाणी, एक जागे भेळो हय जा, ने सुकली जागा देखायणे बाजी जाय।” ने भगवान कह्‌यु तसोत हय गुयो<note caller="+" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="2PE 3:5">2 पतरस 3:5</ref></char></note> <verse eid="GEN 1:9" /><verse number="10" style="v" sid="GEN 1:10" />भगवान सुकली जागान नाव धरती पाड़्‌यु ने जो पाणी भेळो हय रवलो, तीना पाणीन नाव समुंदर पाड़्‌यु। तत्‌यार भगवान जो देखीन कह्‌यु वारु छे। <verse eid="GEN 1:10" /><verse number="11" style="v" sid="GEN 1:11" />अळी भगवान कह्‌यु, “धरती पर आखी भातीन झाड़का ने बीज उंगी आवु, ने भाती-भातीन फळ लावण्‌या झाड़का उंगी आवु, ने तींद्‌रेम भाती-भातीन बीज रवसे, ने भाती-भातीन दाणावाळा टटाळा बी उंगु।” ने भगवान कह्‌यु तसोत हय गुयो।<note caller="+" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="1CO 11:8">1 कुरींथी 11:8</ref></char></note> <verse eid="GEN 1:11" /><verse number="12" style="v" sid="GEN 1:12" />ने धरतीम सी भात-भातीन फळ लावण्‌या झाड़का उंगी गुया, तींद्‌रेम भाती-भातीन बीज रवे, ने भाती-भातीन दाणावाळा टटाळा, ने आखी भातीन झाड़का ने बीज उंगी गुया, ने भगवान जो आखो देखीन कह्‌यु, जो वारु छे। <verse eid="GEN 1:12" /><verse number="13" style="v" sid="GEN 1:13" />तत्‌यार सांतो हयो, अळी संदारो हयो। असु करीन तीसरु दाहड़ु हय गुयु,<verse eid="GEN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 1:14" />अळतेन भगवान कह्‌यु, “दाहड़ा काजे रात सी अलग करने करीन सरगेन नेचो वीजाळो रहे; ने चे सहलाणी, ने टाकली टेम ने दाहड़ा, ने साल सी हवे; <verse eid="GEN 1:14" /><verse number="15" style="v" sid="GEN 1:15" />ने वीजाळो सरगेन नेचे धरती पर वीजाळो करने वाळा रवे,” ने तसोत हयो। <verse eid="GEN 1:15" /><verse number="16" style="v" sid="GEN 1:16" />तत्‌यार भगवान दुय मटला वीजाळा बणायु, दीसु राज करने वाटे दाहड़ा काजे बणायु ने रात पर राज करने वाटे चांद काजे बणायु ने तारा बी बणायु। <verse eid="GEN 1:16" /><verse number="17" style="v" sid="GEN 1:17" />भगवान तीनुक सरगेन हेटु असु करीन मेक्‌यु की चे धरती पर वीजाळो करे, <verse eid="GEN 1:17" /><verse number="18" style="v" sid="GEN 1:18" />ने दीसु ने रात पर हक करे, ने वीजाळा काजे आंधारा सी अलग करे : भगवान देख्‌यु की जो वारु छे। <verse eid="GEN 1:18" /><verse number="19" style="v" sid="GEN 1:19" />तत्‌यार सांतो हयो, अळी संदारो हयो। असु करीन चोवथु दाहड़ु हय गुयु।<verse eid="GEN 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 1:20" />भगवान कह्‌यु, पाणी छे च आखा भाती-भातीन जीवतेला जानवार्‌या सी भराय जाय, ने जे वाहळा मां उडण्‌या चिरला सी भराय जाय। <verse eid="GEN 1:20" /><verse number="21" style="v" sid="GEN 1:21" />हेरेसी भगवान पाणी मां रहण्‌या भाती-भातीन ने मटा-मटा पाणीम रहण्‌या जानवर्‌या बणायु, ने ईनी रीती वाहळा मां उडन्‌या, चिरला काजे बी जाती-जातीन अनसारे बणायु, ने भगवान जो आखो देखीन कह्‌यु, “जो वारु छे।” <verse eid="GEN 1:21" /><verse number="22" style="v" sid="GEN 1:22" />ने भगवान जो कह्‌तु जाय्‌न संयबरकत आप्‌यु, “वेल अधे ने दरीयान पाणीम भराये ने चिरला धरती पर अधे।” <verse eid="GEN 1:22" /><verse number="23" style="v" sid="GEN 1:23" />तत्‌यार सांतो हयो ने अळी संदारो हयो। असु करीन पांचवु दाहड़ु हय गुयु,<verse eid="GEN 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 1:24" />भगवान कह्‌यु, “धरतीम सी आखी जातीन जीव जानवर्‌या, घर पाळन्‌या जानवर्‌या, घीसड़ायन चालन्‌या जीव, ने जंगली जानवर्‌या, तुहुंं आखा आपसी- जाती-जातीन अनसारे बणी जावु।” ने भगवान कह्‌यु तसोत हय गुयो <verse eid="GEN 1:24" /><verse number="25" style="v" sid="GEN 1:25" />असु करीन भगवान धरती पर जाती-जातीन जंगली जानवर्‌या काजे, ने जाती-जातीन घरेन जानवर्‌या काजे, ने जाती-जातीन जागा पर आखा घीसड़ायन्‌या जानवर्‌या काजे, बणायु; ने देखीन भगवान काजे वारु लाग्‌यो।<verse eid="GEN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 1:26" />अळतेन भगवान कह्‌यु, “चालु आपणु माणुस जात काजे आपणा सीका मां, आपणेन तसात बणावता। ने चे, तीनु आखा जानवर्‌या पर, ने दरीयान माछा पर, ने सरगेन चिरला पर, ने घर पाळन्‌या जानवर्‌या पर, ने घीसड़ायन चालन्‌या जानवर्‌या पर, ने आखी धरती पर राज करे।”<note caller="+" style="x"><char style="xo" closed="false">1:26 </char><char style="xt" closed="false"><ref loc="JAS 3:9">याकुब 3:9</ref></char></note> <verse eid="GEN 1:26" /><verse number="27" style="v" sid="GEN 1:27" />ने भगवान माणुस जात काजे आपसा सीका मां घड़्‌यु। ने चु अदमीक ने बायरीक घड़्‌यु।<note caller="+" style="x"><char style="xo" closed="false">1:27 </char><char style="xt" closed="false"><ref loc="MRK 10:6">मरकुस 10:6</ref>; <ref loc="ACT 17:29">नेवताळान काम 17:29</ref>; <ref loc="COL 3:10">कुलुस्‌यो 3:10</ref>; <ref loc="1TI 2:13">1 तीमुथीयुस 2:13</ref></char></note> <verse eid="GEN 1:27" /><verse number="28" style="v" sid="GEN 1:28" />भगवान तीनुक संयबरकत आप्‌यु, ने तीनुक कह्‌यु, “वेल वदु ने धरती पर वस जावु, ने तीनीक आपसा हकेम कर लेवु, ने दरीयान माछा ने सरगेन चिरला ने धरती पर घीसड़ायन चालन्‌या-फीरन्‌या आखा जीव-जानवर्‌या पर हक जमाड़ लेवु।”<note caller="+" style="x"><char style="xo" closed="false">1:28 </char><char style="xt" closed="false"><ref loc="GEN 5:1-2">उबजाणनी किताप 5:1-2</ref></char></note> <verse eid="GEN 1:28" /><verse number="29" style="v" sid="GEN 1:29" />अळतेन भगवान कह्‌यु, “सामळु, मे आखी धरतीन भात-भातीन फळ लावण्‌या झाड़का तींद्‌रेम भात-भातीन बीज रवे ने भात-भातीन दाणावाळा टटाळा तुहुंंक आपलु छे। जे आखा तुंद्‌रे वाटे खाणे करीन छे।<note caller="+" style="x"><char style="xo" closed="false">1:29 </char><char style="xt" closed="false"><ref loc="ROM 14:2">रोमीयो 14:2</ref></char></note> <verse eid="GEN 1:29" /><verse number="30" style="v" sid="GEN 1:30" />ने धरतीन आखा जानवर्‌या वाटे, ने सरगेन आखा चिरला वाटे, ने धरती पर चालन्‌या-फीरन्‌या आखा जानवर्‌या वाटे तींद्‌रेम जीवणेन जीव छे- ईनु आखा काजे खाणे करीन आखी भातीन नीळ्‌ळा झाड़का आपलु छे।” ने भगवान कह्‌यु तसोत हवणे बाजी गुयो। <verse eid="GEN 1:30" /><verse number="31" style="v" sid="GEN 1:31" />तत्‌यार भगवान ज काय बणावलु, चो आखो देखीन कह्‌यु, “जो बेसको वारु छे।” तत्‌यार सांतो हयो, अळतेन संदारो हयो। तसों करीन छटवु दाहड़ु हय ज्‌यु।<verse eid="GEN 1:31" /></para>
  <chapter eid="GEN 1" />
  <chapter number="2" style="c" sid="GEN 2" />
  <para style="s">सातवे दाहड़े आराम कर्‌यु</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 2:1" />असु करीन भगवान सरग, ने धरतीम जो काय तेरेमां छे, चो आखो बणायु। <note caller="+" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="EXO 20:11">नीरगमन 20:11</ref>; <ref loc="HEB 4:4">ईब्‌रानीयो 4:4</ref>,<ref loc="HEB 4:10">10</ref></char></note> <verse eid="GEN 2:1" /><verse number="2" style="v" sid="GEN 2:2" />भगवान, आपसो जो काम करने बाजी रहलु, तीना काम काजे पुरो करीन सातवे दाहड़े रीकामु हयु, ने सातवे दाहड़े आराम कर्‌यु।<note caller="+" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="HEB 4:4">ईब्‌रानीयो 4:4</ref>,<ref loc="HEB 4:10">10</ref></char></note> <verse eid="GEN 2:2" /><verse number="3" style="v" sid="GEN 2:3" />तत्‌यार भगवान सातवे दाहड़ाक संयबरकतेन चुखलु दाहड़ु कहीन तीनाक नक्‌खी कर्‌यु, काहाकी तीने दाहड़े, चु कळीक घड़नेन आखा कामे करीन नवराय्‌न आराम करलु। <note caller="+" style="x"><char style="xo" closed="false">2:3 </char><char style="xt" closed="false"><ref loc="EXO 20:11">नीरगमन 20:11</ref></char></note><verse eid="GEN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 2:4" />सरगे ने धरती बणावणेन हवली वात जी छे,</para>
  <para style="s" vid="GEN 2:4">अदनेन वाड़ी</para>
  <para style="p" vid="GEN 2:4">जत्‌यार कळ घड़ाय मतलब जीने दाहड़े यहोवा भगवान कळी काजे बणावणे बाजी गुयलु। <verse eid="GEN 2:4" /><verse number="5" style="v" sid="GEN 2:5" />तत्‌यार धरती पर काहनो बी बीज, झाड़को नी उंगयो, ने खेत मां बी कायनी उंगयो काहाकी यहोवा भगवान धरती पर पाणी नी पाड़्‌यु ने धरती पर खेती करने वाटे काहनो माणुस बी नी हतलो। <verse eid="GEN 2:5" /><verse number="6" style="v" sid="GEN 2:6" />तेबी धरतीम सी कुहरो नीकळीन आवतेलु ती चु आखी धरती काजे भींजवी देतलु।<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false">यहोवा बुल, ज्‌य बुल हीब्‌रु रीती भाती सी लेदलो छे</char></note><verse eid="GEN 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 2:7" />ती यहोवा भगवान माणुस काजे धरतीन धुळा सी बणायु, ने तेरा नाक मां जीवनेन दम फुक देदु। ने माणुस एक जीवतेला डीलेन जीव बण गुयु।<note caller="+" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="1CO 15:45">1 कुरींथी 15:45</ref></char></note><verse eid="GEN 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 2:8" />अळी यहोवा भगवान उगेवणु अदन मुलुक मां एक वाड़ी लागाड़्‌यु, ने यहोवा भगवान तीना माणुस काजे बणायु तीना काजे तीनी वाड़ी मां मेल देदु। <verse eid="GEN 2:8" /><verse number="9" style="v" sid="GEN 2:9" />ने यहोवा भगवान आखी भातीन झाड़का ने देखणे मां वारु तींद्‌रा फळ खाणे मां वारु हतला, धरतीम सी तीनी वाड़ी मां बणायु ने वाड़ीन ईचमां दुय खास झाड़का बी बणायु, एक झाड़कान फळ जलमेन जीवाय आपण्‌यो हतलो ने दीसरा झाड़कान फळ भलायन ने कुहरायन अक्‌कल आपण्‌यो हतलो।<note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="REV 2:7">उजेंता बुले 2:7</ref>; <ref loc="REV 22:14">22:14</ref></char></note><verse eid="GEN 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 2:10" />तीनी वाड़ी काजे रेलवणे करीन एक अदन सी नीकळीन एक नदी हतली ची नदी तीनी वाड़ीम वाटायन चार नानला नद्‌या बण गुया।<note caller="+" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="REV 22:2">उजेंता बुले 22:2</ref></char></note> <verse eid="GEN 2:10" /><verse number="11" style="v" sid="GEN 2:11" />पेहली नदीन नाव पीसोन छे; जी हयीत छे जी हवीला नावेन आखा देस काजे जाहा सी सोनो जड़े, तीना काजे घेरला छे। <verse eid="GEN 2:11" /><verse number="12" style="v" sid="GEN 2:12" />तीना देसेन सनो चुखलो रहे; चां मोती ने सुलेमानेन दगड़ा बी जड़े। <verse eid="GEN 2:12" /><verse number="13" style="v" sid="GEN 2:13" />दीसरी नदीन नाव गीहोन छे, जे आखा कुस देस काजे घेरवी रय। <verse eid="GEN 2:13" /><verse number="14" style="v" sid="GEN 2:14" />ने तीसरी नदीन नाव हीदकेल छे; जी असीरीया सहरेन उगवणी रवे। चोवथी नदीन नाव फरात छे।<verse eid="GEN 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 2:15" />ने यहोवा भगवान आदम काजे तेरो नाव बी आदम हतलो तीनाक वाड़ीन राखवाळी करने करीन ने चां काम करने करीन अदन वाड़ी मां मेल्‌लु। <verse eid="GEN 2:15" /><verse number="16" style="v" sid="GEN 2:16" />ने यहोवा भगवान तीना आदम काजे असु कय्‌न हुकुम आपलु: “तु वाड़ी माय्‌न काहना बी झाड़कान फळ बेफीकर्‌यु खाय सके। <verse eid="GEN 2:16" /><verse number="17" style="v" sid="GEN 2:17" />बाकुन तीना झाड़कान फळ घुण खावु, जेरो फळ भलाय ने कुहराय्‌न अक्‌कल आपण्‌यो छे; काहाकी जीने दाहड़े तु तीना फळ काजे खासी, तीनेत दाहड़े, तु छाचलीन मर जासी।”<verse eid="GEN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 2:18" />अळतेन यहोवा भगवान कह्‌यु, “आदम काजे एखलु रहणु वारु नी हय। मे एरे वाटे, एरे साते मेळ खाय ने एरी सात देय, तसों जुड़ो घड़ीस।” <note caller="+" style="x"><char style="xo" closed="false">2:18 </char><char style="xt" closed="false"><ref loc="1CO 11:9">1 कुरींथी 11:9</ref></char></note> <verse eid="GEN 2:18" /><verse number="19" style="v" sid="GEN 2:19" />ने यहोवा भगवान धरतीम सी उबजाड़ला आखा जानवर्‌या काजे ने सरगेन आखा चिरला काजे नाव पाड़ावणे करीन आदम धड़े लायु। ने आदम बाबु तींद्‌रा जे-जे नावे पाड़्‌यु, तींद्‌रा चेत नावे पड़ ज्‌या। तसों करीन चु आखा जीव-जानवर्‌यान नावे पाड़्‌यु; <verse eid="GEN 2:19" /><verse number="20" style="v" sid="GEN 2:20" />ने आदम आखा घर पाळन्‌या जानवर्‌यान, ने आखा जानवर्‌यान, ने सरगेम उडण्‌या चिरलान, नावे पाड़्‌यु, बाकुन तीनु आखा जानवर्‌या मां आदम काजे, तेरे साते मेळ खाय ने तेरी सात देय असो, काहनो बी जुड़ो नी जड़्‌यो।<verse eid="GEN 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 2:21" />ने यहोवा भगवान आदम काजे मटी नीदे सुवाड़ देदु, ने चु तेरी एक पासळी नीकाळ लेदु, ने जां सी पासळी नीकाळ्‌ळु, चां वाळु घाव पछु भर देदु।<note caller="+" style="x"><char style="xo" closed="false">2:21 </char><char style="xt" closed="false"><ref loc="1CO 11:8">1 कुरींथी 11:8</ref></char></note> <verse eid="GEN 2:21" /><verse number="22" style="v" sid="GEN 2:22" />तत्‌यार यहोवा भगवान आदम मां सी जी पासळी नीकाळ्‌ळु तीनी पासळी सी एक बायर काजे घड़्‌यु, ने तीनीक आदम धड़े लायु।<note caller="+" style="x"><char style="xo" closed="false">2:22 </char><char style="xt" closed="false"><ref loc="1TI 2:13">1 तीमुथीयुस 2:13</ref></char></note> <verse eid="GEN 2:22" /><verse number="23" style="v" sid="GEN 2:23" />आदम तेर भीणी एक-हेट्‌यु भाळीन कह्‌यु,</para>
  <para style="q1" vid="GEN 2:23">जी ते मारेन तसीत देखाये,</para>
  <para style="q1" vid="GEN 2:23">मारा हाटका मां सी नीकाळ्‌ळो हाटकत छे, ने मास मां सी नीकाळ्‌ळो मासुत छे।</para>
  <para style="q1" vid="GEN 2:23">ने छाचलीन जी धेणीम सी नीकाळ्‌ळी छे, तेरेमां जी बायर कवायसे।<verse eid="GEN 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 2:24" />तेरेमां अदमी आपसा आस्‌या-बास्‌या सी आंग्‌ये हय्‌न, आपसी बायरी पुठ्‌ये भगवान सी जुड़ाय्‌न रवसे; ने चे दुयु एक डील बण जासे।<note caller="+" style="x"><char style="xo" closed="false">2:24 </char><char style="xt" closed="false"><ref loc="MRK 10:7">मरकुस 10:7</ref>,<ref loc="MRK 10:8">8</ref>; <ref loc="EPH 5:31">ईफीसीयो 5:31</ref></char></note><verse eid="GEN 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 2:25" />आदम ने तेरी बायर वाड़ी मां हतला ने तींद्‌रा डील पर पुथल्‌या बी नी हतला, तेबी चे सरमायतेला नी।<verse eid="GEN 2:25" /></para>
  <chapter eid="GEN 2" />
  <chapter number="3" style="c" sid="GEN 3" />
  <para style="s">माणसे हुकुम तुड़े</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 3:1" />यहोवा भगवान जत्‌रा जंगली जानवर्‌या बणावलु, तीनु आखाम सी घड़सु कदर्‌यु हतलु, ने चु तीनी बायर काजे कह्‌यु, “तुहुंं वाड़ीम काहना बी झाड़कान फळ घुण खाजु।” करीन भगवान तुहुंंक छाचलीन कह्‌लु काय?<note caller="+" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="REV 12:9">उजेंता बुले 12:9</ref></char></note><verse eid="GEN 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 3:2" />ची बायर घड़साक कय, “वाड़ीन झाड़कान फळ ते हामु खाय सकजे। <verse eid="GEN 3:2" /><verse number="3" style="v" sid="GEN 3:3" />बाकुन वाड़ीन ईचमां वाळा झाड़कान फळेन बारामां भगवान असु कह्‌लु की, तुहुंं तीना झाड़कान फळ ईतरोक बी घुण खाजु। ने तीनाक छीमु बी घुण करु, नीते तुहुंं मर जासु।”<verse eid="GEN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 3:4" />तत्‌यार घड़सु तीनी बायर काजे कह्‌यु, “तुहुंं छाचलीन नी मरु! <verse eid="GEN 3:4" /><verse number="5" style="v" sid="GEN 3:5" />भगवान काजे मालुम छे की, तीने दाहड़े तुहुंं ईना फळ काजे खासु, तीनेत दाहड़े तुंद्‌रा डुळा उघड़ी जासे, ने तुहुंंक भलायन ने कुहराय्‌न अक्‌कल जड़ जासे, ने भगवानेन तसा बण जासु।”<verse eid="GEN 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 3:6" />कुहर्‌या घड़सान वात सामळीन बायर तीना झाड़का भीणी देखी: ती तीनीक चो झाड़को बेसको वारु देखाये। तीनीक असो लाग्‌यो ईना झाड़कान फळ ते खाणे वाटे वारु सवादो लाग्‌से, ने अक्‌कल जड़से करीन वारु रवसे। अळी ची तीना झाड़कान फळ तुड़ीन खादी, ने तेरा घरवाळाक बी देदी ने चु बी खादु। <verse eid="GEN 3:6" /><verse number="7" style="v" sid="GEN 3:7" />तत्‌यार तीनु दुयु जणान डुळा उघड़ी गुया, ने तीनुक मालुम पड़्‌यो की, आपणु पुथल्‌या पेहरला नी हय, ने चे अंजीर नावेन झाड़कान पान्‌टा तुड़ी तुड़ीन आपसा वाटे कुस्‌टी बणाय लेदा।<verse eid="GEN 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 3:8" />सांती वेळाय चे सामळ्‌या की यहोवा भगवान बगीचा मां फीरतेलु, ती चे तीनाक देखीन झाड़का मां डुकाय ज्‌या। <verse eid="GEN 3:8" /><verse number="9" style="v" sid="GEN 3:9" />तत्‌यार यहोवा भगवान आयड़ीन आदम काजे पुछ्‌यु, “तु कां छे?”<verse eid="GEN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 3:10" />चु कह्‌यु, “वाड़ी मां तुसेक आवतेलु सामळीन मे बीहीन डुकाय गुयलु, काहाकी मेसेक मालुम पड़ गुयलो की, मे पुथल्‌या नी पेहरी र्‌यु।”<verse eid="GEN 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 3:11" />तत्‌यार भगवान असु पुछ्‌यु, “तुसेक कुण कह्‌यो की, तु पुथल्‌या पेहरलु नी हय? मे तुसेक तीना झाड़कान फळ घुण खाजी कह्‌लु, तीना झाड़कान फळ तु खादलु काय?”<verse eid="GEN 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 3:12" />आदम असु कह्‌यु, तु हीनी बायर काजे बणायन। मार वाटे लावलु चीत बायर तीनु झाड़कान फळ खाणे करीन मेसेक आपी ने मे खाय लेदु।<verse eid="GEN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 3:13" />तत्‌यार यहोवा भगवान मेसेक असु कह्‌यु तु ज काय कर्‌यु?</para>
  <para style="p" vid="GEN 3:13">ची बायर असी कय घड़सु मेसेक ठगीन खावाड़्‌यु ने मे खाय लेदी।<note caller="+" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="ROM 7:11">रोमीयो 7:11</ref></char></note><verse eid="GEN 3:13" /></para>
  <para style="s">भगवानेन नीयाव</para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 3:14" />तत्‌यार यहोवा भगवान घड़साक असु कह्‌यु, “तु असु कर्‌यु करीन तु आखा पाळन्‌या ने जंगली जानवर्‌या सी अदु गरा वाळु छे; तु पेटेन भुरसे चालसी, ने मरता लग धुळु चाट्‌या करसी। <verse eid="GEN 3:14" /><verse number="15" style="v" sid="GEN 3:15" />ने तु ने बायर आंबा-सांबा लड़ाय करसु ने अळी तारी अवल्‌यात ने हीनी बायरीन अवल्‌यात बी आंबा-सांबा लड़ाय करसे बायरीन अवल्‌यात जे पयदा हवसे चे तारा मुणका काजे छुन्‌दसे ने तु तींद्‌री अड़ी काजे चावसी।”<verse eid="GEN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 3:16" />बाकुन बायरी काजे भगवान असु कह्‌यु, “मे तारो दुख ने तारा पुर्‌या पयदा हवसे तत्‌यार तारा दुख काजे बेसकु बड़ावीस; तु दुख झेलीन पुर्‌या पयदा करसी; ने तारी हर घरवाळा भीणी रवसे, ने चु तार पर हक जमाड़से।”<verse eid="GEN 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 3:17" />अळतेन भगवान आदम काजे कह्‌यु, “मे पेहलुत हुकुम आपीन कहलु की, तु तीना झाड़कान फळ घुण खाय, तेबी तु तारी बायरीन वात मानीन तीना झाड़कान फळ खाय लेदु,ने धरती तार वाटे गरा वाळी छे। ने तु मरता लग हेरेम काठी कमाय करीन खाणो खाया करसी। <verse eid="GEN 3:17" /><verse number="18" style="v" sid="GEN 3:18" />जी धरती तार वाटे काटाळस्‌या ने घाड़स्‌या उगाड़से। तेबी, तु खेतेन कमाय मां सी खाया करसी। <verse eid="GEN 3:18" /><verse number="19" style="v" sid="GEN 3:19" />तु खाणा वाटे काठी कमाय करीन उबाय जासी। ने असु काम करतु-करतु तु मर जासी। मे तुसेक धुळाम सी घड़लु, ने धुळात मां तु भेसकाय जासी।”<verse eid="GEN 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 3:20" />ने आदम असु वीच्‌यार्‌यु, ने अळी चु आपसी बायरीन नाव हवा पाड़्‌यु; काहाकी जी ते धरती पर रहण्‌या आखा जीवतेला माणसेन माय बणसे। <verse eid="GEN 3:20" /><verse number="21" style="v" sid="GEN 3:21" />ने यहोवा भगवान आदम ने तेरी बायर काजे चामड़ान पुथल्‌या पेहराय देदु।<verse eid="GEN 3:21" /></para>
  <para style="s">आदम ने हवा काजे वाड़ी मां सी नीकाळनु</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 3:22" />तत्‌यार यहोवा भगवान कह्‌यु, “देख, जु माणुस भलाय ने कुहरायन अक्‌कल आपण्‌या झाड़कान फळ खायन हामरे माय्‌न एक जणान तसु हय गुयलु छे, कांखुर माय्‌न असो नी हय जाय की, जु आपसे हाते करीन जीवाय्‌न झाड़कान फळ तुड़ीन खाय लेय ने असु करीन चु जलम करता गुनाळुत जीवतेलु रय जाय।” <verse eid="GEN 3:22" /><verse number="23" style="v" sid="GEN 3:23" />हेरेसी यहोवा भगवान तीनाक धुळाम सी बणावलु, तीना धुळा मां खेती मां कमाय करने करीन तीनाक अदन मुलुकेन वाड़ीम सी बायर भेळु बाहर मकली देदु। <verse eid="GEN 3:23" /><verse number="24" style="v" sid="GEN 3:24" />यहोवा भगवान तीनाक बाहर मकली देदु, ने जीवाय्‌न झाड़कान राखवाळी करने करीन अदन मुलुकेन वाड़ी मां करुब टुळान आपसा बेसका राखवाळ्‌या काजे ने झाड़कान च्‌यारे-मेर फीरनी हळो-हळो धपतेली तलवार काजे मेल देदु।<verse eid="GEN 3:24" /></para>
  <chapter eid="GEN 3" />
  <chapter number="4" style="c" sid="GEN 4" />
  <para style="s">केन ने हाबील</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 4:1" />जत्‌यार आदम आपसी बायर हवा साते सोवसार कर्‌यु, ती ची भारीस हय ने तेरु एक पुर्‌यु हयु, ने ची कय, “यहोवा भगवानेन मदत सी मारु एक पुर्‌यु हयु।” ने ची पुर्‌यान नाव केन पाड़ी। <verse eid="GEN 4:1" /><verse number="2" style="v" sid="GEN 4:2" />अळी हवान एक दीसरु पुर्‌यु बी हयु, तेरो नाव हाबील पाड़्‌या, ने चु गाडरा चारन्‌यु बण गुयु, बाकुन केन ते खेती मां कमाय करनेवाळु कीरसान बण गुयु। <verse eid="GEN 4:2" /><verse number="3" style="v" sid="GEN 4:3" />थुड़ाक दाहड़ा हय ज्‌या ने मेर काटणेन टेम आय ती केन आपसी मेरेम सी थुड़ोक लीन यहोवा भगवान धड़े भेट चहड़ायु।<note caller="+" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="JHN 1:11">युहन्‌ना 1:11</ref></char></note> <verse eid="GEN 4:3" /><verse number="4" style="v" sid="GEN 4:4" />ने हाबील बी आपसा गाडरान पेहला पीला माय्‌न मातला पीला काजे मार्‌यु, ने तेरेम सी वारलु काळजो, ने चरबी ने सीकार चड़ायु; ने यहोवा भगवान हाबील काजे ने तेरा भेट काजे मानी लेदु।<note caller="+" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="HEB 11:4">ईब्‌रानीयो 11:4</ref></char></note> <verse eid="GEN 4:4" /><verse number="5" style="v" sid="GEN 4:5" />बाकुन भगवान केन काजे ने तेरी भेट काजे नी मान्‌यु। तत्‌यार केन बेसकु रीसाय पड़्‌यु, ने केनेन मुंहडो उतरी गुयो। <verse eid="GEN 4:5" /><verse number="6" style="v" sid="GEN 4:6" />तत्‌यार यहोवा भगवान केन काजे पुछ्‌यु, “तु काहा रीसवाय रयु? ने तार नुरपाणी काहा उतरी रयो?” <verse eid="GEN 4:6" /><verse number="7" style="v" sid="GEN 4:7" />कदी तु भलो करसी ती मे भेट काजे नी मानो काय? छाचलीन मानीस। ने कदी तु भलो नी करे, ती पाप बारना पर बस रवे, ने तारी हय तेर भीणी रवसे, ने तु तेरे पर हक जमाड़जी।<verse eid="GEN 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 4:8" />तत्‌यार केन आपसा भाय हाबील काजे काय कह्‌यु; ने जत्‌यार चे खयड़ा मां हतला तत्‌यार केन आपसा भाय हाबील काजे उचकाणुन दीन मार नाख्‌यु।<verse eid="GEN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 4:9" />तत्‌यार यहोवा भगवान केन काजे पुछ्‌यु, “तारु भायस हाबील कां छे?”</para>
  <para style="p" vid="GEN 4:9">तत्‌यार केन जपाप आप्‌यु, “काय जाणु?” काय मे मारा भायसेन गुवाळी करो काय?<verse eid="GEN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 4:10" />तत्‌यार यहोवा भगवान केन काजे कह्‌यु, “तारा भायसेन लुही धरतीम सी आयड़ीन मारे धड़े वीन्‌ती-दुवा करने बाजी रयो!” तु असु काहा करलु?<note caller="+" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="HEB 12:24">ईब्‌रानीयो 12:24</ref></char></note> <verse eid="GEN 4:10" /><verse number="11" style="v" sid="GEN 4:11" />हेरेसी हय धरती तारा भायसेन लुही पीणे करीन आपसान मुंहडो उगाड़ लेदी, हेरेसी तु धरती भीणी सी गरा वाळु छे। <verse eid="GEN 4:11" /><verse number="12" style="v" sid="GEN 4:12" />पछला दाहड़ा मां तारी मेर वारु पाकी, बाकुन हय सी तारी मेर वारु नी पाके, धरती पर तुसेक घर बणायन नी रवाये ने उजाड़्‌यु जां वां भटकायतु फीर्‌या करसी।<verse eid="GEN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 4:13" />तत्‌यार केन यहोवा भगवान सी कह्‌यु, जु डंड बेसकु भारी छे, मेसेक नी सेण हवे। <verse eid="GEN 4:13" /><verse number="14" style="v" sid="GEN 4:14" />सामळ, तु मेसे काजे खेत मां सी नीकाळ देदु, ने मे तार सी छेटु रय्‌स, ने धरती पर मेसेक घर बणाय्‌न नी रवाये ने मे उजाड़्‌यु जां वां भटकायतु फीर्‌या करीस, ने जु काहनुक बी मेसेक देख्‌से चु मेसेक मार नाखसे।<verse eid="GEN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 4:15" />तत्‌यार यहोवा भगवान केन काजे कह्‌यु, “मे तु कह्‌यु तसों नी हवणे दम। कदी काहनुक तुसेक मारसे, ती मे तीनाक सात गुणा डंड आपीस।” ने अळी यहोवा भगवान केन पर एक सहलाणीन छाप लगाड़ देदु। जु सहलाणीन छाप जो देखाड़तेलु की, केन काजे काहनु नी मारनु चाहजे। <verse eid="GEN 4:15" /><verse number="16" style="v" sid="GEN 4:16" />तत्‌यार केन यहोवा भगवानेन चां सी जात रयु, ने नोद नावेन देस मां रवणे बाजी गुयु, जो अदन मुलुकेन उगवणो हतलो।<verse eid="GEN 4:16" /></para>
  <para style="s">केनेन अवल्‌यात</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 4:17" />जत्‌यार केनेन ईयाव हय-ज्‌यु ने चु आपसी बायरी साते सोवसार कर्‌यु, ने ची भारीस हय गुय, ने तेरु एक पुर्‌यु हयु, ने तेरो नाव हनोक पाड़्‌या। ने केन एक सहर बसाड़्‌यु ने तीना सहरेन नाव बी आपसा पुर्‌यान नाव हनोक पाड़ देदु। <verse eid="GEN 4:17" /><verse number="18" style="v" sid="GEN 4:18" />हनोक सी ईराद पयदा हयु, ने ईराद सी महुयायेल पयदा हयु, ने महुयायेल सी मतुसायेल पयदा हयु, ने मतुसायेल सी लेमेक पयदा हयु। <verse eid="GEN 4:18" /><verse number="19" style="v" sid="GEN 4:19" />लेमेक दुय बायरा बणाय लेदु: तींद्‌रेम सी एकेन नाव आदा, ने दीसरीन नाव सील्‌ला हतलो। <verse eid="GEN 4:19" /><verse number="20" style="v" sid="GEN 4:20" />आदानेन एक पुर्‌यु हयु, तेरो नाव याबाल पाड़्‌या। चु अगु जाय्‌न कळीन आखान पेहलु ढुरे पाळन्‌यु बण्‌यु। ने ढुरे काजे पाळने करीन जागे-जागे रवणे करीन तम्‌बु मां रवतेलु; ने चु तम्‌बु मां रवण्‌यान ने ढुरे पाळन्‌यान डाहलु बास कह्‌वाये। <verse eid="GEN 4:20" /><verse number="21" style="v" sid="GEN 4:21" />ने आदानेन बायरीन दीसरु पुर्‌यु हयु। तेरो नाव युबाल पाड़्‌या। जु युबाल्‌यान भायस हतलु। अगु जाय्‌न युबाल बासुरी ने पावळी बणायु ने कळीम आखान पेहले वाजाड़नेन काम करने बाजी गुयु। ने चु पावळी वाजाड़न्‌यान डाहलु बास कह्‌वाये। <verse eid="GEN 4:21" /><verse number="22" style="v" sid="GEN 4:22" />सील्‌ला बायरीन बी एक पुर्‌यु हयु। तीना पुर्‌यान नाव तुबलकेन पाड़्‌या। तुबलकेन अगु जाय्‌न पीतळेन ने लुहड़ान हत्‌यार बणावणेन काम करतेलु। चु तुबेलकेन्‌यु लुहार्‌यान डाहलु-बाबु कहवाये। ने ईना तुबलकेन एक बहणीस हतली, तेरो नाव नामा हतलो।<verse eid="GEN 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 4:23" />एक दाहड़ु लेमेक आपसा बायरा अगळ असु कहीन मटाय करने बाज-ज्‌यु;</para>
  <para style="q1" vid="GEN 4:23">“ए आदा ने सील्‌ला, मारी वात सामळु; ए लेमेकेन लाड्‌या, मारी वात धीयान दीन सामळु:</para>
  <para style="q1" vid="GEN 4:23">एक अदमी मार भीणी जुर करीन मारे देदु ने मेसेक घाव वाळु कर देदु,</para>
  <para style="q1" vid="GEN 4:23">मे तेरे पछु वाळ देदु। ने तीना जुवान्‌या काजे मे मारीत नाख्‌यु।<verse eid="GEN 4:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="GEN 4:24" />भगवान कहलु, जु कुय केन काजे मारसे तीनाक ते सात गुणा डंड आपणु पड़से,</para>
  <para style="q1" vid="GEN 4:24">बाकुन मे कह, जु कुय मेसेक मारनेन करसे, मे लेमेक काजे सत्‌तर ने सात गुणा डंड आपीस।”<verse eid="GEN 4:24" /></para>
  <para style="s">सेत ने एनोस</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 4:25" />आदम आपसी बायर हवा साते अळी सोवसार कर्‌यु, ने ची भारीस हय गुय, ने तेरु एक अळी पुर्‌यु हयु, ने ची तेरो जो कय्‌न नाव सेत पाड़ी की, भगवान मेसे काजे हाबीलेन बदले एक अवल्‌यात बी आप्‌यु, तीना हाबील काजे केन मारीन नाख देद्‌लु।<note caller="+" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="GEN 5:3-4">उबजाणनी किताप 5:3-4</ref></char></note> <verse eid="GEN 4:25" /><verse number="26" style="v" sid="GEN 4:26" />अळी सेत आपसी बायर साते सोवसार कर्‌यु, ने तेरु एक पुर्‌यु हयु। तेरो नाव चे एनोस पाड़्‌या। तीनी टेमे सी माणसे भगवान काजे यहोवा कय्‌न तेरे सी दुवा करने बाजी गुया।<verse eid="GEN 4:26" /></para>
  <chapter eid="GEN 4" />
  <chapter number="5" style="c" sid="GEN 5" />
  <para style="s">आदमेन अवल्‌यातेन कुळी</para>
  <para style="r">(<ref loc="1CH 1:1-4">1 ईतीहास 1:1-4</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 5:1" />आदमेन कुळी जी छे, तीने दाहड़े भगवान माणसेक बणायु, तीने दाहड़े तीनाक आपसान सीका मां बणायु। <verse eid="GEN 5:1" /><verse number="2" style="v" sid="GEN 5:2" />सुरु मां चु एक अदमीक ने एक बायर काजे बणायु। तीने दाहड़े भगवान तीनु काजे बणायु, तीने दाहड़े भगवान तीनु काजे संयबरकत आपलु; ने तींद्‌रो नाव “आदम पाड़लु।”<note caller="+" style="f"><char style="fr" closed="false">5:2 </char><char style="ft" closed="false">एक माणसेन नाव हतलो</char></note> <verse eid="GEN 5:2" /><verse number="3" style="v" sid="GEN 5:3" />जत्‌यार आदमेन उमर एक सोव तीस साल हय, जत्‌यार तेरे साहरे तेरी बायरीन एक पुर्‌यु हयु। ने चु पुर्‌यु आदमेन सीका मां देखाय तेलु ने आदम तीना पुर्‌यान नाव सेत पाड़्‌यु। <verse eid="GEN 5:3" /><verse number="4" style="v" sid="GEN 5:4" />सेत पयदा हय गुयु, ने अळी आदम आठ सोव साल लग जीवतेलु रह्‌यु, ने तीनी टेमे तेरे साहरे तेरी बायरीन बेसका पुर्‌या पारी हया। <verse eid="GEN 5:4" /><verse number="5" style="v" sid="GEN 5:5" />असु करीन आदम नव सोव तीस साल लग जीवतेलु रह्‌यु तेरे पछेन चु मर गुयु।<verse eid="GEN 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 5:6" />जत्‌यार सेतेन उमर एक सोव पांच साल हवी, तत्‌यार तेरे साहरे तेरी बायरीन एक पुर्‌यु हयु; ने तेरो नाव एनोस पाड़्‌या। <verse eid="GEN 5:6" /><verse number="7" style="v" sid="GEN 5:7" />एनोस पयदा हय गुयु, ने अळी सेत आठ सोव सात साल जीवतेलु रह्‌यु, ने तीनी टेमे तेरे साहरे तीनी बायरीन बेसका पुर्‌या पारी हया। <verse eid="GEN 5:7" /><verse number="8" style="v" sid="GEN 5:8" />ने असु सेत नव सोव बारे साल लग जीवतेलु रह्‌यु, ने तेरे पछेन चु मर गुयु।<verse eid="GEN 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 5:9" />जत्‌यार एनोस दस कम सोव सालेन हयु, तत्‌यार तेरे साहरे तेरी बायरीन एक पुर्‌यु हयु, ने चे तेरो नाव केनान पाड़्‌या। <verse eid="GEN 5:9" /><verse number="10" style="v" sid="GEN 5:10" />केनान पयदा हयु, ने अळी एनोस आठ सोव पंद्‌रे साल जीवतेलु रह्‌यु, ने तीनी टेमे तेरे साहरे तेरी बायरीन दीसरा पुर्‌या पारी पयदा हया। <verse eid="GEN 5:10" /><verse number="11" style="v" sid="GEN 5:11" />ने असु करीन एनोस नव सोव पांच साल लग जीवतेलु रह्‌यु, ने अळी चु मर गुयु।<verse eid="GEN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 5:12" />जत्‌यार केनान उमर सत्‌तर साल हतली, तत्‌यार तेरे साहरे तेरी बायरीन एक पुर्‌यु हयु, चे तेरो नाव महललेल पाड़्‌या। <verse eid="GEN 5:12" /><verse number="13" style="v" sid="GEN 5:13" />महललेल पयदा हय गुयु ने अळी केनान आठ सोव चाळीस साल लग जीवतेलु रह्‌यु, ने तीनी टेमे तेरे साहरे तेरी बायरीन दीसरा पुर्‌या पारी हया। <verse eid="GEN 5:13" /><verse number="14" style="v" sid="GEN 5:14" />ने असु करीन केनान नव सोव दस साल लग जीवतेलु रह्‌यु, ने अळी चु मर गुयु।<verse eid="GEN 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 5:15" />जत्‌यार महललेल्‌यान उमर साठ ने पांच साल हतली तत्‌यार तेरे साहरे बायरीन एक पुर्‌यु हयु ने चे तेरो नाव येरेद पाड़्‌या। <verse eid="GEN 5:15" /><verse number="16" style="v" sid="GEN 5:16" />येरेद पयदा हय गुयु, ने अळी महललेल आठ सोव तीस साल लग जीवतेलु रह्‌यु, ने तीनी टेमे तेरे साहरे तेरी बायरीन बेसका पुर्‌या पारी हया। <verse eid="GEN 5:16" /><verse number="17" style="v" sid="GEN 5:17" />असु महललेल पांच कम नव सोव साल लग जीवतेलु रह्‌यु, ने पछेन चु मर गुयु।<verse eid="GEN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 5:18" />जत्‌यार येरेद एक सोव साठ ने दुय साल लग जीवतेलु रह्‌यु, तत्‌यार तेरे साहरे तेरी बायरीन एक पुर्‌यु हयु, ने चे तेरो नाव हनोक पाड़्‌या। <verse eid="GEN 5:18" /><verse number="19" style="v" sid="GEN 5:19" />हनोक पयदा हय गुयु ने अळी येरेद आठ सोव साल लग जीवतेलु रह्‌यु, तीनी टेमे तेरे साहरे तेरी बायरीन बेसका पुर्‌या पारी हया। <verse eid="GEN 5:19" /><verse number="20" style="v" sid="GEN 5:20" />ने असु करीन येरेद नव सोव साठ ने दुय साल लग जीवतेलु रह्‌यु, ने चु मर गुयु।<verse eid="GEN 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 5:21" />जत्‌यार हनोकेन उमर साठ ने पांच साल हय तत्‌यार तेरे साहरे तेरी बायरीन एक पुर्‌यु हयु, ने चे तेरो नाव मतुसेल पाड़्‌या। <verse eid="GEN 5:21" /><verse number="22" style="v" sid="GEN 5:22" />मतुसेल पयदा हय गुयु, ने अळी हनोक बी तीन सोव साल लग भगवान पुठ्‌ये रय्‌न जीयु, तीनी टेमे हनोकेन साहरे तेरी बायरीन बेसका पुर्‌या पारी हया। <verse eid="GEN 5:22" /><verse number="23" style="v" sid="GEN 5:23" />असु करीन हनोक तीन सोव साठ ने पांच साल लग जीवतेलु रह्‌यु। <verse eid="GEN 5:23" /><verse number="24" style="v" sid="GEN 5:24" />हनोक भगवान पुठ्‌ये-पुठ्‌ये चालतेलु, ने अळी भगवान तीनाक गायब करीन जीवतेलु हाकली ली गुयु।<note caller="+" style="x"><char style="xo" closed="false">5:24 </char><char style="xt" closed="false"><ref loc="HEB 11:5">ईब्‌रानीयो 11:5</ref></char></note><verse eid="GEN 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 5:25" />जत्‌यार मतुसेलेन उमर एक सोव ने अस्‌सी ने सात सालेन हतली, तत्‌यार तेरे साहरे तेरी बायरीन एक पुर्‌यु हयु, चे तीना पुर्‌यान नाव लेमेक पाड़्‌या। <verse eid="GEN 5:25" /><verse number="26" style="v" sid="GEN 5:26" />लेमेक पयदा हय गुयु, ने अळी मतुसेल्‌यु सात सोव बय्‌यालीस साल लग जीवतेलु रह्‌यु, ने तीनी टेमे तेरे साहरे तेरी बायरीन अळी बी पुर्‌या पारी हया। <verse eid="GEN 5:26" /><verse number="27" style="v" sid="GEN 5:27" />ने असु करीन मतुसेल्‌यान उमर नव सोव ने एक कम सत्‌तर साल लग जीवतेलु रह्‌यु, ने अळी चु मर गुयु।<verse eid="GEN 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 5:28" />जत्‌यार लेमेकेन उमर अठ्‌ठारे कम दुय सोव साल हतली, तत्‌यार तेरु एक पुर्‌यु हयु। <verse eid="GEN 5:28" /><verse number="29" style="v" sid="GEN 5:29" />हयु असु कयन तेरो नाव नुह पाड़्‌यु, “यहोवा भगवान जु धरती काजे सराप देदलु छे, तेरे बारामां जु पुर्‌यु हामरा काम मां, ने तीना काठला काम मां जो हामु करजे तीना काम काजे हामु सांती देसु।” <verse eid="GEN 5:29" /><verse number="30" style="v" sid="GEN 5:30" />ने नुह पयदा हय गुयु, ने अळी चु लेमेक पांच कम सोव साल जीवतेलु रह्‌यु, ने तीनी टेमे तेरा बेसका पुर्‌या पारी हया। <verse eid="GEN 5:30" /><verse number="31" style="v" sid="GEN 5:31" />ने असु करीन लेमेक सात सोव ने तीन कम अस्‌सी साल जीवतेलु रह्‌यु, ने अळी चु मर गुयु।<verse eid="GEN 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 5:32" />ने नुह पांच सोव सालेन हयु; ने नुह सी सेम ने हाम हया, ने येपेतेन पयदावारी हयी।<verse eid="GEN 5:32" /></para>
  <chapter eid="GEN 5" />
  <chapter number="6" style="c" sid="GEN 6" />
  <para style="s">माणसेन भुंडला कामे</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 6:1" />धरती पर माणसेन जाती बेसकी हय गुय। ने तींद्‌री पुरे बी बेसकी हवी। <verse eid="GEN 6:1" /><verse number="2" style="v" sid="GEN 6:2" />तत्‌यार भगवानेन पुर्‌या हतला, ने चे माणसे पुरे काजे देखीन वीच्‌यार्‌या की जे ते बेसकु वारु देखाये, करीन चे जे वारु लागे तीनु पुरे सी ईयाव करीन राख लेदा। <verse eid="GEN 6:2" /><verse number="3" style="v" sid="GEN 6:3" />तत्‌यार भगवान कह्‌यु, “मारो मन माणसे सी जलम दुख मां नी रहे, काहाकी माणुस ते डीलुत छे; तेरी उमर एक सोव वीस सालेन रवसे।” <verse eid="GEN 6:3" /><verse number="4" style="v" sid="GEN 6:4" />तीनु दाहड़ा मां धरती पर आखा सी मटा ताकुत वाळा माणसे रवतेला; ने तेरे पछेन भगवानेन पुर्‌यु माणसेन पुर्‌या धड़े आयु तत्‌यार तेर सी जे पुर्‌या हया चे आखा सी ताकुत वाळा हतला, ने तींद्‌रो नाव पेहला जमाना सी हवतो आय रयो।<verse eid="GEN 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 6:5" />यहोवा भगवान जो देख्‌यु की, धरती पर माणसेन पाप बड़ गुयु, ने तींद्‌रा मन मां जु बी वीच्‌यार आवे, चु वीच्‌यार कुहर्‌युत आवे।<note caller="+" style="x"><char style="xo" closed="false">6:5 </char><char style="xt" closed="false"><ref loc="PSA 53:2">भजन सहीता 53:2</ref></char></note> <verse eid="GEN 6:5" /><verse number="6" style="v" sid="GEN 6:6" />हेरेसी यहोवा भगवान धरती पर माणुस जात काजे बणायन बेसकु दुखी हयु। <verse eid="GEN 6:6" /><verse number="7" style="v" sid="GEN 6:7" />तत्‌यार यहोवा भगवान वीच्‌यार कर्‌यु, “मे ईनुक नी बणावतु ती वारु रवतो, हय मे तीनु माणसे काजे बणावलु छे, तीनु माणसे काजे धरती पर सी सार दीस, ने आखा जानवर्‌या ने घीसड़ायन चालन्‌या जानवर्‌या, ने एकेक जीव काजे ने सरगेन चिरला काजे सार दीस।” <verse eid="GEN 6:7" /><verse number="8" style="v" sid="GEN 6:8" />बाकुन तेबी भगवान काजे खुस करन्‌यु एक माणुस हतलु; चु नुह बाबु हतलु। हेरेसी यहोवा भगवान नुह पर गीण-दया बणीन रय।<verse eid="GEN 6:8" /></para>
  <para style="s">नुह</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 6:9" />नुहन घराणान काहणी जी छे। नुह धरमी माणुस हतलु, ने तीनी टेमे जत्‌रा बी माणसे हतला, तीनु माणसे मां चु ईमानदार हतलु, ने चु भगवानेन हजरी मां रय्‌न जीवतेलु। <verse eid="GEN 6:9" /><verse number="10" style="v" sid="GEN 6:10" />नुहान तीन पुर्‌या हतला, सेम ने हाम ने येपेत। <verse eid="GEN 6:10" /><verse number="11" style="v" sid="GEN 6:11" />तीनी टेमे धरती भगवानेन नींगा मां बीगड़ी रहली, ने जागे-जागे खुन-खराबु हय रहलु। <verse eid="GEN 6:11" /><verse number="12" style="v" sid="GEN 6:12" />ने भगवान धरती भीणी भाळ्‌यु, ती देख्‌यु की जागे-जागे खुन-खराबु हय रहलु, माणसे पापी हय रहला ने धरती पर माणसे आपणो-आपणो जीवन बीगाड़ देदा।<verse eid="GEN 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 6:13" />तत्‌यार भगवान नुह काजे कह्‌यु, “आखा माणसे धरती पर रीस ने खुन-खराबु कर र्‌या।” तेरेमां मे तीनु आखा जीवतेला जीव काजे धरती पर सी सार दीस। <verse eid="GEN 6:13" /><verse number="14" style="v" sid="GEN 6:14" />ने तु गोपेर नावेन झाड़कान लाकड़ान ढंड्‌यो बणाय ले। तीना ढंड्‌या मां खुणा बणावजी, ने माहे ने बाहर डमर्‌ये सी नीप देजी। <verse eid="GEN 6:14" /><verse number="15" style="v" sid="GEN 6:15" />“ने ढंड्‌या काजे असो बणावजी: चो तीन सोव हात नांबो, ने पचास हात चवड़ो, ने तीस हात उचो हवणु। <verse eid="GEN 6:15" /><verse number="16" style="v" sid="GEN 6:16" />ढंड्‌यो दुय माळ्‌यो बणावजी: तेरेम चे हीस्‌सा रवसे। नेचलु हीस्‌सु, ईचमाळ्‌ळु हीस्‌सु, ने उपेरलु हीस्‌सु। ढंड्‌या पर ढुपु बी बणावजी, ने ढुपा सी एक हात नेची खीड़की बणावजी। ने ढंड्‌यान एक धड़े बारनो बणावजी। <verse eid="GEN 6:16" /><verse number="17" style="v" sid="GEN 6:17" />तुसे काजे मे जो कय र्‌यु चो समज। मे धरती पर बेसकु-मटु मुसळ-धार्‌यु पाणी पाड़ीस, ने सरगेन नेचे आखा जीव-जानवर्‌या काजे सार दीस: ने धरती पर वाळा आखा जीवतेला जीव, मर जासे। <verse eid="GEN 6:17" /><verse number="18" style="v" sid="GEN 6:18" />बाकुन मे तारे साते वायदु करलु: तेरेमां तु आपसा पुर्‌या ने उहड़ीस्‌या ने आपसी बायर भेळे ढंड्‌या मां भराय जाजी। <verse eid="GEN 6:18" /><verse number="19" style="v" sid="GEN 6:19" />ने धरती पर जतरा बी जीव-जानवर्‌या छे, तींद्‌रो एकेक जुड़ो ली आवजी। मतलब एक नर ने एक नारी काजे ढंड्‌या मां भर लेजी, काहाकी, चे तारे पुठी जीवतेला रहे करीन। <verse eid="GEN 6:19" /><verse number="20" style="v" sid="GEN 6:20" />आखी जातीन चिरला मां सी ने आखी जातीन जानवर्‌याम सी, ने आखी जातीन धरती पर घीसड़ायन चालन्‌या जानवर्‌याम सी दुय-दुय नर-नारी ढंड्‌या मां जीवतेला भर लेजी। <verse eid="GEN 6:20" /><verse number="21" style="v" sid="GEN 6:21" />धरती पर वाळी आखी भातीन खाणेन चीज तारे वाटे ने जानवर्‌या वाटे ढंड्‌या मां भर लेजी।” <verse eid="GEN 6:21" /><verse number="22" style="v" sid="GEN 6:22" />ने भगवानेन हुकुम मानीन भगवान कहलु तसुत नुह कर्‌यु।<verse eid="GEN 6:22" /></para>
  <chapter eid="GEN 6" />
  <chapter number="7" style="c" sid="GEN 7" />
  <para style="s">छळो-छळो मुसळ धार्‌यु पाणी पड़्‌यु</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 7:1" />जत्‌यार नुह ढंड्‌यो बणाय लेदु तत्‌यार मालीक कह्‌यु, “तु आपसा घरन्‌या भेळुत ढंड्‌याम भराय जाजी; काहाकी मे ईनी टेमेन माणसे मां तु अतरुत धरमी माणुस छे। <verse eid="GEN 7:1" /><verse number="2" style="v" sid="GEN 7:2" />ने तार साते आखी जातीन चुखला जानवर्‌याम सी ते तु सात-सात जुड़ा मतलब नर ने मादा नेवाड़जी: बाकुन जे जानवर्‌या चुखला नी हय, तींद्‌रेम सी दुय-दुय लेजी, ने चे बी नर ने मादा: <verse eid="GEN 7:2" /><verse number="3" style="v" sid="GEN 7:3" />ने उपर उडण्‌या चिरला मां सी, सात-सात जुड़ा मतलब नर ने मादा नेवाड़जी, काहाकी तींद्‌रा अगा अवल्‌यात सींगळीन आखी धरती पर जीवतेला रवे। <verse eid="GEN 7:3" /><verse number="4" style="v" sid="GEN 7:4" />काहाकी हंय सी सात दाहड़ा वीत जासे ने पछेन मे धरती पर चाळीस दाहड़ा ने चाळीस रात लग पाणी पाड़तु रवीस ने जतरा बी जीव काजे मे बणावलु छे तीनु आखाक धरती पर सी सार दीस।” <verse eid="GEN 7:4" /><verse number="5" style="v" sid="GEN 7:5" />ने नुह बी जसु यहोवा भगवान कह्‌यु, तसुत कर्‌यु।<verse eid="GEN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 7:6" />जत्‌यार नुहान छव साल हतला, ती धरती पर मुसळ-धार्‌यु पाणी पड़्‌लु। <verse eid="GEN 7:6" /><verse number="7" style="v" sid="GEN 7:7" />नुह आपसा पुर्‌या, आपसी बायर ने उहड़ीस्‌याक लीन बचणे करीन ढंड्‌याम भरायु। <verse eid="GEN 7:7" /><verse number="8" style="v" sid="GEN 7:8" />ने चुखला, ने नी-चुखला दुयु भातीन जीव-जानवर्‌याक ने चिरला, <verse eid="GEN 7:8" /><verse number="9" style="v" sid="GEN 7:9" />ने जसु भगवान नुह काजे हुकुम आपीन कहलु तसुत भुयमां घीसड़ायन चालन्‌या जीव-जानवर्‌या माय्‌न बी दुय-दुय जुड़ा मतलब नर ने नारी ढंड्‌या मां नुह पुठ्‌ये भर्‌यु। <verse eid="GEN 7:9" /><verse number="10" style="v" sid="GEN 7:10" />सात दाहड़ा हय ज्‌या ती मुसळ-धार पाणी धरती पर पड़ने चालु हय ज्‌यु। <verse eid="GEN 7:10" /><verse number="11" style="v" sid="GEN 7:11" />दुसरा महनान सत्‌रवे दाहड़े, जत्‌यार नुहान उमर छव साल हय ज्‌या तीने दाहड़े उंडला दरीयान झीरेन उकाळा नीकळी ज्‌या, ने सरगेन पाणी बारना उघड़ी ज्‌या। <verse eid="GEN 7:11" /><verse number="12" style="v" sid="GEN 7:12" />ने चाळीस दाहड़ा ने चाळीस रात एक सारकु धरती पर मुसळ-धार पाणी पड़तु रह्‌यु। <verse eid="GEN 7:12" /><verse number="13" style="v" sid="GEN 7:13" />ती तीनेत दाहड़े नुह आपसा पुर्‌या सेम, हाम ने येपेत ने आपसान बायर ने तीनु उहड़ीस काजे लीन, <verse eid="GEN 7:13" /><verse number="14" style="v" sid="GEN 7:14" />ने तींद्‌रे भेळे हर एक आखी जातीन जंगली जानवर्‌या ने एक-एक जातीन घर पाळन्‌या जीव जानवर्‌या एक-एक जातीन आखा घीसड़ायन चालन्‌या जीव-जानवर्‌या, ने एक-एक जातीन उडणे वाळा आखा चिरला, ढंड्‌याम गुया। <verse eid="GEN 7:14" /><verse number="15" style="v" sid="GEN 7:15" />जतरा बी जीव-जानवर्‌या नुह पुठ्‌ये ढंड्‌याम भराया चे आखी जातीन दुय-दुय जुड़ा हतला। <verse eid="GEN 7:15" /><verse number="16" style="v" sid="GEN 7:16" />ने जसु भगवान हुकुम आपलु तसात चे नर ने नारी ढंड्‌याम भराय ज्‌या तत्‌यार भगवान ढंड्‌यान बारनो दी देदु।<verse eid="GEN 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 7:17" />ने धरती पर चाळीस दाहड़ा लग मुसळ-धार्‌यु पाणी पड़तु; ने पाणी बेसको अदुस बड़तो गुयो, तेरेमां ढंड्‌यो उपर हाकलायणे लाग्‌यो ने धरती पर सी उंचों उठ ज्‌यो। <verse eid="GEN 7:17" /><verse number="18" style="v" sid="GEN 7:18" />ने पाणी बड़तो-बड़तो धरती बेसको अदुस हय ज्‌यो, ती ढंड्‌यो पाणीन उपर तीरतो रह्‌यो। <verse eid="GEN 7:18" /><verse number="19" style="v" sid="GEN 7:19" />ने धरती पर पाणी अतरो बड़ ज्‌यो की धरती परुन उंचा सी उंचा बयड़ा बी आखा डुब ज्‌या। <verse eid="GEN 7:19" /><verse number="20" style="v" sid="GEN 7:20" />चो पाणी धरतीन उंचला बयड़ा सी उपर पंद्‌रे हात चहड़ी ज्‌यो तेरेमां आखा चे बयड़ा डुब ज्‌या। <verse eid="GEN 7:20" /><verse number="21" style="v" sid="GEN 7:21" />ने आखी धरती परुन आखा चिरला ने घर मां पाळन्‌या आखा जीव-जानवर्‌या ने बयड़ाम रहण्‌या आखा जीव-जानवर्‌या ने धरती परुन आखा चालने वाळा जीव-जानवर्‌या ने जतरा बी धरती परुन मटला जीव- जानवर्‌या चे आखा ने आखा माणसे बी मर ज्‌या। <verse eid="GEN 7:21" /><verse number="22" style="v" sid="GEN 7:22" />जे-जे धरती पर हतला ने जतरा बी तींद्‌रेम जीवेन दम हतलु चे आखा मरीन सर ज्‌या। <verse eid="GEN 7:22" /><verse number="23" style="v" sid="GEN 7:23" />ने जतरा बी माणसे, जीव-जानवर्‌या, घीसड़ायन चालन्‌या जीव-जानवर्‌या, सरग मां उडण्‌या चिरला ने जे-जे धरती पर हतला, चे आखा धरती पर मरीन सर ज्‌या, बाकुन नुह ने जतरा तेरे पुठ्‌ये ढंड्‌याम हतला चे अतरात बच ज्‌या। <verse eid="GEN 7:23" /><verse number="24" style="v" sid="GEN 7:24" />ने पाणी धरती पर एक सोव पचास दाहड़ा लग उसट्‌यो नी।<verse eid="GEN 7:24" /></para>
  <chapter eid="GEN 7" />
  <chapter number="8" style="c" sid="GEN 8" />
  <para style="s">मुसळ-धार्‌यु पाणी खत्‌तम हवणु</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 8:1" />भगवान नुहान ने जतरा बी बयड़ाम रहण्‌या जीव-जानवर्‌या ने घर पाळन्‌या जीव-जानवर्‌या नुह भेळे ढंड्‌याम हतला तीनु आखाक नी वीसरी तेरेमां भगवान धरती पर वाहळी छुड़्‌यु ती पाणी आटणे लाग्‌यो। <verse eid="GEN 8:1" /><verse number="2" style="v" sid="GEN 8:2" />ने उंडा दरीयान झीरेन उकाळा ने सरगेन पाणीन बारना देवाय ज्‌या ने मुसळ-धार्‌यु पाणी हीट ज्‌यु। <verse eid="GEN 8:2" /><verse number="3" style="v" sid="GEN 8:3" />ने एक सोव पचास दाहड़ा वीत ज्‌या ती धरती पर पाणी आटणे लाग ज्‌यो। <verse eid="GEN 8:3" /><verse number="4" style="v" sid="GEN 8:4" />ती सालेन सातवे महनान सतरे तारीक ढंड्‌यो अरारत नावेन बयड़ा पर टेक ज्‌यो। <verse eid="GEN 8:4" /><verse number="5" style="v" sid="GEN 8:5" />ने दसवा महना लग पाणी कम हवतु गुयो, ने दसवे महनान पेहले दाहड़े बयड़ान चट्‌या देखाव पड़्‌या।<verse eid="GEN 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 8:6" />ने जत्‌यार चाळीस दाहड़ा हय ज्‌या ती नुह ढंड्‌यान खीड़की उघाड़्‌यु, <verse eid="GEN 8:6" /><verse number="7" style="v" sid="GEN 8:7" />ने एक कागळाक उडाड़ देदु, ने जत्‌यार लग पाणी धरती परुन सुक्‌यो नी तत्‌यार लग कागळु अथुन-अथु फीरतु रह्‌यु। <verse eid="GEN 8:7" /><verse number="8" style="v" sid="GEN 8:8" />पछेन अळी आपसा धड़े सी एक पेरवा काजे बी उडाड़ीन देख्‌यु की पाणी कम हय ज्‌यो की नी। <verse eid="GEN 8:8" /><verse number="9" style="v" sid="GEN 8:9" />ती तीना पेरवा काजे पाय मेकणेन काय जागु नी जड़्‌यु ती ची पछीत नुह धड़े आय गुय, काहाकी आखी धरती पर पाणीत सी भरलो हतलो तत्‌यार चु तीनीक अघु हात करीन आपसा ढंड्‌याम भर लेदु। <verse eid="GEN 8:9" /><verse number="10" style="v" sid="GEN 8:10" />तत्‌यार अळी नुह सात दाहड़ा लग थुब्‌यु ने अळी पछु तीना पेरवा काजे ढंड्‌याम सी उडाड़ देदु। <verse eid="GEN 8:10" /><verse number="11" style="v" sid="GEN 8:11" />ती चु पेरवु सांती वेळाय पछी तेर धड़े आय गुय, ने ची आपसी मुंहडाम जेतुन नावेन झाड़कान एक ताब्‌लु पालु लीन आय, तेरेसी नुह जाण लेदु की पाणी धरती पर उस्‌टी गुयो। <verse eid="GEN 8:11" /><verse number="12" style="v" sid="GEN 8:12" />पछेन अळी हयु सात दाहड़ा लग वाट देखीन तीनात पेरवाक उडाड़्‌यु ने ची पछी कदी नी आवी।<verse eid="GEN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 8:13" />ने जत्‌यार नुहान उमर छव सोव एक सालेन पेहला महनान पेहले दाहड़े पाणी धरती पर उस्‌टीन सुक गुय तत्‌यार नुह ढंड्‌यान छत उघाड़ीन देख्‌यु ती असो देख्‌यु की धरती परुन पाणी उस्‌टीन सुक गुय। <verse eid="GEN 8:13" /><verse number="14" style="v" sid="GEN 8:14" />ने दुसरा महनान सत्‌तावीस तारीक धरती पुरी सुक गुय।<verse eid="GEN 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 8:15" />तत्‌यार भगवान नुह काजे असु कह्‌यु, <verse eid="GEN 8:15" /><verse number="16" style="v" sid="GEN 8:16" />“तु आपसा पुर्‌या, बायर ने उहड़ीस काजे लीन भेळात ढंड्‌याम सी नीकळी आव। <verse eid="GEN 8:16" /><verse number="17" style="v" sid="GEN 8:17" />ने आखा चिरला ने आखा जानवर्‌या ने आखा भातेन धरती पर घीसड़ायन चालन्‌या जीवतेला जानवर्‌या तार धड़े छे, तीनु आखा काजे तार भेळे उतारीन नेचु ली आव काहाकी धरती पर तींद्‌रे सी अदुस अवल्‌यात पयदा हय जाय, ने चे आखी धरती पर छावाय जाय।” <verse eid="GEN 8:17" /><verse number="18" style="v" sid="GEN 8:18" />तत्‌यार नुह ने आपसा पुर्‌या ने आपसान बायर ने उहड़ीस नीकळीन आय ज्‌या। <verse eid="GEN 8:18" /><verse number="19" style="v" sid="GEN 8:19" />ने आखा चार पाया, घीसड़ायन चालन्‌या जानवर्‌या ने चिरला ने जतरा बी जीव-जानवर्‌या धरती पर चाले-फीरे, तीनु आखी जातेन ने जुड़ा भेळे ढंड्‌याम सी नीकळी आया।<verse eid="GEN 8:19" /></para>
  <para style="s">नुहन साहरे बादा चड़ावणु</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 8:20" />तत्‌यार नुह यहोवा भगवान वाटे एक दगड़ान चड़ावान जागु बणायु, ने आखा चुखला जानवर्‌या ने आखा चुखला चिरला माय्‌न थुड़ाक काजे नेवाड़्‌यु ने मारीन तीना चड़ावान जागा पर बाळीन चड़ावु चड़ायु।<note caller="+" style="x"><char style="xo" closed="false">8:20 </char><char style="xt" closed="false"><ref loc="2CO 2:15">2 कुरींथी 2:15</ref>; <ref loc="ISA 54:9">यसाया 54:9</ref></char></note> <verse eid="GEN 8:20" /><verse number="21" style="v" sid="GEN 8:21" />तेरेमां यहोवा भगवान तीना बाळीन चड़ावाक वारलु गंधीन वीच्‌यार कर्‌यु की, “माणसेन वजे सी मे पछेन अळी कदी नी धरती काजे सराप आपो, कदी माणसेन मन मां पयदावारी सी ज काय नीकळे चो भुंड्‌लो वीच्‌यार रहे, तेबी जसु मे हंय आखा जीव-जानवर्‌याक पाणीम डुबाड़ीन मार्‌यु तसु तीनुक असु कबी नी मारो। <verse eid="GEN 8:21" /><verse number="22" style="v" sid="GEN 8:22" />हंय सी जत्‌यार लग धरती रवसे, तत्‌यार लग वेरनेन ने काटणेन टेम, सींग ने सीयाळु ने तप ने उंडाळु ने रात ने दाहड़ु हवतु रवसे।”<verse eid="GEN 8:22" /></para>
  <chapter eid="GEN 8" />
  <chapter number="9" style="c" sid="GEN 9" />
  <para style="s">भगवान नुह साते वायदु कर्‌यु</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 9:1" />तत्‌यार भगवान नुह ने तेरा पुर्‌याक संयबरकत आप्‌यु ने तीनुक कह्‌यु, “वेल वदु ने धरती पर वस जावु।” <verse eid="GEN 9:1" /><verse number="2" style="v" sid="GEN 9:2" />ने तुंद्‌रो बीहाणो ने तुंद्‌रु धाक आखा जानवर्‌या मां, ने सरगेन चिरला मां, ने धरती पर घीसड़ायन चालन्‌या जानवर्‌या मां, ने दरीयान माछा मां रवसे। ने मे तीनु आखा काजे तुंद्‌रा हातेम आप देदु। <verse eid="GEN 9:2" /><verse number="3" style="v" sid="GEN 9:3" />जसु मे पेहले तुहुंं काजे नीळ्‌ळी भाजी खाणे करीन आपलु; तसुत हंय मे आखा चालन्‌या-फीरन्‌या जानवर्‌या खाणे करीन आपो। ने जे आखा तुंद्‌रेत वाटे छे। <verse eid="GEN 9:3" /><verse number="4" style="v" sid="GEN 9:4" />बाकुन तुंद्‌रे वाटे जानवर्‌यान मास जीव भेळेत मतलब लुही भेळेत घुण खावु। <verse eid="GEN 9:4" /><verse number="5" style="v" sid="GEN 9:5" />ने मे छाचलीन तुंद्‌रा लुहीन मतलब जीवेन बदलु लीस ने जानवर्‌या ने माणसे दुयुन बदलु लीस। माणसेन जीवेन बदलु मे एक-एकेक भाय सी लीस। <verse eid="GEN 9:5" /><verse number="6" style="v" sid="GEN 9:6" />“मे भगवान, माणसे काजे आपसान सीका मां घड़लु छे। तेरेमां कुय काहना बी माणसे काजे मारीन खुन उहवाड़से, तेरे वाटे मे खुनेन बदलु लीस।”<verse eid="GEN 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 9:7" />“हंय तुहुंं धरती पर वेल अधे ने धरती पर वस जावु।”<verse eid="GEN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 9:8" />भगवान नुह काजे ने तेरा पुर्‌या काजे अघु कवतुत गुयु, <verse eid="GEN 9:8" /><verse number="9" style="v" sid="GEN 9:9" />“सामळु, मे तुंद्‌रे भेळु ने तुंद्‌रे पछळ जी तुंद्‌री अवल्‌यात आवसे, तींद्‌रे सी बी वायदु करु; <verse eid="GEN 9:9" /><verse number="10" style="v" sid="GEN 9:10" />ने आखा जीवतेला जानवर्‌या सी बी बुली बांदो, जे ढंड्‌याम सी खयड़े आवला छे। चिरला साते, ने आखा जानवर्‌या साते बुली बांदो। <verse eid="GEN 9:10" /><verse number="11" style="v" sid="GEN 9:11" />हंय सी कदी बी मुसळ-धार्‌यु पाणी पाड़ीन मे माणसे काजे ने जीव जानवर्‌या काजे नी मारो। मे ईनी बुली काजे कदी नी वीसरो।” <verse eid="GEN 9:11" /><verse number="12" style="v" sid="GEN 9:12" />अळी भगवान कह्‌यु, “मे तुंद्‌रे साते ने आखा जीवतेला जीवे सी जी बुली करलु, ची बुली पीड़ीडीट बणली रवसे; तीना वायदान सहलाणी जी छे: <verse eid="GEN 9:12" /><verse number="13" style="v" sid="GEN 9:13" />मे वादळा मां बाम मेल दम। जु बाम धरतीन ने मारे ईचमां जु वायदु हवलु छे, तेरी सहलाणी रवसे। <verse eid="GEN 9:13" /><verse number="14" style="v" sid="GEN 9:14" />ने जत्‌यार मे धरती पर वादळा फेलाय्‌स तत्‌यार जु बाम देखाव पड़से। <verse eid="GEN 9:14" /><verse number="15" style="v" sid="GEN 9:15" />तत्‌यार मारी जी बुली तुंद्‌रे ने आखा जीवला जे डील मां छे तीनु जीवे सी करलु छे; तीनुक मे हेर करीस, तत्‌यार असो मुसळ-धार्‌यु पाणी नी पड़से ने चे आखा जे जीवला छे चे बची जासे। <verse eid="GEN 9:15" /><verse number="16" style="v" sid="GEN 9:16" />वादळा मां जु बाम रवसे मे तीनाक देखीन जी सदान बुली हेर करीस, जी बुली भगवानेन ने धरती परुन आखा जीवला डील मां छे तीनु जीवेन ईचमां बांदलु छे।” <verse eid="GEN 9:16" /><verse number="17" style="v" sid="GEN 9:17" />भगवान नुह काजे अळी कह्‌यु, “जी बुली मे धरतीन आखा जीवतेला जीवे साते करलु छे, तेरी सहलाणी जु बामुत छे।”<verse eid="GEN 9:17" /></para>
  <para style="s">नुह ने हेरु पुर्‌यु</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 9:18" />नुहान पुर्‌या जे ढंड्‌या मां सी नीकळ्‌ला चे सेम्‌यु, हाम ने येपेत्‌यु हतला। ने हाम्‌यु ते कनान्‌यान बास हतलु। <verse eid="GEN 9:18" /><verse number="19" style="v" sid="GEN 9:19" />नुहान तीन पुर्‌या जेत हतला, ने हींद्‌रेत सी धरतीन आखा माणसेन वेल अध्‌यु।<verse eid="GEN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 9:20" />कळ धुवाय गुय ने अळतेन नुह खेती करने बाजी ज्‌यु, ने चु आपसा खेते मां अंगुरेन वाड़ी लागाड़्‌यु। <verse eid="GEN 9:20" /><verse number="21" style="v" sid="GEN 9:21" />अंगुर पाक ज्‌या ने अळतेन चु अंगुरेन रस बणाय्‌न पीदु, ने बेसकु छाक ज्‌यु ने तेरी पुथल्‌या समाळनेन बी सान नी रय। तेरेमां चु आपसा तम्‌बा मां पुथल्‌या पाखुर सुय ज्‌यु। <verse eid="GEN 9:21" /><verse number="22" style="v" sid="GEN 9:22" />ती कनानेन बास हाम आपसा बास नुह काजे पुथल्‌या पाखुर सुय रहलु देख्‌यु, ती चु खयड़े जाय्‌न आपसा भाय काजे बास पुथल्‌या पाखुर सुय र्‌यु, करीन कय देदु। <verse eid="GEN 9:22" /><verse number="23" style="v" sid="GEN 9:23" />आपसा भायस हाम्‌यान वात सामळीन सेम्‌यु ने येपेत्‌यु पुथल्‌यो आपसा खांदा पर सी वासा पछळ टांगायतो करीन पछ-मुंड्‌या गुयु ने आपसा बास पर पुथल्‌या पाखुर सुय रवलु ती डील ढाक देदा, ने चे पछ-मुंड्‌या हतला, तेरेमां आपसा बासेक पुथल्‌या पाखुर नी देख्‌या। <verse eid="GEN 9:23" /><verse number="24" style="v" sid="GEN 9:24" />अळतेन तेरी नस्‌यु उतरी गुय ने चु सुय्‌न उठ्‌यु ती तीनाक मालम पड़्‌यो की: मारु इजगाळ्‌यु पुर्‌यु हाम्‌यु मार साते कसु वेहवार करलु। <verse eid="GEN 9:24" /><verse number="25" style="v" sid="GEN 9:25" />तेरेमां नुह कह्‌यु,</para>
  <para style="q1" vid="GEN 9:25">“ए हामेन पुर्‌या कनान्‌या! मे तुसे काजे सराप दम,</para>
  <para style="q1" vid="GEN 9:25">तु आपसा भाय-बंदीन पावर्‌यु बण जायस।”<verse eid="GEN 9:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="GEN 9:26" />नुह अळी कवतु गुयु, “ए सेम्‌या, तारु यहोवा भगवान बरकत वाळु छे, बाकुन कनान्‌यु ने तेरी अवल्‌यात,</para>
  <para style="q1" vid="GEN 9:26">तारा ने तारी अवल्‌यातेन पावर्‌यु बण जाय करीन।<verse eid="GEN 9:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="GEN 9:27" />भगवान येपेत्‌यान अधाड़ीन तेरा वाटा काजे बी वदाड़े करीन;</para>
  <para style="q1" vid="GEN 9:27">ने येपेत्‌यु ने तेरी अवल्‌यात, सेम्‌यान ने तेरी अवल्‌यातेन तम्‌बा मां मेळीन रहे करीन,</para>
  <para style="q1" vid="GEN 9:27">ने कनान्‌यु येपेत्‌यान अवल्‌यातेन पावर्‌यु बणीन रहे करीन।”<verse eid="GEN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 9:28" />मुसळ-धार्‌यु पाणी पड़ीन हीटी गुयु ने अळतेन नुह तीन सव पचास साल लग अळी जीवत्‌लु रह्‌यु। <verse eid="GEN 9:28" /><verse number="29" style="v" sid="GEN 9:29" />तसु करीन नुह नव सव पचास साल लग जीवत्‌लु रह्‌यु; ने अळतेन चु मर ज्‌यु।<verse eid="GEN 9:29" /></para>
  <chapter eid="GEN 9" />
  <chapter number="10" style="c" sid="GEN 10" />
  <para style="s">नुहन पुर्‌यान खानदानी</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 10:1" />नुहान पुर्‌या सेम्‌यु, हाम ने याफत्‌यु हतला; हींद्‌रा पुर्‌या कळ-डुब हवणेन पछेन पयदा हया: ने तींद्‌री अवल्‌यात जी छे।<verse eid="GEN 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 10:2" />येपत्‌यान पुर्‌या: गोमर, माग्‌यु, माद्‌यु, यावान्‌यु, तुबल्‌यु, मेसक्‌यु, ने तीरास्‌यु हया। <verse eid="GEN 10:2" /><verse number="3" style="v" sid="GEN 10:3" />ने गोमर्‌यान पुर्‌या: असकनज, रीपत्‌यु ने तोगर्‌मायु हया। <verse eid="GEN 10:3" /><verse number="4" style="v" sid="GEN 10:4" />ने यावान्‌यान अवल्‌यात सी एलीस्‌या, ने तरसीस्‌या, ने कीत्‌तया, ने दोदान्‌या माणसे हया। <verse eid="GEN 10:4" /><verse number="5" style="v" sid="GEN 10:5" />हींद्‌रा अवल्‌यात धरतीन ईचमां वाळान दरीयान च्‌यारे-मेर वाळा देसेम जाय्‌न वस ज्‌या। ने चे अलग-अलग बुली, कुळी ने जाती मां वाटाय ज्‌या।<verse eid="GEN 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 10:6" />हाम्‌यान पुर्‌या: कुस, मीसर, पुत्‌यु ने कनान्‌यु हया। <verse eid="GEN 10:6" /><verse number="7" style="v" sid="GEN 10:7" />ने कुस पुर्‌या सबा, हवील्‌यु, सबत्‌यु, राम्‌यु, ने सबतक्‌यु हया। ने राम्‌यान पुर्‌या सेब्‌यु ने ददान हया। <verse eid="GEN 10:7" /><verse number="8" style="v" sid="GEN 10:8" />कुस, नीम्‌रोद नावेन एक अळी पुर्‌यु हतलु। नीम्‌रोद बेसकु ताकुतवाळु बण ज्‌यु। ने चु धुवायली कळी पर असलु पेहलु माणुस हतलु। <verse eid="GEN 10:8" /><verse number="9" style="v" sid="GEN 10:9" />चु यहोवा भगवानेन नीगा मां ताकतवाळु सीकार खेलने वाळु बण्‌यु, हेरे सी जु कवाड़ु चाल्‌यु, “नीम्‌रोद अगळ यहोवान नीगा मां ताकतवाळु सीकार खेलने वाळु।” <verse eid="GEN 10:9" /><verse number="10" style="v" sid="GEN 10:10" />नीम्‌रोद राज सीनार देसेन बेबीलोन राजवाड़ा मां, एरेख राजवाड़ा मां, अक्‌कद राजवाड़ा मां, ने कलने राजवाड़ा मां सुरु हयो। <verse eid="GEN 10:10" /><verse number="11" style="v" sid="GEN 10:11" />तीना देसेम सी नीम्‌रोद असीरीया देस मां गुयु; ने चां नीनवे, रोहोबोतीर, कालोह, <verse eid="GEN 10:11" /><verse number="12" style="v" sid="GEN 10:12" />ने रेसेन नावेन सहर काजे वसाड़्‌यु। जो रेसेन सहर तीना जमाना मां, नीनवे सहरेन ने कालोह सहरेन ईचमां वाळो मटलो सहर हतलो।<verse eid="GEN 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 10:13" />मीसरेन अवल्‌यात मां लुदी, अनामी, लहाबी, नप्‌तुही, <verse eid="GEN 10:13" /><verse number="14" style="v" sid="GEN 10:14" />ने पतरुसी, कसलुही ने कप्‌तोरी माणसे हया, कसलुहीया माणसे मां सी पलीस्‌ती माणसे नीकळ्‌या।<verse eid="GEN 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 10:15" />कनान्‌यान पुर्‌या हतला: सीदोन, ने हीत्‌यु, <verse eid="GEN 10:15" /><verse number="16" style="v" sid="GEN 10:16" />ने यबुसी, एमोरी, गीरगास्‌यु, <verse eid="GEN 10:16" /><verse number="17" style="v" sid="GEN 10:17" />हीव्‌वी, ओरक्‌यु, सीन्‌यु, <verse eid="GEN 10:17" /><verse number="18" style="v" sid="GEN 10:18" />अर्‌वदी, समारी, ने हमाती। तसा करीन कनानीन अवल्‌यात कळी मां आखे दुर वस गुय। <verse eid="GEN 10:18" /><verse number="19" style="v" sid="GEN 10:19" />ने कनानीन अवल्‌यात सीदोन सी गरारेन वाट्‌ये माय्‌न गाजा लग, ने सदोम ने अमोरा ने अदमा ने सबोयीमेन वाट्‌ये सी लासा लग वस रहला। <verse eid="GEN 10:19" /><verse number="20" style="v" sid="GEN 10:20" />जे आखा माणसे हाम्‌यान कुळी माय्‌न हतला; ने जे आखा, कुळीन, ने बुलीन, ने देसेन, ने जातीन अनसारे आंग्‌ये-आंग्‌ये वस ज्‌या।<verse eid="GEN 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 10:21" />सेम्‌यु येपेत्‌यान मट्‌लु भायस हतलु, ने सेम्‌यान एबर नावेन पुर्‌यु हयु, ने तेरा बी पुर्‌या हया। तसा करीन सेम्‌यु एबर्‌यान अवल्‌यातेन डाहलु बास बण ज्‌यु। अगा जाय्‌न एबर्‌यान अवल्‌यातेन माणसे एबर्‌या कवायणे बाजी ज्‌या। <verse eid="GEN 10:21" /><verse number="22" style="v" sid="GEN 10:22" />सेम्‌यान अळी बी पुर्‌या हतला; चे एलाम, अस्‌सुर, ओरपोकसोद्‌यु, लुद ने ओराम्‌यु हतला। <verse eid="GEN 10:22" /><verse number="23" style="v" sid="GEN 10:23" />अरामेन पुर्‌या उस, हुल, गेतेर ने मस हतला। <verse eid="GEN 10:23" /><verse number="24" style="v" sid="GEN 10:24" />ओरपोकसोद्‌यु सेलह ने एबर काजे पयदा कर्‌यु। <verse eid="GEN 10:24" /><verse number="25" style="v" sid="GEN 10:25" />एबरनेन दुय पुर्‌या हतला। एक पुर्‌यान नाव पेलेग्‌यु हतलो। पेलेग्‌यान टेमे माणसे टुळुन-टुळु आंग्‌ये हय्‌न धरती पर वस गुयला। करीन तेरो नाव पेलेग्‌यु पाड़ला। ने पेलेग्‌यान नानला भायसेन नाव योकतान्‌यु हतलु। <verse eid="GEN 10:25" /><verse number="26" style="v" sid="GEN 10:26" />ने योकतान ने अल्‌मोदाद, सेलेप, हसरमावेत, येरह, <verse eid="GEN 10:26" /><verse number="27" style="v" sid="GEN 10:27" />यदोरवाम, उजाल, ने दीक्‌ला, <verse eid="GEN 10:27" /><verse number="28" style="v" sid="GEN 10:28" />ओबाल, अबीमाएल, सबा <verse eid="GEN 10:28" /><verse number="29" style="v" sid="GEN 10:29" />ओपीर, हवीला ने योबाब पयदा हया; जे आखा योकतान पुर्‌या हतला। <verse eid="GEN 10:29" /><verse number="30" style="v" sid="GEN 10:30" />जे आखा बुडवणी धड़े वाळा मेसा सी उगेण्‌ले धड़े वाळा सेपारा लग रवतेला। सेपारा बयड़ा वाळा जागा मां हतला। <verse eid="GEN 10:30" /><verse number="31" style="v" sid="GEN 10:31" />जे आखा माणसे सेम्‌यान कुळी माय्‌न हतला; ने जे आखा कुळीन, ने बुलीन, ने देसेन ने जातीन अनसारे आंग्‌ये-आंग्‌ये वस ज्‌या।<verse eid="GEN 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 10:32" />नुहान पुर्‌यान तींद्‌री जातीन अनसारे कुळी-वेलु जुत छे; ने मुसळ-धार्‌यु पाणी पड़ीन हीट ज्‌यु, ने अळतेन हींद्‌रेम सीत आखी जातीन माणसे पयदा हया, ने आखी धरती पर वस ज्‌या।<verse eid="GEN 10:32" /></para>
  <chapter eid="GEN 10" />
  <chapter number="11" style="c" sid="GEN 11" />
  <para style="s">बुली मां गड़बड़ी</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 11:1" />पेहले आखी धरती पर एकुत बुल ने बुली हतली। <verse eid="GEN 11:1" /><verse number="2" style="v" sid="GEN 11:2" />तीने टेमे माणसे उगेवणा चालता-चालता सीनार नावेन देस मां एक जागु देखीन चां वस ज्‌या। <verse eid="GEN 11:2" /><verse number="3" style="v" sid="GEN 11:3" />चे भेळा हय्‌न कहणे लाग्‌या, “आपणु आखा हय्‌न वार ईटड़ा बणाय्‌न आकठा मां पाकाड़जे।” च दगड़ान जागा पर धुळान गारा काजे काम मां लेदा। <verse eid="GEN 11:3" /><verse number="4" style="v" sid="GEN 11:4" />ने चे कह्‌या, “आवु आपणु आपणे वाटे एक सहर ने मुंडेवरी बणावजे ने मुंडवरी अतरु उचु बणावजे, की सरगे लग जाती रवजे, काहाकी आपणु आपणो नाव कमायजे ने असो नी हवे की आपणु काजे आखी धरती पर खवळाय्‌णु पड़े।”<verse eid="GEN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 11:5" />जत्‌यार माणसे सहर ने मुंडेवरी बणावणे लाग्‌या, तत्‌यार ईनाक देखणे करीन यहोवा भगवान उतरी आयु। <verse eid="GEN 11:5" /><verse number="6" style="v" sid="GEN 11:6" />ती यहोवा भगवान वीच्‌यार्‌यु, ईनु माणसेन एक्‌कु छे, ने हींद्‌री एकुत बुली छे, ने हंय अगा बी असात काम करसे, ती हींद्‌रे वाटे काहनो बी काम काठो नी रवसे। <verse eid="GEN 11:6" /><verse number="7" style="v" sid="GEN 11:7" />तेरेमां हामु हींद्‌री बुली मां गरबड़ी नाख देजे, काहाकी जे एक दीसरान बुली काजे समज नी सके। <verse eid="GEN 11:7" /><verse number="8" style="v" sid="GEN 11:8" />ने यहोवा भगवान तसु करीन, चां सी आखी धरती पर खळवी देदु, ने चे तीना सहरेक बणावणु छुड़ देदा। <verse eid="GEN 11:8" /><verse number="9" style="v" sid="GEN 11:9" />तेरेमां ईना जागान नाव बेबीलोन पड़्‌यो, काहाकी ईनात जागा पर यहोवा भगवान बुली मां गरबड़ी नाखलु, ने ईनात जागा सी तीनुक आखी धरती पर खळवी देदु।<verse eid="GEN 11:9" /></para>
  <para style="s">सेमेन खानदानी</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 11:10" />सेम्‌यान अवल्‌यात जी छे। मुसळ धार्‌या पाणीन दुय साल पछेन ओरपोकसोद्‌यान पयदावारी हय तत्‌यार सेम्‌यु सोव सालेन हतलु। <verse eid="GEN 11:10" /><verse number="11" style="v" sid="GEN 11:11" />ओरपोकसोद्‌यान पयदावारीन पछेन सेम्‌यु पांच सोव साल अळी जीयु, ने तेरा अळी बी पुर्‌या-पारी हया।<verse eid="GEN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 11:12" />जत्‌यार ओरपोकसोद्‌यु तीस ने पांच सालेन हयु, तत्‌यार सेलहन पयदावारी हय। <verse eid="GEN 11:12" /><verse number="13" style="v" sid="GEN 11:13" />सेलहन पयदावारीन पछेन मां ओरपोकसोद्‌यु च्‌यार सोव तीन साल अळी जीयु, ने अळी बी तेरा पुर्‌या-पारी हया।<verse eid="GEN 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 11:14" />जत्‌यार सेलहन तीस साल हया, तत्‌यार एबरनेन पयदावारी हय। <verse eid="GEN 11:14" /><verse number="15" style="v" sid="GEN 11:15" />एबरनेन पयदावारीन पछेन सेलह च्‌यार सोव तीन साल अळी जीयु, ने तेरा अळी बी पुर्‌या-पारी पयदा हया।<verse eid="GEN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 11:16" />जत्‌यार एबर तीस ने च्‌यार सालेन हयु, तत्‌यार पेलेग्‌यान पयदावारी हय। <verse eid="GEN 11:16" /><verse number="17" style="v" sid="GEN 11:17" />पेलेग्‌यान पयदावारीन पछेन एबर च्‌यार सोव तीस साल अळी जीयु, ने तेरा अळी बी पुर्‌या-पारी हया।<verse eid="GEN 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 11:18" />जत्‌यार पेलेग्‌यु तीस सालेन हयु, तत्‌यार रेवान पयदावारी हय। <verse eid="GEN 11:18" /><verse number="19" style="v" sid="GEN 11:19" />रेवान पयदावारीन पछेन पेलेग्‌यु दुय सोव ने नव साल अळी जीयु, ने तेरा अळी बी पुर्‌या-पारी हया।<verse eid="GEN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 11:20" />जत्‌यार रेवान तीस ने दुय सालेन हयु, तत्‌यार सेरुग्‌यान पयदावारी हय। <verse eid="GEN 11:20" /><verse number="21" style="v" sid="GEN 11:21" />सेरुग्‌यान पयदावारी पछेन रेवान दुय सोव ने सात साल अळी जीयु, ने तेरा अळी बी पुर्‌या-पारी हया।<verse eid="GEN 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 11:22" />जत्‌यार सेरुग तीस सालेन हयु, तत्‌यार नाहोरेन पयदावारी हय। <verse eid="GEN 11:22" /><verse number="23" style="v" sid="GEN 11:23" />नाहोरेन पयदावारीन पछेन सेरुग्‌यु दुय साल अळी जीयु, ने तेरा अळी बी पुर्‌या-पारी पयदा हया।<verse eid="GEN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 11:24" />जत्‌यार नाहोर वीस ने नव सालेन हयु, तेरायान पयदावारी हय। <verse eid="GEN 11:24" /><verse number="25" style="v" sid="GEN 11:25" />तेरायान पयदावारीन पछेन नाहोर एक सोव ने गुन्‌नीस साल अळी जीयु ने तेरा अळी बी पुर्‌या-पारी हया।<verse eid="GEN 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 11:26" />ने तेरायान सतत्‌र साल हवणेन पेहलुत तेरा पुर्‌या अब्‌राम, नाहोर ने हारानेन पयदावारी हय।<verse eid="GEN 11:26" /></para>
  <para style="s">तेरेन खानदानी</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 11:27" />तेरायान अवल्‌यात जी छे: तेरायु अब्‌राम, नाहोर ने हारान काजे पयदा कर्‌यु; ने हारान लुत काजे पयदा कर्‌यु। <verse eid="GEN 11:27" /><verse number="28" style="v" sid="GEN 11:28" />ने हारानेन बास तेराया तीहीन कसदीया माणसे उर नावेन सहर मां मर गुयला, जां चु पयदा हवलु। <verse eid="GEN 11:28" /><verse number="29" style="v" sid="GEN 11:29" />अब्‌राम ने हारानेन ईयाव हयु, अब्‌रामेन घरवाळीन नाव सारे ने नाहोरेन घरवाळीन नाव मील्‌का हतली। ची हारानेन पुरे हतली ने मीलकान बहणीसेन नाव यीसका हतलो। <verse eid="GEN 11:29" /><verse number="30" style="v" sid="GEN 11:30" />सारे आंझी हतली तेरेमां तेरी अवल्‌यात नी हया।<verse eid="GEN 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 11:31" />तेरायु आपसा पुर्‌याक अब्‌राम, ने आपसा पुर्‌यान- पुर्‌यु लुत काजे, जु हारानेन पुर्‌यु हतलु, ने अब्‌रामेन घरवाळी सारे काजे भेळे ली ज्‌यु,ने चे कसदीया देसेन उर सहर सी नीकळीन कनान देस भीणी चाल पड़्‌या, बाकुन चे हारान नावेन सहर मां पुगीन चांत रहणे बाजी ज्‌या। <verse eid="GEN 11:31" /><verse number="32" style="v" sid="GEN 11:32" />जत्‌यार तेरायान दुय सोव पांच सालेन हयु; तत्‌यार हयु हारान देस मां मर ज्‌यु।<verse eid="GEN 11:32" /></para>
  <chapter eid="GEN 11" />
  <chapter number="12" style="c" sid="GEN 12" />
  <para style="s">भगवान अब्‌राम काजे बुलावे</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 12:1" />अळतेन यहोवा भगवान अब्‌राम सी कह्‌यु, आपसा देसेक ने बासेन घर ने आखा तारा रीस्‌ता वाळा काजे छुड़ीन पला देस मां जाती रव, जो मे तुसेक देखाड़ीस। <verse eid="GEN 12:1" /><verse number="2" style="v" sid="GEN 12:2" />मे तार सी एक मट्‌ली जाती बणावीस, मे तुहुंंक संयबरकत आपीस; मे तुंद्‌रो नाव मटो करीस, ने तुहुंं संयबरकतेन जड़ बण जासु।<verse eid="GEN 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="GEN 12:3" />जे तुहुंंक संयबरकत देसे,</para>
  <para style="q1" vid="GEN 12:3">मे तीनुक संयबरकत दीस ने जे तुहुंंक सराप देसे,</para>
  <para style="q1" vid="GEN 12:3">मे तीनुक सराप दीस तुंद्‌रे सी धरतीन आखा माणसे संयबरकत काजे हात करसे।<verse eid="GEN 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 12:4" />तेरेमां यहोवा भगवानेन हुकुम सी अब्‌राम चाल पड़्‌यु, लुत बी तेरे भेळे गुयु, जत्‌यार अब्‌राम हारान देस सी नीकळ्‌यु तत्‌यार हयु सतत्‌र ने पांच सालेन हतलु। <verse eid="GEN 12:4" /><verse number="5" style="v" sid="GEN 12:5" />अब्‌राम भेळे तेरी घरवाळी सारे ने तेरु भतरजुस लुत, आखो माल धन ने आखा जानवर्‌या बी हारान देस मां हेरा हतला,</para>
  <para style="p" vid="GEN 12:5">आखो काय लीन कनान देस मां जाणे करीन नीकळ्‌यु ने चे कनान देस मां आय ज्‌या।<note caller="+" style="x"><char style="xo" closed="false">12:5 </char><char style="xt" closed="false"><ref loc="ACT 7:4">नेवताळान काम 7:4</ref>; <ref loc="HEB 11:8">ईब्‌रानीयो 11:8</ref></char></note> <verse eid="GEN 12:5" /><verse number="6" style="v" sid="GEN 12:6" />चां सी अब्‌राम चुखलु सकेम मां मोरेन चुखलो बांज नावेन झाड़कान चां पुग ज्‌या, तीने टेमे तीना कनान देस मां कनानी माणसे रवतेला। <verse eid="GEN 12:6" /><verse number="7" style="v" sid="GEN 12:7" />यहोवा भगवान अब्‌राम काजे देखाव पड़्‌यु ने कह्‌यु, “तुंद्‌री अवल्‌यात काजे जो देस आपीस।” तत्‌यार अब्‌राम तीना जागा पर अब्‌राम वाटे जु हीनाक देखाव पड़्‌लु, तेरे वाटे एक चड़ावान जागु बणायु।<note caller="+" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="GAL 3:16">गलातीयो 3:16</ref>; <ref loc="ACT 7:5">नेवताळान काम 7:5</ref></char></note> <verse eid="GEN 12:7" /><verse number="8" style="v" sid="GEN 12:8" />पछेन अब्‌राम चां सी बेतेल उगण मां बयड़ा भीणी गुया ने चांत हयु तम्‌बु उबु कर्‌यु, चां सी बुडण मां बेते-एल ने उंगण मां आय नावेन सहर हतलो, अब्‌राम चां यहोवा भगवान वाटे चड़ावान जागु बणायु ने भगवान काजे आंध्‌यु। <verse eid="GEN 12:8" /><verse number="9" style="v" sid="GEN 12:9" />अळतेन चां कथु अब्‌राम दखणाव नेगेव जीला भीणी चाल पड़्‌यु।<verse eid="GEN 12:9" /></para>
  <para style="s">अब्‌राम मीसरे देस मां जाय</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 12:10" />तीना देस मां काळ पड़्‌यु, तत्‌यार अब्‌राम थुड़ाक दाहड़ा वाटे दखणाव भीणी मीसर देस मां रहणे करीन जाती र्‌यु, काहाकी तींद्‌रा देस मां बेसकु काळ पड़ रहलु। <verse eid="GEN 12:10" /><verse number="11" style="v" sid="GEN 12:11" />जत्‌यार चे मीसर देस धड़े पुग्‌या, तत्‌यार अब्‌राम आपसी घरवाळी सारे काजे कह्‌यु, सामळ, मेसे मालम छे की तु बेसकी वारु बायर छे। <verse eid="GEN 12:11" /><verse number="12" style="v" sid="GEN 12:12" />जत्‌यार मीसर देसेन माणसेक मालम हय जासे की तु मारी घरवाळी छे, ती चे मेसेक मार नाखसे, ने तुसेक जीवतेली राख लेसे। <verse eid="GEN 12:12" /><verse number="13" style="v" sid="GEN 12:13" />तेरेमां असी कवजी, मे हेरी बहणीस छे काहाकी तार वजे सी मारो भलो हवे ने मारु जीव तार वजे सी बची जासे। <verse eid="GEN 12:13" /><verse number="14" style="v" sid="GEN 12:14" />पछेन असो हयो की जत्‌यार अब्‌राम मीसर देस मां आयु, तत्‌यार मीसर मां रहण्‌या माणसे तेरी घरवाळीक देख्‌या की जी ते बेसकी वारु देखाये। <verse eid="GEN 12:14" /><verse number="15" style="v" sid="GEN 12:15" />ने मीसर देसेन फीरोन राजा सीपायड़ा तीनी सारा काजे देखीन फीरोन राजा अगळ तीनीक बड़ाय कर देदा ने तीनीक फीरोन राजान हवेली मां पुगाड़ देदा। <verse eid="GEN 12:15" /><verse number="16" style="v" sid="GEN 12:16" />ने फीरोन तेर वजे सी अब्‌रामेन भलाय कर्‌यु ने तीनाक गाडरा-बुकड़ा, गावड़ी-बेल, गदड़ा-गदड़ी, उटड़ा ने पावर-पावरनी बी देदु।<verse eid="GEN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 12:17" />तेरेमां यहोवा भगवान फीरोन ने तेरा घरन्‌या पर अब्‌रामेन घरवाळी सारेन वजे सी मटी-मटी हीड़ा-पीड़ा नाख्‌यु। <verse eid="GEN 12:17" /><verse number="18" style="v" sid="GEN 12:18" />तेरेमां फीरोन राजा अब्‌राम काजे बुलायन कह्‌यु, “तु मारे साते असो काय कर्‌यु? तु मारे सी जी वात साताड़ीन काहा राख्‌यु की जी मारी घरवाळी छे? <verse eid="GEN 12:18" /><verse number="19" style="v" sid="GEN 12:19" />तु असो काहा कह्‌यु की जी मारी बहणीस छे? तेरेमां मे ईनीक मारी घरवाळी बणावणे करीन मारा हवेली मां राख्‌यु। तेरेमां हंय तुहुंं ईनीक जां सी लीन जाती रव।” <verse eid="GEN 12:19" /><verse number="20" style="v" sid="GEN 12:20" />तत्‌यार फीरोन आपसा सीपायड़ाक अब्‌राम बारामां हुकुम देदु ने चे अब्‌राम काजे हेरी घरवाळीक ने तेरो आखो धन ने आखो काय लीन मकली देदा।<verse eid="GEN 12:20" /></para>
  <chapter eid="GEN 12" />
  <chapter number="13" style="c" sid="GEN 13" />
  <para style="s">अब्‌राम ने लुत आंग्‌ये हवे</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 13:1" />तत्‌यार अब्‌राम आपसी घरवाळी, आखो माल धन ने लुत काजे लीन मीसर कथु चाल पड़्‌यु। ने कनान देसेन दखेवरु नेगेव नावेन उजाड़्‌या बयड़ा मां आयु।<note caller="+" style="x"><char style="xo" closed="false">13:1 </char><char style="xt" closed="false"><ref loc="GEN 2:10">उबजाणनी किताप 2:10</ref></char></note> <verse eid="GEN 13:1" /><verse number="2" style="v" sid="GEN 13:2" />अब्‌राम धड़े बेसका जानवर्‌या ने सोनो हतलो तेरेमां चु बेसकु धन वाळु हतलु। <verse eid="GEN 13:2" /><verse number="3" style="v" sid="GEN 13:3" />तत्‌यार चु दखणाव सहर सी नीकळीन बेतेल भीणी एक जागा सी दीसरा जागा भीणी जात र्‌यु ने चु बेतेल ने आय सहरेन ईचमां वाळा जागा पर जात र्‌यु चां तेरा पड़ावा काजे नाख्‌यु। <verse eid="GEN 13:3" /><verse number="4" style="v" sid="GEN 13:4" />ने जीने जागे अब्‌राम भगवान वाटे चड़ावान जागु बणावलु, ने अब्‌राम चां अळी यहोवा भगवानेन भक्‌ती कर्‌यु।<verse eid="GEN 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 13:5" />लुत धड़े बी बेसका गाडरा-बुकड़ा ने जानवर्‌या हतला, ने हयु बी अब्‌राम धड़े आपसान तम्‌बु लागाड़लु। <verse eid="GEN 13:5" /><verse number="6" style="v" sid="GEN 13:6" />बाकुन रहणेन जागु कम हतलु तेरेसी चे दुय भेळा नी रय सकतेला, काहाकी तींद्‌रे धड़े बेसका जानवर्‌या हतला। <verse eid="GEN 13:6" /><verse number="7" style="v" sid="GEN 13:7" />ने अळी अब्‌राम ने लुतेन गुवाळ्‌यान ईचमां झगड़ु हय जातलु, ने तीने टेमे तीना देस मां कनानी ने परीज्‌जी जातीन माणसे रवतेला।<verse eid="GEN 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 13:8" />तेरेमां अब्‌राम लुत सी कह्‌यु, “मारे ने तारे ईचमां ने तारा ने मारा गुवाळ्‌यान ईचमां झगड़ु नी हवणु चाहजे; काहाकी आपणु भाय-भायुत छे। <verse eid="GEN 13:8" /><verse number="9" style="v" sid="GEN 13:9" />तेरेमां आपणु दुयु नाळा हय जाता, कदी तु डाखर्‌ये हात भीणी जाय ती मे जेवड़्‌ये हात भीणी जाती रय्‌स ने कदी तु जेवड़्‌ये हात भीणी जाय ती मे डाखर्‌ये हात भीणी जाती रय्‌स।”<verse eid="GEN 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 13:10" />लुत यरदन नदीन तेरे आड़े-धड़ेन नीळोकच खयड़ाक देख्‌यु, चो बेसको लाबों, चवड़ो हतलो, ने नदी बी पाणी सी भरली हतली। चो यहोवा भगवानेन बगीचा ने मीसर देसेन तसों हतलो (जी वात यहोवा भगवान सदोम ने अमोरा सहर काजे सारनेन पेहलुन छे।) <verse eid="GEN 13:10" /><verse number="11" style="v" sid="GEN 13:11" />तेरेमां लुत यरदन नदी, चो उगण भीणी छे, तीनाक नेवाड़ लेदु, तसा करीन लुत ने अब्‌राम दुयु नाळा हय ज्‌या। <verse eid="GEN 13:11" /><verse number="12" style="v" sid="GEN 13:12" />अब्‌राम कनान देस मां वस ज्‌यु ने लुत खयड़ाम वाळा सहर मां रहणे बाजी ज्‌यु ने आपसा तम्‌बाक सदोम सहर धड़े ताण देदु। <verse eid="GEN 13:12" /><verse number="13" style="v" sid="GEN 13:13" />सदोम सहर वाळा माणसे बेसका कुहर्‌या ने यहोवा भगवानेन नींगा मां पाप मां हतला।<verse eid="GEN 13:13" /></para>
  <para style="s">अब्‌रामेन हेब्‌रोन जाणु</para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 13:14" />लुत अब्‌राम सी नाळु हवणेन पछेन मां यहोवा भगवान अब्‌राम सी कह्‌यु, “तु जीना जागा पर उबु हय र्‌यु, चां सी च्‌यारे-मेर देख। <verse eid="GEN 13:14" /><verse number="15" style="v" sid="GEN 13:15" />काहाकी आखु जागु जु तुसेक देखाये, तीनाक मे तुसे ने तारी अवल्‌यात काजे जलम भर दी दीस।<note caller="+" style="x"><char style="xo" closed="false">13:15 </char><char style="xt" closed="false"><ref loc="ACT 7:5">नेवताळान काम 7:5</ref></char></note> <verse eid="GEN 13:15" /><verse number="16" style="v" sid="GEN 13:16" />मे तारी अवल्‌यात काजे धरतीन धुळान पीठीन तसों गीणाये नी तत्‌रा करीस ने कदी काहनुक तुंद्‌रा ईना धुळान पीठीक गीण लेसे ती चु तुंद्‌रा अवल्‌यात काजे बी गीण सकसे। <verse eid="GEN 13:16" /><verse number="17" style="v" sid="GEN 13:17" />हंय उठ, ने जो देस कतरो लाबों ने चवड़ो छे तत्‌राम चाल-फीर काहाकी च मे तुसेत काजे आपीस।” <verse eid="GEN 13:17" /><verse number="18" style="v" sid="GEN 13:18" />तेरेमां अब्‌राम आपसा तम्‌बाक उखाळीन ली जाती र्‌यु, ने हेबरोन सहर धड़े वाळा मम्‌रे वाड़ी मां गुयु, जां चुखला बांज नावेन झाड़का हतला, ने चां तम्‌बु ताणीन आपसा टुळा भेळुत रहणे बाजी ज्‌यु ने अब्‌राम चां बी यहोवा भगवान वाटे चड़ावान जागु बणायु।<verse eid="GEN 13:18" /></para>
  <chapter eid="GEN 13" />
  <chapter number="14" style="c" sid="GEN 14" />
  <para style="s">अब्‌राम लुत काजे छुड़ावणु</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 14:1" />सीनार देसेन राजा अमराफेल, एल्‌लसार देसेन राजु आरीओक, एलाम देसेन राजु कदोरलामोर ने गोयीम देसेन राजु तीवालेन, हींद्‌रा दाहड़ा मां असो हयो, <verse eid="GEN 14:1" /><verse number="2" style="v" sid="GEN 14:2" />की जे सदोम देसेन राजु बेरु, ने अमोरा देसेन राजु बीरसा ने अदमा देसेन राजु सीनाब, ने सबोयीम देसेन राजु सेमेबेर ने बेला देसेन राजु, बेला देसेन दीसरो नाव सोवर हतलो, हींद्‌रे साते लड़ाय कर्‌या। <verse eid="GEN 14:2" /><verse number="3" style="v" sid="GEN 14:3" />जे पांचु एक हय्‌न सीद्‌दीम खयड़ा मां भेळा रया, चो सीद्‌दीम आज खारलो दर्‌यो छे। <verse eid="GEN 14:3" /><verse number="4" style="v" sid="GEN 14:4" />बारे साल लग ते जे कदोरलामोर राजान हक मां रया, बाकुन तेरा साल मां तीनु राजा सी लड़ाय कर पड़्‌या। <verse eid="GEN 14:4" /><verse number="5" style="v" sid="GEN 14:5" />जत्‌यार चवदा साल हय ज्‌या ती कदोरलामोर ने तेरा साते वाळा राजा आवीन असतेरोथ मां रापाया जात्‌या काजे, ने हाम मां जुजीया जात्‌या काजे, ने साबेकीर्‌यातेम मां एमीया जात्‌या काजे। <verse eid="GEN 14:5" /><verse number="6" style="v" sid="GEN 14:6" />ने सेईर नावेन बयड़ा मां होरी जाती काजे मारता-मारता तीना एल्‌पारा लग पुग ज्‌या, ने चो तीना उजाड़्‌या बयड़ा मां छे। <verse eid="GEN 14:6" /><verse number="7" style="v" sid="GEN 14:7" />चां सी पछा फीरीन एनमीसपात मां आया, जो कादेस बी कहवाये, ने अमालेकी जातीन पुरा देस काजे, ने तीनु एमोरीया देस मां रहणे वाळा काजे बी जीक लेदु, जे हसासोन्‌तामार मां रवतेला।<verse eid="GEN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 14:8" />तत्‌यार सदोम, अमोरा, अदमा, सबोयीम ने बेला जो सोवर बी कहवाये, ईनु देसेन राजा बाहर नीकळी ज्‌या ने जे तीना सीद्‌दीम खयड़ा मां तीनु च्‌यार राजा साते लड़ाय पड़्‌या। <verse eid="GEN 14:8" /><verse number="9" style="v" sid="GEN 14:9" />जी लड़ाय एलाम देसेन राजु कदोरलामोर, गोयीम देसेन राजु तीदाल, सीनार देसेन राजु अमराफेल ने एल्‌लसार देसेन राजु आरीओक- जे च्‌यार राजा तीनु पांच राजा सी लड़ी रहला। <verse eid="GEN 14:9" /><verse number="10" style="v" sid="GEN 14:10" />सीदीम खयड़ा मां काळ्‌ळा धुळा सी भरला खाडात-खाडा हतला; जत्‌यार सदोम ने अमोरा देसेन राजा लड़ाय सी ढासता-ढासता थुड़ाक माणसे गड्‌डा मां हीट पड़्‌या, ने जे बची रवला चे बयड़ा मां ढासी ज्‌या। <verse eid="GEN 14:10" /><verse number="11" style="v" sid="GEN 14:11" />तत्‌यार च्‌यारु राजा सदोम ने अमोरा देस सी आखो धन ने आखो खाणेन चीजेक लुटी-पाटीन ली जाती र्‌या। <verse eid="GEN 14:11" /><verse number="12" style="v" sid="GEN 14:12" />चे सदोम मां रहण्‌या अब्‌रामेन भतरजास लुत काजे ने तेरो आखो धन भेळेत ली जाती र्‌या।<verse eid="GEN 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 14:13" />ने जत्‌यार लड़ायतेला तत्‌यार एक जणु ढासीन ईब्‌री जातीन अब्‌राम काजे जी वात बताड़ देदु, अब्‌राम ते मम्‌रे नावेन माणुस हतलु चु एक एमोरी जातीन हतलु, ने बांज नावेन चुखला झाड़कान चां तम्‌बु ताणीन रवतेलु ने मम्‌रे, एसकोल ने आनेरेन भाय हतलु, ने जे अब्‌राम सी बुली बांद्‌ला हतला। <verse eid="GEN 14:13" /><verse number="14" style="v" sid="GEN 14:14" />जत्‌यार अब्‌राम काजे असो मालम हयो, लुत काजे चे बांदी लेदा, ती चु तेरा आखा कुटुम काजे भेळा कर्‌यु, ने तीन सोव अठ्‌ठारे जणा जे लड़ाय करने करीन वारु सीकला हतला, तीनुक लीन दान नावेन जागे लग पछळुत पड़ला। <verse eid="GEN 14:14" /><verse number="15" style="v" sid="GEN 14:15" />रात्‌ये अब्‌राम आपसा माणसे काजे तींद्‌रे सी लड़ाय करने करीन वाट देदु ने अब्‌राम ने अळी तेरा चाकर्‌या भेसकायन तीनुक हाराय देदु ने तींद्‌रा दमीस्‌क सहरेन धुराव भीणी होबा नावेन जागे लग पछळ पड़्‌या। <verse eid="GEN 14:15" /><verse number="16" style="v" sid="GEN 14:16" />अब्‌राम तीनु माणसे सी आखो चीज पछु मांग लेदु ने लुत काजे ने तेरा आखा माणसे ने तींद्‌रो धन बी तींद्‌रे सी हापकी लेदु।<verse eid="GEN 14:16" /></para>
  <para style="s">मलीकीस्‌दक काजे अब्‌राम काजे संयबरकत आपणु</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 14:17" />जत्‌यार अब्‌राम कदोरलामोर ने तेर साते वाळा राजा काजे हाराय्‌न पछु आवतेलु, तत्‌यार सदोम देसेन राजु, सावेन नावेन खयड़ा मां अब्‌राम सी भेळु हवणे करीन आयु, सावे काजे हंय राजान खयड़ो कहे। <verse eid="GEN 14:17" /><verse number="18" style="v" sid="GEN 14:18" />सालेम सहरेन राजु मेलकीजेदेक, जु आखान हकदार्‌या भगवानेन पुजारु हतलु, चु अब्‌राम वाटे रुटा ने अंगुरेन रस लायु।<note caller="+" style="x"><char style="xo" closed="false">14:18 </char><char style="xt" closed="false"><ref loc="HEB 7:1-10">ईब्‌रानीयो 7:1-10</ref>; <ref loc="PSA 110:4">भजन सहीता 110:4</ref></char></note> <verse eid="GEN 14:18" /><verse number="19" style="v" sid="GEN 14:19" />ने अब्‌राम काजे संय बरकत आप्‌तु जाय्‌न कह्‌यु, “सरग ने धरती काजे बणावणे वाळा, आखान हकदार्‌या भगवान भीणी सी तुसेक संय बरकत जड़े। <verse eid="GEN 14:19" /><verse number="20" style="v" sid="GEN 14:20" />ने संयबरकत वाळु छे, आखान हकदार्‌यु भगवान, जु तारा वेरी काजे हारावणे मां मदत कर देदु।” तत्‌यार अब्‌राम मलकीसीदक काजे आखाम सी दसवु हीस्‌सु आप्‌यु।<verse eid="GEN 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 14:21" />तत्‌यार सदोम देसेन राजु अब्‌राम सी कह्‌यु, “मेसे माणसे आप दे ने दीसरो आखो धन तु राख ले।”<verse eid="GEN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 14:22" />सदोम देसेन राजाक अब्‌राम जपाप आप्‌यु, “मे सरग ने धरतीन हकदार्‌या यहोवा भगवान अगळ सगुन खाय र्‌यु। <verse eid="GEN 14:22" /><verse number="23" style="v" sid="GEN 14:23" />की मे तारा चीज मां सी बी चीज ने अतरो बी की एक दुरु ने खासड़ान बंद लग नी लम, काहाकी ईनु चीजेक देखीन तु असु नी कय पड़े की ‘मे अब्‌राम काजे मालदार बणायु।’ <verse eid="GEN 14:23" /><verse number="24" style="v" sid="GEN 14:24" />मे तार सी कायनी लम, बाकुन खाणो अतरोत, तीनाक मारा माणसे खाय लेदला छे, ने तींद्‌रु हीस्‌सु; जु मारे साते गुयला, मतलब आनेर, एसकोल, ने मम्‌रेन हीस्‌सु, मे तुसेक नी आपो, तीनुक चे आपसा-आपसा हीस्‌साक राख लेय।”<verse eid="GEN 14:24" /></para>
  <chapter eid="GEN 14" />
  <chapter number="15" style="c" sid="GEN 15" />
  <para style="s">अब्‌राम साते यहोवा भगवान वायदु करे</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 15:1" />ईनु वातेन पछेन अब्‌राम काजे यहोवा भगवान असु बताड़्‌यु की, “अब्‌राम, बीहे मां, मे तारु ढाळ बणीन तारी राखवाळी करीस, ने मे तुसेक बेसको मटो ईनाम आपीस।”<verse eid="GEN 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 15:2" />अब्‌राम जपाप आप्‌यु, “ए मालीक यहोवा, तु मेसेक काय देसी? काहाकी मारी अवल्‌यात नी हय, ने मारा घरेन वारीस ते एलीएजर रवसे जु दमीस्‌क सहर वाळु छे।” <verse eid="GEN 15:2" /><verse number="3" style="v" sid="GEN 15:3" />अब्‌राम असु बी कह्‌यु, “तारे भीणी सी मेसेक ते अवल्‌यात बी नी देदु; तेरेमां मारा घर मां एक सेवक वारीस रवसे।”<verse eid="GEN 15:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 15:4" />तत्‌यार अब्‌राम धड़े यहोवा भगवानेन बुल अळी आयो ने कह्‌यु, “तारु वारीस जु नी हय, बाकुन तारी खुदेन अवल्‌यातेन वारीस रवसे।” <verse eid="GEN 15:4" /><verse number="5" style="v" sid="GEN 15:5" />यहोवा भगवान अब्‌राम काजे बाहर ली ज्‌यु ने अब्‌राम सी कह्‌यु, “सरग भीणी भाळ, ने तारान गिन्‌ती लागाड़, यहोवा अब्‌राम सी कह्‌यु, असात तारा अवल्‌यात बी रवसे, जीनुक कुय बी गीण नी सके।”<note caller="+" style="x"><char style="xo" closed="false">15:5 </char><char style="xt" closed="false"><ref loc="ROM 4:18">रोमीयो 4:18</ref>; <ref loc="HEB 11:12">ईब्‌रानीयो 11:12</ref></char></note><verse eid="GEN 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 15:6" />अब्‌राम यहोवा भगवान पर भुरसु कर्‌यु, ने यहोवा भगवान ईनी वात सी तीनाक वारलु काम मां गीण्‌यु।<verse eid="GEN 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 15:7" />ने यहोवा भगवान अब्‌राम काजे कह्‌यु, “मे हयुत यहोवा छे, जु कसदीयान उर सहर सी बाहर नीकाळ्‌यु, काहाकी तुसेक ज देस जड़े ने तु ईना देस पर हक जमाड़े।”<verse eid="GEN 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 15:8" />अब्‌राम कह्‌यु, “ए मालीक यहोवा भगवान, मे कसु जाणों की तु मेसे ईना देसेक आप देसी?”<verse eid="GEN 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 15:9" />तेरेमां यहोवा भगवान अब्‌राम सी कह्‌यु, “तीन सालेन केवड़ी, तीन सालेन एक बुकड़ी, ने तीन सालेन एक सींगड़ा वाळु गाडरु, एक हुली ने अळी एक पेरवान पीला काजे ली आव।” <verse eid="GEN 15:9" /><verse number="10" style="v" sid="GEN 15:10" />अब्‌राम यहोवा भगवान वाटे ज आखो ली आयु, ने तीनु आखाक काटी-काटीन दुय-दुय टुकड़ा कर्‌यु ने टुकड़ा काजे यहोवा भगवान अगळ मेल्‌यु, बाकुन हयु चिरलान टुकड़ा नी कर्‌यु। <verse eid="GEN 15:10" /><verse number="11" style="v" sid="GEN 15:11" />ने अब्‌राम तीनु मारला जानवार काजे यहोवा भगवान अगळ मेल रहलु, ती घुवड़ा तीना मास भीणी झड़पायता आया, बाकुन अब्‌राम तीनु घुवड़ा काजे ढासाड़ देदु।<verse eid="GEN 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 15:12" />जत्‌यार दाहड़ु डुबणे बाजी रहलु, तत्‌यार अब्‌राम मटी नींद मां सुय ज्‌यु ने तेरे पर आंधारो छावाय ज्‌यो। <verse eid="GEN 15:12" /><verse number="13" style="v" sid="GEN 15:13" />तत्‌यार यहोवा भगवान अब्‌राम सी कह्‌यु, “जी छाचली छे की तारा अवल्‌यात दीसरा देस मां परदेसी बणीन रवसे, जां तीनुक गुलाम बणावसे, ने तीनुक च्‌यार सोव साल लग एल्‌हा पाड़से।<note caller="+" style="x"><char style="xo" closed="false">15:13 </char><char style="xt" closed="false"><ref loc="EXO 1:1-14">नीरगमन 1:1-14</ref>; <ref loc="ACT 7:6">नेवताळान काम 7:6</ref></char></note> <verse eid="GEN 15:13" /><verse number="14" style="v" sid="GEN 15:14" />ने जीना देस मां जे गुलाम बणसे, तीनु देसेन माणसे काजे मे डंड आपीस, ने अळतेन चां सी तारा अवल्‌यात बेसको धन लीन आवसे। <note caller="+" style="x"><char style="xo" closed="false">15:14 </char><char style="xt" closed="false"><ref loc="EXO 12:36">नीरगमन 12:36</ref>; <ref loc="EXO 12:40">12:40</ref>,<ref loc="EXO 12:41">41</ref>; <ref loc="ACT 7:7">नेवताळान काम 7:7</ref></char></note> <verse eid="GEN 15:14" /><verse number="15" style="v" sid="GEN 15:15" />बाकुन तु ते तारा डाहा-बुड़ा मां जाय्‌न वारु भेसकाय जासी, ने तु ते डाहवारे लग जीवीन तारा डाहा-बुड़ा मां वारु तुसे अघे करीन गाड़ देसे। <verse eid="GEN 15:15" /><verse number="16" style="v" sid="GEN 15:16" />बाकुन चे चवंथी पीड़ी मां पछा आवसे; काहाकी जां लग एमोरी जातीन माणसेन भुंडला कामे करनेन पुरो हवसे ने तीनुक डंड बी जड़नु चाहजे।”<verse eid="GEN 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 15:17" />सांतो दाहड़ु बुडीत गुयलु, तत्‌यार ने बेसको आंधारो हय ज्‌यो, तत्‌यार तीनु काटला जानवर्‌यान दुय-दुय टुकड़ान ईचमां सी कुळु उड्‌तेलो एक चुल्‌हा मां ने एक धपतेलो मसाल भगवान भेळे गुयो। <verse eid="GEN 15:17" /><verse number="18" style="v" sid="GEN 15:18" />ने तीनेत दाहड़े यहोवा अब्‌राम सी बुली बांद्‌यु ने कह्‌यु, “मे तारा अवल्‌यात काजे मीसर नदी सी लागाड़ीन मट्‌ली नदी फरात लग आप दीस। <verse eid="GEN 15:18" /><verse number="19" style="v" sid="GEN 15:19" />मतलब केनीया, कनीज्‌जीया, कदमोनीया, <verse eid="GEN 15:19" /><verse number="20" style="v" sid="GEN 15:20" />हीत्‌तीया, परीज्‌जी, रापाया, <verse eid="GEN 15:20" /><verse number="21" style="v" sid="GEN 15:21" />एमोरीया, कनानीया, गीरगास्‌यु ने यबुसीयान जागा, मे तारा अवल्‌यात काजे आप दीस।”<verse eid="GEN 15:21" /></para>
  <chapter eid="GEN 15" />
  <chapter number="16" style="c" sid="GEN 16" />
  <para style="s">हाजीरा ने इस्‌माएल</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 16:1" />अब्‌रामेन घरवाळी सारे काजे अवल्‌यात हतली, बाकुन तीनीन एक हाजीरा नावेन गुलाम पावरनी मीसर देस वाळी हतली; <verse eid="GEN 16:1" /><verse number="2" style="v" sid="GEN 16:2" />सारे अब्‌राम सी कय, “मे ते माय नी बण सकती काहाकी मे आंझी छे तेरेमां दया करीन तु मारी पावरनी भीणी जा, ती तेरे साहरे घर वस जासे।” ने अब्‌राम सारे वात काजे मान लेदु। <verse eid="GEN 16:2" /><verse number="3" style="v" sid="GEN 16:3" />अब्‌राम काजे कनान देस मां रवतेला दस साल हय गुयला, ती अब्‌रामेन लाडी सारे आपसीन पावरनी हाजीरा काजे अब्‌रामेन घरवाळी हवणे करीन सुप देदी। <verse eid="GEN 16:3" /><verse number="4" style="v" sid="GEN 16:4" />ती अब्‌राम हाजीरा भेळे सुयु, ने हाजीरा भार पाये हय ती जी सारे काजे आपसी नींगा मां फालतु समजणे लागी।<verse eid="GEN 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 16:5" />सारे अब्‌राम सी कय, “मारी गुलाम पावरनी मेसे हंय फालतु समजणेन वजे तु छे, मे ते तीनीक वारीस बणने करीन तुसेक सुपली बाकुन हाजीरा भार पाये हवतेत मेसेक फालतु समजणे लागी हंय यहोवात तारे ने मारे ईचमां नीयाव करे।”<verse eid="GEN 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 16:6" />अब्‌राम सारे सी कह्‌यु, “सामळ, तारी पावरनी पर तारुत हक छे, तु जसी चाहे तसी तेरे साते कर।” तत्‌यार सारे हाजीरा काजे बी एलहा पाड़ने बाजी गुय, ने हाजीरा परेसान हयन सारे अगळ सी ढास गुय।<verse eid="GEN 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 16:7" />जत्‌यार यहोवान सरगेन काहवाळ्‌यु तीनीक बयड़ा मां झीरी धड़े देख्‌यु, ज सुर नावेन वाट पर हतलो, <verse eid="GEN 16:7" /><verse number="8" style="v" sid="GEN 16:8" />ती सरगेन काहवाळ्‌यु कह्‌यु, ओय, सारेन पावरनी हाजीरा, कां सी आय रय ने कां जाय रय?</para>
  <para style="p" vid="GEN 16:8">हाजीरा जपाप आपी, “मे मारी मालकी सारे भीणी सी ढासीन आय रय।”<verse eid="GEN 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 16:9" />यहोवान सरगेन काहवाळ्‌यु कह्‌यु, “आपसी मालकीन चां पछी जाती रव ने तेरे हक मां रव।” <verse eid="GEN 16:9" /><verse number="10" style="v" sid="GEN 16:10" />ने यहोवान सरगेन काहवाळ्‌यु कह्‌यु, “मे तारा अवल्‌यात काजे बेसकु बड़ावीस, ने अतरा बी की चे गीणाय नी तत्‌रा।” <verse eid="GEN 16:10" /><verse number="11" style="v" sid="GEN 16:11" />यहोवान सरगेन काहवाळ्‌यु असु बी कह्‌यु, “देख, तारु एक पुर्‌यु पयदा हवसे, तेरो नाव तु इस्‌माएल राखजी। काहाकी यहोवा तुंद्‌रा दुख पर धीयान लागाड़लु छे। <verse eid="GEN 16:11" /><verse number="12" style="v" sid="GEN 16:12" />चु पुर्‌यु एक जंगली गदड़ान तसलु रवसे; चु आखान वेरी बणसे ने दीसरा बी एरे सी दुसमनी करसे, ने चु आपसा भायसेन ईचमांत काम करसे।”<verse eid="GEN 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 16:13" />तत्‌यार हाजीरा, जु तेरे सी वात कर्‌यु तेरो नाव अत्‌ता-एल-रोय पाड़ी (मतलब यहोवा भगवान मारा दुख पर धीयान कर्‌यु ईना जंगल मां मार सी वात कर्‌यु) <verse eid="GEN 16:13" /><verse number="14" style="v" sid="GEN 16:14" />ईनी वातेन हवणे सी तीना कुवान नाव लहेरोई पड़्‌यु, जो कादेस ने बेरेद मुलुकेन ईचमां छे।<verse eid="GEN 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 16:15" />अब्‌राम सी हाजीरान एक पुर्‌यु हयु, ने अब्‌राम तेरा पुर्‌यान नाव इस्‌माएल राख्‌यु, <verse eid="GEN 16:15" /><verse number="16" style="v" sid="GEN 16:16" />अब्‌राम अस्‌सी ने छव सालेन हतलु, तत्‌यार इस्‌माएल पयदा हवलु।<verse eid="GEN 16:16" /></para>
  <chapter eid="GEN 16" />
  <chapter number="17" style="c" sid="GEN 17" />
  <para style="s">वायदान सहलाणी, फतरी काटणु</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 17:1" />जत्‌यार अब्‌राम नब्‌बे ने नव सालेन हयु, तत्‌यार यहोवा भगवान तीनुक उजेंतु हयु ने कह्‌यु, “मे आखाम सी मटु ताकत वाळु भगवान छे; तु मारे साते बणीन रव ने अघु बड़तु जा। <verse eid="GEN 17:1" /><verse number="2" style="v" sid="GEN 17:2" />मे मारा वायदा काजे तारे साते पुरा करीस ने तारा अवल्‌यात काजे बड़ावीस।” <verse eid="GEN 17:2" /><verse number="3" style="v" sid="GEN 17:3" />तत्‌यार अब्‌राम पाये पड़ीन भगवान काजे आंध्‌यु ने भगवान कह्‌यु, <verse eid="GEN 17:3" /><verse number="4" style="v" sid="GEN 17:4" />तारे साते मारु वादु असु छे की, तु बेसका जातीन माणसेन डाहलु बास कहवायसी। <verse eid="GEN 17:4" /><verse number="5" style="v" sid="GEN 17:5" />हंय सी तारो नाव अब्‌राम नी रवे बाकुन अब्‌राहम रवसे, काहाकी मे तुसेक बेसका जातीन डाहलु बास बणावलु छे। <verse eid="GEN 17:5" /><verse number="6" style="v" sid="GEN 17:6" />मे तारु बेसकु वेल अधाड़ीस, मे तुसे जाती-जातीन डाहलु बास बणायस ने तारा अवल्‌यात मां राजा बणसे।<verse eid="GEN 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 17:7" />मे तारे ने तारा आवणे वाळा अवल्‌यात साते पीड़ीडीट असु वादु करों की तारे ने तारे पछेन आवणे वाळान अवल्‌यातेन बी भगवान रय्‌स। <verse eid="GEN 17:7" /><verse number="8" style="v" sid="GEN 17:8" />जो कनान देस छे, जां तु परदेसी बणीस रवे, जो देस तुसे ने तारे पछेन आवणे वाळा अवल्‌यात काजे जलेमकी अवल्‌यात रवसे, ने मे तींद्‌रु भगवान रवीस।<note caller="+" style="x"><char style="xo" closed="false">17:8 </char><char style="xt" closed="false"><ref loc="ACT 7:5">नेवताळान काम 7:5</ref></char></note><verse eid="GEN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 17:9" />तत्‌यार भगवान अब्‌राहम सी कह्‌यु, “तु ने तारे पछेन तारा अवल्‌यातेन माणसे मारा वायदाक छाचलीन लीन चालता रवजु। <verse eid="GEN 17:9" /><verse number="10" style="v" sid="GEN 17:10" />तारे ने तारे पछेन वाळा अवल्‌यात साते मारु जु वादु छे ने जीनाक मान्‌नु जरुड़ी छे; तुंद्‌रे मां हरेक पुर्‌यान फतरी काटा कराड़े।<note caller="+" style="x"><char style="xo" closed="false">17:10 </char><char style="xt" closed="false"><ref loc="ACT 7:8">नेवताळान काम 7:8</ref>; <ref loc="ROM 4:11">रोमीयो 4:11</ref></char></note> <verse eid="GEN 17:10" /><verse number="11" style="v" sid="GEN 17:11" />ने तुहुंं तुंद्‌री फतरी काटाड़जु, असुत मारे ने तारे ईचमां वादु करनेन सहलाणी रवसे। <verse eid="GEN 17:11" /><verse number="12" style="v" sid="GEN 17:12" />तारा अवल्‌यात मां आखा पीड़ी मां हरेक पुर्‌यान पयदा हवणे सी आठवे दाहड़े तेरो फतरी काटाड़जु, चाहे चो तुंद्‌रे घरेन पावर्‌यु हय जु तारे घर मां पयदा हयु हय चाहे तीनाक तुहुंं दीसरा देस सी मुल लेदा हय, चाहे चे तुंद्‌रा अवल्‌यात माय्‌न नी रवे तेरु बी करजु। <verse eid="GEN 17:12" /><verse number="13" style="v" sid="GEN 17:13" />तुंद्‌रा घर मां पयदा हयु हय, चाहे पयस्‌या दीन लेदा हय, तींद्‌रो बी फतरी काटाड़नु पड़से। तुंद्‌रा डील मां मारु जु वादु जलमेन वादु छे। <verse eid="GEN 17:13" /><verse number="14" style="v" sid="GEN 17:14" />बाकुन जु फतरी नी काटाड़े, तीनाक खानदानी सी बाहर कर देजु, काहाकी चु मारा वादा काजे तुड़लु छे।”<note caller="+" style="x"><char style="xo" closed="false">17:14 </char><char style="xt" closed="false"><ref loc="GEN 17:24">उबजाणनी किताप 17:24</ref>; <ref loc="GEN 21:4">21:4</ref></char></note><verse eid="GEN 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 17:15" />भगवान अब्‌राहम सी असु बी कह्‌यु, “तारी घरवाळी सारे काजे हंय सी सारे घुण कह्‌वे, बाकुन हंय तेरो नाव सारा रवसे। <verse eid="GEN 17:15" /><verse number="16" style="v" sid="GEN 17:16" />मे तीनीक संयबरकत आपीस, ने मे तुसेक तेरे सी एक पुर्‌याक आपीस, मे तीनाक संयबरकत आपीस, तेरेसी ची जाती-जातीन डाहली माय बणसे, ने बेसका राजान पयदावारी तींद्‌री अवल्‌यात सी हवसे।”<verse eid="GEN 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 17:17" />असो सामळीन अब्‌राहम पाये पड़ीन तीनाक आंध्‌यु, ने हास्‌यु, ने मन मांत कहणे लाग्‌यु, “काय सोव सालेन माणसेन पुर्‌यु पयदा हय सके? सारा जी नब्‌बे ने नव सालेन छे, काय ची पुर्‌याक पयदा कर सकसे?” <verse eid="GEN 17:17" /><verse number="18" style="v" sid="GEN 17:18" />ने अब्‌राहम भगवान सी कह्‌यु, “इस्‌माएल तारी नींगा मां वारु बणीन रवे! अतरोत बेसको।”<verse eid="GEN 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 17:19" />तत्‌यार भगवान अब्‌राम सी कह्‌यु, “नीही! तारी घरवाळी सारा सी एक पुर्‌यु हवसे, ने तेरो नाव इसाक पाड़जी, मे तेरे साते असु वादु करीस की जे तेरे पछेन आवणे वाळी पीड़ी-पीड़ी लग सदान वादु रवसे। <note caller="+" style="x"><char style="xo" closed="false">17:19 </char><char style="xt" closed="false"><ref loc="GAL 4:7-8">गलातीयो 4:7-8</ref></char></note> <verse eid="GEN 17:19" /><verse number="20" style="v" sid="GEN 17:20" />ने इस्‌माएल बारामां, मे तुंद्‌री वात सामळ्‌यु; मे तीनाक बी छाचलीन संयबरकत आपीस; मे तेरा बेसका पुर्‌या हवसे, ने बेसका अवल्‌यात बी बणसे। चु बारे राजान मुखी बी बणसे ने मे तेरे सी मटीत जाती बणावीस। <verse eid="GEN 17:20" /><verse number="21" style="v" sid="GEN 17:21" />बाकुन मारु वादु इसाक साते करीस, तीनाक सारा सी अगले साल ईनात टेम मां पयदा हवसे।” <verse eid="GEN 17:21" /><verse number="22" style="v" sid="GEN 17:22" />जत्‌यार भगवान अब्‌राहम सी जी वात करी लेदलु, तत्‌यार चु चां सी उपर पछु चहड़ी ज्‌यु।<verse eid="GEN 17:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 17:23" />तत्‌यार अब्‌राहम तीनेत दाहड़े भगवानेन हुकुमेन अनसारे आपसा पुर्‌यान इस्‌माएलेन ने आपसा पावर्‌याक, तींद्‌रो पयदावारी तेरे खानदानी मां हवलो ने तीनुक चु पयस्‌या दीन मुल लेदलु, ने घरन्‌यान हरेक पुर्‌यान भगवान जसु कह्‌यु तसु तींद्‌री फतरी काट्‌यु। <verse eid="GEN 17:23" /><verse number="24" style="v" sid="GEN 17:24" />जत्‌यार अब्‌राहमेन फतरी काटाड़्‌यु तत्‌यार चु नब्‌बे ने नव सालेन हतलु। <verse eid="GEN 17:24" /><verse number="25" style="v" sid="GEN 17:25" />ने तेरु पुर्‌यु इस्‌माएल दस ने तीन सालेन हतलु, जत्‌यार तेरी फतरी काट्‌या; <verse eid="GEN 17:25" /><verse number="26" style="v" sid="GEN 17:26" />अब्‌राहम ने तेरा पुर्‌या इस्‌माएलेन फतरी काट्‌या च एकुत दाहड़े हयो। <verse eid="GEN 17:26" /><verse number="27" style="v" sid="GEN 17:27" />ने तेरा घरन्‌यान आखा पुर्‌या, जे तेरा घर मां पयदा हवला, ने जे दीसरा देस सी पयस्‌या सी मुल लेदला, आखान फतरी काट्‌या तींद्‌रे भेळेत हयो।<verse eid="GEN 17:27" /></para>
  <chapter eid="GEN 17" />
  <chapter number="18" style="c" sid="GEN 18" />
  <para style="s">इसाकेन पयदा हवणेन वायदु</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 18:1" />अब्‌राहम तपी वेळाय, मम्‌रे वाड़ी मां आपसा तम्‌बु मां बठी रहलु, चां बांज नावेन झाड़का हतला। तत्‌यार यहोवा भगवान तीना काजे देखाव पड़्‌यु; <verse eid="GEN 18:1" /><verse number="2" style="v" sid="GEN 18:2" />अब्‌राहम असु देख्‌यु की तेरे अगळ तीन माणसे उभा हय र्‌या। जत्‌यार हयु तीनु माणसे काजे देख्‌यु, तत्‌यार चु तीनुक भेळु हवणे करीन तम्‌बुन बारनाम सी दवड़ीन तींद्‌रे धड़े गुयु, ने पाये पड़ीन आंध्‌यु। <verse eid="GEN 18:2" /><verse number="3" style="v" sid="GEN 18:3" />अब्‌राहम तीनुक कह्‌यु, “मारा मालीक, कदी मारे पर तारी गीण-दयान नींगा छे ती मे लीलघाय्‌न कहों, की मे तारु चाकर्‌यु, छे करीन मारेन थुड़ीक वार थुबीन जाजी। <verse eid="GEN 18:3" /><verse number="4" style="v" sid="GEN 18:4" />तु ईना झाड़का तळे बठ, मे तारे वाटे पाणी लीन आवों, काहाकी तु आपसा पाय धुय ले। <verse eid="GEN 18:4" /><verse number="5" style="v" sid="GEN 18:5" />मे तारे वाटे खाणों तीयार करों, काहाकी खाणे तारा जीवेक सांती जड़े, तत्‌यार तु अघु बी जाय सके- काहाकी तु तार चाकर्‌यान चां आवलु छे, ती चु अब्‌राहम सी कह्‌यु,</para>
  <para style="p" vid="GEN 18:5">“हसुत कर, जसु तु कह्‌यु।”<verse eid="GEN 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 18:6" />अब्‌राहम तम्‌बु मां सारा धड़े जाय्‌न कह्‌यु, “तीन चवकीन पीठु कुसणीन रुटा कर दे।” <verse eid="GEN 18:6" /><verse number="7" style="v" sid="GEN 18:7" />अब्‌राहम दवड़ीन आपसान गावड़ीन-बेलेन टुळा मां जाय्‌न एक वारलु केवड़ु छाटीन आपसा चाकर्‌या काजे देदु ने तीनाक कह्‌यु, मामार चुड़ाया। <verse eid="GEN 18:7" /><verse number="8" style="v" sid="GEN 18:8" />अळतेन अब्‌राहम, दही, दुत ने मास जो बणावलो हतलो, तीनुक खावाड़्‌यु, जत्‌यार चे तीन्‌हु खाणेत बाजी रहला, तत्‌यार अब्‌राहम झाड़कान साहळे तींद्‌रे धड़े उबु रह्‌यु।<note caller="+" style="x"><char style="xo" closed="false">18:8 </char><char style="xt" closed="false"><ref loc="HEB 13:2">ईब्‌रानीयो 13:2</ref></char></note><verse eid="GEN 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 18:9" />चे अब्‌राहम सी पुछ्‌या, “तारी घरवाळी सारा कां छे?”</para>
  <para style="p" vid="GEN 18:9">अब्‌राहम कह्‌यु, “ची तम्‌बु मां छे।”<verse eid="GEN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 18:10" />ईनी वात पर तींद्‌रेम सी एक जणु कह्‌यु, “आवते साल ईनात टेमे तारी घरवाळी सारान एक पुर्‌यु हवसे।” अब्‌राहमेन आसु तम्‌बु भीणी फीरीन हतलु, ने तम्‌बान बारने पर रय्‌न सारा जी वात सामळी रहली।<note caller="+" style="x"><char style="xo" closed="false">18:10 </char><char style="xt" closed="false"><ref loc="ROM 9:9">रोमीयो 9:9</ref></char></note> <verse eid="GEN 18:10" /><verse number="11" style="v" sid="GEN 18:11" />अब्‌राहम ने सारा बेसका डाहा हय गुयला, ने सारान महना आवणु बंद हय गुयला।<note caller="+" style="x"><char style="xo" closed="false">18:11 </char><char style="xt" closed="false"><ref loc="ROM 4:9">रोमीयो 4:9</ref></char></note> <verse eid="GEN 18:11" /><verse number="12" style="v" sid="GEN 18:12" />तेरेमां सारा मन-मन मां हासती जाय्‌न वीच्‌यारने लागी, “मे ने मारु धेणी हामु दुयु बेसका डाहा हय ज्‌या, हंय काय जी खुसी हामरा जीवाय मां आवसे?”<verse eid="GEN 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 18:13" />तत्‌यार यहोवा अब्‌राहम सी पुछ्‌यु, “सारा असी कय्‌न काहा हासी रय की काय छाचलीन मारे सी एक पुर्‌यु पयदा हवसे, काहाकी मे ते बेसकी डाही हय गुयली छे?” <verse eid="GEN 18:13" /><verse number="14" style="v" sid="GEN 18:14" />“काय यहोवा वाटे ज काठो छे? मे आवते साले टाकली टेमे तुसे भेळु हवणे आय्‌स, जत्‌यार सारान एक पुर्‌यु हवसे।”<verse eid="GEN 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 18:15" />तत्‌यार सारा बीही गुय, ने असी कय्‌न झुट मेकणे बाजी गुय की, “मे नी हासी।”</para>
  <para style="p" vid="GEN 18:15">तत्‌यार भगवानेन सरग काहवाळ्‌यु कह्‌यु, “तु छाचलीन हासली।” <note caller="+" style="x"><char style="xo" closed="false">18:15 </char><char style="xt" closed="false"><ref loc="1PE 3:6">1 पतरस 3:6</ref></char></note><verse eid="GEN 18:15" /></para>
  <para style="s">सदोम ने आखा सहरेन नास हवणु</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 18:16" />अळतेन चे माणसे जाणे करीन उठ्‌या ने सदोम भीणी देखणे लाग्‌या, अब्‌राहम तीनुक अघुस मेकणे करीन तींद्‌रे भेळे चालतु रह्‌यु। <verse eid="GEN 18:16" /><verse number="17" style="v" sid="GEN 18:17" />तत्‌यार यहोवा असु वीच्‌यार्‌यु की, “जो काम मे करनेवाळु छे, काय मे जी वात अब्‌राहम सी साताड़ीन राखों? <verse eid="GEN 18:17" /><verse number="18" style="v" sid="GEN 18:18" />अब्‌राहम सी ते छाचलीन एक मट्‌ली ने ताकुत वाळी जाती बणसे ने तेरेत सी धरतीन परुन आखी जाती संयबरकत काजे हात करसे।<note caller="+" style="x"><char style="xo" closed="false">18:18 </char><char style="xt" closed="false"><ref loc="GEN 12:3">उबजाणनी किताप 12:3</ref>; <ref loc="ACT 3:25">नेवताळान काम 3:25</ref>; <ref loc="GAL 3:8">गलातीयो 3:8</ref></char></note> <verse eid="GEN 18:18" /><verse number="19" style="v" sid="GEN 18:19" />काहाकी मे हीना काजे असु करीन नेवाड़लु छे की हयु आपसा पुर्‌याक ने घरेन माणसेक छाचली ने नीयावेन वात सीकाड़े ने चे यहोवान वाटे पर काठा रहे, काहाकी यहोवा अब्‌राहम सी करला वादा काजे पुरा करे।”<verse eid="GEN 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 18:20" />तत्‌यार यहोवा बताड़्‌यु, “सदोम ने अमोरान सहरेन आयड़नु ने तींद्‌रा पाप बेसका हय ज्‌या <verse eid="GEN 18:20" /><verse number="21" style="v" sid="GEN 18:21" />तेरेमां मे चां जाय्‌न देखीस की, तींद्‌रा काम छाचला छे की नी, कदी नी हय ती मे तीनाक उळखी लीस।”<verse eid="GEN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 18:22" />अळतेन तींद्‌रेम सी दुय माणसे चां सी पछा वळीन सदोम भीणी चाल पड़्‌या, बाकुन अब्‌राहम ते यहोवा अगळ उंबुत रह्‌यु। <verse eid="GEN 18:22" /><verse number="23" style="v" sid="GEN 18:23" />अब्‌राहम यहोवा सी कह्‌यु, “काय छाचलीन तु भुंडला माणसे भेळे धरमी माणसे काजे बी खत्‌तम कर देसी? <verse eid="GEN 18:23" /><verse number="24" style="v" sid="GEN 18:24" />कदी तीना सहर मां पचास जणा धरमी हय, ती काय तु तीना सहर काजे खत्‌तम कर देसी? काय तीनु पचास धरमीन वजे सी दीसरा माणसे नी बचे? <verse eid="GEN 18:24" /><verse number="25" style="v" sid="GEN 18:25" />असो काम करने सी तु छेटु रवजी की भुंडला भेळे धरमी काजे मारनु, ने भुंडला ने धरमी साते एक जसु वेहवार करनु। असो तु नी करनु चाहे! काय आखी धरतीन नीयाव करने वाळु नीयाव नी करसे?”<verse eid="GEN 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 18:26" />यहोवा कह्‌यु, “कदीक मेसे सदोम सहर मां पचास धरमी माणसे जड़ जाय, ती मे तींद्‌रे वजे सी तीना आखा सहर काजे छुड़ दीस।”<verse eid="GEN 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 18:27" />अब्‌राहम अळी कह्‌यु, “एक कहे ती ते मे धुळु ने रखड़ुत छे, तेबी मे मालीक सी वात करनेन हिम्‌मत कर्‌यु, <verse eid="GEN 18:27" /><verse number="28" style="v" sid="GEN 18:28" />कदी चां पचास मां सी पांच घट जाय, ती काय तु पांच धरमी घट जाणे सी आखा सहर काजे खत्‌तम कर देसी?”</para>
  <para style="p" vid="GEN 18:28">यहोवा जपाप आप्‌यु, “कदी मेसे चां चालीस ने पांच बी जड़ जाय, ती मे तीना सहर काजे खत्‌तम नी करों।”<verse eid="GEN 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 18:29" />एक कावु अळी अब्‌राहम यहोवा सी कह्‌यु, “कदी चां चाळीस जड़से ती?”</para>
  <para style="p" vid="GEN 18:29">यहोवा जपाप आप्‌यु, “कदी चालीस बी रवसे तेबी मे तीना सहर काजे खत्‌तम नी करो।”<verse eid="GEN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 18:30" />तत्‌यार अब्‌राहम कह्‌यु, “मालीक, तु मारे सी नराज मां हवे, ने एक कावु अळी पुछणी दे, कदी चां तीस धरमी रवसे ती?”</para>
  <para style="p" vid="GEN 18:30">यहोवा जपाप आप्‌यु, “कदी चां तीस बी जड़ जाय, ती तीनुक मे खत्‌तम नी करों।”<verse eid="GEN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 18:31" />अब्‌राहम कह्‌यु, “मालीक, मे तारे सी वात करनेन हिम्‌मत ते करीत लेदु, ती कदी चां बीसुत रवसे ती?”</para>
  <para style="p" vid="GEN 18:31">यहोवा जपाप आप्‌यु, “मे तीनु बीसेन वजे सी तीना सहर काजे खत्‌तम नी करों।”<verse eid="GEN 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 18:32" />अळी अब्‌राहम कह्‌यु, “ए मालीक, तु रीस घुण माने, आकरी कावा तार सी लीलघाय्‌न कहों कदी चां तसुत धरमी रवसे ती?”</para>
  <para style="p" vid="GEN 18:32">यहोवा जपाप आप्‌यु, “ती मे तीनु दसेन वजे सी तीना सहर काजे खत्‌तम नी करों।” <verse eid="GEN 18:32" /><verse number="33" style="v" sid="GEN 18:33" />जत्‌यार यहोवा सी अब्‌राहम सी वात करीत लेदलु, ती चु चां सी जाती र्‌यु, ने अब्‌राहम आपसे घर जाती र्‌यु।<verse eid="GEN 18:33" /></para>
  <chapter eid="GEN 18" />
  <chapter number="19" style="c" sid="GEN 19" />
  <para style="s">सदोमेन पाप</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 19:1" />सांती वेळाय हवतेत चे दुय सरगेन काहवाळ्‌या सदोम सहर मां आया, ने लुत सदोमेन फाटक धड़े बसी रहलु। तीनुक देखीन अब्‌राहम तींद्‌रे सी भेळु हवणे करीन उठ्‌यु, ने पाये पड़ीन आंध्‌यु। <verse eid="GEN 19:1" /><verse number="2" style="v" sid="GEN 19:2" />ने कह्‌यु, “ए मालीक, तुहुंं मारे घर आवु, ने पाय धुवीन मारे घर रात रहु ने अगास उठीन जाजु।”</para>
  <para style="p" vid="GEN 19:2">बाकुन चे जपाप आप्‌या, “नीही, हामु ते सहरेन चवराया पर राते सुवसुन।”<verse eid="GEN 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 19:3" />बाकुन लुत ते लीलघाय्‌न बेसकु कवतुत रह्‌यु, तत्‌यार चे लुतेन वात मानीन तेरे घर गुया, ने लुत तींद्‌रे वाटे खाणों, नी खमीर वाळा रुटा बणाय्‌न तीनुक खावाड़्‌यु।<verse eid="GEN 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 19:4" />सुवणे सी पेहेल, सदोम सहरेन माणसे ने, जुवान्‌या सी लागाड़ीन डाहला लग, मतलब आखे दुरेन आखा माणसे तीना लुतेन घर काजे घेरवी लेदा। <verse eid="GEN 19:4" /><verse number="5" style="v" sid="GEN 19:5" />चे मट्‌ये अवाज सी आयड़ीन लुत सी कहणे लाग्‌यु, “कां छे चे माणसे, जे आज रात मां जां रुकला‌ छे? तीनुक बाहर ली आव ने तींद्‌रे भेळे सुवीन सोवसार करजी।”<verse eid="GEN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 19:6" />लुत बाहर नीकळ्‌यु ने बारनो लागाड़ीन <verse eid="GEN 19:6" /><verse number="7" style="v" sid="GEN 19:7" />तींद्‌रे सी लीलघाय्‌न कह्‌यु, “ए मारा भायस, मारो कहणु छे, असलो काम घुण करु। <verse eid="GEN 19:7" /><verse number="8" style="v" sid="GEN 19:8" />देखु, मारी दुय पुरे छे,चे हाल लग काहना बी पुर्‌यान मुंहडो नी देखी, मे तीनुक बाहर ली आवों। तींद्‌रे साते तुहुंंक जसों बी लागे तसों वेहवार कर लेवु, बाकुन ईनु माणसे साते असा मां करु, काहाकी जे मारा मेजवान्‌या छे।”<verse eid="GEN 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 19:9" />चे कह्‌या, “छेटे हय जां!” ने कहणे लाग्‌या, तु ते पारकु बणीन जां रय र्‌यु बाकुन हंय तु नीयाय करने वाळु बन्‌ने कर र्‌यु! हामु तारु हाल तीनु माणसे सी बी अदुस गलत करसुन। चे लुत काजे बीहाड़ने लाग्‌या ने बारनाक तुड़ने करीन अगास गुया। <verse eid="GEN 19:9" /><verse number="10" style="v" sid="GEN 19:10" />बाकुन चे मेजवान्‌या लुत काजे धरीन घरमा भर लेदा ने बारनो लागाड़ देदा। <verse eid="GEN 19:10" /><verse number="11" style="v" sid="GEN 19:11" />चे मेजवान्‌या तीनु पर, जे बारना पर हतला, नानला सी मटला लग, आखा काजे आंदळा कर देदा, ती चे बारनाक हेरता-हेरता हारी पड़्‌या।<note caller="+" style="x"><char style="xo" closed="false">19:11 </char><char style="xt" closed="false"><ref loc="2KI 6:18">2 राजा 6:18</ref> </char></note><verse eid="GEN 19:11" /></para>
  <para style="s">लुत सदोम सी नीकळे</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 19:12" />तत्‌यार चे दुय मेजवान्‌या लुत सी कह्‌या, “जां तारा अळी कुण-कुण छे? जवायलास, पुर्‌या, पुरे हय मतलब ईना सहर मां जे बी हय, तीनुक ईना जागा पर सी कान्‌खुर ली जाती रव, <verse eid="GEN 19:12" /><verse number="13" style="v" sid="GEN 19:13" />काहाकी हामु ईना जागा काजे खत्‌तम करने वाळा छे। यहोवा भगवान माणसे काजे एला पाड़नेन ने आयड़नु तेरे अगळ बेसको जादा हय ज्‌यो तेरेमां हयु हामुक ईनु काजे खत्‌तम करने करीन मकेल्‌लु छे।”<verse eid="GEN 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 19:14" />लुत जाय्‌न आपसान हवणे वाळा तीनु जवायलास सी वात कर्‌यु, जींद्‌रे साते तेरी पुरेन मांगणी हय गुयली। तीनुक कह्‌यु, “उठु, जां सी बाहर जाती रहु, यहोवा ईना सहर काजे खत्‌तम करने वाळु छे!” बाकुन लुतेन जवायलास समज्‌या की जु असलुत कय र्‌यु।<note caller="+" style="x"><char style="xo" closed="false">19:14 </char><char style="xt" closed="false"><ref loc="LUK 17:28-29">लुका 17:28-29</ref></char></note><verse eid="GEN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 19:15" />जत्‌यार वीजाळो हवणे लाग्‌यो, तत्‌यार काहवाळ्‌या लुत काजे मामार करु करीन कह्‌यु ने कह्‌यु की, “उठ, तारी घरवाळीक ने दुयु पुरेक जे जां छे तीनुक ली जां। नीते तु बी ईना सहरेन डंड भेळे खत्‌तम हय जासी।” <verse eid="GEN 19:15" /><verse number="16" style="v" sid="GEN 19:16" />बाकुन लुत वारुत लागाड़तु रह्‌यु, तत्‌यार मेजवान्‌या तीनाक ने तेरी घरवाळीक ने दुयु पुरेन हात धरीन तीनुक बचाड़ीन बाहर ली ज्‌यु, काहाकी यहोवा भगवानेन दया तींद्‌रे पर हतली। <verse eid="GEN 19:16" /><verse number="17" style="v" sid="GEN 19:17" />जत्‌यार चे बाहर ली आया, ती तींद्‌रेम सी एक जणु कह्‌यु, “आपणा जीव बचाड़ीन ढासु! पछु फीरीन घुण देखु ने घाट्‌ये घुण उभा रहु! बयड़ा मां जाती रहु, नीही ते तुहुंं आखा खत्‌तम हय जासु।”<verse eid="GEN 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 19:18" />बाकुन लुत तींद्‌रे सी लीलघाय्‌न कह्‌यु, “ए मारा मालीक असु मां करे! <verse eid="GEN 19:18" /><verse number="19" style="v" sid="GEN 19:19" />जत्‌यार तारा सेवक तारी गीण-दया हेरीत लेदु ने तु मारा जीव काजे बचाड़ने सी मारी परम ने दया काजे बड़ावलु छे, बयड़ा मां सातायणु मार वाटे काठो रवसे, कांखुर मां असो नी हय जाय की मार पर परेसानी आय जाय, ने मे मर जाम। <verse eid="GEN 19:19" /><verse number="20" style="v" sid="GEN 19:20" />देखु, एक सहर असो छे की मे चां ढासी सको, ने चो नानलो बी छे। मेसेक चांत ढासणी दे, काय जो सहर नानलो छे? ने मारु जीव बची जासे।”<verse eid="GEN 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 19:21" />हयु तीनाक कह्‌यु, “देख, मे ईनी वात मां बी तारी लीलघाय काजे मानो की जीना सहरेन वात तु कर्‌यु, तीनाक मे खत्‌तम नी करो। <verse eid="GEN 19:21" /><verse number="22" style="v" sid="GEN 19:22" />छाटुस चां ढासी जा, काहाकी जत्‌यार लग तु चां नी पुगे तत्‌यार लग मे काय बी नी कर सकीस।”</para>
  <para style="p" vid="GEN 19:22">तेरेसी तीना सहरेन नाव सोवर पड़्‌यो।<verse eid="GEN 19:22" /></para>
  <para style="s">सदोम ने अमोरान नास</para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 19:23" />लुत सोवर धड़े जातेत धरती पर दाहड़ु उंग्‌यु। <verse eid="GEN 19:23" /><verse number="24" style="v" sid="GEN 19:24" />तत्‌यार यहोवा आपसा भीणी सी सदोम ने अमोरा पर सरग सी आकठो ने गंधकेन ईंगाळा पाड़्‌यु, <verse eid="GEN 19:24" /><verse number="25" style="v" sid="GEN 19:25" />ने तीनु सहर काजे ने आखा घाट्‌या मां रहण्‌या ने आखा सहरेम रहण्‌या आखा माणसे काजे, खेतेन आखी मेर भेळा खत्‌तम कर देदु। <verse eid="GEN 19:25" /><verse number="26" style="v" sid="GEN 19:26" />लुतेन घरवाळी जी तेरे पछळ हतली ची पछी फीरीन देखी, ने ची नणेन खांबु बण गुय।<note caller="+" style="x"><char style="xo" closed="false">19:26 </char><char style="xt" closed="false"><ref loc="LUK 17:32">लुका 17:32</ref></char></note><verse eid="GEN 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 19:27" />संदारे अब्‌राहम उठीन तीना जागा पर गुयु, जां चु यहोवा अगळ उबु हतलु, <verse eid="GEN 19:27" /><verse number="28" style="v" sid="GEN 19:28" />ने सदोम ने अमोरा, ने तीनु घाट्‌यान पुरा देस भीणी नजर नाखीन असु देख्‌यु, की तीना देस मां सी भाटीन तसु कुळ्‌ळु नीकळी र्‌यु। <verse eid="GEN 19:28" /><verse number="29" style="v" sid="GEN 19:29" />ने असो हयो की जत्‌यार भगवान तीनु घाट्‌यान सहर काजे, जां लुत रवतेलु, उलट-पुलट करीन खत्‌तम कर देदु, तत्‌यार अब्‌राहम काजे हेर करीन लुत काजे तीनी परेसानी सी बचाड़ी लेदु।<verse eid="GEN 19:29" /></para>
  <para style="s">मोआबी ने अम्‌मोन्‌यान कळ</para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 19:30" />लुत सोवर सहर काजे छुड़ देदु, ने बयड़ा पर आपसी दुयु पुरे भेळे रहणे लाग्‌यु, काहाकी हयु सोवर मां रहणे सी बीहतेलु, तेरेमां हयु ने तेरी दुयु पुरे तीना एक दर मां रहणे लाग्‌यु। <verse eid="GEN 19:30" /><verse number="31" style="v" sid="GEN 19:31" />तत्‌यार मट्‌ली बहणीस नानली बहणीस सी कय, “हामरु बास डाहु हय ज्‌यु, ने धरती पर असु असा काहना पुर्‌या नी हय की हामु तेरे भेळे सुवजे ने अवल्‌यात पयदा करजे। <verse eid="GEN 19:31" /><verse number="32" style="v" sid="GEN 19:32" />तेरेमां आव, आपणु आपणा बास काजे अंगुरेन रस पावीन, तेरे भेळे सुवजे, काहाकी आपणा बासेन अवल्‌यात काजे बड़ावजे।” <verse eid="GEN 19:32" /><verse number="33" style="v" sid="GEN 19:33" />तेरेमां चे तीनेत रात्‌ये आपसा बास काजे अंगुरेन रस पाया, तत्‌यार मट्‌ली बेटीस जाय्‌न आपसा बास भेळे सुय गुय, बाकुन चु नी जाण्‌यु, की ची कत्‌यार सुय, ने कत्‌यार उठ गुय।<verse eid="GEN 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 19:34" />ने असो हयो की दीसरे दाहड़े मट्‌ली बेटीस नानली सी कय, देख, काल रात्‌ये मे आपणा बास भेळे सुय, तेरेमां आज बी रात्‌ये अंगुरेन रस पावजे ने तु जाय्‌न तेर भेळे सुव काहाकी आपणा बासे सी अवल्‌यात बड़ावजे। <verse eid="GEN 19:34" /><verse number="35" style="v" sid="GEN 19:35" />तेरेमां ची तीने रात्‌ये बी आपसा बास काजे अंगुरेन रस पावी, ने नानली बेटीस जाय्‌न तेरे भेळे सुय, बाकुन तीनाक तत्‌यार बी मालम नी पड़्‌यो की ची कत्‌यार सुय ने कत्‌यार उठ गुय। <verse eid="GEN 19:35" /><verse number="36" style="v" sid="GEN 19:36" />असी करीन लुतेन साहरे, लुतेन दुयु पुरे भार पाय हय गुय। <verse eid="GEN 19:36" /><verse number="37" style="v" sid="GEN 19:37" />मट्‌लीन एक पुर्‌यु हयु ने तेरो नाव मोआब पाड़ी, ची मोआब जाती आज लग छे ने डाहलु बास बण्‌यु। <verse eid="GEN 19:37" /><verse number="38" style="v" sid="GEN 19:38" />ने नानलीन बी एक पुर्‌यु हयु, ने तेरो नाव बेआनमी पाड़ी, ने ची अमोन जाती आज लग छे, ने तींद्‌रु डाहलु बास बण्‌यु।<verse eid="GEN 19:38" /></para>
  <chapter eid="GEN 19" />
  <chapter number="20" style="c" sid="GEN 20" />
  <para style="s">अब्‌राहम ने अबीमेलेक</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 20:1" />अळतेन अब्‌राहम चां सी नीकळीन दखणाव वाळा देस मां आवीन कादेस ने सुर मुलुकेन ईचमां रय्‌न, ने गरार देस मां रहणे लाग्‌यु। <verse eid="GEN 20:1" /><verse number="2" style="v" sid="GEN 20:2" />ने अब्‌राहम आपसान घरवाळी सारान बारामां कहणे लाग्‌यु, हयी मारी बहणीस छे, तेरेमां गरार देसेन राजु अबीमेलेक आपसा सीपायड़ाक कह्‌यु की साराक जां बुलाय लावु। <verse eid="GEN 20:2" /><verse number="3" style="v" sid="GEN 20:3" />रात्‌ये भगवान सपना मां अबीमेलेक धड़े आयन कह्‌यु, “सामळ, जीनी बायर काजे तु राख लेदलु छे, तेरे वजे सी तु मर जासी, काहाकी ची दीसरा सी ईयाव करली छे।”<note caller="+" style="x"><char style="xo" closed="false">20:3 </char><char style="xt" closed="false"><ref loc="GEN 12:13">उबजाणनी किताप 12:13</ref>; <ref loc="GEN 26:7">26:7</ref></char></note><verse eid="GEN 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 20:4" />बाकुन अबीमेलेक तेरे धड़े जाय्‌न नी सुयु, तेरेमां चु असु कह्‌यु, “ए मालीक, काय तु नी-गुनाळा वाळा काजे खत्‌तम कर देसी? <verse eid="GEN 20:4" /><verse number="5" style="v" sid="GEN 20:5" />काहाकी हयुत ते असु कह्‌यु, हयी मारी बहणीस छे, ने हयी बायर बी असी कय की हयु मारु भायस छे, मे ते मारा मनेन छाचाय ने खराय सी असो काम कर्‌यु।”<verse eid="GEN 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 20:6" />भगवान तीनाक सपना मां असु कह्‌यु, “हव, मे जाणों की तु वारु मनेन खराय सी असो काम करलु छे ने मे तुसेक रुकीन बी राख र्‌यु की तु मार नींगा मां असु पाप नी करे; तेरेमां तुसे तीनीक हात नी लागाड़ने देदु। <verse eid="GEN 20:6" /><verse number="7" style="v" sid="GEN 20:7" />तेरेमां हंय तीना अदमीन बायर काजे पछु दी दे, काहाकी चु भगवानेन वाती बी छे, ने तार वाटे बी दुवा करसे, ने तु जीवतु रवसी बाकुन कदी तु पछु नी आपे ती हेर राख, की तु, ने तारा जतरा बी माणसे छे, आखा मरीत जासु।”<verse eid="GEN 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 20:8" />संदारे अबीमेलेक एगुत उठीन आपसा आखा पावर्‌या काजे बुलायन जी आखी वात सामळायु, ने चे माणसे बीही ज्‌या। <verse eid="GEN 20:8" /><verse number="9" style="v" sid="GEN 20:9" />तत्‌यार अबीमेलेक अब्‌राहम काजे बुलायन कह्‌यु, “तु हामरे साते असो ज काय कर्‌यु? ने मे तारो काय बीगाड़्‌लु की तु मारे ने मारा राज्‌य पर असु मटु पाप नाख देदु? तु मारे साते असो काम कर्‌यु जो करनु नी हतलो।” <verse eid="GEN 20:9" /><verse number="10" style="v" sid="GEN 20:10" />अळतेन अबीमेलेक अब्‌राहम सी पुछ्‌यु, “तु कायन वजे सी असो काम कर्‌यु?”<verse eid="GEN 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 20:11" />अब्‌राहम असु कह्‌यु, “मे असु समजी रहलु की ईना जागा पर भगवानेन काय बी धाक नी हसे; तेरेमां मारी घरवाळीन वजे सी जे माणसे मेसेक मार नाखसे। <verse eid="GEN 20:11" /><verse number="12" style="v" sid="GEN 20:12" />एक कहे छाचलीन ची मारी बहणीस छे, हयी मारा बासेन पुरे ते छे बाकुन मारी मायन पुरे नी हय; तेबी ची मारी घरवाळी बण गुय। <verse eid="GEN 20:12" /><verse number="13" style="v" sid="GEN 20:13" />ने असो हयो की जत्‌यार भगवान मेसे मारा बासेन घर काजे छुड़ीन बाहर नीकळनेन हुकुम आप्‌यु, तत्‌यार मे तीनीक कह्‌यु, अतरी दया मार पर करजी की आपणु दुयु जां बी जाजे चां-चां तु मारा बारामां कवजी की जु मारु भायस छे।”<verse eid="GEN 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 20:14" />तत्‌यार अबीमेलेक गाडरा-बुकड़ा, गावड़ी-बेल, ने पावर-पावरनी बी अब्‌राहम काजे आप्‌यु, ने तेरी घरवाळी सारा बी तेर हातेम सुप देदु। <verse eid="GEN 20:14" /><verse number="15" style="v" sid="GEN 20:15" />ने अबीमेलेक कह्‌यु, देख, “मारो देस तारे अगळ छे, जां तुसेक भावे चां रव।” <verse eid="GEN 20:15" /><verse number="16" style="v" sid="GEN 20:16" />ने अबीमेलेक साराक कह्‌यु, “देख, मे तारा भाय काजे हजार चांदीन टका देदलु छे। जे तारी ईज्‌जतेन पयस्‌या छे, कुय बी तुसेक गुनाळी करीन वाक नी नीकाळनु चाहजे।” <verse eid="GEN 20:16" /><verse number="17" style="v" sid="GEN 20:17" />तत्‌यार अब्‌राहम यहोवा भगवान सी दुवा कर्‌यु की अबीमेलेकेन, ने तेरी घरवाळीन, ने पावरनी कुख खुल जाय ने तींद्‌रो कुख खुल गुय ने पुर्‌या हवणे लाग्‌या। <verse eid="GEN 20:17" /><verse number="18" style="v" sid="GEN 20:18" />काहाकी यहोवा अब्‌राहमेन घरवाळीन सारान वजे सी अबीमेलेकेन घरेन आखा बायरान कुखे बंद कर देदलु।<verse eid="GEN 20:18" /></para>
  <chapter eid="GEN 20" />
  <chapter number="21" style="c" sid="GEN 21" />
  <para style="s">इसाकेन पयदावारी</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 21:1" />यहोवा जसु कहलु तसुत सारान सला लीन आपसा बुलेन अनसारे कर्‌यु। <verse eid="GEN 21:1" /><verse number="2" style="v" sid="GEN 21:2" />सारा अब्‌राहम सी भार पाये हयन डाहवारा मां एक पुर्‌यु हयु, जसो की भगवान तीना टेम काजे टाकलु।<note caller="+" style="x"><char style="xo" closed="false">21:2 </char><char style="xt" closed="false"><ref loc="HEB 11:11">ईब्‌रानीयो 11:11</ref></char></note> <verse eid="GEN 21:2" /><verse number="3" style="v" sid="GEN 21:3" />अब्‌राहम आपसा पुर्‌यान नाव जु सारा सी हवलु तेरो नाव इसाक पाड़्‌यु। <verse eid="GEN 21:3" /><verse number="4" style="v" sid="GEN 21:4" />ने जत्‌यार तेरु पुर्‌यु इसाकेन आठ दाहड़ा हया, तत्‌यार हयु भगवानेन हुकुमेन अनसारे तेरी फतरी काट्‌यु।<note caller="+" style="x"><char style="xo" closed="false">21:4 </char><char style="xt" closed="false"><ref loc="GEN 17:12">उबजाणनी किताप 17:12</ref>; <ref loc="ACT 7:8">नेवताळान काम 7:8</ref></char></note> <verse eid="GEN 21:4" /><verse number="5" style="v" sid="GEN 21:5" />जत्‌यार अब्‌राहमेन पुर्‌यु इसाक हयु तत्‌यार हयु एक सोव सालेन हतलु। <verse eid="GEN 21:5" /><verse number="6" style="v" sid="GEN 21:6" />ने सारा कय, “भगवान मेसेक बेसकी खुसी आपलु छे, तेरेमां आखा सामळने वाळा बी मारे भेळे खुस रवसे।” <verse eid="GEN 21:6" /><verse number="7" style="v" sid="GEN 21:7" />अळतेन ची असी बी कय, “काय काहनुक अब्‌राहम सी कय सकतेला की सारा पुर्‌या काजे दुत पावणी बणसे? बाकुन देखु, मारे सी तेरा डाहवारा मां एक पुर्‌यु पयदा हवलु छे।”<verse eid="GEN 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 21:8" />ने चु पुर्‌यु अध्‌यु ने तेरो दुत पीणु छुड़ाया; ने इसाकेन दुत छुड़ाया तीने दाहड़े अब्‌राहम मटो खाणो खाणे करीन खादु।<note caller="+" style="x"><char style="xo" closed="false">21:8 </char><char style="xt" closed="false"><ref loc="GAL 4:22">गलातीयो 4:22</ref>; <ref loc="HEB 11:11">ईब्‌रानीयो 11:11</ref></char></note><verse eid="GEN 21:8" /></para>
  <para style="s">हाजीरा ने इस्‌माएल काजे नीकाळनु</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 21:9" />तत्‌यार साराक मीसर मां रहण्‌यु हाजीरान पुर्‌यु, जु अब्‌राहम सी हवलु, इस्‌माएल, चु हासी उडाड़तु देखाव पड़्‌यु। <verse eid="GEN 21:9" /><verse number="10" style="v" sid="GEN 21:10" />तेरेमां सारा अब्‌राहम सी कय, “ईनी पावरनी काजे तेरा पुर्‌या भेळती नीकाळ दे, काहाकी ईनी पावरनीन पुर्‌यु मारा पुर्‌याक इसाक भेळे तारा माल-धनेन हकदार्‌यु नी बण सके।”<note caller="+" style="x"><char style="xo" closed="false">21:10 </char><char style="xt" closed="false"><ref loc="GAL 4:29">गलातीयो 4:29</ref>,<ref loc="GAL 4:30">30</ref></char></note> <verse eid="GEN 21:10" /><verse number="11" style="v" sid="GEN 21:11" />जी वात अब्‌राहम काजे वारु नी लाग्‌यो काहाकी इस्‌माएल बी तेरु बेटुस हतलु। <verse eid="GEN 21:11" /><verse number="12" style="v" sid="GEN 21:12" />तत्‌यार भगवान अब्‌राहम सी कह्‌यु, “तीना पुर्‌यान ने तारी पावरनीन वजे सी तुसे भुंडो नी लागणु चाहजे, जी वात सारा तुसे कहे, तीनीक मान, काहाकी जी तारी अवल्‌यात वदणे वाळी छे ची इसाक सी वदसे।<note caller="+" style="x"><char style="xo" closed="false">21:12 </char><char style="xt" closed="false"><ref loc="ROM 9:7">रोमीयो 9:7</ref>; <ref loc="HEB 11:18">ईब्‌रानीयो 11:18</ref></char></note> <verse eid="GEN 21:12" /><verse number="13" style="v" sid="GEN 21:13" />ईनी पावरनीन पुर्‌या सी बी मे एक जाती काजे वदाड़ीस, काहाकी ची बी तारी अवल्‌यात छे।”<verse eid="GEN 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 21:14" />तेरेमां अब्‌राहम संदारे एगुत उठीन रुटा ने पाणी भरली चामड़ान थयलि बी हाजीरा आप्‌यु, ने तेरे खांदे पर मेल देदु, ने तेरा पुर्‌याक बी तीनीक आपीन मकली देदु ने ची चाल पड़ी ने बेरसेबान उजाड़्‌या बयड़ा मां भटकायणे लागी। <verse eid="GEN 21:14" /><verse number="15" style="v" sid="GEN 21:15" />जत्‌यार थयलि मायन पाणी सर ज्‌यो, तत्‌यार ची पुर्‌याक एक झाड़का तळे छुड़ीन जाती रय। <verse eid="GEN 21:15" /><verse number="16" style="v" sid="GEN 21:16" />ने पुर्‌यो नी देखाये ततरे लांबे जाय्‌न ची असी वीच्‌यार करीन बठ गुय, मारा डुळा अगळ पुर्‌यो मरसे ती मेसेक नी वेठाये ने ची ढळो-ढळो रड़ने बाजी गुय।<verse eid="GEN 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 21:17" />भगवान तीना पुर्‌यान सामळ्‌यु, ने सरगेम सी सरगेन काहवाळ्‌यु हाजीरा काजे कह्‌यु, ओय हाजीरा, तारे काय हयो? मां बीहे; काहाकी जां तारु पुर्‌यु छे चां सी तेरी अवाज भगवान काजे सामळाय देदी। <verse eid="GEN 21:17" /><verse number="18" style="v" sid="GEN 21:18" />उठ, तारा पुर्‌या काजे हाकल ने तार हात सी समाळ; काहाकी मे तेरे सी एक मट्‌ली जाती बणावीस। <verse eid="GEN 21:18" /><verse number="19" style="v" sid="GEN 21:19" />तत्‌यार भगवान तेरा डुळा काजे उघाड़ देदु, ने तीनीक एक कुवु देखाव पड़्‌यु; तत्‌यार ची जाय्‌न थयलि मां पाणी भरीन पुर्‌या काजे पावी। <verse eid="GEN 21:19" /><verse number="20" style="v" sid="GEN 21:20" />ने भगवान तीना पुर्‌या साते रह्‌यु; ने जत्‌यार चु मटु हयु, तत्‌यार बयड़ा मां रवते-रवते सीकारी बण ज्‌यु। <verse eid="GEN 21:20" /><verse number="21" style="v" sid="GEN 21:21" />चु पारान नावेन बयड़ा मां रया करतेलु। ने तेरी माय तेरे वाटे मीसर देस सी लाडी लावी।<verse eid="GEN 21:21" /></para>
  <para style="s">अब्‌राहम अबीमेलेक साते वायदु करे</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 21:22" />तीनु दाहड़ा मां असो हयो की अबीमेलेक राजु पीकोल काजे जु सीपायड़ान डाहलु हतलु, तीनाक लीन अब्‌राहम भीणी आवीन कह्‌या, जो काय तु करे तेरेम भगवान तारे साते रहे; <note caller="+" style="x"><char style="xo" closed="false">21:22 </char><char style="xt" closed="false"><ref loc="GEN 26:26">उबजाणनी किताप 26:26</ref></char></note> <verse eid="GEN 21:22" /><verse number="23" style="v" sid="GEN 21:23" />तेरेमां हंय मारे सी जां ईनी वातेम भगवानेन सगुन खा की तु नीते मारे सी धुकु करसी, ने नी कदी मारी अवल्‌यात सी करसी, बाकुन जसु दया मे तारे पर कर्‌यु, तसुत तु मारे पर ने ईना देस पर बी करजी, जीनाम तु रहे।<verse eid="GEN 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 21:24" />अब्‌राहम कह्‌यु, “मे सगुन खाम।”<verse eid="GEN 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 21:25" />ने अब्‌राहम अबीमेलेक काजे एक कुवान बारामां तीनाक अबीमेलेकेन पावर्‌या हापकी लेदला तेरे बारामां बी बताड़्‌यु। <verse eid="GEN 21:25" /><verse number="26" style="v" sid="GEN 21:26" />तत्‌यार अबीमेलेक कह्‌यु, “मे नी जाणों की कुण असो काम कर्‌यो; ने तु बी मेसेक नी बताड़्‌यु, ने नी मे आज सी पेहले ईनी वातेम बारामां काहींन सामळ्‌यु।” <verse eid="GEN 21:26" /><verse number="27" style="v" sid="GEN 21:27" />तत्‌यार अब्‌राहम गाडरा-बुकड़ा, ने गावड़ी-बेल अबीमेलेक काजे आप्‌यु; ने चे दुयुन ईचमां बुली बांद्‌या। <verse eid="GEN 21:27" /><verse number="28" style="v" sid="GEN 21:28" />अब्‌राहम गाडरान सात पीला आंग्‌ये कर्‌यु। <verse eid="GEN 21:28" /><verse number="29" style="v" sid="GEN 21:29" />तत्‌यार अबीमेलेक अब्‌राहम सी पुछ्‌यु, “ईनु सात पीला काजे, जीनुक तु आंग्‌ये कर्‌यु एरो मतलब काय छे?”<verse eid="GEN 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 21:30" />ती चु कह्‌यु, “तु ईनु सात पीला काजे ईनी वातेन गवा जाणीन मारे हाते सी ली ले की ईना कुवा काजे मेत खुद्‌यु।” <verse eid="GEN 21:30" /><verse number="31" style="v" sid="GEN 21:31" />जां चे दुयु जीना जागा पर सगुन खादा, तेरे वजे सी तेरो नाव बेरसेबा<note caller="+" style="f"><char style="fr" closed="false">21:31 </char><char style="ft" closed="false">कीर्‌यान कुवु</char></note> पड़्‌यो।<note caller="+" style="x"><char style="xo" closed="false">21:31 </char><char style="xt" closed="false"><ref loc="GEN 26:33">उबजाणनी किताप 26:33</ref></char></note><verse eid="GEN 21:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 21:32" />जत्‌यार चे दुयु बेरसेबा सहर मां आंबा-सांबा सगुन खादा, तत्‌यार अबीमेलेक ने तेरु सीपायड़ान डाहलु पीकोल, चां सी उठीन पलीस्‌ती देस मां पछा जाती र्‌या। <verse eid="GEN 21:32" /><verse number="33" style="v" sid="GEN 21:33" />अळतेन अब्‌राहम बेरसेबा मां एसेल नावेन झाड़कों लागाड़्‌यु, ने चां यहोवा सी जु जलमेन भगवान छे, तेरी भक्‌ती कर्‌यु। <verse eid="GEN 21:33" /><verse number="34" style="v" sid="GEN 21:34" />अब्‌राहम पलीस्‌तीन देस मां बेसका दाहड़ा लग पारकु बणीन रह्‌यु।<verse eid="GEN 21:34" /></para>
  <chapter eid="GEN 21" />
  <chapter number="22" style="c" sid="GEN 22" />
  <para style="s">अब्‌राहम पारख मां पड़े</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 22:1" />ईनु वातेन पछेन मां असो हयो की भगवान, अब्‌राहम सी असु कयन तेरी पारख कर्‌यु, ए अब्‌राहम! चु कह्‌यु, “देख, मे जां छे।”<note caller="+" style="x"><char style="xo" closed="false">22:1 </char><char style="xt" closed="false"><ref loc="HEB 11:17">ईब्‌रानीयो 11:17</ref></char></note><verse eid="GEN 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 22:2" />भगवान कह्‌यु, “तारा पुर्‌या काजे जु तारु एकुत लाड़कु पुर्‌यु इसाक काजे, तेरे सी तु बेसकु परम करे, तीनाक लीन मोरीया देस मां जाती रव, ने चां तीनाक एक बयड़ा पर जो मे तुसेक बताड़ीस चां बाळीन चड़ाव।”<verse eid="GEN 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 22:3" />तेरेमां अब्‌राहम संदारे एगुत उठ्‌यु ने तेरा गदड़ा पर लाकड़ा फुड़ीन फाचरा बांदीन तीयार कर लेदु, ने तेरा दुय पावर्‌या, ने तेरा पुर्‌या इसाक काजे बी भेळे लेदु, ने बाळीन चड़ावणे करीन लाकड़ा चीर लेदु, तत्‌यार नीकळीन तीना जागा भीणी चाल पड़्‌यु, तीना बारामां भगवान वात करलु। <verse eid="GEN 22:3" /><verse number="4" style="v" sid="GEN 22:4" />तीसरे दाहड़े अब्‌राहम उंचु भाळीन तीना जागा काजे लांबे सी देख्‌यु। <verse eid="GEN 22:4" /><verse number="5" style="v" sid="GEN 22:5" />ने चु तेरा पावर्‌या काजे कह्‌यु, “गदड़ा धड़े जांत तु रव; पुर्‌यु ने मे चां लग जाय्‌न, ने आंधीन, पछा तुंद्‌रे धड़े आय जासुन।”<verse eid="GEN 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 22:6" />तत्‌यार अब्‌राहम बाळीन चड़ावु करने करीन लाकड़ा लीन आपसा पुर्‌या इसाक पर मेक्‌यु, ने आकठो ने छुरु आपसा हात मां लेदु; ने चे दुयु भेळात चाल पड़्‌या। <verse eid="GEN 22:6" /><verse number="7" style="v" sid="GEN 22:7" />इसाक आपसा बास अब्‌राहम सी कह्‌यु, “ए मारा बास,”</para>
  <para style="p" vid="GEN 22:7">चु कह्‌यु देख, आकठो ने लाकड़ा ते छे;</para>
  <para style="p" vid="GEN 22:7">बाकुन भाळीन चड़ावा वाटे गाडरो कां छे?<verse eid="GEN 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 22:8" />अब्‌राहम कह्‌यु, “ए मारा पुर्‌या, भगवान बादा चड़ावणेन करीन गाडरान तज्‌बु भगवानुत कर देसे।” ने दुयु भेळे-भेळे अगा चालता गुया।<verse eid="GEN 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 22:9" />जत्‌यार चे तीना जागा काजे जीनाक भगवान बताड़लु चां पुग ज्‌या; तत्‌यार अब्‌राहम चां चड़ावान जागु बणायन लाकड़ा काजे वारु जमाड़ीन मेक्‌यु, ने आपसा पुर्‌याक इसाक काजे बांदीन चड़ावान जागे मेकला लाकड़ा पर मेक देदु।<note caller="+" style="x"><char style="xo" closed="false">22:9 </char><char style="xt" closed="false"><ref loc="JAS 2:21">याकुब 2:21</ref></char></note> <verse eid="GEN 22:9" /><verse number="10" style="v" sid="GEN 22:10" />अळतेन अब्‌राहम अघुस हात करीन चक्‌कु लेदु काहाकी आपसा पुर्‌याक चड़ावु करे। <verse eid="GEN 22:10" /><verse number="11" style="v" sid="GEN 22:11" />तत्‌यार यहोवान सरगेन काहवाळ्‌यु हीनाक आयड़ीन कह्‌यु,</para>
  <para style="p" vid="GEN 22:11">अब्‌राहम हीयु जपाप आप्‌यु काय मे जान छे।<verse eid="GEN 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 22:12" />हीयु कह्‌यु, “तार पुर्‌या पर चक्‌कु घुण मेके ने नी तेरो काहींन करे, काहाकी तु मेसे काजे तारा पुर्‌या काजे देणे बी तीयार हय ज्‌यु, मतलब तारु एकुत पुर्‌यु जु तारु लाटेकलु छे, तेरेसी मे जाणी ज्‌यु की तु भगवानेन धाक माने।”<verse eid="GEN 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 22:13" />तत्‌यार अब्‌राहम च्‌यारे-मेर देखणे लाग्‌यु ती देखाव पड़्‌यो, की तेर पछळ एक गाडरो आपसा सींगड़ा सी झाड़का मां गुताय रवलो, ने अब्‌राहम जाय्‌न तीना केवड़ा काजे लायु, ने आपसा पुर्‌यान जागे तीना काजे भाळीन चड़ायु। <verse eid="GEN 22:13" /><verse number="14" style="v" sid="GEN 22:14" />अब्‌राहम तीना जागान नाव यहोवा यीरे पाड़्‌यु, तेरेमां आज बी कहे की, “यहोवान बयड़ा पर देणे वाळु बणसे।”<verse eid="GEN 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 22:15" />अळतेन यहोवान सरग काहवाळ्‌यु अळी बी सरग सी अब्‌राहम काजे कह्‌यु, <verse eid="GEN 22:15" /><verse number="16" style="v" sid="GEN 22:16" />“यहोवा भगवान असु कहे की, मे मारीत सगुन खायन कहो की तु असो काम कर्‌यु की तारा पुर्‌याक, मतलब एकुत पुर्‌यु जु तारु लाड़कु हतलु तीनाक बी देणे करीन तीयार हय ज्‌यु;<note caller="+" style="x"><char style="xo" closed="false">22:16 </char><char style="xt" closed="false"><ref loc="HEB 6:13">ईब्‌रानीयो 6:13</ref>,<ref loc="HEB 6:14">14</ref></char></note> <verse eid="GEN 22:16" /><verse number="17" style="v" sid="GEN 22:17" />तेरेमां छाचलीन तुसे संयबरकत आपीस, ने छाचलीन तारी अवल्‌यात काजे तारान तसा, ने दरीयान आड़े-धड़ेन रेतळा मां पीठीन तसु जीनाक गीणाये नी तसु करीस ने तारा अवल्‌यात दुसमन्‌यान सहरेक जीत्‌या करसी;<note caller="+" style="x"><char style="xo" closed="false">22:17 </char><char style="xt" closed="false"><ref loc="HEB 11:12">ईब्‌रानीयो 11:12</ref></char></note> <verse eid="GEN 22:17" /><verse number="18" style="v" sid="GEN 22:18" />ने धरतीन आखा जात्‌या तुसे तारा अवल्‌यातेन वजे सी बरकत वाळु मानसे, काहाकी तु मारी वात मान्‌यु।” <verse eid="GEN 22:18" /><verse number="19" style="v" sid="GEN 22:19" />तत्‌यार अब्‌राहम आपसा पावर्‌या धड़े जाती र्‌यु, ने चे आखा बेरसेबा भीणी भेळा गुया; ने अब्‌राहम बेरसेबा मां रहणे लाग्‌यु।<verse eid="GEN 22:19" /></para>
  <para style="s">नाहोरेन खानदानी</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 22:20" />ईनी वातेन पछेन असो हयो की अब्‌राहम काजे खबर जड़ी, “तारा भायस नाहोर तेरी घरवाळी मील्‌का सी पुर्‌या हया।” <verse eid="GEN 22:20" /><verse number="21" style="v" sid="GEN 22:21" />मीलकान पुर्‌या जे छे मतलब तेरु पेहलु पुर्‌यु, उस, ने उसेन भायस बुज, ने कमुएल, जु अरामेन बास छे। <verse eid="GEN 22:21" /><verse number="22" style="v" sid="GEN 22:22" />अळी केसेद, हजो, पीलदास, यीदलाप ने बतुएल। <verse eid="GEN 22:22" /><verse number="23" style="v" sid="GEN 22:23" />ईनु आठु काजे मील्‌का ने अब्‌राहमेन भायस नाहोर सी पयदा हया। ने बतुएल सी रीबकान बास हतलु। <verse eid="GEN 22:23" /><verse number="24" style="v" sid="GEN 22:24" />नाहोर एक अळी पावरनी काजे बणावलु, तेरो नाव रुमा हतलो, तीनी पावरनीन च्‌यार पुर्‌या हया; तेब्‌यु, गहम, तहस ने माक्‌यु हयु।<verse eid="GEN 22:24" /></para>
  <chapter eid="GEN 22" />
  <chapter number="23" style="c" sid="GEN 23" />
  <para style="s">सारान मुत ने अगा कर्‌या</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 23:1" />जत्‌यार सारा एक सोव सत्‌तावीस साल लग जीन्‌दी रय, <verse eid="GEN 23:1" /><verse number="2" style="v" sid="GEN 23:2" />तत्‌यार ची हेबरोन मां मर गुय, जो कनान देस मां छे, तेरेमां अब्‌राहम चां गुयु ने रड़्‌यु।<verse eid="GEN 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 23:3" />तत्‌यार अब्‌राहम धड़ेन चां सी उठीन हीत्‌यु माणसे सी कहणे लाग्‌यु,<note caller="+" style="x"><char style="xo" closed="false">23:3 </char><char style="xt" closed="false"><ref loc="HEB 11:9">ईब्‌रानीयो 11:9</ref>,<ref loc="HEB 11:13">13</ref></char></note> <verse eid="GEN 23:3" /><verse number="4" style="v" sid="GEN 23:4" />“मे तुंद्‌रेन चां पाहनत्‌यु ने पारकु छे; मेसेक तुहुंं हड़वाय वाटे जागु आपु, चु मारुत हय जाय, काहाकी मे ईनी धड़ काजे गाड़ीन मारा डुळा सी छेटु करों।”<verse eid="GEN 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 23:5" />ती हीत्‌ती जातीन माणसे अब्‌राहम काजे जपाप आप्‌या, <verse eid="GEN 23:5" /><verse number="6" style="v" sid="GEN 23:6" />“ए हामरा मालीक, हामरी सामळ; तु ते हामरु मुखी माणुस छे। हामरी हड़वाय मां जां तु चाहे चां धड़ काजे गाड़ दे, हामरेम सी काहनु बी हड़वायन जागु लेणे सी काहनु बी नी रुके, ने तु चां तारी घरवाळी काजे जां गाड़ सक्‌सी।”<verse eid="GEN 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 23:7" />तत्‌यार अब्‌राहम उठीन उबु हय ज्‌यु, ने हीत्‌या माणसे अगळ, जे तीना देस मां रवतेला, तींद्‌रे पाये पड़ीन कहणे लाग्‌यु, <verse eid="GEN 23:7" /><verse number="8" style="v" sid="GEN 23:8" />“कदी तुंद्‌री असी मरजी छे की मे ईना धड़ काजे गाड़ीन मार डुळा सी छेटे करों, ती मे लीलघाय्‌न कहो, की सोहरेन पुर्‌यु एपरोन काजे कहु, <verse eid="GEN 23:8" /><verse number="9" style="v" sid="GEN 23:9" />की चु तेरा मकपेला वाळी नावेन दर, चो तेरा खेत धड़े छे; मेसे काजे मुल आप दे, काहाकी चु जागु तुंद्‌रे चां हड़वाय मारुत जागु हय जाय।”<verse eid="GEN 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 23:10" />एपरोन ते हीत्‌तीयान ईचमां बठी रहलु, तेरेमां जतरा बी हीत्‌या माणसे तेरे सहरेन फाटक मायन माहीं जातला, तीनु आखा अगळ हयु अब्‌राहम काजे जपाप आप्‌यु, <verse eid="GEN 23:10" /><verse number="11" style="v" sid="GEN 23:11" />“ए मारा मालीक, असो नी, मारी सामळ; चु जागु तुसे आपो, ने तेरेम जु दर छे, चु बी आपो; आपणा जाती वाळा माणसे अगळ मे तुसे आपो; काहाकी तु तारा मरला काजे हड़वाये पर मेकी सके।”<verse eid="GEN 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 23:12" />तत्‌यार अब्‌राहम तीना देसेन रहणे वाळान माणसे अगळ पाये पड़्‌यु। <verse eid="GEN 23:12" /><verse number="13" style="v" sid="GEN 23:13" />ने तेरी सामळतु जाय्‌न एपरोन सी कह्‌यु, “कदी तु असु चाहे, ती मारी सामळ; तीना जागान जतरी कीमत छे, चो मे देणे हींडर्‌यु; ततरा पयस्‌या मारे सी ली ले, तत्‌यार मे ईना धड़ काजे चां गाड़ दीस।”<verse eid="GEN 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 23:14" />एपरोन अब्‌राहम काजे जपाप आप्‌यु, <verse eid="GEN 23:14" /><verse number="15" style="v" sid="GEN 23:15" />“ए मारा मालीक, मारी वात सामळ; तीना जागान कीमत ते चार सोव चांदीन सीक्‌का छे; बाकुन मारे ने तारे ईचमां अतरी कीमत ते काय नी हय,तेरेमां असुत ली ले ने तारा मरला काजे हड़वाय पर मेक दे।” <verse eid="GEN 23:15" /><verse number="16" style="v" sid="GEN 23:16" />अब्‌राहम एपरोनमेन वात मानीन तेरो कीमतेन सीक्‌का तुलीन आप देदु, जतरा हयु हीत्‌या माणसे अगळ कहलु, मतलब चार सोव चांदीन सीक्‌का जे लेण-देण मां करतेला।<verse eid="GEN 23:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 23:17" />तसु करीन एपरोनमेन जागु, जु मम्‌रे नावेन जागा अगळ मकपेला मां हतली, चांहान दर समेत, ने तीनु आखा झाड़का भेळे जे बी तेरेम हतला ने तेरे च्‌यारे-मेर सेडे लग आप देदु, <verse eid="GEN 23:17" /><verse number="18" style="v" sid="GEN 23:18" />ने जतरा हीत्‌या तेरे सहरेन फाटक मायन माहीं जातला, तीनु आखा अब्‌राहमेन हक मां आय गुय।<note caller="+" style="x"><char style="xo" closed="false">23:18 </char><char style="xt" closed="false"><ref loc="ACT 7:6">नेवताळान काम 7:6</ref></char></note><verse eid="GEN 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 23:19" />तेरे पछेन अब्‌राहम आपसान घरवाळी सारान धड़ काजे तीना मकपेला वाळी जागेन दर मां जो मम्‌रे मतलब हेबरोन अगळ कनान देस मां हतली, चां गाड़्‌यु। <verse eid="GEN 23:19" /><verse number="20" style="v" sid="GEN 23:20" />तसु करीन चु जागाम दर समेत, जो तेरेम हतलो, हीत्‌या माणसेन मदत सी हड़वायन जागु अब्‌राहमेन हक मां आय ज्‌यु।<verse eid="GEN 23:20" /></para>
  <chapter eid="GEN 23" />
  <chapter number="24" style="c" sid="GEN 24" />
  <para style="s">इसाकेन ईयाव</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 24:1" />अब्‌राहम जत्‌यार डाहु हय गुयलु ने तेरा बेसका साल हय गुयला, ने यहोवा भगवान आखी वात मां तीनाक संयबरकत आप्‌यु। <verse eid="GEN 24:1" /><verse number="2" style="v" sid="GEN 24:2" />अब्‌राहम आपसा डाहला पावर्‌याक जु तेरा घरेन ने आखी चीजेक समाळनेन तेर हक मां हतलो, तीनाक बुलायन कह्‌यु, “तारु हात मार सातळ्‌या तळे मेक; <verse eid="GEN 24:2" /><verse number="3" style="v" sid="GEN 24:3" />ने मारे सी सरग ने धरतीन भगवान यहोवान अगळ ईनी वात मां सगुन खा, की तु मारा पुर्‌या वाटे कनानी माणसेन पुरे मां सी, जींद्‌रा ईचमां मे रह, चां सी काहनी काजे बी घुण लावु। <verse eid="GEN 24:3" /><verse number="4" style="v" sid="GEN 24:4" />बाकुन तु मारा देस मां मारात कुटुम्‌या मां जाय्‌न मारा पुर्‌या इसाक वाटे लाडी बणावजी।”<verse eid="GEN 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 24:5" />पावर्‌यु तीनाक कह्‌यु, “कदी ची पुरे ईना देस मां मार भेळे नी आवणे चाहसे; ती काय मेसे तारा पुर्‌या काजे तीना देस मां जासी तु आयु, चां ली जाणु पड़से?”<verse eid="GEN 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 24:6" />अब्‌राहम तीनाक कह्‌यु, “संभ्‌ळीन रव, मारा पुर्‌या काजे चां कदी घुण ली जाजी।” <verse eid="GEN 24:6" /><verse number="7" style="v" sid="GEN 24:7" />सरगेन भगवान यहोवा, जु मेसेक मारा बासेन घर सी ने मारी पयदावारीन जागे सी ली आवीन मार सी सगुन खायन कह्‌यु, की “मे ज देस तारा अवल्‌यात काजे आप दीस; हयुत सरग काहवाळ्‌यु तारे अगळ-अगळ मकलसे, काहाकी तु मारा पुर्‌या वाटे चां सी एक लाडी ली आवे। <verse eid="GEN 24:7" /><verse number="8" style="v" sid="GEN 24:8" />ने कदी ची पुरे तार भेळे नी आवणे चाहे तत्‌यार ते तु मारी सगुन सी छुट जासी; बाकुन मारा पुर्‌या काजे चां घुण ली जाय।” <verse eid="GEN 24:8" /><verse number="9" style="v" sid="GEN 24:9" />तत्‌यार चु पावर्‌यु आपसा मालीक अब्‌राहमेन सातळ्‌या तळे आपसान हात मेकीन तीना भेळे ईनी वातेन बारामां सगुन खादु।<verse eid="GEN 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 24:10" />तत्‌यार चु पावर्‌यु आपसा मालीकेन उटड़ा मां सी दस उटड़ा छाटीन ने तेरा वारु-वारु चीज मां सी काहींन-काहींन लीन गुयु; ने मेसोपोटामीया मुलुक मां नाहोर नावेन सहर धड़े पुग्‌यु। <verse eid="GEN 24:10" /><verse number="11" style="v" sid="GEN 24:11" />ने हयु उटड़ा काजे सहरेन बाहर एक कुवा धड़े बठाड़्‌यु। तत्‌यार सांती वेळाय हतलो, तीने टेमे पुरे पाणी भरने नीकळे। <verse eid="GEN 24:11" /><verse number="12" style="v" sid="GEN 24:12" />चु कहणे लाग्‌यु, “ए मारा मालीक अब्‌राहमेन भगवान यहोवा, आज मारा काम काजे पुरो कर, ने मारा, मालीक अब्‌राहम पर दया कर। <verse eid="GEN 24:12" /><verse number="13" style="v" sid="GEN 24:13" />देख, मे पाणीन ईना कुवा धड़े उबु हय र्‌यु; ने सहर मां रहण्‌यान पुरे पाणी भरने करीन आवणे बाजी रय <verse eid="GEN 24:13" /><verse number="14" style="v" sid="GEN 24:14" />तेरेमां असो हवणे दे की मे जीनी पुरे सी कहों, तारो गुळो मार भीणी कर ने मे पीणे हय र्‌यु, ने ची कहे, ‘ले पी ले, अळतेन तारा उटड़ा काजे बी पाय दीस,’ ची हयीत हवणु चाहजे जीनीक तु आपसा इसाक वाटे ठहरावलु छे; तत्‌यार मे जाणी लीस की तु मारा मालीक पर दया करलु छे।”<verse eid="GEN 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 24:15" />ने असो हयो की जत्‌यार चु कय रहलु ने रीबका, जी अब्‌राहमेन भाय नाहोर सी पयदा हवली ने मील्‌कान पुर्‌यु, बतुएलेन पुरे हतली, ची खांदे पर गुळो मेकीन आवी। <verse eid="GEN 24:15" /><verse number="16" style="v" sid="GEN 24:16" />रीबका बेसकी घाटाळी, ने कुवारली हतली, ने काहना बी पुर्‌यान मुंहडो नी देखली। ची कुवा मां पाणी धड़े उतरी, ने आपसीत गुळा काजे भरीन बाहर नीकळी। <verse eid="GEN 24:16" /><verse number="17" style="v" sid="GEN 24:17" />तत्‌यार चु पावर्‌यु तीनीक भेळु हवणे दवड़्‌यु, ने कह्‌यु, “तारा गुळा मायन पाणी मेसेक ईतरोक पाव।”<verse eid="GEN 24:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 24:18" />ची कय, “ए मारा मालीक, ले, पी ले,” ने ची मामार गुळाक हेटी उतारीन हातेम ली-लीन तीनाक पाणी पाय। <verse eid="GEN 24:18" /><verse number="19" style="v" sid="GEN 24:19" />जत्‌यार ची तीनाक पाय देदी, तत्‌यार कय, “मे तारा उटड़ा काजे बी पाणी भरीन पाय दीस जां लग चे पीसे।” <verse eid="GEN 24:19" /><verse number="20" style="v" sid="GEN 24:20" />तत्‌यार ची मामार आपसा गुळाक खाली करीन पछी ची कुवे पाणी भरने गुय; ने तेरा आखा उटड़ा काजे पीणेन पाणी भर देदी। <verse eid="GEN 24:20" /><verse number="21" style="v" sid="GEN 24:21" />ने चु पावर्‌यु तेर भीणी एक-हेट्‌यु हयन भाळतु जाय्‌न असु वीचार कर्‌यु की यहोवा मारा काम काजे कर देदु की नी।<verse eid="GEN 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 24:22" />जत्‌यार उटड़ा पाणी पी लेदला, तत्‌यार चु पावर्‌यु छव गराम सोनान नाकेन काटु हेड़ीन तीनीक आप्‌यु, ने सोव गराम सोनान दुय कड़ा बी आप्‌यु; <verse eid="GEN 24:22" /><verse number="23" style="v" sid="GEN 24:23" />ने पुछ्‌यु, “तु कुणीन पुरे छे? मेसेक बताड़। काय तारा बासेन घर हामरे वाटे रहणेन जागु छे?”<verse eid="GEN 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 24:24" />ची जपाप आपी, “मे ते नाहोर सी पयदा हवली मील्‌कान पुर्‌यु बतुएलेन पुरे छे।” <verse eid="GEN 24:24" /><verse number="25" style="v" sid="GEN 24:25" />अळतेन ची तीनाक कय, “हामरेन्‌चां आखा पुळा ने चारु रेट छे, ने रहणे वाटे जागु बी छे।”<verse eid="GEN 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 24:26" />तत्‌यार यहोवा काजे चु पावर्‌यु पाये पड़ीन आंधीन कह्‌यु, <verse eid="GEN 24:26" /><verse number="27" style="v" sid="GEN 24:27" />“अब्‌राहमेन यहोवा भगवानेन बड़ाय हवे, जु आपसा दया ने खराय काजे मारा मालीक सी छेटु नी कर्‌यु: यहोवा मेसेक वारलु वाटे चालाड़ीन मारा मालीकेन कुटुमेन घर पर लायु।”<verse eid="GEN 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 24:28" />तत्‌यार ची जुवान पुरे दवड़ीन आपसी माय काजे ईनी वातेन बारामां आखो काय बताड़ देदी। <verse eid="GEN 24:28" /><verse number="29" style="v" sid="GEN 24:29" />तत्‌यार रीबकान भायस लाबान हतलु चु बाहर कुवा भीणी दवड़ीन गुयु जां अब्‌राहमेन पावर्‌यु हतलु। <verse eid="GEN 24:29" /><verse number="30" style="v" sid="GEN 24:30" />रीबकान भाय हतलु लाबान चु नाकेन काटु ने आपसान बहणीसेन हाते कड़ा बी देख्‌यु, ने तेरी असी वात बी सामळ्‌यु की चु माणुस मारे सी असी वात कह्‌यु; तत्‌यार चु तीना माणुस धड़े गुयु; ने असु देख्‌यु की चु पाणी धड़े उटड़ान चां उबु हय र्‌यु। <verse eid="GEN 24:30" /><verse number="31" style="v" sid="GEN 24:31" />ती चु कह्‌यु, “ए यहोवा भीणी सी संयबरकत वाळा माणुस माहीं आव तु काहा बाहर उबु हय र्‌या? मे तार वाटे रहणे करीन घरमां जागु तीयार कर देदलु छे, ने उटड़ा वाटे बी जागु तीयार कर देदलु छे।”<verse eid="GEN 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 24:32" />ईनी वात पर चु माणुस घर मां गुयु; ने लाबान उटड़ान झुळनो छुड़ीन पुळा ने चारु आप्‌यु; ने तेरा ने तेरे साते आवला माणसेन बी पाय धुवणे करीन पाणी आप्‌यु। <verse eid="GEN 24:32" /><verse number="33" style="v" sid="GEN 24:33" />तत्‌यार अब्‌राहम पावर्‌या अगळ खाणे-पीणेन काहींन मेक्‌या; बाकुन चु असु कह्‌यु “मे जत्‌यार लग मे काहा आयु चो नी कहों तत्‌यार लग मे नी खाम।”</para>
  <para style="p" vid="GEN 24:33">लाबान कह्‌यु, “कय दे।”<verse eid="GEN 24:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 24:34" />तत्‌यार चु कह्‌यु, मे ते अब्‌राहमेन पावर्‌यु छे। <verse eid="GEN 24:34" /><verse number="35" style="v" sid="GEN 24:35" />यहोवा मारा मालीक काजे बेसकु मटु संयबरकत आपलु छे; तेरेमां चु बेसकु माल-धन वाळु माणुस हय ज्‌यु; ने चु तीनाक गाडरा-बुकड़ा, गावड़ी-बेल, सोनो-चांदी, पावर-पावरनी, उटड़ा ने गदड़ा बी आप्‌यु। <verse eid="GEN 24:35" /><verse number="36" style="v" sid="GEN 24:36" />ने मारा मालीकेन घरवाळी सारान डाहवारा मां तीनीक एक पुर्‌यु हयु; ने तीना पुर्‌या काजे अब्‌राहम आपसान हतलो चो आखो चीज आप देदलु छे। <verse eid="GEN 24:36" /><verse number="37" style="v" sid="GEN 24:37" />मारु मालीक मार सी असु सगुन खावाड़लु छे की मे तारा पुर्‌या वाटे कनानी जातीन पुरे मां सी जां मे रह, चां सी नी लावो। <verse eid="GEN 24:37" /><verse number="38" style="v" sid="GEN 24:38" />मे तेरा बासेन माणसे, ने कुटुमेन माणसेन्‌चां जाय्‌न तेरा पुर्‌या वाटे एक कुवारली पुरे ली आवीस। <verse eid="GEN 24:38" /><verse number="39" style="v" sid="GEN 24:39" />तत्‌यार मे मारा मालीक सी कह्‌यु, कदी ची पुरे मार पछळ नी आवे। <verse eid="GEN 24:39" /><verse number="40" style="v" sid="GEN 24:40" />तत्‌यार चु मेसेक कह्‌यु, यहोवा, तेर अगळ मे चालतु आवलु छे, चु तारे साते सरगेन काहवाळ्‌याक मकलीन तारा काम काजे पुरो करसे; ने तु मारा माणसे, ने मारा बासेन घरन्‌यात मां सी मार पुर्‌या वाटे लाडी ली आवजी। <verse eid="GEN 24:40" /><verse number="41" style="v" sid="GEN 24:41" />तु तत्‌यारुत मारी ईनी सगुन सी छुटसी, जत्‌यार लग तु मारा कुटुमेन माणसे धड़े नी जासी; ने कदी चे तुसेक पुरे नी आपे, ती तु मारी सगुन सी छुट जासी।<verse eid="GEN 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 24:42" />तेरेमां मे आज तीना कुवा धड़े आवीन कहणे लाग्‌यु, ए मारा मालीक अब्‌राहमेन भगवान यहोवा, कदी तु मारा ईना काम काजे पुरो करतु हय; <verse eid="GEN 24:42" /><verse number="43" style="v" sid="GEN 24:43" />ती देख मे पाणीन ईना कुवा धड़े उबु हय र्‌यु; ने असो हवे की जी पुरे पाणी भरने करीन आवे, ने मे तीनीक कहों, “तारा गुळा मां सी थुड़क पाणी पाव,” <verse eid="GEN 24:43" /><verse number="44" style="v" sid="GEN 24:44" />ने ची मेसेक कहे, “पी ले, ने मे तारा उटड़ा वाटे बी पीणेन पाणी भर दीस,” ची हयीत पुरे हवणु चाहजे जीनीक तु मारा मालीकेन पुर्‌या वाटे ठहरावलु छे। <verse eid="GEN 24:44" /><verse number="45" style="v" sid="GEN 24:45" />मे मन मां असु कय रहलु, ने तत्‌यारुत रीबका खांदा पर गुळो लीन आवतेली; अळतेन ची पाणी धड़े उतरीन भरने लागी। मे तीनीक कह्‌यु, मेसेक पाणी पाव। <verse eid="GEN 24:45" /><verse number="46" style="v" sid="GEN 24:46" />ने ची मामार आपसा गुळा काजे खांदे सी उतारीन कय, ले, पी ले, अळतेन मे तारा उटड़ा काजे बी पाय दीस, तसु करीन मे पी लेदु, ने ची उटड़ा काजे बी पाय देदी। <verse eid="GEN 24:46" /><verse number="47" style="v" sid="GEN 24:47" />तत्‌यार मे तीनीक पुछ्‌यु, तु कुणीन पुरे छे? ने ची कय, मे ते नाहोर सी पयदा हवली मील्‌कान पुर्‌यु बतुएलेन पुरे छे, तत्‌यार मे तीनीक नाकेम पेहरन्‌यु काटु, ने तेरा हातेम पेहरन्‌या कड़ा बी आप देदु। <verse eid="GEN 24:47" /><verse number="48" style="v" sid="GEN 24:48" />अळतेन मे पाये पड़ीन यहोवा भगवान काजे आंध्‌यु, ने मारा मालीक अब्‌राहमेन भगवान यहोवा काजे वारु कह्‌यु, काहाकी चु मेसेक वारलु वाटे पर लायु की मे मारा मालीकेन पुर्‌या वाटे सगासाय मां सी पुरे ली आवों। <verse eid="GEN 24:48" /><verse number="49" style="v" sid="GEN 24:49" />तेरेमां हंय, कदी तुहुंं मारा मालीक साते दया ने खरायन वेहवार करने चाहे, ती मेसेक कहु; ने कदी नी चाहता, तेबी मेसेक कय देवु; काहाकी मे जेवड़्‌ये नीते डाखर्‌ये हात भीणी जाम।<verse eid="GEN 24:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 24:50" />तत्‌यार लाबान ने बतुएल जपाप आप्‌या, “जी वात यहोवा भगवानेन मरजी सी हवली छे; तेरेमां हामु तारे सी भलो कय सकसे ने नीते बुरो। <verse eid="GEN 24:50" /><verse number="51" style="v" sid="GEN 24:51" />देख, रीबका तारे अगळ छे, तीनीक ली जा, ने ची यहोवान बुलेन अनसारे, तारा मालीकेन पुर्‌यान लाडी बण जाय।” <verse eid="GEN 24:51" /><verse number="52" style="v" sid="GEN 24:52" />जत्‌यार अब्‌राहमेन पावर्‌यु तींद्‌री वात सामळ्‌यु, तत्‌यार चु पाये पड़ीन यहोवा काजे आंध्‌यु। <verse eid="GEN 24:52" /><verse number="53" style="v" sid="GEN 24:53" />अळतेन चु पावर्‌यु सोनान ने चांदीन रकम, पुथल्‌या हेड़ीन रीबका काजे आप्‌यु; ने तेरा भायस काजे ने माय काजे बी चु महंगली रकम आप्‌यु।<verse eid="GEN 24:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="GEN 24:54" />तत्‌यार चु ने तेरा साती पुठ्‌ये खादा ने पीदा। चे चांत रात रया, जत्‌यार चे संदारे सुयन उठ्‌या ती पावर्‌यु कह्‌यु, हंय मेसे मारा मालीक धड़े जाणेन हुकुम आप दे।<verse eid="GEN 24:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="GEN 24:55" />रीबकान भाय ने माय कह्‌या, पुरे काजे हाल थुड़ाक दाहड़ा मतलब दसेक दाहड़ा लग हामरे धड़े रहणी दे। तेर पछेन ची जां सी जाय सके।<verse eid="GEN 24:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="GEN 24:56" />बाकुन चु कह्‌यु तीनुक कह्‌यु, मेसेक मां रुकु, काहाकी यहोवा मारा काम काजे पुरो करलु छे।<verse eid="GEN 24:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="GEN 24:57" />चे कह्‌या, हामु पुरे काजे बुलायन पुछी लेजे की ची काय कहे।<verse eid="GEN 24:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="GEN 24:58" />ने चे रीबका काजे बुलाया ने पुछ्‌या, “काय तु ईना माणीस पुठ्‌ये जासी?” ची कय।</para>
  <para style="p" vid="GEN 24:58">“हव मे जायस।”<verse eid="GEN 24:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="GEN 24:59" />तत्‌यार चे रीबका, ने तेरी डाहली पावरनी ने अब्‌राहमेन पावर ने तेरा साती आखा काजे मकली देदा। <verse eid="GEN 24:59" /><verse number="60" style="v" sid="GEN 24:60" />ने रीबका काजे संयबरकत आपीन कह्‌या, ओ हामरी बहणीस,</para>
  <para style="q1" vid="GEN 24:60">तु हजारु लाखु माणसेन डाहली माय छे,</para>
  <para style="q1" vid="GEN 24:60">ने तारा अवल्‌यात तींद्‌रा दुसमनेन सहर काजे जीत लेय।<verse eid="GEN 24:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="GEN 24:61" />तत्‌यार रीबका आपसीन जुवान साती वाळी भेळे चाल पड़ी; ने उटड़ा पर चहड़ीन तीनु माणसे पुठ्‌ये बठ गुय। तसा करीन चु पावर्‌यु रीबका काजे भेळे लीन चाल पड़्‌यु।<verse eid="GEN 24:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="GEN 24:62" />इसाक जु की दखणाव देस मां रवतेलु, चु लहेरोई नावेन कुवा धड़े नेगेव नावेन उजाड़्‌या बयड़ा मां आयु। <verse eid="GEN 24:62" /><verse number="63" style="v" sid="GEN 24:63" />सांतीन टेमे चु खळदान मां चालने-फीरने नीकळ्‌यु ने चु उंचु भाळीन भाळ्‌यु ती असु देख्‌यु की उटड़ा आवणे बाजी र्‌या। <verse eid="GEN 24:63" /><verse number="64" style="v" sid="GEN 24:64" />रीबका उची भाळी ती इसाक देखाव पड़्‌यु, देखतेत चु उटड़ा पर सी उतरी पड़ी। <verse eid="GEN 24:64" /><verse number="65" style="v" sid="GEN 24:65" />तत्‌यार ची अब्‌राहमेन पावर्‌या सी पुछी की, जु माणुस खळदान मायन हामरे सी भेळु हवणे आवणे बाजी र्‌यु, चु कुण छे?</para>
  <para style="p" vid="GEN 24:65">पावर्‌यु कह्‌यु, हयु ते मारु मालीक छे। तत्‌यार रीबका घुमतु करीन आपसा मुंहडा काजे ढाक लेदी।<verse eid="GEN 24:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="GEN 24:66" />पावर्‌यु इसाक काजे जो काय आपसा साते वीत्‌यो चो आखो कह्‌यु। <verse eid="GEN 24:66" /><verse number="67" style="v" sid="GEN 24:67" />तत्‌यार इसाक रीबका काजे तम्‌बु मां ली ज्‌यु जां तेरी माय रवतेली, ने तीनी सी ईयाव करीन तेरेसी परम कर्‌यु। तत्‌यार चु खुस हयु, काहाकी तेरी माय सारा मर गुय करीन दुखी हतलु।<verse eid="GEN 24:67" /></para>
  <chapter eid="GEN 24" />
  <chapter number="25" style="c" sid="GEN 25" />
  <para style="s">अब्‌राहमेन दीसरी खानदानी</para>
  <para style="r">(<ref loc="1CH 1:32-33">1 ईतीहास 1:32-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 25:1" />अब्‌राहम एक अळी बायर सी ईयाव कर्‌यु, तेरो नाव कतुरा हतलो। <verse eid="GEN 25:1" /><verse number="2" style="v" sid="GEN 25:2" />ची जीमरान, योकसान, मदना, मीद्‌यान, यीसबाक, ने सुह काजे पयदा करी। <verse eid="GEN 25:2" /><verse number="3" style="v" sid="GEN 25:3" />योकसान सी सबा ने ददान हया; ने ददानेन अवल्‌यात अस्‌सुरी, लतुसी ने लम्‌मी माणसे हया। <verse eid="GEN 25:3" /><verse number="4" style="v" sid="GEN 25:4" />मीद्‌यानेन पुर्‌या एपा, एपेर, हनोक, अबीदा ने एलदाह हतला। जे आखा कतुरान अवल्‌यात हतला।<verse eid="GEN 25:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 25:5" />अब्‌राहम आपसान आखो-काय इसाक काजे सुप देदु। <verse eid="GEN 25:5" /><verse number="6" style="v" sid="GEN 25:6" />बाकुन आपसान पावरनीन पुर्‌या काजे काही-काहींन दीन आपसान जीवते रवतात आपसा पुर्‌याक इसाक धड़े सी अखण वाळा देस मां मकली देदु।<verse eid="GEN 25:6" /></para>
  <para style="s">अब्‌राहमेन मरण</para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 25:7" />जत्‌यार अब्‌राहमेन एक सव ने सत्‌तर ने पांच साल हया <verse eid="GEN 25:7" /><verse number="8" style="v" sid="GEN 25:8" />अळतेन अब्‌राहम डाहलु हयन मर गुयु। ने चु तेरा आड़ा-बुड़ा मां जाय्‌न भेसकाय गुयु। <verse eid="GEN 25:8" /><verse number="9" style="v" sid="GEN 25:9" />तेरा पुर्‌या इसाक ने इस्‌माएल ने हीत्‌ती सोवरेन पुर्‌यु एपरोनमेन मम्‌रे नावेन जागान अगळ वाळु जागा मां, जु मकपेला दर हतलु, चां तीनाक गाड़्‌या; <verse eid="GEN 25:9" /><verse number="10" style="v" sid="GEN 25:10" />अब्‌राहम जु जागु हीत्‌या माणसे सी मुल लेदलु। तीना जागा आपसी घरवाळी सारा काजे गाड़्‌ला चां अब्‌राहम काजे बी गाड़्‌या। <verse eid="GEN 25:10" /><verse number="11" style="v" sid="GEN 25:11" />भगवान अब्‌राहमेन मरनेन पछेन मां तेरा पुर्‌या काजे संयबरकत आप्‌यु। इसाक लहेरोई नावेन कुवा धड़े रहणे लाग्‌यु। <verse eid="GEN 25:11" /><verse number="12" style="v" sid="GEN 25:12" />अब्‌राहमेन पुर्‌यु इस्‌माएलेन अवल्‌यात, जो सारान मीसर वाळी पावरनी हाजीरा सी पयदा हवली, तेरी जी अवल्‌यात छे।<verse eid="GEN 25:12" /></para>
  <para style="s">इस्‌माएलेन खानदानी</para>
  <para style="r">(<ref loc="1CH 1:28-31">1 ईतीहास 1:28-31</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 25:13" />इस्‌माएलेन पुर्‌यान नाव ने अवल्‌यात ज्‌य छे: मतलब इस्‌माएलेन पेहलु पुर्‌यु नबायोत, अळतेन केदार, अदबेल, मीबसाम, <verse eid="GEN 25:13" /><verse number="14" style="v" sid="GEN 25:14" />मीसमा, दुमा, मस्‌सा, <verse eid="GEN 25:14" /><verse number="15" style="v" sid="GEN 25:15" />हदद, तेमा, यतुर, नापीस ने केदमा नावेन पुर्‌यु हतला। <verse eid="GEN 25:15" /><verse number="16" style="v" sid="GEN 25:16" />जेत इस्‌माएलेन पुर्‌या हतला। हींद्‌रा नावेन तसा तींद्‌रा गावेन पड़ावान नाव बी पाड़्‌या। जेत बारहे आपणा-आपणा कुळीन मुखी बण्‌या। <verse eid="GEN 25:16" /><verse number="17" style="v" sid="GEN 25:17" />इस्‌माएलेन एक सोव ने संयतीस सालेन हया; तत्‌यार चु तेरा जीवेक छुड़ीन जात र्‌यु, ने तींद्‌रा मरला माणसे मां भेसकाय ज्‌यु। <verse eid="GEN 25:17" /><verse number="18" style="v" sid="GEN 25:18" />ने तेरा अवल्‌यात हवीला सी सुर तक, चो मीसर देस अगळ असीरीयान वाट पर छे, चां वस ज्‌या; ने तींद्‌रा भाय बेटा आखा आंग्‌ये हयन छेटे वसणे लाग्‌या।<verse eid="GEN 25:18" /></para>
  <para style="s">इसाकेन पुर्‌यान पयदावारी</para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 25:19" />अब्‌राहमेन पुर्‌यु इसाकेन अवल्‌यात जी छे: अब्‌राहम सी इसाक हयु; <verse eid="GEN 25:19" /><verse number="20" style="v" sid="GEN 25:20" />ने इसाक जत्‌यार चालीस सालेन हयु तत्‌यार रीबकान पयदावारी हय, जी पद्‌दनराम मां रहणे वाळी, अराम्‌या बतुएलेन पुरे, ने अरामी लाबानेन बहणीस हतली, तेर सी ईयाव कर लेदु। <verse eid="GEN 25:20" /><verse number="21" style="v" sid="GEN 25:21" />इसाकेन घरवाळी ते आंझी हतली, तेरेमां चु यहोवा सी दुवा कर्‌यु ने यहोवा तेरी दुवा काजे सामळ्‌यु, ने ची रीबका भार पाये हय। <verse eid="GEN 25:21" /><verse number="22" style="v" sid="GEN 25:22" />तीनीन जवळ्‌या पुर्‌या हवणे वाळा हतला तेर सी पेहल चे दुयु पेटेत मां लड़ायणी बाजी ज्‌या। ची रीबका कय, कदी असोत हवतो रवसे ती मे कसी जीवीस? तेरेमां ची यहोवा सी पुछणे लागी।<verse eid="GEN 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 25:23" />तत्‌यार यहोवा तीनीक कह्‌यु,</para>
  <para style="q1" vid="GEN 25:23">“तारा पेट मां दुय जात्‌या छे,</para>
  <para style="q1" vid="GEN 25:23">ने तारी कुख सी नीकळतात दुय जातीन माणसे मां अलग-अलग रवसे,</para>
  <para style="q1" vid="GEN 25:23">ने एक जातीन माणसे दुसरी जातीन माणसे सी बेसका ताकुत वाळा रवसे,</para>
  <para style="q1" vid="GEN 25:23">ने मट्‌लु पुर्‌यु नानला पुर्‌यान सेवा करसे।”<verse eid="GEN 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 25:24" />जत्‌यार तेरा पुर्‌या हवणेन टेम आय गुय, तत्‌यार मालम पड़्‌यो की तेरा पेट मां जवळ्‌या पुर्‌या छे। <verse eid="GEN 25:24" /><verse number="25" style="v" sid="GEN 25:25" />पेहलु पयदा हयु चु रातलु हयु ने तेरो डील चादरान तसों कान्‌यावाळो हतलो, तेरेमां तेरो नाव एसाव पाड़्‌यु। <verse eid="GEN 25:25" /><verse number="26" style="v" sid="GEN 25:26" />अळतेन तेरु भाय तेरा भायसेन हात सी एसावेन अड़ी धरीन हयु; ने तेरो नाव याकुब पाड़्‌यु। जत्‌यार रीबका सी जे पयदा हया ती इसाक साठ सालेन हतलु।<verse eid="GEN 25:26" /></para>
  <para style="s">एसावेन साहरे पेहल हवणेन हक वेचणु</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 25:27" />अळतेन चे पुर्‌या मटा हवणे लाग्‌या ने एसाव ते जंगल मां रय्‌न सीकार करने वाळु बण ज्‌यु, बाकुन याकुब सुदु माणुस हतलु, ने तम्‌बु बणाय रया करतेलु। <verse eid="GEN 25:27" /><verse number="28" style="v" sid="GEN 25:28" />इसाक एसाव लावे चो मास खाया करतेलु, तेरेमां चु एसाव सी परम करतेलु बाकुन रीबका याकुब सी परम करतेली।<verse eid="GEN 25:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 25:29" />एक दाहड़े याकुब खाणे करीन दाळ बणावतेलु; ने एसाव जंगल सी हार पड़लु आयु। <verse eid="GEN 25:29" /><verse number="30" style="v" sid="GEN 25:30" />तत्‌यार एसाव याकुब सी कह्‌यु, “जी रातली दाळ छे मेसेक खावाड़, काहाकी मे हार पड़लु छे।” तेरेमां तेरो नाव एदोम पड़्‌यो।<verse eid="GEN 25:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 25:31" />याकुब कह्‌यु, “तारु पेहलु खुळ्‌यु पुर्‌यु हवणेन हक मेसेक आप दे।”<verse eid="GEN 25:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 25:32" />एसाव कह्‌यु, देख मे मरने वाळु छे, तेरेमां हक आपणे सी मारु काय फायदु हवसे ?<verse eid="GEN 25:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 25:33" />याकुब कह्‌यु, “मार सी अबी सगुन खा,” तेरेमां एसाव तेर सी सगुन खादु,</para>
  <para style="p" vid="GEN 25:33">ने तीनाक तारु पेहलु खुळ्‌यु पुर्‌यु हवणेन हक आपीन वेच दे। <verse eid="GEN 25:33" /><verse number="34" style="v" sid="GEN 25:34" />तेर पछेन याकुब एसाव काजे रुटा ने बणावली रातली दाळ आप्‌यु, ने चु खादु पीदु, तत्‌यार उठीन जाती र्‌यु। तसु करीन एसाव आपसान पेहलु खुळ्‌यु पुर्‌यु हवणेन हक काजे फालतु समज्‌यु।<verse eid="GEN 25:34" /></para>
  <chapter eid="GEN 25" />
  <chapter number="26" style="c" sid="GEN 26" />
  <para style="s">इसाक गरार मां रवे</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 26:1" />देस मां काळ पड़्‌यु। अब्‌राहमेन दाहड़ा पड़लु तेर सी अलग हतलु। तेरेमां इसाक गरारेन पलीस्‌तीन राजु अबीमेलेक धड़े गुयु। <verse eid="GEN 26:1" /><verse number="2" style="v" sid="GEN 26:2" />चां यहोवा भगवान तीनाक उजेंतु हयन कह्‌यु, “मीसर मां जा; जो देस तुसेक बताड़ीस चां रया करजी। <verse eid="GEN 26:2" /><verse number="3" style="v" sid="GEN 26:3" />तु ईनात देस मां रव, ने मे तार साते रवीस, ने तुसेक संयबरकत आपीस; ने ज आखो देस तुसेक ने तारा अवल्‌यात काजे आपीस; ने जु सगुन मे तारा बास अब्‌राहम सी खादलु, तीनाक मे पुरो करीस। <verse eid="GEN 26:3" /><verse number="4" style="v" sid="GEN 26:4" />ने मे तारा अवल्‌यात काजे सरगेन तारान तसा गीणाये नी ततरा करीस; ने मे तारा अवल्‌यात काजे ज आखो देस आप दीस, ने धरतीन आखा जात्‌या तारा अवल्‌यातेन वजे सी तुसेक संयबरकत वाळु मानसे। <verse eid="GEN 26:4" /><verse number="5" style="v" sid="GEN 26:5" />काहाकी अब्‌राहम मारी मान्‌यु, ने ज बी तीनाक सुपलु तीनाक ने मारी हुकुम काजे, रीती-भाती ने नीयम काजे पाळ्‌यु।”<verse eid="GEN 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 26:6" />तसु करीन इसाक गरार मात रहणे लाग ज्‌यु। <verse eid="GEN 26:6" /><verse number="7" style="v" sid="GEN 26:7" />जत्‌यार तीना जागा मां रहणे वाळा तेरी घरवाळीन बारामां पुछ्‌या, तत्‌यार चु असु वीच्‌यारीन कह्‌यु की कदी मे तीनीक मारी घरवाळी कयस ती ते जां रहणे वाळा माणसे रीबका ची बेसकी वारु देखाये, ती चे मेसेक मार नाखसे, तसु करीन जपाप आप्‌यु, की “हयी ते मारी बहणीस छे।”<note caller="+" style="x"><char style="xo" closed="false">26:7 </char><char style="xt" closed="false"><ref loc="GEN 12:13">उबजाणनी किताप 12:13</ref>; <ref loc="GEN 20:2">20:2</ref></char></note> <verse eid="GEN 26:7" /><verse number="8" style="v" sid="GEN 26:8" />जत्‌यार तीनाक चां रवतेला बेसका दाहड़ा हय ज्‌या, तत्‌यार एक दाहड़े पलीस्‌तीन राजु अबीमेलेक खीड़कीम रय्‌न झाकीन असु देख्‌यु की इसाक आपसी घरवाळी रीबका भेळे सुयन परम करतेलु। <verse eid="GEN 26:8" /><verse number="9" style="v" sid="GEN 26:9" />अबीमेलेक इसाक काजे बुलायु ने तीनाक कह्‌यु, छाचलीन हयी तारी घरवाळी छे। तु असु काहा कहलु, “हयी मारी बहणीस छे?”</para>
  <para style="p" vid="GEN 26:9">इसाक जपाप आप्‌यु, मे सुची रहलु की कदी मे हयी मारी घरवाळी छे करीन कहीस ती तेर वजे सी मे माराय जायस।<verse eid="GEN 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 26:10" />अबीमेलेक कह्‌यु, तु हामरे साते असु ज काय कर्‌यु? मारा माणसे मायन काहनु बी ईनी साते सुय जातो ने तु हामुक पाप मां फसाड़तु। <verse eid="GEN 26:10" /><verse number="11" style="v" sid="GEN 26:11" />अबीमेलेक आपसा माणसे काजे समजाड़्‌यु; जु काहनुक ईना माणुस काजे ने तेरी घरवाळी काजे छीमसे, तीनाक मार नाकसुन।<verse eid="GEN 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 26:12" />इसाक तीना देस मां वेर्‌यु ने तीनेत साल सोव गुणा फळ फळ्‌यो, काहाकी मालीक तीनाक संयबरकत आप्‌यु। <verse eid="GEN 26:12" /><verse number="13" style="v" sid="GEN 26:13" />ने असुत संयबरकत जड़तु रह्‌यु, तसु करीन चु मात-भर बण ज्‌यु। <verse eid="GEN 26:13" /><verse number="14" style="v" sid="GEN 26:14" />तेर धड़े गाडरा-बुकड़ा, गावड़ी-बेल, ने बेसका पावर्‌या-पावरनी हतली। तेरेमां पलीस्‌ती माणसे इसाक सी रीस करने बाजी ज्‌या। <verse eid="GEN 26:14" /><verse number="15" style="v" sid="GEN 26:15" />तेरेमां जतरा कुवा तेरु बास अब्‌राहमेन पावर्‌या अब्‌राहमेन जीवते खुदला, तीनु कुवाक पलीस्‌ती माणसे धुळा करीन बुरवी देदा।<verse eid="GEN 26:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 26:16" />तत्‌यार अबीमेलेक इसाक सी कह्‌यु, हामरे धड़े सी जाती रव, “काहाकी तु हामरे सी अदु ताकुत वाळु हय ज्‌यु।” <verse eid="GEN 26:16" /><verse number="17" style="v" sid="GEN 26:17" />तेरेमां इसाक चां सी जाती र्‌यु, ने गरारेन बयड़ा मां तम्‌बु उबु करीन चां रहणे लाग्‌यु। <verse eid="GEN 26:17" /><verse number="18" style="v" sid="GEN 26:18" />तत्‌यार जे कुवा तेरु बास अब्‌राहमेन वाराम खुदला हतला, ने अब्‌राहमेन मरनेन पछेन पलीस्‌ती माणसे बुरवी देदला, तीनुक फीर सी उकराड़्‌यु; ने तींद्‌रा चेत नाव पाड़्‌यु,जे तेरु बास पाड़लु।<verse eid="GEN 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 26:19" />अळतेन इसाक्‌यान पावर्‌या बयड़ा मां कुवु खुदते-खुदते पाणीन झीर नीकळ्‌यु। <verse eid="GEN 26:19" /><verse number="20" style="v" sid="GEN 26:20" />तत्‌यार गरारेन गुवाळ्‌या इसाक्‌यान गुवाळ्‌या सी झगड़ु कर्‌या ने कह्‌या, “ज पाणी हामरो छे।” तेरेमां चु तीना कुवान नाव एसेक पाड़्‌यु; काहाकी चे तीनाक लीन लड़ायतेला।<verse eid="GEN 26:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 26:21" />अळतेन चे दीसरु कुवु खुद्‌या, ने चे तीनाक कुवाक लीन बी लड़ाय कर्‌या; तेरेमां तेरो नाव सीतना पाड़्‌यु। <verse eid="GEN 26:21" /><verse number="22" style="v" sid="GEN 26:22" />तत्‌यार इसाक चां सी बाहर नीकळीन एक अळी कुवु खुदाड़्‌यु, ने तेर वाटे चे लड़ाय नी कर्‌या; तेरेमां चु तेरो नाव असु कय्‌न रहोबोत पाड़्‌यु, “हंय यहोवा हामरे वाटे बेसकु जागु आप देदलु छे, ने हामु ईना देस मां संयबरकत हात करसुन।”<verse eid="GEN 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 26:23" />चां सी चु बेरसेबा गुयु। <verse eid="GEN 26:23" /><verse number="24" style="v" sid="GEN 26:24" />ने तीनेत रात्‌ये यहोवा तीनाक उजेंतु हयन कह्‌यु, “मे अब्‌राहमेन जु तारु बास छे तेरु भगवान छे; मां बीहे, काहाकी मे तारे साते छे, ने मारु सेवक अब्‌राहमेन वजे सी तुसे संयबरकत आपीस, ने तारा अवल्‌यात काजे वदाड़ीस।” <verse eid="GEN 26:24" /><verse number="25" style="v" sid="GEN 26:25" />तत्‌यार चु चां एक चड़ावान जागु बणायु, ने यहोवा भगवान सी दुवा कर्‌यु, ने चांत तम्‌बु ताणीन रहणे लाग्‌यु; ने चां इसाकेन पावर्‌या एक कुवु खुद्‌या।<verse eid="GEN 26:25" /></para>
  <para style="s">इसाक ने अबीमेलेकेन ईचमां वायदु</para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 26:26" />तत्‌यार अबीमेलेक आपसा दुस्‌तीदार अहुजत ने आपसा सीपायड़ान डाहला पीकोल काजे साते लीन गरार सी इसाक काजे देखणे आयु।<note caller="+" style="x"><char style="xo" closed="false">26:26 </char><char style="xt" closed="false"><ref loc="GEN 21:22">उबजाणनी किताप 21:22</ref></char></note> <verse eid="GEN 26:26" /><verse number="27" style="v" sid="GEN 26:27" />इसाक तीनुक कह्‌यु, “तुहुंं मार सी रीस करीन तींद्‌रे ईचमां सी नीकाळ देदला, हंय मार धड़े काहा आय र्‌या?”<verse eid="GEN 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 26:28" />चे कह्‌या, “हामु जाण ज्‌या की यहोवा तारे साते रहे; तेरेमां हामु सुच्‌या की तु ते यहोवा भगवान भीणी सी सयाळु छे, हेरेसी आपणु सगुन खायन, ईनी वात मां तार सी वादु करजे, <verse eid="GEN 26:28" /><verse number="29" style="v" sid="GEN 26:29" />की जसा हामु तारो नुकसान नी कर्‌या, बाकुन तारी भलाय करला, ने तुसेक काजे वारु खुसी-खुसी सी मकली देदा, तसु तु हामरे पर कुहराय घुण करे बाकुन यहोवा भगवान तुसेक संयबरकत आपलु छे।” <verse eid="GEN 26:29" /><verse number="30" style="v" sid="GEN 26:30" />तत्‌यार चु तींद्‌रे वाटे वारु खाणों बणायु ने तीनुक खादा-पीदा। <verse eid="GEN 26:30" /><verse number="31" style="v" sid="GEN 26:31" />संदारे चे आखा संदारे उठीन भेळा हयन सगुन खादा; तत्‌यार इसाक तीनुक वळायु, ने चे चां सी वारु जाती र्‌या।<verse eid="GEN 26:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 26:32" />तीनेत दाहड़े इसाकेन पावर्‌या आवीन आपसा खुदला तीना कुवान बारामां कह्‌या, “हामुक पाणीन एक अळी झीर जड़्‌लु छे।” <verse eid="GEN 26:32" /><verse number="33" style="v" sid="GEN 26:33" />तत्‌यार हयु तेरो नाव सीबा पाड़्‌यु; तेरेमां तीना सहरेन नाव आज लग बेरसेबा पड़्‌यो।<verse eid="GEN 26:33" /></para>
  <para style="s">एसावेन पारका देसेन बायरा</para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 26:34" />जत्‌यार एसाव चाळीस सालेन हयु, तत्‌यार एसाव हीत्‌ती जातीन दुय पुरे सी ईयाव कर्‌यु; यहुदीत ने बासमत। यहुदीतेन बासेन नाव बेरी ने बासमतेन बासेन नाव एलोन हतलो। <verse eid="GEN 26:34" /><verse number="35" style="v" sid="GEN 26:35" />ने ईनु उहड़ीसेन वजे सी इसाक ने रीबकान मन मां काठो लाग्‌यो।<verse eid="GEN 26:35" /></para>
  <chapter eid="GEN 26" />
  <chapter number="27" style="c" sid="GEN 27" />
  <para style="s">याकुब काजे एसावेन संयबरकत जड़नु</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 27:1" />जत्‌यार इसाक डाहु हय ज्‌यु, ने तीनाक धुंधळो देखायणे लाग्‌यो, तत्‌यार चु आपसा पेहला पुर्‌यु एसाव काजे बुलायन कह्‌यु, ए मारा पुर्‌या,</para>
  <para style="p" vid="GEN 27:1">चु कह्‌यु, “काय कहे।”<verse eid="GEN 27:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 27:2" />चु कह्‌यु, “सामळ, मे ते डाहु हय ज्‌यु, ने मेसेक नी मालम की मारो मरनेन दाहड़ु काहनु हसे; <verse eid="GEN 27:2" /><verse number="3" style="v" sid="GEN 27:3" />तेरेमां हंय तु बीलख्‌या ने धंदली लीन खयड़ाम जां ने मारे वाटे काहींन मारीन लाव। <verse eid="GEN 27:3" /><verse number="4" style="v" sid="GEN 27:4" />तत्‌यार सवादो खाणो जसो मेसेक गमे तसों बणाय लाव ने मे तीनाक खायन मरनेन पेहल तुसे मारु बरकत आपो।”<verse eid="GEN 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 27:5" />तत्‌यार एसाव सीकार करने खयड़ा मां गुयु। जत्‌यार इसाक एसाव सी वात करतेलु, तत्‌यार रीबका सामळी रहली। <verse eid="GEN 27:5" /><verse number="6" style="v" sid="GEN 27:6" />तेरेमां रीबका आपसान पुर्‌यु याकुब सी कय, “सामळ, मे तारा बास काजे तारा भाय एसाव काजे असु कवतु सामळी, <verse eid="GEN 27:6" /><verse number="7" style="v" sid="GEN 27:7" />‘तु मारे वाटे सीकार करीन तीनान सवादो खाणो बणाव, ने मे तीनाक खायन यहोवा अगळ मरनेन पेहल संयबरकत आपो।’ <verse eid="GEN 27:7" /><verse number="8" style="v" sid="GEN 27:8" />तेरेमां हंय, ए मारा पुर्‌या, मारी सामळ, ने मारी मान, <verse eid="GEN 27:8" /><verse number="9" style="v" sid="GEN 27:9" />की बुकड़ा धड़े जाय्‌न वार मातली दुय पाठड़ी बुकड़ी ली आव; ने मे तारा बास वाटे गमे तसों सवादो मासेन खाणो बणावीस। <verse eid="GEN 27:9" /><verse number="10" style="v" sid="GEN 27:10" />तत्‌यार तु खाणाक तारा बास धड़े ली जाजी, ने चु तीनाक खायन मरनेन पेहल तुसेक संयबरकत आपे।”<verse eid="GEN 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 27:11" />याकुब आपसी माय रीबका सी कह्‌यु, “सामळ, मारु भाय एसाव ते चादरान तसु लुछा वाळु माणुस छे, मे तसु माणुस नी हय। <verse eid="GEN 27:11" /><verse number="12" style="v" sid="GEN 27:12" />कदी मारु बास मारे हात लागाड़ने बाजी जाय, ती मे तेरी नींगा मां लुच्‌चु बण जायस; ने संयबरकतेन जागे सराप काजे ली आयस।”<verse eid="GEN 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 27:13" />तेरी माय तीनाक कय, “ए मारा पुर्‌या, सराप तार पर नी मार पर पड़े, तेरेमां तु मारी सामळ, ने जाय्‌न चे बुकड़ा मार धड़े ली आव।” <verse eid="GEN 27:13" /><verse number="14" style="v" sid="GEN 27:14" />तत्‌यार याकुब जाय्‌न तीनुक आपसी माय धड़े ली आयु, ने तेरी आयस तेरा बास वाटे सवादो खाणो बणाय देदी। <verse eid="GEN 27:14" /><verse number="15" style="v" sid="GEN 27:15" />तत्‌यार रीबका आपसा पेहला पुर्‌या एसावेन वारु खुलता पुथल्‌या, जे तेरे धड़े घर मां हतला, लावीन आपसा नानला पुर्‌या याकुब काजे पेहराय देदी; <verse eid="GEN 27:15" /><verse number="16" style="v" sid="GEN 27:16" />ने बुकड़ीन गीदल्‌या तेर हाते मां ने तेरा सुवाळा गाल पर लागाड़ देदी; <verse eid="GEN 27:16" /><verse number="17" style="v" sid="GEN 27:17" />ने ची सवादो खाणो ने आपसे हाते बणावला रुटा बी आपसीन पुर्‌यु याकुबेन हात मां दी देदी।<verse eid="GEN 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 27:18" />तत्‌यार याकुब आपसा बास धड़े गुयु ने कह्‌यु, “ए मारा बास,”</para>
  <para style="p" vid="GEN 27:18">चु तीनाक कह्‌यु, “काय वात छे? तु मार पुर्‌या माय्‌न काहनु पुर्‌यु छे?”<verse eid="GEN 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 27:19" />याकुब आपसा बास काजे कह्‌यु, “मे तारु पेहलु पुर्‌यु एसाव छे। मे तारी हुकुमेन अनसारे करलु छे; तेरेमां उठ ने मारा बणावला मास काजे खा, काहाकी तु पुरा जीव सी संयबरकत आपे।”<verse eid="GEN 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 27:20" />इसाक आपसा पुर्‌या काजे कह्‌यु, “ए मारा पुर्‌या, असो कसो तुसे अतरो मामार तुसे जड़ गुयो?”</para>
  <para style="p" vid="GEN 27:20">हयु जपाप आप्‌यु, “तारु भगवान मालीक तीनाक मारे अगळ कर देदु।”<verse eid="GEN 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 27:21" />अळतेन इसाक याकुब सी कह्‌यु, “ए मारा पुर्‌या, मार धड़े आव, मे तुसेक हात लागाड़ीन उळखो की छाचलीन मारु पुर्‌यु एसाव छे की नी।” <verse eid="GEN 27:21" /><verse number="22" style="v" sid="GEN 27:22" />तत्‌यार याकुब आपसा बास इसाक धड़े गुयु, ने हयु तीनाक सुलकीन कह्‌यु, “बुल ते याकुबेन तसी छे, बाकुन हात एसावेन तसा मालम पड़े।” <verse eid="GEN 27:22" /><verse number="23" style="v" sid="GEN 27:23" />ने चु तीनाक नी उळख्‌यु, काहाकी तेरा भाय एसावेन हातेन तसा कान्‌या वाळा हतला; तेरेमां तीनाक चु संयबरकत आप देदु। <verse eid="GEN 27:23" /><verse number="24" style="v" sid="GEN 27:24" />ने हयु पुछ्‌यु, “काय तु छाचलीन मारु पुर्‌यु एसाव छे?”</para>
  <para style="p" vid="GEN 27:24">हयु कह्‌यु, “हव मेत छे।”<verse eid="GEN 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 27:25" />तत्‌यार हयु कह्‌यु, “खाणो मार धड़े ली आव, काहाकी मे मारु पुर्‌यु जो खाणो बणावीन मार वाटे मास लावलु तीनाक वारु खाम ने तुसेक आखा जीव सी संयबरकत आपीस।” तत्‌यार चु बी तेर धड़े ली आयु, ने चु खादु ने; ने चु तेर धड़े दारु बी लायु, ने चु पीदु। <verse eid="GEN 27:25" /><verse number="26" style="v" sid="GEN 27:26" />तत्‌यार तेरु बास इसाक तीनाक कह्‌यु, मारा पुर्‌या, “धड़े आवीन मारा गुळा दे।” <verse eid="GEN 27:26" /><verse number="27" style="v" sid="GEN 27:27" />ती चु धड़े जाय्‌न तेरे गुळा देदु; ने तीनाक तेरा पुथल्‌यान गंद सी तीनाक संयबरकत आप्‌यु, “देख, मारा पुर्‌यान गंद असा खेतेन तसी छे जीना खेत पर भगवान मालीक संयबरकत आपलु हय; <note caller="+" style="x"><char style="xo" closed="false">27:27 </char><char style="xt" closed="false"><ref loc="HEB 11:20">ईब्‌रानीयो 11:20</ref></char></note> <verse eid="GEN 27:27" /><verse number="28" style="v" sid="GEN 27:28" />भगवान सरग सी उस्‌टो, ने खेतेन वारु सी वारु मेर ने बेसका दाणा ने अंगुरेन रस आपे। <verse eid="GEN 27:28" /><verse number="29" style="v" sid="GEN 27:29" />राज्‌य-राज्‌येन तारा हक मां रहे, ने देस-देसेन माणसे तारे पाये पड़े। तु आपसा भायन मालीक बणे,ने तारी माइन पुर्‌या तारे पाये पड़े। जे तुसेक सराप देय तींद्‌रे बी सराप लागे, ने जे तुसे संयबरकत आपे तीनुक बी संयबरकत जड़े।” <note caller="+" style="x"><char style="xo" closed="false">27:29 </char><char style="xt" closed="false"><ref loc="GEN 12:3">उबजाणनी किताप 12:3</ref></char></note><verse eid="GEN 27:29" /></para>
  <para style="s">संयबरकत वाटे एसावेन वीन्‌ती</para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 27:30" />जसु नी असी संयबरकत इसाक याकुब काजे दी देदलु, ने याकुब आपसा बास इसाक अगळ सी नीकळ्‌यु अतरुत, ने एसाव बी सीकार लीन आय ज्‌यु। <verse eid="GEN 27:30" /><verse number="31" style="v" sid="GEN 27:31" />तत्‌यार चु बी सवादो खाणो बणावीन आपसा बास धड़े ली आयु, ने तीनाक कह्‌यु, “मारा बास, उठीन आपसान पुर्‌यु सीकार करीन लावला मास काजे खा, काहाकी मेसे पुरा मन सी संयबरकत आपे।”<verse eid="GEN 27:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 27:32" />तेरु बास इसाक पुछ्‌यु, “तु कुण छे?”</para>
  <para style="p" vid="GEN 27:32">चु कह्‌यु, “मे तारु पेहलु पुर्‌यु एसाव छे।”<verse eid="GEN 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 27:33" />तत्‌यार इसाक बेसकु थर-थर कापतु जाय्‌न कह्‌यु, “ती चु कुण हतलो, जु सीकार करीन मार धड़े लीन आवलु, ने मे तारे आवणे सी पेहेल आखा मां सी ईतरोक-ईतरोक खाय लेदु ने तीनाक संयबरकत आप देदु? ने हंय जी संयबरकत लागली रवसे।”<verse eid="GEN 27:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 27:34" />आपसा बासेन जी वात सामळतेत एसाव जुरे ने दुख सी भरला अवाज सी आयड़ीन आपसा बास सी कह्‌यु, “मारा बास, मेसे बी संयबरकत दी दे!”<verse eid="GEN 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 27:35" />ती हयु कह्‌यु, “तारु भाय मेसे धुकु दी देदु ने तारी संयबरकत काजे लीन जाती र्‌यु।”<verse eid="GEN 27:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 27:36" />चु कह्‌यु, “तेरो नाव याकुब ते नी हय? चु मेसे काजे दुय कावा धुकु देदु। मे पेहलु पुर्‌यु बाकुन हयु तीना जागा काजे लीत लेदलु; ने हंय देख, हयु संयबरकत बी ली लेदु।” ती हयु कह्‌यु, “काय तु मार वाटे संयबरकत बचाड़ीन नी राख्‌यु?”<verse eid="GEN 27:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 27:37" />इसाक एसाव काजे जपाप आपीन कह्‌यु, “सामळ, मे तीनाक तारु मालीक ठहरायु, ने तेरा आखा भायस काजे तेरे हक मां कर देदु, ने दाणा ने नवला अंगुरेन रस आपीन तीनाक खुस करलु छे। तेरेमां हंय, ए मारा पुर्‌या, मे तारे वाटे काय करों?”<verse eid="GEN 27:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 27:38" />एसाव आपसा बास काजे कह्‌यु, “ए मारा बास, काय तार धड़े एकुत संयबरकत छे? मारा बास, मेसे काजे बी संयबरकत आप।” असु कय्‌न एसाव ढळो-ढळो रड़्‌यु।<note caller="+" style="x"><char style="xo" closed="false">27:38 </char><char style="xt" closed="false"><ref loc="HEB 12:17">ईब्‌रानीयो 12:17</ref></char></note><verse eid="GEN 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 27:39" />तेरु बास इसाक तीनाक कह्‌यु, सामळ,</para>
  <para style="q1" vid="GEN 27:39">तारु रहणेन खत वाळी खेती नी रहे, ने सरग सी उस्‌टो नी पड़े।<note caller="+" style="x"><char style="xo" closed="false">27:39 </char><char style="xt" closed="false"><ref loc="HEB 11:20">ईब्‌रानीयो 11:20</ref></char></note><verse eid="GEN 27:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="GEN 27:40" />तु आपसान तलवारेन ताकुत सी जीवतु रहे,</para>
  <para style="q1" vid="GEN 27:40">ने आपसा भायन हक मां ते हवे;</para>
  <para style="q1" vid="GEN 27:40">बाकुन जत्‌यार तु तेरे हकेम सी छुटणे करीन लड़ाय करसी ती,</para>
  <para style="q1" vid="GEN 27:40">तु तेरा हकेम सी छुट जासी। <note caller="+" style="x"><char style="xo" closed="false">27:40 </char><char style="xt" closed="false"><ref loc="HEB 11:20">ईब्‌रानीयो 11:20</ref></char></note><verse eid="GEN 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 27:41" />एसाव याकुब सी भुंडु हय ज्‌यु, काहाकी तेरु बास याकुब काजे संयबरकत देदलु; ने हयु असु वीच्‌यार कर्‌यु की, “मारा बासेन मरनेन धड़ेत छे, अळतेन मे मारा भायस याकुब काजे मारीस।”<verse eid="GEN 27:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 27:42" />जत्‌यार रीबका काजे तेरु पेहलु पुर्‌यु एसावेन जी वात सामळी, तत्‌यार हयी आपसा नानला पुर्‌या याकुब काजे बुलायन कय, “सामळ, तारु भाय एसाव तुसे मारने करीन सुची र्‌यु। <verse eid="GEN 27:42" /><verse number="43" style="v" sid="GEN 27:43" />तेरेमां हंय, ए मारा पुर्‌या, मारी सामळ, ने हारान देस मां मारु भाय लाबानेन चां जाती रव; <verse eid="GEN 27:43" /><verse number="44" style="v" sid="GEN 27:44" />ने थुड़ाक दाहड़ा लग, मतलब जत्‌यार लग तारा भायन रीस नी सेळाये तत्‌यार लग तेरेत धड़े रवजी। <verse eid="GEN 27:44" /><verse number="45" style="v" sid="GEN 27:45" />ने थुड़ाक दाहड़ा मां तारु भाय वीसरी जासे, ने तेरी रीस सेळाय जासे। तत्‌यार मे तुसे काजे चां सी बुलावणे करीन पावर्‌याक मकलीस। ने तु आवती रवजी। असो नी हवणु चाहजे की, एकुत दाहड़े तुहुंं लड़ायन मर जावु। मे तुहुंं दुयु काजे खुवणे नी हींड्‌ती।”<verse eid="GEN 27:45" /></para>
  <para style="s">याकुब लाबान धड़े जाय</para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 27:46" />तत्‌यार रीबका इसाक काजे कय, “तारु पुर्‌यु एसाव ते हीत्‌ती जातीन बायरा काजे बणाय लेदु, मे तीनु बायरा सी घाबराय गुयु, काहाकी चे बायरा आपणा माणसे माय्‌न नी हय। कांखुर माय्‌न याकुब बी हीत्‌ती जातीन बायरा बणाय लेसे, ती ते मेसेक जीवणे सी मरनु वारु छे।”<verse eid="GEN 27:46" /></para>
  <chapter eid="GEN 27" />
  <chapter number="28" style="c" sid="GEN 28" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 28:1" />तत्‌यार इसाक याकुब काजे बुलायन संयबरकत देदु, ने हुकुम देदु, “तु कनानी माणसे माय्‌न काहनी बी पुरे सी ईयाव घुण करे। <verse eid="GEN 28:1" /><verse number="2" style="v" sid="GEN 28:2" />पद्‌दनराम देस मां बतुएलेन घर जाय्‌न, चां तारा मामा लाबानेन पुरे सी ईयाव कर लेजी। <verse eid="GEN 28:2" /><verse number="3" style="v" sid="GEN 28:3" />आखा सी जुर भर्‌यु भगवान तुसे संयबरकत आपे, ने तारा बेसका पुर्‌या-पारी हवे ने तु आखा राजेन माणसेन मुख्‌यु बणे। <verse eid="GEN 28:3" /><verse number="4" style="v" sid="GEN 28:4" />चु तुसे ने तारी अवल्‌यात काजे बी अब्‌राहमेन तसी संयबरकत आपे, काहाकी तु जीना देस मां छे चो देस परदेसी छे ने चां रहे, ने तीनात देस काजे भगवान तीना अब्‌राहम काजे आपलु, काहाकी तीना देसेन हकदार्‌यु बण जाय।”<note caller="+" style="x"><char style="xo" closed="false">28:4 </char><char style="xt" closed="false"><ref loc="GEN 17:4-8">उबजाणनी किताप 17:4-8</ref></char></note> <verse eid="GEN 28:4" /><verse number="5" style="v" sid="GEN 28:5" />असु कयदीन इसाक, याकुब काजे पद्‌दनराम देस मकली देदु, ने याकुब तेरा मामा लाबानेन चां गुयु। ने अरामी बतुएल याकुबेन मामा लाबानेन ने याकुबेन माय रीबकान बास हतलु। रीबका एसावेन ने याकुबेन माय हतली।<verse eid="GEN 28:5" /></para>
  <para style="s">एसाव एक अळी बायर बणावे</para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 28:6" />जत्‌यार एसाव काजे मालम पड़्‌यो की इसाक, याकुब काजे संयबरकत आपीन पद्‌दनराम मकली देदु, काहाकी चु चांहान सी ईयाव करे, ने तीने टेमे असु हुकुम बी आप्‌यु, “तु काहनी बी कनानी माणसेन पुरे सी ईयाव घुण करे,” <verse eid="GEN 28:6" /><verse number="7" style="v" sid="GEN 28:7" />ने याकुब आस्‌या-बास्‌यान मानीन पद्‌दनराम देस मां जाती र्‌यु। <verse eid="GEN 28:7" /><verse number="8" style="v" sid="GEN 28:8" />तत्‌यार एसाव असु सामळीन अळी बी वीचार करने लाग्‌यु की कनानी पुरे मारा बास काजे नी गमे, <verse eid="GEN 28:8" /><verse number="9" style="v" sid="GEN 28:9" />अब्‌राहमेन पुर्‌यु इस्‌माएलेन पुरे धड़े गुयु, ने इस्‌माएलेन पुरे महलत काजे, जी नबायोतेन बहणीस हतली, तेरेसी ईयाव करीन आपसान घरवाळी बणाय लेदु।<verse eid="GEN 28:9" /></para>
  <para style="s">बेथेल मां याकुबेन सपनो</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 28:10" />याकुब बेरसेबा सहर सी नीकळीन हारान देस भीणी चाल पड़्‌यु। <verse eid="GEN 28:10" /><verse number="11" style="v" sid="GEN 28:11" />ने चु वाट्‌ये चालतु-चालतु रात्‌ये काहनेक जागे रुकणेन वीच्‌यार कर्‌यु, काहाकी दाहड़ु डुब गुयलु; तेरेमां चु तीना जागान दगड़ाम सी एक दगड़ु लीन ईसो बणायु, ने तीनात जागा पर सुय ज्‌यु। <verse eid="GEN 28:11" /><verse number="12" style="v" sid="GEN 28:12" />तत्‌यार चु असो सपनो देख्‌यु, की एक लीसुण धरती पर उभी छे, ने उपरनो सीरो सरग लग टेकाय्‌लो छे, ने भगवानेन सरगेन काहवाळ्‌या लीसुण सी चहड़े ने उतरे। <verse eid="GEN 28:12" /><verse number="13" style="v" sid="GEN 28:13" />ने यहोवा भगवान तेर पर उबु रय्‌न कहे, “मे यहोवा भगवान, तारा डाहला अब्‌राहमेन भगवान, ने इसाकेन भगवान छे; जीनी धरती पर आडु पड़ र्‌यु, तीनीक मे तुसे ने तारा अवल्‌यात काजे आपीस। <verse eid="GEN 28:13" /><verse number="14" style="v" sid="GEN 28:14" />ने तारा अवल्‌यात धरतीन धुळान पीठीन तसी गीणाये नी तत्‌री हय जासे, ने बुडण, उगण, अखण, दखण, च्‌यारे-मेर हय जासे: ने तारा ने तारा अवल्‌यात सी धरतीन आखा देसेन रहण्‌या घरन्‌या काजे संयबरकत आपीस। <verse eid="GEN 28:14" /><verse number="15" style="v" sid="GEN 28:15" />ने सामळ, मे तारे भेळे रय्‌स, ने जां बी तु जासी चां तारी राखवाळी करीस, ने तुसे ईना देस मां पछु ली आवीस: मे मारा करला वादा काजे पुरो नी करों चां लग तुसे नी छुड़ो।”<verse eid="GEN 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 28:16" />तत्‌यार याकुब जागी ज्‌यु, ने असु कह्‌यु, “छाचलीन ईना जागा मां यहोवा भगवान छे; ने मे ईनी वात काजे नी जाणों।” <verse eid="GEN 28:16" /><verse number="17" style="v" sid="GEN 28:17" />ने बीहीन असु कहणे लाग्‌यु, “जु जागु कसु बीहे तसु छे! जु ते भगवानेन घर काजे छुड़ीन अळी दीसरो नी हय सके; बाकुन जु सरगेन फाटकुत हसे।”<verse eid="GEN 28:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 28:18" />एगुत याकुब उठ्‌यु, ने आपसान दगड़ान ईसा काजे लीन तेरु खंबु बणाय देदु, ने तेरे उपर थीन्‌गे सी तेल नाख देदु। <verse eid="GEN 28:18" /><verse number="19" style="v" sid="GEN 28:19" />हयु तीना जागान नाव बेतेल<note caller="+" style="f"><char style="fr" closed="false">28:19 </char><char style="ft" closed="false">भगवानेन भक्‌तीन घर</char></note> राख्‌यु; बाकुन तीना सहरेन नाव पेहेल लुज हतलो। <verse eid="GEN 28:19" /><verse number="20" style="v" sid="GEN 28:20" />तत्‌यार याकुब असु बादा लेदु, “कदी भगवान मार भेळे रय्‌न चां जाणेन मारी राखवाळी करसे, ने खाणे वाटे रुटा ने पेहरनेन पुथल्‌या देय, <verse eid="GEN 28:20" /><verse number="21" style="v" sid="GEN 28:21" />ने मे बासेन घर वारु पुग जाम; ती यहोवा भगवान मारु भगवान बणसे। <verse eid="GEN 28:21" /><verse number="22" style="v" sid="GEN 28:22" />ने जु दगड़ु, जीनाक मे उबु करलु छे, चो भगवानेन घर बणसे: ने जो काय तु मेसे आपसी तेरो दसवु हीस्‌सु तुसे आप्‌यात करीस।”<verse eid="GEN 28:22" /></para>
  <chapter eid="GEN 28" />
  <chapter number="29" style="c" sid="GEN 29" />
  <para style="s">याकुबेन लाबान सी मेळनु</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 29:1" />अळतेन याकुब अघु वाट्‌ये पड़्‌यु, ने उगण वाळा देस मां आयु। <verse eid="GEN 29:1" /><verse number="2" style="v" sid="GEN 29:2" />हयु चां असु देख्‌यु की खयड़ा मां एक कुवु छे, ने तेर धड़े गाडरा-बुकड़ान तीन टुळा बठला छे; काहाकी जु दगड़ु तीना कुवान मुंहडा पर मेक्‌लु रवतेलु, तीना सी तीनु टुळा काजे पाणी पावतेला, चु भारलु दगड़ु हतलु। <verse eid="GEN 29:2" /><verse number="3" style="v" sid="GEN 29:3" />ने जत्‌यार आखा टुळा भेळा हय जातला, तत्‌यार गुवाळ्‌या तीना दगड़ा काजे कुवान मुंहडा पर सी गबड़ायान गाडरा-बुकड़ा काजे पाणी पावे, ने पछेन दगड़ा काजे कुवान मुंहडा पर जसु हतलु तसु मेक देय।<verse eid="GEN 29:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 29:4" />तेरेमां याकुब गुवाळ्‌या सी पुछ्‌यु, “एय मारा भायसे, तुहुंं कां वाळा छे?”</para>
  <para style="p" vid="GEN 29:4">चे कह्‌या, “हामु हारान सहर वाळा छे।”<verse eid="GEN 29:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 29:5" />तत्‌यार चु तीनुक पुछ्‌यु, काय तुहुंं नाहोरेन लाबानेन पुर्‌या काजे उळखे?</para>
  <para style="p" vid="GEN 29:5">चे कह्‌या, “हव हामु तीना काजे उळख्‌यु।”<verse eid="GEN 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 29:6" />तत्‌यार याकुब पुछ्‌यु, “चु वारलु ते छे की?” चे कह्‌या, चे वारलु छे।</para>
  <para style="p" vid="GEN 29:6">आखो काय वारलु छे। देखु, “पली पुरे राहेल तेरा गाडरा पुठ्‌ये आवणे बाजी रय।”<verse eid="GEN 29:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 29:7" />याकुब कह्‌यु, “देखु, हाल दाहड़ु छे ने दाहड़ु डुबणेन बेसकी वार छे। माल-डर भेळा हवणेन टेम नी हय रय; तेरेमां गाडरा-बुकड़ा काजे पाणी पावीन पछा ली जाय्‌न चारु,”<verse eid="GEN 29:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 29:8" />चे कह्‌या, “हामु हंय असा नी कर सकजे; जत्‌यार आखा टुळा भेळा हवे, तत्‌यार दकड़ु कुवा पर सी अथा करे, ने तत्‌यार हामु गाडरा-बुकड़ा काजे पाणी पावजे।”<verse eid="GEN 29:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 29:9" />तींद्‌री असी वात चालीत रहली ने राहेल, जी माल-ढुरे चारतेली, ची आपसा बासेन गाडरा-बुकड़ा लीन आय। <verse eid="GEN 29:9" /><verse number="10" style="v" sid="GEN 29:10" />याकुब आपसा मामा लाबानेन पुरे राहेल, ने तेरा गाडरा-बुकड़ा काजे देख्‌यु ने कुवान मुंहडे सी दगड़ु अथु करी ने आपसा मामा लाबानेन गाडरा-बुकड़ा काजे पाणी पावी। <verse eid="GEN 29:10" /><verse number="11" style="v" sid="GEN 29:11" />तत्‌यार याकुब राहेलेन गुळा देदु, ने खुस हय्‌न जुरे आयड़्‌यु। <verse eid="GEN 29:11" /><verse number="12" style="v" sid="GEN 29:12" />ने याकुब राहेल काजे कय देदु, की मे तारा बासेन अवल्‌यात माय्‌न छे। राहेल काजे असु बी बताड़्‌यु की मे रीबकान पुर्‌यु छे।</para>
  <para style="p" vid="GEN 29:12">तेरेमां राहेल घर भीणी दवड़ीन गुय ने आपसा बास काजे आखो बताड़ देदी। <verse eid="GEN 29:12" /><verse number="13" style="v" sid="GEN 29:13" />लाबान तीना याकुबेन खबर सामळीन तीनाक भेळु हवणे दवड़्‌यु, ने तीनाक गळे लागीन गुळा देदु, अळतेन आपसे घर ली ज्‌यु। ने याकुब आपसा बारामां आखो बताड़्‌यु। <verse eid="GEN 29:13" /><verse number="14" style="v" sid="GEN 29:14" />तत्‌यार लाबान याकुब सी कह्‌यु, “छाचलीन तु मारा हाटकान ने मास माय्‌न छे।” ने याकुब एक महनो भरीन चां रह्‌यु।<verse eid="GEN 29:14" /></para>
  <para style="s">याकुब राहेल ने लीया: वाटे सेवा करे</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 29:15" />तत्‌यार लाबान याकुब सी कह्‌यु, “मारु सगासायन तार सी असलुत सेवा करान्‌नु मार वाटे वारु नी हय; तेरेमां कव की सेवान बदले तुसे काय आपो?” <verse eid="GEN 29:15" /><verse number="16" style="v" sid="GEN 29:16" />लाबानेन दुय पुरे हतली, तींद्‌रेम सी मट्‌लीन नाव: लीया ने नानलीन नाव राहेल हतलो। <verse eid="GEN 29:16" /><verse number="17" style="v" sid="GEN 29:17" />लीयान ते डुळा कमजु हतला, बाकुन राहेल ते वारु ने घाटाळी हतली।<verse eid="GEN 29:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 29:18" />तेरेमां याकुब काजे राहेल गमतेली, तेरेमां कह्‌यु, “मे तारी नानली पुरे राहेल वाटे सांत साल लग तारी सेवा करीस।”<verse eid="GEN 29:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 29:19" />लाबान कह्‌यु, “तीनीक पारका पुर्‌याक आपणे सी तुसे देणु वारु रवसे; तेरेमां मार धड़े रव।” <verse eid="GEN 29:19" /><verse number="20" style="v" sid="GEN 29:20" />तेरेमां याकुब राहेल वाटे सांत साल लग सेवा कर्‌यु; ने तीनाक राहेल गमी तेरेमां थुड़ाक दाहड़ा लग रह्‌यु तसों लाग्‌यो।<verse eid="GEN 29:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 29:21" />तत्‌यार याकुब लाबान सी कह्‌यु, मारी बायर मेसे आप, ने मे तीनी धड़े जायस, “काहाकी मारा दाहड़ा पुरा हय ज्‌या।” <verse eid="GEN 29:21" /><verse number="22" style="v" sid="GEN 29:22" />तेरेमां लाबान तीना जागान आखा माणसे काजे भेळा कर्‌यु, ने खाणेन तीहवार राख्‌यु। <verse eid="GEN 29:22" /><verse number="23" style="v" sid="GEN 29:23" />राते आपसी पुरे लीया काजे याकुब धड़े ली ज्‌यु, ने चु तेरे धड़े गुयु। <verse eid="GEN 29:23" /><verse number="24" style="v" sid="GEN 29:24" />लाबान आपसी पुरे लीया काजे पावरनी बणे करीन आपसी पावरनी जील्‌पा काजे आप देदी। <verse eid="GEN 29:24" /><verse number="25" style="v" sid="GEN 29:25" />संदारे मालम पड़्‌यो की जी ते लीया छे, तेरेमां हयु लाबान सी कह्‌यु, “मार साते असु काय कर्‌यु? मे तार भेळे रय्‌न सेवा कर्‌यु, ती मे राहेल वाटे सेवा नी कर्‌यु काय? ती तु मेसे काजे असु काहा धुकु देदु?”<verse eid="GEN 29:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 29:26" />लाबान कह्‌यु, “हामरेन चां असी रीती हय नी की मट्‌ली काजे छुड़ीन नानली काजे पयणी देजे। <verse eid="GEN 29:26" /><verse number="27" style="v" sid="GEN 29:27" />बाकुन ईयाव करलान तसु पुरु हाप्‌तु एर धड़े रव ने मे तुसे राहेल साते बी तारु ईयाव कराड़ दीस। बाकुन तुसे अळी सांत साल लग मारी चाकरी करनु पड़से।”<verse eid="GEN 29:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 29:28" />याकुब तसुत कर्‌यु, ने लीयान हाप्‌ता काजे पुरो कर्‌यु, तत्‌यार लाबान तीनी राहेल काजे तेरी बायर बणे करीन आप देदु। <verse eid="GEN 29:28" /><verse number="29" style="v" sid="GEN 29:29" />लाबान आपसान पुरे राहेलेन पावरनी बणे करीन जी तेरी पावरनी तीनी बील्‌हा काजे आप देदु। <verse eid="GEN 29:29" /><verse number="30" style="v" sid="GEN 29:30" />तत्‌यार याकुब राहेल धड़े गुयु, ने तीनाक लीया सी अदु राहेल गमी, ने चु लाबान भेळे रय्‌न सांत साल अळी सेवा कर्‌यु।<verse eid="GEN 29:30" /></para>
  <para style="s">याकुबेन अवल्‌यात</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 29:31" />जत्‌यार यहोवा भगवान देख्‌यु की चु राहेल लीया सी अदु गमे, तत्‌यार तेरेमां चु तेरी कुख काजे खुल देदु, बाकुन राहेल आंझी रय गुय। <verse eid="GEN 29:31" /><verse number="32" style="v" sid="GEN 29:32" />तेरेमां लीया भार पाये हय ने एक पुर्‌यु हयु, ने तसु करीन तेरो नाव रुबेन पाड़्‌यु, “यहोवा मारा दुख काजे देख्‌यु, हंय मारु घर धेणी मेसे काजे वारु राखसे।” <verse eid="GEN 29:32" /><verse number="33" style="v" sid="GEN 29:33" />अळतेन ची अळी भार पाये हवी ने तीनीन एक पुर्‌यु हयु: तत्‌यार हयु असी कय, “काहाकी असी सामळी की मे वारु गमो, यहोवा मेसे काजे जु बी पुर्‌यु आप्‌यु।” तेरेमां हयी तेरो नाव सीमोन पाड़ी। <verse eid="GEN 29:33" /><verse number="34" style="v" sid="GEN 29:34" />अळी ची भार पाये हवी ने तेरो एक पुर्‌यो हयो; ने ची कय, “ईनी कावा ते मारु घर धेणी मेसे जड़ जासे, काहाकी हेरे सी मारा तीन पुर्‌या हया।” तेरेमां तेरो नाव लेवी पाड़्‌या। <verse eid="GEN 29:34" /><verse number="35" style="v" sid="GEN 29:35" />ने अळी ची भार पाये हवी ने अळी एक पुर्‌यु हयु, ने ची कय, “हंयन कावा मे भगवान काजे वारु कय्‌स।” तेरेमां ची तेरो नाव यहुदा पाड़ी; ती तेरो कुख बंद हय ज्‌यो।<verse eid="GEN 29:35" /></para>
  <chapter eid="GEN 29" />
  <chapter number="30" style="c" sid="GEN 30" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 30:1" />राहेल देखी की, याकुब सी मारा पुर्‌या नी हवता, ती ची आपसी बहणीस लीया पर कुहरायणे बाजी गुय: ने ची याकुब काजे कय, “मेसेक बी अवल्‌यात आप, नीते मे मर जायस।”<verse eid="GEN 30:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 30:2" />याकुब राहेल पर रीसवाय गुयु ने कह्‌यु, “मे भगवान छे काय? तारी कुख ते भगवानुत बंद कर देदलु छे।”<verse eid="GEN 30:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 30:3" />तत्‌यार राहेल याकुब काजे कय, “तु मारी पावरनी बील्‌हा साते सोवसार कर, ने तेरे सी मारे वाटे पुर्‌या हवसे, ने तेरेसी मारो बी घर वसे।” <verse eid="GEN 30:3" /><verse number="4" style="v" sid="GEN 30:4" />ने राहेल, याकुब काजे आपसी पावरनी बील्‌हा आप देदी ने तीनाक असी कय, ईनीक आपसी घरवाळी बणाय ले। ने याकुब तेरे साते सोवसार कर्‌यु। <verse eid="GEN 30:4" /><verse number="5" style="v" sid="GEN 30:5" />बील्‌हा याकुब सी भार पाये हय ने तेरु एक पुर्‌यु हयु। <verse eid="GEN 30:5" /><verse number="6" style="v" sid="GEN 30:6" />राहेल कय, “भगवान मारी दुवा सामळी लेदु। ने मेसेक एक पुर्‌यु आपलु छे।” तेरेमां ची तीना पुर्‌यान नाव दान<note caller="+" style="f"><char style="fr" closed="false">30:6 </char><char style="ft" closed="false">नीयाव करनु</char></note> पाड़ी। <verse eid="GEN 30:6" /><verse number="7" style="v" sid="GEN 30:7" />ने राहेलेन पावरनी बील्‌हा याकुब सी अळी भार पाये हय, ने तेरु एक पुर्‌यु अळी पयदा हयु। <verse eid="GEN 30:7" /><verse number="8" style="v" sid="GEN 30:8" />तत्‌यार राहेल कय, “मे मारी बहणीस साते बाथे-बात पड़ीन जीत गुयली छे।” ने ची तीना पुर्‌यान नाव नप्‌ताली पाड़ी।<verse eid="GEN 30:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 30:9" />लीया काजे मालम पड़्‌यो की, मे आंझी हय गुय, तत्‌यार ची याकुब काजे आपसी पावरनी जील्‌पा आप देदी। काहाकी, ची बी याकुबेन बायर बणे करीन। <verse eid="GEN 30:9" /><verse number="10" style="v" sid="GEN 30:10" />ने लीयान पावरनीन याकुब सी एक पुर्‌यु हयु। <verse eid="GEN 30:10" /><verse number="11" style="v" sid="GEN 30:11" />तत्‌यार लीया कय, “मे बेसकी भाग वाळी छे।” ने ची तीना पुर्‌यान नाव गाद पाड़ी। <verse eid="GEN 30:11" /><verse number="12" style="v" sid="GEN 30:12" />अळतेन याकुब सी लीयान पावरनी जील्‌पान एक अळी पुर्‌यु हयु। <verse eid="GEN 30:12" /><verse number="13" style="v" sid="GEN 30:13" />लीया कय, “मे बेसकी-खुस छे। जी वात सामळन्‌या आखा बायरा खुस हय्‌न मेसेक संयबरकत वाळी कवसे।” तेरेमां ची तीना पुर्‌यान नाव आसेर पाड़ी।<verse eid="GEN 30:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 30:14" />गहुं काटणेन टेमे रुबेन खेत मां गुयु, ती तीना काजे खयड़ा मां एक भातीन फळे जड़्‌या, तीनु काजे दुदाफळ<note caller="+" style="f"><char style="fr" closed="false">30:14 </char><char style="fq" closed="false">दुदाफळ </char><char style="ft" closed="false">दुदाफळ खाणे सी भार पाये हवणेन ताकत जड़े</char></note> कहे। चु चे दुदाफळ आपसी आय्‌स लीया काजे आप्‌यु। तत्‌यार राहेल लीया काजे कय, “तारु बेटु जे दुदाफळ लायु, तीनु माय्‌न थुड़ाक मेसेक आप दे।”<verse eid="GEN 30:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 30:15" />लीया राहेल काजे कय, “तु मारा धेणी काजे आपसा वाटे मांग लेदी, ने हंय मारा पुर्‌यान दुदाफळ बी मांगणे हींड र्‌यु?”</para>
  <para style="p" vid="GEN 30:15">बाकुन राहेल लीया काजे कय, “कदी तु, तारु पुर्‌यु लावलु चे दुदाफळ मेसेक आपसी, ती तु आज राती याकुब पुठ्‌ये सुय सके।”<verse eid="GEN 30:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 30:16" />सांती वेळाय याकुब खेतेम सी आवणे बाजी रहलु, ती लीया तीनाक सांबी भेळी हवणे गुय ने कय, “आज राती तुसे काजे मार भेळे सुवणु पड़से, काहाकी मे मारु पुर्‌यु लावलु चे दुदाफळ राहेल काजे आपीन तुसेक मुल ली लेदली छे।” ने याकुब तीनी राती लीया भेळेत सुयु।<verse eid="GEN 30:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 30:17" />तत्‌यार भगवान लीयान दुवा सामळी लेदु, ने ची याकुब सी भार पाये हय गुय, ने याकुब सी तेरु पांचवु पुर्‌यु हयु। <verse eid="GEN 30:17" /><verse number="18" style="v" sid="GEN 30:18" />तत्‌यार लीया कय, “भगवान मेसेक असु करीन ईनाम आपलु छे, काहाकी मे मारा धेणी काजे मारी पावरनी आप देदी।” ने ची तीना पुर्‌यान नाव ईस्‌साकार पाड़ी। <verse eid="GEN 30:18" /><verse number="19" style="v" sid="GEN 30:19" />लीया अळी भारपाये हय, ने याकुब सी तेरु छटवु पुर्‌यु हयु। <verse eid="GEN 30:19" /><verse number="20" style="v" sid="GEN 30:20" />तत्‌यार लीया कय, “भगवान मेसेक एक बेसकु वारु वाटु आपलु छे। हंय ते मारु धेणी मारेत पुठ्‌ये रवसे, काहाकी तेरे सी मारा छव पुर्‌या हय गुयला छे।” तेरेमां ची तीना पुर्‌यान नाव जबुलुन पाड़ी। <verse eid="GEN 30:20" /><verse number="21" style="v" sid="GEN 30:21" />अळतेन याकुब सी लीयान एक पुरे बी हय, ने ची तेरो नाव दीना पाड़ी।<verse eid="GEN 30:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 30:22" />अळतेन भगवान राहेल काजे हेर करीन तेरे पर बी दया कर्‌यु। ने तेरी दुवा सामळीन तेरी कुख काजे उगाड़ देदु। <verse eid="GEN 30:22" /><verse number="23" style="v" sid="GEN 30:23" />राहेल भार पाये हय ने तेरु एक पुर्‌यु हयु; ने ची कय, “भगवान मारी नाव-बद्‌दी छेटे कर देदलु छे। <verse eid="GEN 30:23" /><verse number="24" style="v" sid="GEN 30:24" />ने यहोवा भगवान मेसेक एक अळी पुर्‌यु आपसे।” ने तेरो नाव युसुफ पाड़ी।<verse eid="GEN 30:24" /></para>
  <para style="s">याकुब ने लाबानेन ईचमां समजतु करे</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 30:25" />जत्‌यार राहेल सी युसुफ हयु, ती याकुब लाबान काजे कह्‌यु, “हंय मेसेक वळाय दे, ने मारा देसेम जाणी दे। <verse eid="GEN 30:25" /><verse number="26" style="v" sid="GEN 30:26" />मेसेक मारा बायरा-छुरा आप दे, तींद्‌रे वाटे मे तारो सेवान-काम करलु छे; एने मे तीनुक लीन जात रवीस। तु जाणे की, मे तारो कसो सेवान-काम करलु छे।”<verse eid="GEN 30:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 30:27" />लाबान, याकुब काजे कह्‌यु, “मेसेक असो लागे की, तार वाटेत यहोवा भगवान मारे पर गीण करीन मेसेक संयबरकत आपलु छे। <verse eid="GEN 30:27" /><verse number="28" style="v" sid="GEN 30:28" />देखाड़ की, तुसेक काय चाहजे ने मे तुसेक चत आपीस।”<verse eid="GEN 30:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 30:29" />याकुब लाबान काजे कह्‌यु, “तु ते जाणे की, मे तारा सेवान-काम बेसकु करलु छे, ने तारा बुकड़ान ने गाडरान मे कसु काय राखवाळी कर्‌यु। ने चे वारलु रवतेला छे।”<verse eid="GEN 30:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 30:30" />जत्‌यार मे आवलु तत्‌यार कतराक हतला, ने हंय ते बेसका वेल वदीन हय ज्‌या; मे आयु ती यहोवा भगवान तुसेक संयबरकत आप्‌यु: बाकुन वीच्‌यार कर मे मारा घरेन काम कत्‌यार करीस?<verse eid="GEN 30:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 30:31" />लाबान याकुब काजे कह्‌यु, “मे तुसेक काय आपो, कय दे?”</para>
  <para style="p" vid="GEN 30:31">याकुब कह्‌यु, “तु मेसेक असलुत काय बी घुण आपतु; दाहड़की आप दीस ती, मे ती बी तारा गाडरा ने बुकड़ा चारीस ने तींद्‌री राखवाळी करीस। <verse eid="GEN 30:31" /><verse number="32" style="v" sid="GEN 30:32" />मे आज तारा गाडरा ने बुकड़ान ईचमां माय्‌न छरकीस, ने जे काबर्‌या-चीतर्‌या बुकड़ा ने गाडरा हसे, ने जे गाडरान पीला काळ्‌ळा हसे, चे मे आंग्‌ये कर लीस; ने चेत मारी दाहड़की रवसे। <verse eid="GEN 30:32" /><verse number="33" style="v" sid="GEN 30:33" />ने अळतेन जत्‌यार तु मारा गाडरा ने बुकड़ा देखणे आवसी; ती मारा गाडरान ने बुकड़ान टुळा मां काळ्‌ळा गाडराक ने काबर्‌या-चीतर्‌या बुकड़ाक छुड़ीन काहनो धवळ्‌यो गाडरो (नीते काळळो बुकड़ो) तुसेक नी जड़े। असला जड़से ती तु समजी जाजी, मे तारा गाडरा ने बुकड़ा चुरी कर र्‌यु। बाकुन आवणेवाळा दाहड़ा मां तुसेक पतु चाल जासे की, मे ईमानदार छे।”<verse eid="GEN 30:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 30:34" />याकुबेन वात सामळीन लाबान कह्‌यु, “हव, तु कहे तसोत करने करीन मे तीयार छे।” <verse eid="GEN 30:34" /><verse number="35" style="v" sid="GEN 30:35" />बाकुन तीनेत दाहड़े लाबान तीनु आखा काबर्‌या-चीतर्‌या बुकड़ा ने बुकड़ा काजे आंग्‌ये कर देदु, तींद्‌रे पर धवळ्‌या रेगटान सहलाणी हतला; काळ्‌ळा गाडरा काजे बी आंग्‌ये कर देदु ने आपसा पुर्‌या काजे बुलावीन तीनुक आप देदु। <verse eid="GEN 30:35" /><verse number="36" style="v" sid="GEN 30:36" />ने तीनुक आखा काबर्‌या-चीतर्‌या गाडरा ने बुकड़ा लीन दीसरे जागे मकली देदु। चे पुर्‌या, तीन दाहड़ान चाल चालीन जाय ने नांबे जात रया ने तींखुरुत चे काबर्‌या-चीतर्‌या गाडरा ने बुकड़ा चारने बाज-ज्‌या। बाकुन याकुब, लाबानेन बचला गाडरा ने बुकड़ा भेळे, तीनेत जागे उभा हय ज्‌या, ने याकुब ईंखुरुत लाबानेन बचला धवळ्‌या गाडरा ने काळ्‌ळा बुकड़ान देख-रेख करने बाजी ज्‌यु। बाकुन तीनु गाडरा ने बुकड़ा मां एक बी काबर्‌या-चीतर्‌या गाडरा ने बुकड़ा नी हतलो।<verse eid="GEN 30:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 30:37" />याकुब चीनार, बादाम ने ओर्‌मन नावेन झाड़कान नीळ्‌ळा डाळखा काट देदु। तीनु डाळखाम सी सुट्‌या काट लेदु ने तीनुक रेगाटा-रेगाटा बणावीन छुल देदु (ती चे सुट्‌या काळ्‌ळो-धवळ्‌यो छेल-भात्‌या दुय-रंग वाळा देखाव पड़्‌या।) <verse eid="GEN 30:37" /><verse number="38" style="v" sid="GEN 30:38" />ने याकुब तीनु छुल्‌ला रेगटाळ्‌या सुट्‌या काजे बुकड़ा जां बुकड़ा ने गाडरा पाणी पीये चां ली जाय्‌न उबा धर रह्‌यु; ने जत्‌यार चे पाणी पीणे आया, ती चां बुकड़ा ने गाडरा गेराय गुया। <verse eid="GEN 30:38" /><verse number="39" style="v" sid="GEN 30:39" />चे तीनु रेगटाळ्‌या सुट्‌या अगळ वाहळाया, ने चे काबर्‌या-चीतर्‌या ने रेगटाळ्‌या गीदल्‌या जे जण्‌या।<verse eid="GEN 30:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="GEN 30:40" />तत्‌यार याकुब गाडरान ने बुकड़ान गीदल्‌या आंग्‌ये-आंग्‌ये कर देदु। ने याकुब आपसा गाडरा ने बुकड़ा लाबान मामान गाडरा ने बुकड़ा मां भेसकायणे नी देदु।<verse eid="GEN 30:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 30:41" />जत्‌यार बी मातला गाडरा ने बुकड़ा गेरायतेला, तत्‌यार याकुब आपसा छुल्‌ला डाळखा काजे बुकड़ा पाणी पीये चां उबा कर देत्‌लु; ने चे गाडरा ने बुकड़ा गेराय जातला। <verse eid="GEN 30:41" /><verse number="42" style="v" sid="GEN 30:42" />जत्‌यार लुल्‌ला बुकड़ा ने गाडरा गेरायतेला ती चु तींद्‌रे अगळ छुल्‌ला डाळखान सुट्‌या नी मेलतु। तेरेमां लुल्‌ला-लुल्‌ला गाडरा ने बुकड़ा लाबान धड़े हतला, ने वारलु ने मातला याकुबेन हतला। <verse eid="GEN 30:42" /><verse number="43" style="v" sid="GEN 30:43" />ने याकुबेन बेसके जुरे गाडरा ने बुकड़ा हय ज्‌या। तेरेमां चु बेसकु मात-भर हय ज्‌यु। ने तेरे धड़े पावर्‌या ने पावरनी हतला, ने उटड़ा ने गदड़ा बी हतला।<verse eid="GEN 30:43" /></para>
  <chapter eid="GEN 30" />
  <chapter number="31" style="c" sid="GEN 31" />
  <para style="s">याकुब लाबान धड़े सी डासीन जाय</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 31:1" />अळतेन लाबानेन पुर्‌यान जी वात याकुब काजे सामळनेन आय, “याकुब हामरा बासेन आखो काय हापकी लेदु, ने बासेन माल-धन मांगीन आपसु मालदार बण ज्‌यु।” <verse eid="GEN 31:1" /><verse number="2" style="v" sid="GEN 31:2" />ने याकुब असु देख्‌यु की लाबान पेहलेन तसु परम भाव नी करे। <verse eid="GEN 31:2" /><verse number="3" style="v" sid="GEN 31:3" />तत्‌यार यहोवा भगवान याकुब सी कह्‌यु, “तुंद्‌रा डाहा-बुड़ान देस मां ने आपसा पयदावारीन जागा पर जाती रव, ने मे तारे साते रवीस।”<verse eid="GEN 31:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 31:4" />तत्‌यार याकुब, राहेल ने लीया काजे खयड़ा मां आपसान गाडरा-बुकड़ा धड़े बुलावीन कह्‌यु, <verse eid="GEN 31:4" /><verse number="5" style="v" sid="GEN 31:5" />“तुंद्‌रा बासेन मुंहडा काजे देखीन असो मालम पड़े, की हयु मेसे पेहलेन तसु हंय मेसे नी राखे; बाकुन मारा बासेन भगवान मारे साते छे।” <verse eid="GEN 31:5" /><verse number="6" style="v" sid="GEN 31:6" />तु बी जाणे की मे तारा बासेन सेवा पुरा ताकुत सी कर्‌यु। <verse eid="GEN 31:6" /><verse number="7" style="v" sid="GEN 31:7" />तेबी तारु बास मेसे धुकु दीन मारी दाहड़की काजे दस कावा बदली देदु; बाकुन भगवान मारे काय बी नुकसान नी करनी देदु। <verse eid="GEN 31:7" /><verse number="8" style="v" sid="GEN 31:8" />जत्‌यार हयु कह्‌लु, चीत्‌रा वाळा गाडरा-बुकड़ा तारी दाहड़की रवसे, तत्‌यार आखा गाडरा-बुकड़ा चीत्‌रा वाळात हवणे लाग्‌या; ने जत्‌यार हयु कह्‌यु, धार्‌या वाळा तारी दाहड़की रवसे, तत्‌यार आखा धार्‌या वाळा हवणे लाग्‌या। <verse eid="GEN 31:8" /><verse number="9" style="v" sid="GEN 31:9" />तसु करीन भगवान तारा बासेन घर माले लीन मेसेक आप देदा।<verse eid="GEN 31:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 31:10" />एक कावा मे सपना मां असु देखणे बाजी रहलु की, जे बुकड़ा, बुकड़ी पर कुदणे बाजी रहला, चे बुकड़ा धारीवाळा, ने काबर्‌या-चीतर्‌या हतला <verse eid="GEN 31:10" /><verse number="11" style="v" sid="GEN 31:11" />तत्‌यार भगवानेन सरगेन काहवाळ्‌यु सपना मां कह्‌यु ए याकुब, मे कह्‌यु, काय हुकुम छे। <verse eid="GEN 31:11" /><verse number="12" style="v" sid="GEN 31:12" />चु कह्‌यु, उचु भाळीन तीनु आखा बुकड़ा काजे जे तीनु बुकड़ी पछळ हतला तीनु काजे देख, की चे धारीवाळा, चीत्‌रा वाळा, ने दागवाळा छे; काहाकी जो काय लाबान तारे सी भुंडो करे, चो मे देखलु छे। <verse eid="GEN 31:12" /><verse number="13" style="v" sid="GEN 31:13" />मे तीना बेतेलेन भगवान छे, जां तु एक खंबा पर तेल नाखलु, ने मारी बादा लेदलु। हंय चाल, ईना देस सी नीकळीन आपणी पयदावारीन जागा पर जा।<note caller="+" style="x"><char style="xo" closed="false">31:13 </char><char style="xt" closed="false"><ref loc="GEN 28:18-22">उबजाणनी किताप 28:18-22</ref></char></note><verse eid="GEN 31:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 31:14" />तत्‌यार राहेल ने लीया याकुब काजे जपाप आप्‌या, “काय हामरो हंय बी हामरा बासेन घर कायनी वाटु बच्‌यु? <verse eid="GEN 31:14" /><verse number="15" style="v" sid="GEN 31:15" />काय हामु तेरी नींगा मां पारका बण ज्‌या काय? देख, हयु हामुक ते वेच देदु, ने तसु करीन हामरो आखो धन सार देदु। <verse eid="GEN 31:15" /><verse number="16" style="v" sid="GEN 31:16" />तेरेमां भगवान हामरा बासेन जतरो बी धन ली लेदलु छे, चो हामरा ने हामरा पुर्‌यान छे; हंय जो काय भगवान तार सी कहे, चत कर।”<verse eid="GEN 31:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 31:17" />तत्‌यार याकुब आपसा पुर्‌याक ने बायराक उटड़ा पर बठाड़ देदु; <verse eid="GEN 31:17" /><verse number="18" style="v" sid="GEN 31:18" />ने जतरा बी माल-धन चु पद्‌दनराम मां भेळु करीन मालदार बण गुयलु, आखा तीनुक लीन कनान देस मां आपसा बास इसाक धड़े जाणेन मरजी सी, साते ली गुयलु। <verse eid="GEN 31:18" /><verse number="19" style="v" sid="GEN 31:19" />लाबान आपसा गाडरान कान्‌या कातरने करीन जाती रहलु, ने राहेल आपसा बासेन घरन्‌या देवे काजे चुट्‌टाये ली जाती रहली। <verse eid="GEN 31:19" /><verse number="20" style="v" sid="GEN 31:20" />तेरेमां याकुब अरामी माणसे धड़े सी चुरी सी ढासी ज्‌यु, बाकुन तीनाक बताड़्‌यु नी की मे ढास जाम। <verse eid="GEN 31:20" /><verse number="21" style="v" sid="GEN 31:21" />चु आपसान आखो काय लीन ढास्‌यु, ने फरात नदीन पली धड़े जाय्‌न गीलाद देस भीणी गुयु। <verse eid="GEN 31:21" /><verse number="22" style="v" sid="GEN 31:22" />तीसरे दाहड़े लाबान काजे खबर जड़ी की याकुब ढास ज्‌यु। <verse eid="GEN 31:22" /><verse number="23" style="v" sid="GEN 31:23" />तेरेमां चु आपसा माणसेक भेळा करीन सात दाहड़ा लग तेरे पछळ पड़्‌यु, ने गीलाद देसेन बयड़ा मां तीनाक धर लेदु। <verse eid="GEN 31:23" /><verse number="24" style="v" sid="GEN 31:24" />बाकुन भगवान रातेन सपना मां अरामी लाबान धड़े आवीन कह्‌यु, “चेतीन रव, तु याकुब काजे वारु कवजी ने नी भुंडो कवजी।” <verse eid="GEN 31:24" /><verse number="25" style="v" sid="GEN 31:25" />ने लाबान धड़े जाती र्‌यु। याकुब आपसान तम्‌बुक गीलाद नावेन बयड़ान देस मां उबु करलु हतलु; ने लाबान बी आपसा भायसे भेळे आपसान तम्‌बु तीनात देसेन बयड़ा मां उबु कर्‌यु।<verse eid="GEN 31:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 31:26" />तत्‌यार लाबान याकुब सी कहणे लाग्‌यु, “तु असु काय कर्‌यु की मारे धड़े सी चुरी सी आवती र्‌यु, ने मारी पुरेक असु ली आयु, मानु की चे लड़ाय मां धरायली पुरे हय? <verse eid="GEN 31:26" /><verse number="27" style="v" sid="GEN 31:27" />तु हुगलुत काहा ढासी आयु, ने मेसेक पुछ्‌यु नी ने मारेन्‌चां सी जाती र्‌यु; कदी तु कवतु ते मे खुसी सी खाणो खावाड़नी ने वाजा-गाजा ने गीते गावता जाय्‌न तुसेक मकेलतु? <verse eid="GEN 31:27" /><verse number="28" style="v" sid="GEN 31:28" />तु ते मेसे मारी पुरेन गुळा लग नी देणी देदु? तु असु करीन तु वारु नी कर्‌यु। <verse eid="GEN 31:28" /><verse number="29" style="v" sid="GEN 31:29" />तुहुंं काजे नुकसान करनेन मारे भीणी ताकुत ते छे; बाकुन तुंद्‌रा बासेन भगवान मारे सी गुये रात्‌ये कह्‌यु, ‘चेतीन रव, याकुब काजे नीते वारु कवजी ने नी भुंडो कवजी।’ <verse eid="GEN 31:29" /><verse number="30" style="v" sid="GEN 31:30" />मे जाणो की तु आपसा घर जाणे हींडतेलु तेरेमां तु जाती र्‌यु, बाकुन तु मारा घर सी देवता काजे चुट्‌टाये काहा ली ज्‌यु?”<verse eid="GEN 31:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 31:31" />याकुब लाबान काजे जपाप आप्‌यु, “मे असु सुचीन बीही गुयलु की कांखुर माय्‌न मारी पुरे काजे ली जाती नी रहे। <verse eid="GEN 31:31" /><verse number="32" style="v" sid="GEN 31:32" />जीना भीणी बी तारा देवता जड़े, चु नी जीवे। मारे धड़े जो काय तारो नीकळे, तीनाक मारा गवा माणसे अगळ उलखीन ली ले।” काहाकी याकुब नी जाणतेलु राहेल घरेन देवता काजे चुट्‌टाये ली आवली।<verse eid="GEN 31:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 31:33" />असु सामळीन लाबान, याकुब ने लीया ने दुयु पावरनीन तम्‌बु मां गुयु; ने काय नी जड़्‌यो। तत्‌यार लीयान तम्‌बुम सी नीकळीन राहेलेन तम्‌बु मां गुयु। <verse eid="GEN 31:33" /><verse number="34" style="v" sid="GEN 31:34" />राहेल ते घरेन देवता काजे उटड़ा पर झुळनो मेकीन तेर पर बठी रहली। लाबान तींद्‌रा आखा तम्‌बु हेर्‌यु तेबी नी जड़्‌या। <verse eid="GEN 31:34" /><verse number="35" style="v" sid="GEN 31:35" />राहेल आपसान बास सी कय, “ए मारा बास; मार पर मां रीसवाये। मे तार अगळ उभी नी हय; काहाकी छेटे हय रहली।” तेरेमां तीनाक घर सी देवता हेर्‌यु तेबी नी जड़्‌या।<verse eid="GEN 31:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 31:36" />तत्‌यार याकुब रीसवाय्‌न लाबान सी लड़ाय करने लाग्‌यु, “मारु काय गुनु छे? मारु काय पाप छे की तु मारे पछळ पड़्‌यु ने रुकणेन हक कसु हयु? <verse eid="GEN 31:36" /><verse number="37" style="v" sid="GEN 31:37" />तु मारा आखा समान्‌या मां हेर्‌यु, ती तुसे मारा घरेन आखा समान्‌या मां सी काय जड़्‌यो? काहींग जड़्‌यो हय ती तीनाक आपणे घर ने आपणा भायस अगळ मेक दे, ने चे आपणे ईचमां नीयाव करे। <verse eid="GEN 31:37" /><verse number="38" style="v" sid="GEN 31:38" />ईनु वीस साल लग मे तारे धड़े रह्‌यु; तेरेम नी ते तारा बुकड़ा-गाडरा गाबण नाख्‌या, ने नी मे तारा पाठड़्‌यान मास खादु। <verse eid="GEN 31:38" /><verse number="39" style="v" sid="GEN 31:39" />जीनाक बयड़ा माय्‌न जानवर्‌या मार्‌या तीनुक तार धड़े नी लावतेलु, ने तीनीत कीमत मां देतलु; चाहे वीजाळे चुरी हवे, चाहे रात्‌ये, तेबी मारे सी ली लेतलु। <verse eid="GEN 31:39" /><verse number="40" style="v" sid="GEN 31:40" />मारी ते असी हालत हतली की दीसु ते तपे ने रात्‌ये काय उस्‌टा मां मेसेक नींद नी आवतेली। <verse eid="GEN 31:40" /><verse number="41" style="v" sid="GEN 31:41" />वीस साल लग मे तारे घर रह्‌यु; चोवदे साल लग ते मे तारी दुयु पुरे वाटे, ने छव साल तारा गाडरा-बुकड़ा वाटे सेवा कर्‌यु; ने तु मारी धाड़की काजे दस कावा बदली देदु। <verse eid="GEN 31:41" /><verse number="42" style="v" sid="GEN 31:42" />मारा बासेन घर, मतलब अब्‌राहमेन भगवान, तेरो बीहाणो इसाक बी माने, कदी मार भीणी नी रवतु ते छाचलीन तु हंय मेसे खाली हाते जाणी देतु। मारा दुख ने मारा हातेन काठा काम काजे देखीन भगवान काल रात्‌ये तुसेक लड़्‌यु।”<verse eid="GEN 31:42" /></para>
  <para style="s">याकुब ने लाबानेन ईचमां वादु</para>
  <para style="p">
    <verse number="43" style="v" sid="GEN 31:43" />लाबान याकुब सी कह्‌यु, “जी पुरे ते मारीत छे, ने जे पुर्‌या बी मारात छे, ने जे गाडरा-बुकड़ा बी मारात छे। बाकुन हय मे ईनु पुरे, ने अवल्‌यात सी काय कर सको? <verse eid="GEN 31:43" /><verse number="44" style="v" sid="GEN 31:44" />हंय आव, मे ने तु वादु करजे, ने चो तारे ने मारे ईचमां गवा बणीन रहे।”<verse eid="GEN 31:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="GEN 31:45" />तत्‌यार याकुब एक दगड़ु लीन खंबु उबु कर्‌यु। <verse eid="GEN 31:45" /><verse number="46" style="v" sid="GEN 31:46" />तत्‌यार याकुब आपसा भाय बेटा सी कह्‌यु, “दगड़ा भेळा करु,” असा सामळीन चे दगड़ा भेळा करीन एक ढेर बणाया, ने हीनात ढेर धड़े चे खाणो खादा। <verse eid="GEN 31:46" /><verse number="47" style="v" sid="GEN 31:47" />तीना ढेरेन नाव लाबान ते यजर सहादुथा पाड़्‌यु, बाकुन याकुब तेरो नाव गीलीयाद पाड़्‌यु। <verse eid="GEN 31:47" /><verse number="48" style="v" sid="GEN 31:48" />लाबान कह्‌यु, “जु ढेर तारे मे मारे ईचमां गवा रवसे।” तेरेमां तेरो नाव गीलीयाद पाड़्‌या, <verse eid="GEN 31:48" /><verse number="49" style="v" sid="GEN 31:49" />ने मीजपा बी; काहाकी हयु कह्‌यु, “जत्‌यार आपणु छेटे-छेटे रवजे तत्‌यार यहोवा भगवान मारी ने तारी नीगा राखतु रहे। <verse eid="GEN 31:49" /><verse number="50" style="v" sid="GEN 31:50" />कदी तु मारी पुरे काजे दमे नीते तीनुक छुड़ीन दीसरी सी ईयाव करे, ती आपणे साते काहनुक माणुस ते नी रवसे; बाकुन देख, मारे तारे ईचमां भगवान गवा रवसे।” <verse eid="GEN 31:50" /><verse number="51" style="v" sid="GEN 31:51" />अळतेन लाबान याकुब सी कह्‌यु, “ईना ढेर काजे देख ने ईना खंबा काजे देख, जीनाक मे मारे ने तारे वाटे हेर करने करीन बणावला छे। <verse eid="GEN 31:51" /><verse number="52" style="v" sid="GEN 31:52" />जु ढेर ने जु खांबु दुयु, ईनी वातेन गवा छे की लड़ाय करनेन मन सी नीते ते ईना ढेरेन पली आवीस ने नी तु ईनी धड़े आवसी। <verse eid="GEN 31:52" /><verse number="53" style="v" sid="GEN 31:53" />अब्‌राहम ने नाहोर ने तेरु बास; तींद्‌रु जु भगवान छे, हयुत आपणु दुयुन ईचमां नीयाव करे।” तत्‌यार याकुब तेरी सगुन खादु ने हेरो बीहाणो तेरु बास इसाक बी मानतेलु; <verse eid="GEN 31:53" /><verse number="54" style="v" sid="GEN 31:54" />ने याकुब तीना बयड़ा पर जानवर्‌यान बादा चड़ायु, ने आपसा भाय-बेटा काजे खाणो खाणे करीन बुलायु, तत्‌यार चे खाणो खायन तीना बयड़ा पर रात रुक्‌या। <verse eid="GEN 31:54" /><verse number="55" style="v" sid="GEN 31:55" />ने लाबान एगुत उठ्‌यु, ने आपसा पुरे-पुर्‌यान गुळा देदु ने संयबरकत आपीन जाती र्‌यु, ने आपसे घर जाती र्‌यु।<verse eid="GEN 31:55" /></para>
  <chapter eid="GEN 31" />
  <chapter number="32" style="c" sid="GEN 32" />
  <para style="s">याकुब एसाव सी भेळो हवणेन करीन तीयारी करे</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 32:1" />याकुब बी आपसी वाटे गुयु, ने भगवानेन सरगे वाळा काहवाळ्‌या तीनाक भेळा हया। <verse eid="GEN 32:1" /><verse number="2" style="v" sid="GEN 32:2" />तीनुक देखतेत याकुब कह्‌यु, “जे ते भगवानेन टुळु छे।” तेरेमां हयु तीना जागान नाव महनेम<note caller="+" style="f"><char style="fr" closed="false">32:2 </char><char style="ft" closed="false">दुय टुळा</char></note> पाड़्‌यु।<verse eid="GEN 32:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 32:3" />तत्‌यार याकुब सेईर देस मां, मतलब एदोम देस मां, आपसा भाय एसाव धड़े आपसा अगळ काहवाळ्‌या मकल्‌यु, <verse eid="GEN 32:3" /><verse number="4" style="v" sid="GEN 32:4" />ने हयु असु हुकुम आप्‌यु, “मारा मालीक एसाव सी असु कवजी: तारु पावर्‌यु याकुब तार सी असु कहे की मे लाबानेन चां हंय लग पारकु बणीन रह्‌यु; <verse eid="GEN 32:4" /><verse number="5" style="v" sid="GEN 32:5" />ने मारे धड़े गावड़ी-बेल, गदड़ा, गाडरा-बुकड़ा, ने पावर-पावरनी छे: ने मे मारा मालीक धड़े असु करीन वात मकल्‌यु की तारी गीण-दया मार पर रवे।”<verse eid="GEN 32:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 32:6" />चे काहवाळ्‌या याकुब सी कहणे लाग्‌या, “हामु तारा भाय एसाव धड़े गुयला, ने चु बी तार सी भेळु हवणे करीन च्‌यार सोव माणसे लीन आवे।” <verse eid="GEN 32:6" /><verse number="7" style="v" sid="GEN 32:7" />तत्‌यार याकुब अदुस बीही ज्‌यु, ने फीकुर मां पड़ ज्‌यु; ने असु सुचीन आपसा दुस्‌तीदारेन, ने गाडरा-बुकड़ाक, ने गावड़ी-बेल, ने उटड़ान बी अलग-अलग टुळा बणाय देदु, <verse eid="GEN 32:7" /><verse number="8" style="v" sid="GEN 32:8" />की कदी एसाव आवीन पेहला टुळा काजे मारने बाजी जाय, ती दीसरु टुळु ढासीन बची जासी।<verse eid="GEN 32:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 32:9" />अळतेन याकुब कह्‌यु, “ए यहोवा, ए मारा बाबा अब्‌राहमेन भगवान, ए मारा बास इसाकेन भगवान, तु ते मेसे कहलु की मारा देस ने पयदावारीन जागा पर जाती रव, ने मे तारी भलाय करीस: <verse eid="GEN 32:9" /><verse number="10" style="v" sid="GEN 32:10" />तु मारे पर गीण करीन भलो करे असु ते मे नी हय, बाकुन तेबी तु गीण करीन मारे वाटे छाचाय सी काम करलु छे। ने मे मारु डेंगु लीन यरदन नदी वेणकीन आवती रहलु छे। तेरेमां हंय मे मारा दुय टुळा बण गुयला छे। <verse eid="GEN 32:10" /><verse number="11" style="v" sid="GEN 32:11" />मारी दुवा सामळीन मारा भाय एसावेन हात सी बचाड़: मे तेरे सी बीहो,कान्‌खुर मायन असो हवे की चु आवीन मेसे ने माय भेळेत पुर्‌याक बी मार नाखे। <verse eid="GEN 32:11" /><verse number="12" style="v" sid="GEN 32:12" />तु ते कहलु की छाचलीन मे तारे सी भलाय करीस, ने तारा अवल्‌यात काजे दरीयान बालु रेतेन तसु गीणाये नी तत्‌रा अवल्‌यात करीस।”<note caller="+" style="x"><char style="xo" closed="false">32:12 </char><char style="xt" closed="false"><ref loc="GEN 22:17">उबजाणनी किताप 22:17</ref></char></note><verse eid="GEN 32:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 32:13" />हयु तीने दाहड़े चांहान रात रह्‌यु; ने जो काय तेर धड़े हतलो तेरेम सी आपसा भाय एसाव काजे आपणे करीन छाटी-छाटीन नीकाळ्‌यु; <verse eid="GEN 32:13" /><verse number="14" style="v" sid="GEN 32:14" />मतलब दुय सोव बुकड़ी, ने वीस बुकड़ा, ने दुय सोव गाडरा, ने वीस गीदल्‌या, <verse eid="GEN 32:14" /><verse number="15" style="v" sid="GEN 32:15" />ने उटड़ा बी जे जन्‌नला हतला, ने चाळीस गावड़ी, ने दस बेल, ने वीस गदड़ी ने दस पीला। <verse eid="GEN 32:15" /><verse number="16" style="v" sid="GEN 32:16" />याकुब ईनु आखा जानवर्‌या काजे तेरा पावर्‌यान हातेम सुप देदु ने तीनुक कह्‌यु, “तुहुंं अगा जाती रहु; ने आंग्‌ये-आंग्‌ये टुळान ईचमां जागु राखु।” <verse eid="GEN 32:16" /><verse number="17" style="v" sid="GEN 32:17" />अळतेन हयु अगला टुळान राखवाळ्‌या काजे असु हुकुम आप्‌यु, “जत्‌यार मारु भाय एसाव जड़े, ने पुछणे लागे, ‘तु कुणीन पावर छे, ने कां जाय, ने जे तारे अगळ-अगळ छे, चे कुणीन छे?’ <verse eid="GEN 32:17" /><verse number="18" style="v" sid="GEN 32:18" />तत्‌यार कवजी, जे तारा पावर याकुबेन छे। ए मारा मालीक एसाव, जे चड़ावणे करीन तार धड़े लावला छे, ने चु बी पुठ्‌ये आवणे बाजी र्‌यु।” <verse eid="GEN 32:18" /><verse number="19" style="v" sid="GEN 32:19" />ने हयु दीसरा ने तीसरा राखवाळ्‌या काजे बी, मतलब आखा तीनु टुळान पछळ-पछळ हतला असात हुकुम देदु की जत्‌यार एसाव तुहुंंक जड़े तत्‌यार असु तीनुक कवजी। <verse eid="GEN 32:19" /><verse number="20" style="v" sid="GEN 32:20" />ने असो बी कवजु की, तारु गुलाम-पावर पछळ आवणे बाजी र्‌यु। याकुब असु वीच्‌यार कर्‌यु, “मे जी जानवर्‌या भेट अगळ-अगळ मकलीन एसाव्‌यान रीस काजे सेळवी दीस, ने अळतेन तीनाक भेळु हयस ती चु खुस हय जासे।” <verse eid="GEN 32:20" /><verse number="21" style="v" sid="GEN 32:21" />तेरेमां चु चड़ावु याकुब पेहेल पुग गुयु, ने चु आपसु तीने रात्‌ये तम्‌बु मां रह्‌यु।<verse eid="GEN 32:21" /></para>
  <para style="s">याकुबेन लड़ाय</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 32:22" />तीनेत रात्‌ये चु उठ्‌यु ने आपसान दुय बायरा ने दुयु पावरनी ने ग्‌यारे पुर्‌या काजे भेळे लीन घाट सी यब्‌बोक नदीन पली धड़े जाती र्‌या। <verse eid="GEN 32:22" /><verse number="23" style="v" sid="GEN 32:23" />हयु तीनुक तीनी नदीन पार उतार देदु, मतलब आपसान आखो काय पार उतार देदु। <verse eid="GEN 32:23" /><verse number="24" style="v" sid="GEN 32:24" />ने याकुब चां एखलु रय ज्‌यु;</para>
  <para style="p" vid="GEN 32:24">तत्‌यार काहनुक पुर्‌यु आवीन दाहड़ु उंगणे सी पेहेल लग तेरेसी लड़ाय करतु रह्‌यु। <verse eid="GEN 32:24" /><verse number="25" style="v" sid="GEN 32:25" />जत्‌यार हयु देख्‌यु की मे याकुब सी नी जीताये तत्‌यार तेरा सातळ्‌याम छीम्‌यु: ने याकुबेन सातळ्‌यान नस लड़ायणेन टेमे नस लागी गुय। <verse eid="GEN 32:25" /><verse number="26" style="v" sid="GEN 32:26" />तत्‌यार हयु कह्‌यु, “मेसे जाणी दे, काहाकी वीजाळो हवणे वाळो छे,” याकुब कह्‌यु,</para>
  <para style="p" vid="GEN 32:26">“जत्‌यार लग तु मेसे संयबरकत नी आपे, तत्‌यार लग मे तुसे जाणी नी दम।”<verse eid="GEN 32:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 32:27" />ने हयु याकुब सी कह्‌यु, “तारो नाव काय छे?”</para>
  <para style="p" vid="GEN 32:27">हयु कह्‌यु, “याकुब।”<verse eid="GEN 32:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 32:28" />हयु कह्‌यु, “तारो नाव याकुब नी हय, बाकुन इस्‌राएल हसे, काहाकी तु भगवान भीणी सी ने माणसे सी बी लड़ाय मां जीतीन आवलु छे।”<verse eid="GEN 32:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 32:29" />याकुब कह्‌यु, “मे तार सी लीलघाय्‌न कहो की, मेसे तारो नाव बताड़।”</para>
  <para style="p" vid="GEN 32:29">चु कह्‌यु, “तु मारो नाव काहा पुछे?” तत्‌यार हयु तीनाक हयुत संयबरकत आप्‌यु।<verse eid="GEN 32:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 32:30" />तत्‌यार याकुब असु कहीन तीना जागान नाव पनीएल<note caller="+" style="f"><char style="fr" closed="false">32:30 </char><char style="ft" closed="false">भगवानेन मुंहडो</char></note> पाड़्‌यु, “भगवान काजे उजेंतु देखलु छे बाकुन तेबी मे नी मर्‌यु” <verse eid="GEN 32:30" /><verse number="31" style="v" sid="GEN 32:31" />पनीएल धड़े चालते-चालते दाहड़ु उंग ज्‌यु, ने चयड़ु जाती रहलु तेरेमां लंगड़ायतेलु। <verse eid="GEN 32:31" /><verse number="32" style="v" sid="GEN 32:32" />तेरेमां इस्‌राएली माणसे आज बी जानवर्‌यान सातळ्‌याम वाळी नस काजे नी खाय। काहाकी चु माणुस याकुबेन सातळ्‌या वाळी नस काजे छीमलु।<verse eid="GEN 32:32" /></para>
  <chapter eid="GEN 32" />
  <chapter number="33" style="c" sid="GEN 33" />
  <para style="s">याकुब ने एसावेन मेळनु</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 33:1" />याकुब उचु भालीन देख्‌यु, की एसाव च्‌यार सोव माणसे लीन आवे। तत्‌यार हयु पुर्‌याक अलग-अलग वाटीन लीया ने राहेल ने तींद्‌री दुयु पावरनी काजे सुप देदु। <verse eid="GEN 33:1" /><verse number="2" style="v" sid="GEN 33:2" />ने चु आखा सी अगळ पुर्‌या भेळे पावरनी काजे, तेर पछळ पुर्‌या भेळे लीया काजे ने आखा सी पछळ राहेल ने युसुफ काजे मेक्‌या, <verse eid="GEN 33:2" /><verse number="3" style="v" sid="GEN 33:3" />ने आपसु तीनु आखा अगळ गुयु ने सांत कावा पाये पड़्‌यु, ने आपसा भायस धड़े गुयु। <verse eid="GEN 33:3" /><verse number="4" style="v" sid="GEN 33:4" />तत्‌यार एसाव तीनाक भेळु हवणे करीन दवड़्‌यु, ने तीनाक गळे लागाड़्‌यु, ने गळे लागीन गुळु देदु; अळतेन चे दुयु रड़ी पड़्‌या। <verse eid="GEN 33:4" /><verse number="5" style="v" sid="GEN 33:5" />तत्‌यार हयु उचु भाळीन बायरा ने पुर्‌या काजे देख्‌यु, ने पुछ्‌यु,</para>
  <para style="p" vid="GEN 33:5">“जे तारा पावर्‌यान पुर्‌या छे, जीनुक भगवान गीण-दया करीन मेसे आप्‌यु।” <verse eid="GEN 33:5" /><verse number="6" style="v" sid="GEN 33:6" />तत्‌यार पुर्‌या भेळे पावर्‌या ने धड़े आवीन पाये पड़्‌यु। <verse eid="GEN 33:6" /><verse number="7" style="v" sid="GEN 33:7" />अळतेन पुर्‌या भेळे ने लीया धड़े आवी ने चे बी पाये पड़्‌या; आकरी मां युसुफ ने राहेल बी धड़े आवीन पाये पड़ी।<verse eid="GEN 33:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 33:8" />तत्‌यार एसाव्‌यु, याकुब काजे पुछ्‌यु, “मेसेक वाट्‌ये माणसेन ने ढुरेन टुळा भेळा हवला, एरो काय मतलब छे?”</para>
  <para style="p" vid="GEN 33:8">याकुब कह्‌यु, “ए मालीक, तु मारे पर गीण करसी करीन जी तारे वाटे भेट छे।”<verse eid="GEN 33:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 33:9" />एसाव कह्‌यु, “मारा भाय, मारे धड़े रेट छे; जो काय तारो छे चो आखो तारोत रहे।”<verse eid="GEN 33:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 33:10" />याकुब कह्‌यु, “नी-नी, कदी तारी गीण-दया मार पर हय, ती मारी बादा काजे मान; काहाकी मेसे तु उजेंतु हयु, बाकुन मानु भगवान उजेंतु हयु असो लागे, ने तु मार सी खुस हवलु छे। <verse eid="GEN 33:10" /><verse number="11" style="v" sid="GEN 33:11" />तेरेमां जी भेट मकेल्‌लु छे, मान कर; काहाकी भगवान मार पर गीण-दया करलु छे, ने मारे धड़े रेट छे।” जत्‌यार हयु तेर सी बेसकु लीलघाय कर्‌यु, तत्‌यार हयु मारी भेट काजे मान कर्‌यु।<verse eid="GEN 33:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 33:12" />अळतेन एसाव कह्‌यु, “आव, आपणु अगा बड़जे; ने मे तारे अगळ-अगळ चालीस।”<verse eid="GEN 33:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 33:13" />बाकुन याकुब एसाव्‌या काजे कह्‌यु, “ए मालीक, तुसेक ते मालमुत छे की, पुर्‌या-पारी लुल्‌ला छे, ने मेसेक दुत आपण्‌या गाडरा, बुकड़ा ने गावड़ी देख-रेख करनु पड़े। कदी मे तीनुक एक दाहड़ा मां बेसके नांबे लग गेरीस, ती चे हार-पड़ीन मर जासे। <verse eid="GEN 33:13" /><verse number="14" style="v" sid="GEN 33:14" />तेरेमां मारु मालीक आपसा पावर्‌यान सी अघु बड़ जाय, ने ईनु मालेन चाल तत्‌रु जे मारे सी अगळ छे, ने पुर्‌यान चालेन तसु धीरु-धीरु चालीन सेईर सहर मां मारा मालीकेन चां जाती रय्‌स।”<verse eid="GEN 33:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 33:15" />एसाव कह्‌यु, “ती आपणा भायस मां सी काहनाक एक काजे तारे धड़े मेल जाम।” हयु कह्‌यु, “असु काहा?”</para>
  <para style="p" vid="GEN 33:15">अतरो रेट छे, “की मारा मालीकेन दया नीगा मार पर बणीन रहे।” <verse eid="GEN 33:15" /><verse number="16" style="v" sid="GEN 33:16" />तत्‌यार एसाव तीनेत दाहड़े सेईर सहर जाणे करीन वाट्‌ये पड़्‌यु। <verse eid="GEN 33:16" /><verse number="17" style="v" sid="GEN 33:17" />ने याकुब सुक्‌कोत नावेन जागे गुयु, ने चां आपसा वाटे एक खपड़ी बणायु। ने ढुरे वाटे ढुरेन वाड़ो बणायु। तेरेमां याकुब तीना जागान नाव सुक्‌कोथ<note caller="+" style="f"><char style="fr" closed="false">33:17 </char><char style="ft" closed="false">एना बुलेन मतलब खोपड़्‌या छे</char></note> पाड़्‌यु।<verse eid="GEN 33:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 33:18" />याकुब, ते पद्‌दनराम सी आवलु, ने चु कनान देसेन सकेम नावेन सहर धड़े वारलु पुग ज्‌यु, ने चां आपसु तम्‌बु ताणीन डेरु नाख देदु। <verse eid="GEN 33:18" /><verse number="19" style="v" sid="GEN 33:19" />ने जागान जीना खुणा पर हयु तम्‌बु उबु कर्‌यु, तीनाक हयु सकेमेन बास हमोरेन पुर्‌यान हाते सी एक सोव चांदीन टका मुल लेदु। <verse eid="GEN 33:19" /><verse number="20" style="v" sid="GEN 33:20" />चां चड़ावान जागु बणायन तेरो नाव एल-एलोहे- इस्‌राएल<note caller="+" style="f"><char style="fr" closed="false">33:20 </char><char style="ft" closed="false">इस्‌राएलेन भगवान</char></note> पाड़्‌यु।<note caller="+" style="x"><char style="xo" closed="false">33:20 </char><char style="xt" closed="false"><ref loc="JHN 4:5">युहन्‌ना 4:5</ref></char></note><verse eid="GEN 33:20" /></para>
  <chapter eid="GEN 33" />
  <chapter number="34" style="c" sid="GEN 34" />
  <para style="s">दीना काजे धरे</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 34:1" />एक दाहड़े लीयान पुरे दीना, जी याकुब सी पयदा हवी, तीना कनान देसेन पुरे काजे भेळी हवणे नीकळी। <verse eid="GEN 34:1" /><verse number="2" style="v" sid="GEN 34:2" />तत्‌यार तीना देसेन मुखी हीव्‌वी हमोरेन पुर्‌यु सकेम तीनाक देख्‌यु, ने तीनीक धरीन जबर जस्‌ती कर्‌या ने तेरु अब्‌रु रहणी नी देदा। <verse eid="GEN 34:2" /><verse number="3" style="v" sid="GEN 34:3" />तत्‌यार तेरो मन याकुबेन पुरे दीना सी लागी ज्‌यु, ने हयु तीनी पुरे सी परमेन वात कर्‌यु, ने तेर सी वारु अदुस परम हय ज्‌यु। <verse eid="GEN 34:3" /><verse number="4" style="v" sid="GEN 34:4" />तेरेमां सकेम आपसा बास हमोर सी कह्‌यु, “मेसे ईनी पुरे काजे मारी घरवाळी बन्‌ने करीन दी देवु।”<verse eid="GEN 34:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 34:5" />ने याकुब सामळ्‌यु की सकेम मारी पुरे दीना साते सोवसार कर्‌यु; बाकुन तेरा पुर्‌या तीने टेमे माले भेळे खयड़ा मां हतला, तेरेमां हयु तीनुक आवणे लग हुगु रह्‌यु। <verse eid="GEN 34:5" /><verse number="6" style="v" sid="GEN 34:6" />तत्‌यार सकेमेन बास हमोर नीकळीन याकुब सी वात करने करीन तेरे धड़े गुयु। <verse eid="GEN 34:6" /><verse number="7" style="v" sid="GEN 34:7" />याकुबेन पुर्‌या, खयड़ाम सी आवतात जी आखी वात सामळ्‌या ने बेसकु रीसवाया पड़्‌या; काहाकी सकेम याकुबेन बेटी दीना साते जबरान धरीन सोवसार करलु ने हयु इस्‌राएलेन घराणा साते भुंड्‌ला काम करलु छे। <verse eid="GEN 34:7" /><verse number="8" style="v" sid="GEN 34:8" />हमोर तीनु आखा सी कह्‌यु, “मारा पुर्‌या सकेमेन मन तारी पुरे पर बेसको लागलो छे, तेरेमां तीनीक तेरी बायर हवणे करीन तीनाक दी देवु। <verse eid="GEN 34:8" /><verse number="9" style="v" sid="GEN 34:9" />ने तुंद्‌रा ने हामरा पुर्‌या ने पुरे आंबा-सांबा ईयाव कर्‌या करसुन। <verse eid="GEN 34:9" /><verse number="10" style="v" sid="GEN 34:10" />हामरे चां वस जावु; ने जो देस तुंद्‌रे अगळ छे, जां रय्‌न लेण-देणु कर्‌या करु, ने जी जागा ली लेवु।”<verse eid="GEN 34:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 34:11" />सकेम बी दीनान बास ने भाय सी कह्‌यु, “कदी मारे पर तुंद्‌री दया हय, ती जो काय तुहुंं मारे सी कहु, चो मे दीस। <verse eid="GEN 34:11" /><verse number="12" style="v" sid="GEN 34:12" />तुहुंं मार सी कतरा बी कीमत ने बदलु मांगे, तेबी मे तुहुंंक कवे तीनी अनसारे आपीस, काहाकी तीनी पुरे काजे घरवाळी हवणे करीन मेसे देवु।”<verse eid="GEN 34:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 34:13" />तत्‌यार असु वीचार कर्‌यु की हामरी बहणीस दीना सात जबरान सोवसार कर्‌यु, याकुबेन पुर्‌या सकेम ने तेरु बास हमोर काजे ठगणे करीन असु जपाप देदु, <verse eid="GEN 34:13" /><verse number="14" style="v" sid="GEN 34:14" />“हामु असो काम नी कर सकजे की काहनीन फतरी नी काटाल्‌ला पुर्‌या काजे कुवारी पुरे आपजे, काहाकी हामरी नाव-बद्‌दी हवे। <verse eid="GEN 34:14" /><verse number="15" style="v" sid="GEN 34:15" />ईनी वात पर हामु तुंद्‌री मान लेसुन की हामरेन तसात तुहुंं बी आखा माणसे फतरी काटाड़्‌यु। <verse eid="GEN 34:15" /><verse number="16" style="v" sid="GEN 34:16" />तत्‌यार हामु हामरी पुरे तुंद्‌रे सी ईयाव कर देसुन, ने तुंद्‌री पुरे सी साते हामरा पुर्‌यान ईयाव करसुन, ने तुंद्‌रे भेळे ईना देस मां रवसुन बी, ने आपणु एक आखा एक जसा माणसे बण जासुन। <verse eid="GEN 34:16" /><verse number="17" style="v" sid="GEN 34:17" />बाकुन कदी तुहुंं हामरी वात नी मानीन फतरी नी काटाड़्‌यु, ती हामु हामरी पुरेक लीन जां ली आवसुन।”<verse eid="GEN 34:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 34:18" />तींद्‌री ईनी वात पर हमोर ने तेरु पुर्‌यु सकेम खुस हया। <verse eid="GEN 34:18" /><verse number="19" style="v" sid="GEN 34:19" />सकेम याकुबेन पुर्‌यान राया मानीन छाटुत तीयार हय ज्‌यु। काहाकी चु याकुबेन पुरे काजे बणावणे करीन बेसकु हर करतेलु। चु ते तेरा घराणा मां आखा सी अदु नाव वाळु मटु हतलु।<verse eid="GEN 34:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 34:20" />तेरेमां हमोर ने तेरु पुर्‌यु सकेम आपसा सहरेन फाटक धड़े जाय्‌न सहरेम रहण्‌या काजे असु समजाड़ने लाग्‌यु, <verse eid="GEN 34:20" /><verse number="21" style="v" sid="GEN 34:21" />“जे माणसे हामरे भेळे वारु रहणे चाह र्‌या, तेरेमां तीनुक ईना देस मां रय्‌न लेण-देणु करनी देय; देखु, जो देस बी तींद्‌रे वाटे रेट छे; अळतेन हामु माणसे तींद्‌रे पुरे सी ईयाव करसुन, ने हामरी पुरे तीनुक आपसुन। <verse eid="GEN 34:21" /><verse number="22" style="v" sid="GEN 34:22" />चे माणसे ईनी वात पर अतरात हामरे भेळे रहणे ने एकुत कुटुमेन माणसे बण जाणे सी खुस छे की तींद्‌रेन तसा हामरा आखा माणसे बी फतरी काटाड़ लेवु। <verse eid="GEN 34:22" /><verse number="23" style="v" sid="GEN 34:23" />आपणु तींद्‌री वात मान लेसु, ती आपणु तींद्‌रा गाडरा ने बुकड़ा, ने गावड़ी, ने बेल ने माल-धन सी मालदार हय जासुन।” <verse eid="GEN 34:23" /><verse number="24" style="v" sid="GEN 34:24" />तेरेमां जतरा तीना सहरेन फाटक सी नीकळतेला, चे आखा हमोरेन ने तेरु पुर्‌यु सकेमेन वात मान्‌या; ने आखा माणसे फतरी काटाड़्‌या, अतरा तीना सहरेन फाटक सी नीकळतेला।<verse eid="GEN 34:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 34:25" />तीसरे दाहड़े, जत्‌यार चे माणसे मादा हतला, तत्‌यार असो हयो की सीमोन ने लेवी नावेन याकुबेन दुय पुर्‌या, जु दीनान भायस हतलु, आपणी-आपणी तलवार लीन तीना सहर मां बीह्‌या नी ने भराइन आखा माणसे काजे मार नाख्‌या। <verse eid="GEN 34:25" /><verse number="26" style="v" sid="GEN 34:26" />हमोर ने तेरु पुर्‌यु सकेम काजे मार नाख्‌या, ने दीना काजे सकेमेन घर सी नीकाळीन ली ज्‌या। <verse eid="GEN 34:26" /><verse number="27" style="v" sid="GEN 34:27" />याकुबेन पुर्‌या मार नाख्‌या तेबी सहर मां भराइन असा करीन लुट्‌या की तेरेम तींद्‌री बहणीस सोवसार कर्‌यु। <verse eid="GEN 34:27" /><verse number="28" style="v" sid="GEN 34:28" />चे गाडरा-बुकड़ा, ने गावड़ी-बेल, ने गदड़ा, ने सहर ने खयड़ा मां जतरा बी माल ली लेदा। <verse eid="GEN 34:28" /><verse number="29" style="v" sid="GEN 34:29" />तीनु आखा काजे ने तींद्‌रा पुर्‌या-पारी, ने बायरा काजे बी ली जाती र्‌या, मतलब घरमा बी जो काय हतलो तीनुक बी ली जाती र्‌या।<verse eid="GEN 34:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 34:30" />अळतेन याकुब, आपसा पुर्‌या सीमोन ने लेवी काजे कह्‌यु, “तुहुंं मेसेक बेसका दुखी करला छे, काहाकी तुहुंं असा कर्‌या ने कनानी ने परीज्‌जी जातीन माणसे हंय आपणे सी भुंडा रवसे। आपणु ते बेसका कामका छे। ने चे आपणे वीरुद मां भेळा हय्‌न आवसे, ने लड़ाय करसे। ने आपणे भेळता आपणा आखा घरन्‌याक बी, खत्‌तम कर देसे।”<verse eid="GEN 34:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 34:31" />चे कह्‌या, “काय चु हामरी बहणीस भेळे रंडीन तसा वेहवार कर्‌या?”<verse eid="GEN 34:31" /></para>
  <chapter eid="GEN 34" />
  <chapter number="35" style="c" sid="GEN 35" />
  <para style="s">बेतेल मां याकुब काजे संयबरकत जड़नु</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 35:1" />थुड़ाक दाहड़ाम भगवान याकुब काजे कह्‌यु, “तु जां सी बेतेल सहर मां जाय्‌न वस जाजी। ने चां मारे वाटे एक दगड़ान वेदी बणावजी, जु तुसेक तीने टेमे सपना मां देखाव पड़लु, तीनी टेमे तु आपसा भायस एसाव्‌या सी बीहीन ढासतेलु।”<verse eid="GEN 35:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 35:2" />तत्‌यार याकुब, आपसा घरन्‌या काजे, ने जे तेरे पुठ्‌ये हतला, तीनु आखा काजे बी कह्‌यु, “तुंद्‌रे ईचमां सी आखी भातीन पारकी देव-धाणी काजे नीकाळीन नाख देवु; ने खुद काजे चुखा करु, ने आपसा पुथल्‌या बदलीन, धुवला पुथल्‌या पेहेर लेवु। <verse eid="GEN 35:2" /><verse number="3" style="v" sid="GEN 35:3" />ने चालु, आपणु जां सी बेतेल सहर भीणी जाता; चां मे तीना भगवान वाटे दगड़ान एक वेदी बणावीस, जु भगवान मारी आफत मां मारी समळीन मारी मदत करलु, ने तीने वाट्‌ये मे जातलु, तीने वाट्‌ये चु मारे पुठ्‌ये हतलु।” <verse eid="GEN 35:3" /><verse number="4" style="v" sid="GEN 35:4" />तेरेमां ततरा बी दीसरा देवतान मुरत्‌या तींद्‌रेन्‌चां हतला, तीनु मुरत्‌या काजे ने जतरा बी बायरा कान्‌टा मां भारेवला टुकर्‌या पेहेरतेला तीनु टुकर्‌या काजे, चे याकुब काजे आप देदा; ने याकुब तीनु देवतान मुरत्‌याक ने टुकर्‌या काजे सकेम सहर धड़े वाळा बांज नावेन झाड़का तळे गाड़ देदु।<verse eid="GEN 35:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 35:5" />जत्‌यार याकुब ने तेरा पुर्‌या चां सी जाणे बाजी रहला ती, तीना सहरेम वाळा तींद्‌रे पछळ पड़ने हींडतेला; बाकुन तींद्‌रा मन मां भगवानेन बीहाणो भराय ज्‌यु, ने चे तींद्‌रे पछळ नी पड़ सक्‌या। <verse eid="GEN 35:5" /><verse number="6" style="v" sid="GEN 35:6" />अळतेन याकुब, तेरा माणसे भेळे लुज नावेन सहर मां आयु। तीना सहर काजे बेतेल बी कवतेला। जो सहर कनान मुलुक मां छे। <verse eid="GEN 35:6" /><verse number="7" style="v" sid="GEN 35:7" />याकुब चां दगड़ान एक वेदी बणायु। ने तीना जागान नाव “एल बेतेल” पाड़्‌यु; काहाकी जत्‌यार चु आपसा भायस एसावेन धाके ढासीन जातलु, ती ईनेत जागे भगवान तेरे अगळ उजेंतु हवलु। <verse eid="GEN 35:7" /><verse number="8" style="v" sid="GEN 35:8" />रीबकान बाळ-पणा मां, रीबकान देख-भाळ करने वाळी दबोरा चां मर गुयली, ने बेतेल सहर मां बांज नावेन झाड़का तळे तीनी काजे गाड़्‌ला, ने तीना बांज नावेन झाड़कान नाव अल्‌लोन-बक्‌कुत पाड़्‌या।<verse eid="GEN 35:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 35:9" />जत्‌यार याकुब पद्‌दनराम सी पछु आयु ती दुसरी कावा भगवान तीनाक जागता-सपना मां देखाव पड़्‌यु, ने संयबरकत आप्‌यु। <verse eid="GEN 35:9" /><verse number="10" style="v" sid="GEN 35:10" />ने भगवान याकुब काजे कह्‌यु, “हंय लग ते तारो नाव याकुब हतलो; बाकुन हंय सी तारो नाव ‘इस्‌राएल्‌यु’ रवसे।” तसों करीन भगवान याकुबेन नवलो नाव इस्‌राएल पाड़्‌यु। <verse eid="GEN 35:10" /><verse number="11" style="v" sid="GEN 35:11" />अळतेन भगवान याकुब काजे कह्‌यु, “मे आखा सी जुर भर्‌यु भगवान छे: मे तुसेक वेल वदणेन बरकत आपो: तारु बेसकु-मटु वेल वदसे, ने तारे सी बेसका जातीन माणसे पयदा हवसे, ने तारी अवल्‌यात मां राजा पयदा हवसे। <verse eid="GEN 35:11" /><verse number="12" style="v" sid="GEN 35:12" />ने जी जागा मे तारा डाहला-बास अब्‌राहम काजे ने तारा बास इसाक काजे आपणेन वायदु करलु, चत देस मे तुसेक ने तारी आवणे वाळी अवल्‌यात काजे आपीस।” <verse eid="GEN 35:12" /><verse number="13" style="v" sid="GEN 35:13" />अळतेन याकुब साते वात करीन भगवान चां सी उपर जात र्‌यु। <verse eid="GEN 35:13" /><verse number="14" style="v" sid="GEN 35:14" />ने जीना जागा मां भगवान याकुब सी वात कर्‌यु, चां याकुब दगड़ु उबु कर्‌यु, ने अंगुरेन रस ने जेतुनेन तेल चड़ायु। <verse eid="GEN 35:14" /><verse number="15" style="v" sid="GEN 35:15" />जीना जागा पर भगवान याकुब सी वात कर्‌यु, तीना जागान नाव चु बेतेल पाड़्‌यु।<verse eid="GEN 35:15" /></para>
  <para style="s">राहेल मर गुय</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 35:16" />याकुब ने तेरा माणसे बेतेल सहर काजे छुड़ीन जात रया। ने एपराता सहरेम पुगणेन ईतरीक वार पेहलेत राहेलेन फवरी हवणेन टेम आय लागी। ने ची वेणेन दुख सी बेसकी वेला करने बाजी गुय। <verse eid="GEN 35:16" /><verse number="17" style="v" sid="GEN 35:17" />जत्‌यार ची बेसकी वेला करतेली तीने टेमे दायण तीनीक कय, “ओ राहेल, बीहे घुण; हंयन कावा बी तारु पुर्‌युत हवसे।” <verse eid="GEN 35:17" /><verse number="18" style="v" sid="GEN 35:18" />ने पखड़ाय्‌नेन टेमे राहेल मर गुय, ने मरता-मरता ची तीना पुर्‌यान नाव बेनोनी<note caller="+" style="f"><char style="fr" closed="false">35:18 </char><char style="ft" closed="false">मारा दुखेन पुर्‌यु</char></note> पाड़ी: बाकुन तीना पुर्‌यान बास याकुब, तीना पुर्‌यान नाव बीन्‌यामीन<note caller="+" style="f"><char style="fr" closed="false">35:18 </char><char style="ft" closed="false">मारा जेवड़्‌या हातेन पुर्‌यु</char></note> पाड़्‌यु।<verse eid="GEN 35:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 35:19" />तसु करीन राहेल मर गुय, ने एपराता सहरेन वाट्‌येत तीनी काजे गाड़ देदा। <verse eid="GEN 35:19" /><verse number="20" style="v" sid="GEN 35:20" />ने याकुब, राहेलेन ईज्‌जत मां तेरा बीड़ा पर एक दगड़ान खाम्‌बु उबु कर्‌यु: चु दगड़ान खाम्‌बु आज लग छे। <verse eid="GEN 35:20" /><verse number="21" style="v" sid="GEN 35:21" />अळतेन इस्‌राएल्‌यु चां सी अगु जाती र्‌यु, ने एदेर नावेन एक मीडेवरान दखणाव आपसु तम्‌बु ताण देदु।<verse eid="GEN 35:21" /></para>
  <para style="s">याकुबेन पुर्‌यु</para>
  <para style="r">(<ref loc="1CH 2:1">1 ईतीहास 2:1</ref>,<ref loc="1CH 2:2">2</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 35:22" />जत्‌यार याकुब इस्‌राएलेन तीनी मुलुक मां रहणे बाजी रहलु, ती एक दाहड़ु तेरु पुर्‌यु रुबेन राहेलेन पावरनी बील्‌हा दीनीक इस्‌राएल बणाय लेदलु, तीनी साते जबरान सोवसार करीन छीनाळो कर्‌यु,</para>
  <para style="p" vid="GEN 35:22">ने जी वात इस्‌राएल काजे मालम पड़ गुयो। ने इस्‌राएल रीसवाय गुयु। <verse eid="GEN 35:22" /><verse number="23" style="v" sid="GEN 35:23" />तेरी लाडी लीया सी जे पुर्‌या हवला: रुबेन, सीमोन, लेवी, यहुदा, ईस्‌साकार ने जबुलुन। <verse eid="GEN 35:23" /><verse number="24" style="v" sid="GEN 35:24" />तेरी लाडी राहेल सी तेरा दुय पुर्‌या हवला: युसुफ ने बीन्‌यामीन। <verse eid="GEN 35:24" /><verse number="25" style="v" sid="GEN 35:25" />ने राहेलेन पावरनी बील्‌हा सी तेरा दुय पुर्‌या हवला: दान ने नप्‌ताली। <verse eid="GEN 35:25" /><verse number="26" style="v" sid="GEN 35:26" />लीयान पावरनी जील्‌पा सी तेरा दुय पुर्‌या हवला: गाद ने आसेर पद्‌दनराम मां हया।<verse eid="GEN 35:26" /></para>
  <para style="s">इसाकेन मरनु</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 35:27" />अळतेन याकुब मम्‌रे नावेन जागान्‌चा वाळा कीरयोतोरबा सहर मां आयु। ज कीरयोतोरबा सहर, हेबरोन बी कहवाये। ईना सहर मां याकुबेन डाहलु-बास अब्‌राहम पारकु बणीन रहलु, ने हंय तेरु बास इसाक रहणे बाजी रहलु। <verse eid="GEN 35:27" /><verse number="28" style="v" sid="GEN 35:28" />इसाक एक सोव ने अस्‌सी सालेन हयु। <verse eid="GEN 35:28" /><verse number="29" style="v" sid="GEN 35:29" />ने इसाक ती मरीन सर ज्‌यु ने आपसान डाहवारो पुरो करीन आपसा पेहला माणसे मां भेसकाय ज्‌यु; ने तेरा पुर्‌या एसाव ने याकुब तीनाक वळाया।<verse eid="GEN 35:29" /></para>
  <chapter eid="GEN 35" />
  <chapter number="36" style="c" sid="GEN 36" />
  <para style="s">एसावेन अवल्‌यात</para>
  <para style="r">(<ref loc="1CH 1:34-37">1 ईतीहास 1:34-37</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 36:1" />एसाव जीनाक एदोम बी कवाये, तेरी जी अवल्‌यात छे। <verse eid="GEN 36:1" /><verse number="2" style="v" sid="GEN 36:2" />एसाव ते कनानी पुरे सी ईयाव कर्‌यु; मतलब हीत्‌ती एलोनेन पुरे आदा काजे, ने आहलीबामा काजे जे अनान पुरे ने हीव्‌वी सीबोनेन पुरे हतली।<note caller="+" style="x"><char style="xo" closed="false">36:2 </char><char style="xt" closed="false"><ref loc="GEN 26:34">उबजाणनी किताप 26:34</ref></char></note> <verse eid="GEN 36:2" /><verse number="3" style="v" sid="GEN 36:3" />अळतेन हयु इस्‌माएलेन पुरे बासमत काजे बी, जो नबायोतेन बहणीस हतली तेरे सी ईयाव करनु कर लेदु।<note caller="+" style="x"><char style="xo" closed="false">36:3 </char><char style="xt" closed="false"><ref loc="GEN 28:9">उबजाणनी किताप 28:9</ref></char></note> <verse eid="GEN 36:3" /><verse number="4" style="v" sid="GEN 36:4" />आदा सी एसाव सी एलीपज काजे, ने बासमत ने रुएल पयदा हया। <verse eid="GEN 36:4" /><verse number="5" style="v" sid="GEN 36:5" />ने आहलीबामा ने युस, ने यालाम, ने कोरह पयदा हया। एसावेन जेत पुर्‌या कनान देस मां हया।<verse eid="GEN 36:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 36:6" />तत्‌यार एसाव आपसी घरवाळीक ने पुर्‌या पारी, ने घरेन आखा जानवर्‌या, ने गाडरा बुकड़ा, ने गावड़ी बेल ने आखा पाळन्‌या जानवर्‌या, आखो माल धन काजे, जो कनान देस मां कमाय करलु, आखाक लीन आपसा भाय याकुब सी छेटु दीसरा देस मां जाती र्‌यु <verse eid="GEN 36:6" /><verse number="7" style="v" sid="GEN 36:7" />काहाकी तींद्‌रो माल धन अतरो हय गुयलो की भेळो नी कर सके, ने जानवर्‌या बी बेसका तीना देस मां हवणे सी, जीना देस मां पारका बणीन रवतेला चां समाय नी सकतेला। <verse eid="GEN 36:7" /><verse number="8" style="v" sid="GEN 36:8" />एसाव जु एदोम बी कहवाये, सेईर नावेन बयड़ा वाळा देस मां रहणे लाग्‌यु।<verse eid="GEN 36:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 36:9" />सेईर नावेन बयड़ा वाळा देस मां रहणे वाळा एदोम पेहलु माणुस एसावेन अवल्‌यात जी छे। <verse eid="GEN 36:9" /><verse number="10" style="v" sid="GEN 36:10" />एसावेन पुर्‌यान नावे जे छे; मतलब एसावेन घरवाळी आदान पुर्‌यु एलीपज, ने तीनात एसावेन घरवाळी बासमत पुर्‌यु रुएल। <verse eid="GEN 36:10" /><verse number="11" style="v" sid="GEN 36:11" />एलीपजेन जे पुर्‌या हया, मतलब तेमान, ओमर, सपो, गाताम, ने कनज। <verse eid="GEN 36:11" /><verse number="12" style="v" sid="GEN 36:12" />एसावेन पुर्‌यु एलीपजेन तीम्‌ना नावेन एक पावरनी हतली, जी एलीपज सी अमालेक पयदा हया; एसावेन घरवाळी आदा अवल्‌यात मां जेत हया। <verse eid="GEN 36:12" /><verse number="13" style="v" sid="GEN 36:13" />रुएलेन जे पुर्‌या हया: मतलब नहत, जेरह, समा ने मीज्‌जा: एसावेन घरवाळी बासमतेन अवल्‌यात जेत छे।<verse eid="GEN 36:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 36:14" />एसाव्‌यान लाडी आहलीबामान जे पुर्‌या पयदा हवला: युस, यालाम ने कोरह। जी आहलीबामा सीबोनेन पुर्‌या अनानेन पुरे हतली।<verse eid="GEN 36:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 36:15" />एसाव्‌यायेन डाहला जे हतला; मतलब एसावेन जेठु एलीपजेन अवल्‌यात मां सी तेमान, ओमर, सपो, ने कनज मुखी, <verse eid="GEN 36:15" /><verse number="16" style="v" sid="GEN 36:16" />कोरह, गाताम, अमालेक: एलीपजेन अवल्‌यात मां सी। एदोम देस मां जेत मुख्‌या रह्‌या: ने जेत आदान अवल्‌यात हया।<verse eid="GEN 36:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 36:17" />एसाव्‌यान पुर्‌या रुएल्‌यान अवल्‌यात मां पयदा हवणी जातीन मुखी जे हतला: नहत मुखी, जेरह मुखी, समा मुखी, ने मीज्‌जा मुखी। जे आखा एदोम देस मां एसाव्‌यान लाडी बासमती सी पयदा हया।<verse eid="GEN 36:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 36:18" />अनानेन पुरे एसाव्‌यान लाडी आहलीबामान अवल्‌यात मां पयदा हवणी जातीन मुखी जे हतला: युस मुखी, यालाम मुखी, कोरह मुखी। जे आखा आपसी-आपसी जातीन मुखी हतला। <verse eid="GEN 36:18" /><verse number="19" style="v" sid="GEN 36:19" />एसाव जु एदोम बी कहवाये, तेरा अवल्‌यात जेत छे, ने तींद्‌रा मुख्‌या बी जेत हया।<verse eid="GEN 36:19" /></para>
  <para style="s">सेईरेन खानदानी</para>
  <para style="r">(<ref loc="1CH 1:38-42">1 ईतीहास 1:38-42</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 36:20" />सेईर जो होरी नावेन जातीन हतला, तेरा जे पुर्‌या तीना देस मां पेहलुत सी रवतेला: लोतान, सोबाल, सीबोन, अना, <verse eid="GEN 36:20" /><verse number="21" style="v" sid="GEN 36:21" />दीसोन, एसेर, ने दीसान: एदोम देस मां, सेईर घरन्‌या होरी जातीन मुख्‌या हया।<verse eid="GEN 36:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 36:22" />लोतानेन पुर्‌या, होरी ने हेमाम हया; ने लोतानेन बहणीस तीम्‌ना हतली।<verse eid="GEN 36:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 36:23" />सोबालेन जे पुर्‌या हया: आल्‌वान, मानहात, एबाल, सपो, ने ओनाम।<verse eid="GEN 36:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 36:24" />ने सीबोनेन पुर्‌या जेत हतला: अय्‌यु, ने ओन्‌यु; ईना ओन्‌या काजे आपसा बास जीबोन्‌यान गदड़ा चारने बाजी रहलु, तीने टेमे तात्‌ला पाणीन झीरे जड़ला। <verse eid="GEN 36:24" /><verse number="25" style="v" sid="GEN 36:25" />अनान दीसोन नावेन पुर्‌या हया, ने तीनात अनानेन आहलीबामा नावेन पुरे हय। <verse eid="GEN 36:25" /><verse number="26" style="v" sid="GEN 36:26" />दीसोनने जे पुर्‌या हया: हेमदान, एसबान, यीत्‌रान, ने करान।<verse eid="GEN 36:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 36:27" />एसेरेन जे पुर्‌या हया: बील्‌हान, जाबान, ने अकान। <note caller="+" style="x"><char style="xo" closed="false">36:27 </char><char style="xt" closed="false"><ref loc="HEB 11:9">ईब्‌रानीयो 11:9</ref>; <ref loc="GEN 13:18">उबजाणनी किताप 13:18</ref></char></note><verse eid="GEN 36:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 36:28" />दीसानेन जे पुर्‌या हया: उस, ने अरान।<verse eid="GEN 36:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 36:29" />होरीयान जे मुख्‌या हया: लोतान, सोबाल, सीबोन, अना, <verse eid="GEN 36:29" /><verse number="30" style="v" sid="GEN 36:30" />दीसोन, एसेर, दीसान; सेईर देस मां होरी जातीन माणसे जेत मुख्‌या छे।<verse eid="GEN 36:30" /></para>
  <para style="s">एदोमेन राजु</para>
  <para style="r">(<ref loc="1CH 1:43-54">1 ईतीहास 1:43-54</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 36:31" />अळतेन जत्‌यार इस्‌राएली माणसे पर काहनु बी राजु राज नी कर्‌यु, तत्‌यार बी एदोमेन देस मां जेत राजा हतला; <verse eid="GEN 36:31" /><verse number="32" style="v" sid="GEN 36:32" />बोरेन पुर्‌यु बेला एदोम मां राज कर्‌यु, ने तेरी राजधानीन नाव दीन्‌हाबा छे। <verse eid="GEN 36:32" /><verse number="33" style="v" sid="GEN 36:33" />बेलान मरनेन पछेन, बोस्‌रा मां रहण्‌या जेरह पुर्‌यु योबाब तेर जागा पर राजु बण्‌यु। <verse eid="GEN 36:33" /><verse number="34" style="v" sid="GEN 36:34" />योबाब मर ज्‌यु ती तेमानी जातीन माणसेन देसेन रहण्‌या हुसाम तेर जागा पर राजु बण्‌यु। <verse eid="GEN 36:34" /><verse number="35" style="v" sid="GEN 36:35" />हुसाम मर ज्‌यु, ने अळतेन तेरा जागा पर बदद पुर्‌यु हादाद्‌यु राजा बण्‌यु। जु हदद, मीद्‌यानी जातीन माणसे काजे मोआब देस मां मार नाखलु, ने तीनुक जीत लेदलु। ईना होदाद्‌यान राजधानी अबीत सहर मां हतली। <verse eid="GEN 36:35" /><verse number="36" style="v" sid="GEN 36:36" />हदद मर ज्‌यु ती मस्‌रेन रहण्‌या सम्‌ला तेर जागा पर राजु बण्‌यु। <verse eid="GEN 36:36" /><verse number="37" style="v" sid="GEN 36:37" />अळतेन सम्‌ला मर ज्‌यु ती सावुल जु मट्‌ली नदीन धड़े वाळा रहोबोत सहरेन हतलु चु तेर जागा पर राजु बण्‌यु। <verse eid="GEN 36:37" /><verse number="38" style="v" sid="GEN 36:38" />सावुल मर ज्‌यु ती अकबोरेन पुर्‌यु बालहान तेर जागा पर राजु बण्‌यु। <verse eid="GEN 36:38" /><verse number="39" style="v" sid="GEN 36:39" />जत्‌यार अकबोरेन पुर्‌यु, बालहान मर ज्‌यु, ती तेरे जागे हदाद्‌यु राजा बण्‌यु। तेरा राजवाड़ान नाव पावु हतलो। हादार्‌म अनसारे तींद्‌रा नावे जेत छे; ने तेरी लाडीन नाव महेतबेल छे, ची मेजाहाबेन पुर्‌यान पुरेन मत्‌रेदेन पुरे हतली। <verse eid="GEN 36:39" /><verse number="40" style="v" sid="GEN 36:40" />अळतेन एसावेन घरनान मुख्‌यान घराणा, ने जागान अनसारे तींद्‌रा नाव जे छे, तीम्‌ना मुख्‌यु, अल्‌बा मुख्‌यु, यतेत मुख्‌यु, <verse eid="GEN 36:40" /><verse number="41" style="v" sid="GEN 36:41" />आहलीबामा मुख्‌यु, एला मुख्‌यु, पीनोन मुख्‌यु, <verse eid="GEN 36:41" /><verse number="42" style="v" sid="GEN 36:42" />कनज मुख्‌यु, तेमान मुख्‌यु, मीब्‌सार मुख्‌यु, <verse eid="GEN 36:42" /><verse number="43" style="v" sid="GEN 36:43" />मग्‌दीएल मुख्‌यु, ईराम मुख्‌यु ने एदोम अवल्‌यात जे आपसान देस बणाय लेदला, तीना रहणेन जागा मां तींद्‌रात मुख्‌या बण्‌या, एदोमी जातीन पेहलु माणुस एसाव छे।<verse eid="GEN 36:43" /></para>
  <chapter eid="GEN 36" />
  <chapter number="37" style="c" sid="GEN 37" />
  <para style="s">युसुफ सपना देखे</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 37:1" />याकुब ते कनान देस मां रवतेलु, जां तेरु बास पारकु बणीन रवतेलु। <verse eid="GEN 37:1" /><verse number="2" style="v" sid="GEN 37:2" />याकुबेन अवल्‌यातेन वाराम: जत्‌यार युसुफ सतरे सालेन हतलु, ती चु आपसा बासेन दीसरा बायरा बील्‌हा ने जील्‌पान पुर्‌या पुठ्‌ये रय्‌न गाडरा ने बुकड़ा चार्‌या करतेलु; ने तींद्‌री कुहराय्‌न खबर आपसा बास याकुबेन चां पुगाड़्‌या करतेलु।<verse eid="GEN 37:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 37:3" />इस्‌राएल आपसा आखा पुर्‌या अदुस युसुफ सी परम राखतेलु, काहाकी चु तेरा डाहवारान पुर्‌यु हतलु: ने चु तेर वाटे वारु रंग वाळो झगल्‌यो बणाव्‌लु। <verse eid="GEN 37:3" /><verse number="4" style="v" sid="GEN 37:4" />युसुफेन भायस देख्‌या की, हामरु बास हामरे सी कम परम करे, बाकुन युसुफ काजे वदु परम करे, ती चे युसुफ पर कुहरायणे बाजी गुया, ने तेरे साते वारुस वात बी नी करतेला।<verse eid="GEN 37:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 37:5" />युसुफ एक सपनो देख्‌यु, ने आपसा भाय काजे तेर बारामां बताड़्‌यु; तत्‌यार चे तेर सी अळी बी अदुस रीस करने बाजी ज्‌यु। <verse eid="GEN 37:5" /><verse number="6" style="v" sid="GEN 37:6" />चु तीनाक कह्‌यु, “जो सपनो देख्‌यु चो सामळ: <verse eid="GEN 37:6" /><verse number="7" style="v" sid="GEN 37:7" />आपणु आखा खेतेम पुळा बांदणे बाजी रहला, ने मारु पुळु सुदु-सट उबु हय ज्‌यु, तत्‌यार तुंद्‌रा ग्‌यारे पुळा आवीन मारा पुळाक च्‌यारे-मेर घेरवीन उबा हय ज्‌या, ने नेचा वळीन पाये पड़ने बाजी ज्‌या।”<verse eid="GEN 37:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 37:8" />तत्‌यार युसुफेन भायस, युसुफ काजे कह्‌या, “तु छाचली, हामरे पर राज करीन हक जमाड़सी काय?” ने चे सपनान ने तेरी वाते सी, वदुस तेरे पर कुहराय करने बाजी ज्‌या।<verse eid="GEN 37:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 37:9" />अळतेन हयु एक अळी सपनो देख्‌यु, ने आपसा भाय काजे चो सामळायु, “सामळ, मे एक अळी सपनो देख्‌यु, की दाहड़ु ने चांद ने ग्‌यारे तारा मारे पाये पड़े।” <verse eid="GEN 37:9" /><verse number="10" style="v" sid="GEN 37:10" />युसुफ आपसा बासेक बी ईना सपनान वाराम कह्‌यु, बाकुन तेरु बास तीनाक लड़ीन कह्‌यु, “जो असलो-कसो सपनो छे? छाचलीन मे, ने तारी आय्‌स ने तारा भायस, हामु आखा तुंद्‌रे पाये पड़सुन काय?” <verse eid="GEN 37:10" /><verse number="11" style="v" sid="GEN 37:11" />तेरा भाय तेर सी रीस करतेला, बाकुन तेरु बास तेरा बुले काजे हेर राख्‌यु।<note caller="+" style="x"><char style="xo" closed="false">37:11 </char><char style="xt" closed="false"><ref loc="ACT 7:9">नेवताळान काम 7:9</ref></char></note><verse eid="GEN 37:11" /></para>
  <para style="s">युसुफ काजे एचणे</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 37:12" />तेरा भायस आपसा बासेन गाडरा-बुकड़ा चारने करीन सकेम सहर मां गुया। <verse eid="GEN 37:12" /><verse number="13" style="v" sid="GEN 37:13" />तत्‌यार इस्‌राएल युसुफ सी कह्‌यु, “तारा भायस सकेम सहर मात गाडरा-बुकड़ा चारता हसे। तेरेमां जा, मे तुसे तींद्‌रे धड़े मकलो।”</para>
  <para style="p" vid="GEN 37:13">चु तीनुक कह्‌यु, “हव मे तीयार छे।”<verse eid="GEN 37:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 37:14" />चु तीनाक कह्‌यु, “जा तु आपणा भायस ने गाडरा बुकड़ा काजे देखीन आव की चे कसा छे, ने खबर लीन आव।”</para>
  <para style="p" vid="GEN 37:14">तेरेमां तीनाक चु हेबरोन घाटी लग मेकीन आयु, ने चु सकेम सहर मां आयु। <verse eid="GEN 37:14" /><verse number="15" style="v" sid="GEN 37:15" />ने एक माणुस तीनाक खयड़ा मां अथुन-अथु फीरतु देखाव पड़्‌यु तीनाक पुछ्‌यु, “तु काय हेरे?”<verse eid="GEN 37:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 37:16" />चु कह्‌यु, “मे मारा भायस काजे हेरो। मेसे काजे बताड़ की चे गाडरा-बुकड़ा कां चारने बाजी र्‌या?”<verse eid="GEN 37:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 37:17" />चु माणुस कह्‌यु, “चे बेसकी वारुन जां सी जाती र्‌या। ने मे तीनुक असा कवतेला सामेळ्‌ळु की, चालु आपणु दोतान सहर भीणी खयड़ा मां जाजे।” अळतेन युसुफ सकेम सहर खयड़ाम सी, दोतान सहरेन खयड़ा मां गुयु, ने आपसा भायसेक हेर लेदु। युसुफेन भायस, युसुफ काजे गुलामी कराड़ने करीन वेच देदा।<verse eid="GEN 37:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 37:18" />जसु नी चे हीनाक देख्‌या, ती तेर धड़े आवणे सी पेहेल तीनाक मार नाखणेन मुजगी कर्‌या। <verse eid="GEN 37:18" /><verse number="19" style="v" sid="GEN 37:19" />ने चे भेळा हयन कहणे लाग्‌या, “देखु, हयु सपनो देखणे वाळु आवणे बाजी र्‌यु। <verse eid="GEN 37:19" /><verse number="20" style="v" sid="GEN 37:20" />ने चालु, आपणु हीनाक मारीन काहानास खाडा मां नाख देता। ने आपणा बास काजे कय देसु की, काहनोस जंगली जानवर्‌यो तीनाक खाय गुयो हसे। अळतेन आपणु देखसु की, हेरा सपना कसा पुरा हवतेला?”<verse eid="GEN 37:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 37:21" />असु सामळीन रुबेन तीनाक तींद्‌रे हात सी बचाड़नेन वीच्‌यार सी कह्‌यु, “हामु तेरु जीवेक नी मारजे।” <verse eid="GEN 37:21" /><verse number="22" style="v" sid="GEN 37:22" />रुबेन अळी आपसा भायसेक कह्‌यु, “हीनाक घुण मारता, बाकुन बयड़ान मटला खाडा मां जीवत्‌लु नाख देजु।” रुबेन ते असु वीच्‌यार कर रहलु की, “मे हीनाक छुड़वीन बासेन चां पुगाड़ दीस।” <verse eid="GEN 37:22" /><verse number="23" style="v" sid="GEN 37:23" />तेरेमां असो हयो की जत्‌यार युसुफ आपसा भायस धड़े गुयु तत्‌यार चे तीनाक वारु रंगेन झगल्‌यो पेहरावलो हतलो तीनाक नीकाळ देदा। <verse eid="GEN 37:23" /><verse number="24" style="v" sid="GEN 37:24" />ने युसुफ काजे ली जाय्‌न खाडा मां नाख देदा, चु खाडु सुकलु हतलु ने तेरेम काय बी पाणी नी हतलो।<verse eid="GEN 37:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 37:25" />युसुफ उंड्‌ला खाडात मां हतलु, तत्‌यार तेरा भायस खाणे बस्‌या। ने चे खाता-खाता छेटेत नींगा कर्‌या, ती तीनु काजे एक वेपारीन टुळु आवतेलु देखाव पड़्‌यु। जे वेपार्‌या माणसे इस्‌माएली जातीन हतला। जे ईसमा-एल्‌यान अवल्‌यात कह्‌वाये। जे वेपारी बेसका भातीन गंदायण्‌यो तेल, बाम-मलम, ने गंदरस उटड़ा पर झेलाड़ीन गीलाद मुलुक मां सी मीसर देसेम ली जाणे बाजी रहला।<verse eid="GEN 37:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 37:26" />तत्‌यार यहुदा आपसा भायस सी कह्‌यु, “आपणा भायस काजे मारीन ने तींद्‌रो खुन ढाकणे सी काय फायदु हवसे?<note caller="+" style="x"><char style="xo" closed="false">37:26 </char><char style="xt" closed="false"><ref loc="GEN 4:10">उबजाणनी किताप 4:10</ref>; <ref loc="JOB 16:18">अय्‌युब 16:18</ref></char></note> <verse eid="GEN 37:26" /><verse number="27" style="v" sid="GEN 37:27" />आवु, आपणु हीनाक इस्‌माएलीन हाते वेच देजे, ने आपणु तीना पर हात नी लागाड़जे; काहाकी हयु आपणु भाय ने आपणात खुनेन छे।” ने चे तेरी वात सामळी लेदा। <verse eid="GEN 37:27" /><verse number="28" style="v" sid="GEN 37:28" />तत्‌यार मीद्‌यानी लेण-देण करने वाळु तींखुर आवीन तींद्‌रे धड़े आयु। तेरेमां युसुफेन भायस तीना गड्‌डा मां सी नीकाळ्‌या, ने इस्‌माएलीन माणसे काजे चांदीन वीस टका मां वेच देदा; ने चे युसुफ काजे मीसर देस मां ली ज्‌या।<note caller="+" style="x"><char style="xo" closed="false">37:28 </char><char style="xt" closed="false"><ref loc="ACT 7:9">नेवताळान काम 7:9</ref></char></note><verse eid="GEN 37:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 37:29" />रुबेन गड्‌डा पर आवीन देख्‌यु ती युसुफ गड्‌डा मां नी हतलु; तेरेमां हयु आपसान पुथल्‌या फाड़्‌यु, <verse eid="GEN 37:29" /><verse number="30" style="v" sid="GEN 37:30" />ने आपसा भाय धड़े आवीन कहणे लाग्‌यु, “पुर्‌यु ते नी हय; हंय मे कां जाम?”<verse eid="GEN 37:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 37:31" />तत्‌यार चे युसुफेन झगल्‌या काजे लेदा ने एक बुकड़ा काजे मारीन तेरा खुन मां बुळवी देदा। <verse eid="GEN 37:31" /><verse number="32" style="v" sid="GEN 37:32" />अळतेन चे, चो झगल्‌यो ली जाय्‌न आपसा बासेक देखाड़ीन कह्‌या, “हामु काजे जो झगल्‌यो जड़लो छे, चो युसुफेन झगल्‌यो छे काय?”<verse eid="GEN 37:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 37:33" />हयु तीनाक उळखी लेदु ने कह्‌यु, “हव, जो मारात पुर्‌यान झगल्‌यो छे; काहनोक जंगली जानवर्‌यो हीनाक खाय ज्‌यो; ने छाचलीन युसुफ खावाय ज्‌यु हसे।” <verse eid="GEN 37:33" /><verse number="34" style="v" sid="GEN 37:34" />तत्‌यार याकुब आपसान पुथल्‌या फाड़्‌यु ने कमर मां टाटड़ो एळट्‌यु, ने आपसा पुर्‌या वाटे बेसका दाहड़ा लग रड़तु रह्‌यु। <verse eid="GEN 37:34" /><verse number="35" style="v" sid="GEN 37:35" />ने याकुबेन पुर्‌या बेसका दाहड़ा लग तीनाक हुगु राखणे कर्‌या; बाकुन चु हुगु नी रह्‌यु; ने चु असुत कवतु रह्‌यु, “मे ते मारा पुर्‌यान फीकुर मां मरता लग रड़तु कलेपतु रय्‌स।” करीन युसुफेन बास रड़तुत रह्‌यु।<verse eid="GEN 37:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 37:36" />ने मीद्‌या माणसे युसुफ काजे मीसर देस ली जाय्‌न पोतीपर नावेन फीरोनेन एक आफसर ने कीलान राखवाळी करन्‌यान हाते वेच देदा।<verse eid="GEN 37:36" /></para>
  <chapter eid="GEN 37" />
  <chapter number="38" style="c" sid="GEN 38" />
  <para style="s">यहुदा ने तामार</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 38:1" />तीनुत दाहड़ा मां असो हयो की यहुदा आपसा भायस धड़े सी जाती र्‌यु, ने हीरा नावेन एक अदुल्‌लाम मां रहण्‌या माणसे धड़े रह्‌या। <verse eid="GEN 38:1" /><verse number="2" style="v" sid="GEN 38:2" />चां यहुदा ने सुआ नावेन एक कनानी माणसेन पुरे काजे देख्‌यु; ने तीनी सी ईयाव करीन तेर धड़े गुयु। <verse eid="GEN 38:2" /><verse number="3" style="v" sid="GEN 38:3" />ची भार पाये हय, ने तेरु एक पुर्‌यु हयु; ने यहुदा तेरो नाव एर पाड़्‌यु। <verse eid="GEN 38:3" /><verse number="4" style="v" sid="GEN 38:4" />ची अळी भार पाये हय ने अळी एक पुर्‌यु हयु, ने ची तेरो नाव ओनान पाड़ी। <verse eid="GEN 38:4" /><verse number="5" style="v" sid="GEN 38:5" />अळतेन ची यहुदा सी अळी भार पाये हय, ने तेरु एक अळी पुर्‌यु हयु, ने तेरो नाव ची सेला पाड़ी: ने दीने टेमे चु पुर्‌यु हवलु तीने टेमे यहुदा कबीज नावेन जागा मां रवतेलु। <verse eid="GEN 38:5" /><verse number="6" style="v" sid="GEN 38:6" />यहुदा ने तामार नावेन एक पुरे सी आपसा मटला पुर्‌या एरेन ईयाव कराड़ देदा।<verse eid="GEN 38:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 38:7" />बाकुन यहुदान चु मट्‌लु पुर्‌यु एर यहोवा भगवानेन नीगा मां वारु नी हतलु, तेरेमां यहोवा भगवान तीनाक मार नाख्‌यु। <verse eid="GEN 38:7" /><verse number="8" style="v" sid="GEN 38:8" />तत्‌यार यहुदा ओनान सी कह्‌यु, “तारी भुजाइस धड़े जा, ने तेर साते देवरुसेन धरमेन काम पुरो करीन आपणा भायस वाटे अवल्‌यात बणाव।” <verse eid="GEN 38:8" /><verse number="9" style="v" sid="GEN 38:9" />ओनान वीच्‌यार कर्‌यु की, ईनी बायरीन साहरे जी अवल्‌यात हवसे, ची मारी अवल्‌यात नी कह्‌वाये, ने चु तीनी बायर साते जत्‌यार बी सोवसार करतेलु, तत्‌यार चु सोवसार करनेन टेमे जो पाणी पड़तेलो, तीना पाणी काजे भुयमां नाखीन रद कर देतलु। <verse eid="GEN 38:9" /><verse number="10" style="v" sid="GEN 38:10" />ज काम जु कर्‌यु तेर सी यहोवा भगवान खुस नी हयु; ने हयु तीनाक बी मार नाख्‌यु। <verse eid="GEN 38:10" /><verse number="11" style="v" sid="GEN 38:11" />यहुदा असु वीच्‌यार कर्‌यु की, मारो असो बीयहाणो छे: कांखुर माय्‌न यहोवा भगवान जसु सेलान भायसेन जीव ली लेदलु, तसुत सेलान बी जीव ली लेसे। तेरेमां यहुदा आपसी उहड़ीस तामार काजे कह्‌यु, “जा, तारा बासेन घर जात रव ने मारा पुर्‌या सेला काजे मटु हवता लग, तारा बासेन घर रांडायली रवजी।” ने तामार आपसे मायके जात रय।<verse eid="GEN 38:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 38:12" />अळतेन थुड़ाक दाहड़ा मां यहुदान लाडी मर गुय। जी सुआन पुरे हतली। यहुदा रड़ने-कलेपणेन दाहड़ा पुरा कर लेदु ने अळतेन चु, अदुल्‌लाम सहर मां रहण्‌या आपसा दुस्‌तीदार हीरा पुठी आपसा गाडरान कान्‌या काटाड़ने करीन तीमनाथ सहर मां गुयु। <verse eid="GEN 38:12" /><verse number="13" style="v" sid="GEN 38:13" />ने तामार काजे असी खबर जड़ी की, “तारु सेसरुस आपणा गाडरा-बुकड़ान कान्‌या काटाड़ने करीन तीमनाथ जाय र्‌यु।” <verse eid="GEN 38:13" /><verse number="14" style="v" sid="GEN 38:14" />ती ची मन मां वीच्‌यार कर लेदी की, “सेला जुवान ते हय गुयु, बाकुन हंय लग मे तेरी बायर नी बणी।” ने ची, जे रांडायलीन पुथल्‌या पेहेरी रहली, चे पुथल्‌या नीकाळ देदी। ने रंडीन पुथल्‌या पेहेरी लेदी, ने घुमतु करीन, एनेम सहरेन झपला धड़े तीमनाथ सहर जाणेन वाट्‌ये जाय्‌न बस गुय।<verse eid="GEN 38:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 38:15" />जत्‌यार यहुदा तीनी काजे देख्‌यु, ती चु तीनीक रंडी समज्‌यु; काहाकी ची आपसीन मुंहड़ो ढाकी रहली। <verse eid="GEN 38:15" /><verse number="16" style="v" sid="GEN 38:16" />ने यहुदा काजे मालोम नी हतलो की, ची तेरी उहड़ीस छे। तेरेमां यहुदा तेरेन्‌चां जाय्‌न तीनीक कह्‌यु, “मेसेक तारे साते सोवसार करने दे।”</para>
  <para style="p" vid="GEN 38:16">ची बायर कय, “मे तुसेक मारे साते सोवसार करने दीस ती तु मेसेक काय आपसी?”<verse eid="GEN 38:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 38:17" />यहुदा जपाप आप्‌यु, “मे बुकड़ाम सी एक बुकड़ी पाठड़ी आपीस।” ची बायर कय, “मे ईनी वात काजे मान लम की, तु मेसेक पाठड़ी बुकड़ी आपसी।” बाकुन जत्‌यार लग तु मारे वाटे पाठड़ी बुकड़ी नी लावे,</para>
  <para style="p" vid="GEN 38:17">“ती लग सांयन हीसाबे मेसेक कांहीन आपी जा।”<verse eid="GEN 38:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 38:18" />यहुदा तीनीक कह्‌यु, “मे बुकड़ो नी दी मकलो ती लग तारेन्‌चां सांयन हीसाबे काय मेल जाम?”</para>
  <para style="p" vid="GEN 38:18">ची बायर कय, “मेसेक तारा नावेन सीलठप्‌पु ने चापड़ा बांदणाय दुरी ने तारा हातेम वाळी लाकड़ी आप दे।” ने यहुदा तीनीक जो मांगी चो आप देदु, ने तीनी बायर साते सोवसार कर्‌यु, ने ची भार पाये हय गुय। <verse eid="GEN 38:18" /><verse number="19" style="v" sid="GEN 38:19" />तत्‌यार ची उठीन जाती रय, ने आपसीन घुमतु छेटे करीन रांडायलीन पुथल्‌या अळी पेहरी लेदी।<verse eid="GEN 38:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 38:20" />यहुदा, तीनी बायर काजे बुकड़ी आपणेन वायदु करलु, तीना वायदान अनसारे चु आपसी रकम छुड़ावणे करीन अदुल्‌लाम सहर मां रहण्‌या आपसा दुस्‌तीदार हीरान हाते तीनी बायर काजे एक बुकड़ी गीदल्‌यो आपणे करीन ली मकल्‌यु। बाकुन तीना हीरा काजे ची बायर चां नी जड़ी। <verse eid="GEN 38:20" /><verse number="21" style="v" sid="GEN 38:21" />तत्‌यार चु चांहान माणसे सी पुछ्‌यु, “हयी रंडी जी एनेमेन वाट्‌ये भीणी फीरीन बठी रहली, ची कां छे?”</para>
  <para style="p" vid="GEN 38:21">चे कह्‌या, “जां ते कुय रंडी नी हतली।”<verse eid="GEN 38:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 38:22" />तेरेमां हयु यहुदा धड़े जाय्‌न कह्‌यु, “मेसे ची नी जड़ी; ने तीना जागान माणसे कह्‌या, जां ते काहनी बी रंडी नी हतली।”<verse eid="GEN 38:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 38:23" />तत्‌यार यहुदा कह्‌यु, “वारु, ती मारो रकम हेरेन चां रहणी दे, नी ते आपणु काजे माणसे फालतु समजसे; देख, मे बुकड़ीन गीदल्‌यो जां मकली देदलु, बाकुन चो तुसे नी जड़्‌यो।”<verse eid="GEN 38:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 38:24" />तीन महना हय जां ने अळतेन काहनुस जी खबर लायु की, “तारी उहड़ीस तामार छीनाळो करली छे; ने ची भार पाये हय रय।”</para>
  <para style="p" vid="GEN 38:24">तत्‌यार यहुदा कह्‌यु, “तीनीक जीवतेली धपाड़ने करीन खयड़े ली आवु।”<verse eid="GEN 38:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 38:25" />जत्‌यार तीनीक खयड़े नीकाळ्‌ने बाजी रहला, ती ची कय, “जाय्‌न, मारा सेसराक असा कय देवु की, जीना अदमीन जी रकम छे, तीना अदमी सीत मे भार पाये हवली छे।” ने ची तामार नावेन सीलठप्‌पु ने दुरी ने लाकड़ी देखाड़ीन कय, “ईनी रकम काजे ते देखु! जी रकम कुणीन छे? जु सीलठप्‌पु, ने दुरी कुणीन छे? ने जी लाकड़ी कुणीन छे?”<verse eid="GEN 38:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 38:26" />यहुदा तीनुक उळखीन कह्‌यु, “हयु ते मारे सी कमुस गुनेगार छे; काहाकी मे तेरु आपणा पुर्‌या सेला सी ईयाव नी कर्‌यु।” ने हयु तेर भेळे कदी नी सुयु।<verse eid="GEN 38:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 38:27" />जत्‌यार तेरो फवरी हवणेन टेम आय, तत्‌यार असो मालम पड़्‌यो की तेरा पेट मां जवळ्‌या पुर्‌या छे। <verse eid="GEN 38:27" /><verse number="28" style="v" sid="GEN 38:28" />ने जत्‌यार ची पखड़ायणे बाजी गुय, ती एक पुर्‌यान हात बाहरु आयु ने सयाणी तीनान हाते रातलु दुरु बांद देदी, ने कय, “पेहले जत पुर्‌यो पयदा हवलो छे।” <verse eid="GEN 38:28" /><verse number="29" style="v" sid="GEN 38:29" />जत्‌यार हयु हात सेमटी लेदु, तत्‌यार तेरु भाय पयदा हयु। ती ची पावरनी कय, “तु काहा असलुत नीकळी आयु?” तेरेमां तेरो नाव पेरेस<note caller="+" style="f"><char style="fr" closed="false">38:29 </char><char style="ft" closed="false">नीकळनेन वाट</char></note> पाड़्‌यु। <verse eid="GEN 38:29" /><verse number="30" style="v" sid="GEN 38:30" />अळतेन तेरु भायस जेरे हाते रातलु सुत बांदलु हतलु चु पयदा हयु, ने तेरो नाव जेरह पाड़्‌या।<verse eid="GEN 38:30" /></para>
  <chapter eid="GEN 38" />
  <chapter number="39" style="c" sid="GEN 39" />
  <para style="s">युसुफ ने पोतीपरेन बायर</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 39:1" />जत्‌यार युसुफ मीसर देस मां आयु, तत्‌यार पोतीपर नावेन एक मीसर देसेन जु फीरोनेन आफसर ने कीलान राखवाळ्‌यु हतला, तीनाक इस्‌माएली हाते सी जे हीनाक चां ली गुयला ने मुल ली लेदला। <verse eid="GEN 39:1" /><verse number="2" style="v" sid="GEN 39:2" />युसुफ आपसा मीसर देस वाळा मालीकेन घर मां रवतेलु। ने यहोवा तेरे साते रवतेलु तेरेमां फायदा वाळु माणुस बण ज्‌यु,<note caller="+" style="x"><char style="xo" closed="false">39:2 </char><char style="xt" closed="false"><ref loc="ACT 7:9">नेवताळान काम 7:9</ref></char></note> <verse eid="GEN 39:2" /><verse number="3" style="v" sid="GEN 39:3" />ने युसुफेन मालीक देख्‌यु की यहोवा तेर भले रहे, ने जो काम हयु करे तीनाक यहोवा तेरा हात सी फायदु कर देय।<note caller="+" style="x"><char style="xo" closed="false">39:3 </char><char style="xt" closed="false"><ref loc="ACT 7:9">नेवताळान काम 7:9</ref></char></note> <verse eid="GEN 39:3" /><verse number="4" style="v" sid="GEN 39:4" />पोतीपर तीने दाहड़े सी युसुफ काजे आपसा घरेन हकदार्‌यु बणायु, तीने दाहड़े सी यहोवा भगवान पतीपोर्‌यान घरमां ने खेते मां संयबरकत आपणे बाजी ज्‌यु। <verse eid="GEN 39:4" /><verse number="5" style="v" sid="GEN 39:5" />पतीपर तीने दाहड़े सी युसुफ काजे आपसा घरेन हकदार्‌यु बणायु, तीने दाहड़े सी यहोवा भगवान पतीपोर्‌यान घरमां ने खेते मां संयबरकत आपणे बाज-ज्‌यु। <verse eid="GEN 39:5" /><verse number="6" style="v" sid="GEN 39:6" />तेरेमां पोतीपुर्‌यु घरेन आखी रकम युसुफेन सुपरुत कर देदु। पतीपोर्‌यु आपसी काहनी बी रकमेन फीकुर नी करतेलु। बाकुन चु खाणो खाणेन अतरीत फीकुर करतेलु।</para>
  <para style="p" vid="GEN 39:6">युसुफ पतीपोर्‌यान घरवाळी साते सोवसार करने सी मना करे युसुफ बेसकु वारु ने बेसकु घाटाळु हतलु। <verse eid="GEN 39:6" /><verse number="7" style="v" sid="GEN 39:7" />ईनु वातेन पछे हयो की तेरा मालीकेन घरवाळी युसुफ भीणी देखी ने कय, “मार भेळे सुव।” <verse eid="GEN 39:7" /><verse number="8" style="v" sid="GEN 39:8" />बाकुन युसुफ नीकारु करतु जाय्‌न आपसी मालीकेन काजे कह्‌यु, “सामळ जतरी बी रकम ईना घरमां छे। तेरे वाराम मालीक काजे काय बी मालम नी हय, ने मालीक आखो काय मारे सुपरुत कर देदलु छे। <verse eid="GEN 39:8" /><verse number="9" style="v" sid="GEN 39:9" />ने ईना घर मां, मारु मालीक, आखी रकम पर मेसेक हक आपलु छे, बाकुन तार पर मारु काय बी हक नी हय; तेरेमां मे तारे साते सोवसार करीन, यहोवा भगवानेन नींगा मां पाप नी करों।” <verse eid="GEN 39:9" /><verse number="10" style="v" sid="GEN 39:10" />ने असो हयो की ची दाहड़ीन युसुफ सी वात करती रय, बाकुन हयु नी गुयु ने तेरी वात नी मान्‌यु की तेर भेळे सुवे ने भेळे रहे।<verse eid="GEN 39:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 39:11" />एक दाहड़े असो हयो की युसुफ आपसान काम करने घरमां गुयु, ने घरेन पावर्‌या मां सी कुय बी नी हतलो। <verse eid="GEN 39:11" /><verse number="12" style="v" sid="GEN 39:12" />तत्‌यार ची तेरा पुथल्‌या धरीन कय, “मार भेळे सुव,” बाकुन चु आपसान पुथल्‌या तेर हातेम छुड़ीन ढास्‌यु ने बाहर नीकळ्‌यु ज्‌यु। <verse eid="GEN 39:12" /><verse number="13" style="v" sid="GEN 39:13" />ती ची वीच्‌यार करी की युसुफ ते आपसान पुथल्‌या मार हात मां छुड़ीन बाहर ढासी ज्‌यु, <verse eid="GEN 39:13" /><verse number="14" style="v" sid="GEN 39:14" />ती ची बायरी घरेन पावर्‌याक आयड़ीन कय, “देखु, मारु घरवाळु, ईना ईब्‌री जातीन माणुस काजे हामरा घरमां हामरी ईज्‌जत हळकी करने करीन लावलु। हयु ईब्‌री जातीन माणुस मारे साते सोवसार करनेन वीच्‌यार सी मांही घरमां आवलु, बाकुन मे जुर सी आयड़ी। <verse eid="GEN 39:14" /><verse number="15" style="v" sid="GEN 39:15" />ने मे जुर सी आयड़ी ती सामळीन चु आपसान पुथल्‌या छुड़ीन मार धड़े सी ढास्‌यु, ने बाहर नीकळी गुयु।”<verse eid="GEN 39:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 39:16" />ने ची तेरा पुथल्‌या तीनान घरवाळा काजे घर पुगणे लग आपसी धड़े मेक रहली। <verse eid="GEN 39:16" /><verse number="17" style="v" sid="GEN 39:17" />ने जत्‌यार तेरु घरवाळु आयु ती ची तीनाक जी वात कय, “चु ईब्‌री जातीन पावर तीनाक तु लावलु, चु मारे साते सोवसार करने करीन मारेन्‌चां आवलु। <verse eid="GEN 39:17" /><verse number="18" style="v" sid="GEN 39:18" />ने जत्‌यार मे जुर सी आयड़ी, तत्‌यार चु आपसान पुथल्‌या मार धड़े रहणीदीन ढास गुयु।”<verse eid="GEN 39:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 39:19" />युसुफेन मालीक आपसी घरवाळीन वात सामळीन बेसकु रीसवाय गुयु। <verse eid="GEN 39:19" /><verse number="20" style="v" sid="GEN 39:20" />ने युसुफेन मालीक तीनाक धरीन जेल मां जां राजान केदी जेल मां हतला, चां कुंड देदा; ने चु तीना जेल मां कुंडायलु रयु। <verse eid="GEN 39:20" /><verse number="21" style="v" sid="GEN 39:21" />बाकुन यहोवा भगवान युसुफ भेळु हतलु ने चु युसुफ पर गीण-दया कर्‌यु ने तेरेमां सीपायाड़ान डाहलु हदार्‌यु युसुफ पर गीण-दया कर्‌यु।<note caller="+" style="x"><char style="xo" closed="false">39:21 </char><char style="xt" closed="false"><ref loc="ACT 7:9">नेवताळान काम 7:9</ref></char></note> <verse eid="GEN 39:21" /><verse number="22" style="v" sid="GEN 39:22" />अळतेन सीपायड़ान डाहलु, युसुफ काजे केदड़ान मुखी बणाय देदु, ने चे केदड़ा, युसुफ काजे कह्‌या मां आखो काम करतेला। <verse eid="GEN 39:22" /><verse number="23" style="v" sid="GEN 39:23" />सीपायड़ान डाहलु, युसुफ काजे, तीने दाहड़े सी केदड़ान डाहलु बणायु, ने तीने दाहड़े सी सीपायड़ान डाहलु जेलेन काहनी बी चीजेन देख-भाळ नी करतेलु; काहाकी आखो काम युसुफ कर लेतलु। यहोवा भगवान युसुफ साते हतलु, ने युसुफ जो बी करे तेरे मां चु संयबरकत आपतेलु।<verse eid="GEN 39:23" /></para>
  <chapter eid="GEN 39" />
  <chapter number="40" style="c" sid="GEN 40" />
  <para style="s">युसुफेन साहरे सपनान मतलब देखाड़नु</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 40:1" />थुड़ाक दाहड़ा वीत ज्‌या ने अळतेन मीसर देसेन राजान दुय मुखी पावर्‌या काहींग गुनु कर्‌या। तीनु माय्‌न एक जणु खाणो रांदण्‌यान मुखी हतलु, ने एक जणु अंगुरेन रस पावण्‌यु मुखी हतलु। <verse eid="GEN 40:1" /><verse number="2" style="v" sid="GEN 40:2" />अळतेन फीरोन राजु, तीना रांदण्‌यान मुखी पर ने अंगुरेन रस पावण्‌या मुखी पर रीसवाय ज्‌यु। <verse eid="GEN 40:2" /><verse number="3" style="v" sid="GEN 40:3" />जीनी जेल मां युसुफ हतलु, तीनीत जेल मां राजा तीनु दुयु काजे कुंडाड़ देदु। ने राजान राखवाळ्‌या-सीपायड़ान मुखी पोतीपर बी तीनी जेलेन हकदार्‌यु हतलु। <verse eid="GEN 40:3" /><verse number="4" style="v" sid="GEN 40:4" />सीपायड़ान मुखी पोतीपर तीनु दुय केदड़ा काजे युसुफेन सुपरुत कर देदु, चु चाकरी करनु चालु कर देदु अळतेन चे बेसका दाहड़ा लग जेल मां रह्‌या।<verse eid="GEN 40:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 40:5" />मीसर देसेन राजा काजे अंगुरेन रस पावण्‌यान मुखी, ने रांदण्‌यान मुखी जे दुयु जेल मां हतला, ती एक दाहड़ु राती दुयु जणा सपनो देख्‌या, ने तीनु सपनान आंग्‌ये-आंग्‌ये मतलब हतलो। ने चो सपनो हींद्‌रे पर जो हवणे वाळो हतलो, तेरेत अनसारे हतलो। <verse eid="GEN 40:5" /><verse number="6" style="v" sid="GEN 40:6" />युसुफ संदारे एगुत तींद्‌रेन्‌चां गुयु, ती चु तीनुक बेसका फीकुर मां पड़ रहला देख्‌यु। <verse eid="GEN 40:6" /><verse number="7" style="v" sid="GEN 40:7" />ने फीरोन तीनुक पुछ्‌यु, “तुहुंं आज काहा फीकुर मां पड़ रह्‌या?”<verse eid="GEN 40:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 40:8" />चे जपाप आप्‌या, “हामु दुयु जणा सपनो देखला छे, ने तीनु सपनान मतलब देखाड़न्‌यु कुय नी हय।”</para>
  <para style="p" vid="GEN 40:8">युसुफ तीनुक कह्‌यु, “सपनान मतलब देखाड़न्‌यु यहोवा भगवान अतरुत छे। तुहुंं कसो सपनो देखला, चो मेसेक कहु।”<verse eid="GEN 40:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 40:9" />अंगुरेन रस पावण्‌या मुखी आपसो सपनो कह्‌यु, “मे सपना मां अंगुरेन वेलु देखलु। <verse eid="GEN 40:9" /><verse number="10" style="v" sid="GEN 40:10" />तीना वेला मां तीन डाळ्‌या हतला, ने तीनु डाळ्‌या मे डीरा फुट्‌या, ने चे डाळ्‌या मां फुले आया ने अंगुरेन घुमचा लाग्‌या ने घुमचा पाक गुया। <verse eid="GEN 40:10" /><verse number="11" style="v" sid="GEN 40:11" />राजा फीरोनेन पीयालु मारा हातेम हतलु, ने मे तीना अंगुरेन घुमचा काजे फीरोन राजान पीयाला मां चीबदीन नीफळ्‌यु, ने पीयालु राजा काजे आप देदु।”<verse eid="GEN 40:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 40:12" />युसुफ, तीना अंगुरेन रस पावण्‌या काजे कह्‌यु, “तीन वेलान मतलब तीन दाहड़ा छे। <verse eid="GEN 40:12" /><verse number="13" style="v" sid="GEN 40:13" />तेरेमां तीन दाहड़ा हय जासे, ने अळतेन फीरोन राजु तुसेक माप कर देसे, ने तु पेहलेन तसु राजा काजे अंगुरेन रस, पीयाला आप्‌या करसे। <verse eid="GEN 40:13" /><verse number="14" style="v" sid="GEN 40:14" />जत्‌यार तु जेलेम सी छुट जाय, ती मेसेक हेर करजी, ने मारे पर गीण-दया करीन मारे बारामां फीरोन राजा काजे कवजी, ने ईना जेलेम सी मेसेक छुड़ाय लेजी। <verse eid="GEN 40:14" /><verse number="15" style="v" sid="GEN 40:15" />काहाकी छाचलीन चे मेसेक ईब्‌री जातीन देसेम सी चुराये ली आवला छे, ने मे काय बी गुनु नी कर्‌यु, तेबी असलुत जेल मां बुजाय जाम।”<verse eid="GEN 40:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 40:16" />ज देखीन तेरा सपनान मतलब वारु हतला करीन रांदण्‌यान मुखी, युसुफ काजे कह्‌यु, “मे बी सपनो देखलु छे। चो सपनो असो हतलो: मार मुणका पर रुटान तीन मसका हतला। <verse eid="GEN 40:16" /><verse number="17" style="v" sid="GEN 40:17" />आखान उपेरली मसकी मां फीरोन राजा वाटे छेल-भात्‌यो रांदलो खाणो हतलो। बाकुन तीना खाणा काजे चिरला खाणे बाजी रवला।”<verse eid="GEN 40:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 40:18" />युसुफ जपाप आप्‌यु, “तीन मसक्‌यान मतलब: तीन दाहड़ा छे। <verse eid="GEN 40:18" /><verse number="19" style="v" sid="GEN 40:19" />ने तीन दाहड़ा मां फीरोन तुसेक बी जेल मां सी नीकाळ देसे, बाकुन तारो मुणको काटाड़ देसे, ने तारा धड़ काजे एक झाड़का पर टांगाड़ देसे, ने चिरला तारा धड़ काजे खासे।”<verse eid="GEN 40:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 40:20" />तीन दाहड़ा हय ज्‌या, ने अळतेन फीरोन राजान पयदावारीन तीहवारेन दाहड़ु आयु। तीना तीहवार मां फीरोन राजु आखा पावर्‌या काजे पंगतेन खाणो खाणे बुलायु। ने रांदण्‌यान मुखी काजे ने अंगुरेन रस पावण्‌यान मुखी काजे बी जेलेम सी नीकाळ मांग्‌यु। <verse eid="GEN 40:20" /><verse number="21" style="v" sid="GEN 40:21" />राजा फीरोन, अंगुरेन रस पावण्‌यान मुखी काजे पछु नकरी पर लागाड़ लेदु, ने चु फीरोन राजा काजे पछु अंगुरेन रस पीयालु आपणे बाजी गुयु। <verse eid="GEN 40:21" /><verse number="22" style="v" sid="GEN 40:22" />बाकुन फीरोन राजा, रांदण्‌यान मुखी काजे मुणको तुड़ायन माराड़ नाख्‌यु। जसु युसुफ तीनाक सपनान मतलब देखाड़लु तसोत हयो। <verse eid="GEN 40:22" /><verse number="23" style="v" sid="GEN 40:23" />तेबी अंगुरेन रस पावण्‌यान मुख्‌यु युसुफ काजे वीसरी गुयु। ने तीनाक हेर नी कर्‌यु।<verse eid="GEN 40:23" /></para>
  <chapter eid="GEN 40" />
  <chapter number="41" style="c" sid="GEN 41" />
  <para style="s">युसुफेन साहरे फीरोन राजान सपनो बताड़नु</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 41:1" />दुय साल वीत गुया ने अळतेन फीरोन राजु एक सपनो देख्‌यु, चो सपनो असो हतलो: राजु नीळ नदी धड़े उबु हय रहलु। <verse eid="GEN 41:1" /><verse number="2" style="v" sid="GEN 41:2" />ने तीनी नीळ नदी मां सी सात वारु बेसका वारु ने मातालीस गावड़्‌या नीकळ्‌या ने नदी धड़े चरने बाजी गुया। <verse eid="GEN 41:2" /><verse number="3" style="v" sid="GEN 41:3" />अळतेन तींद्‌रे पछळ सात कुड़ायला ने हाड़कायला गावड़्‌या नीळ नदी मां सी नीकळीन आया, ने मातला गावड़्‌या धड़े आवीन उबा हय ज्‌या। <verse eid="GEN 41:3" /><verse number="4" style="v" sid="GEN 41:4" />अळतेन चे सात कुड़ायला ने हाड़कायला गावड़ी, तीनु सात बेसका वारु ने मातला गावड़्‌या काजे खाय ज्‌या। ने ततरा मां फीरोन राजान नींद उघड़ी गुय। <verse eid="GEN 41:4" /><verse number="5" style="v" sid="GEN 41:5" />अळतेन राजु पछु सुय गुयु, ने दीसरो एक अळी सपनो देख्‌यु की, एक टटाळा मां, वारु पेड्‌ला दाणा भर सात उमब्‌या नीकळ्‌या। <verse eid="GEN 41:5" /><verse number="6" style="v" sid="GEN 41:6" />अळतेन तीनात टटाळा मां अळी सात पातेळ्‌ळा ने उगेण्‌ली झाल सी झळ्‌ळायला उमब्‌या नीकळ्‌या। <verse eid="GEN 41:6" /><verse number="7" style="v" sid="GEN 41:7" />जे सात पातेळ्‌ळा उमब्‌या, सांत वारु पेड्‌ला दाणा भरला उमब्‌या काजे गीळ गुया। अळतेन फीरोन राजु जाग गुयु। ती चु वीच्‌यार्‌यु की, ए! जो ते सपनो हतलो। <verse eid="GEN 41:7" /><verse number="8" style="v" sid="GEN 41:8" />संदारे एगुत, फीरोन राजु असो सपनो काहा देखाड़्‌यो हसे करीन फीकुर मां पड़ गुयु, ने चु, मीसर देसेन आखा कागळ पांड्‌या काजे, ने मंडळीन सहलाणी देखण्‌या काजे बुलायु, ने आपसा सपना सामळायु, बाकुन तीनु माय्‌न कुय बी तीनु सपनान मतलब नी देखाड़ सक्‌यो।<note caller="+" style="x"><char style="xo" closed="false">41:8 </char><char style="xt" closed="false"><ref loc="DAN 2:2">दानीयल 2:2</ref></char></note><verse eid="GEN 41:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 41:9" />तत्‌यार अंगुरेन रस पावण्‌यु मुखी फीरोन राजा काजे कह्‌यु, “हंय, मेसेक एक वात हेर आय रय, जी वात तुसेक पेहलुत कहणु हतलो। बाकुन ईस्‌राय गुयलो, हयु मारु गुनु छे। <verse eid="GEN 41:9" /><verse number="10" style="v" sid="GEN 41:10" />ए फीरोन राजा, एक दाहड़ु, जत्‌यार तु रीसवाय आवलु, ती मेसेक ने रांदण्‌यान मुख्‌या काजे धराड़ीन पोतीपरेन घरेन धड़े वाळी जेल मां कुंडाड़ देदलु। <verse eid="GEN 41:10" /><verse number="11" style="v" sid="GEN 41:11" />तत्‌यार एकुत राती हामु दुयु जणा सपनो देखला, ने हामरे साते जसो हवणे वाळो हतलो, तसोन-तसों हामरो सपनो बी हतलो। <verse eid="GEN 41:11" /><verse number="12" style="v" sid="GEN 41:12" />तीने टेमे जेल मां हामरे पुठ्‌ये एक ईब्‌री जातीन जुवान माणुस हतलु, जु जेलेन राखवाळ्‌या-सीपायड़ान मुखीन गुलाम-पावर हतलु; ने हामु तीना जुवान्‌या काजे हामरो सपनो देखाड़ला, ने चु हामरा एकेक सपनान मतलब देखाड़ देदलु। <verse eid="GEN 41:12" /><verse number="13" style="v" sid="GEN 41:13" />ने चु हामु काजे जसु देखाड़लु तसोत हामरे साते वीत्‌यो: तु मेसेक ते नकरी पर पछु लागाड़ लेदलु, बाकुन खावाड़नी मुखी काजे टांगाड़ीन माराय नाख्‌यु।”<verse eid="GEN 41:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 41:14" />अळतेन फीरोन राजु, युसुफ काजे बुलाय मांग्‌यु, ने सीपायड़ा युसुफ काजे तळ-घर वाळा जेल मां सी छाटुत नीकाळ लाया, ने युसुफ कान्‌या काटाड़्‌यु, ने तेरा पुथल्‌या बदलीन फीरोन राजा अगळ आयु। <verse eid="GEN 41:14" /><verse number="15" style="v" sid="GEN 41:15" />फीरोन राजु, युसुफ काजे कह्‌यु, “मे एक दाहड़ु सपना देखलु छे, तीनु सपनान मतलब देखाड़न्‌या कुय नी हय। ने मे तारे बारामां सामेळ्‌ळु छे की, तु सपनो सामेळतात तीना सपनान मतलब देखाड़ सके।”<verse eid="GEN 41:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 41:16" />युसुफ फीरोन राजा काजे कह्‌यु, “मे, नी, बाकुन भगवानुत सपनान छाचो मतलब देखाड़ सके।”<verse eid="GEN 41:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 41:17" />फीरोन राजु युसुफ काजे कह्‌यु, “मे सपना मां नीळ नदी धड़े उबु हय रहलु। <verse eid="GEN 41:17" /><verse number="18" style="v" sid="GEN 41:18" />ती सात बेसका वारु ने मातालीस गावड़ी काजे नदी मां सी नीकळीन नदी धड़े चरतेला देखलु। <verse eid="GEN 41:18" /><verse number="19" style="v" sid="GEN 41:19" />अळतेन तीनु सात गावड़ी पछळ दीसरा सात कुड़ायला ने हाड़कायला गावड़्‌या आवतेला देखलु। मीसर देस मां असला कुड़ायला ने हाड़कायला गावड़्‌या मे कदी नी देख्‌यु। <verse eid="GEN 41:19" /><verse number="20" style="v" sid="GEN 41:20" />ने चे कुड़ायला ने हाड़कायला गावड़्‌या, बेसका वारु ने माताला गावड़्‌या काजे खाय गुया। <verse eid="GEN 41:20" /><verse number="21" style="v" sid="GEN 41:21" />बाकुन चे हाड़कायला गावड़्‌या, मातली सांत गावड़ी काजे खाय गुया, तेबी चे हाड़कायला गावड़्‌या तसात कुड़ायला ने हाड़कायला देखाय तेला। तत्‌रा मां मारी नींद उगड़ी गुय। <verse eid="GEN 41:21" /><verse number="22" style="v" sid="GEN 41:22" />मे अळी दीसरो सपनो देख्‌यु, एक टटाळा मां, मटा ने वारु पेड्‌ला दाणा भर सात उमब्‌या नीकळ्‌या। <verse eid="GEN 41:22" /><verse number="23" style="v" sid="GEN 41:23" />अळतेन तीनात टटाळा मां अळी सात पातेळ्‌ळा ने उगेण्‌ली झाळ सी झळ्‌ळायला उमब्‌या नीकळ्‌या। <verse eid="GEN 41:23" /><verse number="24" style="v" sid="GEN 41:24" />जे सांत पातेळ्‌ळा उमब्‌या, सांत वारु पेड्‌ला दाणा भरला सांत उमब्‌या काजे गीळ गुया। मे आखा कागळ पांड्‌या काजे ने आखा मंडळीन सहलाणी देखण्‌या काजे बुलावीन चे सपना सामळायु, बाकुन तींद्‌रे माय्‌न कुय बी तीनु सपनान मतलब नी देखाड़ सक्‌यो।”<verse eid="GEN 41:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 41:25" />तत्‌यार युसुफ फीरोन राजा काजे कह्‌यु, दुयु सपनान मतलब एक जसा छे, यहोवा भगवान जो काम करने वाळु छे, तीना कामेन बारामां चु तुसेक देखाड़ देदलु छे। <verse eid="GEN 41:25" /><verse number="26" style="v" sid="GEN 41:26" />तीनु सात मातला गावड़्‌या ने तीनु सात वारु पेड्‌ला उमब्‌यान मतलब वारु पाक पाणीन सात साल छे; ईनु दुयु सपनान एकुत मतलब छे। <verse eid="GEN 41:26" /><verse number="27" style="v" sid="GEN 41:27" />ने सात हाड़कायला ने कुड़ायला गावड़्‌या मतलब ने उगेवणी झाळ सी झळ्‌ळायला सात उमब्‌यान मतलब आवणे वाळा काळेन सात साल छे। <verse eid="GEN 41:27" /><verse number="28" style="v" sid="GEN 41:28" />भगवान जो काम करने वाळु छे चत फीरोन अगळ देखाड़ देदलु छे; जीत वात मे पेहले देखाड़लु ने असो की असो हवणे वाळो छे: <verse eid="GEN 41:28" /><verse number="29" style="v" sid="GEN 41:29" />सामळ, सात साल लग मीसर देस मां बेसको अन पाक्‌से। <verse eid="GEN 41:29" /><verse number="30" style="v" sid="GEN 41:30" />बाकुन सात साल हय जासे ने अळतेन सात साल लग बेसकु काळ पड़से ने तीना काळ मां पेहली सात सालेन पाक पाणीक माणसे वीसरी जासे; ने काळ मां आखो मीसर देस उजड़ी जासे। <verse eid="GEN 41:30" /><verse number="31" style="v" sid="GEN 41:31" />काळ अतरो पड़से की, तीना काळ मां सात सालेन वारलु पाक पाणी लग हेर नी आवे। <verse eid="GEN 41:31" /><verse number="32" style="v" sid="GEN 41:32" />ने फीरोन जे दुय सपना देखलु, तीनु सपनान मतलब जत छे की, भगवान भीणी सी जो हवणे वाळो छे चो टाकाय गुयलो छे, ने भगवान जो छाटुत पुरो करसे।<verse eid="GEN 41:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 41:33" />तेरेमां हंय ए फीरोन तु एक समजदार ने अक्‌कल वाळा माणुस काजे देखीन नेवाड़, ने तीनाक मीसर देसेन मुखी मंत्‌री बणाव। <verse eid="GEN 41:33" /><verse number="34" style="v" sid="GEN 41:34" />ने ए फीरोन, जत्‌यार लगुन वारु पाके ती लग तु मीसर देस मां आखा माणसे भीणी मेरेन पांचवु हीस्‌सु भेळु करने करीन दीसरा हकदार्‌या काजे बी नेवाड़ ले। <verse eid="GEN 41:34" /><verse number="35" style="v" sid="GEN 41:35" />ने चे हकदार्‌या, खाणेन अन भेळो करसे, ने चे सहर-सहरे मां अन भेळो करीन अन काजे मट्‌ली-मट्‌ली कणगी मां ने मटला-मटला कुठा मां भरसे। ने चे फीरोनेन हकेम रवीन तीनु कणगीन राखवाळी करसे। <verse eid="GEN 41:35" /><verse number="36" style="v" sid="GEN 41:36" />चो भेळो करलो अन सात सालेन काळ मां काम देसे। ने मीसर देसेम काळ सी कुय बी नी मरे।<verse eid="GEN 41:36" /></para>
  <para style="s">युसुफ काजे मीसरे देसेन मुखी मंत्‌री बणाय जाणु</para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 41:37" />युसुफ जी वात राजा फीरोन काजे ने तेरा आखा हकदार्‌या काजे वारु गम्‌यो। <verse eid="GEN 41:37" /><verse number="38" style="v" sid="GEN 41:38" />तेरेमां फीरोन राजु आपसा हकदार्‌या काजे कह्‌यु, “हेरेम ते भगवानेन जीव-आत्‌मा रवे। आपणुक एरेन तसलु माणुस अळी कांखुर जड़से काय?” <verse eid="GEN 41:38" /><verse number="39" style="v" sid="GEN 41:39" />फीरोन राजु युसुफ काजे कह्‌यु, “भगवान ते तारेत पर जो आखो उजेंतो करलु छे, तेरेमां हंय तारेन तसु समजवाळु ने अक्‌कल वाळु कांखुर नी जड़े; <verse eid="GEN 41:39" /><verse number="40" style="v" sid="GEN 41:40" />तेरेमां मे तुसेक मारा घरन्‌यान मुखी मंत्‌री बणायस ने मारा आखा माणसे तारु हुकुम मानसे। ने राजगादी समाळने मां अतरुत मे तारे सी मटु रय्‌स।” <verse eid="GEN 41:40" /><verse number="41" style="v" sid="GEN 41:41" />फीरोन राजु युसुफ काजे कह्‌यु, “सामळ, मे तुसे काजे मीसर देसेन मुखी मंत्‌री बणाय दम।” <verse eid="GEN 41:41" /><verse number="42" style="v" sid="GEN 41:42" />तत्‌यार फीरोन राजु आपसा हातेम सी आपसा नावेन सीलठप्‌पा वाळी मुंदी नीकाळीन युसुफेन हातेम पेहराय देदु; ने बेसका वारु चमकण्‌या पुथल्‌या पेहराय देदु, ने तेरा गळाम सनान साकळ पेहराय देदु; <verse eid="GEN 41:42" /><verse number="43" style="v" sid="GEN 41:43" />ने युसुफ काजे फीरोन राजु आपसी दीसरी घुड़ा-गाडी पर बसाड़्‌यु ने फीरोन राजान माणसे युसुफ अगळ असो परचार करता गुया, “युसुफ काजे वांद्‌या।” करीन फीरोन राजु युसुफ काजे आखा मीसर देसेन हकदार्‌यु मंत्‌री बणाय देदु। <verse eid="GEN 41:43" /><verse number="44" style="v" sid="GEN 41:44" />फीरोन राजा युसुफ काजे कह्‌यु, “फीरोन राजु ते मेत छे, बाकुन आखा मीसर देसेन माणसे तारात हुकुमेन अनसारे चालसे।” <verse eid="GEN 41:44" /><verse number="45" style="v" sid="GEN 41:45" />फीरोन राजु युसुफ नाव जाफेनात-पान्‌यु पाड़्‌यु। ओन सहरेन एक पुजारु हतलु, तेरो नाव पोतीपेरा हतलु ने तेरी आसनात नावेन पुरे हतली। फीरोन राजु तीनी पुरेन ईयाव युसुफ साते कराड़ देदु। तेरेमां युसुफ आखा मीसर देसेन हकदार्‌यु बण गुयु। <verse eid="GEN 41:45" /><verse number="46" style="v" sid="GEN 41:46" />जत्‌यार युसुफ मीसर देसेन, हकदार्‌यु मंत्‌री बन्‌लु, ती तेरी उमर तीस सालेन हतली। ने युसुफ फीरोन राजान हवेली काजे छुड़ीन तीना देस मां आखे दुर माणसेन हाल-चाल देखणे नीकळ्‌यु। <verse eid="GEN 41:46" /><verse number="47" style="v" sid="GEN 41:47" />मीसर देस मां सात साल लग बेसकी मेर पाकी। <verse eid="GEN 41:47" /><verse number="48" style="v" sid="GEN 41:48" />मीसर देस मां सात साल लग जतरो बी पाक्‌यो चो आखो युसुफ, सहर-सहर मां भेळो कराड़ीन मट्‌ली-मट्‌ली कणगीम ने मटला-मटला कुठाम भराड़ देदु। <verse eid="GEN 41:48" /><verse number="49" style="v" sid="GEN 41:49" />युसुफ दरीयान रेतळान तसों बेसको अन भेळो कराड़ लेदु। ने युसुफ अन काजे तुलीन हीसाब राखणेन छुड़ देदु काहाकी अनेन हीसाब नी राखाये ततरो हय गुयलो।<verse eid="GEN 41:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 41:50" />काळ पड़नेन पेहले साल युसुफ लाडी आसेनात, युसुफ सी भार पाये हय, ने तेरा दुय पुर्‌या हया। युसुफेन लाडी आसनात ओन सहरेन पुजारा पोतीपेरान पुरे हतली। <verse eid="GEN 41:50" /><verse number="51" style="v" sid="GEN 41:51" />युसुफ आपसा मटला पुर्‌यान नाव मनेस्‌यु पाड़्‌यु, ने कह्‌यु, “भगवान मेसेक आखो दुख, ने मारा बासेन घराणाक ईस्‌राड़ देदु।” <verse eid="GEN 41:51" /><verse number="52" style="v" sid="GEN 41:52" />ने दीसरा पुर्‌यान नाव एप्‌रेम पाड़्‌यु ने कह्‌यु, “दीना देस मां मेसेक बेसको दुख झेलनु पड़लो, तीनात देस मां भगवान मेसेक, कमी घटी नी हवणी देदु।”<verse eid="GEN 41:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="GEN 41:53" />मीसर देस मां सात साल लग बेसको पाक्‌यो ने चे सात साल वीत गुया। <verse eid="GEN 41:53" /><verse number="54" style="v" sid="GEN 41:54" />ने अळतेन युसुफ दसु कहलु तसुत मीसर देस मां ने दीसरा आखा देस मां बी सांत सालेन काळ पड़ने बाजी ज्‌यु; बाकुन आखा मीसर देस मां सांत साल लग बेसको पाक्‌लो चे दाणा भेळा करला हतला। <verse eid="GEN 41:54" /><verse number="55" style="v" sid="GEN 41:55" />जत्‌यार मीसर देसेन आखा माणसे भुकला घाबरायणे बाजी गुया, ती चे आयड़ी-आयड़ीन रड़ी-रड़ीन फीरोन सी अन मांगणे बाजी गुया: ने फीरोन राजा तीनु माणसेक असु कह्‌या करतेलु, “तुहुंं युसुफेन चां जावु, ने युसुफ जसो कवसे तसोत करजु।” <verse eid="GEN 41:55" /><verse number="56" style="v" sid="GEN 41:56" />मीसर देस मां बेसकु काळ पड़्‌यु ती युसुफ मटला-मटला कणगी मां सी भेळो करलो नीकाळी-नीकाळीन मीसर देसेम वाळा माणसे काजे मुल आपणे बाजी गुयु। <verse eid="GEN 41:56" /><verse number="57" style="v" sid="GEN 41:57" />आखी धरतीन देसेन माणसे दाणा मुल लेणे करीन, मीसर देस मां युसुफेन चां आवणे बाजी गुया, काहाकी आखी धरती पर बेसकु काळ पड़ रवलु।<verse eid="GEN 41:57" /></para>
  <chapter eid="GEN 41" />
  <chapter number="42" style="c" sid="GEN 42" />
  <para style="s">युसुफेन भायसे काजे मीसरे देस मां दाणा लेणे आवणु</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 42:1" />तीने टेमे युसुफेन बास याकुब रवतेलु चां बी काळ पड़ने बाजी रहलु। याकुब सामळ्‌यु की, मीसर देस मां दाणा मुल जड़े, ती चु आपसा पुर्‌या काजे कह्‌यु, “तुहुंं आखान-आखा मुंहडे हात लागाड़ीन काहा बस र्‌या? <verse eid="GEN 42:1" /><verse number="2" style="v" sid="GEN 42:2" />मे सामेळ्‌ळु छे की, मीसर देस मां दाणा मुल जड़ने बाजी रया। तेरेमां चां जाय्‌न आपणे वाटे दाणा मुल ली आवु, तत्‌यार आपणु भुकला नी मरजे।” <verse eid="GEN 42:2" /><verse number="3" style="v" sid="GEN 42:3" />असो सामळीन युसुफेन दस भायस मीसर देस मां दाणा लेणे गुया। <verse eid="GEN 42:3" /><verse number="4" style="v" sid="GEN 42:4" />बाकुन याकुब युसुफेन नानला भायस बीन्‌यामीन काजे तींद्‌रे पुठ्‌ये नी मकल्‌यु। याकुब बीहतेलु की, बीन्‌यामीन बी काय माय्‌न काय हय जासे।<verse eid="GEN 42:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 42:5" />कनान देस मां आखे दुर बेसकु काळ पड़ रहलु; तेरेमां दीसरा माणसे बी मीसर देस मां दाणा मुल लेणे गुया। तींद्‌रे पुठ्‌ये इस्‌राएल्‌यान पुर्‌या बी दाणा मुल लेणे गुया। <verse eid="GEN 42:5" /><verse number="6" style="v" sid="GEN 42:6" />युसुफ मीसर देसेन हकदार्‌यान मंत्‌री हतलु, तेरेमां आखा देसेन माणसे काजे युसुफ अतरुत दाणा वेचतेलु। ने युसुफेन भायस युसुफेन चां गुया ने युसुफ काजे ढंगा वळीन पाये पड़्‌या। <verse eid="GEN 42:6" /><verse number="7" style="v" sid="GEN 42:7" />युसुफ आपसा भायस काजे उळखी ते लेदु, बाकुन चु तींद्‌रे अगळ अंजाणलु बणीन काठाये पुछ्‌यु, “तुहुंं कां सी आवला छे?”</para>
  <para style="p" vid="GEN 42:7">चे युसुफ काजे जपाप आप्‌या, “हामु कनान देस मां सी दाणा मुल लेणे आवला छे।”<verse eid="GEN 42:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 42:8" />युसुफ ते आपसा भास्‌यो काजे उळखी लेदलु, बाकुन तेरा भायस युसुफ काजे नी उळख्‌या। <verse eid="GEN 42:8" /><verse number="9" style="v" sid="GEN 42:9" />तत्‌यार युसुफ काजे चो सपनो हेर आयो, जो सपनो चु आपसा भायसेन बारामां देखलु; ने चु तीनुक कह्‌यु, “तुहुंं ईना देसेन काहवाळ्‌या बणीन आवला छे, ने ईना देसेन लुलखाय देखणे आवला छे।”<verse eid="GEN 42:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 42:10" />युसुफेन भायस युसुफ काजे कह्‌या, “नी-नी, हामरा मालीक असी वात नी हय, हामु ते तारा गुलाम पावर्‌या छे, ने दाणा मुल लेणे आवला छे। <verse eid="GEN 42:10" /><verse number="11" style="v" sid="GEN 42:11" />हामु आखा एकुत बासेन पुर्‌या छे, ने हामु ते ईमानदार माणसे छे। हामु तारा गुलाम पावर्‌या छे, ने हामु ईना देसेन लुलखाय देखणे नी आया।”<verse eid="GEN 42:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 42:12" />युसुफ तीनु काजे कह्‌यु, “नी-नी, तुहुंं झुट मेक र्‌या, तुहुंं ते ईना देसेन लुलगाय देखणेत आवला छे।”<verse eid="GEN 42:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 42:13" />चे कह्‌या, “हामु ते तारा गुलाम पावर्‌या छे, ने कनान देस मां रहण्‌या एकुत बासेन बारे पुर्‌या छे, एक भायस मर गुयलु, ने छेंडलु भायस बास पुठ्‌ये घर छे।”<verse eid="GEN 42:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 42:14" />युसुफ तीनुक कह्‌यु, “तुहुंं ते काहवाळ्‌यात छे। जी वात ते मे तुहुंंक पेहलुन कय देदलु अळी काय? <verse eid="GEN 42:14" /><verse number="15" style="v" sid="GEN 42:15" />राजा फीरोनेन सगुन खाय्‌न मे तुहुंं काजे कहों की, तुहुंं काजे पारेखणुत पड़से; जत्‌यार लगुन तुंद्‌रु नानलु भायस जां नी आवे, तत्‌यार लगुन मे तुहुंंक नी छुड़ो। <verse eid="GEN 42:15" /><verse number="16" style="v" sid="GEN 42:16" />तेरेमां तुंद्‌रा नानला भायस काजे लेणे करीन तुंद्‌रे माय्‌न एक जणा काजे मकली देवु। ने मे तुहुंं काजे छाचला ने झुटला पारखी नी लम ती लग दीसरा काजे, मारा जेलेत मां रहणु पड़से। कांखुर माय्‌न तुहुंं छाचला नी नीकळ्‌या, ती मे फीरोन राजान सगुन खाय्‌न कहों की, तुहुंं देसेन काहवाळ्‌यात कवायसु।” <verse eid="GEN 42:16" /><verse number="17" style="v" sid="GEN 42:17" />अळतेन युसुफ तीनु काजे तीन दाहड़ा लग जेल मां कुंडाड़ देदु।<verse eid="GEN 42:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 42:18" />तीन दाहड़ा हय ज्‌या ने अळतेन युसुफ तीनु काजे कह्‌यु, “मे भगवानेन बीहाणो मानीन जीवण्‌यु माणुस छे; ने जो काय मे तुहुंंक कहों, चत करु; ती तुहुंं जीवतेला रवसु। <verse eid="GEN 42:18" /><verse number="19" style="v" sid="GEN 42:19" />कदीक तुहुंं ईमानदार माणसे हय, ती तुंद्‌रे माय्‌न एक जणु ईनी जेल मां रहु, ने दीसरा, भुकला घरन्‌या वाटे अन लीन घर जावु। <verse eid="GEN 42:19" /><verse number="20" style="v" sid="GEN 42:20" />ने तुंद्‌रा छेंडेला भायस काजे मारेन्‌चां लावु; तत्‌यार तुहुंं छाचला कवायसु, ने तुहुंं मुत सी बची जासु।”</para>
  <para style="p" vid="GEN 42:20">अळतेन चे युसुफ कह्‌यु तसात कर्‌या। <verse eid="GEN 42:20" /><verse number="21" style="v" sid="GEN 42:21" />चे आपसा-आपसात कहणे बाजी ज्‌या, “छाचलीन आपणु आपणा भाय पर कुहराय करला, तेरेमां हंय आपणुक डंड जड़ र्‌यु। चु बेसकु दुख मां कलेपतु जाय्‌न लीलघाय करलु, तेबी आपणु तेरी नी सामळ्‌या। ने हंय आपणु बी दुख मां पड़ र्‌या, ने लीलघाय कर र्‌या।”<verse eid="GEN 42:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 42:22" />रुबेन तीनुक कह्‌यु, “मे तुहुंंक कहलु ते खरु की, तुहुंं हेरे पर मां कुहरायु, बाकुन तुहुंं मारी सामळ्‌या नी। तेरेमां तुहुंंक तेरा खुनेन बदलु जड़ र्‌यु।” <verse eid="GEN 42:22" /><verse number="23" style="v" sid="GEN 42:23" />युसुफ दुय बुली समजण्‌या काजे तींद्‌रे साते वात करने करीन कामे लागाड़ रहलु, ने युसुफेन भायस असा समज्‌या की, युसुफ हामरी बुली नी जाणतु हसे। बाकुन युसुफ ते चे कहे, चो आखो समजतेलु। <verse eid="GEN 42:23" /><verse number="24" style="v" sid="GEN 42:24" />अळतेन युसुफ तींद्‌रेन्‌चां सी एक धड़े जाय्‌न रड़ने बाजी ज्‌यु; ने थुड़ीक वार मां पछु आवीन तींद्‌रे साते वात कर्‌यु, ने सीमोन काजे नेवाड़ीन तींद्‌रे देखेतात तीनाक जेल मां कुंड देदु।<verse eid="GEN 42:24" /></para>
  <para style="s">युसुफेन भायसे कनान देस मां पछा आवे</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 42:25" />अळतेन युसुफ थुड़ाक पावर्‌या काजे हुकुम आप्‌यु की, “तुहुंं तींद्‌रा थयला मां दाणा भर देवु, ने तींद्‌रा एकेक थयला मां तींद्‌रा पयस्‌या पछा भर देवु। ने वाट्‌ये वाटे खाणो बी बांद देवु।” ने चे, जसु युसुफ कह्‌यु तसात कर्‌या। <verse eid="GEN 42:25" /><verse number="26" style="v" sid="GEN 42:26" />अळतेन चे भायस आपसा-आपसा गदड़ा पर ने भरला थयला मेकीन चां सी आपसा घर भीणी चाल पड़्‌या। <verse eid="GEN 42:26" /><verse number="27" style="v" sid="GEN 42:27" />वाट्‌ये धरम-साहळा मां, चे रात काट्‌या, ने एक जणु गदड़ाक चारु आपणे करीन थयलु छुड़्‌यु, ती थयलान मुंहडे पर रुप्‌या देख्‌यु। <verse eid="GEN 42:27" /><verse number="28" style="v" sid="GEN 42:28" />ती चु आपसा भायसे काजे कह्‌यु, “देखु, मारा पयस्‌या ते मारा थयला मां पछा भरला छे।” असो सामळीन चे आखा बीह ज्‌या, ने तींद्‌रु चट्‌ये जीव जात र्‌यु। ने एक-दीसराक कह्‌या, “भगवान हामरे साते असो काहा हवणी दी र्‌यु हसे?”<verse eid="GEN 42:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 42:29" />ने युसुफेन भायस घर आवीन आखी वात आपसा बास काजे असा देखाड़्‌या: <verse eid="GEN 42:29" /><verse number="30" style="v" sid="GEN 42:30" />“जु माणुस तीना देसेन मालीक छे, चु हामरे साते काठाय करीन असु कह्‌यु तुहुंं ईना देसेन काहवाळ्‌या बणीन आय र्‌या। <verse eid="GEN 42:30" /><verse number="31" style="v" sid="GEN 42:31" />ती हामु तीनाक कह्‌या, हामु ईमानदार माणसे छे, हामु ईना देसेन काहवाळ्‌या बणीन नी आया। <verse eid="GEN 42:31" /><verse number="32" style="v" sid="GEN 42:32" />हामु एकुत बासेन बारे पुर्‌या छे, बाकुन एक जणु मर गुयलु, ने आखान छेंडेलु कनान देस मां हामरा बासेन्‌चां छे।” <verse eid="GEN 42:32" /><verse number="33" style="v" sid="GEN 42:33" />तत्‌यार चु हामुक कह्‌यु, “कदीक तुहुंं ईमानदार माणसे हय, ती तुंद्‌रे माय्‌न एक जणु ईनी जेल मां रहु, ने दीसरा, भुकला घरन्‌या वाटे दाणा लीन घर जावु। <verse eid="GEN 42:33" /><verse number="34" style="v" sid="GEN 42:34" />ने तुंद्‌रा छेंडेला भायस काजे मारेन्‌चां लावु। ती मेसेक भुरसु आवसे की, तुहुंं काहवाळ्‌या माणसे नी हय। ने ईमानदार छे। अळतेन मे तुंद्‌रा भायस काजे पछु आप दीस, ने तुहुंं ईना देस मां लेणु-देणु कर सक्‌सु।”<verse eid="GEN 42:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 42:35" />जो काय दीन आखा भायस आपसा-आपसा थयला मां सी दाणा नीकाळ्‌ने बाजी ज्‌या। तत्‌यार तीनु काजे तींद्‌रा थयला मां रुप्‌यान एकेक थयलि देखाव पड़ी: तत्‌यार रुप्‌यान थयलि देखीन, चे ने तींद्‌रु बास बेसका बीही ज्‌या। <verse eid="GEN 42:35" /><verse number="36" style="v" sid="GEN 42:36" />तत्‌यार तींद्‌रु बास याकुब तीनु काजे कह्‌यु, “तुहुंं ते मेसेक बीना अवल्‌यातेन तसा कर देदा, सामळु, युसुफ ते जाती र्‌यु, ने सीमोन बी नी हय, ने तुहुंं बीन्‌यामीन काजे बी ली जाणे हींडे: जी आखी गरा मारेत पर आय पड़ली छे।”<verse eid="GEN 42:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 42:37" />रुबेन आपसा बास याकुब काजे कह्‌यु, “कदीक मे बीन्‌यामीन काजे तारेन्‌चां नी लावो, ती तु मारा दुयु पुर्‌या काजे मार नाखजी। बीन्‌यामीन काजे मारे पुठ्‌ये मकली दे, मे हीनाक पछु ली आवीस।”<verse eid="GEN 42:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 42:38" />बाकुन याकुब कह्‌यु, “मे मारा पुर्‌या बीन्‌यामीन काजे तारे पुठ्‌ये नी मकलो, काहाकी हेरु भायस ते मर गुयु, ने हयु एखलुत रय गुयलु छे: ने कांखुर माय्‌न वाट्‌ये जाता-जाता तुंद्‌रे पर काहनीस गरा आय पड़से, ती तुंद्‌रे वाट्‌ये मे डाहवारा मां रड़तु कलेपतु मर जायस ने तुहुंं मेसे अघे कर देसु।”<verse eid="GEN 42:38" /></para>
  <chapter eid="GEN 42" />
  <chapter number="43" style="c" sid="GEN 43" />
  <para style="s">बीन्‌यामीन साते मीसरे देस मां जाणु</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 43:1" />कनान देस मां अळी अदुस काळ पड़ ज्‌यु। <verse eid="GEN 43:1" /><verse number="2" style="v" sid="GEN 43:2" />ने मीसर देस मां सी जो दाणा ली गुयला, चो आखा दाणा सर गुया, तत्‌यार इस्‌राएल आपसा पुर्‌या काजे कह्‌यु, “मीसर देस मां जाय्‌न थुड़ाक दाणा अळी मुल ली आवु।”<verse eid="GEN 43:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 43:3" />बासेन वात सामळीन यहुदा आपसा बास काजे कह्‌यु, “चु माणुस हामु काजे चेतावणी दीन कहलु की, तुंद्‌रा भायस काजे लीन जां आवजु, नीते मारो मुंहडो घुण देखु। <verse eid="GEN 43:3" /><verse number="4" style="v" sid="GEN 43:4" />ने कदी तु हामरा भायस बीन्‌यामीन काजे हामरे पुठ्‌ये मकलीस, ती हामु मीसर देस जाय्‌न अळी दाणा ली आवसुन। <verse eid="GEN 43:4" /><verse number="5" style="v" sid="GEN 43:5" />बाकुन कदीक तु बीन्‌यामीन काजे हामरे भेळुत नी मकले, ती हामु चां नी जाजे: काहाकी चु माणुस हामुक असु कहलु की, तुंद्‌रा भायस काजे लीन जां आवजु, नीते जां पाय घुण मेकु।”<verse eid="GEN 43:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 43:6" />तत्‌यार इस्‌राएल्‌यु आपसा पुर्‌या काजे कह्‌यु, हामरु एक अळी भायस छे, असा कय्‌न तुहुंं, “मेसेक काहा फीकुर मां पाड़ देदा?”<verse eid="GEN 43:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 43:7" />चे कह्‌या, “चु माणुस हामरे बारामां ने आपणा घरन्‌यान बारामां पुरी कदर सी असु पुछ्‌यु, ‘तुंद्‌रु बास हाल लग जीवत्‌लु छे काय? तुंद्‌रा अळी बी दीसरा भायस छे काय?’ चु पुछ्‌यु तसात हामु बी कह्‌या; हामुक काय मालम की, चु असु कवसे तुंद्‌रा भायस काजे मारेन्‌चां ली आवजु।”<verse eid="GEN 43:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 43:8" />यहुदा आपसा बास इस्‌राएल्‌या काजे कह्‌यु, “बीन्‌यामीन काजे हामरे पुठ्‌ये मकली दे, ती हामु, तु ने हामरा पुर्‌या काळ मां जीवतेला रवसु ने भुकला नी मरजे। <verse eid="GEN 43:8" /><verse number="9" style="v" sid="GEN 43:9" />तीनाक पछो लावणेन काम मार माथे रवसे, मेत तीनाक पछु लावीन तारे अगळ उबु कर दीस। ने कदी मे तीनाक तारे अगळ लावीन उबु नी करों ती मे जलम तारु गुनाळु रय्‌स। <verse eid="GEN 43:9" /><verse number="10" style="v" sid="GEN 43:10" />हामु पेहलुस जाता, ने वार नी करता ती हंय लग दुय कावा वळ जाता।”<verse eid="GEN 43:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 43:11" />इस्‌राएल्‌यु कह्‌यु “असी वात छे ती असा करु, जां सी तीना माणुस काजे भेट आपणे करीन थुड़ोक मुहाळ, पीस्‌तो, बादाम, गंद, बाम-मलम ने लबान लेता जावु। <verse eid="GEN 43:11" /><verse number="12" style="v" sid="GEN 43:12" />ने एनी कावा दुणा रुप्‌या बी लेता जावु, ने तुंद्‌रा थयला मां जे रुप्‌या हतला चे रुप्‌या बी पछा लेता जावु कांखुर माय्‌न चे रुप्‌या गलती सी थयला मां भराय ज्‌या हसे। <verse eid="GEN 43:12" /><verse number="13" style="v" sid="GEN 43:13" />बीन्‌यामीन काजे बी तुंद्‌रे पुठ्‌ये लीन तीना माणसेन्‌चां छाटास अळी जावु। <verse eid="GEN 43:13" /><verse number="14" style="v" sid="GEN 43:14" />जत्‌यार तुहुंं तीना हकदार्‌या माणुस अगळ उबा हवसु, ती आखाम जुर भर्‌यु भगवान तुंद्‌री मदत करसे, ने चु हकदार्‌यु माणुस गीण करीन, सीमेन्‌या काजे ने बीन्‌यामीन काजे बी पछु मकली देसे। हय सके चु पछु नी मकले ती, भले मे बीना अवल्‌यातेन रवो।”<verse eid="GEN 43:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 43:15" />अळतेन युसुफेन भायस, युसुफ वाटे भेट ने दुणा रुप्‌या, ने बीन्‌यामीन काजे बी पुठ्‌ये लीन मीसर देस भीणी चाल पड़्‌या। ने चालता-चालता चे मीसर देस मां युसुफेन चां पुग ज्‌या। <verse eid="GEN 43:15" /><verse number="16" style="v" sid="GEN 43:16" />युसुफ बीन्‌यामीन काजे तींद्‌रे पुठ्‌ये देखीन आपसा घरेन राखवाळ्‌या पावर काजे कह्‌यु, “पला माणसेक मारे घर ली जावु। ने एक जानवर्‌यो मारु, ने रांदु। आज तपी वेळाय हीनु माणसे काजे मे मारे पुठ्‌ये खाणो खावाड़ीस।” <verse eid="GEN 43:16" /><verse number="17" style="v" sid="GEN 43:17" />युसुफेन वात सामळीन चु पावर तीनु माणसे काजे युसुफेन घर ली ज्‌या।<verse eid="GEN 43:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 43:18" />जत्‌यार युसुफेन भायस, युसुफेन घर पुग्‌या, ती चे बीहीन आंबा-सां‌बा कहणे बाजी ज्‌या, “पेहली कावा जे आपणा थयला मां रुप्‌या भरला, करीन जे आपणु काजे धरीन माहीं लाय र्‌या। ने हंय जे माणसे आपणुक ठुक्‌से, ने आपणु काजे कब्‌जा मां करीन गुलाम बणाय लेसे ने आपणा गदड़ा बी हापकी लेसे।” <verse eid="GEN 43:18" /><verse number="19" style="v" sid="GEN 43:19" />अळतेन चे युसुफेन घरेन बारनान‌चां जाय्‌न युसुफेन घरेन राखवाळ्‌या पावर काजे असा कहणे बाजी ज्‌या, <verse eid="GEN 43:19" /><verse number="20" style="v" sid="GEN 43:20" />“ए हामरा मालीक, जत्‌यार हामु पेहली कावा दाणा मुल लेणे आवला। <verse eid="GEN 43:20" /><verse number="21" style="v" sid="GEN 43:21" />ने पछा जाणे बाजी रहला ती वाट्‌येत धरम-साहळा मां हामरा थयला उघाड़्‌या, ती आखान थयलान मुंहडे पर रुप्‌यान एकेक थयलि हतली। ने जतरा रुप्‌या हामु दाणा लेणे करीन आपला ततरात रुप्‌या तीनु थयला मां हतला। तेरेमां हामु चे रुप्‌या पछा लेता आवला छे। <verse eid="GEN 43:21" /><verse number="22" style="v" sid="GEN 43:22" />काय जाणु, हामरा थयला मां चे रुप्‌या कुण भरलो जाणे? हामु ते अळी दाणा मुल लेणे करीन दीसरा रुप्‌या बी लेता आय र्‌या।”<verse eid="GEN 43:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 43:23" />बाकुन पावर तीनुक कह्‌यु, “बीहु मां, बेफीकर्‌या रहु! तुहुंं पेहले मुल लेदला तीना दाणान रुप्‌या ते मेसेक जड़ गुयला। तुंद्‌रे वाटे तुंद्‌रा थयला मां रुप्‌या ते तुंद्‌रु भगवानुत भर्‌यु हसे, जु तुंद्‌रा बासेन बी भगवान छे।” असु कय दीन चु पावर सीमोन काजे जेलेम सी नीकाळीन तींद्‌रे पुठ्‌ये भेसकी देदु।<verse eid="GEN 43:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 43:24" />तत्‌यार चु अधीकारी तीना माणसे काजे घर मां ली जाय्‌न पाणी आप्‌यु, तत्‌यार जे आपसान पाय धुया ने; पछेन चु तींद्‌रा गदड़ा काजे चारु आप्‌यु। <verse eid="GEN 43:24" /><verse number="25" style="v" sid="GEN 43:25" />तत्‌यार ज सामळीन की आज हामुक जांत खाणो खाणु पड़से, चे युसुफेन आवणेन टेम तक, मतलब खयार दाहड़े लग, तीनी भेट काजे आपणे करीन भेळा कर लेदा। <verse eid="GEN 43:25" /><verse number="26" style="v" sid="GEN 43:26" />जत्‌यार युसुफ घर आयु, ती चे तीयार करली भेट आपणे करीन तेरे अगळ गुया, ने भेट आपीन युसुफ काजे ढंगा वळीन पाये पड़्‌या। <verse eid="GEN 43:26" /><verse number="27" style="v" sid="GEN 43:27" />अळतेन युसुफ तीनुक पुछ्‌यु, “वारलु छे की? ने तुंद्‌रु बास, जु डाहलु छे, तेरे बारामां तुहुंं मेसेक कहला। चु वारलु छे की? चु हंय लग जीवतेलु छे काय?”<verse eid="GEN 43:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 43:28" />चे कह्‌या, “हव, तारु गुलाम, जु हामरु बास छे, चु वारलु छे।” ने असा कयदीन चे ढंगा वळीन युसुफेन पाये पड़्‌या।<verse eid="GEN 43:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 43:29" />अळतेन युसुफ आपसा भायस बीन्‌यामीन भीणी भाळीन दीसरा भायस काजे पुछ्‌यु, “तुंद्‌रु छेंडेवलु भायस, तेरे बारामां तुहुंं मेसेक कह्‌या, जुत छे काय?” अळतेन युसुफ, बीन्‌यामीन काजे कह्‌यु, “मारा बेटा, भगवान तारे पर गीण करे करीन।” <verse eid="GEN 43:29" /><verse number="30" style="v" sid="GEN 43:30" />असु कवतात युसुफेन मन गीणे सी भराय ज्‌यो, ने चु तत्‌यारुत आपसा कपराम जाय्‌न रड़ने बाजी ज्‌यु। <verse eid="GEN 43:30" /><verse number="31" style="v" sid="GEN 43:31" />अळतेन चु हुगु रय ज्‌यु, ने मुंहडो धुवीन काठु-जीव करीन आपसा भायसेन चां पछु आयु, ने पावर्‌या काजे कह्‌यु, “चालु, हंय खाणो आपु, खाणो खाय लेता।” <verse eid="GEN 43:31" /><verse number="32" style="v" sid="GEN 43:32" />अळतेन पावर्‌या, युसुफ वाट्‌ये आंग्‌ये, युसुफेन भायस वाटे आंग्‌ये, ने मीसर देसेम वाळा वाटे आंग्‌ये खाणो आप्‌या। काहाकी मीसर देस मां रहण्‌या माणसे ईब्‌री जातीन माणसे काजे वीटळ्‌लु समजतेला। ने भेळा बसीन नी खात्‌ला। <verse eid="GEN 43:32" /><verse number="33" style="v" sid="GEN 43:33" />युसुफेन भायस काजे उमरेन हीसाबे मटला ने नानला लग गमे-च युसुफ अगळ बसाड़ देदा। जो देखीन चे चकराय ज्‌या, ने आंबा-सांबा भाळने बाजी ज्‌या। <verse eid="GEN 43:33" /><verse number="34" style="v" sid="GEN 43:34" />युसुफ जो खात्‌लु, चत खाणो तेरेन्‌चां सी पावर्‌या जाहा गाड़तेलु, ने युसुफ बीन्‌यामीन आपसान्‌चां सी पांच गुणा खाणो अदु पुगाड़्‌यु। चे आखा पेट भरीन खादा-पीदा।<verse eid="GEN 43:34" /></para>
  <chapter eid="GEN 43" />
  <chapter number="44" style="c" sid="GEN 44" />
  <para style="s">चांदीन कटेवरु</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 44:1" />युसुफ आपसा घरेन राखवाळ्‌या पावर काजे कह्‌यु, “ईनु माणसेन थयला मां दतरो अन भराये, ततरो अन भर दे, ने अन लेणे करीन चे, जे रुप्‌या आपला, तीनु रुप्‌याक तींद्‌रा आखान थयला-डीट मुंहडेस पर मेकीन बांद दे। <verse eid="GEN 44:1" /><verse number="2" style="v" sid="GEN 44:2" />ने छेंडला भायसेन थयला मां रुप्‌या भेळे मारु चांदीन पीयालु बी मेल दे।” जसु युसुफ कह्‌यु, तसुत चु कर्‌यु। <verse eid="GEN 44:2" /><verse number="3" style="v" sid="GEN 44:3" />ने चु पावर संदारे एगुत तीनु काजे तींद्‌रा गदड़ा भेळे मकली देदु। <verse eid="GEN 44:3" /><verse number="4" style="v" sid="GEN 44:4" />चे सहर सी थुड़ेस नांबे गुया अतरात, ने युसुफ आपसा घर राखवाळ्‌या पावर काजे कह्‌यु, “ईनु माणसेन पछळ पड़ीन, ने तीनुक हात करीन कव, तुहुंं भलायन बदले कुहराय काहा कर्‌या? <verse eid="GEN 44:4" /><verse number="5" style="v" sid="GEN 44:5" />तुहुंं हामरा मालीकेन चांदीन पीयालु चुरी करीन ली आवला छे, ने ईना पीयाला काजे चु ईसारु देखणेन कामे लावे। ने तुहुंं ईना पीयाला काजे चुरी करीन गुनु करला छे।”<verse eid="GEN 44:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 44:6" />तत्‌यार पावर युसुफेन हुकुम मानीन तीनुक हात कर लेदु, ने युसुफ कहलु, तसोत तीनुक कह्‌यु। <verse eid="GEN 44:6" /><verse number="7" style="v" sid="GEN 44:7" />चे तीना पावर काजे कह्‌या, “ए हामरा मालीक, तु हामुक असी वात काहा कहे? असो काम करनु तारा पावर्‌या छे छेटे रहे। <verse eid="GEN 44:7" /><verse number="8" style="v" sid="GEN 44:8" />हामरा थयला मां जे रुप्‌या हतला, चे रुप्‌या हामु कनान देस मां सी पछा लावीन आप देदला छे, जी वात तुसेक मालम छे। ती हामु तारा मालीकेन घरमां सी चांदी नीते सनो काहा चुरी करसु? <verse eid="GEN 44:8" /><verse number="9" style="v" sid="GEN 44:9" />ने तेरे वाटे बी तारा मालीकेन चांदीन पीयालु जड़े, तीनाक मार देजी, ने दीसरा हामु आखा तारा गुलाम पावर्‌या बण जासुन।”<verse eid="GEN 44:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 44:10" />चु पावर युसुफेन भाय काजे कह्‌यु, “हव, तुहुंं कय र्‌या, तसुत मे करीस, बाकुन तेरा थयलाम चांदीन पीयालु जड़से, तीनाक मे मारु, नी बाकुन तीनाक गुलाम बणाय लीस। ने दीसराक छुड़ दीस।” <verse eid="GEN 44:10" /><verse number="11" style="v" sid="GEN 44:11" />असो सामळीन चे आखा मामार-मामार आपसा-आपसा थयला गदड़ा पर सी हेटा उतारीन थयलान मुंहडा छुड़्‌या। <verse eid="GEN 44:11" /><verse number="12" style="v" sid="GEN 44:12" />तत्‌यार युसुफेन पावर तींद्‌रा एकेक थयला मां मटलानचां सी नानलान चां लग पीयाला हेरने बाजी ज्‌यु, ने पीयाला बीन्‌यामीन थयला मां जड़ ज्‌यो। <verse eid="GEN 44:12" /><verse number="13" style="v" sid="GEN 44:13" />अळतेन चे दुखी हय्‌न आपसा-आपसा पुथल्‌या फाड़्‌या, ने अळतेन थयला आपसा-आपसा गदड़ा पर मेल-लीन मीसर मां युसुफेन सहर गुया।<verse eid="GEN 44:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 44:14" />जत्‌यार यहुदा ने तेरा भायस युसुफेन घरमां गुया, ती युसुफ चांत हतलु, ने युसुफ अगळ पाये पड़ीन वांद्‌या। <verse eid="GEN 44:14" /><verse number="15" style="v" sid="GEN 44:15" />युसुफ तीनु काजे कह्‌यु, “तुहुंं जु चांदीन पीयालु काहा चुरी करला? तुहुंं काजे जी वात मालम नी हतली काय की, जु माणुस ईसारु देखीन हामरी वात जाण लेसे?”<verse eid="GEN 44:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 44:16" />यहुदा कह्‌यु, “हामु, हामरा मालीक काजे काय कवजे ने काय नी? हामु ‘चुरी नी कर्‌या’ एरु पुरावु देणे वाटे हामरे वाटे काय नी हय। ने तींद्‌रा थयला मां चांदीन पीयाला हतलो, चु ने हामु आखा तारा गुलाम पावर्‌यात छे। हंय काय करजे?”<verse eid="GEN 44:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 44:17" />युसुफ कह्‌यु, “मे तुहुंं आखा काजे गुलाम पावर्‌या नी बणावो। बाकुन जु माणुस मारु चांदीन पीयालु चुरी करलु छे। चु की चु मारु गुलाम-पावर बणसे। ने दीसरा तुहुंं आखा आपसा बासेन घर सुकने-मने जात रवु।”<verse eid="GEN 44:17" /></para>
  <para style="s">बीन्‌यामीन वाटे यहुदान वीन्‌ती</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 44:18" />असो सामळीन यहुदा युसुफेन चां जाय्‌न कह्‌यु, ए मारा मालीक, मे तारु गुलाम-पावर छे, बाकुन मेसेक एक वात कहणेन हुकुम आप, तु मारे पर रीसवाये घुण, काहाकी तु फीरोन राजा बराबर छे। <verse eid="GEN 44:18" /><verse number="19" style="v" sid="GEN 44:19" />ए मारा मालीक! हामु ते तारा गुलाम पावर्‌या छे। जत्‌यार हामु पेहले आवला ती तु हामुक पुछलु की, तुंद्‌रु बास नीते भायस छे काय? <verse eid="GEN 44:19" /><verse number="20" style="v" sid="GEN 44:20" />ने ए मालीक! तत्‌यार हामु तुसेक कहला की, हामरु बास छे, ने तेरु डाहवाराम हवलु एक पुर्‌यु छे, बाकुन तेरु सगु भायस मर गुयलु, ने हंय चु तेरी आय्‌सीन एकुत जीवतेलु पुर्‌यु छे, हेरे सी तेरु बास तीनाक वदु परम करे। <verse eid="GEN 44:20" /><verse number="21" style="v" sid="GEN 44:21" />ने तत्‌यार तु हामु गुलाम पावर्‌या काजे कहलु, तीनाक मे देखणे हींड र्‌यु, ने तीनाक जां ली आवु। <verse eid="GEN 44:21" /><verse number="22" style="v" sid="GEN 44:22" />ए मालीक! ती हामु तुसेक कहला की, चु पुर्‌यु आपसा बास काजे नी छुड़े; कदीक चु बासेक छुड़ देसे, ती तेरु बास मर जासे। <verse eid="GEN 44:22" /><verse number="23" style="v" sid="GEN 44:23" />ती तु हामु गुलाम पावर्‌याक कहलु की, तुहुंं छेंडला भायस काजे नी लावे, ती तुहुंं जां पछा पाय घुण मेकु।<verse eid="GEN 44:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 44:24" />ती तु हामु गुलाम पावर्‌याक कहलु की, तुहुंं छेंडेला भायस काजे नी लावे, तत्‌यार हामु तीनाक मालीकेन वात सामळ्‌या। <verse eid="GEN 44:24" /><verse number="25" style="v" sid="GEN 44:25" />थुड़ाक दाहड़ा वीत-ज्‌या ने अळतेन हामरु बास हामुक कहलु, अळी जाय्‌न, थुड़ाक दाणा ली आवु। <verse eid="GEN 44:25" /><verse number="26" style="v" sid="GEN 44:26" />ती हामु हामरा बासेक कहला कदी बी हामु, हामरा छेंडेला भायस पाखुर चां नी जाजे। हव, कदी चु भायस पुठ्‌ये जासे, तीत जासुन: काहाकी छेंडेला भायस पाखुर हामु काजे तीना माणसेन्‌चां नी जावाये। <verse eid="GEN 44:26" /><verse number="27" style="v" sid="GEN 44:27" />ती हामरु बास जु तारु गुलाम-पावर छे, चु हामुक कह्‌यु, तुहुंं काजे मालम छे की, मारे सी मारी बायर राहेलेन दुयु पुर्‌या हवला। <verse eid="GEN 44:27" /><verse number="28" style="v" sid="GEN 44:28" />ने तींद्‌रे माय्‌न एक ते पेहलेत मर ज्‌यु, ने मे समजी ज्‌यु की, तीनाक काहानास जंगली जानवर्‌या तातड़ीन खाय ज्‌यो हसे। ने ती सी चु मेसेक देखणे लग नी जड़्‌यु। <verse eid="GEN 44:28" /><verse number="29" style="v" sid="GEN 44:29" />ने कदी तुहुंं मारा दीसरा पुर्‌या काजे बी ली जाणे हींड र्‌यु, ने हेरो काहींग हय-ज्‌यो, ती ते मे हंय डाहवारा मां मर जायस।<verse eid="GEN 44:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 44:30" />“तेरेमां जत्‌यार मे मार बास तारा पावर्‌या धड़े आवों ने जु पुर्‌यु साते नी रहे, तेरु जीव ईनात पर अटकीन रहे, <verse eid="GEN 44:30" /><verse number="31" style="v" sid="GEN 44:31" />तेरेमां असु देखीन की पुर्‌यु नी हय हयु तत्‌यारुत मर जासे। तत्‌यार तारा आखा पावर्‌यान वजे सी तारु पावर्‌यु हामरु बास, जु डाहु हय ज्‌यु, दुख सी मरलान दुनीया मां उतरी जाय्‌स। <verse eid="GEN 44:31" /><verse number="32" style="v" sid="GEN 44:32" />मे, तारु गुलाम पावर, मार बास अगळ असु कहलु की, ईनाक पछु लावणेन काम मारे माथे रवसे, ने कदी मे ईना काजे तारेन्‌चां पछु नी लावो, ती ते मे जलम तारी नींगा मां गुनाळु रय्‌स। <verse eid="GEN 44:32" /><verse number="33" style="v" sid="GEN 44:33" />तेरेमां ए मालीक, मे तारु गुलाम-पावर, तारे सी लीलघाय करों की, मे ईना भायसेन बदले तारेन्‌चां गुलाम-पावर बणीन रय्‌स, ने ईना भाय काजे मारा दीसरा भाय पुठ्‌ये पछु मकली दे। <verse eid="GEN 44:33" /><verse number="34" style="v" sid="GEN 44:34" />मे ईना भाय पाखुर कसु मारा बासेन्‌चां जाम? मे मार बास काजे फीकुर करीन मरतेलु देखणे नी हींड्‌तु।”<verse eid="GEN 44:34" /></para>
  <chapter eid="GEN 44" />
  <chapter number="45" style="c" sid="GEN 45" />
  <para style="s">युसुफ खुदेन बारामां आपसान भायस काजे देखाड़े</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 45:1" />यहुदान वात सामळीन युसुफेन काठु-जीव नी हयु, ने चु उतवाळ्‌युत आखा पावर्‌या काजे आयड़ीन कह्‌यु “जां सी खयड़े जाती रव।” आखा खयड़े जाती रया ने अळतेन युसुफ आपसा वाराम आपसा भाय अगळ कय देदु। तीने टेमे युसुफ पुठ्‌ये तेरा भायसेक छुड़ीन कुय नी हतलो। <verse eid="GEN 45:1" /><verse number="2" style="v" sid="GEN 45:2" />ने चु ढळो-ढळो रड़ने बाजी ज्‌यु, ने खयड़े वाळा मीसर देसेन माणसे युसुफ काजे रड़तेलु सामळी लेदा, ने तेरा रड़नेन खबर फीरोन राजान चां ने तेरा घरन्‌यान चां पुगाड़ देदा। <verse eid="GEN 45:2" /><verse number="3" style="v" sid="GEN 45:3" />ती युसुफ आपसा भाय काजे कह्‌यु, “मे तुंद्‌रु भायस युसुफ छे, मारु बास हंय लग जीवतेलु छे काय?” युसुफेन वात सामळीन चे घाबराय गुयला, तेरेमां चे युसुफ काजे काय बी जपाप नी देदा। <verse eid="GEN 45:3" /><verse number="4" style="v" sid="GEN 45:4" />अळतेन युसुफ आपसा भाय काजे अळी कह्‌यु, “मारे साते आवु।” ज सामळीन चे युसुफ साते गुया। ने युसुफ तीनुक कह्‌यु, “मे तुंद्‌रु भायस युसुफ छे, ने तुहुंं मेसेक मीसर देसेम जाण्‌या वेपारी काजे वेच देदला, ने चे मेसेक जां ली आवला। <verse eid="GEN 45:4" /><verse number="5" style="v" sid="GEN 45:5" />हंय मां घाबरायु। ‘हामु ते ईनाक वेच देदला’ करीन आपसा पर मां कीचवायु; काहाकी भगवान तुहुंंक काळ मां सी बचाड़ने करीन, पेहेल सीत मेसेक जां मकेल्‌लु छे। <verse eid="GEN 45:5" /><verse number="6" style="v" sid="GEN 45:6" />काळ पल्‌लु दुयुत साल हय र्‌या; ने पांच साल अळी काळ पड़से, काळेन ईनु साले मां कुय खेते मां हळ बी नी जुपे, ने बीज बी नी वेरे ने फसल बी नी काटे। <verse eid="GEN 45:6" /><verse number="7" style="v" sid="GEN 45:7" />तेरेमां भगवान मेसेक तुंद्‌रे सी पेहेल जां सी मकली देदलु, काहाकी तुहुंं धरती पर जीवतेला रहु, ने तुंद्‌रु वेल अधे करीन ने तुंद्‌री अवल्‌यात बची जाय करीन। <verse eid="GEN 45:7" /><verse number="8" style="v" sid="GEN 45:8" />जां भगवान मेसे काजे फीरोन राजान बासेन तसु, ने तेरा घरेन मुखी, ने आखा मीसर देसेन मालीक बणाय देदलु छे।”<verse eid="GEN 45:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 45:9" />युसुफ अळी कह्‌यु, “ने तुहुंं उतवाळ्‌यात मारा बासेन चां जावु, ने तीना काजे कहु तारु पुर्‌यु युसुफ असु कय मकेल्‌लु छे की, भगवान मेसे काजे मीसर देसेन मालीक बणाय देदलु छे; तेरेमां तु छाटुत मारेन चां आवती रव। <verse eid="GEN 45:9" /><verse number="10" style="v" sid="GEN 45:10" />ने तु मार धड़े गोसेन मुलुक मां तारा पुर्‌या भेळे, ने पुर्‌यान-पुर्‌या भेळे, ने गाडरा बुकड़ा भेळे ने आपसा आखा माणसे भेळे रवजी। <verse eid="GEN 45:10" /><verse number="11" style="v" sid="GEN 45:11" />ने पांच साल लग अळी काळ पड़से, ती तीना काळ मां मे तुंद्‌री देख-भाळ कर्‌या करीस; ने तु ने तारा घरन्‌या, ने जतरा बी तारे भेळा छे, चे भुकला नी मरे।”<verse eid="GEN 45:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 45:12" />युसुफ आपसा भाय काजे कवतुत गुयु की, “हंय तुहुंं ने तुंद्‌रु भायस बीन्‌यामीन उजेंता देख लेदला छे की, मे छाचलीन युसुफ छे। <verse eid="GEN 45:12" /><verse number="13" style="v" sid="GEN 45:13" />ने तुहुंं मीसर मां जो काय मटा कामे देखला छे, तेरे वाराम मारा बास काजे देखाड़ देजु; ने मारा बास काजे जां छाटात लीन आवजु।”<verse eid="GEN 45:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 45:14" />असु कय दीन युसुफ बीन्‌यामीन काजे बाथलाटीन रड़ने बाजी ज्‌यु; ने बीन्‌यामीन बी युसुफ काजे बाथलाटीन रड़ने बाजी ज्‌यु। <verse eid="GEN 45:14" /><verse number="15" style="v" sid="GEN 45:15" />अळतेन युसुफ रड़तु जाय्‌न आखा भाय काजे गुळु देदु ने तीनुक बाथलाटीन रड़्‌यु: ने अळतेन तेरा भायस तेरे साते वात करने बाजी ज्‌या।<verse eid="GEN 45:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 45:16" />युसुफेन भायस युसुफेन चां आय र्‌या, करीन राजान हवेली मां खबर पुगी, ती फीरोन राजु ने तेरा पावर्‌या खुस हय ज्‌या। <verse eid="GEN 45:16" /><verse number="17" style="v" sid="GEN 45:17" />ने फीरोन राजु युसुफ काजे कह्‌यु, “तारा भाय काजे कव की, तुहुंं काजे जतरो बी अन चाहजे, ततरो दाणा गदड़ा पर झेलाड़ीन कनान देस मां पछा जाती रहु। <verse eid="GEN 45:17" /><verse number="18" style="v" sid="GEN 45:18" />ने तुंद्‌रा बास काजे ने तुंद्‌रा घरन्‌या काजे जां ली आवु; ने मीसर देस मां जो काय छे, तेरेम सी आखान वारलु तीनुक आपीस, ने देसेम वाळो आखाम वारलु खाणो खाणे आपीस।” <verse eid="GEN 45:18" /><verse number="19" style="v" sid="GEN 45:19" />फीरोन राजु, युसुफ काजे असो बी कह्‌यु, “तु, तीनुक कव की, तुहुंं तुंद्‌रा बायरा-छुरा काजे जां लावणे करीन मीसर देसेम सी थुड़ाक घुड़ा-गाडी ली जावु, ने आपसा बास काजे बी बठाड़ीन ली आवु। <verse eid="GEN 45:19" /><verse number="20" style="v" sid="GEN 45:20" />ने चां वाळी चीजेन फीकुर घुण करु; काहाकी तुहुंं काजे मीसर देसेम वाळी वारलु सी बी वारलु चीज जड़ जासे।”<verse eid="GEN 45:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 45:21" />युसुफ फीरोन राजान वात सामळीन आपसा भायसेक देखाड़्‌यु, ने चे हव, कय देदा। ने युसुफ, राजान कहणेन अनसारे तीनुक घुड़ा-गाडी आप्‌यु ने वाट्‌ये खाणे करीन खाणेन चीज बी आप्‌यु। <verse eid="GEN 45:21" /><verse number="22" style="v" sid="GEN 45:22" />आखा भायस काजे युसुफ एकेक जुड़ी नवला पुथल्‌या बी आप्‌यु; बाकुन बीन्‌यामीन काजे तीन सव चांदीन टका ने पांच जुड़ी नवला पुथल्‌या आप्‌यु। <verse eid="GEN 45:22" /><verse number="23" style="v" sid="GEN 45:23" />युसुफ आपसा बास वाटे दस गदड़ा पर, मीसर देसेन वारली चीजेन दस गाठड़ा, ने कनान देसेम सी मीसर देसेम आवणी वेळाय वाट्‌ये खाणे करीन खाणो, रुटा ने दीसरो भात्‌यो खाणो दस गदड़ी पर झेलाड़ देदु। <verse eid="GEN 45:23" /><verse number="24" style="v" sid="GEN 45:24" />असु करीन युसुफ आपसा भाय काजे जो आखो आपीन वळाय देदु, ने चे चाल पड़्‌या; ती चु तीनुक कह्‌यु, “वाट्‌ये घुण लड़ायता।”<verse eid="GEN 45:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 45:25" />असु करीन चे मीसर देस सी चाल पड़्‌या ने कनान देस मां आपसा बास याकुबेन चां जाती र्‌या। <verse eid="GEN 45:25" /><verse number="26" style="v" sid="GEN 45:26" />ने घर पुगतात चे आपसा बासेक कह्‌या, “युसुफ ते हय लग जीवतेलु छे, ने मीसर देसेम राज-करन्‌यु मुखी बण र्‌यु।” जी वात सामळीन तींद्‌रा बास याकुबेन भळ-जीव कर्‌यु, ने चु ईनी वाते पर भुरसु नी कर्‌यु।<verse eid="GEN 45:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 45:27" />बाकुन युसुफ कहलु ची आखी वात चे आपसा बास याकुब काजे कय देदा ने याकुब तीनु घुड़ा-गाडी काजे बी देख्‌यु, जे घुड़ा-गाडी युसुफ तीनाक लेणे करीन मकेल्‌लु। ती याकुबेन जीव फवरु हय गुयु। <verse eid="GEN 45:27" /><verse number="28" style="v" sid="GEN 45:28" />अळतेन इस्‌राएल्‌यु कह्‌यु, “हंय मेसेक भुरसु छे की, मारु पुर्‌यु युसुफ हय लग जीवतेलु छे, मारे वाटे अतरोत बेसको, मे ते मरनेन पेहलुत जाय्‌न तीनाक देख लीस।”<verse eid="GEN 45:28" /></para>
  <chapter eid="GEN 45" />
  <chapter number="46" style="c" sid="GEN 46" />
  <para style="s">याकुबेन घरन्‌या भेळे मीसरे देस मां जाणु</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 46:1" />इस्‌राएल्‌यु आपसु आखु बीडारु बांदीन मीसर देस भीणी चाल पड़्‌यु, ने बेरसेबा पुगीन चां आपसा बास इसाकेन भगवान काजे जानवर मारीन बादा चड़ायु, ने तेरी भक्‌ती कर्‌यु। <verse eid="GEN 46:1" /><verse number="2" style="v" sid="GEN 46:2" />तत्‌यार राती भगवान, इस्‌राएल्‌या काजे जागता-सपना मां कह्‌यु, “ए याकुब! ए याकुब!” इस्‌राएल कह्‌यु,</para>
  <para style="p" vid="GEN 46:2">“काय वात छे कव, मे जां छे।”<verse eid="GEN 46:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 46:3" />चु कह्‌यु, “मे भगवान छे, तारा बासेन भगवान छे।” तु मीसर देस जाणे सी मां बीहे काहाकी मे तार सी चां एक मट्‌ली अवल्‌यातेन अवल्‌यात बणावीस। <verse eid="GEN 46:3" /><verse number="4" style="v" sid="GEN 46:4" />मे तारे पुठ्‌ये-पुठ्‌ये मीसरे देस मां चालीस, ने मे चां सी मे जरुर पछु ली आवीस ने युसुफ आपसान हाते सी तारा डुळा काजे बंद कर देसे। <verse eid="GEN 46:4" /><verse number="5" style="v" sid="GEN 46:5" />अळतेन याकुब बेरसेबा सी मीसर देस मां जाणे तीयार हय ज्‌यु: ती फीरोन राजु ली मकेल्‌लु, तीनु घुड़ा-गाडी पर इस्‌राएल्‌यु आपसा पुर्‌या ने तींद्‌रा बायरा-छुरा भेळे बसीन मीसर देस भीणी चाल पड़्‌यु। <verse eid="GEN 46:5" /><verse number="6" style="v" sid="GEN 46:6" />ने आपसा गाडरा ने बुकड़ा, गावड़ी, ने बेल ने अळी कनान देस मां जो माल-धन भेळो करलु आखो धन लीन मीसरे देस मां पछु आयु। <verse eid="GEN 46:6" /><verse number="7" style="v" sid="GEN 46:7" />ने याकुब आपसा पुर्‌या पारी ने पुर्‌यान पुर्‌या पारीक मतलब आखा घरन्‌या काजे आपसा पुठ्‌ये मीसरे देस मां ली आयु।<verse eid="GEN 46:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 46:8" />याकुबेन मतलब इस्‌राएल्‌यान पुर्‌या ने तींद्‌रा पुर्‌यान-पुर्‌या, जे मीसर देसो मां आवला, तींद्‌रा नावे जे छे: इस्‌राएलीन पेहलु पुर्‌यु रुबेन हतलु। <verse eid="GEN 46:8" /><verse number="9" style="v" sid="GEN 46:9" />ने रुबेनेन पुर्‌या: हनोक, पल्‌लु, हेसर्‌यु ने कर्‌मी हतला। <verse eid="GEN 46:9" /><verse number="10" style="v" sid="GEN 46:10" />इस्‌राएल्‌यान दुसरु पुर्‌यु सीमोन हतलु। सीमेन्‌यान पुर्‌या: यमुयेल्‌यु, यामीन्‌यु, अहद्‌यु, याकीन्‌यु ने सहर्‌यु ने सावुल हतला। सावुल कनानी जातीन बायरी सी पयदा हवलु। <verse eid="GEN 46:10" /><verse number="11" style="v" sid="GEN 46:11" />इस्‌राएल्‌यान तीसरु पुर्‌यु लेवी हतलु। लेवीन पुर्‌या: गेरसोन्‌यु, कहात्‌यु, ने मरार्‌यु हतला। <verse eid="GEN 46:11" /><verse number="12" style="v" sid="GEN 46:12" />इस्‌राएल्‌यान चोवथु पुर्‌यु यहुदा हतलु। यहुदान पुर्‌या: एर्‌यु, ओनान, सेला, पेरेस, ने जेरह हतला। एर्‌यु ने ओनान कनान देस मां मर गुयला। पारस्‌यान पुर्‌या: हेबरोन्‌यु ने हामुल हतला। <verse eid="GEN 46:12" /><verse number="13" style="v" sid="GEN 46:13" />इस्‌राएल्‌यान पुर्‌यु इस्‌साकार्‌यु बी हतलु। ईस्‌साकार्‌यान पुर्‌या: तल्‌यु, पुव्‌वु, यासुब्‌यु ने सीम्‌रोन्‌यु हतला। <verse eid="GEN 46:13" /><verse number="14" style="v" sid="GEN 46:14" />इस्‌राएल्‌यान पुर्‌यु जबुलुन बी हतलु। जबुलुनेन पुर्‌या: सेरेद्‌यु, एलोन्‌यु, ने योहलेल्‌यु हतला। <verse eid="GEN 46:14" /><verse number="15" style="v" sid="GEN 46:15" />पद्‌दनराम मां लीया सी पयदा हवला याकुबेन पुर्‌या ने तींद्‌रा पुर्‌यान-पुर्‌या जेत हतला। ईना घराणा मां तीस ने तीन अदमी हतला। याकुबेन एक पुरे बी हतली, तेरो नाव दीना हतलो।<verse eid="GEN 46:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 46:16" />इस्‌राएल्‌यान पुर्‌यु गाद बी हतलु। गाद्‌यान पुर्‌या: सीयोन्‌यु, हग्‌गीयु, सुनीयु, एसबोन्‌यु, एरीयु, आरोदीयु ने आरेलीयु हतला। <verse eid="GEN 46:16" /><verse number="17" style="v" sid="GEN 46:17" />इस्‌राएल्‌यान पुर्‌यु आसेर बी हतलु। आसेरेन पुर्‌या: ईम्‌नायु, ईसवायु, ईसवीयु, ने बेरीयायु हतला। ने बेरीयान पुर्‌या: हेबेर्‌यु ने माल्‌कीएल्‌यु हतला। ने आसेरेन एक पुरे बी हतली, तेरो नाव सेरा हतलो। <verse eid="GEN 46:17" /><verse number="18" style="v" sid="GEN 46:18" />जे आखा जील्‌पा सी पयदा हवला याकुबेन अवल्‌यात हतला। लाबान जी जील्‌पा, लीया काजे आप्‌लु। ईना घराणा मां सुळ्‌ळे जणा हतला।<verse eid="GEN 46:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 46:19" />युसुफ ने बीन्‌यामीन बी याकुबेन पुर्‌या हतला। जे तेरी घरवाळी राहेल सी पयदा हवला। <verse eid="GEN 46:19" /><verse number="20" style="v" sid="GEN 46:20" />युसुफेन दुय पुर्‌या: मनेस्‌यु ने एप्‌रेम हतला। जे युसुफेन लाडी आसनातीस मीसर देस मां पयदा हया। जी आसेनाती, सन सहर मां रहण्‌या पोतीपेरा पुजारान पुरे हतली। <verse eid="GEN 46:20" /><verse number="21" style="v" sid="GEN 46:21" />बीन्‌यामीन पुर्‌या: बेला, बेकेर्‌यु, आसबेल्‌यु, गेरा, नामान्‌यु, एहीयु, रोस, मुप्‌पीम्‌यु, हुप्‌पीम्‌यु ने आरद्‌यु हतला। <verse eid="GEN 46:21" /><verse number="22" style="v" sid="GEN 46:22" />जे आखा राहेली सी पयदा हवला, याकुबेन पुर्‌या ने पुर्‌यान-पुर्‌या हतला। ईना घराणा मां चोवदे जणा हतला।<verse eid="GEN 46:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 46:23" />इस्‌राएल्‌यान पुर्‌यु दान बी हतलु। दान्‌यान पुर्‌यु: हुसीम हतलु। <verse eid="GEN 46:23" /><verse number="24" style="v" sid="GEN 46:24" />इस्‌राएल्‌यान पुर्‌यु नप्‌ताली बी हतलु। नोपताल्‌यान पुर्‌या: याहसेल्‌यु, गुनीयु, येसेर्‌यु, ने सील्‌लेम्‌यु हतला। <verse eid="GEN 46:24" /><verse number="25" style="v" sid="GEN 46:25" />जे आखा बील्‌हान ने याकुबेन पुर्‌या-पारी हतला। जी बील्‌हा राहेलेन पावरनी हतली। ईनी बील्‌हा काजे लाबान आपसी बेटी राहेली वाटे आपलु। ईना घराणा मां सांत जणा हतला।<verse eid="GEN 46:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 46:26" />याकुबेन उहड़ीस्‌या काजे छुड़ीन याकुबेन घराणा मां आखा मेळीन तीन-वीसु ने छव जणा हतला। जे मीसर देस मां आवला। <verse eid="GEN 46:26" /><verse number="27" style="v" sid="GEN 46:27" />मीसर देस मां पयदा हवला, चे युसुफेन दुय पुर्‌या हतला। ईने रीते मीसर देस मां याकुबेन घराणा मां आखा मेळीन सत्‌तर जणा हतला।<verse eid="GEN 46:27" /></para>
  <para style="s">याकुब ने हेरा घरन्‌या मीसरे मां</para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 46:28" />याकुब, यहुदा काजे आपसा सी अगळ युसुफेन चां मकली देदु। ने अळतेन इस्‌राएल्‌यु पछळ सी आपसा घराणा भेळ गोसेन नावेन जागा भीणी चाल पड़्‌यु। <verse eid="GEN 46:28" /><verse number="29" style="v" sid="GEN 46:29" />अळतेन युसुफ, मीसर देसेम सी आपसी घुड़ा-गाडी जुपाड़ीन आपसा बास इस्‌राएल्‌या काजे भेळा हवणे करीन गोसेन नावेन जागा मां आयु, ने तीनाक भेळा हय्‌न तीनाक बाथलाटीन रड़तुत रयु। <verse eid="GEN 46:29" /><verse number="30" style="v" sid="GEN 46:30" />तत्‌यार इस्‌राएल्‌यु, युसुफ काजे कह्‌यु “हंय मे तुसेक जीवतेलु देख लेदु; तेरेमां मे हंयत मर जाम तेबी काय नी हय।”<verse eid="GEN 46:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 46:31" />जो सामळीन युसुफ आपसा भायसेक ने तींद्‌रा पुर्‌या-पारीक, ने आपसा बास काजे कह्‌यु, “मे फीरोन राजा काजे जाय्‌न असु कय्‌स की, ‘मारा भायस ने मारु बास ने तेरो आखो घराणो, जो कनान देस मां रवतेलो, चो मारेन चां आवती रहलो छे। <verse eid="GEN 46:31" /><verse number="32" style="v" sid="GEN 46:32" />ने चे गुवाळ्‌या छे, काहाकी चे ढुरे पाळे; ने चे आपसा गाडरा ने बुकड़ा, गावड़ी ने बेल, ने जो काय तींद्‌रे धड़े छे, चो आखो ली आवला छे।’ <verse eid="GEN 46:32" /><verse number="33" style="v" sid="GEN 46:33" />ने जत्‌यार फीरोन राजु तुहुंं काजे पुछे की, ‘तुंद्‌रु काय धंदु छे?’ <verse eid="GEN 46:33" /><verse number="34" style="v" sid="GEN 46:34" />तत्‌यार तुहुंं तीनाक कवजु, ‘हामु तारा गुलाम पावर्‌या छे, ने हामु नानला हतला, ती सीत गुवाळ्‌या छे ने बुकड़ा, गाडरा ने ढुरे चारता आय र्‌या। ने हामरा आड़ा-बुड़ा बी असात ढुरे चारतेला।’ असा कवसु तीत चु तुहुंं काजे गोसेन नावेन खयड़ा मां वसणी देसे; काहाकी आखा मीसर मां रहण्‌या माणसे गुवाळ्‌या सी छीट पाळे।”<verse eid="GEN 46:34" /></para>
  <chapter eid="GEN 46" />
  <chapter number="47" style="c" sid="GEN 47" />
  <para style="p">
    <verse number="1-2" style="v" sid="GEN 47:1-2" />युसुफ आपसा भायस मां सी पांच भायसेक पुठ्‌ये लीन, फीरोन राजा साते वात करने गुयु। ने चु तींद्‌री उळखाण फीरोन राजा साते कराड़्‌यु, ने कह्‌यु, “मारु बास ने मारा आखा भायस, कनान देस मां सी तींद्‌रा गाडरा ने बुकड़ा, ने गावड़ी ने बेल ने आखो माल-धन लीन आवती रहला छे; ने हंय चे गोसेन नावेन खयड़ा मां छे।” <verse eid="GEN 47:1-2" /><verse number="3" style="v" sid="GEN 47:3" />फीरोन राजु युसुफेन भाय काजे पुछ्‌यु, “तुंद्‌रु काम धंदु काय छे?” चे फीरोन राजा काजे कह्‌या, “हामु तारा गुलाम पावर्‌या! गुवाळ्‌या छे, जसा हामरा आड़ा-बुड़ा बी गुवाळ्‌यात हतला। <verse eid="GEN 47:3" /><verse number="4" style="v" sid="GEN 47:4" />बाकुन हंय हामरा कनान देस मां बेसकु काळ पड़ र्‌यु। ने हामरा गाडरा ने बुकड़ा वाटे चारने करीन चारु बी नी रह्‌यु। तेरेमां हामु जां ईतराक दाहड़ा लग परदेसी बणीन रहणे आय र्‌या। ने हामु काजे दया करीन गोसेन खयड़ा मां रहणे करीन हुकुम आप दे।” <verse eid="GEN 47:4" /><verse number="5" style="v" sid="GEN 47:5" />फीरोन राजु युसुफ काजे कह्‌यु, “तारु बास ने तारा भायस तारेन चां आय लाग्‌या करीन मे बेसकु खुस छे, <verse eid="GEN 47:5" /><verse number="6" style="v" sid="GEN 47:6" />तुसेक मीसर देस मां जो गमे चो आखाम सी वारु खयड़ो नेवाड़ ले, मेसेक असो लागे की, गोसेन खयड़ो तींद्‌रे वाटे आखा सी वारु रवसे, तेरेमां आपसा बासेक ने आपसा भाय काजे चां वसाड़ दे; ने कदीक तु जाणतु हय की, हींद्‌रे माय्‌न कुणी-कुणी धड़े वारु गुवाळी करनेन हुनर छे, तीनुक मारा ढुरे चारने वाळान हकदार्‌या ठहराय दे।”<verse eid="GEN 47:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 47:7" />अळतेन युसुफ आपसा बास याकुब काजे बी फीरोन राजान चां मांही बुलायन तेरी उळखाण राजाक कराड़्‌यु। ने याकुब फीरोन राजा काजे संयबरकत आप्‌यु। <verse eid="GEN 47:7" /><verse number="8" style="v" sid="GEN 47:8" />अळतेन फीरोन राजु याकुब काजे पुछ्‌यु, “तु कतरा सालेन छे?”<verse eid="GEN 47:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 47:9" />याकुब फीरोन काजे कह्‌यु, “मे दीसरा देस मां दुख झेलीन एक सव तीस साले काट लेदु; मारा आड़ा-बुड़ा दीसरा-देसेम जतरा साल लग जीया, ततरा साल मारा नी हया।” <verse eid="GEN 47:9" /><verse number="10" style="v" sid="GEN 47:10" />ने याकुब फीरोन राजा काजे एक कावा अळी संयबरकत आप्‌यु, ने तेरेन चां सी जाती र्‌यु। <verse eid="GEN 47:10" /><verse number="11" style="v" sid="GEN 47:11" />युसुफ, फीरोन राजान हुकुम मानीन आपसा बास ने आपसा भायस्‌ये काजे मीसर देसेन, रामसेस नावेन सहर मां वारलु जागा आप दीन वसाड़ देदु। <verse eid="GEN 47:11" /><verse number="12" style="v" sid="GEN 47:12" />युसुफ आपसा बासेक, भायसेक ने तींद्‌रा बायरा-छुराक, तींद्‌री गिन्‌तीन अनसारे खाणान तज्‌बु कर्‌यु।<verse eid="GEN 47:12" /></para>
  <para style="s">काळेन टेम मां युसुफेन तज्‌बु</para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 47:13" />बेसकु काळ पड़ रहलु, तेरेमां मीसर देसेन माणसे भीणी ने कनान देसेन माणसे वाटे खाणे करीन काय नी रह्‌यो। ने चे काळ मां भुकला ने कमजुर हय ज्‌या। <verse eid="GEN 47:13" /><verse number="14" style="v" sid="GEN 47:14" />मीसर देसेम वाळा ने कनान देसेम वाळा युसुफ वाटे अन रुप्‌या आपीन मुल लेदा, ने जे रुप्‌या भेळा हया चे रुप्‌या, युसुफ फीरोन राजान घरेन खजाना मां लाय्‌न मेल देदु। <verse eid="GEN 47:14" /><verse number="15" style="v" sid="GEN 47:15" />मीसर देसेन ने कनान देसेन रुप्‌या सर ज्‌या। तत्‌यार आखा मीसर देसेम वाळा युसुफेन चां आय्‌न कहणे बाजी ज्‌या, “हामरे वाटे अन मुल लेणे करीन रुप्‌या नी हय, बाकुन दया करीन हामु काजे खाणेन अन आपी दे, नीते हामु तारे अगळुत भुकला मर जासुन।”<verse eid="GEN 47:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 47:16" />युसुफ कह्‌यु, “रुप्‌या नी हय ती, तुंद्‌रा ढुरे आपी देवु, ने ढुरेन आटे-साटे मां मे तुहुंं काजे खाणेन अन आपीस।” <verse eid="GEN 47:16" /><verse number="17" style="v" sid="GEN 47:17" />ने चे आपसा घर पाळन्‌या जानवर्‌या युसुफेन चां ली आया; ने युसुफ, घुल्‌ला, ने गाडरा, ने बुकड़ा, ने गावड़ी, ने बेल ने गदड़ा बदलाम तीनुक खाणेन अन आपणे बाजी ज्‌यु। तसु करीन युसुफ तीने साल बेसका जातीन जानवर्‌यान आटे-साटे अन आपीन माणसे काजे पुस्‌यु।<verse eid="GEN 47:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 47:18" />काळेन चो साल ते जसो-तसों काटाय ज्‌यो, बाकुन हंय ईने साल तींद्‌रे वाटे अनेन आटे-साटे जानवर्‌या आपणे करीन नी रया, ती चे युसुफेन चां आय्‌न कह्‌या, “ए मालीक, हामु जी वात काहा सातजे! हामु ते आखा रुप्‌या ने जानवर्‌या तुसे काजे आप देदा; ने हामरे वाटे हामरो डील ने हामरी जागा अतरीत रय, रय। <verse eid="GEN 47:18" /><verse number="19" style="v" sid="GEN 47:19" />हामुक तारे अगळ भुकला मरने मां देय, हामरी कमायणेन जागान आटे-साटे हामुक अन आप दे। ने हामुक हामरी जागा भेळे फीरोनेन गुलाम पावर्‌या बणाय ले। ने हामुक वेरने करीन बीज आपजी। नीते कांखुर माय्‌न हामरी जागा नी उजड़े।”<verse eid="GEN 47:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 47:20" />तत्‌यार युसुफ मीसर देसेन माणसेन आखी जागा दाणा आपीन मुल ली लेदु; काहाकी बेसका काळ मां तीनु काजे जागा मुल वेचणु पड़्‌यो; करीन आखी जागा फीरोन राजान हक मां हय गुय। <verse eid="GEN 47:20" /><verse number="21" style="v" sid="GEN 47:21" />ने युसुफ, मीसर देसेन आखा माणसे काजे सहरे-सहरे मां लावीन वसाड़ देदु। ने चे आखा फीरोन राजान गुलाम पावर्‌या बण ज्‌या। <verse eid="GEN 47:21" /><verse number="22" style="v" sid="GEN 47:22" />बाकुन जी जागा मीसर देसेन पुजारान हक मां हतली, ची जागा युसुफ मुल नी लेदु; काहाकी फीरोन राजा तीनु पुजारा वाटे दाहड़ीत खाणेन तज्‌बु करतेलु, ने फीरोन राजा जो खाणो तीनुक आपाड़तेलु चत खाणो चे खातला; ने तीनु काजे अन सी, तींद्‌री कमायणेन जागा वेचणु नी पड़्‌यो। <verse eid="GEN 47:22" /><verse number="23" style="v" sid="GEN 47:23" />युसुफ मीसर देसेन मुख्‌या काजे कह्‌यु, “सामळु, मे आजुन दाहड़े फीरोन राजा वाटे, तुहुंंक ने तुंद्‌री जागा काजे बी मुल लेदलु छे; देखु, जां तुंद्‌रे वाटे बीज मेकी मेल्‌यो, ने हामु तुहुंंक जो बीज आपसु ने तुहुंं ईना बीज काजे खेते मां वेरजु। <verse eid="GEN 47:23" /><verse number="24" style="v" sid="GEN 47:24" />ने ईनी जागा मां जो बी पाके, तीनी पाक पाणीन पांच हीस्‌सा पाड़जु, ने एक हीस्‌सु फीरोन राजा काजे आपजु, बचला च्‌यार हीस्‌सा तुंद्‌रा रवसे। ईनु च्‌यार हीस्‌सा मां सी बीज वाटे बचाड़जु, ने रहे चो तुहुंं ने तुंद्‌रा पुर्‌या-पारी खाजु।”<verse eid="GEN 47:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 47:25" />जी वात सामळीन चे मुख्‌या कह्‌या, “तु हामरे पर गीण करीन हामु काजे बचाड़ लेदु, ने तु हामरे वाटे वारु काम कर्‌यु; हंय हामु फीरोन राजान गुलाम पावर्‌या बणीन रवसु।” <verse eid="GEN 47:25" /><verse number="26" style="v" sid="GEN 47:26" />तसु करीन युसुफ मीसर देसेन खेती वाटे आसोत नेम बणावलु, ने चु नेम मीसर देस मां आज लगुन चाल र्‌यु। चु नेम छे की, पाक-पाणीन पांच हीस्‌सा माय्‌न, एक हीस्‌सु फीरोन राजा काजे आपणु पड़से। बाकुन पुजारान जागा पर फीरोन राजान हक नी हतलु।<verse eid="GEN 47:26" /></para>
  <para style="s">याकुबेन आकरी मरजी</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 47:27" />ने इस्‌राएली माणसे मीसर देसेन गोसेन जीला मांत रय्‌न, चां वाळी जागा काजे आपसा कब्‌जा मां कर लेदा, ने चांत तींद्‌रु वेल वदणे बाजी ज्‌यु, ने चे बेसका अदु हय गुया। <verse eid="GEN 47:27" /><verse number="28" style="v" sid="GEN 47:28" />याकुब, मीसर देस मां सतरे साल लग जीवतेलु रह्‌यु, आखी मेळीन याकुबेन उमर एक सोव ने दुय वीसु ने सात साले हय ज्‌या। <verse eid="GEN 47:28" /><verse number="29" style="v" sid="GEN 47:29" />जत्‌यार इस्‌राएल्‌यान मरनेन टेम साते आय, ती चु युसुफ काजे बुलावीन तीनाक कह्‌यु, “कदीक तु मारे पर गीण करतु हय, ती तारु हात मारा सातळ्‌या तळे मेलीन सगुन खाय्‌न कह की, मे तारे पर गीण करो ने छाचाय्‌न अनसारे काम करीस, ने मे मरीस ती मारा धड़ेक मीसर देस मां वगु घुण करे। <verse eid="GEN 47:29" /><verse number="30" style="v" sid="GEN 47:30" />मीसर देस मां सी ली जाय्‌न मारा घरन्‌या माणसेन बीड़ा मांत गाड़ीस।”</para>
  <para style="p" vid="GEN 47:30">जो सामळीन युसुफ कह्‌यु, “हव, तु कह्‌यु, तसुत मे करीस।”<verse eid="GEN 47:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 47:31" />तत्‌यार याकुब कह्‌यु, “ईनी वातेन करता तु सगुन खादु।” युसुफ सगुन खादु। तत्‌यार इस्‌राएल्‌यु खाटलान मुणका भीणी मुणको वाळ्‌यु ने युसुफ काजे तु बेसकु वारु कह्‌यु।<verse eid="GEN 47:31" /></para>
  <chapter eid="GEN 47" />
  <chapter number="48" style="c" sid="GEN 48" />
  <para style="s">याकुबेन साहरे एप्‌रेम ने मनस्‌से काजे संयबरकत आपणु</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 48:1" />थुड़ाक दाहड़ा मां काहनुस युसुफेन चां खबर लायु की, तारु बास मांदलु छे। ती युसुफ आपसा दुय पुर्‌या मनेस्‌या ने एप्‌रेम काजे पुठी लीन आपसा बासेन चां गुयु। <verse eid="GEN 48:1" /><verse number="2" style="v" sid="GEN 48:2" />ती काहनुस याकुब काजे कह्‌यु, “तारु बेटु युसुफ तारेन चां आवणे बाजी र्‌यु।” ती इस्‌राएल्‌यु खाटलात मां वार जुर लागाड़ीन बठु हय्‌न बठ ज्‌यु। <verse eid="GEN 48:2" /><verse number="3" style="v" sid="GEN 48:3" />याकुब, युसुफ काजे कह्‌यु, “कनान देस मां लुज नावेन सहर मां, आखाम जुर भर्‌यु भगवान मेसेक उजेंतु देखाव पड़लु, ने मेसेक संयबरकत आपलु। <verse eid="GEN 48:3" /><verse number="4" style="v" sid="GEN 48:4" />ने कहलु, मे तारा घराणान वेल वदाड़ीस, ने तुसेक आखा देसेन जातीन जड़-मुळ बणावीस, ने तारा माणसे ईना देस पर जलम हक जमाड़्‌ला रवसे।”<verse eid="GEN 48:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 48:5" />ने हंय तारा जे दुय पुर्‌या, जे मीसर देस मां मेसेक आवणेन पेहले पयदा हवला; चे मारात पुर्‌या कहवायसे, मतलब जसा रुबेन ने सीमोन मारा पुर्‌या छे, तसात एप्‌रेम ने मनेस्‌यु बी, मारात पुर्‌या कवायसे। <verse eid="GEN 48:5" /><verse number="6" style="v" sid="GEN 48:6" />ने ईनु दुयु काजे छुड़ीन दीसरी जी तारी अवल्‌यात हवसे, ची तारी अवल्‌यात ते कह्‌वायसे; बाकुन वाटा पाड़नेन टेमे तींद्‌रु आंग्‌ये वाटु नी पड़े; बाकुन ईनु दुय भायसेन वाटात मां तींद्‌रु बी वाटु रवसे। <verse eid="GEN 48:6" /><verse number="7" style="v" sid="GEN 48:7" />जत्‌यार मे पद्‌दनराम मां सी एपराता सहर मां आवणे बाजी रहलु, ती तार आय्‌स राहेली वाट्‌येत कनान देस मां एपराता पुगणेन ईतरीक वार पेहलुत मारे अगळ मर गुय; ने मे तीनीत वाट्‌ये धड़े तीनी काजे गाड़ीन वगे कर देदु।<verse eid="GEN 48:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 48:8" />जो कहणे बाजी रहलु ती इस्‌राएल्‌या काजे युसुफेन पुर्‌या देखाव पड़्‌या, ती इस्‌राएल्‌यु पुछ्‌यु, “जे कुण छे?”<verse eid="GEN 48:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 48:9" />युसुफ आपसा बास इस्‌राएल्‌या काजे कह्‌यु, “जे मारा पुर्‌या छे। ने भगवान मेसेक आपलु छे।”</para>
  <para style="p" vid="GEN 48:9">इस्‌राएल्‌यु, युसुफ काजे कह्‌यु, “तारा पुर्‌या काजे मारेन्‌चां लाव। ने मे हीनुक संयबरकत आपीस।” <verse eid="GEN 48:9" /><verse number="10" style="v" sid="GEN 48:10" />इस्‌राएल्‌या काजे डाहवारा मां धुंधळो देखायतेलो, ने अतरो बी की तीनाक कांही बी वारुस उळखायतेलो नी। तत्‌यार युसुफ आपसा पुर्‌या काजे इस्‌राएल्‌यान चां ली ज्‌यु; ने इस्‌राएल्‌यु तीनु काजे गुळु दीन बाथलायु। <verse eid="GEN 48:10" /><verse number="11" style="v" sid="GEN 48:11" />तत्‌यार इस्‌राएल्‌यु युसुफ काजे कह्‌यु, “मे तुसेक देखणेन आस छुड़ देदलु, बाकुन भगवान मारे पर गीण कर्‌यु, ने मे तुसेक बी ने तारा पुर्‌याक बी देख र्‌यु।” <verse eid="GEN 48:11" /><verse number="12" style="v" sid="GEN 48:12" />अळतेन युसुफ तेरा पुर्‌याक याकुबेन खुळा मां सी छेटा कर लेदु, ने अळतेन चु युसुफ आपसा बासेक ढंगु वळीन वांद्‌यु कर्‌यु।<verse eid="GEN 48:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 48:13" />युसुफ आपसा नानला पुर्‌या एप्‌रेम काजे इस्‌राएल्‌यान डाखर्‌या हातेन चां ली ज्‌यु ने आपसा मटला पुर्‌या मनेस्‌या काजे इस्‌राएल्‌यान जेवड़्‌या हातेन चां ली ज्‌यु। <verse eid="GEN 48:13" /><verse number="14" style="v" sid="GEN 48:14" />बाकुन इस्‌राएल्‌यु हात आटवीन जेवड़्‌यु हात नानला पुर्‌या एप्‌रेम पर मेक्‌यु, ने डाखर्‌यु हात मटला पुर्‌या मनेस्‌या पर मेक्‌यु। <verse eid="GEN 48:14" /><verse number="15" style="v" sid="GEN 48:15" />अळतेन इस्‌राएल्‌यु युसुफ काजे संयबरकत आपीन कह्‌यु,</para>
  <para style="q1" vid="GEN 48:15">जीना भगवानेन आपणा आड़ा-बुड़ा अब्‌राहम, ने इसाक भक्‌ती करला,</para>
  <para style="q1" vid="GEN 48:15">हयुत भगवान, मारे पयदा हवणे ती सी हंय लग गुवाळ्‌यु बण्‌यु।<verse eid="GEN 48:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="GEN 48:16" />जु भगवान आपसु सरगेवाळु चाकर्‌यु मकलीन मेसेक आखी कुहराय सी बचाड़्‌यु,</para>
  <para style="q1" vid="GEN 48:16">हंय हीयुत भगवान ईनु पुर्‌या काजे संयबरकत आपे करीन: हंय जे पुर्‌या मारा ने मारा आड़ा-बुड़ा अब्‌राहम ने इसाकेन अवल्‌यात कहवायसे।</para>
  <para style="q1" vid="GEN 48:16">आखी धरती पर हींद्‌री अवल्‌यातेन वेल वद्‌या करे करीन।<verse eid="GEN 48:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 48:17" />याकुब आपसु जेवड़्‌यु हात युसुफेन नानला पुर्‌या एप्‌रेमेन मुणका पर मेकी रहलु, जो देखीन युसुफ काजे वारु नी लाग्‌यो; तेरेमां युसुफ आपसा बासेन जेवड़्‌यु हात एप्‌रेमेन मुणका पर सी हेड़ाय्‌न, मनेस्‌यान मुणका पर मेकाड़नेन वीच्‌यार सी धर लेदु। <verse eid="GEN 48:17" /><verse number="18" style="v" sid="GEN 48:18" />ने युसुफ आपसा बास काजे कह्‌यु, “ए बाबा, आपसु जेवड़्‌यु हात मनेस्‌यान मुणका पर मेक; काहाकी पेहेल-खुळ्‌यु जुत छे।”<verse eid="GEN 48:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 48:19" />बाकुन युसुफेन बास युसुफ काजे कह्‌यु, “बेटा, मेसेक मालम छे की, मट्‌लु मनेस्‌यु छे, ने चु मट्‌लु बणसे। चु बेसका माणसेन डाहलु-बाबु बणसे। बाकुन नानलु भायस एप्‌रेम मटला सी मटु बणसे, ने ईना नानलान घराणो मटलान घराणा सी बेसका हय जासे। ने जु बेसका जातीन बास बण जासे।”<verse eid="GEN 48:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 48:20" />असु करीन तीने दाहड़े इस्‌राएल्‌यु युसुफेन पुर्‌या काजे असी संयबरकत आप्‌यु, “इस्‌राएली जातीन माणसे तुहुंं दुयु काजे नावलीन संयबरकत आपसे, ने तुंद्‌रे वाटे संयबरकत हात करसे। माणसे असी संयबरकत आप्‌या करसे: भगवान तुहुंंक एप्‌रेमेन ने मनेस्‌यान तसा बणावसे।” ने इस्‌राएल्‌यु एप्‌रेम काजे मनेस्‌या सी मटु गीण्‌यु।<verse eid="GEN 48:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 48:21" />अळतेन इस्‌राएल्‌यु युसुफ काजे कह्‌यु, “सामळ, मे मरनेवाळु छे, बाकुन भगवान तुंद्‌रे पुठ्‌ये रवसे, ने तुहुंंक कनान देस मां पछु ली जासे, जो आपणा आड़ा-बुड़ान देस छे। <verse eid="GEN 48:21" /><verse number="22" style="v" sid="GEN 48:22" />मे तारा आखा भायसे काजे ततरी जागा आपलु, तीनी जागा सी एक हीस्‌सु वदु मतलब पली बयड़ा वाळी जागा<note caller="+" style="f"><char style="fr" closed="false">48:22 </char><char style="ft" closed="false">सकेम जागान नाव</char></note> बी तुसेक आपो। जी जागा मे तलवार ने धंदलीन भुरसे एमोरी‌या जातीन माणसे साते लड़ाय करीन तींद्‌रे धड़े सी हापकी लेदलु।”<verse eid="GEN 48:22" /></para>
  <chapter eid="GEN 48" />
  <chapter number="49" style="c" sid="GEN 49" />
  <para style="s">याकुबेन आकरी बुले</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 49:1" />अळतेन याकुब आपसा आखा पुर्‌याक असु कय्‌न बुलायु, “पुर्‌या उरहावु, आवणे वाळा दाहड़ाम तुंद्‌रे साते काय-काय हवसे; चो मे तुहुंंक देखाड़ो।”<verse eid="GEN 49:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="GEN 49:2" />ए मारा पुर्‌या, तुहुंं आखा भेळा हय्‌न सामळु, आपसा बास इस्‌राएल्‌यान वात धीयान सी सामळु।</para>
  <para style="q1" vid="GEN 49:2">याकुब, रुबेन्‌या काजे संयबरकत आपे।<verse eid="GEN 49:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="GEN 49:3" />ए रुबेन, तु ते मारु पेहलु-खुळ्‌यु बेटुस छे।</para>
  <para style="q1" vid="GEN 49:3">तु मारी जुवानीन ताकुतेन पेहलु पुरावु छे।</para>
  <para style="q1" vid="GEN 49:3">आखा भायस सी ईज्‌जत ने ताकुत मां बेसकु वारु छे।<verse eid="GEN 49:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="GEN 49:4" />बाकुन तु ते छीनाळ्‌यु छे। बाकुन तु ते मार लाडी साते सोवसार कर्‌यु;</para>
  <para style="q1" vid="GEN 49:4">ने तारा बासेन खाटलाक वीटाळ देदु ने खाटलान ईज्‌जत नी कर्‌यु।</para>
  <para style="q1" vid="GEN 49:4">तेरेमां तारी ईज्‌जत ने ताकुत दीसरा सी अदु नी रहे।</para>
  <para style="q1" vid="GEN 49:4">याकुब, सीमेन्‌या ने लेव्‌या काजे संयबरकत आपे।<verse eid="GEN 49:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="GEN 49:5" />“ए सीमोन ने लेवी, तुहुंं ते सग्‌गा भायस छे।</para>
  <para style="q1" vid="GEN 49:5">तुहुंं काजे ते तलवार करीन लड़ाय करनु वारु गमे।<verse eid="GEN 49:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="GEN 49:6" />तुहुंं मनेन भुंड्‌ली वात वीच्‌यार्‌या।</para>
  <para style="q1" vid="GEN 49:6">तीनी भुंड्‌ली वात मां, मे नी भेसकायो। मे तुंद्‌री बठक मां नी बठो।</para>
  <para style="q1" vid="GEN 49:6">काहाकी तुहुंं रीसे मां माणसे काजे मार्‌या ने,</para>
  <para style="q1" vid="GEN 49:6">चे आवीन बेल काजे झाटकाय्‌न लंगड़ा कर देदा।<verse eid="GEN 49:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="GEN 49:7" />तुंद्‌री रीसे पर तुंद्‌रे पर गरा छे!</para>
  <para style="q1" vid="GEN 49:7">काहाकी तुहुंं रीसेम गांडवाय गुयला।</para>
  <para style="q1" vid="GEN 49:7">ने तुहुंंक गीण नी आवी। तेरेमां तुंद्‌री अवल्‌यात याकुब सी आंग्‌ये-आंग्‌ये हय जासे,</para>
  <para style="q1" vid="GEN 49:7">ने हव, इस्‌राएल देस मां तुंद्‌री अवल्‌यात रावण्‌या-तीवण्‌या हय जासे।”<verse eid="GEN 49:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="GEN 49:8" />ए यहुदा! तारा भायस तुसेक बेसकु वारु कवसे।</para>
  <para style="q1" vid="GEN 49:8">तु तारा वेरीक जीत लेसी।</para>
  <para style="q1" vid="GEN 49:8">तारा भायस तार सी नानला बणीन रवसे।<verse eid="GEN 49:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="GEN 49:9" />यहुदा तीना जुवान्‌या नाहरेन तसु छे, जु काहानास जानवर काजे मार्‌यु हय।</para>
  <para style="q1" vid="GEN 49:9">ए मारा बेटा, तु तीना नाहरेन तसु छे,</para>
  <para style="q1" vid="GEN 49:9">जु काहानास जानवरेन सीकार करने करीन तकाय रह्‌यु हय।</para>
  <para style="q1" vid="GEN 49:9">सीकार करने करीन तेरु जुर कुण वदाड़ सके?<verse eid="GEN 49:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="GEN 49:10" />यहुदा तारा घराणा मां राज-करन्‌या पयदा हवसे,</para>
  <para style="q1" vid="GEN 49:10">छाचलीन वारु राज-करन्‌या काजे आवता लग,</para>
  <para style="q1" vid="GEN 49:10">तींद्‌रे मां सी राजगादीन सहलाणी नी सरे।</para>
  <para style="q1" vid="GEN 49:10">चु वारु राज-करन्‌यु आवसे ती बेसका माणसे तेरु हुकुम मानसे ने सेवा करसे।<verse eid="GEN 49:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="GEN 49:11" />चु जुवान्‌या गदड़ा काजे अंगुरेन वेले करीन बांदसे।</para>
  <para style="q1" vid="GEN 49:11">ने गदड़ीन पीला काजे वारला अंगुरेन वेले करीन बांदसे।</para>
  <para style="q1" vid="GEN 49:11">चु आपसा पुथल्‌या काजे धुवणे करीन आखा सी वारु अंगुरेन रस वापरसे।<verse eid="GEN 49:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="GEN 49:12" />तेरा डुळा अंगुरेन रस पीणे सी राता रवसे,</para>
  <para style="q1" vid="GEN 49:12">ने तेरा दात दुत पीणे सी धवळा फक हय जासे।<verse eid="GEN 49:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="GEN 49:13" />“ए जबुलुन तु दरीया धड़े रय्‌स,</para>
  <para style="q1" vid="GEN 49:13">ने दरीया धड़े वाळु जागु ढंड्‌यान ठेसण बणसे,</para>
  <para style="q1" vid="GEN 49:13">ने तारी वस्‌तीन छेव सीदोन देस लग रवसे।”<verse eid="GEN 49:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="GEN 49:14" />“ए ईस्‌साकार्‌या, तु तीना गदड़ान तसु छे,</para>
  <para style="q1" vid="GEN 49:14">जो काठी मेहनत करे। बाकुन हारी पड़ीन जानवर्‌यान वाड़ा मां आडु पड़ रवे।<verse eid="GEN 49:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="GEN 49:15" />जत्‌यार तु देखीस की, मारु आराम करनेन जागु वारु छे,</para>
  <para style="q1" vid="GEN 49:15">ने कमायणेन जागा बी बेसकी वारु छे।</para>
  <para style="q1" vid="GEN 49:15">तत्‌यार तु भार हाकलने करीन तीयार हय जासी।</para>
  <para style="q1" vid="GEN 49:15">ने पावरेन काम करने वाटे गुलाम बण ज्‌यु।”<verse eid="GEN 49:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="GEN 49:16" />ए दान, तु बी इस्‌राएली जातीन एक कुळी बणसी,</para>
  <para style="q1" vid="GEN 49:16">ने आपसा जाती-भायन नीयाव करसी।<verse eid="GEN 49:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="GEN 49:17" />ए दान, तु वाट धड़े वाळा घड़सान तसु हवसी,</para>
  <para style="q1" vid="GEN 49:17">ने वाटे धड़े वाळा फेण वाळा घड़सान तसु बणसी,</para>
  <para style="q1" vid="GEN 49:17">जु फेण वाळु घड़सु घुल्‌लान पाय झुल देसे,</para>
  <para style="q1" vid="GEN 49:17">ने घुल्‌ला पर सवारी करन्‌यु घुल्‌ला पर सी पछ मुंड्‌या हीट पड़े।<verse eid="GEN 49:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="GEN 49:18" />“ए यहोवा भगवान, मे तारे सीत छुटकारु हात करनेन वाट देख र्‌यु।”<verse eid="GEN 49:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="GEN 49:19" />“ए गाद, तारे भीणी डाकुन एक टुळु आवसे, बाकुन तु तीना डाकुन टुळा काजे हुहड़ीन ढासाड़ दीस।”</para>
  <para style="q1" vid="GEN 49:19">याकुब, आसेर्‌या काजे संयबरकत आपे।<verse eid="GEN 49:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="GEN 49:20" />“ए आसेर, तारा देस मां अन वारु पाकसे,</para>
  <para style="q1" vid="GEN 49:20">ने तु राजा काजे सवादो खाणो खावाड़सी।”<verse eid="GEN 49:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="GEN 49:21" />“ए नप्‌ताली, तु छुटली हयणीन तसु छे,</para>
  <para style="q1" vid="GEN 49:21">ने तु वारु सुवाळी वात करे।”<verse eid="GEN 49:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="GEN 49:22" />“ए युसुफ, तु वारु फळन्‌या अंगुरेन वेलान तसु छे, हव, तु झीरे धड़े उगाड़ला अंगुरेन वेलान तसु छे;</para>
  <para style="q1" vid="GEN 49:22">जु वेलु, वाड़्‌ये लागीन चहड़ रयु।<verse eid="GEN 49:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="GEN 49:23" />धंदली-बील्‌खा वाळा वेरी तारे भीणी हुड़दीन आया,</para>
  <para style="q1" vid="GEN 49:23">चे तुसेक मारने करीन धंदली-बील्‌खा लीन पुठ्‌ये पड़्‌या।<verse eid="GEN 49:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="GEN 49:24" />बाकुन याकुबेन जुर भर्‌यु भगवान तारा हात काठा कर देदु,</para>
  <para style="q1" vid="GEN 49:24">याकुबेन कुळीन गुवाळ्‌यु, जु इस्‌राएली माणसे वाटे ढाटा सारकु छे,</para>
  <para style="q1" vid="GEN 49:24">चु तारी अगवाय करीन राखवाळी कर्‌यु।</para>
  <para style="q1" vid="GEN 49:24">तेरेमां तारी धंदली वारु काठी रय ने तुसेक सक्‌ती जड़ी, तेरे साहरे तु लड़ाय मां जीत गुयु।<verse eid="GEN 49:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="GEN 49:25" />मारु भगवान सक्‌ती आपीन तारी मदत करसे।</para>
  <para style="q1" vid="GEN 49:25">चु भगवान तुसेक वादळान पाणीन संयबरकत आपसे,</para>
  <para style="q1" vid="GEN 49:25">ने चु तुसेक धरतीन उंडा वाळा पाणीन संयबरकत आपसे।</para>
  <para style="q1" vid="GEN 49:25">ने तुंद्‌रा बायरा ने पाळन्‌या जानवर्‌यान अवल्‌यात आपीन संयबरकत आपसे,</para>
  <para style="q1" vid="GEN 49:25">ने तींद्‌रा धादीम दुत आपीन संयबरकत आपसे।”<verse eid="GEN 49:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="GEN 49:26" />तारा बासेन संयबरकत, आपणा आड़ा-बुड़ान संयबरकत सी वदीन छे,</para>
  <para style="q1" vid="GEN 49:26">ने ची संयबरकत जलम टेकला बयड़ाम सी,</para>
  <para style="q1" vid="GEN 49:26">ने उचला बयड़ाम सी आवणी संयबरकत सी वदीन छे।</para>
  <para style="q1" vid="GEN 49:26">तु ते तारा भाय सी बेसकु-छेक्‌तु छे;</para>
  <para style="q1" vid="GEN 49:26">तेरेमां जी आखी संयबरकत तारा मुणका पर पागड़ीन तसी रवसे।<verse eid="GEN 49:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="GEN 49:27" />“ए बीन्‌यामीन, तु ने तारी अवल्‌यात तीनु तातड़ीन-खाण्‌या लेंड्‌यान तसु छे,</para>
  <para style="q1" vid="GEN 49:27">जे संदारे ते सीकार करलो खाय, बाकुन सांती वेळाय बचलो वाटीन खाय लेय।”<verse eid="GEN 49:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="GEN 49:28" />इस्‌राएल्‌यान बारे पुर्‌यान बारे कुळी जीत छे: जी संयबरकत तींद्‌रे वाटे वारु हतली; चीत संयबरकत चु एकेक जणाक आपलु।<verse eid="GEN 49:28" /></para>
  <para style="s">याकुबेन मरनु ने गाड़ाय जाणु</para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 49:29" />अळतेन इस्‌राएल्‌यु, आपसा पुर्‌या काजे हुकुम आपीन कह्‌यु, “मे मरीन छाटुत आपणा मर्‌या-सर्‌या आड़ा-बुड़ा मां भेसकाय जायस। ती तुहुंं मारा धड़ काजे हीत्‌ती जातीन एपरोन नावेन माणसेन खेते धड़े वाळा खंगरा मां गाड़जु, जां आपणा मर्‌या-सर्‌या आड़ा-बुड़ा काजे गाड़ला छे। <verse eid="GEN 49:29" /><verse number="30" style="v" sid="GEN 49:30" />चु खंगरु मम्‌रे नावेन जागान उगेवणु छे, ने मकपेला नावेन खंगरा वाळा खेत मां छे। ने चो खेत कनान देस मां छे। अब्‌राहम चो खेत हीत्‌ती जातीन एपरोन नावेन माणसे जुळ बीड़ा बणावणे करीन मुल लेदलु। <verse eid="GEN 49:30" /><verse number="31" style="v" sid="GEN 49:31" />चां मारा डाहला-बास अब्‌राहमेन धड़ काजे, ने मारी डाहली-आया सारान धड़ काजे गाड़ला; ने चांत मारा बास इसाकेन धड़ काजे, ने मारी माय्‌न रीबकान धड़ काजे बी गाड़ला; ने चांत मे मारी घरवाळी लीयान धड़ काजे बी गाड़लु। <verse eid="GEN 49:31" /><verse number="32" style="v" sid="GEN 49:32" />चु खंगरु तीना खेतेम छे, तीना खेत काजे डाहलु-बास अब्‌राहम्‌यु हीत्‌या जातीन माणसे भीणी सी मुल लेदलु। मे मरीस ती मारा धड़ेक चांत ली जाय्‌न गाड़जु।” <verse eid="GEN 49:32" /><verse number="33" style="v" sid="GEN 49:33" />याकुब आपसा पुर्‌या काजे हुकुम आप देदु, ने अळतेन चु खाटला पर सुय ज्‌यु, ने कुचण्‌या वळ्‌यु, ने तेरु जीव छांड ज्‌यु, ने तेरु जीव मर्‌या-सर्‌या आड़ा-बुड़ाम जाय्‌न भेसकाय ज्‌यु<verse eid="GEN 49:33" /></para>
  <chapter eid="GEN 49" />
  <chapter number="50" style="c" sid="GEN 50" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 50:1" />युसुफ आपसा बासेन धड़ पर आड़ा पड़ीन ढळो-ढळो ने फुको-फुको रड़्‌यु, ने तीना धड़ेन गुळु देदु। <verse eid="GEN 50:1" /><verse number="2" style="v" sid="GEN 50:2" />अळतेन युसुफ दाक्‌तर्‌याम ने मरलान रीती-भाती करीन धड़ेक चतराये मेलन्‌या काजे हुकुम आप्‌यु की, “तुहुंं बाबान धड़ेक गाड़नेन तीयारी करु।” ने चे मीसर देसेन रीतीन अनसारे तीना धड़ेक गाड़नेन तीयार कर्‌या। <verse eid="GEN 50:2" /><verse number="3" style="v" sid="GEN 50:3" />मीसर देसेन रीतीन अनसारे चाळीस दाहड़ा लग चे दाक्‌तर्‌याम धड़ मां गंदायण्‌यु-मसालु ने गंदायण्‌यो-तेल भर्‌या। ने मीसर देसेन माणसे सत्‌तर दाहड़ा लग याकुबेन करता ढळो-ढळो रड़ता-कलेपता रह्‌या।<verse eid="GEN 50:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 50:4" />रड़ने-कलेपणेन सत्‌तर दाहड़ा वीत ज्‌या, ती युसुफ फीरोन राजान घराणान माणसे काजे कह्‌यु, “कदीक तुहुंं मारे पर गीण करता हय, ती मारी जी वात फीरोन राजान चां जाय्‌न देखाड़ देवु की, <verse eid="GEN 50:4" /><verse number="5" style="v" sid="GEN 50:5" />‘मारु बास मरने वेळा जी सगुन खादलु की, जत्‌यार मे मरीस ती मारा धड़ काजे तीना बीड़ा मां गाड़जु, जो बीड़ो, मे कनान देस मां खुदाड़लु छे।’ तेरेमां मेसे काजे तीना बीड़ा मां मारा बाबान धड़ गाड़नेन हुकुम आप। ने मे धड़ गाड़ीन पछु आवती रय्‌स।”<verse eid="GEN 50:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 50:6" />चे जी वात राजाक देखाड़्‌या, ती फीरोन राजु आवीन युसुफ कह्‌यु, “जा, तारु बास जसु तुसेक सगुन भरीन कहलु छे तसुत तु तारा बासेन धड़ काजे गाड़ दे।”<verse eid="GEN 50:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 50:7" />तेरेमां युसुफ आपसा बासेन धड़ लीन गाड़ने करीन कनान देस मां जाणे बाजी ज्‌यु। ने युसुफ साते फीरोन राजान हकदार्‌या, ने राजान घराणान आखा मुख्‌या, ने मीसर देसेन आखा डाहला माणसे बी पुठी गुया। <verse eid="GEN 50:7" /><verse number="8" style="v" sid="GEN 50:8" />युसुफेन घराणान आखा माणसे, ने तेरा भायस, ने तेरा बासेन घरेन आखा माणसे बी युसुफ पुठ्‌ये गुया; बाकुन चे पुर्‌या-पारी काजे, ने गाडराक ने बुकड़ा काजे, ने गावड़ी ने बेल काजे गोसेन नावेन जीला मांत मेल दीन जाती र्‌या <verse eid="GEN 50:8" /><verse number="9" style="v" sid="GEN 50:9" />युसुफ पुठ्‌ये सीपायड़ा बी घुड़ा-गाडी पर ने घुल्‌ला पर बसीन गुया। तसा करीन बेसका डाग्‌या हय ज्‌या।<verse eid="GEN 50:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 50:10" />अळतेन याकुबेन डाग्‌या यरदन नदी काजे एणकीन आताद नावेन मटला खळा मां पुग्‌या, ती चे चां फुको-फुको ने ढळो-ढळो रड़्‌या-कलप्‌या, ने युसुफ सात दाहड़ा लग फुको-फुको रड़तु-कलेपतु जाय्‌न आपसा बासेन डागेन रीती-भाती कराड़्‌यु। <verse eid="GEN 50:10" /><verse number="11" style="v" sid="GEN 50:11" />मीसर देसेन माणसेक फुको-फुको रड़तेला-कलेपतेला सामळीन चां आताद नावेन मटला खळान आड़े-धड़े रहण्‌या कनानी जातीन माणसे कह्‌या, “जो ते मीसर देसेन माणसेन फुको-फुको रड़नु-कलेपणु हसे।” ने तीना जागान नाव आबेल-मीसरेम पड़ ज्‌यो। ईब्‌रानीयो बुली मां एरो मतलब मीसर्‌या माणसेन फुको-फुको रड़नु-कलेपणु छे। जु जागु यरदन नदीन पली धड़े कनान देस मां छे।<verse eid="GEN 50:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 50:12" />इस्‌राएलेन पुर्‌या वारु चत काम कर्‌या, चु तीनुक हुकुम आपलु। <verse eid="GEN 50:12" /><verse number="13" style="v" sid="GEN 50:13" />अळतेन चे तीनाक कनान देस मां ली जाय्‌न मकपेला जागा वाळी गुफा मां मम्‌रे नावेन जागा अगळ छे। जु अब्‌राहम हीत्‌ती एपरोन सी मुल लेदु की चु कबर वाटे हेरी खुदेन जागा हवे। <verse eid="GEN 50:13" /><verse number="14" style="v" sid="GEN 50:14" />चां युसुफ आपसा याकुबेन धड़ काजे वगे करीन आपसा भायसे भेळे, ने जतरा बी डाग्‌या गुयला तींद्‌रे भेळे मीसर देस मां पछु आवती र्‌यु।<verse eid="GEN 50:14" /></para>
  <para style="s">युसुफ आपणा भायसे काजे दीलासु आपे</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 50:15" />याकुबेन धड़ वगे करी आया ने अळतेन युसुफेन भायस असा वीच्‌यार करीन फीकुर मां पड़ ज्‌या की, कांखुर माय्‌न युसुफ हंय हामरे पर कीचवायसे, ने हामु तेरे पर जी बी कुहराय करला छे, तेरु बदलु हामरे सी लेसे। <verse eid="GEN 50:15" /><verse number="16" style="v" sid="GEN 50:16" />तेरेमां चे युसुफेन चां असो कय मकल्‌या, “आपणु बास मरनेन पेहले हामुक जु हुकुम आपलु की, <verse eid="GEN 50:16" /><verse number="17" style="v" sid="GEN 50:17" />तुहुंं युसुफ काजे कवजु की, हामरा गुनान ने पापेन माफी हामुक आप दे, काहाकी हामु तारे पर कुहराय करला छे। तेरेमां तु, हामुक, हामरा पाप-गुनान माफी आप दे, हामु ते आपणा बासेन भगवानेन, गुलाम पावर्‌या छे।” तींद्‌री जी वात सामळीन युसुफ फुको-फुको रड़ने बाजी गुयु।<verse eid="GEN 50:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 50:18" />अळतेन युसुफेन आखा भायस युसुफेन चां जाय्‌न तेरे अगळ उबडु पड़्‌या। ने कह्‌या, “हामु ते तारा गुलाम पावर्‌या छे।”<verse eid="GEN 50:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 50:19" />बाकुन युसुफ तीनु काजे कह्‌यु, “मारे सी मां बीहु! मे डंड आपण्‌यु भगवान छे काय? <verse eid="GEN 50:19" /><verse number="20" style="v" sid="GEN 50:20" />तुहुंं ते कुहराये जाळसांदी बणावला; बाकुन भगवान ईनी वात मां बी भलायन वीच्‌यार बणाय रहलु। ने भगवानेन वीच्‌यार बेसका माणसेन जीव बचाड़नेन हतलु। ने देखु, तसोत हय-ज्‌यो ने आज तुहुंं जीवतेला छे। <verse eid="GEN 50:20" /><verse number="21" style="v" sid="GEN 50:21" />तेरेमां मे एक कावा अळी कहं, मारे सी मां बीहु! मे तुंद्‌रे वाटे ने तुंद्‌रा पुर्‌या-पारी वाटे खाणे-पीणेन तज्‌बु करीन पुसतु रय्‌स।” तसु करीन युसुफ तींद्‌रे साते परम मां भरायन वात कर्‌यु ने हिम्‌मत आप्‌यु।<verse eid="GEN 50:21" /></para>
  <para style="s">युसुफेन मुत</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 50:22" />युसुफ आपसा बासेन घराणा भेळे मीसर देस मां रह्‌यु। ने युसुफ एक सव दस साल लग जीवतु रह्‌यु। <verse eid="GEN 50:22" /><verse number="23" style="v" sid="GEN 50:23" />ने युसुफ एप्‌रेमेन तीसरी पीड़ी मतलब एप्‌रेमेन पुर्‌यान-पुर्‌या काजे लग देख्‌यु। ने मनेस्‌यान पुर्‌या काजे जु माकीरेन पुर्‌या हतला, चे पयदा हया ने युसुफ आपसा खुळा मां खेलाड़्‌यु। <verse eid="GEN 50:23" /><verse number="24" style="v" sid="GEN 50:24" />युसुफ आपसा भाय काजे कह्‌यु, “मे ते मरनेवाळु छे, बाकुन भगवान तुहुंं काजे हेर करीन तुंद्‌रे पर गीण करसे, ने तुहुंं काजे ईना देसेम सी नीकाळीन तीना देस मां पुगाड़ देसे, जो देस चु अब्‌राहम काजे, ने इसाक काजे, ने याकुब काजे आपणेन बुली करलु।” <verse eid="GEN 50:24" /><verse number="25" style="v" sid="GEN 50:25" />युसुफ आपसा भाय काजे कह्‌यु, “मे ते मरनेवाळु छे, बाकुन भगवान तुहुंं काजे हेर करीन तुंद्‌रे पर गीण करसे, ने तुहुंं काजे ईना देसेम सी नीकाळीन तीना देस मां पुगाड़ देसे, जो देस चु अब्‌राहम काजे, ने इसाक काजे, ने याकुब काजे आपणेन बुली करलु।” <verse eid="GEN 50:25" /><verse number="26" style="v" sid="GEN 50:26" />तसु करीन युसुफ एक-सव-दस साल लग जीवीन मर गुयु। ने युसुफेन धड़ काजे गंदायण्‌यु-मसालु ने गंदायण्‌यो तेल लागाड़ीन तीयार कर्‌या। ने चे मीसर देस मां, तेरा धड़ काजे पेटी मां मेल देदा।<verse eid="GEN 50:26" /></para>
  <chapter eid="GEN 50" />
</usx>