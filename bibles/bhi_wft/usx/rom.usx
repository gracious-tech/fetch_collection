<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ROM" style="id">- Bhilali Standard Project</book>
  <para style="h">रोमी</para>
  <para style="toc3">रोमी</para>
  <para style="toc2">रोमी</para>
  <para style="toc1">रोमीन मंडळी वाटे पोलुसेन चिट्‌ठी</para>
  <para style="mt2">रोमियों की कलिसीया के लिए पौलुस की पत्री</para>
  <para style="mt1">रोमीन मंडळी वाटे पोलुसेन चिट्‌ठी</para>
  <para style="imt">रोमीन बारामां</para>
  <para style="ip">रोमेन किताप नेवताळु पोलुस धड़े-वड़े 54-58 सालेन ईचमां ईसु मसीन पयदा हवणेन पछे लिखली हतली पोलुस रोमनेन चाल सी पेहल हयु जी चिट्‌ठी रोम मां भुरसु करने वाळा साते समजाड़ने वाटे मकल्‌यु जे की दुयु यहुदी ने नी-यहुदी वाटे हयु कुरींथी सहर सी जी चिट्‌ठी लिखलु हतलु जां चु हीनी टेमे चां रय रवलु पोलुस जी चिट्‌ठी हेरे सी लिखलु काहाकी आखा देसेन माणसे ईसु मसी पर भुरसु करीन मान सके। <char style="xt"><ref loc="ROM 16:26">16:26</ref></char></para>
  <para style="ip">रोमेन किताप आखी जागा ने आखी टेम भुरसु करने वाळा माणसे वाटे जरुड़ी किताप छे काहाकी पोलुस साप-साप ने वारु तरह सी समजाड़्‌यु की आपणु ईसु मसीन साहरे छुटकारु हय सके पोलुस ईसु मसीन खुस-खबर काजे जुन्‌ला नीयम सी बी जड़्‌यु काय पुजारा बी वीच्‌यार करला छे की किताप मां आखी सी जरुड़ी बुल <char style="xt"><ref loc="ROM 1:16">1:16</ref></char> छे जी कवे मेसे खुस-खबर सी कुय सरम नी हय काहाकी ज आखा वाटे भुरसु करे हींद्‌रे वाटे छुटकारु भगवानेन ताकत छे पेहल यहुदी वाटे अळतेन नी-यहुदी वाटे रोमेन पेहलु भाग <char style="xt"><ref loc="ROM 1:12">1:12</ref></char> उंडाय सी धरम सास्‌तुर छे ने दीसरु भाग (13-15) मां सी मसी जीवन वाटे वेहवार सी समजाड़नु छे।</para>
  <para style="iot">बाहरती वात</para>
  <para style="io1">1. पोलुस आपणी चिट्‌ठी मामुली रुप सी खुदेन बारामां बताड़तु जाय्‌न सुरु करे की चु कुणीक लिख रयु। <char style="ior"><ref loc="ROM 1:1-15">1:1-15</ref></char></para>
  <para style="io1">2. हेरे पछेन चु ईसु मसी ईचमां सी माणुस जातीन दसा ने वीच्‌यारीन छुटकारान बारामां लिखलो छे। <char style="ior"><ref loc="ROM 1:16-11:36">1:16—11:36</ref></char></para>
  <para style="io1">3. हेरे पछेन पोलुस मसी जीवन जीवणे वाटे काय वेहवार सी समजाड़्‌यु। <char style="ior"><ref loc="ROM 12:1-15:13">12:1—15:13</ref></char></para>
  <para style="io1">4. चु रोमन मंडळी मां माणसे काजे काय वारु छे की कय्‌न रोमेन किताप लिखीन सार देदु। <char style="ior"><ref loc="ROM 16">16</ref></char></para>
  <chapter number="1" style="c" sid="ROM 1"/>
  <para style="s">आव-भाव करनु</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 1:1"/>पोलुस भीणी सी जु ईसु मसीन पावर्‌यु छे, ने नेवताळु हवणे करीन बुलावलु छे, ने भगवान तीना खुस-खबर वाटे नेवाड़लु छे।<verse eid="ROM 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ROM 1:2"/>तेरी चु पेहलुत सी आपणी भगवानेन अघी सी आवणे वाळी वात देखाड़न्‌यान साहरे चुखला<note caller="+" style="f"><char style="fr" closed="false">1:2 </char><char style="ft" closed="false">पवित्र चुखो</char></note> सास्‌तुर मां, वायदु करलु हतलु। <verse eid="ROM 1:2"/><verse number="3" style="v" sid="ROM 1:3"/>गुयु हेरु पुर्‌या काजे आपणा मालीक ईसु मसीन बारामां आस लागाड़्‌यु; चु डीलेन भाव सी ते दावुदेन खानदानी<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false">वंशखानदानी</char></note> सी पयदा हयु <verse eid="ROM 1:3"/><verse number="4" style="v" sid="ROM 1:4"/>ने चुखली-आत्‌मान भाव सी ईसु मरलाम सी जीवतु हवणेन वजे सी ताकुतेन साते भगवानेन पुर्‌यु ठेहरलु छे। <verse eid="ROM 1:4"/><verse number="5" style="v" sid="ROM 1:5"/>हेरे साहरे आपणु काजे बेसकी वारु दया ने नेवताळा बननेन मुखु जड़्‌यु हेरा नावेन वजे सी आखा नी-यहुदी माणसे भुरसु करीन हेरी माने, <verse eid="ROM 1:5"/><verse number="6" style="v" sid="ROM 1:6"/>तेरेमां तुहुं बी ईसु मसीन हवणे वाटे बुलावला छे।<verse eid="ROM 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 1:7"/>तीनु आखान नाव जे रोम मां भगवानेन लाटेक्‌ला छे ने चुखला हवणे वाटे बुलावला छे:</para>
  <para style="p" vid="ROM 1:7">आपणु बास भगवान ने मालीक ईसु मसी भीणी सी तुहुं काजे गीण-दया ने सांती जड़ती रवे।<verse eid="ROM 1:7"/></para>
  <para style="s">तु बेसकु वारु छे करीन दुवा</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 1:8"/>पेहेल मे तुहुं आखा वाटे ईसु मसीन साहरे आपणा भगवान काजे तु बेसकु वारु छे करीन कहुं, काहाकी तुंद्‌रा भुरसान वात आखा कळी मां हय रय <verse eid="ROM 1:8"/><verse number="9" style="v" sid="ROM 1:9"/>भगवान तेरी चाकरी मे आपणी आत्‌मा सी हेरा पुर्‌यान खुस-खबरेन बारामां करो, हयुत मारु गवा छे की मे तुहुं काजे काहनी रीत सी लगातार हेर करतु रव, <verse eid="ROM 1:9"/><verse number="10" style="v" sid="ROM 1:10"/>ने जलम असु वीन्‌ती करो की भगवानेन मरजी सी काहली-ने-काहली रीत सी मेसे आकरी मां तुंद्‌रे धड़े आवणे वारु मुखु जड़े। <verse eid="ROM 1:10"/><verse number="11" style="v" sid="ROM 1:11"/>काहाकी मे तुंद्‌रे सी भेळु हवणेन लालुच करो की मे तुहुं काजे कुय जीव-आत्‌मान वाटु आपो तेरे सी तुहुं काठा हय जावु; <verse eid="ROM 1:11"/><verse number="12" style="v" sid="ROM 1:12"/>अळतेन ज की जत्‌यार मे तुंद्‌रे ईचमां रवो, ती हामु तीना भुरसान साहरे ज हामरे मां, ने तुंद्‌रे मां छे एक दीसरा सी वात वीच्‌यार जड़े।<verse eid="ROM 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 1:13"/>ए भायसे, मे नी चाहतु की तुहुं हेरे सी अणजाण्‌या रवु की मे काय कावा तुंद्‌रे धड़े आवणे चाह, की जसा मेसे नी-यहुदी नी जाणे तीनी जाती मां फळ जड़्‌यो, असात तुंद्‌रे मां बी जड़से, बाकुन हय लग रुकायलो छे। <verse eid="ROM 1:13"/><verse number="14" style="v" sid="ROM 1:14"/>मारे पर युनानी माणसेन ने नी-यहुदी, ने अक्‌कल वाळा ने डेड़-अकल्‌या माणसेन करजु छे। <verse eid="ROM 1:14"/><verse number="15" style="v" sid="ROM 1:15"/>अळतेन मे तुहुंक बी जे रोम मां रवु, खुस-खबर सामळवणे करीन काहाली बी टेम मां तीयार छे।<verse eid="ROM 1:15"/></para>
  <para style="s">खुस-खबरेन ताकत</para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 1:16"/>काहाकी मे खुस-खबर सी नी सरमांयो, हेरे सी की चु आखा जणा जे भुरसु करने वाळा वाटे, पेहेल ते यहुदी अळतेन नी-यहुदी वाटे, छुटकारान करीन भगवानेन ताकत छे। <verse eid="ROM 1:16"/><verse number="17" style="v" sid="ROM 1:17"/>काहाकी हेरे मां भगवानेन वारलु भुरसा सी ने भुरसा वाटे देखाये; जसों लिखलो छे, “भुरसा सी वारलु माणसे जीवता रवसे।”<verse eid="ROM 1:17"/></para>
  <para style="s">माणुस जातीन पाप</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 1:18"/>भगवानेन रीस ते तीनु माणसे आखी नी भक्‌ती ने पाप पर चाले सरगे सी पड़से ज छाचाय्‌न वात काजे पाप करीन चीपदीन राखे। <verse eid="ROM 1:18"/><verse number="19" style="v" sid="ROM 1:19"/>हेरेसी की भगवानेन बारामां अक्‌कल हींद्‌रे मने मां देखायसे, काहाकी भगवान हींद्‌रे बारामां बताड़लु छे। <verse eid="ROM 1:19"/><verse number="20" style="v" sid="ROM 1:20"/>जत्‌यार सी कळी बणी हेरी नी-देखाय असली खास जलमेन ताकत ने भगवानेन गुण साप देखाये काहाकी हीनु चीजे सी पुरी रीती सी जाणी जाय सके जी भगवान बणावलु छे हेरेसी माणसे भीणी काय बाहनो नी हय। <verse eid="ROM 1:20"/><verse number="21" style="v" sid="ROM 1:21"/>हेरे वजे सी चे भगवान काजे जाणे तेबी चे भगवानेन जसी बड़ाय करनु चाहजे बाकुन तसी बड़ाय नी कर्‌या ने जसा भगवान काजे तु बेसकु वारु छे करीन कहंणु चाहजे तसा नी कह्‌या, बाकुन असलात वीच्‌यार करने बाजी गुया, जां लग की तींद्‌रा डेड़-अकल्‌या मन आंदारलो हय गुयो। <verse eid="ROM 1:21"/><verse number="22" style="v" sid="ROM 1:22"/>चे आपसा काजे अक्‌कल वाळा समजीन डेड़-अकल्‌या बण गुया, <verse eid="ROM 1:22"/><verse number="23" style="v" sid="ROM 1:23"/>ने जलम लग भगवानेन सेक-सींगार काजे माणसेन सीकु, ने चिरलान सीकु, ने चार पाया जनवार्‌यान सीकु, ने घीसड़ायन्‌या जनवार्‌यान सीकु समजीन तींद्‌री पुजा-पाट करने बाजी गुया।<verse eid="ROM 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 1:24"/>हेरे वजे सी भगवान बी तीनुक हींद्‌रे मनेन हरेन अनसारे वीटळने करीन छुड़ देदु की चे एक दीसरान डीलेन अबरु नी करे। <verse eid="ROM 1:24"/><verse number="25" style="v" sid="ROM 1:25"/>काहाकी चे भगवानेन छाचाय काजे झुट साते भेसकी देदा, ने कळीन उपास ने चाकरी, ने पुजा-पाट सुरु कर देदा बाकुन कळ काजे घड़न्‌या भगवानेन भक्‌ती ने पुजा-पाट नी कर्‌या। भगवान जलम बेसका वारु छे! असोत हवतो रवे।<verse eid="ROM 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 1:26"/>हेरेसी भगवान बी तीनु काजे गांडा हरेन हक मां रवणी देदु; जां लग की बायरा साते सवसार करने बाजी गुया। <verse eid="ROM 1:26"/><verse number="27" style="v" sid="ROM 1:27"/>ने अदमी बायरा साते सवसार करने रहणीदीन ने अदमी-अदमी साते सवसार करने ने कराड़ने ने चे चंगलाय ने सवसार करने हायाळ्‌ळा बण गुया। तीनुक बे सरम्‌या पापेन डंड, आपसा डील मां जीवतेला काजे भुकेतणु पड़्‌यो।<verse eid="ROM 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 1:28"/>जत्‌यार चे भगवान काजे उळखणे नी हींडतेला, भगवान बी तीनु काजे हींद्‌रे भुंडले मनेन वजे सी रवणी देदु की चे जे कामे चे नी करनु चाहजे असला काम करने बाजी गुया। <verse eid="ROM 1:28"/><verse number="29" style="v" sid="ROM 1:29"/>चे आखी तरान वारलु काम नी करन्‌या ने पाप ने हाय-हाय ने कुहरायन वीच्‌यार सी भराय गुया, ने मनेन काट खुन ने झगड़ा, ने ठगणे वाळा भुंड्‌ला वीच्‌यार सी भराय गुया ने एक दीसरान चुगली करने बाजी गुया ने चे जलम दीसरान नुकसाण हवणु चाहजे करीन असात वीच्‌यार कर्‌या करे, <verse eid="ROM 1:29"/><verse number="30" style="v" sid="ROM 1:30"/>ने चे दीसरान असलात नाव-बद्‌दी करन्‌या, ने भगवान सी रीस करने वाळा, दीसरान अबरु लेण्‌या, ने मटाय कर्‌या, मट्‌ली-मट्‌ली आपरन्‌या, ने कुहरायन वात करने वाळा, आस्‌या-बास्‌यान हुकुम नी मान्‌या, <verse eid="ROM 1:30"/><verse number="31" style="v" sid="ROM 1:31"/>डेड़-अकल्‌या, धुकु देण्‌या, दया नी करन्‌या ने दया करने मां लुला बण गुया। <verse eid="ROM 1:31"/><verse number="32" style="v" sid="ROM 1:32"/>चे ते भगवानेन जी रीती जाणे की असला काम करने वाळा काजे मुतेन डंड जड़से, ने आपसात असलो काम करे ने ज असला कामे करे तीनु काजे तु बेसकु वारु करीन बी कह्‌या।<verse eid="ROM 1:32"/></para>
  <chapter eid="ROM 1"/>
  <chapter number="2" style="c" sid="ROM 2"/>
  <para style="s">भगवानेन नीयाव</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 2:1"/>हेरेसी ए दीसरान वाक नीकाळन्‌या, तु काहनु बी हय, तुसेक जपाप नी देवाये; काहाकी तु तीनी वात मां दीसरान वाक नीकाळे तीनीत वात मां तारु बी वाक छे, तेरेमां की तु तीनीत वात मां वाक नीकाळे चेत गलत काम करे। <verse eid="ROM 2:1"/><verse number="2" style="v" sid="ROM 2:2"/>काहाकी आपणु काजे मालम छे की छाचला-छाचला गलत काम करने वाळा पर भगवान भीणी सी छाचला-छाचला टेम मां डंडेन हुकुम जड़से। <verse eid="ROM 2:2"/><verse number="3" style="v" sid="ROM 2:3"/>ए माणुस, तु ज असला-असला गलत कामे करने वाळान वाक नीकाळे<note caller="+" style="f"><char style="fr" closed="false">2:3 </char><char style="ft" closed="false">दोष लगाना</char></note> ने आपसुत असला गलत काम करे; ती तु ज समजी र्‌यु काय की मे भगवानेन नीयावेन डंड सी बची जायस? <verse eid="ROM 2:3"/><verse number="4" style="v" sid="ROM 2:4"/>काय तु भगवानेन भलाय, ने तेरो सहणु, तेरी सेण काजे असलुत समजी र्‌यु काय? ने तुसेक जी वात नी समज मां आवती काय की तेरी मट्‌ली दया पाप भीणी सी मन फीरावणे करीन सीकाड़े? <verse eid="ROM 2:4"/><verse number="5" style="v" sid="ROM 2:5"/>बाकुन तु आपणा काठला ने कदी नी पसतावु करने वाळा मनेन वजे सी हेरे रीसेन दाहड़ा वाटे, तेरेमां भगवानेन छाचला नीयाव आवसे, तारे वाटे रीस कमाय र्‌यु। <verse eid="ROM 2:5"/><verse number="6" style="v" sid="ROM 2:6"/>चु एक-एक काजे तींद्‌रा कामेन अनसारे बदलु आपसे। <verse eid="ROM 2:6"/><verse number="7" style="v" sid="ROM 2:7"/>जे भगवान काजे वारु गमे असो काम काठु रवीन सेक-सींगार, ने आव-भाव, ने अमरेन जीवन काजे हेरसे, तीनु काजे चु जलमेन जीवन आपसे; <verse eid="ROM 2:7"/><verse number="8" style="v" sid="ROM 2:8"/>बाकुन जे झगड़ा वाळा छे ने छाचाय काजे नी माने बाकुन पाप जाणे हींद्‌रे पर रीस लागसे। <verse eid="ROM 2:8"/><verse number="9" style="v" sid="ROM 2:9"/>दुख ने गरा एकेक माणसेन जीव पर चे भुंडात काम करे तींद्‌रे पर आवसे, पेहेल यहुदी पर अळतेन नी-यहुदी पर; <verse eid="ROM 2:9"/><verse number="10" style="v" sid="ROM 2:10"/>बाकुन सेक-सींगार ने आव-भाव ने वारलु सांती एकेक काजे जड़से, जे वारु करसे, पेहेल यहुदी काजे अळतेन नी-यहुदी काजे। <verse eid="ROM 2:10"/><verse number="11" style="v" sid="ROM 2:11"/>काहाकी भगवान काहनान बी छीट राखीन कुयन नीयाव नी करे।<verse eid="ROM 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 2:12"/>हेरेसी जीनु काजे मुसान साहरे लिखलु कायदु नी जड़्‌यु, पाप कर्‌या चे मुसान साहरे लिखला कायदा पाखुर सरी जासे; ने जीनु काजे मुसान कायदु जड़्‌यु ने पाप कर्‌या, तीनु काजे कायदान अनसारे डंड जड़से; <verse eid="ROM 2:12"/><verse number="13" style="v" sid="ROM 2:13"/>काहाकी भगवानेन चां मुसान साहरे लिखला कायदा काजे सामळने वाळा वारलु नी, बाकुन मुसान साहरे लिखला कायदा पर चालने वाळा वारलु ठेहरायसे। <verse eid="ROM 2:13"/><verse number="14" style="v" sid="ROM 2:14"/>अळतेन जत्‌यार नी-यहुदी तींद्‌रे धड़े मुसान साहरे लिखली सास्‌तुर नी हय, तेबी वारु मन सी मुसान साहरे लिखला सास्‌तुरेन वात पर चाले, ती कायदु हींद्‌रे धड़े नी रवे तेबी चे तींद्‌रे वाटे आपसान कायदु छे। <verse eid="ROM 2:14"/><verse number="15" style="v" sid="ROM 2:15"/>चे कामेन साहरे ने चां कायदा लिखला देखाड़े ने तींद्‌रो हीयो मन गवा देय, ने हींद्‌रा वीच्‌यार एक दीसरा पर गुनु लागाड़े, नीते हीनुक नी-गुनावाळा ठेहरावे; <verse eid="ROM 2:15"/><verse number="16" style="v" sid="ROM 2:16"/>जी खुस-खबर मे सामळावो तीनी खुस-खबरेन अनसारे ईसु मसीन साहरे भगवान तीने दाहड़े माणसेन सातायला वातेन नीयाव करसे।<verse eid="ROM 2:16"/></para>
  <para style="s">यहुदी माणसे ने मुसान साहरे लिखलु कायदु</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 2:17"/>कदी तु आपसा काजे यहुदी कहें, ने कायदा मां भुरसु करे, ने तु तारा भगवानेन बारामां मटाय करे, <verse eid="ROM 2:17"/><verse number="18" style="v" sid="ROM 2:18"/>ने भगवानेन मरजी काजे जाणे ने कायदान सीकाड़नेन वात काजे वारु-वारु वात काजे पाळे; <verse eid="ROM 2:18"/><verse number="19" style="v" sid="ROM 2:19"/>ने आपसा पर भुरसु करे की मे आंदळा काजे वाट देखाड़्‌यु, ने आंदारला मां भटकी रवला माणसे काजे वीजाळो आपलु छे, <verse eid="ROM 2:19"/><verse number="20" style="v" sid="ROM 2:20"/>ने डेड़-अकल्‌या काजे सीकाड़ने वाळु, ने पुर्‌या-पारी काजे सीकाड़न्‌यु छे; ने अकल, ने छाचाय सीकाड़नेन वात, जी कायदा मां छे, ची मेसे काजे जड़ली छे। <verse eid="ROM 2:20"/><verse number="21" style="v" sid="ROM 2:21"/>हेरेसी वीच्‌यार कर तु दीसरा काजे सीकाड़े, ती आपसा काजे नी सीकाड़े काय? तु जु चुरी नी करनु करीन परचार करु, ने आपसात चुरी करे? <verse eid="ROM 2:21"/><verse number="22" style="v" sid="ROM 2:22"/>तु ज कहें, “छीनाळो<note caller="+" style="f"><char style="fr" closed="false">2:22 </char><char style="ft" closed="false">व्यभिचार</char></note> नी करनु” काय आपसु छीनाळो नी करतु काय? तु जु मुरत्‌या सी रीस करे, काय आपसुत मंदीरेन धन काजे नी लुटे काय? <verse eid="ROM 2:22"/><verse number="23" style="v" sid="ROM 2:23"/>तु जु मुसान कायदान बारामां मटाय ते करे, कायदा काजे तुड़ीन भगवानेन बदनामी काहा करे? <verse eid="ROM 2:23"/><verse number="24" style="v" sid="ROM 2:24"/>“काहाकी तुंद्‌रे वजे सी नी-यहुदी मां भगवानेन नावेन वाक वाळा हय रया।” जसों लिखलो बी छे।<verse eid="ROM 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 2:25"/>कदी तु मुसान साहरे लिखला कायदा पर चाले ती ते फतरी काटाड़ने सी नफु हवसे, बाकुन कदी तु मुसान साहरे लिखला कायदा पर नी चाले, ती फतरी काटाणे सी काय बी नफु नी हवे। <verse eid="ROM 2:25"/><verse number="26" style="v" sid="ROM 2:26"/>हेरेसी कदी फतरी काटे पाखुर माणसे मुसान साहरे लिखला कायदान रीती काजे पाळे ती भले चु फतरी काटाड़्‌यु तेबी चु फतरी काटाड़न्‌या मां नी गीणाये काय? <verse eid="ROM 2:26"/><verse number="27" style="v" sid="ROM 2:27"/>ने चु माणुस डील मां फतरी नी काटाड़्‌यु ने मुसान साहरे लिखला कायदु पाळी र्‌यु, चु तुसे काजे गुनाळु<note caller="+" style="f"><char style="fr" closed="false">2:27 </char><char style="ft" closed="false">दोषी</char></note> ठेहरावसे भले तारे वाटे मुसान साहरे लिखला कायदा छे, काहाकी तु मुसान साहरे लिखला कायदा पर नी चालतु? <verse eid="ROM 2:27"/><verse number="28" style="v" sid="ROM 2:28"/>जे बाहार सी यहुदी छे, चे छाचलीन यहुदी नी हय ने डीलेन फतरी काटाड़े छाचलीन फतरी काटाड़न्‌यु नी हय। <verse eid="ROM 2:28"/><verse number="29" style="v" sid="ROM 2:29"/>बाकुन खास यहुदी हयुत छे जु मन मां यहुदी छे, ने फतरी काटाड़्‌लु हयुत छे जु मन मां ने जीव-आत्‌मा मां छे ने चु लिखली वातेन अनसारे फतरी काजे काटाड़लु बी नी हय, बाकुन<note caller="+" style="f"><char style="fr" closed="false">2:29 </char><char style="ft" closed="false">परन्तु</char></note> असली ईज्‌जत माणसे काजे माणुस भीणी सी ईज्‌जत नी जड़े बाकुन भगवान भीणी सी ईज्‌जत जड़े।<verse eid="ROM 2:29"/></para>
  <chapter eid="ROM 2"/>
  <chapter number="3" style="c" sid="ROM 3"/>
  <para style="p">
    <verse number="1" style="v" sid="ROM 3:1"/>अळतेन यहुदी बन्‌ने सी काय फायदु ने नीते फतरी काटणे सी काय नफु? <verse eid="ROM 3:1"/><verse number="2" style="v" sid="ROM 3:2"/>आखे आन्‌गे सी बेसकु फायदु पेहेल ते ज की भगवानेन बुल<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">वचन</char></note> तीनु काजे सुपलु हतलु। <verse eid="ROM 3:2"/><verse number="3" style="v" sid="ROM 3:3"/>कदी हींद्‌रे मां भुरसु नी करे असला बी नीकळी जाय ती काय हय गुयो? काय हींद्‌रे भुरसा मां धुकु देणे सी भगवानेन छाचाय फालतु हय जासे काय? <verse eid="ROM 3:3"/><verse number="4" style="v" sid="ROM 3:4"/>कदी नी बाकुन भगवान छाचलु रवसे</para>
  <para style="q1" vid="ROM 3:4">ने आखा माणसे लुच्‌चा रवसे, जसों लिखलो छे,</para>
  <para style="q2" vid="ROM 3:4">“तेरी तु आपणी वात मां वारलु छे ने नीयाव करनेन टेम मां तु छाचलु छे।”<verse eid="ROM 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 3:5"/>हेरेसी कदी आपणु जे भुंडो काम करजे चे भगवानेन धरम काजे पाक्‌को करे, ती आपणु काय कहंजे? काय ज की भगवान जु रीस करे नीयाव नी करन्‌यु छे काय? ज ते माणसेन रीत पर कय र्‌यु। <verse eid="ROM 3:5"/><verse number="6" style="v" sid="ROM 3:6"/>कदी नी नीते भगवान कसु कळीन नीयाव करसे?<verse eid="ROM 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 3:7"/>कदी मारा झुटेन वजे सी भगवानेन छाचाय हेरे सेक-सींगार वाटे, जादा करीन उजेंतु हवे ती पेहेल काहा तु पापी छे करीन मारु नीयाव हवे? <verse eid="ROM 3:7"/><verse number="8" style="v" sid="ROM 3:8"/>“हामु काहा नाव-बद्‌दी नी करजे की भलाय नीकळे?” जसों हामरे पर जु वाक नीकाळी बी र्‌या, ने काहानाक कहें की हींद्‌रो जत कहंणु छे। बाकुन असलात गुनु लागाड़नु वारु छे?<verse eid="ROM 3:8"/></para>
  <para style="s">कुय बी वारलु नी हय</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 3:9"/>ती पछेन काय हयो? काय आपणु हींद्‌रे सी वारलु छे? कदी नी; काहाकी आपणु यहुदी ने नी-यहुदी दुयु पर गुयु गुनु लागाड़ी देदला छे की चे आखा ने आखा पापेन हक मां छे। <verse eid="ROM 3:9"/><verse number="10" style="v" sid="ROM 3:10"/>जसों लिखलो छे:</para>
  <para style="q1" vid="ROM 3:10">“कुय बी वारलु नी हय, एक बी नी हय।<verse eid="ROM 3:10"/></para>
  <para style="q2">
    <verse number="11" style="v" sid="ROM 3:11"/>कुय बी समजदार नी हय;</para>
  <para style="q2" vid="ROM 3:11">कुय बी भगवान काजे हेरने वाळु नी हय।<verse eid="ROM 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ROM 3:12"/>आखा भटकी गुयला छे,</para>
  <para style="q2" vid="ROM 3:12">आखान आखा बीगड़ी गुयला छे;</para>
  <para style="q2" vid="ROM 3:12">कुय बी भलाय करने वाळु नी हय, एक बी नी हय।<verse eid="ROM 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ROM 3:13"/>तींद्‌रु गळु मसाणेन तसु छे,</para>
  <para style="q2" vid="ROM 3:13">चे आपणा जीप्‌या सी झगड़ा करे,</para>
  <para style="q2" vid="ROM 3:13">हींद्‌रा हुटड़ा मां घड़सान जहर भरलु छे।<verse eid="ROM 3:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="ROM 3:14"/>हींद्‌रो मुंहडो<note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="ft" closed="false">मुहं</char></note> रीस ने कड़वान सी भरायलो छे।<verse eid="ROM 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ROM 3:15"/>हींद्‌रा पाय माणसे काजे मारीन खुन करने उतवाळा रवे,<verse eid="ROM 3:15"/></para>
  <para style="q2">
    <verse number="16" style="v" sid="ROM 3:16"/>हींद्‌रे वाट मां नुकसाण ने दुख छे,<verse eid="ROM 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ROM 3:17"/>चे सांतीन वाट नी जाणे।<verse eid="ROM 3:17"/></para>
  <para style="q2">
    <verse number="18" style="v" sid="ROM 3:18"/>हींद्‌रा डुळा अगळ भगवान काजे देखीन बी नी बीहे।”<verse eid="ROM 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 3:19"/>हामुक मालम छे की मुसान कायदु जु काय कहें तींद्‌रे सी कहें, जे मुसान कायदान हक मां छे; हेरेसी एकेक जणान मुंहडो बन्‌द हय जाणु चाहजे ने आखी कळी भगवानेन डंडेन वाटे रवे; <verse eid="ROM 3:19"/><verse number="20" style="v" sid="ROM 3:20"/>काहाकी मुसान कायदान काम सी कुय जीव बी हेरे अगळ वारलु नी गीणाये, हेरेसी की मुसान कायदान साहरे पापेन उळखान हवे।<verse eid="ROM 3:20"/></para>
  <para style="s">भुरसान साहरे वारलु</para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 3:21"/>बाकुन हय मुसान कायदा सी अलग भगवानेन चु वारलु उजेंतु हयु, की तेरी गवाय मुसान कायदु ने भगवानेन अघी सी आवणे वाळी वात देखाड़न्‌यान देय, <verse eid="ROM 3:21"/><verse number="22" style="v" sid="ROM 3:22"/>ने भगवानेन चु धरम ज्‌य ईसु मसी पर भुरसु करने सी आखा भुरसु करने वाळा वाटे छे। काहाकी काय बी छीट नी हय; <verse eid="ROM 3:22"/><verse number="23" style="v" sid="ROM 3:23"/>हेरेसी की आखान ने आखा पाप कर्‌या ने भगवानेन सेक-सींगार सी छेटे हय गुया, <verse eid="ROM 3:23"/><verse number="24" style="v" sid="ROM 3:24"/>बाकुन भगवानेन गीण-दया सी तीना छुटकारान साहरे ज ईसु मसी मां छे, फेरी मां वारलु ठेहरावलु छे। <verse eid="ROM 3:24"/><verse number="25" style="v" sid="ROM 3:25"/>ईसु मसी काजे भगवान लुही सी पापेन डंड भरन्‌यु बणाय देदु, ने ईसु पर भुरसु करने सीत आपणु काजे छुटकारु जड़े, जे माणसे पाप पेहेल करला ने भगवान तींद्‌रा पाप काजे सेण करतु र्‌यु ने तींद्‌रा चु ईसुन साहरे आपसान धरम उजेंतु कर्‌यु। <verse eid="ROM 3:25"/><verse number="26" style="v" sid="ROM 3:26"/>बाकुन ईनेत टेमे तेरु धरम उजेंतु हवे तेरेसी चु आपसुत वारलु गीणायसे, ने जे ईसु पर भुरसु करे तीनु काजे बी वारलु बणावसे।<verse eid="ROM 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 3:27"/>ती मटाय करनु काहा र्‌यो? हेरी ते जागा नी हय। काहानी मुसान कायदान वजे सी? काय वारलु करने मुसान कायदा सी? नी बाकुन भुरसान कायदान वजे सी। <verse eid="ROM 3:27"/><verse number="28" style="v" sid="ROM 3:28"/>हेरेसी कुय माणुस मुसान कायदान कामेन अनसारे चालीन नी, बाकुन भुरसान साहरे धरमी बण सके। <verse eid="ROM 3:28"/><verse number="29" style="v" sid="ROM 3:29"/>काय भगवान यहुदीयान अतरुत छे काय? काय नी-यहुदीन नी हय? हव नी-यहुदीन बी छे। <verse eid="ROM 3:29"/><verse number="30" style="v" sid="ROM 3:30"/>काहाकी एकुत भगवान छे, जु फतरी काटाण्‌या काजे भुरसा सी ने नी फतरी काटण्‌या काजे बी भुरसान साहरे<note caller="+" style="f"><char style="fr" closed="false">3:30 </char><char style="ft" closed="false">द्वारा</char></note> वारलु ठेहरावे। <verse eid="ROM 3:30"/><verse number="31" style="v" sid="ROM 3:31"/>ती काय आपणु मुसान साहरे लिखला कायदा काजे भुरसान साहरे फालतु ठेहरावजे? कदी नी बाकुन मुसान साहरे लिखला कायदा काजे जादा ताकतवाळु बणावे।<verse eid="ROM 3:31"/></para>
  <chapter eid="ROM 3"/>
  <chapter number="4" style="c" sid="ROM 4"/>
  <para style="s">अब्‌राहमेन दाखलु</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 4:1"/>तेरेमां हामु अब्‌राहमेन बारामां काय कहंजे जु डीलेन अनसारे हामरु डाहालु हतलु तीनाक काय जड़्‌यो? <verse eid="ROM 4:1"/><verse number="2" style="v" sid="ROM 4:2"/>काहाकी कदी अब्‌राहमेन काम सी धरमी गीणायतु, ती तीनाक मटाय करनेन जागु रवतु, बाकुन भगवान अगळ तीनाक मटाय करनेन गाळु नी हय। <verse eid="ROM 4:2"/><verse number="3" style="v" sid="ROM 4:3"/>चुखलो सास्‌तुर<note caller="+" style="f"><char style="fr" closed="false">4:3 </char><char style="fq" closed="false">चुखलो सास्‌तुर </char><char style="ft" closed="false">पवित्रशास्त्र</char></note> काय कहें? ज्‌य की, “अब्‌राहम भगवान पर भुरसु कर्‌यु, ने जु भुरसु तेरे वाटे वारलु गीणायु।” <verse eid="ROM 4:3"/><verse number="4" style="v" sid="ROM 4:4"/>काम करने वाळान दाहड़की आपणु दान नी, बाकुन हक गीणाये। <verse eid="ROM 4:4"/><verse number="5" style="v" sid="ROM 4:5"/>बाकुन जु काम करनु रवणी दीन तीना भगवान पर भुरसु करे, चु पापी काजे वारलु गीणे, ती तेरु भुरसुत तेरे वाटे वारलु गीणायसे। <verse eid="ROM 4:5"/><verse number="6" style="v" sid="ROM 4:6"/>ईनी भाती दावुद हीना माणुस काजे वारु कह्‌वे, तीनाक भगवान काम करे पाखुर वारलु बणावे:<verse eid="ROM 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ROM 4:7"/>“वारु छे चु, तेरु पाप माफ हय गुयु,</para>
  <para style="q2" vid="ROM 4:7">ने तेरा पाप ढाकाय गुया।<verse eid="ROM 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ROM 4:8"/>वारु छे चु माणुस तीनाक भगवान पापी नी कहें!”<verse eid="ROM 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 4:9"/>ती ज्‌य वारु बुल, काय फतरी काटाड़न्‌या नीते फतरी नी काटाड़्‌या हींद्‌रे वाटे बी? हामु ज्‌य कहंजे, “अब्‌राहम हेरा भुरसान साहरे खरलु धरमी गीणायु<note caller="+" style="f"><char style="fr" closed="false">4:9 </char><char style="ft" closed="false">धार्मिकता</char></note>।” <verse eid="ROM 4:9"/><verse number="10" style="v" sid="ROM 4:10"/>ती चु वारलु कसु गीणायु? फतरी काटाड़लु ती, की फतरी नी काटाड़्‌यु ती वारलु गीणायु; बाकुन चु ते फतरी काटे पाखुर वारलु गीणायलु। <verse eid="ROM 4:10"/><verse number="11" style="v" sid="ROM 4:11"/>ने अळतेन चु भुरसान साहरे धरमी गीणायलु छे ज्‌य देखणे करीन सहलाणी वाटे फतरी काटाड़्‌यु, पेहल चु फतरी काटे पाखुर भगवान पर भुरसु करलु हतलु। ने असु करीन चु अब्‌राहम तीनु आखान बास गीणाये; <verse eid="ROM 4:11"/><verse number="12" style="v" sid="ROM 4:12"/>ने असु करीन चु फतरी नी काटाड़े तींद्‌रु बास गीणायु, जे अब्‌राहमेन तसा भगवान पर भुरसु करीन जीवे, तसु अब्‌राहम बी फतरी काटाड़े पाखुर पेहेल भगवान पर भुरसु करतेलु।<verse eid="ROM 4:12"/></para>
  <para style="s">भुरसु ने भगवानेन बुल</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 4:13"/>काहाकी भगवान अब्‌राहम ने अब्‌राहमेन अवल्‌यात काजे वायदु करलु की चे कळीन हकदार्‌या बणसे। अब्‌राहम कायदाक मान्‌यु करीन भगवान असु वायदु नी कर्‌यु, बाकुन चु भुरसु कर्‌यु करीन भगवान हीनाक धरमी गीणायु। <verse eid="ROM 4:13"/><verse number="14" style="v" sid="ROM 4:14"/>काहाकी कदी मुसान कायदा पाळन्‌यात वायदान जागु हात मां करसे, ती ते भुरसु करने सी काय फायदु नी हय ने भगवानेन वायदु करली वात बी फालतु हय गुय। <verse eid="ROM 4:14"/><verse number="15" style="v" sid="ROM 4:15"/>मुसान कायदु ते भगवानेन रीस काजे उबजाड़े ने चां कायदु नी हय, चां कायदु तुड़नेन वात नी आवे।<verse eid="ROM 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 4:16"/>भगवानेन वायदु भुरसान फळ छे ने ज असोत जड़े। तीने रीते तेरा बुले अब्‌राहमेन आखा वाटे ते चेत, ने जे नीयम काजे माने तींद्‌रे वाटे नी बाकुन तीनु आखा वाटे बी जे अब्‌राहमेन तसा भुरसु राखजे। चु हामरु आखान भगवान बास छे। तेरेमां ज पाक्‌को छे <verse eid="ROM 4:16"/><verse number="17" style="v" sid="ROM 4:17"/>जसों की लिखलो छे, “मे तुसे काजे बेसका माणसेन बास ठेरावलु छे।” भगवानेन नींगा मां अब्‌राहम हामरु बास छे। अब्‌राहम भगवान पर भुरसु कर्‌यु, जु भगवान मरला काजे जीवाड़े ने जे हय नी तीनु काजे बी घड़ीन उबजाड़े। <verse eid="ROM 4:17"/><verse number="18" style="v" sid="ROM 4:18"/>अब्‌राहम नीरासेन दाहड़ाम बी आस राखीन भुरसु कर्‌यु ने चु बेसकी जातीन माणसेन बास बण गुयु, जसों तीनाक कहंलो हतलो की तारा गीणाये नी अतरा माणसेन बास हवसी। <verse eid="ROM 4:18"/><verse number="19" style="v" sid="ROM 4:19"/>अब्‌राहम भुरसा मां पाक्‌कु बणीन रयु ने असु जाणतेलु तेबी की हेरो डील सोव सालेन हय गुयली छे ने सारान पुर्‌या नी हवतेला। <verse eid="ROM 4:19"/><verse number="20" style="v" sid="ROM 4:20"/>भगवानेन वायदा पर भुरसु बणायन राख्‌यु अतरुत नी भुरसा काजे काठु करतु जाय्‌न भगवानेन सेक-सींगार कर्‌यु। <verse eid="ROM 4:20"/><verse number="21" style="v" sid="ROM 4:21"/>तीनाक पाक्‌कु भुरसु हतलु की भगवान तीनी वातेन वायदु करलु छे, चु तीनाक पुरु करीन छुड़से। <verse eid="ROM 4:21"/><verse number="22" style="v" sid="ROM 4:22"/>हेरे वजे सी भगवान अब्‌राहम काजे खरलु धरमी। <verse eid="ROM 4:22"/><verse number="23" style="v" sid="ROM 4:23"/>ने गुयु बुल की भुरसुत तेरे वाटे धरम गीणायु, तेरे वाटे अतरुत नी <verse eid="ROM 4:23"/><verse number="24" style="v" sid="ROM 4:24"/>बाकुन आपणे वाटे बी लिखलो छे। आपणु बी भुरसा सी वारलु गीणायसुन। काहाकी आपणु तीना भगवान पर भुरसु करजे, जु मालीक ईसु काजे मरलाम सी जीवाड़लु छे। <verse eid="ROM 4:24"/><verse number="25" style="v" sid="ROM 4:25"/>हयुत ईसु आपणात पाप गुनान करता मरणे करीन धराय गुयु ने आपणुक वारलु बणावणे करीन मरलाम सी जीवतु हय्‌न बठु बी हय गुयु।<verse eid="ROM 4:25"/></para>
  <chapter eid="ROM 4"/>
  <chapter number="5" style="c" sid="ROM 5"/>
  <para style="s">भगवान सी मेळु</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 5:1"/>जत्‌यार आपणु भुरसा सी वारलु बण्‌या, ती आपणा मालीक ईसु मसीन वजे सी भगवान साते आपणु सांती मां हय गुयला छे, <verse eid="ROM 5:1"/><verse number="2" style="v" sid="ROM 5:2"/>ईसु मसी आपणे वाटे तीनी गीण-दयान बारनो उघाड़ देदलु छे जी आपणुक जड़ गुयलो छे, आपणु ईनी वात पर मटाय करजे की आपणुक भगवानेन सेक-सींगारेन आस पर मटाय करजे। <verse eid="ROM 5:2"/><verse number="3" style="v" sid="ROM 5:3"/>अतरोत नी, आपणु दुख पर बी खुस हवजे, काहाकी आपणु जाणजे की दुखुत आपणुक गम खाण्‌या बणावे, <verse eid="ROM 5:3"/><verse number="4" style="v" sid="ROM 5:4"/>ने दम धरीन खरा नीकळनु, ने खरा नीकळने, सी आस उबजे। <verse eid="ROM 5:4"/><verse number="5" style="v" sid="ROM 5:5"/>ने आस सी लाज नी आवे, काहाकी भगवान आपणुक चुखली-आत्‌मा आपलु छे ने हेरेत वाटे भगवान परम आपणा मन मां भरलु छे।<verse eid="ROM 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 5:6"/>काहाकी जत्‌यार आपणु लुला हतला, तत्‌यार तीनेत टेमे ईसु मसी आपणे वाटे मर गुयलु। <verse eid="ROM 5:6"/><verse number="7" style="v" sid="ROM 5:7"/>कुय वारलु माणुस वाटे जीव आपणे तीयार हय जाय, तेबी काय जाणु कुय वारलु माणुस वाटे मरने तीयार हय जाय ती हय जाय। <verse eid="ROM 5:7"/><verse number="8" style="v" sid="ROM 5:8"/>बाकुन जत्‌यार आपणु पापीत हतला तत्‌यार ईसु मसी आपणे वाटे मर्‌यु, असु करीन भगवान आपसान परम उजेंती कर्‌यु। <verse eid="ROM 5:8"/><verse number="9" style="v" sid="ROM 5:9"/>तत्‌यार आपणु ईसुन लुहीन वजे सी वारलु गीणाया; ती आपणु छाचलीन मसीन वजे सी भगवानेन रीस सी बची जासुन। <verse eid="ROM 5:9"/><verse number="10" style="v" sid="ROM 5:10"/>काहाकी जत्‌यार आपणु वेरी हतला तत्‌यार ईसु आपसान मुतेन साहरे भगवान साते आपणु मेळ कराड़ देदु, ती हय ते आपणु मेळ भगवान साते हय गुयु। ती तेरा पुर्‌यान जीवन वाटे आपणुक छुटकारु नी जड़े काय? छुटकारु जड़से ने जड़से।<verse eid="ROM 5:10"/></para>
  <para style="s">आदम ने मसी</para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 5:11"/>अतरोत नी, बाकुन हय ते आपणा ईसु मसीन साहरे भगवान साते आपणु मेळ हय गुयलु छे, अतरा मां आपणु हेरे साहरे भगवान पर भुरसु राखीन खुस छे।<verse eid="ROM 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 5:12"/>तेरेमां एकुत अदमीन वजे सी कळी<note caller="+" style="f"><char style="fr" closed="false">5:12 </char><char style="ft" closed="false">दुनिया कळी</char></note> मां पाप आयु, ने पापेन वजे सी मुत आवी। ईनी वजे सी मुत आखा माणसे मां फेली गुय, काहाकी आखात पाप करला छे। <verse eid="ROM 5:12"/><verse number="13" style="v" sid="ROM 5:13"/>भगवान मुसा काजे कायदु नी आप्‌यु तेरेसी पेहेल सी पाप ईनी कळी मां हतलु बाकुन कायदु<note caller="+" style="f"><char style="fr" closed="false">5:13 </char><char style="ft" closed="false">व्यवस्था कायदु</char></note> नी हतलु अतरे कायदान कसर मां पापेन हीसाब नी लेवायतेलु। <verse eid="ROM 5:13"/><verse number="14" style="v" sid="ROM 5:14"/>तेबी आदम सी मुसा लग मुत तीनु माणसे पर बी राज करती रय जे आदमेन तसा काहनाक हुकुम तुड़नेन साहरे पाप नी करला।</para>
  <para style="p" vid="ROM 5:14">आदम आवणे वाळा छुटकारु आपण्‌या ईसुन सहलाणी<note caller="+" style="f"><char style="fr" closed="false">5:14 </char><char style="ft" closed="false">चिन्ह</char></note> हतलु। <verse eid="ROM 5:14"/><verse number="15" style="v" sid="ROM 5:15"/>बाकुन जसों गुनान नेम छे असीत गीण-दया वाटु नी हय काहाकी जत्‌यार एक माणुसेन गुना सी बेसका माणसे मरे ती भगवानेन गीण-दया ने तेरो ज्‌य दान एक माणसेन मतलब ईसु मसीन गीण-दया सी हयो बेसका माणसे पर हयो ने वारु हयो <verse eid="ROM 5:15"/><verse number="16" style="v" sid="ROM 5:16"/>ने जु फुटक्‌यु वाटु एकुत माणसेन पाप गुनान मुतेन फळेन तसु नी हय काहाकी एकुत जणु पाप कर्‌यु ने पापेन डंडेन दाहड़ु टाकाय गुयु बाकुन बेसका पाप करने सी असु फुटक्‌यु वाटु पयदा हयु की बेसका माणसे धरमी बण जासे। <verse eid="ROM 5:16"/><verse number="17" style="v" sid="ROM 5:17"/>काहाकी कदी एकुत माणसेन पापेन वजे सी मुत राज करने झुम गुय ती जे माणसे गीण-दया ने धरमेन फुटक्‌यु वाटु बेसकु हात करे चे एकुत माणसेन मतलब ईसु मसीन साहरे छाचलीन जलमेन जीवाय मां राज करसे।<verse eid="ROM 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 5:18"/>तेरेमां जसों एकुत जणान पापेन वजे सी आखा गुनाळा गीणाया तसोत एकुत जणान धरमेन कामेन वजे सी आखा काजे अमरकाय जीवन आपण्‌यु धरमेन वाटु जड़ गुयु। <verse eid="ROM 5:18"/><verse number="19" style="v" sid="ROM 5:19"/>काहाकी जसु एक माणुस हुकुम नी पाळ्‌ने सी आखा पापी बण गुया तसात एक माणसेन हुकुम पाळने सी आखा धरमी बण जासे।<verse eid="ROM 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 5:20"/>ने मुसा साहरे लिखलु कायदु ईचमां आय गुयु ने माणसेम पाप जादात हवणे बाजी गुयु। बाकुन चां गुनु जादा हयु ती गीण-दया बी जादात वदती गुयु। <verse eid="ROM 5:20"/><verse number="21" style="v" sid="ROM 5:21"/>जसु पाप मुत लावतु जाय्‌न राज कर्‌यु तसोत आपणा मालीक ईसु मसीन साहरे गीण-दया बी जलमेन जीवन वाटे माणसेक वारलु ठहरावीन राज करती जाय।<verse eid="ROM 5:21"/></para>
  <chapter eid="ROM 5"/>
  <chapter number="6" style="c" sid="ROM 6"/>
  <para style="s">पाप वाटे मरनु मसी मां जीवणु</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 6:1"/>आपणु काय कहजे? आपणु पाप करतात रवजे काय? की भगवानेन गीण-दया आपणे पर हवतीत जासे। <verse eid="ROM 6:1"/><verse number="2" style="v" sid="ROM 6:2"/>कदी नी हामु जे पाप वाटे मर गुयला छे ती पाप मां कसा जीवसुन? <verse eid="ROM 6:2"/><verse number="3" style="v" sid="ROM 6:3"/>काय तुहुं नी जाणु काय की ईसु मसीन ज बपतीस्‌मा<note caller="+" style="f"><char style="fr" closed="false">6:3 </char><char style="ft" closed="false">बपतिस्मा</char></note> आपणु आखा काजे जड़लो छे चो बपतीस्‌मा तेरे जाण देनेन बपतीस्‌मा छे। <verse eid="ROM 6:3"/><verse number="4" style="v" sid="ROM 6:4"/>अतरामा आपणु ईसुन मुतेन बपतीस्‌मा लीन ईसु साते तेरेमां गाड़ाय गुया की जसों ईसु मसी बासेन सेक-सींगारेन ताकत साते मरलाम सी जीवतु हय्‌न बठु हय गुयला छे। तसात आपणु बी एक नवली जीवन जीवजे।<verse eid="ROM 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 6:5"/>काहाकी कदी आपणु हेरे मरनेन तसात हेरे साते एक हय गुयला छे, ती छाचलीन हीनाक मरलाम सी जीवतु हवणेन तसात एक हय जासुन। <verse eid="ROM 6:5"/><verse number="6" style="v" sid="ROM 6:6"/>आपणुक मालम छे की आपणी जुन्‌डलो जीवन ईसु साते कुरुस पर चड़ाय गुयलो हतलो काहाकी पाप सी भरायलो आपणो डील खत्‌तम हय जाय ने आपणु अगा वाटे पापेन गुलाम नी बणजे। <verse eid="ROM 6:6"/><verse number="7" style="v" sid="ROM 6:7"/>काहाकी जु मर गुयलु छे, चु पापेन गुलामी सी छुटीन धरमी बण गुयलु छे। <verse eid="ROM 6:7"/><verse number="8" style="v" sid="ROM 6:8"/>तेरेमां कदी आपणु ईसु मसी साते मर गुयला छे, ती आपणुक भुरसु छे तेरे साते नवली जीवन बी जीवसुन। <verse eid="ROM 6:8"/><verse number="9" style="v" sid="ROM 6:9"/>काहाकी आपणु जाणजे की ईसु मसी मरलाम सी जीवतु हवीन पछु कदी नी मरे। ने तेरे पर मुतेन हक नी चाले। <verse eid="ROM 6:9"/><verse number="10" style="v" sid="ROM 6:10"/>काहाकी चु मर गुयु ती पापेन करता एकुत कावा मर गुयु; बाकुन हय चु भगवान साते जीवणे करीन जीवतेलु छे। <verse eid="ROM 6:10"/><verse number="11" style="v" sid="ROM 6:11"/>असात तुहुं बी आपणा जीव काजे पाप वाटे मरला समजु बाकुन भगवान वाटे ईसु मसी मां जीवतेला समजु।<verse eid="ROM 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 6:12"/>तेरेमां तुंद्‌रे मरला डीलेन उपर पापेन, राज नी चाले काहाकी तुहुं पापेन मरजी पर कदी नी चाल सकु। <verse eid="ROM 6:12"/><verse number="13" style="v" sid="ROM 6:13"/>ने तुहुं तुंद्‌रा डील काजे धरमेन काम नी करन्‌यान हत्‌यार बणावीन पाप काजे मां आपु, बाकुन आपणु काजे मर्‌या-सर्‌याम सी जीवता हय्‌न बठा हय गुया समजीन भगवानेन हातेम सुप देवु, ने आपणा डील काजे धरमेन काम करनेन हत्‌यार<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="ft" closed="false">हथियार</char></note> समजीन भगवान काजे सुप देवु। <verse eid="ROM 6:13"/><verse number="14" style="v" sid="ROM 6:14"/>तत्‌यार तुंद्‌रे पर पाप राज नी करे काहाकी तुहुं मुसान कायदान हक मां नी हय, बाकुन गीण-दया हक मां छे।<verse eid="ROM 6:14"/></para>
  <para style="s">धरमेन पावर्‌यु</para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 6:15"/>ती काय हय गुयो? आपणु अतरामा पाप करता रहणु चाहजे, की आपणु मुसान लिखला कायदान हक मां नी हय, बाकुन गीण-दया हक मां छे? नी कदी बी पाप नी करनु चाहजे। <verse eid="ROM 6:15"/><verse number="16" style="v" sid="ROM 6:16"/>तुहुंक जी वात मालम नी हय काय, की तेरी तुहुं हुकुम मान्‌ने करीन तेरा हातेम खुद काजे सुप देवु तुहुं तेरात गुलाम पावर्‌या बण जाय, भले पापेन हातेम आपीन पापेन गुलाम बणु, तेरो फळ मुत छे भले भगवानेन हुकुम मानीन तेरा हातेम सुप देवु, तेरो फळ अमरकाय धरम छे। <verse eid="ROM 6:16"/><verse number="17" style="v" sid="ROM 6:17"/>बाकुन भगवान काजे तु बेसकु वारु छे<note caller="+" style="f"><char style="fr" closed="false">6:17 </char><char style="fq" closed="false">वारु छे </char><char style="ft" closed="false">धन्यवाद</char></note> कहं की तुहुं पेहेल पापेन गुलाम हतला तुहुं आपणा मन सी हीनु सीकाड़नेन रीती काजे मान्‌या जी तुहुं काजे आपली हतली। <verse eid="ROM 6:17"/><verse number="18" style="v" sid="ROM 6:18"/>ने हय तुहुं पापेन गुलामी मां सी छुटीन धरमेन गुलाम बण गुयला छे। <verse eid="ROM 6:18"/><verse number="19" style="v" sid="ROM 6:19"/>तुंद्‌री डीलेन लुलायन वजे सी माणसेन रीत पर कहं। जसा तुहुं आपणे भाग काजे वीटळो धरने पापेन गुलाम करीन सुपलु हतलु, असात हय आपणे भाग काजे चुखला वाटे धरमेन गुलाम करीन सुप देवु।<verse eid="ROM 6:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 6:20"/>जत्‌यार तुहुं पापेन गुलाम हतला, ती भगवानेन धरम भीणी सी तुहुं छुटला<note caller="+" style="f"><char style="fr" closed="false">6:20 </char><char style="ft" closed="false">स्वतंत्र</char></note> हतला। <verse eid="ROM 6:20"/><verse number="21" style="v" sid="ROM 6:21"/>तीनी वात सी तुहुं लाजवाय रया, ती पेहेल तुहुंक तीनी वात सी काय फायदु हवतेलु? काहाकी तेरो आकरी फळ ते मरनु छे। <verse eid="ROM 6:21"/><verse number="22" style="v" sid="ROM 6:22"/>बाकुन हय पाप सी छुटीन भगवानेन गुलाम पावर्‌या बणीन तुहुंक ज फळ जड़लो छे की तुहुं चुखला बणु, ने आकरी मां जलमेन जीवन हात करनु छे। <verse eid="ROM 6:22"/><verse number="23" style="v" sid="ROM 6:23"/>काहाकी पापेन दाहड़की ते मरनु छे, बाकुन भगवानेन दानेन वाटु आपणा मालीक ईसु मसी मां जलमेन जीवन छे।<verse eid="ROM 6:23"/></para>
  <chapter eid="ROM 6"/>
  <chapter number="7" style="c" sid="ROM 7"/>
  <para style="s">ईयावेन जीवनेन दाखलु</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 7:1"/>ए भायसे, मे मुसान लिखला कायदा काजे जाणन्‌या काजे कहं, की जत्‌यार लगुन माणुस जीवतेलु रवे, तत्‌यार लगुन तेरे पर मुसान लिखला कायदान कब्‌जु रवे। <verse eid="ROM 7:1"/><verse number="2" style="v" sid="ROM 7:2"/>काहाकी ईयाव करली बायरी मुसान साहरे लिखला कायदान अनसारे धेणी जत्‌यार लगुन जीवतेलु रवे, तत्‌यार लगुन ईयावेन<note caller="+" style="f"><char style="fr" closed="false">7:2 </char><char style="ft" closed="false">विवाहित</char></note> नेम मां बांदायली रवे। बाकुन जत्‌यार धेणी मर जाय ती ची आपणा धेणीन हक मां सी छुट जाय। <verse eid="ROM 7:2"/><verse number="3" style="v" sid="ROM 7:3"/>तेरेमां कदी चु अदमी <note caller="+" style="f"><char style="fr" closed="false">7:3 </char><char style="ft" closed="false">पुरुष</char></note>जीवतेलु रवे ने अळी ची दीसरु अदमी कर लेय, ती छीनाळी कहंवायसे; बाकुन कदी तेरु धेणी मर जाय, ती ची ईयावेन कायदा सी छुट जाय, जां लग की ची कदी दीसरु अदमी बी कर लेय, तेबी छीनाळी नी कह्‌वाये। <verse eid="ROM 7:3"/><verse number="4" style="v" sid="ROM 7:4"/>असात ए मारा भायस्‌यो ने बहणीस्‌या, तुहुं बी ईसु मसीन डीलेन वाटे मुसान कायदान वाटे मरला तसा हय गुयला छे, ने भगवान वाटे फळ लावणे करीन तुहुं तीना दीसरान बण गुयला छे, चु मरलाम सी जीवतु हय्‌न बठु हय गुयलु छे। <verse eid="ROM 7:4"/><verse number="5" style="v" sid="ROM 7:5"/>काहाकी जत्‌यार आपणु डीलेन अनसारे जीवतेला ती पापेन हर कायदान वीरुद मां आपणा जीवे मां काम करतेली, ने आपणा डील पर कब्‌जु कर रवली। तेरेसी आपणु दाहड़ीन मुत भीणी जातला। <verse eid="ROM 7:5"/><verse number="6" style="v" sid="ROM 7:6"/>बाकुन तेरा कब्‌जा मां आपणु हतला, तेरे वाटे आपणु मर गुयला छे, हय आपणु पाप काजे उजेंती करन्‌या मुसान साहरे लिखला कायदा सी छुट गुया, जे मुसान कायदा ते जुन्‌डली रीत छे, आपणु ईनी जुन्‌डली रीतीन अनसारे नी, बाकुन चुखला आत्‌मान नवली रीतीन अनसारे भगवानेन सेवा करजे।<verse eid="ROM 7:6"/></para>
  <para style="s">मुसान साहरे लिखलु कायदु ने पाप</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 7:7"/>काय हेरो मतलब ज्‌य छे की कायदु पाप छे? कदी नी तेबी कायदान साहरेत पापेन पतु चाल्‌यु कदी कायदु नी कवतु लालुच घुण करे ती मे ज्‌य नी समजतु की लालुच काय छे। <verse eid="ROM 7:7"/><verse number="8" style="v" sid="ROM 7:8"/>बाकुन पाप मुखु देखीन कायदान हुकुमेन साहरे मारा जीवे मां आखी भातीन लालुच उबजाड़्‌यु काहाकी पेहले मुसान कायदा पाखुर पाप मरलु हतलु। <verse eid="ROM 7:8"/><verse number="9" style="v" sid="ROM 7:9"/>मे ते मुसान कायदु जड़ने सी पेहले जीवतेलु बाकुन जत्‌यार मुसान कायदान हुकुम आयु, ती पाप जीवतु हय गुयु, ने मे मर गुयु। <verse eid="ROM 7:9"/><verse number="10" style="v" sid="ROM 7:10"/>ने असु करीन जु कायदान हुकुम मारे धड़े जीवाय आपण्‌यु हतलु; हयुत कायदु हुकुम मारे धड़े मरनेन वजे बण गुय। <verse eid="ROM 7:10"/><verse number="11" style="v" sid="ROM 7:11"/>काहाकी पाप मुखु देखीन कायदान हुकुमेन साहरे मेसेक भंगलाड़ देदु ने हीना कायदान हुकुमेन साहरे मेसेक मार बी नाख्‌यु।<verse eid="ROM 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 7:12"/>तेरेमां मुसान कायदु ते चुखलु छे, ने हुकुम बी चुखलु छे, वारु छे। <verse eid="ROM 7:12"/><verse number="13" style="v" sid="ROM 7:13"/>ती काय जु मुसान कायदु मारे वाटे वारु हतलु, चु मारे वाटे मरनेन वजे बण गुयु काय? कदी नी। बाकुन पाप तीना वारलु चीजेन साहरे मारे वाटे मुत काजे उबजाड़ने वाळु बण गुयु, तेरे सी पाप ते पापुत छे करीन जादास उजेंतु हय गुयु तेरेमां ईनु हुकुम सी पाप जादात पापी हय गुयु।<verse eid="ROM 7:13"/></para>
  <para style="s">माणसेन वात-वात मां झगड़ु</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 7:14"/>आपणुक मालम छे की मुसान कायदु ते जीव-आत्‌मा वाटे फायदु आपे असु छे बाकुन, ने डीलेन बणलु माणुस छे, जु पापेन गुलामी करने पापेन हातेम वेचायलु छे। <verse eid="ROM 7:14"/><verse number="15" style="v" sid="ROM 7:15"/>ने मारा डील मां मे ज करो, चत मेसेक मालम नी हय, काहाकी ज करनेन मारी हर छे, च मे नी करो, बाकुन तेरे सी मे छीट करो चत काम कर्‌या करो। <verse eid="ROM 7:15"/><verse number="16" style="v" sid="ROM 7:16"/>ने कदी मेसे ज नी गमे चत करो ती मे जी वात मान लम की मुसान कायदु बेसकु वारु छे। <verse eid="ROM 7:16"/><verse number="17" style="v" sid="ROM 7:17"/>ती असो गलत करन्‌यु मे नी हय, बाकुन पाप छे जु मारा डीलेम बस र्‌यु। <verse eid="ROM 7:17"/><verse number="18" style="v" sid="ROM 7:18"/>काहाकी मेसेक मालम छे की मारेम मतलब मारा डील<note caller="+" style="f"><char style="fr" closed="false">7:18 </char><char style="ft" closed="false">शरीर</char></note> मां काहनी बी वात वारु नी हय, वारलु करनेन मारी हर ते छे, बाकुन भलो काम मारे सी नी बणे। <verse eid="ROM 7:18"/><verse number="19" style="v" sid="ROM 7:19"/>काहाकी ज वारलु काम करनेन हर<note caller="+" style="f"><char style="fr" closed="false">7:19 </char><char style="ft" closed="false">ईच्छा</char></note> करे, च ते नी करु, बाकुन जी कुहराय मे नी करने हींडे, चीत कुहराय मे कर्‌या करो। <verse eid="ROM 7:19"/><verse number="20" style="v" sid="ROM 7:20"/>बाकुन कदी मे चत करो, ज करनेन मे हर नी करो, ती च करने वाळु मे नी हय, बाकुन पाप छे जु मार डील मां बस र्‌यु।<verse eid="ROM 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 7:21"/>अतरा मां मे मारा डील मां जु मुसान साहरे लिखला कायदान देखु, की मे जी भलाय करनेन हर कर र्‌यु, ती कुहराय मार धड़े आवे। <verse eid="ROM 7:21"/><verse number="22" style="v" sid="ROM 7:22"/>काहाकी मे मारा जीव मां ते मुसान साहरे लिखला भगवानेन कायदा सी बेसकु खुस रवे। <verse eid="ROM 7:22"/><verse number="23" style="v" sid="ROM 7:23"/>बाकुन मेसेक मारा डील मां एक दीसरु भात्‌यु कायदु देखाव पड़ र्‌यु, जु मारी अकलेन कायदा साते लड़ाय करे, ने मेसेक पापेन कायदान कब्‌जा मां करने हींडे जु मारा डीलेम छे। <verse eid="ROM 7:23"/><verse number="24" style="v" sid="ROM 7:24"/>मे बेसकु दुखी माणुस छे! ईना मुतेन हक मां रवणेवाळा डील सी मेसेक कुण छुड़ावसे <verse eid="ROM 7:24"/><verse number="25" style="v" sid="ROM 7:25"/>मे आपणा मालीक ईसु मसीन साहरे मे भगवान काजे तु बेसकु वारु छे करीन कह्‌वो!</para>
  <para style="p" vid="ROM 7:25">असु करीन मे आपसुत ते अक्‌कल वाटे भगवानेन कायदाक पाळ, बाकुन डीलेन नीयमेन अनसारे पापेन कायदान सेवा कर र्‌यु।<verse eid="ROM 7:25"/></para>
  <chapter eid="ROM 7"/>
  <chapter number="8" style="c" sid="ROM 8"/>
  <para style="s">चुखली-आत्‌मान साहरे जीवन</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 8:1"/>हेरेसी हय जे ईसु मसी मां छे, तींद्‌रे पर गुनान डंडेन हुकुम नी हय। काहाकी चे डीलेन अनसारे नी बाकुन आत्‌मान अनसारे चाले। <verse eid="ROM 8:1"/><verse number="2" style="v" sid="ROM 8:2"/>काहाकी जीवनेन आत्‌मान कायदु ईसु मसी मां पाप भीणी सी ने मुतेन कायदा मां सी छुड़ाय देदलु छे। <verse eid="ROM 8:2"/><verse number="3" style="v" sid="ROM 8:3"/>काहाकी ज काम कायदु डीलेन वजे सी हय नी कर सक्‌यु, तीना काजे भगवान पुरो कर्‌यु, मतलब आपणा पुर्‌या काजे पापेन डीलेन तसु ने पापेन बादान सीका मां मकल्‌यु, डील मां पाप पर डंडेन हुकुम आप्‌यु। <verse eid="ROM 8:3"/><verse number="4" style="v" sid="ROM 8:4"/>हेरेसी मुसान साहरे लिखला कायदान रीती काजे आपणे मां सी जे डीलेन अनसारे नी बाकुन आत्‌मान अनसारे चाले, ची पुरी करसे। <verse eid="ROM 8:4"/><verse number="5" style="v" sid="ROM 8:5"/>काहाकी डीलेन अनसारे चालन्‌यु माणुस डीलेन वात पर मन लागाड़े; बाकुन चुखला आत्‌मान अनसारे जीवण्‌यु माणुस आत्‌मा वात पर मन लागाड़े। <verse eid="ROM 8:5"/><verse number="6" style="v" sid="ROM 8:6"/>डील पर मन लागाड़नु ते मुत छे, बाकुन आत्‌मा पर मन लागाड़नु जीवन ने सांती छे; <verse eid="ROM 8:6"/><verse number="7" style="v" sid="ROM 8:7"/>काहाकी डील पर मन लागाड़नु ते भगवान सी नाव-बद्‌दी राखणु छे, काहाकी नीते चु भगवानेन कायदान कब्‌जा मां छे ने नी हय सके; <verse eid="ROM 8:7"/><verse number="8" style="v" sid="ROM 8:8"/>ने जे माणसे डीलेन अनसारे जीवन जीवे, चे भगवान काजे खुस नी कर सके।<verse eid="ROM 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 8:9"/>बाकुन जत्‌यार भगवानेन आत्‌मा तुंद्‌रे मां बसली छे, ती तुहुं डीलेन अनसारे चालु बाकुन आत्‌मान हक मां चालन्‌या बणु। कदी काहनाक मां मसीन आत्‌मा नी हय ती चु मसी मां नी हय। <verse eid="ROM 8:9"/><verse number="10" style="v" sid="ROM 8:10"/>कदी मसी तुंद्‌रे मां छे, ती डील पापेन वजे सी मरलो छे, बाकुन आत्‌मा धरमेन वजे सी जीवतेलु छे। <verse eid="ROM 8:10"/><verse number="11" style="v" sid="ROM 8:11"/>कदी हेरीत आत्‌मा ज ईसु काजे मरलाम सी जीवाड़्‌यु, तुंद्‌रे मां बसलु छे; ती जु मसी काजे मरला मां सी जीवाड़्‌यु<note caller="+" style="f"><char style="fr" closed="false">8:11 </char><char style="ft" closed="false">जिलाया</char></note>, चु तुंद्‌रो मरन्‌या डील काजे बी आपणी आत्‌मान साहरे ज तुंद्‌रे मां बसलु छे, च जीवाड़से।<verse eid="ROM 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 8:12"/>हेरेसी ए भायसे, आपणु डीलेन करजा वाळा<note caller="+" style="f"><char style="fr" closed="false">8:12 </char><char style="fq" closed="false">करजा वाळा </char><char style="ft" closed="false">कर्जदार</char></note> नी हय की हामु डीलेन अनसारे जीवन नी जीवणु चाहजे, <verse eid="ROM 8:12"/><verse number="13" style="v" sid="ROM 8:13"/>काहाकी कदी तुहुं डीलेन अनसारे जीवन जीवसु ती मरी जासु, कदी आत्‌मा सी डीलेन हर काजे मारसु ती जीवतेला रवसु। <verse eid="ROM 8:13"/><verse number="14" style="v" sid="ROM 8:14"/>हेरेसी जतरा माणसे भगवान आत्‌मान साहरे चालसे, चे भगवानेन पुर्‌या<note caller="+" style="f"><char style="fr" closed="false">8:14 </char><char style="fq" closed="false">भगवानेन पुर्‌या </char><char style="ft" closed="false">परमेश्वर के पुत्र</char></note> छे। <verse eid="ROM 8:14"/><verse number="15" style="v" sid="ROM 8:15"/>काहाकी तुहुं काजे गुलामी कराड़ने वाळी आत्‌मा नी जड़ी की तुहुं अळी बीहणे बाजी जावु, बाकुन खुळे-लेणी<note caller="+" style="f"><char style="fr" closed="false">8:15 </char><char style="ft" closed="false">लेपालकपन</char></note> आत्‌मा जड़ली छे, तेरी सी आपणु भगवान काजे ए बास, कह्‌वीन आयड़जे। <verse eid="ROM 8:15"/><verse number="16" style="v" sid="ROM 8:16"/>आत्‌मा आपसीत हामरी आत्‌मा साते गवाय देय, की आपणु भगवानेन अवल्‌यात छे; <verse eid="ROM 8:16"/><verse number="17" style="v" sid="ROM 8:17"/>ने कदी अवल्‌यात छे ती जागरीन हकदर्‌या बी छे, बाकुन भगवानेन जागरी ने मसी साते ने तेरी जागरीन हकदर्‌या छे, जत्‌यार आपणु मसी साते दुख झेलसुन ती तेरे साते सेक-सींगार मां हय्‌न जासु।<verse eid="ROM 8:17"/></para>
  <para style="s">आवणे वाळा टेम मां उजेंतो हवण्‌यु सेक-सींगार</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 8:18"/>काहाकी मे समजो की ईनी टेमे दुख ने वेला आवणे वाळी टेमे हामरे पर उजेंता हवणे वाळा सेक-सींगार अगळ, फीका छे। <verse eid="ROM 8:18"/><verse number="19" style="v" sid="ROM 8:19"/>काहाकी जी कळी बेसकी मटी आस करीन भगवानेन पुर्‌यान उजेंता हवणेन वाट देख<note caller="+" style="f"><char style="fr" closed="false">8:19 </char><char style="fq" closed="false">वाट देख </char><char style="ft" closed="false">प्रतीक्षा</char></note> रय। <verse eid="ROM 8:19"/><verse number="20" style="v" sid="ROM 8:20"/>काहाकी कळी आपणी मरजी सी नी बाकुन गुलाम बणावणे वाळा भीणी सी, बेकार मां गुलाम ने ईनी आस सी करली छे। <verse eid="ROM 8:20"/><verse number="21" style="v" sid="ROM 8:21"/>की जी कळी बी आपसीत खत्‌तम कराड़ने वाळी गुलामी मां सी छुटकारु लीन, भगवानेन अवल्‌यातेन सेक-सींगारेन छुटकारु बी हात करसे। <verse eid="ROM 8:21"/><verse number="22" style="v" sid="ROM 8:22"/>काहाकी आपणु काजे मालम छे की आखी कळी हय लग कासे ने वेला करीन फपड़ी रय; <verse eid="ROM 8:22"/><verse number="23" style="v" sid="ROM 8:23"/>ने कळी अतरीत वेला करीन नी फपड़ी रय बाकुन आपणु बी वेला कर रया जीनु काजे आत्‌मान फळ जड़लो छे, जे आपसात कास र्‌या; ने खुळे लेदला पुर्‌या बन्‌नेन, मतलब आपणा डीलेन छुटकारान वाट देख र्‌या। <verse eid="ROM 8:23"/><verse number="24" style="v" sid="ROM 8:24"/>ईनी आसेन साहरे आपणु छुटकारु हवलु छे; बाकुन जीनी चीजेन आपणु आस करजे, ने ची चीज देखणे मां आवे ती ची आस नी रय, काहाकी जीनी चीज काजे कुय देखणे बाजी र्‌यो हय ती चु तीनी चीजेन आस काहा करसे? <verse eid="ROM 8:24"/><verse number="25" style="v" sid="ROM 8:25"/>बाकुन जीनी चीज काजे हामु नी देखजे, कदी हेरीत आस राखजे, ती दम धरीन वाट बी देखजे।<verse eid="ROM 8:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 8:26"/>ईनी रीत सी आत्‌मा बी आपणी लुल्‌गाय मां सात देय; काहाकी आपणु काजे नी मालम की दुवा काहनी रीत सी करनु चाहजे, बाकुन आत्‌मा आपसीत उसकी-उसकीन, जी आपणी समज सी बाहर हय, हामरे वाटे भगवान सी लीलघाय करे; <verse eid="ROM 8:26"/><verse number="27" style="v" sid="ROM 8:27"/>ने आपणा मन काजे पारखणे वाळु जाणे की आत्‌मान मरजी काय छे; काहाकी चु चुखला माणसे वाटे भगवानेन मरजीन अनसारे लीलघाय करे।<verse eid="ROM 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 8:28"/>आपणु काजे मालम छे की जे माणसे भगवान सी परम करे, तींद्‌रे वाटे आखी वात मेळीन भलाय काजे उबजाड़े; मतलब हींद्‌रे वाटे जे भगवानेन अनसारे बुलावला छे। <verse eid="ROM 8:28"/><verse number="29" style="v" sid="ROM 8:29"/>जीनुक भगवान पेहलुत सी नेवाड़ी की हीनुक पेहलुत सी आपणा पुर्‌यान रुप मां ठेरावे काहाकी बेसका भायस मां चु आखा सी मट्‌लु भायस बण सके। <verse eid="ROM 8:29"/><verse number="30" style="v" sid="ROM 8:30"/>अळतेन तीनु काजे भगवान पेहलुत सी ठेहरावलु छे, तीनु काजे बुलायु बी; ने तीनु काजे बुलायु, तीनु काजे वारलु ठेहरायु, तीनु काजे वारलु ठेरायु तीनु काजे सेक-सींगार बी आप्‌यु।<verse eid="ROM 8:30"/></para>
  <para style="s">भगवानेन परम</para>
  <para style="p">
    <verse number="31" style="v" sid="ROM 8:31"/>अळतेन आपणु एक वातेन बारामां काय कहंजे? कदी भगवान हामरे भीणी छे, ती हामरे वीरुद कुण रवसे? <verse eid="ROM 8:31"/><verse number="32" style="v" sid="ROM 8:32"/>तेरेसी भगवान आपणा खुदेन पुर्‌या काजे बी नी छुड़्‌यु, ने आपणे वाटे मरणे करीन आप देदु, ती तेरे साते आपणु काजे अळी आखो काय नी आपे? <verse eid="ROM 8:32"/><verse number="33" style="v" sid="ROM 8:33"/>भगवानेन नेवाड़ला पर गुनु कुण लागाड़से? भगवानुत हीनु काजे नी-गुनाळा ठेहरावसे! <verse eid="ROM 8:33"/><verse number="34" style="v" sid="ROM 8:34"/>पछेन कुण छे जु डंडेन हुकुम आपसे? मसी ईसु छे चु मर गुयु मतलब मरलाम सी जीवतु बी हय गुयु, ने भगवानेन जेवड़े आन्‌गे छे, ने हामरे वाटे दुवा बी करे। <verse eid="ROM 8:34"/><verse number="35" style="v" sid="ROM 8:35"/>कुण आपणु काजे मसीन परम सी आन्‌गे करसे? काय दुख, नीते वेला, नीते काड़की, नीते काळ; नीते उघाल्‌ला नीते आफत, नीते तलवार? <verse eid="ROM 8:35"/><verse number="36" style="v" sid="ROM 8:36"/>जसों खरला सास्‌तुर मां लिखलो छे,</para>
  <para style="q1" vid="ROM 8:36">“तारे वाटे हामु दाहड़ीन मुतेन हात मां आपाय जाजे;</para>
  <para style="q2" vid="ROM 8:36">हामु ते तीनु गाडरान तसा गीणाय जाजे।”<verse eid="ROM 8:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="ROM 8:37"/>बाकुन ईनुक आखी वात मां हामु भगवानेन साहरे जु आपणे सी परम कर्‌यु, जीत सी बी अघु छेकीन छे। <verse eid="ROM 8:37"/><verse number="38" style="v" sid="ROM 8:38"/>काहाकी मे छाचलीन जाणी लेदु की नी मुत, नी जीवन, नी सरग वाळा काहवाळ्‌या, नी हकदार, नी हय्‌न टेम, नी आवणे वाळी टेम, नी ताकत, नी उचाय, <verse eid="ROM 8:38"/><verse number="39" style="v" sid="ROM 8:39"/>नी उंडाय, ने नी कुय अळी कळी आपणु काजे भगवानेन परम सी जे आपणा मालीक ईसु मसी मां छे, आन्‌गे नी कर सके।<verse eid="ROM 8:39"/></para>
  <chapter eid="ROM 8"/>
  <chapter number="9" style="c" sid="ROM 9"/>
  <para style="s">भगवान ने हेरा नेवाड़ला माणसे</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 9:1"/>मे ईसु मसी मां छाचलीन कह्‌वो, मे झुट नी मेल्‌तु ने मारो मन बी चुखली-आत्‌मा मां गवा देय <verse eid="ROM 9:1"/><verse number="2" style="v" sid="ROM 9:2"/>की मे बेसकु दुखी छे, ने मारो मन जलम दुखतोत रवे, <verse eid="ROM 9:2"/><verse number="3" style="v" sid="ROM 9:3"/>काहाकी मारी जां लग हर हतली की आपणा भायसे वाटे जे डीलेन अनसारे मारा भाय-बेटा छे, मे खुद मसी सी सराप <note caller="+" style="f"><char style="fr" closed="false">9:3 </char><char style="ft" closed="false">श्रापित</char></note>वाळु हय जातु। <verse eid="ROM 9:3"/><verse number="4" style="v" sid="ROM 9:4"/>चे ईस्‌रायली छे, ने खुळे लेवायणेन हक ने सेक-सींगार ने वायदु ने कायदु ने बड़ाय ने आसेन वाट देखणु हींद्‌रोत छे। <verse eid="ROM 9:4"/><verse number="5" style="v" sid="ROM 9:5"/>डाहा-डाहा बी हींद्‌रात छे, ने मसी बी डीलेन भावना सी हींद्‌रेत मां सी पयदा हयु। चु आखान भगवान छे ने जलम बेसकु वारु छे, असोत हवे।<verse eid="ROM 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 9:6"/>बाकुन ज नी की भगवानेन बुल टळ गुयो, हेरेसी ईस्‌रायली अवल्‌यात छे, चे आखा ईस्‌रायली नी हय; <verse eid="ROM 9:6"/><verse number="7" style="v" sid="ROM 9:7"/>ने नी अब्‌राहमेन कुळी मां पयदा हवणेन वजे सी आखा हेरी अवल्‌यात ठेहरे, बाकुन लिखलो छे “इसाक सीत तारी अवल्‌यात कहंवायसे।” <verse eid="ROM 9:7"/><verse number="8" style="v" sid="ROM 9:8"/>मतलब डीलेन अवल्‌यात भगवानेन अवल्‌यात नी, बाकुन वायदान अवल्‌यातेन खानदानी गीणाय जाय। <verse eid="ROM 9:8"/><verse number="9" style="v" sid="ROM 9:9"/>काहाकी वायदान बुल जत छे: “मे टाकली टेमेन अनसारे आवीस, ने तीनी टेमे सारान एक पुर्‌यु हवसे।”<verse eid="ROM 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 9:10"/>ते अतरोत नी, बाकुन जत्‌यार रीबका एक सी मतलब आपणा बास इसाक सी भारीस<note caller="+" style="f"><char style="fr" closed="false">9:10 </char><char style="fq" closed="false">भारीस </char><char style="ft" closed="false">गर्भवती</char></note> हतली, <verse eid="ROM 9:10"/><verse number="11" style="v" sid="ROM 9:11"/>ते हय लग नीते ते पुर्‌या पयदा हतला, नीते चे काय भलो ने भुंडो कर्‌या हेरेसी की भगवानेन मरजी जी छे की हेरे नेवाड़ला अनसारे छे, वारु कामेन वजे सी नी बाकुन बुलावणेन वजे सी, बणी रवे। <verse eid="ROM 9:11"/><verse number="12" style="v" sid="ROM 9:12"/>चु कह्‌यु, “मट्‌लु पुर्‌यु<note caller="+" style="f"><char style="fr" closed="false">9:12 </char><char style="fq" closed="false">मट्‌लु पुर्‌यु </char><char style="ft" closed="false">जेठा</char></note> नानला पुर्‌यान चाकरी करसे।” <verse eid="ROM 9:12"/><verse number="13" style="v" sid="ROM 9:13"/>जसों लिखलो छे, “मे याकुप सी परम कर्‌यु, बाकुन एसाव सी खुसी नी हयु।”<verse eid="ROM 9:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 9:14"/>हेरेसी हामु काय कहंजे, काय भगवानेन चां भुंडो छे काय? नीयाव नी हवे काय? कदी नी सय मां नीयाव हवे। <verse eid="ROM 9:14"/><verse number="15" style="v" sid="ROM 9:15"/>काहाकी चु मुसा सी कहें, “मे तीना काहना पर बी दया करने लागो ती तेरे पर दया करीस, ने तीना काहना उपर वारु दया करने लागे ती तीना पर वारु दया करीस।” <verse eid="ROM 9:15"/><verse number="16" style="v" sid="ROM 9:16"/>अळतेन जी वात नी हर करने वाळान, नी दवड़ने वाळान बाकुन दया करने वाळा भगवानेन वात छे। <verse eid="ROM 9:16"/><verse number="17" style="v" sid="ROM 9:17"/>काहाकी चुखला सास्‌तुर मां लिखलो छे फीरोन सी कहंलो हतलो, “मे तुसे हेरे वाटे उबु करलु छे की तुसे मे मारी ताकत देखाड़ो, ने मारे नाव सी परचार आखी कळी पर हवे।” <verse eid="ROM 9:17"/><verse number="18" style="v" sid="ROM 9:18"/>हेरेसी भगवान तीना काजे हर करे हेरेत पर दया करे, ने तीना काजे चाहत करे तीनात काजे कयड़ावाळु कर देय।<verse eid="ROM 9:18"/></para>
  <para style="s">भगवानेन रीस ने हेरी दया</para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 9:19"/>तुहुं मारे सी कहंवसु, ती भगवान माणसे पर काहा गुनु लागाड़े? भगवान मरजीन वीरुद कुण कर सके? <verse eid="ROM 9:19"/><verse number="20" style="v" sid="ROM 9:20"/>ए माणुस, तु कुण छे जे भगवान काजे उल्‌टु फीरीन जपाप देय? घड़ायली चीज घड़न्‌या काजे ज कय सके काय, “तु मेसे काजे असु काहा घड़्‌यु?” <verse eid="ROM 9:20"/><verse number="21" style="v" sid="ROM 9:21"/>काय कुमाहरटा काजे धुळा पर हक नी हय एक धुळान गुळा मां सी एक ठाहरु ईज्‌जत करे असु बणावे, ने दीसरा धुळान गुळा सी ईज्‌जत नी करे असु बणावे?<verse eid="ROM 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 9:22"/>की भगवान आपसुत रीस देखाड़े ने आपणी ताकत आवणेन मरजी सी रीसेन ठाहरा, ज खत्‌तम करने वाटे तीयार करलो हतलो, बेसकु दम धरीन सेण कर्‌यु; <verse eid="ROM 9:22"/><verse number="23" style="v" sid="ROM 9:23"/>ने दयान ठाहरा पर तीनु काजे भगवान सेक-सींगार वाटे भगवान पेहलुत सी तीयार कर्‌यु आपसान सेक-सींगारेन धन देखाड़नेन मरजी पुरी कर्‌यु? <verse eid="ROM 9:23"/><verse number="24" style="v" sid="ROM 9:24"/>मतलब हामु जीनुक भगवान नी सीरप यहुदी माणसे मां सी नी, बाकुन नी-यहुदी मां सी बी बुलायु। <verse eid="ROM 9:24"/><verse number="25" style="v" sid="ROM 9:25"/>जसों भगवान होसेन किताप मां सी कहें,</para>
  <para style="q1" vid="ROM 9:25">“जे मारा माणसे नी हतला तीनु काजे,</para>
  <para style="q2" vid="ROM 9:25">मे मारा माणसे कहीन ने जे लाटेक्‌ला।</para>
  <para style="q1" vid="ROM 9:25">नी हतला तीनु काजे लाटेक्‌ला</para>
  <para style="q2" vid="ROM 9:25">मां छे कहीन।<verse eid="ROM 9:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ROM 9:26"/>ने असो हवसे की तीना जागा मां तीनु काजे कहंलो हतलो की तुहुं मारा माणसे नी हय,</para>
  <para style="q2" vid="ROM 9:26">तीनीत जागा पर चे जीवता भगवानेन अवल्‌यात कह्‌वायसे।”<verse eid="ROM 9:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 9:27"/>यसायु ईस्‌रायली माणसेन बारामां आयड़ीन कहें, “चाहजे ईस्‌रायलेन अवल्‌यातेन गिन्‌ती समुदरेन रेतळा बराबर हवणु चाहजे, तेबी हींद्‌रे मां सी थुड़ाक बची जासे।” <verse eid="ROM 9:27"/><verse number="28" style="v" sid="ROM 9:28"/>काहाकी मालीक हेरो बुल कळी पर पुरो करसे धरमी सी छाटात चुखु करसे। <verse eid="ROM 9:28"/><verse number="29" style="v" sid="ROM 9:29"/>जसों यसायु पेहलुत सी कहंलु हतलु, “कदी टुळान मालीक आपणे वाटे काय खानदानी नी छुड़तु, ती आपणु सदोमेन तसा हय जाता, ने अमोरान सहलाणी रवता।”<verse eid="ROM 9:29"/></para>
  <para style="s">ईस्‌रायल भुरसु नी करे</para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 9:30"/>ती आपणु काय कहंजे, ज की नी-यहुदी धरमेन हेर नी करतेला, तीना काजे धरम जड़ी गुयलो मतलब ईनी धरम काजे ज भुरसा सी छे; <verse eid="ROM 9:30"/><verse number="31" style="v" sid="ROM 9:31"/>बाकुन ईस्‌रायली, ज्‌य धरमेन मुसान साहरे लिखला कायदा काजे हेर तेला तीना कायदा लग नी पुग्‌या। <verse eid="ROM 9:31"/><verse number="32" style="v" sid="ROM 9:32"/>काय वाटे? हेरेसी चे भुरसा सी नी, बाकुन वारलु काम करने सी हेरी हेर करतेला। चे तीनाक ठुकरायला दगड़ा पर ठुकर खादा, <verse eid="ROM 9:32"/><verse number="33" style="v" sid="ROM 9:33"/>जसों लिखलो छे:</para>
  <para style="q1" vid="ROM 9:33">“देखु, मे सीयोन मां एक दगड़ु,</para>
  <para style="q2" vid="ROM 9:33">मेक र्‌यु ने जु ठुकर देवाड़े ने एक चापर्‌यु जु गुनु कराड़े,</para>
  <para style="q2" vid="ROM 9:33">बाकुन चु जु हीना मां भुरसु करे।</para>
  <para style="q1" vid="ROM 9:33">तीनाक कदी बी लाजवायणु नी पड़े।”<verse eid="ROM 9:33"/></para>
  <chapter eid="ROM 9"/>
  <chapter number="10" style="c" sid="ROM 10"/>
  <para style="p">
    <verse number="1" style="v" sid="ROM 10:1"/>ए भायसे, मारा मनेन मरजी ने मे भगवान सी हींद्‌रे आखा वाटे दुवा करो की हीनुक छुटकारु जड़े। <verse eid="ROM 10:1"/><verse number="2" style="v" sid="ROM 10:2"/>काहाकी मे हींद्‌री गवाय दम की तीनु काजे भगवानेन धुन मां रवे, बाकुन अकलेन साते नी। <verse eid="ROM 10:2"/><verse number="3" style="v" sid="ROM 10:3"/>काहाकी चे भगवानेन धरमेन काम सी अणजाण्‌या हय्‌न, ने आपणो वारलु बणावणे करीन छाटात, भगवानेन वारलु हक मां नी हया। <verse eid="ROM 10:3"/><verse number="4" style="v" sid="ROM 10:4"/>मसी कायदा काजे सार देदु काहाकी जु कुय भुरसु करे भगवान वाटे धरम वाळु हवे।<verse eid="ROM 10:4"/></para>
  <para style="s">छुटकारु आखा वाटे छे</para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 10:5"/>काहाकी मुसु ज लिखलु छे की जु माणुस ईना धरम पर ज कायदा सी छे, चाले, चु हेरे वजे सी जीवतु रवसे। <verse eid="ROM 10:5"/><verse number="6" style="v" sid="ROM 10:6"/>बाकुन ज वारलु भुरसा सी छे, च असु कहें, “तु आपणा मन मां ज घुण कहें की सरग पर कुण चड़से?” मतलब मसी काजे उतारीन लावणे वाटे। <verse eid="ROM 10:6"/><verse number="7" style="v" sid="ROM 10:7"/>जां “पाताळ<note caller="+" style="f"><char style="fr" closed="false">10:7 </char><char style="ft" closed="false">अधोलोक</char></note> मां कुण उतरसे?” मतलब मसी काजे मरला मां सी जीवाड़ीन उपर लावणे वाटे। <verse eid="ROM 10:7"/><verse number="8" style="v" sid="ROM 10:8"/>बाकुन ज खरलो सास्‌तुर काय कहें? ज की “बुल तारे धड़े छे, तारा मुंहडा मां ने तारा मन मां छे” ज तीनात भुरसान बुल छे, ज्‌य आपणु परचार करजे, <verse eid="ROM 10:8"/><verse number="9" style="v" sid="ROM 10:9"/>की कदी तु तारा मुंहडा सी ईसु काजे मालीक जाणीन हुकारु भरे<note caller="+" style="f"><char style="fr" closed="false">10:9 </char><char style="fq" closed="false">हुकारु भरे </char><char style="ft" closed="false">अंगीकार</char></note>, ने आपणा मन सी भुरसु करे की भगवान ईसु काजे मरलाम सी जीवाड़्‌यु, ती तुसेक छाचलीन छुटकारु जड़से। <verse eid="ROM 10:9"/><verse number="10" style="v" sid="ROM 10:10"/>काहाकी धरम वाटे मन सी भुरसु करनु पड़े, ने छुटकारा वाटे मुंहडा सी हुकारु भरनु पड़े। <verse eid="ROM 10:10"/><verse number="11" style="v" sid="ROM 10:11"/>काहाकी चुखला सास्‌तुर मां ज कहंलो छे, “जे कुय तीना पर भुरसु करसे तीनु काजे कदी बी लाजवायणु<note caller="+" style="f"><char style="fr" closed="false">10:11 </char><char style="ft" closed="false">लज्जित</char></note> नी पड़े।” <verse eid="ROM 10:11"/><verse number="12" style="v" sid="ROM 10:12"/>यहुदीया ने नी-यहुदी मां काय बी छीट नी हय, हेरेसी की चु आखान मालीक छे ने आपणे आखा नाव लेण्‌या वाटे दयाळु छे। <verse eid="ROM 10:12"/><verse number="13" style="v" sid="ROM 10:13"/>काहाकी, “जु कुय मालीकेन नाव लेसे, तीना काजे छुटकारु जड़से।”<verse eid="ROM 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 10:14"/>पछेन तीना पर चे भुरसु नी कर्‌या, चे हेरो नाव कसा लेसे? ने तेर बारामां सामळ्‌या नी तीना पर कसा भुरसु करसे? ने परचार सामळावन्‌या पाखुर कसा सामळसे? <verse eid="ROM 10:14"/><verse number="15" style="v" sid="ROM 10:15"/>ने कदी मकली नी जाय, ती कसा परचार करसे? जसों लिखलो छे, “हींद्‌रा पाय बेसका वारु छे, जे वारलु वातेन खुस-खबर सामळावे।” <verse eid="ROM 10:15"/><verse number="16" style="v" sid="ROM 10:16"/>बाकुन आखा तीना खुस-खबर पर कान्‌टा नी लागाड़्‌या यसायु कहें, “ए मालीक कुण आपणा खबर पर भुरसु कर्‌या?” <verse eid="ROM 10:16"/><verse number="17" style="v" sid="ROM 10:17"/>अळतेन भुरसु सामळने सी ने सामळावनु मसीन बुल सी हवे।<verse eid="ROM 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 10:18"/>बाकुन मे कहं चे नी सामळ्‌या? सामळ ते खरीन; काहाकी लिखलो छे,</para>
  <para style="q1" vid="ROM 10:18">“हींद्‌री अवाज आखी कळी पर,</para>
  <para style="q2" vid="ROM 10:18">ने हींद्‌रो बुल कळीन छेव लग पुग गुयो।”<verse eid="ROM 10:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 10:19"/>अळी मे कहं काय, ईस्‌रायली नी जाणतेला काय? पेहलुत मुसु कहें,</para>
  <para style="q1" vid="ROM 10:19">“मे हींद्‌रे साहरे जे जाती नी हय,</para>
  <para style="q2" vid="ROM 10:19">तींद्‌रा मन मां रीस पयदा करीस;</para>
  <para style="q1" vid="ROM 10:19">ने एक हेट्‌या माणसेन साहरे,</para>
  <para style="q2" vid="ROM 10:19">मे तुहुं काजे रीस देवाड़ीस।”<verse eid="ROM 10:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 10:20"/>अळतेन यसायु हिम्‌मत राखीन कहें,</para>
  <para style="q1" vid="ROM 10:20">“जे मेसे नी हेर तेला, चे बी मेसे हेर लेदा;</para>
  <para style="q2" vid="ROM 10:20">ने जे मेसे पुछतेला बी नी, हींद्‌रे पर मे उजेंतु<note caller="+" style="f"><char style="fr" closed="false">10:20 </char><char style="ft" closed="false">प्रगट</char></note> हय गुयु।”<verse eid="ROM 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 10:21"/>बाकुन ईस्‌रायलेन बारामां चु असु कहें, “मे आखु दाहड़ु मारु हात एक हुकुम नी मान्‌ने वाळा ने कीच-कीच करने वाळा माणसे भीणी फेलाय र्‌यु।”<verse eid="ROM 10:21"/></para>
  <chapter eid="ROM 10"/>
  <chapter number="11" style="c" sid="ROM 11"/>
  <para style="s">ईस्‌रायली माणसे पर भगवानेन गीण-दया</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 11:1"/>हेरेसी मे कह्‌वो, काय भगवान हेरा माणसे काजे छुड़ देदु काय? कदी नी मे बी ते ईस्‌रायली छे; अब्‌राहमेन खानदानी ने बीन्‌यामीन कुळी<note caller="+" style="f"><char style="fr" closed="false">11:1 </char><char style="ft" closed="false">गोत्र</char></note> मां सी छे। <verse eid="ROM 11:1"/><verse number="2" style="v" sid="ROM 11:2"/>भगवान हेरा तीनु माणसे काजे नी छुड़्‌यु, जीनु काजे हयु पेहलुत सी जाण्‌यु। काय तुहुं नी जाणता की चुखला सास्‌तुर मां एलीयान बारामां काय कह्‌वे, की ईस्‌रायलेन वीरुद मां भगवान सी लीलघाया करु? <verse eid="ROM 11:2"/><verse number="3" style="v" sid="ROM 11:3"/>“ए मालीक, चे तारा भगवानेन अघी सी आवणे वाळी वात देखान्‌या काजे मार नाख्‌या, ने तेरी वेदी काजे उदार देदा; ने मेत एखलुत रय र्‌यु, ने चे मारा जीव काजे बी मार नाखणे करीन हेर र्‌या।” <verse eid="ROM 11:3"/><verse number="4" style="v" sid="ROM 11:4"/>बाकुन भगवान सी एलीया काजे काय जपाप जड़्‌यो? “मे आपणे वाटे सात हजार अदमी काजे राखी र्‌यु, चे बाल देवता अगळ मांडा नी टेक्‌या।” <verse eid="ROM 11:4"/><verse number="5" style="v" sid="ROM 11:5"/>ईनीत रीती सी ईनी टेमे बी, गीण-दया सी नेवाड़ला माणसे रवला छे। <verse eid="ROM 11:5"/><verse number="6" style="v" sid="ROM 11:6"/>कदी जे गीण-दया सी हयु, ती पछेन वारलु काम सी नी; नीते दया पछेन दया नी रय।<verse eid="ROM 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 11:7"/>हेरेसी सार काय नीकळ्‌यु? ज की ईस्‌रायली माणसे तेरी हेर मां हतला, च तीनु काजे नी जड़्‌यो; बाकुन नेवाड़ला काजे जड़्‌यो, ने रवला माणसे मन कयड़ावाळा हय गुया। <verse eid="ROM 11:7"/><verse number="8" style="v" sid="ROM 11:8"/>जसों लिखलो छे, “भगवान हीनु काजे आजुन दाहड़े लग बेसकी भारी नीदेन आत्‌मा मां नाख र्‌यु, ने असा डुळा आप्‌यु जे नी देखे ने असा कान्‌टा आप्‌यु जे नी सामळे।” <verse eid="ROM 11:8"/><verse number="9" style="v" sid="ROM 11:9"/>ने दावुद कहें,</para>
  <para style="q1" vid="ROM 11:9">“हींद्‌रो खाणो हींद्‌रे वाटे जाळ ने फांद,</para>
  <para style="q2" vid="ROM 11:9">ने ठुकर ने डंडेन वजे हय जाय।<verse eid="ROM 11:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ROM 11:10"/>हींद्‌रा डुळा पर आंदारो छाय जाणु चाहजे काहाकी नी देखणु चाहजे,</para>
  <para style="q2" vid="ROM 11:10">ने तु जलम हींद्‌रा आस काजे वाकु वाळीन राख्‌जी।”<verse eid="ROM 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 11:11"/>अळतेन मे कहं काय चे हेरेसी ठुकर खाय ती हीटी पड़्‌या? कदी नी बाकुन हींद्‌रे पापेन वजे सी नी-यहुदी काजे छुटकारु जड़्‌यो, की हीनु काजे जळन हवे। <verse eid="ROM 11:11"/><verse number="12" style="v" sid="ROM 11:12"/>हेरेसी कदी हींद्‌रु गुनु कळी वाटे धन ने तींद्‌री कमी नी-यहुदी वाटे धनेन वजे हवे, ती तींद्‌री भरपुर सी ते बेसको काय हय जासे।<verse eid="ROM 11:12"/></para>
  <para style="s">दीसरी जातीन छुटकारु</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 11:13"/>मे तुहुंक नी-यहुदी सी जी वात कहं। जत्‌यार की मे नी-यहुदी वाटे नेवताळु छे, ती मे मारा चाकरीन कामेन बड़ाय करो, <verse eid="ROM 11:13"/><verse number="14" style="v" sid="ROM 11:14"/>ईनी आस सी की मे आपणा माणसे मां सी हुड़ पयदा कराड़ीन हींद्‌रे मां ईतराक जणान छुटकारु कराड़ सक। <verse eid="ROM 11:14"/><verse number="15" style="v" sid="ROM 11:15"/>काहाकी जत्‌यार हीनु काजे छुड़ देदु ती कळीन मेळ कराड़नेन टेम आवसे, ती काय तीनु काजे खुळे लेणु मरला मां सी जीवता हवणेन बराबर नी हवे काय?<verse eid="ROM 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 11:16"/>जत्‌यार भेटेन पेहलु हीस्‌सु चुखलु छे, ती चु आखु गुंदलु पीठु बी चुखलु छे; ने जत्‌यार मुळ चुखली रवसे, ती डाळखा बी असात रवसे। <verse eid="ROM 11:16"/><verse number="17" style="v" sid="ROM 11:17"/>बाकुन कदी ईतराक डाळखा तुड़ीन आंग्‌ये कर देय, ने तु जंगली जेतुनेन झाड़कान हय्‌न हींद्‌रे मां कलम हय गुयु, ने जेतुनेन झाड़कान मुळेन चीकणाय मां साजु हयु, <verse eid="ROM 11:17"/><verse number="18" style="v" sid="ROM 11:18"/>ती डाळखा पर मटाय घुण करे; ने कदी तु मटाय करे, ती ज जाण ले की तु मुळ काजे नी बाकुन मुळ<note caller="+" style="f"><char style="fr" closed="false">11:18 </char><char style="fq" closed="false">मुळ </char><char style="ft" closed="false">जड़</char></note> तुसे काजे बचाड़ी रयु।<verse eid="ROM 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 11:19"/>पछेन तु कहंसी, “डाळखा हेरेसी तुड़ी देदला की मे कलम<note caller="+" style="f"><char style="fr" closed="false">11:19 </char><char style="fq" closed="false">कलम </char><char style="ft" closed="false">साटा</char></note> हय जाम।” <verse eid="ROM 11:19"/><verse number="20" style="v" sid="ROM 11:20"/>जी वात छाची छे, की चे ते भुरसु नी करनेन वजे सी तुड़ी देदला, बाकुन तु भुरसा पर बन्‌लु रव हेरेसी मटाय घुण करे, बाकुन बीहतु रवजी, <verse eid="ROM 11:20"/><verse number="21" style="v" sid="ROM 11:21"/>काहाकी जत्‌यार भगवान खास डाळखा काजे नी रहणी देदु ती चु तुसे काजे बी नी रहणी देय। <verse eid="ROM 11:21"/><verse number="22" style="v" sid="ROM 11:22"/>हेरेसी भगवानेन दया ने काठायन तीनी वात पर धी‌यान लागाड़ जे पड़ी गुया हीनु काजे काठायन, बाकुन तारे पर ते दया, कदी हेरे मां बणी रवसी ती नी ते तुसे काजे बी तुड़ी नाखसे। <verse eid="ROM 11:22"/><verse number="23" style="v" sid="ROM 11:23"/>चे बी नी भुरसा मां नी रवसे, ती ते कलम हय जासे; काहाकी भगवान ईनु काजे पछु कलम करसे। <verse eid="ROM 11:23"/><verse number="24" style="v" sid="ROM 11:24"/>काहाकी कदी तु ईना जंगली जेतुन सी, ज सभाव सी जंगली छे, काट नाख्‌या ने सभावेन वीरुद वारलु जेतुन मां कलम हय गुयु, जे खास डाळखा छे, आपणा जेतुन मां काहनी कलम हय जाय।<verse eid="ROM 11:24"/></para>
  <para style="s">ईस्‌रायली माणसेन छुटकारु</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 11:25"/>ए भायसे, काय असो नी हवे की तुहुं आपसा काजे अक्‌कल वाळा समजी लेवु; हेरेसी मे नी चाहतु की तुहुं ईनी वात सी अणजाण्‌या रवु की जत्‌यार लग नी-यहुदी माणसे पुरा नी भराये, तत्‌यार लग ईस्‌रायली माणसेन एक हीस्‌सु काठु रवसे। <verse eid="ROM 11:25"/><verse number="26" style="v" sid="ROM 11:26"/>ने ईनी रीत सी आखा ईस्‌रायल काजे छुटकारु जड़से। ने असो लिखलो छे,</para>
  <para style="q1" vid="ROM 11:26">“छुड़ावने वाळु सीयोन सी आवसे,</para>
  <para style="q2" vid="ROM 11:26">ने नी भक्‌ती करन्‌या काजे याकुप सी छेटा करसे;<verse eid="ROM 11:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ROM 11:27"/>ने तींद्‌रे साते जु मारु वायदु रवसे,</para>
  <para style="q2" vid="ROM 11:27">जत्‌यार की मे तींद्‌रा पाप काजे छेटु कर दीस।”<verse eid="ROM 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 11:28"/>खुस-खबरेन भाव सी ती तुंद्‌रे वाटे चे भगवानेन वेरी छे, बाकुन नेवाड़ला भाव सी चे बास डुकरान वजे सी लाटेक्‌ला छे। <verse eid="ROM 11:28"/><verse number="29" style="v" sid="ROM 11:29"/>काहाकी भगवानेन वाटु ने बुलावणु जलम एक तसों छे। <verse eid="ROM 11:29"/><verse number="30" style="v" sid="ROM 11:30"/>काहाकी जसा तुहुं पेहेल भगवानेन हुकुम नी मान्‌या, बाकुन हय तेरी हुकुम नी मान्‌ने सी तुंद्‌रे पर दया हवे हेरेसी हींद्‌रे पर बी दया हवे; <verse eid="ROM 11:30"/><verse number="31" style="v" sid="ROM 11:31"/>असात चे बी हय हुकुम नी मान्‌या, की तुंद्‌रे पर दया हवे हेरेसी हींद्‌रे पर बी दया हवे। <verse eid="ROM 11:31"/><verse number="32" style="v" sid="ROM 11:32"/>काहाकी भगवान आखा काजे हुकुम नी माननेन मन बणाय देदु, की चु तींद्‌रे पर बी दया कर सके।<verse eid="ROM 11:32"/></para>
  <para style="s">भगवानेन बड़ाय</para>
  <para style="p">
    <verse number="33" style="v" sid="ROM 11:33"/>भगवानेन दया, डीमाक ने अक्‌कल कतरा उंडो छे हेरो नीयावेन कतरी पुहुच छे हेरी वाट कतरी सातायली छे। <verse eid="ROM 11:33"/><verse number="34" style="v" sid="ROM 11:34"/>मालीकेन अक्‌कल काजे,</para>
  <para style="q1" vid="ROM 11:34">कुण जाण्‌यो?</para>
  <para style="q2" vid="ROM 11:34">नीते हेरु मंत्‌री कुण हयु?<verse eid="ROM 11:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="ROM 11:35"/>नीते कुण भगवान काजे काय आपलु छे</para>
  <para style="q2" vid="ROM 11:35">तेरु बद्‌लु तीना काजे आप देय?<verse eid="ROM 11:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ROM 11:36"/>काहाकी हेरेत भीणी सी, ने हेरेत साहरे, ने हेरेत वाटे आखो काय छे। हेरो सेक-सींगार जलम-जलम हवतो रवे। असोत हवे।<verse eid="ROM 11:36"/></para>
  <chapter eid="ROM 11"/>
  <chapter number="12" style="c" sid="ROM 12"/>
  <para style="s">मसी मां नवलु जीवन</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 12:1"/>तेरेमां ए भायस्‌यो ने बहणीस्‌या, भगवानेन दया हेर कराड़ीन लीलघाय करे की तुहुं तुंद्‌रा डील काजे जीवता जीव भेळे, ने चुखलो, ने भगवान काजे गमे असो बादान सारकु भेट चड़ावु। जीत तुंद्‌री जीव-आत्‌मा मां भगवानेन सेवा-भक्‌ती छे। <verse eid="ROM 12:1"/><verse number="2" style="v" sid="ROM 12:2"/>तुहुं ईनी कळीन माणसेन तसा मां बणु; बाकुन तुहुंक नवली अक्‌कल जड़ गुय करीन आपसो वीच्‌यार ने वेहवार बदली लेवु, असो करसु ती तुहुं भगवानेन वारु, ने गमे तसी, ने पाक्‌की मरजी सय रीते पारखीन जाण जासु।<verse eid="ROM 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 12:3"/>काहाकी मेसेक जड़ली गीण-दया ज तुंद्‌रे मांयन आखा काजे कहं की जसों आपसा काजे समजणु चाहजे तसात आपसा काजे समजु हेरे सी जादा मां समजु बाकुन हेरे वजे सी आपणी वीच्‌यार मां वारु जसु भगवान आखा काजे वाटु आप देदलु छे तेरेत अनसारे वारलु अकलेन अनुसार आपसा काजे समजु। <verse eid="ROM 12:3"/><verse number="4" style="v" sid="ROM 12:4"/>काहाकी जसों आपणा डील मां बेसका डील छे, ने आखा डीलेन एक तसों काम नी हय, <verse eid="ROM 12:4"/><verse number="5" style="v" sid="ROM 12:5"/>तसात आपणु बी बेसका हय्‌न बी ईसु मसी मां एकुत डील मां भेसकायन एक दीसरु डील छे। <verse eid="ROM 12:5"/><verse number="6" style="v" sid="ROM 12:6"/>ने आपणु काजे भगवानेन अगे सी जड़ली गीण-दया अनसारे आंग्‌ये-आंग्‌ये वाटु जड़लु छे अतरे तीना काजे आवणे वाळी वात कहंणेन वाटु जड़लु छे जु भुरसान मापे आवणे वाळी वात कहंणु चाहजे; <verse eid="ROM 12:6"/><verse number="7" style="v" sid="ROM 12:7"/>कदी सेवा चाकरी करनेन वाटु जड़लु हय ती तीनाक सेवा चाकरी करतु रहणु चाहजे, ने कदी काहनाक सीकाड़नेन वाटु जड़लु हय ती तीनाक सीकाड़तु रहणु चाहजे। <verse eid="ROM 12:7"/><verse number="8" style="v" sid="ROM 12:8"/>कदी काहाना काजे सीकाड़ानेन वाटु जड़लु हय चु सीकाड़तु रहणु चाहजे; ने तीनाक भेट आपणेन वाटु जड़लु हय, चु भेट आपणो चाहजे ने तीनाक अगवाय करनेन वाटु जड़लु हय चु खुस हय्‌न अगवाय करतु रहणु चाहजे तीनाक दया करनेन वाटु जड़लु हय चु खुसी सी दया करतु रहणु चाहजे।<verse eid="ROM 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 12:9"/>तुंद्‌रु परम खरलु हवणु चाहजे कुहराय सी छीट राखु; ने भलाय मां लागी रवु। <verse eid="ROM 12:9"/><verse number="10" style="v" sid="ROM 12:10"/>भाय-भलाय परम सी एक दीसरा पर परम करु; एक दीसरान ईज्‌जत सी आव-भाव करने करीन आंबा-सांबा जावु। <verse eid="ROM 12:10"/><verse number="11" style="v" sid="ROM 12:11"/>काठली मेहनत करु आळसी मां बणु; जत्‌यार बी मालीक ईसुन सेवा करु तत्‌यार जीव-आत्‌मा मां खुसी सी सेवा करु। <verse eid="ROM 12:11"/><verse number="12" style="v" sid="ROM 12:12"/>आस मां खुस रवु; दुख मां काठु रवु; ने एक रंग्‌या दुवा करता रवु। <verse eid="ROM 12:12"/><verse number="13" style="v" sid="ROM 12:13"/>चुखला माणसे काजे ज काय चाहजे तीनु काजे च आपीन तींद्‌री मदत करु; तींद्‌री मेजवानी करता रवु।<verse eid="ROM 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 12:14"/>जे तुहुं काजे वेला पाड़ने वाळा; तीनु काजे तुहुं संयबरकत<note caller="+" style="f"><char style="fr" closed="false">12:14 </char><char style="fq" closed="false">संयबरकत </char><char style="ft" closed="false">आशीष</char></note> आपु। <verse eid="ROM 12:14"/><verse number="15" style="v" sid="ROM 12:15"/>खुस हवण्‌या साते खुस हयु; ने रड़ने वाळा साते रड़ु। <verse eid="ROM 12:15"/><verse number="16" style="v" sid="ROM 12:16"/>तुहुं एक वीच्‌यार मां हय्‌न मेळीन रवु; मटाय<note caller="+" style="f"><char style="fr" closed="false">12:16 </char><char style="fq" closed="false">मटाय </char><char style="ft" closed="false">अभिमानी</char></note> मां करु बाकुन नीचळा माणसे सात संगात करु; आपणा नींगा मां अक्‌कल वाळा मां बणु।<verse eid="ROM 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 12:17"/>कुहरायन बदला मां कुहराय मां करु। आखान नींगा मां ज वारु छे चत करनेन वीच्‌यार करु। <verse eid="ROM 12:17"/><verse number="18" style="v" sid="ROM 12:18"/>तत्‌रो बणे तत्‌रा आखा माणसे साते सांती मां रवु। <verse eid="ROM 12:18"/><verse number="19" style="v" sid="ROM 12:19"/>ए लाटेक्‌ला, तुहुं बद्‌लु घुण लेता बाकुन भगवानेन रीस काजे मुखु आप्‌जु; काहाकी खरली सास्‌तुर मां लिखलो छे, बद्‌लु लेणु मारो काम छे, मालीक कहें मेत बद्‌लु लीस। <verse eid="ROM 12:19"/><verse number="20" style="v" sid="ROM 12:20"/>बाकुन कदी तारु वेरी<note caller="+" style="f"><char style="fr" closed="false">12:20 </char><char style="fq" closed="false">वेरी </char><char style="ft" closed="false">बैरी</char></note> भुकलु हय ती तीनाक खावाड़ ने कदी पीसलु हय ती तीनाक पाणी पीयाड़; काहाकी असु करसी ती तु तेरा मुणका पर आकठान ईंगाळान ढीक लागाड़ीस। <verse eid="ROM 12:20"/><verse number="21" style="v" sid="ROM 12:21"/>कुहराय देखीन हिम्‌मत मां हारु बाकुन वारलु काम वाटे कुहराय जीत लेवु।<verse eid="ROM 12:21"/></para>
  <chapter eid="ROM 12"/>
  <chapter number="13" style="c" sid="ROM 13"/>
  <para style="s">सरकारेन हुकुम मानु</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 13:1"/>आखा माणसे काजे सरकारी आफसर्‌यान हक मां रहणु चाहजे, काहाकी सरकारेन हक भगवान भीणी सी छे; ने जे हक हय छे हीनुक भगवान नेवाड़लु छे। <verse eid="ROM 13:1"/><verse number="2" style="v" sid="ROM 13:2"/>हेरेसी जु कुय सरकारी हकेन वीरुद करे, जु भगवानेन कायदान वीरुद करे, ने जे भगवानेन हुकुमेन वीरुद करे, तीनु काजे डंड जड़से। <verse eid="ROM 13:2"/><verse number="3" style="v" sid="ROM 13:3"/>काहाकी हक करन्‌या वारलु कामे सी नी, बाकुन भुंडला कामे सी बीहणे वजे छे; हेरेसी कदी तुसे काजे हक करन्‌या नेता सी बीहे पाखुर रहणु हय, ती वारलु काम कर, ती हक करन्‌यु नेतु तुसे काजे बेसकु वारु कर्‌यु करीन कहंसे<note caller="+" style="f"><char style="fr" closed="false">13:3 </char><char style="fq" closed="false">वारु कर्‌यु करीन कहंसे </char><char style="ft" closed="false">सराहना</char></note>; <verse eid="ROM 13:3"/><verse number="4" style="v" sid="ROM 13:4"/>काहाकी राज करन्‌यु नेतु तारी भलाय वाटे भगवानेन चाकर्‌यु छे। बाकुन कदी तु कुहराय करे, ती बीहीन रवजी, काहाकी चु फालतु तलवार लीन उबु नी रवे; बाकुन चु भगवानेन चाकरी करन्‌यु छे काहाकी चु भगवानेन रीसेन अनसारे कुहर्‌या काजे डंड आपे। <verse eid="ROM 13:4"/><verse number="5" style="v" sid="ROM 13:5"/>हेरेसी हक मां रहणु भगवानेन रीसेन मार्‌यु अतरुत नी, बाकुन बीहीन बी हक मां रहणु चाहजे बाकुन आपणो मन बी हक मां रहणु चाहजे।<verse eid="ROM 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 13:6"/>हेरसी फाळु बी आपु काहाकी भगवानेन चाकर्‌या छे ने चे जलम ईनात काम मां लागला रवे। <verse eid="ROM 13:6"/><verse number="7" style="v" sid="ROM 13:7"/>हेरेसी आखान हक काजे पुरो करे; तीना काजे फाळु आपणु चाहजे, तीना काजे फाळु आपु; तीना काजे वसोली चाहजे, तीना काजे वसोली आपु; तीना सी बीहणु चाहजे तेरे सी बीहु, तेरी ईज्‌जत करनु चाहजे, तेरी ईज्‌जत करु।<verse eid="ROM 13:7"/></para>
  <para style="s">एक दीसरान तकलीप काजे सामळु</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 13:8"/>आंबा-सांबा परम करनु छुड़ीन दीसरी काहली बी वातेन करजा वाळा नी हवणु चाहजे; काहाकी जु दीसरा काजे परम करे, चु मुसान कायदा काजे पाळी लेदलु छे। <verse eid="ROM 13:8"/><verse number="9" style="v" sid="ROM 13:9"/>काहाकी ज्‌य की “छीनाळो घुण करे, खुन घुण करे, चुरी घुण करे, लालुच घुण करे।” ने काहनु बी हुकुम हय तीना हुकुमेन जु जीत साहरु छे, “आपणे साते वाळा काजे आपणेन तसा परम करु।” <verse eid="ROM 13:9"/><verse number="10" style="v" sid="ROM 13:10"/>परम धड़े वाळान काय बी कुहराय नी करे, हेरे सी परम करनु मुसान कायदा काजे पुरो करनु छे।<verse eid="ROM 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 13:11"/>ने तुहुं टेम काजे उळखीन असात करु, तुहुं जाणु की नीद मां सी जागणेन टेम आय गुयली छे; काहाकी जीनी टेमे आपणु ईसु पर भुरसु करला, तीने टेमेन वीच्‌यार सी हय आपणु छुटकारु धड़ेत आय गुयलु छे। <verse eid="ROM 13:11"/><verse number="12" style="v" sid="ROM 13:12"/>रात बेसकी हय गुयली छे, दाहड़ु उंगणेत वाळु छे; हेरेसी आपणु आंदारलान काम छुड़ीन आपणु वीजाळान हत्‌यार धर लेता। <verse eid="ROM 13:12"/><verse number="13" style="v" sid="ROM 13:13"/>हेरेसी हामु असात वारु रीती सी रहणु चाहजे जसा दीसुन टेमे रवजे, बेसका जादा पाल्‌टी मां जाय्‌न पी खाय्‌न छाकी घुण जावु। लुच्‌चाय गुना छीनाळा मां घुण पड़ु। <verse eid="ROM 13:13"/><verse number="14" style="v" sid="ROM 13:14"/>बाकुन मालीक ईसु मसी काजे पुथल्‌यान तसु पेहरी लेजु ने डीलेन पाप पुरो करनेन वीच्‌यार नी करनु चाहजे।<verse eid="ROM 13:14"/></para>
  <chapter eid="ROM 13"/>
  <chapter number="14" style="c" sid="ROM 14"/>
  <para style="s">आपणा भायस पर गुनु घुण लागाड़ु</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 14:1"/>जु भुरसा मां लुलु छे, तीना काजे सात संगात मां ली लेवु, बाकुन संक्‌यान वात पर कीच-कीच घुण करु। <verse eid="ROM 14:1"/><verse number="2" style="v" sid="ROM 14:2"/>काहाकी एक भुरसु करे, की आखो काय खाणु चाहजे बाकुन जु भुरसा मां लुलु छे चु सब्‌जी-भाजी अतरुत खाय। <verse eid="ROM 14:2"/><verse number="3" style="v" sid="ROM 14:3"/>खाणे वाळु नी खाणे वाळा काजे भुंडुत नी समजणु चाहजे, ने नी खाणे वाळु खाणे वाळा पर गुनु नी लागाड़नु चाहजे; काहाकी भगवान तीना काजे आवरी लेदलु छे। <verse eid="ROM 14:3"/><verse number="4" style="v" sid="ROM 14:4"/>तु कुण छे दीसरा पावर्‌या पर गुनु लागाड़े? तेरा भुरसा मां टेकलु रहणु टेकलु नी रहणु तेरो मालीक साते काम छे; ने मालीक तीना काजे भुरसा मां पाक्‌कु कर देसे, काहाकी मालीक तीना काजे भुरसा मां टेकलु राख्‌से।<verse eid="ROM 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 14:5"/>काहनुक ते एक दाहड़ा काजे दीसरा दाहड़ा सी जादा वारु समजे, ने काहनुक ते आखा दाहड़ा काजे एक सारकु समजे। आखा आपसान मन मां ठान<note caller="+" style="f"><char style="fr" closed="false">14:5 </char><char style="fq" closed="false">ठान </char><char style="ft" closed="false">निश्चय</char></note> लेवु की काहनी वात ताले छे। <verse eid="ROM 14:5"/><verse number="6" style="v" sid="ROM 14:6"/>चु काहना दाहड़ा काजे वारु माने, चु मालीक वाटे माने। जु खाय, चु बी मालीक वाटे खाय, काहाकी चु भगवान काजे तु बेसकु वारु छे करीन कहें, जु नी खाय, चु मालीक वाटे नी खाय, ने भगवान काजे तु बेसकु वारु छे कहें। <verse eid="ROM 14:6"/><verse number="7" style="v" sid="ROM 14:7"/>काहाकी आपणे मां सी नीते कुय आपसान वाटे जीवे ने नी कुय आपसान वाटे मरे। <verse eid="ROM 14:7"/><verse number="8" style="v" sid="ROM 14:8"/>कदी आपणु जीवतेला रवजे, ती मालीकेन वाटे जीवता रवजे; ने कदी आपणु मर जाजे, ती मालीकेन वाटे मर जाजे; हेरेसी भले आपणु जीवता रवजे नीते मर जाजे, आपणु मालीकेन वाटे छे। <verse eid="ROM 14:8"/><verse number="9" style="v" sid="ROM 14:9"/>काहाकी मसी हेरेसी मर्‌यु ने मरला मां सी जीवतु हय्‌न बठु हय गुयु की चु मरला ने जीवतेला दुय जणान मालीक छे।<verse eid="ROM 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 14:10"/>तु आपणा भायस पर गुनु काहा लागाड़े? नीते तु आपणा भायस काजे छीट काहा राखे? आपणु आखा ने आखा काजे भगवानेन नीयावेन अगळ उबा रवणु पड़से। <verse eid="ROM 14:10"/><verse number="11" style="v" sid="ROM 14:11"/>काहाकी लिखलो छे,</para>
  <para style="q1" vid="ROM 14:11">“मालीक कहें, मारी जीवणेन आण आखा,</para>
  <para style="q2" vid="ROM 14:11">माणसे मारे अगळ मांडा टेकसे,</para>
  <para style="q2" vid="ROM 14:11">ने आखा माणसे भगवान काजे हुकार लेसे।”<verse eid="ROM 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 14:12"/>हेरेसी आपणु आपणे मां सी आखा ने आखा भगवान काजे आपणु लेखु देणु पड़से।<verse eid="ROM 14:12"/></para>
  <para style="s">आपणा भायसेन पापेन वजे मां बणु</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 14:13"/>हेरेसी हय सी हेरे पर गुनु मां लागाड़ु, बाकुन तुहुं ज ठाणी लेवु की कुय आपणा भायस अगळ अड़चन पयदा करीन ठुकर खाणेन वजे घुण बणु। <verse eid="ROM 14:13"/><verse number="14" style="v" sid="ROM 14:14"/>मे जाणो की मालीक ईसु मसीन साहरे पाक्‌की वात मालम हय गुयली छे की काहानी बी चीज वीटळ्‌ली नी हय, बाकुन जे कुय तीनी चीज काजे वीटळ्‌ली समजे तेरे वाटे ची चीज वीटळ्‌ली छे। <verse eid="ROM 14:14"/><verse number="15" style="v" sid="ROM 14:15"/>कदी तारु भायस खाणान वजे सी नीरास हवे, ती तु परम सी नी चाल र्‌यु; तेरे वाटे ईसु मसी मर गुयलु छे, तीना काजे तु खाणान वजे सी सारे मां। <verse eid="ROM 14:15"/><verse number="16" style="v" sid="ROM 14:16"/>हेरेसी तारी भलाय वाटे कुय बी तारु वाक नी नीकाळनु चाहजे। <verse eid="ROM 14:16"/><verse number="17" style="v" sid="ROM 14:17"/>काहाकी भगवानेन राज खाणे पीणेन नी हय, बाकुन धरमेन साहरे ने सांती ने ची खुसी छे ज्‌य चुखली-आत्‌मा सी हवे। <verse eid="ROM 14:17"/><verse number="18" style="v" sid="ROM 14:18"/>ने जु कुय ईनी रीत सी जीवे चु ईसु मसीन चाकरी करे ने असु करे, ती भगवान काजे गमे ने माणसे मां बी तेरु अबरु रय जाय।<verse eid="ROM 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 14:19"/>हेरेसी आपणु हीनी वातेन हेर करनु चाहजे तेरसी सांती मां रवजे ने एक दीसरा काजे सुदार हवणु चाहजे। <verse eid="ROM 14:19"/><verse number="20" style="v" sid="ROM 14:20"/>खाणा सी भगवानेन काम मां बीगाड़े। आखो काय चुखो ते छे, बाकुन ज तीना माणसे वाटे भुंडो छे। ज खाणो दीसरा भायस काजे ठुकर खावाड़े। <verse eid="ROM 14:20"/><verse number="21" style="v" sid="ROM 14:21"/>भलो ते ईनी वात मां छे की सीकार<note caller="+" style="f"><char style="fr" closed="false">14:21 </char><char style="fq" closed="false">सीकार </char><char style="ft" closed="false">माँस</char></note> घुण खाय ने अंगुरेन रस बी घुण पीये, ने काहनो बी असो काम घुण करे तीनी वात सी तारु भायस ठुकर खाय। <verse eid="ROM 14:21"/><verse number="22" style="v" sid="ROM 14:22"/>ईनी चीजेन बारामां जु बी तारु भुरसु छे, तीना भुरसा काजे भगवानेन ने तारे ईचमां रवणी दे। बेसकु वारु छे चु जु ईनी वात मां, आपसा काजे तालेत समजे, ने आपसा काजे गुनाळु नी ठेहरावे। <verse eid="ROM 14:22"/><verse number="23" style="v" sid="ROM 14:23"/>बाकुन जु कुय संका करीन खाय चु आपसात पर डंड लावे, काहाकी चु पाक्‌का भुरसा भेळु नी खाय; ने जु कुय पाक्‌का भुरसा भेळु नी खाय, चु पाप करे।<verse eid="ROM 14:23"/></para>
  <chapter eid="ROM 14"/>
  <chapter number="15" style="c" sid="ROM 15"/>
  <para style="s">दीसरा वाटे बी सुचु</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 15:1"/>हेरेसी आपणु ताकतवाळा<note caller="+" style="f"><char style="fr" closed="false">15:1 </char><char style="fq" closed="false">ताकतवाळा </char><char style="ft" closed="false">बलवानों</char></note> छे करीन तेरेसी आपणु काजे जे लुला माणसेन लुलाय मां मदत करनु चाहजे, ने आपसात काजे खुस नी करनु चाहजे। <verse eid="ROM 15:1"/><verse number="2" style="v" sid="ROM 15:2"/>आपणे मां सी जतरा बी जणा छे आपणे धड़े वाळा काजे हेरी भलाय वाटे खुसी करे की चु अगु बड़े। <verse eid="ROM 15:2"/><verse number="3" style="v" sid="ROM 15:3"/>काहाकी मसी बी आपसा काजे खुस नी कर्‌यु, बाकुन जसों लिखलो छे, “चे जसात तारी वाक नीकाळे तसात मारी वाक बी नीकाळी र्‌या।” <verse eid="ROM 15:3"/><verse number="4" style="v" sid="ROM 15:4"/>जतरी वाते पेहेलुत सी खरला सास्‌तुर मां लिखलो हतलो, च आपणु काजे सीकाड़ने वाटे लिखली हतली की आपणु दम धरीन ने चुखला सास्‌तुरेन सांतीन साहरे आस राखजे। <verse eid="ROM 15:4"/><verse number="5" style="v" sid="ROM 15:5"/>दम धरीन ने सांती आपण्‌यु भगवान तुहुं काजे जु वाटु आपे की मसी ईसुन अनसारे आपसा-आपसा मां एक वीच्‌यार मां हय्‌न रवु। <verse eid="ROM 15:5"/><verse number="6" style="v" sid="ROM 15:6"/>काहाकी तुहुं एक मन ने एक रेंग मां आपणा मालीक ईसु मसीन बास भगवानेन बड़ाय करु।<verse eid="ROM 15:6"/></para>
  <para style="s">आखा वाटे खुस-खबर</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 15:7"/>हेरेसी, जसु मसी भगवानेन सेक-सींगार वाटे तुहुं काजे हुकारलु छे, असात तुहुं बी एक दीसरा काजे हुकारी लेवु। <verse eid="ROM 15:7"/><verse number="8" style="v" sid="ROM 15:8"/>हेरेसी मे कहं की जु वायदु डाहा बुड़ा काजे आपलु हतलु तीनु काजे काठा करने वाटे मसी, भगवानेन छाचाय देखाड़ने वाटे, फतरी काटाण्‌या यहुदी माणसेन चाकरी करन्‌यु बण्‌यु, <verse eid="ROM 15:8"/><verse number="9" style="v" sid="ROM 15:9"/>ने नी-यहुदी बी दयान वजे सी भगवानेन बड़ाय करे; जसों लिखलो छे,</para>
  <para style="q1" vid="ROM 15:9">“हेरेसी मे जाती-जाती मां तु बेसकु वारु छे करीन कहंवीस,</para>
  <para style="q2" vid="ROM 15:9">ने तारे नावेन गीत गावीस।”<verse eid="ROM 15:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 15:10"/>अळतेन कहलो छे,</para>
  <para style="q1" vid="ROM 15:10">“ए जाती नी-यहुदी आखा माणसे, भगवानेन भेळा खुस रवु।”<verse eid="ROM 15:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 15:11"/>ने पछेन,</para>
  <para style="q1" vid="ROM 15:11">“ए जाती नी-यहुदी आखा माणसे, मालीकेन बड़ाय करु;</para>
  <para style="q2" vid="ROM 15:11">ने राज राजेन आखा माणसे तीना काजे तु बेसकु वारु छे करीन कहुं।”<verse eid="ROM 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 15:12"/>ने पछेन यसायु कहें,</para>
  <para style="q1" vid="ROM 15:12">“यीसेन एक मुळ उजेंतु हवसे,</para>
  <para style="q2" vid="ROM 15:12">ने नी-यहुदी जातीन माणसे मां राज करने वाटे उजेंतु हवसे,</para>
  <para style="q2" vid="ROM 15:12">हेरे पर नी-यहुदी आस राख्‌से।”<verse eid="ROM 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 15:13"/>भगवान जु आस काजे आपण्‌यु छे तुहुं काजे भुरसु करने मां आखी खुसी ने सांती मां भर देय की चुखली-आत्‌मान ताकत सी तुंद्‌री आस मटी हवती जाय।<verse eid="ROM 15:13"/></para>
  <para style="s">हिम्‌मत सी लिखणेन वजे</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 15:14"/>ए मारा भायसे, मे खुद तुंद्‌रे बारामां जाणो की तुहुं बी आपसा भगवानेन भलाय ने भगवानेन अक्‌कल सी पुरा ने पुरा भरायला छे, ने एक दीसरा काजे सीकाड़ सकु। <verse eid="ROM 15:14"/><verse number="15" style="v" sid="ROM 15:15"/>तेबी मे कांखुर-कांखुर हेर कराड़ने वाटे तुहुं ज बेसका हिम्‌मत करीन लिख्‌या। ज ईनी गीण-दयान वजे सी हयो ज भगवान मेसे काजे आप्‌यु। <verse eid="ROM 15:15"/><verse number="16" style="v" sid="ROM 15:16"/>की नी-यहुदी वाटे मसी ईसुन चाकरी करन्‌यु हय्‌न भगवानेन खुस-खबरेन चाकरी पुजारान तसु करो, तेरसी नी-यहुदी भगवान अगळ गमे असी भेट बण जाय, ने चुखली-आत्‌मान सी भगवान वाटे पुरा ने पुरा चुखला बण जाय। <verse eid="ROM 15:16"/><verse number="17" style="v" sid="ROM 15:17"/>हेरेसी हीनी वातेन बारामां ज भगवान सी नातो राख्‌से, ने ईसु मसी मां बड़ाय कर सको। <verse eid="ROM 15:17"/><verse number="18" style="v" sid="ROM 15:18"/>काहाकी हीनी वात काजे छुड़ीन मेसेक अळी काहनीक वात कहंणेन बारामां हिम्‌मत नी हय, जु मसी नी-यहुदीन हकेन वाटे बुल, ने काम, <verse eid="ROM 15:18"/><verse number="19" style="v" sid="ROM 15:19"/>ने सहलाणी, ने छेल-भात्‌या कामेन ताकत, सी ने चुखली-आत्‌मान ताकत सी मारे साहरे कर्‌यु; जां लग की मे यरुसलेम सी लीन चारे मेर इल्‌लुरकुम लग मसीन खुस-खबर पुरो-पुरो परचार कर्‌यु। <verse eid="ROM 15:19"/><verse number="20" style="v" sid="ROM 15:20"/>बाकुन मारी हर जी छे की जां-जां मसीन नाव नी लेदा, चां-चां खुस-खबर सामळावो असो नी हवे की दीसरान नेहा<note caller="+" style="f"><char style="fr" closed="false">15:20 </char><char style="fq" closed="false">नेहा </char><char style="ft" closed="false">नींव</char></note> पर घर बणावो। <verse eid="ROM 15:20"/><verse number="21" style="v" sid="ROM 15:21"/>बाकुन जसों लिखलो छे तसोत हवे,</para>
  <para style="q1" vid="ROM 15:21">“जीनु काजे तेरो खुस-खबर नी पुग्‌यो,</para>
  <para style="q2" vid="ROM 15:21">चेत देखसे ने जे नी सामळ्‌या चेत सामळसे।”<verse eid="ROM 15:21"/></para>
  <para style="s">रोम मां पोलुस जाणेन तीयारी कर्‌यु</para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 15:22"/>हेरेसी मे तुंद्‌रेन्‌चां अळी-अळीन आवणे नी हींड रवलु। <verse eid="ROM 15:22"/><verse number="23" style="v" sid="ROM 15:23"/>बाकुन हय ईनु देस मां मारे काम वाटे कुय जागा नी रवी, ने बेसका साल मां तुंद्‌रे धड़े आवणेन हर कर र्‌यु। <verse eid="ROM 15:23"/><verse number="24" style="v" sid="ROM 15:24"/>हेरेसी जत्‌यार ईस्‌पेन जायस ती तुंद्‌रेन्‌चां मांयन जायस, काहाकी मे जी आस कर र्‌यु की तीने टेमे मे तुहुं काजे मेळीस, ने मे तुहुं काजे मेळीन खुस हय जायस ने अळतेन तुहुं ईतराक अगास मेसे मेली आवजु। <verse eid="ROM 15:24"/><verse number="25" style="v" sid="ROM 15:25"/>बाकुन मे हय ते चुखला माणसेन चाकरी करने करीन यरुसलेम सहर मां जाणे बाजी र्‌यु। <verse eid="ROM 15:25"/><verse number="26" style="v" sid="ROM 15:26"/>काहाकी मकीदुनीया ने अखायान माणसे काजे ज वारु लाग्‌यो की यरुसलेम चुखला माणसे मां गरीब वाटे चंदु भेळु करीन आपे। <verse eid="ROM 15:26"/><verse number="27" style="v" sid="ROM 15:27"/>वारु ते लाग्‌यो बाकुन चे हींद्‌रा करजा वाळा बी छे, काहाकी नी-यहुदी ईसुन माणसे आत्‌मान काम मां यहुदी माणसे साते साजल्‌या बणी गुयलु छे, हेरेसी नी-यहुदी काजे बी यहुदी माणसे वाटे डीलेन वात मां हींद्‌री सेवा करनु चाहजे। <verse eid="ROM 15:27"/><verse number="28" style="v" sid="ROM 15:28"/>हेरेसी ज काम खत्‌तम करीन ने तीनु काजे भेळु करलु चंदु आपीन तुंद्‌रेन्‌चां मांयन ईस्‌पेन जायस। <verse eid="ROM 15:28"/><verse number="29" style="v" sid="ROM 15:29"/>ने मेसे काजे मालम छे जत्‌यार मे तुंद्‌रे भीणी आवीस, ती मसीन पुरी संयबरकत लीन आवीस।<verse eid="ROM 15:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 15:30"/>ए भायसे, आपणा मालीक ईसु मसी काजे ने चुखला आत्‌मान परम काजे अटकळ कराड़ीन लीलघायो, की मारे वाटे भगवान धड़े दुवा करने मां मारे साते भेसकायन झींग पड़ीन दुवा करता रवु। <verse eid="ROM 15:30"/><verse number="31" style="v" sid="ROM 15:31"/>की मे यहुदी माणसे जे भुरसु नी करे तींद्‌रे सी बचीन रव, ने मारी चाकरी जी यरुसलेम वाळा माणसे वाटे छे, ची चुखला माणसे काजे गमणु चाहजे; <verse eid="ROM 15:31"/><verse number="32" style="v" sid="ROM 15:32"/>ने मे भगवानेन मरजी सी तुंद्‌रे ईचमां खुस हय आवीन तुंद्‌रे साते ईतरीक वार आराम करीस। <verse eid="ROM 15:32"/><verse number="33" style="v" sid="ROM 15:33"/>सांती आपण्‌यु भगवान तुंद्‌रे आखा साते रवे, असोत हवे।<verse eid="ROM 15:33"/></para>
  <chapter eid="ROM 15"/>
  <chapter number="16" style="c" sid="ROM 16"/>
  <para style="s">रोम सहर मां रवण्‌या ईसुन माणसे काजे पोलुस सीकाड़े</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 16:1"/>मे तुंद्‌रे सी फीबे वाटे जी आपणी बहणीस ने कींख्‌रायान मंडळीन चाकरी करने वाळी छे, लीलघाय। <verse eid="ROM 16:1"/><verse number="2" style="v" sid="ROM 16:2"/>की तुहुं, जे चुखला माणसे छे, ने जसों तुहुंक करनु चाहजे तसात तुहुं मालीक ईसु मां हय्‌न तीनीन आव-भाव करु; ने जी वाते मां तीनी काजे तुंद्‌रे साहरे मदत चाहजे, तीनी वात मां तुहुं तेरी मदत करो, काहाकी की हीयी बी बेसका माणसेन भलाय करने वाळी छे। मारी बी करने वाळी छे।<verse eid="ROM 16:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 16:3"/>परीस्‌का ने अक्‌वीला काजे ईसु मसी मां आवजी करीन कय र्‌यु, जे मारे साते खुस-खबरेन काम करन्‌या साजल्‌या छे। <verse eid="ROM 16:3"/><verse number="4" style="v" sid="ROM 16:4"/>हीये दुय माणसे मारु जीव बचाड़ने वाटे आपसान जीव बी खुवणे तीयार हय गुयला; हेरेसी मे हीनु काजे बेसका वारु छे कहं, ने नी-यहुदी ईसुन मंडळी मां वाळा बी हीनु काजे बेसका वारु छे करीन कहें। <verse eid="ROM 16:4"/><verse number="5" style="v" sid="ROM 16:5"/>हीनु मंडळीन माणसे काजे बी ने आवीस ने आवजी कहं जे हींद्‌रे घर मां छे।</para>
  <para style="p" vid="ROM 16:5">ने मारु बेसकु वारु लाटेक्‌ला इपेनीतुस काजे जु मसी मां आवीस ने आवजी कहं जु आसीया पेहेल भुरसु करलु छे। <verse eid="ROM 16:5"/><verse number="6" style="v" sid="ROM 16:6"/>मरीयम बी तुंद्‌रे वाटे, जी काठो काम करली छे, आवीस ने आवजी कहं। <verse eid="ROM 16:6"/><verse number="7" style="v" sid="ROM 16:7"/>अन्‌दुर्‌नीकुस ने युनीयास काजे बी आवीस ने आवजी कहं जे मारा भाय-बेटा छे, ने जे मारे साते जेल मां हतला ने नेवताळा मां नाव-सादीन छे, जे मार सी पेहेल ईसु मसी पर भुरसु करला छे, आवीस ने आवजी कह्‌वो।<verse eid="ROM 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 16:8"/>अम्‌पलीयातुस काजे, जु मालीक मां मारु लाटेक्‌लु छे, आवीस ने आवजी कहं, <verse eid="ROM 16:8"/><verse number="9" style="v" sid="ROM 16:9"/>उरबानुस काजे, बी मे आवीस ने आवजी कहं, जु ईसु मसी मां हामरे साते काम करन्‌यु साजल्‌यु छे, ने मारा लाटेक्‌ला ईस्‌तखुस काजे बी आवीस ने आवजी कहं। <verse eid="ROM 16:9"/><verse number="10" style="v" sid="ROM 16:10"/>अपील्‌लेस काजे आवीस ने आवजी। कहं जु ईसु मसी मां खरलु छे, ने मे अरीस्‌तुसन घराणा काजे बी आवीस ने आवजी कहं। <verse eid="ROM 16:10"/><verse number="11" style="v" sid="ROM 16:11"/>मारा भाय-बेटा हेरोदीयोन काजे बी आवीस ने आवजी कहं। नरकीखुसेन घराणा काजे बी आवीस ने आवजी कहं, जे मालीक ईसु पर भुरसु करे।<verse eid="ROM 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 16:12"/>तीरुफेना ने तीरुफेसा काजे बी आवीस ने आवजी कहं। जे मालीक ईसु मां काठो काम करे, ने लाटेक्‌ला पीर्‌सीस काजे, बी आवीस ने आवजी कहं। जु मालीक ईसु मां बेसको काठो काम करे। <verse eid="ROM 16:12"/><verse number="13" style="v" sid="ROM 16:13"/>मालीक ईसु मां नेवाड़ला रुफुस काजे ने तेरी आयस काजे, मे आवीस ने आवजी कहं। <verse eid="ROM 16:13"/><verse number="14" style="v" sid="ROM 16:14"/>असुनक्‌रीतुस काजे मे फीलगेन काजे ने हीरमेस काजे मे पुत्‌रुबास काजे ने हर्‌मास काजे मे तींद्‌रे साते रवण्‌या भायस काजे आवीस ने आवजी कहं। <verse eid="ROM 16:14"/><verse number="15" style="v" sid="ROM 16:15"/>फीलोलुगुस काजे मे युलीया काजे मे नेर्‌युस काजे मे तेरी बहणीस काजे, मे उलीम्‌पास काजे मे तेरी साते रवण्‌या आखा चुखला माणसे काजे आवीस ने आवजी कहं।<verse eid="ROM 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 16:16"/>तुहुं सांबा आंबा-चुखला गुळा<note caller="+" style="f"><char style="fr" closed="false">16:16 </char><char style="fq" closed="false">चुखला गुळा </char><char style="ft" closed="false">पवित्र चुम्बन</char></note> दीन वारलु छे करीन पुछु। ने आवीस ने आवजी करीन कहुं तुहुं आखा काजे ईसु मसी मां मंडळी माणसे भीणी सी आवीस ने आवजी कहं।<verse eid="ROM 16:16"/></para>
  <para style="s">आकरी सीकाड़नु</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 16:17"/>हय ए भायस्‌यो, मे तुंद्‌रे सी लीलघायो करो, की जे माणसे हीनी सीकाड़नेन वात सी आन्‌गे, जड़ली छे, बेरजु पाड़ने ने ठुकर खावड़नेन वजे बणे, हींद्‌रे सी नातो तुड़ लेवु ने हींद्‌रे सी छेटा रवु। <verse eid="ROM 16:17"/><verse number="18" style="v" sid="ROM 16:18"/>काहाकी असला माणसे आपणा मालीक ईसु मसीन सेवा भक्‌ती नी करे, बाकुन आपसान पेट वाटे सेवा भक्‌ती करे; ने सुवाळी-सुवाळी वात कहंवीन सुदला मन वाळा ने भुळा माणसे काजे ठगी लेय। <verse eid="ROM 16:18"/><verse number="19" style="v" sid="ROM 16:19"/>तुंद्‌री हुकुम मान्‌नेन वात आखे दुर पुग गुयली छे, हेरेसी मे तुंद्‌रे बारामां खुस छे, बाकुन मारी जी मरजी छे की तु भलाय करने करीन अक्‌कल वाळा बणी जावु ने कुहराय वाटे डेड़-अकल्‌या मां बणु। <verse eid="ROM 16:19"/><verse number="20" style="v" sid="ROM 16:20"/>सांती आपण्‌यु भगवान भुतड़ा काजे तुंद्‌रे पाय तळे छाटुस कुचरी देसे।</para>
  <para style="p" vid="ROM 16:20">आपणा मालीक ईसुन गीण-दया तुहुं काजे जड़ती रवणु चाहजे।<verse eid="ROM 16:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 16:21"/>मारे साते काम करन्‌यु साजल्‌यु तीमुथीयुस, ने लुकीयुस जु मारु भाय-बेटु छे ने यासोन ने सोसीपत्‌रस तुहुं काजे आवीस ने आवजी कहं।<verse eid="ROM 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 16:22"/>मारी चिट्‌ठी काजे लिखण्‌यु तीरतीयुस, मालीक ईसु मां तुहुं काजे आवीस ने आवजी कहं।<verse eid="ROM 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 16:23"/>गयुस बी तुहुं काजे आवीस ने आवजी कहं जु मारी ने ईसुन माणसेन जे मंडळी मां बठण्‌यान मेजवानी<note caller="+" style="f"><char style="fr" closed="false">16:23 </char><char style="fq" closed="false">मेजवानी </char><char style="ft" closed="false">पहुनाई</char></note> करन्‌यु, छे ईरास्‌तुस तुहुं काजे आवीस ने आवजी कहं जु सहरेन देख-भाळ करन्‌यु, पयस्‌या टकान देख-भाळ राखण्‌यु पावर्‌यु छे ने भायस क्‌वारतुस बी तुहुं काजे आवीस ने आवजी कहं। <verse eid="ROM 16:23"/><verse number="24" style="v" sid="ROM 16:24"/>हामरा ईसु मसीन दया तुहुं आखा पर रवे। आमीन।<verse eid="ROM 16:24"/></para>
  <para style="s">भगवानेन बड़ाय</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 16:25"/>हय जु तुहुं काजे मारी खुस-खबरेन मतलब ईसु मसीन खुस-खबरेन परचारेन साहरे तुहुं काजे टणका कर सके, भगवानेन सातयलो वीजाळो जलम सातयली हतली, <verse eid="ROM 16:25"/><verse number="26" style="v" sid="ROM 16:26"/>बाकुन हय ज जलमेन भगवानेन हुकुम सी भगवानेन अघी सी आवणे वाळी वात देखान्‌यान साहरे लिखली चुखली सास्‌तुरेन साहरे आखा माणसे पर उजेंतु हय गुयलो छे ने असात करीन चे ईसु पर भुरसु करीन भगवानेन हुकुम मान्‌या बण गुया,<verse eid="ROM 16:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 16:27"/>एकुत अक्‌कल वाळा भगवानेन ईसु मसीन साहरे जलम सेक-सींगार हवती रवे ने असोत हवतो रवे।<verse eid="ROM 16:27"/></para>
  <chapter eid="ROM 16"/>
</usx>
