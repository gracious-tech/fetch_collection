<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JHN" style="id">- Bhilali Standard Project</book>
  <para style="h">युहन्‌ना</para>
  <para style="toc3">युहन्‌ना</para>
  <para style="toc2">युहन्‌ना</para>
  <para style="toc1">युहन्‌नान साहरे लिखली ईसुन खुस-खबर</para>
  <para style="mt2">यूहन्ना के द्वारा लिखा गया यीशु का सुसमाचार</para>
  <para style="mt1">युहन्‌नान साहरे लिखली ईसुन खुस-खबर</para>
  <para style="imt">युहन्‌नान बारामां</para>
  <para style="ip">युहन्‌नान अनसारे खुस-खबर नवला नेम मां चार किताप मां सी एक छे, जु ईसु मसीन जीवनेन बारामां देखाड़े। तींद्‌रे मां सी एकेक काजे “खुस-खबर” कह्‌वे। तेरो मतलब छे “वारलु खबर।” चे मत्‌ती, मरकुस, लुकु, ने युहन्‌नान साहरे ईसुन मरनेन पछे लिखली छे। युहन्‌ना अनसारे खुस-खबर आड़े-धड़ेन नेवताळान काम युहन्‌नान साहरे ईसुन पयदा हवणेन लग-भग नब्‌बे साल पछेन लिखला, चाहे ची किताप जी नी कह्‌वे, की युहन्‌नु लिखणे वाळु छे, लिखणेन ढंग पेहला युहन्‌ना दीसरा युहन्‌ना ने तीसरा युहन्‌नान आक्‌सरेन तसा छे, थुड़ाक डाहा-बुड़ा युहन्‌ना काजे तीनी टेमे ईफीसुस सहर मां रवे, हेरेसी कवतेला की जी किताप ईफीसुस सहर मां लिखी गुयली।</para>
  <para style="ip">युहन्‌ना साप रुप सी बताड़े की ईनी कितापेन मतलब माणसे काजे भुरसु करने मां मदत करनु छे, की ईसुत मसी छे, जीवतेला भगवानेन पुर्‌यु <char style="xt"><ref loc="JHN 20:31">20:31</ref></char> असु भुरसु करीन आपणु हेरा नाव पर जीवन जी असकु। किताप यहुदी ने नी-यहुदी आखा वाटे लिखली छे। युहन्‌नान खुस-खबर थुड़ाक मायनो मे दीसरी तीन खुस-खबर मां सी बेसकी आंगे छे। हयु हीनु मटा-मटा काम पर धीयान लागाड़्‌यु, जु ईसु करलु ने आपणा दाखलान बारामां अदुस नी लिख्‌यु, ईसुन बपतीस्‌मा ने उजाड़ मां लालुचेन तसा दीसरा मटला काम काजे बी नी लिख्‌यु।</para>
  <para style="iot">बाहरती वात</para>
  <para style="io1">1. युहन्‌नान खुस-खबर चालु करे। <char style="ior"><ref loc="JHN 1:1-18">1:1-18</ref> </char></para>
  <para style="io1">2. अळतेन चु तीनुक बेसका मटा कामेन बारामां जु लिखे चु ईसु कर्‌यु। <char style="ior"><ref loc="JHN 1:19-12:50">1:19—12:50</ref> </char></para>
  <para style="io1">3. तेरे पछेन चु ईसुन जीवनेन बेसका कामेन बारामां देखाड़े जु तेरे मरनेन ने पछु जीव उठणेन वाटे अगवाय करे। <char style="ior"><ref loc="JHN 13:1-20:31">13:1—20:31</ref> </char></para>
  <para style="io1">4. युहन्‌नान खुस-खबर खाजे खत्‌तम करनेन बारामां बताड़े, तेरेमां सी एकेक पछे ईसु माणसे काजे देखाव पड़नेन पछे चु मरला मां सी जीव उठे ने अळी किताप लिखणेन आपणो मतलब बताड़्‌यु। <char style="ior"><ref loc="JHN 21">21</ref> </char></para>
  <chapter number="1" style="c" sid="JHN 1" />
  <para style="s">जीवनेन बुल</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1" />कळी घड़ायणे सी पेहलुत बुल हतलो, ने बुल भगवान पुठ्‌ये हतलो, ने बुल भगवानुत हतलु। <verse eid="JHN 1:1" /><verse number="2" style="v" sid="JHN 1:2" />च बुल कळी सी पेहेल भगवान साते हतलो। <verse eid="JHN 1:2" /><verse number="3" style="v" sid="JHN 1:3" />कळी मां ज आखो काय तेरे सीत बण्‌यो, ने ज काय बण्‌यो तेरेमां सी काय बी चीज तेरे पाखुर नी बण्‌यो। <verse eid="JHN 1:3" /><verse number="4" style="v" sid="JHN 1:4" />हेरेम जीव हतलु, ने हयु जीव दुनीया मायन माणसे वाटे वीजाळो हतलो। <verse eid="JHN 1:4" /><verse number="5" style="v" sid="JHN 1:5" />वीजाळो<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">ज्योति</char></note> आंदारला मां चमक्‌यो ने आंदारलो तीनाक कदी नी उळखी सक्‌यो।<verse eid="JHN 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6" />भगवान भीणी सी मकेल्‌लु एक अदमी ईनी कळी मां आयु, तेरो नाव युहन्‌ना हतलो। <verse eid="JHN 1:6" /><verse number="7" style="v" sid="JHN 1:7" />ने चु युहन्‌नु तीना वीजाळान बारामां माणसेक गवा देणे आयु, काहाकी आखा माणसे तीनी गवायन साहरे तीना वीजाळा पर भुरसु कर्‌या। <verse eid="JHN 1:7" /><verse number="8" style="v" sid="JHN 1:8" />चु युहन्‌नु, आपसुत च वीजाळो नी हतलु; बाकुन तीना वीजाळान बारामां गवाय देणे आवलु। <verse eid="JHN 1:8" /><verse number="9" style="v" sid="JHN 1:9" />ज खरलो वीजाळो हतलो, चु कळी मां हय उजेंतु हवणेवाळु हतलु, ने चु आखा माणसे काजे आपसा वीजाळान साहरे भगवानेन छाचाय देखाड़न्‌यु हतलु।<verse eid="JHN 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 1:10" />कळीन आखा घड़न्‌या, तेरेत साहरे घड़ाया, ने चु कळी मां आयन देखाव पड़्‌यु, तेबी कळीन माणसे तीना काजे नी उळख्‌या। <verse eid="JHN 1:10" /><verse number="11" style="v" sid="JHN 1:11" />चु आपसा यहुदी-माणसेन ईचमां आयन रयु, बाकुन तेरात माणसे तीनाक नी आवर्‌या। <verse eid="JHN 1:11" /><verse number="12" style="v" sid="JHN 1:12" />बाकुन जतरा बी माणसे तीनाक आपसा जीवेम आवरीन, तेरा नाव पर भुरसु करे, चु तीनु आखा काजे भगवानेन अवल्‌यात बणनेन हक आप्‌यु। <verse eid="JHN 1:12" /><verse number="13" style="v" sid="JHN 1:13" />चे नी ते खुन सी, ने नी ते डीलेन मरजी सी, नी आयस बासेन मरजी सी, बाकुन भगवानेन मरजी सी पयदा हया।<verse eid="JHN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 1:14" />तेरेमां चु बुल कहंवायतेलु; ने चु माणुस बणीन धरती पर आयु, ने आपणे ईचमां रयु। ने हामु तेरी सेक-सींगार देख्‌या, जसा की भगवान बासेन एकुत लाटेक्‌ला पुर्‌यान गीण-दया ने छाचाय बी हतली।<verse eid="JHN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 1:15" />युहन्‌ना तेरा बारामां असी गवाय देदु, ने आयड़ीन कह्‌यु, “जु हयुत छे, तेरे बारामां मे असु कह्‌लु, एक जणु आवणे वाळु छे, चु मार पछळ आय र्‌यु, चु मार सी मटु छे, काहाकी चु मार सी पेहेल हतलु।”<verse eid="JHN 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 1:16" />काहाकी हेरेत उगळता खजाना मां सी हामुक आखो जड़्‌यो, मतलब तीना खजाना मां सी आपणु काजे बेसकी गीण-दया हवली छे। <verse eid="JHN 1:16" /><verse number="17" style="v" sid="JHN 1:17" />तेरेमां नेम कायदु ते मुसु देदलु, बाकुन गीण-दया ने छाचाय ईसु मसीन साहरे आपणेन्‌चां पुगली। <verse eid="JHN 1:17" /><verse number="18" style="v" sid="JHN 1:18" />भगवान काजे कुय बी माणुस आज लग नी देख्‌या, बाकुन तेरु एखलु पुर्‌यु ईसु चु आपसुत भगवान छे, ने जलम भगवान पुठ्‌ये रवे, हयुत भगवान काजे आपसी जीवान साहरे देखाड़ीन पुरु उजेंतु करलु छे।<verse eid="JHN 1:18" /></para>
  <para style="s">युहन्‌ना बपतीस्‌मा आपणे वाळान गवाय</para>
  <para style="r">(<ref loc="MAT 3:1-12">मत्‌ती 3:1-12</ref>; <ref loc="MRK 1:1-8">मरकुस 1:1-8</ref>; <ref loc="LUK 3:1-18">लुका 3:1-18</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19" />एक दाहड़े यरुसलेम सहर सी यहुदी माणसेन डाहला, चे भगवानेन मंदीरेन पुजारा काजे ने पुजारान मदत करन्‌या लेवी कुळीन माणसे काजे, युहन्‌ना भीणी असा पुछणे मकल्‌या की तु कुण छे?<verse eid="JHN 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 1:20" />तत्‌यार युहन्‌नु ज मान लेदु बाकुन मना नी कर्‌यु, “मे मसी नी हय।”<verse eid="JHN 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 1:21" />तत्‌यार चे तीनाक पुछ्‌या, “की तु कुण छे?”</para>
  <para style="p" vid="JHN 1:21">काय तु एलीयु छे? युहन्‌नु जपाप आप्‌यु।</para>
  <para style="p" vid="JHN 1:21">“मे नी हय ती काय?” तु चु भगवानेन अघली वात बताड़न्‌यु माणुस छे।</para>
  <para style="p" vid="JHN 1:21">“चु जपाप<note caller="+" style="f"><char style="fr" closed="false">1:21 </char><char style="ft" closed="false">उत्तर</char></note> आप्‌यु,” मे नी हय।<verse eid="JHN 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 1:22" />तत्‌यार चे तीनाक कह्‌या, “ती तु कुण छे? जे हामुक मकल्‌या तीनुक हामु काय जपाप आपजे? तु तार बारामां काय कह्‌वे?”<verse eid="JHN 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 1:23" />चु युहन्‌नु कह्‌यु, जसों भगवानेन अघली वात बताड़न्‌यु यसायु कहंलु की:</para>
  <para style="q1" vid="JHN 1:23">“मे बयड़ा मां आयड़ीन बुल सामळावण्‌यु छे:</para>
  <para style="q2" vid="JHN 1:23">की तुहुंं मालीकेन<note caller="+" style="f"><char style="fr" closed="false">1:23 </char><char style="ft" closed="false">प्रभु</char></note> वाट सुदी करु!”<verse eid="JHN 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24" />युहन्‌नान झड़ती करने करीन यरुसलेम सी मकेल्‌ला फरीसी माणसे बी हतला। <verse eid="JHN 1:24" /><verse number="25" style="v" sid="JHN 1:25" />चे माणसे युहन्‌ना काजे अळी पुछ्‌या कदी तु मसी बी नी हय, “ने एलीयु बी नी हय, ने भगवानेन अघली वात बताड़न्‌यु माणुस बी नी हय, ती तु बपतीस्‌मा काहा आपे?” <verse eid="JHN 1:25" /><verse number="26" style="v" sid="JHN 1:26" />युहन्‌ना तीनुक जपाप आप्‌यु, “मे ते तुहुंं काजे पाणी सी बपतीस्‌मा आपो, बाकुन तुंद्‌रे ईचमां एक माणुस छे तीनाक तुहुंं नी उळ्‌खु। <verse eid="JHN 1:26" /><verse number="27" style="v" sid="JHN 1:27" />अळतेन मारे पछेन आवणे वाळु छे, मे तेरा खासड़ान बंद छुड़ने लायक बी नी हय।”<verse eid="JHN 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 1:28" />जी वात यरदन नदीन पार बेतन्‌या गांव मां हवली, चां युहन्‌नु बपतीस्‌मा आपतेलु।<verse eid="JHN 1:28" /></para>
  <para style="s">भगवानेन गाडरो</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29" />दीसरे दाहड़े युहन्‌ना ईसु काजे तेरे भीणी आवतेलु देखीन कह्‌यु, “देखु जु भगवानेन साहरे मकेल्‌लु गाडरु छे, चु कळीन माणसेन पाप हाकलीन ली जासे। <verse eid="JHN 1:29" /><verse number="30" style="v" sid="JHN 1:30" />जु चु छे तेरा बारामां मे कह्‌लु, की एक माणुस मारे पछळ आवणे वाळु छे, जु मारे सी बेसकु मटु छे मार सी अगळ छे, काहाकी चु मार सी पेहलुत हतलु <verse eid="JHN 1:30" /><verse number="31" style="v" sid="JHN 1:31" />मेसेक बी जी वात पेहेल मालुम नी हतली, हयुत मसी छे, बाकुन भगवानेन मरजी जी हतली की ईस्‌रायली जातीन माणसे समजणु चाहजे की, मसी कुण छे, हेरेसी भगवान मेसेक पाणीम बपतीस्‌मा आपणेन सेवा आप्‌यु।”<verse eid="JHN 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 1:32" />ने युहन्‌नु जी गवाय आप्‌यु, मे आत्‌मा काजे पेरवान तसों सरगे सी उतरतेला देख्‌यु, ने चु तेरे पर बठ गुयु। <verse eid="JHN 1:32" /><verse number="33" style="v" sid="JHN 1:33" />मे ते तीनाक उळखो नी बाकुन जु मेसेक पाणी सी बपतीस्‌मा आपणे वाळु मकेल्‌लु हयुत मेसेक कह्‌यु, “तेरे पर तु आत्‌मा उतरतेला ने बठतेला देख्‌यु, हयुत चुखली-आत्‌मा सी बपतीस्‌मा आपणे वाळु छे।” <verse eid="JHN 1:33" /><verse number="34" style="v" sid="JHN 1:34" />ने मे देख्‌यु, ने गवाय देदु, “की हयुत भगवानेन नेवाड़लु पुर्‌यु छे।”<verse eid="JHN 1:34" /></para>
  <para style="s">मालीक ईसुन पेहला चेला</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35" />दीसरे दाहड़े युहन्‌नु ने तेरा दुय चेला चां आय रवला। <verse eid="JHN 1:35" /><verse number="36" style="v" sid="JHN 1:36" />युहन्‌ना ईसु काजे चां मायन जातलु देख्‌यु ने तेरा चेला काजे कह्‌यु, “देखु हीयुत भगवानेन गाडरु छे।”<verse eid="JHN 1:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37" />तत्‌यार चे दुयु चेला युहन्‌नान जी वात सामळीन ईसुन चेला बणने करीन, ईसु पछळ चाली पड़्‌या। <verse eid="JHN 1:37" /><verse number="38" style="v" sid="JHN 1:38" />जत्‌यार ईसु पछु फीरीन तीनुक आवतेला देखीन तीनुक कह्‌यु, “तुहुंं काय हेर रया?”</para>
  <para style="p" vid="JHN 1:38">चे ईसुक कह्‌या, “ए मास्‌तर तारु रवणेन जागु कां छे।”<verse eid="JHN 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 1:39" />ईसु तीनुक जपाप आप्‌यु, “आवीन देख लेवु।” तत्‌यार चे जाय्‌न ईसुन रहणेन जागु देख्‌या, ने तीने दाहड़े ईसु पुठ्‌ये रया ने तीनी टेमे सांती वेळाय चार बज रवली।<verse eid="JHN 1:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40" />तीनु दुय जणा मां सी जे युहन्‌नान वात सामळीन चे ईसु पछळ चाली पड़्‌या, एक सीमोन पतरसेन भाय अन्‌दीरीयास हतलु। <verse eid="JHN 1:40" /><verse number="41" style="v" sid="JHN 1:41" />अदरीयास ईसुन्‌चां सी पछु गुयु ती, चु सुदु सट पेहल आपसा संगा भाय सीमोनेन्‌चां गुयु, तत्‌यार कह्‌यु, “हामुक छुड़ावन्‌यु मसी जड़ गुयु, तीनाक आपणु खीरीस्‌त कहजे।” <verse eid="JHN 1:41" /><verse number="42" style="v" sid="JHN 1:42" />पछेन अन्‌दीरीयास तीना सीमोन काजे ईसुन्‌चां लायु।</para>
  <para style="p" vid="JHN 1:42">ईसु सीमोन भीणी भाळीन कह्‌यु, “तु युहन्‌नान पुर्‌यु सीमोन छे, तु केफा कहंवाय्‌सी।” हीना केफा काजे युनानी बुली मां पतरस कह्‌वे।<verse eid="JHN 1:42" /></para>
  <para style="s">फीलीप्‌पुस ने नतनएल काजे ईसु बुलावे</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43" />दीसरे दाहड़े ईसु गलील जीला भीणी जाणेन हींडी रवलु। तीनी टेमे चु फीलीप्‌पुस काजे भेळु हयु ने कह्‌यु, “तु मारु चेलु बणीन मारे पछळ चाल पड़।” <verse eid="JHN 1:43" /><verse number="44" style="v" sid="JHN 1:44" />ने जु फीलीप्‌पुस बी, अन्‌दीरीयास ने पतरस रवतेलु तीनात बेतसेदा सहर वाळु हतलु। <verse eid="JHN 1:44" /><verse number="45" style="v" sid="JHN 1:45" />ने जु फीलीप्‌पुस, नतनएल नावेन आपसा दुस्‌तीदार काजे भेळु हवणे गुयु, ने तीनाक भेळु हय्‌न कह्‌यु तीना मसीन बारामां मुसु नीयम मां लिखलु छे ने भगवानेन अघली वात बताड़ने वाळा बी करला, च हामुक जड़ गुयो, चु नासरत सहरेम रहणे वाळु युसुफ्‌यान पुर्‌यु ईसु छे।<verse eid="JHN 1:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 1:46" />नतनएल फीलीप्‌पुस काजे कह्‌यु, “ए नासरत सहर मां सी नीकळी काहनी बी वारलु बरकत उबजी सके काय?”</para>
  <para style="p" vid="JHN 1:46">फीलीप्‌पुस नतनएल काजे कह्‌यु, “आवीन देख ले।”<verse eid="JHN 1:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 1:47" />ईसु नतनएल काजे हेरे भीणी आवतेलु देखीन कह्‌यु, “ने तेरा बारामां कह्‌यु, देखु जु ईस्‌रायली जातीन खरलु माणुस छे। हेरेमां काय बी खुट नी हय!”<verse eid="JHN 1:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 1:48" />नतनएल ईसु काजे कह्‌यु, “तु मेसेक कसु उळखे?” ईसु तीनाक जपाप आप्‌यु, “हेरेसी पेहेल की फीलीप्‌पुस तुसेक बुलायु जत्‌यार तु अंजीर नावेन झाड़का तळे हतलु तत्‌यार मे तुसेक देखलु।”<verse eid="JHN 1:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 1:49" />नतनएल ईसुक कह्‌यु, “ए मास्‌तर” तु भगवानेन पुर्‌यु छे, “तु ईस्‌रायली माणसेन राजु छे!”<verse eid="JHN 1:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 1:50" />ईसु नतनएल काजे कह्‌यु, “मे तुसेक वारु कहलु, की तु अंजीर नावेन झाड़का तळे देखलु काय, तु तेरेमां मार पर भुरसु<note caller="+" style="f"><char style="fr" closed="false">1:50 </char><char style="ft" closed="false">विश्वास</char></note> कर रयु? तु हेरेसी बी मटा-मटा काम देखसी!” <verse eid="JHN 1:50" /><verse number="51" style="v" sid="JHN 1:51" />ईसु तीनाक ने दीसरा चेलाक असु कह्‌यु, “मे तुहुंंक छाचलीन कहो की तुहुंं सरग काजे उघड़लो, ने भगवानेन सरग वाळा काहवाळ्‌या काजे माणसेन पुर्‌यान्‌चां उतरतेला ने चां सी उपर चहड़तेला देखसु।”<verse eid="JHN 1:51" /></para>
  <chapter eid="JHN 1" />
  <chapter number="2" style="c" sid="JHN 2" />
  <para style="s">गलील जीलान काना मां ईयाव</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1" />पछेन तीसरे दाहड़े<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">दिन</char></note> गलील जीलान काना सहर मां ईयाव हतलु। ने ईसुन माय बी चां हतली <verse eid="JHN 2:1" /><verse number="2" style="v" sid="JHN 2:2" />चां ईयाव मां ईसु ने तेरा चेला काजे बी नेवता आपीन बुलाय रवला। <verse eid="JHN 2:2" /><verse number="3" style="v" sid="JHN 2:3" />जत्‌यार चां अंगुरेन रस सर गुयु, ती ईसुन माय ईसुक कय, “हींद्‌रे धड़े ते अंगुरेन रस सर गुयु।”<verse eid="JHN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 2:4" />ईसु हेरी माय काजे कह्‌यु, “तु मेसे असी काहा कय रय? मारे साते तारो काय काम छे? हय मारी टेम नी आय रय।”<verse eid="JHN 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 2:5" />ईसुन माय पावर्‌या काजे कय, “हीयु तुहुंंक जु काय कहं चत करजु।”<verse eid="JHN 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6" />चां दगड़ान छव बेसका-मटा गुळा मेल्‌ला हतला, हीनु गुळाम सी पाणी हेड़ीन यहुदी माणसे चुखा हवणे करीन हात-पाय धुवतेला। हीनु गुळाम सोवेक लीटर पाणी समायतेलो। <verse eid="JHN 2:6" /><verse number="7" style="v" sid="JHN 2:7" />ईसु चां वाळा पावर्‌याक कह्‌यु, “गुळा मां पाणी भर देवु” ने चे पावर्‌या ईसुन वात मानीन उगेळतो पाणी भर देदा। <verse eid="JHN 2:7" /><verse number="8" style="v" sid="JHN 2:8" />तत्‌यार ईसु तीनुक कह्‌यु, “हय ईतरोक पाणी नीकाळीन वारत्‌यान धड़े ली जावु।” चे पावर्‌या च पाणी नीकाळीन वारत्‌यान्‌चां ली गुया। <verse eid="JHN 2:8" /><verse number="9" style="v" sid="JHN 2:9" />तत्‌यार वारती च पाणी चाख्‌यु अंगुरेन रस बण गुयो ने तीनाक नी मालुम हतलो की अंगुरेन रस कां सी लावला। बाकुन<note caller="+" style="f"><char style="fr" closed="false">2:9 </char><char style="ft" closed="false">परन्तु</char></note> तीनु पावर्‌याक मालुम हतलो की कां सी लावला ती आरत्‌यु दुल्‌लाक बुलायन तीनाक कह्‌यु। <verse eid="JHN 2:9" /><verse number="10" style="v" sid="JHN 2:10" />“कुय बी माणुस पेहली बार वारलु अंगुरेन रस आपे ने तत्‌यार माणसे पीन आफरी जाय तत्‌यार हळकु अंगुरेन रस आपे; बाकुन तु ते वारलु अंगुरेन रस हय लग मेल रवलु।” <figure style="fig" alt="Filling water in the stone jars" file="lb00135c.tif" size="col" copy="Horace Knowles ©" ref="2:7">दगड़ान गुळा मां पाणी भरे</figure><verse eid="JHN 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 2:11" />ईसु गलीलेन काना सहर मां पेहली कावा वारु कामेन सहलाणी देखाड़ीन आपसुत सेक-सींगार देखाड़्‌यु। ने ज देखीन ईसुन चेला ईसु पर भुरसु कर्‌या।<verse eid="JHN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 2:12" />हेरे पछेन ईसु ने हेरी माय ने हेरु भाय ने हेरा चेला कफरनहुम सहर मां गुया ने चां थुड़ाक दाहड़ा रया।<verse eid="JHN 2:12" /></para>
  <para style="s">ईसु मंदीर मां सी लेण देण करन्‌याक बाहार नीकाळे</para>
  <para style="r">(<ref loc="MAT 21:12">मत्‌ती 21:12</ref>,<ref loc="MAT 21:13">13</ref>; <ref loc="MRK 11:15-17">मरकुस 11:15-17</ref>; <ref loc="LUK 19:45">लुका 19:45</ref>,<ref loc="LUK 19:46">46</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13" />यहुदी माणसेन फसह तीहवार सातेत आय रवलु। तेरेमां ईसु यरुसलेम सहर मां जाती रयु। <verse eid="JHN 2:13" /><verse number="14" style="v" sid="JHN 2:14" />चां ईसु मंदीर मां देख्‌यु की माणसे बेल गाडरा ने पेरवा वेचतेला देख्‌यु ने चां लेण देण वाळा वेपारी आटे-साटे करन्‌या बठ रवला देख्‌यु। <verse eid="JHN 2:14" /><verse number="15" style="v" sid="JHN 2:15" />तेरेमां ईसु रासेन सपाटु बणायन आखा गाडरा ने बेल काजे मंदीर मां सी नीकाळ देदु ने लेण-देण करने वाळान पयस्‌या खडळी देदु ने ठेला गाडी काजे उन्‌धलाय देदु। <verse eid="JHN 2:15" /><verse number="16" style="v" sid="JHN 2:16" />पेरवा वेचण्‌या काजे कह्‌यु, “ज आखो जां सी छेटा ली जावु। मारा बासेन<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">पिता</char></note> घर काजे वेपारीन घर मां बणावु।” <verse eid="JHN 2:16" /><verse number="17" style="v" sid="JHN 2:17" />ईसुन वात सामळीन ईसुन चेला काजे खरला-सास्‌तुर मां लिखली वात हेर आय गुय, “तारा घरेन धुन मां मेसेक आकठान तसी धपाड़ देसे।”<verse eid="JHN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18" />ईसुन वात सामळीन यहुदी माणसे ईसु काजे कह्‌या, “तु जो काय करने बाजी रयु? कदी भगवान तुसेक जो करनेन हक आपलु हय ती, ईनी वातेन पुरावु देणे करीन, हामुक चकराड़े असी एक वारु-कामेन सहलाणी देखाड़।”<verse eid="JHN 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 2:19" />ईसु तीनुक जपाप आप्‌यु, “कदी तुहुंं भगवानेन हीना मंदीर काजे उदार नाखसु, ती मे हीनाक अळी तीन दाहड़ाम पछु बणाय दीस।”<verse eid="JHN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 2:20" />जो सामळीन यहुदी माणसे ईसु काजे कह्‌या, “भगवान हीना मंदीर काजे बणावणे मां चालीस ने छव साल लागला, ती हय तु हीनाक तीन दाहड़ा मां बणाय देसी काय!”<verse eid="JHN 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 2:21" />बाकुन ईसु आपसा डीलेन मंदीरेन बारामां बताड़लु। <verse eid="JHN 2:21" /><verse number="22" style="v" sid="JHN 2:22" />जत्‌यार ईसु जत्‌यार मर्‌या-सर्‌याम सी जी उठ्‌यु, ती ईसुन चेला काजे ईसुन साहरे मंदीरेक उदारनेन ने पछु उबु करनेन बारामां कह्‌ली वात हेर आय, ने चेला खरला-सास्‌तुरेन वात पर ने ईसुन कवली वात पर भुरसु कर्‌या।<verse eid="JHN 2:22" /></para>
  <para style="s">ईसु माणसेन मन काजे जाणे</para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23" />पासका तीहवारेन दाहड़ा, मां, ईसु यरुसलेम सहर मां हतलु। तत्‌यार बेसका माणसे तेरा करला वारु कामेन सहलाणी देखीन ईसु पर भुरसु कर्‌या। <verse eid="JHN 2:23" /><verse number="24" style="v" sid="JHN 2:24" />बाकुन ईसु हीनु काजे तींद्‌रा भुरसा पर नी छुड़्‌यु, काहाकी<note caller="+" style="f"><char style="fr" closed="false">2:24 </char><char style="ft" closed="false">क्योंकि</char></note> हयु आखा माणसे काजे जाणतेलु। <verse eid="JHN 2:24" /><verse number="25" style="v" sid="JHN 2:25" />ने हीनाक जरुवत नी हतली, की माणसेन बारामां काहींग गवा पुरावु देय, काहाकी हयु आपसुत जाणतेलु की माणसेन मन मां काय छे?<verse eid="JHN 2:25" /></para>
  <chapter eid="JHN 2" />
  <chapter number="3" style="c" sid="JHN 3" />
  <para style="s">ईसु ने नीकुदेमुस</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1" />यरुसलेम सहर मां नीकुदेमुस नावेन एक माणुस हतलु। चु यहुदी माणसेन एक पंचुन मुख्‌यु हतलु। चु फरीसी माणसे मायन हतलु। <verse eid="JHN 3:1" /><verse number="2" style="v" sid="JHN 3:2" />चु राते नीकुदेमुस ईसु धड़े आयु ने ईसु काजे कह्‌यु, “ए मास्‌तर, हामु जाणजे की तु भगवानेन्‌चां सी सीकाड़न्‌यु बणीन आवलु छे, काहाकी जत्‌यार लग भगवान पुठ्‌ये नी हय ती माणुस कुय बी असो वारलु कामेन सहलाणी नी देखाड़ सके, जसु तु वारलु कामेन सहलाणी देखाड़े।”<verse eid="JHN 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 3:3" />ईसु नीकुदेमुस काजे कह्‌यु, “मे तुसेक छाची-छाची कह्‌वो की जत्‌यार लग कुय अळी पछु पयदा नी हवे तत्‌यार लग चु भगवानेन राज नी देख सके।”<verse eid="JHN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 3:4" />नीकुदेमुस ईसुक पुछ्‌यु, “काहनु बी माणुस डाहलु हय्‌न अळी पछु कसु पयदा हय सके? छाचलीन चु आपसी आयसीन कुख मां अळी पछु जाय्‌न, दीसरी कावा ते, नी पयदा हय सके।”<verse eid="JHN 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5" />ईसु नीकुदेमुस काजे कह्‌यु, “मे तुसेक छाचली-छाचली कहं, जत्‌यार लग काहनुक बी माणुस भगवानेन जीव-आत्‌मा अनसारे आपसा जीव-आत्‌मा मां पयदा नी हवे, तत्‌यार लग चु भगवानेन राज मां भराय नी सके। <verse eid="JHN 3:5" /><verse number="6" style="v" sid="JHN 3:6" />काहाकी जु कुय डील सी पयदा हयु च डील छे; ने जु कुय भगवानेन आत्‌मा सी पयदा हयु चु आत्‌मात छे। <verse eid="JHN 3:6" /><verse number="7" style="v" sid="JHN 3:7" />मे तुसेक जी वात कहं तुहुंं आखा जीव-आत्‌मा मां पछा पयदा हवण्‌या छे, हीनी वातेक सामळीन तु घाबरायु मां। <verse eid="JHN 3:7" /><verse number="8" style="v" sid="JHN 3:8" />आहळी तींखुर जाणे लागे तींखुर जाय ने तु तेरी अवाज काजे सामळे ते खरु, बाकुन ची कां सी आवे, ने कां जाय, च तुसेक मालुम नी पड़े। जु-जु भगवानेन जीव-आत्‌माम सी पयदा हवलु छे, चु हीनी आहळीन तसुत छे।”<verse eid="JHN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9" />जी वात सामळीन नीकुदेमुस ईसु काजे कह्‌यु, “ज असो कसों हय सके।”<verse eid="JHN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 3:10" />ईसु, नीकुदेमुस काजे कह्‌यु, “तु ईस्‌रायली माणसेन मास्‌तर छे, तेबी तुसेक जी वात पल्‌ले नी पड़ती काय? <verse eid="JHN 3:10" /><verse number="11" style="v" sid="JHN 3:11" />मे तुसेक छाचली-छाचलीन कह्‌वो हामु जे सरग वाळा छे, हामु ज जाणजे चत कहंजे ने हामु तीनाक देखला छे, तेरीत गवाय देजे, ने तुहुंं माणसे हामरी गवाय काजे मान्‌ता काहनी। <verse eid="JHN 3:11" /><verse number="12" style="v" sid="JHN 3:12" />मे तुहुंंक धरती पर हये ची वात देखाड़्‌यु, तेबी<note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="ft" closed="false">प्रथ्वी</char></note> तुहुंं तीनी वात पर भुरसु नी कर्‌या, ने कदी मे तुहुंंक सरगेम हये ची वात देखाड़ीस ती तुहुंं कसा भुरसु करसु? <verse eid="JHN 3:12" /><verse number="13" style="v" sid="JHN 3:13" />सरग मां उपर कुय बी नी गुयो, हयु अतरुत गुयु, जु सरग सी आयु तेरो मतलब माणसेन पुर्‌यु जु सरग मां छे।”<verse eid="JHN 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 3:14" />जसु मुसु माणसे काजे भगवानेन डंडेम सी बचाड़णे करीन उजाड़्‌या बयड़ा मां घड़सान मुरती बणायन खाम्‌बा पर टांगलु तसात माणसेन पुर्‌या काजे बी उपर चहड़ाय टांगसे ने असो हवणु जरुड़ी छे। <verse eid="JHN 3:14" /><verse number="15" style="v" sid="JHN 3:15" />जु काहनुक माणसेन पुर्‌या पर भुरसु करे, चु तेरेत साहरे अमर जीवाय हात करसे <verse eid="JHN 3:15" /><verse number="16" style="v" sid="JHN 3:16" />काहाकी भगवान ईनी कळीन पापी माणसे काजे अतरु परम कर्‌यु, की तेरु एकुत लाटेक्‌लु पुर्‌यु मरने करीन आप देदु, ने जु कुय तेरे पर भुरसु करे, चु खत्‌तम नी हवे बाकुन अमर जीवन हात करसे।<verse eid="JHN 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 3:17" />भगवान आपसा पुर्‌या काजे ईनी कळी मां माणसेन नीयाव करीन डंड आप्‌णेन हुकुम आपजी करीन नी मकल्‌यु, बाकुन तेरेमां मकल्‌यु की कळी मायन माणसे हेरे साहरे छुटकारु हात करसे।<verse eid="JHN 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 3:18" />ने जु काहनुक भगवानेन पुर्‌या ईसु पर भुरसु करे, तीनाक डंडेन हुकुम नी आपे; बाकुन जु कुय ईसु पर भुरसु नी करे, चु गुनावाळु गीणाय गुयलु छे, काहाकी चु भगवानेन एखला पुर्‌यान नाव पर भुरसु नी कर्‌यु। <verse eid="JHN 3:18" /><verse number="19" style="v" sid="JHN 3:19" />भगवान नीयावेन दाहड़े माणसे काजे डंडेन फेसलु जु सामळावसे की ईसु वीजाळो हय्‌न कळी मां आवलु, बाकुन माणसे काजे वीजाळो नी बाकुन आंदारला सी अदु परम राख्‌या, काहाकी तींद्‌रा काम भुंडात हतला। <verse eid="JHN 3:19" /><verse number="20" style="v" sid="JHN 3:20" />काहाकी जु कुय कुहराय करे, तीनाक वीजाळो गमे नी, ने तेरा कुहराय्‌न काम उजन्‌ता हय जासे करीन चु वीजाळा धड़े नी आवे। <verse eid="JHN 3:20" /><verse number="21" style="v" sid="JHN 3:21" />बाकुन जु कुय छाचली वातेन अनसारे चाल्‌या करे, चु जी हिम्‌मत करीन वीजाळा धड़े आवे, ने जे वारलु काम भगवानेन मदत सी करलु छे, चे काम, ने जी वात दीसरा अगळ उजन्‌ती हय जाणु चाहजे।<verse eid="JHN 3:21" /></para>
  <para style="s">युहन्‌नु ईसु काजे बपतीस्‌मा आपे</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22" />थुड़ाक दाहड़ा हय गुया ने अळी ईसु, आपसा चेला भेळतुत यरुसलेम सहर छुड़दीन यहुदीया जीलान दीसरा जागाम जाती रयु। ने चां चु तींद्‌रे पुठ्‌ये रय्‌न बपतीस्‌मा आपणे बाजी गुयु। <verse eid="JHN 3:22" /><verse number="23" style="v" sid="JHN 3:23" />तीनी टेमे चु युहन्‌नु बी सालेम सहर धड़े एनोन गांव मां पाणीन बपतीस्‌मा आपतेलु, काहाकी चां बेसको पाणी हतलो, ने माणसे आवीन बपतीस्‌मा लेदला। <verse eid="JHN 3:23" /><verse number="24" style="v" sid="JHN 3:24" />बपतीस्‌मा आपण्‌या युहन्‌ना काजे राजु हेरोदेस तीनी टेम लग जेल मां नी कुंडाड़्‌यु।<verse eid="JHN 3:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 3:25" />चां युहन्‌नान चेला एक यहुदी माणसे साते चुखो करनेन रीतीन बारामां जखड़ी पड़्‌यु। <verse eid="JHN 3:25" /><verse number="26" style="v" sid="JHN 3:26" />ने चे युहन्‌नान चेला युहन्‌ना धड़े आवीन कह्‌या, “ए मास्‌तर, जु माणुस यरदन नदीन पली धड़े तारे पुठ्‌ये हतलु, ने तेरी तु गवाय देदलु, ने चु बपतीस्‌मा आपणे बाजी रयु, ने आखा माणसे तेरे धड़े जाय।”<verse eid="JHN 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 3:27" />युहन्‌नु जपाप आप्‌यु, “काहना बी माणसेक सरग वाळु भगवान वाटु आपसे तीत असला सेवान काम जड़से। <verse eid="JHN 3:27" /><verse number="28" style="v" sid="JHN 3:28" />मे तुहुंंक ज कय देदलु की, ‘मे मसी नी हय, बाकुन मसीन काम सुरु हवणेन पेहेल भगवान मेसेक मकेल्‌लु छे।’ ने तुहुंं मारी हीनी वातेन गवा छे। <verse eid="JHN 3:28" /><verse number="29" style="v" sid="JHN 3:29" />नवली लाडी नवला लाडा धड़े रवे, बाकुन नवला लाडान खास दुस्‌तीदार, चु नवला लाडा धड़े हुबु रय्‌न तेरी सामळे चु तेरी वात सामळीन बेसकु खुस हय जाय। तसीत हय मारी खुसी पुरी हय गुय। <verse eid="JHN 3:29" /><verse number="30" style="v" sid="JHN 3:30" />ज जरुड़ी छे, की चु बड़तु जाय ने मे कम हवतु जाम।<verse eid="JHN 3:30" /></para>
  <para style="s">ईसु मसी सरगे सी उतर्‌यु</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31" />“जु उपर सी आवे, चु आखा सी मट्‌लु छे। ईसु अतरुत सरग वाळा भगवानेन्‌चां सी आयु, हेरेसी चु आखाम सी मट्‌लु छे, धरती सी छे, बाकुन चु धरती पर रवण्‌यु छे, चु धरतीन छे, ने धरती पर वाळान तसात वात करे <verse eid="JHN 3:31" /><verse number="32" style="v" sid="JHN 3:32" />ईसु ज काय चु देख्‌यु ने सामळ्‌यु, तेरीत गवाय देय; ने कुय तेरी गवाय नी माने। <verse eid="JHN 3:32" /><verse number="33" style="v" sid="JHN 3:33" />जु कुय ईसुन गवाय मान लेदु, चु ईनी वात पर छाप लागाड़ देदु की, भगवान छाचलु छे। <verse eid="JHN 3:33" /><verse number="34" style="v" sid="JHN 3:34" />काहाकी तीनाक भगवान मकेल्‌लु छे, चु भगवानेन वात कहें, काहाकी भगवान आत्‌मा अमर जीवाय आपलु छे। <verse eid="JHN 3:34" /><verse number="35" style="v" sid="JHN 3:35" />भगवान बास पुर्‌या सी परम करे, ने चु आखी चीज तेरा हात मां सुप देदु। <verse eid="JHN 3:35" /><verse number="36" style="v" sid="JHN 3:36" />जु भगवानेन पुर्‌या ईसु पर भुरसु करे, अमर जीवन तेरीत छे, बाकुन जु ईसुक नी माने, चु अमर जीवन काजे नी देखे, बाकुन भगवानेन रीस तेरे पर रहे ने तीनाक डंड जड़से ने जड़से।”<verse eid="JHN 3:36" /></para>
  <chapter eid="JHN 3" />
  <chapter number="4" style="c" sid="JHN 4" />
  <para style="s">ईसु ने सामरी बायर</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1" />फरीसी माणसे ईसुन बारामां ज सामळ्‌या की, ईसु बपतीस्‌मा आपण्‌या युहन्‌नान चेला सी अदुस चेला बणावे, ने तीनु चेलाक बपतीस्‌मा आपे <verse eid="JHN 4:1" /><verse number="2" style="v" sid="JHN 4:2" />अदुस ईसु आपसुत बपतीस्‌मा नी आपतेलु बाकुन ईसुन खास चेला, दीसरा नवला चेला बणावणे करीन बपतीस्‌मा आपतेला। <verse eid="JHN 4:2" /><verse number="3" style="v" sid="JHN 4:3" />ती ईसु यहुदीया जीला काजे छुड़ीन अळी पछु गलील जीला भीणी जाती रयु। <verse eid="JHN 4:3" /><verse number="4" style="v" sid="JHN 4:4" />हीनी कावा ईसु, आपसा चेला पुठ्‌ये सामरीया जीला मायन गुयु।<verse eid="JHN 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 4:5" />जाते-जाते चे, सामरीया जीलान सुखार नावेन एक सहर धड़े पुग्‌या। चां एक खेत हतलो, च खेत अगला वाराम याकुब आपसान पुर्‌या युसुफ काजे आपलु। <verse eid="JHN 4:5" /><verse number="6" style="v" sid="JHN 4:6" />चां याकुब्‌यान साहरे खुदाड़लु कुवु बी हतलु, तत्‌यार ईसुक चु कुवु देखायु, ईसु ते, चाली चालीन हारी पड़लु। अळतेन चु तीना कुवा धड़े चां बठ गुयलु। हय खयार दाहड़ु हय रवलु।<verse eid="JHN 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 4:7" />तीनी टेमे तीना कुवा पर एक सामरी बायर पाणी भरने आवी। तत्‌यार ईसु तीनीक कह्‌यु, “मेसेक पाणी पीयाड़ दे।” <verse eid="JHN 4:7" /><verse number="8" style="v" sid="JHN 4:8" />काहाकी तेरा चेला खाणो मुल लेणे करीन सहर मां जाय रवला।<verse eid="JHN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 4:9" />तीनु दाहड़ाम यहुदी माणसे सामरी माणसे साते छीट राखतेला, अळी ची सामरी बायर ईसु काजे कय, “तु यहुदी जातीन हय्‌न बी मारे धड़े पाणी पीणे करीन काहा मांगे? मे ते एक सामरी जातीन बायर छे।”<verse eid="JHN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 4:10" />ईसु तीनीक जपाप आप्‌यु, “कदी तु ज नी जाण लेती की, भगवान तुसेक काहनु वाटु आपणे हींडे, ने जु तारे धड़े पीणे करीन पाणी मांग र्‌यु, चु कुण छे। कदी तु जाण लेती ती मारे धड़े पाणी मांगती, ने मे तुसेक अमर जीवेन पाणी आपतु।”<verse eid="JHN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 4:11" />सामरी बायर ईसुक कय, “ए मालीक तारे धड़े ते कुवाम सी पाणी लाटणे करीन ठाहरु बी नी हय, ने कुवु उंडु छे; ती च अमर जीवन आपण्‌यो पाणी तु कां सी लावसी? <verse eid="JHN 4:11" /><verse number="12" style="v" sid="JHN 4:12" />तु हामरा बास याकुब सी बी मटु छे काय? जु हामु काजे गुयु कुवु आपलु; चु बी हीना कुवाम सीत पाणी पीदलु, ने तेरा पुर्‌या ने तेरा पाळ्‌ळा जनवार्‌या लग हीना कुवाम सी पाणी पीदा।”<verse eid="JHN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 4:13" />ईसु सामरी बायर काजे कह्‌यु, “ज कुय पाणी पीये तीनाक अळी पीस लागसे, <verse eid="JHN 4:13" /><verse number="14" style="v" sid="JHN 4:14" />बाकुन मे आपीस च पाणी, जु बी पीसे तीनाक कदी पीस नी लागे। अतरोत नी बाकुन च पाणी तेरी जीवाय मां पाणीन झीर बण जासे। ने तेरी अमर जीवाय वाटे खळो-खळो उंहतो रवसे।”<verse eid="JHN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 4:15" />तत्‌यार सामरी बायर ईसुक कय, “ए मालीक मेसेक च पाणी आप ती मेसेक अळी-अळी पीस नी लागे, ने मेसेक चां पछो पाणी भरने आवणु नी पड़े।”<verse eid="JHN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 4:16" />ईसु तीनीक कह्‌यु, “जाय्‌न तारा घरवाळा काजे बुलाय लाव।”<verse eid="JHN 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 4:17" />ची बायर<note caller="+" style="f"><char style="fr" closed="false">4:17 </char><char style="ft" closed="false">स्त्री</char></note> जपाप आपी, “मारु घरवाळु नी हय।”</para>
  <para style="p" vid="JHN 4:17">ईसु तीनीक कह्‌यु, “तु संय कय की मारु घरवाळु नी हाय।” <verse eid="JHN 4:17" /><verse number="18" style="v" sid="JHN 4:18" />हव तु पांच लाडा कर लेदली, ने हय तु तेरे भेळे रय चु बी तारु घरवाळु नी हय, तु जी वात छाचलीन कय रय।<verse eid="JHN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19" />जी वात सामळीन बायर ईसुक कही, ए मालीक असो लागे की, तु भगवानेन अघली वात बताड़न्‌यु माणुस छे। <verse eid="JHN 4:19" /><verse number="20" style="v" sid="JHN 4:20" />हामरा डाहा-डाहा हीना बयड़ा पर पुजा-पाट कर्‌या, ने तुहुंं यहुदी माणसे कह्‌वु की पुजा-पाट करनेन जागु यरुसलेम सहर मां छे।<verse eid="JHN 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 4:21" />ईसु तीनीक कह्‌यु, “ओ बायर, मारी ईनी वात पर भुरसु कर, काहाकी असी टेम आवणे बाजी रय, की तीने टेमे तुहुंं नी ते हीना बयड़ा पर ने नीते यरुसलेम मां भगवानेन पुजा-पाट करसु। <verse eid="JHN 4:21" /><verse number="22" style="v" sid="JHN 4:22" />तीनाक तुहुंं नी जाणु तेरी पुजा-पाट करु ने हामु तीनाक जाणजे तेरी पुजा-पाट करजे, काहाकी छुटकारु यहुदी जातीवाळा मसी मां सीत जड़से। <verse eid="JHN 4:22" /><verse number="23" style="v" sid="JHN 4:23" />बाकुन हय ची टेम आवणे बाजी रय, ने हींताळ आय गुय, तीने टेमे छाचलीन भगवानेन पुजा-पाट करन्‌या, तेरा चुखली-आत्‌मा मां बणीन तेरी छाचली वातेन अनसारे भगवान बासेन भक्‌ती करसे। काहाकी भगवान बास आपसा वाटे असली भक्‌ती करन्‌यात काजे हेर र्‌यु। <verse eid="JHN 4:23" /><verse number="24" style="v" sid="JHN 4:24" />भगवान जीव-आत्‌मा छे, ने तेरे मां छाचलीन भगवानेन भक्‌ती करन्‌या काजे तेरा जीव-आत्‌मा मां रय्‌न ने छाचे मन तेरी भक्‌ती करनु चाहजे।”<verse eid="JHN 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 4:25" />सामरी बायर ईसुक कय, “मेसेक मालुम छे, की छुड़ावन्‌यु मसी जु खीरीस्‌त कह्‌वाये, चु आवणे वाळु छे; जत्‌यार<note caller="+" style="f"><char style="fr" closed="false">4:25 </char><char style="ft" closed="false">जब</char></note> चु आवसे, तत्‌यार हामु काजे आखी वात कय देसे।”<verse eid="JHN 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 4:26" />ईसु तीनीक कह्‌यु, “मेत मसी छे, जु तारे साते वात करने बाजी र्‌यु।”<verse eid="JHN 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27" />तीनी टेमे ईसुन चेला आय गुया, ने ईसु काजे एक बायर साते वात करतेलु देखीन वीच्‌यार मां पड़ गुया; तेबी कुय बी ज नी कह्‌यो की तु हेरे धड़े सी काय मांग रयु? “नीते तु हीनी साते काहा वात कर रयु?” <verse eid="JHN 4:27" /><verse number="28" style="v" sid="JHN 4:28" />तत्‌यार ची बायर आपसीत वटळु चांहान रहणीदीन तेरा सहर मां जाय्‌न माणसेक ज कहंणे बाजी गुय। <verse eid="JHN 4:28" /><verse number="29" style="v" sid="JHN 4:29" />“चालु, एक माणुस काजे देख लेवु! चु माणुस, मे ज करली च आखो कय देदु; कांखुर मायन हयुत मसी हसे?” <verse eid="JHN 4:29" /><verse number="30" style="v" sid="JHN 4:30" />तीनी बायरीन वात सामळीन तीना सहर वाळा माणसे सहरेम सी नीकळीन ईसु काजे भेळा हवणे हुड़ु-हुड़ु आवतेला।<verse eid="JHN 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 4:31" />तीने टेमे ईसुन चेला ईसु सी लीलघाय्‌न कह्‌या, “ए मास्‌तर थुड़ोक खाय ले।”<verse eid="JHN 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 4:32" />बाकुन ईसु तीनुक कह्‌यु, “मारे धड़े खाणे वाटे असो खाणो छे, तीना खाणान बारामां तुहुंंक मालुम नी हय।”<verse eid="JHN 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 4:33" />अतरात मां ईसुन चेला आपसा-आपसात कह्‌या, “कुय हेरे वाटे खाणो लायु हसे काय? करीन चु असु कय र्‌यु।”<verse eid="JHN 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 4:34" />जी वात समजीन ईसु तीनुक कह्‌यु, “मारो खाणो ज छे, की मारा मकलने वाळान मरजीन अनसारे चालो ने तेरो काम पुरो करो। <verse eid="JHN 4:34" /><verse number="35" style="v" sid="JHN 4:35" />तुहुंं ते असा कवता आय रया, मेर पाकणेन हय चार महना बच रया। बाकुन मे तुहुंंक दाखलान साहरे कह्‌वो, आपसा पापण्‌या उपर करीन ईनु खेत भीणी देखु, ईनु खेतेन मेर पाकीन धवळी फक हय गुय काटणे वाटे तीयार हय गुय। <verse eid="JHN 4:35" /><verse number="36" style="v" sid="JHN 4:36" />काटणे वाळाक दाहड़की जड़े ने अमर जीवाय वाटे फळ भेळा करे, काहाकी एरने वाळु ने काटणे वाळु दुयु खुस हवे। <verse eid="JHN 4:36" /><verse number="37" style="v" sid="JHN 4:37" />काहाकी जु दाखलु संय छे, ‘एरने वाळु काहनुक दीसरु छे, ने काटणे वाळु काहनु दीसरु छे।’ <verse eid="JHN 4:37" /><verse number="38" style="v" sid="JHN 4:38" />मे तुहुंंक पलो खेत काटणे वाटे मकल्‌यु जाहां तुहुंं मेहनत नी कर्‌या, ने दीसरा मेहनत कर्‌या ने तुहुंं तींद्‌रा मेहनतेन फळ मां भेसकाय गुया।”<verse eid="JHN 4:38" /></para>
  <para style="s">सामरी माणसेन भुरसु</para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39" />चां सामरी बायर ईसुन बारामां असी गवा देदली की, “चु माणुस, मे ज करली च आखो कय देदु। अळतेन तीना सामरीया जीलान बेसका माणसे सामरी बायरीन मुंहडे ईसुन बारामां जी गवा सामळीन ईसु पर भुरसु करने बाजी गुया।” <verse eid="JHN 4:39" /><verse number="40" style="v" sid="JHN 4:40" />तेरेमां तत्‌यार ची सामरी बायर ईसु धड़े आय ती ईसु सी लीलघाय्‌न कह्‌णे बाजी गुय की हामरेन्‌चां रव। अळतेन ईसु चां दुय तीन दाहड़ा लग रयु।<verse eid="JHN 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 4:41" />ने ईसुन वात सामळी बेसका दीसरा माणसे बी ईसु पर भुरसु कर्‌या। <verse eid="JHN 4:41" /><verse number="42" style="v" sid="JHN 4:42" />ने अळी तीनी सामरी बायर काजे कह्‌या, “हय हामु तारी सामळीन ईसु पर भुरसु करने बाजी गुया; काहाकी हामु ईसुन वात सामळी लेदा, की छाचलीन हयु की हयु ईनी कळीन<note caller="+" style="f"><char style="fr" closed="false">4:42 </char><char style="ft" closed="false">जगत</char></note> माणसेक पाप सी छुड़ावणे वाळु छे, करीन तेरे पर भुरसु कर रया।”<verse eid="JHN 4:42" /></para>
  <para style="s">गलील जीला मां ईसु काजे वार काम करन्‌यु माने, बाकुन बचाड़न्‌यु करीन भुरसु नी करे</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43" />अळतेन दुय दाहड़ा वीती गुया, ने ईसु आपसा चेला भेळु सामरीया जीलाम सी नीकळीन गलील जीलाम जात रयु। <verse eid="JHN 4:43" /><verse number="44" style="v" sid="JHN 4:44" />ईसु ते आपसुत असी गवा देदलु की, “भगवानेन अघी सी आवणे वाळी वात देखाड़न्‌यु, तीना काजे आपसान देस मां ईज्‌जत नी जड़े।” <verse eid="JHN 4:44" /><verse number="45" style="v" sid="JHN 4:45" />जत्‌यार ईसु गलील जीलाम पुग्‌यु, ती गलील वाळा माणसे ईसु तेरेत अनसारे ईसु साते वेहवार कर्‌या। चे बी तीहवारेन टेमे यरुसलेम सहर गुयला, ने तीहवारेन दाहड़ाम ईसु यरुसलेम मां जतरा बी वारलु काम करलु, चे आखा काम देखला हतला करीन ईसुन आव-भाव कर्‌या।<verse eid="JHN 4:45" /></para>
  <para style="s">ईसु काजे गलील वाळा मटो काम करन्‌यु करीन माने</para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46" />तत्‌यार ईसु एक कावा अळी गलील जीलान काना सहर मां आयु, चां चु पाणी काजे अंगुरेन रस बणाय देदलु। ने हीना काना सहर साते वाळा कफरनहुम सहर राजान एक खास पावर हतलु, तेरु पुर्‌यु मांदलु हतलु। <verse eid="JHN 4:46" /><verse number="47" style="v" sid="JHN 4:47" />चु ज सामळ्‌यु की यहुदीया सी ईसु आपसान गांव मां सी गलील जीलाम आय गुयलु छे, ती चु काना सहर मां ईसु धड़े गुयु, ने ईसु सी लीलघाय्‌न कह्‌यु की चाल मारा पुर्‌या काजे वारु कर दे। काहाकी तेरु पुर्‌यु मरने वाळु हतलु। <verse eid="JHN 4:47" /><verse number="48" style="v" sid="JHN 4:48" />ईसु गलील वाळा माणसेन कम भुरसु देखीन कह्‌यु, “जत्‌यार लग तुहुंं मटा कामेन सहलाणी नी देखु, तत्‌यार लग तुहुंं मार पर भुरसु नी करसु।”<verse eid="JHN 4:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 4:49" />चु राजान खास पावर्‌यु ईसुक कह्‌यु, “ए मालीक मामार चाल नेते मारु पुर्‌यु मर जासे।”<verse eid="JHN 4:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 4:50" />ईसु तीना राजान खास पावर्‌याक कह्‌यु, “जां तारु पुर्‌यु<note caller="+" style="f"><char style="fr" closed="false">4:50 </char><char style="ft" closed="false">पुत्र</char></note> नी मरे, चु जीवतेलु रवसे।”</para>
  <para style="p" vid="JHN 4:50">चु राजान पावर्‌यु ईसुन ईनी वात पर भुरसु करीन जाती रयु। <verse eid="JHN 4:50" /><verse number="51" style="v" sid="JHN 4:51" />चु राजान खास पावर्‌यु वाटेत हतलु, ती तीना पावर्‌यान, पावर्‌या आय्‌न तीनाक भेळा हया ने कह्‌या, “तारु पुर्‌यु वारु हय गुयु ने जीवतु छे।”<verse eid="JHN 4:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 4:52" />चु तीनुक पुछ्‌यु, “काहने टेमे मारु पुर्‌यु वारु हवणे बाजी गुयलु, चे कह्‌या काल दीसु एक बजे तेरो सेरी उतरी गुयलो।” <verse eid="JHN 4:52" /><verse number="53" style="v" sid="JHN 4:53" />तत्‌यार तीना मांदला पुर्‌यान बासेक जी वात हेर आवी की ईसु हीनीत टेमे ज कहंलु, “जां तारु पुर्‌यु जीवतु छे।” ने असु करीन चु राजान पावर्‌यु ने तेरा घरना आखा माणसे ईसु पर भुरसु कर्‌या।<verse eid="JHN 4:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 4:54" />ज पेहला मायन दीसरा मटा कामेन सहलाणी हतली, जु ईसु यहुदीया सी गलील जीलाम पछु आय्‌न देखाड़्‌यु।<verse eid="JHN 4:54" /></para>
  <chapter eid="JHN 4" />
  <chapter number="5" style="c" sid="JHN 5" />
  <para style="s">ईसु यरुसलेम मां एक मांदलाक वारु करे</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1" />अळतेन यहुदी माणसेन एक तीहवार आयु, ने ईसु यरुसलेम सहर अळी गुयु। <verse eid="JHN 5:1" /><verse number="2" style="v" sid="JHN 5:2" />यरुसलेम सहरेम गाडरान फाटक धड़े एक कुंडान तसों हतलो, तीनाक ईब्‌रानीयो माणसेन बुली मां बेतसेदा कह्‌वे; ने हीना कुंडान चारे मेर पांच मांडवा हतला। <verse eid="JHN 5:2" /><verse number="3" style="v" sid="JHN 5:3" />चां बेसका मांदवाड़ वाळा, आंदळा, लंगड़ा, ने पांगळा पाणी झलकायणेन वाट देखीन पड़ी रवतेला, <verse eid="JHN 5:3" /><verse number="4" style="v" sid="JHN 5:4" />काहाकी ठहरावली टेम पर भगवानेन सरग वाळु काहवाळ्‌यु कुंडा मां उतरीन पाणीक गचळावतेला। पाणी हवतेत जु काहनुक पेहेल उतरे चे मांदवाड़ वाळा वारु हय जाय, चाहे तेरी काहनी बी मांदवाड़ हय। <verse eid="JHN 5:4" /><verse number="5" style="v" sid="JHN 5:5" />तीना हळावेन चां एक माणुस हतलो, च दुय कम चालीस साल लग, चां मांदलु पड़ी रवलु। <verse eid="JHN 5:5" /><verse number="6" style="v" sid="JHN 5:6" />ईसु तीनाक चां पड़ी रवलो देख्‌यु ने ज जाणीन की चु बेसका दाहड़ा सी असुत पड़ रवलु तेरेमां तीना मांदला काजे कह्‌यु, “तु वारु हवणे हींडे काय?” <verse eid="JHN 5:6" /><verse number="7" style="v" sid="JHN 5:7" />च मांदलो ईसु काजे जपाप आप्‌यु, “ए मालीक, पाणी झलकाय्‌तात मेसेक हळाव मां उतारे असो कुय माणुस मारे पुठ्‌ये नी हय। ने मेसेक पुगणेन पेहलुत हळाव मां दीसरु मांदलो माणुस उतरी पड़े।”<verse eid="JHN 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 5:8" />ईसु तीनाक कह्‌यु, “उबु हय जां। ने तारी गुदड़ी हाकलीन चाल।” <verse eid="JHN 5:8" /><verse number="9" style="v" sid="JHN 5:9" />च माणुस तत्‌यारुत वारु हय गुयो,</para>
  <para style="p" vid="JHN 5:9">ने तेरी गुदड़ी हाकलीन हींडणे बाजी गुयो चु दाहड़ु आरामेन दाहड़ु हतलु। <verse eid="JHN 5:9" /><verse number="10" style="v" sid="JHN 5:10" />तेरेमां यहुदी माणसेन मुख्‌या तीना वारु हवला माणसेक कहंणे बाजी गुया, “आज आरामेन दाहड़ु छे। आज कायदान अनसारे तारे धड़े गुदड़ी हाकलनु वारु नी हय।”<verse eid="JHN 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 5:11" />चु वारु हवलु माणुस तीनुक कह्‌यु, जु मेसेक वारु<note caller="+" style="f"><char style="fr" closed="false">5:11 </char><char style="ft" closed="false">चंगा</char></note> करलु छे, चु मेसेक कहंलु छे, “उबु हय जां। ने तारी गुदड़ी हाकलीन जाती रव।”<verse eid="JHN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 5:12" />चे तीनाक पुछ्‌या, चु कुण छे, चु तुसेक कह्‌यु की, “उबु हय जां ने तारी गुदड़ी हाकलीन जाती रव?” <verse eid="JHN 5:12" /><verse number="13" style="v" sid="JHN 5:13" />बाकुन चु वारु हवलु, चु माणुस नी जाणतेलु की चु कुण छे, काहाकी चां जागा पर माणसेन गड़दी हवणे सी ईसु चां सी जाती रवलु।<verse eid="JHN 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 5:14" />अळतेन ईसु तीना वारु हवला माणुस काजे ईसु मंदीर मां भेळु हयु, ती ईसु तीनाक कह्‌यु, “देख तु वारु हय गुयलु छे, अळी पाप घुण करे। नीते कांखुर मायन तार पर एर सी बी अळी जादा गरा आय पड़से।”<verse eid="JHN 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 5:15" />चु माणुस जाय्‌न यहुदी माणसेक कह्‌यु की चु मेसेक वारु करलु चु ईसु छे। <verse eid="JHN 5:15" /><verse number="16" style="v" sid="JHN 5:16" />ईसु आरामेन दाहड़े असो काम कर्‌यु, करीन यहुदी माणसे ईसु काजे दमणे बाजी गुया। <verse eid="JHN 5:16" /><verse number="17" style="v" sid="JHN 5:17" />ईसु तीनु दमण्‌याक ज कह्‌यु, “मारु बास हय लगुन काम करने बाजी रयु ने मे बी काम करने बाजी रयु।”<verse eid="JHN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 5:18" />ईनी वजे सी यहुदी ने अदुस तीनाक मार नाखणेन कुसीत करने लाग्‌या, काहाकी हयु आरामेन दाहड़े वाळा रीतीक अतरुत नी तुड़े, बाकुन भगवान काजे मारु बास कहीन आपसा काजे भगवान बराबर बी ठहरावतेलु।<verse eid="JHN 5:18" /></para>
  <para style="s">पुर्‌यान हक</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19" />ईसु तीनुक कह्‌यु, मे तुहुंंक छाचलीन कहं भगवानेन पुर्‌यु आपसान मन सी काय बी नी कर सके, बाकुन चु आपसान भगवान बासेक करतेलु देखे; काहाकी ज-ज काम भगवान बास करे चत काम तेरु पुर्‌यु बी करे। <verse eid="JHN 5:19" /><verse number="20" style="v" sid="JHN 5:20" />काहाकी भगवान बास ते पुर्‌या सी परम राखे ने ज-ज काम चु करे चो आखो तीनाक देखाड़े; ने चु हेरेसी बी मटा काम तीनाक देखाड़से ने चे काम देखीन तुहुंं घाबराय जासु। <verse eid="JHN 5:20" /><verse number="21" style="v" sid="JHN 5:21" />तुहुंंक मालुम छे की भगवान मर्‌या सर्‌याक जीवता करीन बठा करे। तसुत पुर्‌या धड़े बी जीनुक गमे तीनुक नवलो जीवन आपणेन ने जीवता करीन बठा करनेन हक छे। <verse eid="JHN 5:21" /><verse number="22" style="v" sid="JHN 5:22" />भगवान बास ते कुयन बी नीयाव नी करे, बाकुन माणसेन नीयाव करनेन आखो हक तेरा पुर्‌या काजे आप देदलु छे। <verse eid="JHN 5:22" /><verse number="23" style="v" sid="JHN 5:23" />काहाकी आखा माणसे भगवान बासेन ईज्‌जत करे; तसान तसा आखा माणसे तेरा पुर्‌यान बी ईज्‌जत करनु चाहे। चु पुर्‌यान ईज्‌जत नी करे चु पुर्‌या काजे मकलन्‌या भगवान बासेन बी ईज्‌जत नी करे।<verse eid="JHN 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24" />मे तुहुंंक छाचलीन कहं, जु मारा बुले सामळीन मेसेक मकलन्‌या भगवान बास पर भुरसु करे तीनाक अमर जीवन जड़से ने नीयावेन दाहड़े तीनाक डंडेन हुकुम नी जड़े बाकुन चु मुत काजे छेकीन अमर जीवन हात कर लेदलु छे। <verse eid="JHN 5:24" /><verse number="25" style="v" sid="JHN 5:25" />मे तुंद्‌रे सी छाचलीन कहं च टेम<note caller="+" style="f"><char style="fr" closed="false">5:25 </char><char style="ft" closed="false">समय</char></note> आवसे ने मरला माणसे भगवानेन पुर्‌यान बुल सामळसे ने जे सामळसे चे मर्‌या-सर्‌याम सी जीवता हय जासे। <verse eid="JHN 5:25" /><verse number="26" style="v" sid="JHN 5:26" />काहाकी भगवान बास जीवनेन झीर छे, तसुत चु हेरा पुर्‌या काजे बी ज हक आपलु छे की तु बी जीवनेन झीर छे; <verse eid="JHN 5:26" /><verse number="27" style="v" sid="JHN 5:27" />अतरोत नी बाकुन भगवानेन पुर्‌यु माणसेन पुर्‌यु बणीन आवलु छे, तेरेमां तीनाक माणसेन नीयाव करनेन बी हक आपलु छे। <verse eid="JHN 5:27" /><verse number="28" style="v" sid="JHN 5:28" />मर्‌या-सर्‌याम सी जीवता हवणेन बारामां घुण घाबरायु काहाकी ची टेम आवणे बाजी रय, तीने टेमे जतरा बी मड़ायट्‌या मां गाड़ला छे चे आखा भगवानेन पुर्‌यान बुल सामळीन<note caller="+" style="f"><char style="fr" closed="false">5:28 </char><char style="ft" closed="false">सुनकर</char></note> जीन्‌दा हय जासे ने मड़ायट्‌या मां सी नीकळीन आवसे। <verse eid="JHN 5:28" /><verse number="29" style="v" sid="JHN 5:29" />जे भगवानेन नींगाम भलाय करला छे अमर जीवन वाटे मरलाम सी जीवता हय्‌न बठा हवसे, ने जे भगवानेन नींगा मां कुहराय करला छे, चे नीयावेन दाहड़े डंड भुकत्‌णे करीन मरलाम सी जीवता हय्‌न मड़ायट्‌याम सी नीकळसे।<verse eid="JHN 5:29" /></para>
  <para style="s">ईसुन बारामां गवाय</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 5:30" />मे मारी मरजी सी काय बी नी कर सको। तेरेत अनसारे नीयाव करो; ने मारु नीयाव छाचु छे काहाकी मे मारी मरजी सी नी बाकुन मे मकलने वाळा भगवानेन मरजी पुरी करो।<verse eid="JHN 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 5:31" />कदी मे मारा बारामां मे अतरुत गवा दम ती मारी गवाय छाचली नी हय। <verse eid="JHN 5:31" /><verse number="32" style="v" sid="JHN 5:32" />एक अळी छे चु मारी गवाय देय ने मे जाणो की चु मारी गवाय देय ने तेरी गवाय छाचली छे। <verse eid="JHN 5:32" /><verse number="33" style="v" sid="JHN 5:33" />तुहुंं बपतीस्‌मान रीत आपण्‌या युहन्‌ना धड़े पुछणे करीन माणसे काजे मकल्‌या, ने तत्‌यार चु मारा बारामां छाचली गवाय देदु। <verse eid="JHN 5:33" /><verse number="34" style="v" sid="JHN 5:34" />बाकुन मे मारा बारामां माणसेन गवाय नी चाहतु; जी वात तेरेमां कव की तुहुंं पाप सी छुटकारु जड़े। <verse eid="JHN 5:34" /><verse number="35" style="v" sid="JHN 5:35" />युहन्‌नु ते एक धपतेला दिवान तसलु हतलु, ने तुहुंंक ईतरीक वार लग तीना दिवान वीजाळा मां खुस रहणु वारु लाग्‌यो। <verse eid="JHN 5:35" /><verse number="36" style="v" sid="JHN 5:36" />बाकुन युहन्‌नु मारे बारामां जी गवा देदलु, तीनी गवाय सी मटी गवा मारे धड़े छे, काहाकी ज काम करने भगवान बास मेसेक मकेल्‌लु छे, चेत काम मे करने बाजी रयु ने चेत काम मारे बारामां जी गवा दी रया की मारु भगवान बास मेसेक मकेल्‌लु छे। <verse eid="JHN 5:36" /><verse number="37" style="v" sid="JHN 5:37" />ने भगवान बास जु मेसेक मकेल्‌लु छे, चु मारी गवा देदलु छे। तुहुंं कदी बी तेरो वचन नी सामळ्‌या ने तेरु सीकु नी देख्‌या। <verse eid="JHN 5:37" /><verse number="38" style="v" sid="JHN 5:38" />ने हेरा बुल काजे मन मां बठाड़ीन नी राखे, काहाकी तीनाक हयु मकल्‌यु तेरे पर तुहुंं भुरसु नी करु। <verse eid="JHN 5:38" /><verse number="39" style="v" sid="JHN 5:39" />तुहुंं चुखली-सास्‌तुर मां चाळवीन भन्‌ने हामु काजे अमर जीवन जड़से, असु वीच्‌यार करीन तुहुंं चुखली-सास्‌तुर काजे चाळवीन भण्‌या बाकुन जीत चुखली-सास्‌तुर मारा बारामां असी गवा देदी आय रय की जु आवणेवाळु छे, हयुत अमर जीवन आपण्‌यु छे! <verse eid="JHN 5:39" /><verse number="40" style="v" sid="JHN 5:40" />तेबी तुहुंं जीवन हात करने करीन मारे धड़े आवणे नी हींडता।<verse eid="JHN 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41" />मेसेक माणसे धड़े सी ईज्‌जत नी चाहती। मेसेक ईज्‌जत आपण्‌यु ते मारुत भगवान बास छे। <verse eid="JHN 5:41" /><verse number="42" style="v" sid="JHN 5:42" />बाकुन मेसेक मालम छे की तुंद्‌रे माहें भगवानेन परम नी हय। <verse eid="JHN 5:42" /><verse number="43" style="v" sid="JHN 5:43" />मे मारा भगवानेन नाव सी आवलु छे, तेबी तुहुंं मेसेक मानीन मार पर भुरसु नी करता; कदी काहनुक दीसरु आपसान नावे आवे ती तुहुंं तीनाक मानीन तेर पर भुरसु कर लेसु। <verse eid="JHN 5:43" /><verse number="44" style="v" sid="JHN 5:44" />तुहुंं ते आंबा-सांबा ईज्‌जत ने आव-भाव हात करने हींड रया, बाकुन तुहुंंक एकुत भगवान सी ईज्‌जत ने आव-भाव जड़से ने तुहुंं नी चाहता, ती तुहुंं मारे पर कसा काय भुरसु करसु? <verse eid="JHN 5:44" /><verse number="45" style="v" sid="JHN 5:45" />असा घुण समजु की मे भगवान अगळ तुहुंं काजे गुनाळा ठहरावीस, तुंद्‌रे पर गुनु लागाड़ने वाळु ते मुसा छे, तेरे पर तुहुंं भुरसु राख र्‌या। <verse eid="JHN 5:45" /><verse number="46" style="v" sid="JHN 5:46" />काहाकी कदी तुहुंं मुसा पर भुरसु करता ती मारु बी भुरसु करता काहाकी चु मारा बारामां<note caller="+" style="f"><char style="fr" closed="false">5:46 </char><char style="ft" closed="false">विषय</char></note> लिखलु। <verse eid="JHN 5:46" /><verse number="47" style="v" sid="JHN 5:47" />बाकुन कदी तुहुंं मुसान लिखली वात पर लग भुरसु नी करु, ती मारी वात पर कसा भुरसु करसु?<verse eid="JHN 5:47" /></para>
  <chapter eid="JHN 5" />
  <chapter number="6" style="c" sid="JHN 6" />
  <para style="s">ईसु पांच हजार माणसेक खावाड़े</para>
  <para style="r">(<ref loc="MAT 14:13-21">मत्‌ती 14:13-21</ref>; <ref loc="MRK 6:30-44">मरकुस 6:30-44</ref>; <ref loc="LUK 9:10-17">लुका 9:10-17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1" />थुड़ाक दाहड़ा हय गुया ने अळतेन, गलील सी ईसु आपसा चेला भेळुत गलील डाबरान पली धड़ जाती र्‌यु। ईना गलील डाबरा काजे तीबीरीयासेन मटलो डाबरो बी कहें। <verse eid="JHN 6:1" /><verse number="2" style="v" sid="JHN 6:2" />ईसु, बेसका मांदला माणसेक वारु करतेलु। ईसुन ईनु मटा कामेन सहलाणी देखीन माणसेन एक मटुत टुळु<note caller="+" style="f"><char style="fr" closed="false">6:2 </char><char style="ft" closed="false">गड़दी</char></note> ईसु पछळ चाल पड़्‌यु। <verse eid="JHN 6:2" /><verse number="3" style="v" sid="JHN 6:3" />तत्‌यार ईसु बयड़ा पर चहड़ीन हेरा चेला पुठ्‌ये चां बठ गुयु। <verse eid="JHN 6:3" /><verse number="4" style="v" sid="JHN 6:4" />यहुदी माणसेन फसहन तीहवार सातेत आय रवलु। <verse eid="JHN 6:4" /><verse number="5" style="v" sid="JHN 6:5" />जत्‌यार ईसु बेसकु मटु माणसेन टुळा काजे हेरे भीणी आवतेला देख्‌यु, ती फीलीप्‌पुस सी कह्‌यु, “हीनु आखा माणसे काजे रुटा खावाड़ने वाटे कां सी मुल लावसुन?” <verse eid="JHN 6:5" /><verse number="6" style="v" sid="JHN 6:6" />ईसु जी वात फीलीप्‌पुस काजे पंतारने करीन कहंलु, काहाकी ईसु काजे जी वात मालुम हतली की चु काय करने वाळु छे।<verse eid="JHN 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7" />फीलीप्‌पुस ईसु काजे कह्‌यु, “दुय सोव दाहड़ान दाहड़कीन रुप्‌यान रुटा लावसु ने, ईतराक-ईतराक वाटसु तेबी हींद्‌रे वाटे पुरती नी हवे।”<verse eid="JHN 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 6:8" />ईसुन चेला मायन सीमोन पतरसेन सगु भायस अन्‌दीरीयास ईसु काजे कह्‌यु, <verse eid="JHN 6:8" /><verse number="9" style="v" sid="JHN 6:9" />“जां एक नानलु पुर्‌यु छे तेरे धड़े जळ-गहुंन पांच रुटा ने दुय माछा छे, बाकुन अतरा माणसे मां काय हवसे।”<verse eid="JHN 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 6:10" />ईसु जपाप आप्‌यु, “माणसेक पंगते बठाड़ देवु।” तीना जागा पर बेसकु वारु चारु हतलु; चां माणसे बठी गुया। ने चां अदमी पांचेक हजार हतला। <verse eid="JHN 6:10" /><verse number="11" style="v" sid="JHN 6:11" />तत्‌यार ईसु रुटा हातेम लेदु, ने रुटा लीन भगवान काजे कह्‌यु, तु बेसकु वारु, ने चु बठी रवला माणसेम चे रुटा वाटाड़ देदु। ने माछा बी तसुत वाटाड़्‌यु। <verse eid="JHN 6:11" /><verse number="12" style="v" sid="JHN 6:12" />जत्‌यार माणसे खायलीन आफरी गुया, ती ईसु हेरा चेला सी कह्‌यु, “बचला रुटान कुटका भेळा कर लेवु, थुड़ाक बी रद नी हवणु चाहे।” <verse eid="JHN 6:12" /><verse number="13" style="v" sid="JHN 6:13" />अळतेन चेला खायलीन रवला जळ-गहुंन रुटान कुटका काजे भेळा कर्‌या ती बारे चार्‌या भराय गुया।<verse eid="JHN 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 6:14" />माणसे ईसुन मटला कामेन सहलाणी देखीन कय पड़्‌या, “छाचली, चु भगवानेन अघी सी आवणे वाळी वात बताड़न्‌या माणुस ईनी कळी मां आवणे वाळु हतलु।” <verse eid="JHN 6:14" /><verse number="15" style="v" sid="JHN 6:15" />ईसु ज जाण लेदु की माणसे आवीन मेसेक जबरान मां राजु बणावणे हींडे तेरेमां पछेन बयड़ा पर एखेलुत जाती रयु।<verse eid="JHN 6:15" /></para>
  <para style="s">ईसुन पाणी पर चालनु</para>
  <para style="r">(<ref loc="MAT 14:22-23">मत्‌ती 14:22-23</ref>; <ref loc="MRK 6:45-52">मरकुस 6:45-52</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16" />जत्‌यार सांती वेळाय हय ती ईसुन चेला गलील दरीया धड़े गुया। <verse eid="JHN 6:16" /><verse number="17" style="v" sid="JHN 6:17" />चे ढंड्‌या मां बठीन दरीयान पली धड़ कफरनहुम सहर भीणी जाणे बाजी गुया। आंदारो बेसको हय गुयलो ने ईसु चां लग तींद्‌रे धड़े पछु नी आयु। <verse eid="JHN 6:17" /><verse number="18" style="v" sid="JHN 6:18" />आहळीन वजे सी दरीया मां झलक बी आवणे बाजी गुय। <verse eid="JHN 6:18" /><verse number="19" style="v" sid="JHN 6:19" />जत्‌यार चे पांच छव कीलुमीटर अगा जाती रवला, ती चे ईसु काजे दरीया पर ढंड्‌या भीणी चालीन आवतेलु देख्‌या ने चे बीही गुया। <verse eid="JHN 6:19" /><verse number="20" style="v" sid="JHN 6:20" />बाकुन ईसु हेरा चेलाक कह्‌यु, “मेत छे, बीहु मां।” <verse eid="JHN 6:20" /><verse number="21" style="v" sid="JHN 6:21" />अळतेन चे ईसुक ढंड्‌या मां बठाड़्‌या ने तत्‌यारुत<note caller="+" style="f"><char style="fr" closed="false">6:21 </char><char style="ft" closed="false">तुरन्त</char></note> च ढंड्‌यो तीना जागा पर गुयो, जां चे जाणे बाजी रवला।<verse eid="JHN 6:21" /></para>
  <para style="s">माणसे ईसु काजे हेरे</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22" />दीसरे दाहड़े चु टुळु ने, एक दरीयान पली धड़ उबु हय रवलु, चे असा देख्‌या की जां एक काजे छुड़ीन अळी दीसरो ढंड्‌यो नी हतलो, ने ईसु आपसा चेला साते तीना ढंड्‌या पर चहड़ी नी रवलु बाकुन तेरा चेला अतरात गुयला। <verse eid="JHN 6:22" /><verse number="23" style="v" sid="JHN 6:23" />तत्‌यार नानला दीसरा ढंड्‌या तीबीरीयास सी तीना जागा धड़े आया चे चां मालीक काजे तु बेसकु वारु छे, कय्‌न रुटा खादा। <verse eid="JHN 6:23" /><verse number="24" style="v" sid="JHN 6:24" />हेरेसी जत्‌यार टुळु देख्‌यु की जां नीते ईसु हय ने नी हेरा चेला छे, ती चे ढंड्‌या पर चहड़ीन ईसु काजे हेरता जाय्‌न कफरनहुम जात रया।<verse eid="JHN 6:24" /></para>
  <para style="s">ईसु जीवनेन रुटु छे</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25" />दरीयान पली धड़े जत्‌यार चे ईसु काजे भेळा हया ती कह्‌या, “ए मास्‌तर तु जां कत्‌यार आयु?” <verse eid="JHN 6:25" /><verse number="26" style="v" sid="JHN 6:26" />ईसु तीनुक जपाप आप्‌यु, “मे तुहुंंक छाचलीन कहं, तुहुंं मारे सी करला मटा कामेन सहलाणी देखीन तेरो मतलब समजी गुया करीन मेसेक नी हेर्‌या, बाकुन तुहुंं रुटा खाय्‌न आफरी गुयला छे, करीन मेसेक हेर्‌या। <verse eid="JHN 6:26" /><verse number="27" style="v" sid="JHN 6:27" />रद हवण्‌या खाणा वाटे मेहनत मां करु, बाकुन तीना खाणा वाटे मेहनत करु ज रद नी हवे, ने च खाणो अमर जीवन वाटे जलम टेकलो रहे, ने असो खाणो तुहुंंक माणसेन पुर्‌यु आपसे, अटकळ राखु, भगवान बास माणसेन पुर्‌या पर छाप लागाड़ीन ज देखाड़लु छे की माणसेन पुर्‌यु अतरु माणसेक अमर जीवन आपणेन हकदार छे।”<verse eid="JHN 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28" />माणसे ईसु सी पुछ्‌या, “तीना काम काजे भगवान चाहे तीना काम काजे करने वाटे हामु काय करजे?” <verse eid="JHN 6:28" /><verse number="29" style="v" sid="JHN 6:29" />ईसु तीनु माणसेक जपाप आप्‌यु, “भगवानेन काम ज छे, की भगवान तीना काजे मकेल्‌लु छे, तीना पर तुहुंं भुरसु करु।”<verse eid="JHN 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 6:30" />तत्‌यार चे माणसे ईसुक कह्‌या, “तु काहनी सहलाणी देखाड़े की हामु तीनाक देखीन तार पर भुरसु करजे? तु काहनो काम देखाड़े? <verse eid="JHN 6:30" /><verse number="31" style="v" sid="JHN 6:31" />हामरा डाहा बुड़ा ते बयड़ा मां बेसका दाहड़ा लग मुसा वाटे आपलो मन्‌ना नावेन खाणो खादला ने तेरे बारामां चुखला सास्‌तुर मां लिखलो बी छे; चु तीनु काजे खाणे करीन सरग सी रुटा आप्‌यु।”<verse eid="JHN 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 6:32" />ईसु तीनुक कह्‌यु, “मे तुंद्‌रे सी छाचलीन कहं की मुसु तुहुंंक चे रुटा सरग सी नी देदु बाकुन मारु बास तुहुंंक खरला रुटा सरग सी आपे।” <verse eid="JHN 6:32" /><verse number="33" style="v" sid="JHN 6:33" />काहाकी भगवानेन रुटु हयुत छे जु सरग सी उतरीन कळी माणसे काजे अमर जीवन आपे।<verse eid="JHN 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 6:34" />तत्‌यार चे माणसे ईसु सी कह्‌या, “ए मालीक चे रुटा हामु काजे जलम आप्‌या कर।”<verse eid="JHN 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 6:35" />ईसु तीनुक कह्‌यु, “अमर जीवनेन रुटु मेत छे; जु मारे धड़े आवसे ने मारे पर भुरसु करसे तीनाक कदी भुक नी लागे। <verse eid="JHN 6:35" /><verse number="36" style="v" sid="JHN 6:36" />बाकुन मे तुहुंंक कह्‌लु पेहेल बी कय देदलु की मेसेक देख बी लेदला छे, तेबी भुरसु नी करता। आखा चे माणसे भगवान बास मेसेक सुपलु चे आखा मारे धड़े आवसे। <verse eid="JHN 6:36" /><verse number="37" style="v" sid="JHN 6:37" />तेबी मे हिम्‌मत नी हारो, भगवान बास तीनुक बी नेवाड़ीन मारा हातेम आप देय, चे आखा मारेन्‌चां आवसे ने मे तीनुक मारेन्‌चां सी कदी नी ढासाड़ो। <verse eid="JHN 6:37" /><verse number="38" style="v" sid="JHN 6:38" />काहाकी मे मारी मरजी पुरी करने नी बाकुन मेसेक मकलन्‌यान भगवानेन मरजी पुरी करने करीन सरग सी धरती पर उतरीन आवलु छे। <verse eid="JHN 6:38" /><verse number="39" style="v" sid="JHN 6:39" />ने मारा मकलने वाळान मरजी जी छे, ज काय हयु मेसेक आप्‌यु तेरे मां सी मे काय बी नी खुवो बाकुन तीनुक आकरी दाहड़े मर्‌या-सर्‌याम सी जीन्‌दा कर दीस। <verse eid="JHN 6:39" /><verse number="40" style="v" sid="JHN 6:40" />काहाकी मारा बासेन मरजी जी छे की जु कुय मारा पुर्‌या काजे देखे ने तीना पर भुरसु करे। तीनाक अमर जीवन जड़से ने मे तीनाक आकरी दाहड़े मर्‌या-सर्‌याम सी पछु जीन्‌दा कर दीस।”<verse eid="JHN 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41" />तेरेमां यहुदी माणसे तीना पर वाक नीकाळीन कुर-कुर करने बाजी गुया काहाकी ईसु कह्‌लु, “जु रुटु सरग सी उतर्‌यु चु मेत छे।” <verse eid="JHN 6:41" /><verse number="42" style="v" sid="JHN 6:42" />ने चे कह्‌या, “काय जु युसुफेन पुर्‌यु ईसु नी हय काय, तेरा आयस बास काजे हामु उळख्‌जे? ती चु कसु कहें की मे सरग सी उतर्‌यु?”<verse eid="JHN 6:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43" />ईसु तीनुक जपाप आप्‌यु, तुहुंं तुहुंंत कुर-कुर मां करु। <verse eid="JHN 6:43" /><verse number="44" style="v" sid="JHN 6:44" />बाकुन जी वात समज लेवु, जत्‌यार लग मेसेक मकलन्‌यु भगवान बास तीनाक बी मनवीन मारे धड़े नी लावे तत्‌यार लग तीनुक मारे धड़े नी आवाये, असला माणसे काजे मे आकरी दाहड़े, मतलब नीयावेन दाहड़े मर्‌या-सर्‌याम सी पछु जीवतु करीन बठु कर दीस। <verse eid="JHN 6:44" /><verse number="45" style="v" sid="JHN 6:45" />भगवानेन अघी सी आवणे वाळी वात बताड़ने वाळा माणसे आपसा किताप मां लिखलो छे, “चे आखा भगवानेन भीणी सी सीकाड़ला रवसे।” जे काहनाक मारा बास सी सामळ्‌या ने सीक्‌या, चे मारे धड़े आवे। <verse eid="JHN 6:45" /><verse number="46" style="v" sid="JHN 6:46" />ज घुण समज्‌ता की काहनुक भगवान बास काजे देखलु छे, बाकुन जु भगवान बासेन आवजी पर तेरेन्‌चां सी आवलु छे, हय अतरुत भगवान बास काजे देखलु छे। <verse eid="JHN 6:46" /><verse number="47" style="v" sid="JHN 6:47" />“मे तुंद्‌रे सी छाचलीन कहं, की जु काहनुक भुरसु करे, अमर जीवन तेरोत छे। <verse eid="JHN 6:47" /><verse number="48" style="v" sid="JHN 6:48" />अमर जीवनेन रुटु मेत छे। <verse eid="JHN 6:48" /><verse number="49" style="v" sid="JHN 6:49" />तुंद्‌रा आड़ा-बुड़ा बयड़ा मां मन्‌ना नावेन खाणो खादा, तेबी चे मर गुया। <verse eid="JHN 6:49" /><verse number="50" style="v" sid="JHN 6:50" />बाकुन जु पल्‌लु रुटु छे, जु सरग सी उतरे, काहाकी काहनुक माणुस हेरेम सी खाय, ने मरे नी। <verse eid="JHN 6:50" /><verse number="51" style="v" sid="JHN 6:51" />सरग सी उतर्‌लु अमर जीवन आपण्‌यु रुटु मेत छे, कदी काहनुक जु रुटु खासे चु जलम जीवतेलु रवसे ने जु रुटु मे ईनी कळीन माणसेन जीवन वाटे आपीस, चु रुटु मारो मास छे।”<verse eid="JHN 6:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52" />अतरा मां चे यहुदी माणसे असा कह्‌ता जाय्‌न वातेम लड़ायणे बाजी गुया की, “जु माणुस आपसो मास खाणे करीन कसु दी सक्‌से।”<verse eid="JHN 6:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 6:53" />ईसु तीनुक कह्‌यु, “मे तुंद्‌रे सी छाचलीन कहं की, जत्‌यार लग तुहुंं माणसेन पुर्‌यान मास नी खावु ने तेरो लुही नी पीयु चां लग तुहुंंक जीवन नी जड़े। <verse eid="JHN 6:53" /><verse number="54" style="v" sid="JHN 6:54" />जु मारो मास खाय ने मारो लुही पीये, अमर जीवन तेरोत छे; ने मे आकरी दाहड़े तीनाक मर्‌या-सर्‌याम सी पछा जीन्‌दा कर दीस। <verse eid="JHN 6:54" /><verse number="55" style="v" sid="JHN 6:55" />काहाकी मारो मास छाचलीन खाणेन चीज छे, ने मारो लुही छाचलीन पीणेन चीज छे। <verse eid="JHN 6:55" /><verse number="56" style="v" sid="JHN 6:56" />जु मारो मास खाया करसे ने मारो लुही पीया करसे चु मारेम वारु बणीन रवसे ने मे तेरेमां रवीस। <verse eid="JHN 6:56" /><verse number="57" style="v" sid="JHN 6:57" />जसु जलम जीवण्‌यु बास मेसेक मकल्‌यु ने मे मारा बासेन वजे<note caller="+" style="f"><char style="fr" closed="false">6:57 </char><char style="ft" closed="false">कारण</char></note> सी जीवलु रवीस, तसा की तसा जु मेसेक खासे चु मारे वजे सी जीवलु रवसे। <verse eid="JHN 6:57" /><verse number="58" style="v" sid="JHN 6:58" />सरग सी उतेरलु रुटु मेत छे। जु रुटु तीना रुटान तसु नी हय, तीनाक आड़ा-बुड़ा खादा ने मर गुया; बाकुन काहनुक जु हीना रुटु काजे खासे चु जलम जीवलु रवसे।”<verse eid="JHN 6:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 6:59" />कफरनहुम सहर वाळा तींद्‌रा भक्‌तीन घर मां रय्‌न सीकाड़तु जाय्‌न ईसु जी आखी वात कह्‌यु।<verse eid="JHN 6:59" /></para>
  <para style="s">अमर जीवनेन बुल</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60" />ईसुन चेला मां सी बेसका जणा ज सामळीन कह्‌णे बाजी गुया, “जी ते काठी वात छे हीनीक कुण सामळाय सक्‌से?”<verse eid="JHN 6:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="JHN 6:61" />ईसु हेरा मन मां जी वात जाण लेदु की मारा चेला ईनी वातेन बारामां कुर-कुर कर रया। ईसु पुछ्‌यु, “काय ईनी वात सी तुहुंंक ठुकर लाग रय काय। <verse eid="JHN 6:61" /><verse number="62" style="v" sid="JHN 6:62" />कदी तुहुंं माणसेन पुर्‌या काजे जां हयु पेहेल हतलु, चां उपर जातलु देखसु ती काय हवसे? <verse eid="JHN 6:62" /><verse number="63" style="v" sid="JHN 6:63" />भगवानेन चुखली-आत्‌मा जीवन आपे। डील सी काय फायदु नी हय जी वात मे तुंद्‌रे सी कहंलु चे आत्‌मा छे ने जीवन बी छे। <verse eid="JHN 6:63" /><verse number="64" style="v" sid="JHN 6:64" />बाकुन तुंद्‌रे मायन काहनाक असा छे, चे भुरसु नी करे।” काहाकी ईसु पेहलुत सी जाणतेलु की जे भुरसु नी करे चे कुण छे; ने कुण छे चे मेसेक धुकु देसे। <verse eid="JHN 6:64" /><verse number="65" style="v" sid="JHN 6:65" />ईसु कह्‌यु, “ने मे तुहुंं काजे ज कह्‌लु की काहना बी माणसेक भगवान बासेन मदत लेय पाखुर मारे धड़े नी आवाये।”<verse eid="JHN 6:65" /></para>
  <para style="s">पतरसेन भुरसु</para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66" />ज सामळीन ईसुन बेसका चेला ईसुन चां सी जाती रया, ने ईसुन सात छुड़ देदा। <verse eid="JHN 6:66" /><verse number="67" style="v" sid="JHN 6:67" />तत्‌यार ईसु तीनु बारे चेला काजे कह्‌यु, “काय तुहुंं बी जाणे हींडी रया?”<verse eid="JHN 6:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="JHN 6:68" />सीमोन पतरस ईसु काजे जपाप आप्‌यु, “ए मालीक हामु कुणी धड़े जाजे? अमर जीवन आपण्‌या बुले ते तारेत धड़े छे। <verse eid="JHN 6:68" /><verse number="69" style="v" sid="JHN 6:69" />ने हामु जाण गुया ने भुरसु कर लेदा की, भगवानेन चुखलु माणुस तुत मसी छे।”<verse eid="JHN 6:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="JHN 6:70" />ईसु तीनुक जपाप आप्‌यु, “काय मे तुहुंं बारे जणा काजे नी नेवाड़्‌यु? तेबी तुंद्‌रे मायन एक माणुस भुतड़ु<note caller="+" style="f"><char style="fr" closed="false">6:70 </char><char style="ft" closed="false">शैतान </char></note> छे।” <verse eid="JHN 6:70" /><verse number="71" style="v" sid="JHN 6:71" />ईसु जी वात सीमोन ईस्‌करीयोतीन पुर्‌या यहुदीयान बारामां कह्‌लु, काहाकी ईसुन बारे चेला मायन एक हतलु, चु ईसु काजे धुकु देणेवाळु हतलु।<verse eid="JHN 6:71" /></para>
  <chapter eid="JHN 6" />
  <chapter number="7" style="c" sid="JHN 7" />
  <para style="s">ईसुन भायसे भुरसु नी करे</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1" />यहुदा जीला वाळा यहुदी मुख्‌या ईसुक मार नाखणेन वीच्‌यार कर रवला, तेरेमां चु यहुदा जीला मां जाणे नी हींडतेलु ने ईसु आपसा चेला भेळुत गलील जीलात मां सेवा करतु जाय्‌न हींडतु रयु। <verse eid="JHN 7:1" /><verse number="2" style="v" sid="JHN 7:2" />बाकुन हीयु यहुदी माणसेन आसरान तीहवार<note caller="+" style="f"><char style="fr" closed="false">7:2 </char><char style="ft" closed="false">पर्व</char></note> सातेत आय रवलु। <verse eid="JHN 7:2" /><verse number="3" style="v" sid="JHN 7:3" />तेरेमां ईसुन भायस ईसुक कह्‌यु, “जां सी यहुदी जीलाम जां काहाकी ज काय काम तु करे तीनु कामेक तारा आखा चेला बी देखे। <verse eid="JHN 7:3" /><verse number="4" style="v" sid="JHN 7:4" />काहाकी असु काहनु नी हसे चु नाव कमाय्‌णे चाहे ने डुकायन<note caller="+" style="f"><char style="fr" closed="false">7:4 </char><char style="ft" closed="false">छिपकर</char></note> काम करे। कदी तु ज काम करे ती खुद काजे कळी पर उजेंतु कर।” <verse eid="JHN 7:4" /><verse number="5" style="v" sid="JHN 7:5" />काहाकी ईसुन भाय ईसु पर भुरसु नी करतेलु करीन चु असी वात कर्‌यु।<verse eid="JHN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 7:6" />तत्‌यार ईसु तीनुक कह्‌यु, “मारे वाटे हाल लगुन वारु टेम नी आवी बाकुन तुंद्‌रे वाटे आखी टेम वारलु छे। <verse eid="JHN 7:6" /><verse number="7" style="v" sid="JHN 7:7" />ईनी कळीन माणसे मे तुंद्‌रे सी कुहराय नी राखो, बाकुन जे मारे सी कुहराय राखे काहाकी मे तेरा वीरुद मां जी गवाय दम की तेरा काम भुंडात छे। <verse eid="JHN 7:7" /><verse number="8" style="v" sid="JHN 7:8" />तुहुंं तीहवार मां जावु, मे हय ईना तीहवार मां नी जातु, काहाकी हय लग मारी टेम पुरी नी हय रय।” <verse eid="JHN 7:8" /><verse number="9" style="v" sid="JHN 7:9" />जी वात कय्‌न ईसु गलील जीलात मां रय गुयु।<verse eid="JHN 7:9" /></para>
  <para style="s">भगवान नक्‌खी करला टेमे ईसु खपड़ीन तीहवार वाळने हुगलुत जाय</para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10" />जत्‌यार ईसुन भायस तीहवार वाळने जाती रया, ती ईसु बी गुयु, बाकुन उजेंतु नी हयु, चु हुगलुत चां गुयु। <verse eid="JHN 7:10" /><verse number="11" style="v" sid="JHN 7:11" />खपड़ीन तीहवार मां यहुदी माणसे ईसु काजे हेरता जाय्‌न असा पुछतेला, “चु माणुस कां छे।”<verse eid="JHN 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 7:12" />खपड़ीन तीहवार मां माणसे ईसुन बारामां कळेन कळे बेसकी वात करतेला, “हयु भलु माणुस छे।” ने थुड़ाक कहंतेला, “नी हयु भलु नी हय बाकुन माणसे काजे भटकाड़ र्‌यु।” <verse eid="JHN 7:12" /><verse number="13" style="v" sid="JHN 7:13" />कुय बी तेरे बारामां जुर सी वात नी करतेला, काहाकी चे यहुदी नेता सी बीहतेला।<verse eid="JHN 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14" />तीहवारेन आदा दाहड़ा जाती रया, ने ती ईसु मंदीरेन आंगणा मां जाय्‌न सीकाड़ने बाजी गुयु। <verse eid="JHN 7:14" /><verse number="15" style="v" sid="JHN 7:15" />ईसुन वात सामळीन यहुदी माणसे घाबराय्‌न ईसुन बारामां असा कह्‌या, “काहना बी गुरुन साहरे सीके बीगुर ईना माणसेम असी अक्‌कल कां सी आय गुय।”<verse eid="JHN 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 7:16" />असा कहण्‌याक ईसु कह्‌यु, “मारु भगवान बास मेसेक मकलने वाळु छे। वात सीकाड़ने वाळी मारी मनेन वात नी हय बाकुन मेसेक मकलने वाळान छे। <verse eid="JHN 7:16" /><verse number="17" style="v" sid="JHN 7:17" />कदी काहनुक तेरी मरजी पर चालने हींडे, ती हयु ईनी भणावली वातेन बारामां जाण जासे की, ज भगवान भीणी सी छे, की मे मार भीणी सी कहंणे बाजी रयु। <verse eid="JHN 7:17" /><verse number="18" style="v" sid="JHN 7:18" />जु काहनुक आपसुत खुद काय कह्‌वे, चु आपसान बड़ाय करनु चाहे, बाकुन जु आपणा मकलने वाळान बड़ाय करनु चाहे हयुत छाचलीन छे, ने हेरेम काय बी पाप नी हय। <verse eid="JHN 7:18" /><verse number="19" style="v" sid="JHN 7:19" />काय मुसु तुहुंंक नेम कायदु नी देदु काय? तेबी तुंद्‌रे मां सी काहनुक मुसान साहरे लिखला नेम कायदा पर नी चाले। तुहुंं काहा मेसेक मारेन हींडी रया?”<verse eid="JHN 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 7:20" />माणसेन टुळाम सी काहनाक जपाप आप्‌या, “असो लागे तारे मां भुतड़ो भराय रयो। कुण तुसेक मारने हींडे?” <verse eid="JHN 7:20" /><verse number="21" style="v" sid="JHN 7:21" />ईसु तीनुक जपाप आप्‌यु, “मे आरामेन दाहड़े एक मांदलाक वारु करलु करीन, ने तुहुंं आखा देखीन चकराय रया। <verse eid="JHN 7:21" /><verse number="22" style="v" sid="JHN 7:22" />हेरे वजे सी मुसु तुहुंंक फतरी काटणेन रीती पाळनेन नीयम आप्‌यु, ज नी की मुसा भीणी सी बाकुन डाहा बुड़ा सी चालती आय रय ने तुहुंं आरामेन दाहड़े माणसेन फतरी काट्‌या करु। <verse eid="JHN 7:22" /><verse number="23" style="v" sid="JHN 7:23" />जत्‌यार आरामेन दाहड़े माणसेन फतरी काटाड़े, काहाकी मुसान नीयम नी टुटे, ती तुहुंं मारे पर काहा रीस करु की मे आरामेन दाहड़े एक माणसे काजे वारु कर्‌यु। <verse eid="JHN 7:23" /><verse number="24" style="v" sid="JHN 7:24" />मुंहडा देखीन दसा तसा नीयाव मां करु, वारु वीच्‌यार करीन खरु नीयाव करु।”<verse eid="JHN 7:24" /></para>
  <para style="s">काय ईसुत मसी छे?</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25" />तीनी टेमे यरुसलेम सहर वाळा थुड़ाक यहुदी माणसे कहंणे बाजी गुया, “काय जु हयुत माणुस छे ने हय तीनाक हामरा पुडार्‌या मार नाखणेन वीच्‌यार कर रया। <verse eid="JHN 7:25" /><verse number="26" style="v" sid="JHN 7:26" />ने देखु जु ते उजेंतु वात करने बाजी रयु, ने कुय हीनाक काय नी कह्‌ता। काय यहुदी नेता छाचलीन जाण लेदा काय हयुत मसी छे? <verse eid="JHN 7:26" /><verse number="27" style="v" sid="JHN 7:27" />बाकुन हीनाक ते हामु जाणजे की, जु कां सी आवलु छे; बाकुन मसी जत्‌यार आवसे ती कुय नी जाणे की चु कां सी आयु।”<verse eid="JHN 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 7:28" />तत्‌यार ईसु मंदीर आंगणा मां सीकाड़तु जाय्‌न आयड़ीन कह्‌यु, “तुहुंंक असो लागे की हीनाक उळखी रया, ने ज बी जाणु की मे कान छे। मेते मारी मरजी सी नी आयु, बाकुन मेसेक मकलने वाळु खरलु छे, तीनाक तुहुंं नी जाणु। <verse eid="JHN 7:28" /><verse number="29" style="v" sid="JHN 7:29" />मे तीनाक जाणो काहाकी मे तेरे भीणी सी आयु ने हयुत मेसेक मकेल्‌लु छे।”<verse eid="JHN 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 7:30" />थुड़ाक माणसे ईसुक धरीन ली जाणे हींडी रवला, बाकुन आज लग ईसुन मरने टेम नी आय, जी टेम भगवान नक्‌खी करलु। <verse eid="JHN 7:30" /><verse number="31" style="v" sid="JHN 7:31" />तेबी माणसेन टुळा मां सी बेसका माणसे ईसु पर भुरसु कर्‌या, ने कहणे बाजी गुया, “अतरा चकराड़न्‌या वारु कामेन सहलाणी दीसरु काहनु बी, नी देखाड़ सके।”<verse eid="JHN 7:31" /></para>
  <para style="s">यहुदी माणसे ईसु काजे धरनेन कुसीत करे</para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32" />फरीसी माणसे ज सामळ्‌या की, माणसे ईसुन बारामां कळे-कळे वात करने बाजी र्‌या; ती चे मंदीरेन डाहला पुजारा साते वात करीन ईसुक धरीन लावणे करीन मंदीरेन राखवाळ्‌या सीपायड़ा काजे मकल्‌या। <verse eid="JHN 7:32" /><verse number="33" style="v" sid="JHN 7:33" />पछेन ईसु कह्‌यु, “हय मे ईतरीक वार तुंद्‌रे पुठ्‌ये रय्‌स। ने अळतेन मेसेक जु मकेल्‌लु छे, तेरेन्‌चां पछु जाती रय्‌स। <verse eid="JHN 7:33" /><verse number="34" style="v" sid="JHN 7:34" />तुहुंं मेसेक हेर्‌या करसु बाकुन मे तुहुंंक नी जड़ो। ने मे जां जाणे हींडी र्‌यु चां तुहुंंक नी आवाये।”<verse eid="JHN 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 7:35" />जी वात सामळीन यहुदी-मुख्‌या आपसा-आपसात कह्‌या, “जु काहा जासे की हयु हामुक नी जड़े, काय हयु पला धड़े जासे जे युनानी मां रावण्‌या-तीवण्‌या हय्‌न रवे ने युनानी काजे वारलु वात सीकाड़ देसे? <verse eid="JHN 7:35" /><verse number="36" style="v" sid="JHN 7:36" />जां काय वात छे, ची जु कह्‌लु, की तुहुंं मेसेक हेरसु बाकुन मे नी जड़ो; ने चां मे छे चां तुहुंं नी आय सकु?”<verse eid="JHN 7:36" /></para>
  <para style="s">ईसु चुखली-आत्‌मान बारामां सीकाड़े</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37" />खपड़ीन तीहवारेन खास दाहड़े जु पेहलु दाहड़ु छे, ईसु उबु हयु ने आयड़ीन कह्‌यु, “कदी कुय पीसलो हय ती मारे धड़े आवे ने पाणी पीणु चाहजे। <verse eid="JHN 7:37" /><verse number="38" style="v" sid="JHN 7:38" />जु मार पर भुरसु करसे जसों चुखला सास्‌तुर मां अनसारे आवलो छे, तेरा डील मां सी जीवनेन पाणीन नदी उहवसे।” <verse eid="JHN 7:38" /><verse number="39" style="v" sid="JHN 7:39" />ईसु ज बुल चुखली<note caller="+" style="f"><char style="fr" closed="false">7:39 </char><char style="ft" closed="false">पवित्र</char></note> आत्‌मान बारामां कह्‌यु, ज कुय हेरे पर भुरसु करने वाळा हेरेत पर हतला; काहाकी आत्‌मा हय लग नी उतरी काहाकी ईसु हय लग तेरी सेक-सींगार लग नी पुग्‌यु।<verse eid="JHN 7:39" /></para>
  <para style="s">ईसुन बारामां माणसे वात वीच्‌यार करे</para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40" />ईसुन जी वात सामळीन माणसेन टुळा मां सी काहना-काहनाक जी वात कह्‌या, “छाचलीन हयु भगवानेन अघली वात बताड़ने वाळु माणुस छे।”<verse eid="JHN 7:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 7:41" />थुड़ाक माणसे कवतेला की,</para>
  <para style="p" vid="JHN 7:41">“जु मसी छे, बाकुन काहनाक कह्‌या, काहाकी मसी गलील जीलाम वाळु नी हय सके? <verse eid="JHN 7:41" /><verse number="42" style="v" sid="JHN 7:42" />काय चुखली-सास्‌तुर मां ज नी लिखलो आयो काय मसी दावुदेन कळी मां पयदा हवसे ने बेतलहम गांव सी आवसे जां दावुद रहतेलु।” <verse eid="JHN 7:42" /><verse number="43" style="v" sid="JHN 7:43" />असो करीन ईसुन बारामां माणसे मां बेरजु पड़ गुयु। <verse eid="JHN 7:43" /><verse number="44" style="v" sid="JHN 7:44" />तींद्‌रे मायन थुड़ाक माणसे ईसु काजे धरीन ली जाणे हींडी रवला बाकुन तीनाक धरीन ली जाणे करीन कुयन हिम्‌मत नी हय।<verse eid="JHN 7:44" /></para>
  <para style="s">यहुदी नेता भुरसु करने सी मना करे</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45" />तत्‌यार ईसुक धरने करीन गुयला मंदीरेन राखवाळ्‌या-सीपायड़ा मंदीरेन डाहला पुजारान्‌चां ने फरीसी माणसेन्‌चां पछा जाती रया। ती चे डाहला पुजारा ने फरीसी माणसे तीनुक कह्‌या, “तुहुंं तीना ईसुक काहानी लाया?”<verse eid="JHN 7:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 7:46" />मंदीरेन राखवाळ्‌या सीपायड़ा जपाप आप्‌या, “चु माणुस जसी वात करे तसी वात आज लग कुय नी कर्‌यो।”<verse eid="JHN 7:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 7:47" />जी वात सामळीन फरीसी माणसे तीनुक जपाप आप्‌या, “काय चु तुहुंंक बी भुले पाड़ देदु काय।” <verse eid="JHN 7:47" /><verse number="48" style="v" sid="JHN 7:48" />कुय बी यहुदी नेता ने फरीसी माणसे मायन कुय बी ईना ईसु पर भुरसु नी कर्‌या? <verse eid="JHN 7:48" /><verse number="49" style="v" sid="JHN 7:49" />बाकुन ईनु टुळाम माणसे काजे मुसा सी लिखली सास्‌तुर मालम नी हय, करीन जे ईसुन सामळीन भुले पड़ गुया। ने हींद्‌रे पर ते भगवानेन गरा छे।<verse eid="JHN 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 7:50" />नीकुदेमुस चु पेहेल ईसु काजे भेळु हवणे गुयलु, चु तीनु फरीसी माणसे मायन एक हतलु। चु तीनु काजे कह्‌यु। <verse eid="JHN 7:50" /><verse number="51" style="v" sid="JHN 7:51" />काहना बी माणुस काजे पुछीन तेरा गुनान पतु लागाड़े बीगुर जसों तसों तेरु नीयाव करीन तीनाक तु गुनाळु छे, कहीन डंड आपणु आपसा नीयम अनसारे संय छे काय? <verse eid="JHN 7:51" /><verse number="52" style="v" sid="JHN 7:52" />चे तीना नीकुदेमुस काजे जपाप आप्‌या, “तु बी गलील जीला वाळा पुठ्‌ये भेसकायलु छे? सास्‌तुर मां हेर ने भणीन देख तत्‌यार तुसेक मालुम पड़से की गलील जीलाम सी भगवानेन अघली वात बताड़न्‌यु माणुस उजेंतु हय्‌न आवण्‌यु नी हय।”<verse eid="JHN 7:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 7:53" />ने तत्‌यार चे आखा आपणे-आपणे घर जाती र्‌या।<verse eid="JHN 7:53" /></para>
  <chapter eid="JHN 7" />
  <chapter number="8" style="c" sid="JHN 8" />
  <para style="s">ईसु छीनाळी बायरीन पाप माफ करे</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 8:1" />ने ईसु जेतुनेन बयड़ा<note caller="+" style="f"><char style="fr" closed="false">8:1 </char><char style="ft" closed="false">पहाड़</char></note> पर जाती र्‌यु। <verse eid="JHN 8:1" /><verse number="2" style="v" sid="JHN 8:2" />ने चु संदारे एगुत मंदीर मां गुयु। ने आखा माणसे ईसु धड़े आया; ने चु बठीन तीनुक सीकाड़ने बाजी गुयु। <verse eid="JHN 8:2" /><verse number="3" style="v" sid="JHN 8:3" />तीनी टेमे यहुदी-सास्‌तुर सीकाड़न्‌या ने फरीसी माणसे एक बायर काजे ईसु धड़े धरीन लाया, ची बायर काहनाक साते छीनाळो करतेली ने धर लेदला ने तीनी काजे माणसेन ईचमां उभी करीन ईसु काजे कह्‌या <verse eid="JHN 8:3" /><verse number="4" style="v" sid="JHN 8:4" />चे यहुदी सास्‌तुर सीकाड़न्‌या ने फरीसी माणसे ईसु सी कह्‌या, “ए मास्‌तर जी बायर छीनाळो<note caller="+" style="f"><char style="fr" closed="false">8:4 </char><char style="ft" closed="false">व्यभिचार</char></note> करतेली धराय गुय। <verse eid="JHN 8:4" /><verse number="5" style="v" sid="JHN 8:5" />मुसु आपसा लिखला कायदान सास्‌तुर मां हामुक हुकुम आप्‌लु छे, की असली छीनाळी बायर काजे दगड़ा दीन मार नाखणु चाहजे। तेरेसी ईनी बायरीन बारामां तारो काय कहंणु पड़े?” <verse eid="JHN 8:5" /><verse number="6" style="v" sid="JHN 8:6" />चे ईसु काजे पारखणे करीन जी वात कह्‌या, तेरेसी तीनुक ईसु पर गुनु लागाड़नेन काहनुस पुरावु जड़ जाय करीन बाकुन ईसु ढंगु अळीन आंगळे करीन धुळा मां लिखतु रयु। <verse eid="JHN 8:6" /><verse number="7" style="v" sid="JHN 8:7" />जत्‌यार चे ईसुक पुछता रया ती ईसु उबु हय्‌न तीनुक कह्‌यु, “तुंद्‌रे मां जु कुय काय बी पाप नी कर्‌यु हय चु ईनी बायरीन आखाम सी पेहेल दगड़ु देणु चाहजे।” <verse eid="JHN 8:7" /><verse number="8" style="v" sid="JHN 8:8" />ने ईसु अळी ढंगु अळीन <note caller="+" style="f"><char style="fr" closed="false">8:8 </char><char style="fq" closed="false">ढंगु अळीन </char><char style="ft" closed="false">झुककर</char></note>धरती पर लिखणे बाजी गुयु। <verse eid="JHN 8:8" /><verse number="9" style="v" sid="JHN 8:9" />बाकुन ज सामळीन डाहा-बुड़ा सी नानला लग आखान-आखा एकेक करीन जाती रया। ने चां ईसु ने ची बायरी रय गुया। <verse eid="JHN 8:9" /><verse number="10" style="v" sid="JHN 8:10" />ईसु अळी उबु हय्‌न तीनी बायर काजे कह्‌यु, “ओ बायरी चे माणसे काहा जाती रया? तुसे कुय गुनाळी ठेहरावीन डंड नी आप्‌यो काय?”<verse eid="JHN 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 8:11" />ची बायर कय, “ए मालीक कुय बी मेसेक डंड नी आप्‌यो।”</para>
  <para style="p" vid="JHN 8:11">ईसु कह्‌यु, “जां मे बी तुसेक डंड नी आपतु जां ने हय सी अळी पाप घुण करजी।”<verse eid="JHN 8:11" /></para>
  <para style="s">ईसु कळीन वीजाळो छे</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12" />ने अळतेन मंदीर मां माणसे ईसु धड़े अळी भेळा हया, तत्‌यार ईसु तीनाक कह्‌यु, “मे कळीन माणसे वाटे वीजाळो मे छे। ज कुय मारु चेलु बणने करीन मारे पुठ्‌ये आवे चु अमर जीवन मां ली जाण्‌यो वीजाळो हात करसे अतरामा तीनाक पापेन आंदारला मां झटवायतु फीरनु नी पड़े।”<verse eid="JHN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13" />फरीसी माणसे ईसुक कह्‌या, “तु आपसात बारामां आपसुत गवा दी र्‌यु। हेरेसी तारी गवाय खरली नी हय।”<verse eid="JHN 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 8:14" />ईसु तीनुक जपाप आप्‌यु, “मेसेक मालुम छे, की मे कां सी आवलु छे ने कां जाणे बाजी र्‌यु। बाकुन तुहुंं नी जाणता की मे कां सी आवलु छे ने कां जाणे बाजी र्‌यु। अतरामा कदी मे आपसुत मारा बारामां गवा दम; तेबी मारी गवाय खरली छे। <verse eid="JHN 8:14" /><verse number="15" style="v" sid="JHN 8:15" />तुहुंं ईनी कळीन माणसेन डीलेन अनसारे नीयाव कर र्‌या, बाकुन मे कुय बी असु नीवाय नी करो; <verse eid="JHN 8:15" /><verse number="16" style="v" sid="JHN 8:16" />ने कदी मे नीयाव करो बी, ते मारु नीयाव छाचलु छे, काहाकी मे एखलु नी हय बास बी छे, चु मेसेक मकेल्‌लु छे। <verse eid="JHN 8:16" /><verse number="17" style="v" sid="JHN 8:17" />तुंद्‌रा कायदान सास्‌तुर मां बी लिखलो छे, की दुय जणान गवाय छाचली रवे। <verse eid="JHN 8:17" /><verse number="18" style="v" sid="JHN 8:18" />एक ते मे मारा बारामां गवाय दम ने मारु बास बी मारा बारामां गवाय देय चु मेसेक मकेल्‌लु छे।”<verse eid="JHN 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 8:19" />ज सामळीन चे ईसु काजे कह्‌या, “तारु बास कां छे।” ईसु जपाप आप्‌यु,</para>
  <para style="p" vid="JHN 8:19">“तुहुंं मेसेक जाणु नी मारा बास काजे कदी मेसेक जाणु ती मारा बास काजे बी जाणु।”<verse eid="JHN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 8:20" />ईसु मंदीर मां दान पेटी धड़े सीकाड़तु जाय्‌न जी आखी वात कह्‌यु, तेबी कुय बी ईसुक नी धर्‌या, काहाकी हय लग ईसुन मरने टेम नी आय, जी टेम भगवान नक्‌खी करलु।<verse eid="JHN 8:20" /></para>
  <para style="s">जे यहुदी माणसे ईसु पर भुरसु नी करे तीनुक ईसु चकराड़े</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21" />ईसु अळी एक कावा माणसे काजे कह्‌यु, “मे जात रय्‌स, ने तुहुंं मेसेक हेर्‌या करसु, बाकुन तुहुंं तुंद्‌रा पापेन माफी हात कर्‌या बीगुर तुंद्‌रा पाप मां मर जासु। ने चां जात रय्‌स चां तुहुंंक कदी नी आवाये।”<verse eid="JHN 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 8:22" />जी वात सामळीन यहुदी माणसे कह्‌या, “जु असु काहा कय रयु, जां मे जात रय्‌स चां तुहुंंक कदी नी आवाये हेरो ज कहंणेन मतलब काय छे? कांखुर मायन जु जाणी बुजीन मरने ते नी हींडी र्‌यु?” <verse eid="JHN 8:22" /><verse number="23" style="v" sid="JHN 8:23" />ईसु तीनु काजे कह्‌यु, “तुहुंं सरगे सी नेचा ईनी धरती वाळा छे; तुहुंं कळीन छे, ने मे ईनी कळीम वाळु नी हय। <verse eid="JHN 8:23" /><verse number="24" style="v" sid="JHN 8:24" />तेरेमां मे तुहुंंक कह्‌यु, की तुहुंं तुंद्‌रा पाप मां मरसु काहाकी कदी तुहुंं भुरसु नी करु की मे हयुत छे ती तुंद्‌रा पाप मां मरसु।”<verse eid="JHN 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 8:25" />ज सामळीन चे माणसे ईसुक कह्‌या, “तु कुण छे?” ईसु तीनुक कह्‌यु, “हयुत छे सुरु सी तुंद्‌रे सी कह्‌तु आय र्‌यु। <verse eid="JHN 8:25" /><verse number="26" style="v" sid="JHN 8:26" />तुंद्‌रा बारामां मेसेक बेसको काय नीयाव करनु छे। बाकुन मारु मकेलने वाळु छाचलु छे, ने ज मे तेरे सी सामळळु छे, चोन ईनी कळीन माणसे काजे सामळावो।”<verse eid="JHN 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 8:27" />ईसु ते तीनु काजे भगवान बासेन बारामां कहंणे बाजी रवलु, बाकुन ची वात तीनुक पल्‌ले नी पड़े। <verse eid="JHN 8:27" /><verse number="28" style="v" sid="JHN 8:28" />तत्‌यार ईसु कह्‌यु, “जत्‌यार तुहुंं माणसेन पुर्‌या काजे ती जाणसु की मे हयुत छे; मे मारी मरजी सी काय बी नी कहो बाकुन जसु मारु बास मेसेक सीकाड़लु तसुत जी वात कहो। <verse eid="JHN 8:28" /><verse number="29" style="v" sid="JHN 8:29" />मेसेक मकेलने वाळु मारे पुठ्‌ये; चु मेसेक एखलु नी मकल्‌यु काहाकी मे जलम चत काम करो तीनाक गमे च।”<verse eid="JHN 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 8:30" />ईसु जी वात कहंणे बाजी रवलु, ती बेसका माणसे तेरे पर भुरसु करने बाजी गुया।<verse eid="JHN 8:30" /></para>
  <para style="s">ईसु पाप काजे छुड़ने बारामां सीकाड़े</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31" />जे यहुदी माणसे ईसु पर भुरसु कर्‌या, तीनुक कह्‌यु, “कदी तुहुंं मारा बुल मांनीन रवसु, ती छाचलीन मारा चेला बण जासु। <verse eid="JHN 8:31" /><verse number="32" style="v" sid="JHN 8:32" />तुहुंं छाचाय काजे जाण लेसु, ने छाचाय तुहुंंक गुलामी मां सी छुड़ाय देसे।”<verse eid="JHN 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 8:33" />चे ईसु काजे कह्‌या, “हामु ते अब्‌राहमेन अवल्‌यात छे, ने हामु कदी काहनान बी गुमाली नी कर्‌या। ती तु असु कसु कह्‌वे की छाचाय तुहुंंक गुलामी मां सी छुड़ाय देसे।”<verse eid="JHN 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34" />ईसु तीनु काजे कह्‌यु, “मे तुहुंंक छाचलीन कहं, जु पाप करे चु पापेन गुलाम छे। <verse eid="JHN 8:34" /><verse number="35" style="v" sid="JHN 8:35" />एक घरेन पावर्‌यान बारामां वीच्‌यार करु। मालीकेन पावर्‌यु नी बाकुन मालीकेन खरलु बेटुस घरेन हकदार्‌यु छे, ने चु अतरुत घर मां जलम रय सके, <verse eid="JHN 8:35" /><verse number="36" style="v" sid="JHN 8:36" />हेरेसी कदी पुर्‌यु तुहुंं काजे पापेम सी छुड़ावसे ती तुहुंं छाचलीन पापेन गुलामी मां सी छुट जासु। <verse eid="JHN 8:36" /><verse number="37" style="v" sid="JHN 8:37" />मे जाणो की तुहुंं अब्‌राहमेन अवल्‌यात छे; तेबी मारो बुल तुंद्‌रा डील मां जागु नी हेरे, तेरेमां तुहुंं मेसेक मारने हींडी रया। <verse eid="JHN 8:37" /><verse number="38" style="v" sid="JHN 8:38" />तुहुंं चत कय रया च मेसेक मारु बास देखलु, ने तुहुंं च करु च तुंद्‌रा बास सी तुहुंं सामळ्‌या।”<verse eid="JHN 8:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 8:39" />चे ईसु काजे जपाप आप्‌या, “हामरु बास ते अब्‌राहम छे।” ईसु तीनुक कह्‌यु,</para>
  <para style="p" vid="JHN 8:39">“कदी तुहुंं अब्‌राहमेन अवल्‌यात रवता ती चत काम करता च अब्‌राहम करलु। <verse eid="JHN 8:39" /><verse number="40" style="v" sid="JHN 8:40" />बाकुन हय तुहुंं मारेन तसला माणसे काजे मारने हींडी रया, चु तुहुंंक च खरलो बुल बताड़लु चु भगवान सी सामळ्‌या असो ते अब्‌राहम नी कर्‌यु। <verse eid="JHN 8:40" /><verse number="41" style="v" sid="JHN 8:41" />तुहुंं ते खरला बासेन तसु नी, बाकुन तुंद्‌रा दीसरा बासेन तसु वेहवार कर रया।”</para>
  <para style="p" vid="JHN 8:41">चे ईसु काजे कह्‌या, “हामु छीनाळा सी पयदा नी हया; हामरु एकुत बास छे, ने चु भगवान छे।”<verse eid="JHN 8:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42" />ईसु तीनु यहुदी माणसेक कह्‌यु, “भगवान तुंद्‌रु बास नी हय। कदी भगवान तुंद्‌रु बास रवतु, ती तुहुंं मेसेक उळखीन परम करता काहाकी मे मारी मरजी सी नी आयु। बाकुन भगवान मेसेक मकेल्‌लु छे। करीन मे भगवान बासेम सी नीकाळीन आवलु छे, ने मे हय जां हजुर छे। <verse eid="JHN 8:42" /><verse number="43" style="v" sid="JHN 8:43" />तुहुंं मारी वात काहा नी समजु? तेरेमां की तुहुंं मारो बुल सामळी नी सकु। <verse eid="JHN 8:43" /><verse number="44" style="v" sid="JHN 8:44" />तुहुंं आपसा बास भुतड़ा सी छे, ने आपसा बासेन मरजी काजे पुरी करने हींडी र्‌या। हयु ते पेहलुत सी हत्‌यारु छे, ने छाचलु बणीन नी रयु, काहाकी छाचाय तेरेमां हय नी। जत्‌यार हयु झुट बुले, ती आपसा हीयान मनेम सी बुले, काहाकी हयु झुटु अतरुत नी हय, बाकुन आखी भातीन झुटेन बास झुटु छे, <verse eid="JHN 8:44" /><verse number="45" style="v" sid="JHN 8:45" />बाकुन मे ज छाचलीन कह्‌वो, तुहुंं माणसे मारे पर भुरसु नी करु। <verse eid="JHN 8:45" /><verse number="46" style="v" sid="JHN 8:46" />तुंद्‌रे मायन कुण मेसेक पापी कहें? काय कदी मे छाचलीन कहं, ती तुहुंं मारु भुरसु काहा नी करु? <verse eid="JHN 8:46" /><verse number="47" style="v" sid="JHN 8:47" />जु भगवान भीणी सी छे, ने भगवानेन वात काजे सामळे। तेरेमां तुहुंं मारी वात काजे नी मानु, तुहुंं भगवान भीणी सी नी हय।”<verse eid="JHN 8:47" /></para>
  <para style="s">ईसु ने अब्‌राहम</para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48" />ईसुन वात सामळीन यहुदी माणसे रीसवायन ईसु काजे कह्‌या, “हामु ते छाचलीन कय र्‌या की, तु सामरी जातीन छे, ने तारे भुतड़ु चस्‌टी र्‌यु?”<verse eid="JHN 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 8:49" />ईसु तीनुक जपाप आप्‌यु, “मारे भुतड़ु नी चस्‌टी र्‌यु। बाकुन मे मारा बासेन अबरु राख र्‌यु ने तुहुंं मारु अबरु ली रया। <verse eid="JHN 8:49" /><verse number="50" style="v" sid="JHN 8:50" />मेसेक मारी ईज्‌जत नी चाहजे, बाकुन एक जणु छे, चु मारु अबरु राखणेन हेर कर रयु, ने हयुत छाचलु नीयाव करन्‌यु छे। <verse eid="JHN 8:50" /><verse number="51" style="v" sid="JHN 8:51" />मे तुंद्‌रे सी छाचलीन कहं, ज कुय माणुस मारा बुल काजे मानीन चालसे चु कदी नी मरे।”<verse eid="JHN 8:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 8:52" />जी वात सामळीन यहुदी माणसे ईसु काजे कह्‌या, “हय हामुक पक्‌को मालम पड़ गुयो की, तारे भुतड़ु चस्‌टी रयु। अब्‌राहम मर गुयु ने भगवानेन अघली वात बताड़न्‌यु मर गुयु, ने तु ज कय रयु की जु कुय मारा बुल काजे मानीन चालसे चु कदी नी मरे। <verse eid="JHN 8:52" /><verse number="53" style="v" sid="JHN 8:53" />हामरा डाहा बुड़ान बास अब्‌राहम ते मर गुयु, ने भगवानेन अघली वात बताड़न्‌या बी मर गुया, तु अब्‌राहम सी मटु छे काय? तु आपसा काजे काय समजी रयु? तु कुण छे?” <verse eid="JHN 8:53" /><verse number="54" style="v" sid="JHN 8:54" />ईसु जपाप आप्‌यु, “कदी मे मारीत ईज्‌जत करो ती तीनी ईज्‌जतेन काय बी दाम नी रवे। बाकुन मारी ईज्‌जत करन्‌यु मारु बास छे तीनाक तुहुंं कहुं की चु तुंद्‌रु भगवान छे। <verse eid="JHN 8:54" /><verse number="55" style="v" sid="JHN 8:55" />तुहुंं ते तीनाक कदी नी उळख्‌या; ने कदी मे कहं की मे तीनाक कदी नी उळखो, ती ते मे तुंद्‌रेन तसु लुच्‌चु कहं; बाकुन मे तीनाक उळखो ने तेरा बुल पर चालो। <verse eid="JHN 8:55" /><verse number="56" style="v" sid="JHN 8:56" />तुंद्‌रु बास अब्‌राहम मेसेक देखणे करीन मारे आवणेन दाहड़ाम वाट देखीन खुस हय गुयलु; ने चु मेसेक देखी बी लेदु ने खुस हय गुयु।”<verse eid="JHN 8:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="JHN 8:57" />जी वात सामळीन यहुदी माणसे ईसुक कह्‌या, “हय लगुन तारी उमर पचास साल बी नी हय ने तु असु कसु कय रयु की मे अब्‌राहम काजे देखलु छे?”<verse eid="JHN 8:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="JHN 8:58" />ईसु तीनुक कह्‌यु, “मे तुहुंं काजे छाचलीन कहं अब्‌राहम पयदा नी हयु तेरे सी बी पेहलुन मेत छे।”<verse eid="JHN 8:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 8:59" />ज सामळीन यहुदी माणसे ईसुक मारने करीन दगड़ा<note caller="+" style="f"><char style="fr" closed="false">8:59 </char><char style="ft" closed="false">पत्थर</char></note> ईछी लेदा बाकुन ईसु मंदीर मां सी कळेन जाती र्‌यु।<verse eid="JHN 8:59" /></para>
  <chapter eid="JHN 8" />
  <chapter number="9" style="c" sid="JHN 9" />
  <para style="s">ईसु पयदावारी सी आंदळा हवलाक देखणेन ताकत आपे</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1" />ईसु हेरा चेला भेळुत वाटे जाणे बाजी रवलु ती चु एक माणुस काजे देख्‌यु चु पयदा हयु ती सीत आंधळु हतलु। <verse eid="JHN 9:1" /><verse number="2" style="v" sid="JHN 9:2" />ती ईसुन चेला ईसु काजे पुछ्‌या, “ए मास्‌तर कुण पाप कर्‌यु हसे ने जु आंधळु पयदा हयु। जु माणुस पाप कर्‌यु हसे की हेरा आयस-बास पाप कर्‌या हसे?”<verse eid="JHN 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 9:3" />ईसु जपाप आप्‌यु, “नी ते जु माणुस पाप कर्‌यु ने नी ते हेरा आयस-बास पाप कर्‌या बाकुन जु हेरेन करीन आंधळु पयदा हयु की ईनाक वारु करनेन सी हेरी जीवन मां भगवानेन ताकत देखाव पड़ जाय। <verse eid="JHN 9:3" /><verse number="4" style="v" sid="JHN 9:4" />ने भगवान जु मेसेक मकेल्‌लु छे, आपणुक तेरो काम दीसुत पुरो कर लेणु वारु रवसे। बाकुन ची रात आवणे वाळी छे, तेरेमां कुयक काम नी कराये। <verse eid="JHN 9:4" /><verse number="5" style="v" sid="JHN 9:5" />जत्‌यार लग मे कळी मां छे तत्‌यार लग कळीन वीजाळो छे।”<verse eid="JHN 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6" />ज कयदीन ईसु भुयमां थुप्‌यु ने हाते करीन धुळु कालवीन आंदळान डुळा पर चुपड़ी देदु। <verse eid="JHN 9:6" /><verse number="7" style="v" sid="JHN 9:7" />ने तीना आंदळा काजे कह्‌यु, “जां सीलोम नावेन हळाव मां तारा डुळा धुय ले।” सीलोम नावेन मतलब छे मकेल्‌लु। अतरा मां चु आंधळु माणुस जाय्‌न तीना हळाव मां डुळा धुय लेदु ने जत्‌यार चु पछु आयु तत्‌यार देखणे बाजी गुयु।<verse eid="JHN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 9:8" />ईना आंदळान आड़े-धड़े वाळा ने उळखायता माणसे चे पेहल ईनाक भीक मांगतेला देखला चे ईनाक हय देखीन कह्‌या,</para>
  <para style="p" vid="JHN 9:8">“काय जु चु नी हय जां बठीन पेहेल भीक मांगतेलु?” <verse eid="JHN 9:8" /><verse number="9" style="v" sid="JHN 9:9" />थुड़ाक माणसे कह्‌या, “जु हयुत छे। थुड़ाक माणसे कह्‌या जु चु आंधळु माणुस नी हय बाकुन तेरेन तसु देखाये।”</para>
  <para style="p" vid="JHN 9:9">बाकुन चु आंधळु माणुस कह्‌यु, “मे हयुत छे।”<verse eid="JHN 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 9:10" />ज सामळीन चे तीनाक पुछणे बाजी गुया, “ती तु कसु काय देखणे बाजी गुयु।”<verse eid="JHN 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 9:11" />चु माणुस जपाप आप्‌यु, “ईसु नावेन माणुस थुपे करीन धुळु मारा डुळा पर चुपड़ी देदु। ने मेसेक कह्‌यु, सीलोम नावेन हळाव मां तारा डुळा धुय ले। ने मे जाय्‌न डुळा धुय लेदु ने मे देखणे बाजी गुयु।”<verse eid="JHN 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 9:12" />ज सामळीन चे तीनाक पुछ्‌या, “चु कां छे।”</para>
  <para style="p" vid="JHN 9:12">ने चु कह्‌यु, “काय जाणु।”<verse eid="JHN 9:12" /></para>
  <para style="s">फरीसी माणसे वारु हय गुयला आंदळान पतु लागाड़े</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13" />वारु हय गुयला आंदळा माणुस काजे चां भेळा हवला माणसे फरीसी माणसे ने यहुदी माणसे धड़े लाया। <verse eid="JHN 9:13" /><verse number="14" style="v" sid="JHN 9:14" />तीने दाहड़े ईसु धुळु<note caller="+" style="f"><char style="fr" closed="false">9:14 </char><char style="ft" closed="false">मिट्टी</char></note> कालवीन तीना आंदळान डुळा वारु करलु चु दाहड़ु आरामेन दाहड़ु हतलु। <verse eid="JHN 9:14" /><verse number="15" style="v" sid="JHN 9:15" />अतरामा फरीसी माणसे बी तीना माणसेक पुछणे बाजी गुया, “तु कसु काय देखणे बाजी गुयु।” चु तीनुक कह्‌यु, “ईसु नावेन माणुस धुळु कालवीन मारा डुळा पर चुपड़ी देदु। ने मे धुय लेदु ती पछेन देखणे बाजी गुयु।”<verse eid="JHN 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 9:16" />जी वात सामळीन थुड़ाक फरीसी माणसे कह्‌या, “हीयु ईसु आरामेन दाहड़ु नी पाळतु। तेरेमां हीयु भगवानेन्‌चां सी नी आवलु हय।”</para>
  <para style="p" vid="JHN 9:16">ने जी वात सामळीन थुड़ाक फरीसी माणसे कह्‌या, “पापी माणुस असा वारु कामेन सहलाणी कसु देखाड़ सके?” अतरा मां ईसुन बारामां तींद्‌रे-तींद्‌रे मां वीरुद हय गुयु।<verse eid="JHN 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 9:17" />एक कावा अळी तीना आंदळा काजे पुछ्‌या, “जु माणुस तारा डुळा वारु करलु छे, तेरा बारामां तु काय कहें?” ने चु माणुस कह्‌यु, “चु एक भगवानेन अघी सी आवणे वाळी वात बताड़ने वाळु माणुस छे।”<verse eid="JHN 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 9:18" />जु माणुस पेहेल आंधळु हतलु, चु माणुस हय देखणे बाजी गुयु ईनी वातेम तीनु यहुदी मुख्‌या काजे भुरसु नी आयु ने चे तीना माणसेन आस्‌या-बास्‌या काजे बुलाया। <verse eid="JHN 9:18" /><verse number="19" style="v" sid="JHN 9:19" />ने तीनुक पुछ्‌या, “जु तुंद्‌रु पुर्‌यु छे काय? जु पयदा हयु तीन आंधळु हतलु काय? ‘आंधळु हतलु’ कहुं ती हय जु कसु देखणे बाजी गुयु?” <verse eid="JHN 9:19" /><verse number="20" style="v" sid="JHN 9:20" />चे आस्‌या-बास्‌या जपाप आप्‌या, “हामु जाणजे की हामरु पुर्‌यु छे, ने जु पयदा हयु तीन आंधळु हतलु। <verse eid="JHN 9:20" /><verse number="21" style="v" sid="JHN 9:21" />बाकुन हय जु कसु देखणे बाजी गुयु जी वात हामुक मालम नी हय। हामुक ज बी नी मालम हय की हेरा डुळा कुण वारु कर्‌यो ईनात काजे पुछ लेवु। जु नानलु नी हय आपसान बारामां खुद बताड़ देसे।” <verse eid="JHN 9:21" /><verse number="22" style="v" sid="JHN 9:22" />यहुदी डाहला भेळा हय्‌न जी वात नक्‌खी कर लेदला की कुय बी ईसु काजे मसी करीन मान लेसे ती आपणा भक्‌तीन घर मां सी बाहर नीकाळीन बाहरु कर देसुन। ने तीनाक वारु हय गुयला आंदळान आस्‌या-बास्‌या मन मां यहुदी मुख्‌यान धाक भराय गुयली। <verse eid="JHN 9:22" /><verse number="23" style="v" sid="JHN 9:23" />तेरेमां तेरा आस्‌या-बास्‌या कहला की, “जु मटु हय गुयु ईनात काजे पुछ लेवु।”<verse eid="JHN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24" />चे यहुदी मुख्‌यान तीना वारु हय गुयला आंदळाक अळी बुलाया ने तीनाक कह्‌या, “भगवानेन आण घालीन कहं की मे तीना भगवानेन बड़ाय करीस। हामु जाणजे की चु माणुस पापी छे।”<verse eid="JHN 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 9:25" />चु जपाप आप्‌यु, “चु माणुस पापी हय की नी हय जी वात मेसेक मालम नी हय बाकुन मे अतरोत जाणो की मे आंधळु हतलु ने हय मे देखो।”<verse eid="JHN 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 9:26" />ने चे तीनाक अळी पुछ्‌या चु तारे काय कर्‌यु? “चु तारा डुळाक कसु वारु कर्‌यु?” <verse eid="JHN 9:26" /><verse number="27" style="v" sid="JHN 9:27" />चु कह्‌यु, “मे तुहुंं काजे पेहलुत कय देदु तेबी तुहुंंक भुरसु नी आवतु, ती हय अळी काहा सामळने हींडी र्‌या? तुहुंं बी तेरा चेला बणने हींड र्‌या काय?” <verse eid="JHN 9:27" /><verse number="28" style="v" sid="JHN 9:28" />चे तीनाक बेसका लड़ीन कह्‌या, “तुत छे तेरु चेलु बाकुन हामु ते मुसान चेला छे। <verse eid="JHN 9:28" /><verse number="29" style="v" sid="JHN 9:29" />हामु जाणजे की भगवान मुसा साते वात करलु बाकुन तीना ईसुन बारामां हामु जाणजे लग नी, की चु कां सी आवलु छे।”<verse eid="JHN 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 9:30" />चु वारु हय गुयलु माणुस तीनाक कह्‌यु, “जो! तुहुंंक पल्‌ले नी पड़तो काय चु आंदळान डुळाक वारु कर देदु तेबी तुहुंंक मालम नी हय की चु कां सी आवलु छे। <verse eid="JHN 9:30" /><verse number="31" style="v" sid="JHN 9:31" />आपणु जाणजे की भगवान पापी माणसेन दुवा नी सामळे बाकुन तीना माणसेन दुवा सामळे जु भगवानेन भक्‌ती करतु हय ने भगवानेन मरजी<note caller="+" style="f"><char style="fr" closed="false">9:31 </char><char style="ft" closed="false">ईच्छा</char></note> पर जीवन जीवे। <verse eid="JHN 9:31" /><verse number="32" style="v" sid="JHN 9:32" />कळी घड़ाय तीसी आज लग ज सामळने मां नी आयो की काहनु बी आंधळु पयदा वारी माणसेन डुळा उघाड़ीन वारु कर्‌यु हय। <verse eid="JHN 9:32" /><verse number="33" style="v" sid="JHN 9:33" />कदी भगवान ईना माणसेक नी मकेलतु ती चु कसु मारा आंदळा डुळा उघाड़तु।”<verse eid="JHN 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 9:34" />चे यहुदी मुख्‌या वारु हय गुयला आंदळाक कह्‌या तुते पाप मां पयदा हयु ने पापेत मां पुसायु, “ने बेसकु! तु हामुक सीकाड़ने बाजी र्‌यु!” ने असु कहीन चे तीनाक तींद्‌रा घर मां सी खयड़े नीकाळ दीन बाहर कर देदा।<verse eid="JHN 9:34" /></para>
  <para style="s">जीवेन आंदळान बारामां ईसु, फरीसी माणसेक देखाड़े</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35" />अळतेन ईसु सामळ्‌यु की फरीसी माणसे यहुदी मुख्‌या तीनाक चां बाहर कर देदला छे, ने अळतेन ईसु तीनाक भेळु हयु ती तीनाक कह्‌यु, “तु माणसेन पुर्‌या पर भुरसु करे काय?” <verse eid="JHN 9:35" /><verse number="36" style="v" sid="JHN 9:36" />चु वारु हय गुयलु आंधळु माणुस कह्‌यु, “ए मालीक! मेसेक देखाड़ दे की माणसेन पुर्‌यु कुण छे, ने मे तेरे पर भुरसु करीस।”<verse eid="JHN 9:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 9:37" />ईसु तीना माणसेक कह्‌यु तु तीनाक देखलु छे, “ने चु तार साते वात करने बाजी र्‌यु ने हयुत माणसेन पुर्‌यु छे।”<verse eid="JHN 9:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 9:38" />चु वारु हय गुयलु आंधळु ईसु काजे कह्‌यु ए मालीक! मे भुरसु कर्‌यु ने चु ईसुन पाये पड़ीन आंध्‌यु।<verse eid="JHN 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 9:39" />ने ईसु कह्‌यु, “मे ईनी कळी मां नीयाव करने वाळु छे की जे आंदळा छे चे देखणे बाजी जाय बाकुन जे देखणे बाजी र्‌या चे आंदळा हय जाय।”<verse eid="JHN 9:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 9:40" />फरीसी माणसे मुख्‌या मायन थुड़ाक चां ईसु साते हतला ने चे ज सामळीन ईसु काजे कह्‌या, “छाचलीन हामु आंदळा नी हय। हामु बी आंदळा छे करीन तु कय र्‌यु काय?”<verse eid="JHN 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 9:41" />ईसु तीनु काजे कह्‌यु, “कदी तुहुंं छाचलीन आंदळा रवता ती पापी नी गीणायता बाकुन हय ते तुहुंं कय र्‌या की हामु देखजे ने तुहुंं पापीत गीणाय र्‌या।”<verse eid="JHN 9:41" /></para>
  <chapter eid="JHN 9" />
  <chapter number="10" style="c" sid="JHN 10" />
  <para style="s">गाडरा गुवाळ्‌यु ने तेरा गाडरान दाखलु</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1" />ईसु कह्‌यु, “मे तुहुंं काजे छाची-छाची कहं, की जु काहनुक गाडरान ईना वाड़ान झपला मायन गाडरान वाड़ा मां नी भराये, बाकुन गाडरान वाड़ो चहड़ीन एक धड़े मायन भराये, चु चुट्‌टु ने डाकु छे। <verse eid="JHN 10:1" /><verse number="2" style="v" sid="JHN 10:2" />बाकुन जु गाडरान वाड़ान झपले मायन भराये, चु गाडरा गुवाळ्‌यु छे। <verse eid="JHN 10:2" /><verse number="3" style="v" sid="JHN 10:3" />ने तेरे भीणी गाडरान वाड़ान झपले राखवाळी करन्‌यु झपलु उघाड़ देय। ने गाडरा तीना गाडरा गुवाळ्‌यान बुली सामळी लेय, ने चु आपसा एक-एक गाडरान नाव धरीन बुलावे, ने आपसा गाडराक खयड़े चारने ली जाती रहे। <verse eid="JHN 10:3" /><verse number="4" style="v" sid="JHN 10:4" />ने जत्‌यार चु आपसा आखा गाडरा काजे खयड़े ली जाय, ती चु तींद्‌रे अगळ-अगळ चाले, ने चे गाडरा आपसा मालीकेन बुली समजी जाय, ने तेरे पछळ-पछळ आवे। <verse eid="JHN 10:4" /><verse number="5" style="v" sid="JHN 10:5" />बाकुन कदी अंजाण्‌यु माणुस आयड़े ती चे गाडरा राखवाळ्‌यान अंजाणी बुली काजे नी उळखे, ने तेरे पछळ-पछळ नी जाय बाकुन तीनाक देखीन छेटा डास जासे।”<verse eid="JHN 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 10:6" />ईसु तीनुक जी वात दाखलु<note caller="+" style="f"><char style="fr" closed="false">10:6 </char><char style="ft" closed="false">द्रष्टान्त</char></note> दीन कह्‌यु, बाकुन तीनुक तीना दाखलान मतलब समजायो नी।<verse eid="JHN 10:6" /></para>
  <para style="s">ईसु वारलु गुवाळ्‌यु छे</para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7" />तत्‌यार ईसु तीनुक अळी कह्‌यु, मे तुहुंंक छाची-छाची कह्‌वो, गाडरान झपलु मेत छे। <verse eid="JHN 10:7" /><verse number="8" style="v" sid="JHN 10:8" />जतरा मारे सी पेहेल आया चे आखा चुट्‌टा ने डाकु छे, बाकुन गाडरा तेरी नी सामळ्‌या। <verse eid="JHN 10:8" /><verse number="9" style="v" sid="JHN 10:9" />झपलु मे छे, कदी काहनुक मारे मायन माहीं आवे, ती मे राखवाळी करीस, ने बाहर आवता जाता रवसे ने चारु जड़से। <verse eid="JHN 10:9" /><verse number="10" style="v" sid="JHN 10:10" />चुट्‌टु काहनुक दीसरा काम आटे नी आवे, बाकुन चुरी करने अतरुत आवे, ने मारने ने खत्‌तम करने आवे, बाकुन मे असु करीन आयु की हीनुक नवलो जीवन जड़े ने पुरो की पुरो जड़े।<figure style="fig" alt="Shepherd with his sheep in sheepfold" file="lb00014c.tif" size="span" copy="Horace Knowles ©" ref="10:7">गाडरान कुंडवाड़ा मां गाडरा साते गुवाळ्‌या</figure><verse eid="JHN 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11" />वारलु गुवाळ्‌यु मे छे! वारलु गुवाळ्‌यु गाडरा आटे आपसान जीव दी देय। <verse eid="JHN 10:11" /><verse number="12" style="v" sid="JHN 10:12" />बाकुन दाहड़क्‌यु नीते गुवाळ्‌यु हय, ती गाडरान मालीक छे, लेंड्‌या काजे आवता देखीन गाडरा काजे छुड़दीन ढासी जाय, ने लेंड्‌या तीनुक धरे ने रावण्‌या-तीवण्‌या कर देय। <verse eid="JHN 10:12" /><verse number="13" style="v" sid="JHN 10:13" />दाहड़क्‌यु असु करीन ढासी जाय की चु पावर्‌यु छे, ने तेरी गाडरान फीकुर नी करे। <verse eid="JHN 10:13" /><verse number="14" style="v" sid="JHN 10:14" />वारलु गुवाळ्‌यु मे छे, मे मारा गाडरा काजे उळखो ने मारा गाडरा मेसेक उळखे। <verse eid="JHN 10:14" /><verse number="15" style="v" sid="JHN 10:15" />जसु बास मेसेक उळखे ने मे बासेक उळखो ने मे गाडरा आटे मारु जीव दी दम। <verse eid="JHN 10:15" /><verse number="16" style="v" sid="JHN 10:16" />मारा अळी बी गाडरा छे, चे ईना गाडरान वाड़ा मां नी हय। मेसे तीनुक बी लावणुत छे, चे मारी बुली सामळसे, तत्‌यार एकुत टुळु ने एकुत गुवाळ्‌यु रवसे।<verse eid="JHN 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 10:17" />बास असु करीन मारे सी परम राखे की मे मारु जीव दी दम, काहाकी तीना जीवेक पछु मांगणेन बी हक छे। <verse eid="JHN 10:17" /><verse number="18" style="v" sid="JHN 10:18" />बाकुन मे मारी मरजी सी दम, ने मेसे तीनाक देणेन बी हक छे, ने तीनाक अळी पछु लेणेन बी हक छे, जी हुकुम मारा बास सी मेसेक जड़ी।<verse eid="JHN 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 10:19" />ईसुन जी वात सामळीन, यहुदी माणसेम अळी लड़ाय हय गुय। <verse eid="JHN 10:19" /><verse number="20" style="v" sid="JHN 10:20" />तींद्‌रे मायन बेसका माणसे कवतेला, “हेरे भुतड़ा लागला छे, तुहुंं हेरी काहा सामळु।”<verse eid="JHN 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 10:21" />बाकुन दीसरा माणसे कहतेला, “जी वात भुतड़ा लागला माणसेन नी हय, काहाकी भुत आंदळान डुळाक वारु कर सके काय?”<verse eid="JHN 10:21" /></para>
  <para style="s">यहुदी माणसेन वीरुद मां ईसु</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22" />यरुसलेम मंदीर काजे भगवानेन हातेम सुपणेन तीहवार आयु। तीनु दाहड़ाम सींव पड़ रवली। <verse eid="JHN 10:22" /><verse number="23" style="v" sid="JHN 10:23" />ईसु मंदीर मां सुलेमान नावेन आंगणा मां हींडतेलु। <verse eid="JHN 10:23" /><verse number="24" style="v" sid="JHN 10:24" />तत्‌यार यहुदी नेता ईसुक घेर लेदा, ने कह्‌या, “तु हामरा मन काजे कां लगुन भुले पाड़तु रवसी? कदी तु मसी हय ती हामुक तसु छाची बताड़ दे?” <verse eid="JHN 10:24" /><verse number="25" style="v" sid="JHN 10:25" />ईसु तीनुक जपाप आप्‌यु, “मे तुहुंंक छाचलीन कय देदु की, मे कुण छे। बाकुन तुहुंं भुरसु नी करता, ज काम मे मारा बासेन नाव सी करो, मारी गवा पुरावु देय की मे छाचलीन कुण छे? <verse eid="JHN 10:25" /><verse number="26" style="v" sid="JHN 10:26" />तेबी तुहुंं भुरसु नी करता, काहाकी तुहुंं मारा गाडरा नी हय। <verse eid="JHN 10:26" /><verse number="27" style="v" sid="JHN 10:27" />मारा गाडरा मतलब मारा चेला, मारी बुली काजे जाणी लेय, ने मे तीनुक जाणो, ने मारे पछळ-पछळ आवे। <verse eid="JHN 10:27" /><verse number="28" style="v" sid="JHN 10:28" />ने मे तीनुक अमर जीवन आपो, ने हयु जीव कदी नी मरसे। ने कुय बी तीनाक मार हातेम सी नी हापके। <verse eid="JHN 10:28" /><verse number="29" style="v" sid="JHN 10:29" />मारु बास, चु तीनुक मेसेक आप्‌यु, आखा सी मटु छे, ने कुय बी तीनुक बासेन हातेम सी हापकी नी सके। <verse eid="JHN 10:29" /><verse number="30" style="v" sid="JHN 10:30" />मे ने मारु भगवान बास एक छे।”<verse eid="JHN 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31" />ईसुन जी वात सामळीन, यहुदी माणसे ईसु काजे मारने करीन अळी दगड़ा ईछ्‌या। <verse eid="JHN 10:31" /><verse number="32" style="v" sid="JHN 10:32" />ती ईसु तीनु काजे जपाप आप्‌यु, “मे मारा भगवान बासेन कह्‌याम तुहुंंक बेसका मटा वारलु काम करीन देखाड़्‌यु। तीनु मायन काहना कामेन करीन मेसेक दगड़ाटीन मारने हींडी र्‌या?”<verse eid="JHN 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33" />तत्‌यार यहुदी माणसे जपाप आप्‌या, “काहना बी वारलु कामेन करीन नी, बाकुन तु भगवानेन नाव-बद्‌दी कर र्‌यु करीन हामु तुसेक दगड़ाटीन मारने हींडी र्‌या, तु ते माणुस हय्‌न बी खुद काजे ‘मे भगवान छे’ करीन कय र्‌यु।”<verse eid="JHN 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 10:34" />ईसु तीनुक जपाप आप्‌यु, “तीना चुखला सास्‌तुर काजे तुहुंं मानु, तेरेमां असो लिखलो छे भगवान कह्‌यु, तुहुंं देवता छे” तुहुंंक जी वात मालम नी हय काय। <verse eid="JHN 10:34" /><verse number="35" style="v" sid="JHN 10:35" />पेहला वाराम तीनु माणसेन्‌चां आपसु बुल पुगाड़लु, तीनु काजे भगवान देवता करीन बुलाड़्‌यु। ने खरली सास्‌तुर मां लिखली वात कदी नी टळे। <verse eid="JHN 10:35" /><verse number="36" style="v" sid="JHN 10:36" />बाकुन मेसेक ते चुखलु भगवान बास हक आपीन ईनी कळी मां मकेल्‌लु छे, ने मे भगवानेन पुर्‌यु छे करीन मे मारा बारामां कह्‌यु, ती तुहुंं रीसवायन मेसेक तु भगवानेन नाव-बद्‌दी कर र्‌यु, करीन काहा कय र्‌या? <verse eid="JHN 10:36" /><verse number="37" style="v" sid="JHN 10:37" />कदी मे मारा बासेन काम नी करो ती मारे पर भुरसु घुण करु। <verse eid="JHN 10:37" /><verse number="38" style="v" sid="JHN 10:38" />बाकुन कदी मे भुरसु करो, ती भले मारे पर भुरसु मां करु, बाकुन तीनु कामे पर ते भुरसु करु, काहाकी तुहुंं जाणु ने समजु की बास मारेम छे, ने मे बासेम छे।<verse eid="JHN 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 10:39" />जी वात सामळीन, यहुदी माणसे, अळी ईसु काजे धरने हींडी रवला, बाकुन चु तींद्‌रा हातेम सी नीस्‌टीन जाती रयु।<verse eid="JHN 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 10:40" />ईसु आपसा चेला पुठ्‌ये अळी यरदन नदीन पली धड़े जागा पर जाती र्‌यु, चां युहन्‌नु पेहेल बपतीस्‌मा आप्‌या करतेलु, ने चाहात रहणे बाजी गुयु। <verse eid="JHN 10:40" /><verse number="41" style="v" sid="JHN 10:41" />बेसका माणसे ईसु धड़े आवीन कहतेला, “युहन्‌नु ते असो काहना बी मटा कामेन सहलाणी<note caller="+" style="f"><char style="fr" closed="false">10:41 </char><char style="ft" closed="false">चिन्ह</char></note> नी देखाड़्‌यु, बाकुन युहन्‌नु ईसुन बारामां ज काय हवलो, चो आखो छाचलीन हतलो।” <verse eid="JHN 10:41" /><verse number="42" style="v" sid="JHN 10:42" />ने चां बेसका माणसे ईसु पर भुरसु कर्‌या।<verse eid="JHN 10:42" /></para>
  <chapter eid="JHN 10" />
  <chapter number="11" style="c" sid="JHN 11" />
  <para style="s">लाजर मांदु हय्‌न मरे</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1" />बेतन्‌या गांव मां तीन भाय बहणस्‌या रहतेला, लाजर ने तेरे दुय बहणीस मारथा ने मरीयम, एक दाहड़े हेरु भाय लाजर मांदु पड़ गुयु। <verse eid="JHN 11:1" /><verse number="2" style="v" sid="JHN 11:2" />जी चीत मरीयम हतली, ची मालीक ईसुन पाये पर ईत्‌तर रेचवीन आपसे कान्‌या सी तेरा पाये नुछली हेरुत भाय लाजर मांदलु हतलु। <verse eid="JHN 11:2" /><verse number="3" style="v" sid="JHN 11:3" />तेरेमां मरीयम ने मार्‌था लाजरेन बहणीस ईसु धड़े असी कय मकली की, “ए मालीक, देख, तीनाक तु वारु परम राखे चु मांदलु छे।”<verse eid="JHN 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4" />ईसु जी वात सामळीन कह्‌यु, “जी मांदवाड़ मर जाणु करीन नी आय, बाकुन भगवानेन बड़ाय हवणे करीन, ने ईनी मांदवाड़ेन साहरे भगवानेन पुर्‌यान बी बड़ाय हवे।”<verse eid="JHN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 11:5" />ईसु लाजर काजे, ने तेरी बहणीस मारथा ने मरीयम काजे परम करतेलु। <verse eid="JHN 11:5" /><verse number="6" style="v" sid="JHN 11:6" />तेबी जत्‌यार ईसु सामळ्‌यु, की लाजर मांदलु छे, ती जां लाजर रहतेलु चां जाणी बुजीन दुय दाहड़ा अळी रय गुयु। <verse eid="JHN 11:6" /><verse number="7" style="v" sid="JHN 11:7" />जी दुय दाहड़ा बीती गुया, ने पछेन ईसु चेला काजे कह्‌यु, “चालु आपणु अळी पछा यहुदी जीलाम जाजे।”<verse eid="JHN 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 11:8" />बाकुन चेला ईसु काजे कह्‌या, “ए मास्‌तर! ईतराक दाहड़ा पेहलुस ते यहुदी डाहला नेता तुसेक दगड़ाटीन मारने हींडी रवला, ने तु पछु अळी चांहान जाणे हींडी र्‌यु?”<verse eid="JHN 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 11:9" />ईसु जपाप आप्‌यु, “काय दाहड़ान बारे घंटा नी रवे? कदी काहनुक माणुस दीसु चाले ती झट नी लागे काहाकी तीनाक ईनी कळीन वीजाळो देखाये। <verse eid="JHN 11:9" /><verse number="10" style="v" sid="JHN 11:10" />बाकुन कदी काहनुक राते चाले ती झटवायसे, काहाकी चां वीजाळो नी रहे।” <verse eid="JHN 11:10" /><verse number="11" style="v" sid="JHN 11:11" />ईसु जी वात कह्‌यु, ने पछेन कहणे बाजी गुयु, “आपणु दुस्‌तीदार लाजर सुय गुयु, बाकुन मे हीनाक जागाड़ने जाम।”<verse eid="JHN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 11:12" />चेला कह्‌या, “ए मालीक। कदी चु सुय रयु हसे, ती वारु हय जासे।”<verse eid="JHN 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 11:13" />ईसुन चेला ज्‌य समज्‌या की लाजर छाचलीन सुवणे बाजी रयु हसे, बाकुन ईसु ते दाखलान साहरे ईसारु करीन कहणे बाजी रवलु। <verse eid="JHN 11:13" /><verse number="14" style="v" sid="JHN 11:14" />तत्‌यार ईसु तीनुक सय-सय कय देदु, “की लाजर मर गुयु।” <verse eid="JHN 11:14" /><verse number="15" style="v" sid="JHN 11:15" />मे लाजरेन मरने टेमे चां नी हतलु, तेबी मे तुहुंं छे करीन मे खुस छे, “काहाकी हय तुहुंं मारे पर पाक्‌कु भुरसु करने मुखु जड़ जासे। ती चालु, आपणु लाजर धड़े जाजे।”<verse eid="JHN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16" />तत्‌यार थोमु चु दीद्‌मुस बी कह्‌वाये, हेरे साते चेला सी कह्‌यु, “चालु, आपणु बी हेरे साते जाजे भले आपणुक बी हेरे पुठ्‌ये मरनु पड़े।”<verse eid="JHN 11:16" /></para>
  <para style="s">बेतन्‌या गांव मां ईसु</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17" />जत्‌यार ईसु बेतन्‌या गांव मां पुग्‌यु, ती चु सामळ्‌यु की लाजर काजे मसाण मां मेकला चार दाहड़ा हय गुया। <verse eid="JHN 11:17" /><verse number="18" style="v" sid="JHN 11:18" />बेतन्‌या गांव यरुसलेम सहर सी एक कुस लांबो हतलो। <verse eid="JHN 11:18" /><verse number="19" style="v" sid="JHN 11:19" />ने बेसका यहुदी माणसे बी लाजरेन मरनेन खबर सामळीन हेरी बहणीस मारथा ने मरीयम काजे हुगा राखणे, ने तुहुंं काठु जीव राख्‌जु करीन हेरा भायसेन बारामां कहंणे चां आय रवला।<verse eid="JHN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 11:20" />जत्‌यार मारथा सामळी, की ईसु आवणे बाजी र्‌यु, तीनाक भेळी हवणे करीन अघीस गुय बाकुन मरीयम घरुत मां बस रय। <verse eid="JHN 11:20" /><verse number="21" style="v" sid="JHN 11:21" />ईसु धड़े पुगीन मारथा ईसु काजे कय, “ए मालीक! कदी तु जां रहतु ती मारु भाय नी मरतु। <verse eid="JHN 11:21" /><verse number="22" style="v" sid="JHN 11:22" />ने मेसेक मालम छे, की तु हय बी भगवान भीणी सी ज काय मांगीस, चोन भगवान तुसेक आपसे।”<verse eid="JHN 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 11:23" />ईसु मारथा काजे कह्‌यु, “तारु भाय पछु जीवतु हय जासे।”<verse eid="JHN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 11:24" />ज सामळीन मारथा ईसु काजे कय, “मेसेक मालुम छे, की तीने दाहड़े आखा मरला माणसे मर्‌या-सर्‌याम सी पछा जीवता हय्‌न बठा हवसे, तीने दाहड़े मारु भाय बी तींद्‌रे भेलुत पछु जीवतु हय्‌न बठु हय जासे।”<verse eid="JHN 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 11:25" />ईसु मारथा काजे कह्‌यु, “मर्‌या-सर्‌याम सी पछा जीवता करीन बठा करन्‌यु, ने तीनुक अमर जीवाय आपण्‌यु मेत छे, जु बी मार पर भुरसु करे, चु मर बी जासे तेबी जीवतेलु रवसे।” <verse eid="JHN 11:25" /><verse number="26" style="v" sid="JHN 11:26" />ने जु मार पर भुरसु करतु जाय्‌न जीवतेलु रवसे, तीनाक जलमकी मुतेन डंड नी जड़े तु ईनी वात पर भुरसु करे काय? <verse eid="JHN 11:26" /><verse number="27" style="v" sid="JHN 11:27" />ती मारथा कय, “हव, मालीक! पाक्‌कु भुरसु करो की ईनी कळी मां आवणे वाळु भगवानेन पुर्‌यु तीनाक मसी कहवे चु तुत छे।”<verse eid="JHN 11:27" /></para>
  <para style="s">ईसु रड़्‌यु</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28" />ची असी कयदीन जाती रय ने आपसी बहणीस मरीयम काजे बुलावीन कळ्‌येन तीनीक कय, “मास्‌तर आय रयु, चु तुसेक बुलावे।” <verse eid="JHN 11:28" /><verse number="29" style="v" sid="JHN 11:29" />ज सामळीन मरीयम छाटीत उठीन ईसु काजे भेळी हवणे चाल पड़ी। <verse eid="JHN 11:29" /><verse number="30" style="v" sid="JHN 11:30" />ईसु हाल लगुन तीना गांव मां नी आयु, हय बी चु तीना जागा पर हतलु जां मारथा ईसुक भेळी हवली। <verse eid="JHN 11:30" /><verse number="31" style="v" sid="JHN 11:31" />तत्‌यार ईतराक यहुदी माणसे हेरे साते घर मां हतला ने तीनाक हुगी रव ने काठु जीव राख, करीन कह्‌णे बाजी रवला, चे माणसे ज देख्‌या की ची उचकाणुन मरीयम उठीन खयड़े चाल पड़ी ती चे असा वीच्‌यार कर्‌या की जी मसाण पर रहणे जाणे बाजी रय, ने चे बी तेरे पछळ चाल पड़्‌या।<verse eid="JHN 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32" />जत्‌यार मरीयम ती जागे पुगी जां ईसु हतलु, ती तीनाक देखतात ची तेरा पायेम हीट पड़ी ने कय ए मालीक! “कदी तु जां रवतु ती मारु भायस नी मरतु।”<verse eid="JHN 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 11:33" />ने ईसु मरीयम काजे ने तेरे पुठ्‌ये आवला यहुदी माणसेक रड़तेला देख्‌यु, ती ईसुन जीव भळ कर्‌यु, ने चु बेसकु दुखी हय गुई। <verse eid="JHN 11:33" /><verse number="34" style="v" sid="JHN 11:34" />ने चु कह्‌यु, “तीनाक काहना जागा पर मेकला छे?” चे ईसुक कह्‌या, ए मालीक!</para>
  <para style="p" vid="JHN 11:34">चाल आवीन देख ले।<verse eid="JHN 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 11:35" />ने ईसु तत्‌यार कलपी-कलपीन रड़ने बाजी गुयु। <verse eid="JHN 11:35" /><verse number="36" style="v" sid="JHN 11:36" />ईसु काजे रड़तेलु देखीन चां भेळा हवला माणसेम सी बेसका यहुदी माणसे कह्‌या, “देखु! जु ते लाजर काजे बेसकु परम करतेलु।”<verse eid="JHN 11:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 11:37" />बाकुन थुड़ाक माणसे कह्‌या, “जु ते आंदळान डुळा उघाड़ीन तीनाक देखता कर्‌यु ती जु लाजर काजे काहानी बचाड़्‌यु?”<verse eid="JHN 11:37" /></para>
  <para style="s">ईसु लाजर काजे पछु जीवतु करे</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38" />ज सामळीन ईसुन जीव अळी भळ लेवायु, ने चु लाजरेन मसाण धड़े गुयु, ची मसाण बयड़ान खंगरा मां दर खुदीन बणावलो हतलो, ने तेरे पर एक चापरु दगड़ु मेल्‌लु हतलु। <verse eid="JHN 11:38" /><verse number="39" style="v" sid="JHN 11:39" />ईसु माणसेक कह्‌यु, “चापरु दगड़ु हेड़ देवु।” मरला लाजरेन बहणीस मारथा कही,</para>
  <para style="p" vid="JHN 11:39">“बाकुन ए मालीक लाजर मरलु चार दाहड़ा हय गुया हय ते तेरो धड़ गंदायतो हसे।”<verse eid="JHN 11:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 11:40" />ईसु मारथाक कह्‌यु, “कदी तु भुरसु करसी, ती भगवानेन सेक-सींगार देखसी, असु मे तुसेक हय पेहलुस कह्‌लु बी।” <verse eid="JHN 11:40" /><verse number="41" style="v" sid="JHN 11:41" />तत्‌यार चे माणसे चापरु दगड़ु हेड़ देदा ने ईसु सरग भीणी भाळीन कह्‌यु, ए भगवान बास! मे तुसेक बेसकु वारु कह्‌वो तु मारी दुवा सामळी लेदु। <verse eid="JHN 11:41" /><verse number="42" style="v" sid="JHN 11:42" />तु ते मारी दुवा सामळ्‌या करे जी वात मेसेक पाक्‌को मालुम छे बाकुन मे जी वात आड़े-धड़े उबा हय रवला माणसे वाटे कय र्‌यु, “काहाकी चे ज देखीन भुरसु करे ने असा जाणे की ईना ईसुक भगवानुत हक आपीन मकेल्‌लु छे।” <verse eid="JHN 11:42" /><verse number="43" style="v" sid="JHN 11:43" />असु कयदीन ईसु जुर सी आयड़ीन कह्‌यु, “लाजर! बाहर नीकळ। <verse eid="JHN 11:43" /><verse number="44" style="v" sid="JHN 11:44" />चु मरलु लाजर जीवतु हय्‌न बाहर नीकळी आयु, तेरे मुंहडे ने हाते पाये पुथल्‌यान पाटा बांदला हतला, ईसु माणसेक असु कह्‌यु, हेरा पाटा छुड़ीन हीनाक जाणी देवु।”<verse eid="JHN 11:44" /></para>
  <para style="s">ईसु काजे मार नाखणेन जाळ सादी</para>
  <para style="r">(<ref loc="MAT 26:1-5">मत्‌ती 26:1-5</ref>; <ref loc="MRK 14:1">मरकुस 14:1</ref>,<ref loc="MRK 14:2">2</ref>; <ref loc="LUK 22:1">लुका 22:1</ref>,<ref loc="LUK 22:2">2</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45" />जे यहुदी माणसे, मरीयम काजे भेळा हवणे आवला हतला, चे ईसुन बेसका मटा काम देख्‌या, ने तीनु मायन बेसका माणसे ईसु पर भुरसु कर्‌या। <verse eid="JHN 11:45" /><verse number="46" style="v" sid="JHN 11:46" />बाकुन तीनु यहुदी माणसे मायन थुड़ाक जणा जाय्‌न फरीसी माणसे काजे ईसुन ईना मटला कामेन बारामां कय देदा। <verse eid="JHN 11:46" /><verse number="47" style="v" sid="JHN 11:47" />ने मंदीरेन डाहला पुजारा ने फरीसी माणसे पंचु बठ्‌या ने कह्‌या, “आपणु काय करजे? हयु माणुस ते मटा कामेन सहलाणी देखाड़ने बाजी र्‌यु। <verse eid="JHN 11:47" /><verse number="48" style="v" sid="JHN 11:48" />कदी आपणु हीनाक असुत करने देसुन ती हेरे पर आखा यहुदी माणसे भुरसु करने बाजी जासे, ने ईना काजे राजा बणाय देसे, तत्‌यार रोमी सीपायड़ा आवीन आपणु मंदीर ने आपणी आखी जाती काजे सार देसे।”<verse eid="JHN 11:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49" />तींद्‌रे मायन एक जणु तेरो नाव काइफा हतलो, ने चु तीने साल मंदीरेन डाहला पुजारान मुख्‌यु हतलु चु पंचुन वात सामळीन तीनु काजे कह्‌यु, “तुहुंंक ईतरोक बी मालुम नी हय काय? <verse eid="JHN 11:49" /><verse number="50" style="v" sid="JHN 11:50" />जाराक वीच्‌यार ते करु आपणा माणसे वाटे एकुत माणुस मरसे ती आपणी आखी जाती बच जासे, आपणे वाटे च वारलु रवसे।” <verse eid="JHN 11:50" /><verse number="51" style="v" sid="JHN 11:51" />चु जी वात आपसुत नी कह्‌यु, बाकुन चु तीने साल मंदीरेन डाहला पुजारान मुखी हवणेन नाते पेहेल सी हवणे वाळी वात कह्‌यु की ईसु भगवान आखा माणसे वाटे मरसे। <verse eid="JHN 11:51" /><verse number="52" style="v" sid="JHN 11:52" />हेरो मतलब ज छे की ईसु यहुदी जाती वाटे अतरुत नी बाकुन, रावण्‌या-तीवण्‌या हवला भगवानेन आखा पुर्‌या-पारी तीनुक भेळा करने करीन मरसे।<verse eid="JHN 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 11:53" />तीनेत दाहड़े सी यहुदी पंचु वाळा मुख्‌या ईसु काजे मारने करीन पाक्‌कु वीच्‌यार कर्‌या। <verse eid="JHN 11:53" /><verse number="54" style="v" sid="JHN 11:54" />ज जाणीन ईसु तीने दाहड़े सी यहुदीया जीलान माणसे मां उजेंतु नी हवणे चाहतेलु, बाकुन यहुदीया जीलान यरुसलेम सहर छुड़ीन उजाड़्‌या बयड़ा धड़े वाळा येफरेन नावेन सहरेम जाय्‌न चेला पुठ्‌ये रहणे बाजी गुयु।<verse eid="JHN 11:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55" />यहुदी जातीन फसह तीहवार धड़ेत आय रवलु, ने तीना तीहवारेन पेहलुत आपसा काजे चुखा करने करीन बेसका माणसे गांव खेड़ाम सी यरुसलेम सहर मां आय रवला। <verse eid="JHN 11:55" /><verse number="56" style="v" sid="JHN 11:56" />ने चे ईसु काजे हेरता-हेरता यरुसलेम मंदीरेन्‌चां उबा रय गुया, ने ईसु नी जड़्‌यु, ती चे एक दीसराक कहणे बाजी गुया, “तुंद्‌रु काय वीच्‌यार छे, चु तीहवार मां नी आवे काय?” <verse eid="JHN 11:56" /><verse number="57" style="v" sid="JHN 11:57" />मंदीरेन डाहला पुजारा ने फरीसी माणसे काजे पेहलुत हुकुम आपीन ज कह्‌या, की तुंद्‌रे मायन कुय बी ईसुन बारामां मालुम हवे, की ईसु जां छे, ती आवीन कय देजु ने हामु तीनाक धराय देसु।<verse eid="JHN 11:57" /></para>
  <chapter eid="JHN 11" />
  <chapter number="12" style="c" sid="JHN 12" />
  <para style="s">ईसु, बेतन्‌या गांव मां हेरा चेला पुठ्‌ये</para>
  <para style="r">(<ref loc="MAT 26:6-13">मत्‌ती 26:6-13</ref>; <ref loc="MRK 14:3-9">मरकुस 14:3-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1" />ईसु तीहवारेन छव दाहड़ा पेहेल यरुसलेम सहर धड़े, बेतन्‌या गांव मां गुयु, चां लाजर रहतेलु, तीनाक ईसु मर्‌या-सर्‌याम सी जीवतु करलु। <verse eid="JHN 12:1" /><verse number="2" style="v" sid="JHN 12:2" />ने तींद्‌रे मायन एक घर मां ईसुन मेजवानी कर्‌या ने लाजर बी चां खाणे बठी रवलु, ने मारथा चां वारती बणीन खावड़ातेली। <verse eid="JHN 12:2" /><verse number="3" style="v" sid="JHN 12:3" />तत्‌यार मरीयम आदु लीटर बेसको महंगलो ईत्‌तर लावीन ईसुन पाये पर रेचवी ने आपसे कान्‌या सी तेरा पाये नुछी, ने ईत्‌तरेन गंदे आखो घर गंदणु<note caller="+" style="f"><char style="fr" closed="false">12:3 </char><char style="ft" closed="false">सुगन्धित</char></note> ईस्‌ट्‌यो च ईत्‌तर एक खास झाड़कान मुळेम सी नीकाळीन बणावलो पीवर ईत्‌तर हतलो। <verse eid="JHN 12:3" /><verse number="4" style="v" sid="JHN 12:4" />ज देखीन ईसुन एक चेलु, यहुदा ईस्‌करीयोती चु ईसुक धराड़ने वाळु हतलु, चु कह्‌णे बाजी गुयु। <verse eid="JHN 12:4" /><verse number="5" style="v" sid="JHN 12:5" />“च ईत्‌तर वेचती ती तीन सोव दाहड़ान दाहड़कीन पयस्‌या जड़ जाता, ने चे पयस्‌या बेसका गरीबेक आपीन मदत कर देणु हतलो।” <verse eid="JHN 12:5" /><verse number="6" style="v" sid="JHN 12:6" />तीनाक गरीबेन फीकुर हतली, चु जी वात नी कह्‌यु, बाकुन चु चुट्‌टु हतलु। चु ते तींद्‌री पयस्‌यान थयलिन राखवाळी करन्‌यु हतलु, तेबी चु तीनी थयलिम सी ईत्‌तराक पयस्‌या चुरी कर लेदलु।<figure style="fig" alt="Alabaster jars" file="hk00142c.tif" size="col" copy="Horace Knowles ©" ref="12:3">संगमरमरेन ठाहरु</figure><verse eid="JHN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7" />ईसु तीनाक कह्‌यु, “हीनीक रहणी देवु! काय मां कहुं हयी ते मारे डागेन तीयारी पेहेलुत सी करने बाजी रय। <verse eid="JHN 12:7" /><verse number="8" style="v" sid="JHN 12:8" />काहाकी गरीब ते तुंद्‌रे पुठ्‌ये जलम लग रवसे बाकुन मे तुंद्‌रे पुठ्‌ये जलम लग नी रहो।”<verse eid="JHN 12:8" /></para>
  <para style="s">लाजर काजे मारनेन वीच्‌यार करे</para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9" />जत्‌यार यहुदी बेसका माणसे काजे मालुम हय गुयो की ईसु बेतन्‌या मां आयु, ती चे ईसु छे करीन अतरात नी आया बाकुन बेसकास ते लाजर काजे देखणे आया, तीनाक ईसु मरलाम सी पछु जीवतु करलु। <verse eid="JHN 12:9" /><verse number="10" style="v" sid="JHN 12:10" />तत्‌यार डाहला पुजारा लाजर काजे बी मारनेन मुजगी कर लेदला। <verse eid="JHN 12:10" /><verse number="11" style="v" sid="JHN 12:11" />काहाकी ईसु ईना कामे सी बेसका यहुदी माणसे तीनु यहुदी डाहला पुजाराक छुड़ देदला ने ईसु पर भुरसु कर्‌या।<verse eid="JHN 12:11" /></para>
  <para style="s">ईसु यरुसलेम मां जाय</para>
  <para style="r">(<ref loc="MAT 21:1-11">मत्‌ती 21:1-11</ref>; <ref loc="MRK 11:1-11">मरकुस 11:1-11</ref>; <ref loc="LUK 19:28-40">लुका 19:28-40</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12" />दीसरे<note caller="+" style="f"><char style="fr" closed="false">12:12 </char><char style="ft" closed="false">दूसरे</char></note> दाहड़े तीहवार वाळने आवला माणसेन मट्‌लु टुळु, असा सामळ्‌या की ईसु यरुसलेम मां आवणे बाजी र्‌यु। <verse eid="JHN 12:12" /><verse number="13" style="v" sid="JHN 12:13" />ने चे माणसे खजुरेन डाळ्‌या लीन तीनाक भेळा हवणे गुया, ने आयड़ी-आयड़ीन कह्‌या, होसान्‌ना! बेसकु वारु छे, ईस्‌रायलेन राजु, जे मालीक भगवानेन नाव सी आवे!<verse eid="JHN 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 12:14" />बाकुन ईसु काजे गदड़ीन एक पीलो जड़्‌यो, ती चु तेरे पर बठी गुयु, जसों की खरला सास्‌तुर मां लिखलो छे,<verse eid="JHN 12:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JHN 12:15" />“सीयोन सहर मां रहण्‌या माणसेन टुळा” बीहे मां!</para>
  <para style="q1" vid="JHN 12:15">देख, तारु राजा तुंद्‌रेन्‌चां आवणे बाजी र्‌यु,</para>
  <para style="q2" vid="JHN 12:15">चु ते गदड़ीन पीला पर बठीन आवणे बाजी र्‌यु।<verse eid="JHN 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16" />ईसुन चेलाक पेहेल मेहेल ते जी वात पल्‌ले नी पड़ी, बाकुन जत्‌यार ईसु मर्‌या-सर्‌याम सी जीवतु हय्‌न पछु सरगेन आपसा सेक-सींगार मां जाती र्‌यु, ती तीनुक पल्‌ले पड़ी की ईसुन बारामां असोत लिखलो हतलो ने तसा की तसा माणसे तीने दाहड़े तेरे साते वेहवार करला।<verse eid="JHN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17" />तत्‌यार टुळा मायन चे माणसे गवा देदा, चे तीने टेमे हेरे साते हतला, जत्‌यार हयु लाजर काजे मसाण मां सी बुलायन मर्‌या-सर्‌याम सी पछु जीवतु करलु। <verse eid="JHN 12:17" /><verse number="18" style="v" sid="JHN 12:18" />तेरेमां माणसे हीनाक मेळने करीन आवला, काहाकी चे सामळ्‌या की हयु असु मटा कामेन सहलाणी देखाड़्‌यु। <verse eid="JHN 12:18" /><verse number="19" style="v" sid="JHN 12:19" />ने च आखो देखीन फरीसी माणसे आपसा-आपसा कह्‌णे बाजी गुया, “देखु ते खरा, आखी कळीन माणसे ईसु पछळ चाल पड़्‌या, ने आपणु हीनुक बेसका रुकणे कर्‌या, तेबी हया नी रुकायता।”<verse eid="JHN 12:19" /></para>
  <para style="s">नी-यहुदी ईसु काजे हेरे</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20" />चे माणसे तीहवारेन मुखा पर भगवानेन भक्‌ती करने यरुसलेमेन मंदीर मां आवला, तींद्‌रे मां ईतराक युनानी माणसे हतला। <verse eid="JHN 12:20" /><verse number="21" style="v" sid="JHN 12:21" />चे गलील जीलान बेतसेदा गांव मां रहण्‌या फीलीप्‌पुस धड़े आवीन तेरे धड़े लीलघाय्‌न असा कह्‌या, “ए मालीक! हामु ईसु काजे भेळा हवणे हींडी र्‌या।”<verse eid="JHN 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 12:22" />फीलीप्‌पुस जाय्‌न अन्‌दीरीयास काजे खबर कर्‌यु ने, अंदीर्‌यास फीलीप्‌पुस भेळुत जाय्‌न ईसु काजे खबर कर्‌यु। <verse eid="JHN 12:22" /><verse number="23" style="v" sid="JHN 12:23" />ईसु तीनु काजे आपसा मरनेन बारामां दाखला सी कह्‌यु, माणसेन पुर्‌यु दुख झेलीन सरग वाळा सेक-सींगार मां पछु जाणेन घड़ी आय लागली छे। <verse eid="JHN 12:23" /><verse number="24" style="v" sid="JHN 12:24" />मे तुहुंंक छाची-छाचीन कह्‌वो जत्‌यार लग गहुंन दाणु धुळा मां पड़ीन मरे नी, तत्‌यार लग चु एखलुत रहे, बाकुन कदी चु मर जाय, ती बेसका दाणा लावे। <verse eid="JHN 12:24" /><verse number="25" style="v" sid="JHN 12:25" />जु काहनुक ईनी कळीन जीवाय मां आपसा जीव काजे जादा परम करे, चु आपसा जीवेक खुवसे, बाकुन जु काहनुक ईनी कळीन जीवाय मां आपसान जीव आपणे लग तीयार छे, ती चु आपसा जीव काजे अमर जीवन हेर लेसे। <verse eid="JHN 12:25" /><verse number="26" style="v" sid="JHN 12:26" />कदी काहनुक माणुस मारी सेवा चाकरी करने हींडे ती तीनाक मारु चेलु बणीन मारा कह्‌याम चालनु चाहजे, जसु मे मुतेन वाटे हय चालने बाजी र्‌यु, तसात मारा चाकर्‌या चेलाक बी तीनेत वाटे चालनु पड़से, ने कदी काहनुक ईनी रीते मारी सेवा चाकरी करसे, ती मारु भगवान बास तेरी ईज्‌जत करसे।<verse eid="JHN 12:26" /></para>
  <para style="s">भगवान बास ईसु ने माणसे अगळ आपसु सेक-सींगार उजेंतु देखाड़े</para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27" />ईसु अगु कह्‌तु गुयु, “हय मारु जीव कलपी र्‌यु।” मे ज कहं काय? ए भगवान बास! मेसेक हीना दुखेन घड़ीम सी वाचाड़ नी, मे असु नी कहं, काहाकी मे ईना दुखेन घड़ी काजे एठणे करीन ईनी कळी मां आवलु छे। <verse eid="JHN 12:27" /><verse number="28" style="v" sid="JHN 12:28" />ए भगवान बास! “तारा नावेन सेक-सींगार उजेंतु देखाड़।” तीनीत टेमे सरगेम सी जु बुल सामळायु,</para>
  <para style="p" vid="JHN 12:28">मे सेक-सींगार उजेंतु देखाड़लु छे, “ने अळी उजेंतु देखाड़ीस।”<verse eid="JHN 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 12:29" />आड़े-धड़े उबा हय रवला माणसे ज सामळीन कह्‌या, “वादळो गुयो।” दीसरा माणसे कह्‌या, “सरग वाळु काहवाळ्‌यु हीनाक काय कह्‌यु।”<verse eid="JHN 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30" />ईसु जपाप आप्‌यु, “ईना बुलेन अवाज मारे वाटे नी आवी, बाकुन तुंद्‌रे वाटे सरगे सी आवी। <verse eid="JHN 12:30" /><verse number="31" style="v" sid="JHN 12:31" />हय भगवानेन वीरुद करन्‌या, ईनी कळीन नीयाव हवण्‌यो छे। हय, भगवान ईनी कळीन मुखी भुतड़ा काजे वार मां बाहर नीकाळ देसे। <verse eid="JHN 12:31" /><verse number="32" style="v" sid="JHN 12:32" />जत्‌यार माणसे मेसेक धरती पर लाकड़ान कुरुस पर चहड़ावीन मारसे, ती मे आखी जातीन माणसे काजे मारे भीणी मनवी लीस।” <verse eid="JHN 12:32" /><verse number="33" style="v" sid="JHN 12:33" />असु कय्‌न ईसु आपसा बारामां ज देखाड़ने हींडी रवलु, की मारी मोत असी हवणे वाळी छे।<verse eid="JHN 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34" />ईसुन वात सामळीन माणसे ईसुक कह्‌या, खरला सास्‌तुर मां सी हामुक ज सीकणु जड़लो छे की, “आवणे वाळु छुड़ावन्‌यु मसी जलम जीवतेलु रवसे। ती तु असु काहा कय र्‌यु की माणसेन पुर्‌या काजे ईनी धरती पर लाकड़ान कुरुस पर चड़ावीन मारसे? जु काहना भातीन वाचाड़न्‌यु माणसेन पुर्‌यु छे, चु मरनेन हेर कर र्‌यु? जी वात हामुक समज मां नी आवती।”<verse eid="JHN 12:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35" />तींद्‌री वात सामळीन ईसु तीनुक आपसा बारामां दाखलु दीन कह्‌यु, “तुंद्‌रे ईचमां वीजाळो हय छे, च ईतरीक वार भबळसे, जत्‌यार लग ज वीजाळो तुंद्‌रे ईचमां रवसे, ईना वीजाळा सी अगा चालता रहु। काहाकी आंदारलो तुहुंं काजे टुपी नी लेय। काहाकी जु कुय आंदारला मां चाले ती ज नी जाणे की कां जाणे बाजी रयु। <verse eid="JHN 12:35" /><verse number="36" style="v" sid="JHN 12:36" />जत्‌यार लग च वीजाळो तुंद्‌रे ईचमां छे, चां लग ईना वीजाळा पर भुरसु करु असा करसु ती तुहुंं वीजाळान अवल्‌यात बण जासु।” ईसु ज कय्‌न जाती र्‌यु, ने तींद्‌रे देखतात जातु-जातु अंछाप हय गुयु।<verse eid="JHN 12:36" /></para>
  <para style="s">यहुदी माणसे ईसु पर भुरसु नी करे</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 12:37" />ईसु ते माणसे अगळ चकराड़े तसा बेसका मटा कामेन सहलाणी देखाड़्‌यु, तेबी चे तेर पर भुरसु नी कर्‌या। <verse eid="JHN 12:37" /><verse number="38" style="v" sid="JHN 12:38" />काहाकी भगवानेन अघली वात बताड़न्‌यु माणुस यसायु जी वात पेहलुत कह्‌लु ची वात पुरी हवे:</para>
  <para style="q1" vid="JHN 12:38">“ए मालीक! कुण हामरी खबर<note caller="+" style="f"><char style="fr" closed="false">12:38 </char><char style="ft" closed="false">समाचार</char></note> पर भुरसु करलु छे?</para>
  <para style="q2" vid="JHN 12:38">कुणी पर मालीकेन जुर देखाव पड़लु छे।”<verse eid="JHN 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 12:39" />असा करीन चे भुरसु नी कर्‌या, काहाकी यसायु अळी बी ज कह्‌लु,<verse eid="JHN 12:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="JHN 12:40" />“भगवान तींद्‌रा डुळा काजे आंदळा कर देदु,</para>
  <para style="q2" vid="JHN 12:40">ने तींद्‌री मन काजे काठो कर देदलु छे,</para>
  <para style="q1" vid="JHN 12:40">की कांखुर मायन असो नी हय जाय की चे</para>
  <para style="q2" vid="JHN 12:40">देख लेय ने समजी लेय,</para>
  <para style="q2" vid="JHN 12:40">ने मारे भीणी पछा आय लागे,</para>
  <para style="q2" vid="JHN 12:40">ने मे हीनुक वारु कर दम।”<verse eid="JHN 12:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 12:41" />यसायु ते एक जागता सपना मां सेक-सींगार देख्‌लु, चु ते ईसुन बारामां पेहेल सी लिखी रवलु।<verse eid="JHN 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 12:42" />तेबी यहुदी मुख्‌या मायन थुड़ाक तेरे पर भुरसु कर्‌या ने दीसरा बेसका यहुदी माणसे बी ईसु पर भुरसु कर्‌या बाकुन फरीसी माणसेन धाके चे मुख्‌या उजेंता ईसु काजे नी मानतेला। तींद्‌रो ज बी बीहाणो हतलो की फरीसी माणसेन मुख्‌या हामुक आपणा भक्‌तीन घर मां सी नीकाळ देसे। <verse eid="JHN 12:42" /><verse number="43" style="v" sid="JHN 12:43" />काहाकी माणसे सी जादा ईज्‌जत मांगणे हेर करतेला, बाकुन भगवान सी ईज्‌जत मांगणे वारु नी लाग्‌यो।<verse eid="JHN 12:43" /></para>
  <para style="s">ईसुन लिखला बुले सी कळीन माणसेन नीयाव हवसे</para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44" />ईसु जुर सी आयड़ीन कह्‌यु, “जु मारे पर भुरसु करे, चु छाचलीन तेरे पर बी भुरसु कर र्‌यु, जु मेसेक मकेल्‌लु छे। <verse eid="JHN 12:44" /><verse number="45" style="v" sid="JHN 12:45" />ने जु मेसेक देखे, चु तीनाक देखे जु मेसेक मकेल्‌लु छे। <verse eid="JHN 12:45" /><verse number="46" style="v" sid="JHN 12:46" />मे वीजाळो बणीन कळी मां आवलु छे, तेरेमां चे आखा माणसे मारे पर भुरसु करे, चु आंदारला मां नी रहे। <verse eid="JHN 12:46" /><verse number="47" style="v" sid="JHN 12:47" />कदी काहनुक मारी वात सामळीन बी जी वात तीनीक मानीन नी जीवे, ती हय मे तेरु नीयाव करीन तीना गुनावाळु नी ठहरावो, काहाकी मे ईनी कळीन मनख्‌यान नीयाव करीन गुनावाळु ठहरावणे नी आयु, बाकुन तीनुक छुटकारु आपणे करीन आवलु छे। <verse eid="JHN 12:47" /><verse number="48" style="v" sid="JHN 12:48" />जु मेसेक नानु समजीन मारी सीकाड़ली वात काजे नी माने, तीनाक गुनावाळु ठहरावणे वाळु ते एक छे, ज मे सीकाड़लु छे की चे बुले तीनाक आवणे वाळा दाहड़ाम मतलब नीयावेन दाहड़े गुनावाळु ठहराय देसे। <verse eid="JHN 12:48" /><verse number="49" style="v" sid="JHN 12:49" />मे मारी मरजी सी काय बी नी कह्‌यु, बाकुन माणसेक काय-काय कहणु चाहजे ने काय सीकाड़नु चाहजे भगवान बास, जु मेसेक मकेल्‌लु छे, चु की चु मेसेक हुकुम आपीन देखाड़लु छे। <verse eid="JHN 12:49" /><verse number="50" style="v" sid="JHN 12:50" />मे जाणो की जे बुले कहणे करीन भगवान बास मेसेक हुकुम आप्‌लु छे, तींद्‌रेम अमर जीवेनेन ताकत छे, ने जसु भगवान बास मेसेक कहलु छे, तसु ने तसु मे सीकाड़ो।”<verse eid="JHN 12:50" /></para>
  <chapter eid="JHN 12" />
  <chapter number="13" style="c" sid="JHN 13" />
  <para style="s">ईसु आपसा चेलान पाय धुवे</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1" />फसह तीहवारेन दाहड़ु आय लाग्‌यु, ने खाणो तीयार हय रह्‌लो। ईसु काजे मालुम हतलो, की जी कळ छुड़ीन भगवान बासेन्‌चां जाणेन मारी घड़ी आय गुयली छे। ईसु आपसा चेला काजे, जे ईनी कळी मां हतला, तीनुक पेहेल सीत परम करतु आय रवलु ने आकरी<note caller="+" style="f"><char style="fr" closed="false">13:1 </char><char style="ft" closed="false">अन्त</char></note> टेम लग तीनु काजे तसुत परम करतु रयु।<verse eid="JHN 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 13:2" />सांतो हय रह्‌लो तत्‌यार ईसु ने तेरा चेला तीहवारेन खाणो खाणे करीन बठी गुया, तीने टेमे लग भुतड़ु सीमोन ईस्‌करीयोतीन पुर्‌या यहुदीयान मन मां ईसु काजे धुकु दीन धरावणेन वीच्‌यार नाख देदलु। <verse eid="JHN 13:2" /><verse number="3" style="v" sid="JHN 13:3" />ईसु जाणतेलु की मे भगवान बासेन्‌चां सी आवलु छे ने भगवान बास मारा हाते मां आखो काय आप देदलु छे ने मे तेरेन्‌चां पछु जाणे वाळु छे। <verse eid="JHN 13:3" /><verse number="4" style="v" sid="JHN 13:4" />ने चु खाणो खाणे रहणीदीन उबु हय गुयु ने आपसो उपरनो झगल्‌यो नीकाळ लेदु ने कमर मां टुवाल बांद लेदु। <verse eid="JHN 13:4" /><verse number="5" style="v" sid="JHN 13:5" />ती चु टगार्‌याम पाणी हेड़ लेदु, ने आपसा एक-एक चेलान पाय धुवतु गुयु, ने कमर मां बांदी रवलु, तीना टुवाल सी तींद्‌रा पाय नुछतु गुयु। <verse eid="JHN 13:5" /><verse number="6" style="v" sid="JHN 13:6" />जत्‌यार ईसु सीमोन पतरसेन्‌चां पाय धुवणे करीन आयु, ती पतरस ईसु काजे कह्‌यु, “ए मालीक! तु मारा पाय धुवणे हय र्‌यु काय?”<verse eid="JHN 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 13:7" />ईसु पतरस काजे जपाप आप्‌यु, “मे ज करने बाजी र्‌यु, च तु हींताळ नी समजतु बाकुन तु अळतेन समजी जासी।”<verse eid="JHN 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 13:8" />पतरस ईसुक कह्‌यु, “मे तुसेक मारा पाय कदी नी धुवणी दम।” ईसु पतरस काजे कह्‌यु,</para>
  <para style="p" vid="JHN 13:8">“कदी मे तुसेक नी धुवों, ती मार साते रवणे मां हक नी जड़े।”<verse eid="JHN 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 13:9" />ज सामळीन सीमोन पतरस ईसुक कह्‌यु, “ए मालीक! असो हय ती तु मारा पाय अतरा नी बाकुन मारा हात ने मुणको लग धुय दे।”<verse eid="JHN 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 13:10" />ती ईसु पतरस काजे अळी कह्‌यु, “जु उंघळी लेदलु छे, तीनाक आपसा पाय अतरा धुवणु छे, तेरो आखो डील ते चुखलो छे। तुहुंं ते चुखला छे, बाकुन आखा ने आखा चुखला नी हय।” <verse eid="JHN 13:10" /><verse number="11" style="v" sid="JHN 13:11" />ईसु काजे मालम हतलो की मेसेक कुण धरावसे, चु कह्‌यु, “तुहुंं आखा ने आखा चुखला<note caller="+" style="f"><char style="fr" closed="false">13:11 </char><char style="ft" closed="false">शुध्द</char></note> नी हय।”<verse eid="JHN 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 13:12" />जत्‌यार ईसु तींद्‌रा पाय धुय देदु, ती आपसो झगल्‌यो पछु पेहरीन अळी पछु बठ गुयु, ने तीनुक कह्‌यु, “मे तुंद्‌रे साते ज वेहवार कर्‌यु, तीना वेहवारेन मतलब तुहुंं समजी गुया काय? <verse eid="JHN 13:12" /><verse number="13" style="v" sid="JHN 13:13" />तुहुंं मेसेक मास्‌तर ने मालीकेन नाते बुलाड़ी र्‌या ने तुहुंं सय कय र्‌या, काहाकी मे छाचलीन चु ने चु छे। <verse eid="JHN 13:13" /><verse number="14" style="v" sid="JHN 13:14" />कदी मे तुंद्‌रु मालीक ने मास्‌तर हय्‌न बी तुंद्‌रा पाय धुयु ती तुहुंं बी एक दीसरान पाय धुवणु चाहजे। <verse eid="JHN 13:14" /><verse number="15" style="v" sid="JHN 13:15" />मे ते तुंद्‌रा पाय धुवीन तुंद्‌रे वाटे दाखलु देखाड़लु छे, ने जसु मे ने तुंद्‌रे साते वेहवार करलु छे, तसु तुंद्‌रे वेहवार तुहुंं बी दीसरा साते वेहवार करु। <verse eid="JHN 13:15" /><verse number="16" style="v" sid="JHN 13:16" />मे तुहुंं काजे छाची छाचीन ज कहं, काय हक मां रहणे वाळु पावर्‌यु आपसान मालीक सी मटु नी हय ने मकलन्‌या सी मटु नी हय। <verse eid="JHN 13:16" /><verse number="17" style="v" sid="JHN 13:17" />कदी तुहुंं जी वात समजीन एरे अनसारे जीवु ती तुहुंं बरकतवाळा रवसु।”<verse eid="JHN 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 13:18" />“मे तुहुंं आखा काजे बरकतवाळा नी कह्‌तु काहाकी मे तीनु आखाक जाणो जीनुक मे नेवाड़लु छे बाकुन तींद्‌रे मायन एक जम छे, तेरे बारामां असो लिखलो छे जु मारु रुटु खादु, चु मेसेक लातावणे बाजी गुयु, ची वात पुरी हवसे करीन मे तीनाक बी नेवाड़लु छे। <verse eid="JHN 13:18" /><verse number="19" style="v" sid="JHN 13:19" />हय मे तुहुंंक पेहलुत ज कयदम, तेरेसी मारो कहंलो पुरो हय जाय, ती तुहुंं भुरसु करसु, की मे चु ने चु छे। <verse eid="JHN 13:19" /><verse number="20" style="v" sid="JHN 13:20" />मे तुहुंंक छाची छाचीन ज कहं, जु काहनु मारे सी मकेल्‌ला माणसे काजे मानीन तेरो आव-भाव करे, चु मेसेक मानीन मारुत आव-भाव करे, चु मेसेक मकेलन्‌याक मानीन तेरुत आव-भाव करे।”<verse eid="JHN 13:20" /></para>
  <para style="s">ईसु धुकु देण्‌यान वात करे</para>
  <para style="r">(<ref loc="MAT 26:20-25">मत्‌ती 26:20-25</ref>; <ref loc="MRK 14:17-21">मरकुस 14:17-21</ref>; <ref loc="LUK 22:21-23">लुका 22:21-23</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21" />जी वात कयदीन ईसु जीवेम बेसकु कलपी गुयु, ने जी गवाय देदु काय वात नी सात्‌यु ने कह्‌यु, “मे तुहुंंक छाची-छाची कहं तुंद्‌रे मायन एक जणु मेसेक धराय देसे।”<verse eid="JHN 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 13:22" />चेलाक ज नी समज पड़्‌यो की ईसु कुणीन बारामां कहंणे बाजी र्‌यु, ने चेला चकरायन एक दीसरा भीणी भाळने बाजी गुया। <verse eid="JHN 13:22" /><verse number="23" style="v" sid="JHN 13:23" />तीनु बारे चेला मायन एक जणु, “ईसुन लाटेक्‌लु चेलु।” कहंवायतेलु। चु ईसुन छाती भीणी एक कड़्‌यु वळीन बठी रवलु। <verse eid="JHN 13:23" /><verse number="24" style="v" sid="JHN 13:24" />सीमोन पतरस तीनाक ईसारु करीन जां कह्‌यु, “ईसुक पुछ, चु चेलु कुण छे।”<verse eid="JHN 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 13:25" />तत्‌यार चु असु की असु ईसुन छाती भीणी अळीन बठी रवलुत ईसुक कळेन पुछ्‌यु, “ए मालीक! जु कुण छे?” <verse eid="JHN 13:25" /><verse number="26" style="v" sid="JHN 13:26" />ईसु तीनाक कळेन जपाप आप्‌यु, “मे तीनाक रुटान कवळ उलन मां चुपड़ीन आपीस, चु की चु मेसेक धरावण्‌यु छे।” ने चु रुटान कवळ चुपड़ीन<note caller="+" style="f"><char style="fr" closed="false">13:26 </char><char style="ft" closed="false">डुबाकर</char></note> सीमोन ईस्‌करीयोतीन पुर्‌या यहुदा काजे आप्‌यु। <verse eid="JHN 13:26" /><verse number="27" style="v" sid="JHN 13:27" />ने रुटान कवळ धरीन मुंहडाम नाख्‌तुत यहुदान डीलेम भुतड़ु भरायन तीनाक कब्‌जाम कर लेदु। तत्‌यार ईसु तीना यहुदाक कह्‌यु, “ज काम तु करने हींड र्‌यु च छाटुस कर।” <verse eid="JHN 13:27" /><verse number="28" style="v" sid="JHN 13:28" />बाकुन चां खाणो खाणे बठी रवला चेला मायन कुयक बी जी वात समज नी पड़ी की ईसु तीनाक जी वात काहा कह्‌यु। <verse eid="JHN 13:28" /><verse number="29" style="v" sid="JHN 13:29" />यहुदा धड़े थयलि हतली, ने काहनाक-काहनाक ज समज्‌या की ईसु तीनाक ज कह्‌यु हसे की, आपणु तीहवार वाटे ज काय चाहजे च मुल ली लेजे, नी ते गरीबेक आप दे।<verse eid="JHN 13:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 13:30" />अळतेन रुटान कवळ खायलीन यहुदा तत्‌यारुत खयड़े जाती र्‌यु। तीने टेमे रात हय वागली।<verse eid="JHN 13:30" /></para>
  <para style="s">नवली हुकुम</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31" />यहुदाक खयड़े जाणी दीन ईसु कह्‌यु, “हय माणसेन पुर्‌या काजे भगवान पेहलुत सी ईज्‌जत जड़ली छे, ने माणसे अगळ भगवान काजे बी माणसेन पुर्‌यान कामे सी ईज्‌जत जड़ने वाळी छे। <verse eid="JHN 13:31" /><verse number="32" style="v" sid="JHN 13:32" />ने माणसे अगळ माणसेन पुर्‌यान कामे सी भगवान काजे ईज्‌जत जड़से ती भगवान बी माणसेन पुर्‌या काजे सरग वाळु सेक-सींगार पछु आपीन ईज्‌जत करसे ने छाटुस ईज्‌जत करसे। <verse eid="JHN 13:32" /><verse number="33" style="v" sid="JHN 13:33" />ए मारा लाटेक्‌ला पुर्‌या-पारी! मे अळी ईतरीक वार लग तुंद्‌रे पुठ्‌ये छे, अळतेन तुहुंं मेसेक हेरसु ने जसु मे यहुदी मुख्‌याक कहलु, तसु हय मे बी तुहुंंक कहो, जां मे जाणे हींड र्‌यु चां तुहुंंक नी आवाये। <verse eid="JHN 13:33" /><verse number="34" style="v" sid="JHN 13:34" />मे तुहुंंक एक नवलु हुकुम आपो, तुहुंं एक दीसरा पर परम राखु जसु मे तुंद्‌रे पर परम राख्‌यु तसा तुहुंं बी एक दीसरा पर परम राखु। <verse eid="JHN 13:34" /><verse number="35" style="v" sid="JHN 13:35" />कदी तुहुंं एक दीसरा पर परम राखसु ती च देखीन आखा माणसे जाण लेसे की तुहुंं मारा चेला छे।”<verse eid="JHN 13:35" /></para>
  <para style="s">ईसु पतरस सी कहें की तुसे तीन कावा नी जाणो करीन</para>
  <para style="r">(<ref loc="MAT 26:31-35">मत्‌ती 26:31-35</ref>; <ref loc="MRK 14:27-31">मरकुस 14:27-31</ref>; <ref loc="LUK 22:31-34">लुका 22:31-34</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36" />सीमोन पतरस ईसु सी पुछ्‌यु, “ए मालीक।”</para>
  <para style="p" vid="JHN 13:36">“तु कां जाणे हींड र्‌यु?” ईसु पतरस काजे कह्‌यु, “मे जां जाणे हींड र्‌यु चां तुसेक हींताळ नी आवाये बाकुन अळतेन तु चां आवसी।”<verse eid="JHN 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 13:37" />पतरस तीनाक कह्‌यु, ए मालीक! मेसेक हींताळ तु जाय चां काहा नी आवाये? “मे तार वाटे मारु जीव बी आप दीस।”<verse eid="JHN 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 13:38" />ईसु पतरस काजे जपाप आप्‌यु, “तु मारे वाटे आपसु जीव आप देसी काय? मे तुसेक छाची छाचीन ज कहं कुकड़ा वासणेन पेहलुत तु तीन कावा दीसरा अगळ असुत कह्‌सी की मे ईसुक जाणो लग नी।”<verse eid="JHN 13:38" /></para>
  <chapter eid="JHN 13" />
  <chapter number="14" style="c" sid="JHN 14" />
  <para style="s">ईसुत वाट छाचली ने जीवन छे</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1" />“तुंद्‌रु जीव घाबरायणु नी चाहजे। भगवान पर भुरसु करु, ने मारे पर बी भुरसु करु।” <verse eid="JHN 14:1" /><verse number="2" style="v" sid="JHN 14:2" />मारा भगवान बासेन घर मां रहणे करीन बेसकु जागु छे, कदी नी रहतु ती तुहुंंक पेहलुत कय देतु। मे तुंद्‌रे वाटे घरेन तज्‌बु करने करीन जाणे हींड र्‌यु। <verse eid="JHN 14:2" /><verse number="3" style="v" sid="JHN 14:3" />ने मे जाय्‌न तुंद्‌रे वाटे आखो तीयार कर दीस ती तुहुंंक लेणे करीन अळी पछु आवीस। ने तुहुंंक मारेन्‌चां असु करीन ली जायस की जां मे रहो चां तुहुंं बी रहु। <verse eid="JHN 14:3" /><verse number="4" style="v" sid="JHN 14:4" />मे जां जाणे हींड र्‌यु, चां जाणेन वाट तुहुंंक मालुम छे।<verse eid="JHN 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5" />थोमा ईसुक कह्‌यु, “ए मालीक! हामुक ज बी मालुम नी हय की तु कां जाणे हींड र्‌यु ती हामुक चां जाणेन वाट<note caller="+" style="f"><char style="fr" closed="false">14:5 </char><char style="ft" closed="false">मार्ग</char></note> कसा काय जाणसुन?” <verse eid="JHN 14:5" /><verse number="6" style="v" sid="JHN 14:6" />ईसु थोमा काजे कह्‌यु, “वाट, छाचली ने जीवात मेत छे। मारेन्‌चां नी आवे ती तीनाक भगवान बासेन्‌चां नी जावाये।” <verse eid="JHN 14:6" /><verse number="7" style="v" sid="JHN 14:7" />कदी तुहुंं मेसेक उळखी लेता, ती मारा बासेक बी उळखी लेता, “बाकुन ज छाचलीन छे, की तीनाक तुहुंं देखला छे, ने हाय सी मारा भगवान बासेक उळखी बी लेसु।”<verse eid="JHN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 14:8" />फीलीप्‌पुस ईसुक कह्‌यु, “ए मालीक! हामु काजे तारु बास देखाड़ दे, हामरे वाटे अतरोत घणो।”<verse eid="JHN 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 14:9" />ईसु फीलीप्‌पुस काजे कह्‌यु, “ए फीलीप्‌पुस! मे अतरा दाहड़ा लग तुंद्‌रे पुठ्‌ये र्‌यु, ने तेबी तुहुंं मेसेक नी उळखु? जु मेसेक देखलु छे। चु भगवान बास काजे बी देखलु छे। तु असु काहा कह्‌यु की हामु काजे बास देखाड़ दे। <verse eid="JHN 14:9" /><verse number="10" style="v" sid="JHN 14:10" />तुसेक भुरसु नी आवतु काय की भगवान बास मारे मां छे, ने मे भगवानेन बास मां छे, मे जे बुले तुहुंंक कह्‌वो चे बुले मारा नी हय बाकुन बास मारेम रवीन बुले ने मारे सी तेरा मटा काम करे। <verse eid="JHN 14:10" /><verse number="11" style="v" sid="JHN 14:11" />मारी ईनी वात पर भुरसु करु की मे भगवान बास मां छे, ने भगवान बास मारेम छे, कदी मारी ईनी वात पर तुहुंंक भुरसु नी आवतु ती कम सी कम ईना मटा कामे मारे सी हवे। तीनु कामेक देखीन ईनी वात पर भुरसु करु।” <verse eid="JHN 14:11" /><verse number="12" style="v" sid="JHN 14:12" />मे तुहुंं काजे छाचलीन ज कहं, जु मारे पर भुरसु करे, ने च बी मे करो चे काम करसे। मेते भगवान बासेन्‌चां जाणे बाजी र्‌यु। ने मार पर भुरसु करन्‌या ईनु कामे सी बी मटा काम करसे। <verse eid="JHN 14:12" /><verse number="13" style="v" sid="JHN 14:13" />ने तुहुंं ज काय मारे नावे भगवान बास सी दुवा करीन मांग्‌सु, च काम मे करीस तेरेसी पुर्‌यान सी मतलब मारे सी भगवान बासेन ईज्‌जत जड़े। <verse eid="JHN 14:13" /><verse number="14" style="v" sid="JHN 14:14" />तुहुंं ज बी मारे धड़े मार नाव सी दुवा करीन मांग्‌सु च मे काम करीस।<verse eid="JHN 14:14" /></para>
  <para style="s">ईसु चुखला-आत्‌मा काजे मकेलनेन बारामां वात करे</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15" />कदी तुहुंं मारे सी परम करसु ती मारा हुकुम काजे बी पाळसु। <verse eid="JHN 14:15" /><verse number="16" style="v" sid="JHN 14:16" />ने मे बास सी दुवा करीस ने चु तुंद्‌रेन्‌चां मारी आवजी पर एक दीसरु सात देण्‌यु मकलसे चु जलम तुंद्‌रे पुठ्‌ये रवसे। <verse eid="JHN 14:16" /><verse number="17" style="v" sid="JHN 14:17" />मतलब छाचली जीव-आत्‌मा काजे मकलसे। तुहुंं ते तीनाक जाणु, काहाकी चु तुंद्‌रे साते रहे बाकुन आवणे वाळा दाहड़ाम चु तुंद्‌रेत मां रवसे। बाकुन भगवानेन काम रुकण्‌या कळीन माणसे छाचली जीव-आत्‌मा काजे आपसा जीव वाटे जागु नी आपे काहाकी चे तीनाक देख्‌या बी नी ने उळखे बी नी।<verse eid="JHN 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 14:18" />“मे मरीस बाकुन तुहुंं काजे एखला नाखीन नी जाम मे तुंद्‌रेन्‌चां अळी आवीस। <verse eid="JHN 14:18" /><verse number="19" style="v" sid="JHN 14:19" />ईतरीक वार अळतेन ईनी कळीन माणसे जे मारे पर भुरसु नी करे चे मेसेक अळी नी देखे बाकुन तुहुंं मेसेक अळी देखसु मे अळी जीवतु हय जायस ने जीवतेलु रवीस ने तुहुंं बी जीवतेला रवसु। <verse eid="JHN 14:19" /><verse number="20" style="v" sid="JHN 14:20" />मे पछु जीवतु हय जायस तीने दाहड़े तुहुंं समजी जासु की मे मारा बासेम छे, ने तुहुंं मारेम छे, ने मे तुंद्‌रेम छे।<verse eid="JHN 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 14:21" />“तींद्‌रे भीणी मारी हुकुम छे, चु मारी हुकुम जाणे ने तीनुक पाळे, ने चु मारसी परम राखे, तीनाक मारु बास बी परम राख्‌से ने तीनाक मे बी परम करीस ने मे आपसा काजे तेरे अगळ उजेंतु करीस।”<verse eid="JHN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22" />तत्‌यार ईस्‌करीयोती यहुदा नी बाकुन एक दीसरु यहुदा, ईसु काजे पुछ्‌यु “ए मालीक तु हामरे अगळ आपसाक उजेंतु करीस ने ईनी कळीन मनख्‌या पर उजेंतु नी करे?” <verse eid="JHN 14:22" /><verse number="23" style="v" sid="JHN 14:23" />ईसु तीना यहुदा काजे कह्‌यु, “कदी काहनुक मारे सी परम राख्‌से ती चु मारी सीकाड़ली वात काजे मानीन जीवसे ने मारु भगवान बास तेरे सी परम राख्‌से ने हामु तेरेन्‌चां आवसुन ने तीनाम रवसुन। <verse eid="JHN 14:23" /><verse number="24" style="v" sid="JHN 14:24" />जी सीकाड़ली वात तुहुंंक आप्‌यी र्‌यु ची आखी वात सीकाड़ली वात मारे वात मारे वावड़ते नी हय बाकुन मेसेक मकलन्‌या भगवान बास सी छे। चु मारे सी परम राखे चु मारी सीकाड़ली वात काजे मानीन नी जीवे ने मे आपसा काजे तेरे अगळ उजेंतु नी करो।”<verse eid="JHN 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25" />“मे जी आखी वात तुंद्‌रे पुठ्‌ये रय्‌न तुहुंंक कह्‌लु छे। <verse eid="JHN 14:25" /><verse number="26" style="v" sid="JHN 14:26" />बाकुन चु सात देण्‌यु चुखली-आत्‌मा तीनाक भगवान बास मार नाव सी मकेलसे चु तुहुंंक आखी<note caller="+" style="f"><char style="fr" closed="false">14:26 </char><char style="ft" closed="false">सब</char></note> वात सीकाड़से ने ज काय बी मे तुहुंंक कह्‌लु छे, च आखो हेर कराड़से।”<verse eid="JHN 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 14:27" />मे तुहुंंक जीवेन सांती आपीन जाम मारी सांती तुहुंंक आपी जाम, जसा ईनी कळीन माणसे सांती आपे, तसली सांती तुहुंंक नी आप्‌तु; ने तुहुंं तुंद्‌रा जीवेन घुण घाबरायजु ने घुण बीहजु। <verse eid="JHN 14:27" /><verse number="28" style="v" sid="JHN 14:28" />मे जाणे बाजी र्‌यु, मे भगवान बासेन्‌चां जाणे बाजी र्‌यु, चु भगवान बास मारे सी मटु छे, कदी तुहुंं मार सी परम राखु ती जी सामळीन खुस हवजु। <verse eid="JHN 14:28" /><verse number="29" style="v" sid="JHN 14:29" />मे ज आखो हवणेन पेहलुत तुहुंंक कय देदलु छे। मे असु करीन कय देदु की, ज मे कहलु च हय जाय, तत्‌यार तुहुंं मारी वात पर भुरसु करु। <verse eid="JHN 14:29" /><verse number="30" style="v" sid="JHN 14:30" />हय ईनी कळीन मुख्‌यु भुतड़ु मेसेक मारने करीन आवणे बाजी र्‌यु, ने तुंद्‌रे साते जादा वार लग वात नी करो ने चु मेसेक कब्‌जाम नी कर सके। <verse eid="JHN 14:30" /><verse number="31" style="v" sid="JHN 14:31" />तेबी मे तेरा कब्‌जाम हय्‌न मर जाम काहाकी मारा भगवान बासेन जीत मरजी छे; असु करीन की ईनी कळीन माणसे ज जाण लेय की मे बास सी परम राखो ने बास मेसेक ज काय हुकुम आप्‌लु, मे तसु की तसु करो।</para>
  <para style="p" vid="JHN 14:31">उठ! हय आपणु जां सी जाजे।<verse eid="JHN 14:31" /></para>
  <chapter eid="JHN 14" />
  <chapter number="15" style="c" sid="JHN 15" />
  <para style="s">ईसु कह्‌वे मे खरलु अंगुरेन वेलु छे</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1" />ईसु कह्‌यु, “अंगुरेन खरलु वेलु मेत छे। ने ईना अंगुरेन वेलान राखवाळ्‌यु किरसाण<note caller="+" style="f"><char style="fr" closed="false">15:1 </char><char style="ft" closed="false">किसान</char></note> मारु भगवान बास छे।” <verse eid="JHN 15:1" /><verse number="2" style="v" sid="JHN 15:2" />मारा डाळ्‌या मायन जे डाळ्‌या नी फळे, तीनुक मारु भगवान बास काट नाखे। ने जे डाळ्‌या फळे, चे डाळ्‌या अळी बी अदु फळनु चाहजे करीन तीनुक छाटे। <verse eid="JHN 15:2" /><verse number="3" style="v" sid="JHN 15:3" />तुहुंं काजे जी वात सीकाड़लु छे, तीनी वात सी तुहुंं चुखा हय गुयला। <verse eid="JHN 15:3" /><verse number="4" style="v" sid="JHN 15:4" />अळी अळीन फळ लावणे करीन मे तुहुंंक चुखा करलु छे, जीनु डाळ्‌या काजे अंगुरेन वेला मां सी काट नाख्‌या, चे डाळ्‌या मारेम जुड़ायला नी हय, ने चे आपसात नी फळे। तीने रीते मारेम जुड़ायला नी रहे ती फळ बी नी लावे, ने तुहुंं मारेम जुड़ायला रहु ने मे तुंद्‌रेम जुड़ायलु रवीस।<verse eid="JHN 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 15:5" />“चु अंगुरेन वेलु छे, ने तुहुंं मारा डाळ्‌या छे, मार सी छेटे रय्‌न तुहुंं काय बी नी कराये। ने जु मारेम जुड़ायलु रहे ने मे तेरेमां जुड़ायलु रवसे, चु बेसकु फळसे।” <verse eid="JHN 15:5" /><verse number="6" style="v" sid="JHN 15:6" />जे मारेम जुड़ायला नी रहे चे तीनु डाळ्‌यान तसा छे, तीनुक किरसाण काटीन नाख देय ने चे सुक जाय ने किरसाण ईछीन आकठा मां नाख देय ने चे धप जाय। <verse eid="JHN 15:6" /><verse number="7" style="v" sid="JHN 15:7" />कदी तुहुंं मारेम जुड़ायला रवसु ने मारी सीकाड़ली वात काजे मान्‌ता रवसु, ती च बी चाहजे च दुवा करीन मांगजु ने मे तुहुंंक आपी दीस। <verse eid="JHN 15:7" /><verse number="8" style="v" sid="JHN 15:8" />असा करीन तुहुंं बेसका फळ लावसु, ती मारा भगवान बासेन बड़ाय हवसे ने तत्‌यार तुहुंं मारा पक्‌का चेला बण जासु। <verse eid="JHN 15:8" /><verse number="9" style="v" sid="JHN 15:9" />जसु भगवान बास मारे सी परम<note caller="+" style="f"><char style="fr" closed="false">15:9 </char><char style="ft" closed="false">प्रेम</char></note> राखलु छे तसुत मे बी तुंद्‌रे सी परम राखलु छे। तुहुंं मारा ईना परम मां बणीन रवजु। <verse eid="JHN 15:9" /><verse number="10" style="v" sid="JHN 15:10" />मे मारा भगवान बासेन हुकुम पाळतु जाय्‌न तेरा परम मां बणीन रवु, तसात तुहुंं बी मारा हुकुम पाळसु ती मालम पड़से की तुहुंं मारा परम मां बन्‌ला छे।<verse eid="JHN 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 15:11" />मे तुहुंं काजे ज असु करीन कह्‌यु की, तुहुंं काजे मारु हुकुम पाळनेन खुसी जड़ती रवे ने ची खुसी पुरी की पुरी जड़ जाय। <verse eid="JHN 15:11" /><verse number="12" style="v" sid="JHN 15:12" />मारु हुकुम जु छे की जसु मे तुंद्‌रे सी परम करलु, तसा तुहुंं बी एक दीसरा सी परम करता रवजु। <verse eid="JHN 15:12" /><verse number="13" style="v" sid="JHN 15:13" />आपसा दुस्‌तीदार सी परम करीन तींद्‌रे वाटे मरनु आखा सी मटु परम छे। असलु परम सी मटु काहनु बी परम नी हय। <verse eid="JHN 15:13" /><verse number="14" style="v" sid="JHN 15:14" />कदी तुहुंं मारा हुकुम पाळसु ती तुहुंं मारा खरला दुस्‌तीदार<note caller="+" style="f"><char style="fr" closed="false">15:14 </char><char style="ft" closed="false">मित्र</char></note> कहंवायसु। <verse eid="JHN 15:14" /><verse number="15" style="v" sid="JHN 15:15" />पावर्‌या काजे मालम नी पड़े की तेरा मालीकेन मरजी काय छे, ने चु काय करने वाळु छे। बाकुन मे मारा बास सी सामळ्‌ळु च आखो तुहुंंक कय देदलु छे, ने हय सी मे तुहुंंक पावर्‌या नी कहं बाकुन दुस्‌तीदार कहीन। <verse eid="JHN 15:15" /><verse number="16" style="v" sid="JHN 15:16" />“तुहुंं मेसेक नी नेवाड़्‌या, बाकुन मे तुहुंंक नेवाड़ीन तुहुंंक मारे कामे लागाड़लु छे, की तुहुंं मारो नाव लीन भगवान बास सी ज काय दुवा करीन मांगसु च भगवान तुहुंंक आप देसे <verse eid="JHN 15:16" /><verse number="17" style="v" sid="JHN 15:17" />मे तुहुंं काजे जे हुकुम असु करीन आप र्‌यु की, तुहुंं एक दीसरा पर परम राखता रहु।”<verse eid="JHN 15:17" /></para>
  <para style="s">ईनी कळीन माणसे ईसुन चेला काजे वारु नी कह्‌वे</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18" />“कदी ईनी कळीन माणसे तुंद्‌रे पर भुंडा सुचे, ती तुहुंं ज हेर राख्‌जु की तुंद्‌रे सी पेहेल चे मारे पर भुंडा सुचे।” <verse eid="JHN 15:18" /><verse number="19" style="v" sid="JHN 15:19" />कदी तु ईनी कळीन माणसे रहता तत्‌यार चे तुहुंंक आपणा समजीन परम राखता बाकुन मे तुहुंं काजे ईनी कळीन माणसेम सी नेवाड़ लेदलु छे, करीन चे तुंद्‌रे बारामां भुंडा सुचसे। <verse eid="JHN 15:19" /><verse number="20" style="v" sid="JHN 15:20" />मे तुहुंंक जी वात कह्‌यु तीनीक हेर राख्‌जु की, पावर्‌यु आपसा मालीक सी मटु नी हय। मे तुंद्‌रु मालीक छे, तेबी माणसे मेसेक वेला पाड़्‌या असला माणसे तुहुंंक बी वेला पाड़से ईनी कळीम वाळा माणसे मारी सीकाड़ली वात काजे नी मान्‌या ती तुंद्‌री सीकाड़ली वात बी नी माने। <verse eid="JHN 15:20" /><verse number="21" style="v" sid="JHN 15:21" />असला माणसे, मेसेक मकेलन्‌या भगवान काजे नी उळख्‌या, ने मारी वीरुद कर्‌या, तुहुंं ते मारो नाव ली र्‌या ने चे तुहुंं काजे भुंडात करीन तुहुंंक वेला पाड़से। <verse eid="JHN 15:21" /><verse number="22" style="v" sid="JHN 15:22" />कदी मे नी आवतु ने हीनुक पापेन बारामां भगवानेन छाचली वात नी सीकाड़तु, ती हीनुक पाप नी लागतु बाकुन हय ते हींद्‌रे धड़े आपसा पापेन बारामां ढंगड़ा करनेन मुखु नी हय। <verse eid="JHN 15:22" /><verse number="23" style="v" sid="JHN 15:23" />जु मेसेक भुंडु समजे, चु मारा भगवान बास काजे भुंडु समजे। <verse eid="JHN 15:23" /><verse number="24" style="v" sid="JHN 15:24" />कदी मे तींद्‌रे अगळ चे मटा कामे नी करतु, चे कामे कुय बी दीसरु कदी नी कर्‌यु, ती तीनुक पाप नी लाग्‌तु बाकुन हय ते चे असा काम देखीन बी मेसेक नी मान्‌या ने सांबा मार भीणी ने मारा भगवान बास काजे भुंडा करला छे। <verse eid="JHN 15:24" /><verse number="25" style="v" sid="JHN 15:25" />ज असो काहा हयो काहाकी खरला सास्‌तुर मां लिखलो हतलो च पुरो हवे चां असो लिखलो छे, की चे माणसे फालतु मां मारा वेरी बण गुयला छे।<verse eid="JHN 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 15:26" />मे तुंद्‌रेन्‌चां सात देण्‌या काजे मतलब छाचली जीव-आत्‌मा काजे भगवान बासेन चां सी मकलीस, जत्‌यार चु छाचली जीव-आत्‌मा भगवान बासेम सी आवसे ती चु मारे बारामां गवा देसे। <verse eid="JHN 15:26" /><verse number="27" style="v" sid="JHN 15:27" />ने तेरे पुठ्‌ये तुहुंं बी मारी गवाय देसु काहाकी तुहुंं सुरु सीत मारे पुठ्‌ये रवला छे।<verse eid="JHN 15:27" /></para>
  <chapter eid="JHN 15" />
  <chapter number="16" style="c" sid="JHN 16" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1" />“मे तुहुंं काजे जी आखी वात असु करीन कह्‌लु, छे की जत्‌यार माणसे तुहुंंक वेला पाड़से, तत्‌यार तुहुंं मार पर भुरसु छुड़ीन भटकाड़्‌यु घुण। <verse eid="JHN 16:1" /><verse number="2" style="v" sid="JHN 16:2" />माणसे तुहुंं काजे तुंद्‌रा भक्‌तीन घर मां सी नीकाळीन बाहर कर देसे, ने छाचलीन जी टेम आवणे बाजी रय की, माणसे ज समजीन तुहुंंक मारसे की हामु ईनुक मारीन भगवानेन सेवा चाकरी कर र्‌या। <verse eid="JHN 16:2" /><verse number="3" style="v" sid="JHN 16:3" />छाचलीन चे भगवान बासेक बी नी उळखे, ने मेसेक बी नी उळखे, ने चे तुंद्‌रे साते असा वेहवार करसे। <verse eid="JHN 16:3" /><verse number="4" style="v" sid="JHN 16:4" />मे तुहुंंक जी आखी वात असु करीन कह्‌लु छे, की जत्‌यार चे तुहुंंक वेला पाड़से, ती तुहुंं काजे आखी वात हेर<note caller="+" style="f"><char style="fr" closed="false">16:4 </char><char style="ft" closed="false">स्मरण</char></note> आवणु चाहजे की, मे तुहुंंक जी वात पेहलुत कयदीन काठु करलु छे।” अतरा दाहड़ा मे तुंद्‌रे पुठ्‌ये हतलु करीन मे जी आखी वात सुरु मां नी कह्‌यु।<verse eid="JHN 16:4" /></para>
  <para style="s">चुखली-आत्‌मान कामेन बारामां ईसु बताड़े</para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 16:5" />बाकुन हाय मे तेरेन्‌चां जाणे हींडी र्‌यु, जु मेसेक मकेल्‌लु छे, ने तुंद्‌रे मायन काहनुक मेसेक बी छाचे मने ज नी पुछतु की तु कां जाणे हींड र्‌यु? <verse eid="JHN 16:5" /><verse number="6" style="v" sid="JHN 16:6" />मे तुहुंंक जी आखी वात कय देदु, करीन तुंद्‌रो मन सुच मां पड़ गुयो, ने तुहुंं मेसेक नी पुछता। <verse eid="JHN 16:6" /><verse number="7" style="v" sid="JHN 16:7" />बाकुन मे तुहुंंक छाचलीन कह्‌वो की, मे जाती रय्‌स ती तुंद्‌रे वाटे वारु रवसे काहाकी मे नी जाम ती तुहुंंक सात देण्‌यु तुंद्‌रेन्‌चां नी आवे बाकुन मे जायस ती तीना सात देण्‌या काजे तुंद्‌रेन्‌चां मकली दीस। <verse eid="JHN 16:7" /><verse number="8" style="v" sid="JHN 16:8" />जत्‌यार चु सात देण्‌यु चुखली-आत्‌मा आवसे ती ची ईनी कळीन माणसेक तींद्‌रा पापेन बारामां ने तींद्‌रा धरमेन बारामां ने तींद्‌रा नीयावेन बारामां पुरावु भेळु गुनु देखाड़ीन समजाड़से। <verse eid="JHN 16:8" /><verse number="9" style="v" sid="JHN 16:9" />कळीन माणसे मारे पर भुरसु नी करता, करीन चुखली-आत्‌मा तींद्‌रा पापेन बारामां तीनुक पुरावा भेळु गुनु समजाड़से। <verse eid="JHN 16:9" /><verse number="10" style="v" sid="JHN 16:10" />मेते भगवान बासेन्‌चां जाणे हींड र्‌यु, ने जत्‌यार मे जाती रय्‌स ती तुहुंं मेसेक नी देखु मारी आवजी पर चुखली-आत्‌मा तुंद्‌रे पुठ्‌ये रय्‌न कळीन माणसेक तींद्‌रा झुटा धरमेन बारामां पुरावा भेळु गुनु देखाड़ीन समजाड़से। <verse eid="JHN 16:10" /><verse number="11" style="v" sid="JHN 16:11" />ईनी कळीन मुख्‌यु भुतड़ान नीयाव हय गुयला छे ने तेरा पापेन डंड तीनाक छाटुस भुकेतणु पड़से ने चुखली-आत्‌मा कळीन माणसेक बी तींद्‌रा झुटा नीयावेन बारामां पुरावु भेळ गुनु देखाड़ीन समजाड़से।<verse eid="JHN 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 16:12" />तुहुंंक कहंणे करीन अळी बेसकी वात मारा मन मां आय रय बाकुन हींताळ कयस ती तुहुंंक वेठाये नी। <verse eid="JHN 16:12" /><verse number="13" style="v" sid="JHN 16:13" />जत्‌यार चु छाचलीन जीव-आत्‌मा आवसे, ती चु तुहुंंक भगवानेन आखी छाचली वाटे ली जाणे अगवाय करसे काहाकी चु आपसे आवड़ते काय बी नी कह्‌वे, बाकुन चु ज काय मारे सी सामळसे चत कवसे ने आवणे वाळी वातेन बारामां बी तुहुंंक देखाड़से। <verse eid="JHN 16:13" /><verse number="14" style="v" sid="JHN 16:14" />चु मारी सेक-सींगार करसे, काहाकी ज काय मारो छे च बताड़से, ने आखी चीज जी बासेन छे ची मारी छे। <verse eid="JHN 16:14" /><verse number="15" style="v" sid="JHN 16:15" />तेरेमां मे कह्‌यु की ज काय भगवान बासेन छे, च आखो मारो छे चु तीनाक लेसे ने तुहुंंक बताड़से।<verse eid="JHN 16:15" /></para>
  <para style="s">ईसुन चेलान दुख खुसी मां बदली जासे</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16" />“ईसु आपसा चेलाक पेहलुत सी कह्‌तु गुयु, ईतरीक वार मां तुहुंं मेसेक नी देखु ने अळी ईतरीक वार मां मेसेक देख्‌सु।”<verse eid="JHN 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17" />ने ईसुन चेला मायन ईतराक चेला आपसा आपसात कह्‌या, “हयु आपणुक काय कय र्‌यु, च आपणुक समज मां नी आवतो हयु कह्‌यु की ईतरीक वार मां तुहुंं मेसेक नी देखु ने अळतेन अळी ईतरीक वार मां तुहुंं मेसेक देखसु चु ईतरीक वार पेहेले असु बी कह्‌लु, काहाकी मे भगवान बासेन चां जाणे हींडी र्‌यु।” ईनी दुय वातेन मतलब काय छे। <verse eid="JHN 16:17" /><verse number="18" style="v" sid="JHN 16:18" />चे कह्‌या हयु ईतरीक वार मां कहें च काय कहंवाये हामुक समज मां नी आवतो की हयु हामुक काय कय र्‌यु।<verse eid="JHN 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 16:19" />ईसु ज जाण लेदु की हया मेसेक मारी ईनीक वातेक लीन सवाल पुछणे हींडे की ईतरीक वार मां तुहुंं मेसेक नी देखु, ने अळी ईतरीक वार मां तुहुंं मेसेक देख्‌सु करीन ईसु तीनुक कह्‌यु, “तुहुंं आपसा-आपसा मारी ईनी वातेन बारामां वीच्‌यार काहा कर र्‌या? <verse eid="JHN 16:19" /><verse number="20" style="v" sid="JHN 16:20" />मे तुहुंंक छाची छाचीन ज कहं, ईतरीक वार मां तुहुंं रड़सु ने कलेपसु बाकुन ईनी कळीन माणसे खुस हवसे, ने हय तुहुंं दुखी हवसु ते खरा बाकुन अळतेन तुहुंं दुखी हवणु रहणीदीन खुस हय जासु।” <verse eid="JHN 16:20" /><verse number="21" style="v" sid="JHN 16:21" />“भारीस बायर फवरी हवणे वेळाय बेसकी वेला करीन कलपे, बाकुन जत्‌यार ची फवरी हय जाय ती, बेसकी खुस हवे। हय ईनी कळी मां एक पुर्‌यु पयदा<note caller="+" style="f"><char style="fr" closed="false">16:21 </char><char style="ft" closed="false">उत्पन्न</char></note> हवलु, करीन ची एक वेलान वात काजे ईसरी जाय।” <verse eid="JHN 16:21" /><verse number="22" style="v" sid="JHN 16:22" />असात हय ते तुहुंं बी दुखी छे, बाकुन मे अळी तुहुंंक भेळु हय्‌स तत्‌यार तुंद्‌रा मन मां खुसी आय जासे, ने तुंद्‌री खुसी तुंद्‌रे सी कुय सी नी हापकाये।<verse eid="JHN 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 16:23" />तीने दाहड़े तुहुंं मारे सी काय बी नी पुछु मे तुहुंं काजे छाची-छाची कह्‌वो, कदी तुहुंं भगवान बास सी मारे नावे दुवा करीन काय बी मांगसु, ती चु तुहुंं काजे आपसे। <verse eid="JHN 16:23" /><verse number="24" style="v" sid="JHN 16:24" />आज लग तुहुंं मारे नावे दुवा करीन काय बी नी मांग्‌या। मांगसु, ती भगवान तुहुंंक आपसे, असु करीन की तुंद्‌री खुसी पुरी हय जाय।<verse eid="JHN 16:24" /></para>
  <para style="s">ईसु कळीक जीत लेदु</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25" />“मे तुहुंं काजे जी आखी वात दाखलु दीन कह्‌लु छे। असी टेम आवणे बाजी रय की मे तुहुंं काजे अळी दाखलु दीन वात नी बताड़ो, बाकुन भगवान बासेन बारामां वात खुलीन बताड़ीस। <verse eid="JHN 16:25" /><verse number="26" style="v" sid="JHN 16:26" />तीने दाहड़े तुहुंं मारे नाव सी मांगसु ने मे तुंद्‌रे सी ज नी कवतु की मे तुंद्‌रे वाटे भगवान बास सी दुवा कर्‌यु। <verse eid="JHN 16:26" /><verse number="27" style="v" sid="JHN 16:27" />बाकुन भगवान बास आपसुत तुंद्‌रे सी परम करे, काहाकी तुहुंं मारे सी परम राखु ज भुरसु कर लेदला छे की मे भगवान बासेम सी आयु। <verse eid="JHN 16:27" /><verse number="28" style="v" sid="JHN 16:28" />मे भगवान बास सी नीकळीन कळी मां आय गुयु, ने अळी पछु कळी काजे छुड़ीन भगवान बास भीणी जाणे बाजी र्‌यु।”<verse eid="JHN 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29" />ईसुन चेला ईसु काजे कह्‌या, “देख, तु हय दाखलु दीन नी कवतु बाकुन चुखो झण कह्‌णे बाजी र्‌यु। <verse eid="JHN 16:29" /><verse number="30" style="v" sid="JHN 16:30" />हय हामु समजी गुयला छे की, तु आखो काय जाणे। हामु तुसेक ज पुछणे हींड र्‌या तीनी वातेक बी तु पेहल सीत जाणी लेय ने तु जी हेर नी करतु की कुय तुसेक पुछणु चाहजे, तारेम काय बी कसर नी हय ने हामु भुरसु करजे की तु भगवान बास सी आवलु छे।”<verse eid="JHN 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 16:31" />ईसु तीनु काजे कह्‌यु, “काय तुहुंं हय भुरसु करु? <verse eid="JHN 16:31" /><verse number="32" style="v" sid="JHN 16:32" />बाकुन देखु! असी टेम आवणे बाजी रय ने आय गुयली छे, जत्‌यार तुहुंं आखा की आखा रावण्‌या-तीवण्‌या हय जासु ने मेसेक एखलुत छुड़ीन जाती रवसु। तेबी मे एखलु नी हय काहाकी भगवान बास मार पुठ्‌ये छे।” <verse eid="JHN 16:32" /><verse number="33" style="v" sid="JHN 16:33" />“हय, ईनी कळी मां तुहुंंक वेला करनु पड़से तेबी काठु जीव करजु, मे ईनी कळीक जीत लेदलु छे। मे तुहुंं काजे जी आखी वात असु करीन कह्‌लु छे की, आवणे वाळा दाहड़ाम दुख झेलता जाय्‌न बी तुहुंं मारेम छे ची सांती हात कर लेय।”<verse eid="JHN 16:33" /></para>
  <chapter eid="JHN 16" />
  <chapter number="17" style="c" sid="JHN 17" />
  <para style="s">ईसु आपसा वाटे दुवा करे</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1" />जी वात कयदीन ईसु सरग भीणी भाळीन कह्‌यु, “ए मारा भगवान बास! तारा पुर्‌यान मरनेन घड़ी आय गुयली छे। ने तारा पुर्‌यान सेक-सींगार उजेंतु कर तेरे सी तारु पुर्‌यु बी तारु सेक-सींगार उजेंतु कर देय। <verse eid="JHN 17:1" /><verse number="2" style="v" sid="JHN 17:2" />तु ते तारा पुर्‌या काजे आखा माणसे पर हक आपलु छे, की तीना हक सी चु आखा माणसेन ईचमां तारु सेक-सींगार उजेंतु करे ने तींद्‌रेम सी जत्‌यार बी माणसे तु तेरा हाते सुपलु छे, तीनु आखा काजे चु अमर जीवाय आप देय। <verse eid="JHN 17:2" /><verse number="3" style="v" sid="JHN 17:3" />एकुत छाचलु भगवान तुत छे, ने मे ईसु तारे सी मकेल्‌लु छुड़ावन्‌यु मसी छे, तुसेक ने मेसेक जाणीन मान्‌ने सीत माणसेक अमर जीवाय जड़से। <verse eid="JHN 17:3" /><verse number="4" style="v" sid="JHN 17:4" />ज काम तु मेसेक करने करीन आपलु हतलु, च काम करीन धरती पर तारो सेक-सींगार काजे उजेंतु करलु छे। <verse eid="JHN 17:4" /><verse number="5" style="v" sid="JHN 17:5" />ए भगवान! कळी नी घड़ाय ने पेहलुन, मे तारे पुठ्‌ये हतलु, ने मे नी तारेन तसु सेक-सींगार मां हतलु हय मेसेक तीना सेक-सींगार मां पछु भेसकी ले।”<verse eid="JHN 17:5" /></para>
  <para style="s">ईसु आपसा चेला वाटे दुवा करे</para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 17:6" />तीनु माणसे काजे तु ईनी कळीम सी नेवाड़ीन मेसेक सुपलु चे तींद्‌रे अगळ मे तारो नाव उजेंतु कर देदलु छे, छाचलीन चे माणसे तारात हतला, ने तु तीनु काजे मार हातेम सुप देदु, ने चे तारा बुल काजे मानीन पाळ र्‌या। <verse eid="JHN 17:6" /><verse number="7" style="v" sid="JHN 17:7" />हय चे जाण गुया की ज काय तु मेसेक देदलु छे, च आखो तारो छे। <verse eid="JHN 17:7" /><verse number="8" style="v" sid="JHN 17:8" />काहाकी ज बुले तु मेसेक देदलु, ने चे बुले तीनुक बी सामळाय देदु, ने चे मान लेदा ने छाची-छाची जाण लेदा की मे तारे सी आय र्‌यु ने भुरसु कर लेदा की तुत मेसे काजे मकल्‌यु।<verse eid="JHN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 17:9" />हींद्‌रे वाटे मे जी दुवा करो ची दुवा तु सामळी ले, मे कळीन माणसे वाटे दुवा नी करतु, बाकुन तींद्‌रे वाटे करो जीनुक तु मारे हातेम सुपलु छे काहाकी चे तारात छे। <verse eid="JHN 17:9" /><verse number="10" style="v" sid="JHN 17:10" />छाचलीन ज काय मारो छे च तारो छे, ने ज तारो छे च मारो छे। ने हींद्‌रे सी मारु सेक-सींगार उजेंतु हवलु छे। <verse eid="JHN 17:10" /><verse number="11" style="v" sid="JHN 17:11" />“मे ईनी कळीक छुड़ीन तारेन चां आवणे हींड रयु, बाकुन हय जे चेला कळीत मां रवसे।” ए चुखला भगवान बास! तु ज नाव मेसेक आपलु छे तीने नावे हींद्‌री राखवाळी करो, तेरेसी चे आपणेन तसा एक हय जाय। <verse eid="JHN 17:11" /><verse number="12" style="v" sid="JHN 17:12" />जत्‌यार लग मे हींद्‌रे साते हतलु, तत्‌यार लग तारा नाव सी हींद्‌री पुरी राखवाळी करतु रयु। तींद्‌रे मायन कुय बी ठायकुत नी सर्‌यु बाकुन एकुत जणु ठायकुत सर गुयु, जु सरने वाळु हतलु। खरला-सास्‌तुर मां लिखली वात पुरी हवणु चाहजे करीन असो हयो। <verse eid="JHN 17:12" /><verse number="13" style="v" sid="JHN 17:13" />हय मे तारेन चां आवणे हींडी र्‌यु ने मे जी दुवा ईनी कळीम रय्‌न करने बाजी र्‌यु, तेरसी जी खुसी मारेम छे, ची खुसी जे चेला पुरी की पुरी हात करे। <verse eid="JHN 17:13" /><verse number="14" style="v" sid="JHN 17:14" />मे तारी बुल हीनुक कय देदलु छे ने भगवानेन काम रुकण्‌या काजे ईनी कळीन माणसे हीनु काजे भुंडा कर्‌या काहाकी जसु मे ईनी कळीन माणसे साते संगात नी करो, तसात चे चेला बी ईनी कळीन माणसे साते सात संगात नी करे। <verse eid="JHN 17:14" /><verse number="15" style="v" sid="JHN 17:15" />मे जी दुवा नी करतु की तु हीनु काजे कळी मां सी ली जाती रहे, बाकुन ज कहो की हीनु काजे भुंडात कामे सी बचाड़ीन राख। <verse eid="JHN 17:15" /><verse number="16" style="v" sid="JHN 17:16" />जसु मे ईनी कळीन नी हय तसात चे बी ईनी कळीन नी हय। <verse eid="JHN 17:16" /><verse number="17" style="v" sid="JHN 17:17" />ए भगवान बास तारा बुल चुखला छे ईना छाचला बुल सी ईनुक तारी सेवा वाटे चुखा करीन तीयार कर। <verse eid="JHN 17:17" /><verse number="18" style="v" sid="JHN 17:18" />जसु तु मेसेक ईनी कळीन चाकरीन हक आपीन मकेल्‌लु छे, तसुत मे बी ईनुक ईनी कळीन चाकरीन हक आपीन मकेल्‌लु छे। <verse eid="JHN 17:18" /><verse number="19" style="v" sid="JHN 17:19" />ने हींद्‌रा फायदा वाटे मे मारु जीव आपीन आपसाक नेवाड़ीन चुखु करो, काहाकी चे बी तारा छाचला बुले सी तारी सेवा वाटे नेवाड़ीन चुखा हय्‌न तीयार हय जाय।<verse eid="JHN 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 17:20" />“मे हींद्‌रे वाटे अतरुत दुवा नी करतु, बाकुन तींद्‌रे वाटे बी दुवा कर र्‌यु, जे आवणे वाळा दाहड़ाम हींद्‌री वात सामळीन मार पर भुरसु करसे। <verse eid="JHN 17:20" /><verse number="21" style="v" sid="JHN 17:21" />मे तींद्‌रे वाटे असी दुवा करो की चे आखा एक मन हय्‌न एक सारका हय जाय करीन। ए भगवान बास! जसु तु मारेम छे, ने मे तारेम छे, तसात चे बी आपणेम भेसकायन एक सारका हय जाय काहाकी ईनी कळीन माणसे तीनुक देखीन असु भुरसु कर लेय की ईसुत भगवानेन मकेलन्‌यु छुड़ावन्‌यु मसी छे। <verse eid="JHN 17:21" /><verse number="22" style="v" sid="JHN 17:22" />ने जु सेक-सींगार तु मेसेक आप्‌यु, चु सेक-सींगार मे तीनुक आप देदलु छे, काहाकी चे आखा एक मन हय्‌न एक सारका हय जाय जसा आपणु एक सारका छे। <verse eid="JHN 17:22" /><verse number="23" style="v" sid="JHN 17:23" />मे तींद्‌रेम रवु, ने तु मारेम रहे ने चे आखा ने आखा एक सारका हय जाय ने ईनी कळीन माणसे ज जाण लेय की ईसु भगवानेन मकेल्‌लु मसी छे, ने जसु तु मार सी परम कर्‌यु तसु तु बी तीनुक परम करे।”<verse eid="JHN 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 17:24" />“ए भगवान बास! जी कळी नी घड़ाय ने पेहलुत मारे सी परम राखलु छे, ने सेक-सींगार आपलु छे। जे माणसे तु मेसेक आपलु छे, चे बी मे जां रहो चां रहणु चाहजे काहाकी चे बी मारु सेक-सींगार देखे। <verse eid="JHN 17:24" /><verse number="25" style="v" sid="JHN 17:25" />ए धरमी भगवान बास! ईनी कळीन माणसे तुसे नी जाणता बाकुन मे तुसेक जाणो ने मारा चेला जाण लेदला छे, ईसु भगवानेन मकेल्‌लु मसी छे। <verse eid="JHN 17:25" /><verse number="26" style="v" sid="JHN 17:26" />मे तारो नाव ईनुक बताड़ देदु ने बताड़तु रय्‌स, काहाकी जसु तु मेसेक मारे सी परम करलु, चु परम हींद्‌रेम रव ने मे हींद्‌रेम रहो।”<verse eid="JHN 17:26" /></para>
  <chapter eid="JHN 17" />
  <chapter number="18" style="c" sid="JHN 18" />
  <para style="s">ईसुन धरायणु</para>
  <para style="r">(<ref loc="MAT 26:47-56">मत्‌ती 26:47-56</ref>; <ref loc="MRK 14:43-50">मरकुस 14:43-50</ref>; <ref loc="LUK 22:47-53">लुका 22:47-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1" />ईसु आपसा भगवान बास धड़े दुवा करीन नवराय गुयु, ने तेरा चेला पुठ्‌ये एक खुदराक एणकीन एक वाड़ी मां गुयु। तीना खुदरान नाव कीदरोन हतलो। <verse eid="JHN 18:1" /><verse number="2" style="v" sid="JHN 18:2" />ईसु आपसा चेला पुठ्‌ये ईनी वाड़ी मां एकदम जाया करतेलु। ने ईसुक धुकुदीन धराड़ने वाळु चेलु यहुदा, बी ईनी वाड़ीक देख रवलु। <verse eid="JHN 18:2" /><verse number="3" style="v" sid="JHN 18:3" />अळतेन यहुदा, रोमी सीपायड़ान टुळा काजे लीन, ने मंदीरेन डाहला पुजारा ने फरीसी माणसेन साहरे मकेल्‌ला मंदीरेन राखवाळ्‌या सीपायड़ा काजे लीन तीनी वाड़ी मां आय गुयु। चे कंदल्‌या, बेर्‌या ने हत्‌यार लीन आवला। <verse eid="JHN 18:3" /><verse number="4" style="v" sid="JHN 18:4" />मारे पर काय-काय वीतसे च आखो जाणीन ईसु अघु गुयु। ने तीनु काजे कह्‌यु, “तुहुंं कुणीक हेर र्‌या?” <verse eid="JHN 18:4" /><verse number="5" style="v" sid="JHN 18:5" />चे तीनाक जपाप आप्‌या “ईसु नासरी काजे, ईसु तीनुक कह्‌यु मे छे।” तीनाक धराड़ने वाळु यहुदा बी तींद्‌रे धड़े उबु हय रवलु। <verse eid="JHN 18:5" /><verse number="6" style="v" sid="JHN 18:6" />जत्‌यार ईसु कह्‌यु की, “मेत छे” ती चे पछास हय्‌न धरती पर हीट पड़्‌या। <verse eid="JHN 18:6" /><verse number="7" style="v" sid="JHN 18:7" />ईसु तीनुक अळी पुछ्‌यु, “तुहुंं कुणीक हेर र्‌या?” चे कह्‌या, “नासरत सहर वाळा ईसु नासरी काजे हेर र्‌या।”<verse eid="JHN 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 18:8" />ईसु जपाप आप्‌यु मे तुहुंं काजे पेहलुत कय देदु की चु मे हयुत छे, “कदी तुहुंं मेसेक हेर र्‌या ती तुहुंं मारा ईनु चेला काजे जाणी देवु।” <verse eid="JHN 18:8" /><verse number="9" style="v" sid="JHN 18:9" />ज असो काहा हयो की ज चु कह्‌यु पुरो हवणु चाहजे, “तीनुक चु मारे सुपरुत करलु छे, मे तीनु मायन एक काजे बी खुवायणी नी दम।”<verse eid="JHN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10" />तत्‌यार सीमोन पतरस आपसी तलवार मीयान मां सी नीकाळीन मंदीरेन डाहला पुजारा मुख्‌यान पावर्‌यान देदु। ने तेरो जेवड़्‌यु कान्‌टु काट नाख्‌यु तीना पावर्‌यान नाव मलखुस हतलो। <verse eid="JHN 18:10" /><verse number="11" style="v" sid="JHN 18:11" />ने ईसु पतरस काजे कह्‌यु, “तलवार मीयान मां पछी भर ले। ज दुखेन पीयालु भगवान बास मेसेक पीणे करीन आप्‌लु छे च दुखेन पीयालु मां पीये करीन तु अड़चन काहा नाख र्‌यु?”<verse eid="JHN 18:11" /></para>
  <para style="s">ईसु काजे हन्‌ना अगळ धरीन लावे</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12" />अळतेन रोमी सीपायड़ान टुळु, ने तींद्‌रु सुबेदार, ने यहुदी डाहला सी मकेल्‌लु मंदीरेन राखवाळ्‌या सीपायड़ा ईसु काजे धरीन बांद लेदा। <verse eid="JHN 18:12" /><verse number="13" style="v" sid="JHN 18:13" />ने ईसु काजे धरीन पेहेल मेहेल ते हन्‌ना धड़े लीजा, जु मंदीरेन डाहला पुजारान मुख्‌यी पुजारु हतलु, काहाकी चु हन्‌ना, काइफान सेसरुस हतलु, चु काइफा तीने साल मंदीरेन डाहला पुजारान मुखी हतलु। <verse eid="JHN 18:13" /><verse number="14" style="v" sid="JHN 18:14" />जु हयुत काइफा हतलु, चु यहुदी मुख्‌याक असु कय्‌न अगवाय करलु की आपणा माणसे भीणी एक माणुस मरनु वारु छे।<verse eid="JHN 18:14" /></para>
  <para style="s">पतरस ईसु काजे नी उळखो करीन कवे</para>
  <para style="r">(<ref loc="MAT 26:69">मत्‌ती 26:69</ref>,<ref loc="MAT 26:70">70</ref>; <ref loc="MRK 14:66-68">मरकुस 14:66-68</ref>; <ref loc="LUK 22:55-57">लुका 22:55-57</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15" />सीमोन पतरस ने एक अळी दीसरु चेलु ईसुन पछळ-पछळ चाल पड़्‌यु, चु दीसरु चेलु डाहला पुजारान मुख्‌यु हन्‌नान उळखायतु हतलु, ने चु चेलु ईसु पुठ्‌ये मंदीरेन डाहला पुजारान मुखीन घरेन आंगणाम लग गुयु, हीनाक कुय बी नी रुक्‌यो। <verse eid="JHN 18:15" /><verse number="16" style="v" sid="JHN 18:16" />बाकुन पतरस झपले उबु रय गुयु, ने डाहला पुजारान उळखायतु, चु दीसरु चेलु तीने आंगणे सी पछु खयड़े जाय्‌न झपलान राखवाळ्‌या काजे पुछीन पतरस काजे माहें आंगणाम ली आयु। <verse eid="JHN 18:16" /><verse number="17" style="v" sid="JHN 18:17" />ची झपलान राखवाळी पावरनी पतरस काजे कह्‌यी, “तु बी तीनु ईसुन चेला मायन नी हय काय?” पतरस कह्‌यु, “नी हय।”<verse eid="JHN 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 18:18" />सींगेन दाहड़ा हतला, ने घरेन पावर्‌या ने मंदीरेन राखवाळ्‌या सीपायड़ा आकठे तापणे बाजी रवला ने पतरस बी तींद्‌रे पुठ्‌ये तापतेलु।<verse eid="JHN 18:18" /></para>
  <para style="s">मंदीरेन जुन्‌लु मुखी पुजारु ईसु सी पुछताछ करे</para>
  <para style="r">(<ref loc="MAT 26:59-66">मत्‌ती 26:59-66</ref>; <ref loc="MRK 14:55-64">मरकुस 14:55-64</ref>; <ref loc="LUK 22:66-71">लुका 22:66-71</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19" />अळतेन मंदीरेन डाहला पुजारान मुखी हन्‌ना ईसु काजे चेलान बारामां ने तेरी सीकाड़ली वातेन बारामां पुछ्‌यु। <verse eid="JHN 18:19" /><verse number="20" style="v" sid="JHN 18:20" />ईसु जपाप आप्‌यु, “मे मनेन काय बी, नी सीकाड़्‌यु, मे माणसे अगळ उजेंतु कळी मां सीकाड़लु छे; ने मे जलम तुंद्‌रा भक्‌तीन घर मां ने मंदीर मां जां आखा यहुदी भेळा हया करे चां सीकाड़तु रयु। <verse eid="JHN 18:20" /><verse number="21" style="v" sid="JHN 18:21" />ती तु मेसेक काहा पुछ र्‌यु? सामळन्‌याक असु पुछु की, हयु तुहुंंक काय सीकाड़लु छे मे तीनुक काय कहंलु तीनुक मालुम छे।”<verse eid="JHN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 18:22" />जत्‌यार ईसु जी वात कह्‌यु ती चां उबा हय रवला मंदीरेन राखवाळ्‌या सीपायड़ा मायन एक जणु ईसुन एक थापड़<note caller="+" style="f"><char style="fr" closed="false">18:22 </char><char style="ft" closed="false">थप्पड़</char></note> देदु। ने कह्‌यु, “तु ते मंदीरेन मुखी पुजारा काजे असु जपाप काहा दी र्‌यु?” <verse eid="JHN 18:22" /><verse number="23" style="v" sid="JHN 18:23" />ईसु तीनाक जपाप आप्‌यु, “कदी मे काय गलत वात कह्‌यु हय, ती पुरावु दीन देखाड़; बाकुन छाचली वात कह्‌यु हय ती मारे काहा देय?” <verse eid="JHN 18:23" /><verse number="24" style="v" sid="JHN 18:24" />अळतेन हन्‌ना ईसु काजे असुत बांदायलुत मंदीरेन डाहला पुजारान मुखी काइफान्‌चां मकली देदु।<verse eid="JHN 18:24" /></para>
  <para style="s">पतरस ईसुन बारामां नी जाणो करीन कह्‌वे</para>
  <para style="r">(<ref loc="MAT 26:71-75">मत्‌ती 26:71-75</ref>; <ref loc="MRK 14:69-72">मरकुस 14:69-72</ref>; <ref loc="LUK 22:58-62">लुका 22:58-62</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25" />तीने टेमे सीमोन पतरस, आकठा धड़े उबु-उबु तापणे बाजी रवलु। तत्‌यार थुड़ाक माणसे पतरस काजे कह्‌या, “तु बी तेरा चेला मायन एक छे काय?” पतरस ईसुन नीकारु करतु जाय्‌न कह्‌यु मे नी हय।<verse eid="JHN 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 18:26" />मंदीरेन मुखी पुजारान एक पावर्‌यु, चु तीना पावर्‌यान दुस्‌ती बी हतली, तेरु कान्‌टु<note caller="+" style="f"><char style="fr" closed="false">18:26 </char><char style="ft" closed="false">कान</char></note> पतरस काट नाखलु, “चु पतरस काजे कह्‌यु मे तुसेक तीना ईसु पुठ्‌ये वाड़ी मां देखलु?” <verse eid="JHN 18:26" /><verse number="27" style="v" sid="JHN 18:27" />पतरस ईसुन अळी नीकारु करतु जाय्‌न कह्‌यु, “मे नी हय” ने तत्‌यारुत कुकड़ु वास देदु।<verse eid="JHN 18:27" /></para>
  <para style="s">ईसु काजे पीलातुस अगळ उबु करे</para>
  <para style="r">(<ref loc="MAT 27:1">मत्‌ती 27:1</ref>,<ref loc="MAT 27:2">2</ref>,<ref loc="MAT 27:11-14">11-14</ref>; <ref loc="MRK 15:1-5">मरकुस 15:1-5</ref>; <ref loc="LUK 23:1-5">लुका 23:1-5</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28" />अळतेन यहुदी मुख्‌या ने डाहला पुजारा ईसु काजे काइफान घर मां सी रोमी सरकारेन यरुसलेम राजवाड़ान हवेली वाळा कीलान आंगणाम ली गुया, ने तीने टेमे काय संदारो हय वाग्‌लो ईना रोमी राजवाड़ान राज करन्‌यु पीलातुस नी भुरसु वाळा यहुदी आड़जात्‌या बी हतला, ने यहुदी मुख्‌या ने पुजारा वीच्‌यार कर्‌या की हामु ईना आड़जात्‌या पीलातुसेन हवेली मां भरायसु ती हामु वीटळी जासुन। ने हामुक हामरा फसह तीहवारेन खाणो नी खावाये करीन चे यहुदी मुख्‌या ने पुजारा तीनी हवेली मां नी भराय। <verse eid="JHN 18:28" /><verse number="29" style="v" sid="JHN 18:29" />ने राज करन्‌यु पीलातुस हवेलीम सी बाहर नीकळीन तींद्‌रे अगळ आयु ने कह्‌यु, “तुहुंं ईना माणुस पर काहनु गुनु लागाड़ र्‌या?” <verse eid="JHN 18:29" /><verse number="30" style="v" sid="JHN 18:30" />चे जपाप आप्‌या, “कदी जु गुनाळु नी रहतु, ती हामु हीनाक तारेन चां नी लावता।”<verse eid="JHN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 18:31" />पीलातुस तीनुक कह्‌यु, “तुहुंंत ईनाक ली जावु, ने तुंद्‌रा कायदान अनसारे हेरु नीयाव करजु।”</para>
  <para style="p" vid="JHN 18:31">यहुदी मुख्‌या कह्‌या “हामुक हक नी हय की काहनाकेन जीव लेणु।” <verse eid="JHN 18:31" /><verse number="32" style="v" sid="JHN 18:32" />मारी मोत कसी हवसे करीन ईसु पेहलुत तेरा चेला काजे कहंलु। ने ईसुन कहला बुलेन अनसारे आखो हयो ने तेरेत अनसारे हय बी यहुदी मुख्‌या तीनाक मुतेन डंड आपाड़ने करीन पीलातुस साते वात कर्‌या।<verse eid="JHN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 18:33" />अळतेन पीलातुस अळी पछु हवेली मां जात र्‌यु, ने ईसु काजे बुलायु ने तीनाक पुछ्‌यु, “तु यहुदी माणसेन राजु छे काय?” <verse eid="JHN 18:33" /><verse number="34" style="v" sid="JHN 18:34" />ईसु पीलातुस काजे जपाप आप्‌यु, “जी वात तु आपसे आवड़तेत कय र्‌यु की मार बारामां काहना दीसरा तुसेक कहंला छे?” <verse eid="JHN 18:34" /><verse number="35" style="v" sid="JHN 18:35" />पीलातुस ईसुक जपाप आप्‌यु, “मे यहुदी छे काय? तारीत जातीन माणसे, मंदीरेन डाहला पुजारा भेळा भेसकायन तुसेक धराय्‌न मारे सुपरुत करला छे। तु काहनु गुनु करलु छे?” <verse eid="JHN 18:35" /><verse number="36" style="v" sid="JHN 18:36" />ईसु कह्‌यु, “मारो राज ईनी कळीन राजान तसों नी हय। कदी मारो राज, ईनी कळीन राजा तसों रहतो, ती मारा राखवाळ्‌या सीपायड़ा मारे वाटे लड़ाय करता, ने मे यहुदी माणसेन हातेम नी धरायतु। बाकुन मारो राज ईनी कळीन राजान तसों नी हय।”<verse eid="JHN 18:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 18:37" />च सामळीन पीलातुस ईसुक कह्‌यु, “ती, तु छाचलीन राजा छे काय?” ईसु पीलातुस काजे जपाप आप्‌यु, “तु वारुत कय र्‌यु काहाकी मे राजा छे ने मे छाचली वात ने गवा पुरावा आपणे करीन ईनी कळी मां पयदा हय्‌न आवलु छे ने जीत छाचली छे चु मारी वात सामळीन पाळे।”<verse eid="JHN 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 18:38" />“पीलातुस ईसु काजे पुछ्‌यु छाचली काय छे?” ज पुछीन पीलातुस अळी हवेलीम सी बाहर नीकळीन यहुदी मुख्‌या अगळ आवीन कह्‌यु, मेसेक ते हीना माणुस मां काय बी गुनु नी देखायतु।<verse eid="JHN 18:38" /></para>
  <para style="s">मोतेन डंडेन हुकुम</para>
  <para style="r">(<ref loc="MAT 27:15-31">मत्‌ती 27:15-31</ref>; <ref loc="MRK 15:6-20">मरकुस 15:6-20</ref>; <ref loc="LUK 23:13-15">लुका 23:13-15</ref>)</para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 18:39" />बाकुन तुंद्‌री रीतीन अनसारे मे तुंद्‌रे वाटे फसह तीहवारेन टेमे एक केदड़ा काजे जेल मां सी छुड़तेलु, “ने तुंद्‌री मरजी हय ती तुंद्‌रे वाटे यहुदीन राजाक छुड़ दम?” <verse eid="JHN 18:39" /><verse number="40" style="v" sid="JHN 18:40" />ज सामळीन चे एक कावा अळी आयड़ीन कह्‌या, “हीनाक मां छुड़े, बाकुन बरअब्‌बा काजे छुड़ दे।” ने चु बरअब्‌बा एक डाकु हतलु।<verse eid="JHN 18:40" /></para>
  <chapter eid="JHN 18" />
  <chapter number="19" style="c" sid="JHN 19" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1" />अळतेन पीलातुस ईसु काजे लीजाय्‌न सुटा देवाड़्‌यु। <verse eid="JHN 19:1" /><verse number="2" style="v" sid="JHN 19:2" />ने सीपायड़ा काटाळ्‌या वेळान मुळ्‌यो गुथीन ईसुन मुणका<note caller="+" style="f"><char style="fr" closed="false">19:2 </char><char style="ft" closed="false">सिर</char></note> पर मेक देदा ने जामण्‌यो झगल्‌यो पेहराया। <verse eid="JHN 19:2" /><verse number="3" style="v" sid="JHN 19:3" />ने ईसु धड़े आवीन ईसुक हास्‌ता जाय्‌न कह्‌णे बाजी गुया, “ए यहुदी माणसेन राजा, वारु छे की!” ने चे तीनाक थापड़ाया।<verse eid="JHN 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 19:4" />पीलातुस अळी बाहर जाय्‌न माणसेक कह्‌यु, “देखु, मारी नींगा मां हेरेम काय बी खुड़ नी देखाव पड़तु, ज तुहुंं बी जान्‌नु चाहजे, करीन मे तीनाक अळी बाहर लावलु।” <verse eid="JHN 19:4" /><verse number="5" style="v" sid="JHN 19:5" />तीने टेमे ईसुन मुणका पर काटाळ्‌या वेळान मुळ्‌यो मेकलोत हतलो, ने तीनाक जामण्‌यो झगल्‌यो पेहरावलोन हतलो, तसुत चु बाहर आयु ने पीलातुस माणसेक कह्‌यु देख, “हयुत छे चु माणुस!”<verse eid="JHN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 19:6" />मंदीरेन डाहला पुजारा ने मंदीरेन राखवाळ्‌या सीपायड़ा ईसु काजे देखीन, पीलातुस अगळ असा आयड़ी पड़्‌या की, “हीनाक कुरुस पर टांगीन खीळा ठुकीन मार देवु!”</para>
  <para style="p" vid="JHN 19:6">हीनाक कुरुस पर टांगीन खीळा ठुकीन मार देवु! पीलातुस तीनुक कह्‌यु, “मारी नींगा मां हेरेम काय बी खुड़ नी देखाव पड़तु ने ईनाक तुहुंंत ली जावु ने तुहुंंत ईनाक कुरुस पर टांगीन खीळा ठुकीन मार देवु!”<verse eid="JHN 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 19:7" />यहुदी मुख्‌या कह्‌या, “हामरे धड़े मुसान लिखला नीयम छे, तेरे अनसारे ईनाक मुतेन डंड जड़नु चाहजे, काहाकी आपसुत भगवानेन पुर्‌यु हवणेन दावु करलु छे।”<verse eid="JHN 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 19:8" />पीलातुस तींद्‌री जी वात सामळीन अळी बी बीही गुयु। <verse eid="JHN 19:8" /><verse number="9" style="v" sid="JHN 19:9" />चु अळी हवेलीन आंगणाम ली जाय्‌न तीनाक पुछ्‌यु, “तु कां सी आवलु छे?” बाकुन ईसु तीनाक काय जपाप नी आप्‌यु। <verse eid="JHN 19:9" /><verse number="10" style="v" sid="JHN 19:10" />ने पीलातुस ईसुक कह्‌यु, “तु मेसेक जपाप काहनी आपतु तुसेक नी मालम हय काय, की मारे भीणी तुसेक छुड़नेन हक छे नीते, ईना कुरुस पर टांगीन खीळा ठुकीन मार देवु, असु हुकुम आपणेन बी हक छे।”<verse eid="JHN 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 19:11" />ईसु पीलातुस काजे जपाप आप्‌यु, “कदी तुसेक उपर सरगे सी हक नी जड़तु ती तारु मारे पर काहनु बी हक<note caller="+" style="f"><char style="fr" closed="false">19:11 </char><char style="ft" closed="false">अधिकार</char></note> नी रवतु ने चु मेसेक धराड़ीन तारे सुपरुत करलु छे, माणुस बेसकु पापी छे।”<verse eid="JHN 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12" />ईसुन जी वात सामळीन पीलातुस, “ईसु काजे छुड़नेन वीच्‌यार कर्‌यु, बाकुन यहुदी मुख्‌या आयड़ी आयड़ीन कह्‌या, जु आपसा काजे राजा कह्‌वे चु आपणा रोमी राजान वीरुद करे। ने तीनाक डंड जड़नु चाहजे कदी तु ईनाक छुड़ देसी ती तु आपणा रोमी राजान दुस्‌तीदार नी हय।”<verse eid="JHN 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13" />जी वात सामळीन पीलातुस ईसु काजे बाहर गब्‌बता नावेन जागा पर बुलायन ईब्‌रानीयो बुली ईना नावेन मतलब, “दगड़ान पयड़ी” हतलो ने पीलातुस तीना जागा पर आपसी नीयावेन गादी पर बस गुयु। <verse eid="JHN 19:13" /><verse number="14" style="v" sid="JHN 19:14" />जु दाहड़ु, फसह तीहवारेन हाप्‌ताम वाळा आरामेन दाहड़ान तीयारीन दाहड़ु हतलु। ने मांजणीक टेम हय रवली, तत्‌यार पीलातुस यहुदी माणसेक कह्‌यु, “देखु, हयुत छे तुंद्‌रु राजा!”<verse eid="JHN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 19:15" />ती यहुदी मुख्‌या अळी आयड़ीन कह्‌या ईनाक जां सी लीजा!</para>
  <para style="p" vid="JHN 19:15">ईनाक जां सी लीजा! “ने ईना कुरुस पर टांगीन खीळा ठुकीन मार देवु!” पीलातुस तीनु काजे पुछ्‌यु, “मे तुंद्‌रा राजा काजे कुरुस पर टांगीन खीळा ठुकाड़ो काय?”</para>
  <para style="p" vid="JHN 19:15">मंदीरेन डाहला पुजारा कह्‌या, “रोमी राजा काजे छुड़ीन हामरु काहनु राजा नी हय।”<verse eid="JHN 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 19:16" />पीलातुस ईसु काजे तींद्‌रे हातेम आप देदु, हेरेन करीन की, चे तीनाक कुरुस पर मार देय।<verse eid="JHN 19:16" /></para>
  <para style="s">सीपायड़ा ईसु काजे कुरुस पर चड़ावे</para>
  <para style="r">(<ref loc="MAT 27:32-44">मत्‌ती 27:32-44</ref>; <ref loc="MRK 15:21-32">मरकुस 15:21-32</ref>; <ref loc="LUK 23:26-43">लुका 23:26-43</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 19:17" />ने ईसु सीपायड़ान कह्‌णेन अनसारे कुरुस हाकलीन चालतु-चालतु ईब्‌रानीयो गुलगुता नावेन जागा पर गुयु। यहुदी माणसेन बुली मां ईना नावेन मतलब मुणको हतलो। <verse eid="JHN 19:17" /><verse number="18" style="v" sid="JHN 19:18" />तीना जागा पर ईसु काजे ने तेरे भेळा दुय गुना वाळा माणसे काजे कुरुस पर टांगीन खीळा ठुक्‌या। ईचमां ईसु काजे ने एक काजे ईसुन डाखर्‌ये आंग्‌ये ने एक काजे जेवड़्‌ये आंग्‌ये कुरुस पर टांगीन खीळा ठुक्‌या। <verse eid="JHN 19:18" /><verse number="19" style="v" sid="JHN 19:19" />पीलातुस एक लाकड़ान पट्‌टी पर ईसुन बारामां लिखाड़ीन तेरा मुणका सी उपर कुरुस पर ठुकाड़ देदु। तीनी पट्‌टी पर असो लिखलो हतलो, “ईसु नासरी यहुदी माणसेन राजा।” <verse eid="JHN 19:19" /><verse number="20" style="v" sid="JHN 19:20" />ने जी वात ईब्‌रानीयो बुली मां, ने लातीनी बुली मां, ने युनानी बुली मां लिखली हतली। चां ईसु काजे कुरुस पर टांगीन खीळा ठुकला हतला, चु जागु सहरे धड़े हतलु ने बेसका यहुदी माणसे जी वात लिखली भण्‌या। <verse eid="JHN 19:20" /><verse number="21" style="v" sid="JHN 19:21" />यहुदी मुख्‌या मायन डाहला पुजारा काजे जी लिखली वात नी जमी ने चे पीलातुस काजे कह्‌या, “यहुदी माणसेन राजा असा मां लिखु बाकुन असो लिखु की हयु कह्‌यु की मे यहुदी माणसेन राजा छे।”<verse eid="JHN 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 19:22" />पीलातुस तीनुक जपाप आप्‌यु, “मे ज लिखाड़ देदु चत रवसे।”<verse eid="JHN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23" />अळतेन सीपायड़ा ईसु काजे कुरुस पर टांगीन खीळा ठुकीन नवराय गुया, तत्‌यार चे ईसुन पुथल्‌यान चार वाटा पाड़्‌या एक-एक सीपायड़ा वाटे एकेक वाटु पाड़्‌या बाकुन ईसुन झगल्‌यो सीवीन बणावलो नी हतलो, बाकुन आखो की आखो गुथीन बणावलो हतलो। <verse eid="JHN 19:23" /><verse number="24" style="v" sid="JHN 19:24" />ने चे वीच्‌यार करीन कह्‌या, आपणु हीना पुथल्‌याक नी फाड़ता, बाकुन चिट्‌ठी नाखीन देख लेता की ज कुणीक जड़से ज असो काहा कर्‌या की खरला सास्‌तुर मां लिखली वात ची पुरी हवे:</para>
  <para style="q1" vid="JHN 19:24">“चे वेरी माणसे मारा पुथल्‌याक वाट लेदा,</para>
  <para style="q2" vid="JHN 19:24">ने चे मारा पुथल्‌या वाटे चिट्‌ठी बी नाख्‌या।”</para>
  <para style="p" vid="JHN 19:24">ने छाचलीन सीपायड़ा असा की असा कर्‌या।<verse eid="JHN 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25" />ईसुन कुरुस धड़े ईसुन माय ने ईसुन मायन बहणीस ने काइफान घरवाळी मरीयम मगदलनी मरीयम उभी हय रवली। <verse eid="JHN 19:25" /><verse number="26" style="v" sid="JHN 19:26" />जत्‌यार ईसु चां आपसी माय काजे देख्‌यु ने तीना चेलाक बी देख्‌यु, जु ईसुन लाटेक्‌लु चेलु कहवायतेलु, ती चु आपसी माय काजे कह्‌यु, “ओ माय! देख, हयु तारु बेटु छे।”<verse eid="JHN 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 19:27" />अळतेन तीना चेलाक कह्‌यु, हयी तारी माय छे ने तीने टेम सी चु चेलु ईसुन माय काजे आपसी माय मान लेदु। ने आपसे घर ली जाय्‌न तेरी सेवा चाकरी करने बाजी गुयु।<verse eid="JHN 19:27" /></para>
  <para style="s">ईसुन कुरुस पर मरनु</para>
  <para style="r">(<ref loc="MAT 27:45-56">मत्‌ती 27:45-56</ref>; <ref loc="MRK 15:33-41">मरकुस 15:33-41</ref>; <ref loc="LUK 23:44-49">लुका 23:44-49</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28" />अळतेन ईसु ज जाण गुयु की, हय आखो काय पुरो हय गुयलो छे ने खरला सास्‌तुर मां पेहलुत सी लिखलो हतलो, च पुरो करने करीन कह्‌यु, “मे तीसलु छे।”<verse eid="JHN 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 19:29" />चां एक ठाहरु हतलु तीना ठाहरा मां अंगुरेन कड़वलु रस भर रवला ने चे सीपायड़ा कड़वला रस मां एक पुतो डुबाड़ीन तीना पुताक जुफा नावेन झाड़कान एक सुट्‌ये झेलाड़ीन ईसुन मुंहडे टेकी देदा। <verse eid="JHN 19:29" /><verse number="30" style="v" sid="JHN 19:30" />तत्‌यार ईसु अंगुरेन कड़वलु रस चाख्‌यु ती कह्‌यु, “पुरो हय गुयो।”</para>
  <para style="p" vid="JHN 19:30">ने आपसो मुणको हेटु वाळ लेदु ने आपसु जीव-आत्‌मा भगवान काजे आप देदु।<verse eid="JHN 19:30" /></para>
  <para style="s">ईसु काजे भाला सी गुपे</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31" />चु दाहड़ु फसह तीहवारेन हाप्‌तान वाळान खास आरामेन दाहड़ान तीयारीन दाहड़ु हतलु। आरामेन दाहड़े ईसुन ने दीसरा गुना वाळा धड़े कुरुस पर टांगलो नी रहणु चाहजे करीन यहुदी माणसे पीलातुस सी आवीन वीन्‌ती कर्‌या की कुरुस पर टांगीन खीळा ठुकला माणसेन पायेन हाटका तुड़ाय दे। ने तींद्‌रो धड़ कुरुस पर सी उतार मांग। <verse eid="JHN 19:31" /><verse number="32" style="v" sid="JHN 19:32" />सीपायड़ा आवीन ईसुन आड़े-धड़े कुरुस पर टांगीन खीळा ठुकला माणसेन पायेन हाटका टुकड़ा-टुकड़ा कर देदा। <verse eid="JHN 19:32" /><verse number="33" style="v" sid="JHN 19:33" />बाकुन अळतेन चे ईसु धड़े आवीन देख्‌या ती तीनुक मालम पड़्‌यो की चु मर गुयु ने चे तेरा पाय नी तुड़्‌या। <verse eid="JHN 19:33" /><verse number="34" style="v" sid="JHN 19:34" />बाकुन तीना सीपायड़ा मायन एक सीपायड़ु ईसुन काखे भालु घुदल्‌यु ने कुखेम सी तत्‌यारुत लुही ने पाणी नीकळ्‌यो। <verse eid="JHN 19:34" /><verse number="35" style="v" sid="JHN 19:35" />जतरा बी ज देख्‌या, चे गवाय देदा, ने तींद्‌री गवाय संय छे ने चु जाणे की चे संय कवे की तुहुंं बी भुरसु करु। <verse eid="JHN 19:35" /><verse number="36" style="v" sid="JHN 19:36" />जी वात तेरेमां हय की चुखला सास्‌तुर मां ज कहलो छे, च पुरो हवसे, “तेरा कुय हाटका बी नी तुड़े।” <verse eid="JHN 19:36" /><verse number="37" style="v" sid="JHN 19:37" />पछेन एक अळी जागा पर ज लिखलो छे, “तीनाक चे गुपला छे, तीना पर चे नींगा करसे।”<verse eid="JHN 19:37" /></para>
  <para style="s">नीकुदेमुस ने अरीमीतीया सहर वाळु युसुफ ईसुन धड़ काजे गाड़ने जाय</para>
  <para style="r">(<ref loc="MAT 27:57-61">मत्‌ती 27:57-61</ref>; <ref loc="MRK 15:42-47">मरकुस 15:42-47</ref>; <ref loc="LUK 23:50-56">लुका 23:50-56</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38" />ज आखो हय गुयो ने अळतेन अरीमतीया सहर वाळु युसुफ चु ईसुन चेलु हतलु, बाकुन यहुदी माणसेन धाके काहनाक बी नी कह्‌तेलु की मे ईसुन चेलु छे, बाकुन हय चु चेलु पीलातुस वीन्‌ती कर्‌यु की मेसेक ईसुन धड़ काजे गाड़ने ली जान दे, ने पीलातुस तेरी सामळी लेदु। ने चु युसुफ आवीन ईसुन धड़<note caller="+" style="f"><char style="fr" closed="false">19:38 </char><char style="ft" closed="false">शव</char></note> ली जात र्‌यु। <verse eid="JHN 19:38" /><verse number="39" style="v" sid="JHN 19:39" />नीकुदेमुस चु एक दाहड़ु राती वेळाय, ईसु काजे भेळु हवणे आवलु, चु बी चां एक सोव ने पंद्‌रे कीलु ईत्‌तर ने एलवो<note caller="+" style="f"><char style="fr" closed="false">19:39 </char><char style="ft" closed="false">एक भातीन झाड़कान पुपड़ो छे चो माणसेन धड़ काजे थुड़ाक दाहड़ा लग सड़ने नी देय।</char></note> लीन आयु। <verse eid="JHN 19:39" /><verse number="40" style="v" sid="JHN 19:40" />ने यहुदी माणसे जसा मरला माणसेन धड़ काजे गाड़ने ली गुया तसात चे ईसुन धड़ काजे वारु गंदायण्‌यु मसालु चुपड़्‌या ने धवळा पुथल्‌या मां गुचवी देदा। <verse eid="JHN 19:40" /><verse number="41" style="v" sid="JHN 19:41" />तीना जागा मां ईसु काजे कुरुस पर टांगीन खीळा ठुकला तीनात जागा धड़े वाड़ी हतली, ने तीनी वाड़ीन खंगराम एक नवलो बीड़ो खुदलो हतलो, तीना बीड़ा मां हय लग कुय काजे गाड़्‌या नी। <verse eid="JHN 19:41" /><verse number="42" style="v" sid="JHN 19:42" />हय यहुदी माणसेन आरामेन तीयारीन दाहड़ु खत्‌तम हवणे वाळु हतलु, ने आरामेन दाहड़ु सुरु हवणे वाळु हतलु। ने जो मसाण्‌या धड़ेत हतलो, करीन नीकुदेमुस ने युसुफ ईसुन धड़ काजे तीनात मसाण्‌या मां मेल देदा।<verse eid="JHN 19:42" /></para>
  <chapter eid="JHN 19" />
  <chapter number="20" style="c" sid="JHN 20" />
  <para style="s">ईसु मर्‌या-सर्‌याम सी जीवतु हवे</para>
  <para style="r">(<ref loc="MAT 28:1-8">मत्‌ती 28:1-8</ref>; <ref loc="MRK 16:1-8">मरकुस 16:1-8</ref>; <ref loc="LUK 24:1-12">लुका 24:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1" />हाप्‌तान पेहले दाहड़े संदारे एगीत, मरीयम मगदलनी मसाण धड़े आवी, ने ची मसाण पर सी चापर्‌यु दगड़ु छेटे करलो देखी। <verse eid="JHN 20:1" /><verse number="2" style="v" sid="JHN 20:2" />ची सीमोन ने पतरसेन्‌चां ने दीसरा चेलान चां दवड़ीन आवी, चु ईसुन लाटेक्‌लु चेलु कहंवायतेलु। ने ची तीनुक कही काहनाक माणसे मालीक ईसुन धड़ काजे मसाण सी नीकाळीन ली जात र्‌या। ने हामुक मालम नी हय की चे तीना धड़ काजे कां मेक र्‌या।<verse eid="JHN 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 20:3" />तत्‌यार पतरस ने ईसुन दीसरु चेलु मसाण भीणी दवड़ी पड़्‌या। <verse eid="JHN 20:3" /><verse number="4" style="v" sid="JHN 20:4" />चे दुय भेळा दवड़्‌या बाकुन दीसरु चेलु पतरस काजे पछळ नाख दीन पेहलुत मसाण धड़े पुग गुयु। <verse eid="JHN 20:4" /><verse number="5" style="v" sid="JHN 20:5" />चु ढंगु अळीन लेफड़्‌या पुथल्‌यान देख्‌यु बाकुन मसाणेन खंगरा मां माहें नी भरायु। <verse eid="JHN 20:5" /><verse number="6" style="v" sid="JHN 20:6" />सीमोन पतरस तेरे पछळ-पछळ आयु, ने अळतेन मसाण धड़े गुयु मसाण खंगरा मां माहें गुयु, ने चु लेफड़्‌या पुथल्‌यान पड़ रवलु देख्‌यु। <verse eid="JHN 20:6" /><verse number="7" style="v" sid="JHN 20:7" />ईसुन मुंहडा पर फेटको बांदलो हतलो च फेटको लेफड़्‌या पुथल्‌यान भेळतो हतलो, बाकुन दीसरे जागे दुर करीन मेल्‌लो देखाव पड़्‌यो। <verse eid="JHN 20:7" /><verse number="8" style="v" sid="JHN 20:8" />ती चु दीसरु चेलु जु मसाण धड़े पेहलुत पुगी गुयलु, चु बी मसाणेन खंगरा मां माहें गुयु ने पुथल्‌यो देख्‌यु ने चु चेलु असु भुरसु कर्‌यु की ईसु पछु जीवतु हय्‌न बठु हय गुयु। <verse eid="JHN 20:8" /><verse number="9" style="v" sid="JHN 20:9" />ज हवणेन पेहेल तीनुक जी वात समज मां नी आवी की, खरला-सास्‌तुरेन अनसारे ईसुन मर्‌या-सर्‌याम सी जीवतु हय्‌न बठु हवसे। <verse eid="JHN 20:9" /><verse number="10" style="v" sid="JHN 20:10" />ने चे दुय चेला आपसा-आपसा जागा पर जात र्‌या।<verse eid="JHN 20:10" /></para>
  <para style="s">पछु जीवतु हवलु ईसु मरीयम मगदली काजे देखाव पड़े</para>
  <para style="r">(<ref loc="MAT 28:9">मत्‌ती 28:9</ref>,<ref loc="MAT 28:10">10</ref>; <ref loc="MRK 16:9-11">मरकुस 16:9-11</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11" />मरीयम मगदलनी मसाण धड़े खयड़े रड़तेली, ने ची रड़ती-रड़ती ढंगी अळीन मसाण मां माहें नींगा करी। <verse eid="JHN 20:11" /><verse number="12" style="v" sid="JHN 20:12" />ने तीना जागा पर ईसुन धड़ मेलायलो हतलो, चां ची उजळा पुथल्‌या पेहर रवला दुय सरग वाळा चाकर्‌या काजे देखी एक काय मुणका भीणी ने एक पायाता भीणी बस रवला देखी। <verse eid="JHN 20:12" /><verse number="13" style="v" sid="JHN 20:13" />चे दुय सरग वाळा खबर लावण्‌या तीनी काजे कह्‌या, “ओ बायर जात! तु काहा रड़ रय?” ची कय “चे मारा मालीक काजे हाकली ली गुयला छे ने मेसेक नी मालम हय की चे तीनाक कां मेल र्‌या!”<verse eid="JHN 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 20:14" />ज कयदीन ची पछी फीरीन भाळी ने ची ईसु काजे उबु हय रवलु देखीम, बाकुन तीनीक जु ईसु छे करीन उळखायो नी। <verse eid="JHN 20:14" /><verse number="15" style="v" sid="JHN 20:15" />ईसु तीनी काजे कह्‌यु, “ओ बायर जात तु काहा रड़ रय कुणीक हेर रय?” ची मरीयम तीनाक वाड़ीम काम करन्‌यु पावर समजीन तीनाक कय, “ए दादा! कदी तु तीना काजे ली गुयु हय ती मेसेक कय दे की तु तीनाक कां मेल र्‌यु ने तीनाक ली आवीस।”<verse eid="JHN 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 20:16" />ज सामळीन ईसु तीनीक कह्‌यु, “ओ मरीयम!” ची पछी फीरीन ईसुक उळखीन तीनाक ईब्‌रानीयो मां कय, “रबी।”</para>
  <para style="p" vid="JHN 20:16">यहुदी माणसेन बुली मां ईना बुलेन मतलब ए गुरु हतलो।<verse eid="JHN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 20:17" />ईसु तीनी काजे कह्‌यु, “मे हय लग भगवान बासेन चां उपर सरग मां नी गुयु। ने मेसेक छीमीन मां रुके, बाकुन मारा भायसेन चां जाय्‌न तीनु काजे ज कय दे, की ईसु कय र्‌यु की, मे मारा भगवान बासेन्‌चां जाणे हींड र्‌यु, हयु हय सी तुंद्‌रु बी भगवान बास छे।”<verse eid="JHN 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 20:18" />मरीयम मगदलनी जाय्‌न जी वात चेला काजे कय की “मे मालीक काजे देखली छे, ने चु मेसेक बी वात कय मकल्‌यु।”<verse eid="JHN 20:18" /></para>
  <para style="s">ईसु चेला काजे देखाव पड़े</para>
  <para style="r">(<ref loc="MAT 28:16-20">मत्‌ती 28:16-20</ref>; <ref loc="MRK 16:14-18">मरकुस 16:14-18</ref>; <ref loc="LUK 24:36-49">लुका 24:36-49</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19" />तीने दाहड़े, हाप्‌तान पेहले दाहड़े सांती वेळाय ईसुन चेला यहुदी माणसेन धाके आपसात बारनो दीलीन घरमां कुंडाय रवला। ने ईसु तींद्‌रे ईचमां आय्‌न उबु हय गुयु, ने चेला काजे कह्‌यु “तुहुंंक सांती जड़े!” <verse eid="JHN 20:19" /><verse number="20" style="v" sid="JHN 20:20" />ज कयदीन ईसु आपसा हातेन घाव, ने आपसी कुखेम घाव देखाड़्‌यु, ती तेरा चेला मालीक ईसु काजे देखीन खुस हय गुया। <verse eid="JHN 20:20" /><verse number="21" style="v" sid="JHN 20:21" />ने ईसु तीनुक अळी कह्‌यु, “तुहुंंक सांती जड़े! असु भगवान बास मेसेक मकेल्‌लु छे तसुत मे बी तुहुंंक मकलो।” <verse eid="JHN 20:21" /><verse number="22" style="v" sid="JHN 20:22" />ज कयदीन<note caller="+" style="f"><char style="fr" closed="false">20:22 </char><char style="ft" closed="false">कहकर</char></note> ईसु तीनु पर फुक्‌यु ने तीनुक कह्‌यु, “लेवु, जी चुखली-आत्‌मा, तुंद्‌रा जीवन मां ली लेवु। <verse eid="JHN 20:22" /><verse number="23" style="v" sid="JHN 20:23" />तुहुंं जीनु माणसेक पापेन माफी आपसु, तीनु माणसेक पापेन माफी जड़ जासे, ने तीनुक माणसेक तुहुंं पापेन माफी नी आपु तीनु माणसेक पापेन माफी नी जड़े।”<verse eid="JHN 20:23" /></para>
  <para style="s">पछु जीवतु हवलु ईसु थोमा काजे देखाव पड़े</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24" />जत्‌यार ईसु चेला धड़े आयु ती थोमा तींद्‌रे भेळु नी हतलु चु बी बारे चेला मायन एक हतलु, चु दीद्‌मुस कहवाये। <verse eid="JHN 20:24" /><verse number="25" style="v" sid="JHN 20:25" />दीसरा चेला तीनाक कह्‌या, “हामु मालीक ईसु काजे देखला छे।”</para>
  <para style="p" vid="JHN 20:25">ती चु कह्‌यु, “जत्‌यार लग मे तेरा हातेम खीळान<note caller="+" style="f"><char style="fr" closed="false">20:25 </char><char style="ft" closed="false">कीलों</char></note> घाव नी देख लम ने खीळा सी पड़लो घावेम मारी आंगळी नी नाख दम ने तेरा कुखेम पड़ला घाव मां मारु हात नी नाख दम तत्‌यार लग मे भुरसु नी करो।”<verse eid="JHN 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26" />आंठ दाहड़ा हय गुया, ने अळतेन ईसुन चेलान अळी घरमां हतला, ने थोमु बी तींद्‌रे भेळु हतलु तीने टेमे घरेन बारनो देदलो हतलो, तेबी ईसु तींद्‌रे ईचमां आवीन उबु रय गुयु ने कह्‌यु, “तुहुंंक सांती जड़े!” <verse eid="JHN 20:26" /><verse number="27" style="v" sid="JHN 20:27" />ती ईसु थोमा काजे हेरा हात देखाड़ीन कह्‌यु, “तारी आंगळी ईनु हातेन घाव मां नाख ने आपसु हात उरु कर ने मारा कुखेम वाळा घाव मां तारु हात नाख। ने तु नी भुरसु वाळु मां बणे बाकुन मारे पर भुरसु कर।”<verse eid="JHN 20:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 20:28" />थोमा ईसु काजे जपाप आप्‌यु, “ए मारा मालीक! ए मारा भगवान!”<verse eid="JHN 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 20:29" />ती ईसु थोमा काजे कह्‌यु तु ते मेसेक देखीन मारे पर भुरसु करलु छे। बरकतवाळ चे छे, जे मेसेक नी देख्‌या बाकुन मार पर भुरसु करे।<verse eid="JHN 20:29" /></para>
  <para style="s">जी वात युहन्‌नु काहा लिखलु</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30" />ईसु आपसा चेला अगळ अळी बेसका मटा कामेन सहलाणी देखाड़्‌यु बाकुन तीनु मटा कामेन सहलाणीन बारामां ईनी किताप मां लिखलो नी हय। <verse eid="JHN 20:30" /><verse number="31" style="v" sid="JHN 20:31" />बाकुन जी वात जां असो करीन लिखली छे की तुहुंं जु भुरसु करु की ईसुत भगवानेन पुर्‌यु मसी छे, ने तेरे पर भुरसु करीन तेरे नावे सी अमर जीवन हात कर लेय।<verse eid="JHN 20:31" /></para>
  <chapter eid="JHN 20" />
  <chapter number="21" style="c" sid="JHN 21" />
  <para style="s">पछु जीवतु हय्‌न ईसु, तीबीरीयास दर्‌या धड़े चेला काजे देखाव पड़े</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1" />तीबीरीयास दरीया धड़े ईसु अळी आपसा चेला काजे ईनी रीती अळी उजेंतु देखाव पड़्‌यु, <verse eid="JHN 21:1" /><verse number="2" style="v" sid="JHN 21:2" />एक दाहड़े, सीमोन पतरस, ने थोमा, चु दीद्‌मुस कह्‌वाये नतनएल चु गलील जीलान काना सहर वाळु हतलु ने जब्‌दीन दुय पुर्‌या ने ईसुन दुय दीसरा चेला, जे आखा भेळात हतला। <verse eid="JHN 21:2" /><verse number="3" style="v" sid="JHN 21:3" />सीमोन पतरस तीनु काजे कह्‌यु, “मे ते माछा<note caller="+" style="f"><char style="fr" closed="false">21:3 </char><char style="ft" closed="false">मछली</char></note> मारने जाम। ने चे दीसरा चेला काजे कह्‌या।”</para>
  <para style="p" vid="JHN 21:3">“हामु बी तारे पुठ्‌ये आवजे।” ने चे तेरे पुठ्‌ये चाल पड़्‌या, ने ढंड्‌या मां चहड़ीन बठ गुया, बाकुन तीने राते एक बी माछी हात नी लागी। <verse eid="JHN 21:3" /><verse number="4" style="v" sid="JHN 21:4" />संदारे हवतात ईसु दरीया धड़े आय्‌न उबु रय गुयु, बाकुन चेला काजे ईसु नी उळख्‌यु। <verse eid="JHN 21:4" /><verse number="5" style="v" sid="JHN 21:5" />तत्‌यार ईसु तीना चेला काजे कह्‌यु, “ए पुर्‌या! तुहुंं काजे खाणे करीन एक बी माछी नी धराय काय?” चे चेला जपाप आप्‌या, “एक बी नी धराय!”<verse eid="JHN 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 21:6" />तत्‌यार ईसु तीनु काजे कह्‌यु, “ढंड्‌यान जेवड़्‌ये आंग्‌ये जाळ नाखु ने तुहुंंक माछा हात लागसे।” चे जाळ नाख्‌या ने अतरा माछा जाळेम आया की तीनुक जाळ नी हाकलाय।<verse eid="JHN 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 21:7" />तत्‌यार चु चेलु, जु ईसुन लाटेकलु चेलु, “कह्‌वायतेलु, पतरस काजे कह्‌यु, जु ते आपणु मालीक ईसुत छे।” जत्‌यार सीमोन पतरस सामळ्‌यु की जु आपणु मालीक ईसुत छे ती चु नांगरलु हतलु करीन आपसो झगल्‌यो पेहरी लेदु ने ईसुक भेळु हवणे करीन दरीया मां मामार कुद पड़्‌यु। <verse eid="JHN 21:7" /><verse number="8" style="v" sid="JHN 21:8" />बाकुन दीसरा चेला, माछा भरायली जाळ काजे हाकलता जाय्‌न ढंड्‌या काजे दरीया धड़े लाया। काहाकी चे दरीया धड़े सी जादा छेटा नी हतला। चे दरीया धड़े सी दुयेक सोव हात छेटा हतला।<verse eid="JHN 21:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 21:9" />जत्‌यार चे ढंड्‌याम सी उतरीन धड़े भुयमां आया, ती तीनुक चां रुटा ने धपतेला कुयलान ईंगाळा पर माछा मेकला देखाव पड़्‌या। <verse eid="JHN 21:9" /><verse number="10" style="v" sid="JHN 21:10" />ईसु तीनु काजे कह्‌यु, “तुहुंं हींताळ जे माछा धरला छे, तीनु मायन थुड़ाक ली आवु।”<verse eid="JHN 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 21:11" />सीमोन पतरस पछु ढंड्‌या मां गुयु, ने जाळ धड़े हाकली लायु। तीनु जाळेम डेड़ सोव ने तीन मटला माछा पड़ला हतला, ने अतरा माछा जाळेम पड़्‌या तेबी जाळ नी फाटी। <verse eid="JHN 21:11" /><verse number="12" style="v" sid="JHN 21:12" />ईसु तीनु काजे कह्‌यु, “आवु, ईतरोक खाय लेवु।” चेला जाण लेदा की जु मालीक ईसुत छे। ने “तु कुण छे।” करीन ईसु काजे पुछणे, तीनु मायन कुय काजे बी हिम्‌मत नी कर्‌या। <verse eid="JHN 21:12" /><verse number="13" style="v" sid="JHN 21:13" />ईसु धड़े आयु, ने खाणे करीन चु रुटु हातेम लीन तीनुक आप्‌यु, ने ईनी रीते माछा आप्‌यु।<verse eid="JHN 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 21:14" />असु करीन मर्‌या-सर्‌याम सी जीवतु हय्‌न ईसु तीसरी कावा आपसा खास चेला अगळ उजेंतु देखाव पड़लु।<verse eid="JHN 21:14" /></para>
  <para style="s">ईसु पतरस काजे, हय अळी पछु परम सी बुलावे</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15" />खायलीन नवराय्‌न ईसु, सीमोन पतरस काजे पुछ्‌यु, “ए सीमोन, युहन्‌नान पुर्‌या! तु छाचलीन, हींद्‌रे सी जादा मेसेक परम करे काय?” पतरस ईसुक कह्‌यु, हव, “मालीक! तु जाणे की मे तारे सी परम करो।”</para>
  <para style="p" vid="JHN 21:15">ईसु सीमोन पतरस काजे कह्‌यु, “मारा गाडरा चार।” <verse eid="JHN 21:15" /><verse number="16" style="v" sid="JHN 21:16" />ईसु दीसरी कावा अळी सीमोन पतरस काजे कह्‌यु, “ए सीमोन, युहन्‌नान पुर्‌या! तु छाचलीन मारे सी परम करे काय?” पतरस ईसु काजे जपाप आप्‌यु,</para>
  <para style="p" vid="JHN 21:16">“हव, मालीक! तु जाणे की मे तारे सी परम करो।”</para>
  <para style="p" vid="JHN 21:16">ईसु पतरस काजे कह्‌यु, “मारा गाडरान गुवाळी<note caller="+" style="f"><char style="fr" closed="false">21:16 </char><char style="ft" closed="false">राखवाळी</char></note> कर।” <verse eid="JHN 21:16" /><verse number="17" style="v" sid="JHN 21:17" />ईसु अळी तीसरी कावा, पतरस काजे कह्‌यु, “ए सीमोन, युहन्‌नान पुर्‌या! तु छाचलीन मेसेक परम करे काय?”</para>
  <para style="p" vid="JHN 21:17">ईसु पतरस काजे तीसरी कावा ज पुछ्‌यु की तु छाचलीन मारे सी परम करे काय? करीन तीनाक बेसको दुख लाग्‌यो। ने पतरस ईसु काजे कह्‌यु, “मालीक! तुसेक आखी वात मालम छे, तु जाणे की मे तारे सी छाचलीन परम करो।”</para>
  <para style="p" vid="JHN 21:17">ईसु पतरस काजे कह्‌यु, “मारा गाडरा काजे चार।” <verse eid="JHN 21:17" /><verse number="18" style="v" sid="JHN 21:18" />मे तुसेक छाचलीन कहो की जत्‌यार तु जुवान हतलु, ती आपसान कमर बांदीन जाहां बी चाहतेलु चां फीरतेलु, बाकुन जत्‌यार डुकरु हवसी ती आपसा हात फेलावसी ने दीसरा तारी कमर बांदीन जाहां तु नी चाहसी चां तुसे ली जासे। <verse eid="JHN 21:18" /><verse number="19" style="v" sid="JHN 21:19" />हयु ईनी वात सी सहलाणी देदु, की पतरस कसु मरनेन सी भगवानेन सेक-सींगार करसे। ने तत्‌यार हयु तीनाक कह्‌यु, “मार कह्‌याम चाल।”<verse eid="JHN 21:19" /></para>
  <para style="s">पतरस ईसु काजे युहन्‌नान बारामां पुछे</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20" />पतरस पछु फीरीन ईसुन तीना दीसरा चेला काजे पछळ-पछळ आवतेलु देख्‌यु, चु ईसुन लाटेकलु चेलु कहंवायतेलु। हयु चु की चु हतलु, जु तीहवारेन दाहड़े सांती वेळाय खाणेन टेमे ईसुन छाती भीणी वळीन, “ए मालीक! तुसेक धरावण्‌यु कुण छे?” करीन पुछलु। <verse eid="JHN 21:20" /><verse number="21" style="v" sid="JHN 21:21" />अळतेन पतरस तीना चेलाक देखीन ईसु काजे पुछ्‌यु, “मालीक! एरे पर काय वीतणे वाळो छे?” <verse eid="JHN 21:21" /><verse number="22" style="v" sid="JHN 21:22" />ईसु कह्‌यु, “कदी मेसेक पछु आवता लग हयु जीवतेलु रय जाय, ती ईनी वात सी तारो काय लेण देणु छे? तु ते मरता लग मारा कह्‌याम चालतु रव।”<verse eid="JHN 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 21:23" />ने ईसु पर भुरसु करन्‌या भायसे मां जी हुकवाय फीर गुय की हयु चेलु नी मरे, “बाकुन ईसु असु नी कह्‌यु की हयु नी मरे बाकुन ज कहंलु की कदी मेसेक पछु आवता लग हयु जीवतेलु रय जाय ती, ईनी वात तारो काय लेण देन छे?”<verse eid="JHN 21:23" /></para>
  <para style="s">आकरी वात</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 21:24" />हयु चु की चु चेलु छे, जु ईनी वातेन गवा देणे करीन जी किताप लिखलु छे। हामु जाणजे की हेरी गवाय छाचली छे।<verse eid="JHN 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25" />ईसु अळी बी बेसका काम कर्‌यु, कदी एकेक करीन तीनु कामेन बारामां लिखता ती, ती मे समजो की जे किताप लिखायता, चे किताप अतरा जादा हय जाता की ईनी कळी मां बी नी समाय्‌ता।<verse eid="JHN 21:25" /></para>
  <chapter eid="JHN 21" />
</usx>