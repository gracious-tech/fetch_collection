<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="TIT" style="id">- Bhilali Standard Project</book>
  <para style="h">तीतुस</para>
  <para style="toc3">तीतुस</para>
  <para style="toc2">तीतुस</para>
  <para style="toc1">तीतुस वाटे पोलुसेन चिट्‌ठी</para>
  <para style="mt2">तीतुस के लिए पौलुस की पत्री</para>
  <para style="mt1">तीतुस वाटे पोलुसेन चिट्‌ठी</para>
  <para style="imt">तीतुसेन बारामां</para>
  <para style="ip">तीतुसेन किताप पोलुसेन चार चिट्‌ठी मां सी एक छे ज एक मंडळी वाटे नी बाकुन माणुस काजे बताड़ी जाय। ने दीसरी तीन चिट्‌ठी पेहला तीमुथीयुस दुसरा तीमुथीयुस ने फीलेमोन छे। पोलुस तीतुस काजे लिख रवलु बाकुन चे ज बी लिखलो की चिट्‌ठी काजे माणसे ईचमां जुर सी भणे हामु ज जान सकजे काहाकी चु हेरी अक्‌कल काजे एक नेवताळान काम रुप मां बताड़े काय असो हसे की तीतुस काजे पेहलुत सी मालुम हसे। पोलुस नक्‌खी ईसुन पयदा हवणे 63-65 सालेन ईचमां जी चिट्‌ठी लिखलु।</para>
  <para style="ip">पोलुस तीतुस काजे करेत पाणीन ईचमां वाळी जागा मां मंडळीन अगवाय करने सीकापण देय पोलुस जी चिट्‌ठी हेरे करीन लिख्‌यु काहाकी तीतुस मंडळीन सीकला ने नेवाड़ला अगवाय करन्‌या काजे सीकापण देय। हीयु आपणा चिट्‌ठीया मां असु सीकापण तीमुथीयुस काजे आपे। हींद्‌री चिट्‌ठी मां बताड़लो छे की मंडळीन अगवाय करन्‌या काजे एक मट्‌ली जागा पर कसों मेकणु चाहजे। मंडळ्‌या काजे ने मंडळीन अगवाय करन्‌या काजे आजुन अगवाय मां जरुड़ी जागा पर धी‌यान राखणु चाहजे।</para>
  <para style="iot">बाहरती वात</para>
  <para style="io1">1. पोलुस तीतुस काजे धरमी अगवाय करन्‌या काजे नेवाड़ने सीकापण देय। <char style="ior"><ref loc="TIT 1:1-16">1:1-16</ref> </char></para>
  <para style="io1">2. अळतेन हीयु हीना माणसे काजे भगवानेन जीवन जीवणे वाटे सीकाड़ने सीकापण आप्‌यु। <char style="ior"><ref loc="TIT 2:1-3:11">2:1—3:11</ref></char></para>
  <para style="io1">3. अळतेन आकरी मां हेरी थुड़ीक युजना काजे बताड़ीन वारु छे की कय्‌न सार देय। <char style="ior"><ref loc="TIT 3:12-15">3:12-15</ref> </char></para>
  <chapter number="1" style="c" sid="TIT 1" />
  <para style="p">
    <verse number="1" style="v" sid="TIT 1:1" />पोलुस भीणी सी, जु भगवानेन पावर्‌यु ने ईसु मसीन नेवतावाळु छे,</para>
  <para style="p" vid="TIT 1:1">भगवानेन नेवाड़ला<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">चुने हुए</char></note> माणसे भुरसा काजे बड़ावणे करीन खरली वात बड़ावणे वाटे तीना काजे मकेलु छे, <verse eid="TIT 1:1" /><verse number="2" style="v" sid="TIT 1:2" />तीनी अमर जीवनेन आसा पर, भगवान चु वायदु पेहलुन करलु छे, भगवान लुच्‌चाय मेलन्‌यु नी हय, <verse eid="TIT 1:2" /><verse number="3" style="v" sid="TIT 1:3" />बाकुन संय टेम पर आपसा बुलेक तीना परचार सी उजेंतु करलु, जु हामरा मरण सी छुटकारु करने वाळु भगवानेन हुकुमेन अनसारे मेसेक सुप देदलु।<verse eid="TIT 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="TIT 1:4" />तीतुसेन नावेन जु भुरसा भेळु वीच्‌यार सी मारु खरलु पुर्‌यु छे।</para>
  <para style="p" vid="TIT 1:4">भगवान बास ने हामरु मरण सी छुटकारु<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">उद्धारकर्ता</char></note> करने वाळु मसी ईसु भीणी सी तुसेक गीण-दया ने सुक-सांती जड़ती रवे।<verse eid="TIT 1:4" /></para>
  <para style="s">केरते मां तीतुसेन काम</para>
  <para style="p">
    <verse number="5" style="v" sid="TIT 1:5" />मे असु करीन तुसे केरते मां मेलदीन आवती रवलु, की तु बचली वाते काजे सुदारे, ने मारी हुकुमेन अनसारे गांव-गांव मां नी डाहला बणावे। <verse eid="TIT 1:5" /><verse number="6" style="v" sid="TIT 1:6" />जे नी-गुनावाळु ने एकुत बायरीन घरवाळु हय, तींद्‌रा पुर्‌या बी भुरसु करन्‌या हय, ने तींद्‌रे पर लुच्‌चाय ने तींद्‌रे मां नी मान्‌ने वाळा छे, करीन गुनु नी हय। <verse eid="TIT 1:6" /><verse number="7" style="v" sid="TIT 1:7" />काहाकी मंडळीन मुख्‌या काजे भगवानेन पावर्‌यु नाते नी-गुनावाळु रवणु चाहे; नी हुकुम मान्‌ने वाळु, नी रीस वाळु<note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="fq" closed="false">रीस वाळु </char><char style="ft" closed="false">क्रोधी</char></note>, नी पीने वाळु, नी लड़ाय करने वाळु, ने नी चुरी करीन खाने वाळु हवणु चाहजे। <verse eid="TIT 1:7" /><verse number="8" style="v" sid="TIT 1:8" />बाकुन आव-भाव सी मेजवानी करने वाळु, भलाय करने वाळु, हुस्‌यार, छाचलु, चुखलु ने नीयम पर चालने वाळु हवणु चाहजे; <verse eid="TIT 1:8" /><verse number="9" style="v" sid="TIT 1:9" />ने भुरसु राखणे लायक बुले पर काठा बणीन रहु; जे धरमेन सीकापणेन अनसारे छे, काहाकी खरली सीक सी दीसरा काजे सीकाड़ सके, ने फालतु वात पर बक-बक करने वाळान मुंहडा बी बंद कर सकजे।<verse eid="TIT 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="TIT 1:10" />ज तेरेमां जरुड़ी छे काहाकी बेसका माणसे खुद पर गम नी राखे ने फालतु वात बणायन दीसरा माणसे काजे बी भटकाड़े। मे खास करीन यहुदी माणसे काजे जी वात कय र्‌यु। <verse eid="TIT 1:10" /><verse number="11" style="v" sid="TIT 1:11" />हींद्‌रो मुंहडो बंद करनु चाहे। जे माणसे फालतु कमाय वाटे जी वात फालतु छे, तीनी लुच्‌ची वात सी सीकाड़ीन घर की घर बीगाड़ देय। <verse eid="TIT 1:11" /><verse number="12" style="v" sid="TIT 1:12" />तीनुत मां सी एक जणु चु तींद्‌रुत अघली वात बताड़ने वाळु छे, चु कह्‌लु छे, “केरती माणसे जलम लुच्‌चा, उजग्‌ला जनवार्‌या ने आपसात ने पेट भरता रहे।” <verse eid="TIT 1:12" /><verse number="13" style="v" sid="TIT 1:13" />जी गवा छाचली छे, तेरेमां तीनाक वारुस लड़ीन चेताव की चे भुरसा मां पाक्‌का हय जाय। <verse eid="TIT 1:13" /><verse number="14" style="v" sid="TIT 1:14" />ने यहुदीन माणसेन काहानीया ने तीनु माणसेन हुकुम पर मन नी लागाड़े, जे छाचली वाट सी भटकी जाय। <verse eid="TIT 1:14" /><verse number="15" style="v" sid="TIT 1:15" />चुखला माणसे वाटे आखी चीज चुखली छे, बाकुन भुंडात ने नी भुरसु करने वाळा वाटे काय बी चुखलो नी हय नीते तींद्‌रु डीमाक ने अक्‌कल दुयु चुखलो नी हय। <verse eid="TIT 1:15" /><verse number="16" style="v" sid="TIT 1:16" />चे कहें की हामु भगवान काजे जाणजे बाकुन तींद्‌रा काम सी तीनाक मना करे; काहाकी चे भुंडात काम ने नी हुकुम मान्‌ने वाळा छे, ने काहना भला काम करे असा नी हय।<verse eid="TIT 1:16" /></para>
  <chapter eid="TIT 1" />
  <chapter number="2" style="c" sid="TIT 2" />
  <para style="s">खरली सीक्‌सा काय छे</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 2:1" />बाकुन तु असी वात कर रयु जु खरली अक्‌कल सीकाड़ने लायक छे। <verse eid="TIT 2:1" /><verse number="2" style="v" sid="TIT 2:2" />ने डाहला<note caller="+" style="f"><char style="fr" closed="false">2:2 </char><char style="ft" closed="false">वृद्ध</char></note> माणसे सांती ने समजदार ने खुद काजे हक मां बणायन राखे, ने तींद्‌रु भुरसु ने परम ने सेण करने मां पाक्‌का रहु। <verse eid="TIT 2:2" /><verse number="3" style="v" sid="TIT 2:3" />हेरेत वजे सी डाहला बायरान चाल-चालन चुखला बायरान तसा रवे; चे गुनु लागाड़ने ने नस्‌यु करनेन गुलाम नी रहे, बाकुन वारलु वात सीकाड़ने वाळी बणे। <verse eid="TIT 2:3" /><verse number="4" style="v" sid="TIT 2:4" />काहाकी ची जुवान बायरी काजे सीकाड़ती रवे की आपसा घर वाळाक ने पुर्‌या सी परम राखे; <verse eid="TIT 2:4" /><verse number="5" style="v" sid="TIT 2:5" />ने अक्‌कल वाळा, चुखली, डाहला माणसेन वात माने, घरेन कारबार करने वाळी, भुळी ने आपणा-आपणा घर वाळान हक मां रहणे वाळी हवणु, काहाकी भगवानेन बुलेन नाव-बद्‌दी नी हवे।<verse eid="TIT 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="TIT 2:6" />असोत जुवान अदमी काजे बी समजाड़्‌या कर की, चे हुस्‌यार बणु। <verse eid="TIT 2:6" /><verse number="7" style="v" sid="TIT 2:7" />आखी वात मां आपणे आप काजे वारलु कामेन दाखलु बणाव; तारे सीकाड़ने सी चतराय, चे सीकणु चाहजे <verse eid="TIT 2:7" /><verse number="8" style="v" sid="TIT 2:8" />ने असी खरली वात करु, की तीनी वात सी तुसे कुय भुंडुत नी कय सके काहाकी तु नी बाकुन उल्‌टा चे लाजवाये काहाकी तींद्‌रे धड़े तुसेक भुंडुत कहणेन काय नी रवसे।<verse eid="TIT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="TIT 2:9" />पावर्‌या काजे समजाड़ की आपणा-आपणा मालीकेन हक मां रहे, ने आखी वात मां तीनुक खुस राखे, ने तींद्‌रे मुंहडे लागण्‌या मां बणु। <verse eid="TIT 2:9" /><verse number="10" style="v" sid="TIT 2:10" />चुरी चालाकी नी करे, बाकुन आखी भाती सी पुरु भुरसु करने वाळा नीकळे, काहाकी चे आखी वाते मां हामरा मरण सी छुटकारु करने वाळु भगवानेन सीकाड़न्‌यान सुभा बड़ाय देय।<verse eid="TIT 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="TIT 2:11" />काहाकी भगवानेन गीण-दया उजेंती हवे, जु आखा माणसे मां अमर छुटकारु देखाव पड़ गुयलु छे। <verse eid="TIT 2:11" /><verse number="12" style="v" sid="TIT 2:12" />ने हामुक लड़ीन सीकाड़े, की हामु भक्‌ती नी करने वाळा ने दुनीयान चीज सी मन फेरवीन ईनी कळी मां हुस्‌यार ने धरमेन कामे सी ने भक्‌ती सी जीवन जीवजे; <verse eid="TIT 2:12" /><verse number="13" style="v" sid="TIT 2:13" />ने तीना वारु आसेन नीते आपणा मटला भगवान ने मरण सी छुटकारु करने वाळु ईसु मसीन सेक-सींगार उजेंतु हवणेन वाट देखता रहे। <verse eid="TIT 2:13" /><verse number="14" style="v" sid="TIT 2:14" />जु खुद काजे हामरे वाटे दी देदलु छे, काहाकी हामुक आखा भातीन जे धरमेन काम नी हय तींद्‌रे सी छुड़ाय लेय, ने चुखा करीन आपणे वाटे एक असी जाती बणाय लेय जे भला काम करनेन हवस देय।<verse eid="TIT 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 2:15" />आखे हकेन साते जी वात कव ने समजाड़ ने सीकाड़तु रव। काहनुक तुसेक नानु<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="ft" closed="false">तुच्छ</char></note> नी जान्‌नु चाहजे।<verse eid="TIT 2:15" /></para>
  <chapter eid="TIT 2" />
  <chapter number="3" style="c" sid="TIT 3" />
  <para style="s">दीसरान भलाय कनेन काळजी करता रहु</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 3:1" />ईसु पर भुरसु करन्‌या काजे तु असा हेर कराड़, की राज करन्‌या नेतान ने आखी भातीन मुख्‌या माणसेन हक मां रहु, ने तींद्‌रु हुकुम मानु, ने आखा वारलु काम करने वाटे तीयार रहु। <verse eid="TIT 3:1" /><verse number="2" style="v" sid="TIT 3:2" />कुयन बी नाव-बद्‌दी घुण करजु, ने लड़ाय मां करु; बाकुन आखा हेळी-मेळीन रहु, ने आखा माणसे साते नीचळा बणीन वेहवार करु। <verse eid="TIT 3:2" /><verse number="3" style="v" sid="TIT 3:3" />काहाकी आपणु बी पेहले, डेड़-अकल्‌या हतला।<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="fq" closed="false">डेड़-अकल्‌या </char><char style="ft" closed="false">निर्बुद्धि</char></note> ने हुकुम नी मानने वाळा हतला, ने गलत वात मां पड़ला हतला। छीनाळा मां ने पापेन गुलाम हतला ने असली आखी कुहरली वात करन्‌या हतला जां लग की माणसे आपणे सी कुहराय करतेला ने आपणु बी एक दीसरा सी रीस करतेला ने हामु बुरफाय ने कुहराय मां जीवतेला। <verse eid="TIT 3:3" /><verse number="4" style="v" sid="TIT 3:4" />बाकुन जत्‌यार हामरु छुटकारु आपणे वाळु भगवाननेन भलाय, ने माणसे पर तेरु परम उजेंतु हयु, ने आपणु तेरे पर भुरसु कर्‌या। <verse eid="TIT 3:4" /><verse number="5" style="v" sid="TIT 3:5" />ती चु आपणु छुटकारु कर्‌यु; ने ज धरमेन कामेन वजे सी नी, जो हामु आपसात कर्‌या, बाकुन आपणी दयान अनसारे नवला जनमेन उंघळने सी, ने चुखली-आत्‌मा सी हामुक नवला बणावणेन वजे सी हयो। <verse eid="TIT 3:5" /><verse number="6" style="v" sid="TIT 3:6" />तीनाक हयु आपणु छुटकारु देणेवाळु ईसु मसी सी आपणे पर अदु सी अदु चुखली-आत्‌मा रेचव्‌यु, <verse eid="TIT 3:6" /><verse number="7" style="v" sid="TIT 3:7" />भगवान तेरेमां आपणुक तेरी दया सी हामु धरमी ठहरीन अमर जीवनेन आसेन अनसारे वारीस बण्‌या। <verse eid="TIT 3:7" /><verse number="8" style="v" sid="TIT 3:8" />जी वात संय छे ने मे चाहो की तु हीनी वातेन बारामां पुरा मन सी कहलु काहाकी जे भगवान पर भुरसु कर्‌या, चे भला काम मां लागला रवे,</para>
  <para style="p" vid="TIT 3:8">असला भला काम माणसे वाटे बेसको वारु छे। ने ईसुन भुरसाम लावणे मां नफावाळा छे। <verse eid="TIT 3:8" /><verse number="9" style="v" sid="TIT 3:9" />बाकुन डेड़-अकल्‌या बणीन वात मां वात देण्‌या, ने बाप दादा, ने मन मां रीस राखीन रुकावट, ने तीना झगड़ा सी, जो नीयमेन बारामां छे, तेरेसी बचीन रहु; काहाकी चे काय बी फळ लावण्‌या नी हय<note caller="+" style="f"><char style="fr" closed="false">3:9 </char><char style="fq" closed="false">फळ लावण्‌या नी हय </char><char style="ft" closed="false">निष्फल</char></note> ने फालतु छे। <verse eid="TIT 3:9" /><verse number="10" style="v" sid="TIT 3:10" />काहनाक ढंगड़ा करने वाळा काजे एक दुय कावा समजाड़ीन तेरेसी अलग हय जाणु। <verse eid="TIT 3:10" /><verse number="11" style="v" sid="TIT 3:11" />काहाकी तुहुंं जाणु की असा करीन जे माणसे भटकी गुयला छे ने आपणे आप काजे गुनाळु ठहरावीन पाप करता रवे।<verse eid="TIT 3:11" /></para>
  <para style="s">हेर राखणे वाटे चिट्‌ठीन खास वात</para>
  <para style="p">
    <verse number="12" style="v" sid="TIT 3:12" />जत्‌यार मे तारे धड़े अरतीमास नेते तुखीकुस काजे मकलो, ती मारे धड़े नीकुपुलीस आवणेन कुसीत करजी, काहाकी मे चांहान सींगेन दाहड़ा काटणेन पाक्‌कु वीच्‌यार करलु छे। <verse eid="TIT 3:12" /><verse number="13" style="v" sid="TIT 3:13" />जेनास नावेन वकील ने अपुल्‌लोस तारेन चां आवणे वाळा छे, चां सी बी अगास जाण्‌या छे, तीनु काजे ज बी चाहजे तेरी पुर्‌ती करीन तु तीनुक छाटुस मकली देजी। <verse eid="TIT 3:13" /><verse number="14" style="v" sid="TIT 3:14" />तु अतरुत नी आपणा मंडळ्‌यान आखा माणसे जी वात सीकणु चाहजे माणसे ते चारे मेर बेसका कसरायला छे, हेरे सी मंडळीन माणसे काजे तु असु सीकाड़जु की, तुहुंं बेसका कसरायला माणसे वाटे भला काम करने मां लागला रवु। असा करसु ती तुंद्‌री जीवाय बेसकी काम की रवसे।<verse eid="TIT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 3:15" />जतरा बी साती मारे पुठ्‌ये छे, चे आखा तुसेक वारलु छे की? पुछ रया ने आवजी कय रया। मेसेक मालुम छे की, करेत वाळा बेसका ईसुन चेला हामु काजे भुरसा मां साजेल्‌या समजीन परम करे। तीनुक बी मार वाटीन वारलु छे की? करीन पुछ लेजी ने आवजु कय देजी।</para>
  <para style="p" vid="TIT 3:15">तुहुंं आखा काजे भगवान गीण-दया जड़ती रहणु चाहजे।<verse eid="TIT 3:15" /></para>
  <chapter eid="TIT 3" />
</usx>