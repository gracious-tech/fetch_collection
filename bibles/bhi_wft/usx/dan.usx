<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="DAN" style="id">- Bhilali Standard Project</book>
  <para style="h">दानीयल</para>
  <para style="toc3">दानीयल</para>
  <para style="toc2">दानीयल</para>
  <para style="toc1">दानीयल</para>
  <para style="mt2">दानीएल के द्वारा लिखा गया यीशु का सुसमाचार</para>
  <para style="mt1">दानीयलेन साहरे लिखली ईसुन खुस-खबर</para>
  <para style="imt">दानीयलेन बारामां</para>
  <para style="ip">दानीयलेन किताप बेबीलोन मां इस्‌राएली माणसेन गुलामीन टेमे भगवानेन अघली वात बताड़न्‌यु दानीयलेन जीवनेन बारामां ने अघली वात ने सपनान बारामां छे। जां दानीयल ने तेरा दुस्‌तीदारेन ईमानदारी ने तेर भेळे-भेळे राज्‌य-राज्‌य ने दुनीयान ने अघली वातेन बारामां बताड़े। जी किताप 605 सी 535 ईसा पेहलेन टेम लगुन वात काजे बताड़े, जां दानीयल ने बेबीलोन वाटे चार दीसरा-दीसरा राजान राज करनेन टेमे सेवा करला। जसी पेहलुत सी रीतीन अनसारे सी असों छे की दानीयल खुदुत तीनी टेमे बेबीलोन मां किताप लिखलु छे, बाकुन काहीं बाद वाळा माणसेन वारु भन्‌ला माणसेन कवणु छे की, ईनाक बाद मां मे दुसरी सताब्‌दी ईसा पेहलेन टेम मां, इस्‌राएल देस मां लिखायलो छे। दानीयलेन किताप गुलामी मां रवणे वाळा इस्‌राएली माणसे भेळे-भेळे काठली टेम आवणे पर आवणे वाळी पीड़ी काजे आस देणे करीन लिखायली छे। दानीयलेन जीवनेन बारामां हवलो ने हवणे वाली वातेन बारामां दुयुन साहरे, भगवान राजा ने राज्‌य-राज्‌य पर आपसी ताकत देखाड़े। बाईबलेन हीसाब मां, जो नवलो नेम भगवानेन राज काजे समजणे मां मदत करे। <char style="xt"><ref loc="DAN 7:13-14">दानीयल 7:13-14</ref></char> मां ईसु मसीन बारामां अघली वात बताड़ली छे। आकरी टेमेन बारामां दानीयलेन सपनान बारामां ईसु मसी बताड़्‌लु छे। <char style="xt"><ref loc="MAT 24:15">मत्‌ती 24:15</ref>; <ref loc="MRK 13:14">मरकुस 13:14</ref></char> ने जो युहन्‌नान उजेंता बुलेन कितापेन बारामां बी लिखलो छे। दानीयल यीरम्‌यान बारामां बी हवणे वाळी वातेन वीच्‌यार करे। <char style="xt"><ref loc="DAN 9:1-3">दानीयल 9:1-3</ref> </char></para>
  <para style="iot">बाहरती वात</para>
  <para style="io1">1. नबुकदनेस्‌सरेन राजान राज मां बेबीलोन देस मां दानीयल ने आपसा दुस्‌तीदारेन बारामां बताड़लो छे। <char style="ior"><ref loc="DAN 1-4">1—4</ref> </char></para>
  <para style="io1">2. राजु बेलसस्‌सरेन सपनान दानीयलेन कामेन बारामां बताड़लो छे। <char style="ior"><ref loc="DAN 5">5</ref> </char></para>
  <para style="io1">3. दारा राजेन दाहड़ा मां नाहरेन गड्‌डा मां दानीयलेन बारामां बताड़लो छे। <char style="ior"><ref loc="DAN 6">6</ref> </char></para>
  <para style="io1">4. आवणे वाळी वातेन बारामां दानीयल काजे भगवान भीणी सी सातायली वातेन सुरुवात भेसकायली छे। <char style="ior"><ref loc="DAN 7-12">7—12</ref></char></para>
  <para style="io2">(क) दानीयल आवणे वाळी वातेन बारामां दुय सपनो ने हींद्‌रो काम बताड़े। <char style="ior"><ref loc="DAN 7-8">7—8</ref> </char></para>
  <para style="io2">(ख) दानीयल आपणा माणसे वाटे दुवा करे, ने सरगदुत जीब्‌राएलेन साहरे जपाप जड़े। <char style="ior"><ref loc="DAN 9">9</ref> </char></para>
  <para style="io2">(ग) जीब्‌राएल भगवानेन अघली वातेन बारामां उजेंतु देखाड़े, ने तेरेमां आकरी टेम बी भेसकायली छे। <char style="ior"><ref loc="DAN 10-12">10—12</ref> </char></para>
  <chapter number="1" style="c" sid="DAN 1" />
  <para style="s">दानीयल ने तेरा दुस्‌तीदार</para>
  <para style="r">(<ref loc="DAN 1:1-6:28">दानीयल 1:1—6:28</ref>)</para>
  <para style="s">नबुकदनेस्‌सरेन राजान दरबार मां जुवान अदमी</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 1:1" />यहुदान राजु यहोयाकीमेन राजेन तीसरे साल मां बेबीलोन राजा, नबुकदनेस्‌सर, राजा ने यरुसलेम सहर पर, उपर चहड़ीन तीनाक घेरवी लेदु।<note caller="+" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="2KI 24:1">2 राजा 24:1</ref>; <ref loc="2CH 36:5-7">2 ईतीहास 36:5-7</ref></char></note> <verse eid="DAN 1:1" /><verse number="2" style="v" sid="DAN 1:2" />यहोवा भगवान हीना राजा यहोयाकीम काजे धरने ने मंदीरेन थुड़ाक ठाहरा काजे धरने देदु ने चु थुड़ाक केद्‌या काजे आपणे साते बेबीलोन मां आपणा देवतान मंदीर मां ली गुयु, ने धरीन लावला ठाहरा काजे मंदीरेन भंडार घर मां मेक देदु।<verse eid="DAN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="DAN 1:3" />तत्‌यार राजु आपसा खास मुख्‌या असपनज काजे हुकुम आप्‌यु की, तु इस्‌राएली राज घराणा ने मटली कुळीन थुड़ाक माणसे काजे मारी चाकरी करने करीन ली आव;<note caller="+" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="2KI 20:17">2 राजा 20:17</ref></char></note> <verse eid="DAN 1:3" /><verse number="4" style="v" sid="DAN 1:4" />जे असा जुवान्‌या हवणु चाहजे तींद्‌रेम कांय बी खुड़ नी हवणु चाहजे, घाटाळा हवणु चाहजे, आखी वात सीकणेन ताकत हवणु चाहजे, वारु माहती राखण्‌या हवणु चाहजे, बाकुन समजणे वाळा हवणु चाहजे। ने राजान बंगला मां सेवा करे असा हवणु चाहजे, चु तीनुक बुलाय लायु, ने मुख्‌या काजे हुकुम आप्‌यु की तुहुं हीनुक बाबुल मां रवण्‌यान बुली ने आखी भातीन लिखा पुड़ी करन्‌यु सीकाड़्‌यु। <verse eid="DAN 1:4" /><verse number="5" style="v" sid="DAN 1:5" />ने राजु हुकुम आप देदु की, तीनुक खाणे ने पीणे वाटे अंगुरेन रस मां सी तीनुक दाहड़ीन खाणे पीणे वाटे देणु चाहजे। तेरेसी तीन साल लग तीनुक सीकाड़तु रवे, ती पछेन चे राजा अगळ हजुर हवे। <verse eid="DAN 1:5" /><verse number="6" style="v" sid="DAN 1:6" />तींद्‌रेम यहुदान अवल्‌यातेम सी नेवाड़ला हतला, चे जे छे, दानीयल, हनन्‌याह, मीसाएल, ने अजर्‌याह नावेन यहुदी माणसे हतला। <verse eid="DAN 1:6" /><verse number="7" style="v" sid="DAN 1:7" />ने खास मुख्‌या तींद्‌रो दीसरो नाव पाड़्‌या, मतलब दानीयलेन नाव चु बेलतसस्‌सर, हनन्‌याह नाव सदरक, मीसाएल नाव मेसक, ने अजर्‌याह नाव अबेदनगो पाड़्‌या।<verse eid="DAN 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 1:8" />बाकुन दानीयल आपसा मन मां मान लेदु की चु नी राजान खाणो खाय ने नी अंगुरेन रस पीन ईटळे; तेरेमां चु खास मुख्‌या असपनज सी लीलघायु की चु ईटाळे नी। <verse eid="DAN 1:8" /><verse number="9" style="v" sid="DAN 1:9" />भगवान मुख्‌या पुजारान मन मां दानीयल वाटे गीण-दया भर देदु।<note caller="+" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="GEN 39:21">उबजाणनी किताप 39:21</ref></char></note> <verse eid="DAN 1:9" /><verse number="10" style="v" sid="DAN 1:10" />ने खास मुख्‌या दानीयल काजे कह्‌यु, “मे मारा मालीक राजा सी बीह्‌यो, काहाकी हामरो खाणो-पीणो मारु मालीक राजु नक्‌खी करलु, कांखुर मायन असो नी हवे की चु तारो मुंहडो तार भेळे जुवान्‌या सी उतारलु ने नाराज देखे, ने मारो मुणको राजु काट नाखसे।”<verse eid="DAN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 1:11" />तत्‌यार दानीयल तीना मुख्‌या असपनज काजे तीना मुखी दानीयल, हनन्‌याह ने, मीसाएल, ने अजर्‌याह गुवाळी करने करीन ठेरावलु कह्‌यु, <verse eid="DAN 1:11" /><verse number="12" style="v" sid="DAN 1:12" />“मे तुसेक लीलघायन कहों की, तारा पावर्‌यान दस दाहड़ा लग पारख कर, की चु हामुक खाणे करीन भाजी-पालु ने पीणे करीन पाणी आप्‌या कर।” <verse eid="DAN 1:12" /><verse number="13" style="v" sid="DAN 1:13" />अळतेन दस दाहड़ा वीतणेन हामरा जी मुंहडा ने जुवान्‌या राजान खाणो खातला छे, तींद्‌रा मुंहडाक देखीन, ने जसा तुसेक देखाय देय, तींद्‌रे अनसारे आपसा पावर्‌या सी वेहवार करजी।<verse eid="DAN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 1:14" />तींद्‌री जी दुवा चु मान लेदु, ने दस दाहड़ा तक तीनुक पारेखतु रयु। <verse eid="DAN 1:14" /><verse number="15" style="v" sid="DAN 1:15" />दस दाहड़ा वीत गुया ने तींद्‌रा मुंहडाक राजान खाणो खाणेवाळा आखा जुवान्‌या सी बेसका वारु ने मातला देखाय देय। <verse eid="DAN 1:15" /><verse number="16" style="v" sid="DAN 1:16" />तत्‌यार चु मुख्‌यु तींद्‌रो खाणो ने तींद्‌रो पीणेन पाणी वाटे नक्‌खी करलो अंगुरेन रस दुयु हापकीन, तीनुक भाजी-पालु देणे बाजी गुया।<verse eid="DAN 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 1:17" />ने भगवान तीनु चारु जुवान्‌या काजे आखा सीके ने आखी भातीन सीके मां अक्‌कल वाळा ने अक्‌कलेन सीक आप्‌यु; ने दानीयल आखी भातीन सातायली वात ने सपनान मतलब बताड़न्‌यु हय गुयु।<verse eid="DAN 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 1:18" />तत्‌यार जतरा दाहड़ा नक्‌खी करला ततरा दाहड़ा वीत गुया ने अळी राजु नबुकदनेस्‌सर तीनुक माहें लावणेन हुकुम आप्‌यु, ने खास मुख्‌यु असपनज तीनुक राजा अगळ ली गुयु। <verse eid="DAN 1:18" /><verse number="19" style="v" sid="DAN 1:19" />ने राजु तींद्‌रे सी वात वीच्‌यार करने बाजी गुयु, ने दानीयल, हनन्‌याह, मीसाएल, ने अजर्‌याह भीणी तीनु आखा मां सी काहनुक नी नक्‌खी कर्‌यु, हेरेसी चे राजा भीणी हजुर रवणे बाजी गुया। <verse eid="DAN 1:19" /><verse number="20" style="v" sid="DAN 1:20" />ने अक्‌कल आखी भातीन समजेन बारामां जो काय राजु तींद्‌रे सी पुछतेलु तींद्‌रे मां आखा देसेन रासी देखणे वाळा ने जादु टुना सी दस गुणा अक्‌कल वाळा मानायतेला। <verse eid="DAN 1:20" /><verse number="21" style="v" sid="DAN 1:21" />ने दानीयल धनवान दरबार मां तत्‌यार लग रयु, जत्‌यार लग फारसेन राज करन्‌यु कुस्‌रु बेबीलोन पर जीत हात नी कर लेदु।<verse eid="DAN 1:21" /></para>
  <chapter eid="DAN 1" />
  <chapter number="2" style="c" sid="DAN 2" />
  <para style="s">नबुकदनेस्‌सरेन सपनो</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 2:1" />नबुकदनेस्‌सर राजु आपसा राजेन बारामां दीसरे साल बेसको वारु सपनो देख्‌यु, ने जाग गुयु ने तेरु जीव घाबराय गुयु, ने तीनाक नींदुत नी आवी। <verse eid="DAN 2:1" /><verse number="2" style="v" sid="DAN 2:2" />तत्‌यार राजु हुकुम आप्‌यु, की रासी देखण्‌या, बड़वाय-भुपाय करने वाळा काजे बुलावु की चे राजा तेरा सपनान मतलब देखाड़े; तेरेमां चे आवे ने राजा अगळ हजुर हवे। <verse eid="DAN 2:2" /><verse number="3" style="v" sid="DAN 2:3" />तत्‌यार राजु तीनुक कह्‌यु, “मे एक सपनो देख्‌यु, ने मारो मन बेसकु परेसान हय ज्‌यु, की मे तीना सपनाक कसु समजो।”<verse eid="DAN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 2:4" />तत्‌यार कसदी माणसे राजा सी अरामी बुली मां कह्‌या, “ए राजा, तु जलम जीवतेलु रह्‌वे! तारा चेलाक सपनो देखाड़, ने हामु तेरो मतलब देखाड़सुन।”<note caller="+" style="f"><char style="fr" closed="false">2:4 </char><char style="ft" closed="false">जां सी सातवा पाटेन आकरी लग काम मां लाई गुई बुली ईब्‌रानीयो मां नी हय अरामी बुली छे।</char></note><verse eid="DAN 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 2:5" />राजु कसदी माणसे काजे जपाप आप्‌यु, “मे जी हुकुम आप देदु की, कदी माणसे तुहुंं सपनान मतलब नी देखाड़ु, ती तुहुंं काजे मारायन बटका-बटका कर देसे, ने तुंद्‌रा घर काजे उजाड़ देसे। <verse eid="DAN 2:5" /><verse number="6" style="v" sid="DAN 2:6" />कदी तुहुंं फळ समेत सपना काजे देखाड़ देवु, ती तुहुंं भाती-भातीन दान ने मटली ईज्‌जत हात करसु। ने मटा-मटा फळ हात करसु करीन तुहुंं मेसेक सपनान मतलब देखाड़ु।”<verse eid="DAN 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 2:7" />चे दीसरी कावा अळी कह्‌या, “ए राजा सपनो तारा चाकर्‌या काजे देखाड़ु, ने हामु तेरो मतलब समजाड़ देसुन।”<verse eid="DAN 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 2:8" />राजु जपाप आप्‌यु, “मे पाक्‌को जाणो की तुहुंं जो देख्‌या, की राजान मुंहडाम सी जी हुकुम नीकळी गुय की, राजान टेम बड़ावणे चाही रया। <verse eid="DAN 2:8" /><verse number="9" style="v" sid="DAN 2:9" />तेरेमां कदी तुहुंं मेसे सपनो नी देखाड़ो ती तुंद्‌रे वाटे एकुत हुकुम छे। काहाकी तुहुंं एकु कर्‌या हसे की जत्‌यार लग टेम नी बदले, तत्‌यार लग हामु राजा अगळ झुटी वात कर्‌या करसुन। तेरेमां तुहुंं मेसे मारो सपनो देखाड़ु, तत्‌यार मे जाणीस की तुहुंं तेरा फळेन मतलब बी देखाड़ सक्‌सु।”<verse eid="DAN 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 2:10" />कसदी माणसे राजा सी कह्‌या, “ईनी धरती पर असु काहनु माणुस नी हय, जु राजान मन मां काय छे, चो देखाड़ सके। ने नी काहनुक असु राजु हय नीते डाहलु मुखी हय नीते सीपायड़ु हय जु काहनाक हात देखण्‌याक, नीते मंतर नीते जादु सी असी वात पुछला हय। <verse eid="DAN 2:10" /><verse number="11" style="v" sid="DAN 2:11" />जी वात राजु पुछतेलु तसी वात दीसरा काहना बी भीणी नी हय, ने देवता काजे छुड़ीन तींद्‌रो रह्‌णु माणसे साते नी हय, ने काहनुक दीसरु नी हय, जु राजा काजे जो बताड़ सके।”<verse eid="DAN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="DAN 2:12" />तींद्‌री वात सामळीन राजु बेसकु रीसवाय गुयु, ने बेबीलोन सहर मां रवण्‌या आखा अक्‌कल वाळाक मार नाखणेन हुकुम आप देदु। <verse eid="DAN 2:12" /><verse number="13" style="v" sid="DAN 2:13" />हेरेसी जु हुकुम नीकाळ्‌यु, ने जानकार्‌या माणसे काजे मार नाखणे करीन, माणसे दानीयल काजे ने तेरा दुस्‌तीदार्‌या काजे हेरने बाजी रह्‌ला की तीनुक बी मार नाखु।<verse eid="DAN 2:13" /></para>
  <para style="s">भगवानेन साहरे दानीयल काजे सपनान मतलब उजेंतो करे</para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 2:14" />तत्‌यार दानीयल, राजान राखवाळ्‌यान मुखी अर्‌योक सी, जो बेबीलोनेन जानकार्‌या माणसे काजे मारने करीन नीकळी रवला, सुचीन वीच्‌यार कर्‌या ने अक्‌कल सी वात कर्‌या। <verse eid="DAN 2:14" /><verse number="15" style="v" sid="DAN 2:15" />ने राजान मुख्‌या अर्‌योक सी पुछ्‌या की, “जु हुकुम राजा भीणी सी अतरी उतवाळ सी काहा नीकाळ्‌यु?” तत्‌यार अर्‌योक दानीयल काजे तेरो मतलब देखाड़ देदु।<verse eid="DAN 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="DAN 2:16" />ने दानीयल राजान कीला मां गुयु, ने राजा सी लीलघायन कह्‌यु, की तेरे वाटे एक टेम नक्‌खी करनु चाहजे, ती चु मटला राजा काजे सपनान मतलब देखाड़ देसे। <verse eid="DAN 2:16" /><verse number="17" style="v" sid="DAN 2:17" />तत्‌यार दानीयल आपसान घर जाय्‌न, आपसा दुस्‌तीदार्‌या हनन्‌याह, मीसाएल, ने अजर्‌याह काजे ची आखी वात देखाड़्‌यु, <verse eid="DAN 2:17" /><verse number="18" style="v" sid="DAN 2:18" />ईनी वातेन बारामां सरगेन भगवानेन गीण-दया वाटे जो कय्‌न दुवा करु, की बेबीलोन ने आखा जानकार्‌या साते दानीयल ने आपसा दुस्‌तीदार्‌या काजे बी नी खत्‌तम नी करे। <verse eid="DAN 2:18" /><verse number="19" style="v" sid="DAN 2:19" />तत्‌यार जी वात दानीयल काजे रातेन सपनान साहरे उजेंती हय। तत्‌यार दानीयल ने सरगेन भगवान काजे तु बेसकु वारु छे कह्‌यु,<verse eid="DAN 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="DAN 2:20" />दानीयल कह्‌यु भगवानेन नाव जलमको वारु छे,</para>
  <para style="q2" vid="DAN 2:20">काहाकी अक्‌कल ने बड़ाय तेरीत छे।<verse eid="DAN 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="DAN 2:21" />टेमे ने सीजन काजे हयुत बदले;</para>
  <para style="q2" vid="DAN 2:21">राजा काजे बदले बी ने बीगाड़ बी देय;</para>
  <para style="q2" vid="DAN 2:21">अक्‌कल वाळा काजे अक्‌कल ने समजणे वाळा काजे समज बी हयुत आपे।<verse eid="DAN 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="DAN 2:22" />हयुत सातायली वात काजे ने सातायली वाट काजे उजेंतु करे,</para>
  <para style="q2" vid="DAN 2:22">ने चु जाणे की आंदारला मां काय छे,</para>
  <para style="q2" vid="DAN 2:22">ने तेरे पुठे जलम वीजाळो बणीन रह्‌वे।<verse eid="DAN 2:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="DAN 2:23" />ए मारा आड़ा-बुड़ान भगवान, मे तुसेक बेसकु वारु कह्‌वो ने तारी भक्‌ती करो,</para>
  <para style="q1" vid="DAN 2:23">काहाकी तु मेसेक अक्‌कल ने सक्‌ती आपलु छे,</para>
  <para style="q2" vid="DAN 2:23">“जेरी वातेन खुलासु हामु तारे धड़े मांगला,</para>
  <para style="q2" vid="DAN 2:23">तीनाक तु मारे पर उजेंतु करलु छे, तु हामुक राजान वात देखाड़लु छे।”<verse eid="DAN 2:23" /></para>
  <para style="s">दानीयल काजे राजान सपनान मतलब बताड़नु</para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 2:24" />तत्‌यार दानीयल अर्‌योक धड़े, तीनाक राजा बेबीलोन सहरेन जानकार्‌या काजे खत्‌तम करने करीन ठेहरावलु छे, घर मां जाय्‌न कह्‌या, “बेबीलोनेन जानकार्‌या काजे खत्‌तम मां कर, मेसेक राजा अगळ घर मां ली चाल, मे फळ बताड़ीस।”<verse eid="DAN 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 2:25" />तत्‌यार अर्‌योक दानीयल काजे राजान तसु मामार घर मां ली जाय्‌न तीनाक कह्‌यु, “यहुदी जेल मां सी एक अदमी मेसेक भेळु हयु, चु राजा काजे सपनान मतलब देखाड़से।”<verse eid="DAN 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="DAN 2:26" />राजु दानीयल सी पुछ्‌यु, तेरो नाव बेलतसस्‌सर बी हतलो, पुछ्‌यु, “काय तारेम अतरी ताकुत छे, काय की जो सपनो मे देख्‌यु, तीनाक तु मतलब समेत मेसेक देखाड़ सके?”<verse eid="DAN 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="DAN 2:27" />दानीयल राजा काजे जपाप आप्‌यु, “जी वात राजा पुछ्‌ये, चो नी ते जानकार्‌या, नीते जादु-टुना करन्‌या, नी रासी देखण्‌या, नी दीसरा हात देखण्‌या राजा काजे देखाड़ सके।” <verse eid="DAN 2:27" /><verse number="28" style="v" sid="DAN 2:28" />बाकुन वात काजे उजेंतु करन्‌यु भगवान सरगे मां छे; ने हयुत नबुकदनेस्‌सर राजा काजे कह्‌यु की, आकरी दाहड़ा मां काय-काय हवसे। तारो सपनो ने जो काय तु सुवतु जाय्‌न देख्‌यु, चो जो छे:<verse eid="DAN 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 2:29" />ए राजा तुसेक सुवणी घड़ी जो वीच्‌यार आयो की आवणे वाळा टेम मां काय-काय हवणे वाळो छे, तत्‌यार वात काजे उघाड़ने वाळा तुसेक देखाड़्‌या की, काय-काय हवणे वाळो छे। <verse eid="DAN 2:29" /><verse number="30" style="v" sid="DAN 2:30" />मार पर जी वात ईनी वजे सी नी उजेंती हय की मे आखा जीवतेला माणसे सी अधु अक्‌कल वाळु छे, बाकुन ईनीत वजे सी उजेंती हय की सपनान मतलब राजा काजे देखाड़ सको, ने तु आपसान मन मां वीच्‌यार समजी सके।<verse eid="DAN 2:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="DAN 2:31" />“ए राजा, तत्‌यार तु सपनो देखतेलु, तत्‌यारुत एक मटली मुरती देखाव पड़ी, ने ची मुरती जी मार अगळ उभी हय रह्‌ली, ची बेसकी लांबी चवड़ी हतली, तेरी चमक बेसकी हतली, ने तेरो बणावट बीहाड़े असो हतलो। <verse eid="DAN 2:31" /><verse number="32" style="v" sid="DAN 2:32" />तीनी मुरतीन मुणको ते चुखला सनान हतला, तेरी छाती ने दुह्‌यु बाहळा चांदीन ने तेरो पेट ने सातळ्‌या पीतळेन हतला, <verse eid="DAN 2:32" /><verse number="33" style="v" sid="DAN 2:33" />हेरा पाय लुहड़ान छे, नीते हेरा पाय थुड़ाक लुहड़ान नीते थुड़ाक हीस्‌सा धुळान छे। <verse eid="DAN 2:33" /><verse number="34" style="v" sid="DAN 2:34" />अळतेन देखता-देखता, तु काय देख्‌या की, एक दगड़ा काजे काहनुक बी नी खुद्‌यु ने आपसुत उखळीन तीनी मुरतीन पायेन्‌चा लागीन जी लुहड़ान ने धुळान हतली, तीनुक छेदर्‌या-छेदर्‌या कर देदु। <verse eid="DAN 2:34" /><verse number="35" style="v" sid="DAN 2:35" />तत्‌यार लुहड़ो, धुळु, पीतळ, चांदी ने सोनो बी आखो छेदर्‌या-छेदर्‌या हय गुयो, ने तप माय्‌न ने खळदाण मायन चारान तसो असो उडी गुयो की तेरु पतु बी नी चाल्‌यु, ने चु दगड़ु जु मुरती पर लागलु हतलु, चु मटलु बयड़ु बणीन आखी धरती पर पाखराय गुयो।<verse eid="DAN 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="DAN 2:36" />“सपनो ते जत छे, ने हंय हामु तींद्‌रा सपनान मतलब राजा काजे समजाड़ देसुन। <verse eid="DAN 2:36" /><verse number="37" style="v" sid="DAN 2:37" />ए राजा, तु ते आखा राजा पर राज करन्‌यु मटु छे, काहाकी सरगेन भगवान तुसेक राज, सक्‌ती, ताकत ने सेक-सींगार आप्‌यु। <verse eid="DAN 2:37" /><verse number="38" style="v" sid="DAN 2:38" />ने जां बी माणसे छे, चां तीनु आखा काजे, ने खयड़ान आखा जीवे, ने जानवर्‌या ने सरगेन चिरला बी तारा हक मां कर देदा; ने तुसे काजे तीनु आखान हकवाळु ठेहरायु। जां सनान मुणको तुत छे। <verse eid="DAN 2:38" /><verse number="39" style="v" sid="DAN 2:39" />तेर पछेन एक राज्‌य अळी पयदा हवसे जो तार सी नान्‌लो हवसे, अळतेन एक अळी तीसरो राज पीतळेन तसो हवसे, तेरेम आखी कळजुग आय जासे। <verse eid="DAN 2:39" /><verse number="40" style="v" sid="DAN 2:40" />चवथो देस लुहड़ान तसो काठो हवसे, ने लुहड़ा सी आखी चीज छेदर्‌या-छेदर्‌या हय जासे, ने दळाय जाय। हेरेसी तीना तरीका सी लुहड़ा सी चो आखो कुचाय जाय, हीना तरीका सी तीना चवथा देस सी आखो काही छेदर्‌या-छेदर्‌या हयन दळाय जासे। <verse eid="DAN 2:40" /><verse number="41" style="v" sid="DAN 2:41" />तुहुंं जी मुरती पाये ने तींद्‌री आंगळी काजे देख्‌या, जो काही कुम्‌हारेन धुळान हतली, ने काहलीक लुहड़ान मुरती हतली, तींद्‌रे सी चो चवथो देस वाटायलो हसे: तेबी तेरेमां लुहड़ान तसो काठो रह्‌से, जसा की तुहुंं कुम्‌हारेन धुळा साते लुहड़ो बी भेसकायलो देख्‌या हसे। <verse eid="DAN 2:41" /><verse number="42" style="v" sid="DAN 2:42" />जसी पायेन आंगळी काहलीक ते लुहड़ान हतली, ने काहलीक धुळान हतली, तेरो मतलब जो छे, की चो देस काहनीक जागे ते काठो हतलो, हसे ने काहनीक जागे कमजुर हतलो हसे। <verse eid="DAN 2:42" /><verse number="43" style="v" sid="DAN 2:43" />तुहुंं तीना लुहड़ाक कुम्‌हारेन धुळा साते भेसकायलो ते देख्‌या हसे, तेरेसी तेरो मतलब जो छे, की तीना राजेन माणसे एक दीसरा माणसे साते परम सी ते रवसे, बाकुन जसो लुहड़ो धुळा साते भेसकाय नी सके तसोत चे बी एक दीसरा साते परम मां बणीन नी रवे। <verse eid="DAN 2:43" /><verse number="44" style="v" sid="DAN 2:44" />तीनु राजान दाहड़ा मां सरगेन भगवान, एक असो राज बणावसे जो जलम तक खत्‌तम नी हवे, ने नी चो दीसरा माणसेन हात मां आपसे बाकुन चो तीनु आखा देस काजे छेदर्‌या-छेदर्‌या कर देसे, ने तीनुक आखा काजे खत्‌तम कर देसे, ने चो जलम टेकीन रह्‌से। <verse eid="DAN 2:44" /><verse number="45" style="v" sid="DAN 2:45" />जसु तु देख्‌यु एक दगड़ु काहनाक ने हाते पाखुर बयड़ाम सी उखळे, ने चु लुहड़ा, पीतळ, धुळु, चांदी, ने सना काजे छेदर्‌या-छेदर्‌या कर्‌या, ईनीत रीती मटु भगवान राजा काजे बताड़्‌यु की हेरे पछेन काय हवणे वाळो छे। ने नी सपना मां ने नी तेरा फळ मां संका हय।”<verse eid="DAN 2:45" /></para>
  <para style="s">राजान साहरे दानीयलेन आव-भाव करनु</para>
  <para style="p">
    <verse number="46" style="v" sid="DAN 2:46" />अतरो सामळीन नबुकदनेस्‌सर राजु मुंहडान भुरसे धरती पर हीट पड़्‌यु, ने दानीयल काजे आंध्‌यु, ने हुकुम आप्‌यु की तीनाक बादा आपु, ने तींद्‌रे अगळ गंदायणी चीज काजे धपाड़ु। <verse eid="DAN 2:46" /><verse number="47" style="v" sid="DAN 2:47" />अळी राजु दानीयल काजे कह्‌यु, “छाची ते जी छे, की तुंद्‌रु भगवान आखा भगवानेन भगवान, राजान राजु, ने रासी देखणे वाळु‌ छे, हेरेसी तु जी वात उजेंतु कर देदु।” <verse eid="DAN 2:47" /><verse number="48" style="v" sid="DAN 2:48" />तत्‌यार राजु दानीयलेन पद काजे मटु कर देदु, ने तीना काजे बेसका मटा-मटा भेट आप्‌या; ने जो हुकुम आप्‌यु की चु बेबीलोनेन आखा जीला पर सरदार ने बेबीलोनेन आखा जानकार्‌या डाहला मुखी बण्‌या। <verse eid="DAN 2:48" /><verse number="49" style="v" sid="DAN 2:49" />तत्‌यार दानीयल राजु लीलघायन कह्‌णे सी पेहलुत राजु सदरक, मेसक, ने अबेदनगो काजे बेबीलोन राजेन काम उपर नक्‌खी कर देदु: बाकुन दानीयल आपसुत राजान महल मां रया करतेलु।<verse eid="DAN 2:49" /></para>
  <chapter eid="DAN 2" />
  <chapter number="3" style="c" sid="DAN 3" />
  <para style="s">सनान मुरती</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 3:1" />नबुकदनेस्‌सर राजु सनान एक मुरती बणायु, ची सांठ हात उंची हतली, ने तेरी चवड़ाय छव हात हतली। चु तीनी मुरती काजे बेबीलोन राजेन दुरा नावेन खळदाण मां उबु कराड़्‌यु। <verse eid="DAN 3:1" /><verse number="2" style="v" sid="DAN 3:2" />अळतेन नबुकदनेस्‌सर राजु, हकदार्‌याक, राज करन्‌याक, मुख्‌याक, राय आपण्‌याक, पयस्‌या-टकान हीसाब राखण्‌याक, नीयाव करन्‌याक जीलान हकदार्‌या ने दीसरा राजेन आखा हकदार्‌याक बुलाय मांग्‌यु। ने हेरेसी की चे राजान साहरे उभी करली मुरतीन उजघाटन करनेन मीटींग मां हीस्‌सु लेसे। <verse eid="DAN 3:2" /><verse number="3" style="v" sid="DAN 3:3" />अळतेन राजा नबुकदनेस्‌सरेन साहरे उभी कराड़ली मुरतीन उजघाटन करनेन मीटींग मां हीस्‌सु लेणे करीन हकदार्‌या, राज करन्‌या, मुख्‌या, राय आपण्‌या, पयस्‌या टकान हीसाब राखण्‌या, नीयाव करन्‌या, जीलान हकदार्‌या ने दीसरा राजेन आखा हकदार्‌या भेळा हया। <verse eid="DAN 3:3" /><verse number="4" style="v" sid="DAN 3:4" />तत्‌यार चवकीदार जुर-जुर सी आयड़ीन कह्‌यु, ए राज-राजेन माणसे, ने भाती-भातीन बुली बुलने वाळा, तुहुंं काजे जो हुकुम सामळावे की, <verse eid="DAN 3:4" /><verse number="5" style="v" sid="DAN 3:5" />तीनी टेमे तुहुंं फेपार्‌या, पावळी, तुमड़ु, सारंगी, सीतार, सहनाइ आखी भातीन वाजा सामळु, तुहुंं तत्‌यारुत पायें पड़ीन नबुकदनेस्‌सर राजा उबी कराड़ली सनान मुरती काजे आंदु। <verse eid="DAN 3:5" /><verse number="6" style="v" sid="DAN 3:6" />ने जु काहनुक मांडा टेकीन नी आंधे तीना काजे तत्‌यारुत धपतेला आकठान भाटान ईचमां नाख देसे। <verse eid="DAN 3:6" /><verse number="7" style="v" sid="DAN 3:7" />हेरे वजे सी तीनी टेमे जसात आखा माणसे काजे, फेफर्‌या, पावळीन तुमड़ु, सारंगी, सीतार, सहनाइ आखा भातीन वाजान अवाज सामळाय पड़ी, तसात राज-राजेन आखा माणसे ने भाती-भाती बुली बुलनेवाळा ढंगा वळीन तीनी सनान मुर्‌ती काजे, जे नबुकदनेस्‌सर राजु उभी कराड़ने वाळु हतलु, आंध्‌या।<verse eid="DAN 3:7" /></para>
  <para style="s">दानीयलेन दुस्‌तीदार पर हुकुम नी मान्‌नेन गुनु</para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 3:8" />तीनीत टेमे बेसका कसदी नावेन माणसे राजान्‌चां आया, ने मटाय सी यहुदी माणसेन बारामां चुगली कर्‌या। <verse eid="DAN 3:8" /><verse number="9" style="v" sid="DAN 3:9" />चे राजा नबुकदनेस्‌सर सी कह्‌या, “ए राजा, तु जलम जीवतेलु रवसी।” <verse eid="DAN 3:9" /><verse number="10" style="v" sid="DAN 3:10" />ए राजा, तु असु हुकुम आपलु की जे फेफर्‌या, पावळी, तुमड़ु, सारंगी, वीणवाजो, ने अळी आखी भातीन वाजो वाजतेलो सामळे, ती चे पांये पड़ीन मार साहरे बणाय मांगली मुरतीन पुजा पाट करजु; <verse eid="DAN 3:10" /><verse number="11" style="v" sid="DAN 3:11" />ने जु काहनुक मांडा टेकीन मुरती काजे नी आंधे, तीनाक चु धपला आकठान भाटा मां नाख देसे। <verse eid="DAN 3:11" /><verse number="12" style="v" sid="DAN 3:12" />देखु सदरक, मेसक, ने अबेदनगो नावेन थुड़ाक यहुदी माणसे छे, तीनुक तु बेबीलोनेन देस मां काम करने नक्‌खी करलु छे। चे माणसे, ए राजा तारी हुकुमेन काही बी फीकुर नी कर्‌या चे तारा देवतान पुजा पाट नी करे, ने जो तु सनान मुरती तु उभी करलु तीनीक नी आंदता।<verse eid="DAN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 3:13" />तत्‌यार नबुकदनेस्‌सर रीसवाय गुयु, ने हुकुम आप्‌यु, की सदरक, मेसक ने अबेदनगो काजे लावु तत्‌यार चे माणसे राजा अगळ लाया ने अगा कर्‌या। <verse eid="DAN 3:13" /><verse number="14" style="v" sid="DAN 3:14" />नबुकदनेस्‌सर राजु तीनुक पुछ्‌यु, “ए सदरक, मेसक ने अबेदनगो, तुहुंं मारी देवधाणीन पुजा पाट नी करता ने मारी घड़ावीन उभी कराड़ली सोनान मुर्‌ती काजे नी आंदता, ती तुहुंं काय जाणी बुजीन असो करु?” <verse eid="DAN 3:14" /><verse number="15" style="v" sid="DAN 3:15" />कदी तुहुंं हंय तीयार हवु, की जत्‌यार फेपार्‌या, पावळी, तुमड़ु, सारंगी, सीतार, सहनाइ ने काहीं भातीन वाजान बुले सामळु, ने तीनीत घड़ी आडा पड़ीन मारी बणावली मुरती काजे आंदु, ती बची जासु; ने कदी तुहुंं आंदसु नी ती ईनीत घड़ी आकठान भाटा मां नाख देसे; अळतेन असो काहना देवता छे, जो तुहुंंक मार हात सी छुड़ाय सके?<verse eid="DAN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="DAN 3:16" />सदरक, मेसक, ने अबेदनगो ने राजा सी कह्‌या, “ए नबुकदनेस्‌सर, हेरे बारामां तुसेक काय जपाप आपणेन हामुक काय जरुड़ी नी हय।” <verse eid="DAN 3:16" /><verse number="17" style="v" sid="DAN 3:17" />हामरु भगवान, तेरी हामु भक्‌ती करजे, चु हामुक तीना धपतेला आकठान भाटाम सी वाचाड़नेन ताकत राखे; बाकुन ए राजा, चु हामुक तारा हातेम सी बी वाचाड़ सके। <verse eid="DAN 3:17" /><verse number="18" style="v" sid="DAN 3:18" />बाकुन कदी नी, ते ए राजा तुसेक मालुम छे, की हामरा माणसे तारा देवतान पुजा-पाट नी कर्‌या, ने नी तारी उभी करली सनान मुरती काजे आंधसे।<verse eid="DAN 3:18" /></para>
  <para style="s">दानीयलेन तीनु दुस्‌तीदार्‌या काजे मरनेन सजा सामळाय गुई</para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 3:19" />तत्‌यार नबुकदनेस्‌सर बेसकु रीसवाय गुयु, ने तेरा मुंहडान रंग सदरक, मेसक ने अबेदनगोन तसो हय गुयो। जु हुकुम आप्‌यु की आकठान भाटा काजे अळी सांत गुणा जादा धपाड़ देदा। <verse eid="DAN 3:19" /><verse number="20" style="v" sid="DAN 3:20" />अळी तींद्‌रा सीपायड़ान टुळा मां सी काहनाक एक ताकतवाळा माणुस काजे चु हुकुम आप्‌यु, की सदरक, मेसक ने अबेदनगो काजे बांधीन तीनुक धपतेला ईंगाळान आकठा मां नाख देवु। <verse eid="DAN 3:20" /><verse number="21" style="v" sid="DAN 3:21" />तत्‌यार चे माणसे आपसा मुज्‌या, झगल्‌या, टुपा ने अळी दीसरा पुथल्‌या भेळेत बांधीन, तीना आकठान भट्‌टा मां नाख देदा। <verse eid="DAN 3:21" /><verse number="22" style="v" sid="DAN 3:22" />चु धपतेलु आकठान भाटु ते राजान काठी हुकुम सी वदुस धपतो गुयो, तेरेसी तीनु माणसे काजे सदरक, मेसक ने अबेदनगो काजे हाकल्‌या, चीत धपतेला आकठान ईंगाळाम बळीन मर गुया। <verse eid="DAN 3:22" /><verse number="23" style="v" sid="DAN 3:23" />ने तीना धपतेला आकठान भाटान ईचमां तीनु अदमी काजे सदरक, मेसक ने अबेदनगो काजे बांदीन नाख देदा।<verse eid="DAN 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 3:24" />तत्‌यार नबुकदनेस्‌सर राजु चकराय गुयु ने घाबरायन उठ्‌यु, ने आपसा मदत करन्‌या काजे पुछणे बाजी गुयु, “काय हामु तीना आकठान ईचमां तीन अदमी बांदला नी नाख्‌या?”</para>
  <para style="p" vid="DAN 3:24">चे राजा काजे जपाप आप्‌या, “हव राजा, छाचली वात छे।”<verse eid="DAN 3:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 3:25" />ने अळी चु कह्‌यु, “हंय मे देखणे बाजी रयु की, चार माणुस आकठान ईचमां अथान-अथा हींडी-फीरी रया, ने तींद्‌रे काय बी नुकसाण नी हवतो, ने चोवथा माणसेन मुंहडो भगवानेन पुर्‌यान तसो छे।”<verse eid="DAN 3:25" /></para>
  <para style="s">दानीयलेन तीनु दुस्‌तीदार्‌यान ईज्‌जत करु</para>
  <para style="p">
    <verse number="26" style="v" sid="DAN 3:26" />पछेन नबुकदनेस्‌सर तीना धपतेला आकठान बारना धड़े जाय्‌न कह्‌णे बाजी गुयु, “ए सदरक, मेसक ने अबेदनगो, ए डाहला मुखी भगवानेन पावर्‌या, नीकळीन जां आवु!” जो सामळीन सदरक मेसक ने अबेदनगो आकठान ईचमां सी नीकळीन आया। <verse eid="DAN 3:26" /><verse number="27" style="v" sid="DAN 3:27" />जत्‌यार अदीकारीन मुखी, सीपायड़ु, राज करन्‌यु ने राजान मदत करन्‌यु, जे भेळा हवला, तीनु माणसे भीणी भाळ्‌या, तत्‌यार तींद्‌रा डीले मां आकठान असर नी देखायु; ने तींद्‌रा मुणकान एक बी कान्‌यो झुलसायो नी, ने नी तींद्‌रा मुज्‌या बी नी बीगड़्‌या, ने नी तींद्‌रेम धपणेन गंद हतली।<verse eid="DAN 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 3:28" />नबुकदनेस्‌सर राजु कह्‌यु कवणे बाजी गुयु, “वारु छे सदरक, मेसक ने अबेदनगोन भगवान चु आपसा सरगेन काहवाळ्‌या काजे मकलीन आपसा पावर्‌या काजे हेरेसी वाचाड़्‌या, काहाकी चे राजान हुकुम नी मान्‌या ने तार पर भुरसु कर्‌या, ने सुचीन आपसो डील बी आप्‌यु की हामु आपणा भगवान काजे छुड़ीन, काहना बी देवतान पुजा-पाट नी करजे ने नी आंदजे।”<verse eid="DAN 3:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 3:29" />तेरेमां हंय मे जी हुकुम आपो की राज-राजेन माणसे ने भाती-भातीन बुली बुलने वाळा मां सी जे काहनाक सदरक मेसक ने अबेदनगोनेन भगवानेन बुराई करसे, चु टुकड़ा-टुकड़ा हय जासे, ने तेरो घर बीगड़ीन ढेर हय जासे; काहाकी असो काहनो बी ने काहनु देवता नी हय जो ईनी रीती सी बचाड़ सके।<verse eid="DAN 3:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="DAN 3:30" />तत्‌यार राजु बेबीलोनेन देस सदरक, मेसक ने अबेदनगोन पद अळी उचु कर्‌यु।<verse eid="DAN 3:30" /></para>
  <chapter eid="DAN 3" />
  <chapter number="4" style="c" sid="DAN 4" />
  <para style="s">नबुकदनेस्‌सर दीसरो सपनो देख्‌यु</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 4:1" />नबुकदनेस्‌सर राजा भीणी सी ने राज-राजेन माणसे, ने भाती-भातीन बुली बुलने वाळा जतरा बी ईनी धरती पर रह्‌वे, तीनु आखा काजे जो खबर जड़ी: “तुहुंंक बेसकी सांती जड़े!” <verse eid="DAN 4:1" /><verse number="2" style="v" sid="DAN 4:2" />मेसेक ज वारु लाग्‌यो की आखाम सी जुर भर्‌यु भगवान मेसेक जी मटला सहलाण्‌या ने छेलभात्‌या काम देखाड़ला छे, तीनुक उजेंता करो।<verse eid="DAN 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="DAN 4:3" />तेरा देखाड़ला सहलाण्‌या असा मटा छे,</para>
  <para style="q1" vid="DAN 4:3">ने तेरा चमत्‌कार मां काय मटी ताकत उजेंती छे, तेरो राज ते जलम छे,</para>
  <para style="q1" vid="DAN 4:3">ने तेरी बड़ाय पीड़ीडीट बणीन रवे।<verse eid="DAN 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 4:4" />मे नबुकदनेस्‌सर मारा बंगला मां मे वारु ने खुसी ती रह्‌तेलु। <verse eid="DAN 4:4" /><verse number="5" style="v" sid="DAN 4:5" />मे असो सपनो देख्‌यु, की तीना सपना सी मे बीही गुयु, ने खाटली पर सुवतु-सुवतु मारा मन मां जो वीच्‌यार आयो ने जी वात मे देख्‌यु, तीनी वात सी मे घाबराय गुयु। <verse eid="DAN 4:5" /><verse number="6" style="v" sid="DAN 4:6" />तत्‌यार मे हुकुम आप्‌यु की बेबीलोनेन आखा जानकार्‌या मारा सपनान फळ बताड़ने वाटे मारे अगळ लावु। <verse eid="DAN 4:6" /><verse number="7" style="v" sid="DAN 4:7" />तत्‌यार जानकार्‌या, बड़वाय-भुपाय वाळा, कसदी ने सक्‌ती बताड़ने वाळा माहें आया, ने मे तीनुक मारा सपनो बताड़्‌यु बाकुन चे तेरो मतलब नी बताड़ सक्‌या। <verse eid="DAN 4:7" /><verse number="8" style="v" sid="DAN 4:8" />आकरी मां दानीयल मार अगळ आयु, ने तेरो नाव मारा देवतान नावेन वजे सी बेलतसस्‌सर पाड़लो हतलो, ने तींद्‌रेम चुखला भगवानेन जीव आत्‌मा रवतेली, ने मे तीनाक मारो सपनो जो बताड़ देदु: <verse eid="DAN 4:8" /><verse number="9" style="v" sid="DAN 4:9" />ए बेलतसस्‌सर, तु ते आखा हात देखण्‌यान मटु छे, मे जाणो की तारेमां चुखला देवतान आत्‌मा रहे, ने तु काहनी बी सातायली वात सी नी घाबराये; तेरेमां ज सपनो मे देख्‌यु तीनाक मतलब समेत मेसे बताड़ीन समजाड़ दे।<verse eid="DAN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 4:10" />जो सपनो मे खाटली पर देख्‌यु चो जो छे, मे देख्‌यु, की धरतीन ईचमां एक झाड़को उंगलो छे, ने चो झाड़को बेसको उचो छे। <verse eid="DAN 4:10" /><verse number="11" style="v" sid="DAN 4:11" />चो झाड़को मटो हयन बेसको काठो हय गुयो, ने तीना झाड़कान उचाय सरगे तक पुगी गुय, ने चो झाड़को धरतीन आखा खुणाम देखाय देय। <verse eid="DAN 4:11" /><verse number="12" style="v" sid="DAN 4:12" />तींद्‌रा पांटा वारका, ने तींद्‌रेम फळ लाग रह्‌ला, ने तीना झाड़कान फळ तीनु आखा वाटे खाणो हतलो। तीना झाड़का तळे खळदाण माय्‌न आखा जानवर्‌या काजे साहळु जड़तेलु, ने तेरा डाळ्‌या पर सरगेन आखा चिरला बठतेला, ने आखा चिरला ने जानवर्‌या काजे खाणे वाटे फळ जड़तेलो।<verse eid="DAN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 4:13" />“मे खाटली पर सुवते-सुवते सपना मां असु देख्‌यु, की एक चुखलु सरगे दुत सरगे सी उतरी आयु।” <verse eid="DAN 4:13" /><verse number="14" style="v" sid="DAN 4:14" />चु जुरेत आयड़ीन कह्‌यु, हीना झाड़काक काट नाखु, तेरा डाळ्‌या काजे बी काट नाखु, तेरा पान्‌टा बी पाड़ी देवु, ने तेरा फळ काजे बी खळवी देवु, ने जानवर तीना झाड़का तळे ती ढासी जाय, ने चिरला तीना झाड़कान पर सी उडी जाय। <verse eid="DAN 4:14" /><verse number="15" style="v" sid="DAN 4:15" />तेबी तीना झाड़कान खुटड़ा काजे मुळ समेत जागा मां छुड़ देवु, ने तीनाक लुहड़ा ने पीतळेन बांधण सी बांधीन खयड़ान नीळ्‌ळा चारा मां रहणी दे। च सरगेन उस्‌टा सी भीग्‌या करे, ने भुयमान चारु खाणे करीन खयड़ान ढुरे भेळे रहे। <verse eid="DAN 4:15" /><verse number="16" style="v" sid="DAN 4:16" />तेरो मन बदली जाय ने चु माणसेन तसु नी रह्‌वे, बाकुन जानवरेन तसु बण जाय, ने तेरे पर सात साल लग हीनीत हालात मां रह्‌वे। <verse eid="DAN 4:16" /><verse number="17" style="v" sid="DAN 4:17" />जी हुकुम तीना सरगे वाळा काहवाळ्‌या भीणी सी ने जी वात तीनु चुखला माणसेन बुल सी नीकळी, की जे जीवतेला छे, जाणी लेय की, डाहला मुखी पुजारा भगवान माणसेन राज मां राज करसे, ने तीना राज काजे तीनुक चाहजे तीनुक आपी बी सके, ने चु तीना नानला सी नानला माणसे काजे बी तीना राज पर नक्‌खी करी सके।<verse eid="DAN 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 4:18" />मे नबुकदनेस्‌सर राजु जत सपनो देख्‌यु, हेरेसी ए बेलतसस्‌सर, तु हेरो मतलब बताड़, काहाकी मारा राज मां अळी कुय जानकार्‌या हेरो मतलब मेसेक नी समजाड़ सक्‌या, बाकुन तारेम ते चुखला भगवानेन जीव आत्‌मा रह्‌वे, जी वजे तु तीनाक समजाड़ देसी।<verse eid="DAN 4:18" /></para>
  <para style="s">दानीयलेन साहरे सपनान मतलब बताड़नु</para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 4:19" />तत्‌यार दानीयल तेरो नाव बेलतसस्‌सर बी हतलो, हर घड़ी घाबरायतु रयु, ने सुच्‌तु-सुच्‌तु दुखी हय ज्‌यु। तत्‌यार राजु कवणे बाजी गुयु, “ए बेलतसस्‌सर, हीना सपना सी, नीते हीना मतलब सी दुखी मां हवे।”</para>
  <para style="p" vid="DAN 4:19">बेलतसस्‌सर कह्‌यु, “ए मारा मालीक, जो सपनो तारा दुसमन पर, ने हेरो मतलब तारा लड़ाय करन्‌या पर हवे!” <verse eid="DAN 4:19" /><verse number="20" style="v" sid="DAN 4:20" />तीना झाड़का काजे तु देख्‌यु, जो मटो ने काठो हय गुयो, ने तीना झाड़कान उचाय सरगे तक पुगी गुई, ने जो धरतीन आखा खुणाम देखाय देय। <verse eid="DAN 4:20" /><verse number="21" style="v" sid="DAN 4:21" />तीना झाड़कान पांटा वारका हतला, ने फळ बेसका हतला, ने तींद्‌रेम आखान फळ हतलो, तेर तळे धरतीन आखा जानवर रवतेला, ने तींद्‌रा डाळ्‌या पर सरगेन चिरला बठ्‌या करतेला।<verse eid="DAN 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="DAN 4:22" />ए राजा, चु तुत छे। तु मटु ने ताकुतवाळु हय ज्‌यु, तारी बड़ाय अधे ने सरग लग जाती रय, ने तारु राज धरतीन खुणे लग फेलायली छे। <verse eid="DAN 4:22" /><verse number="23" style="v" sid="DAN 4:23" />ए राजा, तु एक चुखला राखवाळ्‌या काजे सरग सी उतेरता ने असो कवता देख्‌यु की झाड़का काजे काट देवु ने तीनाक नास कर देवु, बाकुन तेरा खुटड़ा काजे जड़ समेत रहणी देवु, ने हीनाक लुहड़ा ने पीतळेन बांधण सी बांधीन खयड़ान नीळ्‌ळा चारान ईचमां रहणी दे; चु सरगेन उस्‌टा सी भीग्‌या करे, ने तेरो खयड़ान ढुरे भेळोत रहणेन छे; ने जत्‌यार लग सात साल तेर पर नी वीते, तत्‌यार लग तेरी असीत हालत रवसे।<verse eid="DAN 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 4:24" />ए राजा तेरो मतलब जो चुखलु भगवान मान लेदु, की राजा पर हवे, चो जो छे, <verse eid="DAN 4:24" /><verse number="25" style="v" sid="DAN 4:25" />की तुसेक माणसेन ईचमां सी नीकाळ देसे ने खयड़ान ढुरे भेळे रवसी; तु बेलेन तसु चारु चरसी ने सरगेन उस्‌टा सी भीगी जासी; ने सांत साल लग तारे पर वीतसे, जत्‌यार लग की तु जाण नी लेय की माणसेन राज मां मुखी भगवानुत राज करे, ने जीनाक चाहे तीनाक दी देय। <verse eid="DAN 4:25" /><verse number="26" style="v" sid="DAN 4:26" />तीना झाड़कान खुटड़ाक मुळ समेत छुड़नेन हुकुम छे, तेर मतलब ज छे की तेरो राज तेर वाटे बणीन रहे; ने जत्‌यार लग तु जाण लेसी की कळीन मालीक सरगेत मां छे,<note caller="+" style="f"><char style="fr" closed="false">4:26 </char><char style="ft" closed="false">की सरग मां राज करे</char></note> तत्‌यार तु फीर सी राज करसी। <verse eid="DAN 4:26" /><verse number="27" style="v" sid="DAN 4:27" />हेरेन करीन ए राजा, तु मारी जी वात मान ले, कदी तु पाप काजे छुड़ीन धरमेन काम करने लागे, ती गलत काम छुड़ीन भुळा माणसे पर दया करसी ती, ते वारु छे की तु असु करने सी सांती सी रवसी।<verse eid="DAN 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 4:28" />जो आखो काय नबुकदनेस्‌सर राजा पर कम हय गुयो। <verse eid="DAN 4:28" /><verse number="29" style="v" sid="DAN 4:29" />बारे महना वीतणे पर जत्‌यार चु बेबीलोन राजान बंगलान छत पर हींडणे बाजी रह्‌लु, तत्‌यार चु कह्‌णे बाजी गुयु, <verse eid="DAN 4:29" /><verse number="30" style="v" sid="DAN 4:30" />“काय जो मटलो बेबीलोन नी हय, तीनाक मेत मारी ताकत ने सक्‌ती सी राजधानी हवणे, ने आपसा मटा नावेन बड़ाय वाटे वसाल्‌लु?”<verse eid="DAN 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="DAN 4:31" />जो बुल राजान मुंहडाम सी नीकळी बी सक्‌यो ने सरगे सी अवाज सामळाय देदी की, “ए राजा नबुकदनेस्‌सर तारा बारामां जी हुकुम नीकळी की राज तारा हातेम सी नीकळी गुयो?” <verse eid="DAN 4:31" /><verse number="32" style="v" sid="DAN 4:32" />ने तु माणसेन ईचमां सी नीकळी जासी, ने खळदाण मायन जानवर साते रवसी, ने बेल साय चारु खासी, ने सात साल लग तारे पर वीतसे, जत्‌यार तु जाणी नी लेय की चुखलु भगवान माणसेन राज मां हक करसे, ने तीनुक चाहजे तीनु आपी देसे।<verse eid="DAN 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="DAN 4:33" />तीनी टेमे जो बुल नबुकदनेस्‌सर राजान बारामां पुरो हयो, चो माणसेन ईचमां सी नीकळी गुयो, ने बेलेन तसु चारु खाणे बाजी गुयो, ने आपसो डील सरगेन उस्‌टा सी भीगतेलो, जां लग की तेरा कान्‌या सरगेम उडण्‌या घुवड़ान पाखड़ान तसा हय गुया। ने तेरा नखड़्‌या चिरलान पायेन तसा वदी गुया।<verse eid="DAN 4:33" /></para>
  <para style="s">नबुकदनेस्‌सर भगवानेन बड़ाय करे</para>
  <para style="p">
    <verse number="34" style="v" sid="DAN 4:34" />तीनु दाहड़ान वीतणेन बात, मे नबुकदनेस्‌सर मारा डुळा सरग भीणी भाळ्‌यु, ने जु जलम जीवतेलु छे तेरी बड़ाय ने आव भाव असु कहीन करने लाग्‌यु:</para>
  <para style="q1" vid="DAN 4:34">तेरु राज जलम छे,</para>
  <para style="q2" vid="DAN 4:34">ने तेरु राज पीड़ी सी पीड़ी लग बणीन रवसे।<verse eid="DAN 4:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="DAN 4:35" />धरती पर रह्‌णे वाळा आखा तेरे अगळ काय नी मानाये,</para>
  <para style="q2" vid="DAN 4:35">ने चु सरगेन सेना ने धरती पर रह्‌णे वाळान</para>
  <para style="q2" vid="DAN 4:35">ईचमां आपसी मरजीन अनसारे काम करतेला छे,</para>
  <para style="q1" vid="DAN 4:35">ने कुय तीनाक रुकीन तीनाक नी कय सकतेला,</para>
  <para style="q2" vid="DAN 4:35">की तु जो काय कय देदलु छे।<verse eid="DAN 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="DAN 4:36" />तीनी टेमे, मारी अक्‌कल जां की चां रय गुय, ने मारा राजेन सेक-सींगार मार वाटे मारो वीजाळो ने मुकुट मार पर अळी आय गुयो। ने मारा मंतरी ने डाहला माणसे मेसेक भेळा हवणे करीन मार धड़े आया, ने मे मारा राज मां टीकीन रयु, ने मारी अळी जादा बड़ाय हवणे बाजी गुय।<verse eid="DAN 4:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="DAN 4:37" />हय मे नबुकदनेस्‌सर सरगेन राजान बड़ाय करो; ने तेरात गुणे गावो ने बड़ाय करो, काहाकी तेरा आखा काम छाचला छे, ने तेरा सब वेहवार नीयावेन छे, ने जे माणसे मटाय करीन चाले, तीनुक चु नेचु कर देय।<verse eid="DAN 4:37" /></para>
  <chapter eid="DAN 4" />
  <chapter number="5" style="c" sid="DAN 5" />
  <para style="s">बेलसस्‌सरेन खाणो</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 5:1" />बेलसस्‌सर नावेन राजु आपसा एक हजार मालदार धनवाळा माणसे वाटे मटली पंगत राख्‌यु, ने तींद्‌रा हजारु माणसे अगळ अंगुरेन रस पीदु। <verse eid="DAN 5:1" /><verse number="2" style="v" sid="DAN 5:2" />अंगुरेन रस पीतु-पीतु बेलसस्‌सर राजु हुकुम आप्‌यु की, सनान ने चांदीन जे कपास्‌या ने कटवरा तेरु बास जु नबुकदनेस्‌सर यरुसलेमेन मंदीर मां सी नीकाळ देदलु, तीनुक लावु की राजु मालदार धनवाळा माणसे ने राणी ने राखली बायरी आखी भेळे तीना ठाहरा मां सी पीदा। <verse eid="DAN 5:2" /><verse number="3" style="v" sid="DAN 5:3" />तत्‌यार चे सनान कपास्‌या ने कटेवरा यरुसलेम मां भगवानेन मंदीर मां सी नीकाळ्‌ळा हतला, चे लाया, ने राजु आपसा मालदार ने धनवाळा माणसे, ने राण्‌या, ने तेरी राखली समेत तेरेमां पीणे लाग्‌या। <verse eid="DAN 5:3" /><verse number="4" style="v" sid="DAN 5:4" />चे अंगुरेन रस पीदा ने सनान, ने चांदीन, ने पीतळ, ने लुहड़ान ने लाकड़ा ने दगड़ान देवतान भक्‌ती करतेला।<verse eid="DAN 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 5:5" />उचकाणुत एक माणसेन हात देखाव पड़्‌यु ने बंगलान चुनान दीवाल पर लिखणु सुरु कर देदु; चां दीवान वीजाळो आखा सी ज्‌यादा चमकी रवलो। ने राजान हात काजे लिखतेलु देख्‌यु। <verse eid="DAN 5:5" /><verse number="6" style="v" sid="DAN 5:6" />तीनाक देखीन राजु घाबराय गुयु, ने चु मन मां की मन मां घाबराय गुयु, ने तेरी कमरेन जुड़न ढीला पड़ ज्‌या, ने कापते-कापते तेरा घुटणा एक दीसरा सी टकरायणे बाजी गुया। <verse eid="DAN 5:6" /><verse number="7" style="v" sid="DAN 5:7" />तत्‌यार राजु जुर सी आयड़ीन बड़वाय-भुपाय करने वाळा ने दीसरा अळी हात देखणेवाळा काजे हजुर हवणे करीन हुकुम आप्‌यु। जत्‌यार बेबीलोनेन पुती वाचण्‌या धड़े आयु, तत्‌यार राजु तीनु सी कहणे लाग्‌यु, “ज काय चो लिखलो भणीन तेरो मतलब मेसेक समजाड़ तीनाक जामण्‌या रंगेन पुथल्‌या, ने तेरा गळा मां सनान माळु पेहरावसे; ने मारा राज मां तीसरु हयुत राज करसे।” <verse eid="DAN 5:7" /><verse number="8" style="v" sid="DAN 5:8" />तत्‌यार राजान आखा जानकार्‌या माणसे घर मां माहें आया, बाकुन तीना लिखला काजे कुई बी नी भणी सक्‌या, ने नी राजा काजे तेरो मतलब समजाड़ सक्‌या। <verse eid="DAN 5:8" /><verse number="9" style="v" sid="DAN 5:9" />तेरेसी बेलसस्‌सर राजु बेसकु घाबराय गुयु, ने बेसकु बीही गुयु, ने तींद्‌रु मुख्‌यु बी बेसकु उदास हय गुयु।<verse eid="DAN 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 5:10" />राजान माय मुख्‌यान वात सामळीन, खाणो बणावतेला घर मां आवी ने कवणे बाजी गुय, “ए राजा, तु जलम जीवतेलु रवसी, ने तारा मन मां, मां घाबराये ने उदास मां हवे। <verse eid="DAN 5:10" /><verse number="11" style="v" sid="DAN 5:11" />तारा राज मां दानीयल नावेन एक माणुस छे तेरो नाव तारु बास बेलतसस्‌सर पाड़‌लु तींद्‌रेम चुखला भगवानेन जीव आत्‌मा रवे, ने तीना राजान दाहड़ान मां तेरेम तेज, समज ने देवतान तसी अक्‌कल हतली। ए राजा, तारु बास जु राजु हतलु, चु तीनाक आखा रासी देखण्‌या, हात देखणे वाळा, बड़वाय-भुपाय करने वाळा ने अळी वारु अगला बारामां वात बताड़न्‌यान मुखी ठेहरावलु, <verse eid="DAN 5:11" /><verse number="12" style="v" sid="DAN 5:12" />काहाकी तींद्‌रेम खास आत्‌मा, अक्‌कल ने समज, ने सपनान मतलब बताड़‌ने ने काहनी बताड़ने, ने संका छेटे करनेन सक्‌ती हतली। तेरेमां हंय दानीयल काजे बुलावे, ने चु तेरो मतलब बताड़से।”<verse eid="DAN 5:12" /></para>
  <para style="s">दानीयलेन साहरे लिखलान मतलब बताड़नु</para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 5:13" />तत्‌यार दानीयल काजे राजा अगळ घरमां बुलाया। ने राजु दानीयल सी पुछणे बाजी गुयु, “काय तु जुत दानीयल छे, जु मारा बास नबुकदनेस्‌सर राजान साहरे रवणेन जागा यहुदान देस मां सी लावला यहुदान गुलाम माणसे भेळतु लावलु छे? <verse eid="DAN 5:13" /><verse number="14" style="v" sid="DAN 5:14" />मे तारा बारामां सामळ्‌ळु छे की, देवतान जीव आत्‌मा तारेम छे, ने तारेम वीजाळो, समज ने वारु अक्‌कल छे। <verse eid="DAN 5:14" /><verse number="15" style="v" sid="DAN 5:15" />देखु हंय जानकार्‌या ने बड़वाय भुपाय करने वाळा माणसे मार अगळ असा करीन बुलावला की जो लिखलो भणे ने तेरो मतलब बताड़े, बाकुन चे तीनी वातेन मतलब नी समजाड़ सक्‌या। <verse eid="DAN 5:15" /><verse number="16" style="v" sid="DAN 5:16" />बाकुन मे तारा बारामां सामळ्‌यु की दानीयल सातायली वात बताड़ सके ने संका छेटे कर सके। तेरेमां हंय कदी तु तीना लिखला काजे भण सके ने तेरो मतलब मेसेक समजाड़ सके, ती तुसेक जामण्‌या रंगेन पुथल्‌या, ने तारा गळा मां सनान माळा पेहरावसुन, ने राज मां तीसरु मुख्‌यु तुत बणसी।”<verse eid="DAN 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 5:17" />दानीयल राजा काजे कह्‌यु, “तारो भेट तारेत धड़े राख, ने जु बदलु तु देणे हींडी रयु, चु दीसरा काजे आप दे, ची लिखली वात मे राजा काजे भणीन सामळावीस, ने तेरो मतलब बी तुसेक समजाड़ दीस।”<verse eid="DAN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 5:18" />ए राजा, आखान मुखी भगवान तारा बासेक नबुकदनेस्‌सर काजे राज, बड़ाई, ईज्‌जत ने मटो नाव आप्‌यु। <verse eid="DAN 5:18" /><verse number="19" style="v" sid="DAN 5:19" />ने तीना बड़ायन वजे जो चु तीनाक आपलु, राज-राजेन आखा माणसे, ने दीसरी-दीसरी बुली बुलने वाळा तेरे अगळ कापे ने थर-थर करतेला; तीनाक चु चाहतेलु तीनाक मारतेलु, ने तीनाक चु चाहतेलु तीनाक चु उंचु पद आपतेलु, ने तीनाक चु चाहतेलु तीनाक नेचु उतार देय। <verse eid="DAN 5:19" /><verse number="20" style="v" sid="DAN 5:20" />बाकुन जत्‌यार राजान मन मटाय करने बाजी गुयलो, ने तेरी आत्‌मा बेसकी काठी हय गुई, ने चु बेसकु मटाय करने बाजी गुयु, तत्‌यार चु तीनाक आपसी राजगादी पर ती उतारी देदा, ने तेरी बड़ाय हेटी हय गुय। <verse eid="DAN 5:20" /><verse number="21" style="v" sid="DAN 5:21" />चु माणसे मां सी नीकळी गुयु, ने तेरो मन जानवरेन तसो हय गुयो, ने तेरो रवणु बयड़ा मायन गदड़ान तसो हय गुयो, ने चु बेलेन तसु चारु चरतेलु, ने आपसो डील सरगेन उस्‌टा ती भीगतो रयो, जत्‌यार चु जाणी गुयु की आखान मुखी भगवान माणसेन राज मां राज करे, ने तीनाक चाहे तीनाक हकदार्‌यु ठेहरावे।<verse eid="DAN 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="DAN 5:22" />तेबी ए बेलसस्‌सर, तु जु तेरु पुर्‌यु छे, ने जो आखो काय तु जाणतेलु, तेबी तारो मन नीचळो नी हयो। <verse eid="DAN 5:22" /><verse number="23" style="v" sid="DAN 5:23" />ने तु सरगेन मालीकेन वीरुद मां मुणको हाकलीन तेरा घरेन ठाहरा मांगाड़ीन आपसा अगळ मेकाड़ लेदु, ने आपसा मुख्‌या ने राखला बायरा समेत तु तेरेमां अंगुरेन रस पीदु; सनो चांदी, पीतळ, लुहड़ो, लाकड़ो ने दगड़ान देवता, जे नी देखे ने नी सामळे, ने नी काय समजे, तींद्‌री ते बड़ाय कर्‌या बाकुन भगवान, तीनान हात मां तारु जीव छे, ने तीनान हक मां तारो चालनु फीरनु छे, तेरु आव-भाव तु नी कर्‌यु। <verse eid="DAN 5:23" /><verse number="24" style="v" sid="DAN 5:24" />तत्‌यारुत जु हातेन एक हीस्‌सु हेरे भीणी सी उजेंतु हयु, ने चे बुल लिखाय गुया।<verse eid="DAN 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 5:25" />चे बुल लिखाय गुयला चे जे छे, मने, मने, तकेल, ने पर्‌सीन। <verse eid="DAN 5:25" /><verse number="26" style="v" sid="DAN 5:26" />हीना लिखलान मतलब जो छे की: मने, मतलब भगवान तारा राजेन दाहड़ा गीणीन तीनाक खत्‌तम कर देदु। <verse eid="DAN 5:26" /><verse number="27" style="v" sid="DAN 5:27" />तकेल, मतलब जो छे की, तुसेक ताकड़ीम तुली देदा, ने तारो बजन कम नीकळ्‌यो। <verse eid="DAN 5:27" /><verse number="28" style="v" sid="DAN 5:28" />परेस, मतलब जो छे की, तारो राज वाटीन मादीयों ने फारसी माणसे काजे आप देदु।<verse eid="DAN 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 5:29" />तत्‌यार बेलसस्‌सर हुकुम आप्‌यु, ने दानीयलेन जामण्‌या रंगेन पुथल्‌या ने तेरा गळा मां सनान माळा पेहराया<note caller="+" style="x"><char style="xo" closed="false">5:29 </char><char style="xt" closed="false"><ref loc="GEN 41:42">उबजाणनी किताप 41:42</ref></char></note>, ने आयड़ीन चवकीदार्‌या तेरे बारामां कह्‌या, की राज मां तीसरु दानीयलुत राज करसे। <verse eid="DAN 5:29" /><verse number="30" style="v" sid="DAN 5:30" />तीनीत राते बेबीलोन देसेन राजा बेलसस्‌सर काजे मार देदा। <verse eid="DAN 5:30" /><verse number="31" style="v" sid="DAN 5:31" />ने अळतेन तेरो राज माद्‌या माणसेन राजु दारु हात कर लेदु, तेरे जागे राजगादी पर बसीन राज-पाट समाळने बाजी गुयु। तीनी टेमे दारु राजु धड़े-वड़े साहाठ ने दुय सालेन हतलु।<verse eid="DAN 5:31" /></para>
  <chapter eid="DAN 5" />
  <chapter number="6" style="c" sid="DAN 6" />
  <para style="s">दानीयल काजे नाहारेन गुफा मां नाखणु</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 6:1" />दारा काजे जो वारु लाग्‌यो की आपणा देस उपर एक सोव ने बीस असा मुख्‌या बणाया। चे आखा देस पर हक राखे। <verse eid="DAN 6:1" /><verse number="2" style="v" sid="DAN 6:2" />ने तींद्‌रे उपर चु तीन मुख्‌या बणावलु, तींद्‌रेम सी दानीयल एक हतलु, हेरेसी बणावलु की चे तीनु मुख्‌या सी हीसाब कर्‌या करे, ने हेरसी राजान काही नुकसान नी हवणु चाहजे। <verse eid="DAN 6:2" /><verse number="3" style="v" sid="DAN 6:3" />जत्‌यार जो देख्‌या की दानीयल मां जीव आत्‌मा रह्‌वे, तत्‌यार तीनु काजे तींद्‌रा मुख्‌या ने आफसरेन हक सी अदुस आव-भाव जड़ी, बाकुन राजु बी चाहतेलु की तीनाक आखा राज पर ठेहरायु। <verse eid="DAN 6:3" /><verse number="4" style="v" sid="DAN 6:4" />तत्‌यार मुख्‌या ने आफसर्‌या मुखीन कामेन राजेन बारामां दानीयलेन वीरुद गुनु हेरने बाजी गुया; बाकुन चु भुरसा लायक हतलु, ने तेरा कामेन बारामां काय बी भुल ने गलती नी नीकळी, ने चे असी काहनीक गुना ने गलती नी देखी सक्‌या। <verse eid="DAN 6:4" /><verse number="5" style="v" sid="DAN 6:5" />तत्‌यार चे माणसे कवणे बाजी गुया की, “हामु तीना दानीयलेन भगवानेन कायदा काजे छुड़ीन, अळी काहनान बारामां तेर भीणी काय बी गुनु नी हामुक जड़्‌यु।”<verse eid="DAN 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="DAN 6:6" />तत्‌यार चे मुख्‌या ने मुख्‌या भीणी मामार आया, ने तीनुक कह्‌या, ए राजा दारा, तु जलम जीवतेलु रहे। <verse eid="DAN 6:6" /><verse number="7" style="v" sid="DAN 6:7" />राजेन आखा मुख्‌या, ने सीपायड़ान, राज करन्‌यान मुख्‌या, नीयाव करनेवाळा, ने राज करनेवाळा बी भेळा हय्‌न मान्‌या की, राजु असी हुकुम आपे ने असी मटी कड़ी हुकुम नीकाळे, की तीस दाहड़ा लग जो काहनुक, ए राजा, तुसेक छुड़ीन अळी दीसरु काहनुक माणुस नीते देवता सी दुवा करे, तीनाक नाहरेन टुळा मां नाख देय। <verse eid="DAN 6:7" /><verse number="8" style="v" sid="DAN 6:8" />हेरेसी हंय ए राजा, असु हुकुम आप दे, ने हीनी चिट्‌ठी पर साईन कर दे, तेरेसी जी वात, मादीयों ने फारसीन नक्‌खी करला कायदान साहरे बदलनु नी सके। <verse eid="DAN 6:8" /><verse number="9" style="v" sid="DAN 6:9" />तत्‌यार दारु राजु तीना हुकुम काजे लिखाड़ीन तेरे पर साय्‌न कर देदु। <verse eid="DAN 6:9" /><verse number="10" style="v" sid="DAN 6:10" />जत्‌यार दानीयल काजे मालुम हयो की तीनी चिट्‌ठी पर साय्‌न करलो छे, तत्‌यार चु आपसा घर मां गुयु, तीना घरेन उपरली मंजीलेन खीड़की यरुसलेम सहर भीणी उघड़ी रवतेली। ने आपसान रीतीन अनसारे चु भगवान धड़े दीसु तीन कावा मांडा टेकीन दुवा करतेलु ने बेसकु वारु छे कवतेलु, असुत तत्‌यार बी करतु रयु।<verse eid="DAN 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 6:11" />तत्‌यार चे माणसे मामार जुर सी आयन दानीयल काजे आपसा भगवान अगळ लीलघायता जाय्‌न ने भगवान अगळ मदत मांगतेला देख्‌या। <verse eid="DAN 6:11" /><verse number="12" style="v" sid="DAN 6:12" />तत्‌यार चे गुनु लागाड़ने राजा धड़े गुया, ने चे कह्‌या, ए राजा, काय तु असा हुकुमेन चिट्‌ठी पर साय्‌न करलु छे की तीस दाहड़ा लग जु काहनुक बी तुसेक छुड़ीन, काहनाक माणसे नीते देवता काजे वांदसे, तीनाक नाहरेन डहरा मां नाख देसे?</para>
  <para style="p" vid="DAN 6:12">राजु जपाप आप्‌यु, “ने छाचलीन, मादी ने फारसी माणसेन नी टळने वाळु हुकुम नीकाळ्‌यु की जी वात काठी छे।”<verse eid="DAN 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 6:13" />तत्‌यार चे राजा काजे कह्‌या, “यहुदी केदी मां सी जु दानीयल छे, चु ए राजा, नी ते तार भीणी धीयान देदु, ने नी तार साईन करला हुकुमेन चिट्‌ठी भीणी; धीयान देदु, चु एक दाहड़ा मां तीन कावा दुवा कर्‌या करे।”<verse eid="DAN 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 6:14" />जी वात सामळीन, राजु बेसकु घाबराय गुयु, ने दानीयल काजे वाचाड़नेन कुसीत करने बाजी गुयु, ने दाहड़ु बुडणे लक तीनाक वाचाड़नेन वीच्‌यार करतु रयु। <verse eid="DAN 6:14" /><verse number="15" style="v" sid="DAN 6:15" />तत्‌यार चे माणसे राजा धड़े जुर सी मामार आयन कह्‌णे बाजी गुया, “ए राजा, जो जाणी ले की मादी ने फारसी माणसे मां जो नेम-कायदु छे, की जे नी करनेन हुकुम ने राजा ठेहरावे, चु बदली नी सके।”<verse eid="DAN 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="DAN 6:16" />तत्‌यार राजु हुकुम आप्‌यु, ने दानीयल काजे लायन नाहारेन दर मां नाख देद्‌ला‌ छे। तीनी टेमे राजु ने दानीयल काजे पुछ्‌या, “तारु भगवान, तेरी तु दाहड़ीन भक्‌ती कर्‌या करे, हयुत तुसेक वाचाड़से!” <verse eid="DAN 6:16" /><verse number="17" style="v" sid="DAN 6:17" />तत्‌यार एक दगड़ु लायन तीना डहरान मुंहडा पर मेक देदा, ने राजु तीना दगड़ा पर आपसी मुंदी सी, ने आपसा मुख्‌या मुंद्‌या सी छाप लगाड़ देदु, की दानीयलेन बारामां काही बदली नी सके।<verse eid="DAN 6:17" /></para>
  <para style="s">दानीयल काजे नाहार सी बचाड़नु</para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 6:18" />तत्‌यार राजु आपसा बंगला मां जाती रयु, ने तीनी राते खाणो बी नी खादु ने आखी रात सुय रयु, ने तेरे धड़े काय बी मजा करने काय चीज नी हतली, ने तीनाक आखी रात नींद बी नी आवी।<verse eid="DAN 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 6:19" />जत्‌यार संदारे एगुत दाहड़ु उंगतेत राजु उठ्‌यु ने नाहारेन डहरा भीणी मामार जाती रयु। <verse eid="DAN 6:19" /><verse number="20" style="v" sid="DAN 6:20" />जत्‌यार राजु नाहारेन डहरा धड़े गुयु, तत्‌यार दुख भर्‌या बुल सी आयड़ने बाजी गुयु, ने दानीयल काजे कह्‌यु, “ए दानीयल, ए जीवतेला भगवानेन पावर्‌या काय तारु भगवान तेरी तु दाहड़ीन भक्‌ती करे, तुसेक नाहार सी वाचाड़ी सक्‌यु काय?”<verse eid="DAN 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="DAN 6:21" />तत्‌यार दानीयल राजा काजे कह्‌यु, “ए राजा, तु जलम जीवतेलु रह्‌वे! <verse eid="DAN 6:21" /><verse number="22" style="v" sid="DAN 6:22" />मारु भगवान आपसा सरगेवाळा काहवाळ्‌या काजे मकलीन नाहारेन मुंहडा काजे असु बंद करीन मेक्‌यु की, चे मारो काय बी नी नुकसाण करी सक्‌या, तेरो मतलब जो छे, की मे तेरे अगळ बीन-गुनाळु नीकळ्‌यु। ने ए राजा, तार भीणी बी मे काय भुल नी कर्‌यु।”<verse eid="DAN 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="DAN 6:23" />तत्‌यार राजु बेसकु खुस हयन, दानीयल काजे डहराम सी बाहर नीकाळनेन हुकुम आप्‌यु, तत्‌यारुत दानीयल काजे डहरा मां सी नीकाळ लेदा, ने तेरे पर काय बी नुकसाणेन सहलाणी नी देखाव पड़ी, काहाकी चु दानीयल आपसा भगवान पर भुरसु करतेलु। <verse eid="DAN 6:23" /><verse number="24" style="v" sid="DAN 6:24" />तत्‌यार राजु हुकुम आप्‌यु की, जे माणसे दानीयलेन चुगली कर्‌या, चे आपणा-आपणा बायरा ने पुर्‌या-पारी आखा काजे लीन आवु, ने नाहारेन डहरा मां नाख देवु, ने चे डहरान कुर तक बी नी पुग्‌या ने नाहार तीनु काजे एकदम सी आखा हाटका सुदे तीनु काजे खाय गुया।<verse eid="DAN 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 6:25" />तत्‌यार राजु दारा आखी धरती पर रह्‌णे वाळा राज-राजेन आखा माणसे, ने भाती-भातीन बुली बुलने वाळा धड़े जो लिख्‌या, तुहुंं सुख सांती सी रवु! <verse eid="DAN 6:25" /><verse number="26" style="v" sid="DAN 6:26" />मे जो हुकुम आपो की जां-जां मारा राजेन हक छे,</para>
  <para style="q1" vid="DAN 6:26">चांहान माणसे दानीयलेन भगवान अगळ थुर-थुर कापे,</para>
  <para style="q2" vid="DAN 6:26">काहाकी जीवतु ने जलम लग रवणे वाळु भगवान हयुत छे;</para>
  <para style="q1" vid="DAN 6:26">तेरो राज खत्‌तम नी हवणे वाळो,</para>
  <para style="q2" vid="DAN 6:26">ने तेरु हक कदी नी टळसे।<verse eid="DAN 6:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="DAN 6:27" />जु दानीयल काजे नाहार सी वाचाड़लु छे, जुत तुहुंंक ने मेसेक वाचाड़न्‌यु,</para>
  <para style="q2" vid="DAN 6:27">ने छुड़ावणे वाळु छे,</para>
  <para style="q2" vid="DAN 6:27">ने सरगे मां ने हीनी धरती पर सहलाणी,</para>
  <para style="q1" vid="DAN 6:27">ने मटा काम उजेंता करनेवाळा छे।<verse eid="DAN 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 6:28" />तेरेसी दानीयल, दारा ने कुर्‌सु फारसी, दुयुन राज मां सुख-सांती ने आराम सी रयु।<verse eid="DAN 6:28" /></para>
  <chapter eid="DAN 6" />
  <chapter number="7" style="c" sid="DAN 7" />
  <para style="s">दानीयलेन साहरे आपसान दरसनेन बारामां देखाड़नु</para>
  <para style="r">(<ref loc="DAN 7:1-12:13">दानीयल 7:1—12:13</ref>)</para>
  <para style="s">चार जानवर्‌यान बारामां दानीयलेन दरसन</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 7:1" />बेबीलोनेन राजु बेलसस्‌सरेन पेहला सालो मां, दानीयल राती एक सपनो ने दरसन देख्‌यु। तत्‌यार चु चो सपनो लिख्‌यु, ने तीनी वातेन मतलब बी बताड़्‌यु। <verse eid="DAN 7:1" /><verse number="2" style="v" sid="DAN 7:2" />दानीयल जो कह्‌यु की, मे राते ज सपनो देख्‌यु,</para>
  <para style="p" vid="DAN 7:2">की एक मटला दर्‌यान आड़े-धड़े आंधी चालने बाजी रय। <verse eid="DAN 7:2" /><verse number="3" style="v" sid="DAN 7:3" />तत्‌यार दर्‌या मां सी चार मटला-मटला जानवर नीकळ्‌या, जे एक दीसरा सी अलग-अलग हतला।<note caller="+" style="x"><char style="xo" closed="false">7:3 </char><char style="xt" closed="false"><ref loc="REV 13:1">उजेंता बुले 13:1</ref>; <ref loc="REV 17:8">17:8</ref></char></note> <verse eid="DAN 7:3" /><verse number="4" style="v" sid="DAN 7:4" />पेहलो टीड्‌डो नाहारेन तसो हतलो, ने तेरा पाखड़ा घुवड़ान तसा हतला, ने मेसेक देखते-देखते तेरा पाखड़ा उखाळ देदा, ने चु जागा मां ती उठीन, माणसेन तसु पायेन साहरु लीन उबु हय गुयु, ने तीनाक माणसेन डील आप देदा।<verse eid="DAN 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 7:5" />अळतेन मे एक अळी जानवर देख्‌यु, चो रीछड़ान तसो हतलो, ने एक हेट्‌यु उबु हय रवलु, ने तेरा मुंहडा मां दातेन ईचमां तीन पासळी हतली; ने माणसे कवतेला की, उठीन बेसकु सीकार खा।<verse eid="DAN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="DAN 7:6" />तेर पछेन मे एक कावा अळी नींगा करीन देख्‌यु, की चो जानवर एक चीतर्‌या-नाहारेन तसो छे। ने तेरा आसा पर चिरलान तसा चार पाखड़ा छे, ने तीना जानवर्‌यान चार मुणका हतला, ने आपसो आखो हक तीना जानवर काजे आप देदु।<note caller="+" style="x"><char style="xo" closed="false">7:6 </char><char style="xt" closed="false"><ref loc="REV 13:2">उजेंता बुले 13:2</ref></char></note><verse eid="DAN 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 7:7" />अळी मे तेरे पछेन मे एक सपना मां नजर नाख्‌यु ने देखीन कह्‌यु, ने एक चवथो जानवर छे, चो बेसको ने बीहाड़े ने ताकतवाळो छे; ने तेरा मटला-मटला लुहड़ान दात छे, चु आखो काय खाय जाय ने कटका-कटका कर देय, जो बची जाय तीनाक पाय तळे रंदळी देय। चो आखा पेहला जानवर्‌या मां सी अलग छे, ने तेरा दस सींगड़ा छे। <verse eid="DAN 7:7" /><verse number="8" style="v" sid="DAN 7:8" />मे तीनु सींगड़ा काजे धीयान सी देख्‌यु ती काय देख्‌यु की तींद्‌रे ईचमां सी एक अळी नान्‌लो सींगड़ो नीकळ्‌यो, ने तीना सींगड़ान ताकत सी तीनु पेहला सींगड़ाम सी तीन सींगड़ा उखाळ्‌या, अळतेन मे जो देख्‌यु की हीनु सींगड़ाम सी माणसेन डुळान तसो, ने मटाय्‌न वात बुलने वाळो मुंहडो हतलो।<verse eid="DAN 7:8" /></para>
  <para style="s">जलेमका जीवतेला रवणे वाळान दरसन</para>
  <para style="p">
    <verse number="9" style="v" sid="DAN 7:9" />मे देखतु-देखतु आकरी मां जो देख्‌यु की राजगाद्‌या मेकला छे, ने एक आड़ा-बुड़ा मां सी एक बस्‌यु, तींद्‌रा पुथल्‌या बरप सांय धवेळ्‌ळा उजळा हतला ने मुणकान कान्‌या उजेळान तसा ने तींद्‌री राजगादी आकठान तसी ने तींद्‌रा चाटका हुड़ु-हुड़ु धपतेला आकठान तसा देखायतेला।<note caller="+" style="x"><char style="xo" closed="false">7:9 </char><char style="xt" closed="false"><ref loc="REV 20:4">उजेंता बुले 20:4</ref>; <ref loc="REV 1:14">1:14</ref></char></note> <verse eid="DAN 7:9" /><verse number="10" style="v" sid="DAN 7:10" />तीना जमाना टेमे धड़े सी आकठीन धार नदी सी नीकळीन उहणे बाजी रवली, अळतेन हजारु माणसे आपसी सेवा चाकरी करने बाजी रवला, ने लाखु माणसे तेर अगळ हजुर हतला; अळी नीयाव करने वाळी बठ गुयु ने किताप्‌या खुली गुय।<note caller="+" style="x"><char style="xo" closed="false">7:10 </char><char style="xt" closed="false"><ref loc="REV 5:11">उजेंता बुले 5:11</ref>; <ref loc="REV 20:12">20:12</ref></char></note><verse eid="DAN 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 7:11" />तीनी टेमे तीना सींगड़ान खुदेन मटाय्‌न अवाज सामळीन देखतु रयु, ने देखते-देखते आकरी मां देख्‌यु की तीना चोवथा जानवर काजे मारी नाख्‌या, ने तेरा डील काजे धपतेला आकठाम नाख देदा ने धपाड़ देदा। <verse eid="DAN 7:11" /><verse number="12" style="v" sid="DAN 7:12" />बाकी बचला दीसरा जानवर्‌यान हक हापकी लेदा, बाकुन तीनुक थुड़ाक दाहड़ा अळी जीवतेला रवणेन हुकुम आप्‌या।<verse eid="DAN 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 7:13" />मे राते एक दरसन देख्‌यु, ने देखु, माणसेन पुर्‌या साय काहनुक सरगेन वादळा पर बसीन आवतेलु देखसु, ने चे तीना डाहला धड़े पुग्‌या, ने तीनाक चे तेरे धड़े लाया। <verse eid="DAN 7:13" /><verse number="14" style="v" sid="DAN 7:14" />तत्‌यार तीनाक असो राज, सेक-सींगार ने राज आपलो छे, ने भाती-भातीन कुळीन माणसे ने राज-राजेन माणसे ने भाती-भातीन बुली बुलने वाळा ने आखी कुळीन माणसे तेरा हक मां रवे; ने तेरो राज जलम लक टणको, ने तेरो राज खत्‌तम नी हवणे वाळो ठेहरसे।<verse eid="DAN 7:14" /></para>
  <para style="s">सपनान मतलब बताड़नु</para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 7:15" />मे दानीयल जो सपनो देखलु हेरेसी मे घाबराय गुयु, ने बेसकु उदास हय गुयु। <verse eid="DAN 7:15" /><verse number="16" style="v" sid="DAN 7:16" />तत्‌यार जे माणसे धड़े उबा हय रह्‌ला, तींद्‌रे मां सी एक धड़े जाय्‌न मे तीनी आखी वातेन मतलब पुछ्‌यु, ने चु जो कंयन मेसेक तीनी आखी वातेन मतलब बताड़्‌यु। <verse eid="DAN 7:16" /><verse number="17" style="v" sid="DAN 7:17" />तीनु चार मटला-मटला जानवर्‌यान मतलब चार राज<note caller="+" style="f"><char style="fr" closed="false">7:17 </char><char style="ft" closed="false">राजु</char></note> छे, जो धरती पर पयदा हवसे। <verse eid="DAN 7:17" /><verse number="18" style="v" sid="DAN 7:18" />बाकुन मुखी माणसे चुखला माणसे देस काजे हात करसे, ने जलमकात तींद्‌रा हकवाळा बणीन रवसे।<note caller="+" style="x"><char style="xo" closed="false">7:18 </char><char style="xt" closed="false"><ref loc="REV 2:5">उजेंता बुले 2:5</ref></char></note><verse eid="DAN 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 7:19" />तत्‌यार मारा मन मां जी वीच्‌यार आय की तीना चोवथा जानवरेक बी जाणी लम, जो दीसरा तीनु सी आंग्‌ये ने बेसको हतलो, ने तेरा दात लुहड़ान ने नखड़्‌या पीतळेन हतला, चु आखो काय खाय जातलु, ने छेदर्‌या-छेदर्‌या कर देतलु, ने बचला काजे पाय सी रंदळी नाखतेलु। <verse eid="DAN 7:19" /><verse number="20" style="v" sid="DAN 7:20" />अळतेन तेरा मुणकान दस सींगड़ान भेद जाणनेन, ने तीनु दस सींगड़ान ईचमां नीकळन्‌या तीन सींगड़ा भेद जाणनेन हर आय। चो दस सींगड़ान ईचमां नीकळन्‌यो सींगड़ो ते बीहाड़े असो ने बेसको वारु देखायतेलो, तेरा डुळा हतला ने मुंहडा बी हतलो, जो मटाय्‌न वात बी करने बाजी रवलो।<verse eid="DAN 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="DAN 7:21" />अळतेन मे देख्‌यु की, चो सींगड़ो चुखला माणसे साते लड़ाय करीन तीनी टेमे तक ताकतवाळो हय गुयो।<note caller="+" style="x"><char style="xo" closed="false">7:21 </char><char style="xt" closed="false"><ref loc="REV 13:7">उजेंता बुले 13:7</ref></char></note> <verse eid="DAN 7:21" /><verse number="22" style="v" sid="DAN 7:22" />तत्‌यार लक चु जलमकु राजु नी आयु, ने आखाम जुरभर्‌या भगवानेन चुखला माणसेन खरलु नीयाव नी बस्‌या, ने चुखला माणसेक राज जड़नेन टेम नी आवी।<verse eid="DAN 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="DAN 7:23" />चु जलमकु राजु मेसेक कह्‌यु, तीना चवथा जानवर्‌यान मतलब, एक चोवथु राज छे। चो धरती पर आय्‌न आखा राज ती अलगुत रवसे, जो राज आखी धरतीक रंदळीन छेदर्‌या-छेदर्‌या कर देसे। <verse eid="DAN 7:23" /><verse number="24" style="v" sid="DAN 7:24" />तीनु दस सींगड़ान मतलब जो छे की, तीना राज मां सी दस राज नीकळसे, ने अळतेन एक अळी दीसरु राजु आवसे, चु पेहला राजा सी अलगुत भातीन रवसे, चु तीनु दस राजा माय्‌न तीन काजे आपसा हक मां कर लेसे।<note caller="+" style="x"><char style="xo" closed="false">7:24 </char><char style="xt" closed="false"><ref loc="REV 17:12">उजेंता बुले 17:12</ref></char></note> <verse eid="DAN 7:24" /><verse number="25" style="v" sid="DAN 7:25" />ने चु डाहला मुख्‌या भगवानेन वीरुद मां वात कह्‌से, ने तीना डाहला मुख्‌यान चुखला माणसे काजे कुची देसे। ने चु आखो काय टेम ने कायदा काजे ने तीहवार बदलनेन वात करसे, भगवानेन माणसे साड़े तीन साल लग चे आखो आपसा हातेम कर देसे। <verse eid="DAN 7:25" /><verse number="26" style="v" sid="DAN 7:26" />बाकुन, तत्‌यार नीयाव करन्‌या बठसे, ने आपसो आखो राज हापकीन खत्‌तम कर देसे, ने आखो सारी देसे, ने जां लग की तेरु पतु बी नी चाले। <verse eid="DAN 7:26" /><verse number="27" style="v" sid="DAN 7:27" />सरगेन आखे जागे सी धरतीन आखा राजवाड़ा ने राज जुरभर्‌या भगवानेन भगत काजे आपणेम आवसे, तींद्‌रो राज जलमको राज रवसे, धरतीन आखा राजा लक तींद्‌री सेवा करसे, ने तींद्‌रा हुकुम मानसे।<verse eid="DAN 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 7:28" />तीनी वातेन बारामां मे हंय कय देदु, बाकुन मे दानीयल मन मां बेसकु घाबरायतु रयु, ने मे बीही गुयु, ने हीनी वातेक मे मारा मन मां राखी र्‌यु।<verse eid="DAN 7:28" /></para>
  <chapter eid="DAN 7" />
  <chapter number="8" style="c" sid="DAN 8" />
  <para style="s">दानीयलेन साहरे गाडरा ने एक बुकड़ान सपनो</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 8:1" />राजा बेलसस्‌सर देसेन तीसरे साल मां तीना पेहला सपनान ने पछेन एक अळी मेसेक दानीयल काजे सपनान साहरे देखाय देदी। <verse eid="DAN 8:1" /><verse number="2" style="v" sid="DAN 8:2" />जत्‌यार मे एलाम नावेन जागा मां, सुसन नावेन सहर मां रवतेलु, तत्‌यार मे एक सपनो देख्‌यु की मे एक उले नदीन धड़का पर हतलु। <verse eid="DAN 8:2" /><verse number="3" style="v" sid="DAN 8:3" />अळतेन मे उपर भाळीन देख्‌यु, तीनी नदीन अगळ दुय सींगड़ावाळु एक गाडरु उबु हय रयु, तेरा दुय सींगड़ा मटला छे, बाकुन तींद्‌रे मां सी एक बेसको मटो छे, ने जो मटलो छे, चो दीसरा पछळ नीकळ्‌यो। <verse eid="DAN 8:3" /><verse number="4" style="v" sid="DAN 8:4" />मे तीना गाडरा काजे देख्‌यु की चु बुडवणु ने धुराव ने दखणाव भीणी सी सींगड़ो मारतेलु, ने काहनु बी जानवर तीना गाडरा अगळ उबो नी हय सके, ने नी तेर हात सी काहनुक नी बचाड़ी सके; ने चु आपसीत मरजीन अनसारे काम करीन अगु बड़तु जातलु।<verse eid="DAN 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 8:5" />मे वीच्‌यार करने बाजी रह्‌लु, ती अळी काय देख्‌यु की एक बुकड़ो बुडवणो भीणी सी नीकळीन आखी धरती पर असु फीर्‌यु की चालनेन टेमे जागा पर पाय बी नी छीमाया, ने तीना बुकड़ान डुळान ईचमां एक देखणे लायक सींगड़ो हतलो। <verse eid="DAN 8:5" /><verse number="6" style="v" sid="DAN 8:6" />चो तीना दुय सींगड़ा वाळा गाडरा धड़े जाय्‌न, तीनाक मे नदी अगळ उबो हवलो देख्‌यु, तेरे पर रीसवाय्‌न आपसी आखी ताकत सी चीसटी गुयो। <verse eid="DAN 8:6" /><verse number="7" style="v" sid="DAN 8:7" />अळतेन मे देख्‌यु की, चु बुकड़ु, रीसवाय्‌न सींगड़ा वाळा गाडरा धड़े दवड़ीन आवीन लड़ाय करने बाजी गुयु, ने तीनाक बेसकु जुर्‌ये घुदलाय्‌न तेरा दुयु सींगड़ा काजे भांज देदु, ने तीना सींगड़ा वाळा गाडराक तेर साते लड़ाय करने करीन नी बणे। तत्‌यार बुकड़ु तीना सींगड़ा वाळा गाडरा काजे जागा पर भुयमां हीट पाड़्‌यु, ने भुयमां रंदळी देदु, ने सक्‌ती सी तीनु सींगड़ा वाळा गाडराक छुड़ावणे वाळा कुय नी जड़्‌या।<verse eid="DAN 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 8:8" />तत्‌यार बुकड़ु बेसकु मटाय करने बाजी गुयु, ने तत्‌यार ताकतवाळु हयु, ने तत्‌यार आपसो मटलो सींगड़ो टुटी गुयो, ने तेर बदलाम देखणे वाटे चार सींगड़ा नीकळीन चारु खुणाम वदणे बाजी गुया। <verse eid="DAN 8:8" /><verse number="9" style="v" sid="DAN 8:9" />अळी तीना बुकड़ाम सी एक नान्‌लोस सींगड़ो नीकळ्‌यो, जो दखणाव सी ने उगवणो सी ने वादु करलो देस भीणी सी बेसको वद गुयो। <verse eid="DAN 8:9" /><verse number="10" style="v" sid="DAN 8:10" />चु अतरु ताकतवाळु हय गुयु की सरगेन सेना सी लड़ाय कर्‌यु, ने तींद्‌रे मां सी सरगेन आखा तारान तीन हीस्‌सा माय्‌न एक हीस्‌सु तारा काजे आबड़ीन धरती पर नाखीन रंदळी देदु।<note caller="+" style="x"><char style="xo" closed="false">8:10 </char><char style="xt" closed="false"><ref loc="REV 12:4">उजेंता बुले 12:4</ref></char></note> <verse eid="DAN 8:10" /><verse number="11" style="v" sid="DAN 8:11" />जां तक की चु तीना सरगेन सेनान डाहला मुख्‌या लक पुग गुयु, ने तीनुक बादा देणु बंद कराय देदा, ने तेरा चुखला जागाक उदारी देदा। <verse eid="DAN 8:11" /><verse number="12" style="v" sid="DAN 8:12" />ने माणसेन पापेन वजे सी खास होमबादा पुठे सीपायड़ा बी तेर साते कर देद्‌ला छे, ने चो सींगड़ो छाचाय काजे धुळा मां भेसकी देदा, ने चु काम करते-करते बेसकु अगु बड़ गुयु।<verse eid="DAN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 8:13" />तत्‌यार मे एक सरगेवाळा चाकर्‌याक बुलते सामळ्‌यु, अळी एक चुखलु माणुस ने तेरेसी पेहेल बुलने वाळा सी पुछ्‌यु, “दाहड़ीन आकठान बादा ने उजाड़ने वाळा पापेन बारामां मे जो काय दरसन देखलु छे, चु कां तक बड़तु रवसे; मतलब चुखला जागाक ने सेना दुयु काजे वेला पाड़से ने काहा तक जो हवतो रवसे?”<verse eid="DAN 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 8:14" />तत्‌यार चु मेसेक कह्‌यु, “जत्‌यार तक सांतो ने संदारे दुय हजार ने तीन सोव कावा तक नी हवे, चां लग चो हवतो रवसे, ने तत्‌यार टेम पुरी हय जासे ने चुखली जागाक पुरी काजे चुखी करनेन टेम आवसे।”<verse eid="DAN 8:14" /></para>
  <para style="s">सरगेन काहवाळ्‌यु जीब्‌राएलेन साहरे सपनान मतलब बताड़नु</para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 8:15" />जी वात मे दरसन मां देख्‌यु, मे दानीयल हीनाक समजणेन कुसीत कर्‌यु; तेरेमां माणसे साय देखायणे वाळो उचकाणुन आयन मार अगळ उबो हयु ने देखाव पड़्‌यु। <verse eid="DAN 8:15" /><verse number="16" style="v" sid="DAN 8:16" />तत्‌यार मेसेक उले नदीन ईचमां सी एक माणसेन आवाज सामळाय देदी, जो आयड़ीन कवतेलु, “ए जीब्‌राएल, हीनु माणसेक तेरी देखली वातेक समजाड़ दे।” <verse eid="DAN 8:16" /><verse number="17" style="v" sid="DAN 8:17" />तत्‌यार मे जां उबु हय रह्‌लु, चां चु मारे धड़े आयु, ने मे तीनाक आवते देखीन घाबराय गुयु, ने मुंहडान भुरसे हीट पड़्‌यु, तत्‌यार चु मेसेक कह्‌यु,</para>
  <para style="p" vid="DAN 8:17">ए माणसेन अवल्‌यात तीनु देखली सपनान वात काजे समजी ले, काहाकी तींद्‌रो मतलब आकरी दाहड़ाम फळ लावसे। <verse eid="DAN 8:17" /><verse number="18" style="v" sid="DAN 8:18" />जत्‌यार चु वात कर रवलु; मे बेहुस हय्‌न धरती पर हीट पड़्‌यु बाकुन हयु मेसे धर लेदु ने मेसे मारा पाय पर उबु कर्‌यु। <verse eid="DAN 8:18" /><verse number="19" style="v" sid="DAN 8:19" />तत्‌यार चु मेसेक कह्‌यु, रीस करनेन टेमे आकरी दाहड़ाम जो काय हवसे, चो मे तुसेक बताड़ीस। काहाकी आकरी दाहड़ाम नक्‌खी करली टेम मां चो आखो पुरो हवसे।<verse eid="DAN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 8:20" />जे दुय सींगड़ावाळो गाडरो तु देखलु छे, तेरो मतलब मादीयों ने फारसीन राज<note caller="+" style="f"><char style="fr" closed="false">8:20 </char><char style="ft" closed="false">राजा</char></note> मां सी छे। <verse eid="DAN 8:20" /><verse number="21" style="v" sid="DAN 8:21" />ने जु बुकड़ु तु देख्‌यु चु बुकड़ु युनान राज मां सी छे, ने तेरा डुळाम ईचमां सी जो मटलो सींगड़ो नीकळ्‌यो चु पेहला राजाक नक्‌खी कर्‌यु। <verse eid="DAN 8:21" /><verse number="22" style="v" sid="DAN 8:22" />चो सींगड़ो जो टुटी गुयलो, ने तेरी आवजीम जे चार सींगड़ा नीकळ्‌या, तेरो मतलब जो छे, की तीना देसेम सी चार राज बणसे, बाकुन तेरी ताकत तीना पेहला राजा सी कम रवसे।<verse eid="DAN 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="DAN 8:23" />जत्‌यार तीनु राजेन आकरी टेम धड़े आय रवसे ने चे अतरा पापी हय जासे की हीनुक डंड आपणु चाहजे तत्‌यार चां एक हेट्‌यु; पापी ने धुकु देण्‌यु राजु हवसे। <verse eid="DAN 8:23" /><verse number="24" style="v" sid="DAN 8:24" />ने तेरी ताकत बेसकी मटी रवसे, बाकुन तीना मटला राजान तसी नी रह्‌वे, ने चु घाबराड़ नाखे असी रीती सी माणसे काजे खत्‌तम कर देसे, ने अगु बड़तु जाय्‌न काम करतु जासे, ने ताकत वाळा काजे ने चुखला माणसेन टुळा काजे सारी देसे। <verse eid="DAN 8:24" /><verse number="25" style="v" sid="DAN 8:25" />चु सफल हवणे वाटे धुकु करनेन काम करसे, ने चु मन मां मटाय करीन बे धड़क रयन बेसका माणसे काजे नास करसे। चु आखा राजान वीरुद बी उबु हवसे, बाकुन आकरी मां चु काहनाकेन हात सी बीना मार खाय्‌न टुट जासे। <verse eid="DAN 8:25" /><verse number="26" style="v" sid="DAN 8:26" />सांती ने संदारेन बारामां जो तु देख्‌यु ने समजु, चो छाचलो छे, बाकुन जो कांय तु सपना मां देख्‌यु, तीना दरसन काजे साताड़ीन राख, काहाकी चो बेसका दाहड़ान पछेन फळ लावसे।<verse eid="DAN 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="DAN 8:27" />तत्‌यार मारेम सी दानीयलेन ताकत जाती रय, ने थुड़ाक दाहड़ा लक मे मांदु रयु, ने तत्‌यार उठीन अळी मे राजान काम-धंदु करने बाजी गुयु, बाकुन जो काय मे देखलु तीनाक देखीन मे देखतुत रय गुयु, काहाकी तीनाक कुय समजावणे वाळु नी हतलु।<verse eid="DAN 8:27" /></para>
  <chapter eid="DAN 8" />
  <chapter number="9" style="c" sid="DAN 9" />
  <para style="s">दानीयल आपसा माणसे वाटे दुवा करे</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 9:1" />मादी कुळीन राजु सयर्‌सेन<note caller="+" style="f"><char style="fr" closed="false">9:1 </char><char style="ft" closed="false">अहसवेरोसेन पुर्‌यु</char></note> पुर्‌यु दारु हतलु, कसदीन राज्‌य पर राज करने बाजी गुयलु। <verse eid="DAN 9:1" /><verse number="2" style="v" sid="DAN 9:2" />तेरा राजेन पेहला साल मां, मेसेक दानीयल ने चुखला सास्‌तुरेन साहरे समजी लेदु की यरुसलेम माय्‌न उजड़ी दसा यहोवा भगवानेन तीना बुलेन साहरे जु यीरम्‌या जु भगवान धड़े पुग्‌या, थुड़ाक साल वीतणे पर मतलब सत्‌तर साल अळतेन आखी हय जासे।<note caller="+" style="x"><char style="xo" closed="false">9:2 </char><char style="xt" closed="false"><ref loc="JER 25:11">यीरम्‌या 25:11</ref>; <ref loc="JER 29:10">29:10</ref></char></note> <verse eid="DAN 9:2" /><verse number="3" style="v" sid="DAN 9:3" />तत्‌यार मे मारो मुंहडो मालीक भगवान भीणी करीन लीलघायन दुवा करने बाजी गुयु, ने उपास पाळीन, ने गनटाट्‌यो पांघरीन, ने रखड़ा पर बठीन वीनती करने बाजी गुयु। <verse eid="DAN 9:3" /><verse number="4" style="v" sid="DAN 9:4" />ने मे यहोवा भगवान भीणी असी दुवा कर्‌यु, की मे पापेन माफी मांग्‌यु, ए यहोवा भगवान तु बेसकु ताकत वाळु ने ईज्‌जत वाळु भगवान छे,</para>
  <para style="p" vid="DAN 9:4">जु आपसा सी परम करने हुकुम मान्‌ने वाळा पुठे आपणा कायदा काजे पुरो करे ने दया कर्‌या करे।<verse eid="DAN 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 9:5" />बाकुन ए यहोवा भगवान हामु ते पापी छे, हामु ते बुराई करला छे, हामु ते वीरुद कर्‌या, ने हामु ते गलत काम कर्‌या, तारा नेम ने हुकुम काजे तुड़ देद्‌ला छे। <verse eid="DAN 9:5" /><verse number="6" style="v" sid="DAN 9:6" />तारा जे चेला भगवानेन अघली वात बताड़ने वाळा माणसे छे, हामरा राजा, मुखी माणसे ने आड़ा-बुड़ा ने आखा धरतीन माणसे तार नाव सी वात करतेला, ने तींद्‌री हामु नी सामळ्‌या। <verse eid="DAN 9:6" /><verse number="7" style="v" sid="DAN 9:7" />ए मालीक तु धरमी छे, बाकुन हामु माणसे काजे आजुन दाहड़ा लक लाजवायणु पड़तेलो। बाकुन यरुसलेम मां रह्‌णे वाळा आखा यहुदी काजे, काय धड़े वाळा काय छेटे वाळा आखा इस्‌राएली माणसे काजे, तीनुक तु तीनु धुकु देणेवाळा जे तार साते करला छे, राज मां रावण्‌या-तीवण्‌या कर देदा, तीनु आखा काजे लाजवायणु पड़े। <verse eid="DAN 9:7" /><verse number="8" style="v" sid="DAN 9:8" />ए यहोवा भगवान, हामु ने हामरा राजा ने डाहा-डाहा, तार वीरुद पाप करला, हेरेसी हामुक लाजे पड़नु पड़्‌यो। <verse eid="DAN 9:8" /><verse number="9" style="v" sid="DAN 9:9" />ए भगवान मालीक, भले हामु तार वीरुद मां पाप कर्‌या, तेबी तु दयाळु ने माफी आपण्‌यु छे। <verse eid="DAN 9:9" /><verse number="10" style="v" sid="DAN 9:10" />हामु ते हामरा यहोवा भगवानेन सीकापण सामळीन बी हामु तेरा कह्‌याम नी चाल्‌या, जु आपसा चेला भगवान हामुक सामळावला छे। <verse eid="DAN 9:10" /><verse number="11" style="v" sid="DAN 9:11" />बाकुन आखा इस्‌राएली माणसे तारा कायदान वीरुद कर्‌या, ने असा हय गुया की तारी नी सामळ्‌या। हेरे वजे सी तीना सरापेन वीचार भगवानेन पावर मुसान कायदान बारामां लिखली हतली, चु सराप हामरे पर सरी गुयो, काहाकी हामु तींद्‌रे वीरुद पाप कर्‌या। <verse eid="DAN 9:11" /><verse number="12" style="v" sid="DAN 9:12" />ए भगवान, जी वात चु हामरे ने हामरा राज-करन्‌यान वीरुद कवलु, ची वात हंय पुरी हय गुयली छे; काहाकी जी गरा चु हामरे पर ने यरुसलेम पर नाखलु छे, असी गरा चु आखी धरती पर कांखुर बी नी नाख्‌यु। <verse eid="DAN 9:12" /><verse number="13" style="v" sid="DAN 9:13" />जसो मुसान कायदा मां लिखलो छे, तसीत जी आखी गरा हामरे पर आय पड़ी, तेबी हामु हामरा यहोवा भगवानेन मान्‌ने वाटे नी ते भुंडला काम सी फीर्‌या, ने नी आपसी छाचाय्‌न वात पर धीयान देदा। <verse eid="DAN 9:13" /><verse number="14" style="v" sid="DAN 9:14" />तेरेसी यहोवा भगवान सुची समजीन हामरे पर गरा नाख्‌यु, काहाकी हामरु यहोवा भगवान जतरो काम कर्‌यु, तीनु आखा मां धरमी ठेहरे। बाकुन हामु तेरा कह्‌याम नी चाल्‌या।<verse eid="DAN 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 9:15" />हंय ए हामरा भगवान-मालीक, तु तारा माणसे काजे मीसर राज्‌य मां सी आपसा जुरभर्‌या हाते नीकाळ लायु, ने तारो नाव असो मटो हय गुयो, जो आज तक चाल रयो, बाकुन हामु ते पाप करला छे, ने हामु ते कुहरायत करला छे। <verse eid="DAN 9:15" /><verse number="16" style="v" sid="DAN 9:16" />ए भगवान-मालीक, हामरा पापेन ने हामरा डाहा-डाहान नी-धरमेन साहरे यरुसलेम सहरेन, ने तारा माणसेन, ने आड़े-धड़ेन माणसेन नावबद्‌दी हवणे बाजी रय; तेबी तु तारा धरमेन साहरे आपसी रीस तारा यरुसलेम सहर पर सी छेटी कर ले, जो तारा चुखला बयड़ा पर वस रयो। <verse eid="DAN 9:16" /><verse number="17" style="v" sid="DAN 9:17" />ए हामरा भगवान मालीक, मे तारु पावर्‌यु छे, तार नावेन साहरे, मारी दुवा ने लीलघायणु सामळी ले, तारा उजड़ला चुखला मंदीर पर तारा मुंहडान वीजाळो भबळाव। <verse eid="DAN 9:17" /><verse number="18" style="v" sid="DAN 9:18" />ए मारा भगवान कांटा लागाड़ीन सामळ, डुळा उघाड़ीन हामरी उजड़ली दसा काजे देख ने तीना सहर काजे बी देख जे तारा कह्‌वाये, काहाकी हामु ते तारे अगळ आयड़ी-आयड़ीन दुवा करजे, चु आपसा धरमेन काम पर नी बाकुन, तारी मटली दयान वजे सी भुरसु करीन कवजे। <verse eid="DAN 9:18" /><verse number="19" style="v" sid="DAN 9:19" />ए मालीक, सामळ; ए मालीक, पापेन माफी आप दे: ए मालीक, धीयान लागाड़ीन जो काय करनु हय चो कर, तु टेम मां करे, ए मारा भगवान तारो सहर ने तारा माणसे तारात कवाये, हेरेसी आपणा नावेन साहरे वार मां लागाड़े।<verse eid="DAN 9:19" /></para>
  <para style="s">जीब्‌राएल आवती वात काजे सीकाड़े</para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 9:20" />हीनी रीते दुवा करो, ने मारा ने मारा इस्‌राएली माणसेन पापेक माफ करतेलु, आपणा यहोवा भगवान धड़े आपसा चुखला मंदीर वाटे लीलघायन दुवा करतेलु छे। <verse eid="DAN 9:20" /><verse number="21" style="v" sid="DAN 9:21" />जब मे दुवा करतेलु तत्‌यार चु माणुस जीब्‌राएल तीनाक मे तीनी टेमे सपनाम देख्‌यु, जत्‌यार मेसेक पेहेल देखाव पड़्‌यु, चु पाखड़ा सी उडणेन हुकुम मानीन, सांती वेळाय बादा चड़ावणेन टेमे मेसेक छीम लेदु; ने मेसेक समजाड़ीन मार पुठे वात करने बाजी गुयु।<note caller="+" style="x"><char style="xo" closed="false">9:21 </char><char style="xt" closed="false"><ref loc="LUK 1:19">लुका 1:19</ref>,<ref loc="LUK 1:26">26</ref></char></note> <verse eid="DAN 9:21" /><verse number="22" style="v" sid="DAN 9:22" />ने चु मेसेक असु कह्‌यु, “ए दानीयल, मे तुसेक भगवानेन अघली वात बताड़ने करीन अक्‌कल ने समज आपणे आवलु छे।” <verse eid="DAN 9:22" /><verse number="23" style="v" sid="DAN 9:23" />जत्‌यार तु आयड़ी-आयड़ीन लीलघायन दुवा करने बाजी रवलु, तीनीत टेमे मेसेक हुकुम जड़लु, हेरेसी मे तुसेक बताड़ने आवलु छे, काहाकी तु बेसकु लाटेक्‌लु छे, हेरेसी हीनी वात पर वीच्‌यार करीन सपनान वातेक समजी ले।<verse eid="DAN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 9:24" />“भगवान तारा माणसे ने तारा चुखला सहर वाटे सत्‌तर हाप्‌ता मतलब सत्‌तर साल ठेहरावलु छे, हेरेन करीन की, चे दाहड़ा सरता लग पाप हवणु बंद हय जासे, ने पाप सरनु ने गुनान माफीन बादा छुटायसे, ने जलमको धरम उजेंतु हवसे; ने सपनान ने आवती वातेन मुहर लागसे ने चुखला जागाक तेल चुपड़ीन, अभीसेक करने ने भरवणे आवसे। <verse eid="DAN 9:24" /><verse number="25" style="v" sid="DAN 9:25" />दानीयल तु ईनी वात काजे जाणी ले ने समजी ले। की यरुसलेम काजे फीर सी वसणेन हुकुम नीकळने सी लीन नेवाड़ला<note caller="+" style="f"><char style="fr" closed="false">9:25 </char><char style="ft" closed="false">मसीह</char></note> मुख्‌यान टेमे लग सात हाप्‌ता वीतसे। अळी साठ ने दुय हाप्‌ता वीतणे पर बेमटा ने खुयार समेत तीना जीलाक काठला टेम मां फीर सी वसाड़से। <verse eid="DAN 9:25" /><verse number="26" style="v" sid="DAN 9:26" />तीनु साठ ने दुय हाप्‌ता वीतणे पर नेवाड़ला<note caller="+" style="f"><char style="fr" closed="false">9:26 </char><char style="ft" closed="false">मसीह</char></note> मां सी मार नाखसे, ने तेर हातेम काय नी रवसे, ने आवणे वाळा मुख्‌यान माणसे सहर ने चुखला जागा काजे नास ते करसे। बाकुन तीना मुख्‌यान नास असो हवसे जसी नदी आवसे; तेबी आकरी लग लड़ाई हवती रवसे; काहाकी तेरो उजड़ी जाणु पाक्‌को हय गुयलो छे। <verse eid="DAN 9:26" /><verse number="27" style="v" sid="DAN 9:27" />चु मुख्‌यु एक हाप्‌ता लक बेसका जणा पुठे पाक्‌कु वायदु करसे, बाकुन आदु हाप्‌तु वीतणे पर मेळन चड़ावु ने अनेन चड़ावु बंद कर देसे, ने मंदीर मां उजाड़ने रीस आवे असली मुरती देखाव पड़से, ने पाक्‌की करली वात पुरी हवते लक भगवानेन रीस उजाड़ने वाळा पर पड़ी रवसे।”<verse eid="DAN 9:27" /></para>
  <chapter eid="DAN 9" />
  <chapter number="10" style="c" sid="DAN 10" />
  <para style="s">दानीयल काजे हीदेकेल<note caller="+" style="f"><char style="fr" closed="false">10:1 </char><char style="ft" closed="false">फारसी बुली मां हीना काजे तीगरीस कहें</char></note> नदी धड़े सपनो देख्‌यु</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 10:1" />कुस्‌रु फारस देसेन राजु हतलु, कुर्‌सु राजान राज मां तीसरे साल दानीयल काजे ईनी वातेन बारामां मालुम हय गुयलो, दानीयलेन दीसरो नाव बेलतसस्‌सर हतलो, जी वात उजेंती हय गुय की, जी वात छाचली हतली की जां बेसकी मटी लड़ाय हवसे, दानीयल तीनी वात काजे जाणी लेदलु ने दानीयल काजे जी देखली वात समज मां आय गुय।<verse eid="DAN 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="DAN 10:2" />तीनी टेमे मां, मे दानीयल, तीन हाप्‌ता लक दुख झेलतु रयु। <verse eid="DAN 10:2" /><verse number="3" style="v" sid="DAN 10:3" />हीनु तीन हाप्‌ता पुरा हवते लग, मे नी ते सवादो खाणो खादु, ने नी सीकार खादु, ने नी अंगुरेन रस मारा मुंहडाम नाख्‌यु, ने नी मारा डील मां तेल चुपड़्‌यु।<verse eid="DAN 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 10:4" />अळतेन मे पेहला महनान वीस ने चोवथे दाहड़े जत्‌यार मे हीदेकेल<note caller="+" style="f"><char style="fr" closed="false">10:4 </char><char style="ft" closed="false">तीगरीस नदी धड़े</char></note> नावेन नदी धड़े हतलु। <verse eid="DAN 10:4" /><verse number="5" style="v" sid="DAN 10:5" />तत्‌यार मे उपर भाळीन देख्‌यु, की सणेन पुथल्‌या पेहरी रह्‌लु, ने उफाज देसेन चुखला सनान पट्‌टु कमर मां बांदीन एक अदमी उबी रवलु। <verse eid="DAN 10:5" /><verse number="6" style="v" sid="DAN 10:6" />तेरो डील मंहगला मणीन तसो हतलो, ने तेरो मुंहडो ईजळीन तसो हतलो, ने तेरा डुळा धपतेला दीवान तसा हतला, ने तेरी कमर मां ने पांय भबळतेला पीतळ्‌यान तसो हतलो, ने तेरा बुलेन अवाज मटली भीड़ेन अवाजेन तसी हतली।<note caller="+" style="x"><char style="xo" closed="false">10:6 </char><char style="xt" closed="false"><ref loc="REV 1:13-15">उजेंता बुले 1:13-15</ref>; <ref loc="REV 2:18">2:18</ref>; <ref loc="REV 19:12">19:12</ref> </char></note><verse eid="DAN 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 10:7" />तीनाक नीस्‌तु मे दानीयल अतरुत देख्‌यु, ने जे माणसे मार पुठ्‌ये हतला, चे काय नी देख्‌या, बाकुन चे बेसका थर-थर करने बाजी गुया। ने डुकायणे वाटे ढास गुया। <verse eid="DAN 10:7" /><verse number="8" style="v" sid="DAN 10:8" />तत्‌यार मे एखलुत रयन जो बेसको मटो सपनो देखतु रयु, हेरेसी मारी ताकत जाती रय, ने बेसकु बीही गुयु, ने मेसेक कुय बी नी उळखी सक्‌या। <verse eid="DAN 10:8" /><verse number="9" style="v" sid="DAN 10:9" />तेबी मे तीना माणसेन बुलेन आवाज सामळ्‌यु, ने जत्‌यार चु मेसेक सामळाय देदु, तत्‌यार मे मुंहडान ने भुरसे हीट पड़्‌यु, ने बेसकी नींद मां धरती पर उबडु हय्‌न पड़ गुयु। <verse eid="DAN 10:9" /><verse number="10" style="v" sid="DAN 10:10" />पछेन काहनुक आपसे हाते करीन मारा डील काजे छीम्‌यु। ने मेसेक बठु करीन मांडान ने हातेन भुरसे थर-थर कापाड़तु जाय्‌न मेसेक उबु कर देदु। मे हय बी कापणे बाजी रवलु।<verse eid="DAN 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 10:11" />तत्‌यार चु मेसेक कह्‌यु, “ए दानीयल तु भगवानेन बेसकु लाटेकलु पुर्‌यु छे, जो बुल मे तुसेक सामळावो, तीनाक तु समजी जाजी, ने सुदु उबु रवजी, काहाकी हय मे तार धड़े मकली रयु” जत्‌यार चु मेसेक जो बुल सामळावलु, तत्‌यार मे उबु ते हय गुयु, बाकुन चु थर-थर कापणे बाजी गुयु।<verse eid="DAN 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="DAN 10:12" />तेरेमां चु मेसेक कह्‌यु, ए दानीयल, तु मां बीहे, काहाकी तु सपनान मतलब समजणेन काठी कुसीत कर्‌यु। जत्‌यार तु समजणे सुचणे मां मन लागाड़्‌यु ने आपसा भगवान अगळ आपसा काजे नीचळु कर्‌यु, तीनेत दाहड़े तारी दुवा सामळी लेदा ने तारी दुवान जपाप वाटे जां आय रयु। <verse eid="DAN 10:12" /><verse number="13" style="v" sid="DAN 10:13" />फारस राजेन मुख्‌यु वीस ने एक दाहड़ु तक मार साते लड़ाय करतु रयु, बाकुन मीकायेल जु एक खास मुख्‌यु छे, सरग दुत मारी मदत करने आयु, हेरेसी मे फारस राज मां एखलुत रय गुयु,<note caller="+" style="x"><char style="xo" closed="false">10:13 </char><char style="xt" closed="false"><ref loc="REV 12:7">उजेंता बुले 12:7</ref></char></note> <verse eid="DAN 10:13" /><verse number="14" style="v" sid="DAN 10:14" />ने हय मे तुसेक समजाड़ने आय रयु, की आकरी दाहड़ाम तारा माणसे पर काय वीतसे। काहाकी जो सपनो तु देखलु‌ छे, चो थुड़ाक दाहड़ा पछेन पुरो हय जासे।<verse eid="DAN 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 10:15" />तत्‌यार चु माणुस मार सी असी वात कह्‌यु, तत्‌यार मे धरती भीणी मुंहडो कर्‌यु ने हुगु रय गुयु। <verse eid="DAN 10:15" /><verse number="16" style="v" sid="DAN 10:16" />तत्‌यार माणसेन अवल्‌यात साय काहनुक मारा हुटड़ा काजे छीम्‌यु, ने मे मुंहडो उघाड़ीन बुलने बाजी गुयु। ने जु मार अगळ उबु हय रवलु, तीनुक मे कह्‌यु, ए मारा मालीक सपनान वजे सी मेसेक दुख हयो, ने मारेम काय बी ताकत नी रय। <verse eid="DAN 10:16" /><verse number="17" style="v" sid="DAN 10:17" />हेरेसी मारा मालीकेन जु पावर्‌यु, आपणा मालीक साते कसु वात कर सके? काहाकी मारा डील मां नी ते काय ताकत रय, ने नी काय मारेम जीव रयु।<verse eid="DAN 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 10:18" />तत्‌यार माणसेन तसु देखायतेलु, ने मेसेक छीम्‌यु ती मेसेक हीम्‌मत आप्‌यु। <verse eid="DAN 10:18" /><verse number="19" style="v" sid="DAN 10:19" />ने चु कह्‌यु, “ए मारा भगवानेन लाटेक‌ला पुर्‌या, मां बीहें, तुसेक सांती आपो, तु काठु रव, ने तु हिम्‌मत राख।”</para>
  <para style="p" vid="DAN 10:19">जत्‌यार चु मेसेक कह्‌यु, ती मेसेक हिम्‌मत आप्‌यु, ए मारा मालीक हय कव, काहाकी तु मेसेक ताकत आपाड़्‌यु।<verse eid="DAN 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 10:20" />तत्‌यार चु मेसेक कह्‌यु, तु ते जाणे की मे तार धड़े काय लेणे आय रयु? हय मे फारस देसेन मुख्‌या सी लड़ाय करने पछु जाय्‌स, ने जत्‌यार मे लड़ाय करने जाय्‌स, ती युनान देसेन मुख्‌यु आवसे। <verse eid="DAN 10:20" /><verse number="21" style="v" sid="DAN 10:21" />अळतेन जी छाचली वात खरला-सासतुर मां लिखली छे, ची मे तुसेक देखाड़ीस, तीनु मुख्‌यान वीरुद, तुंद्‌रा मुख्‌या मीकायेल काजे छुड़ीन अळी मार साते रवणे वाळा मुख्‌या कुय नी हय।<verse eid="DAN 10:21" /></para>
  <chapter eid="DAN 10" />
  <chapter number="11" style="c" sid="DAN 11" />
  <para style="p">
    <verse number="1" style="v" sid="DAN 11:1" />मे दारा नावेन मादी राजान राज सी पेहले साल, मां तीनाक हिम्‌मत आपणे ने ताकत देणे वाटे मे उबु हय गुयु।<verse eid="DAN 11:1" /></para>
  <para style="s">मीसरे ने सीरीयान राज</para>
  <para style="p">
    <verse number="2" style="v" sid="DAN 11:2" />हय मे तुहुंक खरली वात देखाड़ो, देखु फारस्‌यान राज मां हय तीन अळी राजा बणसे, ने चोवथु राजु तीनु आखा सी अदुस मालदार रवसे। ने तत्‌यार चु राजु मे मालदार छे, करीन बेसकु ताकतवाळु रवसे, तत्‌यार आखा माणसे काजे युनान राज्‌येन वीरुद मां लड़ाय कराड़से।<verse eid="DAN 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="DAN 11:3" />तेरे पछेन एक सक्‌तीवाळु राजु आवसे चु आप्‌सो बेसको राज वदाड़से, ने आपसी मरजीन अनसारेत चु काम करसे। <verse eid="DAN 11:3" /><verse number="4" style="v" sid="DAN 11:4" />जत्‌यार चु मटु हवसे, तत्‌यार तेरु राज्‌य टुटीन च्‌यारे-मेर वाटाय जासे, ने चारु खुणा मां वाटायन अलग-अलग हय जासे, ने नी आपसा राजेन ताकतेन असर तीना देस पर पड़से, ने नी आपसी अवल्‌यात काजे काय जड़से; काहाकी आपसा राजेन हक आपसे धड़े सी हापकीन दीसराक आप देसे।<verse eid="DAN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 11:5" />तत्‌यार मीसरे देसेन राजु ताकत वाळु बणसे, बाकुन तेरु एक मुख्‌यु तेरेसी अदुस ताकतवाळु हवसे, ने चु एक नवलु देस बणावसे, जां लग की चु बेसकु ताकत वाळु हवसे। <verse eid="DAN 11:5" /><verse number="6" style="v" sid="DAN 11:6" />काहीं साल वीतणे पर, जे दुयु एक दीसरा साते भेळा हवसे ने मीसरे देसेन राजान पुरे धुराव देसेन राजा धड़े सांतीन वायदु करने आवसे बाकुन चां राजान पुरेन ताकत जलम वाटे नी चाले, ने चु राजा ने तेरो नाव रवे, बाकुन ची बायरी आपसा मकलने वाळा ने आपसा बास ने आपसा समाळने वाळा समेत छेटे कर देसे। <verse eid="DAN 11:6" /><verse number="7" style="v" sid="DAN 11:7" />अळतेन तत्‌यारुत पछेन हेरु एक रीस्‌तेदार राजु बण जासे चु सीरीया देसेन राजान सीपायड़ा पर हमलु कर देसे हींद्‌रा कीला मां बी भराय जासे ने हीनुक हाराड़ देसे। <verse eid="DAN 11:7" /><verse number="8" style="v" sid="DAN 11:8" />तत्‌यार चु तीनु देवतान उदरली मुरती, ने सना चांदीन बणावली मंहगली मुरतीन चीज काजे हापकीन मीसरे देस मां ली जासे। तेर पछेन चु थुड़ाक साल तक सीरीया देसेन राजान वीरुद मां हमलु नी करे। <verse eid="DAN 11:8" /><verse number="9" style="v" sid="DAN 11:9" />तत्‌यार चु राजु सीरीया देसेन राजान देस भीणी आवसे, बाकुन अळी चु राजु आपसा देस मां पछु जाती रवसे।<verse eid="DAN 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 11:10" />आपसा पुर्‌या लड़ाय करने करीन तीयारी करसे ने बेसका मटला टुळा काजे भेळा करसे, जु नी रुके असला जळडुबेन तसा दवड़ीन अगा बड़से, ने वेरीन कीला तक लड़ाय करता जासे। <verse eid="DAN 11:10" /><verse number="11" style="v" sid="DAN 11:11" />तत्‌यार सीरीया देसेन राजाक रीस लागसे, ने जाय्‌न मीसरे देसेन राजा सी लड़ाय करसे, ने चु राजु लड़ाय करने करीन मटलु टुळु भेळु करसे, बाकुन तीना टुळाक दखवाण देसेम सी आवला राजान हात मां आप देसे। <verse eid="DAN 11:11" /><verse number="12" style="v" sid="DAN 11:12" />रीस मां आवीन मीस्‌रे देसेन राजु सीरीया देसेन राजान वीरुद मां लड़ाय करसे ने हेरा बेसका सीपायड़ा सी जीत नी सके।<verse eid="DAN 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 11:13" />काहाकी सीरीया देसेन राजा आयन पेहेल सी बी मटलु टुळु भेळु करसे, ने काही दाहड़ा ने साल वीतणेन पर चु छाचलीन बेसका सीपायड़ा ने धन लीन आवसे। <verse eid="DAN 11:13" /><verse number="14" style="v" sid="DAN 11:14" />तीनु दाहड़ाम बेसका माणसे मीसरे देसेन राजान वीरुद मां बुलसे, बाकुन तारा माणसे मां सी बी लड़ाय करन्‌या माणसे नीकळसे, तेरेसी ईना सपनान वात पुरी हय जासे, ने चे ठुकर खाय्‌न हीट पड़से। <verse eid="DAN 11:14" /><verse number="15" style="v" sid="DAN 11:15" />तत्‌यार सीरीया देसेन राजु आयन कीला काजे घेरवी लेसे ने तेरे उपर हक कर लेसे। ने मीसरे देसेन नी ते मुखी उबा रवसे, ने नी काहनाक मटला ताकतवाळान उबा रवणेन ताकुत नी रवे। <verse eid="DAN 11:15" /><verse number="16" style="v" sid="DAN 11:16" />तत्‌यार जे बी तींद्‌रे वीरुद मां आवसे, चु आपसी मरजी पुरी करसे, ने चु आपसा हातेम नास करने वाटे वादु करलो वारलु देस मां बी उबु हवसे, ने तेरु मुकाबलु करने वाळु कुय नी रवसे।<verse eid="DAN 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 11:17" />तत्‌यार चु आपसा राजेन आखी ताकत भेळ काही वारलु माणसे काजे साते लीन आवसे, ने आपसी मरजीन अनसारे काम कर्‌या करसे। चु तीनुक आपसी बायरीन पुरे साते ईयाव बी कराड़नेन युजना बणावसे, तेबी तेरी युजना पुरी नी हवे, ने तेरु काय बी फायदु नी हवे। <verse eid="DAN 11:17" /><verse number="18" style="v" sid="DAN 11:18" />ने तत्‌यार चु मटला समुदर भीणी मुंहडो कर लेसे ने बेसका माणसे काजे साते ली लेसे, बाकुन एक सीपायड़ान मुख्‌यु आपसी मटाय काजे सार देसे, बाकुन तेरी मटाय्‌न अनसारे तेरेसी बदलु लेसे। <verse eid="DAN 11:18" /><verse number="19" style="v" sid="DAN 11:19" />तत्‌यार चु आपसा देसेन कीला भीणी आपसो मुंहडो कर लेसे, ने चु ठुकर खाय्‌न हीट पड़से, ने तेरु काय पतु नी लागे।<verse eid="DAN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 11:20" />“हेरे पछेन एक अळी राजु आवसे, जु आपणा राज्‌येन धन बड़ावणे वाटे माणसे पर पयस्‌या मांगीन परेसान करने वाटे एक आफसर काजे मकलसे। थुड़ीक टेम मां हीना राजा काजे मार देसे, बाकुन माणसे अगळ नी ने नी लड़ाय मां।”<verse eid="DAN 11:20" /></para>
  <para style="s">सीरीया देसेन वेरी राजु</para>
  <para style="p">
    <verse number="21" style="v" sid="DAN 11:21" />तीना जागा मां एक एकहेट्‌यु राजु उबु हवतेत चु राजगादी पर बठसे, बाकुन चु तेरे लायक नी रवे, तेबी चु वारु-वारु वात करीन राज हात कर लेसे। <verse eid="DAN 11:21" /><verse number="22" style="v" sid="DAN 11:22" />तत्‌यार बेसका सीपायड़ा तेर साहरे सर जासे, ने वायदान मुख्‌यु बी हेरे अगळ सी उहवीन खत्‌तम हय जासे। <verse eid="DAN 11:22" /><verse number="23" style="v" sid="DAN 11:23" />काहाकी चु तेरे साते वाचा बांदणे पर बी धुकु करसे, ने थुड़ाक माणसे काजे साते चहड़ीन ताकत वाळु बणसे। <verse eid="DAN 11:23" /><verse number="24" style="v" sid="DAN 11:24" />चु वारु आरामेन दाहड़ाम सी देसेन मटला सहर पर लड़ाय करसे। ने जो काम तेरा डाहा-डाहा ने नी तेरा डाहा डाहान डाहा-डाहा करतेला, तीनाक चु करसे, ने लुटला धन काजे आपसा माणसे मां वाट देसे, चु थुड़ीक टेम लग मटला सहर काजे लेणेन वीच्‌यार करतु रवे।<verse eid="DAN 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 11:25" />तत्‌यार चु मीसरे देसेन राजा भीणी एक मटला सीपायड़ान टुळा लीन आवसे ने आपसी ताकत ने हिम्‌मत वदाड़से, ने मीसरे देसेन राजु बेसका मटा ताकतवाळा सीपायड़ा लीन आवसे ने लड़ाय ते करसे, बाकुन टीकी नी सके, काहाकी माणसे तेर वीरुद मां वीच्‌यार करसे। <verse eid="DAN 11:25" /><verse number="26" style="v" sid="DAN 11:26" />तेरो खाणो खाणेवाळा बी तीनाक खत्‌तम करनेन कुसीत करसे, ने कदी तेरा सीपायड़ा जळडुबेन तसा चहड़से, तेबी तींद्‌रा बेसका माणसे लड़ाय करीन मर जासे। <verse eid="DAN 11:26" /><verse number="27" style="v" sid="DAN 11:27" />तत्‌यार तीनु दुह्‌यु राजान मन बुराई करने मां लाग जासे, जां तक की चे एकुत टेबल पर बसीन आपसात आपसा लुच्‌चाय करसे, बाकुन तेरेसी काय नी हवे, काहाकी ईनी आखी वातेन आकरी टेम संय टेम मां हवसे। <verse eid="DAN 11:27" /><verse number="28" style="v" sid="DAN 11:28" />तत्‌यार सीरीया देसेन राजु आपसा देस काजे बेसकु लुटीन खासे, ने तेरो मन भगवानेन चुखला वायदा भीणी रीस करसे, ने चु आपसी मरजी पुरी करीन आपसा देसेम पछु जाती रवसे।<verse eid="DAN 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 11:29" />अळी पछेन चु राजु मीसरे देस भीणी अळी पछु जासे, बाकुन तीनी पेहली कावान तसु पछेन तीनाक नी लुटीन खावाये। <verse eid="DAN 11:29" /><verse number="30" style="v" sid="DAN 11:30" />काहाकी रोमी माणसेन ढंड्‌या तेरी वीरुद करसे, ने चु उदास हयन पछु जाती रवसे,</para>
  <para style="p" vid="DAN 11:30">ने चुखला कायदा पर रीस करीन आपसी मरजी पुरी करसे। चु पछु आयन चुखला कायदाक नी माने तींद्‌री खबर लेसे। <verse eid="DAN 11:30" /><verse number="31" style="v" sid="DAN 11:31" />तत्‌यार तींद्‌री मदत करन्‌या उबा हयन काठा चुखला जागाक ईटाळ देसे, ने तत्‌यारुत आकठान बादा काजे बंद कर देसे। ने चे तीनी बेकार चीज काजे उबी करसे, जी तीनी चीज काजे सारी देय। <verse eid="DAN 11:31" /><verse number="32" style="v" sid="DAN 11:32" />ने जे माणसे वेरी हयन तीना वायदा काजे तुड़से, तीनुक जु चीकनी-चुपड़ी वात कंय-कंयन भटकाड़ देसे, बाकुन जे माणसे आपसा भगवानेन अक्‌कल राखसे, चे हिम्‌मत सी वीरुद करसे। <verse eid="DAN 11:32" /><verse number="33" style="v" sid="DAN 11:33" />तींद्‌रेम सी थुड़ाक अक्‌कल वाळा माणसे, जे दीसरा माणसेक समजाड़से, तेबी चे बेसका दाहड़ा लग तलवार सी मारीन ने आकठा मां धपाड़ीन, ने गुलामी मां जाय्‌न ने लुटायन, मटला दुख मां पड़ी रवसे। <verse eid="DAN 11:33" /><verse number="34" style="v" sid="DAN 11:34" />ने चे दुख मां पड़ीन मारायणु चालु रवसे, तत्‌यार थुड़ाक माणसे मदत सी बची जासे, बाकुन बेसका माणसे वारु-वारु वात कय्‌न दीसरा माणसे साते भेसकाय जासे। <verse eid="DAN 11:34" /><verse number="35" style="v" sid="DAN 11:35" />ने सीकाड़ने वाळा माणसे मां सी थुड़ाक माराय जासे, चे हेरेसी हीट पड़से की चे पारखाय जाय, ने वारु ने चुखला बणे ने आकरी टेमे तक नी-गुनाळा रवसे, काहाकी हीनी आखी वातेन हवणु संय टेमे पुरो हवसे।<verse eid="DAN 11:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="DAN 11:36" />तत्‌यार चु राजु आपसी मरजीन अनसारे काम करसे, ने आपसुत आखा देवता सी उचु ने मटु छे करीन कवसे, ने आखा देवतान ने भगवानेन वीरुद मां बी गलत वात करसे, जां तक भगवानेन रीस सेळाय नी जाय, चां तक तीना राजान काम पुरो हवतो रवसे, काहाकी जो नख्‌खी करलो छे चो जरुड़ पुरो हवसे। <verse eid="DAN 11:36" /><verse number="37" style="v" sid="DAN 11:37" />चु नी ते आपसा डाहा-डाहान देवतान फीकुर करसे, ने नी चु बायरीन देवतान फीकुर करसे। ने नी काहनाक देवतान ईज्‌जत करे, बाकुन चु आपसुत कवसे की मे आखा सी मटु छे। <verse eid="DAN 11:37" /><verse number="38" style="v" sid="DAN 11:38" />चु आपसान राजान पद पर टीकी रय्‌न कीलान देवतान ईज्‌जत करसे, एक असु देवता तीनाक तेरा आड़ा-बुड़ा बी नी जाणतेला, चे सोनो, चांदी, मंहगली मणी अळी जसो चाहजे तसो मंहगलो भेट चड़ावीन तींद्‌री बड़ाय करसे। <verse eid="DAN 11:38" /><verse number="39" style="v" sid="DAN 11:39" />चु एक पारका देस वाळा देवतान मदत सी आखाम ताकतवाळा कीला पर लड़ाय करसे ने जु काहनुक तीनाक माने तीनाक चु मटी ईज्‌जत आपसे, जे तीनुक राजान रुप मां मानसे, चु तीनुक बेसका माणसे पर राजु बणावसे ने तीनुक ईनाम वाटे आपसा देसेन जागा काजे वाट देसे।<verse eid="DAN 11:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="DAN 11:40" />आकरी टेम आवसे ती मीसरे देसेन राजु तीनाक सींगड़ा सी मारसे, बाकुन सीरीया देसेन राजु तींद्‌रे पर भुत्‌यान तसु बेसकु लड़ाय करने आवसे ने बेसका घुड़ा गाड्‌या ने ढंड्‌या लीन लड़ाय करसे, हेरे वजे सी चु आखा देसो मां पुगी जासे, ने तींद्‌रेम सी नीकळी आवसे। <verse eid="DAN 11:40" /><verse number="41" style="v" sid="DAN 11:41" />चु वायदान देस पर बी लड़ाय करसे, ने बेसका देस उजड़ी जासे, बाकुन एदोमी, मोआबी ने अम्‌मोनी राजेन मुख्‌या आपसा हातेम सी बची जासे। <verse eid="DAN 11:41" /><verse number="42" style="v" sid="DAN 11:42" />चु काही देस पर हमलु करसे ने मीसरे देस पर बी हमलु करसे। <verse eid="DAN 11:42" /><verse number="43" style="v" sid="DAN 11:43" />चु मीसरे देसेन आखा सनो, चांदीन खजाना ने आखी चीजेन मालीक हय जासे, ने लुबीया देसेन ने कुसी देसेन<note caller="+" style="f"><char style="fr" closed="false">11:43 </char><char style="ft" closed="false">नीळ नदीन ईलाकान उपरला भागेन माणसे </char></note> माणसे बी तेरे पछळ हय जासे। <verse eid="DAN 11:43" /><verse number="44" style="v" sid="DAN 11:44" />तीनी टेमे चु उगेवणु ने बुडेवणु सी खुस-खबर सामळीन घाबराय जासे, ने चु बेसकु रीसवायन बेसका माणसेक सारने करीन नीकळसे। <verse eid="DAN 11:44" /><verse number="45" style="v" sid="DAN 11:45" />चु दर्‌यान ने बयड़ान ईचमां चुखली वाचान वारका देसेन बयड़ा धड़े राजपाटेन तम्‌बु उबु कराड़से; अतरो करने पर बी तेरो आकरी आय जासे, ने कुय बी तेरु मदत करने करीन नी आवे।<verse eid="DAN 11:45" /></para>
  <chapter eid="DAN 11" />
  <chapter number="12" style="c" sid="DAN 12" />
  <para style="s">आकरी टेम</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 12:1" />तीनी टेमे मीकायेल नावेन मटलु मुख्‌यु, जु तारा माणसेन सात देणे मां उबु हवसे, चु आवसे। तत्‌यार असी गरान टेम आवसे, जसा काहनोक राज्‌य हवसे तीनी टेमे ती हय तक कदी नी हयो, ने नी हवसे; बाकुन तीनी टेमे तारा माणसे मां सी जतरान नाव भगवानेन किताप मां लिखायलो छे, चे बची जासे।<note caller="+" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="MAT 12:1">मत्‌ती 12:1</ref>; <ref loc="MRK 13:19">मरकुस 13:19</ref>; <ref loc="REV 7:14">उजेंता बुले 7:14</ref>; <ref loc="REV 12:7">12:7</ref></char></note> <verse eid="DAN 12:1" /><verse number="2" style="v" sid="DAN 12:2" />जे धरतीन हेटा मसाण मां सुय रवसे, तींद्‌रे मां सी बेसका माणसे उबा हय जासे, कतरा ते जलम जीवतेला रवसे, ने कतरा ते आपसान बदनामी ने जलमका वाटे भगवानेन नींगा मां कुहराय करने वाटे।<note caller="+" style="x"><char style="xo" closed="false">12:2 </char><char style="xt" closed="false"><ref loc="ISA 26:19">यसाया 26:19</ref>; <ref loc="MAT 25:46">मत्‌ती 25:46</ref>; <ref loc="JHN 5:29">युहन्‌ना 5:29</ref></char></note> <verse eid="DAN 12:2" /><verse number="3" style="v" sid="DAN 12:3" />तत्‌यार सीकाड़ने वाळा सरगेन तारा मंडळीन तसा भबळसे, ने जे बेसका माणसे काजे धरमी बणावसे, चे जलमकात तारान तसा भबळसे।<verse eid="DAN 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 12:4" />बाकुन ए दानीयल, तु ईनी किताप पर छाप लागाड़ीन ईनु बुल काजे आकरी टेमे तक साताड़ीन राख।<note caller="+" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="REV 22:10">उजेंता बुले 22:10</ref></char></note> ने बेसका माणसे पुछसे ने अथान-अथा हेरसे, काहाकी तेरेसी अक्‌कल बी आय जासे।<verse eid="DAN 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 12:5" />जो आखो सामळीन, मेसेक दानीयल भाळीन काय देख्‌यु की अळी दुय अदमी उबा हय रया, एक ते नदीन ईनी धड़े, दीसरु नदीन पली धड़े छे। <verse eid="DAN 12:5" /><verse number="6" style="v" sid="DAN 12:6" />तत्‌यार चु अदमी सणेन पुथल्‌या पेहरीन नदीन पाणी पर हतलु, तीनु माणसे मां सी काहनुक एक पुछ्‌यु, जे छेलभात्‌या काम कत्‌यार खत्‌तम हवसे।<verse eid="DAN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 12:7" />तत्‌यार जु माणुस सणेन पुथल्‌या पेहरीन नदीन पाणी उपर हतलु, चु मारी सामळतेत जेवड़्‌यु हात ने डाखर्‌यु हाय आपसा दुयु हात काजे सरगे भीणी उपर करीन, जलम जीवतेला रह्‌णे वाळान सगुन खायलीन कह्‌यु, “जी हालत साड़े तीन साल तक रह्‌से; ने जत्‌यार चुखला माणसेन दुख झेलनु खत्‌तम हय जासे, ती जी वात आखी पुरी हय जासे।”<note caller="+" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="REV 10:5">उजेंता बुले 10:5</ref>; <ref loc="REV 12:14">12:14</ref></char></note><verse eid="DAN 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 12:8" />जी वात मे सामळतेलु ते खरु, बाकुन काही नी समजी सक्‌यु। तत्‌यार मे कह्‌यु, “ए मारा मालीक, ईनी वातेन आकरी फळ काय हवसे?”<verse eid="DAN 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="DAN 12:9" />बाकुन चु कह्‌यु, ए दानीयल जाती रव; काहाकी जी वात आकरी टेम लक मुहर लागाड़ीन बंद करली छे। <verse eid="DAN 12:9" /><verse number="10" style="v" sid="DAN 12:10" />बेसका माणसे आपसा-आपसा काजे चुखला करसे ने धवेळ्‌ळा करसे, ने चुखला हय जासे; बाकुन कुहराय करन्‌या माणसेक कुहरायत करने देवु, कुहर्‌या माणसे मां सी काहनुक जी वात नी समजसे, बाकुन जु अक्‌कल वाळु छे चे समजसे।<note caller="+" style="x"><char style="xo" closed="false">12:10 </char><char style="xt" closed="false"><ref loc="REV 22:10">उजेंता बुले 22:10</ref></char></note><verse eid="DAN 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 12:11" />जत्‌यार सी दाहड़ीन चड़ावणी बादा काजे रुक देसे, तत्‌यार ती हय तक जत्‌यार असी खास बेकार चीज पयदा हवसे चु छाचलीन उजाड़ कराड़ देसे, ने एक हजार दुय सोव नब्‌बे दाहड़ान टेम वीत जासे।<note caller="+" style="x"><char style="xo" closed="false">12:11 </char><char style="xt" closed="false"><ref loc="DAN 9:27">दानीयल 9:27</ref>; <ref loc="DAN 11:31">11:31</ref>; <ref loc="MAT 24:15">मत्‌ती 24:15</ref>; <ref loc="MRK 13:14">मरकुस 13:14</ref></char></note> <verse eid="DAN 12:11" /><verse number="12" style="v" sid="DAN 12:12" />वारु छे, चे माणसे बेसका भागवाळा छे, चे एक हजार ने तीन सोव तीस ने पांच दाहड़ा पुरा करसे।<verse eid="DAN 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 12:13" />“ने ए दानीयल तु आकरी लग भुरसा लायक बणीन रव तु आराम करसी, बाकुन टेमेन आकरी मां आपणो मेहनतेन फळ हात करने वाटे उठीन उबु हय जासी।”<verse eid="DAN 12:13" /></para>
  <chapter eid="DAN 12" />
</usx>