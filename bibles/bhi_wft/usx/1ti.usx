<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TI" style="id">- Bhilali Standard Project</book>
  <para style="h">1 तीमुथीयुस</para>
  <para style="toc3">1 तीमुथीयुस</para>
  <para style="toc2">1 तीमुथीयुस</para>
  <para style="toc1">तीमुथीयुस वाटे पोलुसेन पेहली चिट्‌ठी</para>
  <para style="mt2">तीमुथियुस के लिए पौलुस की पहली पत्री</para>
  <para style="mt1">तीमुथीयुस वाटे पोलुसेन पेहली चिट्‌ठी</para>
  <para style="imt">1 तीमुथीयुसेन बारामां</para>
  <para style="ip">पेहला तीमुथीयुस किताप नेवताळान काम पोलुसेन साहरे आपणा चेला तीमुथीयुस काजे लिखी गुय एक चिट्‌ठी छे। पेहला तीमुथीयुस अनुमान मसीन पयदा हवणेन 62-64 सालेन पछे लिखी गुयो ज्‌य पोलुसेन जीवणेन आकरी आवणु साते छे हतलो। पोलुसेन तीमुथीयुस साते गहरो रीस्‌तो हतलो ने हीयु हीनाक काय कावा पुर्‌यान रुप मां बन्‌लो छे। <char style="xt"><ref loc="PHP 2:22">फीलीपीयो 2:22</ref></char> <char style="xt"><ref loc="1TI 1:2">1 तीमुथीयुस 1:2</ref>; <ref loc="1TI 1:18">1:18</ref></char></para>
  <para style="ip">ज्‌य पोलुसेन चार चिट्‌ठीया मां सी एक छे ज्‌य एक मंडळीन बजाय एक माणुस काजे अगवाय करे दीसरा चिट्‌ठीया दीसरा तीमुथीयुस, तीतुस ने फीलोमेन छे। पेहला तीमुथीयुस मां मंडळीन बड़ाय <char style="xt"><ref loc="1TI 2:1-15">2:1-15</ref></char> मंडळीन अगवाय वाटे लायक <char style="xt"><ref loc="1TI 3:1-13">3:1-13</ref></char> ने लुच्‌चा सीकाड़्‌यान वीरुद चेतावणी <char style="xt"><ref loc="1TI 1:3-11">1:3-11</ref>; <ref loc="1TI 4:1-5">4:1-5</ref>; <ref loc="1TI 6:2-5">6:2-5</ref></char> ज्‌य दरसाय मेल्‌यो की कसु पोलुस तीमुथीयुस काजे मंडळी मां अगवाय करने वाळु बणने वाटे सीकाड़ तेलु। पेहला तीमुथीयुस मां बेसकु दरसन छे ज्‌य हामरा दाहड़ा मां मंडळी मां अगवाय करन्‌या काजे नेचले जागान मंडळ्‌यान सेवान देख रख करने मां मदत कर सके।</para>
  <para style="iot">बाहरती वात</para>
  <para style="io1">1. पोलुस तीमुथीयुस आव-भाव करतु जाय सुरु करे। <char style="ior"><ref loc="1TI 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2. तत्‌यार चु तीमुथीयुस काजे लुच्‌चा सीकाड़े वाळान वीरुद चेतावणी देय। <char style="ior"><ref loc="1TI 1:3-11">1:3-11</ref></char></para>
  <para style="io1">3. पोलुस ज्‌य बताड़तु जाय्‌न जारी राखे की ईसु मसी वाटे कतरु अभारी छे। <char style="ior"><ref loc="1TI 1:12-19">1:12-19</ref> </char></para>
  <para style="io1">4. हेरे पछेन चु तीमुथीयुस काजे बड़ायन ने मंडळीन बारामां आदेस आपे। <char style="ior"><ref loc="1TI 2-3">2—3</ref></char></para>
  <para style="io1">5. पोलुस तीमुथीयुस काजे थुड़ाक आकरी आदेस आपीन आपणी चिट्‌ठी काजे सार्‌यु। <char style="ior"><ref loc="1TI 4-6">4—6</ref> </char></para>
  <chapter number="1" style="c" sid="1TI 1" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 1:1" />पोलुस भीणी सी जु आपणुक छुड़ावणे वाळु भगवान ने हामरी आसेन साहरु मसी ईसुन हुकुम सी ईसु मसीन नेवतावाळु छे।<verse eid="1TI 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1TI 1:2" />तीमुथीयुस नाव जु भुरसा मां मारु छाचलु पुर्‌यु छे:</para>
  <para style="p" vid="1TI 1:2">बास भगवान ने हामरु मालीक ईसु मसीन दया ने गीण-दया ने सुक सांती तुसेक जड़ती रहणु चाहजे।<verse eid="1TI 1:2" /></para>
  <para style="s">पोलुस तीमुथीयुस काजे झुटी वात सीकाड़न्‌याक रुकणेन हुकुम आपे</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 1:3" />जसु मे मकीदुनीया जीला मां जाणेन टेमे तुसेक समजाड़लु, की ईफीसुस सहर मां रवीन थुड़ाक माणसे काजे हुकुम आप की तुहुंं भाती-भातीन झुटी वात मां सीकाड़ु। <verse eid="1TI 1:3" /><verse number="4" style="v" sid="1TI 1:4" />ने तीनु मनघड़्‌या काहाण्‌यान बारामां, ने गीणाये नी असला खानदानीन बारामां सीकाड़ी-सीकाड़ीन माणसेक खुटी मां करु। असली मनघड़ाय वात ते भगवानेन चुखला माणसेक, भुरसान साहरे भगवानेन कह्‌याम जीवणे नी सीकाड़े, बाकुन लड़ाय कराड़े; झुटी वात सीकाड़न्‌याक रुकणेन बारामां, जु हुकुम मे तुसेक आपलु, चु हुकुम पुरु करजी। <verse eid="1TI 1:4" /><verse number="5" style="v" sid="1TI 1:5" />हुकुमेन सार जु छे की चुखला मन ने वारलु समज ने खरला भुरसा सी परम उबजणु। <verse eid="1TI 1:5" /><verse number="6" style="v" sid="1TI 1:6" />झुटी वात सीकाड़न्‌या थुड़ाक माणसे ते हीना वारलु गुनाक छुड़ीन भटकी गुया ने फालतु वात मां जखड़ी पड़ने बाजी गुया। <verse eid="1TI 1:6" /><verse number="7" style="v" sid="1TI 1:7" />ने चे मटला भगवानेन नीयमेन मास्‌तर्‌या ते बन्‌ने ते हींडे पर जी वात कवे चे जी वात हिम्‌मत सी कवे तीनी वातेक चे आपसात नी समजे।<verse eid="1TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 1:8" />पर आपणु जाणजे की कदी कुय मुसान लिखलु कायदु ते वारलु छे बाकुन जसु भगवान गवा तेरेत अनसारे तीनु कायदाक समजीन सीकाड़ने सीत चे नफावाळा छे। <verse eid="1TI 1:8" /><verse number="9" style="v" sid="1TI 1:9" />ज जाणीन की भगवान जे कायदा मुसा वाटे आपलु चे धरमी माणसेक डंड आपणु करीन नी पर कायदान बीगुर जीवण्‌या पापी माणसेक तींद्‌रा पापेन बारामां ने डंडेन बारामां समजाड़ने करीन आपलु जे माणसे भगवानेन भक्‌ती नी करे, जे आस्‌या-बासेन ने डाहलान वात नी माने, माणसेन ईज्‌जत नी करे; जे कुहराय ने पाप करे जे आयस ने बासेक लग मार नाखे, <verse eid="1TI 1:9" /><verse number="10" style="v" sid="1TI 1:10" />जे छीनाळो करे, जे अदमी। अदमी साते सोवसार करे<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="fq" closed="false">अदमी साते सोवसार करे </char><char style="ft" closed="false">पुरुषगामियों</char></note>, ने जे बायरा, बायरा साते सोवसार करे, जे माणसेक कब्‌जाम करीन दीसराक वेचे, जे सगुन खाणेन टेमे लुच्‌चाय मेले, तीनु आखा वाटे तींद्‌रा पापेन बारामां ने डंडेन बारामां समजाड़ने करीन ठेहरावलु छे। <verse eid="1TI 1:10" /><verse number="11" style="v" sid="1TI 1:11" />जुत आखा सी वारु भगवानेन सेक-सींगार तीना खुस-खबरेन अनसारे छे च मेसेक आपलु छे।<verse eid="1TI 1:11" /></para>
  <para style="s">गीण-दया वाटे भगवान काजे बेसकु वारु छे कह्‌वे</para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 1:12" />मे आपणा मालीक मसी ईसुन चु मेसेक ताकत आपलु छे, वारु छे कह्‌वो की चु मेसेक ईमानदार समजीन आपसान सेवान काम वाटे नेवाड़ लेदलु छे। <verse eid="1TI 1:12" /><verse number="13" style="v" sid="1TI 1:13" />मे ते पेहेल ईसु पर भुरसु करन्‌यान नाव-बद्‌दी करतेलु तीनुक वेला पाड़तेलु ने तींद्‌रे पर दया नी कर तेलु तेबी मार पर ईसु दया कर्‌यु काहाकी मे पेहेल ईसु पर भुरसु नी करतेलु ने तीने टेमे बीना समजे जे काम करलु छे। <verse eid="1TI 1:13" /><verse number="14" style="v" sid="1TI 1:14" />ने आपणु भगवान मालीक मार पर बेसकु गीण-दया देखाड़्‌यु ने मारा हीया मन मां भुरसु ने परम ईसु मसीन साहरे भर देदलु छे। <verse eid="1TI 1:14" /><verse number="15" style="v" sid="1TI 1:15" />जी वात संय छे ने आखी भातीन भुरसु करे असी छे की मसी ईसु पापी माणसेक छुड़ावणे करीन ईनी कळी मां आवलु छे, ने मे असु मानो की तीनु आखा सी मटु पापी मे छे। <verse eid="1TI 1:15" /><verse number="16" style="v" sid="1TI 1:16" />बाकुन मारे पर तेरेमां दया हवी की आखा सी मटु पापी मेत छे तेबी ईसु मारा आखा पाप झेलतु जाय्‌न मेसेक माफ कर्‌यु की जे पापी माणसे अमर जीवाय हात करने करीन ईसु मसी पर भुरसु करसे तींद्‌रे वाटे मे ईसु पछळ चालनेन एक सहलाणी ने जपाप बण जाम। <verse eid="1TI 1:16" /><verse number="17" style="v" sid="1TI 1:17" />ने असु करीन एकुत खरला भगवानेन ईज्‌जत ने बड़ाय पीड़ीडीट जलम हवती रवे जु नी देख्‌यु अमरकाय, ने जलमेन राजु छे! आमीन।<verse eid="1TI 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1TI 1:18" />ए पुर्‌या तीमुथीयुस भगवानेन अघी सी आवणे वाळी वात बताड़न्‌या माणसे जे बुल तारा बारामां पेहेल सीत तुसेक कवला मे तुसेक जु हुकुम आपो की तु तींद्‌रे अनसारे वारलु लड़ाय काजे लड़तु रव, <verse eid="1TI 1:18" /><verse number="19" style="v" sid="1TI 1:19" />ने भुरसान वात पर ने समजदार रवीन जी लड़ायन काम पुरो कर तीनाक छेटे करने वाटे कतरा जणा भुरसा सी छेटे हय गुया। <verse eid="1TI 1:19" /><verse number="20" style="v" sid="1TI 1:20" />हींद्‌रे मां सी हुमन्‌युस ने सीकन्‌दर छे तीनुक मे भुतड़ाक आप देदलु छे की चे भगवानेन नाव-बद्‌दी<note caller="+" style="f"><char style="fr" closed="false">1:20 </char><char style="fq" closed="false">नाव-बद्‌दी </char><char style="ft" closed="false">निन्दा</char></note> करनु नी सीके।<verse eid="1TI 1:20" /></para>
  <chapter eid="1TI 1" />
  <chapter number="2" style="c" sid="1TI 2" />
  <para style="s">आखा माणसेन छुटकारा वाटे वीन्‌ती करनु जरुड़ी छे</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 2:1" />अतरे ए तीमुथीयुस, मे जी वात कहीन पेहली अगवाय करो, जत्‌यार बी ईसुक मान्‌या, भगवानेन भक्‌ती करने करीन भेळा हया, तीने टेमे आपसान करता अतरात नी, बाकुन आखा माणसेन करता भगवान धड़े रवण्‌या, वीन्‌ती ने दुवा करनु चाहजे, ने आखान करता भगवान काजे बेसकु वारु कहणु चाहजे। <verse eid="1TI 2:1" /><verse number="2" style="v" sid="1TI 2:2" />राजा ने सरकारी आफसर वाटे बी भगवान धड़े दुवा करनु चाहजे तेरेमां की आपणु भक्‌तीन जीवाय ने ईज्‌जत भेळा सांती मां मेळीन रवणेन मुखु जड़से। <verse eid="1TI 2:2" /><verse number="3" style="v" sid="1TI 2:3" />जु भगवान आपणु काजे पापेम सी छुड़ावे तीना काजे बी जी वात वारु लागे। <verse eid="1TI 2:3" /><verse number="4" style="v" sid="1TI 2:4" />भगवानेन मरजी जी छे की आखा माणसेन भलो हवणु चाहजे ने चे छाचाय काजे वारु रीते जाण लेणु चाहजे।<note caller="+" style="x"><char style="xo" closed="false">2:4 </char><char style="xt" closed="false"><ref loc="EZK 18:23">यहेजकेल 18:23</ref></char></note> <verse eid="1TI 2:4" /><verse number="5" style="v" sid="1TI 2:5" />काहाकी भगवान एकुत छे, ने भगवानेन ने माणसेन ईचमां बी मेळ करावण्‌यु बी एकुत छे, ने जु मेळ कराड़न्‌यु ते, ईसु मसी छे, जु माणसेक बचावणे करीन माणुस बणीन आवलु। <verse eid="1TI 2:5" /><verse number="6" style="v" sid="1TI 2:6" />ईसु आपसा काजे आखा माणसेन पापेम सी छुड़ावने करीन आपसा काजे भगवान अगळ बादान तसु चड़ाय देदु ने हेरी गवाय सय टेम पर देदलु। <verse eid="1TI 2:6" /><verse number="7" style="v" sid="1TI 2:7" />ने भगवान मेसेक हीनी छाचाय्‌न बारामां हय ईसुन गवा देणे करीन ईसुन नेवताळु ने परचार करन्‌यु बणावलु छे खास करीन आड़जात्‌या नी-यहुदी माणसेक ईनी छाचाय्‌न अनसारे भुरसु करनेन बारामां सीकाड़न्‌यु बणावलु छे। तेबी थुड़ाक माणसे मेसेक ईसुन नेवताळु नी मान्‌ता। बाकुन मे जी वात कहलु छे ची वात सय छे।<verse eid="1TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 2:8" />तेरेमां मे चाहो की जागे-जागे ईसुन आखी मां बीना झगड़ा मां चुखला हात काजे उचा करीन दुवा करता रहणु चाहजे। <verse eid="1TI 2:8" /><verse number="9" style="v" sid="1TI 2:9" />असात बायरा बी समळीन रहणु चाहजे, ने जचे असा पुथल्‌या पेहरीन जीवणु चाहजे ने कान्‌या भाती-भातीन नी गुथणु चाहजे ने सनान गावणो, नीते मोती नी पेहरनु चाहजे, ने बेसका मंहगला पुथल्‌या नी पेहरनु चाहजे, <verse eid="1TI 2:9" /><verse number="10" style="v" sid="1TI 2:10" />बाकुन भला काम सी काहाकी भगवान भक्‌ती करने वाळा बायरा काजे ज सय छे। <verse eid="1TI 2:10" /><verse number="11" style="v" sid="1TI 2:11" />बायरा काजे मां सीकाड़न्‌या काजे हुगा रय्‌न पुरो मन लागाड़ीन<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="fq" closed="false">पुरो मन लागाड़ीन </char><char style="ft" closed="false">अधीनता</char></note> सीकणु चाहजे। <verse eid="1TI 2:11" /><verse number="12" style="v" sid="1TI 2:12" />मे कहो की बायरा नी अदमी काजे सीकाड़नु चाहजे ने नी अदमी पर हक जमाड़नु चाहजे बाकुन हुगा हय रवणु चाहजे। <verse eid="1TI 2:12" /><verse number="13" style="v" sid="1TI 2:13" />काहाकी भगवान आदम अदमी काजे पेहेल घड़्‌यु ने पछेन हव्‌वा बायर काजे घड़्‌यु।<note caller="+" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="1CO 11:8">1 कुरींथी 11:8</ref></char></note> <verse eid="1TI 2:13" /><verse number="14" style="v" sid="1TI 2:14" />ने आदम अदमी नी ठगायु, बाकुन हव्‌वा बायर भुतड़ान आहे लागीन ठगाय गुय, ने भगवानेन हुकुम काजे पेहेल तुड़ी।<note caller="+" style="x"><char style="xo" closed="false">2:14 </char><char style="xt" closed="false"><ref loc="GEN 3:6">उबजाणनी किताप 3:6</ref></char></note> <verse eid="1TI 2:14" /><verse number="15" style="v" sid="1TI 2:15" />तेबी बायरी पुर्‌या-पारीक पयदा करी ने तीनुक वारु भुरसा मां परम मां ने चुखा काम मां सीकाड़ती जाय्‌न भगवानेन काम मां साजेली बणसे ने चे छुटकारु हात करसे।<verse eid="1TI 2:15" /></para>
  <chapter eid="1TI 2" />
  <chapter number="3" style="c" sid="1TI 3" />
  <para style="s">मंडळीन सेवा-चाकरी करन्‌या</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 3:1" />जी वात संय छे की जु बी नी पुडारी बणन्‌ने हेर करे ती चु भलो काम करनेन हेर करे। <verse eid="1TI 3:1" /><verse number="2" style="v" sid="1TI 3:2" />डाहलु असली जीवाय जीवण्‌यु हवणु चाहजे तेरी जीवाय मां काय बी वाक नी हय पुडारी एकुत लाडीवाळु हवणु चाहजे ने तेरी लाडी तेरे पर नी अदराय करे असी जीवाय जीवण्‌यु हवणु चाहजे; दसो पेट असो करन्‌यु नी बाकुन आपसान जीव काजे कब्‌जाम राखीन दीसरा साते वारु वेहवार राखण्‌यु हवणु चाहजे चु असु माणुस हवणु चाहजे तेरी दीसरा ईज्‌जत करता हय ने चु आपसान घर आवण्‌यान आव-भाव करीन तींद्‌री खातरी करने वाळु हवणु चाहजे, ने वाळाक खरली वात हुनर सी सीकाड़ने वाळु हवणु चाहजे। <verse eid="1TI 3:2" /><verse number="3" style="v" sid="1TI 3:3" />नी पुडारी दारु पीणेवाळु ते नी लड़ाय करने वाळु नी हवणु बाकुन चु भुळु रहणु चाहजे, ने नी लड़ाय ने नी धनेन लालच्‌यु हवणु चाहजे। <verse eid="1TI 3:3" /><verse number="4" style="v" sid="1TI 3:4" />चु आपसान घरनाक अतरुत वारु अगवाय करन्‌यु, ने तेरा पुर्‌या-पारी जलम तेरु अबरु राखता हय, ने आखी वातेम तेरु हुकुम मानीन तेरा कब्‌जाम रहता हय। <verse eid="1TI 3:4" /><verse number="5" style="v" sid="1TI 3:5" />कदी तीनाक आपसा घरन्‌यान वारु अगवाय ने राखवाळी करता नी आवड़े, ती चु भगवानेन मंडळीन आखा माणसेन राखवाळी कसु करसे? <verse eid="1TI 3:5" /><verse number="6" style="v" sid="1TI 3:6" />पछेन ज की ईसु पर भुरसु करला नवला चेलाक, नी ते चु असु कय्‌न मटाय करने बाजी जासे की, मे मामार पुडारी बण गुयु; ने असु करीन चु भुतड़ान तसु मटाय करीन नीयावेन डंड हात कर लेसे। असो नी हवणु चाहजे। <verse eid="1TI 3:6" /><verse number="7" style="v" sid="1TI 3:7" />ने बाहार वाळा माणसे बी तेरी वाक नी-नीकाळनु चाहजे, असो नी हवे की भुतड़ु तीनाक तेरा गुनान फांदेम फांद लेसे।<verse eid="1TI 3:7" /></para>
  <para style="s">ईसुन मंडळीन खास नेवाड़ला चेला</para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 3:8" />असात पावर्‌या बी वीनगुनाळी जीवाय जीवीन नावसाद्‌या हवणु चाहजे। चे दारुड़्‌या नी हवणु चाहजे, ने काहने बी भात्‌ये हायाळ्‌ळा नी हवणु चाहजे। <verse eid="1TI 3:8" /><verse number="9" style="v" sid="1TI 3:9" />बाकुन भुरसु करीन सातायली वात काजे चु चुखा मन करीन राखणु। <verse eid="1TI 3:9" /><verse number="10" style="v" sid="1TI 3:10" />खास पावर्‌यु बणावणे सी पेहेल पारखीन देखणु चाहजे तत्‌यार कदी नी-गुनावाळा नीकळे ती पावर्‌यान काम करनु चाहजे। <verse eid="1TI 3:10" /><verse number="11" style="v" sid="1TI 3:11" />असात बायरा बी चुरी-चुगली करने वाळा नी हवणु चाहजे, बाकुन आखी वात सामळीन, ने वात मां भुरसु करे असा हवणु चाहजे। <verse eid="1TI 3:11" /><verse number="12" style="v" sid="1TI 3:12" />पावर्‌यु एकुत लाडी वाळु हवणु चाहजे ने आपसान पुर्‌या-पारीन ने आपसान आखा घरन्‌यान वारु रीते अगवाय करन्‌या ने राखवाळी करन्‌या हवणु चाहजे। <verse eid="1TI 3:12" /><verse number="13" style="v" sid="1TI 3:13" />काहाकी जु पावर्‌यान काम वारु रीते सी कर सके, चु तेरे वाटे वारलु नाव वाळा ने तीना भुरसा मां जु मसी ईसु पर जु तींद्‌रु भुरसु छे, तीना भुरसान बारामां दीसराक कह्‌णे मां बी तीनुक अळी जादा हिम्‌मत जड़ जासे।<verse eid="1TI 3:13" /></para>
  <para style="s">ईसु ने ईसुन मंडळीन सातायली वात</para>
  <para style="p">
    <verse number="14" style="v" sid="1TI 3:14" />मे तारे धड़े छाटुस आवणेन आस राख रयु। पर बी जी वात तुसेक तेरेमां लिखो की <verse eid="1TI 3:14" /><verse number="15" style="v" sid="1TI 3:15" />कदी मेसेक आवणे मां वार लाग जाय, ती तु जाण ले की भगवानेन घरना मां जु जीवतेलु भगवानेन मंडळी छे, ने चु छाचीन <note caller="+" style="f"><char style="fr" closed="false">3:15 </char><char style="ft" closed="false">सत्य कां खंबा</char></note>खुटु ने नेवु छे कसों वेहवार करनु चाहजे। <verse eid="1TI 3:15" /><verse number="16" style="v" sid="1TI 3:16" />तीनी छाचाय पर टेकीन आपणु भगवानेन भक्‌ती कर रया ची छाचाय पेहेल सातायली हतली बाकुन भगवान हय तीनी छाचाय काजे उजेंतु करलु छे हेरेम काय बी सक नी हय जी छाचाय बेसकी उंडी छे ने असी छे:</para>
  <para style="q1" vid="1TI 3:16">ईसु मसी डील मां उजेंतु हयु,</para>
  <para style="q2" vid="1TI 3:16">चुखली-आत्‌मा मां धरमी बण्‌यु,</para>
  <para style="q2" vid="1TI 3:16">चु सरग वाळा खबर लावण्‌या काजे देखाव पड़्‌यु।</para>
  <para style="q1" vid="1TI 3:16">आड़जात्‌या नी-यहुदी माणसे मां तेरु परचार हयु,</para>
  <para style="q2" vid="1TI 3:16">ईनी कळी मां माणसे तेरे पर भुरसु कर्‌या,</para>
  <para style="q2" vid="1TI 3:16">ने चु सेक-सींगार भेळु सरगे मां हाकलाय गुयु।<verse eid="1TI 3:16" /></para>
  <chapter eid="1TI 3" />
  <chapter number="4" style="c" sid="1TI 4" />
  <para style="s">लुच्‌चाय वात सीकाड़न्‌या सी चेतीन रवु</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 4:1" />बाकुन भगवानेन चुखली-आत्‌मा चुखी झण असी कह्‌वे की, आवणे वाळा थुड़ाक दाहड़ा मां लुच्‌चा माणसे, चे भुतड़ान जमेन वाये लागीन मंडळीन माणसेक ढंगड़ा करीन भुतड़ान जमेन भोंगलाड़नी वात सीकणे बाजी जासे, तीनु सीकाड़न्‌यान वात सामळीन थुड़ाक माणसे तींद्‌रे वाये लाग जासे, ने ईसु पर सी भुरसु छुड़ीन भटकी जासे। <verse eid="1TI 4:1" /><verse number="2" style="v" sid="1TI 4:2" />ज तीनु लुच्‌चा माणसेन घमंडीन वजे सी हवसे जसों चामड़ो तात्‌ले लुहड़े डामणे सी बेहरो फट हय जाय। <verse eid="1TI 4:2" /><verse number="3" style="v" sid="1TI 4:3" />चे ईयाव करने सी रुकसे ने खाणो-खाणेन थुड़ीक चीजे सी छेटा रवणेन हुकुम आपसे तीनुक भगवान हेरेसी बणावलु की भगवान पर भुरसु करन्‌या ने छाचाय काजे उळखणे वाळा हीनाक तु बेसकु वारु करीन कय्‌न खाणो खासे।<note caller="+" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="GEN 9:3">उबजाणनी किताप 9:3</ref></char></note> <verse eid="1TI 4:3" /><verse number="4" style="v" sid="1TI 4:4" />काहाकी भगवानेन बणावली आखी एकेक चीज वारु छे ने कुय चीज बेकार नी हय बाकुन ज की तु बेसकु वारु करीन कय्‌न खाणु चाहजे। <verse eid="1TI 4:4" /><verse number="5" style="v" sid="1TI 4:5" />काहाकी भगवानेन वायदु करला बुलेन अनसारे दुवा करने सी आखो काय चुखो हय जाय।<verse eid="1TI 4:5" /></para>
  <para style="s">ईसु मसीन वारलु पावर्‌यु</para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 4:6" />कदी तु भायस्‌यो ने बहणस्‌या काजे हीनी वातेन हेर कराड़तु रवजी, ती ईसु मसीन वारलु पावर्‌यु बणसी, ने भुरसु ने तीनी वारलु सीकाड़ली वात सी च तु मान्‌तु आय रयु तारी चुखली-आत्‌मा मां वारु पुसायतु आय रयु। <verse eid="1TI 4:6" /><verse number="7" style="v" sid="1TI 4:7" />बाकुन वीटेळ्‌ळा ने डाहली बायरीन आस दाखला सी छेटे रहु, ने भगवानेन भक्‌ती करनेन वात पर मन लागाड़्‌या कर। <verse eid="1TI 4:7" /><verse number="8" style="v" sid="1TI 4:8" />एक दाखलान साहरे मे तुसेक जी वात समजाड़ो, डीलेक मेहनत करीन सीकाड़ने सी थुड़ुक नफु जड़े। बाकुन भगवानेक गमे असी जीवाय जीवणे करीन आपसाक सीकाड़ने सीत आखे भात्‌ये नफु हवे। असो करने सी, धरती पर वाळी जीवाय मां बी, ने सरगेम आवणे वाळी अमरकायान जीवाय मां बी नफु जड़से। भगवान असुत वायदु करलु छे; अतरे भगवानेक गमे असी जीवाय जीवणे करीन आपसाक सीकाड़तु रव। <verse eid="1TI 4:8" /><verse number="9" style="v" sid="1TI 4:9" />जी वात संय छे, ने तुहुंं आखी भातीन वातेक मानीन जीवजु। <verse eid="1TI 4:9" /><verse number="10" style="v" sid="1TI 4:10" />काहाकी हामु मेहनत ने कुसीस हेरे वाटे करजे की हामरी आस हीना जीवतेला भगवान पर छे जु आखा माणसेन ने खास करीन भुरसु करन्‌यान छुटकारु छे।<verse eid="1TI 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 4:11" />तु ईनी आखी वातेन हुकुम आप ने सीकाड़तु रव। <verse eid="1TI 4:11" /><verse number="12" style="v" sid="1TI 4:12" />काहनाक तु जुवान्‌यु छे करीन तुसेक<note caller="+" style="f"><char style="fr" closed="false">4:12 </char><char style="ft" closed="false">तुच्छ</char></note> हेटु नी समजणु चाहजे। बाकुन बुल ने वेहवार ने परम, ने भुरसु ने चुखली जीवाय जीवणे मां बी दाखलु बण जां। <verse eid="1TI 4:12" /><verse number="13" style="v" sid="1TI 4:13" />जत्‌यार लग मे नी आवो; तत्‌यार लग नी माणसे काजे खरली सास्‌तुर भणीन सामळावतु रव, ने तेरेत अनसारे तीनुक समजाड़तु रव, ने सीकाड़तु रव। <verse eid="1TI 4:13" /><verse number="14" style="v" sid="1TI 4:14" />जत्‌यार मुख्‌या भेळा हय्‌न तारे पर हात मेकला ती जड़ला, भगवान सी दुवा करला, तीने टेमे भगवानेन अघी सी आवणे वाळी वात बताड़न्‌या माणुस, भगवान पुठ्‌ये हय्‌न तारे बारामां वात कह्‌लु; तीने टेमे भगवान जु खास वाटु तुसेक आपलु तीना वाटाक रीकामु घुण रहणी देय। <verse eid="1TI 4:14" /><verse number="15" style="v" sid="1TI 4:15" />हीनी वात काजे हेर करतु रव ने हेरेत मां तारो मन लागाड़तु रव, तत्‌यार ते तारी चुखली-आत्‌मा ताकत ने सेवान हर ने हुनर आखा अगळ उजेंती हय जासे। <verse eid="1TI 4:15" /><verse number="16" style="v" sid="1TI 4:16" />तु भगवानेन कह्‌याम जापताये जीवजी ने जापताये सीकाड़जी असुत कर्‌या करजी तत्‌यार ते तु बी छुटकारु हात करसी ने तारी सामळने वाळा बी छुटकारु हात करसे।<verse eid="1TI 4:16" /></para>
  <chapter eid="1TI 4" />
  <chapter number="5" style="c" sid="1TI 5" />
  <para style="s">भुरसु करने वाळा साते कसु वेहवार करनु चाहजे तेरी सीकापण</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 5:1" />काहना बी डाहला माणसे काजे लड़जी घुण, बाकुन तीनाक बास जाणीन समजाड़ देजी, ने जुवान काजे भायस जाणीन समजाड़ देजी। <verse eid="1TI 5:1" /><verse number="2" style="v" sid="1TI 5:2" />ने डाहली बायरा काजे आयस जाणीन समजाड़ देजी; ने जुवान बायरा काजे चुखला वीच्‌यार सी बहणीस जाणीन समजाड़ देजी।<verse eid="1TI 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 5:3" />छाचलीन रांडायला बायरान छे तींद्‌री ईज्‌जत करजु। <verse eid="1TI 5:3" /><verse number="4" style="v" sid="1TI 5:4" />कदी काहना रांडायला बायरान पुर्‌या-पारी नीते पुर्‌यान पुर्‌या हय ती चे पेहल आपसात घराणा मां रांडायलान सेवा चाकरी करीन आपसी भक्‌तीन उळखाण देणु चाहजे। काहाकी आपणा आस्‌या-बास्‌या नानला हतला ती चे परम सी आपणी सेवा चाकरी कर्‌या तीनी सेवा चाकरी काजे पछी वाळनु चाहजे, ती भगवान काजे बी गमे। <verse eid="1TI 5:4" /><verse number="5" style="v" sid="1TI 5:5" />तीनी रांडायली बायरीन कांखुर बी आसरु नी हय, ने भगवानेन आस करीन जीवे, ने रात-दाहड़ु भगवान धड़े लीलघाय ने दुवा करनेम झींग पड़ली रवे। <verse eid="1TI 5:5" /><verse number="6" style="v" sid="1TI 5:6" />बाकुन जी रांडायली बायर वार सुके जीवीन बेसकी मुजा करे ची जीवतेली हय्‌न बी मरला मुजुक छे। <verse eid="1TI 5:6" /><verse number="7" style="v" sid="1TI 5:7" />ईनी वातेन बी हुकुम आप्‌या कर की तेरेमां की चे दीसरान वाक नीकाळे। <verse eid="1TI 5:7" /><verse number="8" style="v" sid="1TI 5:8" />बाकुन कदी काहनुस आपसान भायस ने आपसान घरन्‌यान फीकुर करीन मदत नी करे, ती चु भुरसा मां सी छेटु हय गुयु ने चु भुरसु नी करे, तींद्‌रे सी बी जादा भुंडुत हय गुयलु छे।<verse eid="1TI 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TI 5:9" />तीनी रांडायली<note caller="+" style="f"><char style="fr" closed="false">5:9 </char><char style="fq" closed="false">रांडायली </char><char style="ft" closed="false">विधवा</char></note> बायरीन नाव लिखाय जासे ची सांठ साल सी कम साल वाळी नी रवे, ने एकुत लाडु करली हय। <verse eid="1TI 5:9" /><verse number="10" style="v" sid="1TI 5:10" />ने भलो काम मन लागाड़ीन करने मां बी, ने ची पुर्‌या-पारी काजे पाळी-पुसी हय, ने अनजाण्‌या माणसेन बी सेवा चाकरी करली हय, ने चुखला माणसे सी पाय धुवली हय, ने दुखी माणसेन मदत करली हय, ने असा भाती-भातीन काम मां मन लागाड़ी हय।<verse eid="1TI 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 5:11" />बाकुन जुवान रांडायला बायरान नाव घुण लिखे, काहाकी जत्‌यार चे ईसु मसीन कुहराय करीन आराम मां पड़ जाय ती ईयाव करने हींडे। <verse eid="1TI 5:11" /><verse number="12" style="v" sid="1TI 5:12" />ने असी करीन ची पेहली बुली काजे तुड़ीन गुनाळी हय जासे। <verse eid="1TI 5:12" /><verse number="13" style="v" sid="1TI 5:13" />ने असला जुवान रांडायला बायरा दीसरान घर जाय-जाय्‌न उजग्‌या टेवाय जासे ने उजग्‌या नी बाकुन कारा बी ने चीत वात कही-कहीन फालतु दीसरा काजे खुटी करसे। ने असा करीन चे आधला रुटा पर दाळ झेलन्‌या बण जासे। <verse eid="1TI 5:13" /><verse number="14" style="v" sid="1TI 5:14" />तेरेमां मे ज चाहो की जुवान रांडायला बायरा ईयाव करे ने पुर्‌या वाळा बणीन घर बार समाळे, ने काहनाक वीरुद करने वाळा माणसे काजे मुखु जड़से तीनुक असु मुखु नी जड़नु चाहजे। <verse eid="1TI 5:14" /><verse number="15" style="v" sid="1TI 5:15" />काहाकी थुड़ाक रांडायला बायरा असा करता जाय्‌न भगवानेन वात सी छेटे हय्‌न भुतड़ान वात मान्‌या बण गुयला छे। <verse eid="1TI 5:15" /><verse number="16" style="v" sid="1TI 5:16" />कदी काहना भुरसु करन्‌यान रांडायला बायरा हय ती चे तींद्‌रा घरन्‌या तीनी रांडायली बायरी काजे च चाहे आपणु चाहजे मंडळी पर जादा बुझ नी पड़े तेरेमां की चे तींद्‌री मदत कर सके चे छाचलीन रांडायला बायरा छे।<verse eid="1TI 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 5:17" />तु माणसेक असु सीकाड़जी जे पुडारी ईसुन नी माणसेक वारु अगवाय करन्‌या ने राखवाळी करन्‌या छे, तीनु पुडार्‌यान दुय गुणा ईज्‌जत करजी। <verse eid="1TI 5:17" /><verse number="18" style="v" sid="1TI 5:18" />काहाकी खरला सास्‌तुर मां बी लिखलो छे की, “अन मसणे करीन खळाम, जुपला बेलेन मुंहडे मसको मां बांदु,” काहाकी “दाहड़क्‌या काजे दाहड़कीन हक छे।”<note caller="+" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="LEV 19:13">लेवयवेवस्‌था 19:13</ref>; <ref loc="DEU 25:4">वेवस्‌थावीवरन 25:4</ref></char></note> <verse eid="1TI 5:18" /><verse number="19" style="v" sid="1TI 5:19" />कुय बी गुनावाळु, तारे अगळ नी काहना पुडारीन वाक नीकाळे ती, दुय-तीन गवान गवाय सामळे बीगुर वाक नीकाळन्‌यान घुण सामळे।<note caller="+" style="x"><char style="xo" closed="false">5:19 </char><char style="xt" closed="false"><ref loc="DEU 17:6">वेवस्‌थावीवरन 17:6</ref>; <ref loc="DEU 19:15">19:15</ref></char></note> <verse eid="1TI 5:19" /><verse number="20" style="v" sid="1TI 5:20" />असु करीन पाप करता रवे, तीनुक आखा माणसे अगळ लड़जी, ती दीसरा बी पाप नी करनु चाहजे करीन बीहसे।<verse eid="1TI 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1TI 5:21" />भगवान ने मसी ईसु ने अळी तेरा नेवाड़ला सरगदुत अगळ तीनुक हजुर जाणीन मे तुसेक चेताव, की मन लागाड़ीन ईनी वात काजे मान्‌या कर, ने काहनास काम काजे काट छाट मां करे। <verse eid="1TI 5:21" /><verse number="22" style="v" sid="1TI 5:22" />काहनाक वारु पंतारजी ने खरला नीकळे तीत तींद्‌रे पर हात मेलीन तींद्‌रे मुणके काम मेलजी। नीते तींद्‌रा पापेन साजल्‌या बणनेन गुनु तारे पर पड़से आखी हालत मां आपसा काजे चुखलु बणायन राख।<verse eid="1TI 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TI 5:23" />आवणे वाळा दाहड़ा मां पाणी अतरुत घुण पीये, बाकुन पछुत-पछुत मांदु हवणेन वजे सी तु ईतरु-ईतरुक अंगुरेन रस बी पीया करजी।<verse eid="1TI 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1TI 5:24" />थुड़ाक माणसेन पाप मां उजेंता हय जाय ने नीयाव करने वाटे पेहलुत जाती रवे, बाकुन थुड़ाक माणसे पछळ सी आवे। <verse eid="1TI 5:24" /><verse number="25" style="v" sid="1TI 5:25" />थुड़ाक माणसे दीसरान देखायता भला काम करे; अतरामा जी वात आखा अगळ उजेंती करे; तेबी तींद्‌रा भला काम जलम सातायला नी रवे; बाकुन एक दाहड़ु उजेंता हय जासे।<verse eid="1TI 5:25" /></para>
  <chapter eid="1TI 5" />
  <chapter number="6" style="c" sid="1TI 6" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 6:1" />ईसु पर भुरसु करन्‌या मायन जतरा बी माणसे, दीसरा माणसेन गुलाम बणीन रय र्‌या ने जुड़ान नेचा छे, तीनुक असु सीकाड़ जी की, तुहुंं आपणा-आपणा मालीकेन वारु ईज्‌जत करजु, नीते दीसरा माणसे ईसुन सीकाड़ली वात काजे काटणे बाजी जासे, ने भगवानेन नाव-बद्‌दी हवसे। <verse eid="1TI 6:1" /><verse number="2" style="v" sid="1TI 6:2" />तींद्‌रु मालीक भुरसु करने वाळु छे, तीनाक चे भाय हवणेन वजे सी नानलु नी जाणे ने तेरी अळी बी सेवा-चाकरी करनु, काहाकी हेरेसी फायदु लेणे वाळा भुरसा वाळा ने परमवाळा छे। हीनी वातेक सीकाड़तु ने समजाड़तु रवजी।<verse eid="1TI 6:2" /></para>
  <para style="s">लुच्‌चा मास्‌तर्‌या ने छाचलो धन</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 6:3" />थुड़ाक माणसे आपणी वात काजे नी मान्‌ता। बाकुन जतरी बी वात मे तुसेक सीकाड़ने करीन कय रयु, ची आखी वात आपणा मालीक ईसु मसीन वातेन अनसारे छे, ने माणसे मां खरली भक्‌तीन अनसारे पाक्‌की सीकापण छे। <verse eid="1TI 6:3" /><verse number="4" style="v" sid="1TI 6:4" />जु काहनुक जी पाक्‌की सीकापण छुड़ीन लुच्‌चाय वात सीकाड़े, ती चु मटाय करन्‌यु बण गुयु। तीनाक ते खरी भक्‌तीन बारामां काय बी मालुम नी हय; तेबी चु लड़ाय करने बाजी जाय, जां लग की फालतु वात मां लड़ाय पड़े। असो लड़ाय करने सी कुहराय ने बीरजु, ने नाव-बद्‌दी, ने भुंडी-भुंडी संक्‌या, <verse eid="1TI 6:4" /><verse number="5" style="v" sid="1TI 6:5" />ने तीनु माणसे मां फालतु झगड़ु उब्‌जे, तींद्‌री अक्‌कल बीगड़ी गुय, ने चे छाचाय सी छेटे हय गुया, ने चे ज समजे की ईसुन भक्‌ती करनु, पयस्‌या कमायणु वारलु धंदु छे।<verse eid="1TI 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 6:6" />अतरे आपणुक जी वीच्‌यार राखणु चाहजे की आपणे धड़े ज धन छे, तत्‌रात धनेम नीसरा रवीन ईसुन भक्‌ती करनुत खरली कमाय छे। <verse eid="1TI 6:6" /><verse number="7" style="v" sid="1TI 6:7" />आपणु ते ईनी कळी मां काय बी लीन नी आया, ने मरसु ती, ईनी कळीम सी काय बी नी ली जाजे।<note caller="+" style="x"><char style="xo" closed="false">6:7 </char><char style="xt" closed="false"><ref loc="JOB 1:21">अय्‌युब 1:21</ref>; <ref loc="PSA 49:17">भजन सहीता 49:17</ref></char></note> <verse eid="1TI 6:7" /><verse number="8" style="v" sid="1TI 6:8" />कदी आपणे धड़े खाणेन ने पेहरनेन पुथल्‌या हय, ती ईनी चीज मां नीसरा रवणु चाहजे। <verse eid="1TI 6:8" /><verse number="9" style="v" sid="1TI 6:9" />बाकुन जे मालदार हवणे चाहजे, चे भुतड़ान फांदेम ने भाती-भातीन पारख मां पड़ जाय ने चे असी बेसकी हाय करने बाजी जाय तीनी हाय सी फायदु नी हवे, बाकुन उल्‌टो नुकसाण हवे ज आखो तीनु माणसेक नड़से ने सार देसे; जसों दर्‌या मां पड़न्‌या माणसे काजे दर्‌यान भंवरु मुयड़ीन सार देय।<note caller="+" style="x"><char style="xo" closed="false">6:9 </char><char style="xt" closed="false"><ref loc="PRO 23:4">नीतीवचन 23:4</ref>; <ref loc="PRO 15:27">15:27</ref></char></note> <verse eid="1TI 6:9" /><verse number="10" style="v" sid="1TI 6:10" />काहाकी पयस्‌यान लालच आखी भातीन कुहराय्‌न जड़-मुळ छे, बेसका जणा धनेक हात करनेन हेर करता-करता ईसु पर वाळा भुरसाम सी भटकी गुया ने आपसात भाती-भातीन गरा मां पड़ गुया।<verse eid="1TI 6:10" /></para>
  <para style="s">हेर राखणे वाटे वात</para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 6:11" />बाकुन ए तीमुथीयुस, तु ते भगवानेन माणुस छे, तु ईनी वात सी छेटु रवजी; ने तु धरमेन वातेन, भुरसाम, ने गम खाणेन वातेन, भक्‌ती, ने परम, ने नरमायन हीनी आखी वातेक पाळतु रव। <verse eid="1TI 6:11" /><verse number="12" style="v" sid="1TI 6:12" />भुरसान वारलु लड़ाय लड़; ने तीनी अमर जीवाय काजे हात कर ले, तेरे वाटे तु बुलावलु छे ने बेसका माणसे अगळ गवा भरलु छे। <verse eid="1TI 6:12" /><verse number="13" style="v" sid="1TI 6:13" />आखा काजे जीवाय आपण्‌यु ते भगवान छे, ने आखा काजे जीवतु राखे, ने मसी ईसु गवा देदु चु पुंतीयुस पीलातुस अगळ आपसान छाचाय्‌न गवा देदु। तेरेमां भगवान अगळ ने ईसु मसी अगळ तुसेक जु हुकुम आपो की। <verse eid="1TI 6:13" /><verse number="14" style="v" sid="1TI 6:14" />की तु आपणा मालीक ईसु मसी काजे पछु उजेंतु आवता लग नी-गुनावाळा ने चुखलु रय्‌न हुकुम मान्‌तु रव। <verse eid="1TI 6:14" /><verse number="15" style="v" sid="1TI 6:15" />तीनाक चु संय टेम पर देखाड़से ने चु आखा सी वारु ने मटु छे, ने एकुत राज करन्‌यु छे, चु राजान राजा ने मालीकेन मालीक छे।<note caller="+" style="x"><char style="xo" closed="false">6:15 </char><char style="xt" closed="false"><ref loc="PSA 47:2">भजन सहीता 47:2</ref></char></note> <verse eid="1TI 6:15" /><verse number="16" style="v" sid="1TI 6:16" />ने चु अतरुत अमर छे, ने चु ईसु मसी जां कुय नी जाय सके तीना वीजाळा मां रवे अळी नी तीनाक कुय माणुस नी देख्‌यो। तीनात काजे जलम ईज्‌जत जड़ती रवसे ने तेरोत राज जलम रवसे। आमीन।<verse eid="1TI 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 6:17" />ईनी दुनीया मालदार काजे हुकुम आप की चे ईनी दुनीयान मामार सरन्‌या धनेन भुरसे मटाय नी करनु चाहजे बाकुन भगवानेन भुरसे जीवणु चाहजे, चु आपणुक खुसी मां सुकेन जीये जीवणे करीन ज चाहजे च आखो नीचळे मने आपतु रवे।<note caller="+" style="x"><char style="xo" closed="false">6:17 </char><char style="xt" closed="false"><ref loc="PSA 62:10">भजन सहीता 62:10</ref></char></note> <verse eid="1TI 6:17" /><verse number="18" style="v" sid="1TI 6:18" />चे भलाय करता रवणु चाहजे ने चे भला काम मां मालदार बणे ने दीसरान सात देणे मां तीयार रवणु चाहजे ने वारु मने धरम करन्‌या बन्‌नु चाहजे। <verse eid="1TI 6:18" /><verse number="19" style="v" sid="1TI 6:19" />ने चे असला भला काम मां मालदार बणसे ती भगवानेन नींगाम सरगेन धन भेळा करला मालदार गीणायसे एक दाहड़ु तीनुक बी तींद्‌री खरली जीवाय मां जलम जीवणे करीन सरगे जाणु छे, चां भगवान तींद्‌रे वाटे घर बांद रयु। भगवान तींद्‌रा हीनु भला कामेक तींद्‌रे वाटे घर बांदणे साय्‌न तसु गीणसे।<verse eid="1TI 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1TI 6:20" />ए तीमुथीयुस जी वात मे तुसेक कहलु छे, तीनी वातेक एक <note caller="+" style="f"><char style="fr" closed="false">6:20 </char><char style="ft" closed="false">धरोहर</char></note>खजानान तसु राखवाळी कर। तीनी अक्‌कल काजे अक्‌कल कवणु भुल छे, ची छाचलीन भक्‌तीन वीरुद करन्‌या, लुच्‌चाय सीकाड़न्‌या छे। अतरामा तीनी अकलेन वात लीन फालतुत वीरुद करने ने जखड़ी पड़ने तारेन चां काहनास बी आवे ती तींद्‌रे सी छेटु रव। <verse eid="1TI 6:20" /><verse number="21" style="v" sid="1TI 6:21" />छाचलीन तींद्‌री झुटी सीकापण मानीन थुड़ाक माणसे ईसु पर सी भुरसु छुड़ देदला छे।</para>
  <para style="p" vid="1TI 6:21">तुंद्‌रे पर भगवानेन गीण-दया हवती रवे।<verse eid="1TI 6:21" /></para>
  <chapter eid="1TI 6" />
</usx>