<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2JN" style="id">- Bhilali Standard Project</book>
  <para style="h">2 युहन्‌ना</para>
  <para style="toc3">2 युहन्‌ना</para>
  <para style="toc2">2 युहन्‌ना</para>
  <para style="toc1">युहन्‌नान दुसरी चिट्‌ठी</para>
  <para style="mt2">यूहन्ना की दूसरी पत्री</para>
  <para style="mt1">युहन्‌नान दुसरी चिट्‌ठी</para>
  <para style="imt">2 युहन्‌नान बारामां</para>
  <para style="ip">1 युहन्‌नान चिट्‌ठी नेवताळान काम युहन्‌नान साहरे मसीन पयदा हवणेन पचास सी सोव सालेन ईचमां लिखी गुयलो। युहन्‌नु खुद काजे लिखण्‌यान रुप मां नी उळखे, हेरे बजाय चु खुद काजे आखा सी मटु कह्‌वे। 2 युहन्‌नान बारामां युहन्‌नान अनसारे खुस-खबर मां जड़लाल बारामां घणो हेळे-मेळे। ज्‌य खास रुप सी हीनी तरा सी साप छे जीनी तरा सी चु एक दीसरा सी परम करने वाटे ईसुन हुकुम पर जुर देय ने जसु चु ईसु सी परम करनेन बराबरी हेरा हुकुमेन पाळन करनेन साते करे। <char style="xt"><ref loc="2JN 1:5-6">1:5-6</ref></char>, <char style="xt"><ref loc="JHN 15:9-10">युहन्‌ना 15:9-10</ref></char> असो मानी जाय की युहन्‌ना ईफीसुस मां रय्‌न युहन्‌ना ने तीन आक्‌सर मां 1 युहन्‌ना, 2 युहन्‌ना, 3 युहन्‌नान अनसारे खुस-खबर लिखलो हतलो।</para>
  <para style="ip">युहन्‌ना ईनी चिट्‌ठी काजे नेवाड़ली बायरी ने हेरा पुर्‌या काजे देखाड़े। चु काहा मायन मंडळीन वात कर रवलु। ईनी चिट्‌ठी काजे लिखणे मां युहन्‌नान मतलब मंडळी काजे हिम्‌मत बांदाड़्‌यु ने हीनुक झुठ सीकाड़न्‌या सी बचीन रवणु हतलो।</para>
  <para style="iot">बाहरती वात</para>
  <para style="io1">1. युहन्‌ना ज्‌य कय्‌न चिट्‌ठीन उळखाण देय की ज्‌य कुणी वाटे छे ने हेरे हात करन्‌यान आव-भाव करीन उळखाण देय। <char style="ior"><ref loc="2JN 1:1-3">1:1-3</ref> </char></para>
  <para style="io1">2. अळतेन चु मंडळी काजे हिम्‌मत बांदाड़्‌यु ने हीनुक आखा सी मटु हुकुम हेर कराड़्‌यु। <char style="ior"><ref loc="2JN 1:4-6">1:4-6</ref> </char></para>
  <para style="io1">3. हेरे पछेन चु हीनु झुठ सीकाड़न्‌यान बारामां चेतावणी देय। <char style="ior"><ref loc="2JN 1:7-11">1:7-11</ref> </char></para>
  <para style="io1">4. युहन्‌ना आपणी चिट्‌ठी काजे हीनी मंडळीन ईसु पर भुरसु करन्‌या सी जां चु रय रवलु, आव-भाव करीन पुरो कर्‌यु। <char style="ior"><ref loc="2JN 1:12-13">1:12-13</ref> </char></para>
  <chapter number="1" style="c" sid="2JN 1" />
  <para style="s">आव-भाव</para>
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1" />ओ ईसुन मंडळी, तुसे काजे भगवान नेवाड़लु छे। मे डाहा-बुड़ा, जी चिट्‌ठी तुसे काजे ने तारा माणसे काजे लिखो। मे तुंद्‌रे सी छाचला मन सी परम करो। <verse eid="2JN 1:1" /><verse number="2" style="v" sid="2JN 1:2" />भगवानेन जी छाचाय जलम हामरे साते रवसे, ने हय जी छाचाय हामरे साते रवसे:<verse eid="2JN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2JN 1:3" />आपणु, जे भगवानेन छाचाय्‌न अनसारे परम करीन, जीवणे बाजी रया, आपणु काजे भगवान बास अगु सी, ने भगवान बासेन पुर्‌यु ईसु मसी अगु सी, बेसकी वारु गीण-दया, ने सुक-सांती जड़ती रवसे।<verse eid="2JN 1:3" /></para>
  <para style="s">छाचाय ने परम</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4" />मे ज्‌य देखीन बेसकु खुस हयु की चां वाळा मंडळी मायन थुड़ाक माणसे बासेन हुकुमेन अनसारे, तेरी छाचाय पर चाल र्‌या। <verse eid="2JN 1:4" /><verse number="5" style="v" sid="2JN 1:5" />हय वो लाटेक्‌ली ईसुन मंडळी, मे तारे सी लीलघाय्‌न कह्‌वो, की मे तुसे काजे काय नवलु हुकुम नी पतु, बाकुन हयुत हुकुम आपो, जु आपणु काजे सुरु सी जड़लु छे, की तुहुंं एक दीसरा सी परम कर्‌या करजु। <verse eid="2JN 1:5" /><verse number="6" style="v" sid="2JN 1:6" />परमेन मतलब ज्‌य छे की आपणु भगवान काजे छाचलीन परम करजे। तेरेसी मे तुहुंं काजे अळी कहो तुहुंं आखा एक दीसरा सी परम करता जाय्‌न जीवजु। जु हुकुम तुहुंंक पेहल सी जड़लु छे।<verse eid="2JN 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7" />कळी मां असा बेसका माणसे भटकाड़ने वाळा छे, चे असा नी माने की ईसु मसी माणसेन पुर्‌यु बणीन आयु; भटकाड़णे वाळा ने मसीन वीरुद करन्‌या जेत छे। <verse eid="2JN 1:7" /><verse number="8" style="v" sid="2JN 1:8" />तुहुंं चेतीन रहु, नीते कांखुर मायन तुहुंं काठी मेहनतेन ईनाम खुय देसु, बाकुन मारी मरजी जी छे की तुहुंं पुरात-पुरा ईनाम हात करनु चाहजे।<verse eid="2JN 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2JN 1:9" />जु कुय बेसके छेटे जाती रवे ने मसीन सीकाड़नेन अनसारे नी जीवे, बाकुन सीकाड़ने सी छेटा हयन अगा जात रवे, तेरे साते भगवान नी रवे, बाकुन जु मसीन सीकाड़नेन अनसारे जीवे, तेरे साते भगवान बास ने तेरु पुर्‌यु ईसु, दुयु रवसे। <verse eid="2JN 1:9" /><verse number="10" style="v" sid="2JN 1:10" />कदी कुय तुंद्‌रे घर आवीन ईना सीकाड़ने काजे छुड़ीन दीसरी रीत सी सीकाड़े, ती तुहुंं, तीनाक ईसु पर भुरसु करन्‌यु समजीन आव-भाव घुण करु, ने तीनाक वारलु छे की? करीन बी घुण पुछु। <verse eid="2JN 1:10" /><verse number="11" style="v" sid="2JN 1:11" />काहाकी जु माणुस तीना काजे वारलु छे की? करीन पुछे, चु तेरा पाप मां बी साजल्‌यु हवे।<verse eid="2JN 1:11" /></para>
  <para style="s">आकरी कावा आवजी ने आवीस कहं</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12" />मेसेक तुंद्‌रे वाटे बेसको लिखणु छे, बाकुन मे जी वात कागदा पर सांय करीन नी लिखो। मे पाक्‌की आस करो की मे तुंद्‌रेन्‌चां आवीस ती उजेंतु वात करीस, तेरे सी आपणी खुसी पुरी हय जासे।<verse eid="2JN 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13" />ईसु पर भुरसु करने वाळी नेवाड़ली बहणीस तुहुंं काजे तुहुंं वारलु छे की? करीन पुछ रय ने आवीस ने आवजी कय र्‌या।<verse eid="2JN 1:13" /></para>
  <chapter eid="2JN 1" />
</usx>