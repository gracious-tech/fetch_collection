<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- Bhilali Standard Project</book>
  <para style="h">फीलेमोन</para>
  <para style="toc3">फीलेमोन</para>
  <para style="toc2">फीलेमोन</para>
  <para style="toc1">फीलेमोन वाटे पोलुसेन चिट्‌ठी</para>
  <para style="mt2">फिलेमोन के लिए पौलुस की पत्री</para>
  <para style="mt1">फीलेमोन वाटे पोलुसेन चिट्‌ठी</para>
  <para style="imt">फीलेमोन बारामां</para>
  <para style="ip">फीलोमेन नानली किताप नेवतावाळु पोलुस साहरे लिखलु। <char style="xt"><ref loc="PHM 1:1">1:1</ref></char> पोलुस जत्‌यार जेल मां हतलु तत्‌यार हीयु हीनी चिट्‌ठी काजे लिखलु तेरो मतलब छे की चु सायद रोम सी लिखलु हेरे सी चु रोम मां हतलु ती हीनी चिट्‌ठी काजे पयदा हवणेन धड़े-वड़े सांठ ने एक साल पछे लिखलु हसे तीनी टेम मां हीयु कुलुस्‌यो चिट्‌ठी काजे लिखलु हसे।</para>
  <para style="ip">हयु जी चिट्‌ठी फीलेमोन नावेन एक माणुस काजे लिखलु फीलेमोन मंडळीन एक मेहमर हतलु ने एक पावर्‌यान मालीक बी हतलु पोलुस हीनाक ज पुछणे वाटे लिखलु की चु आपणा पावर्‌या उनेसीमुस काजे डंड नी आपे जु फीलेमोन सी ढास गुयलु रोमेन नीयमेन अनसारे फीलेमोन उनेसीयुस काजे मुतेन घाट उतारनेन हकदार्‌यु हतलु। पोलुस फीलेमोन काजे एक भुरसु करने वाळा भायसेन रुप मां हुकारु भरने वाटे फीलोमन काजे बड़ावु देणे वाटे भुरसा मां चेतीन रवे काम मां लेय ने सीकापण देय की उनेमीयुस काजे पोलुस भेळु सेवा करनेन हुकुम आपे। <char style="xt"><ref loc="PHM 1:13-14">1:13-14</ref></char></para>
  <para style="iot">बाहरती वात</para>
  <para style="io1">1. पोलुस मां फीलेमोन आव-भाव करे। <char style="ior"><ref loc="PHM 1:1-3">1:1-3</ref> </char></para>
  <para style="io1">2. तत्‌यार पलु उनेसीमुस भीणी सी पुछे की फीलेमोन हीना एक भुरसु करने वाळा भायस रुप मां हुकारु भरे। <char style="ior"><ref loc="PHM 1:4-21">1:4-21</ref> </char></para>
  <para style="io1">3. पोलुस सेवा करनेन चाल पर जाणेन वीच्‌यार करीन सार देय ने वारु छे की करीन मकले। <char style="ior"><ref loc="PHM 1:22-25">1:22-25</ref></char></para>
  <chapter number="1" style="c" sid="PHM 1" />
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1" />पोलुस भीणी सी जु मसी ईसु मां जेल मां छे, ने भाय तीमुथीयुस भीणी सी,</para>
  <para style="p" vid="PHM 1:1">हामरु लाटेक्‌लु साती मदत करने वाळु फीलेमोन, <verse eid="PHM 1:1" /><verse number="2" style="v" sid="PHM 1:2" />ने बहणीस अपफीया, ने हामरु साती सीपायड़ा अरखीप्‌पुस ने फीलेमोनेन घरेन भेळी हवणे वाळी मंडळी काजे:<verse eid="PHM 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3" />आपणा भगवान बास ने मालीक ईसु मसी भीणी सी गीण-दया ने सुक-सांती आखा काजे जड़ती रहे।<verse eid="PHM 1:3" /></para>
  <para style="s">फीलेमोनेन परम ने भुरसु</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4" />मे जलम भगवान काजे वारु छे करीन कहं, ने मारी दुवा मां तुसे हेर करो। <verse eid="PHM 1:4" /><verse number="5" style="v" sid="PHM 1:5" />काहाकी मे तारा तीना परम ने भुरसान वात सामळीन, जु मालीक ईसु पर ने आखा चुखला माणसेन साते छे। <verse eid="PHM 1:5" /><verse number="6" style="v" sid="PHM 1:6" />मे दुवा करो की, भुरसा मां तारु हीस्‌सु लेणेन आखी मदतेन समज वाटे असर हवे, जे मसी मां हामरे धड़े छे। <verse eid="PHM 1:6" /><verse number="7" style="v" sid="PHM 1:7" />ए भायस, मेसे तारा परम सी बेसकी खुसी ने सुक-सांती जड़ी, काहाकी तारे सी चुखला माणसेन मन खुसी सी भर गुयला छे।<verse eid="PHM 1:7" /></para>
  <para style="s">पोलुस वाटे उनेसीमुसेन लीलघायणु</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8" />तेरेमां मसी मां मटीत हिम्‌मत छे, काहाकी जी वात वारु छे, ची हुकुम तुसे आपो। <verse eid="PHM 1:8" /><verse number="9" style="v" sid="PHM 1:9" />तेबी मे डाहलु पोलुस जु हय मसी ईसुन नाव सी जेल मां छे, ने ज अळी बी भलायन वात छे की परम सी लीलघाय करु। <verse eid="PHM 1:9" /><verse number="10" style="v" sid="PHM 1:10" />मे आपणु पुर्‌यु उनेसीमुस वाटे जु मारे सी मारी बांदण मां पयदा हवलु छे, तारे सी लीलघायो। <verse eid="PHM 1:10" /><verse number="11" style="v" sid="PHM 1:11" />हयु ते पेहले तारे काय कामकु नी हतलु, बाकुन हय तारे ने मारे दुयुन बेसकु कामकु छे।<verse eid="PHM 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PHM 1:12" />तीनात काजे मतलब जु मारा काळजांन कटकु छे, मे तीना काजे तारे धड़े मकली देदलु छे। <verse eid="PHM 1:12" /><verse number="13" style="v" sid="PHM 1:13" />तीनाक मे मारेत धड़े मेकणे हींडी रवलु, काहाकी तार भीणी सी ईना बांदण मां खुस-खबरेन वजे सी छे, ने मारी सेवा कर सके। <verse eid="PHM 1:13" /><verse number="14" style="v" sid="PHM 1:14" />बाकुन मे तारी मरजी पाखुर काय बी नी करने हींडतेलु की तारी जी दया जबरान मां नी बाकुन खुसी सी रहे।<verse eid="PHM 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHM 1:15" />काहाकी कुण जाण्‌यो की हयु तारे सी ईतराक दाहड़ा लगुन असु करीन छेटे हय गुयलु, जत्‌यार चु तारेन चां पछु आवे, ती जलम तारे पुठ्‌ये रवे। <verse eid="PHM 1:15" /><verse number="16" style="v" sid="PHM 1:16" />पावर्‌यान तसु नी हय, बाकुन पावर्‌या सी बी अदुस, मतलब भाय बराबर रहे, जु मारु खास लाटेक्‌लु साते ते छे, बाकुन हय डीलेम ने मालीक मां बी, तारु बी खास साती बणे।<verse eid="PHM 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17" />कदी तु मेसेक हीना काम मां तारु साजेल्‌यु समजे, ती मारु आव-भाव करे, तसुत हीना उनेसीमुसेन आव-भाव करीन हीना आवरी ले। <verse eid="PHM 1:17" /><verse number="18" style="v" sid="PHM 1:18" />ने कदी चु तारा वीरुद काय बी गुनु करलु हय, नीते चु तारु करजा वाळु हय ती चे पयस्‌या मां छुट जायस। <verse eid="PHM 1:18" /><verse number="19" style="v" sid="PHM 1:19" />मे पोलुस मारा हात सी लिखो, की मेत भर दीस, ने ईनाक कहणेन काय बी जरुड़ी नी हय, की मारु करजु जु तार पर छे चु तुत छे। <verse eid="PHM 1:19" /><verse number="20" style="v" sid="PHM 1:20" />ए भाय, जी खुसी मेसेक मालीक तार भीणी सी जड़े, मसी मां उनेसीमुसेन काजे माफी आपीन मारा जीवेक खुस कर देदु।<verse eid="PHM 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PHM 1:21" />मेसेक पाक्‌कु भुरसु छे की मे ज काय तुसेक कहलु, तेरे सी जादा तु हेरु आव-भाव करसी। <verse eid="PHM 1:21" /><verse number="22" style="v" sid="PHM 1:22" />ने ज बी, की मारे वाटे रुकणेन जागु तीयार राख, मेसे आस छे, की तुंद्‌री दुवा सी मेसे तुंद्‌रेन्‌चां आवाय जासे।<verse eid="PHM 1:22" /></para>
  <para style="s">आकरी वातेन बुले</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23" />ईपर्‌फास जु मसी ईसु मां मार भेळु जेल मां छे, तीना काजे बी वारु छे की करीन पुछी रयु, आवजी करीन कय रयु। <verse eid="PHM 1:23" /><verse number="24" style="v" sid="PHM 1:24" />ने मरकुस ने अरीस्‌तारकुस ने देमास ने लुकु जे मारा काम करने वाळा साती छे, हींद्‌रे भीणी सी बी तुसेक वारु छे की करीन कहें।<verse eid="PHM 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25" />तुहुंं आखा पर मालीक ईसु मसीन गीण-दया तुंद्‌री आत्‌मा साते बणीन रवे। आमीन।<verse eid="PHM 1:25" /></para>
  <chapter eid="PHM 1" />
</usx>