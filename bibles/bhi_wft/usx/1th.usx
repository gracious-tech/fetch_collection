<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1TH" style="id">- Bhilali Standard Project</book>
  <para style="h">1 थीसलुनीकी</para>
  <para style="toc3">1 थीसलुनीकी</para>
  <para style="toc2">1 थीसलुनीकी</para>
  <para style="toc1">थीसलुनीकी मंडळी वाटे पोलुसेन पेहली चिट्‌ठी</para>
  <para style="mt2">थिस्सलुनीकियों की कलिसीया के लिए पौलुस की पहली पत्री</para>
  <para style="mt1">थीसलुनीकीन मंडळी वाटे पोलुसेन पेहली चिट्‌ठी</para>
  <para style="imt">1 थीसलुनीकीन बारामां</para>
  <para style="ip">थीसलुनीकी काजे पेहली चिट्‌ठी नेवताळा पोलुस <char style="xt"><ref loc="1TH 1:1">1:1</ref></char> साहरे लिखी गुयलु। जी पेहली चिट्‌ठी हय सके ज्‌य पोलुस लिखलु ज्‌य बाइबीलेन हीस्‌सु बण गुयु ने ज्‌य ईसुन पयदा हवणेन लक-भग 51 साल पछे लिखी गुयलो। पोलुस कुरींथी मां हतलु जत्‌यार हीयु थीसलुनीकीन मंडळी काजे जी चिट्‌ठी लिख्‌यु, एक मंडळी तेरेमां हीयु आपणी दीसरी कावा सेवा करनेन चाल पर जागु बणावलु <char style="xt"><ref loc="ACT 17:1-10">नेवताळा 17:1-10</ref></char> नेवताळान कामेन किताप मां ज्‌य कवलो छे की मंडळी थुड़ाक यहुदी माणसे ने बेसका युनानी माणसे सी बन्‌नली हतली।</para>
  <para style="ip">मंडळीन जागु बणावणेन पछे बी पोलुस थीसलुनीकी मां रवणे मां ताकत वाळु नी हतलु हेरेसी हीयु पछे एनी चिट्‌ठी काजे चाहान भुरसु करन्‌या काजे हीम्‌मत राखणे करीन मकल्‌यु। चिट्‌ठी मां बेसका बारामां भेसकी मेल्‌यो ने ईसु पर भुरसु करन्‌या काजे कसो रवणु चाहजे हेरे बारामां जारा-जाराक समजाड़न्‌यु। पोलुस मसीन दीसरी कावा आवणे पर थुड़ाक हेर राखे कांखुर मायन थीसलुनीकीन मंडळीन भुरसु करन्‌या एना बारामां खास रुप सी मरजी राखे। पोलुस मसीन दीसरी कावा आवणे काजे भगवान काजे खुस करने वाळु जीवन जीवणेन काम मां लावणेन रुप मां काम मां लाय गुयो। <char style="xt"><ref loc="1TH 5:6-8">5:6-8</ref> </char></para>
  <para style="iot">बाहरती वात</para>
  <para style="io1">1. पोलुस एनी चिट्‌ठीन सुरुवात मंडळीन आव-भाव करने ने हींद्‌रे वाटे भगवान काजे भगवान काजे तु बेसकु वारु कह्‌वणेन साहरे करे। <char style="ior"><ref loc="1TH 1">1</ref></char></para>
  <para style="io1">2. अळतेन चु आपणा कामेन ने तीमुथीयुसेन साहरे लावला खबरेन बारामां बताड़े। <char style="ior"><ref loc="1TH 2-3">2—3</ref> </char></para>
  <para style="io1">3. अगलु पोलुस समजाड़े की कसा ईसु पर भुरसु करन्‌या काजे ईसुन दीसरी कावा आवणेन उजाळा मां रवणु चाहजे। <char style="ior"><ref loc="1TH 4:1-5:15">4:1—5:15</ref> </char></para>
  <para style="io1">4. पोलुस मंडळीन माणसे काजे पछु अळी आव-भाव करे ने हेरे पर भुरसु करने वाटे कह्‌यु की मंडळी मां एक-एक माणसे काजे चिट्‌ठी काजे भन्‌नु चाहजे। <char style="ior"><ref loc="1TH 5:16-28">5:16-28</ref></char></para>
  <chapter number="1" style="c" sid="1TH 1"/>
  <para style="p">
    <verse number="1" style="v" sid="1TH 1:1"/>पोलुस ने सीलवानुस तीमुथीयुस,</para>
  <para style="p" vid="1TH 1:1">भीणी सी थीसलुनीकीया सहर मां रहणे वाळी ईसुन मंडळीन माणसेक लिख रयु, तुहुं जे भगवान बास मां ने मालीक ईसु मसी मां भुरसु करीन रवे।</para>
  <para style="p" vid="1TH 1:1">तुहुं आखा काजे भगवानेन गीण-दया ने सुक-सांती तुंद्‌रे पुठ्‌ये रवे।<verse eid="1TH 1:1"/></para>
  <para style="s">थीसलुनीकी मंडळी वाळान भुरसु ने जीवन</para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2"/>हामु तुहुं आखा वाटे जलम भगवान काजे बेसकु वारु कवता रवजे। ने हामरी दुवा मां हामु तुंद्‌री हेर करता रवजे। <verse eid="1TH 1:2"/><verse number="3" style="v" sid="1TH 1:3"/>तुहुं ते भगवान बास पर भुरसु करीन वारलु काम कर र्‌या, ने परम सी काठो काम कर रया, ने आपणु मालीक ईसु मसी आपणुक वाचाड़ने करीन सरगे सी पछु आवसे करीन तुहुं आस कर रया, ने ईनी आसेन गम खाय्‌न वाट देख रया। ईनी वातेक आपणा भगवान बास अगळ अळी अळीन हेर करीन हामु तुंद्‌रे वाटे भगवान काजे बेसकु वारु कह्‌या करजे। <verse eid="1TH 1:3"/><verse number="4" style="v" sid="1TH 1:4"/>भगवानेन परमवाळा मारा भायस्‌यो ने बहणस्‌या हामु जाणजे की तुहुं तेरा नेवाड़ला छे। <verse eid="1TH 1:4"/><verse number="5" style="v" sid="1TH 1:5"/>काहाकी हामु जी खुस-खबर तुहुं काजे सामळावला, तीनी खुस-खबर मां बुले अतरात नी हतला, बाकुन हामरा बुल भेळा, भगवानेन चुखली-आत्‌मान ताकत बी उजेंती हवली। तुंद्‌रे वाटे, हामु तुंद्‌रे ईचमां कसा जीया, जी वात तुहुं देख लेदा; हामरे सी सामळावली खुस-खबर पर तुंद्‌रु पाक्‌कु भुरसु हय गुयु। <verse eid="1TH 1:5"/><verse number="6" style="v" sid="1TH 1:6"/>ने माणसे तुहुंक बेसका वेला पाड़्‌या; तेबी भगवानेन चुखली-आत्‌मा सी जड़ली खुसी भेळा, तुहुं हामरा ने मालीक ईसुन चाल धरन्‌या बण गुयला। <verse eid="1TH 1:6"/><verse number="7" style="v" sid="1TH 1:7"/>ने तेरेमां मकीदुनीया जीलाम ने अखाया जीलाम रहण्‌या, ईसुक मान्‌या आखा माणसेन चाल धरने करीन एक वारलु दाखलु बण गुया। <verse eid="1TH 1:7"/><verse number="8" style="v" sid="1TH 1:8"/>काहाकी तुंद्‌रेन्‌चां सी अतरात नी मकीदुनीया ने अखाया मां मालीकेन बुल सामळाया, बाकुन तुंद्‌रु भुरसु जु भगवान पर छे, ची वात आखे दुर जाती रय, की हामुक कहणेन जरुवत बी नी पड़ी। <verse eid="1TH 1:8"/><verse number="9" style="v" sid="1TH 1:9"/>काहाकी चे आफरतात हामरा बारामां बताड़े, की तुहुं कसा मुरती पुजा छुड़ीन भगवान भीणी फीर्‌या, काहाकी जीवला ने छाचला भगवानेन सेवा करे, <verse eid="1TH 1:9"/><verse number="10" style="v" sid="1TH 1:10"/>ने तेरा पुर्‌यान सरग सी आवणेन वाट देखता रहु तीनाक चु मर्‌या-सर्‌या मां सी जीवतु कर्‌यु, मतलब ईसु, जु हामुक आवणे वाळी गरा<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="fq" closed="false">गरा </char><char style="ft" closed="false">प्रकोप</char></note> सी बचाड़े।<verse eid="1TH 1:10"/></para>
  <chapter eid="1TH 1"/>
  <chapter number="2" style="c" sid="1TH 2"/>
  <para style="s">पोलुस थीसलुनीकाय मंडळीक, तींद्‌रा ईचमां हवला सेवान कामेन बारामां हेर कराड़े</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1"/>ए भायस्‌यो ने बहणस्‌या हामरो तुंद्‌रेन्‌चां आवणु फालतु नी हय, जी वात ते तुहुं काजे मालुम छे। <verse eid="1TH 2:1"/><verse number="2" style="v" sid="1TH 2:2"/>तुहुं जाणु की फीलीपी सहर मां ईसुन खुस-खबर सामळावणे गुयला, ती माणसे खुस-खबरेन बेसका वीरुद कर्‌या, ने हामुक बेसका वेला पाड़्‌या, तेबी हामु भगवानेन भुरसे, बीहे बीगुर तुंद्‌रेन्‌चां आया, ने तुहुं काजे ईसुन खुस-खबर सामळाया। जी वात बी तुहुं काजे मालुम छे। <verse eid="1TH 2:2"/><verse number="3" style="v" sid="1TH 2:3"/>काहाकी हिम्‌मत सी तुहुंक सीकाड़नु ने नी भरम सी छे ने नी वीटेळ्‌ळा सी छे, ने नी धुका सी छे। <verse eid="1TH 2:3"/><verse number="4" style="v" sid="1TH 2:4"/>बाकुन जसु भगवान हामुक कामका समजीन खुस-खबर सुपलु, हामु तसात बताड़जे; ने हामु माणसे काजे खुस करनेन कुसीस नी करजे बाकुन हामु ते तीना भगवान काजे खुस<note caller="+" style="f"><char style="fr" closed="false">2:4 </char><char style="fq" closed="false">खुस </char><char style="ft" closed="false">प्रसन्न</char></note> करजे चु हामरा मनेन वात काजे पारखे। <verse eid="1TH 2:4"/><verse number="5" style="v" sid="1TH 2:5"/>हामु तुंद्‌रे धड़े सी फायदु लेणे करीन, तुहुं बेसका वारु छे कय्‌न तुंद्‌रेन्‌चां कदी नी आया। ने हाय करीन हामु कदी ढंगड़ा नी कर्‌या। जी वात बी तुहुं जाण रया ने भगवान बी ईनी वातेन गवा छे। <verse eid="1TH 2:5"/><verse number="6" style="v" sid="1TH 2:6"/>हामु काजे माणसे भीणी सी ईज्‌जत नी चाहती, हव तुंद्‌रे भीणी सी बी, नी ने दीसरा भीणी सी बी ईज्‌जत नी चाहती।<verse eid="1TH 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1TH 2:7"/>हामु ते ईसु मसीन नेवताळा छे असा कय्‌न तुंद्‌रे पर हक जमाड़ सकजे; बाकुन तेबी हामु तुंद्‌रे साते असु दया कर्‌यु, जसी माय आपसा पुर्‌या काजे दुत पीयाड़ीन पाळे पुसे। <verse eid="1TH 2:7"/><verse number="8" style="v" sid="1TH 2:8"/>हामु तुंद्‌री बेसकी हेर करीन परम कर्‌या। तुहुं हामरे वाटे लाटेक्‌ला छे; तेरेमां हामु तुहुं काजे भगवानेन खुस-खबर सामळावणे अतरात नी, बाकुन हामरु जीव आपणे बी तीयार हय गुयला।<verse eid="1TH 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 2:9"/>ए भायस्‌यो ने बहणस्‌या, तुहुंक हामरी काठी मेहनत ने हरबड़ हेर हसे। तीनु दाहड़ाम, तुंद्‌रे पर बुजु नी आवणु चाहजे, करीन हामु रात-दाहड़ु मेहनत करीन कमाय बी कर्‌या, ने खरचु करीन तुहुं काजे भगवानेन खुस-खबर सामळाया।<verse eid="1TH 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1TH 2:10"/>तुहुं गवा छे, ने भगवान बी गवा छे, की तुहुं भुरसु करने वाळान ईचमां हामरु वेहवार कसु चुखलु ने धरमेन ने नी-गुनाळु <note caller="+" style="f"><char style="fr" closed="false">2:10 </char><char style="fq" closed="false">नी-गुनाळु </char><char style="ft" closed="false">निर्दोष</char></note>रयु। <verse eid="1TH 2:10"/><verse number="11" style="v" sid="1TH 2:11"/>जसु बास तेरा पुर्‌या साते वेहवार करे, तसात हामु बी तुंद्‌रे साते वेहवार करला। <verse eid="1TH 2:11"/><verse number="12" style="v" sid="1TH 2:12"/>जसात हामु तुहुंक भात-भात्‌ये समजाड़ीन सीकाड़ता रया; हामु कह्‌या भगवान तुहुंक हेरा राज मां, ने राजेन सेक-सींगार मां, साजल्‌या बणने करीन तुहुंक बुलावलु छे; तेरेमां तुहुं भगवानेक गमे तसों जीवन जीवु।<verse eid="1TH 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 2:13"/>ने तेरेमां हामु भगवानेक वारु छे करीन जलम कवता रवजे, काहाकी हामरे सी जत्‌यार तुहुं भगवानेन खरला बुले समजीन आवर्‌या ने छाचलीन हयु वचन भगवानेन छे, ने तुहुं जे भुरसु कर्‌या, तुंद्‌रा जे बुले बेसको काम करे। अतरामा ईनी वातेन करता हामु भगवान काजे बेसकु वारु कह्‌या करजे। <verse eid="1TH 2:13"/><verse number="14" style="v" sid="1TH 2:14"/>मेसेक यहुदीया जीलान, भगवानेन मंडळीन माणसे हेर आय रय। चे यहुदी माणसेम सी ईसु मसी पर भुरसु कर्‌या। तत्‌यार यहुदी दीसरा माणसे तीनुक वेला पाड़्‌या, तेबी चे ची वेला ने दुख वेठी लेदा। तींद्‌रेन तसात, जत्‌यार तुंद्‌रा माणसे तुहुंक वेला पाड़्‌या, तत्‌यार तुहुं बी ची वेला ने दुख वेठी लेदा। तेरेमां ए भायस्‌यो ने बहणस्‌या, तुहुं यहुदी ईसु वाळान चाल धरन्‌या बण गुयला छे। <verse eid="1TH 2:14"/><verse number="15" style="v" sid="1TH 2:15"/>चे मालीक ईसु काजे ने भगवानेन अघली वात बताड़ने वाळा माणसे काजे बी मार नाख्‌या ने हामुक तळ्‌या, ने भगवान तींद्‌रे सी खुस नी हय, ने चे आखा माणसे पर रुक लागाड़े, <verse eid="1TH 2:15"/><verse number="16" style="v" sid="1TH 2:16"/>ने चे नी-यहुदीया सी तींद्‌रा छुटकारा वाटे वाते करने सी हामुक रुके, काहाकी जलम आपणा पापेन गुळा<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="fq" closed="false">पापेन गुळा </char><char style="ft" closed="false">नपुआ</char></note> भरता रहे; बाकुन तीनु पर भगवानेन रीसेन गरा आय्‌त पड़ली छे।<verse eid="1TH 2:16"/></para>
  <para style="s">पोलुस मंडळी काजे भेळु हवणेन हर करे</para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17"/>ए भायस्‌यो ने बहणस्‌या हामु थुड़ीक वार लग तुंद्‌रे सी छेटे हय गुयला, मन मां छेटे नी हया, बाकुन डील मां छेटे हय गुयला। तेरेमां हामु तुंद्‌रा मुंहडा देखणे करीन बेसका हेर कर रवला। <verse eid="1TH 2:17"/><verse number="18" style="v" sid="1TH 2:18"/>तेरेमां हामु तुंद्‌रेन्‌चां पछा आवणे कर रवला, खास करीन मे पोलुस, एक कावा नी बाकुन दुयेक कावा आवणे करलु, बाकुन भुतड़ु रुक लेदलु। <verse eid="1TH 2:18"/><verse number="19" style="v" sid="1TH 2:19"/>आपणु मालीक ईसु पछु आवसे तीने टेमे, तेरे धड़े सी हामुक ईनाम जड़नेन आस, ने खुसी ने ईज्‌जत आपणी पागड़ी कुण रवसे? तीने टेमे, तेरे अगळ हामुक मटाय करनेन उत्‌तर तुहुंत बणसु; नी की? <verse eid="1TH 2:19"/><verse number="20" style="v" sid="1TH 2:20"/>हामरी बड़ाय ने खुसी तुहुंत छे।<verse eid="1TH 2:20"/></para>
  <chapter eid="1TH 2"/>
  <chapter number="3" style="c" sid="1TH 3"/>
  <para style="s">पोलुस तीमुथीयुस काजे थीसलुनीकी मंडळी मां खबर्‌यु मकले</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1"/>काहाकी जत्‌यार हामरे सी नी रह्‌वायो, ती हामु वीच्‌यार कर्‌या की एथेंस सहर मां रय जाजे, <verse eid="1TH 3:1"/><verse number="2" style="v" sid="1TH 3:2"/>ने हामु तीमुथीयुस काजे, जु मसीन खुस-खबर मां मदत करने वाळु हामरु भाय ने भगवानेन सेवक छे, असा करीन मकल्‌या की चु तुहुंक मजबुत करे ने तुंद्‌रो भुरसान बारामां तुहुंक समजाड़े, <verse eid="1TH 3:2"/><verse number="3" style="v" sid="1TH 3:3"/>काहाकी कुय दुख तकलीप वजे सी कमजुर नी हवे, काहाकी तुहुं आपसाक जाणु की हामु हींद्‌रेत वाटे नक्‌खी करलो छे। <verse eid="1TH 3:3"/><verse number="4" style="v" sid="1TH 3:4"/>काहाकी पेहलुत, जत्‌यार हामु तुंद्‌रेन्‌चां हतला ती तुहुंक कह्‌या करतेला की हामुक दुख तकलीप हाकलनु पड़से, ने असोत हवलो छे, जसा की तुहुं जाणु बी। <verse eid="1TH 3:4"/><verse number="5" style="v" sid="1TH 3:5"/>हेरे वजे सी जत्‌यार मारे सी नी रह्‌वायो, ती तुंद्‌रा भुरसान हाल जाणने करीन मकल्‌या, की कांखुर असो नी हय जाय की पारखणे वाळु तुंद्‌री पारख कर्‌यु, ने हामरी मेहनत फालतुत<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="fq" closed="false">फालतुत </char><char style="ft" closed="false">व्यर्थ</char></note> हय जाय।<verse eid="1TH 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 3:6"/>बाकुन हय्‌स ते तीमुथीयुस तुंद्‌रेन्‌चां सी पछु आवीन तुंद्‌रे बारामां हामुक असु सामळायु, थीसलुनीकी मंडळीन माणसे वारु ईसु पर भुरसु कर र्‌या, ने चे परमेन खुस-खबर सामळाया ने ईनी वातेक बी सामळाया की तुहुं जलम परम सी हेर करे। ने जसा आपणु तीनुक देखणेन हेर कर्‌या, तसात चे बे आपणु काजे देखणेन बेसका हेर करे। <verse eid="1TH 3:6"/><verse number="7" style="v" sid="1TH 3:7"/>तेरेसी ए भायस ने बहणस्‌या, हामु हामरा आखा दुख ने तकलीप मां तुंद्‌रा भुरसा सी तुंद्‌रे बारामां सांती जड़ी। <verse eid="1TH 3:7"/><verse number="8" style="v" sid="1TH 3:8"/>काहाकी हय कदी तुहुं मालीक मां काठा रहु ती हामु जीवला छे। <verse eid="1TH 3:8"/><verse number="9" style="v" sid="1TH 3:9"/>तुंद्‌रा बारामां सामळीन, तुंद्‌रे सी जी खुसी जड़ रय, तीनी खुसी सी हामु भगवान काजे कसा कहीन बेसकु वारु कवजे, जी वात हामुक समज मां नी आवती। <verse eid="1TH 3:9"/><verse number="10" style="v" sid="1TH 3:10"/>तुहुंक भेळा हवणे करीन ने तुंद्‌रा भुरसा सी सीकणे मां जी बी कसर छे, ची कसर पुरी करने करीन हामु रात दाहड़ु भगवान सी दुवा कर्‌या करजे।<verse eid="1TH 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 3:11"/>हामरी हेर असी छे, तुंद्‌रेन्‌चां आवणे करीन भगवान बास ने मालीक ईसु मसी, तुंद्‌रेन्‌चां आवणे करीन अगवाय करे! <verse eid="1TH 3:11"/><verse number="12" style="v" sid="1TH 3:12"/>ने मालीक असु करे की जसा हामु तुंद्‌रे सी परम कर्‌या तसात तुंद्‌रा परम बी तुंद्‌रे मां ने आखा माणसे साते अधे, ने बड़तो जाय, <verse eid="1TH 3:12"/><verse number="13" style="v" sid="1TH 3:13"/>काहाकी हयु तुंद्‌रा मन काजे काठो करे, काहाकी जत्‌यार हामरु मालीक ईसु आपसा आखा चुखला माणसे भेळु आवे, ती चे हामरा भगवान बास अगळ चुखला ने छाचला बणावे।<verse eid="1TH 3:13"/></para>
  <chapter eid="1TH 3"/>
  <chapter number="4" style="c" sid="1TH 4"/>
  <para style="s">चुखा हवणेन बुलावु</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1"/>ए भायस्‌यो ने बहणस्‌या, भगवानेन मरजीन अनसारे कसों जीवणु छे, ने तीनाक कसों खुस करनु छे; ईनी वातेन सीकणु तुहुं हामरे धड़े सी सीक लेदा, ने ईनी सीकणेन अनसारे तुहुं जीवता आय रया। हय हामु मालीक ईसुन नावे तुंद्‌रे धड़े लीलघाय करीन तुहुंक ज समजाड़जे, भगवानेक खुस करता जाय्‌न जीवणे मां तुहुं अगा बड़ता जावु। <verse eid="1TH 4:1"/><verse number="2" style="v" sid="1TH 4:2"/>काहाकी तुहुं जाणु की हामु मालीक ईसु भीणी सी तुहुंक काहनी-काहनी हुकुम बताड़्‌या। <verse eid="1TH 4:2"/><verse number="3" style="v" sid="1TH 4:3"/>तुहुं चुखला रहणु चाहजे; जीत भगवानेन मरजी छे; मतलब छीनाळा सी छेटे रहु। <verse eid="1TH 4:3"/><verse number="4" style="v" sid="1TH 4:4"/>ने तुंद्‌रे मां सी हर एक जणु चुखलु ने ईज्‌जत करीन आपणी लाडी साते रहणे जाणे। <verse eid="1TH 4:4"/><verse number="5" style="v" sid="1TH 4:5"/>छीनाळाय ने चंगली हेर सी छेटे रवजु। भगवान काजे नी जाणे, असला नी-यहुदीया माणसेत असी हेर करे। <verse eid="1TH 4:5"/><verse number="6" style="v" sid="1TH 4:6"/>की हीनी वात मां कुय बी आपसान भाय काजे नी ठगे ने अळी नी तेरे पर दावु लागाड़े, काहाकी मालीक असली आखी वातेन हीसाब लेण्‌यु छे। जी वात हामु पेहेल बी कहीन तुहुं काजे चेतावला। <verse eid="1TH 4:6"/><verse number="7" style="v" sid="1TH 4:7"/>काहाकी भगवान आपणु काजे वीटाळने करीन नी बुलायु, बाकुन तेरी नींगाम चुखला रहणे करीन बुलावलु छे। <verse eid="1TH 4:7"/><verse number="8" style="v" sid="1TH 4:8"/>हेरे वजे सी जु कुय हीनाक नानु जाणे तीना माणुस काजे नी बाकुन भगवान काजे नानु जाणे चु तेरी चुखली-आत्‌मा तुसेक आपे।<verse eid="1TH 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 4:9"/>मंडळीन भाय-बहणस्‌यान परमेन बारामां तुहुं काजे लिखणु जरुड़ी नी हय, काहाकी तुहुं काजे आंबा-सांबा परम करनेन वात भगवान सी सीकला छे। <verse eid="1TH 4:9"/><verse number="10" style="v" sid="1TH 4:10"/>ने आखा मकीदुनीया जीलान आखा मंडळीन आखा भाय-बहण्‌स्‌या काजे परम कर रया। तेबी अतरोत घुण कहुं। ए भायस्‌यो ने बहणस्‌या, हामु तुहुं काजे समजाड़जे की तुहुं आंबा-सांबा बी जादा परम करता जावु। <verse eid="1TH 4:10"/><verse number="11" style="v" sid="1TH 4:11"/>ने जसा हामु तुहुं काजे पेहेल हुकुम आपीन कहला तसात हय बी कवजे की दीसरान काम-धंदा मां अड़चन मां नाखु। आपसोत काम करता रवु, ने खुदेन हातेन कमाय सी खावु। <verse eid="1TH 4:11"/><verse number="12" style="v" sid="1TH 4:12"/>तत्‌यार तुहुंक कसरायला माणसेन तसा दीसरान भुरसे रहणु नी पड़े, ने मंडळीन बाहरना माणसे बी तुंद्‌री जीवाय देखीन तुहुंक वारु कवसे।<verse eid="1TH 4:12"/></para>
  <para style="s">मालीकेन पछु आवणेन</para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13"/>ए भायस ने बहणस्‌या, हामु नी चाहता की तुहुं तींद्‌रा बारामां जे सुय गुयला चे तींद्‌रा बारामां अंजाण्‌या<note caller="+" style="f"><char style="fr" closed="false">4:13 </char><char style="fq" closed="false">अंजाण्‌या </char><char style="ft" closed="false">अज्ञानी</char></note> रहु, असो नी हवे की तुहुं दीसरान तसा रड़ु ने कलप्‌या करु, तीनुक काय बी आस नी रवे। <verse eid="1TH 4:13"/><verse number="14" style="v" sid="1TH 4:14"/>कदी हामु भुरसु करजे की ईसु मर गुयलु, ने पछु जीवतु बी हय गुयु अतरामा जे ईसु पर भुरसु करीन मर गुया, भगवान तीनुक बी पछा जीवता करीन ईसु पुठ्‌ये ली जासे।<verse eid="1TH 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1TH 4:15"/>काहाकी हामु मालीकेन बुलेन अनसारे ज कह्‌जे जत्‌यार ईसु कळीम पछु आवसे, तत्‌यार ईसु पर भुरसु करन्‌या मरला भाय-बहणस्‌या जीवता हय्‌न ईसुक भेटणे पेहेल जासे। अळतेन आपणु जे जीवतेला छे, ने ईसुक आवता लग जीवतेला रवसु, तींद्‌रे पछळ ईसुक भेळा हवणे जासु। <verse eid="1TH 4:15"/><verse number="16" style="v" sid="1TH 4:16"/>काहाकी तीने दाहड़े, पेहेल मालीक ईसु खुद सरगे सी उतेरतु जाय्‌न कुर्‌रु दीन बुलावसे। तीने टेमे एक मटला सरग वाळा खबर लावण्‌यान अवाज सामळायसे। एक सरग वाळु खबर लावण्‌यु, भगवान अगे सी फेप्‌या वाजाड़से। तत्‌यार जे ईसु मसी पर भुरसु करता जाय्‌न मर गुया, चे पछा जीवता हवसे। <verse eid="1TH 4:16"/><verse number="17" style="v" sid="1TH 4:17"/>तत्‌यार आपणु बी जे जीवतेला रवसु, ने बचला रवसु, ईसुक भेळा हवणे करीन वादळा मां हाकलायन जासु। ईसुक मान्‌या आपणु आखा, सरगेम ईसु साते भेळा हवसु, ने असा करीन चां आपणु जलम मालीक ईसु पुठ्‌ये रवसुन। <verse eid="1TH 4:17"/><verse number="18" style="v" sid="1TH 4:18"/>हेरे वजे सी तुहुं जी वात कहीन एक दीसरा काजे हिम्‌मत आप्‌या करु।<verse eid="1TH 4:18"/></para>
  <chapter eid="1TH 4"/>
  <chapter number="5" style="c" sid="1TH 5"/>
  <para style="s">ईसु पछु आवसे, तीने टेमे भेळा हवणे तीयार रवु</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1"/>ए भायस्‌यो ने बहणस्‌या, हेरे बारामां लिखणेन जरुवत नी हय की टेमेन ने दाहड़ान बारामां तुंद्‌रे वाटे काहींग लिखजे। <verse eid="1TH 5:1"/><verse number="2" style="v" sid="1TH 5:2"/>काहाकी तुहुं आपसा वारु जाणु की जसु राते चुट्‌टु आवे, तसुत मालीकेन दाहड़ु बी आवणे वाळु छे। <verse eid="1TH 5:2"/><verse number="3" style="v" sid="1TH 5:3"/>जत्‌यार माणसे कवता हसे, “सांती मां छे <note caller="+" style="f"><char style="fr" closed="false">5:3 </char><char style="fq" closed="false">सांती मां छे </char><char style="ft" closed="false">कुशल</char></note>ने काय डर नी हय,” ती तींद्‌रे पर उचकाणुन नास हवणेन दुख आय पड़से, जसों भार पाये बायर पर पीड़ा दुख ने चे काहनी बी रीती सी नी बचे। <verse eid="1TH 5:3"/><verse number="4" style="v" sid="1TH 5:4"/>बाकुन ए भायस ने बहणस्‌या, तुहुं आंदारला मां नी हय, की चु दाहड़ु तुंद्‌रे पर चुट्‌टान तसु आय पड़े। <verse eid="1TH 5:4"/><verse number="5" style="v" sid="1TH 5:5"/>काहाकी तुहुं आखा वीजाळान अवल्‌यात ने दाहड़ान अवल्‌यात छे, हामु नीते रातेन छे, ने नी आंदारलान छे। <verse eid="1TH 5:5"/><verse number="6" style="v" sid="1TH 5:6"/>तेरेमां हामु दीसरान तसा सुवता नी रवजे, पर जागता ने समळीन रवजे। <verse eid="1TH 5:6"/><verse number="7" style="v" sid="1TH 5:7"/>काहाकी जे सुवे चे रातेत सुवे, ने जे दारु पीन छाके चे रात मात छाके। <verse eid="1TH 5:7"/><verse number="8" style="v" sid="1TH 5:8"/>आपणु ते दीसुन छे, तेरेमां भुरसान ने परमेन झीलम पेहरीन, ने छुटकारु हात करनेन आस काजे टुपान तसा पेहरीन, समळीन रहणु चाहजे। <verse eid="1TH 5:8"/><verse number="9" style="v" sid="1TH 5:9"/>काहाकी भगवान आपणु काजे डंड आपणे करीन नी नेवाड़्‌यु, बाकुन आपणा मालीक ईसु मसीन पापेन डंडेम सी छुटकारु जड़े करीन नेवाड़लु छे। <verse eid="1TH 5:9"/><verse number="10" style="v" sid="1TH 5:10"/>ईसु हामरे वाटे हेरे वजे सी मर्‌यु की हामु चाहे जागता रवजे चाहे सुवता रवजे, आखा मेळीन तेरेत साते जीवजे। <verse eid="1TH 5:10"/><verse number="11" style="v" sid="1TH 5:11"/>तेरेमां तुहुं एक दीसरान हिम्‌मत बड़ावता रहु, ने एक दीसराक चुखली-आत्‌मा मां टणका करता रहु, जसा तुहुं करता आय रया।<verse eid="1TH 5:11"/></para>
  <para style="s">चिट्‌ठीन पेहली सीकणो</para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12"/>ए भायस्‌यो, हामु तुहुं काजे लीलघाय्‌न कय र्‌या की, जे तुंद्‌रे वाटे काठी मेहनत करने बाजी रया, ने मालीक ईसु मां तुंद्‌री अगवाय करे, ने जे तुहुं काजे सीकाड़े, तींद्‌री सामळीन तींद्‌री ईज्‌जत करु। <verse eid="1TH 5:12"/><verse number="13" style="v" sid="1TH 5:13"/>ने तींद्‌रा काम वाटे, तुहुं परम सी तींद्‌रु वारु आव-भाव करु; ने हेळी-मेळीन<note caller="+" style="f"><char style="fr" closed="false">5:13 </char><char style="fq" closed="false">हेळी-मेळीन </char><char style="ft" closed="false">मेलमिलाप</char></note> रहु।<verse eid="1TH 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1TH 5:14"/>ए भायस्‌यो, हामु तुंद्‌रे सी जी लीलघाय कवजे की गलत चाल रया, तीनु काजे तुहुं लड़ीन समजाड़ु, ने बीहेतेला काजे हिम्‌मत आपु, ने लुल्‌ला काजे संभाळु, ने आखान वेहवार काजे वेठता जाय्‌न गम खावु। <verse eid="1TH 5:14"/><verse number="15" style="v" sid="1TH 5:15"/>चेतीन रहु! कुय करु दीसरान कुहराय्‌न बदले कुहराय मां करु; बाकुन तुहुं जलम एक दीसरान ने मंडळीन बाहरनान बी भलो कर्‌या करजु।<verse eid="1TH 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1TH 5:16"/>जलम खुस रवजु। <verse eid="1TH 5:16"/><verse number="17" style="v" sid="1TH 5:17"/>भगवान धड़े अळी-अळीन दुवा कर्‌या करजु, <verse eid="1TH 5:17"/><verse number="18" style="v" sid="1TH 5:18"/>हर वात मां, भगवान काजे बेसकु वारु कवता रहु। काहाकी ईसु मसी मां तुंद्‌रे धड़े भगवानेन बी जीत मरजी छे।<verse eid="1TH 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1TH 5:19"/>भगवानेन चुखली-आत्‌मान अगवाय काजे घुण रुकता। <verse eid="1TH 5:19"/><verse number="20" style="v" sid="1TH 5:20"/>खास करीन, भगवानेन अघी सी आवणे वाळी वात बताड़न्‌या माणसे वाटे कहली वातेक फालतु घुण समजु। <verse eid="1TH 5:20"/><verse number="21" style="v" sid="1TH 5:21"/>आखी वात काजे पारखीन देखणु चाहजे: जी वारु छे, तीनी वातेक मानीन जीवु। <verse eid="1TH 5:21"/><verse number="22" style="v" sid="1TH 5:22"/>आखी भातीन नाव-बद्‌दी सी छेटा रहु।<verse eid="1TH 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23"/>सांतीन भगवान आपसुत तुहुंक पुरी रीती सी चुखु करे, ने तुंद्‌री जीव-आत्‌मा ने मन ने डील हामरा मालीक ईसु मसीन आवणे लग पुरु-पुरु ने नी-गुनाळा बणीन रवे। <verse eid="1TH 5:23"/><verse number="24" style="v" sid="1TH 5:24"/>तुंद्‌रु बुलावणे वाळु खरलु छे, ने चु असुत करसे।<verse eid="1TH 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1TH 5:25"/>ए भायस्‌यो, हामरे वाटे दुवा करु।<verse eid="1TH 5:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1TH 5:26"/>आखा भायस ने बहणस्‌या काजे ईसुन चुखलु गुळु दीन वारला छे की पुछ्‌जु।<verse eid="1TH 5:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1TH 5:27"/>मे मालीक ईसुन हक सी तुहुं काजे कह्‌वो, जी चिट्‌ठी आखा भायस्‌यो काजे भणीन सामळावजु।<verse eid="1TH 5:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1TH 5:28"/>आपणा मालीक ईसु मसीन गीण-दया तुंद्‌रे पुठ्‌ये बणीन रहे।<verse eid="1TH 5:28"/></para>
  <chapter eid="1TH 5"/>
</usx>
