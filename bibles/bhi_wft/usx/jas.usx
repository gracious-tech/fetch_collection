<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JAS" style="id">- Bhilali Standard Project</book>
  <para style="h">याकुब</para>
  <para style="toc3">याकुब</para>
  <para style="toc2">याकुब</para>
  <para style="toc1">याकुबेन चिट्‌ठी</para>
  <para style="mt2">याकूब की पत्री</para>
  <para style="mt1">याकुबेन चिट्‌ठी</para>
  <para style="imt">याकुबेन बारामां</para>
  <para style="ip">याकुबेन किताप काजे याकुब नावेन एक माणुस लिखलु छे। हय सके जुत ईसुन भाय हतलु, जु सुरवातीन मंडळी मां एक अगळवाण्‌यु हतलु ने यरुसलेमेन मट्‌ली गड़दीन हीस्‌सु हतलु। <char style="xt"><ref loc="ACT 15:13">नेवताळान काम 15:13</ref></char> नेवताळु पोलुस तीनाक <char style="xt"><ref loc="GAL 2:9">गलातीयो 2:9</ref></char> मां मंडळीन खास खांबु बी कह्‌यु। नीयम काजे जान्‌ने वाळान मान्‌नु छे की याकुबेन किताप ईसु मसीन पयदावारीन 50 सेक साल बात लिखायली। काहाकी याकुब यरुसलेमेन मंडळीन अगळवाण्‌यु हतलु, हय सके चां रय्‌न हयु ईनी किताप काजे लिखलु।</para>
  <para style="ip">याकुब आपसान किताप मां नी-यहुदी वाळा माणसे फेलायला बारे कुळ्‌या माणसेन <char style="xt"><ref loc="JAS 1:1">1:1</ref></char> बारामां बताड़े। याकुबेन सीकापण आखा मसी माणसे पर लागु हवे, बाकुन बारे कुल्‌यान बारामां बुले लिखला सी असो छाचलीन मालम पड़े की याकुब सुदु यहुदी माणसे काजे लिख रवलु। काहाकी जी किताप बन्‌ने वाळान एक बेसका टुळा लग जाय करीन लिखलु, हयु बेसकी वातेन बारामां बताड़्‌यु। याकुब भुरसा ने कामेन काजे साते लीन चालनेन बारामां अदु जुर देय। छाचलु भुरसु कामे सी देखाव पड़से। <char style="xt"><ref loc="JAS 2:17">2:17</ref></char> हयु लकपती माणसेन <char style="xt"><ref loc="JAS 2:1-4">2:1-4</ref></char> बारामां नानला मटान भेदभाव तीनुक वारु नी कहें ने हामुक बताड़े की जो आपणु करजे तेर बारामां चेतीन रहणे कहें। <char style="xt"><ref loc="JAS 3:1-12">3:1-12</ref> </char></para>
  <para style="iot">बाहरती वात</para>
  <para style="io1">1. याकुब मां आपसा भन्‌ने वाळाक वारु छे की करीन पुछे। <char style="ior"><ref loc="JAS 1:1">1:1</ref></char></para>
  <para style="io1">2. तेर बात हयु मसी वाळा काजे हवस देय की जत्‌यार तुहुंं दुख झेलु ती काठा रहे। <char style="ior"><ref loc="JAS 1:2-27">1:2-27</ref></char></para>
  <para style="io1">3. अळतेन हयु कहें की कामे सी भुरसु देखायणु जरुड़ी छे। <char style="ior"><ref loc="JAS 2:1-26">2:1-26</ref></char></para>
  <para style="io1">4. तेर बात हयु कहें की मुंहडा सी नीकळने वाळा बुले कतरा ताकतवाळा हय सके। <char style="ior"><ref loc="JAS 3:1-12">3:1-12</ref> </char></para>
  <para style="io1">5. तत्‌यार याकुब समजाड़े की कसी भगवानेन अक्‌कल माणसेन अक्‌कल सी अलग छे। <char style="ior"><ref loc="JAS 3:13-4:10">3:13—4:10</ref></char></para>
  <para style="io1">6. तेर बात हयु आपसा भन्‌ने वाळा काजे घमट वाळा वळु नी हवणु करीन कहें। <char style="ior"><ref loc="JAS 4:11-5:6">4:11—5:6</ref> </char></para>
  <para style="io1">7. याकुब ईतरीक वातेन बारामां कय्‌न किताप काजे लिखणु बंद करे। <char style="ior"><ref loc="JAS 5:7-20">5:7-20</ref></char></para>
  <chapter number="1" style="c" sid="JAS 1" />
  <para style="s">आव-भाव</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1" />भगवान ने मालीक ईसु मसीन पावर्‌यु याकुब भीणी सी तीनु बारे चेला काजे जी रावण्‌या-तीवण्‌या हय्‌न रवे:</para>
  <para style="p" vid="JAS 1:1">तीनु काजे वारु छे की कह्‌वे।<verse eid="JAS 1:1" /></para>
  <para style="s">भुरसु ने अक्‌कल</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2" />ए मारा भायस्‌यो ने बहणस्‌या, ईसु पर भुरसु करनेन साहरे, तुंद्‌रे, पर कदी भाती-भातीन वेला ने पारख आया करे; तत्‌यार ईनी वात काजे तुहुंं खुसीन वात समजु। <verse eid="JAS 1:2" /><verse number="3" style="v" sid="JAS 1:3" />काहाकी तुहुंं जाणु की तुंद्‌रु भुरसु जत्‌यार ईनी पारख मां जीत जाय, तीत हामु काजे गम खाणेन ताकत जड़े। <verse eid="JAS 1:3" /><verse number="4" style="v" sid="JAS 1:4" />असा करीन तुहुंं गम खाणेन ताकत काजे तुंद्‌री जीवाय मां पुरो-पुरो वदणे देवु; तेरेसी तुहुंं भुरसा मां पुरा-पुरा पाक्‌का हय जावु, ने तुंद्‌री जीवाय मां काहनी बी वारलु वातेन कसर नी रवणु चाहजे। <verse eid="JAS 1:4" /><verse number="5" style="v" sid="JAS 1:5" />कदी तुंद्‌रे मायन काहनाक धड़े, भगवानेन मरजीन अनसारे जीवणे करीन कम अक्‌कल हय, ती भगवान धड़े दुवा करीन अक्‌कल मांगु। भगवान ते आखा काजे मटले मने आपण्‌यु छे; आपणु मांग्‌या करीन चु आपणुक नी लड़े। चु तुहुंंक अक्‌कल आपसे ने आपसे। <verse eid="JAS 1:5" /><verse number="6" style="v" sid="JAS 1:6" />बाकुन तुहुंं संक्‌या करे पाखुर भुरसु करीन अक्‌कल मांगजु, काहाकी संक्‌या करतु जाय्‌न वीन्‌ती करन्‌यु ते दर्‌याम आवणी झलकेन तसु छे, जी वाहळाम अथीन-अथी उछळ्‌या करे। <verse eid="JAS 1:6" /><verse number="7" style="v" sid="JAS 1:7" />असो माणसे काजे कदी बी जी आस नी करनु चाहजे की, भगवान मालीक भीणी सी मेसेक काहींग जड़से। <verse eid="JAS 1:7" /><verse number="8" style="v" sid="JAS 1:8" />भगवान पर संक्‌या करन्‌यु माणुस ते दुय मन वाळु रवे, ने आपसान जीवाय मां आखी वातेम टेक्‌लु नी रवे।<verse eid="JAS 1:8" /></para>
  <para style="s">पयस्‌या वाळु ने गरीब</para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9" />जत्‌यार भगवान तीना भाय ने बहणस्‌या गरीबी मां सी उपर उठाड़े ती हीनुक खुसी हवणु चाहजे। <verse eid="JAS 1:9" /><verse number="10" style="v" sid="JAS 1:10" />ने भगवान तीना काहालाक भाय ने बहणस्‌या काजे लकपती मां सी गरीबी मां लावे जत्‌यार बी हीनाक खुसी हवणु चाहजे काहाकी लकपती जंगली चारान फुलेन तसों सरी जासे। <verse eid="JAS 1:10" /><verse number="11" style="v" sid="JAS 1:11" />दाहड़ु उगतेत बेसको सेक लागे, ने चारान फुल झड़ जाय, ने बेसको वारु देखाय असो रवे चो सर जाय; तसुत अमीर माणुस बी, आपसा वाटे कमायणेन हाय-हरबड़ करतु-करतु मरीन धुळा मां भेसकाय जासे।<verse eid="JAS 1:11" /></para>
  <para style="s">पारख ने लालच</para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12" />वारु छे चु माणुस जु पारख मां काठु रहे, काहाकी चु खरु बणीन जीवनेन पागड़ी जड़से जु वायदु मालीक आपसा सी परम करने वाळा सी करलु छे। <verse eid="JAS 1:12" /><verse number="13" style="v" sid="JAS 1:13" />जत्‌यार बी काहनाक ने पारख आवे, ती चु असु कय्‌न भगवानेक वात नी काटणु चाहजे, काहाकी भगवान भुंडी वातेन नी ते पारख कर सके ने नी चु काहनान ने पारख खुद करे। <verse eid="JAS 1:13" /><verse number="14" style="v" sid="JAS 1:14" />बाकुन काहना बी माणसे आपसीत हाय्‌न साहरे हापकाये ने फांदायन पारख मां पड़ जाय। <verse eid="JAS 1:14" /><verse number="15" style="v" sid="JAS 1:15" />बाकुन जीत हाय माणसेन जीवाय मां बड़ जाय, ने माणसे पाप करने बाजी जाय। ने अळतेन पसतावु करे वीगुर चे असला पाप कर्‌या करे, ती आकरी टेमे, चे भगवानेन जीवाय सी छेटा हय्‌न जलमकात मर जासे।<verse eid="JAS 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16" />ए मारा लाटेक्‌ला भायस्‌यो ने बहणस्‌या! आपसा काजे धुकु घुण देवु। <verse eid="JAS 1:16" /><verse number="17" style="v" sid="JAS 1:17" />काहाकी उपर सीत, आपणुक वारलु चीज ने वारला वाटा आपे, तींद्‌रेम काय बी कसर नी रवे। ने आखो वीजाळान बास सीत जड़े, तेरेमां काय बी बदली नी हय सके, ने नी अदलु-बदलु करने सी तीना पर साहळु पाड़े। <verse eid="JAS 1:17" /><verse number="18" style="v" sid="JAS 1:18" />हव, भगवान आपसीत मरजीन अनसारे, आपसान छाचाय्‌न छाचला बुल पर भुरसु कराड़ीन, आपणुक नवलो जीवाय आप्‌यु। भगवान एरेन करीन नवलो जीवाय आप्‌यु, की भगवानेन हाते बणावला आखा माणसे मायन, आपणु, भगवान वाटे पेहला फळ रवजे।<verse eid="JAS 1:18" /></para>
  <para style="s">सामळनु ने करनु</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19" />ए मारा लाटेक्‌ला भायस्‌यो ने बहणस्‌या! जी वात हेर राखु! की, एकेक माणुस भगवानेन बुल मन लागाड़ीन सामळनु चाहजे, ने बुले ती वीच्‌यार करे पाखुर मामार नी बुलनु चाहजे, ने मामार नी रीसायणु चाहजे। <verse eid="JAS 1:19" /><verse number="20" style="v" sid="JAS 1:20" />काहाकी काहना बी माणसेन रीस, भगवानेन धरमेन काम नी कर सके। <verse eid="JAS 1:20" /><verse number="21" style="v" sid="JAS 1:21" />आखी भुंडी वेहवार ने कुहराय काजे छेटी कर देवु। ने तुहुंं ज भगवानेन छाचला बुल सामळ्‌या, तीना बुले काजे आपसान जीवाय मां नीचळा हय्‌न आवरी लेवु; काहाकी ज छाचलो बुल तुंद्‌रा जीव-आत्‌मा काजे छुटकारु आप सके।<verse eid="JAS 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22" />हेरेसी भगवानेन बुले, सामळने वाळा अतरात नी, बाकुन तीनु बुलेन अनसारे जीवण्‌या बी बणु। कदी तुहुंं भगवानेन बुल सामळीन तेरेत अनसारे नी जीवे, ती तुहुंं आपसात काजे धुकु दी र्‌या। <verse eid="JAS 1:22" /><verse number="23" style="v" sid="JAS 1:23" />जु भगवानेन बुल ते सामळे, बाकुन भगवानेन बुलेन अनसारे नी जीवे; चु तीना माणसे साय छे, जु आपसो मुंहडो आरस्‌या मां देखे, <verse eid="JAS 1:23" /><verse number="24" style="v" sid="JAS 1:24" />काहाकी चु आपसा काजे आरस्‌याम देखीन जाती रहे ने मामार ईसरी जाय की आपसु कसु हतलु। <verse eid="JAS 1:24" /><verse number="25" style="v" sid="JAS 1:25" />बाकुन जु माणुस जसों छुड़ावन्‌या चुखला सास्‌तुर कहें तसु धी‌यान करतु रहे, तेरा काम मां संयबरकत आवसे काहाकी चु सामळीन ईसरे नी बाकुन तसुत काम बी करे।<verse eid="JAS 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 1:26" />कदी काहनुक माणुस आपसा काजे मे भगवानेन भक्‌ती करन्‌यु छे असु मान लेय, ने आपसान जीप काजे आपसा बस मां नी राखे, ती चु आपसात काजे धुकु देय, हेरेसी तेरी भक्‌ती करनु वारु नी हय। <verse eid="JAS 1:26" /><verse number="27" style="v" sid="JAS 1:27" />भगवानेन छाचलु भगत, पुराह्‌यला ने रांडायलान दुखो मां, तींद्‌री मदत करसे। अतरोत नी बाकुन चु तींद्‌री मदत करनेन टेमे बी, आपसा काजे ईनी कळीन पाप-धंदा सी छेटु राख्‌से। आपणा भगवान बासेन नींगा मां चुखलो ने नी-गुनावाळी भक्‌ती जीत छे। <note caller="+" style="x"><char style="xo" closed="false">1:27 </char><char style="xt" closed="false"><ref loc="PSA 34:13">भजन सहीता 34:13</ref>; <ref loc="PSA 141:3">141:3</ref></char></note><verse eid="JAS 1:27" /></para>
  <chapter eid="JAS 1" />
  <chapter number="2" style="c" sid="JAS 2" />
  <para style="s">नेवाड़ करनेन बारामां चेताव</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1" />ए मारा लाटेक्‌ला भायस्‌यो ने बहणस्‌या! आपणु मालीक ईसु मसी सेक-सींगार भर्‌यु छे, तेरे पर भुरसु करनेन साहरे आपणु आखा एक छे, हेरेसी काहनान बी वगे वळीन, नानला मटाक नेवाड़नु नी चाहजे।<note caller="+" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="JOB 34:19">अय्‌युब 34:19</ref>; <ref loc="PSA 24:7-10">भजन सहीता 24:7-10</ref></char></note> <verse eid="JAS 2:1" /><verse number="2" style="v" sid="JAS 2:2" />मान लेवु, कदी एक माणुस सनान मुंदी ने वारु-वारु पुथल्‌या पेहरीन ईसुन भक्‌तीन घर मां आवे, ने एक गरीब तेरे धड़े काय बी नी हय, चु बी मुयेळ वाळा, कुचळायला पुथल्‌या पेहरीन आवे; <verse eid="JAS 2:2" /><verse number="3" style="v" sid="JAS 2:3" />ने तुहुंं तीना वारु-वारु पुथल्‌या पेहरीन आवण्‌यान मुंहडो देखीन कहुं की तु जां वारलु जागे बस ने तीना गरीब काजे कहुं की हय उबु रव, नीते मारा पायेन्‌चां बस, <verse eid="JAS 2:3" /><verse number="4" style="v" sid="JAS 2:4" />असु वेहवार करीन तुहुंं ते एक जणान आव-भाव करीन नानला मटान छीट राख रया, असलु वीच्‌यार भुंडुत छे जी वात तुहुंंक मालुम नी हय काय? असु वीच्‌यार करीन, तुहुंं मंडळीन माणसे गरीब ने मालदारेन नेवाड़ु पाड़ र्‌या।<verse eid="JAS 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5" />ए मारा लाटेक्‌ला भायस्‌यो ने बहणस्‌या। सामळु। भगवान ईनी कळीन गरीब माणसे काजे भुरसा मां मालदार बणावे ने भगवानेन राजेन हकदार्‌या बणावणे करीन नेवाड़लु छे। जे भगवान काजे परम करे, तीनुक चु आपसा राजेन हकदार्‌या बणावणे करीन पेहलुत वायदु करलु हतलु। <verse eid="JAS 2:5" /><verse number="6" style="v" sid="JAS 2:6" />बाकुन तुहुंं ते छीट राखीन ईनु गरीब माणसेन हासी उड़ाया। तुहुंंक कुरुट-कचेरी मां घीसड़ी-घीसड़ीन ली जाण्‌या कुण छे? जे मालदार माणसेत छे, जे तुहुंंक वेला पाड़ र्‌या। <verse eid="JAS 2:6" /><verse number="7" style="v" sid="JAS 2:7" />तुहुंं तीना ईसुक भगवान मानीन, भक्‌ती कर र्‌या, तीना ईसुन नाव-बद्‌दी करन्‌या असला मालदार माणसेत छे।<verse eid="JAS 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8" />मुसान नेम मां असो लिखलो छे, तु तार साते वाळाक तारेन तसुत परम कर। जु नेम कायदु आखाम मटु छे करीन आपणु राजा ईसु सीकाड़लु छे। कदी तुहुंं जु नेम कायदु पाळु ती तुहुंं वारलुत कर र्‌या।<note caller="+" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="LEV 19:18">लेवयवेवस्‌था 19:18</ref></char></note> <verse eid="JAS 2:8" /><verse number="9" style="v" sid="JAS 2:9" />बाकुन कदी तुहुंं गरीबेन नेवाड़ु करीन मालदार्‌याक अतरोत परम कर रया, ती तुहुंं पाप कर रया, हेरेसी तुहुंं भगवानेन कायदान अनसारे कायदु तुहुंंक गुनाळु ठेहरावे।<note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="LEV 19:15">लेवयवेवस्‌था 19:15</ref></char></note> <verse eid="JAS 2:9" /><verse number="10" style="v" sid="JAS 2:10" />जु काहनुक भगवानेन आखा कायदाक पाळे, ने कदी एक कायदु बी पाळनेम चुक जाय, ती चु आखा कायदा पाळनेन नेम चुक गुयु कह्‌वाये। <verse eid="JAS 2:10" /><verse number="11" style="v" sid="JAS 2:11" />काहाकी असो बी कहलो छे की छीनाळो घुण करजु, चु जु हुकुम बी आप्‌लु छे की खुन घुण करजु। काहाकी तुहुंं छीनाळो ते नी कर्‌या बाकुन खुन अतरोत कर्‌या, तेबी तुहुंं भगवानेन कायदान अनसारे गुनाळा रवसु।<note caller="+" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="EXO 20:13-14">नीरगमन 20:13-14</ref>; <ref loc="DEU 5:17">वेवस्‌थावीवरन 5:17</ref>,<ref loc="DEU 5:18">18</ref></char></note> <verse eid="JAS 2:11" /><verse number="12" style="v" sid="JAS 2:12" />तुहुंं तीनु माणसे साय बुल कह्‌वु, ने काम बी करु, तींद्‌रो नीयाव हीना कायदान अनसारे हवसे। <verse eid="JAS 2:12" /><verse number="13" style="v" sid="JAS 2:13" />जु दयाळु नी हय, हेरे वाटे भगवानेन नीयाव बी दया पाखुर हवसे; काहाकी दया नीयाव पर बड़ीन रवे।<verse eid="JAS 2:13" /></para>
  <para style="s">भुरसु ने भलायन काम</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14" />ए भायस ने बहणस्‌या! कदी काहनुक, कह्‌वे की मे ईसु पर भुरसु करो। बाकुन चु भुरसान अनसारे भलायन काम नी करे, ती असु भुरसु करने सी काय बी फायदु नी हवे असु भुरसु करन्‌या माणसेक, भगवान छुटकारु नी आपे। <verse eid="JAS 2:14" /><verse number="15" style="v" sid="JAS 2:15" />मान लेवु की काहना भायस नीते बहणीस धड़े पेहरने वाटे पुथल्‌या नी हय, ने दाहड़ीन खाणे वाटे खाणो बी नी हय; <verse eid="JAS 2:15" /><verse number="16" style="v" sid="JAS 2:16" />ने कदी तुंद्‌रे मायन काहनुक तीनीक नीते तीनाक कह्‌वे, खुस हय्‌न जात रव, “ने वारु हुपवाळा पुथल्‌या पेहरजी ने पेट भरीन खाणो खाजी।” बाकुन चु कहण्‌यु तीनुक डीलो वाटे ज चाहजे च नी आपे, ती तेरा कवला बुले, तेरा ने सामळ‌न्‌यान काय बी फायदु नी करे। <verse eid="JAS 2:16" /><verse number="17" style="v" sid="JAS 2:17" />असु भुरसु बी भलायन कामे बीगुर मरलु छे।<verse eid="JAS 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18" />कदी काहनुक मेसेक असु पुछे की “भगवान पर तारु भुरसु छे काय?” ती मे तीनाक असु कयस “हव, मे ते भलायन कामेन साहरे भुरसान पुरावु दी रयु। मे ते तुसेक, मारु भुरसु मारी उठ-बस मां भगवानेन नावे करला भलायन कामेन साहरे देखाड़ीस।” बाकुन मे तीनाक ज बी पुछीस, “भगवानेन नावे भलायन काम करे बीगुर, तु कसु काय कय सके की, मे भगवान पर भुरसु करो।” <verse eid="JAS 2:18" /><verse number="19" style="v" sid="JAS 2:19" />ए माणसे एकुत भगवान छे, असु तारु भुरसु छे काय? हसे रे! बाकुन भुतड़ान आत्‌मा बी एकुत भगवान छे। करीन भुरसु करे, ने थर-थर कापे। असलु भुरसु काय कामकु? <verse eid="JAS 2:19" /><verse number="20" style="v" sid="JAS 2:20" />ए डेड़-अकल्‌या माणसे कदी तु ईसु पर भुरसु अतरुत करे, ने भुरसु करनेन साहरे देखाव पड़न्‌या भलायन काम नी करे ती तारु भुरसु फालतु छे, ईनी वातेन हुकारु भरने करीन तुसेक पुरावु चाहजे काय? <verse eid="JAS 2:20" /><verse number="21" style="v" sid="JAS 2:21" />जत्‌यार आपणु बास अब्‌राहम आपसा पुर्‌याक इसाक काजे वेदी पर चड़ायु, ती काय चु काम सी धरमी नी बण्‌यु काय?<note caller="+" style="x"><char style="xo" closed="false">2:21 </char><char style="xt" closed="false"><ref loc="GEN 22:9">उबजाणनी किताप 22:9</ref></char></note> <verse eid="JAS 2:21" /><verse number="22" style="v" sid="JAS 2:22" />अब्‌राहमेन ते भगवान पर अतरु जबर भुरसु हतलु, की चु भगवान ज काय बी कह्‌यु, तीनाक करने करीन तीयार हतलु। हेरेसी जे भलायन काम अबराहाम्‌यु कर्‌यु, तेरेसी आपणे अगळ जी वात उजेंती हय जाय की अब्‌राहमेन भुरसान काय बी कसर नी रय। <verse eid="JAS 2:22" /><verse number="23" style="v" sid="JAS 2:23" />चुखला सास्‌तुर मां असो लिखलो छे, अब्‌राहम ते भगवान पर भुरसु कर्‌यु, हेरेसी भगवान तीना भुरसान साहरे तीनाक धरमी बणायु। सास्‌तुरेन ज बुल अब्‌राहमेन जीवन मां पुरो हय गुयो। अतरोत नी बाकुन, चु भगवानेन दुस्‌तीदार कवायणे बाजी गुयु। <note caller="+" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="GEN 15:6">उबजाणनी किताप 15:6</ref></char></note> <verse eid="JAS 2:23" /><verse number="24" style="v" sid="JAS 2:24" />हेरेसी अब्‌राहमेन जीवनेन साहरे आपणे अगळ जी वात उजेंती हय जाय की भगवान पर माणसेन पाक्‌कु भुरसु फालतु नी रवे; चु भुरसु तींद्‌रे जीवन मां भलायन कामेन साहरे देखाव पड़से ने असला माणसेत काजे भगवान धरमी समजु।<verse eid="JAS 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JAS 2:25" />तसोत राहाब बायरीन जात रंडी, जत्‌यार हयी आपसा खबर देण्‌या काजे आपसा घर राखी ने दीसरे वाट्‌ये सी मकली, ती काय ची काम सी धरमी नी बणी? <note caller="+" style="x"><char style="xo" closed="false">2:25 </char><char style="xt" closed="false"><ref loc="HEB 11:31">ईब्‌रानीयो 11:31</ref></char></note><verse eid="JAS 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 2:26" />मे असु काहा कय रयु? मेसेक पाक्‌को मालुम छे की, जु भगवान पर भुरसु करे, बाकुन भुरसान अनसारे तेरी जीवाय मां भलायन काम देखाव नी पड़े, ती तेरु भुरसु मरलु‌ छे। असलु भुरसु एक मरला माणसेन तसु छे, जु दम नी लेय। तेरो डील ते छे; बाकुन जीव नी हय।<verse eid="JAS 2:26" /></para>
  <chapter eid="JAS 2" />
  <chapter number="3" style="c" sid="JAS 3" />
  <para style="s">जीप काजे ने डील काजे आपणा बस मां राखणु</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1" />ए मारा भायस्‌यो ने बहणस्‌या, तुंद्‌रे मां सी बेसका सीकापण आपण्‌या मां बणु, काहाकी जाणु की हामु सीकापण आपण्‌या अळी बी गुना वाळा बणसु। <verse eid="JAS 3:1" /><verse number="2" style="v" sid="JAS 3:2" />आपणु आखा भगवानेन बुलेन अनसारे जीवणे मां बेसका कावा चुक जाजे। हेरेसी तुंद्‌रे मां जे चे, भगवानेन बुल सीकाड़न्‌या नी बणनु चाहजे। कदी काहनुक आपसी जीप काजे कब्‌जाम राखीन, सामळ्‌ये असा बुले बुल्‌या करे, चु माणुस पुरु-पुरु पाक्‌कु छे, ने चु आपसा आखा डीलेक बी कब्‌जा मां राख सके। <verse eid="JAS 3:2" /><verse number="3" style="v" sid="JAS 3:3" />जत्‌यार आपणु दाखलान हीसाबे वीच्‌यार करु; घुल्‌लाक कब्‌जाम करने करीन तेरा मुंहडा मां लगाम पेहरावणु पड़े। तीत, घुल्‌लु बदे ने आपणु तीनाक, जां ली जाणु हय चां ली जाय सकजे। <verse eid="JAS 3:3" /><verse number="4" style="v" sid="JAS 3:4" />ने देखु जाराक वीच्‌यार करु! दर्‌याम चालन्‌यो ढंड्‌यो बी बेसको मटो छे। दर्‌याम बेसके जुरे चालनी आंधी मां चो ढंड्‌यो अथोन-अथो फीर जाय। तेबी एक नानलास हेंडलेन साहरे ढंड्‌यो चालाड़न्‌यु आंधी मां बी ढंड्‌या काजे, जां ली जाणु चाहजे चांहान ली जात रवे। <verse eid="JAS 3:4" /><verse number="5" style="v" sid="JAS 3:5" />तसीत जीप बी आपणा डीलेन एक नानोस अंग छे, तेबी मटी-मटी वात करने मां पछी नी पड़े। बाकुन ईनी जीप वाटे बेसकी मटी नुकसाण झेलनु पड़े।<figure style="fig" alt="Rider on a horse" file="lb00035c.tif" size="col" copy="Horace Knowles ©" ref="3:3">घुल्‌ला पर बठीन जाय</figure></para>
  <para style="p" vid="JAS 3:5">हय आकठान तीणग्‌यान बारामां वीच्‌यार करु! ईना तीणग्‌यान साहरे बयड़ा मां आकठो लाग जाय, ने हुड़ु-हुड़ु बयड़ु धप जाय ती कतरो नुकसाण हय जाय। <verse eid="JAS 3:5" /><verse number="6" style="v" sid="JAS 3:6" />तसी जीप बी आपणा डीलेन एक आकठो छे; जी आकठान तीणग्‌यान तसी छे, आपणुक जतर-कतर नी बुलनु चाहजे, नी ते आपणा हीया मनेम कुहराय काजे उजेंतो करे। जे बुले, आपणा आखा वीच्‌यार काजे ने काम काजे बी वीटाळ देय। जसों आकठीन आच आखी चीजेक धपाड़ीन सार देय, ने नरक कुंडेन आकठा सी धपती रवे। <verse eid="JAS 3:6" /><verse number="7" style="v" sid="JAS 3:7" />ईनी कळीन भाती-भातीन जंगली जनवार्‌या काजे ने पाणीम चालन्‌या-फीरन्‌या जीव जनवार्‌या काजे, ने भाती-भातीन चिरला काजे ने धरती पर घीसड़ायन चालन्‌या भाती-भातीन जनवार्‌या काजे माणसे बदाड़ सके, ने बेसका जनवार्‌या काजे बदाड़ बी लेदला छे। <verse eid="JAS 3:7" /><verse number="8" style="v" sid="JAS 3:8" />बाकुन माणसेन जीप ते लपळ्‌ळी छे, हेरेसी काहनु बी माणुस आपसान जुर, सी आपसी जीप काजे बदाड़ नी सके। कुहराय काजे उबजाड़े। छाचलीन जीप, जीव ली लेय, असला जहर साय छे।<note caller="+" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="PSA 140:3">भजन सहीता 140:3</ref></char></note> <verse eid="JAS 3:8" /><verse number="9" style="v" sid="JAS 3:9" />ईनी जीप सीत आपणु मालीक भगवान बासेन बड़ाय करजे, ने ईनी जीपुत ती भगवानेन रुप मां घड़ायला माणसे काजे सराप देजे। <verse eid="JAS 3:9" /><verse number="10" style="v" sid="JAS 3:10" />असु करीन एकुत मुंहडा सी आपणु सराप बी देजे ने भगवानेक बेसकु वारु कह्‌जे। असो हवणु वारु छे काय? ए मारा भायस्‌यो ने बहणस्‌या! असा घुण कह्‌वु। <verse eid="JAS 3:10" /><verse number="11" style="v" sid="JAS 3:11" />एकुत झीरेम सी गुळो ने खारलो पाणी नीकळी सके काय? कहुं ते खरा! <verse eid="JAS 3:11" /><verse number="12" style="v" sid="JAS 3:12" />ए मारा भायस्‌यो ने बहणस्‌या! अंजीरेन झाड़का पर जेतुनेन झाड़कान फळ लागे काय? ने अंगुरेन रेला मां अंजीरेन फळ लागे काय? तसात खारला पाणीन झीरेम सी गुळो पाणी नी नीकळे।<verse eid="JAS 3:12" /></para>
  <para style="s">खरलु अक्‌कल</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13" />तुंद्‌रे मायन असु कुण छे, चु आपसा काजे अकलवाळु ने जानकार समजे? जु असु हय, चु आपसी छाचली अकलेन साहरे पुरावु देणु चाहजे। ने ईनी छाचली अक्‌कल काजे दीसरा साते नीचळाय्‌न वेहवारेन ने कामेन साहरे उजेंती करनु चाहजे। <verse eid="JAS 3:13" /><verse number="14" style="v" sid="JAS 3:14" />बाकुन कदी तुहुंं आपसा-आपसा मनेम घमंड राखीन कुहराय ने दीसरा सी मटा बणने हींडे, ती तुंद्‌रो ज मटाय करनु झुट छे। तुहुंं ते आपसा बारामां जो काय छाचाय्‌न वीरुद मां झुट मेक रया की हामु जानकार अकलवाळा छे। हेरेसी तुहुंं मटाय करनु ने झुट मेकणु छुड़ देवु। <verse eid="JAS 3:14" /><verse number="15" style="v" sid="JAS 3:15" />असली मटाय करनेन अक्‌कल उपर सरगे सी नी आवे, बाकुन ईनी कळीन माणसे धड़े छे। असली अक्‌कल नी आपे; बाकुन भुतड़ा धड़े सी आवे। असलु अक्‌कल वाळु डीलेन अतरुत फीकुर करे, बाकुन आपसान जीव-आत्‌मान फीकुर नी करे। <verse eid="JAS 3:15" /><verse number="16" style="v" sid="JAS 3:16" />जां आखा माणसे एक दीसरा पर कुहराये, ने दीसरा सी मटा बणनेन हेर करे, चां आखी भातीन कुहरला कामे ने लड़ाय हवे। <verse eid="JAS 3:16" /><verse number="17" style="v" sid="JAS 3:17" />बाकुन जी अक्‌कल भगवान उपर सी आपे, ची अक्‌कल खास चुखली छे। असला अकलवाळा माणसे, दीसरा साते भेळा रवे, ने सुवाळा रवे, ने दीसरान वात बी मान्‌ने तीयार रवे। चे बेसका दयाळा छे, ने दीसरान भलाय करता रवे। चे ते ढंगड़ा नी करे, ने काहनान छीट राखीन काहनान वगे नी वळे। <verse eid="JAS 3:17" /><verse number="18" style="v" sid="JAS 3:18" />मेळ कराड़ने वाळा जे अकलवाळा माणसे दीसरा साते हेळी-मीळीन रवे, चे दीसराक बी मीलाड़ देय, ने असा करीन चे आखा मेळीन धरमेन काम करीन जीवणे बाजी जाय। जे वारलु वेरे, चे वारलुत काटे।<note caller="+" style="x"><char style="xo" closed="false">3:18 </char><char style="xt" closed="false"><ref loc="ISA 32:17">यसाया 32:17</ref></char></note><verse eid="JAS 3:18" /></para>
  <chapter eid="JAS 3" />
  <chapter number="4" style="c" sid="JAS 4" />
  <para style="s">ईनी कळी साते दुस्‌तीदारी नी करनु चाहजे</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1" />हय तुंद्‌रे ईचमां लड़ाय-झगड़ा कां सी आय गुया? तुहुंंक जी वात मालुम नी हय काय तुंद्‌रा डीलेम ने मनेम मजा लेण्‌या छीनाळ्‌या वीच्‌यारे, भगवानेक चाहजे असली वातेन वीरुद मां लड़ाय रया। तीनु वीच्‌यारेन साहरे तुंद्‌रे ईचमां लड़ाय-झगड़ा हय र्‌या। <verse eid="JAS 4:1" /><verse number="2" style="v" sid="JAS 4:2" />तुहुंं हाय ते कर र्‌या, बाकुन ची हाय पुरी नी हवे, हेरेसी तुहुंं दीसरान खुन करने हींड रया। ने तुहुंं दीसरा पर कुहराये, बाकुन तुहुंंक काय नी जड़े हेरेसी तुहुंं लड़ाय-झगड़ु कर रया। तुहुंंक ज जड़नु चाहजे, च नी जड़तो काहाकी तुहुंं भगवान धड़े च नी मांग्‌ता <verse eid="JAS 4:2" /><verse number="3" style="v" sid="JAS 4:3" />तुहुंं मांगु ने जड़े नी, हेरेसी की भुंडला वीच्‌यार सी मांगु, काहाकी आपणे पाप-धंदाम मुजा लेणे मां उजाड़ देवु। <verse eid="JAS 4:3" /><verse number="4" style="v" sid="JAS 4:4" />सामळु हय तुहुंं, तीनी छीनाळी बायर साय छे, जी आपसा घरवाळाक छुड़ीन दीसरा पुठ्‌ये छीनाळो करे। तुहुंं ते छाचला भगवान काजे छुड़ीन ईनी कळीन चीजेन हेर कर रया। तुहुंंक जी वात मालुम नी हय काय? की ईनी कळीन कुहरायला माणसेन तसा कुहराय करीन तींद्‌रे साते दुस्‌ती करनु भगवान साते खार करनु छे। हेरेसी जु काहनुक जाणी बुजीन ईनी कळीम दुस्‌तीदार बणने हींडे, चु भगवानेन वेरी बण जाय।<note caller="+" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="1JN 2:15">1 युहन्‌ना 2:15</ref>,<ref loc="1JN 2:16">16</ref></char></note> <verse eid="JAS 4:4" /><verse number="5" style="v" sid="JAS 4:5" />चुखला सास्‌तुर मां सी आपणुक जी सीक जड़ली छे, की भगवान जत्‌यार माणसेक बणायु, तत्‌यार आपणा जीवो ने डीलो पुठ्‌ये रहणे करीन जीव-आत्‌मा काजे बी बठाड़्‌यु। हेरेसी चु आपणा जीव-आत्‌मान बारामां जी फीकुर करे, की आपणु जीव-आत्‌मा तेरे वाटे पुरो जीवणु चाहजे। चुखला सास्‌तुरेन ज बुल भुंडला वीच्‌यार सी। असा तुहुंं समजी र्‌या काय? <verse eid="JAS 4:5" /><verse number="6" style="v" sid="JAS 4:6" />चु भगवान ते आपणे पर बेसका दया देखाड़े। हेरेसी सास्‌तुर मां ज बी लिखलो छे की “भगवान मटाय करन्‌यान वीरुद करे, बाकुन नीचळा माणसे पर दया करे।”<verse eid="JAS 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 4:7" />हेरेसी तुहुंं भगवानेन हक मां हय जावु, ने भुतड़ान वातेन वीरुद करता जाय्‌न भुतड़ा साते गड़दी जावु, ती चु तुंद्‌रेन्‌चां सी ढास जासे। <verse eid="JAS 4:7" /><verse number="8" style="v" sid="JAS 4:8" />भगवानेन्‌चां आवु, ती भगवान बी तुंद्‌रेन्‌चां आवसे। ए पापी माणसे। पाप करनु छुड़ देवु, ने तुंद्‌रा संका काजे छुड़ु, ने चुखला वीच्‌यार राखु।<note caller="+" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="ZEC 1:3">जकर्‌याह 1:3</ref>; <ref loc="MAL 3:7">मलाकी 3:7</ref></char></note> <verse eid="JAS 4:8" /><verse number="9" style="v" sid="JAS 4:9" />दुखी हवु ने कलप्‌या करु, ने रड़ु। तुंद्‌री हासी दुख मां ने तुंद्‌री खुसी नुरपाणी मां बदली जासे। <verse eid="JAS 4:9" /><verse number="10" style="v" sid="JAS 4:10" />हेरेसी तुहुंं मालीक अगळ नीचळा बण जावु; ती मालीक तुहुंंक नानला सी मटा बणावसे।<note caller="+" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="PSA 147:6">भजन सहीता 147:6</ref></char></note><verse eid="JAS 4:10" /></para>
  <para style="s">भायस्‌यो पर गुनु लागाड़नु वारु नी हय</para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11" />ए भायस्‌यो ने बहणस्‌या! तुहुंं एक दीसरान नाव-बद्‌दी मां करु। भगवान आपसा कायदाम असु हुकुम आपलु छे की, तुहुंं आपसा सातेवाळाक परम करु। हेरेसी कदी तुहुंं, ईसु पर भुरसु करन्‌या आपसा भायस्‌योन नाव-बद्‌दी कर रया, ने तेरे पर गुनु लागाड़ रया हय, ती तुहुंं भगवानेन कायदान नाव-बद्‌दी कर रया, ने तेरे पर गुनु लागाड़ रया। ने कदी तुहुंं भगवानेन कायदा पर गुनु नाख रया, ती तुहुंं ते भगवानेन कायदान अनसारे चालने वाळा नी, बाकुन तेरे पर नीयाव करने वाळा बण रया। <verse eid="JAS 4:11" /><verse number="12" style="v" sid="JAS 4:12" />कायदु बणावीन आपणे वाळु ते भगवान छे; कायदान अनसारे नीयाव करन्‌यु बी हयुत छे। हेरेसी माणसेन नीयाव करीन तीनाक नीयाव करने वाळु, नी ते तीनाक बचाड़नेन हक बी तेरे धड़े छे। बाकुन तु कुण छे, जु आपसा सातेवाळा पर गुनु लागाड़ रयु?<verse eid="JAS 4:12" /></para>
  <para style="s">मटाय करन्‌या काजे चेतावणी</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13" />तुहुंं ते ज कय रया, की आज नीते वाहणे हामु काहनाक दीसरा सहर मां जाय्‌न, “एक साल लग काम करसु ने वेपार करीन नफु कमायसु। बाकुन मारी वात मन लागाड़ीन सामळु ते खरा।” <verse eid="JAS 4:13" /><verse number="14" style="v" sid="JAS 4:14" />तुहुंं ज नी जाणु की वाहणे काय हवसे। तुंद्‌री जीवाय्‌न काय ठीकाणो नी हय। तुंद्‌री जीवाय ते कुळ्‌ळा साय छे, जी थुड़ीक वार देखाव पड़े ने अंछाप हय जाय।<note caller="+" style="x"><char style="xo" closed="false">4:14 </char><char style="xt" closed="false"><ref loc="PRO 27:1">नीतीवचन 27:1</ref></char></note> <verse eid="JAS 4:14" /><verse number="15" style="v" sid="JAS 4:15" />हेरेसी तुहुंंक असो कहंणु चाहजे की कदी भगवान मालीकेन मरजी हसे, ती वाहणे बी जीवतेलो रवसु ने ज काम नी ते पलो काम करसु। <verse eid="JAS 4:15" /><verse number="16" style="v" sid="JAS 4:16" />बाकुन तुहुंं ते हय बी असा कह्‌ता जाय्‌न मटाय कर रया की हामु जु वीच्‌यार कर्‌या तसोन-तसों करसु। असी मटाय भगवानेन नींगा मां भुंडी छे।<figure style="fig" alt="Customer, merchant with his wares" file="hk00172c.tif" size="col" copy="Horace Knowles ©" ref="4:13">लेण्‌या ने वेपारी आपसा समान साते</figure><verse eid="JAS 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 4:17" />हेरेसी काहनुक भलाय करनु जाणीन बी भलाय नी करे, ती चु पाप कर रयु।<verse eid="JAS 4:17" /></para>
  <chapter eid="JAS 4" />
  <chapter number="5" style="c" sid="JAS 5" />
  <para style="s">भगवान ईनी कळीन अमीर माणसेन नीयाव करसे</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1" />ए अमीर माणसे! मारेन्‌चां आवीन मारी वात सामळु। जत्‌यार भगवान तुंद्‌रु नीयाव करसे, तत्‌यार तुहुंंक बेसका वेला करनु पड़से। तुंद्‌रे वाटे ज वारु रवसे, की तुहुंं हय तीनी गरान बारामां वीच्‌यार करीन रड़ु ने कलपु। <verse eid="JAS 5:1" /><verse number="2" style="v" sid="JAS 5:2" />तुहुंं आपसा वाटे घणो माल धन जापताये मेल रया। बाकुन हय देखु, तुंद्‌रा पयस्‌या टका जीर गुयला छे; ने तुंद्‌रा वारलु-महंगला पुथल्‌या पर वेधु लाग गुयली छे। <verse eid="JAS 5:2" /><verse number="3" style="v" sid="JAS 5:3" />देखु ते खरा, तुंद्‌रा सनो चांदी पर बी कीटी लाग गुयली छे। जत्‌यार भगवान तुंद्‌रु नीयाव करसे, ती हयी कीटी तुंद्‌रा गुनान जी गवा देसे की तुहुंं बेसका हायाळ्‌ळा छे। जसी आकठी माणसेक खाय जाय, तसुत भगवान तुहुंंक डंड आपसे। तुहुंं ते खत्‌तम हवणी ईनी कळीन आकरी दाहड़ा मां बी धन भेळो करीन धीग लागाड़ रया। <verse eid="JAS 5:3" /><verse number="4" style="v" sid="JAS 5:4" />दाहड़क्‌या तुंद्‌रा खेतेन मेर काट्‌या, ने तुहुंं तीनुक दाहड़की नी आप्‌या। ची दाहड़की तुंद्‌रा गुनान बारामां जुर सी आयड़ी रय, सामळु ते खरा चे दाहड़क्‌या बी रड़ने कलपणे बाजी रया। ने ताकत वाळु मालीक भगवान तींद्‌रो रड़नु सामळी लेदलु छे।<note caller="+" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="LEV 19:15">लेवयवेवस्‌था 19:15</ref></char></note> <verse eid="JAS 5:4" /><verse number="5" style="v" sid="JAS 5:5" />तुहुंं धरती पर वारु सुक सी जीवीन बेसका मुजा कर लेदला छे; ने तुहुंं खस्‌सी कराड़ला बुकड़ान तसा मातालीस हय रया। <verse eid="JAS 5:5" /><verse number="6" style="v" sid="JAS 5:6" />जे धरमी तुंद्‌री मानीन सांबु बुल लग नी कह्‌या, तुहुंं तीनु धरमी काजे गुनाळा छे, कय्‌न मार नाख्‌या।<verse eid="JAS 5:6" /></para>
  <para style="s">गम खाणु ने दुवा करनु</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7" />हेरेसी ए भायस्‌यो ने बहणस्‌या! मालीक ईसुक पछा आवणे लग दम धरीन रवजु। किरसाण काजे देखीन सीकु, चु ते खेतेम वारु पाकाड़ने करीन दम धरीन रवे, हव चु पेहलु ने आकरी पाणी आवणेन वाट देखता रवे।<note caller="+" style="x"><char style="xo" closed="false">5:7 </char><char style="xt" closed="false"><ref loc="DEU 11:14">वेवस्‌थावीवरन 11:14</ref></char></note> <verse eid="JAS 5:7" /><verse number="8" style="v" sid="JAS 5:8" />मालीक ईसुन पछु आवणेन दाहड़ा धड़ेस आय रया। हेरेसी तुहुंं बी दम धरीन रवजु ने हदस मां छुड़ु।<verse eid="JAS 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 5:9" />ए भायस्‌यो ने बहणस्‌या, आखान नीयाव करन्‌यु भगवान ते धड़ेस आय रयु। हेरेसी एक दीसरान चुरी-चुगली मां करु। तुहुंं चुरी-चुगली नी करु ती तुंद्‌रे पर बी भगवान गुनु नी लागाड़े। <verse eid="JAS 5:9" /><verse number="10" style="v" sid="JAS 5:10" />ए भायस्‌यो ने बहणस्‌या! तुहुंं जाणु की भगवानेन अघली वात बताड़ने वाळा माणसे भगवानेन खबर पुगाड़्‌या, करीन दीसरा माणसे तीनुक बेसका वेला पाड़्‌या, तेबी चे दुख झेल्‌या ने गम खादा तुहुंं बी तीनुक हेर राखीन, दुख ने वेला मां बी गम खाय्‌न दम धरीन रवजु। <verse eid="JAS 5:10" /><verse number="11" style="v" sid="JAS 5:11" />आपणु कह्‌जे की जे दुखेम बी गम खाता रहणु, चे बरकतवाळा छे, तुहुंं आयुबेन बारामां सामळ्‌या नी काय? तीनाक ते बेसको दुख झेलनु पड़्‌यो, तेबी चु कतरु वारु गम खाय्‌न दम धरीन रयु। आपणु जाणजे की भगवान मालीक आकरी टेमे तीनाक संयबरकत आप्‌यु, ने तीनाक एक अंजाण्‌यु माणुस बणाय देदु। चु आपणु भगवान मालीक ते बेसकु दयाळु छे।<verse eid="JAS 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12" />ए भायस्‌यो ने बहणस्‌या, हय मे एक खास वात बताड़ो, सगुन घुण खाजु, नीते सरगेन, नीते धरतीन, नीते काहनीक चीजेन। ज काम तुहुंंक नी बणे, तीना कामेक मे कर लीस करीन घुण कह्‌जु। ज काम तुहुंंक बण जाय, तीना कामेक मे कर लीस कह्‌जु। ज काम तुहुंंक नी बणे, तीना कामेक मेसेक ज नी कराये करीन कह्‌जु। असा कह्‌ता रवसु, ती भगवान तुंद्‌रे पर गुनु नी लागाड़े।<verse eid="JAS 5:12" /></para>
  <para style="s">दुवान ताकत</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13" />कदी तुंद्‌रे मां कुय वेला कर रयु हय, ती चु भगवान धड़े दुवा करनु चाहजे; ने कदी काहनुक सुकनु हय, ती गीत गावीन भगवानेन गुण गावु। <verse eid="JAS 5:13" /><verse number="14" style="v" sid="JAS 5:14" />कदी काहनुक मांदु पड़ रयु हय, ती तीनाक असो कह्‌वणु चाहजे, की मार वाटे दुवा करने करीन मंडळीन मुख्‌या काजे बुलाय लावु, ने चे आवीन मालीक ईसुन नावे तीना मांदलान तेल चुपड़ीन दुवा करसे, <verse eid="JAS 5:14" /><verse number="15" style="v" sid="JAS 5:15" />ने भुरसा भेळी करली दुवान साहरे मांदलु वारु हय जासे, ने मालीक ईसु तीना मांदला काजे वारु कर देसे, ने चु खाट्‌ली मां सी उठी आवसे। ने चु कदी पाप कर्‌यु हय, ती तीनाक माफी बी जड़ जासे। <verse eid="JAS 5:15" /><verse number="16" style="v" sid="JAS 5:16" />हेरेसी तुहुंं एक दीसरा अगळ आपणा-आपणा पापेक मान लेवु, ने एक दीसरा वाटे दुवा करु, तेरेसी तुहुंं डील ने जीव-आत्‌मा मां वारका हय जावु। छाचलीन धरमी माणसेन दुवा ताकतवाळी ने कामकी रवे। <verse eid="JAS 5:16" /><verse number="17" style="v" sid="JAS 5:17" />एलीयान बी ते आपणेन तसु सुक-दुख झेलन्‌यु माणुस हतलु। तेबी चु भगवान धड़े मन लागाड़ीन दुवा कर्‌यु, की पाणी नी आवणु चाहजे। ने साड़े तीन साल लग धरती पर पाणी नी पड़्‌यु। <verse eid="JAS 5:17" /><verse number="18" style="v" sid="JAS 5:18" />अळतेन चु एलीया भगवान धड़े दुवा कर्‌यु, की पाणी आवणु चाहजे ने सरगे सी पाणी पड़्‌यु, ती धरती पर मेर पाकी।<verse eid="JAS 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 5:19" />ए मारा भायस्‌यो ने बहणस्‌या, कदी काहनुक भगवानेन छाचले वाट्‌ये सी छेटु हय जाय, तत्‌यार तीनाक छाचले वाट्‌ये अळी पछु लावणे करीन तेरी मदत करु। <verse eid="JAS 5:19" /><verse number="20" style="v" sid="JAS 5:20" />ती चु असु जान लेणु चाहजे की जु काहनुक काहनाक भटकला पापी काजे पछु ली आवसे, चु जीव-आत्‌मा काजे जलम लग मुत मां सी बचाड़ लेसे। हेरेसी जी वात पाक्‌का जाणीन पापेम खुवायलाक पछु लावणेन काम हासी-खुसी सी करु।<verse eid="JAS 5:20" /></para>
  <chapter eid="JAS 5" />
</usx>