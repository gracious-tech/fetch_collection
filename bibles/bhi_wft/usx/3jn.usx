<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- Bhilali Standard Project</book>
  <para style="h">3 युहन्‌ना</para>
  <para style="toc3">3 युहन्‌ना</para>
  <para style="toc2">3 युहन्‌ना</para>
  <para style="toc1">युहन्‌नान तीसरी चिट्‌ठी</para>
  <para style="mt2">यूहन्ना की तीसरी पत्री</para>
  <para style="mt1">युहन्‌नान तीसरी चिट्‌ठी</para>
  <para style="imt">3 युहन्‌नान बारामां</para>
  <para style="ip">3 युहन्‌नान चिट्‌ठी नेवताळान काम युहन्‌नान साहरे मसीन पयदा हवणेन पचास सी सोव सालेन ईचमां लिखी गुयलो। युहन्‌नु खुद काजे लिखण्‌यान रुप मां नी उळखे, बाकुन खुद काजे डाहा-बुड़ा कह्‌वे। <char style="xt"><ref loc="3JN 1:1">1:1</ref></char> <char style="xt"><ref loc="2JN 1:1">2 युहन्‌ना 1:1</ref></char> मां बी चु असुत करे। असो मानी जाय की युहन्‌ना ईफीसुस मां रय्‌न युहन्‌ना ने तीन आक्‌सर मां 1 युहन्‌ना, 2 युहन्‌ना, 3 युहन्‌नान अनसारे खुस-खबर लिखलो हतलो।</para>
  <para style="ip">युहन्‌ना जी चिट्‌ठी गयुस नावेन एक ईसु पर भुरसु करन्‌या काजे लिख्‌यु। चु गयुस काजे एक दुस्‌तेन कमरा मां देखाड़े ने हीनाक मसी भायसे वाटे मेजवानी करनेन आदेस देय ज्‌य हीना ईलाका मायन हयन जासे।</para>
  <para style="iot">बाहरती वात</para>
  <para style="io1">1. युहन्‌ना आपणी चिट्‌ठीन उळखाण देय। <char style="ior"><ref loc="3JN 1:1">1:1</ref> </char></para>
  <para style="io1">2. अळतेन चु गयुस काजे हिम्‌मत बांदाड़े ने हीनु भायसे काजे मेजवान्‌या देखाड़नेन आदेस देय। <char style="ior"><ref loc="3JN 1:2-8">1:2-8</ref> </char></para>
  <para style="io1">3. हेरे पछेन, चु दुय दीसरा अदमी, दीमेत्‌रफेस ने दीमेत्‌रयुसेन वात करे। <char style="ior"><ref loc="3JN 1:9-12">1:9-12</ref></char></para>
  <para style="io1">4. आकरी मां चु आपणी चिट्‌ठी काजे पुरु करे। <char style="ior"><ref loc="3JN 1:13-14">1:13-14</ref> </char></para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="s">आव-भाव</para>
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />ए मारा लाटेक्‌ला गयुस, मे युहन्‌नु पुडारी, जी चिट्‌ठी तुसे काजे लिखो,</para>
  <para style="p" vid="3JN 1:1">ने मे छाचलीन तुसेक परम करो।<verse eid="3JN 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2" />ए मारा लाटेक्‌ला दुस्‌तीदार, मे तार धड़े जी दुवा करो की, जसु, तु जीव-आत्‌मा मां बड़ रयु, तसुत आखी वात मां बड़ ने वारु रव। <verse eid="3JN 1:2" /><verse number="3" style="v" sid="3JN 1:3" />जत्‌यार हामरा सात देण्‌या भायस तुंद्‌रेन्‌चां सी पछा आवीन तुंद्‌रा बारामां असी छाचली गवाय देदला छे, “तारा चेला ते छाचाय्‌न वाटे वारु चाल रया” तत्‌यार मे बेसकु खुस हयु। ने चे मेसेक ज बी बताड़्‌या की तुहुंं छाचली वाट पर कसा चाल रया। <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />मार वाटे ते मारा पुर्‌या-पारीन बारामां गवाय सामळने सी अळी मट्‌ली खुसी नी हय, की मे सामळो, की मारा पुर्‌या-पारी छाचाय्‌न वाट पर चाले।<verse eid="3JN 1:4" /></para>
  <para style="s">गास्‌यान बड़ाय</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5" />ए मारा लाटेक्‌ला दुस्‌तीदार, तु आपणा भाय बेटान भलाय वाटे ज काय कर सके चो, तु भुरसा भेळ कर रयु, भले चे ईसुन सेवा भक्‌ती करन्‌या भाय बेटा, तारे वाटे अंजाण्‌या छे। <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />ने चे भाय बेटा, जां वाळी मंडळी मां पछा आवीन तारा परमेन बारामां गवा देदला छे। जसु तु, ईनु माणसेक परम सी पेहले आव-भाव करलु, तसुत हय बी अळी ईनुक भगवानेक लागे असो आव-भाव करीन खुसी-खुसी वारु मकल्‌या करजी, ती वारलु रवसे। <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />काहाकी चे ईसु मसी पर भुरसु नी करे तींद्‌रे धड़े, चे काय बी लेय बीगुर, मालीक ईसु मसीन नावेत नीकळ्‌ळा छे। <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />तेरेमां आपणु आखा काजे बी असला माणसेन फीकुर करीन मदत करनु चाहजे। काहाकी आपणु असा करसु, ती छाचाय वाटे काम करन्‌यान साजल्‌या बण जासु।<verse eid="3JN 1:8" /></para>
  <para style="s">दीयुतीरफ्‌यु ने देमेतीरीयुस</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />मे, ईनी वातेन खबर करीन तुंद्‌रे सातेवाळी, ईसुन मंडळी वाटे एक चिट्‌ठी लिखलु। बाकुन तीनी चिट्‌ठी वाळु दीयुतीरफ्‌यु हामरी वात सामळने नी हींडे; चु ते आखा सी मटु बणने हींडे, ने ईसु काजे हामरी वातेन खबर नी पुगाड़्‌यु। <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />तेरेमां मे जत्‌यार आवीस, ती तेरा करला कामेन बारामां मे तीनाक हेर कराड़ीस, हयु हामरी नाव-बद्‌दी करसे, ने हेरेम बी चु खुस नी रवे; ने जे हामरी भायसेन आव-भाव करने हींडे, तीनुक बी चु मना करे! ने तीनुक भगवानेम सी नीकाळ देय।<verse eid="3JN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11" />ए मारा लाटेक्‌ला दुस्‌तीदार, असी कुहराय करन्‌यान तसु, तु कुहराय घुण करजी बाकुन भलाय करन्‌यान चाल धर, काहाकी जु माणुस भलाय करे, चु माणुस भगवानेन अगे सी छे। बाकुन जु कुहराय करे, चु माणुस भगवानेक नी देख्‌यु।<verse eid="3JN 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="3JN 1:12" />हाय देमेतर्‌यान बारामां सामळु, जु जां सी तारेन चां आवणे वाळु छे। देमेतीरीयुसेन बारामां आखा वारलु गवाय देदला छे। ने तेरी जीवाय ते, पुरी-पुरी छाचली सीकापण छे, ने हामु बी देमेतीरीयुस वारलु गवा देजे। ने तु जाणे की, हामु जी गवाय दी रया ची गवाय छाची छे। हेरेसी देमेतीरीयुसेन बी वारु आव-भाव करजी।<verse eid="3JN 1:12" /></para>
  <para style="s">चिट्‌ठीन आकरी वात</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />मार धड़े तार बारामां लिखणे वाटे ते बेसकी वात छे, बाकुन मे, ईनी वातेक हय अगु कागदा पर सांय ने पेन वाटे लिखणे नी हींडतु। <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />बाकुन मे छाटुस आवीन तुसेक भेळु हवणेन आस कर रयु। ने जत्‌यार मे तारेन चां आवीन तुसेक भेळु हय्‌स, तत्‌यार आपणु आंबा-सांबा वात करसु।<verse eid="3JN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15" />भगवानेन अगे सी तुहुंंक सुक सांती जड़ती रहणु चाहजे,</para>
  <para style="p" vid="3JN 1:15">ने जां वाळा दुस्‌तीदार्‌या तुहुंंक वारलु छे की? करीन पुछ रया। अतरे हामरे वाटीन चां वाळा आखा दुस्‌तीदार्‌यान नाव धरी-धरीन वारलु छे की? करीन पुछ लेजी<note caller="+" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="2JN 1:12">2 युहन्‌ना 1:12</ref></char></note>।<verse eid="3JN 1:15" /></para>
  <chapter eid="3JN 1" />
</usx>