<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1JN" style="id">- Bhilali Standard Project</book>
  <para style="h">1 युहन्‌ना</para>
  <para style="toc3">1 युहन्‌ना</para>
  <para style="toc2">1 युहन्‌ना</para>
  <para style="toc1">युहन्‌नान पेहली चिट्‌ठी</para>
  <para style="mt2">यूहन्ना की पहली पत्री</para>
  <para style="mt1">युहन्‌नान पेहली चिट्‌ठी</para>
  <para style="imt">1 युहन्‌नान बारामां</para>
  <para style="ip">1 युहन्‌नान चिट्‌ठी नेवताळान काम युहन्‌नान साहरे मसीन पयदा हवणेन पचास सी सोव सालेन ईचमां लिखी गुयली। युहन्‌नु खुद काजे लिखण्‌यान रुप मां नी उळखे, बाकुन पेहला पाठ मां देखाड़े की चु ईसुन जीवनेन मरलाम सी पछो जीवतो हवणेन एक गवा बणे। <char style="xt"><ref loc="1JN 1:1-3">1:1-3</ref></char> 1 युहन्‌ना मां लिखणेन तरीकु बी युहन्‌नान अनसारे खुस-खबर मां जड़ला लिखणेन तरीका सी घणो हीळे-मेळे। असो मानी जाय की युहन्‌नु ईफीसुस मां रवतु जाय्‌न युहन्‌ना ने तीन आक्‌सर मां 1 युहन्‌ना, 2 युहन्‌ना, 3 युहन्‌नान अनसारे खुस-खबर लिखलो हतलो।</para>
  <para style="ip">युहन्‌ना जी चिट्‌ठी आखा ईसु पर भुरसु करन्‌या काजे असी टेम मां लिखलो जत्‌यार मंडळी काजे आत्‌मान अकलेन नावेन माणसेन एक पंथ सी परेसानी हय रय। ईनु माणसे काजे माननु हतलो की ईसु पुरी तरह सी भगवान हतला बाकुन धरती पर रवता जाय्‌न चु छाचलीन सीकार ने खुनेन डील वाळा माणसे नी हतला। हेरे मतलब सी युहन्‌ना ईसुन जीवनेन गवा हवणेन बारामां लिखे ने ज्‌य की हेरे आपणे हाते काजे ईसु छीमाड़्‌यु। <char style="xt"><ref loc="1JN 1:1-3">1:1-3</ref></char> ईनी चिट्‌ठी काजे लिखणे मां युहन्‌नान उदेस हेरी खुसी काजे पुरो करनु हतलो <char style="xt"><ref loc="1JN 1:4">1 युहन्‌ना 1:4</ref></char> ईसु पर भुरसु करन्‌या काजे पाप करने सी रुकणु <char style="xt"><ref loc="1JN 2:1">1 युहन्‌ना 2:1</ref></char> ईसु पर भुरसु करन्‌या काजे झुटा सीकापण सी बचणु <char style="xt"><ref loc="1JN 2:26">1 युहन्‌ना 2:26</ref></char> ने वायदु कराड़नु की ईसु पर भुरसु करन्‌या चे बची गुयला छे। <char style="xt"><ref loc="1JN 5:13">5:13</ref> </char></para>
  <para style="iot">बाहरती वात</para>
  <para style="io1">1. युहन्‌ना आपणी चिट्‌ठीन उळखाण देय ने हीनाक लिखणेन एक उदेस देय। <char style="ior"><ref loc="1JN 1:1-4">1:1-4</ref> </char></para>
  <para style="io1">2. अळतेन चु बताड़े की भगवान कसों उजाळो छे ने हामुक ईसुन तसों जीवणु चाहजे। <char style="ior"><ref loc="1JN 1:5-3:10">1:5—3:10</ref> </char></para>
  <para style="io1">3. हेरे पछेन चु हामुक एक दीसरा सी परम करे की हुकुमेन हेर देवाड़े। <char style="ior"><ref loc="1JN 3:11-5:12">3:11—5:12</ref> </char></para>
  <para style="io1">4. चु आपणी चिट्‌ठी काजे पुरो करे। <char style="ior"><ref loc="1JN 5:13-21">5:13-21</ref> </char></para>
  <chapter number="1" style="c" sid="1JN 1" />
  <para style="s">जीवनेन बुल</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 1:1" />कळ घड़ायणे सुरु नी हयो, ने पेहलुत सी, बुल नावेन एक जणु हतलु। चु ते भगवान बास साते सरगेम हतलु, ने अळतेन माणसेन अवतार लीन हामरे ईचमां उजेंतु हयु। ने ज्‌य जीवनेन झर बी छे; हेरेसी हामु तीनाक जीवनेन बुल बी कह्‌जे। हामु जे तेरा नेवताळान काम छे, तीनाक ते देख लेदला छे, ने तेरा बुले सामळी लेदला छे, जे बुले आखा काजे अमर जीवन आपे। ईनी अमर जीवनेन वाट ते तेरे साहरे देखाव पड़ी; हामु ते धी‌यान लागाड़ीन तेरा जीवन काजे पंतार लेदला छे, ने हामरे हाते करीन तीनाक छीमी बी लेदला छे। <verse eid="1JN 1:1" /><verse number="2" style="v" sid="1JN 1:2" />ने हय हामु तेरीत गवाय देजे, तीनाक हामु डुळे देख्‌ला छे। ने तेरे साहरे जड़ली जलमेन जीवनेन परचार बी करजे। जु बचाड़न्‌यु ईसु मसीत छे। <verse eid="1JN 1:2" /><verse number="3" style="v" sid="1JN 1:3" />हव, हामु ईना ईसुक देखला, ने सामेळला छे, तेरीत खुस-खबर हामु तुहुंंक देखाड़जे। हामु ते बासेन, ने तेरा बेटा ईसु मसीन साजल्‌या रवजे। जी वात हामु एरेन करीन तुहुंंक देखाड़जे की तुहुंं बी हामरे पुठ्‌ये रवीन तींद्‌री साजल्‌या बण जावु। <verse eid="1JN 1:3" /><verse number="4" style="v" sid="1JN 1:4" />ने हामु जी वात तेरेमां तुहुंंक लिख रया, की तुंद्‌रे बारामां हामरी खुसी छे, ची खुसी पुरी हय जाय।<verse eid="1JN 1:4" /></para>
  <para style="s">भगवान वीजाळो छे</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5" />ने हामु ईसु मसी सी जी खुस-खबर सामळ्‌या, ने चीत खबर तुहुंंक बी सामळावजे, चो ज्‌य छे; की भगवान वीजाळो छे, ने तेरेमां काय बी आंदारलो नी हय। <verse eid="1JN 1:5" /><verse number="6" style="v" sid="1JN 1:6" />कदी आपणे मायन काहनाक कह्‌वे की हामु ते भगवानेन साजल्‌या छे, ने असु दावु करीन बी आंदारला सारकी कुहराय, ने पाप मां जीवे, ती चे झुटा छे, ने चे छाचाय पर चालन्‌या नी हय। <verse eid="1JN 1:6" /><verse number="7" style="v" sid="1JN 1:7" />बाकुन जसु भगवान बास वीजाळा मां रवे, तसात आपणुक बी वीजाळा मां जीवणु चाहजे मतलब भगवान बासेन तसी चुखली ने खरली जीवाय जीवणु चाहजे। असा आपणु जीवसु, ती एक दीसरान साजल्‌या बणीन रय सक्‌सु। काहाकी आपणुक आखा पापेम सी चुखा करीन आपणुक चुखला भगवानेन सात-संगात मां भेसकणे करीन भगवान बासेन पुर्‌यु ईसु मसीन लुही कामको छे।<verse eid="1JN 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1JN 1:8" />थुड़ाक माणसे कदी असा कह्‌वीन सीकाड़े, की आपणे मां पाप करनेन हर लग नी हय, ने कदी आपणु बी तींद्‌रेन तसात कहणे बाजी जाजे, ती आपणु आपसात काजे धुकु दी र्‌या, ने आपणे मां छाचाय नी हय<note caller="+" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="ISA 2:5">यसाया 2:5</ref></char></note>। <verse eid="1JN 1:8" /><verse number="9" style="v" sid="1JN 1:9" />कदी हामु आपणा-आपणा पाप काजे मान लेजे, ती भगवान बी हामरा पाप काजे माफ करने, ने हामुक आखा भुंडा काम सी चुखा करने मां भुरसा वाळु ने धरमी छे<note caller="+" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="PSA 32:5">भजन सहीता 32:5</ref>; <ref loc="PRO 28:13">नीतीवचन 28:13</ref></char></note>। <verse eid="1JN 1:9" /><verse number="10" style="v" sid="1JN 1:10" />थुड़ाक माणसे असा कय्‌न सीकाड़े, की हामु काय पाप नी कर्‌या, कदी आपणु बी तींद्‌रेन तसात कहणे बाजी जाजे, ती आपणु आपसात काजे धुकु दी र्‌या, ने आपणे मां छाचाय नी हय। ने हेरो बुल आपणा मन मां नी हय।<verse eid="1JN 1:10" /></para>
  <chapter eid="1JN 1" />
  <chapter number="2" style="c" sid="1JN 2" />
  <para style="s">ईसु हामरी मदत करे</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1" />ए मारा लाटेक्‌ला पुर्‌या-पारी, तुहुंं पाप घुण करु, हेरेन करीन मे जी आखी वात लिखणे बाजी रयु; बाकुन कांखुर मायन भुल सी कुय पाप कर देय, ती बास अगळ आपणे अगु हय्‌न आपणुक माफी आपाड़न्‌यु धरमी ईसु मसी छे। <verse eid="1JN 2:1" /><verse number="2" style="v" sid="1JN 2:2" />ने हयुत ईसु मसी आपणा पाप काजे माफ कर्‌यु; ने आपणा पापेन बादा अतरुत नी, बाकुन आखी कळीन माणसेन पाप काजे माफ कर्‌यु।<verse eid="1JN 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 2:3" />आपणु, ईसु मसी काजे जाण्‌या की नी जाण्‌या, ईनी वातेन पुरावु काय छे? कदी आपणु, तेरा हुकुम काजे मानीन जीवसुन, ती ईनी वातेन पुरावु हय जासे, की आपणु, ईसु मसीक छाचलीन जाण लेदा। <verse eid="1JN 2:3" /><verse number="4" style="v" sid="1JN 2:4" />जु कुय असु कह्‌वे की, “मे भगवान काजे जाणो।” बाकुन तेबी तारा हुकुम काजे मानीन नी जीवे, चु झुटु छे; ने तेरेमां छाचाय नी हय। <verse eid="1JN 2:4" /><verse number="5" style="v" sid="1JN 2:5" />बाकुन जु कुय तारा बुल काजे मानीन जीवे, छाचलीन चु भगवानेन परम मां पुरुन-पुरु घुळाय गुयलु छे। तेरेसी आपणुक गुयो मालुम पड़े, की चु छाचलीन ईसु मसी साते जुड़ायलु छे। <verse eid="1JN 2:5" /><verse number="6" style="v" sid="1JN 2:6" />जु कुय गुयो कह्‌वे, की मे ते ईसु मसी साते जुड़ायलु रव, ती तीना कवण्‌याक ते तसीत जीवाय जीवणु चाहजे, जसी जीवाय ईसु ईनी धरती पर जीवतेलु।<verse eid="1JN 2:6" /></para>
  <para style="s">ईसुन हुकुम जु छे; आखाक परम करु</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 2:7" />ए मारा लाटेक्‌ला साथी, मे तुहुंं काजे काय बी नवलु हुकुम नी लिखतु, बाकुन चु जुन्‌लु हुकुम जु सुरु मां तुहुंंक जड़लु छे; चो जुन्‌लो हुकुम जु बुल छे, तीनाक तुहुंं सामेळला छे। <verse eid="1JN 2:7" /><verse number="8" style="v" sid="1JN 2:8" />ती बी मे तुहुंंक नवलु हुकुम लिखणे बाजी रयु। ने ज्‌य ते ईसु मां ने तुंद्‌रे मां छाचाला कवायसे; काहाकी आंदारलो छेटे हवतो जाय र्‌यो ने खरलो वीजाळो हय झजळणे बाजी रयो।<verse eid="1JN 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 2:9" />बाकुन जु कुय जुरदीन ज्‌य कह्‌वे की मे ते वीजाळाम रय-रवीन चुखु हय गुयु, बाकुन ईसुक मान्‌या भायस भीणी खर करे, चु हय लग पापेन आंदारलात मां जी रयु। <verse eid="1JN 2:9" /><verse number="10" style="v" sid="1JN 2:10" />जु कुय, ईसुक मान्‌या भायस काजे परम करतु हय, चु छाचलीन वीजाळा मां रवे, ने चु कुय भीणी बी पापेन उत्‌तर नी बणे। <verse eid="1JN 2:10" /><verse number="11" style="v" sid="1JN 2:11" />बाकुन जु कुय, ईसुक मान्‌या भायस भीणी खर करे, चु आंदारलात मां छे, ने आंदारलात मां जीवे। ने चु ज्‌य नी जाणे की मे कां जाणे बाजी रयु, काहाकी पापेन आंदारलो तेरा जीव-आत्‌मान डुळा काजे आंधळो कर देदो।<verse eid="1JN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1JN 2:12" />ए पुर्‌या-पारी, मे तुहुंं काजे तेरेमां लिखणे बाजी रयु, की ईसुन नाव सी तुंद्‌रा पाप माफ हय गुया<note caller="+" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="PSA 25:11">भजन सहीता 25:11</ref></char></note>। <verse eid="1JN 2:12" /><verse number="13" style="v" sid="1JN 2:13" />ए आखा बासे, मे तुहुंं काजे गुयो लिखणे बाजी रयु की जु ईसु कळ नी घड़ायी, ने पेहलेन छे, तीनाक तुहुंं जुत छे, करीन वारु जाण रया। ए जुवान्‌या, मे तुहुंंक गुयो लिखणे बाजी रयु की तुहुंं ते वेरी भुतड़ा साते लड़ाय करीन तीनाक जीक लेदला छे। ए भगवानेन पुर्‌या, मे तुहुंंक अळी गुयो लिखणे बाजी रयु की तुहुंं ते सरग वाळा बासेक जाण लेदला छे।<verse eid="1JN 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1JN 2:14" />ए बासे, मे तुहुंंक तेरेमां लिखणे बाजी रयु, की जो सुरु सी छे तुहुंं हीनाक जाणी गुया। ए जुवान्‌या, मे तुहुंं काजे तेरेमां लिखणे बाजी रयु, की ताकत वाळा हय जावु, ने भगवानेन बुल तुंद्‌रे मां बणीन रवे, ने तुहुंं हीना भुतड़ा सी जीती गुया।<verse eid="1JN 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 2:15" />तुहुंं नीते कळी सी ने नी कळीन चीजो सी परम राखु कदी कुय कळी सी परम राखे, ती तेरेमां बासेन परम नी हय।<verse eid="1JN 2:15" /></para>
  <para style="s">कुहर्‌या भुतड़ान वगे सी जड़नी, कळीन आखी वातेक परम मां, करु</para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 2:16" />काहाकी ज्‌य काय कळी मां छे, मतलब डीलेन लालच, ने डुळान लालच ने जीवणेन चीजेन मटाय, चु बास भीणी सी नी हय, बाकुन कळीत भीणी सी छे<note caller="+" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="ROM 13:14">रोमीयो 13:14</ref>; <ref loc="PRO 27:20">नीतीवचन 27:20</ref></char></note>। <verse eid="1JN 2:16" /><verse number="17" style="v" sid="1JN 2:17" />कळी ने हेरी लालच दुयु सर जासे, बाकुन जे भगवानेन मरजी पर चालसे, चु जलम बणीन रवसे।<verse eid="1JN 2:17" /></para>
  <para style="s">ईसु मसीन वीरुद करन्‌या माणसेन वात मां मानु</para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 2:18" />ए मारा लाटेक्‌ला पुर्‌या-पारी, जी आकरी टेम छे, ने जसा तुहुंं सामेळला छे, की मसीन वीरुदी आवणे वाळा छे, हेरे अनसारे हय बी बेसका मसीन वीरुदी उठसे; हेरसी हामु जाणजे, की जी आकरी टेम छे। <verse eid="1JN 2:18" /><verse number="19" style="v" sid="1JN 2:19" />चे नीकळ्‌या ते हामरे मां सी, बाकुन हामरे मां सी नी हतला; काहाकी कदी चे हामरे मां सी रवता, ती हामरे साते रवता, बाकुन नीकळी हेरसी गुया काहाकी ज्‌य उजेंतो हवे की चे आखा हामरे मां सी नी हय।<verse eid="1JN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 2:20" />ने तुहुंं काजे भगवानेन चुखली-आत्‌मा आपली छे, तेरेमां तुहुंं आखा छाचाय जाणु। <verse eid="1JN 2:20" /><verse number="21" style="v" sid="1JN 2:21" />मे तुहुंंक हेरसी नी लिख्‌यु, की तुहुंं छाचाय काजे नी जाणु, बाकुन हेरसी, की तुहुंं हीनाक जाणु, ने हेरसी की कुय झुट छाचाय भीणी सी नी हय।<verse eid="1JN 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1JN 2:22" />लुच्‌चु कुण छे? चु, जु ईसु मसीन हवणेन नीकारु करे; ने मसीन वीरुदी हयुत छे, जु बासेन ने पुर्‌याक नीकारु करे। <verse eid="1JN 2:22" /><verse number="23" style="v" sid="1JN 2:23" />जु कुय पुर्‌याक नीकारु हेरे धड़े बास बी नी हय जु पुर्‌या काजे मानी लेय, हेरे धड़े बास बी छे।<verse eid="1JN 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1JN 2:24" />ज्‌य काय तुहुंं सुरु सी सामेळला छे हयुत तुंद्‌रे मां बणीन रवसे; ज्‌य तुहुंं सुरु सी सामळ्‌या, कदी चु तुंद्‌रे मां बणीन रवे, ती तुहुंं बी पुर्‌या मां, ने बास मां बणीन रवसु। <verse eid="1JN 2:24" /><verse number="25" style="v" sid="1JN 2:25" />ने तेरेसी हयु हामरे सी वायदु कर्‌यु चु जलम जीवसे।<verse eid="1JN 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1JN 2:26" />मे जी बात तुहुंंक हींद्‌रे बारामां लिख्‌यु, जे तुहुंंक भुलवाड़े करीन नी। <verse eid="1JN 2:26" /><verse number="27" style="v" sid="1JN 2:27" />ने तुंद्‌रे वाटे मसी हेरी चुखली-आत्‌मा आप देदु, ज्‌य हेरे भीणी सी करलो छे, ने तुंद्‌रे मां बणीन रवे; ने तुहुंंक हेरो मतलब नी हय, की कुय तुहुंंक सीकाड़े, बाकुन जसों हयु हेरी आत्‌मा आप देदु ज्‌य हेरे भीणी सी करलो छे तुहुंंक आखी वात सीकाड़े, ने ज्‌य छाचो छे, ने झुटो नी हय ने जसु चु तुहुंंक सीकाड़्‌यु असात तुहुंं हेरे मां बणीन रवु।<verse eid="1JN 2:27" /></para>
  <para style="s">आपणु भगवानेन अवल्‌यात छे</para>
  <para style="p">
    <verse number="28" style="v" sid="1JN 2:28" />अळतेन ए भगवानेन पुर्‌या, हेरेमां बणीन रवु, की जत्‌यार चु उजेंतु हवे, ती हामुक हिम्‌मत हवे, ने हामु हेरे आवणे पर हेरे अगळ सरमायजे नी। <verse eid="1JN 2:28" /><verse number="29" style="v" sid="1JN 2:29" />कदी तुहुंं जाणु, की ईसु भगवान धरमी छे, ती ज्‌य बी जाणु, की जु कुय धरमीन काम करे, चु भगवानेन पुर्‌या-पारी बण गुया।<verse eid="1JN 2:29" /></para>
  <chapter eid="1JN 2" />
  <chapter number="3" style="c" sid="1JN 3" />
  <para style="s">हामु भगवानेन पुर्‌या छे</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1" />देखु, बास हामरे सी कसु परम कर्‌यु, की हामु भगवानेन अवल्‌यात कवाया, ने हामु छे बी; हेरे वजे सी कळीन माणसे हामुक नी जाणता, काहाकी कळीन माणसे भगवान काजे बी नी जाणे। <verse eid="1JN 3:1" /><verse number="2" style="v" sid="1JN 3:2" />ए लाटेक्‌ला साथी, हय हामु भगवानेन अवल्‌यात छे, ने हय लग उजेंतो नी हयो, की हामु काय नी हवसुन! अतरो जाणजे, की जत्‌यार ईसु मसी उजेंतु हवसे ती हामु बी हेरेन तसा रवसुन, काहाकी हामु हेरेन असुत देखसुन जसु चु छे। <verse eid="1JN 3:2" /><verse number="3" style="v" sid="1JN 3:3" />ने जे कुय हेरे पर जी आस राखे, चु आपणे आप काजे बी असुत चुखु करे, जसु मसी चुखलु छे।<verse eid="1JN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 3:4" />जु कुय पाप करे, चु मुसान साहरे लिखला कायदान वीरुद करे; ने पाप ते कायदान वीरुद मां छे। <verse eid="1JN 3:4" /><verse number="5" style="v" sid="1JN 3:5" />ने तुहुंं जाणु, की ईसु मसी हेरसी उजेंतु हयु, की पाप काजे सार देय; ने हेरेमां काय पाप नी हय। <verse eid="1JN 3:5" /><verse number="6" style="v" sid="1JN 3:6" />जु कुय मसी मां बणीन रवसे, चु पाप नी करे; जु कुय पाप करे, चु नी ते हीनाक देख्‌यु, ने नी हीनाक जाण्‌यु।<verse eid="1JN 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 3:7" />लाटेक्‌ला पुर्‌या, काहालाकेन भुलवाड़ मां घुण आवु; जु धरमीन काम करे, हयुत हेरेन तसु धरमी छे। <verse eid="1JN 3:7" /><verse number="8" style="v" sid="1JN 3:8" />जु कुय पाप करे, चु भुतड़ा भीणी सी छे, काहाकी भुतड़ु सुरु सी पाप करतु आवलु छे। भगवानेन पुर्‌यु हेरसी उजेंतु हयु की भुतड़ान काम काजे खत्‌तम कर देय।<verse eid="1JN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 3:9" />जु कुय भगवान सी पयदा हयु चु पाप नी करे; काहाकी भगवानेन बीज हेरेमां बणीन रवे; ने चु पाप करी नी सके, काहाकी चु भगवान सी पयदा हयु। <verse eid="1JN 3:9" /><verse number="10" style="v" sid="1JN 3:10" />हेरसी भगवानेन अवल्‌यात, ने भुतड़ान अवल्‌यात जाणी जाय; जे कुय धरमीन काम नी करे, चु भगवान सी नी, ने नी चु जु आपणा भायस सी परम नी राखे।<verse eid="1JN 3:10" /></para>
  <para style="s">एक दीसरा सी परम राखु</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11" />काहाकी जु खबर तुहुंं सुरु सी सामळ्‌या, चो ज्‌य छे, की हामु एक दीसरा सी परम राखजे। <verse eid="1JN 3:11" /><verse number="12" style="v" sid="1JN 3:12" />ने केनेन तसा मां बणु, जु हीना भुतड़ा सी हतलु, ने चु आपणा भायसेक मार नाखलु। ने हीनाक कसु मारलु? हेरसी की हेरा काम भुंडा हतला, ने हेरु भायसेन काम धरमी हतलो।<note caller="+" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="PSA 38:20">भजन सहीता 38:20</ref></char></note><verse eid="1JN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 3:13" />ए भायस्‌यो, कदी कळीन माणसे तुंद्‌रे सी कुहराय करे ती चकरायु घुण। <verse eid="1JN 3:13" /><verse number="14" style="v" sid="1JN 3:14" />हामु जाणजे, की हामु मरलाम सी जीवता हयन जीवन मां पुग्‌या; काहाकी हामु भायसे सी परम राखजे जु परम नी राखे, चु मरलान तसु रवे। <verse eid="1JN 3:14" /><verse number="15" style="v" sid="1JN 3:15" />जु कुय आपणा भायस सी कुहराय राखे, चु हत्‌यारु छे; ने तुहुंं जाणु, की काहालाक हत्‌यारा मां जलमेन जीवन नी रवे। <verse eid="1JN 3:15" /><verse number="16" style="v" sid="1JN 3:16" />हामु परम हेरेसी जाण्‌या, की मसी आपणे वाटे आपसान जीव आप देदु; ने हामुक बी भायस्‌यो वाटे जीव आपणु चाहजे। <verse eid="1JN 3:16" /><verse number="17" style="v" sid="1JN 3:17" />बाकुन तीना काहानाक धड़े कळीन धन रवे ने चु आपणा भायस काजे जरुवत मां देखीन हेरे पर तरस नी खाणे चाहे, ती हेरेमां भगवानेन परम कसु बणीन रय सके?<note caller="+" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="DEU 15:7">वेवस्‌थावीवरन 15:7</ref>,<ref loc="DEU 15:8">8</ref></char></note> <verse eid="1JN 3:17" /><verse number="18" style="v" sid="1JN 3:18" />ए मारा लाटेक्‌ला पुर्‌या, हामु बुल ने जीप सी नी, बाकुन काम ने छाचाय्‌न साहरे बी परम करनु चाहजे।<verse eid="1JN 3:18" /></para>
  <para style="s">भगवान अगळ दुवा करने मां हिम्‌मत करु</para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 3:19" />हेरसी हामु जाणसुन, की हामु छाचला छे; ने जीनी बात मां हामरो मन हामुक गुनु आपसे, हेरे बारामां हामु हेरे अगळ आपणा मन मां हिम्‌मत दी सकजे। <verse eid="1JN 3:19" /><verse number="20" style="v" sid="1JN 3:20" />ने कदी गलत करजे ती हामुक रुके, काहाकी भगवान हामरे मन सी मटु छे; ने आखो काय जाणे। <verse eid="1JN 3:20" /><verse number="21" style="v" sid="1JN 3:21" />ए लाटेक्‌ला, कदी हामरो मन हामुक गुनु नी लागाड़े ती हामु भगवान अगळ हामुक हिम्‌मत बणीन रवे। <verse eid="1JN 3:21" /><verse number="22" style="v" sid="1JN 3:22" />ने ज्‌य काय हामु मांगजे, चो हामुक हेरसी जड़्‌यो; काहाकी हामु हेरा हुकुम काजे माने; ने ज्‌य हीनाक भावे चत करजे। <verse eid="1JN 3:22" /><verse number="23" style="v" sid="1JN 3:23" />ने हेरु हुकुम ज्‌य छे की हामु हेरा पुर्‌या ईसु मसीन नाव पर भुरसु करजे ने जसु हयु हामुक हुकुम आप्‌यु हेरे अनसारे एक दीसरा सी परम राखे। <verse eid="1JN 3:23" /><verse number="24" style="v" sid="1JN 3:24" />ने जु भगवानेन हुकुम काजे माने, चु हेरेमां, ने भगवान हींद्‌रे मां बणीन रवे। ने हेरसी, मतलब हयु चुखली-आत्‌मा सी जु हयु हामुक आपलु छे, हामु जाणजे, की चु हामरे मां बणीन रवसे।<verse eid="1JN 3:24" /></para>
  <chapter eid="1JN 3" />
  <chapter number="4" style="c" sid="1JN 4" />
  <para style="s">जीव-आत्‌मा काजे पारखु</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1" />ए लाटेक्‌ला साथी, आखी भातीन आत्‌मान भुरसु मां करु, बाकुन आत्‌मा काजे पारखु, की चे भगवान भीणी सी छे की नी हय; काहाकी बेसका लुच्‌चा अघी सी आवणे वाळी बात देखाड़न्‌या ईनी कळी मां नीकळीन आय गुयला छे। <verse eid="1JN 4:1" /><verse number="2" style="v" sid="1JN 4:2" />भगवानेन आत्‌मा काजे तुहुंं हीनी रीत सी उळखी लेसु, की जी कुय आत्‌मा मान लेय, की ईसु मसी माणसेन पुर्‌यु बणीन धरती पर आवलु छे, चु भगवान भीणी सी छे। <verse eid="1JN 4:2" /><verse number="3" style="v" sid="1JN 4:3" />ने जी कुय आत्‌मा ईसु काजे नी माने, ची भगवान भीणी सी नी हय; जी मसीन वीरुदी आत्‌मा छे; जेरी बात वीच्‌यार तुहुंं सामळी लेदला छे, की चु आवणे वाळु छे ने हय बी जागा मां छे।<verse eid="1JN 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 4:4" />ए लाटेक्‌ला पुर्‌या, तुहुंं भगवानेन छे ने हीनु आत्‌मा काजे जीती गुयला छे; काहाकी जु तुंद्‌रे मां छे, चु कळी पर मटु छे। <verse eid="1JN 4:4" /><verse number="5" style="v" sid="1JN 4:5" />झुटी वात सीकाड़न्‌या, जे माणसे ईनी कळी मायन छे, ने अळी जे भगवानेन वीरुद करन्‌या ईनी कळीन वीच्‌यारेन तसा वात करे ने सीकाड़े। ने ईनी कळीन वीच्‌यारेम रहण्‌या माणसे हींद्‌री झुटी वाट सामळीन माने। <verse eid="1JN 4:5" /><verse number="6" style="v" sid="1JN 4:6" />बाकुन हामु ते भगवानेन नेवताळान काम छे। हेरेसी जतरा बी भगवान काजे जाणे, चे हामरी वात सामळी लेसे; ने मान लेसे, ने जे भगवान काजे बी नी जाणे तीनुक हामरी वात उळखाये बी नी ने मानाये बी नी। हीनी रीती सी आपणु भगवानेन चुखला जीव-आत्‌मा काजे ने माणसेक भंगलाड़ने वाळी आत्‌मा काजे पारखीन उळखी लेसु।<verse eid="1JN 4:6" /></para>
  <para style="s">भगवान परम छे</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7" />ए लाटेक्‌ला साथी, आपणु एक दीसरा सी परम राखु; काहाकी परम भगवान सी छे ने जु कुय परम करे, चु भगवान सी पयदा हयु, ने भगवान काजे जाणु। <verse eid="1JN 4:7" /><verse number="8" style="v" sid="1JN 4:8" />जु परम नी राखे चु भगवान काजे नी जाणे, काहाकी भगवान परम छे। <verse eid="1JN 4:8" /><verse number="9" style="v" sid="1JN 4:9" />भगवान हामरे पर असु परम राख्‌यु, चु हेरेसी उजेंतो हयो की भगवान आपणा एक खुळ्‌या पुर्‌या काजे जागा मां मकेल्‌लु छे की हामु हेरे साहरे जीवाय जीवसु। <verse eid="1JN 4:9" /><verse number="10" style="v" sid="1JN 4:10" />भगवानेन परमेन बदले, आपणु बी भगवान काजे परम करजे बाकुन तेबी परम करनेन खरलु दाखलु आपणु जु परम नी हय, खरलु परम असु उजेंतु हयु की भगवान आपसा पुर्‌या काजे आपणा पापेन माफी वाटे मरीन बादा छुटणे करीन ईनी कळीम मकली देदु।<verse eid="1JN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 4:11" />ए मारा लाटेक्‌ला साथी, जत्‌यार भगवान हामरे सी असु परम कर्‌यु, ती हामुक बी एक दीसरा सी परम करनु चाहजे। <verse eid="1JN 4:11" /><verse number="12" style="v" sid="1JN 4:12" />भगवान काजे कदी कुय नी देख्‌या, कदी हामु एक दीसरा सी परम राखसुन, ती भगवान हामरे मां बणीन रवे; ने हेरु परम हामरे मां पुरु हवे।<verse eid="1JN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 4:13" />हव भगवान आपसा चुखला जीव-आत्‌मा काजे आपणा जीवेम वसणे करीन मकली देदु, ने भगवानेन जु चुखलु जीव-आत्‌मा, आपणेम रय्‌न आपणा परमेक पाक्‌कु करनेन काम करने बाजी रयु। ईना कामेन साहरे आपणुक ईनी वातेन सबुत जड़े की, भगवान आपणे मां रवे, ने आपणु भगवान मां रवजे। <verse eid="1JN 4:13" /><verse number="14" style="v" sid="1JN 4:14" />ने हामु देखी बी लेदा ने गवाय देजे की बास पुर्‌या काजे कळीन छुटकारु करने करीन मकल्‌यु। <verse eid="1JN 4:14" /><verse number="15" style="v" sid="1JN 4:15" />जु कुय ज्‌य मानी लेय, की ईसु भगवानेन पुर्‌यु छे भगवान हेरेमां बणीन रवे, ने चु भगवान मां। <verse eid="1JN 4:15" /><verse number="16" style="v" sid="1JN 4:16" />ने ज्‌य परम भगवान हामरे सी राखे; हीनाक हामु जाणी गुया, ने हामुक हेरे पर भुरसु छे।</para>
  <para style="p" vid="1JN 4:16">भगवान परम छे; जे परम मां बणीन रवे चु भगवान मां बणीन रवे; ने भगवान हेरेमां बणीन रवे। <verse eid="1JN 4:16" /><verse number="17" style="v" sid="1JN 4:17" />हेरसी परम हामरे मां पुरो हयो, की हामु नीयावेन दाहड़े हिम्‌मत राखजे; काहाकी जसु चु छे, असोत कळी मां बी छे। ने मसीन जीवनेन तसु छे। <verse eid="1JN 4:17" /><verse number="18" style="v" sid="1JN 4:18" />परम मां डर नी हय, बाकुन पुरु हवलु परम धाक काजे छेटु कर देय, काहाकी बीहणेन नातो डंड सी हवे, ने जु बीही जाय, चु परम मां पुरु नी हवे।<verse eid="1JN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 4:19" />हामु हेरसी परम करजे, काहाकी पेहल भगवान हामरे सी परम कर्‌यु। <verse eid="1JN 4:19" /><verse number="20" style="v" sid="1JN 4:20" />कदी कुय कवे, “मे भगवान सी परम राखो,” ने आपणे भायस सी कुहराय राख; ती चु लुच्‌चु छे; काहाकी जु आपणे सी, तीनाक चु देख्‌यु, चु परम नी राखे, ती चु भगवान सी बी तीनाक हयु नी देख्‌यु, परम नी राख सके। <verse eid="1JN 4:20" /><verse number="21" style="v" sid="1JN 4:21" />ने हेरसी हामुक ज्‌य हुकुम जड़्‌यु, की जु कुय आपणा भगवान सी परम राखे, चु आपणा भायस सी बी परम राखे।<verse eid="1JN 4:21" /></para>
  <chapter eid="1JN 4" />
  <chapter number="5" style="c" sid="1JN 5" />
  <para style="s">भुरसान साहरे कळी पर जीक</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1" />जु कुय भुरसु करे की ईसुत मसी छे, चु भगवान अवल्‌यात बण जाय ने जु कुय पयदा करने वाळा सी परम राखे, चु हेरसी बी परम राखे, जु हेरसी पयदा हयु। <verse eid="1JN 5:1" /><verse number="2" style="v" sid="1JN 5:2" />जत्‌यार हामु भगवान सी परम राखजे, ने हेरा हुकुम काजे मांजे, ती हेरसी हामु ज्‌य जाणी लेजे, की हामु भगवानेन अवल्‌यात सी परम राखजे। <verse eid="1JN 5:2" /><verse number="3" style="v" sid="1JN 5:3" />काहाकी भगवानेन परम ज्‌य छे, की हामु हेरा हुकुम काजे मानजे; ने हेरा हुकुम भारो नी लागे।<note caller="+" style="x"><char style="xo" closed="false">5:3 </char><char style="xt" closed="false"><ref loc="MAT 11:30">मत्‌ती 11:30</ref></char></note> <verse eid="1JN 5:3" /><verse number="4" style="v" sid="1JN 5:4" />काहाकी ज्‌य काय भगवान सी पयदा हयो, चो कळी सी जीत हात कर लेदा, ने ची जीत तीनाक कळी पर जीत हात हवे ज्‌य हामरु भुरसु छे। <verse eid="1JN 5:4" /><verse number="5" style="v" sid="1JN 5:5" />कळी पर जीत हात करने वाळो कुण छे? सीरप चु तेरु भुरसु छे, की ईसु, भगवानेन पुर्‌यु छे।<verse eid="1JN 5:5" /></para>
  <para style="s">ईसु मसी पर भुरसु करनेन बारे मां आपणे धड़े काय-काय गवाय छे?</para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 5:6" />ज्‌य हयुत छे, जु पाणी ने लुहीन साहरे आवलु हतलु; मतलब ईसु मसी चु नी सीरप पाणीन साहरे, बाकुन पाणी ने लुही दुयुन साहरे आवलु हतलु। ने जी आत्‌मा छे ज्‌य गवाय देय, काहाकी आत्‌मा छाचली छे। <verse eid="1JN 5:6" /><verse number="7" style="v" sid="1JN 5:7" />ने असा करीन गवाय देणेवाळा तीन छे। <verse eid="1JN 5:7" /><verse number="8" style="v" sid="1JN 5:8" />आत्‌मा, पाणी ने लुही; ने तीनु एकुत वात पर मुजगी छे। <verse eid="1JN 5:8" /><verse number="9" style="v" sid="1JN 5:9" />जत्‌यार हामु माणसेन गवाय मानी लेजे, ती भगवानेन गवाय ते हेरसी अदीन छे; ने भगवानेन गवाय जी छे, की हयु आपणा पुर्‌यान बारामां गवाय देजे। <verse eid="1JN 5:9" /><verse number="10" style="v" sid="1JN 5:10" />चु भगवानेन पुर्‌या पर भुरसु करे, चु आपणेत मां गवाय काजे मान लेदलु छे; बाकुन चु भगवान पर भुरसु नी कर्‌यु, हयु तीनाक झुटु बणायु; काहाकी हयु तीना गवाय देण्‌या पर भुरसु नी कर्‌यु, जु भगवान आपणा पुर्‌यान बारामां आपलु छे। <verse eid="1JN 5:10" /><verse number="11" style="v" sid="1JN 5:11" />ने ची गवाय जी छे, की भगवान हामुक जलमेन जीवाय आपलु छे, ने ज्‌य जीवाय हेरा पुर्‌या मां छे। <verse eid="1JN 5:11" /><verse number="12" style="v" sid="1JN 5:12" />तेरे धड़े पुर्‌यु छे, तेरे धड़े जीवन छे; ने जेरे धड़े भगवानेन पुर्‌यु नी हय, हेरे धड़े जीवन बी नी हय।<verse eid="1JN 5:12" /></para>
  <para style="s">अमर जीवाय</para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 5:13" />मे तुहुंंक, जे भगवानेन पुर्‌यान नाव पर भुरसु करो, हेरसी लिख्‌यु की तुहुंं जाणु की जलमेन जीवन तुंद्‌रु छे। <verse eid="1JN 5:13" /><verse number="14" style="v" sid="1JN 5:14" />ने हामरु हीना भगवान पर हिम्‌मत छे की कदी हामु हेरी मरजीन अनसारे काय बी मांगजे, ती चु हामरी सामळे। <verse eid="1JN 5:14" /><verse number="15" style="v" sid="1JN 5:15" />ने जत्‌यार हामु जाणजे, की ज्‌य काय बी हामु मांगजे चु हामरी सामळे, ती ज्‌य बी जाणजे, की ज्‌य काय हामु हेरसी मांगजे, च जड़लो छे।<verse eid="1JN 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 5:16" />कदी कुय आपणा भायस ने बहण्‌स्‌या काजे असु पाप करतेलु देखे, तेरो फळ मरनु नी हवे, ती लीलघाये, ने भगवान हीनाक हींद्‌रे वाटे, जु असु पाप कर्‌यु जेरो फळ मरनु नी हवे, जीवन आपसे। पाप असु बी हवे तेरो फळ मरनु हवे हेरे बारामां मे लीलघायणे वाटे नी कवो। <verse eid="1JN 5:16" /><verse number="17" style="v" sid="1JN 5:17" />आखी भातीन भुंडा काम ते पाप छे, बाकुन असु पाप बी रवे, जु पाप जीव-आत्‌मान मुत भीणी नी ली जाय। असला पापेन माफी वाटे दुवा करनु भगवानेन मरजी छे।<verse eid="1JN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 5:18" />हामु जाणजे, की जु कुय भगवान सी पयदा हयु, चु पाप नी करे; बाकुन जु भगवान सी पयदा हयु, हीनाक चु बचाड़ीन राखे, ने चु भुतड़ु हीनाक धरी नी सके।<verse eid="1JN 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 5:19" />हामु जाणजे, की हामु भगवान सी छे, ने आखी कळी हीना भुतड़ान हक मां पड़ रय।<verse eid="1JN 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 5:20" />ने ज्‌य बी जाणजे, की भगवानेन पुर्‌यु आय गुयु ने हयु हामुक अक्‌कल आपलु छे, की हामु हीना छाचला काजे उळखजे, ने हामु हेरेमां ज्‌य छाचलीन छे, मतलब हेरा पुर्‌या ईसु मसी मां रवजे। छाचलु भगवान ने जलमेन जीवन हयुत छे।<verse eid="1JN 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 5:21" />ए पुर्‌या, आपणे आप काजे मुरत्‌या सी बचाड़ु।<verse eid="1JN 5:21" /></para>
  <chapter eid="1JN 5" />
</usx>