<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="SNG" style="id">- Bhilali Standard Project</book>
  <para style="h">वारलु गीत</para>
  <para style="toc3">वारलु गीत</para>
  <para style="toc2">वारलु गीत</para>
  <para style="toc1">वारलु गीत</para>
  <para style="mt2">सुलेमान का श्रेष्‍ठगीत</para>
  <para style="mt1">सुलेमानेन वारलु गीत</para>
  <para style="imt">वारलु गीतेन कितापेन उळखाण</para>
  <para style="ip">वारु गीतेन किताप इस्‌राएली परमेन गीतेन एक किताप छे, हय सके बेसका जणा सी लिखली किताप छे। हीब्‌रु मां, “वारलु गीत” बुल असों कह्‌वणेन एक तरीकु छे की ज आखा सी मटो गीत छे, जसा वातेन हीस्‌साम “राजान राजा” हेरो मतलब आखा सी मटु राजु छे, कितापेन सुरुआत राजु सुलेमानेन बारामां <char style="xt"><ref loc="SNG 1:1">1:1</ref></char> मां लिखलो छे, बाकुन हेरो मतलब असों नी हय की हयुत लिखलु छे। ज्‌य बी हय सके की किताप सुलेमान काजे ईज्‌जत करने वाटे काहनाक दीसरान साहरे लिखलो छे। अक्‌कल वाळा ने समझवाळा काजे नी मालम की किताप कत्‌यार लिखायली छे, बाकुन ज्‌य सुलेमानेन जीवणेन (970-931 ईसा पेहले) टेमे मां लिखायली हसे ने पछे कांय सुदार करली हसे।</para>
  <para style="ip">वारलु गीत वीचारीन परमेन तारीक करे। आखी किताप मां, एक अदमी ने एक बायर एक दीसरा वाटे आपणी मरजी बताड़े। कदी-कदी हींद्‌रा दुस्‌त बी लिखे ने हींद्‌री खुसी मां भेसकाये <char style="xt"><ref loc="SNG 1:8">1:8</ref></char> बेसका अक्‌कल वाळा ने समझवाळा हीनी वात सी हव मां हव छे की कितापेन ची वाते <char style="xt"><ref loc="SNG 8:5-7">8:5-7</ref></char> मां जड़े। चां बायर कह्‌वे की परम मुतेन तसी ताकत वाळी छे। परम आखा सी काठी चीज छे जेरेमां हामु जाणी सकसे ने ईनाक रुक नी सक्‌जे, जसी मुत। हय सके जीत वजे छे की बायर तीन कावा चेतावणी बी देय की माणसे काजे ठेहरावली टेम सी पेहल परम काजे नी जागाड़नु चाहाजे। <char style="xt"><ref loc="SNG 2:7">2:7</ref>; <ref loc="SNG 3:5">3:5</ref>; <ref loc="SNG 8:4">8:4</ref> </char></para>
  <para style="iot">बाहरती वात</para>
  <para style="io1">1. कितापेन लायन आपली छे। <char style="ior"><ref loc="SNG 1:1">1:1</ref> </char></para>
  <para style="io1">2. खास वातेन पछे, पेहलो गीत। <char style="ior"><ref loc="SNG 1:2-2:7">1:2—2:7</ref></char></para>
  <para style="io1">3. दीसरो गीत। <char style="ior"><ref loc="SNG 2:8-3:5">2:8—3:5</ref></char></para>
  <para style="io1">4. तीसरो गीत। <char style="ior"><ref loc="SNG 3:6-5:1">3:6—5:1</ref></char></para>
  <para style="io1">5. चवथो गीत। <char style="ior"><ref loc="SNG 5:2-6:3">5:2—6:3</ref></char></para>
  <para style="io1">6. पांचवो गीत। <char style="ior"><ref loc="SNG 6:4-8:4">6:4—8:4</ref></char></para>
  <para style="io1">7. आकरी मां, छटवो गीत। <char style="ior"><ref loc="SNG 8:5-14">8:5—8:14</ref></char></para>
  <chapter number="1" style="c" sid="SNG 1" />
  <para style="p">
    <verse number="1" style="v" sid="SNG 1:1" />जे वारलु-गीत, राजा सुलेमानेन साहरे लिखलो छे।<note caller="+" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="1KI 4:32">1 राजा 4:32</ref> </char></note><verse eid="SNG 1:1" /></para>
  <para style="s">पेहलो गीत</para>
  <para style="sp">लाडी</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 1:2" />कतरो वारु रवतो! जत्‌यार चु मारे गाले गुळा देतु!</para>
  <para style="q2" vid="SNG 1:2">काहाकी तेरु मंग ते अंगुरेन रस सी बी बेसको वारु छे।<verse eid="SNG 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 1:3" />तारे भाती-भातीन ईत्‌तरेन गंद बेसको वारु छे,</para>
  <para style="q2" vid="SNG 1:3">तारो नाव ते रेचवला ईत्‌तर बराबर छे;</para>
  <para style="q2" vid="SNG 1:3">तेरेमां कुवारली पुरे तार सी परम करे।<verse eid="SNG 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 1:4" />मेसेक मनवी ले; हामु तार पछळ दवेड़सुन।</para>
  <para style="q2" vid="SNG 1:4">राजु मेसेक आपसा कमरा मां ली आवलु छे।</para>
  <para style="q1" vid="SNG 1:4">हामु तारेम खुस ने मजा मां रवसु; हामु अंगुरेन रस सी वदु तार सी परम करसु,</para>
  <para style="q2" vid="SNG 1:4">तेरेसी अदु तारा बारामां कवसुन;</para>
  <para style="q2" vid="SNG 1:4">ची कुवारली पुरे तार सी परम करे।<verse eid="SNG 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 1:5" />ओ यरुसलेम सहरेन पुरे,</para>
  <para style="q2" vid="SNG 1:5">मे काळी ते छे, बाकुन बेसकी वारु छे,</para>
  <para style="q2" vid="SNG 1:5">मे केदार अवल्‌यातेन तम्‌बान तसी ने सुलेमानेन बंगलान पड़दान तसी छे।<verse eid="SNG 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 1:6" />मे सावळा रंगेन छे करीन मेसेक एक हेट्‌यु मां भाळे,</para>
  <para style="q2" vid="SNG 1:6">काहाकी मे तपेन सेक मां काळी पड़ गुयली छे।</para>
  <para style="q1" vid="SNG 1:6">मारी मायन पुर्‌या मारे सी खुस नी हतला।</para>
  <para style="q2" vid="SNG 1:6">चे मेसेक अंगुरेन वाड़ीन राखवाळी करने मेक देदा;</para>
  <para style="q2" vid="SNG 1:6">बाकुन मे मारीत अंगुरेन वाड़ीन राखवाळी नी करी!<verse eid="SNG 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 1:7" />ए मारा जीव सी वदु लाटेक्‌ला, मेसेक देखाड़,</para>
  <para style="q2" vid="SNG 1:7">तु तारा गाडरा-बुकड़ा कां चारे,</para>
  <para style="q2" vid="SNG 1:7">खराय्‌न दाहड़े तु गाडरा-बुकड़ान गुठाण कां बठाड़े;</para>
  <para style="q1" vid="SNG 1:7">मे तारी सांतीन गाडरा-बुकड़ा धड़्‌ये</para>
  <para style="q2" vid="SNG 1:7">घुमतु पांघरीन काहा फीर्‌या करो?<verse eid="SNG 1:7" /></para>
  <para style="sp">लाडु</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 1:8" />ओ आखा बायराम सी वदु वारु,</para>
  <para style="q1" vid="SNG 1:8">कदी तुसेक मालम नी हय,</para>
  <para style="q2" vid="SNG 1:8">ती गाडरा-बुकड़ान पायरे-पायरे जां,</para>
  <para style="q2" vid="SNG 1:8">ने गुवाळ्‌यान तम्‌बा धड़्‌ये आपसा गाडरा बुकड़ान गीदल्‌या चार।<verse eid="SNG 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 1:9" />ओ मारी लाटेकली, मे तुसेक फीरोन राजान,</para>
  <para style="q2" vid="SNG 1:9">घुड़ा-गाडी मां जुपली घुल्‌ली साते बराबर करलु छे।<verse eid="SNG 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 1:10" />तारा कान्‌या गालेन्‌चां आय रवे ती तारा गाल बेसका वारु देखाये,</para>
  <para style="q2" vid="SNG 1:10">ने तारा गळा मां हीरान माळा।<verse eid="SNG 1:10" /></para>
  <para style="sp">लाडी</para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 1:11" />हामु तार वाटे चांदीन फुले वाळु,</para>
  <para style="q2" vid="SNG 1:11">सनान माळु बणावसु।<verse eid="SNG 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 1:12" />जत्‌यार राजु बठी रवलु,</para>
  <para style="q2" vid="SNG 1:12">मारो ईत्‌तर आखी दुर गंदायणे बाजी रवलो।<verse eid="SNG 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 1:13" />मारु लाटेक‌लु, मार वाटे लुबानेन थयलिन तसु छे।</para>
  <para style="q2" vid="SNG 1:13">जी थयलि मारा छातीन ईचमां पड़ी रवतेली।<verse eid="SNG 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 1:14" />मारु लाटेकलु, मारे वाटे मेहंदीन फुलेन तसु छे।</para>
  <para style="q2" vid="SNG 1:14">जी मेहंदी एनगदीन<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="ft" closed="false">मरला समुदरेन बुडवणी धड़े</char></note> अंगुरेन वाड़ी मां रवे।<verse eid="SNG 1:14" /></para>
  <para style="sp">लाडु</para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 1:15" />तु बेसकी वारु छे, ओ मारी लाटेकली, तु बेसकी वारु छे;</para>
  <para style="q2" vid="SNG 1:15">तारा डुळा पेरवीन तसा छे।<verse eid="SNG 1:15" /></para>
  <para style="sp">लाडी</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 1:16" />ए मारा लाटेकला,</para>
  <para style="q2" vid="SNG 1:16">तु बेसकु वारु ने गमे असु छे।</para>
  <para style="q1" vid="SNG 1:16">ने नीळ्‌ळु चारु हामरो आथेरनु रवसे;<verse eid="SNG 1:16" /></para>
  <para style="q2">
    <verse number="17" style="v" sid="SNG 1:17" />आपणा घरेन धारण देवदारेन छे,</para>
  <para style="q2" vid="SNG 1:17">ने आपणा घरेन छतेन डांडा सनोवर झाड़कान छे।<verse eid="SNG 1:17" /></para>
  <chapter eid="SNG 1" />
  <chapter number="2" style="c" sid="SNG 2" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 2:1" />मे सारोन गुलाब छे,</para>
  <para style="q2" vid="SNG 2:1">ने बयड़ा घाटीन सोसन फुल छे।<verse eid="SNG 2:1" /></para>
  <para style="sp">लाडु</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 2:2" />जसो सोसन फुल काटाळ्‌या झाड़कान ईचमां रवे,</para>
  <para style="q2" vid="SNG 2:2">तसीत मारी लाटेक‌ली, कुवारली पुरे ईचमां रवे।<verse eid="SNG 2:2" /></para>
  <para style="sp">लाडी</para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 2:3" />जसो सेवफळेन झाड़को जंगली झाड़कान ईचमां रवे,</para>
  <para style="q2" vid="SNG 2:3">तसुत मारु लाटेकलु जुवान्‌यान ईचमां छे।</para>
  <para style="q1" vid="SNG 2:3">मे तेरा साहळा तळे खुस हयन बठ गुय,</para>
  <para style="q2" vid="SNG 2:3">ने मे तेरो फळ खादी ती मेसेक गुळ्‌यो लाग्‌यो।<verse eid="SNG 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 2:4" />चु मेसेक तेरा खाणेन घर मां ली गुयु,</para>
  <para style="q2" vid="SNG 2:4">ने मार पर तेरु झंडु हालतेलु, चु परम हतलु।<verse eid="SNG 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 2:5" />मेसेक सुकला अंगुर खावाड़ीन काठी कर,</para>
  <para style="q2" vid="SNG 2:5">ने सेवफळ खावाड़ीन ताकत वाळी बणाव;</para>
  <para style="q1" vid="SNG 2:5">काहाकी मे परमेन जुर सी कमजुर छे।<verse eid="SNG 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 2:6" />बेसको वारु रवतो, जत्‌यार तारु डाखर्‌यु हात, मारा मुणका तळे रवतु,</para>
  <para style="q2" vid="SNG 2:6">ने जेवड़्‌यु हात मेसेक पुमाळतु!<verse eid="SNG 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 2:7" />ओ यरुसलेम सहरेन पुरे, मे तुहुंंक हयणान; ने हयणीन सगुन खावाड़ीन कवो,</para>
  <para style="q2" vid="SNG 2:7">जत्‌यार लगुन परम आपसुत नी जागे,</para>
  <para style="q2" vid="SNG 2:7">तत्‌यार लगुन हामु तीनाक नी जागाड़जे।<verse eid="SNG 2:7" /></para>
  <para style="s">दुसरो गीत</para>
  <para style="sp">लाडी</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 2:8" />मेसेक परम करन्‌यान बुल सामळाय रयो!</para>
  <para style="q1" vid="SNG 2:8">देखु, पलु बयड़ा पर उछेळतु-उछेळतु आवे,</para>
  <para style="q2" vid="SNG 2:8">ने बयड़ा छेकी-छेकीन आवणे बाजी रयु।<verse eid="SNG 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 2:9" />मेसेक परम करन्‌यु आयड़े,</para>
  <para style="q2" vid="SNG 2:9">ने, जु जुवान हयणान तसु छे।</para>
  <para style="q1" vid="SNG 2:9">देखु, चु हामरा भीतड़ा पछळ उबु हय रयु,</para>
  <para style="q1" vid="SNG 2:9">ने खीड़कीम रय्‌न भाळ रयु,</para>
  <para style="q2" vid="SNG 2:9">ने जाळीम रयन देखणे बाजी रयु।<verse eid="SNG 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 2:10" />मेसेक परम करन्‌यु मेसेक असु कवणे बाजी रयु,</para>
  <para style="sp" vid="SNG 2:10">लाडु</para>
  <para style="q1" vid="SNG 2:10">ओ मारी लाटेक‌ली,</para>
  <para style="q2" vid="SNG 2:10">ओ मारी घाटाळी, उठीन आवती रव।<verse eid="SNG 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 2:11" />काहाकी देख, सींग ते जाती रयो, ने पाणी बी पड़ीन जाती रयु।<verse eid="SNG 2:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="SNG 2:12" />धरती पर फुल देखाय रया,</para>
  <para style="q1" vid="SNG 2:12">चिरलान गावणेन टेम आय लागली छे,</para>
  <para style="q2" vid="SNG 2:12">ने हामरा जागा मां पेरवा आयड़ने बाजी रया।<verse eid="SNG 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 2:13" />अंजीर पाकणे बाजी गुया,</para>
  <para style="q2" vid="SNG 2:13">ने अंगुरेन वेलाम फुल आय रया; ने चे वारु गंदायणे बाजी रया।</para>
  <para style="q1" vid="SNG 2:13">ओ मारी लाटेक‌ली,</para>
  <para style="q1" vid="SNG 2:13">ओ मारी घाटा‌ळी, उठीन आवती रव।<verse eid="SNG 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 2:14" />ओ मारी पेरवी, बयड़ान खुबारामां,</para>
  <para style="q2" vid="SNG 2:14">ने गुफा मां सातायला जागा मां मेसेक तारो मुंहडो देखणी दे।</para>
  <para style="q1" vid="SNG 2:14">ने मेसेक तारो बुल सामळनी दे,</para>
  <para style="q2" vid="SNG 2:14">काहाकी तारो बुल सुवांग भराय छे,</para>
  <para style="q1" vid="SNG 2:14">ने तारो मुंहडो बेसको वारु छे।<verse eid="SNG 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 2:15" />जी नानली फुंदाळी अंगुरेन वेला रंदळी रय,</para>
  <para style="q2" vid="SNG 2:15">तीनी काजे धर ले;</para>
  <para style="q1" vid="SNG 2:15">काहाकी अंगुरेन वेलाम फुले आय रया।<verse eid="SNG 2:15" /></para>
  <para style="sp">लाडी</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 2:16" />मेसेक परम करन्‌यु मारु छे, ने मे तेरी छे।</para>
  <para style="q2" vid="SNG 2:16">चु आपसान गाडरा-बुकड़ा सोसन फुलेन ईचमां चारने बाजी रयु।<verse eid="SNG 2:16" /></para>
  <para style="q2">
    <verse number="17" style="v" sid="SNG 2:17" />जत्‌यार लग दाहड़ु नी ढळे</para>
  <para style="q2" vid="SNG 2:17">ने साहळु नांबु नी हवे, तत्‌यार लग ए मेसेक परम करन्‌या,</para>
  <para style="q1" vid="SNG 2:17">तु जुवान हयणान तसु बण,</para>
  <para style="q2" vid="SNG 2:17">जे हयण्‌या बेतेर<note caller="+" style="f"><char style="fr" closed="false">2:17 </char><char style="ft" closed="false">उबड़ खाबड़ बयड़ा</char></note> बयड़ा मां फीर्‌या करे।<verse eid="SNG 2:17" /></para>
  <chapter eid="SNG 2" />
  <chapter number="3" style="c" sid="SNG 3" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 3:1" />रातेन टेमे मे मारी खाट्‌ली पर सुय रवली,</para>
  <para style="q2" vid="SNG 3:1">मेसेक परम करन्‌या काजे मे अथीन-अथी हेरने बाजी गुय;</para>
  <para style="q2" vid="SNG 3:1">बाकुन चु मेसेक नी जड़्‌यु।<verse eid="SNG 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 3:2" />मे कय, “मे हय उठीन सहर मां,</para>
  <para style="q2" vid="SNG 3:2">ने सयड़क पर ने आड़े-धड़े पर फीरीन मेसेक परम करन्‌याक हेरीस।”</para>
  <para style="q1" vid="SNG 3:2">मे तीनाक हेरती रय,</para>
  <para style="q2" vid="SNG 3:2">बाकुन चु मेसेक नी जड़्‌यु।<verse eid="SNG 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 3:3" />जे पहरु देण्‌या सहर मां फीरतेला, चे मेसेक भेळा हया।</para>
  <para style="q2" vid="SNG 3:3">मे तीनुक पुछी, “तुहुं मेसेक परम करन्‌या काजे देख्‌या काय?”<verse eid="SNG 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 3:4" />तीनुक असी कय्‌न मे ईतरीक अगी गुय,</para>
  <para style="q1" vid="SNG 3:4">ने थुड़ीक वार हवली ने मेसेक परम करन्‌यु मेसेक जड़ गुयु।</para>
  <para style="q2" vid="SNG 3:4">ने मे तीनाक धर पाड़ी ने मे तीनाक जाणी नी देदी, जां लग की मारी माय्‌न घर मतलब मे पयदा हवली</para>
  <para style="q2" vid="SNG 3:4">चां लावता लग तीनाक जाणे नी देदी।<verse eid="SNG 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 3:5" />ओ यरुसलेम सहरेन पुरे,</para>
  <para style="q2" vid="SNG 3:5">मे तुहुंंक हयणान ने हयणीन सगुन खावाड़ीन कवाड़ो,</para>
  <para style="q2" vid="SNG 3:5">की जत्‌यार लगुन परम आपसुत नी जागे, तत्‌यार लगुन हामु तीनाक नी जागाड़जे।<verse eid="SNG 3:5" /></para>
  <para style="s">तीसरो गीत</para>
  <para style="sp">लाडी</para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 3:6" />जो काय छे कुळ्‌ळान खम्‌बान तसो, गंधरस ने लुबान सी गंदायण्‌यो,</para>
  <para style="q2" vid="SNG 3:6">ने वेपारीन आखी भातीन गंदायण्‌या मसालान बगदु चुपड़ीन,</para>
  <para style="q2" vid="SNG 3:6">बयड़ा भीणी सी आवणे बाजी रयु?<verse eid="SNG 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 3:7" />देखु! जी ते सुलेमानेन पालकी छे।</para>
  <para style="q2" vid="SNG 3:7">तेरे च्‌यारु मेर ईस्‌राएली सीपायड़ा माय्‌न</para>
  <para style="q2" vid="SNG 3:7">साहाठ जणा चाल रया।<verse eid="SNG 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 3:8" />जे आखान-आखा कमर मां तलवार बांद रया</para>
  <para style="q2" vid="SNG 3:8">ने लड़ाय मां हुनर छे।</para>
  <para style="q1" vid="SNG 3:8">तींद्‌रे मां एकेक जणु बीहीन</para>
  <para style="q2" vid="SNG 3:8">कमर मां तलवार टांग रवे।<verse eid="SNG 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 3:9" />सुलेमान राजु आपसा वाटे लबानोन झाड़कान लाकड़ान,</para>
  <para style="q2" vid="SNG 3:9">एक पालकी बणाय मांगलु छे।<verse eid="SNG 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 3:10" />हेरा खांबा चांदी सी ढाकला छे,</para>
  <para style="q2" vid="SNG 3:10">हेरे उपर सना सी थीगळा पुथल्‌या छे।</para>
  <para style="q1" vid="SNG 3:10">हेरा टकीयान रातला जामण्‌या रंगेन कापड़ा सी ढाकलो छे,</para>
  <para style="q2" vid="SNG 3:10">जेरेसी यरुसलेमेन बायरा परम सी जुड़ला छे।<verse eid="SNG 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 3:11" />ओ सीयोन सहरेन पुरे, खयड़े आय्‌न राजा सुलेमान काजे देखु।</para>
  <para style="q2" vid="SNG 3:11">चु तेरी माय पागड़ी आपली, ची पागड़ी पेहरी रयु,</para>
  <para style="q2" vid="SNG 3:11">तीनी पागड़ी काजे ची ईयावेन दाहड़े खुस हय्‌न तीनाक पेहरावली।<verse eid="SNG 3:11" /></para>
  <chapter eid="SNG 3" />
  <chapter number="4" style="c" sid="SNG 4" />
  <para style="sp">लाडु</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 4:1" />ओ मारी लाटेक‌ली, तु घाटाळी छे,</para>
  <para style="q1" vid="SNG 4:1">सय मां तु घाटाळी छे। तारा डुळा तारा कान्‌यान ईचमां पेरवीन तसा देखाये।</para>
  <para style="q1" vid="SNG 4:1">तारा कान्‌या तीनु बुकड़ान टुळान तसा छे,</para>
  <para style="q2" vid="SNG 4:1">जे बुकड़ा गीलाद बयड़ान कड़खे सुय रवे।<verse eid="SNG 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 4:2" />तारा दात तीनु कान्‌या कातेरला गाडरान तसा छे,</para>
  <para style="q2" vid="SNG 4:2">जे नदीम उंघळीन उपर आवला हय,</para>
  <para style="q1" vid="SNG 4:2">तींद्‌रेम एकेक जवळ्‌या पीला रवे।</para>
  <para style="q2" vid="SNG 4:2">तींद्‌रेम एक बी पीलो नी मर्‌यो हय।<verse eid="SNG 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 4:3" />तारा हुटड़ा ते बेसका वारु ने रातला रंगेन छे,</para>
  <para style="q2" vid="SNG 4:3">ने तारो मुंहडो गमे असो छे,</para>
  <para style="q1" vid="SNG 4:3">तारा गाल तारा मकासा पछळ अनारेन चीर्‌यान तसा देखाये।<verse eid="SNG 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 4:4" />तारु गळु दावुदेन मीनारेन तसु छे।</para>
  <para style="q2" vid="SNG 4:4">जो हत्‌यार मेलने करीन बणाय मेल्‌यो हय,</para>
  <para style="q2" vid="SNG 4:4">ने तेरे पर हजारु ढाळ्‌या टांग मेल्‌या हय, चे आखा ढाळ्‌या ते ताकतवाळान छे।<verse eid="SNG 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 4:5" />तारा दुयु छात्‌या ते, हयणीन दुय पीलान तसा देखाये,</para>
  <para style="q2" vid="SNG 4:5">असो लागे जे सोसन फुलेन ईचमां चरने बाजी रया हय।<verse eid="SNG 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 4:6" />जत्‌यार लगुन सेळी वेळाय नी आवे,</para>
  <para style="q2" vid="SNG 4:6">ने साहळु ढळीन नांबु हवतु-हवतु सरी नी जाय,</para>
  <para style="q2" vid="SNG 4:6">तत्‌यार लगुन मे गंधरसेन बयड़ा पर</para>
  <para style="q2" vid="SNG 4:6">ने लुबानेन बयड़ा पर जाती रय्‌स।<verse eid="SNG 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 4:7" />ओ मारी लाटेकली, तारो आखो डील बेसको वारु छे;</para>
  <para style="q2" vid="SNG 4:7">तारे मां काय बी खुड़ नी हय।<verse eid="SNG 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 4:8" />ओ मारी लाडी, तु मार पुठे लबानोन बयड़ा पर सी उतरीन आव।</para>
  <para style="q2" vid="SNG 4:8">तु अमाना बयड़ान चटी पर सी,</para>
  <para style="q1" vid="SNG 4:8">हय, सनीर बयड़ा ने हेरमोन बयड़ान चटी पर सी,</para>
  <para style="q2" vid="SNG 4:8">नाहरेन दरेम सी, चीतर्‌या नाहरेन बयड़े सी</para>
  <para style="q2" vid="SNG 4:8">नींगा करीन देख।<verse eid="SNG 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 4:9" />ओ मारी लाटेकली, ओ मारी लाडी, तु मारो मन मनवी लेदली छे,</para>
  <para style="q2" vid="SNG 4:9">तु ते तारी एकुत नजर सी,</para>
  <para style="q2" vid="SNG 4:9">ने तु तारा गळान एकुत हार सी मारा मनेक मनवी लेदली छे।<verse eid="SNG 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 4:10" />ओ मारी लाटेकली, ओ मारी लाडी,</para>
  <para style="q2" vid="SNG 4:10">तारो परम वारु गमे असो छे!</para>
  <para style="q1" vid="SNG 4:10">तारु परम ते अंगुरेन रस सी बी बेसकु वारु छे,</para>
  <para style="q2" vid="SNG 4:10">ने तारा ईत्‌तरेन गंद आखी भातीन गंदायण्‌या मसालान तसो छे!<verse eid="SNG 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 4:11" />ओ मारी लाडी, तारे हुटड़े सी मुहाळेन रस चुहे;</para>
  <para style="q2" vid="SNG 4:11">तारी जीप तळे मुहवाळेन रस ने दुद रवे;</para>
  <para style="q1" vid="SNG 4:11">तारा पुथल्‌यान गंद लबानोन बयड़ान तसी छे।<verse eid="SNG 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 4:12" />ओ मारी लाटेकली, मारी लाडी, एक सातायली वाड़ीन तसी छे,</para>
  <para style="q2" vid="SNG 4:12">एक दीवाल सी घेरलु बगीचु ने एक खुदेन झरनो छे।<verse eid="SNG 4:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="SNG 4:13" />तु वारु फळन्‌या अनारेन वाड़ीन तसी छे,</para>
  <para style="q1" vid="SNG 4:13">तेरेमां मेहंदी ने जटामासीन फुल बी लाग रया।<verse eid="SNG 4:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="SNG 4:14" />जटामासी, ने केसर, लुबान भात-भातीन झाड़के,</para>
  <para style="q2" vid="SNG 4:14">मुस्‌को ने दालचीनी, गंदरस,</para>
  <para style="q1" vid="SNG 4:14">ने आखा खास मसालान झाड़का छे।<verse eid="SNG 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 4:15" />तु वाड़ीन झीर छे,</para>
  <para style="q2" vid="SNG 4:15">जीवाय आपण्‌या पाणीन कुवु,</para>
  <para style="q2" vid="SNG 4:15">ने तु लबानोन बयड़े सी झीरेन तसी छे।<verse eid="SNG 4:15" /></para>
  <para style="sp">लाडी</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 4:16" />ओ अखणाव वाहळी जाग,</para>
  <para style="q1" vid="SNG 4:16">ने दखणाव वाहळी! आय जां;</para>
  <para style="q2" vid="SNG 4:16">मारी वाड़ी पर माय्‌न जां, तेरेसी तेरी गंद आखी दुर जाय।</para>
  <para style="q1" vid="SNG 4:16">मारु लाटेकलु मारी वाड़ी मां आवे,</para>
  <para style="q2" vid="SNG 4:16">ने वाड़ीन वारलु-वारलु फळ खाय।<verse eid="SNG 4:16" /></para>
  <chapter eid="SNG 4" />
  <chapter number="5" style="c" sid="SNG 5" />
  <para style="sp">लाडु</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 5:1" />ओ मारी घाटाळी, ओ मारी लाडी,</para>
  <para style="q2" vid="SNG 5:1">मे आपणी वाड़ी मां आवलु छे,</para>
  <para style="q1" vid="SNG 5:1">मे मारो गंदरस ने बलसान भेळो कर लेदु;</para>
  <para style="q2" vid="SNG 5:1">मे मुहाळेन रस भेळु छातड़ो खाय लेदु,</para>
  <para style="q2" vid="SNG 5:1">मे दुद ने अंगुरेन रस पी लेदु।</para>
  <para style="sp" vid="SNG 5:1">दुस्‌तीदारेण</para>
  <para style="q1" vid="SNG 5:1">ए दुस्‌तीदार्‌या, तुहुंं बी खावु, ए लाटेकला, पीवु, ततरो पीणे लागे ततरो पीयु!<verse eid="SNG 5:1" /></para>
  <para style="s">चवथो गीत</para>
  <para style="sp">लाडी</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 5:2" />मे सुवतेली, बाकुन मारो मन जागतेलो।</para>
  <para style="q1" vid="SNG 5:2">सामळ! मारु लाटेकलु! बारनो ठुक रयु, ने कय रयु, “ओ मारी घाटाळी,</para>
  <para style="q1" vid="SNG 5:2">ओ मारी लाटेकली, ओ मारी पेरवी,</para>
  <para style="q2" vid="SNG 5:2">ओ मारी चुखली, मार वाटे झपलु उगाड़;</para>
  <para style="q1" vid="SNG 5:2">काहाकी मारो मुणको उस्‌टा सी भीग रयो,</para>
  <para style="q2" vid="SNG 5:2">ने मारा कान्‌या राते उस्‌टान पाणी सी गीला हय गुयला।”<verse eid="SNG 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 5:3" />मे मारा पुथल्‌या छुड़ देदी,</para>
  <para style="q2" vid="SNG 5:3">मे तीना पुथल्‌याक कसी पेहरो?</para>
  <para style="q1" vid="SNG 5:3">मे ते मारा पाय धुय लेदी,</para>
  <para style="q2" vid="SNG 5:3">हय तीनु पाय काजे कादवाळा कसी करो?<verse eid="SNG 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 5:4" />मारु लाटेकलु, आपसान हात बारनान डुचाम भर देदु,</para>
  <para style="q2" vid="SNG 5:4">तत्‌यार मारो मन तेर वाटे मनवाय गुयो।<verse eid="SNG 5:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="SNG 5:5" />मे मारा लाटेकला वाटे बारनो उघाड़ने उठी,</para>
  <para style="q1" vid="SNG 5:5">तत्‌यार मारा हातेम सी गंदरस चुही पड़्‌यो,</para>
  <para style="q2" vid="SNG 5:5">ने मार आंगळ्‌ये सी चुहीन गंधरस कुंडी पर पड़्‌यो।<verse eid="SNG 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 5:6" />मे मारा परम करन्‌या वाटे बारनो उघाड़ी,</para>
  <para style="q2" vid="SNG 5:6">बाकुन मारु लाटेकलु पेहलुत चां सी जाती रयु।</para>
  <para style="q1" vid="SNG 5:6">ने मे तेरो बुल सामळने हींडतेली।</para>
  <para style="q1" vid="SNG 5:6">ने मे तीनाक हेरी, बाकुन चु नी जड़्‌यु; मे तीनाक आयड़ी,</para>
  <para style="q2" vid="SNG 5:6">बाकुन काय बी जपाप नी आप्‌यु।<verse eid="SNG 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 5:7" />सहरेम पेहरु देण्‌या मेसेक भेळा हया,</para>
  <para style="q2" vid="SNG 5:7">चे ते मेसेक ठुक्‌या ने आदमुळ्‌तु कर देदा;</para>
  <para style="q2" vid="SNG 5:7">अवारकुटेन पेहरु देण्‌या मारु चादरु हापकी लेदा,<verse eid="SNG 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 5:8" />ए यरुसलेम सहरेन पुरे, तुहुंं सगुन खाय्‌न असी कहुं,</para>
  <para style="q2" vid="SNG 5:8">कदी मारु परम करन्‌यु, तुहुंंक जड़ जासे, ती तीनाक कय देजु की,</para>
  <para style="q2" vid="SNG 5:8">तुसेक परम करने वाळी काजे, परमेन जुर सी कमजुर छे।<verse eid="SNG 5:8" /></para>
  <para style="sp">दुस्‌तीदारी</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 5:9" />ओ आखा बायरा मां सी बेसकी वारु,</para>
  <para style="q2" vid="SNG 5:9">तुसेक परम करन्‌यु, दीसरा परम करन्‌या सी</para>
  <para style="q1" vid="SNG 5:9">काहनी वातेम अलग छे?</para>
  <para style="q2" vid="SNG 5:9">तु हामुक असी सगुन काहा खावाड़ रय?<verse eid="SNG 5:9" /></para>
  <para style="sp">लाडी</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 5:10" />मेसेक परम करन्‌यु घाटाळु ने काठु,</para>
  <para style="q2" vid="SNG 5:10">चु दस हजार मां सी बी बेसकु वारु छे।<verse eid="SNG 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 5:11" />तेरो मुणको ते चुखला सोना मुजुक छे;</para>
  <para style="q2" vid="SNG 5:11">तेरा टांगायता कान्‌या ते</para>
  <para style="q2" vid="SNG 5:11">कागळान तसा काळ्‌ळा छे।<verse eid="SNG 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 5:12" />तेरा डुळा तीनु पेरवान तसा छे,</para>
  <para style="q2" vid="SNG 5:12">जे दुद मां उंघळीन नदी धड़े हारे-दुरे टुळान-टुळा बठी रया हय।<verse eid="SNG 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 5:13" />तेरा गाल जड़ी-बुटी,</para>
  <para style="q2" vid="SNG 5:13">ने मसाला सी भरली वाड़ीन तसा छे।</para>
  <para style="q1" vid="SNG 5:13">हेरा हुटड़ा चुहणे वाळी लुबान सी,</para>
  <para style="q2" vid="SNG 5:13">भीगला सोसन फुलेन तसो छे।<verse eid="SNG 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 5:14" />तेरा हात ते तीना सनान तसा छे,</para>
  <para style="q2" vid="SNG 5:14">तेरेमां मंहगली मणी बसाड़ली छे।</para>
  <para style="q1" vid="SNG 5:14">तेरो डील ते हातीन दात मां</para>
  <para style="q2" vid="SNG 5:14">नीलम सी बसाड़लो छे।<verse eid="SNG 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 5:15" />तेरा पाय ते सना पर बसाड़ला</para>
  <para style="q2" vid="SNG 5:15">झीकर्‌या दगड़ान खम्‌बान तसा छे।</para>
  <para style="q1" vid="SNG 5:15">चो ते लबानोन बयड़ान तसु वारु,</para>
  <para style="q2" vid="SNG 5:15">ने देवदारेन झाड़कान तसु गमे असु छे।<verse eid="SNG 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 5:16" />तेरी बुली बेसकी सुवाळी छे,</para>
  <para style="q2" vid="SNG 5:16">ने चु बेसकु वारु छे।</para>
  <para style="q1" vid="SNG 5:16">ए यरुसलेम सहरेन पुरे,</para>
  <para style="q2" vid="SNG 5:16">जुत मारु लाटेकलु ने जुत मारु दुस्‌तीदार छे।<verse eid="SNG 5:16" /></para>
  <chapter eid="SNG 5" />
  <chapter number="6" style="c" sid="SNG 6" />
  <para style="sp">दुस्‌तीदारेन</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 6:1" />ओ आखा बायरा मां बेसकी वारु,</para>
  <para style="q2" vid="SNG 6:1">तारु लाटेकलु कांखुर जाती रयु?</para>
  <para style="q1" vid="SNG 6:1">तुसेक परम करन्‌यु कांखुर जाती रयु? बताड़,</para>
  <para style="q2" vid="SNG 6:1">हामु तार पुठे तीनाक हेरने आवसु।<verse eid="SNG 6:1" /></para>
  <para style="sp">लाडी</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 6:2" />मारु परम वाळु आपणी वाड़ी मां जाती रयु,</para>
  <para style="q2" vid="SNG 6:2">जां बलसानेन झाड़का उंगे,</para>
  <para style="q1" vid="SNG 6:2">चु वाड़ी मां आपणा गाडरा-बुकड़ान टुळा काजे खावाड़ी रयु,</para>
  <para style="q2" vid="SNG 6:2">ने सोसनेन फुल काजे भेळु कर रयु।<verse eid="SNG 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 6:3" />मे मारा परम करन्‌यान छे, ने मारु परम करन्‌यु, मारु छे,</para>
  <para style="q2" vid="SNG 6:3">चु आपसा गाडरा-बुकड़ा सोसन फुलेन ईचमां चारे।<verse eid="SNG 6:3" /></para>
  <para style="s">पांचवो गीत</para>
  <para style="sp">लाडु</para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 6:4" />ओ मारी लाटेकली, तु तीरसा सहरेन तसी बेसकी वारु छे।</para>
  <para style="q2" vid="SNG 6:4">तु यरुसलेम सहरेन तसी बेसकी वारु छे,</para>
  <para style="q2" vid="SNG 6:4">ने तु झंडु लीन जातला सीपायड़ान तसी ताकतवाळु छे।<verse eid="SNG 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 6:5" />आपसा डुळा मारे भीणी सी अथा फेरवी लेदी,</para>
  <para style="q2" vid="SNG 6:5">काहाकी तारा डुळा देखीन मारी घाबराण छुट जाय;</para>
  <para style="q1" vid="SNG 6:5">तारा कान्‌या ते गीलाद बयड़ान आड़खे बठी रवला,</para>
  <para style="q1" vid="SNG 6:5">बुकड़ान टुळान तसा देखाये।<verse eid="SNG 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 6:6" />तारा दात तीनु गाडरान टुळान तसा छे,</para>
  <para style="q2" vid="SNG 6:6">जे नदीम उंघळीन उपर आवला हय,</para>
  <para style="q1" vid="SNG 6:6">तींद्‌रेम एकेक जवळ्‌या पीला रवे।</para>
  <para style="q2" vid="SNG 6:6">तींद्‌रेम एक बी पीलो नी मर्‌यो हय।<verse eid="SNG 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 6:7" />तारा गाल तारा कान्‌या पछळ अनारेन चीर्‌यान तसा देखाये।<verse eid="SNG 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 6:8" />चां साहाठ राणी, ने अस्‌सी राखला बायरा छे,</para>
  <para style="q2" vid="SNG 6:8">ने गीणाये नी अतरी कुवारली पुरे बी छे।<verse eid="SNG 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 6:9" />बाकुन मारी पेरवी,</para>
  <para style="q2" vid="SNG 6:9">मारी चुखली, बेसकी वारु छे,</para>
  <para style="q1" vid="SNG 6:9">ची आपसी मायन एखली पुरे छे,</para>
  <para style="q2" vid="SNG 6:9">आपसी मायन लाटेकली छे।</para>
  <para style="q1" vid="SNG 6:9">आखी कुवारली पुरे देखीन तुसेक वारु कवे;</para>
  <para style="q2" vid="SNG 6:9">राणी ने राखला बायरा देखीन तुसेक बेसका वारु कवे।<verse eid="SNG 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 6:10" />जी कुण छे, जी संदारे वीजाळान तसी सुबा देय,</para>
  <para style="q1" vid="SNG 6:10">जी चांदेन तसी बेसकी वारु छे, ने दाहड़ान तसी चुखी छे,</para>
  <para style="q2" vid="SNG 6:10">ने झंडु लीन जातला सीपायड़ान तसी छे, बेसका छेलभात्‌या छे।<verse eid="SNG 6:10" /></para>
  <para style="sp">लाडी</para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 6:11" />मे बदामेन झाड़कान घाटी मां फुले देखणे करीन गुयली,</para>
  <para style="q2" vid="SNG 6:11">ने अंगुरेन कवळ्‌ळा डीरा फुट्‌या की नी फुट्‌या करीन गुय,</para>
  <para style="q2" vid="SNG 6:11">ने अनारेन फुले आया की नी</para>
  <para style="q2" vid="SNG 6:11">आयो करीन देखणे करीन गुयली।<verse eid="SNG 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 6:12" />मेसेक मालुम बी नी पड़्‌यो ने मारा वीच्‌यार मेसेक मारा राजकुमारेन घुड़ा-गाडी पर चड़ाय देदा।<verse eid="SNG 6:12" /></para>
  <para style="sp">दुस्‌तीदारन्‌या</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 6:13" />ओ सुलेम्‌मीन पुरे<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="ft" closed="false">सांती वाळी</char></note>, पछी आवती रव, पछी आवती रव,</para>
  <para style="q1" vid="SNG 6:13">हेरेन करीन की, हामु तुसेक एक हेट्‌या भाळजे।</para>
  <para style="sp" vid="SNG 6:13">लाडी</para>
  <para style="q1" vid="SNG 6:13">तुहुंं सुलेम्‌मीन पुरे काजे एकहेट्‌या काहा भाळने हींड रया,</para>
  <para style="q2" vid="SNG 6:13">ने मानु जो दुय टुळान नाचणु छे?<verse eid="SNG 6:13" /></para>
  <chapter eid="SNG 6" />
  <chapter number="7" style="c" sid="SNG 7" />
  <para style="sp">लाडु</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 7:1" />ओ राजान पुरे, तारा पाय, चाट्‌या मां बेसका वारु देखाये!</para>
  <para style="q2" vid="SNG 7:1">ने तारा सातळ्‌या गुळमला वजन साय छे,</para>
  <para style="q1" vid="SNG 7:1">तीनुक काहनुक सीकलु मीस्‌तरी बणायु हय।<verse eid="SNG 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 7:2" />तारी डुटी ते वारुलु वाटका सांय छे,</para>
  <para style="q2" vid="SNG 7:2">ची जलमकी अंगुरेन रस सी भरली रवे।</para>
  <para style="q1" vid="SNG 7:2">तारो पेट ते गहुंन पुळा सांय छे,</para>
  <para style="q2" vid="SNG 7:2">तेरे च्‌यारु मेर सोसन फुल छे।<verse eid="SNG 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 7:3" />तारा दुयु छात्‌या ते,</para>
  <para style="q2" vid="SNG 7:3">हयणीन दुय पीलान तसा देखाये।<verse eid="SNG 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 7:4" />तारी बुची ते हातीन दातेन बणावली मीनार मुजुक छे।</para>
  <para style="q1" vid="SNG 7:4">तारा डुळा ते हेसबोन सहर मां बणावला कुंडान तसा छे,</para>
  <para style="q2" vid="SNG 7:4">जे कुंडा बेतरब्‌बीम बारना धड़्‌ये छे।</para>
  <para style="q1" vid="SNG 7:4">तारी नाक ते लबानोन बयड़े बणावला मीनार मुजुक छे,</para>
  <para style="q2" vid="SNG 7:4">तीना मीनारेन बारनो दमीस्‌क सहर भीणी फीरीन छे।<verse eid="SNG 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 7:5" />तारो मुणको तारा डील पर करमेल बयड़ा सांय सुबा देय।</para>
  <para style="q1" vid="SNG 7:5">तारा मुणकेन कान्‌या जामण्‌या रंगेन पड़दा सांय देखाये;</para>
  <para style="q2" vid="SNG 7:5">असो लागे राजु तीनु कान्‌या देखीन मनवाय गुयु।<verse eid="SNG 7:5" /></para>
  <para style="sp">लाडु</para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 7:6" />ओ लाटेकली, ने मोहणी वाळनी!</para>
  <para style="q2" vid="SNG 7:6">तु ते गमे असी कुवारली पुरे छे, तु घाटाळी छे!<verse eid="SNG 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 7:7" />तारो डील खजुरेन तसो वारु छे,</para>
  <para style="q2" vid="SNG 7:7">ने तारा छात्‌या अंगुरेन गुछ्‌छान तसा छे।<verse eid="SNG 7:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="SNG 7:8" />मे वीच्‌यार कर्‌यु, “मे खजुरेन झाड़का पर चहड़ीन तेरा फळेन गुछ्‌छा छीम लीस।”</para>
  <para style="q2" vid="SNG 7:8">कसो रवतो, कदी तारा धाद्‌या अंगुरेन गुछ्‌छान तसा रवता,</para>
  <para style="q1" vid="SNG 7:8">ने तारी कीमत वारु गंदायण्‌या सेवफळेन तसी रवती,<verse eid="SNG 7:8" /></para>
  <para style="q2">
    <verse number="9" style="v" sid="SNG 7:9" />ने तारु गुळु वारलु अंगुरेन रसेन सांय छे।</para>
  <para style="sp" vid="SNG 7:9">लाडी</para>
  <para style="q2" vid="SNG 7:9">मारा हुटड़ा पर मायन धीरु-धीरु उहीन जाती रयु।<verse eid="SNG 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 7:10" />मे मारा परम करन्‌यान छे। ने मेसेक परम करन्‌यु मारीत हेर कर्‌या करे।<verse eid="SNG 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 7:11" />ओ मेसेक परम करन्‌या, चाल, आपणु खेते भीणी जाता,</para>
  <para style="q2" vid="SNG 7:11">ने गांव मां रात रवजे।<verse eid="SNG 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 7:12" />आपणु संदारे एगात उठीन अंगुरेन वाड़ी मां जाता,</para>
  <para style="q2" vid="SNG 7:12">ने देखता की, अंगुरेन डीरा फुट्‌या की नी फुट्‌या,</para>
  <para style="q2" vid="SNG 7:12">ने अंगुरेन फुल नीकळ्‌या की नी,</para>
  <para style="q2" vid="SNG 7:12">ने अनारेन फुल आय रया।</para>
  <para style="q1" vid="SNG 7:12">चां जाय्‌न मे तुसेक परम करीस ने मारो परम तुसेक देखाड़ीस।<verse eid="SNG 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 7:13" />दुदाफळ<note caller="+" style="f"><char style="fr" closed="false">7:13 </char><char style="ft" closed="false">वारु गंदायण्‌यो फुल</char></note> वारु गंदायणे बाजी रयो,</para>
  <para style="q2" vid="SNG 7:13">ने हामरे बारने आखी भातीन वारु-वारु फळ छे,</para>
  <para style="q1" vid="SNG 7:13">तेरेमां नवला ने जुनला फळ बी छे। ए मेसेक परम करन्‌या,</para>
  <para style="q2" vid="SNG 7:13">जे आखा फळ मे तार वाटे भेळा कर रय।<verse eid="SNG 7:13" /></para>
  <chapter eid="SNG 7" />
  <chapter number="8" style="c" sid="SNG 8" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 8:1" />जत्‌यार तु मारु भाय रवतु,</para>
  <para style="q2" vid="SNG 8:1">ने मारा खुदेन घराणा मां ती एक रवतु,</para>
  <para style="q1" vid="SNG 8:1">ती मे तुसेक बाहर गुळा देती,</para>
  <para style="q2" vid="SNG 8:1">ने कुय बी मेसेक गुनाळी नी ठेहरावती।<verse eid="SNG 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 8:2" />मे तुसेक मारी मायन घर ली जाती,</para>
  <para style="q2" vid="SNG 8:2">ने ची मेसेक सीकाड़ती,</para>
  <para style="q1" vid="SNG 8:2">ने मे तुसेक मसालु भेसकेलु अंगुरेन रस पीवाड़ती,</para>
  <para style="q2" vid="SNG 8:2">ने आपणा अनारेन रस पीवाड़ती।<note caller="+" style="x"><char style="xo" closed="false">8:2 </char><char style="xt" closed="false"><ref loc="PRO 9:2">नीतीवचन 9:2</ref></char></note><verse eid="SNG 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 8:3" />बेसको वारु रवतो, जत्‌यार तारु डाखर्‌यु हात,</para>
  <para style="q2" vid="SNG 8:3">मारा मुणका तळे रवतु, ने जेवड़्‌यु हात मेसेक पुमाळतु!<verse eid="SNG 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 8:4" />ओ यरुसलेम सहरेन पुरे, मे तुहुंंक सगुन खावाड़ीन कवाड़ो,</para>
  <para style="q2" vid="SNG 8:4">जत्‌यार लग सय टेम नी आवे तत्‌यार लग मारा परम काजे मां जागाड़े, तत्‌यार लगुन हामु तीनाक नी जागाड़जे।<verse eid="SNG 8:4" /></para>
  <para style="s">छटवो गीत</para>
  <para style="sp">दुस्‌तीदार</para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 8:5" />जी कुण छे, ची आपसा परम वाळा काजे हात मां धरीन,</para>
  <para style="q2" vid="SNG 8:5">रेतवाळी जागा मां सी आवणे बाजी रय?</para>
  <para style="sp" vid="SNG 8:5">लाडी</para>
  <para style="q1" vid="SNG 8:5">सेवफळेन झाड़का तळे मे तुसेक जागाड़ी।</para>
  <para style="q2" vid="SNG 8:5">चां तारी माय तुसेक पयदा करली। चां तारी मायन वेणा छुट्‌ला।<verse eid="SNG 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 8:6" />जसु कुय मुहर लागाड़े, तसु तु मेसेक आपसा मन मां मुहरेन तसु लागाड़ ले।</para>
  <para style="q2" vid="SNG 8:6">ने तावीजेन तसु आपसा हात मां बांद ले;</para>
  <para style="q1" vid="SNG 8:6">काहाकी परम ते मरने सांय ताकतवाळु छे,</para>
  <para style="q2" vid="SNG 8:6">ने जलमेन रीस मसाणेन तसी दयाळी नी हय।</para>
  <para style="q1" vid="SNG 8:6">तेरा ते आकठान धुदवा सांय छे।</para>
  <para style="q2" vid="SNG 8:6">ची छाचलीन भगवानेन धुदवा छे।<verse eid="SNG 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 8:7" />फुसाटा दीन नदी आवे, तेबी परम उलाये नी,</para>
  <para style="q2" vid="SNG 8:7">ने मट्‌ली नदी फुसाटा दीन आवे, तेबी परम डुबी नी सके।</para>
  <para style="q1" vid="SNG 8:7">कदी कुय परमेन बदले आखो माल-धन बी आप देय,</para>
  <para style="q2" vid="SNG 8:7">तेबी आखो माल-धन, परम अगळ फालतु ठेहरसे।<verse eid="SNG 8:7" /></para>
  <para style="sp">लाडीन भायस</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 8:8" />हामरी एक नान्‌ली बहणीस छे,</para>
  <para style="q2" vid="SNG 8:8">तेरा छात्‌या हाल लग मटा बी नी हया।</para>
  <para style="q1" vid="SNG 8:8">कदी काहनेस दाहड़े हेरा मांगा आय जासे,</para>
  <para style="q2" vid="SNG 8:8">ती तीने दाहड़े हामु काय करसु?<verse eid="SNG 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 8:9" />कदी ची अवारकुट रवती,</para>
  <para style="q2" vid="SNG 8:9">ती हामु तेर पर चांदीन मुंडेवरी बणावता;</para>
  <para style="q1" vid="SNG 8:9">ने कदी चो बारनो रवतो,</para>
  <para style="q2" vid="SNG 8:9">ती हामु तेरे पर देवदारेन लाकड़ान पाट्‌या लागाड़ता।<verse eid="SNG 8:9" /></para>
  <para style="sp">लाडी</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 8:10" />मे अवारकुट रवती,</para>
  <para style="q2" vid="SNG 8:10">ने मारा छात्‌या मीनारेन तसा रवता;</para>
  <para style="q1" vid="SNG 8:10">तत्‌यार मे मारा परम करन्‌यान नींगा मां सांती लावण्‌या मुजुक रवती।<note caller="+" style="x"><char style="xo" closed="false">8:10 </char><char style="xt" closed="false"><ref loc="EZK 16:7">यहेजकेल 16:7</ref>; <ref loc="1KI 4:24">1 राजा 4:24</ref>,<ref loc="1KI 4:25">25</ref> </char></note><verse eid="SNG 8:10" /></para>
  <para style="sp">लाडु</para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 8:11" />बाल्‌हामोन सहर मां राजा सुलेमानेन एक अंगुरेन वाड़ी हतली;</para>
  <para style="q2" vid="SNG 8:11">चु ची अंगुरेन वाड़ी किरसाण काजे ठेका पर आप देदु;</para>
  <para style="q1" vid="SNG 8:11">हय हरेक किरसाण हीनुक हींद्‌रा फळ वाटे,</para>
  <para style="q2" vid="SNG 8:11">चांदीन एक हजार सीक्‌का आपतेलु।<verse eid="SNG 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 8:12" />मारी खुदेन अंगुरेन वाड़ी मारीत वाड़ी छे;</para>
  <para style="q2" vid="SNG 8:12">ए सुलेमान, एक हजार रुप्‌या पर तारु हक छे,</para>
  <para style="q1" vid="SNG 8:12">ने दुय सोव रुप्‌या, फळेन राखवाळी करन्‌या किरसाण वाटे छे।<verse eid="SNG 8:12" /></para>
  <para style="sp">लाडु</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 8:13" />ओ वाड़ी मां रवणी,</para>
  <para style="q2" vid="SNG 8:13">मारा दुस्‌तीदार्‌या तारी बुली सामळनेन हेर कर रया; मेसेक बी तारी वात सामळाव।<verse eid="SNG 8:13" /></para>
  <para style="sp">लाडी</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 8:14" />ए मारा परम वाळा, उतवाळुस आव, ने गंदाण्‌या मसालान बयड़ा पर हयणान तसु,</para>
  <para style="q2" vid="SNG 8:14">जुवान हयणान तसु दवड़ीन आवती रव।<verse eid="SNG 8:14" /></para>
  <chapter eid="SNG 8" />
</usx>