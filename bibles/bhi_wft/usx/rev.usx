<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="REV" style="id">- Bhilali Standard Project</book>
  <para style="h">उजेंता बुले</para>
  <para style="toc3">उजेंता बुले</para>
  <para style="toc2">उजेंता बुले</para>
  <para style="toc1">उजेंता बुले</para>
  <para style="mt2">यूहन्ना के द्वारा लिखा गया यीशु का प्रकाशितवाक्य</para>
  <para style="mt1">युहन्‌नान साहरे लिखला ईसुन उजेंता बुले</para>
  <para style="imt">उजेंता बुलेन बारामां</para>
  <para style="ip">उजेंता बुलेन किताप नवला नेमेन आकरी किताप छे जी ईसु मसीन पयदा हवणेन धड़े-वड़ेन नब्‌बे ने पांच साल पछेन नेवतावाळु युहन्‌नु <char style="xt"><ref loc="REV 1:1">1:1</ref></char> साहरे लिखायलो हतलो हीयु युहन्‌ना लिखला खुस-खबर ने पेहला युहन्‌ना ने दीसरु युहन्‌ना ने तीसरु युहन्‌ना ने तीन चिट्‌ठी बी लिखलु युहन्‌ना काजे तीनाक ईसुन परमवाळान रुप मां बी जाणाय जाय <char style="xt"><ref loc="JHN 13:23">युहन्‌ना 13:23</ref></char> युहन्‌नु पतमुस टापा पर उजेंता बुलेन किताप काजे लिखलु काहाकी ईसु मसी। <char style="xt"><ref loc="REV 1:9">उजेंता बुले 1:9</ref></char></para>
  <para style="ip">खुस-खबर सामळावणे वाटे चां मकेलु। उजेंता बुलेन किताप लिखणे मां युहन्‌ना मतलब भन्‌ने वाळा काजे ईसु मसी वाटे ईमान्‌दार रहणेन ने हीनाक आस आपणे वाटे हिम्‌मत आपे काहाकी ईसु मसीन आवणेन टेम धड़ेत छे। <char style="xt"><ref loc="REV 1:3">1:3</ref>; <ref loc="REV 22:7">22:7</ref></char> हीये नानली वात पर आखा भुरसु करने वाळा माणसे ने पाठ 2-3 मां खास सात मंडळी काजे लिखलु युहन्‌ना आपणा खुदेन लिखला काजे भगवानेन आवणे वाळी वातेन नाव सादी कर्‌यु। <char style="xt"><ref loc="REV 1:3">1:3</ref></char> ने चु जे चीजे देख्‌यु हींद्‌रे बारामां बताड़ने करीन आखी किताप मां फुटुक काजे काम मां लेदु जी किताप जुन्‌ला नीयमेन थुड़ीक वातेन तसी छे खास करीन जकर्‌या <char style="xt"><ref loc="REV 6:1-8">6:1-8</ref></char> सात फेप्‌या ने सात कटेवरा बी हीनी परेसानीन तसा छे तीनुक भगवान मीसरे देस मां डंड आपणे करीन मकेलु <char style="xt"><ref loc="EXO 7:9">नीरगमन 7:9</ref></char> उजेंता बुलेन टेमेन आकरीन बारामां वात करे असो छे की ईसु जीती जासे ने जे आखा हेरे पर भुरसु करे जे जलम हेरे साते रवसे जी किताप तुहुंं काजे चेतावे की ने तुहुंं काजे आसा देवाड़े की ईसु छाटुस पछु आवणे वाळु छे।</para>
  <para style="iot">बाहरती वात</para>
  <para style="io1">1. युहन्‌ना असु कय्‌न सुरु करे की हीयु कुण छे ने हीनाक जी भगवान अघी सी आवणे वाळी वीजाळो कसों जड़्‌यो। <char style="ior"><ref loc="REV 1:1-20">1:1-20</ref> </char></para>
  <para style="io1">2. चु सुदु ईसु सी सात मंडळ्‌या काजे खबर आपे। <char style="ior"><ref loc="REV 1:1-3:22">1:1—3:22</ref></char></para>
  <para style="io1">3. अळतेन हीयु सात मुहर <char style="ior"><ref loc="REV 4:1-8:5">4:1—8:5</ref> </char> ने सात फेप्‌यान बारामां बताड़े। <char style="ior"><ref loc="REV 8:6-11:19">8:6—11:19</ref></char></para>
  <para style="io1">4. हेरे पछेन युहन्‌नु सात मुणका साते माणसे पुर्‌यान लड़ायन वीरुद मां अजगरेन बारामां बताड़े। <char style="ior"><ref loc="REV 12:1-14:20">12:1—14:20</ref> </char></para>
  <para style="io1">5. तत्‌यार चु रीसेन सात कटवरान बारामां लिखे। <char style="ior"><ref loc="REV 15:1-16:18">15:1—16:18</ref> </char></para>
  <para style="io1">6. अळी युहन्‌नु बताड़े भगवान सरग मां आपणा दुसमनेन वीरुद मां कसु जीते। <char style="ior"><ref loc="REV 17:1-20:15">17:1—20:15</ref> </char></para>
  <para style="io1">7. आकरी मां चु नवला सरग नवली धरतीन बारामां बताड़े ज आकरी मां आवसे। <char style="ior"><ref loc="REV 21:1-22:21">21:1—22:21</ref> </char></para>
  <chapter number="1" style="c" sid="REV 1" />
  <para style="p">
    <verse number="1" style="v" sid="REV 1:1" />ईसु मसीन उजेंता बुले, च तीनाक भगवान असु करीन देदु की आपसा चाकर्‌याक चे वात, तीनुक मामार हवणु की हवणु छे, देखाड़े; ने हयु आपसा सरग काहवाळ्‌या काजे मकलीन आपसा चाकर्‌या युहन्‌नाक बताड़्‌यु, <verse eid="REV 1:1" /><verse number="2" style="v" sid="REV 1:2" />जु भगवानेन बुल ने ईसु मसीन गवाय मतलब जो काय हयु देखलु तेरी गवाय देदु। <verse eid="REV 1:2" /><verse number="3" style="v" sid="REV 1:3" />चे वारु छे ची ईनी हवणे वाळी अघली वातेन बुल काजे भणे, ने जे सामळे ने हेरेम लिखली वातेक माने; काहाकी टेम धड़ेत छे।<verse eid="REV 1:3" /></para>
  <para style="s">सातु मंडळ्‌यान आव-भाव</para>
  <para style="p">
    <verse number="4" style="v" sid="REV 1:4" />युहन्‌ना भीणी सी आसीया देसेन सांतु मंडळ्‌यान नावे: तेरे भीणी सी जु छे, ने जु हतलु ने जु आवणे वाळु छे:</para>
  <para style="p" vid="REV 1:4">ने तीनु सातु आत्‌मा भीणी सी जु तेरा बठणेन गादीन अगळ छे। <verse eid="REV 1:4" /><verse number="5" style="v" sid="REV 1:5" />ने ईसु मसी भीणी सी जु भुरसा लायक गवाय ने मरला मां सी जीव उठणे वाळा मां पेहलु पुर्‌यु ने धरतीन बेसका राजान मालीक छे, तुहुंंक गीण-दया ने सांती जड़ती रहे।</para>
  <para style="p" vid="REV 1:5">हयु हामरे सी परम राखे, ने हयु आपसा लुही सी हामुक पापेम सी छुड़ायु, <verse eid="REV 1:5" /><verse number="6" style="v" sid="REV 1:6" />ने हामुक एक राज ने आपणा बास भगवान वाटे पुजारु बी बणाय देदु; तेरोत सेक-सींगार ने ताकुतेन काम जलम हवतो रहणु चाहजे आमीन।<verse eid="REV 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 1:7" />देखु ज लिखलो छे की, हयु वादळा भेळुत आवणे वाळु छे, ने हरेक ने डुळा तीनाक देखसे, मतलब जे तीनाक वेला पाड़ीन मारला चे बी देखसे, ने धरतीन आखा माणसे तेरे वजे सी छाती ठुकसे। हव। आमीन।<verse eid="REV 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 1:8" />मालीक भगवान, जु छे ने जु हतलु ने जु आवणेवाळु छे, जु आखाम सी ताकतवाळु छे, चु असु कह्‌वे, “मेत अल्‌फा ने ओमेगा छे।”<verse eid="REV 1:8" /></para>
  <para style="s">युहन्‌नाक मसीन बारामां जागतो सपनो</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 1:9" />मे युहन्‌ना, जु तुंद्‌रु भाय ने ईसुन दुख ने राज्‌य ने दम धरने मां तुंद्‌रे भेळु भेसकायलु छे, भगवानेन बुले ने ईसुन गवायन वजे सी पतमुस नावेन टापा मां हतलु। <verse eid="REV 1:9" /><verse number="10" style="v" sid="REV 1:10" />मे मालीकेन दाहड़े आत्‌माम आय गुयु, ने आपणे पछळ फेप्‌यान तसा मटात बुले असो कवता सामळ्‌यु, <verse eid="REV 1:10" /><verse number="11" style="v" sid="REV 1:11" />“ज काय तु देखे तीनाक किताप मां लिखीन सांतु मंडळ्‌याक पुगाड़ दे, मतलब ईफीसुस, ने समुरना, ने पीरगमुन, ने थुवातीरा, ने सरदीस, ने फीलदीलफीया, ने लोदीकीया काजे।”<figure style="fig" alt="Map of seven churches in Asia" file="hk00378c.tif" size="span" copy="Horace Knowles ©" ref="1:11">आसीयान सात मंडळीन नक्‌सु</figure><verse eid="REV 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 1:12" />तत्‌यार मे तीनाक, जु मारे सी बुलतेलु, देखणे वाटे मारो मुंहडो फेरव्‌यु; ने पछु वळीन मे सनान सात दिवा देख्‌यु, <verse eid="REV 1:12" /><verse number="13" style="v" sid="REV 1:13" />ने तीनु दिवान ईचमां माणसेन पुर्‌यान तसु एक माणुस काजे देख्‌यु, जु पाये लगुन पुथल्‌या पेहरलु, ने छाती पर सनान फेटु बांद्‌लो हतलो। <verse eid="REV 1:13" /><verse number="14" style="v" sid="REV 1:14" />तेरे मुणको ने कान्‌या धवळा जसा बरफेन तसों उजेळ्‌ळो हतलो, ने तेरा डुळा आकठान ईंगाळान तसा हतला। <verse eid="REV 1:14" /><verse number="15" style="v" sid="REV 1:15" />तेरा पांय वारलु पीतळेन तसा हतला जसा मानु की भाटी मां हळो-हळो तातो करलो हय, ने तेरा बुले बेसका पाणीन आवाजेन तसा हतला। <verse eid="REV 1:15" /><verse number="16" style="v" sid="REV 1:16" />चु आपसा जेवड़्‌या हात मां सात तारा ली रवलु, ने तेरा मुंहडाम सी <note caller="+" style="f"><char style="fr" closed="false">1:16 </char><char style="ft" closed="false">पाजावली दुय धारी छर-छर तलवार</char></note>पाजावली दुयधारी छर-छर तलवार नीकळने बाजी रवली। ने तेरा मुंहडाम सी माथे दाहड़े भीबळन्‌या दाहड़ान तसों बेसके जुरे भीबळी रह्‌लो। <verse eid="REV 1:16" /><verse number="17" style="v" sid="REV 1:17" />जत्‌यार मे तीनाक देख्‌यु, ती मे तेरा पाये पर मरलान तसु हीट पड़्‌यु। ने चु मारे उपर आपसु जेवड़्‌यु हात मेकीन कह्‌यु, तु बीहे मां; मे पेहलु<note caller="+" style="f"><char style="fr" closed="false">1:17 </char><char style="ft" closed="false">मेत पेहलु, ने आकरी ने तेरो मतलब छे; सुरु मां आखी कळ-जुग घड़न्‌यु मेत छे, ने आखी कळ-जुग सारनु बी मेत छे।</char></note> ने आकरी ने जीवतेलु छे; <verse eid="REV 1:17" /><verse number="18" style="v" sid="REV 1:18" />मे मर गुयलु, ने हय देख मे मर्‌या-सर्‌याम सी बठु हय्‌न जलम पीड़ीडीट जीवतु छे; ने मोतन कुची ने पाताळेन कुची मारेत धड़े छे। <verse eid="REV 1:18" /><verse number="19" style="v" sid="REV 1:19" />तेरेमां जी वात तु देखलु छे ने जी वात हय रय ने जी वात हेरे पछळ हवणे वाळी छे, तीनु आखी काजे लिख ले। <verse eid="REV 1:19" /><verse number="20" style="v" sid="REV 1:20" />मतलब तीनु सांतु तारान सातायली वात जीनुक तु मारे जेवड़्‌ये हात मां देख्‌यु, ने तीनु सात सनान दिवान सातायली वात: चे सात तारा सांतु मंडळ्‌यान सरग काहवाळ्‌या छे, ने चे सात दिवा सात मंडळ्‌या छे।<verse eid="REV 1:20" /></para>
  <chapter eid="REV 1" />
  <chapter number="2" style="c" sid="REV 2" />
  <para style="s">ईफीसुस काजे समाचार</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 2:1" />तु ईफीसुस सहरेन मंडळीन माणसे वाटे तींद्‌रा चाकर्‌या काजे असो लिखीन दी मकल:</para>
  <para style="p" vid="REV 2:1">जु सात तारा आपसा जेवड़्‌या हात मां धर रयु, ने सनान सात दिवान ईचमां फीरी र्‌यु, मे तुहुंंक असो कह्‌वो। <verse eid="REV 2:1" /><verse number="2" style="v" sid="REV 2:2" />मे तारा काम काजे, ने तुंद्‌री मेहनत काजे, ने तुंद्‌री गम खाणेन ताकत काजे वारु जाणो; की तुहुंं तीनु कुहर्‌या माणसेक देख नी सके, ने जे आपसात काजे ईसुन नेवताळु कह्‌वे, ने तुहुंंक पारखी लेदा, ने जाण लेदा की, चे ईसुन नेवताळान काम नी हय, बाकुन लुच्‌चा छे। <verse eid="REV 2:2" /><verse number="3" style="v" sid="REV 2:3" />तुहुंं बेसका गम खावु, तुहुंं मार नाव सी वेला करी-करीन हारी नी पड़्‌यु। <verse eid="REV 2:3" /><verse number="4" style="v" sid="REV 2:4" />बाकुन तेबी, मेसेक तुंद्‌रा वीरुद मां जो कह्‌णु छे की, तुहुंं पेहलेन तसु परम छुड़ देदा। <verse eid="REV 2:4" /><verse number="5" style="v" sid="REV 2:5" />तेरेमां वीतला दाहड़ाक हेर करु, ने तुहुंं कां सी पड़ला, ने मन फेरवीन भगवान भीणी वळु, ने पेहलेन तसा परम सी काम करु; ने कदी तुहुंं भगवान भीणी नी वळु, ती मे तुंद्‌रेन्‌चां आय्‌न तुंद्‌रा दिवा काजे तुंद्‌रेन्‌चां सी छेटे कर दीस। <verse eid="REV 2:5" /><verse number="6" style="v" sid="REV 2:6" />बाकुन हव, तारेम जी वात ते छे, की तु नीकुलईया पंथवाळान काम तुसेक नी पटे, ने चे मेसेक बी नी पटे।<verse eid="REV 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 2:7" />जेरा कान्‌टा हय, चु सामळी लेय की चुखली-आत्‌मा मंडळ्‌या सी काय कहें!</para>
  <para style="p" vid="REV 2:7">जु जीती जाय, मे तीनाक पला जीवनेन झाड़का मां सी जु भगवानेन सरगेन बगीचा मां छे, फळ खाणेन दीस।<verse eid="REV 2:7" /></para>
  <para style="s">समुरना सहरेन मंडळी वाटे खुस खबर</para>
  <para style="p">
    <verse number="8" style="v" sid="REV 2:8" />“समुरनान मंडळ्‌यान सरग काहवाळ्‌या काजे ज लिख:</para>
  <para style="p" vid="REV 2:8">“जु पेहलु ने आकरी छे; जु मर गुयलु ने हय जीवतु हय गुयु, हयु असो कहें।” <verse eid="REV 2:8" /><verse number="9" style="v" sid="REV 2:9" />मे तारा दुख ने गरीबी काजे जाणो; ने जे माणसे आपसा काजे यहुदी कहें ने हय नी, बाकुन भुतड़ान दुवान घर छे, तींद्‌री बदनामी काजे बी जाणो। <verse eid="REV 2:9" /><verse number="10" style="v" sid="REV 2:10" />जे दुख तुसे झेलनु पड़से, तीनु सी मां बीहे काहाकी, भुतड़ु तुंद्‌रे मायन काहनाक काजे जेल मां नाखणेत वाळा छे काहाकी, तुहुंं पारखाय जावु; ने तुहुंं दस दाहड़ा लग दुख हाकलनु पड़से। जीव देणे लग भुरसा लायक रव; ती मे तुसेक जीवनेन मुड़ दीस।<verse eid="REV 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 2:11" />तेरा कान्‌टा छे, हयु सामळी लेय की आत्‌मा मंडळ्‌या सी काय कहें, जे जीत जाय,</para>
  <para style="p" vid="REV 2:11">“तीनुक दीसरी मरण सी काय बी नुकसाण नी हवे।”<verse eid="REV 2:11" /></para>
  <para style="s">पीरगमुन सहरेन मंडळी वाटे खुस खबर</para>
  <para style="p">
    <verse number="12" style="v" sid="REV 2:12" />पीरगमुनेन मंडळ्‌यान सरग काहवाळ्‌या काजे असु लिख की:</para>
  <para style="p" vid="REV 2:12">“तेरे धड़े पाजावली दुयधारी तलवार छे।” <verse eid="REV 2:12" /><verse number="13" style="v" sid="REV 2:13" />ने मे असो बी ते जाणो की तु वां रहे जां भुतड़ान बठणेन राजगादी छे, ने मारे नाव सी टीकीन रहे; ने मार पर भुरसु करने सी तीनु दाहड़ाम बी पछु नी पड़्‌यु, तेरेमां मारु भुरसाम रहण्‌यु अंतीपास, तुंद्‌रेन्‌चां तीना जागा पर माराय गुयु जां भुतड़ु रहे। <verse eid="REV 2:13" /><verse number="14" style="v" sid="REV 2:14" />बाकुन मे तार वळु नी हवतु ने ईतरीक वात कहणु छे, काहाकी तारेन चां काहनाक ते असा छे, जे बीलामेन सीकापण काजे माने, जु बालाक काजे ईस्‌रायलेन माणसे अगळ पाप करने करीन पटव्‌या, की जे दगड़ा पर चड़ावली चीज खाय, ने छीनाळो काम करे। <verse eid="REV 2:14" /><verse number="15" style="v" sid="REV 2:15" />तसोत तारेन चां काहनाक असा छे, जे नीकुलईन सीकापण काजे माने। <verse eid="REV 2:15" /><verse number="16" style="v" sid="REV 2:16" />तेरेमां मन फेरव, नी ते मे तारे धड़े मामारुत आवीन, मारी लुहड़ान तलवार सी तींद्‌रे भीणी लड़ीस।<verse eid="REV 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 2:17" />तेरा कान्‌टा छे, हयु सामळी लेय की चुखली-आत्‌मा मंडळ्‌या सी काय कहें; जे जीत जाय,</para>
  <para style="p" vid="REV 2:17">“तीनाक मे सातायला मन्‌ना मां सी दीस; ने तीना दगड़ा पर एक नाव लिखलो रवसे, जो तीनाक जड़ने वाळा पाखुर ने कुय नी जाणसे।”<verse eid="REV 2:17" /></para>
  <para style="s">थुवातीरा सहरेन मंडळी वाटे खुस खबर</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 2:18" />थुवातीरान मंडळ्‌यान सरग काहवाळ्‌या काजे असो लिख,</para>
  <para style="p" vid="REV 2:18">भगवानेन पुर्‌यु तेरा डुळा आकठान ईंगाळान तसा, ने तेरा पांय वारलु पीतळेन तसों छे, हयु असु कहें: <verse eid="REV 2:18" /><verse number="19" style="v" sid="REV 2:19" />मे तारा कामे, ने परम, ने भुरसा, ने सेवा, ने गम काजे जाणो, ने ज बी की तारा पछला काम पेहला काम सी बड़ीन छे। <verse eid="REV 2:19" /><verse number="20" style="v" sid="REV 2:20" />बाकुन मे तारे वळु नी हवतु ने असो कहणु छे, की तु तीनी बायर इजेबेल मां रहणी देय, ची आपसी काजे भगवानेन अघली वात बताड़ने वाळी कहें, ने मारी सेवा करन्‌या काजे छीनाळो करने, ने दगड़ा अगळ चड़ावली चीज खाणु करीन भुले पाड़े। <verse eid="REV 2:20" /><verse number="21" style="v" sid="REV 2:21" />मे तीनाक मन फेरवणेन टेम आप्‌यु, बाकुन हयी आपसीन छीनाळा काम करने सी मन नी फेरवणे नी हींडती। <verse eid="REV 2:21" /><verse number="22" style="v" sid="REV 2:22" />देख, मे तीनीक रुगेन खाट्‌ली मां नाखो; ने जे तेरे साते छीनाळो करी र्‌या ने कदी चे बी हीनीन तसा काम सी मन नी फेरवसे ती तीनुक मटला दुख मां नाखीस। <verse eid="REV 2:22" /><verse number="23" style="v" sid="REV 2:23" />मे तींद्‌रा पुर्‌या काजे मार नाखीस; ने तत्‌यार आखा मंडळ्‌या जाणी लेसे की मन ने मरजी काजे पारखणे वाळु मेत छे, ने मे तुंद्‌रे मायन हरेक ने तेरा कामेन अनसारे बदलु दीस।<verse eid="REV 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="REV 2:24" />बाकुन तुहुंं थुवातीरान बाकी माणसे सी, जतरा ईना सीकापण काजे नी माने, ने तीनु वातेक जीनुक भुतड़ान उंडली वात कहें, तीनुक नी जाणे, तीनुक असो कहं, की मे तुंद्‌रे पर अळी भार नी नाखो। <verse eid="REV 2:24" /><verse number="25" style="v" sid="REV 2:25" />बाकुन हव, जो तुंद्‌रे धड़े छे तीनाक मारे आवणे लग धरी राख। <verse eid="REV 2:25" /><verse number="26" style="v" sid="REV 2:26" />जे जीते, ने मारा कामेन अनसारे आकरी लग करे, मे तीनाक जाती-जातीन माणसे पर हक दीस। <verse eid="REV 2:26" /><verse number="27" style="v" sid="REV 2:27" />ने हयु लुहड़ान राड़ेन हक लीन तीनु पर राज करसे, जसु कुमाहरेन धुळान डुचरा भुकरा हय जाय: मे बी असुत हक मारा बास भगवान सी जड़ली छे। <verse eid="REV 2:27" /><verse number="28" style="v" sid="REV 2:28" />ने मे बी तीनाक वीजाळ्‌यु तारु आपीस।<verse eid="REV 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="REV 2:29" />जेरा कान्‌टा छे, हयु सामळी लेय की आत्‌मा मंडळ्‌या सी काय कहें।<verse eid="REV 2:29" /></para>
  <chapter eid="REV 2" />
  <chapter number="3" style="c" sid="REV 3" />
  <para style="s">सरदीस सहरेन मंडळी वाटे खुस खबर</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 3:1" />सरदीसेन मंडळ्‌यान सरग काहवाळ्‌या काजे,</para>
  <para style="p" vid="REV 3:1">जेरे धड़े भगवानेन सात आत्‌मा ने सात तारा छे, असु कहें की मे तारा कामे काजे जाणो, की तु जीवलु ते कहवाये, बाकुन ए मरला! <verse eid="REV 3:1" /><verse number="2" style="v" sid="REV 3:2" />जागतु हय जां, ने तीनु चीजेक जी बाकी रवली छे, ने जे सरनेत वाळी छे, तीनुक काठा कर; काहाकी मे तारा काहना बी काम काजे भगवान धड़े पुरो की पुरो नी देख्‌यु। <verse eid="REV 3:2" /><verse number="3" style="v" sid="REV 3:3" />तेरेमां हेर कर, की तु काहनी बी रीती सी सीक लेदलु ने सामळ्‌ळु हतलु, ने तेरेमां बणीन रव, ने मन फेरव; ने कदी तु जागतु नी रवसी ती मे चुट्‌टान तसु आय जायस ने तु कदी नी जाण सक्‌सी, की मे काहनी टेम पर तार पर आय पड़ीस। <verse eid="REV 3:3" /><verse number="4" style="v" sid="REV 3:4" />बाकुन अतरी संय वात छे की, सरदीस मां तारेन चां काहनाक असा माणसे छे, जे आपसा पुथल्‌या काजे चुखला राख्‌या, चे धवळा पुथल्‌या पेहरीन मारे साते फीरसे, काहाकी चे हेरे लायक छे। <verse eid="REV 3:4" /><verse number="5" style="v" sid="REV 3:5" />जे जीत जाय, तीनाक हेरेन तसोत धवळा पुथल्‌या पेहरावसे, ने मे तेरो नाव जीवनेन किताप मां सी काहनी बी रीती सी नी काटो, बाकुन तेरो नाव मारु बास भगवान ने तेरा सरग काहवाळ्‌या अगळ मान लीस।<verse eid="REV 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 3:6" />तेरा कान्‌टा हय, हयु सामळी लेय की आत्‌मा मंडळ्‌या सी काय कहें।<verse eid="REV 3:6" /></para>
  <para style="s">फीलादेलफीया सहरेन मंडळी वाटे खुस खबर</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 3:7" />फीलदीलफीयान मंडळ्‌यान सरग काहवाळ्‌याक काजे असु लिख:</para>
  <para style="p" vid="REV 3:7">“जुत चुखलु ने छाचलु छे, ने जुत दावुदेन कुची राखे, तीना खुल्‌ला काजे कुय बी बंद नी कर सके ने बंद करला काजे कुय बी खुल नी सके, हयु असु कहें, <verse eid="REV 3:7" /><verse number="8" style="v" sid="REV 3:8" />मे तारा काम काजे जाणो। देख, मे तारे अगळ एक बारनो उगाड़ी र्‌यु, तीनाक कुय बी बन्‌द नी कर सके; तारी ताकत ईतरीक सी ते छे, तेबी मारा बुलेन पाळन कर्‌यु, ने मारा नावेन नीकारु नी कर्‌यु।” <verse eid="REV 3:8" /><verse number="9" style="v" sid="REV 3:9" />देख, मे भुतड़ान तीनी मंडळी काजे तार बस मां कर दीस जे यहुदी बणीन रहे, बाकुन हय नी, ने झुट बुले मे असु करीस, की चे आवीन तारे पाय मां आंदसे, ने ज जाण लेसे, की मे तारे सी परम राखो। <verse eid="REV 3:9" /><verse number="10" style="v" sid="REV 3:10" />तु मारा गमेन बुले काजे धरीन उबु रयु, तेरेमां मे बी तुसेक आफतेन टेम सी बचाड़ीस, जे धरती पर रहणे वाळान पारखणे वाटे आखी दुनीया पर आवणेवाळी छे। <verse eid="REV 3:10" /><verse number="11" style="v" sid="REV 3:11" />मे मामारुस आवणेवाळु छे; जो काय तारे धड़े छे तीनाक धरी राख, काहाकी तारा जीतला ईनाम काजे कुय बी हापकी नी सके। <verse eid="REV 3:11" /><verse number="12" style="v" sid="REV 3:12" />जे जीत जाय, तीनाक मे मारा भगवानेन घर मां एक खाम्‌बु बणावीस, ने हयु पछु कदी बाहर नी नीकळसे; ने मारा भगवानेन नाव, ने भगवानेन सहर मतलब नवला यरुसलेमेन नाव, ज मारा भगवानेन धड़े सी सरग पर सी उतरनेवाळु छे ने मारो नवलो नाव तीना पर लिखीस।<verse eid="REV 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 3:13" />तेरेमां तेरा कान्‌टा हय, हयु सामळी लेय की आत्‌मा मंडळ्‌या सी काय कहें।<verse eid="REV 3:13" /></para>
  <para style="s">लोदीकीया सहरेन मंडळी वाटे खुस खबर</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 3:14" />लोदीकीयान मंडळीन काहवाळ्‌या काजे असो लिख:</para>
  <para style="p" vid="REV 3:14">“जु आमीन, ने भुरसा वाळा, ने छाचला गवा छे, ने भगवानेन घड़नेन खास वजे छे, हयु असु कहें। <verse eid="REV 3:14" /><verse number="15" style="v" sid="REV 3:15" />मे तारा कामे काजे जाणो की तु नी ते सेळ्‌ळु छे ने नी तातु; भलो रवतो की तु सेळ्‌ळु नीते तातु रवतु। <verse eid="REV 3:15" /><verse number="16" style="v" sid="REV 3:16" />असु करीन तु फळ्‌कु छे, ने नी सेळ्‌ळु छे ने नी तातु, मे तुसे मारा मुंहडाम सी उंगेळने पर छे। <verse eid="REV 3:16" /><verse number="17" style="v" sid="REV 3:17" />तु असु कहें, की मे मातलु हय गुयु, ने मेसेक काय चीजेन कमी नीही, ने असु नी जाणतु, की तु नी भाग वाळु ने फालतु ने गरीब ने आंधळु, ने नांगरलु छे। <verse eid="REV 3:17" /><verse number="18" style="v" sid="REV 3:18" />तेरेमां मे तुसे सला दम, की आकठा मां तावलो सनो मार सी मुल ले, काहाकी मातलु हय जाय; ने धवळा पुथल्‌या ली ले की पेहरीन तुसे आपसा नांगरला सी लाजे नी पड़े; ने आपसा डुळा मां लागाड़ने करीन सुरमु ले काहाकी तु देखणे लाग जाय। <verse eid="REV 3:18" /><verse number="19" style="v" sid="REV 3:19" />मे जीनु-जीनु सी परम राखो, तीनु आखा काजे लड़ो ने ठुको, तेरेमां तीयार हय जां, ने पाप सी मन फेरव। <verse eid="REV 3:19" /><verse number="20" style="v" sid="REV 3:20" />देख, मे बारना मां उबु रय्‌न खटो-खटो कराड़ो; कदी काहनुक मारो बुली सामळीन बारनो खुलसे, ती मे तेरे धड़े माहीं आय्‌न तेरे भेळु खाणो खाय्‌स, ने चु मारे साते खासे। <verse eid="REV 3:20" /><verse number="21" style="v" sid="REV 3:21" />जु जीत जाय, मे तीनाक मारे साते मारे राजगादी पर बठाड़ीस, जसु मे बी जीती गुयु ने मारा बास भगवान भेळु तेरे राजगादी पर बठ गुयु।<verse eid="REV 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 3:22" />“तेरेमां तेरा कान्‌टा छे चे सामळी लेय की आत्‌मा मंडळ्‌या सी काय कहें।”<verse eid="REV 3:22" /></para>
  <chapter eid="REV 3" />
  <chapter number="4" style="c" sid="REV 4" />
  <para style="s">सरगेम वाळी चीज देखाय देय</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 4:1" />ईनी वातेन वात मे नींगा कर्‌यु, ती असो देख की सरग मां एक बारनो खुल्‌लो छे।</para>
  <para style="p" vid="REV 4:1">ने तीनाक मे पेहेल फेप्‌यान तसों अवाज मां आपणे साते वात करतेला सामळ्‌यु, हयुत कहें, “जां उपर आय जां, ने मे असी वात तुसे देखाड़ीस, तीनुक जी वात पुरी हवणुत छे।” <verse eid="REV 4:1" /><verse number="2" style="v" sid="REV 4:2" />तत्‌यारुत मे आत्‌मा मां आय गुयु; ने काय देखो की एक राजगादी सरग मां मेकलो छे, ने तीनी राजगादी पर काहनुक बठ्‌लु छे। <verse eid="REV 4:2" /><verse number="3" style="v" sid="REV 4:3" />ने जु तीनी राजगादी पर बठ्‌लु छे, हयु यसब (नीळ्‌ळा रंगेन) ने माणीक्‌य (रातला रंगेन) नावेन दगड़ान तसों भबळने बाजी रह्‌लो, ने ती राजगादीन चारे-मेर मरकत नावेन दगड़ा (नीळ्‌ळु रंगेन) तसों एक भाती-भातीन रंगेन बाम देखाये। <verse eid="REV 4:3" /><verse number="4" style="v" sid="REV 4:4" />तीनी राजगादीन चारे-मेर वीस ने चार राजगादी छे; ने हीनु राजगादी पर वीस ने चार मुख्‌या धवळा पुथल्‌या पेहरीन बठी र्‌यु, ने तींद्‌रे मुणका पर सनान मुड़ छे। <verse eid="REV 4:4" /><verse number="5" style="v" sid="REV 4:5" />तीनु राजगादी मां सी वीजळी चमके ने गाजुण गाजे, ने राजगादी अगळ आकठान सात दिवा धपी र्‌या, चे भगवानेन सात आत्‌मा छे, <verse eid="REV 4:5" /><verse number="6" style="v" sid="REV 4:6" />ने तीनी राजगादीन अगळ मानु वारु आर-पार देखाये तसों,</para>
  <para style="p" vid="REV 4:6">आरस्‌यान जसों दरीयों छे, ने राजगादीन ईचमां ने राजगादीन चारे-मेर चार जनवार्‌या छे, तींद्‌रे अगळ-पछळ डुळात-डुळा छे। <verse eid="REV 4:6" /><verse number="7" style="v" sid="REV 4:7" />पेहलो जनवार्‌या नाहरेन तसों छे, ने दीसरो जनवार्‌या केवड़्‌यान तसों छे, तीसरो जनवार्‌यान मुंहडो माणसेन तसों चे, ने चोवथां जनवार्‌या उडतेला घुवड़ान तसों छे। <verse eid="REV 4:7" /><verse number="8" style="v" sid="REV 4:8" />ने चारु जनवार्‌यान छव-छव पाखड़ा छे, ने चारे-मेर ने माहीं डुळात-डुळा छे; ने चे रात दाहड़ु आराम लग नी लेय ने असा कवता रहे,</para>
  <para style="q1" vid="REV 4:8">“चुखलु, चुखलु, चुखलु मालीक भगवान, आखाम सी ताकतवाळु,</para>
  <para style="q2" vid="REV 4:8">जु हतलु, ने जु छे, ने जु आवणे वाळु छे।”<verse eid="REV 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 4:9" />ने जत्‌यार जनवार्‌या तेरी जु राजगादी पर बठ्‌लु छे, ने जु जलम जीवतु छे, सेक-सींगार ने आव-भाव ने बड़ाय कर र्‌या। <verse eid="REV 4:9" /><verse number="10" style="v" sid="REV 4:10" />तत्‌यार वीस ने चार डाहा-बुड़ा राजगादी पर बठणे वाळान अगळ हीट पड़्‌या, ने तीनाक जु जलम जीवतु छे आंध्‌या; ने आपणा-आपणा मुड़ राजगादीन अगळ असा कवता जाय्‌न नाख देदा,<verse eid="REV 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="REV 4:11" />“ए हामरा मालीक, ने भगवान, तुत सेक-सींगार,</para>
  <para style="q2" vid="REV 4:11">ने आव-भाव, ने ताकुतेन लायक छे;</para>
  <para style="q1" vid="REV 4:11">काहाकी तुत आखी चीजे घड़्‌यु,</para>
  <para style="q2" vid="REV 4:11">ने तारीत मरजी सी, चे हजुरी मां हतला ने घड़ायली।”<verse eid="REV 4:11" /></para>
  <chapter eid="REV 4" />
  <chapter number="5" style="c" sid="REV 5" />
  <para style="s">सील लागली किताप ने गाडरो</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 5:1" />ने जु राजगादी पर बठलु हतलु, मे तेरे जेवड़्‌ये हात मां एक किताप देख्‌यु, तेरेमां माहीं ने बाहर लिखलो हतलो, ने सात सील लागाड़ीन बन्‌द करलो हतलो। <verse eid="REV 5:1" /><verse number="2" style="v" sid="REV 5:2" />अळतेन मे एक ताकतवाळु सरग काहवाळ्‌या काजे देख्‌यु जुर सी आयड़ीन असु परचार करतेलु “ईनी किताप काजे खुलने ने तेरी सील तुड़ने लायक कुण छे?” <verse eid="REV 5:2" /><verse number="3" style="v" sid="REV 5:3" />बाकुन ने नी सरग मां, नी धरती पर, नी धरतीन नेचु काहनुक तीनी किताप काजे खुलने नीते तीनी पर नींगा नाखणेन लायक नीकळ्‌या <verse eid="REV 5:3" /><verse number="4" style="v" sid="REV 5:4" />तत्‌यार मे उसकी-उसकीन रड़ने बाजी गुयु, काहाकी तीनी किताप काजे खुलने, नीते तीनी पर नींगा करने लायक कुय नी जड़्‌यो। <verse eid="REV 5:4" /><verse number="5" style="v" sid="REV 5:5" />तत्‌यार तीनु डाहा-बुड़ा मायन एक जणु मारे सी कह्‌यु, “मां रड़े; देख, यहुदान कुळीन पलु नाहर, जु दावुदेन अवल्‌यात छे, तीनी किताप काजे खुलने ने तेरी सातु सील तुड़ने करीन जीत जड़ी।”<verse eid="REV 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 5:6" />तत्‌यार मे तीनी राजगादी ने चारु जनवार्‌या ने तीनु डाहा-बुड़ान ईचमां, एक गाडरान पीलो उबो हय रवलो देख्‌यु; तेरा सात सींगड़ा ने सात डुळा हतला; जे भगवानेन सातु आत्‌मा छे, जी आखी धरती पर मकेली छे। <verse eid="REV 5:6" /><verse number="7" style="v" sid="REV 5:7" />हयु आवीन तेरे जेवड़े हात सी जु राजगादी पर बठ्‌लु हतलु, चु किताप ली लेदु, <verse eid="REV 5:7" /><verse number="8" style="v" sid="REV 5:8" />जत्‌यार हयु किताप ली लेदु, ती चे चारु जनवार्‌यान चोवीस डाहा-बुड़ा तीना गाडरा अगळ हीट पड़्‌या; ने आखान हात मां झुणगु ने ईत्‌तर सी भरलो सनान कटवरा हतला, चे ते चुखला माणसेन दुवा छे। <verse eid="REV 5:8" /><verse number="9" style="v" sid="REV 5:9" />ने चे ज नवलो गीत गावणे लाग्‌या,</para>
  <para style="q1" vid="REV 5:9">“तु ईनी किताप काजे लेणे,</para>
  <para style="q2" vid="REV 5:9">ने तेरी सील तुड़ने लायक छे; काहाकी तु माराय्‌न,</para>
  <para style="q1" vid="REV 5:9">आपसा लुही सी हरेक कुळ, ने बुली, ने माणसे,</para>
  <para style="q2" vid="REV 5:9">ने जाती मां सी भगवान वाटे माणसे काजे मुल लेदु।<verse eid="REV 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="REV 5:10" />ने तीनुक आपणा भगवान वाटे एक राज्‌य ने पुजारु बणायु;</para>
  <para style="q2" vid="REV 5:10">ने चे धरती पर राज करे।”<verse eid="REV 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 5:11" />जत्‌यार मे देख्‌यु, ती तीनी राजगादी ने तीनु जनवार्‌या ने तीनु डाहा-बुड़ान चारे-मेर बेसका सरग काहवाळ्‌यान बुल सामळ्‌यु, तींद्‌री गिन्‌ती लाखु ने कुरुड़ुन हतली। <verse eid="REV 5:11" /><verse number="12" style="v" sid="REV 5:12" />ने चे जुर सी कवतेला,</para>
  <para style="q1" vid="REV 5:12">“माराय्‌लु गाडरुत ताकतवाळु,</para>
  <para style="q2" vid="REV 5:12">ने धन, ने आखो सीकणो, ने ताकत, ने आव-भाव,</para>
  <para style="q2" vid="REV 5:12">ने सेक-सींगार, ने बड़ायन लायक छे।”<verse eid="REV 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 5:13" />अळतेन मे सरग मां, ने धरती पर, ने धरतीन नेचु, ने दरीयान आखी बणावली चीज, ने आखो काय जो तेरेमां छे, असो कवता सामळी,</para>
  <para style="q1" vid="REV 5:13">“जु राजगादी पर बठलु छे, तेरी,</para>
  <para style="q2" vid="REV 5:13">ने गाडरान बड़ाय, ने आव-भाव, ने सेक-सींगार,</para>
  <para style="q2" vid="REV 5:13">ने राज्‌य, जलम रहे।”<verse eid="REV 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 5:14" />चारु जनवार्‌या आमीन कह्‌या ने वीस ने चार डाहा-बुड़ा भगवान अगळ ने गाडरान पीला अगळ उबडु पड़ीन तींद्‌री भक्‌ती कर्‌या।<verse eid="REV 5:14" /></para>
  <chapter eid="REV 5" />
  <chapter number="6" style="c" sid="REV 6" />
  <para style="s">गाडरान पीलो चापड़ान छव सील तुड़े</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 6:1" />तत्‌यार मे देख्‌यु की गाडरान पीलो चो तीनु सात सील मां सी एक काजे खुल्‌यु, ने तीनु चारु जनवार्‌या मां सी एक गाजणेन तसी अवाज सामळ्‌यु, “आव।” <verse eid="REV 6:1" /><verse number="2" style="v" sid="REV 6:2" />मे नींगा नाख्‌यु, ने एक धवळु घुल्‌लु छे, ने तेरे उपर एक जणु धंदली ली र्‌यु। ने तीनाक एक मुड़ देदलो छे, ने हयु जीती रवलु ने अळी बी जीत हात करने करीन नीकळी पड़्‌यु।<verse eid="REV 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 6:3" />जत्‌यार हयु दुसरी सील खुल्‌यु, ती मे दीसरा जनवार्‌या काजे असो कवतेला सामळ्‌यु, “आव।” <verse eid="REV 6:3" /><verse number="4" style="v" sid="REV 6:4" />तत्‌यार अळी एक घुल्‌लु नीकळ्‌यु, जु रातला रंगेन हतलु; तेरो बठी रवलु तीना काजे असो हक देदलो की धरती पर सी सांतीक हाकली ले, काहाकी माणसे एक दीसरान हत्‌या करे; ने तीनाक एक मट्‌ली तलवार देदु।<verse eid="REV 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 6:5" />जत्‌यार हयु तीसरी सील तुड़्‌यु, ती मे तीसरा जनवार्‌या काजे असु कवता सामळ्‌यु, “आव।” ने मे नींगा कर्‌यु, ने एक काळ्‌ळु घुल्‌लु छे; ने घुल्‌ला पर बठी रहलान हात मां एक ताकड़ी छे। <verse eid="REV 6:5" /><verse number="6" style="v" sid="REV 6:6" />ने तीनु चारु जनवार्‌यान ईचमां सी एक असु कहतेला सामळ्‌यु, “एक दाहड़ान-दाहाड़कीन एकुत कीलु गहुं, ने एक दाहड़ान-दाहाड़कीन तीनुत कीलु जळ-गहुं जड़से, बाकुन तेल ने अंगुरेन रस बीगाड़ु घुण।”<verse eid="REV 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 6:7" />ने जत्‌यार हयु चोवथु सील तुड़्‌यु, ती मे चोवथां जनवार्‌यान बेसके जुरे आव कवतेलान सामळ्‌यु, “आव।” <verse eid="REV 6:7" /><verse number="8" style="v" sid="REV 6:8" />मे नींगा कर्‌यु, ने एक पेळ्‌ळु घुल्‌लु छे; ने तीना घुल्‌ला पर बठी रहलान नाव मरनु सरनु छे; ने पाताळ तेरे पछळ-पछळ छे ने तीनाक धरतीन चार मां सी एक हीस्‌सा पर हक देदलो छे, की तलवार, ने काळ, ने मांदवाड़, ने धरतीन जंगली जनवार्‌या माणसेक मार नाख्‌या।<verse eid="REV 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 6:9" />जत्‌यार हयु पांचवी सील तुड़्‌यु, ती चुखला चड़ावान जागान नेचु तेरी बेसकी आत्‌मा काजे देख्‌यु, जे भगवानेन बुले दीसराक सामळावणेन वजे सी, ने ईसुन गवा पुरावा देय करीन तीनुक मार नाखला। <verse eid="REV 6:9" /><verse number="10" style="v" sid="REV 6:10" />ने चे जुर सी आयड़ीन कह्‌यु, “ए मालीक, ए चुखला, ने छाचला; तु कां लग नीयाव नी करसी? ने धरतीन रहणे वाळा सी हामरा लुहीन पलटु कां लग नी लेसी?” <verse eid="REV 6:10" /><verse number="11" style="v" sid="REV 6:11" />ने तींद्‌रे मायन एक-एक जणा काजे धवेळो पुथल्‌यो देदलो छे, ने तीनुक कह्‌यो, की अळी ईतरीक वार लग आराम करु, जत्‌यार लग की तुंद्‌रु सगु सेवक ने भाय जे तुंद्‌रेन तसा मारायणे वाळा छे, तींद्‌री बी गिन्‌ती पुरी नी हय जाय।<verse eid="REV 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 6:12" />जत्‌यार हयु छटवी सील तुड़्‌यु, ती मे देख्‌यु धरती बेसके जुर सी हाकलाय; ने दाहड़ु काळ्‌ळा चादरान तसु काळ्‌ळु, ने आखु चांद लुहीन तसु हय गुयु। <verse eid="REV 6:12" /><verse number="13" style="v" sid="REV 6:13" />ने सरगेन तारा धरती पर असा पड़्‌या जसी आंधी सी हालीन अंजीर नावेन झाड़का मां सी काचला फळ झड़े। <verse eid="REV 6:13" /><verse number="14" style="v" sid="REV 6:14" />सरग असो सरकी गुयो, जसों पान्‌टो एलेट्‌णे सी सरकी जाय; ने हरेक बयड़ा, ने काळ पाणी, आपणा-आपणा जागा सी टळ गुया। <verse eid="REV 6:14" /><verse number="15" style="v" sid="REV 6:15" />धरतीन राजा, ने मुख्‌या, ने सीपायड़ा डाहला, ने मातला, ने ताकतवाळा माणसे, ने हरेक सेवक, ने हरेक छुटला, बयड़ान दरे ने चापर्‌या मां जाय्‌न डुकाया; <verse eid="REV 6:15" /><verse number="16" style="v" sid="REV 6:16" />ने बयड़ा, ने चापर्‌या सी कहणे लाग्‌या, “हामरे पर पड़ जावु; ने हामुक तेरा मुंहडा सी जु राजगादी पर बठ्‌लु छे ने गाडरान पीलान रीस सी हामु काजे बचाड़ लेवु; <verse eid="REV 6:16" /><verse number="17" style="v" sid="REV 6:17" />काहाकी तींद्‌रा रीसेन दुखेन दाहड़ा आय गुयलो छे, हय कुण उबु हय सक्‌से?”<verse eid="REV 6:17" /></para>
  <chapter eid="REV 6" />
  <chapter number="7" style="c" sid="REV 7" />
  <para style="s">एक लाख चाळीस-ने-चार हजार माणसेक भगवान बचाड़े</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 7:1" />तेरे पछेन मे धरतीन चारु खुणा पर चार सरग वाळा काहवाळ्‌याक उभला देख्‌यु, चे धरतीन चारु वाहळा काजे धरीन राख र्‌या काहाकी धरती, नीते दरीया, नीते काहनाक झाड़का पर, वाहळ नी चाले। <verse eid="REV 7:1" /><verse number="2" style="v" sid="REV 7:2" />तत्‌यार मे एक अळी सरग वाळा काहवाळ्‌याक जीवला भगवानेन सील लीन उगवणु सी उपर आवते देख्‌यु; हयु तीनु चारु सरग वाळा काहवाळ्‌या सी तीनुक धरती ने दरीयान नुकसाण करनेन हक देदलु हतलु, जुर सी आयड़ीन कह्‌यु, <verse eid="REV 7:2" /><verse number="3" style="v" sid="REV 7:3" />“जत्‌यार लग हामु आपणा भगवानेन सेवक्‌यान नींडाळे पर सील नी लागाड़ देय, तत्‌यार लग धरती ने दरीया ने झाड़कान नुकसाण घुण करे।” <verse eid="REV 7:3" /><verse number="4" style="v" sid="REV 7:4" />ने जीनु पर सील हतली, मे तींद्‌री गिन्‌ती सामळ्‌यु, की ईस्‌रायेलेन पुर्‌यान आखा कुळ मां सी एक लाख चाळीस ने चार हजार पर मुहर लागली हतली, <verse eid="REV 7:4" /><verse number="5" style="v" sid="REV 7:5" />यहुदान कुळ मां सी बारे हजार पर सील लागली हतली, रुबेनेन कुळ मां सी बारे हजार पर, गादेन कुळ मां सी बारे हजार पर, <verse eid="REV 7:5" /><verse number="6" style="v" sid="REV 7:6" />आसेरेन कुळ मां सी बारे हजार पर, नप्‌तालीन कुळ मां सी बारे हजार पर; मनस्‌सेन कुळ मां सी बारे हजार पर, <verse eid="REV 7:6" /><verse number="7" style="v" sid="REV 7:7" />सीमोनेन कुळ मां सी बारे हजार पर, लेवीन कुळ मां सी बारे हजार पर, ईस्‌साकारेन कुळ मां सी बारे हजार पर, <verse eid="REV 7:7" /><verse number="8" style="v" sid="REV 7:8" />जबुलुनेन कुळ मां सी बारे हजार पर, युसुफेन कुळ मां सी बारे हजार पर, बीन्‌यामीनेन कुळ मां सी बारे हजार पर सील देदली हतली।<verse eid="REV 7:8" /></para>
  <para style="s">बेसका माणसेन एक टुळु</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 7:9" />तेरे पछेन मे नींगा कर्‌यु, ने हरेक जाती, ने कुळ, ने माणसे ने बुली मां सी एक असी मटी गड़दी, जीनीक कुय गीण नी सकतेलो धवळा पुथल्‌या पेहेरलु ने आपसा हात मां खजुरेन डाळ्‌या लीन राजगादी अगळ ने गाडरान पीला अगळ उबी छे; <verse eid="REV 7:9" /><verse number="10" style="v" sid="REV 7:10" />ने जुर सी आयड़ीन कहें, “छुटकारा वाटे आपणा भगवानेन, जु राजगादी पर बठलु छे, ने गाडरान जय-जय हवे।” <verse eid="REV 7:10" /><verse number="11" style="v" sid="REV 7:11" />ने आखा सरग वाळा काहवाळ्‌या, तीनी राजगादी ने डाहा-बुड़ा ने चारु जनवार्‌यान चारे मेर उबला छे, तत्‌यार चे राजगादी अगळ मुंहडान भुरसे पड़्‌या, ने भगवान काजे आंधीन कह्‌या, <verse eid="REV 7:11" /><verse number="12" style="v" sid="REV 7:12" />“आमीन, हामरा भगवानेन बड़ाय, सेक-सींगार, अकल, वारु कह्‌णु, ने आव-भाव, ने ताकत ने ताकत जलम बणीन रहे।”<verse eid="REV 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 7:13" />ईनु आड़ा-बुड़ा मां सी एक मारे सी कह्‌यु, “चे धवळा पुथल्‌या पेहेरलु कुण छे, ने कां सी आवलु छे?” <verse eid="REV 7:13" /><verse number="14" style="v" sid="REV 7:14" />मे तेरे सी कह्‌यु, ए मालीक, तुत जाणे, जे तीना मट्‌ली गरा सी नीकळीन आवला छे,</para>
  <para style="p" vid="REV 7:14">जे आपणा-आपणा पुथल्‌या गाडरान पीलान लुही मां धुवीन धवळा करला छे। <verse eid="REV 7:14" /><verse number="15" style="v" sid="REV 7:15" />तेरेमां चे भगवानेन राजगादी अगळ छे, ने तीना मंदीर मां रात दाहड़ु तेरी सेवा करे; ने जु राजगादी पर बठलु छे, हयु तींद्‌रे उपर आपसान तम्‌बु ताणसे। <verse eid="REV 7:15" /><verse number="16" style="v" sid="REV 7:16" />“चे पछा भुकला ने तीसला नी हवसे; ने नी तीनु पर तप, नी काय तांत्‌लो पड़से। <verse eid="REV 7:16" /><verse number="17" style="v" sid="REV 7:17" />काहाकी गाडरान पीलो जु राजगादीन ईचमां छे, तींद्‌री राखवाळी करसे; ने तीनुक जीवन सारका उंहता पाणी धड़े लीजाया करसे, ने भगवान तींद्‌रा डुळाम सी आखा आसा नुछ देसे।”<verse eid="REV 7:17" /></para>
  <chapter eid="REV 7" />
  <chapter number="8" style="c" sid="REV 8" />
  <para style="s">सातवी सील</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 8:1" />जत्‌यार हयु सातवी सील खुली, ती सरग मां आधु घंटु लग हुगात रय गुयला। <verse eid="REV 8:1" /><verse number="2" style="v" sid="REV 8:2" />ने मे तीनु सातु सरग वाळा काहवाळ्‌या काजे जु भगवान अगळ हुबा रवे, देख्‌यु, ने तीनुक सात फेप्‌या आपला हतला।<verse eid="REV 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 8:3" />तत्‌यार एक अळी सरग वाळु काहवाळ्‌यु सनान धुपदेण्‌यो वाटको लीन आयु, ने चड़ावान जागा धड़े हुबु रय र्‌यु; ने तीनाक बेसका धुप देदलो छे काहाकी आखा चुखला माणसेन दुवा भेळ सनान तीना चड़ावान जागा पर, जु राजगादीन अगळ छे चड़ावे। <verse eid="REV 8:3" /><verse number="4" style="v" sid="REV 8:4" />ने तीना धुपेन कुळ्‌ळु चुखला माणसेन दुवा साते सरग वाळा काहवाळ्‌यान हात सी भगवान भीणी पुगी गुयो। <verse eid="REV 8:4" /><verse number="5" style="v" sid="REV 8:5" />तत्‌यार सरग वाळा काहवाळ्‌या धुपदेण्‌यो वाटको वेदीन्‌चां लीन आयु ,ने तीना वेदीन्‌चां ली जाय्‌न तीना आटका मां आकठो भर्‌यु, ने धरती पर नाख देदु, ने ईजळी ककड़ने बाजी गुय, ने गाजुण ने धरती हालने बाजी गुय।<verse eid="REV 8:5" /></para>
  <para style="s">सात फेप्‌या</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 8:6" />ने चे सातु सरग वाळा काहवाळ्‌या तींद्‌रे धड़े सात फेप्‌या हतला, वाजाड़ने करीन तीयार हया।<verse eid="REV 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 8:7" />ने जत्‌यार पेहलु सरग वाळु काहवाळ्‌यु फेप्‌यो वाजाड़्‌यु, ने गारे लुही ने आकठो मां भेसकायन धरती पर नाख देदु; ने तीन मां सी एक हीस्‌सान धरती धपी गुई, ने तीन मां सी एक हीस्‌सान झाड़का धपी गुया, ने आखु नीळ्‌ळु चारु बी धपी गुयु।<verse eid="REV 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 8:8" />ने जत्‌यार दीसरु सरग वाळु काहवाळ्‌यु फेप्‌यो वजाड़्‌यु, ती असो लाग्‌यो की मटला बयड़ान तसो एक धपतेला एक मटला बयड़ाक दरीया मां नाख्‌यु; ने दरीया बी तीन हीस्‌सा मां सी एक हीस्‌सु लुही बण गुयु। <verse eid="REV 8:8" /><verse number="9" style="v" sid="REV 8:9" />ने दरीयान तीन मां सी एक हीस्‌सान घड़्‌ली चीज, जी जीवली हतली मर गुई, ने तीन मां एक हीस्‌सान पाणीम चालन्‌या ढंड्‌यो नास हय गुया।<verse eid="REV 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 8:10" />तीसरु सरग वाळु काहवाळ्‌यु फेप्‌यो फुक्‌यु, ने एक मट्‌लु तारु जु मसाल तारान तसों धपतेलो, सरग सी टुट्‌यो, ने नदीन तीन मां सी एक हीस्‌सा पर, ने उंहता पाणी झीरे पर आय पड़्‌यु। <verse eid="REV 8:10" /><verse number="11" style="v" sid="REV 8:11" />तीना तारान नाव धतुरो छे, ने तीन मां सी एक हीस्‌सा पाणी धतुरान तसों कड़वोझण हय गुयो, ने बेसका माणसे तीना कड़वा पाणीक पीन मर गुया।<verse eid="REV 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 8:12" />चोवथु सरग वाळु काहवाळ्‌यु फेप्‌यो फुक्‌यु, ने दाहड़ान, चांदेन ने तारान, तीन हीस्‌सा मायन एकेक हीस्‌सा पर गरा आवी, अतरो बी की दीसुन तीन हीस्‌सा मायन एक हीस्‌सा पर बी आंदारो हय गुयो ने राती बी तीन घड़ी मायन एक घड़ी पर चांद ने तारा नी भबळ्‌या।<verse eid="REV 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 8:13" />जत्‌यार मे अळी देख्‌यु, ती सरगेन ईचमां एक घुवड़ा काजे उड़तेला ने उचा अवाज सी असु कवता सामळ्‌यु, “ने तीनु सरग वाळा काहवाळ्‌यान फेप्‌यान अवाजेन वजे तींद्‌रो फुकणु हाल बाकी छे, धरती पर रहणे वाळा पर हाय, हाय, हाय!”<verse eid="REV 8:13" /></para>
  <chapter eid="REV 8" />
  <chapter number="9" style="c" sid="REV 9" />
  <para style="s">पांचवों फेप्‌यो वाजाड़नु</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 9:1" />जत्‌यार पांचवु सरग वाळु काहवाळ्‌यु फेप्‌यो फुक्‌यु, ती मे सरग सी धरती पर एक तारु नेचु पड़तेलु देख्‌यु, ने तीनाक उंडला कुंडेन<note caller="+" style="f"><char style="fr" closed="false">9:1 </char><char style="ft" closed="false">जां भुतड़ा काजे मेल रहे</char></note> कुची देदली हतली। <verse eid="REV 9:1" /><verse number="2" style="v" sid="REV 9:2" />हयु उंडला कुंड काजे खुल्‌यु, ने कुंड मां सी मट्‌ली भट्‌टीन तसों कुळु उठ्‌यु, ने कुंडेन कुळा सी दाहड़ु ने वाहळी पर आंदारो छावाय गुयो। <verse eid="REV 9:2" /><verse number="3" style="v" sid="REV 9:3" />तीना कुळा मां सी धरती पर टिड्‌डा नीकळ्‌या, ने तीनुक धरतीन ईछान तसा ताकत आपली छे। <verse eid="REV 9:3" /><verse number="4" style="v" sid="REV 9:4" />तीनुक कह्‌लो छे की नी धरतीन चाराक, नी काहनीक मेरेक, ने नी काहनाक झाड़काक नुकसाण करे, बाकुन तीनु माणसेन अतरात नुकसाण करजु जींद्‌रे नींडाळा पर भगवानेन सील नी हय। <verse eid="REV 9:4" /><verse number="5" style="v" sid="REV 9:5" />ने तीनु माणसेक मार नाखणेन ती नी, बाकुन पांच महना लग माणसेक दुख देणेन हक आपलो हतलो; ने तींद्‌रु दुख असु हतलु, जसु ईछु चावणे सी माणसेन दुखे। <verse eid="REV 9:5" /><verse number="6" style="v" sid="REV 9:6" />तीनु दाहड़ा मां माणसे मुत हेरसे, ने मुत नी जड़से, ने मरने चाहसे, ने मुत तींद्‌रे सी ढास्‌से।<verse eid="REV 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 9:7" />चे टिड्‌डा घुल्‌लान तसा लड़ाय करने करीन तीयार हया, ने तींद्‌रा मुणका पर मानु सनान मुड़ हतली; ने तींद्‌रा मुंहडा माणसेन तसा हतला। <verse eid="REV 9:7" /><verse number="8" style="v" sid="REV 9:8" />तींद्‌रा कान्‌या बायरीन कान्‌यान तसा, ने दात नाहरेन दात जसा हतला। <verse eid="REV 9:8" /><verse number="9" style="v" sid="REV 9:9" />चे लुहड़ान तसों लुहड़ान झीलम पेहरला हतला, ने तींद्‌रा पाखड़ान अवाज असो हतलो जसा घुड़ागाड्‌या ने घुल्‌ला दवड़े। <verse eid="REV 9:9" /><verse number="10" style="v" sid="REV 9:10" />तींद्‌री छेम्‌टी ईछान तसी हतली, ने तेरेमां आवळ हतली, ने तीनुक पांच महना लग माणसे काजे नुकसाण करनेन जी ताकत जड़ली हतली, ची तींद्‌री छेम्‌टी मां हतली। <verse eid="REV 9:10" /><verse number="11" style="v" sid="REV 9:11" />उंडला कुंडेन सरग वाळु काहवाळ्‌यु तीनु पर राजु हतलु, तेरो नाव ईब्‌रानीयो मां अबद्‌योन, ने युनानी मां अपुल्‌लयोन छे।<verse eid="REV 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 9:12" />पेहली गरा वीत गुयली छे, हय हेरे बात दुय गरा अळी आवणे वाळी छे।<verse eid="REV 9:12" /></para>
  <para style="s">छटवो फेप्‌यो वाजाड़नु</para>
  <para style="p">
    <verse number="13" style="v" sid="REV 9:13" />जत्‌यार छटवु सरग वाळु काहवाळ्‌यु फेप्‌यो फुक्‌यु ती जु सनान चड़ावान जागु भगवान अगळ छे तींद्‌रा सींगड़ा मां सी मे असु अवाज सामळ्‌यु, <verse eid="REV 9:13" /><verse number="14" style="v" sid="REV 9:14" />मानु कुय छटवु सरग वाळा काहवाळ्‌या सी, तेरे धड़े फेप्‌यो हतलो कह्‌णे बाजी र्‌यु, “तीनु चारु सरग वाळा काहवाळ्‌या काजे मट्‌ली नदी फरात धड़े बांदायला छे, खुल दे।” <verse eid="REV 9:14" /><verse number="15" style="v" sid="REV 9:15" />ने चे चारु सरग वाळा काहवाळ्‌याक छुड़ी देदा जे तीनी घड़ी, ने दाहड़ु, ने महना, ने साल भर वाटे माणसेन तीन हीस्‌सा मायन एक हीस्‌सा काजे मार नाखणे करीन तीयार करला हतला। <verse eid="REV 9:15" /><verse number="16" style="v" sid="REV 9:16" />तींद्‌री सीपायड़ान सवारीन गिन्‌ती वीस कुरुड़ हतली; मे तींद्‌री गिन्‌ती सामळ्‌यु। <verse eid="REV 9:16" /><verse number="17" style="v" sid="REV 9:17" />ने मेसेक चे घुल्‌ला ने घुल्‌ला पर बठी रवला देखाव पड़्‌या, तींद्‌री छाती पर लुहड़ान झीलम्‌या आकठान तसा रातला, नीलमणीन तसा नीळ्‌ळा, ने गन्‌धकेने तसा पेळ्‌ळा हतला, तीनु घुल्‌लान मुणका नाहरेन तसा हतला: ने तींद्‌रा मुंहडा सी आकठो, कुळु, ने गन्‌धक नीकळतेलो। <verse eid="REV 9:17" /><verse number="18" style="v" sid="REV 9:18" />ईनु तीनु रुग्‌टान; मतलब आकठो, कुळु, गन्‌धक सी, जो तींद्‌रा मुंहडा सी नीकळतेलो, माणसेन तीन हीस्‌सा मायन एक हीस्‌सु माराय गुया। <verse eid="REV 9:18" /><verse number="19" style="v" sid="REV 9:19" />काहाकी तीनु घुल्‌लान ताकत तींद्‌रा मुंहडा, ने तींद्‌रा छेम्‌टा मां छे; काहाकी तींद्‌रा छेम्‌टा घड़सान तसा हतला, ने तीनु छेम्‌टान मुणका बी हतला, ने तींद्‌रे सीत चे नुकसाण करे।<verse eid="REV 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 9:20" />रवला माणसे जे तीनु हाड़ाम सी नी मर्‌या, आपसा हातेन कामे सी मन नी फेरव्‌या, काहाकी भुतड़ान आत्‌मान, ने सनो, चांदी, पीतळ, दगड़ु, ने धुळान मुरतीन पुजा नी करे, जे नी देखे, नी सामळे, ने नी चाल सके। <verse eid="REV 9:20" /><verse number="21" style="v" sid="REV 9:21" />ने जे खुन, ने जादु टुणा, ने छीनाळो, ने चुरी, चे करला हतला, तींद्‌रे सी मन नी फेरव्‌या।<verse eid="REV 9:21" /></para>
  <chapter eid="REV 9" />
  <chapter number="10" style="c" sid="REV 10" />
  <para style="s">सरगेवाळु काहवाळ्‌यु ने नानली किताप</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 10:1" />तत्‌यार मे एक अळी ताकत भर्‌यु सरग वाळा काहवाळ्‌याक वादळा सी छावायलु सरग सी उतेरतेलो देख्‌यु; ने तेरा मुणका पर धंदलीन तसों बम हतलु, ने तेरो मुंहडो दाहड़ान तसों ने तेरा पांय आकठान खाम्‌बान तसा हतला; <verse eid="REV 10:1" /><verse number="2" style="v" sid="REV 10:2" />ने तेरा हात मां एक नानली सी खुल्‌ली किताप हतली। हयु आपसु जेवड़्‌यु पांय दरीया पर, ने डाखर्‌यु धरती पर मेक्‌यु; <verse eid="REV 10:2" /><verse number="3" style="v" sid="REV 10:3" />ने असला मटा अवाज मां आयड़्‌यु, जसु नाहर डकारे; ने जत्‌यार हयु आयड़्‌यु ती डकारनेन सात अवाज सामळाय। <verse eid="REV 10:3" /><verse number="4" style="v" sid="REV 10:4" />जत्‌यार सातु गाजणेन अवाज सामळी लेदला, ती मे लिखणेत वाळु हतलु, ने मेसे सरग सी असी अवाज सामळाय, “जी वात गाजणेन तीनु सात अवाज सी सामळ्‌यु, तीनुक ढाकी राख, ने मां लिखे।”<verse eid="REV 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 10:5" />तीना सरग वाळा काहवाळ्‌या काजे मे दरीया ने धरती पर उबु रवलु देख्‌यु; हयु आपसु जेवड़्‌यु हात सरग भीणी हाकल्‌यु <verse eid="REV 10:5" /><verse number="6" style="v" sid="REV 10:6" />ने तेरी सगुन खाय्‌न जु जलम जीवलु छे, ने जु सरग काजे ने जो काय तेरेमां छे, ने धरती काजे ने जो काय तेरे पर छे, ने दरीया काजे ने जो काय तेरेमां छे, घड़ायलो छे तेरीत सगुन खाय्‌न कह्‌यु की “हय अळी वार नी लागसे।” <verse eid="REV 10:6" /><verse number="7" style="v" sid="REV 10:7" />बाकुन सातवों सरग वाळा काहवाळ्‌या काजे अवाज देणेन दाहड़ा मां, जत्‌यार हयु फेप्‌यो फुकणे पर रवसे, ती भगवानेन चो सातायलो पुरो हय जासे, तेरो खुस-खबर हयु आपसा सेवक अघली वात बताड़ने वाळाक देदलु।<verse eid="REV 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 10:8" />तत्‌यार अवाज करने वाळाक मे सरग सी बुलतेला सामळ्‌यु, हयु अळी मारे साते वात करने लाग्‌यु, “जां, जु सरग वाळु काहवाळ्‌यु दरीया ने धरती पर उबलु छे, तेरा हाते मायन खुल्‌ली किताप ली ले।”<verse eid="REV 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 10:9" />ने मे सरग वाळा काहवाळ्‌या धड़े जाय्‌न कह्‌यु, “जी नानली किताप मेसे आप।” ने चु मेसेक कह्‌यु, “ले, ईनीक खाय ले। जी तारो पेट कड़वो ते करसे, बाकुन तारा मुंहडा मां मुहाळेन तसों गुळो लागसे।”<verse eid="REV 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 10:10" />तेरेमां मे ची नानली किताप तीना सरग वाळा काहवाळ्‌यान हाते सी लीन खाय गुयु। ची मारे मुंहडा मां मुहाळेन तसों गुळो ते लाग्‌यो, बाकुन जत्‌यार मे तीनाक खाय गुयु, ती मारो पेट कड़वो हय गुयो। <verse eid="REV 10:10" /><verse number="11" style="v" sid="REV 10:11" />तत्‌यार मारे सी असो कह्‌यो, “तुसे बेसका माणसे, जाती, बुली, ने राजान बारामां अळी अगली हवणे वाळी वात बताड़नु पड़से।”<verse eid="REV 10:11" /></para>
  <chapter eid="REV 10" />
  <chapter number="11" style="c" sid="REV 11" />
  <para style="s">दुय गवा</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 11:1" />तत्‌यार मेसेक मापणे करीन एक सुटी देदु, ने काहनुक कह्‌यु, “उठ, भगवानेन मंदीर ने चड़ावान जागु, ने तींद्‌रेम भक्‌ती करने वाळाक नाप ले। <verse eid="REV 11:1" /><verse number="2" style="v" sid="REV 11:2" />बाकुन मंदीरेन बाहरलो आंगणो छुड़ दे; तीनाक मां नापे काहाकी चे दीसरी जाती काजे देदलो छे, ने चे चुखला सहर काजे बय्‌यालीस महना लग रंदळसे। <verse eid="REV 11:2" /><verse number="3" style="v" sid="REV 11:3" />ने मे मारा दुय गवा काजे जु हक दीस की गंटाट्‌या पांगरला एक हजार दुय सोव सांठ दाहड़ा लग भगवानेन खबर फेलाया करे।”<verse eid="REV 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 11:4" />जे चेत जेतुनेन दुय झाड़का ने दुय दिवा छे, जे धरतीन मालीक अगळ उबा रहे। <verse eid="REV 11:4" /><verse number="5" style="v" sid="REV 11:5" />ने कदी काहनुक तीनुक नुकसाण करने चाहसे, ती तींद्‌रे मुंहडा सी आकठो नीकळीन तींद्‌रा वेरी काजे नास करे, ने कदी काहनुक तीनुक नुकसाण करनु चाहसे, ती छाचली ईनीत रीती सी माराय जासे। <verse eid="REV 11:5" /><verse number="6" style="v" sid="REV 11:6" />तीनुक हक छे, की सरग काजे बंद करे, काहाकी तीनुक भगवानेन खबर फेलावणेन दाहड़ाम पाणी नी पड़े, ने तीनुक आखा पाणी पर बी हक छे, की तीना पाणीक लुही बणावे, ने जत्‌यार चाहे तत्‌यार धरती पर आखी भातीन गरा लावे।<verse eid="REV 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 11:7" />जत्‌यार चे आपसी गवाय दी देसे, ती चु जनवार्‌या जु उंडला कुंड मां सी नीकळसे, तींद्‌रे सी लड़ीन तीनुक जीतसे ने तीनुक मार नाखसे। <verse eid="REV 11:7" /><verse number="8" style="v" sid="REV 11:8" />ने तींद्‌रा धड़ तीना मटला सहरेन गळ्‌या मां पड़ला रवसे, जु आत्‌मान रीती सी सदोम ने मीसर कहवाये, जां तींद्‌रु मालीक बी कुरुस पर चड़ावलु हतलु। <verse eid="REV 11:8" /><verse number="9" style="v" sid="REV 11:9" />ने आखा माणसे, कुळी, बुली, ने जाती मां सी माणसे तींद्‌रा धड़ काजे साड़ी तीन दाहड़ा लग देखता रवसे, ने तींद्‌रा धड़ काजे गाड़नी नी देसे। <verse eid="REV 11:9" /><verse number="10" style="v" sid="REV 11:10" />ने धरती मां रहणे वाळा तींद्‌रे मरने सी खुस हवसे, ने एक दीसरा काजे नेवता मकलसे, काहाकी जे दुय अघली वात बताड़ने वाळा धरती मां रहणे वाळा काजे दमला छे। <verse eid="REV 11:10" /><verse number="11" style="v" sid="REV 11:11" />बाकुन साड़ी तीन दाहड़ान पछेन भगवान सी आवलु जीवनेन दम तेरेमां आय गुयु; ने चे आपसा पायेन भुरसे उबा हय गुया, ने तीनु देखणेवाळा पर मटलो बीहाणो भराय गुयो। <verse eid="REV 11:11" /><verse number="12" style="v" sid="REV 11:12" />ने तीनुक सरग सी एक मट्‌ली अवाज सामळाय, “जां उपर आवु!” असो सामळतात चे वादळा पर सवार हय्‌न आपसान वेरी काजे देखता-देखता सरग पर चहड़ी गुया। <verse eid="REV 11:12" /><verse number="13" style="v" sid="REV 11:13" />ने तीनीत घड़ी धरती बेसकी हालने लागी, ने सहरेन दस हीस्‌सा मायन एक हीस्‌सु उदरी गुयु; ने धरती हालने सी सात हजार माणसे मर गुया ने रवला सीयारी ली लेदा, ने सरगेन भगवानेन सेक-सींगार कर्‌या।<verse eid="REV 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 11:14" />सामळु दीसरी गरा वीत गुय; तत्‌यार, तीसरी गरा मामारुत आवणेवाळी छे।<verse eid="REV 11:14" /></para>
  <para style="s">सातवों फेप्‌यो</para>
  <para style="p">
    <verse number="15" style="v" sid="REV 11:15" />जत्‌यार सातवु सरग वाळु काहवाळ्‌यु फेप्‌यो फुक्‌यु, ती सरग मां हेरे बारामां जुर-जुर आयड़ीन अवाज मां कहणे लाग्‌या, “दुनीयान राज हामरा मालीकेन ने तेरा मसीन हय गुयो ने हयु जलम राज करसे।” <verse eid="REV 11:15" /><verse number="16" style="v" sid="REV 11:16" />ने वीस ने चार मुख्‌या डाहला जे भगवान अगळ आपसा-आपसा राजगादी पर बठला हतला, मुंहडान भुरसे पड़ीन भगवान काजे आंधीन, <verse eid="REV 11:16" /><verse number="17" style="v" sid="REV 11:17" />असा कहणे लाग्‌या,</para>
  <para style="q1" vid="REV 11:17">“ए आखाम सी ताकतवाळा मालीक भगवान, जु छे ने जु हतलु,</para>
  <para style="q1" vid="REV 11:17">हामु बेसकु वारु छे करीन कवजे की,</para>
  <para style="q2" vid="REV 11:17">तु आपसान मट्‌ली ताकत काजे काम मां लावीन राज करलु छे।<verse eid="REV 11:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="REV 11:18" />नी-यहुदी रीस कर्‌या,</para>
  <para style="q2" vid="REV 11:18">ने तेरी रीस आय पड़्‌यु ने पली टेम आय गुयली छे,</para>
  <para style="q2" vid="REV 11:18">की मरला सरलान नीयाव हवे, ने तारु सेवक भगवानेन अघली वात बताड़ने वाळा,</para>
  <para style="q1" vid="REV 11:18">ने चुखला माणसे काजे,</para>
  <para style="q2" vid="REV 11:18">ने तीनु नानला मटान जे तारा नाव सी बीहे,</para>
  <para style="q2" vid="REV 11:18">बदलु देसे।</para>
  <para style="q1" vid="REV 11:18">ने धरतीन बीगाड़ने वाळा नास हवसे!”<verse eid="REV 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 11:19" />ने भगवानेन जु मंदीर सरग मां छे, उघाड़ी देदा, ने मंदीर मां भगवानेन बुलेन पेटी देखाय, वीजळ्‌या, अवाज, गाजण ने धरती हाली, ने बेसकु पाणी पड़्‌यु।<verse eid="REV 11:19" /></para>
  <chapter eid="REV 11" />
  <chapter number="12" style="c" sid="REV 12" />
  <para style="s">बायर ने अजगर</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 12:1" />तत्‌यार सरग पर एक मट्‌ली सहलाणी देखाय देदी, मतलब एक बायर ची दाहड़ु पेहरली हतली, ने चांद तेरे पांय तळे हतलु, ने तेरे मुणका पर बारे तारान मुड़ हतलु; <verse eid="REV 12:1" /><verse number="2" style="v" sid="REV 12:2" />ने ची भार पाये हय, ने आयड़तेली; काहाकी तेरे फवरी हवणेन दुख लागलु हतलु; ने ची फवरी हवणेन दुख मां हतली।<verse eid="REV 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 12:3" />एक अळी सहलाणी सरग मां देखाय देदी, एक मट्‌लु रातलु अजगर हतलु, तेरा सात मुणका ने दस सींगड़ा हतला, ने तेरा मुणका पर सात राज मुड़ हतलु। <verse eid="REV 12:3" /><verse number="4" style="v" sid="REV 12:4" />ने तेरी छेम्‌टी सरग सी तारान तीन हीस्‌सा काजे खेचीन धरती पर नाख देदु, ने चु अजगर तीनी बायरीन अगळ पुर्‌यो हतलो, चां हुबु हतलु, काहाकी जत्‌यार तेरो पुर्‌यो हवे ती तेरा पुर्‌या काजे घीटी जाय। <verse eid="REV 12:4" /><verse number="5" style="v" sid="REV 12:5" />ने ची पुर्‌याक पयदा करी जो लुहड़ान राजेन हक वाटे हयो, आखा जाती पर राज करनेत पर हतलु, ने तेरो पुर्‌यो भगवान धड़े, ने तेरा राजगादी धड़े हाकलीन मकली देदो। <verse eid="REV 12:5" /><verse number="6" style="v" sid="REV 12:6" />ने ची बायर पला जंगल मां ढासी गुई, जांहा भगवान भीणी सी तेरे वाटे एक जागु तीयार करलु हतलु की चां हयु एक हजार दुय सोव सांठ दाहड़ा लग पाळे।<verse eid="REV 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 12:7" />तत्‌यार सरग पर लड़ाय हय, मीकायेल ने तेरे सरग वाळा काहवाळ्‌या अजगर सी लड़ाय करने नीकळ्‌या; ने अजगर ने तेरा काहवाळ्‌या तेरे सी लड़ाया, <verse eid="REV 12:7" /><verse number="8" style="v" sid="REV 12:8" />बाकुन जीतायो नी, ने सरग मां तींद्‌रे वाटे अळी जागु नी रयु। <verse eid="REV 12:8" /><verse number="9" style="v" sid="REV 12:9" />ने चु मट्‌लु अजगर मतलब हयुत पुराणु घड़सु, जु भुतड़ु कहवाये, ने आखा दुनीया काजे भटकाड़ने वालु छे, धरती पर नाख देदा; ने तेरा सरग वाळा काहवाळ्‌या तेरे पुठ्‌येत उराटी देदा।<verse eid="REV 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 12:10" />तत्‌यार मे सरग सी असी अवाज आवतेली सामळ्‌यु, हय हामरा भगवानेन छुटकारु, ताकत, राज, ने तेरा मसीन हक उजेंतु हवलु छे; काहाकी हामरा भायस्‌ये पर गुनु लागाड़न्‌यु, जु रात दाहड़ु आपणा भगवान अगळ तीनु पर गुनु लागाड़्‌या करतेलु, उराटी देदा। <verse eid="REV 12:10" /><verse number="11" style="v" sid="REV 12:11" />ने चे गाडरान पीलान लुहीन वजे, ने तींद्‌री गवायन बुलेन वजे, तीना सी जीत्‌या, काहाकी चे आपसा जीव सी परमवाळु नी समज्‌या, जां लग की मरण बी सेण कर लेदा। <verse eid="REV 12:11" /><verse number="12" style="v" sid="REV 12:12" />“ईना वजे, ए आखा सरग, ने तींद्‌रेम रहणे वाळा खुस हवु; ए धरती, ने दरीया, तुंद्‌रे पर हाय! काहाकी भुतड़ु बेसकी रीसेन साते तुंद्‌रे धड़े उतरी आयु; काहाकी जाणे की तेरु थुड़ीक टेम अळी रवली छे।”<verse eid="REV 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 12:13" />जत्‌यार अजगर देख्‌यु, की मेसेक धरती पर उराटी देदा, ती तीनी बायर काजे जी पुर्‌याक पयदा करली, तीनीक दम्‌यु। <verse eid="REV 12:13" /><verse number="14" style="v" sid="REV 12:14" />बाकुन तीनी बायर काजे घुवड़ान दुय पाखड़ा देदला छे, की घड़सा अगळ सी उडीन जंगल मां पला जागा पर जाती रहे, जांहा ची एक टेम, ने बेसका टेमे, ने आधी टेम लग पाळाय जाय। <verse eid="REV 12:14" /><verse number="15" style="v" sid="REV 12:15" />ने घड़सु तीनी बायरी पछळ आपसा मुंहडा सी नदी तसों पाणी उहुवाड़्‌यु की तीनीक ईनी नदी सी उहाड़ी दम। <verse eid="REV 12:15" /><verse number="16" style="v" sid="REV 12:16" />बाकुन धरती तीनी बायरीन मदत करी, ने आपसीन मुंहडो फाड़ीन तीनी नदी काजे जु अजगर आपसे मुंहडे सी उहाड़लु, पी गुय। <verse eid="REV 12:16" /><verse number="17" style="v" sid="REV 12:17" />तत्‌यार अजगर काजे बायरी पर रीस आय, ने तेरी बचली अवल्‌यात सी जे भगवानेन हुकुम काजे माने, ने ईसुन गवाय देणे करीन काठा छे, लड़ाय करने करीन गुयु। <verse eid="REV 12:17" /><verse number="18" style="v" sid="REV 12:18" />ने चु दरीयान रेतळा पर जाय्‌न हुबु हय गुयु।<verse eid="REV 12:18" /></para>
  <chapter eid="REV 12" />
  <chapter number="13" style="c" sid="REV 13" />
  <para style="s">दुय जनवार्‌या</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 13:1" />मे एक जनवार्‌या काजे दरीया मां सी नीकळतेलो देख्‌यु, तेरा दस सींगड़ा ने सात मुणका हतला। तेरा सींगड़ा पर दस राज मुड़, ने तेरे मुणका पर भगवानेन नाव-बद्‌दीन नाव लिखला हतला। <verse eid="REV 13:1" /><verse number="2" style="v" sid="REV 13:2" />तीना जनवार्‌या काजे मे देख्‌यु, चो चीतान तसों हतलो; ने तेरा पांय रीछड़ान तसा, ने मुंहडो नाहरेन तसों हतलो। ने चु अजगर आपसी ताकत, ने आपसी राजगादी, ने मट्‌लु हक, तीनाक दी देदु। <verse eid="REV 13:2" /><verse number="3" style="v" sid="REV 13:3" />मे तेरा मुणका मां सी एक पर असु घाव लागलु देख्‌यु, मानु चु मरनेत वाळु छे; तत्‌यार तेरु जीव लेणे वाळु घाव वारु हय गुयु, ने आखी धरतीन माणसे तीना जनवार्‌यान पछळ-पछळ घाबराय्‌तात चाल्‌या। <verse eid="REV 13:3" /><verse number="4" style="v" sid="REV 13:4" />चे अजगरेन पुजा कर्‌या, काहाकी हयु जनवार्‌या काजे आपसु हक दी देदलु, ने असा करीन जनवार्‌यान पुजा कर्‌या की, “ईना जनवार्‌यान तसु कुण छे? कुण हेरे सी लड़ सके?” <verse eid="REV 13:4" /><verse number="5" style="v" sid="REV 13:5" />मटला बुल बुलने ने वाक नीकाळे करीन तीनाक एक मुंहडो आपलो छे, ने तीनाक चाळीस ने दुय महना लग काम करनेन हक आपलु छे। <verse eid="REV 13:5" /><verse number="6" style="v" sid="REV 13:6" />ने चु भगवानेन बदनाम करने करीन मुंहडो खुल्‌यु, की तेरो नाव ने तेरु रहणेन जागु तम्‌बु मतलब सरगेन रहणे वाळान नाव-बद्‌दी करे। <verse eid="REV 13:6" /><verse number="7" style="v" sid="REV 13:7" />तीनाक जु हक देदु, की चुखला माणसे सी लड़े, ने तींद्‌रे सी जीती जाय, ने तीनाक एक कुळ, माणसे, बुली, ने जाती पर हक देदलु छे। <verse eid="REV 13:7" /><verse number="8" style="v" sid="REV 13:8" />धरतीन चे आखा रहणे वाळा तींद्‌रा नाव तीना गाडरान पीलान जीवनेन किताप मां लिखायो नी, जो कळी घड़ायणेन टेमे सी मारायलो छे, तीना जनवार्‌यान पुजा करसुन।<verse eid="REV 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 13:9" />तेरा कान्‌टा छे चे सामळे। <verse eid="REV 13:9" /><verse number="10" style="v" sid="REV 13:10" />तीनाक जेल मां पड़नु छे, चु जेल मां पड़से, जु तलवार सी मारसे, छाचलीन छे की हयु तलवार सी मारायसे। चुखला माणसेन गम ने भुरसु एरे मां छे।<verse eid="REV 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 13:11" />तत्‌यार मे एक अळी जनवार्‌या काजे धरती मां सी नीकळतेलो देख्‌यु, तेरा गाडरान पीलान तसा दुय सींगड़ा हतला; ने हयु अजगरेन तसु बुलतेलु। <verse eid="REV 13:11" /><verse number="12" style="v" sid="REV 13:12" />जु तीना पेहला जनवार्‌यान आखा हक तेरे अगळ काम मां लावतेलु, ने धरती ने तेरा रहणे वाळा सी तीना पेहला जनवार्‌यान, तेरु जीव लेणे वाळु घाव वारु हय गुयलु, पुजा कराड़तेलु। <verse eid="REV 13:12" /><verse number="13" style="v" sid="REV 13:13" />हयु मटा-मटा सहलाणी देखाड़तेलु, जां लग की माणसे अगळ सरग सी धरती पर आकठो पाड़तेलु। <verse eid="REV 13:13" /><verse number="14" style="v" sid="REV 13:14" />तीनु सहलाणीन वजे सी जीनुक तीनु जनवार्‌यान अगळ देखाड़नेन हक तीनाक देदलु हतलु; हयु धरतीन रहणे वाळाक ईनी भाते भटकाड़तेलु, की धरतीन रहणे वाळा सी कवतेलु की तीना जनवार्‌याक तलवार लागली, हयु जीवी गुयु, तेरी मुरती बणावु। <verse eid="REV 13:14" /><verse number="15" style="v" sid="REV 13:15" />ने तीनाक तीना जनवार्‌यान मुरती मां जीव नाखणेन हक देदलु हतलु, की जनवार्‌यान मुरती बुलने लागे; ने जतरा माणसे तीना जनवार्‌यान मुरतीन पुजा नी करे, तीनुक माराड़ नाखे। <verse eid="REV 13:15" /><verse number="16" style="v" sid="REV 13:16" />ने हयु नानला-मटा, पयस्‌या वाळान-गरीब, छुटला-गुलाम आखान जेवड़्‌ये हाते नीते तींद्‌रा नींडाळे पर एक-एक छाप लागाड़ देदु, <verse eid="REV 13:16" /><verse number="17" style="v" sid="REV 13:17" />की तीनाक छुड़ीन तीना पर छाप मतलब तीना जनवार्‌यान नाव, नीते तेरा नावेन आकड़ु रवे, ने दीसरा कुय लेणु देणु नी कर सके।<verse eid="REV 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 13:18" />अक्‌कल हेरेत मां छे; तेरी अक्‌कल छे, हयु ईना जनवार्‌यान आकड़ा जुड़ ले, काहाकी हयु माणसेन आकड़ु छे, ने तेरा आकड़ा छव सोव सांठ ने छव छे।<verse eid="REV 13:18" /></para>
  <chapter eid="REV 13" />
  <chapter number="14" style="c" sid="REV 14" />
  <para style="s">गाडरा ने तेरा माणसे</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 14:1" />तत्‌यार मे देख्‌यु, ने देखु, हयो गाडरान पीलो सीयोन नावेन उंचा बयड़ा पर उबा हय रवला देख्‌यु, ने तेरे साते एक लाख चाळीस ने चार हजार माणसे छे, तींद्‌रा नींडाळे पर तेरो ने तेरे बासेन नाव लिखलो छे। <verse eid="REV 14:1" /><verse number="2" style="v" sid="REV 14:2" />ने सरग सी मेसेक एक अवाज सामळाय, चो पाणीन मटा सुसवणेन ने मटा गाजणेन तसों अवाज हतलो, ने जी अवाज मे सामळ्‌यु चो असो हतलो, मानु काहनाक झुणगा वाजाड़नेवाळा झुणगा वाजाड़ र्‌या। <verse eid="REV 14:2" /><verse number="3" style="v" sid="REV 14:3" />ने राजगादीन अगळ ने चारु जीव ने डाहला मुख्‌यान अगळ मानु, एक नवलो गीत गावतेला, ने तीनु एक लाख चाळीस ने चार हजार माणसेक छुड़ीन, जे धरती पर सी छुड़ावला हतला, कुय बी तीना गीत काजे सीक नी सकतेलो। <verse eid="REV 14:3" /><verse number="4" style="v" sid="REV 14:4" />जे चे छे, जे बायरा साते वीटळ्‌या नी, बाकुन कुवारला छे; जे चेत छे, की जां कांखुर गाडरान पीलो जाय, चे तेरे पछळ हय ले; जे ते भगवान ने गाडरा वाटे पेहलो फळ हवणे करीन माणसे मां सी छुड़ावला छे। <verse eid="REV 14:4" /><verse number="5" style="v" sid="REV 14:5" />ने तींद्‌रा मुंहडा सी कदी झुट नी नीकळतेलो, चे नी-गुना वाळा छे।<verse eid="REV 14:5" /></para>
  <para style="s">तीन सरग वाळा काहवाळ्‌या</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 14:6" />तत्‌यार मे एक अळी सरग वाळा काहवाळ्‌या काजे सरगेन ईचमां उडतेलो देख्‌यु तीना धड़े धरती पर रहणे वाळान हरेक जाती, कुळ, बुली, ने माणसेक सामळावणे करीन अमरेन खुस-खबर हतली। <verse eid="REV 14:6" /><verse number="7" style="v" sid="REV 14:7" />ने हयु मटा अवाज सी कह्‌यु, “भगवान सी बीहु, ने तेरु सेक-सींगार करु, काहाकी तेरु नीयाव करनेन टेम आय गुई; ने तेरी बड़ाय करु, जु सरग ने धरती ने दरीया ने पाणीन झीरे बणायु।”<verse eid="REV 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 14:8" />तत्‌यार तेरे पछेन एक अळी दीसरु सरग वाळु काहवाळ्‌यु असु कवतु आयु, “हीट पड़्‌यो, चु मट्‌लु बाबेल हीट पड़्‌यु जी आपसी छीनाळान पागलेन तसी दारु आखी जाती काजे पावाड़्‌या।”<verse eid="REV 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 14:9" />तेर पछळ एक अळी तीसरु सरग वाळु काहवाळ्‌यु मटी अवाज सी असु कवतु आयु, “जु काहनुक तीना जनवार्‌यान ने जीनी मुरतीन पुजा करे, ने आपसे नींडाळे नीते आपसे हाते पर तेरी छाप लेय, <verse eid="REV 14:9" /><verse number="10" style="v" sid="REV 14:10" />ती हयु भगवानेन रीसेन पीयालु चो पाखुर पाणी मीलाड़े, ने तेरा रीसेन दारु मां नाखली छे, पीसे ने चुखला सरग वाळा काहवाळ्‌या अगळ ने गाडरान पीला अगळ आकठो ने धपतेला गन्‌धकेन पीड़ा मां पड़से। <verse eid="REV 14:10" /><verse number="11" style="v" sid="REV 14:11" />ने तींद्‌री पीड़ान कुळु जलम उठतु रवसे, ने जु तीना जनवार्‌या ने तेरी मुरतीन पुजा करे, ने जे तेरे नावेन छाप लेय, तीनुक रात दाहड़ु चेन नी पड़से।”<verse eid="REV 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 14:12" />चुखला माणसेन गम हेरेमां छे, जे भगवानेन हुकुम काजे माने, ने ईसु पर भुरसु राखे।<verse eid="REV 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 14:13" />अळी मे सरग सी असु अवाज सामळ्‌यु, “लिख: मरने वाळा मालीक मां मरे, चे हय सी वारु छे।” आत्‌मा कहें,</para>
  <para style="p" vid="REV 14:13">“हव, काहाकी चे आपसा मेहनत सी सांतीक हेरसे, ने तींद्‌रा काम तींद्‌रे साते हय लेय।”<verse eid="REV 14:13" /></para>
  <para style="s">धरतीन फसलेन काटणी</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 14:14" />मे नींगा कर्‌यु, ने देखु, एक धवेळो वादळो छे, ने तीना वादळा पर माणसेन पुर्‌यान तसु काहनुक बठलु छे, ने तेरे मुणका पर सनान मुड़ ने हाते मां पांजावलु दातळु छे। <verse eid="REV 14:14" /><verse number="15" style="v" sid="REV 14:15" />तत्‌यार एक अळी सरग वाळु काहवाळ्‌यु मंदीर मां सी नीकळीन, तीनाक जु वादळा पर बठलु हतलु, जुर सी आयड़ीन कह्‌यु, “तारु दातळु लीन काटणी चालु कर, काहाकी काटणीन टेम आय गुई, ने धरतीन फसल पाकी गुई।” <verse eid="REV 14:15" /><verse number="16" style="v" sid="REV 14:16" />तेरेमां जु वादळा पर बठलु हतलु, चु धरती पर तेरु दातळु फेरव्‌यु, ने धरतीन काटणी चालु कर्‌यु।<verse eid="REV 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 14:17" />तत्‌यार एक अळी सरग वाळु काहवाळ्‌यु तीना मंदीर मां सी नीकळ्‌यु, जु सरग मां छे, ने तेरे धड़े बी पांजावलु दातळु हतलु।<verse eid="REV 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 14:18" />तत्‌यार एक अळी सरग वाळु काहवाळ्‌यु, तीनाक आकठा पर हक हतलु, चड़ावान जागा मां सी नीकळ्‌यु, ने तेरे धड़े पांजावलु दातळु हतलु, तीनाक उचा अवाज सी कह्‌यु, “तारु पांजावलु दातळु लागाड़ीन धरतीन अंगुरेन गुछ्‌छा काट ले; काहाकी तेरा अंगुर पाक गुयला छे।” <verse eid="REV 14:18" /><verse number="19" style="v" sid="REV 14:19" />तत्‌यार हयु सरग वाळु काहवाळ्‌यु धरती पर तेरु दातळु लागाड़्‌यु, ने धरतीन अंगुरेन फळ काटीन, तेरा भगवानेन रीसेन मटला रसेनकुंडा मां नाख देदु। <verse eid="REV 14:19" /><verse number="20" style="v" sid="REV 14:20" />ने गांवेन बाहर तीना रसेनकुंडा मां अंगुर रंदळाय गुया, ने रसेनकुंडा मां सी अतरो लुही नीकळ्‌यो की घुल्‌लान रासे लग पुग्‌यो, ने तीन सोव कीलु मीटर लग उही गुयो।<verse eid="REV 14:20" /></para>
  <chapter eid="REV 14" />
  <chapter number="15" style="c" sid="REV 15" />
  <para style="s">आकरी गरा साते सरग वाळा काहवाळ्‌या</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 15:1" />तत्‌यार मे सरग सी एक अळी मटलो ने तेरेन तसों सहलाणी देख्‌यु, मतलब सात सरग वाळा काहवाळ्‌या तींद्‌रे धड़े सातु आकरी गरा हतली, काहाकी तीनी गरान हवणेन पछे भगवानेन रीस आकरी छे।<verse eid="REV 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 15:2" />ने मे आकठाम भेसकायलो कांचेन तसों एक दरीयों देख्‌यु, ने जे माणसे तीना जनवार्‌या सी ने तीनी धुळान मुरती सी, ने तेरे नावेन आकड़ा सी जीतला, तीनुक तीना आरस्‌यान तसों दरीया धड़े भगवानेन झुणगा काजे लीन हुबु रवलु देख्‌यु। <verse eid="REV 15:2" /><verse number="3" style="v" sid="REV 15:3" />ने चे भगवानेन सेवक मुसान गीत, ने गाडरान पीलान गीत गाय गाय्‌न कवतेला,</para>
  <para style="q1" vid="REV 15:3">“ए आखाम सी ताकत भर्‌या,</para>
  <para style="q2" vid="REV 15:3">मालीक भगवान, तारा काम मटला ने तेरेन तसों दीसरो नी हय,</para>
  <para style="q1" vid="REV 15:3">ए जाती-जातीन राजा,</para>
  <para style="q2" vid="REV 15:3">तारी चाल वारलु ने संय छे।”<verse eid="REV 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="REV 15:4" />“ए मालीक, कुण तारे सी नी बीहसे?</para>
  <para style="q2" vid="REV 15:4">ने तारे नावेन सेक-सींगार नी करसे?</para>
  <para style="q2" vid="REV 15:4">काहाकी तु अतरुत चुखलु छे,</para>
  <para style="q1" vid="REV 15:4">ने आखी जाती आवीन तारे,</para>
  <para style="q2" vid="REV 15:4">अगळ आवीन बड़ाय करसे,</para>
  <para style="q2" vid="REV 15:4">काहाकी तारा नीयावेन काम उजेंतो हय गुयलो छे।”<verse eid="REV 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 15:5" />हेरे पछे मे देख्‌यु, की सरग मां वायदान तम्‌बान मंदीर उघाड़्‌या, <verse eid="REV 15:5" /><verse number="6" style="v" sid="REV 15:6" />ने चे सातु सरग वाळा काहवाळ्‌या तींद्‌रे धड़े सातु गरा हतली, चुखा उजल्‌ळा ने चमकण्‌या पुथल्‌या पेहरला ने छाती पर सनान पट्‌टा बांदला मंदीर सी नीकळ्‌या। <verse eid="REV 15:6" /><verse number="7" style="v" sid="REV 15:7" />तत्‌यार तीनु चारु जनवार्‌या मां सी एक तीनु सात सरग वाळा काहवाळ्‌यान भगवानेन, जु जलम जीवतु छे, रीस सी भरला सात सनान कटवरा आप्‌यु। <verse eid="REV 15:7" /><verse number="8" style="v" sid="REV 15:8" />ने भगवानेन सेक कुळा सी सींगार, ने तेरी ताकुतेन वजे सी मंदीर कुळा सी भराय गुयु, ने जत्‌यार लग तीनु सातु सरग वाळा काहवाळ्‌यान सातु गरा सरी नी, तत्‌यार लग काहनु बी मंदीर मां जाय नी सक्‌यो।<verse eid="REV 15:8" /></para>
  <chapter eid="REV 15" />
  <chapter number="16" style="c" sid="REV 16" />
  <para style="s">भगवानेन रीसेन सात कटवरा</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 16:1" />तत्‌यार मे मंदीर मां काहनाक काजे उचा अवाज सी तीनु सातु सरग वाळा काहवाळ्‌या सी असो कवता सामळ्‌यु, “जावु, भगवानेन रीसेन सातु कटवरा धरती पर अंधलाय देवु।”<verse eid="REV 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 16:2" />तेरेमां पेहलु सरग वाळु काहवाळ्‌यु जाय्‌न आपसान कटवरु धरती पर अंधलाय देदु। ने तीनु माणसेन जीनु पर जनवार्‌यान छाप हतली, ने जे तेरी मुरतीन पुजा करतेला, एक भातीन बुरो ने दुख देण्‌यु फुड़ु नीकळ्‌यु।<verse eid="REV 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 16:3" />दीसरु सरग वाळु काहवाळ्‌यु आपसान कटवरु दरीया पर अंधलाय देदु ने चो मरलान लुहीन तसों बण गुयो, ने दरीया मायन हरेक जीव मर गुया।<verse eid="REV 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 16:4" />तीसरु सरग वाळु काहवाळ्‌यु आपसान कटवरु नदी, ने पाणीन झीर्‌या पर अंधलाय देदु, ने चे लुही बण गुया। <verse eid="REV 16:4" /><verse number="5" style="v" sid="REV 16:5" />ने मे पाणीन सरग वाळा काहवाळ्‌या काजे असो कवते सामळ्‌यु, “ए चुखला, जु छे, ने जु हतलु, तु नीयाव करन्‌यु छे ने तु नीयाव कर्‌यु। <verse eid="REV 16:5" /><verse number="6" style="v" sid="REV 16:6" />काहाकी चे चुखला माणसे, ने भगवानेन अघी सी आवणे वाळी वात बताड़न्‌यान लुही उहुवाड़ला, ने तु तीनुक लुही पायु, काहाकी चे हेरेत लायक छे।” <verse eid="REV 16:6" /><verse number="7" style="v" sid="REV 16:7" />ने मे चड़ावान जागा सी असु अवाज सामळ्‌यु, “हव, ए आखाम सी ताकत भर्‌या मालीक भगवान, तारा नीयाव वारु ने संय छे।”<verse eid="REV 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 16:8" />चोवथु सरग वाळु काहवाळ्‌यु आपसान कटवरु दाहड़ा पर अंधलाय देदु, ने तीनाक माणसे काजे आकठा सी झुलसणेन हक देदु। <verse eid="REV 16:8" /><verse number="9" style="v" sid="REV 16:9" />माणुस मट्‌ली सेक सी झुलसी गुया, ने भगवानेन नावेन तीनाक ईनु गरा पर हक छे, नाव-बद्‌दी कर्‌या ने चे मन नी फेरव्‌या ने नी सेक-सींगार कर्‌या।<verse eid="REV 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 16:10" />पांचवु सरग वाळु काहवाळ्‌यु आपसान कटवरु तीना जनवार्‌यान राजगादी पर अंधलाय देदु ने तेरा राज पर आंदारलो छावाय गुयो; ने माणसे पीड़ान मारे आपणी-आपणी जीप चावणे लाग्‌या, <verse eid="REV 16:10" /><verse number="11" style="v" sid="REV 16:11" />ने आपसान पीड़ा ने फुड़ान वजे सरगेन भगवानेन नाव-बद्‌दी कर्‌यु; बाकुन आपसा-आपसा कामे सी मन नी फेरव्‌या।<verse eid="REV 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 16:12" />छटवु सरग वाळु काहवाळ्‌यु आपसा कटवरु मट्‌ली नदी फरात पर अंधलाय देदु ने तेरो पाणी सुक गुयो की उगण भीणीन रवण्‌या राजा वाटे वाट तीयार हय जाय। <verse eid="REV 16:12" /><verse number="13" style="v" sid="REV 16:13" />ने मे तीना अजगरेन मुंहडा सी, ने तीना जनवार्‌यान मुंहडा सी ने तीना लुच्‌चा भगवानेन अघी सी आवणे वाळी वात बताड़न्‌यान मुंहडा सी तीन भुंडीत आत्‌मान डेडरान रुप मां नीकळतेलो देख्‌यु। <verse eid="REV 16:13" /><verse number="14" style="v" sid="REV 16:14" />चे सहलाणी देखाड़नेवाळी भुतड़ान आत्‌मा छे, जी आखी दुनीयान राजा धड़े नीकळीन असी करीन जाय, की तीनुक आखाम सी ताकत भर्‌या भगवानेन तीना मटला दाहड़े लड़ाय वाटे भेळु करे।<verse eid="REV 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 16:15" />“देख, मे चुट्‌टान तसु आवो; वारु हयु छे, जु जागतु रहे, ने आपसा पुथल्‌या वारु राखे की उघाड़ु नी फीरे, ने माणसे तीनाक उघाड़लु नी देखे।”<verse eid="REV 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 16:16" />ने चे राजा काजे तीना जागा पर भेळु कर्‌यु, जो ईब्‌रानीयो बुली मां हर-मगीदोन कहवाये।<verse eid="REV 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 16:17" />ने सांतवु सरग वाळु काहवाळ्‌यु आपसान कटवरु हवा पर अंधलाय देदु, मंदीरेन राजगादी सी असो अवाज हयो, “हय्‌त गुयलो छे।” <verse eid="REV 16:17" /><verse number="18" style="v" sid="REV 16:18" />तत्‌यार वीजळ्‌या, ने अवाज, ने गाजणो हयो, ने बेसकी धरती हाली, की जत्‌यार सी माणुस धरती पर घड़ायो, तत्‌यार सी असी धरती हालनेन कदी नी हवलो। <verse eid="REV 16:18" /><verse number="19" style="v" sid="REV 16:19" />तेरेसी तीनु मटला सहरेन तीन टुकड़ा हय गुया, ने जाती-जातीन सहर उदरी पड़्‌या, ने मटला बाबेलेन हेर भगवान काजे हय, की हयु आपसा रीसेन जुरेन दारु तीनाक पावे। <verse eid="REV 16:19" /><verse number="20" style="v" sid="REV 16:20" />ने हर एक काळापाणीन टापा आपसा जागा सी टळ गुया, ने मटला बयड़ा काजे पतु नी लाग्‌यु। <verse eid="REV 16:20" /><verse number="21" style="v" sid="REV 16:21" />ने सरग सी माणसे पर बेसका मटा गारे पड़्‌या, ने काहाकी जी गरा बेसकी भारी हतली, माणसे गारेन वजे सी भगवानेन नाव-बद्‌दी कर्‌या।<verse eid="REV 16:21" /></para>
  <chapter eid="REV 16" />
  <chapter number="17" style="c" sid="REV 17" />
  <para style="s">मट्‌ली रंडी</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 17:1" />जीनु सातु सरग वाळा काहवाळ्‌या धड़े चे सात कटवरा हतला, तींद्‌रे मां सी एक आवीन मारे सी असो कह्‌यु, “उरु आव, मे तुसेक तीनी मट्‌ली नाव-बद्‌दी हवली छीनाळो करने वाळीन डंड देखाड़ो, ची बेसका पाणी मां बसी रय। <verse eid="REV 17:1" /><verse number="2" style="v" sid="REV 17:2" />तेरे साते धरतीन बेसका राजा छीनाळो कर्‌या, ने धरतीन रहणे वाळा छीनाळो करने सी दारुन नस्‌या वाळा हय गुयला।”<verse eid="REV 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 17:3" />तत्‌यार हयु मेसेक चुखली-आत्‌मा मां जंगल भीणी ली गुयु, ने मे रातला रंगेन जनवार्‌या पर चो नाव-बद्‌दीन नाव सी भरलो हतलो ने तेरा सात मुणका ने दस सींगड़ा हतला, एक बायर काजे बठी रवली देख्‌यु। <verse eid="REV 17:3" /><verse number="4" style="v" sid="REV 17:4" />जी बायर जामण्‌या, ने रातला रंगेन पुथल्‌या पेहरली हतली, ने सनो ने महंग्‌ला दगड़ान ने मत्‌तीन गळसुन पेहरली हतली, ने तेरा हाते मां एक सनान कटवरु हतलु चु भुंडला कामेन चीजे सी ने तेरा छीनाळान भुंडला चीजे सी भरलो हतलो। <verse eid="REV 17:4" /><verse number="5" style="v" sid="REV 17:5" />ने तेरे नींडाळे पर असो नाव लिखलो हतलो, “सातायली वात मटला बाबेल धरतीन छीनाळो करने वाळी ने भुंडला चीजेन माय।” <verse eid="REV 17:5" /><verse number="6" style="v" sid="REV 17:6" />ने मे तीनी बायर काजे चुखला माणसेन लुही ने ईसुन गवान लुही पीणे सी छाकली देख्‌यु।</para>
  <para style="p" vid="REV 17:6">ने तीनीक देखीन मे घाबराय गुयु। <verse eid="REV 17:6" /><verse number="7" style="v" sid="REV 17:7" />चु सरग वाळु काहवाळ्‌यु मारे सी कह्‌यु, “तु काहा घाबराय गुयु?” मे ईनी बायर, ने तीना जनवार्‌याक, तीना पर ची सवार छे, ने तेरा सात मुणका ने दस सींगड़ा छे, तुसेक सातायली वात बताड़ो। <verse eid="REV 17:7" /><verse number="8" style="v" sid="REV 17:8" />तीना जनवार्‌या काजे तु देख्‌यु, जु पेहले ते हतलु, बाकुन हय नी हय, ने उंडला कुंडाम सी नीकळीन नास मां पड़से, ने धरतीन रहणे वाळा तींद्‌रा नाव कळीन घड़ायणेन टेमे सी जीवनेन किताप मां लिखायलो नी हय, ईना जनवार्‌यान हाल देखीन की पेहले हतलु, ने हय नी हय; ने अळी पछु आय जासे, घाबराय जासे।<verse eid="REV 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 17:9" />“हीनी वातेन मतलब समजणे करीन वारू अक्‌कल चाहजे। ने तेरे धड़े अक्‌कल छे, जाणी लेणु चाहजे रंडी बायर ते बाबुलेन साहरे सहलाणी छे। जे सात मुणका तीनु सहरेन सात बयड़ान सहलाणी छे, तींद्‌रे पर जी रंडी बस रय। ने सात मुणका, सात राजान बी सहलाणी छे।” <verse eid="REV 17:9" /><verse number="10" style="v" sid="REV 17:10" />ने चे सात राजा बी छे, पांच ते हयत गुया, ने एक हय छे; ने एक हय लग आयु नी, ने जत्‌यार आवसे ती ईतरीक टेम लग तेरो रुकणु बी जरुड़ी छे। <verse eid="REV 17:10" /><verse number="11" style="v" sid="REV 17:11" />जु जनवार्‌या पेहल हतलु, ने हय नी हय, चु आपसु आठवु छे; ने तीनु सात मां सी एक छे, ने चु नास मां पड़से।<verse eid="REV 17:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 17:12" />जे दस सींगड़ा तु देख्‌यु चे दस राजा छे; जीनुक हय लग राज नी जड़्‌यो; बाकुन तीना जनवार्‌या साते घड़ी भर वाटे राजान तसा हक जड़से। <verse eid="REV 17:12" /><verse number="13" style="v" sid="REV 17:13" />जे आखा एक मन्‌या हवसे, ने चे आपसा-आपसा ताकत ने हक तीना जनवार्‌या काजे देसे। <verse eid="REV 17:13" /><verse number="14" style="v" sid="REV 17:14" />जे गाडरा सी लड़ायसे, ने तीनु सी जीत जड़से; काहाकी चु मालीकेन मालीक, ने राजान राजु छे, ने जे बुलावला, नेवाड़ला ने भुरसा वाळा छे, तेरे साते छे, तीनुक बी जीत जड़से।<verse eid="REV 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 17:15" />तत्‌यार हयु मारे सी कह्‌यु, ज पाणी तु देखे, तीना पर छीनाळो करने वाळी बठली छे, चे माणसे, टुळु, जाती, ने बुली छे। <verse eid="REV 17:15" /><verse number="16" style="v" sid="REV 17:16" />ने ज दस सींगड़ा तु देखे, चे ने जनवार्‌या तीनी छीनाळो करने वाळी सी नफरत करसे, ने तीनीक तेरो कुय नी ने नांगरली कर देसे; ने तेरो मास खाय जासे, ने तीनीक आकठा मां धपाड़ देसे। <verse eid="REV 17:16" /><verse number="17" style="v" sid="REV 17:17" />काहाकी भगवान तींद्‌रे मन मां असो नाखसे की चे तींद्‌री मनेन मरजी पुरी करे; ने जत्‌यार लग भगवानेन बुले पुरा नी हय जाय, तत्‌यार लग एक मन्‌या हयन आपणो-आपणो राज जनवार्‌या काजे दी देय।<verse eid="REV 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 17:18" />“ने ची बायर, तीनीक तु देख्‌यु चो मटलो सहर छे, ज धरतीन बेसका राजा पर राज करे।”<verse eid="REV 17:18" /></para>
  <chapter eid="REV 17" />
  <chapter number="18" style="c" sid="REV 18" />
  <para style="s">बेबीलोन सहर सरीन उजड़ी जाय</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 18:1" />हेरे पछेन एक सरग वाळा काहवाळ्‌या काजे सरग सी उतरतेलु देख्‌यु, तीनाक मट्‌लु हक जड़लु हतलु; ने धरती तेरा मटा सेक सी चमक उठी। <verse eid="REV 18:1" /><verse number="2" style="v" sid="REV 18:2" />चु उंची अवाज सी आयड़ीन कह्‌यु, “हीट पड़्‌यु, मट्‌लु बाबेल हीट पड़्‌यु! ने भुतड़ान आत्‌मान आसरु, ने हरेक भुंडीत आत्‌मान आसरु, ने हरेक भुंडी ने भुंडली चिरलीन आसरु हय गुयु। <verse eid="REV 18:2" /><verse number="3" style="v" sid="REV 18:3" />काहाकी तेरा छीनाळान कामे सी अदुस दारुन वजे सी आखी जातीन हीट पड़ला छे, ने धरतीन बेसका राजा तेरे साते छीनाळान काम कर्‌या; ने धरतीन वेपारी तेरा वारु-वारु चीज करीन बेसकी जादा लालुचेन वजे सी पयस्‌या वाळा बन्‌नला छे।”<verse eid="REV 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 18:4" />तत्‌यार मे सरग सी एक अळी अवाज सामळ्‌यु,</para>
  <para style="q1" vid="REV 18:4">ए मारा माणसे, हेरेम सी नीकळी आवु की तुहुंं तेरा पापेन हीस्‌सा मां नी रवु,</para>
  <para style="q2" vid="REV 18:4">ने तेरी गरा मां सी काहनीक,</para>
  <para style="q2" vid="REV 18:4">तुंद्‌रे पर आय नी पड़े;<verse eid="REV 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="REV 18:5" />काहाकी तेरा पापेन ढीक सरग लग फुगी गुयो,</para>
  <para style="q2" vid="REV 18:5">ने तेरा नी धरमेन काम भगवान काजे हेर आय गुयलो छे।<verse eid="REV 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="REV 18:6" />जसों चु तुहुंंक देदलु छे,</para>
  <para style="q2" vid="REV 18:6">तसोत तीनाक देवु,</para>
  <para style="q1" vid="REV 18:6">ने तेरा कामेन अनसारे तीनाक दुय गुणा बदलु देवु,</para>
  <para style="q2" vid="REV 18:6">तीना कटवरा मां चु भरलु तीनात मां तेरे वाटे दुय गुणा भर देवु।<verse eid="REV 18:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 18:7" />जतरी हयी आपसीन बड़ाय करी ने मन चाहे तसी करी;</para>
  <para style="q2" vid="REV 18:7">ततरी तीनीक पीड़ा, ने दुख देवु;</para>
  <para style="q1" vid="REV 18:7">काहाकी ची आपसे मन मां कहें,</para>
  <para style="q1" vid="REV 18:7">मे राणी बण गुई,</para>
  <para style="q2" vid="REV 18:7">रांडायली नी हय;</para>
  <para style="q2" vid="REV 18:7">ने दुख मां कदी नी पड़ो।<verse eid="REV 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="REV 18:8" />काहाकी एकुत दाहड़ा मां तीनी पर गरा आय पड़से,</para>
  <para style="q2" vid="REV 18:8">मतलब मुत, ने दुख, ने काळ;</para>
  <para style="q1" vid="REV 18:8">ने ची आकठा मां धपाड़ी देवाय जासे,</para>
  <para style="q2" vid="REV 18:8">काहाकी तेरु नीयाव करन्‌यु मालीक भगवान ताकतवाळु छे।<verse eid="REV 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 18:9" />ने धरतीन राजा जे तेरे साते छीनाळो, ने मनेन मरजी कर्‌या, जत्‌यार तेरो धपणेन कुळु देखसे, ती तेरे वाटे रड़से, ने छाती ठुकसे। <verse eid="REV 18:9" /><verse number="10" style="v" sid="REV 18:10" />ने तेरी पीड़ान बीय्‌हाणान मारे चे बेसके नांबेत हुबा हय्‌न कवसे, “ए मटला सहर, बाबेल! ए काठला सहर, हाय! हाय! ईतरीत वार मां तुसेक डंड जड़ गुयु।”<verse eid="REV 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 18:11" />ने धरतीन वेपारी तेरे वाटे रड़से ने दुखी हवसे, काहाकी हय कुय बी तींद्‌रा माल मुल नी लेसे <verse eid="REV 18:11" /><verse number="12" style="v" sid="REV 18:12" />मतलब सनो, चांदी, महंग्‌ला दगड़ा, मुत्‌या, चमकण्‌यो सणेन जामण्‌या पुथल्‌या, रेसम्‌या, रातला रंगेन पुथल्‌या, आखा भातेन वारला गंदायण्‌या लाकड़ा, महंगला लाकड़ा, पीतळ, लुहड़ान ने घड़ी घड़ीन बणावला आखा भाती-भातेन ठाहरा, <verse eid="REV 18:12" /><verse number="13" style="v" sid="REV 18:13" />ने मसालान पुपड़ा ने गंदायण्‌या मसाला, गंदायण्‌या धुप, ईत्‌तर, लुभान, दारु, तेल, मयदु, गहुं, गावड़ी-बेल, गाडरा-बुकड़ा, घुल्‌ला, घुड़ागाड्‌या, ने पावर्‌या, ने माणसेन जीवे। <verse eid="REV 18:13" /><verse number="14" style="v" sid="REV 18:14" />हय तारे मन काजे भावणे वाळा फळ तारे धड़े सी छेटा हवता जाय; ने सवादली ने झोळ-झोळ करनी चीज तारे सी छेटी हवली छे, ने चे अळी कदी नी जड़से। <verse eid="REV 18:14" /><verse number="15" style="v" sid="REV 18:15" />ईनु चीजेन वेपारी जे तेरेसी मातला बण गुयला, तेरी पीड़ान धाकेन मारे छेटा हुबा हवसे, ने रड़ता ने दुखी हवीन कवसे, <verse eid="REV 18:15" /><verse number="16" style="v" sid="REV 18:16" />“हाय! हाय! ज मटलो सहर जु चमकण्‌यो सणेन पुथल्‌या, जामण्‌या ने रातला रंगेन पुथल्‌या पेहरलु हतलु, ने सनो, महंगला दगड़ा, ने मुत्‌या सी सींगेर्‌लु हतलु; <verse eid="REV 18:16" /><verse number="17" style="v" sid="REV 18:17" />घड़ीत भर मां तेरो असो भारी धन नास हय गुयो।”</para>
  <para style="p" vid="REV 18:17">ने हरेक मटला-मटला ढंड्‌या चालाड़न्‌या ने मुख्‌या, ने ढंड्‌याम बठीन फीरन्‌या, ने जतरा दरीया मां काम करीन कमाये, आखा छेटे हुबा हय र्‌या, <verse eid="REV 18:17" /><verse number="18" style="v" sid="REV 18:18" />ने तेरे धपणेन कुळु देखीन आयड़ीन कवसे, काहनो सहर ईना मटला सहरेन तसों छे! <verse eid="REV 18:18" /><verse number="19" style="v" sid="REV 18:19" />ने आपणा-आपणा मुणका पर धुळु नाखसे, ने रड़ता जाय्‌न ने दुखी हवता जाय्‌न, “आयड़ी आयड़ीन कवसे, हाय! हाय! ज मटलो सहर जेरा माल धन सी दरीयान आखा मटला ढंड्‌या वाळा मातला बण गुयला, घड़ी भर मां उजड़ी गुयो।”<verse eid="REV 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 18:20" />ए सरग, ने ए चुखला माणसे, ने नेवताळा, ने भगवानेन अघी सी आवणे वाळी वात बताड़ने वाळा, तीनु पर खुसी करु, काहाकी भगवान नीयाव करीन तींद्‌रे सी पलटु लेदलु छे।<verse eid="REV 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 18:21" />तत्‌यार एक ताकतवाळु सरग वाळु काहवाळ्‌यु, मट्‌ली चक्‌खीन पाटेन तसलु दगड़ु हाकल्‌यु, ने असु कय्‌न दरीया मां उराट देदु, “मटला सहर बाबेल असुत मटला ताकत सी हीटी पाड़से, ने अळी कदी तेरो पतु नी जड़से। <verse eid="REV 18:21" /><verse number="22" style="v" sid="REV 18:22" />झुणगा वाजाड़ने वाळा, गावण्‌या, पावळी वाजाड़नेवाळा, ने फेप्‌यो फुकणेवाळान अवाज अळी कदी तुसे सामळाय नी देसे, ने काहनाक धंदान काहनु कारीगर बी कदी तारेम नी जड़से; ने घट्‌टीन चालनेन अवाज अळी कदी तारेम सामळाय नी देसे; <verse eid="REV 18:22" /><verse number="23" style="v" sid="REV 18:23" />ने दिवान वीजाळो अळी कदी तारेम नी चमकसे ने दुल्‌लान ने लाडीन अवाज अळी कदी तारेम सामळाय नी देसे; काहाकी तारा वेपारी धरतीन मुख्‌या हतला, ने तारा जादु टुणा सी आखा जाती भटकी गुयला।”<verse eid="REV 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="REV 18:24" />ने भगवानेन अघी सी आवणे वाळी वात बताड़न्‌या ने चुखला माणसे, ने धरती पर आखा मरलान लुही तेरेमां जड़्‌यो।<verse eid="REV 18:24" /></para>
  <chapter eid="REV 18" />
  <chapter number="19" style="c" sid="REV 19" />
  <para style="p">
    <verse number="1" style="v" sid="REV 19:1" />तेरे पछेन सरग सी मट्‌ली गड़दी काजे उची अवाज सी असो कवतो सामळ्‌यु, “भगवानेन बड़ाय हवे! छुटकारु, ने सेक-सींगार, ने ताकत हामरा भगवानेत ने छे। <verse eid="REV 19:1" /><verse number="2" style="v" sid="REV 19:2" />काहाकी तेरा नीयाव संय ने वारु छे, तेरेमां की हयु तीनी मट्‌ली रंडीन जी आपसा छीनाळा सी धरती काजे भुंडी कर देदली, नीयाव कर्‌यु, ने तीनी सी आपसा पावर्‌यान लुहीन पलटु लेदलु छे।” <verse eid="REV 19:2" /><verse number="3" style="v" sid="REV 19:3" />अळी दीसरी कावा चे कह्‌या, “बड़ाय! तेरे धपणेन कुळु जलम जातु रवसे।” <verse eid="REV 19:3" /><verse number="4" style="v" sid="REV 19:4" />ने वीस ने चारु डाहला मुख्‌या ने चारु जीव जनवार्‌या पड़ीन भगवानेन बड़ाय कर्‌या; जु राजगादी पर बठलु हतलु, ने कह्‌यु, “आमीन! हाल्‌लेलुया!”<verse eid="REV 19:4" /></para>
  <para style="s">गाडरान ईयावेन पंगत</para>
  <para style="p">
    <verse number="5" style="v" sid="REV 19:5" />ने राजगादी मां सी एक बुल सामळाय, “ए आपणा भगवान सी आखा बीहणेवाळा पावर्‌या, काय नानला, काय मटला; तुहुंं आखा तेरी बड़ाय करु।” <verse eid="REV 19:5" /><verse number="6" style="v" sid="REV 19:6" />तत्‌यार मे मटला टुळान तसी ने बेसको पाणीन जसी अवाज, ने गाजणेन जसों मटलो अवाज सामळ्‌यु “बड़ाय करु! तेरेमां की मालीक आपणु भगवान, आखाम सी ताकत भर्‌यु राज करे। <verse eid="REV 19:6" /><verse number="7" style="v" sid="REV 19:7" />आवु, हामु धव हय्‌न खुस हवजे, ने तेरी बड़ाय करजे, काहाकी गाडरान ईयाव आय गुयलु छे, ने तेरी लाडी आपसा काजे तीयार कर लेदली छे। <verse eid="REV 19:7" /><verse number="8" style="v" sid="REV 19:8" />तीनीक चुखलो ने चमकण्‌यो सणेन पुथल्‌यो पेहरने करीन हक आप्‌यु।” काहाकी तीनु खास पुथल्‌यान मतलब चुखला माणसेन धरमेन काम छे।<verse eid="REV 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 19:9" />तत्‌यार सरग वाळु काहवाळ्‌यु मारे सी कह्‌यु, “की वारु चे छे, जे गाडरान ईयावेन पंगत मां बुलावला छे।” अळी हयु मारे सी कह्‌यु, “जे बुले भगवानेन छाचला बुले छे।”<verse eid="REV 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 19:10" />तत्‌यार मे तीनाक आंधणे करीन तेरे पाये पर पड़्‌यु। हयु मारे सी कह्‌यु, “असु मां करे, तारु ने तारा भायस्‌येन सगु पावर्‌यु छे, जे ईसुन गवाय देणे मां काठा छे। भगवान काजे आंध।”</para>
  <para style="p" vid="REV 19:10">काहाकी ईसुन गवाय भगवानेन अघी सी आवणे वाळी वात देखाड़नेन आत्‌मा छे।<verse eid="REV 19:10" /></para>
  <para style="s">धवळ्‌या घुल्‌ला पर बसीन आवण्‌यु राजु</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 19:11" />तत्‌यार मे सरग काजे खुली रवलो देख्‌यु, ने देखो की एक धवळु घुल्‌लु छे; ने तीना पर एक सवारी छे, जु भुरसा वाळा, ने छाचलु कहवाये; ने चु धरमेन साते नीयाव ने लड़ाय करे। <verse eid="REV 19:11" /><verse number="12" style="v" sid="REV 19:12" />तेरा डुळा आकठान आंच छे, ने तेरे मुणका पर बेसका राज मुड़े छे। ने तेरो एक नाव तीना पर लिखलो छे, ज तीनाक छुड़ीन अळी कुय नी जाणे। <verse eid="REV 19:12" /><verse number="13" style="v" sid="REV 19:13" />चु लुही मां डुबाड़ला पुथल्‌या पेहरलु छे, ने तेरो नाव भगवानेन बुल छे। <verse eid="REV 19:13" /><verse number="14" style="v" sid="REV 19:14" />ने सरगेन सीपायड़ा धवळा घुल्‌ला पर बठी रवला ने चुखला ने धवळा चमकण्‌यो सणेन पुथल्‌यो पेहेरीन तेरे पछळ-पछळ आवणे बाजी र्‌या। <verse eid="REV 19:14" /><verse number="15" style="v" sid="REV 19:15" />जाती-जाती काजे मारने करीन तेरे मुंहडा सी एक पाजावली तलवार नीकळे, ने लुहड़ान डेंगु लीन तीनु पर राज करसे<note caller="+" style="f"><char style="fr" closed="false">19:15 </char><char style="ft" closed="false">लुहड़ान डेंगु लीन तींद्‌रे पर राज करसे मतलब चु दया करे बीगुर तींद्‌रे पर राज करसे</char></note> ने हयु आखाम सी ताकत सी भरलु भगवानेन रीस सी कुंड मां अंगुरेन रस रंदळसे। <verse eid="REV 19:15" /><verse number="16" style="v" sid="REV 19:16" />ने तेरा पुथल्‌या ने सातळ्‌या पर असो नाव लिखलो छे: “राजान राजा ने मालक्‌यान मालीक।”<verse eid="REV 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 19:17" />ने मे एक सरग वाळा काहवाळ्‌या काजे दाहड़ा पर हुबु हय रवलु देख्‌यु, ने हयु मट्‌ली अवाज सी आयड़ीन उपर सरग मां सी उडणेवाळा आखा चिरला सी कह्‌यु, “आवु, भगवानेन मट्‌ली पंगत वाटे भेळा हय जावु, <verse eid="REV 19:17" /><verse number="18" style="v" sid="REV 19:18" />तेरेसी तुहुंं राजान मास, ने सीपायड़ान मुख्‌यान मास, ने ताकतवाळान माणसेन मास, ने घुल्‌लान ने घुल्‌ला पर बठण्‌या माणसेन मास, ने काय छुटला, काय बांदायला, काय पावर्‌या, काय नानला, काय मटला, आखा माणसेन मास खाणे आवु।”<verse eid="REV 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 19:19" />तत्‌यार मे तीना पेहला जनवार्‌या काजे ने धरतीन राजा काजे देख्‌यु। ने तींद्‌रे पुठ्‌ये तींद्‌रा सीपायड़ान मेळा बी हतला चे आखा, धवळ्‌ळा घुल्‌ला पर बठी रवलु, तीना भगवानेन पावर्‌या साते, ने तेरा सीपायड़ान मेळा साते लड़ाय करने भेळा हय रवला। <verse eid="REV 19:19" /><verse number="20" style="v" sid="REV 19:20" />ने हयु जनवार्‌या ने तेरे भेळु चु लुच्‌चु अघी सी आवणे वाळी वात बताड़न्‌यु धराय गुयु, जु तेरे अगळ असा सहलाणी देखाड़ला, तीनु सी हयु तीनुक भटकाड़्‌यु, जीनु पर तीना जनवार्‌यान छाप हतली, ने जे तेरे मुरतीन पुजा करतेला। जे दुयु जीवता जीवतात तीना आकठान कुंडा मां, जो गंधक सी जलम धपे, चां नाख्‌या। <verse eid="REV 19:20" /><verse number="21" style="v" sid="REV 19:21" />ने रवला माणसे तीना घुल्‌लान सवारीक तलवार सी, जी तेरे मुंहडा सी नीकळतेली, मार नाख्‌या; ने आखा चिरला तींद्‌रा मास सी आफरी गुया।<verse eid="REV 19:21" /></para>
  <chapter eid="REV 19" />
  <chapter number="20" style="c" sid="REV 20" />
  <para style="s">भुतड़ा काजे हजार साल वाटे उंडला कुंड मां नाखे</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 20:1" />ने मे एक सरग वाळा काहवाळ्‌याक सरग सी उतेरतेलो देख्‌यु; तेरे हाते मां उंडला कुंडेन कुची, ने एक मट्‌ली साकळ हतली। <verse eid="REV 20:1" /><verse number="2" style="v" sid="REV 20:2" />ने हयु तीना अजगर, मतलब पुराणु घड़साक, जु भुतड़ु छे; धरीन हजार साल लग बांद देदा, <verse eid="REV 20:2" /><verse number="3" style="v" sid="REV 20:3" />ने तीनाक उंडला कुंड मां नाखीन बंद कर देदा ने तीना पर सील लागाड़ देदा, की हयु हजार साल पुरा हवता लग जाती-जातीन माणसेक अळी नी भटकाड़े। तेरे पछेन जरुड़ी छे की थुड़ीक वार वाटे अळी छुड़ाय जासे।<verse eid="REV 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 20:4" />तत्‌यार मे राजगाद्‌या देख्‌यु, ने तीनु पर माणसे बठ गुया, ने तीनुक नीयाव करनेन हक देदु। ने तींद्‌री आत्‌मा काजे बी देख्‌यु, तींद्‌रा मुणका ईसुन गवाय देणे ने भगवानेन बुलेन परचार करने वजे सी काटाय्‌ला, ने जे नी हीना जनवार्‌यान, ने नी हेरी मुरतीन पुजा करला, ने नी हेरी छाप आपणा मुणका ने हात पर लेदला चे जीवता हय्‌न मसी साते हजार साल लग राज करता रवे। <verse eid="REV 20:4" /><verse number="5" style="v" sid="REV 20:5" />जत्‌यार लग चे हजार साल पुरा नी हवे तत्‌यार लग बाकी मरला नी जीव हवे। ज ते पेहलो मर्‌या-सर्‌याम सी जीवता हवणेन छे। <verse eid="REV 20:5" /><verse number="6" style="v" sid="REV 20:6" />वारु ने चुखलु हयु छे, जु ईना पेहला मर्‌या-सर्‌याम सी जीवता हवणे मां साजल्‌या छे, असला पर दीसरी मुतेन काय बी हक नी हय, बाकुन चे भगवान ने मसीन पुजारा बणसे, ने तेरे साते हजार साल लग राज करसे।<verse eid="REV 20:6" /></para>
  <para style="s">भुतड़ान नास</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 20:7" />जत्‌यार हजार साल पुरा हय गुया ती भुतड़ु काजे जेल सी छुड़ी देसे। <verse eid="REV 20:7" /><verse number="8" style="v" sid="REV 20:8" />ने चु तीनु जाती काजे जे धरतीन चारु भीणी रवसे, मतलब गोग ने मागोन काजे तींद्‌री गिन्‌ती दरीयान रेतेन बराबर हवसे, भटकाड़ीन लड़ाय वाटे भेळा करने करीन नीकळसे। <verse eid="REV 20:8" /><verse number="9" style="v" sid="REV 20:9" />ने चे आखी धरती पर जासे ने चुखला माणसेन तम्‌बु ने वारलु परमवाळा सहर काजे घेरवी लेसे ने आकठो सरग सी उतरीन तीनुक उजाड़ देसे। <verse eid="REV 20:9" /><verse number="10" style="v" sid="REV 20:10" />तींद्‌रु भटकाड़ने वाळु भुतड़ु आकठो ने गंधकेन तीना कुंडा मां, तेरेमां चो जनवार्‌या ने लुच्‌चु अघी सी आवणे वाळी वात बताड़न्‌यु बी रवसे, चां नाख देसे; ने चे रात दाहड़ु जलम पीड़ा मां तड़पता रवसे।<verse eid="REV 20:10" /></para>
  <para style="s">धवळी मट्‌ली राजगादी ने आकरी नीयाव</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 20:11" />तत्‌यार मे एक मट्‌ली धवळी राजगादी ने तीनाक जु तीना पर बठलु हतलु, देखु, तेरे अगळ सी धरती ने सरग ढासी गुई, ने तींद्‌रे वाटे जागु नी जड़्‌यु। <verse eid="REV 20:11" /><verse number="12" style="v" sid="REV 20:12" />ने मे नानला मटला आखा मरला काजे राजगादीन अगळ हुबा देख्‌यु, ने किताप खुळ्‌यु, ने तत्‌यार एक अळी किताप खुळ्‌यु, मतलब जीवनेन किताप, ने जसों तीनु किताप मां लिखलो हतलो, तींद्‌रा कामेन अनसारे मरलान नीयाव हयो। <verse eid="REV 20:12" /><verse number="13" style="v" sid="REV 20:13" />ने दरीया तीनु मरलाक जे तेरेमां हतला आपी देदी, ने मरण ने पाताळ बी, जे तेरेमां हतला; ने तेरेमां सी हरेकेन कामेन अनसारे तींद्‌रु नीयाव हयो। <verse eid="REV 20:13" /><verse number="14" style="v" sid="REV 20:14" />ने मरण ने पाताळ बी आकठान कुंडा मां नाख देदा। जी आकठान कुंडो ते दीसरी मरण छे। <verse eid="REV 20:14" /><verse number="15" style="v" sid="REV 20:15" />ने काहनाक ने नाव जीवनेन किताप मां लिखलो नी जड़्‌यो, तीनाक आकठान कुंडा मां नाख देदा।<verse eid="REV 20:15" /></para>
  <chapter eid="REV 20" />
  <chapter number="21" style="c" sid="REV 21" />
  <para style="s">नवली कळजुग सुरु हवे</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 21:1" />तत्‌यार मे नवली सरग ने नवली धरती काजे देख्‌यु, काहाकी पेहली सरग ने पेहली धरती जाती रहतेली, ने दरीया बी नी रवी। <verse eid="REV 21:1" /><verse number="2" style="v" sid="REV 21:2" />अळी मे चुखला सहर नवला यरुसलेम काजे सरग सी भगवानेन धड़े सी उतरतेला देख्‌यु, ने हयु तीनी लाडीन तसी हतलु, जी आपसा अदमी वाटे सींगारु करली छे। <verse eid="REV 21:2" /><verse number="3" style="v" sid="REV 21:3" />अळी मे राजगादी काहनाक मां सी काहनाक काजे उची अवाज सी असो कवता सामळ्‌यु, देखु, भगवानेन माणसेन ईचमां छे; हयु तींद्‌रे साते डेरा करसे, ने चे तेरा माणसे बणसे, ने भगवान आपसु तींद्‌रे साते रवसे; ने तींद्‌रु भगवान रवसे। <verse eid="REV 21:3" /><verse number="4" style="v" sid="REV 21:4" />ने हयु तींद्‌रा डुळा सी आखा आसा नुछी देसे, ने तेरे पछेन मरण नी रवसे, ने नी दुख, नी आयड़्‌नु, नी पीड़ा रवसे; पेहली वाते जाती रय।<verse eid="REV 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 21:5" />ने ज राजगादी पर बठलु हतलु, हयु कह्‌यु, “मे आखो काय नवलो कर दम।” अळी हयु कह्‌यु, “लिख ले, काहाकी चे बुले भुरसा वाळा ने छाचला छे।” <verse eid="REV 21:5" /><verse number="6" style="v" sid="REV 21:6" />अळी हयु मारे सी कह्‌यु, “जी वाते पुरी हय गुयली छे। मे अल्‌फा ने ओमेगा, पेहलु ने आकरी छे। मे तीसला काजे जीवनेन पाणीन उंहता मां सी फुकट मां पावीस। <verse eid="REV 21:6" /><verse number="7" style="v" sid="REV 21:7" />जु जीते, हयुत तीनु चीजेन वारीस बणसे; ने तेरु भगवान रवीस, ने हयु मारु पुर्‌यु रवसे। <verse eid="REV 21:7" /><verse number="8" style="v" sid="REV 21:8" />बाकुन नी कामका, नी भुरसा वाळा, रीस करन्‌या, ने हत्‌यारा, ने छीनाळा, ने बड़वाय करन्‌या, मुरती पुजा करन्‌या, ने आखा लुच्‌चायन भागी हवण्‌या तीना कुंडेम जड़से, जाहां आकठो ने गंधक सी धपती रहे, जी दीसरी मरण छे।”<verse eid="REV 21:8" /></para>
  <para style="s">नवलु यरुसलेम सहर</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 21:9" />तत्‌यार जीनु सात सरग वाळा काहवाळ्‌या धड़े सात आकरी गरा सी भरला सात कटवरा हतला, तेरेमां सी एक मारे धड़े आयु, ने मारे साते वात करीन कह्‌यु, “उरु आव, मे तुसेक चे माणसे देखाड़ीस, जे गाडरा साते जलम रवसे, चे तेरे साते नवली लाडीन तसा छे।” <verse eid="REV 21:9" /><verse number="10" style="v" sid="REV 21:10" />ने हयु मेसे आत्‌मा मां, एक मटला ने उचला बयड़ा पर ली गुयु, ने चुखला सहर यरुसलेम काजे सरग सी भगवान धड़े उतेरता देखाड़्‌यु। <verse eid="REV 21:10" /><verse number="11" style="v" sid="REV 21:11" />चो सहर भगवानेन सेक-सींगार सी चमकतेलो; ने तेरो वीजाळो यसब नावेन महंगला दगड़ा तसों चुखोझण चमकतेलो। <verse eid="REV 21:11" /><verse number="12" style="v" sid="REV 21:12" />ने तेरी दिवाल मटी उची हतली, ने तेरा बारे फाटक ने फाटके पर बारे सरग वाळा काहवाळ्‌या हतला; ने तीनु फाटके पर ईस्‌रायेलीन बारे कुळीन नाव लिखला हतला। <verse eid="REV 21:12" /><verse number="13" style="v" sid="REV 21:13" />उगण फीरीन तीन फाटक, अखण भीणी फीरीन तीन फाटक, दखण फीरीन तीन फाटक, ने बुडण फीरीन तीन फाटक हतला। <verse eid="REV 21:13" /><verse number="14" style="v" sid="REV 21:14" />ने सहरेन दिवालेन बारे नेहान दगड़ा हतला, ने तीनु पर गाडरान बारे नेवताळान बारे नाव लिखला हतला। <verse eid="REV 21:14" /><verse number="15" style="v" sid="REV 21:15" />जु मारे साते वात करी रवलु, तेरे धड़े सहर ने तेरा फाटके ने तेरी दिवाल काजे नापणे करीन एक सनान फीट हतली। <verse eid="REV 21:15" /><verse number="16" style="v" sid="REV 21:16" />हयो सहर चारखुट बन्‌नलो हतलो ने चो नाबो, चोवड़ो बराबर हतलो, ने हयु तीना फीट सी सहर काजे नाप्‌यु, ती साड़े सात सोव कुसेन नीकळ्‌यो: चो नाबो, ने चवड़ो, ने उंचो बराबर हतलो। <verse eid="REV 21:16" /><verse number="17" style="v" sid="REV 21:17" />ने हयु तेरी दिवाल काजे माणसेन, मतलब सरग वाळा काहवाळ्‌यान नाप सी नाप्‌यु, ती एक सोव चाळीस ने चार हात नीकळ्‌यो। <verse eid="REV 21:17" /><verse number="18" style="v" sid="REV 21:18" />तेरी दिवाल यसबेन नावेन महंगला दगड़ान बन्‌नली हतली, ने सहर असो चुखला सनान हतलो, ज चुखला आरस्‌यान तसों रवे। <verse eid="REV 21:18" /><verse number="19" style="v" sid="REV 21:19" />तीना सहरेन नेहा हर भातेन जरुड़ी दगड़ा सी सवारली हतली, पेहलु नेहु यसबेन, दीसरी नीलमणीन, तीसरी लालड़ीन, चोवथी मरकतेन, <verse eid="REV 21:19" /><verse number="20" style="v" sid="REV 21:20" />पांचवी गोमेदकेन, छटवी माणीक्‌येन, सातवी पीतमणीन, आठवी पेरोजेन, नव्‌वी पखराजेन, दसवी लहसनीयेन, ग्‌यारवी धुमरकान्‌तेन, बारवो याकुतेन हतली। <verse eid="REV 21:20" /><verse number="21" style="v" sid="REV 21:21" />ने बारे फाटक, बारे मुत्‌यान हतला; एक-एक फाटक, एक-एक मुतीन बन्‌नलो हतलो। ने सहरेन सयड़क चुखला आरस्‌यान तसों चुखो सनान हतलो।<verse eid="REV 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 21:22" />मे तेरेमां काहनु बी मंदीर नी देख्‌यु, काहाकी आखाम सी ताकत वाळु मालीक भगवान, ने गाडरो तेरो मंदीर छे। <verse eid="REV 21:22" /><verse number="23" style="v" sid="REV 21:23" />ने तीना सहरेम दाहड़ु ने चांदेन वीजाळान जरुवत नी हय, काहाकी भगवानेन सेक सी तेरेमां वीजाळो हय र्‌यो, ने गाडरो तेरो दिवु छे। <verse eid="REV 21:23" /><verse number="24" style="v" sid="REV 21:24" />जाती-जातीन माणसे तेरा उजाळा मां चालसे फीरसे, ने धरतीन राजा आपणा-आपणा सेकेन समान तेरेमां लावसे। <verse eid="REV 21:24" /><verse number="25" style="v" sid="REV 21:25" />तेरा फाटक दीसु कदी बंद नी हवसे, ने रात चां नी हवसे। <verse eid="REV 21:25" /><verse number="26" style="v" sid="REV 21:26" />ने माणसे जाती-जातीन सेक ने धनेन समान तेरेमां लावसे। <verse eid="REV 21:26" /><verse number="27" style="v" sid="REV 21:27" />ने तेरेमां कुय बी वीटेळ्‌ळी चीज नीते सरमेन काम करने वाळा, नीते झुट सी धुकु देणेवाळा, काहनी रीती सी माहें नी भरायसे; बाकुन चे माणसे अतरात तींद्‌रा नाव गाडरान जीवनेन किताप मां लिखला छे।<verse eid="REV 21:27" /></para>
  <chapter eid="REV 21" />
  <chapter number="22" style="c" sid="REV 22" />
  <para style="s">जीवणेन पाणीन नदी</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 22:1" />तत्‌यार हयु मारे बील्‌लोरेन तसी चमकतेली, जीवनेन पाणीन नदी देखाड़्‌यु, जी भगवान ने गाडरान राजगादी सी नीकळीन, <verse eid="REV 22:1" /><verse number="2" style="v" sid="REV 22:2" />तीना सहरेन सड़केन ईचमां उहतेली। नदीन ईनी धड़े ने पली धड़े जीवनेन झाड़को हतलो; तेरेमां बारे भातेन फळ लागतेला, ने चे हर महने फळतेला; ने तीना झाड़कान पान्‌टा सी जाती-जातीन माणसे वारु हवतेला। <verse eid="REV 22:2" /><verse number="3" style="v" sid="REV 22:3" />तत्‌यार सराप नी हवसे,</para>
  <para style="p" vid="REV 22:3">ने भगवान ने गाडरान राजगादी तीना सहर मां रवसे, ने तेरा पावर्‌या तेरी चाकरी करसे। <verse eid="REV 22:3" /><verse number="4" style="v" sid="REV 22:4" />चे तेरो मुंहडो देखसे, ने तेरो नाव तींद्‌रा नींडाळा पर लिखलो रवसे। <verse eid="REV 22:4" /><verse number="5" style="v" sid="REV 22:5" />ने रात नी पड़से, ने तीनुक दिवान ने दाहड़ान वीजाळान जरुवत नी पड़से, काहाकी मालीक भगवान तीनुक वीजाळो देसे, ने चे जलम राज करसे।<verse eid="REV 22:5" /></para>
  <para style="s">ईसु मसी छाटुस पछु आवण्‌यु छे</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 22:6" />तत्‌यार हयु मारे सी कह्‌यु, “जी वाते भुरसा वाळा ने छाचली छे। ने मालीक, जु भगवानेन अघी सी आवणे वाळी वात बताड़न्‌यान आत्‌मान भगवान छे, आपसा सरग वाळा काहवाळ्‌या काजे असु करीन मकेल्‌लु की आपसा पावर्‌या काजे जी वाते, तीनुक मामार पुरो हवणु जरुड़ी छे देखाड़े।”<verse eid="REV 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 22:7" />“ने सामळु, मे मामार आवणेवाळु छे; वारु छे हया, जे ईनी कितापेन हवणे वाळी वात माने।”<verse eid="REV 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 22:8" />मे हयुत युहन्‌नु छे, जु जी वात सामळे, ने देखतेलु। ने जत्‌यार मे सामळ्‌यु ने देख्‌यु, ती जु सरग वाळु काहवाळ्‌यु मेसेक जी वात देखाड़तेलु, मे तेरे पाये पड़ीन आंधणे करीन हीट पड़्‌यु। <verse eid="REV 22:8" /><verse number="9" style="v" sid="REV 22:9" />बाकुन मेसेक कह्‌यु, “देख, असु मां करे; काहाकी मे तारु ने तारा भाय अघी सी आवणे वाळी वात बताड़न्‌या ने ईनी कितापेन वातेक मान्‌नेवाळान सगु पावर्‌यु छे, भगवानेन ने बड़ाय कर।” <verse eid="REV 22:9" /><verse number="10" style="v" sid="REV 22:10" />अळी हयु, मारे सी कह्‌यु, “ईनी कितापेन हवणे वाळीन वातेक बंद मां करे; काहाकी ईनी वातेक हवणेन टेम धड़ेत छे। <verse eid="REV 22:10" /><verse number="11" style="v" sid="REV 22:11" />जु बी कुहराय करे, हयु कुहरायत करतु रहे; ने जु सरमेन काम करे, चु सरमेन कामुत करतु रहे; ने जु धरमी छे, हयु धरमी बणीन रहे; ने जु चुखलु छे, चु चुखलु बणीन रहे।”<verse eid="REV 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 22:12" />देख, मे मामार आवणेवाळु छे; ने हर एक कामेन अनसारे बदलु देणेन फळ मारे धड़े छे। <verse eid="REV 22:12" /><verse number="13" style="v" sid="REV 22:13" />“मे अल्‌फा ने ओमेगा, पेहलु ने आकरी, सुरुवात ने खत्‌तम छे।”<verse eid="REV 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 22:14" />वारु चे छे, जे आपसा पुथल्‌या धुय लेय, काहाकी तीनुक जीवनेन झाड़कान धड़े आवणेन हक जड़से, ने चे फाटके मायन हय्‌न सहर मां भरायसे। <verse eid="REV 22:14" /><verse number="15" style="v" sid="REV 22:15" />बाकुन कुतरा, बड़वाय करन्‌या, छीनाळा, हत्‌यारा, मुरती पुजा करन्‌या, हर एक झुट काजे परम करने वाळा ने झुट पर चालनेवाळा बाहर रवसे।<verse eid="REV 22:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 22:16" />“मे ईसु मारा सरग वाळा काहवाळ्‌या काजे असु करीन मकल्‌यु, की तुंद्‌रे अगळ मंडळ्‌यान बारामां ईनु वातेन गवाय देय। मे दावुदेन जड़ ने अवल्‌यात, ने वीजाळान चमक्‌तु तारु छे।”<verse eid="REV 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 22:17" />ने आत्‌मा, ने लाडी दुयु कहें, “आव!”</para>
  <para style="p" vid="REV 22:17">ने सामळनेवाळु बी कहें, “आव!”</para>
  <para style="p" vid="REV 22:17">ने जु तीसलु हय, हयु आवे ने जु काहनुक चाहे चु जीवनेन पाणी फुकट मां लेय।<verse eid="REV 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 22:18" />मे युहन्‌नु हर एक काजे, जु ईनी कितापेन हवणे वाळीन वाते सामळे, गवाय दम; कदी काहनुक माणुस ईनु वाते मां काहींग बड़ावे ती भगवान तीनु गरा काजे ज ईनी किताप मां लिखलो छे, तीनु पर बड़ावसे। <verse eid="REV 22:18" /><verse number="19" style="v" sid="REV 22:19" />ने कदी काहनुक ईनी हवणे वाळीन कितापेन वाते मां सी नीकाळसे, ती भगवान तीना जीवनेन झाड़को ने चुखलो सहर मां सी, तेरी खुलीन वात ईनी किताप मां छे, तेरु भाग नीकाळ देसे।<verse eid="REV 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 22:20" />जु ईनी वातेन गवाय देय, हयु असो कहें,</para>
  <para style="p" vid="REV 22:20">“हव, मे मामार आवणेवाळु छे।” आमीन। ए मालीक ईसु आव!<verse eid="REV 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 22:21" />मालीक ईसुन गीण-दया चुखला माणसे साते रहे। आमीन।<verse eid="REV 22:21" /></para>
  <chapter eid="REV 22" />
</usx>