<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2CO" style="id">- Bhilali Standard Project</book>
  <para style="h">2 कुरींथी</para>
  <para style="toc3">2 कुरींथी</para>
  <para style="toc2">2 कुरींथी</para>
  <para style="toc1">कुरींथी वाटे पोलुसेन दुसरी चिट्‌ठी</para>
  <para style="mt2">कुरिन्थियों के लिए पौलुस की दूसरी पत्री</para>
  <para style="mt1">कुरींथी वाटे पोलुसेन दुसरी चिट्‌ठी</para>
  <para style="imt">दुसरी कुरींथीन बारामां</para>
  <para style="ip">ईसु मसीन पयदा हवणेन पछे नेवताळु पोलुस 55-56 आड़े-धड़े 2 कुरींथी काजे लिख्‌यु। <char style="xt"><ref loc="2CO 1:1">1:1</ref></char> जी दुय चिट्‌ठी मां सी दुसरी चिट्‌ठी पोलुस कुरींथी काजे लिखलु। नीयमेन मास्‌तर्‌यान मान्‌नु छे की पोलुस पेहली कुरींथी काजे फीकुर करीन चिट्‌ठी लिखलु। ने तीनी चिट्‌ठीन तेरेन तसा हामरे धड़े नी हय तेरे बारामां <char style="xt"><ref loc="2CO 2:3-4">2:3-4</ref></char> हयु बताड़े। जत्‌यार पोलुस मकीदुनीया मां हतलु। <char style="xt"><ref loc="2CO 2:13">2:13</ref></char></para>
  <para style="ip">तत्‌यार दुसरी कुरींथी लिखायली। दुसरी कुरींथी मां बेसकी मटी खास वात ने हवस मां आवे तसली चिट्‌ठी छे। पोलुस कुरींथीनीन बारामां तीतुस सी सामळ्‌ळी खबर बारामां खुसी काजे बताड़े। ईनी चिट्‌ठी मां, हामुक नवला नीयम सी लेदली वातेन बारामां चवड़ी सीक जड़े, ने तीना भाग मां पोलुस पयस्‌या वसुलीन वात बताड़े, काहाकी यरुसलमेन भुरसा करने वाळान मदत हय सके। <char style="xt"><ref loc="2CO 8:9">8:9</ref></char> ने असो लागे की ने बाहरला थुड़ाक लुच्‌चा नेवताळा पोलुसेन वीरुद मां ईतराक माणसे साते दुस्‌मनी करतेला काहाकी चे खुद काजे मटा बणाय सके ने चे पोलुसेन हक पर सक करतेला, तीनी वजे सी पोलुस 2 कुरींथीन आकरी मां ईसु मसी भीणी सी एक नेवताळा समजीन आपसा हक काजे हिम्‌मत सी कह्‌यु।</para>
  <para style="iot">बाहरती वात</para>
  <para style="io1">1. पोलुस काजे वारु छे की करीन पुछीन आपसान चिट्‌ठीक सुरु करे। <char style="ior"><ref loc="2CO 1:1-7">1:1-7</ref> </char></para>
  <para style="io1">2. ने पोलुस जाणेन इरादा मां बदलनेन ने खबर जी तींद्‌रे सी जड़ली ने आपसा पेहली चिट्‌ठीन सवालेन जपाप देणेन बारामां बताड़े। <char style="ior"><ref loc="2CO 1:8-7:16">1:8—7:16</ref> </char></para>
  <para style="io1">3. तेरे पछेन पोलुस यरुसलमेन भुरसा करन्‌या वाटे पयस्‌यान वसुलीन बारामां बताड़े। <char style="ior"><ref loc="2CO 8:1-9:15">8:1—9:15</ref></char></para>
  <para style="io1">4. आकरी मां, पोलुस आपसा नेवताळान काम बड़नेन ने आपसान आवणे वाळी जाणेन बारामां सीक देय। <char style="ior"><ref loc="2CO 10:1-13:10">10:1—13:10</ref> </char></para>
  <chapter number="1" style="c" sid="2CO 1"/>
  <para style="s">आव-भाव</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 1:1"/>ए कुरींथीस सहर मां रहण्‌या भगवानेन मंडळीन माणसे, मे पोलुस, ईसु मसी पर भुरसु करन्‌या भाय भेटा तीमुथीयुस भेळे जी चिट्‌ठी तुहुंक लिखो। भगवान आपसी मरजीन अनसारे, मेसेक नेवाड़ीन ईसु मसीन नेवताळु बणावलु छे।</para>
  <para style="p" vid="2CO 1:1">जी चिट्‌ठी अखाया जीला मां आखे दुर रहण्‌या भगवानेन आखा चुखला माणसे वाटे बी लिखलु छे, जे ईसु मसी काजे माने।<verse eid="2CO 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 1:2"/>आपणा भगवान बासेन ने मालीक ईसु मसीन गीण-दया ने सुक सांती तुहुं आखा काजे जड़ती रहणु चाहजे।<verse eid="2CO 1:2"/></para>
  <para style="s">पोलुस भगवान काजे तु बेसकु वारु करीन कवे</para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 1:3"/>आपणा मालीक ईसु मसीन भगवान, ने बासेन तु बेसकु वारु छे करीन कहो, जु दयान बास, ने आखी भातीन मां सांतीन भगवान छे। <verse eid="2CO 1:3"/><verse number="4" style="v" sid="2CO 1:4"/>चु हामरे आखी आफोत मां सांती आपे, काहाकी हामु हीनी सांतीन वजे सी जु भगवान हामुक आपे, हीनुक बी सांती आप सके, काहाकी जे आखी आफोत मां पड़ र्‌या। <verse eid="2CO 1:4"/><verse number="5" style="v" sid="2CO 1:5"/>काहाकी जसा मसीन दुखे मां हामु जादास साजल्‌या हवजे, असात हामु सांती मां बी मसीन साहरे जादास साजल्‌या रवजे। <verse eid="2CO 1:5"/><verse number="6" style="v" sid="2CO 1:6"/>कदी हामु दुख झेलजे, ती जी तींद्‌री सांती ने छुटकारा वाटे छे, ने कदी सांती जड़े, जे तुंद्‌री सांती वाटे छे; जेरे ताकत सी तुहुं सेण करता जाय्‌न हीनु दुखे काजे सेण कर लेय, जीनुक हामु बी सेण करजे। <verse eid="2CO 1:6"/><verse number="7" style="v" sid="2CO 1:7"/>ने हामरी आस तुंद्‌रे बारामां काठी छे, काहाकी हामु जाणजे, की तुहुं जसा हामरा दुखे मां साजल्‌या छे असात सांती मां बी साजल्‌या छे।<verse eid="2CO 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 1:8"/>ए भायसे, हामु नी चाहता की तुहुं हामरे पर आवला हीना दुख सी अनजाण्‌या रवु। ज्‌य आसीया जीलाम हामरे उपर बेसकी आफोत आय पल्‌ली, ने ची वेला सेण नी हवे हामरी ताकत सी बाहार हतली अतरी जबर हतली की हामु जीवन सी बी मरने-मरने हय गुयला। <verse eid="2CO 1:8"/><verse number="9" style="v" sid="2CO 1:9"/>बाकुन हामु हामरा मन मां समजी लेदला, छे की हामरे पर मुतेन डंड जड़ीत गुय। की हामु आपणे पर भुरसु नी राखजे, बाकुन भगवान पर भुरसु राखजे। जु मरलाम सी जीवाड़े। <verse eid="2CO 1:9"/><verse number="10" style="v" sid="2CO 1:10"/>हव जुत भगवान हामुक मुतेम सी बचाड़्‌यु, ने अगु बी मुतेम सी बचाड़से, ने हामरी जी आस छे की चु अगु बी बचाड़तु रवसे। <verse eid="2CO 1:10"/><verse number="11" style="v" sid="2CO 1:11"/>तुहुं बी मेळीन दुवान साहरे हामरी मदत करसु, की जु भगवानेन वाटु बेसका माणसेन साहरे हामुक जड़लो छे, हेरे वजे बेसका माणसे हामरे भीणी सी तु बेसकु वारु छे कवे।<verse eid="2CO 1:11"/></para>
  <para style="s">पोलुस आपसान युजना बदले</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 1:12"/>काहाकी हामु आपणा मन हीनी गवाय पर मटाय करजे, की कळी मां ने खास करीन तुंद्‌रे ईचमां हामरु एहवार भगवान वाटे असो चुखलो ने छाचाय साते हतलु, जे डीलेन अक्‌कल सी नी, बाकुन भगवानेन गीण-दया साते हतला। <verse eid="2CO 1:12"/><verse number="13" style="v" sid="2CO 1:13"/>हामु तुहुंक काय नी लिखजे, सीरप ज तुहुं भणु ने मानु बी, ने मेसे आस छे, की आकरी लग बी मान्‌ता रवसु। <verse eid="2CO 1:13"/><verse number="14" style="v" sid="2CO 1:14"/>जसा तुंद्‌रे मां सी कतरा मानी लेदला छे, की हामु तुंद्‌रे मटायन वजे छे; असात तुहुं बी मालीक ईसुन दाहड़े हामरे वाटे मटायन वजे ठेरसु।<verse eid="2CO 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 1:15"/>ने हीना भुरसा सी मे चाहतेलु की पेहेल तुंद्‌रे धड़े आवो, की तुहुंक दुय कावा संयबरकत जड़नु चाहजे। <verse eid="2CO 1:15"/><verse number="16" style="v" sid="2CO 1:16"/>ने तुंद्‌रेन्‌चां मायन मकीदुनीया हय्‌न जायस, ने अळतेन पछु मकीदुनीया सी हय्‌न तुंद्‌रेन्‌चां आवीस ने तुहुं मेसेक यहुदीया जीला भीणी थुड़ीक वार लग पुगाड़ देजु। <verse eid="2CO 1:16"/><verse number="17" style="v" sid="2CO 1:17"/>हेरेसी मे जी मरजी करलु हतलु ती काय मे हींडणे फीरने वाळु देखाड़्‌यु काय? नीते ज करने चाह काय डीलेन अनसारे करने चाह, की मे वात मां “हव, हव” बी कहं; ने “नी, नी” बी कहं? <verse eid="2CO 1:17"/><verse number="18" style="v" sid="2CO 1:18"/>भगवान भुरसा वाळु गवा छे, की हामरे हीना बुल मां ज तुंद्‌रे सी कह्‌यु “हव” ने “नी” दुयु नी जड़े। <verse eid="2CO 1:18"/><verse number="19" style="v" sid="2CO 1:19"/>काहाकी भगवानेन पुर्‌यु ईसु मसी जेरो हामरे साहरे मतलब मारे ने सीलवानुस ने तीमुथीयुसेन साहरे तुंद्‌रे ईचमां मे परचार हयु; तेरेमां “हव” ने “नी” दुयु नी हतला; बाकुन, हेरे मां “हव” की “हव” हवे। <verse eid="2CO 1:19"/><verse number="20" style="v" sid="2CO 1:20"/>काहाकी भगवानेन वायदा छे, चे आखा हेरेमां “हव” हय्‌न साते छे हेरे सी हेरे साहरे असोत बी हवतो रवे बी हवे, की हामरे साहरे भगवानेन सेक-सींगार<note caller="+" style="f"><char style="fr" closed="false">1:20 </char><char style="fq" closed="false">सेक-सींगार </char><char style="ft" closed="false">महिमा</char></note> हवे। <verse eid="2CO 1:20"/><verse number="21" style="v" sid="2CO 1:21"/>ने ज हामु तुंद्‌रे साते मसी मां काठा करे, ने जु हामुक नेवाड़्‌लु छे चु भगवान छे <verse eid="2CO 1:21"/><verse number="22" style="v" sid="2CO 1:22"/>चु हामरे पर छाप बी कर देदु, ने बचाड़ने मां आत्‌मा काजे हामरे मनेम आप्‌यु।<verse eid="2CO 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2CO 1:23"/>मे भगवान काजे आपणी आत्‌मा सी गवा करीन कहं, की मे हय लग कुरींथीस मां हेरेसी नी आयु, की मेसे तुंद्‌रे पर दया आवतेली <verse eid="2CO 1:23"/><verse number="24" style="v" sid="2CO 1:24"/>ज नी, की हामु भुरसान बारामां तुंद्‌रे पर राज करीन हक जमाड़ने हींडजे; बाकुन तुंद्‌रे खुसी मां साजेदारी छे काहाकी तुहुं भुरसात मां पाक्‌का छे।<verse eid="2CO 1:24"/></para>
  <chapter eid="2CO 1"/>
  <chapter number="2" style="c" sid="2CO 2"/>
  <para style="p">
    <verse number="1" style="v" sid="2CO 2:1"/>हेरेसी मे मारा मन मां नक्‌खी कर लेदलु छे की, मे तुहुंक लड़ीन वेला पाड़ने करीन अळी पछु तुंद्‌रेन्‌चां हय नी आवो। <verse eid="2CO 2:1"/><verse number="2" style="v" sid="2CO 2:2"/>काहाकी कदी मे तुहुंक नीरास करो, ती मेसेक खुसी आपणे वाळु कुण रवसे, सीरप चु तीनाक मे नीरास कर्‌यु। <verse eid="2CO 2:2"/><verse number="3" style="v" sid="2CO 2:3"/>ने मे जी वात तुहुं काजे हेरेसी लिख र्‌यु, की काही असो नी हवे, की मारा आवणे पर हींद्‌रे सी मेसे खुसी जड़नु चाहजे, मे हींद्‌रे सी नीरास हय जाम; काहाकी मेसे आखा काजे हीनी वातेन भुरसु छे, की जु मारी खुसी छे, ची तुंद्‌रे आखा मां बी छे। <verse eid="2CO 2:3"/><verse number="4" style="v" sid="2CO 2:4"/>मटी आफोत, ने मनेन थकान सी मे बेसकु आसळा पाड़ी पाड़ीन तुहुंक लिखलो हतलो हेरेसी नी, की तुहुं नीरास हवु, बाकुन हेरेसी की तुहुं हीना मटला परम काजे जाणी लेवु, ज मेसे तुंद्‌रे सी छे।<verse eid="2CO 2:4"/></para>
  <para style="s">गुनु करलाक माफी आपु</para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 2:5"/>ने जु बी पाप करीन मेसेक वेला पाड़लु छे, चु मेसेक अतरात वेला नी पाड़्‌यु, बाकुन एक कहींयाम तुहुं आखाक वेला पाल्‌ला छे। तेबी हय मे ईनी वात काजे लीन तुहुंक जादा वेला पाड़ने नी हय र्‌या।<note caller="+" style="x"><char style="xo" closed="false">2:5 </char><char style="xt" closed="false"><ref loc="GAL 4:12">गलाती 4:12</ref></char></note> <verse eid="2CO 2:5"/><verse number="6" style="v" sid="2CO 2:6"/>काहाकी पाप करला काजे तुंद्‌रे मायन बेसका जणा मेळीन डंड आप्‌या। अतरोत घणो। हय ते चु सुदरी गुयु।<note caller="+" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="EPH 4:32">ईफीसी 4:32</ref></char></note> <verse eid="2CO 2:6"/><verse number="7" style="v" sid="2CO 2:7"/>हेरेसी ज्‌य वारु छे की हेरा गुना काजे माफ करु; ने सांती आपु, असा नी हवे की असा माणसे बेसका नीरास मां डुबी जाय। <verse eid="2CO 2:7"/><verse number="8" style="v" sid="2CO 2:8"/>हेरे वजे सी मे तुंद्‌रे सी लीलघायो, की हीना काजे आपणा परमेन सबुत आप देवु। <verse eid="2CO 2:8"/><verse number="9" style="v" sid="2CO 2:9"/>काहाकी मे हेरेसी बी लिखलु, की तुहुंक पारखी लम की तुहुं मारी आखी वाते काजे मान्‌ने वाटे तीयार हवु, की नी। <verse eid="2CO 2:9"/><verse number="10" style="v" sid="2CO 2:10"/>जेरो तुहुं काय माफ करता रवु हीनाक मे बी माफ<note caller="+" style="f"><char style="fr" closed="false">2:10 </char><char style="fq" closed="false">माफ </char><char style="ft" closed="false">क्षमा</char></note> करीस, काहाकी मे बी जो काय माफ कर्‌यु, कदी कर्‌या ती, तुंद्‌रे वजे सी मसीन जागा मां हयन माफ कर्‌या। <verse eid="2CO 2:10"/><verse number="11" style="v" sid="2CO 2:11"/>की भुतड़ान दावु हामरे पर नी चाले, काहाकी हामु हेरी सुच सी अनजाण्‌या नी हय।<verse eid="2CO 2:11"/></para>
  <para style="s">तरवास मां पोलुसेन दुख</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 2:12"/>जत्‌यार मे ईसु मसीन खुस-खबर सामळावणे करीन तरोआस मां आयु, ने मालीक मारे वाटे एक बारनो उगाड़ देदु। <verse eid="2CO 2:12"/><verse number="13" style="v" sid="2CO 2:13"/>ती मारा मन मां सांती नी जड़े, हेरेसी की मे आपणा भायस तीतुस काजे नी हेर्‌यु; हेरेसी हींद्‌रे सी आवजु ने आवसी करीन मे मकीदुनीया जीला मां जात र्‌यु।<verse eid="2CO 2:13"/></para>
  <para style="s">मसी मां जीतणेन खुसी</para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 2:14"/>बाकुन भगवान काजे तु बेसकु वारु छे करीन कह्‌वो, जु मसी मां जलम हामुक जीतेन खुसी मां लीन फीरे, ने आपणे अकलेन खुसबु हामरे साहरे आखी दुर फेलावे। <verse eid="2CO 2:14"/><verse number="15" style="v" sid="2CO 2:15"/>काहाकी हामु भगवान धड़े छुटकारु<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="fq" closed="false">छुटकारु </char><char style="ft" closed="false">उद्धार</char></note> जड़ने वाळा, ने खत्‌तम हवणे वाळा, दुयु वाटे मसीन खुसबु छे। <verse eid="2CO 2:15"/><verse number="16" style="v" sid="2CO 2:16"/>कतरा वाटे ते मरनेन वजे मरनेन गन्‌द, ने कतरा वाटे जीवनेन वजे खुसबु, वारु ईनी वातेन लायक कुण छे? <verse eid="2CO 2:16"/><verse number="17" style="v" sid="2CO 2:17"/>काहाकी हामु हीनु बेसकान तसा नी, जे भगवानेन बुल मां भेसकु करे; बाकुन मनेन छाचाय सी, ने भगवान भीणी सी भगवान काजे मारे साते छे करीन जाणीन ईसु मसी मां बुलो।<verse eid="2CO 2:17"/></para>
  <chapter eid="2CO 2"/>
  <chapter number="3" style="c" sid="2CO 3"/>
  <para style="s">नवला वायदान चाकर्‌या</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 3:1"/>काय हामु अळी पछा आपणी मटाय करने लागजे काय? नीते हामु काजे दीसरा माणसेन तसा दुवा कर्‌या की चिट्‌ठीया तुंद्‌रे धड़े लावणु नीते तुंद्‌रे सी लेणु छे? <verse eid="2CO 3:1"/><verse number="2" style="v" sid="2CO 3:2"/>हामरी चिट्‌ठी तुहुंत छे, जी हामरे मन मां लिखली छे, ने हीनी चिट्‌ठी काजे आखा माणसे उळखे ने भणे। <verse eid="2CO 3:2"/><verse number="3" style="v" sid="2CO 3:3"/>ज देखाय, की तुहुं ईसु मसीन चिट्‌ठी छे, तीनाक हामु चाकर्‌यान तसा लिखजे; ने जे लिखणेन सांय सी नी, बाकुन जीवतेला भगवानेन आत्‌मा सी दगड़ान पट्‌या पर नी, बाकुन मनेन मास<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="fq" closed="false">मास </char><char style="ft" closed="false">माँस</char></note> पट्‌या पर लिखली छे।<note caller="+" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="EXO 24:12">नीरगमन 24:12</ref>; <ref loc="EZK 11:19">यहेजकेल 11:19</ref>,<ref loc="EZK 11:20">20</ref></char></note><verse eid="2CO 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 3:4"/>हामु मसीन साहरे भगवान पर असात भुरसु राखजे। <verse eid="2CO 3:4"/><verse number="5" style="v" sid="2CO 3:5"/>ज नी, की हामु आपणे आप सी ईना लायक छे, की आपणे भीणी सी काहालीक वात काजे सुची समजी सकजे; बाकुन हामरी काबील भगवान भीणी सी छे। <verse eid="2CO 3:5"/><verse number="6" style="v" sid="2CO 3:6"/>चु हामु काजे नवला लिखला वायदान चाकर्‌या हवणे वाटे बी कर्‌या, बुलेन चाकर्‌या नी बाकुन आत्‌मान; काहाकी बुल मारे, बाकुन आत्‌मा जीवाड़े।<verse eid="2CO 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 3:7"/>कदी मरनेन वायदु जेरा आक्‌सर दगड़ा पर खुदी देदला, जां लग झजळन्‌या ताकत सी भरायला, मुसान मुंहडा परुन उजाळान वजे जो कम बी हवतो, जातलो ईस्‌रायेल हेरा मुंहडा पर नींगा नी कर सकतेला। <verse eid="2CO 3:7"/><verse number="8" style="v" sid="2CO 3:8"/>ती आत्‌मान वायदा अळी बी झजळन्‌या ताकत सी भरायला काहानी हवे? <verse eid="2CO 3:8"/><verse number="9" style="v" sid="2CO 3:9"/>काहाकी जत्‌यार गुनाळु ठेरावणे वाळु वायदु ताकत सी भरायला हतली, ती धरमी ठेरावणे वाळु वायदु ने बी झजळन्‌या ताकत सी भरायला काहा नी हवे? <verse eid="2CO 3:9"/><verse number="10" style="v" sid="2CO 3:10"/>ने जे झजळन्‌या सी भरायला हतलु, चु बी हीना उजाळान वजे जे हेरेसी बड़ीन वीजाळो हतला, काय बी झजळन्‌या सी भरायला नी ठेहर्‌या। <verse eid="2CO 3:10"/><verse number="11" style="v" sid="2CO 3:11"/>काहाकी जत्‌यार चु जे कम हवतो जातलो, ती हयु जु काठु रवसे, ने अळी बी झजळन्‌या काहानी रवे?<note caller="+" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="EXO 34:29">नीरगमन 34:29</ref>,<ref loc="EXO 34:30">30</ref></char></note> <verse eid="2CO 3:11"/><verse number="12" style="v" sid="2CO 3:12"/>हेरेसी असी आस राखीन हामु हिम्‌मतेन साते बुलजे। <verse eid="2CO 3:12"/><verse number="13" style="v" sid="2CO 3:13"/>ने मुसान तसा नी, जेरे आपणा मुंहडा पर पड़दु नाखतेला काहाकी ईस्‌रायली हीनी कम हवणे वाळा उजाळान आकरी<note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="fq" closed="false">आकरी </char><char style="ft" closed="false">अन्त</char></note> काजे नी देखे। <verse eid="2CO 3:13"/><verse number="14" style="v" sid="2CO 3:14"/>बाकुन चे डेड़-अकल्‌या हय गुया, काहाकी आज लग जुन्‌डला कायदान नेम भणते टेम हींद्‌रे मन पर चु पड़दु पड़ी रवलु; बाकुन चु ईसु मसी मां उठी जाय।<note caller="+" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="EXO 34:33-35">नीरगमन 34:33-35</ref></char></note> <verse eid="2CO 3:14"/><verse number="15" style="v" sid="2CO 3:15"/>आज लग जत्‌यार कदी मुसान किताप भणजे, ती हींद्‌रे मन पर पड़दु पड़ी रहे। <verse eid="2CO 3:15"/><verse number="16" style="v" sid="2CO 3:16"/>बाकुन जत्‌यार कदी हींद्‌रा मन मालीक भीणी सी फीरसे, तत्‌यार चु पड़दु उठी जासे।<note caller="+" style="x"><char style="xo" closed="false">3:16 </char><char style="xt" closed="false"><ref loc="EXO 34:34">नीरगमन 34:34</ref>; <ref loc="ISA 25:7">यसाया 25:7</ref></char></note> <verse eid="2CO 3:16"/><verse number="17" style="v" sid="2CO 3:17"/>मालीक ते आत्‌मा छे, “जांहा मालीक” छे चां छुटकारु छे। <verse eid="2CO 3:17"/><verse number="18" style="v" sid="2CO 3:18"/>बाकुन जत्‌यार हामु आत्‌मान उगाड़्‌ला सीका सी मालीकेन उजाळो एरेन तसों देखाव पड़े, जसों आरस्‌या मां, ते मालीकेन साहरे जी आत्‌मा छे, हामु तीनीत सेक-सींगार सी भरायला सीका मां थुड़ा-थुड़ा करीन बदलता जाय रया।<verse eid="2CO 3:18"/></para>
  <chapter eid="2CO 3"/>
  <chapter number="4" style="c" sid="2CO 4"/>
  <para style="s">धुळान बन्‌ला ठाहरा मां महंग्‌लो धन</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 4:1"/>हेरेसी जत्‌यार हामरे पर असी दया हवी, की हामु जी चाकरी जड़ी, ती हामुक हिम्‌मत नी हारजे। <verse eid="2CO 4:1"/><verse number="2" style="v" sid="2CO 4:2"/>बाकुन हामुक सरम आवे असला सातायला काम काजे छुड़ देदा, ने नी चतराय सी चालजे, ने नी भगवानेन बुल मां भेसकु करजे, बाकुन छाचाय काजे उजेंतो करीन, भगवान अगळ हरेक माणसेन मन मां आपणी भलाय देखाड़जे। <verse eid="2CO 4:2"/><verse number="3" style="v" sid="2CO 4:3"/>बाकुन कदी हामरे खुस-खबर पर पड़दु पड़लु छे, ती जी खत्‌तम हवणे वाळा वाटे पड़ला छे। <verse eid="2CO 4:3"/><verse number="4" style="v" sid="2CO 4:4"/>ने तीनु पर जे भुरसु नी करे हींद्‌रे वाटे, तींद्‌री अक्‌कल काजे ईनी कळीन देव आंदळा कर देदला छे, काहाकी मसी जु भगवानेन तसु सीकु छे, हेरे झजळन्‌या खुस-खबरेन उजाळो हींद्‌रे पर नी भबळे। <verse eid="2CO 4:4"/><verse number="5" style="v" sid="2CO 4:5"/>काहाकी हामु आपणे आप काजे नी, बाकुन मसी ईसु काजे परचार करजे, की चु मालीक छे; ने आपणा बारामां असो कहें, की हामु ईसुन वजे सी तुंद्‌रा पावर्‌या छे। <verse eid="2CO 4:5"/><verse number="6" style="v" sid="2CO 4:6"/>हेरेसी की, भगवानुत छे, जु कह्‌यु, “आंदारलान सी वीजाळो, भबळे ने चु हामरे मन मां भबळे की भगवानेन सेक-सींगारेन उळखाण वीजाळो<note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="fq" closed="false">वीजाळो </char><char style="ft" closed="false">ज्योति</char></note> ईसु मसीन सीका सी भबळे।”<verse eid="2CO 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 4:7"/>बाकुन हामरे धड़े चो धन धुळान ठाहरा मां मेकलो छे, की जी कदी नी खत्‌तम हवणे वाळी ताकत हामरे भीणी सी नी, बाकुन भगवान भीणी सी ठेरे। <verse eid="2CO 4:7"/><verse number="8" style="v" sid="2CO 4:8"/>हामरे चारे मेर सी दुख ते भुकतजे, बाकुन पीड़ा मां नी पड़जे; घांगवायला ते छे, बाकुन नीरास नी हवजे। <verse eid="2CO 4:8"/><verse number="9" style="v" sid="2CO 4:9"/>माणसे एला ते पाड़े बाकुन भगवान हामुक नी छुड़े, माणसे हामुक पाड़े, बाकुन खत्‌तम नी करे। <verse eid="2CO 4:9"/><verse number="10" style="v" sid="2CO 4:10"/>हामु ईसुन मरण काजे आपणा डील मां हर घड़ी लीन फीरजे; की ईसुन जीवन बी हामरा डील मां उजेंतो हवे। <verse eid="2CO 4:10"/><verse number="11" style="v" sid="2CO 4:11"/>काहाकी हामु जीवते जीव जलम ईसुन वजे सी मुतेन हात मां सुपायजे, की ईसुन जीवन बी हामरे मरला डील मां उजेंतो हवे। <verse eid="2CO 4:11"/><verse number="12" style="v" sid="2CO 4:12"/>हेरेसी मुत ते हामरे पर ताकत लावे ने जीवन तुंद्‌रे पर।<verse eid="2CO 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 4:13"/>हेरेसी की हामरे मां चीत भुरसान आत्‌मा छे, “जेरे बारामां लिखलो छे, मे भुरसु कर्‌यु।” हेरेसी कह्‌यु अळतेन हामु बी भुरसु करजे, तेरेसी बुलजे। <verse eid="2CO 4:13"/><verse number="14" style="v" sid="2CO 4:14"/>काहाकी हामु जाणजे, की जु मालीक ईसु काजे मरलाम सी जीवाड़े, चु हामुक बी ईसु मां साजल्‌यु जाणीन जीवाड़ेसे, ने तुंद्‌रे साते आपणे अगळ उबा करसे। <verse eid="2CO 4:14"/><verse number="15" style="v" sid="2CO 4:15"/>काहाकी आखी चीजे तुंद्‌रे वाटे छे, काहाकी गीण-दयान साहरे अदुस हयन भगवानेन सेक-सींगार वाटे तु बेसकु वारु छे करीन बी बड़ावे।<verse eid="2CO 4:15"/></para>
  <para style="s">भुरसा मां जीवणु</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 4:16"/>हेरेसी हामु हिम्‌मत नी, हारजे कदी हामरा बाहरलो माणसेन सीकु खत्‌तम हय जासे तेबी हामरो माहींन माणसेन सीकु दाहड़ीन-दाहड़ीन नवलु हवतु जाय। <verse eid="2CO 4:16"/><verse number="17" style="v" sid="2CO 4:17"/>काहाकी हामरु थुड़ाक दाहड़ान हळकु दुख हामरे वाटे बेसका खास ने जलमेन सेक-सींगार देवाड़े। <verse eid="2CO 4:17"/><verse number="18" style="v" sid="2CO 4:18"/>ने हामु ते देखली चीज काजे नी बाकुन नी देखाय असली चीज काजे देखता रवजे काहाकी देखली चीज, थुड़ाक दाहड़ान छे, बाकुन नी देखली चीज जलम बणीन रवसे।<verse eid="2CO 4:18"/></para>
  <chapter eid="2CO 4"/>
  <chapter number="5" style="c" sid="2CO 5"/>
  <para style="p">
    <verse number="1" style="v" sid="2CO 5:1"/>काहाकी हामु जाणजे की जत्‌यार हामरो धरती परुन तसलो घर उदार देसे, ती हामुक भगवान भीणी सी सरगे पर एक असु बंगलु<note caller="+" style="f"><char style="fr" closed="false">5:1 </char><char style="fq" closed="false">बंगलु </char><char style="ft" closed="false">भवन</char></note> जड़से, जो हाते सी बन्‌नलो घर नी बाकुन जलम लग बन्‌नलो<note caller="+" style="f"><char style="fr" closed="false">5:1 </char><char style="fq" closed="false">जलम लग बन्‌नलो </char><char style="ft" closed="false">चिरस्थाई</char></note> रवसे। <verse eid="2CO 5:1"/><verse number="2" style="v" sid="2CO 5:2"/>हेरेमां ते हामु तरसजे ने मटी लालुच राखजे; की आपणा सरगेन घर काजे पेहेरी लेजे। <verse eid="2CO 5:2"/><verse number="3" style="v" sid="2CO 5:3"/>की हीना काजे पेहरने सी हामु नांगरला नी जड़े। <verse eid="2CO 5:3"/><verse number="4" style="v" sid="2CO 5:4"/>ने हामु हीना तम्‌बु मां रवता जाय्‌न बुज सी दबला कवता रवजे काहाकी हामु उतारने नी, बाकुन अळी पेहरने चाहजे, काहाकी चु जो मरणहार छे जीवन मां डुब जाय। <verse eid="2CO 5:4"/><verse number="5" style="v" sid="2CO 5:5"/>जु हामुक हीनीत वात वाटे तीयार करला छे, ने चु भगवान छे, चु आपणुक सांय लीन जीव-आत्‌मा आप देदु,<verse eid="2CO 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 5:6"/>अळतेन हामु जलम हिम्‌मत धरीन रवजे ने ज्‌य जाणजे; की जत्‌यार लग हामु डील मां रवजे, तत्‌यार लग मालीक सी छेटा छे। <verse eid="2CO 5:6"/><verse number="7" style="v" sid="2CO 5:7"/>काहाकी हामु सीका काजे देखीन नी, बाकुन भुरसा सी चालजे। <verse eid="2CO 5:7"/><verse number="8" style="v" sid="2CO 5:8"/>हेरेसी हामु हिम्‌मत राखीन रवजे, ने डील सी छेटा हयन मालीक साते रवणु अळी बी वारु समजे। <verse eid="2CO 5:8"/><verse number="9" style="v" sid="2CO 5:9"/>हेरे वजे सी हामरे मनेन खुसी जी छे, की चाहे साते रवे, चाहे छेटा-छेटा रवे बाकुन हामु हीनाक बी जादा वारु गमे। <verse eid="2CO 5:9"/><verse number="10" style="v" sid="2CO 5:10"/>काहाकी जरुड़ी छे, की हामु आखान हामु मसीन नीयाव बास अगळ खुली जाय, की आखा एक अदमी आपणे-आपणे वारु भुंडा कामेन बदलु जु हीयु डीलेन साहरे करला छे जड़े।<verse eid="2CO 5:10"/></para>
  <para style="s">भगवानेन सी मेळ</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 5:11"/>हेरेसी मालीकेन धाक मानीन हामु माणसे काजे समजाड़जे बाकुन भगवान पर हामरु हाल उजेंतु छे; ने मारी आस जी छे, की तुंद्‌रो मन पर बी उजेंतो हय गुयला छे। <verse eid="2CO 5:11"/><verse number="12" style="v" sid="2CO 5:12"/>हामु तेबी आपणी बड़ाय तुंद्‌रे अगळ नी करजे बाकुन हामु आपणे बारामां तुहुंक मटाय करनेन मुखु देजे, की तुहुं हीनुक जपाप आप सकु, जे मन पर नी, बाकुन मे कसुक करीन देखाड़ने वाळी वात पर सी मटाय करजे। <verse eid="2CO 5:12"/><verse number="13" style="v" sid="2CO 5:13"/>कदी हामु बेहुस<note caller="+" style="f"><char style="fr" closed="false">5:13 </char><char style="fq" closed="false">बेहुस </char><char style="ft" closed="false">बेसुध</char></note> छे, ती भगवान वाटे; ने कदी समजी गुयला छे, ती तुंद्‌रे वाटे छे। <verse eid="2CO 5:13"/><verse number="14" style="v" sid="2CO 5:14"/>काहाकी मसीन परम हामुक लाचार कर देय; हेरेसी की हामु ज्‌य समज्‌जे, की जत्‌यार एक आखा वाटे मर गुयु ती आखा मर गुया। <verse eid="2CO 5:14"/><verse number="15" style="v" sid="2CO 5:15"/>ने चु हीनी वजे सी आखा वाटे मर्‌यु, की जे जीवतेला छे, चे अगा जाय्‌न आपणे वाटे नी जीवे बाकुन हेरे वाटे जे हींद्‌रे वाटे मर्‌या ने पछा मरलाम सी जीवता हय गुया।<verse eid="2CO 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 5:16"/>अळतेन हय सी हामु काहालाक काजे बी डीलेन अनसारे नी समजणु, चाहजे कदी हामु मसी काजे बी डीलेन अनसारे जाणु हतलो, तेबी हय सी हीनाक असा नी जाणजे। <verse eid="2CO 5:16"/><verse number="17" style="v" sid="2CO 5:17"/>हेरेसी कदी कुय ईसु मसी मां छे ती चु नवलु बन्‌नलु छे; जुन्‌डली वात जाती रय; देखु, आखी वात नवली हय गुय। <verse eid="2CO 5:17"/><verse number="18" style="v" sid="2CO 5:18"/>चे आखी वात भगवान भीणी सी छे तीनाक मसीन साहरे आपणे साते हामरो हेळ-मेळ कर लेदा ने हेळ-मेळ कराड़नेन चाकरी हामुक सुप देदु। <verse eid="2CO 5:18"/><verse number="19" style="v" sid="2CO 5:19"/>मतलब भगवान ईसु मसी मां हयन आपणे साते कळीन हेळ-मेळ कर देदा, ने हींद्‌रे पापेन गुनु हींद्‌रे पर नी लागाड़्‌या ने हीयु हेळ-मेळेन बुल हामुक सुप देदु।<verse eid="2CO 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CO 5:20"/>हेरेसी हामु मसीन आवजी पर काम करन्‌या छे; मानु भगवान हामरे साहरे समजाड़ी र्‌यु: हामु मसी भीणी सी लीलघायजे की भगवान साते हेळ-मेळ कर लेदा। <verse eid="2CO 5:20"/><verse number="21" style="v" sid="2CO 5:21"/>जे पाप सी अनजाण्‌या हतला, हीनुत काजे हयु हामरे वाटे पाप ठेहरायु, की हामु हींद्‌रे मां सी हयन भगवानेन धरमी बणी जाजे।<verse eid="2CO 5:21"/></para>
  <chapter eid="2CO 5"/>
  <chapter number="6" style="c" sid="2CO 6"/>
  <para style="p">
    <verse number="1" style="v" sid="2CO 6:1"/>हामु जे भगवानेन साजल्‌या<note caller="+" style="f"><char style="fr" closed="false">6:1 </char><char style="fq" closed="false">साजल्‌या </char><char style="ft" closed="false">सहकर्मी</char></note> हयन ज्‌य बी समजाड़जे, की भगवानेन गीण-दया जे तुंद्‌रे पर हया, फालतु नी जाणे देजे। <verse eid="2CO 6:1"/><verse number="2" style="v" sid="2CO 6:2"/>काहाकी चु ते कह्‌वे,</para>
  <para style="q1" vid="2CO 6:2">“आपणी खुसीन टेम मे तारी सामळीस,</para>
  <para style="q2" vid="2CO 6:2">ने छुटकारान दाहड़ु मे तारी, मदत कर्‌यु।”</para>
  <para style="q1" vid="2CO 6:2">देखु; हय खुस हवणेन टेम छे; देखु,</para>
  <para style="q2" vid="2CO 6:2">हय छुटकारान दाहड़ु छे।<verse eid="2CO 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 6:3"/>हामु काहाली बी वात मां ठुकर खाणेन काय बी जागु नी देजे, काहाकी हामरी चाकरी पर कुय गुनु नी आयु। <verse eid="2CO 6:3"/><verse number="4" style="v" sid="2CO 6:4"/>बाकुन आखी वात सी भगवानेन चाकर्‌यान तसा आपणे वारलु गुणे<note caller="+" style="f"><char style="fr" closed="false">6:4 </char><char style="fq" closed="false">वारलु गुणे</char><char style="ft" closed="false">सदुगुणों</char></note> काजे उजेंता करजे मटा गमे सी दुखे सी, गरीबी सी, पीड़ा, सी। <verse eid="2CO 6:4"/><verse number="5" style="v" sid="2CO 6:5"/>सपाटान मार खाणे सी, जेल मां बुजायणे हवणे सी माणसेन कचाटा सी काठी मेहनत सी जागला रवणे सी उपास करने सी। <verse eid="2CO 6:5"/><verse number="6" style="v" sid="2CO 6:6"/>चुखला सी, अक्‌कल सी, गम धरने सी, दया वाळा सी, चुखली-आत्‌मा ने छाचला परम सी। <verse eid="2CO 6:6"/><verse number="7" style="v" sid="2CO 6:7"/>छाचला रय्‌न ईसुन खरला बुले सी, भगवानेन ताकत सी; धरमेन हत्‌यार सी, जे जेवड़े ने डाखर्‌ये हात मां छे, <verse eid="2CO 6:7"/><verse number="8" style="v" sid="2CO 6:8"/>हामरी ईज्‌जत करे तेबी, ने ईज्‌जत नी करे तेबी, हामरी नाव-बद्‌दी करे, तेबी, हामु नाव साद्‌या हवजे तेबी भगवानेन सेवा करने तीयार छे। भले हामु दीसराक ठगण्‌या तसा लाग्‌जे तेबी छाचाय काजे उजेंता करजे। <verse eid="2CO 6:8"/><verse number="9" style="v" sid="2CO 6:9"/>हामु ईसुन नेवताळा छे जी वात जे नी समजे तींद्‌रे अगळ हामु अनजाण्‌यान तसा छे; तेबी जे हामुक समजे तींद्‌रे अगळ हामु नाव सादीन छे; माणसे हामुक मारीन नाखणे हय र्‌या, बाकुन तेबी देखु हय लग जीवता छे; हामु दीसरा माणसेन साहरे डंड भुक्‌ती र्‌या बाकुन तेबी हामु नी मरजे। <verse eid="2CO 6:9"/><verse number="10" style="v" sid="2CO 6:10"/>दुख करने वाळान तसा छे, बाकुन जलम खुसी करे, गरीबी तसा छे, बाकुन बेसका काजे पयस्‌या वाळा बणाय देय, असा छे जसा हामरे धड़े काय नी तेबी आखो काय राखजे।<verse eid="2CO 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 6:11"/>ए कुरींथीयो, हामु खुलाम खुल्‌ला वात कर्‌या, हामरो मन तुंद्‌रे भीणी उगाड़्‌लो छे। <verse eid="2CO 6:11"/><verse number="12" style="v" sid="2CO 6:12"/>तुंद्‌रे वाटे हामरा मन मां काय खेचा ताण नी हय, बाकुन तुंद्‌रेत मन मां खेचा ताण छे। <verse eid="2CO 6:12"/><verse number="13" style="v" sid="2CO 6:13"/>बाकुन आपणा पुर्‌या जाणीन तुंद्‌रे सी कहो, की तुहुं बी हेरे बदला मां आपणा मन काजे उगाड़ देवु।<verse eid="2CO 6:13"/></para>
  <para style="s">हामु जीवतेला भगवानेन मंदीर छे</para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 6:14"/>भुरसु नी करे, हींद्‌रे साते तुंद्‌रो जुड़ो नी लागे। हेरेसी हींद्‌रे भेळा मां साजल्‌या बणु, काहाकी धरम ने पाप मेळ खाय काय? नीते उजाळो ने आंदारलान काय मेळ? <verse eid="2CO 6:14"/><verse number="15" style="v" sid="2CO 6:15"/>ईसु मसी भुतड़ा साते दुस्‌ती करे काय? नीते भुरसु करन्‌या ने नी भुरसु करन्‌या सी काय नातो? <verse eid="2CO 6:15"/><verse number="16" style="v" sid="2CO 6:16"/>ने मुरत्‌या साते भगवानेन मंदीरेन काय नातो?</para>
  <para style="q1" vid="2CO 6:16">काहाकी हामु ते जीवतेला भगवानेन मंदीर छे;</para>
  <para style="q2" vid="2CO 6:16">जसु भगवान कह्‌यु मे हींद्‌रे मां बसीस ने हींद्‌रे मां चालीस फीरीस;</para>
  <para style="q1" vid="2CO 6:16">ने मे हींद्‌रु भगवान हवीस,</para>
  <para style="q2" vid="2CO 6:16">ने चे मारा माणसे रवसे।<verse eid="2CO 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CO 6:17"/>हेरेसी मालीक कवे,</para>
  <para style="q1" vid="2CO 6:17">हींद्‌रे ईचमां सी नीकळु ने आंग्‌ये रहु;</para>
  <para style="q2" vid="2CO 6:17">ने वीटाळ देय असली,</para>
  <para style="q1" vid="2CO 6:17">चीज काजे मां धरु,</para>
  <para style="q2" vid="2CO 6:17">ती मे तुहुंक अगु करीस।<verse eid="2CO 6:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="2CO 6:18"/>ने मे तुंद्‌रु बास रवीस,</para>
  <para style="q2" vid="2CO 6:18">ने तुहुं मारा पुर्‌या ने पुरे रवसु,</para>
  <para style="q2" vid="2CO 6:18">जी आखा सी ताकतवाळु मालीक भगवानेन बुल छे।<verse eid="2CO 6:18"/></para>
  <chapter eid="2CO 6"/>
  <chapter number="7" style="c" sid="2CO 7"/>
  <para style="p">
    <verse number="1" style="v" sid="2CO 7:1"/>अळतेन ए लाटेक्‌लु भायसे जत्‌यार की जु वायदु हामुक जड़लु छे, ती आवु, हामु आपणे आप काजे डील ने आत्‌मान आखा पापे सी चुखला करे, ने भगवान काजे बीहता जाय्‌न चुखला काजे पुरो करु।<verse eid="2CO 7:1"/></para>
  <para style="s">पोलुसेन खुसी</para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 7:2"/>हामुक आपणा मन मां जागा आपु; हामु ते तुंद्‌रे मायन काहालान बी हामु बयमानी नी कर्‌या ने काहालाक काजे बीगाड़्‌या, नी काहनाक काजे नी ठग्‌या <verse eid="2CO 7:2"/><verse number="3" style="v" sid="2CO 7:3"/>ने तुहुं गुना वाळा ठेराड़ने वाटे ज नी कवतु काहाकी मे पेहेल सी कय देदलु छे, की तुहुं हामरे मन मां असा बसी गुया की हामु तुंद्‌रे साते मरणे जीवणे वाटे बी तीयार छे। <verse eid="2CO 7:3"/><verse number="4" style="v" sid="2CO 7:4"/>मे तुंद्‌रे सी बेसकु हिम्‌मतेन साते कय र्‌यु, मेसे तुंद्‌रे पर मटुत घमट छे; मे सांती भराय गुयु; आपणा आखा दुख<note caller="+" style="f"><char style="fr" closed="false">7:4 </char><char style="fq" closed="false">दुख </char><char style="ft" closed="false">क्लेश</char></note> मां सी ने मे बेसकु कायनी खुस छे।<verse eid="2CO 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 7:5"/>काहाकी जत्‌यार हामु मकीदुनीया मां आया, तत्‌यार बी हामरा डील काजे आराम नी जड़्‌यो, बाकुन हामुक चारे मेर सी दुख जड़तेला; बाहार झगड़ा हतला, माहें बीहणे वाळी वात हतली। <verse eid="2CO 7:5"/><verse number="6" style="v" sid="2CO 7:6"/>तेबी हीनु काजे सांती आपणे वाळु भगवान तीतुसेन आवणे सी हामु काजे सांती आप्‌यु। <verse eid="2CO 7:6"/><verse number="7" style="v" sid="2CO 7:7"/>ने हेरे आवणे सी अतरुत नी, बाकुन हीनी सांती सी बी, जे हेरो तुंद्‌रे भीणी सी जड़ली हतली; हयु तुंद्‌री लालच सी, ने तुंद्‌रो दुख ने मारे वाटे तुंद्‌री धुन काजे खबर हामुक सामळावे, जेरे सी मेसेक अळी बी खुसी हवे।<verse eid="2CO 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 7:8"/>काहाकी कदी मे आपणी चिट्‌ठी सी तुहुंक दुखी कर्‌यु, बाकुन हेरसी पसतावु नी करतु जसों की पेहेल पसतावु हतलु काहाकी मे देखो की हीनी चिट्‌ठी सी तुहुं काजे दुख ते हयु। बाकुन च थुड़ीक वार वाटे हतलो। <verse eid="2CO 7:8"/><verse number="9" style="v" sid="2CO 7:9"/>हय ने खुसी हयु बाकुन हेरेसी नी की तुहुं काजे आफोत आय बाकुन हेरेसी की तुहुं हीना आफोतेन वजे सी मन फीराया, काहाकी तुंद्‌रो आफोत भगवानेन मरजीन अनसारे हतलो, ती हामरे भीणी सी तुहुंक काहनी वात मां नुकसाण नी हवे <verse eid="2CO 7:9"/><verse number="10" style="v" sid="2CO 7:10"/>काहाकी भगवान भक्‌तीन आफोत असा पसतावु पयदा करे; की जेरो सबुत छुटकारु छे। ने अळतेन हीनाक पसतावु नी हवे! बाकुन कळीन डीलेन दुख मुत काजे पयदा करे। <verse eid="2CO 7:10"/><verse number="11" style="v" sid="2CO 7:11"/>अळतेन देखु, ईनी वात सी की तुहुं भगवानेन भक्‌तीन आफोत हया; तुंद्‌रे मां कतरो खुसीन, जपाप, ए रीस, बीहणु, ने लालच, ने धुन ने डंड आपणेन वीच्‌यार पयदा हवे? तुहुं आखी भाती सी ज चुखो करीन देखाड़्‌या, की तुहुं हीनी वात मां नी-गुना वाळा छे।<verse eid="2CO 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 7:12"/>जी चिट्‌ठी जु पाप कर्‌यु तेरे वाटे नी लिख्‌यु ने जु बयमानी कर्‌यु तेरे वाटे बी नी लिख्‌यु, बाकुन तुंद्‌रे वाटे एरेन करीन लिख्‌यु की तुंद्‌री खुसी जी हामरे वाटे छे, ची हवस भगवान अगळ उजेंती हय जाय। <verse eid="2CO 7:12"/><verse number="13" style="v" sid="2CO 7:13"/>हेरेसी हामुक सांती जड़े।</para>
  <para style="p" vid="2CO 7:13">हामरी सांती साते तीतुसेन खुसीन वजे सी अळी बी खुसी हवे, काहाकी हेरा जीव तुहुं आखान वजे सी खुसी मां गद-गद हय गुया! <verse eid="2CO 7:13"/><verse number="14" style="v" sid="2CO 7:14"/>काहाकी कदी मे हेरे अगळ तुंद्‌रे बारामां काय मटाय देखाड़्‌यु, ती लाजवाये नी, बाकुन जसा हामु तुंद्‌रे सी आखी वात छाचली कय देदला, असात हामरी मटाय देखाय तीतुस अगळ बी छाचली नीकळी। <verse eid="2CO 7:14"/><verse number="15" style="v" sid="2CO 7:15"/>जत्‌यार हेरो तुहुं आखान हुकुम मान्‌या<note caller="+" style="f"><char style="fr" closed="false">7:15 </char><char style="fq" closed="false">हुकुम मान्‌या </char><char style="ft" closed="false">आज्ञाकारी</char></note> हवणेन हेर आवे, की कसा तुहुं बीहता जाय्‌न ने घाबरायता जाय्‌न ने भेट कर्‌या; ती हेरा परम अळी बी बड़तो जाय। <verse eid="2CO 7:15"/><verse number="16" style="v" sid="2CO 7:16"/>मे खुसी मां छे, काहाकी मेसेक तुंद्‌रे भीणी सी वात मां पुरु भुरसु छे।<verse eid="2CO 7:16"/></para>
  <chapter eid="2CO 7"/>
  <chapter number="8" style="c" sid="2CO 8"/>
  <para style="s">खुला मन सी दान आपणु</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 8:1"/>हय ए भायसे, हामु तुहुंक भगवानेन हीना गीण-दयान खबर आपजे, जे मकीदुनीयान मंडळी पर हयो। <verse eid="2CO 8:1"/><verse number="2" style="v" sid="2CO 8:2"/>की दुखेन मट्‌ली पारख मां हींद्‌रे मटला खुसी ने मटी गरीबी मां हींद्‌रे खुला मन सी<note caller="+" style="f"><char style="fr" closed="false">8:2 </char><char style="fq" closed="false">खुला मन सी </char><char style="ft" closed="false">उदार</char></note> बेसकी अदी गुय। <verse eid="2CO 8:2"/><verse number="3" style="v" sid="2CO 8:3"/>हींद्‌रे बारामां मारी जी गवाय छे, की हीनुक आपणी ताकत भरीन बाकुन ताकत सी बी बाहार मन सी आप देदा। <verse eid="2CO 8:3"/><verse number="4" style="v" sid="2CO 8:4"/>ने हीना दान मां ने चुखला माणसेन चाकरी मां साजल्‌या हवणेन गीण-दयान बारामां हामरे सी पछात-पछात बेसका लीलघाया। <verse eid="2CO 8:4"/><verse number="5" style="v" sid="2CO 8:5"/>ने जसा हामु ने आस करला हतला, असात नी, बाकुन चे मालीक काजे, अळतेन भगवानेन मरजी सी हामु काजे बी आपणे आप काजे आप देदा। <verse eid="2CO 8:5"/><verse number="6" style="v" sid="2CO 8:6"/>हेरेसी हामु तीतुस काजे समजाड़्‌या, की जसों हयु पेहल सुरु करलु हतलु, असात तुंद्‌रे ईचमां हीनी दानेन काम काजे पुरो बी करला। <verse eid="2CO 8:6"/><verse number="7" style="v" sid="2CO 8:7"/>हेरेसी जसा तुहुं आखी वात मां मतलब भुरसु, बुल, अक्‌कल ने आखी भातीन खुसी मां, ने हीना परम मां, जे हामरे सी राखे, अदता जावु, असात हीना दानेन काम मां बी अदता जावु।<verse eid="2CO 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 8:8"/>मे हुकुमेन रीत पर ते नी, बाकुन दीसरान खुसी सी तुंद्‌रे परमेन छाचाय काजे पारखणे वाटे कहो। <verse eid="2CO 8:8"/><verse number="9" style="v" sid="2CO 8:9"/>तुहुं हामरा मालीक ईसु मसीन गीण-दया काजे जाणु, की चु पयस्‌या वाळु हयन बी तुंद्‌रे वाटे खाली हय गुयु काहाकी हेरे खाली हय जाणे सी तुहुं पयस्‌या वाळा हय जावु।<verse eid="2CO 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 8:10"/>ने हीनी वात मां मारु वीच्‌यार जु छे। ज्‌य तुंद्‌रे वाटे वारलु छे जे एक साल सी नी ते सीरप हीना काम काजे करनेत मां, बाकुन हीनी वातेन चाहावणे मां बी पेहल हतला। <verse eid="2CO 8:10"/><verse number="11" style="v" sid="2CO 8:11"/>हेरेसी हय ज्‌य काम पुरो करु; की जसी मरजी करने मां तुहुं तीयार हतला, असात आपणी-आपणी कमायन अनसारे पुरा बी करु। <verse eid="2CO 8:11"/><verse number="12" style="v" sid="2CO 8:12"/>काहाकी कदी मनेन तीयारी हय जाय ती दान हेरे अनसारे अगा बी हवे जे हेरे धड़े छे असो नी की हेरे अनसारे जो तेरे धड़े नी हय।<verse eid="2CO 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 8:13"/>ज्‌य नी की दीसरा काजे सांती<note caller="+" style="f"><char style="fr" closed="false">8:13 </char><char style="fq" closed="false">सांती </char><char style="ft" closed="false">चैन</char></note> ने तुहुं काजे दुख जड़े। <verse eid="2CO 8:13"/><verse number="14" style="v" sid="2CO 8:14"/>बाकुन बराबरेन वीच्‌यार सी ईनी टेमे तुंद्‌री बड़ती ने तुंद्‌री कमी मां काम आवे, काहाकी तुंद्‌री अदती बी ने तुंद्‌री कमी मां काम आवे, की बराबर हय जाय। <verse eid="2CO 8:14"/><verse number="15" style="v" sid="2CO 8:15"/>जसों लिखलो छे, “जु बेसका भेळा कर्‌यु हेरा काम अदुस नी नीकळ्‌या ने जे थुड़ाक भेळा कर्‌यु तेरो कम नी नीकळ्‌यो।”<verse eid="2CO 8:15"/></para>
  <para style="s">तीतुस ने हेरु साजल्‌यु</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 8:16"/>भगवान काजे तु बेसकु वारु छे करीन कह्‌वो, जु तुंद्‌रे वाटे जीत खुसी तीतुसेन मन मां भर देदु। <verse eid="2CO 8:16"/><verse number="17" style="v" sid="2CO 8:17"/>की हयु हामरो समजाड़नु मान लेदु ने बेसकु खुसी हयन चु आपणी मरजी सी तुंद्‌रे धड़े गुयु। <verse eid="2CO 8:17"/><verse number="18" style="v" sid="2CO 8:18"/>हामु हेरे धड़े हीना भायस काजे बी मकेल्‌ला जेरो नाव खुस-खबरेन बारामां आखी मंडळी मां फेलाय देदा; <verse eid="2CO 8:18"/><verse number="19" style="v" sid="2CO 8:19"/>ने अतरात नी, बाकुन चु मंडळीन साहरे ठेराया बी गुया की हीना दानेन काम वाटे हामरे भेळा जाय हामु जी चाकरी हेरेसी करजे, की मालीकेन सेक-सींगार ने हामरे मनेन तीयारी देखाव पड़ जाय।<verse eid="2CO 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CO 8:20"/>हामु हीनी वात मां चेतीन रवु, की हीनी खुला मन सी कामेन बारामां तींद्‌री चाकरी हामु करजे, कुय बी हामरे पर गुना नी लागाड़नु चाहजे। <verse eid="2CO 8:20"/><verse number="21" style="v" sid="2CO 8:21"/>काहाकी जी वात मालीक धड़े अतरोत नी, बाकुन माणसेन धड़े बी वारु छे हामु हींद्‌री फीकुर करजे।<verse eid="2CO 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CO 8:22"/>हामु हेरे भेळा आपणा भायस काजे बी मकेल्‌ला छे, तीना काजे हामु अळी अळीन पारख्‌या, बेसकी वात मां खुसी हवला देख्‌या; बाकुन हय तुंद्‌रे पर हेरु मट्‌लु भुरसु छे, हीनी वजे सी चु अळी बी जादास खुसी छे। <verse eid="2CO 8:22"/><verse number="23" style="v" sid="2CO 8:23"/>कदी कुय तीतुसेन बारामां पुछे, ती चु मारु साती, ने तुंद्‌रे वाटे मारु साजल्‌यु छे। ने कदी हामरा भायसेन बारामां पुछे ती चे मंडळीन नेवताळा ने मसीन सेक-सींगार छे। <verse eid="2CO 8:23"/><verse number="24" style="v" sid="2CO 8:24"/>अळतेन आपणा परम ने हामरु चु मटाय जे तुंद्‌रे बारामां छे मंडळी अगळ पुरो करीन हीनुक देखाड़े।<verse eid="2CO 8:24"/></para>
  <chapter eid="2CO 8"/>
  <chapter number="9" style="c" sid="2CO 9"/>
  <para style="s">भेळा रवण्‌या मसी माणसे वाटे मदत</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 9:1"/>हय तीनी चाकरीन बारामां जे चुखला माणसे वाटे कर र्‌या, मेसे तुहुं काजे लिखणु जरुड़ी नी हय। <verse eid="2CO 9:1"/><verse number="2" style="v" sid="2CO 9:2"/>काहाकी मे तुंद्‌रे मनेन तीयारी काजे जाणो, जेरे वजे सी मे तुंद्‌रे बारामां मकीदुनीयाम रवण्‌यान अगळ मटाय देखाड़ो, की अखायान माणसे एक साल सी तीयार हवला छे, ने तुंद्‌री खुसी बेसका काजे उभार्‌या बी। <verse eid="2CO 9:2"/><verse number="3" style="v" sid="2CO 9:3"/>बाकुन मे भायसे काजे हेरेसी मकेल्‌लु छे, की हामु जे मटाय तुंद्‌रे बारामां देखाड़जे, चु ईनी वात मां फालतु नी ठेहरे; बाकुन जसों की मे कहं; असात तुहुं बी तीयार रहु <verse eid="2CO 9:3"/><verse number="4" style="v" sid="2CO 9:4"/>असो नी हवे, की कदी कुय मकीदुनीया वाळा मारे धड़े आया, ने तुहुं तीयार नी रवु, की हय सके की हीना भुरसान वजे सी हामु ज नी कवता की तुहुंक सरमायु<note caller="+" style="f"><char style="fr" closed="false">9:4 </char><char style="fq" closed="false">सरमायु </char><char style="ft" closed="false">लज्जित</char></note>! <verse eid="2CO 9:4"/><verse number="5" style="v" sid="2CO 9:5"/>हेरेसी मे भायसे सी जी लीलघायान करनु जरुड़ी समजी गुयु की जे पेहेल सी तुंद्‌रे धड़े आया, ने तुंद्‌रा खुल्‌ला मन सी फळ तींद्‌रे बारामां पेहलुत सी बुल आपला हतला, तीयार करीन राखु, की ज दबाव सी नी बाकुन खुले मनेन फळेन तसा तीयार रवु।<verse eid="2CO 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 9:6"/>बाकुन वात जी छे, जे ईतरोक वेरे चु ईतरोक काटे बी, ने जे बेसको वेरे, चु बेसको काटसे। <verse eid="2CO 9:6"/><verse number="7" style="v" sid="2CO 9:7"/>आखा माणुस जसों मन मां ठाणी लेय असोत दान करे; नी कुड़-कुड़ सी, ने नी दबाव सी, काहाकी भगवान खुसी सी आपणे वाळा सी परम राखे। <verse eid="2CO 9:7"/><verse number="8" style="v" sid="2CO 9:8"/>भगवान आखी भातीन गीण-दया सी बेसकु बड़ीन आप सके जेरे सी आखी वात मां ने आखी टेमे, आखो काय, जो तुहुंक जरुड़ी रवे, तुंद्‌रे धड़े रवे, आखो वारु काम वाटे तुंद्‌रे धड़े हवे। <verse eid="2CO 9:8"/><verse number="9" style="v" sid="2CO 9:9"/>जसों लिखलो छे,</para>
  <para style="q1" vid="2CO 9:9">“हयु आरवी देदु, ने खाली काजे दान आप्‌यु,</para>
  <para style="q2" vid="2CO 9:9">हेरो धरम जलम बणीन रवसे।”<verse eid="2CO 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 9:10"/>अळतेन जे एरने वाळा काजे बीज, ने खाणे वाटे रुटा आपे, चु तुहुंक बीज आपसे ने हीनाक फळ वाळु करसे; ने तुंद्‌रे धरमेन फळे काजे बड़ावसे। <verse eid="2CO 9:10"/><verse number="11" style="v" sid="2CO 9:11"/>तुहुं आखी वात मां आखी भातीन खुला वाटे जे हामरे साहरे भगवान काजे तु बेसकु वारु <note caller="+" style="f"><char style="fr" closed="false">9:11 </char><char style="fq" closed="false">तु बेसकु वारु </char><char style="ft" closed="false">धन्यवाद</char></note>छे करीन कह्‌वाड़े, पयस्‌या वाळा हय जावु। <verse eid="2CO 9:11"/><verse number="12" style="v" sid="2CO 9:12"/>काहाकी हीनी चाकरीन पुरो करने सी, चुखला माणसेन मांगे अतरी पुरी नी हवसे, बाकुन माणसे भीणी सी भगवानेन बी बेसकु वारु छे करीन कहवाय्‌से। <verse eid="2CO 9:12"/><verse number="13" style="v" sid="2CO 9:13"/>काहाकी हीनी चाकरी काजे सबुत काजे माने चे भगवानेन सेक-सींगार देखाड़े करे, की तुहुं मसीन खुस-खबर काजे मानीन हेरे हक मां रवे, ने हींद्‌री, ने आखी मदत करने मां उदार देखाड़ता रवे। <verse eid="2CO 9:13"/><verse number="14" style="v" sid="2CO 9:14"/>ने चे तुंद्‌रे वाटे दुवा करे, ने हेरेसी की तुंद्‌रे पर भगवानेन मट्‌ली गीण-दया सी, तुंद्‌री लालच करती रवे। <verse eid="2CO 9:14"/><verse number="15" style="v" sid="2CO 9:15"/>भगवानेन तीना दानेन वाटे जे समज सी बाहार छे, तु बेसकु वारु छे।<verse eid="2CO 9:15"/></para>
  <chapter eid="2CO 9"/>
  <chapter number="10" style="c" sid="2CO 10"/>
  <para style="s">पोलुसेन हक</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 10:1"/>मे चु पोलुस जे तुंद्‌रे अगळ लीलघाये, बाकुन आसा पछळ तुंद्‌री अळी हिम्‌मत करो; तुहुं काजे मसीन नरम, ने लाड़-परम सी समजाड़ो, <verse eid="2CO 10:1"/><verse number="2" style="v" sid="2CO 10:2"/>मे जी लीलघाया करो, की तुंद्‌रे अगळ मेसे ताकत वाळु हय्‌न हिम्‌मत करनु नी पड़े; जसु मे काय माणसे पर जे हामु काजे डीलेन अनसारे चालने वाळा समजे, हिम्‌मत देखाड़ने वीच्‌यार करो। <verse eid="2CO 10:2"/><verse number="3" style="v" sid="2CO 10:3"/>ज्‌य सय छे की कदी हामु डील मां चालजे ने फीरजे, तेबी डीलेन अनसारे नी लड़ायजे। <verse eid="2CO 10:3"/><verse number="4" style="v" sid="2CO 10:4"/>काहाकी हामरी लड़ाय हत्‌यार कळीन तसी नी, बाकुन गड़ काजे उदार नाखणे वाटे भगवानेन साहरे ताकत वाळा छे। <verse eid="2CO 10:4"/><verse number="5" style="v" sid="2CO 10:5"/>हेरेसी हामु मनेन उपजाव काजे, ने हरीक एक उचली वात काजे, जी भगवानेन उवखाणेन वीरुद मां उठे, आंग्‌ये-आंग्‌ये<note caller="+" style="f"><char style="fr" closed="false">10:5 </char><char style="fq" closed="false">आंग्‌ये-आंग्‌ये </char><char style="ft" closed="false">खण्डन</char></note> करजे; ने मसीन हरीक एक हुकुम मान्‌या बणाय देय। <verse eid="2CO 10:5"/><verse number="6" style="v" sid="2CO 10:6"/>ने तीयार रवे की जत्‌यार तुंद्‌रा हुकुम पाळनेन दाहड़ा पुरा हय जाय, ती हरीक भातीन हुकुम नी मान्‌या काजे डंड आपे।<verse eid="2CO 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 10:7"/>तुहुं ईनीत वात काजे देखु, जे डुळा अगळ छे, ती काहालाक काजे आपणे पर जु भुरसु छे, की मे मसीन छे, ती चु ज बी जाणी लेय, चु मसीन छे, असात हामु बी छे। <verse eid="2CO 10:7"/><verse number="8" style="v" sid="2CO 10:8"/>काहाकी कदी मे हीना हकेन बारामां अळी बी मटाय देखाड़ो, जे मालीक तुंद्‌रे बीगाड़ने वाटे नी बाकुन बणावणे वाटे हामुक आपलो छे, ती सरमाये नी। <verse eid="2CO 10:8"/><verse number="9" style="v" sid="2CO 10:9"/>ज्‌य मे हेरेसी कवो, की चिट्‌ठीन साहरे तुहुंक बीहाड़ने वाळा नी ठेरे। <verse eid="2CO 10:9"/><verse number="10" style="v" sid="2CO 10:10"/>काहाकी चे कवे, “हेरी चिट्‌ठीया ते बेसका ताकत वाळा ने हिम्‌मत देखाड़न्‌या छे; बाकुन जत्‌यार देखे, ती कहें की चु डीलेन लुलु ने कहणे<note caller="+" style="f"><char style="fr" closed="false">10:10 </char><char style="fq" closed="false">कहणे </char><char style="ft" closed="false">वक्तव्य</char></note> मां हळकु जाणी पड़े।” <verse eid="2CO 10:10"/><verse number="11" style="v" sid="2CO 10:11"/>जु असु कहें, चु ज समज राखे, की जसा आसा पछळ चिट्‌ठीया मां हामरा बुल छे, असात तुंद्‌रे अगळ हामरे काम बी हवसे।<verse eid="2CO 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 10:12"/>काहाकी हामु जी हिम्‌मत नी की हामु आपणे आप काजे हींद्‌रे मां सी असा काय साते गीणे, नीते तीनुक आपणु काजे भेळा करे, जे आपणी बड़ाय आपसु करे, ने आपणे आप काजे आंबा-सांबा नापीन तुलीन एक दीसरा सी भेळा करीन डेड़-अकल्‌या ठेरजे। <verse eid="2CO 10:12"/><verse number="13" style="v" sid="2CO 10:13"/>हामु ते काकड़ सी बाहार मटाय कदी नी करे, बाकुन हीना काकड़ लग जे भगवान हामरे वाटे ठेराय देदला छे, ने हेरे मां तुहुं बी आय गुयला छे। ने हेरे अनसारे मटाय बी करसुन। <verse eid="2CO 10:13"/><verse number="14" style="v" sid="2CO 10:14"/>काहाकी हामु आपणा काकड़ सी बाहार आपणे आप काजे बड़ावु नी चाहतु, जसा की तुंद्‌रे लग नी पुगणेन दसा मां हवे, बाकुन मसीन खुस-खबर सामळावता जाय्‌न तुंद्‌रे धड़े लग आय गुयला छे। <verse eid="2CO 10:14"/><verse number="15" style="v" sid="2CO 10:15"/>हामु काकड़ सी बाहार दीसरान मेहनत पर मटाय नी करजे; बाकुन हामुक आस छे, की जसु-जसु तुंद्‌रु भुरसु बड़तु जासे असात-असात हामु बी आपणा-आपणा काकड़ेन अनसारे तुंद्‌रे वजे सी अळी बी बड़ता जासुन। <verse eid="2CO 10:15"/><verse number="16" style="v" sid="2CO 10:16"/>काहाकी हामु तुंद्‌रा काकड़ सी अगा बड़ीन खुस-खबर सामळ्‌या, ने ज्‌य नी, की हामु दीसरान काकड़ेन माहें बणावला काम पर मटाय करजे।<verse eid="2CO 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CO 10:17"/>बाकुन जो मटाय करे, चु मालीक पर मटाय करे <verse eid="2CO 10:17"/><verse number="18" style="v" sid="2CO 10:18"/>काहाकी जो आपणी बड़ाय करे, चु नी, बाकुन जेरी बड़ाय मालीक करे, हयुत अगु हवसे।<verse eid="2CO 10:18"/></para>
  <chapter eid="2CO 10"/>
  <chapter number="11" style="c" sid="2CO 11"/>
  <para style="s">पोलुस ने लुच्‌चा नेवताळा</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 11:1"/>कदी तुहुं मारी थुड़ीक डेड़ अक्‌कल सेण कर लेता ती काय वारु रवतो; हव, मारी सेण बी कर लेवु। <verse eid="2CO 11:1"/><verse number="2" style="v" sid="2CO 11:2"/>काहाकी मे तुंद्‌रे बारामां भगवानेन धुन लागाड़ रवो हेरेसी की मे एक अदमी सी तुंद्‌री वात लागाड़लु छे, की तुहुं चुखली कुवारली पुरेन तसा मसी काजे सुप दम। <verse eid="2CO 11:2"/><verse number="3" style="v" sid="2CO 11:3"/>बाकुन मे बीहु की जसु घड़सु आपणी चालाकी सी हव्‌वा काजे बेहकाड़्‌यु, असात तुंद्‌रे मन मां सुदा ने चुखला पण सी जे मसीन साती हवणु चाहजे काय खत्‌तम नी हय जाय। <verse eid="2CO 11:3"/><verse number="4" style="v" sid="2CO 11:4"/>कदी कुय तुंद्‌रे धड़े आवीन, काहालाक दीसरा ईसुन परचार करे, जेरो परचार हामु नी कर्‌या नीते कुय अळी आत्‌मा तुहुंक जड़ी; जे पेहल नी जड़लो हतलो; नीते अळी कुय खुस-खबर सामळी तीनाक तुहुं पेहल नी मानतेला, ती तुहुं हीनाक सेण करनु वारु रवतो।<verse eid="2CO 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 11:5"/>मे ते समजो, की मे काहाली वात मां मटा सी मटा नेवताळा सी कम नी हय। <verse eid="2CO 11:5"/><verse number="6" style="v" sid="2CO 11:6"/>कदी तुहुंक असो लागे की मारे वाटे तींद्‌रेन तसों वारु बुलनेन हुसारी नी हय, तेबी अक्‌कल मां नी; बाकुन हामु हीनाक आखी वातेन तरा सी तुंद्‌रे वाटे देखाव पाड़ देय।<verse eid="2CO 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 11:7"/>काय हेरेमां मे काय पाप कर्‌यु; की मे तुहुंक भगवानेन खुस-खबर पयस्‌या लेय पाखुर सामळावो; ने आपणे आप काजे नेचु कर्‌यु, की तुहुं उचा हय जावु? <verse eid="2CO 11:7"/><verse number="8" style="v" sid="2CO 11:8"/>मे दीसरी मंडळी काजे लुट्‌यु मतलब मे हींद्‌री दाहड़की लेदु, काहाकी तुंद्‌री चाकरी करो। <verse eid="2CO 11:8"/><verse number="9" style="v" sid="2CO 11:9"/>ने जत्‌यार मे तुंद्‌रे साते हतलु, ने मेसे कमी हवी, ती मे काहाला पर बी भार नी नाख्‌यु, काहाकी भायसे, मकीदुनीया सी आवीन मारी कमी काजे पुरा कर्‌या; ने मे हरीक वात मां आपणे आप काजे तुंद्‌रे पर भार बन्‌ने सी रुक्‌यु, ने रुकीन रवीस। <verse eid="2CO 11:9"/><verse number="10" style="v" sid="2CO 11:10"/>कदी मसीन छाचाय मारे मां छे, ती अखाया नावेन देस मां कुय मेसे हीनी मटाय सी नी रुकसे। <verse eid="2CO 11:10"/><verse number="11" style="v" sid="2CO 11:11"/>असो काहा? काय असु करीन की मे तुंद्‌रे सी परम नी राखो? भगवान ज जाणे की मे परम राखो।<verse eid="2CO 11:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 11:12"/>बाकुन जो मे करो, चोन करतु रवीस; की जे माणसे दावु हेरे, हीनुक मे दावु नी जड़ने दम, काहाकी जीनी वात मां चे मटाय करजे हेरे मां जे हामरेन तसा ठेरे। <verse eid="2CO 11:12"/><verse number="13" style="v" sid="2CO 11:13"/>काहाकी असा माणसे लुच्‌चा नेवताळा छे, ने धुका सी काम करने वाळा छे, ने मसीन नेवताळान सीकु धरणे वाळा छे। <verse eid="2CO 11:13"/><verse number="14" style="v" sid="2CO 11:14"/>जी काय उसकारनेन वात नी काहाकी भुतड़ु आपसु बी बेसकु जबर वीजाळो सरग वाळा काहवाळ्‌यान सीकु धरे। <verse eid="2CO 11:14"/><verse number="15" style="v" sid="2CO 11:15"/>हेरेसी कदी हेरा पावर्‌या बी धरमेन चाकर्‌यान सीकु धरे, ती कुय मटी वात नी हय, बाकुन हींद्‌रो आकरी हींद्‌रे कामेन अनसारे हवसे।<verse eid="2CO 11:15"/></para>
  <para style="s">नेवताळान सीका मां पोलुसेन दुख भुकत्‌णु</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 11:16"/>मे अळी कवो, की मेसे डेड़-अकल्‌या नी समजे; नीते डेड़ अकल्‌यु समजीन मारी वात सेण कर लेवु, काहाकी थुड़ीक मे बी मटाय कर सको। <verse eid="2CO 11:16"/><verse number="17" style="v" sid="2CO 11:17"/>ईनी गांडान तसों मटाय मां जो काय मे कहो चो मालीकेन हुकुमेन अनसारे नी बाकुन मानु डेड़ अक्‌कल सी कवो। <verse eid="2CO 11:17"/><verse number="18" style="v" sid="2CO 11:18"/>जत्‌यार की बेसका माणसेन डीलेन अनसारे मटाय करजे, ती मे बी मटाय करीस। <verse eid="2CO 11:18"/><verse number="19" style="v" sid="2CO 11:19"/>तुहुं ते समजदार हयन खुसी सी डेड़-अकल्‌यान सेण कर लेवु। <verse eid="2CO 11:19"/><verse number="20" style="v" sid="2CO 11:20"/>काहाकी जत्‌यार तुहुंक कुय पावर्‌यु बणाय लेय, नीते खाय जाय, नीते फसाण देय, नीते आपणे आप काजे मट्‌लु बणावे। नीते तुंद्‌रे मुंहडा पर थापड़ देय, ती तुहुं सेण कर लेवु। <verse eid="2CO 11:20"/><verse number="21" style="v" sid="2CO 11:21"/>हामु तुंद्‌रे साते तींद्‌रेन तसा वेहवार नी कर्‌या ने, कमजुर बण्‌या करीन सरमायणु चाहजे काय? कदी नी।</para>
  <para style="p" vid="2CO 11:21">बाकुन चे माणसे ते मटाय करने मां हिम्‌मत कर र्‌या; हेरसी मे बी मटाय करने मां हिम्‌मत करो, भले मारी मटाय करने गांडाय लागे। <verse eid="2CO 11:21"/><verse number="22" style="v" sid="2CO 11:22"/>काय चे ईब्‌रानी छे? मे बी छे; काय चे ईस्‌रायली छे? मे बी छे काय चे अब्‌राहमेन खानदानी छे? मे बी छे। <verse eid="2CO 11:22"/><verse number="23" style="v" sid="2CO 11:23"/>काय चेत मसीन चाकर्‌यु छे? मे गांडान तसु कवे मे बी छे मे हींद्‌रे सी बड़ीन छे जादास मेहनत<note caller="+" style="f"><char style="fr" closed="false">11:23 </char><char style="fq" closed="false">मेहनत </char><char style="ft" closed="false">परिश्रम</char></note> करने मां; अळीन अळी जेल मां; सड़ापान मार खाणे मां; अळी-अळी मरतु बचणे मां। <verse eid="2CO 11:23"/><verse number="24" style="v" sid="2CO 11:24"/>पांच कावा मे यहुदीयान हात सी उंचालीस-उंचालीस सड़ापा खादु। <verse eid="2CO 11:24"/><verse number="25" style="v" sid="2CO 11:25"/>तीन कावा मेसे सुट्‌ये करीन देदा; एक कावा मेसे दगड़ाट्‌या<note caller="+" style="f"><char style="fr" closed="false">11:25 </char><char style="fq" closed="false">दगड़ाट्‌या </char><char style="ft" closed="false">पत्थराव</char></note>; तीन कावा ढंड्‌या तींद्‌रे पर मेसे चड़ावला हतला, टुटी गुयु; एक रात ने एक दाहड़ु मे समुदर मां काट्‌यु। <verse eid="2CO 11:25"/><verse number="26" style="v" sid="2CO 11:26"/>मे अळी-अळी चालने मां; नदीन खतरा मां; चुट्‌टान खतरा मां; आपणे जातीवाळान खतरा मां; नी-यहुदीयान खतरा मां; जंगलेन खतरा मां; समुदरेन खतरा मां; लुच्‌चा भायसेन ईचमां खतरा मां रवु; <verse eid="2CO 11:26"/><verse number="27" style="v" sid="2CO 11:27"/>मेहनत ने थकान मां; अळी-अळी जागतु रवणे मां; भुक-पीस मां; अळी-अळीन उपास करने मां; सेळा मां; उघाड़ु रहणे मां। <verse eid="2CO 11:27"/><verse number="28" style="v" sid="2CO 11:28"/>दीसरी वात काजे छुड़ीन जेरो नाप मे नी करतु आखी मंडळीन फीकुर दाहड़ीन मेसे दड़पे। <verse eid="2CO 11:28"/><verse number="29" style="v" sid="2CO 11:29"/>कुणीन लुल्‌गाय सी मे लुलु नी हवो, कुणीन पाप मां पड़ने सी मारु जीव नी दुखे।<verse eid="2CO 11:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="2CO 11:30"/>कदी मटाय करनु जरुड़ी छे, ती मे आपणी लुल्‌गायपन वात पर मटाय करो। <verse eid="2CO 11:30"/><verse number="31" style="v" sid="2CO 11:31"/>मालीक ईसुन भगवानेन ने बास जु जलम बेसको वारु छे, जाणो, की मे लुच्‌चाय नी मेलो। <verse eid="2CO 11:31"/><verse number="32" style="v" sid="2CO 11:32"/>दमीस्‌क मां अरीतास राजा भीणी सी जे हकदार्‌या हतला, हयु मेसे धरने करीन दमीस्‌क वाळा सहर पर राखवाळ्‌यु बठाड़ी रवला। <verse eid="2CO 11:32"/><verse number="33" style="v" sid="2CO 11:33"/>ने मेसे चारली मां बठाड़ीन खीड़की मां सी भीतड़ा पर सी उतार देदा, ने हेरे हात सी बची गुयु। <figure style="fig" alt="Entrance to the city gate and wall" file="hk00238c.tif" size="col" copy="Horace Knowles ©" ref="11:32">सहरेन झपला ने भीतड़ा भीणी जाय</figure><verse eid="2CO 11:33"/></para>
  <chapter eid="2CO 11"/>
  <chapter number="12" style="c" sid="2CO 12"/>
  <para style="s">पोलुसेन वारलु जागतो सपनो ने सातायली वात</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 12:1"/>तेबी मटाय करनु मारे वाटे वारु नी, तेबी करनु पड़े; बाकुन मे मालीकेन आपला सपना ने वीजाळान<note caller="+" style="f"><char style="fr" closed="false">12:1 </char><char style="fq" closed="false">वीजाळान </char><char style="ft" closed="false">प्रकशनों</char></note> वात वीच्‌यार करीस। <verse eid="2CO 12:1"/><verse number="2" style="v" sid="2CO 12:2"/>मे ईसु मसी मां एक माणुस काजे जाणो, चवदा साल हया की नी जाणे डील समोत नी जाणे डील पाखुर, भगवान जाणे, की असु माणुस तीसरा सरग लग उठाय गुयलु छे। <verse eid="2CO 12:2"/><verse number="3" style="v" sid="2CO 12:3"/>मे असा माणुस काजे जाणो जु नी जाणे डील समोत नी जाणे डील पाखुर, भगवानुत जाणे <verse eid="2CO 12:3"/><verse number="4" style="v" sid="2CO 12:4"/>की सरग लुक पर उठाय ली गुयु, ने असी वात सामळ्‌या जी कवणेन नी हय; ने जींद्‌रा मुंहडा पर लावणु माणुस काजे सय नी हय। <verse eid="2CO 12:4"/><verse number="5" style="v" sid="2CO 12:5"/>असा माणुस पर ते मे मटाय करीस, बाकुन आपणे पर आपणी लुल्‌गाय काजे छुड़ीन, आपणे बारामां मटाय नी करो। <verse eid="2CO 12:5"/><verse number="6" style="v" sid="2CO 12:6"/>काहाकी कदी मे मटाय करने चाहो बी ती डेड़ अकल्‌यु नी हवो, काहाकी छाचलीन कह्‌वो; ती बी हुबु हय जाम, असो नी हवे की असो नी हवे की असा कुय मेसे देखला छे, नीते मारे सी सामळे, मेसे हेरसी बड़ीन समजे।<verse eid="2CO 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 12:7"/>हेरेसी की मे वीजाळान अदती सी फुगी नी जाम, मारा डील मां काटु भाक गुयु मतलब भुतड़ान एक काहवाळ्‌यु की मारे घुधावे काहाकी मे फुगी नी जाम। <verse eid="2CO 12:7"/><verse number="8" style="v" sid="2CO 12:8"/>हेरे बारामां मे मालीक सी तीन कावा लीलघायु, की मारे सी गुयो छेटो हय जाय। <verse eid="2CO 12:8"/><verse number="9" style="v" sid="2CO 12:9"/>ने चु मार सी कह्‌यु, “मारा गीण-दया तारे वाटे बेसकी छे।” काहाकी मारी ताकत लुल्‌गाय मां पुरी हवे। हेरेसी मे मटी खुसी सी आपणी लुल्‌गाय पर मटाय करीस, की मसीन ताकत मारे पर साहळु करती रवे। <verse eid="2CO 12:9"/><verse number="10" style="v" sid="2CO 12:10"/>हेरे वजे सी मे मसी वाटे, ने लुलाय, मां ने कुहराय मां, ने गरीबी<note caller="+" style="f"><char style="fr" closed="false">12:10 </char><char style="fq" closed="false">गरीबी </char><char style="ft" closed="false">दरिद्रता</char></note> मां, ने झगड़ा मां, ने गरा मां, खुसी छे; काहाकी जत्‌यार मे लुलु हतलु, तेबी ताकत वाळु हवो।<verse eid="2CO 12:10"/></para>
  <para style="s">कुरींथी मां रवण्‌या वाळा वाटे फीकुर</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 12:11"/>मे डेड़ अकल्‌यु ते बण्‌यु, बाकुन तुहुंत मेसे गुयो करने वाटे लाचार कर्‌या। तुहुं ते मारी बड़ाय करनु चाहजे, काहाकी कदी मे काय बी नी, ती बी हींद्‌रे मां सी मटा सी मटा नेवताळा सी काहली बी वात मां कम नी हय। <verse eid="2CO 12:11"/><verse number="12" style="v" sid="2CO 12:12"/>नेवताळान आसार बी तुंद्‌रे ईचमां आखी भातीन सेण समोत सहलाणी, ने मटा-मटा काम असा कामेन ताकुतेन काम देखाड़ला छे। <verse eid="2CO 12:12"/><verse number="13" style="v" sid="2CO 12:13"/>तुहुं काहली वात मां दीसरी मंडळी मां सी थुड़ाक हतला, हींद्‌रे मां अतरोत की मे तुंद्‌रे पर आपणु भार नी नाखे जी मारे सी भुल हय गुय तीती कुहराय काजे मेसे माफ करु।<verse eid="2CO 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 12:14"/>देखु, मे तीसरी कावा तुंद्‌रे धड़े आवणे तीयार छे, ने मे तुंद्‌रु पर भार नी राखो; काहाकी मे तुंद्‌रो धन नी, बाकुन तुहुंत काजे चाहो। काहाकी पुर्‌या काजे आयस्‌या बास्‌या वाटे धन भेळो नी करनु चाहजे, बाकुन आयस्‌या बास्‌या काजे पुर्‌या वाटे धन भेळो करनु चाहजे। <verse eid="2CO 12:14"/><verse number="15" style="v" sid="2CO 12:15"/>मे तुंद्‌री आत्‌मा वाटे बेसकी खुसी सी खरचु हय जायस, बाकुन आपसात बी खरचु हय जासे काय जतरा बड़ीन मे तुंद्‌रे सी परम राखो, अतरा कम हयन तुंद्‌रे सी परम राखसु? <verse eid="2CO 12:15"/><verse number="16" style="v" sid="2CO 12:16"/>असा हय सके, की मे तुंद्‌रे पर बुज नी नाखो, बाकुन चतराय सी तुहुंक धुकु दीन फसाड़ लेदु। <verse eid="2CO 12:16"/><verse number="17" style="v" sid="2CO 12:17"/>बाकुन, जीनुक मे तुंद्‌रे धड़े मकल्‌यु, काय हींद्‌रे मां सी काहालाकेन साहरे मे जुर करीन तुंद्‌रे सी काय ली देदा? <verse eid="2CO 12:17"/><verse number="18" style="v" sid="2CO 12:18"/>मे तीतुस काजे लीलघाय्‌न ने समजाड़ीन हेरे साते हीना भाय काजे मकल्‌या, ती काय तीतुस जुर करीन तुंद्‌रे सी काय लेदु? काय हामु एक आत्‌मान चाल मां नी चालजे? काय एकुत वाट पर नी चालजे? <verse eid="2CO 12:18"/><verse number="19" style="v" sid="2CO 12:19"/>तुहुं हय लग समजी र्‌या हसे की हामु तुंद्‌रे अगळ जपाप दी रया, हामु ते भगवान काजे आय रवलु जाणीन ईसु मसी मां बुलजे, ने ए लाटेक्‌ला, आखी वात तुंद्‌रे वाटे अदुस हवणे करीन कवजे। <verse eid="2CO 12:19"/><verse number="20" style="v" sid="2CO 12:20"/>काहाकी मेसे धाक छे, काय असो नी हवे, की मे आवीन जसु चाहो, असु तुहुंक नी जड़ो; ने मेसे बी जसा नी चाहजे असात जड़ो, ने तुहुं तुंद्‌रे मां झगड़ा हय र्‌या, जळन कर र्‌या, रीसवाय र्‌या, आपसान ने भलो हवणेन वीच्‌यार कर्‌या, दीसरान वाक नीकाळ र्‌या, चुगली कर र्‌या, मटाय कर र्‌या, ने बीरजु पाड़ी र्‌या। <verse eid="2CO 12:20"/><verse number="21" style="v" sid="2CO 12:21"/>ने कांखुर मायन असो नी हवे की जत्‌यार मे पछु आवीस, ने मारु भगवान मारी नाव-बद्‌दी करे ने मेसे बेसका वाटे अळी दुख करनु पड़े, जे पेहल पाप करला हतला, ने भुंड्‌ला काम, ने छीनाळो, ने लुच्‌चाय सी, जो चे कर्‌या, मन नी फीराया।<verse eid="2CO 12:21"/></para>
  <chapter eid="2CO 12"/>
  <chapter number="13" style="c" sid="2CO 13"/>
  <para style="s">आकरी चेतावणी ने आव-भाव</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 13:1"/>हय तीसरी कावा मे तुंद्‌रे धड़े आवो, “दुय नीते तीन गवान मुंहडा सी हरीक एक वात ठेहरावसे।” <verse eid="2CO 13:1"/><verse number="2" style="v" sid="2CO 13:2"/>जसु मे जत्‌यार दीसरी कावा तुंद्‌रे साते हतलु, असुत हय छेटा रवते जाय हीनु माणसे सी जे पेहल पाप कर्‌या, ने दीसरा आखा माणसे सी हय पेहल सी कय दम, की कदी मे अळी आवीस, ती नी छुड़ो, <verse eid="2CO 13:2"/><verse number="3" style="v" sid="2CO 13:3"/>काहाकी तुहुं ते हेरो सबुत चाहु, की मसी मारे मां बुले, जे तुंद्‌रे वाटे लुला नी; बाकुन तुंद्‌रे मां ताकत छे। <verse eid="2CO 13:3"/><verse number="4" style="v" sid="2CO 13:4"/>चु लुलान वजे कुरुस पर चड़ाय ते गुयु, तेबी भगवानेन ताकत सी जीवतेलु छे, हामु बी हेरेमां लुलु छे; बाकुन भगवानेन ताकत सी जे तुंद्‌रे वाटे छे, हेरे साते।<verse eid="2CO 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 13:5"/>आपणे आप काजे पारखु, की भुरसा मां छे की नी; आपणे आप काजे पारखु, काय तुहुं आपणे बारामां ज्‌य नी जाणे, की ईसु मसी तुंद्‌रे मां छे। नीते तुहुं पारख मां पापी नीकळे। <verse eid="2CO 13:5"/><verse number="6" style="v" sid="2CO 13:6"/>बाकुन मारी आस छे, की तुहुं जाणी लेसु, की हामु पापी नी हय। <verse eid="2CO 13:6"/><verse number="7" style="v" sid="2CO 13:7"/>हामु आपणा भगवान सी जी दुवा करजे, की तुहुं काय बी कुहराय नी करु; हेरेसी नी, की हामु खरला देखाव पड़े, बाकुन हेरेसी की तुहुं भलाय करु, चाहे हामु पापी रवजे। <verse eid="2CO 13:7"/><verse number="8" style="v" sid="2CO 13:8"/>काहाकी हामु छाचाय्‌न वीरुद मां काय बी नी कर सकजे, बाकुन सय वाटे कर सकजे। <verse eid="2CO 13:8"/><verse number="9" style="v" sid="2CO 13:9"/>जत्‌यार हामु लुला छे, ने तुहुं जुर वाळा<note caller="+" style="f"><char style="fr" closed="false">13:9 </char><char style="fq" closed="false">जुर वाळा </char><char style="ft" closed="false">बलवन्त</char></note> छे, ती हामु खुसी हवजे, ने जी दुवा बी करजे, की तुहुं सय हय जावु। <verse eid="2CO 13:9"/><verse number="10" style="v" sid="2CO 13:10"/>एरे वजे सी मे तुंद्‌रे आसा पछळ जी वात लिखो, की तुंद्‌रे अगळ उबु हयन मेसे हीना हकेन अनसारे तीनाक मालीक बीगाड़ने वाटे नी बाकुन बणावणे वाटे मेसे आपलु छे, काठा एहवार सी मेसे काय करनु नी पड़े।<verse eid="2CO 13:10"/></para>
  <para style="s">आव-भाव</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 13:11"/>अळतेन ए भायसे, खुसी मां रवु; सय बणी जावु; हिम्‌मत राखु; एकुत मन रवु; मेळीन रवु, ने परम ने सांतीन दातान भगवान तुंद्‌रे साते रवसे।<verse eid="2CO 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 13:12"/>एक दीसरा काजे चुखला गुळु<note caller="+" style="f"><char style="fr" closed="false">13:12 </char><char style="fq" closed="false">गुळु </char><char style="ft" closed="false">चुम्बन</char></note> दीन आवजु ने आवीस कवो।<verse eid="2CO 13:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 13:13"/>मालीक ईसु मसीन दया, ने भगवानेन परम आखा चुखली-आत्‌मान साजेदारी बणीन रवे। <verse eid="2CO 13:13"/><verse number="14" style="v" sid="2CO 13:14"/>मालीक ईसु मसीन गीण-दया ने भगवानेन परम ने चुखली-आत्‌मान साजी तुहुं आखा साते हवती रवे।<verse eid="2CO 13:14"/></para>
  <chapter eid="2CO 13"/>
</usx>
