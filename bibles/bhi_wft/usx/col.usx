<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="COL" style="id">- Bhilali Standard Project</book>
  <para style="h">कुलुसी</para>
  <para style="toc3">कुलुसी</para>
  <para style="toc2">कुलुसी</para>
  <para style="toc1">कुलुसीन मंडळी वाटे पोलुसेन चिट्‌ठी</para>
  <para style="mt2">कुलुस्सियों की कलिसीया के लिए पौलुस की पत्री</para>
  <para style="mt1">कुलुसीन मंडळी वाटे पोलुसेन चिट्‌ठी</para>
  <para style="imt">कुलुसीन बारामां</para>
  <para style="ip">कुलुसीन कितापेन चिट्‌ठी नेवतावाळु पोलुस साहरे लिखलु। <char style="xt"><ref loc="COL 1:1">1:1</ref></char> जत्‌यार चु जेल मां हतलु नक्‌खी छे रोमी मां मसीन पयदा हवणेन धड़े-वड़े सांठ सालेन पछे हीयु जी चिट्‌ठी लिखलु। कुलुसी साते ईफीसी ने फीलेमोन काजे जेलेन चिट्‌ठी कवाय जाय काहाकी पोलुस हीनी चिट्‌ठीया काजे जेल मां हतलु ती लिखलु हीयु जी चिट्‌ठी कुलुसी सहर मां रवीन मंडळी काजे लिखलु पोलुस कुलुसी मां मंडळी काजे सुरु नी कर्‌यु जसा हीये बताड़लो छे। <char style="xt"><ref loc="COL 2:1">2:1</ref></char> बाकुन हेरे वाटे थुड़ीक जपापदारी मान्‌यु हसे। ज नक्‌खी छे की एफरास मंडळी काजे बणावलु हसे काहाकी चु कुलुसी मां हतलु।</para>
  <para style="ip">पोलुस कुलुसीन मंडळी मां थुड़ीक गलत सीकापणेन फीकुर मां हतलु चे हेरे बारामां चिट्‌ठी लिखणे मां बेसकी मेहनत कर्‌या हसे हय सके की यहुदी भुरसु करन्‌यान एक टुळु हतलु हसे जे दीसरा भुरसु करन्‌या काजे जुन्‌ला नेम सी यहुदी कानुनेन पाळनी करने वाटे जबर जस्‌ती करनेन कुसीस कर्‌या हसे। खास करीन फतरी काटाड़ने वाटे। पोलुस खास रुप सी लिखे की भुरसु करन्‌या काजे मसी काजे अळी काहलाकेन बी जरुवत नी हय काहाकी चु भगवानेन साहरे हुकारलु छे। <char style="xt"><ref loc="COL 1:15-20">1:15-20</ref></char> ने माणसेन सुचेन आधार पर जी सीकापण बेकार छे। <char style="xt"><ref loc="COL 2:8">2:8</ref></char></para>
  <para style="iot">बाहरती वात</para>
  <para style="io1">1. पोलुस कुलुसी कितापेन मंडळी काजे वारु चे की करीन चिट्‌ठीन सुरुवात करे। <char style="ior"><ref loc="COL 1:1-2">1:1-2</ref> </char></para>
  <para style="io1">2. अळतेन चु मसीन मटा-मटा कामेन बारामां लिखे खास रुप सी झुठी सीकापणेन जपाप मां। <char style="ior"><ref loc="COL 1:3-3:4">1:3—3:4</ref> </char></para>
  <para style="io1">3. पोलुसेन बेसका चिट्‌ठीया मां चु चिट्‌ठीन आदा भाग मां बताड़े जु वारलु भुरसु करीन जीवे तींद्‌रे वाटे खास सीकापण बताड़े। <char style="ior"><ref loc="COL 3:5-4:6">3:5—4:6</ref> </char></para>
  <para style="io1">4. चिट्‌ठी काजे दीसरी मंडळीन काजे जुर सी भन्‌ने वाटे ने वारु सीकापणेन साते सार देय। <char style="ior"><ref loc="COL 4:7-18">4:7-18</ref> </char></para>
  <chapter number="1" style="c" sid="COL 1"/>
  <para style="p">
    <verse number="1" style="v" sid="COL 1:1"/>मे पोलुस भगवानेन मरजीन अनसारे ईसु मसीन नेवताळु छे। जी चिट्‌ठी मे पोलुस ने तीमुथीयुस लिखला छे; ने जु तीमुथीयुस ईसु पर भुरसु करनेन साहरे आपणु भाय छे,<verse eid="COL 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="COL 1:2"/>जी चिट्‌ठी कुलुस्‌या सहर मां रहण्‌या, भगवानेन चुखला माणसे वाटे लिखली छे, जे ईसु मसी पर भुरसु करे।</para>
  <para style="p" vid="COL 1:2">आपणा भगवान बास भीणी सी तुहुं काजे गीण-दया<note caller="+" style="f"><char style="fr" closed="false">1:2 </char><char style="fq" closed="false">गीण-दया </char><char style="ft" closed="false">काहनाक काजे दया देखाड़नेन काम</char></note> ने सुक-सांती जड़ती रहणु चाहजे।<verse eid="COL 1:2"/></para>
  <para style="s">पोलुस कुलुसी सहरेन ईसुन-मंडळी वाटे भगवान काजे बेसकु वारु कह्‌वे</para>
  <para style="p">
    <verse number="3" style="v" sid="COL 1:3"/>हामु तुंद्‌रे वाटे भगवान धड़े दुवा करजे ती, आपणा मालीक ईसु मसीन बास भगवान काजे बेसकु वारु कह्‌या करजे। <verse eid="COL 1:3"/><verse number="4" style="v" sid="COL 1:4"/>काहाकी ईसु मसी पर तुंद्‌रा भुरसान बारामां ने भगवानेन आखा चुखला माणसे पर तुंद्‌रा परमेन बारामां हामु सामळी रया। <verse eid="COL 1:4"/><verse number="5" style="v" sid="COL 1:5"/>जत्‌यार तुहुं खुस-खबरेन खरला बुल सामळ्‌या ती सीत भगवानेन बरकतेन बारामां बी, सामळता आय रया, तीनी बरकत काजे भगवान तुहुंक आपणे करीन सरगेम जापताये मेल रयु। ईनी वातेन तुहुं पाक्‌की आस कर रया; हेरेसी तुंद्‌रु भुरसु ने परम नाव साद्‌यु हय रयु। <verse eid="COL 1:5"/><verse number="6" style="v" sid="COL 1:6"/>जी खुस-खबर आखी कळी मां पुगती जाय, ने हेरे साहरे माणसेन जीवाय बदलीन फळ लावती जाय, ने अदतीत जाय; ने तीने दाहड़े तुहुं ईनी खुस-खबर काजे सामळ्‌या, ने भगवानेन गीण-दया काजे छाचलीन उळख्‌या, ती सीत खुस-खबर तुंद्‌रे मां बी तसीत काम करती जाय। <verse eid="COL 1:6"/><verse number="7" style="v" sid="COL 1:7"/>ईसुन खुस-खबरेन सीकापण तुहुं काजे हामरा लाटेक्‌ला भाय ईपर्‌फास धड़े सी जड़ली छे, जु हामरु साती गुलाम पावर्‌यु हतलु, ने हामरे धड़े सी ईसु मसीन ईमानदार पावर्‌यु बणीन आय रयु। <verse eid="COL 1:7"/><verse number="8" style="v" sid="COL 1:8"/>जु ईपरास्‌यु हामुक तुंद्‌रा परमेन बारामां खबर कर्‌यु, जु परम भगवानेन जीव-आत्‌मा तुहुं काजे दीसराक परम करने करीन आपलु छे।<verse eid="COL 1:8"/></para>
  <para style="s">पोलुस कुलुसी सहरेन ईसुन मंडळी वाटे भगवान धड़े दुवा करे</para>
  <para style="p">
    <verse number="9" style="v" sid="COL 1:9"/>हेरेसी तीने दाहड़े सी हामु ज सामळ्‌या, हामु बी तुंद्‌रे वाटे भगवान धड़े लीलघाय्‌न असी दुवा करनु नी छुड़्‌या; एरेन करीन की तुहुं आखा चुखली-आत्‌मान अकलेन ने समजेन साहरे तुंद्‌रे वाटे भगवानेन मरजी काजे पुरा-पुरा जाण लेवु। <verse eid="COL 1:9"/><verse number="10" style="v" sid="COL 1:10"/>काहाकी तुंद्‌रु वेहवार मालीक ईसु काजे गमे असु रहणु चाहजे, तेरे सी मालीक ईसु आखे भात्‌ये खुस हये, ने तुहुं आखा भला कामे करता रहु, ने भगवानेन उळखाण मां बड़ता जावु। <verse eid="COL 1:10"/><verse number="11" style="v" sid="COL 1:11"/>ने तुहुं भगवानेन सेक-सींगारेन ताकतेन अनसारे आखी भातीन ताकत सी ताकतवाळा हवता जावु, जां लग की खुसी भेळ आखी वातेम गम खाता जाय्‌न सेण कर सकु। <verse eid="COL 1:11"/><verse number="12" style="v" sid="COL 1:12"/>ने भगवान बास काजे बेसकु वारु कवता रहु, ने भगवान बास आपसा नेवाड़ला चुखला माणसेक तीना वीजाळा राज मां आटु आपणे करीन मेल रयु। ने चु तीना आटान साजल्‌यु बणने करीन तुहुंक बी हक आप देदलु छे। <verse eid="COL 1:12"/><verse number="13" style="v" sid="COL 1:13"/>जु भगवान आपणुक भुतड़ान आंदारला राज मां सी छुड़ायन आपसा लाटेक्‌ला पुर्‌यान राज मां ली आवलु छे। <verse eid="COL 1:13"/><verse number="14" style="v" sid="COL 1:14"/>ने ईना पुर्‌यान साहरे आपणुक आपणा पापेन माफी जड़ली छे, आपणुक छुटकारु जड़लु छे।<verse eid="COL 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="COL 1:15"/>जु ईसु मसी बीन देख्‌या भगवानेन खरलु सीकु छे, हय जु ईसु कळ घड़ायणेन पेहलेन हतलु, ने आखा घड़ायण्‌यान मालीक छे। <verse eid="COL 1:15"/><verse number="16" style="v" sid="COL 1:16"/>काहाकी तेरेत साहरे भगवान आखी चीजेक घड़्‌यु। सरगे वाळी चीज बी, धरती पर छे ची चीज बी देखणी चीज बी, ने, बीन देखणी चीज बी, ने राजगादी, राजान हक बी, सरगे वाळा खबर लावण्‌यान हक बी, राज करन्‌यान हक बी, ने पुडार्‌यान हक बी ज आखो तेरेत साहरे ने तेरेत वाटे घड़ायलो छे। <verse eid="COL 1:16"/><verse number="17" style="v" sid="COL 1:17"/>ने जुत ईसु आखी चीजेक घड़ायणेन पेहलेन हतलु, ने आखी चीज तेरेत साहरे टेकीन चाल रय। <verse eid="COL 1:17"/><verse number="18" style="v" sid="COL 1:18"/>ने जु ईसु आपसा डीलेन मतलब आपसी मंडळीन मुणको छे, ज सुरु बी छे हव जुत मर्‌या-सर्‌याम<note caller="+" style="f"><char style="fr" closed="false">1:18 </char><char style="fq" closed="false">मर्‌या-सर्‌याम </char><char style="ft" closed="false">काहना बी माणसेन जीवन सर जाणु</char></note> सी जीवता हय्‌न बठा हवण्‌या मायन पेहलु छे; हेरेसी जुत आखी वातेन मुख्‌यु छे। <verse eid="COL 1:18"/><verse number="19" style="v" sid="COL 1:19"/>काहाकी भगवान बास आपसा आखा गुण भेळ ईसु मसीत मां पुरु-पुरु वसणेन नक्‌खी कर्‌यु। <verse eid="COL 1:19"/><verse number="20" style="v" sid="COL 1:20"/>ने ईसुन जो लुही कुरुस पर उह्‌यो, तीना खुनेन साहरे मेळ करीन, आखी चीजेक ईसुन साहरे आपसा साते मेळ कर ले, भले ची चीज धरती परुन हय चाहे सरगे परुन हय। आपसा साते मेळ कर लेय।<verse eid="COL 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="COL 1:21"/>पेहले तुहुं आपसा कुहराय्‌न कामेन, ने वीच्‌यारेन साहरे भगवान सी छेटा हतला, ने तेरा वेरी हतला। <verse eid="COL 1:21"/><verse number="22" style="v" sid="COL 1:22"/>बाकुन भगवान तुहुं काजे चुखला ने नी-गुनाळा, हव चुखोझण बणायन आपसा अगळ हजुर करने करीन नक्‌खी कर्‌यु तेरेत अनसारे ईसु मसी ईनी कळीम माणुस बणीन आयु, ने आपसा डीलेन मोत झेल्‌यु ने ईनात ईसुन साहरे हय भगवान तुहुं काजे आपसा साते मेळ कर लेदु छे। <verse eid="COL 1:22"/><verse number="23" style="v" sid="COL 1:23"/>ईसुन खुस-खबरेन परचार सरगेन नेचो आखी धरती पर हय रयो। जी खुस-खबर सामळीन तुहुं ईसु पर भुरसु कर्‌या। तेरे सी तुहुं खुस-खबरेन आस काजे घुण छुड़ु, बाकुन भुरसान पाया पर टेक्‌ला रवजु। असा करसु ती तुहुं भगवान अगळ चुखो झण हजुर हवसु। ईनी खुस-खबरेन बमदीन परचार करने करीन मे पोलुस तेरु पावर्‌यु बन्‌लु छे।<verse eid="COL 1:23"/></para>
  <para style="s">ईसुन मंडळी वाटे पोलुसेन काम</para>
  <para style="p">
    <verse number="24" style="v" sid="COL 1:24"/>जे दुख मां हय तुंद्‌रे वाटे झेल रयु, तीनु दुखेन साहरे मे ते खुस छे। आपसा डीलेन मतलब आपसी मंडळी वाटे बेसकी वेला कर्‌यु; आपणुक बी तेरी आवजी पर तेरेन तसा दुख झेलीन तेरा दुखेन साजल्‌या बणनु छे। अतरे मे ते ईनी वातेन अनसारे ईसुन आवजी पर तीनु दुखेन कसर मारा डील मां दुख झेलीन पुरी करने बाजी रयु। <verse eid="COL 1:24"/><verse number="25" style="v" sid="COL 1:25"/>भगवान मेसेक आपसी मंडळीन पावर्‌यु बणावलु छे, ने आपसा बुल तुहुं नी-यहुदी माणसे वाटे पुरो-पुरो उजेंतो करनेन काम मारा मुणका पर मेल देदलु छे। <verse eid="COL 1:25"/><verse number="26" style="v" sid="COL 1:26"/>भगवानेन खुस-खबरेन जी सातायली युजना बेसकी टेमे ने, बेसकी पीड़ी लग सातायली रय, बाकुन हय तेरा चुखला माणसे पर उजेंती हय गुय। <verse eid="COL 1:26"/><verse number="27" style="v" sid="COL 1:27"/>ने भगवानेन हय आपसी सातायली युजना काजे बेसकी वारु रीते उजेंतु करलु छे, की आपणु जे तेरा नेवाड़ला चुखला माणसे छे, ईनी युजनान सेक-सींगार देखीन चकरायजे खास करीन, तुंद्‌रे तसा नी-यहुदी आड़जात्‌या माणसे मां ईसु मसी बसलु छे, ने आपसी जीव-आत्‌मान साहरे घणो वारु काम करने बाजी रयु भगवानेन जी युजना बेसकी सेकवाळी ने कामकी छे, ज देखीन आपणु चकराय जाजे। जी वात तीनी आवणे वाळी आपणी आसान संय बी छे की एक दाहड़ु आपणु आखा ईसु मसी पुठ्‌ये सेक-सींगार भर्‌या सरगेम रवसु। <verse eid="COL 1:27"/><verse number="28" style="v" sid="COL 1:28"/>तेरु खुस-खबर अतरे एक-एक माणसे काजे ईसु मसी मां पाक्‌का करीन भगवान अगळ हजुर करने करीन, हामु आखी अक्‌कल भेळा आखा माणसेक चेतावता जाय्‌न ने सीकाड़ता जाय्‌न, ईना ईसु मसीन परचार करजे। <verse eid="COL 1:28"/><verse number="29" style="v" sid="COL 1:29"/>हेरेन करीन मे ईसुन ताकुतेन साहरे जुरभर्‌यु हय्‌न आखो डील ने मन लगाड़ीन सीकाड़ने बाजी रयु।<verse eid="COL 1:29"/></para>
  <chapter eid="COL 1"/>
  <chapter number="2" style="c" sid="COL 2"/>
  <para style="p">
    <verse number="1" style="v" sid="COL 2:1"/>तुहुंक ज समजणु चाहजे की मे तुंद्‌रे वाटे ने लोदीकीया सहर वाळी ईसुन मंडळी वाटे ने तीनु दीसरा आखा वाटे बी जे मेसेक हय लग नी देख्‌या, मे बेसकी काठी मेहनत करने बाजी रयु। <verse eid="COL 2:1"/><verse number="2" style="v" sid="COL 2:2"/>मे एरेन करीन बेसकु काठो काम करने बाजी रयु, की तुहुं आखा परम मां एक मन्‌या हय जावु, ने भगवानेन सातायली युजनान मतलब ईसु मसीन बारामां पुरी-पुरी अक्‌कल ने समज मां एक मन्‌या हय्‌न हिम्‌मत वाळा बण जावु। <verse eid="COL 2:2"/><verse number="3" style="v" sid="COL 2:3"/>काहाकी ईना ईसु मसी मां आखी अकलेन ने समजेन खजानो सातायलो छे।<verse eid="COL 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="COL 2:4"/>ज मे हेरेसी कहो की, काहनुक माणुस तुहुं काजे कदरे-कदरे पटाड़ीन धुकु नी देणु चाहजे। <verse eid="COL 2:4"/><verse number="5" style="v" sid="COL 2:5"/>भले मे तुंद्‌रे सी छेटे छे, तेबी मे मारा मनोम तुहुंक हेर कर्‌या करो, करीन मे तुहुंक हेर करो, ने हय तुहुं ईसु मसी पर भुरसु करीन टेक्‌ला रय रया ने एक जसा नवली जीवाय्‌न पाळनी पाळ रया; ज जाणीन मे बी बेसकु खुस छे।<verse eid="COL 2:5"/></para>
  <para style="s">मसी ईसु मां जीवनेन भरपुरी</para>
  <para style="p">
    <verse number="6" style="v" sid="COL 2:6"/>जसा तुहुं ईसु काजे आपसु छुड़ावणे वाळु मसी ने मालीक मानीन भुरसु कर लेदला छे, तसात भुरसु करता जाय्‌न तेरीत कह्‌याम चालता रहु। <verse eid="COL 2:6"/><verse number="7" style="v" sid="COL 2:7"/>ने तेरेत मां जड़्‌या उंडा करता जावु, ने तेरेत मां वदता जावु; ने जसों तुहुंक सीकाड़लो छे, तसात भुरसा मां पाक्‌का हवता जावु, ने भगवान काजे अळी-अळीन बेसकु वारु कवता रहु।<verse eid="COL 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="COL 2:8"/>कांखुर मायन काहनुक जाणी बुजीन कहवायण्‌यु ईनी कळीम वाळी अकलेन साहरे, ने फालतु ने पारकी वातेन अनसारे धुकु दीन तुहुंक पटाड़ी नी लेय। तेरेसी तुहुं चेतीन रहु; काहाकी जी वात ईसु मसीन अनसारे नी हय, बाकुन आड़ा-बुड़ान रीकामी रीती-भाती छे, तेरे पछळ कळ घड़ायणेन भक्‌तीन बारामां भुतड़ान जमेन साहरे बणावला मनघड़्‌या छे। <verse eid="COL 2:8"/><verse number="9" style="v" sid="COL 2:9"/>काहाकी ईसु मसी मां भगवानेन आखा गुण पुरा-पुरा वसला छे, ने आपणु तेरो डील मतलब तेरी मंडळी छे, ने आपणु तेरी सीकापणेन साहरे, तेरे साते जुड़ायला रहणेन साहरे पुरा-पुरा पाक्‌का हय गुयला छे। अतरे आपणुक काहनी बी वातेन कसर नी हय। <verse eid="COL 2:9"/><verse number="10" style="v" sid="COL 2:10"/>आपणु ईसु, ते कळी भीणी आखा राज करन्‌या पर, ने हकदार्‌या पर राज करन्‌यु मालीक छे।<verse eid="COL 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="COL 2:11"/>ईसु मसी मां तुंद्‌री फतरी बी काटायली छे! मे माणसेन हात करीन पेहरवोटन अगली फतरी काटाड़नेन वातेन बारामां नी कहतु! ईसु मसीत भगवानेन मटा कामेन ताकुतेन साहरे, तुंद्‌री फतरी मतलब तुंद्‌री पाप करने वाळी डीलेन हेर काजे डीलेम सी उतारीन नाख देदलु, ने तुंद्‌रा पापेन जुन्‌ली जीवाय मर गुयली। <verse eid="COL 2:11"/><verse number="12" style="v" sid="COL 2:12"/>तुहुं ईसु पर भुरसु करीन बपतीस्‌मान रीत लेदला छे, ने बपतीस्‌मा ईनी वातेन सहलाणी छे, छाचलीन तुंद्‌रा पापेन जुन्‌ली जीवाय ईसु पुठ्‌ये बपतीस्‌मा मां गाड़ाय गुय ने ईसु काजे मर्‌या-सर्‌याम सी जीवता करनेन भगवानेन ताकत पर भुरसु करनेन साहरे, तुहुं ईसु मसी पुठ्‌ये पछा जीवता हय्‌न बठा हय गुयला छे। <verse eid="COL 2:12"/><verse number="13" style="v" sid="COL 2:13"/>तुहुं पेहले तुंद्‌रा पाप मां मरला हतला, ने तुहुंक तुंद्‌री पाप करन्‌यान डीलेन हेर डीलेम सी उतारीन नी नाखायी। हय भगवान तुहुं काजे बी तीना ईसु पुठ्‌ये मर्‌या-सर्‌याम सी जीवतु कर देदु। <verse eid="COL 2:13"/><verse number="14" style="v" sid="COL 2:14"/>ने आपणु आखा नेम तुड़ीन बेसका गुना करला हतला, चे करजान तसा हतला। आपणा गुना गुनान करजान किताप मां लिखला हतला। जी किताप आपणे वीरुद मां हय्‌न आपणी वात काटतेलु, बाकुन तीनु आखा पापेन साहरे भगवान आपणुक माफी आप देदु; खरीन चु आपणु आपणा करजान किताप काजे ईसु पुठ्‌ये कुरुस पर खीळा ठुकीन खत्‌तम कर देदु। <verse eid="COL 2:14"/><verse number="15" style="v" sid="COL 2:15"/>असा करीन भगवान आपणा जीव-आत्‌मा पर हक जमाड़ीन राज करन्‌या भुतड़ा काजे जीत लेदु, ने तीनुक आखा अगळ गुलाम पावर्‌यान तसा पछळ-पछळ चालाड़्‌यु। कांखुर मायन काहनुक धुकु दीन तुहुंक पटाड़ी नी लेय, तेरेसी चेतीन रहु।<verse eid="COL 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="COL 2:16"/>हेरेसी खाणे-पीणेन चीजेन पाळनीन बारामां नीते तीहवारेन पाळनीन बारामां भले ची पाळनी नवला चांदेन तीहवारेन बारामां हय नीते आरामेन दाहड़ान पाळनीन बारामां हय, काहनुक तुहुंक पुछे की तुहुं ज काहा नी पाळता ती तुहुं तींद्‌री घुण सामळु। <verse eid="COL 2:16"/><verse number="17" style="v" sid="COL 2:17"/>काहाकी जी आखी पाळनी ते आवणे वाळा ईना ईसु मसीन सहलाणी अतरीत हतली, बाकुन ज ईसु मसीत खरलु छे। <verse eid="COL 2:17"/><verse number="18" style="v" sid="COL 2:18"/>हव जु काहनुक माणुस ते आपसा मनेम भुंडला वीच्‌यारे मां, देखली चीजे पर फालतु मटाय करतु रहे। अतरे कदी चु तुहुंक सरग वाळा खबर लावण्‌यान पुजा कराड़ने हींडे, नी ते आपसाक जबरान वेला पाड़नेन वातेक मानाड़ने हींडे, ती तेरे वाये घुण लागु। तुहुं तेरे वाये लागसु ती तुंद्‌रा सरग वाळान ईनाम खुय देसु। <verse eid="COL 2:18"/><verse number="19" style="v" sid="COL 2:19"/>जु ईसु मसीत आपणो मुणको छे, ईना साते तेरो डील मतलब हेरी जुड़ायली छे ईनात साहरे आखो डील हाटकान साहरे जुड़ायन ने मास सी ने नस सी पुसाये, ने भगवानेन मरजीन अनसारे वदतो जाय। कदी कानुक मुणका साते जुड़ायलु नी हय, ने चु कहणे बाजी जाय की। मे ते सरगेन बारामां बेसका जागता सपना देखलु छे। ती तीना सी चेतीन रहु।<verse eid="COL 2:19"/></para>
  <para style="s">माणसेन सीकापण ने तींद्‌रा बणावला नेम पर मां चालु</para>
  <para style="p">
    <verse number="20" style="v" sid="COL 2:20"/>तुंद्‌री जुन्‌ली जीवाय ते ईसु मसी भेळीत मर गुयली छे, ती तुहुं ईनी कळीन माणसेन तसा काहा जी रया? असो लागे की तुहुं ईनी पापी कळीन छे, ने ईनी कळीन पाळनी पाळ रया। <verse eid="COL 2:20"/><verse number="21" style="v" sid="COL 2:21"/>ईनी कळीन पाळनी असी छे; ज घुण धरु पलो घुण खावु, ने ईनी चीजेक हात घुण लागाड़ु। <verse eid="COL 2:21"/><verse number="22" style="v" sid="COL 2:22"/>कळीन जी आखी चीज काम लावते-लावते कळीत मां सर जासे। ती ईनी कळीन माणसेन वाये लागीन तींद्‌रे साहरे बणावली पाळनी ने रीती भाती काहा पाळु। <verse eid="COL 2:22"/><verse number="23" style="v" sid="COL 2:23"/>दीसरा माणसेक जी पाळनी अक्‌कल वाळी ने बेसकी भक्‌ती वाळी लागे; काहाकी ईनी पाळनी मां बेसकी भक्‌तीन रीती छे; ने आपसा डीलेक जबरान वेला पाड़नेन रीती छे, ने आपसी जीवाय्‌न हेर काजे जबरान रुकणेन रीती छे। बाकुन छाचली मां डीलेन ईनी पापी हेर काजे रुकणे मां ईनी रीती सी काय फायदु नी हये।<verse eid="COL 2:23"/></para>
  <chapter eid="COL 2"/>
  <chapter number="3" style="c" sid="COL 3"/>
  <para style="p">
    <verse number="1" style="v" sid="COL 3:1"/>तुहुं ईसु मसी भेळा जीवता हवला छे, जु हय सरगे मां भगवानेन जेवड़्‌ये आंगे बठी र्‌यु ने चां वाळी उपरवाळी वात, हेर करीन हेरता रहु। <verse eid="COL 3:1"/><verse number="2" style="v" sid="COL 3:2"/>तुहुं धरती पर वाळी वात पर मन घुण लागाड़ु बाकुन भगवानेन्‌चां वाळी उपरनी वात पर मन लागाड़ु। <verse eid="COL 3:2"/><verse number="3" style="v" sid="COL 3:3"/>तुंद्‌री जुन्‌ली जीवाय ते मरीन सर गुयली छे, ने तुंद्‌री नवली जीवाय ईसु मसी पुठ्‌ये भगवान मालीक मां सातायली छे। <verse eid="COL 3:3"/><verse number="4" style="v" sid="COL 3:4"/>जत्‌यार ईसु मसी जु हामरी जीवाय छे उजेंतु हवसे तत्‌यार तुहुं बी ईसु साते सेक-सींगार भेळ उजेंतो हवसे।<verse eid="COL 3:4"/></para>
  <para style="s">जुन्‌ली ने नवली जीवाय</para>
  <para style="p">
    <verse number="5" style="v" sid="COL 3:5"/>हेरेसी तुहुं धरती पर आपसी जीवाय मां, ईनु पापेक अळी पछा घुण आवणे देवु; छीनाळो, चंगलु वीच्‌यार, भुंडली हेर, कुहर्‌यु वीच्‌यार, ने हाय करनु। भगवानेन नींगा मां देवधाणी पुजणे सीगी आवे असु पाप छे, तसोन हाय करनु बी सीगी आवे असु पाप छे। हेरेसी काहने बी भात्‌ये हायाळ्‌ळा घुण बणु। <verse eid="COL 3:5"/><verse number="6" style="v" sid="COL 3:6"/>असली वातेन साहरे हुकुम नी मान्‌या माणसे पर भगवान रीसवाये, ने तींद्‌रे पर भगवानेन डंड आवण्‌यु छे। <verse eid="COL 3:6"/><verse number="7" style="v" sid="COL 3:7"/>ने तुहुं बी पेहले असली वातेन अनसारेत जीवतेला।<verse eid="COL 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="COL 3:8"/>बाकुन हय, तुहुं तुंद्‌रे ईचमां सी जी आखी वात बी छेटी कर देवु; जसों रीसवायणु, खचरायणु, खर करनु, दीसरान नाव-बद्‌दी करनु, ने लड़नु देणु। <verse eid="COL 3:8"/><verse number="9" style="v" sid="COL 3:9"/>ने एक दीसरा काजे लुच्‌चाय करनु बी छुड़ देवु। हेर करु की तुहुं जुन्‌ली पापेन जीवाय काजे तेरा भंडात काम भेळ आपसा डील पर सी हेड़ीन नाख देदला छे; <verse eid="COL 3:9"/><verse number="10" style="v" sid="COL 3:10"/>ने तुहुं नवली जीवाय हात कर लेदला छे; जी जीवाय पुरी अक्‌कल हात करती जाय्‌न आपसा घड़न्‌यान सीका मां उपर-चापर नवली बणती जाय रय। <verse eid="COL 3:10"/><verse number="11" style="v" sid="COL 3:11"/>ईनी नवली जीवाय मां आपणु आखा एक जसा बण गुयला छे; हव फतरी काटण्‌या ने, वीन फतरी काटण्‌या ने, यहुदी जातीन माणसे ने, युनानी जातीन माणसे ने, आड़जात्‌या ने, सहर मां ने बयड़ाम रहण्‌या ने, गुलामी करन्‌या ने, जे गुलामी नी करे चे ने आखा ईसु मसी मां एक हय गुयला छे, हाय हींद्‌रेम काय बी छीट नी रय। बाकुन ज आखो काय ईसुत छे, ने जु आपसा आखा माणसेम बसलु छे।<verse eid="COL 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 3:12"/>हेरेसी भगवान तुहुंक आपसा चुखला ने लाटेक्‌ला असामी बणावणे करीन नेवाड़ लेदलु छे। अतरे तुहुं गीणाका दयाळा, नीचळा, सेळुजीव राखण्‌या ने गम खाण्‌या बणु। <verse eid="COL 3:12"/><verse number="13" style="v" sid="COL 3:13"/>तुंद्‌रे ईचमां काहनी बी वातेन लड़ाय हय जाय, ती एक दीसरान वात काजे वेठ लेजु, ने एक दीसराक माफ कर देजु; जसु मालीक ईसु आपणु गुनु माफ कर्‌यु तसात तुहुं बी दीसराक माफी आपु। <verse eid="COL 3:13"/><verse number="14" style="v" sid="COL 3:14"/>ने जी आखी वात मानीन आंबा-सांबा दयाळु वेहवार करु, काहाकी परम आखाम एक्‌कु लावीन आखाक पुरा-पुरा पाक्‌का करे। <verse eid="COL 3:14"/><verse number="15" style="v" sid="COL 3:15"/>तुहुं आखा एकुत डीलेन भाग छे, ज ईसुन डील छे; ने एक दीसरा पुठ्‌ये हेळी-मेळीन सांती मां जीवणे करीन भगवान तुहुंक बुलावलु छे। ने ईसुन सी जड़नी सुक-सांतीन साहरे तुंद्‌रा मनेन वीच्‌यार काजे कब्‌जाम राखीन भेळा रहु। ने तुहुं भगवान काजे बेसकु वारु छे कह्‌ता रहु। <verse eid="COL 3:15"/><verse number="16" style="v" sid="COL 3:16"/>ईसुन आखा सीकाड़ला काजे तुंद्‌रा मन मां ने जीवाय मां पुरी-पुरी बसणे देवु। तुहुं वारु समज राखीन एक दीसरा काजे सीकाड़ु ने चेतावु, ने भगवानेन नींगा मां हेळी-मेळीन आखे हीये भगवानेन वातरा कहता जाय्‌न भगवानेन गीते, गावु ने भजन गाया करु। <verse eid="COL 3:16"/><verse number="17" style="v" sid="COL 3:17"/>ज काय बी तुहुं करु, भले बुलने मां नी ते दीसरा काम मां च आखो काय मालीक ईसु मसीन नावलीन करु, हव तेरे वगे हय्‌न भगवान बाबान गुणे गावता जाय्‌न च आखो काम करु।<verse eid="COL 3:17"/></para>
  <para style="s">नवली जीवाय्‌न पाळनी</para>
  <para style="p">
    <verse number="18" style="v" sid="COL 3:18"/>ओ बायर, तुहुं आपसा काजे आपसा-आपसा घरवाळाक सुपरुत करीन जीवु, जसों मालीक ईसुक मान्‌या धड़े तालेत छे।<verse eid="COL 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="COL 3:19"/>ए अदमी, तुहुं आपणी-आपणी बायर काजे परम करता रहु, ने तींद्‌रे साते काठो वेहवार घुण करु।<verse eid="COL 3:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="COL 3:20"/>ए पुर्‌या-पारी आखी वातेम आपणा-आपणा आसी बासेन हुकुम मानु, काहाकी असा करसु ती भगवान मालीक खुस हवसे।<verse eid="COL 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="COL 3:21"/>ए आसी बास तुहुं आपणा-आपणा पुर्‌या-पारी काजे फालतु घुण कीचवाड़जु; नी ते तींद्‌रो मन ढास जासे।<verse eid="COL 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="COL 3:22"/>ए पावर्‌या, जे धरती पर वाळा तुंद्‌रा मालीक छे, आखी वात मां तींद्‌रु बी हुकुम मान्‌ता रवजु। आपणा-आपणा मालीक काजे देखाड़ने करीन अतरात सेवा चाकरी करनेन ढंगड़ा घुण करजु; बाकुन भगवानेन सीक मानीन तींद्‌री वात मान्‌ता रवजु। <verse eid="COL 3:22"/><verse number="23" style="v" sid="COL 3:23"/>माणसेन सेवा चाकरी कर रया; असो समजीन आपसा-आपसा मालीकेन सेवा चाकरी घुण करु; बाकुन मालीक ईसुन सेवा चाकरी कर रया समजीन तींद्‌री सेवा चाकरी करजु, असो करीन ज काय बी करे च, खरलो मने, पुरु जीव ने डील लागाड़ीन करजु। <verse eid="COL 3:23"/><verse number="24" style="v" sid="COL 3:24"/>हेर करु तुहुं मालीक ईसु मसीन सेवा कर रया करीन तुहुं काजे मालीक ईसु वगे सी वायदु करला हकेन हीसाबे ईनाम जड़से। <verse eid="COL 3:24"/><verse number="25" style="v" sid="COL 3:25"/>जु काहनुक आपणा-आपणा मालीकेन कुहराय करे, तीना काजे तेरीत कुहराय नड़से; तीने टेमे नीयाव करन्‌यु काहनुक अगु नी आवे।<verse eid="COL 3:25"/></para>
  <chapter eid="COL 3"/>
  <chapter number="4" style="c" sid="COL 4"/>
  <para style="p">
    <verse number="1" style="v" sid="COL 4:1"/>ए मालक्‌या सरगे मां तुंद्‌रु बी एक मालीक छे, असो समजीन तुहुं आपणा-आपणा गुलाम पावर्‌या साते वारु नीयाव ने वेहवार करु।<verse eid="COL 4:1"/></para>
  <para style="s">खुस-खबर सामळावणेन मुखु जड़नु चाहजे करीन भगवान धड़े वीन्‌ती करता रहु</para>
  <para style="p">
    <verse number="2" style="v" sid="COL 4:2"/>पहरु देण्‌यान तसा चेतीन रहु ने भगवान धड़े दुवा करु, ने भगवान काजे बेसकु वारु कहता जाय्‌न मन लागाड़ीन वीन्‌ती कर्‌या करु। <verse eid="COL 4:2"/><verse number="3" style="v" sid="COL 4:3"/>मे ते हय ईसु मसीन बारामां भगवानेन सातायली युजना उजेंती कर देदु करीन मेसेक जेल मां कुंड मेल्‌यु; तेबी मेसेक ईसुन ज काम करनु छे; अतरे हामरे वाटे बी भगवान धड़े वीन्‌ती करता रहु, की भगवान हामुक ईनी सातायली वातेन खुस-खबर दीसराक बी सामळावणे करीन अळी बी मुखु आपे। <verse eid="COL 4:3"/><verse number="4" style="v" sid="COL 4:4"/>भगवान वाटे वीन्‌ती करु की मे भगवानेन ईनी सातायली वात काजे जसी मेसेक उजेंती करनु चाहजे तसीत चुखी झण उजेंती करो।<verse eid="COL 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="COL 4:5"/>तुहुं बी खुस-खबर सामळावणेन मुखु हेरता रहु; ईसु काजे माने तींद्‌रे साते अक्‌कल सी वेहवार करु; जत्‌यार बी मुखु जड़ जाय ती, मुखा काजे महंग्‌लु समजीन तीनुक खुस-खबर सामळु। <verse eid="COL 4:5"/><verse number="6" style="v" sid="COL 4:6"/>ने तींद्‌रे धड़े तुंद्‌री वात जलम गीण-दया वाळी ने सुवाळी रहणु चाहजे, ने तुहुं काजे वारु रीते आखाक जपाप देदा आवड़ी जाणु चाहजे।<verse eid="COL 4:6"/></para>
  <para style="s">पोलुसेन सातीन बारामां खबर</para>
  <para style="p">
    <verse number="7" style="v" sid="COL 4:7"/>मे तुखीकुस काजे तुंद्‌रेन्‌चां मकली रयु जु, मालीक ईसु मां मारु लाटेक्‌लु भाय ने साती गुलाम पावर्‌यु छे, ने ईसुन ईमानदार पावर्‌यु छे। <verse eid="COL 4:7"/><verse number="8" style="v" sid="COL 4:8"/>मे हीनाक हेरेन करीन मकली रयु की तुहुं, हेरे साहरे हामरे बारामां जाण लेवु, ने जु तुंद्‌रा हीया मन काजे हिम्‌मत आपे। <verse eid="COL 4:8"/><verse number="9" style="v" sid="COL 4:9"/>ने मे हेरे पुठ्‌ये उनेसीमुस काजे बी मकली रयु, हयु ईसु मसी मां हामरु लाटेक्‌लु ने ईमानदार भाय छे, ने जु तुंद्‌रे मायन एक जणु छे; ने हया तुहुं काजे जां वाळी आखी वात कय देसे।<verse eid="COL 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="COL 4:10"/>अरीस्‌तारकुस ते मार पुठ्‌ये जेल मां कुंडायलु छे। मरकुस ते बरनाबासेन सगु भाय छे; तेरे बारामां तुहुं काजे ज हुकुम जड़लो हतलो की हयु जत्‌यार बी तुंद्‌रेन्‌चां आवे ती हेरु वारु आव-भाव करजु। <verse eid="COL 4:10"/><verse number="11" style="v" sid="COL 4:11"/>ने ईसु काजे बी जु युस्‌तुस कहवाये, जे तुहुं काजे वारलु छे की करीन पुछ रया, ने यहुदी माणसे मायन जे अतरात भगवानेन राजेन वाटे मार साते काम करन्‌या साजल्‌या छे; ने जे मेसेक सांती आपण्‌या छे।<verse eid="COL 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 4:12"/>ईपर्‌फास बी तुहुं काजे वारलु छे की करीन पुछ रयु। हयु तुंद्‌रेत मायन एक जणु छे, ने ईसु मसीन गुलाम पावर्‌यु बण रयु। हयु ते तुंद्‌रे वाटे जलम भगवान धड़े जीव ने डील लागाड़ीन दुवा कर्‌या करे, हयु हेरेन करीन की तुहुं आखी वातेम भगवानेन मरजी पुरी करता जाय्‌न पुरा-पुरा पाक्‌का हय जावु। <verse eid="COL 4:12"/><verse number="13" style="v" sid="COL 4:13"/>मे ईनी वातेन गवा छे की, हयु तुंद्‌रे वाटे ने लोदीकीया सहर ने हीयारापुलीस सहर मां रहणे वाळा ईसुन माणसे वाटे बेसको काठो काम करो। <verse eid="COL 4:13"/><verse number="14" style="v" sid="COL 4:14"/>परमवाळु डाक्‌टर लुकु तुहुं काजे आवीस ने आवजु कय रयु ने देमास बी आवीस ने आवजु कय रयु।<verse eid="COL 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="COL 4:15"/>लोदीकीया सहरेन ईसुन माणसे काजे ने नुमफास काजे ने तेरा घर मां बसणे वाळी मंडळी ने माणसे काजे बी मारे अगळ हय्‌न वारलु छे करीन कय देजु। <verse eid="COL 4:15"/><verse number="16" style="v" sid="COL 4:16"/>ने जत्‌यार जी चिट्‌ठी तुंद्‌रेन्‌चां भण लेवु, ती लोदीकीया सहरे मां रहण्‌या ईसुन मंडळी काजे बी जी चिट्‌ठी भणाय देजु, ने जी चिट्‌ठी मे लोदीकीया वाळी मंडळीन नावे मकेल्‌लु जी चिट्‌ठी तुंद्‌रेन्‌चां आवे ती तुहुं बी भणजु। <verse eid="COL 4:16"/><verse number="17" style="v" sid="COL 4:17"/>ने अरखीप्‌पुस काजे कह्‌जु की ज सेवान काम मालीक ईसु तुसे काजे आपलु छे, तीना कामेक समळीन पुरो कर लेजु।<verse eid="COL 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="COL 4:18"/>मे पोलुस खुद आपसे हाते करीन तुहुं काजे वारलु छे करीन लिख रयु। मेसेक ते जेल मां कुंड मेल्‌यो; मेसेक घुण ईसेरु। तुंद्‌रे पर गीण-दया हवती रहणु चाहजे!</para>
  <para style="p" vid="COL 4:18">असु मे भगवान धड़े वीन्‌ती करो; आमीन।<verse eid="COL 4:18"/></para>
  <chapter eid="COL 4"/>
</usx>
