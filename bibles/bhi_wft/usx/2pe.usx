<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2PE" style="id">- Bhilali Standard Project</book>
  <para style="h">2 पतरस</para>
  <para style="toc3">2 पतरस</para>
  <para style="toc2">2 पतरस</para>
  <para style="toc1">पतरसेन दुसरी चिट्‌ठी</para>
  <para style="mt2">पतरस की दूसरी पत्री</para>
  <para style="mt1">पतरसेन दुसरी चिट्‌ठी</para>
  <para style="imt">2 पतरसेन बारामां</para>
  <para style="ip">2 पतरसेन चिट्‌ठी कह्‌वे की ज्‌य नेवताळान काम पतरसेन साहरे लिखी गुयलो, आज बेसका सास्‌तुर लिखण्‌या ईनाक छाचो नी माने। असा मानु कुय दीसरु ईनाक पतरस भीणी सी लिखलु हय। लिखणे वाळु कह्‌वे की चु ईसुन जीवनेन ने खास रुप सी चेहरु बदलनेन <char style="xt"><ref loc="2PE 1:17-18">1:17-18</ref></char> हतलु। कदी पतरस चिट्‌ठी लिखलु, ती मान लेवु की हीयु रोम मां मसीन पयदा हवणेन सांठ ने पांच-सांठ ने नव सालेन ईचमां मरने सी पेहल लिखलु हय। पतरस ईनाक आपणी दीसरी चिट्‌ठी बी कह्‌वे <char style="xt"><ref loc="2PE 3:1">3:1</ref></char> ज्‌य 1 पतरसेन चिट्‌ठीन पछे लिखणेन तारीक राखे। चे आखा ईसु पर भुरसु करन्‌या काजे देखाड़े।</para>
  <para style="ip">पतरस जी चिट्‌ठी ईसु पर भुरसु करन्‌या काजे वारलु जीवन जीवणे वाटे हिम्‌मत बांदाड़ने करीन ने झुठी वात सीकाड़न्‌यान घुणी मानु चेतावणी देणे वाटे लिखलु। <char style="xt"><ref loc="2PE 2">2</ref></char> हीयु हीनुक हीनु माणसेन नीरास करने वाटे हिम्‌मत बांदाड़्‌यु जे कय र्‌या की ईसु काजे पछु आवणे मां बेसकी टेम लाग रय। हेरे बजाय हीयु बताड़्‌यु की भगवान ढील्‌लु नी हय बाकुन चाहे की हर एक बचाड़ी जाय। <char style="xt"><ref loc="2PE 3:8-9">2 पतरस 3:8-9</ref>;</char> ज्‌य एक वारलु जीवन जीवणेन एक मतलब छे। <char style="xt"><ref loc="2PE 3:14">3:14</ref></char></para>
  <para style="iot">बाहरती वात</para>
  <para style="io1">1. पतरस हेरु उळखाण देय ने आपणा भन्‌ने वाळा काजे देखाड़्‌यु। <char style="ior"><ref loc="2PE 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2. अळतेन चु हीनुक वारलु जीवन जीवणे हेर देवाड़े काहाकी भगवान हामुक सफल कर्‌यु। <char style="ior"><ref loc="2PE 1:3-21">1:3-21</ref></char></para>
  <para style="io1">3. हेरे पछेन चु झुठ सीकाड़न्‌यान वीरुद चेतावणी देय ने कह्‌वे की आकरी मां झुट सीकाड़न्‌यान काय हसे। <char style="ior"><ref loc="2PE 2:1-22">2:1-22</ref></char></para>
  <para style="io1">4. हेरे पछेन पतरस ईसु पर भुरसु करन्‌या काजे ईसुन दीसरी कावा आवणेन तीयारी वाटे वारु जीवन जीवणे वाटे हिम्‌मत बांदाड़ने करतु जाय पुरो करे। <char style="ior"><ref loc="2PE 3:1-17">3:1-17</ref></char></para>
  <chapter number="1" style="c" sid="2PE 1" />
  <para style="s">ईसु आपणु काजे ज चाहजे च आपलु छे</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 1:1" />सीमोन पतरस भीणी सी, जु ईसु मसीन पावर्‌यु ने नेवताळु छे, मे जी चिट्‌ठी तुहुंं आखा काजे लिख रयु,</para>
  <para style="p" vid="2PE 1:1">तीनुक हामु नेवताळान तसुत ईसु पर भुरसु करने सी महंग्‌लु वाटु जड़लु छे। आपणु भगवान ने ईसु मसी जु बचाड़न्‌यु छे, चु आपसा धरमेन अनसारे चु वाटु आपणुक आपलु छे।<verse eid="2PE 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2PE 1:2" />तुहुंंक आपणा भगवान ने मालीक ईसु मसीन उवखाणेन साहरे गीण-दया ने सुक-सांती तुंद्‌रे मां बेसकी जादा जड़ती रवे।<verse eid="2PE 1:2" /></para>
  <para style="s">बुलावु ने नेवाड़नेन</para>
  <para style="p">
    <verse number="3" style="v" sid="2PE 1:3" />काहाकी सरगेन ताकत ने आखो काय जो जीवन ने भक्‌ती सी लागाव राखे, हामुक हेरीत उवखाणेन साहरे आपला छे, भगवान हेरीत सेक-सींगार ने वारलु कामेन अनसारे बुलाय गुयला छे। <verse eid="2PE 1:3" /><verse number="4" style="v" sid="2PE 1:4" />तींद्‌रे साहरे हयु हामुक बेसको जरुड़ी ने बेसकु मटु वायदु आपलु छे। काहाकी हींद्‌रे साहरे तुहुंं हीनी सड़नु सी छुटीन जे कळी मां भुंडी लालुच सी हवे, सरगेन साजल्‌या बणी जावु। <verse eid="2PE 1:4" /><verse number="5" style="v" sid="2PE 1:5" />हेरे वजे सी तुहुंं आखी भातीन कुसीस करीन, आपणा भुरसा पर वारलु कामे, ने वारलु काम पर समज, <verse eid="2PE 1:5" /><verse number="6" style="v" sid="2PE 1:6" />ने समज पर खुद पर भुरसु, भुरसा पर दमधरीन, ने दमधरीन पर भक्‌ती। <verse eid="2PE 1:6" /><verse number="7" style="v" sid="2PE 1:7" />ने खरली भक्‌ती भेळा भाय-बहण्‌स्‌यान, नातो अदाड़ु ने तेरे भेळा भाय-बहण्‌यान मां परम अदाड़ता जावु।<verse eid="2PE 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2PE 1:8" />काहाकी कदी जी वात तुंद्‌रे मां हीनी टेम मां रवे, ने अदतीत जाय, ती तुहुंं हामरा मालीक ईसु मसीन उळखाण मां बेकार ने रवलो नी हवणी देय। <verse eid="2PE 1:8" /><verse number="9" style="v" sid="2PE 1:9" />काहाकी जेरेमां जी वात नी, हय चु आंधळु छे, ने धुंधळो देखे, ने आपणा पछला पाप सी चुखो हवणे भुली गुयु।<verse eid="2PE 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 1:10" />हीनी वजे सी ए भायसे आपणे बुलाय जाणेन, ने नेवाड़ लेदा जाणेन पुरावु करनेन भली भाती कुसीस करता जावु, काहाकी कदी असा करसु, ती कदी बी वाटे सी नी भुलवायु। <verse eid="2PE 1:10" /><verse number="11" style="v" sid="2PE 1:11" />बाकुन हीनी रीत सी तुहुंं हामरा मालीक ने छुटकारु आपण्‌या ईसु मसीन जलमेन राज मां वारु ईज्‌जतेन साते जाती रवसु।<verse eid="2PE 1:11" /></para>
  <para style="s">पतरसेन आकरी घड़ी</para>
  <para style="p">
    <verse number="12" style="v" sid="2PE 1:12" />हेरेसी कदी तुहुंं जी वात जाणु काय, ने जो छाचलो बुल तुहुंंक जड़लो छे, हेरेमां बणी रवसु, तेबी मे तुहुंंक ईनी वातेन हेर देवाड़ने करीन जलम तीयार रवीस। <verse eid="2PE 1:12" /><verse number="13" style="v" sid="2PE 1:13" />मे जो आपणे वाटे सय समजो, की जत्‌यार लग मे ईना पड़ावा मां छे, तत्‌यार लग तुहुंंक हेर देवाड़ी-देवाड़ीन अगा बड़ावतु रवीस। <verse eid="2PE 1:13" /><verse number="14" style="v" sid="2PE 1:14" />काहाकी मे गुयो जाणु, की मारा पड़ावा काजे उदारनेन टेम छाटात आवणे वाळा छे, जसा की हामरा मालीक ईसु मसी, मेसे काजे उजेंतु कर्‌यु। <verse eid="2PE 1:14" /><verse number="15" style="v" sid="2PE 1:15" />हेरेसी मे असा तावणी करीस, की दुनीयाक छुड़ीन जाणेन पछे बी तुहुंं ईनु आखा वात काजे जलम हेर करसे।<verse eid="2PE 1:15" /></para>
  <para style="s">मसीन सेक-सींगारेन डुळा अगळ</para>
  <para style="p">
    <verse number="16" style="v" sid="2PE 1:16" />काहाकी जत्‌यार हामु तुहुंंक आपणे मालीक ईसु मसीन ताकत काजे, ने आवणे वाळा दाहड़ान खबर आपलु, ती चु चालाकी सी बणावली दाखलान साहरु नी लेदा बाकुन हामु आपसात हेरे सेक काजे देखला हतला। <verse eid="2PE 1:16" /><verse number="17" style="v" sid="2PE 1:17" />काहाकी हीयु भगवान बास सी ईज्‌जत, ने सेक-सींगार हात करे ने हीना सरगेन सेक-सींगार सी जी अवाज आवी, “जु मारु लाटेक्‌लु पुर्‌यु छे, जेरेसी मे खुस छे।”<note caller="+" style="x"><char style="xo" closed="false">1:17 </char><char style="xt" closed="false"><ref loc="PSA 2:7">भजन सहीता 2:7</ref>; <ref loc="ISA 42:1">यसाया 42:1</ref></char></note> <verse eid="2PE 1:17" /><verse number="18" style="v" sid="2PE 1:18" />तत्‌यार हामु हेरे साते चुखला बयड़ा पर हतला ने सरग सी जी अवाज आवतेली सामळाय।<verse eid="2PE 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2PE 1:19" />हामरे धड़े जे भगवानेन अघी सी आवणे वाळी वात देखान्‌यान बुल छे, चु ईनु हालोत सी काठा ठेहर्‌या तुहुंं जो वारु करु जे ज्‌य सामळीन हीना पर हेर करु, की चु एक दिवु छे जे आंदारलान जागा मां हीनी टेम लग उजाळो देतो रवसे जत्‌यार लग की दाहड़ान वीजाळो नी छुड़े ने वीजाळ्‌यु तारु तुंद्‌रे मन मां नी चमकी पड़े। <verse eid="2PE 1:19" /><verse number="20" style="v" sid="2PE 1:20" />बाकुन आखा सी पेहल गुयो जाणी लेवु की चुखला सास्‌तुरेन कुय बी आवणे वाळी वात भगवानेन अघी सी आवणे वाळी वात देखान्‌या बी खुद आपणे वीच्‌यार सी नी कह्‌वे। <verse eid="2PE 1:20" /><verse number="21" style="v" sid="2PE 1:21" />काहाकी कुय बी भगवानेन अघी सी आवणे वाळी वात देखाड़ने वाळा बी आपणी मरजी सी कदी नी कह्‌वे बाकुन भक्‌त जणा चुखली-आत्‌मान साहरे उभरीन जाय्‌न भगवानेन भीणी सी बुल तेला।<verse eid="2PE 1:21" /></para>
  <chapter eid="2PE 1" />
  <chapter number="2" style="c" sid="2PE 2" />
  <para style="s">झुटी वात सीकाड़न्‌या</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 2:1" />जीनी तरह हीनु माणसे भगवानेन अघी सी आवणे वाळी वात देखान्‌या मां बी लुच्‌चा हतला तसात तुंद्‌रे मां बी लुच्‌चा सीकाड़न्‌या हवसे, जे खत्‌तम करने वाळा ढंगेन सुरुवात डुकाय डुकायन करसे, ने हीना मालीक जीनुक हीयु मुल ली लेदलु छे हेरु नीकारु करसे, ने आपणे आप काजे छाटुस खत्‌तम कर लेसे। <verse eid="2PE 2:1" /><verse number="2" style="v" sid="2PE 2:2" />बेसका हींद्‌रेन तसा लुच्‌चाय करसे, जेरे वजे सी छाचाय्‌न वाटेन वाक नीकाळे। <verse eid="2PE 2:2" /><verse number="3" style="v" sid="2PE 2:3" />चे लालच वाटे वात बणायन तुहुंंक आपणा फायदान वजे बणावसे, ने जे डंडेन हुकुम हींद्‌रे पर पेहल सी हय गुयलु छे, हेरे आवणे मां काय बी वार नी हय, ने हींद्‌रो नास वाट देख र्‌यो।<note caller="+" style="x"><char style="xo" closed="false">2:3 </char><char style="xt" closed="false"><ref loc="EZK 36:22">यहेजकेल 36:22</ref>; <ref loc="ROM 2:24">रोमीयो 2:24</ref></char></note><verse eid="2PE 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2PE 2:4" />काहाकी जत्‌यार भगवान हीनु सरग वाळा काहवाळ्‌या काजे जे पाप करनु नी छुड़्‌या, बाकुन नरक मां मकलीन आंदारला डहरा मां नाख देदा, काहाकी नीयावेन दाहड़ा लग बंद रवसे। <verse eid="2PE 2:4" /><verse number="5" style="v" sid="2PE 2:5" />ने पेहला वारान कळीन आखा माणसे काजे मुसळ धार्‌यु-पाणी पाड़ीन सारी नाख्‌यु, तीने टेमे नुह धरमेन परचार कर्‌या करतेलु, नुहेन घरन्‌या सुद्‌ये ढंड्‌या मां नाखीन बचाड़ लेदु, चे आखा मेळीन आठ जणा हतला। <verse eid="2PE 2:5" /><verse number="6" style="v" sid="2PE 2:6" />ने सदोम ने अमोरान सहर काजे नासेन असु डंड देदु, की हीनुक खत्‌तम करीन रखड़ा मां मेळाय देदु काहाकी चे आवणे वाळा भक्‌ती नी करने वाळा माणसेन सीकापण वाटे एक दाखलु बणु। <verse eid="2PE 2:6" /><verse number="7" style="v" sid="2PE 2:7" />ने धरमी लुत काजे जे नी-धरम वाळान वीटेळ्‌ळान चाल-चलन सी बेसका दुखी, हतला ने छुटकारु आप्‌यु ने बचाड़्‌यु।<note caller="+" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="GEN 19:12">उबजाणनी किताप 19:12</ref>,<ref loc="GEN 19:13">13</ref>,<ref loc="GEN 19:15">15</ref></char></note> <verse eid="2PE 2:7" /><verse number="8" style="v" sid="2PE 2:8" />काहाकी चु धरमी हींद्‌रे ईचमां रवतेलु, ने हींद्‌रे नी-धरमेन काम काजे देखी देखीन, ने सामळी सामळीन, दाहड़ीन आपणा छाचला मन काजे दुखाड़तेलु। <verse eid="2PE 2:8" /><verse number="9" style="v" sid="2PE 2:9" />ती मालीक आपसा भगत काजे पारख मां सी बचाड़ लेजी ने पापी काजे नीयावेन दाहड़े लग डंडेन दसा मां राखणे बी जाणे। <verse eid="2PE 2:9" /><verse number="10" style="v" sid="2PE 2:10" />खास करीन हीनुक जे वीटळा लालुचेन पछळ डीलेन अनसारे चाले, ने सरकार काजे बेकार जाणे। चे चामटा, ने नीसवड़ा छे, ने मटला राज करन्‌या काजे वारु-भुंडो कवणे सी नी बीहीये, <verse eid="2PE 2:10" /><verse number="11" style="v" sid="2PE 2:11" />तेबी सरग वाळा काहवाळ्‌या जे ताकत ने ताकत मां हींद्‌रे सी मटा छे, मालीकेन अगळ हीनुक वारु भुंडा कय्‌न गुनु नी लागाड़े। <verse eid="2PE 2:11" /><verse number="12" style="v" sid="2PE 2:12" />बाकुन जे झुट सीकाड़न्‌या तीनु जनवार्‌यान तसा छे, तींद्‌री अक्‌कल नी हय, ने आखी टेमे आपसा डीलेन हेरेन अनसारेत जीवे, ने धरीन ली जाणे वाटे, ने मरने वाटे पयदा हवला छे। जे माणसे जी वात नी जाणे, चीत वात लीन दीसरान नाव-बद्‌दी करे, बाकुन जे खर करन्‌या माणसे, जनवार्‌यान तसात आपसान खेतेम करन्‌या पापेन साहरे मरीन सर जासे। <verse eid="2PE 2:12" /><verse number="13" style="v" sid="2PE 2:13" />दीसरान बदनामी करनेन बदले हींद्‌रोत भुंडो हवसे; हीनुक दाहड़ु मांजणीक मुजा मस्‌ती करनु वारु लागे; चे बदनावी ने गुना छे। जत्‌यार चे तुंद्‌रे साते खाय ने पीये, ती आपणे भीणी सी परम खाणो करीन मुजा मस्‌ती करे। <verse eid="2PE 2:13" /><verse number="14" style="v" sid="2PE 2:14" />हींद्‌रा डुळा मां छीनाळो बसलो छे, ने चे पाप करे पाखुर हुबा नी रय सके; चे उतवाळ्‌या मनवाळा काजे फुसलायन लेय; हींद्‌रा मन काजे लालच करनेन आदत हय गुयली छे, चे सराप सी पुर्‌या छे। <verse eid="2PE 2:14" /><verse number="15" style="v" sid="2PE 2:15" />चे सुदली वाट काजे छुड़ीन भटकी गुयला छे, ने बवोरेन पुर्‌या बीलामेन वाट पर हय गुयलु छे, तीनाक नी-धरमेन काम करनेन दाहड़की काजे वारु समजी गुयु।<note caller="+" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="NUM 22:5-7">गिन्‌ती 22:5-7</ref></char></note> <verse eid="2PE 2:15" /><verse number="16" style="v" sid="2PE 2:16" />बाकुन हेरे गुनान बारामां फठकार बी पड़ी, जां लग की एक गुंगी गदड़ीक बी माणसेन तसी वात करी हीना भगवानेन अघी सी आवणे वाळी वात देखान्‌या काजे हेरे गांडाय सी रुक्‌यु।<note caller="+" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="NUM 22:26-31">गिन्‌ती 22:26-31</ref></char></note><verse eid="2PE 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 2:17" />चे माणसे सुकला कुवान, ने आंधान उडाल्‌ला वादळा छे; हींद्‌रे वाटे जलमेन आंदारलो ठेराय गीलो छे। <verse eid="2PE 2:17" /><verse number="18" style="v" sid="2PE 2:18" />चे बेकार कुहरायन वात करी करीन लुच्‌चायन कामेन साहरे हीनु माणसे काजे डीलेन लालच मां फसाड़ी लेय जे भुल मां सी हय नीकळी र्‌या। <verse eid="2PE 2:18" /><verse number="19" style="v" sid="2PE 2:19" />जे झुट सीकाड़न्‌या असु छुटकारु आपणेन वायदु करे, तीना छुटकारा मां आखा नेम सी छुटीन, जसों पटे तसों जीवणेन छुट छे बाकुन चे ते खत्‌तम करन्‌या पापेन गुलाम छे ने आपसात छुटकारु हात करला नी हय, काहाकी माणुस तेरा कब्‌जाम हय जाय, तेरुत गुलाम बण जाय। <verse eid="2PE 2:19" /><verse number="20" style="v" sid="2PE 2:20" />जत्‌यार चे मालीक ने छुटकारु आपण्‌या ईसु मसीन उवखाणेन साहरे कळीन नानलीत तरान वीटळने सी बचीन नीकळे, ने अळी हींद्‌रे मां फसीन हारी जाय, ती हींद्‌री पछली दसा पेहली सी बी भुंडीत हय जासे। <verse eid="2PE 2:20" /><verse number="21" style="v" sid="2PE 2:21" />काहाकी धरमेन वाट काजे नी जाणुत हींद्‌रे वाटे वारु हवतो, की हीनुक जाणीन हीनी चुखली हुकुम सी फीरी जाणु जो हीनुक सुप गुयलो हतलो। <verse eid="2PE 2:21" /><verse number="22" style="v" sid="2PE 2:22" />तींद्‌रे पर चत वीत्‌यो जसा खरला कवाड़ा मां लिखलो छे: “कुतरो आपसान उखेळ्‌ळो चाट लेय” ने एक उंगळावली सुहेरनी पछी धुळा मां लुळायणे जात रवे।<note caller="+" style="x"><char style="xo" closed="false">2:22 </char><char style="xt" closed="false"><ref loc="PRO 26:11">नीतीवचन 26:11</ref></char></note><verse eid="2PE 2:22" /></para>
  <chapter eid="2PE 2" />
  <chapter number="3" style="c" sid="2PE 3" />
  <para style="s">ईसु अळी पछु कळी मां आवणेवाळु छे</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 3:1" />ए मारा लाटेक्‌ला, हय मे तुहुंंक जी दीसरी पत्‌री लिखो, ने दुयु मां हेर देवाड़ीन तुहुंंक चुखला मन काजे अदाड़नु, चाहो <verse eid="2PE 3:1" /><verse number="2" style="v" sid="2PE 3:2" />की तुहुंं हीनु वात काजे, जे चुखला भगवानेन अघी सी आवणे वाळी वात देखान्‌यान पेहल सी कय देदला, ने मालीक, ने छुटकारु आपण्‌या हीना हुकुम काजे हेर करु, जे तुंद्‌रे नेवताळान साहरे आपी गुयली हतली। <verse eid="2PE 3:2" /><verse number="3" style="v" sid="2PE 3:3" />पेहल गुयो जाणी लेवु, की आकरी दाहड़ा मां हासी उड़ावणे वाळा आवसे, जे आपणी लालुचेन अनसारे चालसे। <verse eid="2PE 3:3" /><verse number="4" style="v" sid="2PE 3:4" />ने कवसे, “हीनाक आवणेन वायदु काहा गुय? काहाकी जत्‌यार सी डाहा बुड़ा सुय गुयला छे, आखा काय असात छे, जसों कळीन सुरु सी हतलो?” <verse eid="2PE 3:4" /><verse number="5" style="v" sid="2PE 3:5" />चे ते जाणी बुजीन ज्‌य वीसरी गुया, की भगवानेन बुलेन साहरे सरग काय दाहड़ा सी पेहल सी हतलो, छे ने धरती बी पाणी मां सी बणी ने पाणी मां टेकली छे।<note caller="+" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="GEN 1:6-9">उबजाणनी किताप 1:6-9</ref></char></note> <verse eid="2PE 3:5" /><verse number="6" style="v" sid="2PE 3:6" />ज्‌य हीनु हासी उडाड़न्‌यान वजे सी हीनी टेम मां कळी पाणी मां डुबीन सरी गुय।<note caller="+" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="GEN 7:11-21">उबजाणनी किताप 7:11-21</ref></char></note> <verse eid="2PE 3:6" /><verse number="7" style="v" sid="2PE 3:7" />बाकुन हयन टेमेन सरग ने धरती हया बुलेन साहरे हेरेसी मेकी गुयली छे, की धपाड़ी जाय, ने जे पापी माणसेन नीयाव ने खत्‌तम हवणेन दाहड़ा लग असुत राखी रवसे।<verse eid="2PE 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2PE 3:8" />ए मारा लाटेक्‌ला, जी वात तुंद्‌रे सी सातायली नी रवे, की मालीकेन चां एक दाहड़ु हजार साल बराबर छे, ने हजार साल एक दाहड़ा बराबर छे। <verse eid="2PE 3:8" /><verse number="9" style="v" sid="2PE 3:9" />मालीक आपणा वायदान बारामां वार नी करे, जसी वार थुड़ाक माणसे समजे; बाकुन तुंद्‌रे बारामां दम धरी रयु, ने नी चाहे की कुय खत्‌तम हवे; बाकुन गुयो की आखा काजे मन फीरावणेन मुखु जड़े।<note caller="+" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="HEB 2:3">ईब्‌रानीयो 2:3</ref>,<ref loc="HEB 2:4">4</ref></char></note><verse eid="2PE 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 3:10" />बाकुन मालीकेन दाहड़ु चुट्‌टान तसु आय जासे, हीनु दाहड़े सरग हुहेड़तो गाजतो अंछाप हय जासे, ने सरगेन चीज तातु हयन पीगळी जासे, ने धरती ने हेरे पर आखो काम धपी जासे। <verse eid="2PE 3:10" /><verse number="11" style="v" sid="2PE 3:11" />जसों की जो आखी चीजे, हीनी रीत सी खत्‌तम हवणे वाळी छे, ती तुहुंं चुखली चाल चलन ने भक्‌ती मां कसा माणसे हवणु चाहजे, <verse eid="2PE 3:11" /><verse number="12" style="v" sid="2PE 3:12" />ने भगवान हीना दाहड़ान वाट काहाली रीत सी देखणु चाहजे ने हेरो छाटु आवणे वाटे कसा कुसीस करनु चाहजे, जेरे वजे सी सरग आकठा सी पीगळी जासे, ने सरगेन चीज बेसको तातो हयन गळी जासे। <verse eid="2PE 3:12" /><verse number="13" style="v" sid="2PE 3:13" />बाकुन हेरी वायदान अनसारे हामु एक नवलु सरग ने नवली धरतीन आस देखजे जां आखा धरमी रवसे।<verse eid="2PE 3:13" /></para>
  <para style="s">जागता ने तीयार रवु</para>
  <para style="p">
    <verse number="14" style="v" sid="2PE 3:14" />हेरेसी, ए लाटेक्‌ला, जत्‌यार की तुहुंं हीनु वातेन आस देखजे, ती कुसीस करु की तुहुंं सांती सी हेरे अगळ नी-दाग ने नी-गुनाळु ठेहरसु। <verse eid="2PE 3:14" /><verse number="15" style="v" sid="2PE 3:15" />ने हामरे मालीक दम धरी र्‌यु ती छुटकारु समजे, जसा हामरा लाटेक्‌ला भायस पोलुस बी हीना अकलेन अनसारे जे हीनाक जड़लो, तुहुंंक लिखलु छे। <verse eid="2PE 3:15" /><verse number="16" style="v" sid="2PE 3:16" />असात हीयु आपणी आखी पत्‌री मां बी हीना वातेन पंचाती करली छे, जेरेमां काय वात असी छे तींद्‌रो समजणु काठो छे, ने कम-सीकला ने नी-भन्‌नला माणसे बीगाड़ देय जसा की चे दीसरी चुखला सास्‌तुरेन चिट्‌ठीन दत थता मतलब नीकाळता रवे जेरेसी चे खुद आपणात नास कर लेय।<verse eid="2PE 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 3:17" />हेरेसी ए लाटेक्‌ला, तुहुंं माणसे पेहल सी हीनु वात काजे जाणीन चेतीन रवजु, काहाकी नी-धरम वाळान भरम मां फसीन आपणी ताकत काजे कय्‌न हात सी खुय मां देय। <verse eid="2PE 3:17" /><verse number="18" style="v" sid="2PE 3:18" />बाकुन हामरा मालीक, ने छुटकारु आपण्‌या ईसु मसीन गीण-दया ने उळखाण, मां अथा जावु, सेक-सींगार हय बी हवे, ने जलम पीड़ीडीट हवती रवे! आमीन।<verse eid="2PE 3:18" /></para>
  <chapter eid="2PE 3" />
</usx>