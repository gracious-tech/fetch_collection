<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="TIT" style="id">Sanskrit Bible (NT) in ISO Script (satyavēdaḥ ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Titus</para>
  <para style="toc1">tītaṁ patraṁ</para>
  <para style="toc2">tītaḥ</para>
  <para style="toc3">tītaḥ</para>
  <para style="mt1">tītaṁ patraṁ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantajīvanasyāśātō jātāyā īśvarabhaktē ryōgyasya satyamatasya yat tatvajñānaṁ yaśca viśvāsa īśvarasyābhirucitalōkai rlabhyatē tadarthaṁ</para>
  <para style="p">
    <verse number="2" style="v"/>yīśukhrīṣṭasya prērita īśvarasya dāsaḥ paulō'haṁ sādhāraṇaviśvāsāt mama prakr̥taṁ dharmmaputraṁ tītaṁ prati likhami|</para>
  <para style="p">
    <verse number="3" style="v"/>niṣkapaṭa īśvara ādikālāt pūrvvaṁ tat jīvanaṁ pratijñātavān svanirūpitasamayē ca ghōṣaṇayā tat prakāśitavān|</para>
  <para style="p">
    <verse number="4" style="v"/>mama trāturīśvarasyājñayā ca tasya ghōṣaṇaṁ mayi samarpitam abhūt| asmākaṁ tāta īśvaraḥ paritrātā prabhu ryīśukhrīṣṭaśca tubhyam anugrahaṁ dayāṁ śāntiñca vitaratu|</para>
  <para style="p">
    <verse number="5" style="v"/>tvaṁ yad asampūrṇakāryyāṇi sampūrayē rmadīyādēśācca pratinagaraṁ prācīnagaṇān niyōjayēstadarthamahaṁ tvāṁ krītyupadvīpē sthāpayitvā gatavān|</para>
  <para style="p">
    <verse number="6" style="v"/>tasmād yō narō 'nindita ēkasyā yōṣitaḥ svāmī viśvāsinām apacayasyāvādhyatvasya vā dōṣēṇāliptānāñca santānānāṁ janakō bhavati sa ēva yōgyaḥ|</para>
  <para style="p">
    <verse number="7" style="v"/>yatō hētōradyakṣēṇēśvarasya gr̥hādyakṣēṇēvānindanīyēna bhavitavyaṁ| tēna svēcchācāriṇā krōdhinā pānāsaktēna prahārakēṇa lōbhinā vā na bhavitavyaṁ</para>
  <para style="p">
    <verse number="8" style="v"/>kintvatithisēvakēna sallōkānurāgiṇā vinītēna nyāyyēna dhārmmikēṇa jitēndriyēṇa ca bhavitavyaṁ,</para>
  <para style="p">
    <verse number="9" style="v"/>upadēśē ca viśvastaṁ vākyaṁ tēna dhāritavyaṁ yataḥ sa yad yathārthēnōpadēśēna lōkān vinētuṁ vighnakāriṇaśca niruttarān karttuṁ śaknuyāt tad āvaśyakaṁ|</para>
  <para style="p">
    <verse number="10" style="v"/>yatastē bahavō 'vādhyā anarthakavākyavādinaḥ pravañcakāśca santi viśēṣataśchinnatvacāṁ madhyē kēcit tādr̥śā lōkāḥ santi|</para>
  <para style="p">
    <verse number="11" style="v"/>tēṣāñca vāgrōdha āvaśyakō yatastē kutsitalābhasyāśayānucitāni vākyāni śikṣayantō nikhilaparivārāṇāṁ sumatiṁ nāśayanti|</para>
  <para style="p">
    <verse number="12" style="v"/>tēṣāṁ svadēśīya ēkō bhaviṣyadvādī vacanamidamuktavān, yathā, krītīyamānavāḥ sarvvē sadā kāpaṭyavādinaḥ| hiṁsrajantusamānāstē 'lasāścōdarabhārataḥ||</para>
  <para style="p">
    <verse number="13" style="v"/>sākṣyamētat tathyaṁ, atōे hētōstvaṁ tān gāḍhaṁ bhartsaya tē ca yathā viśvāsē svasthā bhavēyu</para>
  <para style="p">
    <verse number="14" style="v"/>ryihūdīyōpākhyānēṣu satyamatabhraṣṭānāṁ mānavānām ājñāsu ca manāṁsi na nivēśayēyustathādiśa|</para>
  <para style="p">
    <verse number="15" style="v"/>śucīnāṁ kr̥tē sarvvāṇyēva śucīni bhavanti kintu kalaṅkitānām aviśvāsināñca kr̥tē śuci kimapi na bhavati yatastēṣāṁ buddhayaḥ saṁvēdāśca kalaṅkitāḥ santi|</para>
  <para style="p">
    <verse number="16" style="v"/>īśvarasya jñānaṁ tē pratijānanti kintu karmmabhistad anaṅgīkurvvatē yatastē garhitā anājñāgrāhiṇaḥ sarvvasatkarmmaṇaścāyōgyāḥ santi|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yathārthasyōpadēśasya vākyāni tvayā kathyantāṁ</para>
  <para style="p">
    <verse number="2" style="v"/>viśēṣataḥ prācīnalōkā yathā prabuddhā dhīrā vinītā viśvāsē prēmni sahiṣṇutāyāñca svasthā bhavēyustadvat</para>
  <para style="p">
    <verse number="3" style="v"/>prācīnayōṣitō'pi yathā dharmmayōgyam ācāraṁ kuryyuḥ paranindakā bahumadyapānasya nighnāśca na bhavēyuḥ</para>
  <para style="p">
    <verse number="4" style="v"/>kintu suśikṣākāriṇyaḥ satya īśvarasya vākyaṁ yat na nindyēta tadarthaṁ yuvatīḥ suśīlatām arthataḥ patisnēham apatyasnēhaṁ</para>
  <para style="p">
    <verse number="5" style="v"/>vinītiṁ śucitvaṁ gr̥hiṇītvaṁ saujanyaṁ svāminighnañcādiśēyustathā tvayā kathyatāṁ|</para>
  <para style="p">
    <verse number="6" style="v"/>tadvad yūnō'pi vinītayē prabōdhaya|</para>
  <para style="p">
    <verse number="7" style="v"/>tvañca sarvvaviṣayē svaṁ satkarmmaṇāṁ dr̥ṣṭāntaṁ darśaya śikṣāyāñcāvikr̥tatvaṁ dhīratāṁ yathārthaṁ</para>
  <para style="p">
    <verse number="8" style="v"/>nirddōṣañca vākyaṁ prakāśaya tēna vipakṣō yuṣmākam apavādasya kimapi chidraṁ na prāpya trapiṣyatē|</para>
  <para style="p">
    <verse number="9" style="v"/>dāsāśca yat svaprabhūnāṁ nighnāḥ sarvvaviṣayē tuṣṭijanakāśca bhavēyuḥ pratyuttaraṁ na kuryyuḥ</para>
  <para style="p">
    <verse number="10" style="v"/>kimapi nāpaharēyuḥ kintu pūrṇāṁ suviśvastatāṁ prakāśayēyuriti tān ādiśa| yata ēvamprakārēṇāsmakaṁ trāturīśvarasya śikṣā sarvvaviṣayē tai rbhūṣitavyā|</para>
  <para style="p">
    <verse number="11" style="v"/>yatō hētōstrāṇājanaka īśvarasyānugrahaḥ sarvvān mānavān pratyuditavān</para>
  <para style="p">
    <verse number="12" style="v"/>sa cāsmān idaṁ śikṣyati yad vayam adharmmaṁ sāṁsārikābhilāṣāṁścānaṅgīkr̥tya vinītatvēna nyāyēnēśvarabhaktyā cēhalōkē āyu ryāpayāmaḥ,</para>
  <para style="p">
    <verse number="13" style="v"/>paramasukhasyāśām arthatō 'smākaṁ mahata īśvarasya trāṇakarttu ryīśukhrīṣṭasya prabhāvasyōdayaṁ pratīkṣāmahē|</para>
  <para style="p">
    <verse number="14" style="v"/>yataḥ sa yathāsmān sarvvasmād adharmmāt mōcayitvā nijādhikārasvarūpaṁ satkarmmasūtsukam ēkaṁ prajāvargaṁ pāvayēt tadartham asmākaṁ kr̥tē ātmadānaṁ kr̥tavān|</para>
  <para style="p">
    <verse number="15" style="v"/>ētāni bhāṣasva pūrṇasāmarthyēna cādiśa prabōdhaya ca, kō'pi tvāṁ nāvamanyatāṁ|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tē yathā dēśādhipānāṁ śāsakānāñca nighnā ājñāgrāhiṇśca sarvvasmai satkarmmaṇē susajjāśca bhavēyuḥ</para>
  <para style="p">
    <verse number="2" style="v"/>kamapi na nindēyu rnivvirōdhinaḥ kṣāntāśca bhavēyuḥ sarvvān prati ca pūrṇaṁ mr̥dutvaṁ prakāśayēyuścēti tān ādiśa|</para>
  <para style="p">
    <verse number="3" style="v"/>yataḥ pūrvvaṁ vayamapi nirbbōdhā anājñāgrāhiṇō bhrāntā nānābhilāṣāṇāṁ sukhānāñca dāsēyā duṣṭatvērṣyācāriṇō ghr̥ṇitāḥ parasparaṁ dvēṣiṇaścābhavāmaḥ|</para>
  <para style="p">
    <verse number="4" style="v"/>kintvasmākaṁ trāturīśvarasya yā dayā marttyānāṁ prati ca yā prītistasyāḥ prādurbhāvē jātē</para>
  <para style="p">
    <verse number="5" style="v"/>vayam ātmakr̥tēbhyō dharmmakarmmabhyastannahi kintu tasya kr̥pātaḥ punarjanmarūpēṇa prakṣālanēna pravitrasyātmanō nūtanīkaraṇēna ca tasmāt paritrāṇāṁ prāptāḥ</para>
  <para style="p">
    <verse number="6" style="v"/>sa cāsmākaṁ trātrā yīśukhrīṣṭēnāsmadupari tam ātmānaṁ pracuratvēna vr̥ṣṭavān|</para>
  <para style="p">
    <verse number="7" style="v"/>itthaṁ vayaṁ tasyānugrahēṇa sapuṇyībhūya pratyāśayānantajīvanasyādhikāriṇō jātāḥ|</para>
  <para style="p">
    <verse number="8" style="v"/>vākyamētad viśvasanīyam atō hētōrīśvarē yē viśvasitavantastē yathā satkarmmāṇyanutiṣṭhēyustathā tān dr̥ḍham ājñāpayēti mamābhimataṁ|tānyēvōttamāni mānavēbhyaḥ phaladāni ca bhavanti|</para>
  <para style="p">
    <verse number="9" style="v"/>mūḍhēbhyaḥ praśnavaṁśāvalivivādēbhyō vyavasthāyā vitaṇḍābhyaśca nivarttasva yatastā niṣphalā anarthakāśca bhavanti|</para>
  <para style="p">
    <verse number="10" style="v"/>yō janō bibhitsustam ēkavāraṁ dvirvvā prabōdhya dūrīkuru,</para>
  <para style="p">
    <verse number="11" style="v"/>yatastādr̥śō janō vipathagāmī pāpiṣṭha ātmadōṣakaśca bhavatīti tvayā jñāyatāṁ|</para>
  <para style="p">
    <verse number="12" style="v"/>yadāham ārttimāṁ tukhikaṁ vā tava samīpaṁ prēṣayiṣyāmi tadā tvaṁ nīkapalau mama samīpam āgantuṁ yatasva yatastatraivāhaṁ śītakālaṁ yāpayituṁ matim akārṣaṁ|</para>
  <para style="p">
    <verse number="13" style="v"/>vyavasthāpakaḥ sīnā āpalluścaitayōḥ kasyāpyabhāvō yanna bhavēt tadarthaṁ tau yatnēna tvayā visr̥jyētāṁ|</para>
  <para style="p">
    <verse number="14" style="v"/>aparam asmadīyalōkā yanniṣphalā na bhavēyustadarthaṁ prayōjanīyōpakārāyā satkarmmāṇyanuṣṭhātuṁ śikṣantāṁ|</para>
  <para style="p">
    <verse number="15" style="v"/>mama saṅginaḥ savvē tvāṁ namaskurvvatē| yē viśvāsād asmāsu prīyantē tān namaskuru; sarvvēṣu yuṣmāsvanugrahō bhūyāt| āmēn|</para>
</usx>
