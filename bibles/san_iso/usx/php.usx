  <para style="h">Philippians</para>
  <para style="toc1">philipinaḥ patraṁ</para>
  <para style="toc2">philipinaḥ</para>
  <para style="toc3">philipinaḥ</para>
  <para style="mt1">philipinaḥ patraṁ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>paulatīmathināmānau yīśukhrīṣṭasya dāsau philipinagarasthān khrīṣṭayīśōḥ sarvvān pavitralōkān samitēradhyakṣān paricārakāṁśca prati patraṁ likhataḥ|</para>
  <para style="p">
    <verse number="2" style="v"/>asmākaṁ tāta īśvaraḥ prabhu ryīśukhrīṣṭaśca yuṣmabhyaṁ prasādasya śāntēśca bhōgaṁ dēyāstāṁ|</para>
  <para style="p">
    <verse number="3" style="v"/>ahaṁ nirantaraṁ nijasarvvaprārthanāsu yuṣmākaṁ sarvvēṣāṁ kr̥tē sānandaṁ prārthanāṁ kurvvan</para>
  <para style="p">
    <verse number="4" style="v"/>yati vārān yuṣmākaṁ smarāmi tati vārān ā prathamād adya yāvad</para>
  <para style="p">
    <verse number="5" style="v"/>yuṣmākaṁ susaṁvādabhāgitvakāraṇād īśvaraṁ dhanyaṁ vadāmi|</para>
  <para style="p">
    <verse number="6" style="v"/>yuṣmanmadhyē yēnōttamaṁ karmma karttum ārambhi tēnaiva yīśukhrīṣṭasya dinaṁ yāvat tat sādhayiṣyata ityasmin dr̥ḍhaviśvāsō mamāstē|</para>
  <para style="p">
    <verse number="7" style="v"/>yuṣmān sarvvān adhi mama tādr̥śō bhāvō yathārthō yatō'haṁ kārāvasthāyāṁ pratyuttarakaraṇē susaṁvādasya prāmāṇyakaraṇē ca yuṣmān sarvvān mayā sārddham ēkānugrahasya bhāginō matvā svahr̥dayē dhārayāmi|</para>
  <para style="p">
    <verse number="8" style="v"/>aparam ahaṁ khrīṣṭayīśōḥ snēhavat snēhēna yuṣmān kīdr̥śaṁ kāṅkṣāmi tadadhīśvarō mama sākṣī vidyatē|</para>
  <para style="p">
    <verse number="9" style="v"/>mayā yat prārthyatē tad idaṁ yuṣmākaṁ prēma nityaṁ vr̥ddhiṁ gatvā</para>
  <para style="p">
    <verse number="10" style="v"/>jñānasya viśiṣṭānāṁ parīkṣikāyāśca sarvvavidhabuddhē rbāhulyaṁ phalatu,</para>
  <para style="p">
    <verse number="11" style="v"/>khrīṣṭasya dinaṁ yāvad yuṣmākaṁ sāralyaṁ nirvighnatvañca bhavatu, īśvarasya gauravāya praśaṁsāyai ca yīśunā khrīṣṭēna puṇyaphalānāṁ pūrṇatā yuṣmabhyaṁ dīyatām iti|</para>
  <para style="p">
    <verse number="12" style="v"/>hē bhrātaraḥ, māṁ prati yad yad ghaṭitaṁ tēna susaṁvādapracārasya bādhā nahi kintu vr̥ddhirēva jātā tad yuṣmān jñāpayituṁ kāmayē'haṁ|</para>
  <para style="p">
    <verse number="13" style="v"/>aparam ahaṁ khrīṣṭasya kr̥tē baddhō'smīti rājapuryyām anyasthānēṣu ca sarvvēṣāṁ nikaṭē suspaṣṭam abhavat,</para>
  <para style="p">
    <verse number="14" style="v"/>prabhusambandhīyā anēkē bhrātaraśca mama bandhanād āśvāsaṁ prāpya varddhamānēnōtsāhēna niḥkṣōbhaṁ kathāṁ pracārayanti|</para>
  <para style="p">
    <verse number="15" style="v"/>kēcid dvēṣād virōdhāccāparē kēcicca sadbhāvāt khrīṣṭaṁ ghōṣayanti;</para>
  <para style="p">
    <verse number="16" style="v"/>yē virōdhāt khrīṣṭaṁ ghōṣayanti tē pavitrabhāvāt tanna kurvvantō mama bandhanāni bahutaraklōśadāyīni karttum icchanti|</para>
  <para style="p">
    <verse number="17" style="v"/>yē ca prēmnā ghōṣayanti tē susaṁvādasya prāmāṇyakaraṇē'haṁ niyuktō'smīti jñātvā tat kurvvanti|</para>
  <para style="p">
    <verse number="18" style="v"/>kiṁ bahunā? kāpaṭyāt saralabhāvād vā bhavēt, yēna kēnacit prakārēṇa khrīṣṭasya ghōṣaṇā bhavatītyasmin aham ānandāmyānandiṣyāmi ca|</para>
  <para style="p">
    <verse number="19" style="v"/>yuṣmākaṁ prārthanayā yīśukhrīṣṭasyātmanaścōpakārēṇa tat mannistārajanakaṁ bhaviṣyatīti jānāmi|</para>
  <para style="p">
    <verse number="20" style="v"/>tatra ca mamākāṅkṣā pratyāśā ca siddhiṁ gamiṣyati phalatō'haṁ kēnāpi prakārēṇa na lajjiṣyē kintu gatē sarvvasmin kālē yadvat tadvad idānīmapi sampūrṇōtsāhadvārā mama śarīrēṇa khrīṣṭasya mahimā jīvanē maraṇē vā prakāśiṣyatē|</para>
  <para style="p">
    <verse number="21" style="v"/>yatō mama jīvanaṁ khrīṣṭāya maraṇañca lābhāya|</para>
  <para style="p">
    <verse number="22" style="v"/>kintu yadi śarīrē mayā jīvitavyaṁ tarhi tat karmmaphalaṁ phaliṣyati tasmāt kiṁ varitavyaṁ tanmayā na jñāyatē|</para>
  <para style="p">
    <verse number="23" style="v"/>dvābhyām ahaṁ sampīḍyē, dēhavāsatyajanāya khrīṣṭēna sahavāsāya ca mamābhilāṣō bhavati yatastat sarvvōttamaṁ|</para>
  <para style="p">
    <verse number="24" style="v"/>kintu dēhē mamāvasthityā yuṣmākam adhikaprayōjanaṁ|</para>
  <para style="p">
    <verse number="25" style="v"/>aham avasthāsyē yuṣmābhiḥ sarvvaiḥ sārddham avasthitiṁ kariṣyē ca tayā ca viśvāsē yuṣmākaṁ vr̥ddhyānandau janiṣyētē tadahaṁ niścitaṁ jānāmi|</para>
  <para style="p">
    <verse number="26" style="v"/>tēna ca mattō'rthatō yuṣmatsamīpē mama punarupasthitatvāt yūyaṁ khrīṣṭēna yīśunā bahutaram āhlādaṁ lapsyadhvē|</para>
  <para style="p">
    <verse number="27" style="v"/>yūyaṁ sāvadhānā bhūtvā khrīṣṭasya susaṁvādasyōpayuktam ācāraṁ kurudhvaṁ yatō'haṁ yuṣmān upāgatya sākṣāt kurvvan kiṁ vā dūrē tiṣṭhan yuṣmākaṁ yāṁ vārttāṁ śrōtum icchāmi sēyaṁ yūyam ēkātmānastiṣṭhatha, ēkamanasā susaṁvādasambandhīyaviśvāsasya pakṣē yatadhvē, vipakṣaiśca kēnāpi prakārēṇa na vyākulīkriyadhva iti|</para>
  <para style="p">
    <verse number="28" style="v"/>tat tēṣāṁ vināśasya lakṣaṇaṁ yuṣmākañcēśvaradattaṁ paritrāṇasya lakṣaṇaṁ bhaviṣyati|</para>
  <para style="p">
    <verse number="29" style="v"/>yatō yēna yuṣmābhiḥ khrīṣṭē kēvalaviśvāsaḥ kriyatē tannahi kintu tasya kr̥tē klēśō'pi sahyatē tādr̥śō varaḥ khrīṣṭasyānurōdhād yuṣmābhiḥ prāpi,</para>
  <para style="p">
    <verse number="30" style="v"/>tasmāt mama yādr̥śaṁ yuddhaṁ yuṣmābhiradarśi sāmprataṁ śrūyatē ca tādr̥śaṁ yuddhaṁ yuṣmākam api bhavati|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>khrīṣṭād yadi kimapi sāntvanaṁ kaścit prēmajātō harṣaḥ kiñcid ātmanaḥ samabhāgitvaṁ kācid anukampā kr̥pā vā jāyatē tarhi yūyaṁ mamāhlādaṁ pūrayanta</para>
  <para style="p">
    <verse number="2" style="v"/>ēkabhāvā ēkaprēmāṇa ēkamanasa ēkacēṣṭāśca bhavata|</para>
  <para style="p">
    <verse number="3" style="v"/>virōdhād darpād vā kimapi mā kuruta kintu namratayā svēbhyō'parān viśiṣṭān manyadhvaṁ|</para>
  <para style="p">
    <verse number="4" style="v"/>kēvalam ātmahitāya na cēṣṭamānāḥ parahitāyāpi cēṣṭadhvaṁ|</para>
  <para style="p">
    <verse number="5" style="v"/>khrīṣṭasya yīśō ryādr̥śaḥ svabhāvō yuṣmākam api tādr̥śō bhavatu|</para>
  <para style="p">
    <verse number="6" style="v"/>sa īśvararūpī san svakīyām īśvaratulyatāṁ ślāghāspadaṁ nāmanyata,</para>
  <para style="p">
    <verse number="7" style="v"/>kintu svaṁ śūnyaṁ kr̥tvā dāsarūpī babhūva narākr̥tiṁ lēbhē ca|</para>
  <para style="p">
    <verse number="8" style="v"/>itthaṁ naramūrttim āśritya namratāṁ svīkr̥tya mr̥tyōrarthataḥ kruśīyamr̥tyōrēva bhōgāyājñāgrāhī babhūva|</para>
  <para style="p">
    <verse number="9" style="v"/>tatkāraṇād īśvarō'pi taṁ sarvvōnnataṁ cakāra yacca nāma sarvvēṣāṁ nāmnāṁ śrēṣṭhaṁ tadēva tasmai dadau,</para>
  <para style="p">
    <verse number="10" style="v"/>tatastasmai yīśunāmnē svargamartyapātālasthitaiḥ sarvvai rjānupātaḥ karttavyaḥ,</para>
  <para style="p">
    <verse number="11" style="v"/>tātasthēśvarasya mahimnē ca yīśukhrīṣṭaḥ prabhuriti jihvābhiḥ svīkarttavyaṁ|</para>
  <para style="p">
    <verse number="12" style="v"/>atō hē priyatamāḥ, yuṣmābhi ryadvat sarvvadā kriyatē tadvat kēvalē mamōpasthitikālē tannahi kintvidānīm anupasthitē'pi mayi bahutarayatnēnājñāṁ gr̥hītvā bhayakampābhyāṁ svasvaparitrāṇaṁ sādhyatāṁ|</para>
  <para style="p">
    <verse number="13" style="v"/>yata īśvara ēva svakīyānurōdhād yuṣmanmadhyē manaskāmanāṁ karmmasiddhiñca vidadhāti|</para>
  <para style="p">
    <verse number="14" style="v"/>yūyaṁ kalahavivādarvijatam ācāraṁ kurvvantō'nindanīyā akuṭilā</para>
  <para style="p">
    <verse number="15" style="v"/>īśvarasya niṣkalaṅkāśca santānāiva vakrabhāvānāṁ kuṭilācāriṇāñca lōkānāṁ madhyē tiṣṭhata,</para>
  <para style="p">
    <verse number="16" style="v"/>yatastēṣāṁ madhyē yūyaṁ jīvanavākyaṁ dhārayantō jagatō dīpakā iva dīpyadhvē| yuṣmābhistathā kr̥tē mama yatnaḥ pariśramō vā na niṣphalō jāta ityahaṁ khrīṣṭasya dinē ślāghāṁ karttuṁ śakṣyāmi|</para>
  <para style="p">
    <verse number="17" style="v"/>yuṣmākaṁ viśvāsārthakāya balidānāya sēvanāya ca yadyapyahaṁ nivēditavyō bhavēyaṁ tathāpi tēnānandāmi sarvvēṣāṁ yuṣmākam ānandasyāṁśī bhavāmi ca|</para>
  <para style="p">
    <verse number="18" style="v"/>tadvad yūyamapyānandata madīyānandasyāṁśinō bhavata ca|</para>
  <para style="p">
    <verse number="19" style="v"/>yuṣmākam avasthām avagatyāhamapi yat sāntvanāṁ prāpnuyāṁ tadarthaṁ tīmathiyaṁ tvarayā yuṣmatsamīpaṁ prēṣayiṣyāmīti prabhau pratyāśāṁ kurvvē|</para>
  <para style="p">
    <verse number="20" style="v"/>yaḥ satyarūpēṇa yuṣmākaṁ hitaṁ cintayati tādr̥śa ēkabhāvastasmādanyaḥ kō'pi mama sannidhau nāsti|</para>
  <para style="p">
    <verse number="21" style="v"/>yatō'parē sarvvē yīśōḥ khrīṣṭasya viṣayān na cintayanta ātmaviṣayān cintayanti|</para>
  <para style="p">
    <verse number="22" style="v"/>kintu tasya parīkṣitatvaṁ yuṣmābhi rjñāyatē yataḥ putrō yādr̥k pituḥ sahakārī bhavati tathaiva susaṁvādasya paricaryyāyāṁ sa mama sahakārī jātaḥ|</para>
  <para style="p">
    <verse number="23" style="v"/>ataēva mama bhāvidaśāṁ jñātvā tatkṣaṇāt tamēva prēṣayituṁ pratyāśāṁ kurvvē</para>
  <para style="p">
    <verse number="24" style="v"/>svayam ahamapi tūrṇaṁ yuṣmatsamīpaṁ gamiṣyāmītyāśāṁ prabhunā kurvvē|</para>
  <para style="p">
    <verse number="25" style="v"/>aparaṁ ya ipāphradītō mama bhrātā karmmayuddhābhyāṁ mama sahāyaśca yuṣmākaṁ dūtō madīyōpakārāya pratinidhiścāsti yuṣmatsamīpē tasya prēṣaṇam āvaśyakam amanyē|</para>
  <para style="p">
    <verse number="26" style="v"/>yataḥ sa yuṣmān sarvvān akāṅkṣata yuṣmābhistasya rōgasya vārttāśrāvīti buddhvā paryyaśōcacca|</para>
  <para style="p">
    <verse number="27" style="v"/>sa pīḍayā mr̥takalpō'bhavaditi satyaṁ kintvīśvarastaṁ dayitavān mama ca duḥkhāt paraṁ punarduḥkhaṁ yanna bhavēt tadarthaṁ kēvalaṁ taṁ na dayitvā māmapi dayitavān|</para>
  <para style="p">
    <verse number="28" style="v"/>ataēva yūyaṁ taṁ vilōkya yat punarānandēta mamāpi duḥkhasya hrāsō yad bhavēt tadartham ahaṁ tvarayā tam aprēṣayaṁ|</para>
  <para style="p">
    <verse number="29" style="v"/>atō yūyaṁ prabhōḥ kr̥tē sampūrṇēnānandēna taṁ gr̥hlīta tādr̥śān lōkāṁścādaraṇīyān manyadhvaṁ|</para>
  <para style="p">
    <verse number="30" style="v"/>yatō mama sēvanē yuṣmākaṁ truṭiṁ pūrayituṁ sa prāṇān paṇīkr̥tya khrīṣṭasya kāryyārthaṁ mr̥taprāyē'bhavat|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>hē bhrātaraḥ, śēṣē vadāmi yūyaṁ prabhāvānandata| punaḥ punarēkasya vacō lēkhanaṁ mama klēśadaṁ nahi yuṣmadarthañca bhramanāśakaṁ bhavati|</para>
  <para style="p">
    <verse number="2" style="v"/>yūyaṁ kukkurēbhyaḥ sāvadhānā bhavata duṣkarmmakāribhyaḥ sāvadhānā bhavata chinnamūlēbhyō lōkēbhyaśca sāvadhānā bhavata|</para>
  <para style="p">
    <verse number="3" style="v"/>vayamēva chinnatvacō lōkā yatō vayam ātmanēśvaraṁ sēvāmahē khrīṣṭēna yīśunā ślāghāmahē śarīrēṇa ca pragalbhatāṁ na kurvvāmahē|</para>
  <para style="p">
    <verse number="4" style="v"/>kintu śarīrē mama pragalbhatāyāḥ kāraṇaṁ vidyatē, kaścid yadi śarīrēṇa pragalbhatāṁ cikīrṣati tarhi tasmād api mama pragalbhatāyā gurutaraṁ kāraṇaṁ vidyatē|</para>
  <para style="p">
    <verse number="5" style="v"/>yatō'ham aṣṭamadivasē tvakchēdaprāpta isrāyēlvaṁśīyō binyāmīnagōṣṭhīya ibrikulajāta ibriyō vyavasthācaraṇē phirūśī</para>
  <para style="p">
    <verse number="6" style="v"/>dharmmōtsāhakāraṇāt samitērupadravakārī vyavasthātō labhyē puṇyē cānindanīyaḥ|</para>
  <para style="p">
    <verse number="7" style="v"/>kintu mama yadyat labhyam āsīt tat sarvvam ahaṁ khrīṣṭasyānurōdhāt kṣatim amanyē|</para>
  <para style="p">
    <verse number="8" style="v"/>kiñcādhunāpyahaṁ matprabhōḥ khrīṣṭasya yīśō rjñānasyōtkr̥ṣṭatāṁ buddhvā tat sarvvaṁ kṣatiṁ manyē|</para>
  <para style="p">
    <verse number="9" style="v"/>yatō hētōrahaṁ yat khrīṣṭaṁ labhēya vyavasthātō jātaṁ svakīyapuṇyañca na dhārayan kintu khrīṣṭē viśvasanāt labhyaṁ yat puṇyam īśvarēṇa viśvāsaṁ dr̥ṣṭvā dīyatē tadēva dhārayan yat khrīṣṭē vidyēya tadarthaṁ tasyānurōdhāt sarvvēṣāṁ kṣatiṁ svīkr̥tya tāni sarvvāṇyavakarāniva manyē|</para>
  <para style="p">
    <verse number="10" style="v"/>yatō hētōrahaṁ khrīṣṭaṁ tasya punarutthitē rguṇaṁ tasya duḥkhānāṁ bhāgitvañca jñātvā tasya mr̥tyōrākr̥tiñca gr̥hītvā</para>
  <para style="p">
    <verse number="11" style="v"/>yēna kēnacit prakārēṇa mr̥tānāṁ punarutthitiṁ prāptuṁ yatē|</para>
  <para style="p">
    <verse number="12" style="v"/>mayā tat sarvvam adhunā prāpi siddhatā vālambhi tannahi kintu yadartham ahaṁ khrīṣṭēna dhāritastad dhārayituṁ dhāvāmi|</para>
  <para style="p">
    <verse number="13" style="v"/>hē bhrātaraḥ, mayā tad dhāritam iti na manyatē kintvētadaikamātraṁ vadāmi yāni paścāt sthitāni tāni vismr̥tyāham agrasthitānyuddiśya</para>
  <para style="p">
    <verse number="14" style="v"/>pūrṇayatnēna lakṣyaṁ prati dhāvan khrīṣṭayīśunōrddhvāt mām āhvayata īśvarāt jētr̥paṇaṁ prāptuṁ cēṣṭē|</para>
  <para style="p">
    <verse number="15" style="v"/>asmākaṁ madhyē yē siddhāstaiḥ sarvvaistadēva bhāvyatāṁ, yadi ca kañcana viṣayam adhi yuṣmākam aparō bhāvō bhavati tarhīśvarastamapi yuṣmākaṁ prati prakāśayiṣyati|</para>
  <para style="p">
    <verse number="16" style="v"/>kintu vayaṁ yadyad avagatā āsmastatrāsmābhirēkō vidhirācaritavya ēkabhāvai rbhavitavyañca|</para>
  <para style="p">
    <verse number="17" style="v"/>hē bhrātaraḥ, yūyaṁ mamānugāminō bhavata vayañca yādr̥gācaraṇasya nidarśanasvarūpā bhavāmastādr̥gācāriṇō lōkān ālōkayadhvaṁ|</para>
  <para style="p">
    <verse number="18" style="v"/>yatō'nēkē vipathē caranti tē ca khrīṣṭasya kruśasya śatrava iti purā mayā punaḥ punaḥ kathitam adhunāpi rudatā mayā kathyatē|</para>
  <para style="p">
    <verse number="19" style="v"/>tēṣāṁ śēṣadaśā sarvvanāśa udaraścēśvarō lajjā ca ślāghā pr̥thivyāñca lagnaṁ manaḥ|</para>
  <para style="p">
    <verse number="20" style="v"/>kintvasmākaṁ janapadaḥ svargē vidyatē tasmāccāgamiṣyantaṁ trātāraṁ prabhuṁ yīśukhrīṣṭaṁ vayaṁ pratīkṣāmahē|</para>
  <para style="p">
    <verse number="21" style="v"/>sa ca yayā śaktyā sarvvāṇyēva svasya vaśīkarttuṁ pārayati tayāsmākam adhamaṁ śarīraṁ rūpāntarīkr̥tya svakīyatējōmayaśarīrasya samākāraṁ kariṣyati|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>hē madīyānandamukuṭasvarūpāḥ priyatamā abhīṣṭatamā bhrātaraḥ, hē mama snēhapātrāḥ, yūyam itthaṁ pabhau sthirāstiṣṭhata|</para>
  <para style="p">
    <verse number="2" style="v"/>hē ivadiyē hē suntukhi yuvāṁ prabhau ēkabhāvē bhavatam ētad ahaṁ prārthayē|</para>
  <para style="p">
    <verse number="3" style="v"/>hē mama satya sahakārin tvāmapi vinīya vadāmi ētayōrupakārastvayā kriyatāṁ yatastē klīminādibhiḥ sahakāribhiḥ sārddhaṁ susaṁvādapracāraṇāya mama sāhāyyārthaṁ pariśramam akurvvatāṁ tēṣāṁ sarvvēṣāṁ nāmāni ca jīvanapustakē likhitāni vidyantē|</para>
  <para style="p">
    <verse number="4" style="v"/>yūyaṁ prabhau sarvvadānandata| puna rvadāmi yūyam ānandata|</para>
  <para style="p">
    <verse number="5" style="v"/>yuṣmākaṁ vinītatvaṁ sarvvamānavai rjñāyatāṁ, prabhuḥ sannidhau vidyatē|</para>
  <para style="p">
    <verse number="6" style="v"/>yūyaṁ kimapi na cintayata kintu dhanyavādayuktābhyāṁ prārthanāyāñcābhyāṁ sarvvaviṣayē svaprārthanīyam īśvarāya nivēdayata|</para>
  <para style="p">
    <verse number="7" style="v"/>tathā kr̥ta īśvarīyā yā śāntiḥ sarvvāṁ buddhim atiśētē sā yuṣmākaṁ cittāni manāṁsi ca khrīṣṭē yīśau rakṣiṣyati|</para>
  <para style="p">
    <verse number="8" style="v"/>hē bhrātaraḥ, śēṣē vadāmi yadyat satyam ādaraṇīyaṁ nyāyyaṁ sādhu priyaṁ sukhyātam anyēṇa yēna kēnacit prakārēṇa vā guṇayuktaṁ praśaṁsanīyaṁ vā bhavati tatraiva manāṁsi nidhadhvaṁ|</para>
  <para style="p">
    <verse number="9" style="v"/>yūyaṁ māṁ dr̥ṣṭvā śrutvā ca yadyat śikṣitavantō gr̥hītavantaśca tadēvācarata tasmāt śāntidāyaka īśvarō yuṣmābhiḥ sārddhaṁ sthāsyati|</para>
  <para style="p">
    <verse number="10" style="v"/>mamōpakārāya yuṣmākaṁ yā cintā pūrvvam āsīt kintu karmmadvāraṁ na prāpnōt idānīṁ sā punaraphalat ityasmin prabhau mama paramāhlādō'jāyata|</para>
  <para style="p">
    <verse number="11" style="v"/>ahaṁ yad dainyakāraṇād idaṁ vadāmi tannahi yatō mama yā kācid avasthā bhavēt tasyāṁ santōṣṭum aśikṣayaṁ|</para>
  <para style="p">
    <verse number="12" style="v"/>daridratāṁ bhōktuṁ śaknōmi dhanāḍhyatām api bhōktuṁ śaknōmi sarvvathā sarvvaviṣayēṣu vinītō'haṁ pracuratāṁ kṣudhāñca dhanaṁ dainyañcāvagatō'smi|</para>
  <para style="p">
    <verse number="13" style="v"/>mama śaktidāyakēna khrīṣṭēna sarvvamēva mayā śakyaṁ bhavati|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu yuṣmābhi rdainyanivāraṇāya mām upakr̥tya satkarmmākāri|</para>
  <para style="p">
    <verse number="15" style="v"/>hē philipīyalōkāḥ, susaṁvādasyōdayakālē yadāhaṁ mākidaniyādēśāt pratiṣṭhē tadā kēvalān yuṣmān vināparayā kayāpi samityā saha dānādānayō rmama kō'pi sambandhō nāsīd iti yūyamapi jānītha|</para>
  <para style="p">
    <verse number="16" style="v"/>yatō yuṣmābhi rmama prayōjanāya thiṣalanīkīnagaramapi māṁ prati punaḥ punardānaṁ prēṣitaṁ|</para>
  <para style="p">
    <verse number="17" style="v"/>ahaṁ yad dānaṁ mr̥gayē tannahi kintu yuṣmākaṁ lābhavarddhakaṁ phalaṁ mr̥gayē|</para>
  <para style="p">
    <verse number="18" style="v"/>kintu mama kasyāpyabhāvō nāsti sarvvaṁ pracuram āstē yata īśvarasya grāhyaṁ tuṣṭijanakaṁ sugandhinaivēdyasvarūpaṁ yuṣmākaṁ dānaṁ ipāphraditād gr̥hītvāhaṁ paritr̥ptō'smi|</para>
  <para style="p">
    <verse number="19" style="v"/>mamēśvarō'pi khrīṣṭēna yīśunā svakīyavibhavanidhitaḥ prayōjanīyaṁ sarvvaviṣayaṁ pūrṇarūpaṁ yuṣmabhyaṁ dēyāt|</para>
  <para style="p">
    <verse number="20" style="v"/>asmākaṁ piturīśvarasya dhanyavādō'nantakālaṁ yāvad bhavatu| āmēn|</para>
  <para style="p">
    <verse number="21" style="v"/>yūyaṁ yīśukhrīṣṭasyaikaikaṁ pavitrajanaṁ namaskuruta| mama saṅgibhrātarō yūṣmān namaskurvvatē|</para>
  <para style="p">
    <verse number="22" style="v"/>sarvvē pavitralōkā viśēṣataḥ kaisarasya parijanā yuṣmān namaskurvvatē|</para>
  <para style="p">
    <verse number="23" style="v"/>asmākaṁ prabhō ryīśukhrīṣṭasya prasādaḥ sarvvān yuṣmān prati bhūyāt| āmēn|</para>
</usx>
