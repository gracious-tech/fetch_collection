<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="HEB" style="id">Sanskrit Bible (NT) in ISO Script (satyavēdaḥ ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Hebrews</para>
  <para style="toc1">ibriṇaḥ patraṁ</para>
  <para style="toc2">ibriṇaḥ</para>
  <para style="toc3">ibriṇaḥ</para>
  <para style="mt1">ibriṇaḥ patraṁ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>purā ya īśvarō bhaviṣyadvādibhiḥ pitr̥lōkēbhyō nānāsamayē nānāprakāraṁ kathitavān</para>
  <para style="p">
    <verse number="2" style="v"/>sa ētasmin śēṣakālē nijaputrēṇāsmabhyaṁ kathitavān| sa taṁ putraṁ sarvvādhikāriṇaṁ kr̥tavān tēnaiva ca sarvvajaganti sr̥ṣṭavān|</para>
  <para style="p">
    <verse number="3" style="v"/>sa putrastasya prabhāvasya pratibimbastasya tattvasya mūrttiścāsti svīyaśaktivākyēna sarvvaṁ dhattē ca svaprāṇairasmākaṁ pāpamārjjanaṁ kr̥tvā ūrddhvasthānē mahāmahimnō dakṣiṇapārśvē samupaviṣṭavān|</para>
  <para style="p">
    <verse number="4" style="v"/>divyadūtagaṇād yathā sa viśiṣṭanāmnō 'dhikārī jātastathā tēbhyō'pi śrēṣṭhō jātaḥ|</para>
  <para style="p">
    <verse number="5" style="v"/>yatō dūtānāṁ madhyē kadācidīśvarēṇēdaṁ ka uktaḥ? yathā, "madīyatanayō 'si tvam adyaiva janitō mayā|" punaśca "ahaṁ tasya pitā bhaviṣyāmi sa ca mama putrō bhaviṣyati|"</para>
  <para style="p">
    <verse number="6" style="v"/>aparaṁ jagati svakīyādvitīyaputrasya punarānayanakālē tēnōktaṁ, yathā, "īśvarasya sakalai rdūtairēṣa ēva praṇamyatāṁ|"</para>
  <para style="p">
    <verse number="7" style="v"/>dūtān adhi tēnēdam uktaṁ, yathā, "sa karōti nijān dūtān gandhavāhasvarūpakān| vahniśikhāsvarūpāṁśca karōti nijasēvakān||"</para>
  <para style="p">
    <verse number="8" style="v"/>kintu putramuddiśya tēnōktaṁ, yathā, "hē īśvara sadā sthāyi tava siṁhāsanaṁ bhavēt| yāthārthyasya bhavēddaṇḍō rājadaṇḍastvadīyakaḥ|</para>
  <para style="p">
    <verse number="9" style="v"/>puṇyē prēma karōṣi tvaṁ kiñcādharmmam r̥tīyasē| tasmād ya īśa īśastē sa tē mitragaṇādapi| adhikāhlādatailēna sēcanaṁ kr̥tavān tava||"</para>
  <para style="p">
    <verse number="10" style="v"/>punaśca, yathā, "hē prabhō pr̥thivīmūlam ādau saṁsthāpitaṁ tvayā| tathā tvadīyahastēna kr̥taṁ gaganamaṇḍalaṁ|</para>
  <para style="p">
    <verse number="11" style="v"/>imē vinaṁkṣyatastvantu nityamēvāvatiṣṭhasē| idantu sakalaṁ viśvaṁ saṁjariṣyati vastravat|</para>
  <para style="p">
    <verse number="12" style="v"/>saṅkōcitaṁ tvayā tattu vastravat parivartsyatē| tvantu nityaṁ sa ēvāsī rnirantāstava vatsarāḥ||"</para>
  <para style="p">
    <verse number="13" style="v"/>aparaṁ dūtānāṁ madhyē kaḥ kadācidīśvarēṇēdamuktaḥ? yathā, "tavārīn pādapīṭhaṁ tē yāvannahi karōmyahaṁ| mama dakṣiṇadigbhāgē tāvat tvaṁ samupāviśa||"</para>
  <para style="p">
    <verse number="14" style="v"/>yē paritrāṇasyādhikāriṇō bhaviṣyanti tēṣāṁ paricaryyārthaṁ prēṣyamāṇāḥ sēvanakāriṇa ātmānaḥ kiṁ tē sarvvē dūtā nahi?</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>atō vayaṁ yad bhramasrōtasā nāpanīyāmahē tadarthamasmābhi ryadyad aśrāvi tasmin manāṁsi nidhātavyāni|</para>
  <para style="p">
    <verse number="2" style="v"/>yatō hētō dūtaiḥ kathitaṁ vākyaṁ yadyamōgham abhavad yadi ca tallaṅghanakāriṇē tasyāgrāhakāya ca sarvvasmai samucitaṁ daṇḍam adīyata,</para>
  <para style="p">
    <verse number="3" style="v"/>tarhyasmābhistādr̥śaṁ mahāparitrāṇam avajñāya kathaṁ rakṣā prāpsyatē, yat prathamataḥ prabhunā prōktaṁ tatō'smān yāvat tasya śrōtr̥bhiḥ sthirīkr̥taṁ,</para>
  <para style="p">
    <verse number="4" style="v"/>aparaṁ lakṣaṇairadbhutakarmmabhi rvividhaśaktiprakāśēna nijēcchātaḥ pavitrasyātmanō vibhāgēna ca yad īśvarēṇa pramāṇīkr̥tam abhūt|</para>
  <para style="p">
    <verse number="5" style="v"/>vayaṁ tu yasya bhāvirājyasya kathāṁ kathayāmaḥ, tat tēn divyadūtānām adhīnīkr̥tamiti nahi|</para>
  <para style="p">
    <verse number="6" style="v"/>kintu kutrāpi kaścit pramāṇam īdr̥śaṁ dattavān, yathā, "kiṁ vastu mānavō yat sa nityaṁ saṁsmaryyatē tvayā| kiṁ vā mānavasantānō yat sa ālōcyatē tvayā|</para>
  <para style="p">
    <verse number="7" style="v"/>divyadatagaṇēbhyaḥ sa kiñcin nyūnaḥ kr̥tastvayā| tējōgauravarūpēṇa kirīṭēna vibhūṣitaḥ| sr̥ṣṭaṁ yat tē karābhyāṁ sa tatprabhutvē niyōjitaḥ|</para>
  <para style="p">
    <verse number="8" style="v"/>caraṇādhaśca tasyaiva tvayā sarvvaṁ vaśīkr̥taṁ||" tēna sarvvaṁ yasya vaśīkr̥taṁ tasyāvaśībhūtaṁ kimapi nāvaśēṣitaṁ kintvadhunāpi vayaṁ sarvvāṇi tasya vaśībhūtāni na paśyāmaḥ|</para>
  <para style="p">
    <verse number="9" style="v"/>tathāpi divyadūtagaṇēbhyō yaḥ kiñcin nyūnīkr̥tō'bhavat taṁ yīśuṁ mr̥tyubhōgahētōstējōgauravarūpēṇa kirīṭēna vibhūṣitaṁ paśyāmaḥ, yata īśvarasyānugrahāt sa sarvvēṣāṁ kr̥tē mr̥tyum asvadata|</para>
  <para style="p">
    <verse number="10" style="v"/>aparañca yasmai yēna ca kr̥tsnaṁ vastu sr̥ṣṭaṁ vidyatē bahusantānānāṁ vibhavāyānayanakālē tēṣāṁ paritrāṇāgrasarasya duḥkhabhōgēna siddhīkaraṇamapi tasyōpayuktam abhavat|</para>
  <para style="p">
    <verse number="11" style="v"/>yataḥ pāvakaḥ pūyamānāśca sarvvē ēkasmādēvōtpannā bhavanti, iti hētōḥ sa tān bhrātr̥n vadituṁ na lajjatē|</para>
  <para style="p">
    <verse number="12" style="v"/>tēna sa uktavān, yathā, "dyōtayiṣyāmi tē nāma bhrātr̥ṇāṁ madhyatō mama| parantu samitē rmadhyē kariṣyē tē praśaṁsanaṁ||"</para>
  <para style="p">
    <verse number="13" style="v"/>punarapi, yathā, "tasmin viśvasya sthātāhaṁ|" punarapi, yathā, "paśyāham apatyāni ca dattāni mahyam īśvarāt|"</para>
  <para style="p">
    <verse number="14" style="v"/>tēṣām apatyānāṁ rudhirapalalaviśiṣṭatvāt sō'pi tadvat tadviśiṣṭō'bhūt tasyābhiprāyō'yaṁ yat sa mr̥tyubalādhikāriṇaṁ śayatānaṁ mr̥tyunā balahīnaṁ kuryyāt</para>
  <para style="p">
    <verse number="15" style="v"/>yē ca mr̥tyubhayād yāvajjīvanaṁ dāsatvasya nighnā āsan tān uddhārayēt|</para>
  <para style="p">
    <verse number="16" style="v"/>sa dūtānām upakārī na bhavati kintvibrāhīmō vaṁśasyaivōpakārī bhavatī|</para>
  <para style="p">
    <verse number="17" style="v"/>atō hētōḥ sa yathā kr̥pāvān prajānāṁ pāpaśōdhanārtham īśvarōddēśyaviṣayē viśvāsyō mahāyājakō bhavēt tadarthaṁ sarvvaviṣayē svabhrātr̥ṇāṁ sadr̥śībhavanaṁ tasyōcitam āsīt|</para>
  <para style="p">
    <verse number="18" style="v"/>yataḥ sa svayaṁ parīkṣāṁ gatvā yaṁ duḥkhabhōgam avagatastēna parīkṣākrāntān upakarttuṁ śaknōti|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>hē svargīyasyāhvānasya sahabhāginaḥ pavitrabhrātaraḥ, asmākaṁ dharmmapratijñāyā dūtō'grasaraśca yō yīśustam ālōcadhvaṁ|</para>
  <para style="p">
    <verse number="2" style="v"/>mūsā yadvat tasya sarvvaparivāramadhyē viśvāsya āsīt, tadvat ayamapi svaniyōjakasya samīpē viśvāsyō bhavati|</para>
  <para style="p">
    <verse number="3" style="v"/>parivārācca yadvat tatsthāpayituradhikaṁ gauravaṁ bhavati tadvat mūsasō'yaṁ bahutaragauravasya yōgyō bhavati|</para>
  <para style="p">
    <verse number="4" style="v"/>ēkaikasya nivēśanasya parijanānāṁ sthāpayitā kaścid vidyatē yaśca sarvvasthāpayitā sa īśvara ēva|</para>
  <para style="p">
    <verse number="5" style="v"/>mūsāśca vakṣyamāṇānāṁ sākṣī bhr̥tya iva tasya sarvvaparijanamadhyē viśvāsyō'bhavat kintu khrīṣṭastasya parijanānāmadhyakṣa iva|</para>
  <para style="p">
    <verse number="6" style="v"/>vayaṁ tu yadi viśvāsasyōtsāhaṁ ślāghanañca śēṣaṁ yāvad dhārayāmastarhi tasya parijanā bhavāmaḥ|</para>
  <para style="p">
    <verse number="7" style="v"/>atō hētōḥ pavitrēṇātmanā yadvat kathitaṁ, tadvat, "adya yūyaṁ kathāṁ tasya yadi saṁśrōtumicchatha|</para>
  <para style="p">
    <verse number="8" style="v"/>tarhi purā parīkṣāyā dinē prāntaramadhyataḥ| madājñānigrahasthānē yuṣmābhistu kr̥taṁ yathā| tathā mā kurutēdānīṁ kaṭhināni manāṁsi vaḥ|</para>
  <para style="p">
    <verse number="9" style="v"/>yuṣmākaṁ pitarastatra matparīkṣām akurvvata| kurvvadbhi rmē'nusandhānaṁ tairadr̥śyanta matkriyāḥ| catvāriṁśatsamā yāvat kruddhvāhantu tadanvayē|</para>
  <para style="p">
    <verse number="10" style="v"/>avādiṣam imē lōkā bhrāntāntaḥkaraṇāḥ sadā| māmakīnāni vartmāni parijānanti nō imē|</para>
  <para style="p">
    <verse number="11" style="v"/>iti hētōrahaṁ kōpāt śapathaṁ kr̥tavān imaṁ| prēvēkṣyatē janairētai rna viśrāmasthalaṁ mama||"</para>
  <para style="p">
    <verse number="12" style="v"/>hē bhrātaraḥ sāvadhānā bhavata, amarēśvarāt nivarttakō yō'viśvāsastadyuktaṁ duṣṭāntaḥkaraṇaṁ yuṣmākaṁ kasyāpi na bhavatu|</para>
  <para style="p">
    <verse number="13" style="v"/>kintu yāvad adyanāmā samayō vidyatē tāvad yuṣmanmadhyē kō'pi pāpasya vañcanayā yat kaṭhōrīkr̥tō na bhavēt tadarthaṁ pratidinaṁ parasparam upadiśata|</para>
  <para style="p">
    <verse number="14" style="v"/>yatō vayaṁ khrīṣṭasyāṁśinō jātāḥ kintu prathamaviśvāsasya dr̥ḍhatvam asmābhiḥ śēṣaṁ yāvad amōghaṁ dhārayitavyaṁ|</para>
  <para style="p">
    <verse number="15" style="v"/>adya yūyaṁ kathāṁ tasya yadi saṁśrōtumicchatha, tarhyājñālaṅghanasthānē yuṣmābhistu kr̥taṁ yathā, tathā mā kurutēdānīṁ kaṭhināni manāṁsi va iti tēna yaduktaṁ,</para>
  <para style="p">
    <verse number="16" style="v"/>tadanusārād yē śrutvā tasya kathāṁ na gr̥hītavantastē kē? kiṁ mūsasā misaradēśād āgatāḥ sarvvē lōkā nahi?</para>
  <para style="p">
    <verse number="17" style="v"/>kēbhyō vā sa catvāriṁśadvarṣāṇi yāvad akrudhyat? pāpaṁ kurvvatāṁ yēṣāṁ kuṇapāḥ prāntarē 'patan kiṁ tēbhyō nahi?</para>
  <para style="p">
    <verse number="18" style="v"/>pravēkṣyatē janairētai rna viśrāmasthalaṁ mamēti śapathaḥ kēṣāṁ viruddhaṁ tēnākāri? kim aviśvāsināṁ viruddhaṁ nahi?</para>
  <para style="p">
    <verse number="19" style="v"/>atastē tat sthānaṁ pravēṣṭum aviśvāsāt nāśaknuvan iti vayaṁ vīkṣāmahē|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>aparaṁ tadviśrāmaprāptēḥ pratijñā yadi tiṣṭhati tarhyasmākaṁ kaścit cēt tasyāḥ phalēna vañcitō bhavēt vayam ētasmād bibhīmaḥ|</para>
  <para style="p">
    <verse number="2" style="v"/>yatō 'smākaṁ samīpē yadvat tadvat tēṣāṁ samīpē'pi susaṁvādaḥ pracāritō 'bhavat kintu taiḥ śrutaṁ vākyaṁ tān prati niṣphalam abhavat, yatastē śrōtārō viśvāsēna sārddhaṁ tannāmiśrayan|</para>
  <para style="p">
    <verse number="3" style="v"/>tad viśrāmasthānaṁ viśvāsibhirasmābhiḥ praviśyatē yatastēnōktaṁ, "ahaṁ kōpāt śapathaṁ kr̥tavān imaṁ, pravēkṣyatē janairētai rna viśrāmasthalaṁ mama|" kintu tasya karmmāṇi jagataḥ sr̥ṣṭikālāt samāptāni santi|</para>
  <para style="p">
    <verse number="4" style="v"/>yataḥ kasmiṁścit sthānē saptamaṁ dinamadhi tēnēdam uktaṁ, yathā, "īśvaraḥ saptamē dinē svakr̥tēbhyaḥ sarvvakarmmabhyō viśaśrāma|"</para>
  <para style="p">
    <verse number="5" style="v"/>kintvētasmin sthānē punastēnōcyatē, yathā, "pravēkṣyatē janairētai rna viśrāmasthalaṁ mama|"</para>
  <para style="p">
    <verse number="6" style="v"/>phalatastat sthānaṁ kaiścit pravēṣṭavyaṁ kintu yē purā susaṁvādaṁ śrutavantastairaviśvāsāt tanna praviṣṭam,</para>
  <para style="p">
    <verse number="7" style="v"/>iti hētōḥ sa punaradyanāmakaṁ dinaṁ nirūpya dīrghakālē gatē'pi pūrvvōktāṁ vācaṁ dāyūdā kathayati, yathā, "adya yūyaṁ kathāṁ tasya yadi saṁśrōtumicchatha, tarhi mā kurutēdānīṁ kaṭhināni manāṁsi vaḥ|"</para>
  <para style="p">
    <verse number="8" style="v"/>aparaṁ yihōśūyō yadi tān vyaśrāmayiṣyat tarhi tataḥ param aparasya dinasya vāg īśvarēṇa nākathayiṣyata|</para>
  <para style="p">
    <verse number="9" style="v"/>ata īśvarasya prajābhiḥ karttavya ēkō viśrāmastiṣṭhati|</para>
  <para style="p">
    <verse number="10" style="v"/>aparam īśvarō yadvat svakr̥takarmmabhyō viśaśrāma tadvat tasya viśrāmasthānaṁ praviṣṭō janō'pi svakr̥takarmmabhyō viśrāmyati|</para>
  <para style="p">
    <verse number="11" style="v"/>atō vayaṁ tad viśrāmasthānaṁ pravēṣṭuṁ yatāmahai, tadaviśvāsōdāharaṇēna kō'pi na patatu|</para>
  <para style="p">
    <verse number="12" style="v"/>īśvarasya vādō'maraḥ prabhāvaviśiṣṭaśca sarvvasmād dvidhārakhaṅgādapi tīkṣṇaḥ, aparaṁ prāṇātmanō rgranthimajjayōśca paribhēdāya vicchēdakārī manasaśca saṅkalpānām abhiprētānāñca vicārakaḥ|</para>
  <para style="p">
    <verse number="13" style="v"/>aparaṁ yasya samīpē svīyā svīyā kathāsmābhiḥ kathayitavyā tasyāgōcaraḥ kō'pi prāṇī nāsti tasya dr̥ṣṭau sarvvamēvānāvr̥taṁ prakāśitañcāstē|</para>
  <para style="p">
    <verse number="14" style="v"/>aparaṁ ya uccatamaṁ svargaṁ praviṣṭa ētādr̥śa ēkō vyaktirarthata īśvarasya putrō yīśurasmākaṁ mahāyājakō'sti, atō hētō rvayaṁ dharmmapratijñāṁ dr̥ḍham ālambāmahai|</para>
  <para style="p">
    <verse number="15" style="v"/>asmākaṁ yō mahāyājakō 'sti sō'smākaṁ duḥkhai rduḥkhitō bhavitum aśaktō nahi kintu pāpaṁ vinā sarvvaviṣayē vayamiva parīkṣitaḥ|</para>
  <para style="p">
    <verse number="16" style="v"/>ataēva kr̥pāṁ grahītuṁ prayōjanīyōpakārārtham anugrahaṁ prāptuñca vayam utsāhēnānugrahasiṁhāsanasya samīpaṁ yāmaḥ|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yaḥ kaścit mahāyājakō bhavati sa mānavānāṁ madhyāt nītaḥ san mānavānāṁ kr̥ta īśvarōddēśyaviṣayē'rthata upahārāṇāṁ pāpārthakabalīnāñca dāna niyujyatē|</para>
  <para style="p">
    <verse number="2" style="v"/>sa cājñānāṁ bhrāntānāñca lōkānāṁ duḥkhēna duḥkhī bhavituṁ śaknōti, yatō hētōḥ sa svayamapi daurbbalyavēṣṭitō bhavati|</para>
  <para style="p">
    <verse number="3" style="v"/>ētasmāt kāraṇācca yadvat lōkānāṁ kr̥tē tadvad ātmakr̥tē'pi pāpārthakabalidānaṁ tēna karttavyaṁ|</para>
  <para style="p">
    <verse number="4" style="v"/>sa ghōccapadaḥ svēcchātaḥ kēnāpi na gr̥hyatē kintu hārōṇa iva ya īśvarēṇāhūyatē tēnaiva gr̥hyatē|</para>
  <para style="p">
    <verse number="5" style="v"/>ēvamprakārēṇa khrīṣṭō'pi mahāyājakatvaṁ grahītuṁ svīyagauravaṁ svayaṁ na kr̥tavān, kintu "madīyatanayō'si tvam adyaiva janitō mayēti" vācaṁ yastaṁ bhāṣitavān sa ēva tasya gauravaṁ kr̥tavān|</para>
  <para style="p">
    <verse number="6" style="v"/>tadvad anyagītē'pīdamuktaṁ, tvaṁ malkīṣēdakaḥ śrēṇyāṁ yājakō'si sadātanaḥ|</para>
  <para style="p">
    <verse number="7" style="v"/>sa ca dēhavāsakālē bahukrandanēnāśrupātēna ca mr̥tyuta uddharaṇē samarthasya pituḥ samīpē punaḥ punarvinatiṁ prarthanāñca kr̥tvā tatphalarūpiṇīṁ śaṅkātō rakṣāṁ prāpya ca</para>
  <para style="p">
    <verse number="8" style="v"/>yadyapi putrō'bhavat tathāpi yairakliśyata tairājñāgrahaṇam aśikṣata|</para>
  <para style="p">
    <verse number="9" style="v"/>itthaṁ siddhībhūya nijājñāgrāhiṇāṁ sarvvēṣām anantaparitrāṇasya kāraṇasvarūpō 'bhavat|</para>
  <para style="p">
    <verse number="10" style="v"/>tasmāt sa malkīṣēdakaḥ śrēṇībhuktō mahāyājaka īśvarēṇākhyātaḥ|</para>
  <para style="p">
    <verse number="11" style="v"/>tamadhyasmākaṁ bahukathāḥ kathayitavyāḥ kintu tāḥ stabdhakarṇai ryuṣmābhi rdurgamyāḥ|</para>
  <para style="p">
    <verse number="12" style="v"/>yatō yūyaṁ yadyapi samayasya dīrghatvāt śikṣakā bhavitum aśakṣyata tathāpīśvarasya vākyānāṁ yā prathamā varṇamālā tāmadhi śikṣāprāpti ryuṣmākaṁ punarāvaśyakā bhavati, tathā kaṭhinadravyē nahi kintu dugdhē yuṣmākaṁ prayōjanam āstē|</para>
  <para style="p">
    <verse number="13" style="v"/>yō dugdhapāyī sa śiśurēvētikāraṇāt dharmmavākyē tatparō nāsti|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu sadasadvicārē yēṣāṁ cētāṁsi vyavahārēṇa śikṣitāni tādr̥śānāṁ siddhalōkānāṁ kaṭhōradravyēṣu prayōjanamasti|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>vayaṁ mr̥tijanakakarmmabhyō manaḥparāvarttanam īśvarē viśvāsō majjanaśikṣaṇaṁ hastārpaṇaṁ mr̥talōkānām utthānam</para>
  <para style="p">
    <verse number="2" style="v"/>anantakālasthāyivicārājñā caitaiḥ punarbhittimūlaṁ na sthāpayantaḥ khrīṣṭaviṣayakaṁ prathamōpadēśaṁ paścātkr̥tya siddhiṁ yāvad agrasarā bhavāma|</para>
  <para style="p">
    <verse number="3" style="v"/>īśvarasyānumatyā ca tad asmābhiḥ kāriṣyatē|</para>
  <para style="p">
    <verse number="4" style="v"/>ya ēkakr̥tvō dīptimayā bhūtvā svargīyavararasam āsvaditavantaḥ pavitrasyātmanō'ṁśinō jātā</para>
  <para style="p">
    <verse number="5" style="v"/>īśvarasya suvākyaṁ bhāvikālasya śaktiñcāsvaditavantaśca tē bhraṣṭvā yadi</para>
  <para style="p">
    <verse number="6" style="v"/>svamanōbhirīśvarasya putraṁ punaḥ kruśē ghnanti lajjāspadaṁ kurvvatē ca tarhi manaḥparāvarttanāya punastān navīnīkarttuṁ kō'pi na śaknōti|</para>
  <para style="p">
    <verse number="7" style="v"/>yatō yā bhūmiḥ svōpari bhūyaḥ patitaṁ vr̥ṣṭiṁ pivatī tatphalādhikāriṇāṁ nimittam iṣṭāni śākādīnyutpādayati sā īśvarād āśiṣaṁ prāptā|</para>
  <para style="p">
    <verse number="8" style="v"/>kintu yā bhūmi rgōkṣurakaṇṭakavr̥kṣān utpādayati sā na grāhyā śāpārhā ca śēṣē tasyā dāhō bhaviṣyati|</para>
  <para style="p">
    <verse number="9" style="v"/>hē priyatamāḥ, yadyapi vayam ētādr̥śaṁ vākyaṁ bhāṣāmahē tathāpi yūyaṁ tata utkr̥ṣṭāḥ paritrāṇapathasya pathikāścādhva iti viśvasāmaḥ|</para>
  <para style="p">
    <verse number="10" style="v"/>yatō yuṣmābhiḥ pavitralōkānāṁ ya upakārō 'kāri kriyatē ca tēnēśvarasya nāmnē prakāśitaṁ prēma śramañca vismarttum īśvarō'nyāyakārī na bhavati|</para>
  <para style="p">
    <verse number="11" style="v"/>aparaṁ yuṣmākam ēkaikō janō yat pratyāśāpūraṇārthaṁ śēṣaṁ yāvat tamēva yatnaṁ prakāśayēdityaham icchāmi|</para>
  <para style="p">
    <verse number="12" style="v"/>ataḥ śithilā na bhavata kintu yē viśvāsēna sahiṣṇutayā ca pratijñānāṁ phalādhikāriṇō jātāstēṣām anugāminō bhavata|</para>
  <para style="p">
    <verse number="13" style="v"/>īśvarō yadā ibrāhīmē pratyajānāt tadā śrēṣṭhasya kasyāpyaparasya nāmnā śapathaṁ karttuṁ nāśaknōt, atō hētōḥ svanāmnā śapathaṁ kr̥tvā tēnōktaṁ yathā,</para>
  <para style="p">
    <verse number="14" style="v"/>"satyam ahaṁ tvām āśiṣaṁ gadiṣyāmi tavānvayaṁ varddhayiṣyāmi ca|"</para>
  <para style="p">
    <verse number="15" style="v"/>anēna prakārēṇa sa sahiṣṇutāṁ vidhāya tasyāḥ pratyāśāyāḥ phalaṁ labdhavān|</para>
  <para style="p">
    <verse number="16" style="v"/>atha mānavāḥ śrēṣṭhasya kasyacit nāmnā śapantē, śapathaśca pramāṇārthaṁ tēṣāṁ sarvvavivādāntakō bhavati|</para>
  <para style="p">
    <verse number="17" style="v"/>ityasmin īśvaraḥ pratijñāyāḥ phalādhikāriṇaḥ svīyamantraṇāyā amōghatāṁ bāhulyatō darśayitumicchan śapathēna svapratijñāṁ sthirīkr̥tavān|</para>
  <para style="p">
    <verse number="18" style="v"/>ataēva yasmin anr̥takathanam īśvarasya na sādhyaṁ tādr̥śēnācalēna viṣayadvayēna sammukhastharakṣāsthalasya prāptayē palāyitānām asmākaṁ sudr̥ḍhā sāntvanā jāyatē|</para>
  <para style="p">
    <verse number="19" style="v"/>sā pratyāśāsmākaṁ manōnaukāyā acalō laṅgarō bhūtvā vicchēdakavastrasyābhyantaraṁ praviṣṭā|</para>
  <para style="p">
    <verse number="20" style="v"/>tatraivāsmākam agrasarō yīśuḥ praviśya malkīṣēdakaḥ śrēṇyāṁ nityasthāyī yājakō'bhavat|</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>śālamasya rājā sarvvōparisthasyēśvarasya yājakaśca san yō nr̥patīnāṁ māraṇāt pratyāgatam ibrāhīmaṁ sākṣātkr̥tyāśiṣaṁ gaditavān,</para>
  <para style="p">
    <verse number="2" style="v"/>yasmai cēbrāhīm sarvvadravyāṇāṁ daśamāṁśaṁ dattavān sa malkīṣēdak svanāmnō'rthēna prathamatō dharmmarājaḥ paścāt śālamasya rājārthataḥ śāntirājō bhavati|</para>
  <para style="p">
    <verse number="3" style="v"/>aparaṁ tasya pitā mātā vaṁśasya nirṇaya āyuṣa ārambhō jīvanasya śēṣaścaitēṣām abhāvō bhavati, itthaṁ sa īśvaraputrasya sadr̥śīkr̥taḥ, sa tvanantakālaṁ yāvad yājakastiṣṭhati|</para>
  <para style="p">
    <verse number="4" style="v"/>ataēvāsmākaṁ pūrvvapuruṣa ibrāhīm yasmai luṭhitadravyāṇāṁ daśamāṁśaṁ dattavān sa kīdr̥k mahān tad ālōcayata|</para>
  <para style="p">
    <verse number="5" style="v"/>yājakatvaprāptā lēvēḥ santānā vyavasthānusārēṇa lōkēbhyō'rthata ibrāhīmō jātēbhyaḥ svīyabhrātr̥bhyō daśamāṁśagrahaṇasyādēśaṁ labdhavantaḥ|</para>
  <para style="p">
    <verse number="6" style="v"/>kintvasau yadyapi tēṣāṁ vaṁśāt nōtpannastathāpībrāhīmō daśamāṁśaṁ gr̥hītavān pratijñānām adhikāriṇam āśiṣaṁ gaditavāṁśca|</para>
  <para style="p">
    <verse number="7" style="v"/>aparaṁ yaḥ śrēyān sa kṣudratarāyāśiṣaṁ dadātītyatra kō'pi sandēhō nāsti|</para>
  <para style="p">
    <verse number="8" style="v"/>aparam idānīṁ yē daśamāṁśaṁ gr̥hlanti tē mr̥tyōradhīnā mānavāḥ kintu tadānīṁ yō gr̥hītavān sa jīvatītipramāṇaprāptaḥ|</para>
  <para style="p">
    <verse number="9" style="v"/>aparaṁ daśamāṁśagrāhī lēvirapībrāhīmdvārā daśamāṁśaṁ dattavān ētadapi kathayituṁ śakyatē|</para>
  <para style="p">
    <verse number="10" style="v"/>yatō yadā malkīṣēdak tasya pitaraṁ sākṣāt kr̥tavān tadānīṁ sa lēviḥ pitururasyāsīt|</para>
  <para style="p">
    <verse number="11" style="v"/>aparaṁ yasya sambandhē lōkā vyavasthāṁ labdhavantastēna lēvīyayājakavargēṇa yadi siddhiḥ samabhaviṣyat tarhi hārōṇasya śrēṇyā madhyād yājakaṁ na nirūpyēśvarēṇa malkīṣēdakaḥ śrēṇyā madhyād aparasyaikasya yājakasyōtthāpanaṁ kuta āvaśyakam abhaviṣyat?</para>
  <para style="p">
    <verse number="12" style="v"/>yatō yājakavargasya vinimayēna sutarāṁ vyavasthāyā api vinimayō jāyatē|</para>
  <para style="p">
    <verse number="13" style="v"/>aparañca tad vākyaṁ yasyōddēśyaṁ sō'parēṇa vaṁśēna saṁyuktā'sti tasya vaṁśasya ca kō'pi kadāpi vēdyāḥ karmma na kr̥tavān|</para>
  <para style="p">
    <verse number="14" style="v"/>vastutastu yaṁ vaṁśamadhi mūsā yājakatvasyaikāṁ kathāmapi na kathitavān tasmin yihūdāvaṁśē'smākaṁ prabhu rjanma gr̥hītavān iti suspaṣṭaṁ|</para>
  <para style="p">
    <verse number="15" style="v"/>tasya spaṣṭataram aparaṁ pramāṇamidaṁ yat malkīṣēdakaḥ sādr̥śyavatāparēṇa tādr̥śēna yājakēnōdētavyaṁ,</para>
  <para style="p">
    <verse number="16" style="v"/>yasya nirūpaṇaṁ śarīrasambandhīyavidhiyuktayā vyavasthāyā na bhavati kintvakṣayajīvanayuktayā śaktyā bhavati|</para>
  <para style="p">
    <verse number="17" style="v"/>yata īśvara idaṁ sākṣyaṁ dattavān, yathā, "tvaṁ maklīṣēdakaḥ śrēṇyāṁ yājakō'si sadātanaḥ|"</para>
  <para style="p">
    <verse number="18" style="v"/>anēnāgravarttinō vidhē durbbalatāyā niṣphalatāyāśca hētōrarthatō vyavasthayā kimapi siddhaṁ na jātamitihētōstasya lōpō bhavati|</para>
  <para style="p">
    <verse number="19" style="v"/>yayā ca vayam īśvarasya nikaṭavarttinō bhavāma ētādr̥śī śrēṣṭhapratyāśā saṁsthāpyatē|</para>
  <para style="p">
    <verse number="20" style="v"/>aparaṁ yīśuḥ śapathaṁ vinā na niyuktastasmādapi sa śrēṣṭhaniyamasya madhyasthō jātaḥ|</para>
  <para style="p">
    <verse number="21" style="v"/>yatastē śapathaṁ vinā yājakā jātāḥ kintvasau śapathēna jātaḥ yataḥ sa idamuktaḥ, yathā,</para>
  <para style="p">
    <verse number="22" style="v"/>"paramēśa idaṁ śēpē na ca tasmānnivartsyatē| tvaṁ malkīṣēdakaḥ śrēṇyāṁ yājakō'si sadātanaḥ|"</para>
  <para style="p">
    <verse number="23" style="v"/>tē ca bahavō yājakā abhavan yatastē mr̥tyunā nityasthāyitvāt nivāritāḥ,</para>
  <para style="p">
    <verse number="24" style="v"/>kintvasāvanantakālaṁ yāvat tiṣṭhati tasmāt tasya yājakatvaṁ na parivarttanīyaṁ|</para>
  <para style="p">
    <verse number="25" style="v"/>tatō hētō ryē mānavāstēnēśvarasya sannidhiṁ gacchanti tān sa śēṣaṁ yāvat paritrātuṁ śaknōti yatastēṣāṁ kr̥tē prārthanāṁ karttuṁ sa satataṁ jīvati|</para>
  <para style="p">
    <verse number="26" style="v"/>aparam asmākaṁ tādr̥śamahāyājakasya prayōjanamāsīd yaḥ pavitrō 'hiṁsakō niṣkalaṅkaḥ pāpibhyō bhinnaḥ svargādapyuccīkr̥taśca syāt|</para>
  <para style="p">
    <verse number="27" style="v"/>aparaṁ mahāyājakānāṁ yathā tathā tasya pratidinaṁ prathamaṁ svapāpānāṁ kr̥tē tataḥ paraṁ lōkānāṁ pāpānāṁ kr̥tē balidānasya prayōjanaṁ nāsti yata ātmabalidānaṁ kr̥tvā tad ēkakr̥tvastēna sampāditaṁ|</para>
  <para style="p">
    <verse number="28" style="v"/>yatō vyavasthayā yē mahāyājakā nirūpyantē tē daurbbalyayuktā mānavāḥ kintu vyavasthātaḥ paraṁ śapathayuktēna vākyēna yō mahāyājakō nirūpitaḥ sō 'nantakālārthaṁ siddhaḥ putra ēva|</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>kathyamānānāṁ vākyānāṁ sārō'yam asmākam ētādr̥śa ēkō mahāyājakō'sti yaḥ svargē mahāmahimnaḥ siṁhāsanasya dakṣiṇapārśvō samupaviṣṭavān</para>
  <para style="p">
    <verse number="2" style="v"/>yacca dūṣyaṁ na manujaiḥ kintvīśvarēṇa sthāpitaṁ tasya satyadūṣyasya pavitravastūnāñca sēvakaḥ sa bhavati|</para>
  <para style="p">
    <verse number="3" style="v"/>yata ēkaikō mahāyājakō naivēdyānāṁ balīnāñca dānē niyujyatē, atō hētōrētasyāpi kiñcid utsarjanīyaṁ vidyata ityāvaśyakaṁ|</para>
  <para style="p">
    <verse number="4" style="v"/>kiñca sa yadi pr̥thivyām asthāsyat tarhi yājakō nābhaviṣyat, yatō yē vyavasthānusārāt naivēdyāni dadatyētādr̥śā yājakā vidyantē|</para>
  <para style="p">
    <verse number="5" style="v"/>tē tu svargīyavastūnāṁ dr̥ṣṭāntēna chāyayā ca sēvāmanutiṣṭhanti yatō mūsasi dūṣyaṁ sādhayitum udyatē satīśvarastadēva tamādiṣṭavān phalataḥ sa tamuktavān, yathā, "avadhēhi girau tvāṁ yadyannidarśanaṁ darśitaṁ tadvat sarvvāṇi tvayā kriyantāṁ|"</para>
  <para style="p">
    <verse number="6" style="v"/>kintvidānīm asau tasmāt śrēṣṭhaṁ sēvakapadaṁ prāptavān yataḥ sa śrēṣṭhapratijñābhiḥ sthāpitasya śrēṣṭhaniyamasya madhyasthō'bhavat|</para>
  <para style="p">
    <verse number="7" style="v"/>sa prathamō niyamō yadi nirddōṣō'bhaviṣyata tarhi dvitīyasya niyamasya kimapi prayōjanaṁ nābhaviṣyat|</para>
  <para style="p">
    <verse number="8" style="v"/>kintu sa dōṣamārōpayan tēbhyaḥ kathayati, yathā, "paramēśvara idaṁ bhāṣatē paśya yasmin samayē'ham isrāyēlavaṁśēna yihūdāvaṁśēna ca sārddham ēkaṁ navīnaṁ niyamaṁ sthirīkariṣyāmyētādr̥śaḥ samaya āyāti|</para>
  <para style="p">
    <verse number="9" style="v"/>paramēśvarō'paramapi kathayati tēṣāṁ pūrvvapuruṣāṇāṁ misaradēśād ānayanārthaṁ yasmin dinē'haṁ tēṣāṁ karaṁ dhr̥tvā taiḥ saha niyamaṁ sthirīkr̥tavān taddinasya niyamānusārēṇa nahi yatastai rmama niyamē laṅghitē'haṁ tān prati cintāṁ nākaravaṁ|</para>
  <para style="p">
    <verse number="10" style="v"/>kintu paramēśvaraḥ kathayati taddināt paramahaṁ isrāyēlavaṁśīyaiḥ sārddham imaṁ niyamaṁ sthirīkariṣyāmi, tēṣāṁ cittē mama vidhīn sthāpayiṣyāmi tēṣāṁ hr̥tpatrē ca tān lēkhiṣyāmi, aparamahaṁ tēṣām īśvarō bhaviṣyāmi tē ca mama lōkā bhaviṣyanti|</para>
  <para style="p">
    <verse number="11" style="v"/>aparaṁ tvaṁ paramēśvaraṁ jānīhītivākyēna tēṣāmēkaikō janaḥ svaṁ svaṁ samīpavāsinaṁ bhrātarañca puna rna śikṣayiṣyati yata ākṣudrāt mahāntaṁ yāvat sarvvē māṁ jñāsyanti|</para>
  <para style="p">
    <verse number="12" style="v"/>yatō hētōrahaṁ tēṣām adharmmān kṣamiṣyē tēṣāṁ pāpānyaparādhāṁśca punaḥ kadāpi na smariṣyāmi|"</para>
  <para style="p">
    <verse number="13" style="v"/>anēna taṁ niyamaṁ nūtanaṁ gaditvā sa prathamaṁ niyamaṁ purātanīkr̥tavān; yacca purātanaṁ jīrṇāñca jātaṁ tasya lōpō nikaṭō 'bhavat|</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>sa prathamō niyama ārādhanāyā vividharītibhiraihikapavitrasthānēna ca viśiṣṭa āsīt|</para>
  <para style="p">
    <verse number="2" style="v"/>yatō dūṣyamēkaṁ niramīyata tasya prathamakōṣṭhasya nāma pavitrasthānamityāsīt tatra dīpavr̥kṣō bhōjanāsanaṁ darśanīyapūpānāṁ śrēṇī cāsīt|</para>
  <para style="p">
    <verse number="3" style="v"/>tatpaścād dvitīyāyāstiraṣkariṇyā abhyantarē 'tipavitrasthānamitināmakaṁ kōṣṭhamāsīt,</para>
  <para style="p">
    <verse number="4" style="v"/>tatra ca suvarṇamayō dhūpādhāraḥ paritaḥ suvarṇamaṇḍitā niyamamañjūṣā cāsīt tanmadhyē mānnāyāḥ suvarṇaghaṭō hārōṇasya mañjaritadaṇḍastakṣitau niyamaprastarau,</para>
  <para style="p">
    <verse number="5" style="v"/>tadupari ca karuṇāsanē chāyākāriṇau tējōmayau kirūbāvāstām, ētēṣāṁ viśēṣavr̥ttāntakathanāya nāyaṁ samayaḥ|</para>
  <para style="p">
    <verse number="6" style="v"/>ētēṣvīdr̥k nirmmitēṣu yājakā īśvarasēvām anutiṣṭhanatō dūṣyasya prathamakōṣṭhaṁ nityaṁ praviśanti|</para>
  <para style="p">
    <verse number="7" style="v"/>kintu dvitīyaṁ kōṣṭhaṁ prativarṣam ēkakr̥tva ēkākinā mahāyājakēna praviśyatē kintvātmanimittaṁ lōkānām ajñānakr̥tapāpānāñca nimittam utsarjjanīyaṁ rudhiram anādāya tēna na praviśyatē|</para>
  <para style="p">
    <verse number="8" style="v"/>ityanēna pavitra ātmā yat jñāpayati tadidaṁ tat prathamaṁ dūṣyaṁ yāvat tiṣṭhati tāvat mahāpavitrasthānagāmī panthā aprakāśitastiṣṭhati|</para>
  <para style="p">
    <verse number="9" style="v"/>tacca dūṣyaṁ varttamānasamayasya dr̥ṣṭāntaḥ, yatō hētōḥ sāmprataṁ saṁśōdhanakālaṁ yāvad yannirūpitaṁ tadanusārāt sēvākāriṇō mānasikasiddhikaraṇē'samarthābhiḥ</para>
  <para style="p">
    <verse number="10" style="v"/>kēvalaṁ khādyapēyēṣu vividhamajjanēṣu ca śārīrikarītibhi ryuktāni naivēdyāni balidānāni ca bhavanti|</para>
  <para style="p">
    <verse number="11" style="v"/>aparaṁ bhāvimaṅgalānāṁ mahāyājakaḥ khrīṣṭa upasthāyāhastanirmmitēnārthata ētatsr̥ṣṭē rbahirbhūtēna śrēṣṭhēna siddhēna ca dūṣyēṇa gatvā</para>
  <para style="p">
    <verse number="12" style="v"/>chāgānāṁ gōvatsānāṁ vā rudhiram anādāya svīyarudhiram ādāyaikakr̥tva ēva mahāpavitrasthānaṁ praviśyānantakālikāṁ muktiṁ prāptavān|</para>
  <para style="p">
    <verse number="13" style="v"/>vr̥ṣachāgānāṁ rudhirēṇa gavībhasmanaḥ prakṣēpēṇa ca yadyaśucilōkāḥ śārīriśucitvāya pūyantē,</para>
  <para style="p">
    <verse number="14" style="v"/>tarhi kiṁ manyadhvē yaḥ sadātanēnātmanā niṣkalaṅkabalimiva svamēvēśvarāya dattavān, tasya khrīṣṭasya rudhirēṇa yuṣmākaṁ manāṁsyamarēśvarasya sēvāyai kiṁ mr̥tyujanakēbhyaḥ karmmabhyō na pavitrīkāriṣyantē?</para>
  <para style="p">
    <verse number="15" style="v"/>sa nūtananiyamasya madhyasthō'bhavat tasyābhiprāyō'yaṁ yat prathamaniyamalaṅghanarūpapāpēbhyō mr̥tyunā muktau jātāyām āhūtalōkā anantakālīyasampadaḥ pratijñāphalaṁ labhēran|</para>
  <para style="p">
    <verse number="16" style="v"/>yatra niyamō bhavati tatra niyamasādhakasya balē rmr̥tyunā bhavitavyaṁ|</para>
  <para style="p">
    <verse number="17" style="v"/>yatō hatēna balinā niyamaḥ sthirībhavati kintu niyamasādhakō bali ryāvat jīvati tāvat niyamō nirarthakastiṣṭhati|</para>
  <para style="p">
    <verse number="18" style="v"/>tasmāt sa pūrvvaniyamō'pi rudhirapātaṁ vinā na sādhitaḥ|</para>
  <para style="p">
    <verse number="19" style="v"/>phalataḥ sarvvalōkān prati vyavasthānusārēṇa sarvvā ājñāḥ kathayitvā mūsā jalēna sindūravarṇalōmnā ēṣōvatr̥ṇēna ca sārddhaṁ gōvatsānāṁ chāgānāñca rudhiraṁ gr̥hītvā granthē sarvvalōkēṣu ca prakṣipya babhāṣē,</para>
  <para style="p">
    <verse number="20" style="v"/>yuṣmān adhīśvarō yaṁ niyamaṁ nirūpitavān tasya rudhiramētat|</para>
  <para style="p">
    <verse number="21" style="v"/>tadvat sa dūṣyē'pi sēvārthakēṣu sarvvapātrēṣu ca rudhiraṁ prakṣiptavān|</para>
  <para style="p">
    <verse number="22" style="v"/>aparaṁ vyavasthānusārēṇa prāyaśaḥ sarvvāṇi rudhirēṇa pariṣkriyantē rudhirapātaṁ vinā pāpamōcanaṁ na bhavati ca|</para>
  <para style="p">
    <verse number="23" style="v"/>aparaṁ yāni svargīyavastūnāṁ dr̥ṣṭāntāstēṣām ētaiḥ pāvanam āvaśyakam āsīt kintu sākṣāt svargīyavastūnām ētēbhyaḥ śrēṣṭhēै rbalidānaiḥ pāvanamāvaśyakaṁ|</para>
  <para style="p">
    <verse number="24" style="v"/>yataḥ khrīṣṭaḥ satyapavitrasthānasya dr̥ṣṭāntarūpaṁ hastakr̥taṁ pavitrasthānaṁ na praviṣṭavān kintvasmannimittam idānīm īśvarasya sākṣād upasthātuṁ svargamēva praviṣṭaḥ|</para>
  <para style="p">
    <verse number="25" style="v"/>yathā ca mahāyājakaḥ prativarṣaṁ paraśōṇitamādāya mahāpavitrasthānaṁ praviśati tathā khrīṣṭēna punaḥ punarātmōtsargō na karttavyaḥ,</para>
  <para style="p">
    <verse number="26" style="v"/>karttavyē sati jagataḥ sr̥ṣṭikālamārabhya bahuvāraṁ tasya mr̥tyubhōga āvaśyakō'bhavat; kintvidānīṁ sa ātmōtsargēṇa pāpanāśārtham ēkakr̥tvō jagataḥ śēṣakālē pracakāśē|</para>
  <para style="p">
    <verse number="27" style="v"/>aparaṁ yathā mānuṣasyaikakr̥tvō maraṇaṁ tat paścād vicārō nirūpitō'sti,</para>
  <para style="p">
    <verse number="28" style="v"/>tadvat khrīṣṭō'pi bahūnāṁ pāpavahanārthaṁ balirūpēṇaikakr̥tva utsasr̥jē, aparaṁ dvitīyavāraṁ pāpād bhinnaḥ san yē taṁ pratīkṣantē tēṣāṁ paritrāṇārthaṁ darśanaṁ dāsyati|</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>vyavasthā bhaviṣyanmaṅgalānāṁ chāyāsvarūpā na ca vastūnāṁ mūrttisvarūpā tatō hētō rnityaṁ dīyamānairēkavidhai rvārṣikabalibhiḥ śaraṇāgatalōkān siddhān karttuṁ kadāpi na śaknōti|</para>
  <para style="p">
    <verse number="2" style="v"/>yadyaśakṣyat tarhi tēṣāṁ balīnāṁ dānaṁ kiṁ na nyavarttiṣyata? yataḥ sēvākāriṣvēkakr̥tvaḥ pavitrībhūtēṣu tēṣāṁ kō'pi pāpabōdhaḥ puna rnābhaviṣyat|</para>
  <para style="p">
    <verse number="3" style="v"/>kintu tai rbalidānaiḥ prativatsaraṁ pāpānāṁ smāraṇaṁ jāyatē|</para>
  <para style="p">
    <verse number="4" style="v"/>yatō vr̥ṣāṇāṁ chāgānāṁ vā rudhirēṇa pāpamōcanaṁ na sambhavati|</para>
  <para style="p">
    <verse number="5" style="v"/>ētatkāraṇāt khrīṣṭēna jagat praviśyēdam ucyatē, yathā, "nēṣṭvā baliṁ na naivēdyaṁ dēhō mē nirmmitastvayā|</para>
  <para style="p">
    <verse number="6" style="v"/>na ca tvaṁ balibhi rhavyaiḥ pāpaghnai rvā pratuṣyasi|</para>
  <para style="p">
    <verse number="7" style="v"/>avādiṣaṁ tadaivāhaṁ paśya kurvvē samāgamaṁ| dharmmagranthasya sargē mē vidyatē likhitā kathā| īśa manō'bhilāṣastē mayā sampūrayiṣyatē|"</para>
  <para style="p">
    <verse number="8" style="v"/>ityasmin prathamatō yēṣāṁ dānaṁ vyavasthānusārād bhavati tānyadhi tēnēdamuktaṁ yathā, balinaivēdyahavyāni pāpaghnañcōpacārakaṁ, nēmāni vāñchasi tvaṁ hi na caitēṣu pratuṣyasīti|</para>
  <para style="p">
    <verse number="9" style="v"/>tataḥ paraṁ tēnōktaṁ yathā, "paśya manō'bhilāṣaṁ tē karttuṁ kurvvē samāgamaṁ;" dvitīyam ētad vākyaṁ sthirīkarttuṁ sa prathamaṁ lumpati|</para>
  <para style="p">
    <verse number="10" style="v"/>tēna manō'bhilāṣēṇa ca vayaṁ yīśukhrīṣṭasyaikakr̥tvaḥ svaśarīrōtsargāt pavitrīkr̥tā abhavāma|</para>
  <para style="p">
    <verse number="11" style="v"/>aparam ēkaikō yājakaḥ pratidinam upāsanāṁ kurvvan yaiśca pāpāni nāśayituṁ kadāpi na śakyantē tādr̥śān ēkarūpān balīn punaḥ punarutsr̥jan tiṣṭhati|</para>
  <para style="p">
    <verse number="12" style="v"/>kintvasau pāpanāśakam ēkaṁ baliṁ datvānantakālārtham īśvarasya dakṣiṇa upaviśya</para>
  <para style="p">
    <verse number="13" style="v"/>yāvat tasya śatravastasya pādapīṭhaṁ na bhavanti tāvat pratīkṣamāṇastiṣṭhati|</para>
  <para style="p">
    <verse number="14" style="v"/>yata ēkēna balidānēna sō'nantakālārthaṁ pūyamānān lōkān sādhitavān|</para>
  <para style="p">
    <verse number="15" style="v"/>ētasmin pavitra ātmāpyasmākaṁ pakṣē pramāṇayati</para>
  <para style="p">
    <verse number="16" style="v"/>"yatō hētōstaddināt param ahaṁ taiḥ sārddham imaṁ niyamaṁ sthirīkariṣyāmīti prathamata uktvā paramēśvarēṇēdaṁ kathitaṁ, tēṣāṁ cittē mama vidhīn sthāpayiṣyāmi tēṣāṁ manaḥsu ca tān lēkhiṣyāmi ca,</para>
  <para style="p">
    <verse number="17" style="v"/>aparañca tēṣāṁ pāpānyaparādhāṁśca punaḥ kadāpi na smāriṣyāmi|"</para>
  <para style="p">
    <verse number="18" style="v"/>kintu yatra pāpamōcanaṁ bhavati tatra pāpārthakabalidānaṁ puna rna bhavati|</para>
  <para style="p">
    <verse number="19" style="v"/>atō hē bhrātaraḥ, yīśō rudhirēṇa pavitrasthānapravēśāyāsmākam utsāhō bhavati,</para>
  <para style="p">
    <verse number="20" style="v"/>yataḥ sō'smadarthaṁ tiraskariṇyārthataḥ svaśarīrēṇa navīnaṁ jīvanayuktañcaikaṁ panthānaṁ nirmmitavān,</para>
  <para style="p">
    <verse number="21" style="v"/>aparañcēśvarīyaparivārasyādhyakṣa ēkō mahāyājakō'smākamasti|</para>
  <para style="p">
    <verse number="22" style="v"/>atō hētōrasmābhiḥ saralāntaḥkaraṇai rdr̥ḍhaviśvāsaiḥ pāpabōdhāt prakṣālitamanōbhi rnirmmalajalē snātaśarīraiścēśvaram upāgatya pratyāśāyāḥ pratijñā niścalā dhārayitavyā|</para>
  <para style="p">
    <verse number="23" style="v"/>yatō yastām aṅgīkr̥tavān sa viśvasanīyaḥ|</para>
  <para style="p">
    <verse number="24" style="v"/>aparaṁ prēmni satkriyāsu caikaikasyōtsāhavr̥ddhyartham asmābhiḥ parasparaṁ mantrayitavyaṁ|</para>
  <para style="p">
    <verse number="25" style="v"/>aparaṁ katipayalōkā yathā kurvvanti tathāsmābhiḥ sabhākaraṇaṁ na parityaktavyaṁ parasparam upadēṣṭavyañca yatastat mahādinam uttarōttaraṁ nikaṭavartti bhavatīti yuṣmābhi rdr̥śyatē|</para>
  <para style="p">
    <verse number="26" style="v"/>satyamatasya jñānaprāptēḥ paraṁ yadi vayaṁ svaṁcchayā pāpācāraṁ kurmmastarhi pāpānāṁ kr̥tē 'nyat kimapi balidānaṁ nāvaśiṣyatē</para>
  <para style="p">
    <verse number="27" style="v"/>kintu vicārasya bhayānakā pratīkṣā ripunāśakānalasya tāpaścāvaśiṣyatē|</para>
  <para style="p">
    <verse number="28" style="v"/>yaḥ kaścit mūsasō vyavasthām avamanyatē sa dayāṁ vinā dvayōstisr̥ṇāṁ vā sākṣiṇāṁ pramāṇēna hanyatē,</para>
  <para style="p">
    <verse number="29" style="v"/>tasmāt kiṁ budhyadhvē yō jana īśvarasya putram avajānāti yēna ca pavitrīkr̥tō 'bhavat tat niyamasya rudhiram apavitraṁ jānāti, anugrahakaram ātmānam apamanyatē ca, sa kiyanmahāghōrataradaṇḍasya yōgyō bhaviṣyati?</para>
  <para style="p">
    <verse number="30" style="v"/>yataḥ paramēśvaraḥ kathayati, "dānaṁ phalasya matkarmma sūcitaṁ pradadāmyahaṁ|" punarapi, "tadā vicārayiṣyantē parēśēna nijāḥ prajāḥ|" idaṁ yaḥ kathitavān taṁ vayaṁ jānīmaḥ|</para>
  <para style="p">
    <verse number="31" style="v"/>amarēśvarasya karayōḥ patanaṁ mahābhayānakaṁ|</para>
  <para style="p">
    <verse number="32" style="v"/>hē bhrātaraḥ, pūrvvadināni smarata yatastadānīṁ yūyaṁ dīptiṁ prāpya bahudurgatirūpaṁ saṁgrāmaṁ sahamānā ēkatō nindāklēśaiḥ kautukīkr̥tā abhavata,</para>
  <para style="p">
    <verse number="33" style="v"/>anyataśca tadbhōgināṁ samāṁśinō 'bhavata|</para>
  <para style="p">
    <verse number="34" style="v"/>yūyaṁ mama bandhanasya duḥkhēna duḥkhinō 'bhavata, yuṣmākam uttamā nityā ca sampattiḥ svargē vidyata iti jñātvā sānandaṁ sarvvasvasyāpaharaṇam asahadhvañca|</para>
  <para style="p">
    <verse number="35" style="v"/>ataēva mahāpuraskārayuktaṁ yuṣmākam utsāhaṁ na parityajata|</para>
  <para style="p">
    <verse number="36" style="v"/>yatō yūyaṁ yēnēśvarasyēcchāṁ pālayitvā pratijñāyāḥ phalaṁ labhadhvaṁ tadarthaṁ yuṣmābhi rdhairyyāvalambanaṁ karttavyaṁ|</para>
  <para style="p">
    <verse number="37" style="v"/>yēnāgantavyaṁ sa svalpakālāt param āgamiṣyati na ca vilambiṣyatē|</para>
  <para style="p">
    <verse number="38" style="v"/>"puṇyavān janō viśvāsēna jīviṣyati kintu yadi nivarttatē tarhi mama manastasmin na tōṣaṁ yāsyati|"</para>
  <para style="p">
    <verse number="39" style="v"/>kintu vayaṁ vināśajanikāṁ dharmmāt nivr̥ttiṁ na kurvvāṇā ātmanaḥ paritrāṇāya viśvāsaṁ kurvvāmahēे|</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>viśvāsa āśaṁsitānāṁ niścayaḥ, adr̥śyānāṁ viṣayāṇāṁ darśanaṁ bhavati|</para>
  <para style="p">
    <verse number="2" style="v"/>tēna viśvāsēna prāñcō lōkāḥ prāmāṇyaṁ prāptavantaḥ|</para>
  <para style="p">
    <verse number="3" style="v"/>aparam īśvarasya vākyēna jagantyasr̥jyanta, dr̥ṣṭavastūni ca pratyakṣavastubhyō nōdapadyantaitad vayaṁ viśvāsēna budhyāmahē|</para>
  <para style="p">
    <verse number="4" style="v"/>viśvāsēna hābil īśvaramuddiśya kābilaḥ śrēṣṭhaṁ balidānaṁ kr̥tavān tasmāccēśvarēṇa tasya dānānyadhi pramāṇē dattē sa dhārmmika ityasya pramāṇaṁ labdhavān tēna viśvāsēna ca sa mr̥taḥ san adyāpi bhāṣatē|</para>
  <para style="p">
    <verse number="5" style="v"/>viśvāsēna hanōk yathā mr̥tyuṁ na paśyēt tathā lōkāntaraṁ nītaḥ, tasyōddēśaśca kēnāpi na prāpi yata īśvarastaṁ lōkāntaraṁ nītavān, tatpramāṇamidaṁ tasya lōkāntarīkaraṇāt pūrvvaṁ sa īśvarāya rōcitavān iti pramāṇaṁ prāptavān|</para>
  <para style="p">
    <verse number="6" style="v"/>kintu viśvāsaṁ vinā kō'pīśvarāya rōcituṁ na śaknōti yata īśvarō'sti svānvēṣilōkēbhyaḥ puraskāraṁ dadāti cētikathāyām īśvaraśaraṇāgatai rviśvasitavyaṁ|</para>
  <para style="p">
    <verse number="7" style="v"/>aparaṁ tadānīṁ yānyadr̥śyānyāsan tānīśvarēṇādiṣṭaḥ san nōhō viśvāsēna bhītvā svaparijanānāṁ rakṣārthaṁ pōtaṁ nirmmitavān tēna ca jagajjanānāṁ dōṣān darśitavān viśvāsāt labhyasya puṇyasyādhikārī babhūva ca|</para>
  <para style="p">
    <verse number="8" style="v"/>viśvāsēnēbrāhīm āhūtaḥ san ājñāṁ gr̥hītvā yasya sthānasyādhikārastēna prāptavyastat sthānaṁ prasthitavān kintu prasthānasamayē kka yāmīti nājānāt|</para>
  <para style="p">
    <verse number="9" style="v"/>viśvāsēna sa pratijñātē dēśē paradēśavat pravasan tasyāḥ pratijñāyāḥ samānāṁśibhyām ishākā yākūbā ca saha dūṣyavāsyabhavat|</para>
  <para style="p">
    <verse number="10" style="v"/>yasmāt sa īśvarēṇa nirmmitaṁ sthāpitañca bhittimūlayuktaṁ nagaraṁ pratyaikṣata|</para>
  <para style="p">
    <verse number="11" style="v"/>aparañca viśvāsēna sārā vayōtikrāntā santyapi garbhadhāraṇāya śaktiṁ prāpya putravatyabhavat, yataḥ sā pratijñākāriṇaṁ viśvāsyam amanyata|</para>
  <para style="p">
    <verse number="12" style="v"/>tatō hētō rmr̥takalpād ēkasmāt janād ākāśīyanakṣatrāṇīva gaṇanātītāḥ samudratīrasthasikatā iva cāsaṁkhyā lōkā utpēdirē|</para>
  <para style="p">
    <verse number="13" style="v"/>ētē sarvvē pratijñāyāḥ phalānyaprāpya kēvalaṁ dūrāt tāni nirīkṣya vanditvā ca, pr̥thivyāṁ vayaṁ vidēśinaḥ pravāsinaścāsmaha iti svīkr̥tya viśvāsēna prāṇān tatyajuḥ|</para>
  <para style="p">
    <verse number="14" style="v"/>yē tu janā itthaṁ kathayanti taiḥ paitr̥kadēśō 'smābhiranviṣyata iti prakāśyatē|</para>
  <para style="p">
    <verse number="15" style="v"/>tē yasmād dēśāt nirgatāstaṁ yadyasmariṣyan tarhi parāvarttanāya samayam alapsyanta|</para>
  <para style="p">
    <verse number="16" style="v"/>kintu tē sarvvōtkr̥ṣṭam arthataḥ svargīyaṁ dēśam ākāṅkṣanti tasmād īśvarastānadhi na lajjamānastēṣām īśvara iti nāma gr̥hītavān yataḥ sa tēṣāṁ kr̥tē nagaramēkaṁ saṁsthāpitavān|</para>
  <para style="p">
    <verse number="17" style="v"/>aparam ibrāhīmaḥ parīkṣāyāṁ jātāyāṁ sa viśvāsēnēshākam utsasarja,</para>
  <para style="p">
    <verse number="18" style="v"/>vastuta ishāki tava vaṁśō vikhyāsyata iti vāg yamadhi kathitā tam advitīyaṁ putraṁ pratijñāprāptaḥ sa utsasarja|</para>
  <para style="p">
    <verse number="19" style="v"/>yata īśvarō mr̥tānapyutthāpayituṁ śaknōtīti sa mēnē tasmāt sa upamārūpaṁ taṁ lēbhē|</para>
  <para style="p">
    <verse number="20" style="v"/>aparam ishāk viśvāsēna yākūb ēṣāvē ca bhāviviṣayānadhyāśiṣaṁ dadau|</para>
  <para style="p">
    <verse number="21" style="v"/>aparaṁ yākūb maraṇakālē viśvāsēna yūṣaphaḥ putrayōrēkaikasmai janāyāśiṣaṁ dadau yaṣṭyā agrabhāgē samālambya praṇanāma ca|</para>
  <para style="p">
    <verse number="22" style="v"/>aparaṁ yūṣaph caramakālē viśvāsēnēsrāyēlvaṁśīyānāṁ misaradēśād bahirgamanasya vācaṁ jagāda nijāsthīni cādhi samādidēśa|</para>
  <para style="p">
    <verse number="23" style="v"/>navajātō mūsāśca viśvāsāt trāीn māsān svapitr̥bhyām agōpyata yatastau svaśiśuṁ paramasundaraṁ dr̥ṣṭavantau rājājñāñca na śaṅkitavantau|</para>
  <para style="p">
    <verse number="24" style="v"/>aparaṁ vayaḥprāptō mūsā viśvāsāt phirauṇō dauhitra iti nāma nāṅgīcakāra|</para>
  <para style="p">
    <verse number="25" style="v"/>yataḥ sa kṣaṇikāt pāpajasukhabhōgād īśvarasya prajābhiḥ sārddhaṁ duḥkhabhōgaṁ vavrē|</para>
  <para style="p">
    <verse number="26" style="v"/>tathā misaradēśīyanidhibhyaḥ khrīṣṭanimittāṁ nindāṁ mahatīṁ sampattiṁ mēnē yatō hētōḥ sa puraskāradānam apaikṣata|</para>
  <para style="p">
    <verse number="27" style="v"/>aparaṁ sa viśvāsēna rājñaḥ krōdhāt na bhītvā misaradēśaṁ paritatyāja, yatastēnādr̥śyaṁ vīkṣamāṇēnēva dhairyyam ālambi|</para>
  <para style="p">
    <verse number="28" style="v"/>aparaṁ prathamajātānāṁ hantā yat svīyalōkān na spr̥śēt tadarthaṁ sa viśvāsēna nistāraparvvīyabalicchēdanaṁ rudhirasēcanañcānuṣṭhitāvān|</para>
  <para style="p">
    <verse number="29" style="v"/>aparaṁ tē viśvāsāt sthalēnēva sūphsāgarēṇa jagmuḥ kintu misrīyalōkāstat karttum upakramya tōyēṣu mamajjuḥ|</para>
  <para style="p">
    <verse number="30" style="v"/>aparañca viśvāsāt taiḥ saptāhaṁ yāvad yirīhōḥ prācīrasya pradakṣiṇē kr̥tē tat nipapāta|</para>
  <para style="p">
    <verse number="31" style="v"/>viśvāsād rāhabnāmikā vēśyāpi prītyā cārān anugr̥hyāviśvāsibhiḥ sārddhaṁ na vinanāśa|</para>
  <para style="p">
    <verse number="32" style="v"/>adhikaṁ kiṁ kathayiṣyāmi? gidiyōnō bārakaḥ śimśōnō yiptahō dāyūd śimūyēlō bhaviṣyadvādinaścaitēṣāṁ vr̥ttāntakathanāya mama samayābhāvō bhaviṣyati|</para>
  <para style="p">
    <verse number="33" style="v"/>viśvāsāt tē rājyāni vaśīkr̥tavantō dharmmakarmmāṇi sādhitavantaḥ pratijñānāṁ phalaṁ labdhavantaḥ siṁhānāṁ mukhāni ruddhavantō</para>
  <para style="p">
    <verse number="34" style="v"/>vahnērdāhaṁ nirvvāpitavantaḥ khaṅgadhārād rakṣāṁ prāptavantō daurbbalyē sabalīkr̥tā yuddhē parākramiṇō jātāḥ parēṣāṁ sainyāni davayitavantaśca|</para>
  <para style="p">
    <verse number="35" style="v"/>yōṣitaḥ punarutthānēna mr̥tān ātmajān lēbhirēे, aparē ca śrēṣṭhōtthānasya prāptērāśayā rakṣām agr̥hītvā tāḍanēna mr̥tavantaḥ|</para>
  <para style="p">
    <verse number="36" style="v"/>aparē tiraskāraiḥ kaśābhi rbandhanaiḥ kārayā ca parīkṣitāḥ|</para>
  <para style="p">
    <verse number="37" style="v"/>bahavaśca prastarāghātai rhatāḥ karapatrai rvā vidīrṇā yantrai rvā kliṣṭāḥ khaṅgadhārai rvā vyāpāditāḥ| tē mēṣāṇāṁ chāgānāṁ vā carmmāṇi paridhāya dīnāḥ pīḍitā duḥkhārttāścābhrāmyan|</para>
  <para style="p">
    <verse number="38" style="v"/>saṁsārō yēṣām ayōgyastē nirjanasthānēṣu parvvatēṣu gahvarēṣu pr̥thivyāśchidrēṣu ca paryyaṭan|</para>
  <para style="p">
    <verse number="39" style="v"/>ētaiḥ sarvvai rviśvāsāt pramāṇaṁ prāpi kintu pratijñāyāḥ phalaṁ na prāpi|</para>
  <para style="p">
    <verse number="40" style="v"/>yatastē yathāsmān vinā siddhā na bhavēyustathaivēśvarēṇāsmākaṁ kr̥tē śrēṣṭhataraṁ kimapi nirdidiśē|</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>atō hētōrētāvatsākṣimēghai rvēṣṭitāḥ santō vayamapi sarvvabhāram āśubādhakaṁ pāpañca nikṣipyāsmākaṁ gamanāya nirūpitē mārgē dhairyyēṇa dhāvāma|</para>
  <para style="p">
    <verse number="2" style="v"/>yaścāsmākaṁ viśvāsasyāgrēsaraḥ siddhikarttā cāsti taṁ yīśuṁ vīkṣāmahai yataḥ sa svasammukhasthitānandasya prāptyartham apamānaṁ tucchīkr̥tya kruśasya yātanāṁ sōḍhavān īśvarīyasiṁhāsanasya dakṣiṇapārśvē samupaviṣṭavāṁśca|</para>
  <para style="p">
    <verse number="3" style="v"/>yaḥ pāpibhiḥ svaviruddham ētādr̥śaṁ vaiparītyaṁ sōḍhavān tam ālōcayata tēna yūyaṁ svamanaḥsu śrāntāḥ klāntāśca na bhaviṣyatha|</para>
  <para style="p">
    <verse number="4" style="v"/>yūyaṁ pāpēna saha yudhyantō'dyāpi śōṇitavyayaparyyantaṁ pratirōdhaṁ nākuruta|</para>
  <para style="p">
    <verse number="5" style="v"/>tathā ca putrān pratīva yuṣmān prati ya upadēśa uktastaṁ kiṁ vismr̥tavantaḥ? "parēśēna kr̥tāṁ śāstiṁ hē matputra na tucchaya| tēna saṁbhartsitaścāpi naiva klāmya kadācana|</para>
  <para style="p">
    <verse number="6" style="v"/>parēśaḥ prīyatē yasmin tasmai śāstiṁ dadāti yat| yantu putraṁ sa gr̥hlāti tamēva praharatyapi|"</para>
  <para style="p">
    <verse number="7" style="v"/>yadi yūyaṁ śāstiṁ sahadhvaṁ tarhīśvaraḥ putrairiva yuṣmābhiḥ sārddhaṁ vyavaharati yataḥ pitā yasmai śāstiṁ na dadāti tādr̥śaḥ putraḥ kaḥ?</para>
  <para style="p">
    <verse number="8" style="v"/>sarvvē yasyāḥ śāstēraṁśinō bhavanti sā yadi yuṣmākaṁ na bhavati tarhi yūyam ātmajā na kintu jārajā ādhvē|</para>
  <para style="p">
    <verse number="9" style="v"/>aparam asmākaṁ śārīrikajanmadātārō'smākaṁ śāstikāriṇō'bhavan tē cāsmābhiḥ sammānitāstasmād ya ātmanāṁ janayitā vayaṁ kiṁ tatō'dhikaṁ tasya vaśībhūya na jīviṣyāmaḥ?</para>
  <para style="p">
    <verse number="10" style="v"/>tē tvalpadināni yāvat svamanō'matānusārēṇa śāstiṁ kr̥tavantaḥ kintvēṣō'smākaṁ hitāya tasya pavitratāyā aṁśitvāya cāsmān śāsti|</para>
  <para style="p">
    <verse number="11" style="v"/>śāstiśca varttamānasamayē kēnāpi nānandajanikā kintu śōkajanikaiva manyatē tathāpi yē tayā vinīyantē tēbhyaḥ sā paścāt śāntiyuktaṁ dharmmaphalaṁ dadāti|</para>
  <para style="p">
    <verse number="12" style="v"/>ataēva yūyaṁ śithilān hastān durbbalāni jānūni ca sabalāni kurudhvaṁ|</para>
  <para style="p">
    <verse number="13" style="v"/>yathā ca durbbalasya sandhisthānaṁ na bhajyēta svasthaṁ tiṣṭhēt tathā svacaraṇārthaṁ saralaṁ mārgaṁ nirmmāta|</para>
  <para style="p">
    <verse number="14" style="v"/>aparañca sarvvaiḥ sārtham ēेkyabhāvaṁ yacca vinā paramēśvarasya darśanaṁ kēnāpi na lapsyatē tat pavitratvaṁ cēṣṭadhvaṁ|</para>
  <para style="p">
    <verse number="15" style="v"/>yathā kaścid īśvarasyānugrahāt na patēt, yathā ca tiktatāyā mūlaṁ praruhya bādhājanakaṁ na bhavēt tēna ca bahavō'pavitrā na bhavēyuḥ,</para>
  <para style="p">
    <verse number="16" style="v"/>yathā ca kaścit lampaṭō vā ēkakr̥tva āhārārthaṁ svīyajyēṣṭhādhikāravikrētā ya ēṣaustadvad adharmmācārī na bhavēt tathā sāvadhānā bhavata|</para>
  <para style="p">
    <verse number="17" style="v"/>yataḥ sa ēṣauḥ paścād āśīrvvādādhikārī bhavitum icchannapi nānugr̥hīta iti yūyaṁ jānītha, sa cāśrupātēna matyantaraṁ prārthayamānō'pi tadupāyaṁ na lēbhē|</para>
  <para style="p">
    <verse number="18" style="v"/>aparañca spr̥śyaḥ parvvataḥ prajvalitō vahniḥ kr̥ṣṇāvarṇō mēghō 'ndhakārō jhañbhśa tūrīvādyaṁ vākyānāṁ śabdaśca naitēṣāṁ sannidhau yūyam āgatāḥ|</para>
  <para style="p">
    <verse number="19" style="v"/>taṁ śabdaṁ śrutvā śrōtārastādr̥śaṁ sambhāṣaṇaṁ yat puna rna jāyatē tat prārthitavantaḥ|</para>
  <para style="p">
    <verse number="20" style="v"/>yataḥ paśurapi yadi dharādharaṁ spr̥śati tarhi sa pāṣāṇāghātai rhantavya ityādēśaṁ sōḍhuṁ tē nāśaknuvan|</para>
  <para style="p">
    <verse number="21" style="v"/>tacca darśanam ēvaṁ bhayānakaṁ yat mūsasōktaṁ bhītastrāsayuktaścāsmīti|</para>
  <para style="p">
    <verse number="22" style="v"/>kintu sīyōnparvvatō 'marēśvarasya nagaraṁ svargasthayirūśālamam ayutāni divyadūtāḥ</para>
  <para style="p">
    <verse number="23" style="v"/>svargē likhitānāṁ prathamajātānām utsavaḥ samitiśca sarvvēṣāṁ vicārādhipatirīśvaraḥ siddhīkr̥tadhārmmikānām ātmānō</para>
  <para style="p">
    <verse number="24" style="v"/>nūtananiyamasya madhyasthō yīśuḥ, aparaṁ hābilō raktāt śrēyaḥ pracārakaṁ prōkṣaṇasya raktañcaitēṣāṁ sannidhau yūyam āgatāḥ|</para>
  <para style="p">
    <verse number="25" style="v"/>sāvadhānā bhavata taṁ vaktāraṁ nāvajānīta yatō hētōḥ pr̥thivīsthitaḥ sa vaktā yairavajñātastai ryadi rakṣā nāprāpi tarhi svargīyavaktuḥ parāṅmukhībhūyāsmābhiḥ kathaṁ rakṣā prāpsyatē?</para>
  <para style="p">
    <verse number="26" style="v"/>tadā tasya ravāt pr̥thivī kampitā kintvidānīṁ tēnēdaṁ pratijñātaṁ yathā, "ahaṁ punarēkakr̥tvaḥ pr̥thivīṁ kampayiṣyāmi kēvalaṁ tannahi gaganamapi kampayiṣyāmi|"</para>
  <para style="p">
    <verse number="27" style="v"/>sa ēkakr̥tvaḥ śabdō niścalaviṣayāṇāṁ sthitayē nirmmitānāmiva cañcalavastūnāṁ sthānāntarīkaraṇaṁ prakāśayati|</para>
  <para style="p">
    <verse number="28" style="v"/>ataēva niścalarājyaprāptairasmābhiḥ sō'nugraha ālambitavyō yēna vayaṁ sādaraṁ sabhayañca tuṣṭijanakarūpēṇēśvaraṁ sēvituṁ śaknuyāma|</para>
  <para style="p">
    <verse number="29" style="v"/>yatō'smākam īśvaraḥ saṁhārakō vahniḥ|</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>bhrātr̥ṣu prēma tiṣṭhatu| atithisēvā yuṣmābhi rna vismaryyatāṁ</para>
  <para style="p">
    <verse number="2" style="v"/>yatastayā pracchannarūpēṇa divyadūtāḥ kēṣāñcid atithayō'bhavan|</para>
  <para style="p">
    <verse number="3" style="v"/>bandinaḥ sahabandibhiriva duḥkhinaśca dēhavāsibhiriva yuṣmābhiḥ smaryyantāṁ|</para>
  <para style="p">
    <verse number="4" style="v"/>vivāhaḥ sarvvēṣāṁ samīpē sammānitavyastadīyaśayyā ca śuciḥ kintu vēśyāgāminaḥ pāradārikāścēśvarēṇa daṇḍayiṣyantē|</para>
  <para style="p">
    <verse number="5" style="v"/>yūyam ācārē nirlōbhā bhavata vidyamānaviṣayē santuṣyata ca yasmād īśvara ēvēdaṁ kathitavān, yathā, "tvāṁ na tyakṣyāmi na tvāṁ hāsyāmi|"</para>
  <para style="p">
    <verse number="6" style="v"/>ataēva vayam utsāhēnēdaṁ kathayituṁ śaknumaḥ, "matpakṣē paramēśō'sti na bhēṣyāmi kadācana| yasmāt māṁ prati kiṁ karttuṁ mānavaḥ pārayiṣyati||"</para>
  <para style="p">
    <verse number="7" style="v"/>yuṣmākaṁ yē nāyakā yuṣmabhyam īśvarasya vākyaṁ kathitavantastē yuṣmābhiḥ smaryyantāṁ tēṣām ācārasya pariṇāmam ālōcya yuṣmābhistēṣāṁ viśvāsō'nukriyatāṁ|</para>
  <para style="p">
    <verse number="8" style="v"/>yīśuḥ khrīṣṭaḥ śvō'dya sadā ca sa ēvāstē|</para>
  <para style="p">
    <verse number="9" style="v"/>yūyaṁ nānāvidhanūtanaśikṣābhi rna parivarttadhvaṁ yatō'nugrahēṇāntaḥkaraṇasya susthirībhavanaṁ kṣēmaṁ na ca khādyadravyaiḥ| yatastadācāriṇastai rnōpakr̥tāḥ|</para>
  <para style="p">
    <verse number="10" style="v"/>yē daṣyasya sēvāṁ kurvvanti tē yasyā dravyabhōjanasyānadhikāriṇastādr̥śī yajñavēdirasmākam āstē|</para>
  <para style="p">
    <verse number="11" style="v"/>yatō yēṣāṁ paśūnāṁ śōṇitaṁ pāpanāśāya mahāyājakēna mahāpavitrasthānasyābhyantaraṁ nīyatē tēṣāṁ śarīrāṇi śibirād bahi rdahyantē|</para>
  <para style="p">
    <verse number="12" style="v"/>tasmād yīśurapi yat svarudhirēṇa prajāḥ pavitrīkuryyāt tadarthaṁ nagaradvārasya bahi rmr̥tiṁ bhuktavān|</para>
  <para style="p">
    <verse number="13" style="v"/>atō hētōrasmābhirapi tasyāpamānaṁ sahamānaiḥ śibirād bahistasya samīpaṁ gantavyaṁ|</para>
  <para style="p">
    <verse number="14" style="v"/>yatō 'trāsmākaṁ sthāyi nagaraṁ na vidyatē kintu bhāvi nagaram asmābhiranviṣyatē|</para>
  <para style="p">
    <verse number="15" style="v"/>ataēva yīśunāsmābhi rnityaṁ praśaṁsārūpō balirarthatastasya nāmāṅgīkurvvatām ōṣṭhādharāṇāṁ phalam īśvarāya dātavyaṁ|</para>
  <para style="p">
    <verse number="16" style="v"/>aparañca parōpakārō dānañca yuṣmābhi rna vismaryyatāṁ yatastādr̥śaṁ balidānam īśvarāya rōcatē|</para>
  <para style="p">
    <verse number="17" style="v"/>yūyaṁ svanāyakānām ājñāgrāhiṇō vaśyāśca bhavata yatō yairupanidhiḥ pratidātavyastādr̥śā lōkā iva tē yuṣmadīyātmanāṁ rakṣaṇārthaṁ jāgrati, atastē yathā sānandāstat kuryyu rna ca sārttasvarā atra yatadhvaṁ yatastēṣām ārttasvarō yuṣmākam iṣṭajanakō na bhavēt|</para>
  <para style="p">
    <verse number="18" style="v"/>aparañca yūyam asmannimittiṁ prārthanāṁ kuruta yatō vayam uttamamanōviśiṣṭāḥ sarvvatra sadācāraṁ karttum icchukāśca bhavāma iti niścitaṁ jānīmaḥ|</para>
  <para style="p">
    <verse number="19" style="v"/>viśēṣatō'haṁ yathā tvarayā yuṣmabhyaṁ puna rdīyē tadarthaṁ prārthanāyai yuṣmān adhikaṁ vinayē|</para>
  <para style="p">
    <verse number="20" style="v"/>anantaniyamasya rudhirēṇa viśiṣṭō mahān mēṣapālakō yēna mr̥tagaṇamadhyāt punarānāyi sa śāntidāyaka īśvarō</para>
  <para style="p">
    <verse number="21" style="v"/>nijābhimatasādhanāya sarvvasmin satkarmmaṇi yuṣmān siddhān karōtu, tasya dr̥ṣṭau ca yadyat tuṣṭijanakaṁ tadēva yuṣmākaṁ madhyē yīśunā khrīṣṭēna sādhayatu| tasmai mahimā sarvvadā bhūyāt| āmēn|</para>
  <para style="p">
    <verse number="22" style="v"/>hē bhrātaraḥ, vinayē'haṁ yūyam idam upadēśavākyaṁ sahadhvaṁ yatō'haṁ saṁkṣēpēṇa yuṣmān prati likhitavān|</para>
  <para style="p">
    <verse number="23" style="v"/>asmākaṁ bhrātā tīmathiyō muktō'bhavad iti jānīta, sa ca yadi tvarayā samāgacchati tarhi tēna sārddhaṁm ahaṁ yuṣmān sākṣāt kariṣyāmi|</para>
  <para style="p">
    <verse number="24" style="v"/>yuṣmākaṁ sarvvān nāyakān pavitralōkāṁśca namaskuruta| aparam itāliyādēśīyānāṁ namaskāraṁ jñāsyatha|</para>
  <para style="p">
    <verse number="25" style="v"/>anugrahō yuṣmākaṁ sarvvēṣāṁ sahāyō bhūyāt| āmēn|</para>
</usx>
