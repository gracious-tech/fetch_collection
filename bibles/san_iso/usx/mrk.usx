<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="MRK" style="id">Sanskrit Bible (NT) in ISO Script (satyavēdaḥ ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Mark</para>
  <para style="toc1">mārkalikhitaḥ susaṁvādaḥ</para>
  <para style="toc2">mārkaḥ</para>
  <para style="toc3">mārkaḥ</para>
  <para style="mt1">mārkalikhitaḥ susaṁvādaḥ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>īśvaraputrasya yīśukhrīṣṭasya susaṁvādārambhaḥ|</para>
  <para style="p">
    <verse number="2" style="v"/>bhaviṣyadvādināṁ granthēṣu lipiritthamāstē, paśya svakīyadūtantu tavāgrē prēṣayāmyaham| gatvā tvadīyapanthānaṁ sa hi pariṣkariṣyati|</para>
  <para style="p">
    <verse number="3" style="v"/>"paramēśasya panthānaṁ pariṣkuruta sarvvataḥ| tasya rājapathañcaiva samānaṁ kurutādhunā|" ityētat prāntarē vākyaṁ vadataḥ kasyacidravaḥ||</para>
  <para style="p">
    <verse number="4" style="v"/>saēva yōhan prāntarē majjitavān tathā pāpamārjananimittaṁ manōvyāvarttakamajjanasya kathāñca pracāritavān|</para>
  <para style="p">
    <verse number="5" style="v"/>tatō yihūdādēśayirūśālamnagaranivāsinaḥ sarvvē lōkā bahi rbhūtvā tasya samīpamāgatya svāni svāni pāpānyaṅgīkr̥tya yarddananadyāṁ tēna majjitā babhūvuḥ|</para>
  <para style="p">
    <verse number="6" style="v"/>asya yōhanaḥ paridhēyāni kramēlakalōmajāni, tasya kaṭibandhanaṁ carmmajātam, tasya bhakṣyāṇi ca śūkakīṭā vanyamadhūni cāsan|</para>
  <para style="p">
    <verse number="7" style="v"/>sa pracārayan kathayāñcakrē, ahaṁ namrībhūya yasya pādukābandhanaṁ mōcayitumapi na yōgyōsmi, tādr̥śō mattō gurutara ēkaḥ puruṣō matpaścādāgacchati|</para>
  <para style="p">
    <verse number="8" style="v"/>ahaṁ yuṣmān jalē majjitavān kintu sa pavitra ātmāni saṁmajjayiṣyati|</para>
  <para style="p">
    <verse number="9" style="v"/>aparañca tasminnēva kālē gālīlpradēśasya nāsaradgrāmād yīśurāgatya yōhanā yarddananadyāṁ majjitō'bhūt|</para>
  <para style="p">
    <verse number="10" style="v"/>sa jalādutthitamātrō mēghadvāraṁ muktaṁ kapōtavat svasyōpari avarōhantamātmānañca dr̥ṣṭavān|</para>
  <para style="p">
    <verse number="11" style="v"/>tvaṁ mama priyaḥ putrastvayyēva mamamahāsantōṣa iyamākāśīyā vāṇī babhūva|</para>
  <para style="p">
    <verse number="12" style="v"/>tasmin kālē ātmā taṁ prāntaramadhyaṁ nināya|</para>
  <para style="p">
    <verse number="13" style="v"/>atha sa catvāriṁśaddināni tasmin sthānē vanyapaśubhiḥ saha tiṣṭhan śaitānā parīkṣitaḥ; paścāt svargīyadūtāstaṁ siṣēvirē|</para>
  <para style="p">
    <verse number="14" style="v"/>anantaraṁ yōhani bandhanālayē baddhē sati yīśu rgālīlpradēśamāgatya īśvararājyasya susaṁvādaṁ pracārayan kathayāmāsa,</para>
  <para style="p">
    <verse number="15" style="v"/>kālaḥ sampūrṇa īśvararājyañca samīpamāgataṁ; atōhētō ryūyaṁ manāṁsi vyāvarttayadhvaṁ susaṁvādē ca viśvāsita|</para>
  <para style="p">
    <verse number="16" style="v"/>tadanantaraṁ sa gālīlīyasamudrasya tīrē gacchan śimōn tasya bhrātā andriyanāmā ca imau dvau janau matsyadhāriṇau sāgaramadhyē jālaṁ prakṣipantau dr̥ṣṭvā tāvavadat,</para>
  <para style="p">
    <verse number="17" style="v"/>yuvāṁ mama paścādāgacchataṁ, yuvāmahaṁ manuṣyadhāriṇau kariṣyāmi|</para>
  <para style="p">
    <verse number="18" style="v"/>tatastau tatkṣaṇamēva jālāni parityajya tasya paścāt jagmatuḥ|</para>
  <para style="p">
    <verse number="19" style="v"/>tataḥ paraṁ tatsthānāt kiñcid dūraṁ gatvā sa sivadīputrayākūb tadbhrātr̥yōhan ca imau naukāyāṁ jālānāṁ jīrṇamuddhārayantau dr̥ṣṭvā tāvāhūyat|</para>
  <para style="p">
    <verse number="20" style="v"/>tatastau naukāyāṁ vētanabhugbhiḥ sahitaṁ svapitaraṁ vihāya tatpaścādīyatuḥ|</para>
  <para style="p">
    <verse number="21" style="v"/>tataḥ paraṁ kapharnāhūmnāmakaṁ nagaramupasthāya sa viśrāmadivasē bhajanagrahaṁ praviśya samupadidēśa|</para>
  <para style="p">
    <verse number="22" style="v"/>tasyōpadēśāllōkā āścaryyaṁ mēnirē yataḥ sōdhyāpakāiva nōpadiśan prabhāvavāniva prōpadidēśa|</para>
  <para style="p">
    <verse number="23" style="v"/>aparañca tasmin bhajanagr̥hē apavitrabhūtēna grasta ēkō mānuṣa āsīt| sa cītśabdaṁ kr̥tvā kathayāñcakē</para>
  <para style="p">
    <verse number="24" style="v"/>bhō nāsaratīya yīśō tvamasmān tyaja, tvayā sahāsmākaṁ kaḥ sambandhaḥ? tvaṁ kimasmān nāśayituṁ samāgataḥ? tvamīśvarasya pavitralōka ityahaṁ jānāmi|</para>
  <para style="p">
    <verse number="25" style="v"/>tadā yīśustaṁ tarjayitvā jagāda tūṣṇīṁ bhava itō bahirbhava ca|</para>
  <para style="p">
    <verse number="26" style="v"/>tataḥ sō'pavitrabhūtastaṁ sampīḍya atyucaiścītkr̥tya nirjagāma|</para>
  <para style="p">
    <verse number="27" style="v"/>tēnaiva sarvvē camatkr̥tya parasparaṁ kathayāñcakrirē, ahō kimidaṁ? kīdr̥śō'yaṁ navya upadēśaḥ? anēna prabhāvēnāpavitrabhūtēṣvājñāpitēṣu tē tadājñānuvarttinō bhavanti|</para>
  <para style="p">
    <verse number="28" style="v"/>tadā tasya yaśō gālīlaścaturdiksthasarvvadēśān vyāpnōt|</para>
  <para style="p">
    <verse number="29" style="v"/>aparañca tē bhajanagr̥hād bahi rbhūtvā yākūbyōhanbhyāṁ saha śimōna āndriyasya ca nivēśanaṁ praviviśuḥ|</para>
  <para style="p">
    <verse number="30" style="v"/>tadā pitarasya śvaśrūrjvarapīḍitā śayyāyāmāsta iti tē taṁ jhaṭiti vijñāpayāñcakruḥ|</para>
  <para style="p">
    <verse number="31" style="v"/>tataḥ sa āgatya tasyā hastaṁ dhr̥tvā tāmudasthāpayat; tadaiva tāṁ jvarō'tyākṣīt tataḥ paraṁ sā tān siṣēvē|</para>
  <para style="p">
    <verse number="32" style="v"/>athāstaṁ gatē ravau sandhyākālē sati lōkāstatsamīpaṁ sarvvān rōgiṇō bhūtadhr̥tāṁśca samāninyuḥ|</para>
  <para style="p">
    <verse number="33" style="v"/>sarvvē nāgarikā lōkā dvāri saṁmilitāśca|</para>
  <para style="p">
    <verse number="34" style="v"/>tataḥ sa nānāvidharōgiṇō bahūn manujānarōgiṇaścakāra tathā bahūn bhūtān tyājayāñcakāra tān bhūtān kimapi vākyaṁ vaktuṁ niṣiṣēdha ca yatōhētōstē tamajānan|</para>
  <para style="p">
    <verse number="35" style="v"/>aparañca sō'tipratyūṣē vastutastu rātriśēṣē samutthāya bahirbhūya nirjanaṁ sthānaṁ gatvā tatra prārthayāñcakrē|</para>
  <para style="p">
    <verse number="36" style="v"/>anantaraṁ śimōn tatsaṅginaśca tasya paścād gatavantaḥ|</para>
  <para style="p">
    <verse number="37" style="v"/>taduddēśaṁ prāpya tamavadan sarvvē lōkāstvāṁ mr̥gayantē|</para>
  <para style="p">
    <verse number="38" style="v"/>tadā sō'kathayat āgacchata vayaṁ samīpasthāni nagarāṇi yāmaḥ, yatō'haṁ tatra kathāṁ pracārayituṁ bahirāgamam|</para>
  <para style="p">
    <verse number="39" style="v"/>atha sa tēṣāṁ gālīlpradēśasya sarvvēṣu bhajanagr̥hēṣu kathāḥ pracārayāñcakrē bhūtānatyājayañca|</para>
  <para style="p">
    <verse number="40" style="v"/>anantaramēkaḥ kuṣṭhī samāgatya tatsammukhē jānupātaṁ vinayañca kr̥tvā kathitavān yadi bhavān icchati tarhi māṁ pariṣkarttuṁ śaknōti|</para>
  <para style="p">
    <verse number="41" style="v"/>tataḥ kr̥pālu ryīśuḥ karau prasāryya taṁ spaṣṭvā kathayāmāsa</para>
  <para style="p">
    <verse number="42" style="v"/>mamēcchā vidyatē tvaṁ pariṣkr̥tō bhava| ētatkathāyāḥ kathanamātrāt sa kuṣṭhī rōgānmuktaḥ pariṣkr̥tō'bhavat|</para>
  <para style="p">
    <verse number="43" style="v"/>tadā sa taṁ visr̥jan gāḍhamādiśya jagāda</para>
  <para style="p">
    <verse number="44" style="v"/>sāvadhānō bhava kathāmimāṁ kamapi mā vada; svātmānaṁ yājakaṁ darśaya, lōkēbhyaḥ svapariṣkr̥tēḥ pramāṇadānāya mūsānirṇītaṁ yaddānaṁ tadutsr̥jasva ca|</para>
  <para style="p">
    <verse number="45" style="v"/>kintu sa gatvā tat karmma itthaṁ vistāryya pracārayituṁ prārēbhē tēnaiva yīśuḥ punaḥ saprakāśaṁ nagaraṁ pravēṣṭuṁ nāśaknōt tatōhētōrbahiḥ kānanasthānē tasyau; tathāpi caturddigbhyō lōkāstasya samīpamāyayuḥ|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tadanantaraṁ yīśai katipayadināni vilambya punaḥ kapharnāhūmnagaraṁ praviṣṭē sa gr̥ha āsta iti kiṁvadantyā tatkṣaṇaṁ tatsamīpaṁ bahavō lōkā āgatya samupatasthuḥ,</para>
  <para style="p">
    <verse number="2" style="v"/>tasmād gr̥hamadhyē sarvvēṣāṁ kr̥tē sthānaṁ nābhavad dvārasya caturdikṣvapi nābhavat, tatkālē sa tān prati kathāṁ pracārayāñcakrē|</para>
  <para style="p">
    <verse number="3" style="v"/>tataḥ paraṁ lōkāścaturbhi rmānavairēkaṁ pakṣāghātinaṁ vāhayitvā tatsamīpam āninyuḥ|</para>
  <para style="p">
    <verse number="4" style="v"/>kintu janānāṁ bahutvāt taṁ yīśōḥ sammukhamānētuṁ na śaknuvantō yasmin sthānē sa āstē taduparigr̥hapr̥ṣṭhaṁ khanitvā chidraṁ kr̥tvā tēna mārgēṇa saśayyaṁ pakṣāghātinam avarōhayāmāsuḥ|</para>
  <para style="p">
    <verse number="5" style="v"/>tatō yīśustēṣāṁ viśvāsaṁ dr̥ṣṭvā taṁ pakṣāghātinaṁ babhāṣē hē vatsa tava pāpānāṁ mārjanaṁ bhavatu|</para>
  <para style="p">
    <verse number="6" style="v"/>tadā kiyantō'dhyāpakāstatrōpaviśantō manōbhi rvitarkayāñcakruḥ, ēṣa manuṣya ētādr̥śīmīśvaranindāṁ kathāṁ kutaḥ kathayati?</para>
  <para style="p">
    <verse number="7" style="v"/>īśvaraṁ vinā pāpāni mārṣṭuṁ kasya sāmarthyam āstē?</para>
  <para style="p">
    <verse number="8" style="v"/>itthaṁ tē vitarkayanti yīśustatkṣaṇaṁ manasā tad budvvā tānavadad yūyamantaḥkaraṇaiḥ kuta ētāni vitarkayatha?</para>
  <para style="p">
    <verse number="9" style="v"/>tadanantaraṁ yīśustatsthānāt punaḥ samudrataṭaṁ yayau; lōkanivahē tatsamīpamāgatē sa tān samupadidēśa|</para>
  <para style="p">
    <verse number="10" style="v"/>kintu pr̥thivyāṁ pāpāni mārṣṭuṁ manuṣyaputrasya sāmarthyamasti, ētad yuṣmān jñāpayituṁ (sa tasmai pakṣāghātinē kathayāmāsa)</para>
  <para style="p">
    <verse number="11" style="v"/>uttiṣṭha tava śayyāṁ gr̥hītvā svagr̥haṁ yāhi, ahaṁ tvāmidam ājñāpayāmi|</para>
  <para style="p">
    <verse number="12" style="v"/>tataḥ sa tatkṣaṇam utthāya śayyāṁ gr̥hītvā sarvvēṣāṁ sākṣāt jagāma; sarvvē vismitā ētādr̥śaṁ karmma vayam kadāpi nāpaśyāma, imāṁ kathāṁ kathayitvēśvaraṁ dhanyamabruvan|</para>
  <para style="p">
    <verse number="13" style="v"/>tadanantaraṁ yīśustatsthānāt punaḥ samudrataṭaṁ yayau; lōkanivahē tatsamīpamāgatē sa tān samupadidēśa|</para>
  <para style="p">
    <verse number="14" style="v"/>atha gacchan karasañcayagr̥ha upaviṣṭam ālphīyaputraṁ lēviṁ dr̥ṣṭvā tamāhūya kathitavān matpaścāt tvāmāmaccha tataḥ sa utthāya tatpaścād yayau|</para>
  <para style="p">
    <verse number="15" style="v"/>anantaraṁ yīśau tasya gr̥hē bhōktum upaviṣṭē bahavaḥ karamañcāyinaḥ pāpinaśca tēna tacchiṣyaiśca sahōpaviviśuḥ, yatō bahavastatpaścādājagmuḥ|</para>
  <para style="p">
    <verse number="16" style="v"/>tadā sa karamañcāyibhiḥ pāpibhiśca saha khādati, tad dr̥ṣṭvādhyāpakāḥ phirūśinaśca tasya śiṣyānūcuḥ karamañcāyibhiḥ pāpibhiśca sahāyaṁ kutō bhuṁktē pivati ca?</para>
  <para style="p">
    <verse number="17" style="v"/>tadvākyaṁ śrutvā yīśuḥ pratyuvāca,arōgilōkānāṁ cikitsakēna prayōjanaṁ nāsti, kintu rōgiṇāmēva; ahaṁ dhārmmikānāhvātuṁ nāgataḥ kintu manō vyāvarttayituṁ pāpina ēva|</para>
  <para style="p">
    <verse number="18" style="v"/>tataḥ paraṁ yōhanaḥ phirūśināñcōpavāsācāriśiṣyā yīśōḥ samīpam āgatya kathayāmāsuḥ, yōhanaḥ phirūśināñca śiṣyā upavasanti kintu bhavataḥ śiṣyā nōpavasanti kiṁ kāraṇamasya?</para>
  <para style="p">
    <verse number="19" style="v"/>tadā yīśustān babhāṣē yāvat kālaṁ sakhibhiḥ saha kanyāyā varastiṣṭhati tāvatkālaṁ tē kimupavastuṁ śaknuvanti? yāvatkālaṁ varastaiḥ saha tiṣṭhati tāvatkālaṁ ta upavastuṁ na śaknuvanti|</para>
  <para style="p">
    <verse number="20" style="v"/>yasmin kālē tēbhyaḥ sakāśād varō nēṣyatē sa kāla āgacchati, tasmin kālē tē janā upavatsyanti|</para>
  <para style="p">
    <verse number="21" style="v"/>kōpi janaḥ purātanavastrē nūtanavastraṁ na sīvyati, yatō nūtanavastrēṇa saha sēvanē kr̥tē jīrṇaṁ vastraṁ chidyatē tasmāt puna rmahat chidraṁ jāyatē|</para>
  <para style="p">
    <verse number="22" style="v"/>kōpi janaḥ purātanakutūṣu nūtanaṁ drākṣārasaṁ na sthāpayati, yatō nūtanadrākṣārasasya tējasā tāḥ kutvō vidīryyantē tatō drākṣārasaśca patati kutvaśca naśyanti, ataēva nūtanadrākṣārasō nūtanakutūṣu sthāpanīyaḥ|</para>
  <para style="p">
    <verse number="23" style="v"/>tadanantaraṁ yīśu ryadā viśrāmavārē śasyakṣētrēṇa gacchati tadā tasya śiṣyā gacchantaḥ śasyamañjarīśchēttuṁ pravr̥ttāḥ|</para>
  <para style="p">
    <verse number="24" style="v"/>ataḥ phirūśinō yīśavē kathayāmāsuḥ paśyatu viśrāmavāsarē yat karmma na karttavyaṁ tad imē kutaḥ kurvvanti?</para>
  <para style="p">
    <verse number="25" style="v"/>tadā sa tēbhyō'kathayat dāyūd tatsaṁṅginaśca bhakṣyābhāvāt kṣudhitāḥ santō yat karmma kr̥tavantastat kiṁ yuṣmābhi rna paṭhitam?</para>
  <para style="p">
    <verse number="26" style="v"/>abiyātharnāmakē mahāyājakatāṁ kurvvati sa kathamīśvarasyāvāsaṁ praviśya yē darśanīyapūpā yājakān vinānyasya kasyāpi na bhakṣyāstānēva bubhujē saṅgilōkēbhyō'pi dadau|</para>
  <para style="p">
    <verse number="27" style="v"/>sō'paramapi jagāda, viśrāmavārō manuṣyārthamēva nirūpitō'sti kintu manuṣyō viśrāmavārārthaṁ naiva|</para>
  <para style="p">
    <verse number="28" style="v"/>manuṣyaputrō viśrāmavārasyāpi prabhurāstē|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ yīśuḥ puna rbhajanagr̥haṁ praviṣṭastasmin sthānē śuṣkahasta ēkō mānava āsīt|</para>
  <para style="p">
    <verse number="2" style="v"/>sa viśrāmavārē tamarōgiṇaṁ kariṣyati navētyatra bahavastam apavadituṁ chidramapēkṣitavantaḥ|</para>
  <para style="p">
    <verse number="3" style="v"/>tadā sa taṁ śuṣkahastaṁ manuṣyaṁ jagāda madhyasthānē tvamuttiṣṭha|</para>
  <para style="p">
    <verse number="4" style="v"/>tataḥ paraṁ sa tān papraccha viśrāmavārē hitamahitaṁ tathā hi prāṇarakṣā vā prāṇanāśa ēṣāṁ madhyē kiṁ karaṇīyaṁ ? kintu tē niḥśabdāstasthuḥ|</para>
  <para style="p">
    <verse number="5" style="v"/>tadā sa tēṣāmantaḥkaraṇānāṁ kāṭhinyāddhētō rduḥkhitaḥ krōdhāt cartuिdaśō dr̥ṣṭavān taṁ mānuṣaṁ gaditavān taṁ hastaṁ vistāraya, tatastēna hastē vistr̥tē taddhastō'nyahastavad arōgō jātaḥ|</para>
  <para style="p">
    <verse number="6" style="v"/>atha phirūśinaḥ prasthāya taṁ nāśayituṁ hērōdīyaiḥ saha mantrayitumārēbhirē|</para>
  <para style="p">
    <verse number="7" style="v"/>ataēva yīśustatsthānaṁ parityajya śiṣyaiḥ saha punaḥ sāgarasamīpaṁ gataḥ;</para>
  <para style="p">
    <verse number="8" style="v"/>tatō gālīlyihūdā-yirūśālam-idōm-yardannadīpārasthānēbhyō lōkasamūhastasya paścād gataḥ; tadanyaḥ sōrasīdanōḥ samīpavāsilōkasamūhaśca tasya mahākarmmaṇāṁ vārttaṁ śrutvā tasya sannidhimāgataḥ|</para>
  <para style="p">
    <verse number="9" style="v"/>tadā lōkasamūhaścēt tasyōpari patati ityāśaṅkya sa nāvamēkāṁ nikaṭē sthāpayituṁ śiṣyānādiṣṭavān|</para>
  <para style="p">
    <verse number="10" style="v"/>yatō'nēkamanuṣyāṇāmārōgyakaraṇād vyādhigrastāḥ sarvvē taṁ spraṣṭuṁ parasparaṁ balēna yatnavantaḥ|</para>
  <para style="p">
    <verse number="11" style="v"/>aparañca apavitrabhūtāstaṁ dr̥ṣṭvā taccaraṇayōḥ patitvā prōcaiḥ prōcuḥ, tvamīśvarasya putraḥ|</para>
  <para style="p">
    <verse number="12" style="v"/>kintu sa tān dr̥ḍham ājñāpya svaṁ paricāyituṁ niṣiddhavān|</para>
  <para style="p">
    <verse number="13" style="v"/>anantaraṁ sa parvvatamāruhya yaṁ yaṁ praticchā taṁ tamāhūtavān tatastē tatsamīpamāgatāḥ|</para>
  <para style="p">
    <verse number="14" style="v"/>tadā sa dvādaśajanān svēna saha sthātuṁ susaṁvādapracārāya prēritā bhavituṁ</para>
  <para style="p">
    <verse number="15" style="v"/>sarvvaprakāravyādhīnāṁ śamanakaraṇāya prabhāvaṁ prāptuṁ bhūtān tyājayituñca niyuktavān|</para>
  <para style="p">
    <verse number="16" style="v"/>tēṣāṁ nāmānīmāni, śimōn sivadiputrō</para>
  <para style="p">
    <verse number="17" style="v"/>yākūb tasya bhrātā yōhan ca āndriyaḥ philipō barthalamayaḥ,</para>
  <para style="p">
    <verse number="18" style="v"/>mathī thōmā ca ālphīyaputrō yākūb thaddīyaḥ kinānīyaḥ śimōn yastaṁ parahastēṣvarpayiṣyati sa īṣkariyōtīyayihūdāśca|</para>
  <para style="p">
    <verse number="19" style="v"/>sa śimōnē pitara ityupanāma dadau yākūbyōhanbhyāṁ ca binērigiś arthatō mēghanādaputrāvityupanāma dadau|</para>
  <para style="p">
    <verse number="20" style="v"/>anantaraṁ tē nivēśanaṁ gatāḥ, kintu tatrāpi punarmahān janasamāgamō 'bhavat tasmāttē bhōktumapyavakāśaṁ na prāptāḥ|</para>
  <para style="p">
    <verse number="21" style="v"/>tatastasya suhr̥llōkā imāṁ vārttāṁ prāpya sa hatajñānōbhūd iti kathāṁ kathayitvā taṁ dhr̥tvānētuṁ gatāḥ|</para>
  <para style="p">
    <verse number="22" style="v"/>aparañca yirūśālama āgatā yē yē'dhyāpakāstē jagadurayaṁ puruṣō bhūtapatyābiṣṭastēna bhūtapatinā bhūtān tyājayati|</para>
  <para style="p">
    <verse number="23" style="v"/>tatastānāhūya yīśu rdr̥ṣṭāntaiḥ kathāṁ kathitavān śaitān kathaṁ śaitānaṁ tyājayituṁ śaknōti?</para>
  <para style="p">
    <verse number="24" style="v"/>kiñcana rājyaṁ yadi svavirōdhēna pr̥thag bhavati tarhi tad rājyaṁ sthiraṁ sthātuṁ na śaknōti|</para>
  <para style="p">
    <verse number="25" style="v"/>tathā kasyāpi parivārō yadi parasparaṁ virōdhī bhavati tarhi sōpi parivāraḥ sthiraṁ sthātuṁ na śaknōti|</para>
  <para style="p">
    <verse number="26" style="v"/>tadvat śaitān yadi svavipakṣatayā uttiṣṭhan bhinnō bhavati tarhi sōpi sthiraṁ sthātuṁ na śaknōti kintūcchinnō bhavati|</para>
  <para style="p">
    <verse number="27" style="v"/>aparañca prabalaṁ janaṁ prathamaṁ na baddhā kōpi tasya gr̥haṁ praviśya dravyāṇi luṇṭhayituṁ na śaknōti, taṁ badvvaiva tasya gr̥hasya dravyāṇi luṇṭhayituṁ śaknōti|</para>
  <para style="p">
    <verse number="28" style="v"/>atōhētō ryuṣmabhyamahaṁ satyaṁ kathayāmi manuṣyāṇāṁ santānā yāni yāni pāpānīśvaranindāñca kurvvanti tēṣāṁ tatsarvvēṣāmaparādhānāṁ kṣamā bhavituṁ śaknōti,</para>
  <para style="p">
    <verse number="29" style="v"/>kintu yaḥ kaścit pavitramātmānaṁ nindati tasyāparādhasya kṣamā kadāpi na bhaviṣyati sōnantadaṇḍasyārhō bhaviṣyati|</para>
  <para style="p">
    <verse number="30" style="v"/>tasyāpavitrabhūtō'sti tēṣāmētatkathāhētōḥ sa itthaṁ kathitavān|</para>
  <para style="p">
    <verse number="31" style="v"/>atha tasya mātā bhrātr̥gaṇaścāgatya bahistiṣṭhanatō lōkān prēṣya tamāhūtavantaḥ|</para>
  <para style="p">
    <verse number="32" style="v"/>tatastatsannidhau samupaviṣṭā lōkāstaṁ babhāṣirē paśya bahistava mātā bhrātaraśca tvām anvicchanti|</para>
  <para style="p">
    <verse number="33" style="v"/>tadā sa tān pratyuvāca mama mātā kā bhrātarō vā kē? tataḥ paraṁ sa svamīpōpaviṣṭān śiṣyān prati avalōkanaṁ kr̥tvā kathayāmāsa</para>
  <para style="p">
    <verse number="34" style="v"/>paśyataitē mama mātā bhrātaraśca|</para>
  <para style="p">
    <verse number="35" style="v"/>yaḥ kaścid īśvarasyēṣṭāṁ kriyāṁ karōti sa ēva mama bhrātā bhaginī mātā ca|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ sa samudrataṭē punarupadēṣṭuṁ prārēbhē, tatastatra bahujanānāṁ samāgamāt sa sāgarōpari naukāmāruhya samupaviṣṭaḥ; sarvvē lōkāḥ samudrakūlē tasthuḥ|</para>
  <para style="p">
    <verse number="2" style="v"/>tadā sa dr̥ṣṭāntakathābhi rbahūpadiṣṭavān upadiśaṁśca kathitavān,</para>
  <para style="p">
    <verse number="3" style="v"/>avadhānaṁ kuruta, ēkō bījavaptā bījāni vaptuṁ gataḥ;</para>
  <para style="p">
    <verse number="4" style="v"/>vapanakālē kiyanti bījāni mārgapāśvē patitāni, tata ākāśīyapakṣiṇa ētya tāni cakhāduḥ|</para>
  <para style="p">
    <verse number="5" style="v"/>kiyanti bījāni svalpamr̥ttikāvatpāṣāṇabhūmau patitāni tāni mr̥dōlpatvāt śīghramaṅkuritāni;</para>
  <para style="p">
    <verse number="6" style="v"/>kintūditē sūryyē dagdhāni tathā mūlānō nādhōgatatvāt śuṣkāṇi ca|</para>
  <para style="p">
    <verse number="7" style="v"/>kiyanti bījāni kaṇṭakivanamadhyē patitāni tataḥ kaṇṭakāni saṁvr̥dvya tāni jagrasustāni na ca phalitāni|</para>
  <para style="p">
    <verse number="8" style="v"/>tathā kiyanti bījānyuttamabhūmau patitāni tāni saṁvr̥dvya phalānyutpāditāni kiyanti bījāni triṁśadguṇāni kiyanti ṣaṣṭiguṇāni kiyanti śataguṇāni phalāni phalitavanti|</para>
  <para style="p">
    <verse number="9" style="v"/>atha sa tānavadat yasya śrōtuṁ karṇau staḥ sa śr̥ṇōtu|</para>
  <para style="p">
    <verse number="10" style="v"/>tadanantaraṁ nirjanasamayē tatsaṅginō dvādaśaśiṣyāśca taṁ taddr̥ṣṭāntavākyasyārthaṁ papracchuḥ|</para>
  <para style="p">
    <verse number="11" style="v"/>tadā sa tānuditavān īśvararājyasya nigūḍhavākyaṁ bōddhuṁ yuṣmākamadhikārō'sti;</para>
  <para style="p">
    <verse number="12" style="v"/>kintu yē vahirbhūtāḥ "tē paśyantaḥ paśyanti kintu na jānanti, śr̥ṇvantaḥ śr̥ṇvanti kintu na budhyantē, cēttai rmanaḥsu kadāpi parivarttitēṣu tēṣāṁ pāpānyamōcayiṣyanta," atōhētōstān prati dr̥ṣṭāntairēva tāni mayā kathitāni|</para>
  <para style="p">
    <verse number="13" style="v"/>atha sa kathitavān yūyaṁ kimētad dr̥ṣṭāntavākyaṁ na budhyadhvē? tarhi kathaṁ sarvvān dr̥ṣṭāntāna bhōtsyadhvē?</para>
  <para style="p">
    <verse number="14" style="v"/>bījavaptā vākyarūpāṇi bījāni vapati;</para>
  <para style="p">
    <verse number="15" style="v"/>tatra yē yē lōkā vākyaṁ śr̥ṇvanti, kintu śrutamātrāt śaitān śīghramāgatya tēṣāṁ manaḥsūptāni tāni vākyarūpāṇi bījānyapanayati taēva uptabījamārgapārśvēsvarūpāḥ|</para>
  <para style="p">
    <verse number="16" style="v"/>yē janā vākyaṁ śrutvā sahasā paramānandēna gr̥hlanti, kintu hr̥di sthairyyābhāvāt kiñcit kālamātraṁ tiṣṭhanti tatpaścāt tadvākyahētōḥ</para>
  <para style="p">
    <verse number="17" style="v"/>kutracit klēśē upadravē vā samupasthitē tadaiva vighnaṁ prāpnuvanti taēva uptabījapāṣāṇabhūmisvarūpāḥ|</para>
  <para style="p">
    <verse number="18" style="v"/>yē janāḥ kathāṁ śr̥ṇvanti kintu sāṁsārikī cintā dhanabhrānti rviṣayalōbhaśca ētē sarvvē upasthāya tāṁ kathāṁ grasanti tataḥ mā viphalā bhavati</para>
  <para style="p">
    <verse number="19" style="v"/>taēva uptabījasakaṇṭakabhūmisvarūpāḥ|</para>
  <para style="p">
    <verse number="20" style="v"/>yē janā vākyaṁ śrutvā gr̥hlanti tēṣāṁ kasya vā triṁśadguṇāni kasya vā ṣaṣṭiguṇāni kasya vā śataguṇāni phalāni bhavanti taēva uptabījōrvvarabhūmisvarūpāḥ|</para>
  <para style="p">
    <verse number="21" style="v"/>tadā sō'paramapi kathitavān kōpi janō dīpādhāraṁ parityajya drōṇasyādhaḥ khaṭvāyā adhē vā sthāpayituṁ dīpamānayati kiṁ?</para>
  <para style="p">
    <verse number="22" style="v"/>atōhētō ryanna prakāśayiṣyatē tādr̥g lukkāyitaṁ kimapi vastu nāsti; yad vyaktaṁ na bhaviṣyati tādr̥śaṁ guptaṁ kimapi vastu nāsti|</para>
  <para style="p">
    <verse number="23" style="v"/>yasya śrōtuṁ karṇau staḥ sa śr̥ṇōtu|</para>
  <para style="p">
    <verse number="24" style="v"/>aparamapi kathitavān yūyaṁ yad yad vākyaṁ śr̥ṇutha tatra sāvadhānā bhavata, yatō yūyaṁ yēna parimāṇēna parimātha tēnaiva parimāṇēna yuṣmadarthamapi parimāsyatē; śrōtārō yūyaṁ yuṣmabhyamadhikaṁ dāsyatē|</para>
  <para style="p">
    <verse number="25" style="v"/>yasyāśrayē varddhatē tasmai aparamapi dāsyatē, kintu yasyāśrayē na varddhatē tasya yat kiñcidasti tadapi tasmān nēṣyatē|</para>
  <para style="p">
    <verse number="26" style="v"/>anantaraṁ sa kathitavān ēkō lōkaḥ kṣētrē bījānyuptvā</para>
  <para style="p">
    <verse number="27" style="v"/>jāgaraṇanidrābhyāṁ divāniśaṁ gamayati, parantu tadvījaṁ tasyājñātarūpēṇāṅkurayati varddhatē ca;</para>
  <para style="p">
    <verse number="28" style="v"/>yatōhētōḥ prathamataḥ patrāṇi tataḥ paraṁ kaṇiśāni tatpaścāt kaṇiśapūrṇāni śasyāni bhūmiḥ svayamutpādayati;</para>
  <para style="p">
    <verse number="29" style="v"/>kintu phalēṣu pakkēṣu śasyacchēdanakālaṁ jñātvā sa tatkṣaṇaṁ śasyāni chinatti, anēna tulyamīśvararājyaṁ|</para>
  <para style="p">
    <verse number="30" style="v"/>punaḥ sō'kathayad īśvararājyaṁ kēna samaṁ? kēna vastunā saha vā tadupamāsyāmi?</para>
  <para style="p">
    <verse number="31" style="v"/>tat sarṣapaikēna tulyaṁ yatō mr̥di vapanakālē sarṣapabījaṁ sarvvapr̥thivīsthabījāt kṣudraṁ</para>
  <para style="p">
    <verse number="32" style="v"/>kintu vapanāt param aṅkurayitvā sarvvaśākād br̥had bhavati, tasya br̥hatyaḥ śākhāśca jāyantē tatastacchāyāṁ pakṣiṇa āśrayantē|</para>
  <para style="p">
    <verse number="33" style="v"/>itthaṁ tēṣāṁ bōdhānurūpaṁ sō'nēkadr̥ṣṭāntaistānupadiṣṭavān,</para>
  <para style="p">
    <verse number="34" style="v"/>dr̥ṣṭāntaṁ vinā kāmapi kathāṁ tēbhyō na kathitavān paścān nirjanē sa śiṣyān sarvvadr̥ṣṭāntārthaṁ bōdhitavān|</para>
  <para style="p">
    <verse number="35" style="v"/>taddinasya sandhyāyāṁ sa tēbhyō'kathayad āgacchata vayaṁ pāraṁ yāma|</para>
  <para style="p">
    <verse number="36" style="v"/>tadā tē lōkān visr̥jya tamavilambaṁ gr̥hītvā naukayā pratasthirē; aparā api nāvastayā saha sthitāḥ|</para>
  <para style="p">
    <verse number="37" style="v"/>tataḥ paraṁ mahājhañbhśagamāt nau rdōlāyamānā taraṅgēṇa jalaiḥ pūrṇābhavacca|</para>
  <para style="p">
    <verse number="38" style="v"/>tadā sa naukācaścādbhāgē upadhānē śirō nidhāya nidrita āsīt tatastē taṁ jāgarayitvā jagaduḥ, hē prabhō, asmākaṁ prāṇā yānti kimatra bhavataścintā nāsti?</para>
  <para style="p">
    <verse number="39" style="v"/>tadā sa utthāya vāyuṁ tarjitavān samudrañcōktavān śāntaḥ susthiraśca bhava; tatō vāyau nivr̥ttē'bdhirnistaraṅgōbhūt|</para>
  <para style="p">
    <verse number="40" style="v"/>tadā sa tānuvāca yūyaṁ kuta ētādr̥kśaṅkākulā bhavata? kiṁ vō viśvāsō nāsti?</para>
  <para style="p">
    <verse number="41" style="v"/>tasmāttē'tīvabhītāḥ parasparaṁ vaktumārēbhirē, ahō vāyuḥ sindhuścāsya nidēśagrāhiṇau kīdr̥gayaṁ manujaḥ|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>atha tū sindhupāraṁ gatvā gidērīyapradēśa upatasthuḥ|</para>
  <para style="p">
    <verse number="2" style="v"/>naukātō nirgatamātrād apavitrabhūtagrasta ēkaḥ śmaśānādētya taṁ sākṣāc cakāra|</para>
  <para style="p">
    <verse number="3" style="v"/>sa śmaśānē'vātsīt kōpi taṁ śr̥ṅkhalēna badvvā sthāpayituṁ nāśaknōt|</para>
  <para style="p">
    <verse number="4" style="v"/>janairvāraṁ nigaḍaiḥ śr̥ṅkhalaiśca sa baddhōpi śr̥ṅkhalānyākr̥ṣya mōcitavān nigaḍāni ca bhaṁktvā khaṇḍaṁ khaṇḍaṁ kr̥tavān kōpi taṁ vaśīkarttuṁ na śaśaka|</para>
  <para style="p">
    <verse number="5" style="v"/>divāniśaṁ sadā parvvataṁ śmaśānañca bhramitvā cītśabdaṁ kr̥tavān grāvabhiśca svayaṁ svaṁ kr̥tavān|</para>
  <para style="p">
    <verse number="6" style="v"/>sa yīśuṁ dūrāt paśyannēva dhāvan taṁ praṇanāma ucairuvaṁścōvāca,</para>
  <para style="p">
    <verse number="7" style="v"/>hē sarvvōparisthēśvaraputra yīśō bhavatā saha mē kaḥ sambandhaḥ? ahaṁ tvāmīśvarēṇa śāpayē māṁ mā yātaya|</para>
  <para style="p">
    <verse number="8" style="v"/>yatō yīśustaṁ kathitavān rē apavitrabhūta, asmānnarād bahirnirgaccha|</para>
  <para style="p">
    <verse number="9" style="v"/>atha sa taṁ pr̥ṣṭavān kintē nāma? tēna pratyuktaṁ vayamanēkē 'smastatō'smannāma bāhinī|</para>
  <para style="p">
    <verse number="10" style="v"/>tatōsmān dēśānna prēṣayēti tē taṁ prārthayanta|</para>
  <para style="p">
    <verse number="11" style="v"/>tadānīṁ parvvataṁ nikaṣā br̥han varāhavrajaścarannāsīt|</para>
  <para style="p">
    <verse number="12" style="v"/>tasmād bhūtā vinayēna jagaduḥ, amuṁ varāhavrajam āśrayitum asmān prahiṇu|</para>
  <para style="p">
    <verse number="13" style="v"/>yīśunānujñātāstē'pavitrabhūtā bahirniryāya varāhavrajaṁ prāviśan tataḥ sarvvē varāhā vastutastu prāyōdvisahasrasaṁṅkhyakāḥ kaṭakēna mahājavād dhāvantaḥ sindhau prāṇān jahuḥ|</para>
  <para style="p">
    <verse number="14" style="v"/>tasmād varāhapālakāḥ palāyamānāḥ purē grāmē ca tadvārttaṁ kathayāñcakruḥ| tadā lōkā ghaṭitaṁ tatkāryyaṁ draṣṭuṁ bahirjagmuḥ</para>
  <para style="p">
    <verse number="15" style="v"/>yīśōḥ sannidhiṁ gatvā taṁ bhūtagrastam arthād bāhinībhūtagrastaṁ naraṁ savastraṁ sacētanaṁ samupaviṣṭañca dr̥ृṣṭvā bibhyuḥ|</para>
  <para style="p">
    <verse number="16" style="v"/>tatō dr̥ṣṭatatkāryyalōkāstasya bhūtagrastanarasya varāhavrajasyāpi tāṁ dhaṭanāṁ varṇayāmāsuḥ|</para>
  <para style="p">
    <verse number="17" style="v"/>tatastē svasīmātō bahirgantuṁ yīśuṁ vinētumārēbhirē|</para>
  <para style="p">
    <verse number="18" style="v"/>atha tasya naukārōhaṇakālē sa bhūtamuktō nā yīśunā saha sthātuṁ prārthayatē;</para>
  <para style="p">
    <verse number="19" style="v"/>kintu sa tamananumatya kathitavān tvaṁ nijātmīyānāṁ samīpaṁ gr̥hañca gaccha prabhustvayi kr̥pāṁ kr̥tvā yāni karmmāṇi kr̥tavān tāni tān jñāpaya|</para>
  <para style="p">
    <verse number="20" style="v"/>ataḥ sa prasthāya yīśunā kr̥taṁ tatsarvvāścaryyaṁ karmma dikāpalidēśē pracārayituṁ prārabdhavān tataḥ sarvvē lōkā āścaryyaṁ mēnirē|</para>
  <para style="p">
    <verse number="21" style="v"/>anantaraṁ yīśau nāvā punaranyapāra uttīrṇē sindhutaṭē ca tiṣṭhati sati tatsamīpē bahulōkānāṁ samāgamō'bhūt|</para>
  <para style="p">
    <verse number="22" style="v"/>aparaṁ yāyīr nāmnā kaścid bhajanagr̥hasyādhipa āgatya taṁ dr̥ṣṭvaiva caraṇayōḥ patitvā bahu nivēdya kathitavān;</para>
  <para style="p">
    <verse number="23" style="v"/>mama kanyā mr̥taprāyābhūd atō bhavānētya tadārōgyāya tasyā gātrē hastam arpayatu tēnaiva sā jīviṣyati|</para>
  <para style="p">
    <verse number="24" style="v"/>tadā yīśustēna saha calitaḥ kintu tatpaścād bahulōkāścalitvā tādgātrē patitāḥ|</para>
  <para style="p">
    <verse number="25" style="v"/>atha dvādaśavarṣāṇi pradararōgēṇa</para>
  <para style="p">
    <verse number="26" style="v"/>śīrṇā cikitsakānāṁ nānācikitsābhiśca duḥkhaṁ bhuktavatī ca sarvvasvaṁ vyayitvāpi nārōgyaṁ prāptā ca punarapi pīḍitāsīcca</para>
  <para style="p">
    <verse number="27" style="v"/>yā strī sā yīśō rvārttāṁ prāpya manasākathayat yadyahaṁ tasya vastramātra spraṣṭuṁ labhēyaṁ tadā rōgahīnā bhaviṣyāmi|</para>
  <para style="p">
    <verse number="28" style="v"/>atōhētōḥ sā lōkāraṇyamadhyē tatpaścādāgatya tasya vastraṁ pasparśa|</para>
  <para style="p">
    <verse number="29" style="v"/>tēnaiva tatkṣaṇaṁ tasyā raktasrōtaḥ śuṣkaṁ svayaṁ tasmād rōgānmuktā ityapi dēhē'nubhūtā|</para>
  <para style="p">
    <verse number="30" style="v"/>atha svasmāt śakti rnirgatā yīśurētanmanasā jñātvā lōkanivahaṁ prati mukhaṁ vyāvr̥tya pr̥ṣṭavān kēna madvastraṁ spr̥ṣṭaṁ?</para>
  <para style="p">
    <verse number="31" style="v"/>tatastasya śiṣyā ūcuḥ bhavatō vapuṣi lōkāḥ saṁgharṣanti tad dr̥ṣṭvā kēna madvastraṁ spr̥ṣṭamiti kutaḥ kathayati?</para>
  <para style="p">
    <verse number="32" style="v"/>kintu kēna tat karmma kr̥taṁ tad draṣṭuṁ yīśuścaturdiśō dr̥ṣṭavān|</para>
  <para style="p">
    <verse number="33" style="v"/>tataḥ sā strī bhītā kampitā ca satī svasyā rukpratikriyā jātēti jñātvāgatya tatsammukhē patitvā sarvvavr̥ttāntaṁ satyaṁ tasmai kathayāmāsa|</para>
  <para style="p">
    <verse number="34" style="v"/>tadānīṁ yīśustāṁ gaditavān, hē kanyē tava pratītistvām arōgāmakarōt tvaṁ kṣēmēṇa vraja svarōgānmuktā ca tiṣṭha|</para>
  <para style="p">
    <verse number="35" style="v"/>itivākyavadanakālē bhajanagr̥hādhipasya nivēśanāl lōkā ētyādhipaṁ babhāṣirē tava kanyā mr̥tā tasmād guruṁ punaḥ kutaḥ kliśnāsi?</para>
  <para style="p">
    <verse number="36" style="v"/>kintu yīśustad vākyaṁ śrutvaiva bhajanagr̥hādhipaṁ gaditavān mā bhaiṣīḥ kēvalaṁ viśvāsihi|</para>
  <para style="p">
    <verse number="37" style="v"/>atha pitarō yākūb tadbhrātā yōhan ca ētān vinā kamapi svapaścād yātuṁ nānvamanyata|</para>
  <para style="p">
    <verse number="38" style="v"/>tasya bhajanagr̥hādhipasya nivēśanasamīpam āgatya kalahaṁ bahurōdanaṁ vilāpañca kurvvatō lōkān dadarśa|</para>
  <para style="p">
    <verse number="39" style="v"/>tasmān nivēśanaṁ praviśya prōktavān yūyaṁ kuta itthaṁ kalahaṁ rōdanañca kurutha? kanyā na mr̥tā nidrāti|</para>
  <para style="p">
    <verse number="40" style="v"/>tasmāttē tamupajahasuḥ kintu yīśuḥ sarvvāna bahiṣkr̥tya kanyāyāḥ pitarau svasaṅginaśca gr̥hītvā yatra kanyāsīt tat sthānaṁ praviṣṭavān|</para>
  <para style="p">
    <verse number="41" style="v"/>atha sa tasyāḥ kanyāyā hastau dhr̥tvā tāṁ babhāṣē ṭālīthā kūmī, arthatō hē kanyē tvamuttiṣṭha ityājñāpayāmi|</para>
  <para style="p">
    <verse number="42" style="v"/>tunaiva tatkṣaṇaṁ sā dvādaśavarṣavayaskā kanyā pōtthāya calitumārēbhē, itaḥ sarvvē mahāvismayaṁ gatāḥ|</para>
  <para style="p">
    <verse number="43" style="v"/>tata ētasyai kiñcit khādyaṁ dattēti kathayitvā ētatkarmma kamapi na jñāpayatēti dr̥ḍhamādiṣṭavān|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ sa tatsthānāt prasthāya svapradēśamāgataḥ śiṣyāśca tatpaścād gatāḥ|</para>
  <para style="p">
    <verse number="2" style="v"/>atha viśrāmavārē sati sa bhajanagr̥hē upadēṣṭumārabdhavān tatō'nēkē lōkāstatkathāṁ śrutvā vismitya jagaduḥ, asya manujasya īdr̥śī āścaryyakriyā kasmāj jātā? tathā svakarābhyām itthamadbhutaṁ karmma karttāुm ētasmai kathaṁ jñānaṁ dattam?</para>
  <para style="p">
    <verse number="3" style="v"/>kimayaṁ mariyamaḥ putrastajñā nō? kimayaṁ yākūb-yōsi-yihudā-śimōnāṁ bhrātā nō? asya bhaginyaḥ kimihāsmābhiḥ saha nō? itthaṁ tē tadarthē pratyūhaṁ gatāḥ|</para>
  <para style="p">
    <verse number="4" style="v"/>tadā yīśustēbhyō'kathayat svadēśaṁ svakuṭumbān svaparijanāṁśca vinā kutrāpi bhaviṣyadvādī asatkr̥tō na bhavati|</para>
  <para style="p">
    <verse number="5" style="v"/>aparañca tēṣāmapratyayāt sa vismitaḥ kiyatāṁ rōgiṇāṁ vapuḥṣu hastam arpayitvā kēvalaṁ tēṣāmārōgyakaraṇād anyat kimapi citrakāryyaṁ karttāṁ na śaktaḥ|</para>
  <para style="p">
    <verse number="6" style="v"/>atha sa caturdikstha grāmān bhramitvā upadiṣṭavān</para>
  <para style="p">
    <verse number="7" style="v"/>dvādaśaśiṣyān āhūya amēdhyabhūtān vaśīkarttāṁ śaktiṁ dattvā tēṣāṁ dvau dvau janō prēṣitavān|</para>
  <para style="p">
    <verse number="8" style="v"/>punarityādiśad yūyam ēkaikāṁ yaṣṭiṁ vinā vastrasaṁpuṭaḥ pūpaḥ kaṭibandhē tāmrakhaṇḍañca ēṣāṁ kimapi mā grahlīta,</para>
  <para style="p">
    <verse number="9" style="v"/>mārgayātrāyai pādēṣūpānahau dattvā dvē uttarīyē mā paridhadvvaṁ|</para>
  <para style="p">
    <verse number="10" style="v"/>aparamapyuktaṁ tēna yūyaṁ yasyāṁ puryyāṁ yasya nivēśanaṁ pravēkṣyatha tāṁ purīṁ yāvanna tyakṣyatha tāvat tannivēśanē sthāsyatha|</para>
  <para style="p">
    <verse number="11" style="v"/>tatra yadi kēpi yuṣmākamātithyaṁ na vidadhati yuṣmākaṁ kathāśca na śr̥ṇvanti tarhi tatsthānāt prasthānasamayē tēṣāṁ viruddhaṁ sākṣyaṁ dātuṁ svapādānāsphālya rajaḥ sampātayata; ahaṁ yuṣmān yathārthaṁ vacmi vicāradinē tannagarasyāvasthātaḥ sidōmāmōrayō rnagarayōravasthā sahyatarā bhaviṣyati|</para>
  <para style="p">
    <verse number="12" style="v"/>atha tē gatvā lōkānāṁ manaḥparāvarttanīḥ kathā pracāritavantaḥ|</para>
  <para style="p">
    <verse number="13" style="v"/>ēvamanēkān bhūtāṁśca tyājitavantastathā tailēna marddayitvā bahūn janānarōgānakārṣuḥ|</para>
  <para style="p">
    <verse number="14" style="v"/>itthaṁ tasya sukhyātiścaturdiśō vyāptā tadā hērōd rājā tanniśamya kathitavān, yōhan majjakaḥ śmaśānād utthita atōhētōstēna sarvvā ētā adbhutakriyāḥ prakāśantē|</para>
  <para style="p">
    <verse number="15" style="v"/>anyē'kathayan ayam ēliyaḥ, kēpi kathitavanta ēṣa bhaviṣyadvādī yadvā bhaviṣyadvādināṁ sadr̥śa ēkōyam|</para>
  <para style="p">
    <verse number="16" style="v"/>kintu hērōd ityākarṇya bhāṣitavān yasyāhaṁ śiraśchinnavān sa ēva yōhanayaṁ sa śmaśānādudatiṣṭhat|</para>
  <para style="p">
    <verse number="17" style="v"/>pūrvvaṁ svabhrātuḥ philipasya patnyā udvāhaṁ kr̥tavantaṁ hērōdaṁ yōhanavādīt svabhātr̥vadhū rna vivāhyā|</para>
  <para style="p">
    <verse number="18" style="v"/>ataḥ kāraṇāt hērōd lōkaṁ prahitya yōhanaṁ dhr̥tvā bandhanālayē baddhavān|</para>
  <para style="p">
    <verse number="19" style="v"/>hērōdiyā tasmai yōhanē prakupya taṁ hantum aicchat kintu na śaktā,</para>
  <para style="p">
    <verse number="20" style="v"/>yasmād hērōd taṁ dhārmmikaṁ satpuruṣañca jñātvā sammanya rakṣitavān; tatkathāṁ śrutvā tadanusārēṇa bahūni karmmāṇi kr̥tavān hr̥ṣṭamanāstadupadēśaṁ śrutavāṁśca|</para>
  <para style="p">
    <verse number="21" style="v"/>kintu hērōd yadā svajanmadinē pradhānalōkēbhyaḥ sēnānībhyaśca gālīlpradēśīyaśrēṣṭhalōkēbhyaśca rātrau bhōjyamēkaṁ kr̥tavān</para>
  <para style="p">
    <verse number="22" style="v"/>tasmin śubhadinē hērōdiyāyāḥ kanyā samētya tēṣāṁ samakṣaṁ saṁnr̥tya hērōdastēna sahōpaviṣṭānāñca tōṣamajījanat tatā nr̥paḥ kanyāmāha sma mattō yad yācasē tadēva tubhyaṁ dāsyē|</para>
  <para style="p">
    <verse number="23" style="v"/>śapathaṁ kr̥tvākathayat cēd rājyārddhamapi yācasē tadapi tubhyaṁ dāsyē|</para>
  <para style="p">
    <verse number="24" style="v"/>tataḥ sā bahi rgatvā svamātaraṁ papraccha kimahaṁ yāciṣyē? tadā sākathayat yōhanō majjakasya śiraḥ|</para>
  <para style="p">
    <verse number="25" style="v"/>atha tūrṇaṁ bhūpasamīpam ētya yācamānāvadat kṣaṇēsmin yōhanō majjakasya śiraḥ pātrē nidhāya dēhi, ētad yācē'haṁ|</para>
  <para style="p">
    <verse number="26" style="v"/>tasmāt bhūpō'tiduḥkhitaḥ, tathāpi svaśapathasya sahabhōjināñcānurōdhāt tadanaṅgīkarttuṁ na śaktaḥ|</para>
  <para style="p">
    <verse number="27" style="v"/>tatkṣaṇaṁ rājā ghātakaṁ prēṣya tasya śira ānētumādiṣṭavān|</para>
  <para style="p">
    <verse number="28" style="v"/>tataḥ sa kārāgāraṁ gatvā tacchiraśchitvā pātrē nidhāyānīya tasyai kanyāyai dattavān kanyā ca svamātrē dadau|</para>
  <para style="p">
    <verse number="29" style="v"/>ananataraṁ yōhanaḥ śiṣyāstadvārttāṁ prāpyāgatya tasya kuṇapaṁ śmaśānē'sthāpayan|</para>
  <para style="p">
    <verse number="30" style="v"/>atha prēṣitā yīśōḥ sannidhau militā yad yac cakruḥ śikṣayāmāsuśca tatsarvvavārttāstasmai kathitavantaḥ|</para>
  <para style="p">
    <verse number="31" style="v"/>sa tānuvāca yūyaṁ vijanasthānaṁ gatvā viśrāmyata yatastatsannidhau bahulōkānāṁ samāgamāt tē bhōktuṁ nāvakāśaṁ prāptāḥ|</para>
  <para style="p">
    <verse number="32" style="v"/>tatastē nāvā vijanasthānaṁ guptaṁ gagmuḥ|</para>
  <para style="p">
    <verse number="33" style="v"/>tatō lōkanivahastēṣāṁ sthānāntarayānaṁ dadarśa, anēkē taṁ paricitya nānāpurēbhyaḥ padairvrajitvā javēna taiṣāmagrē yīśōḥ samīpa upatasthuḥ|</para>
  <para style="p">
    <verse number="34" style="v"/>tadā yīśu rnāvō bahirgatya lōkāraṇyānīṁ dr̥ṣṭvā tēṣu karuṇāṁ kr̥tavān yatastē'rakṣakamēṣā ivāsan tadā sa tāna nānāprasaṅgān upadiṣṭavān|</para>
  <para style="p">
    <verse number="35" style="v"/>atha divāntē sati śiṣyā ētya yīśumūcirē, idaṁ vijanasthānaṁ dinañcāvasannaṁ|</para>
  <para style="p">
    <verse number="36" style="v"/>lōkānāṁ kimapi khādyaṁ nāsti, ataścaturdikṣu grāmān gantuṁ bhōjyadravyāṇi krētuñca bhavān tān visr̥jatu|</para>
  <para style="p">
    <verse number="37" style="v"/>tadā sa tānuvāca yūyamēva tān bhōjayata; tatastē jagadu rvayaṁ gatvā dviśatasaṁkhyakai rmudrāpādaiḥ pūpān krītvā kiṁ tān bhōjayiṣyāmaḥ?</para>
  <para style="p">
    <verse number="38" style="v"/>tadā sa tān pr̥ṣṭhavān yuṣmākaṁ sannidhau kati pūpā āsatē? gatvā paśyata; tatastē dr̥ṣṭvā tamavadan pañca pūpā dvau matsyau ca santi|</para>
  <para style="p">
    <verse number="39" style="v"/>tadā sa lōkān śaspōpari paṁktibhirupavēśayitum ādiṣṭavān,</para>
  <para style="p">
    <verse number="40" style="v"/>tatastē śataṁ śataṁ janāḥ pañcāśat pañcāśajjanāśca paṁktibhi rbhuvi samupaviviśuḥ|</para>
  <para style="p">
    <verse number="41" style="v"/>atha sa tān pañcapūpān matsyadvayañca dhr̥tvā svargaṁ paśyan īśvaraguṇān anvakīrttayat tān pūpān bhaṁktvā lōkēbhyaḥ parivēṣayituṁ śiṣyēbhyō dattavān dvā matsyau ca vibhajya sarvvēbhyō dattavān|</para>
  <para style="p">
    <verse number="42" style="v"/>tataḥ sarvvē bhuktvātr̥pyan|</para>
  <para style="p">
    <verse number="43" style="v"/>anantaraṁ śiṣyā avaśiṣṭaiḥ pūpai rmatsyaiśca pūrṇān dvadaśa ḍallakān jagr̥huḥ|</para>
  <para style="p">
    <verse number="44" style="v"/>tē bhōktāraḥ prāyaḥ pañca sahasrāṇi puruṣā āsan|</para>
  <para style="p">
    <verse number="45" style="v"/>atha sa lōkān visr̥jannēva nāvamārōḍhuṁ svasmādagrē pārē baitsaidāpuraṁ yātuñca śṣyiाn vāḍhamādiṣṭavān|</para>
  <para style="p">
    <verse number="46" style="v"/>tadā sa sarvvān visr̥jya prārthayituṁ parvvataṁ gataḥ|</para>
  <para style="p">
    <verse number="47" style="v"/>tataḥ sandhyāyāṁ satyāṁ nauḥ sindhumadhya upasthitā kintu sa ēkākī sthalē sthitaḥ|</para>
  <para style="p">
    <verse number="48" style="v"/>atha sammukhavātavahanāt śiṣyā nāvaṁ vāhayitvā pariśrāntā iti jñātvā sa niśācaturthayāmē sindhūpari padbhyāṁ vrajan tēṣāṁ samīpamētya tēṣāmagrē yātum udyataḥ|</para>
  <para style="p">
    <verse number="49" style="v"/>kintu śiṣyāḥ sindhūpari taṁ vrajantaṁ dr̥ṣṭvā bhūtamanumāya ruruvuḥ,</para>
  <para style="p">
    <verse number="50" style="v"/>yataḥ sarvvē taṁ dr̥ṣṭvā vyākulitāḥ| ataēva yīśustatkṣaṇaṁ taiḥ sahālapya kathitavān, susthirā bhūta, ayamahaṁ mā bhaiṣṭa|</para>
  <para style="p">
    <verse number="51" style="v"/>atha naukāmāruhya tasmin tēṣāṁ sannidhiṁ gatē vātō nivr̥ttaḥ; tasmāttē manaḥsu vismitā āścaryyaṁ mēnirē|</para>
  <para style="p">
    <verse number="52" style="v"/>yatastē manasāṁ kāṭhinyāt tat pūpīyam āścaryyaṁ karmma na viviktavantaḥ|</para>
  <para style="p">
    <verse number="53" style="v"/>atha tē pāraṁ gatvā ginēṣaratpradēśamētya taṭa upasthitāḥ|</para>
  <para style="p">
    <verse number="54" style="v"/>tēṣu naukātō bahirgatēṣu tatpradēśīyā lōkāstaṁ paricitya</para>
  <para style="p">
    <verse number="55" style="v"/>caturdikṣu dhāvantō yatra yatra rōgiṇō narā āsan tān sarvvāna khaṭvōpari nidhāya yatra kutracit tadvārttāṁ prāpuḥ tat sthānam ānētum ārēbhirē|</para>
  <para style="p">
    <verse number="56" style="v"/>tathā yatra yatra grāmē yatra yatra purē yatra yatra pallyāñca tēna pravēśaḥ kr̥tastadvartmamadhyē lōkāḥ pīḍitān sthāpayitvā tasya cēlagranthimātraṁ spraṣṭum tēṣāmarthē tadanujñāṁ prārthayantaḥ yāvantō lōkāḥ paspr̥śustāvanta ēva gadānmuktāḥ|</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ yirūśālama āgatāḥ phirūśinō'dhyāpakāśca yīśōḥ samīpam āgatāḥ|</para>
  <para style="p">
    <verse number="2" style="v"/>tē tasya kiyataḥ śiṣyān aśucikarairarthāda aprakṣālitahastai rbhuñjatō dr̥ṣṭvā tānadūṣayan|</para>
  <para style="p">
    <verse number="3" style="v"/>yataḥ phirūśinaḥ sarvvayihūdīyāśca prācāṁ paramparāgatavākyaṁ sammanya pratalēna hastān aprakṣālya na bhuñjatē|</para>
  <para style="p">
    <verse number="4" style="v"/>āpanādāgatya majjanaṁ vinā na khādanti; tathā pānapātrāṇāṁ jalapātrāṇāṁ pittalapātrāṇām āsanānāñca jalē majjanam ityādayōnyēpi bahavastēṣāmācārāḥ santi|</para>
  <para style="p">
    <verse number="5" style="v"/>tē phirūśinō'dhyāpakāśca yīśuṁ papracchuḥ, tava śiṣyāḥ prācāṁ paramparāgatavākyānusārēṇa nācarantō'prakṣālitakaraiḥ kutō bhujaṁtē?</para>
  <para style="p">
    <verse number="6" style="v"/>tataḥ sa pratyuvāca kapaṭinō yuṣmān uddiśya yiśayiyabhaviṣyadvādī yuktamavādīt| yathā svakīyairadharairētē sammanyanatē sadaiva māṁ| kintu mattō viprakarṣē santi tēṣāṁ manāṁsi ca|</para>
  <para style="p">
    <verse number="7" style="v"/>śikṣayantō bidhīn nnājñā bhajantē māṁ mudhaiva tē|</para>
  <para style="p">
    <verse number="8" style="v"/>yūyaṁ jalapātrapānapātrādīni majjayantō manujaparamparāgatavākyaṁ rakṣatha kintu īśvarājñāṁ laṁghadhvē; aparā īdr̥śyōnēkāḥ kriyā api kurudhvē|</para>
  <para style="p">
    <verse number="9" style="v"/>anyañcākathayat yūyaṁ svaparamparāgatavākyasya rakṣārthaṁ spaṣṭarūpēṇa īśvarājñāṁ lōpayatha|</para>
  <para style="p">
    <verse number="10" style="v"/>yatō mūsādvārā prōktamasti svapitarau sammanyadhvaṁ yastu mātaraṁ pitaraṁ vā durvvākyaṁ vakti sa nitāntaṁ hanyatāṁ|</para>
  <para style="p">
    <verse number="11" style="v"/>kintu madīyēna yēna dravyēṇa tavōpakārōbhavat tat karbbāṇamarthād īśvarāya nivēditam idaṁ vākyaṁ yadi kōpi pitaraṁ mātaraṁ vā vakti</para>
  <para style="p">
    <verse number="12" style="v"/>tarhi yūyaṁ mātuḥ pitu rvōpakāraṁ karttāṁ taṁ vārayatha|</para>
  <para style="p">
    <verse number="13" style="v"/>itthaṁ svapracāritaparamparāgatavākyēna yūyam īśvarājñāṁ mudhā vidhadvvē, īdr̥śānyanyānyanēkāni karmmāṇi kurudhvē|</para>
  <para style="p">
    <verse number="14" style="v"/>atha sa lōkānāhūya babhāṣē yūyaṁ sarvvē madvākyaṁ śr̥ṇuta budhyadhvañca|</para>
  <para style="p">
    <verse number="15" style="v"/>bāhyādantaraṁ praviśya naramamēdhyaṁ karttāṁ śaknōti īdr̥śaṁ kimapi vastu nāsti, varam antarād bahirgataṁ yadvastu tanmanujam amēdhyaṁ karōti|</para>
  <para style="p">
    <verse number="16" style="v"/>yasya śrōtuṁ śrōtrē staḥ sa śr̥ṇōtu|</para>
  <para style="p">
    <verse number="17" style="v"/>tataḥ sa lōkān hitvā gr̥hamadhyaṁ praviṣṭastadā śiṣyāstadr̥ṣṭāntavākyārthaṁ papracchuḥ|</para>
  <para style="p">
    <verse number="18" style="v"/>tasmāt sa tān jagāda yūyamapi kimētādr̥gabōdhāḥ? kimapi dravyaṁ bāhyādantaraṁ praviśya naramamēdhyaṁ karttāṁ na śaknōti kathāmimāṁ kiṁ na budhyadhvē?</para>
  <para style="p">
    <verse number="19" style="v"/>tat tadantarna praviśati kintu kukṣimadhyaṁ praviśati śēṣē sarvvabhuktavastugrāhiṇi bahirdēśē niryāti|</para>
  <para style="p">
    <verse number="20" style="v"/>aparamapyavādīd yannarānnirēti tadēva naramamēdhyaṁ karōti|</para>
  <para style="p">
    <verse number="21" style="v"/>yatō'ntarād arthān mānavānāṁ manōbhyaḥ kucintā parastrīvēśyāgamanaṁ</para>
  <para style="p">
    <verse number="22" style="v"/>naravadhaścauryyaṁ lōbhō duṣṭatā pravañcanā kāmukatā kudr̥ṣṭirīśvaranindā garvvastama ityādīni nirgacchanti|</para>
  <para style="p">
    <verse number="23" style="v"/>ētāni sarvvāṇi duritānyantarādētya naramamēdhyaṁ kurvvanti|</para>
  <para style="p">
    <verse number="24" style="v"/>atha sa utthāya tatsthānāt sōrasīdōnpurapradēśaṁ jagāma tatra kimapi nivēśanaṁ praviśya sarvvairajñātaḥ sthātuṁ matiñcakrē kintu guptaḥ sthātuṁ na śaśāka|</para>
  <para style="p">
    <verse number="25" style="v"/>yataḥ suraphainikīdēśīyayūnānīvaṁśōdbhavastriyāḥ kanyā bhūtagrastāsīt| sā strī tadvārttāṁ prāpya tatsamīpamāgatya taccaraṇayōḥ patitvā</para>
  <para style="p">
    <verse number="26" style="v"/>svakanyātō bhūtaṁ nirākarttāṁ tasmin vinayaṁ kr̥tavatī|</para>
  <para style="p">
    <verse number="27" style="v"/>kintu yīśustāmavadat prathamaṁ bālakāstr̥pyantu yatō bālakānāṁ khādyaṁ gr̥hītvā kukkurēbhyō nikṣēpō'nucitaḥ|</para>
  <para style="p">
    <verse number="28" style="v"/>tadā sā strī tamavādīt bhōḥ prabhō tat satyaṁ tathāpi mañcādhaḥsthāḥ kukkurā bālānāṁ karapatitāni khādyakhaṇḍāni khādanti|</para>
  <para style="p">
    <verse number="29" style="v"/>tataḥ sō'kathayad ētatkathāhētōḥ sakuśalā yāhi tava kanyāṁ tyaktvā bhūtō gataḥ|</para>
  <para style="p">
    <verse number="30" style="v"/>atha sā strī gr̥haṁ gatvā kanyāṁ bhūtatyaktāṁ śayyāsthitāṁ dadarśa|</para>
  <para style="p">
    <verse number="31" style="v"/>punaśca sa sōrasīdōnpurapradēśāt prasthāya dikāpalidēśasya prāntarabhāgēna gālīljaladhēḥ samīpaṁ gatavān|</para>
  <para style="p">
    <verse number="32" style="v"/>tadā lōkairēkaṁ badhiraṁ kadvadañca naraṁ tannikaṭamānīya tasya gātrē hastamarpayituṁ vinayaḥ kr̥taḥ|</para>
  <para style="p">
    <verse number="33" style="v"/>tatō yīśu rlōkāraṇyāt taṁ nirjanamānīya tasya karṇayōṅgulī rdadau niṣṭhīvaṁ dattvā ca tajjihvāṁ pasparśa|</para>
  <para style="p">
    <verse number="34" style="v"/>anantaraṁ svargaṁ nirīkṣya dīrghaṁ niśvasya tamavadat itaphataḥ arthān muktō bhūyāt|</para>
  <para style="p">
    <verse number="35" style="v"/>tatastatkṣaṇaṁ tasya karṇau muktau jihvāyāśca jāḍyāpagamāt sa suspaṣṭavākyamakathayat|</para>
  <para style="p">
    <verse number="36" style="v"/>atha sa tān vāḍhamityādidēśa yūyamimāṁ kathāṁ kasmaicidapi mā kathayata, kintu sa yati nyaṣēdhat tē tati bāhulyēna prācārayan;</para>
  <para style="p">
    <verse number="37" style="v"/>tē'ticamatkr̥tya parasparaṁ kathayāmāsuḥ sa badhirāya śravaṇaśaktiṁ mūkāya ca kathanaśaktiṁ dattvā sarvvaṁ karmmōttamarūpēṇa cakāra|</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tadā tatsamīpaṁ bahavō lōkā āyātā atastēṣāṁ bhōjyadravyābhāvād yīśuḥ śiṣyānāhūya jagāda,|</para>
  <para style="p">
    <verse number="2" style="v"/>lōkanivahē mama kr̥pā jāyatē tē dinatrayaṁ mayā sārddhaṁ santi tēṣāṁ bhōjyaṁ kimapi nāsti|</para>
  <para style="p">
    <verse number="3" style="v"/>tēṣāṁ madhyē'nēkē dūrād āgatāḥ, abhuktēṣu tēṣu mayā svagr̥hamabhiprahitēṣu tē pathi klamiṣyanti|</para>
  <para style="p">
    <verse number="4" style="v"/>śiṣyā avādiṣuḥ, ētāvatō lōkān tarpayitum atra prantarē pūpān prāptuṁ kēna śakyatē?</para>
  <para style="p">
    <verse number="5" style="v"/>tataḥ sa tān papraccha yuṣmākaṁ kati pūpāḥ santi? tē'kathayan sapta|</para>
  <para style="p">
    <verse number="6" style="v"/>tataḥ sa tāllōkān bhuvi samupavēṣṭum ādiśya tān sapta pūpān dhr̥tvā īśvaraguṇān anukīrttayāmāsa, bhaṁktvā parivēṣayituṁ śiṣyān prati dadau, tatastē lōkēbhyaḥ parivēṣayāmāsuḥ|</para>
  <para style="p">
    <verse number="7" style="v"/>tathā tēṣāṁ samīpē yē kṣudramatsyā āsan tānapyādāya īśvaraguṇān saṁkīrtya parivēṣayitum ādiṣṭavān|</para>
  <para style="p">
    <verse number="8" style="v"/>tatō lōkā bhuktvā tr̥ptiṁ gatā avaśiṣṭakhādyaiḥ pūrṇāḥ saptaḍallakā gr̥hītāśca|</para>
  <para style="p">
    <verse number="9" style="v"/>ētē bhōktāraḥ prāyaścatuḥ sahasrapuruṣā āsan tataḥ sa tān visasarja|</para>
  <para style="p">
    <verse number="10" style="v"/>atha sa śiṣyaḥ saha nāvamāruhya dalmānūthāsīmāmāgataḥ|</para>
  <para style="p">
    <verse number="11" style="v"/>tataḥ paraṁ phirūśina āgatya tēna saha vivadamānāstasya parīkṣārtham ākāśīyacihnaṁ draṣṭuṁ yācitavantaḥ|</para>
  <para style="p">
    <verse number="12" style="v"/>tadā sō'ntardīrghaṁ niśvasyākathayat, ētē vidyamānanarāḥ kutaścinhaṁ mr̥gayantē? yuṣmānahaṁ yathārthaṁ bravīmi lōkānētān kimapi cihnaṁ na darśayiṣyatē|</para>
  <para style="p">
    <verse number="13" style="v"/>atha tān hitvā puna rnāvam āruhya pāramagāt|</para>
  <para style="p">
    <verse number="14" style="v"/>ētarhi śiṣyaiḥ pūpēṣu vismr̥tēṣu nāvi tēṣāṁ sannidhau pūpa ēkaēva sthitaḥ|</para>
  <para style="p">
    <verse number="15" style="v"/>tadānīṁ yīśustān ādiṣṭavān phirūśināṁ hērōdaśca kiṇvaṁ prati satarkāḥ sāvadhānāśca bhavata|</para>
  <para style="p">
    <verse number="16" style="v"/>tatastē'nyōnyaṁ vivēcanaṁ kartum ārēbhirē, asmākaṁ sannidhau pūpō nāstīti hētōridaṁ kathayati|</para>
  <para style="p">
    <verse number="17" style="v"/>tad budvvā yīśustēbhyō'kathayat yuṣmākaṁ sthānē pūpābhāvāt kuta itthaṁ vitarkayatha? yūyaṁ kimadyāpi kimapi na jānītha? bōddhuñca na śaknutha? yāvadadya kiṁ yuṣmākaṁ manāṁsi kaṭhināni santi?</para>
  <para style="p">
    <verse number="18" style="v"/>satsu nētrēṣu kiṁ na paśyatha? satsu karṇēṣu kiṁ na śr̥ṇutha? na smaratha ca?</para>
  <para style="p">
    <verse number="19" style="v"/>yadāhaṁ pañcapūpān pañcasahasrāṇāṁ puruṣāṇāṁ madhyē bhaṁktvā dattavān tadānīṁ yūyam avaśiṣṭapūpaiḥ pūrṇān kati ḍallakān gr̥hītavantaḥ? tē'kathayan dvādaśaḍallakān|</para>
  <para style="p">
    <verse number="20" style="v"/>aparañca yadā catuḥsahasrāṇāṁ puruṣāṇāṁ madhyē pūpān bhaṁktvādadāṁ tadā yūyam atiriktapūpānāṁ kati ḍallakān gr̥hītavantaḥ? tē kathayāmāsuḥ saptaḍallakān|</para>
  <para style="p">
    <verse number="21" style="v"/>tadā sa kathitavān tarhi yūyam adhunāpi kutō bōdvvuṁ na śaknutha?</para>
  <para style="p">
    <verse number="22" style="v"/>anantaraṁ tasmin baitsaidānagarē prāptē lōkā andhamēkaṁ naraṁ tatsamīpamānīya taṁ spraṣṭuṁ taṁ prārthayāñcakrirē|</para>
  <para style="p">
    <verse number="23" style="v"/>tadā tasyāndhasya karau gr̥hītvā nagarād bahirdēśaṁ taṁ nītavān; tannētrē niṣṭhīvaṁ dattvā tadgātrē hastāvarpayitvā taṁ papraccha, kimapi paśyasi?</para>
  <para style="p">
    <verse number="24" style="v"/>sa nētrē unmīlya jagāda, vr̥kṣavat manujān gacchatō nirīkṣē|</para>
  <para style="p">
    <verse number="25" style="v"/>tatō yīśuḥ punastasya nayanayō rhastāvarpayitvā tasya nētrē unmīlayāmāsa; tasmāt sa svasthō bhūtvā spaṣṭarūpaṁ sarvvalōkān dadarśa|</para>
  <para style="p">
    <verse number="26" style="v"/>tataḥ paraṁ tvaṁ grāmaṁ mā gaccha grāmasthaṁ kamapi ca kimapyanuktvā nijagr̥haṁ yāhītyādiśya yīśustaṁ nijagr̥haṁ prahitavān|</para>
  <para style="p">
    <verse number="27" style="v"/>anantaraṁ śiṣyaiḥ sahitō yīśuḥ kaisarīyāphilipipuraṁ jagāma, pathi gacchan tānapr̥cchat kō'ham atra lōkāḥ kiṁ vadanti?</para>
  <para style="p">
    <verse number="28" style="v"/>tē pratyūcuḥ tvāṁ yōhanaṁ majjakaṁ vadanti kintu kēpi kēpi ēliyaṁ vadanti; aparē kēpi kēpi bhaviṣyadvādinām ēkō jana iti vadanti|</para>
  <para style="p">
    <verse number="29" style="v"/>atha sa tānapr̥cchat kintu kōham? ityatra yūyaṁ kiṁ vadatha? tadā pitaraḥ pratyavadat bhavān abhiṣiktastrātā|</para>
  <para style="p">
    <verse number="30" style="v"/>tataḥ sa tān gāḍhamādiśad yūyaṁ mama kathā kasmaicidapi mā kathayata|</para>
  <para style="p">
    <verse number="31" style="v"/>manuṣyaputrēṇāvaśyaṁ bahavō yātanā bhōktavyāḥ prācīnalōkaiḥ pradhānayājakairadhyāpakaiśca sa ninditaḥ san ghātayiṣyatē tr̥tīyadinē utthāsyati ca, yīśuḥ śiṣyānupadēṣṭumārabhya kathāmimāṁ spaṣṭamācaṣṭa|</para>
  <para style="p">
    <verse number="32" style="v"/>tasmāt pitarastasya hastau dhr̥tvā taṁ tarjjitavān|</para>
  <para style="p">
    <verse number="33" style="v"/>kintu sa mukhaṁ parāvartya śiṣyagaṇaṁ nirīkṣya pitaraṁ tarjayitvāvādīd dūrībhava vighnakārin īśvarīyakāryyādapi manuṣyakāryyaṁ tubhyaṁ rōcatatarāṁ|</para>
  <para style="p">
    <verse number="34" style="v"/>atha sa lōkān śiṣyāṁścāhūya jagāda yaḥ kaścin māmanugantum icchati sa ātmānaṁ dāmyatu, svakruśaṁ gr̥hītvā matpaścād āyātu|</para>
  <para style="p">
    <verse number="35" style="v"/>yatō yaḥ kaścit svaprāṇaṁ rakṣitumicchati sa taṁ hārayiṣyati, kintu yaḥ kaścin madarthaṁ susaṁvādārthañca prāṇaṁ hārayati sa taṁ rakṣiṣyati|</para>
  <para style="p">
    <verse number="36" style="v"/>aparañca manujaḥ sarvvaṁ jagat prāpya yadi svaprāṇaṁ hārayati tarhi tasya kō lābhaḥ?</para>
  <para style="p">
    <verse number="37" style="v"/>naraḥ svaprāṇavinimayēna kiṁ dātuṁ śaknōti?</para>
  <para style="p">
    <verse number="38" style="v"/>ētēṣāṁ vyabhicāriṇāṁ pāpināñca lōkānāṁ sākṣād yadi kōpi māṁ matkathāñca lajjāspadaṁ jānāti tarhi manujaputrō yadā dharmmadūtaiḥ saha pituḥ prabhāvēṇāgamiṣyati tadā sōpi taṁ lajjāspadaṁ jñāsyati|</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>atha sa tānavādīt yuṣmabhyamahaṁ yathārthaṁ kathayāmi, īśvararājyaṁ parākramēṇōpasthitaṁ na dr̥ṣṭvā mr̥tyuṁ nāsvādiṣyantē, atra daṇḍāyamānānāṁ madhyēpi tādr̥śā lōkāḥ santi|</para>
  <para style="p">
    <verse number="2" style="v"/>atha ṣaḍdinēbhyaḥ paraṁ yīśuḥ pitaraṁ yākūbaṁ yōhanañca gr̥hītvā girēruccasya nirjanasthānaṁ gatvā tēṣāṁ pratyakṣē mūrtyantaraṁ dadhāra|</para>
  <para style="p">
    <verse number="3" style="v"/>tatastasya paridhēyam īdr̥śam ujjvalahimapāṇaḍaraṁ jātaṁ yad jagati kōpi rajakō na tādr̥k pāṇaḍaraṁ karttāṁ śaknōti|</para>
  <para style="p">
    <verse number="4" style="v"/>aparañca ēliyō mūsāśca tēbhyō darśanaṁ dattvā yīśunā saha kathanaṁ karttumārēbhātē|</para>
  <para style="p">
    <verse number="5" style="v"/>tadā pitarō yīśumavādīt hē gurō'smākamatra sthitiruttamā, tataēva vayaṁ tvatkr̥tē ēkāṁ mūsākr̥tē ēkām ēliyakr̥tē caikāṁ, ētāstisraḥ kuṭī rnirmmāma|</para>
  <para style="p">
    <verse number="6" style="v"/>kintu sa yaduktavān tat svayaṁ na bubudhē tataḥ sarvvē bibhayāñcakruḥ|</para>
  <para style="p">
    <verse number="7" style="v"/>ētarhi payōdastān chādayāmāsa, mamayāṁ priyaḥ putraḥ kathāsu tasya manāṁsi nivēśayatēti nabhōvāṇī tanmēdyānniryayau|</para>
  <para style="p">
    <verse number="8" style="v"/>atha haṭhāttē caturdiśō dr̥ṣṭvā yīśuṁ vinā svaiḥ sahitaṁ kamapi na dadr̥śuḥ|</para>
  <para style="p">
    <verse number="9" style="v"/>tataḥ paraṁ girēravarōhaṇakālē sa tān gāḍham dūtyādidēśa yāvannarasūnōḥ śmaśānādutthānaṁ na bhavati, tāvat darśanasyāsya vārttā yuṣmābhiḥ kasmaicidapi na vaktavyā|</para>
  <para style="p">
    <verse number="10" style="v"/>tadā śmaśānādutthānasya kōbhiprāya iti vicāryya tē tadvākyaṁ svēṣu gōpāyāñcakrirē|</para>
  <para style="p">
    <verse number="11" style="v"/>atha tē yīśuṁ papracchuḥ prathamata ēliyēnāgantavyam iti vākyaṁ kuta upādhyāyā āhuḥ?</para>
  <para style="p">
    <verse number="12" style="v"/>tadā sa pratyuvāca , ēliyaḥ prathamamētya sarvvakāryyāṇi sādhayiṣyati; naraputrē ca lipi ryathāstē tathaiva sōpi bahuduḥkhaṁ prāpyāvajñāsyatē|</para>
  <para style="p">
    <verse number="13" style="v"/>kintvahaṁ yuṣmān vadāmi , ēliyārthē lipi ryathāstē tathaiva sa ētya yayau, lōkā: svēcchānurūpaṁ tamabhivyavaharanti sma|</para>
  <para style="p">
    <verse number="14" style="v"/>anantaraṁ sa śiṣyasamīpamētya tēṣāṁ catuḥpārśvē taiḥ saha bahujanān vivadamānān adhyāpakāṁśca dr̥ṣṭavān;</para>
  <para style="p">
    <verse number="15" style="v"/>kintu sarvvalōkāstaṁ dr̥ṣṭvaiva camatkr̥tya tadāsannaṁ dhāvantastaṁ praṇēmuḥ|</para>
  <para style="p">
    <verse number="16" style="v"/>tadā yīśuradhyāpakānaprākṣīd ētaiḥ saha yūyaṁ kiṁ vivadadhvē?</para>
  <para style="p">
    <verse number="17" style="v"/>tatō lōkānāṁ kaścidēkaḥ pratyavādīt hē gurō mama sūnuṁ mūkaṁ bhūtadhr̥tañca bhavadāsannam ānayaṁ|</para>
  <para style="p">
    <verse number="18" style="v"/>yadāsau bhūtastamākramatē tadaiva pātasati tathā sa phēṇāyatē, dantairdantān gharṣati kṣīṇō bhavati ca; tatō hētōstaṁ bhūtaṁ tyājayituṁ bhavacchiṣyān nivēditavān kintu tē na śēkuḥ|</para>
  <para style="p">
    <verse number="19" style="v"/>tadā sa tamavādīt, rē aviśvāsinaḥ santānā yuṣmābhiḥ saha kati kālānahaṁ sthāsyāmi? aparān kati kālān vā va ācārān sahiṣyē? taṁ madāsannamānayata|</para>
  <para style="p">
    <verse number="20" style="v"/>tatastatsannidhiṁ sa ānīyata kintu taṁ dr̥ṣṭvaiva bhūtō bālakaṁ dhr̥tavān; sa ca bhūmau patitvā phēṇāyamānō lulōṭha|</para>
  <para style="p">
    <verse number="21" style="v"/>tadā sa tatpitaraṁ papraccha, asyēdr̥śī daśā kati dināni bhūtā? tataḥ sōvādīt bālyakālāt|</para>
  <para style="p">
    <verse number="22" style="v"/>bhūtōyaṁ taṁ nāśayituṁ bahuvārān vahnau jalē ca nyakṣipat kintu yadi bhavāna kimapi karttāṁ śaknōti tarhi dayāṁ kr̥tvāsmān upakarōtu|</para>
  <para style="p">
    <verse number="23" style="v"/>tadā yīśustamavadat yadi pratyētuṁ śaknōṣi tarhi pratyayinē janāya sarvvaṁ sādhyam|</para>
  <para style="p">
    <verse number="24" style="v"/>tatastatkṣaṇaṁ tadbālakasya pitā prōccai rūvan sāśrunētraḥ prōvāca, prabhō pratyēmi mamāpratyayaṁ pratikuru|</para>
  <para style="p">
    <verse number="25" style="v"/>atha yīśu rlōkasaṅghaṁ dhāvitvāyāntaṁ dr̥ṣṭvā tamapūtabhūtaṁ tarjayitvā jagāda, rē badhira mūka bhūta tvamētasmād bahirbhava punaḥ kadāpi māśrayainaṁ tvāmaham ityādiśāmi|</para>
  <para style="p">
    <verse number="26" style="v"/>tadā sa bhūtaścītśabdaṁ kr̥tvā tamāpīḍya bahirjajāma, tatō bālakō mr̥takalpō babhūva tasmādayaṁ mr̥ta̮ityanēkē kathayāmāsuḥ|</para>
  <para style="p">
    <verse number="27" style="v"/>kintu karaṁ dhr̥tvā yīśunōtthāpitaḥ sa uttasthau|</para>
  <para style="p">
    <verse number="28" style="v"/>atha yīśau gr̥haṁ praviṣṭē śiṣyā guptaṁ taṁ papracchuḥ, vayamēnaṁ bhūtaṁ tyājayituṁ kutō na śaktāḥ?</para>
  <para style="p">
    <verse number="29" style="v"/>sa uvāca, prārthanōpavāsau vinā kēnāpyanyēna karmmaṇā bhūtamīdr̥śaṁ tyājayituṁ na śakyaṁ|</para>
  <para style="p">
    <verse number="30" style="v"/>anantaraṁ sa tatsthānāditvā gālīlmadhyēna yayau, kintu tat kōpi jānīyāditi sa naicchat|</para>
  <para style="p">
    <verse number="31" style="v"/>aparañca sa śiṣyānupadiśan babhāṣē, naraputrō narahastēṣu samarpayiṣyatē tē ca taṁ haniṣyanti taistasmin hatē tr̥tīyadinē sa utthāsyatīti|</para>
  <para style="p">
    <verse number="32" style="v"/>kintu tatkathāṁ tē nābudhyanta praṣṭuñca bibhyaḥ|</para>
  <para style="p">
    <verse number="33" style="v"/>atha yīśuḥ kapharnāhūmpuramāgatya madhyēgr̥hañcētya tānapr̥cchad vartmamadhyē yūyamanyōnyaṁ kiṁ vivadadhvē sma?</para>
  <para style="p">
    <verse number="34" style="v"/>kintu tē niruttarāstasthu ryasmāttēṣāṁ kō mukhya iti vartmāni tē'nyōnyaṁ vyavadanta|</para>
  <para style="p">
    <verse number="35" style="v"/>tataḥ sa upaviśya dvādaśaśiṣyān āhūya babhāṣē yaḥ kaścit mukhyō bhavitumicchati sa sarvvēbhyō gauṇaḥ sarvvēṣāṁ sēvakaśca bhavatu|</para>
  <para style="p">
    <verse number="36" style="v"/>tadā sa bālakamēkaṁ gr̥hītvā madhyē samupāvēśayat tatastaṁ krōḍē kr̥tvā tānavādāt</para>
  <para style="p">
    <verse number="37" style="v"/>yaḥ kaścidīdr̥śasya kasyāpi bālasyātithyaṁ karōti sa mamātithyaṁ karōti; yaḥ kaścinmamātithyaṁ karōti sa kēvalam mamātithyaṁ karōti tanna matprērakasyāpyātithyaṁ karōti|</para>
  <para style="p">
    <verse number="38" style="v"/>atha yōhan tamabravīt hē gurō, asmākamananugāminam ēkaṁ tvānnāmnā bhūtān tyājayantaṁ vayaṁ dr̥ṣṭavantaḥ, asmākamapaścādgāmitvācca taṁ nyaṣēdhāma|</para>
  <para style="p">
    <verse number="39" style="v"/>kintu yīśuravadat taṁ mā niṣēdhat, yatō yaḥ kaścin mannāmnā citraṁ karmma karōti sa sahasā māṁ nindituṁ na śaknōti|</para>
  <para style="p">
    <verse number="40" style="v"/>tathā yaḥ kaścid yuṣmākaṁ vipakṣatāṁ na karōti sa yuṣmākamēva sapakṣaḥ|</para>
  <para style="p">
    <verse number="41" style="v"/>yaḥ kaścid yuṣmān khrīṣṭaśiṣyān jñātvā mannāmnā kaṁsaikēna pānīyaṁ pātuṁ dadāti, yuṣmānahaṁ yathārthaṁ vacmi, sa phalēna vañcitō na bhaviṣyati|</para>
  <para style="p">
    <verse number="42" style="v"/>kintu yadi kaścin mayi viśvāsināmēṣāṁ kṣudraprāṇinām ēkasyāpi vighnaṁ janayati, tarhi tasyaitatkarmma karaṇāt kaṇṭhabaddhapēṣaṇīkasya tasya sāgarāgādhajala majjanaṁ bhadraṁ|</para>
  <para style="p">
    <verse number="43" style="v"/>ataḥ svakarō yadi tvāṁ bādhatē tarhi taṁ chindhi;</para>
  <para style="p">
    <verse number="44" style="v"/>yasmāt yatra kīṭā na mriyantē vahniśca na nirvvāti, tasmin anirvvāṇānalanarakē karadvayavastava gamanāt karahīnasya svargapravēśastava kṣēmaṁ|</para>
  <para style="p">
    <verse number="45" style="v"/>yadi tava pādō vighnaṁ janayati tarhi taṁ chindhi,</para>
  <para style="p">
    <verse number="46" style="v"/>yatō yatra kīṭā na mriyantē vahniśca na nirvvāti, tasmin 'nirvvāṇavahnau narakē dvipādavatastava nikṣēpāt pādahīnasya svargapravēśastava kṣēmaṁ|</para>
  <para style="p">
    <verse number="47" style="v"/>svanētraṁ yadi tvāṁ bādhatē tarhi tadapyutpāṭaya, yatō yatra kīṭā na mriyantē vahniśca na nirvvāti,</para>
  <para style="p">
    <verse number="48" style="v"/>tasmina 'nirvvāṇavahnau narakē dvinētrasya tava nikṣēpād ēkanētravata īśvararājyē pravēśastava kṣēmaṁ|</para>
  <para style="p">
    <verse number="49" style="v"/>yathā sarvvō bali rlavaṇāktaḥ kriyatē tathā sarvvō janō vahnirūpēṇa lavaṇāktaḥ kāriṣyatē|</para>
  <para style="p">
    <verse number="50" style="v"/>lavaṇaṁ bhadraṁ kintu yadi lavaṇē svādutā na tiṣṭhati, tarhi katham āsvādyuktaṁ kariṣyatha? yūyaṁ lavaṇayuktā bhavata parasparaṁ prēma kuruta|</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ sa tatsthānāt prasthāya yarddananadyāḥ pārē yihūdāpradēśa upasthitavān, tatra tadantikē lōkānāṁ samāgamē jātē sa nijarītyanusārēṇa punastān upadidēśa|</para>
  <para style="p">
    <verse number="2" style="v"/>tadā phirūśinastatsamīpam ētya taṁ parīkṣituṁ papracchaḥ svajāyā manujānāṁ tyajyā na vēti?</para>
  <para style="p">
    <verse number="3" style="v"/>tataḥ sa pratyavādīt, atra kāryyē mūsā yuṣmān prati kimājñāpayat?</para>
  <para style="p">
    <verse number="4" style="v"/>ta ūcuḥ tyāgapatraṁ lēkhituṁ svapatnīṁ tyaktuñca mūsā'numanyatē|</para>
  <para style="p">
    <verse number="5" style="v"/>tadā yīśuḥ pratyuvāca, yuṣmākaṁ manasāṁ kāṭhinyāddhētō rmūsā nidēśamimam alikhat|</para>
  <para style="p">
    <verse number="6" style="v"/>kintu sr̥ṣṭērādau īśvarō narān puṁrūpēṇa strīrūpēṇa ca sasarja|</para>
  <para style="p">
    <verse number="7" style="v"/>"tataḥ kāraṇāt pumān pitaraṁ mātarañca tyaktvā svajāyāyām āsaktō bhaviṣyati,</para>
  <para style="p">
    <verse number="8" style="v"/>tau dvāv ēkāṅgau bhaviṣyataḥ|" tasmāt tatkālamārabhya tau na dvāv ēkāṅgau|</para>
  <para style="p">
    <verse number="9" style="v"/>ataḥ kāraṇād īśvarō yadayōjayat kōpi narastanna viyējayēt|</para>
  <para style="p">
    <verse number="10" style="v"/>atha yīśu rgr̥haṁ praviṣṭastadā śiṣyāḥ punastatkathāṁ taṁ papracchuḥ|</para>
  <para style="p">
    <verse number="11" style="v"/>tataḥ sōvadat kaścid yadi svabhāryyāṁ tyaktavānyām udvahati tarhi sa svabhāryyāyāḥ prātikūlyēna vyabhicārī bhavati|</para>
  <para style="p">
    <verse number="12" style="v"/>kācinnārī yadi svapatiṁ hitvānyapuṁsā vivāhitā bhavati tarhi sāpi vyabhicāriṇī bhavati|</para>
  <para style="p">
    <verse number="13" style="v"/>atha sa yathā śiśūn spr̥śēt, tadarthaṁ lōkaistadantikaṁ śiśava ānīyanta, kintu śiṣyāstānānītavatastarjayāmāsuḥ|</para>
  <para style="p">
    <verse number="14" style="v"/>yīśustad dr̥ṣṭvā krudhyan jagāda, mannikaṭam āgantuṁ śiśūn mā vārayata, yata ētādr̥śā īśvararājyādhikāriṇaḥ|</para>
  <para style="p">
    <verse number="15" style="v"/>yuṣmānahaṁ yathārthaṁ vacmi, yaḥ kaścit śiśuvad bhūtvā rājyamīśvarasya na gr̥hlīyāt sa kadāpi tadrājyaṁ pravēṣṭuṁ na śaknōti|</para>
  <para style="p">
    <verse number="16" style="v"/>ananataraṁ sa śiśūnaṅkē nidhāya tēṣāṁ gātrēṣu hastau dattvāśiṣaṁ babhāṣē|</para>
  <para style="p">
    <verse number="17" style="v"/>atha sa vartmanā yāti, ētarhi jana ēkō dhāvan āgatya tatsammukhē jānunī pātayitvā pr̥ṣṭavān, bhōḥ paramagurō, anantāyuḥ prāptayē mayā kiṁ karttavyaṁ?</para>
  <para style="p">
    <verse number="18" style="v"/>tadā yīśuruvāca, māṁ paramaṁ kutō vadasi? vinēśvaraṁ kōpi paramō na bhavati|</para>
  <para style="p">
    <verse number="19" style="v"/>parastrīṁ nābhigaccha; naraṁ mā ghātaya; stēyaṁ mā kuru; mr̥ṣāsākṣyaṁ mā dēhi; hiṁsāñca mā kuru; pitarau sammanyasva; nidēśā ētē tvayā jñātāḥ|</para>
  <para style="p">
    <verse number="20" style="v"/>tatastana pratyuktaṁ, hē gurō bālyakālādahaṁ sarvvānētān ācarāmi|</para>
  <para style="p">
    <verse number="21" style="v"/>tadā yīśustaṁ vilōkya snēhēna babhāṣē, tavaikasyābhāva āstē; tvaṁ gatvā sarvvasvaṁ vikrīya daridrēbhyō viśrāṇaya, tataḥ svargē dhanaṁ prāpsyasi; tataḥ param ētya kruśaṁ vahan madanuvarttī bhava|</para>
  <para style="p">
    <verse number="22" style="v"/>kintu tasya bahusampadvidyamānatvāt sa imāṁ kathāmākarṇya viṣaṇō duḥkhitaśca san jagāma|</para>
  <para style="p">
    <verse number="23" style="v"/>atha yīśuścaturdiśō nirīkṣya śiṣyān avādīt, dhanilōkānām īśvararājyapravēśaḥ kīdr̥g duṣkaraḥ|</para>
  <para style="p">
    <verse number="24" style="v"/>tasya kathātaḥ śiṣyāścamaccakruḥ, kintu sa punaravadat, hē bālakā yē dhanē viśvasanti tēṣām īśvararājyapravēśaḥ kīdr̥g duṣkaraḥ|</para>
  <para style="p">
    <verse number="25" style="v"/>īśvararājyē dhanināṁ pravēśāt sūcirandhrēṇa mahāṅgasya gamanāgamanaṁ sukaraṁ|</para>
  <para style="p">
    <verse number="26" style="v"/>tadā śiṣyā atīva vismitāḥ parasparaṁ prōcuḥ, tarhi kaḥ paritrāṇaṁ prāptuṁ śaknōti?</para>
  <para style="p">
    <verse number="27" style="v"/>tatō yīśustān vilōkya babhāṣē, tan narasyāsādhyaṁ kintu nēśvarasya, yatō hētōrīśvarasya sarvvaṁ sādhyam|</para>
  <para style="p">
    <verse number="28" style="v"/>tadā pitara uvāca, paśya vayaṁ sarvvaṁ parityajya bhavatōnugāminō jātāḥ|</para>
  <para style="p">
    <verse number="29" style="v"/>tatō yīśuḥ pratyavadat, yuṣmānahaṁ yathārthaṁ vadāmi, madarthaṁ susaṁvādārthaṁ vā yō janaḥ sadanaṁ bhrātaraṁ bhaginīṁ pitaraṁ mātaraṁ jāyāṁ santānān bhūmi vā tyaktvā</para>
  <para style="p">
    <verse number="30" style="v"/>gr̥habhrātr̥bhaginīpitr̥mātr̥patnīsantānabhūmīnāmiha śataguṇān prētyānantāyuśca na prāpnōti tādr̥śaḥ kōpi nāsti|</para>
  <para style="p">
    <verse number="31" style="v"/>kintvagrīyā anēkē lōkāḥ śēṣāḥ, śēṣīyā anēkē lōkāścāgrā bhaviṣyanti|</para>
  <para style="p">
    <verse number="32" style="v"/>atha yirūśālamyānakālē yīśustēṣām agragāmī babhūva, tasmāttē citraṁ jñātvā paścādgāminō bhūtvā bibhyuḥ| tadā sa puna rdvādaśaśiṣyān gr̥hītvā svīyaṁ yadyad ghaṭiṣyatē tattat tēbhyaḥ kathayituṁ prārēbhē;</para>
  <para style="p">
    <verse number="33" style="v"/>paśyata vayaṁ yirūśālampuraṁ yāmaḥ, tatra manuṣyaputraḥ pradhānayājakānām upādhyāyānāñca karēṣu samarpayiṣyatē; tē ca vadhadaṇḍājñāṁ dāpayitvā paradēśīyānāṁ karēṣu taṁ samarpayiṣyanti|</para>
  <para style="p">
    <verse number="34" style="v"/>tē tamupahasya kaśayā prahr̥tya tadvapuṣi niṣṭhīvaṁ nikṣipya taṁ haniṣyanti, tataḥ sa tr̥tīyadinē prōtthāsyati|</para>
  <para style="p">
    <verse number="35" style="v"/>tataḥ sivadēḥ putrau yākūbyōhanau tadantikam ētya prōcatuḥ, hē gurō yad āvābhyāṁ yāciṣyatē tadasmadarthaṁ bhavān karōtu nivēdanamidamāvayōḥ|</para>
  <para style="p">
    <verse number="36" style="v"/>tataḥ sa kathitavān, yuvāṁ kimicchathaḥ? kiṁ mayā yuṣmadarthaṁ karaṇīyaṁ?</para>
  <para style="p">
    <verse number="37" style="v"/>tadā tau prōcatuḥ, āvayōrēkaṁ dakṣiṇapārśvē vāmapārśvē caikaṁ tavaiśvaryyapadē samupavēṣṭum ājñāpaya|</para>
  <para style="p">
    <verse number="38" style="v"/>kintu yīśuḥ pratyuvāca yuvāmajñātvēdaṁ prārthayēthē, yēna kaṁsēnāhaṁ pāsyāmi tēna yuvābhyāṁ kiṁ pātuṁ śakṣyatē? yasmin majjanēnāhaṁ majjiṣyē tanmajjanē majjayituṁ kiṁ yuvābhyāṁ śakṣyatē? tau pratyūcatuḥ śakṣyatē|</para>
  <para style="p">
    <verse number="39" style="v"/>tadā yīśuravadat yēna kaṁsēnāhaṁ pāsyāmi tēnāvaśyaṁ yuvāmapi pāsyathaḥ, yēna majjanēna cāhaṁ majjiyyē tatra yuvāmapi majjiṣyēthē|</para>
  <para style="p">
    <verse number="40" style="v"/>kintu yēṣāmartham idaṁ nirūpitaṁ, tān vihāyānyaṁ kamapi mama dakṣiṇapārśvē vāmapārśvē vā samupavēśayituṁ mamādhikārō nāsti|</para>
  <para style="p">
    <verse number="41" style="v"/>athānyadaśaśiṣyā imāṁ kathāṁ śrutvā yākūbyōhanbhyāṁ cukupuḥ|</para>
  <para style="p">
    <verse number="42" style="v"/>kintu yīśustān samāhūya babhāṣē, anyadēśīyānāṁ rājatvaṁ yē kurvvanti tē tēṣāmēva prabhutvaṁ kurvvanti, tathā yē mahālōkāstē tēṣām adhipatitvaṁ kurvvantīti yūyaṁ jānītha|</para>
  <para style="p">
    <verse number="43" style="v"/>kintu yuṣmākaṁ madhyē na tathā bhaviṣyati, yuṣmākaṁ madhyē yaḥ prādhānyaṁ vāñchati sa yuṣmākaṁ sēvakō bhaviṣyati,</para>
  <para style="p">
    <verse number="44" style="v"/>yuṣmākaṁ yō mahān bhavitumicchati sa sarvvēṣāṁ kiṅkarō bhaviṣyati|</para>
  <para style="p">
    <verse number="45" style="v"/>yatō manuṣyaputraḥ sēvyō bhavituṁ nāgataḥ sēvāṁ karttāṁ tathānēkēṣāṁ paritrāṇasya mūlyarūpasvaprāṇaṁ dātuñcāgataḥ|</para>
  <para style="p">
    <verse number="46" style="v"/>atha tē yirīhōnagaraṁ prāptāstasmāt śiṣyai rlōkaiśca saha yīśō rgamanakālē ṭīmayasya putrō barṭīmayanāmā andhastanmārgapārśvē bhikṣārtham upaviṣṭaḥ|</para>
  <para style="p">
    <verse number="47" style="v"/>sa nāsaratīyasya yīśōrāgamanavārttāṁ prāpya prōcai rvaktumārēbhē, hē yīśō dāyūdaḥ santāna māṁ dayasva|</para>
  <para style="p">
    <verse number="48" style="v"/>tatōnēkē lōkā maunībhavēti taṁ tarjayāmāsuḥ, kintu sa punaradhikamuccai rjagāda, hē yīśō dāyūdaḥ santāna māṁ dayasva|</para>
  <para style="p">
    <verse number="49" style="v"/>tadā yīśuḥ sthitvā tamāhvātuṁ samādidēśa, tatō lōkāstamandhamāhūya babhāṣirē, hē nara, sthirō bhava, uttiṣṭha, sa tvāmāhvayati|</para>
  <para style="p">
    <verse number="50" style="v"/>tadā sa uttarīyavastraṁ nikṣipya prōtthāya yīśōḥ samīpaṁ gataḥ|</para>
  <para style="p">
    <verse number="51" style="v"/>tatō yīśustamavadat tvayā kiṁ prārthyatē? tubhyamahaṁ kiṁ kariṣyāmī? tadā sōndhastamuvāca, hē gurō madīyā dr̥ṣṭirbhavēt|</para>
  <para style="p">
    <verse number="52" style="v"/>tatō yīśustamuvāca yāhi tava viśvāsastvāṁ svasthamakārṣīt, tasmāt tatkṣaṇaṁ sa dr̥ṣṭiṁ prāpya pathā yīśōḥ paścād yayau|</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ tēṣu yirūśālamaḥ samīpasthayō rbaitphagībaithanīyapurayōrantikasthaṁ jaitunanāmādrimāgatēṣu yīśuḥ prēṣaṇakālē dvau śiṣyāvidaṁ vākyaṁ jagāda,</para>
  <para style="p">
    <verse number="2" style="v"/>yuvāmamuṁ sammukhasthaṁ grāmaṁ yātaṁ, tatra praviśya yō naraṁ nāvahat taṁ garddabhaśāvakaṁ drakṣyathastaṁ mōcayitvānayataṁ|</para>
  <para style="p">
    <verse number="3" style="v"/>kintu yuvāṁ karmmēdaṁ kutaḥ kuruthaḥ? kathāmimāṁ yadi kōpi pr̥cchati tarhi prabhōratra prayōjanamastīti kathitē sa śīghraṁ tamatra prēṣayiṣyati|</para>
  <para style="p">
    <verse number="4" style="v"/>tatastau gatvā dvimārgamēlanē kasyacid dvārasya pārśvē taṁ garddabhaśāvakaṁ prāpya mōcayataḥ,</para>
  <para style="p">
    <verse number="5" style="v"/>ētarhi tatrōpasthitalōkānāṁ kaścid apr̥cchat, garddabhaśiśuṁ kutō mōcayathaḥ?</para>
  <para style="p">
    <verse number="6" style="v"/>tadā yīśōrājñānusārēṇa tēbhyaḥ pratyuditē tatkṣaṇaṁ tamādātuṁ tē'nujajñuḥ|</para>
  <para style="p">
    <verse number="7" style="v"/>atha tau yīśōḥ sannidhiṁ garddabhaśiśum ānīya tadupari svavastrāṇi pātayāmāsatuḥ; tataḥ sa tadupari samupaviṣṭaḥ|</para>
  <para style="p">
    <verse number="8" style="v"/>tadānēkē pathi svavāsāṁsi pātayāmāsuḥ, paraiśca taruśākhāśchitavā mārgē vikīrṇāḥ|</para>
  <para style="p">
    <verse number="9" style="v"/>aparañca paścādgāminō'gragāminaśca sarvvē janā ucaiḥsvarēṇa vaktumārēbhirē, jaya jaya yaḥ paramēśvarasya nāmnāgacchati sa dhanya iti|</para>
  <para style="p">
    <verse number="10" style="v"/>tathāsmākamaṁ pūrvvapuruṣasya dāyūdō yadrājyaṁ paramēśvaranāmnāyāti tadapi dhanyaṁ, sarvvasmāducchrāyē svargē īśvarasya jayō bhavēt|</para>
  <para style="p">
    <verse number="11" style="v"/>itthaṁ yīśu ryirūśālami mandiraṁ praviśya caturdiksthāni sarvvāṇi vastūni dr̥ṣṭavān; atha sāyaṁkāla upasthitē dvādaśaśiṣyasahitō baithaniyaṁ jagāma|</para>
  <para style="p">
    <verse number="12" style="v"/>aparēhani baithaniyād āgamanasamayē kṣudhārttō babhūva|</para>
  <para style="p">
    <verse number="13" style="v"/>tatō dūrē sapatramuḍumbarapādapaṁ vilōkya tatra kiñcit phalaṁ prāptuṁ tasya sannikr̥ṣṭaṁ yayau, tadānīṁ phalapātanasya samayō nāgacchati| tatastatrōpasthitaḥ patrāṇi vinā kimapyaparaṁ na prāpya sa kathitavān,</para>
  <para style="p">
    <verse number="14" style="v"/>adyārabhya kōpi mānavastvattaḥ phalaṁ na bhuñjīta; imāṁ kathāṁ tasya śiṣyāḥ śuśruvuḥ|</para>
  <para style="p">
    <verse number="15" style="v"/>tadanantaraṁ tēṣu yirūśālamamāyātēṣu yīśu rmandiraṁ gatvā tatrasthānāṁ baṇijāṁ mudrāsanāni pārāvatavikrētr̥ṇām āsanāni ca nyubjayāñcakāra sarvvān krētr̥n vikrētr̥ṁśca bahiścakāra|</para>
  <para style="p">
    <verse number="16" style="v"/>aparaṁ mandiramadhyēna kimapi pātraṁ vōḍhuṁ sarvvajanaṁ nivārayāmāsa|</para>
  <para style="p">
    <verse number="17" style="v"/>lōkānupadiśan jagāda, mama gr̥haṁ sarvvajātīyānāṁ prārthanāgr̥ham iti nāmnā prathitaṁ bhaviṣyati ētat kiṁ śāstrē likhitaṁ nāsti? kintu yūyaṁ tadēva cōrāṇāṁ gahvaraṁ kurutha|</para>
  <para style="p">
    <verse number="18" style="v"/>imāṁ vāṇīṁ śrutvādhyāpakāḥ pradhānayājakāśca taṁ yathā nāśayituṁ śaknuvanti tathōेpāyaṁ mr̥gayāmāsuḥ, kintu tasyōpadēśāt sarvvē lōkā vismayaṁ gatā atastē tasmād bibhyuḥ|</para>
  <para style="p">
    <verse number="19" style="v"/>atha sāyaṁsamaya upasthitē yīśurnagarād bahirvavrāja|</para>
  <para style="p">
    <verse number="20" style="v"/>anantaraṁ prātaḥkālē tē tēna mārgēṇa gacchantastamuḍumbaramahīruhaṁ samūlaṁ śuṣkaṁ dadr̥śuḥ|</para>
  <para style="p">
    <verse number="21" style="v"/>tataḥ pitaraḥ pūrvvavākyaṁ smaran yīśuṁ babhāṣaṁ, hē gurō paśyatu ya uḍumbaraviṭapī bhavatā śaptaḥ sa śuṣkō babhūva|</para>
  <para style="p">
    <verse number="22" style="v"/>tatō yīśuḥ pratyavādīt, yūyamīśvarē viśvasita|</para>
  <para style="p">
    <verse number="23" style="v"/>yuṣmānahaṁ yathārthaṁ vadāmi kōpi yadyētadgiriṁ vadati, tvamutthāya gatvā jaladhau pata, prōktamidaṁ vākyamavaśyaṁ ghaṭiṣyatē, manasā kimapi na sandihya cēdidaṁ viśvasēt tarhi tasya vākyānusārēṇa tad ghaṭiṣyatē|</para>
  <para style="p">
    <verse number="24" style="v"/>atō hētōrahaṁ yuṣmān vacmi, prārthanākālē yadyadākāṁkṣiṣyadhvē tattadavaśyaṁ prāpsyatha, itthaṁ viśvasita, tataḥ prāpsyatha|</para>
  <para style="p">
    <verse number="25" style="v"/>aparañca yuṣmāsu prārthayituṁ samutthitēṣu yadi kōpi yuṣmākam aparādhī tiṣṭhati, tarhi taṁ kṣamadhvaṁ, tathā kr̥tē yuṣmākaṁ svargasthaḥ pitāpi yuṣmākamāgāṁmi kṣamiṣyatē|</para>
  <para style="p">
    <verse number="26" style="v"/>kintu yadi na kṣamadhvē tarhi vaḥ svargasthaḥ pitāpi yuṣmākamāgāṁsi na kṣamiṣyatē|</para>
  <para style="p">
    <verse number="27" style="v"/>anantaraṁ tē puna ryirūśālamaṁ praviviśuḥ, yīśu ryadā madhyēmandiram itastatō gacchati, tadānīṁ pradhānayājakā upādhyāyāḥ prāñcaśca tadantikamētya kathāmimāṁ papracchuḥ,</para>
  <para style="p">
    <verse number="28" style="v"/>tvaṁ kēnādēśēna karmmāṇyētāni karōṣi? tathaitāni karmmāṇi karttāṁ kēnādiṣṭōsi?</para>
  <para style="p">
    <verse number="29" style="v"/>tatō yīśuḥ pratigaditavān ahamapi yuṣmān ēkakathāṁ pr̥cchāmi, yadi yūyaṁ tasyā uttaraṁ kurutha, tarhi kayājñayāhaṁ karmmāṇyētāni karōmi tad yuṣmabhyaṁ kathayiṣyāmi|</para>
  <para style="p">
    <verse number="30" style="v"/>yōhanō majjanam īśvarāt jātaṁ kiṁ mānavāt? tanmahyaṁ kathayata|</para>
  <para style="p">
    <verse number="31" style="v"/>tē parasparaṁ vivēktuṁ prārēbhirē, tad īśvarād babhūvēti cēd vadāmastarhi kutastaṁ na pratyaita? kathamētāṁ kathayiṣyati|</para>
  <para style="p">
    <verse number="32" style="v"/>mānavād abhavaditi cēd vadāmastarhi lōkēbhyō bhayamasti yatō hētōḥ sarvvē yōhanaṁ satyaṁ bhaviṣyadvādinaṁ manyantē|</para>
  <para style="p">
    <verse number="33" style="v"/>ataēva tē yīśuṁ pratyavādiṣu rvayaṁ tad vaktuṁ na śaknumaḥ| yīśuruvāca, tarhi yēnādēśēna karmmāṇyētāni karōmi, ahamapi yuṣmabhyaṁ tanna kathayiṣyāmi|</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ yīśu rdr̥ṣṭāntēna tēbhyaḥ kathayitumārēbhē, kaścidēkō drākṣākṣētraṁ vidhāya taccaturdikṣu vāraṇīṁ kr̥tvā tanmadhyē drākṣāpēṣaṇakuṇḍam akhanat, tathā tasya gaḍamapi nirmmitavān tatastatkṣētraṁ kr̥ṣīvalēṣu samarpya dūradēśaṁ jagāma|</para>
  <para style="p">
    <verse number="2" style="v"/>tadanantaraṁ phalakālē kr̥ṣīvalēbhyō drākṣākṣētraphalāni prāptuṁ tēṣāṁ savidhē bhr̥tyam ēkaṁ prāhiṇōt|</para>
  <para style="p">
    <verse number="3" style="v"/>kintu kr̥ṣīvalāstaṁ dhr̥tvā prahr̥tya riktahastaṁ visasr̥juḥ|</para>
  <para style="p">
    <verse number="4" style="v"/>tataḥ sa punaranyamēkaṁ bhr̥tyaṁ praṣayāmāsa, kintu tē kr̥ṣīvalāḥ pāṣāṇāghātaistasya śirō bhaṅktvā sāpamānaṁ taṁ vyasarjan|</para>
  <para style="p">
    <verse number="5" style="v"/>tataḥ paraṁ sōparaṁ dāsaṁ prāhiṇōt tadā tē taṁ jaghnuḥ, ēvam anēkēṣāṁ kasyacit prahāraḥ kasyacid vadhaśca taiḥ kr̥taḥ|</para>
  <para style="p">
    <verse number="6" style="v"/>tataḥ paraṁ mayā svaputrē prahitē tē tamavaśyaṁ sammaṁsyantē, ityuktvāvaśēṣē tēṣāṁ sannidhau nijapriyam advitīyaṁ putraṁ prēṣayāmāsa|</para>
  <para style="p">
    <verse number="7" style="v"/>kintu kr̥ṣīvalāḥ parasparaṁ jagaduḥ, ēṣa uttarādhikārī, āgacchata vayamēnaṁ hanmastathā kr̥tē 'dhikārōyam asmākaṁ bhaviṣyati|</para>
  <para style="p">
    <verse number="8" style="v"/>tatastaṁ dhr̥tvā hatvā drākṣākṣētrād bahiḥ prākṣipan|</para>
  <para style="p">
    <verse number="9" style="v"/>anēnāsau drākṣākṣētrapatiḥ kiṁ kariṣyati? sa ētya tān kr̥ṣīvalān saṁhatya tatkṣētram anyēṣu kr̥ṣīvalēṣu samarpayiṣyati|</para>
  <para style="p">
    <verse number="10" style="v"/>aparañca, "sthapatayaḥ kariṣyanti grāvāṇaṁ yantu tucchakaṁ| prādhānaprastaraḥ kōṇē sa ēva saṁbhaviṣyati|</para>
  <para style="p">
    <verse number="11" style="v"/>ētat karmma parēśasyāṁdbhutaṁ nō dr̥ṣṭitō bhavēt||" imāṁ śāstrīyāṁ lipiṁ yūyaṁ kiṁ nāpāṭhiṣṭa?</para>
  <para style="p">
    <verse number="12" style="v"/>tadānīṁ sa tānuddiśya tāṁ dr̥ṣṭāntakathāṁ kathitavān, ta itthaṁ budvvā taṁ dharttāmudyatāḥ, kintu lōkēbhyō bibhyuḥ, tadanantaraṁ tē taṁ vihāya vavrajuḥ|</para>
  <para style="p">
    <verse number="13" style="v"/>aparañca tē tasya vākyadōṣaṁ dharttāṁ katipayān phirūśinō hērōdīyāṁśca lōkān tadantikaṁ prēṣayāmāsuḥ|</para>
  <para style="p">
    <verse number="14" style="v"/>ta āgatya tamavadan, hē gurō bhavān tathyabhāṣī kasyāpyanurōdhaṁ na manyatē, pakṣapātañca na karōti, yathārthata īśvarīyaṁ mārgaṁ darśayati vayamētat prajānīmaḥ, kaisarāya karō dēyō na vāṁ? vayaṁ dāsyāmō na vā?</para>
  <para style="p">
    <verse number="15" style="v"/>kintu sa tēṣāṁ kapaṭaṁ jñātvā jagāda, kutō māṁ parīkṣadhvē? ēkaṁ mudrāpādaṁ samānīya māṁ darśayata|</para>
  <para style="p">
    <verse number="16" style="v"/>tadā tairēkasmin mudrāpādē samānītē sa tān papraccha, atra likhitaṁ nāma mūrtti rvā kasya? tē pratyūcuḥ, kaisarasya|</para>
  <para style="p">
    <verse number="17" style="v"/>tadā yīśuravadat tarhi kaisarasya dravyāṇi kaisarāya datta, īśvarasya dravyāṇi tu īśvarāya datta; tatastē vismayaṁ mēnirē|</para>
  <para style="p">
    <verse number="18" style="v"/>atha mr̥tānāmutthānaṁ yē na manyantē tē sidūkinō yīśōḥ samīpamāgatya taṁ papracchuḥ;</para>
  <para style="p">
    <verse number="19" style="v"/>hē gurō kaścijjanō yadi niḥsantatiḥ san bhāryyāyāṁ satyāṁ mriyatē tarhi tasya bhrātā tasya bhāryyāṁ gr̥hītvā bhrātu rvaṁśōtpattiṁ kariṣyati, vyavasthāmimāṁ mūsā asmān prati vyalikhat|</para>
  <para style="p">
    <verse number="20" style="v"/>kintu kēcit sapta bhrātara āsan, tatastēṣāṁ jyēṣṭhabhrātā vivahya niḥsantatiḥ san amriyata|</para>
  <para style="p">
    <verse number="21" style="v"/>tatō dvitīyō bhrātā tāṁ striyamagr̥haṇat kintu sōpi niḥsantatiḥ san amriyata; atha tr̥tīyōpi bhrātā tādr̥śōbhavat|</para>
  <para style="p">
    <verse number="22" style="v"/>itthaṁ saptaiva bhrātarastāṁ striyaṁ gr̥hītvā niḥsantānāḥ santō'mriyanta, sarvvaśēṣē sāpi strī mriyatē sma|</para>
  <para style="p">
    <verse number="23" style="v"/>atha mr̥tānāmutthānakālē yadā ta utthāsyanti tadā tēṣāṁ kasya bhāryyā sā bhaviṣyati? yatastē saptaiva tāṁ vyavahan|</para>
  <para style="p">
    <verse number="24" style="v"/>tatō yīśuḥ pratyuvāca śāstram īśvaraśaktiñca yūyamajñātvā kimabhrāmyata na?</para>
  <para style="p">
    <verse number="25" style="v"/>mr̥talōkānāmutthānaṁ sati tē na vivahanti vāgdattā api na bhavanti, kintu svargīyadūtānāṁ sadr̥śā bhavanti|</para>
  <para style="p">
    <verse number="26" style="v"/>punaśca "aham ibrāhīma īśvara ishāka īśvarō yākūbaścēśvaraḥ" yāmimāṁ kathāṁ stambamadhyē tiṣṭhan īśvarō mūsāmavādīt mr̥tānāmutthānārthē sā kathā mūsālikhitē pustakē kiṁ yuṣmābhi rnāpāṭhi?</para>
  <para style="p">
    <verse number="27" style="v"/>īśvarō jīvatāṁ prabhuḥ kintu mr̥tānāṁ prabhu rna bhavati, tasmāddhētō ryūyaṁ mahābhramēṇa tiṣṭhatha|</para>
  <para style="p">
    <verse number="28" style="v"/>ētarhi ēkōdhyāpaka ētya tēṣāmitthaṁ vicāraṁ śuśrāva; yīśustēṣāṁ vākyasya saduttaraṁ dattavān iti budvvā taṁ pr̥ṣṭavān sarvvāsām ājñānāṁ kā śrēṣṭhā? tatō yīśuḥ pratyuvāca,</para>
  <para style="p">
    <verse number="29" style="v"/>"hē isrāyēllōkā avadhatta, asmākaṁ prabhuḥ paramēśvara ēka ēva,</para>
  <para style="p">
    <verse number="30" style="v"/>yūyaṁ sarvvantaḥkaraṇaiḥ sarvvaprāṇaiḥ sarvvacittaiḥ sarvvaśaktibhiśca tasmin prabhau paramēśvarē prīyadhvaṁ," ityājñā śrēṣṭhā|</para>
  <para style="p">
    <verse number="31" style="v"/>tathā "svaprativāsini svavat prēma kurudhvaṁ," ēṣā yā dvitīyājñā sā tādr̥śī; ētābhyāṁ dvābhyām ājñābhyām anyā kāpyājñā śrēṣṭhā nāsti|</para>
  <para style="p">
    <verse number="32" style="v"/>tadā sōdhyāpakastamavadat, hē gurō satyaṁ bhavān yathārthaṁ prōktavān yata ēkasmād īśvarād anyō dvitīya īśvarō nāsti;</para>
  <para style="p">
    <verse number="33" style="v"/>aparaṁ sarvvāntaḥkaraṇaiḥ sarvvaprāṇaiḥ sarvvacittaiḥ sarvvaśaktibhiśca īśvarē prēmakaraṇaṁ tathā svamīpavāsini svavat prēmakaraṇañca sarvvēbhyō hōmabalidānādibhyaḥ śraṣṭhaṁ bhavati|</para>
  <para style="p">
    <verse number="34" style="v"/>tatō yīśuḥ subuddhēriva tasyēdam uttaraṁ śrutvā taṁ bhāṣitavān tvamīśvarasya rājyānna dūrōsi|itaḥ paraṁ tēna saha kasyāpi vākyasya vicāraṁ karttāṁ kasyāpi pragalbhatā na jātā|</para>
  <para style="p">
    <verse number="35" style="v"/>anantaraṁ madhyēmandiram upadiśan yīśurimaṁ praśnaṁ cakāra, adhyāpakā abhiṣiktaṁ (tārakaṁ) kutō dāyūdaḥ santānaṁ vadanti?</para>
  <para style="p">
    <verse number="36" style="v"/>svayaṁ dāyūd pavitrasyātmana āvēśēnēdaṁ kathayāmāsa| yathā| "mama prabhumidaṁ vākyavadat paramēśvaraḥ| tava śatrūnahaṁ yāvat pādapīṭhaṁ karōmi na| tāvat kālaṁ madīyē tvaṁ dakṣapārśv upāviśa|"</para>
  <para style="p">
    <verse number="37" style="v"/>yadi dāyūd taṁ prabhūṁ vadati tarhi kathaṁ sa tasya santānō bhavitumarhati? itarē lōkāstatkathāṁ śrutvānananduḥ|</para>
  <para style="p">
    <verse number="38" style="v"/>tadānīṁ sa tānupadiśya kathitavān yē narā dīrghaparidhēyāni haṭṭē vipanau ca</para>
  <para style="p">
    <verse number="39" style="v"/>lōkakr̥tanamaskārān bhajanagr̥hē pradhānāsanāni bhōjanakālē pradhānasthānāni ca kāṅkṣantē;</para>
  <para style="p">
    <verse number="40" style="v"/>vidhavānāṁ sarvvasvaṁ grasitvā chalād dīrghakālaṁ prārthayantē tēbhya upādhyāyēbhyaḥ sāvadhānā bhavata; tē'dhikatarān daṇḍān prāpsyanti|</para>
  <para style="p">
    <verse number="41" style="v"/>tadanantaraṁ lōkā bhāṇḍāgārē mudrā yathā nikṣipanti bhāṇḍāgārasya sammukhē samupaviśya yīśustadavalulōka; tadānīṁ bahavō dhaninastasya madhyē bahūni dhanāni nirakṣipan|</para>
  <para style="p">
    <verse number="42" style="v"/>paścād ēkā daridrā vidhavā samāgatya dvipaṇamūlyāṁ mudraikāṁ tatra nirakṣipat|</para>
  <para style="p">
    <verse number="43" style="v"/>tadā yīśuḥ śiṣyān āhūya kathitavān yuṣmānahaṁ yathārthaṁ vadāmi yē yē bhāṇḍāgārē'smina dhanāni niḥkṣipanti sma tēbhyaḥ sarvvēbhya iyaṁ vidhavā daridrādhikam niḥkṣipati sma|</para>
  <para style="p">
    <verse number="44" style="v"/>yatastē prabhūtadhanasya kiñcit nirakṣipan kintu dīnēyaṁ svadinayāpanayōgyaṁ kiñcidapi na sthāpayitvā sarvvasvaṁ nirakṣipat|</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ mandirād bahirgamanakālē tasya śiṣyāṇāmēkastaṁ vyāhr̥tavān hē gurō paśyatu kīdr̥śāḥ pāṣāṇāḥ kīdr̥k ca nicayanaṁ|</para>
  <para style="p">
    <verse number="2" style="v"/>tadā yīśustam avadat tvaṁ kimētad br̥hannicayanaṁ paśyasi? asyaikapāṣāṇōpi dvitīyapāṣāṇōpari na sthāsyati sarvvē 'dhaḥkṣēpsyantē|</para>
  <para style="p">
    <verse number="3" style="v"/>atha yasmin kālē jaitungirau mandirasya sammukhē sa samupaviṣṭastasmin kālē pitarō yākūb yōhan āndriyaścaitē taṁ rahasi papracchuḥ,</para>
  <para style="p">
    <verse number="4" style="v"/>ētā ghaṭanāḥ kadā bhaviṣyanti? tathaitatsarvvāsāṁ siddhyupakramasya vā kiṁ cihnaṁ? tadasmabhyaṁ kathayatu bhavān|</para>
  <para style="p">
    <verse number="5" style="v"/>tatō yāśustān vaktumārēbhē, kōpi yathā yuṣmān na bhrāmayati tathātra yūyaṁ sāvadhānā bhavata|</para>
  <para style="p">
    <verse number="6" style="v"/>yataḥ khrīṣṭōhamiti kathayitvā mama nāmnānēkē samāgatya lōkānāṁ bhramaṁ janayiṣyanti;</para>
  <para style="p">
    <verse number="7" style="v"/>kintu yūyaṁ raṇasya vārttāṁ raṇāḍambarañca śrutvā mā vyākulā bhavata, ghaṭanā ētā avaśyammāvinyaḥ; kintvāpātatō na yugāntō bhaviṣyati|</para>
  <para style="p">
    <verse number="8" style="v"/>dēśasya vipakṣatayā dēśō rājyasya vipakṣatayā ca rājyamutthāsyati, tathā sthānē sthānē bhūmikampō durbhikṣaṁ mahāklēśāśca samupasthāsyanti, sarvva ētē duḥkhasyārambhāḥ|</para>
  <para style="p">
    <verse number="9" style="v"/>kintu yūyam ātmārthē sāvadhānāstiṣṭhata, yatō lōkā rājasabhāyāṁ yuṣmān samarpayiṣyanti, tathā bhajanagr̥hē prahariṣyanti; yūyaṁ madarthē dēśādhipān bhūpāṁśca prati sākṣyadānāya tēṣāṁ sammukhē upasthāpayiṣyadhvē|</para>
  <para style="p">
    <verse number="10" style="v"/>śēṣībhavanāt pūrvvaṁ sarvvān dēśīyān prati susaṁvādaḥ pracārayiṣyatē|</para>
  <para style="p">
    <verse number="11" style="v"/>kintu yadā tē yuṣmān dhr̥tvā samarpayiṣyanti tadā yūyaṁ yadyad uttaraṁ dāsyatha, tadagra tasya vivēcanaṁ mā kuruta tadarthaṁ kiñcidapi mā cintayata ca, tadānīṁ yuṣmākaṁ manaḥsu yadyad vākyam upasthāpayiṣyatē tadēva vadiṣyatha, yatō yūyaṁ na tadvaktāraḥ kintu pavitra ātmā tasya vaktā|</para>
  <para style="p">
    <verse number="12" style="v"/>tadā bhrātā bhrātaraṁ pitā putraṁ ghātanārthaṁ parahastēṣu samarpayiṣyatē, tathā patyāni mātāpitrō rvipakṣatayā tau ghātayiṣyanti|</para>
  <para style="p">
    <verse number="13" style="v"/>mama nāmahētōḥ sarvvēṣāṁ savidhē yūyaṁ jugupsitā bhaviṣyatha, kintu yaḥ kaścit śēṣaparyyantaṁ dhairyyam ālambiṣyatē saēva paritrāsyatē|</para>
  <para style="p">
    <verse number="14" style="v"/>dāniyēlbhaviṣyadvādinā prōktaṁ sarvvanāśi jugupsitañca vastu yadā tvayōgyasthānē vidyamānaṁ drakṣatha (yō janaḥ paṭhati sa budhyatāṁ) tadā yē yihūdīyadēśē tiṣṭhanti tē mahīdhraṁ prati palāyantāṁ;</para>
  <para style="p">
    <verse number="15" style="v"/>tathā yō narō gr̥hōpari tiṣṭhati sa gr̥hamadhyaṁ nāvarōhatu, tathā kimapi vastu grahītuṁ madhyēgr̥haṁ na praviśatu;</para>
  <para style="p">
    <verse number="16" style="v"/>tathā ca yō naraḥ kṣētrē tiṣṭhati sōpi svavastraṁ grahītuṁ parāvr̥tya na vrajatu|</para>
  <para style="p">
    <verse number="17" style="v"/>tadānīṁ garbbhavatīnāṁ stanyadātrīṇāñca yōṣitāṁ durgati rbhaviṣyati|</para>
  <para style="p">
    <verse number="18" style="v"/>yuṣmākaṁ palāyanaṁ śītakālē yathā na bhavati tadarthaṁ prārthayadhvaṁ|</para>
  <para style="p">
    <verse number="19" style="v"/>yatastadā yādr̥śī durghaṭanā ghaṭiṣyatē tādr̥śī durghaṭanā īśvarasr̥ṣṭēḥ prathamamārabhyādya yāvat kadāpi na jātā na janiṣyatē ca|</para>
  <para style="p">
    <verse number="20" style="v"/>aparañca paramēśvarō yadi tasya samayasya saṁkṣēpaṁ na karōti tarhi kasyāpi prāṇabhr̥tō rakṣā bhavituṁ na śakṣyati, kintu yān janān manōnītān akarōt tēṣāṁ svamanōnītānāṁ hētōḥ sa tadanēhasaṁ saṁkṣēpsyati|</para>
  <para style="p">
    <verse number="21" style="v"/>anyacca paśyata khrīṣṭōtra sthānē vā tatra sthānē vidyatē, tasminkālē yadi kaścid yuṣmān ētādr̥śaṁ vākyaṁ vyāharati, tarhi tasmin vākyē bhaiva viśvasita|</para>
  <para style="p">
    <verse number="22" style="v"/>yatōnēkē mithyākhrīṣṭā mithyābhaviṣyadvādinaśca samupasthāya bahūni cihnānyadbhutāni karmmāṇi ca darśayiṣyanti; tathā yadi sambhavati tarhi manōnītalōkānāmapi mithyāmatiṁ janayiṣyanti|</para>
  <para style="p">
    <verse number="23" style="v"/>paśyata ghaṭanātaḥ pūrvvaṁ sarvvakāryyasya vārttāṁ yuṣmabhyamadām, yūyaṁ sāvadhānāstiṣṭhata|</para>
  <para style="p">
    <verse number="24" style="v"/>aparañca tasya klēśakālasyāvyavahitē parakālē bhāskaraḥ sāndhakārō bhaviṣyati tathaiva candraścandrikāṁ na dāsyati|</para>
  <para style="p">
    <verse number="25" style="v"/>nabhaḥsthāni nakṣatrāṇi patiṣyanti, vyōmamaṇḍalasthā grahāśca vicaliṣyanti|</para>
  <para style="p">
    <verse number="26" style="v"/>tadānīṁ mahāparākramēṇa mahaiśvaryyēṇa ca mēghamāruhya samāyāntaṁ mānavasutaṁ mānavāḥ samīkṣiṣyantē|</para>
  <para style="p">
    <verse number="27" style="v"/>anyacca sa nijadūtān prahitya nabhōbhūmyōḥ sīmāṁ yāvad jagataścaturdigbhyaḥ svamanōnītalōkān saṁgrahīṣyati|</para>
  <para style="p">
    <verse number="28" style="v"/>uḍumbaratarō rdr̥ṣṭāntaṁ śikṣadhvaṁ yadōḍumbarasya tarō rnavīnāḥ śākhā jāyantē pallavādīni ca rnigacchanti, tadā nidāghakālaḥ savidhō bhavatīti yūyaṁ jñātuṁ śaknutha|</para>
  <para style="p">
    <verse number="29" style="v"/>tadvad ētā ghaṭanā dr̥ṣṭvā sa kālō dvāryyupasthita iti jānīta|</para>
  <para style="p">
    <verse number="30" style="v"/>yuṣmānahaṁ yathārthaṁ vadāmi, ādhunikalōkānāṁ gamanāt pūrvvaṁ tāni sarvvāṇi ghaṭiṣyantē|</para>
  <para style="p">
    <verse number="31" style="v"/>dyāvāpr̥thivyō rvicalitayōḥ satyō rmadīyā vāṇī na vicaliṣyati|</para>
  <para style="p">
    <verse number="32" style="v"/>aparañca svargasthadūtagaṇō vā putrō vā tātādanyaḥ kōpi taṁ divasaṁ taṁ daṇḍaṁ vā na jñāpayati|</para>
  <para style="p">
    <verse number="33" style="v"/>ataḥ sa samayaḥ kadā bhaviṣyati, ētajjñānābhāvād yūyaṁ sāvadhānāstiṣṭhata, satarkāśca bhūtvā prārthayadhvaṁ;</para>
  <para style="p">
    <verse number="34" style="v"/>yadvat kaścit pumān svanivēśanād dūradēśaṁ prati yātrākaraṇakālē dāsēṣu svakāryyasya bhāramarpayitvā sarvvān svē svē karmmaṇi niyōjayati; aparaṁ dauvārikaṁ jāgarituṁ samādiśya yāti, tadvan naraputraḥ|</para>
  <para style="p">
    <verse number="35" style="v"/>gr̥hapatiḥ sāyaṁkālē niśīthē vā tr̥tīyayāmē vā prātaḥkālē vā kadāgamiṣyati tad yūyaṁ na jānītha;</para>
  <para style="p">
    <verse number="36" style="v"/>sa haṭhādāgatya yathā yuṣmān nidritān na paśyati, tadarthaṁ jāgaritāstiṣṭhata|</para>
  <para style="p">
    <verse number="37" style="v"/>yuṣmānahaṁ yad vadāmi tadēva sarvvān vadāmi, jāgaritāstiṣṭhatēti|</para>
  <chapter number="14" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tadā nistārōtsavakiṇvahīnapūpōtsavayōrārambhasya dinadvayē 'vaśiṣṭē pradhānayājakā adhyāpakāśca kēnāpi chalēna yīśuṁ dharttāṁ hantuñca mr̥gayāñcakrirē;</para>
  <para style="p">
    <verse number="2" style="v"/>kintu lōkānāṁ kalahabhayādūcirē, nacōtsavakāla ucitamētaditi|</para>
  <para style="p">
    <verse number="3" style="v"/>anantaraṁ baithaniyāpuुrē śimōnakuṣṭhinō gr̥hē yōśau bhōtkumupaviṣṭē sati kācid yōṣit pāṇḍarapāṣāṇasya sampuṭakēna mahārghyōttamatailam ānīya sampuṭakaṁ bhaṁktvā tasyōttamāṅgē tailadhārāṁ pātayāñcakrē|</para>
  <para style="p">
    <verse number="4" style="v"/>tasmāt kēcit svāntē kupyantaḥ kathitavaṁntaḥ kutōyaṁ tailāpavyayaḥ?</para>
  <para style="p">
    <verse number="5" style="v"/>yadyētat taila vyakrēṣyata tarhi mudrāpādaśatatrayādapyadhikaṁ tasya prāptamūlyaṁ daridralōkēbhyō dātumaśakṣyata, kathāmētāṁ kathayitvā tayā yōṣitā sākaṁ vācāyuhyan|</para>
  <para style="p">
    <verse number="6" style="v"/>kintu yīśuruvāca, kuta ētasyai kr̥cchraṁ dadāsi? mahyamiyaṁ karmmōttamaṁ kr̥tavatī|</para>
  <para style="p">
    <verse number="7" style="v"/>daridrāḥ sarvvadā yuṣmābhiḥ saha tiṣṭhanti, tasmād yūyaṁ yadēcchatha tadaiva tānupakarttāṁ śaknutha, kintvahaṁ yubhābhiḥ saha nirantaraṁ na tiṣṭhāmi|</para>
  <para style="p">
    <verse number="8" style="v"/>asyā yathāsādhyaṁ tathaivākarōdiyaṁ, śmaśānayāpanāt pūrvvaṁ samētya madvapuṣi tailam amarddayat|</para>
  <para style="p">
    <verse number="9" style="v"/>ahaṁ yuṣmabhyaṁ yathārthaṁ kathayāmi, jagatāṁ madhyē yatra yatra susaṁvādōyaṁ pracārayiṣyatē tatra tatra yōṣita ētasyāḥ smaraṇārthaṁ tatkr̥takarmmaitat pracārayiṣyatē|</para>
  <para style="p">
    <verse number="10" style="v"/>tataḥ paraṁ dvādaśānāṁ śiṣyāṇāmēka īṣkariyōtīyayihūdākhyō yīśuṁ parakarēṣu samarpayituṁ pradhānayājakānāṁ samīpamiyāya|</para>
  <para style="p">
    <verse number="11" style="v"/>tē tasya vākyaṁ samākarṇya santuṣṭāḥ santastasmai mudrā dātuṁ pratyajānata; tasmāt sa taṁ tēṣāṁ karēṣu samarpaṇāyōpāyaṁ mr̥gayāmāsa|</para>
  <para style="p">
    <verse number="12" style="v"/>anantaraṁ kiṇvaśūnyapūpōtsavasya prathamē'hani nistārōtmavārthaṁ mēṣamāraṇāsamayē śiṣyāstaṁ papracchaḥ kutra gatvā vayaṁ nistārōtsavasya bhōjyamāsādayiṣyāmaḥ? kimicchati bhavān?</para>
  <para style="p">
    <verse number="13" style="v"/>tadānīṁ sa tēṣāṁ dvayaṁ prērayan babhāṣē yuvayōḥ puramadhyaṁ gatayōḥ satō ryō janaḥ sajalakumbhaṁ vahan yuvāṁ sākṣāt kariṣyati tasyaiva paścād yātaṁ;</para>
  <para style="p">
    <verse number="14" style="v"/>sa yat sadanaṁ pravēkṣyati tadbhavanapatiṁ vadataṁ, gururāha yatra saśiṣyōhaṁ nistārōtsavīyaṁ bhōjanaṁ kariṣyāmi, sā bhōjanaśālā kutrāsti?</para>
  <para style="p">
    <verse number="15" style="v"/>tataḥ sa pariṣkr̥tāṁ susajjitāṁ br̥hatīcañca yāṁ śālāṁ darśayiṣyati tasyāmasmadarthaṁ bhōjyadravyāṇyāsādayataṁ|</para>
  <para style="p">
    <verse number="16" style="v"/>tataḥ śiṣyau prasthāya puraṁ praviśya sa yathōktavān tathaiva prāpya nistārōtsavasya bhōjyadravyāṇi samāsādayētām|</para>
  <para style="p">
    <verse number="17" style="v"/>anantaraṁ yīśuḥ sāyaṁkālē dvādaśabhiḥ śiṣyaiḥ sārddhaṁ jagāma;</para>
  <para style="p">
    <verse number="18" style="v"/>sarvvēṣu bhōjanāya prōpaviṣṭēṣu sa tānuditavān yuṣmānahaṁ yathārthaṁ vyāharāmi, atra yuṣmākamēkō janō yō mayā saha bhuṁktē māṁ parakērēṣu samarpayiṣyatē|</para>
  <para style="p">
    <verse number="19" style="v"/>tadānīṁ tē duḥkhitāḥ santa ēkaikaśastaṁ praṣṭumārabdhavantaḥ sa kimahaṁ? paścād anya ēkōbhidadhē sa kimahaṁ?</para>
  <para style="p">
    <verse number="20" style="v"/>tataḥ sa pratyavadad ētēṣāṁ dvādaśānāṁ yō janō mayā samaṁ bhōjanāpātrē pāṇiṁ majjayiṣyati sa ēva|</para>
  <para style="p">
    <verse number="21" style="v"/>manujatanayamadhi yādr̥śaṁ likhitamāstē tadanurūpā gatistasya bhaviṣyati, kintu yō janō mānavasutaṁ samarpayiṣyatē hanta tasya janmābhāvē sati bhadramabhaviṣyat|</para>
  <para style="p">
    <verse number="22" style="v"/>aparañca tēṣāṁ bhōjanasamayē yīśuḥ pūpaṁ gr̥hītvēśvaraguṇān anukīrtya bhaṅktvā tēbhyō dattvā babhāṣē, ētad gr̥hītvā bhuñjīdhvam ētanmama vigraharūpaṁ|</para>
  <para style="p">
    <verse number="23" style="v"/>anantaraṁ sa kaṁsaṁ gr̥hītvēśvarasya guṇān kīrttayitvā tēbhyō dadau, tatastē sarvvē papuḥ|</para>
  <para style="p">
    <verse number="24" style="v"/>aparaṁ sa tānavādīd bahūnāṁ nimittaṁ pātitaṁ mama navīnaniyamarūpaṁ śōṇitamētat|</para>
  <para style="p">
    <verse number="25" style="v"/>yuṣmānahaṁ yathārthaṁ vadāmi, īśvarasya rājyē yāvat sadyōjātaṁ drākṣārasaṁ na pāsyāmi,tāvadahaṁ drākṣāphalarasaṁ puna rna pāsyāmi|</para>
  <para style="p">
    <verse number="26" style="v"/>tadanantaraṁ tē gītamēkaṁ saṁgīya bahi rjaitunaṁ śikhariṇaṁ yayuḥ</para>
  <para style="p">
    <verse number="27" style="v"/>atha yīśustānuvāca niśāyāmasyāṁ mayi yuṣmākaṁ sarvvēṣāṁ pratyūhō bhaviṣyati yatō likhitamāstē yathā, mēṣāṇāṁ rakṣakañcāhaṁ prahariṣyāmi vai tataḥ| mēṣāṇāṁ nivahō nūnaṁ pravikīrṇō bhaviṣyati|</para>
  <para style="p">
    <verse number="28" style="v"/>kantu madutthānē jātē yuṣmākamagrē'haṁ gālīlaṁ vrajiṣyāmi|</para>
  <para style="p">
    <verse number="29" style="v"/>tadā pitaraḥ pratibabhāṣē, yadyapi sarvvēṣāṁ pratyūhō bhavati tathāpi mama naiva bhaviṣyati|</para>
  <para style="p">
    <verse number="30" style="v"/>tatō yīśuruktāvān ahaṁ tubhyaṁ tathyaṁ kathayāmi, kṣaṇādāyāmadya kukkuṭasya dvitīyavāraravaṇāt pūrvvaṁ tvaṁ vāratrayaṁ māmapahnōṣyasē|</para>
  <para style="p">
    <verse number="31" style="v"/>kintu sa gāḍhaṁ vyāharad yadyapi tvayā sārddhaṁ mama prāṇō yāti tathāpi kathamapi tvāṁ nāpahnōṣyē; sarvvē'pītarē tathaiva babhāṣirē|</para>
  <para style="p">
    <verse number="32" style="v"/>aparañca tēṣu gētśimānīnāmakaṁ sthāna gatēṣu sa śiṣyān jagāda, yāvadahaṁ prārthayē tāvadatra sthānē yūyaṁ samupaviśata|</para>
  <para style="p">
    <verse number="33" style="v"/>atha sa pitaraṁ yākūbaṁ yōhanañca gr̥hītvā vavrāja; atyantaṁ trāsitō vyākulitaśca tēbhyaḥ kathayāmāsa,</para>
  <para style="p">
    <verse number="34" style="v"/>nidhanakālavat prāṇō mē'tīva daḥkhamēti, yūyaṁ jāgratōtra sthānē tiṣṭhata|</para>
  <para style="p">
    <verse number="35" style="v"/>tataḥ sa kiñciddūraṁ gatvā bhūmāvadhōmukhaḥ patitvā prārthitavānētat, yadi bhavituṁ śakyaṁ tarhi duḥkhasamayōyaṁ mattō dūrībhavatu|</para>
  <para style="p">
    <verse number="36" style="v"/>aparamuditavān hē pita rhē pitaḥ sarvvēṁ tvayā sādhyaṁ, tatō hētōrimaṁ kaṁsaṁ mattō dūrīkuru, kintu tan mamēcchātō na tavēcchātō bhavatu|</para>
  <para style="p">
    <verse number="37" style="v"/>tataḥ paraṁ sa ētya tān nidritān nirīkṣya pitaraṁ prōvāca, śimōn tvaṁ kiṁ nidrāsi? ghaṭikāmēkām api jāgarituṁ na śaknōṣi?</para>
  <para style="p">
    <verse number="38" style="v"/>parīkṣāyāṁ yathā na patatha tadarthaṁ sacētanāḥ santaḥ prārthayadhvaṁ; mana udyuktamiti satyaṁ kintu vapuraśaktikaṁ|</para>
  <para style="p">
    <verse number="39" style="v"/>atha sa punarvrajitvā pūrvvavat prārthayāñcakrē|</para>
  <para style="p">
    <verse number="40" style="v"/>parāvr̥tyāgatya punarapi tān nidritān dadarśa tadā tēṣāṁ lōcanāni nidrayā pūrṇāni, tasmāttasmai kā kathā kathayitavyā ta ētad bōddhuṁ na śēkuḥ|</para>
  <para style="p">
    <verse number="41" style="v"/>tataḥparaṁ tr̥tīyavāraṁ āgatya tēbhyō 'kathayad idānīmapi śayitvā viśrāmyatha? yathēṣṭaṁ jātaṁ, samayaścōpasthitaḥ paśyata mānavatanayaḥ pāpilōkānāṁ pāṇiṣu samarpyatē|</para>
  <para style="p">
    <verse number="42" style="v"/>uttiṣṭhata, vayaṁ vrajāmō yō janō māṁ parapāṇiṣu samarpayiṣyatē paśyata sa samīpamāyātaḥ|</para>
  <para style="p">
    <verse number="43" style="v"/>imāṁ kathāṁ kathayati sa, ētarhidvādaśānāmēkō yihūdā nāmā śiṣyaḥ pradhānayājakānām upādhyāyānāṁ prācīnalōkānāñca sannidhēḥ khaṅgalaguḍadhāriṇō bahulōkān gr̥hītvā tasya samīpa upasthitavān|</para>
  <para style="p">
    <verse number="44" style="v"/>aparañcāsau parapāṇiṣu samarpayitā pūrvvamiti saṅkētaṁ kr̥tavān yamahaṁ cumbiṣyāmi sa ēvāsau tamēva dhr̥tvā sāvadhānaṁ nayata|</para>
  <para style="p">
    <verse number="45" style="v"/>atō hētōḥ sa āgatyaiva yōśōḥ savidhaṁ gatvā hē gurō hē gurō, ityuktvā taṁ cucumba|</para>
  <para style="p">
    <verse number="46" style="v"/>tadā tē tadupari pāṇīnarpayitvā taṁ dadhnuḥ|</para>
  <para style="p">
    <verse number="47" style="v"/>tatastasya pārśvasthānāṁ lōkānāmēkaḥ khaṅgaṁ niṣkōṣayan mahāyājakasya dāsamēkaṁ prahr̥tya tasya karṇaṁ cicchēda|</para>
  <para style="p">
    <verse number="48" style="v"/>paścād yīśustān vyājahāra khaṅgān laguḍāṁśca gr̥hītvā māṁ kiṁ cauraṁ dharttāṁ samāyātāḥ?</para>
  <para style="p">
    <verse number="49" style="v"/>madhyēmandiraṁ samupadiśan pratyahaṁ yuṣmābhiḥ saha sthitavānatahaṁ, tasmin kālē yūyaṁ māṁ nādīdharata, kintvanēna śāstrīyaṁ vacanaṁ sēdhanīyaṁ|</para>
  <para style="p">
    <verse number="50" style="v"/>tadā sarvvē śiṣyāstaṁ parityajya palāyāñcakrirē|</para>
  <para style="p">
    <verse number="51" style="v"/>athaikō yuvā mānavō nagnakāyē vastramēkaṁ nidhāya tasya paścād vrajan yuvalōkai rdhr̥tō</para>
  <para style="p">
    <verse number="52" style="v"/>vastraṁ vihāya nagnaḥ palāyāñcakrē|</para>
  <para style="p">
    <verse number="53" style="v"/>aparañca yasmin sthānē pradhānayājakā upādhyāyāḥ prācīnalōkāśca mahāyājakēna saha sadasi sthitāstasmin sthānē mahāyājakasya samīpaṁ yīśuṁ ninyuḥ|</para>
  <para style="p">
    <verse number="54" style="v"/>pitarō dūrē tatpaścād itvā mahāyājakasyāṭṭālikāṁ praviśya kiṅkaraiḥ sahōpaviśya vahnitāpaṁ jagrāha|</para>
  <para style="p">
    <verse number="55" style="v"/>tadānīṁ pradhānayājakā mantriṇaśca yīśuṁ ghātayituṁ tatprātikūlyēna sākṣiṇō mr̥gayāñcakrirē, kintu na prāptāḥ|</para>
  <para style="p">
    <verse number="56" style="v"/>anēkaistadviruddhaṁ mr̥ṣāsākṣyē dattēpi tēṣāṁ vākyāni na samagacchanta|</para>
  <para style="p">
    <verse number="57" style="v"/>sarvvaśēṣē kiyanta utthāya tasya prātikūlyēna mr̥ṣāsākṣyaṁ dattvā kathayāmāsuḥ,</para>
  <para style="p">
    <verse number="58" style="v"/>idaṁ karakr̥tamandiraṁ vināśya dinatrayamadhyē punaraparam akarakr̥taṁ mandiraṁ nirmmāsyāmi, iti vākyam asya mukhāt śrutamasmābhiriti|</para>
  <para style="p">
    <verse number="59" style="v"/>kintu tatrāpi tēṣāṁ sākṣyakathā na saṅgātāḥ|</para>
  <para style="p">
    <verse number="60" style="v"/>atha mahāyājakō madhyēsabham utthāya yīśuṁ vyājahāra, ētē janāstvayi yat sākṣyamaduḥ tvamētasya kimapyuttaraṁ kiṁ na dāsyasi?</para>
  <para style="p">
    <verse number="61" style="v"/>kintu sa kimapyuttaraṁ na datvā maunībhūya tasyau; tatō mahāyājakaḥ punarapi taṁ pr̥ṣṭāvān tvaṁ saccidānandasya tanayō 'bhiṣiktastratā?</para>
  <para style="p">
    <verse number="62" style="v"/>tadā yīśustaṁ prōvāca bhavāmyaham yūyañca sarvvaśaktimatō dakṣīṇapārśvē samupaviśantaṁ mēgha māruhya samāyāntañca manuṣyaputraṁ sandrakṣyatha|</para>
  <para style="p">
    <verse number="63" style="v"/>tadā mahāyājakaḥ svaṁ vamanaṁ chitvā vyāvaharat</para>
  <para style="p">
    <verse number="64" style="v"/>kimasmākaṁ sākṣibhiḥ prayōjanam? īśvaranindāvākyaṁ yuṣmābhiraśrāvi kiṁ vicārayatha? tadānīṁ sarvvē jagadurayaṁ nidhanadaṇḍamarhati|</para>
  <para style="p">
    <verse number="65" style="v"/>tataḥ kaścit kaścit tadvapuṣi niṣṭhīvaṁ nicikṣēpa tathā tanmukhamācchādya capēṭēna hatvā gaditavān gaṇayitvā vada, anucarāśca capēṭaistamājaghnuḥ</para>
  <para style="p">
    <verse number="66" style="v"/>tataḥ paraṁ pitarē'ṭṭālikādhaḥkōṣṭhē tiṣṭhati mahāyājakasyaikā dāsī samētya</para>
  <para style="p">
    <verse number="67" style="v"/>taṁ vihnitāpaṁ gr̥hlantaṁ vilōkya taṁ sunirīkṣya babhāṣē tvamapi nāsaratīyayīśōḥ saṅginām ēkō jana āsīḥ|</para>
  <para style="p">
    <verse number="68" style="v"/>kintu sōpahnutya jagāda tamahaṁ na vadmi tvaṁ yat kathayami tadapyahaṁ na buddhyē| tadānīṁ pitarē catvaraṁ gatavati kuेkkuṭō rurāva|</para>
  <para style="p">
    <verse number="69" style="v"/>athānyā dāsī pitaraṁ dr̥ṣṭvā samīpasthān janān jagāda ayaṁ tēṣāmēkō janaḥ|</para>
  <para style="p">
    <verse number="70" style="v"/>tataḥ sa dvitīyavāram apahnutavān paścāt tatrasthā lōkāḥ pitaraṁ prōcustvamavaśyaṁ tēṣāmēkō janaḥ yatastvaṁ gālīlīyō nara iti tavōccāraṇaṁ prakāśayati|</para>
  <para style="p">
    <verse number="71" style="v"/>tadā sa śapathābhiśāpau kr̥tvā prōvāca yūyaṁ kathāṁ kathayatha taṁ naraṁ na jānē'haṁ|</para>
  <para style="p">
    <verse number="72" style="v"/>tadānīṁ dvitīyavāraṁ kukkuṭō 'rāvīt| kukkuṭasya dvitīyaravāt pūrvvaṁ tvaṁ māṁ vāratrayam apahnōṣyasi, iti yadvākyaṁ yīśunā samuditaṁ tat tadā saṁsmr̥tya pitarō rōditum ārabhata|</para>
  <chapter number="15" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>atha prabhātē sati pradhānayājakāḥ prāñca upādhyāyāḥ sarvvē mantriṇaśca sabhāṁ kr̥tvā yīśuृṁ bandhayitva pīlātākhyasya dēśādhipatēḥ savidhaṁ nītvā samarpayāmāsuḥ|</para>
  <para style="p">
    <verse number="2" style="v"/>tadā pīlātastaṁ pr̥ṣṭavān tvaṁ kiṁ yihūdīyalōkānāṁ rājā? tataḥ sa pratyuktavān satyaṁ vadasi|</para>
  <para style="p">
    <verse number="3" style="v"/>aparaṁ pradhānayājakāstasya bahuṣu vākyēṣu dōṣamārōpayāñcakruḥ kintu sa kimapi na pratyuvāca|</para>
  <para style="p">
    <verse number="4" style="v"/>tadānīṁ pīlātastaṁ punaḥ papraccha tvaṁ kiṁ nōttarayasi? paśyaitē tvadviruddhaṁ katiṣu sādhyēṣu sākṣaṁ dadati|</para>
  <para style="p">
    <verse number="5" style="v"/>kantu yīśustadāpi nōttaraṁ dadau tataḥ pīlāta āścaryyaṁ jagāma|</para>
  <para style="p">
    <verse number="6" style="v"/>aparañca kārābaddhē kastiṁścit janē tanmahōtsavakālē lōkai ryācitē dēśādhipatistaṁ mōcayati|</para>
  <para style="p">
    <verse number="7" style="v"/>yē ca pūrvvamupaplavamakārṣurupaplavē vadhamapi kr̥tavantastēṣāṁ madhyē tadānōṁ barabbānāmaka ēkō baddha āsīt|</para>
  <para style="p">
    <verse number="8" style="v"/>atō hētōḥ pūrvvāparīyāṁ rītikathāṁ kathayitvā lōkā uccairuvantaḥ pīlātasya samakṣaṁ nivēdayāmāsuḥ|</para>
  <para style="p">
    <verse number="9" style="v"/>tadā pīlātastānācakhyau tarhi kiṁ yihūdīyānāṁ rājānaṁ mōcayiṣyāmi? yuṣmābhiḥ kimiṣyatē?</para>
  <para style="p">
    <verse number="10" style="v"/>yataḥ pradhānayājakā īrṣyāta ēva yīśuṁ samārpayanniti sa vivēda|</para>
  <para style="p">
    <verse number="11" style="v"/>kintu yathā barabbāṁ mōcayati tathā prārthayituṁ pradhānayājakā lōkān pravarttayāmāsuḥ|</para>
  <para style="p">
    <verse number="12" style="v"/>atha pīlātaḥ punaḥ pr̥ṣṭavān tarhi yaṁ yihūdīyānāṁ rājēti vadatha tasya kiṁ kariṣyāmi yuṣmābhiḥ kimiṣyatē?</para>
  <para style="p">
    <verse number="13" style="v"/>tadā tē punarapi prōccaiḥ prōcustaṁ kruśē vēdhaya|</para>
  <para style="p">
    <verse number="14" style="v"/>tasmāt pīlātaḥ kathitavān kutaḥ? sa kiṁ kukarmma kr̥tavān? kintu tē punaśca ruvantō vyājahrustaṁ kruśē vēdhaya|</para>
  <para style="p">
    <verse number="15" style="v"/>tadā pīlātaḥ sarvvāllōkān tōṣayitumicchan barabbāṁ mōcayitvā yīśuṁ kaśābhiḥ prahr̥tya kruśē vēddhuṁ taṁ samarpayāmbabhūva|</para>
  <para style="p">
    <verse number="16" style="v"/>anantaraṁ sainyagaṇō'ṭṭālikām arthād adhipatē rgr̥haṁ yīśuṁ nītvā sēnānivahaṁ samāhuyat|</para>
  <para style="p">
    <verse number="17" style="v"/>paścāt tē taṁ dhūmalavarṇavastraṁ paridhāpya kaṇṭakamukuṭaṁ racayitvā śirasi samārōpya</para>
  <para style="p">
    <verse number="18" style="v"/>hē yihūdīyānāṁ rājan namaskāra ityuktvā taṁ namaskarttāmārēbhirē|</para>
  <para style="p">
    <verse number="19" style="v"/>tasyōttamāṅgē vētrāghātaṁ cakrustadgātrē niṣṭhīvañca nicikṣipuḥ, tathā tasya sammukhē jānupātaṁ praṇōmuḥ</para>
  <para style="p">
    <verse number="20" style="v"/>itthamupahasya dhūmravarṇavastram uttāryya tasya vastraṁ taṁ paryyadhāpayan kruśē vēddhuṁ bahirninyuśca|</para>
  <para style="p">
    <verse number="21" style="v"/>tataḥ paraṁ sēkandarasya ruphasya ca pitā śimōnnāmā kurīṇīyalōka ēkaḥ kutaścid grāmādētya pathi yāti taṁ tē yīśōḥ kruśaṁ vōḍhuṁ balād dadhnuḥ|</para>
  <para style="p">
    <verse number="22" style="v"/>atha gulgaltā arthāt śiraḥkapālanāmakaṁ sthānaṁ yīśumānīya</para>
  <para style="p">
    <verse number="23" style="v"/>tē gandharasamiśritaṁ drākṣārasaṁ pātuṁ tasmai daduḥ kintu sa na jagrāha|</para>
  <para style="p">
    <verse number="24" style="v"/>tasmin kruśē viddhē sati tēṣāmēkaikaśaḥ kiṁ prāpsyatīti nirṇayāya</para>
  <para style="p">
    <verse number="25" style="v"/>tasya paridhēyānāṁ vibhāgārthaṁ guṭikāpātaṁ cakruḥ|</para>
  <para style="p">
    <verse number="26" style="v"/>aparam ēṣa yihūdīyānāṁ rājēti likhitaṁ dōṣapatraṁ tasya śiraūrdvvam ārōpayāñcakruḥ|</para>
  <para style="p">
    <verse number="27" style="v"/>tasya vāmadakṣiṇayō rdvau caurau kruśayō rvividhātē|</para>
  <para style="p">
    <verse number="28" style="v"/>tēnaiva "aparādhijanaiḥ sārddhaṁ sa gaṇitō bhaviṣyati," iti śāstrōktaṁ vacanaṁ siddhamabhūta|</para>
  <para style="p">
    <verse number="29" style="v"/>anantaraṁ mārgē yē yē lōkā gamanāgamanē cakrustē sarvva ēva śirāṁsyāndōlya nindantō jagaduḥ, rē mandiranāśaka rē dinatrayamadhyē tannirmmāyaka,</para>
  <para style="p">
    <verse number="30" style="v"/>adhunātmānam avitvā kruśādavarōha|</para>
  <para style="p">
    <verse number="31" style="v"/>kiñca pradhānayājakā adhyāpakāśca tadvat tiraskr̥tya parasparaṁ cacakṣirē ēṣa parānāvat kintu svamavituṁ na śaknōti|</para>
  <para style="p">
    <verse number="32" style="v"/>yadīsrāyēlō rājābhiṣiktastrātā bhavati tarhyadhunaina kruśādavarōhatu vayaṁ tad dr̥ṣṭvā viśvasiṣyāmaḥ; kiñca yau lōkau tēna sārddhaṁ kruśē 'vidhyētāṁ tāvapi taṁ nirbhartsayāmāsatuḥ|</para>
  <para style="p">
    <verse number="33" style="v"/>atha dvitīyayāmāt tr̥tīyayāmaṁ yāvat sarvvō dēśaḥ sāndhakārōbhūt|</para>
  <para style="p">
    <verse number="34" style="v"/>tatastr̥tīyapraharē yīśuruccairavadat ēlī ēlī lāmā śivaktanī arthād "hē madīśa madīśa tvaṁ paryyatyākṣīḥ kutō hi māṁ?"</para>
  <para style="p">
    <verse number="35" style="v"/>tadā samīpasthalōkānāṁ kēcit tadvākyaṁ niśamyācakhyuḥ paśyaiṣa ēliyam āhūyati|</para>
  <para style="p">
    <verse number="36" style="v"/>tata ēkō janō dhāvitvāgatya spañjē 'mlarasaṁ pūrayitvā taṁ naḍāgrē nidhāya pātuṁ tasmai dattvāvadat tiṣṭha ēliya ēnamavarōhayitum ēti na vēti paśyāmi|</para>
  <para style="p">
    <verse number="37" style="v"/>atha yīśuruccaiḥ samāhūya prāṇān jahau|</para>
  <para style="p">
    <verse number="38" style="v"/>tadā mandirasya javanikōrdvvādadhaḥryyantā vidīrṇā dvikhaṇḍābhūt|</para>
  <para style="p">
    <verse number="39" style="v"/>kiñca itthamuccairāhūya prāṇān tyajantaṁ taṁ dr̥ṣdvā tadrakṣaṇāya niyuktō yaḥ sēnāpatirāsīt sōvadat narōyam īśvaraputra iti satyam|</para>
  <para style="p">
    <verse number="40" style="v"/>tadānīṁ magdalīnī marisam kaniṣṭhayākūbō yōsēśca mātānyamariyam śālōmī ca yāḥ striyō</para>
  <para style="p">
    <verse number="41" style="v"/>gālīlpradēśē yīśuṁ sēvitvā tadanugāminyō jātā imāstadanyāśca yā anēkā nāryō yīśunā sārddhaṁ yirūśālamamāyātāstāśca dūrāt tāni dadr̥śuḥ|</para>
  <para style="p">
    <verse number="42" style="v"/>athāsādanadinasyārthād viśrāmavārāt pūrvvadinasya sāyaṁkāla āgata</para>
  <para style="p">
    <verse number="43" style="v"/>īśvararājyāpēkṣyarimathīyayūṣaphanāmā mānyamantrī samētya pīlātasavidhaṁ nirbhayō gatvā yīśōrdēhaṁ yayācē|</para>
  <para style="p">
    <verse number="44" style="v"/>kintu sa idānīṁ mr̥taḥ pīlāta ityasambhavaṁ matvā śatasēnāpatimāhūya sa kadā mr̥ta iti papraccha|</para>
  <para style="p">
    <verse number="45" style="v"/>śatasēmanāpatimukhāt tajjñātvā yūṣaphē yīśōrdēhaṁ dadau|</para>
  <para style="p">
    <verse number="46" style="v"/>paścāt sa sūkṣmaṁ vāsaḥ krītvā yīśōḥ kāyamavarōhya tēna vāsasā vēṣṭāyitvā girau khātaśmaśānē sthāpitavān pāṣāṇaṁ lōṭhayitvā dvāri nidadhē|</para>
  <para style="p">
    <verse number="47" style="v"/>kintu yatra sōsthāpyata tata magdalīnī mariyam yōsimātr̥mariyam ca dadr̥śatr̥ḥ|</para>
  <chapter number="16" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>atha viśrāmavārē gatē magdalīnī mariyam yākūbamātā mariyam śālōmī cēmāstaṁ marddayituṁ sugandhidravyāṇi krītvā</para>
  <para style="p">
    <verse number="2" style="v"/>saptāhaprathamadinē'tipratyūṣē sūryyōdayakālē śmaśānamupagatāḥ|</para>
  <para style="p">
    <verse number="3" style="v"/>kintu śmaśānadvārapāṣāṇō'tibr̥han taṁ kō'pasārayiṣyatīti tāḥ parasparaṁ gadanti!</para>
  <para style="p">
    <verse number="4" style="v"/>ētarhi nirīkṣya pāṣāṇō dvārō 'pasārita iti dadr̥śuḥ|</para>
  <para style="p">
    <verse number="5" style="v"/>paścāttāḥ śmaśānaṁ praviśya śuklavarṇadīrghaparicchadāvr̥tamēkaṁ yuvānaṁ śmaśānadakṣiṇapārśva upaviṣṭaṁ dr̥ṣṭvā camaccakruḥ|</para>
  <para style="p">
    <verse number="6" style="v"/>sō'vadat, mābhaiṣṭa yūyaṁ kruśē hataṁ nāsaratīyayīśuṁ gavēṣayatha sōtra nāsti śmaśānādudasthāt; tai ryatra sa sthāpitaḥ sthānaṁ tadidaṁ paśyata|</para>
  <para style="p">
    <verse number="7" style="v"/>kintu tēna yathōktaṁ tathā yuṣmākamagrē gālīlaṁ yāsyatē tatra sa yuṣmān sākṣāt kariṣyatē yūyaṁ gatvā tasya śiṣyēbhyaḥ pitarāya ca vārttāmimāṁ kathayata|</para>
  <para style="p">
    <verse number="8" style="v"/>tāḥ kampitā vistitāśca tūrṇaṁ śmaśānād bahirgatvā palāyanta bhayāt kamapi kimapi nāvadaṁśca|</para>
  <para style="p">
    <verse number="9" style="v"/>aparaṁ yīśuḥ saptāhaprathamadinē pratyūṣē śmaśānādutthāya yasyāḥ saptabhūtāstyājitāstasyai magdalīnīmariyamē prathamaṁ darśanaṁ dadau|</para>
  <para style="p">
    <verse number="10" style="v"/>tataḥ sā gatvā śōkarōdanakr̥dbhyō'nugatalōkēbhyastāṁ vārttāṁ kathayāmāsa|</para>
  <para style="p">
    <verse number="11" style="v"/>kintu yīśuḥ punarjīvan tasyai darśanaṁ dattavāniti śrutvā tē na pratyayan|</para>
  <para style="p">
    <verse number="12" style="v"/>paścāt tēṣāṁ dvāyō rgrāmayānakālē yīśuranyavēśaṁ dhr̥tvā tābhyāṁ darśana dadau!</para>
  <para style="p">
    <verse number="13" style="v"/>tāvapi gatvānyaśiṣyēbhyastāṁ kathāṁ kathayāñcakratuḥ kintu tayōḥ kathāmapi tē na pratyayan|</para>
  <para style="p">
    <verse number="14" style="v"/>śēṣata ēkādaśaśiṣyēṣu bhōjanōpaviṣṭēṣu yīśustēbhyō darśanaṁ dadau tathōtthānāt paraṁ taddarśanaprāptalōkānāṁ kathāyāmaviśvāsakaraṇāt tēṣāmaviśvāsamanaḥkāṭhinyābhyāṁ hētubhyāṁ sa tāṁstarjitavān|</para>
  <para style="p">
    <verse number="15" style="v"/>atha tānācakhyau yūyaṁ sarvvajagad gatvā sarvvajanān prati susaṁvādaṁ pracārayata|</para>
  <para style="p">
    <verse number="16" style="v"/>tatra yaḥ kaścid viśvasya majjitō bhavēt sa paritrāsyatē kintu yō na viśvasiṣyati sa daṇḍayiṣyatē|</para>
  <para style="p">
    <verse number="17" style="v"/>kiñca yē pratyēṣyanti tairīdr̥g āścaryyaṁ karmma prakāśayiṣyatē tē mannāmnā bhūtān tyājayiṣyanti bhāṣā anyāśca vadiṣyanti|</para>
  <para style="p">
    <verse number="18" style="v"/>aparaṁ taiḥ sarpēṣu dhr̥tēṣu prāṇanāśakavastuni pītē ca tēṣāṁ kāpi kṣati rna bhaviṣyati; rōgiṇāṁ gātrēṣu karārpitē tē'rōgā bhaviṣyanti ca|</para>
  <para style="p">
    <verse number="19" style="v"/>atha prabhustānityādiśya svargaṁ nītaḥ san paramēśvarasya dakṣiṇa upavivēśa|</para>
  <para style="p">
    <verse number="20" style="v"/>tatastē prasthāya sarvvatra susaṁvādīyakathāṁ pracārayitumārēbhirē prabhustu tēṣāṁ sahāyaḥ san prakāśitāścaryyakriyābhistāṁ kathāṁ pramāṇavatīṁ cakāra| iti|</para>
</usx>
