  <para style="h">Matthew</para>
  <para style="toc1">mathilikhitaḥ susaṁvādaḥ</para>
  <para style="toc2">mathiḥ</para>
  <para style="toc3">mathiḥ</para>
  <para style="mt1">mathilikhitaḥ susaṁvādaḥ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ibrāhīmaḥ santānō dāyūd tasya santānō yīśukhrīṣṭastasya pūrvvapuruṣavaṁśaśrēṇī|</para>
  <para style="p">
    <verse number="2" style="v"/>ibrāhīmaḥ putra ishāk tasya putrō yākūb tasya putrō yihūdāstasya bhrātaraśca|</para>
  <para style="p">
    <verse number="3" style="v"/>tasmād yihūdātastāmarō garbhē pērassērahau jajñātē, tasya pērasaḥ putrō hiṣrōṇ tasya putrō 'rām|</para>
  <para style="p">
    <verse number="4" style="v"/>tasya putrō 'mmīnādab tasya putrō nahaśōn tasya putraḥ salmōn|</para>
  <para style="p">
    <verse number="5" style="v"/>tasmād rāhabō garbhē bōyam jajñē, tasmād rūtō garbhē ōbēd jajñē, tasya putrō yiśayaḥ|</para>
  <para style="p">
    <verse number="6" style="v"/>tasya putrō dāyūd rājaḥ tasmād mr̥tōriyasya jāyāyāṁ sulēmān jajñē|</para>
  <para style="p">
    <verse number="7" style="v"/>tasya putrō rihabiyām, tasya putrō'biyaḥ, tasya putra āsā:|</para>
  <para style="p">
    <verse number="8" style="v"/>tasya sutō yihōśāphaṭ tasya sutō yihōrāma tasya suta uṣiyaḥ|</para>
  <para style="p">
    <verse number="9" style="v"/>tasya sutō yōtham tasya suta āham tasya sutō hiṣkiyaḥ|</para>
  <para style="p">
    <verse number="10" style="v"/>tasya sutō minaśiḥ, tasya suta āmōn tasya sutō yōśiyaḥ|</para>
  <para style="p">
    <verse number="11" style="v"/>bābilnagarē pravasanāt pūrvvaṁ sa yōśiyō yikhaniyaṁ tasya bhrātr̥ṁśca janayāmāsa|</para>
  <para style="p">
    <verse number="12" style="v"/>tatō bābili pravasanakālē yikhaniyaḥ śaltīyēlaṁ janayāmāsa, tasya sutaḥ sirubbāvil|</para>
  <para style="p">
    <verse number="13" style="v"/>tasya sutō 'bōhud tasya suta ilīyākīm tasya sutō'sōr|</para>
  <para style="p">
    <verse number="14" style="v"/>asōraḥ sutaḥ sādōk tasya suta ākhīm tasya suta ilīhūd|</para>
  <para style="p">
    <verse number="15" style="v"/>tasya suta iliyāsar tasya sutō mattan|</para>
  <para style="p">
    <verse number="16" style="v"/>tasya sutō yākūb tasya sutō yūṣaph tasya jāyā mariyam; tasya garbhē yīśurajani, tamēva khrīṣṭam (arthād abhiṣiktaṁ) vadanti|</para>
  <para style="p">
    <verse number="17" style="v"/>ittham ibrāhīmō dāyūdaṁ yāvat sākalyēna caturdaśapuruṣāḥ; ā dāyūdaḥ kālād bābili pravasanakālaṁ yāvat caturdaśapuruṣā bhavanti| bābili pravāsanakālāt khrīṣṭasya kālaṁ yāvat caturdaśapuruṣā bhavanti|</para>
  <para style="p">
    <verse number="18" style="v"/>yīśukhrīṣṭasya janma kaththatē| mariyam nāmikā kanyā yūṣaphē vāgdattāsīt, tadā tayōḥ saṅgamāt prāk sā kanyā  pavitrēṇātmanā garbhavatī babhūva|</para>
  <para style="p">
    <verse number="19" style="v"/>tatra tasyāḥ pati ryūṣaph saujanyāt tasyāḥ kalaṅgaṁ prakāśayitum anicchan gōpanēnē tāṁ pārityaktuṁ manaścakrē|</para>
  <para style="p">
    <verse number="20" style="v"/>sa tathaiva bhāvayati, tadānīṁ paramēśvarasya dūtaḥ svapnē taṁ darśanaṁ dattvā vyājahāra, hē dāyūdaḥ santāna yūṣaph tvaṁ nijāṁ jāyāṁ mariyamam ādātuṁ mā bhaiṣīḥ|</para>
  <para style="p">
    <verse number="21" style="v"/>yatastasyā garbhaḥ pavitrādātmanō'bhavat, sā ca putraṁ prasaviṣyatē, tadā tvaṁ tasya nāma yīśum (arthāt trātāraṁ) karīṣyasē, yasmāt sa nijamanujān tēṣāṁ kaluṣēbhya uddhariṣyati|</para>
  <para style="p">
    <verse number="22" style="v"/>itthaṁ sati, paśya garbhavatī kanyā tanayaṁ prasaviṣyatē| immānūyēl tadīyañca nāmadhēyaṁ bhaviṣyati|| immānūyēl asmākaṁ saṅgīśvara̮ityarthaḥ|</para>
  <para style="p">
    <verse number="23" style="v"/>iti yad vacanaṁ purvvaṁ bhaviṣyadvaktrā īśvaraḥ kathāyāmāsa, tat tadānīṁ siddhamabhavat|</para>
  <para style="p">
    <verse number="24" style="v"/>anantaraṁ yūṣaph nidrātō jāgarita utthāya paramēśvarīyadūtasya nidēśānusārēṇa nijāṁ jāyāṁ jagrāha,</para>
  <para style="p">
    <verse number="25" style="v"/>kintu yāvat sā nijaṁ prathamasutaṁ a suṣuvē, tāvat tāṁ nōpāgacchat, tataḥ sutasya nāma yīśuṁ cakrē|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ hērōd saṁjñakē rājñi rājyaṁ śāsati yihūdīyadēśasya baitlēhami nagarē yīśau jātavati ca, katipayā jyōtirvvudaḥ pūrvvasyā diśō yirūśālamnagaraṁ samētya kathayamāsuḥ,</para>
  <para style="p">
    <verse number="2" style="v"/>yō yihūdīyānāṁ rājā jātavān, sa kutrāstē? vayaṁ pūrvvasyāṁ diśi tiṣṭhantastadīyāṁ tārakām apaśyāma tasmāt taṁ praṇantum aाgamāma|</para>
  <para style="p">
    <verse number="3" style="v"/>tadā hērōd rājā kathāmētāṁ niśamya yirūśālamnagarasthitaiḥ sarvvamānavaiḥ sārddham udvijya</para>
  <para style="p">
    <verse number="4" style="v"/>sarvvān pradhānayājakān adhyāpakāṁśca samāhūyānīya papraccha, khrīṣṭaḥ kutra janiṣyatē?</para>
  <para style="p">
    <verse number="5" style="v"/>tadā tē kathayāmāsuḥ, yihūdīyadēśasya baitlēhami nagarē, yatō bhaviṣyadvādinā itthaṁ likhitamāstē,</para>
  <para style="p">
    <verse number="6" style="v"/>sarvvābhyō rājadhānībhyō yihūdīyasya nīvr̥taḥ| hē yīhūdīyadēśasyē baitlēham tvaṁ na cāvarā|isrāyēlīyalōkān mē yatō yaḥ pālayiṣyati| tādr̥gēkō mahārājastvanmadhya udbhaviṣyatī||</para>
  <para style="p">
    <verse number="7" style="v"/>tadānīṁ hērōd rājā tān jyōtirvvidō gōpanam āhūya sā tārakā kadā dr̥ṣṭābhavat , tad viniścayāmāsa|</para>
  <para style="p">
    <verse number="8" style="v"/>aparaṁ tān baitlēhamaṁ prahītya gaditavān, yūyaṁ yāta, yatnāt taṁ śiśum anviṣya taduddēśē prāptē mahyaṁ vārttāṁ dāsyatha, tatō mayāpi gatvā sa praṇaṁsyatē|</para>
  <para style="p">
    <verse number="9" style="v"/>tadānīṁ rājña ētādr̥śīm ājñāṁ prāpya tē pratasthirē, tataḥ pūrvvarsyāṁ diśi sthitaistai ryā tārakā dr̥ṣṭā sā tārakā tēṣāmagrē gatvā yatra sthānē śiśūrāstē, tasya sthānasyōpari sthagitā tasyau|</para>
  <para style="p">
    <verse number="10" style="v"/>tad dr̥ṣṭvā tē mahānanditā babhūvuḥ,</para>
  <para style="p">
    <verse number="11" style="v"/>tatō gēhamadhya praviśya tasya mātrā mariyamā sāddhaṁ taṁ śiśuṁ nirīkṣaya daṇḍavad bhūtvā praṇēmuḥ, aparaṁ svēṣāṁ ghanasampattiṁ mōcayitvā suvarṇaṁ kunduruṁ gandharamañca tasmai darśanīyaṁ dattavantaḥ|</para>
  <para style="p">
    <verse number="12" style="v"/>paścād hērōd rājasya samīpaṁ punarapi gantuṁ svapna īśvarēṇa niṣiddhāḥ santō 'nyēna pathā tē nijadēśaṁ prati pratasthirē|</para>
  <para style="p">
    <verse number="13" style="v"/>anantaraṁ tēṣu gatavatmu paramēśvarasya dūtō yūṣaphē svapnē darśanaṁ datvā jagāda, tvam utthāya śiśuṁ tanmātarañca gr̥hītvā misardēśaṁ palāyasva, aparaṁ yāvadahaṁ tubhyaṁ vārttāṁ na kathayiṣyāmi, tāvat tatraiva nivasa, yatō rājā hērōd śiśuṁ nāśayituṁ mr̥gayiṣyatē|</para>
  <para style="p">
    <verse number="14" style="v"/>tadānīṁ yūṣaph utthāya rajanyāṁ śiśuṁ tanmātarañca gr̥hītvā misardēśaṁ prati pratasthē,</para>
  <para style="p">
    <verse number="15" style="v"/>gatvā ca hērōdō nr̥patē rmaraṇaparyyantaṁ tatra dēśē nyuvāsa, tēna misardēśādahaṁ putraṁ svakīyaṁ samupāhūyam| yadētadvacanam īśvarēṇa bhaviṣyadvādinā kathitaṁ tat saphalamabhūt|</para>
  <para style="p">
    <verse number="16" style="v"/>anantaraṁ hērōd jyōtirvidbhirātmānaṁ pravañcitaṁ vijñāya bhr̥śaṁ cukōpa; aparaṁ jyōtirvvidbhyastēna viniścitaṁ yad dinaṁ taddinād gaṇayitvā dvitīyavatsaraṁ praviṣṭā yāvantō bālakā asmin baitlēhamnagarē tatsīmamadhyē cāsan, lōkān prahitya tān sarvvān ghātayāmāsa|</para>
  <para style="p">
    <verse number="17" style="v"/>ataḥ anēkasya vilāpasya nināda: krandanasya ca| śōkēna kr̥taśabdaśca rāmāyāṁ saṁniśamyatē| svabālagaṇahētōrvai rāhēl nārī tu rōdinī| na manyatē prabōdhantu yatastē naiva manti hi||</para>
  <para style="p">
    <verse number="18" style="v"/>yadētad vacanaṁ yirīmiyanāmakabhaviṣyadvādinā kathitaṁ tat tadānīṁ saphalam abhūt|</para>
  <para style="p">
    <verse number="19" style="v"/>tadanantaraṁ hērēdi rājani mr̥tē paramēśvarasya dūtō misardēśē svapnē darśanaṁ dattvā yūṣaphē kathitavān</para>
  <para style="p">
    <verse number="20" style="v"/>tvam utthāya śiśuṁ tanmātarañca gr̥hītvā punarapīsrāyēlō dēśaṁ yāhī, yē janāḥ śiśuṁ nāśayitum amr̥gayanta, tē mr̥tavantaḥ|</para>
  <para style="p">
    <verse number="21" style="v"/>tadānīṁ sa utthāya śiśuṁ tanmātarañca gr̥hlan isrāyēldēśam ājagāma|</para>
  <para style="p">
    <verse number="22" style="v"/>kintu yihūdīyadēśē arkhilāyanāma rājakumārō nijapitu rhērōdaḥ padaṁ prāpya rājatvaṁ karōtīti niśamya tat sthānaṁ yātuṁ śaṅkitavān, paścāt svapna īśvarāt prabōdhaṁ prāpya gālīldēśasya pradēśaikaṁ prasthāya nāsarannāma nagaraṁ gatvā tatra nyuṣitavān,</para>
  <para style="p">
    <verse number="23" style="v"/>tēna taṁ nāsaratīyaṁ kathayiṣyanti, yadētadvākyaṁ bhaviṣyadvādibhirukttaṁ tat saphalamabhavat|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tadānōṁ yōhnnāmā majjayitā yihūdīyadēśasya prāntaram upasthāya pracārayan kathayāmāsa,</para>
  <para style="p">
    <verse number="2" style="v"/>manāṁsi parāvarttayata, svargīyarājatvaṁ samīpamāgatam|</para>
  <para style="p">
    <verse number="3" style="v"/>paramēśasya panthānaṁ pariṣkuruta sarvvataḥ| tasya rājapathāṁścaiva samīkuruta sarvvathā| ityētat prāntarē vākyaṁ vadataḥ kasyacid ravaḥ||</para>
  <para style="p">
    <verse number="4" style="v"/>ētadvacanaṁ yiśayiyabhaviṣyadvādinā yōhanamuddiśya bhāṣitam| yōhanō vasanaṁ mahāṅgarōmajaṁ tasya kaṭau carmmakaṭibandhanaṁ; sa ca śūkakīṭān madhu ca bhuktavān|</para>
  <para style="p">
    <verse number="5" style="v"/>tadānīṁ yirūśālamnagaranivāsinaḥ sarvvē yihūdidēśīyā yarddantaṭinyā ubhayataṭasthāśca mānavā bahirāgatya tasya samīpē</para>
  <para style="p">
    <verse number="6" style="v"/>svīyaṁ svīyaṁ duritam aṅgīkr̥tya tasyāṁ yarddani tēna majjitā babhūvuḥ|</para>
  <para style="p">
    <verse number="7" style="v"/>aparaṁ bahūn phirūśinaḥ sidūkinaśca manujān maṁktuṁ svasamīpam āgacchtō vilōkya sa tān abhidadhau, rē rē bhujagavaṁśā āgāmīnaḥ kōpāt palāyituṁ yuṣmān kaścētitavān?</para>
  <para style="p">
    <verse number="8" style="v"/>manaḥparāvarttanasya samucitaṁ phalaṁ phalata|</para>
  <para style="p">
    <verse number="9" style="v"/>kintvasmākaṁ tāta ibrāhīm astīti svēṣu manaḥsu cīntayantō mā vyāharata| yatō yuṣmān ahaṁ vadāmi, īśvara ētēbhyaḥ pāṣāṇēbhya ibrāhīmaḥ santānān utpādayituṁ śaknōti|</para>
  <para style="p">
    <verse number="10" style="v"/>aparaṁ pādapānāṁ mūlē kuṭhāra idānīmapi lagan āstē, tasmād yasmin pādapē uttamaṁ phalaṁ na bhavati, sa kr̥ttō madhyē'gniṁ nikṣēpsyatē|</para>
  <para style="p">
    <verse number="11" style="v"/>aparam ahaṁ manaḥparāvarttanasūcakēna majjanēna yuṣmān majjayāmīti satyaṁ, kintu mama paścād ya āgacchati, sa mattōpi mahān, ahaṁ tadīyōpānahau vōḍhumapi nahi yōgyōsmi, sa yuṣmān vahnirūpē pavitra ātmani saṁmajjayiṣyati|</para>
  <para style="p">
    <verse number="12" style="v"/>tasya kārē sūrpa āstē, sa svīyaśasyāni samyak prasphōṭya nijān sakalagōdhūmān saṁgr̥hya bhāṇḍāgārē sthāpayiṣyati, kiṁntu sarvvāṇi vuṣāṇyanirvvāṇavahninā dāhayiṣyati|</para>
  <para style="p">
    <verse number="13" style="v"/>anantaraṁ yīśu ryōhanā majjitō bhavituṁ gālīlpradēśād yarddani tasya samīpam ājagāma|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu yōhan taṁ niṣidhya babhāṣē, tvaṁ kiṁ mama samīpam āgacchasi? varaṁ tvayā majjanaṁ mama prayōjanam āstē|</para>
  <para style="p">
    <verse number="15" style="v"/>tadānīṁ yīśuḥ pratyavōcat; īdānīm anumanyasva, yata itthaṁ sarvvadharmmasādhanam asmākaṁ karttavyaṁ, tataḥ sō'nvamanyata|</para>
  <para style="p">
    <verse number="16" style="v"/>anantaraṁ yīśurammasi majjituḥ san tatkṣaṇāt tōyamadhyād utthāya jagāma, tadā jīmūtadvārē muktē jātē, sa īśvarasyātmānaṁ kapōtavad avaruhya svōparyyāgacchantaṁ vīkṣāñcakrē|</para>
  <para style="p">
    <verse number="17" style="v"/>aparam ēṣa mama priyaḥ putra ētasminnēva mama mahāsantōṣa ētādr̥śī vyōmajā vāg babhūva|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tataḥ paraṁ yīśuḥ pratārakēṇa parīkṣitō bhavitum ātmanā prāntaram ākr̥ṣṭaḥ</para>
  <para style="p">
    <verse number="2" style="v"/>san catvāriṁśadahōrātrān anāhārastiṣṭhan kṣudhitō babhūva|</para>
  <para style="p">
    <verse number="3" style="v"/>tadānīṁ parīkṣitā tatsamīpam āgatya vyāhr̥tavān, yadi tvamīśvarātmajō bhavēstarhyājñayā pāṣāṇānētān pūpān vidhēhi|</para>
  <para style="p">
    <verse number="4" style="v"/>tataḥ sa pratyabravīt, itthaṁ likhitamāstē, "manujaḥ kēvalapūpēna na jīviṣyati, kintvīśvarasya vadanād yāni yāni vacāṁsi niḥsaranti tairēva jīviṣyati|"</para>
  <para style="p">
    <verse number="5" style="v"/>tadā pratārakastaṁ puṇyanagaraṁ nītvā mandirasya cūḍōpari nidhāya gaditavān,</para>
  <para style="p">
    <verse number="6" style="v"/>tvaṁ yadiśvarasya tanayō bhavēstarhītō'dhaḥ pata, yata itthaṁ likhitamāstē, ādēkṣyati nijān dūtān rakṣituṁ tvāṁ paramēśvaraḥ| yathā sarvvēṣu mārgēṣu tvadīyacaraṇadvayē| na lagēt prastarāghātastvāṁ ghariṣyanti tē karaiḥ||</para>
  <para style="p">
    <verse number="7" style="v"/>tadānīṁ yīśustasmai kathitavān ētadapi likhitamāstē, "tvaṁ nijaprabhuṁ paramēśvaraṁ mā parīkṣasva|"</para>
  <para style="p">
    <verse number="8" style="v"/>anantaraṁ pratārakaḥ punarapi tam atyuñcadharādharōpari nītvā jagataḥ sakalarājyāni tadaiśvaryyāṇi ca darśayāścakāra kathayāñcakāra ca,</para>
  <para style="p">
    <verse number="9" style="v"/>yadi tvaṁ daṇḍavad bhavan māṁ praṇamēstarhyaham ētāni tubhyaṁ pradāsyāmi|</para>
  <para style="p">
    <verse number="10" style="v"/>tadānīṁ yīśustamavōcat, dūrībhava pratāraka, likhitamidam āstē, "tvayā nijaḥ prabhuḥ paramēśvaraḥ praṇamyaḥ kēvalaḥ sa sēvyaśca|"</para>
  <para style="p">
    <verse number="11" style="v"/>tataḥ pratārakēṇa sa paryyatyāji, tadā svargīyadūtairāgatya sa siṣēvē|</para>
  <para style="p">
    <verse number="12" style="v"/>tadanantaraṁ yōhan kārāyāṁ babandhē, tadvārttāṁ niśamya yīśunā gālīl prāsthīyata|</para>
  <para style="p">
    <verse number="13" style="v"/>tataḥ paraṁ sa nāsarannagaraṁ vihāya jalaghēstaṭē sibūlūnnaptālī ētayōruvabhayōḥ pradēśayōḥ sīmnōrmadhyavarttī ya: kapharnāhūm tannagaram itvā nyavasat|</para>
  <para style="p">
    <verse number="14" style="v"/>tasmāt, anyādēśīyagālīli yarddanpārē'bdhirōdhasi| naptālisibūlūndēśau yatra sthānē sthitau purā|</para>
  <para style="p">
    <verse number="15" style="v"/>tatratyā manujā yē yē paryyabhrāmyan tamisrakē| tairjanairbr̥hadālōkaḥ paridarśiṣyatē tadā| avasan yē janā dēśē mr̥tyucchāyāsvarūpakē| tēṣāmupari lōkānāmālōkaḥ saṁprakāśitaḥ||</para>
  <para style="p">
    <verse number="16" style="v"/>yadētadvacanaṁ yiśayiyabhaviṣyadvādinā prōktaṁ, tat tadā saphalam abhūt|</para>
  <para style="p">
    <verse number="17" style="v"/>anantaraṁ yīśuḥ susaṁvādaṁ pracārayan ētāṁ kathāṁ kathayitum ārēbhē, manāṁsi parāvarttayata, svargīyarājatvaṁ savidhamabhavat|</para>
  <para style="p">
    <verse number="18" style="v"/>tataḥ paraṁ yīśu rgālīlō jaladhēstaṭēna gacchan gacchan āndriyastasya bhrātā śimōn arthatō yaṁ pitaraṁ vadanti ētāvubhau jalaghau jālaṁ kṣipantau dadarśa, yatastau mīnadhāriṇāvāstām|</para>
  <para style="p">
    <verse number="19" style="v"/>tadā sa tāvāhūya vyājahāra, yuvāṁ mama paścād āgacchataṁ, yuvāmahaṁ manujadhāriṇau kariṣyāmi|</para>
  <para style="p">
    <verse number="20" style="v"/>tēnaiva tau jālaṁ vihāya tasya paścāt āgacchatām|</para>
  <para style="p">
    <verse number="21" style="v"/>anantaraṁ tasmāt sthānāt vrajan vrajan sivadiyasya sutau yākūb yōhannāmānau dvau sahajau tātēna sārddhaṁ naukōpari jālasya jīrṇōddhāraṁ kurvvantau vīkṣya tāvāhūtavān|</para>
  <para style="p">
    <verse number="22" style="v"/>tatkṣaṇāt tau nāvaṁ svatātañca vihāya tasya paścādgāminau babhūvatuḥ|</para>
  <para style="p">
    <verse number="23" style="v"/>anantaraṁ bhajanabhavanē samupadiśan rājyasya susaṁvādaṁ pracārayan manujānāṁ sarvvaprakārān rōgān sarvvaprakārapīḍāśca śamayan yīśuḥ kr̥tsnaṁ gālīldēśaṁ bhramitum ārabhata|</para>
  <para style="p">
    <verse number="24" style="v"/>tēna kr̥tsnasuriyādēśasya madhyaṁ tasya yaśō vyāpnōt, aparaṁ bhūtagrastā apasmārargīṇaḥ pakṣādhātiprabhr̥tayaśca yāvantō manujā nānāvidhavyādhibhiḥ kliṣṭā āsan, tēṣu sarvvēṣu tasya samīpam ānītēṣu sa tān svasthān cakāra|</para>
  <para style="p">
    <verse number="25" style="v"/>ētēna gālīl-dikāpani-yirūśālam-yihūdīyadēśēbhyō yarddanaḥ pārāñca bahavō manujāstasya paścād āgacchan|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ sa jananivahaṁ nirīkṣya bhūdharōpari vrajitvā samupavivēśa|</para>
  <para style="p">
    <verse number="2" style="v"/>tadānīṁ śiṣyēṣu tasya samīpamāgatēṣu tēna tēbhya ēṣā kathā kathyāñcakrē|</para>
  <para style="p">
    <verse number="3" style="v"/>abhimānahīnā janā dhanyāḥ, yatastē svargīyarājyam adhikariṣyanti|</para>
  <para style="p">
    <verse number="4" style="v"/>khidyamānā manujā dhanyāḥ, yasmāt tē sāntvanāṁ prāpsanti|</para>
  <para style="p">
    <verse number="5" style="v"/>namrā mānavāśca dhanyāḥ, yasmāt tē mēdinīm adhikariṣyanti|</para>
  <para style="p">
    <verse number="6" style="v"/>dharmmāya bubhukṣitāḥ tr̥ṣārttāśca manujā dhanyāḥ, yasmāt tē paritarpsyanti|</para>
  <para style="p">
    <verse number="7" style="v"/>kr̥pālavō mānavā dhanyāḥ, yasmāt tē kr̥pāṁ prāpsyanti|</para>
  <para style="p">
    <verse number="8" style="v"/>nirmmalahr̥dayā manujāśca dhanyāḥ, yasmāt ta īścaraṁ drakṣyanti|</para>
  <para style="p">
    <verse number="9" style="v"/>mēlayitārō mānavā dhanyāḥ, yasmāt ta īścarasya santānatvēna vikhyāsyanti|</para>
  <para style="p">
    <verse number="10" style="v"/>dharmmakāraṇāt tāḍitā manujā dhanyā, yasmāt svargīyarājyē tēṣāmadhikarō vidyatē|</para>
  <para style="p">
    <verse number="11" style="v"/>yadā manujā mama nāmakr̥tē yuṣmān nindanti tāḍayanti mr̥ṣā nānādurvvākyāni vadanti ca, tadā yuyaṁ dhanyāḥ|</para>
  <para style="p">
    <verse number="12" style="v"/>tadā ānandata, tathā bhr̥śaṁ hlādadhvañca, yataḥ svargē bhūyāṁsi phalāni lapsyadhvē; tē yuṣmākaṁ purātanān bhaviṣyadvādinō'pi tādr̥g atāḍayan|</para>
  <para style="p">
    <verse number="13" style="v"/>yuyaṁ mēdinyāṁ lavaṇarūpāḥ, kintu yadi lavaṇasya lavaṇatvam apayāti, tarhi tat kēna prakārēṇa svāduyuktaṁ bhaviṣyati? tat kasyāpi kāryyasyāyōgyatvāt kēvalaṁ bahiḥ prakṣēptuṁ narāṇāṁ padatalēna dalayituñca yōgyaṁ bhavati|</para>
  <para style="p">
    <verse number="14" style="v"/>yūyaṁ jagati dīptirūpāḥ, bhūdharōpari sthitaṁ nagaraṁ guptaṁ bhavituṁ nahi śakṣyati|</para>
  <para style="p">
    <verse number="15" style="v"/>aparaṁ manujāḥ pradīpān prajvālya drōṇādhō na sthāpayanti, kintu dīpādhārōparyyēva sthāpayanti, tēna tē dīpā gēhasthitān sakalān prakāśayanti|</para>
  <para style="p">
    <verse number="16" style="v"/>yēna mānavā yuṣmākaṁ satkarmmāṇi vilōkya yuṣmākaṁ svargasthaṁ pitaraṁ dhanyaṁ vadanti, tēṣāṁ samakṣaṁ yuṣmākaṁ dīptistādr̥k prakāśatām|</para>
  <para style="p">
    <verse number="17" style="v"/>ahaṁ vyavasthāṁ bhaviṣyadvākyañca lōptum āgatavān, itthaṁ mānubhavata, tē dvē lōptuṁ nāgatavān, kintu saphalē karttum āgatōsmi|</para>
  <para style="p">
    <verse number="18" style="v"/>aparaṁ yuṣmān ahaṁ tathyaṁ vadāmi yāvat vyōmamēdinyō rdhvaṁsō na bhaviṣyati, tāvat sarvvasmin saphalē na jātē vyavasthāyā ēkā mātrā bindurēkōpi vā na lōpsyatē|</para>
  <para style="p">
    <verse number="19" style="v"/>tasmāt yō jana ētāsām ājñānām atikṣudrām ēkājñāmapī laṁghatē manujāṁñca tathaiva śikṣayati, sa svargīyarājyē sarvvēbhyaḥ kṣudratvēna vikhyāsyatē, kintu yō janastāṁ pālayati, tathaiva śikṣayati ca, sa svargīyarājyē pradhānatvēna vikhyāsyatē|</para>
  <para style="p">
    <verse number="20" style="v"/>aparaṁ yuṣmān ahaṁ vadāmi, adhyāpakaphirūśimānavānāṁ dharmmānuṣṭhānāt yuṣmākaṁ dharmmānuṣṭhānē nōttamē jātē yūyam īśvarīyarājyaṁ pravēṣṭuṁ na śakṣyatha|</para>
  <para style="p">
    <verse number="21" style="v"/>aparañca tvaṁ naraṁ mā vadhīḥ, yasmāt yō naraṁ hanti, sa vicārasabhāyāṁ daṇḍārhō bhaviṣyati, pūrvvakālīnajanēbhya iti kathitamāsīt, yuṣmābhiraśrāvi|</para>
  <para style="p">
    <verse number="22" style="v"/>kintvahaṁ yuṣmān vadāmi, yaḥ kaścit kāraṇaṁ vinā nijabhrātrē kupyati, sa vicārasabhāyāṁ daṇḍārhō bhaviṣyati; yaḥ kaścicca svīyasahajaṁ nirbbōdhaṁ vadati, sa mahāsabhāyāṁ daṇḍārhō bhaviṣyati; punaśca tvaṁ mūḍha iti vākyaṁ yadi kaścit svīyabhrātaraṁ vakti, tarhi narakāgnau sa daṇḍārhō bhaviṣyati|</para>
  <para style="p">
    <verse number="23" style="v"/>atō vēdyāḥ samīpaṁ nijanaivēdyē samānītē'pi nijabhrātaraṁ prati kasmāccit kāraṇāt tvaṁ yadi dōṣī vidyasē, tadānīṁ tava tasya smr̥ti rjāyatē ca,</para>
  <para style="p">
    <verse number="24" style="v"/>tarhi tasyā vēdyāḥ samīpē nijanaivaidyaṁ nidhāya tadaiva gatvā pūrvvaṁ tēna sārddhaṁ mila, paścāt āgatya nijanaivēdyaṁ nivēdaya|</para>
  <para style="p">
    <verse number="25" style="v"/>anyañca yāvat vivādinā sārddhaṁ vartmani tiṣṭhasi, tāvat tēna sārddhaṁ mēlanaṁ kuru; nō cēt vivādī vicārayituḥ samīpē tvāṁ samarpayati vicārayitā ca rakṣiṇaḥ sannidhau samarpayati tadā tvaṁ kārāyāṁ badhyēthāḥ|</para>
  <para style="p">
    <verse number="26" style="v"/>tarhi tvāmahaṁ taththaṁ bravīmi, śēṣakapardakē'pi na pariśōdhitē tasmāt sthānāt kadāpi bahirāgantuṁ na śakṣyasi|</para>
  <para style="p">
    <verse number="27" style="v"/>aparaṁ tvaṁ mā vyabhicara, yadētad vacanaṁ pūrvvakālīnalōkēbhyaḥ kathitamāsīt, tad yūyaṁ śrutavantaḥ;</para>
  <para style="p">
    <verse number="28" style="v"/>kintvahaṁ yuṣmān vadāmi, yadi kaścit kāmataḥ kāñcana yōṣitaṁ paśyati, tarhi sa manasā tadaiva vyabhicaritavān|</para>
  <para style="p">
    <verse number="29" style="v"/>tasmāt tava dakṣiṇaṁ nētraṁ yadi tvāṁ bādhatē, tarhi tannētram utpāṭya dūrē nikṣipa, yasmāt tava sarvvavapuṣō narakē nikṣēpāt tavaikāṅgasya nāśō varaṁ|</para>
  <para style="p">
    <verse number="30" style="v"/>yadvā tava dakṣiṇaḥ karō yadi tvāṁ bādhatē, tarhi taṁ karaṁ chittvā dūrē nikṣipa, yataḥ sarvvavapuṣō narakē nikṣēpāt ēkāṅgasya nāśō varaṁ|</para>
  <para style="p">
    <verse number="31" style="v"/>uktamāstē, yadi kaścin nijajāyāṁ parityakttum icchati, tarhi sa tasyai tyāgapatraṁ dadātu|</para>
  <para style="p">
    <verse number="32" style="v"/>kintvahaṁ yuṣmān vyāharāmi, vyabhicāradōṣē na jātē yadi kaścin nijajāyāṁ parityajati, tarhi sa tāṁ vyabhicārayati; yaśca tāṁ tyaktāṁ striyaṁ vivahati, sōpi vyabhicarati|</para>
  <para style="p">
    <verse number="33" style="v"/>punaśca tvaṁ mr̥ṣā śapatham na kurvvan īścarāya nijaśapathaṁ pālaya, pūrvvakālīnalōkēbhyō yaiṣā kathā kathitā, tāmapi yūyaṁ śrutavantaḥ|</para>
  <para style="p">
    <verse number="34" style="v"/>kintvahaṁ yuṣmān vadāmi, kamapi śapathaṁ mā kārṣṭa, arthataḥ svarganāmnā na, yataḥ sa īśvarasya siṁhāsanaṁ;</para>
  <para style="p">
    <verse number="35" style="v"/>pr̥thivyā nāmnāpi na, yataḥ sā tasya pādapīṭhaṁ; yirūśālamō nāmnāpi na, yataḥ sā mahārājasya purī;</para>
  <para style="p">
    <verse number="36" style="v"/>nijaśirōnāmnāpi na, yasmāt tasyaikaṁ kacamapi sitam asitaṁ vā karttuṁ tvayā na śakyatē|</para>
  <para style="p">
    <verse number="37" style="v"/>aparaṁ yūyaṁ saṁlāpasamayē kēvalaṁ bhavatīti na bhavatīti ca vadata yata itō'dhikaṁ yat tat pāpātmanō jāyatē|</para>
  <para style="p">
    <verse number="38" style="v"/>aparaṁ lōcanasya vinimayēna lōcanaṁ dantasya vinimayēna dantaḥ pūrvvaktamidaṁ vacanañca yuṣmābhiraśrūyata|</para>
  <para style="p">
    <verse number="39" style="v"/>kintvahaṁ yuṣmān vadāmi yūyaṁ hiṁsakaṁ naraṁ mā vyāghātayata| kintu kēnacit tava dakṣiṇakapōlē capēṭāghātē kr̥tē taṁ prati vāmaṁ kapōlañca vyāghōṭaya|</para>
  <para style="p">
    <verse number="40" style="v"/>aparaṁ kēnacit tvayā sārdhdaṁ vivādaṁ kr̥tvā tava paridhēyavasanē jighr̥titē tasmāyuttarīyavasanamapi dēhi|</para>
  <para style="p">
    <verse number="41" style="v"/>yadi kaścit tvāṁ krōśamēkaṁ nayanārthaṁ anyāyatō dharati, tadā tēna sārdhdaṁ krōśadvayaṁ yāhi|</para>
  <para style="p">
    <verse number="42" style="v"/>yaśca mānavastvāṁ yācatē, tasmai dēhi, yadi kaścit tubhyaṁ dhārayitum icchati, tarhi taṁ prati parāṁmukhō mā bhūḥ|</para>
  <para style="p">
    <verse number="43" style="v"/>nijasamīpavasini prēma kuru, kintu śatruṁ prati dvēṣaṁ kuru, yadētat purōktaṁ vacanaṁ ētadapi yūyaṁ śrutavantaḥ|</para>
  <para style="p">
    <verse number="44" style="v"/>kintvahaṁ yuṣmān vadāmi, yūyaṁ ripuvvapi prēma kuruta, yē ca yuṣmān śapantē, tāna, āśiṣaṁ vadata, yē ca yuṣmān r̥ृtīyantē, tēṣāṁ maṅgalaṁ kuruta, yē ca yuṣmān nindanti, tāḍayanti ca, tēṣāṁ kr̥tē prārthayadhvaṁ|</para>
  <para style="p">
    <verse number="45" style="v"/>tatra yaḥ satāmasatāñcōpari prabhākaram udāyayati, tathā dhārmmikānāmadhārmmikānāñcōpari nīraṁ varṣayati tādr̥śō yō yuṣmākaṁ svargasthaḥ pitā, yūyaṁ tasyaiva santānā bhaviṣyatha|</para>
  <para style="p">
    <verse number="46" style="v"/>yē yuṣmāsu prēma kurvvanti, yūyaṁ yadi kēvalaṁ tēvvēva prēma kurutha, tarhi yuṣmākaṁ kiṁ phalaṁ bhaviṣyati? caṇḍālā api tādr̥śaṁ kiṁ na kurvvanti?</para>
  <para style="p">
    <verse number="47" style="v"/>aparaṁ yūyaṁ yadi kēvalaṁ svīyabhrātr̥tvēna namata, tarhi kiṁ mahat karmma kurutha? caṇḍālā api tādr̥śaṁ kiṁ na kurvvanti?</para>
  <para style="p">
    <verse number="48" style="v"/>tasmāt yuṣmākaṁ svargasthaḥ pitā yathā pūrṇō bhavati, yūyamapi tādr̥śā bhavata|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>sāvadhānā bhavata, manujān darśayituṁ tēṣāṁ gōcarē dharmmakarmma mā kuruta, tathā kr̥tē yuṣmākaṁ svargasthapituḥ sakāśāt kiñcana phalaṁ na prāpsyatha|</para>
  <para style="p">
    <verse number="2" style="v"/>tvaṁ yadā dadāsi tadā kapaṭinō janā yathā manujēbhyaḥ praśaṁsāṁ prāptuṁ bhajanabhavanē rājamārgē ca tūrīṁ vādayanti, tathā mā kuriु, ahaṁ tubhyaṁ yathārthaṁ kathayāmi, tē svakāyaṁ phalam alabhanta|</para>
  <para style="p">
    <verse number="3" style="v"/>kintu tvaṁ yadā dadāsi, tadā nijadakṣiṇakarō yat karōti, tad vāmakaraṁ mā jñāpaya|</para>
  <para style="p">
    <verse number="4" style="v"/>tēna tava dānaṁ guptaṁ bhaviṣyati yastu tava pitā guptadarśī, sa prakāśya tubhyaṁ phalaṁ dāsyati|</para>
  <para style="p">
    <verse number="5" style="v"/>aparaṁ yadā prārthayasē, tadā kapaṭina̮iva mā kuru, yasmāt tē bhajanabhavanē rājamārgasya kōṇē tiṣṭhantō lōkān darśayantaḥ prārthayituṁ prīyantē; ahaṁ yuṣmān tathyaṁ vadāmi, tē svakīyaphalaṁ prāpnuvan|</para>
  <para style="p">
    <verse number="6" style="v"/>tasmāt prārthanākālē antarāgāraṁ praviśya dvāraṁ rudvvā guptaṁ paśyatastava pituḥ samīpē prārthayasva; tēna tava yaḥ pitā guptadarśī, sa prakāśya tubhyaṁ phalaṁ dāsyatil</para>
  <para style="p">
    <verse number="7" style="v"/>aparaṁ prārthanākālē dēvapūjakāiva mudhā punaruktiṁ mā kuru, yasmāt tē bōdhantē, bahuvāraṁ kathāyāṁ kathitāyāṁ tēṣāṁ prārthanā grāhiṣyatē|</para>
  <para style="p">
    <verse number="8" style="v"/>yūyaṁ tēṣāmiva mā kuruta, yasmāt yuṣmākaṁ yad yat prayōjanaṁ yācanātaḥ prāgēva yuṣmākaṁ pitā tat jānāti|</para>
  <para style="p">
    <verse number="9" style="v"/>ataēva yūyama īdr̥k prārthayadhvaṁ, hē asmākaṁ svargasthapitaḥ, tava nāma pūjyaṁ bhavatu|</para>
  <para style="p">
    <verse number="10" style="v"/>tava rājatvaṁ bhavatu; tavēcchā svargē yathā tathaiva mēdinyāmapi saphalā bhavatu|</para>
  <para style="p">
    <verse number="11" style="v"/>asmākaṁ prayōjanīyam āhāram adya dēhi|</para>
  <para style="p">
    <verse number="12" style="v"/>vayaṁ yathā nijāparādhinaḥ kṣamāmahē, tathaivāsmākam aparādhān kṣamasva|</para>
  <para style="p">
    <verse number="13" style="v"/>asmān parīkṣāṁ mānaya, kintu pāpātmanō rakṣa; rājatvaṁ gauravaṁ parākramaḥ ētē sarvvē sarvvadā tava; tathāstu|</para>
  <para style="p">
    <verse number="14" style="v"/>yadi yūyam anyēṣām aparādhān kṣamadhvē tarhi yuṣmākaṁ svargasthapitāpi yuṣmān kṣamiṣyatē;</para>
  <para style="p">
    <verse number="15" style="v"/>kintu yadi yūyam anyēṣām aparādhān na kṣamadhvē, tarhi yuṣmākaṁ janakōpi yuṣmākam aparādhān na kṣamiṣyatē|</para>
  <para style="p">
    <verse number="16" style="v"/>aparam upavāsakālē kapaṭinō janā mānuṣān upavāsaṁ jñāpayituṁ svēṣāṁ vadanāni mlānāni kurvvanti, yūyaṁ ta̮iva viṣaṇavadanā mā bhavata; ahaṁ yuṣmān tathyaṁ vadāmi tē svakīyaphalam alabhanta|</para>
  <para style="p">
    <verse number="17" style="v"/>yadā tvam upavasasi, tadā yathā lōkaistvaṁ upavāsīva na dr̥śyasē, kintu tava yō'gōcaraḥ pitā tēnaiva dr̥śyasē, tatkr̥tē nijaśirasi tailaṁ marddaya vadanañca prakṣālaya;</para>
  <para style="p">
    <verse number="18" style="v"/>tēna tava yaḥ pitā guptadarśī sa prakāśya tubhyaṁ phalaṁ dāsyati|</para>
  <para style="p">
    <verse number="19" style="v"/>aparaṁ yatra sthānē kīṭāḥ kalaṅkāśca kṣayaṁ nayanti, caurāśca sandhiṁ karttayitvā cōrayituṁ śaknuvanti, tādr̥śyāṁ mēdinyāṁ svārthaṁ dhanaṁ mā saṁcinuta|</para>
  <para style="p">
    <verse number="20" style="v"/>kintu yatra sthānē kīṭāḥ kalaṅkāśca kṣayaṁ na nayanti, caurāśca sandhiṁ karttayitvā cōrayituṁ na śaknuvanti, tādr̥śē svargē dhanaṁ sañcinuta|</para>
  <para style="p">
    <verse number="21" style="v"/>yasmāt yatra sthānē yuṣmāṁka dhanaṁ tatraiva khānē yuṣmākaṁ manāṁsi|</para>
  <para style="p">
    <verse number="22" style="v"/>lōcanaṁ dēhasya pradīpakaṁ, tasmāt yadi tava lōcanaṁ prasannaṁ bhavati, tarhi tava kr̥tsnaṁ vapu rdīptiyuktaṁ bhaviṣyati|</para>
  <para style="p">
    <verse number="23" style="v"/>kintu lōcanē'prasannē tava kr̥tsnaṁ vapuḥ tamisrayuktaṁ bhaviṣyati| ataēva yā dīptistvayi vidyatē, sā yadi tamisrayuktā bhavati, tarhi tat tamisraṁ kiyan mahat|</para>
  <para style="p">
    <verse number="24" style="v"/>kōpi manujō dvau prabhū sēvituṁ na śaknōti, yasmād ēkaṁ saṁmanya tadanyaṁ na sammanyatē, yadvā ēkatra manō nidhāya tadanyam avamanyatē; tathā yūyamapīśvaraṁ lakṣmīñcētyubhē sēvituṁ na śaknutha|</para>
  <para style="p">
    <verse number="25" style="v"/>aparam ahaṁ yuṣmabhyaṁ tathyaṁ kathayāmi, kiṁ bhakṣiṣyāmaḥ? kiṁ pāsyāmaḥ? iti prāṇadhāraṇāya mā cintayata; kiṁ paridhāsyāmaḥ? iti kāyarakṣaṇāya na cintayata; bhakṣyāt prāṇā vasanāñca vapūṁṣi kiṁ śrēṣṭhāṇi na hi?</para>
  <para style="p">
    <verse number="26" style="v"/>vihāyasō vihaṅgamān vilōkayata; tai rnōpyatē na kr̥tyatē bhāṇḍāgārē na sañcīyatē'pi; tathāpi yuṣmākaṁ svargasthaḥ pitā tēbhya āhāraṁ vitarati|</para>
  <para style="p">
    <verse number="27" style="v"/>yūyaṁ tēbhyaḥ kiṁ śrēṣṭhā na bhavatha? yuṣmākaṁ kaścit manujaḥ cintayan nijāyuṣaḥ kṣaṇamapi varddhayituṁ śaknōti?</para>
  <para style="p">
    <verse number="28" style="v"/>aparaṁ vasanāya kutaścintayata? kṣētrōtpannāni puṣpāṇi kathaṁ varddhantē tadālōcayata| tāni tantūn nōtpādayanti kimapi kāryyaṁ na kurvvanti;</para>
  <para style="p">
    <verse number="29" style="v"/>tathāpyahaṁ yuṣmān vadāmi, sulēmān tādr̥g aiśvaryyavānapi tatpuṣpamiva vibhūṣitō nāsīt|</para>
  <para style="p">
    <verse number="30" style="v"/>tasmāt kṣadya vidyamānaṁ ścaḥ cullyāṁ nikṣēpsyatē tādr̥śaṁ yat kṣētrasthitaṁ kusumaṁ tat yadīścara itthaṁ bibhūṣayati, tarhi hē stōkapratyayinō yuṣmān kiṁ na paridhāpayiṣyati?</para>
  <para style="p">
    <verse number="31" style="v"/>tasmāt asmābhiḥ kimatsyatē? kiñca pāyiṣyatē? kiṁ vā paridhāyiṣyatē, iti na cintayata|</para>
  <para style="p">
    <verse number="32" style="v"/>yasmāt dēvārccakā apīti cēṣṭantē; ētēṣu dravyēṣu prayōjanamastīti yuṣmākaṁ svargasthaḥ pitā jānāti|</para>
  <para style="p">
    <verse number="33" style="v"/>ataēva prathamata īśvarīyarājyaṁ dharmmañca cēṣṭadhvaṁ, tata ētāni vastūni yuṣmabhyaṁ pradāyiṣyantē|</para>
  <para style="p">
    <verse number="34" style="v"/>śvaḥ kr̥tē mā cintayata, śvaēva svayaṁ svamuddiśya cintayiṣyati; adyatanī yā cintā sādyakr̥tē pracuratarā|</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yathā yūyaṁ dōṣīkr̥tā na bhavatha, tatkr̥tē'nyaṁ dōṣiṇaṁ mā kuruta|</para>
  <para style="p">
    <verse number="2" style="v"/>yatō yādr̥śēna dōṣēṇa yūyaṁ parān dōṣiṇaḥ kurutha, tādr̥śēna dōṣēṇa yūyamapi dōṣīkr̥tā bhaviṣyatha, anyañca yēna parimāṇēna yuṣmābhiḥ parimīyatē, tēnaiva parimāṇēna yuṣmatkr̥tē parimāyiṣyatē|</para>
  <para style="p">
    <verse number="3" style="v"/>aparañca nijanayanē yā nāsā vidyatē, tām anālōcya tava sahajasya lōcanē yat tr̥ṇam āstē, tadēva kutō vīkṣasē?</para>
  <para style="p">
    <verse number="4" style="v"/>tava nijalōcanē nāsāyāṁ vidyamānāyāṁ, hē bhrātaḥ, tava nayanāt tr̥ṇaṁ bahiṣyartuṁ anujānīhi, kathāmētāṁ nijasahajāya kathaṁ kathayituṁ śaknōṣi?</para>
  <para style="p">
    <verse number="5" style="v"/>hē kapaṭin, ādau nijanayanāt nāsāṁ bahiṣkuru tatō nijadr̥ṣṭau suprasannāyāṁ tava bhrātr̥ rlōcanāt tr̥ṇaṁ bahiṣkartuṁ śakṣyasi|</para>
  <para style="p">
    <verse number="6" style="v"/>anyañca sāramēyēbhyaḥ pavitravastūni mā vitarata, varāhāṇāṁ samakṣañca muktā mā nikṣipata; nikṣēpaṇāt tē tāḥ sarvvāḥ padai rdalayiṣyanti, parāvr̥tya yuṣmānapi vidārayiṣyanti|</para>
  <para style="p">
    <verse number="7" style="v"/>yācadhvaṁ tatō yuṣmabhyaṁ dāyiṣyatē; mr̥gayadhvaṁ tata uddēśaṁ lapsyadhvē; dvāram āhata, tatō yuṣmatkr̥tē muktaṁ bhaviṣyati|</para>
  <para style="p">
    <verse number="8" style="v"/>yasmād yēna yācyatē, tēna labhyatē; yēna mr̥gyatē tēnōddēśaḥ prāpyatē; yēna ca dvāram āhanyatē, tatkr̥tē dvāraṁ mōcyatē|</para>
  <para style="p">
    <verse number="9" style="v"/>ātmajēna pūpē prārthitē tasmai pāṣāṇaṁ viśrāṇayati,</para>
  <para style="p">
    <verse number="10" style="v"/>mīnē yācitē ca tasmai bhujagaṁ vitarati, ētādr̥śaḥ pitā yuṣmākaṁ madhyē ka āstē?</para>
  <para style="p">
    <verse number="11" style="v"/>tasmād yūyam abhadrāḥ santō'pi yadi nijabālakēbhya uttamaṁ dravyaṁ dātuṁ jānītha, tarhi yuṣmākaṁ svargasthaḥ pitā svīyayācakēbhyaḥ kimuttamāni vastūni na dāsyati?</para>
  <para style="p">
    <verse number="12" style="v"/>yūṣmān pratītarēṣāṁ yādr̥śō vyavahārō yuṣmākaṁ priyaḥ, yūyaṁ tān prati tādr̥śānēva vyavahārān vidhatta; yasmād vyavasthābhaviṣyadvādināṁ vacanānām iti sāram|</para>
  <para style="p">
    <verse number="13" style="v"/>saṅkīrṇadvārēṇa praviśata; yatō narakagamanāya yad dvāraṁ tad vistīrṇaṁ yacca vartma tad br̥hat tēna bahavaḥ praviśanti|</para>
  <para style="p">
    <verse number="14" style="v"/>aparaṁ svargagamanāya yad dvāraṁ tat kīdr̥k saṁkīrṇaṁ| yacca vartma tat kīdr̥g durgamam| taduddēṣṭāraḥ kiyantō'lpāḥ|</para>
  <para style="p">
    <verse number="15" style="v"/>aparañca yē janā mēṣavēśēna yuṣmākaṁ samīpam āgacchanti, kintvantardurantā vr̥kā ētādr̥śēbhyō bhaviṣyadvādibhyaḥ sāvadhānā bhavata, yūyaṁ phalēna tān paricētuṁ śaknutha|</para>
  <para style="p">
    <verse number="16" style="v"/>manujāḥ kiṁ kaṇṭakinō vr̥kṣād drākṣāphalāni śr̥gālakōlitaśca uḍumbaraphalāni śātayanti?</para>
  <para style="p">
    <verse number="17" style="v"/>tadvad uttama ēva pādapa uttamaphalāni janayati, adhamapādapaēvādhamaphalāni janayati|</para>
  <para style="p">
    <verse number="18" style="v"/>kintūttamapādapaḥ kadāpyadhamaphalāni janayituṁ na śaknōti, tathādhamōpi pādapa uttamaphalāni janayituṁ na śaknōti|</para>
  <para style="p">
    <verse number="19" style="v"/>aparaṁ yē yē pādapā adhamaphalāni janayanti, tē kr̥ttā vahnau kṣipyantē|</para>
  <para style="p">
    <verse number="20" style="v"/>ataēva yūyaṁ phalēna tān paricēṣyatha|</para>
  <para style="p">
    <verse number="21" style="v"/>yē janā māṁ prabhuṁ vadanti, tē sarvvē svargarājyaṁ pravēkṣyanti tanna, kintu yō mānavō mama svargasthasya pituriṣṭaṁ karmma karōti sa ēva pravēkṣyati|</para>
  <para style="p">
    <verse number="22" style="v"/>tad dinē bahavō māṁ vadiṣyanti, hē prabhō hē prabhō, tava nāmnā kimasmāmi rbhaviṣyadvākyaṁ na vyāhr̥taṁ? tava nāmnā bhūtāḥ kiṁ na tyājitāḥ? tava nāmnā kiṁ nānādbhutāni karmmāṇi na kr̥tāni?</para>
  <para style="p">
    <verse number="23" style="v"/>tadāhaṁ vadiṣyāmi, hē kukarmmakāriṇō yuṣmān ahaṁ na vēdmi, yūyaṁ matsamīpād dūrībhavata|</para>
  <para style="p">
    <verse number="24" style="v"/>yaḥ kaścit mamaitāḥ kathāḥ śrutvā pālayati, sa pāṣāṇōpari gr̥hanirmmātrā jñāninā saha mayōpamīyatē|</para>
  <para style="p">
    <verse number="25" style="v"/>yatō vr̥ṣṭau satyām āplāva āgatē vāyau vātē ca tēṣu tadgēhaṁ lagnēṣu pāṣāṇōpari tasya bhittēstanna patatil</para>
  <para style="p">
    <verse number="26" style="v"/>kintu yaḥ kaścit mamaitāḥ kathāḥ śrutvā na pālayati sa saikatē gēhanirmmātrā 'jñāninā upamīyatē|</para>
  <para style="p">
    <verse number="27" style="v"/>yatō jalavr̥ṣṭau satyām āplāva āgatē pavanē vātē ca tai rgr̥hē samāghātē tat patati tatpatanaṁ mahad bhavati|</para>
  <para style="p">
    <verse number="28" style="v"/>yīśunaitēṣu vākyēṣu samāpitēṣu mānavāstadīyōpadēśam āścaryyaṁ mēnirē|</para>
  <para style="p">
    <verse number="29" style="v"/>yasmāt sa upādhyāyā iva tān nōpadidēśa kintu samarthapuruṣa̮iva samupadidēśa|</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yadā sa parvvatād avārōhat tadā bahavō mānavāstatpaścād vavrajuḥ|</para>
  <para style="p">
    <verse number="2" style="v"/>ēkaḥ kuṣṭhavān āgatya taṁ praṇamya babhāṣē, hē prabhō, yadi bhavān saṁmanyatē, tarhi māṁ nirāmayaṁ karttuṁ śaknōti|</para>
  <para style="p">
    <verse number="3" style="v"/>tatō yīśuḥ karaṁ prasāryya tasyāṅgaṁ spr̥śan vyājahāra, sammanyē'haṁ tvaṁ nirāmayō bhava; tēna sa tatkṣaṇāt kuṣṭhēnāmōci|</para>
  <para style="p">
    <verse number="4" style="v"/>tatō yīśustaṁ jagāda, avadhēhi kathāmētāṁ kaścidapi mā brūhi, kintu yājakasya sannidhiṁ gatvā svātmānaṁ darśaya manujēbhyō nijanirāmayatvaṁ pramāṇayituṁ mūsānirūpitaṁ dravyam utsr̥ja ca|</para>
  <para style="p">
    <verse number="5" style="v"/>tadanantaraṁ yīśunā kapharnāhūmnāmani nagarē praviṣṭē kaścit śatasēnāpatistatsamīpam āgatya vinīya babhāṣē,</para>
  <para style="p">
    <verse number="6" style="v"/>hē prabhō, madīya ēkō dāsaḥ pakṣāghātavyādhinā bhr̥śaṁ vyathitaḥ, satu śayanīya āstē|</para>
  <para style="p">
    <verse number="7" style="v"/>tadānīṁ yīśustasmai kathitavān, ahaṁ gatvā taṁ nirāmayaṁ kariṣyāmi|</para>
  <para style="p">
    <verse number="8" style="v"/>tataḥ sa śatasēnāpatiḥ pratyavadat, hē prabhō, bhavān yat mama gēhamadhyaṁ yāti tadyōgyabhājanaṁ nāhamasmi; vāṅmātram ādiśatu, tēnaiva mama dāsō nirāmayō bhaviṣyati|</para>
  <para style="p">
    <verse number="9" style="v"/>yatō mayi paranidhnē'pi mama nidēśavaśyāḥ kati kati sēnāḥ santi, tata ēkasmin yāhītyuktē sa yāti, tadanyasmin ēhītyuktē sa āyāti, tathā mama nijadāsē karmmaitat kurvvityuktē sa tat karōti|</para>
  <para style="p">
    <verse number="10" style="v"/>tadānīṁ yīśustasyaitat vacō niśamya vismayāpannō'bhūt; nijapaścādgāminō mānavān avōcca, yuṣmān tathyaṁ vacmi, isrāyēlīyalōkānāṁ madhyē'pi naitādr̥śō viśvāsō mayā prāptaḥ|</para>
  <para style="p">
    <verse number="11" style="v"/>anyaccāhaṁ yuṣmān vadāmi, bahavaḥ pūrvvasyāḥ paścimāyāśca diśa āgatya ibrāhīmā ishākā yākūbā ca sākam militvā samupavēkṣyanti;</para>
  <para style="p">
    <verse number="12" style="v"/>kintu yatra sthānē rōdanadantagharṣaṇē bhavatastasmin bahirbhūtatamisrē rājyasya santānā nikṣēsyantē|</para>
  <para style="p">
    <verse number="13" style="v"/>tataḥ paraṁ yīśustaṁ śatasēnāpatiṁ jagāda, yāhi, tava pratītyanusāratō maṅgalaṁ bhūyāt; tadā tasminnēva daṇḍē tadīyadāsō nirāmayō babhūva|</para>
  <para style="p">
    <verse number="14" style="v"/>anantaraṁ yīśuḥ pitarasya gēhamupasthāya jvarēṇa pīḍitāṁ śayanīyasthitāṁ tasya śvaśrūṁ vīkṣāñcakrē|</para>
  <para style="p">
    <verse number="15" style="v"/>tatastēna tasyāḥ karasya spr̥ṣṭatavāt jvarastāṁ tatyāja, tadā sā samutthāya tān siṣēvē|</para>
  <para style="p">
    <verse number="16" style="v"/>anantaraṁ sandhyāyāṁ satyāṁ bahuśō bhūtagrastamanujān tasya samīpam āninyuḥ sa ca vākyēna bhūtān tyājayāmāsa, sarvvaprakārapīḍitajanāṁśca nirāmayān cakāra;</para>
  <para style="p">
    <verse number="17" style="v"/>tasmāt, sarvvā durbbalatāsmākaṁ tēnaiva paridhāritā| asmākaṁ sakalaṁ vyādhiṁ saēva saṁgr̥hītavān| yadētadvacanaṁ yiśayiyabhaviṣyadvādinōktamāsīt, tattadā saphalamabhavat|</para>
  <para style="p">
    <verse number="18" style="v"/>anantaraṁ yīśuścaturdikṣu jananivahaṁ vilōkya taṭinyāḥ pāraṁ yātuṁ śiṣyān ādidēśa|</para>
  <para style="p">
    <verse number="19" style="v"/>tadānīm ēka upādhyāya āgatya kathitavān, hē gurō, bhavān yatra yāsyati tatrāhamapi bhavataḥ paścād yāsyāmi|</para>
  <para style="p">
    <verse number="20" style="v"/>tatō yīśu rjagāda, krōṣṭuḥ sthātuṁ sthānaṁ vidyatē, vihāyasō vihaṅgamānāṁ nīḍāni ca santi; kintu manuṣyaputrasya śiraḥ sthāpayituṁ sthānaṁ na vidyatē|</para>
  <para style="p">
    <verse number="21" style="v"/>anantaram apara ēkaḥ śiṣyastaṁ babhāṣē, hē prabhō, prathamatō mama pitaraṁ śmaśānē nidhātuṁ gamanārthaṁ mām anumanyasva|</para>
  <para style="p">
    <verse number="22" style="v"/>tatō yīśuruktavān mr̥tā mr̥tān śmaśānē nidadhatu, tvaṁ mama paścād āgaccha|</para>
  <para style="p">
    <verse number="23" style="v"/>anantaraṁ tasmin nāvamārūḍhē tasya śiṣyāstatpaścāt jagmuḥ|</para>
  <para style="p">
    <verse number="24" style="v"/>paścāt sāgarasya madhyaṁ tēṣu gatēṣu tādr̥śaḥ prabalō jhañbhśanila udatiṣṭhat, yēna mahātaraṅga utthāya taraṇiṁ chāditavān, kintu sa nidrita āsīt|</para>
  <para style="p">
    <verse number="25" style="v"/>tadā śiṣyā āgatya tasya nidrābhaṅgaṁ kr̥tvā kathayāmāsuḥ, hē prabhō, vayaṁ mriyāmahē, bhavān asmākaṁ prāṇān rakṣatu|</para>
  <para style="p">
    <verse number="26" style="v"/>tadā sa tān uktavān, hē alpaviśvāsinō yūyaṁ kutō vibhītha? tataḥ sa utthāya vātaṁ sāgarañca tarjayāmāsa, tatō nirvvātamabhavat|</para>
  <para style="p">
    <verse number="27" style="v"/>aparaṁ manujā vismayaṁ vilōkya kathayāmāsuḥ, ahō vātasaritpatī asya kimājñāgrāhiṇau? kīdr̥śō'yaṁ mānavaḥ|</para>
  <para style="p">
    <verse number="28" style="v"/>anantaraṁ sa pāraṁ gatvā gidērīyadēśam upasthitavān; tadā dvau bhūtagrastamanujau śmaśānasthānād bahi rbhūtvā taṁ sākṣāt kr̥tavantau, tāvētādr̥śau pracaṇḍāvāstāṁ yat tēna sthānēna kōpi yātuṁ nāśaknōt|</para>
  <para style="p">
    <verse number="29" style="v"/>tāvucaiḥ kathayāmāsatuḥ, hē īśvarasya sūnō yīśō, tvayā sākam āvayōḥ kaḥ sambandhaḥ? nirūpitakālāt prāgēva kimāvābhyāṁ yātanāṁ dātum atrāgatōsi?</para>
  <para style="p">
    <verse number="30" style="v"/>tadānīṁ tābhyāṁ kiñcid dūrē varāhāṇām ēkō mahāvrajō'carat|</para>
  <para style="p">
    <verse number="31" style="v"/>tatō bhūtau tau tasyāntikē vinīya kathayāmāsatuḥ, yadyāvāṁ tyājayasi, tarhi varāhāṇāṁ madhyēvrajam āvāṁ prēraya|</para>
  <para style="p">
    <verse number="32" style="v"/>tadā yīśuravadat yātaṁ, anantaraṁ tau yadā manujau vihāya varāhān āśritavantau, tadā tē sarvvē varāhā uccasthānāt mahājavēna dhāvantaḥ sāgarīyatōyē majjantō mamruḥ|</para>
  <para style="p">
    <verse number="33" style="v"/>tatō varāharakṣakāḥ palāyamānā madhyēnagaraṁ tau bhūtagrastau prati yadyad aghaṭata, tāḥ sarvvavārttā avadan|</para>
  <para style="p">
    <verse number="34" style="v"/>tatō nāgarikāḥ sarvvē manujā yīśuṁ sākṣāt karttuṁ bahirāyātāḥ tañca vilōkya prārthayāñcakrirē bhavān asmākaṁ sīmātō yātu|</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ yīśu rnaukāmāruhya punaḥ pāramāgatya nijagrāmam āyayau|</para>
  <para style="p">
    <verse number="2" style="v"/>tataḥ katipayā janā ēkaṁ pakṣāghātinaṁ svaṭṭōpari śāyayitvā tatsamīpam ānayan; tatō yīśustēṣāṁ pratītiṁ vijñāya taṁ pakṣāghātinaṁ jagāda, hē putra, susthirō bhava, tava kaluṣasya marṣaṇaṁ jātam|</para>
  <para style="p">
    <verse number="3" style="v"/>tāṁ kathāṁ niśamya kiyanta upādhyāyā manaḥsu cintitavanta ēṣa manuja īśvaraṁ nindati|</para>
  <para style="p">
    <verse number="4" style="v"/>tataḥ sa tēṣām ētādr̥śīṁ cintāṁ vijñāya kathitavān, yūyaṁ manaḥsu kr̥ta ētādr̥śīṁ kucintāṁ kurutha?</para>
  <para style="p">
    <verse number="5" style="v"/>tava pāpamarṣaṇaṁ jātaṁ, yadvā tvamutthāya gaccha, dvayōranayō rvākyayōḥ kiṁ vākyaṁ vaktuṁ sugamaṁ?</para>
  <para style="p">
    <verse number="6" style="v"/>kintu mēdinyāṁ kaluṣaṁ kṣamituṁ manujasutasya sāmarthyamastīti yūyaṁ yathā jānītha, tadarthaṁ sa taṁ pakṣāghātinaṁ gaditavān, uttiṣṭha, nijaśayanīyaṁ ādāya gēhaṁ gaccha|</para>
  <para style="p">
    <verse number="7" style="v"/>tataḥ sa tatkṣaṇād utthāya nijagēhaṁ prasthitavān|</para>
  <para style="p">
    <verse number="8" style="v"/>mānavā itthaṁ vilōkya vismayaṁ mēnirē, īśvarēṇa mānavāya sāmarthyam īdr̥śaṁ dattaṁ iti kāraṇāt taṁ dhanyaṁ babhāṣirē ca|</para>
  <para style="p">
    <verse number="9" style="v"/>anantaraṁ yīśustatsthānād gacchan gacchan karasaṁgrahasthānē samupaviṣṭaṁ mathināmānam ēkaṁ manujaṁ vilōkya taṁ babhāṣē, mama paścād āgaccha, tataḥ sa utthāya tasya paścād vavrāja|</para>
  <para style="p">
    <verse number="10" style="v"/>tataḥ paraṁ yīśau gr̥hē bhōktum upaviṣṭē bahavaḥ karasaṁgrāhiṇaḥ kaluṣiṇaśca mānavā āgatya tēna sākaṁ tasya śiṣyaiśca sākam upaviviśuḥ|</para>
  <para style="p">
    <verse number="11" style="v"/>phirūśinastad dr̥ṣṭvā tasya śiṣyān babhāṣirē, yuṣmākaṁ guruḥ kiṁ nimittaṁ karasaṁgrāhibhiḥ kaluṣibhiśca sākaṁ bhuṁktē?</para>
  <para style="p">
    <verse number="12" style="v"/>yīśustat śrutvā tān pratyavadat, nirāmayalōkānāṁ cikitsakēna prayōjanaṁ nāsti, kintu sāmayalōkānāṁ prayōjanamāstē|</para>
  <para style="p">
    <verse number="13" style="v"/>atō yūyaṁ yātvā vacanasyāsyārthaṁ śikṣadhvam, dayāyāṁ mē yathā prīti rna tathā yajñakarmmaṇi|yatō'haṁ dhārmmikān āhvātuṁ nāgatō'smi kintu manaḥ parivarttayituṁ pāpina āhvātum āgatō'smi|</para>
  <para style="p">
    <verse number="14" style="v"/>anantaraṁ yōhanaḥ śiṣyāstasya samīpam āgatya kathayāmāsuḥ, phirūśinō vayañca punaḥ punarupavasāmaḥ, kintu tava śiṣyā nōpavasanti, kutaḥ?</para>
  <para style="p">
    <verse number="15" style="v"/>tadā yīśustān avōcat yāvat sakhīnāṁ saṁṅgē kanyāyā varastiṣṭhati, tāvat kiṁ tē vilāpaṁ karttuṁ śakluvanti? kintu yadā tēṣāṁ saṁṅgād varaṁ nayanti, tādr̥śaḥ samaya āgamiṣyati, tadā tē upavatsyanti|</para>
  <para style="p">
    <verse number="16" style="v"/>purātanavasanē kōpi navīnavastraṁ na yōjayati, yasmāt tēna yōjitēna purātanavasanaṁ chinatti tacchidrañca bahukutsitaṁ dr̥śyatē|</para>
  <para style="p">
    <verse number="17" style="v"/>anyañca purātanakutvāṁ kōpi navānagōstanīrasaṁ na nidadhāti, yasmāt tathā kr̥tē kutū rvidīryyatē tēna gōstanīrasaḥ patati kutūśca naśyati; tasmāt navīnāyāṁ kutvāṁ navīnō gōstanīrasaḥ sthāpyatē, tēna dvayōravanaṁ bhavati|</para>
  <para style="p">
    <verse number="18" style="v"/>aparaṁ tēnaitatkathākathanakālē ēkō'dhipatistaṁ praṇamya babhāṣē, mama duhitā prāyēṇaitāvatkālē mr̥tā, tasmād bhavānāgatya tasyā gātrē hastamarpayatu, tēna sā jīviṣyati|</para>
  <para style="p">
    <verse number="19" style="v"/>tadānīṁ yīśuḥ śiṣyaiḥ sākam utthāya tasya paścād vavrāja|</para>
  <para style="p">
    <verse number="20" style="v"/>ityanantarē dvādaśavatsarān yāvat pradarāmayēna śīrṇaikā nārī tasya paścād āgatya tasya vasanasya granthiṁ pasparśa;</para>
  <para style="p">
    <verse number="21" style="v"/>yasmāt mayā kēvalaṁ tasya vasanaṁ spr̥ṣṭvā svāsthyaṁ prāpsyatē, sā nārīti manasi niścitavatī|</para>
  <para style="p">
    <verse number="22" style="v"/>tatō yīśurvadanaṁ parāvarttya tāṁ jagāda, hē kanyē, tvaṁ susthirā bhava, tava viśvāsastvāṁ svasthāmakārṣīt| ētadvākyē gaditaēva sā yōṣit svasthābhūt|</para>
  <para style="p">
    <verse number="23" style="v"/>aparaṁ yīśustasyādhyakṣasya gēhaṁ gatvā vādakaprabhr̥tīn bahūn lōkān śabdāyamānān vilōkya tān avadat,</para>
  <para style="p">
    <verse number="24" style="v"/>panthānaṁ tyaja, kanyēyaṁ nāmriyata nidritāstē; kathāmētāṁ śrutvā tē tamupajahasuḥ|</para>
  <para style="p">
    <verse number="25" style="v"/>kintu sarvvēṣu bahiṣkr̥tēṣu sō'bhyantaraṁ gatvā kanyāyāḥ karaṁ dhr̥tavān, tēna sōdatiṣṭhat;</para>
  <para style="p">
    <verse number="26" style="v"/>tatastatkarmmaṇō yaśaḥ kr̥tsnaṁ taṁ dēśaṁ vyāptavat|</para>
  <para style="p">
    <verse number="27" style="v"/>tataḥ paraṁ yīśustasmāt sthānād yātrāṁ cakāra; tadā hē dāyūdaḥ santāna, asmān dayasva, iti vadantau dvau janāvandhau prōcairāhūyantau tatpaścād vavrajatuḥ|</para>
  <para style="p">
    <verse number="28" style="v"/>tatō yīśau gēhamadhyaṁ praviṣṭaṁ tāvapi tasya samīpam upasthitavantau, tadānīṁ sa tau pr̥ṣṭavān karmmaitat karttuṁ mama sāmarthyam āstē, yuvāṁ kimiti pratīthaḥ? tadā tau pratyūcatuḥ, satyaṁ prabhō|</para>
  <para style="p">
    <verse number="29" style="v"/>tadānīṁ sa tayō rlōcanāni spr̥śan babhāṣē, yuvayōḥ pratītyanusārād yuvayō rmaṅgalaṁ bhūyāt| tēna tatkṣaṇāt tayō rnētrāṇi prasannānyabhavan,</para>
  <para style="p">
    <verse number="30" style="v"/>paścād yīśustau dr̥ḍhamājñāpya jagāda, avadhattam ētāṁ kathāṁ kōpi manujō ma jānīyāt|</para>
  <para style="p">
    <verse number="31" style="v"/>kintu tau prasthāya tasmin kr̥tsnē dēśē tasya kīrttiṁ prakāśayāmāsatuḥ|</para>
  <para style="p">
    <verse number="32" style="v"/>aparaṁ tau bahiryāta ētasminnantarē manujā ēkaṁ bhūtagrastamūkaṁ tasya samīpam ānītavantaḥ|</para>
  <para style="p">
    <verse number="33" style="v"/>tēna bhūtē tyājitē sa mūkaḥ kathāṁ kathayituṁ prārabhata, tēna janā vismayaṁ vijñāya kathayāmāsuḥ, isrāyēlō vaṁśē kadāpi nēdr̥gadr̥śyata;</para>
  <para style="p">
    <verse number="34" style="v"/>kintu phirūśinaḥ kathayāñcakruḥ bhūtādhipatinā sa bhūtān tyājayati|</para>
  <para style="p">
    <verse number="35" style="v"/>tataḥ paraṁ yīśustēṣāṁ bhajanabhavana upadiśan rājyasya susaṁvādaṁ pracārayan lōkānāṁ yasya ya āmayō yā ca pīḍāsīt, tān śamayan śamayaṁśca sarvvāṇi nagarāṇi grāmāṁśca babhrāma|</para>
  <para style="p">
    <verse number="36" style="v"/>anyañca manujān vyākulān arakṣakamēṣāniva ca tyaktān nirīkṣya tēṣu kāruṇikaḥ san śiṣyān avadat,</para>
  <para style="p">
    <verse number="37" style="v"/>śasyāni pracurāṇi santi, kintu chēttāraḥ stōkāḥ|</para>
  <para style="p">
    <verse number="38" style="v"/>kṣētraṁ pratyaparān chēdakān prahētuṁ śasyasvāminaṁ prārthayadhvam|</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ yīśu rdvādaśaśiṣyān āhūyāmēdhyabhūtān tyājayituṁ sarvvaprakārarōgān pīḍāśca śamayituṁ tēbhyaḥ sāmarthyamadāt|</para>
  <para style="p">
    <verse number="2" style="v"/>tēṣāṁ dvādaśaprēṣyāṇāṁ nāmānyētāni| prathamaṁ śimōn yaṁ pitaraṁ vadanti, tataḥ paraṁ tasya sahaja āndriyaḥ, sivadiyasya putrō yākūb</para>
  <para style="p">
    <verse number="3" style="v"/>tasya sahajō yōhan; philip barthalamay thōmāḥ karasaṁgrāhī mathiḥ, ālphēyaputrō yākūb,</para>
  <para style="p">
    <verse number="4" style="v"/>kinānīyaḥ śimōn, ya īṣkariyōtīyayihūdāḥ khrīṣṭaṁ parakarē'rpayat|</para>
  <para style="p">
    <verse number="5" style="v"/>ētān dvādaśaśiṣyān yīśuḥ prēṣayan ityājñāpayat, yūyam anyadēśīyānāṁ padavīṁ śēmirōṇīyānāṁ kimapi nagarañca na praviśyē</para>
  <para style="p">
    <verse number="6" style="v"/>isrāyēlgōtrasya hāritā yē yē mēṣāstēṣāmēva samīpaṁ yāta|</para>
  <para style="p">
    <verse number="7" style="v"/>gatvā gatvā svargasya rājatvaṁ savidhamabhavat, ētāṁ kathāṁ pracārayata|</para>
  <para style="p">
    <verse number="8" style="v"/>āmayagrastān svasthān kuruta, kuṣṭhinaḥ pariṣkuruta, mr̥talōkān jīvayata, bhūtān tyājayata, vinā mūlyaṁ yūyam alabhadhvaṁ vinaiva mūlyaṁ viśrāṇayata|</para>
  <para style="p">
    <verse number="9" style="v"/>kintu svēṣāṁ kaṭibandhēṣu svarṇarūpyatāmrāṇāṁ kimapi na gr̥hlīta|</para>
  <para style="p">
    <verse number="10" style="v"/>anyacca yātrāyai cēlasampuṭaṁ vā dvitīyavasanaṁ vā pādukē vā yaṣṭiḥ, ētān mā gr̥hlīta, yataḥ kāryyakr̥t bharttuṁ yōgyō bhavati|</para>
  <para style="p">
    <verse number="11" style="v"/>aparaṁ yūyaṁ yat puraṁ yañca grāmaṁ praviśatha, tatra yō janō yōgyapātraṁ tamavagatya yānakālaṁ yāvat tatra tiṣṭhata|</para>
  <para style="p">
    <verse number="12" style="v"/>yadā yūyaṁ tadgēhaṁ praviśatha, tadā tamāśiṣaṁ vadata|</para>
  <para style="p">
    <verse number="13" style="v"/>yadi sa yōgyapātraṁ bhavati, tarhi tatkalyāṇaṁ tasmai bhaviṣyati, nōcēt sāśīryuṣmabhyamēva bhaviṣyati|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu yē janā yuṣmākamātithyaṁ na vidadhati yuṣmākaṁ kathāñca na śr̥ṇvanti tēṣāṁ gēhāt purādvā prasthānakālē svapadūlīḥ pātayata|</para>
  <para style="p">
    <verse number="15" style="v"/>yuṣmānahaṁ tathyaṁ vacmi vicāradinē tatpurasya daśātaḥ sidōmamōrāpurayōrdaśā sahyatarā bhaviṣyati|</para>
  <para style="p">
    <verse number="16" style="v"/>paśyata, vr̥kayūthamadhyē mēṣaḥ yathāvistathā yuṣmāna prahiṇōmi, tasmād yūyam ahiriva satarkāḥ kapōtāivāhiṁsakā bhavata|</para>
  <para style="p">
    <verse number="17" style="v"/>nr̥bhyaḥ sāvadhānā bhavata; yatastai ryūyaṁ rājasaṁsadi samarpiṣyadhvē tēṣāṁ bhajanagēhē prahāriṣyadhvē|</para>
  <para style="p">
    <verse number="18" style="v"/>yūyaṁ mannāmahētōḥ śāstr̥ṇāṁ rājñāñca samakṣaṁ tānanyadēśinaścādhi sākṣitvārthamānēṣyadhvē|</para>
  <para style="p">
    <verse number="19" style="v"/>kintvitthaṁ samarpitā yūyaṁ kathaṁ kimuttaraṁ vakṣyatha tatra mā cintayata, yatastadā yuṣmābhi ryad vaktavyaṁ tat taddaṇḍē yuṣmanmanaḥ su samupasthāsyati|</para>
  <para style="p">
    <verse number="20" style="v"/>yasmāt tadā yō vakṣyati sa na yūyaṁ kintu yuṣmākamantarasthaḥ pitrātmā|</para>
  <para style="p">
    <verse number="21" style="v"/>sahajaḥ sahajaṁ tātaḥ sutañca mr̥tau samarpayiṣyati, apatyāgi svasvapitrōे rvipakṣībhūya tau ghātayiṣyanti|</para>
  <para style="p">
    <verse number="22" style="v"/>mannamahētōḥ sarvvē janā yuṣmān r̥ृtīyiṣyantē, kintu yaḥ śēṣaṁ yāvad dhairyyaṁ ghr̥tvā sthāsyati, sa trāyiṣyatē|</para>
  <para style="p">
    <verse number="23" style="v"/>tai ryadā yūyamēkapurē tāḍiṣyadhvē, tadā yūyamanyapuraṁ palāyadhvaṁ yuṣmānahaṁ tathyaṁ vacmi yāvanmanujasutō naiti tāvad isrāyēldēśīyasarvvanagarabhramaṇaṁ samāpayituṁ na śakṣyatha|</para>
  <para style="p">
    <verse number="24" style="v"/>gurōḥ śiṣyō na mahān, prabhōrdāsō na mahān|</para>
  <para style="p">
    <verse number="25" style="v"/>yadi śiṣyō nijagurō rdāsaśca svaprabhōḥ samānō bhavati tarhi tad yathēṣṭaṁ| cēttairgr̥hapatirbhūtarāja ucyatē, tarhi parivārāḥ kiṁ tathā na vakṣyantē?</para>
  <para style="p">
    <verse number="26" style="v"/>kintu tēbhyō yūyaṁ mā bibhīta, yatō yanna prakāśiṣyatē, tādr̥k chāditaṁ kimapi nāsti, yacca na vyañciṣyatē, tādr̥g guptaṁ kimapi nāsti|</para>
  <para style="p">
    <verse number="27" style="v"/>yadahaṁ yuṣmān tamasi vacmi tad yuṣmābhirdīptau kathyatāṁ; karṇābhyāṁ yat śrūyatē tad gēhōpari pracāryyatāṁ|</para>
  <para style="p">
    <verse number="28" style="v"/>yē kāyaṁ hantuṁ śaknuvanti nātmānaṁ, tēbhyō mā bhaiṣṭa; yaḥ kāyātmānau nirayē nāśayituṁ, śaknōti, tatō bibhīta|</para>
  <para style="p">
    <verse number="29" style="v"/>dvau caṭakau kimēkatāmramudrayā na vikrīyētē? tathāpi yuṣmattātānumatiṁ vinā tēṣāmēkōpi bhuvi na patati|</para>
  <para style="p">
    <verse number="30" style="v"/>yuṣmacchirasāṁ sarvvakacā gaṇitāṁḥ santi|</para>
  <para style="p">
    <verse number="31" style="v"/>atō mā bibhīta, yūyaṁ bahucaṭakēbhyō bahumūlyāḥ|</para>
  <para style="p">
    <verse number="32" style="v"/>yō manujasākṣānmāmaṅgīkurutē tamahaṁ svargasthatātasākṣādaṅgīkariṣyē|</para>
  <para style="p">
    <verse number="33" style="v"/>pr̥thvyāmahaṁ śāntiṁ dātumāgata̮iti mānubhavata, śāntiṁ dātuṁ na kintvasiṁ|</para>
  <para style="p">
    <verse number="34" style="v"/>pitr̥mātr̥ścaśrūbhiḥ sākaṁ sutasutābadhū rvirōdhayituñcāgatēाsmi|</para>
  <para style="p">
    <verse number="35" style="v"/>tataḥ svasvaparivāraēva nr̥śatru rbhavitā|</para>
  <para style="p">
    <verse number="36" style="v"/>yaḥ pitari mātari vā mattōdhikaṁ prīyatē, sa na madarhaḥ;</para>
  <para style="p">
    <verse number="37" style="v"/>yaśca sutē sutāyāṁ vā mattōdhikaṁ prīyatē, sēाpi na madarhaḥ|</para>
  <para style="p">
    <verse number="38" style="v"/>yaḥ svakruśaṁ gr̥hlan matpaścānnaiti, sēाpi na madarhaḥ|</para>
  <para style="p">
    <verse number="39" style="v"/>yaḥ svaprāṇānavati, sa tān hārayiṣyatē, yastu matkr̥tē svaprāṇān hārayati, sa tānavati|</para>
  <para style="p">
    <verse number="40" style="v"/>yō yuṣmākamātithyaṁ vidadhāti, sa mamātithyaṁ vidadhāti, yaśca mamātithyaṁ vidadhāti, sa matprērakasyātithyaṁ vidadhāti|</para>
  <para style="p">
    <verse number="41" style="v"/>yō bhaviṣyadvādīti jñātvā tasyātithyaṁ vidhattē, sa bhaviṣyadvādinaḥ phalaṁ lapsyatē, yaśca dhārmmika iti viditvā tasyātithyaṁ vidhattē sa dhārmmikamānavasya phalaṁ prāpsyati|</para>
  <para style="p">
    <verse number="42" style="v"/>yaśca kaścit ētēṣāṁ kṣudranarāṇām yaṁ kañcanaikaṁ śiṣya iti viditvā kaṁsaikaṁ śītalasalilaṁ tasmai dattē, yuṣmānahaṁ tathyaṁ vadāmi, sa kēnāpi prakārēṇa phalēna na vañciṣyatē|</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>itthaṁ yīśuḥ svadvādaśaśiṣyāṇāmājñāpanaṁ samāpya purē pura upadēṣṭuṁ susaṁvādaṁ pracārayituṁ tatsthānāt pratasthē|</para>
  <para style="p">
    <verse number="2" style="v"/>anantaraṁ yōhan kārāyāṁ tiṣṭhan khriṣṭasya karmmaṇāṁ vārttaṁ prāpya yasyāgamanavārttāsīt saēva kiṁ tvaṁ? vā vayamanyam apēkṣiṣyāmahē?</para>
  <para style="p">
    <verse number="3" style="v"/>ētat praṣṭuṁ nijau dvau śiṣyau prāhiṇōt|</para>
  <para style="p">
    <verse number="4" style="v"/>yīśuḥ pratyavōcat, andhā nētrāṇi labhantē, khañcā gacchanti, kuṣṭhinaḥ svasthā bhavanti, badhirāḥ śr̥ṇvanti, mr̥tā jīvanta uttiṣṭhanti, daridrāṇāṁ samīpē susaṁvādaḥ pracāryyata,</para>
  <para style="p">
    <verse number="5" style="v"/>ētāni yadyad yuvāṁ śr̥ṇuthaḥ paśyathaśca gatvā tadvārttāṁ yōhanaṁ gadataṁ|</para>
  <para style="p">
    <verse number="6" style="v"/>yasyāhaṁ na vighnībhavāmi, saēva dhanyaḥ|</para>
  <para style="p">
    <verse number="7" style="v"/>anantaraṁ tayōḥ prasthitayō ryīśu ryōhanam uddiśya janān jagāda, yūyaṁ kiṁ draṣṭuṁ vahirmadhyēprāntaram agacchata? kiṁ vātēna kampitaṁ nalaṁ?</para>
  <para style="p">
    <verse number="8" style="v"/>vā kiṁ vīkṣituṁ vahirgatavantaḥ? kiṁ parihitasūkṣmavasanaṁ manujamēkaṁ? paśyata, yē sūkṣmavasanāni paridadhati, tē rājadhānyāṁ tiṣṭhanti|</para>
  <para style="p">
    <verse number="9" style="v"/>tarhi yūyaṁ kiṁ draṣṭuṁ bahiragamata, kimēkaṁ bhaviṣyadvādinaṁ? tadēva satyaṁ| yuṣmānahaṁ vadāmi, sa bhaviṣyadvādinōpi mahān;</para>
  <para style="p">
    <verse number="10" style="v"/>yataḥ, paśya svakīyadūtōyaṁ tvadagrē prēṣyatē mayā| sa gatvā tava panthānaṁ smayak pariṣkariṣyati|| ētadvacanaṁ yamadhi likhitamāstē sō'yaṁ yōhan|</para>
  <para style="p">
    <verse number="11" style="v"/>aparaṁ yuṣmānahaṁ tathyaṁ bravīmi, majjayitu ryōhanaḥ śrēṣṭhaḥ kōpi nārītō nājāyata; tathāpi svargarājyamadhyē sarvvēbhyō yaḥ kṣudraḥ sa yōhanaḥ śrēṣṭhaḥ|</para>
  <para style="p">
    <verse number="12" style="v"/>aparañca ā yōhanō'dya yāvat svargarājyaṁ balādākrāntaṁ bhavati ākraminaśca janā balēna tadadhikurvvanti|</para>
  <para style="p">
    <verse number="13" style="v"/>yatō yōhanaṁ yāvat sarvvabhaviṣyadvādibhi rvyavasthayā ca upadēśaḥ prākāśyata|</para>
  <para style="p">
    <verse number="14" style="v"/>yadi yūyamidaṁ vākyaṁ grahītuṁ śaknutha, tarhi śrēyaḥ, yasyāgamanasya vacanamāstē sō'yam ēliyaḥ|</para>
  <para style="p">
    <verse number="15" style="v"/>yasya śrōtuṁ karṇau staḥ sa śr̥ṇōtu|</para>
  <para style="p">
    <verse number="16" style="v"/>ētē vidyamānajanāḥ kai rmayōpamīyantē? yē bālakā haṭṭa upaviśya svaṁ svaṁ bandhumāhūya vadanti,</para>
  <para style="p">
    <verse number="17" style="v"/>vayaṁ yuṣmākaṁ samīpē vaṁśīravādayāma, kintu yūyaṁ nānr̥tyata; yuṣmākaṁ samīpē ca vayamarōdima, kintu yūyaṁ na vyalapata, tādr̥śai rbālakaista upamāyiṣyantē|</para>
  <para style="p">
    <verse number="18" style="v"/>yatō yōhan āgatya na bhuktavān na pītavāṁśca, tēna lōkā vadanti, sa bhūtagrasta iti|</para>
  <para style="p">
    <verse number="19" style="v"/>manujasuta āgatya bhuktavān pītavāṁśca, tēna lōkā vadanti, paśyata ēṣa bhōktā madyapātā caṇḍālapāpināṁ bandhaśca, kintu jñāninō jñānavyavahāraṁ nirdōṣaṁ jānanti|</para>
  <para style="p">
    <verse number="20" style="v"/>sa yatra yatra purē bahvāścaryyaṁ karmma kr̥tavān, tannivāsināṁ manaḥparāvr̥ttyabhāvāt tāni nagarāṇi prati hantētyuktā kathitavān,</para>
  <para style="p">
    <verse number="21" style="v"/>hā kōrāsīn, hā baitsaidē, yuṣmanmadhyē yadyadāścaryyaṁ karmma kr̥taṁ yadi tat sōrasīdōnnagara akāriṣyata, tarhi pūrvvamēva tannivāsinaḥ śāṇavasanē bhasmani cōpaviśantō manāṁsi parāvarttiṣyanta|</para>
  <para style="p">
    <verse number="22" style="v"/>tasmādahaṁ yuṣmān vadāmi, vicāradinē yuṣmākaṁ daśātaḥ sōrasīdōnō rdaśā sahyatarā bhaviṣyati|</para>
  <para style="p">
    <verse number="23" style="v"/>aparañca bata kapharnāhūm, tvaṁ svargaṁ yāvadunnatōsi, kintu narakē nikṣēpsyasē, yasmāt tvayi yānyāścaryyāṇi karmmaṇyakāriṣata, yadi tāni sidōmnagara akāriṣyanta, tarhi tadadya yāvadasthāsyat|</para>
  <para style="p">
    <verse number="24" style="v"/>kintvahaṁ yuṣmān vadāmi, vicāradinē tava daṇḍataḥ sidōmō daṇḍō sahyatarō bhaviṣyati|</para>
  <para style="p">
    <verse number="25" style="v"/>ētasminnēva samayē yīśuḥ punaruvāca, hē svargapr̥thivyōrēkādhipatē pitastvaṁ jñānavatō viduṣaśca lōkān pratyētāni na prakāśya bālakān prati prakāśitavān, iti hētōstvāṁ dhanyaṁ vadāmi|</para>
  <para style="p">
    <verse number="26" style="v"/>hē pitaḥ, itthaṁ bhavēt yata idaṁ tvadr̥ṣṭāvuttamaṁ|</para>
  <para style="p">
    <verse number="27" style="v"/>pitrā mayi sarvvāṇi samarpitāni, pitaraṁ vinā kōpi putraṁ na jānāti, yān prati putrēṇa pitā prakāśyatē tān vinā putrād anyaḥ kōpi pitaraṁ na jānāti|</para>
  <para style="p">
    <verse number="28" style="v"/>hē pariśrāntā bhārākrāntāśca lōkā yūyaṁ matsannidhim āgacchata, ahaṁ yuṣmān viśramayiṣyāmi|</para>
  <para style="p">
    <verse number="29" style="v"/>ahaṁ kṣamaṇaśīlō namramanāśca, tasmāt mama yugaṁ svēṣāmupari dhārayata mattaḥ śikṣadhvañca, tēna yūyaṁ svē svē manasi viśrāmaṁ lapsyadhbē|</para>
  <para style="p">
    <verse number="30" style="v"/>yatō mama yugam anāyāsaṁ mama bhāraśca laghuḥ|</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ yīśu rviśrāmavārē śsyamadhyēna gacchati, tadā tacchiṣyā bubhukṣitāḥ santaḥ śsyamañjarīśchatvā chitvā khāditumārabhanta|</para>
  <para style="p">
    <verse number="2" style="v"/>tad vilōkya phirūśinō yīśuṁ jagaduḥ, paśya viśrāmavārē yat karmmākarttavyaṁ tadēva tava śiṣyāḥ kurvvanti|</para>
  <para style="p">
    <verse number="3" style="v"/>sa tān pratyāvadata, dāyūd tatsaṅginaśca bubhukṣitāḥ santō yat karmmākurvvan tat kiṁ yuṣmābhi rnāpāṭhi?</para>
  <para style="p">
    <verse number="4" style="v"/>yē darśanīyāḥ pūpāḥ yājakān vinā tasya tatsaṅgimanujānāñcābhōjanīyāsta īśvarāvāsaṁ praviṣṭēna tēna bhuktāḥ|</para>
  <para style="p">
    <verse number="5" style="v"/>anyacca viśrāmavārē madhyēmandiraṁ viśrāmavārīyaṁ niyamaṁ laṅvantōpi yājakā nirdōṣā bhavanti, śāstramadhyē kimidamapi yuṣmābhi rna paṭhitaṁ?</para>
  <para style="p">
    <verse number="6" style="v"/>yuṣmānahaṁ vadāmi, atra sthānē mandirādapi garīyān ēka āstē|</para>
  <para style="p">
    <verse number="7" style="v"/>kintu dayāyāṁ mē yathā prīti rna tathā yajñakarmmaṇi| ētadvacanasyārthaṁ yadi yuyam ajñāsiṣṭa tarhi nirdōṣān dōṣiṇō nākārṣṭa|</para>
  <para style="p">
    <verse number="8" style="v"/>anyacca manujasutō viśrāmavārasyāpi patirāstē|</para>
  <para style="p">
    <verse number="9" style="v"/>anantaraṁ sa tatsthānāt prasthāya tēṣāṁ bhajanabhavanaṁ praviṣṭavān, tadānīm ēkaḥ śuṣkakarāmayavān upasthitavān|</para>
  <para style="p">
    <verse number="10" style="v"/>tatō yīśum apavadituṁ mānuṣāḥ papracchuḥ, viśrāmavārē nirāmayatvaṁ karaṇīyaṁ na vā?</para>
  <para style="p">
    <verse number="11" style="v"/>tēna sa pratyuvāca, viśrāmavārē yadi kasyacid avi rgarttē patati, tarhi yastaṁ ghr̥tvā na tōlayati, ētādr̥śō manujō yuṣmākaṁ madhyē ka āstē?</para>
  <para style="p">
    <verse number="12" style="v"/>avē rmānavaḥ kiṁ nahi śrēyān? atō viśrāmavārē hitakarmma karttavyaṁ|</para>
  <para style="p">
    <verse number="13" style="v"/>anantaraṁ sa taṁ mānavaṁ gaditavān, karaṁ prasāraya; tēna karē prasāritē sōnyakaravat svasthō'bhavat|</para>
  <para style="p">
    <verse number="14" style="v"/>tadā phirūśinō bahirbhūya kathaṁ taṁ haniṣyāma iti kumantraṇāṁ tatprātikūlyēna cakruḥ|</para>
  <para style="p">
    <verse number="15" style="v"/>tatō yīśustad viditvā sthanāntaraṁ gatavān; anyēṣu bahunarēṣu tatpaścād gatēṣu tān sa nirāmayān kr̥tvā ityājñāpayat,</para>
  <para style="p">
    <verse number="16" style="v"/>yūyaṁ māṁ na paricāyayata|</para>
  <para style="p">
    <verse number="17" style="v"/>tasmāt mama prīyō manōnītō manasastuṣṭikārakaḥ| madīyaḥ sēvakō yastu vidyatē taṁ samīkṣatāṁ| tasyōpari svakīyātmā mayā saṁsthāpayiṣyatē| tēnānyadēśajātēṣu vyavasthā saṁprakāśyatē|</para>
  <para style="p">
    <verse number="18" style="v"/>kēnāpi na virōdhaṁ sa vivādañca kariṣyati| na ca rājapathē tēna vacanaṁ śrāvayiṣyatē|</para>
  <para style="p">
    <verse number="19" style="v"/>vyavasthā calitā yāvat nahi tēna kariṣyatē| tāvat nalō vidīrṇō'pi bhaṁkṣyatē nahi tēna ca| tathā sadhūmavarttiñca na sa nirvvāpayiṣyatē|</para>
  <para style="p">
    <verse number="20" style="v"/>pratyāśāñca kariṣyanti tannāmni bhinnadēśajāḥ|</para>
  <para style="p">
    <verse number="21" style="v"/>yānyētāni vacanāni yiśayiyabhaviṣyadvādinā prōktānyāsan, tāni saphalānyabhavan|</para>
  <para style="p">
    <verse number="22" style="v"/>anantaraṁ lōkai statsamīpam ānītō bhūtagrastāndhamūkaikamanujastēna svasthīkr̥taḥ, tataḥ sō'ndhō mūkō draṣṭuṁ vaktuñcārabdhavān|</para>
  <para style="p">
    <verse number="23" style="v"/>anēna sarvvē vismitāḥ kathayāñcakruḥ, ēṣaḥ kiṁ dāyūdaḥ santānō nahi?</para>
  <para style="p">
    <verse number="24" style="v"/>kintu phirūśinastat śrutvā gaditavantaḥ, bālsibūbnāmnō bhūtarājasya sāhāyyaṁ vinā nāyaṁ bhūtān tyājayati|</para>
  <para style="p">
    <verse number="25" style="v"/>tadānīṁ yīśustēṣām iti mānasaṁ vijñāya tān avadat kiñcana rājyaṁ yadi svavipakṣād bhidyatē, tarhi tat ucchidyatē; yacca kiñcana nagaraṁ vā gr̥haṁ svavipakṣād vibhidyatē, tat sthātuṁ na śaknōti|</para>
  <para style="p">
    <verse number="26" style="v"/>tadvat śayatānō yadi śayatānaṁ bahiḥ kr̥tvā svavipakṣāt pr̥thak pr̥thak bhavati, tarhi tasya rājyaṁ kēna prakārēṇa sthāsyati?</para>
  <para style="p">
    <verse number="27" style="v"/>ahañca yadi bālsibūbā bhūtān tyājayāmi, tarhi yuṣmākaṁ santānāḥ kēna bhūtān tyājayanti? tasmād yuṣmākam ētadvicārayitārasta ēva bhaviṣyanti|</para>
  <para style="p">
    <verse number="28" style="v"/>kintavahaṁ yadīśvarātmanā bhūtān tyājayāmi, tarhīśvarasya rājyaṁ yuṣmākaṁ sannidhimāgatavat|</para>
  <para style="p">
    <verse number="29" style="v"/>anyañca kōpi balavanta janaṁ prathamatō na badvvā kēna prakārēṇa tasya gr̥haṁ praviśya taddravyādi lōṭhayituṁ śaknōti? kintu tat kr̥tvā tadīyagr̥sya dravyādi lōṭhayituṁ śaknōti|</para>
  <para style="p">
    <verse number="30" style="v"/>yaḥ kaścit mama svapakṣīyō nahi sa vipakṣīya āstē, yaśca mayā sākaṁ na saṁgr̥hlāti, sa vikirati|</para>
  <para style="p">
    <verse number="31" style="v"/>ataēva yuṣmānahaṁ vadāmi, manujānāṁ sarvvaprakārapāpānāṁ nindāyāśca marṣaṇaṁ bhavituṁ śaknōti, kintu pavitrasyātmanō viruddhanindāyā marṣaṇaṁ bhavituṁ na śaknōti|</para>
  <para style="p">
    <verse number="32" style="v"/>yō manujasutasya viruddhāṁ kathāṁ kathayati, tasyāparādhasya kṣamā bhavituṁ śaknōti, kintu yaḥ kaścit pavitrasyātmanō viruddhāṁ kathāṁ kathayati nēhalōkē na prētya tasyāparādhasya kṣamā bhavituṁ śaknōti|</para>
  <para style="p">
    <verse number="33" style="v"/>pādapaṁ yadi bhadraṁ vadatha, tarhi tasya phalamapi sādhu vaktavyaṁ, yadi ca pādapaṁ asādhuṁ vadatha, tarhi tasya phalamapyasādhu vaktavyaṁ; yataḥ svīyasvīyaphalēna pādapaḥ paricīyatē|</para>
  <para style="p">
    <verse number="34" style="v"/>rē bhujagavaṁśā yūyamasādhavaḥ santaḥ kathaṁ sādhu vākyaṁ vaktuṁ śakṣyatha? yasmād antaḥkaraṇasya pūrṇabhāvānusārād vadanād vacō nirgacchati|</para>
  <para style="p">
    <verse number="35" style="v"/>tēna sādhurmānavō'ntaḥkaraṇarūpāt sādhubhāṇḍāgārāt sādhu dravyaṁ nirgamayati, asādhurmānuṣastvasādhubhāṇḍāgārād asādhuvastūni nirgamayati|</para>
  <para style="p">
    <verse number="36" style="v"/>kintvahaṁ yuṣmān vadāmi, manujā yāvantyālasyavacāṁsi vadanti, vicāradinē taduttaramavaśyaṁ dātavyaṁ,</para>
  <para style="p">
    <verse number="37" style="v"/>yatastvaṁ svīyavacōbhi rniraparādhaḥ svīyavacōbhiśca sāparādhō gaṇiṣyasē|</para>
  <para style="p">
    <verse number="38" style="v"/>tadānīṁ katipayā upādhyāyāḥ phirūśinaśca jagaduḥ, hē gurō vayaṁ bhavattaḥ kiñcana lakṣma didr̥kṣāmaḥ|</para>
  <para style="p">
    <verse number="39" style="v"/>tadā sa pratyuktavān, duṣṭō vyabhicārī ca vaṁśō lakṣma mr̥gayatē, kintu bhaviṣyadvādinō yūnasō lakṣma vihāyānyat kimapi lakṣma tē na pradarśayiṣyantē|</para>
  <para style="p">
    <verse number="40" style="v"/>yatō yūnam yathā tryahōrātraṁ br̥hanmīnasya kukṣāvāsīt, tathā manujaputrōpi tryahōrātraṁ mēdinyā madhyē sthāsyati|</para>
  <para style="p">
    <verse number="41" style="v"/>aparaṁ nīnivīyā mānavā vicāradina ētadvaṁśīyānāṁ pratikūlam utthāya tān dōṣiṇaḥ kariṣyanti, yasmāttē yūnasa upadēśāt manāṁsi parāvarttayāñcakrirē, kintvatra yūnasōpi gurutara ēka āstē|</para>
  <para style="p">
    <verse number="42" style="v"/>punaśca dakṣiṇadēśīyā rājñī vicāradina ētadvaṁśīyānāṁ pratikūlamutthāya tān dōṣiṇaḥ kariṣyati yataḥ sā rājñī sulēmanō vidyāyāḥ kathāṁ śrōtuṁ mēdinyāḥ sīmna āgacchat, kintu sulēmanōpi gurutara ēkō janō'tra āstē|</para>
  <para style="p">
    <verse number="43" style="v"/>aparaṁ manujād bahirgatō 'pavitrabhūtaḥ śuṣkasthānēna gatvā viśrāmaṁ gavēṣayati, kintu tadalabhamānaḥ sa vakti, yasmā; nikētanād āgamaṁ, tadēva vēśma pakāvr̥tya yāmi|</para>
  <para style="p">
    <verse number="44" style="v"/>paścāt sa tat sthānam upasthāya tat śūnyaṁ mārjjitaṁ śōbhitañca vilōkya vrajan svatōpi duṣṭatarān anyasaptabhūtān saṅginaḥ karōti|</para>
  <para style="p">
    <verse number="45" style="v"/>tatastē tat sthānaṁ praviśya nivasanti, tēna tasya manujasya śēṣadaśā pūrvvadaśātōtīvāśubhā bhavati, ētēṣāṁ duṣṭavaṁśyānāmapi tathaiva ghaṭiṣyatē|</para>
  <para style="p">
    <verse number="46" style="v"/>mānavēbhya ētāsāṁ kathanāṁ kathanakālē tasya mātā sahajāśca tēna sākaṁ kāñcit kathāṁ kathayituṁ vāñchantō bahirēva sthitavantaḥ|</para>
  <para style="p">
    <verse number="47" style="v"/>tataḥ kaścit tasmai kathitavān, paśya tava jananī sahajāśca tvayā sākaṁ kāñcana kathāṁ kathayituṁ kāmayamānā bahistiṣṭhanti|</para>
  <para style="p">
    <verse number="48" style="v"/>kintu sa taṁ pratyavadat, mama kā jananī? kē vā mama sahajāḥ?</para>
  <para style="p">
    <verse number="49" style="v"/>paścāt śiṣyān prati karaṁ prasāryya kathitavān, paśya mama jananī mama sahajāścaitē;</para>
  <para style="p">
    <verse number="50" style="v"/>yaḥ kaścit mama svargasthasya pituriṣṭaṁ karmma kurutē, saēva mama bhrātā bhaginī jananī ca|</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>aparañca tasmin dinē yīśuḥ sadmanō gatvā saritpatē rōdhasi samupavivēśa|</para>
  <para style="p">
    <verse number="2" style="v"/>tatra tatsannidhau bahujanānāṁ nivahōpasthitēḥ sa taraṇimāruhya samupāviśat, tēna mānavā rōdhasi sthitavantaḥ|</para>
  <para style="p">
    <verse number="3" style="v"/>tadānīṁ sa dr̥ṣṭāntaistān itthaṁ bahuśa upadiṣṭavān| paśyata, kaścit kr̥ṣīvalō bījāni vaptuṁ bahirjagāma,</para>
  <para style="p">
    <verse number="4" style="v"/>tasya vapanakālē katipayabījēṣu mārgapārśvē patitēṣu vihagāstāni bhakṣitavantaḥ|</para>
  <para style="p">
    <verse number="5" style="v"/>aparaṁ katipayabījēṣu stōkamr̥dyuktapāṣāṇē patitēṣu mr̥dalpatvāt tatkṣaṇāt tānyaṅkuritāni,</para>
  <para style="p">
    <verse number="6" style="v"/>kintu ravāvuditē dagdhāni tēṣāṁ mūlāpraviṣṭatvāt śuṣkatāṁ gatāni ca|</para>
  <para style="p">
    <verse number="7" style="v"/>aparaṁ katipayabījēṣu kaṇṭakānāṁ madhyē patitēṣu kaṇṭakānyēdhitvā tāni jagrasuḥ|</para>
  <para style="p">
    <verse number="8" style="v"/>aparañca katipayabījāni urvvarāyāṁ patitāni; tēṣāṁ madhyē kānicit śataguṇāni kānicit ṣaṣṭiguṇāni kānicit triṁśaguṁṇāni phalāni phalitavanti|</para>
  <para style="p">
    <verse number="9" style="v"/>śrōtuṁ yasya śrutī āsātē sa śr̥ṇuyāt|</para>
  <para style="p">
    <verse number="10" style="v"/>anantaraṁ śiṣyairāgatya sō'pr̥cchyata, bhavatā tēbhyaḥ kutō dr̥ṣṭāntakathā kathyatē?</para>
  <para style="p">
    <verse number="11" style="v"/>tataḥ sa pratyavadat, svargarājyasya nigūḍhāṁ kathāṁ vēdituṁ yuṣmabhyaṁ sāmarthyamadāyi, kintu tēbhyō nādāyi|</para>
  <para style="p">
    <verse number="12" style="v"/>yasmād yasyāntikē varddhatē, tasmāyēva dāyiṣyatē, tasmāt tasya bāhulyaṁ bhaviṣyati, kintu yasyāntikē na varddhatē, tasya yat kiñcanāstē, tadapi tasmād ādāyiṣyatē|</para>
  <para style="p">
    <verse number="13" style="v"/>tē paśyantōpi na paśyanti, śr̥ṇvantōpi na śr̥ṇvanti, budhyamānā api na budhyantē ca, tasmāt tēbhyō dr̥ṣṭāntakathā kathyatē|</para>
  <para style="p">
    <verse number="14" style="v"/>yathā karṇaiḥ śrōṣyatha yūyaṁ vai kintu yūyaṁ na bhōtsyatha| nētrairdrakṣyatha yūyañca parijñātuṁ na śakṣyatha| tē mānuṣā yathā naiva paripaśyanti lōcanaiḥ| karṇai ryathā na śr̥ṇvanti na budhyantē ca mānasaiḥ| vyāvarttitēṣu cittēṣu kālē kutrāpi tairjanaiḥ| mattastē manujāḥ svasthā yathā naiva bhavanti ca| tathā tēṣāṁ manuṣyāṇāṁ kriyantē sthūlabuddhayaḥ| badhirībhūtakarṇāśca jātāśca mudritā dr̥śaḥ|</para>
  <para style="p">
    <verse number="15" style="v"/>yadētāni vacanāni yiśayiyabhaviṣyadvādinā prōktāni tēṣu tāni phalanti|</para>
  <para style="p">
    <verse number="16" style="v"/>kintu yuṣmākaṁ nayanāni dhanyāni, yasmāt tāni vīkṣantē; dhanyāśca yuṣmākaṁ śabdagrahāḥ, yasmāt tairākarṇyatē|</para>
  <para style="p">
    <verse number="17" style="v"/>mayā yūyaṁ tathyaṁ vacāmi yuṣmābhi ryadyad vīkṣyatē, tad bahavō bhaviṣyadvādinō dhārmmikāśca mānavā didr̥kṣantōpi draṣṭuṁ nālabhanta, punaśca yūyaṁ yadyat śr̥ṇutha, tat tē śuśrūṣamāṇā api śrōtuṁ nālabhanta|</para>
  <para style="p">
    <verse number="18" style="v"/>kr̥ṣīvalīyadr̥ṣṭāntasyārthaṁ śr̥ṇuta|</para>
  <para style="p">
    <verse number="19" style="v"/>mārgapārśvē bījānyuptāni tasyārtha ēṣaḥ, yadā kaścit rājyasya kathāṁ niśamya na budhyatē, tadā pāpātmāgatya tadīyamanasa uptāṁ kathāṁ haran nayati|</para>
  <para style="p">
    <verse number="20" style="v"/>aparaṁ pāṣāṇasthalē bījānyuptāni tasyārtha ēṣaḥ; kaścit kathāṁ śrutvaiva harṣacittēna gr̥hlāti,</para>
  <para style="p">
    <verse number="21" style="v"/>kintu tasya manasi mūlāpraviṣṭatvāt sa kiñcitkālamātraṁ sthirastiṣṭhati; paścāta tatkathākāraṇāt kōpi klēstāḍanā vā cēt jāyatē, tarhi sa tatkṣaṇād vighnamēti|</para>
  <para style="p">
    <verse number="22" style="v"/>aparaṁ kaṇṭakānāṁ madhyē bījānyuptāni tadartha ēṣaḥ; kēnacit kathāyāṁ śrutāyāṁ sāṁsārikacintābhi rbhrāntibhiśca sā grasyatē, tēna sā mā viphalā bhavati|</para>
  <para style="p">
    <verse number="23" style="v"/>aparam urvvarāyāṁ bījānyuptāni tadartha ēṣaḥ; yē tāṁ kathāṁ śrutvā vudhyantē, tē phalitāḥ santaḥ kēcit śataguṇāni kēcita ṣaṣṭiguṇāni kēcicca triṁśadguṇāni phalāni janayanti|</para>
  <para style="p">
    <verse number="24" style="v"/>anantaraṁ sōparāmēkāṁ dr̥ṣṭāntakathāmupasthāpya tēbhyaḥ kathayāmāsa; svargīyarājyaṁ tādr̥śēna kēnacid gr̥hasthēnōpamīyatē, yēna svīyakṣētrē praśastabījānyaupyanta|</para>
  <para style="p">
    <verse number="25" style="v"/>kintu kṣaṇadāyāṁ sakalalōkēṣu suptēṣu tasya ripurāgatya tēṣāṁ gōdhūmabījānāṁ madhyē vanyayavamabījānyuptvā vavrāja|</para>
  <para style="p">
    <verse number="26" style="v"/>tatō yadā bījēbhyō'ṅkarā jāyamānāḥ kaṇiśāni ghr̥tavantaḥ; tadā vanyayavasānyapi dr̥śyamānānyabhavan|</para>
  <para style="p">
    <verse number="27" style="v"/>tatō gr̥hasthasya dāsēyā āgamya tasmai kathayāñcakruḥ, hē mahēccha, bhavatā kiṁ kṣētrē bhadrabījāni naupyanta? tathātvē vanyayavasāni kr̥ta āyan?</para>
  <para style="p">
    <verse number="28" style="v"/>tadānīṁ tēna tē pratigaditāḥ, kēnacit ripuṇā karmmadamakāri| dāsēyāḥ kathayāmāsuḥ, vayaṁ gatvā tānyutpāyya kṣipāmō bhavataḥ kīdr̥śīcchā jāyatē?</para>
  <para style="p">
    <verse number="29" style="v"/>tēnāvādi, nahi, śaṅkē'haṁ vanyayavasōtpāṭanakālē yuṣmābhistaiḥ sākaṁ gōdhūmā apyutpāṭiṣyantē|</para>
  <para style="p">
    <verse number="30" style="v"/>ataḥ śsyakarttanakālaṁ yāvad ubhayānyapi saha varddhantāṁ, paścāt karttanakālē karttakān vakṣyāmi, yūyamādau vanyayavasāni saṁgr̥hya dāhayituṁ vīṭikā badvvā sthāpayata; kintu sarvvē gōdhūmā yuṣmābhi rbhāṇḍāgāraṁ nītvā sthāpyantām|</para>
  <para style="p">
    <verse number="31" style="v"/>anantaraṁ sōparāmēkāṁ dr̥ṣṭāntakathāmutthāpya tēbhyaḥ kathitavān kaścinmanujaḥ sarṣapabījamēkaṁ nītvā svakṣētra uvāpa|</para>
  <para style="p">
    <verse number="32" style="v"/>sarṣapabījaṁ sarvvasmād bījāt kṣudramapi sadaṅkuritaṁ sarvvasmāt śākāt br̥had bhavati; sa tādr̥śastaru rbhavati, yasya śākhāsu nabhasaḥ khagā āgatya nivasanti; svargīyarājyaṁ tādr̥śasya sarṣapaikasya samam|</para>
  <para style="p">
    <verse number="33" style="v"/>punarapi sa upamākathāmēkāṁ tēbhyaḥ kathayāñcakāra; kācana yōṣit yat kiṇvamādāya drōṇatrayamitagōdhūmacūrṇānāṁ madhyē sarvvēṣāṁ miśrībhavanaparyyantaṁ samācchādya nidhattavatī, tatkiṇvamiva svargarājyaṁ|</para>
  <para style="p">
    <verse number="34" style="v"/>itthaṁ yīśu rmanujanivahānāṁ sannidhāvupamākathābhirētānyākhyānāni kathitavān upamāṁ vinā tēbhyaḥ kimapi kathāṁ nākathayat|</para>
  <para style="p">
    <verse number="35" style="v"/>ētēna dr̥ṣṭāntīyēna vākyēna vyādāya vadanaṁ nijaṁ| ahaṁ prakāśayiṣyāmi guptavākyaṁ purābhavaṁ| yadētadvacanaṁ bhaviṣyadvādinā prōktamāsīt, tat siddhamabhavat|</para>
  <para style="p">
    <verse number="36" style="v"/>sarvvān manujān visr̥jya yīśau gr̥haṁ praviṣṭē tacchiṣyā āgatya yīśavē kathitavantaḥ, kṣētrasya vanyayavasīyadr̥ṣṭāntakathām bhavāna asmān spaṣṭīkr̥tya vadatu|</para>
  <para style="p">
    <verse number="37" style="v"/>tataḥ sa pratyuvāca, yēna bhadrabījānyupyantē sa manujaputraḥ,</para>
  <para style="p">
    <verse number="38" style="v"/>kṣētraṁ jagat, bhadrabījānī rājyasya santānāḥ,</para>
  <para style="p">
    <verse number="39" style="v"/>vanyayavasāni pāpātmanaḥ santānāḥ| yēna ripuṇā tānyuptāni sa śayatānaḥ, karttanasamayaśca jagataḥ śēṣaḥ, karttakāḥ svargīyadūtāḥ|</para>
  <para style="p">
    <verse number="40" style="v"/>yathā vanyayavasāni saṁgr̥hya dāhyantē, tathā jagataḥ śēṣē bhaviṣyati;</para>
  <para style="p">
    <verse number="41" style="v"/>arthāt manujasutaḥ svāṁyadūtān prēṣayiṣyati, tēna tē ca tasya rājyāt sarvvān vighnakāriṇō'dhārmmikalōkāṁśca saṁgr̥hya</para>
  <para style="p">
    <verse number="42" style="v"/>yatra rōdanaṁ dantagharṣaṇañca bhavati, tatrāgnikuṇḍē nikṣēpsyanti|</para>
  <para style="p">
    <verse number="43" style="v"/>tadānīṁ dhārmmikalōkāḥ svēṣāṁ pitū rājyē bhāskara̮iva tējasvinō bhaviṣyanti| śrōtuṁ yasya śrutī āsātē, ma śr̥ṇuyāt|</para>
  <para style="p">
    <verse number="44" style="v"/>aparañca kṣētramadhyē nidhiṁ paśyan yō gōpayati, tataḥ paraṁ sānandō gatvā svīyasarvvasvaṁ vikrīya ttakṣētraṁ krīṇāti, sa iva svargarājyaṁ|</para>
  <para style="p">
    <verse number="45" style="v"/>anyañca yō vaṇik uttamāṁ muktāṁ gavēṣayan</para>
  <para style="p">
    <verse number="46" style="v"/>mahārghāṁ muktāṁ vilōkya nijasarvvasvaṁ vikrīya tāṁ krīṇāti, sa iva svargarājyaṁ|</para>
  <para style="p">
    <verse number="47" style="v"/>punaśca samudrō nikṣiptaḥ sarvvaprakāramīnasaṁgrāhyānāya̮iva svargarājyaṁ|</para>
  <para style="p">
    <verse number="48" style="v"/>tasmin ānāyē pūrṇē janā yathā rōdhasyuttōlya samupaviśya praśastamīnān saṁgrahya bhājanēṣu nidadhatē, kutsitān nikṣipanti;</para>
  <para style="p">
    <verse number="49" style="v"/>tathaiva jagataḥ śēṣē bhaviṣyati, phalataḥ svargīyadūtā āgatya puṇyavajjanānāṁ madhyāt pāpinaḥ pr̥thak kr̥tvā vahnikuṇḍē nikṣēpsyanti,</para>
  <para style="p">
    <verse number="50" style="v"/>tatra rōdanaṁ dantai rdantagharṣaṇañca bhaviṣyataḥ|</para>
  <para style="p">
    <verse number="51" style="v"/>yīśunā tē pr̥ṣṭā yuṣmābhiḥ kimētānyākhyānānyabudhyanta? tadā tē pratyavadan, satyaṁ prabhō|</para>
  <para style="p">
    <verse number="52" style="v"/>tadānīṁ sa kathitavān, nijabhāṇḍāgārāt navīnapurātanāni vastūni nirgamayati yō gr̥hasthaḥ sa iva svargarājyamadhi śikṣitāḥ svarva upadēṣṭāraḥ|</para>
  <para style="p">
    <verse number="53" style="v"/>anantaraṁ yīśurētāḥ sarvvā dr̥ṣṭāntakathāḥ samāpya tasmāt sthānāt pratasthē| aparaṁ svadēśamāgatya janān bhajanabhavana upadiṣṭavān;</para>
  <para style="p">
    <verse number="54" style="v"/>tē vismayaṁ gatvā kathitavanta ētasyaitādr̥śaṁ jñānam āścaryyaṁ karmma ca kasmād ajāyata?</para>
  <para style="p">
    <verse number="55" style="v"/>kimayaṁ sūtradhārasya putrō nahi? ētasya mātu rnāma ca kiṁ mariyam nahi? yākub-yūṣaph-śimōn-yihūdāśca kimētasya bhrātarō nahi?</para>
  <para style="p">
    <verse number="56" style="v"/>ētasya bhaginyaśca kimasmākaṁ madhyē na santi? tarhi kasmādayamētāni labdhavān? itthaṁ sa tēṣāṁ vighnarūpō babhūva;</para>
  <para style="p">
    <verse number="57" style="v"/>tatō yīśunā nigaditaṁ svadēśīyajanānāṁ madhyaṁ vinā bhaviṣyadvādī kutrāpyanyatra nāsammānyō bhavatī|</para>
  <para style="p">
    <verse number="58" style="v"/>tēṣāmaviśvāsahētōḥ sa tatra sthānē bahvāścaryyakarmmāṇi na kr̥tavān|</para>
  <chapter number="14" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tadānīṁ rājā hērōd yīśō ryaśaḥ śrutvā nijadāsēyān jagād,</para>
  <para style="p">
    <verse number="2" style="v"/>ēṣa majjayitā yōhan, pramitēbhayastasyōtthānāt tēnētthamadbhutaṁ karmma prakāśyatē|</para>
  <para style="p">
    <verse number="3" style="v"/>purā hērōd nijabhrātu: philipō jāyāyā hērōdīyāyā anurōdhād yōhanaṁ dhārayitvā baddhā kārāyāṁ sthāpitavān|</para>
  <para style="p">
    <verse number="4" style="v"/>yatō yōhan uktavān, ētsayāḥ saṁgrahō bhavatō nōcitaḥ|</para>
  <para style="p">
    <verse number="5" style="v"/>tasmāt nr̥patistaṁ hantumicchannapi lōkēbhyō vibhayāñcakāra; yataḥ sarvvē yōhanaṁ bhaviṣyadvādinaṁ mēnirē|</para>
  <para style="p">
    <verse number="6" style="v"/>kintu hērōdō janmāhīyamaha upasthitē hērōdīyāyā duhitā tēṣāṁ samakṣaṁ nr̥titvā hērōdamaprīṇyat|</para>
  <para style="p">
    <verse number="7" style="v"/>tasmāt bhūpatiḥ śapathaṁ kurvvan iti pratyajñāsīt, tvayā yad yācyatē, tadēvāhaṁ dāsyāmi|</para>
  <para style="p">
    <verse number="8" style="v"/>sā kumārī svīyamātuḥ śikṣāṁ labdhā babhāṣē, majjayituryōhana uttamāṅgaṁ bhājanē samānīya mahyaṁ viśrāṇaya|</para>
  <para style="p">
    <verse number="9" style="v"/>tatō rājā śuśōca, kintu bhōjanāyōpaviśatāṁ saṅgināṁ svakr̥taśapathasya cānurōdhāt tat pradātuma ādidēśa|</para>
  <para style="p">
    <verse number="10" style="v"/>paścāt kārāṁ prati naraṁ prahitya yōhana uttamāṅgaṁ chittvā</para>
  <para style="p">
    <verse number="11" style="v"/>tat bhājana ānāyya tasyai kumāryyai vyaśrāṇayat, tataḥ sā svajananyāḥ samīpaṁ tannināya|</para>
  <para style="p">
    <verse number="12" style="v"/>paścāt yōhanaḥ śiṣyā āgatya kāyaṁ nītvā śmaśānē sthāpayāmāsustatō yīśōḥ sannidhiṁ vrajitvā tadvārttāṁ babhāṣirē|</para>
  <para style="p">
    <verse number="13" style="v"/>anantaraṁ yīśuriti niśabhya nāvā nirjanasthānam ēkākī gatavān, paścāt mānavāstat śrutvā nānānagarēbhya āgatya padaistatpaścād īyuḥ|</para>
  <para style="p">
    <verse number="14" style="v"/>tadānīṁ yīśu rbahirāgatya mahāntaṁ jananivahaṁ nirīkṣya tēṣu kāruṇikaḥ man tēṣāṁ pīḍitajanān nirāmayān cakāra|</para>
  <para style="p">
    <verse number="15" style="v"/>tataḥ paraṁ sandhyāyāṁ śiṣyāstadantikamāgatya kathayāñcakruḥ, idaṁ nirjanasthānaṁ vēlāpyavasannā; tasmāt manujān svasvagrāmaṁ gantuṁ svārthaṁ bhakṣyāṇi krētuñca bhavān tān visr̥jatu|</para>
  <para style="p">
    <verse number="16" style="v"/>kintu yīśustānavādīt, tēṣāṁ gamanē prayōjanaṁ nāsti, yūyamēva tān bhōjayata|</para>
  <para style="p">
    <verse number="17" style="v"/>tadā tē pratyavadan, asmākamatra pūpapañcakaṁ mīnadvayañcāstē|</para>
  <para style="p">
    <verse number="18" style="v"/>tadānīṁ tēnōktaṁ tāni madantikamānayata|</para>
  <para style="p">
    <verse number="19" style="v"/>anantaraṁ sa manujān yavasōparyyupavēṣṭum ājñāpayāmāsa; apara tat pūpapañcakaṁ mīnadvayañca gr̥hlan svargaṁ prati nirīkṣyēśvarīyaguṇān anūdya bhaṁktvā śiṣyēbhyō dattavān, śiṣyāśca lōkēbhyō daduḥ|</para>
  <para style="p">
    <verse number="20" style="v"/>tataḥ sarvvē bhuktvā paritr̥ptavantaḥ, tatastadavaśiṣṭabhakṣyaiḥ pūrṇān dvādaśaḍalakān gr̥hītavantaḥ|</para>
  <para style="p">
    <verse number="21" style="v"/>tē bhōktāraḥ strīrbālakāṁśca vihāya prāyēṇa pañca sahasrāṇi pumāṁsa āsan|</para>
  <para style="p">
    <verse number="22" style="v"/>tadanantaraṁ yīśu rlōkānāṁ visarjanakālē śiṣyān taraṇimārōḍhuṁ svāgrē pāraṁ yātuñca gāḍhamādiṣṭavān|</para>
  <para style="p">
    <verse number="23" style="v"/>tatō lōkēṣu visr̥ṣṭēṣu sa viviktē prārthayituṁ girimēkaṁ gatvā sandhyāṁ yāvat tatraikākī sthitavān|</para>
  <para style="p">
    <verse number="24" style="v"/>kintu tadānīṁ sammukhavātatvāt saritpatē rmadhyē taraṅgaistaraṇirdōlāyamānābhavat|</para>
  <para style="p">
    <verse number="25" style="v"/>tadā sa yāminyāścaturthapraharē padbhyāṁ vrajan tēṣāmantikaṁ gatavān|</para>
  <para style="p">
    <verse number="26" style="v"/>kintu śiṣyāstaṁ sāgarōpari vrajantaṁ vilōkya samudvignā jagaduḥ, ēṣa bhūta iti śaṅkamānā uccaiḥ śabdāyāñcakrirē ca|</para>
  <para style="p">
    <verse number="27" style="v"/>tadaiva yīśustānavadat, susthirā bhavata, mā bhaiṣṭa, ēṣō'ham|</para>
  <para style="p">
    <verse number="28" style="v"/>tataḥ pitara ityuktavān, hē prabhō, yadi bhavānēva, tarhi māṁ bhavatsamīpaṁ yātumājñāpayatu|</para>
  <para style="p">
    <verse number="29" style="v"/>tataḥ tēnādiṣṭaḥ pitarastaraṇitō'varuhya yīśēाrantikaṁ prāptuṁ tōyōpari vavrāja|</para>
  <para style="p">
    <verse number="30" style="v"/>kintu pracaṇḍaṁ pavanaṁ vilōkya bhayāt tōyē maṁktum ārēbhē, tasmād uccaiḥ śabdāyamānaḥ kathitavān, hē prabhō, māmavatu|</para>
  <para style="p">
    <verse number="31" style="v"/>yīśustatkṣaṇāt karaṁ prasāryya taṁ dharan uktavān, ha stōkapratyayin tvaṁ kutaḥ samaśēthāḥ?</para>
  <para style="p">
    <verse number="32" style="v"/>anantaraṁ tayōstaraṇimārūḍhayōḥ pavanō nivavr̥tē|</para>
  <para style="p">
    <verse number="33" style="v"/>tadānīṁ yē taraṇyāmāsan, ta āgatya taṁ praṇabhya kathitavantaḥ, yathārthastvamēvēśvarasutaḥ|</para>
  <para style="p">
    <verse number="34" style="v"/>anantaraṁ pāraṁ prāpya tē ginēṣarannāmakaṁ nagaramupatasthuḥ,</para>
  <para style="p">
    <verse number="35" style="v"/>tadā tatratyā janā yīśuṁ paricīya taddēśsya caturdiśō vārttāṁ prahitya yatra yāvantaḥ pīḍitā āsan, tāvataēva tadantikamānayāmāsuḥ|</para>
  <para style="p">
    <verse number="36" style="v"/>aparaṁ tadīyavasanasya granthimātraṁ spraṣṭuṁ vinīya yāvantō janāstat sparśaṁ cakrirē, tē sarvvaēva nirāmayā babhūvuḥ|</para>
  <chapter number="15" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>aparaṁ yirūśālamnagarīyāḥ katipayā adhyāpakāḥ phirūśinaśca yīśōḥ samīpamāgatya kathayāmāsuḥ,</para>
  <para style="p">
    <verse number="2" style="v"/>tava śiṣyāḥ kimartham aprakṣālitakarai rbhakṣitvā paramparāgataṁ prācīnānāṁ vyavahāraṁ laṅvantē?</para>
  <para style="p">
    <verse number="3" style="v"/>tatō yīśuḥ pratyuvāca, yūyaṁ paramparāgatācārēṇa kuta īśvarājñāṁ laṅvadhvē|</para>
  <para style="p">
    <verse number="4" style="v"/>īśvara ityājñāpayat, tvaṁ nijapitarau saṁmanyēthāḥ, yēna ca nijapitarau nindyētē, sa niścitaṁ mriyēta;</para>
  <para style="p">
    <verse number="5" style="v"/>kintu yūyaṁ vadatha, yaḥ svajanakaṁ svajananīṁ vā vākyamidaṁ vadati, yuvāṁ mattō yallabhēthē, tat nyavidyata,</para>
  <para style="p">
    <verse number="6" style="v"/>sa nijapitarau puna rna saṁmaṁsyatē| itthaṁ yūyaṁ paramparāgatēna svēṣāmācārēṇēśvarīyājñāṁ lumpatha|</para>
  <para style="p">
    <verse number="7" style="v"/>rē kapaṭinaḥ sarvvē yiśayiyō yuṣmānadhi bhaviṣyadvacanānyētāni samyag uktavān|</para>
  <para style="p">
    <verse number="8" style="v"/>vadanai rmanujā ētē samāyānti madantikaṁ| tathādharai rmadīyañca mānaṁ kurvvanti tē narāḥ|</para>
  <para style="p">
    <verse number="9" style="v"/>kintu tēṣāṁ manō mattō vidūraēva tiṣṭhati| śikṣayantō vidhīn nrājñā bhajantē māṁ mudhaiva tē|</para>
  <para style="p">
    <verse number="10" style="v"/>tatō yīśu rlōkān āhūya prōktavān, yūyaṁ śrutvā budhyadhbaṁ|</para>
  <para style="p">
    <verse number="11" style="v"/>yanmukhaṁ praviśati, tat manujam amēdhyaṁ na karōti, kintu yadāsyāt nirgacchati, tadēva mānuṣamamēdhyī karōtī|</para>
  <para style="p">
    <verse number="12" style="v"/>tadānīṁ śiṣyā āgatya tasmai kathayāñcakruḥ, ētāṁ kathāṁ śrutvā phirūśinō vyarajyanta, tat kiṁ bhavatā jñāyatē?</para>
  <para style="p">
    <verse number="13" style="v"/>sa pratyavadat, mama svargasthaḥ pitā yaṁ kañcidaṅkuraṁ nārōpayat, sa utpāvdyatē|</para>
  <para style="p">
    <verse number="14" style="v"/>tē tiṣṭhantu, tē andhamanujānām andhamārgadarśakā ēva; yadyandhō'ndhaṁ panthānaṁ darśayati, tarhyubhau garttē patataḥ|</para>
  <para style="p">
    <verse number="15" style="v"/>tadā pitarastaṁ pratyavadat, dr̥ṣṭāntamimamasmān bōdhayatu|</para>
  <para style="p">
    <verse number="16" style="v"/>yīśunā prōktaṁ, yūyamadya yāvat kimabōdhāḥ stha?</para>
  <para style="p">
    <verse number="17" style="v"/>kathāmimāṁ kiṁ na budhyadhbē ? yadāsyaṁ prēviśati, tad udarē patan bahirniryāti,</para>
  <para style="p">
    <verse number="18" style="v"/>kintvāsyād yanniryāti, tad antaḥkaraṇāt niryātatvāt manujamamēdhyaṁ karōti|</para>
  <para style="p">
    <verse number="19" style="v"/>yatō'ntaḥkaraṇāt kucintā badhaḥ pāradārikatā vēśyāgamanaṁ cairyyaṁ mithyāsākṣyam īśvaranindā caitāni sarvvāṇi niryyānti|</para>
  <para style="p">
    <verse number="20" style="v"/>ētāni manuṣyamapavitrī kurvvanti kintvaprakṣālitakarēṇa bhōjanaṁ manujamamēdhyaṁ na karōti|</para>
  <para style="p">
    <verse number="21" style="v"/>anantaraṁ yīśustasmāt sthānāt prasthāya sōrasīdōnnagarayōḥ sīmāmupatasyau|</para>
  <para style="p">
    <verse number="22" style="v"/>tadā tatsīmātaḥ kācit kinānīyā yōṣid āgatya tamuccairuvāca, hē prabhō dāyūdaḥ santāna, mamaikā duhitāstē sā bhūtagrastā satī mahāklēśaṁ prāpnōti mama dayasva|</para>
  <para style="p">
    <verse number="23" style="v"/>kintu yīśustāṁ kimapi nōktavān, tataḥ śiṣyā āgatya taṁ nivēdayāmāsuḥ, ēṣā yōṣid asmākaṁ paścād uccairāhūyāgacchati, ēnāṁ visr̥jatu|</para>
  <para style="p">
    <verse number="24" style="v"/>tadā sa pratyavadat, isrāyēlgōtrasya hāritamēṣān vinā kasyāpyanyasya samīpaṁ nāhaṁ prēṣitōsmi|</para>
  <para style="p">
    <verse number="25" style="v"/>tataḥ sā nārīsamāgatya taṁ praṇamya jagāda, hē prabhō māmupakuru|</para>
  <para style="p">
    <verse number="26" style="v"/>sa uktavān, bālakānāṁ bhakṣyamādāya sāramēyēbhyō dānaṁ nōcitaṁ|</para>
  <para style="p">
    <verse number="27" style="v"/>tadā sā babhāṣē, hē prabhō, tat satyaṁ, tathāpi prabhō rbhañcād yaducchiṣṭaṁ patati, tat sāramēyāḥ khādanti|</para>
  <para style="p">
    <verse number="28" style="v"/>tatō yīśuḥ pratyavadat, hē yōṣit, tava viśvāsō mahān tasmāt tava manōbhilaṣitaṁ sidyyatu, tēna tasyāḥ kanyā tasminnēva daṇḍē nirāmayābhavat|</para>
  <para style="p">
    <verse number="29" style="v"/>anantaraṁ yīśastasmāt sthānāt prasthāya gālīlsāgarasya sannidhimāgatya dharādharamāruhya tatrōpavivēśa|</para>
  <para style="p">
    <verse number="30" style="v"/>paścāt jananivahō bahūn khañcāndhamūkaśuṣkakaramānuṣān ādāya yīśōḥ samīpamāgatya taccaraṇāntikē sthāpayāmāsuḥ, tataḥ sā tān nirāmayān akarōt|</para>
  <para style="p">
    <verse number="31" style="v"/>itthaṁ mūkā vākyaṁ vadanti, śuṣkakarāḥ svāsthyamāyānti, paṅgavō gacchanti, andhā vīkṣantē, iti vilōkya lōkā vismayaṁ manyamānā isrāyēla īśvaraṁ dhanyaṁ babhāṣirē|</para>
  <para style="p">
    <verse number="32" style="v"/>tadānīṁ yīśuḥ svaśiṣyān āhūya gaditavān, ētajjananivahēṣu mama dayā jāyatē, ētē dinatrayaṁ mayā sākaṁ santi, ēṣāṁ bhakṣyavastu ca kañcidapi nāsti, tasmādahamētānakr̥tāhārān na visrakṣyāmi, tathātvē vartmamadhyē klāmyēṣuḥ|</para>
  <para style="p">
    <verse number="33" style="v"/>tadā śiṣyā ūcuḥ, ētasmin prāntaramadhya ētāvatō martyān tarpayituṁ vayaṁ kutra pūpān prāpsyāmaḥ?</para>
  <para style="p">
    <verse number="34" style="v"/>yīśurapr̥cchat, yuṣmākaṁ nikaṭē kati pūpā āsatē? ta ūcuḥ, saptapūpā alpāḥ kṣudramīnāśca santi|</para>
  <para style="p">
    <verse number="35" style="v"/>tadānīṁ sa lōkanivahaṁ bhūmāvupavēṣṭum ādiśya</para>
  <para style="p">
    <verse number="36" style="v"/>tān saptapūpān mīnāṁśca gr̥hlan īśvarīyaguṇān anūdya bhaṁktvā śiṣyēbhyō dadau, śiṣyā lōkēbhyō daduḥ|</para>
  <para style="p">
    <verse number="37" style="v"/>tataḥ sarvvē bhuktvā tr̥ptavantaḥ; tadavaśiṣṭabhakṣyēṇa saptaḍalakān paripūryya saṁjagr̥huḥ|</para>
  <para style="p">
    <verse number="38" style="v"/>tē bhōktārō yōṣitō bālakāṁśca vihāya prāyēṇa catuḥsahasrāṇi puruṣā āsan|</para>
  <para style="p">
    <verse number="39" style="v"/>tataḥ paraṁ sa jananivahaṁ visr̥jya tarimāruhya magdalāpradēśaṁ gatavān|</para>
  <chapter number="16" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tadānīṁ phirūśinaḥ sidūkinaścāgatya taṁ parīkṣituṁ nabhamīyaṁ kiñcana lakṣma darśayituṁ tasmai nivēdayāmāsuḥ|</para>
  <para style="p">
    <verse number="2" style="v"/>tataḥ sa uktavān, sandhyāyāṁ nabhasō raktatvād yūyaṁ vadatha, śvō nirmmalaṁ dinaṁ bhaviṣyati;</para>
  <para style="p">
    <verse number="3" style="v"/>prātaḥkālē ca nabhasō raktatvāt malinatvāñca vadatha, jhañbhśadya bhaviṣyati| hē kapaṭinō yadi yūyam antarīkṣasya lakṣma bōddhuṁ śaknutha, tarhi kālasyaitasya lakṣma kathaṁ bōddhuṁ na śaknutha?</para>
  <para style="p">
    <verse number="4" style="v"/>ētatkālasya duṣṭō vyabhicārī ca vaṁśō lakṣma gavēṣayati, kintu yūnasō bhaviṣyadvādinō lakṣma vinānyat kimapi lakṣma tān na darśayiyyatē| tadānīṁ sa tān vihāya pratasthē|</para>
  <para style="p">
    <verse number="5" style="v"/>anantaramanyapāragamanakālē tasya śiṣyāḥ pūpamānētuṁ vismr̥tavantaḥ|</para>
  <para style="p">
    <verse number="6" style="v"/>yīśustānavādīt, yūyaṁ phirūśināṁ sidūkināñca kiṇvaṁ prati sāvadhānāḥ satarkāśca bhavata|</para>
  <para style="p">
    <verse number="7" style="v"/>tēna tē parasparaṁ vivicya kathayitumārēbhirē, vayaṁ pūpānānētuṁ vismr̥tavanta ētatkāraṇād iti kathayati|</para>
  <para style="p">
    <verse number="8" style="v"/>kintu yīśustadvijñāya tānavōcat, hē stōkaviśvāsinō yūyaṁ pūpānānayanamadhi kutaḥ parasparamētad viviṁkya?</para>
  <para style="p">
    <verse number="9" style="v"/>yuṣmābhiḥ kimadyāpi na jñāyatē? pañcabhiḥ pūpaiḥ pañcasahasrapuruṣēṣu bhōjitēṣu bhakṣyōcchiṣṭapūrṇān kati ḍalakān samagr̥hlītaṁ;</para>
  <para style="p">
    <verse number="10" style="v"/>tathā saptabhiḥ pūpaiścatuḥsahasrapuruṣēṣu bhējitēṣu kati ḍalakān samagr̥hlīta, tat kiṁ yuṣmābhirna smaryyatē?</para>
  <para style="p">
    <verse number="11" style="v"/>tasmāt phirūśināṁ sidūkināñca kiṇvaṁ prati sāvadhānāstiṣṭhata, kathāmimām ahaṁ pūpānadhi nākathayaṁ, ētad yūyaṁ kutō na budhyadhvē?</para>
  <para style="p">
    <verse number="12" style="v"/>tadānīṁ pūpakiṇvaṁ prati sāvadhānāstiṣṭhatēti nōktvā phirūśināṁ sidūkināñca upadēśaṁ prati sāvadhānāstiṣṭhatēti kathitavān, iti tairabōdhi|</para>
  <para style="p">
    <verse number="13" style="v"/>aparañca yīśuḥ kaisariyā-philipipradēśamāgatya śiṣyān apr̥cchat, yō'haṁ manujasutaḥ sō'haṁ kaḥ? lōkairahaṁ kimucyē?</para>
  <para style="p">
    <verse number="14" style="v"/>tadānīṁ tē kathitavantaḥ, kēcid vadanti tvaṁ majjayitā yōhan, kēcidvadanti, tvam ēliyaḥ, kēcicca vadanti, tvaṁ yirimiyō vā kaścid bhaviṣyadvādīti|</para>
  <para style="p">
    <verse number="15" style="v"/>paścāt sa tān papraccha, yūyaṁ māṁ kaṁ vadatha? tataḥ śimōn pitara uvāca,</para>
  <para style="p">
    <verse number="16" style="v"/>tvamamarēśvarasyābhiṣiktaputraḥ|</para>
  <para style="p">
    <verse number="17" style="v"/>tatō yīśuḥ kathitavān, hē yūnasaḥ putra śimōn tvaṁ dhanyaḥ; yataḥ kōpi anujastvayyētajjñānaṁ nōdapādayat, kintu mama svargasyaḥ pitōdapādayat|</para>
  <para style="p">
    <verse number="18" style="v"/>atō'haṁ tvāṁ vadāmi, tvaṁ pitaraḥ (prastaraḥ) ahañca tasya prastarasyōpari svamaṇḍalīṁ nirmmāsyāmi, tēna nirayō balāt tāṁ parājētuṁ na śakṣyati|</para>
  <para style="p">
    <verse number="19" style="v"/>ahaṁ tubhyaṁ svargīyarājyasya kuñjikāṁ dāsyāmi, tēna yat kiñcana tvaṁ pr̥thivyāṁ bhaṁtsyasi tatsvargē bhaṁtsyatē, yacca kiñcana mahyāṁ mōkṣyasi tat svargē mōkṣyatē|</para>
  <para style="p">
    <verse number="20" style="v"/>paścāt sa śiṣyānādiśat, ahamabhiṣiktō yīśuriti kathāṁ kasmaicidapi yūyaṁ mā kathayata|</para>
  <para style="p">
    <verse number="21" style="v"/>anyañca yirūśālamnagaraṁ gatvā prācīnalōkēbhyaḥ pradhānayājakēbhya upādhyāyēbhyaśca bahuduḥkhabhōgastai rhatatvaṁ tr̥tīyadinē punarutthānañca mamāvaśyakam ētāḥ kathā yīśustatkālamārabhya śiṣyān jñāpayitum ārabdhavān|</para>
  <para style="p">
    <verse number="22" style="v"/>tadānīṁ pitarastasya karaṁ ghr̥tvā tarjayitvā kathayitumārabdhavān, hē prabhō, tat tvattō dūraṁ yātu, tvāṁ prati kadāpi na ghaṭiṣyatē|</para>
  <para style="p">
    <verse number="23" style="v"/>kintu sa vadanaṁ parāvartya pitaraṁ jagāda, hē vighnakārin, matsammukhād dūrībhava, tvaṁ māṁ bādhasē, īśvarīyakāryyāt mānuṣīyakāryyaṁ tubhyaṁ rōcatē|</para>
  <para style="p">
    <verse number="24" style="v"/>anantaraṁ yīśuḥ svīyaśiṣyān uktavān yaḥ kaścit mama paścādgāmī bhavitum icchati, sa svaṁ dāmyatu, tathā svakruśaṁ gr̥hlan matpaścādāyātu|</para>
  <para style="p">
    <verse number="25" style="v"/>yatō yaḥ prāṇān rakṣitumicchati, sa tān hārayiṣyati, kintu yō madarthaṁ nijaprāṇān hārayati, sa tān prāpsyati|</para>
  <para style="p">
    <verse number="26" style="v"/>mānuṣō yadi sarvvaṁ jagat labhatē nijapraṇān hārayati, tarhi tasya kō lābhaḥ? manujō nijaprāṇānāṁ vinimayēna vā kiṁ dātuṁ śaknōti?</para>
  <para style="p">
    <verse number="27" style="v"/>manujasutaḥ svadūtaiḥ sākaṁ pituḥ prabhāvēṇāgamiṣyati; tadā pratimanujaṁ svasvakarmmānusārāt phalaṁ dāsyati|</para>
  <para style="p">
    <verse number="28" style="v"/>ahaṁ yuṣmān tathyaṁ vacmi, sarājyaṁ manujasutam āgataṁ na paśyantō mr̥tyuṁ na svādiṣyanti, ētādr̥śāḥ katipayajanā atrāpi daṇḍāyamānāḥ santi|</para>
  <chapter number="17" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ ṣaḍdinēbhyaḥ paraṁ yīśuḥ pitaraṁ yākūbaṁ tatsahajaṁ yōhanañca gr̥hlan uccādrē rviviktasthānam āgatya tēṣāṁ samakṣaṁ rūpamanyat dadhāra|</para>
  <para style="p">
    <verse number="2" style="v"/>tēna tadāsyaṁ tējasvi, tadābharaṇam ālōkavat pāṇḍaramabhavat|</para>
  <para style="p">
    <verse number="3" style="v"/>anyacca tēna sākaṁ saṁlapantau mūsā ēliyaśca tēbhyō darśanaṁ dadatuḥ|</para>
  <para style="p">
    <verse number="4" style="v"/>tadānīṁ pitarō yīśuṁ jagāda, hē prabhō sthitiratrāsmākaṁ śubhā, yadi bhavatānumanyatē, tarhi bhavadarthamēkaṁ mūsārthamēkam ēliyārthañcaikam iti trīṇi dūṣyāṇi nirmmama|</para>
  <para style="p">
    <verse number="5" style="v"/>ētatkathanakāla ēka ujjavalaḥ payōdastēṣāmupari chāyāṁ kr̥tavān, vāridād ēṣā nabhasīyā vāg babhūva, mamāyaṁ priyaḥ putraḥ, asmin mama mahāsantōṣa ētasya vākyaṁ yūyaṁ niśāmayata|</para>
  <para style="p">
    <verse number="6" style="v"/>kintu vācamētāṁ śr̥ṇvantaēva śiṣyā mr̥śaṁ śaṅkamānā nyubjā nyapatan|</para>
  <para style="p">
    <verse number="7" style="v"/>tadā yīśurāgatya tēṣāṁ gātrāṇi spr̥śan uvāca, uttiṣṭhata, mā bhaiṣṭa|</para>
  <para style="p">
    <verse number="8" style="v"/>tadānīṁ nētrāṇyunmīlya yīśuṁ vinā kamapi na dadr̥śuḥ|</para>
  <para style="p">
    <verse number="9" style="v"/>tataḥ param adrēravarōhaṇakālē yīśustān ityādidēśa, manujasutasya mr̥tānāṁ madhyādutthānaṁ yāvanna jāyatē, tāvat yuṣmābhirētaddarśanaṁ kasmaicidapi na kathayitavyaṁ|</para>
  <para style="p">
    <verse number="10" style="v"/>tadā śiṣyāstaṁ papracchuḥ, prathamam ēliya āyāsyatīti kuta upādhyāyairucyatē?</para>
  <para style="p">
    <verse number="11" style="v"/>tatō yīśuḥ pratyavādīt, ēliyaḥ prāgētya sarvvāṇi sādhayiṣyatīti satyaṁ,</para>
  <para style="p">
    <verse number="12" style="v"/>kintvahaṁ yuṣmān vacmi, ēliya ētya gataḥ, tē tamaparicitya tasmin yathēcchaṁ vyavajahuḥ; manujasutēnāpi tēṣāmantikē tādr̥g duḥkhaṁ bhōktavyaṁ|</para>
  <para style="p">
    <verse number="13" style="v"/>tadānīṁ sa majjayitāraṁ yōhanamadhi kathāmētāṁ vyāhr̥tavān, itthaṁ tacchiṣyā bubudhirē|</para>
  <para style="p">
    <verse number="14" style="v"/>paścāt tēṣu jananivahasyāntikamāgatēṣu kaścit manujastadantikamētya jānūnī pātayitvā kathitavān,</para>
  <para style="p">
    <verse number="15" style="v"/>hē prabhō, matputraṁ prati kr̥pāṁ vidadhātu, sōpasmārāmayēna bhr̥śaṁ vyathitaḥ san punaḥ puna rvahnau muhu rjalamadhyē patati|</para>
  <para style="p">
    <verse number="16" style="v"/>tasmād bhavataḥ śiṣyāṇāṁ samīpē tamānayaṁ kintu tē taṁ svāsthaṁ karttuṁ na śaktāḥ|</para>
  <para style="p">
    <verse number="17" style="v"/>tadā yīśuḥ kathitavān rē aviśvāsinaḥ, rē vipathagāminaḥ, punaḥ katikālān ahaṁ yuṣmākaṁ sannidhau sthāsyāmi? katikālān vā yuṣmān sahiṣyē? tamatra mamāntikamānayata|</para>
  <para style="p">
    <verse number="18" style="v"/>paścād yīśunā tarjataēva sa bhūtastaṁ vihāya gatavān, taddaṇḍaēva sa bālakō nirāmayō'bhūt|</para>
  <para style="p">
    <verse number="19" style="v"/>tataḥ śiṣyā guptaṁ yīśumupāgatya babhāṣirē, kutō vayaṁ taṁ bhūtaṁ tyājayituṁ na śaktāḥ?</para>
  <para style="p">
    <verse number="20" style="v"/>yīśunā tē prōktāḥ, yuṣmākamapratyayāt;</para>
  <para style="p">
    <verse number="21" style="v"/>yuṣmānahaṁ tathyaṁ vacmi yadi yuṣmākaṁ sarṣapaikamātrōpi viśvāsō jāyatē, tarhi yuṣmābhirasmin śailē tvamitaḥ sthānāt tat sthānaṁ yāhīti brūtē sa tadaiva caliṣyati, yuṣmākaṁ kimapyasādhyañca karmma na sthāsyāti| kintu prārthanōpavāsau vinaitādr̥śō bhūtō na tyājyēta|</para>
  <para style="p">
    <verse number="22" style="v"/>aparaṁ tēṣāṁ gālīlpradēśē bhramaṇakālē yīśunā tē gaditāḥ, manujasutō janānāṁ karēṣu samarpayiṣyatē tai rhaniṣyatē ca,</para>
  <para style="p">
    <verse number="23" style="v"/>kintu tr̥tīyē'hi्na ma utthāpiṣyatē, tēna tē bhr̥śaṁ duḥkhitā babhūvaḥ|</para>
  <para style="p">
    <verse number="24" style="v"/>tadanantaraṁ tēṣu kapharnāhūmnagaramāgatēṣu karasaṁgrāhiṇaḥ pitarāntikamāgatya papracchuḥ, yuṣmākaṁ guruḥ kiṁ mandirārthaṁ karaṁ na dadāti? tataḥ pitaraḥ kathitavān dadāti|</para>
  <para style="p">
    <verse number="25" style="v"/>tatastasmin gr̥hamadhyamāgatē tasya kathākathanāt pūrvvamēva yīśuruvāca, hē śimōn, mēdinyā rājānaḥ svasvāpatyēbhyaḥ kiṁ vidēśibhyaḥ kēbhyaḥ karaṁ gr̥hlanti? atra tvaṁ kiṁ budhyasē? tataḥ pitara uktavān, vidēśibhyaḥ|</para>
  <para style="p">
    <verse number="26" style="v"/>tadā yīśuruktavān, tarhi santānā muktāḥ santi|</para>
  <para style="p">
    <verse number="27" style="v"/>tathāpi yathāsmābhistēṣāmantarāyō na janyatē, tatkr̥tē jaladhēstīraṁ gatvā vaḍiśaṁ kṣipa, tēnādau yō mīna utthāsyati, taṁ ghr̥tvā tanmukhē mōcitē tōlakaikaṁ rūpyaṁ prāpsyasi, tad gr̥hītvā tava mama ca kr̥tē tēbhyō dēhi|</para>
  <chapter number="18" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tadānīṁ śiṣyā yīśōḥ samīpamāgatya pr̥ṣṭavantaḥ svargarājyē kaḥ śrēṣṭhaḥ?</para>
  <para style="p">
    <verse number="2" style="v"/>tatō yīśuḥ kṣudramēkaṁ bālakaṁ svasamīpamānīya tēṣāṁ madhyē nidhāya jagāda,</para>
  <para style="p">
    <verse number="3" style="v"/>yuṣmānahaṁ satyaṁ bravīmi, yūyaṁ manōvinimayēna kṣudrabālavat na santaḥ svargarājyaṁ pravēṣṭuṁ na śaknutha|</para>
  <para style="p">
    <verse number="4" style="v"/>yaḥ kaścid ētasya kṣudrabālakasya samamātmānaṁ namrīkarōti, saēva svargarājayē śrēṣṭhaḥ|</para>
  <para style="p">
    <verse number="5" style="v"/>yaḥ kaścid ētādr̥śaṁ kṣudrabālakamēkaṁ mama nāmni gr̥hlāti, sa māmēva gr̥hlāti|</para>
  <para style="p">
    <verse number="6" style="v"/>kintu yō janō mayi kr̥taviśvāsānāmētēṣāṁ kṣudraprāṇinām ēkasyāpi vidhniṁ janayati, kaṇṭhabaddhapēṣaṇīkasya tasya sāgarāgādhajalē majjanaṁ śrēyaḥ|</para>
  <para style="p">
    <verse number="7" style="v"/>vighnāt jagataḥ santāpō bhaviṣyati, vighnō'vaśyaṁ janayiṣyatē, kintu yēna manujēna vighnō janiṣyatē tasyaiva santāpō bhaviṣyati|</para>
  <para style="p">
    <verse number="8" style="v"/>tasmāt tava karaścaraṇō vā yadi tvāṁ bādhatē, tarhi taṁ chittvā nikṣipa, dvikarasya dvipadasya vā tavānaptavahnau nikṣēpāt, khañjasya vā chinnahastasya tava jīvanē pravēśō varaṁ|</para>
  <para style="p">
    <verse number="9" style="v"/>aparaṁ tava nētraṁ yadi tvāṁ bādhatē, tarhi tadapyutpāvya nikṣipa, dvinētrasya narakāgnau nikṣēpāt kāṇasya tava jīvanē pravēśō varaṁ|</para>
  <para style="p">
    <verse number="10" style="v"/>tasmādavadhaddhaṁ, ētēṣāṁ kṣudraprāṇinām ēkamapi mā tucchīkuruta,</para>
  <para style="p">
    <verse number="11" style="v"/>yatō yuṣmānahaṁ tathyaṁ bravīmi, svargē tēṣāṁ dūtā mama svargasthasya piturāsyaṁ nityaṁ paśyanti| ēvaṁ yē yē hāritāstān rakṣituṁ manujaputra āgacchat|</para>
  <para style="p">
    <verse number="12" style="v"/>yūyamatra kiṁ viviṁgghvē? kasyacid yadi śataṁ mēṣāḥ santi, tēṣāmēkō hāryyatē ca, tarhi sa ēkōnaśataṁ mēṣān vihāya parvvataṁ gatvā taṁ hāritamēkaṁ kiṁ na mr̥gayatē?</para>
  <para style="p">
    <verse number="13" style="v"/>yadi ca kadācit tanmēṣōddēśaṁ lamatē, tarhi yuṣmānahaṁ satyaṁ kathayāmi, sō'vipathagāmibhya ēkōnaśatamēṣēbhyōpi tadēkahētōradhikam āhlādatē|</para>
  <para style="p">
    <verse number="14" style="v"/>tadvad ētēṣāṁ kṣudraprāēिnām ēkōpi naśyatīti yuṣmākaṁ svargasthapitu rnābhimatam|</para>
  <para style="p">
    <verse number="15" style="v"/>yadyapi tava bhrātā tvayi kimapyaparādhyati, tarhi gatvā yuvayōrdvayōḥ sthitayōstasyāparādhaṁ taṁ jñāpaya| tatra sa yadi tava vākyaṁ śr̥ṇōti, tarhi tvaṁ svabhrātaraṁ prāptavān,</para>
  <para style="p">
    <verse number="16" style="v"/>kintu yadi na śr̥ṇōti, tarhi dvābhyāṁ tribhi rvā sākṣībhiḥ sarvvaṁ vākyaṁ yathā niścitaṁ jāyatē, tadartham ēkaṁ dvau vā sākṣiṇau gr̥hītvā yāhi|</para>
  <para style="p">
    <verse number="17" style="v"/>tēna sa yadi tayō rvākyaṁ na mānyatē, tarhi samājaṁ tajjñāpaya, kintu yadi samājasyāpi vākyaṁ na mānyatē,tarhi sa tava samīpē dēvapūjaka̮iva caṇḍāla̮iva ca bhaviṣyati|</para>
  <para style="p">
    <verse number="18" style="v"/>ahaṁ yuṣmān satyaṁ vadāmi, yuṣmābhiḥ pr̥thivyāṁ yad badhyatē tat svargē bhaṁtsyatē; mēdinyāṁ yat bhōcyatē, svargē'pi tat mōkṣyatē|</para>
  <para style="p">
    <verse number="19" style="v"/>punarahaṁ yuṣmān vadāmi, mēdinyāṁ yuṣmākaṁ yadi dvāvēkavākyībhūya kiñcit prārthayētē, tarhi mama svargasthapitrā tat tayōḥ kr̥tē sampannaṁ bhaviṣyati|</para>
  <para style="p">
    <verse number="20" style="v"/>yatō yatra dvau trayō vā mama nānni milanti, tatraivāhaṁ tēṣāṁ madhyē'smi|</para>
  <para style="p">
    <verse number="21" style="v"/>tadānīṁ pitarastatsamīpamāgatya kathitavān hē prabhō, mama bhrātā mama yadyaparādhyati, tarhi taṁ katikr̥tvaḥ kṣamiṣyē?</para>
  <para style="p">
    <verse number="22" style="v"/>kiṁ saptakr̥tvaḥ? yīśustaṁ jagāda, tvāṁ kēvalaṁ saptakr̥tvō yāvat na vadāmi, kintu saptatyā guṇitaṁ saptakr̥tvō yāvat|</para>
  <para style="p">
    <verse number="23" style="v"/>aparaṁ nijadāsaiḥ saha jigaṇayiṣuḥ kaścid rājēva svargarājayaṁ|</para>
  <para style="p">
    <verse number="24" style="v"/>ārabdhē tasmin gaṇanē sārddhasahasramudrāpūritānāṁ daśasahasrapuṭakānām ēkō'ghamarṇastatsamakṣamānāyi|</para>
  <para style="p">
    <verse number="25" style="v"/>tasya pariśōdhanāya dravyābhāvāt pariśōdhanārthaṁ sa tadīyabhāryyāputrādisarvvasvañca vikrīyatāmiti tatprabhurādidēśa|</para>
  <para style="p">
    <verse number="26" style="v"/>tēna sa dāsastasya pādayōḥ patan praṇamya kathitavān , hē prabhō bhavatā ghairyyē kr̥tē mayā sarvvaṁ pariśōdhiṣyatē|</para>
  <para style="p">
    <verse number="27" style="v"/>tadānīṁ dāsasya prabhuḥ sakaruṇaḥ san sakalarṇaṁ kṣamitvā taṁ tatyāja|</para>
  <para style="p">
    <verse number="28" style="v"/>kintu tasmin dāsē bahi ryātē, tasya śataṁ mudrācaturthāṁśān yō dhārayati, taṁ sahadāsaṁ dr̥ṣdvā tasya kaṇṭhaṁ niṣpīḍya gaditavān, mama yat prāpyaṁ tat pariśōdhaya|</para>
  <para style="p">
    <verse number="29" style="v"/>tadā tasya sahadāsastatpādayōḥ patitvā vinīya babhāṣē, tvayā dhairyyē kr̥tē mayā sarvvaṁ pariśōdhiṣyatē|</para>
  <para style="p">
    <verse number="30" style="v"/>tathāpi sa tat nāṅagīkr̥tya yāvat sarvvamr̥ṇaṁ na pariśōdhitavān tāvat taṁ kārāyāṁ sthāpayāmāsa|</para>
  <para style="p">
    <verse number="31" style="v"/>tadā tasya sahadāsāstasyaitādr̥g ācaraṇaṁ vilōkya prabhōḥ samīpaṁ gatvā sarvvaṁ vr̥ttāntaṁ nivēdayāmāsuḥ|</para>
  <para style="p">
    <verse number="32" style="v"/>tadā tasya prabhustamāhūya jagāda, rē duṣṭa dāsa, tvayā matsannidhau prārthitē mayā tava sarvvamr̥ṇaṁ tyaktaṁ;</para>
  <para style="p">
    <verse number="33" style="v"/>yathā cāhaṁ tvayi karuṇāṁ kr̥tavān, tathaiva tvatsahadāsē karuṇākaraṇaṁ kiṁ tava nōcitaṁ?</para>
  <para style="p">
    <verse number="34" style="v"/>iti kathayitvā tasya prabhuḥ kruddhyan nijaprāpyaṁ yāvat sa na pariśōdhitavān, tāvat prahārakānāṁ karēṣu taṁ samarpitavān|</para>
  <para style="p">
    <verse number="35" style="v"/>yadi yūyaṁ svāntaḥkaraṇaiḥ svasvasahajānām aparādhān na kṣamadhvē, tarhi mama svargasyaḥ pitāpi yuṣmān pratītthaṁ kariṣyati|</para>
  <chapter number="19" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaram ētāsu kathāsu samāptāsu yīśu rgālīlapradēśāt prasthāya yardantīrasthaṁ yihūdāpradēśaṁ prāptaḥ|</para>
  <para style="p">
    <verse number="2" style="v"/>tadā tatpaścāt jananivahē gatē sa tatra tān nirāmayān akarōt|</para>
  <para style="p">
    <verse number="3" style="v"/>tadanantaraṁ phirūśinastatsamīpamāgatya pārīkṣituṁ taṁ papracchuḥ, kasmādapi kāraṇāt narēṇa svajāyā parityājyā na vā?</para>
  <para style="p">
    <verse number="4" style="v"/>sa pratyuvāca, prathamam īśvarō naratvēna nārītvēna ca manujān sasarja, tasmāt kathitavān,</para>
  <para style="p">
    <verse number="5" style="v"/>mānuṣaḥ svapitarau parityajya svapatnyām āsakṣyatē, tau dvau janāvēkāṅgau bhaviṣyataḥ, kimētad yuṣmābhi rna paṭhitam?</para>
  <para style="p">
    <verse number="6" style="v"/>atastau puna rna dvau tayōrēkāṅgatvaṁ jātaṁ, īśvarēṇa yacca samayujyata, manujō na tad bhindyāt|</para>
  <para style="p">
    <verse number="7" style="v"/>tadānīṁ tē taṁ pratyavadan, tathātvē tyājyapatraṁ dattvā svāṁ svāṁ jāyāṁ tyaktuṁ vyavasthāṁ mūsāḥ kathaṁ lilēkha?</para>
  <para style="p">
    <verse number="8" style="v"/>tataḥ sa kathitavān, yuṣmākaṁ manasāṁ kāṭhinyād yuṣmān svāṁ svāṁ jāyāṁ tyaktum anvamanyata kintu prathamād ēṣō vidhirnāsīt|</para>
  <para style="p">
    <verse number="9" style="v"/>atō yuṣmānahaṁ vadāmi, vyabhicāraṁ vinā yō nijajāyāṁ tyajēt anyāñca vivahēt, sa paradārān gacchati; yaśca tyaktāṁ nārīṁ vivahati sōpi paradārēṣu ramatē|</para>
  <para style="p">
    <verse number="10" style="v"/>tadā tasya śiṣyāstaṁ babhāṣirē, yadi svajāyayā sākaṁ puṁsa ētādr̥k sambandhō jāyatē, tarhi vivahanamēva na bhadraṁ|</para>
  <para style="p">
    <verse number="11" style="v"/>tataḥ sa uktavān, yēbhyastatsāmarthyaṁ ādāyi, tān vinānyaḥ kōpi manuja ētanmataṁ grahītuṁ na śaknōti|</para>
  <para style="p">
    <verse number="12" style="v"/>katipayā jananaklībaḥ katipayā narakr̥taklībaḥ svargarājyāya katipayāḥ svakr̥taklībāśca santi, yē grahītuṁ śaknuvanti tē gr̥hlantu|</para>
  <para style="p">
    <verse number="13" style="v"/>aparam yathā sa śiśūnāṁ gātrēṣu hastaṁ datvā prārthayatē, tadarthaṁ tatsamīṁpaṁ śiśava ānīyanta, tata ānayitr̥n śiṣyāstiraskr̥tavantaḥ|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu yīśuruvāca, śiśavō madantikam āgacchantu, tān mā vārayata, ētādr̥śāṁ śiśūnāmēva svargarājyaṁ|</para>
  <para style="p">
    <verse number="15" style="v"/>tataḥ sa tēṣāṁ gātrēṣu hastaṁ datvā tasmāt sthānāt pratasthē|</para>
  <para style="p">
    <verse number="16" style="v"/>aparam ēka āgatya taṁ papraccha, hē paramagurō, anantāyuḥ prāptuṁ mayā kiṁ kiṁ satkarmma karttavyaṁ?</para>
  <para style="p">
    <verse number="17" style="v"/>tataḥ sa uvāca, māṁ paramaṁ kutō vadasi? vinēścaraṁ na kōpi paramaḥ, kintu yadyanantāyuḥ prāptuṁ vāñchasi, tarhyājñāḥ pālaya|</para>
  <para style="p">
    <verse number="18" style="v"/>tadā sa pr̥ṣṭavān, kāḥ kā ājñāḥ? tatō yīśuḥ kathitavān, naraṁ mā hanyāḥ, paradārān mā gacchēḥ, mā cōrayēḥ, mr̥ṣāsākṣyaṁ mā dadyāḥ,</para>
  <para style="p">
    <verse number="19" style="v"/>nijapitarau saṁmanyasva, svasamīpavāsini svavat prēma kuru|</para>
  <para style="p">
    <verse number="20" style="v"/>sa yuvā kathitavān, ā bālyād ētāḥ pālayāmi, idānīṁ kiṁ nyūnamāstē?</para>
  <para style="p">
    <verse number="21" style="v"/>tatō yīśuravadat, yadi siddhō bhavituṁ vāñchasi, tarhi gatvā nijasarvvasvaṁ vikrīya daridrēbhyō vitara, tataḥ svargē vittaṁ lapsyasē; āgaccha, matpaścādvarttī ca bhava|</para>
  <para style="p">
    <verse number="22" style="v"/>ētāṁ vācaṁ śrutvā sa yuvā svīyabahusampattē rviṣaṇaḥ san calitavān|</para>
  <para style="p">
    <verse number="23" style="v"/>tadā yīśuḥ svaśiṣyān avadat, dhanināṁ svargarājyapravēśō mahāduṣkara iti yuṣmānahaṁ tathyaṁ vadāmi|</para>
  <para style="p">
    <verse number="24" style="v"/>punarapi yuṣmānahaṁ vadāmi, dhanināṁ svargarājyapravēśāt sūcīchidrēṇa mahāṅgagamanaṁ sukaraṁ|</para>
  <para style="p">
    <verse number="25" style="v"/>iti vākyaṁ niśamya śiṣyā aticamatkr̥tya kathayāmāsuḥ; tarhi kasya paritrāṇaṁ bhavituṁ śaknōti?</para>
  <para style="p">
    <verse number="26" style="v"/>tadā sa tān dr̥ṣdvā kathayāmāsa, tat mānuṣāṇāmaśakyaṁ bhavati, kintvīśvarasya sarvvaṁ śakyam|</para>
  <para style="p">
    <verse number="27" style="v"/>tadā pitarastaṁ gaditavān, paśya, vayaṁ sarvvaṁ parityajya bhavataḥ paścādvarttinō 'bhavāma; vayaṁ kiṁ prāpsyāmaḥ?</para>
  <para style="p">
    <verse number="28" style="v"/>tatō yīśuḥ kathitavān, yuṣmānahaṁ tathyaṁ vadāmi, yūyaṁ mama paścādvarttinō jātā iti kāraṇāt navīnasr̥ṣṭikālē yadā manujasutaḥ svīyaiścaryyasiṁhāsana upavēkṣyati, tadā yūyamapi dvādaśasiṁhāsanēṣūpaviśya isrāyēlīyadvādaśavaṁśānāṁ vicāraṁ kariṣyatha|</para>
  <para style="p">
    <verse number="29" style="v"/>anyacca yaḥ kaścit mama nāmakāraṇāt gr̥haṁ vā bhrātaraṁ vā bhaginīṁ vā pitaraṁ vā mātaraṁ vā jāyāṁ vā bālakaṁ vā bhūmiṁ parityajati, sa tēṣāṁ śataguṇaṁ lapsyatē, anantāyumō'dhikāritvañca prāpsyati|</para>
  <para style="p">
    <verse number="30" style="v"/>kintu agrīyā anēkē janāḥ paścāt, paścātīyāścānēkē lōkā agrē bhaviṣyanti|</para>
  <chapter number="20" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>svargarājyam ētādr̥śā kēnacid gr̥hasyēna samaṁ, yō'tiprabhātē nijadrākṣākṣētrē kr̥ṣakān niyōktuṁ gatavān|</para>
  <para style="p">
    <verse number="2" style="v"/>paścāt taiḥ sākaṁ dinaikabhr̥tiṁ mudrācaturthāṁśaṁ nirūpya tān drākṣākṣētraṁ prērayāmāsa|</para>
  <para style="p">
    <verse number="3" style="v"/>anantaraṁ praharaikavēlāyāṁ gatvā haṭṭē katipayān niṣkarmmakān vilōkya tānavadat,</para>
  <para style="p">
    <verse number="4" style="v"/>yūyamapi mama drākṣākṣētraṁ yāta, yuṣmabhyamahaṁ yōgyabhr̥tiṁ dāsyāmi, tatastē vavrajuḥ|</para>
  <para style="p">
    <verse number="5" style="v"/>punaśca sa dvitīyatr̥tīyayōḥ praharayō rbahi rgatvā tathaiva kr̥tavān|</para>
  <para style="p">
    <verse number="6" style="v"/>tatō daṇḍadvayāvaśiṣṭāyāṁ vēlāyāṁ bahi rgatvāparān katipayajanān niṣkarmmakān vilōkya pr̥ṣṭavān, yūyaṁ kimartham atra sarvvaṁ dinaṁ niṣkarmmāṇastiṣṭhatha?</para>
  <para style="p">
    <verse number="7" style="v"/>tē pratyavadan, asmān na kōpi karmamaṇi niyuṁktē| tadānīṁ sa kathitavān, yūyamapi mama drākṣākṣētraṁ yāta, tēna yōgyāṁ bhr̥tiṁ lapsyatha|</para>
  <para style="p">
    <verse number="8" style="v"/>tadanantaraṁ sandhyāyāṁ satyāṁ saēva drākṣākṣētrapatiradhyakṣaṁ gadivān, kr̥ṣakān āhūya śēṣajanamārabhya prathamaṁ yāvat tēbhyō bhr̥tiṁ dēhi|</para>
  <para style="p">
    <verse number="9" style="v"/>tēna yē daṇḍadvayāvasthitē samāyātāstēṣām ēkaikō janō mudrācaturthāṁśaṁ prāpnōt|</para>
  <para style="p">
    <verse number="10" style="v"/>tadānīṁ prathamaniyuktā janā āgatyānumitavantō vayamadhikaṁ prapsyāmaḥ, kintu tairapi mudrācaturthāṁśō'lābhi|</para>
  <para style="p">
    <verse number="11" style="v"/>tatastē taṁ gr̥hītvā tēna kṣētrapatinā sākaṁ vāgyuddhaṁ kurvvantaḥ kathayāmāsuḥ,</para>
  <para style="p">
    <verse number="12" style="v"/>vayaṁ kr̥tsnaṁ dinaṁ tāpaklēśau sōḍhavantaḥ, kintu paścātāyā sē janā daṇḍadvayamātraṁ pariśrāntavantastē'smābhiḥ samānāṁśāḥ kr̥tāḥ|</para>
  <para style="p">
    <verse number="13" style="v"/>tataḥ sa tēṣāmēkaṁ pratyuvāca, hē vatsa, mayā tvāṁ prati kōpyanyāyō na kr̥taḥ kiṁ tvayā matsamakṣaṁ mudrācaturthāṁśō nāṅgīkr̥taḥ?</para>
  <para style="p">
    <verse number="14" style="v"/>tasmāt tava yat prāpyaṁ tadādāya yāhi, tubhyaṁ yati, paścātīyaniyuktalōkāyāpi tati dātumicchāmi|</para>
  <para style="p">
    <verse number="15" style="v"/>svēcchayā nijadravyavyavaharaṇaṁ kiṁ mayā na karttavyaṁ? mama dātr̥tvāt tvayā kim īrṣyādr̥ṣṭiḥ kriyatē?</para>
  <para style="p">
    <verse number="16" style="v"/>ittham agrīyalōkāḥ paścatīyā bhaviṣyanti, paścātīyajanāścagrīyā bhaviṣyanti, ahūtā bahavaḥ kintvalpē manōbhilaṣitāḥ|</para>
  <para style="p">
    <verse number="17" style="v"/>tadanantaraṁ yīśu ryirūśālamnagaraṁ gacchan mārgamadhyē śiṣyān ēkāntē vabhāṣē,</para>
  <para style="p">
    <verse number="18" style="v"/>paśya vayaṁ yirūśālamnagaraṁ yāmaḥ, tatra pradhānayājakādhyāpakānāṁ karēṣu manuṣyaputraḥ samarpiṣyatē;</para>
  <para style="p">
    <verse number="19" style="v"/>tē ca taṁ hantumājñāpya tiraskr̥tya vētrēṇa praharttuṁ kruśē dhātayituñcānyadēśīyānāṁ karēṣu samarpayiṣyanti, kintu sa tr̥tīyadivasē śmaśānād utthāpiṣyatē|</para>
  <para style="p">
    <verse number="20" style="v"/>tadānīṁ sivadīyasya nārī svaputrāvādāya yīśōḥ samīpam ētya praṇamya kañcanānugrahaṁ taṁ yayācē|</para>
  <para style="p">
    <verse number="21" style="v"/>tadā yīśustāṁ prōktavān, tvaṁ kiṁ yācasē? tataḥ sā babhāṣē, bhavatō rājatvē mamānayōḥ sutayōrēkaṁ bhavaddakṣiṇapārśvē dvitīyaṁ vāmapārśva upavēṣṭum ājñāpayatu|</para>
  <para style="p">
    <verse number="22" style="v"/>yīśuḥ pratyuvāca, yuvābhyāṁ yad yācyatē, tanna budhyatē, ahaṁ yēna kaṁsēna pāsyāmi yuvābhyāṁ kiṁ tēna pātuṁ śakyatē? ahañca yēna majjēnēna majjiṣyē, yuvābhyāṁ kiṁ tēna majjayituṁ śakyatē? tē jagaduḥ śakyatē|</para>
  <para style="p">
    <verse number="23" style="v"/>tadā sa uktavān, yuvāṁ mama kaṁsēnāvaśyaṁ pāsyathaḥ, mama majjanēna ca yuvāmapi majjiṣyēthē, kintu yēṣāṁ kr̥tē mattātēna nirūpitam idaṁ tān vihāyānyaṁ kamapi maddakṣiṇapārśvē vāmapārśvē ca samupavēśayituṁ mamādhikārō nāsti|</para>
  <para style="p">
    <verse number="24" style="v"/>ētāṁ kathāṁ śrutvānyē daśaśiṣyāstau bhrātarau prati cukupuḥ|</para>
  <para style="p">
    <verse number="25" style="v"/>kintu yīśuḥ svasamīpaṁ tānāhūya jagāda, anyadēśīyalōkānāṁ narapatayastān adhikurvvanti, yē tu mahāntastē tān śāsati, iti yūyaṁ jānītha|</para>
  <para style="p">
    <verse number="26" style="v"/>kintu yuṣmākaṁ madhyē na tathā bhavēt, yuṣmākaṁ yaḥ kaścit mahān bubhūṣati, sa yuṣmān sēvēta;</para>
  <para style="p">
    <verse number="27" style="v"/>yaśca yuṣmākaṁ madhyē mukhyō bubhūṣati, sa yuṣmākaṁ dāsō bhavēt|</para>
  <para style="p">
    <verse number="28" style="v"/>itthaṁ manujaputraḥ sēvyō bhavituṁ nahi, kintu sēvituṁ bahūnāṁ paritrāṇamūlyārthaṁ svaprāṇān dātuñcāgataḥ|</para>
  <para style="p">
    <verse number="29" style="v"/>anantaraṁ yirīhōnagarāt tēṣāṁ bahirgamanasamayē tasya paścād bahavō lōkā vavrajuḥ|</para>
  <para style="p">
    <verse number="30" style="v"/>aparaṁ vartmapārśva upaviśantau dvāvandhau tēna mārgēṇa yīśō rgamanaṁ niśamya prōccaiḥ kathayāmāsatuḥ, hē prabhō dāyūdaḥ santāna, āvayō rdayāṁ vidhēhi|</para>
  <para style="p">
    <verse number="31" style="v"/>tatō lōkāḥ sarvvē tuṣṇīmbhavatamityuktvā tau tarjayāmāsuḥ; tathāpi tau punaruccaiḥ kathayāmāsatuḥ hē prabhō dāyūdaḥ santāna, āvāṁ dayasva|</para>
  <para style="p">
    <verse number="32" style="v"/>tadānīṁ yīśuḥ sthagitaḥ san tāvāhūya bhāṣitavān, yuvayōḥ kr̥tē mayā kiṁ karttarvyaṁ? yuvāṁ kiṁ kāmayēthē?</para>
  <para style="p">
    <verse number="33" style="v"/>tadā tāvuktavantau, prabhō nētrāṇi nau prasannāni bhavēyuḥ|</para>
  <para style="p">
    <verse number="34" style="v"/>tadānīṁ yīśustau prati pramannaḥ san tayō rnētrāṇi pasparśa, tēnaiva tau suvīkṣāñcakrātē tatpaścāt jagmutuśca|</para>
  <chapter number="21" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ tēṣu yirūśālamnagarasya samīpavērttinō jaitunanāmakadharādharasya samīpasthtiṁ baitphagigrāmam āgatēṣu, yīśuḥ śiṣyadvayaṁ prēṣayan jagāda,</para>
  <para style="p">
    <verse number="2" style="v"/>yuvāṁ sammukhasthagrāmaṁ gatvā baddhāṁ yāṁ savatsāṁ garddabhīṁ haṭhāt prāpsyathaḥ, tāṁ mōcayitvā madantikam ānayataṁ|</para>
  <para style="p">
    <verse number="3" style="v"/>tatra yadi kaścit kiñcid vakṣyati, tarhi vadiṣyathaḥ, ētasyāṁ prabhōḥ prayōjanamāstē, tēna sa tatkṣaṇāt prahēṣyati|</para>
  <para style="p">
    <verse number="4" style="v"/>sīyōnaḥ kanyakāṁ yūyaṁ bhāṣadhvamiti bhāratīṁ| paśya tē namraśīlaḥ san nr̥pa āruhya gardabhīṁ| arthādāruhya tadvatsamāyāsyati tvadantikaṁ|</para>
  <para style="p">
    <verse number="5" style="v"/>bhaviṣyadvādinōktaṁ vacanamidaṁ tadā saphalamabhūt|</para>
  <para style="p">
    <verse number="6" style="v"/>anantaraṁ tau śṣyiौ yīśō ryathānidēśaṁ taṁ grāmaṁ gatvā</para>
  <para style="p">
    <verse number="7" style="v"/>gardabhīṁ tadvatsañca samānītavantau, paścāt tadupari svīyavasanānī pātayitvā tamārōhayāmāsatuḥ|</para>
  <para style="p">
    <verse number="8" style="v"/>tatō bahavō lōkā nijavasanāni pathi prasārayitumārēbhirē, katipayā janāśca pādapaparṇādikaṁ chitvā pathi vistārayāmāsuḥ|</para>
  <para style="p">
    <verse number="9" style="v"/>agragāminaḥ paścādgāminaśca manujā uccairjaya jaya dāyūdaḥ santānēti jagaduḥ paramēśvarasya nāmnā ya āyāti sa dhanyaḥ, sarvvōparisthasvargēpi jayati|</para>
  <para style="p">
    <verse number="10" style="v"/>itthaṁ tasmin yirūśālamaṁ praviṣṭē kō'yamiti kathanāt kr̥tsnaṁ nagaraṁ cañcalamabhavat|</para>
  <para style="p">
    <verse number="11" style="v"/>tatra lōkōḥ kathayāmāsuḥ, ēṣa gālīlpradēśīya-nāsaratīya-bhaviṣyadvādī yīśuḥ|</para>
  <para style="p">
    <verse number="12" style="v"/>anantaraṁ yīśurīśvarasya mandiraṁ praviśya tanmadhyāt krayavikrayiṇō vahiścakāra; vaṇijāṁ mudrāsanānī kapōtavikrayiṇāñcasanānī ca nyuvjayāmāsa|</para>
  <para style="p">
    <verse number="13" style="v"/>aparaṁ tānuvāca, ēṣā lipirāstē, "mama gr̥haṁ prārthanāgr̥hamiti vikhyāsyati", kintu yūyaṁ tad dasyūnāṁ gahvaraṁ kr̥tavantaḥ|</para>
  <para style="p">
    <verse number="14" style="v"/>tadanantaram andhakhañcalōkāstasya samīpamāgatāḥ, sa tān nirāmayān kr̥tavān|</para>
  <para style="p">
    <verse number="15" style="v"/>yadā pradhānayājakā adhyāpakāśca tēna kr̥tānyētāni citrakarmmāṇi dadr̥śuḥ, jaya jaya dāyūdaḥ santāna, mandirē bālakānām ētādr̥śam uccadhvaniṁ śuśruvuśca, tadā mahākruddhā babhūvaḥ,</para>
  <para style="p">
    <verse number="16" style="v"/>taṁ papracchuśca, imē yad vadanti, tat kiṁ tvaṁ śr̥ṇōṣi? tatō yīśustān avōcat, satyam; stanyapāyiśiśūnāñca bālakānāñca vaktrataḥ| svakīyaṁ mahimānaṁ tvaṁ saṁprakāśayasi svayaṁ| ētadvākyaṁ yūyaṁ kiṁ nāpaṭhata?</para>
  <para style="p">
    <verse number="17" style="v"/>tatastān vihāya sa nagarād baithaniyāgrāmaṁ gatvā tatra rajanīṁ yāpayāmāsa|</para>
  <para style="p">
    <verse number="18" style="v"/>anantaraṁ prabhātē sati yīśuḥ punarapi nagaramāgacchan kṣudhārttō babhūva|</para>
  <para style="p">
    <verse number="19" style="v"/>tatō mārgapārśva uḍumbaravr̥kṣamēkaṁ vilōkya tatsamīpaṁ gatvā patrāṇi vinā kimapi na prāpya taṁ pādapaṁ prōvāca, adyārabhya kadāpi tvayi phalaṁ na bhavatu; tēna tatkṣaṇāt sa uḍumbaramāhīruhaḥ śuṣkatāṁ gataḥ|</para>
  <para style="p">
    <verse number="20" style="v"/>tad dr̥ṣṭvā śiṣyā āścaryyaṁ vijñāya kathayāmāsuḥ, āḥ, uḍumvarapādapō'titūrṇaṁ śuṣkō'bhavat|</para>
  <para style="p">
    <verse number="21" style="v"/>tatō yīśustānuvāca, yuṣmānahaṁ satyaṁ vadāmi, yadi yūyamasandigdhāḥ pratītha, tarhi yūyamapi kēvalōḍumvarapādapaṁ pratītthaṁ karttuṁ śakṣyatha, tanna, tvaṁ calitvā sāgarē patēti vākyaṁ yuṣmābhirasmina śailē prōktēpi tadaiva tad ghaṭiṣyatē|</para>
  <para style="p">
    <verse number="22" style="v"/>tathā viśvasya prārthya yuṣmābhi ryad yāciṣyatē, tadēva prāpsyatē|</para>
  <para style="p">
    <verse number="23" style="v"/>anantaraṁ mandiraṁ praviśyōpadēśanasamayē tatsamīpaṁ pradhānayājakāḥ prācīnalōkāścāgatya papracchuḥ, tvayā kēna sāmarthyanaitāni karmmāṇi kriyantē? kēna vā tubhyamētāni sāmarthyāni dattāni?</para>
  <para style="p">
    <verse number="24" style="v"/>tatō yīśuḥ pratyavadat, ahamapi yuṣmān vācamēkāṁ pr̥cchāmi, yadi yūyaṁ taduttaraṁ dātuṁ śakṣyatha, tadā kēna sāmarthyēna karmmāṇyētāni karōmi, tadahaṁ yuṣmān vakṣyāmi|</para>
  <para style="p">
    <verse number="25" style="v"/>yōhanō majjanaṁ kasyājñayābhavat? kimīśvarasya manuṣyasya vā? tatastē parasparaṁ vivicya kathayāmāsuḥ, yadīśvarasyēti vadāmastarhi yūyaṁ taṁ kutō na pratyaita? vācamētāṁ vakṣyati|</para>
  <para style="p">
    <verse number="26" style="v"/>manuṣyasyēti vaktumapi lōkēbhyō bibhīmaḥ, yataḥ sarvvairapi yōhan bhaviṣyadvādīti jñāyatē|</para>
  <para style="p">
    <verse number="27" style="v"/>tasmāt tē yīśuṁ pratyavadan, tad vayaṁ na vidmaḥ| tadā sa tānuktavān, tarhi kēna sāmarathyēna karmmāṇyētānyahaṁ karōmi, tadapyahaṁ yuṣmān na vakṣyāmi|</para>
  <para style="p">
    <verse number="28" style="v"/>kasyacijjanasya dvau sutāvāstāṁ sa ēkasya sutasya samīpaṁ gatvā jagāda, hē suta, tvamadya mama drākṣākṣētrē karmma kartuṁ vraja|</para>
  <para style="p">
    <verse number="29" style="v"/>tataḥ sa uktavān, na yāsyāmi, kintu śēṣē'nutapya jagāma|</para>
  <para style="p">
    <verse number="30" style="v"/>anantaraṁ sōnyasutasya samīpaṁ gatvā tathaiva kathtivān; tataḥ sa pratyuvāca, mahēccha yāmi, kintu na gataḥ|</para>
  <para style="p">
    <verse number="31" style="v"/>ētayōḥ putrayō rmadhyē piturabhimataṁ kēna pālitaṁ? yuṣmābhiḥ kiṁ budhyatē? tatastē pratyūcuḥ, prathamēna puुtrēṇa| tadānīṁ yīśustānuvāca, ahaṁ yuṣmān tathyaṁ vadāmi, caṇḍālā gaṇikāśca yuṣmākamagrata īśvarasya rājyaṁ praviśanti|</para>
  <para style="p">
    <verse number="32" style="v"/>yatō yuṣmākaṁ samīpaṁ yōhani dharmmapathēnāgatē yūyaṁ taṁ na pratītha, kintu caṇḍālā gaṇikāśca taṁ pratyāyan, tad vilōkyāpi yūyaṁ pratyētuṁ nākhidyadhvaṁ|</para>
  <para style="p">
    <verse number="33" style="v"/>aparamēkaṁ dr̥ṣṭāntaṁ śr̥ṇuta, kaścid gr̥hasthaḥ kṣētrē drākṣālatā rōpayitvā taccaturdikṣu vāraṇīṁ vidhāya tanmadhyē drākṣāyantraṁ sthāpitavān, māñcañca nirmmitavān, tataḥ kr̥ṣakēṣu tat kṣētraṁ samarpya svayaṁ dūradēśaṁ jagāma|</para>
  <para style="p">
    <verse number="34" style="v"/>tadanantaraṁ phalasamaya upasthitē sa phalāni prāptuṁ kr̥ṣīvalānāṁ samīpaṁ nijadāsān prēṣayāmāsa|</para>
  <para style="p">
    <verse number="35" style="v"/>kintu kr̥ṣīvalāstasya tān dāsēyān dhr̥tvā kañcana prahr̥tavantaḥ, kañcana pāṣāṇairāhatavantaḥ, kañcana ca hatavantaḥ|</para>
  <para style="p">
    <verse number="36" style="v"/>punarapi sa prabhuḥ prathamatō'dhikadāsēyān prēṣayāmāsa, kintu tē tān pratyapi tathaiva cakruḥ|</para>
  <para style="p">
    <verse number="37" style="v"/>anantaraṁ mama sutē gatē taṁ samādariṣyantē, ityuktvā śēṣē sa nijasutaṁ tēṣāṁ sannidhiṁ prēṣayāmāsa|</para>
  <para style="p">
    <verse number="38" style="v"/>kintu tē kr̥ṣīvalāḥ sutaṁ vīkṣya parasparam iti mantrayitum ārēbhirē, ayamuttarādhikārī vayamēnaṁ nihatyāsyādhikāraṁ svavaśīkariṣyāmaḥ|</para>
  <para style="p">
    <verse number="39" style="v"/>paścāt tē taṁ dhr̥tvā drākṣākṣētrād bahiḥ pātayitvābadhiṣuḥ|</para>
  <para style="p">
    <verse number="40" style="v"/>yadā sa drākṣākṣētrapatirāgamiṣyati, tadā tān kr̥ṣīvalān kiṁ kariṣyati?</para>
  <para style="p">
    <verse number="41" style="v"/>tatastē pratyavadan, tān kaluṣiṇō dāruṇayātanābhirāhaniṣyati, yē ca samayānukramāt phalāni dāsyanti, tādr̥śēṣu kr̥ṣīvalēṣu kṣētraṁ samarpayiṣyati|</para>
  <para style="p">
    <verse number="42" style="v"/>tadā yīśunā tē gaditāḥ, grahaṇaṁ na kr̥taṁ yasya pāṣāṇasya nicāyakaiḥ| pradhānaprastaraḥ kōṇē saēva saṁbhaviṣyati| ētat parēśituḥ karmmāsmadr̥ṣṭāvadbhutaṁ bhavēt| dharmmagranthē likhitamētadvacanaṁ yuṣmābhiḥ kiṁ nāpāṭhi?</para>
  <para style="p">
    <verse number="43" style="v"/>tasmādahaṁ yuṣmān vadāmi, yuṣmatta īśvarīyarājyamapanīya phalōtpādayitranyajātayē dāyiṣyatē|</para>
  <para style="p">
    <verse number="44" style="v"/>yō jana ētatpāṣāṇōpari patiṣyati, taṁ sa bhaṁkṣyatē, kintvayaṁ pāṣāṇō yasyōpari patiṣyati, taṁ sa dhūlivat cūrṇīkariṣyati|</para>
  <para style="p">
    <verse number="45" style="v"/>tadānīṁ prādhanayājakāḥ phirūśinaśca tasyēmāṁ dr̥ṣṭāntakathāṁ śrutvā sō'smānuddiśya kathitavān, iti vijñāya taṁ dharttuṁ cēṣṭitavantaḥ;</para>
  <para style="p">
    <verse number="46" style="v"/>kintu lōkēbhyō bibhyuḥ, yatō lōkaiḥ sa bhaviṣyadvādītyajñāyi|</para>
  <chapter number="22" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ yīśuḥ punarapi dr̥ṣṭāntēna tān avādīt,</para>
  <para style="p">
    <verse number="2" style="v"/>svargīyarājyam ētādr̥śasya nr̥patēḥ samaṁ, yō nija putraṁ vivāhayan sarvvān nimantritān ānētuṁ dāsēyān prahitavān,</para>
  <para style="p">
    <verse number="3" style="v"/>kintu tē samāgantuṁ nēṣṭavantaḥ|</para>
  <para style="p">
    <verse number="4" style="v"/>tatō rājā punarapi dāsānanyān ityuktvā prēṣayāmāsa, nimantritān vadata, paśyata, mama bhējyamāsāditamāstē, nijavṭaṣādipuṣṭajantūn mārayitvā sarvvaṁ khādyadravyamāsāditavān, yūyaṁ vivāhamāgacchata|</para>
  <para style="p">
    <verse number="5" style="v"/>tathapi tē tucchīkr̥tya kēcit nijakṣētraṁ kēcid vāṇijyaṁ prati svasvamārgēṇa calitavantaḥ|</para>
  <para style="p">
    <verse number="6" style="v"/>anyē lōkāstasya dāsēyān dhr̥tvā daurātmyaṁ vyavahr̥tya tānavadhiṣuḥ|</para>
  <para style="p">
    <verse number="7" style="v"/>anantaraṁ sa nr̥patistāṁ vārttāṁ śrutvā krudhyan sainyāni prahitya tān ghātakān hatvā tēṣāṁ nagaraṁ dāhayāmāsa|</para>
  <para style="p">
    <verse number="8" style="v"/>tataḥ sa nijadāsēyān babhāṣē, vivāhīyaṁ bhōjyamāsāditamāstē, kintu nimantritā janā ayōgyāḥ|</para>
  <para style="p">
    <verse number="9" style="v"/>tasmād yūyaṁ rājamārgaṁ gatvā yāvatō manujān paśyata, tāvataēva vivāhīyabhōjyāya nimantrayata|</para>
  <para style="p">
    <verse number="10" style="v"/>tadā tē dāsēyā rājamārgaṁ gatvā bhadrān abhadrān vā yāvatō janān dadr̥śuḥ, tāvataēva saṁgr̥hyānayan; tatō'bhyāgatamanujai rvivāhagr̥ham apūryyata|</para>
  <para style="p">
    <verse number="11" style="v"/>tadānīṁ sa rājā sarvvānabhyāgatān draṣṭum abhyantaramāgatavān; tadā tatra vivāhīyavasanahīnamēkaṁ janaṁ vīkṣya taṁ jagād,</para>
  <para style="p">
    <verse number="12" style="v"/>hē mitra,tvaṁ vivāhīyavasanaṁ vinā kathamatra praviṣṭavān? tēna sa niruttarō babhūva|</para>
  <para style="p">
    <verse number="13" style="v"/>tadā rājā nijānucarān avadat, ētasya karacaraṇān baddhā yatra rōdanaṁ dantairdantagharṣaṇañca bhavati, tatra vahirbhūtatamisrē taṁ nikṣipata|</para>
  <para style="p">
    <verse number="14" style="v"/>itthaṁ bahava āhūtā alpē manōbhimatāḥ|</para>
  <para style="p">
    <verse number="15" style="v"/>anantaraṁ phirūśinaḥ pragatya yathā saṁlāpēna tam unmāthē pātayēyustathā mantrayitvā</para>
  <para style="p">
    <verse number="16" style="v"/>hērōdīyamanujaiḥ sākaṁ nijaśiṣyagaṇēna taṁ prati kathayāmāsuḥ, hē gurō, bhavān satyaḥ satyamīśvarīyamārgamupadiśati, kamapi mānuṣaṁ nānurudhyatē, kamapi nāpēkṣatē ca, tad vayaṁ jānīmaḥ|</para>
  <para style="p">
    <verse number="17" style="v"/>ataḥ kaisarabhūpāya karō'smākaṁ dātavyō na vā? atra bhavatā kiṁ budhyatē? tad asmān vadatu|</para>
  <para style="p">
    <verse number="18" style="v"/>tatō yīśustēṣāṁ khalatāṁ vijñāya kathitavān, rē kapaṭinaḥ yuyaṁ kutō māṁ parikṣadhvē?</para>
  <para style="p">
    <verse number="19" style="v"/>tatkaradānasya mudrāṁ māṁ darśayata| tadānīṁ taistasya samīpaṁ mudrācaturthabhāga ānītē</para>
  <para style="p">
    <verse number="20" style="v"/>sa tān papraccha, atra kasyēyaṁ mūrtti rnāma cāstē? tē jagaduḥ, kaisarabhūpasya|</para>
  <para style="p">
    <verse number="21" style="v"/>tataḥ sa uktavāna, kaisarasya yat tat kaisarāya datta, īśvarasya yat tad īśvarāya datta|</para>
  <para style="p">
    <verse number="22" style="v"/>iti vākyaṁ niśamya tē vismayaṁ vijñāya taṁ vihāya calitavantaḥ|</para>
  <para style="p">
    <verse number="23" style="v"/>tasminnahani sidūkinō'rthāt śmaśānāt nōtthāsyantīti vākyaṁ yē vadanti, tē yīśēाrantikam āgatya papracchuḥ,</para>
  <para style="p">
    <verse number="24" style="v"/>hē gurō, kaścinmanujaścēt niḥsantānaḥ san prāṇān tyajati, tarhi tasya bhrātā tasya jāyāṁ vyuhya bhrātuḥ santānam utpādayiṣyatīti mūsā ādiṣṭavān|</para>
  <para style="p">
    <verse number="25" style="v"/>kintvasmākamatra kē'pi janāḥ saptasahōdarā āsan, tēṣāṁ jyēṣṭha ēkāṁ kanyāṁ vyavahāt, aparaṁ prāṇatyāgakālē svayaṁ niḥsantānaḥ san tāṁ striyaṁ svabhrātari samarpitavān,</para>
  <para style="p">
    <verse number="26" style="v"/>tatō dvitīyādisaptamāntāśca tathaiva cakruḥ|</para>
  <para style="p">
    <verse number="27" style="v"/>śēṣē sāpī nārī mamāra|</para>
  <para style="p">
    <verse number="28" style="v"/>mr̥tānām utthānasamayē tēṣāṁ saptānāṁ madhyē sā nārī kasya bhāryyā bhaviṣyati? yasmāt sarvvaēva tāṁ vyavahan|</para>
  <para style="p">
    <verse number="29" style="v"/>tatō yīśuḥ pratyavādīt, yūyaṁ dharmmapustakam īśvarīyāṁ śaktiñca na vijñāya bhrāntimantaḥ|</para>
  <para style="p">
    <verse number="30" style="v"/>utthānaprāptā lōkā na vivahanti, na ca vācā dīyantē, kintvīśvarasya svargasthadūtānāṁ sadr̥śā bhavanti|</para>
  <para style="p">
    <verse number="31" style="v"/>aparaṁ mr̥tānāmutthānamadhi yuṣmān pratīyamīśvarōktiḥ,</para>
  <para style="p">
    <verse number="32" style="v"/>"ahamibrāhīma īśvara ishāka īśvarō yākūba īśvara" iti kiṁ yuṣmābhi rnāpāṭhi? kintvīśvarō jīvatām īśvara:, sa mr̥tānāmīśvarō nahi|</para>
  <para style="p">
    <verse number="33" style="v"/>iti śrutvā sarvvē lōkāstasyōpadēśād vismayaṁ gatāḥ|</para>
  <para style="p">
    <verse number="34" style="v"/>anantaraṁ sidūkinām niruttaratvavārtāṁ niśamya phirūśina ēkatra militavantaḥ,</para>
  <para style="p">
    <verse number="35" style="v"/>tēṣāmēkō vyavasthāpakō yīśuṁ parīkṣituṁ papaccha,</para>
  <para style="p">
    <verse number="36" style="v"/>hē gurō vyavasthāśāstramadhyē kājñā śrēṣṭhā?</para>
  <para style="p">
    <verse number="37" style="v"/>tatō yīśuruvāca, tvaṁ sarvvāntaḥkaraṇaiḥ sarvvaprāṇaiḥ sarvvacittaiśca sākaṁ prabhau paramēśvarē prīyasva,</para>
  <para style="p">
    <verse number="38" style="v"/>ēṣā prathamamahājñā| tasyāḥ sadr̥śī dvitīyājñaiṣā,</para>
  <para style="p">
    <verse number="39" style="v"/>tava samīpavāsini svātmanīva prēma kuru|</para>
  <para style="p">
    <verse number="40" style="v"/>anayō rdvayōrājñayōḥ kr̥tsnavyavasthāyā bhaviṣyadvaktr̥granthasya ca bhārastiṣṭhati|</para>
  <para style="p">
    <verse number="41" style="v"/>anantaraṁ phirūśinām ēkatra sthitikālē yīśustān papraccha,</para>
  <para style="p">
    <verse number="42" style="v"/>khrīṣṭamadhi yuṣmākaṁ kīdr̥gbōdhō jāyatē? sa kasya santānaḥ? tatastē pratyavadan, dāyūdaḥ santānaḥ|</para>
  <para style="p">
    <verse number="43" style="v"/>tadā sa uktavān, tarhi dāyūd katham ātmādhiṣṭhānēna taṁ prabhuṁ vadati ?</para>
  <para style="p">
    <verse number="44" style="v"/>yathā mama prabhumidaṁ vākyamavadat paramēśvaraḥ| tavārīn pādapīṭhaṁ tē yāvannahi karōmyahaṁ| tāvat kālaṁ madīyē tvaṁ dakṣapārśva upāviśa| atō yadi dāyūd taṁ prabhuṁ vadati, rtiha sa kathaṁ tasya santānō bhavati?</para>
  <para style="p">
    <verse number="45" style="v"/>tadānīṁ tēṣāṁ kōpi tadvākyasya kimapyuttaraṁ dātuṁ nāśaknōt;</para>
  <para style="p">
    <verse number="46" style="v"/>taddinamārabhya taṁ kimapi vākyaṁ praṣṭuṁ kasyāpi sāhasō nābhavat|</para>
  <chapter number="23" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ yīśu rjananivahaṁ śiṣyāṁścāvadat,</para>
  <para style="p">
    <verse number="2" style="v"/>adhyāpakāḥ phirūśinaśca mūsāsanē upaviśanti,</para>
  <para style="p">
    <verse number="3" style="v"/>atastē yuṣmān yadyat mantum ājñāpayanti, tat manyadhvaṁ pālayadhvañca, kintu tēṣāṁ karmmānurūpaṁ karmma na kurudhvaṁ; yatastēṣāṁ vākyamātraṁ sāraṁ kāryyē kimapi nāsti|</para>
  <para style="p">
    <verse number="4" style="v"/>tē durvvahān gurutarān bhārān badvvā manuṣyāṇāṁ skandhēpari samarpayanti, kintu svayamaṅgulyaikayāpi na cālayanti|</para>
  <para style="p">
    <verse number="5" style="v"/>kēvalaṁ lōkadarśanāya sarvvakarmmāṇi kurvvanti; phalataḥ paṭṭabandhān prasāryya dhārayanti, svavastrēṣu ca dīrghagranthīn dhārayanti;</para>
  <para style="p">
    <verse number="6" style="v"/>bhōjanabhavana uccasthānaṁ, bhajanabhavanē pradhānamāsanaṁ,</para>
  <para style="p">
    <verse number="7" style="v"/>haṭṭhē namaskāraṁ gururiti sambōdhanañcaitāni sarvvāṇi vāñchanti|</para>
  <para style="p">
    <verse number="8" style="v"/>kintu yūyaṁ gurava iti sambōdhanīyā mā bhavata, yatō yuṣmākam ēkaḥ khrīṣṭaēva guru</para>
  <para style="p">
    <verse number="9" style="v"/>ryūyaṁ sarvvē mithō bhrātaraśca| punaḥ pr̥thivyāṁ kamapi pitēti mā sambudhyadhvaṁ, yatō yuṣmākamēkaḥ svargasthaēva pitā|</para>
  <para style="p">
    <verse number="10" style="v"/>yūyaṁ nāyakēti sambhāṣitā mā bhavata, yatō yuṣmākamēkaḥ khrīṣṭaēva nāyakaḥ|</para>
  <para style="p">
    <verse number="11" style="v"/>aparaṁ yuṣmākaṁ madhyē yaḥ pumān śrēṣṭhaḥ sa yuṣmān sēviṣyatē|</para>
  <para style="p">
    <verse number="12" style="v"/>yatō yaḥ svamunnamati, sa nataḥ kariṣyatē; kintu yaḥ kaścit svamavanataṁ karōti, sa unnataḥ kariṣyatē|</para>
  <para style="p">
    <verse number="13" style="v"/>hanta kapaṭina upādhyāyāḥ phirūśinaśca, yūyaṁ manujānāṁ samakṣaṁ svargadvāraṁ rundha, yūyaṁ svayaṁ tēna na praviśatha, pravivikṣūnapi vārayatha| vata kapaṭina upādhyāyāḥ phirūśinaśca yūyaṁ chalād dīrghaṁ prārthya vidhavānāṁ sarvvasvaṁ grasatha, yuṣmākaṁ ghōrataradaṇḍō bhaviṣyati|</para>
  <para style="p">
    <verse number="14" style="v"/>hanta kapaṭina upādhyāyāḥ phirūśinaśca, yūyamēkaṁ svadharmmāvalambinaṁ karttuṁ sāgaraṁ bhūmaṇḍalañca pradakṣiṇīkurutha,</para>
  <para style="p">
    <verse number="15" style="v"/>kañcana prāpya svatō dviguṇanarakabhājanaṁ taṁ kurutha|</para>
  <para style="p">
    <verse number="16" style="v"/>vata andhapathadarśakāḥ sarvvē, yūyaṁ vadatha, mandirasya śapathakaraṇāt kimapi na dēyaṁ; kintu mandirasthasuvarṇasya śapathakaraṇād dēyaṁ|</para>
  <para style="p">
    <verse number="17" style="v"/>hē mūḍhā hē andhāḥ suvarṇaṁ tatsuvarṇapāvakamandiram ētayōrubhayō rmadhyē kiṁ śrēyaḥ?</para>
  <para style="p">
    <verse number="18" style="v"/>anyacca vadatha, yajñavēdyāḥ śapathakaraṇāt kimapi na dēyaṁ, kintu taduparisthitasya naivēdyasya śapathakaraṇād dēyaṁ|</para>
  <para style="p">
    <verse number="19" style="v"/>hē mūḍhā hē andhāḥ, naivēdyaṁ tannaivēdyapāvakavēdirētayōrubhayō rmadhyē kiṁ śrēyaḥ?</para>
  <para style="p">
    <verse number="20" style="v"/>ataḥ kēnacid yajñavēdyāḥ śapathē kr̥tē taduparisthasya sarvvasya śapathaḥ kriyatē|</para>
  <para style="p">
    <verse number="21" style="v"/>kēnacit mandirasya śapathē kr̥tē mandiratannivāsinōḥ śapathaḥ kriyatē|</para>
  <para style="p">
    <verse number="22" style="v"/>kēnacit svargasya śapathē kr̥tē īśvarīyasiṁhāsanataduparyyupaviṣṭayōḥ śapathaḥ kriyatē|</para>
  <para style="p">
    <verse number="23" style="v"/>hanta kapaṭina upādhyāyāḥ phirūśinaśca, yūyaṁ pōdināyāḥ sitacchatrāyā jīrakasya ca daśamāṁśān dattha, kintu vyavasthāyā gurutarān nyāyadayāviśvāsān parityajatha; imē yuṣmābhirācaraṇīyā amī ca na laṁghanīyāḥ|</para>
  <para style="p">
    <verse number="24" style="v"/>hē andhapathadarśakā yūyaṁ maśakān apasārayatha, kintu mahāṅgān grasatha|</para>
  <para style="p">
    <verse number="25" style="v"/>hanta kapaṭina upādhyāyāḥ phirūśinaśca, yūyaṁ pānapātrāṇāṁ bhōjanapātrāṇāñca bahiḥ pariṣkurutha; kintu tadabhyantaraṁ durātmatayā kaluṣēṇa ca paripūrṇamāstē|</para>
  <para style="p">
    <verse number="26" style="v"/>hē andhāḥ phirūśilōkā ādau pānapātrāṇāṁ bhōjanapātrāṇāñcābhyantaraṁ pariṣkuruta, tēna tēṣāṁ bahirapi pariṣkāriṣyatē|</para>
  <para style="p">
    <verse number="27" style="v"/>hanta kapaṭina upādhyāyāḥ phirūśinaśca, yūyaṁ śuklīkr̥taśmaśānasvarūpā bhavatha, yathā śmaśānabhavanasya bahiścāru, kintvabhyantaraṁ mr̥talōkānāṁ kīkaśaiḥ sarvvaprakāramalēna ca paripūrṇam;</para>
  <para style="p">
    <verse number="28" style="v"/>tathaiva yūyamapi lōkānāṁ samakṣaṁ bahirdhārmmikāḥ kintvantaḥkaraṇēṣu kēvalakāpaṭyādharmmābhyāṁ paripūrṇāḥ|</para>
  <para style="p">
    <verse number="29" style="v"/>hā hā kapaṭina upādhyāyāḥ phirūśinaśca, yūyaṁ bhaviṣyadvādināṁ śmaśānagēhaṁ nirmmātha, sādhūnāṁ śmaśānanikētanaṁ śōbhayatha</para>
  <para style="p">
    <verse number="30" style="v"/>vadatha ca yadi vayaṁ svēṣāṁ pūrvvapuruṣāṇāṁ kāla asthāsyāma, tarhi bhaviṣyadvādināṁ śōṇitapātanē tēṣāṁ sahabhāginō nābhaviṣyāma|</para>
  <para style="p">
    <verse number="31" style="v"/>atō yūyaṁ bhaviṣyadvādighātakānāṁ santānā iti svayamēva svēṣāṁ sākṣyaṁ dattha|</para>
  <para style="p">
    <verse number="32" style="v"/>atō yūyaṁ nijapūrvvapuruṣāṇāṁ parimāṇapātraṁ paripūrayata|</para>
  <para style="p">
    <verse number="33" style="v"/>rē bhujagāḥ kr̥ṣṇabhujagavaṁśāḥ, yūyaṁ kathaṁ narakadaṇḍād rakṣiṣyadhvē|</para>
  <para style="p">
    <verse number="34" style="v"/>paśyata, yuṣmākamantikam ahaṁ bhaviṣyadvādinō buddhimata upādhyāyāṁśca prēṣayiṣyāmi, kintu tēṣāṁ katipayā yuṣmābhi rghāniṣyantē, kruśē ca ghāniṣyantē, kēcid bhajanabhavanē kaṣābhirāghāniṣyantē, nagarē nagarē tāḍiṣyantē ca;</para>
  <para style="p">
    <verse number="35" style="v"/>tēna satpuruṣasya hābilō raktapātamārabhya bērikhiyaḥ putraṁ yaṁ sikhariyaṁ yūyaṁ mandirayajñavēdyō rmadhyē hatavantaḥ, tadīyaśōṇitapātaṁ yāvad asmin dēśē yāvatāṁ sādhupuruṣāṇāṁ śōṇitapātō 'bhavat tat sarvvēṣāmāgasāṁ daṇḍā yuṣmāsu varttiṣyantē|</para>
  <para style="p">
    <verse number="36" style="v"/>ahaṁ yuṣmānta tathyaṁ vadāmi, vidyamānē'smin puruṣē sarvvē varttiṣyantē|</para>
  <para style="p">
    <verse number="37" style="v"/>hē yirūśālam hē yirūśālam nagari tvaṁ bhaviṣyadvādinō hatavatī, tava samīpaṁ prēritāṁśca pāṣāṇairāhatavatī, yathā kukkuṭī śāvakān pakṣādhaḥ saṁgr̥hlāti, tathā tava santānān saṁgrahītuṁ ahaṁ bahuvāram aicchaṁ; kintu tvaṁ na samamanyathāḥ|</para>
  <para style="p">
    <verse number="38" style="v"/>paśyata yaṣmākaṁ vāsasthānam ucchinnaṁ tyakṣyatē|</para>
  <para style="p">
    <verse number="39" style="v"/>ahaṁ yuṣmān tathyaṁ vadāmi, yaḥ paramēśvarasya nāmnāgacchati, sa dhanya iti vāṇīṁ yāvanna vadiṣyatha, tāvat māṁ puna rna drakṣyatha|</para>
  <chapter number="24" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ yīśu ryadā mandirād bahi rgacchati, tadānīṁ śiṣyāstaṁ mandiranirmmāṇaṁ darśayitumāgatāḥ|</para>
  <para style="p">
    <verse number="2" style="v"/>tatō yīśustānuvāca, yūyaṁ kimētāni na paśyatha? yuṣmānahaṁ satyaṁ vadāmi, ētannicayanasya pāṣāṇaikamapyanyapāṣāṇēाpari na sthāsyati sarvvāṇi bhūmisāt kāriṣyantē|</para>
  <para style="p">
    <verse number="3" style="v"/>anantaraṁ tasmin jaitunaparvvatōpari samupaviṣṭē śiṣyāstasya samīpamāgatya guptaṁ papracchuḥ, ētā ghaṭanāḥ kadā bhaviṣyanti? bhavata āgamanasya yugāntasya ca kiṁ lakṣma? tadasmān vadatu|</para>
  <para style="p">
    <verse number="4" style="v"/>tadānīṁ yīśustānavōcat, avadhadvvaṁ, kōpi yuṣmān na bhramayēt|</para>
  <para style="p">
    <verse number="5" style="v"/>bahavō mama nāma gr̥hlanta āgamiṣyanti, khrīṣṭō'hamēvēti vācaṁ vadantō bahūn bhramayiṣyanti|</para>
  <para style="p">
    <verse number="6" style="v"/>yūyañca saṁgrāmasya raṇasya cāḍambaraṁ śrōṣyatha, avadhadvvaṁ tēna cañcalā mā bhavata, ētānyavaśyaṁ ghaṭiṣyantē, kintu tadā yugāntō nahi|</para>
  <para style="p">
    <verse number="7" style="v"/>aparaṁ dēśasya vipakṣō dēśō rājyasya vipakṣō rājyaṁ bhaviṣyati, sthānē sthānē ca durbhikṣaṁ mahāmārī bhūkampaśca bhaviṣyanti,</para>
  <para style="p">
    <verse number="8" style="v"/>ētāni duḥkhōpakramāḥ|</para>
  <para style="p">
    <verse number="9" style="v"/>tadānīṁ lōkā duḥkhaṁ bhōjayituṁ yuṣmān parakarēṣu samarpayiṣyanti haniṣyanti ca, tathā mama nāmakāraṇād yūyaṁ sarvvadēśīyamanujānāṁ samīpē ghr̥ṇārhā bhaviṣyatha|</para>
  <para style="p">
    <verse number="10" style="v"/>bahuṣu vighnaṁ prāptavatsu parasparam r̥ृtīyāṁ kr̥tavatsu ca ēkō'paraṁ parakarēṣu samarpayiṣyati|</para>
  <para style="p">
    <verse number="11" style="v"/>tathā bahavō mr̥ṣābhaviṣyadvādina upasthāya bahūn bhramayiṣyanti|</para>
  <para style="p">
    <verse number="12" style="v"/>duṣkarmmaṇāṁ bāhulyāñca bahūnāṁ prēma śītalaṁ bhaviṣyati|</para>
  <para style="p">
    <verse number="13" style="v"/>kintu yaḥ kaścit śēṣaṁ yāvad dhairyyamāśrayatē, saēva paritrāyiṣyatē|</para>
  <para style="p">
    <verse number="14" style="v"/>aparaṁ sarvvadēśīyalōkān pratimākṣī bhavituṁ rājasya śubhasamācāraḥ sarvvajagati pracāriṣyatē, ētādr̥śi sati yugānta upasthāsyati|</para>
  <para style="p">
    <verse number="15" style="v"/>atō yat sarvvanāśakr̥dghr̥ṇārhaṁ vastu dāniyēlbhaviṣyadvadinā prōktaṁ tad yadā puṇyasthānē sthāpitaṁ drakṣyatha, (yaḥ paṭhati, sa budhyatāṁ)</para>
  <para style="p">
    <verse number="16" style="v"/>tadānīṁ yē yihūdīyadēśē tiṣṭhanti, tē parvvatēṣu palāyantāṁ|</para>
  <para style="p">
    <verse number="17" style="v"/>yaḥ kaścid gr̥hapr̥ṣṭhē tiṣṭhati, sa gr̥hāt kimapi vastvānētum adhēा nāvarōhēt|</para>
  <para style="p">
    <verse number="18" style="v"/>yaśca kṣētrē tiṣṭhati, sōpi vastramānētuṁ parāvr̥tya na yāyāt|</para>
  <para style="p">
    <verse number="19" style="v"/>tadānīṁ garbhiṇīstanyapāyayitrīṇāṁ durgati rbhaviṣyati|</para>
  <para style="p">
    <verse number="20" style="v"/>atō yaṣmākaṁ palāyanaṁ śītakālē viśrāmavārē vā yanna bhavēt, tadarthaṁ prārthayadhvam|</para>
  <para style="p">
    <verse number="21" style="v"/>ā jagadārambhād ētatkālaparyyanantaṁ yādr̥śaḥ kadāpi nābhavat na ca bhaviṣyati tādr̥śō mahāklēśastadānīm upasthāsyati|</para>
  <para style="p">
    <verse number="22" style="v"/>tasya klēśasya samayō yadi hsvō na kriyēta, tarhi kasyāpi prāṇinō rakṣaṇaṁ bhavituṁ na śaknuyāt, kintu manōnītamanujānāṁ kr̥tē sa kālō hsvīkariṣyatē|</para>
  <para style="p">
    <verse number="23" style="v"/>aparañca paśyata, khrīṣṭō'tra vidyatē, vā tatra vidyatē, tadānīṁ yadī kaścid yuṣmāna iti vākyaṁ vadati, tathāpi tat na pratīt|</para>
  <para style="p">
    <verse number="24" style="v"/>yatō bhāktakhrīṣṭā bhāktabhaviṣyadvādinaśca upasthāya yāni mahanti lakṣmāṇi citrakarmmāṇi ca prakāśayiṣyanti, tai ryadi sambhavēt tarhi manōnītamānavā api bhrāmiṣyantē|</para>
  <para style="p">
    <verse number="25" style="v"/>paśyata, ghaṭanātaḥ pūrvvaṁ yuṣmān vārttām avādiṣam|</para>
  <para style="p">
    <verse number="26" style="v"/>ataḥ paśyata, sa prāntarē vidyata iti vākyē kēnacit kathitēpi bahi rmā gacchata, vā paśyata, sōntaḥpurē vidyatē, ētadvākya uktēpi mā pratīta|</para>
  <para style="p">
    <verse number="27" style="v"/>yatō yathā vidyut pūrvvadiśō nirgatya paścimadiśaṁ yāvat prakāśatē, tathā mānuṣaputrasyāpyāgamanaṁ bhaviṣyati|</para>
  <para style="p">
    <verse number="28" style="v"/>yatra śavastiṣṭhati, tatrēva gr̥dhrā milanti|</para>
  <para style="p">
    <verse number="29" style="v"/>aparaṁ tasya klēśasamayasyāvyavahitaparatra sūryyasya tējō lōpsyatē, candramā jyōsnāṁ na kariṣyati, nabhasō nakṣatrāṇi patiṣyanti, gagaṇīyā grahāśca vicaliṣyanti|</para>
  <para style="p">
    <verse number="30" style="v"/>tadānīm ākāśamadhyē manujasutasya lakṣma darśiṣyatē, tatō nijaparākramēṇa mahātējasā ca mēghārūḍhaṁ manujasutaṁ nabhasāgacchantaṁ vilōkya pr̥thivyāḥ sarvvavaṁśīyā vilapiṣyanti|</para>
  <para style="p">
    <verse number="31" style="v"/>tadānīṁ sa mahāśabdāyamānatūryyā vādakān nijadūtān prahēṣyati, tē vyōmna ēkasīmātō'parasīmāṁ yāvat caturdiśastasya manōnītajanān ānīya mēlayiṣyanti|</para>
  <para style="p">
    <verse number="32" style="v"/>uḍumbarapādapasya dr̥ṣṭāntaṁ śikṣadhvaṁ; yadā tasya navīnāḥ śākhā jāyantē, pallavādiśca nirgacchati, tadā nidāghakālaḥ savidhō bhavatīti yūyaṁ jānītha;</para>
  <para style="p">
    <verse number="33" style="v"/>tadvad ētā ghaṭanā dr̥ṣṭvā sa samayō dvāra upāsthād iti jānīta|</para>
  <para style="p">
    <verse number="34" style="v"/>yuṣmānahaṁ tathyaṁ vadāmi, idānīntanajanānāṁ gamanāt pūrvvamēva tāni sarvvāṇi ghaṭiṣyantē|</para>
  <para style="p">
    <verse number="35" style="v"/>nabhōmēdinyō rluptayōrapi mama vāk kadāpi na lōpsyatē|</para>
  <para style="p">
    <verse number="36" style="v"/>aparaṁ mama tātaṁ vinā mānuṣaḥ svargasthō dūtō vā kōpi taddinaṁ taddaṇḍañca na jñāpayati|</para>
  <para style="p">
    <verse number="37" style="v"/>aparaṁ nōhē vidyamānē yādr̥śamabhavat tādr̥śaṁ manujasutasyāgamanakālēpi bhaviṣyati|</para>
  <para style="p">
    <verse number="38" style="v"/>phalatō jalāplāvanāt pūrvvaṁ yaddinaṁ yāvat nōhaḥ pōtaṁ nārōhat, tāvatkālaṁ yathā manuṣyā bhōjanē pānē vivahanē vivāhanē ca pravr̥ttā āsan;</para>
  <para style="p">
    <verse number="39" style="v"/>aparam āplāvitōyamāgatya yāvat sakalamanujān plāvayitvā nānayat, tāvat tē yathā na vidāmāsuḥ, tathā manujasutāgamanēpi bhaviṣyati|</para>
  <para style="p">
    <verse number="40" style="v"/>tadā kṣētrasthitayōrdvayōrēkō dhāriṣyatē, aparastyājiṣyatē|</para>
  <para style="p">
    <verse number="41" style="v"/>tathā pēṣaṇyā piṁṣatyōrubhayō ryōṣitōrēkā dhāriṣyatē'parā tyājiṣyatē|</para>
  <para style="p">
    <verse number="42" style="v"/>yuṣmākaṁ prabhuḥ kasmin daṇḍa āgamiṣyati, tad yuṣmābhi rnāvagamyatē, tasmāt jāgrataḥ santastiṣṭhata|</para>
  <para style="p">
    <verse number="43" style="v"/>kutra yāmē stēna āgamiṣyatīti cēd gr̥hasthō jñātum aśakṣyat, tarhi jāgaritvā taṁ sandhiṁ karttitum avārayiṣyat tad jānīta|</para>
  <para style="p">
    <verse number="44" style="v"/>yuṣmābhiravadhīyatāṁ, yatō yuṣmābhi ryatra na budhyatē, tatraiva daṇḍē manujasuta āyāsyati|</para>
  <para style="p">
    <verse number="45" style="v"/>prabhu rnijaparivārān yathākālaṁ bhōjayituṁ yaṁ dāsam adhyakṣīkr̥tya sthāpayati, tādr̥śō viśvāsyō dhīmān dāsaḥ kaḥ?</para>
  <para style="p">
    <verse number="46" style="v"/>prabhurāgatya yaṁ dāsaṁ tathācarantaṁ vīkṣatē, saēva dhanyaḥ|</para>
  <para style="p">
    <verse number="47" style="v"/>yuṣmānahaṁ satyaṁ vadāmi, sa taṁ nijasarvvasvasyādhipaṁ kariṣyati|</para>
  <para style="p">
    <verse number="48" style="v"/>kintu prabhurāgantuṁ vilambata iti manasi cintayitvā yō duṣṭō dāsō</para>
  <para style="p">
    <verse number="49" style="v"/>'paradāsān praharttuṁ mattānāṁ saṅgē bhōktuṁ pātuñca pravarttatē,</para>
  <para style="p">
    <verse number="50" style="v"/>sa dāsō yadā nāpēkṣatē, yañca daṇḍaṁ na jānāti, tatkālaēva tatprabhurupasthāsyati|</para>
  <para style="p">
    <verse number="51" style="v"/>tadā taṁ daṇḍayitvā yatra sthānē rōdanaṁ dantagharṣaṇañcāsātē, tatra kapaṭibhiḥ sākaṁ taddaśāṁ nirūpayiṣyati|</para>
  <chapter number="25" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yā daśa kanyāḥ pradīpān gr̥hlatyō varaṁ sākṣāt karttuṁ bahiritāḥ, tābhistadā svargīyarājyasya sādr̥śyaṁ bhaviṣyati|</para>
  <para style="p">
    <verse number="2" style="v"/>tāsāṁ kanyānāṁ madhyē pañca sudhiyaḥ pañca durdhiya āsan|</para>
  <para style="p">
    <verse number="3" style="v"/>yā durdhiyastāḥ pradīpān saṅgē gr̥hītvā tailaṁ na jagr̥huḥ,</para>
  <para style="p">
    <verse number="4" style="v"/>kintu sudhiyaḥ pradīpān pātrēṇa tailañca jagr̥huḥ|</para>
  <para style="p">
    <verse number="5" style="v"/>anantaraṁ varē vilambitē tāḥ sarvvā nidrāviṣṭā nidrāṁ jagmuḥ|</para>
  <para style="p">
    <verse number="6" style="v"/>anantaram arddharātrē paśyata vara āgacchati, taṁ sākṣāt karttuṁ bahiryātēti janaravāt</para>
  <para style="p">
    <verse number="7" style="v"/>tāḥ sarvvāḥ kanyā utthāya pradīpān āsādayituṁ ārabhanta|</para>
  <para style="p">
    <verse number="8" style="v"/>tatō durdhiyaḥ sudhiya ūcuḥ, kiñcit tailaṁ datta, pradīpā asmākaṁ nirvvāṇāḥ|</para>
  <para style="p">
    <verse number="9" style="v"/>kintu sudhiyaḥ pratyavadan, dattē yuṣmānasmāṁśca prati tailaṁ nyūnībhavēt, tasmād vikrētr̥ṇāṁ samīpaṁ gatvā svārthaṁ tailaṁ krīṇīta|</para>
  <para style="p">
    <verse number="10" style="v"/>tadā tāsu krētuṁ gatāsu vara ājagāma, tatō yāḥ sajjitā āsan, tāstēna sākaṁ vivāhīyaṁ vēśma praviviśuḥ|</para>
  <para style="p">
    <verse number="11" style="v"/>anantaraṁ dvārē ruddhē aparāḥ kanyā āgatya jagaduḥ, hē prabhō, hē prabhō, asmān prati dvāraṁ mōcaya|</para>
  <para style="p">
    <verse number="12" style="v"/>kintu sa uktavān, tathyaṁ vadāmi, yuṣmānahaṁ na vēdmi|</para>
  <para style="p">
    <verse number="13" style="v"/>atō jāgrataḥ santastiṣṭhata, manujasutaḥ kasmin dinē kasmin daṇḍē vāgamiṣyati, tad yuṣmābhi rna jñāyatē|</para>
  <para style="p">
    <verse number="14" style="v"/>aparaṁ sa ētādr̥śaḥ kasyacit puṁsastulyaḥ, yō dūradēśaṁ prati yātrākālē nijadāsān āhūya tēṣāṁ svasvasāmarthyānurūpam</para>
  <para style="p">
    <verse number="15" style="v"/>ēkasmin mudrāṇāṁ pañca pōṭalikāḥ anyasmiṁśca dvē pōṭalikē aparasmiṁśca pōṭalikaikām itthaṁ pratijanaṁ samarpya svayaṁ pravāsaṁ gatavān|</para>
  <para style="p">
    <verse number="16" style="v"/>anantaraṁ yō dāsaḥ pañca pōṭalikāḥ labdhavān, sa gatvā vāṇijyaṁ vidhāya tā dviguṇīcakāra|</para>
  <para style="p">
    <verse number="17" style="v"/>yaśca dāsō dvē pōṭalikē alabhata, sōpi tā mudrā dviguṇīcakāra|</para>
  <para style="p">
    <verse number="18" style="v"/>kintu yō dāsa ēkāṁ pōṭalikāṁ labdhavān, sa gatvā bhūmiṁ khanitvā tanmadhyē nijaprabhōstā mudrā gōpayāñcakāra|</para>
  <para style="p">
    <verse number="19" style="v"/>tadanantaraṁ bahutithē kālē gatē tēṣāṁ dāsānāṁ prabhurāgatya tairdāsaiḥ samaṁ gaṇayāñcakāra|</para>
  <para style="p">
    <verse number="20" style="v"/>tadānīṁ yaḥ pañca pōṭalikāḥ prāptavān sa tā dviguṇīkr̥tamudrā ānīya jagāda; hē prabhō, bhavatā mayi pañca pōṭalikāḥ samarpitāḥ, paśyatu, tā mayā dviguṇīkr̥tāḥ|</para>
  <para style="p">
    <verse number="21" style="v"/>tadānīṁ tasya prabhustamuvāca, hē uttama viśvāsya dāsa, tvaṁ dhanyōsi, stōkēna viśvāsyō jātaḥ, tasmāt tvāṁ bahuvittādhipaṁ karōmi, tvaṁ svaprabhōḥ sukhasya bhāgī bhava|</para>
  <para style="p">
    <verse number="22" style="v"/>tatō yēna dvē pōṭalikē labdhē sōpyāgatya jagāda, hē prabhō, bhavatā mayi dvē pōṭalikē samarpitē, paśyatu tē mayā dviguṇīkr̥tē|</para>
  <para style="p">
    <verse number="23" style="v"/>tēna tasya prabhustamavōcat, hē uttama viśvāsya dāsa, tvaṁ dhanyōsi, stōkēna viśvāsyō jātaḥ, tasmāt tvāṁ bahudraviṇādhipaṁ karōmi, tvaṁ nijaprabhōḥ sukhasya bhāgī bhava|</para>
  <para style="p">
    <verse number="24" style="v"/>anantaraṁ ya ēkāṁ pōṭalikāṁ labdhavān, sa ētya kathitavān, hē prabhō, tvāṁ kaṭhinanaraṁ jñātavān, tvayā yatra nōptaṁ, tatraiva kr̥tyatē, yatra ca na kīrṇaṁ, tatraiva saṁgr̥hyatē|</para>
  <para style="p">
    <verse number="25" style="v"/>atōhaṁ saśaṅkaḥ san gatvā tava mudrā bhūmadhyē saṁgōpya sthāpitavān, paśya, tava yat tadēva gr̥hāṇa|</para>
  <para style="p">
    <verse number="26" style="v"/>tadā tasya prabhuḥ pratyavadat rē duṣṭālasa dāsa, yatrāhaṁ na vapāmi, tatra chinadmi, yatra ca na kirāmi, tatrēva saṁgr̥hlāmīti cēdajānāstarhi</para>
  <para style="p">
    <verse number="27" style="v"/>vaṇikṣu mama vittārpaṇaṁ tavōcitamāsīt, yēnāhamāgatya vr̥dvyā sākaṁ mūlamudrāḥ prāpsyam|</para>
  <para style="p">
    <verse number="28" style="v"/>atōsmāt tāṁ pōṭalikām ādāya yasya daśa pōṭalikāḥ santi tasminnarpayata|</para>
  <para style="p">
    <verse number="29" style="v"/>yēna vardvyatē tasminnaivārpiṣyatē, tasyaiva ca bāhulyaṁ bhaviṣyati, kintu yēna na vardvyatē, tasyāntikē yat kiñcana tiṣṭhati, tadapi punarnēṣyatē|</para>
  <para style="p">
    <verse number="30" style="v"/>aparaṁ yūyaṁ tamakarmmaṇyaṁ dāsaṁ nītvā yatra sthānē krandanaṁ dantagharṣaṇañca vidyētē, tasmin bahirbhūtatamasi nikṣipata|</para>
  <para style="p">
    <verse number="31" style="v"/>yadā manujasutaḥ pavitradūtān saṅginaḥ kr̥tvā nijaprabhāvēnāgatya nijatējōmayē siṁhāsanē nivēkṣyati,</para>
  <para style="p">
    <verse number="32" style="v"/>tadā tatsammukhē sarvvajātīyā janā saṁmēliṣyanti| tatō mēṣapālakō yathā chāgēbhyō'vīn pr̥thak karōti tathā sōpyēkasmādanyam itthaṁ tān pr̥thaka kr̥tvāvīn</para>
  <para style="p">
    <verse number="33" style="v"/>dakṣiṇē chāgāṁśca vāmē sthāpayiṣyati|</para>
  <para style="p">
    <verse number="34" style="v"/>tataḥ paraṁ rājā dakṣiṇasthitān mānavān vadiṣyati, āgacchata mattātasyānugrahabhājanāni, yuṣmatkr̥ta ā jagadārambhat yad rājyam āsāditaṁ tadadhikuruta|</para>
  <para style="p">
    <verse number="35" style="v"/>yatō bubhukṣitāya mahyaṁ bhōjyam adatta, pipāsitāya pēyamadatta, vidēśinaṁ māṁ svasthānamanayata,</para>
  <para style="p">
    <verse number="36" style="v"/>vastrahīnaṁ māṁ vasanaṁ paryyadhāpayata, pīḍītaṁ māṁ draṣṭumāgacchata, kārāsthañca māṁ vīkṣituma āgacchata|</para>
  <para style="p">
    <verse number="37" style="v"/>tadā dhārmmikāḥ prativadiṣyanti, hē prabhō, kadā tvāṁ kṣudhitaṁ vīkṣya vayamabhōjayāma? vā pipāsitaṁ vīkṣya apāyayāma?</para>
  <para style="p">
    <verse number="38" style="v"/>kadā vā tvāṁ vidēśinaṁ vilōkya svasthānamanayāma? kadā vā tvāṁ nagnaṁ vīkṣya vasanaṁ paryyadhāpayāma?</para>
  <para style="p">
    <verse number="39" style="v"/>kadā vā tvāṁ pīḍitaṁ kārāsthañca vīkṣya tvadantikamagacchāma?</para>
  <para style="p">
    <verse number="40" style="v"/>tadānīṁ rājā tān prativadiṣyati, yuṣmānahaṁ satyaṁ vadāmi, mamaitēṣāṁ bhrātr̥ṇāṁ madhyē kañcanaikaṁ kṣudratamaṁ prati yad akuruta, tanmāṁ pratyakuruta|</para>
  <para style="p">
    <verse number="41" style="v"/>paścāt sa vāmasthitān janān vadiṣyati, rē śāpagrastāḥ sarvvē, śaitānē tasya dūtēbhyaśca yō'nantavahnirāsādita āstē, yūyaṁ madantikāt tamagniṁ gacchata|</para>
  <para style="p">
    <verse number="42" style="v"/>yatō kṣudhitāya mahyamāhāraṁ nādatta, pipāsitāya mahyaṁ pēyaṁ nādatta,</para>
  <para style="p">
    <verse number="43" style="v"/>vidēśinaṁ māṁ svasthānaṁ nānayata, vasanahīnaṁ māṁ vasanaṁ na paryyadhāpayata, pīḍitaṁ kārāsthañca māṁ vīkṣituṁ nāgacchata|</para>
  <para style="p">
    <verse number="44" style="v"/>tadā tē prativadiṣyanti, hē prabhō, kadā tvāṁ kṣudhitaṁ vā pipāsitaṁ vā vidēśinaṁ vā nagnaṁ vā pīḍitaṁ vā kārāsthaṁ vīkṣya tvāṁ nāsēvāmahi?</para>
  <para style="p">
    <verse number="45" style="v"/>tadā sa tān vadiṣyati, tathyamahaṁ yuṣmān bravīmi, yuṣmābhirēṣāṁ kañcana kṣōdiṣṭhaṁ prati yannākāri, tanmāṁ pratyēva nākāri|</para>
  <para style="p">
    <verse number="46" style="v"/>paścādamyanantaśāstiṁ kintu dhārmmikā anantāyuṣaṁ bhōktuṁ yāsyanti|</para>
  <chapter number="26" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yīśurētān prastāvān samāpya śiṣyānūcē,</para>
  <para style="p">
    <verse number="2" style="v"/>yuṣmābhi rjñātaṁ dinadvayāt paraṁ nistāramaha upasthāsyati, tatra manujasutaḥ kruśēna hantuṁ parakarēṣu samarpiṣyatē|</para>
  <para style="p">
    <verse number="3" style="v"/>tataḥ paraṁ pradhānayājakādhyāpakaprāñcaḥ kiyaphānāmnō mahāyājakasyāṭṭālikāyāṁ militvā</para>
  <para style="p">
    <verse number="4" style="v"/>kēnōpāyēna yīśuṁ dhr̥tvā hantuṁ śaknuyuriti mantrayāñcakruḥ|</para>
  <para style="p">
    <verse number="5" style="v"/>kintu tairuktaṁ mahakālē na dharttavyaḥ, dhr̥tē prajānāṁ kalahēna bhavituṁ śakyatē|</para>
  <para style="p">
    <verse number="6" style="v"/>tatō baithaniyāpurē śimōnākhyasya kuṣṭhinō vēśmani yīśau tiṣṭhati</para>
  <para style="p">
    <verse number="7" style="v"/>kācana yōṣā śvētōpalabhājanēna mahārghyaṁ sugandhi tailamānīya bhōjanāyōpaviśatastasya śirōbhyaṣēcat|</para>
  <para style="p">
    <verse number="8" style="v"/>kintu tadālōkya tacchiṣyaiḥ kupitairuktaṁ, kuta itthamapavyayatē?</para>
  <para style="p">
    <verse number="9" style="v"/>cēdidaṁ vyakrēṣyata, tarhi bhūrimūlyaṁ prāpya daridrēbhyō vyatāriṣyata|</para>
  <para style="p">
    <verse number="10" style="v"/>yīśunā tadavagatya tē samuditāḥ, yōṣāmēnāṁ kutō duḥkhinīṁ kurutha, sā māṁ prati sādhu karmmākārṣīt|</para>
  <para style="p">
    <verse number="11" style="v"/>yuṣmākamaṁ samīpē daridrāḥ satatamēvāsatē, kintu yuṣmākamantikēhaṁ nāsē satataṁ|</para>
  <para style="p">
    <verse number="12" style="v"/>sā mama kāyōpari sugandhitailaṁ siktvā mama śmaśānadānakarmmākārṣīt|</para>
  <para style="p">
    <verse number="13" style="v"/>atōhaṁ yuṣmān tathyaṁ vadāmi sarvvasmin jagati yatra yatraiṣa susamācāraḥ pracāriṣyatē, tatra tatraitasyā nāryyāḥ smaraṇārtham karmmēdaṁ pracāriṣyatē|</para>
  <para style="p">
    <verse number="14" style="v"/>tatō dvādaśaśiṣyāṇām īṣkariyōtīyayihūdānāmaka ēkaḥ śiṣyaḥ pradhānayājakānāmantikaṁ gatvā kathitavān,</para>
  <para style="p">
    <verse number="15" style="v"/>yadi yuṣmākaṁ karēṣu yīśuṁ samarpayāmi, tarhi kiṁ dāsyatha? tadānīṁ tē tasmai triṁśanmudrā dātuṁ sthirīkr̥tavantaḥ|</para>
  <para style="p">
    <verse number="16" style="v"/>sa tadārabhya taṁ parakarēṣu samarpayituṁ suyōgaṁ cēṣṭitavān|</para>
  <para style="p">
    <verse number="17" style="v"/>anantaraṁ kiṇvaśūnyapūpaparvvaṇaḥ prathamēhni śiṣyā yīśum upagatya papracchuḥ bhavatkr̥tē kutra vayaṁ nistāramahabhōjyam āyōjayiṣyāmaḥ? bhavataḥ kēcchā?</para>
  <para style="p">
    <verse number="18" style="v"/>tadā sa gaditavān, madhyēnagaramamukapuṁsaḥ samīpaṁ vrajitvā vadata, guru rgaditavān, matkālaḥ savidhaḥ, saha śiṣyaistvadālayē nistāramahabhōjyaṁ bhōkṣyē|</para>
  <para style="p">
    <verse number="19" style="v"/>tadā śiṣyā yīśōstādr̥śanidēśānurūpakarmma vidhāya tatra nistāramahabhōjyamāsādayāmāsuḥ|</para>
  <para style="p">
    <verse number="20" style="v"/>tataḥ sandhyāyāṁ satyāṁ dvādaśabhiḥ śiṣyaiḥ sākaṁ sa nyaviśat|</para>
  <para style="p">
    <verse number="21" style="v"/>aparaṁ bhuñjāna uktavān yuṣmān tathyaṁ vadāmi, yuṣmākamēkō māṁ parakarēṣu samarpayiṣyati|</para>
  <para style="p">
    <verse number="22" style="v"/>tadā tē'tīva duḥkhitā ēkaikaśō vaktumārēbhirē, hē prabhō, sa kimahaṁ?</para>
  <para style="p">
    <verse number="23" style="v"/>tataḥ sa jagāda, mayā sākaṁ yō janō bhōjanapātrē karaṁ saṁkṣipati, sa ēva māṁ parakarēṣu samarpayiṣyati|</para>
  <para style="p">
    <verse number="24" style="v"/>manujasutamadhi yādr̥śaṁ likhitamāstē, tadanurūpā tadgati rbhaviṣyati; kintu yēna puṁsā sa parakarēṣu samarpayiṣyatē, hā hā cēt sa nājaniṣyata, tadā tasya kṣēmamabhaviṣyat|</para>
  <para style="p">
    <verse number="25" style="v"/>tadā yihūdānāmā yō janastaṁ parakarēṣu samarpayiṣyati, sa uktavān, hē gurō, sa kimahaṁ? tataḥ sa pratyuktavān, tvayā satyaṁ gaditam|</para>
  <para style="p">
    <verse number="26" style="v"/>anantaraṁ tēṣāmaśanakālē yīśuḥ pūpamādāyēśvarīyaguṇānanūdya bhaṁktvā śiṣyēbhyaḥ pradāya jagāda, madvapuḥsvarūpamimaṁ gr̥hītvā khādata|</para>
  <para style="p">
    <verse number="27" style="v"/>paścāt sa kaṁsaṁ gr̥hlan īśvarīyaguṇānanūdya tēbhyaḥ pradāya kathitavān, sarvvai ryuṣmābhiranēna pātavyaṁ,</para>
  <para style="p">
    <verse number="28" style="v"/>yasmādanēkēṣāṁ pāpamarṣaṇāya pātitaṁ yanmannūtnaniyamarūpaśōṇitaṁ tadētat|</para>
  <para style="p">
    <verse number="29" style="v"/>aparamahaṁ nūtnagōstanīrasaṁ na pāsyāmi, tāvat gōstanīphalarasaṁ punaḥ kadāpi na pāsyāmi|</para>
  <para style="p">
    <verse number="30" style="v"/>paścāt tē gītamēkaṁ saṁgīya jaitunākhyagiriṁ gatavantaḥ|</para>
  <para style="p">
    <verse number="31" style="v"/>tadānīṁ yīśustānavōcat, asyāṁ rajanyāmahaṁ yuṣmākaṁ sarvvēṣāṁ vighnarūpō bhaviṣyāmi, yatō likhitamāstē, "mēṣāṇāṁ rakṣakō yastaṁ prahariṣyāmyahaṁ tataḥ| mēṣāṇāṁ nivahō nūnaṁ pravikīrṇō bhaviṣyati"||</para>
  <para style="p">
    <verse number="32" style="v"/>kintu śmaśānāt samutthāya yuṣmākamagrē'haṁ gālīlaṁ gamiṣyāmi|</para>
  <para style="p">
    <verse number="33" style="v"/>pitarastaṁ prōvāca, bhavāṁścēt sarvvēṣāṁ vighnarūpō bhavati, tathāpi mama na bhaviṣyati|</para>
  <para style="p">
    <verse number="34" style="v"/>tatō yīśunā sa uktaḥ, tubhyamahaṁ tathyaṁ kathayāmi, yāminyāmasyāṁ caraṇāyudhasya ravāt pūrvvaṁ tvaṁ māṁ tri rnāṅgīkariṣyasi|</para>
  <para style="p">
    <verse number="35" style="v"/>tataḥ pitara uditavān, yadyapi tvayā samaṁ marttavyaṁ, tathāpi kadāpi tvāṁ na nāṅgīkariṣyāmi; tathaiva sarvvē śiṣyāścōcuḥ|</para>
  <para style="p">
    <verse number="36" style="v"/>anantaraṁ yīśuḥ śiṣyaiḥ sākaṁ gētśimānīnāmakaṁ sthānaṁ prasthāya tēbhyaḥ kathitavān, adaḥ sthānaṁ gatvā yāvadahaṁ prārthayiṣyē tāvad yūyamatrōpaviśata|</para>
  <para style="p">
    <verse number="37" style="v"/>paścāt sa pitaraṁ sivadiyasutau ca saṅginaḥ kr̥tvā gatavān, śōkākulō'tīva vyathitaśca babhūva|</para>
  <para style="p">
    <verse number="38" style="v"/>tānavādīcca mr̥tiyātanēva matprāṇānāṁ yātanā jāyatē, yūyamatra mayā sārddhaṁ jāgr̥ta|</para>
  <para style="p">
    <verse number="39" style="v"/>tataḥ sa kiñciddūraṁ gatvādhōmukhaḥ patan prārthayāñcakrē, hē matpitaryadi bhavituṁ śaknōti, tarhi kaṁsō'yaṁ mattō dūraṁ yātu; kintu madicchāvat na bhavatu, tvadicchāvad bhavatu|</para>
  <para style="p">
    <verse number="40" style="v"/>tataḥ sa śiṣyānupētya tān nidratō nirīkṣya pitarāya kathayāmāsa, yūyaṁ mayā sākaṁ daṇḍamēkamapi jāgarituṁ nāśankuta?</para>
  <para style="p">
    <verse number="41" style="v"/>parīkṣāyāṁ na patituṁ jāgr̥ta prārthayadhvañca; ātmā samudyatōsti, kintu vapu rdurbbalaṁ|</para>
  <para style="p">
    <verse number="42" style="v"/>sa dvitīyavāraṁ prārthayāñcakrē, hē mattāta, na pītē yadi kaṁsamidaṁ mattō dūraṁ yātuṁ na śaknōti, tarhi tvadicchāvad bhavatu|</para>
  <para style="p">
    <verse number="43" style="v"/>sa punarētya tān nidratō dadarśa, yatastēṣāṁ nētrāṇi nidrayā pūrṇānyāsan|</para>
  <para style="p">
    <verse number="44" style="v"/>paścāt sa tān vihāya vrajitvā tr̥tīyavāraṁ pūrvvavat kathayan prārthitavān|</para>
  <para style="p">
    <verse number="45" style="v"/>tataḥ śiṣyānupāgatya gaditavān, sāmprataṁ śayānāḥ kiṁ viśrāmyatha? paśyata, samaya upāsthāt, manujasutaḥ pāpināṁ karēṣu samarpyatē|</para>
  <para style="p">
    <verse number="46" style="v"/>uttiṣṭhata, vayaṁ yāmaḥ, yō māṁ parakarēṣu masarpayiṣyati, paśyata, sa samīpamāyāti|</para>
  <para style="p">
    <verse number="47" style="v"/>ētatkathākathanakālē dvādaśaśiṣyāṇāmēkō yihūdānāmakō mukhyayājakalōkaprācīnaiḥ prahitān asidhāriyaṣṭidhāriṇō manujān gr̥hītvā tatsamīpamupatasthau|</para>
  <para style="p">
    <verse number="48" style="v"/>asau parakarēṣvarpayitā pūrvvaṁ tān itthaṁ saṅkētayāmāsa, yamahaṁ cumbiṣyē, sō'sau manujaḥ,saēva yuṣmābhi rdhāryyatāṁ|</para>
  <para style="p">
    <verse number="49" style="v"/>tadā sa sapadi yīśumupāgatya hē gurō, praṇamāmītyuktvā taṁ cucumbē|</para>
  <para style="p">
    <verse number="50" style="v"/>tadā yīśustamuvāca, hē mitraṁ kimarthamāgatōsi? tadā tairāgatya yīśurākramya daghrē|</para>
  <para style="p">
    <verse number="51" style="v"/>tatō yīśōḥ saṅgināmēkaḥ karaṁ prasāryya kōṣādasiṁ bahiṣkr̥tya mahāyājakasya dāsamēkamāhatya tasya karṇaṁ cicchēda|</para>
  <para style="p">
    <verse number="52" style="v"/>tatō yīśustaṁ jagāda, khaḍgaṁ svasthānēे nidhēhi yatō yē yē janā asiṁ dhārayanti, taēvāsinā vinaśyanti|</para>
  <para style="p">
    <verse number="53" style="v"/>aparaṁ pitā yathā madantikaṁ svargīyadūtānāṁ dvādaśavāhinītō'dhikaṁ prahiṇuyāt mayā tamuddiśyēdānīmēva tathā prārthayituṁ na śakyatē, tvayā kimitthaṁ jñāyatē?</para>
  <para style="p">
    <verse number="54" style="v"/>tathā satītthaṁ ghaṭiṣyatē dharmmapustakasya yadidaṁ vākyaṁ tat kathaṁ sidhyēt?</para>
  <para style="p">
    <verse number="55" style="v"/>tadānīṁ yīśu rjananivahaṁ jagāda, yūyaṁ khaḍgayaṣṭīn ādāya māṁ kiṁ cauraṁ dharttumāyātāḥ? ahaṁ pratyahaṁ yuṣmābhiḥ sākamupaviśya samupādiśaṁ, tadā māṁ nādharata;</para>
  <para style="p">
    <verse number="56" style="v"/>kintu bhaviṣyadvādināṁ vākyānāṁ saṁsiddhayē sarvvamētadabhūt|tadā sarvvē śiṣyāstaṁ vihāya palāyanta|</para>
  <para style="p">
    <verse number="57" style="v"/>anantaraṁ tē manujā yīśuṁ dhr̥tvā yatrādhyāpakaprāñcaḥ pariṣadaṁ kurvvanta upāviśan tatra kiyaphānāाmakamahāyājakasyāntikaṁ ninyuḥ|</para>
  <para style="p">
    <verse number="58" style="v"/>kintu śēṣē kiṁ bhaviṣyatīti vēttuṁ pitarō dūrē tatpaścād vrajitvā mahāyājakasyāṭṭālikāṁ praviśya dāsaiḥ sahita upāviśat|</para>
  <para style="p">
    <verse number="59" style="v"/>tadānīṁ pradhānayājakaprācīnamantriṇaḥ sarvvē yīśuṁ hantuṁ mr̥ṣāsākṣyam alipsanta,</para>
  <para style="p">
    <verse number="60" style="v"/>kintu na lēbhirē| anēkēṣu mr̥ṣāsākṣiṣvāgatēṣvapi tanna prāpuḥ|</para>
  <para style="p">
    <verse number="61" style="v"/>śēṣē dvau mr̥ṣāsākṣiṇāvāgatya jagadatuḥ, pumānayamakathayat, ahamīśvaramandiraṁ bhaṁktvā dinatrayamadhyē tannirmmātuṁ śaknōmi|</para>
  <para style="p">
    <verse number="62" style="v"/>tadā mahāyājaka utthāya yīśum avādīt| tvaṁ kimapi na prativadasi? tvāmadhi kimētē sākṣyaṁ vadanti?</para>
  <para style="p">
    <verse number="63" style="v"/>kintu yīśu rmaunībhūya tasyau| tatō mahāyājaka uktavān, tvām amarēśvaranāmnā śapayāmi, tvamīśvarasya putrō'bhiṣiktō bhavasi navēti vada|</para>
  <para style="p">
    <verse number="64" style="v"/>yīśuḥ pratyavadat, tvaṁ satyamuktavān; ahaṁ yuṣmān tathyaṁ vadāmi, itaḥparaṁ manujasutaṁ sarvvaśaktimatō dakṣiṇapārśvē sthātuṁ gagaṇasthaṁ jaladharānāruhyāyāntaṁ vīkṣadhvē|</para>
  <para style="p">
    <verse number="65" style="v"/>tadā mahāyājakō nijavasanaṁ chittvā jagāda, ēṣa īśvaraṁ ninditavān, asmākamaparasākṣyēṇa kiṁ prayōjanaṁ? paśyata, yūyamēvāsyāsyād īśvaranindāṁ śrutavantaḥ,</para>
  <para style="p">
    <verse number="66" style="v"/>yuṣmābhiḥ kiṁ vivicyatē? tē pratyūcuḥ, vadhārhō'yaṁ|</para>
  <para style="p">
    <verse number="67" style="v"/>tatō lōkaistadāsyē niṣṭhīvitaṁ kēcit pratalamāhatya kēcicca capēṭamāhatya babhāṣirē,</para>
  <para style="p">
    <verse number="68" style="v"/>hē khrīṣṭa tvāṁ kaścapēṭamāhatavān? iti gaṇayitvā vadāsmān|</para>
  <para style="p">
    <verse number="69" style="v"/>pitarō bahiraṅgana upaviśati, tadānīmēkā dāsī tamupāgatya babhāṣē, tvaṁ gālīlīyayīśōḥ sahacaraēkaḥ|</para>
  <para style="p">
    <verse number="70" style="v"/>kintu sa sarvvēṣāṁ samakṣam anaṅgīkr̥tyāvādīt, tvayā yaducyatē, tadarthamahaṁ na vēdmi|</para>
  <para style="p">
    <verse number="71" style="v"/>tadā tasmin bahirdvāraṁ gatē 'nyā dāsī taṁ nirīkṣya tatratyajanānavadat, ayamapi nāsaratīyayīśunā sārddham āsīt|</para>
  <para style="p">
    <verse number="72" style="v"/>tataḥ sa śapathēna punaranaṅgīkr̥tya kathitavān, taṁ naraṁ na paricinōmi|</para>
  <para style="p">
    <verse number="73" style="v"/>kṣaṇāt paraṁ tiṣṭhantō janā ētya pitaram avadan, tvamavaśyaṁ tēṣāmēka iti tvaduccāraṇamēva dyōtayati|</para>
  <para style="p">
    <verse number="74" style="v"/>kintu sō'bhiśapya kathitavān, taṁ janaṁ nāhaṁ paricinōmi, tadā sapadi kukkuṭō rurāva|</para>
  <para style="p">
    <verse number="75" style="v"/>kukkuṭaravāt prāk tvaṁ māṁ trirapāhnōṣyasē, yaiṣā vāg yīśunāvādi tāṁ pitaraḥ saṁsmr̥tya bahiritvā khēdād bhr̥śaṁ cakranda|</para>
  <chapter number="27" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>prabhātē jātē pradhānayājakalōkaprācīnā yīśuṁ hantuṁ tatpratikūlaṁ mantrayitvā</para>
  <para style="p">
    <verse number="2" style="v"/>taṁ badvvā nītvā pantīyapīlātākhyādhipē samarpayāmāsuḥ|</para>
  <para style="p">
    <verse number="3" style="v"/>tatō yīśōḥ parakarēvvarpayitā yihūdāstatprāṇādaṇḍājñāṁ viditvā santaptamanāḥ pradhānayājakalōkaprācīnānāṁ samakṣaṁ tāstrīṁśanmudrāḥ pratidāyāvādīt,</para>
  <para style="p">
    <verse number="4" style="v"/>ētannirāgōnaraprāṇaparakarārpaṇāt kaluṣaṁ kr̥tavānahaṁ| tadā ta uditavantaḥ, tēnāsmākaṁ kiṁ? tvayā tad budhyatām|</para>
  <para style="p">
    <verse number="5" style="v"/>tatō yihūdā mandiramadhyē tā mudrā nikṣipya prasthitavān itvā ca svayamātmānamudbabandha|</para>
  <para style="p">
    <verse number="6" style="v"/>paścāt pradhānayājakāstā mudrā ādāya kathitavantaḥ, ētā mudrāḥ śōṇitamūlyaṁ tasmād bhāṇḍāgārē na nidhātavyāḥ|</para>
  <para style="p">
    <verse number="7" style="v"/>anantaraṁ tē mantrayitvā vidēśināṁ śmaśānasthānāya tābhiḥ kulālasya kṣētramakrīṇan|</para>
  <para style="p">
    <verse number="8" style="v"/>atō'dyāpi tatsthānaṁ raktakṣētraṁ vadanti|</para>
  <para style="p">
    <verse number="9" style="v"/>itthaṁ sati isrāyēlīyasantānai ryasya mūlyaṁ nirupitaṁ, tasya triṁśanmudrāmānaṁ mūlyaṁ</para>
  <para style="p">
    <verse number="10" style="v"/>māṁ prati paramēśvarasyādēśāt tēbhya ādīyata, tēna ca kulālasya kṣētraṁ krītamiti yadvacanaṁ yirimiyabhaviṣyadvādinā prōktaṁ tat tadāsidhyat|</para>
  <para style="p">
    <verse number="11" style="v"/>anantaraṁ yīśau tadadhipatēḥ sammukha upatiṣṭhati sa taṁ papraccha, tvaṁ kiṁ yihūdīyānāṁ rājā? tadā yīśustamavadat, tvaṁ satyamuktavān|</para>
  <para style="p">
    <verse number="12" style="v"/>kintu pradhānayājakaprācīnairabhiyuktēna tēna kimapi na pratyavādi|</para>
  <para style="p">
    <verse number="13" style="v"/>tataḥ pīlātēna sa uditaḥ, imē tvatpratikūlataḥ kati kati sākṣyaṁ dadati, tat tvaṁ na śr̥ṇōṣi?</para>
  <para style="p">
    <verse number="14" style="v"/>tathāpi sa tēṣāmēkasyāpi vacasa uttaraṁ nōditavān; tēna sō'dhipati rmahācitraṁ vidāmāsa|</para>
  <para style="p">
    <verse number="15" style="v"/>anyacca tanmahakālē'dhipatērētādr̥śī rātirāsīt, prajā yaṁ kañcana bandhinaṁ yācantē, tamēva sa mōcayatīti|</para>
  <para style="p">
    <verse number="16" style="v"/>tadānīṁ barabbānāmā kaścit khyātabandhyāsīt|</para>
  <para style="p">
    <verse number="17" style="v"/>tataḥ pīlātastatra militān lōkān apr̥cchat, ēṣa barabbā bandhī khrīṣṭavikhyātō yīśuścaitayōḥ kaṁ mōcayiṣyāmi? yuṣmākaṁ kimīpsitaṁ?</para>
  <para style="p">
    <verse number="18" style="v"/>tairīrṣyayā sa samarpita iti sa jñātavān|</para>
  <para style="p">
    <verse number="19" style="v"/>aparaṁ vicārāsanōpavēśanakālē pīlātasya patnī bhr̥tyaṁ prahitya tasmai kathayāmāsa, taṁ dhārmmikamanujaṁ prati tvayā kimapi na karttavyaṁ; yasmāt tatkr̥tē'dyāhaṁ svapnē prabhūtakaṣṭamalabhē|</para>
  <para style="p">
    <verse number="20" style="v"/>anantaraṁ pradhānayājakaprācīnā barabbāṁ yācitvādātuṁ yīśuñca hantuṁ sakalalōkān prāvarttayan|</para>
  <para style="p">
    <verse number="21" style="v"/>tatō'dhipatistān pr̥ṣṭavān, ētayōḥ kamahaṁ mōcayiṣyāmi? yuṣmākaṁ kēcchā? tē prōcu rbarabbāṁ|</para>
  <para style="p">
    <verse number="22" style="v"/>tadā pīlātaḥ papraccha, tarhi yaṁ khrīṣṭaṁ vadanti, taṁ yīśuṁ kiṁ kariṣyāmi? sarvvē kathayāmāsuḥ, sa kruśēna vidhyatāṁ|</para>
  <para style="p">
    <verse number="23" style="v"/>tatō'dhipatiravādīt, kutaḥ? kiṁ tēnāparāddhaṁ? kintu tē punarucai rjagaduḥ, sa kruśēna vidhyatāṁ|</para>
  <para style="p">
    <verse number="24" style="v"/>tadā nijavākyamagrāhyamabhūt, kalahaścāpyabhūt, pīlāta iti vilōkya lōkānāṁ samakṣaṁ tōyamādāya karau prakṣālyāvōcat, ētasya dhārmmikamanuṣyasya śōṇitapātē nirdōṣō'haṁ, yuṣmābhirēva tad budhyatāṁ|</para>
  <para style="p">
    <verse number="25" style="v"/>tadā sarvvāḥ prajāḥ pratyavōcan, tasya śōṇitapātāparādhō'smākam asmatsantānānāñcōpari bhavatu|</para>
  <para style="p">
    <verse number="26" style="v"/>tataḥ sa tēṣāṁ samīpē barabbāṁ mōcayāmāsa yīśuntu kaṣābhirāhatya kruśēna vēdhituṁ samarpayāmāsa|</para>
  <para style="p">
    <verse number="27" style="v"/>anantaram adhipatēḥ sēnā adhipatē rgr̥haṁ yīśumānīya tasya samīpē sēnāsamūhaṁ saṁjagr̥huḥ|</para>
  <para style="p">
    <verse number="28" style="v"/>tatastē tasya vasanaṁ mōcayitvā kr̥ṣṇalōhitavarṇavasanaṁ paridhāpayāmāsuḥ</para>
  <para style="p">
    <verse number="29" style="v"/>kaṇṭakānāṁ mukuṭaṁ nirmmāya tacchirasi daduḥ, tasya dakṣiṇakarē vētramēkaṁ dattvā tasya sammukhē jānūni pātayitvā, hē yihūdīyānāṁ rājan, tubhyaṁ nama ityuktvā taṁ tiraścakruḥ,</para>
  <para style="p">
    <verse number="30" style="v"/>tatastasya gātrē niṣṭhīvaṁ datvā tēna vētrēṇa śira ājaghnuḥ|</para>
  <para style="p">
    <verse number="31" style="v"/>itthaṁ taṁ tiraskr̥tya tad vasanaṁ mōcayitvā punarnijavasanaṁ paridhāpayāñcakruḥ, taṁ kruśēna vēdhituṁ nītavantaḥ|</para>
  <para style="p">
    <verse number="32" style="v"/>paścāttē bahirbhūya kurīṇīyaṁ śimōnnāmakamēkaṁ vilōkya kruśaṁ vōḍhuṁ tamādadirē|</para>
  <para style="p">
    <verse number="33" style="v"/>anantaraṁ gulgaltām arthāt śiraskapālanāmakasthānamu pasthāya tē yīśavē pittamiśritāmlarasaṁ pātuṁ daduḥ,</para>
  <para style="p">
    <verse number="34" style="v"/>kintu sa tamāsvādya na papau|</para>
  <para style="p">
    <verse number="35" style="v"/>tadānīṁ tē taṁ kruśēna saṁvidhya tasya vasanāni guṭikāpātēna vibhajya jagr̥huḥ, tasmāt, vibhajantē'dharīyaṁ mē tē manuṣyāḥ parasparaṁ| maduttarīyavastrārthaṁ guṭikāṁ pātayanti ca||yadētadvacanaṁ bhaviṣyadvādibhiruktamāsīt, tadā tad asidhyat,</para>
  <para style="p">
    <verse number="36" style="v"/>paścāt tē tatrōpaviśya tadrakṣaṇakarvvaṇi niyuktāstasthuḥ|</para>
  <para style="p">
    <verse number="37" style="v"/>aparam ēṣa yihūdīyānāṁ rājā yīśurityapavādalipipatraṁ tacchirasa ūrdvvē yōjayāmāsuḥ|</para>
  <para style="p">
    <verse number="38" style="v"/>tatastasya vāmē dakṣiṇē ca dvau cairau tēna sākaṁ kruśēna vividhuḥ|</para>
  <para style="p">
    <verse number="39" style="v"/>tadā pānthā nijaśirō lāḍayitvā taṁ nindantō jagaduḥ,</para>
  <para style="p">
    <verse number="40" style="v"/>hē īśvaramandirabhañjaka dinatrayē tannirmmātaḥ svaṁ rakṣa, cēttvamīśvarasutastarhi kruśādavarōha|</para>
  <para style="p">
    <verse number="41" style="v"/>pradhānayājakādhyāpakaprācīnāśca tathā tiraskr̥tya jagaduḥ,</para>
  <para style="p">
    <verse number="42" style="v"/>sō'nyajanānāvat, kintu svamavituṁ na śaknōti| yadīsrāyēlō rājā bhavēt, tarhīdānīmēva kruśādavarōhatu, tēna taṁ vayaṁ pratyēṣyāmaḥ|</para>
  <para style="p">
    <verse number="43" style="v"/>sa īśvarē pratyāśāmakarōt, yadīśvarastasmin santuṣṭastarhīdānīmēva tamavēt, yataḥ sa uktavān ahamīśvarasutaḥ|</para>
  <para style="p">
    <verse number="44" style="v"/>yau stēnau sākaṁ tēna kruśēna viddhau tau tadvadēva taṁ ninindatuḥ|</para>
  <para style="p">
    <verse number="45" style="v"/>tadā dvitīyayāmāt tr̥tīyayāmaṁ yāvat sarvvadēśē tamiraṁ babhūva,</para>
  <para style="p">
    <verse number="46" style="v"/>tr̥tīyayāmē "ēlī ēlī lāmā śivaktanī", arthāt madīśvara madīśvara kutō māmatyākṣīḥ? yīśuruccairiti jagāda|</para>
  <para style="p">
    <verse number="47" style="v"/>tadā tatra sthitāḥ kēcit tat śrutvā babhāṣirē, ayam ēliyamāhūyati|</para>
  <para style="p">
    <verse number="48" style="v"/>tēṣāṁ madhyād ēkaḥ śīghraṁ gatvā spañjaṁ gr̥hītvā tatrāmlarasaṁ dattvā nalēna pātuṁ tasmai dadau|</para>
  <para style="p">
    <verse number="49" style="v"/>itarē'kathayan tiṣṭhata, taṁ rakṣitum ēliya āyāti navēti paśyāmaḥ|</para>
  <para style="p">
    <verse number="50" style="v"/>yīśuḥ punarucairāhūya prāṇān jahau|</para>
  <para style="p">
    <verse number="51" style="v"/>tatō mandirasya vicchēdavasanam ūrdvvādadhō yāvat chidyamānaṁ dvidhābhavat,</para>
  <para style="p">
    <verse number="52" style="v"/>bhūmiścakampē bhūdharōvyadīryyata ca| śmaśānē muktē bhūripuṇyavatāṁ suptadēhā udatiṣṭhan,</para>
  <para style="p">
    <verse number="53" style="v"/>śmaśānād vahirbhūya tadutthānāt paraṁ puṇyapuraṁ gatvā bahujanān darśayāmāsuḥ|</para>
  <para style="p">
    <verse number="54" style="v"/>yīśurakṣaṇāya niyuktaḥ śatasēnāpatistatsaṅginaśca tādr̥śīṁ bhūkampādighaṭanāṁ dr̥ṣṭvā bhītā avadan, ēṣa īśvaraputrō bhavati|</para>
  <para style="p">
    <verse number="55" style="v"/>yā bahuyōṣitō yīśuṁ sēvamānā gālīlastatpaścādāgatāstāsāṁ madhyē</para>
  <para style="p">
    <verse number="56" style="v"/>magdalīnī mariyam yākūbyōśyō rmātā yā mariyam sibadiyaputrayō rmātā ca yōṣita ētā dūrē tiṣṭhantyō dadr̥śuḥ|</para>
  <para style="p">
    <verse number="57" style="v"/>sandhyāyāṁ satyam arimathiyānagarasya yūṣaphnāmā dhanī manujō yīśōḥ śiṣyatvāt</para>
  <para style="p">
    <verse number="58" style="v"/>pīlātasya samīpaṁ gatvā yīśōḥ kāyaṁ yayācē, tēna pīlātaḥ kāyaṁ dātum ādidēśa|</para>
  <para style="p">
    <verse number="59" style="v"/>yūṣaph tatkāyaṁ nītvā śucivastrēṇācchādya</para>
  <para style="p">
    <verse number="60" style="v"/>svārthaṁ śailē yat śmaśānaṁ cakhāna, tanmadhyē tatkāyaṁ nidhāya tasya dvāri vr̥hatpāṣāṇaṁ dadau|</para>
  <para style="p">
    <verse number="61" style="v"/>kintu magdalīnī mariyam anyamariyam ētē striyau tatra śmaśānasammukha upaviviśatuḥ|</para>
  <para style="p">
    <verse number="62" style="v"/>tadanantaraṁ nistārōtsavasyāyōjanadināt parē'hani pradhānayājakāḥ phirūśinaśca militvā pīlātamupāgatyākathayan,</para>
  <para style="p">
    <verse number="63" style="v"/>hē mahēccha sa pratārakō jīvana akathayat, dinatrayāt paraṁ śmaśānādutthāsyāmi tadvākyaṁ smarāmō vayaṁ;</para>
  <para style="p">
    <verse number="64" style="v"/>tasmāt tr̥tīyadinaṁ yāvat tat śmaśānaṁ rakṣitumādiśatu, nōcēt tacchiṣyā yāminyāmāgatya taṁ hr̥tvā lōkān vadiṣyanti, sa śmaśānādudatiṣṭhat, tathā sati prathamabhrāntēḥ śēṣīyabhrānti rmahatī bhaviṣyati|</para>
  <para style="p">
    <verse number="65" style="v"/>tadā pīlāta avādīt, yuṣmākaṁ samīpē rakṣigaṇa āstē, yūyaṁ gatvā yathā sādhyaṁ rakṣayata|</para>
  <para style="p">
    <verse number="66" style="v"/>tatastē gatvā taddūाrapāṣāṇaṁ mudrāṅkitaṁ kr̥tvā rakṣigaṇaṁ niyōjya śmaśānaṁ rakṣayāmāsuḥ|</para>
  <chapter number="28" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tataḥ paraṁ viśrāmavārasya śēṣē saptāhaprathamadinasya prabhōtē jātē magdalīnī mariyam anyamariyam ca śmaśānaṁ draṣṭumāgatā|</para>
  <para style="p">
    <verse number="2" style="v"/>tadā mahān bhūkampō'bhavat; paramēśvarīyadūtaḥ svargādavaruhya śmaśānadvārāt pāṣāṇamapasāryya taduparyyupavivēśa|</para>
  <para style="p">
    <verse number="3" style="v"/>tadvadanaṁ vidyudvat tējōmayaṁ vasanaṁ himaśubhrañca|</para>
  <para style="p">
    <verse number="4" style="v"/>tadānīṁ rakṣiṇastadbhayāt kampitā mr̥tavad babhūvaḥ|</para>
  <para style="p">
    <verse number="5" style="v"/>sa dūtō yōṣitō jagāda, yūyaṁ mā bhaiṣṭa, kruśahatayīśuṁ mr̥gayadhvē tadahaṁ vēdmi|</para>
  <para style="p">
    <verse number="6" style="v"/>sō'tra nāsti, yathāvadat tathōtthitavān; ētat prabhōḥ śayanasthānaṁ paśyata|</para>
  <para style="p">
    <verse number="7" style="v"/>tūrṇaṁ gatvā tacchiṣyān iti vadata, sa śmaśānād udatiṣṭhat, yuṣmākamagrē gālīlaṁ yāsyati yūyaṁ tatra taṁ vīkṣiṣyadhvē, paśyatāhaṁ vārttāmimāṁ yuṣmānavādiṣaṁ|</para>
  <para style="p">
    <verse number="8" style="v"/>tatastā bhayāt mahānandāñca śmaśānāt tūrṇaṁ bahirbhūya tacchiṣyān vārttāṁ vaktuṁ dhāvitavatyaḥ| kintu śiṣyān vārttāṁ vaktuṁ yānti, tadā yīśu rdarśanaṁ dattvā tā jagāda,</para>
  <para style="p">
    <verse number="9" style="v"/>yuṣmākaṁ kalyāṇaṁ bhūyāt, tatastā āgatya tatpādayōḥ patitvā praṇēmuḥ|</para>
  <para style="p">
    <verse number="10" style="v"/>yīśustā avādīt, mā bibhīta, yūyaṁ gatvā mama bhrātr̥n gālīlaṁ yātuṁ vadata, tatra tē māṁ drakṣyanti|</para>
  <para style="p">
    <verse number="11" style="v"/>striyō gacchanti, tadā rakṣiṇāṁ kēcit puraṁ gatvā yadyad ghaṭitaṁ tatsarvvaṁ pradhānayājakān jñāpitavantaḥ|</para>
  <para style="p">
    <verse number="12" style="v"/>tē prācīnaiḥ samaṁ saṁsadaṁ kr̥tvā mantrayantō bahumudrāḥ sēnābhyō dattvāvadan,</para>
  <para style="p">
    <verse number="13" style="v"/>asmāsu nidritēṣu tacchiṣyā yāminyāmāgatya taṁ hr̥tvānayan, iti yūyaṁ pracārayata|</para>
  <para style="p">
    <verse number="14" style="v"/>yadyētadadhipatēḥ śrōtragōcarībhavēt, tarhi taṁ bōdhayitvā yuṣmānaviṣyāmaḥ|</para>
  <para style="p">
    <verse number="15" style="v"/>tatastē mudrā gr̥hītvā śikṣānurūpaṁ karmma cakruḥ, yihūdīyānāṁ madhyē tasyādyāpi kiṁvadantī vidyatē|</para>
  <para style="p">
    <verse number="16" style="v"/>ēkādaśa śiṣyā yīśunirūpitāgālīlasyādriṁ gatvā</para>
  <para style="p">
    <verse number="17" style="v"/>tatra taṁ saṁvīkṣya praṇēmuḥ, kintu kēcit sandigdhavantaḥ|</para>
  <para style="p">
    <verse number="18" style="v"/>yīśustēṣāṁ samīpamāgatya vyāhr̥tavān, svargamēdinyōḥ sarvvādhipatitvabhārō mayyarpita āstē|</para>
  <para style="p">
    <verse number="19" style="v"/>atō yūyaṁ prayāya sarvvadēśīyān śiṣyān kr̥tvā pituḥ putrasya pavitrasyātmanaśca nāmnā tānavagāhayata; ahaṁ yuṣmān yadyadādiśaṁ tadapi pālayituṁ tānupādiśata|</para>
  <para style="p">
    <verse number="20" style="v"/>paśyata, jagadantaṁ yāvat sadāhaṁ yuṣmābhiḥ sākaṁ tiṣṭhāmi| iti|</para>
</usx>
