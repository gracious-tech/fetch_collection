<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="JHN" style="id">Sanskrit Bible (NT) in ISO Script (satyavēdaḥ ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">John</para>
  <para style="toc1">yōhanalikhitaḥ susaṁvādaḥ</para>
  <para style="toc2">yōhanaḥ</para>
  <para style="toc3">yōhanaḥ</para>
  <para style="mt1">yōhanalikhitaḥ susaṁvādaḥ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ādau vāda āsīt sa ca vāda īśvarēṇa sārdhamāsīt sa vādaḥ svayamīśvara ēva|</para>
  <para style="p">
    <verse number="2" style="v"/>sa ādāvīśvarēṇa sahāsīt|</para>
  <para style="p">
    <verse number="3" style="v"/>tēna sarvvaṁ vastu sasr̥jē sarvvēṣu sr̥ṣṭavastuṣu kimapi vastu tēnāsr̥ṣṭaṁ nāsti|</para>
  <para style="p">
    <verse number="4" style="v"/>sa jīvanasyākāraḥ, tacca jīvanaṁ manuṣyāṇāṁ jyōtiḥ</para>
  <para style="p">
    <verse number="5" style="v"/>tajjyōtirandhakārē pracakāśē kintvandhakārastanna jagrāha|</para>
  <para style="p">
    <verse number="6" style="v"/>yōhan nāmaka ēkō manuja īśvarēṇa prēṣayāñcakrē|</para>
  <para style="p">
    <verse number="7" style="v"/>tadvārā yathā sarvvē viśvasanti tadarthaṁ sa tajjyōtiṣi pramāṇaṁ dātuṁ sākṣisvarūpō bhūtvāgamat,</para>
  <para style="p">
    <verse number="8" style="v"/>sa svayaṁ tajjyōti rna kintu tajjyōtiṣi pramāṇaṁ dātumāgamat|</para>
  <para style="p">
    <verse number="9" style="v"/>jagatyāgatya yaḥ sarvvamanujēbhyō dīptiṁ dadāti tadēva satyajyōtiḥ|</para>
  <para style="p">
    <verse number="10" style="v"/>sa yajjagadasr̥jat tanmadya ēva sa āsīt kintu jagatō lōkāstaṁ nājānan|</para>
  <para style="p">
    <verse number="11" style="v"/>nijādhikāraṁ sa āgacchat kintu prajāstaṁ nāgr̥hlan|</para>
  <para style="p">
    <verse number="12" style="v"/>tathāpi yē yē tamagr̥hlan arthāt tasya nāmni vyaśvasan tēbhya īśvarasya putrā bhavitum adhikāram adadāt|</para>
  <para style="p">
    <verse number="13" style="v"/>tēṣāṁ janiḥ śōṇitānna śārīrikābhilāṣānna mānavānāmicchātō na kintvīśvarādabhavat|</para>
  <para style="p">
    <verse number="14" style="v"/>sa vādō manuṣyarūpēṇāvatīryya satyatānugrahābhyāṁ paripūrṇaḥ san sārdham asmābhi rnyavasat tataḥ pituradvitīyaputrasya yōgyō yō mahimā taṁ mahimānaṁ tasyāpaśyāma|</para>
  <para style="p">
    <verse number="15" style="v"/>tatō yōhanapi pracāryya sākṣyamidaṁ dattavān yō mama paścād āgamiṣyati sa mattō gurutaraḥ; yatō matpūrvvaṁ sa vidyamāna āsīt; yadartham ahaṁ sākṣyamidam adāṁ sa ēṣaḥ|</para>
  <para style="p">
    <verse number="16" style="v"/>aparañca tasya pūrṇatāyā vayaṁ sarvvē kramaśaḥ kramaśōnugrahaṁ prāptāḥ|</para>
  <para style="p">
    <verse number="17" style="v"/>mūsādvārā vyavasthā dattā kintvanugrahaḥ satyatvañca yīśukhrīṣṭadvārā samupātiṣṭhatāṁ|</para>
  <para style="p">
    <verse number="18" style="v"/>kōpi manuja īśvaraṁ kadāpi nāpaśyat kintu pituḥ krōḍasthō'dvitīyaḥ putrastaṁ prakāśayat|</para>
  <para style="p">
    <verse number="19" style="v"/>tvaṁ kaḥ? iti vākyaṁ prēṣṭuṁ yadā yihūdīyalōkā yājakān lēvilōkāṁśca yirūśālamō yōhanaḥ samīpē prēṣayāmāsuḥ,</para>
  <para style="p">
    <verse number="20" style="v"/>tadā sa svīkr̥tavān nāpahnūtavān nāham abhiṣikta ityaṅgīkr̥tavān|</para>
  <para style="p">
    <verse number="21" style="v"/>tadā tē'pr̥cchan tarhi kō bhavān? kiṁ ēliyaḥ? sōvadat na; tatastē'pr̥cchan tarhi bhavān sa bhaviṣyadvādī? sōvadat nāhaṁ saḥ|</para>
  <para style="p">
    <verse number="22" style="v"/>tadā tē'pr̥cchan tarhi bhavān kaḥ? vayaṁ gatvā prērakān tvayi kiṁ vakṣyāmaḥ? svasmin kiṁ vadasi?</para>
  <para style="p">
    <verse number="23" style="v"/>tadā sōvadat| paramēśasya panthānaṁ pariṣkuruta sarvvataḥ| itīdaṁ prāntarē vākyaṁ vadataḥ kasyacidravaḥ| kathāmimāṁ yasmin yiśayiyō bhaviṣyadvādī likhitavān sōham|</para>
  <para style="p">
    <verse number="24" style="v"/>yē prēṣitāstē phirūśilōkāḥ|</para>
  <para style="p">
    <verse number="25" style="v"/>tadā tē'pr̥cchan yadi nābhiṣiktōsi ēliyōsi na sa bhaviṣyadvādyapi nāsi ca, tarhi lōkān majjayasi kutaḥ?</para>
  <para style="p">
    <verse number="26" style="v"/>tatō yōhan pratyavōcat, tōyē'haṁ majjayāmīti satyaṁ kintu yaṁ yūyaṁ na jānītha tādr̥śa ēkō janō yuṣmākaṁ madhya upatiṣṭhati|</para>
  <para style="p">
    <verse number="27" style="v"/>sa matpaścād āgatōpi matpūrvvaṁ varttamāna āsīt tasya pādukābandhanaṁ mōcayitumapi nāhaṁ yōgyōsmi|</para>
  <para style="p">
    <verse number="28" style="v"/>yarddananadyāḥ pārasthabaithabārāyāṁ yasminsthānē yōhanamajjayat tasmina sthānē sarvvamētad aghaṭata|</para>
  <para style="p">
    <verse number="29" style="v"/>parē'hani yōhan svanikaṭamāgacchantaṁ yiśuṁ vilōkya prāvōcat jagataḥ pāpamōcakam īśvarasya mēṣaśāvakaṁ paśyata|</para>
  <para style="p">
    <verse number="30" style="v"/>yō mama paścādāgamiṣyati sa mattō gurutaraḥ, yatō hētōrmatpūrvvaṁ sō'varttata yasminnahaṁ kathāmimāṁ kathitavān sa ēvāyaṁ|</para>
  <para style="p">
    <verse number="31" style="v"/>aparaṁ nāhamēnaṁ pratyabhijñātavān kintu isrāyēllōkā ēnaṁ yathā paricinvanti tadabhiprāyēṇāhaṁ jalē majjayitumāgaccham|</para>
  <para style="p">
    <verse number="32" style="v"/>punaśca yōhanaparamēkaṁ pramāṇaṁ datvā kathitavān vihāyasaḥ kapōtavad avatarantamātmānam asyōparyyavatiṣṭhantaṁ ca dr̥ṣṭavānaham|</para>
  <para style="p">
    <verse number="33" style="v"/>nāhamēnaṁ pratyabhijñātavān iti satyaṁ kintu yō jalē majjayituṁ māṁ prairayat sa ēvēmāṁ kathāmakathayat yasyōparyyātmānam avatarantam avatiṣṭhantañca drakṣayasi saēva pavitrē ātmani majjayiṣyati|</para>
  <para style="p">
    <verse number="34" style="v"/>avastannirīkṣyāyam īśvarasya tanaya iti pramāṇaṁ dadāmi|</para>
  <para style="p">
    <verse number="35" style="v"/>parē'hani yōhan dvābhyāṁ śiṣyābhyāṁ sārddhēṁ tiṣṭhan</para>
  <para style="p">
    <verse number="36" style="v"/>yiśuṁ gacchantaṁ vilōkya gaditavān, īśvarasya mēṣaśāvakaṁ paśyataṁ|</para>
  <para style="p">
    <verse number="37" style="v"/>imāṁ kathāṁ śrutvā dvau śiṣyau yīśōḥ paścād īyatuḥ|</para>
  <para style="p">
    <verse number="38" style="v"/>tatō yīśuḥ parāvr̥tya tau paścād āgacchantau dr̥ṣṭvā pr̥ṣṭavān yuvāṁ kiṁ gavēśayathaḥ? tāvapr̥cchatāṁ hē rabbi arthāt hē gurō bhavān kutra tiṣṭhati?</para>
  <para style="p">
    <verse number="39" style="v"/>tataḥ sōvādit ētya paśyataṁ| tatō divasasya tr̥tīyapraharasya gatatvāt tau taddinaṁ tasya saṅgē'sthātāṁ|</para>
  <para style="p">
    <verse number="40" style="v"/>yau dvau yōhanō vākyaṁ śrutvā yiśōḥ paścād āgamatāṁ tayōḥ śimōnpitarasya bhrātā āndriyaḥ</para>
  <para style="p">
    <verse number="41" style="v"/>sa itvā prathamaṁ nijasōdaraṁ śimōnaṁ sākṣātprāpya kathitavān vayaṁ khrīṣṭam arthāt abhiṣiktapuruṣaṁ sākṣātkr̥tavantaḥ|</para>
  <para style="p">
    <verse number="42" style="v"/>paścāt sa taṁ yiśōḥ samīpam ānayat| tadā yīśustaṁ dr̥ṣṭvāvadat tvaṁ yūnasaḥ putraḥ śimōn kintu tvannāmadhēyaṁ kaiphāḥ vā pitaraḥ arthāt prastarō bhaviṣyati|</para>
  <para style="p">
    <verse number="43" style="v"/>parē'hani yīśau gālīlaṁ gantuṁ niścitacētasi sati philipanāmānaṁ janaṁ sākṣātprāpyāvōcat mama paścād āgaccha|</para>
  <para style="p">
    <verse number="44" style="v"/>baitsaidānāmni yasmin grāmē pitarāndriyayōrvāsa āsīt tasmin grāmē tasya philipasya vasatirāsīt|</para>
  <para style="p">
    <verse number="45" style="v"/>paścāt philipō nithanēlaṁ sākṣātprāpyāvadat mūsā vyavasthā granthē bhaviṣyadvādināṁ granthēṣu ca yasyākhyānaṁ likhitamāstē taṁ yūṣaphaḥ putraṁ nāsaratīyaṁ yīśuṁ sākṣād akārṣma vayaṁ|</para>
  <para style="p">
    <verse number="46" style="v"/>tadā nithanēl kathitavān nāsarannagarāta kiṁ kaściduttama utpantuṁ śaknōti? tataḥ philipō 'vōcat ētya paśya|</para>
  <para style="p">
    <verse number="47" style="v"/>aparañca yīśuḥ svasya samīpaṁ tam āgacchantaṁ dr̥ṣṭvā vyāhr̥tavān, paśyāyaṁ niṣkapaṭaḥ satya isrāyēllōkaḥ|</para>
  <para style="p">
    <verse number="48" style="v"/>tataḥ sōvadad, bhavān māṁ kathaṁ pratyabhijānāti? yīśuravādīt philipasya āhvānāt pūrvvaṁ yadā tvamuḍumbarasya tarōrmūlē'sthāstadā tvāmadarśam|</para>
  <para style="p">
    <verse number="49" style="v"/>nithanēl acakathat, hē gurō bhavān nitāntam īśvarasya putrōsi, bhavān isrāyēlvaṁśasya rājā|</para>
  <para style="p">
    <verse number="50" style="v"/>tatō yīśu rvyāharat, tvāmuḍumbarasya pādapasya mūlē dr̥ṣṭavānāhaṁ mamaitasmādvākyāt kiṁ tvaṁ vyaśvasīḥ? ētasmādapyāścaryyāṇi kāryyāṇi drakṣyasi|</para>
  <para style="p">
    <verse number="51" style="v"/>anyaccāvādīd yuṣmānahaṁ yathārthaṁ vadāmi, itaḥ paraṁ mōcitē mēghadvārē tasmānmanujasūnunā īśvarasya dūtagaṇam avarōhantamārōhantañca drakṣyatha|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ trutīyadivasē gālīl pradēśiyē kānnānāmni nagarē vivāha āsīt tatra ca yīśōrmātā tiṣṭhat|</para>
  <para style="p">
    <verse number="2" style="v"/>tasmai vivāhāya yīśustasya śiṣyāśca nimantritā āsan|</para>
  <para style="p">
    <verse number="3" style="v"/>tadanantaraṁ drākṣārasasya nyūnatvād yīśōrmātā tamavadat ētēṣāṁ drākṣārasō nāsti|</para>
  <para style="p">
    <verse number="4" style="v"/>tadā sa tāmavōcat hē nāri mayā saha tava kiṁ kāryyaṁ? mama samaya idānīṁ nōpatiṣṭhati|</para>
  <para style="p">
    <verse number="5" style="v"/>tatastasya mātā dāsānavōcad ayaṁ yad vadati tadēva kuruta|</para>
  <para style="p">
    <verse number="6" style="v"/>tasmin sthānē yihūdīyānāṁ śucitvakaraṇavyavahārānusārēṇāḍhakaikajaladharāṇi pāṣāṇamayāni ṣaḍvr̥hatpātrāṇiāsan|</para>
  <para style="p">
    <verse number="7" style="v"/>tadā yīśustān sarvvakalaśān jalaiḥ pūrayituṁ tānājñāpayat, tatastē sarvvān kumbhānākarṇaṁ jalaiḥ paryyapūrayan|</para>
  <para style="p">
    <verse number="8" style="v"/>atha tēbhyaḥ kiñciduttāryya bhōjyādhipātēḥsamīpaṁ nētuṁ sa tānādiśat, tē tadanayan|</para>
  <para style="p">
    <verse number="9" style="v"/>aparañca tajjalaṁ kathaṁ drākṣārasō'bhavat tajjalavāhakādāsā jñātuṁ śaktāḥ kintu tadbhōjyādhipō jñātuṁ nāśaknōt tadavalihya varaṁ saṁmbōdyāvadata,</para>
  <para style="p">
    <verse number="10" style="v"/>lōkāḥ prathamaṁ uttamadrākṣārasaṁ dadati taṣu yathēṣṭaṁ pitavatsu tasmā kiñcidanuttamañca dadati kintu tvamidānīṁ yāvat uttamadrākṣārasaṁ sthāpayasi|</para>
  <para style="p">
    <verse number="11" style="v"/>itthaṁ yīśurgālīlapradēśē āścaryyakārmma prārambha nijamahimānaṁ prākāśayat tataḥ śiṣyāstasmin vyaśvasan|</para>
  <para style="p">
    <verse number="12" style="v"/>tataḥ param sa nijamātrubhrātrusśiṣyaiḥ sārddhṁ kapharnāhūmam āgamat kintu tatra bahūdināni ātiṣṭhat|</para>
  <para style="p">
    <verse number="13" style="v"/>tadanantaraṁ yihūdiyānāṁ nistārōtsavē nikaṭamāgatē yīśu ryirūśālam nagaram āgacchat|</para>
  <para style="p">
    <verse number="14" style="v"/>tatō mandirasya madhyē gōmēṣapārāvatavikrayiṇō vāṇijakṣcōpaviṣṭān vilōkya</para>
  <para style="p">
    <verse number="15" style="v"/>rajjubhiḥ kaśāṁ nirmmāya sarvvagōmēṣādibhiḥ sārddhaṁ tān mandirād dūrīkr̥tavān|</para>
  <para style="p">
    <verse number="16" style="v"/>vaṇijāṁ mudrādi vikīryya āsanāni nyūbjīkr̥tya pārāvatavikrayibhyō'kathayad asmāt sthānāt sarvāṇyētāni nayata, mama pitugr̥haṁ vāṇijyagr̥haṁ mā kārṣṭa|</para>
  <para style="p">
    <verse number="17" style="v"/>tasmāt tanmandirārtha udyōgō yastu sa grasatīva mām| imāṁ śāstrīyalipiṁ śiṣyāḥsamasmaran|</para>
  <para style="p">
    <verse number="18" style="v"/>tataḥ param yihūdīyalōkā yīṣimavadan tavamidr̥śakarmmakaraṇāt kiṁ cihnamasmān darśayasi?</para>
  <para style="p">
    <verse number="19" style="v"/>tatō yīśustānavōcad yuṣmābhirē tasmin mandirē nāśitē dinatrayamadhyē'haṁ tad utthāpayiṣyāmi|</para>
  <para style="p">
    <verse number="20" style="v"/>tadā yihūdiyā vyāhārṣuḥ, ētasya mandirasa nirmmāṇēna ṣaṭcatvāriṁśad vatsarā gatāḥ, tvaṁ kiṁ dinatrayamadhyē tad utthāpayiṣyasi?</para>
  <para style="p">
    <verse number="21" style="v"/>kintu sa nijadēharūpamandirē kathāmimāṁ kathitavān|</para>
  <para style="p">
    <verse number="22" style="v"/>sa yadētādr̥śaṁ gaditavān tacchiṣyāḥ śmaśānāt tadīyōtthānē sati smr̥tvā dharmmagranthē yīśunōktakathāyāṁ ca vyaśvasiṣuḥ|</para>
  <para style="p">
    <verse number="23" style="v"/>anantaraṁ nistārōtsavasya bhōjyasamayē yirūśālam nagarē tatkrutāścaryyakarmmāṇi vilōkya bahubhistasya nāmani viśvasitaṁ|</para>
  <para style="p">
    <verse number="24" style="v"/>kintu sa tēṣāṁ karēṣu svaṁ na samarpayat, yataḥ sa sarvvānavait|</para>
  <para style="p">
    <verse number="25" style="v"/>sa mānavēṣu kasyacit pramāṇaṁ nāpēkṣata yatō manujānāṁ madhyē yadyadasti tattat sōjānāt|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>nikadimanāmā yihūdīyānām adhipatiḥ phirūśī kṣaṇadāyāṁ</para>
  <para style="p">
    <verse number="2" style="v"/>yīśaurabhyarṇam āvrajya vyāhārṣīt, hē gurō bhavān īśvarād āgat ēka upadēṣṭā, ētad asmābhirjñāyatē; yatō bhavatā yānyāścaryyakarmmāṇi kriyantē paramēśvarasya sāhāyyaṁ vinā kēnāpi tattatkarmmāṇi karttuṁ na śakyantē|</para>
  <para style="p">
    <verse number="3" style="v"/>tadā yīśuruttaraṁ dattavān tavāhaṁ yathārthataraṁ vyāharāmi punarjanmani na sati kōpi mānava īśvarasya rājyaṁ draṣṭuṁ na śaknōti|</para>
  <para style="p">
    <verse number="4" style="v"/>tatō nikadīmaḥ pratyavōcat manujō vr̥ddhō bhūtvā kathaṁ janiṣyatē? sa kiṁ puna rmātr̥rjaṭharaṁ praviśya janituṁ śaknōti?</para>
  <para style="p">
    <verse number="5" style="v"/>yīśuravādīd yathārthataram ahaṁ kathayāmi manujē tōyātmabhyāṁ puna rna jātē sa īśvarasya rājyaṁ pravēṣṭuṁ na śaknōti|</para>
  <para style="p">
    <verse number="6" style="v"/>māṁsād yat jāyatē tan māṁsamēva tathātmanō yō jāyatē sa ātmaiva|</para>
  <para style="p">
    <verse number="7" style="v"/>yuṣmābhiḥ puna rjanitavyaṁ mamaitasyāṁ kathāyām āścaryaṁ mā maṁsthāḥ|</para>
  <para style="p">
    <verse number="8" style="v"/>sadāgatiryāṁ diśamicchati tasyāmēva diśi vāti, tvaṁ tasya svanaṁ śuṇōṣi kintu sa kuta āyāti kutra yāti vā kimapi na jānāsi tadvād ātmanaḥ sakāśāt sarvvēṣāṁ manujānāṁ janma bhavati|</para>
  <para style="p">
    <verse number="9" style="v"/>tadā nikadīmaḥ pr̥ṣṭavān ētat kathaṁ bhavituṁ śaknōti?</para>
  <para style="p">
    <verse number="10" style="v"/>yīśuḥ pratyaktavān tvamisrāyēlō gururbhūtvāpi kimētāṁ kathāṁ na vētsi?</para>
  <para style="p">
    <verse number="11" style="v"/>tubhyaṁ yathārthaṁ kathayāmi, vayaṁ yad vidmastad vacmaḥ yaṁcca paśyāmastasyaiva sākṣyaṁ dadmaḥ kintu yuṣmābhirasmākaṁ sākṣitvaṁ na gr̥hyatē|</para>
  <para style="p">
    <verse number="12" style="v"/>ētasya saṁsārasya kathāyāṁ kathitāyāṁ yadi yūyaṁ na viśvasitha tarhi svargīyāyāṁ kathāyāṁ kathaṁ viśvasiṣyatha?</para>
  <para style="p">
    <verse number="13" style="v"/>yaḥ svargē'sti yaṁ ca svargād avārōhat taṁ mānavatanayaṁ vinā kōpi svargaṁ nārōhat|</para>
  <para style="p">
    <verse number="14" style="v"/>aparañca mūsā yathā prāntarē sarpaṁ prōtthāpitavān manuṣyaputrō'pi tathaivōtthāpitavyaḥ;</para>
  <para style="p">
    <verse number="15" style="v"/>tasmād yaḥ kaścit tasmin viśvasiṣyati sō'vināśyaḥ san anantāyuḥ prāpsyati|</para>
  <para style="p">
    <verse number="16" style="v"/>īśvara itthaṁ jagadadayata yat svamadvitīyaṁ tanayaṁ prādadāt tatō yaḥ kaścit tasmin viśvasiṣyati sō'vināśyaḥ san anantāyuḥ prāpsyati|</para>
  <para style="p">
    <verse number="17" style="v"/>īśvarō jagatō lōkān daṇḍayituṁ svaputraṁ na prēṣya tān paritrātuṁ prēṣitavān|</para>
  <para style="p">
    <verse number="18" style="v"/>ataēva yaḥ kaścit tasmin viśvasiti sa daṇḍārhō na bhavati kintu yaḥ kaścit tasmin na viśvasiti sa idānīmēva daṇḍārhō bhavati,yataḥ sa īśvarasyādvitīyaputrasya nāmani pratyayaṁ na karōti|</para>
  <para style="p">
    <verse number="19" style="v"/>jagatō madhyē jyōtiḥ prākāśata kintu manuṣyāṇāṁ karmmaṇāṁ dr̥ṣṭatvāt tē jyōtiṣōpi timirē prīyantē ētadēva daṇḍasya kāraṇāṁ bhavati|</para>
  <para style="p">
    <verse number="20" style="v"/>yaḥ kukarmma karōti tasyācārasya dr̥ṣṭatvāt sa jyōtirr̥̄tīyitvā tannikaṭaṁ nāyāti;</para>
  <para style="p">
    <verse number="21" style="v"/>kintu yaḥ satkarmma karōti tasya sarvvāṇi karmmāṇīśvarēṇa kr̥tānīti sathā prakāśatē tadabhiprāyēṇa sa jyōtiṣaḥ sannidhim āyāti|</para>
  <para style="p">
    <verse number="22" style="v"/>tataḥ param yīśuḥ śiṣyaiḥ sārddhaṁ yihūdīyadēśaṁ gatvā tatra sthitvā majjayitum ārabhata|</para>
  <para style="p">
    <verse number="23" style="v"/>tadā śālam nagarasya samīpasthāyini ainan grāmē bahutaratōyasthitēstatra yōhan amajjayat tathā ca lōkā āgatya tēna majjitā abhavan|</para>
  <para style="p">
    <verse number="24" style="v"/>tadā yōhan kārāyāṁ na baddhaḥ|</para>
  <para style="p">
    <verse number="25" style="v"/>aparañca śācakarmmaṇi yōhānaḥ śiṣyaiḥ saha yihūdīyalōkānāṁ vivādē jātē, tē yōhanaḥ saṁnnidhiṁ gatvākathayan,</para>
  <para style="p">
    <verse number="26" style="v"/>hē gurō yarddananadyāḥ pārē bhavatā sārddhaṁ ya āsīt yasmiṁśca bhavān sākṣyaṁ pradadāt paśyatu sōpi majjayati sarvvē tasya samīpaṁ yānti ca|</para>
  <para style="p">
    <verse number="27" style="v"/>tadā yōhan pratyavōcad īśvarēṇa na dattē kōpi manujaḥ kimapi prāptuṁ na śaknōti|</para>
  <para style="p">
    <verse number="28" style="v"/>ahaṁ abhiṣiktō na bhavāmi kintu tadagrē prēṣitōsmi yāmimāṁ kathāṁ kathitavānāhaṁ tatra yūyaṁ sarvvē sākṣiṇaḥ stha|</para>
  <para style="p">
    <verse number="29" style="v"/>yō janaḥ kanyāṁ labhatē sa ēva varaḥ kintu varasya sannidhau daṇḍāyamānaṁ tasya yanmitraṁ tēna varasya śabdē śrutē'tīvāhlādyatē mamāpi tadvad ānandasiddhirjātā|</para>
  <para style="p">
    <verse number="30" style="v"/>tēna kramaśō varddhitavyaṁ kintu mayā hsitavyaṁ|</para>
  <para style="p">
    <verse number="31" style="v"/>ya ūrdhvādāgacchat sa sarvvēṣāṁ mukhyō yaśca saṁsārād udapadyata sa sāṁsārikaḥ saṁsārīyāṁ kathāñca kathayati yastu svargādāgacchat sa sarvvēṣāṁ mukhyaḥ|</para>
  <para style="p">
    <verse number="32" style="v"/>sa yadapaśyadaśr̥ṇōcca tasminnēva sākṣyaṁ dadāti tathāpi prāyaśaḥ kaścit tasya sākṣyaṁ na gr̥hlāti;</para>
  <para style="p">
    <verse number="33" style="v"/>kintu yō gr̥hlāti sa īśvarasya satyavāditvaṁ mudrāṅgitaṁ karōti|</para>
  <para style="p">
    <verse number="34" style="v"/>īśvarēṇa yaḥ prēritaḥ saēva īśvarīyakathāṁ kathayati yata īśvara ātmānaṁ tasmai aparimitam adadāt|</para>
  <para style="p">
    <verse number="35" style="v"/>pitā putrē snēhaṁ kr̥tvā tasya hastē sarvvāṇi samarpitavān|</para>
  <para style="p">
    <verse number="36" style="v"/>yaḥ kaścit putrē viśvasiti sa ēvānantam paramāyuḥ prāpnōti kintu yaḥ kaścit putrē na viśvasiti sa paramāyuṣō darśanaṁ na prāpnōti kintvīśvarasya kōpabhājanaṁ bhūtvā tiṣṭhati|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yīśuḥ svayaṁ nāmajjayat kēvalaṁ tasya śiṣyā amajjayat kintu yōhanō'dhikaśiṣyān sa karōti majjayati ca,</para>
  <para style="p">
    <verse number="2" style="v"/>phirūśina imāṁ vārttāmaśr̥ṇvan iti prabhuravagatya</para>
  <para style="p">
    <verse number="3" style="v"/>yihūdīyadēśaṁ vihāya puna rgālīlam āgat|</para>
  <para style="p">
    <verse number="4" style="v"/>tataḥ śōmirōṇapradēśasya madyēna tēna gantavyē sati</para>
  <para style="p">
    <verse number="5" style="v"/>yākūb nijaputrāya yūṣaphē yāṁ bhūmim adadāt tatsamīpasthāyi śōmirōṇapradēśasya sukhār nāmnā vikhyātasya nagarasya sannidhāvupāsthāt|</para>
  <para style="p">
    <verse number="6" style="v"/>tatra yākūbaḥ prahirāsīt; tadā dvitīyayāmavēlāyāṁ jātāyāṁ sa mārgē śramāpannastasya prahēḥ pārśvē upāviśat|</para>
  <para style="p">
    <verse number="7" style="v"/>ētarhi kācit śōmirōṇīyā yōṣit tōyōttōlanārtham tatrāgamat</para>
  <para style="p">
    <verse number="8" style="v"/>tadā śiṣyāḥ khādyadravyāṇi krētuṁ nagaram agacchan|</para>
  <para style="p">
    <verse number="9" style="v"/>yīśuḥ śōmirōṇīyāṁ tāṁ yōṣitam vyāhārṣīt mahyaṁ kiñcit pānīyaṁ pātuṁ dēhi| kintu śōmirōṇīyaiḥ sākaṁ yihūdīyalōkā na vyavāharan tasmāddhētōḥ sākathayat śōmirōṇīyā yōṣitadahaṁ tvaṁ yihūdīyōsi kathaṁ mattaḥ pānīyaṁ pātum icchasi?</para>
  <para style="p">
    <verse number="10" style="v"/>tatō yīśuravadad īśvarasya yaddānaṁ tatkīdr̥k pānīyaṁ pātuṁ mahyaṁ dēhi ya itthaṁ tvāṁ yācatē sa vā ka iti cēdajñāsyathāstarhi tamayāciṣyathāḥ sa ca tubhyamamr̥taṁ tōyamadāsyat|</para>
  <para style="p">
    <verse number="11" style="v"/>tadā sā sīmantinī bhāṣitavati, hē mahēccha prahirgambhīrō bhavatō nīrōttōlanapātraṁ nāstī ca tasmāt tadamr̥taṁ kīlālaṁ kutaḥ prāpsyasi?</para>
  <para style="p">
    <verse number="12" style="v"/>yōsmabhyam imamandhūṁ dadau, yasya ca parijanā gōmēṣādayaśca sarvvē'sya prahēḥ pānīyaṁ papurētādr̥śō yōsmākaṁ pūrvvapuruṣō yākūb tasmādapi bhavān mahān kiṁ?</para>
  <para style="p">
    <verse number="13" style="v"/>tatō yīśurakathayad idaṁ pānīyaṁ saḥ pivati sa punastr̥ṣārttō bhaviṣyati,</para>
  <para style="p">
    <verse number="14" style="v"/>kintu mayā dattaṁ pānīyaṁ yaḥ pivati sa punaḥ kadāpi tr̥ṣārttō na bhaviṣyati| mayā dattam idaṁ tōyaṁ tasyāntaḥ prasravaṇarūpaṁ bhūtvā anantāyuryāvat srōṣyati|</para>
  <para style="p">
    <verse number="15" style="v"/>tadā sā vanitākathayat hē mahēccha tarhi mama punaḥ pīpāsā yathā na jāyatē tōyōttōlanāya yathātrāgamanaṁ na bhavati ca tadarthaṁ mahyaṁ tattōyaṁ dēhī|</para>
  <para style="p">
    <verse number="16" style="v"/>tatō yīśūravadadyāhi tava patimāhūya sthānē'trāgaccha|</para>
  <para style="p">
    <verse number="17" style="v"/>sā vāmāvadat mama patirnāsti| yīśuravadat mama patirnāstīti vākyaṁ bhadramavōcaḥ|</para>
  <para style="p">
    <verse number="18" style="v"/>yatastava pañca patayōbhavan adhunā tu tvayā sārddhaṁ yastiṣṭhati sa tava bharttā na vākyamidaṁ satyamavādiḥ|</para>
  <para style="p">
    <verse number="19" style="v"/>tadā sā mahilā gaditavati hē mahēccha bhavān ēkō bhaviṣyadvādīti buddhaṁ mayā|</para>
  <para style="p">
    <verse number="20" style="v"/>asmākaṁ pitr̥lōkā ētasmin śilōccayē'bhajanta, kintu bhavadbhirucyatē yirūśālam nagarē bhajanayōgyaṁ sthānamāstē|</para>
  <para style="p">
    <verse number="21" style="v"/>yīśuravōcat hē yōṣit mama vākyē viśvasihi yadā yūyaṁ kēvalaśailē'smin vā yirūśālam nagarē piturbhajanaṁ na kariṣyadhvē kāla ētādr̥śa āyāti|</para>
  <para style="p">
    <verse number="22" style="v"/>yūyaṁ yaṁ bhajadhvē taṁ na jānītha, kintu vayaṁ yaṁ bhajāmahē taṁ jānīmahē, yatō yihūdīyalōkānāṁ madhyāt paritrāṇaṁ jāyatē|</para>
  <para style="p">
    <verse number="23" style="v"/>kintu yadā satyabhaktā ātmanā satyarūpēṇa ca piturbhajanaṁ kariṣyantē samaya ētādr̥śa āyāti, varam idānīmapi vidyatē ; yata ētādr̥śō bhatkān pitā cēṣṭatē|</para>
  <para style="p">
    <verse number="24" style="v"/>īśvara ātmā; tatastasya yē bhaktāstaiḥ sa ātmanā satyarūpēṇa ca bhajanīyaḥ|</para>
  <para style="p">
    <verse number="25" style="v"/>tadā sā mahilāvādīt khrīṣṭanāmnā vikhyātō'bhiṣiktaḥ puruṣa āgamiṣyatīti jānāmi sa ca sarvvāḥ kathā asmān jñāpayiṣyati|</para>
  <para style="p">
    <verse number="26" style="v"/>tatō yīśuravadat tvayā sārddhaṁ kathanaṁ karōmi yō'ham ahamēva sa puruṣaḥ|</para>
  <para style="p">
    <verse number="27" style="v"/>ētasmin samayē śiṣyā āgatya tathā striyā sārddhaṁ tasya kathōpakathanē mahāścaryyam amanyanta tathāpi bhavān kimicchati? yadvā kimartham ētayā sārddhaṁ kathāṁ kathayati? iti kōpi nāpr̥cchat|</para>
  <para style="p">
    <verse number="28" style="v"/>tataḥ paraṁ sā nārī kalaśaṁ sthāpayitvā nagaramadhyaṁ gatvā lōkēbhyōkathāyad</para>
  <para style="p">
    <verse number="29" style="v"/>ahaṁ yadyat karmmākaravaṁ tatsarvvaṁ mahyamakathayad ētādr̥śaṁ mānavamēkam āgatya paśyata ru kim abhiṣiktō na bhavati ?</para>
  <para style="p">
    <verse number="30" style="v"/>tatastē nagarād bahirāgatya tātasya samīpam āyan|</para>
  <para style="p">
    <verse number="31" style="v"/>ētarhi śiṣyāḥ sādhayitvā taṁ vyāhārṣuḥ hē gurō bhavān kiñcid bhūktāṁ|</para>
  <para style="p">
    <verse number="32" style="v"/>tataḥ sōvadad yuṣmābhiryanna jñāyatē tādr̥śaṁ bhakṣyaṁ mamāstē|</para>
  <para style="p">
    <verse number="33" style="v"/>tadā śiṣyāḥ parasparaṁ praṣṭum ārambhanta, kimasmai kōpi kimapi bhakṣyamānīya dattavān?</para>
  <para style="p">
    <verse number="34" style="v"/>yīśuravōcat matprērakasyābhimatānurūpakaraṇaṁ tasyaiva karmmasiddhikāraṇañca mama bhakṣyaṁ|</para>
  <para style="p">
    <verse number="35" style="v"/>māsacatuṣṭayē jātē śasyakarttanasamayō bhaviṣyatīti vākyaṁ yuṣmābhiḥ kiṁ nōdyatē? kintvahaṁ vadāmi, śira uttōlya kṣētrāṇi prati nirīkṣya paśyata, idānīṁ karttanayōgyāni śuklavarṇānyabhavan|</para>
  <para style="p">
    <verse number="36" style="v"/>yaśchinatti sa vētanaṁ labhatē anantāyuḥsvarūpaṁ śasyaṁ sa gr̥hlāti ca, tēnaiva vaptā chēttā ca yugapad ānandataḥ|</para>
  <para style="p">
    <verse number="37" style="v"/>itthaṁ sati vapatyēkaśchinatyanya iti vacanaṁ siddhyati|</para>
  <para style="p">
    <verse number="38" style="v"/>yatra yūyaṁ na paryyaśrāmyata tādr̥śaṁ śasyaṁ chēttuṁ yuṣmān prairayam anyē janāḥparyyaśrāmyan yūyaṁ tēṣāṁ śragasya phalam alabhadhvam|</para>
  <para style="p">
    <verse number="39" style="v"/>yasmin kālē yadyat karmmākārṣaṁ tatsarvvaṁ sa mahyam akathayat tasyā vanitāyā idaṁ sākṣyavākyaṁ śrutvā tannagaranivāsinō bahavaḥ śōmirōṇīyalōkā vyaśvasan|</para>
  <para style="p">
    <verse number="40" style="v"/>tathā ca tasyāntikē samupasthāya svēṣāṁ sannidhau katicid dināni sthātuṁ tasmin vinayam akurvvāna tasmāt sa dinadvayaṁ tatsthānē nyavaṣṭat</para>
  <para style="p">
    <verse number="41" style="v"/>tatastasyōpadēśēna bahavō'parē viśvasya</para>
  <para style="p">
    <verse number="42" style="v"/>tāṁ yōṣāmavadan kēvalaṁ tava vākyēna pratīma iti na, kintu sa jagatō'bhiṣiktastrātēti tasya kathāṁ śrutvā vayaṁ svayamēvājñāsamahi|</para>
  <para style="p">
    <verse number="43" style="v"/>svadēśē bhaviṣyadvaktuḥ satkārō nāstīti yadyapi yīśuḥ pramāṇaṁ datvākathayat</para>
  <para style="p">
    <verse number="44" style="v"/>tathāpi divasadvayāt paraṁ sa tasmāt sthānād gālīlaṁ gatavān|</para>
  <para style="p">
    <verse number="45" style="v"/>anantaraṁ yē gālīlī liyalōkā utsavē gatā utsavasamayē yirūśalam nagarē tasya sarvvāḥ kriyā apaśyan tē gālīlam āgataṁ tam āgr̥hlan|</para>
  <para style="p">
    <verse number="46" style="v"/>tataḥ param yīśu ryasmin kānnānagarē jalaṁ drākṣārasam ākarōt tat sthānaṁ punaragāt| tasminnēva samayē kasyacid rājasabhāstārasya putraḥ kapharnāhūmapurī rōgagrasta āsīt|</para>
  <para style="p">
    <verse number="47" style="v"/>sa yēhūdīyadēśād yīśō rgālīlāgamanavārttāṁ niśamya tasya samīpaṁ gatvā prārthya vyāhr̥tavān mama putrasya prāyēṇa kāla āsannaḥ bhavān āgatya taṁ svasthaṁ karōtu|</para>
  <para style="p">
    <verse number="48" style="v"/>tadā yīśurakathayad āścaryyaṁ karmma citraṁ cihnaṁ ca na dr̥ṣṭā yūyaṁ na pratyēṣyatha|</para>
  <para style="p">
    <verse number="49" style="v"/>tataḥ sa sabhāsadavadat hē mahēccha mama putrē na mr̥tē bhavānāgacchatu|</para>
  <para style="p">
    <verse number="50" style="v"/>yīśustamavadad gaccha tava putrō'jīvīt tadā yīśunōktavākyē sa viśvasya gatavān|</para>
  <para style="p">
    <verse number="51" style="v"/>gamanakālē mārgamadhyē dāsāstaṁ sākṣātprāpyāvadan bhavataḥ putrō'jīvīt|</para>
  <para style="p">
    <verse number="52" style="v"/>tataḥ kaṁ kālamārabhya rōgapratīkārārambhō jātā iti pr̥ṣṭē tairuktaṁ hyaḥ sārddhadaṇḍadvayādhikadvitīyayāmē tasya jvaratyāgō'bhavat|</para>
  <para style="p">
    <verse number="53" style="v"/>tadā yīśustasmin kṣaṇē prōktavān tava putrō'jīvīt pitā tadbuddhvā saparivārō vyaśvasīt|</para>
  <para style="p">
    <verse number="54" style="v"/>yihūdīyadēśād āgatya gālīli yīśurētad dvitīyam āścaryyakarmmākarōt|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tataḥ paraṁ yihūdīyānām utsava upasthitē yīśu ryirūśālamaṁ gatavān|</para>
  <para style="p">
    <verse number="2" style="v"/>tasminnagarē mēṣanāmnō dvārasya samīpē ibrīyabhāṣayā baithēsdā nāmnā piṣkariṇī pañcaghaṭṭayuktāsīt|</para>
  <para style="p">
    <verse number="3" style="v"/>tasyāstēṣu ghaṭṭēṣu kilālakampanam apēkṣya andhakhañcaśuṣkāṅgādayō bahavō rōgiṇaḥ patantastiṣṭhanti sma|</para>
  <para style="p">
    <verse number="4" style="v"/>yatō viśēṣakālē tasya sarasō vāri svargīyadūta ētyākampayat tatkīlālakampanāt paraṁ yaḥ kaścid rōgī prathamaṁ pānīyamavārōhat sa ēva tatkṣaṇād rōgamuktō'bhavat|</para>
  <para style="p">
    <verse number="5" style="v"/>tadāṣṭātriṁśadvarṣāṇi yāvad rōgagrasta ēkajanastasmin sthānē sthitavān|</para>
  <para style="p">
    <verse number="6" style="v"/>yīśustaṁ śayitaṁ dr̥ṣṭvā bahukālikarōgīti jñātvā vyāhr̥tavān tvaṁ kiṁ svasthō bubhūṣasi?</para>
  <para style="p">
    <verse number="7" style="v"/>tatō rōgī kathitavān hē mahēccha yadā kīlālaṁ kampatē tadā māṁ puṣkariṇīm avarōhayituṁ mama kōpi nāsti, tasmān mama gamanakālē kaścidanyō'grō gatvā avarōhati|</para>
  <para style="p">
    <verse number="8" style="v"/>tadā yīśurakathayad uttiṣṭha, tava śayyāmuttōlya gr̥hītvā yāhi|</para>
  <para style="p">
    <verse number="9" style="v"/>sa tatkṣaṇāt svasthō bhūtvā śayyāmuttōlyādāya gatavān kintu taddinaṁ viśrāmavāraḥ|</para>
  <para style="p">
    <verse number="10" style="v"/>tasmād yihūdīyāḥ svasthaṁ naraṁ vyāharan adya viśrāmavārē śayanīyamādāya na yātavyam|</para>
  <para style="p">
    <verse number="11" style="v"/>tataḥ sa pratyavōcad yō māṁ svastham akārṣīt śayanīyam uttōlyādāya yātuṁ māṁ sa ēvādiśat|</para>
  <para style="p">
    <verse number="12" style="v"/>tadā tē'pr̥cchan śayanīyam uttōlyādāya yātuṁ ya ājñāpayat sa kaḥ?</para>
  <para style="p">
    <verse number="13" style="v"/>kintu sa ka iti svasthībhūtō nājānād yatastasmin sthānē janatāsattvād yīśuḥ sthānāntaram āgamat|</para>
  <para style="p">
    <verse number="14" style="v"/>tataḥ paraṁ yēśu rmandirē taṁ naraṁ sākṣātprāpyākathayat paśyēdānīm anāmayō jātōsi yathādhikā durdaśā na ghaṭatē taddhētōḥ pāpaṁ karmma punarmākārṣīḥ|</para>
  <para style="p">
    <verse number="15" style="v"/>tataḥ sa gatvā yihūdīyān avadad yīśu rmām arōgiṇam akārṣīt|</para>
  <para style="p">
    <verse number="16" style="v"/>tatō yīśu rviśrāmavārē karmmēdr̥śaṁ kr̥tavān iti hētō ryihūdīyāstaṁ tāḍayitvā hantum acēṣṭanta|</para>
  <para style="p">
    <verse number="17" style="v"/>yīśustānākhyat mama pitā yat kāryyaṁ karōti tadanurūpam ahamapi karōti|</para>
  <para style="p">
    <verse number="18" style="v"/>tatō yihūdīyāstaṁ hantuṁ punarayatanta yatō viśrāmavāraṁ nāmanyata tadēva kēvalaṁ na adhikantu īśvaraṁ svapitaraṁ prōcya svamapīśvaratulyaṁ kr̥tavān|</para>
  <para style="p">
    <verse number="19" style="v"/>paścād yīśuravadad yuṣmānahaṁ yathārthataraṁ vadāmi putraḥ pitaraṁ yadyat karmma kurvvantaṁ paśyati tadatiriktaṁ svēcchātaḥ kimapi karmma karttuṁ na śaknōti| pitā yat karōti putrōpi tadēva karōti|</para>
  <para style="p">
    <verse number="20" style="v"/>pitā putrē snēhaṁ karōti tasmāt svayaṁ yadyat karmma karōti tatsarvvaṁ putraṁ darśayati ; yathā ca yuṣmākaṁ āścaryyajñānaṁ janiṣyatē tadartham itōpi mahākarmma taṁ darśayiṣyati|</para>
  <para style="p">
    <verse number="21" style="v"/>vastutastu pitā yathā pramitān utthāpya sajivān karōti tadvat putrōpi yaṁ yaṁ icchati taṁ taṁ sajīvaṁ karōti|</para>
  <para style="p">
    <verse number="22" style="v"/>sarvvē pitaraṁ yathā satkurvvanti tathā putramapi satkārayituṁ pitā svayaṁ kasyāpi vicāramakr̥tvā sarvvavicārāṇāṁ bhāraṁ putrē samarpitavān|</para>
  <para style="p">
    <verse number="23" style="v"/>yaḥ putraṁ sat karōti sa tasya prērakamapi sat karōti|</para>
  <para style="p">
    <verse number="24" style="v"/>yuṣmānāhaṁ yathārthataraṁ vadāmi yō janō mama vākyaṁ śrutvā matprērakē viśvasiti sōnantāyuḥ prāpnōti kadāpi daṇḍabājanaṁ na bhavati nidhanādutthāya paramāyuḥ prāpnōti|</para>
  <para style="p">
    <verse number="25" style="v"/>ahaṁ yuṣmānatiyathārthaṁ vadāmi yadā mr̥tā īśvaraputrasya ninādaṁ śrōṣyanti yē ca śrōṣyanti tē sajīvā bhaviṣyanti samaya ētādr̥śa āyāti varam idānīmapyupatiṣṭhati|</para>
  <para style="p">
    <verse number="26" style="v"/>pitā yathā svayañjīvī tathā putrāya svayañjīvitvādhikāraṁ dattavān|</para>
  <para style="p">
    <verse number="27" style="v"/>sa manuṣyaputraḥ ētasmāt kāraṇāt pitā daṇḍakaraṇādhikāramapi tasmin samarpitavān|</para>
  <para style="p">
    <verse number="28" style="v"/>ētadarthē yūyam āścaryyaṁ na manyadhvaṁ yatō yasmin samayē tasya ninādaṁ śrutvā śmaśānasthāḥ sarvvē bahirāgamiṣyanti samaya ētādr̥śa upasthāsyati|</para>
  <para style="p">
    <verse number="29" style="v"/>tasmād yē satkarmmāṇi kr̥tavantasta utthāya āyuḥ prāpsyanti yē ca kukarmāṇi kr̥tavantasta utthāya daṇḍaṁ prāpsyanti|</para>
  <para style="p">
    <verse number="30" style="v"/>ahaṁ svayaṁ kimapi karttuṁ na śaknōmi yathā śuṇōmi tathā vicārayāmi mama vicārañca nyāyyaḥ yatōhaṁ svīyābhīṣṭaṁ nēhitvā matprērayituḥ pituriṣṭam īhē|</para>
  <para style="p">
    <verse number="31" style="v"/>yadi svasmin svayaṁ sākṣyaṁ dadāmi tarhi tatsākṣyam āgrāhyaṁ bhavati ;</para>
  <para style="p">
    <verse number="32" style="v"/>kintu madarthē'parō janaḥ sākṣyaṁ dadāti madarthē tasya yat sākṣyaṁ tat satyam ētadapyahaṁ jānāmi|</para>
  <para style="p">
    <verse number="33" style="v"/>yuṣmābhi ryōhanaṁ prati lōkēṣu prēritēṣu sa satyakathāyāṁ sākṣyamadadāt|</para>
  <para style="p">
    <verse number="34" style="v"/>mānuṣādahaṁ sākṣyaṁ nōpēkṣē tathāpi yūyaṁ yathā paritrayadhvē tadartham idaṁ vākyaṁ vadāmi|</para>
  <para style="p">
    <verse number="35" style="v"/>yōhan dēdīpyamānō dīpa iva tējasvī sthitavān yūyam alpakālaṁ tasya dīptyānandituṁ samamanyadhvaṁ|</para>
  <para style="p">
    <verse number="36" style="v"/>kintu tatpramāṇādapi mama gurutaraṁ pramāṇaṁ vidyatē pitā māṁ prēṣya yadyat karmma samāpayituṁ śakttimadadāt mayā kr̥taṁ tattat karmma madarthē pramāṇaṁ dadāti|</para>
  <para style="p">
    <verse number="37" style="v"/>yaḥ pitā māṁ prēritavān mōpi madarthē pramāṇaṁ dadāti| tasya vākyaṁ yuṣmābhiḥ kadāpi na śrutaṁ tasya rūpañca na dr̥ṣṭaṁ</para>
  <para style="p">
    <verse number="38" style="v"/>tasya vākyañca yuṣmākam antaḥ kadāpi sthānaṁ nāpnōti yataḥ sa yaṁ prēṣitavān yūyaṁ tasmin na viśvasitha|</para>
  <para style="p">
    <verse number="39" style="v"/>dharmmapustakāni yūyam ālōcayadhvaṁ tai rvākyairanantāyuḥ prāpsyāma iti yūyaṁ budhyadhvē taddharmmapustakāni madarthē pramāṇaṁ dadati|</para>
  <para style="p">
    <verse number="40" style="v"/>tathāpi yūyaṁ paramāyuḥprāptayē mama saṁnidhim na jigamiṣatha|</para>
  <para style="p">
    <verse number="41" style="v"/>ahaṁ mānuṣēbhyaḥ satkāraṁ na gr̥hlāmi|</para>
  <para style="p">
    <verse number="42" style="v"/>ahaṁ yuṣmān jānāmi; yuṣmākamantara īśvaraprēma nāsti|</para>
  <para style="p">
    <verse number="43" style="v"/>ahaṁ nijapitu rnāmnāgatōsmi tathāpi māṁ na gr̥hlītha kintu kaścid yadi svanāmnā samāgamiṣyati tarhi taṁ grahīṣyatha|</para>
  <para style="p">
    <verse number="44" style="v"/>yūyam īśvarāt satkāraṁ na ciṣṭatvā kēvalaṁ parasparaṁ satkāram cēd ādadhvvē tarhi kathaṁ viśvasituṁ śaknutha?</para>
  <para style="p">
    <verse number="45" style="v"/>putuḥ samīpē'haṁ yuṣmān apavadiṣyāmīti mā cintayata yasmin , yasmin yuṣmākaṁ viśvasaḥ saēva mūsā yuṣmān apavadati|</para>
  <para style="p">
    <verse number="46" style="v"/>yadi yūyaṁ tasmin vyaśvasiṣyata tarhi mayyapi vyaśvasiṣyata, yat sa mayi likhitavān|</para>
  <para style="p">
    <verse number="47" style="v"/>tatō yadi tēna likhitavāni na pratitha tarhi mama vākyāni kathaṁ pratyēṣyatha?</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tataḥ paraṁ yīśu rgālīl pradēśīyasya tiviriyānāmnaḥ sindhōḥ pāraṁ gatavān|</para>
  <para style="p">
    <verse number="2" style="v"/>tatō vyādhimallōkasvāsthyakaraṇarūpāṇi tasyāścaryyāṇi karmmāṇi dr̥ṣṭvā bahavō janāstatpaścād agacchan|</para>
  <para style="p">
    <verse number="3" style="v"/>tatō yīśuḥ parvvatamāruhya tatra śiṣyaiḥ sākam|</para>
  <para style="p">
    <verse number="4" style="v"/>tasmin samaya nistārōtsavanāmni yihūdīyānāma utsava upasthitē</para>
  <para style="p">
    <verse number="5" style="v"/>yīśu rnētrē uttōlya bahulōkān svasamīpāgatān vilōkya philipaṁ pr̥ṣṭavān ētēṣāṁ bhōjanāya bhōjadravyāṇi vayaṁ kutra krētuṁ śakrumaḥ?</para>
  <para style="p">
    <verse number="6" style="v"/>vākyamidaṁ tasya parīkṣārtham avādīt kintu yat kariṣyati tat svayam ajānāt|</para>
  <para style="p">
    <verse number="7" style="v"/>philipaḥ pratyavōcat ētēṣām ēkaikō yadyalpam alpaṁ prāpnōti tarhi mudrāpādadviśatēna krītapūpā api nyūnā bhaviṣyanti|</para>
  <para style="p">
    <verse number="8" style="v"/>śimōn pitarasya bhrātā āndriyākhyaḥ śiṣyāṇāmēkō vyāhr̥tavān</para>
  <para style="p">
    <verse number="9" style="v"/>atra kasyacid bālakasya samīpē pañca yāvapūpāḥ kṣudramatsyadvayañca santi kintu lōkānāṁ ētāvātāṁ madhyē taiḥ kiṁ bhaviṣyati?</para>
  <para style="p">
    <verse number="10" style="v"/>paścād yīśuravadat lōkānupavēśayata tatra bahuyavasasattvāt pañcasahastrēbhyō nyūnā adhikā vā puruṣā bhūmyām upāviśan|</para>
  <para style="p">
    <verse number="11" style="v"/>tatō yīśustān pūpānādāya īśvarasya guṇān kīrttayitvā śiṣyēṣu samārpayat tatastē tēbhya upaviṣṭalōkēbhyaḥ pūpān yathēṣṭamatsyañca prāduḥ|</para>
  <para style="p">
    <verse number="12" style="v"/>tēṣu tr̥ptēṣu sa tānavōcad ētēṣāṁ kiñcidapi yathā nāpacīyatē tathā sarvvāṇyavaśiṣṭāni saṁgr̥hlīta|</para>
  <para style="p">
    <verse number="13" style="v"/>tataḥ sarvvēṣāṁ bhōjanāt paraṁ tē tēṣāṁ pañcānāṁ yāvapūpānāṁ avaśiṣṭānyakhilāni saṁgr̥hya dvādaśaḍallakān apūrayan|</para>
  <para style="p">
    <verse number="14" style="v"/>aparaṁ yīśōrētādr̥śīm āścaryyakriyāṁ dr̥ṣṭvā lōkā mithō vaktumārēbhirē jagati yasyāgamanaṁ bhaviṣyati sa ēvāyam avaśyaṁ bhaviṣyadvakttā|</para>
  <para style="p">
    <verse number="15" style="v"/>ataēva lōkā āgatya tamākramya rājānaṁ kariṣyanti yīśustēṣām īdr̥śaṁ mānasaṁ vijñāya punaśca parvvatam ēkākī gatavān|</para>
  <para style="p">
    <verse number="16" style="v"/>sāyaṁkāla upasthitē śiṣyā jaladhitaṭaṁ vrajitvā nāvamāruhya nagaradiśi sindhau vāhayitvāgaman|</para>
  <para style="p">
    <verse number="17" style="v"/>tasmin samayē timira upātiṣṭhat kintu yīṣustēṣāṁ samīpaṁ nāgacchat|</para>
  <para style="p">
    <verse number="18" style="v"/>tadā prabalapavanavahanāt sāgarē mahātaraṅgō bhavitum ārēbhē|</para>
  <para style="p">
    <verse number="19" style="v"/>tatastē vāhayitvā dvitrān krōśān gatāḥ paścād yīśuṁ jaladhērupari padbhyāṁ vrajantaṁ naukāntikam āgacchantaṁ vilōkya trāsayuktā abhavan</para>
  <para style="p">
    <verse number="20" style="v"/>kintu sa tānukttavān ayamahaṁ mā bhaiṣṭa|</para>
  <para style="p">
    <verse number="21" style="v"/>tadā tē taṁ svairaṁ nāvi gr̥hītavantaḥ tadā tatkṣaṇād uddiṣṭasthānē naurupāsthāt|</para>
  <para style="p">
    <verse number="22" style="v"/>yayā nāvā śiṣyā agacchan tadanyā kāpi naukā tasmin sthānē nāsīt tatō yīśuḥ śiṣyaiḥ sākaṁ nāgamat kēvalāḥ śiṣyā agaman ētat pārasthā lōkā jñātavantaḥ|</para>
  <para style="p">
    <verse number="23" style="v"/>kintu tataḥ paraṁ prabhu ryatra īśvarasya guṇān anukīrttya lōkān pūpān abhōjayat tatsthānasya samīpasthativiriyāyā aparāstaraṇaya āgaman|</para>
  <para style="p">
    <verse number="24" style="v"/>yīśustatra nāsti śiṣyā api tatra nā santi lōkā iti vijñāya yīśuṁ gavēṣayituṁ taraṇibhiḥ kapharnāhūm puraṁ gatāḥ|</para>
  <para style="p">
    <verse number="25" style="v"/>tatastē saritpatēḥ pārē taṁ sākṣāt prāpya prāvōcan hē gurō bhavān atra sthānē kadāgamat?</para>
  <para style="p">
    <verse number="26" style="v"/>tadā yīśustān pratyavādīd yuṣmānahaṁ yathārthataraṁ vadāmi āścaryyakarmmadarśanāddhētō rna kintu pūpabhōjanāt tēna tr̥ptatvāñca māṁ gavēṣayatha|</para>
  <para style="p">
    <verse number="27" style="v"/>kṣayaṇīyabhakṣyārthaṁ mā śrāmiṣṭa kintvantāyurbhakṣyārthaṁ śrāmyata, tasmāt tādr̥śaṁ bhakṣyaṁ manujaputrō yuṣmābhyaṁ dāsyati; tasmin tāta īśvaraḥ pramāṇaṁ prādāt|</para>
  <para style="p">
    <verse number="28" style="v"/>tadā tē'pr̥cchan īśvarābhimataṁ karmma karttum asmābhiḥ kiṁ karttavyaṁ?</para>
  <para style="p">
    <verse number="29" style="v"/>tatō yīśuravadad īśvarō yaṁ prairayat tasmin viśvasanam īśvarābhimataṁ karmma|</para>
  <para style="p">
    <verse number="30" style="v"/>tadā tē vyāharan bhavatā kiṁ lakṣaṇaṁ darśitaṁ yaddr̥ṣṭvā bhavati viśvasiṣyāmaḥ? tvayā kiṁ karmma kr̥taṁ?</para>
  <para style="p">
    <verse number="31" style="v"/>asmākaṁ pūrvvapuruṣā mahāprāntarē mānnāṁ bhōkttuṁ prāpuḥ yathā lipirāstē| svargīyāṇi tu bhakṣyāṇi pradadau paramēśvaraḥ|</para>
  <para style="p">
    <verse number="32" style="v"/>tadā yīśuravadad ahaṁ yuṣmānatiyathārthaṁ vadāmi mūsā yuṣmābhyaṁ svargīyaṁ bhakṣyaṁ nādāt kintu mama pitā yuṣmābhyaṁ svargīyaṁ paramaṁ bhakṣyaṁ dadāti|</para>
  <para style="p">
    <verse number="33" style="v"/>yaḥ svargādavaruhya jagatē jīvanaṁ dadāti sa īśvaradattabhakṣyarūpaḥ|</para>
  <para style="p">
    <verse number="34" style="v"/>tadā tē prāvōcan hē prabhō bhakṣyamidaṁ nityamasmabhyaṁ dadātu|</para>
  <para style="p">
    <verse number="35" style="v"/>yīśuravadad ahamēva jīvanarūpaṁ bhakṣyaṁ yō janō mama sannidhim āgacchati sa jātu kṣudhārttō na bhaviṣyati, tathā yō janō māṁ pratyēti sa jātu tr̥ṣārttō na bhaviṣyati|</para>
  <para style="p">
    <verse number="36" style="v"/>māṁ dr̥ṣṭvāpi yūyaṁ na viśvasitha yuṣmānaham ityavōcaṁ|</para>
  <para style="p">
    <verse number="37" style="v"/>pitā mahyaṁ yāvatō lōkānadadāt tē sarvva ēva mamāntikam āgamiṣyanti yaḥ kaścicca mama sannidhim āyāsyati taṁ kēnāpi prakārēṇa na dūrīkariṣyāmi|</para>
  <para style="p">
    <verse number="38" style="v"/>nijābhimataṁ sādhayituṁ na hi kintu prērayiturabhimataṁ sādhayituṁ svargād āgatōsmi|</para>
  <para style="p">
    <verse number="39" style="v"/>sa yān yān lōkān mahyamadadāt tēṣāmēkamapi na hārayitvā śēṣadinē sarvvānaham utthāpayāmi idaṁ matprērayituḥ piturabhimataṁ|</para>
  <para style="p">
    <verse number="40" style="v"/>yaḥ kaścin mānavasutaṁ vilōkya viśvasiti sa śēṣadinē mayōtthāpitaḥ san anantāyuḥ prāpsyati iti matprērakasyābhimataṁ|</para>
  <para style="p">
    <verse number="41" style="v"/>tadā svargād yad bhakṣyam avārōhat tad bhakṣyam ahamēva yihūdīyalōkāstasyaitad vākyē vivadamānā vakttumārēbhirē</para>
  <para style="p">
    <verse number="42" style="v"/>yūṣaphaḥ putrō yīśu ryasya mātāpitarau vayaṁ jānīma ēṣa kiṁ saēva na? tarhi svargād avārōham iti vākyaṁ kathaṁ vaktti?</para>
  <para style="p">
    <verse number="43" style="v"/>tadā yīśustān pratyavadat parasparaṁ mā vivadadhvaṁ</para>
  <para style="p">
    <verse number="44" style="v"/>matprērakēṇa pitrā nākr̥ṣṭaḥ kōpi janō mamāntikam āyātuṁ na śaknōti kintvāgataṁ janaṁ caramē'hni prōtthāpayiṣyāmi|</para>
  <para style="p">
    <verse number="45" style="v"/>tē sarvva īśvarēṇa śikṣitā bhaviṣyanti bhaviṣyadvādināṁ granthēṣu lipiritthamāstē atō yaḥ kaścit pituḥ sakāśāt śrutvā śikṣatē sa ēva mama samīpam āgamiṣyati|</para>
  <para style="p">
    <verse number="46" style="v"/>ya īśvarād ajāyata taṁ vinā kōpi manuṣyō janakaṁ nādarśat kēvalaḥ saēva tātam adrākṣīt|</para>
  <para style="p">
    <verse number="47" style="v"/>ahaṁ yuṣmān yathārthataraṁ vadāmi yō janō mayi viśvāsaṁ karōti sōnantāyuḥ prāpnōti|</para>
  <para style="p">
    <verse number="48" style="v"/>ahamēva tajjīvanabhakṣyaṁ|</para>
  <para style="p">
    <verse number="49" style="v"/>yuṣmākaṁ pūrvvapuruṣā mahāprāntarē mannābhakṣyaṁ bhūkttāpi mr̥tāḥ</para>
  <para style="p">
    <verse number="50" style="v"/>kintu yadbhakṣyaṁ svargādāgacchat tad yadi kaścid bhuṅkttē tarhi sa na mriyatē|</para>
  <para style="p">
    <verse number="51" style="v"/>yajjīvanabhakṣyaṁ svargādāgacchat sōhamēva idaṁ bhakṣyaṁ yō janō bhuṅkttē sa nityajīvī bhaviṣyati| punaśca jagatō jīvanārthamahaṁ yat svakīyapiśitaṁ dāsyāmi tadēva mayā vitaritaṁ bhakṣyam|</para>
  <para style="p">
    <verse number="52" style="v"/>tasmād yihūdīyāḥ parasparaṁ vivadamānā vakttumārēbhirē ēṣa bhōjanārthaṁ svīyaṁ palalaṁ katham asmabhyaṁ dāsyati?</para>
  <para style="p">
    <verse number="53" style="v"/>tadā yīśustān āvōcad yuṣmānahaṁ yathārthataraṁ vadāmi manuṣyaputrasyāmiṣē yuṣmābhi rna bhukttē tasya rudhirē ca na pītē jīvanēna sārddhaṁ yuṣmākaṁ sambandhō nāsti|</para>
  <para style="p">
    <verse number="54" style="v"/>yō mamāmiṣaṁ svādati mama sudhirañca pivati sōnantāyuḥ prāpnōti tataḥ śēṣē'hni tamaham utthāpayiṣyāmi|</para>
  <para style="p">
    <verse number="55" style="v"/>yatō madīyamāmiṣaṁ paramaṁ bhakṣyaṁ tathā madīyaṁ śōṇitaṁ paramaṁ pēyaṁ|</para>
  <para style="p">
    <verse number="56" style="v"/>yō janō madīyaṁ palalaṁ svādati madīyaṁ rudhirañca pivati sa mayi vasati tasminnahañca vasāmi|</para>
  <para style="p">
    <verse number="57" style="v"/>matprērayitrā jīvatā tātēna yathāhaṁ jīvāmi tadvad yaḥ kaścin māmatti sōpi mayā jīviṣyati|</para>
  <para style="p">
    <verse number="58" style="v"/>yadbhakṣyaṁ svargādāgacchat tadidaṁ yanmānnāṁ svāditvā yuṣmākaṁ pitarō'mriyanta tādr̥śam idaṁ bhakṣyaṁ na bhavati idaṁ bhakṣyaṁ yō bhakṣati sa nityaṁ jīviṣyati|</para>
  <para style="p">
    <verse number="59" style="v"/>yadā kapharnāhūm puryyāṁ bhajanagēhē upādiśat tadā kathā ētā akathayat|</para>
  <para style="p">
    <verse number="60" style="v"/>tadētthaṁ śrutvā tasya śiṣyāṇām anēkē parasparam akathayan idaṁ gāḍhaṁ vākyaṁ vākyamīdr̥śaṁ kaḥ śrōtuṁ śakruyāt?</para>
  <para style="p">
    <verse number="61" style="v"/>kintu yīśuḥ śiṣyāṇām itthaṁ vivādaṁ svacittē vijñāya kathitavān idaṁ vākyaṁ kiṁ yuṣmākaṁ vighnaṁ janayati?</para>
  <para style="p">
    <verse number="62" style="v"/>yadi manujasutaṁ pūrvvavāsasthānam ūrdvvaṁ gacchantaṁ paśyatha tarhi kiṁ bhaviṣyati?</para>
  <para style="p">
    <verse number="63" style="v"/>ātmaiva jīvanadāyakaḥ vapu rniṣphalaṁ yuṣmabhyamahaṁ yāni vacāṁsi kathayāmi tānyātmā jīvanañca|</para>
  <para style="p">
    <verse number="64" style="v"/>kintu yuṣmākaṁ madhyē kēcana aviśvāsinaḥ santi kē kē na viśvasanti kō vā taṁ parakarēṣu samarpayiṣyati tān yīśurāprathamād vētti|</para>
  <para style="p">
    <verse number="65" style="v"/>aparamapi kathitavān asmāt kāraṇād akathayaṁ pituḥ sakāśāt śakttimaprāpya kōpi mamāntikam āgantuṁ na śaknōti|</para>
  <para style="p">
    <verse number="66" style="v"/>tatkālē'nēkē śiṣyā vyāghuṭya tēna sārddhaṁ puna rnāgacchan|</para>
  <para style="p">
    <verse number="67" style="v"/>tadā yīśu rdvādaśaśiṣyān ukttavān yūyamapi kiṁ yāsyatha?</para>
  <para style="p">
    <verse number="68" style="v"/>tataḥ śimōn pitaraḥ pratyavōcat hē prabhō kasyābhyarṇaṁ gamiṣyāmaḥ?</para>
  <para style="p">
    <verse number="69" style="v"/>anantajīvanadāyinyō yāḥ kathāstāstavaiva| bhavān amarēśvarasyābhiṣikttaputra iti viśvasya niścitaṁ jānīmaḥ|</para>
  <para style="p">
    <verse number="70" style="v"/>tadā yīśuravadat kimahaṁ yuṣmākaṁ dvādaśajanān manōnītān na kr̥tavān? kintu yuṣmākaṁ madhyēpi kaścidēkō vighnakārī vidyatē|</para>
  <para style="p">
    <verse number="71" style="v"/>imāṁ kathaṁ sa śimōnaḥ putram īṣkarīyōtīyaṁ yihūdām uddiśya kathitavān yatō dvādaśānāṁ madhyē gaṇitaḥ sa taṁ parakarēṣu samarpayiṣyati|</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tataḥ paraṁ yihūdīyalōkāstaṁ hantuṁ samaihanta tasmād yīśu ryihūdāpradēśē paryyaṭituṁ nēcchan gālīl pradēśē paryyaṭituṁ prārabhata|</para>
  <para style="p">
    <verse number="2" style="v"/>kintu tasmin samayē yihūdīyānāṁ dūṣyavāsanāmōtsava upasthitē</para>
  <para style="p">
    <verse number="3" style="v"/>tasya bhrātarastam avadan yāni karmmāṇi tvayā kriyantē tāni yathā tava śiṣyāḥ paśyanti tadarthaṁ tvamitaḥ sthānād yihūdīyadēśaṁ vraja|</para>
  <para style="p">
    <verse number="4" style="v"/>yaḥ kaścit svayaṁ pracikāśiṣati sa kadāpi guptaṁ karmma na karōti yadīdr̥śaṁ karmma karōṣi tarhi jagati nijaṁ paricāyaya|</para>
  <para style="p">
    <verse number="5" style="v"/>yatastasya bhrātarōpi taṁ na viśvasanti|</para>
  <para style="p">
    <verse number="6" style="v"/>tadā yīśustān avōcat mama samaya idānīṁ nōpatiṣṭhati kintu yuṣmākaṁ samayaḥ satatam upatiṣṭhati|</para>
  <para style="p">
    <verse number="7" style="v"/>jagatō lōkā yuṣmān r̥tīyituṁ na śakruvanti kintu māmēva r̥tīyantē yatastēṣāṁ karmāṇi duṣṭāni tatra sākṣyamidam ahaṁ dadāmi|</para>
  <para style="p">
    <verse number="8" style="v"/>ataēva yūyam utsavē'smin yāta nāham idānīm asminnutsavē yāmi yatō mama samaya idānīṁ na sampūrṇaḥ|</para>
  <para style="p">
    <verse number="9" style="v"/>iti vākyam ukttvā sa gālīli sthitavān</para>
  <para style="p">
    <verse number="10" style="v"/>kintu tasya bhrātr̥ṣu tatra prasthitēṣu satsu sō'prakaṭa utsavam agacchat|</para>
  <para style="p">
    <verse number="11" style="v"/>anantaram utsavam upasthitā yihūdīyāstaṁ mr̥gayitvāpr̥cchan sa kutra?</para>
  <para style="p">
    <verse number="12" style="v"/>tatō lōkānāṁ madhyē tasmin nānāvidhā vivādā bhavitum ārabdhavantaḥ| kēcid avōcan sa uttamaḥ puruṣaḥ kēcid avōcan na tathā varaṁ lōkānāṁ bhramaṁ janayati|</para>
  <para style="p">
    <verse number="13" style="v"/>kintu yihūdīyānāṁ bhayāt kōpi tasya pakṣē spaṣṭaṁ nākathayat|</para>
  <para style="p">
    <verse number="14" style="v"/>tataḥ param utsavasya madhyasamayē yīśu rmandiraṁ gatvā samupadiśati sma|</para>
  <para style="p">
    <verse number="15" style="v"/>tatō yihūdīyā lōkā āścaryyaṁ jñātvākathayan ēṣā mānuṣō nādhītyā katham ētādr̥śō vidvānabhūt?</para>
  <para style="p">
    <verse number="16" style="v"/>tadā yīśuḥ pratyavōcad upadēśōyaṁ na mama kintu yō māṁ prēṣitavān tasya|</para>
  <para style="p">
    <verse number="17" style="v"/>yō janō nidēśaṁ tasya grahīṣyati mamōpadēśō mattō bhavati kim īśvarād bhavati sa ganastajjñātuṁ śakṣyati|</para>
  <para style="p">
    <verse number="18" style="v"/>yō janaḥ svataḥ kathayati sa svīyaṁ gauravam īhatē kintu yaḥ prērayitu rgauravam īhatē sa satyavādī tasmin kōpyadharmmō nāsti|</para>
  <para style="p">
    <verse number="19" style="v"/>mūsā yuṣmabhyaṁ vyavasthāgranthaṁ kiṁ nādadāt? kintu yuṣmākaṁ kōpi tāṁ vyavasthāṁ na samācarati| māṁ hantuṁ kutō yatadhvē?</para>
  <para style="p">
    <verse number="20" style="v"/>tadā lōkā avadan tvaṁ bhūtagrastastvāṁ hantuṁ kō yatatē?</para>
  <para style="p">
    <verse number="21" style="v"/>tatō yīśuravōcad ēkaṁ karmma mayākāri tasmād yūyaṁ sarvva mahāścaryyaṁ manyadhvē|</para>
  <para style="p">
    <verse number="22" style="v"/>mūsā yuṣmabhyaṁ tvakchēdavidhiṁ pradadau sa mūsātō na jātaḥ kintu pitr̥puruṣēbhyō jātaḥ tēna viśrāmavārē'pi mānuṣāṇāṁ tvakchēdaṁ kurutha|</para>
  <para style="p">
    <verse number="23" style="v"/>ataēva viśrāmavārē manuṣyāṇāṁ tvakchēdē kr̥tē yadi mūsāvyavasthāmaṅganaṁ na bhavati tarhi mayā viśrāmavārē mānuṣaḥ sampūrṇarūpēṇa svasthō'kāri tatkāraṇād yūyaṁ kiṁ mahyaṁ kupyatha?</para>
  <para style="p">
    <verse number="24" style="v"/>sapakṣapātaṁ vicāramakr̥tvā nyāyyaṁ vicāraṁ kuruta|</para>
  <para style="p">
    <verse number="25" style="v"/>tadā yirūśālam nivāsinaḥ katipayajanā akathayan imē yaṁ hantuṁ cēṣṭantē sa ēvāyaṁ kiṁ na?</para>
  <para style="p">
    <verse number="26" style="v"/>kintu paśyata nirbhayaḥ san kathāṁ kathayati tathāpi kimapi a vadantyētē ayamēvābhiṣikttō bhavatīti niścitaṁ kimadhipatayō jānanti?</para>
  <para style="p">
    <verse number="27" style="v"/>manujōyaṁ kasmādāgamad iti vayaṁ jānōmaḥ kintvabhiṣiktta āgatē sa kasmādāgatavān iti kōpi jñātuṁ na śakṣyati|</para>
  <para style="p">
    <verse number="28" style="v"/>tadā yīśu rmadhyēmandiram upadiśan uccaiḥkāram ukttavān yūyaṁ kiṁ māṁ jānītha? kasmāccāgatōsmi tadapi kiṁ jānītha? nāhaṁ svata āgatōsmi kintu yaḥ satyavādī saēva māṁ prēṣitavān yūyaṁ taṁ na jānītha|</para>
  <para style="p">
    <verse number="29" style="v"/>tamahaṁ jānē tēnāhaṁ prērita agatōsmi|</para>
  <para style="p">
    <verse number="30" style="v"/>tasmād yihūdīyāstaṁ dharttum udyatāstathāpi kōpi tasya gātrē hastaṁ nārpayad yatō hētōstadā tasya samayō nōpatiṣṭhati|</para>
  <para style="p">
    <verse number="31" style="v"/>kintu bahavō lōkāstasmin viśvasya kathitavāntō'bhiṣikttapuruṣa āgatya mānuṣasyāsya kriyābhyaḥ kim adhikā āścaryyāḥ kriyāḥ kariṣyati?</para>
  <para style="p">
    <verse number="32" style="v"/>tataḥ paraṁ lōkāstasmin itthaṁ vivadantē phirūśinaḥ pradhānayājakāñcēti śrutavantastaṁ dhr̥tvā nētuṁ padātigaṇaṁ prēṣayāmāsuḥ|</para>
  <para style="p">
    <verse number="33" style="v"/>tatō yīśuravadad aham alpadināni yuṣmābhiḥ sārddhaṁ sthitvā matprērayituḥ samīpaṁ yāsyāmi|</para>
  <para style="p">
    <verse number="34" style="v"/>māṁ mr̥gayiṣyadhvē kintūddēśaṁ na lapsyadhvē ratra sthāsyāmi tatra yūyaṁ gantuṁ na śakṣyatha|</para>
  <para style="p">
    <verse number="35" style="v"/>tadā yihūdīyāḥ parasparaṁ vakttumārēbhirē asyōddēśaṁ na prāpsyāma ētādr̥śaṁ kiṁ sthānaṁ yāsyati? bhinnadēśē vikīrṇānāṁ yihūdīyānāṁ sannidhim ēṣa gatvā tān upadēkṣyati kiṁ?</para>
  <para style="p">
    <verse number="36" style="v"/>nō cēt māṁ gavēṣayiṣyatha kintūddēśaṁ na prāpsyatha ēṣa kōdr̥śaṁ vākyamidaṁ vadati?</para>
  <para style="p">
    <verse number="37" style="v"/>anantaram utsavasya caramē'hani arthāt pradhānadinē yīśuruttiṣṭhan uccaiḥkāram āhvayan uditavān yadi kaścit tr̥ṣārttō bhavati tarhi mamāntikam āgatya pivatu|</para>
  <para style="p">
    <verse number="38" style="v"/>yaḥ kaścinmayi viśvasiti dharmmagranthasya vacanānusārēṇa tasyābhyantaratō'mr̥tatōyasya srōtāṁsi nirgamiṣyanti|</para>
  <para style="p">
    <verse number="39" style="v"/>yē tasmin viśvasanti ta ātmānaṁ prāpsyantītyarthē sa idaṁ vākyaṁ vyāhr̥tavān ētatkālaṁ yāvad yīśu rvibhavaṁ na prāptastasmāt pavitra ātmā nādīyata|</para>
  <para style="p">
    <verse number="40" style="v"/>ētāṁ vāṇīṁ śrutvā bahavō lōkā avadan ayamēva niścitaṁ sa bhaviṣyadvādī|</para>
  <para style="p">
    <verse number="41" style="v"/>kēcid akathayan ēṣaēva sōbhiṣikttaḥ kintu kēcid avadan sōbhiṣikttaḥ kiṁ gālīl pradēśē janiṣyatē?</para>
  <para style="p">
    <verse number="42" style="v"/>sōbhiṣikttō dāyūdō vaṁśē dāyūdō janmasthānē baitlēhami pattanē janiṣyatē dharmmagranthē kimitthaṁ likhitaṁ nāsti?</para>
  <para style="p">
    <verse number="43" style="v"/>itthaṁ tasmin lōkānāṁ bhinnavākyatā jātā|</para>
  <para style="p">
    <verse number="44" style="v"/>katipayalōkāstaṁ dharttum aicchan tathāpi tadvapuṣi kōpi hastaṁ nārpayat|</para>
  <para style="p">
    <verse number="45" style="v"/>anantaraṁ pādātigaṇē pradhānayājakānāṁ phirūśināñca samīpamāgatavati tē tān apr̥cchan kutō hētōstaṁ nānayata?</para>
  <para style="p">
    <verse number="46" style="v"/>tadā padātayaḥ pratyavadan sa mānava iva kōpi kadāpi nōpādiśat|</para>
  <para style="p">
    <verse number="47" style="v"/>tataḥ phirūśinaḥ prāvōcan yūyamapi kimabhrāmiṣṭa?</para>
  <para style="p">
    <verse number="48" style="v"/>adhipatīnāṁ phirūśināñca kōpi kiṁ tasmin vyaśvasīt?</para>
  <para style="p">
    <verse number="49" style="v"/>yē śāstraṁ na jānanti ta imē'dhamalōkāēva śāpagrastāḥ|</para>
  <para style="p">
    <verse number="50" style="v"/>tadā nikadīmanāmā tēṣāmēkō yaḥ kṣaṇadāyāṁ yīśōḥ sannidhim agāt sa ukttavān</para>
  <para style="p">
    <verse number="51" style="v"/>tasya vākyē na śrutē karmmaṇi ca na viditē 'smākaṁ vyavasthā kiṁ kañcana manujaṁ dōṣīkarōti?</para>
  <para style="p">
    <verse number="52" style="v"/>tatastē vyāharan tvamapi kiṁ gālīlīyalōkaḥ? vivicya paśya galīli kōpi bhaviṣyadvādī nōtpadyatē|</para>
  <para style="p">
    <verse number="53" style="v"/>tataḥ paraṁ sarvvē svaṁ svaṁ gr̥haṁ gatāḥ kintu yīśu rjaitunanāmānaṁ śilōccayaṁ gatavān|</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>pratyūṣē yīśuḥ panarmandiram āgacchat</para>
  <para style="p">
    <verse number="2" style="v"/>tataḥ sarvvēṣu lōkēṣu tasya samīpa āgatēṣu sa upaviśya tān upadēṣṭum ārabhata|</para>
  <para style="p">
    <verse number="3" style="v"/>tadā adhyāpakāḥ phirūśinañca vyabhicārakarmmaṇi dhr̥taṁ striyamēkām āniya sarvvēṣāṁ madhyē sthāpayitvā vyāharan</para>
  <para style="p">
    <verse number="4" style="v"/>hē gurō yōṣitam imāṁ vyabhicārakarmma kurvvāṇāṁ lōkā dhr̥tavantaḥ|</para>
  <para style="p">
    <verse number="5" style="v"/>ētādr̥śalōkāḥ pāṣāṇāghātēna hantavyā iti vidhirmūsāvyavasthāgranthē likhitōsti kintu bhavān kimādiśati?</para>
  <para style="p">
    <verse number="6" style="v"/>tē tamapavadituṁ parīkṣābhiprāyēṇa vākyamidam apr̥cchan kintu sa prahvībhūya bhūmāvaṅgalyā lēkhitum ārabhata|</para>
  <para style="p">
    <verse number="7" style="v"/>tatastaiḥ punaḥ punaḥ pr̥ṣṭa utthāya kathitavān yuṣmākaṁ madhyē yō janō niraparādhī saēva prathamam ēnāṁ pāṣāṇēnāhantu|</para>
  <para style="p">
    <verse number="8" style="v"/>paścāt sa punaśca prahvībhūya bhūmau lēkhitum ārabhata|</para>
  <para style="p">
    <verse number="9" style="v"/>tāṁ kathaṁ śrutvā tē svasvamanasi prabōdhaṁ prāpya jyēṣṭhānukramaṁ ēkaikaśaḥ sarvvē bahiragacchan tatō yīśurēkākī tayakttōbhavat madhyasthānē daṇḍāyamānā sā yōṣā ca sthitā|</para>
  <para style="p">
    <verse number="10" style="v"/>tatpaścād yīśurutthāya tāṁ vanitāṁ vinā kamapyaparaṁ na vilōkya pr̥ṣṭavān hē vāmē tavāpavādakāḥ kutra? kōpi tvāṁ kiṁ na daṇḍayati?</para>
  <para style="p">
    <verse number="11" style="v"/>sāvadat hē mahēccha kōpi na tadā yīśuravōcat nāhamapi daṇḍayāmi yāhi punaḥ pāpaṁ mākārṣīḥ|</para>
  <para style="p">
    <verse number="12" style="v"/>tatō yīśuḥ punarapi lōkēbhya itthaṁ kathayitum ārabhata jagatōhaṁ jyōtiḥsvarūpō yaḥ kaścin matpaścāda gacchati sa timirē na bhramitvā jīvanarūpāṁ dīptiṁ prāpsyati|</para>
  <para style="p">
    <verse number="13" style="v"/>tataḥ phirūśinō'vādiṣustvaṁ svārthē svayaṁ sākṣyaṁ dadāsi tasmāt tava sākṣyaṁ grāhyaṁ na bhavati|</para>
  <para style="p">
    <verse number="14" style="v"/>tadā yīśuḥ pratyuditavān yadyapi svārthē'haṁ svayaṁ sākṣyaṁ dadāmi tathāpi mat sākṣyaṁ grāhyaṁ yasmād ahaṁ kuta āgatōsmi kva yāmi ca tadahaṁ jānāmi kintu kuta āgatōsmi kutra gacchāmi ca tad yūyaṁ na jānītha|</para>
  <para style="p">
    <verse number="15" style="v"/>yūyaṁ laukikaṁ vicārayatha nāhaṁ kimapi vicārayāmi|</para>
  <para style="p">
    <verse number="16" style="v"/>kintu yadi vicārayāmi tarhi mama vicārō grahītavyō yatōham ēkākī nāsmi prērayitā pitā mayā saha vidyatē|</para>
  <para style="p">
    <verse number="17" style="v"/>dvayō rjanayōḥ sākṣyaṁ grahaṇīyaṁ bhavatīti yuṣmākaṁ vyavasthāgranthē likhitamasti|</para>
  <para style="p">
    <verse number="18" style="v"/>ahaṁ svārthē svayaṁ sākṣitvaṁ dadāmi yaśca mama tātō māṁ prēritavān sōpi madarthē sākṣyaṁ dadāti|</para>
  <para style="p">
    <verse number="19" style="v"/>tadā tē'pr̥cchan tava tātaḥ kutra? tatō yīśuḥ pratyavādīd yūyaṁ māṁ na jānītha matpitarañca na jānītha yadi mām akṣāsyata tarhi mama tātamapyakṣāsyata|</para>
  <para style="p">
    <verse number="20" style="v"/>yīśu rmandira upadiśya bhaṇḍāgārē kathā ētā akathayat tathāpi taṁ prati kōpi karaṁ nōdatōlayat|</para>
  <para style="p">
    <verse number="21" style="v"/>tataḥ paraṁ yīśuḥ punaruditavān adhunāhaṁ gacchāmi yūyaṁ māṁ gavēṣayiṣyatha kintu nijaiḥ pāpai rmariṣyatha yat sthānam ahaṁ yāsyāmi tat sthānam yūyaṁ yātuṁ na śakṣyatha|</para>
  <para style="p">
    <verse number="22" style="v"/>tadā yihūdīyāḥ prāvōcan kimayam ātmaghātaṁ kariṣyati? yatō yat sthānam ahaṁ yāsyāmi tat sthānam yūyaṁ yātuṁ na śakṣyatha iti vākyaṁ bravīti|</para>
  <para style="p">
    <verse number="23" style="v"/>tatō yīśustēbhyaḥ kathitavān yūyam adhaḥsthānīyā lōkā aham ūrdvvasthānīyaḥ yūyam ētajjagatsambandhīyā aham ētajjagatsambandhīyō na|</para>
  <para style="p">
    <verse number="24" style="v"/>tasmāt kathitavān yūyaṁ nijaiḥ pāpai rmariṣyatha yatōhaṁ sa pumān iti yadi na viśvasitha tarhi nijaiḥ pāpai rmariṣyatha|</para>
  <para style="p">
    <verse number="25" style="v"/>tadā tē 'pr̥cchan kastvaṁ? tatō yīśuḥ kathitavān yuṣmākaṁ sannidhau yasya prastāvam ā prathamāt karōmi saēva puruṣōhaṁ|</para>
  <para style="p">
    <verse number="26" style="v"/>yuṣmāsu mayā bahuvākyaṁ vakttavyaṁ vicārayitavyañca kintu matprērayitā satyavādī tasya samīpē yadahaṁ śrutavān tadēva jagatē kathayāmi|</para>
  <para style="p">
    <verse number="27" style="v"/>kintu sa janakē vākyamidaṁ prōkttavān iti tē nābudhyanta|</para>
  <para style="p">
    <verse number="28" style="v"/>tatō yīśurakathayad yadā manuṣyaputram ūrdvva utthāpayiṣyatha tadāhaṁ sa pumān kēvalaḥ svayaṁ kimapi karmma na karōmi kintu tātō yathā śikṣayati tadanusārēṇa vākyamidaṁ vadāmīti ca yūyaṁ jñātuṁ śakṣyatha|</para>
  <para style="p">
    <verse number="29" style="v"/>matprērayitā pitā mām ēkākinaṁ na tyajati sa mayā sārddhaṁ tiṣṭhati yatōhaṁ tadabhimataṁ karmma sadā karōmi|</para>
  <para style="p">
    <verse number="30" style="v"/>tadā tasyaitāni vākyāni śrutvā bahuvastāsmin vyaśvasan|</para>
  <para style="p">
    <verse number="31" style="v"/>yē yihūdīyā vyaśvasan yīśustēbhyō'kathayat</para>
  <para style="p">
    <verse number="32" style="v"/>mama vākyē yadi yūyam āsthāṁ kurutha tarhi mama śiṣyā bhūtvā satyatvaṁ jñāsyatha tataḥ satyatayā yuṣmākaṁ mōkṣō bhaviṣyati|</para>
  <para style="p">
    <verse number="33" style="v"/>tadā tē pratyavādiṣuḥ vayam ibrāhīmō vaṁśaḥ kadāpi kasyāpi dāsā na jātāstarhi yuṣmākaṁ muktti rbhaviṣyatīti vākyaṁ kathaṁ bravīṣi?</para>
  <para style="p">
    <verse number="34" style="v"/>tadā yīśuḥ pratyavadad yuṣmānahaṁ yathārthataraṁ vadāmi yaḥ pāpaṁ karōti sa pāpasya dāsaḥ|</para>
  <para style="p">
    <verse number="35" style="v"/>dāsaśca nirantaraṁ nivēśanē na tiṣṭhati kintu putrō nirantaraṁ tiṣṭhati|</para>
  <para style="p">
    <verse number="36" style="v"/>ataḥ putrō yadi yuṣmān mōcayati tarhi nitāntamēva mukttā bhaviṣyatha|</para>
  <para style="p">
    <verse number="37" style="v"/>yuyam ibrāhīmō vaṁśa ityahaṁ jānāmi kintu mama kathā yuṣmākam antaḥkaraṇēṣu sthānaṁ na prāpnuvanti tasmāddhētō rmāṁ hantum īhadhvē|</para>
  <para style="p">
    <verse number="38" style="v"/>ahaṁ svapituḥ samīpē yadapaśyaṁ tadēva kathayāmi tathā yūyamapi svapituḥ samīpē yadapaśyata tadēva kurudhvē|</para>
  <para style="p">
    <verse number="39" style="v"/>tadā tē pratyavōcan ibrāhīm asmākaṁ pitā tatō yīśurakathayad yadi yūyam ibrāhīmaḥ santānā abhaviṣyata tarhi ibrāhīma ācāraṇavad ācariṣyata|</para>
  <para style="p">
    <verse number="40" style="v"/>īśvarasya mukhāt satyaṁ vākyaṁ śrutvā yuṣmān jñāpayāmi yōhaṁ taṁ māṁ hantuṁ cēṣṭadhvē ibrāhīm ētādr̥śaṁ karmma na cakāra|</para>
  <para style="p">
    <verse number="41" style="v"/>yūyaṁ svasvapituḥ karmmāṇi kurutha tadā tairukttaṁ na vayaṁ jārajātā asmākam ēkaēva pitāsti sa ēvēśvaraḥ</para>
  <para style="p">
    <verse number="42" style="v"/>tatō yīśunā kathitam īśvarō yadi yuṣmākaṁ tātōbhaviṣyat tarhi yūyaṁ mayi prēmākariṣyata yatōham īśvarānnirgatyāgatōsmi svatō nāgatōhaṁ sa māṁ prāhiṇōt|</para>
  <para style="p">
    <verse number="43" style="v"/>yūyaṁ mama vākyamidaṁ na budhyadhvē kutaḥ? yatō yūyaṁ mamōpadēśaṁ sōḍhuṁ na śaknutha|</para>
  <para style="p">
    <verse number="44" style="v"/>yūyaṁ śaitān pituḥ santānā ētasmād yuṣmākaṁ piturabhilāṣaṁ pūrayatha sa ā prathamāt naraghātī tadantaḥ satyatvasya lēśōpi nāsti kāraṇādataḥ sa satyatāyāṁ nātiṣṭhat sa yadā mr̥ṣā kathayati tadā nijasvabhāvānusārēṇaiva kathayati yatō sa mr̥ṣābhāṣī mr̥ṣōtpādakaśca|</para>
  <para style="p">
    <verse number="45" style="v"/>ahaṁ tathyavākyaṁ vadāmi kāraṇādasmād yūyaṁ māṁ na pratītha|</para>
  <para style="p">
    <verse number="46" style="v"/>mayi pāpamastīti pramāṇaṁ yuṣmākaṁ kō dātuṁ śaknōti? yadyahaṁ tathyavākyaṁ vadāmi tarhi kutō māṁ na pratitha?</para>
  <para style="p">
    <verse number="47" style="v"/>yaḥ kaścana īśvarīyō lōkaḥ sa īśvarīyakathāyāṁ manō nidhattē yūyam īśvarīyalōkā na bhavatha tannidānāt tatra na manāṁsi nidhadvē|</para>
  <para style="p">
    <verse number="48" style="v"/>tadā yihūdīyāḥ pratyavādiṣuḥ tvamēkaḥ śōmirōṇīyō bhūtagrastaśca vayaṁ kimidaṁ bhadraṁ nāvādiṣma?</para>
  <para style="p">
    <verse number="49" style="v"/>tatō yīśuḥ pratyavādīt nāhaṁ bhūtagrastaḥ kintu nijatātaṁ sammanyē tasmād yūyaṁ mām apamanyadhvē|</para>
  <para style="p">
    <verse number="50" style="v"/>ahaṁ svasukhyātiṁ na cēṣṭē kintu cēṣṭitā vicārayitā cāpara ēka āstē|</para>
  <para style="p">
    <verse number="51" style="v"/>ahaṁ yuṣmabhyam atīva yathārthaṁ kathayāmi yō narō madīyaṁ vācaṁ manyatē sa kadācana nidhanaṁ na drakṣyati|</para>
  <para style="p">
    <verse number="52" style="v"/>yihūdīyāstamavadan tvaṁ bhūtagrasta itīdānīm avaiṣma| ibrāhīm bhaviṣyadvādinañca sarvvē mr̥tāḥ kintu tvaṁ bhāṣasē yō narō mama bhāratīṁ gr̥hlāti sa jātu nidhānāsvādaṁ na lapsyatē|</para>
  <para style="p">
    <verse number="53" style="v"/>tarhi tvaṁ kim asmākaṁ pūrvvapuruṣād ibrāhīmōpi mahān? yasmāt sōpi mr̥taḥ bhaviṣyadvādinōpi mr̥tāḥ tvaṁ svaṁ kaṁ pumāṁsaṁ manuṣē?</para>
  <para style="p">
    <verse number="54" style="v"/>yīśuḥ pratyavōcad yadyahaṁ svaṁ svayaṁ sammanyē tarhi mama tat sammananaṁ kimapi na kintu mama tātō yaṁ yūyaṁ svīyam īśvaraṁ bhāṣadhvē saēva māṁ sammanutē|</para>
  <para style="p">
    <verse number="55" style="v"/>yūyaṁ taṁ nāvagacchatha kintvahaṁ tamavagacchāmi taṁ nāvagacchāmīti vākyaṁ yadi vadāmi tarhi yūyamiva mr̥ṣābhāṣī bhavāmi kintvahaṁ tamavagacchāmi tadākṣāmapi gr̥hlāmi|</para>
  <para style="p">
    <verse number="56" style="v"/>yuṣmākaṁ pūrvvapuruṣa ibrāhīm mama samayaṁ draṣṭum atīvāvāñchat tannirīkṣyānandacca|</para>
  <para style="p">
    <verse number="57" style="v"/>tadā yihūdīyā apr̥cchan tava vayaḥ pañcāśadvatsarā na tvaṁ kim ibrāhīmam adrākṣīḥ?</para>
  <para style="p">
    <verse number="58" style="v"/>yīśuḥ pratyavādīd yuṣmānahaṁ yathārthataraṁ vadāmi ibrāhīmō janmanaḥ pūrvvakālamārabhyāhaṁ vidyē|</para>
  <para style="p">
    <verse number="59" style="v"/>tadā tē pāṣāṇān uttōlya tamāhantum udayacchan kintu yīśu rguptō mantirād bahirgatya tēṣāṁ madhyēna prasthitavān|</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tataḥ paraṁ yīśurgacchan mārgamadhyē janmāndhaṁ naram apaśyat|</para>
  <para style="p">
    <verse number="2" style="v"/>tataḥ śiṣyāstam apr̥cchan hē gurō narōyaṁ svapāpēna vā svapitrāḥ pāpēnāndhō'jāyata?</para>
  <para style="p">
    <verse number="3" style="v"/>tataḥ sa pratyuditavān ētasya vāsya pitrōḥ pāpād ētādr̥śōbhūda iti nahi kintvanēna yathēśvarasya karmma prakāśyatē taddhētōrēva|</para>
  <para style="p">
    <verse number="4" style="v"/>dinē tiṣṭhati matprērayituḥ karmma mayā karttavyaṁ yadā kimapi karmma na kriyatē tādr̥śī niśāgacchati|</para>
  <para style="p">
    <verse number="5" style="v"/>ahaṁ yāvatkālaṁ jagati tiṣṭhāmi tāvatkālaṁ jagatō jyōtiḥsvarūpōsmi|</para>
  <para style="p">
    <verse number="6" style="v"/>ityukttā bhūmau niṣṭhīvaṁ nikṣipya tēna paṅkaṁ kr̥tavān</para>
  <para style="p">
    <verse number="7" style="v"/>paścāt tatpaṅkēna tasyāndhasya nētrē pralipya tamityādiśat gatvā śilōhē 'rthāt prēritanāmni sarasi snāhi| tatōndhō gatvā tatrāsnāt tataḥ prannacakṣu rbhūtvā vyāghuṭyāgāt|</para>
  <para style="p">
    <verse number="8" style="v"/>aparañca samīpavāsinō lōkā yē ca taṁ pūrvvamandham apaśyan tē bakttum ārabhanta yōndhalōkō vartmanyupaviśyābhikṣata sa ēvāyaṁ janaḥ kiṁ na bhavati?</para>
  <para style="p">
    <verse number="9" style="v"/>kēcidavadan sa ēva kēcidavōcan tādr̥śō bhavati kintu sa svayamabravīt sa ēvāhaṁ bhavāmi|</para>
  <para style="p">
    <verse number="10" style="v"/>ataēva tē 'pr̥cchan tvaṁ kathaṁ dr̥ṣṭiṁ pāptavān?</para>
  <para style="p">
    <verse number="11" style="v"/>tataḥ sōvadad yīśanāmaka ēkō janō mama nayanē paṅkēna pralipya ityājñāpayat śilōhakāsāraṁ gatvā tatra snāhi| tatastatra gatvā mayi snātē dr̥ṣṭimahaṁ labdhavān|</para>
  <para style="p">
    <verse number="12" style="v"/>tadā tē 'vadan sa pumān kutra? tēnōkttaṁ nāhaṁ jānāmi|</para>
  <para style="p">
    <verse number="13" style="v"/>aparaṁ tasmin pūrvvāndhē janē phirūśināṁ nikaṭam ānītē sati phirūśinōpi tamapr̥cchan kathaṁ dr̥ṣṭiṁ prāptōsi?</para>
  <para style="p">
    <verse number="14" style="v"/>tataḥ sa kathitavān sa paṅkēna mama nētrē 'limpat paścād snātvā dr̥ṣṭimalabhē|</para>
  <para style="p">
    <verse number="15" style="v"/>kintu yīśu rviśrāmavārē karddamaṁ kr̥tvā tasya nayanē prasannē'karōd itikāraṇāt katipayaphirūśinō'vadan</para>
  <para style="p">
    <verse number="16" style="v"/>sa pumān īśvarānna yataḥ sa viśrāmavāraṁ na manyatē| tatōnyē kēcit pratyavadan pāpī pumān kim ētādr̥śam āścaryyaṁ karmma karttuṁ śaknōti?</para>
  <para style="p">
    <verse number="17" style="v"/>itthaṁ tēṣāṁ parasparaṁ bhinnavākyatvam abhavat| paścāt tē punarapi taṁ pūrvvāndhaṁ mānuṣam aprākṣuḥ yō janastava cakṣuṣī prasannē kr̥tavān tasmin tvaṁ kiṁ vadasi? sa ukttavān sa bhaviśadvādī|</para>
  <para style="p">
    <verse number="18" style="v"/>sa dr̥ṣṭim āptavān iti yihūdīyāstasya dr̥ṣṭiṁ prāptasya janasya pitrō rmukhād aśrutvā na pratyayan|</para>
  <para style="p">
    <verse number="19" style="v"/>ataēva tē tāvapr̥cchan yuvayō ryaṁ putraṁ janmāndhaṁ vadathaḥ sa kimayaṁ? tarhīdānīṁ kathaṁ draṣṭuṁ śaknōti?</para>
  <para style="p">
    <verse number="20" style="v"/>tatastasya pitarau pratyavōcatām ayam āvayōḥ putra ā janērandhaśca tadapyāvāṁ jānīvaḥ</para>
  <para style="p">
    <verse number="21" style="v"/>kintvadhunā kathaṁ dr̥ṣṭiṁ prāptavān tadāvāṁ n jānīvaḥ kōsya cakṣuṣī prasannē kr̥tavān tadapi na jānīva ēṣa vayaḥprāpta ēnaṁ pr̥cchata svakathāṁ svayaṁ vakṣyati|</para>
  <para style="p">
    <verse number="22" style="v"/>yihūdīyānāṁ bhayāt tasya pitarau vākyamidam avadatāṁ yataḥ kōpi manuṣyō yadi yīśum abhiṣiktaṁ vadati tarhi sa bhajanagr̥hād dūrīkāriṣyatē yihūdīyā iti mantraṇām akurvvan</para>
  <para style="p">
    <verse number="23" style="v"/>atastasya pitarau vyāharatām ēṣa vayaḥprāpta ēnaṁ pr̥cchata|</para>
  <para style="p">
    <verse number="24" style="v"/>tadā tē punaśca taṁ pūrvvāndham āhūya vyāharan īśvarasya guṇān vada ēṣa manuṣyaḥ pāpīti vayaṁ jānīmaḥ|</para>
  <para style="p">
    <verse number="25" style="v"/>tadā sa ukttavān sa pāpī na vēti nāhaṁ jānē pūrvāmandha āsamaham adhunā paśyāmīti mātraṁ jānāmi|</para>
  <para style="p">
    <verse number="26" style="v"/>tē punarapr̥cchan sa tvāṁ prati kimakarōt? kathaṁ nētrē prasannē 'karōt?</para>
  <para style="p">
    <verse number="27" style="v"/>tataḥ sōvādīd ēkakr̥tvōkathayaṁ yūyaṁ na śr̥ṇutha tarhi kutaḥ punaḥ śrōtum icchatha? yūyamapi kiṁ tasya śiṣyā bhavitum icchatha?</para>
  <para style="p">
    <verse number="28" style="v"/>tadā tē taṁ tiraskr̥tya vyāharan tvaṁ tasya śiṣyō vayaṁ mūsāḥ śiṣyāḥ|</para>
  <para style="p">
    <verse number="29" style="v"/>mūsāvaktrēṇēśvarō jagāda tajjānīmaḥ kintvēṣa kutratyalōka iti na jānīmaḥ|</para>
  <para style="p">
    <verse number="30" style="v"/>sōvadad ēṣa mama lōcanē prasannē 'karōt tathāpi kutratyalōka iti yūyaṁ na jānītha ētad āścaryyaṁ bhavati|</para>
  <para style="p">
    <verse number="31" style="v"/>īśvaraḥ pāpināṁ kathāṁ na śr̥ṇōti kintu yō janastasmin bhaktiṁ kr̥tvā tadiṣṭakriyāṁ karōti tasyaiva kathāṁ śr̥ṇōti ētad vayaṁ jānīmaḥ|</para>
  <para style="p">
    <verse number="32" style="v"/>kōpi manuṣyō janmāndhāya cakṣuṣī adadāt jagadārambhād ētādr̥śīṁ kathāṁ kōpi kadāpi nāśr̥ṇōt|</para>
  <para style="p">
    <verse number="33" style="v"/>asmād ēṣa manuṣyō yadīśvarānnājāyata tarhi kiñcidapīdr̥śaṁ karmma karttuṁ nāśaknōt|</para>
  <para style="p">
    <verse number="34" style="v"/>tē vyāharan tvaṁ pāpād ajāyathāḥ kimasmān tvaṁ śikṣayasi? paścāttē taṁ bahirakurvvan|</para>
  <para style="p">
    <verse number="35" style="v"/>tadanantaraṁ yihūdīyaiḥ sa bahirakriyata yīśuriti vārttāṁ śrutvā taṁ sākṣāt prāpya pr̥ṣṭavān īśvarasya putrē tvaṁ viśvasiṣi?</para>
  <para style="p">
    <verse number="36" style="v"/>tadā sa pratyavōcat hē prabhō sa kō yat tasminnahaṁ viśvasimi?</para>
  <para style="p">
    <verse number="37" style="v"/>tatō yīśuḥ kathitavān tvaṁ taṁ dr̥ṣṭavān tvayā sākaṁ yaḥ kathaṁ kathayati saēva saḥ|</para>
  <para style="p">
    <verse number="38" style="v"/>tadā hē prabhō viśvasimītyuktvā sa taṁ praṇāmat|</para>
  <para style="p">
    <verse number="39" style="v"/>paścād yīśuḥ kathitavān nayanahīnā nayanāni prāpnuvanti nayanavantaścāndhā bhavantītyabhiprāyēṇa jagadāham āgaccham|</para>
  <para style="p">
    <verse number="40" style="v"/>ētat śrutvā nikaṭasthāḥ katipayāḥ phirūśinō vyāharan vayamapi kimandhāḥ?</para>
  <para style="p">
    <verse number="41" style="v"/>tadā yīśuravādīd yadyandhā abhavata tarhi pāpāni nātiṣṭhan kintu paśyāmīti vākyavadanād yuṣmākaṁ pāpāni tiṣṭhanti|</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ahaṁ yuṣmānatiyathārthaṁ vadāmi, yō janō dvārēṇa na praviśya kēnāpyanyēna mēṣagr̥haṁ praviśati sa ēva stēnō dasyuśca|</para>
  <para style="p">
    <verse number="2" style="v"/>yō dvārēṇa praviśati sa ēva mēṣapālakaḥ|</para>
  <para style="p">
    <verse number="3" style="v"/>dauvārikastasmai dvāraṁ mōcayati mēṣagaṇaśca tasya vākyaṁ śr̥ṇōti sa nijān mēṣān svasvanāmnāhūya bahiḥ kr̥tvā nayati|</para>
  <para style="p">
    <verse number="4" style="v"/>tathā nijān mēṣān bahiḥ kr̥tvā svayaṁ tēṣām agrē gacchati, tatō mēṣāstasya śabdaṁ budhyantē, tasmāt tasya paścād vrajanti|</para>
  <para style="p">
    <verse number="5" style="v"/>kintu parasya śabdaṁ na budhyantē tasmāt tasya paścād vrajiṣyanti varaṁ tasya samīpāt palāyiṣyantē|</para>
  <para style="p">
    <verse number="6" style="v"/>yīśustēbhya imāṁ dr̥ṣṭāntakathām akathayat kintu tēna kathitakathāyāstātparyyaṁ tē nābudhyanta|</para>
  <para style="p">
    <verse number="7" style="v"/>atō yīśuḥ punarakathayat, yuṣmānāhaṁ yathārthataraṁ vyāharāmi, mēṣagr̥hasya dvāram ahamēva|</para>
  <para style="p">
    <verse number="8" style="v"/>mayā na praviśya ya āgacchan tē stēnā dasyavaśca kintu mēṣāstēṣāṁ kathā nāśr̥ṇvan|</para>
  <para style="p">
    <verse number="9" style="v"/>ahamēva dvārasvarūpaḥ, mayā yaḥ kaścita praviśati sa rakṣāṁ prāpsyati tathā bahirantaśca gamanāgamanē kr̥tvā caraṇasthānaṁ prāpsyati|</para>
  <para style="p">
    <verse number="10" style="v"/>yō janastēnaḥ sa kēvalaṁ stainyabadhavināśān karttumēva samāyāti kintvaham āyu rdātum arthāt bāhūlyēna tadēva dātum āgaccham|</para>
  <para style="p">
    <verse number="11" style="v"/>ahamēva satyamēṣapālakō yastu satyō mēṣapālakaḥ sa mēṣārthaṁ prāṇatyāgaṁ karōti;</para>
  <para style="p">
    <verse number="12" style="v"/>kintu yō janō mēṣapālakō na, arthād yasya mēṣā nijā na bhavanti, ya ētādr̥śō vaitanikaḥ sa vr̥kam āgacchantaṁ dr̥ṣṭvā mējavrajaṁ vihāya palāyatē, tasmād vr̥kastaṁ vrajaṁ dhr̥tvā vikirati|</para>
  <para style="p">
    <verse number="13" style="v"/>vaitanikaḥ palāyatē yataḥ sa vētanārthī mēṣārthaṁ na cintayati|</para>
  <para style="p">
    <verse number="14" style="v"/>ahamēva satyō mēṣapālakaḥ, pitā māṁ yathā jānāti, ahañca yathā pitaraṁ jānāmi,</para>
  <para style="p">
    <verse number="15" style="v"/>tathā nijān mēṣānapi jānāmi, mēṣāśca māṁ jānānti, ahañca mēṣārthaṁ prāṇatyāgaṁ karōmi|</para>
  <para style="p">
    <verse number="16" style="v"/>aparañca ētad gr̥hīya mēṣēbhyō bhinnā api mēṣā mama santi tē sakalā ānayitavyāḥ; tē mama śabdaṁ śrōṣyanti tata ēkō vraja ēkō rakṣakō bhaviṣyati|</para>
  <para style="p">
    <verse number="17" style="v"/>prāṇānahaṁ tyaktvā punaḥ prāṇān grahīṣyāmi, tasmāt pitā mayi snēhaṁ karōti|</para>
  <para style="p">
    <verse number="18" style="v"/>kaścijjanō mama prāṇān hantuṁ na śaknōti kintu svayaṁ tān samarpayāmi tān samarpayituṁ punargrahītuñca mama śaktirāstē bhāramimaṁ svapituḥ sakāśāt prāptōham|</para>
  <para style="p">
    <verse number="19" style="v"/>asmādupadēśāt punaśca yihūdīyānāṁ madhyē bhinnavākyatā jātā|</para>
  <para style="p">
    <verse number="20" style="v"/>tatō bahavō vyāharan ēṣa bhūtagrasta unmattaśca, kuta ētasya kathāṁ śr̥ṇutha?</para>
  <para style="p">
    <verse number="21" style="v"/>kēcid avadan ētasya kathā bhūtagrastasya kathāvanna bhavanti, bhūtaḥ kim andhāya cakṣuṣī dātuṁ śaknōti?</para>
  <para style="p">
    <verse number="22" style="v"/>śītakālē yirūśālami mandirōtsargaparvvaṇyupasthitē</para>
  <para style="p">
    <verse number="23" style="v"/>yīśuḥ sulēmānō niḥsārēṇa gamanāgamanē karōti,</para>
  <para style="p">
    <verse number="24" style="v"/>ētasmin samayē yihūdīyāstaṁ vēṣṭayitvā vyāharan kati kālān asmākaṁ vicikitsāṁ sthāpayiṣyāmi? yadyabhiṣiktō bhavati tarhi tat spaṣṭaṁ vada|</para>
  <para style="p">
    <verse number="25" style="v"/>tadā yīśuḥ pratyavadad aham acakathaṁ kintu yūyaṁ na pratītha, nijapitu rnāmnā yāṁ yāṁ kriyāṁ karōmi sā kriyaiva mama sākṣisvarūpā|</para>
  <para style="p">
    <verse number="26" style="v"/>kintvahaṁ pūrvvamakathayaṁ yūyaṁ mama mēṣā na bhavatha, kāraṇādasmān na viśvasitha|</para>
  <para style="p">
    <verse number="27" style="v"/>mama mēṣā mama śabdaṁ śr̥ṇvanti tānahaṁ jānāmi tē ca mama paścād gacchanti|</para>
  <para style="p">
    <verse number="28" style="v"/>ahaṁ tēbhyō'nantāyu rdadāmi, tē kadāpi na naṁkṣyanti kōpi mama karāt tān harttuṁ na śakṣyati|</para>
  <para style="p">
    <verse number="29" style="v"/>yō mama pitā tān mahyaṁ dattavān sa sarvvasmāt mahān, kōpi mama pituḥ karāt tān harttuṁ na śakṣyati|</para>
  <para style="p">
    <verse number="30" style="v"/>ahaṁ pitā ca dvayōrēkatvam|</para>
  <para style="p">
    <verse number="31" style="v"/>tatō yihūdīyāḥ punarapi taṁ hantuṁ pāṣāṇān udatōlayan|</para>
  <para style="p">
    <verse number="32" style="v"/>yīśuḥ kathitavān pituḥ sakāśād bahūnyuttamakarmmāṇi yuṣmākaṁ prākāśayaṁ tēṣāṁ kasya karmmaṇaḥ kāraṇān māṁ pāṣāṇairāhantum udyatāḥ stha?</para>
  <para style="p">
    <verse number="33" style="v"/>yihūdīyāḥ pratyavadan praśastakarmmahētō rna kintu tvaṁ mānuṣaḥ svamīśvaram uktvēśvaraṁ nindasi kāraṇādasmāt tvāṁ pāṣāṇairhanmaḥ|</para>
  <para style="p">
    <verse number="34" style="v"/>tadā yīśuḥ pratyuktavān mayā kathitaṁ yūyam īśvarā ētadvacanaṁ yuṣmākaṁ śāstrē likhitaṁ nāsti kiṁ?</para>
  <para style="p">
    <verse number="35" style="v"/>tasmād yēṣām uddēśē īśvarasya kathā kathitā tē yadīśvaragaṇā ucyantē dharmmagranthasyāpyanyathā bhavituṁ na śakyaṁ,</para>
  <para style="p">
    <verse number="36" style="v"/>tarhyāham īśvarasya putra iti vākyasya kathanāt yūyaṁ pitrābhiṣiktaṁ jagati prēritañca pumāṁsaṁ katham īśvaranindakaṁ vādaya?</para>
  <para style="p">
    <verse number="37" style="v"/>yadyahaṁ pituḥ karmma na karōmi tarhi māṁ na pratīta;</para>
  <para style="p">
    <verse number="38" style="v"/>kintu yadi karōmi tarhi mayi yuṣmābhiḥ pratyayē na kr̥tē'pi kāryyē pratyayaḥ kriyatāṁ, tatō mayi pitāstīti pitaryyaham asmīti ca kṣātvā viśvasiṣyatha|</para>
  <para style="p">
    <verse number="39" style="v"/>tadā tē punarapi taṁ dharttum acēṣṭanta kintu sa tēṣāṁ karēbhyō nistīryya</para>
  <para style="p">
    <verse number="40" style="v"/>puna ryarddan adyāstaṭē yatra purvvaṁ yōhan amajjayat tatrāgatya nyavasat|</para>
  <para style="p">
    <verse number="41" style="v"/>tatō bahavō lōkāstatsamīpam āgatya vyāharan yōhan kimapyāścaryyaṁ karmma nākarōt kintvasmin manuṣyē yā yaḥ kathā akathayat tāḥ sarvvāḥ satyāḥ;</para>
  <para style="p">
    <verse number="42" style="v"/>tatra ca bahavō lōkāstasmin vyaśvasan|</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ mariyam tasyā bhaginī marthā ca yasmin vaithanīyāgrāmē vasatastasmin grāmē iliyāsar nāmā pīḍita ēka āsīt|</para>
  <para style="p">
    <verse number="2" style="v"/>yā mariyam prabhuṁ sugandhitēlaina marddayitvā svakēśaistasya caraṇau samamārjat tasyā bhrātā sa iliyāsar rōgī|</para>
  <para style="p">
    <verse number="3" style="v"/>aparañca hē prabhō bhavān yasmin prīyatē sa ēva pīḍitōstīti kathāṁ kathayitvā tasya bhaginyau prēṣitavatyau|</para>
  <para style="p">
    <verse number="4" style="v"/>tadā yīśurimāṁ vārttāṁ śrutvākathayata pīḍēyaṁ maraṇārthaṁ na kintvīśvarasya mahimārtham īśvaraputrasya mahimaprakāśārthañca jātā|</para>
  <para style="p">
    <verse number="5" style="v"/>yīśu ryadyapimarthāyāṁ tadbhaginyām iliyāsari cāprīyata,</para>
  <para style="p">
    <verse number="6" style="v"/>tathāpi iliyāsaraḥ pīḍāyāḥ kathaṁ śrutvā yatra āsīt tatraiva dinadvayamatiṣṭhat|</para>
  <para style="p">
    <verse number="7" style="v"/>tataḥ param sa śiṣyānakathayad vayaṁ puna ryihūdīyapradēśaṁ yāmaḥ|</para>
  <para style="p">
    <verse number="8" style="v"/>tatastē pratyavadan, hē gurō svalpadināni gatāni yihūdīyāstvāṁ pāṣāṇai rhantum udyatāstathāpi kiṁ punastatra yāsyasi?</para>
  <para style="p">
    <verse number="9" style="v"/>yīśuḥ pratyavadat, ēkasmin dinē kiṁ dvādaśaghaṭikā na bhavanti? kōpi divā gacchan na skhalati yataḥ sa ētajjagatō dīptiṁ prāpnōti|</para>
  <para style="p">
    <verse number="10" style="v"/>kintu rātrau gacchan skhalati yatō hētōstatra dīpti rnāsti|</para>
  <para style="p">
    <verse number="11" style="v"/>imāṁ kathāṁ kathayitvā sa tānavadad, asmākaṁ bandhuḥ iliyāsar nidritōbhūd idānīṁ taṁ nidrātō jāgarayituṁ gacchāmi|</para>
  <para style="p">
    <verse number="12" style="v"/>yīśu rmr̥tau kathāmimāṁ kathitavān kintu viśrāmārthaṁ nidrāyāṁ kathitavān iti jñātvā śiṣyā akathayan,</para>
  <para style="p">
    <verse number="13" style="v"/>hē gurō sa yadi nidrāti tarhi bhadramēva|</para>
  <para style="p">
    <verse number="14" style="v"/>tadā yīśuḥ spaṣṭaṁ tān vyāharat, iliyāsar amriyata;</para>
  <para style="p">
    <verse number="15" style="v"/>kintu yūyaṁ yathā pratītha tadarthamahaṁ tatra na sthitavān ityasmād yuṣmannimittam āhlāditōhaṁ, tathāpi tasya samīpē yāma|</para>
  <para style="p">
    <verse number="16" style="v"/>tadā thōmā yaṁ didumaṁ vadanti sa saṅginaḥ śiṣyān avadad vayamapi gatvā tēna sārddhaṁ mriyāmahai|</para>
  <para style="p">
    <verse number="17" style="v"/>yīśustatrōpasthāya iliyāsaraḥ śmaśānē sthāpanāt catvāri dināni gatānīti vārttāṁ śrutavān|</para>
  <para style="p">
    <verse number="18" style="v"/>vaithanīyā yirūśālamaḥ samīpasthā krōśaikamātrāntaritā;</para>
  <para style="p">
    <verse number="19" style="v"/>tasmād bahavō yihūdīyā marthāṁ mariyamañca bhyātr̥śōkāpannāṁ sāntvayituṁ tayōḥ samīpam āgacchan|</para>
  <para style="p">
    <verse number="20" style="v"/>marthā yīśōrāgamanavārtāṁ śrutvaiva taṁ sākṣād akarōt kintu mariyam gēha upaviśya sthitā|</para>
  <para style="p">
    <verse number="21" style="v"/>tadā marthā yīśumavādat, hē prabhō yadi bhavān atrāsthāsyat tarhi mama bhrātā nāmariṣyat|</para>
  <para style="p">
    <verse number="22" style="v"/>kintvidānīmapi yad īśvarē prārthayiṣyatē īśvarastad dāsyatīti jānē'haṁ|</para>
  <para style="p">
    <verse number="23" style="v"/>yīśuravādīt tava bhrātā samutthāsyati|</para>
  <para style="p">
    <verse number="24" style="v"/>marthā vyāharat śēṣadivasē sa utthānasamayē prōtthāsyatīti jānē'haṁ|</para>
  <para style="p">
    <verse number="25" style="v"/>tadā yīśuḥ kathitavān ahamēva utthāpayitā jīvayitā ca yaḥ kaścana mayi viśvasiti sa mr̥tvāpi jīviṣyati;</para>
  <para style="p">
    <verse number="26" style="v"/>yaḥ kaścana ca jīvan mayi viśvasiti sa kadāpi na mariṣyati, asyāṁ kathāyāṁ kiṁ viśvasiṣi?</para>
  <para style="p">
    <verse number="27" style="v"/>sāvadat prabhō yasyāvataraṇāpēkṣāsti bhavān saēvābhiṣiktta īśvaraputra iti viśvasimi|</para>
  <para style="p">
    <verse number="28" style="v"/>iti kathāṁ kathayitvā sā gatvā svāṁ bhaginīṁ mariyamaṁ guptamāhūya vyāharat gururupatiṣṭhati tvāmāhūyati ca|</para>
  <para style="p">
    <verse number="29" style="v"/>kathāmimāṁ śrutvā sā tūrṇam utthāya tasya samīpam agacchat|</para>
  <para style="p">
    <verse number="30" style="v"/>yīśu rgrāmamadhyaṁ na praviśya yatra marthā taṁ sākṣād akarōt tatra sthitavān|</para>
  <para style="p">
    <verse number="31" style="v"/>yē yihūdīyā mariyamā sākaṁ gr̥hē tiṣṭhantastām asāntvayana tē tāṁ kṣipram utthāya gacchantiṁ vilōkya vyāharan, sa śmaśānē rōdituṁ yāti, ityuktvā tē tasyāḥ paścād agacchan|</para>
  <para style="p">
    <verse number="32" style="v"/>yatra yīśuratiṣṭhat tatra mariyam upasthāya taṁ dr̥ṣṭvā tasya caraṇayōḥ patitvā vyāharat hē prabhō yadi bhavān atrāsthāsyat tarhi mama bhrātā nāmariṣyat|</para>
  <para style="p">
    <verse number="33" style="v"/>yīśustāṁ tasyāḥ saṅginō yihūdīyāṁśca rudatō vilōkya śōkārttaḥ san dīrghaṁ niśvasya kathitavān taṁ kutrāsthāpayata?</para>
  <para style="p">
    <verse number="34" style="v"/>tē vyāharan, hē prabhō bhavān āgatya paśyatu|</para>
  <para style="p">
    <verse number="35" style="v"/>yīśunā kranditaṁ|</para>
  <para style="p">
    <verse number="36" style="v"/>ataēva yihūdīyā avadan, paśyatāyaṁ tasmin kidr̥g apriyata|</para>
  <para style="p">
    <verse number="37" style="v"/>tēṣāṁ kēcid avadan yōndhāya cakṣuṣī dattavān sa kim asya mr̥tyuṁ nivārayituṁ nāśaknōt?</para>
  <para style="p">
    <verse number="38" style="v"/>tatō yīśuḥ punarantardīrghaṁ niśvasya śmaśānāntikam agacchat| tat śmaśānam ēkaṁ gahvaraṁ tanmukhē pāṣāṇa ēka āsīt|</para>
  <para style="p">
    <verse number="39" style="v"/>tadā yīśuravadad ēnaṁ pāṣāṇam apasārayata, tataḥ pramītasya bhaginī marthāvadat prabhō, adhunā tatra durgandhō jātaḥ, yatōdya catvāri dināni śmaśānē sa tiṣṭhati|</para>
  <para style="p">
    <verse number="40" style="v"/>tadā yīśuravādīt, yadi viśvasiṣi tarhīśvarasya mahimaprakāśaṁ drakṣyasi kathāmimāṁ kiṁ tubhyaṁ nākathayaṁ?</para>
  <para style="p">
    <verse number="41" style="v"/>tadā mr̥tasya śmaśānāt pāṣāṇō'pasāritē yīśurūrdvvaṁ paśyan akathayat, hē pita rmama nēvēsanam aśr̥ṇōḥ kāraṇādasmāt tvāṁ dhanyaṁ vadāmi|</para>
  <para style="p">
    <verse number="42" style="v"/>tvaṁ satataṁ śr̥ṇōṣi tadapyahaṁ jānāmi, kintu tvaṁ māṁ yat prairayastad yathāsmin sthānē sthitā lōkā viśvasanti tadartham idaṁ vākyaṁ vadāmi|</para>
  <para style="p">
    <verse number="43" style="v"/>imāṁ kathāṁ kathayitvā sa prōccairāhvayat, hē iliyāsar bahirāgaccha|</para>
  <para style="p">
    <verse number="44" style="v"/>tataḥ sa pramītaḥ śmaśānavastrai rbaddhahastapādō gātramārjanavāsasā baddhamukhaśca bahirāgacchat| yīśuruditavān bandhanāni mōcayitvā tyajatainaṁ|</para>
  <para style="p">
    <verse number="45" style="v"/>mariyamaḥ samīpam āgatā yē yihūdīyalōkāstadā yīśōrētat karmmāpaśyan tēṣāṁ bahavō vyaśvasan,</para>
  <para style="p">
    <verse number="46" style="v"/>kintu kēcidanyē phirūśināṁ samīpaṁ gatvā yīśōrētasya karmmaṇō vārttām avadan|</para>
  <para style="p">
    <verse number="47" style="v"/>tataḥ paraṁ pradhānayājakāḥ phirūśināśca sabhāṁ kr̥tvā vyāharan vayaṁ kiṁ kurmmaḥ? ēṣa mānavō bahūnyāścaryyakarmmāṇi karōti|</para>
  <para style="p">
    <verse number="48" style="v"/>yadīdr̥śaṁ karmma karttuṁ na vārayāmastarhi sarvvē lōkāstasmin viśvasiṣyanti rōmilōkāścāgatyāsmākam anayā rājadhānyā sārddhaṁ rājyam āchētsyanti|</para>
  <para style="p">
    <verse number="49" style="v"/>tadā tēṣāṁ kiyaphānāmā yastasmin vatsarē mahāyājakapadē nyayujyata sa pratyavadad yūyaṁ kimapi na jānītha;</para>
  <para style="p">
    <verse number="50" style="v"/>samagradēśasya vināśatōpi sarvvalōkārtham ēkasya janasya maraṇam asmākaṁ maṅgalahētukam ētasya vivēcanāmapi na kurutha|</para>
  <para style="p">
    <verse number="51" style="v"/>ētāṁ kathāṁ sa nijabuddhyā vyāharad iti na,</para>
  <para style="p">
    <verse number="52" style="v"/>kintu yīśūstaddēśīyānāṁ kāraṇāt prāṇān tyakṣyati, diśi diśi vikīrṇān īśvarasya santānān saṁgr̥hyaikajātiṁ kariṣyati ca, tasmin vatsarē kiyaphā mahāyājakatvapadē niyuktaḥ san idaṁ bhaviṣyadvākyaṁ kathitavān|</para>
  <para style="p">
    <verse number="53" style="v"/>taddinamārabhya tē kathaṁ taṁ hantuṁ śaknuvantīti mantraṇāṁ karttuṁ prārēbhirē|</para>
  <para style="p">
    <verse number="54" style="v"/>ataēva yihūdīyānāṁ madhyē yīśuḥ saprakāśaṁ gamanāgamanē akr̥tvā tasmād gatvā prāntarasya samīpasthāyipradēśasyēphrāyim nāmni nagarē śiṣyaiḥ sākaṁ kālaṁ yāpayituṁ prārēbhē|</para>
  <para style="p">
    <verse number="55" style="v"/>anantaraṁ yihūdīyānāṁ nistārōtsavē nikaṭavarttini sati tadutsavāt pūrvvaṁ svān śucīn karttuṁ bahavō janā grāmēbhyō yirūśālam nagaram āgacchan,</para>
  <para style="p">
    <verse number="56" style="v"/>yīśōranvēṣaṇaṁ kr̥tvā mandirē daṇḍāyamānāḥ santaḥ parasparaṁ vyāharan, yuṣmākaṁ kīdr̥śō bōdhō jāyatē? sa kim utsavē'smin atrāgamiṣyati?</para>
  <para style="p">
    <verse number="57" style="v"/>sa ca kutrāsti yadyētat kaścid vētti tarhi darśayatu pradhānayājakāḥ phirūśinaśca taṁ dharttuṁ pūrvvam imām ājñāṁ prācārayan|</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>nistārōtsavāt pūrvvaṁ dinaṣaṭkē sthitē yīśu ryaṁ pramītam iliyāsaraṁ śmaśānād udasthāparat tasya nivāsasthānaṁ baithaniyāgrāmam āgacchat|</para>
  <para style="p">
    <verse number="2" style="v"/>tatra tadarthaṁ rajanyāṁ bhōjyē kr̥tē marthā paryyavēṣayad iliyāsar ca tasya saṅgibhiḥ sārddhaṁ bhōjanāsana upāviśat|</para>
  <para style="p">
    <verse number="3" style="v"/>tadā mariyam arddhasēṭakaṁ bahumūlyaṁ jaṭāmāṁsīyaṁ tailam ānīya yīśōścaraṇayō rmarddayitvā nijakēśa rmārṣṭum ārabhata; tadā tailasya parimalēna gr̥ham āmōditam abhavat|</para>
  <para style="p">
    <verse number="4" style="v"/>yaḥ śimōnaḥ putra riṣkariyōtīyō yihūdānāmā yīśuṁ parakarēṣu samarpayiṣyati sa śiṣyastadā kathitavān,</para>
  <para style="p">
    <verse number="5" style="v"/>ētattailaṁ tribhiḥ śatai rmudrāpadai rvikrītaṁ sad daridrēbhyaḥ kutō nādīyata?</para>
  <para style="p">
    <verse number="6" style="v"/>sa daridralōkārtham acintayad iti na, kintu sa caura ēvaṁ tannikaṭē mudrāsampuṭakasthityā tanmadhyē yadatiṣṭhat tadapāharat tasmāt kāraṇād imāṁ kathāmakathayat|</para>
  <para style="p">
    <verse number="7" style="v"/>tadā yīśurakathayad ēnāṁ mā vāraya sā mama śmaśānasthāpanadinārthaṁ tadarakṣayat|</para>
  <para style="p">
    <verse number="8" style="v"/>daridrā yuṣmākaṁ sannidhau sarvvadā tiṣṭhanti kintvahaṁ sarvvadā yuṣmākaṁ sannidhau na tiṣṭhāmi|</para>
  <para style="p">
    <verse number="9" style="v"/>tataḥ paraṁ yīśustatrāstīti vārttāṁ śrutvā bahavō yihūdīyāstaṁ śmaśānādutthāpitam iliyāsarañca draṣṭuṁ tat sthānam āgacchana|</para>
  <para style="p">
    <verse number="10" style="v"/>tadā pradhānayājakāstam iliyāsaramapi saṁharttum amantrayan ;</para>
  <para style="p">
    <verse number="11" style="v"/>yatastēna bahavō yihūdīyā gatvā yīśau vyaśvasan|</para>
  <para style="p">
    <verse number="12" style="v"/>anantaraṁ yīśu ryirūśālam nagaram āgacchatīti vārttāṁ śrutvā parē'hani utsavāgatā bahavō lōkāḥ</para>
  <para style="p">
    <verse number="13" style="v"/>kharjjūrapatrādyānīya taṁ sākṣāt karttuṁ bahirāgatya jaya jayēti vācaṁ prōccai rvaktum ārabhanta, isrāyēlō yō rājā paramēśvarasya nāmnāgacchati sa dhanyaḥ|</para>
  <para style="p">
    <verse number="14" style="v"/>tadā "hē siyōnaḥ kanyē mā bhaiṣīḥ paśyāyaṁ tava rājā garddabhaśāvakam āruhyāgacchati"</para>
  <para style="p">
    <verse number="15" style="v"/>iti śāstrīyavacanānusārēṇa yīśurēkaṁ yuvagarddabhaṁ prāpya taduparyyārōhat|</para>
  <para style="p">
    <verse number="16" style="v"/>asyāḥ ghaṭanāyāstātparyyaṁ śiṣyāḥ prathamaṁ nābudhyanta, kintu yīśau mahimānaṁ prāptē sati vākyamidaṁ tasmina akathyata lōkāśca tampratīttham akurvvan iti tē smr̥tavantaḥ|</para>
  <para style="p">
    <verse number="17" style="v"/>sa iliyāsaraṁ śmaśānād āgantum āhvatavān śmaśānāñca udasthāpayad yē yē lōkāstatkarmya sākṣād apaśyan tē pramāṇaṁ dātum ārabhanta|</para>
  <para style="p">
    <verse number="18" style="v"/>sa ētādr̥śam adbhutaṁ karmmakarōt tasya janaśrutē rlōkāstaṁ sākṣāt karttum āgacchan|</para>
  <para style="p">
    <verse number="19" style="v"/>tataḥ phirūśinaḥ parasparaṁ vaktum ārabhanta yuṣmākaṁ sarvvāścēṣṭā vr̥thā jātāḥ, iti kiṁ yūyaṁ na budhyadhvē? paśyata sarvvē lōkāstasya paścādvarttinōbhavan|</para>
  <para style="p">
    <verse number="20" style="v"/>bhajanaṁ karttum utsavāgatānāṁ lōkānāṁ katipayā janā anyadēśīyā āsan ,</para>
  <para style="p">
    <verse number="21" style="v"/>tē gālīlīyabaitsaidānivāsinaḥ philipasya samīpam āgatya vyāharan hē mahēccha vayaṁ yīśuṁ draṣṭum icchāmaḥ|</para>
  <para style="p">
    <verse number="22" style="v"/>tataḥ philipō gatvā āndriyam avadat paścād āndriyaphilipau yīśavē vārttām akathayatāṁ|</para>
  <para style="p">
    <verse number="23" style="v"/>tadā yīśuḥ pratyuditavān mānavasutasya mahimaprāptisamaya upasthitaḥ|</para>
  <para style="p">
    <verse number="24" style="v"/>ahaṁ yuṣmānatiyathārthaṁ vadāmi, dhānyabījaṁ mr̥ttikāyāṁ patitvā yadi na mr̥yatē tarhyēkākī tiṣṭhati kintu yadi mr̥yatē tarhi bahuguṇaṁ phalaṁ phalati|</para>
  <para style="p">
    <verse number="25" style="v"/>yō janēा nijaprāṇān priyān jānāti sa tān hārayiṣyati kintu yēा jana ihalōkē nijaprāṇān apriyān jānāti sēाnantāyuḥ prāptuṁ tān rakṣiṣyati|</para>
  <para style="p">
    <verse number="26" style="v"/>kaścid yadi mama sēvakō bhavituṁ vāñchati tarhi sa mama paścādgāmī bhavatu, tasmād ahaṁ yatra tiṣṭhāmi mama sēvakēाpi tatra sthāsyati; yō janō māṁ sēvatē mama pitāpi taṁ sammaṁsyatē|</para>
  <para style="p">
    <verse number="27" style="v"/>sāmprataṁ mama prāṇā vyākulā bhavanti, tasmād hē pitara ētasmāt samayān māṁ rakṣa, ityahaṁ kiṁ prārthayiṣyē? kintvaham ētatsamayārtham avatīrṇavān|</para>
  <para style="p">
    <verse number="28" style="v"/>hē pita: svanāmnō mahimānaṁ prakāśaya; tanaiva svanāmnō mahimānam ahaṁ prākāśayaṁ punarapi prakāśayiṣyāmi, ēṣā gagaṇīyā vāṇī tasmin samayē'jāyata|</para>
  <para style="p">
    <verse number="29" style="v"/>tacśrutvā samīpasthalōkānāṁ kēcid avadan mēghō'garjīt, kēcid avadan svargīyadūtō'nēna saha kathāmacakathat|</para>
  <para style="p">
    <verse number="30" style="v"/>tadā yīśuḥ pratyavādīt, madarthaṁ śabdōyaṁ nābhūt yuṣmadarthamēvābhūt|</para>
  <para style="p">
    <verse number="31" style="v"/>adhunā jagatōsya vicāra: sampatsyatē, adhunāsya jagata: patī rājyāt cyōṣyati|</para>
  <para style="p">
    <verse number="32" style="v"/>yadyaī pr̥thivyā ūrdvvē prōtthāpitōsmi tarhi sarvvān mānavān svasamīpam ākarṣiṣyāmi|</para>
  <para style="p">
    <verse number="33" style="v"/>kathaṁ tasya mr̥ti rbhaviṣyati, ētad bōdhayituṁ sa imāṁ kathām akathayat|</para>
  <para style="p">
    <verse number="34" style="v"/>tadā lōkā akathayan sōbhiṣiktaḥ sarvvadā tiṣṭhatīti vyavasthāgranthē śrutam asmābhiḥ, tarhi manuṣyaputraḥ prōtthāpitō bhaviṣyatīti vākyaṁ kathaṁ vadasi? manuṣyaputrōyaṁ kaḥ?</para>
  <para style="p">
    <verse number="35" style="v"/>tadā yīśurakathāyad yuṣmābhiḥ sārddham alpadināni jyōtirāstē, yathā yuṣmān andhakārō nācchādayati tadarthaṁ yāvatkālaṁ yuṣmābhiḥ sārddhaṁ jyōtistiṣṭhati tāvatkālaṁ gacchata; yō janō'ndhakārē gacchati sa kutra yātīti na jānāti|</para>
  <para style="p">
    <verse number="36" style="v"/>ataēva yāvatkālaṁ yuṣmākaṁ nikaṭē jyōtirāstē tāvatkālaṁ jyōtīrūpasantānā bhavituṁ jyōtiṣi viśvasita; imāṁ kathāṁ kathayitvā yīśuḥ prasthāya tēbhyaḥ svaṁ guptavān|</para>
  <para style="p">
    <verse number="37" style="v"/>yadyapi yīśustēṣāṁ samakṣam ētāvadāścaryyakarmmāṇi kr̥tavān tathāpi tē tasmin na vyaśvasan|</para>
  <para style="p">
    <verse number="38" style="v"/>ataēva kaḥ pratyēti susaṁvādaṁ parēśāsmat pracāritaṁ? prakāśatē parēśasya hastaḥ kasya ca sannidhau? yiśayiyabhaviṣyadvādinā yadētad vākyamuktaṁ tat saphalam abhavat|</para>
  <para style="p">
    <verse number="39" style="v"/>tē pratyētuṁ nāśankuvan tasmin yiśayiyabhaviṣyadvādi punaravādīd,</para>
  <para style="p">
    <verse number="40" style="v"/>yadā, "tē nayanai rna paśyanti buddhibhiśca na budhyantē tai rmanaḥsu parivarttitēṣu ca tānahaṁ yathā svasthān na karōmi tathā sa tēṣāṁ lōcanānyandhāni kr̥tvā tēṣāmantaḥkaraṇāni gāḍhāni kariṣyati|"</para>
  <para style="p">
    <verse number="41" style="v"/>yiśayiyō yadā yīśō rmahimānaṁ vilōkya tasmin kathāmakathayat tadā bhaviṣyadvākyam īdr̥śaṁ prakāśayat|</para>
  <para style="p">
    <verse number="42" style="v"/>tathāpyadhipatināṁ bahavastasmin pratyāyan| kintu phirūśinastān bhajanagr̥hād dūrīkurvvantīti bhayāt tē taṁ na svīkr̥tavantaḥ|</para>
  <para style="p">
    <verse number="43" style="v"/>yata īśvarasya praśaṁsātō mānavānāṁ praśaṁsāyāṁ tē'priyanta|</para>
  <para style="p">
    <verse number="44" style="v"/>tadā yīśuruccaiḥkāram akathayad yō janō mayi viśvasiti sa kēvalē mayi viśvasitīti na, sa matprērakē'pi viśvasiti|</para>
  <para style="p">
    <verse number="45" style="v"/>yō janō māṁ paśyati sa matprērakamapi paśyati|</para>
  <para style="p">
    <verse number="46" style="v"/>yō janō māṁ pratyēti sa yathāndhakārē na tiṣṭhati tadartham ahaṁ jyōtiḥsvarūpō bhūtvā jagatyasmin avatīrṇavān|</para>
  <para style="p">
    <verse number="47" style="v"/>mama kathāṁ śrutvā yadi kaścin na viśvasiti tarhi tamahaṁ dōṣiṇaṁ na karōmi, yatō hētō rjagatō janānāṁ dōṣān niścitān karttuṁ nāgatya tān paricātum āgatōsmi|</para>
  <para style="p">
    <verse number="48" style="v"/>yaḥ kaścin māṁ na śraddhāya mama kathaṁ na gr̥hlāti, anyastaṁ dōṣiṇaṁ kariṣyati vastutastu yāṁ kathāmaham acakathaṁ sā kathā caramē'nhi taṁ dōṣiṇaṁ kariṣyati|</para>
  <para style="p">
    <verse number="49" style="v"/>yatō hētōrahaṁ svataḥ kimapi na kathayāmi, kiṁ kiṁ mayā kathayitavyaṁ kiṁ samupadēṣṭavyañca iti matprērayitā pitā māmājñāpayat|</para>
  <para style="p">
    <verse number="50" style="v"/>tasya sājñā anantāyurityahaṁ jānāmi, ataēvāhaṁ yat kathayāmi tat pitā yathājñāpayat tathaiva kathayāmyaham|</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>nistārōtsavasya kiñcitkālāt pūrvvaṁ pr̥thivyāḥ pituḥ samīpagamanasya samayaḥ sannikarṣōbhūd iti jñātvā yīśurāprathamād yēṣu jagatpravāsiṣvātmīyalōkēṣa prēma karōti sma tēṣu śēṣaṁ yāvat prēma kr̥tavān|</para>
  <para style="p">
    <verse number="2" style="v"/>pitā tasya hastē sarvvaṁ samarpitavān svayam īśvarasya samīpād āgacchad īśvarasya samīpaṁ yāsyati ca, sarvvāṇyētāni jñātvā rajanyāṁ bhōjanē sampūrṇē sati,</para>
  <para style="p">
    <verse number="3" style="v"/>yadā śaitān taṁ parahastēṣu samarpayituṁ śimōnaḥ putrasya īṣkāriyōtiyasya yihūdā antaḥkaraṇē kupravr̥ttiṁ samārpayat,</para>
  <para style="p">
    <verse number="4" style="v"/>tadā yīśu rbhōjanāsanād utthāya gātravastraṁ mōcayitvā gātramārjanavastraṁ gr̥hītvā tēna svakaṭim abadhnāt,</para>
  <para style="p">
    <verse number="5" style="v"/>paścād ēkapātrē jalam abhiṣicya śiṣyāṇāṁ pādān prakṣālya tēna kaṭibaddhagātramārjanavāsasā mārṣṭuṁ prārabhata|</para>
  <para style="p">
    <verse number="6" style="v"/>tataḥ śimōnpitarasya samīpamāgatē sa uktavān hē prabhō bhavān kiṁ mama pādau prakṣālayiṣyati?</para>
  <para style="p">
    <verse number="7" style="v"/>yīśuruditavān ahaṁ yat karōmi tat samprati na jānāsi kintu paścāj jñāsyasi|</para>
  <para style="p">
    <verse number="8" style="v"/>tataḥ pitaraḥ kathitavān bhavān kadāpi mama pādau na prakṣālayiṣyati| yīśurakathayad yadi tvāṁ na prakṣālayē tarhi mayi tava kōpyaṁśō nāsti|</para>
  <para style="p">
    <verse number="9" style="v"/>tadā śimōnpitaraḥ kathitavān hē prabhō tarhi kēvalapādau na, mama hastau śiraśca prakṣālayatu|</para>
  <para style="p">
    <verse number="10" style="v"/>tatō yīśuravadad yō janō dhautastasya sarvvāṅgapariṣkr̥tatvāt pādau vinānyāṅgasya prakṣālanāpēkṣā nāsti| yūyaṁ pariṣkr̥tā iti satyaṁ kintu na sarvvē,</para>
  <para style="p">
    <verse number="11" style="v"/>yatō yō janastaṁ parakarēṣu samarpayiṣyati taṁ sa jñātavāna; ataēva yūyaṁ sarvvē na pariṣkr̥tā imāṁ kathāṁ kathitavān|</para>
  <para style="p">
    <verse number="12" style="v"/>itthaṁ yīśustēṣāṁ pādān prakṣālya vastraṁ paridhāyāsanē samupaviśya kathitavān ahaṁ yuṣmān prati kiṁ karmmākārṣaṁ jānītha?</para>
  <para style="p">
    <verse number="13" style="v"/>yūyaṁ māṁ guruṁ prabhuñca vadatha tat satyamēva vadatha yatōhaṁ saēva bhavāmi|</para>
  <para style="p">
    <verse number="14" style="v"/>yadyahaṁ prabhu rguruśca san yuṣmākaṁ pādān prakṣālitavān tarhi yuṣmākamapi parasparaṁ pādaprakṣālanam ucitam|</para>
  <para style="p">
    <verse number="15" style="v"/>ahaṁ yuṣmān prati yathā vyavāharaṁ yuṣmān tathā vyavaharttum ēkaṁ panthānaṁ darśitavān|</para>
  <para style="p">
    <verse number="16" style="v"/>ahaṁ yuṣmānatiyathārthaṁ vadāmi, prabhō rdāsō na mahān prērakācca prēritō na mahān|</para>
  <para style="p">
    <verse number="17" style="v"/>imāṁ kathāṁ viditvā yadi tadanusārataḥ karmmāṇi kurutha tarhi yūyaṁ dhanyā bhaviṣyatha|</para>
  <para style="p">
    <verse number="18" style="v"/>sarvvēṣu yuṣmāsu kathāmimāṁ kathayāmi iti na, yē mama manōnītāstānahaṁ jānāmi, kintu mama bhakṣyāṇi yō bhuṅktē matprāṇaprātikūlyataḥ| utthāpayati pādasya mūlaṁ sa ēṣa mānavaḥ|yadētad dharmmapustakasya vacanaṁ tadanusārēṇāvaśyaṁ ghaṭiṣyatē|</para>
  <para style="p">
    <verse number="19" style="v"/>ahaṁ sa jana ityatra yathā yuṣmākaṁ viśvāsō jāyatē tadarthaṁ ētādr̥śaghaṭanāt pūrvvam ahamidānīṁ yuṣmabhyamakathayam|</para>
  <para style="p">
    <verse number="20" style="v"/>ahaṁ yuṣmānatīva yathārthaṁ vadāmi, mayā prēritaṁ janaṁ yō gr̥hlāti sa māmēva gr̥hlāti yaśca māṁ gr̥hlāti sa matprērakaṁ gr̥hlāti|</para>
  <para style="p">
    <verse number="21" style="v"/>ētāṁ kathāṁ kathayitvā yīśu rduḥkhī san pramāṇaṁ dattvā kathitavān ahaṁ yuṣmānatiyathārthaṁ vadāmi yuṣmākam ēkō janō māṁ parakarēṣu samarpayiṣyati|</para>
  <para style="p">
    <verse number="22" style="v"/>tataḥ sa kamuddiśya kathāmētāṁ kathitavān ityatra sandigdhāḥ śiṣyāḥ parasparaṁ mukhamālōkayituṁ prārabhanta|</para>
  <para style="p">
    <verse number="23" style="v"/>tasmin samayē yīśu ryasmin aprīyata sa śiṣyastasya vakṣaḥsthalam avālambata|</para>
  <para style="p">
    <verse number="24" style="v"/>śimōnpitarastaṁ saṅkētēnāvadat, ayaṁ kamuddiśya kathāmētām kathayatīti pr̥ccha|</para>
  <para style="p">
    <verse number="25" style="v"/>tadā sa yīśō rvakṣaḥsthalam avalambya pr̥ṣṭhavān, hē prabhō sa janaḥ kaḥ?</para>
  <para style="p">
    <verse number="26" style="v"/>tatō yīśuḥ pratyavadad ēkakhaṇḍaṁ pūpaṁ majjayitvā yasmai dāsyāmi saēva saḥ; paścāt pūpakhaṇḍamēkaṁ majjayitvā śimōnaḥ putrāya īṣkariyōtīyāya yihūdai dattavān|</para>
  <para style="p">
    <verse number="27" style="v"/>tasmin dattē sati śaitān tamāśrayat; tadā yīśustam avadat tvaṁ yat kariṣyasi tat kṣipraṁ kuru|</para>
  <para style="p">
    <verse number="28" style="v"/>kintu sa yēnāśayēna tāṁ kathāmakathāyat tam upaviṣṭalōkānāṁ kōpi nābudhyata;</para>
  <para style="p">
    <verse number="29" style="v"/>kintu yihūdāḥ samīpē mudrāsampuṭakasthitēḥ kēcid ittham abudhyanta pārvvaṇāsādanārthaṁ kimapi dravyaṁ krētuṁ vā daridrēbhyaḥ kiñcid vitarituṁ kathitavān|</para>
  <para style="p">
    <verse number="30" style="v"/>tadā pūpakhaṇḍagrahaṇāt paraṁ sa tūrṇaṁ bahiragacchat; rātriśca samupasyitā|</para>
  <para style="p">
    <verse number="31" style="v"/>yihūdē bahirgatē yīśurakathayad idānīṁ mānavasutasya mahimā prakāśatē tēnēśvarasyāpi mahimā prakāśatē|</para>
  <para style="p">
    <verse number="32" style="v"/>yadi tēnēśvarasya mahimā prakāśatē tarhīśvarōpi svēna tasya mahimānaṁ prakāśayiṣyati tūrṇamēva prakāśayiṣyati|</para>
  <para style="p">
    <verse number="33" style="v"/>hē vatsā ahaṁ yuṣmābhiḥ sārddhaṁ kiñcitkālamātram āsē, tataḥ paraṁ māṁ mr̥gayiṣyadhvē kintvahaṁ yatsthānaṁ yāmi tatsthānaṁ yūyaṁ gantuṁ na śakṣyatha, yāmimāṁ kathāṁ yihūdīyēbhyaḥ kathitavān tathādhunā yuṣmabhyamapi kathayāmi|</para>
  <para style="p">
    <verse number="34" style="v"/>yūyaṁ parasparaṁ prīyadhvam ahaṁ yuṣmāsu yathā prīyē yūyamapi parasparam tathaiva prīyadhvaṁ, yuṣmān imāṁ navīnām ājñām ādiśāmi|</para>
  <para style="p">
    <verse number="35" style="v"/>tēnaiva yadi parasparaṁ prīyadhvē tarhi lakṣaṇēnānēna yūyaṁ mama śiṣyā iti sarvvē jñātuṁ śakṣyanti|</para>
  <para style="p">
    <verse number="36" style="v"/>śimōnapitaraḥ pr̥ṣṭhavān hē prabhō bhavān kutra yāsyati? tatō yīśuḥ pratyavadat, ahaṁ yatsthānaṁ yāmi tatsthānaṁ sāmprataṁ mama paścād gantuṁ na śaknōṣi kintu paścād gamiṣyasi|</para>
  <para style="p">
    <verse number="37" style="v"/>tadā pitaraḥ pratyuditavān, hē prabhō sāmprataṁ kutō hētōstava paścād gantuṁ na śaknōmi? tvadarthaṁ prāṇān dātuṁ śaknōmi|</para>
  <para style="p">
    <verse number="38" style="v"/>tatō yīśuḥ pratyuktavān mannimittaṁ kiṁ prāṇān dātuṁ śaknōṣi? tvāmahaṁ yathārthaṁ vadāmi, kukkuṭaravaṇāt pūrvvaṁ tvaṁ tri rmām apahnōṣyasē|</para>
  <chapter number="14" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>manōduḥkhinō mā bhūta; īśvarē viśvasita mayi ca viśvasita|</para>
  <para style="p">
    <verse number="2" style="v"/>mama pitu gr̥hē bahūni vāsasthāni santi nō cēt pūrvvaṁ yuṣmān ajñāpayiṣyaṁ yuṣmadarthaṁ sthānaṁ sajjayituṁ gacchāmi|</para>
  <para style="p">
    <verse number="3" style="v"/>yadi gatvāhaṁ yuṣmannimittaṁ sthānaṁ sajjayāmi tarhi panarāgatya yuṣmān svasamīpaṁ nēṣyāmi, tatō yatrāhaṁ tiṣṭhāmi tatra yūyamapi sthāsyatha|</para>
  <para style="p">
    <verse number="4" style="v"/>ahaṁ yatsthānaṁ brajāmi tatsthānaṁ yūyaṁ jānītha tasya panthānamapi jānītha|</para>
  <para style="p">
    <verse number="5" style="v"/>tadā thōmā avadat, hē prabhō bhavān kutra yāti tadvayaṁ na jānīmaḥ, tarhi kathaṁ panthānaṁ jñātuṁ śaknumaḥ?</para>
  <para style="p">
    <verse number="6" style="v"/>yīśurakathayad ahamēva satyajīvanarūpapathō mayā na gantā kōpi pituḥ samīpaṁ gantuṁ na śaknōti|</para>
  <para style="p">
    <verse number="7" style="v"/>yadi mām ajñāsyata tarhi mama pitaramapyajñāsyata kintvadhunātastaṁ jānītha paśyatha ca|</para>
  <para style="p">
    <verse number="8" style="v"/>tadā philipaḥ kathitavān, hē prabhō pitaraṁ darśaya tasmādasmākaṁ yathēṣṭaṁ bhaviṣyati|</para>
  <para style="p">
    <verse number="9" style="v"/>tatō yīśuḥ pratyāvādīt, hē philipa yuṣmābhiḥ sārddham ētāvaddināni sthitamapi māṁ kiṁ na pratyabhijānāsi? yō janō mām apaśyat sa pitaramapyapaśyat tarhi pitaram asmān darśayēti kathāṁ kathaṁ kathayasi?</para>
  <para style="p">
    <verse number="10" style="v"/>ahaṁ pitari tiṣṭhāmi pitā mayi tiṣṭhatīti kiṁ tvaṁ na pratyaṣi? ahaṁ yadvākyaṁ vadāmi tat svatō na vadāmi kintu yaḥ pitā mayi virājatē sa ēva sarvvakarmmāṇi karāti|</para>
  <para style="p">
    <verse number="11" style="v"/>ataēva pitaryyahaṁ tiṣṭhāmi pitā ca mayi tiṣṭhati mamāsyāṁ kathāyāṁ pratyayaṁ kuruta, nō cēt karmmahētōḥ pratyayaṁ kuruta|</para>
  <para style="p">
    <verse number="12" style="v"/>ahaṁ yuṣmānatiyathārthaṁ vadāmi, yō janō mayi viśvasiti sōhamiva karmmāṇi kariṣyati varaṁ tatōpi mahākarmmāṇi kariṣyati yatō hētōrahaṁ pituḥ samīpaṁ gacchāmi|</para>
  <para style="p">
    <verse number="13" style="v"/>yathā putrēṇa pitu rmahimā prakāśatē tadarthaṁ mama nāma prōcya yat prārthayiṣyadhvē tat saphalaṁ kariṣyāmi|</para>
  <para style="p">
    <verse number="14" style="v"/>yadi mama nāmnā yat kiñcid yācadhvē tarhi tadahaṁ sādhayiṣyāmi|</para>
  <para style="p">
    <verse number="15" style="v"/>yadi mayi prīyadhvē tarhi mamājñāḥ samācarata|</para>
  <para style="p">
    <verse number="16" style="v"/>tatō mayā pituḥ samīpē prārthitē pitā nirantaraṁ yuṣmābhiḥ sārddhaṁ sthātum itaramēkaṁ sahāyam arthāt satyamayam ātmānaṁ yuṣmākaṁ nikaṭaṁ prēṣayiṣyati|</para>
  <para style="p">
    <verse number="17" style="v"/>ētajjagatō lōkāstaṁ grahītuṁ na śaknuvanti yatastē taṁ nāpaśyan nājanaṁśca kintu yūyaṁ jānītha yatō hētōḥ sa yuṣmākamanta rnivasati yuṣmākaṁ madhyē sthāsyati ca|</para>
  <para style="p">
    <verse number="18" style="v"/>ahaṁ yuṣmān anāthān kr̥tvā na yāsyāmi punarapi yuṣmākaṁ samīpam āgamiṣyāmi|</para>
  <para style="p">
    <verse number="19" style="v"/>kiyatkālarat param asya jagatō lōkā māṁ puna rna drakṣyanti kintu yūyaṁ drakṣyatha;ahaṁ jīviṣyāmi tasmāt kāraṇād yūyamapi jīviṣyatha|</para>
  <para style="p">
    <verse number="20" style="v"/>pitaryyahamasmi mayi ca yūyaṁ stha, tathāhaṁ yuṣmāsvasmi tadapi tadā jñāsyatha|</para>
  <para style="p">
    <verse number="21" style="v"/>yō janō mamājñā gr̥hītvā tā ācarati saēva mayi prīyatē; yō janaśca mayi prīyatē saēva mama pituḥ priyapātraṁ bhaviṣyati, tathāhamapi tasmin prītvā tasmai svaṁ prakāśayiṣyāmi|</para>
  <para style="p">
    <verse number="22" style="v"/>tadā īṣkariyōtīyād anyō yihūdāstamavadat, hē prabhō bhavān jagatō lōkānāṁ sannidhau prakāśitō na bhūtvāsmākaṁ sannidhau kutaḥ prakāśitō bhaviṣyati?</para>
  <para style="p">
    <verse number="23" style="v"/>tatō yīśuḥ pratyuditavān, yō janō mayi prīyatē sa mamājñā api gr̥hlāti, tēna mama pitāpi tasmin prēṣyatē, āvāñca tannikaṭamāgatya tēna saha nivatsyāvaḥ|</para>
  <para style="p">
    <verse number="24" style="v"/>yō janō mayi na prīyatē sa mama kathā api na gr̥hlāti punaśca yāmimāṁ kathāṁ yūyaṁ śr̥ṇutha sā kathā kēvalasya mama na kintu mama prērakō yaḥ pitā tasyāpi kathā|</para>
  <para style="p">
    <verse number="25" style="v"/>idānīṁ yuṣmākaṁ nikaṭē vidyamānōham ētāḥ sakalāḥ kathāḥ kathayāmi|</para>
  <para style="p">
    <verse number="26" style="v"/>kintvitaḥ paraṁ pitrā yaḥ sahāyō'rthāt pavitra ātmā mama nāmni prērayiṣyati sa sarvvaṁ śikṣayitvā mayōktāḥ samastāḥ kathā yuṣmān smārayiṣyati|</para>
  <para style="p">
    <verse number="27" style="v"/>ahaṁ yuṣmākaṁ nikaṭē śāntiṁ sthāpayitvā yāmi, nijāṁ śāntiṁ yuṣmabhyaṁ dadāmi, jagatō lōkā yathā dadāti tathāhaṁ na dadāmi; yuṣmākam antaḥkaraṇāni duḥkhitāni bhītāni ca na bhavantu|</para>
  <para style="p">
    <verse number="28" style="v"/>ahaṁ gatvā punarapi yuṣmākaṁ samīpam āgamiṣyāmi mayōktaṁ vākyamidaṁ yūyam aśrauṣṭa; yadi mayyaprēṣyadhvaṁ tarhyahaṁ pituḥ samīpaṁ gacchāmi mamāsyāṁ kathāyāṁ yūyam ahlādiṣyadhvaṁ yatō mama pitā mattōpi mahān|</para>
  <para style="p">
    <verse number="29" style="v"/>tasyā ghaṭanāyāḥ samayē yathā yuṣmākaṁ śraddhā jāyatē tadartham ahaṁ tasyā ghaṭanāyāḥ pūrvvam idānīṁ yuṣmān ētāṁ vārttāṁ vadāmi|</para>
  <para style="p">
    <verse number="30" style="v"/>itaḥ paraṁ yuṣmābhiḥ saha mama bahava ālāpā na bhaviṣyanti yataḥ kāraṇād ētasya jagataḥ patirāgacchati kintu mayā saha tasya kōpi sambandhō nāsti|</para>
  <para style="p">
    <verse number="31" style="v"/>ahaṁ pitari prēma karōmi tathā pitu rvidhivat karmmāṇi karōmīti yēna jagatō lōkā jānanti tadartham uttiṣṭhata vayaṁ sthānādasmād gacchāma|</para>
  <chapter number="15" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ahaṁ satyadrākṣālatāsvarūpō mama pitā tūdyānaparicārakasvarūpañca|</para>
  <para style="p">
    <verse number="2" style="v"/>mama yāsu śākhāsu phalāni na bhavanti tāḥ sa chinatti tathā phalavatyaḥ śākhā yathādhikaphalāni phalanti tadarthaṁ tāḥ pariṣkarōti|</para>
  <para style="p">
    <verse number="3" style="v"/>idānīṁ mayōktōpadēśēna yūyaṁ pariṣkr̥tāḥ|</para>
  <para style="p">
    <verse number="4" style="v"/>ataḥ kāraṇāt mayi tiṣṭhata tēnāhamapi yuṣmāsu tiṣṭhāmi, yatō hētō rdrākṣālatāyām asaṁlagnā śākhā yathā phalavatī bhavituṁ na śaknōti tathā yūyamapi mayyatiṣṭhantaḥ phalavantō bhavituṁ na śaknutha|</para>
  <para style="p">
    <verse number="5" style="v"/>ahaṁ drākṣālatāsvarūpō yūyañca śākhāsvarūpōḥ; yō janō mayi tiṣṭhati yatra cāhaṁ tiṣṭhāmi, sa pracūraphalaiḥ phalavān bhavati, kintu māṁ vinā yūyaṁ kimapi karttuṁ na śaknutha|</para>
  <para style="p">
    <verse number="6" style="v"/>yaḥ kaścin mayi na tiṣṭhati sa śuṣkaśākhēva bahi rnikṣipyatē lōkāśca tā āhr̥tya vahnau nikṣipya dāhayanti|</para>
  <para style="p">
    <verse number="7" style="v"/>yadi yūyaṁ mayi tiṣṭhatha mama kathā ca yuṣmāsu tiṣṭhati tarhi yad vāñchitvā yāciṣyadhvē yuṣmākaṁ tadēva saphalaṁ bhaviṣyati|</para>
  <para style="p">
    <verse number="8" style="v"/>yadi yūyaṁ pracūraphalavantō bhavatha tarhi tadvārā mama pitu rmahimā prakāśiṣyatē tathā yūyaṁ mama śiṣyā iti parikṣāyiṣyadhvē|</para>
  <para style="p">
    <verse number="9" style="v"/>pitā yathā mayi prītavān ahamapi yuṣmāsu tathā prītavān atō hētō ryūyaṁ nirantaraṁ mama prēmapātrāṇi bhūtvā tiṣṭhata|</para>
  <para style="p">
    <verse number="10" style="v"/>ahaṁ yathā piturājñā gr̥hītvā tasya prēmabhājanaṁ tiṣṭhāmi tathaiva yūyamapi yadi mamājñā guhlītha tarhi mama prēmabhājanāni sthāsyatha|</para>
  <para style="p">
    <verse number="11" style="v"/>yuṣmannimittaṁ mama ya āhlādaḥ sa yathā ciraṁ tiṣṭhati yuṣmākam ānandaśca yathā pūryyatē tadarthaṁ yuṣmabhyam ētāḥ kathā atrakatham|</para>
  <para style="p">
    <verse number="12" style="v"/>ahaṁ yuṣmāsu yathā prīyē yūyamapi parasparaṁ tathā prīyadhvam ēṣā mamājñā|</para>
  <para style="p">
    <verse number="13" style="v"/>mitrāṇāṁ kāraṇāt svaprāṇadānaparyyantaṁ yat prēma tasmān mahāprēma kasyāpi nāsti|</para>
  <para style="p">
    <verse number="14" style="v"/>ahaṁ yadyad ādiśāmi tattadēva yadi yūyam ācarata tarhi yūyamēva mama mitrāṇi|</para>
  <para style="p">
    <verse number="15" style="v"/>adyārabhya yuṣmān dāsān na vadiṣyāmi yat prabhu ryat karōti dāsastad na jānāti; kintu pituḥ samīpē yadyad aśr̥ṇavaṁ tat sarvvaṁ yūṣmān ajñāpayam tatkāraṇād yuṣmān mitrāṇi prōktavān|</para>
  <para style="p">
    <verse number="16" style="v"/>yūyaṁ māṁ rōcitavanta iti na, kintvahamēva yuṣmān rōcitavān yūyaṁ gatvā yathā phalānyutpādayatha tāni phalāni cākṣayāṇi bhavanti, tadarthaṁ yuṣmān nyajunajaṁ tasmān mama nāma prōcya pitaraṁ yat kiñcid yāciṣyadhvē tadēva sa yuṣmabhyaṁ dāsyati|</para>
  <para style="p">
    <verse number="17" style="v"/>yūyaṁ parasparaṁ prīyadhvam aham ityājñāpayāmi|</para>
  <para style="p">
    <verse number="18" style="v"/>jagatō lōkai ryuṣmāsu r̥tīyitēṣu tē pūrvvaṁ māmēvārttīyanta iti yūyaṁ jānītha|</para>
  <para style="p">
    <verse number="19" style="v"/>yadi yūyaṁ jagatō lōkā abhaviṣyata tarhi jagatō lōkā yuṣmān ātmīyān buddhvāprēṣyanta; kintu yūyaṁ jagatō lōkā na bhavatha, ahaṁ yuṣmān asmājjagatō'rōcayam ētasmāt kāraṇājjagatō lōkā yuṣmān r̥tīyantē|</para>
  <para style="p">
    <verse number="20" style="v"/>dāsaḥ prabhō rmahān na bhavati mamaitat pūrvvīyaṁ vākyaṁ smarata; tē yadi māmēvātāḍayan tarhi yuṣmānapi tāḍayiṣyanti, yadi mama vākyaṁ gr̥hlanti tarhi yuṣmākamapi vākyaṁ grahīṣyanti|</para>
  <para style="p">
    <verse number="21" style="v"/>kintu tē mama nāmakāraṇād yuṣmān prati tādr̥śaṁ vyavahariṣyanti yatō yō māṁ prēritavān taṁ tē na jānanti|</para>
  <para style="p">
    <verse number="22" style="v"/>tēṣāṁ sannidhim āgatya yadyahaṁ nākathayiṣyaṁ tarhi tēṣāṁ pāpaṁ nābhaviṣyat kintvadhunā tēṣāṁ pāpamācchādayitum upāyō nāsti|</para>
  <para style="p">
    <verse number="23" style="v"/>yō janō mām r̥tīyatē sa mama pitaramapi r̥tīyatē|</para>
  <para style="p">
    <verse number="24" style="v"/>yādr̥śāni karmmāṇi kēnāpi kadāpi nākriyanta tādr̥śāni karmmāṇi yadi tēṣāṁ sākṣād ahaṁ nākariṣyaṁ tarhi tēṣāṁ pāpaṁ nābhaviṣyat kintvadhunā tē dr̥ṣṭvāpi māṁ mama pitarañcārttīyanta|</para>
  <para style="p">
    <verse number="25" style="v"/>tasmāt tē'kāraṇaṁ mām r̥tīyantē yadētad vacanaṁ tēṣāṁ śāstrē likhitamāstē tat saphalam abhavat|</para>
  <para style="p">
    <verse number="26" style="v"/>kintu pitu rnirgataṁ yaṁ sahāyamarthāt satyamayam ātmānaṁ pituḥ samīpād yuṣmākaṁ samīpē prēṣayiṣyāmi sa āgatya mayi pramāṇaṁ dāsyati|</para>
  <para style="p">
    <verse number="27" style="v"/>yūyaṁ prathamamārabhya mayā sārddhaṁ tiṣṭhatha tasmāddhētō ryūyamapi pramāṇaṁ dāsyatha|</para>
  <chapter number="16" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yuṣmākaṁ yathā vādhā na jāyatē tadarthaṁ yuṣmān ētāni sarvvavākyāni vyāharaṁ|</para>
  <para style="p">
    <verse number="2" style="v"/>lōkā yuṣmān bhajanagr̥hēbhyō dūrīkariṣyanti tathā yasmin samayē yuṣmān hatvā īśvarasya tuṣṭi janakaṁ karmmākurmma iti maṁsyantē sa samaya āgacchanti|</para>
  <para style="p">
    <verse number="3" style="v"/>tē pitaraṁ māñca na jānanti, tasmād yuṣmān pratīdr̥śam ācariṣyanti|</para>
  <para style="p">
    <verse number="4" style="v"/>atō hētāḥ samayē samupasthitē yathā mama kathā yuṣmākaṁ manaḥsuḥ samupatiṣṭhati tadarthaṁ yuṣmābhyam ētāṁ kathāṁ kathayāmi yuṣmābhiḥ sārddham ahaṁ tiṣṭhan prathamaṁ tāṁ yuṣmabhyaṁ nākathayaṁ|</para>
  <para style="p">
    <verse number="5" style="v"/>sāmprataṁ svasya prērayituḥ samīpaṁ gacchāmi tathāpi tvaṁ kka gacchasi kathāmētāṁ yuṣmākaṁ kōpi māṁ na pr̥cchati|</para>
  <para style="p">
    <verse number="6" style="v"/>kintu mayōktābhirābhiḥ kathābhi ryūṣmākam antaḥkaraṇāni duḥkhēna pūrṇānyabhavan|</para>
  <para style="p">
    <verse number="7" style="v"/>tathāpyahaṁ yathārthaṁ kathayāmi mama gamanaṁ yuṣmākaṁ hitārthamēva, yatō hētō rgamanē na kr̥tē sahāyō yuṣmākaṁ samīpaṁ nāgamiṣyati kintu yadi gacchāmi tarhi yuṣmākaṁ samīpē taṁ prēṣayiṣyāmi|</para>
  <para style="p">
    <verse number="8" style="v"/>tataḥ sa āgatya pāpapuṇyadaṇḍēṣu jagatō lōkānāṁ prabōdhaṁ janayiṣyati|</para>
  <para style="p">
    <verse number="9" style="v"/>tē mayi na viśvasanti tasmāddhētōḥ pāpaprabōdhaṁ janayiṣyati|</para>
  <para style="p">
    <verse number="10" style="v"/>yuṣmākam adr̥śyaḥ sannahaṁ pituḥ samīpaṁ gacchāmi tasmād puṇyē prabōdhaṁ janayiṣyati|</para>
  <para style="p">
    <verse number="11" style="v"/>ētajjagatō'dhipati rdaṇḍājñāṁ prāpnōti tasmād daṇḍē prabōdhaṁ janayiṣyati|</para>
  <para style="p">
    <verse number="12" style="v"/>yuṣmabhyaṁ kathayituṁ mamānēkāḥ kathā āsatē, tāḥ kathā idānīṁ yūyaṁ sōḍhuṁ na śaknutha;</para>
  <para style="p">
    <verse number="13" style="v"/>kintu satyamaya ātmā yadā samāgamiṣyati tadā sarvvaṁ satyaṁ yuṣmān nēṣyati, sa svataḥ kimapi na vadiṣyati kintu yacchrōṣyati tadēva kathayitvā bhāvikāryyaṁ yuṣmān jñāpayiṣyati|</para>
  <para style="p">
    <verse number="14" style="v"/>mama mahimānaṁ prakāśayiṣyati yatō madīyāṁ kathāṁ gr̥hītvā yuṣmān bōdhayiṣyati|</para>
  <para style="p">
    <verse number="15" style="v"/>pitu ryadyad āstē tat sarvvaṁ mama tasmād kāraṇād avādiṣaṁ sa madīyāṁ kathāṁ gr̥hītvā yuṣmān bōdhayiṣyati|</para>
  <para style="p">
    <verse number="16" style="v"/>kiyatkālāt paraṁ yūyaṁ māṁ draṣṭuṁ na lapsyadhvē kintu kiyatkālāt paraṁ puna rdraṣṭuṁ lapsyadhvē yatōhaṁ pituḥ samīpaṁ gacchāmi|</para>
  <para style="p">
    <verse number="17" style="v"/>tataḥ śiṣyāṇāṁ kiyantō janāḥ parasparaṁ vaditum ārabhanta, kiyatkālāt paraṁ māṁ draṣṭuṁ na lapsyadhvē kintu kiyatkālāt paraṁ puna rdraṣṭuṁ lapsyadhvē yatōhaṁ pituḥ samīpaṁ gacchāmi, iti yad vākyam ayaṁ vadati tat kiṁ?</para>
  <para style="p">
    <verse number="18" style="v"/>tataḥ kiyatkālāt param iti tasya vākyaṁ kiṁ? tasya vākyasyābhiprāyaṁ vayaṁ bōddhuṁ na śaknumastairiti</para>
  <para style="p">
    <verse number="19" style="v"/>nigaditē yīśustēṣāṁ praśnēcchāṁ jñātvā tēbhyō'kathayat kiyatkālāt paraṁ māṁ draṣṭuṁ na lapsyadhvē, kintu kiyatkālāt paraṁ pūna rdraṣṭuṁ lapsyadhvē, yāmimāṁ kathāmakathayaṁ tasyā abhiprāyaṁ kiṁ yūyaṁ parasparaṁ mr̥gayadhvē?</para>
  <para style="p">
    <verse number="20" style="v"/>yuṣmānaham atiyathārthaṁ vadāmi yūyaṁ krandiṣyatha vilapiṣyatha ca, kintu jagatō lōkā ānandiṣyanti; yūyaṁ śōkākulā bhaviṣyatha kintu śōkāt paraṁ ānandayuktā bhaviṣyatha|</para>
  <para style="p">
    <verse number="21" style="v"/>prasavakāla upasthitē nārī yathā prasavavēdanayā vyākulā bhavati kintu putrē bhūmiṣṭhē sati manuṣyaikō janmanā naralōkē praviṣṭa ityānandāt tasyāstatsarvvaṁ duḥkhaṁ manasi na tiṣṭhati,</para>
  <para style="p">
    <verse number="22" style="v"/>tathā yūyamapi sāmprataṁ śōkākulā bhavatha kintu punarapi yuṣmabhyaṁ darśanaṁ dāsyāmi tēna yuṣmākam antaḥkaraṇāni sānandāni bhaviṣyanti, yuṣmākaṁ tam ānandañca kōpi harttuṁ na śakṣyati|</para>
  <para style="p">
    <verse number="23" style="v"/>tasmin divasē kāmapi kathāṁ māṁ na prakṣyatha| yuṣmānaham atiyathārthaṁ vadāmi, mama nāmnā yat kiñcid pitaraṁ yāciṣyadhvē tadēva sa dāsyati|</para>
  <para style="p">
    <verse number="24" style="v"/>pūrvvē mama nāmnā kimapi nāyācadhvaṁ, yācadhvaṁ tataḥ prāpsyatha tasmād yuṣmākaṁ sampūrṇānandō janiṣyatē|</para>
  <para style="p">
    <verse number="25" style="v"/>upamākathābhiḥ sarvvāṇyētāni yuṣmān jñāpitavān kintu yasmin samayē upamayā nōktvā pituḥ kathāṁ spaṣṭaṁ jñāpayiṣyāmi samaya ētādr̥śa āgacchati|</para>
  <para style="p">
    <verse number="26" style="v"/>tadā mama nāmnā prārthayiṣyadhvē 'haṁ yuṣmannimittaṁ pitaraṁ vinēṣyē kathāmimāṁ na vadāmi;</para>
  <para style="p">
    <verse number="27" style="v"/>yatō yūyaṁ mayi prēma kurutha, tathāham īśvarasya samīpād āgatavān ityapi pratītha, tasmād kāraṇāt kāraṇāt pitā svayaṁ yuṣmāsu prīyatē|</para>
  <para style="p">
    <verse number="28" style="v"/>pituḥ samīpājjajad āgatōsmi jagat parityajya ca punarapi pituḥ samīpaṁ gacchāmi|</para>
  <para style="p">
    <verse number="29" style="v"/>tadā śiṣyā avadan, hē prabhō bhavān upamayā nōktvādhunā spaṣṭaṁ vadati|</para>
  <para style="p">
    <verse number="30" style="v"/>bhavān sarvvajñaḥ kēnacit pr̥ṣṭō bhavitumapi bhavataḥ prayōjanaṁ nāstītyadhunāsmākaṁ sthirajñānaṁ jātaṁ tasmād bhavān īśvarasya samīpād āgatavān ityatra vayaṁ viśvasimaḥ|</para>
  <para style="p">
    <verse number="31" style="v"/>tatō yīśuḥ pratyavādīd idānīṁ kiṁ yūyaṁ viśvasitha?</para>
  <para style="p">
    <verse number="32" style="v"/>paśyata sarvvē yūyaṁ vikīrṇāḥ santō mām ēkākinaṁ pīratyajya svaṁ svaṁ sthānaṁ gamiṣyatha, ētādr̥śaḥ samaya āgacchati varaṁ prāyēṇōpasthitavān; tathāpyahaṁ naikākī bhavāmi yataḥ pitā mayā sārddham āstē|</para>
  <para style="p">
    <verse number="33" style="v"/>yathā mayā yuṣmākaṁ śānti rjāyatē tadartham ētāḥ kathā yuṣmabhyam acakathaṁ; asmin jagati yuṣmākaṁ klēśō ghaṭiṣyatē kintvakṣōbhā bhavata yatō mayā jagajjitaṁ|</para>
  <chapter number="17" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tataḥ paraṁ yīśurētāḥ kathāḥ kathayitvā svargaṁ vilōkyaitat prārthayat, hē pitaḥ samaya upasthitavān; yathā tava putrastava mahimānaṁ prakāśayati tadarthaṁ tvaṁ nijaputrasya mahimānaṁ prakāśaya|</para>
  <para style="p">
    <verse number="2" style="v"/>tvaṁ yōllōkān tasya hastē samarpitavān sa yathā tēbhyō'nantāyu rdadāti tadarthaṁ tvaṁ prāṇimātrāṇām adhipatitvabhāraṁ tasmai dattavān|</para>
  <para style="p">
    <verse number="3" style="v"/>yastvam advitīyaḥ satya īśvarastvayā prēritaśca yīśuḥ khrīṣṭa ētayōrubhayōḥ paricayē prāptē'nantāyu rbhavati|</para>
  <para style="p">
    <verse number="4" style="v"/>tvaṁ yasya karmmaṇō bhāraṁ mahyaṁ dattavān, tat sampannaṁ kr̥tvā jagatyasmin tava mahimānaṁ prākāśayaṁ|</para>
  <para style="p">
    <verse number="5" style="v"/>ataēva hē pita rjagatyavidyamānē tvayā saha tiṣṭhatō mama yō mahimāsīt samprati tava samīpē māṁ taṁ mahimānaṁ prāpaya|</para>
  <para style="p">
    <verse number="6" style="v"/>anyacca tvam ētajjagatō yāllōkān mahyam adadā ahaṁ tēbhyastava nāmnastattvajñānam adadāṁ, tē tavaivāsan, tvaṁ tān mahyamadadāḥ, tasmāttē tavōpadēśam agr̥hlan|</para>
  <para style="p">
    <verse number="7" style="v"/>tvaṁ mahyaṁ yat kiñcid adadāstatsarvvaṁ tvattō jāyatē ityadhunājānan|</para>
  <para style="p">
    <verse number="8" style="v"/>mahyaṁ yamupadēśam adadā ahamapi tēbhyastamupadēśam adadāṁ tēpi tamagr̥hlan tvattōhaṁ nirgatya tvayā prēritōbhavam atra ca vyaśvasan|</para>
  <para style="p">
    <verse number="9" style="v"/>tēṣāmēva nimittaṁ prārthayē'haṁ jagatō lōkanimittaṁ na prārthayē kintu yāllōkān mahyam adadāstēṣāmēva nimittaṁ prārthayē'haṁ yatastē tavaivāsatē|</para>
  <para style="p">
    <verse number="10" style="v"/>yē mama tē tava yē ca tava tē mama tathā tai rmama mahimā prakāśyatē|</para>
  <para style="p">
    <verse number="11" style="v"/>sāmpratam asmin jagati mamāvasthitēḥ śēṣam abhavat ahaṁ tava samīpaṁ gacchāmi kintu tē jagati sthāsyanti; hē pavitra pitarāvayō ryathaikatvamāstē tathā tēṣāmapyēkatvaṁ bhavati tadarthaṁ yāllōkān mahyam adadāstān svanāmnā rakṣa|</para>
  <para style="p">
    <verse number="12" style="v"/>yāvanti dināni jagatyasmin taiḥ sahāhamāsaṁ tāvanti dināni tān tava nāmnāhaṁ rakṣitavān; yāllōkān mahyam adadāstān sarvvān ahamarakṣaṁ, tēṣāṁ madhyē kēvalaṁ vināśapātraṁ hāritaṁ tēna dharmmapustakasya vacanaṁ pratyakṣaṁ bhavati|</para>
  <para style="p">
    <verse number="13" style="v"/>kintvadhunā tava sannidhiṁ gacchāmi mayā yathā tēṣāṁ sampūrṇānandō bhavati tadarthamahaṁ jagati tiṣṭhan ētāḥ kathā akathayam|</para>
  <para style="p">
    <verse number="14" style="v"/>tavōpadēśaṁ tēbhyō'dadāṁ jagatā saha yathā mama sambandhō nāsti tathā jajatā saha tēṣāmapi sambandhābhāvāj jagatō lōkāstān r̥tīyantē|</para>
  <para style="p">
    <verse number="15" style="v"/>tvaṁ jagatastān gr̥hāṇēti na prārthayē kintvaśubhād rakṣēti prārthayēham|</para>
  <para style="p">
    <verse number="16" style="v"/>ahaṁ yathā jagatsambandhīyō na bhavāmi tathā tēpi jagatsambandhīyā na bhavanti|</para>
  <para style="p">
    <verse number="17" style="v"/>tava satyakathayā tān pavitrīkuru tava vākyamēva satyaṁ|</para>
  <para style="p">
    <verse number="18" style="v"/>tvaṁ yathā māṁ jagati prairayastathāhamapi tān jagati prairayaṁ|</para>
  <para style="p">
    <verse number="19" style="v"/>tēṣāṁ hitārthaṁ yathāhaṁ svaṁ pavitrīkarōmi tathā satyakathayā tēpi pavitrībhavantu|</para>
  <para style="p">
    <verse number="20" style="v"/>kēvalaṁ ētēṣāmarthē prārthayē'ham iti na kintvētēṣāmupadēśēna yē janā mayi viśvasiṣyanti tēṣāmapyarthē prārthēyē'ham|</para>
  <para style="p">
    <verse number="21" style="v"/>hē pitastēṣāṁ sarvvēṣām ēkatvaṁ bhavatu tava yathā mayi mama ca yathā tvayyēkatvaṁ tathā tēṣāmapyāvayōrēkatvaṁ bhavatu tēna tvaṁ māṁ prēritavān iti jagatō lōkāḥ pratiyantu|</para>
  <para style="p">
    <verse number="22" style="v"/>yathāvayōrēkatvaṁ tathā tēṣāmapyēkatvaṁ bhavatu tēṣvahaṁ mayi ca tvam itthaṁ tēṣāṁ sampūrṇamēkatvaṁ bhavatu, tvaṁ prēritavān tvaṁ mayi yathā prīyasē ca tathā tēṣvapi prītavān ētadyathā jagatō lōkā jānanti</para>
  <para style="p">
    <verse number="23" style="v"/>tadarthaṁ tvaṁ yaṁ mahimānaṁ mahyam adadāstaṁ mahimānam ahamapi tēbhyō dattavān|</para>
  <para style="p">
    <verse number="24" style="v"/>hē pita rjagatō nirmmāṇāt pūrvvaṁ mayi snēhaṁ kr̥tvā yaṁ mahimānaṁ dattavān mama taṁ mahimānaṁ yathā tē paśyanti tadarthaṁ yāllōkān mahyaṁ dattavān ahaṁ yatra tiṣṭhāmi tēpi yathā tatra tiṣṭhanti mamaiṣā vāñchā|</para>
  <para style="p">
    <verse number="25" style="v"/>hē yathārthika pita rjagatō lōkaistvayyajñātēpi tvāmahaṁ jānē tvaṁ māṁ prēritavān itīmē śiṣyā jānanti|</para>
  <para style="p">
    <verse number="26" style="v"/>yathāhaṁ tēṣu tiṣṭhāmi tathā mayi yēna prēmnā prēmākarōstat tēṣu tiṣṭhati tadarthaṁ tava nāmāhaṁ tān jñāpitavān punarapi jñāpayiṣyāmi|</para>
  <chapter number="18" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tāḥ kathāḥ kathayitvā yīśuḥ śiṣyānādāya kidrōnnāmakaṁ srōta uttīryya śiṣyaiḥ saha tatratyōdyānaṁ prāviśat|</para>
  <para style="p">
    <verse number="2" style="v"/>kintu viśvāsaghātiyihūdāstat sthānaṁ paricīyatē yatō yīśuḥ śiṣyaiḥ sārddhaṁ kadācit tat sthānam agacchat|</para>
  <para style="p">
    <verse number="3" style="v"/>tadā sa yihūdāḥ sainyagaṇaṁ pradhānayājakānāṁ phirūśināñca padātigaṇañca gr̥hītvā pradīpān ulkān astrāṇi cādāya tasmin sthāna upasthitavān|</para>
  <para style="p">
    <verse number="4" style="v"/>svaṁ prati yad ghaṭiṣyatē taj jñātvā yīśuragrēsaraḥ san tānapr̥cchat kaṁ gavēṣayatha?</para>
  <para style="p">
    <verse number="5" style="v"/>tē pratyavadan, nāsaratīyaṁ yīśuṁ; tatō yīśuravādīd ahamēva saḥ; taiḥ saha viśvāsaghātī yihūdāścātiṣṭhat|</para>
  <para style="p">
    <verse number="6" style="v"/>tadāhamēva sa tasyaitāṁ kathāṁ śrutvaiva tē paścādētya bhūmau patitāḥ|</para>
  <para style="p">
    <verse number="7" style="v"/>tatō yīśuḥ punarapi pr̥ṣṭhavān kaṁ gavēṣayatha? tatastē pratyavadan nāsaratīyaṁ yīśuṁ|</para>
  <para style="p">
    <verse number="8" style="v"/>tadā yīśuḥ pratyuditavān ahamēva sa imāṁ kathāmacakatham; yadi māmanvicchatha tarhīmān gantuṁ mā vārayata|</para>
  <para style="p">
    <verse number="9" style="v"/>itthaṁ bhūtē mahyaṁ yāllōkān adadāstēṣām ēkamapi nāhārayam imāṁ yāṁ kathāṁ sa svayamakathayat sā kathā saphalā jātā|</para>
  <para style="p">
    <verse number="10" style="v"/>tadā śimōnpitarasya nikaṭē khaṅgalsthitēḥ sa taṁ niṣkōṣaṁ kr̥tvā mahāyājakasya mālkhanāmānaṁ dāsam āhatya tasya dakṣiṇakarṇaṁ chinnavān|</para>
  <para style="p">
    <verse number="11" style="v"/>tatō yīśuḥ pitaram avadat, khaṅgaṁ kōṣē sthāpaya mama pitā mahyaṁ pātuṁ yaṁ kaṁsam adadāt tēnāhaṁ kiṁ na pāsyāmi?</para>
  <para style="p">
    <verse number="12" style="v"/>tadā sainyagaṇaḥ sēnāpati ryihūdīyānāṁ padātayaśca yīśuṁ ghr̥tvā baddhvā hānannāmnaḥ kiyaphāḥ śvaśurasya samīpaṁ prathamam anayan|</para>
  <para style="p">
    <verse number="13" style="v"/>sa kiyaphāstasmin vatsarē mahāyājatvapadē niyuktaḥ</para>
  <para style="p">
    <verse number="14" style="v"/>san sādhāraṇalōkānāṁ maṅgalārtham ēkajanasya maraṇamucitam iti yihūdīyaiḥ sārddham amantrayat|</para>
  <para style="p">
    <verse number="15" style="v"/>tadā śimōnpitarō'nyaikaśiṣyaśca yīśōḥ paścād agacchatāṁ tasyānyaśiṣyasya mahāyājakēna paricitatvāt sa yīśunā saha mahāyājakasyāṭṭālikāṁ prāviśat|</para>
  <para style="p">
    <verse number="16" style="v"/>kintu pitarō bahirdvārasya samīpē'tiṣṭhad ataēva mahāyājakēna paricitaḥ sa śiṣyaḥ punarbahirgatvā dauvāyikāyai kathayitvā pitaram abhyantaram ānayat|</para>
  <para style="p">
    <verse number="17" style="v"/>tadā sa dvārarakṣikā pitaram avadat tvaṁ kiṁ na tasya mānavasya śiṣyaḥ? tataḥ sōvadad ahaṁ na bhavāmi|</para>
  <para style="p">
    <verse number="18" style="v"/>tataḥ paraṁ yatsthānē dāsāḥ padātayaśca śītahētōraṅgārai rvahniṁ prajvālya tāpaṁ sēvitavantastatsthānē pitarastiṣṭhan taiḥ saha vahnitāpaṁ sēvitum ārabhata|</para>
  <para style="p">
    <verse number="19" style="v"/>tadā śiṣyēṣūpadēśē ca mahāyājakēna yīśuḥ pr̥ṣṭaḥ</para>
  <para style="p">
    <verse number="20" style="v"/>san pratyuktavān sarvvalōkānāṁ samakṣaṁ kathāmakathayaṁ guptaṁ kāmapi kathāṁ na kathayitvā yat sthānaṁ yihūdīyāḥ satataṁ gacchanti tatra bhajanagēhē mandirē cāśikṣayaṁ|</para>
  <para style="p">
    <verse number="21" style="v"/>mattaḥ kutaḥ pr̥cchasi? yē janā madupadēśam aśr̥ṇvan tānēva pr̥ccha yadyad avadaṁ tē tat jāninta|</para>
  <para style="p">
    <verse number="22" style="v"/>tadētthaṁ pratyuditatvāt nikaṭasthapadāti ryīśuṁ capēṭēnāhatya vyāharat mahāyājakam ēvaṁ prativadasi?</para>
  <para style="p">
    <verse number="23" style="v"/>tatō yīśuḥ pratigaditavān yadyayathārtham acakathaṁ tarhi tasyāyathārthasya pramāṇaṁ dēhi, kintu yadi yathārthaṁ tarhi kutō hētō rmām atāḍayaḥ?</para>
  <para style="p">
    <verse number="24" style="v"/>pūrvvaṁ hānan sabandhanaṁ taṁ kiyaphāmahāyājakasya samīpaṁ praiṣayat|</para>
  <para style="p">
    <verse number="25" style="v"/>śimōnpitarastiṣṭhan vahnitāpaṁ sēvatē, ētasmin samayē kiyantastam apr̥cchan tvaṁ kim ētasya janasya śiṣyō na? tataḥ sōpahnutyābravīd ahaṁ na bhavāmi|</para>
  <para style="p">
    <verse number="26" style="v"/>tadā mahāyājakasya yasya dāsasya pitaraḥ karṇamacchinat tasya kuṭumbaḥ pratyuditavān udyānē tēna saha tiṣṭhantaṁ tvāṁ kiṁ nāpaśyaṁ?</para>
  <para style="p">
    <verse number="27" style="v"/>kintu pitaraḥ punarapahnutya kathitavān; tadānīṁ kukkuṭō'raut|</para>
  <para style="p">
    <verse number="28" style="v"/>tadanantaraṁ pratyūṣē tē kiyaphāgr̥hād adhipatē rgr̥haṁ yīśum anayan kintu yasmin aśucitvē jātē tai rnistārōtsavē na bhōktavyaṁ, tasya bhayād yihūdīyāstadgr̥haṁ nāviśan|</para>
  <para style="p">
    <verse number="29" style="v"/>aparaṁ pīlātō bahirāgatya tān pr̥ṣṭhavān ētasya manuṣyasya kaṁ dōṣaṁ vadatha?</para>
  <para style="p">
    <verse number="30" style="v"/>tadā tē pētyavadan duṣkarmmakāriṇi na sati bhavataḥ samīpē nainaṁ samārpayiṣyāmaḥ|</para>
  <para style="p">
    <verse number="31" style="v"/>tataḥ pīlātō'vadad yūyamēnaṁ gr̥hītvā svēṣāṁ vyavasthayā vicārayata| tadā yihūdīyāḥ pratyavadan kasyāpi manuṣyasya prāṇadaṇḍaṁ karttuṁ nāsmākam adhikārō'sti|</para>
  <para style="p">
    <verse number="32" style="v"/>ēvaṁ sati yīśuḥ svasya mr̥tyau yāṁ kathāṁ kathitavān sā saphalābhavat|</para>
  <para style="p">
    <verse number="33" style="v"/>tadanantaraṁ pīlātaḥ punarapi tad rājagr̥haṁ gatvā yīśumāhūya pr̥ṣṭavān tvaṁ kiṁ yihūdīyānāṁ rājā?</para>
  <para style="p">
    <verse number="34" style="v"/>yīśuḥ pratyavadat tvam ētāṁ kathāṁ svataḥ kathayasi kimanyaḥ kaścin mayi kathitavān?</para>
  <para style="p">
    <verse number="35" style="v"/>pīlātō'vadad ahaṁ kiṁ yihūdīyaḥ? tava svadēśīyā viśēṣataḥ pradhānayājakā mama nikaṭē tvāṁ samārpayana, tvaṁ kiṁ kr̥tavān?</para>
  <para style="p">
    <verse number="36" style="v"/>yīśuḥ pratyavadat mama rājyam ētajjagatsambandhīyaṁ na bhavati yadi mama rājyaṁ jagatsambandhīyam abhaviṣyat tarhi yihūdīyānāṁ hastēṣu yathā samarpitō nābhavaṁ tadarthaṁ mama sēvakā ayōtsyan kintu mama rājyam aihikaṁ na|</para>
  <para style="p">
    <verse number="37" style="v"/>tadā pīlātaḥ kathitavān, tarhi tvaṁ rājā bhavasi? yīśuḥ pratyuktavān tvaṁ satyaṁ kathayasi, rājāhaṁ bhavāmi; satyatāyāṁ sākṣyaṁ dātuṁ janiṁ gr̥hītvā jagatyasmin avatīrṇavān, tasmāt satyadharmmapakṣapātinō mama kathāṁ śr̥ṇvanti|</para>
  <para style="p">
    <verse number="38" style="v"/>tadā satyaṁ kiṁ? ētāṁ kathāṁ paṣṭvā pīlātaḥ punarapi bahirgatvā yihūdīyān abhāṣata, ahaṁ tasya kamapyaparādhaṁ na prāpnōmi|</para>
  <para style="p">
    <verse number="39" style="v"/>nistārōtsavasamayē yuṣmābhirabhirucita ēkō janō mayā mōcayitavya ēṣā yuṣmākaṁ rītirasti, ataēva yuṣmākaṁ nikaṭē yihūdīyānāṁ rājānaṁ kiṁ mōcayāmi, yuṣmākam icchā kā?</para>
  <para style="p">
    <verse number="40" style="v"/>tadā tē sarvvē ruvantō vyāharan ēnaṁ mānuṣaṁ nahi barabbāṁ mōcaya| kintu sa barabbā dasyurāsīt|</para>
  <chapter number="19" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>pīlātō yīśum ānīya kaśayā prāhārayat|</para>
  <para style="p">
    <verse number="2" style="v"/>paścāt sēnāgaṇaḥ kaṇṭakanirmmitaṁ mukuṭaṁ tasya mastakē samarpya vārttākīvarṇaṁ rājaparicchadaṁ paridhāpya,</para>
  <para style="p">
    <verse number="3" style="v"/>hē yihūdīyānāṁ rājan namaskāra ityuktvā taṁ capēṭēnāhantum ārabhata|</para>
  <para style="p">
    <verse number="4" style="v"/>tadā pīlātaḥ punarapi bahirgatvā lōkān avadat, asya kamapyaparādhaṁ na labhē'haṁ, paśyata tad yuṣmān jñāpayituṁ yuṣmākaṁ sannidhau bahirēnam ānayāmi|</para>
  <para style="p">
    <verse number="5" style="v"/>tataḥ paraṁ yīśuḥ kaṇṭakamukuṭavān vārttākīvarṇavasanavāṁśca bahirāgacchat| tataḥ pīlāta uktavān ēnaṁ manuṣyaṁ paśyata|</para>
  <para style="p">
    <verse number="6" style="v"/>tadā pradhānayājakāḥ padātayaśca taṁ dr̥ṣṭvā, ēnaṁ kruśē vidha, ēnaṁ kruśē vidha, ityuktvā ravituṁ ārabhanta| tataḥ pīlātaḥ kathitavān yūyaṁ svayam ēnaṁ nītvā kruśē vidhata, aham ētasya kamapyaparādhaṁ na prāptavān|</para>
  <para style="p">
    <verse number="7" style="v"/>yihūdīyāḥ pratyavadan asmākaṁ yā vyavasthāstē tadanusārēṇāsya prāṇahananam ucitaṁ yatōyaṁ svam īśvarasya putramavadat|</para>
  <para style="p">
    <verse number="8" style="v"/>pīlāta imāṁ kathāṁ śrutvā mahātrāsayuktaḥ</para>
  <para style="p">
    <verse number="9" style="v"/>san punarapi rājagr̥ha āgatya yīśuṁ pr̥ṣṭavān tvaṁ kutratyō lōkaḥ? kintu yīśastasya kimapi pratyuttaraṁ nāvadat|</para>
  <para style="p">
    <verse number="10" style="v"/>1# tataḥ pīlāt kathitavāna tvaṁ kiṁ mayā sārddhaṁ na saṁlapiṣyasi ? tvāṁ kruśē vēdhituṁ vā mōcayituṁ śakti rmamāstē iti kiṁ tvaṁ na jānāsi ? tadā yīśuḥ pratyavadad īśvarēṇādaŸाṁ mamōpari tava kimapyadhipatitvaṁ na vidyatē, tathāpi yō janō māṁ tava hastē samārpayat tasya mahāpātakaṁ jātam|</para>
  <para style="p">
    <verse number="11" style="v"/>tadā yīśuḥ pratyavadad īśvarēṇādattaṁ mamōpari tava kimapyadhipatitvaṁ na vidyatē, tathāpi yō janō māṁ tava hastē samārpayat tasya mahāpātakaṁ jātam|</para>
  <para style="p">
    <verse number="12" style="v"/>tadārabhya pīlātastaṁ mōcayituṁ cēṣṭitavān kintu yihūdīyā ruvantō vyāharan yadīmaṁ mānavaṁ tyajasi tarhi tvaṁ kaisarasya mitraṁ na bhavasi, yō janaḥ svaṁ rājānaṁ vakti saēva kaimarasya viruddhāṁ kathāṁ kathayati|</para>
  <para style="p">
    <verse number="13" style="v"/>ētāṁ kathāṁ śrutvā pīlātō yīśuṁ bahirānīya nistārōtsavasya āsādanadinasya dvitīyapraharāt pūrvvaṁ prastarabandhananāmni sthānē 'rthāt ibrīyabhāṣayā yad gabbithā kathyatē tasmin sthānē vicārāsana upāviśat|</para>
  <para style="p">
    <verse number="14" style="v"/>anantaraṁ pīlātō yihūdīyān avadat, yuṣmākaṁ rājānaṁ paśyata|</para>
  <para style="p">
    <verse number="15" style="v"/>kintu ēnaṁ dūrīkuru, ēnaṁ dūrīkuru, ēnaṁ kruśē vidha, iti kathāṁ kathayitvā tē ravitum ārabhanta; tadā pīlātaḥ kathitavān yuṣmākaṁ rājānaṁ kiṁ kruśē vēdhiṣyāmi? pradhānayājakā uttaram avadan kaisaraṁ vinā kōpi rājāsmākaṁ nāsti|</para>
  <para style="p">
    <verse number="16" style="v"/>tataḥ pīlātō yīśuṁ kruśē vēdhituṁ tēṣāṁ hastēṣu samārpayat, tatastē taṁ dhr̥tvā nītavantaḥ|</para>
  <para style="p">
    <verse number="17" style="v"/>tataḥ paraṁ yīśuḥ kruśaṁ vahan śiraḥkapālam arthād yad ibrīyabhāṣayā gulgaltāṁ vadanti tasmin sthāna upasthitaḥ|</para>
  <para style="p">
    <verse number="18" style="v"/>tatastē madhyasthānē taṁ tasyōbhayapārśvē dvāvaparau kruśē'vidhan|</para>
  <para style="p">
    <verse number="19" style="v"/>aparam ēṣa yihūdīyānāṁ rājā nāsaratīyayīśuḥ, iti vijñāpanaṁ likhitvā pīlātastasya kruśōpari samayōjayat|</para>
  <para style="p">
    <verse number="20" style="v"/>sā lipiḥ ibrīyayūnānīyarōmīyabhāṣābhi rlikhitā; yīśōḥ kruśavēdhanasthānaṁ nagarasya samīpaṁ, tasmād bahavō yihūdīyāstāṁ paṭhitum ārabhanta|</para>
  <para style="p">
    <verse number="21" style="v"/>yihūdīyānāṁ pradhānayājakāḥ pīlātamiti nyavēdayan yihūdīyānāṁ rājēti vākyaṁ na kintu ēṣa svaṁ yihūdīyānāṁ rājānam avadad itthaṁ likhatu|</para>
  <para style="p">
    <verse number="22" style="v"/>tataḥ pīlāta uttaraṁ dattavān yallēkhanīyaṁ tallikhitavān|</para>
  <para style="p">
    <verse number="23" style="v"/>itthaṁ sēnāgaṇō yīśuṁ kruśē vidhitvā tasya paridhēyavastraṁ caturō bhāgān kr̥tvā ēkaikasēnā ēkaikabhāgam agr̥hlat tasyōttarīyavastrañcāgr̥hlat| kintūttarīyavastraṁ sūcisēvanaṁ vinā sarvvam ūtaṁ|</para>
  <para style="p">
    <verse number="24" style="v"/>tasmāttē vyāharan ētat kaḥ prāpsyati? tanna khaṇḍayitvā tatra guṭikāpātaṁ karavāma| vibhajantē'dharīyaṁ mē vasanaṁ tē parasparaṁ| mamōttarīyavastrārthaṁ guṭikāṁ pātayanti ca| iti yadvākyaṁ dharmmapustakē likhitamāstē tat sēnāgaṇēnētthaṁ vyavaharaṇāt siddhamabhavat|</para>
  <para style="p">
    <verse number="25" style="v"/>tadānīṁ yīśō rmātā mātu rbhaginī ca yā kliyapā bhāryyā mariyam magdalīnī mariyam ca ētāstasya kruśasya sannidhau samatiṣṭhan|</para>
  <para style="p">
    <verse number="26" style="v"/>tatō yīśuḥ svamātaraṁ priyatamaśiṣyañca samīpē daṇḍāyamānau vilōkya mātaram avadat, hē yōṣid ēnaṁ tava putraṁ paśya,</para>
  <para style="p">
    <verse number="27" style="v"/>śiṣyantvavadat, ēnāṁ tava mātaraṁ paśya| tataḥ sa śiṣyastadghaṭikāyāṁ tāṁ nijagr̥haṁ nītavān|</para>
  <para style="p">
    <verse number="28" style="v"/>anantaraṁ sarvvaṁ karmmādhunā sampannamabhūt yīśuriti jñātvā dharmmapustakasya vacanaṁ yathā siddhaṁ bhavati tadartham akathayat mama pipāsā jātā|</para>
  <para style="p">
    <verse number="29" style="v"/>tatastasmin sthānē amlarasēna pūrṇapātrasthityā tē spañjamēkaṁ tadamlarasēnārdrīkr̥tya ēsōbnalē tad yōjayitvā tasya mukhasya sannidhāvasthāpayan|</para>
  <para style="p">
    <verse number="30" style="v"/>tadā yīśuramlarasaṁ gr̥hītvā sarvvaṁ siddham iti kathāṁ kathayitvā mastakaṁ namayan prāṇān paryyatyajat|</para>
  <para style="p">
    <verse number="31" style="v"/>tadvinam āsādanadinaṁ tasmāt parē'hani viśrāmavārē dēhā yathā kruśōpari na tiṣṭhanti, yataḥ sa viśrāmavārō mahādinamāsīt, tasmād yihūdīyāḥ pīlātanikaṭaṁ gatvā tēṣāṁ pādabhañjanasya sthānāntaranayanasya cānumatiṁ prārthayanta|</para>
  <para style="p">
    <verse number="32" style="v"/>ataḥ sēnā āgatya yīśunā saha kruśē hatayōḥ prathamadvitīyacōrayōḥ pādān abhañjan;</para>
  <para style="p">
    <verse number="33" style="v"/>kintu yīśōḥ sannidhiṁ gatvā sa mr̥ta iti dr̥ṣṭvā tasya pādau nābhañjan|</para>
  <para style="p">
    <verse number="34" style="v"/>paścād ēkō yōddhā śūlāghātēna tasya kukṣim avidhat tatkṣaṇāt tasmād raktaṁ jalañca niragacchat|</para>
  <para style="p">
    <verse number="35" style="v"/>yō janō'sya sākṣyaṁ dadāti sa svayaṁ dr̥ṣṭavān tasyēdaṁ sākṣyaṁ satyaṁ tasya kathā yuṣmākaṁ viśvāsaṁ janayituṁ yōgyā tat sa jānāti|</para>
  <para style="p">
    <verse number="36" style="v"/>tasyaikam asdhyapi na bhaṁkṣyatē,</para>
  <para style="p">
    <verse number="37" style="v"/>tadvad anyaśāstrēpi likhyatē, yathā, "dr̥ṣṭipātaṁ kariṣyanti tē'vidhan yantu tamprati|"</para>
  <para style="p">
    <verse number="38" style="v"/>arimathīyanagarasya yūṣaphnāmā śiṣya ēka āsīt kintu yihūdīyēbhyō bhayāt prakāśitō na bhavati; sa yīśō rdēhaṁ nētuṁ pīlātasyānumatiṁ prārthayata, tataḥ pīlātēnānumatē sati sa gatvā yīśō rdēham anayat|</para>
  <para style="p">
    <verse number="39" style="v"/>aparaṁ yō nikadīmō rātrau yīśōḥ samīpam agacchat sōpi gandharasēna miśritaṁ prāyēṇa pañcāśatsēṭakamaguruṁ gr̥hītvāgacchat|</para>
  <para style="p">
    <verse number="40" style="v"/>tatastē yihūdīyānāṁ śmaśānē sthāpanarītyanusārēṇa tatsugandhidravyēṇa sahitaṁ tasya dēhaṁ vastrēṇāvēṣṭayan|</para>
  <para style="p">
    <verse number="41" style="v"/>aparañca yatra sthānē taṁ kruśē'vidhan tasya nikaṭasthōdyānē yatra kimapi mr̥tadēhaṁ kadāpi nāsthāpyata tādr̥śam ēkaṁ nūtanaṁ śmaśānam āsīt|</para>
  <para style="p">
    <verse number="42" style="v"/>yihūdīyānām āsādanadināgamanāt tē tasmin samīpasthaśmaśānē yīśum aśāyayan|</para>
  <chapter number="20" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ saptāhasya prathamadinē 'tipratyūṣē 'ndhakārē tiṣṭhati magdalīnī mariyam tasya śmaśānasya nikaṭaṁ gatvā śmaśānasya mukhāt prastaramapasāritam apaśyat|</para>
  <para style="p">
    <verse number="2" style="v"/>paścād dhāvitvā śimōnpitarāya yīśōḥ priyatamaśiṣyāya cēdam akathayat, lōkāḥ śmaśānāt prabhuṁ nītvā kutrāsthāpayan tad vaktuṁ na śaknōmi|</para>
  <para style="p">
    <verse number="3" style="v"/>ataḥ pitaraḥ sōnyaśiṣyaśca barhi rbhutvā śmaśānasthānaṁ gantum ārabhētāṁ|</para>
  <para style="p">
    <verse number="4" style="v"/>ubhayōrdhāvatōḥ sōnyaśiṣyaḥ pitaraṁ paścāt tyaktvā pūrvvaṁ śmaśānasthāna upasthitavān|</para>
  <para style="p">
    <verse number="5" style="v"/>tadā prahvībhūya sthāpitavastrāṇi dr̥ṣṭavān kintu na prāviśat|</para>
  <para style="p">
    <verse number="6" style="v"/>aparaṁ śimōnpitara āgatya śmaśānasthānaṁ praviśya</para>
  <para style="p">
    <verse number="7" style="v"/>sthāpitavastrāṇi mastakasya vastrañca pr̥thak sthānāntarē sthāpitaṁ dr̥ṣṭavān|</para>
  <para style="p">
    <verse number="8" style="v"/>tataḥ śmaśānasthānaṁ pūrvvam āgatō yōnyaśiṣyaḥ sōpi praviśya tādr̥śaṁ dr̥ṣṭā vyaśvasīt|</para>
  <para style="p">
    <verse number="9" style="v"/>yataḥ śmaśānāt sa utthāpayitavya ētasya dharmmapustakavacanasya bhāvaṁ tē tadā vōddhuṁ nāśankuvan|</para>
  <para style="p">
    <verse number="10" style="v"/>anantaraṁ tau dvau śiṣyau svaṁ svaṁ gr̥haṁ parāvr̥tyāgacchatām|</para>
  <para style="p">
    <verse number="11" style="v"/>tataḥ paraṁ mariyam śmaśānadvārasya bahiḥ sthitvā rōditum ārabhata tatō rudatī prahvībhūya śmaśānaṁ vilōkya</para>
  <para style="p">
    <verse number="12" style="v"/>yīśōḥ śayanasthānasya śiraḥsthānē padatalē ca dvayō rdiśō dvau svargīyadūtāvupaviṣṭau samapaśyat|</para>
  <para style="p">
    <verse number="13" style="v"/>tau pr̥ṣṭavantau hē nāri kutō rōdiṣi? sāvadat lōkā mama prabhuṁ nītvā kutrāsthāpayan iti na jānāmi|</para>
  <para style="p">
    <verse number="14" style="v"/>ityuktvā mukhaṁ parāvr̥tya yīśuṁ daṇḍāyamānam apaśyat kintu sa yīśuriti sā jñātuṁ nāśaknōt|</para>
  <para style="p">
    <verse number="15" style="v"/>tadā yīśustām apr̥cchat hē nāri kutō rōdiṣi? kaṁ vā mr̥gayasē? tataḥ sā tam udyānasēvakaṁ jñātvā vyāharat, hē mahēccha tvaṁ yadītaḥ sthānāt taṁ nītavān tarhi kutrāsthāpayastad vada tatsthānāt tam ānayāmi|</para>
  <para style="p">
    <verse number="16" style="v"/>tadā yīśustām avadat hē mariyam| tataḥ sā parāvr̥tya pratyavadat hē rabbūnī arthāt hē gurō|</para>
  <para style="p">
    <verse number="17" style="v"/>tadā yīśuravadat māṁ mā dhara, idānīṁ pituḥ samīpē ūrddhvagamanaṁ na karōmi kintu yō mama yuṣmākañca pitā mama yuṣmākañcēśvarastasya nikaṭa ūrddhvagamanaṁ karttum udyatōsmi, imāṁ kathāṁ tvaṁ gatvā mama bhrātr̥gaṇaṁ jñāpaya|</para>
  <para style="p">
    <verse number="18" style="v"/>tatō magdalīnīmariyam tatkṣaṇād gatvā prabhustasyai darśanaṁ dattvā kathā ētā akathayad iti vārttāṁ śiṣyēbhyō'kathayat|</para>
  <para style="p">
    <verse number="19" style="v"/>tataḥ paraṁ saptāhasya prathamadinasya sandhyāsamayē śiṣyā ēkatra militvā yihūdīyēbhyō bhiyā dvāraruddham akurvvan, ētasmin kālē yīśustēṣāṁ madhyasthānē tiṣṭhan akathayad yuṣmākaṁ kalyāṇaṁ bhūyāt|</para>
  <para style="p">
    <verse number="20" style="v"/>ityuktvā nijahastaṁ kukṣiñca darśitavān, tataḥ śiṣyāḥ prabhuṁ dr̥ṣṭvā hr̥ṣṭā abhavan|</para>
  <para style="p">
    <verse number="21" style="v"/>yīśuḥ punaravadad yuṣmākaṁ kalyāṇaṁ bhūyāt pitā yathā māṁ praiṣayat tathāhamapi yuṣmān prēṣayāmi|</para>
  <para style="p">
    <verse number="22" style="v"/>ityuktvā sa tēṣāmupari dīrghapraśvāsaṁ dattvā kathitavān pavitram ātmānaṁ gr̥hlīta|</para>
  <para style="p">
    <verse number="23" style="v"/>yūyaṁ yēṣāṁ pāpāni mōcayiṣyatha tē mōcayiṣyantē yēṣāñca pāpāti na mōcayiṣyatha tē na mōcayiṣyantē|</para>
  <para style="p">
    <verse number="24" style="v"/>dvādaśamadhyē gaṇitō yamajō thōmānāmā śiṣyō yīśōrāgamanakālai taiḥ sārddhaṁ nāsīt|</para>
  <para style="p">
    <verse number="25" style="v"/>atō vayaṁ prabhūm apaśyāmēti vākyē'nyaśiṣyairuktē sōvadat, tasya hastayō rlauhakīlakānāṁ cihnaṁ na vilōkya taccihnam aṅgulyā na spr̥ṣṭvā tasya kukṣau hastaṁ nārōpya cāhaṁ na viśvasiṣyāmi|</para>
  <para style="p">
    <verse number="26" style="v"/>aparam aṣṭamē'hni gatē sati thōmāsahitaḥ śiṣyagaṇa ēkatra militvā dvāraṁ ruddhvābhyantara āsīt, ētarhi yīśustēṣāṁ madhyasthānē tiṣṭhan akathayat, yuṣmākaṁ kuśalaṁ bhūyāt|</para>
  <para style="p">
    <verse number="27" style="v"/>paścāt thāmai kathitavān tvam aṅgulīm atrārpayitvā mama karau paśya karaṁ prasāryya mama kukṣāvarpaya nāviśvasya|</para>
  <para style="p">
    <verse number="28" style="v"/>tadā thōmā avadat, hē mama prabhō hē madīśvara|</para>
  <para style="p">
    <verse number="29" style="v"/>yīśurakathayat, hē thōmā māṁ nirīkṣya viśvasiṣi yē na dr̥ṣṭvā viśvasanti taēva dhanyāḥ|</para>
  <para style="p">
    <verse number="30" style="v"/>ētadanyāni pustakē'smin alikhitāni bahūnyāścaryyakarmmāṇi yīśuḥ śiṣyāṇāṁ purastād akarōt|</para>
  <para style="p">
    <verse number="31" style="v"/>kintu yīśurīśvarasyābhiṣiktaḥ suta ēvēti yathā yūyaṁ viśvasitha viśvasya ca tasya nāmnā paramāyuḥ prāpnutha tadartham ētāni sarvvāṇyalikhyanta|</para>
  <chapter number="21" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tataḥ paraṁ tibiriyājaladhēstaṭē yīśuḥ punarapi śiṣyēbhyō darśanaṁ dattavān darśanasyākhyānamidam|</para>
  <para style="p">
    <verse number="2" style="v"/>śimōnpitaraḥ yamajathōmā gālīlīyakānnānagaranivāsī nithanēl sivadēḥ putrāvanyau dvau śiṣyau caitēṣvēkatra militēṣu śimōnpitarō'kathayat matsyān dhartuṁ yāmi|</para>
  <para style="p">
    <verse number="3" style="v"/>tatastē vyāharan tarhi vayamapi tvayā sārddhaṁ yāmaḥ tadā tē bahirgatāḥ santaḥ kṣipraṁ nāvam ārōhan kintu tasyāṁ rajanyām ēkamapi na prāpnuvan|</para>
  <para style="p">
    <verse number="4" style="v"/>prabhātē sati yīśustaṭē sthitavān kintu sa yīśuriti śiṣyā jñātuṁ nāśaknuvan|</para>
  <para style="p">
    <verse number="5" style="v"/>tadā yīśurapr̥cchat, hē vatsā sannidhau kiñcit khādyadravyam āstē? tē'vadan kimapi nāsti|</para>
  <para style="p">
    <verse number="6" style="v"/>tadā sō'vadat naukāyā dakṣiṇapārśvē jālaṁ nikṣipata tatō lapsyadhvē, tasmāt tai rnikṣiptē jālē matsyā ētāvantō'patan yēna tē jālamākr̥ṣya nōttōlayituṁ śaktāḥ|</para>
  <para style="p">
    <verse number="7" style="v"/>tasmād yīśōḥ priyatamaśiṣyaḥ pitarāyākathayat ēṣa prabhu rbhavēt, ēṣa prabhuriti vācaṁ śrutvaiva śimōn nagnatāhētō rmatsyadhāriṇa uttarīyavastraṁ paridhāya hradaṁ pratyudalamphayat|</para>
  <para style="p">
    <verse number="8" style="v"/>aparē śiṣyā matsyaiḥ sārddhaṁ jālam ākarṣantaḥ kṣudranaukāṁ vāhayitvā kūlamānayan tē kūlād atidūrē nāsan dviśatahastēbhyō dūra āsan ityanumīyatē|</para>
  <para style="p">
    <verse number="9" style="v"/>tīraṁ prāptaistaistatra prajvalitāgnistadupari matsyāḥ pūpāśca dr̥ṣṭāḥ|</para>
  <para style="p">
    <verse number="10" style="v"/>tatō yīśurakathayad yān matsyān adharata tēṣāṁ katipayān ānayata|</para>
  <para style="p">
    <verse number="11" style="v"/>ataḥ śimōnpitaraḥ parāvr̥tya gatvā br̥hadbhistripañcāśadadhikaśatamatsyaiḥ paripūrṇaṁ tajjālam ākr̥ṣyōdatōlayat kintvētāvadbhi rmatsyairapi jālaṁ nāchidyata|</para>
  <para style="p">
    <verse number="12" style="v"/>anantaraṁ yīśustān avādīt yūyamāgatya bhuṁgdhvaṁ; tadā saēva prabhuriti jñātatvāt tvaṁ kaḥ? iti praṣṭuṁ śiṣyāṇāṁ kasyāpi pragalbhatā nābhavat|</para>
  <para style="p">
    <verse number="13" style="v"/>tatō yīśurāgatya pūpān matsyāṁśca gr̥hītvā tēbhyaḥ paryyavēṣayat|</para>
  <para style="p">
    <verse number="14" style="v"/>itthaṁ śmaśānādutthānāt paraṁ yīśuḥ śiṣyēbhyastr̥tīyavāraṁ darśanaṁ dattavān|</para>
  <para style="p">
    <verse number="15" style="v"/>bhōjanē samāptē sati yīśuḥ śimōnpitaraṁ pr̥ṣṭavān, hē yūnasaḥ putra śimōn tvaṁ kim ētēbhyōdhikaṁ mayi prīyasē? tataḥ sa uditavān satyaṁ prabhō tvayi prīyē'haṁ tad bhavān jānāti; tadā yīśurakathayat tarhi mama mēṣaśāvakagaṇaṁ pālaya|</para>
  <para style="p">
    <verse number="16" style="v"/>tataḥ sa dvitīyavāraṁ pr̥ṣṭavān hē yūnasaḥ putra śimōn tvaṁ kiṁ mayi prīyasē? tataḥ sa uktavān satyaṁ prabhō tvayi prīyē'haṁ tad bhavān jānāti; tadā yīśurakathayata tarhi mama mēṣagaṇaṁ pālaya|</para>
  <para style="p">
    <verse number="17" style="v"/>paścāt sa tr̥tīyavāraṁ pr̥ṣṭavān, hē yūnasaḥ putra śimōn tvaṁ kiṁ mayi prīyasē? ētadvākyaṁ tr̥tīyavāraṁ pr̥ṣṭavān tasmāt pitarō duḥkhitō bhūtvā'kathayat hē prabhō bhavataḥ kimapyagōcaraṁ nāsti tvayyahaṁ prīyē tad bhavān jānāti; tatō yīśuravadat tarhi mama mēṣagaṇaṁ pālaya|</para>
  <para style="p">
    <verse number="18" style="v"/>ahaṁ tubhyaṁ yathārthaṁ kathayāmi yauvanakālē svayaṁ baddhakaṭi ryatrēcchā tatra yātavān kintvitaḥ paraṁ vr̥ddhē vayasi hastaṁ vistārayiṣyasi, anyajanastvāṁ baddhvā yatra gantuṁ tavēcchā na bhavati tvāṁ dhr̥tvā tatra nēṣyati|</para>
  <para style="p">
    <verse number="19" style="v"/>phalataḥ kīdr̥śēna maraṇēna sa īśvarasya mahimānaṁ prakāśayiṣyati tad bōdhayituṁ sa iti vākyaṁ prōktavān| ityuktē sati sa tamavōcat mama paścād āgaccha|</para>
  <para style="p">
    <verse number="20" style="v"/>yō janō rātrikālē yīśō rvakṣō'valambya, hē prabhō kō bhavantaṁ parakarēṣu samarpayiṣyatīti vākyaṁ pr̥ṣṭavān, taṁ yīśōḥ priyatamaśiṣyaṁ paścād āgacchantaṁ</para>
  <para style="p">
    <verse number="21" style="v"/>pitarō mukhaṁ parāvarttya vilōkya yīśuṁ pr̥ṣṭavān, hē prabhō ētasya mānavasya kīdr̥śī gati rbhaviṣyati?</para>
  <para style="p">
    <verse number="22" style="v"/>sa pratyavadat, mama punarāgamanaparyyantaṁ yadi taṁ sthāpayitum icchāmi tatra tava kiṁ? tvaṁ mama paścād āgaccha|</para>
  <para style="p">
    <verse number="23" style="v"/>tasmāt sa śiṣyō na mariṣyatīti bhrātr̥gaṇamadhyē kiṁvadantī jātā kintu sa na mariṣyatīti vākyaṁ yīśu rnāvadat kēvalaṁ mama punarāgamanaparyyantaṁ yadi taṁ sthāpayitum icchāmi tatra tava kiṁ? iti vākyam uktavān|</para>
  <para style="p">
    <verse number="24" style="v"/>yō jana ētāni sarvvāṇi likhitavān atra sākṣyañca dattavān saēva sa śiṣyaḥ, tasya sākṣyaṁ pramāṇamiti vayaṁ jānīmaḥ|</para>
  <para style="p">
    <verse number="25" style="v"/>yīśurētēbhyō'parāṇyapi bahūni karmmāṇi kr̥tavān tāni sarvvāṇi yadyēkaikaṁ kr̥tvā likhyantē tarhi granthā ētāvantō bhavanti tēṣāṁ dhāraṇē pr̥thivyāṁ sthānaṁ na bhavati| iti||</para>
</usx>
