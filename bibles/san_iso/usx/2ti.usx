<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="2TI" style="id">Sanskrit Bible (NT) in ISO Script (satyavēdaḥ ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">2 Timothy</para>
  <para style="toc1">2 tīmathiyaṁ patraṁ</para>
  <para style="toc2">2 tīmathiyaḥ</para>
  <para style="toc3">2 tīmathiyaḥ</para>
  <para style="mt1">2 tīmathiyaṁ patraṁ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>khrīṣṭēna yīśunā yā jīvanasya pratijñā tāmadhīśvarasyēcchayā yīśōḥ khrīṣṭasyaikaḥ prēritaḥ paulō'haṁ svakīyaṁ priyaṁ dharmmaputraṁ tīmathiyaṁ prati patraṁ likhāmi|</para>
  <para style="p">
    <verse number="2" style="v"/>tāta īśvarō'smākaṁ prabhu ryīśukhrīṣṭaśca tvayi prasādaṁ dayāṁ śāntiñca kriyāstāṁ|</para>
  <para style="p">
    <verse number="3" style="v"/>aham ā pūrvvapuruṣāt yam īśvaraṁ pavitramanasā sēvē taṁ dhanyaṁ vadanaṁ kathayāmi, aham ahōrātraṁ prārthanāsamayē tvāṁ nirantaraṁ smarāmi|</para>
  <para style="p">
    <verse number="4" style="v"/>yaśca viśvāsaḥ prathamē lōyīnāmikāyāṁ tava mātāmahyām unīkīnāmikāyāṁ mātari cātiṣṭhat tavāntarē'pi tiṣṭhatīti manyē</para>
  <para style="p">
    <verse number="5" style="v"/>tava taṁ niṣkapaṭaṁ viśvāsaṁ manasi kurvvan tavāśrupātaṁ smaran yathānandēna praphallō bhavēyaṁ tadarthaṁ tava darśanam ākāṅkṣē|</para>
  <para style="p">
    <verse number="6" style="v"/>atō hētō rmama hastārpaṇēna labdhō ya īśvarasya varastvayi vidyatē tam ujjvālayituṁ tvāṁ smārayāmi|</para>
  <para style="p">
    <verse number="7" style="v"/>yata īśvarō'smabhyaṁ bhayajanakam ātmānam adattvā śaktiprēmasatarkatānām ākaram ātmānaṁ dattavān|</para>
  <para style="p">
    <verse number="8" style="v"/>ataēvāsmākaṁ prabhumadhi tasya vandidāsaṁ māmadhi ca pramāṇaṁ dātuṁ na trapasva kintvīśvarīyaśaktyā susaṁvādasya kr̥tē duḥkhasya sahabhāgī bhava|</para>
  <para style="p">
    <verse number="9" style="v"/>sō'smān paritrāṇapātrāṇi kr̥tavān pavitrēṇāhvānēnāhūtavāṁśca; asmatkarmmahētunēti nahi svīyanirūpāṇasya prasādasya ca kr̥tē tat kr̥tavān| sa prasādaḥ sr̥ṣṭēḥ pūrvvakālē khrīṣṭēna yīśunāsmabhyam adāyi,</para>
  <para style="p">
    <verse number="10" style="v"/>kintvadhunāsmākaṁ paritrātu ryīśōḥ khrīṣṭasyāgamanēna prākāśata| khrīṣṭō mr̥tyuṁ parājitavān susaṁvādēna ca jīvanam amaratāñca prakāśitavān|</para>
  <para style="p">
    <verse number="11" style="v"/>tasya ghōṣayitā dūtaścānyajātīyānāṁ śikṣakaścāhaṁ niyuktō'smi|</para>
  <para style="p">
    <verse number="12" style="v"/>tasmāt kāraṇāt mamāyaṁ klēśō bhavati tēna mama lajjā na jāyatē yatō'haṁ yasmin viśvasitavān tamavagatō'smi mahādinaṁ yāvat mamōpanidhē rgōpanasya śaktistasya vidyata iti niścitaṁ jānāmi|</para>
  <para style="p">
    <verse number="13" style="v"/>hitadāyakānāṁ vākyānām ādarśarūpēṇa mattaḥ śrutāḥ khrīṣṭē yīśau viśvāsaprēmnōḥ kathā dhāraya|</para>
  <para style="p">
    <verse number="14" style="v"/>aparam asmadantarvāsinā pavitrēṇātmanā tāmuttamām upanidhiṁ gōpaya|</para>
  <para style="p">
    <verse number="15" style="v"/>āśiyādēśīyāḥ sarvvē māṁ tyaktavanta iti tvaṁ jānāsi tēṣāṁ madhyē phūgillō harmmaginiśca vidyētē|</para>
  <para style="p">
    <verse number="16" style="v"/>prabhuranīṣipharasya parivārān prati kr̥pāṁ vidadhātu yataḥ sa punaḥ puna rmām āpyāyitavān</para>
  <para style="p">
    <verse number="17" style="v"/>mama śr̥ṅkhalēna na trapitvā rōmānagarē upasthitisamayē yatnēna māṁ mr̥gayitvā mamōddēśaṁ prāptavān|</para>
  <para style="p">
    <verse number="18" style="v"/>atō vicāradinē sa yathā prabhōḥ kr̥pābhājanaṁ bhavēt tādr̥śaṁ varaṁ prabhustasmai dēyāt| iphiṣanagarē'pi sa kati prakārai rmām upakr̥tavān tat tvaṁ samyag vētsi|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>hē mama putra, khrīṣṭayīśutō yō'nugrahastasya balēna tvaṁ balavān bhava|</para>
  <para style="p">
    <verse number="2" style="v"/>aparaṁ bahubhiḥ sākṣibhiḥ pramāṇīkr̥tāṁ yāṁ śikṣāṁ śrutavānasi tāṁ viśvāsyēṣu parasmai śikṣādānē nipuṇēṣu ca lōkēṣu samarpaya|</para>
  <para style="p">
    <verse number="3" style="v"/>tvaṁ yīśukhrīṣṭasyōttamō yōddhēva klēśaṁ sahasva|</para>
  <para style="p">
    <verse number="4" style="v"/>yō yuddhaṁ karōti sa sāṁsārikē vyāpārē magnō na bhavati kintu svaniyōjayitrē rōcituṁ cēṣṭatē|</para>
  <para style="p">
    <verse number="5" style="v"/>aparaṁ yō mallai ryudhyati sa yadi niyamānusārēṇa na yuddhyati tarhi kirīṭaṁ na lapsyatē|</para>
  <para style="p">
    <verse number="6" style="v"/>aparaṁ yaḥ kr̥ṣīvalaḥ karmma karōti tēna prathamēna phalabhāginā bhavitavyaṁ|</para>
  <para style="p">
    <verse number="7" style="v"/>mayā yaducyatē tat tvayā budhyatāṁ yataḥ prabhustubhyaṁ sarvvatra buddhiṁ dāsyati|</para>
  <para style="p">
    <verse number="8" style="v"/>mama susaṁvādasya vacanānusārād dāyūdvaṁśīyaṁ mr̥tagaṇamadhyād utthāpitañca yīśuṁ khrīṣṭaṁ smara|</para>
  <para style="p">
    <verse number="9" style="v"/>tatsusaṁvādakāraṇād ahaṁ duṣkarmmēva bandhanadaśāparyyantaṁ klēśaṁ bhuñjē kintvīśvarasya vākyam abaddhaṁ tiṣṭhati|</para>
  <para style="p">
    <verse number="10" style="v"/>khrīṣṭēna yīśunā yad anantagauravasahitaṁ paritrāṇaṁ jāyatē tadabhirucitai rlōkairapi yat labhyēta tadarthamahaṁ tēṣāṁ nimittaṁ sarvvāṇyētāni sahē|</para>
  <para style="p">
    <verse number="11" style="v"/>aparam ēṣā bhāratī satyā yadi vayaṁ tēna sārddhaṁ mriyāmahē tarhi tēna sārddhaṁ jīvivyāmaḥ, yadi ca klēśaṁ sahāmahē tarhi tēna sārddhaṁ rājatvamapi kariṣyāmahē|</para>
  <para style="p">
    <verse number="12" style="v"/>yadi vayaṁ tam anaṅgīkurmmastarhi sō 'smānapyanaṅgīkariṣyati|</para>
  <para style="p">
    <verse number="13" style="v"/>yadi vayaṁ na viśvāsāmastarhi sa viśvāsyastiṣṭhati yataḥ svam apahnōtuṁ na śaknōti|</para>
  <para style="p">
    <verse number="14" style="v"/>tvamētāni smārayan tē yathā niṣphalaṁ śrōtr̥ṇāṁ bhraṁśajanakaṁ vāgyuddhaṁ na kuryyastathā prabhōḥ samakṣaṁ dr̥ḍhaṁ vinīyādiśa|</para>
  <para style="p">
    <verse number="15" style="v"/>aparaṁ tvam īśvarasya sākṣāt svaṁ parīkṣitam anindanīyakarmmakāriṇañca satyamatasya vākyānāṁ sadvibhajanē nipuṇañca darśayituṁ yatasva|</para>
  <para style="p">
    <verse number="16" style="v"/>kintvapavitrā anarthakakathā dūrīkuru yatastadālambina uttarōttaram adharmmē varddhiṣyantē,</para>
  <para style="p">
    <verse number="17" style="v"/>tēṣāñca vākyaṁ galitakṣatavat kṣayavarddhakō bhaviṣyati tēṣāṁ madhyē humināyaḥ philītaścētināmānau dvau janau satyamatād bhraṣṭau jātau,</para>
  <para style="p">
    <verse number="18" style="v"/>mr̥tānāṁ punarutthiti rvyatītēti vadantau kēṣāñcid viśvāsam utpāṭayataśca|</para>
  <para style="p">
    <verse number="19" style="v"/>tathāpīśvarasya bhittimūlam acalaṁ tiṣṭhati tasmiṁścēyaṁ lipi rmudrāṅkitā vidyatē| yathā, jānāti paramēśastu svakīyān sarvvamānavān| apagacchēd adharmmācca yaḥ kaścit khrīṣṭanāmakr̥t||</para>
  <para style="p">
    <verse number="20" style="v"/>kintu br̥hannikētanē kēvala suvarṇamayāni raupyamayāṇi ca bhājanāni vidyanta iti tarhi kāṣṭhamayāni mr̥ṇmayānyapi vidyantē tēṣāñca kiyanti sammānāya kiyantapamānāya ca bhavanti|</para>
  <para style="p">
    <verse number="21" style="v"/>atō yadi kaścid ētādr̥śēbhyaḥ svaṁ pariṣkarōti tarhi sa pāvitaṁ prabhōḥ kāryyayōgyaṁ sarvvasatkāryyāyōpayuktaṁ sammānārthakañca bhājanaṁ bhaviṣyati|</para>
  <para style="p">
    <verse number="22" style="v"/>yauvanāvasthāyā abhilāṣāstvayā parityajyantāṁ dharmmō viśvāsaḥ prēma yē ca śucimanōbhiḥ prabhum uddiśya prārthanāṁ kurvvatē taiḥ sārddham aikyabhāvaścaitēṣu tvayā yatnō vidhīyatāṁ|</para>
  <para style="p">
    <verse number="23" style="v"/>aparaṁ tvam anarthakān ajñānāṁśca praśnān vāgyuddhōtpādakān jñātvā dūrīkuru|</para>
  <para style="p">
    <verse number="24" style="v"/>yataḥ prabhō rdāsēna yuddham akarttavyaṁ kintu sarvvān prati śāntēna śikṣādānēcchukēna sahiṣṇunā ca bhavitavyaṁ, vipakṣāśca tēna namratvēna cētitavyāḥ|</para>
  <para style="p">
    <verse number="25" style="v"/>tathā kr̥tē yadīśvaraḥ satyamatasya jñānārthaṁ tēbhyō manaḥparivarttanarūpaṁ varaṁ dadyāt,</para>
  <para style="p">
    <verse number="26" style="v"/>tarhi tē yēna śayatānēna nijābhilāṣasādhanāya dhr̥tāstasya jālāt cētanāṁ prāpyōddhāraṁ labdhuṁ śakṣyanti|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>caramadinēṣu klēśajanakāḥ samayā upasthāsyantīti jānīhi|</para>
  <para style="p">
    <verse number="2" style="v"/>yatastātkālikā lōkā ātmaprēmiṇō 'rthaprēmiṇa ātmaślāghinō 'bhimāninō nindakāḥ pitrōranājñāgrāhiṇaḥ kr̥taghnā apavitrāḥ</para>
  <para style="p">
    <verse number="3" style="v"/>prītivarjitā asandhēyā mr̥ṣāpavādinō 'jitēndriyāḥ pracaṇḍā bhadradvēṣiṇō</para>
  <para style="p">
    <verse number="4" style="v"/>viśvāsaghātakā duḥsāhasinō darpadhmātā īśvarāprēmiṇaḥ kintu sukhaprēmiṇō</para>
  <para style="p">
    <verse number="5" style="v"/>bhaktavēśāḥ kintvasvīkr̥tabhaktiguṇā bhaviṣyanti; ētādr̥śānāṁ lōkānāṁ saṁmargaṁ parityaja|</para>
  <para style="p">
    <verse number="6" style="v"/>yatō yē janāḥ pracchannaṁ gēhān praviśanti pāpai rbhāragrastā nānāvidhābhilāṣaiścālitā yāḥ kāminyō</para>
  <para style="p">
    <verse number="7" style="v"/>nityaṁ śikṣantē kintu satyamatasya tattvajñānaṁ prāptuṁ kadācit na śaknuvanti tā dāsīvad vaśīkurvvatē ca tē tādr̥śā lōkāḥ|</para>
  <para style="p">
    <verse number="8" style="v"/>yānni ryāmbriśca yathā mūsamaṁ prati vipakṣatvam akurutāṁ tathaiva bhraṣṭamanasō viśvāsaviṣayē 'grāhyāścaitē lōkā api satyamataṁ prati vipakṣatāṁ kurvvanti|</para>
  <para style="p">
    <verse number="9" style="v"/>kintu tē bahudūram agrasarā na bhaviṣyanti yatastayō rmūḍhatā yadvat tadvad ētēṣāmapi mūḍhatā sarvvadr̥śyā bhaviṣyati|</para>
  <para style="p">
    <verse number="10" style="v"/>mamōpadēśaḥ śiṣṭatābhiprāyō viśvāsō rdharyyaṁ prēma sahiṣṇutōpadravaḥ klēśā</para>
  <para style="p">
    <verse number="11" style="v"/>āntiyakhiyāyām ikaniyē lūstrāyāñca māṁ prati yadyad aghaṭata yāṁścōpadravān aham asahē sarvvamētat tvam avagatō'si kintu tatsarvvataḥ prabhu rmām uddhr̥tavān|</para>
  <para style="p">
    <verse number="12" style="v"/>parantu yāvantō lōkāḥ khrīṣṭēna yīśunēśvarabhaktim ācaritum icchanti tēṣāṁ sarvvēṣām upadravō bhaviṣyati|</para>
  <para style="p">
    <verse number="13" style="v"/>aparaṁ pāpiṣṭhāḥ khalāśca lōkā bhrāmyantō bhramayantaścōttarōttaraṁ duṣṭatvēna varddhiṣyantē|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu tvaṁ yad yad aśikṣathāḥ, yacca tvayi samarpitam abhūt tasmin avatiṣṭha, yataḥ kasmāt śikṣāṁ prāptō'si tad vētsi;</para>
  <para style="p">
    <verse number="15" style="v"/>yāni ca dharmmaśāstrāṇi khrīṣṭē yīśau viśvāsēna paritrāṇaprāptayē tvāṁ jñāninaṁ karttuṁ śaknuvanti tāni tvaṁ śaiśavakālād avagatō'si|</para>
  <para style="p">
    <verse number="16" style="v"/>tat sarvvaṁ śāstram īśvarasyātmanā dattaṁ śikṣāyai dōṣabōdhāya śōdhanāya dharmmavinayāya ca phalayūktaṁ bhavati</para>
  <para style="p">
    <verse number="17" style="v"/>tēna cēśvarasya lōkō nipuṇaḥ sarvvasmai satkarmmaṇē susajjaśca bhavati|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>īśvarasya gōcarē yaśca yīśuḥ khrīṣṭaḥ svīyāgamanakālē svarājatvēna jīvatāṁ mr̥tānāñca lōkānāṁ vicāraṁ kariṣyati tasya gōcarē 'haṁ tvām idaṁ dr̥ḍham ājñāpayāmi|</para>
  <para style="p">
    <verse number="2" style="v"/>tvaṁ vākyaṁ ghōṣaya kālē'kālē cōtsukō bhava pūrṇayā sahiṣṇutayā śikṣayā ca lōkān prabōdhaya bhartsaya vinayasva ca|</para>
  <para style="p">
    <verse number="3" style="v"/>yata ētādr̥śaḥ samaya āyāti yasmin lōkā yathārtham upadēśam asahyamānāḥ karṇakaṇḍūyanaviśiṣṭā bhūtvā nijābhilāṣāt śikṣakān saṁgrahīṣyanti</para>
  <para style="p">
    <verse number="4" style="v"/>satyamatācca śrōtrāṇi nivarttya vipathagāminō bhūtvōpākhyānēṣu pravarttiṣyantē;</para>
  <para style="p">
    <verse number="5" style="v"/>kintu tvaṁ sarvvaviṣayē prabuddhō bhava duḥkhabhōgaṁ svīkuru susaṁvādapracārakasya karmma sādhaya nijaparicaryyāṁ pūrṇatvēna kuru ca|</para>
  <para style="p">
    <verse number="6" style="v"/>mama prāṇānām utsargō bhavati mama prasthānakālaścōpātiṣṭhat|</para>
  <para style="p">
    <verse number="7" style="v"/>aham uttamayuddhaṁ kr̥tavān gantavyamārgasyāntaṁ yāvad dhāvitavān viśvāsañca rakṣitavān|</para>
  <para style="p">
    <verse number="8" style="v"/>śēṣaṁ puṇyamukuṭaṁ madarthaṁ rakṣitaṁ vidyatē tacca tasmin mahādinē yathārthavicārakēṇa prabhunā mahyaṁ dāyiṣyatē kēvalaṁ mahyam iti nahi kintu yāvantō lōkāstasyāgamanam ākāṅkṣantē tēbhyaḥ sarvvēbhyō 'pi dāyiṣyatē|</para>
  <para style="p">
    <verse number="9" style="v"/>tvaṁ tvarayā matsamīpam āgantuṁ yatasva,</para>
  <para style="p">
    <verse number="10" style="v"/>yatō dīmā aihikasaṁsāram īhamānō māṁ parityajya thiṣalanīkīṁ gatavān tathā krīṣki rgālātiyāṁ gatavān tītaśca dālmātiyāṁ gatavān|</para>
  <para style="p">
    <verse number="11" style="v"/>kēvalō lūkō mayā sārddhaṁ vidyatē| tvaṁ mārkaṁ saṅginaṁ kr̥tvāgaccha yataḥ sa paricaryyayā mamōpakārī bhaviṣyati,</para>
  <para style="p">
    <verse number="12" style="v"/>tukhikañcāham iphiṣanagaraṁ prēṣitavān|</para>
  <para style="p">
    <verse number="13" style="v"/>yad ācchādanavastraṁ trōyānagarē kārpasya sannidhau mayā nikṣiptaṁ tvamāgamanasamayē tat pustakāni ca viśēṣataścarmmagranthān ānaya|</para>
  <para style="p">
    <verse number="14" style="v"/>kāṁsyakāraḥ sikandarō mama bahvaniṣṭaṁ kr̥tavān prabhustasya karmmaṇāṁ samucitaphalaṁ dadātu|</para>
  <para style="p">
    <verse number="15" style="v"/>tvamapi tasmāt sāvadhānāstiṣṭha yataḥ sō'smākaṁ vākyānām atīva vipakṣō jātaḥ|</para>
  <para style="p">
    <verse number="16" style="v"/>mama prathamapratyuttarasamayē kō'pi mama sahāyō nābhavat sarvvē māṁ paryyatyajan tān prati tasya dōṣasya gaṇanā na bhūyāt;</para>
  <para style="p">
    <verse number="17" style="v"/>kintu prabhu rmama sahāyō 'bhavat yathā ca mayā ghōṣaṇā sādhyēta bhinnajātīyāśca sarvvē susaṁvādaṁ śr̥ṇuyustathā mahyaṁ śaktim adadāt tatō 'haṁ siṁhasya mukhād uddhr̥taḥ|</para>
  <para style="p">
    <verse number="18" style="v"/>aparaṁ sarvvasmād duṣkarmmataḥ prabhu rmām uddhariṣyati nijasvargīyarājyaṁ nētuṁ māṁ tārayiṣyati ca| tasya dhanyavādaḥ sadākālaṁ bhūyāt| āmēn|</para>
  <para style="p">
    <verse number="19" style="v"/>tvaṁ priṣkām ākkilam anīṣipharasya parijanāṁśca namaskuru|</para>
  <para style="p">
    <verse number="20" style="v"/>irāstaḥ karinthanagarē 'tiṣṭhat traphimaśca pīḍitatvāt milītanagarē mayā vyahīyata|</para>
  <para style="p">
    <verse number="21" style="v"/>tvaṁ hēmantakālāt pūrvvam āgantuṁ yatasva| ubūlaḥ pūdi rlīnaḥ klaudiyā sarvvē bhrātaraśca tvāṁ namaskurvvatē|</para>
  <para style="p">
    <verse number="22" style="v"/>prabhu ryīśuḥ khrīṣṭastavātmanā saha bhūyāt| yuṣmāsvanugrahō bhūyāt| āmēn|</para>
</usx>
