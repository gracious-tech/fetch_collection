  <para style="h">Galatians</para>
  <para style="toc1">gālātinaḥ patraṁ</para>
  <para style="toc2">gālātinaḥ</para>
  <para style="toc3">gālātinaḥ</para>
  <para style="mt1">gālātinaḥ patraṁ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>manuṣyēbhyō nahi manuṣyairapi nahi kintu yīśukhrīṣṭēna mr̥tagaṇamadhyāt tasyōtthāpayitrā pitrēśvarēṇa ca prēritō yō'haṁ paulaḥ sō'haṁ</para>
  <para style="p">
    <verse number="2" style="v"/>matsahavarttinō bhrātaraśca vayaṁ gālātīyadēśasthāḥ samitīḥ prati patraṁ likhāmaḥ|</para>
  <para style="p">
    <verse number="3" style="v"/>pitrēśvarēṇāsmāṁka prabhunā yīśunā khrīṣṭēna ca yuṣmabhyam anugrahaḥ śāntiśca dīyatāṁ|</para>
  <para style="p">
    <verse number="4" style="v"/>asmākaṁ tātēśvarēsyēcchānusārēṇa varttamānāt kutsitasaṁsārād asmān nistārayituṁ yō</para>
  <para style="p">
    <verse number="5" style="v"/>yīśurasmākaṁ pāpahētōrātmōtsargaṁ kr̥tavān sa sarvvadā dhanyō bhūyāt| tathāstu|</para>
  <para style="p">
    <verse number="6" style="v"/>khrīṣṭasyānugrahēṇa yō yuṣmān āhūtavān tasmānnivr̥tya yūyam atitūrṇam anyaṁ susaṁvādam anvavarttata tatrāhaṁ vismayaṁ manyē|</para>
  <para style="p">
    <verse number="7" style="v"/>sō'nyasusaṁvādaḥ susaṁvādō nahi kintu kēcit mānavā yuṣmān cañcalīkurvvanti khrīṣṭīyasusaṁvādasya viparyyayaṁ karttuṁ cēṣṭantē ca|</para>
  <para style="p">
    <verse number="8" style="v"/>yuṣmākaṁ sannidhau yaḥ susaṁvādō'smābhi rghōṣitastasmād anyaḥ susaṁvādō'smākaṁ svargīyadūtānāṁ vā madhyē kēnacid yadi ghōṣyatē tarhi sa śaptō bhavatu|</para>
  <para style="p">
    <verse number="9" style="v"/>pūrvvaṁ yadvad akathayāma, idānīmahaṁ punastadvat kathayāmi yūyaṁ yaṁ susaṁvādaṁ gr̥hītavantastasmād anyō yēna kēnacid yuṣmatsannidhau ghōṣyatē sa śaptō bhavatu|</para>
  <para style="p">
    <verse number="10" style="v"/>sāmprataṁ kamaham anunayāmi? īśvaraṁ kiṁvā mānavān? ahaṁ kiṁ mānuṣēbhyō rōcituṁ yatē? yadyaham idānīmapi mānuṣēbhyō ruruciṣēya tarhi khrīṣṭasya paricārakō na bhavāmi|</para>
  <para style="p">
    <verse number="11" style="v"/>hē bhrātaraḥ, mayā yaḥ susaṁvādō ghōṣitaḥ sa mānuṣānna labdhastadahaṁ yuṣmān jñāpayāmi|</para>
  <para style="p">
    <verse number="12" style="v"/>ahaṁ kasmāccit manuṣyāt taṁ na gr̥hītavān na vā śikṣitavān kēvalaṁ yīśōḥ khrīṣṭasya prakāśanādēva|</para>
  <para style="p">
    <verse number="13" style="v"/>purā yihūdimatācārī yadāham āsaṁ tadā yādr̥śam ācaraṇam akaravam īśvarasya samitiṁ pratyatīvōpadravaṁ kurvvan yādr̥k tāṁ vyanāśayaṁ tadavaśyaṁ śrutaṁ yuṣmābhiḥ|</para>
  <para style="p">
    <verse number="14" style="v"/>aparañca pūrvvapuruṣaparamparāgatēṣu vākyēṣvanyāpēkṣātīvāsaktaḥ san ahaṁ yihūdidharmmatē mama samavayaskān bahūn svajātīyān atyaśayi|</para>
  <para style="p">
    <verse number="15" style="v"/>kiñca ya īśvarō mātr̥garbhasthaṁ māṁ pr̥thak kr̥tvā svīyānugrahēṇāhūtavān</para>
  <para style="p">
    <verse number="16" style="v"/>sa yadā mayi svaputraṁ prakāśituṁ bhinnadēśīyānāṁ samīpē bhayā taṁ ghōṣayituñcābhyalaṣat tadāhaṁ kravyaśōṇitābhyāṁ saha na mantrayitvā</para>
  <para style="p">
    <verse number="17" style="v"/>pūrvvaniyuktānāṁ prēritānāṁ samīpaṁ yirūśālamaṁ na gatvāravadēśaṁ gatavān paścāt tatsthānād dammēṣakanagaraṁ parāvr̥tyāgatavān|</para>
  <para style="p">
    <verse number="18" style="v"/>tataḥ paraṁ varṣatrayē vyatītē'haṁ pitaraṁ sambhāṣituṁ yirūśālamaṁ gatvā pañcadaśadināni tēna sārddham atiṣṭhaṁ|</para>
  <para style="p">
    <verse number="19" style="v"/>kintu taṁ prabhō rbhrātaraṁ yākūbañca vinā prēritānāṁ nānyaṁ kamapyapaśyaṁ|</para>
  <para style="p">
    <verse number="20" style="v"/>yānyētāni vākyāni mayā likhyantē tānyanr̥tāni na santi tad īśvarō jānāti|</para>
  <para style="p">
    <verse number="21" style="v"/>tataḥ param ahaṁ suriyāṁ kilikiyāñca dēśau gatavān|</para>
  <para style="p">
    <verse number="22" style="v"/>tadānīṁ yihūdādēśasthānāṁ khrīṣṭasya samitīnāṁ lōkāḥ sākṣāt mama paricayamaprāpya kēvalaṁ janaśrutimimāṁ labdhavantaḥ,</para>
  <para style="p">
    <verse number="23" style="v"/>yō janaḥ pūrvvam asmān pratyupadravamakarōt sa tadā yaṁ dharmmamanāśayat tamēvēdānīṁ pracārayatīti|</para>
  <para style="p">
    <verse number="24" style="v"/>tasmāt tē māmadhīśvaraṁ dhanyamavadan|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ caturdaśasu vatsarēṣu gatēṣvahaṁ barṇabbā saha yirūśālamanagaraṁ punaragacchaṁ, tadānōṁ tītamapi svasaṅginam akaravaṁ|</para>
  <para style="p">
    <verse number="2" style="v"/>tatkālē'ham īśvaradarśanād yātrām akaravaṁ mayā yaḥ pariśramō'kāri kāriṣyatē vā sa yanniṣphalō na bhavēt tadarthaṁ bhinnajātīyānāṁ madhyē mayā ghōṣyamāṇaḥ susaṁvādastatratyēbhyō lōkēbhyō viśēṣatō mānyēbhyō narēbhyō mayā nyavēdyata|</para>
  <para style="p">
    <verse number="3" style="v"/>tatō mama sahacarastītō yadyapi yūnānīya āsīt tathāpi tasya tvakchēdō'pyāvaśyakō na babhūva|</para>
  <para style="p">
    <verse number="4" style="v"/>yataśchalēnāgatā asmān dāsān karttum icchavaḥ katipayā bhāktabhrātaraḥ khrīṣṭēna yīśunāsmabhyaṁ dattaṁ svātantryam anusandhātuṁ cārā iva samājaṁ prāviśan|</para>
  <para style="p">
    <verse number="5" style="v"/>ataḥ prakr̥tē susaṁvādē yuṣmākam adhikārō yat tiṣṭhēt tadarthaṁ vayaṁ daṇḍaikamapi yāvad ājñāgrahaṇēna tēṣāṁ vaśyā nābhavāma|</para>
  <para style="p">
    <verse number="6" style="v"/>parantu yē lōkā mānyāstē yē kēcid bhavēyustānahaṁ na gaṇayāmi yata īśvaraḥ kasyāpi mānavasya pakṣapātaṁ na karōti, yē ca mānyāstē māṁ kimapi navīnaṁ nājñāpayan|</para>
  <para style="p">
    <verse number="7" style="v"/>kintu chinnatvacāṁ madhyē susaṁvādapracāraṇasya bhāraḥ pitari yathā samarpitastathaivācchinnatvacāṁ madhyē susaṁvādapracāraṇasya bhārō mayi samarpita iti tai rbubudhē|</para>
  <para style="p">
    <verse number="8" style="v"/>yataśchinnatvacāṁ madhyē prēritatvakarmmaṇē yasya yā śaktiḥ pitaramāśritavatī tasyaiva sā śakti rbhinnajātīyānāṁ madhyē tasmai karmmaṇē māmapyāśritavatī|</para>
  <para style="p">
    <verse number="9" style="v"/>atō mahyaṁ dattam anugrahaṁ pratijñāya stambhā iva gaṇitā yē yākūb kaiphā yōhan caitē sahāyatāsūcakaṁ dakṣiṇahastagrahaṁṇa vidhāya māṁ barṇabbāñca jagaduḥ, yuvāṁ bhinnajātīyānāṁ sannidhiṁ gacchataṁ vayaṁ chinnatvacā sannidhiṁ gacchāmaḥ,</para>
  <para style="p">
    <verse number="10" style="v"/>kēvalaṁ daridrā yuvābhyāṁ smaraṇīyā iti| atastadēva karttum ahaṁ yatē sma|</para>
  <para style="p">
    <verse number="11" style="v"/>aparam āntiyakhiyānagaraṁ pitara āgatē'haṁ tasya dōṣitvāt samakṣaṁ tam abhartsayaṁ|</para>
  <para style="p">
    <verse number="12" style="v"/>yataḥ sa pūrvvam anyajātīyaiḥ sārddham āhāramakarōt tataḥ paraṁ yākūbaḥ samīpāt katipayajanēṣvāgatēṣu sa chinnatvaṅmanuṣyēbhyō bhayēna nivr̥tya pr̥thag abhavat|</para>
  <para style="p">
    <verse number="13" style="v"/>tatō'parē sarvvē yihūdinō'pi tēna sārddhaṁ kapaṭācāram akurvvan barṇabbā api tēṣāṁ kāpaṭyēna vipathagāmyabhavat|</para>
  <para style="p">
    <verse number="14" style="v"/>tatastē prakr̥tasusaṁvādarūpē saralapathē na carantīti dr̥ṣṭvāhaṁ sarvvēṣāṁ sākṣāt pitaram uktavān tvaṁ yihūdī san yadi yihūdimataṁ vihāya bhinnajātīya ivācarasi tarhi yihūdimatācaraṇāya bhinnajātīyān kutaḥ pravarttayasi?</para>
  <para style="p">
    <verse number="15" style="v"/>āvāṁ janmanā yihūdinau bhavāvō bhinnajātīyau pāpinau na bhavāvaḥ</para>
  <para style="p">
    <verse number="16" style="v"/>kintu vyavasthāpālanēna manuṣyaḥ sapuṇyō na bhavati kēvalaṁ yīśau khrīṣṭē yō viśvāsastēnaiva sapuṇyō bhavatīti buddhvāvāmapi vyavasthāpālanaṁ vinā kēvalaṁ khrīṣṭē viśvāsēna puṇyaprāptayē khrīṣṭē yīśau vyaśvasiva yatō vyavasthāpālanēna kō'pi mānavaḥ puṇyaṁ prāptuṁ na śaknōti|</para>
  <para style="p">
    <verse number="17" style="v"/>parantu yīśunā puṇyaprāptayē yatamānāvapyāvāṁ yadi pāpinau bhavāvastarhi kiṁ vaktavyaṁ? khrīṣṭaḥ pāpasya paricāraka iti? tanna bhavatu|</para>
  <para style="p">
    <verse number="18" style="v"/>mayā yad bhagnaṁ tad yadi mayā punarnirmmīyatē tarhi mayaivātmadōṣaḥ prakāśyatē|</para>
  <para style="p">
    <verse number="19" style="v"/>ahaṁ yad īśvarāya jīvāmi tadarthaṁ vyavasthayā vyavasthāyai amriyē|</para>
  <para style="p">
    <verse number="20" style="v"/>khrīṣṭēna sārddhaṁ kruśē hatō'smi tathāpi jīvāmi kintvahaṁ jīvāmīti nahi khrīṣṭa ēva madanta rjīvati| sāmprataṁ saśarīrēṇa mayā yajjīvitaṁ dhāryyatē tat mama dayākāriṇi madarthaṁ svīyaprāṇatyāgini cēśvaraputrē viśvasatā mayā dhāryyatē|</para>
  <para style="p">
    <verse number="21" style="v"/>ahamīśvarasyānugrahaṁ nāvajānāmi yasmād vyavasthayā yadi puṇyaṁ bhavati tarhi khrīṣṭō nirarthakamamriyata|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>hē nirbbōdhā gālātilōkāḥ, yuṣmākaṁ madhyē kruśē hata iva yīśuḥ khrīṣṭō yuṣmākaṁ samakṣaṁ prakāśita āsīt atō yūyaṁ yathā satyaṁ vākyaṁ na gr̥hlītha tathā kēnāmuhyata?</para>
  <para style="p">
    <verse number="2" style="v"/>ahaṁ yuṣmattaḥ kathāmēkāṁ jijñāsē yūyam ātmānaṁ kēnālabhadhvaṁ? vyavasthāpālanēna kiṁ vā viśvāsavākyasya śravaṇēna?</para>
  <para style="p">
    <verse number="3" style="v"/>yūyaṁ kim īdr̥g abōdhā yad ātmanā karmmārabhya śarīrēṇa tat sādhayituṁ yatadhvē?</para>
  <para style="p">
    <verse number="4" style="v"/>tarhi yuṣmākaṁ gurutarō duḥkhabhōgaḥ kiṁ niṣphalō bhaviṣyati? kuphalayuktō vā kiṁ bhaviṣyati?</para>
  <para style="p">
    <verse number="5" style="v"/>yō yuṣmabhyam ātmānaṁ dattavān yuṣmanmadhya āścaryyāṇi karmmāṇi ca sādhitavān sa kiṁ vyavasthāpālanēna viśvāsavākyasya śravaṇēna vā tat kr̥tavān?</para>
  <para style="p">
    <verse number="6" style="v"/>likhitamāstē, ibrāhīma īśvarē vyaśvasīt sa ca viśvāsastasmai puṇyārthaṁ gaṇitō babhūva,</para>
  <para style="p">
    <verse number="7" style="v"/>atō yē viśvāsāśritāsta ēvēbrāhīmaḥ santānā iti yuṣmābhi rjñāyatāṁ|</para>
  <para style="p">
    <verse number="8" style="v"/>īśvarō bhinnajātīyān viśvāsēna sapuṇyīkariṣyatīti pūrvvaṁ jñātvā śāstradātā pūrvvam ibrāhīmaṁ susaṁvādaṁ śrāvayana jagāda, tvattō bhinnajātīyāḥ sarvva āśiṣaṁ prāpsyantīti|</para>
  <para style="p">
    <verse number="9" style="v"/>atō yē viśvāsāśritāstē viśvāsinēbrāhīmā sārddham āśiṣaṁ labhantē|</para>
  <para style="p">
    <verse number="10" style="v"/>yāvantō lōkā vyavasthāyāḥ karmmaṇyāśrayanti tē sarvvē śāpādhīnā bhavanti yatō likhitamāstē, yathā, "yaḥ kaścid ētasya vyavasthāgranthasya sarvvavākyāni niścidraṁ na pālayati sa śapta iti|"</para>
  <para style="p">
    <verse number="11" style="v"/>īśvarasya sākṣāt kō'pi vyavasthayā sapuṇyō na bhavati tada vyaktaṁ yataḥ "puṇyavān mānavō viśvāsēna jīviṣyatīti" śāstrīyaṁ vacaḥ|</para>
  <para style="p">
    <verse number="12" style="v"/>vyavasthā tu viśvāsasambandhinī na bhavati kintvētāni yaḥ pālayiṣyati sa ēva tai rjīviṣyatītiniyamasambandhinī|</para>
  <para style="p">
    <verse number="13" style="v"/>khrīṣṭō'smān parikrīya vyavasthāyāḥ śāpāt mōcitavān yatō'smākaṁ vinimayēna sa svayaṁ śāpāspadamabhavat tadadhi likhitamāstē, yathā, "yaḥ kaścit tarāvullambyatē sō'bhiśapta iti|"</para>
  <para style="p">
    <verse number="14" style="v"/>tasmād khrīṣṭēna yīśunēvrāhīma āśī rbhinnajātīyalōkēṣu varttatē tēna vayaṁ pratijñātam ātmānaṁ viśvāsēna labdhuṁ śaknumaḥ|</para>
  <para style="p">
    <verse number="15" style="v"/>hē bhrātr̥gaṇa mānuṣāṇāṁ rītyanusārēṇāhaṁ kathayāmi kēnacit mānavēna yō niyamō niracāyi tasya vikr̥ti rvr̥ddhi rvā kēnāpi na kriyatē|</para>
  <para style="p">
    <verse number="16" style="v"/>parantvibrāhīmē tasya santānāya ca pratijñāḥ prati śuśruvirē tatra santānaśabdaṁ bahuvacanāntam abhūtvā tava santānāyētyēkavacanāntaṁ babhūva sa ca santānaḥ khrīṣṭa ēva|</para>
  <para style="p">
    <verse number="17" style="v"/>ataēvāhaṁ vadāmi, īśvarēṇa yō niyamaḥ purā khrīṣṭamadhi niracāyi tataḥ paraṁ triṁśadadhikacatuḥśatavatsarēṣu gatēṣu sthāpitā vyavasthā taṁ niyamaṁ nirarthakīkr̥tya tadīyapratijñā lōptuṁ na śaknōti|</para>
  <para style="p">
    <verse number="18" style="v"/>yasmāt sampadadhikārō yadi vyavasthayā bhavati tarhi pratijñayā na bhavati kintvīśvaraḥ pratijñayā tadadhikāritvam ibrāhīmē 'dadāt|</para>
  <para style="p">
    <verse number="19" style="v"/>tarhi vyavasthā kimbhūtā? pratijñā yasmai pratiśrutā tasya santānasyāgamanaṁ yāvad vyabhicāranivāraṇārthaṁ vyavasthāpi dattā, sā ca dūtairājñāpitā madhyasthasya karē samarpitā ca|</para>
  <para style="p">
    <verse number="20" style="v"/>naikasya madhyasthō vidyatē kintvīśvara ēka ēva|</para>
  <para style="p">
    <verse number="21" style="v"/>tarhi vyavasthā kim īśvarasya pratijñānāṁ viruddhā? tanna bhavatu| yasmād yadi sā vyavasthā jīvanadānēsamarthābhaviṣyat tarhi vyavasthayaiva puṇyalābhō'bhaviṣyat|</para>
  <para style="p">
    <verse number="22" style="v"/>kintu yīśukhrīṣṭē yō viśvāsastatsambandhiyāḥ pratijñāyāḥ phalaṁ yad viśvāsilōkēbhyō dīyatē tadarthaṁ śāstradātā sarvvān pāpādhīnān gaṇayati|</para>
  <para style="p">
    <verse number="23" style="v"/>ataēva viśvāsasyānāgatasamayē vayaṁ vyavasthādhīnāḥ santō viśvāsasyōdayaṁ yāvad ruddhā ivārakṣyāmahē|</para>
  <para style="p">
    <verse number="24" style="v"/>itthaṁ vayaṁ yad viśvāsēna sapuṇyībhavāmastadarthaṁ khrīṣṭasya samīpam asmān nētuṁ vyavasthāgrathō'smākaṁ vinētā babhūva|</para>
  <para style="p">
    <verse number="25" style="v"/>kintvadhunāgatē viśvāsē vayaṁ tasya vinēturanadhīnā abhavāma|</para>
  <para style="p">
    <verse number="26" style="v"/>khrīṣṭē yīśau viśvasanāt sarvvē yūyam īśvarasya santānā jātāḥ|</para>
  <para style="p">
    <verse number="27" style="v"/>yūyaṁ yāvantō lōkāḥ khrīṣṭē majjitā abhavata sarvvē khrīṣṭaṁ parihitavantaḥ|</para>
  <para style="p">
    <verse number="28" style="v"/>atō yuṣmanmadhyē yihūdiyūnāninō rdāsasvatantrayō ryōṣāpuruṣayōśca kō'pi viśēṣō nāsti; sarvvē yūyaṁ khrīṣṭē yīśāvēka ēva|</para>
  <para style="p">
    <verse number="29" style="v"/>kiñca yūyaṁ yadi khrīṣṭasya bhavatha tarhi sutarām ibrāhīmaḥ santānāḥ pratijñayā sampadadhikāriṇaścādhvē|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ahaṁ vadāmi sampadadhikārī yāvad bālastiṣṭhati tāvat sarvvasvasyādhipatiḥ sannapi sa dāsāt kēnāpi viṣayēṇa na viśiṣyatē</para>
  <para style="p">
    <verse number="2" style="v"/>kintu pitrā nirūpitaṁ samayaṁ yāvat pālakānāṁ dhanādhyakṣāṇāñca nighnastiṣṭhati|</para>
  <para style="p">
    <verse number="3" style="v"/>tadvad vayamapi bālyakālē dāsā iva saṁsārasyākṣaramālāyā adhīnā āsmahē|</para>
  <para style="p">
    <verse number="4" style="v"/>anantaraṁ samayē sampūrṇatāṁ gatavati vyavasthādhīnānāṁ mōcanārtham</para>
  <para style="p">
    <verse number="5" style="v"/>asmākaṁ putratvaprāptyarthañcēśvaraḥ striyā jātaṁ vyavasthāyā adhinībhūtañca svaputraṁ prēṣitavān|</para>
  <para style="p">
    <verse number="6" style="v"/>yūyaṁ santānā abhavata tatkāraṇād īśvaraḥ svaputrasyātmānāṁ yuṣmākam antaḥkaraṇāni prahitavān sa cātmā pitaḥ pitarityāhvānaṁ kārayati|</para>
  <para style="p">
    <verse number="7" style="v"/>ata idānīṁ yūyaṁ na dāsāḥ kintuḥ santānā ēva tasmāt santānatvācca khrīṣṭēnēśvarīyasampadadhikāriṇō'pyādhvē|</para>
  <para style="p">
    <verse number="8" style="v"/>aparañca pūrvvaṁ yūyam īśvaraṁ na jñātvā yē svabhāvatō'nīśvarāstēṣāṁ dāsatvē'tiṣṭhata|</para>
  <para style="p">
    <verse number="9" style="v"/>idānīm īśvaraṁ jñātvā yadi vēśvarēṇa jñātā yūyaṁ kathaṁ punastāni viphalāni tucchāni cākṣarāṇi prati parāvarttituṁ śaknutha? yūyaṁ kiṁ punastēṣāṁ dāsā bhavitumicchatha?</para>
  <para style="p">
    <verse number="10" style="v"/>yūyaṁ divasān māsān tithīn saṁvatsarāṁśca sammanyadhvē|</para>
  <para style="p">
    <verse number="11" style="v"/>yuṣmadarthaṁ mayā yaḥ pariśramō'kāri sa viphalō jāta iti yuṣmānadhyahaṁ bibhēmi|</para>
  <para style="p">
    <verse number="12" style="v"/>hē bhrātaraḥ, ahaṁ yādr̥śō'smi yūyamapi tādr̥śā bhavatēti prārthayē yatō'hamapi yuṣmattulyō'bhavaṁ yuṣmābhi rmama kimapi nāparāddhaṁ|</para>
  <para style="p">
    <verse number="13" style="v"/>pūrvvamahaṁ kalēvarasya daurbbalyēna yuṣmān susaṁvādam ajñāpayamiti yūyaṁ jānītha|</para>
  <para style="p">
    <verse number="14" style="v"/>tadānīṁ mama parīkṣakaṁ śārīraklēśaṁ dr̥ṣṭvā yūyaṁ mām avajñāya r̥tīyitavantastannahi kintvīśvarasya dūtamiva sākṣāt khrīṣṭa yīśumiva vā māṁ gr̥hītavantaḥ|</para>
  <para style="p">
    <verse number="15" style="v"/>atastadānīṁ yuṣmākaṁ yā dhanyatābhavat sā kka gatā? tadānīṁ yūyaṁ yadi svēṣāṁ nayanānyutpāṭya mahyaṁ dātum aśakṣyata tarhi tadapyakariṣyatēti pramāṇam ahaṁ dadāmi|</para>
  <para style="p">
    <verse number="16" style="v"/>sāmpratamahaṁ satyavāditvāt kiṁ yuṣmākaṁ ripu rjātō'smi?</para>
  <para style="p">
    <verse number="17" style="v"/>tē yuṣmatkr̥tē sparddhantē kintu sā sparddhā kutsitā yatō yūyaṁ tānadhi yat sparddhadhvaṁ tadarthaṁ tē yuṣmān pr̥thak karttum icchanti|</para>
  <para style="p">
    <verse number="18" style="v"/>kēvalaṁ yuṣmatsamīpē mamōpasthitisamayē tannahi, kintu sarvvadaiva bhadramadhi sparddhanaṁ bhadraṁ|</para>
  <para style="p">
    <verse number="19" style="v"/>hē mama bālakāḥ, yuṣmadanta ryāvat khrīṣṭō mūrtimān na bhavati tāvad yuṣmatkāraṇāt punaḥ prasavavēdanēva mama vēdanā jāyatē|</para>
  <para style="p">
    <verse number="20" style="v"/>ahamidānīṁ yuṣmākaṁ sannidhiṁ gatvā svarāntarēṇa yuṣmān sambhāṣituṁ kāmayē yatō yuṣmānadhi vyākulō'smi|</para>
  <para style="p">
    <verse number="21" style="v"/>hē vyavasthādhīnatākāṅkṣiṇaḥ yūyaṁ kiṁ vyavasthāyā vacanaṁ na gr̥hlītha?</para>
  <para style="p">
    <verse number="22" style="v"/>tanmāṁ vadata| likhitamāstē, ibrāhīmō dvau putrāvāsātē tayōrēkō dāsyāṁ dvitīyaśca patnyāṁ jātaḥ|</para>
  <para style="p">
    <verse number="23" style="v"/>tayō ryō dāsyāṁ jātaḥ sa śārīrikaniyamēna jajñē yaśca patnyāṁ jātaḥ sa pratijñayā jajñē|</para>
  <para style="p">
    <verse number="24" style="v"/>idamākhyānaṁ dr̥ṣṭantasvarūpaṁ| tē dvē yōṣitāvīśvarīyasandhī tayōrēkā sīnayaparvvatād utpannā dāsajanayitrī ca sā tu hājirā|</para>
  <para style="p">
    <verse number="25" style="v"/>yasmād hājirāśabdēnāravadēśasthasīnayaparvvatō bōdhyatē, sā ca varttamānāyā yirūśālampuryyāḥ sadr̥śī| yataḥ svabālaiḥ sahitā sā dāsatva āstē|</para>
  <para style="p">
    <verse number="26" style="v"/>kintu svargīyā yirūśālampurī patnī sarvvēṣām asmākaṁ mātā cāstē|</para>
  <para style="p">
    <verse number="27" style="v"/>yādr̥śaṁ likhitam āstē, "vandhyē santānahīnē tvaṁ svaraṁ jayajayaṁ kuru| aprasūtē tvayōllāsō jayāśabdaśca gīyatāṁ| yata ēva sanāthāyā yōṣitaḥ santatē rgaṇāt| anāthā yā bhavēnnārī tadapatyāni bhūriśaḥ||"</para>
  <para style="p">
    <verse number="28" style="v"/>hē bhrātr̥gaṇa, imhāk iva vayaṁ pratijñayā jātāḥ santānāḥ|</para>
  <para style="p">
    <verse number="29" style="v"/>kintu tadānīṁ śārīrikaniyamēna jātaḥ putrō yadvad ātmikaniyamēna jātaṁ putram upādravat tathādhunāpi|</para>
  <para style="p">
    <verse number="30" style="v"/>kintu śāstrē kiṁ likhitaṁ? "tvam imāṁ dāsīṁ tasyāḥ putrañcāpasāraya yata ēṣa dāsīputraḥ patnīputrēṇa samaṁ nōttarādhikārī bhaviyyatīti|"</para>
  <para style="p">
    <verse number="31" style="v"/>ataēva hē bhrātaraḥ, vayaṁ dāsyāḥ santānā na bhūtvā pātnyāḥ santānā bhavāmaḥ|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>khrīṣṭō'smabhyaṁ yat svātantryaṁ dattavān yūyaṁ tatra sthirāstiṣṭhata dāsatvayugēna puna rna nibadhyadhvaṁ|</para>
  <para style="p">
    <verse number="2" style="v"/>paśyatāhaṁ paulō yuṣmān vadāmi yadi chinnatvacō bhavatha tarhi khrīṣṭēna kimapi nōpakāriṣyadhvē|</para>
  <para style="p">
    <verse number="3" style="v"/>aparaṁ yaḥ kaścit chinnatvag bhavati sa kr̥tsnavyavasthāyāḥ pālanam īśvarāya dhārayatīti pramāṇaṁ dadāmi|</para>
  <para style="p">
    <verse number="4" style="v"/>yuṣmākaṁ yāvantō lōkā vyavasthayā sapuṇyībhavituṁ cēṣṭantē tē sarvvē khrīṣṭād bhraṣṭā anugrahāt patitāśca|</para>
  <para style="p">
    <verse number="5" style="v"/>yatō vayam ātmanā viśvāsāt puṇyalābhāśāsiddhaṁ pratīkṣāmahē|</para>
  <para style="p">
    <verse number="6" style="v"/>khrīṣṭē yīśau tvakchēdātvakchēdayōḥ kimapi guṇaṁ nāsti kintu prēmnā saphalō viśvāsa ēva guṇayuktaḥ|</para>
  <para style="p">
    <verse number="7" style="v"/>pūrvvaṁ yūyaṁ sundaram adhāvata kintvidānīṁ kēna bādhāṁ prāpya satyatāṁ na gr̥hlītha?</para>
  <para style="p">
    <verse number="8" style="v"/>yuṣmākaṁ sā mati ryuṣmadāhvānakāriṇa īśvarānna jātā|</para>
  <para style="p">
    <verse number="9" style="v"/>vikāraḥ kr̥tsnaśaktūnāṁ svalpakiṇvēna jasayatē|</para>
  <para style="p">
    <verse number="10" style="v"/>yuṣmākaṁ mati rvikāraṁ na gamiṣyatītyahaṁ yuṣmānadhi prabhunāśaṁsē; kintu yō yuṣmān vicāralayati sa yaḥ kaścid bhavēt samucitaṁ daṇḍaṁ prāpsyati|</para>
  <para style="p">
    <verse number="11" style="v"/>parantu hē bhrātaraḥ, yadyaham idānīm api tvakchēdaṁ pracārayēyaṁ tarhi kuta upadravaṁ bhuñjiya? tatkr̥tē kruśaṁ nirbbādham abhaviṣyat|</para>
  <para style="p">
    <verse number="12" style="v"/>yē janā yuṣmākaṁ cāñcalyaṁ janayanti tēṣāṁ chēdanamēva mayābhilaṣyatē|</para>
  <para style="p">
    <verse number="13" style="v"/>hē bhrātaraḥ, yūyaṁ svātantryārtham āhūtā ādhvē kintu tatsvātantryadvārēṇa śārīrikabhāvō yuṣmān na praviśatu| yūyaṁ prēmnā parasparaṁ paricaryyāṁ kurudhvaṁ|</para>
  <para style="p">
    <verse number="14" style="v"/>yasmāt tvaṁ samīpavāsini svavat prēma kuryyā ityēkājñā kr̥tsnāyā vyavasthāyāḥ sārasaṁgrahaḥ|</para>
  <para style="p">
    <verse number="15" style="v"/>kintu yūyaṁ yadi parasparaṁ daṁdaśyadhvē 'śāśyadhvē ca tarhi yuṣmākam ēkō'nyēna yanna grasyatē tatra yuṣmābhiḥ sāvadhānai rbhavitavyaṁ|</para>
  <para style="p">
    <verse number="16" style="v"/>ahaṁ bravīmi yūyam ātmikācāraṁ kuruta śārīrikābhilāṣaṁ mā pūrayata|</para>
  <para style="p">
    <verse number="17" style="v"/>yataḥ śārīrikābhilāṣa ātmanō viparītaḥ, ātmikābhilāṣaśca śarīrasya viparītaḥ, anayōrubhayōḥ parasparaṁ virōdhō vidyatē tēna yuṣmābhi ryad abhilaṣyatē tanna karttavyaṁ|</para>
  <para style="p">
    <verse number="18" style="v"/>yūyaṁ yadyātmanā vinīyadhvē tarhi vyavasthāyā adhīnā na bhavatha|</para>
  <para style="p">
    <verse number="19" style="v"/>aparaṁ paradāragamanaṁ vēśyāgamanam aśucitā kāmukatā pratimāpūjanam</para>
  <para style="p">
    <verse number="20" style="v"/>indrajālaṁ śatrutvaṁ vivādō'ntarjvalanaṁ krōdhaḥ kalahō'naikyaṁ</para>
  <para style="p">
    <verse number="21" style="v"/>pārthakyam īrṣyā vadhō mattatvaṁ lampaṭatvamityādīni spaṣṭatvēna śārīrikabhāvasya karmmāṇi santi| pūrvvaṁ yadvat mayā kathitaṁ tadvat punarapi kathyatē yē janā ētādr̥śāni karmmāṇyācaranti tairīśvarasya rājyē'dhikāraḥ kadāca na lapsyatē|</para>
  <para style="p">
    <verse number="22" style="v"/>kiñca prēmānandaḥ śāntiścirasahiṣṇutā hitaiṣitā bhadratvaṁ viśvāsyatā titikṣā</para>
  <para style="p">
    <verse number="23" style="v"/>parimitabhōjitvamityādīnyātmanaḥ phalāni santi tēṣāṁ viruddhā kāpi vyavasthā nahi|</para>
  <para style="p">
    <verse number="24" style="v"/>yē tu khrīṣṭasya lōkāstē ripubhirabhilāṣaiśca sahitaṁ śārīrikabhāvaṁ kruśē nihatavantaḥ|</para>
  <para style="p">
    <verse number="25" style="v"/>yadi vayam ātmanā jīvāmastarhyātmikācārō'smābhiḥ karttavyaḥ,</para>
  <para style="p">
    <verse number="26" style="v"/>darpaḥ parasparaṁ nirbhartsanaṁ dvēṣaścāsmābhi rna karttavyāni|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>hē bhrātaraḥ, yuṣmākaṁ kaścid yadi kasmiṁścit pāpē patati tarhyātmikabhāvayuktai ryuṣmābhistitikṣābhāvaṁ vidhāya sa punarutthāpyatāṁ yūyamapi yathā tādr̥kparīkṣāyāṁ na patatha tathā sāvadhānā bhavata|</para>
  <para style="p">
    <verse number="2" style="v"/>yuṣmākam ēkaikō janaḥ parasya bhāraṁ vahatvanēna prakārēṇa khrīṣṭasya vidhiṁ pālayata|</para>
  <para style="p">
    <verse number="3" style="v"/>yadi kaścana kṣudraḥ san svaṁ mahāntaṁ manyatē tarhi tasyātmavañcanā jāyatē|</para>
  <para style="p">
    <verse number="4" style="v"/>ata ēkaikēna janēna svakīyakarmmaṇaḥ parīkṣā kriyatāṁ tēna paraṁ nālōkya kēvalam ātmālōkanāt tasya ślaghā sambhaviṣyati|</para>
  <para style="p">
    <verse number="5" style="v"/>yata ēkaikōे janaḥ svakīyaṁ bhāraṁ vakṣyati|</para>
  <para style="p">
    <verse number="6" style="v"/>yō janō dharmmōpadēśaṁ labhatē sa upadēṣṭāraṁ svīyasarvvasampattē rbhāginaṁ karōtu|</para>
  <para style="p">
    <verse number="7" style="v"/>yuṣmākaṁ bhrānti rna bhavatu, īśvarō nōpahasitavyaḥ, yēna yad bījam upyatē tēna tajjātaṁ śasyaṁ karttiṣyatē|</para>
  <para style="p">
    <verse number="8" style="v"/>svaśarīrārthaṁ yēna bījam upyatē tēna śarīrād vināśarūpaṁ śasyaṁ lapsyatē kintvātmanaḥ kr̥tē yēna bījam upyatē tēnātmatō'nantajīvitarūpaṁ śasyaṁ lapsyatē|</para>
  <para style="p">
    <verse number="9" style="v"/>satkarmmakaraṇē'smābhiraśrāntai rbhavitavyaṁ yatō'klāntaustiṣṭhadbhirasmābhirupayuktasamayē tat phalāni lapsyantē|</para>
  <para style="p">
    <verse number="10" style="v"/>atō yāvat samayastiṣṭhati tāvat sarvvān prati viśēṣatō viśvāsavēśmavāsinaḥ pratyasmābhi rhitācāraḥ karttavyaḥ|</para>
  <para style="p">
    <verse number="11" style="v"/>hē bhrātaraḥ, ahaṁ svahastēna yuṣmān prati kiyadvr̥hat patraṁ likhitavān tad yuṣmābhi rdr̥śyatāṁ|</para>
  <para style="p">
    <verse number="12" style="v"/>yē śārīrikaviṣayē sudr̥śyā bhavitumicchanti tē yat khrīṣṭasya kruśasya kāraṇādupadravasya bhāginō na bhavanti kēvalaṁ tadarthaṁ tvakchēdē yuṣmān pravarttayanti|</para>
  <para style="p">
    <verse number="13" style="v"/>tē tvakchēdagrāhiṇō'pi vyavasthāṁ na pālayanti kintu yuṣmaccharīrāt ślāghālābhārthaṁ yuṣmākaṁ tvakchēdam icchanti|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu yēnāhaṁ saṁsārāya hataḥ saṁsārō'pi mahyaṁ hatastadasmatprabhō ryīśukhrīṣṭasya kruśaṁ vinānyatra kutrāpi mama ślāghanaṁ kadāpi na bhavatu|</para>
  <para style="p">
    <verse number="15" style="v"/>khrīṣṭē yīśau tvakchēdātvakchēdayōḥ kimapi guṇaṁ nāsti kintu navīnā sr̥ṣṭirēva guṇayuktā|</para>
  <para style="p">
    <verse number="16" style="v"/>aparaṁ yāvantō lōkā ētasmin mārgē caranti tēṣām īśvarīyasya kr̥tsnasyēsrāyēlaśca śānti rdayālābhaśca bhūyāt|</para>
  <para style="p">
    <verse number="17" style="v"/>itaḥ paraṁ kō'pi māṁ na kliśnātu yasmād ahaṁ svagātrē prabhō ryīśukhrīṣṭasya cihnāni dhārayē|</para>
  <para style="p">
    <verse number="18" style="v"/>hē bhrātaraḥ asmākaṁ prabhō ryīśukhrīṣṭasya prasādō yuṣmākam ātmani sthēyāt| tathāstu|</para>
</usx>
