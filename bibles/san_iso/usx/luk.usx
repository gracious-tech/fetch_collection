<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="LUK" style="id">Sanskrit Bible (NT) in ISO Script (satyavēdaḥ ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Luke</para>
  <para style="toc1">lūkalikhitaḥ susaṁvādaḥ</para>
  <para style="toc2">lūkaḥ</para>
  <para style="toc3">lūkaḥ</para>
  <para style="mt1">lūkalikhitaḥ susaṁvādaḥ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>prathamatō yē sākṣiṇō vākyapracārakāścāsan tē'smākaṁ madhyē yadyat sapramāṇaṁ vākyamarpayanti sma</para>
  <para style="p">
    <verse number="2" style="v"/>tadanusāratō'nyēpi bahavastadvr̥ttāntaṁ racayituṁ pravr̥ttāḥ|</para>
  <para style="p">
    <verse number="3" style="v"/>ataēva hē mahāmahimathiyaphil tvaṁ yā yāḥ kathā aśikṣyathāstāsāṁ dr̥ḍhapramāṇāni yathā prāpnōṣi</para>
  <para style="p">
    <verse number="4" style="v"/>tadarthaṁ prathamamārabhya tāni sarvvāṇi jñātvāhamapi anukramāt sarvvavr̥ttāntān tubhyaṁ lēkhituṁ matimakārṣam|</para>
  <para style="p">
    <verse number="5" style="v"/>yihūdādēśīyahērōdnāmakē rājatvaṁ kurvvati abīyayājakasya paryyāyādhikārī sikhariyanāmaka ēkō yājakō hārōṇavaṁśōdbhavā ilīśēvākhyā</para>
  <para style="p">
    <verse number="6" style="v"/>tasya jāyā dvāvimau nirdōṣau prabhōḥ sarvvājñā vyavasthāśca saṁmanya īśvaradr̥ṣṭau dhārmmikāvāstām|</para>
  <para style="p">
    <verse number="7" style="v"/>tayōḥ santāna ēkōpi nāsīt, yata ilīśēvā bandhyā tau dvāvēva vr̥ddhāvabhavatām|</para>
  <para style="p">
    <verse number="8" style="v"/>yadā svaparyyānukramēṇa sikhariya īśvāsya samakṣaṁ yājakīyaṁ karmma karōti</para>
  <para style="p">
    <verse number="9" style="v"/>tadā yajñasya dinaparipāyyā paramēśvarasya mandirē pravēśakālē dhūpajvālanaṁ karmma tasya karaṇīyamāsīt|</para>
  <para style="p">
    <verse number="10" style="v"/>taddhūpajvālanakālē lōkanivahē prārthanāṁ kartuṁ bahistiṣṭhati</para>
  <para style="p">
    <verse number="11" style="v"/>sati sikhariyō yasyāṁ vēdyāṁ dhūpaṁ jvālayati taddakṣiṇapārśvē paramēśvarasya dūta ēka upasthitō darśanaṁ dadau|</para>
  <para style="p">
    <verse number="12" style="v"/>taṁ dr̥ṣṭvā sikhariya udvivijē śaśaṅkē ca|</para>
  <para style="p">
    <verse number="13" style="v"/>tadā sa dūtastaṁ babhāṣē hē sikhariya mā bhaistava prārthanā grāhyā jātā tava bhāryyā ilīśēvā putraṁ prasōṣyatē tasya nāma yōेhan iti kariṣyasi|</para>
  <para style="p">
    <verse number="14" style="v"/>kiñca tvaṁ sānandaḥ saharṣaśca bhaviṣyasi tasya janmani bahava ānandiṣyanti ca|</para>
  <para style="p">
    <verse number="15" style="v"/>yatō hētōḥ sa paramēśvarasya gōcarē mahān bhaviṣyati tathā drākṣārasaṁ surāṁ vā kimapi na pāsyati, aparaṁ janmārabhya pavitrēṇātmanā paripūrṇaḥ</para>
  <para style="p">
    <verse number="16" style="v"/>san isrāyēlvaṁśīyān anēkān prabhōḥ paramēśvarasya mārgamānēṣyati|</para>
  <para style="p">
    <verse number="17" style="v"/>santānān prati pitr̥ṇāṁ manāṁsi dharmmajñānaṁ pratyanājñāgrāhiṇaśca parāvarttayituṁ, prabhōḥ paramēśvarasya sēvārtham ēkāṁ sajjitajātiṁ vidhātuñca sa ēliyarūpātmaśaktiprāptastasyāgrē gamiṣyati|</para>
  <para style="p">
    <verse number="18" style="v"/>tadā sikhariyō dūtamavādīt kathamētad vētsyāmi? yatōhaṁ vr̥ddhō mama bhāryyā ca vr̥ddhā|</para>
  <para style="p">
    <verse number="19" style="v"/>tatō dūtaḥ pratyuvāca paśyēśvarasya sākṣādvarttī jibrāyēlnāmā dūtōhaṁ tvayā saha kathāṁ gadituṁ tubhyamimāṁ śubhavārttāṁ dātuñca prēṣitaḥ|</para>
  <para style="p">
    <verse number="20" style="v"/>kintu madīyaṁ vākyaṁ kālē phaliṣyati tat tvayā na pratītam ataḥ kāraṇād yāvadēva tāni na sētsyanti tāvat tvaṁ vaktuṁmaśaktō mūkō bhava|</para>
  <para style="p">
    <verse number="21" style="v"/>tadānīṁ yē yē lōkāḥ sikhariyamapaikṣanta tē madhyēmandiraṁ tasya bahuvilambād āścaryyaṁ mēnirē|</para>
  <para style="p">
    <verse number="22" style="v"/>sa bahirāgatō yadā kimapi vākyaṁ vaktumaśaktaḥ saṅkētaṁ kr̥tvā niḥśabdastasyau tadā madhyēmandiraṁ kasyacid darśanaṁ tēna prāptam iti sarvvē bubudhirē|</para>
  <para style="p">
    <verse number="23" style="v"/>anantaraṁ tasya sēvanaparyyāyē sampūrṇē sati sa nijagēhaṁ jagāma|</para>
  <para style="p">
    <verse number="24" style="v"/>katipayadinēṣu gatēṣu tasya bhāryyā ilīśēvā garbbhavatī babhūva</para>
  <para style="p">
    <verse number="25" style="v"/>paścāt sā pañcamāsān saṁgōpyākathayat lōkānāṁ samakṣaṁ mamāpamānaṁ khaṇḍayituṁ paramēśvarō mayi dr̥ṣṭiṁ pātayitvā karmmēdr̥śaṁ kr̥tavān|</para>
  <para style="p">
    <verse number="26" style="v"/>aparañca tasyā garbbhasya ṣaṣṭhē māsē jātē gālīlpradēśīyanāsaratpurē</para>
  <para style="p">
    <verse number="27" style="v"/>dāyūdō vaṁśīyāya yūṣaphnāmnē puruṣāya yā mariyamnāmakumārī vāgdattāsīt tasyāḥ samīpaṁ jibrāyēl dūta īśvarēṇa prahitaḥ|</para>
  <para style="p">
    <verse number="28" style="v"/>sa gatvā jagāda hē īśvarānugr̥hītakanyē tava śubhaṁ bhūyāt prabhuḥ paramēśvarastava sahāyōsti nārīṇāṁ madhyē tvamēva dhanyā|</para>
  <para style="p">
    <verse number="29" style="v"/>tadānīṁ sā taṁ dr̥ṣṭvā tasya vākyata udvijya kīdr̥śaṁ bhāṣaṇamidam iti manasā cintayāmāsa|</para>
  <para style="p">
    <verse number="30" style="v"/>tatō dūtō'vadat hē mariyam bhayaṁ mākārṣīḥ, tvayi paramēśvarasyānugrahōsti|</para>
  <para style="p">
    <verse number="31" style="v"/>paśya tvaṁ garbbhaṁ dhr̥tvā putraṁ prasōṣyasē tasya nāma yīśuriti kariṣyasi|</para>
  <para style="p">
    <verse number="32" style="v"/>sa mahān bhaviṣyati tathā sarvvēbhyaḥ śrēṣṭhasya putra iti khyāsyati; aparaṁ prabhuḥ paramēśvarastasya piturdāyūdaḥ siṁhāsanaṁ tasmai dāsyati;</para>
  <para style="p">
    <verse number="33" style="v"/>tathā sa yākūbō vaṁśōpari sarvvadā rājatvaṁ kariṣyati, tasya rājatvasyāntō na bhaviṣyati|</para>
  <para style="p">
    <verse number="34" style="v"/>tadā mariyam taṁ dūtaṁ babhāṣē nāhaṁ puruṣasaṅgaṁ karōmi tarhi kathamētat sambhaviṣyati?</para>
  <para style="p">
    <verse number="35" style="v"/>tatō dūtō'kathayat pavitra ātmā tvāmāśrāyiṣyati tathā sarvvaśrēṣṭhasya śaktistavōpari chāyāṁ kariṣyati tatō hētōstava garbbhād yaḥ pavitrabālakō janiṣyatē sa īśvaraputra iti khyātiṁ prāpsyati|</para>
  <para style="p">
    <verse number="36" style="v"/>aparañca paśya tava jñātirilīśēvā yāṁ sarvvē bandhyāmavadan idānīṁ sā vārddhakyē santānamēkaṁ garbbhē'dhārayat tasya ṣaṣṭhamāsōbhūt|</para>
  <para style="p">
    <verse number="37" style="v"/>kimapi karmma nāsādhyam īśvarasya|</para>
  <para style="p">
    <verse number="38" style="v"/>tadā mariyam jagāda, paśya prabhērahaṁ dāsī mahyaṁ tava vākyānusārēṇa sarvvamētad ghaṭatām; ananataraṁ dūtastasyāḥ samīpāt pratasthē|</para>
  <para style="p">
    <verse number="39" style="v"/>atha katipayadināt paraṁ mariyam tasmāt parvvatamayapradēśīyayihūdāyā nagaramēkaṁ śīghraṁ gatvā</para>
  <para style="p">
    <verse number="40" style="v"/>sikhariyayājakasya gr̥haṁ praviśya tasya jāyām ilīśēvāṁ sambōdhyāvadat|</para>
  <para style="p">
    <verse number="41" style="v"/>tatō mariyamaḥ sambōdhanavākyē ilīśēvāyāḥ karṇayōḥ praviṣṭamātrē sati tasyā garbbhasthabālakō nanartta| tata ilīśēvā pavitrēṇātmanā paripūrṇā satī</para>
  <para style="p">
    <verse number="42" style="v"/>prōccairgaditumārēbhē, yōṣitāṁ madhyē tvamēva dhanyā, tava garbbhasthaḥ śiśuśca dhanyaḥ|</para>
  <para style="p">
    <verse number="43" style="v"/>tvaṁ prabhōrmātā, mama nivēśanē tvayā caraṇāvarpitau, mamādya saubhāgyamētat|</para>
  <para style="p">
    <verse number="44" style="v"/>paśya tava vākyē mama karṇayōḥ praviṣṭamātrē sati mamōdarasthaḥ śiśurānandān nanartta|</para>
  <para style="p">
    <verse number="45" style="v"/>yā strī vyaśvasīt sā dhanyā, yatō hētōstāṁ prati paramēśvarōktaṁ vākyaṁ sarvvaṁ siddhaṁ bhaviṣyati|</para>
  <para style="p">
    <verse number="46" style="v"/>tadānīṁ mariyam jagāda| dhanyavādaṁ parēśasya karōti māmakaṁ manaḥ|</para>
  <para style="p">
    <verse number="47" style="v"/>mamātmā tārakēśē ca samullāsaṁ pragacchati|</para>
  <para style="p">
    <verse number="48" style="v"/>akarōt sa prabhu rduṣṭiṁ svadāsyā durgatiṁ prati| paśyādyārabhya māṁ dhanyāṁ vakṣyanti puruṣāḥ sadā|</para>
  <para style="p">
    <verse number="49" style="v"/>yaḥ sarvvaśaktimān yasya nāmāpi ca pavitrakaṁ| sa ēva sumahatkarmma kr̥tavān mannimittakaṁ|</para>
  <para style="p">
    <verse number="50" style="v"/>yē bibhyati janāstasmāt tēṣāṁ santānapaṁktiṣu| anukampā tadīyā ca sarvvadaiva sutiṣṭhati|</para>
  <para style="p">
    <verse number="51" style="v"/>svabāhubalatastēna prākāśyata parākramaḥ| manaḥkumantraṇāsārddhaṁ vikīryyantē'bhimāninaḥ|</para>
  <para style="p">
    <verse number="52" style="v"/>siṁhāsanagatāllōkān balinaścāvarōhya saḥ| padēṣūccēṣu lōkāṁstu kṣudrān saṁsthāpayatyapi|</para>
  <para style="p">
    <verse number="53" style="v"/>kṣudhitān mānavān dravyairuttamaiḥ paritarpya saḥ| sakalān dhaninō lōkān visr̥jēd riktahastakān|</para>
  <para style="p">
    <verse number="54" style="v"/>ibrāhīmi ca tadvaṁśē yā dayāsti sadaiva tāṁ| smr̥tvā purā pitr̥ṇāṁ nō yathā sākṣāt pratiśrutaṁ|</para>
  <para style="p">
    <verse number="55" style="v"/>isrāyēlsēvakastēna tathōpakriyatē svayaṁ||</para>
  <para style="p">
    <verse number="56" style="v"/>anantaraṁ mariyam prāyēṇa māsatrayam ilīśēvayā sahōṣitvā vyāghuyya nijanivēśanaṁ yayau|</para>
  <para style="p">
    <verse number="57" style="v"/>tadanantaram ilīśēvāyāḥ prasavakāla upasthitē sati sā putraṁ prāsōṣṭa|</para>
  <para style="p">
    <verse number="58" style="v"/>tataḥ paramēśvarastasyāṁ mahānugrahaṁ kr̥tavān ētat śrutvā samīpavāsinaḥ kuṭumbāścāgatya tayā saha mumudirē|</para>
  <para style="p">
    <verse number="59" style="v"/>tathāṣṭamē dinē tē bālakasya tvacaṁ chēttum ētya tasya pitr̥nāmānurūpaṁ tannāma sikhariya iti karttumīṣuḥ|</para>
  <para style="p">
    <verse number="60" style="v"/>kintu tasya mātākathayat tanna, nāmāsya yōhan iti karttavyam|</para>
  <para style="p">
    <verse number="61" style="v"/>tadā tē vyāharan tava vaṁśamadhyē nāmēdr̥śaṁ kasyāpi nāsti|</para>
  <para style="p">
    <verse number="62" style="v"/>tataḥ paraṁ tasya pitaraṁ sikhariyaṁ prati saṅkētya papracchuḥ śiśōḥ kiṁ nāma kāriṣyatē?</para>
  <para style="p">
    <verse number="63" style="v"/>tataḥ sa phalakamēkaṁ yācitvā lilēkha tasya nāma yōhan bhaviṣyati| tasmāt sarvvē āścaryyaṁ mēnirē|</para>
  <para style="p">
    <verse number="64" style="v"/>tatkṣaṇaṁ sikhariyasya jihvājāḍyē'pagatē sa mukhaṁ vyādāya spaṣṭavarṇamuccāryya īśvarasya guṇānuvādaṁ cakāra|</para>
  <para style="p">
    <verse number="65" style="v"/>tasmāccaturdiksthāḥ samīpavāsilōkā bhītā ēvamētāḥ sarvvāḥ kathā yihūdāyāḥ parvvatamayapradēśasya sarvvatra pracāritāḥ|</para>
  <para style="p">
    <verse number="66" style="v"/>tasmāt śrōtārō manaḥsu sthāpayitvā kathayāmbabhūvuḥ kīdr̥śōyaṁ bālō bhaviṣyati? atha paramēśvarastasya sahāyōbhūt|</para>
  <para style="p">
    <verse number="67" style="v"/>tadā yōhanaḥ pitā sikhariyaḥ pavitrēṇātmanā paripūrṇaḥ san ētādr̥śaṁ bhaviṣyadvākyaṁ kathayāmāsa|</para>
  <para style="p">
    <verse number="68" style="v"/>isrāyēlaḥ prabhu ryastu sa dhanyaḥ paramēśvaraḥ| anugr̥hya nijāllōkān sa ēva parimōcayēt|</para>
  <para style="p">
    <verse number="69" style="v"/>vipakṣajanahastēbhyō yathā mōcyāmahē vayaṁ| yāvajjīvañca dharmmēṇa sāralyēna ca nirbhayāḥ|</para>
  <para style="p">
    <verse number="70" style="v"/>sēvāmahai tamēvaikam ētatkāraṇamēva ca| svakīyaṁ supavitrañca saṁsmr̥tya niyamaṁ sadā|</para>
  <para style="p">
    <verse number="71" style="v"/>kr̥payā puruṣān pūrvvān nikaṣārthāttu naḥ pituḥ| ibrāhīmaḥ samīpē yaṁ śapathaṁ kr̥tavān purā|</para>
  <para style="p">
    <verse number="72" style="v"/>tamēva saphalaṁ karttaṁ tathā śatrugaṇasya ca| r̥ृtīyākāriṇaścaiva karēbhyō rakṣaṇāya naḥ|</para>
  <para style="p">
    <verse number="73" style="v"/>sr̥ṣṭēḥ prathamataḥ svīyaiḥ pavitrai rbhāvivādibhiḥ|</para>
  <para style="p">
    <verse number="74" style="v"/>yathōktavān tathā svasya dāyūdaḥ sēvakasya tu|</para>
  <para style="p">
    <verse number="75" style="v"/>vaṁśē trātāramēkaṁ sa samutpāditavān svayam|</para>
  <para style="p">
    <verse number="76" style="v"/>atō hē bālaka tvantu sarvvēbhyaḥ śrēṣṭha ēva yaḥ| tasyaiva bhāvivādīti pravikhyātō bhaviṣyasi| asmākaṁ caraṇān kṣēmē mārgē cālayituṁ sadā| ēvaṁ dhvāntē'rthatō mr̥tyōśchāyāyāṁ yē tu mānavāḥ|</para>
  <para style="p">
    <verse number="77" style="v"/>upaviṣṭāstu tānēva prakāśayitumēva hi| kr̥tvā mahānukampāṁ hi yāmēva paramēśvaraḥ|</para>
  <para style="p">
    <verse number="78" style="v"/>ūrdvvāt sūryyamudāyyaivāsmabhyaṁ prādāttu darśanaṁ| tayānukampayā svasya lōkānāṁ pāpamōcanē|</para>
  <para style="p">
    <verse number="79" style="v"/>paritrāṇasya tēbhyō hi jñānaviśrāṇanāya ca| prabhō rmārgaṁ pariṣkarttuṁ tasyāgrāyī bhaviṣyasi||</para>
  <para style="p">
    <verse number="80" style="v"/>atha bālakaḥ śarīrēṇa buddhyā ca varddhitumārēbhē; aparañca sa isrāyēlō vaṁśīyalōkānāṁ samīpē yāvanna prakaṭībhūtastāstāvat prāntarē nyavasat|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>aparañca tasmin kālē rājyasya sarvvēṣāṁ lōkānāṁ nāmāni lēkhayitum agastakaisara ājñāpayāmāsa|</para>
  <para style="p">
    <verse number="2" style="v"/>tadanusārēṇa kurīṇiyanāmani suriyādēśasya śāsakē sati nāmalēkhanaṁ prārēbhē|</para>
  <para style="p">
    <verse number="3" style="v"/>atō hētō rnāma lēkhituṁ sarvvē janāḥ svīyaṁ svīyaṁ nagaraṁ jagmuḥ|</para>
  <para style="p">
    <verse number="4" style="v"/>tadānīṁ yūṣaph nāma lēkhituṁ vāgdattayā svabhāryyayā garbbhavatyā mariyamā saha svayaṁ dāyūdaḥ sajātivaṁśa iti kāraṇād gālīlpradēśasya nāsaratnagarād</para>
  <para style="p">
    <verse number="5" style="v"/>yihūdāpradēśasya baitlēhamākhyaṁ dāyūdnagaraṁ jagāma|</para>
  <para style="p">
    <verse number="6" style="v"/>anyacca tatra sthānē tayōstiṣṭhatōḥ satō rmariyamaḥ prasūtikāla upasthitē</para>
  <para style="p">
    <verse number="7" style="v"/>sā taṁ prathamasutaṁ prāsōṣṭa kintu tasmin vāsagr̥hē sthānābhāvād bālakaṁ vastrēṇa vēṣṭayitvā gōśālāyāṁ sthāpayāmāsa|</para>
  <para style="p">
    <verse number="8" style="v"/>anantaraṁ yē kiyantō mēṣapālakāḥ svamēṣavrajarakṣāyai tatpradēśē sthitvā rajanyāṁ prāntarē prahariṇaḥ karmma kurvvanti,</para>
  <para style="p">
    <verse number="9" style="v"/>tēṣāṁ samīpaṁ paramēśvarasya dūta āgatyōpatasthau; tadā catuṣpārśvē paramēśvarasya tējasaḥ prakāśitatvāt tē'tiśaśaṅkirē|</para>
  <para style="p">
    <verse number="10" style="v"/>tadā sa dūta uvāca mā bhaiṣṭa paśyatādya dāyūdaḥ purē yuṣmannimittaṁ trātā prabhuḥ khrīṣṭō'janiṣṭa,</para>
  <para style="p">
    <verse number="11" style="v"/>sarvvēṣāṁ lōkānāṁ mahānandajanakam imaṁ maṅgalavr̥ttāntaṁ yuṣmān jñāpayāmi|</para>
  <para style="p">
    <verse number="12" style="v"/>yūyaṁ (tatsthānaṁ gatvā) vastravēṣṭitaṁ taṁ bālakaṁ gōśālāyāṁ śayanaṁ drakṣyatha yuṣmān pratīdaṁ cihnaṁ bhaviṣyati|</para>
  <para style="p">
    <verse number="13" style="v"/>dūta imāṁ kathāṁ kathitavati tatrākasmāt svargīyāḥ pr̥tanā āgatya kathām imāṁ kathayitvēśvarasya guṇānanvavādiṣuḥ, yathā,</para>
  <para style="p">
    <verse number="14" style="v"/>sarvvōrdvvasthairīśvarasya mahimā samprakāśyatāṁ| śāntirbhūyāt pr̥thivyāstu santōṣaśca narān prati||</para>
  <para style="p">
    <verse number="15" style="v"/>tataḥ paraṁ tēṣāṁ sannidhē rdūtagaṇē svargaṁ gatē mēṣapālakāḥ parasparam avēcan āgacchata prabhuḥ paramēśvarō yāṁ ghaṭanāṁ jñāpitavān tasyā yātharyaṁ jñātuṁ vayamadhunā baitlēhampuraṁ yāmaḥ|</para>
  <para style="p">
    <verse number="16" style="v"/>paścāt tē tūrṇaṁ vrajitvā mariyamaṁ yūṣaphaṁ gōśālāyāṁ śayanaṁ bālakañca dadr̥śuḥ|</para>
  <para style="p">
    <verse number="17" style="v"/>itthaṁ dr̥ṣṭvā bālakasyārthē prōktāṁ sarvvakathāṁ tē prācārayāñcakruḥ|</para>
  <para style="p">
    <verse number="18" style="v"/>tatō yē lōkā mēṣarakṣakāṇāṁ vadanēbhyastāṁ vārttāṁ śuśruvustē mahāścaryyaṁ mēnirē|</para>
  <para style="p">
    <verse number="19" style="v"/>kintu mariyam ētatsarvvaghaṭanānāṁ tātparyyaṁ vivicya manasi sthāpayāmāsa|</para>
  <para style="p">
    <verse number="20" style="v"/>tatpaścād dūtavijñaptānurūpaṁ śrutvā dr̥ṣṭvā ca mēṣapālakā īśvarasya guṇānuvādaṁ dhanyavādañca kurvvāṇāḥ parāvr̥tya yayuḥ|</para>
  <para style="p">
    <verse number="21" style="v"/>atha bālakasya tvakchēdanakālē'ṣṭamadivasē samupasthitē tasya garbbhasthitēḥ purvvaṁ svargīyadūtō yathājñāpayat tadanurūpaṁ tē tannāmadhēyaṁ yīśuriti cakrirē|</para>
  <para style="p">
    <verse number="22" style="v"/>tataḥ paraṁ mūsālikhitavyavasthāyā anusārēṇa mariyamaḥ śucitvakāla upasthitē,</para>
  <para style="p">
    <verse number="23" style="v"/>"prathamajaḥ sarvvaḥ puruṣasantānaḥ paramēśvarē samarpyatāṁ," iti paramēśvarasya vyavasthayā</para>
  <para style="p">
    <verse number="24" style="v"/>yīśuṁ paramēśvarē samarpayitum śāstrīyavidhyuktaṁ kapōtadvayaṁ pārāvataśāvakadvayaṁ vā baliṁ dātuṁ tē taṁ gr̥hītvā yirūśālamam āyayuḥ|</para>
  <para style="p">
    <verse number="25" style="v"/>yirūśālampuranivāsī śimiyōnnāmā dhārmmika ēka āsīt sa isrāyēlaḥ sāntvanāmapēkṣya tasthau kiñca pavitra ātmā tasminnāvirbhūtaḥ|</para>
  <para style="p">
    <verse number="26" style="v"/>aparaṁ prabhuṇā paramēśvarēṇābhiṣiktē trātari tvayā na dr̥ṣṭē tvaṁ na mariṣyasīti vākyaṁ pavitrēṇa ātmanā tasma prākathyata|</para>
  <para style="p">
    <verse number="27" style="v"/>aparañca yadā yīśōḥ pitā mātā ca tadarthaṁ vyavasthānurūpaṁ karmma karttuṁ taṁ mandiram āninyatustadā</para>
  <para style="p">
    <verse number="28" style="v"/>śimiyōn ātmana ākarṣaṇēna mandiramāgatya taṁ krōḍē nidhāya īśvarasya dhanyavādaṁ kr̥tvā kathayāmāsa, yathā,</para>
  <para style="p">
    <verse number="29" style="v"/>hē prabhō tava dāsōyaṁ nijavākyānusārataḥ| idānīntu sakalyāṇō bhavatā saṁvisr̥jyatām|</para>
  <para style="p">
    <verse number="30" style="v"/>yataḥ sakaladēśasya dīptayē dīptirūpakaṁ|</para>
  <para style="p">
    <verse number="31" style="v"/>isrāyēlīyalōkasya mahāgauravarūpakaṁ|</para>
  <para style="p">
    <verse number="32" style="v"/>yaṁ trāyakaṁ janānāntu sammukhē tvamajījanaḥ| saēva vidyatē'smākaṁ dhravaṁ nayananagōcarē||</para>
  <para style="p">
    <verse number="33" style="v"/>tadānīṁ tēnōktā ētāḥ sakalāḥ kathāḥ śrutvā tasya mātā yūṣaph ca vismayaṁ mēnātē|</para>
  <para style="p">
    <verse number="34" style="v"/>tataḥ paraṁ śimiyōn tēbhya āśiṣaṁ dattvā tanmātaraṁ mariyamam uvāca, paśya isrāyēlō vaṁśamadhyē bahūnāṁ pātanāyōtthāpanāya ca tathā virōdhapātraṁ bhavituṁ, bahūnāṁ guptamanōgatānāṁ prakaṭīkaraṇāya bālakōyaṁ niyuktōsti|</para>
  <para style="p">
    <verse number="35" style="v"/>tasmāt tavāpi prāṇāḥ śūlēna vyatsyantē|</para>
  <para style="p">
    <verse number="36" style="v"/>aparañca āśērasya vaṁśīyaphinūyēlō duhitā hannākhyā atijaratī bhaviṣyadvādinyēkā yā vivāhāt paraṁ sapta vatsarān patyā saha nyavasat tatō vidhavā bhūtvā caturaśītivarṣavayaḥparyyanataṁ</para>
  <para style="p">
    <verse number="37" style="v"/>mandirē sthitvā prārthanōpavāsairdivāniśam īśvaram asēvata sāpi strī tasmin samayē mandiramāgatya</para>
  <para style="p">
    <verse number="38" style="v"/>paramēśvarasya dhanyavādaṁ cakāra, yirūśālampuravāsinō yāvantō lōkā muktimapēkṣya sthitāstān yīśōrvr̥ttāntaṁ jñāpayāmāsa|</para>
  <para style="p">
    <verse number="39" style="v"/>itthaṁ paramēśvarasya vyavasthānusārēṇa sarvvēṣu karmmasu kr̥tēṣu tau punaśca gālīlō nāsaratnāmakaṁ nijanagaraṁ pratasthātē|</para>
  <para style="p">
    <verse number="40" style="v"/>tatpaścād bālakaḥ śarīrēṇa vr̥ddhimētya jñānēna paripūrṇa ātmanā śaktimāṁśca bhavitumārēbhē tathā tasmin īśvarānugrahō babhūva|</para>
  <para style="p">
    <verse number="41" style="v"/>tasya pitā mātā ca prativarṣaṁ nistārōtsavasamayē yirūśālamam agacchatām|</para>
  <para style="p">
    <verse number="42" style="v"/>aparañca yīśau dvādaśavarṣavayaskē sati tau parvvasamayasya rītyanusārēṇa yirūśālamaṁ gatvā</para>
  <para style="p">
    <verse number="43" style="v"/>pārvvaṇaṁ sampādya punarapi vyāghuyya yātaḥ kintu yīśurbālakō yirūśālami tiṣṭhati| yūṣaph tanmātā ca tad aviditvā</para>
  <para style="p">
    <verse number="44" style="v"/>sa saṅgibhiḥ saha vidyata ētacca budvvā dinaikagamyamārgaṁ jagmatuḥ| kintu śēṣē jñātibandhūnāṁ samīpē mr̥gayitvā taduddēेśamaprāpya</para>
  <para style="p">
    <verse number="45" style="v"/>tau punarapi yirūśālamam parāvr̥tyāgatya taṁ mr̥gayāñcakratuḥ|</para>
  <para style="p">
    <verse number="46" style="v"/>atha dinatrayāt paraṁ paṇḍitānāṁ madhyē tēṣāṁ kathāḥ śr̥ṇvan tattvaṁ pr̥cchaṁśca mandirē samupaviṣṭaḥ sa tābhyāṁ dr̥ṣṭaḥ|</para>
  <para style="p">
    <verse number="47" style="v"/>tadā tasya buddhyā pratyuttaraiśca sarvvē śrōtārō vismayamāpadyantē|</para>
  <para style="p">
    <verse number="48" style="v"/>tādr̥śaṁ dr̥ṣṭvā tasya janakō jananī ca camaccakratuḥ kiñca tasya mātā tamavadat, hē putra, kathamāvāṁ pratītthaṁ samācarastvam? paśya tava pitāhañca śōkākulau santau tvāmanvicchāvaḥ sma|</para>
  <para style="p">
    <verse number="49" style="v"/>tataḥ sōvadat kutō mām anvaicchataṁ? piturgr̥hē mayā sthātavyam ētat kiṁ yuvābhyāṁ na jñāyatē?</para>
  <para style="p">
    <verse number="50" style="v"/>kintu tau tasyaitadvākyasya tātparyyaṁ bōddhuṁ nāśaknutāṁ|</para>
  <para style="p">
    <verse number="51" style="v"/>tataḥ paraṁ sa tābhyāṁ saha nāsarataṁ gatvā tayōrvaśībhūtastasthau kintu sarvvā ētāḥ kathāstasya mātā manasi sthāpayāmāsa|</para>
  <para style="p">
    <verse number="52" style="v"/>atha yīśō rbuddhiḥ śarīrañca tathā tasmin īśvarasya mānavānāñcānugrahō varddhitum ārēbhē|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ tibiriyakaisarasya rājatvasya pañcadaśē vatsarē sati yadā pantīyapīlātō yihūdādēśādhipati rhērōd tu gālīlpradēśasya rājā philipanāmā tasya bhrātā tu yitūriyāyāstrākhōnītiyāpradēśasya ca rājāsīt luṣānīyanāmā avilīnīdēśasya rājāsīt</para>
  <para style="p">
    <verse number="2" style="v"/>hānan kiyaphāścēmau pradhānayājākāvāstāṁ tadānīṁ sikhariyasya putrāya yōhanē madhyēprāntaram īśvarasya vākyē prakāśitē sati</para>
  <para style="p">
    <verse number="3" style="v"/>sa yarddana ubhayataṭapradēśān samētya pāpamōcanārthaṁ manaḥparāvarttanasya cihnarūpaṁ yanmajjanaṁ tadīyāḥ kathāḥ sarvvatra pracārayitumārēbhē|</para>
  <para style="p">
    <verse number="4" style="v"/>yiśayiyabhaviṣyadvaktr̥granthē yādr̥śī lipirāstē yathā, paramēśasya panthānaṁ pariṣkuruta sarvvataḥ| tasya rājapathañcaiva samānaṁ kurutādhunā|</para>
  <para style="p">
    <verse number="5" style="v"/>kāriṣyantē samucchrāyāḥ sakalā nimnabhūmayaḥ| kāriṣyantē natāḥ sarvvē parvvatāścōpaparvvatāḥ| kāriṣyantē ca yā vakrāstāḥ sarvvāḥ saralā bhuvaḥ| kāriṣyantē samānāstā yā uccanīcabhūmayaḥ|</para>
  <para style="p">
    <verse number="6" style="v"/>īśvarēṇa kr̥taṁ trāṇaṁ drakṣyanti sarvvamānavāḥ| ityētat prāntarē vākyaṁ vadataḥ kasyacid ravaḥ||</para>
  <para style="p">
    <verse number="7" style="v"/>yē yē lōkā majjanārthaṁ bahirāyayustān sōvadat rē rē sarpavaṁśā āgāminaḥ kōpāt palāyituṁ yuṣmān kaścētayāmāsa?</para>
  <para style="p">
    <verse number="8" style="v"/>tasmād ibrāhīm asmākaṁ pitā kathāmīdr̥śīṁ manōbhi rna kathayitvā yūyaṁ manaḥparivarttanayōgyaṁ phalaṁ phalata; yuṣmānahaṁ yathārthaṁ vadāmi pāṣāṇēbhya ētēbhya īśvara ibrāhīmaḥ santānōtpādanē samarthaḥ|</para>
  <para style="p">
    <verse number="9" style="v"/>aparañca tarumūlē'dhunāpi paraśuḥ saṁlagnōsti yastaruruttamaṁ phalaṁ na phalati sa chidyatē'gnau nikṣipyatē ca|</para>
  <para style="p">
    <verse number="10" style="v"/>tadānīṁ lōkāstaṁ papracchustarhi kiṁ karttavyamasmābhiḥ?</para>
  <para style="p">
    <verse number="11" style="v"/>tataḥ sōvādīt yasya dvē vasanē vidyētē sa vastrahīnāyaikaṁ vitaratu kiṁñca yasya khādyadravyaṁ vidyatē sōpi tathaiva karōtu|</para>
  <para style="p">
    <verse number="12" style="v"/>tataḥ paraṁ karasañcāyinō majjanārtham āgatya papracchuḥ hē gurō kiṁ karttavyamasmābhiḥ?</para>
  <para style="p">
    <verse number="13" style="v"/>tataḥ sōkathayat nirūpitādadhikaṁ na gr̥hlita|</para>
  <para style="p">
    <verse number="14" style="v"/>anantaraṁ sēnāgaṇa ētya papraccha kimasmābhi rvā karttavyam? tataḥ sōbhidadhē kasya kāmapi hāniṁ mā kārṣṭa tathā mr̥ṣāpavādaṁ mā kuruta nijavētanēna ca santuṣya tiṣṭhata|</para>
  <para style="p">
    <verse number="15" style="v"/>aparañca lōkā apēkṣayā sthitvā sarvvēpīti manōbhi rvitarkayāñcakruḥ, yōhanayam abhiṣiktastrātā na vēti?</para>
  <para style="p">
    <verse number="16" style="v"/>tadā yōhan sarvvān vyājahāra, jalē'haṁ yuṣmān majjayāmi satyaṁ kintu yasya pādukābandhanaṁ mōcayitumapi na yōgyōsmi tādr̥śa ēkō mattō gurutaraḥ pumān ēti, sa yuṣmān vahnirūpē pavitra ātmani majjayiṣyati|</para>
  <para style="p">
    <verse number="17" style="v"/>aparañca tasya hastē śūrpa āstē sa svaśasyāni śuddharūpaṁ prasphōṭya gōdhūmān sarvvān bhāṇḍāgārē saṁgrahīṣyati kintu būṣāṇi sarvvāṇyanirvvāṇavahninā dāhayiṣyati|</para>
  <para style="p">
    <verse number="18" style="v"/>yōhan upadēśēnētthaṁ nānākathā lōkānāṁ samakṣaṁ pracārayāmāsa|</para>
  <para style="p">
    <verse number="19" style="v"/>aparañca hērōd rājā philipnāmnaḥ sahōdarasya bhāryyāṁ hērōdiyāmadhi tathānyāni yāni yāni kukarmmāṇi kr̥tavān tadadhi ca</para>
  <para style="p">
    <verse number="20" style="v"/>yōhanā tiraskr̥tō bhūtvā kārāgārē tasya bandhanād aparamapi kukarmma cakāra|</para>
  <para style="p">
    <verse number="21" style="v"/>itaḥ pūrvvaṁ yasmin samayē sarvvē yōhanā majjitāstadānīṁ yīśurapyāgatya majjitaḥ|</para>
  <para style="p">
    <verse number="22" style="v"/>tadanantaraṁ tēna prārthitē mēghadvāraṁ muktaṁ tasmācca pavitra ātmā mūrttimān bhūtvā kapōtavat taduparyyavarurōha; tadā tvaṁ mama priyaḥ putrastvayi mama paramaḥ santōṣa ityākāśavāṇī babhūva|</para>
  <para style="p">
    <verse number="23" style="v"/>tadānīṁ yīśuḥ prāyēṇa triṁśadvarṣavayaska āsīt| laukikajñānē tu sa yūṣaphaḥ putraḥ,</para>
  <para style="p">
    <verse number="24" style="v"/>yūṣaph ēlēḥ putraḥ, ēlirmattataḥ putraḥ, mattat lēvēḥ putraḥ, lēvi rmalkēḥ putraḥ, malkiryānnasya putraḥ; yānnō yūṣaphaḥ putraḥ|</para>
  <para style="p">
    <verse number="25" style="v"/>yūṣaph mattathiyasya putraḥ, mattathiya āmōsaḥ putraḥ, āmōs nahūmaḥ putraḥ, nahūm iṣlēḥ putraḥ iṣlirnagēḥ putraḥ|</para>
  <para style="p">
    <verse number="26" style="v"/>nagirmāṭaḥ putraḥ, māṭ mattathiyasya putraḥ, mattathiyaḥ śimiyēḥ putraḥ, śimiyiryūṣaphaḥ putraḥ, yūṣaph yihūdāḥ putraḥ|</para>
  <para style="p">
    <verse number="27" style="v"/>yihūdā yōhānāḥ putraḥ, yōhānā rīṣāḥ putraḥ, rīṣāḥ sirubbābilaḥ putraḥ, sirubbābil śaltīyēlaḥ putraḥ, śaltīyēl nērēḥ putraḥ|</para>
  <para style="p">
    <verse number="28" style="v"/>nērirmalkēḥ putraḥ, malkiḥ adyaḥ putraḥ, addī kōṣamaḥ putraḥ, kōṣam ilmōdadaḥ putraḥ, ilmōdad ēraḥ putraḥ|</para>
  <para style="p">
    <verse number="29" style="v"/>ēr yōśēḥ putraḥ, yōśiḥ ilīyēṣaraḥ putraḥ, ilīyēṣar yōrīmaḥ putraḥ, yōrīm mattataḥ putraḥ, mattata lēvēḥ putraḥ|</para>
  <para style="p">
    <verse number="30" style="v"/>lēviḥ śimiyōnaḥ putraḥ, śimiyōn yihūdāḥ putraḥ, yihūdā yūṣuphaḥ putraḥ, yūṣuph yōnanaḥ putraḥ, yānan ilīyākīmaḥ putraḥ|</para>
  <para style="p">
    <verse number="31" style="v"/>iliyākīmḥ milēyāḥ putraḥ, milēyā mainanaḥ putraḥ, mainan mattattasya putraḥ, mattattō nāthanaḥ putraḥ, nāthan dāyūdaḥ putraḥ|</para>
  <para style="p">
    <verse number="32" style="v"/>dāyūd yiśayaḥ putraḥ, yiśaya ōbēdaḥ putra, ōbēd bōyasaḥ putraḥ, bōyas salmōnaḥ putraḥ, salmōn nahaśōnaḥ putraḥ|</para>
  <para style="p">
    <verse number="33" style="v"/>nahaśōn ammīnādabaḥ putraḥ, ammīnādab arāmaḥ putraḥ, arām hiṣrōṇaḥ putraḥ, hiṣrōṇ pērasaḥ putraḥ, pēras yihūdāḥ putraḥ|</para>
  <para style="p">
    <verse number="34" style="v"/>yihūdā yākūbaḥ putraḥ, yākūb ishākaḥ putraḥ, ishāk ibrāhīmaḥ putraḥ, ibrāhīm tērahaḥ putraḥ, tērah nāhōraḥ putraḥ|</para>
  <para style="p">
    <verse number="35" style="v"/>nāhōr sirugaḥ putraḥ, sirug riyvaḥ putraḥ, riyūḥ pēlagaḥ putraḥ, pēlag ēvaraḥ putraḥ, ēvar śēlahaḥ putraḥ|</para>
  <para style="p">
    <verse number="36" style="v"/>śēlah kainanaḥ putraḥ, kainan arphakṣadaḥ putraḥ, arphakṣad śāmaḥ putraḥ, śām nōhaḥ putraḥ, nōhō lēmakaḥ putraḥ|</para>
  <para style="p">
    <verse number="37" style="v"/>lēmak mithūśēlahaḥ putraḥ, mithūśēlah hanōkaḥ putraḥ, hanōk yēradaḥ putraḥ, yērad mahalalēlaḥ putraḥ, mahalalēl kainanaḥ putraḥ|</para>
  <para style="p">
    <verse number="38" style="v"/>kainan inōśaḥ putraḥ, inōś śētaḥ putraḥ, śēt ādamaḥ putra, ādam īśvarasya putraḥ|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tataḥ paraṁ yīśuḥ pavitrēṇātmanā pūrṇaḥ san yarddananadyāḥ parāvr̥tyātmanā prāntaraṁ nītaḥ san catvāriṁśaddināni yāvat śaitānā parīkṣitō'bhūt,</para>
  <para style="p">
    <verse number="2" style="v"/>kiñca tāni sarvvadināni bhōjanaṁ vinā sthitatvāt kālē pūrṇē sa kṣudhitavān|</para>
  <para style="p">
    <verse number="3" style="v"/>tataḥ śaitānāgatya tamavadat tvaṁ cēdīśvarasya putrastarhi prastarānētān ājñayā pūpān kuru|</para>
  <para style="p">
    <verse number="4" style="v"/>tadā yīśuruvāca, lipirīdr̥śī vidyatē manujaḥ kēvalēna pūpēna na jīvati kintvīśvarasya sarvvābhirājñābhi rjīvati|</para>
  <para style="p">
    <verse number="5" style="v"/>tadā śaitān tamuccaṁ parvvataṁ nītvā nimiṣaikamadhyē jagataḥ sarvvarājyāni darśitavān|</para>
  <para style="p">
    <verse number="6" style="v"/>paścāt tamavādīt sarvvam ētad vibhavaṁ pratāpañca tubhyaṁ dāsyāmi tan mayi samarpitamāstē yaṁ prati mamēcchā jāyatē tasmai dātuṁ śaknōmi,</para>
  <para style="p">
    <verse number="7" style="v"/>tvaṁ cēnmāṁ bhajasē tarhi sarvvamētat tavaiva bhaviṣyati|</para>
  <para style="p">
    <verse number="8" style="v"/>tadā yīśustaṁ pratyuktavān dūrī bhava śaitān lipirāstē, nijaṁ prabhuṁ paramēśvaraṁ bhajasva kēvalaṁ tamēva sēvasva ca|</para>
  <para style="p">
    <verse number="9" style="v"/>atha śaitān taṁ yirūśālamaṁ nītvā mandirasya cūḍāyā upari samupavēśya jagāda tvaṁ cēdīśvarasya putrastarhi sthānāditō lamphitvādhaḥ</para>
  <para style="p">
    <verse number="10" style="v"/>pata yatō lipirāstē, ājñāpayiṣyati svīyān dūtān sa paramēśvaraḥ|</para>
  <para style="p">
    <verse number="11" style="v"/>rakṣituṁ sarvvamārgē tvāṁ tēna tvaccaraṇē yathā| na lagēt prastarāghātastvāṁ dhariṣyanti tē tathā|</para>
  <para style="p">
    <verse number="12" style="v"/>tadā yīśunā pratyuktam idamapyuktamasti tvaṁ svaprabhuṁ parēśaṁ mā parīkṣasva|</para>
  <para style="p">
    <verse number="13" style="v"/>paścāt śaitān sarvvaparīkṣāṁ samāpya kṣaṇāttaṁ tyaktvā yayau|</para>
  <para style="p">
    <verse number="14" style="v"/>tadā yīśurātmaprabhāvāt punargālīlpradēśaṁ gatastadā tatsukhyātiścaturdiśaṁ vyānaśē|</para>
  <para style="p">
    <verse number="15" style="v"/>sa tēṣāṁ bhajanagr̥hēṣu upadiśya sarvvaiḥ praśaṁsitō babhūva|</para>
  <para style="p">
    <verse number="16" style="v"/>atha sa svapālanasthānaṁ nāsaratpuramētya viśrāmavārē svācārād bhajanagēhaṁ praviśya paṭhitumuttasthau|</para>
  <para style="p">
    <verse number="17" style="v"/>tatō yiśayiyabhaviṣyadvādinaḥ pustakē tasya karadattē sati sa tat pustakaṁ vistāryya yatra vakṣyamāṇāni vacanāni santi tat sthānaṁ prāpya papāṭha|</para>
  <para style="p">
    <verse number="18" style="v"/>ātmā tu paramēśasya madīyōpari vidyatē| daridrēṣu susaṁvādaṁ vaktuṁ māṁ sōbhiṣiktavān| bhagnāntaḥ karaṇāllōkān susvasthān karttumēva ca| bandīkr̥tēṣu lōkēṣu muktē rghōṣayituṁ vacaḥ| nētrāṇi dātumandhēbhyastrātuṁ baddhajanānapi|</para>
  <para style="p">
    <verse number="19" style="v"/>parēśānugrahē kālaṁ pracārayitumēva ca| sarvvaitatkaraṇārthāya māmēva prahiṇōti saḥ||</para>
  <para style="p">
    <verse number="20" style="v"/>tataḥ pustakaṁ badvvā paricārakasya hastē samarpya cāsanē samupaviṣṭaḥ, tatō bhajanagr̥hē yāvantō lōkā āsan tē sarvvē'nanyadr̥ṣṭyā taṁ vilulōkirē|</para>
  <para style="p">
    <verse number="21" style="v"/>anantaram adyaitāni sarvvāṇi likhitavacanāni yuṣmākaṁ madhyē siddhāni sa imāṁ kathāṁ tēbhyaḥ kathayitumārēbhē|</para>
  <para style="p">
    <verse number="22" style="v"/>tataḥ sarvvē tasmin anvarajyanta, kiñca tasya mukhānnirgatābhiranugrahasya kathābhiścamatkr̥tya kathayāmāsuḥ kimayaṁ yūṣaphaḥ putrō na?</para>
  <para style="p">
    <verse number="23" style="v"/>tadā sō'vādīd hē cikitsaka svamēva svasthaṁ kuru kapharnāhūmi yadyat kr̥tavān tadaśrauṣma tāḥ sarvāḥ kriyā atra svadēśē kuru kathāmētāṁ yūyamēvāvaśyaṁ māṁ vadiṣyatha|</para>
  <para style="p">
    <verse number="24" style="v"/>punaḥ sōvādīd yuṣmānahaṁ yathārthaṁ vadāmi, kōpi bhaviṣyadvādī svadēśē satkāraṁ na prāpnōti|</para>
  <para style="p">
    <verse number="25" style="v"/>aparañca yathārthaṁ vacmi, ēliyasya jīvanakālē yadā sārddhatritayavarṣāṇi yāvat jaladapratibandhāt sarvvasmin dēśē mahādurbhikṣam ajaniṣṭa tadānīm isrāyēlō dēśasya madhyē bahvyō vidhavā āsan,</para>
  <para style="p">
    <verse number="26" style="v"/>kintu sīdōnpradēśīyasāriphatpuranivāsinīm ēkāṁ vidhavāṁ vinā kasyāścidapi samīpē ēliyaḥ prēritō nābhūt|</para>
  <para style="p">
    <verse number="27" style="v"/>aparañca ilīśāyabhaviṣyadvādividyamānatākālē isrāyēldēśē bahavaḥ kuṣṭhina āsan kintu surīyadēśīyaṁ nāmānkuṣṭhinaṁ vinā kōpyanyaḥ pariṣkr̥tō nābhūt|</para>
  <para style="p">
    <verse number="28" style="v"/>imāṁ kathāṁ śrutvā bhajanagēhasthitā lōkāḥ sakrōdham utthāya</para>
  <para style="p">
    <verse number="29" style="v"/>nagarāttaṁ bahiṣkr̥tya yasya śikhariṇa upari tēṣāṁ nagaraṁ sthāpitamāstē tasmānnikṣēptuṁ tasya śikharaṁ taṁ ninyuḥ</para>
  <para style="p">
    <verse number="30" style="v"/>kintu sa tēṣāṁ madhyādapasr̥tya sthānāntaraṁ jagāma|</para>
  <para style="p">
    <verse number="31" style="v"/>tataḥ paraṁ yīśurgālīlpradēśīyakapharnāhūmnagara upasthāya viśrāmavārē lōkānupadēṣṭum ārabdhavān|</para>
  <para style="p">
    <verse number="32" style="v"/>tadupadēśāt sarvvē camaccakru ryatastasya kathā gurutarā āsan|</para>
  <para style="p">
    <verse number="33" style="v"/>tadānīṁ tadbhajanagēhasthitō'mēdhyabhūtagrasta ēkō jana uccaiḥ kathayāmāsa,</para>
  <para style="p">
    <verse number="34" style="v"/>hē nāsaratīyayīśō'smān tyaja, tvayā sahāsmākaṁ kaḥ sambandhaḥ? kimasmān vināśayitumāyāsi? tvamīśvarasya pavitrō jana ētadahaṁ jānāmi|</para>
  <para style="p">
    <verse number="35" style="v"/>tadā yīśustaṁ tarjayitvāvadat maunī bhava itō bahirbhava; tataḥ sōmēdhyabhūtastaṁ madhyasthānē pātayitvā kiñcidapyahiṁsitvā tasmād bahirgatavān|</para>
  <para style="p">
    <verse number="36" style="v"/>tataḥ sarvvē lōkāścamatkr̥tya parasparaṁ vaktumārēbhirē kōyaṁ camatkāraḥ| ēṣa prabhāvēṇa parākramēṇa cāmēdhyabhūtān ājñāpayati tēnaiva tē bahirgacchanti|</para>
  <para style="p">
    <verse number="37" style="v"/>anantaraṁ caturdiksthadēśān tasya sukhyātirvyāpnōt|</para>
  <para style="p">
    <verse number="38" style="v"/>tadanantaraṁ sa bhajanagēhād bahirāgatya śimōnō nivēśanaṁ pravivēśa tadā tasya śvaśrūrjvarēṇātyantaṁ pīḍitāsīt śiṣyāstadarthaṁ tasmin vinayaṁ cakruḥ|</para>
  <para style="p">
    <verse number="39" style="v"/>tataḥ sa tasyāḥ samīpē sthitvā jvaraṁ tarjayāmāsa tēnaiva tāṁ jvarō'tyākṣīt tataḥ sā tatkṣaṇam utthāya tān siṣēvē|</para>
  <para style="p">
    <verse number="40" style="v"/>atha sūryyāstakālē svēṣāṁ yē yē janā nānārōgaiḥ pīḍitā āsan lōkāstān yīśōḥ samīpam āninyuḥ, tadā sa ēkaikasya gātrē karamarpayitvā tānarōgān cakāra|</para>
  <para style="p">
    <verse number="41" style="v"/>tatō bhūtā bahubhyō nirgatya cītśabdaṁ kr̥tvā ca babhāṣirē tvamīśvarasya putrō'bhiṣiktatrātā; kintu sōbhiṣiktatrātēti tē vividurētasmāt kāraṇāt tān tarjayitvā tadvaktuṁ niṣiṣēdha|</para>
  <para style="p">
    <verse number="42" style="v"/>aparañca prabhātē sati sa vijanasthānaṁ pratasthē paścāt janāstamanvicchantastannikaṭaṁ gatvā sthānāntaragamanārthaṁ tamanvarundhan|</para>
  <para style="p">
    <verse number="43" style="v"/>kintu sa tān jagāda, īśvarīyarājyasya susaṁvādaṁ pracārayitum anyāni purāṇyapi mayā yātavyāni yatastadarthamēva prēritōhaṁ|</para>
  <para style="p">
    <verse number="44" style="v"/>atha gālīlō bhajanagēhēṣu sa upadidēśa|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ yīśurēkadā ginēṣarathdasya tīra uttiṣṭhati, tadā lōkā īśvarīyakathāṁ śrōtuṁ tadupari prapatitāḥ|</para>
  <para style="p">
    <verse number="2" style="v"/>tadānīṁ sa hdasya tīrasamīpē naudvayaṁ dadarśa kiñca matsyōpajīvinō nāvaṁ vihāya jālaṁ prakṣālayanti|</para>
  <para style="p">
    <verse number="3" style="v"/>tatastayōrdvayō rmadhyē śimōnō nāvamāruhya tīrāt kiñciddūraṁ yātuṁ tasmin vinayaṁ kr̥tvā naukāyāmupaviśya lōkān prōpadiṣṭavān|</para>
  <para style="p">
    <verse number="4" style="v"/>paścāt taṁ prastāvaṁ samāpya sa śimōnaṁ vyājahāra, gabhīraṁ jalaṁ gatvā matsyān dharttuṁ jālaṁ nikṣipa|</para>
  <para style="p">
    <verse number="5" style="v"/>tataḥ śimōna babhāṣē, hē gurō yadyapi vayaṁ kr̥tsnāṁ yāminīṁ pariśramya matsyaikamapi na prāptāstathāpi bhavatō nidēśatō jālaṁ kṣipāmaḥ|</para>
  <para style="p">
    <verse number="6" style="v"/>atha jālē kṣiptē bahumatsyapatanād ānāyaḥ pracchinnaḥ|</para>
  <para style="p">
    <verse number="7" style="v"/>tasmād upakarttum anyanausthān saṅgina āyātum iṅgitēna samāhvayan tatasta āgatya matsyai rnaudvayaṁ prapūrayāmāsu ryai rnaudvayaṁ pramagnam|</para>
  <para style="p">
    <verse number="8" style="v"/>tadā śimōnpitarastad vilōkya yīśōścaraṇayōḥ patitvā, hē prabhōhaṁ pāpī narō mama nikaṭād bhavān yātu, iti kathitavān|</para>
  <para style="p">
    <verse number="9" style="v"/>yatō jālē patitānāṁ matsyānāṁ yūthāt śimōn tatsaṅginaśca camatkr̥tavantaḥ; śimōnaḥ sahakāriṇau sivadēḥ putrau yākūb yōhan cēmau tādr̥śau babhūvatuḥ|</para>
  <para style="p">
    <verse number="10" style="v"/>tadā yīśuḥ śimōnaṁ jagāda mā bhaiṣīradyārabhya tvaṁ manuṣyadharō bhaviṣyasi|</para>
  <para style="p">
    <verse number="11" style="v"/>anantaraṁ sarvvāsu nausu tīram ānītāsu tē sarvvān parityajya tasya paścādgāminō babhūvuḥ|</para>
  <para style="p">
    <verse number="12" style="v"/>tataḥ paraṁ yīśau kasmiṁścit purē tiṣṭhati jana ēkaḥ sarvvāṅgakuṣṭhastaṁ vilōkya tasya samīpē nyubjaḥ patitvā savinayaṁ vaktumārēbhē, hē prabhō yadi bhavānicchati tarhi māṁ pariṣkarttuṁ śaknōti|</para>
  <para style="p">
    <verse number="13" style="v"/>tadānīṁ sa pāṇiṁ prasāryya tadaṅgaṁ spr̥śan babhāṣē tvaṁ pariṣkriyasvēti mamēcchāsti tatastatkṣaṇaṁ sa kuṣṭhāt muktaḥ|</para>
  <para style="p">
    <verse number="14" style="v"/>paścāt sa tamājñāpayāmāsa kathāmimāṁ kasmaicid akathayitvā yājakasya samīpañca gatvā svaṁ darśaya, lōkēbhyō nijapariṣkr̥tatvasya pramāṇadānāya mūsājñānusārēṇa dravyamutmr̥jasva ca|</para>
  <para style="p">
    <verse number="15" style="v"/>tathāpi yīśōḥ sukhyāti rbahu vyāptumārēbhē kiñca tasya kathāṁ śrōtuṁ svīyarōgēbhyō mōktuñca lōkā ājagmuḥ|</para>
  <para style="p">
    <verse number="16" style="v"/>atha sa prāntaraṁ gatvā prārthayāñcakrē|</para>
  <para style="p">
    <verse number="17" style="v"/>aparañca ēkadā yīśurupadiśati, ētarhi gālīlyihūdāpradēśayōḥ sarvvanagarēbhyō yirūśālamaśca kiyantaḥ phirūśilōkā vyavasthāpakāśca samāgatya tadantikē samupaviviśuḥ, tasmin kālē lōkānāmārōgyakāraṇāt prabhōḥ prabhāvaḥ pracakāśē|</para>
  <para style="p">
    <verse number="18" style="v"/>paścāt kiyantō lōkā ēkaṁ pakṣāghātinaṁ khaṭvāyāṁ nidhāya yīśōḥ samīpamānētuṁ sammukhē sthāpayituñca vyāpriyanta|</para>
  <para style="p">
    <verse number="19" style="v"/>kintu bahujananivahasamvādhāt na śaknuvantō gr̥hōpari gatvā gr̥hapr̥ṣṭhaṁ khanitvā taṁ pakṣāghātinaṁ sakhaṭvaṁ gr̥hamadhyē yīśōḥ sammukhē 'varōhayāmāsuḥ|</para>
  <para style="p">
    <verse number="20" style="v"/>tadā yīśustēṣām īdr̥śaṁ viśvāsaṁ vilōkya taṁ pakṣāghātinaṁ vyājahāra, hē mānava tava pāpamakṣamyata|</para>
  <para style="p">
    <verse number="21" style="v"/>tasmād adhyāpakāḥ phirūśinaśca cittairitthaṁ pracintitavantaḥ, ēṣa jana īśvaraṁ nindati kōyaṁ? kēvalamīśvaraṁ vinā pāpaṁ kṣantuṁ kaḥ śaknōti?</para>
  <para style="p">
    <verse number="22" style="v"/>tadā yīśustēṣām itthaṁ cintanaṁ viditvā tēbhyōkathayad yūyaṁ manōbhiḥ kutō vitarkayatha?</para>
  <para style="p">
    <verse number="23" style="v"/>tava pāpakṣamā jātā yadvā tvamutthāya vraja ētayō rmadhyē kā kathā sukathyā?</para>
  <para style="p">
    <verse number="24" style="v"/>kintu pr̥thivyāṁ pāpaṁ kṣantuṁ mānavasutasya sāmarthyamastīti yathā yūyaṁ jñātuṁ śaknutha tadarthaṁ (sa taṁ pakṣāghātinaṁ jagāda) uttiṣṭha svaśayyāṁ gr̥hītvā gr̥haṁ yāhīti tvāmādiśāmi|</para>
  <para style="p">
    <verse number="25" style="v"/>tasmāt sa tatkṣaṇam utthāya sarvvēṣāṁ sākṣāt nijaśayanīyaṁ gr̥hītvā īśvaraṁ dhanyaṁ vadan nijanivēśanaṁ yayau|</para>
  <para style="p">
    <verse number="26" style="v"/>tasmāt sarvvē vismaya prāptā manaḥsu bhītāśca vayamadyāsambhavakāryyāṇyadarśāma ityuktvā paramēśvaraṁ dhanyaṁ prōditāḥ|</para>
  <para style="p">
    <verse number="27" style="v"/>tataḥ paraṁ bahirgacchan karasañcayasthānē lēvināmānaṁ karasañcāyakaṁ dr̥ṣṭvā yīśustamabhidadhē mama paścādēhi|</para>
  <para style="p">
    <verse number="28" style="v"/>tasmāt sa tatkṣaṇāt sarvvaṁ parityajya tasya paścādiyāya|</para>
  <para style="p">
    <verse number="29" style="v"/>anantaraṁ lēvi rnijagr̥hē tadarthaṁ mahābhōjyaṁ cakāra, tadā taiḥ sahānēkē karasañcāyinastadanyalōkāśca bhōktumupaviviśuḥ|</para>
  <para style="p">
    <verse number="30" style="v"/>tasmāt kāraṇāt caṇḍālānāṁ pāpilōkānāñca saṅgē yūyaṁ kutō bhaṁgdhvē pivatha cēti kathāṁ kathayitvā phirūśinō'dhyāpakāśca tasya śiṣyaiḥ saha vāgyuddhaṁ karttumārēbhirē|</para>
  <para style="p">
    <verse number="31" style="v"/>tasmād yīśustān pratyavōcad arōgalōkānāṁ cikitsakēna prayōjanaṁ nāsti kintu sarōgāṇāmēva|</para>
  <para style="p">
    <verse number="32" style="v"/>ahaṁ dhārmmikān āhvātuṁ nāgatōsmi kintu manaḥ parāvarttayituṁ pāpina ēva|</para>
  <para style="p">
    <verse number="33" style="v"/>tatastē prōcuḥ, yōhanaḥ phirūśināñca śiṣyā vāraṁvāram upavasanti prārthayantē ca kintu tava śiṣyāḥ kutō bhuñjatē pivanti ca?</para>
  <para style="p">
    <verse number="34" style="v"/>tadā sa tānācakhyau varē saṅgē tiṣṭhati varasya sakhigaṇaṁ kimupavāsayituṁ śaknutha?</para>
  <para style="p">
    <verse number="35" style="v"/>kintu yadā tēṣāṁ nikaṭād varō nēṣyatē tadā tē samupavatsyanti|</para>
  <para style="p">
    <verse number="36" style="v"/>sōparamapi dr̥ṣṭāntaṁ kathayāmbabhūva purātanavastrē kōpi nutanavastraṁ na sīvyati yatastēna sēvanēna jīrṇavastraṁ chidyatē, nūtanapurātanavastrayō rmēlañca na bhavati|</para>
  <para style="p">
    <verse number="37" style="v"/>purātanyāṁ kutvāṁ kōpi nutanaṁ drākṣārasaṁ na nidadhāti, yatō navīnadrākṣārasasya tējasā purātanī kutū rvidīryyatē tatō drākṣārasaḥ patati kutūśca naśyati|</para>
  <para style="p">
    <verse number="38" style="v"/>tatō hētō rnūtanyāṁ kutvāṁ navīnadrākṣārasaḥ nidhātavyastēnōbhayasya rakṣā bhavati|</para>
  <para style="p">
    <verse number="39" style="v"/>aparañca purātanaṁ drākṣārasaṁ pītvā kōpi nūtanaṁ na vāñchati, yataḥ sa vakti nūtanāt purātanam praśastam|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>acarañca parvvaṇō dvitīyadināt paraṁ prathamaviśrāmavārē śasyakṣētrēṇa yīśōrgamanakālē tasya śiṣyāḥ kaṇiśaṁ chittvā karēṣu marddayitvā khāditumārēbhirē|</para>
  <para style="p">
    <verse number="2" style="v"/>tasmāt kiyantaḥ phirūśinastānavadan viśrāmavārē yat karmma na karttavyaṁ tat kutaḥ kurutha?</para>
  <para style="p">
    <verse number="3" style="v"/>yīśuḥ pratyuvāca dāyūd tasya saṅginaśca kṣudhārttāḥ kiṁ cakruḥ sa katham īśvarasya mandiraṁ praviśya</para>
  <para style="p">
    <verse number="4" style="v"/>yē darśanīyāḥ pūpā yājakān vinānyasya kasyāpyabhōjanīyāstānānīya svayaṁ bubhajē saṅgibhyōpi dadau tat kiṁ yuṣmābhiḥ kadāpi nāpāṭhi?</para>
  <para style="p">
    <verse number="5" style="v"/>paścāt sa tānavadat manujasutō viśrāmavārasyāpi prabhu rbhavati|</para>
  <para style="p">
    <verse number="6" style="v"/>anantaram anyaviśrāmavārē sa bhajanagēhaṁ praviśya samupadiśati| tadā tatsthānē śuṣkadakṣiṇakara ēkaḥ pumān upatasthivān|</para>
  <para style="p">
    <verse number="7" style="v"/>tasmād adhyāpakāḥ phirūśinaśca tasmin dōṣamārōpayituṁ sa viśrāmavārē tasya svāsthyaṁ karōti navēti pratīkṣitumārēbhirē|</para>
  <para style="p">
    <verse number="8" style="v"/>tadā yīśustēṣāṁ cintāṁ viditvā taṁ śuṣkakaraṁ pumāṁsaṁ prōvāca, tvamutthāya madhyasthānē tiṣṭha|</para>
  <para style="p">
    <verse number="9" style="v"/>tasmāt tasmin utthitavati yīśustān vyājahāra, yuṣmān imāṁ kathāṁ pr̥cchāmi, viśrāmavārē hitam ahitaṁ vā, prāṇarakṣaṇaṁ prāṇanāśanaṁ vā, ētēṣāṁ kiṁ karmmakaraṇīyam?</para>
  <para style="p">
    <verse number="10" style="v"/>paścāt caturdikṣu sarvvān vilōkya taṁ mānavaṁ babhāṣē, nijakaraṁ prasāraya; tatastēna tathā kr̥ta itarakaravat tasya hastaḥ svasthōbhavat|</para>
  <para style="p">
    <verse number="11" style="v"/>tasmāt tē pracaṇḍakōpānvitā yīśuṁ kiṁ kariṣyantīti parasparaṁ pramantritāḥ|</para>
  <para style="p">
    <verse number="12" style="v"/>tataḥ paraṁ sa parvvatamāruhyēśvaramuddiśya prārthayamānaḥ kr̥tsnāṁ rātriṁ yāpitavān|</para>
  <para style="p">
    <verse number="13" style="v"/>atha dinē sati sa sarvvān śiṣyān āhūtavān tēṣāṁ madhyē</para>
  <para style="p">
    <verse number="14" style="v"/>pitaranāmnā khyātaḥ śimōn tasya bhrātā āndriyaśca yākūb yōhan ca philip barthalamayaśca</para>
  <para style="p">
    <verse number="15" style="v"/>mathiḥ thōmā ālphīyasya putrō yākūb jvalantanāmnā khyātaḥ śimōn</para>
  <para style="p">
    <verse number="16" style="v"/>ca yākūbō bhrātā yihūdāśca taṁ yaḥ parakarēṣu samarpayiṣyati sa īṣkarīyōtīyayihūdāścaitān dvādaśa janān manōnītān kr̥tvā sa jagrāha tathā prērita iti tēṣāṁ nāma cakāra|</para>
  <para style="p">
    <verse number="17" style="v"/>tataḥ paraṁ sa taiḥ saha parvvatādavaruhya upatyakāyāṁ tasthau tatastasya śiṣyasaṅghō yihūdādēśād yirūśālamaśca sōraḥ sīdōnaśca jaladhē rōdhasō jananihāśca ētya tasya kathāśravaṇārthaṁ rōgamuktyarthañca tasya samīpē tasthuḥ|</para>
  <para style="p">
    <verse number="18" style="v"/>amēdhyabhūtagrastāśca tannikaṭamāgatya svāsthyaṁ prāpuḥ|</para>
  <para style="p">
    <verse number="19" style="v"/>sarvvēṣāṁ svāsthyakaraṇaprabhāvasya prakāśitatvāt sarvvē lōkā ētya taṁ spraṣṭuṁ yētirē|</para>
  <para style="p">
    <verse number="20" style="v"/>paścāt sa śiṣyān prati dr̥ṣṭiṁ kutvā jagāda, hē daridrā yūyaṁ dhanyā yata īśvarīyē rājyē vō'dhikārōsti|</para>
  <para style="p">
    <verse number="21" style="v"/>hē adhunā kṣudhitalōkā yūyaṁ dhanyā yatō yūyaṁ tarpsyatha; hē iha rōdinō janā yūyaṁ dhanyā yatō yūyaṁ hasiṣyatha|</para>
  <para style="p">
    <verse number="22" style="v"/>yadā lōkā manuṣyasūnō rnāmahētō ryuṣmān r̥ृtīyiṣyantē pr̥thak kr̥tvā nindiṣyanti, adhamāniva yuṣmān svasamīpād dūrīkariṣyanti ca tadā yūyaṁ dhanyāḥ|</para>
  <para style="p">
    <verse number="23" style="v"/>svargē yuṣmākaṁ yathēṣṭaṁ phalaṁ bhaviṣyati, ētadarthaṁ tasmin dinē prōllasata ānandēna nr̥tyata ca, tēṣāṁ pūrvvapuruṣāśca bhaviṣyadvādinaḥ prati tathaiva vyavāharan|</para>
  <para style="p">
    <verse number="24" style="v"/>kintu hā hā dhanavantō yūyaṁ sukhaṁ prāpnuta| hanta paritr̥ptā yūyaṁ kṣudhitā bhaviṣyatha;</para>
  <para style="p">
    <verse number="25" style="v"/>iha hasantō yūyaṁ vata yuṣmābhiḥ śōcitavyaṁ rōditavyañca|</para>
  <para style="p">
    <verse number="26" style="v"/>sarvvailākai ryuṣmākaṁ sukhyātau kr̥tāyāṁ yuṣmākaṁ durgati rbhaviṣyati yuṣmākaṁ pūrvvapuruṣā mr̥ṣābhaviṣyadvādinaḥ prati tadvat kr̥tavantaḥ|</para>
  <para style="p">
    <verse number="27" style="v"/>hē śrōtārō yuṣmabhyamahaṁ kathayāmi, yūyaṁ śatruṣu prīyadhvaṁ yē ca yuṣmān dviṣanti tēṣāmapi hitaṁ kuruta|</para>
  <para style="p">
    <verse number="28" style="v"/>yē ca yuṣmān śapanti tēbhya āśiṣaṁ datta yē ca yuṣmān avamanyantē tēṣāṁ maṅgalaṁ prārthayadhvaṁ|</para>
  <para style="p">
    <verse number="29" style="v"/>yadi kaścit tava kapōlē capēṭāghātaṁ karōti tarhi taṁ prati kapōlam anyaṁ parāvarttya sammukhīkuru punaśca yadi kaścit tava gātrīyavastraṁ harati tarhi taṁ paridhēyavastram api grahītuṁ mā vāraya|</para>
  <para style="p">
    <verse number="30" style="v"/>yastvāṁ yācatē tasmai dēhi, yaśca tava sampattiṁ harati taṁ mā yācasva|</para>
  <para style="p">
    <verse number="31" style="v"/>parēbhyaḥ svān prati yathācaraṇam apēkṣadhvē parān prati yūyamapi tathācarata|</para>
  <para style="p">
    <verse number="32" style="v"/>yē janā yuṣmāsu prīyantē kēvalaṁ tēṣu prīyamāṇēṣu yuṣmākaṁ kiṁ phalaṁ? pāpilōkā api svēṣu prīyamāṇēṣu prīyantē|</para>
  <para style="p">
    <verse number="33" style="v"/>yadi hitakāriṇa ēva hitaṁ kurutha tarhi yuṣmākaṁ kiṁ phalaṁ? pāpilōkā api tathā kurvvanti|</para>
  <para style="p">
    <verse number="34" style="v"/>yēbhya r̥ṇapariśōdhasya prāptipratyāśāstē kēvalaṁ tēṣu r̥ṇē samarpitē yuṣmākaṁ kiṁ phalaṁ? punaḥ prāptyāśayā pāpīlōkā api pāpijanēṣu r̥ṇam arpayanti|</para>
  <para style="p">
    <verse number="35" style="v"/>atō yūyaṁ ripuṣvapi prīyadhvaṁ, parahitaṁ kuruta ca; punaḥ prāptyāśāṁ tyaktvā r̥ṇamarpayata, tathā kr̥tē yuṣmākaṁ mahāphalaṁ bhaviṣyati, yūyañca sarvvapradhānasya santānā iti khyātiṁ prāpsyatha, yatō yuṣmākaṁ pitā kr̥taghnānāṁ durvṭattānāñca hitamācarati|</para>
  <para style="p">
    <verse number="36" style="v"/>ata ēva sa yathā dayālu ryūyamapi tādr̥śā dayālavō bhavata|</para>
  <para style="p">
    <verse number="37" style="v"/>aparañca parān dōṣiṇō mā kuruta tasmād yūyaṁ dōṣīkr̥tā na bhaviṣyatha; adaṇḍyān mā daṇḍayata tasmād yūyamapi daṇḍaṁ na prāpsyatha; parēṣāṁ dōṣān kṣamadhvaṁ tasmād yuṣmākamapi dōṣāḥ kṣamiṣyantē|</para>
  <para style="p">
    <verse number="38" style="v"/>dānānidatta tasmād yūyaṁ dānāni prāpsyatha, varañca lōkāḥ parimāṇapātraṁ pradalayya sañcālya prōñcālya paripūryya yuṣmākaṁ krōḍēṣu samarpayiṣyanti; yūyaṁ yēna parimāṇēna parimātha tēnaiva parimāṇēna yuṣmatkr̥tē parimāsyatē|</para>
  <para style="p">
    <verse number="39" style="v"/>atha sa tēbhyō dr̥ṣṭāntakathāmakathayat, andhō janaḥ kimandhaṁ panthānaṁ darśayituṁ śaknōti? tasmād ubhāvapi kiṁ garttē na patiṣyataḥ?</para>
  <para style="p">
    <verse number="40" style="v"/>gurōḥ śiṣyō na śrēṣṭhaḥ kintu śiṣyē siddhē sati sa gurutulyō bhavituṁ śaknōti|</para>
  <para style="p">
    <verse number="41" style="v"/>aparañca tvaṁ svacakṣuुṣi nāsām adr̥ṣṭvā tava bhrātuścakṣuṣi yattr̥ṇamasti tadēva kutaḥ paśyami?</para>
  <para style="p">
    <verse number="42" style="v"/>svacakṣuṣi yā nāsā vidyatē tām ajñātvā, bhrātastava nētrāt tr̥ṇaṁ bahiḥ karōmīti vākyaṁ bhrātaraṁ kathaṁ vaktuṁ śaknōṣi? hē kapaṭin pūrvvaṁ svanayanāt nāsāṁ bahiḥ kuru tatō bhrātuścakṣuṣastr̥ṇaṁ bahiḥ karttuṁ sudr̥ṣṭiṁ prāpsyasi|</para>
  <para style="p">
    <verse number="43" style="v"/>anyañca uttamastaruḥ kadāpi phalamanuttamaṁ na phalati, anuttamataruśca phalamuttamaṁ na phalati kāraṇādataḥ phalaistaravō jñāyantē|</para>
  <para style="p">
    <verse number="44" style="v"/>kaṇṭakipādapāt kōpi uḍumbaraphalāni na pātayati tathā śr̥gālakōlivr̥kṣādapi kōpi drākṣāphalaṁ na pātayati|</para>
  <para style="p">
    <verse number="45" style="v"/>tadvat sādhulōkō'ntaḥkaraṇarūpāt subhāṇḍāgārād uttamāni dravyāṇi bahiḥ karōti, duṣṭō lōkaścāntaḥkaraṇarūpāt kubhāṇḍāgārāt kutsitāni dravyāṇi nirgamayati yatō'ntaḥkaraṇānāṁ pūrṇabhāvānurūpāṇi vacāṁsi mukhānnirgacchanti|</para>
  <para style="p">
    <verse number="46" style="v"/>aparañca mamājñānurūpaṁ nācaritvā kutō māṁ prabhō prabhō iti vadatha?</para>
  <para style="p">
    <verse number="47" style="v"/>yaḥ kaścin mama nikaṭam āgatya mama kathā niśamya tadanurūpaṁ karmma karōti sa kasya sadr̥śō bhavati tadahaṁ yuṣmān jñāाpayāmi|</para>
  <para style="p">
    <verse number="48" style="v"/>yō janō gabhīraṁ khanitvā pāṣāṇasthalē bhittiṁ nirmmāya svagr̥haṁ racayati tēna saha tasyōpamā bhavati; yata āplāvijalamētya tasya mūlē vēgēna vahadapi tadgēhaṁ lāḍayituṁ na śaknōti yatastasya bhittiḥ pāṣāṇōpari tiṣṭhati|</para>
  <para style="p">
    <verse number="49" style="v"/>kintu yaḥ kaścin mama kathāḥ śrutvā tadanurūpaṁ nācarati sa bhittiṁ vinā mr̥ृdupari gr̥hanirmmātrā samānō bhavati; yata āplāvijalamāgatya vēgēna yadā vahati tadā tadgr̥haṁ patati tasya mahat patanaṁ jāyatē|</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tataḥ paraṁ sa lōkānāṁ karṇagōcarē tān sarvvān upadēśān samāpya yadā kapharnāhūmpuraṁ praviśati</para>
  <para style="p">
    <verse number="2" style="v"/>tadā śatasēnāpatēḥ priyadāsa ēkō mr̥takalpaḥ pīḍita āsīt|</para>
  <para style="p">
    <verse number="3" style="v"/>ataḥ sēnāpati ryīśō rvārttāṁ niśamya dāsasyārōgyakaraṇāya tasyāgamanārthaṁ vinayakaraṇāya yihūdīyān kiyataḥ prācaḥ prēṣayāmāsa|</para>
  <para style="p">
    <verse number="4" style="v"/>tē yīśōrantikaṁ gatvā vinayātiśayaṁ vaktumārēbhirē, sa sēnāpati rbhavatōnugrahaṁ prāptum arhati|</para>
  <para style="p">
    <verse number="5" style="v"/>yataḥ sōsmajjātīyēṣu lōkēṣu prīyatē tathāsmatkr̥tē bhajanagēhaṁ nirmmitavān|</para>
  <para style="p">
    <verse number="6" style="v"/>tasmād yīśustaiḥ saha gatvā nivēśanasya samīpaṁ prāpa, tadā sa śatasēnāpati rvakṣyamāṇavākyaṁ taṁ vaktuṁ bandhūn prāhiṇōt| hē prabhō svayaṁ śramō na karttavyō yad bhavatā madgēhamadhyē pādārpaṇaṁ kriyēta tadapyahaṁ nārhāmi,</para>
  <para style="p">
    <verse number="7" style="v"/>kiñcāhaṁ bhavatsamīpaṁ yātumapi nātmānaṁ yōgyaṁ buddhavān, tatō bhavān vākyamātraṁ vadatu tēnaiva mama dāsaḥ svasthō bhaviṣyati|</para>
  <para style="p">
    <verse number="8" style="v"/>yasmād ahaṁ parādhīnōpi mamādhīnā yāḥ sēnāḥ santi tāsām ēkajanaṁ prati yāhīti mayā prōktē sa yāti; tadanyaṁ prati āyāhīti prōktē sa āyāti; tathā nijadāsaṁ prati ētat kurvviti prōktē sa tadēva karōti|</para>
  <para style="p">
    <verse number="9" style="v"/>yīśuridaṁ vākyaṁ śrutvā vismayaṁ yayau, mukhaṁ parāvartya paścādvarttinō lōkān babhāṣē ca, yuṣmānahaṁ vadāmi isrāyēlō vaṁśamadhyēpi viśvāsamīdr̥śaṁ na prāpnavaṁ|</para>
  <para style="p">
    <verse number="10" style="v"/>tatastē prēṣitā gr̥haṁ gatvā taṁ pīḍitaṁ dāsaṁ svasthaṁ dadr̥śuḥ|</para>
  <para style="p">
    <verse number="11" style="v"/>parē'hani sa nāyīnākhyaṁ nagaraṁ jagāma tasyānēkē śiṣyā anyē ca lōkāstēna sārddhaṁ yayuḥ|</para>
  <para style="p">
    <verse number="12" style="v"/>tēṣu tannagarasya dvārasannidhiṁ prāptēṣu kiyantō lōkā ēkaṁ mr̥tamanujaṁ vahantō nagarasya bahiryānti, sa tanmāturēkaputrastanmātā ca vidhavā; tayā sārddhaṁ tannagarīyā bahavō lōkā āsan|</para>
  <para style="p">
    <verse number="13" style="v"/>prabhustāṁ vilōkya sānukampaḥ kathayāmāsa, mā rōdīḥ| sa samīpamitvā khaṭvāṁ pasparśa tasmād vāhakāḥ sthagitāstamyuḥ;</para>
  <para style="p">
    <verse number="14" style="v"/>tadā sa uvāca hē yuvamanuṣya tvamuttiṣṭha, tvāmaham ājñāpayāmi|</para>
  <para style="p">
    <verse number="15" style="v"/>tasmāt sa mr̥tō janastatkṣaṇamutthāya kathāṁ prakathitaḥ; tatō yīśustasya mātari taṁ samarpayāmāsa|</para>
  <para style="p">
    <verse number="16" style="v"/>tasmāt sarvvē lōkāḥ śaśaṅkirē; ēkō mahābhaviṣyadvādī madhyē'smākam samudait, īśvaraśca svalōkānanvagr̥hlāt kathāmimāṁ kathayitvā īśvaraṁ dhanyaṁ jagaduḥ|</para>
  <para style="p">
    <verse number="17" style="v"/>tataḥ paraṁ samastaṁ yihūdādēśaṁ tasya caturdiksthadēśañca tasyaitatkīrtti rvyānaśē|</para>
  <para style="p">
    <verse number="18" style="v"/>tataḥ paraṁ yōhanaḥ śiṣyēṣu taṁ tadvr̥ttāntaṁ jñāpitavatsu</para>
  <para style="p">
    <verse number="19" style="v"/>sa svaśiṣyāṇāṁ dvau janāvāhūya yīśuṁ prati vakṣyamāṇaṁ vākyaṁ vaktuṁ prēṣayāmāsa, yasyāgamanam apēkṣya tiṣṭhāmō vayaṁ kiṁ sa ēva janastvaṁ? kiṁ vayamanyamapēkṣya sthāsyāmaḥ?</para>
  <para style="p">
    <verse number="20" style="v"/>paścāttau mānavau gatvā kathayāmāsatuḥ, yasyāgamanam apēkṣya tiṣṭhāmō vayaṁ, kiṁ saēva janastvaṁ? kiṁ vayamanyamapēkṣya sthāsyāmaḥ? kathāmimāṁ tubhyaṁ kathayituṁ yōhan majjaka āvāṁ prēṣitavān|</para>
  <para style="p">
    <verse number="21" style="v"/>tasmin daṇḍē yīśūrōgiṇō mahāvyādhimatō duṣṭabhūtagrastāṁśca bahūn svasthān kr̥tvā, anēkāndhēbhyaścakṣuṁṣi dattvā pratyuvāca,</para>
  <para style="p">
    <verse number="22" style="v"/>yuvāṁ vrajatam andhā nētrāṇi khañjāścaraṇāni ca prāpnuvanti, kuṣṭhinaḥ pariṣkriyantē, badhirāḥ śravaṇāni mr̥tāśca jīvanāni prāpnuvanti, daridrāṇāṁ samīpēṣu susaṁvādaḥ pracāryyatē, yaṁ prati vighnasvarūpōhaṁ na bhavāmi sa dhanyaḥ,</para>
  <para style="p">
    <verse number="23" style="v"/>ētāni yāni paśyathaḥ śr̥ṇuthaśca tāni yōhanaṁ jñāpayatam|</para>
  <para style="p">
    <verse number="24" style="v"/>tayō rdūtayō rgatayōḥ satō ryōhani sa lōkān vaktumupacakramē, yūyaṁ madhyēprāntaraṁ kiṁ draṣṭuṁ niragamata? kiṁ vāyunā kampitaṁ naḍaṁ?</para>
  <para style="p">
    <verse number="25" style="v"/>yūyaṁ kiṁ draṣṭuṁ niragamata? kiṁ sūkṣmavastraparidhāyinaṁ kamapi naraṁ? kintu yē sūkṣmamr̥duvastrāṇi paridadhati sūttamāni dravyāṇi bhuñjatē ca tē rājadhānīṣu tiṣṭhanti|</para>
  <para style="p">
    <verse number="26" style="v"/>tarhi yūyaṁ kiṁ draṣṭuṁ niragamata? kimēkaṁ bhaviṣyadvādinaṁ? tadēva satyaṁ kintu sa pumān bhaviṣyadvādinōpi śrēṣṭha ityahaṁ yuṣmān vadāmi;</para>
  <para style="p">
    <verse number="27" style="v"/>paśya svakīyadūtantu tavāgra prēṣayāmyahaṁ| gatvā tvadīyamārgantu sa hi pariṣkariṣyati| yadarthē lipiriyam āstē sa ēva yōhan|</para>
  <para style="p">
    <verse number="28" style="v"/>atō yuṣmānahaṁ vadāmi striyā garbbhajātānāṁ bhaviṣyadvādināṁ madhyē yōhanō majjakāt śrēṣṭhaḥ kōpi nāsti, tatrāpi īśvarasya rājyē yaḥ sarvvasmāt kṣudraḥ sa yōhanōpi śrēṣṭhaḥ|</para>
  <para style="p">
    <verse number="29" style="v"/>aparañca sarvvē lōkāḥ karamañcāyinaśca tasya vākyāni śrutvā yōhanā majjanēna majjitāḥ paramēśvaraṁ nirdōṣaṁ mēnirē|</para>
  <para style="p">
    <verse number="30" style="v"/>kintu phirūśinō vyavasthāpakāśca tēna na majjitāḥ svān pratīśvarasyōpadēśaṁ niṣphalam akurvvan|</para>
  <para style="p">
    <verse number="31" style="v"/>atha prabhuḥ kathayāmāsa, idānīntanajanān kēnōpamāmi? tē kasya sadr̥śāḥ?</para>
  <para style="p">
    <verse number="32" style="v"/>yē bālakā vipaṇyām upaviśya parasparam āhūya vākyamidaṁ vadanti, vayaṁ yuṣmākaṁ nikaṭē vaṁśīravādiṣma, kintu yūyaṁ nānarttiṣṭa, vayaṁ yuṣmākaṁ nikaṭa arōdiṣma, kintu yuyaṁ na vyalapiṣṭa, bālakairētādr̥śaistēṣām upamā bhavati|</para>
  <para style="p">
    <verse number="33" style="v"/>yatō yōhan majjaka āgatya pūpaṁ nākhādat drākṣārasañca nāpivat tasmād yūyaṁ vadatha, bhūtagrastōyam|</para>
  <para style="p">
    <verse number="34" style="v"/>tataḥ paraṁ mānavasuta āgatyākhādadapivañca tasmād yūyaṁ vadatha, khādakaḥ surāpaścāṇḍālapāpināṁ bandhurēkō janō dr̥śyatām|</para>
  <para style="p">
    <verse number="35" style="v"/>kintu jñāninō jñānaṁ nirdōṣaṁ viduḥ|</para>
  <para style="p">
    <verse number="36" style="v"/>paścādēkaḥ phirūśī yīśuṁ bhōjanāya nyamantrayat tataḥ sa tasya gr̥haṁ gatvā bhōktumupaviṣṭaḥ|</para>
  <para style="p">
    <verse number="37" style="v"/>ētarhi tatphirūśinō gr̥hē yīśu rbhēktum upāvēkṣīt tacchrutvā tannagaravāsinī kāpi duṣṭā nārī pāṇḍaraprastarasya sampuṭakē sugandhitailam ānīya</para>
  <para style="p">
    <verse number="38" style="v"/>tasya paścāt pādayōḥ sannidhau tasyau rudatī ca nētrāmbubhistasya caraṇau prakṣālya nijakacairamārkṣīt, tatastasya caraṇau cumbitvā tēna sugandhitailēna mamarda|</para>
  <para style="p">
    <verse number="39" style="v"/>tasmāt sa nimantrayitā phirūśī manasā cintayāmāsa, yadyayaṁ bhaviṣyadvādī bhavēt tarhi ēnaṁ spr̥śati yā strī sā kā kīdr̥śī cēti jñātuṁ śaknuyāt yataḥ sā duṣṭā|</para>
  <para style="p">
    <verse number="40" style="v"/>tadā yāśustaṁ jagāda, hē śimōn tvāṁ prati mama kiñcid vaktavyamasti; tasmāt sa babhāṣē, hē gurō tad vadatu|</para>
  <para style="p">
    <verse number="41" style="v"/>ēkōttamarṇasya dvāvadhamarṇāvāstāṁ, tayōrēkaḥ pañcaśatāni mudrāpādān aparaśca pañcāśat mudrāpādān dhārayāmāsa|</para>
  <para style="p">
    <verse number="42" style="v"/>tadanantaraṁ tayōḥ śōdhyābhāvāt sa uttamarṇastayō rr̥ṇē cakṣamē; tasmāt tayōrdvayōḥ kastasmin prēṣyatē bahu? tad brūhi|</para>
  <para style="p">
    <verse number="43" style="v"/>śimōn pratyuvāca, mayā budhyatē yasyādhikam r̥ṇaṁ cakṣamē sa iti; tatō yīśustaṁ vyājahāra, tvaṁ yathārthaṁ vyacārayaḥ|</para>
  <para style="p">
    <verse number="44" style="v"/>atha tāṁ nārīṁ prati vyāghuṭhya śimōnamavōcat, strīmimāṁ paśyasi? tava gr̥hē mayyāgatē tvaṁ pādaprakṣālanārthaṁ jalaṁ nādāḥ kintu yōṣidēṣā nayanajalai rmama pādau prakṣālya kēśairamārkṣīt|</para>
  <para style="p">
    <verse number="45" style="v"/>tvaṁ māṁ nācumbīḥ kintu yōṣidēṣā svīyāgamanādārabhya madīyapādau cumbituṁ na vyaraṁsta|</para>
  <para style="p">
    <verse number="46" style="v"/>tvañca madīyōttamāṅgē kiñcidapi tailaṁ nāmardīḥ kintu yōṣidēṣā mama caraṇau sugandhitailēnāmarddīt|</para>
  <para style="p">
    <verse number="47" style="v"/>atastvāṁ vyāharāmi, ētasyā bahu pāpamakṣamyata tatō bahu prīyatē kintu yasyālpapāpaṁ kṣamyatē sōlpaṁ prīyatē|</para>
  <para style="p">
    <verse number="48" style="v"/>tataḥ paraṁ sa tāṁ babhāṣē, tvadīyaṁ pāpamakṣamyata|</para>
  <para style="p">
    <verse number="49" style="v"/>tadā tēna sārddhaṁ yē bhōktum upaviviśustē parasparaṁ vaktumārēbhirē, ayaṁ pāpaṁ kṣamatē ka ēṣaḥ?</para>
  <para style="p">
    <verse number="50" style="v"/>kintu sa tāṁ nārīṁ jagāda, tava viśvāsastvāṁ paryyatrāsta tvaṁ kṣēmēṇa vraja|</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>aparañca yīśu rdvādaśabhiḥ śiṣyaiḥ sārddhaṁ nānānagarēṣu nānāgrāmēṣu ca gacchan iśvarīyarājatvasya susaṁvādaṁ pracārayituṁ prārēbhē|</para>
  <para style="p">
    <verse number="2" style="v"/>tadā yasyāḥ sapta bhūtā niragacchan sā magdalīnīti vikhyātā mariyam hērōdrājasya gr̥hādhipatēḥ hōṣē rbhāryyā yōhanā śūśānā</para>
  <para style="p">
    <verse number="3" style="v"/>prabhr̥tayō yā bahvyaḥ striyaḥ duṣṭabhūtēbhyō rōgēbhyaśca muktāḥ satyō nijavibhūtī rvyayitvā tamasēvanta, tāḥ sarvvāstēna sārddham āsan|</para>
  <para style="p">
    <verse number="4" style="v"/>anantaraṁ nānānagarēbhyō bahavō lōkā āgatya tasya samīpē'milan, tadā sa tēbhya ēkāṁ dr̥ṣṭāntakathāṁ kathayāmāsa| ēkaḥ kr̥ṣībalō bījāni vaptuṁ bahirjagāma,</para>
  <para style="p">
    <verse number="5" style="v"/>tatō vapanakālē katipayāni bījāni mārgapārśvē pētuḥ, tatastāni padatalai rdalitāni pakṣibhi rbhakṣitāni ca|</para>
  <para style="p">
    <verse number="6" style="v"/>katipayāni bījāni pāṣāṇasthalē patitāni yadyapi tānyaṅkuritāni tathāpi rasābhāvāt śuśuṣuḥ|</para>
  <para style="p">
    <verse number="7" style="v"/>katipayāni bījāni kaṇṭakivanamadhyē patitāni tataḥ kaṇṭakivanāni saṁvr̥ddhya tāni jagrasuḥ|</para>
  <para style="p">
    <verse number="8" style="v"/>tadanyāni katipayabījāni ca bhūmyāmuttamāyāṁ pētustatastānyaṅkurayitvā śataguṇāni phalāni phēluḥ| sa imā kathāṁ kathayitvā prōccaiḥ prōvāca, yasya śrōtuṁ śrōtrē staḥ sa śr̥ṇōtu|</para>
  <para style="p">
    <verse number="9" style="v"/>tataḥ paraṁ śiṣyāstaṁ papracchurasya dr̥ṣṭāntasya kiṁ tātparyyaṁ?</para>
  <para style="p">
    <verse number="10" style="v"/>tataḥ sa vyājahāra, īśvarīyarājyasya guhyāni jñātuṁ yuṣmabhyamadhikārō dīyatē kintvanyē yathā dr̥ṣṭvāpi na paśyanti śrutvāpi ma budhyantē ca tadarthaṁ tēṣāṁ purastāt tāḥ sarvvāḥ kathā dr̥ṣṭāntēna kathyantē|</para>
  <para style="p">
    <verse number="11" style="v"/>dr̥ṣṭāntasyāsyābhiprāyaḥ, īśvarīyakathā bījasvarūpā|</para>
  <para style="p">
    <verse number="12" style="v"/>yē kathāmātraṁ śr̥ṇvanti kintu paścād viśvasya yathā paritrāṇaṁ na prāpnuvanti tadāśayēna śaitānētya hr̥dayātr̥ tāṁ kathām apaharati ta ēva mārgapārśvasthabhūmisvarūpāḥ|</para>
  <para style="p">
    <verse number="13" style="v"/>yē kathaṁ śrutvā sānandaṁ gr̥hlanti kintvabaddhamūlatvāt svalpakālamātraṁ pratītya parīkṣākālē bhraśyanti taēva pāṣāṇabhūmisvarūpāḥ|</para>
  <para style="p">
    <verse number="14" style="v"/>yē kathāṁ śrutvā yānti viṣayacintāyāṁ dhanalōbhēna ēेhikasukhē ca majjanta upayuktaphalāni na phalanti ta ēvōptabījakaṇṭakibhūsvarūpāḥ|</para>
  <para style="p">
    <verse number="15" style="v"/>kintu yē śrutvā saralaiḥ śuddhaiścāntaḥkaraṇaiḥ kathāṁ gr̥hlanti dhairyyam avalambya phalānyutpādayanti ca ta ēvōttamamr̥tsvarūpāḥ|</para>
  <para style="p">
    <verse number="16" style="v"/>aparañca pradīpaṁ prajvālya kōpi pātrēṇa nācchādayati tathā khaṭvādhōpi na sthāpayati, kintu dīpādhārōparyyēva sthāpayati, tasmāt pravēśakā dīptiṁ paśyanti|</para>
  <para style="p">
    <verse number="17" style="v"/>yanna prakāśayiṣyatē tādr̥g aprakāśitaṁ vastu kimapi nāsti yacca na suvyaktaṁ pracārayiṣyatē tādr̥g gr̥ptaṁ vastu kimapi nāsti|</para>
  <para style="p">
    <verse number="18" style="v"/>atō yūyaṁ kēna prakārēṇa śr̥ṇutha tatra sāvadhānā bhavata, yasya samīpē barddhatē tasmai punardāsyatē kintu yasyāśrayē na barddhatē tasya yadyadasti tadapi tasmāt nēṣyatē|</para>
  <para style="p">
    <verse number="19" style="v"/>aparañca yīśō rmātā bhrātaraśca tasya samīpaṁ jigamiṣavaḥ</para>
  <para style="p">
    <verse number="20" style="v"/>kintu janatāsambādhāt tatsannidhiṁ prāptuṁ na śēkuḥ| tatpaścāt tava mātā bhrātaraśca tvāṁ sākṣāt cikīrṣantō bahistiṣṭhanatīti vārttāyāṁ tasmai kathitāyāṁ</para>
  <para style="p">
    <verse number="21" style="v"/>sa pratyuvāca; yē janā īśvarasya kathāṁ śrutvā tadanurūpamācaranti taēva mama mātā bhrātaraśca|</para>
  <para style="p">
    <verse number="22" style="v"/>anantaraṁ ēkadā yīśuḥ śiṣyaiḥ sārddhaṁ nāvamāruhya jagāda, āyāta vayaṁ hradasya pāraṁ yāmaḥ, tatastē jagmuḥ|</para>
  <para style="p">
    <verse number="23" style="v"/>tēṣu naukāṁ vāhayatsu sa nidadrau;</para>
  <para style="p">
    <verse number="24" style="v"/>athākasmāt prabalajhañbhśagamād hradē naukāyāṁ taraṅgairācchannāyāṁ vipat tān jagrāsa|tasmād yīśōrantikaṁ gatvā hē gurō hē gurō prāṇā nō yāntīti gaditvā taṁ jāgarayāmbabhūvuḥ|tadā sa utthāya vāyuṁ taraṅgāṁśca tarjayāmāsa tasmādubhau nivr̥tya sthirau babhūvatuḥ|</para>
  <para style="p">
    <verse number="25" style="v"/>sa tān babhāṣē yuṣmākaṁ viśvāsaḥ ka? tasmāttē bhītā vismitāśca parasparaṁ jagaduḥ, ahō kīdr̥gayaṁ manujaḥ pavanaṁ pānīyañcādiśati tadubhayaṁ tadādēśaṁ vahati|</para>
  <para style="p">
    <verse number="26" style="v"/>tataḥ paraṁ gālīlpradēśasya sammukhasthagidērīyapradēśē naukāyāṁ lagantyāṁ taṭē'varōhamāvād</para>
  <para style="p">
    <verse number="27" style="v"/>bahutithakālaṁ bhūtagrasta ēkō mānuṣaḥ purādāgatya taṁ sākṣāccakāra| sa manuṣō vāsō na paridadhat gr̥hē ca na vasan kēvalaṁ śmaśānam adhyuvāsa|</para>
  <para style="p">
    <verse number="28" style="v"/>sa yīśuṁ dr̥ṣṭvaiva cīcchabdaṁ cakāra tasya sammukhē patitvā prōccairjagāda ca, hē sarvvapradhānēśvarasya putra, mayā saha tava kaḥ sambandhaḥ? tvayi vinayaṁ karōmi māṁ mā yātaya|</para>
  <para style="p">
    <verse number="29" style="v"/>yataḥ sa taṁ mānuṣaṁ tyaktvā yātum amēdhyabhūtam ādidēśa; sa bhūtastaṁ mānuṣam asakr̥d dadhāra tasmāllōkāḥ śr̥ṅkhalēna nigaḍēna ca babandhuḥ; sa tad bhaṁktvā bhūtavaśatvāt madhyēprāntaraṁ yayau|</para>
  <para style="p">
    <verse number="30" style="v"/>anantaraṁ yīśustaṁ papraccha tava kinnāma? sa uvāca, mama nāma bāhinō yatō bahavō bhūtāstamāśiśriyuḥ|</para>
  <para style="p">
    <verse number="31" style="v"/>atha bhūtā vinayēna jagaduḥ, gabhīraṁ garttaṁ gantuṁ mājñāpayāsmān|</para>
  <para style="p">
    <verse number="32" style="v"/>tadā parvvatōpari varāhavrajaścarati tasmād bhūtā vinayēna prōcuḥ, amuṁ varāhavrajam āśrayitum asmān anujānīhi; tataḥ sōnujajñau|</para>
  <para style="p">
    <verse number="33" style="v"/>tataḥ paraṁ bhūtāstaṁ mānuṣaṁ vihāya varāhavrajam āśiśriyuḥ varāhavrajāśca tatkṣaṇāt kaṭakēna dhāvantō hradē prāṇān vijr̥huḥ|</para>
  <para style="p">
    <verse number="34" style="v"/>tad dr̥ṣṭvā śūkararakṣakāḥ palāyamānā nagaraṁ grāmañca gatvā tatsarvvavr̥ttāntaṁ kathayāmāsuḥ|</para>
  <para style="p">
    <verse number="35" style="v"/>tataḥ kiṁ vr̥ttam ētaddarśanārthaṁ lōkā nirgatya yīśōḥ samīpaṁ yayuḥ, taṁ mānuṣaṁ tyaktabhūtaṁ parihitavastraṁ svasthamānuṣavad yīśōścaraṇasannidhau sūpaviśantaṁ vilōkya bibhyuḥ|</para>
  <para style="p">
    <verse number="36" style="v"/>yē lōkāstasya bhūtagrastasya svāsthyakaraṇaṁ dadr̥śustē tēbhyaḥ sarvvavr̥ttāntaṁ kathayāmāsuḥ|</para>
  <para style="p">
    <verse number="37" style="v"/>tadanantaraṁ tasya gidērīyapradēśasya caturdiksthā bahavō janā atitrastā vinayēna taṁ jagaduḥ, bhavān asmākaṁ nikaṭād vrajatu tasmāt sa nāvamāruhya tatō vyāghuṭya jagāma|</para>
  <para style="p">
    <verse number="38" style="v"/>tadānīṁ tyaktabhūtamanujastēna saha sthātuṁ prārthayāñcakrē</para>
  <para style="p">
    <verse number="39" style="v"/>kintu tadartham īśvaraḥ kīdr̥ṅmahākarmma kr̥tavān iti nivēśanaṁ gatvā vijñāpaya, yīśuḥ kathāmētāṁ kathayitvā taṁ visasarja| tataḥ sa vrajitvā yīśustadarthaṁ yanmahākarmma cakāra tat purasya sarvvatra prakāśayituṁ prārēbhē|</para>
  <para style="p">
    <verse number="40" style="v"/>atha yīśau parāvr̥tyāgatē lōkāstaṁ ādarēṇa jagr̥hu ryasmāttē sarvvē tamapēkṣāñcakrirē|</para>
  <para style="p">
    <verse number="41" style="v"/>tadanantaraṁ yāyīrnāmnō bhajanagēhasyaikōdhipa āgatya yīśōścaraṇayōḥ patitvā svanivēśanāgamanārthaṁ tasmin vinayaṁ cakāra,</para>
  <para style="p">
    <verse number="42" style="v"/>yatastasya dvādaśavarṣavayaskā kanyaikāsīt sā mr̥takalpābhavat| tatastasya gamanakālē mārgē lōkānāṁ mahān samāgamō babhūva|</para>
  <para style="p">
    <verse number="43" style="v"/>dvādaśavarṣāṇi pradararōgagrastā nānā vaidyaiścikitsitā sarvvasvaṁ vyayitvāpi svāsthyaṁ na prāptā yā yōṣit sā yīśōḥ paścādāgatya tasya vastragranthiṁ pasparśa|</para>
  <para style="p">
    <verse number="44" style="v"/>tasmāt tatkṣaṇāt tasyā raktasrāvō ruddhaḥ|</para>
  <para style="p">
    <verse number="45" style="v"/>tadānīṁ yīśuravadat kēnāhaṁ spr̥ṣṭaḥ? tatō'nēkairanaṅgīkr̥tē pitarastasya saṅginaścāvadan, hē gurō lōkā nikaṭasthāḥ santastava dēhē gharṣayanti, tathāpi kēnāhaṁ spr̥ṣṭa̮iti bhavān kutaḥ pr̥cchati?</para>
  <para style="p">
    <verse number="46" style="v"/>yīśuḥ kathayāmāsa, kēnāpyahaṁ spr̥ṣṭō, yatō mattaḥ śakti rnirgatēti mayā niścitamajñāyi|</para>
  <para style="p">
    <verse number="47" style="v"/>tadā sā nārī svayaṁ na guptēti viditvā kampamānā satī tasya sammukhē papāta; yēna nimittēna taṁ pasparśa sparśamātrācca yēna prakārēṇa svasthābhavat tat sarvvaṁ tasya sākṣādācakhyau|</para>
  <para style="p">
    <verse number="48" style="v"/>tataḥ sa tāṁ jagāda hē kanyē susthirā bhava, tava viśvāsastvāṁ svasthām akārṣīt tvaṁ kṣēmēṇa yāhi|</para>
  <para style="p">
    <verse number="49" style="v"/>yīśōrētadvākyavadanakālē tasyādhipatē rnivēśanāt kaścillōka āgatya taṁ babhāṣē, tava kanyā mr̥tā guruṁ mā kliśāna|</para>
  <para style="p">
    <verse number="50" style="v"/>kintu yīśustadākarṇyādhipatiṁ vyājahāra, mā bhaiṣīḥ kēvalaṁ viśvasihi tasmāt sā jīviṣyati|</para>
  <para style="p">
    <verse number="51" style="v"/>atha tasya nivēśanē prāptē sa pitaraṁ yōhanaṁ yākūbañca kanyāyā mātaraṁ pitarañca vinā, anyaṁ kañcana pravēṣṭuṁ vārayāmāsa|</para>
  <para style="p">
    <verse number="52" style="v"/>aparañca yē rudanti vilapanti ca tān sarvvān janān uvāca, yūyaṁ mā rōdiṣṭa kanyā na mr̥tā nidrāti|</para>
  <para style="p">
    <verse number="53" style="v"/>kintu sā niścitaṁ mr̥tēti jñātvā tē tamupajahasuḥ|</para>
  <para style="p">
    <verse number="54" style="v"/>paścāt sa sarvvān bahiḥ kr̥tvā kanyāyāḥ karau dhr̥tvājuhuvē, hē kanyē tvamuttiṣṭha,</para>
  <para style="p">
    <verse number="55" style="v"/>tasmāt tasyāḥ prāṇēṣu punarāgatēṣu sā tatkṣaṇād uttasyau| tadānīṁ tasyai kiñcid bhakṣyaṁ dātum ādidēśa|</para>
  <para style="p">
    <verse number="56" style="v"/>tatastasyāḥ pitarau vismayaṁ gatau kintu sa tāvādidēśa ghaṭanāyā ētasyāḥ kathāṁ kasmaicidapi mā kathayataṁ|</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tataḥ paraṁ sa dvādaśaśiṣyānāhūya bhūtān tyājayituṁ rōgān pratikarttuñca tēbhyaḥ śaktimādhipatyañca dadau|</para>
  <para style="p">
    <verse number="2" style="v"/>aparañca īśvarīyarājyasya susaṁvādaṁ prakāśayitum rōgiṇāmārōgyaṁ karttuñca prēraṇakālē tān jagāda|</para>
  <para style="p">
    <verse number="3" style="v"/>yātrārthaṁ yaṣṭi rvastrapuṭakaṁ bhakṣyaṁ mudrā dvitīyavastram, ēṣāṁ kimapi mā gr̥hlīta|</para>
  <para style="p">
    <verse number="4" style="v"/>yūyañca yannivēśanaṁ praviśatha nagaratyāgaparyyanataṁ tannivēśanē tiṣṭhata|</para>
  <para style="p">
    <verse number="5" style="v"/>tatra yadi kasyacit purasya lōkā yuṣmākamātithyaṁ na kurvvanti tarhi tasmānnagarād gamanakālē tēṣāṁ viruddhaṁ sākṣyārthaṁ yuṣmākaṁ padadhūlīḥ sampātayata|</para>
  <para style="p">
    <verse number="6" style="v"/>atha tē prasthāya sarvvatra susaṁvādaṁ pracārayituṁ pīḍitān svasthān karttuñca grāmēṣu bhramituṁ prārēbhirē|</para>
  <para style="p">
    <verse number="7" style="v"/>ētarhi hērōd rājā yīśōḥ sarvvakarmmaṇāṁ vārttāṁ śrutvā bhr̥śamudvivijē</para>
  <para style="p">
    <verse number="8" style="v"/>yataḥ kēcidūcuryōhan śmaśānādudatiṣṭhat| kēcidūcuḥ, ēliyō darśanaṁ dattavān; ēvamanyalōkā ūcuḥ pūrvvīyaḥ kaścid bhaviṣyadvādī samutthitaḥ|</para>
  <para style="p">
    <verse number="9" style="v"/>kintu hērōduvāca yōhanaḥ śirō'hamachinadam idānīṁ yasyēdr̥kkarmmaṇāṁ vārttāṁ prāpnōmi sa kaḥ? atha sa taṁ draṣṭum aicchat|</para>
  <para style="p">
    <verse number="10" style="v"/>anantaraṁ prēritāḥ pratyāgatya yāni yāni karmmāṇi cakrustāni yīśavē kathayāmāsuḥ tataḥ sa tān baitsaidānāmakanagarasya vijanaṁ sthānaṁ nītvā guptaṁ jagāma|</para>
  <para style="p">
    <verse number="11" style="v"/>paścāl lōkāstad viditvā tasya paścād yayuḥ; tataḥ sa tān nayan īśvarīyarājyasya prasaṅgamuktavān, yēṣāṁ cikitsayā prayōjanam āsīt tān svasthān cakāra ca|</para>
  <para style="p">
    <verse number="12" style="v"/>aparañca divāvasannē sati dvādaśaśiṣyā yīśōrantikam ētya kathayāmāsuḥ, vayamatra prāntarasthānē tiṣṭhāmaḥ, tatō nagarāṇi grāmāṇi gatvā vāsasthānāni prāpya bhakṣyadravyāṇi krētuṁ jananivahaṁ bhavān visr̥jatu|</para>
  <para style="p">
    <verse number="13" style="v"/>tadā sa uvāca, yūyamēva tān bhējayadhvaṁ; tatastē prōcurasmākaṁ nikaṭē kēvalaṁ pañca pūpā dvau matsyau ca vidyantē, ataēva sthānāntaram itvā nimittamētēṣāṁ bhakṣyadravyēṣu na krītēṣu na bhavati|</para>
  <para style="p">
    <verse number="14" style="v"/>tatra prāyēṇa pañcasahasrāṇi puruṣā āsan|</para>
  <para style="p">
    <verse number="15" style="v"/>tadā sa śiṣyān jagāda pañcāśat pañcāśajjanaiḥ paṁktīkr̥tya tānupavēśayata, tasmāt tē tadanusārēṇa sarvvalōkānupavēśayāpāsuḥ|</para>
  <para style="p">
    <verse number="16" style="v"/>tataḥ sa tān pañca pūpān mīnadvayañca gr̥hītvā svargaṁ vilōkyēśvaraguṇān kīrttayāñcakrē bhaṅktā ca lōkēbhyaḥ parivēṣaṇārthaṁ śiṣyēṣu samarpayāmbabhūva|</para>
  <para style="p">
    <verse number="17" style="v"/>tataḥ sarvvē bhuktvā tr̥ptiṁ gatā avaśiṣṭānāñca dvādaśa ḍallakān saṁjagr̥huḥ|</para>
  <para style="p">
    <verse number="18" style="v"/>athaikadā nirjanē śiṣyaiḥ saha prārthanākālē tān papraccha, lōkā māṁ kaṁ vadanti?</para>
  <para style="p">
    <verse number="19" style="v"/>tatastē prācuḥ, tvāṁ yōhanmajjakaṁ vadanti; kēcit tvām ēliyaṁ vadanti, pūrvvakālikaḥ kaścid bhaviṣyadvādī śmaśānād udatiṣṭhad ityapi kēcid vadanti|</para>
  <para style="p">
    <verse number="20" style="v"/>tadā sa uvāca, yūyaṁ māṁ kaṁ vadatha? tataḥ pitara uktavān tvam īśvarābhiṣiktaḥ puruṣaḥ|</para>
  <para style="p">
    <verse number="21" style="v"/>tadā sa tān dr̥ḍhamādidēśa, kathāmētāṁ kasmaicidapi mā kathayata|</para>
  <para style="p">
    <verse number="22" style="v"/>sa punaruvāca, manuṣyaputrēṇa vahuyātanā bhōktavyāḥ prācīnalōkaiḥ pradhānayājakairadhyāpakaiśca sōvajñāya hantavyaḥ kintu tr̥tīyadivasē śmaśānāt tēnōtthātavyam|</para>
  <para style="p">
    <verse number="23" style="v"/>aparaṁ sa sarvvānuvāca, kaścid yadi mama paścād gantuṁ vāñchati tarhi sa svaṁ dāmyatu, dinē dinē kruśaṁ gr̥hītvā ca mama paścādāgacchatu|</para>
  <para style="p">
    <verse number="24" style="v"/>yatō yaḥ kaścit svaprāṇān rirakṣiṣati sa tān hārayiṣyati, yaḥ kaścin madarthaṁ prāṇān hārayiṣyati sa tān rakṣiṣyati|</para>
  <para style="p">
    <verse number="25" style="v"/>kaścid yadi sarvvaṁ jagat prāpnōti kintu svaprāṇān hārayati svayaṁ vinaśyati ca tarhi tasya kō lābhaḥ?</para>
  <para style="p">
    <verse number="26" style="v"/>puna ryaḥ kaścin māṁ mama vākyaṁ vā lajjāspadaṁ jānāti manuṣyaputrō yadā svasya pituśca pavitrāṇāṁ dūtānāñca tējōbhiḥ parivēṣṭita āgamiṣyati tadā sōpi taṁ lajjāspadaṁ jñāsyati|</para>
  <para style="p">
    <verse number="27" style="v"/>kintu yuṣmānahaṁ yathārthaṁ vadāmi, īśvarīyarājatvaṁ na dr̥ṣṭavā mr̥tyuṁ nāsvādiṣyantē, ētādr̥śāḥ kiyantō lōkā atra sthanē'pi daṇḍāyamānāḥ santi|</para>
  <para style="p">
    <verse number="28" style="v"/>ētadākhyānakathanāt paraṁ prāyēṇāṣṭasu dinēṣu gatēṣu sa pitaraṁ yōhanaṁ yākūbañca gr̥hītvā prārthayituṁ parvvatamēkaṁ samārurōha|</para>
  <para style="p">
    <verse number="29" style="v"/>atha tasya prārthanakālē tasya mukhākr̥tiranyarūpā jātā, tadīyaṁ vastramujjvalaśuklaṁ jātaṁ|</para>
  <para style="p">
    <verse number="30" style="v"/>aparañca mūsā ēliyaścōbhau tējasvinau dr̥ṣṭau</para>
  <para style="p">
    <verse number="31" style="v"/>tau tēna yirūśālampurē yō mr̥tyuḥ sādhiṣyatē tadīyāṁ kathāṁ tēna sārddhaṁ kathayitum ārēbhātē|</para>
  <para style="p">
    <verse number="32" style="v"/>tadā pitarādayaḥ svasya saṅginō nidrayākr̥ṣṭā āsan kintu jāgaritvā tasya tējastēna sārddham uttiṣṭhantau janau ca dadr̥śuḥ|</para>
  <para style="p">
    <verse number="33" style="v"/>atha tayōrubhayō rgamanakālē pitarō yīśuṁ babhāṣē, hē gurō'smākaṁ sthānē'smin sthitiḥ śubhā, tata ēkā tvadarthā, ēkā mūsārthā, ēkā ēliyārthā, iti tisraḥ kuṭyōsmābhi rnirmmīyantāṁ, imāṁ kathāṁ sa na vivicya kathayāmāsa|</para>
  <para style="p">
    <verse number="34" style="v"/>aparañca tadvākyavadanakālē payōda ēka āgatya tēṣāmupari chāyāṁ cakāra, tatastanmadhyē tayōḥ pravēśāt tē śaśaṅkirē|</para>
  <para style="p">
    <verse number="35" style="v"/>tadā tasmāt payōdād iyamākāśīyā vāṇī nirjagāma, mamāyaṁ priyaḥ putra ētasya kathāyāṁ manō nidhatta|</para>
  <para style="p">
    <verse number="36" style="v"/>iti śabdē jātē tē yīśumēkākinaṁ dadr̥śuḥ kintu tē tadānīṁ tasya darśanasya vācamēkāmapi nōktvā manaḥsu sthāpayāmāsuḥ|</para>
  <para style="p">
    <verse number="37" style="v"/>parē'hani tēṣu tasmācchailād avarūḍhēṣu taṁ sākṣāt karttuṁ bahavō lōkā ājagmuḥ|</para>
  <para style="p">
    <verse number="38" style="v"/>tēṣāṁ madhyād ēkō jana uccairuvāca, hē gurō ahaṁ vinayaṁ karōmi mama putraṁ prati kr̥pādr̥ṣṭiṁ karōtu, mama sa ēvaikaḥ putraḥ|</para>
  <para style="p">
    <verse number="39" style="v"/>bhūtēna dhr̥taḥ san saṁ prasabhaṁ cīcchabdaṁ karōti tanmukhāt phēṇā nirgacchanti ca, bhūta itthaṁ vidāryya kliṣṭvā prāyaśastaṁ na tyajati|</para>
  <para style="p">
    <verse number="40" style="v"/>tasmāt taṁ bhūtaṁ tyājayituṁ tava śiṣyasamīpē nyavēdayaṁ kintu tē na śēkuḥ|</para>
  <para style="p">
    <verse number="41" style="v"/>tadā yīśuravādīt, rē āviśvāsin vipathagāmin vaṁśa katikālān yuṣmābhiḥ saha sthāsyāmyahaṁ yuṣmākam ācaraṇāni ca sahiṣyē? tava putramihānaya|</para>
  <para style="p">
    <verse number="42" style="v"/>tatastasminnāgatamātrē bhūtastaṁ bhūmau pātayitvā vidadāra; tadā yīśustamamēdhyaṁ bhūtaṁ tarjayitvā bālakaṁ svasthaṁ kr̥tvā tasya pitari samarpayāmāsa|</para>
  <para style="p">
    <verse number="43" style="v"/>īśvarasya mahāśaktim imāṁ vilōkya sarvvē camaccakruḥ; itthaṁ yīśōḥ sarvvābhiḥ kriyābhiḥ sarvvairlōkairāścaryyē manyamānē sati sa śiṣyān babhāṣē,</para>
  <para style="p">
    <verse number="44" style="v"/>kathēyaṁ yuṣmākaṁ karṇēṣu praviśatu, manuṣyaputrō manuṣyāṇāṁ karēṣu samarpayiṣyatē|</para>
  <para style="p">
    <verse number="45" style="v"/>kintu tē tāṁ kathāṁ na bubudhirē, spaṣṭatvābhāvāt tasyā abhiprāyastēṣāṁ bōdhagamyō na babhūva; tasyā āśayaḥ ka ityapi tē bhayāt praṣṭuṁ na śēkuḥ|</para>
  <para style="p">
    <verse number="46" style="v"/>tadanantaraṁ tēṣāṁ madhyē kaḥ śrēṣṭhaḥ kathāmētāṁ gr̥hītvā tē mithō vivādaṁ cakruḥ|</para>
  <para style="p">
    <verse number="47" style="v"/>tatō yīśustēṣāṁ manōbhiprāyaṁ viditvā bālakamēkaṁ gr̥hītvā svasya nikaṭē sthāpayitvā tān jagāda,</para>
  <para style="p">
    <verse number="48" style="v"/>yō janō mama nāmnāsya bālāsyātithyaṁ vidadhāti sa mamātithyaṁ vidadhāti, yaśca mamātithyaṁ vidadhāti sa mama prērakasyātithyaṁ vidadhāti, yuṣmākaṁ madhyēyaḥ svaṁ sarvvasmāt kṣudraṁ jānītē sa ēva śrēṣṭhō bhaviṣyati|</para>
  <para style="p">
    <verse number="49" style="v"/>aparañca yōhan vyājahāra hē prabhēा tava nāmnā bhūtān tyājayantaṁ mānuṣam ēkaṁ dr̥ṣṭavantō vayaṁ, kintvasmākam apaścād gāmitvāt taṁ nyaṣēdhām| tadānīṁ yīśuruvāca,</para>
  <para style="p">
    <verse number="50" style="v"/>taṁ mā niṣēdhata, yatō yō janōsmākaṁ na vipakṣaḥ sa ēvāsmākaṁ sapakṣō bhavati|</para>
  <para style="p">
    <verse number="51" style="v"/>anantaraṁ tasyārōhaṇasamaya upasthitē sa sthiracētā yirūśālamaṁ prati yātrāṁ karttuṁ niścityāgrē dūtān prēṣayāmāsa|</para>
  <para style="p">
    <verse number="52" style="v"/>tasmāt tē gatvā tasya prayōjanīyadravyāṇi saṁgrahītuṁ śōmirōṇīyānāṁ grāmaṁ praviviśuḥ|</para>
  <para style="p">
    <verse number="53" style="v"/>kintu sa yirūśālamaṁ nagaraṁ yāti tatō hētō rlōkāstasyātithyaṁ na cakruḥ|</para>
  <para style="p">
    <verse number="54" style="v"/>ataēva yākūbyōhanau tasya śiṣyau tad dr̥ṣṭvā jagadatuḥ, hē prabhō ēliyō yathā cakāra tathā vayamapi kiṁ gagaṇād āgantum ētān bhasmīkarttuñca vahnimājñāpayāmaḥ? bhavān kimicchati?</para>
  <para style="p">
    <verse number="55" style="v"/>kintu sa mukhaṁ parāvartya tān tarjayitvā gaditavān yuṣmākaṁ manōbhāvaḥ kaḥ, iti yūyaṁ na jānītha|</para>
  <para style="p">
    <verse number="56" style="v"/>manujasutō manujānāṁ prāṇān nāśayituṁ nāgacchat, kintu rakṣitum āgacchat| paścād itaragrāmaṁ tē yayuḥ|</para>
  <para style="p">
    <verse number="57" style="v"/>tadanantaraṁ pathi gamanakālē jana ēkastaṁ babhāṣē, hē prabhō bhavān yatra yāti bhavatā sahāhamapi tatra yāsyāmi|</para>
  <para style="p">
    <verse number="58" style="v"/>tadānīṁ yīśustamuvāca, gōmāyūnāṁ garttā āsatē, vihāyasīyavihagāाnāṁ nīḍāni ca santi, kintu mānavatanayasya śiraḥ sthāpayituṁ sthānaṁ nāsti|</para>
  <para style="p">
    <verse number="59" style="v"/>tataḥ paraṁ sa itarajanaṁ jagāda, tvaṁ mama paścād ēhi; tataḥ sa uvāca, hē prabhō pūrvvaṁ pitaraṁ śmaśānē sthāpayituṁ māmādiśatu|</para>
  <para style="p">
    <verse number="60" style="v"/>tadā yīśuruvāca, mr̥tā mr̥tān śmaśānē sthāpayantu kintu tvaṁ gatvēśvarīyarājyasya kathāṁ pracāraya|</para>
  <para style="p">
    <verse number="61" style="v"/>tatōnyaḥ kathayāmāsa, hē prabhō mayāpi bhavataḥ paścād gaṁsyatē, kintu pūrvvaṁ mama nivēśanasya parijanānām anumatiṁ grahītum ahamādiśyai bhavatā|</para>
  <para style="p">
    <verse number="62" style="v"/>tadānīṁ yīśustaṁ prōktavān, yō janō lāṅgalē karamarpayitvā paścāt paśyati sa īśvarīyarājyaṁ nārhati|</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tataḥ paraṁ prabhuraparān saptatiśiṣyān niyujya svayaṁ yāni nagarāṇi yāni sthānāni ca gamiṣyati tāni nagarāṇi tāni sthānāni ca prati dvau dvau janau prahitavān|</para>
  <para style="p">
    <verse number="2" style="v"/>tēbhyaḥ kathayāmāsa ca śasyāni bahūnīti satyaṁ kintu chēdakā alpē; tasmāddhētōḥ śasyakṣētrē chēdakān aparānapi prēṣayituṁ kṣētrasvāminaṁ prārthayadhvaṁ|</para>
  <para style="p">
    <verse number="3" style="v"/>yūyaṁ yāta, paśyata, vr̥kāṇāṁ madhyē mēṣaśāvakāniva yuṣmān prahiṇōmi|</para>
  <para style="p">
    <verse number="4" style="v"/>yūyaṁ kṣudraṁ mahad vā vasanasampuṭakaṁ pādukāśca mā gr̥hlīta, mārgamadhyē kamapi mā namata ca|</para>
  <para style="p">
    <verse number="5" style="v"/>aparañca yūyaṁ yad yat nivēśanaṁ praviśatha tatra nivēśanasyāsya maṅgalaṁ bhūyāditi vākyaṁ prathamaṁ vadata|</para>
  <para style="p">
    <verse number="6" style="v"/>tasmāt tasmin nivēśanē yadi maṅgalapātraṁ sthāsyati tarhi tanmaṅgalaṁ tasya bhaviṣyati, nōcēt yuṣmān prati parāvarttiṣyatē|</para>
  <para style="p">
    <verse number="7" style="v"/>aparañca tē yatkiñcid dāsyanti tadēva bhuktvā pītvā tasminnivēśanē sthāsyatha; yataḥ karmmakārī janō bhr̥tim arhati; gr̥hād gr̥haṁ mā yāsyatha|</para>
  <para style="p">
    <verse number="8" style="v"/>anyacca yuṣmāsu kimapi nagaraṁ praviṣṭēṣu lōkā yadi yuṣmākam ātithyaṁ kariṣyanti, tarhi yat khādyam upasthāsyanti tadēva khādiṣyatha|</para>
  <para style="p">
    <verse number="9" style="v"/>tannagarasthān rōgiṇaḥ svasthān kariṣyatha, īśvarīyaṁ rājyaṁ yuṣmākam antikam āgamat kathāmētāñca pracārayiṣyatha|</para>
  <para style="p">
    <verse number="10" style="v"/>kintu kimapi puraṁ yuṣmāsu praviṣṭēṣu lōkā yadi yuṣmākam ātithyaṁ na kariṣyanti, tarhi tasya nagarasya panthānaṁ gatvā kathāmētāṁ vadiṣyatha,</para>
  <para style="p">
    <verse number="11" style="v"/>yuṣmākaṁ nagarīyā yā dhūlyō'smāsu samalagan tā api yuṣmākaṁ prātikūlyēna sākṣyārthaṁ sampātayāmaḥ; tathāpīśvararājyaṁ yuṣmākaṁ samīpam āgatam iti niścitaṁ jānīta|</para>
  <para style="p">
    <verse number="12" style="v"/>ahaṁ yuṣmabhyaṁ yathārthaṁ kathayāmi, vicāradinē tasya nagarasya daśātaḥ sidōmō daśā sahyā bhaviṣyati|</para>
  <para style="p">
    <verse number="13" style="v"/>hā hā kōrāsīn nagara, hā hā baitsaidānagara yuvayōrmadhyē yādr̥śāni āścaryyāṇi karmmāṇyakriyanta, tāni karmmāṇi yadi sōrasīdōnō rnagarayōrakāriṣyanta, tadā itō bahudinapūrvvaṁ tannivāsinaḥ śaṇavastrāṇi paridhāya gātrēṣu bhasma vilipya samupaviśya samakhētsyanta|</para>
  <para style="p">
    <verse number="14" style="v"/>atō vicāradivasē yuṣmākaṁ daśātaḥ sōrasīdōnnivāsināṁ daśā sahyā bhaviṣyati|</para>
  <para style="p">
    <verse number="15" style="v"/>hē kapharnāhūm, tvaṁ svargaṁ yāvad unnatā kintu narakaṁ yāvat nyagbhaviṣyasi|</para>
  <para style="p">
    <verse number="16" style="v"/>yō janō yuṣmākaṁ vākyaṁ gr̥hlāti sa mamaiva vākyaṁ gr̥hlāti; kiñca yō janō yuṣmākam avajñāṁ karōti sa mamaivāvajñāṁ karōti; yō janō mamāvajñāṁ karōti ca sa matprērakasyaivāvajñāṁ karōti|</para>
  <para style="p">
    <verse number="17" style="v"/>atha tē saptatiśiṣyā ānandēna pratyāgatya kathayāmāsuḥ, hē prabhō bhavatō nāmnā bhūtā apyasmākaṁ vaśībhavanti|</para>
  <para style="p">
    <verse number="18" style="v"/>tadānīṁ sa tān jagāda, vidyutamiva svargāt patantaṁ śaitānam adarśam|</para>
  <para style="p">
    <verse number="19" style="v"/>paśyata sarpān vr̥ścikān ripōḥ sarvvaparākramāṁśca padatalai rdalayituṁ yuṣmabhyaṁ śaktiṁ dadāmi tasmād yuṣmākaṁ kāpi hāni rna bhaviṣyati|</para>
  <para style="p">
    <verse number="20" style="v"/>bhūtā yuṣmākaṁ vaśībhavanti, ētannimittat mā samullasata, svargē yuṣmākaṁ nāmāni likhitāni santīti nimittaṁ samullasata|</para>
  <para style="p">
    <verse number="21" style="v"/>tadghaṭikāyāṁ yīśu rmanasi jātāhlādaḥ kathayāmāsa hē svargapr̥thivyōrēkādhipatē pitastvaṁ jñānavatāṁ viduṣāñca lōkānāṁ purastāt sarvvamētad aprakāśya bālakānāṁ purastāt prākāśaya ētasmāddhētōstvāṁ dhanyaṁ vadāmi, hē pitaritthaṁ bhavatu yad ētadēva tava gōcara uttamam|</para>
  <para style="p">
    <verse number="22" style="v"/>pitrā sarvvāṇi mayi samarpitāni pitaraṁ vinā kōpi putraṁ na jānāti kiñca putraṁ vinā yasmai janāya putrastaṁ prakāśitavān tañca vinā kōpi pitaraṁ na jānāti|</para>
  <para style="p">
    <verse number="23" style="v"/>tapaḥ paraṁ sa śiṣyān prati parāvr̥tya guptaṁ jagāda, yūyamētāni sarvvāṇi paśyatha tatō yuṣmākaṁ cakṣūṁṣi dhanyāni|</para>
  <para style="p">
    <verse number="24" style="v"/>yuṣmānahaṁ vadāmi, yūyaṁ yāni sarvvāṇi paśyatha tāni bahavō bhaviṣyadvādinō bhūpatayaśca draṣṭumicchantōpi draṣṭuṁ na prāpnuvan, yuṣmābhi ryā yāḥ kathāśca śrūyantē tāḥ śrōtumicchantōpi śrōtuṁ nālabhanta|</para>
  <para style="p">
    <verse number="25" style="v"/>anantaram ēkō vyavasthāpaka utthāya taṁ parīkṣituṁ papraccha, hē upadēśaka anantāyuṣaḥ prāptayē mayā kiṁ karaṇīyaṁ?</para>
  <para style="p">
    <verse number="26" style="v"/>yīśuḥ pratyuvāca, atrārthē vyavasthāyāṁ kiṁ likhitamasti? tvaṁ kīdr̥k paṭhasi?</para>
  <para style="p">
    <verse number="27" style="v"/>tataḥ sōvadat, tvaṁ sarvvāntaḥkaraṇaiḥ sarvvaprāṇaiḥ sarvvaśaktibhiḥ sarvvacittaiśca prabhau paramēśvarē prēma kuru, samīpavāsini svavat prēma kuru ca|</para>
  <para style="p">
    <verse number="28" style="v"/>tadā sa kathayāmāsa, tvaṁ yathārthaṁ pratyavōcaḥ, ittham ācara tēnaiva jīviṣyasi|</para>
  <para style="p">
    <verse number="29" style="v"/>kintu sa janaḥ svaṁ nirddōṣaṁ jñāpayituṁ yīśuṁ papraccha, mama samīpavāsī kaḥ? tatō yīśuḥ pratyuvāca,</para>
  <para style="p">
    <verse number="30" style="v"/>ēkō janō yirūśālampurād yirīhōpuraṁ yāti, ētarhi dasyūnāṁ karēṣu patitē tē tasya vastrādikaṁ hr̥tavantaḥ tamāhatya mr̥taprāyaṁ kr̥tvā tyaktvā yayuḥ|</para>
  <para style="p">
    <verse number="31" style="v"/>akasmād ēkō yājakastēna mārgēṇa gacchan taṁ dr̥ṣṭvā mārgānyapārśvēna jagāma|</para>
  <para style="p">
    <verse number="32" style="v"/>ittham ēkō lēvīyastatsthānaṁ prāpya tasyāntikaṁ gatvā taṁ vilōkyānyēna pārśvēna jagāma|</para>
  <para style="p">
    <verse number="33" style="v"/>kintvēkaḥ śōmirōṇīyō gacchan tatsthānaṁ prāpya taṁ dr̥ṣṭvādayata|</para>
  <para style="p">
    <verse number="34" style="v"/>tasyāntikaṁ gatvā tasya kṣatēṣu tailaṁ drākṣārasañca prakṣipya kṣatāni baddhvā nijavāhanōpari tamupavēśya pravāsīyagr̥ham ānīya taṁ siṣēvē|</para>
  <para style="p">
    <verse number="35" style="v"/>parasmin divasē nijagamanakālē dvau mudrāpādau tadgr̥hasvāminē dattvāvadat janamēnaṁ sēvasva tatra yō'dhikō vyayō bhaviṣyati tamahaṁ punarāgamanakālē pariśōtsyāmi|</para>
  <para style="p">
    <verse number="36" style="v"/>ēṣāṁ trayāṇāṁ madhyē tasya dasyuhastapatitasya janasya samīpavāsī kaḥ? tvayā kiṁ budhyatē?</para>
  <para style="p">
    <verse number="37" style="v"/>tataḥ sa vyavasthāpakaḥ kathayāmāsa yastasmin dayāṁ cakāra| tadā yīśuḥ kathayāmāsa tvamapi gatvā tathācara|</para>
  <para style="p">
    <verse number="38" style="v"/>tataḥ paraṁ tē gacchanta ēkaṁ grāmaṁ praviviśuḥ; tadā marthānāmā strī svagr̥hē tasyātithyaṁ cakāra|</para>
  <para style="p">
    <verse number="39" style="v"/>tasmāt mariyam nāmadhēyā tasyā bhaginī yīśōḥ padasamīpa uvaviśya tasyōpadēśakathāṁ śrōtumārēbhē|</para>
  <para style="p">
    <verse number="40" style="v"/>kintu marthā nānāparicaryyāyāṁ vyagrā babhūva tasmāddhētōstasya samīpamāgatya babhāṣē; hē prabhō mama bhaginī kēvalaṁ mamōpari sarvvakarmmaṇāṁ bhāram arpitavatī tatra bhavatā kiñcidapi na manō nidhīyatē kim? mama sāhāyyaṁ karttuṁ bhavān tāmādiśatu|</para>
  <para style="p">
    <verse number="41" style="v"/>tatō yīśuḥ pratyuvāca hē marthē hē marthē, tvaṁ nānākāryyēṣu cintitavatī vyagrā cāsi,</para>
  <para style="p">
    <verse number="42" style="v"/>kintu prayōjanīyam ēkamātram āstē| aparañca yamuttamaṁ bhāgaṁ kōpi harttuṁ na śaknōti saēva mariyamā vr̥taḥ|</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ sa kasmiṁścit sthānē prārthayata tatsamāptau satyāṁ tasyaikaḥ śiṣyastaṁ jagāda hē prabhō yōhan yathā svaśiṣyān prārthayitum upadiṣṭavān tathā bhavānapyasmān upadiśatu|</para>
  <para style="p">
    <verse number="2" style="v"/>tasmāt sa kathayāmāsa, prārthanakālē yūyam itthaṁ kathayadhvaṁ, hē asmākaṁ svargasthapitastava nāma pūjyaṁ bhavatu; tava rājatvaṁ bhavatu; svargē yathā tathā pr̥thivyāmapi tavēcchayā sarvvaṁ bhavatu|</para>
  <para style="p">
    <verse number="3" style="v"/>pratyaham asmākaṁ prayōjanīyaṁ bhōjyaṁ dēhi|</para>
  <para style="p">
    <verse number="4" style="v"/>yathā vayaṁ sarvvān aparādhinaḥ kṣamāmahē tathā tvamapi pāpānyasmākaṁ kṣamasva| asmān parīkṣāṁ mānaya kintu pāpātmanō rakṣa|</para>
  <para style="p">
    <verse number="5" style="v"/>paścāt sōparamapi kathitavān yadi yuṣmākaṁ kasyacid bandhustiṣṭhati niśīthē ca tasya samīpaṁ sa gatvā vadati,</para>
  <para style="p">
    <verse number="6" style="v"/>hē bandhō pathika ēkō bandhu rmama nivēśanam āyātaḥ kintu tasyātithyaṁ karttuṁ mamāntikē kimapi nāsti, ataēva pūpatrayaṁ mahyam r̥ṇaṁ dēhi;</para>
  <para style="p">
    <verse number="7" style="v"/>tadā sa yadi gr̥hamadhyāt prativadati māṁ mā kliśāna, idānīṁ dvāraṁ ruddhaṁ śayanē mayā saha bālakāśca tiṣṭhanti tubhyaṁ dātum utthātuṁ na śaknōmi,</para>
  <para style="p">
    <verse number="8" style="v"/>tarhi yuṣmānahaṁ vadāmi, sa yadi mitratayā tasmai kimapi dātuṁ nōttiṣṭhati tathāpi vāraṁ vāraṁ prārthanāta utthāpitaḥ san yasmin tasya prayōjanaṁ tadēva dāsyati|</para>
  <para style="p">
    <verse number="9" style="v"/>ataḥ kāraṇāt kathayāmi, yācadhvaṁ tatō yuṣmabhyaṁ dāsyatē, mr̥gayadhvaṁ tata uddēśaṁ prāpsyatha, dvāram āhata tatō yuṣmabhyaṁ dvāraṁ mōkṣyatē|</para>
  <para style="p">
    <verse number="10" style="v"/>yō yācatē sa prāpnōti, yō mr̥gayatē sa ēvōddēśaṁ prāpnōti, yō dvāram āhanti tadarthaṁ dvāraṁ mōcyatē|</para>
  <para style="p">
    <verse number="11" style="v"/>putrēṇa pūpē yācitē tasmai pāṣāṇaṁ dadāti vā matsyē yācitē tasmai sarpaṁ dadāti</para>
  <para style="p">
    <verse number="12" style="v"/>vā aṇḍē yācitē tasmai vr̥ścikaṁ dadāti yuṣmākaṁ madhyē ka ētādr̥śaḥ pitāstē?</para>
  <para style="p">
    <verse number="13" style="v"/>tasmādēva yūyamabhadrā api yadi svasvabālakēbhya uttamāni dravyāṇi dātuṁ jānītha tarhyasmākaṁ svargasthaḥ pitā nijayācakēbhyaḥ kiṁ pavitram ātmānaṁ na dāsyati?</para>
  <para style="p">
    <verse number="14" style="v"/>anantaraṁ yīśunā kasmāccid ēkasmin mūkabhūtē tyājitē sati sa bhūtatyaktō mānuṣō vākyaṁ vaktum ārēbhē; tatō lōkāḥ sakalā āścaryyaṁ mēnirē|</para>
  <para style="p">
    <verse number="15" style="v"/>kintu tēṣāṁ kēcidūcu rjanōyaṁ bālasibūbā arthād bhūtarājēna bhūtān tyājayati|</para>
  <para style="p">
    <verse number="16" style="v"/>taṁ parīkṣituṁ kēcid ākāśīyam ēkaṁ cihnaṁ darśayituṁ taṁ prārthayāñcakrirē|</para>
  <para style="p">
    <verse number="17" style="v"/>tadā sa tēṣāṁ manaḥkalpanāṁ jñātvā kathayāmāsa, kasyacid rājyasya lōkā yadi parasparaṁ virundhanti tarhi tad rājyam naśyati; kēcid gr̥hasthā yadi parasparaṁ virundhanti tarhi tēpi naśyanti|</para>
  <para style="p">
    <verse number="18" style="v"/>tathaiva śaitānapi svalōkān yadi viruṇaddhi tadā tasya rājyaṁ kathaṁ sthāsyati? bālasibūbāhaṁ bhūtān tyājayāmi yūyamiti vadatha|</para>
  <para style="p">
    <verse number="19" style="v"/>yadyahaṁ bālasibūbā bhūtān tyājayāmi tarhi yuṣmākaṁ santānāḥ kēna tyājayanti? tasmāt taēva kathāyā ētasyā vicārayitārō bhaviṣyanti|</para>
  <para style="p">
    <verse number="20" style="v"/>kintu yadyaham īśvarasya parākramēṇa bhūtān tyājayāmi tarhi yuṣmākaṁ nikaṭam īśvarasya rājyamavaśyam upatiṣṭhati|</para>
  <para style="p">
    <verse number="21" style="v"/>balavān pumān susajjamānō yatikālaṁ nijāṭṭālikāṁ rakṣati tatikālaṁ tasya dravyaṁ nirupadravaṁ tiṣṭhati|</para>
  <para style="p">
    <verse number="22" style="v"/>kintu tasmād adhikabalaḥ kaścidāgatya yadi taṁ jayati tarhi yēṣu śastrāstrēṣu tasya viśvāsa āsīt tāni sarvvāṇi hr̥tvā tasya dravyāṇi gr̥hlāti|</para>
  <para style="p">
    <verse number="23" style="v"/>ataḥ kāraṇād yō mama sapakṣō na sa vipakṣaḥ, yō mayā saha na saṁgr̥hlāti sa vikirati|</para>
  <para style="p">
    <verse number="24" style="v"/>aparañca amēdhyabhūtō mānuṣasyāntarnirgatya śuṣkasthānē bhrāntvā viśrāmaṁ mr̥gayatē kintu na prāpya vadati mama yasmād gr̥hād āgatōhaṁ punastad gr̥haṁ parāvr̥tya yāmi|</para>
  <para style="p">
    <verse number="25" style="v"/>tatō gatvā tad gr̥haṁ mārjitaṁ śōbhitañca dr̥ṣṭvā</para>
  <para style="p">
    <verse number="26" style="v"/>tatkṣaṇam apagatya svasmādapi durmmatīn aparān saptabhūtān sahānayati tē ca tadgr̥haṁ paviśya nivasanti| tasmāt tasya manuṣyasya prathamadaśātaḥ śēṣadaśā duḥkhatarā bhavati|</para>
  <para style="p">
    <verse number="27" style="v"/>asyāḥ kathāyāḥ kathanakālē janatāmadhyasthā kācinnārī tamuccaiḥsvaraṁ prōvāca, yā yōṣit tvāṁ garbbhē'dhārayat stanyamapāyayacca saiva dhanyā|</para>
  <para style="p">
    <verse number="28" style="v"/>kintu sōkathayat yē paramēśvarasya kathāṁ śrutvā tadanurūpam ācaranti taēva dhanyāḥ|</para>
  <para style="p">
    <verse number="29" style="v"/>tataḥ paraṁ tasyāntikē bahulōkānāṁ samāgamē jātē sa vaktumārēbhē, ādhunikā duṣṭalōkāścihnaṁ draṣṭumicchanti kintu yūnasbhaviṣyadvādinaścihnaṁ vinānyat kiñciccihnaṁ tān na darśayiṣyatē|</para>
  <para style="p">
    <verse number="30" style="v"/>yūnas tu yathā nīnivīyalōkānāṁ samīpē cihnarūpōbhavat tathā vidyamānalōkānām ēṣāṁ samīpē manuṣyaputrōpi cihnarūpō bhaviṣyati|</para>
  <para style="p">
    <verse number="31" style="v"/>vicārasamayē idānīntanalōkānāṁ prātikūlyēna dakṣiṇadēśīyā rājñī prōtthāya tān dōṣiṇaḥ kariṣyati, yataḥ sā rājñī sulēmāna upadēśakathāṁ śrōtuṁ pr̥thivyāḥ sīmāta āgacchat kintu paśyata sulēmānōpi gurutara ēkō janō'smin sthānē vidyatē|</para>
  <para style="p">
    <verse number="32" style="v"/>aparañca vicārasamayē nīnivīyalōkā api varttamānakālikānāṁ lōkānāṁ vaiparītyēna prōtthāya tān dōṣiṇaḥ kariṣyanti, yatō hētōstē yūnasō vākyāt cittāni parivarttayāmāsuḥ kintu paśyata yūnasōtigurutara ēkō janō'smin sthānē vidyatē|</para>
  <para style="p">
    <verse number="33" style="v"/>pradīpaṁ prajvālya drōṇasyādhaḥ kutrāpi guptasthānē vā kōpi na sthāpayati kintu gr̥hapravēśibhyō dīptiṁ dātaṁ dīpādhārōparyyēva sthāpayati|</para>
  <para style="p">
    <verse number="34" style="v"/>dēhasya pradīpaścakṣustasmādēva cakṣu ryadi prasannaṁ bhavati tarhi tava sarvvaśarīraṁ dīptimad bhaviṣyati kintu cakṣu ryadi malīmasaṁ tiṣṭhati tarhi sarvvaśarīraṁ sāndhakāraṁ sthāsyati|</para>
  <para style="p">
    <verse number="35" style="v"/>asmāt kāraṇāt tavāntaḥsthaṁ jyōti ryathāndhakāramayaṁ na bhavati tadarthē sāvadhānō bhava|</para>
  <para style="p">
    <verse number="36" style="v"/>yataḥ śarīrasya kutrāpyaṁśē sāndhakārē na jātē sarvvaṁ yadi dīptimat tiṣṭhati tarhi tubhyaṁ dīptidāyiprōjjvalan pradīpa iva tava savarvaśarīraṁ dīptimad bhaviṣyati|</para>
  <para style="p">
    <verse number="37" style="v"/>ētatkathāyāḥ kathanakālē phiruśyēkō bhējanāya taṁ nimantrayāmāsa, tataḥ sa gatvā bhōktum upavivēśa|</para>
  <para style="p">
    <verse number="38" style="v"/>kintu bhōjanāt pūrvvaṁ nāmāṅkṣīt ētad dr̥ṣṭvā sa phiruśyāścaryyaṁ mēnē|</para>
  <para style="p">
    <verse number="39" style="v"/>tadā prabhustaṁ prōvāca yūyaṁ phirūśilōkāḥ pānapātrāṇāṁ bhōjanapātrāṇāñca bahiḥ pariṣkurutha kintu yuṣmākamanta rdaurātmyai rduṣkriyābhiśca paripūrṇaṁ tiṣṭhati|</para>
  <para style="p">
    <verse number="40" style="v"/>hē sarvvē nirbōdhā yō bahiḥ sasarja sa ēva kimanta rna sasarja?</para>
  <para style="p">
    <verse number="41" style="v"/>tata ēva yuṣmābhirantaḥkaraṇaṁ (īśvarāya) nivēdyatāṁ tasmin kr̥tē yuṣmākaṁ sarvvāṇi śucitāṁ yāsyanti|</para>
  <para style="p">
    <verse number="42" style="v"/>kintu hanta phirūśigaṇā yūyaṁ nyāyam īśvarē prēma ca parityajya pōdināyā arudādīnāṁ sarvvēṣāṁ śākānāñca daśamāṁśān dattha kintu prathamaṁ pālayitvā śēṣasyālaṅghanaṁ yuṣmākam ucitamāsīt|</para>
  <para style="p">
    <verse number="43" style="v"/>hā hā phirūśinō yūyaṁ bhajanagēhē prōccāsanē āpaṇēṣu ca namaskārēṣu prīyadhvē|</para>
  <para style="p">
    <verse number="44" style="v"/>vata kapaṭinō'dhyāpakāḥ phirūśinaśca lōkāyat śmaśānam anupalabhya tadupari gacchanti yūyam tādr̥gaprakāśitaśmaśānavād bhavatha|</para>
  <para style="p">
    <verse number="45" style="v"/>tadānīṁ vyavasthāpakānām ēkā yīśumavadat, hē upadēśaka vākyēnēdr̥śēnāsmāsvapi dōṣam ārōpayasi|</para>
  <para style="p">
    <verse number="46" style="v"/>tataḥ sa uvāca, hā hā vyavasthāpakā yūyam mānuṣāṇām upari duḥsahyān bhārān nyasyatha kintu svayam ēkāṅguुlyāpi tān bhārān na spr̥śatha|</para>
  <para style="p">
    <verse number="47" style="v"/>hanta yuṣmākaṁ pūrvvapuruṣā yān bhaviṣyadvādinō'vadhiṣustēṣāṁ śmaśānāni yūyaṁ nirmmātha|</para>
  <para style="p">
    <verse number="48" style="v"/>tēnaiva yūyaṁ svapūrvvapuruṣāṇāṁ karmmāṇi saṁmanyadhvē tadēva sapramāṇaṁ kurutha ca, yatastē tānavadhiṣuḥ yūyaṁ tēṣāṁ śmaśānāni nirmmātha|</para>
  <para style="p">
    <verse number="49" style="v"/>ataēva īśvarasya śāstrē prōktamasti tēṣāmantikē bhaviṣyadvādinaḥ prēritāṁśca prēṣayiṣyāmi tatastē tēṣāṁ kāṁścana haniṣyanti kāṁścana tāḍaśṣyinti|</para>
  <para style="p">
    <verse number="50" style="v"/>ētasmāt kāraṇāt hābilaḥ śōṇitapātamārabhya mandirayajñavēdyō rmadhyē hatasya sikhariyasya raktapātaparyyantaṁ</para>
  <para style="p">
    <verse number="51" style="v"/>jagataḥ sr̥ṣṭimārabhya pr̥thivyāṁ bhaviṣyadvādināṁ yatiraktapātā jātāstatīnām aparādhadaṇḍā ēṣāṁ varttamānalōkānāṁ bhaviṣyanti, yuṣmānahaṁ niścitaṁ vadāmi sarvvē daṇḍā vaṁśasyāsya bhaviṣyanti|</para>
  <para style="p">
    <verse number="52" style="v"/>hā hā vyavasthapakā yūyaṁ jñānasya kuñcikāṁ hr̥tvā svayaṁ na praviṣṭā yē pravēṣṭuñca prayāsinastānapi pravēṣṭuṁ vāritavantaḥ|</para>
  <para style="p">
    <verse number="53" style="v"/>itthaṁ kathākathanād adhyāpakāḥ phirūśinaśca satarkāḥ</para>
  <para style="p">
    <verse number="54" style="v"/>santastamapavadituṁ tasya kathāyā dōṣaṁ dharttamicchantō nānākhyānakathanāya taṁ pravarttayituṁ kōpayituñca prārēbhirē|</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tadānīṁ lōkāḥ sahasraṁ sahasram āgatya samupasthitāstata ēkaikō 'nyēṣāmupari patitum upacakramē; tadā yīśuḥ śiṣyān babhāṣē, yūyaṁ phirūśināṁ kiṇvarūpakāpaṭyē viśēṣēṇa sāvadhānāstiṣṭhata|</para>
  <para style="p">
    <verse number="2" style="v"/>yatō yanna prakāśayiṣyatē tadācchannaṁ vastu kimapi nāsti; tathā yanna jñāsyatē tad guptaṁ vastu kimapi nāsti|</para>
  <para style="p">
    <verse number="3" style="v"/>andhakārē tiṣṭhanatō yāḥ kathā akathayata tāḥ sarvvāḥ kathā dīptau śrōṣyantē nirjanē karṇē ca yadakathayata gr̥hapr̥ṣṭhāt tat pracārayiṣyatē|</para>
  <para style="p">
    <verse number="4" style="v"/>hē bandhavō yuṣmānahaṁ vadāmi, yē śarīrasya nāśaṁ vinā kimapyaparaṁ karttuṁ na śakruvanti tēbhyō mā bhaiṣṭa|</para>
  <para style="p">
    <verse number="5" style="v"/>tarhi kasmād bhētavyam ityahaṁ vadāmi, yaḥ śarīraṁ nāśayitvā narakaṁ nikṣēptuṁ śaknōti tasmādēva bhayaṁ kuruta, punarapi vadāmi tasmādēva bhayaṁ kuruta|</para>
  <para style="p">
    <verse number="6" style="v"/>pañca caṭakapakṣiṇaḥ kiṁ dvābhyāṁ tāmrakhaṇḍābhyāṁ na vikrīyantē? tathāpīśvarastēṣām ēkamapi na vismarati|</para>
  <para style="p">
    <verse number="7" style="v"/>yuṣmākaṁ śiraḥkēśā api gaṇitāḥ santi tasmāt mā vibhīta bahucaṭakapakṣibhyōpi yūyaṁ bahumūlyāḥ|</para>
  <para style="p">
    <verse number="8" style="v"/>aparaṁ yuṣmabhyaṁ kathayāmi yaḥ kaścin mānuṣāṇāṁ sākṣān māṁ svīkarōti manuṣyaputra īśvaradūtānāṁ sākṣāt taṁ svīkariṣyati|</para>
  <para style="p">
    <verse number="9" style="v"/>kintu yaḥ kaścinmānuṣāṇāṁ sākṣānmām asvīkarōti tam īśvarasya dūtānāṁ sākṣād aham asvīkariṣyāmi|</para>
  <para style="p">
    <verse number="10" style="v"/>anyacca yaḥ kaścin manujasutasya nindābhāvēna kāñcit kathāṁ kathayati tasya tatpāpasya mōcanaṁ bhaviṣyati kintu yadi kaścit pavitram ātmānaṁ nindati tarhi tasya tatpāpasya mōcanaṁ na bhaviṣyati|</para>
  <para style="p">
    <verse number="11" style="v"/>yadā lōkā yuṣmān bhajanagēhaṁ vicārakartr̥rājyakartr̥ṇāṁ sammukhañca nēṣyanti tadā kēna prakārēṇa kimuttaraṁ vadiṣyatha kiṁ kathayiṣyatha cētyatra mā cintayata;</para>
  <para style="p">
    <verse number="12" style="v"/>yatō yuṣmābhiryad yad vaktavyaṁ tat tasmin samayaēva pavitra ātmā yuṣmān śikṣayiṣyati|</para>
  <para style="p">
    <verse number="13" style="v"/>tataḥ paraṁ janatāmadhyasthaḥ kaścijjanastaṁ jagāda hē gurō mayā saha paitr̥kaṁ dhanaṁ vibhaktuṁ mama bhrātaramājñāpayatu bhavān|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu sa tamavadat hē manuṣya yuvayō rvicāraṁ vibhāgañca karttuṁ māṁ kō niyuktavān?</para>
  <para style="p">
    <verse number="15" style="v"/>anantaraṁ sa lōkānavadat lōbhē sāvadhānāḥ satarkāśca tiṣṭhata, yatō bahusampattiprāptyā manuṣyasyāyu rna bhavati|</para>
  <para style="p">
    <verse number="16" style="v"/>paścād dr̥ṣṭāntakathāmutthāpya kathayāmāsa, ēkasya dhaninō bhūmau bahūni śasyāni jātāni|</para>
  <para style="p">
    <verse number="17" style="v"/>tataḥ sa manasā cintayitvā kathayāmbabhūva mamaitāni samutpannāni dravyāṇi sthāpayituṁ sthānaṁ nāsti kiṁ kariṣyāmi?</para>
  <para style="p">
    <verse number="18" style="v"/>tatōvadad itthaṁ kariṣyāmi, mama sarvvabhāṇḍāgārāṇi bhaṅktvā br̥hadbhāṇḍāgārāṇi nirmmāya tanmadhyē sarvvaphalāni dravyāṇi ca sthāpayiṣyāmi|</para>
  <para style="p">
    <verse number="19" style="v"/>aparaṁ nijamanō vadiṣyāmi, hē manō bahuvatsarārthaṁ nānādravyāṇi sañcitāni santi viśrāmaṁ kuru bhuktvā pītvā kautukañca kuru| kintvīśvarastam avadat,</para>
  <para style="p">
    <verse number="20" style="v"/>rē nirbōdha adya rātrau tava prāṇāstvattō nēṣyantē tata ētāni yāni dravyāṇi tvayāsāditāni tāni kasya bhaviṣyanti?</para>
  <para style="p">
    <verse number="21" style="v"/>ataēva yaḥ kaścid īśvarasya samīpē dhanasañcayamakr̥tvā kēvalaṁ svanikaṭē sañcayaṁ karōti sōpi tādr̥śaḥ|</para>
  <para style="p">
    <verse number="22" style="v"/>atha sa śiṣyēbhyaḥ kathayāmāsa, yuṣmānahaṁ vadāmi, kiṁ khādiṣyāmaḥ? kiṁ paridhāsyāmaḥ? ityuktvā jīvanasya śarīrasya cārthaṁ cintāṁ mā kārṣṭa|</para>
  <para style="p">
    <verse number="23" style="v"/>bhakṣyājjīvanaṁ bhūṣaṇāccharīrañca śrēṣṭhaṁ bhavati|</para>
  <para style="p">
    <verse number="24" style="v"/>kākapakṣiṇāṁ kāryyaṁ vicārayata, tē na vapanti śasyāni ca na chindanti, tēṣāṁ bhāṇḍāgārāṇi na santi kōṣāśca na santi, tathāpīśvarastēbhyō bhakṣyāṇi dadāti, yūyaṁ pakṣibhyaḥ śrēṣṭhatarā na kiṁ?</para>
  <para style="p">
    <verse number="25" style="v"/>aparañca bhāvayitvā nijāyuṣaḥ kṣaṇamātraṁ varddhayituṁ śaknōti, ētādr̥śō lākō yuṣmākaṁ madhyē kōsti?</para>
  <para style="p">
    <verse number="26" style="v"/>ataēva kṣudraṁ kāryyaṁ sādhayitum asamarthā yūyam anyasmin kāryyē kutō bhāvayatha?</para>
  <para style="p">
    <verse number="27" style="v"/>anyacca kāmpilapuṣpaṁ kathaṁ varddhatē tadāpi vicārayata, tat kañcana śramaṁ na karōti tantūṁśca na janayati kintu yuṣmabhyaṁ yathārthaṁ kathayāmi sulēmān bahvaiśvaryyānvitōpi puṣpasyāsya sadr̥śō vibhūṣitō nāsīt|</para>
  <para style="p">
    <verse number="28" style="v"/>adya kṣētrē varttamānaṁ śvaścūllyāṁ kṣēpsyamānaṁ yat tr̥ṇaṁ, tasmai yadīśvara itthaṁ bhūṣayati tarhi hē alpapratyayinō yuṣmāna kiṁ na paridhāpayiṣyati?</para>
  <para style="p">
    <verse number="29" style="v"/>ataēva kiṁ khādiṣyāmaḥ? kiṁ paridhāsyāmaḥ? ētadarthaṁ mā cēṣṭadhvaṁ mā saṁdigdhvañca|</para>
  <para style="p">
    <verse number="30" style="v"/>jagatō dēvārccakā ētāni sarvvāṇi cēṣṭanatē; ēṣu vastuṣu yuṣmākaṁ prayōjanamāstē iti yuṣmākaṁ pitā jānāti|</para>
  <para style="p">
    <verse number="31" style="v"/>ataēvēśvarasya rājyārthaṁ sacēṣṭā bhavata tathā kr̥tē sarvvāṇyētāni dravyāṇi yuṣmabhyaṁ pradāyiṣyantē|</para>
  <para style="p">
    <verse number="32" style="v"/>hē kṣudramēṣavraja yūyaṁ mā bhaiṣṭa yuṣmabhyaṁ rājyaṁ dātuṁ yuṣmākaṁ pituḥ sammatirasti|</para>
  <para style="p">
    <verse number="33" style="v"/>ataēva yuṣmākaṁ yā yā sampattirasti tāṁ tāṁ vikrīya vitarata, yat sthānaṁ caurā nāgacchanti, kīṭāśca na kṣāyayanti tādr̥śē svargē nijārtham ajarē sampuṭakē 'kṣayaṁ dhanaṁ sañcinuta ca;</para>
  <para style="p">
    <verse number="34" style="v"/>yatō yatra yuṣmākaṁ dhanaṁ varttatē tatrēva yuṣmākaṁ manaḥ|</para>
  <para style="p">
    <verse number="35" style="v"/>aparañca yūyaṁ pradīpaṁ jvālayitvā baddhakaṭayastiṣṭhata;</para>
  <para style="p">
    <verse number="36" style="v"/>prabhu rvivāhādāgatya yadaiva dvāramāhanti tadaiva dvāraṁ mōcayituṁ yathā bhr̥tyā apēkṣya tiṣṭhanti tathā yūyamapi tiṣṭhata|</para>
  <para style="p">
    <verse number="37" style="v"/>yataḥ prabhurāgatya yān dāsān sacētanān tiṣṭhatō drakṣyati taēva dhanyāḥ; ahaṁ yuṣmān yathārthaṁ vadāmi prabhustān bhōjanārtham upavēśya svayaṁ baddhakaṭiḥ samīpamētya parivēṣayiṣyati|</para>
  <para style="p">
    <verse number="38" style="v"/>yadi dvitīyē tr̥tīyē vā praharē samāgatya tathaiva paśyati, tarhi taēva dāsā dhanyāḥ|</para>
  <para style="p">
    <verse number="39" style="v"/>aparañca kasmin kṣaṇē caurā āgamiṣyanti iti yadi gr̥hapati rjñātuṁ śaknōti tadāvaśyaṁ jāgran nijagr̥hē sandhiṁ karttayituṁ vārayati yūyamētad vitta|</para>
  <para style="p">
    <verse number="40" style="v"/>ataēva yūyamapi sajjamānāstiṣṭhata yatō yasmin kṣaṇē taṁ nāprēkṣadhvē tasminnēva kṣaṇē manuṣyaputra āgamiṣyati|</para>
  <para style="p">
    <verse number="41" style="v"/>tadā pitaraḥ papraccha, hē prabhō bhavān kimasmān uddiśya kiṁ sarvvān uddiśya dr̥ṣṭāntakathāmimāṁ vadati?</para>
  <para style="p">
    <verse number="42" style="v"/>tataḥ prabhuḥ prōvāca, prabhuḥ samucitakālē nijaparivārārthaṁ bhōjyaparivēṣaṇāya yaṁ tatpadē niyōkṣyati tādr̥śō viśvāsyō bōddhā karmmādhīśaḥ kōsti?</para>
  <para style="p">
    <verse number="43" style="v"/>prabhurāgatya yam ētādr̥śē karmmaṇi pravr̥ttaṁ drakṣyati saēva dāsō dhanyaḥ|</para>
  <para style="p">
    <verse number="44" style="v"/>ahaṁ yuṣmān yathārthaṁ vadāmi sa taṁ nijasarvvasvasyādhipatiṁ kariṣyati|</para>
  <para style="p">
    <verse number="45" style="v"/>kintu prabhurvilambēnāgamiṣyati, iti vicintya sa dāsō yadi tadanyadāsīdāsān praharttum bhōktuṁ pātuṁ madituñca prārabhatē,</para>
  <para style="p">
    <verse number="46" style="v"/>tarhi yadā prabhuṁ nāpēkṣiṣyatē yasmin kṣaṇē sō'cētanaśca sthāsyati tasminnēva kṣaṇē tasya prabhurāgatya taṁ padabhraṣṭaṁ kr̥tvā viśvāsahīnaiḥ saha tasya aṁśaṁ nirūpayiṣyati|</para>
  <para style="p">
    <verse number="47" style="v"/>yō dāsaḥ prabhēाrājñāṁ jñātvāpi sajjitō na tiṣṭhati tadājñānusārēṇa ca kāryyaṁ na karōti sōnēkān prahārān prāpsyati;</para>
  <para style="p">
    <verse number="48" style="v"/>kintu yō janō'jñātvā prahārārhaṁ karmma karōti sōlpaprahārān prāpsyati| yatō yasmai bāhulyēna dattaṁ tasmādēva bāhulyēna grahīṣyatē, mānuṣā yasya nikaṭē bahu samarpayanti tasmād bahu yācantē|</para>
  <para style="p">
    <verse number="49" style="v"/>ahaṁ pr̥thivyām anaikyarūpaṁ vahni nikṣēptum āgatōsmi, sa cēd idānīmēva prajvalati tatra mama kā cintā?</para>
  <para style="p">
    <verse number="50" style="v"/>kintu yēna majjanēnāhaṁ magnō bhaviṣyāmi yāvatkālaṁ tasya siddhi rna bhaviṣyati tāvadahaṁ katikaṣṭaṁ prāpsyāmi|</para>
  <para style="p">
    <verse number="51" style="v"/>mēlanaṁ karttuṁ jagad āgatōsmi yūyaṁ kimitthaṁ bōdhadhvē? yuṣmān vadāmi na tathā, kintvahaṁ mēlanābhāvaṁ karttuṁm āgatōsmi|</para>
  <para style="p">
    <verse number="52" style="v"/>yasmādētatkālamārabhya ēkatrasthaparijanānāṁ madhyē pañcajanāḥ pr̥thag bhūtvā trayō janā dvayōrjanayōḥ pratikūlā dvau janau ca trayāṇāṁ janānāṁ pratikūlau bhaviṣyanti|</para>
  <para style="p">
    <verse number="53" style="v"/>pitā putrasya vipakṣaḥ putraśca pitu rvipakṣō bhaviṣyati mātā kanyāyā vipakṣā kanyā ca mātu rvipakṣā bhaviṣyati, tathā śvaśrūrbadhvā vipakṣā badhūśca śvaśrvā vipakṣā bhaviṣyati|</para>
  <para style="p">
    <verse number="54" style="v"/>sa lōkēbhyōparamapi kathayāmāsa, paścimadiśi mēghōdgamaṁ dr̥ṣṭvā yūyaṁ haṭhād vadatha vr̥ṣṭi rbhaviṣyati tatastathaiva jāyatē|</para>
  <para style="p">
    <verse number="55" style="v"/>aparaṁ dakṣiṇatō vāyau vāti sati vadatha nidāghō bhaviṣyati tataḥ sōpi jāyatē|</para>
  <para style="p">
    <verse number="56" style="v"/>rē rē kapaṭina ākāśasya bhūmyāśca lakṣaṇaṁ bōddhuṁ śaknutha,</para>
  <para style="p">
    <verse number="57" style="v"/>kintu kālasyāsya lakṣaṇaṁ kutō bōddhuṁ na śaknutha? yūyañca svayaṁ kutō na nyāṣyaṁ vicārayatha?</para>
  <para style="p">
    <verse number="58" style="v"/>aparañca vivādinā sārddhaṁ vicārayituḥ samīpaṁ gacchan pathi tasmāduddhāraṁ prāptuṁ yatasva nōcēt sa tvāṁ dhr̥tvā vicārayituḥ samīpaṁ nayati| vicārayitā yadi tvāṁ praharttuḥ samīpaṁ samarpayati praharttā tvāṁ kārāyāṁ badhnāti</para>
  <para style="p">
    <verse number="59" style="v"/>tarhi tvāmahaṁ vadāmi tvayā niḥśēṣaṁ kapardakēṣu na pariśōdhitēṣu tvaṁ tatō muktiṁ prāptuṁ na śakṣyasi|</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>aparañca pīlātō yēṣāṁ gālīlīyānāṁ raktāni balīnāṁ raktaiḥ sahāmiśrayat tēṣāṁ gālīlīyānāṁ vr̥ttāntaṁ katipayajanā upasthāpya yīśavē kathayāmāsuḥ|</para>
  <para style="p">
    <verse number="2" style="v"/>tataḥ sa pratyuvāca tēṣāṁ lōkānām ētādr̥śī durgati rghaṭitā tatkāraṇād yūyaṁ kimanyēbhyō gālīlīyēbhyōpyadhikapāpinastān bōdhadhvē?</para>
  <para style="p">
    <verse number="3" style="v"/>yuṣmānahaṁ vadāmi tathā na kintu manaḥsu na parāvarttitēṣu yūyamapi tathā naṁkṣyatha|</para>
  <para style="p">
    <verse number="4" style="v"/>aparañca śīlōhanāmna uccagr̥hasya patanād yē'ṣṭādaśajanā mr̥tāstē yirūśālami nivāsisarvvalōkēbhyō'dhikāparādhinaḥ kiṁ yūyamityaṁ bōdhadhvē?</para>
  <para style="p">
    <verse number="5" style="v"/>yuṣmānahaṁ vadāmi tathā na kintu manaḥsu na parivarttitēṣu yūyamapi tathā naṁkṣyatha|</para>
  <para style="p">
    <verse number="6" style="v"/>anantaraṁ sa imāṁ dr̥ṣṭāntakathāmakathayad ēkō janō drākṣākṣētramadhya ēkamuḍumbaravr̥kṣaṁ rōpitavān| paścāt sa āgatya tasmin phalāni gavēṣayāmāsa,</para>
  <para style="p">
    <verse number="7" style="v"/>kintu phalāprāptēḥ kāraṇād udyānakāraṁ bhr̥tyaṁ jagāda, paśya vatsaratrayaṁ yāvadāgatya ētasminnuḍumbaratarau kṣalānyanvicchāmi, kintu naikamapi prapnōmi tarurayaṁ kutō vr̥thā sthānaṁ vyāpya tiṣṭhati? ēnaṁ chindhi|</para>
  <para style="p">
    <verse number="8" style="v"/>tatō bhr̥tyaḥ pratyuvāca, hē prabhō punarvarṣamēkaṁ sthātum ādiśa; ētasya mūlasya caturdikṣu khanitvāham ālavālaṁ sthāpayāmi|</para>
  <para style="p">
    <verse number="9" style="v"/>tataḥ phalituṁ śaknōti yadi na phalati tarhi paścāt chētsyasi|</para>
  <para style="p">
    <verse number="10" style="v"/>atha viśrāmavārē bhajanagēhē yīśurupadiśati</para>
  <para style="p">
    <verse number="11" style="v"/>tasmit samayē bhūtagrastatvāt kubjībhūyāṣṭādaśavarṣāṇi yāvat kēnāpyupāyēna r̥ju rbhavituṁ na śaknōti yā durbbalā strī,</para>
  <para style="p">
    <verse number="12" style="v"/>tāṁ tatrōpasthitāṁ vilōkya yīśustāmāhūya kathitavān hē nāri tava daurbbalyāt tvaṁ muktā bhava|</para>
  <para style="p">
    <verse number="13" style="v"/>tataḥ paraṁ tasyā gātrē hastārpaṇamātrāt sā r̥jurbhūtvēśvarasya dhanyavādaṁ karttumārēbhē|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu viśrāmavārē yīśunā tasyāḥ svāsthyakaraṇād bhajanagēhasyādhipatiḥ prakupya lōkān uvāca, ṣaṭsu dinēṣu lōkaiḥ karmma karttavyaṁ tasmāddhētōḥ svāsthyārthaṁ tēṣu dinēṣu āgacchata, viśrāmavārē māgacchata|</para>
  <para style="p">
    <verse number="15" style="v"/>tadā pabhuḥ pratyuvāca rē kapaṭinō yuṣmākam ēkaikō janō viśrāmavārē svīyaṁ svīyaṁ vr̥ṣabhaṁ gardabhaṁ vā bandhanānmōcayitvā jalaṁ pāyayituṁ kiṁ na nayati?</para>
  <para style="p">
    <verse number="16" style="v"/>tarhyāṣṭādaśavatsarān yāvat śaitānā baddhā ibrāhīmaḥ santatiriyaṁ nārī kiṁ viśrāmavārē na mōcayitavyā?</para>
  <para style="p">
    <verse number="17" style="v"/>ēṣu vākyēṣu kathitēṣu tasya vipakṣāḥ salajjā jātāḥ kintu tēna kr̥tasarvvamahākarmmakāraṇāt lōkanivahaḥ sānandō'bhavat|</para>
  <para style="p">
    <verse number="18" style="v"/>anantaraṁ sōvadad īśvarasya rājyaṁ kasya sadr̥śaṁ? kēna tadupamāsyāmi?</para>
  <para style="p">
    <verse number="19" style="v"/>yat sarṣapabījaṁ gr̥hītvā kaścijjana udyāna uptavān tad bījamaṅkuritaṁ sat mahāvr̥kṣō'jāyata, tatastasya śākhāsu vihāyasīyavihagā āgatya nyūṣuḥ, tadrājyaṁ tādr̥śēna sarṣapabījēna tulyaṁ|</para>
  <para style="p">
    <verse number="20" style="v"/>punaḥ kathayāmāsa, īśvarasya rājyaṁ kasya sadr̥śaṁ vadiṣyāmi? yat kiṇvaṁ kācit strī gr̥hītvā drōṇatrayaparimitagōdhūmacūrṇēṣu sthāpayāmāsa,</para>
  <para style="p">
    <verse number="21" style="v"/>tataḥ kramēṇa tat sarvvagōdhūmacūrṇaṁ vyāpnōti, tasya kiṇvasya tulyam īśvarasya rājyaṁ|</para>
  <para style="p">
    <verse number="22" style="v"/>tataḥ sa yirūśālamnagaraṁ prati yātrāṁ kr̥tvā nagarē nagarē grāmē grāmē samupadiśan jagāma|</para>
  <para style="p">
    <verse number="23" style="v"/>tadā kaścijjanastaṁ papraccha, hē prabhō kiṁ kēvalam alpē lōkāḥ paritrāsyantē?</para>
  <para style="p">
    <verse number="24" style="v"/>tataḥ sa lōkān uvāca, saṁkīrṇadvārēṇa pravēṣṭuṁ yataghvaṁ, yatōhaṁ yuṣmān vadāmi, bahavaḥ pravēṣṭuṁ cēṣṭiṣyantē kintu na śakṣyanti|</para>
  <para style="p">
    <verse number="25" style="v"/>gr̥hapatinōtthāya dvārē ruddhē sati yadi yūyaṁ bahiḥ sthitvā dvāramāhatya vadatha, hē prabhō hē prabhō asmatkāraṇād dvāraṁ mōcayatu, tataḥ sa iti prativakṣyati, yūyaṁ kutratyā lōkā ityahaṁ na jānāmi|</para>
  <para style="p">
    <verse number="26" style="v"/>tadā yūyaṁ vadiṣyatha, tava sākṣād vayaṁ bhēाjanaṁ pānañca kr̥tavantaḥ, tvañcāsmākaṁ nagarasya pathi samupadiṣṭavān|</para>
  <para style="p">
    <verse number="27" style="v"/>kintu sa vakṣyati, yuṣmānahaṁ vadāmi, yūyaṁ kutratyā lōkā ityahaṁ na jānāmi; hē durācāriṇō yūyaṁ mattō dūrībhavata|</para>
  <para style="p">
    <verse number="28" style="v"/>tadā ibrāhīmaṁ ishākaṁ yākūbañca sarvvabhaviṣyadvādinaśca īśvarasya rājyaṁ prāptān svāṁśca bahiṣkr̥tān dr̥ṣṭvā yūyaṁ rōdanaṁ dantairdantagharṣaṇañca kariṣyatha|</para>
  <para style="p">
    <verse number="29" style="v"/>aparañca pūrvvapaścimadakṣiṇōttaradigbhyō lōkā āgatya īśvarasya rājyē nivatsyanti|</para>
  <para style="p">
    <verse number="30" style="v"/>paśyatētthaṁ śēṣīyā lōkā agrā bhaviṣyanti, agrīyā lōkāśca śēṣā bhaviṣyanti|</para>
  <para style="p">
    <verse number="31" style="v"/>aparañca tasmin dinē kiyantaḥ phirūśina āgatya yīśuṁ prōcuḥ, bahirgaccha, sthānādasmāt prasthānaṁ kuru, hērōd tvāṁ jighāṁsati|</para>
  <para style="p">
    <verse number="32" style="v"/>tataḥ sa pratyavōcat paśyatādya śvaśca bhūtān vihāpya rōgiṇō'rōgiṇaḥ kr̥tvā tr̥tīyēhni sētsyāmi, kathāmētāṁ yūyamitvā taṁ bhūrimāyaṁ vadata|</para>
  <para style="p">
    <verse number="33" style="v"/>tatrāpyadya śvaḥ paraśvaśca mayā gamanāgamanē karttavyē, yatō hētō ryirūśālamō bahiḥ kutrāpi kōpi bhaviṣyadvādī na ghāniṣyatē|</para>
  <para style="p">
    <verse number="34" style="v"/>hē yirūśālam hē yirūśālam tvaṁ bhaviṣyadvādinō haṁsi tavāntikē prēritān prastarairmārayasi ca, yathā kukkuṭī nijapakṣādhaḥ svaśāvakān saṁgr̥hlāti, tathāhamapi tava śiśūn saṁgrahītuṁ kativārān aicchaṁ kintu tvaṁ naicchaḥ|</para>
  <para style="p">
    <verse number="35" style="v"/>paśyata yuṣmākaṁ vāsasthānāni prōcchidyamānāni parityaktāni ca bhaviṣyanti; yuṣmānahaṁ yathārthaṁ vadāmi, yaḥ prabhō rnāmnāgacchati sa dhanya iti vācaṁ yāvatkālaṁ na vadiṣyatha, tāvatkālaṁ yūyaṁ māṁ na drakṣyatha|</para>
  <chapter number="14" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>anantaraṁ viśrāmavārē yīśau pradhānasya phirūśinō gr̥hē bhōktuṁ gatavati tē taṁ vīkṣitum ārēbhirē|</para>
  <para style="p">
    <verse number="2" style="v"/>tadā jalōdarī tasya sammukhē sthitaḥ|</para>
  <para style="p">
    <verse number="3" style="v"/>tataḥ sa vyavasthāpakān phirūśinaśca papraccha, viśrāmavārē svāsthyaṁ karttavyaṁ na vā? tatastē kimapi na pratyūcuḥ|</para>
  <para style="p">
    <verse number="4" style="v"/>tadā sa taṁ rōgiṇaṁ svasthaṁ kr̥tvā visasarja;</para>
  <para style="p">
    <verse number="5" style="v"/>tānuvāca ca yuṣmākaṁ kasyacid garddabhō vr̥ṣabhō vā cēd garttē patati tarhi viśrāmavārē tatkṣaṇaṁ sa kiṁ taṁ nōtthāpayiṣyati?</para>
  <para style="p">
    <verse number="6" style="v"/>tatastē kathāyā ētasyāḥ kimapi prativaktuṁ na śēkuḥ|</para>
  <para style="p">
    <verse number="7" style="v"/>aparañca pradhānasthānamanōnītatvakaraṇaṁ vilōkya sa nimantritān ētadupadēśakathāṁ jagāda,</para>
  <para style="p">
    <verse number="8" style="v"/>tvaṁ vivāhādibhōjyēṣu nimantritaḥ san pradhānasthānē mōpāvēkṣīḥ| tvattō gauravānvitanimantritajana āyātē</para>
  <para style="p">
    <verse number="9" style="v"/>nimantrayitāgatya manuṣyāyaitasmai sthānaṁ dēhīti vākyaṁ cēd vakṣyati tarhi tvaṁ saṅkucitō bhūtvā sthāna itarasmin upavēṣṭum udyaṁsyasi|</para>
  <para style="p">
    <verse number="10" style="v"/>asmāt kāraṇādēva tvaṁ nimantritō gatvā'pradhānasthāna upaviśa, tatō nimantrayitāgatya vadiṣyati, hē bandhō prōccasthānaṁ gatvōpaviśa, tathā sati bhōjanōpaviṣṭānāṁ sakalānāṁ sākṣāt tvaṁ mānyō bhaviṣyasi|</para>
  <para style="p">
    <verse number="11" style="v"/>yaḥ kaścit svamunnamayati sa namayiṣyatē, kintu yaḥ kaścit svaṁ namayati sa unnamayiṣyatē|</para>
  <para style="p">
    <verse number="12" style="v"/>tadā sa nimantrayitāraṁ janamapi jagāda, madhyāhnē rātrau vā bhōjyē kr̥tē nijabandhugaṇō vā bhrātr̥ृgaṇō vā jñātigaṇō vā dhanigaṇō vā samīpavāsigaṇō vā ētān na nimantraya, tathā kr̥tē cēt tē tvāṁ nimantrayiṣyanti, tarhi pariśōdhō bhaviṣyati|</para>
  <para style="p">
    <verse number="13" style="v"/>kintu yadā bhējyaṁ karōṣi tadā daridraśuṣkakarakhañjāndhān nimantraya,</para>
  <para style="p">
    <verse number="14" style="v"/>tata āśiṣaṁ lapsyasē, tēṣu pariśōdhaṁ karttumaśaknuvatsu śmaśānāddhārmmikānāmutthānakālē tvaṁ phalāṁ lapsyasē|</para>
  <para style="p">
    <verse number="15" style="v"/>anantaraṁ tāṁ kathāṁ niśamya bhōjanōpaviṣṭaḥ kaścit kathayāmāsa, yō jana īśvarasya rājyē bhōktuṁ lapsyatē saēva dhanyaḥ|</para>
  <para style="p">
    <verse number="16" style="v"/>tataḥ sa uvāca, kaścit janō rātrau bhēाjyaṁ kr̥tvā bahūn nimantrayāmāsa|</para>
  <para style="p">
    <verse number="17" style="v"/>tatō bhōjanasamayē nimantritalōkān āhvātuṁ dāsadvārā kathayāmāsa, khadyadravyāṇi sarvvāṇi samāsāditāni santi, yūyamāgacchata|</para>
  <para style="p">
    <verse number="18" style="v"/>kintu tē sarvva ēkaikaṁ chalaṁ kr̥tvā kṣamāṁ prārthayāñcakrirē| prathamō janaḥ kathayāmāsa, kṣētramēkaṁ krītavānahaṁ tadēva draṣṭuṁ mayā gantavyam, ataēva māṁ kṣantuṁ taṁ nivēdaya|</para>
  <para style="p">
    <verse number="19" style="v"/>anyō janaḥ kathayāmāsa, daśavr̥ṣānahaṁ krītavān tān parīkṣituṁ yāmi tasmādēva māṁ kṣantuṁ taṁ nivēdaya|</para>
  <para style="p">
    <verse number="20" style="v"/>aparaḥ kathayāmāsa, vyūḍhavānahaṁ tasmāt kāraṇād yātuṁ na śaknōmi|</para>
  <para style="p">
    <verse number="21" style="v"/>paścāt sa dāsō gatvā nijaprabhōḥ sākṣāt sarvvavr̥ttāntaṁ nivēdayāmāsa, tatōsau gr̥hapatiḥ kupitvā svadāsaṁ vyājahāra, tvaṁ satvaraṁ nagarasya sannivēśān mārgāṁśca gatvā daridraśuṣkakarakhañjāndhān atrānaya|</para>
  <para style="p">
    <verse number="22" style="v"/>tatō dāsō'vadat, hē prabhō bhavata ājñānusārēṇākriyata tathāpi sthānamasti|</para>
  <para style="p">
    <verse number="23" style="v"/>tadā prabhuḥ puna rdāsāyākathayat, rājapathān vr̥kṣamūlāni ca yātvā madīyagr̥hapūraṇārthaṁ lōkānāgantuṁ pravarttaya|</para>
  <para style="p">
    <verse number="24" style="v"/>ahaṁ yuṣmabhyaṁ kathayāmi, pūrvvanimantritānamēkōpi mamāsya rātribhōjyasyāsvādaṁ na prāpsyati|</para>
  <para style="p">
    <verse number="25" style="v"/>anantaraṁ bahuṣu lōkēṣu yīśōḥ paścād vrajitēṣu satsu sa vyāghuṭya tēbhyaḥ kathayāmāsa,</para>
  <para style="p">
    <verse number="26" style="v"/>yaḥ kaścin mama samīpam āgatya svasya mātā pitā patnī santānā bhrātarō bhagimyō nijaprāṇāśca, ētēbhyaḥ sarvvēbhyō mayyadhikaṁ prēma na karōti, sa mama śiṣyō bhavituṁ na śakṣyati|</para>
  <para style="p">
    <verse number="27" style="v"/>yaḥ kaścit svīyaṁ kruśaṁ vahan mama paścānna gacchati, sōpi mama śiṣyō bhavituṁ na śakṣyati|</para>
  <para style="p">
    <verse number="28" style="v"/>durganirmmāṇē kativyayō bhaviṣyati, tathā tasya samāptikaraṇārthaṁ sampattirasti na vā, prathamamupaviśya ētanna gaṇayati, yuṣmākaṁ madhya ētādr̥śaḥ kōsti?</para>
  <para style="p">
    <verse number="29" style="v"/>nōcēd bhittiṁ kr̥tvā śēṣē yadi samāpayituṁ na śakṣyati,</para>
  <para style="p">
    <verse number="30" style="v"/>tarhi mānuṣōyaṁ nicētum ārabhata samāpayituṁ nāśaknōt, iti vyāhr̥tya sarvvē tamupahasiṣyanti|</para>
  <para style="p">
    <verse number="31" style="v"/>aparañca bhinnabhūpatinā saha yuddhaṁ karttum udyamya daśasahasrāṇi sainyāni gr̥hītvā viṁśatisahasrēḥ sainyaiḥ sahitasya samīpavāsinaḥ sammukhaṁ yātuṁ śakṣyāmi na vēti prathamaṁ upaviśya na vicārayati ētādr̥śō bhūmipatiḥ kaḥ?</para>
  <para style="p">
    <verse number="32" style="v"/>yadi na śaknōti tarhi ripāvatidūrē tiṣṭhati sati nijadūtaṁ prēṣya sandhiṁ karttuṁ prārthayēta|</para>
  <para style="p">
    <verse number="33" style="v"/>tadvad yuṣmākaṁ madhyē yaḥ kaścin madarthaṁ sarvvasvaṁ hātuṁ na śaknōti sa mama śiṣyō bhavituṁ na śakṣyati|</para>
  <para style="p">
    <verse number="34" style="v"/>lavaṇam uttamam iti satyaṁ, kintu yadi lavaṇasya lavaṇatvam apagacchati tarhi tat kathaṁ svāduyuktaṁ bhaviṣyati?</para>
  <para style="p">
    <verse number="35" style="v"/>tada bhūmyartham ālavālarāśyarthamapi bhadraṁ na bhavati; lōkāstad bahiḥ kṣipanti|yasya śrōtuṁ śrōtrē staḥ sa śr̥ṇōtu|</para>
  <chapter number="15" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tadā karasañcāyinaḥ pāpinaśca lōkā upadēśkathāṁ śrōtuṁ yīśōḥ samīpam āgacchan|</para>
  <para style="p">
    <verse number="2" style="v"/>tataḥ phirūśina upādhyāyāśca vivadamānāḥ kathayāmāsuḥ ēṣa mānuṣaḥ pāpibhiḥ saha praṇayaṁ kr̥tvā taiḥ sārddhaṁ bhuṁktē|</para>
  <para style="p">
    <verse number="3" style="v"/>tadā sa tēbhya imāṁ dr̥ṣṭāntakathāṁ kathitavān,</para>
  <para style="p">
    <verse number="4" style="v"/>kasyacit śatamēṣēṣu tiṣṭhatmu tēṣāmēkaṁ sa yadi hārayati tarhi madhyēprāntaram ēkōnaśatamēṣān vihāya hāritamēṣasya uddēśaprāptiparyyanataṁ na gavēṣayati, ētādr̥śō lōkō yuṣmākaṁ madhyē ka āstē?</para>
  <para style="p">
    <verse number="5" style="v"/>tasyōddēśaṁ prāpya hr̥ṣṭamanāstaṁ skandhē nidhāya svasthānam ānīya bandhubāndhavasamīpavāsina āhūya vakti,</para>
  <para style="p">
    <verse number="6" style="v"/>hāritaṁ mēṣaṁ prāptōham atō hētō rmayā sārddham ānandata|</para>
  <para style="p">
    <verse number="7" style="v"/>tadvadahaṁ yuṣmān vadāmi, yēṣāṁ manaḥparāvarttanasya prayōjanaṁ nāsti, tādr̥śaikōnaśatadhārmmikakāraṇād ya ānandastasmād ēkasya manaḥparivarttinaḥ pāpinaḥ kāraṇāt svargē 'dhikānandō jāyatē|</para>
  <para style="p">
    <verse number="8" style="v"/>aparañca daśānāṁ rūpyakhaṇḍānām ēkakhaṇḍē hāritē pradīpaṁ prajvālya gr̥haṁ sammārjya tasya prāptiṁ yāvad yatnēna na gavēṣayati, ētādr̥śī yōṣit kāstē?</para>
  <para style="p">
    <verse number="9" style="v"/>prāptē sati bandhubāndhavasamīpavāsinīrāhūya kathayati, hāritaṁ rūpyakhaṇḍaṁ prāptāhaṁ tasmādēva mayā sārddham ānandata|</para>
  <para style="p">
    <verse number="10" style="v"/>tadvadahaṁ yuṣmān vyāharāmi, ēkēna pāpinā manasi parivarttitē, īśvarasya dūtānāṁ madhyēpyānandō jāyatē|</para>
  <para style="p">
    <verse number="11" style="v"/>aparañca sa kathayāmāsa, kasyacid dvau putrāvāstāṁ,</para>
  <para style="p">
    <verse number="12" style="v"/>tayōḥ kaniṣṭhaḥ putraḥ pitrē kathayāmāsa, hē pitastava sampattyā yamaṁśaṁ prāpsyāmyahaṁ vibhajya taṁ dēhi, tataḥ pitā nijāṁ sampattiṁ vibhajya tābhyāṁ dadau|</para>
  <para style="p">
    <verse number="13" style="v"/>katipayāt kālāt paraṁ sa kaniṣṭhaputraḥ samastaṁ dhanaṁ saṁgr̥hya dūradēśaṁ gatvā duṣṭācaraṇēna sarvvāṁ sampattiṁ nāśayāmāsa|</para>
  <para style="p">
    <verse number="14" style="v"/>tasya sarvvadhanē vyayaṁ gatē taddēśē mahādurbhikṣaṁ babhūva, tatastasya dainyadaśā bhavitum ārēbhē|</para>
  <para style="p">
    <verse number="15" style="v"/>tataḥ paraṁ sa gatvā taddēśīyaṁ gr̥hasthamēkam āśrayata; tataḥ sataṁ śūkaravrajaṁ cārayituṁ prāntaraṁ prēṣayāmāsa|</para>
  <para style="p">
    <verse number="16" style="v"/>kēnāpi tasmai bhakṣyādānāt sa śūkaraphalavalkalēna piciṇḍapūraṇāṁ vavāñcha|</para>
  <para style="p">
    <verse number="17" style="v"/>śēṣē sa manasi cētanāṁ prāpya kathayāmāsa, hā mama pituḥ samīpē kati kati vētanabhujō dāsā yathēṣṭaṁ tatōdhikañca bhakṣyaṁ prāpnuvanti kintvahaṁ kṣudhā mumūrṣuḥ|</para>
  <para style="p">
    <verse number="18" style="v"/>ahamutthāya pituḥ samīpaṁ gatvā kathāmētāṁ vadiṣyāmi, hē pitar īśvarasya tava ca viruddhaṁ pāpamakaravam</para>
  <para style="p">
    <verse number="19" style="v"/>tava putra̮iti vikhyātō bhavituṁ na yōgyōsmi ca, māṁ tava vaitanikaṁ dāsaṁ kr̥tvā sthāpaya|</para>
  <para style="p">
    <verse number="20" style="v"/>paścāt sa utthāya pituḥ samīpaṁ jagāma; tatastasya pitātidūrē taṁ nirīkṣya dayāñcakrē, dhāvitvā tasya kaṇṭhaṁ gr̥hītvā taṁ cucumba ca|</para>
  <para style="p">
    <verse number="21" style="v"/>tadā putra uvāca, hē pitar īśvarasya tava ca viruddhaṁ pāpamakaravaṁ, tava putra̮iti vikhyātō bhavituṁ na yōgyōsmi ca|</para>
  <para style="p">
    <verse number="22" style="v"/>kintu tasya pitā nijadāsān ādidēśa, sarvvōttamavastrāṇyānīya paridhāpayatainaṁ hastē cāṅgurīyakam arpayata pādayōścōpānahau samarpayata;</para>
  <para style="p">
    <verse number="23" style="v"/>puṣṭaṁ gōvatsam ānīya mārayata ca taṁ bhuktvā vayam ānandāma|</para>
  <para style="p">
    <verse number="24" style="v"/>yatō mama putrōyam amriyata punarajīvīd hāritaśca labdhōbhūt tatasta ānanditum ārēbhirē|</para>
  <para style="p">
    <verse number="25" style="v"/>tatkālē tasya jyēṣṭhaḥ putraḥ kṣētra āsīt| atha sa nivēśanasya nikaṭaṁ āgacchan nr̥tyānāṁ vādyānāñca śabdaṁ śrutvā</para>
  <para style="p">
    <verse number="26" style="v"/>dāsānām ēkam āhūya papraccha, kiṁ kāraṇamasya?</para>
  <para style="p">
    <verse number="27" style="v"/>tataḥ sōvādīt, tava bhrātāgamat, tava tātaśca taṁ suśarīraṁ prāpya puṣṭaṁ gōvatsaṁ māritavān|</para>
  <para style="p">
    <verse number="28" style="v"/>tataḥ sa prakupya nivēśanāntaḥ pravēṣṭuṁ na sammēnē; tatastasya pitā bahirāgatya taṁ sādhayāmāsa|</para>
  <para style="p">
    <verse number="29" style="v"/>tataḥ sa pitaraṁ pratyuvāca, paśya tava kāñcidapyājñāṁ na vilaṁghya bahūn vatsarān ahaṁ tvāṁ sēvē tathāpi mitraiḥ sārddham utsavaṁ karttuṁ kadāpi chāgamēkamapi mahyaṁ nādadāḥ;</para>
  <para style="p">
    <verse number="30" style="v"/>kintu tava yaḥ putrō vēśyāgamanādibhistava sampattim apavyayitavān tasminnāgatamātrē tasyaiva nimittaṁ puṣṭaṁ gōvatsaṁ māritavān|</para>
  <para style="p">
    <verse number="31" style="v"/>tadā tasya pitāvōcat, hē putra tvaṁ sarvvadā mayā sahāsi tasmān mama yadyadāstē tatsarvvaṁ tava|</para>
  <para style="p">
    <verse number="32" style="v"/>kintu tavāyaṁ bhrātā mr̥taḥ punarajīvīd hāritaśca bhūtvā prāptōbhūt, ētasmāt kāraṇād utsavānandau karttum ucitamasmākam|</para>
  <chapter number="16" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>aparañca yīśuḥ śiṣyēbhyōnyāmēkāṁ kathāṁ kathayāmāsa kasyacid dhanavatō manuṣyasya gr̥hakāryyādhīśē sampattērapavyayē'pavāditē sati</para>
  <para style="p">
    <verse number="2" style="v"/>tasya prabhustam āhūya jagāda, tvayi yāmimāṁ kathāṁ śr̥ṇōmi sā kīdr̥śī? tvaṁ gr̥hakāryyādhīśakarmmaṇō gaṇanāṁ darśaya gr̥hakāryyādhīśapadē tvaṁ na sthāsyasi|</para>
  <para style="p">
    <verse number="3" style="v"/>tadā sa gr̥hakāryyādhīśō manasā cintayāmāsa, prabhu ryadi māṁ gr̥hakāryyādhīśapadād bhraṁśayati tarhi kiṁ kariṣyē'haṁ? mr̥daṁ khanituṁ mama śakti rnāsti bhikṣituñca lajjiṣyē'haṁ|</para>
  <para style="p">
    <verse number="4" style="v"/>ataēva mayi gr̥hakāryyādhīśapadāt cyutē sati yathā lōkā mahyam āśrayaṁ dāsyanti tadarthaṁ yatkarmma mayā karaṇīyaṁ tan nirṇīyatē|</para>
  <para style="p">
    <verse number="5" style="v"/>paścāt sa svaprabhōrēkaikam adhamarṇam āhūya prathamaṁ papraccha, tvattō mē prabhuṇā kati prāpyam?</para>
  <para style="p">
    <verse number="6" style="v"/>tataḥ sa uvāca, ēkaśatāḍhakatailāni; tadā gr̥hakāryyādhīśaḥ prōvāca, tava patramānīya śīghramupaviśya tatra pañcāśataṁ likha|</para>
  <para style="p">
    <verse number="7" style="v"/>paścādanyamēkaṁ papraccha, tvattō mē prabhuṇā kati prāpyam? tataḥ sōvādīd ēkaśatāḍhakagōdhūmāḥ; tadā sa kathayāmāsa, tava patramānīya aśītiṁ likha|</para>
  <para style="p">
    <verse number="8" style="v"/>tēnaiva prabhustamayathārthakr̥tam adhīśaṁ tadbuddhinaipuṇyāt praśaśaṁsa; itthaṁ dīptirūpasantānēbhya ētatsaṁsārasya santānā varttamānakālē'dhikabuddhimantō bhavanti|</para>
  <para style="p">
    <verse number="9" style="v"/>atō vadāmi yūyamapyayathārthēna dhanēna mitrāṇi labhadhvaṁ tatō yuṣmāsu padabhraṣṭēṣvapi tāni cirakālam āśrayaṁ dāsyanti|</para>
  <para style="p">
    <verse number="10" style="v"/>yaḥ kaścit kṣudrē kāryyē viśvāsyō bhavati sa mahati kāryyēpi viśvāsyō bhavati, kintu yaḥ kaścit kṣudrē kāryyē'viśvāsyō bhavati sa mahati kāryyēpyaviśvāsyō bhavati|</para>
  <para style="p">
    <verse number="11" style="v"/>ataēva ayathārthēna dhanēna yadi yūyamaviśvāsyā jātāstarhi satyaṁ dhanaṁ yuṣmākaṁ karēṣu kaḥ samarpayiṣyati?</para>
  <para style="p">
    <verse number="12" style="v"/>yadi ca paradhanēna yūyam aviśvāsyā bhavatha tarhi yuṣmākaṁ svakīyadhanaṁ yuṣmabhyaṁ kō dāsyati?</para>
  <para style="p">
    <verse number="13" style="v"/>kōpi dāsa ubhau prabhū sēvituṁ na śaknōti, yata ēkasmin prīyamāṇō'nyasminnaprīyatē yadvā ēkaṁ janaṁ samādr̥tya tadanyaṁ tucchīkarōti tadvad yūyamapi dhanēśvarau sēvituṁ na śaknutha|</para>
  <para style="p">
    <verse number="14" style="v"/>tadaitāḥ sarvvāḥ kathāḥ śrutvā lōbhiphirūśinastamupajahasuḥ|</para>
  <para style="p">
    <verse number="15" style="v"/>tataḥ sa uvāca, yūyaṁ manuṣyāṇāṁ nikaṭē svān nirdōṣān darśayatha kintu yuṣmākam antaḥkaraṇānīśvarō jānāti, yat manuṣyāṇām ati praśaṁsyaṁ tad īśvarasya ghr̥ṇyaṁ|</para>
  <para style="p">
    <verse number="16" style="v"/>yōhana āgamanaparyyanataṁ yuṣmākaṁ samīpē vyavasthābhaviṣyadvādināṁ lēkhanāni cāsan tataḥ prabhr̥ti īśvararājyasya susaṁvādaḥ pracarati, ēkaikō lōkastanmadhyaṁ yatnēna praviśati ca|</para>
  <para style="p">
    <verse number="17" style="v"/>varaṁ nabhasaḥ pr̥thivyāśca lōpō bhaviṣyati tathāpi vyavasthāyā ēkabindōrapi lōpō na bhaviṣyati|</para>
  <para style="p">
    <verse number="18" style="v"/>yaḥ kaścit svīyāṁ bhāryyāṁ vihāya striyamanyāṁ vivahati sa paradārān gacchati, yaśca tā tyaktāṁ nārīṁ vivahati sōpi paradārāna gacchati|</para>
  <para style="p">
    <verse number="19" style="v"/>ēkō dhanī manuṣyaḥ śuklāni sūkṣmāṇi vastrāṇi paryyadadhāt pratidinaṁ paritōṣarūpēṇābhuṁktāpivacca|</para>
  <para style="p">
    <verse number="20" style="v"/>sarvvāṅgē kṣatayukta iliyāsaranāmā kaścid daridrastasya dhanavatō bhōjanapātrāt patitam ucchiṣṭaṁ bhōktuṁ vāñchan tasya dvārē patitvātiṣṭhat;</para>
  <para style="p">
    <verse number="21" style="v"/>atha śvāna āgatya tasya kṣatānyalihan|</para>
  <para style="p">
    <verse number="22" style="v"/>kiyatkālātparaṁ sa daridraḥ prāṇān jahau; tataḥ svargīyadūtāstaṁ nītvā ibrāhīmaḥ krōḍa upavēśayāmāsuḥ|</para>
  <para style="p">
    <verse number="23" style="v"/>paścāt sa dhanavānapi mamāra, taṁ śmaśānē sthāpayāmāsuśca; kintu paralōkē sa vēdanākulaḥ san ūrddhvāṁ nirīkṣya bahudūrād ibrāhīmaṁ tatkrōḍa iliyāsarañca vilōkya ruvannuvāca;</para>
  <para style="p">
    <verse number="24" style="v"/>hē pitar ibrāhīm anugr̥hya aṅgulyagrabhāgaṁ jalē majjayitvā mama jihvāṁ śītalāṁ karttum iliyāsaraṁ prēraya, yatō vahniśikhātōhaṁ vyathitōsmi|</para>
  <para style="p">
    <verse number="25" style="v"/>tadā ibrāhīm babhāṣē, hē putra tvaṁ jīvan sampadaṁ prāptavān iliyāsarastu vipadaṁ prāptavān ētat smara, kintu samprati tasya sukhaṁ tava ca duḥkhaṁ bhavati|</para>
  <para style="p">
    <verse number="26" style="v"/>aparamapi yuṣmākam asmākañca sthānayō rmadhyē mahadvicchēdō'sti tata ētatsthānasya lōkāstat sthānaṁ yātuṁ yadvā tatsthānasya lōkā ētat sthānamāyātuṁ na śaknuvanti|</para>
  <para style="p">
    <verse number="27" style="v"/>tadā sa uktavān, hē pitastarhi tvāṁ nivēdayāmi mama pitu rgēhē yē mama pañca bhrātaraḥ santi</para>
  <para style="p">
    <verse number="28" style="v"/>tē yathaitad yātanāsthānaṁ nāyāsyanti tathā mantraṇāṁ dātuṁ tēṣāṁ samīpam iliyāsaraṁ prēraya|</para>
  <para style="p">
    <verse number="29" style="v"/>tata ibrāhīm uvāca, mūsābhaviṣyadvādināñca pustakāni tēṣāṁ nikaṭē santi tē tadvacanāni manyantāṁ|</para>
  <para style="p">
    <verse number="30" style="v"/>tadā sa nivēdayāmāsa, hē pitar ibrāhīm na tathā, kintu yadi mr̥talōkānāṁ kaścit tēṣāṁ samīpaṁ yāti tarhi tē manāṁsi vyāghōṭayiṣyanti|</para>
  <para style="p">
    <verse number="31" style="v"/>tata ibrāhīm jagāda, tē yadi mūsābhaviṣyadvādināñca vacanāni na manyantē tarhi mr̥talōkānāṁ kasmiṁścid utthitēpi tē tasya mantraṇāṁ na maṁsyantē|</para>
  <chapter number="17" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>itaḥ paraṁ yīśuḥ śiṣyān uvāca, vighnairavaśyam āgantavyaṁ kintu vighnā yēna ghaṭiṣyantē tasya durgati rbhaviṣyati|</para>
  <para style="p">
    <verse number="2" style="v"/>ētēṣāṁ kṣudraprāṇinām ēkasyāpi vighnajananāt kaṇṭhabaddhapēṣaṇīkasya tasya sāgarāgādhajalē majjanaṁ bhadraṁ|</para>
  <para style="p">
    <verse number="3" style="v"/>yūyaṁ svēṣu sāvadhānāstiṣṭhata; tava bhrātā yadi tava kiñcid aparādhyati tarhi taṁ tarjaya, tēna yadi manaḥ parivarttayati tarhi taṁ kṣamasva|</para>
  <para style="p">
    <verse number="4" style="v"/>punarēkadinamadhyē yadi sa tava saptakr̥tvō'parādhyati kintu saptakr̥tva āgatya manaḥ parivartya mayāparāddham iti vadati tarhi taṁ kṣamasva|</para>
  <para style="p">
    <verse number="5" style="v"/>tadā prēritāḥ prabhum avadan asmākaṁ viśvāsaṁ varddhaya|</para>
  <para style="p">
    <verse number="6" style="v"/>prabhuruvāca, yadi yuṣmākaṁ sarṣapaikapramāṇō viśvāsōsti tarhi tvaṁ samūlamutpāṭitō bhūtvā samudrē rōpitō bhava kathāyām ētasyām ētaduḍumbarāya kathitāyāṁ sa yuṣmākamājñāvahō bhaviṣyati|</para>
  <para style="p">
    <verse number="7" style="v"/>aparaṁ svadāsē halaṁ vāhayitvā vā paśūn cārayitvā kṣētrād āgatē sati taṁ vadati, ēhi bhōktumupaviśa, yuṣmākam ētādr̥śaḥ kōsti?</para>
  <para style="p">
    <verse number="8" style="v"/>varañca pūrvvaṁ mama khādyamāsādya yāvad bhuñjē pivāmi ca tāvad baddhakaṭiḥ paricara paścāt tvamapi bhōkṣyasē pāsyasi ca kathāmīdr̥śīṁ kiṁ na vakṣyati?</para>
  <para style="p">
    <verse number="9" style="v"/>tēna dāsēna prabhōrājñānurūpē karmmaṇi kr̥tē prabhuḥ kiṁ tasmin bādhitō jātaḥ? nētthaṁ budhyatē mayā|</para>
  <para style="p">
    <verse number="10" style="v"/>itthaṁ nirūpitēṣu sarvvakarmmasu kr̥tēṣu satmu yūyamapīdaṁ vākyaṁ vadatha, vayam anupakāriṇō dāsā asmābhiryadyatkarttavyaṁ tanmātramēva kr̥taṁ|</para>
  <para style="p">
    <verse number="11" style="v"/>sa yirūśālami yātrāṁ kurvvan śōmirōṇgālīlpradēśamadhyēna gacchati,</para>
  <para style="p">
    <verse number="12" style="v"/>ētarhi kutracid grāmē pravēśamātrē daśakuṣṭhinastaṁ sākṣāt kr̥tvā</para>
  <para style="p">
    <verse number="13" style="v"/>dūrē tiṣṭhanata uccai rvaktumārēbhirē, hē prabhō yīśō dayasvāsmān|</para>
  <para style="p">
    <verse number="14" style="v"/>tataḥ sa tān dr̥ṣṭvā jagāda, yūyaṁ yājakānāṁ samīpē svān darśayata, tatastē gacchantō rōgāt pariṣkr̥tāḥ|</para>
  <para style="p">
    <verse number="15" style="v"/>tadā tēṣāmēkaḥ svaṁ svasthaṁ dr̥ṣṭvā prōccairīśvaraṁ dhanyaṁ vadan vyāghuṭyāyātō yīśō rguṇānanuvadan taccaraṇādhōbhūmau papāta;</para>
  <para style="p">
    <verse number="16" style="v"/>sa cāsīt śōmirōṇī|</para>
  <para style="p">
    <verse number="17" style="v"/>tadā yīśuravadat, daśajanāḥ kiṁ na pariṣkr̥tāḥ? tahyanyē navajanāḥ kutra?</para>
  <para style="p">
    <verse number="18" style="v"/>īśvaraṁ dhanyaṁ vadantam ēnaṁ vidēśinaṁ vinā kōpyanyō na prāpyata|</para>
  <para style="p">
    <verse number="19" style="v"/>tadā sa tamuvāca, tvamutthāya yāhi viśvāsastē tvāṁ svasthaṁ kr̥tavān|</para>
  <para style="p">
    <verse number="20" style="v"/>atha kadēśvarasya rājatvaṁ bhaviṣyatīti phirūśibhiḥ pr̥ṣṭē sa pratyuvāca, īśvarasya rājatvam aiśvaryyadarśanēna na bhaviṣyati|</para>
  <para style="p">
    <verse number="21" style="v"/>ata ētasmin paśya tasmin vā paśya, iti vākyaṁ lōkā vaktuṁ na śakṣyanti, īśvarasya rājatvaṁ yuṣmākam antarēvāstē|</para>
  <para style="p">
    <verse number="22" style="v"/>tataḥ sa śiṣyān jagāda, yadā yuṣmābhi rmanujasutasya dinamēkaṁ draṣṭum vāñchiṣyatē kintu na darśiṣyatē, īdr̥kkāla āyāti|</para>
  <para style="p">
    <verse number="23" style="v"/>tadātra paśya vā tatra paśyēti vākyaṁ lōkā vakṣyanti, kintu tēṣāṁ paścāt mā yāta, mānugacchata ca|</para>
  <para style="p">
    <verse number="24" style="v"/>yatastaḍid yathākāśaikadiśyudiya tadanyāmapi diśaṁ vyāpya prakāśatē tadvat nijadinē manujasūnuḥ prakāśiṣyatē|</para>
  <para style="p">
    <verse number="25" style="v"/>kintu tatpūrvvaṁ tēnānēkāni duḥkhāni bhōktavyānyētadvarttamānalōkaiśca sō'vajñātavyaḥ|</para>
  <para style="p">
    <verse number="26" style="v"/>nōhasya vidyamānakālē yathābhavat manuṣyasūnōḥ kālēpi tathā bhaviṣyati|</para>
  <para style="p">
    <verse number="27" style="v"/>yāvatkālaṁ nōhō mahāpōtaṁ nārōhad āplāvivāryyētya sarvvaṁ nānāśayacca tāvatkālaṁ yathā lōkā abhuñjatāpivan vyavahan vyavāhayaṁśca;</para>
  <para style="p">
    <verse number="28" style="v"/>itthaṁ lōṭō varttamānakālēpi yathā lōkā bhōjanapānakrayavikrayarōpaṇagr̥hanirmmāṇakarmmasu prāvarttanta,</para>
  <para style="p">
    <verse number="29" style="v"/>kintu yadā lōṭ sidōmō nirjagāma tadā nabhasaḥ sagandhakāgnivr̥ṣṭi rbhūtvā sarvvaṁ vyanāśayat</para>
  <para style="p">
    <verse number="30" style="v"/>tadvan mānavaputraprakāśadinēpi bhaviṣyati|</para>
  <para style="p">
    <verse number="31" style="v"/>tadā yadi kaścid gr̥hōpari tiṣṭhati tarhi sa gr̥hamadhyāt kimapi dravyamānētum avaruhya naitu; yaśca kṣētrē tiṣṭhati sōpi vyāghuṭya nāyātu|</para>
  <para style="p">
    <verse number="32" style="v"/>lōṭaḥ patnīṁ smarata|</para>
  <para style="p">
    <verse number="33" style="v"/>yaḥ prāṇān rakṣituṁ cēṣṭiṣyatē sa prāṇān hārayiṣyati yastu prāṇān hārayiṣyati saēva prāṇān rakṣiṣyati|</para>
  <para style="p">
    <verse number="34" style="v"/>yuṣmānahaṁ vacmi tasyāṁ rātrau śayyaikagatayō rlōkayōrēkō dhāriṣyatē parastyakṣyatē|</para>
  <para style="p">
    <verse number="35" style="v"/>striyau yugapat pēṣaṇīṁ vyāvarttayiṣyatastayōrēkā dhāriṣyatē parātyakṣyatē|</para>
  <para style="p">
    <verse number="36" style="v"/>puruṣau kṣētrē sthāsyatastayōrēkō dhāriṣyatē parastyakṣyatē|</para>
  <para style="p">
    <verse number="37" style="v"/>tadā tē papracchuḥ, hē prabhō kutrētthaṁ bhaviṣyati? tataḥ sa uvāca, yatra śavastiṣṭhati tatra gr̥dhrā milanti|</para>
  <chapter number="18" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>aparañca lōkairaklāntai rnirantaraṁ prārthayitavyam ityāśayēna yīśunā dr̥ṣṭānta ēkaḥ kathitaḥ|</para>
  <para style="p">
    <verse number="2" style="v"/>kutracinnagarē kaścit prāḍvivāka āsīt sa īśvarānnābibhēt mānuṣāṁśca nāmanyata|</para>
  <para style="p">
    <verse number="3" style="v"/>atha tatpuravāsinī kācidvidhavā tatsamīpamētya vivādinā saha mama vivādaṁ pariṣkurvviti nivēdayāmāsa|</para>
  <para style="p">
    <verse number="4" style="v"/>tataḥ sa prāḍvivākaḥ kiyaddināni na tadaṅgīkr̥tavān paścāccittē cintayāmāsa, yadyapīśvarānna bibhēmi manuṣyānapi na manyē</para>
  <para style="p">
    <verse number="5" style="v"/>tathāpyēṣā vidhavā māṁ kliśnāti tasmādasyā vivādaṁ pariṣkariṣyāmi nōcēt sā sadāgatya māṁ vyagraṁ kariṣyati|</para>
  <para style="p">
    <verse number="6" style="v"/>paścāt prabhuravadad asāvanyāyaprāḍvivākō yadāha tatra manō nidhadhvaṁ|</para>
  <para style="p">
    <verse number="7" style="v"/>īśvarasya yē 'bhirucitalōkā divāniśaṁ prārthayantē sa bahudināni vilambyāpi tēṣāṁ vivādān kiṁ na pariṣkariṣyati?</para>
  <para style="p">
    <verse number="8" style="v"/>yuṣmānahaṁ vadāmi tvarayā pariṣkariṣyati, kintu yadā manuṣyaputra āgamiṣyati tadā pr̥thivyāṁ kimīdr̥śaṁ viśvāsaṁ prāpsyati?</para>
  <para style="p">
    <verse number="9" style="v"/>yē svān dhārmmikān jñātvā parān tucchīkurvvanti ētādr̥gbhyaḥ, kiyadbhya imaṁ dr̥ṣṭāntaṁ kathayāmāsa|</para>
  <para style="p">
    <verse number="10" style="v"/>ēkaḥ phirūśyaparaḥ karasañcāyī dvāvimau prārthayituṁ mandiraṁ gatau|</para>
  <para style="p">
    <verse number="11" style="v"/>tatō'sau phirūśyēkapārśvē tiṣṭhan hē īśvara ahamanyalōkavat lōṭhayitānyāyī pāradārikaśca na bhavāmi asya karasañcāyinastulyaśca na, tasmāttvāṁ dhanyaṁ vadāmi|</para>
  <para style="p">
    <verse number="12" style="v"/>saptasu dinēṣu dinadvayamupavasāmi sarvvasampattē rdaśamāṁśaṁ dadāmi ca, ētatkathāṁ kathayan prārthayāmāsa|</para>
  <para style="p">
    <verse number="13" style="v"/>kintu sa karasañcāyi dūrē tiṣṭhan svargaṁ draṣṭuṁ nēcchan vakṣasi karāghātaṁ kurvvan hē īśvara pāpiṣṭhaṁ māṁ dayasva, itthaṁ prārthayāmāsa|</para>
  <para style="p">
    <verse number="14" style="v"/>yuṣmānahaṁ vadāmi, tayōrdvayō rmadhyē kēvalaḥ karasañcāyī puṇyavattvēna gaṇitō nijagr̥haṁ jagāma, yatō yaḥ kaścit svamunnamayati sa nāmayiṣyatē kintu yaḥ kaścit svaṁ namayati sa unnamayiṣyatē|</para>
  <para style="p">
    <verse number="15" style="v"/>atha śiśūnāṁ gātrasparśārthaṁ lōkāstān tasya samīpamāninyuḥ śiṣyāstad dr̥ṣṭvānētr̥n tarjayāmāsuḥ,</para>
  <para style="p">
    <verse number="16" style="v"/>kintu yīśustānāhūya jagāda, mannikaṭam āgantuṁ śiśūn anujānīdhvaṁ tāṁśca mā vārayata; yata īśvararājyādhikāriṇa ēṣāṁ sadr̥śāḥ|</para>
  <para style="p">
    <verse number="17" style="v"/>ahaṁ yuṣmān yathārthaṁ vadāmi, yō janaḥ śiśōḥ sadr̥śō bhūtvā īśvararājyaṁ na gr̥hlāti sa kēnāpi prakārēṇa tat pravēṣṭuṁ na śaknōti|</para>
  <para style="p">
    <verse number="18" style="v"/>aparam ēkōdhipatistaṁ papraccha, hē paramagurō, anantāyuṣaḥ prāptayē mayā kiṁ karttavyaṁ?</para>
  <para style="p">
    <verse number="19" style="v"/>yīśuruvāca, māṁ kutaḥ paramaṁ vadasi? īśvaraṁ vinā kōpi paramō na bhavati|</para>
  <para style="p">
    <verse number="20" style="v"/>paradārān mā gaccha, naraṁ mā jahi, mā cōraya, mithyāsākṣyaṁ mā dēhi, mātaraṁ pitarañca saṁmanyasva, ētā yā ājñāḥ santi tāstvaṁ jānāsi|</para>
  <para style="p">
    <verse number="21" style="v"/>tadā sa uvāca, bālyakālāt sarvvā ētā ācarāmi|</para>
  <para style="p">
    <verse number="22" style="v"/>iti kathāṁ śrutvā yīśustamavadat, tathāpi tavaikaṁ karmma nyūnamāstē, nijaṁ sarvvasvaṁ vikrīya daridrēbhyō vitara, tasmāt svargē dhanaṁ prāpsyasi; tata āgatya mamānugāmī bhava|</para>
  <para style="p">
    <verse number="23" style="v"/>kintvētāṁ kathāṁ śrutvā sōdhipatiḥ śuśōca, yatastasya bahudhanamāsīt|</para>
  <para style="p">
    <verse number="24" style="v"/>tadā yīśustamatiśōkānvitaṁ dr̥ṣṭvā jagāda, dhanavatām īśvararājyapravēśaḥ kīdr̥g duṣkaraḥ|</para>
  <para style="p">
    <verse number="25" style="v"/>īśvararājyē dhaninaḥ pravēśāt sūcēśchidrēṇa mahāṅgasya gamanāgamanē sukarē|</para>
  <para style="p">
    <verse number="26" style="v"/>śrōtāraḥ papracchustarhi kēna paritrāṇaṁ prāpsyatē?</para>
  <para style="p">
    <verse number="27" style="v"/>sa uktavān, yan mānuṣēṇāśakyaṁ tad īśvarēṇa śakyaṁ|</para>
  <para style="p">
    <verse number="28" style="v"/>tadā pitara uvāca, paśya vayaṁ sarvvasvaṁ parityajya tava paścādgāminō'bhavāma|</para>
  <para style="p">
    <verse number="29" style="v"/>tataḥ sa uvāca, yuṣmānahaṁ yathārthaṁ vadāmi, īśvararājyārthaṁ gr̥haṁ pitarau bhrātr̥gaṇaṁ jāyāṁ santānāṁśca tyaktavā</para>
  <para style="p">
    <verse number="30" style="v"/>iha kālē tatō'dhikaṁ parakālē 'nantāyuśca na prāpsyati lōka īdr̥śaḥ kōpi nāsti|</para>
  <para style="p">
    <verse number="31" style="v"/>anantaraṁ sa dvādaśaśiṣyānāhūya babhāṣē, paśyata vayaṁ yirūśālamnagaraṁ yāmaḥ, tasmāt manuṣyaputrē bhaviṣyadvādibhiruktaṁ yadasti tadanurūpaṁ taṁ prati ghaṭiṣyatē;</para>
  <para style="p">
    <verse number="32" style="v"/>vastutastu sō'nyadēśīyānāṁ hastēṣu samarpayiṣyatē, tē tamupahasiṣyanti, anyāyamācariṣyanti tadvapuṣi niṣṭhīvaṁ nikṣēpsyanti, kaśābhiḥ prahr̥tya taṁ haniṣyanti ca,</para>
  <para style="p">
    <verse number="33" style="v"/>kintu tr̥tīyadinē sa śmaśānād utthāsyati|</para>
  <para style="p">
    <verse number="34" style="v"/>ētasyāḥ kathāyā abhiprāyaṁ kiñcidapi tē bōddhuṁ na śēkuḥ tēṣāṁ nikaṭē'spaṣṭatavāt tasyaitāsāṁ kathānām āśayaṁ tē jñātuṁ na śēkuśca|</para>
  <para style="p">
    <verse number="35" style="v"/>atha tasmin yirīhōḥ purasyāntikaṁ prāptē kaścidandhaḥ pathaḥ pārśva upaviśya bhikṣām akarōt</para>
  <para style="p">
    <verse number="36" style="v"/>sa lōkasamūhasya gamanaśabdaṁ śrutvā tatkāraṇaṁ pr̥ṣṭavān|</para>
  <para style="p">
    <verse number="37" style="v"/>nāsaratīyayīśuryātīti lōkairuktē sa uccairvaktumārēbhē,</para>
  <para style="p">
    <verse number="38" style="v"/>hē dāyūdaḥ santāna yīśō māṁ dayasva|</para>
  <para style="p">
    <verse number="39" style="v"/>tatōgragāminastaṁ maunī tiṣṭhēti tarjayāmāsuḥ kintu sa punāruvan uvāca, hē dāyūdaḥ santāna māṁ dayasva|</para>
  <para style="p">
    <verse number="40" style="v"/>tadā yīśuḥ sthagitō bhūtvā svāntikē tamānētum ādidēśa|</para>
  <para style="p">
    <verse number="41" style="v"/>tataḥ sa tasyāntikam āgamat, tadā sa taṁ papraccha, tvaṁ kimicchasi? tvadarthamahaṁ kiṁ kariṣyāmi? sa uktavān, hē prabhō'haṁ draṣṭuṁ labhai|</para>
  <para style="p">
    <verse number="42" style="v"/>tadā yīśuruvāca, dr̥ṣṭiśaktiṁ gr̥hāṇa tava pratyayastvāṁ svasthaṁ kr̥tavān|</para>
  <para style="p">
    <verse number="43" style="v"/>tatastatkṣaṇāt tasya cakṣuṣī prasannē; tasmāt sa īśvaraṁ dhanyaṁ vadan tatpaścād yayau, tadālōkya sarvvē lōkā īśvaraṁ praśaṁsitum ārēbhirē|</para>
  <chapter number="19" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>yadā yīśu ryirīhōpuraṁ praviśya tanmadhyēna gacchaṁstadā</para>
  <para style="p">
    <verse number="2" style="v"/>sakkēyanāmā karasañcāyināṁ pradhānō dhanavānēkō</para>
  <para style="p">
    <verse number="3" style="v"/>yīśuḥ kīdr̥giti draṣṭuṁ cēṣṭitavān kintu kharvvatvāllōkasaṁghamadhyē taddarśanamaprāpya</para>
  <para style="p">
    <verse number="4" style="v"/>yēna pathā sa yāsyati tatpathē'grē dhāvitvā taṁ draṣṭum uḍumbaratarumārurōha|</para>
  <para style="p">
    <verse number="5" style="v"/>paścād yīśustatsthānam itvā ūrddhvaṁ vilōkya taṁ dr̥ṣṭvāvādīt, hē sakkēya tvaṁ śīghramavarōha mayādya tvadgēhē vastavyaṁ|</para>
  <para style="p">
    <verse number="6" style="v"/>tataḥ sa śīghramavaruhya sāhlādaṁ taṁ jagrāha|</para>
  <para style="p">
    <verse number="7" style="v"/>tad dr̥ṣṭvā sarvvē vivadamānā vaktumārēbhirē, sōtithitvēna duṣṭalōkagr̥haṁ gacchati|</para>
  <para style="p">
    <verse number="8" style="v"/>kintu sakkēyō daṇḍāyamānō vaktumārēbhē, hē prabhō paśya mama yā sampattirasti tadarddhaṁ daridrēbhyō dadē, aparam anyāyaṁ kr̥tvā kasmādapi yadi kadāpi kiñcit mayā gr̥hītaṁ tarhi taccaturguṇaṁ dadāmi|</para>
  <para style="p">
    <verse number="9" style="v"/>tadā yīśustamuktavān ayamapi ibrāhīmaḥ santānō'taḥ kāraṇād adyāsya gr̥hē trāṇamupasthitaṁ|</para>
  <para style="p">
    <verse number="10" style="v"/>yad hāritaṁ tat mr̥gayituṁ rakṣituñca manuṣyaputra āgatavān|</para>
  <para style="p">
    <verse number="11" style="v"/>atha sa yirūśālamaḥ samīpa upātiṣṭhad īśvararājatvasyānuṣṭhānaṁ tadaiva bhaviṣyatīti lōkairanvabhūyata, tasmāt sa śrōtr̥bhyaḥ punardr̥ṣṭāntakathām utthāpya kathayāmāsa|</para>
  <para style="p">
    <verse number="12" style="v"/>kōpi mahāllōkō nijārthaṁ rājatvapadaṁ gr̥hītvā punarāgantuṁ dūradēśaṁ jagāma|</para>
  <para style="p">
    <verse number="13" style="v"/>yātrākālē nijān daśadāsān āhūya daśasvarṇamudrā dattvā mamāgamanaparyyantaṁ vāṇijyaṁ kurutētyādidēśa|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu tasya prajāstamavajñāya manuṣyamēnam asmākamupari rājatvaṁ na kārayivyāma imāṁ vārttāṁ tannikaṭē prērayāmāsuḥ|</para>
  <para style="p">
    <verse number="15" style="v"/>atha sa rājatvapadaṁ prāpyāgatavān ēkaikō janō bāṇijyēna kiṁ labdhavān iti jñātuṁ yēṣu dāsēṣu mudrā arpayat tān āhūyānētum ādidēśa|</para>
  <para style="p">
    <verse number="16" style="v"/>tadā prathama āgatya kathitavān, hē prabhō tava tayaikayā mudrayā daśamudrā labdhāḥ|</para>
  <para style="p">
    <verse number="17" style="v"/>tataḥ sa uvāca tvamuttamō dāsaḥ svalpēna viśvāsyō jāta itaḥ kāraṇāt tvaṁ daśanagarāṇām adhipō bhava|</para>
  <para style="p">
    <verse number="18" style="v"/>dvitīya āgatya kathitavān, hē prabhō tavaikayā mudrayā pañcamudrā labdhāḥ|</para>
  <para style="p">
    <verse number="19" style="v"/>tataḥ sa uvāca, tvaṁ pañcānāṁ nagarāṇāmadhipati rbhava|</para>
  <para style="p">
    <verse number="20" style="v"/>tatōnya āgatya kathayāmāsa, hē prabhō paśya tava yā mudrā ahaṁ vastrē baddhvāsthāpayaṁ sēyaṁ|</para>
  <para style="p">
    <verse number="21" style="v"/>tvaṁ kr̥paṇō yannāsthāpayastadapi gr̥hlāsi, yannāvapastadēva ca chinatsi tatōhaṁ tvattō bhītaḥ|</para>
  <para style="p">
    <verse number="22" style="v"/>tadā sa jagāda, rē duṣṭadāsa tava vākyēna tvāṁ dōṣiṇaṁ kariṣyāmi, yadahaṁ nāsthāpayaṁ tadēva gr̥hlāmi, yadahaṁ nāvapañca tadēva chinadmi, ētādr̥śaḥ kr̥paṇōhamiti yadi tvaṁ jānāsi,</para>
  <para style="p">
    <verse number="23" style="v"/>tarhi mama mudrā baṇijāṁ nikaṭē kutō nāsthāpayaḥ? tayā kr̥tē'ham āgatya kusīdēna sārddhaṁ nijamudrā aprāpsyam|</para>
  <para style="p">
    <verse number="24" style="v"/>paścāt sa samīpasthān janān ājñāpayat asmāt mudrā ānīya yasya daśamudrāḥ santi tasmai datta|</para>
  <para style="p">
    <verse number="25" style="v"/>tē prōcuḥ prabhō'sya daśamudrāḥ santi|</para>
  <para style="p">
    <verse number="26" style="v"/>yuṣmānahaṁ vadāmi yasyāśrayē vaddhatē 'dhikaṁ tasmai dāyiṣyatē, kintu yasyāśrayē na varddhatē tasya yadyadasti tadapi tasmān nāyiṣyatē|</para>
  <para style="p">
    <verse number="27" style="v"/>kintu mamādhipatitvasya vaśatvē sthātum asammanyamānā yē mama ripavastānānīya mama samakṣaṁ saṁharata|</para>
  <para style="p">
    <verse number="28" style="v"/>ityupadēśakathāṁ kathayitvā sōgragaḥ san yirūśālamapuraṁ yayau|</para>
  <para style="p">
    <verse number="29" style="v"/>tatō baitphagībaithanīyāgrāmayōḥ samīpē jaitunādrērantikam itvā śiṣyadvayam ityuktvā prēṣayāmāsa,</para>
  <para style="p">
    <verse number="30" style="v"/>yuvāmamuṁ sammukhasthagrāmaṁ praviśyaiva yaṁ kōpi mānuṣaḥ kadāpi nārōhat taṁ garddabhaśāvakaṁ baddhaṁ drakṣyathastaṁ mōcayitvānayataṁ|</para>
  <para style="p">
    <verse number="31" style="v"/>tatra kutō mōcayathaḥ? iti cēt kōpi vakṣyati tarhi vakṣyathaḥ prabhēाratra prayōjanam āstē|</para>
  <para style="p">
    <verse number="32" style="v"/>tadā tau praritau gatvā tatkathāाnusārēṇa sarvvaṁ prāptau|</para>
  <para style="p">
    <verse number="33" style="v"/>gardabhaśāvakamōcanakālē tatvāmina ūcuḥ, gardabhaśāvakaṁ kutō mōcayathaḥ?</para>
  <para style="p">
    <verse number="34" style="v"/>tāvūcatuḥ prabhōratra prayōjanam āstē|</para>
  <para style="p">
    <verse number="35" style="v"/>paścāt tau taṁ gardabhaśāvakaṁ yīśōrantikamānīya tatpr̥ṣṭhē nijavasanāni pātayitvā tadupari yīśumārōhayāmāsatuḥ|</para>
  <para style="p">
    <verse number="36" style="v"/>atha yātrākālē lōkāḥ pathi svavastrāṇi pātayitum ārēbhirē|</para>
  <para style="p">
    <verse number="37" style="v"/>aparaṁ jaitunādrērupatyakām itvā śiṣyasaṁghaḥ pūrvvadr̥ṣṭāni mahākarmmāṇi smr̥tvā,</para>
  <para style="p">
    <verse number="38" style="v"/>yō rājā prabhō rnāmnāyāti sa dhanyaḥ svargē kuśalaṁ sarvvōccē jayadhvani rbhavatu, kathāmētāṁ kathayitvā sānandam ucairīśvaraṁ dhanyaṁ vaktumārēbhē|</para>
  <para style="p">
    <verse number="39" style="v"/>tadā lōkāraṇyamadhyasthāḥ kiyantaḥ phirūśinastat śrutvā yīśuṁ prōcuḥ, hē upadēśaka svaśiṣyān tarjaya|</para>
  <para style="p">
    <verse number="40" style="v"/>sa uvāca, yuṣmānahaṁ vadāmi yadyamī nīravāstiṣṭhanti tarhi pāṣāṇā ucaiḥ kathāḥ kathayiṣyanti|</para>
  <para style="p">
    <verse number="41" style="v"/>paścāt tatpurāntikamētya tadavalōkya sāśrupātaṁ jagāda,</para>
  <para style="p">
    <verse number="42" style="v"/>hā hā cēt tvamagrē'jñāsyathāḥ, tavāsminnēva dinē vā yadi svamaṅgalam upālapsyathāḥ, tarhyuttamam abhaviṣyat, kintu kṣaṇēsmin tattava dr̥ṣṭēragōcaram bhavati|</para>
  <para style="p">
    <verse number="43" style="v"/>tvaṁ svatrāṇakālē na manō nyadhatthā iti hētō ryatkālē tava ripavastvāṁ caturdikṣu prācīrēṇa vēṣṭayitvā rōtsyanti</para>
  <para style="p">
    <verse number="44" style="v"/>bālakaiḥ sārddhaṁ bhūmisāt kariṣyanti ca tvanmadhyē pāṣāṇaikōpi pāṣāṇōpari na sthāsyati ca, kāla īdr̥śa upasthāsyati|</para>
  <para style="p">
    <verse number="45" style="v"/>atha madhyēmandiraṁ praviśya tatratyān krayivikrayiṇō bahiṣkurvvan</para>
  <para style="p">
    <verse number="46" style="v"/>avadat madgr̥haṁ prārthanāgr̥hamiti lipirāstē kintu yūyaṁ tadēva cairāṇāṁ gahvaraṁ kurutha|</para>
  <para style="p">
    <verse number="47" style="v"/>paścāt sa pratyahaṁ madhyēmandiram upadidēśa; tataḥ pradhānayājakā adhyāpakāḥ prācīnāśca taṁ nāśayituṁ cicēṣṭirē;</para>
  <para style="p">
    <verse number="48" style="v"/>kintu tadupadēśē sarvvē lōkā niviṣṭacittāḥ sthitāstasmāt tē tatkarttuṁ nāvakāśaṁ prāpuḥ|</para>
  <chapter number="20" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>athaikadā yīśu rmanidarē susaṁvādaṁ pracārayan lōkānupadiśati, ētarhi pradhānayājakā adhyāpakāḥ prāñcaśca tannikaṭamāgatya papracchuḥ</para>
  <para style="p">
    <verse number="2" style="v"/>kayājñayā tvaṁ karmmāṇyētāni karōṣi? kō vā tvāmājñāpayat? tadasmān vada|</para>
  <para style="p">
    <verse number="3" style="v"/>sa pratyuvāca, tarhi yuṣmānapi kathāmēkāṁ pr̥cchāmi tasyōttaraṁ vadata|</para>
  <para style="p">
    <verse number="4" style="v"/>yōhanō majjanam īśvarasya mānuṣāṇāṁ vājñātō jātaṁ?</para>
  <para style="p">
    <verse number="5" style="v"/>tatastē mithō vivicya jagaduḥ, yadīśvarasya vadāmastarhi taṁ kutō na pratyaita sa iti vakṣyati|</para>
  <para style="p">
    <verse number="6" style="v"/>yadi manuṣyasyēti vadāmastarhi sarvvē lōkā asmān pāṣāṇai rhaniṣyanti yatō yōhan bhaviṣyadvādīti sarvvē dr̥ḍhaṁ jānanti|</para>
  <para style="p">
    <verse number="7" style="v"/>ataēva tē pratyūcuḥ kasyājñayā jātam iti vaktuṁ na śaknumaḥ|</para>
  <para style="p">
    <verse number="8" style="v"/>tadā yīśuravadat tarhi kayājñayā karmmāṇyētāti karōmīti ca yuṣmān na vakṣyāmi|</para>
  <para style="p">
    <verse number="9" style="v"/>atha lōkānāṁ sākṣāt sa imāṁ dr̥ṣṭāntakathāṁ vaktumārēbhē, kaścid drākṣākṣētraṁ kr̥tvā tat kṣētraṁ kr̥ṣīvalānāṁ hastēṣu samarpya bahukālārthaṁ dūradēśaṁ jagāma|</para>
  <para style="p">
    <verse number="10" style="v"/>atha phalakālē phalāni grahītu kr̥ṣīvalānāṁ samīpē dāsaṁ prāhiṇōt kintu kr̥ṣīvalāstaṁ prahr̥tya riktahastaṁ visasarjuḥ|</para>
  <para style="p">
    <verse number="11" style="v"/>tataḥ sōdhipatiḥ punaranyaṁ dāsaṁ prēṣayāmāsa, tē tamapi prahr̥tya kuvyavahr̥tya riktahastaṁ visasr̥juḥ|</para>
  <para style="p">
    <verse number="12" style="v"/>tataḥ sa tr̥tīyavāram anyaṁ prāhiṇōt tē tamapi kṣatāṅgaṁ kr̥tvā bahi rnicikṣipuḥ|</para>
  <para style="p">
    <verse number="13" style="v"/>tadā kṣētrapati rvicārayāmāsa, mamēdānīṁ kiṁ karttavyaṁ? mama priyē putrē prahitē tē tamavaśyaṁ dr̥ṣṭvā samādariṣyantē|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu kr̥ṣīvalāstaṁ nirīkṣya parasparaṁ vivicya prōcuḥ, ayamuttarādhikārī āgacchatainaṁ hanmastatōdhikārōsmākaṁ bhaviṣyati|</para>
  <para style="p">
    <verse number="15" style="v"/>tatastē taṁ kṣētrād bahi rnipātya jaghnustasmāt sa kṣētrapatistān prati kiṁ kariṣyati?</para>
  <para style="p">
    <verse number="16" style="v"/>sa āgatya tān kr̥ṣīvalān hatvā parēṣāṁ hastēṣu tatkṣētraṁ samarpayiṣyati; iti kathāṁ śrutvā tē 'vadan ētādr̥śī ghaṭanā na bhavatu|</para>
  <para style="p">
    <verse number="17" style="v"/>kintu yīśustānavalōkya jagāda, tarhi, sthapatayaḥ kariṣyanti grāvāṇaṁ yantu tucchakaṁ| pradhānaprastaraḥ kōṇē sa ēva hi bhaviṣyati| ētasya śāstrīyavacanasya kiṁ tātparyyaṁ?</para>
  <para style="p">
    <verse number="18" style="v"/>aparaṁ tatpāṣāṇōpari yaḥ patiṣyati sa bhaṁkṣyatē kintu yasyōpari sa pāṣāṇaḥ patiṣyati sa tēna dhūlivac cūrṇībhaviṣyati|</para>
  <para style="p">
    <verse number="19" style="v"/>sōsmākaṁ viruddhaṁ dr̥ṣṭāntamimaṁ kathitavān iti jñātvā pradhānayājakā adhyāpakāśca tadaiva taṁ dhartuṁ vavāñchuḥ kintu lōkēbhyō bibhyuḥ|</para>
  <para style="p">
    <verse number="20" style="v"/>ataēva taṁ prati satarkāḥ santaḥ kathaṁ tadvākyadōṣaṁ dhr̥tvā taṁ dēśādhipasya sādhuvēśadhāriṇaścarān tasya samīpē prēṣayāmāsuḥ|</para>
  <para style="p">
    <verse number="21" style="v"/>tadā tē taṁ papracchuḥ, hē upadēśaka bhavān yathārthaṁ kathayan upadiśati, kamapyanapēkṣya satyatvēnaiśvaraṁ mārgamupadiśati, vayamētajjānīmaḥ|</para>
  <para style="p">
    <verse number="22" style="v"/>kaisararājāya karōsmābhi rdēyō na vā?</para>
  <para style="p">
    <verse number="23" style="v"/>sa tēṣāṁ vañcanaṁ jñātvāvadat kutō māṁ parīkṣadhvē? māṁ mudrāmēkaṁ darśayata|</para>
  <para style="p">
    <verse number="24" style="v"/>iha likhitā mūrtiriyaṁ nāma ca kasya? tē'vadan kaisarasya|</para>
  <para style="p">
    <verse number="25" style="v"/>tadā sa uvāca, tarhi kaisarasya dravyaṁ kaisarāya datta; īśvarasya tu dravyamīśvarāya datta|</para>
  <para style="p">
    <verse number="26" style="v"/>tasmāllōkānāṁ sākṣāt tatkathāyāḥ kamapi dōṣaṁ dhartumaprāpya tē tasyōttarād āścaryyaṁ manyamānā mauninastasthuḥ|</para>
  <para style="p">
    <verse number="27" style="v"/>aparañca śmaśānādutthānānaṅgīkāriṇāṁ sidūkināṁ kiyantō janā āgatya taṁ papracchuḥ,</para>
  <para style="p">
    <verse number="28" style="v"/>hē upadēśaka śāstrē mūsā asmān pratīti lilēkha yasya bhrātā bhāryyāyāṁ satyāṁ niḥsantānō mriyatē sa tajjāyāṁ vivahya tadvaṁśam utpādayiṣyati|</para>
  <para style="p">
    <verse number="29" style="v"/>tathāca kēcit sapta bhrātara āsan tēṣāṁ jyēṣṭhō bhrātā vivahya nirapatyaḥ prāṇān jahau|</para>
  <para style="p">
    <verse number="30" style="v"/>atha dvitīyastasya jāyāṁ vivahya nirapatyaḥ san mamāra| tr̥tīyaśca tāmēva vyuvāha;</para>
  <para style="p">
    <verse number="31" style="v"/>itthaṁ sapta bhrātarastāmēva vivahya nirapatyāḥ santō mamruḥ|</para>
  <para style="p">
    <verse number="32" style="v"/>śēṣē sā strī ca mamāra|</para>
  <para style="p">
    <verse number="33" style="v"/>ataēva śmaśānādutthānakālē tēṣāṁ saptajanānāṁ kasya sā bhāryyā bhaviṣyati? yataḥ sā tēṣāṁ saptānāmēva bhāryyāsīt|</para>
  <para style="p">
    <verse number="34" style="v"/>tadā yīśuḥ pratyuvāca, ētasya jagatō lōkā vivahanti vāgdattāśca bhavanti</para>
  <para style="p">
    <verse number="35" style="v"/>kintu yē tajjagatprāptiyōgyatvēna gaṇitāṁ bhaviṣyanti śmaśānāccōtthāsyanti tē na vivahanti vāgdattāśca na bhavanti,</para>
  <para style="p">
    <verse number="36" style="v"/>tē puna rna mriyantē kintu śmaśānādutthāpitāḥ santa īśvarasya santānāḥ svargīyadūtānāṁ sadr̥śāśca bhavanti|</para>
  <para style="p">
    <verse number="37" style="v"/>adhikantu mūsāḥ stambōpākhyānē paramēśvara ībrāhīma īśvara ishāka īśvarō yākūbaścēśvara ityuktvā mr̥tānāṁ śmaśānād utthānasya pramāṇaṁ lilēkha|</para>
  <para style="p">
    <verse number="38" style="v"/>ataēva ya īśvaraḥ sa mr̥tānāṁ prabhu rna kintu jīvatāmēva prabhuḥ, tannikaṭē sarvvē jīvantaḥ santi|</para>
  <para style="p">
    <verse number="39" style="v"/>iti śrutvā kiyantōdhyāpakā ūcuḥ, hē upadēśaka bhavān bhadraṁ pratyuktavān|</para>
  <para style="p">
    <verse number="40" style="v"/>itaḥ paraṁ taṁ kimapi praṣṭaṁ tēṣāṁ pragalbhatā nābhūt|</para>
  <para style="p">
    <verse number="41" style="v"/>paścāt sa tān uvāca, yaḥ khrīṣṭaḥ sa dāyūdaḥ santāna ētāṁ kathāṁ lōkāḥ kathaṁ kathayanti?</para>
  <para style="p">
    <verse number="42" style="v"/>yataḥ mama prabhumidaṁ vākyamavadat paramēśvaraḥ| tava śatrūnahaṁ yāvat pādapīṭhaṁ karōmi na| tāvat kālaṁ madīyē tvaṁ dakṣapārśva upāviśa|</para>
  <para style="p">
    <verse number="43" style="v"/>iti kathāṁ dāyūd svayaṁ gītagranthē'vadat|</para>
  <para style="p">
    <verse number="44" style="v"/>ataēva yadi dāyūd taṁ prabhuṁ vadati, tarhi sa kathaṁ tasya santānō bhavati?</para>
  <para style="p">
    <verse number="45" style="v"/>paścād yīśuḥ sarvvajanānāṁ karṇagōcarē śiṣyānuvāca,</para>
  <para style="p">
    <verse number="46" style="v"/>yē'dhyāpakā dīrghaparicchadaṁ paridhāya bhramanti, haṭṭāpaṇayō rnamaskārē bhajanagēhasya prōccāsanē bhōjanagr̥hasya pradhānasthānē ca prīyantē</para>
  <para style="p">
    <verse number="47" style="v"/>vidhavānāṁ sarvvasvaṁ grasitvā chalēna dīrghakālaṁ prārthayantē ca tēṣu sāvadhānā bhavata, tēṣāmugradaṇḍō bhaviṣyati|</para>
  <chapter number="21" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>atha dhanilōkā bhāṇḍāgārē dhanaṁ nikṣipanti sa tadēva paśyati,</para>
  <para style="p">
    <verse number="2" style="v"/>ētarhi kāciddīnā vidhavā paṇadvayaṁ nikṣipati tad dadarśa|</para>
  <para style="p">
    <verse number="3" style="v"/>tatō yīśuruvāca yuṣmānahaṁ yathārthaṁ vadāmi, daridrēyaṁ vidhavā sarvvēbhyōdhikaṁ nyakṣēpsīt,</para>
  <para style="p">
    <verse number="4" style="v"/>yatōnyē svaprājyadhanēbhya īśvarāya kiñcit nyakṣēpsuḥ, kintu daridrēyaṁ vidhavā dinayāpanārthaṁ svasya yat kiñcit sthitaṁ tat sarvvaṁ nyakṣēpsīt|</para>
  <para style="p">
    <verse number="5" style="v"/>aparañca uttamaprastarairutsr̥ṣṭavyaiśca mandiraṁ suśōbhatētarāṁ kaiścidityuktē sa pratyuvāca</para>
  <para style="p">
    <verse number="6" style="v"/>yūyaṁ yadidaṁ nicayanaṁ paśyatha, asya pāṣāṇaikōpyanyapāṣāṇōpari na sthāsyati, sarvvē bhūsādbhaviṣyanti kālōyamāyāti|</para>
  <para style="p">
    <verse number="7" style="v"/>tadā tē papracchuḥ, hē gurō ghaṭanēdr̥śī kadā bhaviṣyati? ghaṭanāyā ētasyasaścihnaṁ vā kiṁ bhaviṣyati?</para>
  <para style="p">
    <verse number="8" style="v"/>tadā sa jagāda, sāvadhānā bhavata yathā yuṣmākaṁ bhramaṁ kōpi na janayati, khīṣṭōhamityuktvā mama nāmrā bahava upasthāsyanti sa kālaḥ prāyēṇōpasthitaḥ, tēṣāṁ paścānmā gacchata|</para>
  <para style="p">
    <verse number="9" style="v"/>yuddhasyōpaplavasya ca vārttāṁ śrutvā mā śaṅkadhvaṁ, yataḥ prathamam ētā ghaṭanā avaśyaṁ bhaviṣyanti kintu nāpātē yugāntō bhaviṣyati|</para>
  <para style="p">
    <verse number="10" style="v"/>aparañca kathayāmāsa, tadā dēśasya vipakṣatvēna dēśō rājyasya vipakṣatvēna rājyam utthāsyati,</para>
  <para style="p">
    <verse number="11" style="v"/>nānāsthānēṣu mahābhūkampō durbhikṣaṁ mārī ca bhaviṣyanti, tathā vyōmamaṇḍalasya bhayaṅkaradarśanānyaścaryyalakṣaṇāni ca prakāśayiṣyantē|</para>
  <para style="p">
    <verse number="12" style="v"/>kintu sarvvāsāmētāsāṁ ghaṭanānāṁ pūrvvaṁ lōkā yuṣmān dhr̥tvā tāḍayiṣyanti, bhajanālayē kārāyāñca samarpayiṣyanti mama nāmakāraṇād yuṣmān bhūpānāṁ śāsakānāñca sammukhaṁ nēṣyanti ca|</para>
  <para style="p">
    <verse number="13" style="v"/>sākṣyārtham ētāni yuṣmān prati ghaṭiṣyantē|</para>
  <para style="p">
    <verse number="14" style="v"/>tadā kimuttaraṁ vaktavyam ētat na cintayiṣyāma iti manaḥsu niścitanuta|</para>
  <para style="p">
    <verse number="15" style="v"/>vipakṣā yasmāt kimapyuttaram āpattiñca karttuṁ na śakṣyanti tādr̥śaṁ vākpaṭutvaṁ jñānañca yuṣmabhyaṁ dāsyāmi|</para>
  <para style="p">
    <verse number="16" style="v"/>kiñca yūyaṁ pitrā mātrā bhrātrā bandhunā jñātyā kuṭumbēna ca parakarēṣu samarpayiṣyadhvē; tatastē yuṣmākaṁ kañcana kañcana ghātayiṣyanti|</para>
  <para style="p">
    <verse number="17" style="v"/>mama nāmnaḥ kāraṇāt sarvvai rmanuṣyai ryūyam r̥tīyiṣyadhvē|</para>
  <para style="p">
    <verse number="18" style="v"/>kintu yuṣmākaṁ śiraḥkēśaikōpi na vinaṁkṣyati,</para>
  <para style="p">
    <verse number="19" style="v"/>tasmādēva dhairyyamavalambya svasvaprāṇān rakṣata|</para>
  <para style="p">
    <verse number="20" style="v"/>aparañca yirūśālampuraṁ sainyavēṣṭitaṁ vilōkya tasyōcchinnatāyāḥ samayaḥ samīpa ityavagamiṣyatha|</para>
  <para style="p">
    <verse number="21" style="v"/>tadā yihūdādēśasthā lōkāḥ parvvataṁ palāyantāṁ, yē ca nagarē tiṣṭhanti tē dēśāntaraṁ palāyantā, yē ca grāmē tiṣṭhanti tē nagaraṁ na praviśantu,</para>
  <para style="p">
    <verse number="22" style="v"/>yatastadā samucitadaṇḍanāya dharmmapustakē yāni sarvvāṇi likhitāni tāni saphalāni bhaviṣyanti|</para>
  <para style="p">
    <verse number="23" style="v"/>kintu yā yāstadā garbhavatyaḥ stanyadāvyaśca tāmāṁ durgati rbhaviṣyati, yata ētāllōkān prati kōpō dēśē ca viṣamadurgati rghaṭiṣyatē|</para>
  <para style="p">
    <verse number="24" style="v"/>vastutastu tē khaṅgadhāraparivvaṅgaṁ lapsyantē baddhāḥ santaḥ sarvvadēśēṣu nāyiṣyantē ca kiñcānyadēśīyānāṁ samayōpasthitiparyyantaṁ yirūśālampuraṁ taiḥ padatalai rdalayiṣyatē|</para>
  <para style="p">
    <verse number="25" style="v"/>sūryyacandranakṣatrēṣu lakṣaṇādi bhaviṣyanti, bhuvi sarvvadēśīyānāṁ duḥkhaṁ cintā ca sindhau vīcīnāṁ tarjanaṁ garjanañca bhaviṣyanti|</para>
  <para style="p">
    <verse number="26" style="v"/>bhūbhau bhāvighaṭanāṁ cintayitvā manujā bhiyāmr̥takalpā bhaviṣyanti, yatō vyōmamaṇḍalē tējasvinō dōlāyamānā bhaviṣyanti|</para>
  <para style="p">
    <verse number="27" style="v"/>tadā parākramēṇā mahātējasā ca mēghārūḍhaṁ manuṣyaputram āyāntaṁ drakṣyanti|</para>
  <para style="p">
    <verse number="28" style="v"/>kintvētāsāṁ ghaṭanānāmārambhē sati yūyaṁ mastakānyuttōlya ūrdadhvaṁ drakṣyatha, yatō yuṣmākaṁ muktēḥ kālaḥ savidhō bhaviṣyati|</para>
  <para style="p">
    <verse number="29" style="v"/>tatastēnaitadr̥ṣṭāntakathā kathitā, paśyata uḍumbarādivr̥kṣāṇāṁ</para>
  <para style="p">
    <verse number="30" style="v"/>navīnapatrāṇi jātānīti dr̥ṣṭvā nidāvakāla upasthita iti yathā yūyaṁ jñātuṁ śaknutha,</para>
  <para style="p">
    <verse number="31" style="v"/>tathā sarvvāsāmāsāṁ ghaṭanānām ārambhē dr̥ṣṭē satīśvarasya rājatvaṁ nikaṭam ityapi jñāsyatha|</para>
  <para style="p">
    <verse number="32" style="v"/>yuṣmānahaṁ yathārthaṁ vadāmi, vidyamānalōkānāmēṣāṁ gamanāt pūrvvam ētāni ghaṭiṣyantē|</para>
  <para style="p">
    <verse number="33" style="v"/>nabhōbhuvōrlōpō bhaviṣyati mama vāk tu kadāpi luptā na bhaviṣyati|</para>
  <para style="p">
    <verse number="34" style="v"/>ataēva viṣamāśanēna pānēna ca sāṁmārikacintābhiśca yuṣmākaṁ cittēṣu mattēṣu taddinam akasmād yuṣmān prati yathā nōpatiṣṭhati tadarthaṁ svēṣu sāvadhānāstiṣṭhata|</para>
  <para style="p">
    <verse number="35" style="v"/>pr̥thivīsthasarvvalōkān prati taddinam unmātha iva upasthāsyati|</para>
  <para style="p">
    <verse number="36" style="v"/>yathā yūyam ētadbhāvighaṭanā uttarttuṁ manujasutasya sammukhē saṁsthātuñca yōgyā bhavatha kāraṇādasmāt sāvadhānāḥ santō nirantaraṁ prārthayadhvaṁ|</para>
  <para style="p">
    <verse number="37" style="v"/>aparañca sa divā mandira upadiśya rācai jaitunādriṁ gatvātiṣṭhat|</para>
  <para style="p">
    <verse number="38" style="v"/>tataḥ pratyūṣē lākāstatkathāṁ śrōtuṁ mandirē tadantikam āgacchan|</para>
  <chapter number="22" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>aparañca kiṇvaśūnyapūpōtsavasya kāla upasthitē</para>
  <para style="p">
    <verse number="2" style="v"/>pradhānayājakā adhyāyakāśca yathā taṁ hantuṁ śaknuvanti tathōpāyām acēṣṭanta kintu lōkēbhyō bibhyuḥ|</para>
  <para style="p">
    <verse number="3" style="v"/>ētastin samayē dvādaśaśiṣyēṣu gaṇita īṣkariyōtīyarūḍhimān yō yihūdāstasyāntaḥkaraṇaṁ śaitānāśritatvāt</para>
  <para style="p">
    <verse number="4" style="v"/>sa gatvā yathā yīśuṁ tēṣāṁ karēṣu samarpayituṁ śaknōti tathā mantraṇāṁ pradhānayājakaiḥ sēnāpatibhiśca saha cakāra|</para>
  <para style="p">
    <verse number="5" style="v"/>tēna tē tuṣṭāstasmai mudrāṁ dātuṁ paṇaṁ cakruḥ|</para>
  <para style="p">
    <verse number="6" style="v"/>tataḥ sōṅgīkr̥tya yathā lōkānāmagōcarē taṁ parakarēṣu samarpayituṁ śaknōti tathāvakāśaṁ cēṣṭitumārēbhē|</para>
  <para style="p">
    <verse number="7" style="v"/>atha kiṇvaśūnyapūpōtmavadinē, arthāt yasmin dinē nistārōtsavasya mēṣō hantavyastasmin dinē</para>
  <para style="p">
    <verse number="8" style="v"/>yīśuḥ pitaraṁ yōhanañcāhūya jagāda, yuvāṁ gatvāsmākaṁ bhōjanārthaṁ nistārōtsavasya dravyāṇyāsādayataṁ|</para>
  <para style="p">
    <verse number="9" style="v"/>tadā tau papracchatuḥ kucāsādayāvō bhavataḥ kēcchā?</para>
  <para style="p">
    <verse number="10" style="v"/>tadā sōvādīt, nagarē praviṣṭē kaścijjalakumbhamādāya yuvāṁ sākṣāt kariṣyati sa yannivēśanaṁ praviśati yuvāmapi tannivēśanaṁ tatpaścāditvā nivēśanapatim iti vākyaṁ vadataṁ,</para>
  <para style="p">
    <verse number="11" style="v"/>yatrāhaṁ nistārōtsavasya bhōjyaṁ śiṣyaiḥ sārddhaṁ bhōktuṁ śaknōmi sātithiśālāा kutra? kathāmimāṁ prabhustvāṁ pr̥cchati|</para>
  <para style="p">
    <verse number="12" style="v"/>tataḥ sa janō dvitīyaprakōṣṭhīyam ēkaṁ śastaṁ kōṣṭhaṁ darśayiṣyati tatra bhōjyamāsādayataṁ|</para>
  <para style="p">
    <verse number="13" style="v"/>tatastau gatvā tadvākyānusārēṇa sarvvaṁ dr̥ṣdvā tatra nistārōtsavīyaṁ bhōjyamāsādayāmāsatuḥ|</para>
  <para style="p">
    <verse number="14" style="v"/>atha kāla upasthitē yīśu rdvādaśabhiḥ prēritaiḥ saha bhōktumupaviśya kathitavān</para>
  <para style="p">
    <verse number="15" style="v"/>mama duḥkhabhōgāt pūrvvaṁ yubhābhiḥ saha nistārōtsavasyaitasya bhōjyaṁ bhōktuṁ mayātivāñchā kr̥tā|</para>
  <para style="p">
    <verse number="16" style="v"/>yuṣmān vadāmi, yāvatkālam īśvararājyē bhōjanaṁ na kariṣyē tāvatkālam idaṁ na bhōkṣyē|</para>
  <para style="p">
    <verse number="17" style="v"/>tadā sa pānapātramādāya īśvarasya guṇān kīrttayitvā tēbhyō datvāvadat, idaṁ gr̥hlīta yūyaṁ vibhajya pivata|</para>
  <para style="p">
    <verse number="18" style="v"/>yuṣmān vadāmi yāvatkālam īśvararājatvasya saṁsthāpanaṁ na bhavati tāvad drākṣāphalarasaṁ na pāsyāmi|</para>
  <para style="p">
    <verse number="19" style="v"/>tataḥ pūpaṁ gr̥hītvā īśvaraguṇān kīrttayitvā bhaṅktā tēbhyō datvāvadat, yuṣmadarthaṁ samarpitaṁ yanmama vapustadidaṁ, ētat karmma mama smaraṇārthaṁ kurudhvaṁ|</para>
  <para style="p">
    <verse number="20" style="v"/>atha bhōjanāntē tādr̥śaṁ pātraṁ gr̥hītvāvadat, yuṣmatkr̥tē pātitaṁ yanmama raktaṁ tēna nirṇītanavaniyamarūpaṁ pānapātramidaṁ|</para>
  <para style="p">
    <verse number="21" style="v"/>paśyata yō māṁ parakarēṣu samarpayiṣyati sa mayā saha bhōjanāsana upaviśati|</para>
  <para style="p">
    <verse number="22" style="v"/>yathā nirūpitamāstē tadanusārēṇā manuṣyapuुtrasya gati rbhaviṣyati kintu yastaṁ parakarēṣu samarpayiṣyati tasya santāpō bhaviṣyati|</para>
  <para style="p">
    <verse number="23" style="v"/>tadā tēṣāṁ kō jana ētat karmma kariṣyati tat tē parasparaṁ praṣṭumārēbhirē|</para>
  <para style="p">
    <verse number="24" style="v"/>aparaṁ tēṣāṁ kō janaḥ śrēṣṭhatvēna gaṇayiṣyatē, atrārthē tēṣāṁ vivādōbhavat|</para>
  <para style="p">
    <verse number="25" style="v"/>asmāt kāraṇāt sōvadat, anyadēśīyānāṁ rājānaḥ prajānāmupari prabhutvaṁ kurvvanti dāruṇaśāsanaṁ kr̥tvāpi tē bhūpatitvēna vikhyātā bhavanti ca|</para>
  <para style="p">
    <verse number="26" style="v"/>kintu yuṣmākaṁ tathā na bhaviṣyati, yō yuṣmākaṁ śrēṣṭhō bhaviṣyati sa kaniṣṭhavad bhavatu, yaśca mukhyō bhaviṣyati sa sēvakavadbhavatu|</para>
  <para style="p">
    <verse number="27" style="v"/>bhōjanōpaviṣṭaparicārakayōḥ kaḥ śrēṣṭhaḥ? yō bhōjanāyōpaviśati sa kiṁ śrēṣṭhō na bhavati? kintu yuṣmākaṁ madhyē'haṁ paricāraka̮ivāsmi|</para>
  <para style="p">
    <verse number="28" style="v"/>aparañca yuyaṁ mama parīkṣākālē prathamamārabhya mayā saha sthitā</para>
  <para style="p">
    <verse number="29" style="v"/>ētatkāraṇāt pitrā yathā madarthaṁ rājyamēkaṁ nirūpitaṁ tathāhamapi yuṣmadarthaṁ rājyaṁ nirūpayāmi|</para>
  <para style="p">
    <verse number="30" style="v"/>tasmān mama rājyē bhōjanāsanē ca bhōjanapānē kariṣyadhvē siṁhāsanēṣūpaviśya cēsrāyēlīyānāṁ dvādaśavaṁśānāṁ vicāraṁ kariṣyadhvē|</para>
  <para style="p">
    <verse number="31" style="v"/>aparaṁ prabhuruvāca, hē śimōn paśya tita̮unā dhānyānīva yuṣmān śaitān cālayitum aicchat,</para>
  <para style="p">
    <verse number="32" style="v"/>kintu tava viśvāsasya lōpō yathā na bhavati ētat tvadarthaṁ prārthitaṁ mayā, tvanmanasi parivarttitē ca bhrātr̥ṇāṁ manāṁsi sthirīkuru|</para>
  <para style="p">
    <verse number="33" style="v"/>tadā sōvadat, hē prabhōhaṁ tvayā sārddhaṁ kārāṁ mr̥tiñca yātuṁ majjitōsmi|</para>
  <para style="p">
    <verse number="34" style="v"/>tataḥ sa uvāca, hē pitara tvāṁ vadāmi, adya kukkuṭaravāt pūrvvaṁ tvaṁ matparicayaṁ vāratrayam apahvōṣyasē|</para>
  <para style="p">
    <verse number="35" style="v"/>aparaṁ sa papraccha, yadā mudrāsampuṭaṁ khādyapātraṁ pādukāñca vinā yuṣmān prāhiṇavaṁ tadā yuṣmākaṁ kasyāpi nyūnatāsīt? tē prōcuḥ kasyāpi na|</para>
  <para style="p">
    <verse number="36" style="v"/>tadā sōvadat kintvidānīṁ mudrāsampuṭaṁ khādyapātraṁ vā yasyāsti tēna tadgrahītavyaṁ, yasya ca kr̥pāṇōे nāsti tēna svavastraṁ vikrīya sa krētavyaḥ|</para>
  <para style="p">
    <verse number="37" style="v"/>yatō yuṣmānahaṁ vadāmi, aparādhijanaiḥ sārddhaṁ gaṇitaḥ sa bhaviṣyati| idaṁ yacchāstrīyaṁ vacanaṁ likhitamasti tanmayi phaliṣyati yatō mama sambandhīyaṁ sarvvaṁ sētsyati|</para>
  <para style="p">
    <verse number="38" style="v"/>tadā tē prōcuḥ prabhō paśya imau kr̥pāṇau| tataḥ sōvadad ētau yathēṣṭau|</para>
  <para style="p">
    <verse number="39" style="v"/>atha sa tasmādvahi rgatvā svācārānusārēṇa jaitunanāmādriṁ jagāma śiṣyāśca tatpaścād yayuḥ|</para>
  <para style="p">
    <verse number="40" style="v"/>tatrōpasthāya sa tānuvāca, yathā parīkṣāyāṁ na patatha tadarthaṁ prārthayadhvaṁ|</para>
  <para style="p">
    <verse number="41" style="v"/>paścāt sa tasmād ēkaśarakṣēpād bahi rgatvā jānunī pātayitvā ētat prārthayāñcakrē,</para>
  <para style="p">
    <verse number="42" style="v"/>hē pita ryadi bhavān sammanyatē tarhi kaṁsamēnaṁ mamāntikād dūraya kintu madicchānurūpaṁ na tvadicchānurūpaṁ bhavatu|</para>
  <para style="p">
    <verse number="43" style="v"/>tadā tasmai śaktiṁ dātuṁ svargīyadūtō darśanaṁ dadau|</para>
  <para style="p">
    <verse number="44" style="v"/>paścāt sōtyantaṁ yātanayā vyākulō bhūtvā punardr̥ḍhaṁ prārthayāñcakrē, tasmād br̥hacchōṇitabindava iva tasya svēdabindavaḥ pr̥thivyāṁ patitumārēbhirē|</para>
  <para style="p">
    <verse number="45" style="v"/>atha prārthanāta utthāya śiṣyāṇāṁ samīpamētya tān manōduḥkhinō nidritān dr̥ṣṭvāvadat</para>
  <para style="p">
    <verse number="46" style="v"/>kutō nidrātha? parīkṣāyām apatanārthaṁ prarthayadhvaṁ|</para>
  <para style="p">
    <verse number="47" style="v"/>ētatkathāyāḥ kathanakālē dvādaśaśiṣyāṇāṁ madhyē gaṇitō yihūdānāmā janatāsahitastēṣām agrē calitvā yīśōścumbanārthaṁ tadantikam āyayau|</para>
  <para style="p">
    <verse number="48" style="v"/>tadā yīśuruvāca, hē yihūdā kiṁ cumbanēna manuṣyaputraṁ parakarēṣu samarpayasi?</para>
  <para style="p">
    <verse number="49" style="v"/>tadā yadyad ghaṭiṣyatē tadanumāya saṅgibhiruktaṁ, hē prabhō vayaṁ ki khaṅgēna ghātayiṣyāmaḥ?</para>
  <para style="p">
    <verse number="50" style="v"/>tata ēkaḥ karavālēnāhatya pradhānayājakasya dāsasya dakṣiṇaṁ karṇaṁ cicchēda|</para>
  <para style="p">
    <verse number="51" style="v"/>adhūnā nivarttasva ityuktvā yīśustasya śrutiṁ spr̥ṣṭvā svasyaṁ cakāra|</para>
  <para style="p">
    <verse number="52" style="v"/>paścād yīśuḥ samīpasthān pradhānayājakān mandirasya sēnāpatīn prācīnāṁśca jagāda, yūyaṁ kr̥pāṇān yaṣṭīṁśca gr̥hītvā māṁ kiṁ cōraṁ dharttumāyātāḥ?</para>
  <para style="p">
    <verse number="53" style="v"/>yadāhaṁ yuṣmābhiḥ saha pratidinaṁ mandirē'tiṣṭhaṁ tadā māṁ dharttaṁ na pravr̥ttāḥ, kintvidānīṁ yuṣmākaṁ samayōndhakārasya cādhipatyamasti|</para>
  <para style="p">
    <verse number="54" style="v"/>atha tē taṁ dhr̥tvā mahāyājakasya nivēśanaṁ ninyuḥ| tataḥ pitarō dūrē dūrē paścāditvā</para>
  <para style="p">
    <verse number="55" style="v"/>br̥hatkōṣṭhasya madhyē yatrāgniṁ jvālayitvā lōkāḥ samētyōpaviṣṭāstatra taiḥ sārddham upavivēśa|</para>
  <para style="p">
    <verse number="56" style="v"/>atha vahnisannidhau samupavēśakālē kāciddāsī manō niviśya taṁ nirīkṣyāvadat pumānayaṁ tasya saṅgē'sthāt|</para>
  <para style="p">
    <verse number="57" style="v"/>kintu sa tad apahnutyāvādīt hē nāri tamahaṁ na paricinōmi|</para>
  <para style="p">
    <verse number="58" style="v"/>kṣaṇāntarē'nyajanastaṁ dr̥ṣṭvābravīt tvamapi tēṣāṁ nikarasyaikajanōsi| pitaraḥ pratyuvāca hē nara nāhamasmi|</para>
  <para style="p">
    <verse number="59" style="v"/>tataḥ sārddhadaṇḍadvayāt paraṁ punaranyō janō niścitya babhāṣē, ēṣa tasya saṅgīti satyaṁ yatōyaṁ gālīlīyō lōkaḥ|</para>
  <para style="p">
    <verse number="60" style="v"/>tadā pitara uvāca hē nara tvaṁ yad vadami tadahaṁ bōddhuṁ na śaknōmi, iti vākyē kathitamātrē kukkuṭō rurāva|</para>
  <para style="p">
    <verse number="61" style="v"/>tadā prabhuṇā vyādhuṭya pitarē nirīkṣitē kr̥kavākuravāt pūrvvaṁ māṁ trirapahnōṣyasē iti pūrvvōktaṁ tasya vākyaṁ pitaraḥ smr̥tvā</para>
  <para style="p">
    <verse number="62" style="v"/>bahirgatvā mahākhēdēna cakranda|</para>
  <para style="p">
    <verse number="63" style="v"/>tadā yai ryīśurdhr̥tastē tamupahasya praharttumārēbhirē|</para>
  <para style="p">
    <verse number="64" style="v"/>vastrēṇa tasya dr̥śau baddhvā kapōlē capēṭāghātaṁ kr̥tvā papracchuḥ, kastē kapōlē capēṭāghātaṁ kr̥tavāna? gaṇayitvā tad vada|</para>
  <para style="p">
    <verse number="65" style="v"/>tadanyat tadviruddhaṁ bahunindāvākyaṁ vaktumārēbhirē|</para>
  <para style="p">
    <verse number="66" style="v"/>atha prabhātē sati lōkaprāñcaḥ pradhānayājakā adhyāpakāśca sabhāṁ kr̥tvā madhyēsabhaṁ yīśumānīya papracchuḥ, tvam abhiṣikatōsi na vāsmān vada|</para>
  <para style="p">
    <verse number="67" style="v"/>sa pratyuvāca, mayā tasminnuktē'pi yūyaṁ na viśvasiṣyatha|</para>
  <para style="p">
    <verse number="68" style="v"/>kasmiṁścidvākyē yuṣmān pr̥ṣṭē'pi māṁ na taduttaraṁ vakṣyatha na māṁ tyakṣyatha ca|</para>
  <para style="p">
    <verse number="69" style="v"/>kintvitaḥ paraṁ manujasutaḥ sarvvaśaktimata īśvarasya dakṣiṇē pārśvē samupavēkṣyati|</para>
  <para style="p">
    <verse number="70" style="v"/>tatastē papracchuḥ, rtiha tvamīśvarasya putraḥ? sa kathayāmāsa, yūyaṁ yathārthaṁ vadatha sa ēvāhaṁ|</para>
  <para style="p">
    <verse number="71" style="v"/>tadā tē sarvvē kathayāmāsuḥ, rtiha sākṣyē'nsasmin asmākaṁ kiṁ prayōjanaṁ? asya svamukhādēva sākṣyaṁ prāptam|</para>
  <chapter number="23" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>tataḥ sabhāsthāḥ sarvvalōkā utthāya taṁ pīlātasammukhaṁ nītvāprōdya vaktumārēbhirē,</para>
  <para style="p">
    <verse number="2" style="v"/>svamabhiṣiktaṁ rājānaṁ vadantaṁ kaimararājāya karadānaṁ niṣēdhantaṁ rājyaviparyyayaṁ kurttuṁ pravarttamānam ēna prāptā vayaṁ|</para>
  <para style="p">
    <verse number="3" style="v"/>tadā pīlātastaṁ pr̥ṣṭavān tvaṁ kiṁ yihūdīyānāṁ rājā? sa pratyuvāca tvaṁ satyamuktavān|</para>
  <para style="p">
    <verse number="4" style="v"/>tadā pīlātaḥ pradhānayājakādilōkān jagād, ahamētasya kamapyaparādhaṁ nāptavān|</para>
  <para style="p">
    <verse number="5" style="v"/>tatastē punaḥ sāhaminō bhūtvāvadan, ēṣa gālīla ētatsthānaparyyantē sarvvasmin yihūdādēśē sarvvāllōkānupadiśya kupravr̥ttiṁ grāhītavān|</para>
  <para style="p">
    <verse number="6" style="v"/>tadā pīlātō gālīlapradēśasya nāma śrutvā papraccha, kimayaṁ gālīlīyō lōkaḥ?</para>
  <para style="p">
    <verse number="7" style="v"/>tataḥ sa gālīlpradēśīyahērōdrājasya tadā sthitēstasya samīpē yīśuṁ prēṣayāmāsa|</para>
  <para style="p">
    <verse number="8" style="v"/>tadā hērōd yīśuṁ vilōkya santutōṣa, yataḥ sa tasya bahuvr̥ttāntaśravaṇāt tasya kiñi्cadāścaryyakarmma paśyati ityāśāṁ kr̥tvā bahukālamārabhya taṁ draṣṭuṁ prayāsaṁ kr̥tavān|</para>
  <para style="p">
    <verse number="9" style="v"/>tasmāt taṁ bahukathāḥ papraccha kintu sa tasya kasyāpi vākyasya pratyuttaraṁ nōvāca|</para>
  <para style="p">
    <verse number="10" style="v"/>atha pradhānayājakā adhyāpakāśca prōttiṣṭhantaḥ sāhasēna tamapavadituṁ prārēbhirē|</para>
  <para style="p">
    <verse number="11" style="v"/>hērōd tasya sēnāgaṇaśca tamavajñāya upahāsatvēna rājavastraṁ paridhāpya punaḥ pīlātaṁ prati taṁ prāhiṇōt|</para>
  <para style="p">
    <verse number="12" style="v"/>pūrvvaṁ hērōdpīlātayōḥ parasparaṁ vairabhāva āsīt kintu taddinē dvayō rmēlanaṁ jātam|</para>
  <para style="p">
    <verse number="13" style="v"/>paścāt pīlātaḥ pradhānayājakān śāsakān lōkāṁśca yugapadāhūya babhāṣē,</para>
  <para style="p">
    <verse number="14" style="v"/>rājyaviparyyayakārakōyam ityuktvā manuṣyamēnaṁ mama nikaṭamānaiṣṭa kintu paśyata yuṣmākaṁ samakṣam asya vicāraṁ kr̥tvāpi prōktāpavādānurūpēṇāsya kōpyaparādhaḥ sapramāṇō na jātaḥ,</para>
  <para style="p">
    <verse number="15" style="v"/>yūyañca hērōdaḥ sannidhau prēṣitā mayā tatrāsya kōpyaparādhastēnāpi na prāptaḥ|paśyatānēna vadhahēेtukaṁ kimapi nāparāddhaṁ|</para>
  <para style="p">
    <verse number="16" style="v"/>tasmādēnaṁ tāḍayitvā vihāsyāmi|</para>
  <para style="p">
    <verse number="17" style="v"/>tatrōtsavē tēṣāmēkō mōcayitavyaḥ|</para>
  <para style="p">
    <verse number="18" style="v"/>iti hētōstē prōccairēkadā prōcuḥ, ēnaṁ dūrīkr̥tya barabbānāmānaṁ mōcaya|</para>
  <para style="p">
    <verse number="19" style="v"/>sa barabbā nagara upaplavavadhāparādhābhyāṁ kārāyāṁ baddha āsīt|</para>
  <para style="p">
    <verse number="20" style="v"/>kintu pīlātō yīśuṁ mōcayituṁ vāñchan punastānuvāca|</para>
  <para style="p">
    <verse number="21" style="v"/>tathāpyēnaṁ kruśē vyadha kruśē vyadhēti vadantastē ruruvuḥ|</para>
  <para style="p">
    <verse number="22" style="v"/>tataḥ sa tr̥tīyavāraṁ jagāda kutaḥ? sa kiṁ karmma kr̥tavān? nāhamasya kamapi vadhāparādhaṁ prāptaḥ kēvalaṁ tāḍayitvāmuṁ tyajāmi|</para>
  <para style="p">
    <verse number="23" style="v"/>tathāpi tē punarēnaṁ kruśē vyadha ityuktvā prōccairdr̥ḍhaṁ prārthayāñcakrirē;</para>
  <para style="p">
    <verse number="24" style="v"/>tataḥ pradhānayājakādīnāṁ kalaravē prabalē sati tēṣāṁ prārthanārūpaṁ karttuṁ pīlāta ādidēśa|</para>
  <para style="p">
    <verse number="25" style="v"/>rājadrōhavadhayōraparādhēna kārāsthaṁ yaṁ janaṁ tē yayācirē taṁ mōcayitvā yīśuṁ tēṣāmicchāyāṁ samārpayat|</para>
  <para style="p">
    <verse number="26" style="v"/>atha tē yīśuṁ gr̥hītvā yānti, ētarhi grāmādāgataṁ śimōnanāmānaṁ kurīṇīyaṁ janaṁ dhr̥tvā yīśōḥ paścānnētuṁ tasya skandhē kruśamarpayāmāsuḥ|</para>
  <para style="p">
    <verse number="27" style="v"/>tatō lōाkāraṇyamadhyē bahustriyō rudatyō vilapantyaśca yīśōḥ paścād yayuḥ|</para>
  <para style="p">
    <verse number="28" style="v"/>kintu sa vyāghuṭya tā uvāca, hē yirūśālamō nāryyō yuyaṁ madarthaṁ na ruditvā svārthaṁ svāpatyārthañca ruditi;</para>
  <para style="p">
    <verse number="29" style="v"/>paśyata yaḥ kadāpi garbhavatyō nābhavan stanyañca nāpāyayan tādr̥śī rvandhyā yadā dhanyā vakṣyanti sa kāla āyāti|</para>
  <para style="p">
    <verse number="30" style="v"/>tadā hē śailā asmākamupari patata, hē upaśailā asmānācchādayata kathāmīdr̥śīṁ lōkā vakṣyanti|</para>
  <para style="p">
    <verse number="31" style="v"/>yataḥ satējasi śākhini cēdētad ghaṭatē tarhi śuṣkaśākhini kiṁ na ghaṭiṣyatē?</para>
  <para style="p">
    <verse number="32" style="v"/>tadā tē hantuṁ dvāvaparādhinau tēna sārddhaṁ ninyuḥ|</para>
  <para style="p">
    <verse number="33" style="v"/>aparaṁ śiraḥkapālanāmakasthānaṁ prāpya taṁ kruśē vividhuḥ; taddvayōraparādhinōrēkaṁ tasya dakṣiṇō tadanyaṁ vāmē kruśē vividhuḥ|</para>
  <para style="p">
    <verse number="34" style="v"/>tadā yīśurakathayat, hē pitarētān kṣamasva yata ētē yat karmma kurvvanti tan na viduḥ; paścāttē guṭikāpātaṁ kr̥tvā tasya vastrāṇi vibhajya jagr̥huḥ|</para>
  <para style="p">
    <verse number="35" style="v"/>tatra lōkasaṁghastiṣṭhan dadarśa; tē tēṣāṁ śāsakāśca tamupahasya jagaduḥ, ēṣa itarān rakṣitavān yadīśvarēṇābhirucitō 'bhiṣiktastrātā bhavati tarhi svamadhunā rakṣatu|</para>
  <para style="p">
    <verse number="36" style="v"/>tadanyaḥ sēnāgaṇā ētya tasmai amlarasaṁ datvā parihasya prōvāca,</para>
  <para style="p">
    <verse number="37" style="v"/>cēttvaṁ yihūdīyānāṁ rājāsi tarhi svaṁ rakṣa|</para>
  <para style="p">
    <verse number="38" style="v"/>yihūdīyānāṁ rājēti vākyaṁ yūnānīyarōmīyēbrīyākṣarai rlikhitaṁ tacchirasa ūrddhvē'sthāpyata|</para>
  <para style="p">
    <verse number="39" style="v"/>tadōbhayapārśvayō rviddhau yāvaparādhinau tayōrēkastaṁ vinindya babhāṣē, cēttvam abhiṣiktōsi tarhi svamāvāñca rakṣa|</para>
  <para style="p">
    <verse number="40" style="v"/>kintvanyastaṁ tarjayitvāvadat, īśvarāttava kiñcidapi bhayaṁ nāsti kiṁ? tvamapi samānadaṇḍōsi,</para>
  <para style="p">
    <verse number="41" style="v"/>yōgyapātrē āvāṁ svasvakarmmaṇāṁ samucitaphalaṁ prāpnuvaḥ kintvanēna kimapi nāparāddhaṁ|</para>
  <para style="p">
    <verse number="42" style="v"/>atha sa yīśuṁ jagāda hē prabhē bhavān svarājyapravēśakālē māṁ smaratu|</para>
  <para style="p">
    <verse number="43" style="v"/>tadā yīśuḥ kathitavān tvāṁ yathārthaṁ vadāmi tvamadyaiva mayā sārddhaṁ paralōkasya sukhasthānaṁ prāpsyasi|</para>
  <para style="p">
    <verse number="44" style="v"/>aparañca dvitīyayāmāt tr̥tīyayāmaparyyantaṁ ravēstējasōntarhitatvāt sarvvadēśō'ndhakārēṇāvr̥tō</para>
  <para style="p">
    <verse number="45" style="v"/>mandirasya yavanikā ca chidyamānā dvidhā babhūva|</para>
  <para style="p">
    <verse number="46" style="v"/>tatō yīśuruccairuvāca, hē pita rmamātmānaṁ tava karē samarpayē, ityuktvā sa prāṇān jahau|</para>
  <para style="p">
    <verse number="47" style="v"/>tadaitā ghaṭanā dr̥ṣṭvā śatasēnāpatirīśvaraṁ dhanyamuktvā kathitavān ayaṁ nitāntaṁ sādhumanuṣya āsīt|</para>
  <para style="p">
    <verse number="48" style="v"/>atha yāvantō lōkā draṣṭum āgatāstē tā ghaṭanā dr̥ṣṭvā vakṣaḥsu karāghātaṁ kr̥tvā vyācuṭya gatāḥ|</para>
  <para style="p">
    <verse number="49" style="v"/>yīśō rjñātayō yā yā yōṣitaśca gālīlastēna sārddhamāyātāstā api dūrē sthitvā tat sarvvaṁ dadr̥śuḥ|</para>
  <para style="p">
    <verse number="50" style="v"/>tadā yihūdīyānāṁ mantraṇāṁ kriyāñcāsammanyamāna īśvarasya rājatvam apēkṣamāṇō</para>
  <para style="p">
    <verse number="51" style="v"/>yihūdidēśīyō 'rimathīyanagarīyō yūṣaphnāmā mantrī bhadrō dhārmmikaśca pumān</para>
  <para style="p">
    <verse number="52" style="v"/>pīlātāntikaṁ gatvā yīśō rdēhaṁ yayācē|</para>
  <para style="p">
    <verse number="53" style="v"/>paścād vapuravarōhya vāsasā saṁvēṣṭya yatra kōpi mānuṣō nāsthāpyata tasmin śailē svātē śmaśānē tadasthāpayat|</para>
  <para style="p">
    <verse number="54" style="v"/>taddinamāyōjanīyaṁ dinaṁ viśrāmavāraśca samīpaḥ|</para>
  <para style="p">
    <verse number="55" style="v"/>aparaṁ yīśunā sārddhaṁ gālīla āgatā yōṣitaḥ paścāditvā śmaśānē tatra yathā vapuḥ sthāpitaṁ tacca dr̥ṣṭvā</para>
  <para style="p">
    <verse number="56" style="v"/>vyāghuṭya sugandhidravyatailāni kr̥tvā vidhivad viśrāmavārē viśrāmaṁ cakruḥ|</para>
  <chapter number="24" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>atha saptāhaprathamadinē'tipratyūṣē tā yōṣitaḥ sampāditaṁ sugandhidravyaṁ gr̥hītvā tadanyābhiḥ kiyatībhiḥ strībhiḥ saha śmaśānaṁ yayuḥ|</para>
  <para style="p">
    <verse number="2" style="v"/>kintu śmaśānadvārāt pāṣāṇamapasāritaṁ dr̥ṣṭvā</para>
  <para style="p">
    <verse number="3" style="v"/>tāḥ praviśya prabhō rdēhamaprāpya</para>
  <para style="p">
    <verse number="4" style="v"/>vyākulā bhavanti ētarhi tējōmayavastrānvitau dvau puruṣau tāsāṁ samīpē samupasthitau</para>
  <para style="p">
    <verse number="5" style="v"/>tasmāttāḥ śaṅkāyuktā bhūmāvadhōmukhyasyasthuḥ| tadā tau tā ūcatu rmr̥tānāṁ madhyē jīvantaṁ kutō mr̥gayatha?</para>
  <para style="p">
    <verse number="6" style="v"/>sōtra nāsti sa udasthāt|</para>
  <para style="p">
    <verse number="7" style="v"/>pāpināṁ karēṣu samarpitēna kruśē hatēna ca manuṣyaputrēṇa tr̥tīyadivasē śmaśānādutthātavyam iti kathāṁ sa galīli tiṣṭhan yuṣmabhyaṁ kathitavān tāṁ smarata|</para>
  <para style="p">
    <verse number="8" style="v"/>tadā tasya sā kathā tāsāṁ manaḥsu jātā|</para>
  <para style="p">
    <verse number="9" style="v"/>anantaraṁ śmaśānād gatvā tā ēkādaśaśiṣyādibhyaḥ sarvvēbhyastāṁ vārttāṁ kathayāmāsuḥ|</para>
  <para style="p">
    <verse number="10" style="v"/>magdalīnīmariyam, yōhanā, yākūbō mātā mariyam tadanyāḥ saṅginyō yōṣitaśca prēritēbhya ētāḥ sarvvā vārttāḥ kathayāmāsuḥ</para>
  <para style="p">
    <verse number="11" style="v"/>kintu tāsāṁ kathām anarthakākhyānamātraṁ buddhvā kōpi na pratyait|</para>
  <para style="p">
    <verse number="12" style="v"/>tadā pitara utthāya śmaśānāntikaṁ dadhāva, tatra ca prahvō bhūtvā pārśvaikasthāpitaṁ kēvalaṁ vastraṁ dadarśa; tasmādāścaryyaṁ manyamānō yadaghaṭata tanmanasi vicārayan pratasthē|</para>
  <para style="p">
    <verse number="13" style="v"/>tasminnēva dinē dvau śiyyau yirūśālamaścatuṣkrōśāntaritam immāyugrāmaṁ gacchantau</para>
  <para style="p">
    <verse number="14" style="v"/>tāsāṁ ghaṭanānāṁ kathāmakathayatāṁ</para>
  <para style="p">
    <verse number="15" style="v"/>tayōrālāpavicārayōḥ kālē yīśurāgatya tābhyāṁ saha jagāma</para>
  <para style="p">
    <verse number="16" style="v"/>kintu yathā tau taṁ na paricinutastadarthaṁ tayō rdr̥ṣṭiḥ saṁruddhā|</para>
  <para style="p">
    <verse number="17" style="v"/>sa tau pr̥ṣṭavān yuvāṁ viṣaṇṇau kiṁ vicārayantau gacchathaḥ?</para>
  <para style="p">
    <verse number="18" style="v"/>tatastayōḥ kliyapānāmā pratyuvāca yirūśālamapurē'dhunā yānyaghaṭanta tvaṁ kēvalavidēśī kiṁ tadvr̥ttāntaṁ na jānāsi?</para>
  <para style="p">
    <verse number="19" style="v"/>sa papraccha kā ghaṭanāḥ? tadā tau vaktumārēbhātē yīśunāmā yō nāsaratīyō bhaviṣyadvādī īśvarasya mānuṣāṇāñca sākṣāt vākyē karmmaṇi ca śaktimānāsīt</para>
  <para style="p">
    <verse number="20" style="v"/>tam asmākaṁ pradhānayājakā vicārakāśca kēnāpi prakārēṇa kruśē viddhvā tasya prāṇānanāśayan tadīyā ghaṭanāḥ;</para>
  <para style="p">
    <verse number="21" style="v"/>kintu ya isrāyēlīyalōkān uddhārayiṣyati sa ēvāyam ityāśāsmābhiḥ kr̥tā|tadyathā tathāstu tasyā ghaṭanāyā adya dinatrayaṁ gataṁ|</para>
  <para style="p">
    <verse number="22" style="v"/>adhikantvasmākaṁ saṅginīnāṁ kiyatstrīṇāṁ mukhēbhyō'sambhavavākyamidaṁ śrutaṁ;</para>
  <para style="p">
    <verse number="23" style="v"/>tāḥ pratyūṣē śmaśānaṁ gatvā tatra tasya dēham aprāpya vyāghuṭyētvā prōktavatyaḥ svargīsadūtau dr̥ṣṭāvasmābhistau cāvādiṣṭāṁ sa jīvitavān|</para>
  <para style="p">
    <verse number="24" style="v"/>tatōsmākaṁ kaiścit śmaśānamagamyata tē'pi strīṇāṁ vākyānurūpaṁ dr̥ṣṭavantaḥ kintu taṁ nāpaśyan|</para>
  <para style="p">
    <verse number="25" style="v"/>tadā sa tāvuvāca, hē abōdhau hē bhaviṣyadvādibhiruktavākyaṁ pratyētuṁ vilambamānau;</para>
  <para style="p">
    <verse number="26" style="v"/>ētatsarvvaduḥkhaṁ bhuktvā svabhūtiprāptiḥ kiṁ khrīṣṭasya na nyāyyā?</para>
  <para style="p">
    <verse number="27" style="v"/>tataḥ sa mūsāgranthamārabhya sarvvabhaviṣyadvādināṁ sarvvaśāstrē svasmin likhitākhyānābhiprāyaṁ bōdhayāmāsa|</para>
  <para style="p">
    <verse number="28" style="v"/>atha gamyagrāmābhyarṇaṁ prāpya tēnāgrē gamanalakṣaṇē darśitē</para>
  <para style="p">
    <verse number="29" style="v"/>tau sādhayitvāvadatāṁ sahāvābhyāṁ tiṣṭha dinē gatē sati rātrirabhūt; tataḥ sa tābhyāṁ sārddhaṁ sthātuṁ gr̥haṁ yayau|</para>
  <para style="p">
    <verse number="30" style="v"/>paścādbhōjanōpavēśakālē sa pūpaṁ gr̥hītvā īśvaraguṇān jagāda tañca bhaṁktvā tābhyāṁ dadau|</para>
  <para style="p">
    <verse number="31" style="v"/>tadā tayō rdr̥ṣṭau prasannāyāṁ taṁ pratyabhijñatuḥ kintu sa tayōḥ sākṣādantardadhē|</para>
  <para style="p">
    <verse number="32" style="v"/>tatastau mithōbhidhātum ārabdhavantau gamanakālē yadā kathāmakathayat śāstrārthañcabōdhayat tadāvayō rbuddhiḥ kiṁ na prājvalat?</para>
  <para style="p">
    <verse number="33" style="v"/>tau tatkṣaṇādutthāya yirūśālamapuraṁ pratyāyayatuḥ, tatsthānē śiṣyāṇām ēkādaśānāṁ saṅgināñca darśanaṁ jātaṁ|</para>
  <para style="p">
    <verse number="34" style="v"/>tē prōcuḥ prabhurudatiṣṭhad iti satyaṁ śimōnē darśanamadācca|</para>
  <para style="p">
    <verse number="35" style="v"/>tataḥ pathaḥ sarvvaghaṭanāyāḥ pūpabhañjanēna tatparicayasya ca sarvvavr̥ttāntaṁ tau vaktumārēbhātē|</para>
  <para style="p">
    <verse number="36" style="v"/>itthaṁ tē parasparaṁ vadanti tatkālē yīśuḥ svayaṁ tēṣāṁ madhya prōtthaya yuṣmākaṁ kalyāṇaṁ bhūyād ityuvāca,</para>
  <para style="p">
    <verse number="37" style="v"/>kintu bhūtaṁ paśyāma ityanumāya tē samudvivijirē trēṣuśca|</para>
  <para style="p">
    <verse number="38" style="v"/>sa uvāca, kutō duḥkhitā bhavatha? yuṣmākaṁ manaḥsu sandēha udēti ca kutaḥ?</para>
  <para style="p">
    <verse number="39" style="v"/>ēṣōhaṁ, mama karau paśyata varaṁ spr̥ṣṭvā paśyata, mama yādr̥śāni paśyatha tādr̥śāni bhūtasya māṁsāsthīni na santi|</para>
  <para style="p">
    <verse number="40" style="v"/>ityuktvā sa hastapādān darśayāmāsa|</para>
  <para style="p">
    <verse number="41" style="v"/>tē'sambhavaṁ jñātvā sānandā na pratyayan| tataḥ sa tān papraccha, atra yuṣmākaṁ samīpē khādyaṁ kiñcidasti?</para>
  <para style="p">
    <verse number="42" style="v"/>tatastē kiyaddagdhamatsyaṁ madhu ca daduḥ</para>
  <para style="p">
    <verse number="43" style="v"/>sa tadādāya tēṣāṁ sākṣād bubhujē</para>
  <para style="p">
    <verse number="44" style="v"/>kathayāmāsa ca mūsāvyavasthāyāṁ bhaviṣyadvādināṁ granthēṣu gītapustakē ca mayi yāni sarvvāṇi vacanāni likhitāni tadanurūpāṇi ghaṭiṣyantē yuṣmābhiḥ sārddhaṁ sthitvāhaṁ yadētadvākyam avadaṁ tadidānīṁ pratyakṣamabhūt|</para>
  <para style="p">
    <verse number="45" style="v"/>atha tēbhyaḥ śāstrabōdhādhikāraṁ datvāvadat,</para>
  <para style="p">
    <verse number="46" style="v"/>khrīṣṭēnētthaṁ mr̥tiyātanā bhōktavyā tr̥tīyadinē ca śmaśānādutthātavyañcēti lipirasti;</para>
  <para style="p">
    <verse number="47" style="v"/>tannāmnā yirūśālamamārabhya sarvvadēśē manaḥparāvarttanasya pāpamōcanasya ca susaṁvādaḥ pracārayitavyaḥ,</para>
  <para style="p">
    <verse number="48" style="v"/>ēṣu sarvvēṣu yūyaṁ sākṣiṇaḥ|</para>
  <para style="p">
    <verse number="49" style="v"/>aparañca paśyata pitrā yat pratijñātaṁ tat prēṣayiṣyāmi, ataēva yāvatkālaṁ yūyaṁ svargīyāṁ śaktiṁ na prāpsyatha tāvatkālaṁ yirūśālamnagarē tiṣṭhata|</para>
  <para style="p">
    <verse number="50" style="v"/>atha sa tān baithanīyāparyyantaṁ nītvā hastāvuttōlya āśiṣa vaktumārēbhē</para>
  <para style="p">
    <verse number="51" style="v"/>āśiṣaṁ vadannēva ca tēbhyaḥ pr̥thag bhūtvā svargāya nītō'bhavat|</para>
  <para style="p">
    <verse number="52" style="v"/>tadā tē taṁ bhajamānā mahānandēna yirūśālamaṁ pratyājagmuḥ|</para>
  <para style="p">
    <verse number="53" style="v"/>tatō nirantaraṁ mandirē tiṣṭhanta īśvarasya praśaṁsāṁ dhanyavādañca karttam ārēbhirē| iti||</para>
</usx>
