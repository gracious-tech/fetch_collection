  <para style="h">3 John</para>
  <para style="toc1">3 yōhanaḥ patraṁ</para>
  <para style="toc2">3 yōhanaḥ</para>
  <para style="toc3">3 yōhanaḥ</para>
  <para style="mt1">3 yōhanaḥ patraṁ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>prācīnō 'haṁ satyamatād yasmin prīyē taṁ priyatamaṁ gāyaṁ prati patraṁ likhāmi|</para>
  <para style="p">
    <verse number="2" style="v"/>hē priya, tavātmā yādr̥k śubhānvitastādr̥k sarvvaviṣayē tava śubhaṁ svāsthyañca bhūyāt|</para>
  <para style="p">
    <verse number="3" style="v"/>bhrātr̥bhirāgatya tava satyamatasyārthatastvaṁ kīdr̥k satyamatamācarasyētasya sākṣyē dattē mama mahānandō jātaḥ|</para>
  <para style="p">
    <verse number="4" style="v"/>mama santānāḥ satyamatamācarantītivārttātō mama ya ānandō jāyatē tatō mahattarō nāsti|</para>
  <para style="p">
    <verse number="5" style="v"/>hē priya, bhrātr̥n prati viśēṣatastān vidēśinō bhr̥ाtr̥n prati tvayā yadyat kr̥taṁ tat sarvvaṁ viśvāsinō yōgyaṁ|</para>
  <para style="p">
    <verse number="6" style="v"/>tē ca samitēḥ sākṣāt tava pramnaḥ pramāṇaṁ dattavantaḥ, aparam īśvarayōgyarūpēṇa tān prasthāpayatā tvayā satkarmma kāriṣyatē|</para>
  <para style="p">
    <verse number="7" style="v"/>yatastē tasya nāmnā yātrāṁ vidhāya bhinnajātīyēbhyaḥ kimapi na gr̥hītavantaḥ|</para>
  <para style="p">
    <verse number="8" style="v"/>tasmād vayaṁ yat satyamatasya sahāyā bhavēma tadarthamētādr̥śā lōkā asmābhiranugrahītavyāḥ|</para>
  <para style="p">
    <verse number="9" style="v"/>samitiṁ pratyahaṁ patraṁ likhitavān kintu tēṣāṁ madhyē yō diyatriphiḥ pradhānāyatē sō 'smān na gr̥hlāti|</para>
  <para style="p">
    <verse number="10" style="v"/>atō 'haṁ yadōpasthāsyāmi tadā tēna yadyat kriyatē tat sarvvaṁ taṁ smārayiṣyāmi, yataḥ sa durvvākyairasmān apavadati, tēnāpi tr̥ptiṁ na gatvā svayamapi bhrātr̥n nānugr̥hlāti yē cānugrahītumicchanti tān samititō 'pi bahiṣkarōti|</para>
  <para style="p">
    <verse number="11" style="v"/>hē priya, tvayā duṣkarmma nānukriyatāṁ kintu satkarmmaiva| yaḥ satkarmmācārī sa īśvarāt jātaḥ, yō duṣkarmmācārī sa īśvaraṁ na dr̥ṣṭavān|</para>
  <para style="p">
    <verse number="12" style="v"/>dīmītriyasya pakṣē sarvvaiḥ sākṣyam adāyi viśēṣataḥ satyamatēnāpi, vayamapi tatpakṣē sākṣyaṁ dadmaḥ, asmākañca sākṣyaṁ satyamēvēti yūyaṁ jānītha|</para>
  <para style="p">
    <verse number="13" style="v"/>tvāṁ prati mayā bahūni lēkhitavyāni kintu masīlēkhanībhyāṁ lēkhituṁ nēcchāmi|</para>
  <para style="p">
    <verse number="14" style="v"/>acirēṇa tvāṁ drakṣyāmīti mama pratyāśāstē tadāvāṁ sammukhībhūya parasparaṁ sambhāṣiṣyāvahē|</para>
  <para style="p">
    <verse number="15" style="v"/>tava śānti rbhūyāt| asmākaṁ mitrāṇi tvāṁ namaskāraṁ jñāpayanti tvamapyēkaikasya nāma prōcya mitrēbhyō namaskuru| iti|</para>
</usx>
