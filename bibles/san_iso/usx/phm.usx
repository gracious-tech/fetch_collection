<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="PHM" style="id">Sanskrit Bible (NT) in ISO Script (satyavēdaḥ ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Philemon</para>
  <para style="toc1">philōmōnaṁ patraṁ</para>
  <para style="toc2">philōmōnaḥ</para>
  <para style="toc3">philōmōnaḥ</para>
  <para style="mt1">philōmōnaṁ patraṁ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>khrīṣṭasya yīśō rbandidāsaḥ paulastīthiyanāmā bhrātā ca priyaṁ sahakāriṇaṁ philīmōnaṁ</para>
  <para style="p">
    <verse number="2" style="v"/>priyām āppiyāṁ sahasēnām ārkhippaṁ philīmōnasya gr̥hē sthitāṁ samitiñca prati patraṁ likhataḥ|</para>
  <para style="p">
    <verse number="3" style="v"/>asmākaṁ tāta īśvaraḥ prabhu ryīśukhrīṣṭaśca yuṣmān prati śāntim anugrahañca kriyāstāṁ|</para>
  <para style="p">
    <verse number="4" style="v"/>prabhuṁ yīśuṁ prati sarvvān pavitralōkān prati ca tava prēmaviśvāsayō rvr̥ttāntaṁ niśamyāhaṁ</para>
  <para style="p">
    <verse number="5" style="v"/>prārthanāsamayē tava nāmōccārayan nirantaraṁ mamēśvaraṁ dhanyaṁ vadāmi|</para>
  <para style="p">
    <verse number="6" style="v"/>asmāsu yadyat saujanyaṁ vidyatē tat sarvvaṁ khrīṣṭaṁ yīśuṁ yat prati bhavatīti jñānāya tava viśvāsamūlikā dānaśīlatā yat saphalā bhavēt tadaham icchāmi|</para>
  <para style="p">
    <verse number="7" style="v"/>hē bhrātaḥ, tvayā pavitralōkānāṁ prāṇa āpyāyitā abhavan ētasmāt tava prēmnāsmākaṁ mahān ānandaḥ sāntvanā ca jātaḥ|</para>
  <para style="p">
    <verse number="8" style="v"/>tvayā yat karttavyaṁ tat tvām ājñāpayituṁ yadyapyahaṁ khrīṣṭēnātīvōtsukō bhavēyaṁ tathāpi vr̥ddha</para>
  <para style="p">
    <verse number="9" style="v"/>idānīṁ yīśukhrīṣṭasya bandidāsaścaivambhūtō yaḥ paulaḥ sō'haṁ tvāṁ vinētuṁ varaṁ manyē|</para>
  <para style="p">
    <verse number="10" style="v"/>ataḥ śr̥ṅkhalabaddhō'haṁ yamajanayaṁ taṁ madīyatanayam ōnīṣimam adhi tvāṁ vinayē|</para>
  <para style="p">
    <verse number="11" style="v"/>sa pūrvvaṁ tavānupakāraka āsīt kintvidānīṁ tava mama cōpakārī bhavati|</para>
  <para style="p">
    <verse number="12" style="v"/>tamēvāhaṁ tava samīpaṁ prēṣayāmi, atō madīyaprāṇasvarūpaḥ sa tvayānugr̥hyatāṁ|</para>
  <para style="p">
    <verse number="13" style="v"/>susaṁvādasya kr̥tē śr̥ṅkhalabaddhō'haṁ paricārakamiva taṁ svasannidhau varttayitum aicchaṁ|</para>
  <para style="p">
    <verse number="14" style="v"/>kintu tava saujanyaṁ yad balēna na bhūtvā svēcchāyāḥ phalaṁ bhavēt tadarthaṁ tava sammatiṁ vinā kimapi karttavyaṁ nāmanyē|</para>
  <para style="p">
    <verse number="15" style="v"/>kō jānāti kṣaṇakālārthaṁ tvattastasya vicchēdō'bhavad ētasyāyam abhiprāyō yat tvam anantakālārthaṁ taṁ lapsyasē</para>
  <para style="p">
    <verse number="16" style="v"/>puna rdāsamiva lapsyasē tannahi kintu dāsāt śrēṣṭhaṁ mama priyaṁ tava ca śārīrikasambandhāt prabhusambandhācca tatō'dhikaṁ priyaṁ bhrātaramiva|</para>
  <para style="p">
    <verse number="17" style="v"/>atō hētō ryadi māṁ sahabhāginaṁ jānāsi tarhi māmiva tamanugr̥hāṇa|</para>
  <para style="p">
    <verse number="18" style="v"/>tēna yadi tava kimapyaparāddhaṁ tubhyaṁ kimapi dhāryyatē vā tarhi tat mamēti viditvā gaṇaya|</para>
  <para style="p">
    <verse number="19" style="v"/>ahaṁ tat pariśōtsyāmi, ētat paulō'haṁ svahastēna likhāmi, yatastvaṁ svaprāṇān api mahyaṁ dhārayasi tad vaktuṁ nēcchāmi|</para>
  <para style="p">
    <verse number="20" style="v"/>bhō bhrātaḥ, prabhōḥ kr̥tē mama vāñchāṁ pūraya khrīṣṭasya kr̥tē mama prāṇān āpyāyaya|</para>
  <para style="p">
    <verse number="21" style="v"/>tavājñāgrāhitvē viśvasya mayā ētat likhyatē mayā yaducyatē tatō'dhikaṁ tvayā kāriṣyata iti jānāmi|</para>
  <para style="p">
    <verse number="22" style="v"/>tatkaraṇasamayē madarthamapi vāsagr̥haṁ tvayā sajjīkriyatāṁ yatō yuṣmākaṁ prārthanānāṁ phalarūpō vara ivāhaṁ yuṣmabhyaṁ dāyiṣyē mamēti pratyāśā jāyatē|</para>
  <para style="p">
    <verse number="23" style="v"/>khrīṣṭasya yīśāḥ kr̥tē mayā saha bandiripāphrā</para>
  <para style="p">
    <verse number="24" style="v"/>mama sahakāriṇō mārka āriṣṭārkhō dīmā lūkaśca tvāṁ namaskāraṁ vēdayanti|</para>
  <para style="p">
    <verse number="25" style="v"/>asmākaṁ prabhō ryīśukhrīṣṭasyānugrahō yuṣmākam ātmanā saha bhūyāt| āmēn|</para>
</usx>
