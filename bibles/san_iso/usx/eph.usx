  <para style="h">Ephesians</para>
  <para style="toc1">iphiṣiṇaḥ patraṁ</para>
  <para style="toc2">iphiṣiṇaḥ</para>
  <para style="toc3">iphiṣiṇaḥ</para>
  <para style="mt1">iphiṣiṇaḥ patraṁ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>īśvarasyēcchayā yīśukhrīṣṭasya prēritaḥ paula iphiṣanagarasthān pavitrān khrīṣṭayīśau viśvāsinō lōkān prati patraṁ likhati|</para>
  <para style="p">
    <verse number="2" style="v"/>asmākaṁ tātasyēśvarasya prabhō ryīśukhrīṣṭasya cānugrahaḥ śāntiśca yuṣmāsu varttatāṁ|</para>
  <para style="p">
    <verse number="3" style="v"/>asmākaṁ prabhō ryīśōḥ khrīṣṭasya tāta īśvarō dhanyō bhavatu; yataḥ sa khrīṣṭēnāsmabhyaṁ sarvvam ādhyātmikaṁ svargīyavaraṁ dattavān|</para>
  <para style="p">
    <verse number="4" style="v"/>vayaṁ yat tasya samakṣaṁ prēmnā pavitrā niṣkalaṅkāśca bhavāmastadarthaṁ sa jagataḥ sr̥ṣṭē pūrvvaṁ tēnāsmān abhirōcitavān, nijābhilaṣitānurōdhācca</para>
  <para style="p">
    <verse number="5" style="v"/>yīśunā khrīṣṭēna svasya nimittaṁ putratvapadē'smān svakīyānugrahasya mahattvasya praśaṁsārthaṁ pūrvvaṁ niyuktavān|</para>
  <para style="p">
    <verse number="6" style="v"/>tasmād anugrahāt sa yēna priyatamēna putrēṇāsmān anugr̥hītavān,</para>
  <para style="p">
    <verse number="7" style="v"/>vayaṁ tasya śōṇitēna muktim arthataḥ pāpakṣamāṁ labdhavantaḥ|</para>
  <para style="p">
    <verse number="8" style="v"/>tasya ya īdr̥śō'nugrahanidhistasmāt sō'smabhyaṁ sarvvavidhaṁ jñānaṁ buddhiñca bāhulyarūpēṇa vitaritavān|</para>
  <para style="p">
    <verse number="9" style="v"/>svargapr̥thivyō ryadyad vidyatē tatsarvvaṁ sa khrīṣṭē saṁgrahīṣyatīti hitaiṣiṇā</para>
  <para style="p">
    <verse number="10" style="v"/>tēna kr̥tō yō manōrathaḥ sampūrṇatāṁ gatavatsu samayēṣu sādhayitavyastamadhi sa svakīyābhilāṣasya nigūḍhaṁ bhāvam asmān jñāpitavān|</para>
  <para style="p">
    <verse number="11" style="v"/>pūrvvaṁ khrīṣṭē viśvāsinō yē vayam asmattō yat tasya mahimnaḥ praśaṁsā jāyatē,</para>
  <para style="p">
    <verse number="12" style="v"/>tadarthaṁ yaḥ svakīyēcchāyāḥ mantraṇātaḥ sarvvāṇi sādhayati tasya manōrathād vayaṁ khrīṣṭēna pūrvvaṁ nirūpitāḥ santō'dhikāriṇō jātāḥ|</para>
  <para style="p">
    <verse number="13" style="v"/>yūyamapi satyaṁ vākyam arthatō yuṣmatparitrāṇasya susaṁvādaṁ niśamya tasminnēva khrīṣṭē viśvasitavantaḥ pratijñātēna pavitrēṇātmanā mudrayēvāṅkitāśca|</para>
  <para style="p">
    <verse number="14" style="v"/>yatastasya mahimnaḥ prakāśāya tēna krītānāṁ lōkānāṁ mukti ryāvanna bhaviṣyati tāvat sa ātmāsmākam adhikāritvasya satyaṅkārasya paṇasvarūpō bhavati|</para>
  <para style="p">
    <verse number="15" style="v"/>prabhau yīśau yuṣmākaṁ viśvāsaḥ sarvvēṣu pavitralōkēṣu prēma cāsta iti vārttāṁ śrutvāhamapi</para>
  <para style="p">
    <verse number="16" style="v"/>yuṣmānadhi nirantaram īśvaraṁ dhanyaṁ vadan prārthanāsamayē ca yuṣmān smaran varamimaṁ yācāmi|</para>
  <para style="p">
    <verse number="17" style="v"/>asmākaṁ prabhō ryīśukhrīṣṭasya tātō yaḥ prabhāvākara īśvaraḥ sa svakīyatattvajñānāya yuṣmabhyaṁ jñānajanakam prakāśitavākyabōdhakañcātmānaṁ dēyāt|</para>
  <para style="p">
    <verse number="18" style="v"/>yuṣmākaṁ jñānacakṣūṁṣi ca dīptiyuktāni kr̥tvā tasyāhvānaṁ kīdr̥śyā pratyāśayā sambalitaṁ pavitralōkānāṁ madhyē tēna dattō'dhikāraḥ kīdr̥śaḥ prabhāvanidhi rviśvāsiṣu cāsmāsu prakāśamānasya</para>
  <para style="p">
    <verse number="19" style="v"/>tadīyamahāparākramasya mahatvaṁ kīdr̥g anupamaṁ tat sarvvaṁ yuṣmān jñāpayatu|</para>
  <para style="p">
    <verse number="20" style="v"/>yataḥ sa yasyāḥ śaktēḥ prabalatāṁ khrīṣṭē prakāśayan mr̥tagaṇamadhyāt tam utthāpitavān,</para>
  <para style="p">
    <verse number="21" style="v"/>adhipatitvapadaṁ śāsanapadaṁ parākramō rājatvañcētināmāni yāvanti padānīha lōkē paralōkē ca vidyantē tēṣāṁ sarvvēṣām ūrddhvē svargē nijadakṣiṇapārśvē tam upavēśitavān,</para>
  <para style="p">
    <verse number="22" style="v"/>sarvvāṇi tasya caraṇayōradhō nihitavān yā samitistasya śarīraṁ sarvvatra sarvvēṣāṁ pūrayituḥ pūrakañca bhavati taṁ tasyā mūrddhānaṁ kr̥tvā</para>
  <para style="p">
    <verse number="23" style="v"/>sarvvēṣām uparyyupari niyuktavāṁśca saiva śaktirasmāsvapi tēna prakāśyatē|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>purā yūyam aparādhaiḥ pāpaiśca mr̥tāḥ santastānyācaranta ihalōkasya saṁsārānusārēṇākāśarājyasyādhipatim</para>
  <para style="p">
    <verse number="2" style="v"/>arthataḥ sāmpratam ājñālaṅghivaṁśēṣu karmmakāriṇam ātmānam anvavrajata|</para>
  <para style="p">
    <verse number="3" style="v"/>tēṣāṁ madhyē sarvvē vayamapi pūrvvaṁ śarīrasya manaskāmanāyāñcēhāṁ sādhayantaḥ svaśarīrasyābhilāṣān ācarāma sarvvē'nya iva ca svabhāvataḥ krōdhabhajanānyabhavāma|</para>
  <para style="p">
    <verse number="4" style="v"/>kintu karuṇānidhirīśvarō yēna mahāprēmnāsmān dayitavān</para>
  <para style="p">
    <verse number="5" style="v"/>tasya svaprēmnō bāhulyād aparādhai rmr̥tānapyasmān khrīṣṭēna saha jīvitavān yatō'nugrahād yūyaṁ paritrāṇaṁ prāptāḥ|</para>
  <para style="p">
    <verse number="6" style="v"/>sa ca khrīṣṭēna yīśunāsmān tēna sārddham utthāpitavān svarga upavēśitavāṁśca|</para>
  <para style="p">
    <verse number="7" style="v"/>itthaṁ sa khrīṣṭēna yīśunāsmān prati svahitaiṣitayā bhāviyugēṣu svakīyānugrahasyānupamaṁ nidhiṁ prakāśayitum icchati|</para>
  <para style="p">
    <verse number="8" style="v"/>yūyam anugrahād viśvāsēna paritrāṇaṁ prāptāḥ, tacca yuṣmanmūlakaṁ nahi kintvīśvarasyaiva dānaṁ,</para>
  <para style="p">
    <verse number="9" style="v"/>tat karmmaṇāṁ phalam api nahi, ataḥ kēnāpi na ślāghitavyaṁ|</para>
  <para style="p">
    <verse number="10" style="v"/>yatō vayaṁ tasya kāryyaṁ prāg īśvarēṇa nirūpitābhiḥ satkriyābhiḥ kālayāpanāya khrīṣṭē yīśau tēna mr̥ṣṭāśca|</para>
  <para style="p">
    <verse number="11" style="v"/>purā janmanā bhinnajātīyā hastakr̥taṁ tvakchēdaṁ prāptai rlōkaiścācchinnatvaca itināmnā khyātā yē yūyaṁ tai ryuṣmābhiridaṁ smarttavyaṁ</para>
  <para style="p">
    <verse number="12" style="v"/>yat tasmin samayē yūyaṁ khrīṣṭād bhinnā isrāyēlalōkānāṁ sahavāsād dūrasthāḥ pratijñāsambalitaniyamānāṁ bahiḥ sthitāḥ santō nirāśā nirīśvarāśca jagatyādhvam iti|</para>
  <para style="p">
    <verse number="13" style="v"/>kintvadhunā khrīṣṭē yīśāvāśrayaṁ prāpya purā dūravarttinō yūyaṁ khrīṣṭasya śōṇitēna nikaṭavarttinō'bhavata|</para>
  <para style="p">
    <verse number="14" style="v"/>yataḥ sa ēvāsmākaṁ sandhiḥ sa dvayam ēkīkr̥tavān śatrutārūpiṇīṁ madhyavarttinīṁ prabhēdakabhittiṁ bhagnavān daṇḍājñāyuktaṁ vidhiśāstraṁ svaśarīrēṇa luptavāṁśca|</para>
  <para style="p">
    <verse number="15" style="v"/>yataḥ sa sandhiṁ vidhāya tau dvau svasmin ēkaṁ nutanaṁ mānavaṁ karttuṁ</para>
  <para style="p">
    <verse number="16" style="v"/>svakīyakruśē śatrutāṁ nihatya tēnaivaikasmin śarīrē tayō rdvayōrīśvarēṇa sandhiṁ kārayituṁ niścatavān|</para>
  <para style="p">
    <verse number="17" style="v"/>sa cāgatya dūravarttinō yuṣmān nikaṭavarttinō 'smāṁśca sandhē rmaṅgalavārttāṁ jñāpitavān|</para>
  <para style="p">
    <verse number="18" style="v"/>yatastasmād ubhayapakṣīyā vayam ēkēnātmanā pituḥ samīpaṁ gamanāya sāmarthyaṁ prāptavantaḥ|</para>
  <para style="p">
    <verse number="19" style="v"/>ata idānīṁ yūyam asamparkīyā vidēśinaśca na tiṣṭhanataḥ pavitralōkaiḥ sahavāsina īśvarasya vēśmavāsinaścādhvē|</para>
  <para style="p">
    <verse number="20" style="v"/>aparaṁ prēritā bhaviṣyadvādinaśca yatra bhittimūlasvarūpāstatra yūyaṁ tasmin mūlē nicīyadhvē tatra ca svayaṁ yīśuḥ khrīṣṭaḥ pradhānaḥ kōṇasthaprastaraḥ|</para>
  <para style="p">
    <verse number="21" style="v"/>tēna kr̥tsnā nirmmitiḥ saṁgrathyamānā prabhōḥ pavitraṁ mandiraṁ bhavituṁ varddhatē|</para>
  <para style="p">
    <verse number="22" style="v"/>yūyamapi tatra saṁgrathyamānā ātmanēśvarasya vāsasthānaṁ bhavatha|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>atō hētō rbhinnajātīyānāṁ yuṣmākaṁ nimittaṁ yīśukhrīṣṭasya bandī yaḥ sō'haṁ paulō bravīmi|</para>
  <para style="p">
    <verse number="2" style="v"/>yuṣmadartham īśvarēṇa mahyaṁ dattasya varasya niyamaḥ kīdr̥śastad yuṣmābhiraśrāvīti manyē|</para>
  <para style="p">
    <verse number="3" style="v"/>arthataḥ pūrvvaṁ mayā saṁkṣēpēṇa yathā likhitaṁ tathāhaṁ prakāśitavākyēnēśvarasya nigūḍhaṁ bhāvaṁ jñāpitō'bhavaṁ|</para>
  <para style="p">
    <verse number="4" style="v"/>atō yuṣmābhistat paṭhitvā khrīṣṭamadhi tasminnigūḍhē bhāvē mama jñānaṁ kīdr̥śaṁ tad bhōtsyatē|</para>
  <para style="p">
    <verse number="5" style="v"/>pūrvvayugēṣu mānavasantānāstaṁ jñāpitā nāsan kintvadhunā sa bhāvastasya pavitrān prēritān bhaviṣyadvādinaśca pratyātmanā prakāśitō'bhavat;</para>
  <para style="p">
    <verse number="6" style="v"/>arthata īśvarasya śaktēḥ prakāśāt tasyānugrahēṇa yō varō mahyam adāyi tēnāhaṁ yasya susaṁvādasya paricārakō'bhavaṁ,</para>
  <para style="p">
    <verse number="7" style="v"/>tadvārā khrīṣṭēna bhinnajātīyā anyaiḥ sārddham ēkādhikārā ēkaśarīrā ēkasyāḥ pratijñāyā aṁśinaśca bhaviṣyantīti|</para>
  <para style="p">
    <verse number="8" style="v"/>sarvvēṣāṁ pavitralōkānāṁ kṣudratamāya mahyaṁ varō'yam adāyi yad bhinnajātīyānāṁ madhyē bōdhāgayasya guṇanidhēḥ khrīṣṭasya maṅgalavārttāṁ pracārayāmi,</para>
  <para style="p">
    <verse number="9" style="v"/>kālāvasthātaḥ pūrvvasmācca yō nigūḍhabhāva īśvarē gupta āsīt tadīyaniyamaṁ sarvvān jñāpayāmi|</para>
  <para style="p">
    <verse number="10" style="v"/>yata īśvarasya nānārūpaṁ jñānaṁ yat sāmprataṁ samityā svargē prādhānyaparākramayuktānāṁ dūtānāṁ nikaṭē prakāśyatē tadarthaṁ sa yīśunā khrīṣṭēna sarvvāṇi sr̥ṣṭavān|</para>
  <para style="p">
    <verse number="11" style="v"/>yatō vayaṁ yasmin viśvasya dr̥ḍhabhaktyā nirbhayatām īśvarasya samāgamē sāmarthyañca</para>
  <para style="p">
    <verse number="12" style="v"/>prāptavantastamasmākaṁ prabhuṁ yīśuṁ khrīṣṭamadhi sa kālāvasthāyāḥ pūrvvaṁ taṁ manōrathaṁ kr̥tavān|</para>
  <para style="p">
    <verse number="13" style="v"/>atō'haṁ yuṣmannimittaṁ duḥkhabhōgēna klāntiṁ yanna gacchāmīti prārthayē yatastadēva yuṣmākaṁ gauravaṁ|</para>
  <para style="p">
    <verse number="14" style="v"/>atō hētōḥ svargapr̥thivyōḥ sthitaḥ kr̥tsnō vaṁśō yasya nāmnā vikhyātastam</para>
  <para style="p">
    <verse number="15" style="v"/>asmatprabhō ryīśukhrīṣṭasya pitaramuddiśyāhaṁ jānunī pātayitvā tasya prabhāvanidhitō varamimaṁ prārthayē|</para>
  <para style="p">
    <verse number="16" style="v"/>tasyātmanā yuṣmākam āntarikapuruṣasya śaktē rvr̥ddhiḥ kriyatāṁ|</para>
  <para style="p">
    <verse number="17" style="v"/>khrīṣṭastu viśvāsēna yuṣmākaṁ hr̥dayēṣu nivasatu| prēmaṇi yuṣmākaṁ baddhamūlatvaṁ susthiratvañca bhavatu|</para>
  <para style="p">
    <verse number="18" style="v"/>itthaṁ prasthatāyā dīrghatāyā gabhīratāyā uccatāyāśca bōdhāya sarvvaiḥ pavitralōkaiḥ prāpyaṁ sāmarthyaṁ yuṣmābhi rlabhyatāṁ,</para>
  <para style="p">
    <verse number="19" style="v"/>jñānātiriktaṁ khrīṣṭasya prēma jñāyatām īśvarasya sampūrṇavr̥ddhiparyyantaṁ yuṣmākaṁ vr̥ddhi rbhavatu ca|</para>
  <para style="p">
    <verse number="20" style="v"/>asmākam antarē yā śaktiḥ prakāśatē tayā sarvvātiriktaṁ karmma kurvvan asmākaṁ prārthanāṁ kalpanāñcātikramituṁ yaḥ śaknōti</para>
  <para style="p">
    <verse number="21" style="v"/>khrīṣṭayīśunā samitē rmadhyē sarvvēṣu yugēṣu tasya dhanyavādō bhavatu| iti|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>atō bandirahaṁ prabhō rnāmnā yuṣmān vinayē yūyaṁ yēnāhvānēnāhūtāstadupayuktarūpēṇa</para>
  <para style="p">
    <verse number="2" style="v"/>sarvvathā namratāṁ mr̥dutāṁ titikṣāṁ parasparaṁ pramnā sahiṣṇutāñcācarata|</para>
  <para style="p">
    <verse number="3" style="v"/>praṇayabandhanēna cātmana ēैkyaṁ rakṣituṁ yatadhvaṁ|</para>
  <para style="p">
    <verse number="4" style="v"/>yūyam ēkaśarīrā ēkātmānaśca tadvad āhvānēna yūyam ēkapratyāśāprāptayē samāhūtāḥ|</para>
  <para style="p">
    <verse number="5" style="v"/>yuṣmākam ēkaḥ prabhurēkō viśvāsa ēkaṁ majjanaṁ, sarvvēṣāṁ tātaḥ</para>
  <para style="p">
    <verse number="6" style="v"/>sarvvōparisthaḥ sarvvavyāpī sarvvēṣāṁ yuṣmākaṁ madhyavarttī caika īśvara āstē|</para>
  <para style="p">
    <verse number="7" style="v"/>kintu khrīṣṭasya dānaparimāṇānusārād asmākam ēkaikasmai viśēṣō varō'dāyi|</para>
  <para style="p">
    <verse number="8" style="v"/>yathā likhitam āstē, "ūrddhvam āruhya jētr̥n sa vijitya bandinō'karōt| tataḥ sa manujēbhyō'pi svīyān vyaśrāṇayad varān||"</para>
  <para style="p">
    <verse number="9" style="v"/>ūrddhvam āruhyētivākyasyāyamarthaḥ sa pūrvvaṁ pr̥thivīrūpaṁ sarvvādhaḥsthitaṁ sthānam avatīrṇavān;</para>
  <para style="p">
    <verse number="10" style="v"/>yaścāvatīrṇavān sa ēva svargāṇām uparyyuparyyārūḍhavān yataḥ sarvvāṇi tēna pūrayitavyāni|</para>
  <para style="p">
    <verse number="11" style="v"/>sa ēva ca kāṁścana prēritān aparān bhaviṣyadvādinō'parān susaṁvādapracārakān aparān pālakān upadēśakāṁśca niyuktavān|</para>
  <para style="p">
    <verse number="12" style="v"/>yāvad vayaṁ sarvvē viśvāsasyēśvaraputraviṣayakasya tattvajñānasya caikyaṁ sampūrṇaṁ puruṣarthañcārthataḥ khrīṣṭasya sampūrṇaparimāṇasya samaṁ parimāṇaṁ na prāpnumastāvat</para>
  <para style="p">
    <verse number="13" style="v"/>sa paricaryyākarmmasādhanāya khrīṣṭasya śarīrasya niṣṭhāyai ca pavitralōkānāṁ siddhatāyāstādr̥śam upāyaṁ niścitavān|</para>
  <para style="p">
    <verse number="14" style="v"/>ataēva mānuṣāṇāṁ cāturītō bhramakadhūrttatāyāśchalācca jātēna sarvvēṇa śikṣāvāyunā vayaṁ yad bālakā iva dōlāyamānā na bhrāmyāma ityasmābhi ryatitavyaṁ,</para>
  <para style="p">
    <verse number="15" style="v"/>prēmnā satyatām ācaradbhiḥ sarvvaviṣayē khrīṣṭam uddiśya varddhitavyañca, yataḥ sa mūrddhā,</para>
  <para style="p">
    <verse number="16" style="v"/>tasmāccaikaikasyāṅgasya svasvaparimāṇānusārēṇa sāhāyyakaraṇād upakārakaiḥ sarvvaiḥ sandhibhiḥ kr̥tsnasya śarīrasya saṁyōgē sammilanē ca jātē prēmnā niṣṭhāṁ labhamānaṁ kr̥tsnaṁ śarīraṁ vr̥ddhiṁ prāpnōti|</para>
  <para style="p">
    <verse number="17" style="v"/>yuṣmān ahaṁ prabhunēdaṁ bravīmyādiśāmi ca, anyē bhinnajātīyā iva yūyaṁ pūna rmācarata|</para>
  <para style="p">
    <verse number="18" style="v"/>yatastē svamanōmāyām ācarantyāntarikājñānāt mānasikakāṭhinyācca timirāvr̥tabuddhaya īśvarīyajīvanasya bagīrbhūtāśca bhavanti,</para>
  <para style="p">
    <verse number="19" style="v"/>svān caitanyaśūnyān kr̥tvā ca lōbhēna sarvvavidhāśaucācaraṇāya lampaṭatāyāṁ svān samarpitavantaḥ|</para>
  <para style="p">
    <verse number="20" style="v"/>kintu yūyaṁ khrīṣṭaṁ na tādr̥śaṁ paricitavantaḥ,</para>
  <para style="p">
    <verse number="21" style="v"/>yatō yūyaṁ taṁ śrutavantō yā satyā śikṣā yīśutō labhyā tadanusārāt tadīyōpadēśaṁ prāptavantaścēti manyē|</para>
  <para style="p">
    <verse number="22" style="v"/>tasmāt pūrvvakālikācārakārī yaḥ purātanapuruṣō māyābhilāṣai rnaśyati taṁ tyaktvā yuṣmābhi rmānasikabhāvō nūtanīkarttavyaḥ,</para>
  <para style="p">
    <verse number="23" style="v"/>yō navapuruṣa īśvarānurūpēṇa puṇyēna satyatāsahitēna</para>
  <para style="p">
    <verse number="24" style="v"/>dhārmmikatvēna ca sr̥ṣṭaḥ sa ēva paridhātavyaśca|</para>
  <para style="p">
    <verse number="25" style="v"/>atō yūyaṁ sarvvē mithyākathanaṁ parityajya samīpavāsibhiḥ saha satyālāpaṁ kuruta yatō vayaṁ parasparam aṅgapratyaṅgā bhavāmaḥ|</para>
  <para style="p">
    <verse number="26" style="v"/>aparaṁ krōdhē jātē pāpaṁ mā kurudhvam, aśāntē yuṣmākaṁ rōṣēsūryyō'staṁ na gacchatu|</para>
  <para style="p">
    <verse number="27" style="v"/>aparaṁ śayatānē sthānaṁ mā datta|</para>
  <para style="p">
    <verse number="28" style="v"/>cōraḥ punaścairyyaṁ na karōtu kintu dīnāya dānē sāmarthyaṁ yajjāyatē tadarthaṁ svakarābhyāṁ sadvr̥ttyā pariśramaṁ karōtu|</para>
  <para style="p">
    <verse number="29" style="v"/>aparaṁ yuṣmākaṁ vadanēbhyaḥ kō'pi kadālāpō na nirgacchatu, kintu yēna śrōturupakārō jāyatē tādr̥śaḥ prayōjanīyaniṣṭhāyai phaladāyaka ālāpō yuṣmākaṁ bhavatu|</para>
  <para style="p">
    <verse number="30" style="v"/>aparañca yūyaṁ muktidinaparyyantam īśvarasya yēna pavitrēṇātmanā mudrayāṅkitā abhavata taṁ śōkānvitaṁ mā kuruta|</para>
  <para style="p">
    <verse number="31" style="v"/>aparaṁ kaṭuvākyaṁ rōṣaḥ kōṣaḥ kalahō nindā sarvvavidhadvēṣaścaitāni yuṣmākaṁ madhyād dūrībhavantu|</para>
  <para style="p">
    <verse number="32" style="v"/>yūyaṁ parasparaṁ hitaiṣiṇaḥ kōmalāntaḥkaraṇāśca bhavata| aparam īśvaraḥ khrīṣṭēna yadvad yuṣmākaṁ dōṣān kṣamitavān tadvad yūyamapi parasparaṁ kṣamadhvaṁ|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>atō yūyaṁ priyabālakā ivēśvarasyānukāriṇō bhavata,</para>
  <para style="p">
    <verse number="2" style="v"/>khrīṣṭa iva prēmācāraṁ kuruta ca, yataḥ sō'smāsu prēma kr̥tavān asmākaṁ vinimayēna cātmanivēdanaṁ kr̥tvā grāhyasugandhārthakam upahāraṁ baliñcēśvarāca dattavān|</para>
  <para style="p">
    <verse number="3" style="v"/>kintu vēśyāgamanaṁ sarvvavidhāśaucakriyā lōbhaścaitēṣām uccāraṇamapi yuṣmākaṁ madhyē na bhavatu, ētadēva pavitralōkānām ucitaṁ|</para>
  <para style="p">
    <verse number="4" style="v"/>aparaṁ kutsitālāpaḥ pralāpaḥ ślēṣōktiśca na bhavatu yata ētānyanucitāni kintvīśvarasya dhanyavādō bhavatu|</para>
  <para style="p">
    <verse number="5" style="v"/>vēśyāgāmyaśaucācārī dēvapūjaka iva gaṇyō lōbhī caitēṣāṁ kōṣi khrīṣṭasya rājyē'rthata īśvarasya rājyē kamapyadhikāraṁ na prāpsyatīti yuṣmābhiḥ samyak jñāyatāṁ|</para>
  <para style="p">
    <verse number="6" style="v"/>anarthakavākyēna kō'pi yuṣmān na vañcayatu yatastādr̥gācārahētōranājñāgrāhiṣu lōkēṣvīśvarasya kōpō varttatē|</para>
  <para style="p">
    <verse number="7" style="v"/>tasmād yūyaṁ taiḥ sahabhāginō na bhavata|</para>
  <para style="p">
    <verse number="8" style="v"/>pūrvvaṁ yūyam andhakārasvarūpā ādhvaṁ kintvidānīṁ prabhunā dīptisvarūpā bhavatha tasmād dīptēḥ santānā iva samācarata|</para>
  <para style="p">
    <verse number="9" style="v"/>dīptē ryat phalaṁ tat sarvvavidhahitaiṣitāyāṁ dharmmē satyālāpē ca prakāśatē|</para>
  <para style="p">
    <verse number="10" style="v"/>prabhavē yad rōcatē tat parīkṣadhvaṁ|</para>
  <para style="p">
    <verse number="11" style="v"/>yūyaṁ timirasya viphalakarmmaṇām aṁśinō na bhūtvā tēṣāṁ dōṣitvaṁ prakāśayata|</para>
  <para style="p">
    <verse number="12" style="v"/>yatastē lōkā rahami yad yad ācaranti taduccāraṇam api lajjājanakaṁ|</para>
  <para style="p">
    <verse number="13" style="v"/>yatō dīptyā yad yat prakāśyatē tat tayā cakāsyatē yacca cakāsti tad dīptisvarūpaṁ bhavati|</para>
  <para style="p">
    <verse number="14" style="v"/>ētatkāraṇād uktam āstē, "hē nidrita prabudhyasva mr̥tēbhyaścōtthitiṁ kuru| tatkr̥tē sūryyavat khrīṣṭaḥ svayaṁ tvāṁ dyōtayiṣyati|"</para>
  <para style="p">
    <verse number="15" style="v"/>ataḥ sāvadhānā bhavata, ajñānā iva mācarata kintu jñānina iva satarkam ācarata|</para>
  <para style="p">
    <verse number="16" style="v"/>samayaṁ bahumūlyaṁ gaṇayadhvaṁ yataḥ kālā abhadrāḥ|</para>
  <para style="p">
    <verse number="17" style="v"/>tasmād yūyam ajñānā na bhavata kintu prabhōrabhimataṁ kiṁ tadavagatā bhavata|</para>
  <para style="p">
    <verse number="18" style="v"/>sarvvanāśajanakēna surāpānēna mattā mā bhavata kintvātmanā pūryyadhvaṁ|</para>
  <para style="p">
    <verse number="19" style="v"/>aparaṁ gītai rgānaiḥ pāramārthikakīrttanaiśca parasparam ālapantō manasā sārddhaṁ prabhum uddiśya gāyata vādayata ca|</para>
  <para style="p">
    <verse number="20" style="v"/>sarvvadā sarvvaviṣayē'smatprabhō yīśōḥ khrīṣṭasya nāmnā tātam īśvaraṁ dhanyaṁ vadata|</para>
  <para style="p">
    <verse number="21" style="v"/>yūyam īśvarād bhītāḥ santa anyē'parēṣāṁ vaśībhūtā bhavata|</para>
  <para style="p">
    <verse number="22" style="v"/>hē yōṣitaḥ, yūyaṁ yathā prabhōstathā svasvasvāminō vaśaṅgatā bhavata|</para>
  <para style="p">
    <verse number="23" style="v"/>yataḥ khrīṣṭō yadvat samitē rmūrddhā śarīrasya trātā ca bhavati tadvat svāmī yōṣitō mūrddhā|</para>
  <para style="p">
    <verse number="24" style="v"/>ataḥ samiti ryadvat khrīṣṭasya vaśībhūtā tadvad yōṣidbhirapi svasvasvāminō vaśatā svīkarttavyā|</para>
  <para style="p">
    <verse number="25" style="v"/>aparañca hē puruṣāḥ, yūyaṁ khrīṣṭa iva svasvayōṣitsu prīyadhvaṁ|</para>
  <para style="p">
    <verse number="26" style="v"/>sa khrīṣṭō'pi samitau prītavān tasyāḥ kr̥tē ca svaprāṇān tyaktavān yataḥ sa vākyē jalamajjanēna tāṁ pariṣkr̥tya pāvayitum</para>
  <para style="p">
    <verse number="27" style="v"/>aparaṁ tilakavalyādivihīnāṁ pavitrāṁ niṣkalaṅkāñca tāṁ samitiṁ tējasvinīṁ kr̥tvā svahastē samarpayituñcābhilaṣitavān|</para>
  <para style="p">
    <verse number="28" style="v"/>tasmāt svatanuvat svayōṣiti prēmakaraṇaṁ puruṣasyōcitaṁ, yēna svayōṣiti prēma kriyatē tēnātmaprēma kriyatē|</para>
  <para style="p">
    <verse number="29" style="v"/>kō'pi kadāpi na svakīyāṁ tanum r̥tīyitavān kintu sarvvē tāṁ vibhrati puṣṇanti ca| khrīṣṭō'pi samitiṁ prati tadēva karōti,</para>
  <para style="p">
    <verse number="30" style="v"/>yatō vayaṁ tasya śarīrasyāṅgāni māṁsāsthīni ca bhavāmaḥ|</para>
  <para style="p">
    <verse number="31" style="v"/>ētadarthaṁ mānavaḥ svamātāpitarōै parityajya svabhāryyāyām āsaṁkṣyati tau dvau janāvēkāṅgau bhaviṣyataḥ|</para>
  <para style="p">
    <verse number="32" style="v"/>ētannigūḍhavākyaṁ gurutaraṁ mayā ca khrīṣṭasamitī adhi tad ucyatē|</para>
  <para style="p">
    <verse number="33" style="v"/>ataēva yuṣmākam ēkaikō jana ātmavat svayōṣiti prīyatāṁ bhāryyāpi svāminaṁ samādarttuṁ yatatāṁ|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>hē bālakāḥ, yūyaṁ prabhum uddiśya pitrōrājñāgrāhiṇō bhavata yatastat nyāyyaṁ|</para>
  <para style="p">
    <verse number="2" style="v"/>tvaṁ nijapitaraṁ mātarañca sammanyasvēti yō vidhiḥ sa pratijñāyuktaḥ prathamō vidhiḥ</para>
  <para style="p">
    <verse number="3" style="v"/>phalatastasmāt tava kalyāṇaṁ dēśē ca dīrghakālam āyu rbhaviṣyatīti|</para>
  <para style="p">
    <verse number="4" style="v"/>aparaṁ hē pitaraḥ, yūyaṁ svabālakān mā rōṣayata kintu prabhō rvinītyādēśābhyāṁ tān vinayata|</para>
  <para style="p">
    <verse number="5" style="v"/>hē dāsāḥ, yūyaṁ khrīṣṭam uddiśya sabhayāḥ kampānvitāśca bhūtvā saralāntaḥkaraṇairaihikaprabhūnām ājñāgrāhiṇō bhavata|</para>
  <para style="p">
    <verse number="6" style="v"/>dr̥ṣṭigōcarīyaparicaryyayā mānuṣēbhyō rōcituṁ mā yatadhvaṁ kintu khrīṣṭasya dāsā iva niviṣṭamanōbhirīścarasyēcchāṁ sādhayata|</para>
  <para style="p">
    <verse number="7" style="v"/>mānavān anuddiśya prabhumēvōddiśya sadbhāvēna dāsyakarmma kurudhvaṁ|</para>
  <para style="p">
    <verse number="8" style="v"/>dāsamuktayō ryēna yat satkarmma kriyatē tēna tasya phalaṁ prabhutō lapsyata iti jānīta ca|</para>
  <para style="p">
    <verse number="9" style="v"/>aparaṁ hē prabhavaḥ, yuṣmābhi rbhartsanaṁ vihāya tān prati nyāyyācaraṇaṁ kriyatāṁ yaśca kasyāpi pakṣapātaṁ na karōti yuṣmākamapi tādr̥śa ēkaḥ prabhuḥ svargē vidyata iti jñāyatāṁ|</para>
  <para style="p">
    <verse number="10" style="v"/>adhikantu hē bhrātaraḥ, yūyaṁ prabhunā tasya vikramayuktaśaktyā ca balavantō bhavata|</para>
  <para style="p">
    <verse number="11" style="v"/>yūyaṁ yat śayatānaśchalāni nivārayituṁ śaknutha tadartham īśvarīyasusajjāṁ paridhaddhvaṁ|</para>
  <para style="p">
    <verse number="12" style="v"/>yataḥ kēvalaṁ raktamāṁsābhyām iti nahi kintu kartr̥tvaparākramayuktaistimirarājyasyēhalōkasyādhipatibhiḥ svargōdbhavai rduṣṭātmabhirēva sārddham asmābhi ryuddhaṁ kriyatē|</para>
  <para style="p">
    <verse number="13" style="v"/>atō hētō ryūyaṁ yayā saṁkuेlē dinē'vasthātuṁ sarvvāṇi parājitya dr̥ḍhāḥ sthātuñca śakṣyatha tām īśvarīyasusajjāṁ gr̥hlīta|</para>
  <para style="p">
    <verse number="14" style="v"/>vastutastu satyatvēna śr̥ṅkhalēna kaṭiṁ baddhvā puṇyēna varmmaṇā vakṣa ācchādya</para>
  <para style="p">
    <verse number="15" style="v"/>śāntēḥ suvārttayā jātam utsāhaṁ pādukāyugalaṁ padē samarpya tiṣṭhata|</para>
  <para style="p">
    <verse number="16" style="v"/>yēna ca duṣṭātmanō'gnibāṇān sarvvān nirvvāpayituṁ śakṣyatha tādr̥śaṁ sarvvācchādakaṁ phalakaṁ viśvāsaṁ dhārayata|</para>
  <para style="p">
    <verse number="17" style="v"/>śirastraṁ paritrāṇam ātmanaḥ khaṅgañcēśvarasya vākyaṁ dhārayata|</para>
  <para style="p">
    <verse number="18" style="v"/>sarvvasamayē sarvvayācanēna sarvvaprārthanēna cātmanā prārthanāṁ kurudhvaṁ tadarthaṁ dr̥ḍhākāṅkṣayā jāgrataḥ sarvvēṣāṁ pavitralōkānāṁ kr̥tē sadā prārthanāṁ kurudhvaṁ|</para>
  <para style="p">
    <verse number="19" style="v"/>ahañca yasya susaṁvādasya śr̥ṅkhalabaddhaḥ pracārakadūtō'smi tam upayuktēnōtsāhēna pracārayituṁ yathā śaknuyāṁ</para>
  <para style="p">
    <verse number="20" style="v"/>tathā nirbhayēna svarēṇōtsāhēna ca susaṁvādasya nigūḍhavākyapracārāya vaktr̥ाtā yat mahyaṁ dīyatē tadarthaṁ mamāpi kr̥tē prārthanāṁ kurudhvaṁ|</para>
  <para style="p">
    <verse number="21" style="v"/>aparaṁ mama yāvasthāsti yacca mayā kriyatē tat sarvvaṁ yad yuṣmābhi rjñāyatē tadarthaṁ prabhunā priyabhrātā viśvāsyaḥ paricārakaśca tukhikō yuṣmān tat jñāpayiṣyati|</para>
  <para style="p">
    <verse number="22" style="v"/>yūyaṁ yad asmākam avasthāṁ jānītha yuṣmākaṁ manāṁsi ca yat sāntvanāṁ labhantē tadarthamēvāhaṁ yuṣmākaṁ sannidhiṁ taṁ prēṣitavāna|</para>
  <para style="p">
    <verse number="23" style="v"/>aparam īśvaraḥ prabhu ryīśukhrīṣṭaśca sarvvēbhyō bhrātr̥bhyaḥ śāntiṁ viśvāsasahitaṁ prēma ca dēyāt|</para>
  <para style="p">
    <verse number="24" style="v"/>yē kēcit prabhau yīśukhrīṣṭē'kṣayaṁ prēma kurvvanti tān prati prasādō bhūyāt| tathāstu|</para>
</usx>
