<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="LUK" style="id">- Melo New Testament Ethiopic</book>
  <para style="h">ሉቃሳ</para>
  <para style="toc1">ሉቃሳ ጻፌዝ የሱሳ ክርስቶሳ ዎንግለ</para>
  <para style="toc2">ሉቃሳ</para>
  <para style="toc3">ሉቃ.</para>
  <para style="mt1">ሉቃሳ ጻፌዝ የሱስ ክርስቶሳ ዎንግለ</para>
  <para style="imt">ገሎ</para>
  <para style="ip">የሱሳ ዶሬዝ ታጶ ናምኢ ሀዋርታይ ጋንጨ ሉቃሳ ባያ። ሉቃሳ ዎንግላይ፥ የሱሳ ቲና ናብታይ ዶና የኦዳ ግንትንቲ ኦድንቴዝ፥ እስሬልታይ ካሰፕ ናግታር የዛይ «ክርስቶሳ» ማቄዛኔ አስ ሼሽ ኡባ አሽዛ ማቄዛ ቤዝዛ። ሉቃሳ፥ ፋ ማጻፋይድ የሱሳ፥ «ማንቅታይስ ዎንግለ ሳባኮዳይስ» ፋ አዳይፕ ኪትንቴዛ ማቄዛኔ የ ዎንግላይ አሳይስ የዝ ዱማ ዱማ መቶፕ ከስዛያ ማቄዛና ኦድዛ። ሉቃሳ ዎንግለ ጋንጨ፥ የሱሳ ይእ ባጋ ኦድዝ ቲና ሸምፕታይዳኔ የሱሳ ፉደ ሳሎ ከዜዛያ ኦድዝ ዉርስ ሸምፕታይድ ቆንጨ ኦድንቴዛይ ኡፋይስ ባጋ። የሱሳ ሳሎ ከዜዛይፕ ጉየ አማኖ ዋይዚ ድጬዛኮኔ ዳልጌዛኮ ኦድዛ ታርካ Ꮊ ዎንግለ ጻፋይ ሀዋርታይ ኦ ማጻፋይድ ጻፌዛ።</para>
  <para style="ip">ኪታንችታይ ማዝሙራይ ባጋ፥ የሱሳ የልንቴዝ ዎደ መሄ ሄንግዝታይ Ꮊንጊ በኤዛና ኦድዛ ታርካይ ባጋ፥ የሱሳ ናአዛር ጾስ ካራ Ꮊንጌዛይ ባጋ፥ ኬሃ ሳማረ አይ ባጋኔ ቢ በንቴዝ ናአይ ባጋ ኦድዛ ታርካይ፥ ሉቃሳ ዎንግለ አዳይድ በንትዝ ታርከ። ሉቃሳ ዎንግላይድ ጋጻፕ ጋጻ ሄሎዳይስ የዝ ዋና ቆፋይ ዎሳ ባጋ፥ ጌሻ አያና ባጋ፥ የሱሳ ኦሶ ጋንጨ ማችታይስ የዝ አቆኔ ጾሲ ናጋራ ማርዛያ ማቀዛያ።</para>
  <para style="iot">ሉቃሳ ዎንግላይ አይኬዝ ቆፍታ</para>
  <para style="io1">ገሎ <char style="ior"><ref loc="LUK 1:1-4">1:1-4</ref> </char></para>
  <para style="io1">ጻማቅዛ ዋንሳኔ የሱሳ የልንቶ <char style="ior"><ref loc="LUK 1:5-2:52">1:5—2:52</ref> </char></para>
  <para style="io1">ጻማቅዛ ዋንሳ ኦሳ <char style="ior"><ref loc="LUK 3:1-20">3:1-20</ref> </char></para>
  <para style="io1">የሱሳ ጻማቅንታኔ ፓጭንታ <char style="ior"><ref loc="LUK 3:21-4:13">3:21—4:13</ref> </char></para>
  <para style="io1">የሱሳ ጋልላ ኦዝ ኦሶ <char style="ior"><ref loc="LUK 4:14-9:50">4:14—9:50</ref> </char></para>
  <para style="io1">ጋልላፐ የሩሳላመ ሄሎዳይስ <char style="ior"><ref loc="LUK 9:51-19:27">9:51—19:27</ref> </char></para>
  <para style="io1">ዉርስ ሳምንታ የሩሳላመ ሄራ <char style="ior"><ref loc="LUK 19:28-23:56">19:28—23:56</ref> </char></para>
  <para style="io1">Ꮊይቆፕ ደንዶ፥ አስስ በንትኔ ሳሎ ቅቶ <char style="ior"><ref loc="LUK 24:1-53">24:1-53</ref> </char></para>
  <chapter number="1" style="c" sid="LUK 1"/>
  <para style="p">
    <verse number="1" style="v" sid="LUK 1:1"/>ቦንቾ ቶፍሎሳ፥ ኑ ጋንጨ ፖልንቴዝ ባዛ ጋምታይ፥ ፓስ ዳንዳእንቴዛይ ጋርክ ጻፌዛ። <verse eid="LUK 1:1"/><verse number="2" style="v" sid="LUK 1:2"/>የ ታርካ ኡ ጻፌዛይ ቲናፕ አይኪ ኣፈ ማርክታይኔ ቃላ ኦዲ ማድዝታይ ኑስ ኦዴዛ። <verse eid="LUK 1:2"/><verse number="3" style="v" sid="LUK 1:3"/>ታካ ታ ባጋር ቲናፕ አካኪ በኤዛይፕ ጉየ የ ታርካይ ሀና ሎእ ኔስ ቶፍሎሳስ ጻፋይ ታስ ሎኦ ማቂ በንቴዛ። <verse eid="LUK 1:3"/><verse number="4" style="v" sid="LUK 1:4"/>የይካ፥ ነ ታማሬዝ ባዛይ ቱማ ማቄዛና ኤርሶዳይሲ።<verse eid="LUK 1:4"/></para>
  <para style="s1">ጻማቅዛ ዋንሳ የልንቶ</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 1:5"/>ይሁዳ ካት ሄሮዶሳ ዎደ አብያ ባጋፕ ማቄዝ ዛክሬሳ ግዝ አይሁደ ቄሳይ የዛ። ኤ ማቻታካ ኣሮና ሼሽፐ። እ ሱንይካ ኤልሳቤጾ።<note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="1CH 24:10">1ዜና. 24:10</ref></char></note> <verse eid="LUK 1:5"/><verse number="6" style="v" sid="LUK 1:6"/>ናምአይካ ጎዳይ ዎጋኔ አዛዛ ኡባ ናጊ ቦርሶ ባይ ጾስ ቲና ጽሎትር የዝዛ። <verse eid="LUK 1:6"/><verse number="7" style="v" sid="LUK 1:7"/>ኤልሳቤጻ ን ማቄዝ ግሾ ኡንትስ ናአ ባያ። ናምአይካ ጭሜዛ።<verse eid="LUK 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 1:8"/>ፐቲ ጋላስ ዛክሬሳ ፋ ታራር ጾስ ቲና ቄሰት ኦዛ። <verse eid="LUK 1:8"/><verse number="9" style="v" sid="LUK 1:9"/>ቄሰት ዎጋር ጾስ ካራ ገሊ እጻኔ ጩይሾዳይስ ኤዛ እጻ ሄሌዛ። <verse eid="LUK 1:9"/><verse number="10" style="v" sid="LUK 1:10"/>ኤ እጻኔ ጩይሾዳር አሳይ ባለ ኤቂ ዎስዛ።<verse eid="LUK 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 1:11"/>ጎዳይ ኪታንቻይ ያርሾ ያርሽዛ አቃይፕ ኡሻች ባጋር ኤቂ በንቴዛ። <verse eid="LUK 1:11"/><verse number="12" style="v" sid="LUK 1:12"/>ዛክሬሳ ኪታንቻና ብኢ ዳጋሚ ኢታ ያሽቲ ፖኬዛ። <verse eid="LUK 1:12"/><verse number="13" style="v" sid="LUK 1:13"/>ዝን ኪታንቻይ ኤኮ፥ «ዛክሬሳ ያሽትፐ፤ ነ ዎሳይ ስንቴዛ። ነ ማቻት ኤልሳቤጻ ራ ናአ የሎዳ፥ ኤ ሱንካ ነ ዋንሳ ጎዳ። <verse eid="LUK 1:13"/><verse number="14" style="v" sid="LUK 1:14"/>ኤ የልንታይ ኔስ ኡፋይስኔ ጊጋ ማቆዳ፤ ጋምታይ ኤ የልንታይድ ኡፋይቶዳ። <verse eid="LUK 1:14"/><verse number="15" style="v" sid="LUK 1:15"/>ጎዳይ ቲና ኤ ኡባይፕ ግታ ማቆዳ፤ ዎይነ ኡሺ ማቅን ሀራ ማስዝ ኡሺ ኡዣሚ። ፋ እንዳት ኡሎ የዛር ጌሻ አያናር ኩሞዳ።<note caller="-" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="NUM 6:3">ታይ. 6:3</ref></char></note> <verse eid="LUK 1:15"/><verse number="16" style="v" sid="LUK 1:16"/>እስሬለ አስታይፕ ጋምታ ኡ ጎዳ ጾሳይኮ ማሆዳ። <verse eid="LUK 1:16"/><verse number="17" style="v" sid="LUK 1:17"/>አድታይ ዎዝና ናእታይኮ ማሆዳ፥ ኪትንቶዝታ ጽልታይ ኤጨትይኮ ማሆዳይ ጋርክ፥ ጎዳይስ ቤዝዛ አሳ ጊግሶዳይስ ኤላሳ አያናራኔ ዎልቃር ጎዳይ ቲናር Ꮊማዳ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">1:17 </char><char style="xt" closed="false"><ref loc="MAL 4:5-6">ሚል. 4:5-6</ref></char></note><verse eid="LUK 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 1:18"/>ዛክሬሳ ኪታንቻይኮ፥ «ታ የያ አባር ኤሮዴ? ታራኔ ታ ማቻትር ጭሜዛ» ዬጌዛ።<verse eid="LUK 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 1:19"/>ኪታንቻይ ማሂ፥ «ታ ጾስ ቲና ኤቅዛ ጋብሬለ። Ꮊ ምሽራቻ ኔስ ኦዶዳይስ ጾሳፕ ኪትንቴዛ።<note caller="-" style="x"><char style="xo" closed="false">1:19 </char><char style="xt" closed="false"><ref loc="DAN 8:16">ዳነ. 8:16</ref>፤ <ref loc="DAN 9:21">9:21</ref></char></note> <verse eid="LUK 1:19"/><verse number="20" style="v" sid="LUK 1:20"/>ይኬ፥ ዎዳይ ሄልን ፖልንትዛ ታ ቃላ ነ አማናም እጼዝ ግሾ Ꮊይ ፖልንቶድ ሄሎዳይስ ነ ሙመ ማቆዳ፥ ኦድንቶዳይስካ ዳንዳኣሚ» ዬጌዛ።<verse eid="LUK 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 1:21"/>የ ዎደ ዛክሬሳ ጾስ ካራ ገሊ ጋምኤዝ ግሾ አብ ሀኔዛኮ ግ አሳይ ባለ ናግታር ጋምኤዛ። <verse eid="LUK 1:21"/><verse number="22" style="v" sid="LUK 1:22"/>ኤ ባለ ከዚ ኡንታር ናሾዳይስ ዳንዳኤካያ። ኩሸር ማሊ ቤዞፐ አትን ኦድንቶዳይስ ዳንዳኦዛና ብኢ አቡካ በኤዛይ ጋርክ ቆፔዛ።<verse eid="LUK 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 1:23"/>ዛክሬሳ ያርሾ ዎዳ ዉርሲ ፋ ካራ ማቄዛ። <verse eid="LUK 1:23"/><verse number="24" style="v" sid="LUK 1:24"/>የይፐ ጉየ፥ ኤ ማቻት ኤልሳቤጻ ዎደጼዛ። እችን አግና ሙመ ኬፕ ከዘካዛር ጋምኤዛ። <verse eid="LUK 1:24"/><verse number="25" style="v" sid="LUK 1:25"/>እዛ፥ «ጎዳይ ፋ ማሮትይር ታ ቦርንታ አሳይ ጋንጨፕ ቃሮዳይስ ኮዪ Ꮊያ ኦዛ» ዬጌዛ።<verse eid="LUK 1:25"/></para>
  <para style="s1">የሱሳ የልንታይ ቲናቲ ኦድንቴዛ</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 1:26"/>ኤልሳቤጻ ዎደጽን ኡሱፑን አግናር፥ ጾሲ ኪታንቻ ጋብሬለና ጋልላ ቢታ የዝ ናዝረተ ካታማ ኪቴዛ። <verse eid="LUK 1:26"/><verse number="27" style="v" sid="LUK 1:27"/>ኤዚ ዉድርትኮ ዳዉተ ሼሻፕ ማቄዝ ዮሴፋ ግዝ አይስ ኡሽንቴዝ ማይራምኮ ኪትንቴዛ።<note caller="-" style="x"><char style="xo" closed="false">1:27 </char><char style="xt" closed="false"><ref loc="MAT 1:18">ማቶ. 1:18</ref></char></note> <verse eid="LUK 1:27"/><verse number="28" style="v" sid="LUK 1:28"/>ኪታንቻይ እዝኮ Ꮊንጊ፥ «ኣ ኬሃትር ኩሜዛኔ፥ ሳሮ ኔስ ማቆ፥ ጾስ ኔር የዛ» ዬጌዛ።<verse eid="LUK 1:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 1:29"/>ማይራማ ኤ ኦዳይድ ኢታ ዳጋሚ፥ «Ꮊይ ዋፋ ሳሮ» ግ ቆፔዛ። <verse eid="LUK 1:29"/><verse number="30" style="v" sid="LUK 1:30"/>ኪታንቻይ ማሂ፥ «ማይራመ፥ ያሽትፐ፤ ነ ጾስ ቲና ሳባ ደንጌዛ። <verse eid="LUK 1:30"/><verse number="31" style="v" sid="LUK 1:31"/>ይኬ ነ ዎደጾዳ ራ ናአ የሎዳ፥ ኤ ሱንካ የሱሳ ግ ሱንዳ።<note caller="-" style="x"><char style="xo" closed="false">1:31 </char><char style="xt" closed="false"><ref loc="MAT 1:21">ማቶ. 1:21</ref></char></note> <verse eid="LUK 1:31"/><verse number="32" style="v" sid="LUK 1:32"/>ኤ ግታ ማቆዳ፥ ኡባይፕ ኣ ጾስ ናአ ግንትንቲ ጼግንቶዳ። ጾሳይ ኤ አዳይ ዳዉተ ዙፋና ኤስ እንጎዳ።<note caller="-" style="x"><char style="xo" closed="false">1:32-33 </char><char style="xt" closed="false"><ref loc="2SA 7:12-13">2ሳም. 7:12-13</ref>፥ <ref loc="2SA 7:16">16</ref>፤ <ref loc="ISA 9:7">ኢሳ. 9:7</ref></char></note> <verse eid="LUK 1:32"/><verse number="33" style="v" sid="LUK 1:33"/>ኤ ያይቆባ ሼሻል አፋ መናስ ካዉቶዳ፤ ኤ ካተትይስ ዛዋ ባያ» ዬጌዛ።<verse eid="LUK 1:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 1:34"/>ማይራማ ኪታንቻይኮ፥ «ታ ራ ኤሮያ የይ ዋይዚ ሀኖዳይስ ዳንዳኤ?» ዬጌዛ።<verse eid="LUK 1:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 1:35"/>ኪታንቻይ ማሂ፥ «ጌሻ አያና ኔል አፋ ዎዳ፥ ኡባፕ ኣ ጾስ ዎልቃይ ኔል አፋ ኩያቶዳ። የይ ግሾ፥ የልንትዛ ናአይ ጌሻ፥ ጾስ ናአካ ግንትንቶዳ። <verse eid="LUK 1:35"/><verse number="36" style="v" sid="LUK 1:36"/>ይኬ፥ ነ ዳባት ኤልሳቤጻ ፋ ጭማት ላይር ራ ናአ ዎደጼዛ። እዛ ን ግንትንቴዛኖ፥ ዝን Ꮊተ ኡሱፑን አግና አይኬዛ። <verse eid="LUK 1:36"/><verse number="37" style="v" sid="LUK 1:37"/>ጾሳ ጋምዝባዝ ባያ»<note caller="-" style="x"><char style="xo" closed="false">1:37 </char><char style="xt" closed="false"><ref loc="GEN 18:14">መ. 18:14</ref></char></note> ዬጌዛ።<verse eid="LUK 1:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 1:38"/>ማይራማ፥ «ዬዛኮ፥ ታስ ጎዳይ አይላትስ፥ ነ ቃላይ ጋርክ ሀኖ» ዬጌዛ። የይፐ ጉየ፥ ኪታንቻይ ኢፐ ሻክንቴዛ። <verse eid="LUK 1:38"/><verse number="39" style="v" sid="LUK 1:39"/>ማይራማ የ ሳምንታተ ደንዲ ይሁዳ ቢታ የዝ ፐቲ ገዘ ካታማ Ꮊንጌዛ። <verse eid="LUK 1:39"/><verse number="40" style="v" sid="LUK 1:40"/>ዛክሬሳ ካራ ገሊ ኤልሳቤጾ ሳሮዛ። <verse eid="LUK 1:40"/><verse number="41" style="v" sid="LUK 1:41"/>ኤልሳቤጻ ማይራሚ ሳሮ ስኤዛን ጋርክ እኡሎ የዝ ናአይ ኡፋይሳር ዶንጌዛ። ኤልሳቤጻ ጌሻ አያናር ኩሚ፥ <verse eid="LUK 1:41"/><verse number="42" style="v" sid="LUK 1:42"/>ፋ ቃላ ቅ ኡዲ፥ «ኔኒ ማችታይ ጋንጨፐ አንጅንቴዛኖ፥ ነ ዎደጼዝ ናአይካ አንጅንቴዛያ። <verse eid="LUK 1:42"/><verse number="43" style="v" sid="LUK 1:43"/>ሀኖ ዝን፥ ታ ጎዳይ እንዳቴ፥ ነ ታኮ የኦዳይስ ታ ኦኖ? <verse eid="LUK 1:43"/><verse number="44" style="v" sid="LUK 1:44"/>ዬዛኮ ነ ሳሮ ታ ስእን ታ ኡሎ የዝ ናአይ ኡፋይሳር ዶንጌዛ። <verse eid="LUK 1:44"/><verse number="45" style="v" sid="LUK 1:45"/>ጎዳይ ፖሎድ ግ እንጌዝ ቃላ አማኔዛና፥ እዛ አንጅቴዛኖ» ዬጌዛ።<verse eid="LUK 1:45"/></para>
  <para style="s1">ማይራሚ ጋላታ ማዝሙረ</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 1:46"/>ማይራማ Ꮊይ ጋርክ ዬጌዛ፦</para>
  <para style="q1" vid="LUK 1:46">«ታ ሸምፓታ ጎዳ ቦንቼዛ፥<note caller="-" style="x"><char style="xo" closed="false">1:46-55 </char><char style="xt" closed="false"><ref loc="1SA 2:1-10">1ሳም. 2:1-10</ref></char></note><verse eid="LUK 1:46"/></para>
  <para style="q2">
    <verse number="47" style="v" sid="LUK 1:47"/>ታ አያናይ ታ ለ ጾሳይል ኡፋይትዛ።<verse eid="LUK 1:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="LUK 1:48"/>ኤ ፋ አይላቲ ካዉሻት በኤዛ።</para>
  <para style="q1" vid="LUK 1:48">Ꮊይኖፐ አይኪ የለት ኡባይ ታና አንጅቴዛኖ ጎዳ።<note caller="-" style="x"><char style="xo" closed="false">1:48 </char><char style="xt" closed="false"><ref loc="1SA 1:11">1ሳም. 1:11</ref></char></note><verse eid="LUK 1:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="LUK 1:49"/>ዎልቃማ ማቄዝ ኤ፥ ታስ ዳማባዝ ኦዛ።</para>
  <para style="q1" vid="LUK 1:49">ኤ ሱንይካ ጌሻ።<verse eid="LUK 1:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="LUK 1:50"/>ኤዛ ቦንችዝታይል አፋ፥</para>
  <para style="q2" vid="LUK 1:50">ኤ ማሮትይ መናፕ መና ሄሎዳይስ የዝዛ።<verse eid="LUK 1:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="LUK 1:51"/>ፋ ሚን ቀሳይር ፋ ዎልቃ ቤዜዛ፥</para>
  <para style="q2" vid="LUK 1:51">ፋ ዎዝናር ኡትርትዝታ ላሌዛ።<verse eid="LUK 1:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="LUK 1:52"/>ዎልቃንዛ ካትታ ኡ ዙፋናይፕ ዎሴዛ፤</para>
  <para style="q2" vid="LUK 1:52">ፋና ቶቼዝታ ቅ ኡዴዛ።<note caller="-" style="x"><char style="xo" closed="false">1:52 </char><char style="xt" closed="false"><ref loc="JOB 5:11">ኢዮ. 5:11</ref>፤ <ref loc="JOB 12:19">12:19</ref></char></note><verse eid="LUK 1:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="LUK 1:53"/>ናይንቴዝታ ሎኦ ባዛር ምሼዛ፥</para>
  <para style="q2" vid="LUK 1:53">ዱርታ ካሎ ኩሸ ዳኬዛ።<verse eid="LUK 1:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="LUK 1:54"/>ፋ ማሮት ቆፒ፥</para>
  <para style="q2" vid="LUK 1:54">ፋ አይላ እስሬለ ማዴዛ።<verse eid="LUK 1:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="LUK 1:55"/>የይካ ኑ አድታይስ ኦዴዝ ቃላ፥</para>
  <para style="q2" vid="LUK 1:55">አፍራመስኔ ኤ ሼሻይስ ጌዛና መናስ ፖሎዳይሲ»<note caller="-" style="x"><char style="xo" closed="false">1:55 </char><char style="xt" closed="false"><ref loc="GEN 17:7">መ. 17:7</ref></char></note></para>
  <para style="m" vid="LUK 1:55">ዬጌዛ።<verse eid="LUK 1:55"/></para>
  <para style="p">
    <verse number="56" style="v" sid="LUK 1:56"/>ማይራማ ኤልሳቤጽ ላንቀ ሀይ አግና ጋምኢ ፋ ካራ ማቄዛ።<verse eid="LUK 1:56"/></para>
  <para style="s1">ጻማቅዛ ዋንሳ የልንቶ</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 1:57"/>ኤልሳቤጽስ የሎ ቃማይ ሄልን ራ ናአ የሌዛ። <verse eid="LUK 1:57"/><verse number="58" style="v" sid="LUK 1:58"/>እ ሾርታይኔ እ ዳብታይ ጎዳይ ጋመ ማሮት ኦዛና ስኢ፥ እዝር ዎላ ኡፋይቴዛ። <verse eid="LUK 1:58"/><verse number="59" style="v" sid="LUK 1:59"/>ሆስፑን ጋላስ ዱደ ናአና ዶካሎዳይስ የኤዛ። ናአና አዳይ ሱንይር ዛክሬሳ ግ ጼጎዳይስ ኮዬዛ።<note caller="-" style="x"><char style="xo" closed="false">1:59 </char><char style="xt" closed="false"><ref loc="LEV 12:3">ለዊ. 12:3</ref></char></note> <verse eid="LUK 1:59"/><verse number="60" style="v" sid="LUK 1:60"/>ዝን እንዳት፥ «የይ ሀነና ዋንሳ ጊንትንቶዳይስ ቤዝዛ» ዬጌዛ። <verse eid="LUK 1:60"/><verse number="61" style="v" sid="LUK 1:61"/>ኡንትካ፥ «ነ ዳብታይፕ Ꮊ ሱንይር ጼግንቴዛይ ኦንካ ባያ» ዬጌዛ። <verse eid="LUK 1:61"/><verse number="62" style="v" sid="LUK 1:62"/>ኤ አዳይ ኦና ግ ሱን ጋዶዳዛኮ ኤሮዳይስ ኮዢ ኤዛ ማላር ኦይጬዛ። <verse eid="LUK 1:62"/><verse number="63" style="v" sid="LUK 1:63"/>ኤ ጻፍዛ ባዝ ኦይጪ ኤኪ፥ «ኤ ሱንይ ዋንሳ» ግ ጻፌዛ። ኡባይ ኤ ጻፈዛና ብኢ ማላባዝ ጌዛ።<verse eid="LUK 1:63"/></para>
  <para style="p">
    <verse number="64" style="v" sid="LUK 1:64"/>እዝር ዛክሬሳ እራንይ ብልንቴዛ፥ ጾስ ጋላትታር ኦድንቶ አይኬዛ። <verse eid="LUK 1:64"/><verse number="65" style="v" sid="LUK 1:65"/>ሾርታይ ኡቢታይ ያሻር ኩሜዛ። Ꮊ ሀኔዝባዛይ ቅ ጌዝ ይሁዳ ጋደ ኡባይድ ኦድንቴዛ። <verse eid="LUK 1:65"/><verse number="66" style="v" sid="LUK 1:66"/>የያ ስኤዝ ኡባይ፥ «Ꮊ ናአይ አብ ሀኖደሻ» ግ ዎል ጋንጨ ኦድንቴዛ። ጎዳይ ኩሻይ ኤዛር የዛ።<verse eid="LUK 1:66"/></para>
  <para style="s1">ዛክሬሳ ትንቢተ</para>
  <para style="p">
    <verse number="67" style="v" sid="LUK 1:67"/>ዋንሳ አዳይ ዛክሬሳ ጌሻ አያናር ኩሚ Ꮊይ ጋርክ ዬጊ ትንቢተ ኦዴዛ።<verse eid="LUK 1:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="LUK 1:68"/>«እስሬለ ጎዳይ ጾሳይ ጋላትንቶ፥</para>
  <para style="q2" vid="LUK 1:68">ይኢ ፋ አሳ ዎዜዛ።<verse eid="LUK 1:68"/></para>
  <para style="q1">
    <verse number="69" style="v" sid="LUK 1:69"/>ፋ አይላይ ዳዉተ ካራ</para>
  <para style="q2" vid="LUK 1:69">አቶት ካጨ ደንዛ።<verse eid="LUK 1:69"/></para>
  <para style="q1">
    <verse number="70" style="v" sid="LUK 1:70"/>የይካ ብኒ ዎደ ጌሻ ናብታይ ዶናይድ ኦድንቴዛይ ጋርክ፥<verse eid="LUK 1:70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="LUK 1:71"/>ኤዚ ኑና ኑ ሞርክታይፐኔ</para>
  <para style="q2" vid="LUK 1:71">ኑር ኤቅንትዛ ኡቢታይ ኩሸፐ አሾዳ።<verse eid="LUK 1:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="LUK 1:72"/>የያ ኤ ኦዛይ ኑ አድታይስ ፋ ማሮት ቤዞዳይስኔ፥</para>
  <para style="q2" vid="LUK 1:72">ፋ ጌሻ ጫቃ ናጎዳይስ።<verse eid="LUK 1:72"/></para>
  <para style="q1">
    <verse number="73" style="v" sid="LUK 1:73"/>ኑ አዳ አፍራመስ ጫቄዝ</para>
  <para style="q2" vid="LUK 1:73">ጫቃ ቆፖዳይስኔ፥<verse eid="LUK 1:73"/></para>
  <para style="q1">
    <verse number="74" style="v" sid="LUK 1:74"/>ኑ ሞርክታይ ኩሸፕ ከሲ፥</para>
  <para style="q2" vid="LUK 1:74">ያሻ ባይ ኤዝስ ኦዳይ ጋርከሲ።<verse eid="LUK 1:74"/></para>
  <para style="q1">
    <verse number="75" style="v" sid="LUK 1:75"/>ኑ ላይ ኡባይድ ጌሸትራኔ ጽሎትር</para>
  <para style="q2" vid="LUK 1:75">ፋ ቲና ኑና ኤሶዳይሲ።<verse eid="LUK 1:75"/></para>
  <para style="q1">
    <verse number="76" style="v" sid="LUK 1:76"/>ማ ታ ናአዮ፥ ነ ኡባፕ ኣ ጾስ ናበ ግንትንቶዳ።<note caller="-" style="x"><char style="xo" closed="false">1:76 </char><char style="xt" closed="false"><ref loc="MAL 3:1">ሚል. 3:1</ref></char></note></para>
  <para style="q1" vid="LUK 1:76">ጎዳይስ ኦገ ሎይዳይስ ነ ኤ ቲና Ꮊማዳ።<verse eid="LUK 1:76"/></para>
  <para style="q1">
    <verse number="77" style="v" sid="LUK 1:77"/>ኡንቲ አቶት ኤረት ደማዳና፥ ኡ ናጋራይ አቶ ግንትንትን፥</para>
  <para style="q2" vid="LUK 1:77">ነ ጎዳይ ዎያይስ ኦዶዳ።<verse eid="LUK 1:77"/></para>
  <para style="q1">
    <verse number="78" style="v" sid="LUK 1:78"/>ኑ ጾሳይ ፋ ኬሃ ማሮትይር</para>
  <para style="q2" vid="LUK 1:78">ዎንታ ጻልቀ ኑስ ሳሎፕ ከሶዳ።<verse eid="LUK 1:78"/></para>
  <para style="q1">
    <verse number="79" style="v" sid="LUK 1:79"/>የይካ ማ ጋንጨኔ፥</para>
  <para style="q2" vid="LUK 1:79">Ꮊይቆ ኩያ ኦሞ የዝታይስ ፖእሶዳይስ፥</para>
  <para style="q2" vid="LUK 1:79">ኑ ቶካካ ሳሮ ኦገኮ ማሆዳ»</para>
  <para style="m" vid="LUK 1:79">ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">1:79 </char><char style="xt" closed="false"><ref loc="ISA 9:2">ኢሳ. 9:2</ref></char></note><verse eid="LUK 1:79"/></para>
  <para style="p">
    <verse number="80" style="v" sid="LUK 1:80"/>ናአይካ ድጬዛ፥ አያናራካ ሚንጌዛ፥ እስሬለ አሳይስ በንቶድ ጋ ሊዦ ደምባ የዜዛ።<verse eid="LUK 1:80"/></para>
  <chapter eid="LUK 1"/>
  <chapter number="2" style="c" sid="LUK 2"/>
  <para style="s1">የሱስ ክርስቶሳ የልንቶ</para>
  <para style="r">(<ref loc="MAT 1:18-25">ማቶ. 1:18-25</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 2:1"/>የ ዎደ ኦሮመ ቢታ የዝ አስ ኡቢታይ ታይብንቶድ ጋርከኔ ሱንይ ጻፍንቶድ ጋርክ ካት አዉግስጾሳ አዛዜዛ። <verse eid="LUK 2:1"/><verse number="2" style="v" sid="LUK 2:2"/>የይካ ቀረኖሳ ሶረ ቢታ አቅስዛ ዎደ ሀኔዝ ቲና ዎያ ታይባ። <verse eid="LUK 2:2"/><verse number="3" style="v" sid="LUK 2:3"/>የይ ግሾስ፥ ፐቲ ፐቲ አሲ ፋ ሱን ጻፍሶዳይስ ፋ የልንቴዝ ቢታ Ꮊንጌዛ።<verse eid="LUK 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 2:4"/>ዮሴፋካ ዳዉተ ካራፐኔ ኮቻፕ ማቄዝ ግሾስ ጋልላ ናዝረተ ካታማፕ ደንዲ ዳዉተ ካታማ ግንትዝ ቤተለመ Ꮊንጌዛ። <verse eid="LUK 2:4"/><verse number="5" style="v" sid="LUK 2:5"/>ኤ ኦይጪ ጋዴዝ ዎልቃ ኢታ፥ ማይራምር ዎላ ጻፍንቶዳይስ Ꮊንጌዛ። <verse eid="LUK 2:5"/><verse number="6" style="v" sid="LUK 2:6"/>ኡንትካ ኤዛይድ የዝን ኢስ የሎ ዎደ ሄሌዛ። <verse eid="LUK 2:6"/><verse number="7" style="v" sid="LUK 2:7"/>ፋ ባይራ ናአ የሌዛ። ቃንጾራ ጻጺ እማ አቅዛ አቆ አቆ ቤዝ ግሾስ መሄ ጋላ ሙዝዝ ጎና ጋንጨ ዎይዛ።<verse eid="LUK 2:7"/></para>
  <para style="s1">መሄ ሄንግዝታኔ ኪታንችታ</para>
  <para style="r">(<ref loc="MAT 1:18-25">ማቶ. 1:18-25</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 2:8"/>የ ጋዳይድ ቃማ ዉደ ሄንግታር ቃኤል አቅዝ መሄ ሄንግዝታይ የዛ። <verse eid="LUK 2:8"/><verse number="9" style="v" sid="LUK 2:9"/>ጎዳ ኪታንቻይ ይኢ ኡንትስ በንቴዛ። ጎዳይ ቦንቾ ፖአይ ኡ ላንቃይር ፖኤዛ፤ ኡንትካ ዎልቃማ ያሻ ያሽቴዛ። <verse eid="LUK 2:9"/><verse number="10" style="v" sid="LUK 2:10"/>ኪታንቻይ ኡንትኮ፥ «ያሽትፓተ! ይኬ አስ ኡባይስ ማቅዝ ግታ ኡፋይሳ ምሽራቾ ታ ኤኪ የኤዛ። <verse eid="LUK 2:10"/><verse number="11" style="v" sid="LUK 2:11"/>የይካ፥ ዳዉተ ካታማ አሽዛይ ይንትስ Ꮊይኖ የልንቴዛ። ኤ ጎዳ ክርስቶሳ። <verse eid="LUK 2:11"/><verse number="12" style="v" sid="LUK 2:12"/>የይስካ ማላይ Ꮊያ። ጽቃ ናአይ ቃንጾር ጻጽንቲ ጎና ጋንጨ ዎይኤዛና ይ ደማዳ» ዬጌዛ።<verse eid="LUK 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 2:13"/>ቆፐካዝን ጋመ ሳሎ ኪታንችታይ ኪታንቻይር ዎላ በንቲ፥ ጾሳ ጋላትታር፥<verse eid="LUK 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LUK 2:14"/>«ቦንቾ ጾስስ ቀ ሳሎ፥</para>
  <para style="q2" vid="LUK 2:14">ሳሮ ቢታል አፋ ጾሲ ቃዛ አሳይስ ማቆ» ዬጌዛ።<verse eid="LUK 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 2:15"/>ኪታንችታይ ኡንታፕ ሻክንቲ ሳሎ ከዜዛይፕ ጉየ መሄ ሄንግዝታይ፥ «አን ጎዳይ ኑስ ቆንጭሴዝ ባዛኔ ሀኔዝ ባዛ በአዳይስ ቤተለመ ዎላ Ꮊማዳ» ዬጌዛ።<verse eid="LUK 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 2:16"/>ኡንትካ ኤልሲ Ꮊንጌዛ። ማይራሞ፥ ዮሴፋ፥ የይፐ ጽቃ ናአይ ጎና ጋንጨ ዎይኤዛ ደንጌዛ። <verse eid="LUK 2:16"/><verse number="17" style="v" sid="LUK 2:17"/>ብኢ ማቂ ናአይ ባጋ ኡንትስ ኦድንቴዛና የ አቃይድ የዝ አሳይስ ጌሺ ኦዴዛ። <verse eid="LUK 2:17"/><verse number="18" style="v" sid="LUK 2:18"/>የያ ስኤዝ ኡባይ መሄ ሄንግዝታይ ኦዴዝ ኦዳ ማላባዝ ጌዛ። <verse eid="LUK 2:18"/><verse number="19" style="v" sid="LUK 2:19"/>ማይራማ ሀኔዝባዛ ኡባ ፋ ዎዝናር ቆፕታር የዛ። <verse eid="LUK 2:19"/><verse number="20" style="v" sid="LUK 2:20"/>መሄ ሄንግዝታይ ኡንትስ ኦድንቴዛይ ጋርክ ሀንን በኤዛ። የይ ግሾ፥ ኡ ፋ ስኤዝ ባዝስኔ በኤዝ ባዝ ኡባይስ ጾሳ ቦንችታራኔ ጋላትታር ማቄዛ።<verse eid="LUK 2:20"/></para>
  <para style="s1">የሱሳና ጾስ ካራ ካንጌዛ</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 2:21"/>ሆስፑን ጋላስ፥ ዶካልንቶዳይስ ቃማ ሄልን፥ ኤዛ ዎደጾዳይፕ ቲና ኪታንቻይ ጋዴዝ ሱንይር የሱሳ ግንቴዛ።<note caller="-" style="x"><char style="xo" closed="false">2:21 </char><char style="xt" closed="false"><ref loc="LEV 12:3">ለዊ. 12:3</ref>፤ <ref loc="LUK 1:3">ሉቃ. 1:3</ref></char></note> <verse eid="LUK 2:21"/><verse number="22" style="v" sid="LUK 2:22"/>ሙሰ ህጋይ ጋርክ ኡንቲ ሻግሸ ዎደ ፖልንቴዛይፕ ጉየ ዮሰፋራኔ ማይራምር ናአ ፋ ጎዳይስ እማዳይስ የሩሳላመ Ꮊንጌዛ።<note caller="-" style="x"><char style="xo" closed="false">2:22-24 </char><char style="xt" closed="false"><ref loc="LEV 12:6-8">ለዊ. 12:6-8</ref></char></note> <verse eid="LUK 2:22"/><verse number="23" style="v" sid="LUK 2:23"/>የይካ፥ ጎዳይ ህጋይድ፥ «ራ ማቄዝ ባይራ ናአ ኡባይ ጎዳይስ ሻክንቴዛ ማቆ» ዬግንቲ ጻፍንቴዛይ ፖሎዳይሲ።<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="EXO 13:2">ከስ 13:2</ref>፥ <ref loc="EXO 13:12">12</ref></char></note> <verse eid="LUK 2:23"/><verse number="24" style="v" sid="LUK 2:24"/>ማ ጎዳይ ህጋይድ፥ ናምኢ ሄሮ ዎይ ሆሌ ጌዛይ ጋርክ ያርሾዳይስ ካንጌዛ። <verse eid="LUK 2:24"/><verse number="25" style="v" sid="LUK 2:25"/>የ ዎደ ጌሽኔ አማኖር ሚን ማቄዝ ስሞና ግንትንትዝ አይ የሩሳላመ የዛ። ኤ እስሬልታይ አቶት ናግታር የዛ። ጌሻ ኣያናይካ ኤዛል አፋ የዛ። <verse eid="LUK 2:25"/><verse number="26" style="v" sid="LUK 2:26"/>ማ ጾሲ ዶሬዝ ክርስቶሳ በኤካዛር Ꮊይቃማና ጌሻ አያናይ ኤስ ቤዝን ኤሪ የዛ። <verse eid="LUK 2:26"/><verse number="27" style="v" sid="LUK 2:27"/>ኤዛ የ ጋላስ አያና ካልን ጾስ ካራ Ꮊንጌዛ። አዳይራኔ እንዳትራ ዎጋ ፖሎዳይስ ናአና ኤኪ ገሌዝ ዎደ <verse eid="LUK 2:27"/><verse number="28" style="v" sid="LUK 2:28"/>ስሞና ሞኪ ኤኪ ናአና እድንጊ፥ ጾሳ ጋላትታር።<verse eid="LUK 2:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="LUK 2:29"/>«ጎዳዮ ነ ታስ ገሌዝ ቃላይ ጋርክ፥</para>
  <para style="q2" vid="LUK 2:29">Ꮊተ ነ አይላ ሳሮ ሞይዞባ።<verse eid="LUK 2:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="LUK 2:30"/>ታ ኣፋይ አስ ኡባይ ቲና ነ ጊግሴዝ፥<verse eid="LUK 2:30"/></para>
  <para style="q2">
    <verse number="31" style="v" sid="LUK 2:31"/>ነ አቶት በኤዛ።<verse eid="LUK 2:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="LUK 2:32"/>የይካ አይሁደ ባ አስ ኡባይስ፥</para>
  <para style="q2" vid="LUK 2:32">ጾስ ቱማት ቤዝዛ ፖኦ፥</para>
  <para style="q2" vid="LUK 2:32">ነ አሳይስ እስራኤልታይስካ ቦንቾ»</para>
  <para style="m" vid="LUK 2:32">ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">2:32 </char><char style="xt" closed="false"><ref loc="ISA 42:6">ኢሳ. 42:6</ref>፤ <ref loc="ISA 49:6">49:6</ref>፤ <ref loc="ISA 52:10">52:10</ref></char></note><verse eid="LUK 2:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 2:33"/>ዮሰፋራኔ ማይራምራ ኤ ባጋ ኦድንቴዛና ማላባዝ ጌዛ። <verse eid="LUK 2:33"/><verse number="34" style="v" sid="LUK 2:34"/>ስሞና ኡንታን አንጄዛ። እንዳትኮ ማይራምኮ፥ «እስሬለ የዝ ጋምታይስ ኡ ፖክይስኔ ደንዳይስ ጾሳፕ ዶርንቴዛ። ማ እጽዝታይስ ማላ ማቃዳ <verse eid="LUK 2:34"/><verse number="35" style="v" sid="LUK 2:35"/>ነ ሸምፓይራካ አዛኖ ማሻ ኣዳ» ይኬ ጋመ አሳይ ዎዛና ጌሜዝ ቆፋይ በንቶዳይ ጋርክ የያ ጌዛ። <verse eid="LUK 2:35"/><verse number="36" style="v" sid="LUK 2:36"/>ማ አሴረ ኮቻፕ ማቄዝ ፋኑኤላ ናአታ ሃና ግንትንትዝ ናባታ የዛ። እዛ ኢታ ጭሜዛ፤ እዛ ፋ አዝናይር ላፑን ላይ በቴዛ። <verse eid="LUK 2:36"/><verse number="37" style="v" sid="LUK 2:37"/>እ አዝናይ Ꮊይቂን ሆስፑን ታማኔ ኦይዲ ላይ ማቆድ ጋ ቃማኔ ጋላስ ፓጨ ባይ ዎሳራኔ ጾማር ጾስ ኬ ኦዛ። <verse eid="LUK 2:37"/><verse number="38" style="v" sid="LUK 2:38"/>እዛ የ ሳታይድ Ꮊንጊ ጾሳ ጋላቴዛ፤ የሩሳላመ ዎዝንታ ናግዛ ኡባይስ ናአይ ባጋ ማርካቴዛ። <verse eid="LUK 2:38"/><verse number="39" style="v" sid="LUK 2:39"/>ዮሰፋራኔ ማይራምራ ጎዳይ ህጋይድ አዛዝንቴዝ ዎጋ ኡብታ ፖሌዛይፕ ጉየ ጋልላ ቢታ የዝ ፋ ካታማ ናዝረተ ማቄዛ።<note caller="-" style="x"><char style="xo" closed="false">2:39 </char><char style="xt" closed="false"><ref loc="MAT 2:23">ማቶ. 2:23</ref></char></note> <verse eid="LUK 2:39"/><verse number="40" style="v" sid="LUK 2:40"/>ናአይ ድጭታራኔ አያናር ምንግታር Ꮊንጌዛ። ኤጨትር ኩሜዛ፤ ጾስ ኣ ኬሄትይ ኤዛል አፋ የዛ።<verse eid="LUK 2:40"/></para>
  <para style="s1">የሱሳ ጾስ ኬ Ꮊንጌዛ</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 2:41"/>ዮሰፋራኔ ማይራምር ፋዝቃ ባለ ቦንቾዳይስ ላይር ላይር የሩሳላመ Ꮊንግዛ።<note caller="-" style="x"><char style="xo" closed="false">2:41 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">ከስ 12:1-27</ref>፤ <ref loc="DEU 16:1-8">ናምእ. 16:1-8</ref></char></note> <verse eid="LUK 2:41"/><verse number="42" style="v" sid="LUK 2:42"/>የሱሳስ ታጶ ናምኢ ላይ ማቄዝ ዎደ ካሰፕ ኦዛይ ጋርክ ባላ ቦንቾዳይስ Ꮊንጌዛ። <verse eid="LUK 2:42"/><verse number="43" style="v" sid="LUK 2:43"/>ባላ ቦንቼዛይፕ ጉየ ካራ ማቆዳር ናአይ የሱሳ የሩሳላመ አቴዛ። ዝን ዮሰፋራኔ ማይራምር ኤ የሩሳላመ አቴዛና ኤረካያ። <verse eid="LUK 2:43"/><verse number="44" style="v" sid="LUK 2:44"/>ኤ ካራ ማቅዝ አሳይር ዎላ የዛ ኣዝን ኡንቲ ፐቲ ጋላሳ ኦገ Ꮊንጌዛ። ኤ ባዛና ኤሬዛይፕ ጉየ ፋ ዳብታይኔ ፋ ላግታይ ላንቀ ኮዬዛ። <verse eid="LUK 2:44"/><verse number="45" style="v" sid="LUK 2:45"/>ኤ ኤዛይድ ብን ኮይታር ጉየ የሩሳላመ ሄሎዳይስ Ꮊንጌዛ።<verse eid="LUK 2:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 2:46"/>ሀይ ጋላሳፕ ጉየ ጾስ ኬ አስታማርታይ ጋንጨ በቲ ኡ ኦድዛና ስእታራኔ ኡንታን ኦይጭታር የዝን ደንጌዛ። <verse eid="LUK 2:46"/><verse number="47" style="v" sid="LUK 2:47"/>ኤዛ ስእዝ ኡቢታይ ኤ አካካኔ ኤ ማህዝ ማልሳ ማላባዝ ጌዛ።<verse eid="LUK 2:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 2:48"/>ካራ አሳይ ኤዛ ደንጌዝ ዎደ Ꮊይ ማላባዝ ጌዛ። ኤ እንዳታካ፥ «ታ ናአዮ፥ አብስ ኑና Ꮊይ ጋርክ ኦኔ? ነ አዳይራኔ ታራ ነና ኮይታር ዳቡሬዛ» ዬጌዛ።<verse eid="LUK 2:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 2:49"/>የሱሳ ኡንትኮ፥ «ታና አብስ ኮዬ? ታ፥ ታ አዳይ ካራ የዞዳይስ ቤዝዛና ይ ኤሮሳ» ዬጌዛ። <verse eid="LUK 2:49"/><verse number="50" style="v" sid="LUK 2:50"/>ዝን ኤ ኡንትኮ ጌዛና ኡንቲ አካኬካያ።<verse eid="LUK 2:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 2:51"/>የይፐ ጉየ፥ ኡንታር ዎላ ናዝረተ ካታማ Ꮊንጌዛ። ኡንትስ ኪትንትታር የዜዛ። ኤ እንዳት የ ኡብታ ፋ ዎዛና ጋዲ ናጌዛ። <verse eid="LUK 2:51"/><verse number="52" style="v" sid="LUK 2:52"/>የሱሳ፥ ኤጨትር፥ ኤቃማር፥ ዴቴር ጾስ ቲናኔ አስ ቲና ድጬዛ።<note caller="-" style="x"><char style="xo" closed="false">2:52 </char><char style="xt" closed="false"><ref loc="1SA 2:26">1ሳም. 2:26</ref>፤ <ref loc="PRO 3:4">ኣዝ. 3:4</ref></char></note><verse eid="LUK 2:52"/></para>
  <chapter eid="LUK 2"/>
  <chapter number="3" style="c" sid="LUK 3"/>
  <para style="s1">ጻማቅዛ ዋንሳ ስብካተ</para>
  <para style="r">(<ref loc="MAT 3:1-12">ማቶ. 3:1-12</ref>፤ <ref loc="MRK 1:1-8">ማር. 1:1-8</ref>፤ <ref loc="JHN 1:19-28">ዋን. 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 3:1"/>ካታይ ጽባሮሳ ኦሮመ ቢታል ካዉትን፥ ታጶ እችን ላይር፥ ጰንጸ ጵላጾሳ ይሁዳ አቅስዛ ላይ ሄሮዶሳ ጋልላ አቅስዛ ላይ ኤ እሻ ፍልጶሳ ኢጹራሳኔ ጽራኮንዶሳ አቅስዛ ዎደ ልሳኖሳ አብላንሳና አቅስዛ ዎደ <verse eid="LUK 3:1"/><verse number="2" style="v" sid="LUK 3:2"/>ሃናራኔ ቃያፋራ ቄሰ ሀላቃ ማቂ የዝን፥ ጾስ ቃላይ ዛክሬሳ ናአ ዋንሳኮ ሊዦ ጋ የኤዛ። <figure style="fig" alt="High priest" file="HK00267B.tif" size="span" ref="3:2">ቄሰ ሃላቃ</figure> <verse eid="LUK 3:2"/><verse number="3" style="v" sid="LUK 3:3"/>ዋንሳ፥ «ይ ናጋራይፕ ማቆይታኔ ጻማቅንቶይታ። ጾሳይ ይ ናጋራ አቶ ጎዳ» ዬጊ ታማርስታር ዮርዳኖሳ ቦርካ ሄራ የዝ ቢታ ኡባ Ꮊንጌዛ። <verse eid="LUK 3:3"/><verse number="4" style="v" sid="LUK 3:4"/>የይካ ናበ ኢስያሳ ፋ ማጻፋይድ፥<note caller="-" style="x"><char style="xo" closed="false">3:4-6 </char><char style="xt" closed="false"><ref loc="ISA 40:3-5">ኢሳ. 40:3-5</ref></char></note></para>
  <para style="q1" vid="LUK 3:4">«ሊዦ ጋ ፋ ቃላ ቅ ኡዲ፥</para>
  <para style="q2" vid="LUK 3:4">ኡክዛ አይ ቃላይ፥</para>
  <para style="q1" vid="LUK 3:4">‹ጎዳይስ ኦገ ሎእይታ፥</para>
  <para style="q2" vid="LUK 3:4">ጎሳካ ፕድ ኡዶይታ።<verse eid="LUK 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LUK 3:5"/>ሎጳ ኡቢታይ ኩሞ፥</para>
  <para style="q2" vid="LUK 3:5">አምባይኔ ደራይ ዝቂ ጎ።</para>
  <para style="q1" vid="LUK 3:5">ዎቦ ኦጋይ ሉሎ፥</para>
  <para style="q2" vid="LUK 3:5">ጊገካ ጎሳይ ቅንጺ ጎ።<verse eid="LUK 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LUK 3:6"/>አሾ ማኤዝ አስ ኡብታይ፥</para>
  <para style="q2" vid="LUK 3:6">ጾሲ አሽዛና ቦኦ› »</para>
  <para style="m" vid="LUK 3:6">ግ ጻፍንቴዛይ ሀኔዛ።<verse eid="LUK 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 3:7"/>ዋንሳ፥ ኤ ኩሸ ጻማቅንቶዳይስ የኤዝ ጋመ አሳይኮ፥ «ይንታኖ፥ ሾሽ ናኡን የኦዳይስ የዝ ቦቻይፕ ቡቶድ ጋርክ ይንታን ዞሬዛይ ኦኖ?<note caller="-" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="MAT 12:34">ማቶ. 12:34</ref>፤ <ref loc="MAT 23:33">23:33</ref></char></note> <verse eid="LUK 3:7"/><verse number="8" style="v" sid="LUK 3:8"/>ይኬ፥ ይ ማቅ ቤዝዛ ሎኦ ኦሶ ኦይታ፥ ይ ዎዝናር፥ ‹ኑስ፥ ኑ አዳይ አፍራመ የዛ ግ ጋይርፓተ።› Ꮊና ስኦይታ፥ Ꮊ ሹችታይፕ ጾሳይ አፍራመስ ናአ ከሶዳይስ ዳንዳእዛ።<note caller="-" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="JHN 8:33">ዋን. 8:33</ref></char></note> <verse eid="LUK 3:8"/><verse number="9" style="v" sid="LUK 3:9"/>ዬዛኮ፥ ጋንደ ምንጻይስ ጻጳይድ የዛ። ይኬ፥ ሎኦ ኣፈ ኣፎዋ ም ኡቢታይ ጋችንቲ ታማ ጋንጨ ዎዳ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="MAT 7:19">ማቶ. 7:19</ref></char></note><verse eid="LUK 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 3:10"/>አሳይ፥ «የዝን ኑኒ አብ ኦ?» ዬጊ ኦይጬዛ።<verse eid="LUK 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 3:11"/>ዋንሳ ማሂ፥ «ናምኢ አፍላ የዛ አሲ ባዛይስ እንጎ። ካ የዛይ ባዛይስ ሻጎ» ዬጌዛ።<verse eid="LUK 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 3:12"/>ቃራጸ ጋችስዝታይ ጻማቅንቶዳይስ ይኢ፥ «አስታማራዮ፥ ኑ አብ ኡዶ?» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="LUK 7:29">ሉቃ. 7:29</ref></char></note><verse eid="LUK 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 3:13"/>ኤ ማሂ፥ «ይንታን ኪቴዛንፕ ኣ ኤክፓተ» ዬጌዛ። <verse eid="LUK 3:13"/><verse number="14" style="v" sid="LUK 3:14"/>ማ ዎታዳርታይ ይኢ፥ «ኑ አብ ኡዶ» ዬጊ ኦይጬዛ።</para>
  <para style="p" vid="LUK 3:14">ዋንሳ፥ «ኦባዝካ ዎልቃር ዳፍ ኤክፓተ፥ ኦናካ ዎርዶር ሞትፓተ፥ ይ ዳሞዛይ ይንትስ ግዶዳ» ዬጌዛ።<verse eid="LUK 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 3:15"/>አሳይ ክርስቶሳ ኡፋይሳር ናግታር የዛ ግሾ ዋንሳና፥ «ኤ ክርስቶሳ ማቃደሻ?» ዬጊ ኡ ፋ ዎዝናይድ ቆፕዛ። <verse eid="LUK 3:15"/><verse number="16" style="v" sid="LUK 3:16"/>ዋንሳ ኡብታይስ ማሂ፥ «ታኒ ይንታን ሃር ጻማቅዛ፥ ዝን ታፕ ኣ ዎልቃምዛይ የኦዳ። ታኒ ኤ ጫማይ ዎዶራ ብሎዳይስ ቤዞዋ አሲ። ኤ ይንታን ጌሻ አያናራኔ ታማር ጻማቆዳ። <verse eid="LUK 3:16"/><verse number="17" style="v" sid="LUK 3:17"/>ዉዱማ የዝ ካ ጌሾዳይስ ፕይ ኤ ኩሻይድ የዛ። ጌዤዝ ካ ፋ ሻላይድ ቆሎዳ፤ ቡናና ቦዋ ታማር ጹጎዳ» ዬጌዛ።<verse eid="LUK 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 3:18"/>ማ ዋንሳ አሳ ጋመ ዞረ ዞሪ ዎንግለ<note caller="+" style="f"><char style="fr" closed="false">3:18 </char><char style="fqa" closed="false">ዎንግለ፦ </char><char style="ft" closed="false">ግርከ ዶናር ዎንግለ ግዝ ቃላይ ጋመ ኡፋይስዛ ኦዳ ዎይ ምሽራቾ ጉሲ። የ ምሽራቻይካ ክርስቶሳ አስ ኮቺ ኡባ መና ፕርደፕ አሾዳይስ ኪትንቲ የኤዝ ጋመ ኡፋይሳ (ሉቃ 1:19፤ 2:10)</char></note> ሳባኬዛ።<verse eid="LUK 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 3:19"/>ዝን ዋንሳ ሄሮዶሳ ፋ እሻይ ማቻት፥ ሄሮድያዳ፥ ኤኬዝ ግሾኔ ሀራ ኢታ ኦስታ ኦዝ ግሾስ ካጬዝ ዎደ<note caller="-" style="x"><char style="xo" closed="false">3:19-20 </char><char style="xt" closed="false"><ref loc="MAT 14:3-4">ማቶ. 14:3-4</ref>፤ <ref loc="MRK 6:17-18">ማር. 6:17-18</ref></char></note> <verse eid="LUK 3:19"/><verse number="20" style="v" sid="LUK 3:20"/>ሄሮዶሳ ካሰሳይል አፋ ሀራ ኢታ ባዝ ኡባ ጉጂ ዋንሳና ዎይነ ገልሴዛ።<verse eid="LUK 3:20"/></para>
  <para style="s1">የሱሳ ጻማቅንቶ</para>
  <para style="r">(<ref loc="MAT 1:1-17">ማቶ. 1:1-17</ref>፤ <ref loc="MAT 3:13-17">3:13-17</ref>፤ <ref loc="MRK 1:9-11">ማር. 1:9-11</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 3:21"/>ዎያይ ኡባይ ጻማቅንቴዛይፕ ጉየ፥ የሱሳካ ማ ጻማቅንቴዛ። ኤ ዎሶዳር ሳሎ ዶይንቴዛ፥ <verse eid="LUK 3:21"/><verse number="22" style="v" sid="LUK 3:22"/>ጌሻ አያናይ ሆለ ጋርከ ማቂ ኤዛል አፋ ዎዛ። ሳሎፕ «ታኒ ቃዛ ናአይ ነና፤ ነ ታና ኡፋይስዛ ዬግዝ» ቃላ የኤዛ።<note caller="-" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="GEN 22:2">መ. 22:2</ref>፤ <ref loc="PSA 2:7">ማዝ. 2:7</ref>፤ <ref loc="ISA 42:1">ኢሳ. 42:1</ref>፤ <ref loc="MAT 3:17">ማቶ. 3:17</ref>፤ <ref loc="MRK 1:11">ማር. 1:11</ref>፤ <ref loc="LUK 9:35">ሉቃ. 9:35</ref></char></note><verse eid="LUK 3:22"/></para>
  <para style="s1">የሱሳ የለት ጹስ</para>
  <para style="r">(<ref loc="MAT 1:1-17">ማቶ. 1:1-17</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 3:23"/>የሱሳ ታማርሶ አይኮዳር ኤስ ሀስታም ላይ ዝን፥ አሳይ ኤዛ ዮሴፋ ናአ ግ ቆፔዛ።</para>
  <para style="q1" vid="LUK 3:23">ዮሴፋ ኤለ ናአ፥ <verse eid="LUK 3:23"/><verse number="24" style="v" sid="LUK 3:24"/>ኤለ ማተ ናአ፥</para>
  <para style="q1" vid="LUK 3:24">ማተ ለወ ናአ፥ ለወ ምልካ ናአ፥</para>
  <para style="q1" vid="LUK 3:24">ምልካ ዮና ናአ፥ ዮና ዮሴፋ ናአ፥<verse eid="LUK 3:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="LUK 3:25"/>ዮሴፋ ማታተ ናአ፥ ማታተ አሞጸ ናአ፥</para>
  <para style="q1" vid="LUK 3:25">አሞጸ ናሆመ ናአ፥ ናሆመ አስሊመ ናአ፥</para>
  <para style="q1" vid="LUK 3:25">አስሊመ ናገ ናአ፥ <verse eid="LUK 3:25"/><verse number="26" style="v" sid="LUK 3:26"/>ናገ ማአተ ናአ፥</para>
  <para style="q1" vid="LUK 3:26">ማአተ ማታትየ ናአ፥ ማታትየ ሳማየ ናአ፥<verse eid="LUK 3:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="LUK 3:27"/>ሳማየ ዮሴፋ ናአ፥ ዮሴፋ ዮዳ ናአ፥</para>
  <para style="q1" vid="LUK 3:27">ዮዳ ዮናነ ናአ፥ ዮናነ ራሰ ናአ፥</para>
  <para style="q1" vid="LUK 3:27">ራሰ ዘሩባበላ ናአ፥ ዘሩባበላ ሳላትያለ ናአ፥</para>
  <para style="q1" vid="LUK 3:27">ሳላትያለ ኔራ ናአ፥ <verse eid="LUK 3:27"/><verse number="28" style="v" sid="LUK 3:28"/>ኔራ ምልካ ናአ፥</para>
  <para style="q1" vid="LUK 3:28">ምልካ ሃደ ናአ፥ ሃደ ቆሳመ ናአ፥</para>
  <para style="q1" vid="LUK 3:28">ቆሳመ ኤልሞዳኔ ናአ፥ ኤልሞዳኔ ኤረ ናአ፥<verse eid="LUK 3:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="LUK 3:29"/>ኤረ ዮሴኤ ናአ፥ ዮሴኤ አላዛራ ናአ፥</para>
  <para style="q1" vid="LUK 3:29">አላዛረ ዮራመ ናአ፥ ዮራመ ማጻተ ናአ፥</para>
  <para style="q1" vid="LUK 3:29">ማጻተ ለወ ናአ፥ <verse eid="LUK 3:29"/><verse number="30" style="v" sid="LUK 3:30"/>ለወ ስሞነ ናአ፥</para>
  <para style="q1" vid="LUK 3:30">ስሞና ይሁዳ ናአ፥ ይሁዳ ዮሴፋ ናአ፥</para>
  <para style="q1" vid="LUK 3:30">ዮሴፋ ዮናነ ናአ፥ ዮናነ ኤልያቀመ ናአ፥<verse eid="LUK 3:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="LUK 3:31"/>ኤልያቀመ ማልየ ናአ፥ ማልየ ማይናነ ናአ፥</para>
  <para style="q1" vid="LUK 3:31">ማይናነ ማጻተ ናአ፥ ማጻተ ናታነ ናአ፥</para>
  <para style="q1" vid="LUK 3:31">ናታነ ዳዉተ ናአ፥ <verse eid="LUK 3:31"/><verse number="32" style="v" sid="LUK 3:32"/>ዳዉተ ኢሳየ ናአ፥</para>
  <para style="q1" vid="LUK 3:32">ኢሳየ ኢዮቤደ ናአ፥ ኢዮቤደ ቦኤዛ ናአ፥</para>
  <para style="q1" vid="LUK 3:32">ቦኤዛ ሳልሞና ናአ፥ ሳልሞና ናአሶና ናአ፥<verse eid="LUK 3:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="LUK 3:33"/>ናአሶና አምናዳባ ናአ፥ አምናዳባ ራመ ናአ፥ ራመ አርና ናአ፥</para>
  <para style="q1" vid="LUK 3:33">አርነ አስሮመ ናአ፥ <verse eid="LUK 3:33"/><verse number="34" style="v" sid="LUK 3:34"/>አስሮመ ፓረሰ ናአ፥</para>
  <para style="q1" vid="LUK 3:34">ፓረሰ ይሁዳ ናአ፥</para>
  <para style="q1" vid="LUK 3:34">ይሁዳ ያይቆባ ናአ፥</para>
  <para style="q1" vid="LUK 3:34">ያይቆባ እሳቃ ናአ፥ ይሳቃ አፍራመ ናአ፥</para>
  <para style="q1" vid="LUK 3:34">አፍራመ ታር ናአ፥ <verse eid="LUK 3:34"/><verse number="35" style="v" sid="LUK 3:35"/>ታር ናኮረ ናአ፥</para>
  <para style="q1" vid="LUK 3:35">ናኮረ ሳሩገ ናአ፥ ሳሩገ ረሁ ናአ፥</para>
  <para style="q1" vid="LUK 3:35">ረሁ ፋላቃ ናአ፥ ፋላቃ ኤቤራ ናአ፥</para>
  <para style="q1" vid="LUK 3:35">ኤቤሮ ሴላ ናአ፥ <verse eid="LUK 3:35"/><verse number="36" style="v" sid="LUK 3:36"/>ሴላ ቃይናመ ናአ፥</para>
  <para style="q1" vid="LUK 3:36">ቃይናመ አርፋክሳዳ ናአ፥ አርፋክሳደ ሴመ ናአ፥</para>
  <para style="q1" vid="LUK 3:36">ሴመ ኖሄ ናአ፥ ኖሄ ላመ ናአ፥<verse eid="LUK 3:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="LUK 3:37"/>ላመሄ ማቱሳላ ናአ፥ ማቱሳላ እኖኬ ናአ፥</para>
  <para style="q1" vid="LUK 3:37">ሄኖኬ ያረደ ናአ፥ ያረደ ማላልኤላ ናአ፥</para>
  <para style="q1" vid="LUK 3:37">ማላልኤላ ቃይናነ ናአ፥ <verse eid="LUK 3:37"/><verse number="38" style="v" sid="LUK 3:38"/>ቃይናነ ሄኖሳ ናአ፥</para>
  <para style="q1" vid="LUK 3:38">ሄኖሰ ሴተ ናአ፥ ሴተ አዳማ ናአ፥</para>
  <para style="q1" vid="LUK 3:38">አዳማ ጾስ ናአ።<verse eid="LUK 3:38"/></para>
  <chapter eid="LUK 3"/>
  <chapter number="4" style="c" sid="LUK 4"/>
  <para style="s1">የሱሳ ፓጭንቴዛ</para>
  <para style="r">(<ref loc="MAT 4:1-11">ማቶ. 4:1-11</ref>፤ <ref loc="MRK 1:12-13">ማር. 1:12-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 4:1"/>የሱሳ ጌሻ አያናር ኩሚ ዮርዳኖሳ ቦርካፕ ማቆዳር ጌሻ አያናይ ኤዛ ሊዦ ጋ ካንጌዛ። <verse eid="LUK 4:1"/><verse number="2" style="v" sid="LUK 4:2"/>ኤዛይድ ኦይታም ጋላስኔ ኦይታም ቃማ ጻላሄር ፓጭንቴዛ። የ ጋላስታ አብካ ሜካዛር ጋምኤዝ ግሾስ ዉርስል ናይንቴዛ።<verse eid="LUK 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 4:3"/>ጻላሄ ኤዝኮ፥ «ነ ጾስ ናአ ማቅኮ አን Ꮊ ሹቻ ሶሎ ማቆ ግ አዛዞባ» ዬጌዛ።<verse eid="LUK 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 4:4"/>የሱሳ ማሂ፥ «አሲ ጾስ ቃላራፕ አትን ሶሎ ኣዳር የዞያ ግንትንቲ ጌሻ ማጻፋይድ ጻፍንቴዛ» ዬጌዝ።<note caller="-" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="DEU 8:3">ናምእ. 8:3</ref></char></note><verse eid="LUK 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 4:5"/>የይፕ ጉየ፥ ጻላሃይ የሱሳ አዱሰ ደረል አፋ ከሲ Ꮊ አላመ ካተት ኤልሲ ቤዜዛ። <verse eid="LUK 4:5"/><verse number="6" style="v" sid="LUK 4:6"/>ጻላሄ፥ «Ꮊ ኡቢታይል ማዉተኔ ቦንቾ ታስ እንግንቴዛ። ታኒ ቃዝ ኦስካ እንግዛ ግሾስ ኔስ እማዳ። <verse eid="LUK 4:6"/><verse number="7" style="v" sid="LUK 4:7"/>የይ ግሾስ፥ ኔኒ ታስ ጎይንኮ ኡቢታይ ኔስ ማቆዳ» ዬጌዛ።<verse eid="LUK 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 4:8"/>የሱሳ ማሂ፥ «ነ ጎዳ፥ ነ ጾሳይስ፥ ኣዳ ጎይኖባ፥ ኤዛ ኣዳ አጋዞባ ዬግንቲ ጌሻ ማጻፋይድ ጻፍንቴዛ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="DEU 6:13">ናምእ. 6:13</ref></char></note><verse eid="LUK 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 4:9"/>ዉርስል ጻላሃይ የሱሳ የሩሳላመ ካንጊ ጾስ ኬስ ኩስተል አፋ ኤሲ፥ «ኔኒ ጾሳ ናአ ማቅኮ አን ሱለ ሳአ ጉፒ ዎባ። <verse eid="LUK 4:9"/><verse number="10" style="v" sid="LUK 4:10"/>አብስ ጊኮ፥</para>
  <para style="q1" vid="LUK 4:10">« ‹ነና ናግዝ ፋ ኪታንችታ፥</para>
  <para style="q2" vid="LUK 4:10">ጾሳይ ነ ግሾስ ኪቶዳ።<note caller="-" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="PSA 91:11-12">ማዝ. 91:11-12</ref></char></note><verse eid="LUK 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LUK 4:11"/>ነ ቶካይ ሹቻር ብንታማይ ጋርክ፥</para>
  <para style="q2" vid="LUK 4:11">ኡ ፋ ኩሻይር ነና ደንዳ› ዬግንቲ ጻፍንቴዛ»</para>
  <para style="m" vid="LUK 4:11">ዬጌዛ።<verse eid="LUK 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 4:12"/>የሱሳ ማሂ፥ «ነ ጎዳ ጾሳ ፓጭፐ ግንትንቲ ጌሻ ማጻፋይድ ጻፍንቴዛ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="DEU 6:16">ናምእ. 6:16</ref></char></note><verse eid="LUK 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 4:13"/>ጻላሃይ የሱሳ ፓጭታ ኡባ ዉርሴዛይፕ ጉየ ሀራ ጊጋ ዎደ ደማድ ጋ ኤዝፕ ሻክንቴዛ።<verse eid="LUK 4:13"/></para>
  <para style="s1">የሱሳ ጋልላ ኦሶ አይኬዛ</para>
  <para style="r">(<ref loc="MAT 4:12-17">ማቶ. 4:12-17</ref>፤ <ref loc="MRK 1:14-15">ማር. 1:14-15</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 4:14"/>የሱሳ ጌሻ አያና ዎልቃር ኩሚ ጋልላ ማቄዛ። ኤ ዋራይ ሄራ የዝ ቢታ ኡባይል ስእንቴዛ። <verse eid="LUK 4:14"/><verse number="15" style="v" sid="LUK 4:15"/>ኤ አይሁድታይ ዎሳ ኬ ገሊ ታማርሴዛ፤ አሲ ኡባይ ኤዛ ጋላቴዛ።<verse eid="LUK 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 4:16"/>የይፕ ፋ ድጬዝ ካታማ ናዝረተ የኤዛ። ቲን ኦዛይ ጋርክ ማላ ጋላስ አይሁድታይ ዎሳ ኬ ገሌዛ። ናባቦዳይስካ ደንዴዛ። <verse eid="LUK 4:16"/><verse number="17" style="v" sid="LUK 4:17"/>ናበ ኢሳያሳ ማጻፋይ ኤዝስ እንግንትን፥ ጻ ብሊ፥ Ꮊይ ጋርከ ዬጊ ጻፍንቴዛና ደንጌዛ፦<verse eid="LUK 4:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LUK 4:18"/>«ጎዳ አያናይ ታል አፋ የዛ፥</para>
  <para style="q2" vid="LUK 4:18">ማንቅታይስ ዎንግለ ኦዶድ ጋርክ</para>
  <para style="q2" vid="LUK 4:18">ጾሳይ ታና ትዤዛ።</para>
  <para style="q1" vid="LUK 4:18">አጭንቴዝታይስ ብል፥</para>
  <para style="q2" vid="LUK 4:18">ቶእታይ በአድ ጋርክ</para>
  <para style="q2" vid="LUK 4:18">ኡንእንቴዝታ ብልኦድ ጋርክ፥<note caller="-" style="x"><char style="xo" closed="false">4:18-19 </char><char style="xt" closed="false"><ref loc="ISA 61:1-2">ኢሳ. 61:1-2</ref></char></note><verse eid="LUK 4:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="LUK 4:19"/>ጾሳይ ኬሆዳይስ ቆፔዝ ላይ ኦዶድ ጋርክ ታና ኪቴዛ»</para>
  <para style="m" vid="LUK 4:19">ዬጌዛ።<verse eid="LUK 4:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 4:20"/>የይፕ ጉየ፥ ማጻፋ ጻጺ አጋዝዛይስ እንጊ በቴዛ። አይሁድታይ ዎሳ ኬ የዛ አሳይ ኡባይ ዳኪ በኤዛ። <verse eid="LUK 4:20"/><verse number="21" style="v" sid="LUK 4:21"/>ኤ፥ «Ꮊይ ይ ሀየር ስእዝ Ꮊ ማጻፈ ቃላይ Ꮊይኖ ፖልንቴዛ» ዬጌዛ።<verse eid="LUK 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 4:22"/>ኡብታይ ኤ ባጋ ሎኦ ኦድንትዛ። ማ ኤ ዶናፕ ከዝዝ ኣ ኬሃትር ኩሜዝ ቃላር ማላባዝ ጊታር፥ «Ꮊይ ዮሴፋ ናአ ባሳኔ?» ዬጌዛ።<verse eid="LUK 4:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 4:23"/>ኤ፥ ኡንትኮ « ‹ነኖ ኣክማዮ ነና አሾባ፥ ዬግዝ ኣዝሶ ናሻ ታ ስአሚ የይ ጋርክ ቅፍርናሆመ ነ ኦዝ ባዝ ኑ ስኤዛና ማ Ꮊይዳ ነ ካታማይድ ኦባ› » ዬጌዛ። <verse eid="LUK 4:23"/><verse number="24" style="v" sid="LUK 4:24"/>ማካ ታ፥ «ቱማ ኦድዛ፤ ናበ ፋ የልንቴዝ ቢታ ቦንችንቶያ ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">4:24 </char><char style="xt" closed="false"><ref loc="JHN 4:44">ዋን. 4:44</ref></char></note><verse eid="LUK 4:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 4:25"/>«ታ ይንትስ ቱሮ ኦድዛ፤ ናበ ኤላሳ ላይ ሀይ ላይኔ ባጋ ሳሎ ጎርድንትን ኢታ ናየ ቢታ ኡባይል የዝ ዎደ ጋመ አዝኒ ባ ማችታይ እስሬለ የዛ።<note caller="-" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="1KI 17:1">1ካት. 17:1</ref></char></note> <verse eid="LUK 4:25"/><verse number="26" style="v" sid="LUK 4:26"/>ኤላሳ ኡ ኡብታይስ ኪትንተካያ። ዝን ሰራፕታ ጋደ የዛ አዝኒ ባ ፐቲ አስትኮ ኪትንቴዛ።<note caller="-" style="x"><char style="xo" closed="false">4:26 </char><char style="xt" closed="false"><ref loc="1KI 17:8-16">1ካት. 17:8-16</ref></char></note> <verse eid="LUK 4:26"/><verse number="27" style="v" sid="LUK 4:27"/>ናበ ኤልሳኤ ዎደ እስሬለ ጋመ ቦርቆንቶ ሀርገር የዝ አሳይ የዛ። ዝን ሶረ አ ንእማነፕ አትን ኦንካ ጌዠካያ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">4:27 </char><char style="xt" closed="false"><ref loc="2KI 5:1-14">2ካት. 5:1-14</ref></char></note><verse eid="LUK 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 4:28"/>አይሁድታይ ዎሳ ኬ የዝ አስ ኡቢታይ የያ ስኤዝ ዎደ ጋመ ካጬዛ። <verse eid="LUK 4:28"/><verse number="29" style="v" sid="LUK 4:29"/>ፋ በቴዝ አቃይፕ ደንዲ አምባል አፋ ኬጽንቴዝ ካታማፕ ጋጻ ከሲ ኡርቂ ዳኮዳይስ አምባ ጼራ ካንጌዛ። <verse eid="LUK 4:29"/><verse number="30" style="v" sid="LUK 4:30"/>ዝን ኤ ኡ ጋንጨር ኣ ቅቴዛ።<verse eid="LUK 4:30"/></para>
  <para style="s1">የሱሳ ቱና አያና ከሴዛ</para>
  <para style="r">(<ref loc="MRK 1:21-28">ማር. 1:21-28</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 4:31"/>ኤዛይፕ ጋልላ ቢታ የዝ ቅፍርናሆመ ካታማ Ꮊንጌዛ። ኤዛይድ ማላ ጋላስ አሳ ታማርሴዛ። <verse eid="LUK 4:31"/><verse number="32" style="v" sid="LUK 4:32"/>ኤ ቃላ ታማርስዛይ ማዉተር የዝ አስ ጋርክ ማቄዝ ግሾስ ኡቢታይ ኤ ትምርታ ማላባዝ ጌዛ።<note caller="-" style="x"><char style="xo" closed="false">4:32 </char><char style="xt" closed="false"><ref loc="MAT 7:28-29">ማቶ. 7:28-29</ref>፤ <ref loc="PSA 91:11-12">ማዝ. 91:11-12</ref></char></note><verse eid="LUK 4:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 4:33"/>አይሁድታይ ዎሳ ኬ ቱና አያና አይኬዝ አይ የዛ። ኤዚ ፋ ቃላ ቅሲ ኡክታር <verse eid="LUK 4:33"/><verse number="34" style="v" sid="LUK 4:34"/>«ናዝረተ የሱሳ ኔስ ኑር አቢ የኔ? ኑፕ ሃኮባ፤ ነ የኤዛይ ኑና ብሶዳይሶኔ? ኔኒ ኦናዛኮ ታኒ ኤርዛ። ኔኒ ጾሳፕ የኤዝ ጽላያ» ዬጌዛ።<verse eid="LUK 4:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 4:35"/>የሱሳ ቱና አያናይኮ፥ «ስኤ ግ Ꮊ አይፕ ከዞባ» ዬጊ ካጬዛ። ቱና አያናይ አ አስ ኡቢታይ ቲና ሾጪ ኦሊ አብካ ቆሄካዛር አሺ ከዜዝ።<verse eid="LUK 4:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 4:36"/>አስ ኡቢታይ ማላባዝ ግ። ዎልኮ፥ «ሀኖስ፥ Ꮊይ አባ ትምርቴ? ቱና አያንታ ማዉተራኔ ዎልቃር ኪትዛ፤ ኡንትካ ከዝዛ» ዬጌዛ። <verse eid="LUK 4:36"/><verse number="37" style="v" sid="LUK 4:37"/>ኤ ዋራይ ሄራ ኡባይል ከዜዝ።<verse eid="LUK 4:37"/></para>
  <para style="s1">የሱሳ ጋመ ሀርግንቴዝ አስታ ፓዛ</para>
  <para style="r">(<ref loc="MAT 8:14-17">ማቶ. 8:14-17</ref>፤ <ref loc="MRK 1:29-34">ማር. 1:29-34</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 4:38"/>የይፐ ጉየ፥ የሱሳ አይሁድታይ ዎሳ ኬፕ ከዚ ስሞና ካራ ገሌዛ። ስሞና ማቻት እንዳታ ኢታ ኦጸ ምሻ ሀርገር ሀርግንቴዛ። እዞ ፓዳይ ጋርክ የሱሳና ዎሴዛ። <verse eid="LUK 4:38"/><verse number="39" style="v" sid="LUK 4:39"/>እ ሂጻይኮ ሺቂ ዙጊ እ ሀርጋ ካጬዛ። ምሻይ አሽን ኤልሲ ደንዲ ኡንታን ሞኬዛ።<verse eid="LUK 4:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 4:40"/>አዋ ገሎድ ሀኖዳር ዱማ ዱማ ሀርጋይር አይክንቴዝ አሳ ኤዝኮ ከኤዛ። ኤ ፐታይል ፐታይል አፋ ፋ ኩሻ ጋዲ ፓዛ። <verse eid="LUK 4:40"/><verse number="41" style="v" sid="LUK 4:41"/>ቱና አያንታይ ማ፥ «ኔኒ፥ ጾስ ናአ» ዬጊ ኡክታር ጋመ አሳይፕ ከዜዝ። ዝን ኤ ኡንታን ካጬዛ። ኤ ክርስቶሳ ማቄዛና ኡንቲ ኤርዛ ግሾስ ፐትባዝካ ኦዶድ ጋርክ ኮየካያ።<verse eid="LUK 4:41"/></para>
  <para style="s1">የሱሳ ይሁዳ አይሁድታይ ዎሳ ኬ ታማርሴዛ</para>
  <para style="r">(<ref loc="MAT 4:23-25">ማቶ. 4:23-25</ref>፤ <ref loc="MRK 1:35-39">ማር. 1:35-39</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 4:42"/>ሀጋ ሳአ ዎንቶዳር የሱሳ ፐቲ ጌማ አቆ Ꮊንጌዛ። አሳይ ኮይታር ኤ የዛ አቃ የኤዛ። ኡንታፕ ኤ ሻክንቲ Ꮊንጋም ጋርክ ኤዛ ዎሴዛ። <verse eid="LUK 4:42"/><verse number="43" style="v" sid="LUK 4:43"/>ዝን ኤ፥ «ታኒ ሀራ ካታምታይድ Ꮊንጊ ጾሳ ካተት ዎንግለ ማርካቶዳይስ ቤዝዛ። ታ ኪትንቴዛይ የይ ግሾሲ» ዬጌዛ። <verse eid="LUK 4:43"/><verse number="44" style="v" sid="LUK 4:44"/>ይሁዳ ቢታል የዝ አይሁድታይ ዎሳ ኬ ኡባ ዉቲ ሳባኬዛ።<verse eid="LUK 4:44"/></para>
  <chapter eid="LUK 4"/>
  <chapter number="5" style="c" sid="LUK 5"/>
  <para style="s1">የሱሳ ዶሬዝ ቲና ታማርታ</para>
  <para style="r">(<ref loc="MAT 4:18-22">ማቶ. 4:18-22</ref>፤ <ref loc="MRK 1:16-20">ማር. 1:16-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 5:1"/>ፐቲ ጋላስ የሱሳ ገንሳሬጸ አባ ላንቀ ኤቄዝን ጋመ አሳይ ኤ ካንታ ኡኪ፥ ኤ ታማርስዛ ጾሳ ቃላና ስኦዳይስ ኡርቅንትዛ።<note caller="-" style="x"><char style="xo" closed="false">5:1-3 </char><char style="xt" closed="false"><ref loc="MAT 13:1-2">ማቶ. 13:1-2</ref>፤ <ref loc="MRK 3:9-10">ማር. 3:9-10</ref>፤ <ref loc="MRK 4:1">4:1</ref></char></note> <verse eid="LUK 5:1"/><verse number="2" style="v" sid="LUK 5:2"/>ኤዛይድ አባይ ጋጻ የዝ ናምኢ ዎጎልታ በኤዛ። ሞሎ አይክዝ አስታይ ዎጎልታይፕ ዎ ፋ ግታ ሜጭዛ። <figure style="fig" alt="Fisher men in their fishing boat" file="HK00208B.tif" size="span" ref="5:2">ሞሎ አይክዝ ኣስ</figure> <verse eid="LUK 5:2"/><verse number="3" style="v" sid="LUK 5:3"/>የ ዎጎልታይፕ ስሞናረ ገሊ ቢታፕ ጽቃል ገድ አባይ ጋንጨል ሺሾዳይ ጋርክ ኦይጬዛ። ዬዚ፥ የ ዎጎላታይድ በቲ አሳ ዎንግለ ታማርሴዛ።<verse eid="LUK 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 5:4"/>ፋ ታማርሳ ዉርሴዛይፕ ጉየ ስሞናኮ፥ «ገደ ጪማይኮ ሺሺ ሞሎ አይኮዳይስ ይ ግታ ኦሎይታ» ዬጌዛ።<verse eid="LUK 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 5:5"/>ስሞና ማሂ፥ «አስታማራዮ፥ ቃማ ሙዳ ዳቡርታር አቅ አብካ አይከካያ፥ ዝን ነ ጊኮ ነቃላይር ግታ ኑ ኦሎዳ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="JHN 21:3">ዋን. 21:3</ref></char></note><verse eid="LUK 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 5:6"/>ኡ ግታ ኦሌዝ ዎደ ግታይ ፔንቶድ ጋ ጋመ ሞሎ አይኬዛ።<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="JHN 21:6">ዋን. 21:6</ref></char></note> <verse eid="LUK 5:6"/><verse number="7" style="v" sid="LUK 5:7"/>ሀራ ዎጎሎ ጋንጨ የዝ ፋ ዣምታይ ይኢ፥ ፋና ማዶድ ጋርክ ዉቲ ጼጌዛ። ኡ ይኢ ናምኢ ዎጎልታ፥ ሃይ ጋንጨ ምትንቶድ ጋ ሞሎ ኩንዛ።<verse eid="LUK 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 5:8"/>ስሞን ጵጽሮሳ የያ በኤዝ ዎደ የሱሳ ቲና ጹጉኒ፥ «ጎዳዮ፥ ታኒ ናጋራንቾ አስ ማቄዝ ግሾስ ታፕ ሻክንቶባ» ዬጌዛ። <verse eid="LUK 5:8"/><verse number="9" style="v" sid="LUK 5:9"/>የያ ኤ ጌዛይ ኤዝኔ ኤዛር የዝታይ አይኬዝ ሞላይ ጋመትይ ማላባዝ ማቄዝ ግሾስ። <verse eid="LUK 5:9"/><verse number="10" style="v" sid="LUK 5:10"/>ማ ስሞና ዣመ ማቄዝ ዛብዶሳ ናእታይ ያይቆባራኔ ዋንሳራ ማላባዝ ጌዛ። የሱሳ ስሞናኮ፥ «ያሽትፐ! Ꮊንፕ ገድ ኔኒ አስ አይክዝ አስ ማቆዳ» ዬጌዛ። <verse eid="LUK 5:10"/><verse number="11" style="v" sid="LUK 5:11"/>ኡ ዎጎልታ ጋጻ ሺሼዛይፕ ጉየ ኡብታ አሺ የሱሳና ካሎ አይኬዛ።<verse eid="LUK 5:11"/></para>
  <para style="s1">የሱሳ ቦርቆንቶ ሀርገር የዛና ጌሼዛ</para>
  <para style="r">(<ref loc="MAT 8:1-4">ማቶ. 8:1-4</ref>፤ <ref loc="MRK 1:40-45">ማር. 1:40-45</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 5:12"/>የሱሳ ካታምታይፕ ፐታይድ ማቂ የዝን ፐቲ ቦርቆንቶ ሀርገር<note caller="+" style="f"><char style="fr" closed="false">5:12 </char><char style="fqa" closed="false">ቦርቆንቶ ሀርገ፦ </char><char style="ft" closed="false">ቦርቆንቶ ሀርገ አስስ ጋላል አፋ ከዝዝ ሀርገ። እስሬለ ቢታ ቦርቆንቶር የዝ Ꮊርጋስታይ ሀራ አሳፕ ዱማቲ የዝዛፕ አትን አስ ሄሎያ።</char></note> አይክንቴዝ አሲ የ ካታማይድ የዛ። የ አይ የሱሳ ብኢ ኤ ቲናይድ ጹጉኒ፥ «ጎዳዮ፥ ነ ሸነ ማቅኮ ታና ጌሾዳይስ ነ ዳንዳእዛ» ግ ዎሴዛ።<verse eid="LUK 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 5:13"/>የሱሳ ፋ ኩሻ ዳኪ ቦቺ፥ «ኤ፥ ታ ሸነ፤ ጌዦባ» ዬጌዛ። እዝር አይ ጌዤዛ።<verse eid="LUK 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 5:14"/>የሱሳ፥ «Ꮊያ ኦስካ ኦድፐ፥ ዝን Ꮊንጊ ነናት ቄሳ ቤዞባ። ነ ጌዤዛይስ ማርካ ማቃዳይ ጋርክ ሙሰ ኪቴዝ ያርሻና ያርሾባ» ግ ኪቴዛ።<note caller="-" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="LEV 14:1-32">ለዊ. 14:1-32</ref></char></note><verse eid="LUK 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 5:15"/>ማቆዝን፥ የሱሳ ዋራይ ካሰሳይፕ ኣ ዳልግታር Ꮊንጌዛ። ጋመ አሳይ ኤ ኦድዛ ባዝ ስኦዳይስኔ ፋ ሀርገፕ ፓጾዳይስ ይእዛ። <verse eid="LUK 5:15"/><verse number="16" style="v" sid="LUK 5:16"/>ዝን ኤዚ ኡባ ዎደ ፋ ኣዳስ ጌማ አቆ Ꮊንጊ ዎስዛ።<verse eid="LUK 5:16"/></para>
  <para style="s1">የሱሳ ስላ አ ፓዛ</para>
  <para style="r">(<ref loc="MAT 9:1-8">ማቶ. 9:1-8</ref>፤ <ref loc="MRK 2:1-12">ማር. 2:1-12</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 5:17"/>ፐቲ ጋላስ የሱሳ ታማርሶዳር ጋልላፐራ ይሁዳ ሄራ ኡባይፐ ማ የሩሳላመፐካ የኤዝ ፈርሳውታይራ ህገ አስታማርታይ ኤዛይድ በቴዛ። አሳ ፓዛ ጎዳይ ዎልቃይካ ኤዛር የዛ። <verse eid="LUK 5:17"/><verse number="18" style="v" sid="LUK 5:18"/>የ ዎደ አሳይ ፐቲ ስላ አስ ሀላር ቶኪ ከኤዛ። ካራ ገልሲ ኤ ቲናይድ ጋዶዳይስ ኮዬዛ። <verse eid="LUK 5:18"/><verse number="19" style="v" sid="LUK 5:19"/>ዝን አስ ዳሮትይፕ ካራ ገልሶዳይስ ጋምንቲ ኬል አፋ ከዚ፥ ሲትንጋ ቃዉጺ፥ ሀርግንቴዝ አ ሀላር አሳ ሻጊ የሱሳ ቲና ዎዛ።<verse eid="LUK 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 5:20"/>የሱሳ ኡ አማና ብኢ፥ «ናት አዮ፥ ነ ናጋራይ አቶ ግንትንቴዛ» ዬጌዛ።<verse eid="LUK 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 5:21"/>ህገ አስታማርታይኔ ፈርሳወ አሳይ፥ «Ꮊይ ጾስ ጫዥዛይ ኦኖ? ፐቲ ጾሳፕ አትን ሀራ ናጋራ አቶ ጎዳይስ ዳንዳእዛይ ኦኖ?» ዬጊ ቆፔዛ።<verse eid="LUK 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 5:22"/>የሱሳ ኡ ቆፋ ኤሬዝ ግሾስ ኡንትኮ፥ «ይ ዎዝና ጋንጨ የይ ጋርክ አብስ ቆፔ? <verse eid="LUK 5:22"/><verse number="23" style="v" sid="LUK 5:23"/>‹ነ ናጋራይ ኡጭንቴዛ ግዛይፐነ ደንዲ የባ ግዛይፕ ኣይ ሎኦ?› <verse eid="LUK 5:23"/><verse number="24" style="v" sid="LUK 5:24"/>ዝን ታ የያ ጌዛይ አስ ናአይ ቢታል አፋ ናጋራ ኡጮዳይስ ማዉተ የዛና ይ ኤሮድ ጋርከ።» የይፕ ማቂ፥ ስላ አይኮ፥ «ደንዲ፤ ነ አርሳ ቶኪ ነ ካራ Ꮊንጎባ» ዬጌዛ። <verse eid="LUK 5:24"/><verse number="25" style="v" sid="LUK 5:25"/>ኤ ኤል ደንዲ ኡ ቲና ኤቄዛ፤ ኤ ቶክንቲ የኤዝ አርሳ ቶኪ ጾሳ ጋላትታር ፋ ካራ Ꮊንጌዛ። <verse eid="LUK 5:25"/><verse number="26" style="v" sid="LUK 5:26"/>የ ዎደ ኡቢታይካ ማላባዝ ጌዛ። ጾሳ ጋላትታር፥ «Ꮊይኖ ኑ ዳማ ማላታ በኤዛ» ዬጊ ያሽቴዛ።<verse eid="LUK 5:26"/></para>
  <para style="s1">የሱሳ ለዋ ጼጌዛ</para>
  <para style="r">(<ref loc="MAT 9:9-13">ማቶ. 9:9-13</ref>፤ <ref loc="MRK 2:13-17">ማር. 2:13-17</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 5:27"/>የይፕ ጉየ፥ የሱሳ የይፕ ከዚ Ꮊንግታር። ለወ ግንትንትዝ ፐቲ ቃራጸ ጋችስዛይ ቃራጸ ጋችስዛ አቆ በቴዛና ብኢ፥ «ታና ካሎባ» ዬጌዛ። <verse eid="LUK 5:27"/><verse number="28" style="v" sid="LUK 5:28"/>ኤ ኡባ ባዝ አሺ ደንዲ ኤዛ ካሌዛ።<verse eid="LUK 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 5:29"/>የ ለዋይ ፋ ካራ ዳሞ ስብረ ጊግሴዛ። ጋመ ቃራጸ ጋችሽዝታይኔ ሀራ አሳይ ካ ማዳይስ በቴዛ። <verse eid="LUK 5:29"/><verse number="30" style="v" sid="LUK 5:30"/>ፈርሳውታይራ ህገ አስታማርታይ፥ «ቃራጸ ጋችስዝታይራኔ ናጋራ ኦዝታይር አብስ ም ኡዤ?» ዬጊ የሱሳ ታማርታይል ኤዛ ዝግሬዛ።<note caller="-" style="x"><char style="xo" closed="false">5:30 </char><char style="xt" closed="false"><ref loc="LUK 15:1-2">ሉቃ. 15:1-2</ref></char></note><verse eid="LUK 5:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 5:31"/>የሱሳ ኡንትኮ፥ «ሀርግንቴዝታይፕ አትን ፓ አስስ አክመ ኮሾያ። <verse eid="LUK 5:31"/><verse number="32" style="v" sid="LUK 5:32"/>ታኒ ናጋራ ኦዝታ ማሮትኮ ማሆዳይስፕ አትን ጌሽታ ጼጎዳይስ የኤካያ» ዬጊ ማሄዛ።<verse eid="LUK 5:32"/></para>
  <para style="s1">ጾማ ባጋ ሺቄዝ ኦይች</para>
  <para style="r">(<ref loc="MAT 9:14-17">ማቶ. 9:14-17</ref>፤ <ref loc="MRK 2:18-22">ማር. 2:18-22</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 5:33"/>ኡ የሱሳኮ፥ «ዋንሳ ታማርታይ ጋመ ጾምዛ፥ ማ ፈርሳውታይ ታማርታይካ የይ ጋርክ ኦዛ። ዝን ኔስታይ ኡባ ዎደ ሚዛይ ኡዥዛይ አብሶ» ዬጌዛ።<verse eid="LUK 5:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 5:34"/>የሱሳ ኡንትኮ፥ «ማቾ ኤክዛይ ኡንታር የዝን ላዛንታይ ጾሞዳይ ጋርክ ኦዳይስ ዳንዳእኔ? <verse eid="LUK 5:34"/><verse number="35" style="v" sid="LUK 5:35"/>ዝን ማቾ ኤክዛይ ኡንታፕ ሻክንቶድ ጋላስ የኦዳ፥ የ ዎደ ኡንቲ ጾሞዳ።»<verse eid="LUK 5:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 5:36"/>ማ ዬጊ ኣዝሶ ኦዴዛ፤ «ኦሮ ማኦፕ ፔ ጭማ አፍላል አፋ ስክዛ ኦንካ ባያ። የይ ጋርክ ኦኮ ኦሮ አፍላ ፐርእዛ፥ ኦሮይ ጭማይስ ጊጎያ። <verse eid="LUK 5:36"/><verse number="37" style="v" sid="LUK 5:37"/>ማልአንቶ ዎይነ ጭማ ኦጎሮ ጋንጨ ቡልዝ ኦንካ ባያ። የያ ኦኮ፥ ማልአንቶ ዎይናይ ጭማ ኦጎራ ስዛ፤ ዎይናይ ላልንትዛ ኦጎራይካ አዶያ። <verse eid="LUK 5:37"/><verse number="38" style="v" sid="LUK 5:38"/>የይ ግሾስ፥ ማልአንቶ ዎይነ ኦሮ ኦጎሮ ጋንጨ ቡልንቶዳይስ ቤዝዛ። <verse eid="LUK 5:38"/><verse number="39" style="v" sid="LUK 5:39"/>ይኬ፥ ካኤዛይ ሎኦ ግዝ ግሾስ ካኦ ዎይነ ኡዢ ማቂ ማልአንቶ ኮይዛይ ኦንካ ባያ» ዬጌዛ።<verse eid="LUK 5:39"/></para>
  <chapter eid="LUK 5"/>
  <chapter number="6" style="c" sid="LUK 6"/>
  <para style="s1">የሱሳ ማላ ባጋ ኦይጭንቴዛ</para>
  <para style="r">(<ref loc="MAT 12:1-8">ማቶ. 12:1-8</ref>፤ <ref loc="MRK 2:23-28">ማር. 2:23-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 6:1"/>ፐቲ ማላ ጋላስ የሱሳ ጋደ ጋንጨር ኣዛ። የሱሳ ታማርታይ ባንጋ ትዣ ዱ ፋ ኩሸር ምርኪ ሚዛ።<note caller="-" style="x"><char style="xo" closed="false">6:1 </char><char style="xt" closed="false"><ref loc="DEU 23:25">ናምእ. 23:25</ref></char></note> <verse eid="LUK 6:1"/><verse number="2" style="v" sid="LUK 6:2"/>ዝን ፈርሳውታይ ጋንጨፕ ፐታይ ፐታይ፥ «ማላ ጋላስ ኦዳይስ ኑ ህጋይድ ቤዞዋ ባዝ አብስ ኦ?» ዬጌዛ።<verse eid="LUK 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 6:3"/>የሱሳ ኡንትኮ ማሂ፥ «ዳዉተ ናይንቴዝ ዎደ ፓር የዝታይራ ዎላ ኦዛና ይ ናባበካሳ?<note caller="-" style="x"><char style="xo" closed="false">6:3 </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">1ሳም. 21:1-6</ref></char></note> <verse eid="LUK 6:3"/><verse number="4" style="v" sid="LUK 6:4"/>ጾስ ኬ ገሊ አይሁድታይ ቄስታይ ኣዳስ ቤዝዛ ዳቦ ሜዛ፤ ፓር የዝታይስካ እንጌዛ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="LEV 24:9">ለዊ. 24:9</ref></char></note> <verse eid="LUK 6:4"/><verse number="5" style="v" sid="LUK 6:5"/>ማ የሱሳ፥ «አስ ናአይ ማላስ ጎዳ» ዬጌዛ።<verse eid="LUK 6:5"/></para>
  <para style="s1">የሱሳ ኩሸ ስላ አ ፓዛ</para>
  <para style="r">(<ref loc="MAT 12:9-14">ማቶ. 12:9-14</ref>፤ <ref loc="MRK 3:1-6">ማር. 3:1-6</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 6:6"/>ሀራ ማላ ጋላስ የሱሳ አይሁድታይ ዎሳ ኬ ገሊ ታማርስዛ። የ አቃይድ ኡሻች ኩሸ ስሌዝ ፐቲ አሲ የዛ። <verse eid="LUK 6:6"/><verse number="7" style="v" sid="LUK 6:7"/>ህገ አስታማርታይኔ ፈርሳወ አሳይ ኤዛ ሞቶዳይስ ሳንከ ኮዢ ማላ ጋላስ ፓኮ በአዳ ግ ናግዛ። <verse eid="LUK 6:7"/><verse number="8" style="v" sid="LUK 6:8"/>ዝን የሱሳ ኡ ቆፋ ኤሪ ኩሻይ ስሌዝ አይኮ፥ «ደንዲ አሳይ ጋንጨ ኤቆባ» ዬጌዛ፥ አይካ ደንዲ ኤቄዛ።<verse eid="LUK 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 6:9"/>የሱሳ፥ «አን ታ ይንታን ፐትባዝ ኦይጭዛ፤ ማላ ጋላስ ኦዳይስ ቤዝዛይ ሎኦ ባዞኔ ኢታባዞ? ሸምፖ አሾኔ ብሶ?» ዬጌዛ።<verse eid="LUK 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 6:10"/>ማ የሱሳ ኤ ላንቃይር የዝ አሳ ኡባ ዩዪ ብኢ አይኮ፥ «ነ ኩሻ ፕድ ኡዶባ» ዬጌዛ፥ አይካ ኤ ጌዛን ጋርክ ኡድን ኩሻይ ፓጼዛ። <verse eid="LUK 6:10"/><verse number="11" style="v" sid="LUK 6:11"/>ዝን ህገ አስታማርታይኔ ፈርሳወ አሳይ ኢታ ይላዛ። የሱሳል አፋ አብ ኡዶ ግ ዎላ ቶቤዛ።<verse eid="LUK 6:11"/></para>
  <para style="s1">የሱሳ ታጶ ናምኢ ሀዋርታ ዶሬዛ</para>
  <para style="r">(<ref loc="MAT 10:1-4">ማቶ. 10:1-4</ref>፤ <ref loc="MRK 3:13-19">ማር. 3:13-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 6:12"/>የ ዎደ ጋላስታይፕ ፐቲ ጋላስ የሱሳ ዎሶዳይስ ደረል አፋ ከዜዛ። ቃማ ሙዳ ጾሳ ዎስታር አቄዛ። <verse eid="LUK 6:12"/><verse number="13" style="v" sid="LUK 6:13"/>ዎንት ፋ ታማርታ ጼጊ ኡ ጋንጨፕ ታጶ ናምእታ ዶሪ፥ ኡንታን፥ «ሀዋርታ» ግ ጼጌዛ። <verse eid="LUK 6:13"/><verse number="14" style="v" sid="LUK 6:14"/>ኡንትካ፥ ጵጽሮሳ ግ ጼግዝ ስሞና፥ ኤ እሻ እንድራሰ፥ ያይቆባ፥ ዋንሳ፥ ፍልጶሳ፥ ባርቶሎሞሳ፥ <verse eid="LUK 6:14"/><verse number="15" style="v" sid="LUK 6:15"/>ማቶሳ፥ ቶማሳ፥ እልፎሳ ናአ ያይቆባ፥ ፋ ቢታይስ ምጭንትዝ ስሞና፥ <verse eid="LUK 6:15"/><verse number="16" style="v" sid="LUK 6:16"/>ያይቆባ ናአ ይሁዳራኔ የሱሳ ኣ እንጌዝ አስቆሮንቶ ይሁዳ።<verse eid="LUK 6:16"/></para>
  <para style="s1">የሱሳ ታማርሶኔ ፓ</para>
  <para style="r">(<ref loc="MAT 4:23-25">ማቶ. 4:23-25</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 6:17"/>የሱሳ ሀዋርታይር ዎላ ደረላፕ ዎ ደንባ አቆ ኤቄዛ። ኤ ታማርታይፕ ጋምታይ የ አቃይድ የዛ። ይሁዳ ቢታ ኡባፐ የሩሳላመፐ፥ ጽሮሳፐኔ ስዶና አባ ጋጻፐ ጋመ አሳይ ኤ ታማርስዛ ባዝ ስኦዳይስኔ ፋ ሀርገፕ ፋጾዳይስ የኤዛ። <verse eid="LUK 6:17"/><verse number="18" style="v" sid="LUK 6:18"/>ቱና አያናር መትንትዛ አስታይካ ይኢ ፓጼዛ። <verse eid="LUK 6:18"/><verse number="19" style="v" sid="LUK 6:19"/>ፓዛ ዎልቃ ኤዝፕ ከዚ አሲ ኡባ ፓዛ ግሾስ አሳይ ኤዛ ቦቾዳይስ ኮይዛ።<verse eid="LUK 6:19"/></para>
  <para style="s1">አንጆኔ መቶ</para>
  <para style="r">(<ref loc="MAT 5:1-12">ማቶ. 5:1-12</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 6:20"/>ፋ ታማርታይኮ ብኢ Ꮊይ ጋርከ ዬጌዛ፦</para>
  <para style="q1" vid="LUK 6:20">«ይንታኖ፥ ማንቅታዮ፥ ይ አንጅንቴዝታ፤</para>
  <para style="q2" vid="LUK 6:20">ጾስ ካተትይ ይንትሲ።<verse eid="LUK 6:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LUK 6:21"/>ይ Ꮊት ናይንትዝታይ አንጅንቴዝታ፥</para>
  <para style="q2" vid="LUK 6:21">ይ ምዦዳ።</para>
  <para style="q1" vid="LUK 6:21">ይ Ꮊት ዬክዝታይ አንጅንቴዝታ</para>
  <para style="q2" vid="LUK 6:21">ይ ሚጮዳ።<verse eid="LUK 6:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="LUK 6:22"/>አሳይ ይንታን ታ ግሾ፥ አስ ናአይ ግሾስ</para>
  <para style="q2" vid="LUK 6:22">እጽዛ ዎደ</para>
  <para style="q2" vid="LUK 6:22">ይንታን ፕልዛ ዎደ</para>
  <para style="q2" vid="LUK 6:22">ይንታን ኡ ቶችዛ ዎደኔ፥</para>
  <para style="q2" vid="LUK 6:22">ኢታ ሱን ኡ ይንትስ እንግዛ ዎደ</para>
  <para style="q2" vid="LUK 6:22">ይ አንጅንቴዝታ።<note caller="-" style="x"><char style="xo" closed="false">6:22 </char><char style="xt" closed="false"><ref loc="1PE 4:14">1ጵጽ. 4:14</ref></char></note><verse eid="LUK 6:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 6:23"/>«ዬዛኮ፥ ይ ጋታይ ሳሎ ዳማ ማቄዝ ግሾስ የ ዎደ ኡፋይሳር ጉፖይታ። አብስ ጊኮ፥ ብኒ ኡ አድታይ ናብታይል አፋ Ꮊይ ጋርክ ኡዴዛ።<note caller="-" style="x"><char style="xo" closed="false">6:23 </char><char style="xt" closed="false"><ref loc="2CH 36:16">2ዜና. 36:16</ref>፤ <ref loc="ACT 7:52">ሀዋ. ኦ. 7:52</ref></char></note><verse eid="LUK 6:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="LUK 6:24"/>«ዝን ዱርታዮ ይንታን አየ፤</para>
  <para style="q2" vid="LUK 6:24">ይ Ꮊት ሎኦ የስ ኤኬዝታ።<verse eid="LUK 6:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="LUK 6:25"/>Ꮊት ምዤዝታዮ ይንታን አየ፤</para>
  <para style="q2" vid="LUK 6:25">ይ ናይንቶዳ።</para>
  <para style="q1" vid="LUK 6:25">Ꮊት ሚጭዝታዮ አቦ ይንታኖሾ</para>
  <para style="q2" vid="LUK 6:25">ይ ካያዳኔ ዬኮዳ።<verse eid="LUK 6:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="LUK 6:26"/>አሲ ኡባይ ይ ሎኦት ኣዳ ኦድዝ ዎደ ይንታን አየ።</para>
  <para style="q2" vid="LUK 6:26">ኡ አድታይ ብኒ ዎርዶ ናብታይል አፋ Ꮊይ ጋርክ ኦዛ።<verse eid="LUK 6:26"/></para>
  <para style="s1">ሞርክታ ሲቆ ባጋ</para>
  <para style="r">(<ref loc="MAT 5:38-48">ማቶ. 5:38-48</ref>፤ <ref loc="MAT 7:12">7:12</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 6:27"/>«ዝን ታና ስእዝ ይንትስ ታ ኦድዛ፤ ይ ሞርክታ ሲቆይታ፤ ይንታን እጽዝታይስ ሎኦ ባዝ ኦይታ። <verse eid="LUK 6:27"/><verse number="28" style="v" sid="LUK 6:28"/>ይንታን ባድዝታ አንጆይታ፥ ይንታን ናቅዝታይስ ዎሶይታ። <verse eid="LUK 6:28"/><verse number="29" style="v" sid="LUK 6:29"/>ፐቲ ባጋ ሻንጋላ ባቅዝታይስ Ꮊንኮ ባጋካ ቤዞባ። ነ ኮታ ኤኮዳ ግዛይስ ነ ሻምዣካ ጉጂ እንጎባ። <verse eid="LUK 6:29"/><verse number="30" style="v" sid="LUK 6:30"/>ነና ዎስዛ ኡባይስ እንጎባ፤ ኔፕ ኤኬዝ ኦናካ ማሆ ግ ኦይጭፐ። <verse eid="LUK 6:30"/><verse number="31" style="v" sid="LUK 6:31"/>አሳይ ይንትስ ኦድ ጋርክ ይ ኮይዝ ባዝ ኡባ ይንትካ አስስ ኦይታ።<note caller="-" style="x"><char style="xo" closed="false">6:31 </char><char style="xt" closed="false"><ref loc="MAT 7:17">ማቶ. 7:17</ref></char></note><verse eid="LUK 6:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 6:32"/>«ይ ይንታን ቃዛ አሳ ኣዳ ቃኮ፥ አባ ጋላታ ይንትስ የኔ? ሀራ አቶዝን፥ ናጋራንችታይካ ፋና ሲቅዝታ ሲቅዛ። <verse eid="LUK 6:32"/><verse number="33" style="v" sid="LUK 6:33"/>ይንትስ ሎኦ ባዝ ኦዝታይስ ኣዳ ሎኦ ባዝ ኦኮ ይንትስ አባ ጋላታ የኔ? ናጋራንችታይካ Ꮊይ ጋርክ ኦዛ። <verse eid="LUK 6:33"/><verse number="34" style="v" sid="LUK 6:34"/>ታልኤ ማሆድ አስስ ኣዳ ይ ታልእኮ አብ ዱማ ጋላትንትኔ? ናጋራንችታይካ ጉየ ማሆድ አሲ ብኢ ታልእዛ።» <verse eid="LUK 6:34"/><verse number="35" style="v" sid="LUK 6:35"/>«ዝን ይ ሞርክታ ሲቆይታ፤ ኡንትስ ሎኦ ባዝ ኦይታ። ጉየ ኤኮዳይስ ቆፐካዛር ታልኦይታ። የይድ ይ ኤኮድ ጋታይ ዳማ ማቆዳ። ይ ኡባይፕ ኣ ጾስ ናእታ ማቆዳ። ኤ ፋና ጋላቶዝታይስኔ ኢትታይስካ ኬሃ። <verse eid="LUK 6:35"/><verse number="36" style="v" sid="LUK 6:36"/>ይ አዳይ ማርዛ ማቄዛይ ጋርከ ይንትካ ማርዝታ ማቆይታ።<verse eid="LUK 6:36"/></para>
  <para style="s1">ሀራ አሳል አፋ ፕርድፓተ</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 6:37"/>«አሳል አፋ ፕርድፓተ፤ ይንታል አፋ ፕርድንታሚ። ይ ቦርንታማይ ጋርክ ኦናካ ቦርፓተ። አቶ ጎይታ፤ ጾሳይ ይንትስ አቶ ጎዳ። <verse eid="LUK 6:37"/><verse number="38" style="v" sid="LUK 6:38"/>እንጎይታ፤ ይንትስ እንግንቶዳ። ይ ማኬዝ ባዛር ይንትስ ማሂ ማክንቶዳ፥ ኡባራካ ሎኦ ማክዝ ባዛር ባቂ፥ ሱዲ ኩን፥ ላልንቶዳር ይንትስ ማክንቲ እንግንቶዳ» ዬጌዛ።<verse eid="LUK 6:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 6:39"/>ማካ የሱሳ ዬጊ ኡንትስ ኣዝሶ ኦዴዛ፤ «ቶአይ ቶአ ካልዳይስ ዳንዳእኔ? ካልኮ ናምእታይካ ዎል ኤኪ ጋጋ ቅቶሳኔ?<note caller="-" style="x"><char style="xo" closed="false">6:39 </char><char style="xt" closed="false"><ref loc="MAT 15:14">ማቶ. 15:14</ref></char></note> <verse eid="LUK 6:39"/><verse number="40" style="v" sid="LUK 6:40"/>ታማራይ አስታማራይፕ ኣያ። ዝን ሎእ ታማሬዝ አይ ፋ አስታማራይ ጋርክ ሀንዛ።<note caller="-" style="x"><char style="xo" closed="false">6:40 </char><char style="xt" closed="false"><ref loc="MAT 10:24-25">ማቶ. 10:24-25</ref>፤ <ref loc="JHN 13:16">ዋን. 13:16</ref>፤ <ref loc="JHN 15:20">15:20</ref></char></note> <verse eid="LUK 6:40"/><verse number="41" style="v" sid="LUK 6:41"/>ነ እሻይ ኣፋይድ የዛ ቡጻ አብስ ነ ብእኔ? ነ ኣፋይድ የዛ ቱስ ኣዝዛና አብስ ቦኦሳ? <verse eid="LUK 6:41"/><verse number="42" style="v" sid="LUK 6:42"/>ነ ኣፋይድ የዛ ቱስ ኣዝዛና በኤካዛር ነ እሻይኮ፥ ‹ታ እሻዮ ነ ኣፋይድ የዝ ቡጻ ከሶ› ጎዳይስ ዋይዚ ዳንዳኤ? ነኖ ጩባዮ፥ ቲናቲ ነ ኣፋይድ የዝ ቱስ ኣዝዛና ከሶባ። የይፕ ጉየ፥ ነ እሻይ ኣፋይድ የዝ ቡጻ ከሶዳይስ ነ ጌሺ በአዳ።<verse eid="LUK 6:42"/></para>
  <para style="s1">ምኔ ም ኣፈ</para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 6:43"/>«ሎኦ ም ኢታ ኣፈ ኣፎያ፤ የይ ጋርከካ ኢታ ም ሎኦ ኣፈ ኣፎያ። <verse eid="LUK 6:43"/><verse number="44" style="v" sid="LUK 6:44"/>ኣፈ ኣፍዝ ም ኡባይ ፋ ኣፈር ኤርንትዛ። አንጉፐ ባላሰ ኣፈ ማጽንቶያ ማ ጎምኦረፐ ዎይነ ኣፋይ ማጽንቶያ።<note caller="-" style="x"><char style="xo" closed="false">6:44 </char><char style="xt" closed="false"><ref loc="MAT 12:33">ማቶ. 12:33</ref></char></note> <verse eid="LUK 6:44"/><verse number="45" style="v" sid="LUK 6:45"/>ሎኦ አስ ፋ ዎዛና ጋንጨ ኩሜዝ ሎኦ ባዛፕ ሎኦ ባዝ ከስዛ። ኢታ አሲ ፋ ዎዝናይድ ኩሜዝ ኢታ ባዛፕ ኢታ ባዝ ከስዛ። አሲ ፋ ዎዝና ኩሚ ፉጬዛይፕ ፋ ዶናር ኦድዛ።<note caller="-" style="x"><char style="xo" closed="false">6:45 </char><char style="xt" closed="false"><ref loc="LUK 12:34">12:34</ref></char></note><verse eid="LUK 6:45"/></para>
  <para style="s1">ኬ ኬጽዝ ናምኢ አስታ</para>
  <para style="r">(<ref loc="MAT 7:24-27">ማቶ. 7:24-27</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 6:46"/>«ታ ግዛና ኦዋዛር፥ አብስ ታና፥ ‹ጎዳዮ፥ ጎዳዮ፥ ጌ?› <verse eid="LUK 6:46"/><verse number="47" style="v" sid="LUK 6:47"/>ታኮ ይእዛይኔ ታ ቃላ ስኢ ፖልዛ ኡቢታይ ኦና ኣዝዛኮ ታ ይንታን ቤሳዳ። <verse eid="LUK 6:47"/><verse number="48" style="v" sid="LUK 6:48"/>ኤ ኬ ኬጾዳይስ ዎሲ፥ ኦላ ቦኪ፥ ኦሞ የዝ ዛላይል አፋ ኬ ኤሴዝ ኤጫ አ ኣዝዛ። ድኦ ድኢ የ ኬ ኡርቄዛ፥ ዝን ሚን ኬጼዝ ግሾስ ኤንኦዳይስ ዳንዳኤካያ። <verse eid="LUK 6:48"/><verse number="49" style="v" sid="LUK 6:49"/>ዝን ታ ቃላ ስኢ ኦዛይ ፋ ኬ ሻፈል አፋ ኬጼዝ አ ኣዝዛ። ድኦ ድኢ የ ኬ ኡርቄዝ ዎደ ኤልሲ ዎዴዛ። የ ኬይ ዎድይካ ዎልቃማ ማቄዛ» ዬጌዛ።<verse eid="LUK 6:49"/></para>
  <chapter eid="LUK 6"/>
  <chapter number="7" style="c" sid="LUK 7"/>
  <para style="s1">ኦሮመ ማቶ ሀላቃይ አማኖ</para>
  <para style="r">(<ref loc="MAT 8:5-13">ማቶ. 8:5-13</ref>፤ <ref loc="JHN 4:43-54">ዋን. 4:43-54</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 7:1"/>የሱሳ የያ ኡባ አስ ቲና ታማርሲ ዉርሴዛይፕ ጉየ፥ ቅፍርናሆማ ካታማ Ꮊንጌዛ። <verse eid="LUK 7:1"/><verse number="2" style="v" sid="LUK 7:2"/>የ አቃይድ ፐቲ ማቶ ሀላቃይ የዛ። ኤ ጋመ ቃዛ አይላይ ሀርግንቲ Ꮊይቆስ ሄሌዛ። <verse eid="LUK 7:2"/><verse number="3" style="v" sid="LUK 7:3"/>ኤ የሱሳ ባጋ ስኤዝ ዎደ ፋ አይላ ፓዳይ ጋርክ ኤዛ ዎሶ ግ አይሁድታይ ጭምታ የሱሳኮ ኪቴዛ። <verse eid="LUK 7:3"/><verse number="4" style="v" sid="LUK 7:4"/>ኪትንቴዝታይ፥ የሱሳኮ Ꮊንጊ፥ «ነ ኤስ Ꮊያ ኦዳይስ ቤዝዛ። <verse eid="LUK 7:4"/><verse number="5" style="v" sid="LUK 7:5"/>አብስ ጊኮ፥ Ꮊ አይ ኑ አሳ ቃዛ፥ አይሁድታይስ ዎሳ ኬካ ኬጼዛ» ግ ሚን ዎሴዛ <verse eid="LUK 7:5"/><verse number="6" style="v" sid="LUK 7:6"/>የሱሳካ ኡንታር Ꮊንጌዛ። ማቶ ሀላቃይ ካራኮ ኡኮዳር ፋ ላግታ ኤዝኮ ኪቲ፥ «ጎዳዮ፥ ታ ኬይድ ነ ገሎዳይስ ታስ ቤዘካ ግሾስ ዳቡርፐ። <verse eid="LUK 7:6"/><verse number="7" style="v" sid="LUK 7:7"/>ታካ ታና ነ ቲና ሺቆዳይስ ቤዝዛ አስ ግ ቆፖያ። ዝን ነ Ꮊን እዘ ኤቂ ፐቲ ቃላ ኦዶባ፤ ታ አይላይ ፓጾዳ። <verse eid="LUK 7:7"/><verse number="8" style="v" sid="LUK 7:8"/>ታስ ታፕ አፋር ሀላቃይ የዛ፥ ታፕ ኦሞር ታ ኪትዛ ዎታዳርታይ የዛ። ፐታ፥ ‹ቅቶባ› ጊኮ ቅትዛ፥ Ꮊንካ፥ ‹Ꮊና የኦባ› ጊኮ ይእዛ። ታ አይላይኮ፥ ‹Ꮊኖ ኦባ› ጊኮ ኦዛ» ዬጌዛ።<verse eid="LUK 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 7:9"/>የሱሳ የያ ስኤዝ ዎደ ማላባዝ ጌዛ። ጉየ ማቂ Ꮊንጊ አሳይኮ፥ «ታ ይንትስ ቱሮ ኦድዛ፤ ሀራ አቶዝን አስራኤለ ጋንጨካ Ꮊይ ጋርክ ግታ አማኖ ታ ደንገካ» ዬጌዛ። <verse eid="LUK 7:9"/><verse number="10" style="v" sid="LUK 7:10"/>ኪትንቴዝታይ ካራ ማቃዳር አይላይ ፓጽን ደንጌዛ።<verse eid="LUK 7:10"/></para>
  <para style="s1">አምአት ናአ</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 7:11"/>ዎንት ጋላስ የሱሳ ናይነ ካታማ Ꮊንጌዛ። ኤ ታማርታይራኔ ሀራ ጋመ አሳይ ኤዛር Ꮊንጌዛ። <verse eid="LUK 7:11"/><verse number="12" style="v" sid="LUK 7:12"/>ኤ ካታማ ገሎድ ሀኖዳር አሃ ቶኬዝ ጋመ አሳይ ካታማፕ ከዜዝ። Ꮊይቄዝ ናአይ ፋ እንዳትስ ፐቶ፥ እዛካ አምኦ። ካታማ አሳይፕ ጋምታይ እዝር የዛ። <verse eid="LUK 7:12"/><verse number="13" style="v" sid="LUK 7:13"/>ጎዳይ እዞ ብኢ ቃንቲ፥ «ዬክፐ» ዬጌዛ።<verse eid="LUK 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 7:14"/>ሺቂ ሀላ ቦችን ቶኬዝ አሳይ ኤቄዛ። የሱሳ፥ «ናት፥ የላጋዮ ደንዶባ» ዬጌዛ። <verse eid="LUK 7:14"/><verse number="15" style="v" sid="LUK 7:15"/>Ꮊይቄዛይ ደንዲ በቲ ናሻ አይኬዛ። የሱሳ ናአ ደን እንዳትስ እንጌዛ።<verse eid="LUK 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 7:16"/>አስ ኡቢታይ ያሽቲ፥ «ኡባፕ ኣዝ ናበ ኑ ጋንጨ ደንዴዛ፤ ጾሳይ ፋ አስታ በኤዛ» ዬጊ ጾሳ ጋላቴዛ። <verse eid="LUK 7:16"/><verse number="17" style="v" sid="LUK 7:17"/>ኤ ዋራይ ይሁዳንነ የ ሄራይድ የዝ ቢታ ኡባይል ስንቴዛ።<verse eid="LUK 7:17"/></para>
  <para style="s1">የሱሳራኔ ጻማቅዛ ዋንሳራ</para>
  <para style="r">(<ref loc="MAT 11:2-9">ማቶ. 11:2-9</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 7:18"/>ጻማቅዛ ዋንሳ ታማርታይ የያ ኡብታ ዋንሳስ ኦዴዛ። ኤ ኡ ጋንጨፕ ናምእታ ጼጊ፥ <verse eid="LUK 7:18"/><verse number="19" style="v" sid="LUK 7:19"/>«የኦድ ጊንትንቴዛይ ነናኔ? ዎይ ሀራ ናጎ?» ዬጊ ኦይጮይታ ግ ጎዳይኮ ኪቴዛ።<verse eid="LUK 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 7:20"/>አሳይ የሱሳኮ Ꮊንጊ፥ ጻማቅዛ ዋንሳ፥ «የኦድ ጊንትንቴዛይ ማሳይ ነናኔ? ዎይ ሀራ ኑ ናጎ?» ጎይታ ግ ኑና ኔኮ ኪቴዛ ዬጌዛ።<verse eid="LUK 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 7:21"/>የ ሳታተ የሱሳ ጋመ አሳ ሀርገፕ ፓዛ። ቱና አያንታ ከሴዛ፥ ጋመ ቶኤዝ አስ ኣፍታካ ብእሴዛ። <verse eid="LUK 7:21"/><verse number="22" style="v" sid="LUK 7:22"/>ዋንሳ ካንታፕ ኪትንቲ የኤዝታይኮ፥ «Ꮊንጊ ይ በኤዛናኔ ስኤዛና ዋንሳስ ኦዶይታ። ኣፈ ቶእታይ ብእዛ፥ ጉንድታይ ብልእንቲ የዛ፥ ቦርቆንቶር የዝታይ ጌዥዛ፥ ቱልታይ ስእዛ፥ Ꮊይቄዝታይ Ꮊይቆፕ ደንድዛ፥ ማንቅታይስ ዎንግላይ ሳባክንትዛ።<note caller="-" style="x"><char style="xo" closed="false">7:22 </char><char style="xt" closed="false"><ref loc="ISA 35:5-6">ኢሳ. 35:5-6</ref>፤ <ref loc="ISA 61:1">61:1</ref></char></note> <verse eid="LUK 7:22"/><verse number="23" style="v" sid="LUK 7:23"/>ታል ብንቶዋ ኦንካ አንጅንቴዛያ።»<verse eid="LUK 7:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 7:24"/>ዋንሳ ኪቴዝታይ Ꮊንጌዛይፕ ጉየ የሱሳ ዎያይስ ዋንሳ ባጋ ዬጊ ኦዴዛ፦ «ይ አብ በአዳይስ ሊዦ ከዜኔ? ጫርኮ ኤንእስዛ ማቃ በአዳይሶኔ? <verse eid="LUK 7:24"/><verse number="25" style="v" sid="LUK 7:25"/>የዝን፥ አብ በአዳይስ ከዜኔ? ቦንቾ አፍላ ማኤዝ አሳ በአዳይስነ? ቦንቾ አፍላ ማኤዝታይኔ ሳአ ጊጌዝ አሳይ ካት ኬ የዛ። <verse eid="LUK 7:25"/><verse number="26" style="v" sid="LUK 7:26"/>የዝን፥ አብ በአዳይስ ከዜኔ? ናበ በአዳይሶኔ? ኤ፥ ታ ዬግዛ፦ ይ በአዳይስ ከዜዛይ ናበፕ ኣዛና።<verse eid="LUK 7:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="LUK 7:27"/>«‹ነ ኦገ ነ ቲና ጊግስዛ</para>
  <para style="q2" vid="LUK 7:27">ታ ኪታንቻ ኔፕ ቲና ታ ኪቶዳ›<note caller="-" style="x"><char style="xo" closed="false">7:27 </char><char style="xt" closed="false"><ref loc="MAL 3:1">ሚል. 3:1</ref></char></note> ዬግንቲ ጻፍንቴዛይ Ꮊይስ ኤዝሲ።<verse eid="LUK 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 7:28"/>ታ ይንትስ ኦድዛ፤ ማቻፕ የልንቴዝታይ ጋንጨፕ ዋንሳፕ ኣዛይ ባያ። ጾስ ካተትት ኡባፕ ጽቅዛይ፥ ኤ ኡባፕ ዳማ ማቆዳ» ዬጌዛ።<verse eid="LUK 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 7:29"/>ሀራ አቶዝን፥ የሱሳ ቃላ ስኤዝ ቃራጸ ጋችዝታይኔ አስ ኡባይ ዋንሳ ኩሸ ጻማቅንቴዝታይ ጾሳይ ጌሽ ማቅዛ ቆንጭሴዛ።<note caller="-" style="x"><char style="xo" closed="false">7:29 </char><char style="xt" closed="false"><ref loc="MAT 21:32">ማቶ. 21:32</ref>፤ <ref loc="LUK 3:12">ሉቃ. 3:12</ref></char></note> <verse eid="LUK 7:29"/><verse number="30" style="v" sid="LUK 7:30"/>ዝን ፈርሳውታይኔ ህገ አስታማርታይ ዋንሳ ኩሸ ጻማቅንታም እጺ ጾስ ቆፋ ለቄዛ።<verse eid="LUK 7:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 7:31"/>የሱሳ ማቂ Ꮊይ ጋርከ ዬጌዛ፦ «ይኬ፥ Ꮊ ዎደ የለት አባር ኣዝሶዴ? ኡንትካ ኦና ኣዜ? <verse eid="LUK 7:31"/><verse number="32" style="v" sid="LUK 7:32"/>ጋበ ጋንጨ በቲ ዎል ጼጊ፥ ‹ኑ ይንትስ እምፕልተ ፑግን፥ ይ የጾያ። ኑ ሳቢ ዘላልን፥ ይ ዬኮያ› ዬግዝ ናእታ ኣዝዛ። <verse eid="LUK 7:32"/><verse number="33" style="v" sid="LUK 7:33"/>ጻማቅዛ ዋንሳ ሶሎ ሜካዛራኔ ዎይነ ኡዠካዛር ይእን፥ ‹ኢታ አያናይር የዛ ይ ጌዛ።› <verse eid="LUK 7:33"/><verse number="34" style="v" sid="LUK 7:34"/>አስ ናአይ ሚታራኔ ኡዥታር ይእን፥ Ꮊ አይ ‹ዥንባራኔ ኡሺ ዶስዛ፥ ቃራጸ ጋችስዝታኔ ናጋራ ኦዝታይ ዳቦ› ጌዛ። <verse eid="LUK 7:34"/><verse number="35" style="v" sid="LUK 7:35"/>ኤጨት ቱሮ ማቅዛይ ፋ ናአትራ ኤርንትዛ» ዬጌዛ።<verse eid="LUK 7:35"/></para>
  <para style="s1">የሱሳ ሽቶ ትዤዝ አስቶ</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 7:36"/>ፈርሳውታይፕ ፐታይ የሱሳ ካ ሙዞዳይስ ፋ ካራ ጼጌዛ። ኤ ፈርሳዋይ ካራ Ꮊንጊ ሌማተል አፋ በቴዛ። <verse eid="LUK 7:36"/><verse number="37" style="v" sid="LUK 7:37"/>የ ካታማ ጋንጨ ፐቲ ናጋራንቾ ማች የዛና የሱሳ ፈርሳዋይ ካራ ስብረል አፋ የዛና ስኤዝ ዎደ ሎእ አልኦ አልባስጽሮሳ ብልጋጸ ሽቶ ኤኪ የኤዛ።<note caller="-" style="x"><char style="xo" closed="false">7:37-38 </char><char style="xt" closed="false"><ref loc="MAT 26:7">ማቶ. 26:7</ref>፤ <ref loc="MRK 14:3">ማር. 14:3</ref>፤ <ref loc="JHN 12:3">ዋን. 12:3</ref></char></note> <verse eid="LUK 7:37"/><verse number="38" style="v" sid="LUK 7:38"/>የሱሳስ ጉየ ባጋር፥ ኤ ቶካይ ካለ ኤቂ ዬክታር ኤ ቶካ ፋ አፉር ላክዛ። ፋ ብናናይር ኤ ቶካ ኡጭታራኔ ዬርታር ሽቶ ትዤዛ።<verse eid="LUK 7:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 7:39"/>ስብራና ማኬዝ ፈርሳዋይ የያ ብኢ ፋ ዎዝናር፥ «Ꮊይ ናበ ማቄዛኮ Ꮊ አስታ ኤዛ ቦችዛና ኦናዛኮ ማ እዛ ዋፋ ናጋራንቾ ማቄዛኮ ኤ ኤሮዳዝን» ዬጌዛ።<verse eid="LUK 7:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 7:40"/>የሱሳ፥ «ስሞና፥ ታ ኔስ ኦድዛ ባዝ የዛ» ዬጌዛ።</para>
  <para style="p" vid="LUK 7:40">ኤ፥ «አስታማራዮ፥ ታስ ኦዶባ» ዬጌዛ።<verse eid="LUK 7:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 7:41"/>የሱሳ ኤዝኮ፥ «ናምኢ አሳይ ፔቲ አይፕ ሚሸ ታልኤዛ። ፐታይ እችን ጼት ድናረ Ꮊንካይ ማ እሻታም ድናረ ታልኤዛ። <verse eid="LUK 7:41"/><verse number="42" style="v" sid="LUK 7:42"/>ናምእታይካ ታልኤ ጭጎዳይስ ጋምንትን፥ ናምእታይስካ ታልኤዛና ማሬዛ። ይኬ፥ Ꮊ ናምእታይፕ የ አ ሎእ ዶሶዳይ ኔስ ኣያ ኣዜ» ዬጌዛ።<verse eid="LUK 7:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 7:43"/>ስሞና፥ «ጋመ አጮ ማርንቴዝ አይ ጋመ ቃዳ ኣዝዛ» ዬጌዛ። የሱሳ፥ «ነ ቱማ ፕርዴዛ» ዬጌዛ። <verse eid="LUK 7:43"/><verse number="44" style="v" sid="LUK 7:44"/>የይፐ ጉየ፥ የሱሳ አስትኮ ማቂ ብኢ፥ ስሞናኮ፥ «Ꮊኖ አስቶ ነ ብእኔ? ታኒ ነ ካራ ገልን ሀራ አትን ነ ታስ ቶኬ ሃ እንገካያ፥ ዝን እዛ ታ ቶካ ፋ አፉር ላክ ፋ ብናናይር ኡጬዛ። <verse eid="LUK 7:44"/><verse number="45" style="v" sid="LUK 7:45"/>ነ ታና ዬሪ ኤከካያ፥ ዝን እዛ ታ ነ ካራ ገሌዛይፕ አይኪ ታ ቶኬ ዬሮ አሸካያ። <verse eid="LUK 7:45"/><verse number="46" style="v" sid="LUK 7:46"/>ኔኒ ታ ኦማይል ዛይተ ትዠካያ፥ ዝን እዛ ታ ቶካ ሽቶ ትዤዛ። <verse eid="LUK 7:46"/><verse number="47" style="v" sid="LUK 7:47"/>እዛ ታና ጋመ ቃዝ ግሾስ እ ጋመ ናጋራይ አቶ ግንትንቴዛ። ኤ ጽቃ ናጋራይ አቶ ጊንትንቴዛይ ጽቃል ቃዛ።»<verse eid="LUK 7:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 7:48"/>የሱሳ አስትኮ፥ «ነ ናጋራይ አቶ ግንትንቴዛ» ዬጌዛ።<verse eid="LUK 7:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 7:49"/>ኤዛር ዎላ በቲ ሚዝታይ፥ «ናጋራ አቶ ዬግዛይ፥ ኤ Ꮊይ ኦኖ?» ዬጊ ፋ ዎዝናር ቆፔዛ።<verse eid="LUK 7:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 7:50"/>የሱሳ አስትኮ፥ «ነ አማናይ ነና አሼዛ፤ ሳሮ ቅቶባ» ዬጌዛ።<verse eid="LUK 7:50"/></para>
  <chapter eid="LUK 7"/>
  <chapter number="8" style="c" sid="LUK 8"/>
  <para style="s1">የሱሳ ሞኬዝ ማችታ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 8:1"/>የይፐ ጉየ፥ የሱሳ ጾሳ ካተት ዎንግለ ሳባክታር ካታማራኔ ሄራር ኣዛ። የ ዎደ ታጶ ናምእታይ ኤዛር የዛ። <verse eid="LUK 8:1"/><verse number="2" style="v" sid="LUK 8:2"/>ማ ቱና አያናፐኔ ዱማ ዱማ ሀርገፕ ፓጼዝ ፐቲ ፐቲ ማችታይ ኤዛር የዛ። ኡንትካ፥ ላፑን ቱና አያንታይ ከዜዝ ማግዴላ ማይራሞ፥<note caller="-" style="x"><char style="xo" closed="false">8:2 </char><char style="xt" closed="false"><ref loc="MAT 27:55-56">ማቶ. 27:55-56</ref>፤ <ref loc="MRK 15:40-41">ማር. 15:40-41</ref>፤ <ref loc="LUK 23:49">ሉቃ. 23:49</ref></char></note> <verse eid="LUK 8:2"/><verse number="3" style="v" sid="LUK 8:3"/>ሄሮዶሳ ሹማይ ኩዛ ማቻት ዮሃና፥ ሶስናራኔ ማ ሀራ ጋምታይ ኡንታን ሚሸር ማድዝታይ የዛ።<verse eid="LUK 8:3"/></para>
  <para style="s1">ዘር ዘርዝ አይ ኣዝሶ</para>
  <para style="r">(<ref loc="MAT 13:1-9">ማቶ. 13:1-9</ref>፤ <ref loc="MRK 4:1-9">ማር. 4:1-9</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 8:4"/>ጋመ አሳይ ዱማ ዱማ ካታማፕ ኤዝኮ ሺቅን ኣዝሶር ኡንትስ ኦዴዛ። <verse eid="LUK 8:4"/><verse number="5" style="v" sid="LUK 8:5"/>«ፐቲ ቢታ ኦ አቅዛይ ዘር ዘሮዳይስ ከዜዝ። ኤ ዘሮዳር ፐቲ ፐቲ ዘርይ ኦገል ዎ የንቴዛ፥ ሳሎ ካፍታይ ሜዛ። <verse eid="LUK 8:5"/><verse number="6" style="v" sid="LUK 8:6"/>Ꮊንክታይ ስስንቆ ኦሞር የዛ ቢታል አፋ ዎዛ። ሀጋ ዶሌዛኒ ጋርክ ቢታይ ላኮ ባዛይ ግሾስ ሚጬዛ። <verse eid="LUK 8:6"/><verse number="7" style="v" sid="LUK 8:7"/>ሀራ ዘርይ ማ አንጉን ጋንጨ ዎዛ። አጉንር ዎላ ድጬዝ ግሾስ አንጉይ ጩሊ አቃይድ አሼዛ። <verse eid="LUK 8:7"/><verse number="8" style="v" sid="LUK 8:8"/>Ꮊንክታይ ሎኦ ቢታል አፋ ዎዛ። ዶሌዝ ዎደ ጼት ኩሸ ኣፌዛ።» የያ ኦዲ ሃሲ፥ ፋ ቃላ ቅ ኡዲ፥ «ስእዝ ሀየ ዬዚ ኡቢታይ ስኦ» ዬጌዛ።<verse eid="LUK 8:8"/></para>
  <para style="s1">ዘር ኣዝሳይስ ብርሽ</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 8:9"/>ኤ ታማርታይ፥ «Ꮊ ኣዝሳይስ ብርሽይ አባ?» ዬጊ ኦይጬዛ <verse eid="LUK 8:9"/><verse number="10" style="v" sid="LUK 8:10"/>ኤ፥ «ጾሳ ካተት ጹራ ባዝ ኤሮድ ጋርክ ይንትስ እንግንቴዛ። ዝን ሀራ አሳይ ብእታር ደንጋም ጋርክ፥ ስእታር አካካማይ ጋርክ ኣዝሶር ኦድዛ።<note caller="-" style="x"><char style="xo" closed="false">8:10 </char><char style="xt" closed="false"><ref loc="ISA 6:9">ኢሳ. 6:9</ref></char></note><verse eid="LUK 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 8:11"/>«ይኬ፥ Ꮊ ኣዝሳይስ ብርሽይ Ꮊይ፦ ዘር ዬግንቴዛይ ጾስ ቃላ። <verse eid="LUK 8:11"/><verse number="12" style="v" sid="LUK 8:12"/>ኦገ ጋጻ ዎዝ ዘርይ ቃላ ስእዝታ። ማቆዝን፥ ኡንቲ አማኒ አታም ጋርክ ጻላሃይ ቃላ ኡ ዎዝናይፕ ማጺ ሃስዛ። <verse eid="LUK 8:12"/><verse number="13" style="v" sid="LUK 8:13"/>ስስልቆ የዝ ቢታል አፋ ዎዝ ዘርይ ቃላ ስኢ ኡፋይሳር ኤክዝታ። ኡ Ꮊተስ አማንዛፕ አትን ጻጶ ባ ግሾስ ፓጨ ሄልዛ ዎደ ኤልሲ ካድዛ። <verse eid="LUK 8:13"/><verse number="14" style="v" sid="LUK 8:14"/>አንጉ ጋንጨ ዘርንቴዝታይ ቃላ ስእዝታ። ኡንትካ አላመ ቆፋር፥ ዱረትራኔ ሳአ የስ ሀንን ጩልንቲ ቤዝዛይ ጋርክ ኣፈካያ። <verse eid="LUK 8:14"/><verse number="15" style="v" sid="LUK 8:15"/>ሎኦ ቢታል ዎዝ ዘርይ ሎኦኔ ሉለ ዎዝናር ቃላ ስኢ ናግዝታኔ ዳንዳአር ሚንጊ ኣፈ ኣፍዝታ።<verse eid="LUK 8:15"/></para>
  <para style="s1">ጾምፐ ኣዝሶ</para>
  <para style="r">(<ref loc="MRK 4:21-25">ማር. 4:21-25</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 8:16"/>«ጾምፐ ጾምፒ፥ ኦታ ጋንጨ ዎይ አርሳፕ ኦሞር ጋድዛይ ባያ። ገልዛ አሲ በአድ ጋርክ ቀ አቆ ጋድዛ።<note caller="-" style="x"><char style="xo" closed="false">8:16 </char><char style="xt" closed="false"><ref loc="MAT 5:15">ማቶ. 5:15</ref>፤ <ref loc="LUK 11:33">ሉቃ. 11:33</ref></char></note><verse eid="LUK 8:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 8:17"/>«የይ ግሾስ፥ ቆስንቴዛይ ፕ ከዘካዛር፥ ካምንቴዝ ባዝ፥ በንተካዛር አታሚ።<note caller="-" style="x"><char style="xo" closed="false">8:17 </char><char style="xt" closed="false"><ref loc="MAT 10:26">ማቶ. 10:26</ref>፤ <ref loc="LUK 12:2">ሉቃ. 12:2</ref></char></note><verse eid="LUK 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 8:18"/>«ይኬ፥ ይ ቃላ ዋይዚ ስእዛኮ ናግንቶይታ። የዛ ኡባይስ ጉዥንቲ እንግንቶዳ፥ ባዛይስ ሀራ አቶዝን ኤዝስ የዛ ጽቃታካ ኤዛፕ ኤክንቶዳ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">8:18 </char><char style="xt" closed="false"><ref loc="MAT 25:29">ማቶ. 25:29</ref>፤ <ref loc="LUK 19:26">ሉቃ. 19:26</ref></char></note><verse eid="LUK 8:18"/></para>
  <para style="s1">የሱሳ እንዳትራኔ እሽታይራ</para>
  <para style="r">(<ref loc="MAT 12:46-50">ማቶ. 12:46-50</ref>፤ <ref loc="MRK 3:31-35">ማር. 3:31-35</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 8:19"/>የሱሳ እንዳትራኔ እሽታይራ ኤዝኮ የኤዛ። ዝን አስታይ ጋመትይፕ ደንዴዛይድ ኤዛ ደንጎዳይስ ዳንዳኤካያ። <verse eid="LUK 8:19"/><verse number="20" style="v" sid="LUK 8:20"/>ፐቲ አሲ የሱሳኮ፥ «ነ እንዳትራ ነ እሽታይራ ነና ኮዪ ባለ ናግዛ» ዬጌዛ።<verse eid="LUK 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 8:21"/>የሱሳ ማሂ፥ «ጾስ ቃላ ስኢ ኦሶል ፔሽዝታይ ኡባይ ታስ እንዶኔ ታስ እሸ» ዬጌዛ።<verse eid="LUK 8:21"/></para>
  <para style="s1">የሱሳ አባ ዙሎ ሴሬዛ</para>
  <para style="r">(<ref loc="MAT 8:23-27">ማቶ. 8:23-27</ref>፤ <ref loc="MRK 4:35-41">ማር. 4:35-41</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 8:22"/>ፐቲ ጋላስ የሱሳራኔ ኤ ታማርታይራ ዎላ ዎጎሎ ጋንጨ ገሊ፥ «አባ ፒንጎዳ» ዬጌዛ። ኡንትካ Ꮊማዳይስ ደንዴዛ። <verse eid="LUK 8:22"/><verse number="23" style="v" sid="LUK 8:23"/>አባል አፋር ኡንቲ ፒንጎዳይስ Ꮊማዳር የሱሳ ገንቴዛ። ቆፐካዝን ዎልቃማ ጫርኮ አባል አፋ ደንዴዛ። ሃይ ዎጎሎ ጋንጨ ገልን ዎጎላይ ምትንቶ አይክን ኡባይ ያሽቴዛ።<verse eid="LUK 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 8:24"/>ኤ ታማርታይ ኤዝኮ ሺቂ፥ «ኑ ጎዳዮ፥ ኑ ቦሆ ዬጊ» የሱሳ ደንዛ።</para>
  <para style="p" vid="LUK 8:24">የሱሳ ደንዲ ጫርካኔ ጎታ ሴሬዛ። ኤልሲ ጫርካይኔ ጎታይ ሀይዚ ጭጭርክ ጌዛ። ሳሮትይካ ማቄዛ። <verse eid="LUK 8:24"/><verse number="25" style="v" sid="LUK 8:25"/>የሱሳ ፋ ታማርታይኮ፥ «ይ አማናይ አባ የኔ» ዬጌዛ። ኡንትካ፥ ያሽትታራኔ ማላባዝ ጊታር ፐታይ ፐታይኮ፥ «ጫርኮኔ ሃ አዛዝንትዛይ፥ ኤ Ꮊይ ኦኖ» ዬጌዛ።<verse eid="LUK 8:25"/></para>
  <para style="s1">ቱና አያናፕ ፓጼዝ አ</para>
  <para style="r">(<ref loc="MAT 8:28-34">ማቶ. 8:28-34</ref>፤ <ref loc="MRK 5:1-20">ማር. 5:1-20</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 8:26"/>አባ ፒንጊ ጋልላ ባጋር የዝ ገርገሶነ ቢታ ሄሌዛ። <verse eid="LUK 8:26"/><verse number="27" style="v" sid="LUK 8:27"/>የሱሳ ዎጎሎፕ ከዚ ሳአ ዎዳር ቱና አያናር አይክንቴዝ አይ ካታምትፕ ከዚ ኤዛ ሄሌዛ። ጋመ ላይ አፍላ ማኤካዛር ካሎ ዱፎ ጋንጨ የዛይፕ አትን ካራ ገሎያ። <verse eid="LUK 8:27"/><verse number="28" style="v" sid="LUK 8:28"/>የሱሳና በኤዝ ዎደ ኤ ቲናይድ ጹጉኒ፥ ፋ ቃላ ቅ ኡዲ፥ «ኡባፕ ኣ ጾስ ናአ የሱሳ ኔር ታስ አባ ፐትፐተ የኔ? ሀያና ታና Ꮊት ብጽስፐ» ዬጌዛ። <verse eid="LUK 8:28"/><verse number="29" style="v" sid="LUK 8:29"/>የይ ኤ ጌዛይ፥ ቱና አያናይ አይፕ ከዞዳይ ጋርክ የሱሳ ካጬዝ ግሾስ። ጋመ ዎደ ቱና አያናይ ኤዛ ሞዴዝ ግሾስ ሳንላተራኔ ቶኬ አጭዝ ብራታር አጭንቲ ናግንትዛ። ዝን አቻ ዱ ቱና አያናር ላግንቲ ሊዦ ገልዛ።<verse eid="LUK 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 8:30"/>የሱሳ፥ «ነ ሱንይ ኦኖ?» ዬጊ ኦይጬዛ።</para>
  <para style="p" vid="LUK 8:30">ኤ፥ ጋመ ቱና አያንታይ ኤዛ አይኬዝ ግሾስ ፋና፥ «ሌጎና» ጌዛ። <verse eid="LUK 8:30"/><verse number="31" style="v" sid="LUK 8:31"/>ቱና አያንታይ ፋና ጪሞ<note caller="+" style="f"><char style="fr" closed="false">8:31 </char><char style="ft" closed="false">ጪሞ ጉሳይ ቱና አያና ዉርስ ፕርደስ ናግንትዛ አቆ</char></note> ኪታም ጋርክ ዎሴዛ።<verse eid="LUK 8:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 8:32"/>የ አቃይድ ደረል አፋ ሚዝ ጉዳይለ ዉደ ሄንግንትዛ። Ꮊ ጉዳይልታይል ኑ ገሎ ግ ዎሴዛ፥ ኤዝካ «ገሎይታ» ጌዛ። <verse eid="LUK 8:32"/><verse number="33" style="v" sid="LUK 8:33"/>ቱና አያንታይ አይፕ ከዚ ጉዳይልታይል ገሌዛ። ዉዳይ ደረላፕ ሱለ ጉርጉጺ አባ ጋንጨ ገሌዛ።<verse eid="LUK 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 8:34"/>ሄንግዝታይ ሀኔዛና ብኢ ዎጺ Ꮊንጊ፥ ካታማኔ ሄራ ኡባይል ኦዴዛ። <verse eid="LUK 8:34"/><verse number="35" style="v" sid="LUK 8:35"/>አሳይ ሀኔዝባዛ በአዳይስ ከዚ የሱሳኮ የኤዛ። ቱና አያናይ ከዜዝ አይ አፍላ ማኢ፥ ኤ ዎዝናይ ማቅን፥ የሱሳ ቶኬ ካለ በቴዛና ደንጊ ያሽቴዛ። <verse eid="LUK 8:35"/><verse number="36" style="v" sid="LUK 8:36"/>ኤዛ በኤዝ አሳይ ቱና አያናር አይክንቴዝ አይ ዋይዚ ፓጼዛኮ ኦዴዛ። <verse eid="LUK 8:36"/><verse number="37" style="v" sid="LUK 8:37"/>ገርገሶነ ላንቃይድ የዝ አሳይ ጋመ ያሻ ያሽቲ የሱሳ ፋ ጋዳይፕ Ꮊንጎድ ጋርክ ዎሴዛ። ኤ ዎጎሎ ጋንጨ ገሊ ጉየ ማቄዛ።<verse eid="LUK 8:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 8:38"/>ቱና አያናይ ከዜዝ አይ የሱሳር የዞዳይስ ዎሴዛ። <verse eid="LUK 8:38"/><verse number="39" style="v" sid="LUK 8:39"/>ዝን የሱሳ ኤዝኮ፥ «ነ ካራ ማቆባ፥ ጾሳይ አብ ጋርክ ዳማባዝ ኔስ ኦዛኮ ኦዶባ» ዬጊ ሞይዜዛ። አይካ የሱሳ አብ ጋርክ ዳማባዝ ኤዝስ ኦዛኮ ካታማ ኡባይድ ማርካትታር ቅቴዛ።<verse eid="LUK 8:39"/></para>
  <para style="s1">Ꮊይቄዝ ናአቶኔ የሱሳ አፍላ ቦቼዝ አስቶ</para>
  <para style="r">(<ref loc="MAT 9:18-26">ማቶ. 9:18-26</ref>፤ <ref loc="MRK 5:21-43">ማር. 5:21-43</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 8:40"/>አሳይ ናጊ ጋምኤዝ ግሾስ የሱሳ ማቅዝ ዎደ ሞኪ ኤኬዛ። <verse eid="LUK 8:40"/><verse number="41" style="v" sid="LUK 8:41"/>አይሁድታይ ዎሳ ኬ ሀላቃ ማቄዝ ኢያሮሳ ግዝ አይ ፋ ካራ የኦድ ጋርክ የሱሳ ቶካይል አፋ ዎ ዎሴዛ። <verse eid="LUK 8:41"/><verse number="42" style="v" sid="LUK 8:42"/>ኤስ ታጶ ናምኢ ላይ ማቄዝ ፐቲ ማች ናአ የዛና ሀርግንቲ Ꮊይቆስ ሄሊ የዛ። የሱሳ Ꮊንጎዳር አሳይ ኤዛ ኡንእዛ። <verse eid="LUK 8:42"/><verse number="43" style="v" sid="LUK 8:43"/>ታጶ ናምኢ ላይ ሱ ጎግታር ጋምኤዝ አስታ የዛ። እዛ ፓስ ዬዚ ሻላ ኡባ አክምታይስ እንጊ ዉርሴዛ። ዝን ፓጾዳይስ ዳንዳኤካያ። <verse eid="LUK 8:43"/><verse number="44" style="v" sid="LUK 8:44"/>እዛ የሱሳስ ጉየ ባጋር ሺቂ፥ ኤ አፍላ ማንቻቶ ቦቼዛ፥ እዝራ ጎግዝ ሱይ ኤቂ አቴዛ።<verse eid="LUK 8:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 8:45"/>የሱሳ፥ «ታና ቦቼዛይ ኦኖ?» ዬጌዛ። ኡባይ «ኑ ቦቼካያ» ዬግን፥ ጵጽሮሳ፥ «አስታማራዮ፥ ጋመ አሳይ ካሎዳራኔ ኡርቅዳር ብእታር ዋይዚ፥ [‹ታና ቦቼዛይ ኦኖ?› ጌ]» ዬጌዛ።<verse eid="LUK 8:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 8:46"/>ዝን የሱሳ፥ «ፐቲ አሲ ታና ቦቼዛ፤ አብስ ጊኮ፥ ዎልቃ ታፕ ከዜዛይ ታስ ኤርንቴዛ» ዬጌዛ።<verse eid="LUK 8:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 8:47"/>የ አስታ፥ እባዝ ቆስንተካዛና ኤሪ ኩኩርታር ይኢ የሱሳ ቶካይል አፋ ዎዛ። አብስ ቦቼዛኮኔ ዋይዚ ኤልሲ ፓጼዛኮ አስ ኡቢታይ ቲና ማርካቴዛ። <verse eid="LUK 8:47"/><verse number="48" style="v" sid="LUK 8:48"/>ኤ፥ «ታ ናአተ፥ ነ አማናይ ነና ፓዛ፤ ሳሮ ቅቶባ» ዬጌዛ።<verse eid="LUK 8:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 8:49"/>የሱሳ ናሻ ዉርሰካዝን፥ አይሁድታይ ዎሳ ኬ ሀላቃይ፥ ኢያሮሳ ካራፕ ፐቲ አሲ ይኢ፥ «ኢያሮሳ፥ ነ ናአታ Ꮊይቄዛ፤ ይኬ አስታማራ ጨረ ዳቡርስፐ» ዬጌዛ።<verse eid="LUK 8:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 8:50"/>ዝን የሱሳ የያ ስኢ ኢያሮሳኮ፥ «ያሽትፐ! አማኖባፕ አትን፥ ነ ናአታ ፓጾዳ» ዬጌዛ።<verse eid="LUK 8:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 8:51"/>የሱሳ ኢያሮሳ ካራ ሄሌዛን ጋርክ ጵጽሮሳ፥ ዋንሳ፥ ያይቆባ፥ ናአቲ አዳይፐኔ እንዳትፐ አትን ሀራ አስ ገሎድ ጋርክ ኮየካያ። <verse eid="LUK 8:51"/><verse number="52" style="v" sid="LUK 8:52"/>የ አቃይድ የዝ አሳይ ኡቢታይ ናአትስ ዎ ዎ ግ ዬኮዳር፥ የሱሳ፥ «ዬክፓተ! ናአታ ገንቴዛፕ አትን Ꮊይቀካያ» ዬጌዛ።<verse eid="LUK 8:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 8:53"/>አሳይ ናአታ Ꮊይቄዛና ኤርዛ ግሾስ ኤ ኦዳ ለቂ ሚጬዛ። <verse eid="LUK 8:53"/><verse number="54" style="v" sid="LUK 8:54"/>ዝን የሱሳ ናአቲ ኩሻ አይኪ፥ «ቡሽተ ደንዶባ» ዬጌዛ። <verse eid="LUK 8:54"/><verse number="55" style="v" sid="LUK 8:55"/>ናአትስ ሸምፓይ ማቅን ኤልሲ ፑክ ግ ደንዲ ኤቄዛ። የሱሳ ኡንትኮ፥ «እዝስ ሚዝባዝ እንጎይታ» ዬጌዛ። <verse eid="LUK 8:55"/><verse number="56" style="v" sid="LUK 8:56"/>ናአቲ አዳይራኔ እንዳትር ማላባዝ ጌዛ። ዝን የሱሳ Ꮊያ፥ «ኦስካ ኦድፓተ» ዬጌዛ።<verse eid="LUK 8:56"/></para>
  <chapter eid="LUK 8"/>
  <chapter number="9" style="c" sid="LUK 9"/>
  <para style="s1">የሱሳ ታጶ ናምኢ ሀዋርታ ኪቴዛ</para>
  <para style="r">(<ref loc="MAT 10:5-15">ማቶ. 10:5-15</ref>፤ <ref loc="MRK 6:7-13">ማር. 6:7-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 9:1"/>የሱሳ ታጶ ናምኢ ሀዋርታ ፋኮ ጼጊ፥ ቱና አያንታ ከሶድ ጋርከኔ ሀርገ ኡባ ፓዳይ ጋርክ ዎልቃኔ ማዉተ እንጌዛ። <verse eid="LUK 9:1"/><verse number="2" style="v" sid="LUK 9:2"/>ጾስ ካተት ባዝ ማርካቶድ ጋርክ ሀርግንቴዝታ ፓዳይ ጋርክ ኪቴዛ። <verse eid="LUK 9:2"/><verse number="3" style="v" sid="LUK 9:3"/>ኤ ኡንትኮ፥ «ጉፈ ማቅን ቁርቦ ማቅን ካ ማቅን ሚሸ ማቅን ላሚ ማእዛ አፍላ ማቅን ኦገስ ግ አብካ አይክፓተ።<note caller="-" style="x"><char style="xo" closed="false">9:3-5 </char><char style="xt" closed="false"><ref loc="LUK 10:4-11">ሉቃ. 10:4-11</ref></char></note> <verse eid="LUK 9:3"/><verse number="4" style="v" sid="LUK 9:4"/>የ ካታማፕ ይ ከዞድ ጋ እማትር ይ ገሌዝ አቆ ጋምኦይታ። <verse eid="LUK 9:4"/><verse number="5" style="v" sid="LUK 9:5"/>ኦንካ ይንታን ሞካም እጽኮ የ ካታማፕ ከዝታር ኡንትስ ኤርስዛ ማርካ ማቃዳይ ጋርክ ይ ቶኬ የዝ ቡልአ ፕቲ ከዞይታ።» <verse eid="LUK 9:5"/><verse number="6" style="v" sid="LUK 9:6"/>ኡንትካ ኪትንቴዛይ ጋርክ ከዚ ዎንግለ ኦድታር ዱማ ዱማ ሄራ ሀርግንቴዝታ ፓታር ኣዛ።<verse eid="LUK 9:6"/></para>
  <para style="s1">ሄሮድሳ የሱሳ ዋራ ስኢ ዳጋሞ</para>
  <para style="r">(<ref loc="MAT 14:1-12">ማቶ. 14:1-12</ref>፤ <ref loc="MRK 6:14-29">ማር. 6:14-29</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 9:7"/>ጋልላ ቢታ አቅስዛ ሄሮዶሳ የሱሳ ኦዝ ባዝ ኡባ ስኢ ዳጋሜዛ። አብስ ጊኮ፥ ፐቲ ፐቲ አሳይ ዋንሳ Ꮊይቆፕ ደንደካ አተና ዬግዛ።<note caller="-" style="x"><char style="xo" closed="false">9:7-8 </char><char style="xt" closed="false"><ref loc="MAT 16:14">ማቶ. 16:14</ref>፤ <ref loc="MRK 8:28">ማር. 8:28</ref>፤ <ref loc="LUK 9:19">ሉቃ. 9:19</ref></char></note> <verse eid="LUK 9:7"/><verse number="8" style="v" sid="LUK 9:8"/>ባግታይ፥ «ኤላሳ በንቴዛ» ግዛ፤ Ꮊንክታይ ማ፥ «ብኒ ናብታይፕ ፐታይ Ꮊይቆፕ ደንዴዛ» ዬጊ ኦድንትዛ። <verse eid="LUK 9:8"/><verse number="9" style="v" sid="LUK 9:9"/>ዝን ሄሮዶሳ፥ «ዋንሳ ቆ ታ ጋችሲ ዎዛ። የዝን፥ Ꮊይ ጋርክ ዬግንቲ ኤ ባጋ ኦድንትዛይ፥ ኤ ኦኖ?» ዬጊ የሱሳና ፋ ኣፈር በአዳይስ ኮይዛ።<verse eid="LUK 9:9"/></para>
  <para style="s1">የሱሳ እችን ሙኩለ አስታ ሙዜዛ</para>
  <para style="r">(<ref loc="MAT 14:13-21">ማቶ. 14:13-21</ref>፤ <ref loc="MRK 6:30-44">ማር. 6:30-44</ref>፤ <ref loc="JHN 6:1-14">ዋን. 6:1-14</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 9:10"/>ታጶ ናምኢ ሀዋርታይ ጉየ ማቂ ይኢ፥ ኡንቲ ኦዝ ባዝ ኡባ የሱሳስ ኦዴዛ። ኤ ኡንታን ኤኪ ቤተሳይዳ ካታማ ላንቀ የዝ አቆ ካንጌዛ። <verse eid="LUK 9:10"/><verse number="11" style="v" sid="LUK 9:11"/>ዝን ጋመ አሳይ የሱሳ ማቄዛና ኤሪ ኤዛ ካሌዛ። ኤ ኡንታን ሞኪ ኤኪ ጾስ ካተት ባጋ ታማርሴዛ፤ ፓጾዳይስ ኮይዝታይካ ፓዛ።<verse eid="LUK 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 9:12"/>ሳአ ኦማዳር ታጶ ናምኢ ሀዋርታይ ኤዝኮ ሺቂ፥ «ኑ የዛይ ሊዦ ማቄዝ ግሾስ አሳይ ዱማ ዱማ ሄራራኔ ካታምታ Ꮊንጊ፥ ካኔ አቅዛ ካራ ኮዮድ ጋርክ አሳ ሞይዞባ» ዬጌዛ።<verse eid="LUK 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 9:13"/>ዝን የሱሳ፥ «ኡንትስ ሚዝባዝ ይ እንጎይታ» ዬጌዛ።</para>
  <para style="p" vid="LUK 9:13">ኡንቲ፥ «ኑስ የዛይ እችን ሶሎኔ ናምኢ ሞሎ ማቄዝ ግሾስ Ꮊ አሳይስ ግድዛ ካ ኑኒ Ꮊንጊ ዎንጋም እጽኮ ግዳሚ» ዬጌዛ። <verse eid="LUK 9:13"/><verse number="14" style="v" sid="LUK 9:14"/>የ አቃይድ እችን ሙኩለ ማቅዝ ራታይ የዛ።</para>
  <para style="p" vid="LUK 9:14">የሱሳ ፋ ታማርታይኮ፥ «ኢሻታም እሻታም ሻኪ ሻኪ አሳ በትይታ» ዬጌዛ።<verse eid="LUK 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 9:15"/>ኤ ታማርታይ፥ ኤ ኪቴዛይ ጋርክ አስታ በትዛ። <verse eid="LUK 9:15"/><verse number="16" style="v" sid="LUK 9:16"/>ኤ እችን ሶሎራኔ ናምኢ ሞልታ ኤኪ፥ ሳሎ ብኢ፥ ጾሳ ጋላቲ፥ መን አሳ ኡባ ሄልድ ጋርክ ፋ ታማርታይስ እንጌዛ። <verse eid="LUK 9:16"/><verse number="17" style="v" sid="LUK 9:17"/>ኡባይ ም ምዤዛ። ኡንታፕ አቴዝ ጉፋይ ታጶ ናምኢ ሌማተ ኩን ማቄዛ።<verse eid="LUK 9:17"/></para>
  <para style="s1">ጵጽሮሳ፥ የሱሳ ኦናዛኮ ማርካቴዛ</para>
  <para style="r">(<ref loc="MAT 16:13-19">ማቶ. 16:13-19</ref>፤ <ref loc="MRK 8:27-29">ማር. 8:27-29</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 9:18"/>የሱሳ ፋ አዳ ዎሶዳር፥ ኤ ታማርታይ ኤዝኮ የኤዛ። ፐቲ ጋላስ ኤ፥ «አሳይ ታና ኦና ጌ?» ግ ኦይጬዛ።<verse eid="LUK 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 9:19"/>ኡንቲ ማሂ «ፐታይ ፐታይ፥ ‹ጻማቅዛ ዋንሳ፥ ባግታይ ኤላሳ፥ Ꮊንክታይ ማ፥ ብኒ ናብታይፕ ፐታይ Ꮊይቆፕ ደንዴዛ› ዬግዛ» ግ ማሄዛ።<note caller="-" style="x"><char style="xo" closed="false">9:19 </char><char style="xt" closed="false"><ref loc="MAT 14:1">ማቶ. 14:1</ref>፥ <ref loc="MAT 14:2">2</ref>፤ <ref loc="MRK 6:14-15">ማር. 6:14-15</ref>፤ <ref loc="LUK 9:7-8">ሉቃ. 9:7-8</ref></char></note><verse eid="LUK 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 9:20"/>ኤ ማሂ፥ «የዝን ይ ታና ኦና ጌ» ዬጌዛ። ጵጽሮሳ፥ «ኔኒ ጾሳፕ ትዥንቴዝ ክርስቶሳ» ዬጊ ማሄዛ።<note caller="-" style="x"><char style="xo" closed="false">9:20 </char><char style="xt" closed="false"><ref loc="JHN 16:20-28">ዋን. 16:20-28</ref>፤ <ref loc="MRK 8:30-9:1">ማር. 8:30—9:1</ref></char></note><verse eid="LUK 9:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 9:21"/>የሱሳ Ꮊያ ኦስካ ኦድፓተ ግ ሚን ኦዴዛ።<verse eid="LUK 9:21"/></para>
  <para style="s1">የሱሳና ካሎ ቤዝዛ መቶኔ ኤ Ꮊይቃ</para>
  <para style="r">(<ref loc="MAT 16:20-28">ማቶ. 16:20-28</ref>፤ <ref loc="MRK 8:34-38">ማር. 8:34-38</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 9:22"/>ማካ የሱሳ፥ «አስ ናአይ ጋመ መቶ ኤኮዳ። ጋደ ጭምታይር፥ ቄሰ ሀላቅታይር፥ ህገ አስታማርታይር እጽንቶዳ። ኡንቲ ኤዛ ዎዳ፥ ዝን ኤ ሃይን ጋላስ Ꮊይቆፕ ደንዶዳ» ዬጌዛ።<verse eid="LUK 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 9:23"/>የሱሳ አስ ኡባይኮ፥ «ታና ካሎዳይስ ኮይዛይ ኦንካ የዝኮ ፋና ካዶ፥ ፋ ማዝቃላ ጋላስ ጋላስ<note caller="+" style="f"><char style="fr" closed="false">9:23 </char><char style="ft" closed="false">ማዝቃለ ቶኪ ጉሳይ፦ ፋ መቶ ቶኪ ጉሲ።</char></note>ቶኪ ታና ካሎ።<note caller="-" style="x"><char style="xo" closed="false">9:23 </char><char style="xt" closed="false"><ref loc="MAT 10:38">ማቶ. 10:38</ref>፤ <ref loc="LUK 14:27">ሉቃ. 14:27</ref></char></note> <verse eid="LUK 9:23"/><verse number="24" style="v" sid="LUK 9:24"/>ፋ ሸምፓቶ አሾዳይስ ኮይዝ ኡባይ እዞ ብስዛ፥ ፋ ሸምፓቶ ታ ግሾስ ግ ብስዛ ኦንካ እዞ አሽዛ።<note caller="-" style="x"><char style="xo" closed="false">9:24 </char><char style="xt" closed="false"><ref loc="MAT 10:39">ማቶ. 10:39</ref>፤ <ref loc="LUK 17:33">ሉቃ. 17:33</ref>፤ <ref loc="JHN 12:25">ዋን. 12:25</ref></char></note> <verse eid="LUK 9:24"/><verse number="25" style="v" sid="LUK 9:25"/>አሲ አላመል የዛ ባዝ ኡባ ሞዲ፥ ፋ ሸምፓቶ ብስዛ ባዝ ዎይ ቆህዛ ባዝ ማቅኮ ኤዛ አብ ማዴ? <verse eid="LUK 9:25"/><verse number="26" style="v" sid="LUK 9:26"/>ኦንካ ታላኔ ታ ቃላይል ዬላትኮ አስ ናአይ ፋ ቦንቾር፥ ፋ አዳይ ቦንቻይራኔ ጌሽ ኪታንችታይ ቦንቾር ይእዛ ዎደ ኤ ቲና ዬላቶዳ። <verse eid="LUK 9:26"/><verse number="27" style="v" sid="LUK 9:27"/>ታ ይንትስ ቱሮ ኦድዛ፤ Ꮊይዳ ኤቄዝታይ ጋንጨፐ ጾሳ ካተት በኤካዛር Ꮊይቃም ፐቲ ፐቲ አሳይ የዛ» ዬጌዛ።<verse eid="LUK 9:27"/></para>
  <para style="s1">የሱሳ ጭራይ ላምንቴዛ</para>
  <para style="r">(<ref loc="MAT 17:1-8">ማቶ. 17:1-8</ref>፤ <ref loc="MRK 9:2-8">ማር. 9:2-8</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 9:28"/>የሱሳ የ ኦዳ ኦድን፥ ሆስፑን ጋላሳፕ ጉየ ጵጽሮሳ፥ ያይቆባራኔ ዋንሳ ፓር ኤኪ ዎሶዳይስ ደረል አፋ ከዜዝ።<note caller="-" style="x"><char style="xo" closed="false">9:28-35 </char><char style="xt" closed="false"><ref loc="2PE 1:17-18">2ጵጽ. 1:17-18</ref></char></note> <verse eid="LUK 9:28"/><verse number="29" style="v" sid="LUK 9:29"/>ኤ ዎሳል አፋ የዝን ኤ ጭራይ ላምንቴዛ፤ አፍላይካ አዋ ጋርክ ፎጪ ቦጺ ፎጬዛ። <verse eid="LUK 9:29"/><verse number="30" style="v" sid="LUK 9:30"/>ናምኢ አሳይ፥ ኡንትካ ሙሰራኔ ኤላሳራ ኡንታር ናሽዛ <verse eid="LUK 9:30"/><verse number="31" style="v" sid="LUK 9:31"/>ቦንቾር በንቲ የሩሳላመ ፖልንቶዳይስ የዛ ባዝ፥ የይካ፥ ኤ Ꮊ አላማይፕ ሻክንቶድ ባዝ ኤዛር ኦድንትዛ። <verse eid="LUK 9:31"/><verse number="32" style="v" sid="LUK 9:32"/>ጵጽሮሳራኔ ኤዛር የዝታ ገንታ ኦልን፥ ኡ ገንታፕ ባርኪ ኤ ቦንቻኔ ኤዛር ኤቄዝ ናምኢ አስታ በኤዛ። <verse eid="LUK 9:32"/><verse number="33" style="v" sid="LUK 9:33"/>አሳይ የሱሳፕ ሻክንቲ ቅቶድ ሀኖዳር፥ ጵጽሮሳ የሱሳኮ፥ «ጎዳዮ፥ Ꮊይዳ የስ ኑስ ሎኦ! ፐቶ ኔስ፥ ፐቶ ሙሰስ፥ ፐቶ ኤላሳስ ሀይ ጋባ ጋቢሶዳ» ዬጌዛ። ዝን ኤ ፋ ግዝ ባዝ ኤሮያ።<verse eid="LUK 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 9:34"/>ኤ ዬጊ ናሾዳር ሻራ ይኢ ኡንታን ካሜዛ። ኤ ታማርታይ የ ሻራይ ጋንጨ ገልታር ያሽቴዛ። <verse eid="LUK 9:34"/><verse number="35" style="v" sid="LUK 9:35"/>ሻራይ ጋንጨፐ፥ «ታ ዶሬዝ ናአይ Ꮊያ ኤዛ ስኦይታ» ዬግዝ ቃላ ስንቴዛ።<note caller="-" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="ISA 42:1">ኢሳ. 42:1</ref>፤ <ref loc="MAT 3:17">ማቶ. 3:17</ref>፤ <ref loc="MAT 12:18">12:18</ref>፤ <ref loc="MRK 1:11">ማር. 1:11</ref>፤ <ref loc="LUK 3:22">ሉቃ. 3:22</ref></char></note> <verse eid="LUK 9:35"/><verse number="36" style="v" sid="LUK 9:36"/>የ ቃላይ ስንቴዛይፕ ጉየ የሱሳ ፋ ኣዳስ የዛር በንቴዛ። የ ጋላስ ኡንቲ በኤዝ ባዝ ኦስካ ኦደካዛር፥ ፋ ዎዝና አይኪ ስእ ግ አቴዛ።<verse eid="LUK 9:36"/></para>
  <para style="s1">የሱሳ ቱና አያና ፐቲ ናአይፕ ከሴዛ</para>
  <para style="r">(<ref loc="MAT 17:14-18">ማቶ. 17:14-18</ref>፤ <ref loc="MRK 9:14-27">ማር. 9:14-27</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 9:37"/>ዎንት ኡንቲ ደረላፕ ዎዳር ጋመ አሳይ ይኢ ኤዛ ሄሌዛ። <verse eid="LUK 9:37"/><verse number="38" style="v" sid="LUK 9:38"/>የ ዎደ ዎይታይፕ ፐቲ አሲ ኡክታር፥ «አስታማራዮ፥ ታ ናአይ ፐቶ ኤዛ ፓዳይ ጋርክ ታ ነና ዎስዛ። <verse eid="LUK 9:38"/><verse number="39" style="v" sid="LUK 9:39"/>ቱና አያና ቆፐካዝን አይኪ ኡክስዛ፤ አፋፕ ኦሊ ጋፑንትሲ ቃክትስዛ፥ ጋላ ማዱስዝ ኡንእ ዳክዛ። <verse eid="LUK 9:39"/><verse number="40" style="v" sid="LUK 9:40"/>ነ ታማርታይ ከሶዳይ ጋርክ ዎሴዛ፥ ዝን ኡ ዳንዳኤካያ» ዬጊ ዎሴዛ።<verse eid="LUK 9:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 9:41"/>የሱሳ፥ «አማኖ ባ ዡጫ የለትን፥ አይደ ሄሎዳይስ ታ ይንታር የዞዴ፥ አይደ ሄሎዳዪስ ይንታን ዳንዳኦዴ? ነ ናአ Ꮊና ኤኪ የኦባ» ዬጌዛ።<verse eid="LUK 9:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 9:42"/>ናአ ኤኪ የኦዳር ቱና አያናይ ሾጪ ኦሊ ኩኩርሴዛ። ዝን የሱሳ ቱና አያና ካጪ ናአይፕ ከሲ ፓዛ። ናአናካ ናአይ አዳይስ እንጌዛ። <verse eid="LUK 9:42"/><verse number="43" style="v" sid="LUK 9:43"/>አሳይ ኡባይ ጾሳይስ የዝ ዳሞ ዎልቃ ብኢ ማላባዝ ጌዛ። ኡንቲ ኤ ኦዝ ባዛር ማላባዝ ጊታር፥ የሱሳ ታማርታይኮ፥ <verse eid="LUK 9:43"/><verse number="44" style="v" sid="LUK 9:44"/>«Ꮊያ ታ ይንትስ ኦድዛና ሎእ ስኦይታ፤ አስ ናአይ ሞርክታይ ኩሸ ኣ እንግንቶዳ» ዬጌዛ። <verse eid="LUK 9:44"/><verse number="45" style="v" sid="LUK 9:45"/>ዝን ኤ ጌዝባዛይ ኡንታፕ ቆስንቴዝ ግሾስ መልክ ጌዛ። የይ ግሾስ፥ ማሂ ኦይጮዳይስ ያሽቴዛ።<verse eid="LUK 9:45"/></para>
  <para style="s1">ኡባይፕ ኣ ማቃዳይ ኦኖ?</para>
  <para style="r">(<ref loc="MAT 18:1-5">ማቶ. 18:1-5</ref>፤ <ref loc="MRK 9:33-37">ማር. 9:33-37</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 9:46"/>የሱሳ ታማርታይ፥ «ኑ ጋንጨ ኡባፕ ኣ ማቃዳይ ኦኖ?» ግ ፓላማ አይኬዛ።<note caller="-" style="x"><char style="xo" closed="false">9:46 </char><char style="xt" closed="false"><ref loc="LUK 22:24">ሉቃ. 22:24</ref></char></note> <verse eid="LUK 9:46"/><verse number="47" style="v" sid="LUK 9:47"/>የሱሳ ኡ ዎዝና ቆፋ ኤሪ ዱደ ናአ ፋ ካለ ኤሲ፥ <verse eid="LUK 9:47"/><verse number="48" style="v" sid="LUK 9:48"/>«Ꮊ ዱደ ናአ ታ ሱንር ሞክዛ ኦንካ ታና ሞክዛ፥ ታና ሞክዛይ ታና አዛዜዛና ሞክዛ፥ ይ ኡባይፕ ጽቅዛይ፥ ኤ ኣ ማቃዳ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">9:48 </char><char style="xt" closed="false"><ref loc="MAT 10:40">ማቶ. 10:40</ref>፤ <ref loc="LUK 10:16">ሉቃ. 10:16</ref>፤ <ref loc="JHN 13:20">ዋን. 13:20</ref></char></note><verse eid="LUK 9:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 9:49"/>ዋንሳ ማሂ «ጎዳዮ ፐቲ አይ ነ ሱንር ጻላሄ ከሶዳር ኑ በኤዛ። ዝን ኤ ኑ ባጋ ማቀካ ግሾስ ኑ ኤዛ ካዬዛ።»<verse eid="LUK 9:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 9:50"/>የሱሳ ማሂ «ይንታን እጾዋ ኡባይ ይንታር የዛ ካይፓተ» ዬጌዛ።<verse eid="LUK 9:50"/></para>
  <para style="s1">ሳማረ አሳይ የሱሳና እጼዛ</para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 9:51"/>የሱሳ ሳሎ Ꮊንግዛ ዎዳይ ኡኬዝ ግሾስ የሩሳላመ Ꮊማዳይስ ሙርቲ ደንዴዛ። <verse eid="LUK 9:51"/><verse number="52" style="v" sid="LUK 9:52"/>ሳማረ ቢታ የዝ ፐቲ ሄራ Ꮊንጊ፥ ኡባ ባዝ ኤዝስ ጊግሶዳይ ጋርክ አሳ የ አቃ ኪቴዛ። <verse eid="LUK 9:52"/><verse number="53" style="v" sid="LUK 9:53"/>ዝን ኤ Ꮊንግዛይ የሩሳላመ ማቅዛና ኡ ኤርዛ ግሾስ ሞኪ ኤከካያ። <verse eid="LUK 9:53"/><verse number="54" style="v" sid="LUK 9:54"/>የሱሳ ታማርታይ ያይቆባራ ዋንሳራ የያ ብኢ፥ «ጎዳዮ፥ ሳሎፕ ታማ ዎ ኡንታን ሙየ ጎድ ጋርክ ነ ኮይኔ?» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">9:54 </char><char style="xt" closed="false"><ref loc="2KI 1:9-16">2ካት. 1:9-16</ref></char></note> <verse eid="LUK 9:54"/><verse number="55" style="v" sid="LUK 9:55"/>ዝን የሱሳ ጉየ ማቂ ኡንታን ካጪ፥ ይንታል አባ አያና የዛኮ ይ ኤሮያ። [«ይንታል አፋ አባ አያና የኔ። Ꮊ ቆፋይ ፐቲ ፐቲ ማጻፍታይድ ባያ አስ ናአይ አስ አሾዳይስ የኤዛይፕ አትን ብሶዳይስ ባያ»]<note caller="+" style="f"><char style="fr" closed="false">9:55</char></note> ዬጌዛ። <verse eid="LUK 9:55"/><verse number="56" style="v" sid="LUK 9:56"/>ኤዛይፕ ደንዲ ሀራ ሄራ Ꮊንጌዛ።<verse eid="LUK 9:56"/></para>
  <para style="s1">የሱሳ ካሎ ጭግስዛ ጋተ</para>
  <para style="r">(<ref loc="MAT 8:19-22">ማቶ. 8:19-22</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 9:57"/>የሱሳራ ኤ ታማርታይራ ኦገር Ꮊማዳር፥ ፐቲ አሲ፥ «ጎዳዮ ነ Ꮊንግዛ አቆ ኡባ ታ ካሎዳ» ዬጌዛ።<verse eid="LUK 9:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 9:58"/>የሱሳ ማሂ፥ «ሻንታይስ ኦላ፥ ሳሎ ካፍታይስ ኬ የዛ፥ ዝን አስ ናአይ ፋ ኦማ ሸምፕስዛ አቆ ባያ» ዬጌዛ።<verse eid="LUK 9:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 9:59"/>Ꮊንካይኮካ፥ «ኔኒ ታና ካሎባ» ዬጌዛ። ዝን አይ፥ «ጎዳዮ፥ ቲናቲ Ꮊንጊ ታ ታ ኣዳ ሞጊ የኦዳ» ዬጌዛ።<verse eid="LUK 9:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 9:60"/>ዝን የሱሳ፥ «Ꮊይቄዝታይ Ꮊይቄዝታ ሞጎድ ጋርክ ኡንትስ አሺ አሾባ፤ ኔኒ Ꮊንጊ ጾሳ ካተት ሳባኮባ» ዬጌዛ።<verse eid="LUK 9:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 9:61"/>ማ ሀራ አሲ፥ «ጎዳዮ፥ ታ ነና ካሎዳ፥ ዝን ቲናቲ ታ ካራ አሳ ሳሮ የኦዳ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">9:61 </char><char style="xt" closed="false"><ref loc="1KI 19:20">1ካት. 19:20</ref></char></note><verse eid="LUK 9:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="LUK 9:62"/>የሱሳ ማሂ፥ «ኮጸ አይኪ ጉየ ብእዝ ኦንካ ጾሳ ካተትይስ ቤዞያ» ዬጌዛ።<verse eid="LUK 9:62"/></para>
  <chapter eid="LUK 9"/>
  <chapter number="10" style="c" sid="LUK 10"/>
  <para style="s1">የሱሳ ላፑን ታማኔ ናምኢ ታማርታ ኪቴዛ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 10:1"/>የይፕ ጉየ፥ ጎዳይ ሀራ ላፑን ታማኔ ናምኢ<note caller="+" style="f"><char style="fr" closed="false">10:1 </char><char style="fqa" closed="false">ላፑን ታማኔ ናምኢ፦ </char><char style="ft" closed="false">ፐቲ ፐቲ ማጻፍታይ ላፑን ታም ግዛ።</char></note> አስታ ዶሬዛ። ኤ Ꮊማዳይስ ቆፔዝ ካታማኔ ሄራ ኡባ ቲናቲ Ꮊማድ ጋርክ ናምኤ ናምኤ ኡዲ ኪቴዛ። <verse eid="LUK 10:1"/><verse number="2" style="v" sid="LUK 10:2"/>የሱሳ ኡንትኮ፥ «ይኬ ሺቆድ ቶርቼ ካይ ጋመ ዝን ቶርቼ ኦሶ አሳይ ጽቃ። ዬዬዝ ግሾስ፥ ቶርቼ ካ ጎዳይ ኦሶ አስታ ኪቶዳ ጋርክ ዎሶይታ።<note caller="-" style="x"><char style="xo" closed="false">10:2 </char><char style="xt" closed="false"><ref loc="MAT 9:37-38">ማቶ. 9:37-38</ref></char></note> <verse eid="LUK 10:2"/><verse number="3" style="v" sid="LUK 10:3"/>ይኬ፥ Ꮊንጎይታ፥ ዱርታይ ጋርክ ፉግታይ ጋንጨ ይንታን ታ ዳኮዳ።<note caller="-" style="x"><char style="xo" closed="false">10:3 </char><char style="xt" closed="false"><ref loc="MAT 10:16">ማቶ. 10:16</ref></char></note> <verse eid="LUK 10:3"/><verse number="4" style="v" sid="LUK 10:4"/>ይ Ꮊንግታር ኦገስ Ꮊይትታ አይክፓተ፥ ሚሸ ማቅን ካ ማቅን ጫማ አይክፓተ። ኦገል አፋ ኦናካ ሳሮታር ዎዴ ኣፓተ።<note caller="-" style="x"><char style="xo" closed="false">10:4 </char><char style="xt" closed="false"><ref loc="MAT 10:7-14">ማቶ. 10:7-14</ref>፤ <ref loc="MRK 6:8-11">ማር. 6:8-11</ref>፤ <ref loc="LUK 9:3-5">ሉቃ. 9:3-5</ref></char></note> <verse eid="LUK 10:4"/><verse number="5" style="v" sid="LUK 10:5"/>ይ ገልዛ ኬ ኡባ ቲናቲ፥ ‹ሳሮ Ꮊ ኬይስ ማቆ› ዬጎይታ። <verse eid="LUK 10:5"/><verse number="6" style="v" sid="LUK 10:6"/>ሳሮ ቃዛ አስ የ አቃይድ የዝኮ፥ ይ ሳራይ ኤዛይድ አቆዳ፤ እጽኮ ይ ሳራይ ይንትስ ማቆዳ። <verse eid="LUK 10:6"/><verse number="7" style="v" sid="LUK 10:7"/>ኦሶ አስስ ዳሞዘ ቤዝዛ ግሾስ ይ ገሌዝ ኬ ይንትስ ሺሼዝ ባዝ ኡባ ሚታራኔ ኡዥታር ኤዛይድ ጋምኦይታ። ፐታይ ካራፕ ፐታይ ካራ ዩይፓተ።<note caller="-" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="1CO 9:14">1ቆሮ. 9:14</ref>፤ <ref loc="1TI 5:8">1ጽማ. 5:8</ref></char></note> <verse eid="LUK 10:7"/><verse number="8" style="v" sid="LUK 10:8"/>አባ ካታማካ ይ ገሎዳር አሳይ ይንታን ሞኪ፥ ይንትስ ሺሼዝ ባዝ ኡባ ሞይታ። <verse eid="LUK 10:8"/><verse number="9" style="v" sid="LUK 10:9"/>የ ካታማ ጋንጨ የዝ ሀርግንቴዝታ ፓታር፥ ‹ጾሳ ካተትይ ይንትኮ ኡኬዛ› ዬጊ ኦዶይታ። <verse eid="LUK 10:9"/><verse number="10" style="v" sid="LUK 10:10"/>ዝን ፐቲ ካታማ ገሎዳር አሳይ ይንታን ሞካም እጽኮ ዞዘል ከዚ Ꮊይ ጋርከ ጎይታ:<note caller="-" style="x"><char style="xo" closed="false">10:10-11 </char><char style="xt" closed="false"><ref loc="ACT 13:51">ሀዋ. ኦ. 13:51</ref></char></note> <verse eid="LUK 10:10"/><verse number="11" style="v" sid="LUK 10:11"/>‹ኑ ቶካይል አፋ የዝ ይ ካታማይ ቡልአ ኑ ፕቶዳ፥ ዝን ጾስ ካተትይ ይንትኮ ኡኬዛና ኤሮይታ›<note caller="-" style="x"><char style="xo" closed="false">10:11 </char><char style="xt" closed="false"><ref loc="MAT 10:7-14">ማቶ. 10:7-14</ref>፤ <ref loc="MRK 6:8-11">ማር. 6:8-11</ref>፤ <ref loc="LUK 9:3-5">ሉቃ. 9:3-5</ref></char></note> <verse eid="LUK 10:11"/><verse number="12" style="v" sid="LUK 10:12"/>ፕርዳ ጋላስ Ꮊ ካታማትፕ ሶዶመ ካታማስ ፕርዳይ ካዉሻ ማቃዳና ታ ይንትስ ኦድዛ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">10:12 </char><char style="xt" closed="false"><ref loc="GEN 19:24-28">መ. 19:24-28</ref>፤ <ref loc="MAT 10:15">ማቶ. 10:15</ref>፤ <ref loc="MAT 11:24">11:24</ref></char></note><verse eid="LUK 10:12"/></para>
  <para style="s1">አማኖዋ ግሾስ ቦርንቴዝ ካታምቶ</para>
  <para style="r">(<ref loc="MAT 11:20-24">ማቶ. 11:20-24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 10:13"/>ማ ማቅካ፥ የሱሳ፥ «ነኖ ኮራዝኔ፥ ነኖ ቤተሳይዳ፥ አየ፥ ይንታል ኦስንቴዝ ማላትታይ ጽሮሳኔ ስዶና ኦስንቴዛኮ ኤዛይድ የዝ አሳይ ካዮ አፍላ ማኢ፥ ቡዶል አፋ በቲ ብኒ ማሮተ ገሊ አቶዳዝን።<note caller="-" style="x"><char style="xo" closed="false">10:13 </char><char style="xt" closed="false"><ref loc="ISA 23:1-18">ኢሳ. 23:1-18</ref>፤ <ref loc="EZK 26:1-21">ኢዝቀ. 26:1-21</ref>፤ <ref loc="JOL 3:4-8">ኢዩ. 3:4-8</ref>፤ <ref loc="AMO 1:9-10">አሞ. 1:9-10</ref>፤ <ref loc="ZEC 9:2-4">ዛክ. 9:2-4</ref></char></note> <verse eid="LUK 10:13"/><verse number="14" style="v" sid="LUK 10:14"/>የይ ግሾስ፥ ይንትፕ ኣ ጽሮሳስኔ ስዶናስ ጾስ ፕርዳይ ካዉዦዳ። <verse eid="LUK 10:14"/><verse number="15" style="v" sid="LUK 10:15"/>Ꮊኔ ቅፍርናሆመ፥ ሳሎ ሄሎዳይስ ነ ቅ ጌኔ? ነ ሱል ስኦለ ዎዳ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="ISA 14:13-15">ኢሳ. 14:13-15</ref></char></note><verse eid="LUK 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 10:16"/>ማካ የሱሳ ፋ ታማርታይኮ፥ «ይንታን ስእዛይ ታና ስእዛ፥ ይንታን ኤኮዛይ ታና ኤኮያ፥ ታና ኤኮዛይ ታና አዛዜዛና ኤኮያ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="MAT 10:40">ማቶ. 10:40</ref>፤ <ref loc="MRK 9:37">ማር. 9:37</ref>፤ <ref loc="LUK 9:48">ሉቃ. 9:48</ref>፤ <ref loc="JHN 13:20">ዋን. 13:20</ref></char></note><verse eid="LUK 10:16"/></para>
  <para style="s1">ላፑን ታማኔ ናምእታይ ማቄዛ</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 10:17"/>ላፑን ታማኔ ናምኢ ታማርታይ ኪትንቴዝ አቃይፕ ሎእ ኡፋይትታር ማቄዛ። የሱሳኮ ሺቂ፥ «ጎዳዮ፥ ነ ሱንር ቱና አያንታይካ ኑስ አዛዝንቴዛ» ዬጌዛ።<verse eid="LUK 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 10:18"/>የሱሳ ኡንትኮ፥ «ጻላሄ ሳሎፕ ዳዳ ጋርክ ዎዳር ታ በኤዛ። <verse eid="LUK 10:18"/><verse number="19" style="v" sid="LUK 10:19"/>ዬዛኮ፥ ሾሽኔ Ꮊንጋርጮ የድ ጋርከኔ ሞርከ ዎልቃር ኤቅንቶድ ጋርክ ይንትስ ታ ማዉተ እንጌዛ። ይንታን ቆሆድ ባዝ አኮካ ባያ።<note caller="-" style="x"><char style="xo" closed="false">10:19 </char><char style="xt" closed="false"><ref loc="PSA 19:13">ማዝ. 19:13</ref></char></note> <figure style="fig" alt="Scorpion" file="BK00058B.tif" size="span" ref="10:19">ኮርነ</figure> <verse eid="LUK 10:19"/><verse number="20" style="v" sid="LUK 10:20"/>ማቆዝን፥ ይ ሱንይ ሳሎ ማዝጋባይድ ጻፍንቴዝ ግሾስ ኡፋይቶይታፕ አትን ቱና አያንታይ ይንትስ ኪትንቴዝ ግሾስ ኡፋይትፓተ» ዬጌዛ።<verse eid="LUK 10:20"/></para>
  <para style="s1">የሱሳ ፋ ኡፋይሳ ቤዜዛ</para>
  <para style="r">(<ref loc="MAT 11:25-27">ማቶ. 11:25-27</ref>፤ <ref loc="MAT 13:16-17">13:16-17</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 10:21"/>የ ዎደ የሱሳ ጌሻ አያናር ኡፋይቲ፥ «ሳሎ ሳአ ጎዳዮ፥ Ꮊያ ኤጭታይፐኔ ኤራንችታይፐ ቆሲ ዱደ ናእታይስ ቤዜዝ ግሾስ ታ ነና ጋላትዛ። ኤ ታ አዳዮ፥ የያ ነ ኦዳይስ ሎኦ ሸነ ማቄዛ።<verse eid="LUK 10:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 10:22"/>«ኡባ ባዝ ታ አዳይፕ ታስ እንግንቴዛ። ናአይ ኦናዛኮ አዳይፕ አትን ሀራ ዎይ ናአይ ቆንጭሶዳይስ ኮይዛይፕ ሀራ ኦንካ ኣዳ ኤርዛይ ባያ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">10:22 </char><char style="xt" closed="false"><ref loc="JHN 3:35">ዋን. 3:35</ref>፤ <ref loc="JHN 10:15">10:15</ref></char></note><verse eid="LUK 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 10:23"/>ማ ማቅካ፥ የሱሳ ዱማ ፋ ታማርታይኮ፥ «ይ በኤዛና ብእዝታይ አንጅንቴዝታ። <verse eid="LUK 10:23"/><verse number="24" style="v" sid="LUK 10:24"/>ቱማ ጋመ ናብታይኔ ካትታይ ይ ብእዛኔ ስእዛና በአዳይስኔ ስኦዳይስ አሞቴዛ፥ ዝን ኡ በኤካያ፥ ስኤካያ» ዬጌዛ።<verse eid="LUK 10:24"/></para>
  <para style="s1">ኬሃ ሳማረ አ</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 10:25"/>ዬዛኮ፥ ፐቲ ጋላስ ሙሰ ህገ ኤርዛ ፐቲ አይ ደንዲ የሱሳ ዬጊ ፓጨ ኦይች ኦይጬዛ። «አስታማራዮ፥ መናስ ደኦ ላቶዳይስ ታኒ አብ ኡዶ?» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">10:25-28 </char><char style="xt" closed="false"><ref loc="MAT 22:35-40">ማቶ. 22:35-40</ref>፤ <ref loc="MRK 12:28-34">ማር. 12:28-34</ref></char></note><verse eid="LUK 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 10:26"/>የሱሳ፥ «ሙሰ ማጻፋይድ ጻፍንቴዛይ ዋጌ? ነ ዋይዚ ናባብ አካኬ?» ዬጌዛ።<verse eid="LUK 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 10:27"/>አይ ማሂ፥ « ‹ነ ጎዳ ነ ጾሳ፥ ነ ኩን ዎዝናፐ፥ ነ ኩን ሸምፖፕ፥ ነ ኩን ዎልቃፐኔ ነ ኩን ቆፋፕ ቃባ። ማካ ነ ላጋ ነ ኡባይ ጋርክ ቃባ› ዬግዛ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">10:27 </char><char style="xt" closed="false"><ref loc="LEV 19:18">ለዊ. 19:18</ref>፤ <ref loc="DEU 6:5">ናምእ. 6:5</ref></char></note><verse eid="LUK 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 10:28"/>የሱሳ ኤዝኮ፥ «ኔኒ ይኖ ልኬ ማሄዛ፥ ኔካ Ꮊይ ጋርክ ኦባ። ነ መናስ ደኦ የዞዳ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">10:28 </char><char style="xt" closed="false"><ref loc="LEV 18:5">ለዊ. 18:5</ref></char></note><verse eid="LUK 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 10:29"/>ዝን አይ ፋና ጌሽ ኦዳይስ ኮዢ፥ «ሀኖስ ኤ ታ ላጋይ ኦኖ?» ዬጌዛ።<verse eid="LUK 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 10:30"/>ኤ ኦይቻይስ የሱሳ ዬጊ ማልሰ እንጌዛ፥ «ፐቲ አሲ የዛይ የሩሳላመ ካታማፐ ሱለ ኢያርኮ ካታማ Ꮊማዳር ኦገል አፋ ፓንታይ ከዚ ሾጬዛ። ኤ አፍላ ቃሪ ኤኪ Ꮊይቆፐኔ ፓፕ ጋንጨ ኦሊ ቅቴዛ። <verse eid="LUK 10:30"/><verse number="31" style="v" sid="LUK 10:31"/>ጉየፕ፥ አይሁደ ቄሰ ፐታይ የ ኦጋይር ፋ Ꮊሞ Ꮊንግታር አ ብኢ ደሽ ግ ኣዛ። <verse eid="LUK 10:31"/><verse number="32" style="v" sid="LUK 10:32"/>ማካ ፐቲ ለዋይ የ አቃ ሄልታር አ ብኢ ሀራ ኦገር ኣ ቅቴዛ። <verse eid="LUK 10:32"/><verse number="33" style="v" sid="LUK 10:33"/>ዝን፥ ፐቲ ሳማረ ቢታ አስ የዛይ የ ኦጋይር ይእታር አ ብኢ ኤስ ቃንቴዛ<note caller="-" style="x"><char style="xo" closed="false">10:33-34 </char><char style="xt" closed="false"><ref loc="2CH 28:15">2ዜና. 28:15</ref></char></note> <verse eid="LUK 10:33"/><verse number="34" style="v" sid="LUK 10:34"/>ኤዝኮ ሺቂ፥ ኤ ማዶይል አፋ ዛይተኔ ዎይነ ቆል አጬዛ። ፋ ሀረል አፋ በት እማ አቅዝ ኬ ካንጌዛ። የ አቃይድ ኤዝስ ኮሽዛ ባዝ ኡባ ኦዛ። <verse eid="LUK 10:34"/><verse number="35" style="v" sid="LUK 10:35"/>ዎንት ናምኢ ዲናረ ማሂ እማ ካራ አዳይስ እንጊ፥ ‹ሀያና Ꮊ አ ሎእ ቦኦባ። ታኒ ኔስ እንጌዛይፕ አፋር ነ ከስዛ ባዝ ኡብታ ታ ኔስ ጭጎዳ› ዬጌዛ።<verse eid="LUK 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 10:36"/>«ይኬ፥ Ꮊ ሀይ አስታይፕ ፓንታይ ሾጬዝ አይስ ላጌ ማቄዛይ ኔስ ኦና ኣዜ?»<verse eid="LUK 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 10:37"/>አይ ማሂ፥ «ኤዝስ ቃንቴዛያ» ዬጌዛ።</para>
  <para style="p" vid="LUK 10:37">የሱሳ፥ «ኔካ Ꮊንጊ Ꮊይ ጋርክ ኦባ» ዬጌዛ።<verse eid="LUK 10:37"/></para>
  <para style="s1">የሱሳ ማርታኔ ማይራሚ ካራ</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 10:38"/>የሱሳ ፋ ታማርታይር ኦገ Ꮊንግታር ፐቲ ሄራ ሄሌዛ። ኤዛይድ ማርታ ግንትንትዝ ፐቲ አስታ ኤዛ ፋ ካራ ሞኬዛ።<note caller="-" style="x"><char style="xo" closed="false">10:38-39 </char><char style="xt" closed="false"><ref loc="JHN 11:1">ዋን. 11:1</ref></char></note> <verse eid="LUK 10:38"/><verse number="39" style="v" sid="LUK 10:39"/>እዝስካ ማይራሞ ግዝ ምሽታ የዛ፥ ማይራማ ቃላ ስእታር ጎዳይ ቶኬ ካለ በቴዛ። <verse eid="LUK 10:39"/><verse number="40" style="v" sid="LUK 10:40"/>ዝን ማርታ ጋመ ኦሶር ኡንእንቲ የሱሳኮ ሺቂ፥ «ጎዳዮ፥ ታ ምሽታ ኦሶ ታ ኣዳስ አሺ በቲ አትን ታ ዳቡሮዳር ነ ብእታር ስኢ ግኔ? እዛ ታና ማዶድ ጋርክ ኦዶሳ» ዬጌዛ።<verse eid="LUK 10:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 10:41"/>ዝን ጎዳይ Ꮊይ ጋርክ ግ ማሄዛ፥ «ማርታ፥ ማርታ፥ ነ ጋመባዛር ቱርቱሪ መትንትዛ። <verse eid="LUK 10:41"/><verse number="42" style="v" sid="LUK 10:42"/>ማቆዝን፥ ኮይንትዛይ ፐትባዝ ኣዳ። ማይራማ ሎኦ ባዝ ዶሬዛ፥ የይካ እዝፐ ኤክንታሚ» ዬጌዛ።<verse eid="LUK 10:42"/></para>
  <chapter eid="LUK 10"/>
  <chapter number="11" style="c" sid="LUK 11"/>
  <para style="s1">የሱሳ ዎሳ ባጋ ታማርሴዛ</para>
  <para style="r">(<ref loc="MAT 6:9-13">ማቶ. 6:9-13</ref>፤ <ref loc="MAT 7:7-11">7:7-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 11:1"/>ፐቲ ጋላስ የሱሳ ፐቲ አቆ ዎስዛ። ዎሳ ዉርሴዛይፕ ጉየ ኤ ታማርታይፕ ፐታይ፥ «ጎዳዮ፥ ዋንሳ ፋ ታማርታ ዎሳ ታማርሴዛይ ጋርክ ኔካ ኑና ዎሳ ታማርሶባ» ዬጌዛ።<verse eid="LUK 11:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 11:2"/>የሱሳ፥ «Ꮊይ ጋርከ ዬጊ ዎሶይታ፦</para>
  <para style="q1" vid="LUK 11:2">«‹ሳሎ የዝ ኑ አዳዮ</para>
  <para style="q2" vid="LUK 11:2">ነ ጌሽ ሱንይ አንጅንቶ፤</para>
  <para style="q2" vid="LUK 11:2">ነ ካተትይ የኦ።<verse eid="LUK 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LUK 11:3"/>ኑስ ጋላሳ ካ Ꮊይኖ ኑስ እንጎባ።<verse eid="LUK 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LUK 11:4"/>ኑና ቆሄዝታ ኑኒ አቶ ግዛይ ጋርክ፥</para>
  <para style="q2" vid="LUK 11:4">ኑ ናጋራ አቶ ጎባ፤</para>
  <para style="q2" vid="LUK 11:4">ፓጨ ጋንጨ ኑና ገልስፐ› ዬጎይታ»</para>
  <para style="m" vid="LUK 11:4">ዬጌዛ።<verse eid="LUK 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 11:5"/>ማቅካ፥ የሱሳ ፋ ታማርታይኮ ዬጌዛ፦ «ኣዝሶስ ይንትፕ ፐታይስ ላጌ የዛ። ኤ ግዲ ብላሄ ፋ ላጋይ ካራ Ꮊንጊ፥ ‹ታ ላጋዮ፥ ሀይ ሶሎ ታስ ታልኦየ። <verse eid="LUK 11:5"/><verse number="6" style="v" sid="LUK 11:6"/>ታስ ላጌ ማቄዝ ፐቲ አሲ ኦገፕ ይእን፥ ኤዝስ ኣድ ባዝ ታና ቤዛ› ዬግኮ፥<verse eid="LUK 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 11:7"/>«ኤ ላጋይ ኬ ጋንጨ የዚ፥ ‹ሀያና ታና ዋይፐ፥ ፐንጋይ ኮብንቴዛ። ታ ናእታይካ ታር አርሳል አፋ ዎይኤዛ። የይ ግሾስ፥ ደንዲ ነ ኮዬዝ ባዛ እንጎዳይስ ዳንዳኦያ› ዬግነኔ? <verse eid="LUK 11:7"/><verse number="8" style="v" sid="LUK 11:8"/>ታ ይንትስ ኦድዛ፤ ላገትይ ግሾስ ደንዲ እማዳይስ ኮየካ ማቅኮካ ዎሳር ዋይዝ ግሾስ ደንዲ ኮይዝ ባዝ ኡባ እንግዛ።<verse eid="LUK 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 11:9"/>«የይ ግሾስ፥ ታኒ ይንትስ ኦድዛ፤ ዎሶይታ ይንትስ እንግንቶዳ፤ ኮዦይታ ይ ደንጎዳ፤ ባለ ይኢ ጼጎይታ ይንትስ ዶይንቶዳ። <verse eid="LUK 11:9"/><verse number="10" style="v" sid="LUK 11:10"/>ዎስዛ ኡባይ ኤክዛ፤ ኮይዛይ ደንግዛ፤ ባለ ይኢ ጼግዛይስ ዶይንቶዳ።<verse eid="LUK 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 11:11"/>«ይንታኖ፥ አድታዮ ይ ጋንጨፕ ናአ ቦራ ዎስኮ ሹች እንግዛይ ኦኖ? ሞሎ ዎስኮ ሾሺ እንግዛይ ኦኖ? <verse eid="LUK 11:11"/><verse number="12" style="v" sid="LUK 11:12"/>ዎይ ጱጱለ ዎስኮ Ꮊንጋርጮ እንግኔ? <verse eid="LUK 11:12"/><verse number="13" style="v" sid="LUK 11:13"/>ይ ኢትታ ማቅታር ይ ናእታይስ ሎኦ ባዝ እሞ ኤርኮ፥ ሳሎ የዝ ይ አዳይ ዎስዝታይስ ጌሻ አያና ዋይዚ ኣ እንጋሞ?» ዬጌዛ።<verse eid="LUK 11:13"/></para>
  <para style="s1">የሱሳራኔ ብኤልዘቡላራ</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 11:14"/>ፐቲ ጋላስ የሱሳ ዶና ሙምሴዝ ቱና አያና ፐቲ አይፕ ከሴዛ። ቱና አያናይ ከዜዛን ጋርክ ሙመ አይ ኦድንቴዛ። ዎያይካ ማላባዝ ጌዛ። <verse eid="LUK 11:14"/><verse number="15" style="v" sid="LUK 11:15"/>ዝን ፐታይ ፐታይ፥ «ቱና አያና ሀላቃ፥ ብኤልዘቡላ ዎልቃር ቱና አያንታ ከስዛ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">11:15 </char><char style="xt" closed="false"><ref loc="MAT 9:34">ማቶ. 9:34</ref>፤ <ref loc="MAT 10:25">10:25</ref></char></note> <verse eid="LUK 11:15"/><verse number="16" style="v" sid="LUK 11:16"/>Ꮊንክታይ ማ ፋጮዳይስ ሳሎፕ ማላ ቤዞዳይ ጋርክ ኮዬዛ።<note caller="-" style="x"><char style="xo" closed="false">11:16 </char><char style="xt" closed="false"><ref loc="MAT 12:38">ማቶ. 12:38</ref>፤ <ref loc="MAT 16:1">16:1</ref>፤ <ref loc="MRK 8:11">ማር. 8:11</ref></char></note><verse eid="LUK 11:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 11:17"/>ዝን የሱሳ ኡ ቆፋ ኤሪ ኡንትኮ፥ «ዎል ጋንጨ ሻክንትዛ ካተት ኡቢታይ ብዛ፤ ዎል ጋንጨ ሻክንትዛ ኬ ዎድዛ። <verse eid="LUK 11:17"/><verse number="18" style="v" sid="LUK 11:18"/>ጻላሄ ካተትይ ሻክንትኮ ኤ ካተትይ ዋይዚ ሚንጊ ኤቆዴ? ይ ታና፥ ‹ኤ ቱና አያንታ ብኤልዘቡላ ዎልቃር ከስዛ› ግዛ። <verse eid="LUK 11:18"/><verse number="19" style="v" sid="LUK 11:19"/>ይኬ፥ ታኒ ቱና አያና ብኤልዘቡላ ዎልቃር ከስዛ ባዝ ማቅኮ ይንታን ካልዝታይ ኦ ዎልቃር ከሶደሻ? የይ ግሾስ፥ ኡንቲ ይንታል አፋ ፕርድዝታ ማቆዳ። <verse eid="LUK 11:19"/><verse number="20" style="v" sid="LUK 11:20"/>ዝን ታኒ ቱና አያንታ ጾስ ዎልቃር ከስዛ ባዝ ማቅኮ ይኬ ጾሳ ካተትይ ይንትኮ ኡኬዛና ኤሮይታ።<verse eid="LUK 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 11:21"/>«ሚን አስ ዳንጭንቲ ፋ ኬ ናግዝ ማቅኮ፥ ኤ ሻላይ ቦችንተና። <verse eid="LUK 11:21"/><verse number="22" style="v" sid="LUK 11:22"/>ሀኖ ዝን፥ ኤዝፕ ኣ ሚን ማቄዝ አስ ይኢ፥ ኤዛ ጋሚ ኤ አማንንቲ ዳንጬዝ ዳንጫ ብልሲ፥ ኤ ሻላና ቦንቂ ሻግዛ።<verse eid="LUK 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 11:23"/>«ታር ዎላ ማቀካዛይ ታና እጽዛ፤ ታር ሺሾዛይካ ላልዛ።<note caller="-" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="MRK 9:40">ማር. 9:40</ref></char></note><verse eid="LUK 11:23"/></para>
  <para style="s1">ቱና አያና ባጋ</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 11:24"/>«ቱና አያናይ አሳፕ ከዜዝ ዎደ ሸምፕዛ አቆ ኮዪ ሃ ባ አቆር ዩይዛ። ሸምፕዛ አቆ ቤዝ ዎደ ‹ማቂ ታ ከዜዝ ካርቴ Ꮊማዳ› ዬግዛ። <verse eid="LUK 11:24"/><verse number="25" style="v" sid="LUK 11:25"/>ኤ ማቅዝ ዎደ ኬይ ፕትንቲ ሎእ የዝን ደንጌዛ። <verse eid="LUK 11:25"/><verse number="26" style="v" sid="LUK 11:26"/>የይፕ ጉየ፥ Ꮊንጊ ኤዝፕ ኣ ኢቴዝ ሀራ ላፑን ቱና አያንታ ኤኪ ይእዛ። ኤዛል ገሊ የስ አይክዛ። የ አይስ ቲናሳይፕ ጉዬሳይ ኣ ኢታ ማቅዛ» ዬጌዛ።<verse eid="LUK 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 11:27"/>የሱሳ የያ ኦዳል አፋ የዝን ፐቲ አስታ ዎያ ጋንጨፕ ደንዲ፥ ፋ ቃላ ቅ ኡዲ፥ «ነና ቶኬዝ ኡላይኔ ነ አሜዝ አምታይ አንጅንቴዛ» ዬጌዛ።<verse eid="LUK 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 11:28"/>ዝን ኤ፥ «አንጅንቴዝታይ ጾስ ቃላ ስኢ ኪትንትዝታ» ዬጌዛ።<verse eid="LUK 11:28"/></para>
  <para style="s1">ዮናሳ ማላ</para>
  <para style="r">(<ref loc="MAT 12:38-42">ማቶ. 12:38-42</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 11:29"/>ጋመ አሳይ ሺቄዝ ዎደ የሱሳ፥ «Ꮊ የለትይ ኢታ፤ ማላ ኮይዛ። ዝን ዮናሳ ማልታይፕ አትን ሀራ ኡንትስ እንግንቶያ።<note caller="-" style="x"><char style="xo" closed="false">11:29 </char><char style="xt" closed="false"><ref loc="MAT 16:4">ማቶ. 16:4</ref>፤ <ref loc="MRK 8:12">ማር. 8:12</ref></char></note> <verse eid="LUK 11:29"/><verse number="30" style="v" sid="LUK 11:30"/>ዮናሳ ናናወ አሳይስ ማላ ማቄዛይ ጋርክ አስ ናአይካ Ꮊ የለትይስ ማላ ማቃዳ።<note caller="-" style="x"><char style="xo" closed="false">11:30 </char><char style="xt" closed="false"><ref loc="JHN 3:4">ዋን. 3:4</ref></char></note> <verse eid="LUK 11:30"/><verse number="31" style="v" sid="LUK 11:31"/>ካታታ ሳባ ፕርደ ጋላስ Ꮊ የለትይራ ደንዲ ፕርዶዳ። አብስ ጊኮ፥ እዛ ሶሎሞነ ኤጨት ስኦዳይስ ቢታ ጋጻፕ ደንዲ የኤዛ። ዬዛኮ ሶሎሞነፕ ኣዛይ Ꮊይዳ የዛ<note caller="-" style="x"><char style="xo" closed="false">11:31 </char><char style="xt" closed="false"><ref loc="1KI 10:1-10">1ካት. 10:1-10</ref>፤ <ref loc="2CH 9:1-12">2ዜና. 9:1-12</ref></char></note> <verse eid="LUK 11:31"/><verse number="32" style="v" sid="LUK 11:32"/>ናናወ አሳይ ፕርደ ጋላስ Ꮊ የለትይራ ደንዲ ኡንታል አፋ ፕርዶዳ። አብስ ጊኮ ዮናሳ ስብካተር ማሮት ገሌዛ። ዬዛኮ፥ ዮናሳፕ ኣዛይ Ꮊይዳ የዛ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">11:32 </char><char style="xt" closed="false"><ref loc="JHN 3:5">ዋን. 3:5</ref></char></note><verse eid="LUK 11:32"/></para>
  <para style="s1">አሰት ፖኦ</para>
  <para style="r">(<ref loc="MAT 5:15">ማቶ. 5:15</ref>፤ <ref loc="MAT 6:22-23">6:22-23</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 11:33"/>«ጾምፐ ጾምፒ ቆሶ አቆ ዎይ ኦታ ጋንጨ ጋድዛ አሲ ባያ። አሲ ፖአና በአድ ጋርክ ቀ አቆ ጋድዛ።<note caller="-" style="x"><char style="xo" closed="false">11:33 </char><char style="xt" closed="false"><ref loc="MAT 5:15">ማቶ. 5:15</ref>፤ <ref loc="MRK 4:21">ማር. 4:21</ref>፤ <ref loc="LUK 8:16">ሉቃ. 8:16</ref></char></note> <verse eid="LUK 11:33"/><verse number="34" style="v" sid="LUK 11:34"/>ነ ጋላ ኡባይስ ፖአይ ነ አፋ። ነ ኣፋይ ሎኦ ማቅኮ፥ ነ ኩን ጋላይ ፖእዛ። ነ ኣፋይ ሀርግኮ ነ ጋላይ ኡባይ ምዛ። <verse eid="LUK 11:34"/><verse number="35" style="v" sid="LUK 11:35"/>የይ ግሾስ፥ ነ ጋንጨ የዝ ፖአይ ማም ጋርክ ናግዛ። <verse eid="LUK 11:35"/><verse number="36" style="v" sid="LUK 11:36"/>ይኬ፥ ነ ኩን ጋላይ ፖኦ ማቅኮ፥ ነ አሰትይዳካ ሀራ ማ አቆ ብኮ፥ ነ ጋላ ኩንይ ዋዢ ጌዝ ፖኦ ጋርክ ማቅዛ» ዬጌዛ።<verse eid="LUK 11:36"/></para>
  <para style="s1">ኡሱፑን ኣዪታ</para>
  <para style="r">(<ref loc="MAT 23:1-36">ማቶ. 23:1-36</ref>፤ <ref loc="MRK 12:38-40">ማር. 12:38-40</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 11:37"/>የሱሳ ፋ ናሻ ዉርሴዛን ጋርክ ፐቲ ፈርሳዋይ ፓር ካ ማዳይ ጋርክ ጼጌዛ። ኤ ኤዛር ዎላ ገሊ ስብረል አፋ በቴዛ። <verse eid="LUK 11:37"/><verse number="38" style="v" sid="LUK 11:38"/>ፈርሳዋይ የሱሳ ካ ማዳይፕ ቲና ኩሸ ሜጨካዛ ብኢ ማላባዝ ጌዛ።<verse eid="LUK 11:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 11:39"/>ጎዳይ ኤዝኮ፥ «ይንቲ ፈርሳውታይ ዋንጫስኔ ከረስ አፋ ባጋ ሜጭዛ። ዝን ይ ጋንጫይ ቦንቃኔ ኢታትር ኩሜዛ። <verse eid="LUK 11:39"/><verse number="40" style="v" sid="LUK 11:40"/>ይንታኖ፥ ቦዝታዮ፥ ባለ ባጋ መዛይ ጋንጨ መዝ ጎዳይ ኤዛ ባሳኔ? <verse eid="LUK 11:40"/><verse number="41" style="v" sid="LUK 11:41"/>ዝን ዋንጫኔ ኬሬ የዛና ማንቅታይስ እንጎይታ። የ ዎደ ይንትስ ኡባ ባዝ ጌሽ ማቃዳ።<verse eid="LUK 11:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 11:42"/>«ፈርሳውታዮ ይንታን አየ፥ ሳዎፐ፥ ጻሎተፐ፥ የይ ጋርክ ባዝፐ አስራታ ከስዛ። ዝን ጽሎትኔ ጾስ ቃ ይንታር ባያ። Ꮊንክታ አሸካዛር Ꮊይትታካ ኦዳይስ ቤዝዛ፥ ዝን ይ አሼዛ።<note caller="-" style="x"><char style="xo" closed="false">11:42 </char><char style="xt" closed="false"><ref loc="LEV 27:30">ለዊ. 27:30</ref></char></note><verse eid="LUK 11:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 11:43"/>«ፈርሳውታዮ ይንታን አየ፥ አይሁድታይ ዎሳ ኬ ቦንቾ ኦይደ፥ ጋበ ጋንጨ ቦንቾ ሳሮ ይ ዶስዛ።<verse eid="LUK 11:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 11:44"/>«ሊላሚ ብን አሳይ ኤረካዛር አፋር የዝ ዱፎ ኣዝዝታዮ ይንታን አየ» ዬጌዛ።<verse eid="LUK 11:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 11:45"/>ህገ አስታማራይ ማቂ፥ «አስታማራዮ፥ ነ የያ ጊታር ኑና ጫዥዛ» ዬጌዛ።<verse eid="LUK 11:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 11:46"/>የሱሳ፥ «ይንታኖ፥ ህገ አስታማርታዮ፥ ይንታናካ አየ፥ አሲ ቶኮዳይስ ዳንዳኦዋ ዴጾ ቶፎ ቶስዛ፥ ዝን ይንቲ ይ ኡባስ ሀራ አቶዝን ብራ ጼራራካ ቦቾያ።<verse eid="LUK 11:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 11:47"/>«ይ አድታይ ዎዝ ናብታይ ዱፋ ይ ጊግስዛይ ግሾስ ይንታን አየ። <verse eid="LUK 11:47"/><verse number="48" style="v" sid="LUK 11:48"/>ይኬ፥ ይ አድታይ ኦሳ ምንዳይስ ኡ ዎዝ ናብታይ ዱፋ ይ ሎእዛ ግሾስ ኡ ኢታ ኦሳይስ ይ ማርካ። <verse eid="LUK 11:48"/><verse number="49" style="v" sid="LUK 11:49"/>የይ ግሾስ፥ ጾሳይ ፋ ኤጨትር፥ ‹ናብታኔ ሀዋርታ ታ ይንትስ ኪቶዳ፥ ዝን ይ ባግታ ዎዳ፤ Ꮊንክታ ባይኦዳ› ዬጌዛ። <verse eid="LUK 11:49"/><verse number="50" style="v" sid="LUK 11:50"/>የይ ግሾስ፥ Ꮊ የለትታይ አላማይ መንቴዛይፐ Ꮊኖ ሄሎዳይስ ላልንቴዝ ናብታይ ኡቢታይ ሱይስ ኦይጭንቶዳ። <verse eid="LUK 11:50"/><verse number="51" style="v" sid="LUK 11:51"/>አቤላፕ አይኪ ያርሾ አቆስኔ ጾስ ኬፐ ጋንጨር ላልንቴዝ ዛክሬሳ ሱይ ግሾስ Ꮊ የለትይ ኦይጭንቶዳ።<note caller="-" style="x"><char style="xo" closed="false">11:51 </char><char style="xt" closed="false"><ref loc="GEN 4:8">መ. 4:8</ref>፤ <ref loc="2CH 24:20-21">2ዜና. 24:20-21</ref></char></note><verse eid="LUK 11:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 11:52"/>«ህገ አስታማርታዮ፥ ይንታን አየ፥ ኤረት ቁልፓ ይ ኩሸ ይ አይኬዛ፥ ዝን ይንትስ ገሎያ Ꮊንክታካ ገልሶያ» ዬጌዛ።<verse eid="LUK 11:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 11:53"/>የሱሳ የይፕ Ꮊማዳይስ ከሳዳር ህገ አስታማርታይኔ ፈርሳውታይ ኤዛር ኤቅንቲ ኦይቻር ዋይዛ። <verse eid="LUK 11:53"/><verse number="54" style="v" sid="LUK 11:54"/>ኤ ዶናፕ ከዝዝ ቃላር ኤዛ አይኮዳይስ ኮዪ የያ ኦዛ።<verse eid="LUK 11:54"/></para>
  <chapter eid="LUK 11"/>
  <chapter number="12" style="c" sid="LUK 12"/>
  <para style="s1">አያና ምንኔ አየ</para>
  <para style="r">(<ref loc="MAT 10:26-27">ማቶ. 10:26-27</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 12:1"/>የ ዎደ ጋመ ሙኩለር ታይብንትዛ አሳይ ዎላል አፋ የንቶድ ጋ አሲ አሳል አፋ ሺቂ የዝን፥ የሱሳ ፋ ታማርታይኮ፥ «ፈርሳውታይ እርሾፕ ናግንቶይታ። የይካ ጩቦት።<note caller="-" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="MAT 16:6">ማቶ. 16:6</ref>፤ <ref loc="MRK 8:15">ማር. 8:15</ref></char></note> <verse eid="LUK 12:1"/><verse number="2" style="v" sid="LUK 12:2"/>በንተካ ቆስንቲ፥ ኤርንተካ ካምንት አትዝባዝ አኮካ ባያ።<note caller="-" style="x"><char style="xo" closed="false">12:2 </char><char style="xt" closed="false"><ref loc="MRK 4:22">ማር. 4:22</ref>፤ <ref loc="LUK 8:17">ሉቃ. 8:17</ref></char></note> <verse eid="LUK 12:2"/><verse number="3" style="v" sid="LUK 12:3"/>ይኬ፥ ይ ማ ኦዴዝባዛይ ኡባይ ፖኦ ስእንቶዳ፥ ቆልአ ሀየ ካልካሼዝ ባዝ ዎያስ ኦድንቶዳ።<verse eid="LUK 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 12:4"/>«ታ ባጉን፥ ታ ኦድዛና ስኦይታ፤ አሾ ዎዛፕ አትን ሀራ አብካ ኦዳይስ ዳንዳኦዝታይስ ያሽትፓተ። <verse eid="LUK 12:4"/><verse number="5" style="v" sid="LUK 12:5"/>ሀኖ ዝን፥ ይ ያሽቶዳይስ ቤዝዛና ታ ይንትስ ቤሳዳ። የይካ ዎዛይፐ ጉየ ጋናመ ኦሎዳይስ ማዉተ የዛይስ ኤዝስ ያሽቶይታ። ኤ፥ ቱማ ግዛ፤ ኤስ ኣዳ ያሽቶይታ። <verse eid="LUK 12:5"/><verse number="6" style="v" sid="LUK 12:6"/>እችን ሱንታይ ፐቲ ሳንትፈስ ባይዝንቶሳኔ? ሀኖፕ አትን ኡንታፕ ፐታታካ ጾስ ቲና ዶግንተና። <verse eid="LUK 12:6"/><verse number="7" style="v" sid="LUK 12:7"/>ሀራ አቶዝን፥ ይ ኦማ ብናናይካ ፓይድንቲ የዛ። ይኬ፥ ያሽትፓተ፤ ጋመ ሱንታይፕ ይ ኣዛ።<verse eid="LUK 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 12:8"/>«ታ ኦድዛ ስኦይታ፤ አስ ቲና ታ ባዝ ማርካትዝ ኡባይስ አስ ናአይ ጾስ ኪታንችታይ ቲና ማርኮቶዳ። <verse eid="LUK 12:8"/><verse number="9" style="v" sid="LUK 12:9"/>አስ ቲና ታና ካድዛና ጾስ ኪታንችታይ ቲና ታ ኤዛ ካዶዳ። <verse eid="LUK 12:9"/><verse number="10" style="v" sid="LUK 12:10"/>አስ ናአል አፋ ለቆ ቃላ ኦድዝ ኡቢታይ ማሮት ደማዳ፥ ዝን ጌሻ አያና ጫዥዝታይ ማርንተና።<note caller="-" style="x"><char style="xo" closed="false">12:10 </char><char style="xt" closed="false"><ref loc="MAT 12:32">ማቶ. 12:32</ref>፤ <ref loc="MRK 3:29">ማር. 3:29</ref></char></note><verse eid="LUK 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 12:11"/>«አሲ ይንታን አይኪ አይሁድታይ ዎሳ ኬ፥ ዳይንታይ ቲናኔ ካትታይ ቲና ጎሽችዛ ዎደ አብ ኦዶዳዛኮኔ ዋጊ ማሆዳዛኮ ህርግፓተ።<note caller="-" style="x"><char style="xo" closed="false">12:11-12 </char><char style="xt" closed="false"><ref loc="MAT 10:19-20">ማቶ. 10:19-20</ref>፤ <ref loc="MRK 13:11">ማር. 13:11</ref>፤ <ref loc="LUK 21:14-15">ሉቃ. 21:14-15</ref></char></note> <verse eid="LUK 12:11"/><verse number="12" style="v" sid="LUK 12:12"/>የ ዎደ ይ ኦዶድ ባዝ ጌሻ አያናይ ይንታን ታማርሶዳ» ዬጌዛ።<verse eid="LUK 12:12"/></para>
  <para style="s1">ዱረ አይ ቦዘት</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 12:13"/>ዎይታይፕ ፐቲ አሲ የሱሳኮ ይኢ፥ «ታ እሻይ ታስ ኑ አዳይ ኬኬፕ ሻኮድ ጋርክ ኤዝስ ኦዶባ» ዬጌዛ።<verse eid="LUK 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 12:14"/>የሱሳ ማሂ፥ «ናት አዮ፥ ይንታል አፋ ታና ዳይንኔ ኬኬ ሻክዝ ጭማ ኦዛይ ኦኖ?» ዬጌዛ። <verse eid="LUK 12:14"/><verse number="15" style="v" sid="LUK 12:15"/>ማካ የሱሳ፥ «አስ የሳይ ሻሎ ጋመትር ባዛይ ግሾስ ዣረ አሺ ሚን ይንታን ናጎይታ» ዬጌዛ።<verse eid="LUK 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 12:16"/>ማቅካ ኣዝሶር፥ «ጋዳይ ጋመ ካ እንግዝ ፐቲ ዱረ አይ የዛ። <verse eid="LUK 12:16"/><verse number="17" style="v" sid="LUK 12:17"/>የ አይ፥ ‹ታ ካ ታኒ ሺሾዳይስ አቆ ጽቄዝ ግሾስ አብ ኦ?› ዬጊ ፋ ዎዝናር ቆፔዛ። <verse eid="LUK 12:17"/><verse number="18" style="v" sid="LUK 12:18"/>Ꮊንፐ የሳዳ፤ ቲን የዛ ሻልታ ሁሊ ሀራ ዳልገ ሻለ ኬጾዳ። ካኔ ታስ የዛ ባዝ ኡባ ኤዛይድ ኦሎዳ። <verse eid="LUK 12:18"/><verse number="19" style="v" sid="LUK 12:19"/>ፋ ሸምፓትኮ፥ ‹ታ ሸምፓተ፥ ጋመ ላይስ ኔስ ግድዛ ሻሎ ሺሼዛ። ይኬ፥ ሸምፕ ሞባ፥ ኡዦባ፥ ኡፋይቶባ› ዬጎዳ።<verse eid="LUK 12:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 12:20"/>«ዝን ጾሳይ፥ ‹ናት፥ ቦዞ አዮ፥ Ꮊይኖ ቃማ ነ ሸምፓታ ኔፕ ኤክንትዛ። ይኬ፥ ነ ሺሼዛይ ኦስ ማቆደ?› ዬጌዛ።<verse eid="LUK 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 12:21"/>«የይ ግሾስ፥ ፓስ ዱረት ሳአል ሺሽዛ አስስ፥ ጾስ ካለ ዱረ ማቀካ አስስ ዉርስይ Ꮊ አይሳይ ጋርከ» ዬጌዛ።<verse eid="LUK 12:21"/></para>
  <para style="s1">ኡንእንትፓተ</para>
  <para style="r">(<ref loc="MAT 6:25-34">ማቶ. 6:25-34</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 12:22"/>የይፐ ጉየ፥ የሱሳ ፋ ታማርታይኮ፥ «ይኬ፥ ታ ኦድዛ ባዝ ስኦይታ፥ ይ ሸምፖስ አብ ማዴ ይ ጋላሳስ አብ ማአዴ ዬጊ ኡንእንትፓተ። <verse eid="LUK 12:22"/><verse number="23" style="v" sid="LUK 12:23"/>ሸምፖ ካፕ ጋላ አፍላፕ ኣዛ። <verse eid="LUK 12:23"/><verse number="24" style="v" sid="LUK 12:24"/>ካፍታ ቦኦይታ ዘሮያ፥ ማጾያ፥ ሻለካ ባያ። ዝን ጾሳይ ኡንታን ሙዝዛ። ይ ካፍታይፕ ሎእ ኣዛ። <verse eid="LUK 12:24"/><verse number="25" style="v" sid="LUK 12:25"/>ሀኖ ዝን፥ ይንትፕ ኡንእንቲ ፋ ላይል አፋ ፐቲ ቃማ ጉጆዳይስ ዳንዳእዛይ ኦኖ? <verse eid="LUK 12:25"/><verse number="26" style="v" sid="LUK 12:26"/>ይኬ፥ Ꮊ ጽቃባዝ ኦዳይስ ዳንዳኦዋ ይ ሀራባዝስ አብስ ኡንእንቴ? <verse eid="LUK 12:26"/><verse number="27" style="v" sid="LUK 12:27"/>አን ፉታይ ዋይዚ ድጭዛኮ ቦኦይታ። ዋዮያ ሱቆያ። ሀራ አቶዝን፥ ሶሎሞነ ፓስ የዝ ቦንቾ ኡባይር ኡንታፕ ፐታይ ጋርከካ ማኢ በኤካያ።<note caller="-" style="x"><char style="xo" closed="false">12:27 </char><char style="xt" closed="false"><ref loc="1KI 10:4-7">1ካት. 10:4-7</ref>፤ <ref loc="2CH 9:3-6">2ዜና. 9:3-6</ref></char></note> <verse eid="LUK 12:27"/><verse number="28" style="v" sid="LUK 12:28"/>ይንታኖ፥ አማኖ ፓጬዝታዮ፥ ይኬ፥ ጾሳይ Ꮊይኖ በንቲ ዎንታ ታማ ጋንጨ ዎድ ፉታ Ꮊይ ጋርከ ማእስኮ፥ ይንታን ዋይዚ ኣ ማእሶሳ? <verse eid="LUK 12:28"/><verse number="29" style="v" sid="LUK 12:29"/>የይ ግሾስ፥ አብ ሞሻ ዎይ አብ ኡዦሻ ግ ይ ዎዝናር ኡንእንትፓተ። <verse eid="LUK 12:29"/><verse number="30" style="v" sid="LUK 12:30"/>የ ኡባ ጾሳ አማኖዋ አሳይ ኮይዛ። ዝን ይ አዳይ ጾሳይ የይ ኡቢታይ ይንትስ ኮሽዛና ኤርዛ። <verse eid="LUK 12:30"/><verse number="31" style="v" sid="LUK 12:31"/>ኡባፕ ኣ ጾስ ካተት ኮዦይታ የይ ኡቢታይ ይንትስ ጉጂ እንግንቶዳ።<verse eid="LUK 12:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 12:32"/>«ይንታኖ፥ ጽቃ ዎይታዮ፥ ይ አዳይ ጾሳይ ካተት ይንትስ እማዳይስ ኤ ሎኦ ሸነ ማቄዛ ያሽትፓተ። <verse eid="LUK 12:32"/><verse number="33" style="v" sid="LUK 12:33"/>ይንትስ የዛ ባዝ ባይዚ ማንቅታይስ እንጎይታ። ካይዞ ኤኮዋ፥ ብላ ሞዋ አቆ፥ ጭሞዋ ቁርቦ ጋንጨ፥ ዉሮዋ ሻላና ሳሎ ሺሾይታ። <verse eid="LUK 12:33"/><verse number="34" style="v" sid="LUK 12:34"/>ይ ዎዝናይ ይ ሻላይ የዛ አቆ ማቃዳ።<verse eid="LUK 12:34"/></para>
  <para style="s1">ባርኪ ናጎ</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 12:35"/>«ይ ጼሳይ ዳንጭንቴዛ፥ ይ ጾምፓይ ፖኤዛ ማቆ።<note caller="-" style="x"><char style="xo" closed="false">12:35 </char><char style="xt" closed="false"><ref loc="MAT 25:1-13">ማቶ. 25:1-13</ref></char></note> <verse eid="LUK 12:35"/><verse number="36" style="v" sid="LUK 12:36"/>ፋ ጎዳይ ቦሳይፕ ማቃድ ጋ ባርኪ ናግዝታይ ጋርክ፥ ጎዳይ ይኢ ጼግዝ ዎደ ኤልሲ ዶዮዳይስ ጊጌዝ አስታ ኣዞይታ።<note caller="-" style="x"><char style="xo" closed="false">12:36 </char><char style="xt" closed="false"><ref loc="MRK 13:34-36">ማር. 13:34-36</ref></char></note> <verse eid="LUK 12:36"/><verse number="37" style="v" sid="LUK 12:37"/>ፋ ጎዳይ ማቅዝ ዎደ ገንተካዛር ናግዝታይ አንጅንቴዝታ። ታ ቱሮ ግዛ፤ ጎዳይ ሃታር ዳንጪ ሌማተ ላንቃይድ በት ሞክዛ። <verse eid="LUK 12:37"/><verse number="38" style="v" sid="LUK 12:38"/>ጎዳይ ግዲ ብላሄ ማቅን ዎይ ዎንትማ ማቅን ይኢ፥ የይ ጋርክ ገንተካዛር ናጎዳር ደንግዛ የ አይልታይ አንጅንቴዝታ። <verse eid="LUK 12:38"/><verse number="39" style="v" sid="LUK 12:39"/>ዝን Ꮊያ ኤሮይታ፤ ካይዞ አይደ የኦዳዛኮ ካራ አዳይ ኤርዛኮ ኬይ ቦክንታምዝን።<note caller="-" style="x"><char style="xo" closed="false">12:39-40 </char><char style="xt" closed="false"><ref loc="MAT 24:23-44">ማቶ. 24:23-44</ref></char></note> <verse eid="LUK 12:39"/><verse number="40" style="v" sid="LUK 12:40"/>ይንትካ ጊጊ ናጎይታ፤ አስ ናአይ ይ ቆፐካ ዎደ የኦዳ» ዬጌዛ።<verse eid="LUK 12:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 12:41"/>ጵጽሮሳካ፥ «ጎዳዮ Ꮊ ኣዝሳ ኑ ኣዳስ ኦድነኔ አስ ኡባሶ?» ዬጌዛ።<verse eid="LUK 12:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 12:42"/>ጎዳይ ማሂ፥ «ይኬ፥ ካ ሙዞዳይስ ቤዝዛ ዎደር እማድ ጋርክ ጎዳይ ፋ አይልታይል አፋ ሹሜዝ አማንዛይኔ ዎዛናማይ ኦኖ? <verse eid="LUK 12:42"/><verse number="43" style="v" sid="LUK 12:43"/>ጎዳይ ማቆዳር የይ ጋርክ ኦታር በንትዝ አይላይ ኤ አንጅንቴዛያ <verse eid="LUK 12:43"/><verse number="44" style="v" sid="LUK 12:44"/>ታ ይንትስ ቱሮ ኦድዛ፤ ፋ ጎዳይስ የዝ ሻሎ ኡባይል አፋ ኤ ሹምንቶዳ። <verse eid="LUK 12:44"/><verse number="45" style="v" sid="LUK 12:45"/>ዝን የ አይላይ፥ ‹ታ ጎዳይ ኤል የኤና› ዬጊ ፋ ዎዝናር ቆፒ፥ ጋንድታኔ ጋችታ Ꮊኮ፥ ማ ፓስ ኮዤዝ ጋርክ ሚታራኔ ኡዥታር ማኮ፥ <verse eid="LUK 12:45"/><verse number="46" style="v" sid="LUK 12:46"/>የ አይላይ ጎዳይ ኤ ቆፐካ ጋላሳኔ ህርገካ ዎደ የኦዳ። ይኢ ኤዛ ጋሽቺ፥ ኤ አንጃ አማኖዋ አስታይር ኡዶዳ።<verse eid="LUK 12:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 12:47"/>«ጎዳይ ሸናይ ጋርክ ጊጎዛይኔ ኤ ጎዳይ አብ ቃዛኮ ኤርታር ኦዋ አይላይ ጋመ ጋራፍንቶዳ። <verse eid="LUK 12:47"/><verse number="48" style="v" sid="LUK 12:48"/>ዝን ፋ ጎዳይ ሸና ኤረካ አቲ ጋራፍንቶዳይስ ቤዝዛና ኦዛይ ጽቃል ጋራፍንቶዳ። አብስ ጊኮ ጋመ እንግንቴዛይፕ ጋመ ኮይንትዛ፥ ጋመ ሀዳራ ኤኬዛይፐካ ጋመ እማድ ግ ናግንትዛ።»<verse eid="LUK 12:48"/></para>
  <para style="s1">ሳሮትስ ባዝን ሻክንቶሲ</para>
  <para style="r">(<ref loc="MAT 10:34-36">ማቶ. 10:34-36</ref>)</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 12:49"/>«ታኒ የኤዛይ ቢታል አፋ ታማ አይዳይስ። Ꮊት ታማይ አይክዛኮ ታና ዋይዚ ኡፋይሶደሻ! <verse eid="LUK 12:49"/><verse number="50" style="v" sid="LUK 12:50"/>ሀኖ ዝን፥ ታ Ꮊት ጻማቅንትዛ ጽንቃታይ የዛ። ኤ ፖልንቶድ ጋ ታ ዋፋ ኡንእንቶደሻ።<note caller="-" style="x"><char style="xo" closed="false">12:50 </char><char style="xt" closed="false"><ref loc="MRK 10:38">ማር. 10:38</ref></char></note> <verse eid="LUK 12:50"/><verse number="51" style="v" sid="LUK 12:51"/>ሳአል አፋ ሳሮት ኮኦዳይስ የኤዛ ይንትስ ኣዝኔ? የያ ባያ፥ ታ የኤዛይ ሻኮዳይስ። <verse eid="LUK 12:51"/><verse number="52" style="v" sid="LUK 12:52"/>Ꮊተፕ አይኪ ዎል ጋንጨ ሻክንቴዝ እችን አሳይ ፐቲ ኬ ዎላ የዛ። ናምእታይ ሃይታይል አፋ፥ ሀይዝታይካ ናምእታይል አፋ፥ ደንዲ ሻክንቶዳ። <verse eid="LUK 12:52"/><verse number="53" style="v" sid="LUK 12:53"/>አዳይ ናአይል አፋ፥ ናአይካ አዳይል አፋ፥ እንዳት ናአትል አፋ፥ ናአታ እንዳትል አፋ፥ አዝናይ እንዳት ናአይ ማቻትል አፋ፥ ናአይ ማቻት አዝናይ እንዳትል አፋ፥ ደንዲ ሻክንቶዳ።»<note caller="-" style="x"><char style="xo" closed="false">12:53 </char><char style="xt" closed="false"><ref loc="MIC 7:6">ሚካ. 7:6</ref></char></note><verse eid="LUK 12:53"/></para>
  <para style="s1">ላይታ ማሎባ</para>
  <para style="r">(<ref loc="MAT 16:2-3">ማቶ. 16:2-3</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 12:54"/>ማካ አሳይኮ፥ «አዋ ገሎ ባጋር ሳሎ ሻራትዛ ዎደ ብኢ፥ ኤልሲ፥ ‹እራ የኦዳ› ይ ዬግዛ፥ የይ ጋርከካ ሀንዛ። <verse eid="LUK 12:54"/><verse number="55" style="v" sid="LUK 12:55"/>ሱለ ባጋ ጫርኮ ጫርክዛ ዎደ ‹ሳአይ አዎዳ› ይ ዬግዛ፥ የይ ጋርከካ ሀንዛ» ዬጌዛ። <verse eid="LUK 12:55"/><verse number="56" style="v" sid="LUK 12:56"/>ይንታኖ፥ ጩብታዮ፥ ሳሎባዝኔ ሳአባዝ ሻኪ ኤርዝን Ꮊ ዎዳ ሻኪ ኤሮዳይ ይንታን ዋይዚ ጋሜኔ?<verse eid="LUK 12:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 12:57"/>«የዝን፥ ይ ኡባስ አብስ ቱማ ፕርዶሳ? <verse eid="LUK 12:57"/><verse number="58" style="v" sid="LUK 12:58"/>ነ ሞርካይር ዎላ ዳይና ቲና ኤቆዳይስ Ꮊንግታር ኦገል አፋ ጊጎዳይስ ኮዪ ነ ጊገካ አትኮ ጎሽች ዳይና ቲና ነና ካማዳ። ዳይናይ ነና ፖልሴስ ኣ እማዳ። ኤ ነና ዎይነ ኦሎዳ። <verse eid="LUK 12:58"/><verse number="59" style="v" sid="LUK 12:59"/>ስኦይታ፥ ፐቲ ባካና አተካዝን ጭግ ሃሶድ ጋ ነ እዝፕ ኬዛምዛኖ ኤሮባ» ዬጌዛ።<verse eid="LUK 12:59"/></para>
  <chapter eid="LUK 12"/>
  <chapter number="13" style="c" sid="LUK 13"/>
  <para style="s1">ናጋራፕ ማቅ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 13:1"/>የ ዎደ የሱሳኮ አሳይ ይኢ ጋልላ አሳይ ያርሾ ያርሾዳር ኡንታን ጵላጾሳ ዎ ኡ ሱ ያርሾር ዋላኬዝ ባዛ ኦዴዛ። <verse eid="LUK 13:1"/><verse number="2" style="v" sid="LUK 13:2"/>ኤ Ꮊይ ጋርከ ዬጊ ማሄዛ፤ «የዝን Ꮊ ጋልላ አሳይ Ꮊ ኢታ Ꮊይቆ Ꮊይቄዝ ግሾስ ጋልላ የዝ አስ ኡባይፕ ኣ ናጋራ ኦዛ ኣዝኔ? <verse eid="LUK 13:2"/><verse number="3" style="v" sid="LUK 13:3"/>የያ ባያ! ይንትካ ማሮተር ማቃም አትኮ፥ ኡቢታይ Ꮊይ ጋርክ ቦዳ። <verse eid="LUK 13:3"/><verse number="4" style="v" sid="LUK 13:4"/>ዎይ ማ ሳልሆመ ግዝ በሳይድ ግምባይ ዎዲ ዎዝ ታጶ ሆስፑን አሳይ የሩሳላመ የዝ አስ ኡባፕ ኣዝ ናጋራ ኦዛ ኣዝኔ? <verse eid="LUK 13:4"/><verse number="5" style="v" sid="LUK 13:5"/>የያ ባያ! ዝን ይንትካ ማሮትር ማቃም አትኮ ኡባይ Ꮊይ ጋርክ ቦዳ።»<verse eid="LUK 13:5"/></para>
  <para style="s1">ኣፈ ኣፎዋ ባላሰ ምቶ</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 13:6"/>ማካ የሱሳ Ꮊይ ጋርከ ግ ኣዝሶ ኦዴዛ፦ «ፐቲ አይስ ዎይነ ጋደ ቱክንቴዝ ባላሰ ምት የዛ። ኤ ኢፐ ኣፈ ኮዪ ይኢ አብካ ደንገካያ። <verse eid="LUK 13:6"/><verse number="7" style="v" sid="LUK 13:7"/>ጋደ ጎዳይ ዎይነ ኦሶ አሳይኮ፥ ‹ኣፈ ደንጎዳይስ ኮዪ ሀይ ላይ ማቂ ማቂ ይኢ አብካ ደንገካያ። የይ ግሾስ፥ ጋቺ ሀልእሶባ፤ አብስ ቢታ መልሴ?› ዬጌዛ።<verse eid="LUK 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 13:8"/>«ዝን ኦሶ አይ፥ ‹ጎዳዮ፥ እ ጋጻ ኦ ኦሻ ኦሎድ ጋ ሀበረስ አሾዬ። <verse eid="LUK 13:8"/><verse number="9" style="v" sid="LUK 13:9"/>ይእዛ ላይ ኣፍኮ ሎኦ፥ አትኮ ጋቺ አሾባ› » ዬጊ ማሄዛ።<verse eid="LUK 13:9"/></para>
  <para style="s1">ዞኮ ኩና አስታ ፓጼዛ</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 13:10"/>የሱሳ ማላ ጋላስ አይሁድታይ ዎሳ ኬ ታማርስዛ። <verse eid="LUK 13:10"/><verse number="11" style="v" sid="LUK 13:11"/>የ በሳይድ ታጶ ሆስፑን ላይ ቱና አያና ዞኮ ኩንሴዝ ፐቲ አስታ የዛ። እዛ ኩኔዛይ ግሾስ ሉለ ኤቆዳይስ ዳንዳኦያ። <verse eid="LUK 13:11"/><verse number="12" style="v" sid="LUK 13:12"/>የሱሳ እዞ በኤዝ ዎደ ጼጊ፥ «Ꮊን አስቴ፥ ነ ሀርጋይፕ ፓጼዛ» ዬጌዛ። <verse eid="LUK 13:12"/><verse number="13" style="v" sid="LUK 13:13"/>ፋ ኩሻ እዝል አፋ ጋድን፥ እዛ ኤለር ሉሊ ኤቄዛ። ጾሳካ ጋላቴዛ።<verse eid="LUK 13:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 13:14"/>ዝን አይሁድታይ ዎሳ ኬ ሀላቃይ ይሎቲ አሳይኮ፥ «ኦሶ ኦዝ ኡሱፑን ጋላስታይ የዛ። የይ ግሾስ፥ የ ጋላስታይድ ይኢ ፓጾይታፕ አትን ማላ ጋላስ ባያ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">13:14 </char><char style="xt" closed="false"><ref loc="EXO 20:9-10">ከስ 20:9-10</ref>፤ <ref loc="DEU 5:13-14">ናምእ. 5:13-14</ref></char></note><verse eid="LUK 13:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 13:15"/>ጎዳይ፥ «ጩብታዮ፥ ይ ጋንጨፕ ገማተ ዎይ ሀረ ማላ ጋላስ ዛዳሎፕ ብሊ ሃ ኡሾዳይስ ካንጎዛይ ኦኖ? <verse eid="LUK 13:15"/><verse number="16" style="v" sid="LUK 13:16"/>የዝን፥ Ꮊ አስታ አፍራመ ናአ ማቅታር ጻላሄር አጭንቲ ታጶ ሆስፑን ላይ ኩን የዜዛንስ ማላ ጋላስ ብልንቶዳይስ ቤዞሳ?» ዬጊ ኦይጬዛ።<verse eid="LUK 13:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 13:17"/>ኤ የያ ኦዴዝ ዎደ ኤቅንትዝታይ ኡቢታይ ዬላቴዛ። ዝን አስ ኡባይ ኤ ኦዝ ማላታ ኦሶ ኡባይድ ኡፋይቴዛ።<verse eid="LUK 13:17"/></para>
  <para style="s1">ሳናፍጨ ኣፈ</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 13:18"/>የይፐ ጉየ፥ የሱሳ Ꮊይ ጋርከ ዬጌዛ፥ «ጾስ ካተትይ አብ ኣዝኔ? እዞ አባር ኣዝሶ? <verse eid="LUK 13:18"/><verse number="19" style="v" sid="LUK 13:19"/>ጾስ ካተትይ ፐቲ አስ ፋ ጋደ ጋንጨ ቱኬዝ ሳናፍጨ ኣፈ ጋርከ። እዛ ድጪ ዳማ ም ማቄዛ። ካፍታይ እ ሻቃይል አፋ ሸምፔዛ።»<verse eid="LUK 13:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 13:20"/>ማ፥ «ጾስ ካተት አባር ኣዝሶ? <verse eid="LUK 13:20"/><verse number="21" style="v" sid="LUK 13:21"/>ፐቲ አስታ ጋመ ላር ዋላኪ ሙኑቄዝ ጽቃ እርሾ ኣዝዛ» ዬጌዛ።<verse eid="LUK 13:21"/></para>
  <para style="s1">ጹን ፐንገ</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 13:22"/>የይፐ ጉየ፥ የሱሳ የሩሳላመ Ꮊንግታር ኤ ኣዝ ኦገል የዝ ካታምታይዳኔ ሄራ ታማርስታር ኣዛ። <verse eid="LUK 13:22"/><verse number="23" style="v" sid="LUK 13:23"/>ፐቲ አስ የሱሳኮ፥ «ጎዳዮ፥ አቶዳይ ጽቃ አስ አዳኔ?» ዬጊ ኦይጬዛ።</para>
  <para style="p" vid="LUK 13:23">የሱሳ ኡንትኮ፥ <verse eid="LUK 13:23"/><verse number="24" style="v" sid="LUK 13:24"/>«ስኦይታ፥ ጹን ፐንገር ገሎዳይስ ቡትቶይታ። ጋምታይ ገሎዳይስ ኮይዛ ዝን ኡንትስ ሀናሚ። <verse eid="LUK 13:24"/><verse number="25" style="v" sid="LUK 13:25"/>ኬ ጎዳይ ደንዲ ፐንገ ጎርደዛይፐ ጉየ ‹ኑስ ዶዮዬ› ዬግታር ባለ ኤቂ ጼስ አይኮዳ። ዝን ኤ፥ ‹ይ ኦናዛኮኔ አናፕ የኤዛኮ ታ ኤሮያ› ግ ማሆዳ። <verse eid="LUK 13:25"/><verse number="26" style="v" sid="LUK 13:26"/>የ ዎደ ይ፥ ‹ኔር ዎላ ሜዛ፥ ኡዤዛ፥ ኑ ደንባይዳካ ነ ታማርሴዛ› ዬጎዳ።<verse eid="LUK 13:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 13:27"/>«ኤ ማሂ፥ ‹ይ ኦናዛኮኔ አናፕ የኤዛኮ ታ ኤሮያ። ይንታኖ፥ ኢታ ባዝ ኦዝታዮ ታፕ ሃኮይታ› ዬጎዳ።<note caller="-" style="x"><char style="xo" closed="false">13:27 </char><char style="xt" closed="false"><ref loc="PSA 6:8">ማዝ. 6:8</ref></char></note> <verse eid="LUK 13:27"/><verse number="28" style="v" sid="LUK 13:28"/>አፍራመ፥ እሳቃ፥ ያይቆባራኔ ናብታ ኡብታ ጾሳ ካተትይድ ይ በአዳ፥ ዝን ይ ባለ ዎ አትኮ ይንትስ ዬፎኔ አች ጮንቺ ማቃዳ። <verse eid="LUK 13:28"/><verse number="29" style="v" sid="LUK 13:29"/>አሳይ አዋ ከሳፐ፥ አዋ ገሎፐ፥ ፑደ ባጋፐ ሱለ ባጋፐ ይኢ ጾስ ካተት ሙንታል አፋ በቶዳ።<note caller="-" style="x"><char style="xo" closed="false">13:28-29 </char><char style="xt" closed="false"><ref loc="MAT 8:11-12">ማቶ. 8:11-12</ref>፤ <ref loc="MAT 22:13">22:13</ref>፤ <ref loc="MAT 25:30">25:30</ref></char></note> <verse eid="LUK 13:29"/><verse number="30" style="v" sid="LUK 13:30"/>የይ ግሾስ፥ ጉየቴዝታይፕ ቲና ማቆድታይ፥ ቲኔዝታይፕ ጉየ ማቆድታይ የዛ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">13:30 </char><char style="xt" closed="false"><ref loc="MAT 19:30">ማቶ. 19:30</ref>፤ <ref loc="MAT 20:16">20:16</ref>፤ <ref loc="MRK 10:31">ማር. 10:31</ref></char></note><verse eid="LUK 13:30"/></para>
  <para style="s1">የሱሳ የሩሳላመስ ዬኬዛ</para>
  <para style="r">(<ref loc="MAT 23:37-39">ማቶ. 23:37-39</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 13:31"/>የ ዎደ ፈርሳውታይፕ ፐታይ ፐታይ ይኢ፥ «ሄሮዶሳ ነና ዎዳይስ ኮይዝ ግሾስ Ꮊ በሳፕ ደንዲ ቅቶባ» ጌዛ።<verse eid="LUK 13:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 13:32"/>ኤ ማሂ፥ «Ꮊንጊ፥ የ ዎርካንታይስ ዬዛኮ፥ ‹Ꮊይኖኔ ዎንታ ቱና አያንታ ከሶዳ፥ ሀርግንቴዝታ ፓዳ፥ ሃይን ጋላሳር ሃሶዳ› ዬጌዛ ጎይታ። <verse eid="LUK 13:32"/><verse number="33" style="v" sid="LUK 13:33"/>ሀኖፕ አትን፥ ናባይ የሩሳላመፕ ሀራ አቆ Ꮊይቆዳይስ ቤዞያ። የይ ግሾስ፥ Ꮊይኖ፥ ዎንታኔ ዎንቲ ፔዢ የ በሳ Ꮊማዳይስ ደንዴዛ።<verse eid="LUK 13:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 13:34"/>«የሩሳላመ፥ የሩሳላመ፥ ናብታ ዎዛኔ፥ ኔኮ ኪትንቴዝታ ሹቻር ሾጭዛኔ፥ ሹጉላ ፋ ናእታ ፋ ቀፋይፕ ኦሞር ሺሽዛይ ጋርክ ነ ናእታ ታ ታ ሹጳይፕ ኦሞር ኣፑን ቶኬ ሺሾዳይስ ኮየኔ፥ ዝን ይ እጼዛ ጌዛ። <verse eid="LUK 13:34"/><verse number="35" style="v" sid="LUK 13:35"/>ታ ይንትስ ኦድዛ፤ ይ ኬይ ካይሳቶዳ። ጎዳይ ሱንር ይእዛይ አንጅንቴዛያ ይ ጎድ ጋ ታና ደንጋሚ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">13:35 </char><char style="xt" closed="false"><ref loc="PSA 118:26">ማዝ. 118:26</ref>፤ <ref loc="JER 22:5">ኤርም. 22:5</ref></char></note><verse eid="LUK 13:35"/></para>
  <chapter eid="LUK 13"/>
  <chapter number="14" style="c" sid="LUK 14"/>
  <para style="s1">የሱሳ ማላ ጋላስ ፐቲ ሀርግንቴዝ አ ፓዛ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 14:1"/>ማላ ጋላስ የሱሳ ፐቲ ፈርሳውታይ ሀላቃይ ካራ ካ ማዳይስ ገሎዳር አሳይ ኤ አብ ኡድዛክ በአዳይስ ናግዛ። <verse eid="LUK 14:1"/><verse number="2" style="v" sid="LUK 14:2"/>የ አቃይድ ሻዉሄ ሀርገር መትንትዛ ፐቲ አስ ኤዝስ ቲና ባጋር ዎይኤዛ። <verse eid="LUK 14:2"/><verse number="3" style="v" sid="LUK 14:3"/>የሱሳ ፈርሳዉታይኮኔ ህገ አስታማርታይኮ፥ «ማላ ጋላስ ሀርግንቴዝ አስ ፓዛይ ዎጋኔ ዎጋ ባሳ?» ዬጊ ኦይጬዛ። <verse eid="LUK 14:3"/><verse number="4" style="v" sid="LUK 14:4"/>ኡ ስእ አቴዛ። የሱሳ ሀርግንትዛ አ ቦቺ ፓ ሞይዜዛ።<verse eid="LUK 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 14:5"/>«ማካ ይንታፕ ፐታይስ ናአ ዎይ ገማተ ማላ ጋላስ ሆቦ ዎኮ ኤልሲ ከሶዛይ ኦኖ»<note caller="-" style="x"><char style="xo" closed="false">14:5 </char><char style="xt" closed="false"><ref loc="MAT 12:11">ማቶ. 12:11</ref></char></note> ዬጊ ኦይጬዛ። <verse eid="LUK 14:5"/><verse number="6" style="v" sid="LUK 14:6"/>ኡ ፐትባዝካ ማሆዳይስ ዳንዳኤካያ።<verse eid="LUK 14:6"/></para>
  <para style="s1">ከሄትኔ እማ ሞኮ</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 14:7"/>የሱሳ እማቶስ ጼግንቴዝታይ ቦንቾ አቆ ዶሮዳር ብኢ፥ Ꮊ ኣዝሳ ኦዴዛ፦ <verse eid="LUK 14:7"/><verse number="8" style="v" sid="LUK 14:8"/>«ፐቲ አሲ ነና ቦስ ካራ ጼግኮ ቦንቾ አቆ በትፐ። ኔፕ ኣ ቦንችንትዛ አሲ ጼግንቶዳይስ ዳንዳእዛ። <verse eid="LUK 14:8"/><verse number="9" style="v" sid="LUK 14:9"/>ይንታን ናምእታካ ጼጌዛይ ይኢ፥ ‹ነ አቃ Ꮊ እማይስ ዳኮባ› ዬግዝ ዎደ ነ ዬላትታር ሱል ዎዳ። <verse eid="LUK 14:9"/><verse number="10" style="v" sid="LUK 14:10"/>ማቆዝን፥ ነ ጼግንቴዝ ዎደ ቲናቲ ዝቃ አቆ ብኢ በቶባ። ጼጌዛይ ይኢ፥ ‹ታ ላጋዮ፥ Ꮊ ቦንቾ አቃይድ በቶባ› ዬጎዳ። የ ዎደ ኔር ዎላ ጼግንቴዝ አሳ ኡባይ ቲና ነ ቦንችንቶዳ። <verse eid="LUK 14:10"/><verse number="11" style="v" sid="LUK 14:11"/>ፋና ሾክ ሾክ ኡድዝ ኡቢታይ ካዉዦዳ፤ ፋና ዝቅ ዝቅ ኡድዝ ኡቢታይ ሾክ ሾክ ጎዳ።»<note caller="-" style="x"><char style="xo" closed="false">14:11 </char><char style="xt" closed="false"><ref loc="MAT 23:12">ማቶ. 23:12</ref>፤ <ref loc="LUK 18:14">ሉቃ. 18:14</ref></char></note><verse eid="LUK 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 14:12"/>ማካ የሱሳ ኤዛ ሞኬዝ ካራ አዳይኮ፥ «ቁማ ዎይ ካሆ እማቶ ጼግዝ ዎደ ኔኒ ኩሸ ማሆ ጼጋማይ ጋርክ ነ ላግታ ዎይ ነ እሽታ ዎይ ነ ዳብታ ዎይ ነ ዱረ ሾርታ እማቶ ጼግፐ። <verse eid="LUK 14:12"/><verse number="13" style="v" sid="LUK 14:13"/>ማቆዝን፥ ነ እማቶ ማኬዝ ዎደ ማንቅታ፥ ዎብታ፥ ስልታኔ ቶእታ ጼጎባ፤ ነ አንጅንቶዳ። <verse eid="LUK 14:13"/><verse number="14" style="v" sid="LUK 14:14"/>Ꮊይትታይ ኩሸ ማሆዳይስ ዳንዳኦዋ ግሾስ ኩሸ ማህይ ጌሽታይ ደንዶ ጋላስ ጾሲ ኔስ ማሆዳ» ዬጌዛ።<verse eid="LUK 14:14"/></para>
  <para style="s1">ዳማ እማቶ ኣዝሶ</para>
  <para style="r">(<ref loc="MAT 22:1-10">ማቶ. 22:1-10</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 14:15"/>የሱሳር ዎላ እማቶል አፋ በቴዝታይ ጋንጨፐ ፐታይ የያ ስኢ፥ «ጾሳ ካተትይድ እማቶል አፋ በቴዛይ አንጅንቴዛያ» ዬጌዛ።<verse eid="LUK 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 14:16"/>የሱሳ፥ «ፐቲ አስ ዳማ እማቶ ጊግሲ ጋመ አስታ ጼጌዛ። <verse eid="LUK 14:16"/><verse number="17" style="v" sid="LUK 14:17"/>እማቶ ሞክንትዛ ሳታት ሄልዝ ዎደ ጼግንቴዝ እማታ፥ ‹ዬዛኮ ኡባ ባዝ ጊጌዛ፥ Ꮊና የኦይታ› ዬጊ ጼጎድ ጋርክ ፋ አይላ ኪቴዛ።<verse eid="LUK 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 14:18"/>«ዝን ኡቢታይካ ፋ ሳላምበ ሳላምበ መዛ። ፐታይ፥ ‹Ꮊት ታ ሀጋ ጋደ ዎንጌዝ ግሾስ Ꮊንጊ በአዳይስ ኮሽዛ ሀያና ታና አሾዬ› ዬጌዛ። <verse eid="LUK 14:18"/><verse number="19" style="v" sid="LUK 14:19"/>Ꮊንካይ፥ ‹እችን ዋጻ ገማተ ዎንጌዛ ኡንታን ዋጺ ፋጪ በአድ ግሾስ ሀያና ታል ላንጭፐ› ዬጌዛ። <verse eid="LUK 14:19"/><verse number="20" style="v" sid="LUK 14:20"/>ማ Ꮊንካይ፥ ‹ታኒ ሀጋ መዳል የዝ ግሾስ የኦዳይስ ታስ ዳንዳእንታሚ› ዬጌዛ።<verse eid="LUK 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 14:21"/>«አይላይ ማቂ ይኢ የያ ኡባ ፋ ጎዳይስ ኦዴዛ። የ ዎደ ቦስ ጎዳይ ካጭንቲ አይላይኮ፥ ‹ኤልሲ ካታማ የዝ ጎስታይላኔ ሁሳ ኦግታይል Ꮊንጊ፥ ማንቅታ፥ ዎብታ፥ ቶእታኔ ጉንዴዝታ Ꮊና ኮኦባ› ዬጌዛ።<verse eid="LUK 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 14:22"/>«አይላይ፥ ‹ታ ጎዳዮ፥ ነ ኪቴዛይ ኡቢታይ ፖልንቴዛ፥ ዝን Ꮊተካ አቆ የዛ› ዬጌዛ።<verse eid="LUK 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 14:23"/>«ጎዳይ አይላይኮ፥ ‹ጎስታይል አፋኔ፥ ካራ ጋንጨ ኦገል ከዞባ፥ ታ ኬይ ኩሞድ ጋ በንቴዝ ኡቢታይ የኦድ ጋርክ ኡዶባ። <verse eid="LUK 14:23"/><verse number="24" style="v" sid="LUK 14:24"/>ታ ይንትስ ኦድዛ፤ እማትንቲ አቴዝታይፕ ኦንካ ታ አታላይፕ ማምዛና ኤሮይታ› ጌዛ» ዬጌዛ።<verse eid="LUK 14:24"/></para>
  <para style="s1">ጎዳ ካሎ ጭግስዛ ጋተ</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 14:25"/>ጋመ አሳይ ኤዛር ዎላ Ꮊማዳር የሱሳ ኡንትኮ ጉየ ማቂ፥ <verse eid="LUK 14:25"/><verse number="26" style="v" sid="LUK 14:26"/>«ታኮ ይእዝ ኡቢታይ ፋ አዳኔ ፋ እንዶ፥ ፋ ማቻቶኔ ፋ ናእታ፥ ፋ እሽታኔ ፋ ምሽታ፥ ሀራ አቶዝን ፋ ሸምፖ እጾዛይ ታ ታማረ ማቆዳይስ ዳንዳኦያ።<note caller="-" style="x"><char style="xo" closed="false">14:26 </char><char style="xt" closed="false"><ref loc="MAT 10:37">ማቶ. 10:37</ref></char></note> <verse eid="LUK 14:26"/><verse number="27" style="v" sid="LUK 14:27"/>ፋ ማዝቃለ ቶኪ ታና ካሎዋ ኦንካ ታ ታማረ ማቆዳይስ ዳንዳኦያ።<note caller="-" style="x"><char style="xo" closed="false">14:27 </char><char style="xt" closed="false"><ref loc="MAT 10:13">ማቶ. 10:13</ref>፤ <ref loc="MAT 16:24">16:24</ref>፤ <ref loc="MRK 8:34">ማር. 8:34</ref>፤ <ref loc="LUK 9:23">ሉቃ. 9:23</ref></char></note><verse eid="LUK 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 14:28"/>«ይንታፕ ፐቲ አሲ ሹች ኬ ኬጾዳይስ ኮይኮ፥ ኬ ኬጺ ዉርሶዳይስ አብ ጋርክ ሚሸ ኮሽዛኮ ቲናቲ ኤሮዳይስ ቆፖዛይ ኦኖ? <verse eid="LUK 14:28"/><verse number="29" style="v" sid="LUK 14:29"/>የያ ማቀካ አትኮ፥ Ꮊ አይ ባሶል ሹች ሂጽን ዉርሶ ጋምኮ፥ <verse eid="LUK 14:29"/><verse number="30" style="v" sid="LUK 14:30"/>ብእዛ ኡባይ፥ ‹Ꮊ አይ ግምብ አይክን ዉርሶዳይስ ኤዛ ጋሜዛ› ዬጊ ቦርዛ።<verse eid="LUK 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 14:31"/>«ዎይ ፐቲ ካታይ ሀራ ካታር ኦልንቶዳይስ ደንድታር ላታም ሙኩለ ኦላንችታ ኤኪ የ በሳ ካታይር ታጲ ሙኩለ ኦላንችታር ኤቅንቶዳይስ ዳንዳኦዳናኔ ዳንዳአምዛ ቲናቲ በቲ ዞርንቶዛይ ኦኖ? <verse eid="LUK 14:31"/><verse number="32" style="v" sid="LUK 14:32"/>ኤቅንቶዳይስ ዳንዳእንቶዋ ባዝ ማቅኮ፥ የ ሀራ ካታይር ሃኮር የዝን ዳቦቶዳይስ ቲናቲ ጭማ ዳኪ ኦይጭሽዛ። <verse eid="LUK 14:32"/><verse number="33" style="v" sid="LUK 14:33"/>የይ ጋርከ፥ ይንታፕ ኦንካ ፓስ የዛ ባዝ ኡብታ አሻም እጽኮ ታ ታማረ ማቆዳይስ ዳንዳኦያ።<verse eid="LUK 14:33"/></para>
  <para style="s1">ማልኦዋ ማጽነ</para>
  <para style="r">(<ref loc="MAT 5:13">ማቶ. 5:13</ref>፤ <ref loc="MRK 9:50">ማር. 9:50</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 14:34"/>«ማጽነ ሎኦ፥ ዝን ማጽነ ፋ ማልአ አሽኮ፥ ዋይዚ ማጽነ ጊንትንቶዳይስ ዳንዳእኔ? <verse eid="LUK 14:34"/><verse number="35" style="v" sid="LUK 14:35"/>ቢታስካ አራድሶስካ ማዶዋ ባዝ ማቅዝ ግሾስ አላ ኦልንቶዳ። ይኬ፥ ስእዝ ሀየር የዝ አስ ስኦ» ዬጌዛ።<verse eid="LUK 14:35"/></para>
  <chapter eid="LUK 14"/>
  <chapter number="15" style="c" sid="LUK 15"/>
  <para style="s1">ቢ በንቴዝ ዱር ኣዝሶ</para>
  <para style="r">(<ref loc="MAT 18:12-14">ማቶ. 18:12-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 15:1"/>ፐቲ ጋላስ ቃራጸ ጋችሽዝታይኔ ናጋራ ኦዝ አሳይ የሱሳ ትምርታ ስኦዳይስ ኤ ላንቃይር ሺቄዛ።<note caller="-" style="x"><char style="xo" closed="false">15:1-2 </char><char style="xt" closed="false"><ref loc="LUK 5:29-30">ሉቃ. 5:29-30</ref></char></note> <verse eid="LUK 15:1"/><verse number="2" style="v" sid="LUK 15:2"/>ዝን ፈርሳውታይራኔ ህገ አስታማርታይ፥ «Ꮊ አይ ናጋራንችታ ሺሺ ኤክዛ፥ ኡንታር ዎላ ሚዛ» ዬጊ ዝግሬዛ።<verse eid="LUK 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 15:3"/>የሱሳ ዬጊ Ꮊ ኣዝሳ ኡንትስ ኦዴዛ፦ <verse eid="LUK 15:3"/><verse number="4" style="v" sid="LUK 15:4"/>«ይ ጋንጨፐ ፐታይስ ጼት ዱርታይ የዛ ባዝ ማቅኮ ኡንታፕ ፐታይ ብኮ ኡዱፉን ታማኔ ኡዱፉንታ ዎራ አሺ ቤዛና ደንጎድ ጋ ኮዮዛይ ኦኖ? <verse eid="LUK 15:4"/><verse number="5" style="v" sid="LUK 15:5"/>ደንጌዝ ዎደ ኡፋይቲ ፋ ጋናል ቶኪ፥ <verse eid="LUK 15:5"/><verse number="6" style="v" sid="LUK 15:6"/>ፋ ካራ ማቅዛ። ፋ ላግታኔ ሾርታ ዎላ ጼጊ፥ ‹ቤዝ ታ ዱራ ደንጌዛ፥ ታር ዎላ ኡፋይቶይታ› ዬግዛ። <verse eid="LUK 15:6"/><verse number="7" style="v" sid="LUK 15:7"/>የይ ጋርከካ፥ ማሮት ገሎዋ ኡዱፉን ታማኔ ኡዱፉን ጽልታይፕ ፋ ናጋራስ ማሮተ ገልዝ ፐቲ አይ ግሾስ ሳሎ ዳሞ ኡፋይስ ማቅዛ።<verse eid="LUK 15:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 15:8"/>«ዎይ ታጲ ሹቻ ብራ የዛ ፐቲ አስታ ታጵፕ ፐታት ብኮ ደንጎድ ሄሎዳይስ ጾምፐ አይ ኬ ፕቲ ሚን ኮዮዛይ ኦኖ? <verse eid="LUK 15:8"/><verse number="9" style="v" sid="LUK 15:9"/>ደንጌዝ ዎደ ፋ ላግታኔ ፋ ሾርታ ጼጊ ‹ቤዝ ታ ሹቻ ብርቶ ደንጌዝ ግሾስ ታር ኡፋይቶይታ› ዬግዛ። <verse eid="LUK 15:9"/><verse number="10" style="v" sid="LUK 15:10"/>ስኦይታ፥ የይ ጋርክ ፐቲ ማሮት ገልዝ ናጋራንቻይር ጾሳ ኪታንችታይ ቲና ኡፋይስ ማቅዛ» ዬጌዛ።<verse eid="LUK 15:10"/></para>
  <para style="s1">ቤዝ ናአይ ኣዝሶ</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 15:11"/>ማቂ የሱሳ፥ «ፐቲ አይስ ናምኢ ናእታይ የዛ። <verse eid="LUK 15:11"/><verse number="12" style="v" sid="LUK 15:12"/>ኡንታፕ ጌዶ ናአይ ፋ አዳይኮ፥ ‹ታ አዳዮ፥ ነ ሻላይፕ ታ ባጋ ታስ እንጎባ› ዬጌዛ። አዳይ ፋ ሻላና ፋ ናእታይስ ሻጌዛ። <verse eid="LUK 15:12"/><verse number="13" style="v" sid="LUK 15:13"/>ጽቃ ጋላሳፕ ጉየ ጌዶ ናአይ ፋ ባጋ ኡብታ አጪ ኤኪ ሃኮ ጋደ Ꮊንጌዛ። ኤዛይድ ኤኪ Ꮊንጌዝ ሻላና ቶቺ ዉርሴዛ። <verse eid="LUK 15:13"/><verse number="14" style="v" sid="LUK 15:14"/>ኤ ፓስ የዛ ባዝ ኡብታ ዉርሴዛይፕ ጉየ የ ጋዳይድ ኡባይል ሚን ናየ ገልን መትንቴዛ። <verse eid="LUK 15:14"/><verse number="15" style="v" sid="LUK 15:15"/>የይ ግሾስ፥ የ ጋደ አሳይፕ ፐታይ ካራ ጋታ ገሌዛ። አይ ኤዛ ጉዳይለ ሄማድ ጋርክ ፋ ሞ ዳኬዛ። <verse eid="LUK 15:15"/><verse number="16" style="v" sid="LUK 15:16"/>ጉዳይልታይ ሚዝ ሀርቃይፕ ማዳይስ አሞቴዛ፥ ዝን እዞካ ኤዝስ እንግዛ አሲ በንተካያ። <verse eid="LUK 15:16"/><verse number="17" style="v" sid="LUK 15:17"/>ፋ ዎዝናር፥ ‹ኣፑን ታ አዳይ አይልታይስ ካ አላ አትን ታ Ꮊይዳ ናየር Ꮊይቀ?› <verse eid="LUK 15:17"/><verse number="18" style="v" sid="LUK 15:18"/>ደንዲ ታ አዳይኮ Ꮊንጊ፥ ‹ታ አዳዮ፥ ሳሎ ጾሳ፥ ሳአ ነና ታ ቆሄዛ። <verse eid="LUK 15:18"/><verse number="19" style="v" sid="LUK 15:19"/>Ꮊንፕ ነ ናአ ግንትንቲ ጼግንቶዳይስ ታስ ቤዞዋ ግሾስ ነ ካራ የዝ አይልታይፕ ፐታይ ጋርክ ኡዲ ታና ታይቦባ› ዬጎዳ» ዬጌዛ። <verse eid="LUK 15:19"/><verse number="20" style="v" sid="LUK 15:20"/>የይ ግሾስ፥ ደንዲ ፋ አዳይኮ Ꮊንጌዛ።</para>
  <para style="p" vid="LUK 15:20">«ሀኖ ዝን፥ ኤ ሀጋ ሃኮር የዝን አዳይ ቃንቲ፥ ኤዝኮ ዎጺ Ꮊንጊ እድንጊ ዬሬዛ። <verse eid="LUK 15:20"/><verse number="21" style="v" sid="LUK 15:21"/>ናአይካ፥ ‹ታ አዳዮ ሳሎ ጾሳ፥ ሳአ ነና ታ ቆሄዛ። Ꮊንፕ ገደ ነ ናአ ግንትንቲ ጼግንቶዳይስ ታስ ቤዞያ› ዬጌዛ።<verse eid="LUK 15:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 15:22"/>«ኤ አዳይ አይልታ ጼጊ፥ ‹ኤልሲ ኡባፕ ሎኦ ማቄዝ አፍላ ክኢ ኤዛ ማእሲ፤ ኤ ብራይዳካ ምግዶ፥ ኤ ቶካይድ ጫማ ኣይታ። <verse eid="LUK 15:22"/><verse number="23" style="v" sid="LUK 15:23"/>ሞ መሄ ክኢ ሹኮይታ፥ ማዳ፥ ኡፋይቶዳ። <verse eid="LUK 15:23"/><verse number="24" style="v" sid="LUK 15:24"/>ታ ናአይ Ꮊይ Ꮊይቄዛ፥ ዝን Ꮊቴ ፓጼዛ፤ ቤዛ፥ ዝን በንቴዛ› ዬጌዛ። የይፐ ጉየ፥ ኡፋይት አይኬዛ።<verse eid="LUK 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 15:25"/>«የ ዎደ ባይራ ናአይ ዎታ ጋደ የዛ። ኤዛይፕ ይእታር ካራ ኡኮዳር የኔ ዶን ጊር ስኤዛ። <verse eid="LUK 15:25"/><verse number="26" style="v" sid="LUK 15:26"/>አይልታይፕ ፐታ ጼጊ ሀንዛይ አብዛኮ ኤሮዳይስ ኦይጬዛ። <verse eid="LUK 15:26"/><verse number="27" style="v" sid="LUK 15:27"/>አይላይ፥ ‹ነ እሻይ ሳሮ የኤዝ ግሾስ ነ አዳይ ሞ መሄ ኤዝስ ሹኬዛ› ዬጌዛ።<verse eid="LUK 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 15:28"/>«ባይራ እሻይ ካጭንቲ ካራ ገሎዳይስካ ኮየካያ። አዳይ ባለ ከዚ ካራ ገሎዳይ ጋርክ ኤዛ ዎሴዛ። <verse eid="LUK 15:28"/><verse number="29" style="v" sid="LUK 15:29"/>ዝን ኤ ፋ አዳይኮ፥ ‹ዬዛኮ፥ Ꮊይ ጋርክ ላይ ታ ኔስ አይለት ነ ኪታፐ ፐቶካ ፓጭንቸካዛር ኔስ ኪትንትን ታ ታ ላግታይር ኡፋይቶድ ጋርክ ሀራ አቶዝን ፐቲ ሆጎ ዴሽ ታስ እንገካያ። <verse eid="LUK 15:29"/><verse number="30" style="v" sid="LUK 15:30"/>ዝን፥ Ꮊይ ነ ናአይ ነ ሻላና ላምዝታይር ዶንጊ ዉርሲ ይእን ሞ መሄ ሹኬነ ባይ› » ዬጌዛ።<verse eid="LUK 15:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 15:31"/>«አዳይካ፥ ‹ታ ናአዮ፥ ነ ኡባ ዎደ ታር የዛ፥ ታባዝ ኡባይ ኔስ። <verse eid="LUK 15:31"/><verse number="32" style="v" sid="LUK 15:32"/>Ꮊይ ነ እሻይ Ꮊይቄዛ፥ ዝን ፓጼዛ፤ ቤዛ፥ ዝን በንቴዛ። የይ ግሾስ፥ ጋመ ኡፋይቶዳይስ ቤዝዛ› ዬጎዳ» ዬጌዛ።<verse eid="LUK 15:32"/></para>
  <chapter eid="LUK 15"/>
  <chapter number="16" style="c" sid="LUK 16"/>
  <para style="s1">አማንንቶዋ ሹማይ ኣዝሶ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 16:1"/>የሱሳ ፋ ታማርታይኮ፥ «ፐቲ ዱረ አይስ ኤዝፕ ኦሞር ፐቲ ሹማይ የዛ። የ ሹማይ ፋ ጎዳይ ሻላና ቶቼዛ ዬጊ ሞቴዛ። <verse eid="LUK 16:1"/><verse number="2" style="v" sid="LUK 16:2"/>ሻሎ ጎዳይ ሹማ ጼግሲ፥ ‹ታኒ ዋግዝን ስአሬ? Ꮊንፕ ነ ታ ኬስ ሹም ማቂ ኦዳይስ ዳንዳኦዋ ግሾስ ታ ሻላና ታና ሄልባ› ዬጌዛ።<verse eid="LUK 16:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 16:3"/>«የ ሹማይካ ፋ ዎዝናር Ꮊይ ጋርከ ዬጊ ቆፔዛ። ‹ታ ጎዳይ ታና ሹመትይፕ ዎድ ሀንዛ፥ ዎቲ አቆዳይስ ዎልቃ ባያ፥ ዎሲ ማዳይስ ዬላዛ፤ የዝን ታ ዋይዞ? <verse eid="LUK 16:3"/><verse number="4" style="v" sid="LUK 16:4"/>ሹማትፕ ታና ዎስኮ ዎደ አሳይ ታና ሞኮድ ጋርክ ኦድ ባዝ ታ ኤርዛ› ዬጌዛ።<verse eid="LUK 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 16:5"/>«የይ ግሾስ፥ ኤ ጎዳይ አጮ የዝ አሳ ፐታ ፐታ ጼጊ ክኢ ቲና አይኮ፥ ‹ኔል አፋ ታ ጎዳይ አጮ ኣፑኒ የኔ?› ዬጊ ኦይጬዛ።<verse eid="LUK 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 16:6"/>«ኤ፥ ‹ጼት ኦታ ዛይተ አጮ የዛ› ዬጌዛ።</para>
  <para style="p" vid="LUK 16:6">«ሹማይ፥ ‹ዉለ ዋርቃታ Ꮊይሼ፥ ኤልሲ፥ እሻታም ኦታ ዛይተ አጮ የዛ ግ ጻፎባ› ዬጌዛ።<verse eid="LUK 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 16:7"/>«የይፐ ካል ናምእንይኮ፥ ‹ኔስ ኣፑኒ የኔ?› ዬጌዛ።</para>
  <para style="p" vid="LUK 16:7">«ኤ፥ ጼት ጆንያ ‹ግስተ አጮ የዛ› ዬጌዛ።</para>
  <para style="p" vid="LUK 16:7">«ሹማይ፥ ‹ነ ዉለ ዋርቃታ Ꮊይሸ፥ ኤልሲ፥ ሆስፑን ታም ጆንያ ዬጊ ጻፎባ› ዬጌዛ። <verse eid="LUK 16:7"/><verse number="8" style="v" sid="LUK 16:8"/>ሻሎ ጎዳይ አማንንቶዋ ሹማይ ኤ ብላማትይስ ናሽቼዛ። Ꮊ አላማይ ናእታይ አስ አይር ፖኦ ናእታይፕ ኣዝ ዎዛናምታ።<verse eid="LUK 16:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 16:9"/>«የይ ግሾስ፥ ታ ይንትስ ኦድዛ፤ Ꮊ ዎርዶ ሚሻይ ዎርዶር በንቴዝ ዎዳይድ መና ኬ ይንታን ሞኮዳይ ጋርክ ሚሻይር ይንትስ ላግታ ዎንጎይታ። <verse eid="LUK 16:9"/><verse number="10" style="v" sid="LUK 16:10"/>ኡባይፕ ጽቃ ባዛል አማንንቴዛይ ጋመ ባዛል አማንንቴዛያ ማቅዛ። ማ ኡባፕ ጽቃ ባዛል አማንንቶዋዛይ ጋመ ባዛል አማንንቶያ። <verse eid="LUK 16:10"/><verse number="11" style="v" sid="LUK 16:11"/>ይኬ፥ Ꮊ አላመ ሚሸል ይ አማንንታም እጽኮ ቱማ ሚሸ ይንትስ ኦኒ ሀዳራ እማደ? <verse eid="LUK 16:11"/><verse number="12" style="v" sid="LUK 16:12"/>ይንቲ ሀራ አስ ሚሸል አማንንታም እጽኮ፥ ይ ቡዞ ሚሸ ይንትስ ኦኒ እማደ?<verse eid="LUK 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 16:13"/>«ፐቲ አይላይ ናምኢ ጎድታይስ ሞድንቶዳይስ ዳንዳኦያ። ፐታ እጽኮ Ꮊንካያ ቃዛ ዎይ ፐታይኮ ሺቅኮ Ꮊንካያ ለቂዛ። የይ ጋርክ፥ ይ ጾስስኔ ሚሸስ ሞድንቶዳይስ ዳንዳኦያ።»<note caller="-" style="x"><char style="xo" closed="false">16:13 </char><char style="xt" closed="false"><ref loc="MAT 6:24">ማቶ. 6:24</ref></char></note><verse eid="LUK 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 16:14"/>ሚሸ ቃዛ ፈርሳውታይ የያ ስኢ የሱሳና ቃልዴዛ። <verse eid="LUK 16:14"/><verse number="15" style="v" sid="LUK 16:15"/>ኤ፥ «ይንቲ ይንታን አስ ቲና ጽልስዛ፥ ዝን ጾሳይ ይ ዎዝና ኤርዛ። አስ ቲና ቦንችንቴዛይ ጾስ ቲና ቦርንቴዛ።<verse eid="LUK 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 16:16"/>«ሙሰ ህጋይኔ ናብታይ ኪታይ ዋንሳ ሄሎዳይስ ይንትስ ኦድንትታር ጋምኤዛ። የይፐ ጉየ፥ ጾሳ ካተት ዎንግላይ ኦታር ጋምኤዛ። አሲ ኡባይ የ አቃ ገሎዳይስ ዳፍንትዛ።<note caller="-" style="x"><char style="xo" closed="false">16:16 </char><char style="xt" closed="false"><ref loc="MAT 11:12-13">ማቶ. 11:12-13</ref></char></note> <verse eid="LUK 16:16"/><verse number="17" style="v" sid="LUK 16:17"/>ማቆዝን፥ ህጋይፕ ፐቲ ላፋ ፕዳለ አቶዳይፕ ሳሎራኔ ሳአር ኣዛይ ሻዉክዛ።<note caller="-" style="x"><char style="xo" closed="false">16:17 </char><char style="xt" closed="false"><ref loc="MAT 5:18">ማቶ. 5:18</ref></char></note><verse eid="LUK 16:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 16:18"/>«ፋ ማቻቶ ዳኪ ሀራ ኤክዛ ኡባይ ዎድረ ላምዛ። ፋ አዝናይፕ አንጅቴዛኖ ኤኬዛይካ ዎድረ ላምዛ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">16:18 </char><char style="xt" closed="false"><ref loc="MAT 5:32">ማቶ. 5:32</ref>፤ <ref loc="1CO 7:10-11">1ቆሮ. 7:10-11</ref></char></note><verse eid="LUK 16:18"/></para>
  <para style="s1">ዱረ አኔ አላዛራ</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 16:19"/>«አልኦኔ ቡቁሮ አፍላ ማእዛ፥ ሳአ ሀንን ጋላስ ጋላስ ኡፋይሳር የዝ ፐቲ ዱረ አስ የዛ። <verse eid="LUK 16:19"/><verse number="20" style="v" sid="LUK 16:20"/>ሀራ ማ ጋላይ ሙመር ማዱንጼዝ ፐቲ አላዛራ ግንትንትዝ ማንቃይ የ ዱረ አይ ባለ ዶግንቲ አቴዛይ የዛ። <verse eid="LUK 16:20"/><verse number="21" style="v" sid="LUK 16:21"/>ናየፕ ደንዴዛይድ ዱረ አይ ሌማተፕ ዎዝ ጉፋ ማዳይስ አሞትታር የዛ። ሀራ አቶዝን፥ ካንታይ ይኢ ኤ ማዶ ላእዛ።<verse eid="LUK 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 16:22"/>«የ ማንቃይ Ꮊይቄዛ፤ ኪታንችታይ ኤዛ አፍራመ ክኦ ካንጌዛ። ማ ዱረ አይካ Ꮊይቂ ሞግንቴዛ። <verse eid="LUK 16:22"/><verse number="23" style="v" sid="LUK 16:23"/>ስኦለ ኡንእንቲ የዝታር ቅ ግ ሃኮር አፍራመኔ ኤ ክኦ የዝ አላዛራ በኤዛ። <verse eid="LUK 16:23"/><verse number="24" style="v" sid="LUK 16:24"/>ኤ፥ ‹አዳዮ አፍራመ፥ ታስ ቃንቶየ፤ Ꮊ ላ ታማይ ጋንጨ ኤጽታር የዝ ግሾስ አላዛረ ፋ ብራ ጼራቶ ሃ ዳኪ ታ እራንቶ ላክድ ጋርክ ሀያና ኤዛ ዳኮየ› ዬጊ ኡኬዛ።<verse eid="LUK 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 16:25"/>«ዝን አፍራመ ኤዝኮ፥ ‹ታ ናአዮ፥ ነ ሳአ የሳይድ ሎኦ ባዝ ኤኬዛናኔ፥ ማ አላዛረ ኢታ ባዝ ኤኬዛና አካኮባ። ዝን Ꮊት ኤ Ꮊይዳ ኡፋይትዛ፥ ማ ኔኒ ዋይታር የዛ› ዬጌዛ። <verse eid="LUK 16:25"/><verse number="26" style="v" sid="LUK 16:26"/>Ꮊ ኡባፕ ኣ፥ ‹Ꮊይፐ ይንትኮ፥ ይንፐ Ꮊና ኑኮ ኣዳይስ ኮይዝታይ ፒንጋም ጋርክ ኑስኔ ይንትስ ጋንጨ ዳማ ጋጋ የዛ› ዬጌዛ።<verse eid="LUK 16:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 16:27"/>«ዱረ አይ፥ ‹ታ አዳዮ፥ ዬዛኮ አላዛራ ታ አዳይ ካራ ኪቶድ ጋርክ ታ ነና ዎስዛ። <verse eid="LUK 16:27"/><verse number="28" style="v" sid="LUK 16:28"/>ታስ እችን እሽታይ የዛ፥ ኡንትካ Ꮊ መቶ አቃ የአማይ ጋርክ ኡንትስ Ꮊንጊ ማርካቶ› ዬጌዛ።<verse eid="LUK 16:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 16:29"/>«ዝን አፍራመ፥ ‹ኡንትስ ሙሰራኔ ናብታይር የዛ፤ ኡንቲ ኦዴዝ ባዝ ስኦ› ዬጌዛ።<verse eid="LUK 16:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 16:30"/>«ዱረ አይ፥ ‹አዳዮ አፍራመ፥ የይ ጋርክ ባያ፤ ፐቲ አሲ Ꮊይቆፕ ደንዲ Ꮊንግኮ ኡንቲ ማሮት ገሎዳ› ዬጌዛ።<verse eid="LUK 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 16:31"/>«አፍራመ፥ ‹ሙሰኔ ናብታ ስአም እጽኮ፥ ሀራ አቶዝን Ꮊይቆፕ ፐቲ አሲ ደንዲ ኦድኮካ አማነና› ዬጌዛ።»<verse eid="LUK 16:31"/></para>
  <chapter eid="LUK 16"/>
  <chapter number="17" style="c" sid="LUK 17"/>
  <para style="s1">አስስ በ ማቆዳይፕ ናግንቶ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 17:1"/>የሱሳ ፋ ታማርታይኮ፥ «አስ ብ ናጋራ ገልስዛባዝ ይእይ አተና። ማቆዝን፥ ናጋራ ገሎድ ጋርክ ኦዛ አይ አየ» ዬጌዛ። <verse eid="LUK 17:1"/><verse number="2" style="v" sid="LUK 17:2"/>የ አይ ጽቅታይፕ ፐታ ባልዳይፕ ዎጻ ፋ ቆል አጪ አባ ጋንጨ ቅትኮ ኤዝስ ሎኦ። <verse eid="LUK 17:2"/><verse number="3" style="v" sid="LUK 17:3"/>የይ ግሾስ ናግንቶይታ።<note caller="-" style="x"><char style="xo" closed="false">17:3 </char><char style="xt" closed="false"><ref loc="MAT 18:15">ማቶ. 18:15</ref></char></note></para>
  <para style="p" vid="LUK 17:3">«ነ እሻይ ናጋራ ኦኮ ካጮባ፤ ቂራ ማሮትር ማቅኮ፥ ኤዝስ አቶ ጎባ። <verse eid="LUK 17:3"/><verse number="4" style="v" sid="LUK 17:4"/>ፐቲ ጋላስ ላፑን ቶኬ ቆህ፥ ላፑን ቶኬ፥ ‹ታኒ ታ ቡታ ኤሬዛ ታና ማሮባ› ዬጊ ይእኮ ኤዝስ አቶ ጎባ።»<verse eid="LUK 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 17:5"/>ሀዋርታይ ጎዳይኮ፥ «አማኖ ኑስ ጉጆየ» ዬጌዛ።<verse eid="LUK 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 17:6"/>ጎዳይ፥ «ሳናፍጨ ኣፈ ጋርክ አማኖ ይንትስ የዝኮ ‹Ꮊ ዋላ ሾድንቲ አባ ጋንጨ ቱክንቶባ› ዬግኮ ይንትስ ኪትንቶዳ» ዬጌዛ።<verse eid="LUK 17:6"/></para>
  <para style="s1">አማንንትዛ አይላይ ኦሶ</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 17:7"/>ጉጅካ የሱሳ፥ «ይ ጋንጨፐ ፐታይስ ዎትዛ ዎይ ዱረ ሄንግዝ አይለ የዝኮ ኦሶ ጋደፕ ዎይ ዉደፕ ካራ ማቃዳር ‹ኤለ ካ ማዳይስ Ꮊና ይኢ በቶባ› ዬግዛይ የኔ? <verse eid="LUK 17:7"/><verse number="8" style="v" sid="LUK 17:8"/>ባያ፥ ‹ታስ ካሆ ጊግሶባ፤ ታ ም፥ ኡዢ አሾድ ጋ ኤቂ ሙዞባ። የይፕ ጉየ፥ ነ ማ ማዳኔ ኡዦዳ› ዬግንባሳ? <verse eid="LUK 17:8"/><verse number="9" style="v" sid="LUK 17:9"/>ይኬ ጎዳይ አይላይ ኪታ ፖሌዝ ግሾስ አንጅኔ? <verse eid="LUK 17:9"/><verse number="10" style="v" sid="LUK 17:10"/>የይ ግሾስ፥ ይንትካ ኪታ ኡብታ ፖሌዝ ዎደ ‹ኑ ፓዋ አይልታይ፤ ኦዳይስ ቤዝዛ ኦሶ ፖሌዛ› ዬጎይታ» ዬጌዛ።<verse eid="LUK 17:10"/></para>
  <para style="s1">ቦርቆንቶ ሀርገፕ ጌዤዝ ታጲ አስታ</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 17:11"/>የሱሳ የሩሳላመ Ꮊንግታር ሳማረስኔ ጋልላ ቢታስ ጋንጨር ቆእ ኣዛ። <verse eid="LUK 17:11"/><verse number="12" style="v" sid="LUK 17:12"/>ፐቲ ሄራ ገሎዳር ቦርቆንቶ ሀርገር አይክንቴዝ ታጲ አስታይ ኤዛና ደንጌዛ። ኡንትካ ሃኮ ኤቂ፥ <verse eid="LUK 17:12"/><verse number="13" style="v" sid="LUK 17:13"/>«ጎዳ የሱሳ፥ ኑስ ቃንቶየ» ዬጊ ኡኬዛ።<verse eid="LUK 17:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 17:14"/>ኤ ኡንታን ብኢ «Ꮊንጊ ይ ጋላ አይሁድታይ ቄሰ ቤዞይታ» ዬጌዛ። ኡ ኦገር Ꮊንግታር ጌዤዛ።<note caller="-" style="x"><char style="xo" closed="false">17:14 </char><char style="xt" closed="false"><ref loc="LEV 14:1-32">ለዊ. 14:1-32</ref></char></note><verse eid="LUK 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 17:15"/>ኡንታፕ ፐታይ ፋ ጌዥ ብኢ ቅ ጌዝ ቃላር ጾሳ ቦንችታር የሱሳኮ ማቄዛ። <verse eid="LUK 17:15"/><verse number="16" style="v" sid="LUK 17:16"/>ኤዚ ሳማረ ቢታ አስ፥ ዝን የሱሳ ቶካይል አፋ ጹጉኒ ኤዛ ጋላቴዛ።<verse eid="LUK 17:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 17:17"/>የሱሳ፥ «ጌዤዛይ ታጲ አስታ ባሳ? የዝን፥ ኡዱፉንታይ አባ የኔ? <verse eid="LUK 17:17"/><verse number="18" style="v" sid="LUK 17:18"/>Ꮊ አላጋ አይፕ<note caller="+" style="f"><char style="fr" closed="false">17:18 </char><char style="fqa" closed="false">Ꮊ አላጋ አይፕ፦ </char><char style="ft" closed="false">ቦርቆንቶ ሀርጋይፕ ፓጼዝ አይ አላጋ ጊንትንቴዛይ ኤ አይሁድታይ ማቀካ ግሾስ።</char></note> አትን ሀራ ማቂ ጾሳ ጋላትዛ አስ በንተካያ» ዬጌዛ። <verse eid="LUK 17:18"/><verse number="19" style="v" sid="LUK 17:19"/>አይኮ፥ «ነ አማናይ ነና ጌሼዛ፤ ደንዲ ቅቶባ» ዬጌዛ።<verse eid="LUK 17:19"/></para>
  <para style="s1">ጾስ ካተት ይእ</para>
  <para style="r">(<ref loc="MAT 24:23-28">ማቶ. 24:23-28</ref>፥ <ref loc="MAT 24:37-41">37-41</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 17:20"/>ፈርሳወ አስታይ፥ «ጾስ ካተትይ አይደ የኦዴ?» ግ የሱሳና ኦይጬዛ። ኤ፥ «ጾስ ካተትይ ናጎር የኦያ። <verse eid="LUK 17:20"/><verse number="21" style="v" sid="LUK 17:21"/>ማካ እዞ፥ ‹Ꮊኔ ዎይ ይነ ዬጎዳይስ ዳንዳኦያ። አብስ ጊኮ ጾስ ካተትይ ይ ጋንጨ የዛ› » ዬጊ ማሄዛ።<verse eid="LUK 17:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 17:22"/>የሱሳ ፋ ታማርታይኮ፥ «አስ ናአይ ጋላስታይፕ ፐታ በአዳይስ ይ አሞትዝ ዎዳይ የኦዳ፥ ዝን ይ በአሚ። <verse eid="LUK 17:22"/><verse number="23" style="v" sid="LUK 17:23"/>አሳይ፥ ‹ኤ የይድ የዛ› ዎይ፥ ‹Ꮊይዳ የዛ› ዬጎዳ፥ ዝን ኡንታን ካሊ Ꮊንግፓተ። <verse eid="LUK 17:23"/><verse number="24" style="v" sid="LUK 17:24"/>ዜልን ዜልንጊ ሳሎ ጋጻፕ ጋጻ ፖእስዛይ ጋርክ አስ ናአይ ይእ ጋላሳይ የይ ጋርክ ሀኖዳ። <verse eid="LUK 17:24"/><verse number="25" style="v" sid="LUK 17:25"/>ዝን የይ ሀኖዳይፕ ቲና አስ ናአይ ጋመ ዋዮዳይስኔ Ꮊ የለትይድ እጽንቶዳይስ ቤዝዛ። <verse eid="LUK 17:25"/><verse number="26" style="v" sid="LUK 17:26"/>ኖሄ ዎደ ሀኔዛይ ጋርክ አስ ናአይ ዎዳይዳካ የይ ጋርክ ሀኖዳ።<note caller="-" style="x"><char style="xo" closed="false">17:26 </char><char style="xt" closed="false"><ref loc="GEN 6:5-8">መ. 6:5-8</ref></char></note> <verse eid="LUK 17:26"/><verse number="27" style="v" sid="LUK 17:27"/>ኖሄ ማርካበ ገሌዝ ቃማ ሄሎዳይስ አሳይ ሚታራኔ ኡዥታር፥ ኤክታራኔ ገልታር የዝን ብስዛ ሃይ ይኢ ኡብታ ብሴዛ።<note caller="-" style="x"><char style="xo" closed="false">17:27 </char><char style="xt" closed="false"><ref loc="GEN 7:6-24">መ. 7:6-24</ref></char></note> <verse eid="LUK 17:27"/><verse number="28" style="v" sid="LUK 17:28"/>ሎጸ ላይካ የይ ጋርክ ሀኔዛ። አሳይ ሚታራኔ ኡዥታር፥ ዎንግታራኔ ባይዝታር፥ ቱክታራኔ ኬጽታር፥ ጋምኤዛ።<note caller="-" style="x"><char style="xo" closed="false">17:28-29 </char><char style="xt" closed="false"><ref loc="GEN 18:20-19:25">መ. 18:20—19:25</ref></char></note> <verse eid="LUK 17:28"/><verse number="29" style="v" sid="LUK 17:29"/>ሎጸ ሶዶማፐ ከዜዝ ጋላስ ዲነ ግንትንትዝ ጹግዝ ታማ ሳሎፕ ቡኪ ኡባ ባዝ ብሴዛ። <verse eid="LUK 17:29"/><verse number="30" style="v" sid="LUK 17:30"/>አስ ናአይ በንትዝ ዎደካ የይ ጋርክ ሀኖዳ።<verse eid="LUK 17:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 17:31"/>«የ ጋላስ ኦንካ ባለ የዛይ ኬል የዛይካ ጋንጨ የዝ ባዝ ኤኮዳይስ ካራ ገልፐ። የይ ጋርከ፥ ጋደ የዝ አሲ አብስካ ካራ ማቅፐ።<note caller="-" style="x"><char style="xo" closed="false">17:31 </char><char style="xt" closed="false"><ref loc="MAT 24:17-18">ማቶ. 24:17-18</ref>፤ <ref loc="MRK 13:15-16">ማር. 13:15-16</ref></char></note> <verse eid="LUK 17:31"/><verse number="32" style="v" sid="LUK 17:32"/>ሎጸ ማቻቶ አካኮይታ፤<note caller="-" style="x"><char style="xo" closed="false">17:32 </char><char style="xt" closed="false"><ref loc="GEN 19:26">መ. 19:26</ref></char></note> <verse eid="LUK 17:32"/><verse number="33" style="v" sid="LUK 17:33"/>ፋ ሸምፓቶ አሾዳይስ ኮይዝ አሲ ኦንካ ብሶዳ፤ ፋ ሸምፓቶ ኣ እንግዝ ኦንካ አሾዳ።<note caller="-" style="x"><char style="xo" closed="false">17:33 </char><char style="xt" closed="false"><ref loc="MAT 10:39">ማቶ. 10:39</ref>፤ <ref loc="MAT 16:25">16:25</ref>፤ <ref loc="MRK 8:35">ማር. 8:35</ref>፤ <ref loc="LUK 9:24">ሉቃ. 9:24</ref>፤ <ref loc="JHN 12:25">ዋን. 12:25</ref></char></note> <verse eid="LUK 17:33"/><verse number="34" style="v" sid="LUK 17:34"/>ታ ይንትስ ኦድዛ፤ የ ጋላስ ናምኢ አሳይ ፐቲ አርሳል ዎይአዳ። ፐታይ ኤክንቶዳ፥ Ꮊንካይ አቶዳ። <verse eid="LUK 17:34"/><verse number="35" style="v" sid="LUK 17:35"/>ናምኢ ማችታይ ዎላ ጋጮዳር ፐታት ኤክንቶዳ፥ Ꮊንካት አቶዳ። <verse eid="LUK 17:35"/><verse number="36" style="v" sid="LUK 17:36"/>[ናምኢ አሳይ ዎላ ጋደ ዎትዝታይፕ ፐታይ ኤክንቶዳ፥ Ꮊንካይ አቶዳ»<note caller="+" style="f"><char style="fr" closed="false">17:36 </char><char style="ft" closed="false">ፐቲ ፐቲ ማጻፍታይድ ታይቦ 36 ባያ።</char></note> ዬጌዛ።]<verse eid="LUK 17:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 17:37"/>ኡንቲ፥ «ጎዳዮ አና ኤክንቶዴ?» ዬጊ ኦይጬዛ።</para>
  <para style="p" vid="LUK 17:37">ኤ፥ «ጋዉጻ የዝ በሳ አንኮ ሺቅዛ» ዬጌዛ።<verse eid="LUK 17:37"/></para>
  <chapter eid="LUK 17"/>
  <chapter number="18" style="c" sid="LUK 18"/>
  <para style="s1">ሚንጊ ዎሶድ ጋርክ ታማርሴዛ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 18:1"/>የሱሳ ፋ ታማርታ አዛለካ ኡባ ዎደ ዎሶድ ጋርክ ታማርሶዳይስ ኮዢ ዬጊ ኣዝሶ ኦዴዛ፦ <verse eid="LUK 18:1"/><verse number="2" style="v" sid="LUK 18:2"/>«ፐቲ ካታማ ጾስስ ያሽቶዋ አስስካ ዬላቶዋ ፐቲ ዳይናይ የዛ <verse eid="LUK 18:2"/><verse number="3" style="v" sid="LUK 18:3"/>የ ካታማ ጋንጨ ፐቲ አምአት የዛ። እዛካ፥ ‹ታስኔ ታ ሞርካይ ጋንጨ የዝ ሞታ ፕርዶባ› ዬጊ ኡባ ዎደ የ ዳይናካ ዳቡርስዛ። <verse eid="LUK 18:3"/><verse number="4" style="v" sid="LUK 18:4"/>ዳይናይ ጽቃ ዎደስ እ ኦዳ ስአም እጼዛ፥ ዝን ጉየፕ ፋ ዎዝናር ቆፕ፥ ‹ታኒ ጾስስ ያሽታም፥ አስስ ዬላታም እጽኮካ፥ <verse eid="LUK 18:4"/><verse number="5" style="v" sid="LUK 18:5"/>Ꮊ አምአት ታና ኡባ ዎደ ዋይዛ ግሾስ እዝስ ፕርዶዳ፤ ዬጊ ቆፔዛ» ዬጌዛ።<verse eid="LUK 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 18:6"/>ጎዳይካ፥ «ዉጨ ዳይናይ ጌዛና ይ ስኦይታ፤ <verse eid="LUK 18:6"/><verse number="7" style="v" sid="LUK 18:7"/>ጾሳይ ቃማኔ ጋላስ ኤዝኮ ኡክዛ ፋ ማራጼዝታይስ ፕርዶሳ? ኡንታን ማዶዳይስ ጋምእኔ? <verse eid="LUK 18:7"/><verse number="8" style="v" sid="LUK 18:8"/>ታ ይንትስ ኦድዛና ስኦይታ፥ ኤልሲ ፕርዶዳ። ማቆዝን፥ አስ ናአይ ይእዛ ዎደ ሳአል አማኖ ደማደሻ?» ዬጌዛ።<verse eid="LUK 18:8"/></para>
  <para style="s1">ፈርሳዋኔ ቃራጸ ጋችስዝ አ</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 18:9"/>ማ ማሂ፥ የሱሳ፥ ፋና ጌሻ አስ ጋርክ ኡዲ ጬቅንትዝታይስኔ Ꮊንክታ ቦርዝታይስ Ꮊይ ጋርከ ዬጊ ኣዝሶ ኦዴዛ፦ <verse eid="LUK 18:9"/><verse number="10" style="v" sid="LUK 18:10"/>«ናምኢ አስታይ ዎሶዳይስ ጾስ ካራ Ꮊንጌዛ። ፐታይ ፈርሳወ Ꮊንካይ ማ ቃራጸ ጋችስዝ አስ። <verse eid="LUK 18:10"/><verse number="11" style="v" sid="LUK 18:11"/>ፈርሳዋይ ኤቂ ፓስ ዎስታር፥ ‹ጾሳዮ ታኒ Ꮊንክታይ ጋርክ ቦንቂዛ፥ ዡጫኔ ላምዛ አስ፥ ኡባራካ ማ Ꮊ ቃራጸ ጋችስዝ አይ ጋርክ ባ ግሾስ ነና ታ ጋላትዛ። <verse eid="LUK 18:11"/><verse number="12" style="v" sid="LUK 18:12"/>ሳምንታፕ ናምኢ ቶኬ ጾምዛ፥ ታ ደንግዝባዝ ኡባይፕ አስራታ ከስዛ› ዬጌዛ።<verse eid="LUK 18:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 18:13"/>«ዝን ቃራጸ ጋችስዛይ ማ ሃኮር ኤቂ ሀራ አቶዝን ሳሎ ቅ ግ በአዳይስ ያሽቲ ፋ ትራ ቆጽታር ‹ጾሳዮ፥ ታና ናጋራንቻና ማሮየ› ዬጊ ዎሴዛ።<note caller="-" style="x"><char style="xo" closed="false">18:13 </char><char style="xt" closed="false"><ref loc="MAT 23:12">ማቶ. 23:12</ref>፤ <ref loc="LUK 14:11">ሉቃ. 14:11</ref></char></note> <verse eid="LUK 18:13"/><verse number="14" style="v" sid="LUK 18:14"/>ታ ይንትስ ኦድዛና ስኦይታ፤ ፈርሳዋይ Ꮊይ ቃራጸ ጋችስዛይ ጾስ ቲና ጌሽ ማቂ ፋ ካራ ማቄዛ። አብስ ጊኮ፥ ፋና ቅ ቅ ኡድዛ አስ ካዉዦዳ፥ ፋና ካዉሽዛ አስ ቅ ቅ ጎዳ» ዬጌዛ።<verse eid="LUK 18:14"/></para>
  <para style="s1">የሱሳራኔ ዱደ ናእታ</para>
  <para style="r">(<ref loc="MAT 19:13-30">ማቶ. 19:13-30</ref>፤ <ref loc="MRK 10:13-31">ማር. 10:13-31</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 18:15"/>የሱሳ ዱደ ናእታይል አፋ ፋ ኩሻ ጋዲ አንጆዳይ ጋርክ አሳይ ኤኮ ክእዛ። የሱሳ ታማርታይ የያ ብኢ አብስ የሱሳኮ ክእኔ ዬጊ ካጬዛ። <verse eid="LUK 18:15"/><verse number="16" style="v" sid="LUK 18:16"/>ዝን የሱሳ ናእታ ፋኮ ጼጊ፥ «ናእታይ ታኮ የኦዳና ካይፐቴ፤ የኦ ጎይታ። አብስ ጊኮ፥ ጾስ ካተትይ Ꮊይትታይ ጋርክ ሀኔዝታይስ። <verse eid="LUK 18:16"/><verse number="17" style="v" sid="LUK 18:17"/>ታ ይንትስ ቱሮ ኦድዛ፤ ጾስ ካተት ዱደ ናእታይ ጋርክ ኤኮዛይ ኦንካ ኤዛይድ ገላሚ» ዬጌዛ።<verse eid="LUK 18:17"/></para>
  <para style="s1">ዱረ አይ ኦይች</para>
  <para style="r">(<ref loc="MAT 19:16-30">ማቶ. 19:16-30</ref>፤ <ref loc="MRK 10:17-31">ማር. 10:17-31</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 18:18"/>አይሁደ ሀላቅታይፕ ፐታይ፥ «ኬሃ አስታማራዮ፥ መና ደኦ ደንጎዳይስ አብ ኦ?» ዬጊ ኦይጬዛ።<verse eid="LUK 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 18:19"/>የሱሳ ኤዝኮ፥ «አብስ ታና ኬሃዮ ዬጊ ጼጌ? ፐቲ ጾሳፕ አትን ሀራ ኬሃ ባያ። <verse eid="LUK 18:19"/><verse number="20" style="v" sid="LUK 18:20"/>ላምፐ፥ ዎፐ፥ ካስትፐ፥ ዎርዶ ማርካትፐ፥ ነ አዳኔ ነ እንዳት ቦንቾባ ዬግዝ አዛዞ ኤርኔ» ዬጊ ኦይጬዛ።<note caller="-" style="x"><char style="xo" closed="false">18:20 </char><char style="xt" closed="false"><ref loc="EXO 20:12-16">ከስ 20:12-16</ref>፤ <ref loc="DEU 5:16-20">ናምእ. 5:16-20</ref></char></note><verse eid="LUK 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 18:21"/>አይካ፥ «የይትታ ኡባ ታ ናአትፕ አይኪ ናግታር ጋምኤዛ» ዬጌዛ።<verse eid="LUK 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 18:22"/>የሱሳ የያ ስኢ «ዬዛኮ፥ ኔስ ፐትባዝ ፓጭዛ፤ ኔስ የዝ ባዝ ኡባ ባይዚ ማንቅታይስ እንጎባ፤ ሳሎ ነና ሻሎ ናግዛ። ዬዚ ማቂ ታና ካሎባ» ዬጌዛ። <verse eid="LUK 18:22"/><verse number="23" style="v" sid="LUK 18:23"/>ዝን አይ የያ ስኢ ኤዝስ ጋመ ሻሎ የዛ ግሾስ ኢታ ቂራቴዛ።<verse eid="LUK 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 18:24"/>የሱሳ አ ብኢ፥ «ዱረ አስስ ጾስ ካተት ገሎ ዋይዚ ኡንኦደሻ! <verse eid="LUK 18:24"/><verse number="25" style="v" sid="LUK 18:25"/>ዱረ ጾስ ካተት ገሎዳይፐ ግማለ ናርፐ ሉኮር ኣዛይ ሻዉክዛ» ዬጌዛ።<verse eid="LUK 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 18:26"/>የያ ስኤዝ አስታይ፥ «የያ ማቅኮ ኦ አቶዴ!» ዬጌዛ።<verse eid="LUK 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 18:27"/>የሱሳ፥ «አስስ ዳንዳእንቶዋ ባዝ ጾስስ ዳንዳእንትዛ» ዬጌዛ።<verse eid="LUK 18:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 18:28"/>ጵጽሮሳ፥ «ዬዛኮ ኑ ኑባዝ ኡባ አሺ ነና ካሌዛ» ዬጌዛ።<verse eid="LUK 18:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 18:29"/>«የሱሳ ቱማ ታ ይንትስ ኦድዛ፤ ጾስ ካተትይስ ግ ፋ ካራ ዎይ ፋ ማቻቶ ዎይ ፋ እሽታ ዎይ ፋ አዳኔ ፋ እንዳት ዎይ ፋ ናእታ አሼዛይ፤ <verse eid="LUK 18:29"/><verse number="30" style="v" sid="LUK 18:30"/>Ꮊ ዎዳይድ ጋመ ዳኮ፥ የኦድ አላማይድ መና ደኦ ኤኮዛይ ኦንካ ባያ» ዬጌዛ።<verse eid="LUK 18:30"/></para>
  <para style="s1">የሱሳ ፋ Ꮊይቆ ባጋ ማሂ ኦዴዛ</para>
  <para style="r">(<ref loc="MAT 20:17-19">ማቶ. 20:17-19</ref>፤ <ref loc="MRK 10:32-34">ማር. 10:32-34</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 18:31"/>የሱሳ ታጶ ናምእታ ፋኮ ጼጊ፥ «አን የሩሳላመ ዎላ Ꮊማዳ፥ ናብታይ አስ ናአይ ባጋ ጻፌዝባዝ ኡቢታይ ኤዛይድ ፖልንቶዳ። <verse eid="LUK 18:31"/><verse number="32" style="v" sid="LUK 18:32"/>ኤ አይሁደ ባ አሳይስ ኣ እንግንቶዳ። ኡ ኤዛ ቶቾዳ፥ ጫዦዳኔ ኤዛል አፋ ጩቶዳ። <verse eid="LUK 18:32"/><verse number="33" style="v" sid="LUK 18:33"/>ኤዛ ጋራፌዛይፕ ጉየ ዎዳ፥ ዝን ሃይን ጋላስ ኤ Ꮊይቆፕ ደንዶዳ» ዬጌዛ።<verse eid="LUK 18:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 18:34"/>ዝን ኤ ታማርታይ ያ ኡባይፕ ፐትባዝካ አካኬካያ። ኤ ጹራይ ኡንትስ ቆስንቴዝ ግሾስ ኤ ዋጌዛኮ ኤረካያ።<verse eid="LUK 18:34"/></para>
  <para style="s1">ቶአ አይ በኤዛ</para>
  <para style="r">(<ref loc="MAT 20:29-34">ማቶ. 20:29-34</ref>፤ <ref loc="MRK 10:46-52">ማር. 10:46-52</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 18:35"/>የሱሳ ኢያርኮ ኡኮዳር ፐቲ ቶአ አይ ኦገ ጋጻ በቲ ዎስዛ። <verse eid="LUK 18:35"/><verse number="36" style="v" sid="LUK 18:36"/>ቶአ አይ አስታይ የ አቃይር ኣዳር ስኢ፥ «የይ አባ?» ግ ኦይጬዛ። <verse eid="LUK 18:36"/><verse number="37" style="v" sid="LUK 18:37"/>ኡ፥ «ናዝረተ የሱሳ Ꮊይር ኣዛ» ዬጌዛ።<verse eid="LUK 18:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 18:38"/>ኤ፥ «ዳዉተ ናአዮ፥ የሱሳ፥ ታና ማሮየ» ዬጊ ኡኬዛ።<verse eid="LUK 18:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 18:39"/>ቲን ቲን Ꮊንግዝታይ፥ «ሀይዞባ» ግ ቆዴዛ። ዝን ኤ፥ «ዳዉተ ናአዮ፥ ታና ማሮየ» ዬጊ ዳርሲ ኡኬዛ።<verse eid="LUK 18:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 18:40"/>የሱሳ ኤቂ አ ፋኮ ኮኦድ ጋርክ ኪቴዛ። አይካ፥ ኤኮ ሺቅን፥ <verse eid="LUK 18:40"/><verse number="41" style="v" sid="LUK 18:41"/>«ታ ኔስ አብ ኡዶድ ጋርክ ኮዬ?» ዬጊ ኦይጬዛ።</para>
  <para style="p" vid="LUK 18:41">ቶአይ፥ «ጎዳዮ ታ በአዳይስ ኮይዛ» ዬጌዛ።<verse eid="LUK 18:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 18:42"/>የሱሳ፥ «ቦኦባ፥ ነ አማናይ ነና ፓዛ» ዬጌዛ። <verse eid="LUK 18:42"/><verse number="43" style="v" sid="LUK 18:43"/>አይ እዝር ብኢ አቴዛ። ጾሳ ቦንችታር የሱሳ ካሌዛ። አስ ኡባይ የያ ብኢ ጾሳ ጋላቴዛ።<verse eid="LUK 18:43"/></para>
  <chapter eid="LUK 18"/>
  <chapter number="19" style="c" sid="LUK 19"/>
  <para style="s1">ቃራጸ ጋችስዝ ዛኮሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 19:1"/>የሱሳ ኢያርኮ ገሊ ኣዛ። <verse eid="LUK 19:1"/><verse number="2" style="v" sid="LUK 19:2"/>ኤዛይድ ዛኮሳ ግንትንትዝ ቃራጸ ጋችስዝታይ ሀላቃይ የዛ። ኤ ጋመ ዱረ። <verse eid="LUK 19:2"/><verse number="3" style="v" sid="LUK 19:3"/>ኤ የሱሳ ኣያዛኮ በአዳይስ ኮዬዛ። ኤ ሃታ ማቄዝ ግሾስ አስ ዳሮትይፕ ደንዴዛይድ የሱሳ በአዳይስ ዳንዳኤካያ። <verse eid="LUK 19:3"/><verse number="4" style="v" sid="LUK 19:4"/>የሱሳና በአዳይስ ኮዢ ኤ Ꮊንግዛ ኦጋይስ ቲና ዎጺ Ꮊንጊ ፐቲ ጋሳረ ምል አፋ ከዜዝ።<verse eid="LUK 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 19:5"/>የሱሳ የ አቃ ሄልታር ቅ ግ ብኢ፥ «ዛኮሳ፥ Ꮊይኖ ታ ነ ካራ ፔዦዳይስ ቤዝዛ ግሾስ ኤል ዎባ» ዬጌዛ። <verse eid="LUK 19:5"/><verse number="6" style="v" sid="LUK 19:6"/>ኤ ኤልሲ ዎ ኡፋይሳር የሱሳና ሞኬዛ።<verse eid="LUK 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 19:7"/>የ አቃይድ የዝ አስ ኡባይ የያ ብኢ፥ «ናጋራንቾ ካራ ገሊ ሞክንቶዳይስ ሀንዛ» ዬጊ ዝግሬዛ። <verse eid="LUK 19:7"/><verse number="8" style="v" sid="LUK 19:8"/>ማቆዝን፥ ዛኮሳ ኤቂ ጎዳይኮ፥ «ጎዳዮ፥ ዬዛኮ ታስ የዝ ሻሎ ኡባይፕ ባጋ ማንቅታይስ እማዳ። አሳፕ አብካ ዎርዶር ባል ኤኬዝባዝ ማቅኮ ኦይዲ ኩሸ ማሆዳ» ዬጌዛ።<verse eid="LUK 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 19:9"/>የሱሳ ማ፥ «Ꮊ አይ አፍራመ ናአ ማቄዝ ግሾስ Ꮊይኖ አቶት Ꮊ ካራ የኤዛ። <verse eid="LUK 19:9"/><verse number="10" style="v" sid="LUK 19:10"/>አስ ናአይ የኤዛይ ቤዛና ኮዮዳይስኔ አሾዳይስ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">19:10 </char><char style="xt" closed="false"><ref loc="MAT 18:10">ማቶ. 18:10</ref></char></note><verse eid="LUK 19:10"/></para>
  <para style="s1">ታጲ ምናንታይ ኣዝሶ</para>
  <para style="r">(<ref loc="MAT 25:14-30">ማቶ. 25:14-30</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 19:11"/>አሳይ የያ ስእታር የዝን የሱሳ የሩሳላመ ኡኬዝ ግሾስ ጾሳ ካተትይ Ꮊት ኡኬዛ ኣዜዝ ግሾስ ኡንትስ ኣዝሶ ኦዴዛ።<note caller="-" style="x"><char style="xo" closed="false">19:11-27 </char><char style="xt" closed="false"><ref loc="MAT 25:14-30">ማቶ. 25:14-30</ref></char></note> <verse eid="LUK 19:11"/><verse number="12" style="v" sid="LUK 19:12"/>የይ ግሾስ፥ የሱሳ፥ «ፐቲ ዳማ አሲ የዛይ ፋስ ካተት ማዉተ ኤኪ የኦዳይስ ሀራ ቢታ Ꮊንጌዛ። <verse eid="LUK 19:12"/><verse number="13" style="v" sid="LUK 19:13"/>ኤዝስ ኦዝ አይልታይፕ ታጵታ ጼጊ ታጲ ምናኔ<note caller="+" style="f"><char style="fr" closed="false">19:13 </char><char style="fqa" closed="false">ምናኔ፦ </char><char style="ft" closed="false">ምናናይ ግርኬ ዶና። ፐቲ ምናናይ ፐቲ ጋላስ ኦሶ አስስ ሀይ አግና ዳሞዘ ማቅዛ።</char></note> እንጊ ‹ታ ማቂ የኦድ ጋ Ꮊ ሚሻይር ዛልኦይታ› ዬጌዛ።<verse eid="LUK 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 19:14"/>«የ ጋደ አሳይ ኤዛ እጽዛ ግሾስ Ꮊ አይ ኑል አፋ ካዉቶዳይ ጋርክ ኑ ኮዮያ ዬጊ አስ ኤ ጉየር ኪቴዛ።<verse eid="LUK 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 19:15"/>«ማቆዝን፥ የ አይ ካት ማቂ ፋ ቢታ ማቄዛ። የ ታጲ አይልታይ ኤ እንጌዝ ሚሻይር አብ ጋርክ ዛልእ ዎሴዛኮ ኤሮዳይስ ኮዢ ኡንታን ጼግሴዛ።<verse eid="LUK 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 19:16"/>«ቲናይ ይኢ፥ ‹ጎዳዮ፥ ነ ታስ እንጌዝ ሚሻይል ሀራ ታጶ ዎሴዛ› ዬጌዛ።<verse eid="LUK 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 19:17"/>«ኤ ጎዳይ፥ ‹ነኖ አማንንትዛ አይላዮ ነ ሎኦ ኦዛ። ኔኒ ጽቃ ባዛል አማንንትዛ ግሾስ ኔስ ታጲ ካታምታይል አፋ ማዉተ እንጌዛ› ዬጌዛ።<verse eid="LUK 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 19:18"/>«ናምአንይካ ይኢ፥ ‹ጎዳዮ፥ ነ ታስ እንጌዝ ሚሻይ ሀራ እችን ዎዛ› ዬጌዛ።<verse eid="LUK 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 19:19"/>«ጎዳይ ኤዝኮ፥ ‹ነስካ ማ እችን ካታምታይል አፋ ማዉተ እንጌዛ› ዬጌዛ።<verse eid="LUK 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 19:20"/>«ዬዛኮ ሃንይ ይኢ፥ ‹ጎዳዮ፥ ታ ቃንጾር ጻጺ ናጌዝ ነ ሚሽታ Ꮊናሾ። <verse eid="LUK 19:20"/><verse number="21" style="v" sid="LUK 19:21"/>አብስ ጊኮ፥ ነ ጋደካ ባዝ ኤክዛናኔ ነ ዘረካባዝ ማጽዝ ኢታ አስ ማቅዝ ግሾስ ኔስ ታ ያሽቴዛ› ዬጌዛ።<verse eid="LUK 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 19:22"/>«ኤ ጎዳይ ማሂ፥ ‹ነኖ ኢታ አይላዮ ነ ዶናቲ ጋርክ ታ ነና ፕርዶዳ። ታ ጋደካ ባዝ ኤክዛናኔ ዘረካባዝ ማጽዝ ኢታ አስ ማቄዛ ነ ኤርኮ፥ <verse eid="LUK 19:22"/><verse number="23" style="v" sid="LUK 19:23"/>ታ ይኢ ታ ሚሻ ዎር ኤኮድ ጋርክ ዛልእዛ አስስ አብስ እንገካሳ?›<verse eid="LUK 19:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 19:24"/>«ኤ ጎዳይ የ አቃይድ ኤቄዛይኮ፥ ‹ኤዛር የዝ ሚሻ ኤኪ ታጶ ዎሴዛይስ እንጎይታ› ዬጌዛ።<verse eid="LUK 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 19:25"/>«ኡንቲ፥ ‹ጎዳዮ፥ ኤዝስ ብንካ ታጲ ምናናይ የዛ› ዬጌዛ።<verse eid="LUK 19:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 19:26"/>«ጎዳይ፥ ታ ይንትስ ኦድዛ፤ ‹የዛ ኡባይስ ሀራ ጉዥንቶዳ፥ ዝን ባዛይፕ ሀራይ አቶ ኤዝስ የዛናካ ኤክንቶዳ።<note caller="-" style="x"><char style="xo" closed="false">19:26 </char><char style="xt" closed="false"><ref loc="MAT 13:12">ማቶ. 13:12</ref>፤ <ref loc="MRK 4:25">ማር. 4:25</ref>፤ <ref loc="LUK 8:18">ሉቃ. 8:18</ref></char></note> <verse eid="LUK 19:26"/><verse number="27" style="v" sid="LUK 19:27"/>ማቆዝን፥ ታ ኡንታል አፋ ካዉታማይ ጋርክ ኮዬዝታ የ ታ ሞርክታ Ꮊና ታ ቲና ክኢ ዎይታ› ጌዛ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">19:11-27 </char><char style="xt" closed="false"><ref loc="MAT 25:14-30">ማቶ. 25:14-30</ref></char></note><verse eid="LUK 19:27"/></para>
  <para style="s1">የሱሳ ዳማ ቦንቾር የሩሳላመ ገሌዛ</para>
  <para style="r">(<ref loc="MAT 21:1-11">ማቶ. 21:1-11</ref>፤ <ref loc="MRK 11:1-11">ማር. 11:1-11</ref>፤ <ref loc="JHN 12:12-19">ዋን. 12:12-19</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 19:28"/>የሱሳ የያ ኦዴዛይፕ ጉየ ኡንታፕ ቲና ኣ የታር የሩሳላመ Ꮊንጌዛ። <verse eid="LUK 19:28"/><verse number="29" style="v" sid="LUK 19:29"/>ደብሬዘይተ አምባል<note caller="+" style="f"><char style="fr" closed="false">19:29 </char><char style="fqa" closed="false">ደብሬዘይተ ጉሳይ ዛይተ ከዝዝ ዎይራ ም ኩሜዝ አቆ።</char></note> አፋ የዝ ቤተፋገኔ ብታና ኡክታር ፋ ታማርታይፕ ናምእታ ዬጊ ኪቴዛ፦ <verse eid="LUK 19:29"/><verse number="30" style="v" sid="LUK 19:30"/>«ይ ቲና የዝ ሄራ Ꮊንጎይታ፥ ይ እዘ ሄሎዳር ኦንካ ቶግበኤካ አጭንቲ የዝ ሀረ ናአ ይ ደማዳ። ኤዛ ብሊ Ꮊና ኤኪ የኦይታ። <verse eid="LUK 19:30"/><verse number="31" style="v" sid="LUK 19:31"/>ኦንካ፥ ‹አብስ ብሌ?› ግ ኦይጭኮ፥ ‹ጎዳይ ኤዛ ኮይዛ› ዬጎይታ» ዬጌዛ።<verse eid="LUK 19:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 19:32"/>ኪትንቴዝታይ Ꮊንጊ ኤ ጌዛይ ጋርክ ሀንን በኤዛ። <verse eid="LUK 19:32"/><verse number="33" style="v" sid="LUK 19:33"/>ኡንትካ ሀረ ናአ ብሎዳር ጎድታይ ብኢ፥ «ሀረ ናአ አብስ ብሌ?» ዬጌዛ።<verse eid="LUK 19:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 19:34"/>ኡንቲ ማሂ፥ «ጎዳይስ ኤ ኮሽዛ» ዬጌዛ።<verse eid="LUK 19:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 19:35"/>ኤዛይፕ ሀረ ናአ የሱሳኮ ከኤዛ። ፋ አፍላ ሀረ ናአይ ዞካይል ህጺ የሱሳና ቶግሴዛ። <verse eid="LUK 19:35"/><verse number="36" style="v" sid="LUK 19:36"/>አሳይካ ኤ Ꮊንግዛ ኦጋይል አፋ ፋ አፍላ ሂጼዛ።<verse eid="LUK 19:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 19:37"/>ደብሬዘይተ ደረል ሱለ የሩሳላመ ዎስዝ ኦገኮ ኡኮዳር ታይቦር ጋመ አሳይ ኡንቲ በኤዝ ማላታይስ ኡፋይቲ ፋ ቃላ ቅ ኡዲ፥ ጾሳ ጋላታ አይኬዛ።<verse eid="LUK 19:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="LUK 19:38"/>«ጎዳይ ሱንር ይእዛ ካታይ አንጅንቴዛያ</para>
  <para style="q2" vid="LUK 19:38">ሳሎ ሳሮ፥</para>
  <para style="q2" vid="LUK 19:38">ኡባፕ ቀ ሳሎ ቦንቾ፥</para>
  <para style="q2" vid="LUK 19:38">ጾሳይስ ማቆ»</para>
  <para style="m" vid="LUK 19:38">ዬጊ ጾሳ ጋላቴዛ።<note caller="-" style="x"><char style="xo" closed="false">19:38 </char><char style="xt" closed="false"><ref loc="PSA 118:26">ማዝ. 118:26</ref></char></note><verse eid="LUK 19:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 19:39"/>አሳይ ጋንጨፐ ፐቲ ፐቲ ፈርሳወ አሳይ የሱሳኮ፥ «አስታማራዮ፥ ነ ታማርታ ሀይዝሶባ» ዬጌዛ።<verse eid="LUK 19:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 19:40"/>ኤ ኡንትኮ፥ «ኡንቲ ስኤ ጊኮ ሹችታይ ኡኮዳ» ዬጌዛ።<verse eid="LUK 19:40"/></para>
  <para style="s1">የሱሳ የሩሳላመስ ዬኬዛ</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 19:41"/>የሱሳ የሩሳላመ ኡክታር ካታማ ብኢ እዝስ ዬኬዛ። <verse eid="LUK 19:41"/><verse number="42" style="v" sid="LUK 19:42"/>«ነ ሳራይስ ማቃዳና Ꮊይኖ ነ ኤረካያ፥ Ꮊተካ ነ ኣፋይፕ ቆስንቴዛ። <verse eid="LUK 19:42"/><verse number="43" style="v" sid="LUK 19:43"/>ነ ሞርክታይ ነ ካላ ጋሲ ፋ ኦገር ኦገር ነና ማር ኡንእዛ ዎደ የኦዳ። <verse eid="LUK 19:43"/><verse number="44" style="v" sid="LUK 19:44"/>ነናኔ ነ ጋሰ ግዶ የዝ ነ ናእታ ብሶዳ። ፐቲ ፐቲ ሹች ደን ላሎዳ፥ አብስ ጊኮ ጾሳይ ነና አሾዳይስ ይእዝ ዎዳ ነ ኤረካዛይ ግሾስ» ዬጊ እዝስ ዬኬዛ።<verse eid="LUK 19:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 19:45"/>የይፐ ጉየ፥ የሱሳ ጾሳ ኬ ገሊ ዛልእዝታ ኤዛይፕ ባይኤዛ። <verse eid="LUK 19:45"/><verse number="46" style="v" sid="LUK 19:46"/>ማ፥ «‹ታ ኬይ ጾሳ ዎስዛ ኬ ማቃዳ› ግ ጻፍንቴዛ፥ ዝን ይ ታ ኬ ፓንታይ ኮምኦ ኡዴዛ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">19:46 </char><char style="xt" closed="false"><ref loc="ISA 56:7">ኢሳ. 56:7</ref>፤ <ref loc="JER 7:11">ኤርም. 7:11</ref></char></note><verse eid="LUK 19:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 19:47"/>ጋላስ ጋላስ ጾሳ ኬ ታማርስዛ። ቄሰ ሀላቅታይ፥ ህገ አስታማርታይኔ ጋደ ጭምታይ ኤዛ ዎዳይስ ኦገ ኮይዛ።<note caller="-" style="x"><char style="xo" closed="false">19:47 </char><char style="xt" closed="false"><ref loc="LUK 21:37">ሉቃ. 21:37</ref></char></note> <verse eid="LUK 19:47"/><verse number="48" style="v" sid="LUK 19:48"/>ማቆዝን፥ አሲ ኡባይ ኤ ትምርታ ፋ ዎዝናስ ኣ ስእዝ ግሾስ ኡንትስ ኦድ ባዝ ቤዛ።<verse eid="LUK 19:48"/></para>
  <chapter eid="LUK 19"/>
  <chapter number="20" style="c" sid="LUK 20"/>
  <para style="s1">የሱሳ ማዉታይ አይሁድታይስ ኦይች ማቄዛ</para>
  <para style="r">(<ref loc="MAT 21:23-27">ማቶ. 21:23-27</ref>፤ <ref loc="MRK 11:27-33">ማር. 11:27-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 20:1"/>ፐቲ ጋላስ የሱሳ ጾሳ ኬ ጋንጨ አሳ ታማርሶዳራኔ ዎንግለ ማርካቶዳር፥ ቄሰ ሀላቅታይ፥ ህገ አስታማርታይኔ ጋደ ጭምታይ ዎላ ኤዝኮ ይኢ፥ <verse eid="LUK 20:1"/><verse number="2" style="v" sid="LUK 20:2"/>«ነ Ꮊይትታ አባ ማዉተር ኦዛኮ ኑስ ኦዶባ። Ꮊ ማዉታ ኔስ እንጌዛይ ኦኖ?» ዬጊ ኦይጬዛ።<verse eid="LUK 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 20:3"/>ኤ ኡንትኮ፥ «ታካ ይንታን ፐትባዝ ኦይጮዳ፥ አን ታስ ማሆይታ። <verse eid="LUK 20:3"/><verse number="4" style="v" sid="LUK 20:4"/>ጻማቅዛ ዋንሳ ጽንቃታይ ጾሳፐነ አሳፔ?» ዬጌዛ።<verse eid="LUK 20:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 20:5"/>ኡ ዎል ጋንጨ ዬጊ ቶቤዛ፦ «ጾሳፕ ጊኮ የዝን፥ አብስ አማነካሳ?» ዬጎዳ።<verse eid="LUK 20:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 20:6"/>«አሳፕ ጊኮ፥ አሲ ኡባይ ዋንሳ ናበ ማቅዛና አማንዛ ግሾስ ኑና ሹቻር ሾጮዳ።»<verse eid="LUK 20:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 20:7"/>የይ ግሾስ፥ «አናፐዛኮ ኑ ኤሮያ» ዬጊ ማሄዛ።<verse eid="LUK 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 20:8"/>የሱሳ ማሂ፥ «ይኬ፥ ታካ አባ ማዉተር Ꮊይትታ ኦዛኮ ይንትስ ኦዳሚ» ዬጌዛ።<verse eid="LUK 20:8"/></para>
  <para style="s1">ቢታ ዎቲ አቅዝ አሳይ ኣዝሶ</para>
  <para style="r">(<ref loc="MAT 21:33-46">ማቶ. 21:33-46</ref>፤ <ref loc="MRK 12:1-12">ማር. 12:1-12</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 20:9"/>የይፕ ጉየ፥ የሱሳ ዬጊ Ꮊ ኣዝሳ አሳይስ ኦዴዛ፦ «ፐቲ አሲ ዎይነ ቱኬዛ። ዎትዝታይስ ማታየ እንጊ ጋመ ዎደ ጋምኢ የኦዳይስ ሀራ ጋደ Ꮊንጌዛ።<note caller="-" style="x"><char style="xo" closed="false">20:9 </char><char style="xt" closed="false"><ref loc="ISA 5:1">ኢሳ. 5:1</ref></char></note> <verse eid="LUK 20:9"/><verse number="10" style="v" sid="LUK 20:10"/>ዎይነ ኣፋ ማጽዛ ዎዳይ ሄልን ዎይነ ኣፋይፕ ኤዝስ ዳኮድ ጋርክ ቢታ ዎትዝታይኮ ፋ አይላ ኪቴዛ። ዝን ዎትዝታይ የ አይላ አይኪ Ꮊ ካሎ ኩሸ ዳኬዛ። <verse eid="LUK 20:10"/><verse number="11" style="v" sid="LUK 20:11"/>ማ ማቅካ ሀራ አይላ ኪቴዛ። ማ ቢታ ዎትዝታይ ኤዛ Ꮊ፥ ቶቺ ካሎ ኩሸ ዳኬዛ። <verse eid="LUK 20:11"/><verse number="12" style="v" sid="LUK 20:12"/>Ꮊተካ ማሂ ሃይን አይላ ኪቴዛ። ዎትዝታይ ኤዛካ Ꮊ ማዱን ዎይኔ ጋንጫይፕ ጋጻ ከሲ ኦሌዛ።<verse eid="LUK 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 20:13"/>«ዎይነ ጎዳይ፥ ‹የዝን ታ አብ ኦ? አን ማ ታ ቃዛ ታ ናአ ዳኮዳ፤ ኦኒ ኤሬ ኡ ኤዛ ቦንቼካ አሻሚ› ዬጌዛ።<verse eid="LUK 20:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 20:14"/>«ዝን ቢታ ዎትዝታይ አይ ናአ ብኢ ‹Ꮊይ ኤዛ ላቶዳያ፥ Ꮊና የኦይታ ኤዛ ዎላ ዎዳ፥ ዬዝኮ ላታይ ኑስ ማቃዳ› ዬጊ ቶቤዛ። <verse eid="LUK 20:14"/><verse number="15" style="v" sid="LUK 20:15"/>ዎይነ ጋንጨፕ ጋጻ ከሲ ዎዛ። የዝን፥ ዎይነ ጎዳይ የ አስታ ዋይሳዴ? <verse eid="LUK 20:15"/><verse number="16" style="v" sid="LUK 20:16"/>ይኢ የ ቢታ ዎትዙንን ዎዳ፥ ዎይነ ጋዳና ሀራ አሳይስ እማዳ። አሳይ የያ ስኤዝ ዎደ ‹ሽንቻለ የይ ጋርክ ባዝ ሀንፔ» ዬጌዛ።<verse eid="LUK 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 20:17"/>የሱሳ ኡንታን ዳኪ ብኢ፥</para>
  <para style="q1" vid="LUK 20:17">«የዝን ‹ግምበ ኬጽዛ አሳይ ቦሬዝ ሹቻይ፥</para>
  <para style="q2" vid="LUK 20:17">ኬ ሙመር ቶኪ አይክዝ ክርክሮ ጋርክ ኡባፕ አጵዝ ሹች ማቄዛ›</para>
  <para style="m" vid="LUK 20:17">ግንትንቲ ጻፍንቴዛይስ ብርሽይ አባ?<note caller="-" style="x"><char style="xo" closed="false">20:17 </char><char style="xt" closed="false"><ref loc="PSA 118:22">ማዝ. 118:22</ref></char></note> <verse eid="LUK 20:17"/><verse number="18" style="v" sid="LUK 20:18"/>የ ሹቻይል አፋ ዎዝ ኡባይ ጋጭንቶዳ፥ ሹቻይ ኤዛል አፋ ዎዝ ኡቢታይካ ጋጭንቶዳ» ዬጌዛ።<verse eid="LUK 20:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 20:19"/>ህገ አስታማርታይኔ ቄሰ ሀላቅታይ Ꮊ ኣዝሳይ ኦድንቴዛይ ኡንታል አፋ ማቄዛና ኤሪ የ ዎደ ኤዛ አይኮዳይስ ኮዬዛ፥ ዝን ዎያይስ ያሽቴዛ።<verse eid="LUK 20:19"/></para>
  <para style="s1">ጊራ ባጋ ሺቄዝ ኦይች</para>
  <para style="r">(<ref loc="MAT 22:15-22">ማቶ. 22:15-22</ref>፤ <ref loc="MRK 12:13-17">ማር. 12:13-17</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 20:20"/>የይ ግሾስ፥ የሱሳ ጋደ አቅስዛ ኦሮመ ካታይስ ኣ እማዳይስ ኮዪ ኤ ዶናፕ ቡታ ቃላ ናግዛ። የያ ፖልሶዳይስ ጌሽ አስ ኣዚ ቆህዝ አስታ ኤዝኮ ኪቴዛ። <verse eid="LUK 20:20"/><verse number="21" style="v" sid="LUK 20:21"/>ኪትንቲ Ꮊንጌዝ አሳይ፥ «አስታማራዮ፥ ኔኒ ኦድዛይኔ ታማርስዛይ ልከ ማቄዛ፥ ማ ጾስ ኦገ ቱማትር ታማርስዛኔ ኦናካ ሻኮዛና ኑ ኤርዛ። <verse eid="LUK 20:21"/><verse number="22" style="v" sid="LUK 20:22"/>ሀኖ ዝን፥ ኦሮመ ካታይስ ጊራ ጊሮዳይስ ቤዝነኔ ቤዞሳ?» ዬጊ ኤዛ ኦይጬዛ።<verse eid="LUK 20:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 20:23"/>ዝን ኤ ኡ ዎዛና ኢታት ኤሬዝ ግሾስ <verse eid="LUK 20:23"/><verse number="24" style="v" sid="LUK 20:24"/>«አን ታና ፐቲ ሳንተ ቤዞይታ፥ ኤዛል አፋር የዝ ምስላይኔ ሱንይ ኦ ባዞ?» ዬጌዛ።</para>
  <para style="p" vid="LUK 20:24">ኡ ማሂ፥ «ቄሳሬሲ» ዬጌዛ።<verse eid="LUK 20:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 20:25"/>ኤ ማሂ፥ «ዬዛኮ፥ ቄሳሬሳ ቄሳረስ፥ ጾሲሳ ጾስስ እንጎይታ» ዬጌዛ።<verse eid="LUK 20:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 20:26"/>የይ ግሾስ፥ ኤ ማሄዝ ማልሳይፕ ዎያይ ቲና ቡታ ደንጎዳይስ ዳንዳኤካያ። ኡ ኤ ማህዝ ማልሳ ማላባዝ ግ ስኤ ጌዛ።<verse eid="LUK 20:26"/></para>
  <para style="s1">Ꮊይቆፕ ደንዶ ባጋ</para>
  <para style="r">(<ref loc="MAT 22:23-33">ማቶ. 22:23-33</ref>፤ <ref loc="MRK 12:18-27">ማር. 12:18-27</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 20:27"/>Ꮊይቆፕ ደንዶ ባያ ዬግዝ ሳዱቃውታይፐ ፐታይ ፐታይ የሱሳኮ ይኢ፥<note caller="-" style="x"><char style="xo" closed="false">20:27 </char><char style="xt" closed="false"><ref loc="ACT 23:8">ሀዋ. ኦ. 23:8</ref></char></note> <verse eid="LUK 20:27"/><verse number="28" style="v" sid="LUK 20:28"/>«አስታማራዮ፥ ፐቲ አሲ ማቾ ኤኪ ናአ የለካዛር Ꮊይቅኮ፥ ኤ እሻይ የ ማቻቶ ኤኪ ናእታ የሊ ፋ እሻይስ ኮቺ አሾዳይ ጋርክ ሙሰ ጻፌዛ።<note caller="-" style="x"><char style="xo" closed="false">20:28 </char><char style="xt" closed="false"><ref loc="DEU 25:5">ናምእ. 25:5</ref></char></note> <verse eid="LUK 20:28"/><verse number="29" style="v" sid="LUK 20:29"/>ዬዛኮ ላፑን እሽታይ የዛ። ባይራይ ማቾ ኤኪ ናአ የለካዛር Ꮊይቄዛ። <verse eid="LUK 20:29"/><verse number="30" style="v" sid="LUK 20:30"/>ኤ ካላይ እዞ ኤኪ ናአ የለካዛር Ꮊይቄዛ። <verse eid="LUK 20:30"/><verse number="31" style="v" sid="LUK 20:31"/>ሃይንይካ የይ ጋርክ ሀኔዛ። ላፑንታይ ኡባይ Ꮊይ ጋርክ ሀኒ እዞ ኤኬዛ፥ ዝን ናአ የለካዛር Ꮊይቄዛ። <verse eid="LUK 20:31"/><verse number="32" style="v" sid="LUK 20:32"/>ዉርስል አስታካ Ꮊይቄዛ። <verse eid="LUK 20:32"/><verse number="33" style="v" sid="LUK 20:33"/>ይኬ፥ ላፑን እሽታይ እዞ ኤኬዝ ግሾስ Ꮊይቆፕ ደንድዛ ዎደ እዛ ኦ ማቾ ማቃዴ?» ዬጊ ኦይጬዛ።<verse eid="LUK 20:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 20:34"/>የሱሳ ማሂ፥ «አሳይ Ꮊ አላማይል ኤክዛኔ ገልዛ። <verse eid="LUK 20:34"/><verse number="35" style="v" sid="LUK 20:35"/>ዝን Ꮊይቆፕ ደንዲ የኦድ አላማይል የዞዳይስ በዝዛ አሳይ ኤኮያኔ ገሎያ። <verse eid="LUK 20:35"/><verse number="36" style="v" sid="LUK 20:36"/>ኡንቲ ኪታንቾ ጋርክ ማቅዝ ግሾስ ቲናፕ Ꮊይቀና። Ꮊይቆፕ ደንዴዝ ግሾስ ኡንቲ ጾስ ናእታ። <verse eid="LUK 20:36"/><verse number="37" style="v" sid="LUK 20:37"/>ሙሰ ጎዳና፥ ‹አፍራመ ጎዳ፥ እሳቃ ጎዳ፥ ያይቆባ ጎዳ› ማቂ ቱሻ ዎራ ጋንጨ ጹግዝ ታማ ታርካ ጻፌዛይድ Ꮊይቄዝ አሳይ ደንድዛና ቤዝዛ።<note caller="-" style="x"><char style="xo" closed="false">20:37 </char><char style="xt" closed="false"><ref loc="EXO 3:6">ከስ 3:6</ref></char></note> <verse eid="LUK 20:37"/><verse number="38" style="v" sid="LUK 20:38"/>ኡባይ ኤዝስ ፓ የዛ ማቅዝ ግሾስ ኤ ፓ የዝታይ ጎዳይፕ አትን Ꮊይቄዝታይ ጎዳ ባያ» ዬጊ ማሄዛ።<verse eid="LUK 20:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 20:39"/>ህገ አስታማርታይፕ ፐታይ ፐታይ፥ «አስታማራዮ፥ ሎኦ ባዝ ነ ኦዴዛ» ዬጌዛ። <verse eid="LUK 20:39"/><verse number="40" style="v" sid="LUK 20:40"/>የይፐ ጉየ፥ ሀራ ኦይች ኦይጮዳይስ ያሽቴዛ።<verse eid="LUK 20:40"/></para>
  <para style="s1">ክርስቶሳ ኦ ናአ</para>
  <para style="r">(<ref loc="MAT 22:41-46">ማቶ. 22:41-46</ref>፤ <ref loc="MRK 12:35-37">ማር. 12:35-37</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 20:41"/>ኤዛይፕ ማቂ የሱሳ ኡንትኮ፥ «አሳይ ክርስቶሳ ዋይዚ ዳዉተ ናአ ዬጌ? <verse eid="LUK 20:41"/><verse number="42-43" style="v" sid="LUK 20:42-43"/>አብስ ጊኮ፥ ዳዉተ ፋ ኡባስ ፋ ማዝሙረ ማጻፋይድ፥</para>
  <para style="q1" vid="LUK 20:42-43">«ጾሳይ ታ ጎዳይኮ ‹ታ ነ ሞርክታ፤</para>
  <para style="q2" vid="LUK 20:42-43">ነ ቶካይ የዝ በሰ ኦድ ጋ፥</para>
  <para style="q2" vid="LUK 20:42-43">ታፕ ኡሻች ባጋር በቶባ› ጌዛ»</para>
  <para style="m" vid="LUK 20:42-43">ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">20:42-43 </char><char style="xt" closed="false"><ref loc="PSA 110:1">ማዝ. 110:1</ref></char></note><verse eid="LUK 20:42-43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 20:44"/>«ይኬ፥ ዳዉተ ክርስቶሳ፥ ‹ጎዳ ግ ጼግታር ኤዝስ ናአ ዋይዚ ማቄ?› » ዬጌዛ።<verse eid="LUK 20:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 20:45"/>ዎያ ኡቢታይ ስኦዳር ፋ ታማርታይኮ፥ <verse eid="LUK 20:45"/><verse number="46" style="v" sid="LUK 20:46"/>«አዱስ አፍላ ማኢ ዩሸ ዶስዝታይፕ፥ ጋበ ጋንጨ ቦንቾ ሳሮ፥ አይሁድታይ ዎሳ ኬ ቦንቾ ኦይደ፥ ሞክንትዛ ካራካ ቦንቾ አቆ ኮይዝ ህገ አስታማርታይፕ ናግንቶይታ። <verse eid="LUK 20:46"/><verse number="47" style="v" sid="LUK 20:47"/>ኡንትካ አምእታይ ካራ ካሎስዛ፥ ጌሽ አስ ኣዚ አስ ቤዞዳይስ ዎሳ አዱስዛ። ኡ ኢታ ፕርደ ኤኮዳ» ዬጌዛ።<verse eid="LUK 20:47"/></para>
  <chapter eid="LUK 20"/>
  <chapter number="21" style="c" sid="LUK 21"/>
  <para style="s1">አምአት ሙጻታ</para>
  <para style="r">(<ref loc="MRK 12:41-44">ማር. 12:41-44</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 21:1"/>ዱረ አሳይ ጾስ ኬ ሙጻታ ሳጽነ ኦሎዳር የሱሳ ቅ ግ አሳ በኤዛ። <verse eid="LUK 21:1"/><verse number="2" style="v" sid="LUK 21:2"/>ማ ፐቲ ማንቆ አምአት ናምኢ ስክና ኦሎዳር ብኢ፥ <verse eid="LUK 21:2"/><verse number="3" style="v" sid="LUK 21:3"/>«ታ ይንትስ ቱሮ ኦድዛ፤ Ꮊ ማንቆ አምአት ኡባፕ ኣ እንጌዛ። <verse eid="LUK 21:3"/><verse number="4" style="v" sid="LUK 21:4"/>አብስ ጊኮ፥ Ꮊ አሳይ ኡቢታይ ፋስ የዛ ባዛፕ እንጌዛ፥ ዝን እዛ ፋ ፓጫትፕ፥ ፓስ የዝ አቆ ፐሽ ኡባ እንጌዛ» ዬጌዛ።<verse eid="LUK 21:4"/></para>
  <para style="s1">ዉርስ ላይ ማልታ</para>
  <para style="r">(<ref loc="MAT 24:3-14">ማቶ. 24:3-14</ref>፤ <ref loc="MRK 13:3-23">ማር. 13:3-23</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 21:5"/>የሱሳ ታማርታይፕ ፐታይ ፐታይ ጾስ ኬይ ጋመ ሎእዛ ሹቻራኔ አሳይ ጾስስ እንጌዝ እሞታር ሎኤዛና ኦድንትዛ። <verse eid="LUK 21:5"/><verse number="6" style="v" sid="LUK 21:6"/>ዝን የሱሳ፥ «Ꮊ ይ ብእዛ ባዛይ ኡቢታይ ላልንተካዛር፥ ሹች ሹቻል አፋ ግምቢንቴዛይ ጋርክ አታም ዎደ የኦዳ» ዬጌዛ።<verse eid="LUK 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 21:7"/>ኡንትካ፥ «አስታማራዮ፥ Ꮊ ኡቢታይ ሀኖዳይ አይደ? ማ Ꮊይ ሀኖዳይስ ማላይ አባ?» ዬጊ ኦይጬዛ።<verse eid="LUK 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 21:8"/>የሱሳ ዬጊ ኡንትስ ማልሰ እንጌዛ፦ «ባልንታማይ ጋርክ ናግንቶይታ። ጋምታይ፥ ‹ታኒ ክርስቶሳ፥ ዎዳይ ኡኬዛ› ዬግታር ታ ሱንይር የኦዳ፥ ዝን ይ ኡንታን ካልፓተ። <verse eid="LUK 21:8"/><verse number="9" style="v" sid="LUK 21:9"/>ይ ኦላ ባጋኔ ጫቦ ስኤዝ ዎደ ዳጋምፓተ። የይ ቲናቲ ሀኖዳይ አቶዋ ባዝ ማቅዝ ግሾስ ዎደ ዉርስይ ኤልሲ የኦያ» ዬጌዛ።<verse eid="LUK 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 21:10"/>ማካ፥ «ዎያይ ዎያል አፋ፥ ካተትይ ካተትል አፋ ደንዶዳ። <verse eid="LUK 21:10"/><verse number="11" style="v" sid="LUK 21:11"/>ግታ ቢታ ኤንኦ ሀኖዳ፥ ናየኔ ጋዶ ዱማ ዱማ በሳ ዳሮዳ፥ ያሽዝባዝኔ ጋመ ማላትታይ ሳሎፕ በንቶዳ። <verse eid="LUK 21:11"/><verse number="12" style="v" sid="LUK 21:12"/>ዝን Ꮊ ኡባይ ሀኖዳይፕ ቲና ታ ሱንይ ግሾስ ግ አሳይ ይንታን ባይኦዳኔ አይኮዳ። አይሁድታይ ዎሳ ኬ ጋንጨኔ አች ኬ ይንታን ዳኮዳ። ካትታይ ቲናኔ ጋደ አቅስዝታይ ቲና ይንታን ካማዳ። <verse eid="LUK 21:12"/><verse number="13" style="v" sid="LUK 21:13"/>የይካ ታ ባጋ ይ ኡንትስ ማርካቶዳይስ ሎኦ ኦገ ማቃዳ። <verse eid="LUK 21:13"/><verse number="14" style="v" sid="LUK 21:14"/>የይ ግሾስ፥ ይ ኦይጭንትዝ ዎደ ዋጊ ማልሰ እማደ ግ ይ ዎዝናር ኡንእንታም ጋርክ አካኮይታ።<note caller="-" style="x"><char style="xo" closed="false">21:14-15 </char><char style="xt" closed="false"><ref loc="LUK 12:11-12">ሉቃ. 12:11-12</ref></char></note> <verse eid="LUK 21:14"/><verse number="15" style="v" sid="LUK 21:15"/>አብስ ጊኮ፥ ይ ሞርክታይ ይንታር ኤቅንቶዳይስኔ ፓላሞዳይስ ዳንዳኦዋ ዶናኔ ኤጨት ታ ይንትስ እማዳ። <verse eid="LUK 21:15"/><verse number="16" style="v" sid="LUK 21:16"/>ሀራ አቶዝን፥ ይንታን የሌዝታይ፥ ይ እሽታይ፥ ይ ዳብታይኔ ላግታይ ይንታን ኣ እማዳ። ይ ጋንጨፕ ፐታ ፐታ ዎዳ። <verse eid="LUK 21:16"/><verse number="17" style="v" sid="LUK 21:17"/>ታ ሱንይ ግሾስ አሲ ኡቢታይ ቲና ይ እጽንቴዝታ ማቃዳ። <verse eid="LUK 21:17"/><verse number="18" style="v" sid="LUK 21:18"/>ዝን ሀራ አቶዝን፥ ይ ጭምባይፐ ፐቲ ብናናካ በና። <verse eid="LUK 21:18"/><verse number="19" style="v" sid="LUK 21:19"/>ይ፥ ዳንዳአር፥ ይ ሸምፖ አሾዳ።»<verse eid="LUK 21:19"/></para>
  <para style="s1">የሩሳላመ ቦ ባጋ</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 21:20"/>«የሩሳላመ ካታማይ ዎታዳርታይር ማርንቲ በቴዝን ይ ብእኮ እዝስ ቦ ኡኬዛና ኤሮይታ። <verse eid="LUK 21:20"/><verse number="21" style="v" sid="LUK 21:21"/>የ ዎደ ይሁዳ ግዶ የዝ ኡቢታይ አምባ ጉየ ቆስንቶ፥ ካታማ የዝታይ የይፕ ከዞ፥ ጋጻረ የዝታይ ካታማ ገልፐ። <verse eid="LUK 21:21"/><verse number="22" style="v" sid="LUK 21:22"/>አብስ ጊኮ፥ Ꮊ ጻፍንቴዝባዝ ፖልንቶድ ጋርክ የይ ጾሳይ ኩሸ ከስስ ዎደ።<note caller="-" style="x"><char style="xo" closed="false">21:22 </char><char style="xt" closed="false"><ref loc="HOS 9:7">ሆሳ. 9:7</ref></char></note> <verse eid="LUK 21:22"/><verse number="23" style="v" sid="LUK 21:23"/>ሳአል አፋ ዳማ መቶ የኦዳ፥ የ ሳአይዳካ አሳል አፋ ጾስ ካቺ የኦዳ። የይ ግሾስ፥ ዎደጸዝታኔ ንዝታ አየ። <verse eid="LUK 21:23"/><verse number="24" style="v" sid="LUK 21:24"/>ኡ ማሻር Ꮊይቃዳ፥ አሲ ኡቢታይ አላጋ ቢታ ድእንቶዳ። አይሁደ ማቀካ አስታ ዎዳይ ፖልንቶድ ጋ የሩሳላመ ኡንታር የንቴዛ ማቃዳ።<verse eid="LUK 21:24"/></para>
  <para style="s1">አስ ናአይ ይእ</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 21:25"/>«አዋ፥ አግናራኔ፥ ጾልንትታይል አፋ ማላትታይ ሀኒ በንቶዳ። አባፐኔ ዙሎ ሾቻይፕ ደንዴዛይድ ቢታል የዝ አሳይ ያሽቲ ኡንእንቶዳ።<note caller="-" style="x"><char style="xo" closed="false">21:25 </char><char style="xt" closed="false"><ref loc="ISA 13:10">ኢሳ. 13:10</ref>፤ <ref loc="EZK 32:7">ኢዝቀ. 32:7</ref>፤ <ref loc="JER 2:31">ኤርም. 2:31</ref>፤ <ref loc="REV 6:12">ዋን. ቆን. 6:12</ref></char></note> <verse eid="LUK 21:25"/><verse number="26" style="v" sid="LUK 21:26"/>ሳሎ ዎልቅታይካ ቡቅንቶዳይ ግሾስ አሳይ ያሻራኔ ቢታል አፋ አብ ሀነነሻ ግ ናጎር ፋና ዶጎዳ። <verse eid="LUK 21:26"/><verse number="27" style="v" sid="LUK 21:27"/>የ ዎደ አስ ናአይ ዎልቃራኔ ጋመ ቦንቾ ሻራር የኦዳር ኡ በአዳ።<note caller="-" style="x"><char style="xo" closed="false">21:27 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳነ. 7:13</ref>፤ <ref loc="REV 1:7">ዋን. ቆን. 1:7</ref></char></note> <verse eid="LUK 21:27"/><verse number="28" style="v" sid="LUK 21:28"/>ይ አቶትይ ኡኬዝ ግሾስ Ꮊ ሀንታይ ፖልንቶ አይክዝ ዎደ ጊግንቲ ኤቆይታ፥ ቅ ግ ቦኦይታ» ዬጌዛ።<verse eid="LUK 21:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 21:29"/>ማ ማቅካ፥ Ꮊይ ጋርክ ግ ኣዝሶ ኦዴዛ፦ «ባላሰ ምኔ ሀራ ም ኡባ ቦኦይታ። <verse eid="LUK 21:29"/><verse number="30" style="v" sid="LUK 21:30"/>ኡ ሀያይ ፉርጮዳር ቦነ ኡኬዛ ይ ኤርዛ። <verse eid="LUK 21:30"/><verse number="31" style="v" sid="LUK 21:31"/>የይ ጋርክ Ꮊ ሀንታይ ፖልንቶዳር ይ ብእኮ ጾስ ካተትይ ኡኬዛና ኤሮይታ።<verse eid="LUK 21:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 21:32"/>«ታ ይንትስ ቱሮ ኦድዛ፤ Ꮊ ኡባይ ፖልንቶድ ጋ Ꮊ የለትታይ ኣሚ። <verse eid="LUK 21:32"/><verse number="33" style="v" sid="LUK 21:33"/>ሳሎኔ ሳአ ኣዳ፥ ዝን ታ ቃላይ ኣሚ።<verse eid="LUK 21:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 21:34"/>«ይኬ፥ ይ ኡሺ ዳሮራኔ፥ ማር የስስ ኡንእንቲ ይ ዎዝናይ አይክንታም ጋርከኔ የ ቃማይ አካኬካዝን ጽኬ ጋርክ ይንታል አፋ ሄላማይ ጋርክ ናግንቶይታ። <verse eid="LUK 21:34"/><verse number="35" style="v" sid="LUK 21:35"/>የ ቃማይ ቢታል የዝ ኡባይል አፋ ሄሊ ጽክሲ አይኮዳ። <verse eid="LUK 21:35"/><verse number="36" style="v" sid="LUK 21:36"/>የይ ግሾስ፥ ይእዛ ኢታይፕ አቶዳይስኔ አስ ናአይ ቲና ኤቆዳይስ ዳንዳኦድ ጋርክ ኡባ ዎደ ሚንጊ ዎሶይታ» ዬጌዛ።<verse eid="LUK 21:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 21:37"/>ጋላስ ጋላስ የሱሳ ጾስ ኬ ታማርስታር፥ ቃማ ቃማ ደብሬዘይተ አምባል አፋ ከዚ አቅዛ።<note caller="-" style="x"><char style="xo" closed="false">21:37 </char><char style="xt" closed="false"><ref loc="LUK 19:47">ሉቃ. 19:47</ref></char></note> <verse eid="LUK 21:37"/><verse number="38" style="v" sid="LUK 21:38"/>አሳይ ኡቢታይ ኤዛ ስኦዳይስ ዎንት ጉራ ኤዝኮ ጾሳ ኬ ይእዛ።<verse eid="LUK 21:38"/></para>
  <chapter eid="LUK 21"/>
  <chapter number="22" style="c" sid="LUK 22"/>
  <para style="s1">ይሁዳ የሱሳና ኣ እማዳይስ ማቅንቴዛ</para>
  <para style="r">(<ref loc="MAT 26:1-5">ማቶ. 26:1-5</ref>፥ <ref loc="MAT 26:14">14</ref>፥ <ref loc="MAT 26:16">16</ref>፤ <ref loc="MRK 14:1-2">ማር. 14:1-2</ref>፥ <ref loc="MRK 14:10-11">10-11</ref>፤ <ref loc="JHN 11:45-53">ዋን. 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 22:1"/>የ ዎደ ፋዝቃ ዬግንትዝ ቦራ ባለ ኡኬዛ።<note caller="-" style="x"><char style="xo" closed="false">22:1 </char><char style="xt" closed="false"><ref loc="EXO 12:1">ከስ 12:1</ref></char></note> <verse eid="LUK 22:1"/><verse number="2" style="v" sid="LUK 22:2"/>ቄሰ ሀላቅታይኔ ህገ አስታማርታይ አሳይስ ያሽቴዝ ግሾስ ዋይዚ የሱሳ ፋ ጋንጨፕ ብሶዳዛኮ ኦገ ኮይዛ። <verse eid="LUK 22:2"/><verse number="3" style="v" sid="LUK 22:3"/>ጻላሄ ታጶ ናምእታይፕ ፐታ ማቄዝ አስቆሮንቶ ይሁዳ ግንትንትዛይ ጋንጨ ገሌዛ። <verse eid="LUK 22:3"/><verse number="4" style="v" sid="LUK 22:4"/>ይሁዳ ቄሰ ሀላቅታይኮራ ጾሳ ካራ ናግዝታይስ ሀላቅታይኮ Ꮊንጊ የሱሳ ዋይዚ ኣ እንጎዳዛኮ ኡንታር ማቅንቴዛ። <verse eid="LUK 22:4"/><verse number="5" style="v" sid="LUK 22:5"/>ኡንትካ የይድ ኡፋይቲ ሚሸ እንጎዳይስ ኤዛር ቶቤዛ። <verse eid="LUK 22:5"/><verse number="6" style="v" sid="LUK 22:6"/>ኤዝካ የ ዞራይድ ጊጌዛ። ኡንትስ አሲ ኤረካዝን ኣ እማዳይስ ጊጋ ዎደ ናግታር የዛ።<verse eid="LUK 22:6"/></para>
  <para style="s1">ዉርስ ካሆ</para>
  <para style="r">(<ref loc="MAT 26:17-25">ማቶ. 26:17-25</ref>፤ <ref loc="MRK 14:12-21">ማር. 14:12-21</ref>፤ <ref loc="JHN 13:21-30">ዋን. 13:21-30</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 22:7"/>የይፐ ጉየ፥ ፋዝቃ ዱር ሹክንትዛ ቦራ ባለ ሄሌዛ። <verse eid="LUK 22:7"/><verse number="8" style="v" sid="LUK 22:8"/>የሱሳ፥ «ፋዝቃ ካሆ ማዳይ ጋርክ Ꮊንጊ ኑስ ጊግሶይታ» ዬጊ ጵጽሮሳኔ ዋንሳ ኪቴዛ። <verse eid="LUK 22:8"/><verse number="9" style="v" sid="LUK 22:9"/>ኡ፥ «ኑ አባ ጊግሶድ ጋርክ ነ ኮዬ» ዬጊ ኦይጬዛ። <verse eid="LUK 22:9"/><verse number="10" style="v" sid="LUK 22:10"/>ኤ ኡንትኮ፥ «ዬዛኮ ይ ካታማ ገሎዳር ሃ ኦታ ቶኬዝ አይ ይንታን ሄሎዳ። ኤ Ꮊንጊ ገልዛ ካራ ኤዛ ካል ገሎይታ። <verse eid="LUK 22:10"/><verse number="11" style="v" sid="LUK 22:11"/>የ ካራ አዳይኮ አስታማራይ፥ ‹ታ ታ ታማርታይራ ዎላ ፋዝቃ ካሆ ማዳይስ እማ ሸምፕዛ ካራ አባ የኔ? ዬጌዛ› ጎይታ። <verse eid="LUK 22:11"/><verse number="12" style="v" sid="LUK 22:12"/>ኤ ፖቄል አፋ ሂጽንቲ ጊጊ የዝ ዳልገ ክፍለ ይንታን ቤዞዳ፥ ኤዛይድ ማኮይታ» ዬጌዛ። <verse eid="LUK 22:12"/><verse number="13" style="v" sid="LUK 22:13"/>ኡ Ꮊንጊ የሱሳ ጌዛይ ጋርክ ሀንን ደንጌዛ። ፋዝቃ ባለ ካሆ ኤዛይድ ጊግሴዛ።<verse eid="LUK 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 22:14"/>ሳታይካ ሄሌዝ ዎደ የሱሳ ሀዋርታይር ዎላ ካሆል አፋ በቴዛ። <verse eid="LUK 22:14"/><verse number="15" style="v" sid="LUK 22:15"/>ኤ ኡንትኮ፥ «ታ ዋየ ኤኮዳይፕ ቲና Ꮊ ካሃ ይንታር ማዳይስ ሎእ አሞቴዛ። <verse eid="LUK 22:15"/><verse number="16" style="v" sid="LUK 22:16"/>ይኬ፥ ስኦይታ! ጾስ ካተት Ꮊይስ ብርሽይ ፖልንቶድ ጋ Ꮊይኖፕ ጉየ Ꮊ ካሃ ማሂ ማሚ» ዬጌዛ። <verse eid="LUK 22:16"/><verse number="17" style="v" sid="LUK 22:17"/>ኡሻ ኤኪ ጋላቲ ማቂ፥ «Ꮊሽተ Ꮊያ ይ ጋንጨ ሻግንቶይታ። <verse eid="LUK 22:17"/><verse number="18" style="v" sid="LUK 22:18"/>ስኦይታ! ጾስ ካተትይ የኦድ ጋ Ꮊይኖፕ አይኪ Ꮊ ዎይነ ኡሻይፕ ማቂ ታ ኡዣሚ» ዬጌዛ።<verse eid="LUK 22:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 22:19"/>ቦራ ደን ኤኪ፥ ጋላቲ ማቂ፥ «Ꮊይ ይንትስ እንግንትዛ ታ አሾ። Ꮊያ ኦታር ታና ቆፖይታ» ዬጊ ኡንትስ ባጺ እንጌዛ። <verse eid="LUK 22:19"/><verse number="20" style="v" sid="LUK 22:20"/>የይ ጋርከካ፥ ካሆፕ ጉየ ኡሻ ኤኪ፥ «Ꮊ ኡሻይ ይንትስ ላልንቴዝ ታ ሱ ማቅዝ ኦሮ ጫቆ።<note caller="-" style="x"><char style="xo" closed="false">22:20 </char><char style="xt" closed="false"><ref loc="JER 31:31">ኤርም. 31:31</ref></char></note> <verse eid="LUK 22:20"/><verse number="21" style="v" sid="LUK 22:21"/>ማቆዝን፥ ታና ኣ እንጎድ አይ ኩሻይ ታር ዎላ ፕልኦ ጋንጨ የዛ።<note caller="-" style="x"><char style="xo" closed="false">22:21 </char><char style="xt" closed="false"><ref loc="PSA 41:9">ማዝ. 41:9</ref></char></note> <verse eid="LUK 22:21"/><verse number="22" style="v" sid="LUK 22:22"/>አስ ናአይ ኤዝስ ጊንትንቴዛይ ጋርክ Ꮊይቆዳይስ የዛ፥ ዝን ኤዛ ኣ እንግዝ አያ አየ» ዬጌዛ። <verse eid="LUK 22:22"/><verse number="23" style="v" sid="LUK 22:23"/>ኡ ፋ ጋንጨ፥ «Ꮊያ ኦኒ ኦዴ» ግ ዎል ኦይጭቼዛ።<verse eid="LUK 22:23"/></para>
  <para style="s1">ኡባይፕ ኣ ማቃዳይ ኦኖ</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 22:24"/>ማ ኡ ጋንጨ ኣ ማቃዳይ ኦኖ ግዝ ፓላማ መንቴዛ።<note caller="-" style="x"><char style="xo" closed="false">22:24 </char><char style="xt" closed="false"><ref loc="MAT 18:1">ማቶ. 18:1</ref>፤ <ref loc="MRK 9:34">ማር. 9:34</ref>፤ <ref loc="LUK 9:46">ሉቃ. 9:46</ref></char></note> <verse eid="LUK 22:24"/><verse number="25" style="v" sid="LUK 22:25"/>የሱሳ ኡንትኮ፥ «ጋደ ካትታይ ፋ አስታ ዎልቃር ሞድዛ፤ ፋ ጋደል አፋ ጎዳትዝታይካ ፋና፥ ‹ሎኦ ኦዝታ› ዬግንትዛ።<note caller="-" style="x"><char style="xo" closed="false">22:25-26 </char><char style="xt" closed="false"><ref loc="MAT 20:25-27">ማቶ. 20:25-27</ref>፤ <ref loc="MRK 10:42-44">ማር. 10:42-44</ref></char></note> <verse eid="LUK 22:25"/><verse number="26" style="v" sid="LUK 22:26"/>ዝን ይ ጋንጨ የይ ጋርክ ማቅፐ። ይ ጋንጨ ባይራትዛይ ካሎ ጋርክ ሀኖ፤<note caller="-" style="x"><char style="xo" closed="false">22:26 </char><char style="xt" closed="false"><ref loc="MAT 23:11">ማቶ. 23:11</ref>፤ <ref loc="MRK 9:35">ማር. 9:35</ref></char></note> ካልዛይ ካልዛይ ጋርክ ሀኖ። <verse eid="LUK 22:26"/><verse number="27" style="v" sid="LUK 22:27"/>ሀኖ ዝን፥ ሞክዛይፐኔ ሞክንትዛይፕ ኣይ ኣ? ሞክንትዛ ባሳ? ዝን ታኒ ይ ጋንጨ ሞክዛይጋርኬ።<note caller="-" style="x"><char style="xo" closed="false">22:27 </char><char style="xt" closed="false"><ref loc="REV 13:12">ዋን. ቆን. 13:12</ref></char></note> <verse eid="LUK 22:27"/><verse number="28" style="v" sid="LUK 22:28"/>ይንትካ ታ መታይር ታፕ ሻክንቶዋ ታር ሚንጊ ኤቄዝታ። <verse eid="LUK 22:28"/><verse number="29-30" style="v" sid="LUK 22:29-30"/>ይ ታ ሌማተፕ ማድ ጋርክ፥ ኡዦድ ጋርከኔ ዙፋንታይል አፋ በቲ ታጶ ናምኢ እስሬለ ሼሽታይል አፋ ፕርዶድ ጋርክ ታ አዳይ ታና ሹሜዛይ ጋርክ ታካ ይንታን ታ ካተትትይል ሹሞዳ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">22:29-30 </char><char style="xt" closed="false"><ref loc="MAT 19:28">ማቶ. 19:28</ref></char></note><verse eid="LUK 22:29-30"/></para>
  <para style="s1">ፕጽሮሳ ካዴዛ</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 22:31"/>ማቅካ የሱሳ፥ «ስሞና፥ ስሞና፥ ጻላሄ ይንታን ግስተ ጋርከ ሀርቆዳይስ ዎሴዛ። <verse eid="LUK 22:31"/><verse number="32" style="v" sid="LUK 22:32"/>ዝን ታኒ ነ አማናይ ባም ጋርክ ኔስ ዎሴዛ። ኔካ ማቄዝ ዎደ ነ እሽታ ምንባ» ዬጌዛ።<verse eid="LUK 22:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 22:33"/>ስሞና፥ «ጎዳዮ፥ ታኒ ኔር አጭንቶዳይስኔ Ꮊይቆዳይስ ጊግንቴዛ» ዬጌዛ።<verse eid="LUK 22:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 22:34"/>የሱሳ ጵጽሮሳኮ፥ «ታ ኔስ ኦድዛ፤ Ꮊይኖ ሹጉላ ኡኮዳይፕ ቲና ነ ታና ሀይ ቶኬ ካዶዳ» ዬጌዛ። <verse eid="LUK 22:34"/><verse number="35" style="v" sid="LUK 22:35"/>ማ ማቅካ፥ የሱሳ ኡንትኮ፥ «ታኒ ይንታን ኮሮጆ፥ ቁርቦኔ ጫማ ባዝን ኪቴዝ ዎደ ይንትስ ፓጬዝ ባዝ የኔ?» ዬጊ ኦይጬዛ።<note caller="-" style="x"><char style="xo" closed="false">22:35 </char><char style="xt" closed="false"><ref loc="MAT 10:9-10">ማቶ. 10:9-10</ref>፤ <ref loc="MRK 6:8-9">ማር. 6:8-9</ref>፤ <ref loc="LUK 9:3">ሉቃ. 9:3</ref></char></note></para>
  <para style="p" vid="LUK 22:35">ኡ ማሂ፥ «አኮካ ፓጨካያ» ዬጌዛ።<verse eid="LUK 22:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 22:36"/>ኤ ኡንትኮ፥ «Ꮊት ኮሮጆኔ ቁርቦ የዛይ አይኮ፤ ማሻ ባዛይ ፋ አፍላ ባይዚ ማሻ ዎንጎ። <verse eid="LUK 22:36"/><verse number="37" style="v" sid="LUK 22:37"/>Ꮊና ስኦይታ! ‹ዡጭታይር ታይብንቴዛ› ግንትንቲ ጻፍንቴዛይ ታል ፖልንቶዳይስ ቤዝዛ። ኤ፥ ታ ግሾስ ጻፍንቴዝባዝ ፖልንትዛይ ቱማተዛ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">22:37 </char><char style="xt" closed="false"><ref loc="ISA 53:12">ኢሳ. 53:12</ref></char></note><verse eid="LUK 22:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 22:38"/>ኤ ታማርታይ፥ «ጎዳዮ Ꮊይዳ ናምኢ ማሻ የዛ» ዬጌዛ።</para>
  <para style="p" vid="LUK 22:38">ኤ፥ «ግዶዳ» ዬጌዛ።<verse eid="LUK 22:38"/></para>
  <para style="s1">የሱሳ ደብሬዘይተ አምባል አፋ ዎሴዛ</para>
  <para style="r">(<ref loc="MAT 26:36-46">ማቶ. 26:36-46</ref>፤ <ref loc="MRK 14:32-42">ማር. 14:32-42</ref>)</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 22:39"/>የሱሳ ካሴሳይ ጋርክ ደንዲ ደብሬዘይተ አምባል አፋ ከዜዝ። ኤ ታማርታይ ኤዛ ካሌዛ። <verse eid="LUK 22:39"/><verse number="40" style="v" sid="LUK 22:40"/>የ አቃ ሄሌዝ ዎደ ይ «ፓጨ ጋንጨ ገላማይ ጋርክ ዎሶይታ» ዬጌዛ። <verse eid="LUK 22:40"/><verse number="41" style="v" sid="LUK 22:41"/>ኡንታፕ ሹች ግን ሄልዛ አቆ ጋርክ ሃኪ ቡንቂቲ ዎሴዛ። <verse eid="LUK 22:41"/><verse number="42" style="v" sid="LUK 22:42"/>«ታ አዳዮ፥ ነ ሸነ ማቅኮ Ꮊ መቶ ጹአ ታፕ ኣባ። ዝን ታ ሸነ ማቅፐ ነ ሸናይ ሀኖ» ዬጊ ዎሴዛ። <verse eid="LUK 22:42"/><verse number="43" style="v" sid="LUK 22:43"/>ምንዛ። ኪታንቻይ ሳሎፕ በንቴዛ። <verse eid="LUK 22:43"/><verse number="44" style="v" sid="LUK 22:44"/>ጋመ ኡንእንቲ ሚን ዎስዛ። ኤ ጫዋይካ ሱ ጾክዛይ ጋርክ ሳአ ጾኬዛ።<verse eid="LUK 22:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 22:45"/>የሱሳ ዎሳ ዉርሲ ፋ ታማርታይኮ የኤዛ። ኡ፥ አዛኖፐ ደንዴዛይድ ዳቡሪ ገንቴዝን ደንጊ፥ <verse eid="LUK 22:45"/><verse number="46" style="v" sid="LUK 22:46"/>«አብስ ገንቴ? ይ ፓጨ ጋንጨ ገላም ጋርክ ደንዲ ዎሶይታ» ዬጌዛ።<verse eid="LUK 22:46"/></para>
  <para style="s1">የሱሳ አይክንቴዛ</para>
  <para style="r">(<ref loc="MAT 26:47-56">ማቶ. 26:47-56</ref>፤ <ref loc="MRK 14:43-50">ማር. 14:43-50</ref>፤ <ref loc="JHN 18:3-11">ዋን. 18:3-11</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 22:47"/>ኤ ሀጋ ኦዳል አፋ የዝን ጋመ አሳይ የኤዛ። ታጶ ናምእታይፕ ፐታይ ይሁዳ ግንትንትዛይ ኡንታን ካልዛ። ኤ የሱሳ ዬሮዳይስ ላንቀ ሺቄዛ። <verse eid="LUK 22:47"/><verse number="48" style="v" sid="LUK 22:48"/>ዝን የሱሳ፥ «ይሁዳ፥ አስ ናአ ዬሪ ኣ እማደ?» ዬጌዛ።<verse eid="LUK 22:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 22:49"/>የሱሳ ታማርታይ የ ሀና ብኢ፥ «ጎዳዮ ኑ ማሻር ጋቾ?» ዬጌዛ። <verse eid="LUK 22:49"/><verse number="50" style="v" sid="LUK 22:50"/>ኡ ጋንጨፕ ፐታይ ቄሰ ሀላቃይ አይላይስ ሾጪ ኡሻች ሀይቶ ጋቺ ኦሌዛ።<verse eid="LUK 22:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 22:51"/>ዝን የሱሳ፥ «አሾባ!»<note caller="+" style="f"><char style="fr" closed="false">22:51 </char><char style="fqa" closed="false">አሾባ! ክኦይፓተ፦ </char><char style="ft" closed="false">የሱሳ Ꮊ በሳይድ አሾባ ዬጌዛይ ኤዛ አሾዳይስ ግ አይ ሀያ ጋቼዛና አሾባ ጋችፐ ጌዛነ፥ ሀራ አሳይ ኤዛ አይኮዳይስ የኤዝታ ካይፓተ Ꮊት ኡ ዎደ የጌዝታ ናምኢ ቆፍታ ዎል ሄል አይኬዛ።</char></note> ዬጌዛ። አይ ሀያ ቦቺ ፓዛ።<verse eid="LUK 22:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 22:52"/>የይፕ ጉየ፥ የሱሳ ፋና አይኮዳይስ የኤዝ ቄሰ ሀላቅታይኮ፥ ጾስ ኬ ናግዝታ ሹምታይኮኔ ጭምታይኮ፥ «ፓኖ አይክዝ አስ ጋርክ ማሻኔ ጉፈ አይኪ የኤኔ? <verse eid="LUK 22:52"/><verse number="53" style="v" sid="LUK 22:53"/>ኡባ ጋላስ ጾስ ኬ ጋንጨ ታ ይንታር የዝ ዎደ ታል አፋ ኩሸ ጋደካያ ዝን Ꮊይ ማ ካተትይ ሞዴዝ ዎደኔ ይ ዎደ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">22:53 </char><char style="xt" closed="false"><ref loc="LUK 19:47">ሉቃ. 19:47</ref>፤ <ref loc="LUK 21:37">21:37</ref></char></note><verse eid="LUK 22:53"/></para>
  <para style="s1">ጵጽሮሳ የሱሳና ካዴዛ</para>
  <para style="r">(<ref loc="MAT 26:57-58">ማቶ. 26:57-58</ref>፥ <ref loc="MAT 26:67-75">67-75</ref>፤ <ref loc="MRK 14:53-54">ማር. 14:53-54</ref>፥ <ref loc="MRK 14:66-72">66-72</ref>፤ <ref loc="JHN 18:12-18">ዋን. 18:12-18</ref>፥ <ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 22:54"/>የይፐ ጉየ፥ የሱሳና አይኪ ቄሰ ሀላቃይ ዛባ ካንጌዛ። ጵጽሮሳ ሃኮር የሱሳና ካልዛ። <verse eid="LUK 22:54"/><verse number="55" style="v" sid="LUK 22:55"/>አሳይ ቄሰ ሀላቃይ ዛባይድ ታማ ኤ ዎላ በቴዝን ጵጽሮሳ ኡንታር ዎላ በቴዛ። <verse eid="LUK 22:55"/><verse number="56" style="v" sid="LUK 22:56"/>ፐቲ ጋንዳታ ጵጽሮሳ ታማ ላንቀ በቴዛና ታማ ፎአይር ዳኪ ብኢ፥ «Ꮊ አይ ኤዛር የዛ» ዬጌዛ።<verse eid="LUK 22:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 22:57"/>ዝን ጵጽሮሳ፥ «Ꮊን አስቴ ታ የ አ ኤሮያ» ዬጊ ካዴዛ።<verse eid="LUK 22:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 22:58"/>ጽቃ ሳተፕ ጉየ ፐቲ ሀራ አይ ኤዛ ብኢ፥ «ኔካ ኡንታፕ ፐታባይ» ዬጌዛ።</para>
  <para style="p" vid="LUK 22:58">ዝን ጵጽሮሳ፥ «Ꮊ አዮ ታና ባያ» ዬጌዛ።<verse eid="LUK 22:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 22:59"/>ፐቲ ሳተ ጋርክ ጋምኤዛይፕ ጉየ ፐቲ ሀራ አይ ትልሲ፥ «Ꮊ አይ ጋልላፕ ማቅዝ ግሾስ ስ ባይ ኤዛር የዛ» ዬጌዛ።<verse eid="LUK 22:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 22:60"/>ዝን ጵጽሮሳ፥ «Ꮊ አዮ፥ ነ ግዛና ታ ኤሮያ» ዬጌዛ። ኤ የ ኦዳ ዉርሰካዝን ሹጉላ ኡኬዛ።<verse eid="LUK 22:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 22:61"/>ጎዳይ ጉየ ሽርንቲ ኤቂ ጵጽሮሳ በኤዛ። ጵጽሮሳ፥ «Ꮊይኖ ሹጉላ ኡኮዳይፕ ቲና ነ ታና ሀይ ቶኬ ካዶዳ» ዬጊ፥ ጎዳይ ኦዴዝ ቃላይ ኤዝስ ኤልቂ ጌዛ። <verse eid="LUK 22:61"/><verse number="62" style="v" sid="LUK 22:62"/>ጵጽሮሳስ ባለ ከዚ ዱካ ሱ ዬኬዛ።<verse eid="LUK 22:62"/></para>
  <para style="s1">የሱሳ ጵላጾሳ ቲናኔ ሄሮዶሳ ቲና ሺቄዛ</para>
  <para style="r">(<ref loc="MAT 26:59-66">ማቶ. 26:59-66</ref>፤ <ref loc="MRK 14:55-64">ማር. 14:55-64</ref>፤ <ref loc="JHN 18:19-24">ዋን. 18:19-24</ref>)</para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 22:63"/>የሱሳ ናግዝ አሳይ ኤዛ ላቃሶኔ Ꮊ አይኬዛ። <verse eid="LUK 22:63"/><verse number="64" style="v" sid="LUK 22:64"/>ኤ አፋ ጎዚ «አን ነ ናበዛኮ ኤሮባ፤ ነና ሾጬዛይ ኦኖ?» ዬጊ ኦይጭዛ። <verse eid="LUK 22:64"/><verse number="65" style="v" sid="LUK 22:65"/>ሀራ ጋመ ጫሺ ጫዢ ካዉሽሴዛ።<verse eid="LUK 22:65"/></para>
  <para style="p">
    <verse number="66" style="v" sid="LUK 22:66"/>ሳአ ዎንትዛ ዎደ አይሁደ ጋደ ጭምታይ፥ ቄሰ ሀላቅታይኔ ህገ አስታማርታይ ሺቂ፥ የሱሳና ፋ ቲና ሺሼዛ። <verse eid="LUK 22:66"/><verse number="67" style="v" sid="LUK 22:67"/>ኡ፥ «ነ ክርስቶሳ? አን ኑስ ኦዶባ?» ዬጊ ኦይጬዛ።</para>
  <para style="p" vid="LUK 22:67">የሱሳ፥ «ታ ኦድዛኮን ይ አማናሚ። <verse eid="LUK 22:67"/><verse number="68" style="v" sid="LUK 22:68"/>ታ ኦይጭዛኮ ይ ማሃሚ። <verse eid="LUK 22:68"/><verse number="69" style="v" sid="LUK 22:69"/>ዝን አስ ናአይ Ꮊይፕ ገደ ዎልቃማ ጾስ ኡሻች ባጋር በቶዳ» ዬጌዛ።<verse eid="LUK 22:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="LUK 22:70"/>የ ዎደ ኡቢታይ፥ «የዝን፥ ነ ጾሳ ናአ?» ዬጌዛ።</para>
  <para style="p" vid="LUK 22:70">ኤ፥ «ታ ጾስ ናአ ማቄዛና ይ ጌዛ» ዬጌዛ።<verse eid="LUK 22:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="LUK 22:71"/>ኡ፥ «ይኬ፥ ሀራ ማርካ አብ ኮሼ? ኤ ፋ ዶናር ኦዶዳር ኑ ስኤዛ» ዬጌዛ።<verse eid="LUK 22:71"/></para>
  <chapter eid="LUK 22"/>
  <chapter number="23" style="c" sid="LUK 23"/>
  <para style="s1">የሱሳ ጵላጾሳ ቲናይድ</para>
  <para style="r">(<ref loc="MAT 27:1-2">ማቶ. 27:1-2</ref>፥ <ref loc="MAT 27:11-14">11-14</ref>፤ <ref loc="MRK 15:1-5">ማር. 15:1-5</ref>፤ <ref loc="JHN 18:28-38">ዋን. 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 23:1"/>የ አቃይድ ሺቄዝ ኡቢታይ ደንዲ የሱሳና ጵላጾሳኮ ካንጌዛ። <verse eid="LUK 23:1"/><verse number="2" style="v" sid="LUK 23:2"/>«Ꮊ አይ ኑ አስታ ባለታር፥ ኦሮመ ካታይስ ጊራ ጊራማይ ጋርክ ካይታራኔ ማ፥ ‹ታኒ ክርስቶሳ ይ ካታ› ዬጎዳር ኑ ደንጌዛ» ዬጊ ሞቴዛ።<verse eid="LUK 23:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 23:3"/>ጵላጾሳ የሱሳና፥ «ኔኒ አይሁድታይ ካቶኔ?» ዬጊ ኦይጬዛ።</para>
  <para style="p" vid="LUK 23:3">የሱሳ፥ «ኤ፥ ነ ጌዛይ ጋርከ» ዬጌዛ።<verse eid="LUK 23:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 23:4"/>ጵላጾሳ ቄሰ ሀላቅታይኮኔ አሳይኮ፥ «Ꮊ አይል አፋ ታ ፐቲ ቡታካ ደንገካያ» ዬጌዛ። <verse eid="LUK 23:4"/><verse number="5" style="v" sid="LUK 23:5"/>ዝን ኡንቲ፥ «Ꮊ አይ ጋልላፐ Ꮊያ ሄሎዳይስ ይሁዳ ሙመር ኢታ ባዝስ ደንዛ» ዬጊ ሚን ኦዴዛ።<verse eid="LUK 23:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 23:6"/>ጵላጾሳ የያ ስኤዝ ዎደ የሱሳ ጋልላ አሶ ዬጊ ኦይጬዛ። <verse eid="LUK 23:6"/><verse number="7" style="v" sid="LUK 23:7"/>የሱሳ ሄሮዶሳ ጋደፕ የኤዝ አስ ማቄዛና ጵላጾሳ ኤሬዛይፕ ጉየ ሄሮዶሳ የ ዎደ የሩሳላመ የዝ ግሾስ ኤዝኮ ዳኬዛ።<verse eid="LUK 23:7"/></para>
  <para style="s1">የሱሳ ሄሮዶሳ ቲና</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 23:8"/>ሄሮዶሳ የሱሳ በአዳይስ ጋመ ዎደፐ ኮይታር የዝ ግሾ ኤዛ በኤዝ ዎደ ጋመ ኡፋይቴዛ። አብስ ጊኮ፥ ኤባዝ ስኤዝ ግሾ ማላባዝ ኡድን በአዳይስ አሞትታር የዛ። <verse eid="LUK 23:8"/><verse number="9" style="v" sid="LUK 23:9"/>ሄሮዶሳ የሱሳና ጋመ ኦይች ኦይጬዛ፥ ዝን ኤ አብካ ማሄካያ። <verse eid="LUK 23:9"/><verse number="10" style="v" sid="LUK 23:10"/>ቄስታይ ሀላቅታይኔ ህገ አስታማርታይ ኤዛይድ ኤቂ ሚን ኤዛ ሞትዛ። <verse eid="LUK 23:10"/><verse number="11" style="v" sid="LUK 23:11"/>ሄሮዶሳራኔ ኤ ዎታዳርታይር የሱሳ ላቃሰር ለቄዛ። ቡቁሮ አፍላ ማእሲ ጵላጾሳኮ ማሂ ዳኬዛ። <verse eid="LUK 23:11"/><verse number="12" style="v" sid="LUK 23:12"/>ሄሮዶሳራኔ ጵላጾሳር ቲን ሞርከዝን የ ጋላስ ዎላ እግንቴዛ።<verse eid="LUK 23:12"/></para>
  <para style="s1">ፕላጾሳ የሱሳል ፕርዴዛ</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 23:13"/>ጵላጾሳ ቄሰ ሀላቅታ፥ ጋደ አቅስዝታኔ ዎይታ ጼጊ፥ <verse eid="LUK 23:13"/><verse number="14" style="v" sid="LUK 23:14"/>« ‹Ꮊ አይ ኢታ ባዝስ ደንዛ› ግ ታኮ ይ ከኤዛ። ታካ ይ ቲና ፕላጊ ብእን ይ ሺሼዝ ሞታይስ አባ ቡታካ ኤል ደንገካያ። <verse eid="LUK 23:14"/><verse number="15" style="v" sid="LUK 23:15"/>ሄሮዶሳ፥ የይ ጋርክ አባ ቡታካ ኤዛል አፋ ደንገካ ግሾስ ኑኮ ዳኬዛ። ቱማ Ꮊ አይ Ꮊይቆስ ሄልዝ አባ ቡታካ ኦካያ። <verse eid="LUK 23:15"/><verse number="16" style="v" sid="LUK 23:16"/>የይ ግሾስ፥ ኤዛ ጋራፊ ብሊ ዳኮዳ» ዬጌዛ። <verse eid="LUK 23:16"/><verse number="17" style="v" sid="LUK 23:17"/>[የያ ኤ ጌዛይ ፋዝቃ ባለ ዎደ ፐቲ አስ አቻፕ ኡንትስ ብልዛይ ኤዝስ አቶዋ ባዝ ማቄዝ ግሾስ።]<verse eid="LUK 23:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 23:18"/>ዎያ ኡቢታይ ፐትፕ፥ «Ꮊ አ ገደ ሀልእሶባ፥ ኑስ ባርባና ብሎባ» ዬጊ ኡኬዛ። <verse eid="LUK 23:18"/><verse number="19" style="v" sid="LUK 23:19"/>ባርባና ካታማ ጋንጨ አስ ኢታ ባዝስ ደን አስ ዎ አጭንቴዝ አሲ።<verse eid="LUK 23:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 23:20"/>ጵላጾሳ የሱሳና ብልኦዳይስ ኮዪ አሳይስ ማሂ ኦዴዛ። <verse eid="LUK 23:20"/><verse number="21" style="v" sid="LUK 23:21"/>ማቆዝን፥ አሳይ፥ «ሶቶባ! ሶቶባ!» ዬጊ ኡኬዛ። <verse eid="LUK 23:21"/><verse number="22" style="v" sid="LUK 23:22"/>ጵላጾሳ ሃይን፥ «Ꮊ አይ ቆሄዝ ባዛይ አባ? ዎስ ሄልዝ ቡታ ታ ደንገካያ። የይ ግሾስ፥ ጋራፊ ዳኮዳ» ዬጌዛ።<verse eid="LUK 23:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 23:23"/>ኡ ፋ ቃላ ቅ ኡዲ፥ «ሶትንቶዳይስ ቤዝዛ» ግ ሚን ኡኬዛ። ኡ ኡፋይካ ኡሳ ዳሬዛ። <verse eid="LUK 23:23"/><verse number="24" style="v" sid="LUK 23:24"/>ኡ ኦይቻይ ግሾስ ግ ጵላጾሳ ኤዛል አፋ ፕርዴዛ። <verse eid="LUK 23:24"/><verse number="25" style="v" sid="LUK 23:25"/>አሳ ኢታ ባዝስ ደንዛኔ አስ ዎ አጭንቴዛና ብሎድ ጋርክ ዎሴዝ፥ የ አ ኡንትስ ብልኤዛ። ዝን የሱሳ ኡንቲ ኮዬዝ ባዝ ኦድ ጋርክ ኡንትስ አ እንጌዛ።<verse eid="LUK 23:25"/></para>
  <para style="s1">የሱሳ ሶትንቴዛ</para>
  <para style="r">(<ref loc="MAT 27:31-44">ማቶ. 27:31-44</ref>፤ <ref loc="MRK 15:21-32">ማር. 15:21-32</ref>፤ <ref loc="JHN 19:17-27">ዋን. 19:17-27</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 23:26"/>የሱሳና አይኪ ካማዳር ስሞና ግዝ ቀረና ቢታ አይ ጋጻረፕ የኦዳር፥ ደንጊ ማዝቃላ ቶሲ የሱሳ ካሊ Ꮊማድ ጋርክ ጭጵቼዛ። <verse eid="LUK 23:26"/><verse number="27" style="v" sid="LUK 23:27"/>ጋመ አሳይኔ ኡ ጋንጨፕ ፋ ትራ ቆጽታር ዬክዛ ማችታይ ኤ ጉያይር ካልዛ።<verse eid="LUK 23:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 23:28"/>ዝን የሱሳ ኡንትኮ ጉየ ማቂ፥ «ይንታኖ፥ የሩሳላመ ማችታዮ፥ ይ ኡባይስኔ ይ ናእታይስ ዬኮይታፕ አትን ታስ ዬክፓተ። <verse eid="LUK 23:28"/><verse number="29" style="v" sid="LUK 23:29"/>‹የዛኮ ንታይ፥ የለካ ኡልታይኔ አምሰካ አምታይ አንጅንቴዛ› ይ ዬጎድ ጋላሳይ የኦዳ። <verse eid="LUK 23:29"/><verse number="30" style="v" sid="LUK 23:30"/>የ ዎደ አምብታካ፥ ‹ኑል አፋ ዎዶይታ›፥ ደርታካ፥ ‹ኑና ቆሶይተ› ዬጎዳ።<note caller="-" style="x"><char style="xo" closed="false">23:30 </char><char style="xt" closed="false"><ref loc="HOS 10:8">ሆሳ. 10:8</ref>፤ <ref loc="REV 6:16">ዋን. ቆን. 6:16</ref></char></note> <verse eid="LUK 23:30"/><verse number="31" style="v" sid="LUK 23:31"/>ይኬ፥ እርጻ ምንጻ የይ ጋርክ ኦኮ መላ ምንጻ ዋይሳደሻ?» ዬጌዛ።<verse eid="LUK 23:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 23:32"/>ኤዛር ዎላ ዎዳይስ ሀራ ናምኢ ፓንታ ካንጌዛ። <verse eid="LUK 23:32"/><verse number="33" style="v" sid="LUK 23:33"/>ቄራንዮ<note caller="+" style="f"><char style="fr" closed="false">23:33 </char><char style="fqa" closed="false">ቄራንዮ፦ </char><char style="ft" closed="false">ቄራንዮ ግዛይ ግርኬ ዶና። አራማይኬ ዶናር «ጎልጎታ» ዎይ «ኦማ ጉተ» ጉሲ። ቄራንዮ ግዝ ሱንይ እንግንቴዛይ የሱሳ ሶትንቴዛይ አስ ኦማ ጉተ ኣዝዝ በሳይድ ማቅዝ ግሾስ። የ አቃይ ኦሮመ ካተትይ ፓንታ ሶጾዳር አቆ። (ማቶ 27፦ 33፤ ማር። 15:22፤ ዋን 19:17)</char></note> ግንትንትዝ አቆ ሄል ሶቴዛ። ፓንታይፕ ፐታ ኡሻች ባጋር Ꮊንካ ሀድርስ ባጋር ሶቴዛ። <verse eid="LUK 23:33"/><verse number="34" style="v" sid="LUK 23:34"/>የሱሳ፥ «ታ አዳዮ፥ ኡ አብ ኦዛኮ ኤሮዋ ግሾስ ኔኒ ኡንትስ አቶ ጎባ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">23:34 </char><char style="xt" closed="false"><ref loc="PSA 22:18">ማዝ. 22:18</ref></char></note></para>
  <para style="p" vid="LUK 23:34">ኡ ኤ አፍላይል አፋ እጻ ኦሊ ሻክንቲ ኤኬዛ።<verse eid="LUK 23:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 23:35"/>አሳይ ኤቂ በአዳር፥ ጋደ ሞድዝታይ፥ «ኤ ሀራ አሳ አሼዛ፤ ጾሳይ ማራጼዝ ክርስቶሳ ኤዛ ማቅኮ አን ፋና አሾ» ዬጊ ለቄዛ።<note caller="-" style="x"><char style="xo" closed="false">23:35 </char><char style="xt" closed="false"><ref loc="PSA 22:18">ማዝ. 22:18</ref>፤ <ref loc="PSA 22:7">ማዝ. 22:7</ref></char></note> <verse eid="LUK 23:35"/><verse number="36" style="v" sid="LUK 23:36"/>ዎታዳርታይ ኤዝኮ ሺቂ፥ ጫላ ዎይነ ኡሽ እንጌዛ።<note caller="-" style="x"><char style="xo" closed="false">23:36 </char><char style="xt" closed="false"><ref loc="PSA 69:21">ማዝ. 69:21</ref></char></note> <verse eid="LUK 23:36"/><verse number="37" style="v" sid="LUK 23:37"/>ዬዚ፥ «ኔኒ አይሁድታይ ካት ማቅኮ አን ነ ኡባ አሾባ» ዬጊ ለቄዛ።<verse eid="LUK 23:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 23:38"/>ኤዝስ ኦማ ባጋር፥ «Ꮊይ አይሁድታይ ካት» ዬግዝ ጹፈ ግርክራ፥ ኦሮምራ፥ እብራይስጽራ ጻፊ ጋዴዛ። <verse eid="LUK 23:38"/><verse number="39" style="v" sid="LUK 23:39"/>ሶትንቴዝ ፓኖ ፐታይ ጫሸ ሳአር ጎችታር፥ «አን ኔኒ ክርስቶሳ ማቅኮ፥ ነናካ ኑናካ አሾባ» ዬጌዛ።<verse eid="LUK 23:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 23:40"/>ዝን Ꮊንኮ ፓናይ፥ «ነ Ꮊይ ጋርክ ፕርዳር የዛር ሀራ አቶዝን፥ ጾስስ ያሽታሞ? <verse eid="LUK 23:40"/><verse number="41" style="v" sid="LUK 23:41"/>ኑኒ ኑ ቡታይስ ቤዝዛ ፕርደ ኤክዛ፥ ዝን Ꮊ አይ ፐቲ ኢታባዝካ ኦካያ» ዬጊ ካጭንቴዛ።<verse eid="LUK 23:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 23:42"/>ማካ፥ «የሱሳ፥ ነ ነ ካተትር ይእዝ ዎደ ታና ቆፖባ» ዬጌዛ።<verse eid="LUK 23:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 23:43"/>የሱሳ፥ «ታ ኔስ ቱሮ ኦድዛ፤ Ꮊይኖ ነ ታር ጋናተ የሳዳ» ዬጌዛ።<verse eid="LUK 23:43"/></para>
  <para style="s1">የሱሳ Ꮊይቆ</para>
  <para style="r">(<ref loc="MAT 27:45-56">ማቶ. 27:45-56</ref>፤ <ref loc="MRK 15:33-41">ማር. 15:33-41</ref>፤ <ref loc="JHN 19:28-30">ዋን. 19:28-30</ref>)</para>
  <para style="p">
    <verse number="44-45" style="v" sid="LUK 23:44-45"/>የ ጋላስ ኡሱፑን ሳተፕ Ꮊንጊ ኡዱፉን ሳተ ጋ አዋ ፖኦ ካዬዝ ግሾስ ቢታ ኡባይል አፋ ማ ማቄዛ። ጾስ ኬ ማጋራዣይ ፐርእንቲ ናምኢ አቆ ሻክንቴዛ።<note caller="-" style="x"><char style="xo" closed="false">23:44-45 </char><char style="xt" closed="false"><ref loc="EXO 26:31">ከስ 26:31</ref></char></note> <verse eid="LUK 23:44-45"/><verse number="46" style="v" sid="LUK 23:46"/>የሱሳ፥ ቃላ ቅ ኡዲ፥ «ታ አዳዮ፥ ታ ታ ሸምፓቶ ነ ኩሻይድ እንጌዛ» ዬጊ Ꮊይቄዛ።<note caller="-" style="x"><char style="xo" closed="false">23:46 </char><char style="xt" closed="false"><ref loc="PSA 31:5">ማዝ. 31:5</ref></char></note><verse eid="LUK 23:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 23:47"/>ማቶ ሀላቃይ፥ ሀኔዛያ ብኢ፥ «Ꮊ አይ ቱማካ ጌሻ» ዬጊ ጾስ ጋላቴዛ። <verse eid="LUK 23:47"/><verse number="48" style="v" sid="LUK 23:48"/>Ꮊ ሀንዛባዛ በአዳይስ የ አቃይድ ሺቄዝ አስ ኡባይ ሀኔዝባዛ ብኢ ፋ ትራ ቆጽታር ፋ ካራ ማቄዛ። <verse eid="LUK 23:48"/><verse number="49" style="v" sid="LUK 23:49"/>ማቆዝን፥ የሱሳ ላንቀ ኤርዛ አስ ኡባይ፥ የይ ጋርከካ ጋልላፐ ካል የኤዝ ማችታይ የያ ብእታር ሃኮር ኤቄዛ።<note caller="-" style="x"><char style="xo" closed="false">23:49 </char><char style="xt" closed="false"><ref loc="LUK 8:2">ሉቃ. 8:2</ref></char></note><verse eid="LUK 23:49"/></para>
  <para style="s1">የሱሳ ሞግንቶ</para>
  <para style="r">(<ref loc="MAT 27:57-61">ማቶ. 27:57-61</ref>፤ <ref loc="MRK 15:42-47">ማር. 15:42-47</ref>)</para>
  <para style="p">
    <verse number="50-51" style="v" sid="LUK 23:50-51"/>አይሁደ ሻንግታይፕ ፐታይ፥ ዮሴፋ ግንትንትዝ አይ የዛ። ኤ አርማትያሳ ግንትንትዝ ይሁዳ ካታማፕ የኤዛ። ኤ ሎኦኔ ጌሽ አስ ማቅዝ ግሾስ ጾሳ ካተትይ ይእና ናግዛ። ሻንግታይፕ ፐታ ማቅታር ኡ ዞረትራኔ ኦሳይር ባያ። <verse eid="LUK 23:50-51"/><verse number="52" style="v" sid="LUK 23:52"/>የ አይ ጵላጾሳኮ Ꮊንጊ፥ የሱሳ አሃ ሞጎዳይስ ታስ እንጎባ ግ ዎሴዛ። <verse eid="LUK 23:52"/><verse number="53" style="v" sid="LUK 23:53"/>የሱሳ አሃ ዎሲ አፍላር ጻጼዛ። ዛላ ዎጪ ከሴዝ ሀራ አስ ሞግንተካ ኦሮ ዱፎ ጋንጨ ጋዴዛ። <verse eid="LUK 23:53"/><verse number="54" style="v" sid="LUK 23:54"/>ማላ ገሎድ ሀንዛ ግሾስ የ ጋላሳይ ጊግንቶ ቃማ።<verse eid="LUK 23:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 23:55"/>ጋልላፐ ደንዲ የሱሳ ካሊ የኤዝ ማችታይ ዮሴፋር ዎላ Ꮊንጊ ኤ አሃ ዋይዚ ሞግዛኮ ዱፋ አካኪ በኤዛ። <verse eid="LUK 23:55"/><verse number="56" style="v" sid="LUK 23:56"/>ኤዛይፕ ማቂ ሽቶኔ ቅባተ ጊግሴዛ። ህገ ኪትዛይ ጋርክ ማላ ጋላስ ሸምፕ ፔዤዛ።<note caller="-" style="x"><char style="xo" closed="false">23:56 </char><char style="xt" closed="false"><ref loc="EXO 20:10">ከስ 20:10</ref>፤ <ref loc="DEU 5:14">ናምእ. 5:14</ref></char></note><verse eid="LUK 23:56"/></para>
  <chapter eid="LUK 23"/>
  <chapter number="24" style="c" sid="LUK 24"/>
  <para style="s1">የሱሳ Ꮊይቆፕ ደንዴዛ</para>
  <para style="r">(<ref loc="MAT 28:1-10">ማቶ. 28:1-10</ref>፤ <ref loc="MRK 16:1-8">ማር. 16:1-8</ref>፤ <ref loc="JHN 20:1-10">ዋን. 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 24:1"/>ሳምንታፕ ቲና ጋላስ፥ ዎጋ ዎደ ጉራ የጭየጮ፥ ማችታይ ፋ ጊግሴዝ ሽቶ ኤኪ ዱፋይኮ Ꮊንጌዛ። <verse eid="LUK 24:1"/><verse number="2" style="v" sid="LUK 24:2"/>ኡ እዘ ሄሎዳር ዱፋይ ዶና የዝ ሹቻይ ጎልኣልኢ ሀልኤዛና ደንጌዛ። <verse eid="LUK 24:2"/><verse number="3" style="v" sid="LUK 24:3"/>ኡ ዱፋ ሄሊ ገሌዛ፥ ዝን ጎዳ የሱሳ አሃ ደንጌካያ። <verse eid="LUK 24:3"/><verse number="4" style="v" sid="LUK 24:4"/>ኡ ኤዛይድ ኤቂ አቢ ሀነኔ ግ ቆፖዳር አካከካዝን ቦ ፖጭዝ አፍላ ማኤዝ ናምኢ አስታይ ኡ ካለ ኤቄዛ። <verse eid="LUK 24:4"/><verse number="5" style="v" sid="LUK 24:5"/>ማችታይ ያሽቲ ፋ ኦማ ሳአ ዝቂ ኡዲ የዝን፥ አስታይ ኡንትኮ፥ «ፓና Ꮊይቅታይ ጋንጨ አብስ ኮዬ? <verse eid="LUK 24:5"/><verse number="6-7" style="v" sid="LUK 24:6-7"/>ኤ Ꮊይዳ ባያ፤ Ꮊይቆፕ ደንዴዛ፥ ‹አስ ናአይ ናጋራ ኦዝታይ ኩሸ ኣ እንግንቶዳ፤ ኡንትካ ኤዛ ሶቶዳ።<note caller="-" style="x"><char style="xo" closed="false">24:6-7 </char><char style="xt" closed="false"><ref loc="MAT 16:21">ማቶ. 16:21</ref>፤ <ref loc="MAT 17:22-23">17:22-23</ref>፤ <ref loc="MAT 20:18-19">20:18-19</ref>፤ <ref loc="MRK 8:31">ማር. 8:31</ref>፤ <ref loc="MRK 9:31">9:31</ref>፤ <ref loc="MRK 10:33-34">10:33-34</ref>፤ <ref loc="LUK 9:22">ሉቃ. 9:22</ref>፤ <ref loc="LUK 18:31-33">18:31-33</ref></char></note> ኤ ሃይን ጋላስ Ꮊይቆፕ ደንዶዳ› ዬጊ፥ ኤ ይንታር ጋልላ ቢታ የዝታር ይንትስ ኦዴዝ ቃላ ቆፖይታ» ዬጌዛ።<verse eid="LUK 24:6-7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 24:8"/>ማችታይ የ ዎደ ኤ ቃላ ቆፔዛ።<verse eid="LUK 24:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 24:9"/>ማችታይ ዱፋይፕ ማቂ ሀኔዝባዛ ኡብታ ታጶ ፐትታይስኔ Ꮊንክታይስካ ኦዴዛ። <verse eid="LUK 24:9"/><verse number="10" style="v" sid="LUK 24:10"/>የያ ሀዋርታይስ ኦዴዛይ ማግዴላ ማይራሞ፥ ዮሃና፥ ያይቆባ እንዳት ማይራምራኔ ኡንታር የዝ ሀራ ማችታ። <verse eid="LUK 24:10"/><verse number="11" style="v" sid="LUK 24:11"/>ዝን ኡንትስ ማችታይ ኦዴዛይ ኤልሞ ኣዝን አማነካያ። <verse eid="LUK 24:11"/><verse number="12" style="v" sid="LUK 24:12"/>ዝን ጵጽሮሳ ደንዲ ዎጺ ዱፎ Ꮊንጌዛ። የ አቃ ሄሊ ዙጊ በአዳር ሞጎ አፍላ ኣዳ በኤዛ። ሀኔዝ ባዛይስ ማላባዝግታር ፋ ካራ ማቄዛ።<verse eid="LUK 24:12"/></para>
  <para style="s1">ኤማሁሰ ኦገል አፋ</para>
  <para style="r">(<ref loc="MRK 16:12-13">ማር. 16:12-13</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 24:13"/>የ ጋላስ ካልዛ ታማርታይፕ ናምእታይ የሩሳላመፕ ታጶ ናምኢ ክሎ ምትረ ሃክዛ ኤማሁሰ ሄራ Ꮊንግዛ። <verse eid="LUK 24:13"/><verse number="14" style="v" sid="LUK 24:14"/>ኡ ዎላ ሀኔዝባዛ ኡብታ ኦድንትዛ። <verse eid="LUK 24:14"/><verse number="15" style="v" sid="LUK 24:15"/>ኡ የ ሀናይ ባጋ ቆፕታራኔ ኦድንትታር Ꮊንጎዳር የሱሳ ኡንትኮ ሺቂ ኡንታር ዎላ Ꮊንግዛ። <verse eid="LUK 24:15"/><verse number="16" style="v" sid="LUK 24:16"/>ሀኖ ዝን፥ ኡንቲ ኤዛ ኤራም ጋርክ ኡ ኣፋይ አይክንቴዛ።<verse eid="LUK 24:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 24:17"/>ኤ፥ «ይ ዎላ ኦገል አፋ ኦድንትዛይ አባ?» ዬጌዛ።</para>
  <para style="p" vid="LUK 24:17">ኡ አዛኒ ስኤ ግ ኤቄዛ። <verse eid="LUK 24:17"/><verse number="18" style="v" sid="LUK 24:18"/>ኡንታፕ ፐታይ ቀልዮጳ ግንትንትዛይ፥ «Ꮊ ቃምታይ ጋንጨ የሩሳላመ ሀኔዝባዛ ኤሮዛይ፥ ነ ቢታስ እማኔ?» ዬጌዛ።<verse eid="LUK 24:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 24:19"/>ኤ ማሂ፥ «ኤ ሀኔዛይ አባ?» ዬጊ ኦይጬዛ።</para>
  <para style="p" vid="LUK 24:19">ኡንቲ፥ «ጾስ ቲናኔ አስ ቲና ኦሶራኔ ኦዳር ሚን ናበ ማቄዝ ናዝረተ የሱሳ ባጋ። <verse eid="LUK 24:19"/><verse number="20" style="v" sid="LUK 24:20"/>ኤዛ ቄሰ ሀላቅታይኔ ኑና አቅስዝታይ Ꮊይቆ ፕርደስ ኣ እንጊ፥ ሶቴዛ። <verse eid="LUK 24:20"/><verse number="21" style="v" sid="LUK 24:21"/>ኑኒ እስሬለ አሳ ዎዞደ ግ ኡፋይቲ ናጌዝን Ꮊይ ሀንን Ꮊይኖ ሃይን ቃማ። <verse eid="LUK 24:21"/><verse number="22" style="v" sid="LUK 24:22"/>ማ ኑ ጋንጨፕ ፐቲ ፐቲ ማችታይ ኑና ዶና ኣይዛ። ኡንቲ Ꮊይኖ ዎንታ ጉራ ዱፎ Ꮊንጌዛ። <verse eid="LUK 24:22"/><verse number="23" style="v" sid="LUK 24:23"/>ኤ አሃይ ብን ማቂ ይኢ፥ ‹ኤ ፓ የዛ› ዬግዛና ኪታንችታይ ቆንጭስን በኤዛ ዬጊ ኦዴዛ። <verse eid="LUK 24:23"/><verse number="24" style="v" sid="LUK 24:24"/>ኑ ጋንጨፐካ ፐታይ ፐታይ ዱፋ Ꮊንጊ ማችታይ ኦዴዛይ ሀንን በኤዛ፥ ዝን ኤዛ ኡ በኤካያ» ዬጌዛ።<verse eid="LUK 24:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 24:25"/>ኤ ኡንትኮ፥ «ይንታኖ፥ አካኮዋ አስታዮ፥ ይ ዎዝናይ ናብታይ ኦዴዝ ባዝ ኡብታ አማኖዳይስ ጋምእዝታዮ፥ <verse eid="LUK 24:25"/><verse number="26" style="v" sid="LUK 24:26"/>ክርስቶሳ Ꮊ መታ ኤኮዳይስነ ፋ ቦንቻይር ገሎዳይስ ቤዞሳ?» ዬጌዛ። <verse eid="LUK 24:26"/><verse number="27" style="v" sid="LUK 24:27"/>ሙሰፐኔ ናብታይ ኡባይፕ ደንዲ ጌሻ ማጻፋይድ ኤባጋ ጻፍንቴዛና ኡባ ኡንትስ ፓቴዛ።<verse eid="LUK 24:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 24:28"/>ኡንቲ Ꮊንግዛ ጉታይኮ ኡኮዳር የሱሳ አ ሃኮ አቆ Ꮊንግዛ ኣዝን፥ <verse eid="LUK 24:28"/><verse number="29" style="v" sid="LUK 24:29"/>ኡንቲ፥ «ሳአይ ቃሜዝ ግሾስ ኑር አቆባ» ዬጊ ሚን ዎሴዛ። የይ ግሾስ፥ ኡንታር አቆዳይስ ገሌዛ።<verse eid="LUK 24:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 24:30"/>ኡንታር ዎላ ሙንታል አፋ በቲ፥ ቦራ፥ ደን አንጂ ኡንትስ ባጺ እንጌዛ። <verse eid="LUK 24:30"/><verse number="31" style="v" sid="LUK 24:31"/>የ ዎደ ኡንቲ ኤሮዳይ ጋርክ ኡ አፋይ ዶይንቴዛ። ኡንትካ ኤሬዛ። ዝን ኤ ኡ ኣፋይፕ ቤዛ። <verse eid="LUK 24:31"/><verse number="32" style="v" sid="LUK 24:32"/>ኡንቲ፥ «ኑ ኦገል አፋ የዝን ኤ ኑስ ጌሻ ማጻፋ ብልታራኔ ኑር ናሾዳር ኑ ዎዝናይ ጹግንተካሳ?» ዬጌዛ። <verse eid="LUK 24:32"/><verse number="33" style="v" sid="LUK 24:33"/>የ ዎደ ደንዲ ጉየ የሩሳላመ የኤዛ። ታጶ ፐትታይራ Ꮊንክታይ ፐትፕ ሺቂ የዝን ደንጌዛ። <verse eid="LUK 24:33"/><verse number="34" style="v" sid="LUK 24:34"/>ኡንቲ፥ «ጎዳይ ቱማ ደንዴዛ፤ ስሞናስ በንቴዛ» ዬጌዛ።<verse eid="LUK 24:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 24:35"/>የ ናምኢ ታማርታይ ኤማሁሰ ኦገል አፋ የዝን ሀነዛናኔ ቦራ ሜዝ ዎደ ዋይዚ ኤዛ ኤሬዛኮ ኡንትስ ኦዴዛ።<verse eid="LUK 24:35"/></para>
  <para style="s1">የሱሳ ፋ ታማርታይስ በንቴዛ</para>
  <para style="r">(<ref loc="MAT 28:16-20">ማቶ. 28:16-20</ref>፤ <ref loc="MRK 16:14-18">ማር. 16:14-18</ref>፤ <ref loc="JHN 20:19-23">ዋን. 20:19-23</ref>፤ <ref loc="ACT 1:6-8">ሀዋ. ኦ. 1:6-8</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 24:36"/>ናምኢ ታማርታይ የ ኦዳይል አፋ የዝን፥ የሱሳ ኡ ጋንጨ ኤቂ፥ «ሳሮ ይንትስ ማቆ» ዬጌዛ።<verse eid="LUK 24:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 24:37"/>ማቆዝን፥ ኡንቲ ዳጋሚ፥ ሜሸ በኤዛ ኣዝን ያሽቴዛ።<verse eid="LUK 24:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 24:38"/>ኤ ኡንትኮ፥ «አብስ ዳጋሜኔ? አብስ ስ ይ ዎዝናይድ ገሌኔ? <verse eid="LUK 24:38"/><verse number="39" style="v" sid="LUK 24:39"/>ታ ኩሻኔ ታ ቶካ ቦኦይታ፤ ታ ታና። ማካ አይኪ ቦኦይታ፤ ታል ይ ብእዛይ ጋርክ፥ ሜሸስ አሾኔ መቀ ባያ» ዬጌዛ። <verse eid="LUK 24:39"/><verse number="40" style="v" sid="LUK 24:40"/>ዬጊ፥ ፋ ቶካኔ ፋ ኩሻ ኡንታን ቤዜዛ። <verse eid="LUK 24:40"/><verse number="41" style="v" sid="LUK 24:41"/>ኡ ኡፋይሳፕ ደንዴዛይድ አማነካዛር ማላባዝ ጉሳል የዝን፥ የሱሳ ኡንትኮ፥ «Ꮊይዳ ይንትስ ሚዝባዝ የኔ?» ዬጌዛ። <verse eid="LUK 24:41"/><verse number="42" style="v" sid="LUK 24:42"/>ኡ ጽቃ ምችንቴዝ ሞሎ ኤዝስ እንጌዛ። <verse eid="LUK 24:42"/><verse number="43" style="v" sid="LUK 24:43"/>ኤ ኤኪ ኡ ቲናይድ ሜዛ።<verse eid="LUK 24:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 24:44"/>ኤ፥ «ታ ይንታር ጋምኤዝ ዎደ ኡባይድ ሙሰ ህገ ማጻፍታይድ፥ ናብታይ ማጻፍታይዳኔ ማዝሙረ ማጻፍታይድ፥ ታ ግሾ ጻፍንቴዝባዝ ኡቢታይ ፖልንቶዳይስ ቤዝዛ ዬጊ ታ ይንትስ ኦዴዝ ቃላይ Ꮊያ» ዬጌዛ።<verse eid="LUK 24:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 24:45"/>የ ዎደ ጌሻ ማጻፍታ አካኮድ ጋርክ ካሃ ኡንትስ ዶዬዛ። <verse eid="LUK 24:45"/><verse number="46" style="v" sid="LUK 24:46"/>የይ ጋርከካ፥ «ክርስቶሳ ዋየ ኤኮዳ፥ ሃይን ቃማ Ꮊይቆፕ ደንዶዳ ዬጊ ጻፍንቴዛ። <verse eid="LUK 24:46"/><verse number="47" style="v" sid="LUK 24:47"/>የሩሳላመፐ ደንዲ አስ ኡባይስ ናጋራይፕ ማሮትይኔ አቶት ኤ ሱንይር ማርካቶዳ። <verse eid="LUK 24:47"/><verse number="48" style="v" sid="LUK 24:48"/>ይ የይስ ማርክታ። <verse eid="LUK 24:48"/><verse number="49" style="v" sid="LUK 24:49"/>ዬዛኮ፥ ታካ ታ አዳይ እንጌዝ ኡፋይሳ ይንትስ ዳኮዳ። ይ ሳሎፕ ዎልቃ ማኦድ ጋ የሩሳላመ ካታማ ጋምኦይታ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">24:49 </char><char style="xt" closed="false"><ref loc="ACT 1:4">ሀዋ. ኦ. 1:4</ref></char></note><verse eid="LUK 24:49"/></para>
  <para style="s1">የሱሳ ደንዲ ሳሎ ቅቴዛ</para>
  <para style="r">(<ref loc="MRK 16:19-20">ማር. 16:19-20</ref>፤ <ref loc="ACT 1:9-11">ሀዋ. ኦ. 1:9-11</ref>)</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 24:50"/>የይፐ ጉየ፥ ብታና ካታማ ኡንታን ኤኪ ቅቴዛ። ፋ ኩሻ ደን አንጄዛ።<note caller="-" style="x"><char style="xo" closed="false">24:50-51 </char><char style="xt" closed="false"><ref loc="ACT 1:9-11">ሀዋ. ኦ. 1:9-11</ref></char></note> <verse eid="LUK 24:50"/><verse number="51" style="v" sid="LUK 24:51"/>ኡንታን አንጅታር ኡንታፕ ሻክንቲ ኡዴ ሳሎ ኤክንቴዛ። <verse eid="LUK 24:51"/><verse number="52" style="v" sid="LUK 24:52"/>ኡ ዙጊ ጎይኒ ጋመ ኡፋይሳር የሩሳላመ ማቄዛ። <verse eid="LUK 24:52"/><verse number="53" style="v" sid="LUK 24:53"/>ጾሳ ኡባ ዎደ ጋላትታር ጾስ ኬ ጋምኤዛ።<verse eid="LUK 24:53"/></para>
  <chapter eid="LUK 24"/>
</usx>
