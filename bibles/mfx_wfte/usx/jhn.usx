<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JHN" style="id">- Melo New Testament Ethiopic</book>
  <para style="h">ዋንሳ</para>
  <para style="toc1">ዋንሳ ጻፌዝ የሱስ ክርስቶሳ ዎንግሌ</para>
  <para style="toc2">ዋንሳ</para>
  <para style="toc3">ዋን.</para>
  <para style="mt1">ዋንሳ ጻፌዝ የሱስ ክርስቶሳ ዎንግለ</para>
  <para style="imt">ገሎ</para>
  <para style="ip">ዋንሳ የሱሳ «አስ ማቂ አስ ጋንጨ በንቴዝ ጾስ ቃላ» ዬጊ ኤርሴዛ። Ꮊ ዎንግላይ ጻፍንቴዛይ፥ ኤዛ ናባብዛ አሳይ የሱሳ አስ አሽዛያ ማቂ የኦዳ ግንትንቴዝ ጾስ ናአ ማቅዛና አማኖድ ጋርከኔ ኤዛ አማንዝታይስ መና ደኦ የዛና ኡንቲ ኤሮድ ጋርከ (20:31)።</para>
  <para style="ip">ዎንግላይስ ቲና ክፍላይ መና ጾሳ ቃላይኔ የሱሳ ፐቶ ማቄዛና ኦዲ ማቂ፥ የሱሳ አሽዛያ ማቂ የኦድ ግንትንቴዝ ጾስ ናአ ማቄዛና ቤዝዛ ዱማ ዱማ ማልታይር ፋልሲ ቤዝዛ። ጻፋይ፥ የሱስ ክርስቶሳ ፋ ኡባስ ቱማ ጾስ ናአኔ ጾስ አዳይር ፐቶ ማቄዛና (1:1) አፋ ቆንጨ ኦዴዛ። የሱሳ ፋ ኡባስ ታ አፍራመፕ ቲን የዛ (8:58) ዬጌዛ። ዉርስል ቶማሳ፥ «ታ ጎዳዮ፥ ታ ጾሳዮ» ዬጊ ጼጌዛ (20:28)። የይፕ ካሊ ማ Ꮊ ማልታይፕ አባ ኣፈ በንቴዛኮ ኦድዝ ታርክታይ ካልዛ። Ꮊ ክፍላይ ፐቲ ፐቲ አሳይ የሱሳ አማኒ ኤዛ ካልዝታ ማቄዛና ኦድዛ፤ ማ Ꮊንክታይ ኤዛር ዋይዚ ኤቅንቴዛኮኔ ዋይዚ አማናም እጼዛኮ ኦድዛ። ሸምፖ 13-17 ሄሎዳይስ የሱሳ አይክንቴዝ ኦማ ኤዝስ፥ ኤ ታማርታይር አብ ጋርክ ምኖ ዳቦት የዛኮ፥ ማ ዎንት ጋላስ ሶትንቶዳይፕ ቲና ጊግንቶ ቃላኔ ምን ቃላ ኡንትስ ኦዴዛና ፋልሲ ቤዝዛ። ዉርስ ሸምፕታይ የሱሳ አይክንቴዝ ባጋኔ ፕርዳስ ሺቄዝ ባዝ፥ ኤ ሶትንቴዛኔ ኤ ደንዶ፥ የይ ጋርከካ ደንዳይፕ ጉየ ፋ ታማርታይስ ኤ በንቴዝ በንት ኦድዛ።</para>
  <para style="iot">ዋንሳ ዎንግላይ አይኬዝ ቆፍታ</para>
  <para style="io1">ገሎ <char style="ior"><ref loc="JHN 1:1-18">1:1-18</ref> </char></para>
  <para style="io1">ጻማቅዛ ዋንሳኔ የሱሳ ቲና ታማርታ <char style="ior"><ref loc="JHN 1:19-51">1:19-51</ref> </char></para>
  <para style="io1">የሱሳ ኦሶ አይኬዛ <char style="ior"><ref loc="JHN 2:1-12:50">2:1—12:50</ref> </char></para>
  <para style="io1">ዉርስ ቃምታ የሩሳላመ ሄራ <char style="ior"><ref loc="JHN 13:1-19:42">13:1—19:42</ref> </char></para>
  <para style="io1">ጎዳይ ደንዳኔ በንት <char style="ior"><ref loc="JHN 20:1-31">20:1-31</ref> </char></para>
  <para style="io1">ኩስተ ቆፋ፦ ጋልላ ማቂ ፋ ታማርታይስ በንት <char style="ior"><ref loc="JHN 21:1-25">21:1-25</ref> </char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="JHN 1"/>
  <para style="s1">ደኦ ቃላ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1"/>ቃላ ቲናፕ የዛ። ቃላይካ ጾሳር የዛ፤ የ ቃላይ ጾሰ። <verse eid="JHN 1:1"/><verse number="2" style="v" sid="JHN 1:2"/>ቲና ቃላይ ጾሳር የዛ። <verse eid="JHN 1:2"/><verse number="3" style="v" sid="JHN 1:3"/>ጾሳይ ኡባ ባዝ ቃላ ባጋር መዛ። መንቴዝ ባዛፕ ፐቲ ባዝካ ኤ ባጋር መንተካባዝ ባያ። <verse eid="JHN 1:3"/><verse number="4" style="v" sid="JHN 1:4"/>ኤዛር ደኦ የዛ፤ የ ደአይ አስስ ፖኦ። <verse eid="JHN 1:4"/><verse number="5" style="v" sid="JHN 1:5"/>ፖአይ ማ ፖእዛ፤ ማይ ፖአና ጋመካያ።<verse eid="JHN 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6"/>ጾሲ ኪቴዝ፥ ፐቲ ዋንሳ ግዝ አሲ የዛ። <verse eid="JHN 1:6"/><verse number="7" style="v" sid="JHN 1:7"/>አሲ ኡባይ ኤ ባጋር ፖአ አማኖድ ጋርክ ኤ ፖኦስ ማርካ ማቂ የኤዛ። <verse eid="JHN 1:7"/><verse number="8" style="v" sid="JHN 1:8"/>ኤ ፖኦ ባጋ ማርካቶዳይስ የኤዛፕ አትን ፋ ኡባስ ፖኦ ባያ። <verse eid="JHN 1:8"/><verse number="9" style="v" sid="JHN 1:9"/>አስ ኡባስ ፖእስዛ ቱማ ፖአይ አላመ ይእዛ።<verse eid="JHN 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 1:10"/>ኤዝካ አላመል የዛ። አላማይካ መንቴዛይ ኤ ባጋራ፥ ዝን አላማይካ ኤዛ ኤረካያ። <verse eid="JHN 1:10"/><verse number="11" style="v" sid="JHN 1:11"/>ኤ ፋስታይኮ የኤዛ፥ ዝን ኤስታይ ኤዛ ኤከካያ። <verse eid="JHN 1:11"/><verse number="12" style="v" sid="JHN 1:12"/>ዝን ኤ ፋና ኤኬዝታይስንኔ ኤ ሱን አማኔዝታይስ ጾስ ናእታ ማቃድ ጋርክ ማዉተ እንጌዛ። <verse eid="JHN 1:12"/><verse number="13" style="v" sid="JHN 1:13"/>ኡንትካ ጾሳፕ የልንቴዛፕ አትን አሲ የልንትዛ ዎጋይ ጋርክ ራ ሸነፕ ዎይ አሾፐኔ ሱ ሸነር የልንተካያ።<verse eid="JHN 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 1:14"/>ቃላይ አስ ማቄዛ፤ አ ኬሄትኔ ቱማት ኩሚ ኑ ጋንጨ የዜዛ። ኤ ፋ አዳይስ ፐቲ ናአ ማቂ ኤኬዝ ኤ ቦንቻ ኑ በኤዛ።<verse eid="JHN 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 1:15"/>ዋንሳ ኤ ባጋ ማርካቴዛ። ፋ ቃላ ቅ ኡዲ፥ «ታኒ፥ ‹ታፕ ጉየር ይእዛይ ታፕ ቲን የዛ ግሾስ ታፕ ኣዛ› ግ ማርካቴዛይ Ꮊያ» ዬጌዛ።<verse eid="JHN 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 1:16"/>ኑኒ ኡቢታይ ኤ አ ኬሄት ኩንይፕ አንጆል አፋ አንጆ ኤኬዛ። <verse eid="JHN 1:16"/><verse number="17" style="v" sid="JHN 1:17"/>ጾሳይ ህገ ሙሰ ባጋር እንጌዛ፥ ዝን አ ኬሄትኔ ቱማት የሱሳ ክርስቶሳ ባጋር የኤዛ። <verse eid="JHN 1:17"/><verse number="18" style="v" sid="JHN 1:18"/>ጾሳ ኣፈር በኤዝ አስ ኦንካ ባያ፤ ፋ አዳይ ላንቀ የዝ ፐቲ ናአይ ኣዳ ኤ ፋ ኡባስ ጾስ ማቄዛይ ኤዛ ቆንጨ ኦዴዛ።<verse eid="JHN 1:18"/></para>
  <para style="s1">ጻማቅዛ ዋንሳ ማርከት</para>
  <para style="r">(<ref loc="MAT 3:1-12">ማቶ. 3:1-12</ref>፤ <ref loc="MRK 1:1-8">ማር. 1:1-8</ref>፤ <ref loc="LUK 3:1-8">ሉቃ. 3:1-8</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19"/>የሩሳላመ የዝ አይሁድታይ ሀላቅታይ፥ ቄስታይኔ ለዊታይ፥ «ኔኒ ኦኖ?» ግ፥ ዋንሳ ኦይጮድ ጋርክ ኤዝኮ ኪትን፥ ዋንሳ ኡንትስ ማርካቴዝ ማርካትይ Ꮊያ።<verse eid="JHN 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 1:20"/>ዋንሳ፥ «ታኒ ክርስቶሳ ባያ» ዬጊ፥ ምልጽ ኡዲ ማርካቴዛፕ አትን ካድበኤካያ።<verse eid="JHN 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 1:21"/>ኡንትካ፥ «የዝን፥ ነ ኦኖ? ነ ኤላሳኔ?» ዬጊ ኦይጬዛ።</para>
  <para style="p" vid="JHN 1:21">ዋንሳ ማሂ፥ «ታ ኤላሳ ባያ» ዬጌዛ።</para>
  <para style="p" vid="JHN 1:21">ማ ኡንቲ፥ «ነ የኦድ ግንትንቴዝ ናባይ ነናኔ?» ዬጊ ኦይጬዛ።</para>
  <para style="p" vid="JHN 1:21">ዋንሳ፥ «ዋኣ» ግ ማሄዛ።<verse eid="JHN 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 1:22"/>የዝን፥ «ነ ኦኖ? ኑኒ ኑና ኪቴዝታይስ ኦዶድ ጋርክ ነ ነና ኦና ጌ?» ዬጌዛ።<verse eid="JHN 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 1:23"/>ዋንሳ ማሂ፥ «ናበ እሳያሳ ጌዛይ ጋርክ፥</para>
  <para style="q1" vid="JHN 1:23">«‹ጎዳይስ ኦገ ሉልሶይታ!›</para>
  <para style="q2" vid="JHN 1:23">ግ ሊዦ ደምባ ኡክዛ አይ ቃላይ ታና»</para>
  <para style="m" vid="JHN 1:23">ዬጌዛ።<verse eid="JHN 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24"/>ማ ፈርሳወ አስታይ ኪቴዝ አሳይ <verse eid="JHN 1:24"/><verse number="25" style="v" sid="JHN 1:25"/>ዋንሳኮ፥ «ነ ክርስቶሳ ዎይ ኤላሳ ዎይ ናበ ባ እጽኮ፥ የዝን አብስ ጻማቄ?» ግ ኦይጬዛ።<verse eid="JHN 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 1:26"/>ዋንሳ ማሂ፥ «ታኒ ሃር ጻማቅዛ፥ ዝን ይ ኤሮዋ አሲ ይ ጋንጨ ኤቄዛ። <verse eid="JHN 1:26"/><verse number="27" style="v" sid="JHN 1:27"/>ኤ ታፕ ጉየር ይእዛ። ታኒ ሀራ አቶዝን ኤ ጫማ ዎዶሮ ብሎዳይስ ቤዞያ» ዬጌዛ።<verse eid="JHN 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 1:28"/>የይ ኡባይ ዮርዳኖሳ ቦርካፕ ሰኮ ፕኖ፥ ብታና ካታማ፥ ዋንሳ ጻማቅዛ አቃይድ ሀኔዛ።<verse eid="JHN 1:28"/></para>
  <para style="s1">ጾስ ዱረ</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29"/>ዋንሳ ዎንት ጋላስ የሱሳ ኤኮ የኦዳር ብኢ፥ «አላመ ናጋራ ባራንችዛ ጾስ ዱራይ Ꮊያ! <verse eid="JHN 1:29"/><verse number="30" style="v" sid="JHN 1:30"/>ታኒ፥ ‹ታፕ ጉየር ፐቲ አሲ የኦዳ። ኤ ታፕ ቲን የዛ ግሾስ ታፕ ኣዛ ግ ኦዴዛይ Ꮊያ። <verse eid="JHN 1:30"/><verse number="31" style="v" sid="JHN 1:31"/>ኤ ኦናዛኮ ታኒ ኤሮያ። ዝን እስሬለ አሳይስ ኤዛ ቆንጨ ከሶዳይስ ሃር ጻማቅታር የኤዛ» ዬጌዛ።<verse eid="JHN 1:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 1:32"/>ዋንሳ Ꮊይ ጋርክ ዬጊ ማርካቴዛ፦ «ጌሻ አያናይ ሳሎፕ ሆለ ጋርክ ዎዳራኔ ኤዛል ሸምፖዳር ታ በኤዛ። <verse eid="JHN 1:32"/><verse number="33" style="v" sid="JHN 1:33"/>የይ ሀኖዳይፕ ቲና ታ ኤዛ ኤሮያ። ዝን ሃር ጻማቆዳይስ ታና ኪቴዝ ጾሳይ፥ ‹ጌሻ አያናይ ዎ ኤዛር የዝን ኔኒ በአዳይኔ ጌሻ አያናር ጻማቆዳይ ኤዛ› ዬጊ ታስ ኦዴዛ። <verse eid="JHN 1:33"/><verse number="34" style="v" sid="JHN 1:34"/>ታ የይ ሀኖዳር ብኢ፥ ኤ ጾስ ናአ ማቄዛና ማርካትዛ» ዬጌዛ።<verse eid="JHN 1:34"/></para>
  <para style="s1">የሱሳ ካሌዝ ቲና ታማርታ</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35"/>ማ ዎንት ጋላስ ዋንሳ ፋ ታማርታይፕ ናምእታይር ዎላ ኤቄዛ። <verse eid="JHN 1:35"/><verse number="36" style="v" sid="JHN 1:36"/>የሱሳ ኣዳር ዋንሳ ብኢ፥ «ጾስ ዱራይ Ꮊይሸ!» ዬጌዛ።<verse eid="JHN 1:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37"/>ናምኢ ዋንሳ ታማርታይ ዋንሳ ግዛና ስኢ የሱሳና ካሌዛ። <verse eid="JHN 1:37"/><verse number="38" style="v" sid="JHN 1:38"/>የሱሳ ፋና ካልዝታ ጉየ ሽርንቲ ብኢ፥ «ይ አብ ኮይኔ?» ዬጊ ኦይጬዛ።</para>
  <para style="p" vid="JHN 1:38">ኡንቲ ማቂ፥ «አስታማራዮ፥ ነ አባ የሳዴ?» ዬጌዛ።<verse eid="JHN 1:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 1:39"/>የሱሳ ኡንትኮ፥ «Ꮊና ይኢ ቦኦይታ» ዬጌዛ። ኡንቲ Ꮊንጊ ኤ የዛ አቃ በኤዛ። የ ጋላስ ሳአይ ታጲ ሳተ ሄራ ማቅዝ ግሾስ ኤ ላንቀ ፔዤዛ።<verse eid="JHN 1:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40"/>ዋንሳ ጌዛና ስኢ፥ የሱሳና ካሌዝ ናምኢ ታማርታይፕ ፐታይ፥ ስሞን ጵጽሮሳ እሻ እንድራሰ። <verse eid="JHN 1:40"/><verse number="41" style="v" sid="JHN 1:41"/>እንድራሰ ቲና ፋ እሻ ስሞናር ዎልሄሊ፥ «ኑኒ ክርስቶሳ ደንጌዛ» ዬጌዛ። <verse eid="JHN 1:41"/><verse number="42" style="v" sid="JHN 1:42"/>እንድራሰ ስሞና የሱሳኮ ከኤዛ።</para>
  <para style="p" vid="JHN 1:42">የሱሳ ስሞና ብኢ፥ «ኔኒ ዮና ናአ ስሞና፤ ነ ሱንይ ኬፋ ግ ጼግንቶዳ» ዬጌዛ።<verse eid="JHN 1:42"/></para>
  <para style="s1">የሱሳ ፍልጶሳራኔ ናትናኤላራ ጼጌዛ</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43"/>ዎንት ጋላስ የሱሳ ጋልላ ቢታ Ꮊማዳይስ ሙርቴዛ። ኤ ፍልጶሳና ደንጊ፥ «ታና ካሎባ!» ዬጌዛ። <verse eid="JHN 1:43"/><verse number="44" style="v" sid="JHN 1:44"/>ፍልጶሳ፥ እንድራሰኔ ጵጽሮሳ የዜዝ ቤተሳይዳ ግዝ ካታማፕ የኤዝ አሲ።<verse eid="JHN 1:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 1:45"/>ፍልጶሳ ናትናኤላና ሄሊ፥ «ሙሰ ህገ ማጻፋይ ጋንጨ፥ ማ ናብታይካ ኤባዝ ጻፌዝ ዮሴፋ ናአ ናዝረተ የሱሳ ኑ ደንጌዛ» ዬጌዛ።<verse eid="JHN 1:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 1:46"/>ናትናኤላ ማሂ፥ «ናዝረተ ካታማፕ ሎኦ ባዝ ከዞዳይስ ዳንዳእኔ?» ዬጌዛ።</para>
  <para style="p" vid="JHN 1:46">ፍልጶሳ፥ «ይኢ ቦኦባ» ዬጌዛ።<verse eid="JHN 1:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 1:47"/>የሱሳ ናትናኤላ ፋኮ ይእዛና ብኢ፥ «ገነ ባ ቱማ እስሬለ አስ Ꮊያ!» ዬጌዛ።<verse eid="JHN 1:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 1:48"/>ናትናኤላ የሱሳኮ፥ «ኔኒ ታና አባ ኤሬ?» ዬጌዛ።</para>
  <para style="p" vid="JHN 1:48">የሱሳ ማሂ፥ «ፍልጶሳ ነና ጼጎዳይፕ ቲና፥ ኔኒ ባላሰ ም ኦሞ የዝን ታኒ ነና በኤዛ» ዬጌዛ።<verse eid="JHN 1:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 1:49"/>ናትናኤላ ማሂ፥ «አስታማራዮ፥ ኔኒ ጾስ ናአ! ኔኒ እስሬለ ካተ!» ዬጌዛ።<verse eid="JHN 1:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 1:50"/>የሱሳ ኤኮ፥ «ታ ነና ባላሰ ም ኦሞ በኤዛ ጌዝ ግሾስ ነ አማንኔ? ኔኒ Ꮊይፕ ኣባዝ በአዳ!» ዬጌዛ። <verse eid="JHN 1:50"/><verse number="51" style="v" sid="JHN 1:51"/>ማ የሱሳ፥ «ታኒ ይንትስ ቱሮ ኦድዛ፤ ሳሎ ዶይንትን፥ ጾስ ኪታንችታይ አስ ናአ አፋ ከዞዳራኔ ዎዳር ይ በአዳ» ዬጌዛ።<verse eid="JHN 1:51"/></para>
  <chapter eid="JHN 1"/>
  <chapter number="2" style="c" sid="JHN 2"/>
  <para style="s1">የሱሳ ቦስ አቆ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1"/>ሃይን ጋላስ ጋልላ ቢታ ቃና ካታማ ቦስ የዛ። የሱሳ እንዳት የ ቦሳይድ የዛ። <verse eid="JHN 2:1"/><verse number="2" style="v" sid="JHN 2:2"/>የሱሳካ ፋ ታማርታይር ዎላ የ ቦሳይድ ጼግንቴዛ። <verse eid="JHN 2:2"/><verse number="3" style="v" sid="JHN 2:3"/>ዎይነ ኡሺ ዉርን፥ የሱሳ እንዳት የሱሳኮ፥ «ኡንትስ ዎይነ ኡሺ ዉሬዛ» ዬጌዛ።<verse eid="JHN 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 2:4"/>የሱሳ ማሂ፥ «ታ እንዳቴ፥ ነ Ꮊይዳ ገልፐ? ታ ዎዳይ ሀጋ ሄለካያ» ዬጌዛ።<verse eid="JHN 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 2:5"/>የሱሳ እንዳት ኦሶ አስታይኮ፥ «ኤ ይንትስ ኦዴዝባዝ አባባዝ ማቅኮካ ኦይታ» ዬጌዛ።<verse eid="JHN 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6"/>አይሁድታይ ፋ ሻግሸ ዎጋስ ማድንትዛ ኡሱፑን ሹች ጋንታይ የ አቃይድ የዛ። ፐቲ ፐቲ ጋናይ ናምኢ ዎይ ሀይ ጹጋ አይክዛ። <verse eid="JHN 2:6"/><verse number="7" style="v" sid="JHN 2:7"/>የሱሳ ኦሶ አስታይኮ፥ «ጋንታይድ ሃ ኩንይታ» ዬጌዛ። ኡንቲ ጋንታይስ ዶና ሄሎዳይስ ሃ ኩንዛ። <verse eid="JHN 2:7"/><verse number="8" style="v" sid="JHN 2:8"/>የሱሳ ኡንትኮ፥ «Ꮊት ዱቂ ቦስ ጎዳይስ እንጎይታ» ዬጌዛ። ኡንቲ ኤዝስ እንጌዛ።<verse eid="JHN 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 2:9"/>ቦስ ጎዳይስ ዎይነ ኡሽኮ ላምንቴዝ ሃ ጋንጺ ብኢ አናፕ የኤዛኮ ኤረካ፥ ዝን ሃ ኩንዝ ኦሶ አስታይ ኤርዛ። ቦሳ ጎዳይ ማቾ ኤክዛና ጼጊ፥ <verse eid="JHN 2:9"/><verse number="10" style="v" sid="JHN 2:10"/>«ኦንካ ሎኦ ዎይነ ኡሺ አሳ ቲናቲ ኡሽዛ። የይተ አሳይ ኡዢ አሌዛይፕ ጉየ ሃጾ ኡሽ እንግዛ። ዝን ኔኒ ሎኦ ዎይነ ኡሺ Ꮊኖ ሄሎዳይስ ጋዴዛ» ዬጌዛ።<verse eid="JHN 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 2:11"/>የሱሳ Ꮊ ቲና ማላታ ጋልላ ቢታ ቃና ካታማ ኦዛ፤ የይዳ ፋ ቦንቻ ቤዜዛ። ኤ ታማርታይ ኤዛ አማኔዛ።<verse eid="JHN 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 2:12"/>የይፕ ጉየ፥ የሱሳ ፋ እንዳትራ፥ ፋ እሽታይራኔ ፋ ታማርታይር ዎላ ቅፍርናሆመ ካታማ Ꮊንጊ ጽቃ ጋላስ ጋምኤዛ።<verse eid="JHN 2:12"/></para>
  <para style="s1">የሱሳ ጾስ ካራፕ ዛልእዝታና ከሴዛ</para>
  <para style="r">(<ref loc="MAT 21:12-13">ማቶ. 21:12-13</ref>፤ <ref loc="MRK 11:15-17">ማር. 11:15-17</ref>፤ <ref loc="LUK 19:45-46">ሉቃ. 19:45-46</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13"/>አይሁድታይ ቦንችዛ ፓዝቃ ባላይ ኡክን የሱሳ የሩሳላመ Ꮊንጌዛ። <verse eid="JHN 2:13"/><verse number="14" style="v" sid="JHN 2:14"/>Ꮊንጊ ጾስ ካራ ጋንጨ ገማትታ፥ ሀርታ፥ ዱርታኔ ሆልታ ባይዝዝታኔ ፋ ኦይደል በቲ ሚሸ ላምዝታ ደንጌዛ። <verse eid="JHN 2:14"/><verse number="15" style="v" sid="JHN 2:15"/>ኤ ጹርቃፈር ኡብታ ኡ መህታይር ጾስ ካራፕ ባይኢ ባለ ከሴዛ። ሚሸ ላምዝታይ ጻርጴዝታካ ሽሪ ኦሊ ኡ ሚሻ ላሌዛ። <verse eid="JHN 2:15"/><verse number="16" style="v" sid="JHN 2:16"/>ሆለ ባይዝዝታና፥ «Ꮊ ሆልታ Ꮊይፕ ከሶይታ፤ ታ አዳይ ካራ ጋበ ማህፓተ» ዬጌዛ።<verse eid="JHN 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 2:17"/>ኤ ታማርታይ ጌሻ ማጻፋይድ፥ «ታኒ ነ ካራይስ ምጭንትዛ ምሻይ ታና ታማ ጋርክ ምችዛ ግዛ» ግንትንቲ ጻፍንቴዛና አካኬዛ።<verse eid="JHN 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18"/>የይፕ ጉየ፥ አይሁድታይ ማሂ፥ «ነ Ꮊያ ኦዳይስ ኔስ ማዉተ የዛይስ ኑና አባ ማላታ ኦ ቤዞዴ?» ዬጌዛ።<verse eid="JHN 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 2:19"/>የሱሳካ፥ «Ꮊ ጾስ ካራ ላሎይታ፤ ታኒ ሀይ ጋላሳር ማሂ ደንዳ» ዬጌዛ።<verse eid="JHN 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 2:20"/>ማካ አይሁድታይ፥ «Ꮊ ጾሳ ካራ ኬጾዳይስ ኦይታማነ ኡሱፑን ላይ ኤኬዛ፥ ዝን ኔኒ ሀይ ጋላሳር ደንደ?» ዬጌዛ።<verse eid="JHN 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 2:21"/>ዝን የሱሳ ኦድዛ ጾሳ ካራይ ፋ አሳተባጋ። <verse eid="JHN 2:21"/><verse number="22" style="v" sid="JHN 2:22"/>የይ ግሾስ፥ የሱሳ Ꮊይቆፕ ደንዴዛይፕ ጉየ ኤ ታማርታይ ኤ የያ ጌዛና አካኬዛኔ ጌሻ ማጻፋይድ ጻፍንተዛኔ የሱሳ ኦዴዛና አማኔዛ።<verse eid="JHN 2:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23"/>የሱሳ ፓዝቃ ቦንችዛ ጋላስ የሩሳላመ የዝን፥ ኤ ኦዝ ማልታ ብኢ ጋመ አሳይ ኤዛ አማኔዛ። <verse eid="JHN 2:23"/><verse number="24" style="v" sid="JHN 2:24"/>ዝን የሱሳ አስ ኡባ ኤርዛ ግሾስ ኡንታን አማነካያ። <verse eid="JHN 2:24"/><verse number="25" style="v" sid="JHN 2:25"/>አስ ዎዝና የዛ ባዝ ኤ ፋ ኡባስ ኤርዛ ግሾስ አስባዝ ኦንካ ኤዝስ ኦዶዳይ ጋርክ ኮየካያ።<verse eid="JHN 2:25"/></para>
  <chapter eid="JHN 2"/>
  <chapter number="3" style="c" sid="JHN 3"/>
  <para style="s1">የሱሳራኔ ንቆድሞሳራ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1"/>ፈርሳውታይ ባጋፕ ማቄዝ፥ አይሁድታይ ሀላቃይ፥ ንቆድሞሳ ግዝ ፐቲ አይ የዛ። <verse eid="JHN 3:1"/><verse number="2" style="v" sid="JHN 3:2"/>ንቆድሞሳ ቃማ የሱሳኮ ይኢ፥ «አስታማራዮ፥ ኔኒ ጾሳይ ኪቴዝ አስታማረ ማቄዛና ኑ ኤርዛ። አብስ ጊኮ፥ ጾሳይ ኤዛር የዛም እጽኮ Ꮊ ነ ኦዛ ማልታ ኦዳይስ ዳንዳእዛ አሲ ባያ» ዬጌዛ።<verse eid="JHN 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 3:3"/>የሱሳ ማሂ፥ «ታኒ ኔስ ቱሮ ኦድዛ፤ ኦንካ ማቂ የልንታም እጽኮ ጾስ ካተት በአዳይስ ዳንዳኦያ» ዬጌዛ።<verse eid="JHN 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 3:4"/>ንቆድሞሳ፥ «አስ ጭሚ ዋይዚ ማቂ የልንቶዳይስ ዳንዳኤ? ፋ እንዳት ኡሎ ማቂ ገሊ ማሂ የልንቶዳይስ ዳንዳእኔ?» ዬጌዛ።<verse eid="JHN 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5"/>የሱሳ ማሂ፥ «ታኒ ኔስ ቱሮ ኦድዛ፤ ኦንካ ሃፐኔ ጌሻ አያናፕ የልንታም እጽኮ፥ ጾስ ካተት ገሎዳይስ ዳንዳኦያ። <verse eid="JHN 3:5"/><verse number="6" style="v" sid="JHN 3:6"/>አሾፕ የልንቴዛይ አሾ፤ አያናፕ የልንቴዛይ አያና። <verse eid="JHN 3:6"/><verse number="7" style="v" sid="JHN 3:7"/>ታኒ፥ ‹ይ ማቂ የልንቶዳይስ ቤዝዛ› ግ ይንትስ ኦዴዛይ ግሾስ ኔኒ ማላባዝ ጊፐ። <verse eid="JHN 3:7"/><verse number="8" style="v" sid="JHN 3:8"/>ጫርኮ ፋ ኮዤዝ ባጋ ጫርክዛ። ኔኒ ጊር ስእነፕ አትን አያይፕ ይእዛኮ ዎይ አያ Ꮊንግዛኮ ኤሮያ። አያናፕ የልንቴዝ ኡቢታይ የይ ጋርክ» ዬጌዛ።<verse eid="JHN 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9"/>የዝን ንቆድሞሳ፥ «የይ ዋይዚ ሀኖዳይስ ዳንዳኤ?» ዬጊ ኦይጬዛ።<verse eid="JHN 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 3:10"/>የሱሳ ማሂ፥ «ኔኒ እስሬልታይ አስታማረ ማቅታር Ꮊያ ኤሮሳ? <verse eid="JHN 3:10"/><verse number="11" style="v" sid="JHN 3:11"/>ታኒ ኔስ ቱሮ ኦድዛ፤ ኑ ኤርዛ ባዝ ኦድዛኔ በኤዝ ባዝ ማርካትዛ፥ ዝን ኑ ማርከት ይ ኤኮያ። <verse eid="JHN 3:11"/><verse number="12" style="v" sid="JHN 3:12"/>ታኒ ይንትስ ሳአባዝ ኦድን ይ አማኖዋባዝ ማቅኮ ሳሎባዝ ኦድን ዋይዚ አማኖዴ? <verse eid="JHN 3:12"/><verse number="13" style="v" sid="JHN 3:13"/>ሳሎፕ ዎዝ አስ ናአይፕ አትን ሳሎ ከዜዛይ ኦንካ ባያ፤ [ሳሎ የዝ አስ ናአይ ታና]» ዬጌዛ።<verse eid="JHN 3:13"/></para>
  <para style="p">
    <verse number="14-15" style="v" sid="JHN 3:14-15"/>ሙሰ ሊዦ ደንባል ናሰ ሾሽ ሶቴዛይ ጋርክ ኤዛ አማኔዝ ኡቢታይ መና ደኦ ኤኮዳይ ጋርክ አስ ናአይ ሶትንቶዳይስ ቤዝዛ።<note caller="-" style="x"><char style="xo" closed="false">3:14-15 </char><char style="xt" closed="false"><ref loc="NUM 21:9">ታይ. 21:9</ref></char></note><verse eid="JHN 3:14-15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 3:16"/>ጾሳይ Ꮊ አላመ ቃዝ ግሾስ ፋ ናአ ፐታ ኣ እንጎድ ሄሎዳይስ ጨር ዶሴዛይ ኤዛ አማንዛ ኡቢታይ መና ደኦ ላቶዳይ ጋርከፕ አትን ባማይ ጋርከ። <verse eid="JHN 3:16"/><verse number="17" style="v" sid="JHN 3:17"/>ጾሳይ ፋ ናአ Ꮊ አላመ ኪቴዛይ አላመ ፕርዶዳይስ ባዝን አላማ ኤ ባጋር አሾዳይሲ።<verse eid="JHN 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 3:18"/>ኤዛ አማንዛ ኦንካ ፕርድንታሚ፥ ዝን ኤዛ አማኖዋ ኦንካ ፐቲ ጾስ ናአ አማነካ ግሾስ Ꮊት ፕርድንቴዛ። <verse eid="JHN 3:18"/><verse number="19" style="v" sid="JHN 3:19"/>ፕርዳይካ Ꮊያ፤ ፖኦ፤ አላመል የኤዛ፥ ዝን አስ ኦሶ ኢታ ማቄዝ ግሾስ አሳይ ፖኦፕ ኣ ማ ዶሴዛ። <verse eid="JHN 3:19"/><verse number="20" style="v" sid="JHN 3:20"/>ኢታ ባዝ ኦዛ ኦንካ ፖኦ እጽዛ። አብስ ጊኮ፥ ፋ ኦሶ ፕ ኬዛማይ ጋርክ ፖኦኮ የኦያ። <verse eid="JHN 3:20"/><verse number="21" style="v" sid="JHN 3:21"/>ዝን ቱማ ኦዝ ኦንካ ጾሳይ ኪቴዛይ ጋርክ ኤ ኦዛና ፖኦ ቤዞዳይ ጋርክ ፖኦኮ ይእዛ።<verse eid="JHN 3:21"/></para>
  <para style="s1">የሱሳ ባጋ ማርካቴዝ ጻማቅዛ ዋንሳ</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22"/>የይፕ ጉየ፥ የሱሳ ፋ ታማርታይር ዎላ ይሁዳ ቢታ Ꮊንጌዛ። ኤዛይድ ጻማቅታር ኡንታር ጽቃ ዎደ ጋምኤዛ።<verse eid="JHN 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 3:23"/>ማ ዋንሳ ሳሌመ ላንቀ የዝ ሄኖነ ዬግዝ አቆ ጋመ ሃ የዛ ግሾስ አሳ ኤዛይድ ጻማቅዛ። አሳይካ የ አቃ Ꮊንጊ ጻማቅንትዛ። <verse eid="JHN 3:23"/><verse number="24" style="v" sid="JHN 3:24"/>የ ዎደ ዋንሳ ሀጋ አጭንተካያ።<verse eid="JHN 3:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 3:25"/>የይፕ ጉየ፥ ዋንሳ ታማርታይኔ አይሁደ አሳይ ሻግሸ ዎጋ ባጋ ፓላሜዛ። <verse eid="JHN 3:25"/><verse number="26" style="v" sid="JHN 3:26"/>ዋንሳ ታማርታይ ዋንሳኮ Ꮊንጊ፥ «አስታማራዮ፥ ዮርዳኖሳ ቦርካፕ ሰኮ ፕኖ ኔር የዛይ፥ ኔኒ ኤባጋ ማርካቴዛይ፥ የዛኮ ጻማቅዛ። አሳይ ኡቢታይካ ኤዝክ Ꮊንግዛ» ዬጌዛ።<verse eid="JHN 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 3:27"/>ዋንሳ ማሂ፥ «ጾሳይ እንገካ አሲ አባባዝካ ኤኮዳይስ ዳንዳኦያ። <verse eid="JHN 3:27"/><verse number="28" style="v" sid="JHN 3:28"/>‹ታኒ ክርስቶሳ ባያ፥ ዝን ኤፕ ቲና ኪትንቴዛ› ማቄዝ ግሾ ይ፥ ይ ኡባስ ታስ ማርካ። <verse eid="JHN 3:28"/><verse number="29" style="v" sid="JHN 3:29"/>ገሎስ ጊጌዛና ኤኮዳይስ ጊጌዝ አይሲ። ኤክዛይስ ላዛንይ ካለ ኤቂ ኤ ግዛ ስኤዝ ዎደ ሎእ ኡፋይትዛ። የይ ግሾስ፥ Ꮊይ ታ ኡፋይሳይ ፖልንቴዛ። <verse eid="JHN 3:29"/><verse number="30" style="v" sid="JHN 3:30"/>ኤ ግታቶዳይስ ታኒ ጽቆዳይስ ቤዝዛ» ዬጌዛ።<verse eid="JHN 3:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31"/>አፋፕ ይእዛይ ኡባይፕ ኣ። ሳአፕ በንቴዛይ ሳአባዝ። ኤ ሳአባዝ ኦድዛ። ሳሎፕ ይእዛይ ኡባይፕ አፋ። <verse eid="JHN 3:31"/><verse number="32" style="v" sid="JHN 3:32"/>ኤ ፋ በኤዝባዝኔ ስኤዝባዝ ማርካትዛ፥ ዝን ኤ ማርከት ኤክዛይ ባያ። <verse eid="JHN 3:32"/><verse number="33" style="v" sid="JHN 3:33"/>ኤ ማርከት ኤክዛ ኦንካ ጾሳይ ቱማ ማቅዛና ቤዝዛ። <verse eid="JHN 3:33"/><verse number="34" style="v" sid="JHN 3:34"/>ጾሳይ ፋ ጌሻ አያና ኤስ ማከካ እንግዝ ግሾስ ጾሳይ ኪቴዛይ ጾስ ቃላ ኦድዛ። <verse eid="JHN 3:34"/><verse number="35" style="v" sid="JHN 3:35"/>አዳይ ፋ ናአ ዶሲ ኡባ ባዝ ኤ ኩሻይድ ጋዴዛ። <verse eid="JHN 3:35"/><verse number="36" style="v" sid="JHN 3:36"/>ናአ አማንዛ አይስ መና ደኦ የዛ። ዝን ናአ አማኖዋ አይል አፋ ጾስ ካቺ የዛይፕ አትን ኤ ደኦ ደንጋሚ።<verse eid="JHN 3:36"/></para>
  <chapter eid="JHN 3"/>
  <chapter number="4" style="c" sid="JHN 4"/>
  <para style="s1">የሱሳራኔ ሳማረ አስቶ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1"/>የሱሳ ዋንሳስታይፕ ጋንግዛ ካልዝታ ፋኮ ሺሽዛኔ ጻማቅዛና ፈርሳውታይ ስኤዛ። <verse eid="JHN 4:1"/><verse number="2" style="v" sid="JHN 4:2"/>ማቅኮካ የሱሳ ታማርታይ ጻማቄነፕ አትን የሱሳ ኦናካ ጻማቀካያ። <verse eid="JHN 4:2"/><verse number="3" style="v" sid="JHN 4:3"/>የሱሳ አሳይ ኤባዝ ግዛ ስኢ ይሁዳፕ ደንዲ ጋልላ Ꮊንጌዛ። <verse eid="JHN 4:3"/><verse number="4" style="v" sid="JHN 4:4"/>ጋልላ Ꮊንግታር ሳማረራ አዳይ ኤዝስ አታምባዝ ማቄዛ።<verse eid="JHN 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 4:5"/>የይ ግሾስ፥ ያይቆባ ፋ ናአ ዮሴፋስ እንጌዝ ጋደ ላንቀ የዝ ስካረ ግዝ ሳማረ ካታማ Ꮊንጌዛ። <verse eid="JHN 4:5"/><verse number="6" style="v" sid="JHN 4:6"/>የ አቃይድ ያይቆባስ ሃ ኦላ የዛ። የሱሳ የታር ዳቡሪ የ ሃ ኦላቲ ላንቀ በቴዛ። የ ዎደ ሳአይ ኡሱፑን ሳተ ሄራ።<verse eid="JHN 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 4:7"/>ፐቲ ሳማረ አስታ የ ኦላይፕ ሃ ትኮዳይስ የኤዛ። የሱሳ የ አስትኮ፥ «ታና ሃ ኡሾየ» ዬጌዛ። <verse eid="JHN 4:7"/><verse number="8" style="v" sid="JHN 4:8"/>የ ዎደ የሱሳ ታማርታይ ሚዝ ባዝ ዎንጎዳይስ ካታማ Ꮊንጌዛን።<verse eid="JHN 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 4:9"/>የ አስታ ማሂ፥ «ኔኒ አይሁደ አስ ማቅታር፥ ሳማረ ማች ማቅዝ ታና ዋይዚ ሃ ኡሾባ ጌ?» ዬጌዛ። የያ እዛ ጌዛይ አይሁድታይ ሳማርታይር ዎልሄሎዋ ግሾስ።<verse eid="JHN 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 4:10"/>የሱሳ ማሂ፥ «ኔኒ ጾስ እሞታኔ ሃ ታና ኡሾየ ግዛይ ኦናዛኮ ነ ኤሬዛኮ ኤዛ ነ ዎሶዳዝን፤ ኤዝካ ኔስ ደኦ እንግዛ ሃ እማዳዝን» ዬጌዛ።<verse eid="JHN 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 4:11"/>የ አስታ ማሂ፥ «ጎዳዮ፥ ኔስ ዱቅዛባዝ ባያ፤ ኦላይካ ጪሞ። የዝን፥ ደኦ እንግዝ ሃ ነ አናፕ ደንጎዴ? <verse eid="JHN 4:11"/><verse number="12" style="v" sid="JHN 4:12"/>ኑስ Ꮊ ሃ ኦላ እንጌዝ ኑ አዳይ ያይቆባፕ ኔኒ አኔ? ኤዝኔ፥ ኤ ናእታይኔ ኤ መህታይ Ꮊ ኦላይፕ ኡዤዛ» ዬጌዛ።<verse eid="JHN 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 4:13"/>የሱሳ፥ «Ꮊ ሃይፕ ኡዤዝ ኦንካ ማቂ ሳምንቶዳ። <verse eid="JHN 4:13"/><verse number="14" style="v" sid="JHN 4:14"/>ዝን ታኒ እንጎድ ሃ ኡዥዝ ኦንካ ኡባራካ ሳምንታሚ። ታኒ እማድ ሃይ ኤ ጋንጨ መናስ ደኦ እንግዝ ጎግዝ ፑልቶ ማቃዳ» ዬጌዛ።<verse eid="JHN 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 4:15"/>የ አስታ ማሂ፥ «ጎዳዮ፥ ታኒ ሳምንታማይ ጋርከኔ ሃ ትኮዳይስ Ꮊ አቃ የኣማይ ጋርክ ታስ የ ሃ እንጎባ» ዬጌዛ።<verse eid="JHN 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 4:16"/>የሱሳ እዝኮ፥ «Ꮊንጊ ነ አዝና ጼጊ የኦባ» ዬጌዛ።<verse eid="JHN 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 4:17"/>የ አስታ ማሂ፥ «ታስ አዝኒ ባያ» ዬጌዛ።</para>
  <para style="p" vid="JHN 4:17">የሱሳ እዝኮ፥ «ታስ ኣዝኒ ባያ ጉሳይድ ኔስ ቡታ ባያ። <verse eid="JHN 4:17"/><verse number="18" style="v" sid="JHN 4:18"/>ኔስ ቲን እችን አዝንታይ የዛ። Ꮊት ኔር የዛ አይ ነ አዝነ ባያ። ኔኒ Ꮊት ቱሮ ኦዴዛ» ዬጌዛ።<verse eid="JHN 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19"/>የ አስታ ማሂ፥ «ጎዳዮ፥ ኔኒ ናበ ማቅዛና ታኒ ኤሬዛ። <verse eid="JHN 4:19"/><verse number="20" style="v" sid="JHN 4:20"/>ኑ አድታይ Ꮊ ደራይል አፋ ጾስ ጎይኔዛ። ዝን ይ አይሁድታይ አሲ ጾስ ጎይኖዳይስ ቤዝዛ አቃይ የሩሳላመ ግዛ» ዬጌዛ።<verse eid="JHN 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 4:21"/>የሱሳ፥ «Ꮊን አስተ ታና አማኖባ፤ Ꮊ ደራይል አፋ ዎይ የሩሳላመ አዳይስ ጎይናም ዎደ የኦዳ። <verse eid="JHN 4:21"/><verse number="22" style="v" sid="JHN 4:22"/>ይ ሳማርታይ ይ ኤሮዋዛይስ ጎይንዛ። ዝን ኑኒ አቶት አይሁደፕ ይእዝ ግሾስ ኑ ኤርዛይስ ጎይንዛ። <verse eid="JHN 4:22"/><verse number="23" style="v" sid="JHN 4:23"/>ዝን አዳ ቱማር ጎይንዝታይ አያናራኔ ቱማር ጎይኖድ ዎደ ኡኬዛ፤ Ꮊተካ ሄሌዛ። ይኬ፥ አዳይ ኮይዛይ Ꮊይ ጋርክ ኦገር ጎይንዝታ። <verse eid="JHN 4:23"/><verse number="24" style="v" sid="JHN 4:24"/>ጾሳይ አያና፤ ኤዝስ ጎይንዝታይ አያናራኔ ቱማትር ጎይኖዳይስ ቤዝዛ» ዬጌዛ።<verse eid="JHN 4:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 4:25"/>የ አስታ ማሂ፥ «ክርስቶሳ ግንትዝ ‹ማሳይ› የኦዳና ታኒ ኤርዛ። ኤ ይኢ ኑስ ኡባ ባዝ ኦዶዳ» ዬጌዛ።<verse eid="JHN 4:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 4:26"/>የሱሳ፥ «Ꮊ ኔር ናሽዛይ ታኒ ኤዛ» ዬጌዛ።<verse eid="JHN 4:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27"/>ኡንቲ ናሾዳር፥ የሱሳ ታማርታይ Ꮊንጌዝ አቃይፕ ማቄዛ። የሱሳ ማቻር ዎላ ናሾዳር ኡ ብኢ ማላባዝ ጌዛ። ዝን አስትኮ፥ «አብ ኮዬ?» ዎይ የሱሳኮ፥ «እዝር አብስ ኦድንቴ?» ጌዛይ ኦንካ ባያ።<verse eid="JHN 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 4:28"/>የይፕ ጉየ፥ አስታ ፋ ሃ ኦታና አሺ ጉየ ካታማ Ꮊንጊ አስታይኮ፥ <verse eid="JHN 4:28"/><verse number="29" style="v" sid="JHN 4:29"/>«ታኒ ኦዝ ባዝ ኡባ ታስ ኦዴዝ አ በአዳይስ የይታ። ኤ ክርስቶሳ ማቃደሻ?» ዬጌዛ። <verse eid="JHN 4:29"/><verse number="30" style="v" sid="JHN 4:30"/>አሳይ ካታማፕ ከዚ የሱሳኮ Ꮊንጌዛ።<verse eid="JHN 4:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 4:31"/>የይ ሀኖዳር፥ ኤ ታማርታይ የሱሳኮ፥ «አስታማራዮ ጽቃ ሙንታ ሞየ» ዬጊ ዎሴዛ።<verse eid="JHN 4:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 4:32"/>ዝን ኤ፥ «ታስ ይ ኤሮዋ ካ ታ ሚዛይ የዛ» ዬጌዛ።<verse eid="JHN 4:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 4:33"/>የይ ግሾስ፥ ኤ ታማርታይ ዎል ጋንጨ፥ «ኤዝስ ሚዝባዝ አሲ ኮኦ አተና?» ዬጌዛ።<verse eid="JHN 4:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 4:34"/>የሱሳ ኡንትኮ፥ «ታ ሙንታይ ታና ኪቴዛይ ሸና ኦኔ ኤ ኦሶ ፖሎዳያ። <verse eid="JHN 4:34"/><verse number="35" style="v" sid="JHN 4:35"/>ይ፥ ‹ኦይዲ አጌናፕ ጉየ ካይ ማጾስ ሄሌዛ› ጎሳ? ዝን ታኒ ይንትስ ኦድዛ፤ ካይ ካጺ ሺሾስ ሄሌዛያ ሎእ ቦኦይታ። <verse eid="JHN 4:35"/><verse number="36" style="v" sid="JHN 4:36"/>ዘርዛይኔ ማጽዛይ ዎላ ኡፋይቶድ ጋርክ ማጽዛይ ዳሞዘ ኤክዛ ማ ካካ መና ደኦስ ሺሽዛ። <verse eid="JHN 4:36"/><verse number="37" style="v" sid="JHN 4:37"/>ይኬ፥ ‹ፐታይ ዘርዛ፤ Ꮊንካይ ማ ማጽዛ› ግዝ ኦዳይ ቱማ። <verse eid="JHN 4:37"/><verse number="38" style="v" sid="JHN 4:38"/>ይንቲ ዳቡረካዛና ሺሾዳይ ጋርክ ታኒ ይንታን ኪቴዛ። Ꮊንክታይ ኦ ዳቡሬዝ አቆ ገሊ ይ ኡ ዳቡርስ አፋ ኤኬዝታ» ዬጌዛ።<verse eid="JHN 4:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39"/>የ አስታ፥ «ኤ፥ ታኒ ኦዝ ኡባ ባዝ ኦዴዛ» ግ ማርካቴዝ ግሾስ የ ካታማ የዝ ሳማረ አሳይፕ ጋምታይ የሱሳ አማኔዛ። <verse eid="JHN 4:39"/><verse number="40" style="v" sid="JHN 4:40"/>ሳማረ አሳይ የሱሳኮ ይኢ፥ ፋ ካለ ጋምኦዳይ ጋርክ የሱሳ ዎስን ኤ ኤዛይድ ናምኢ ጋላስ በቴዛ።<verse eid="JHN 4:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 4:41"/>ኤ ኦድዛ ቃላይ ግሾስ ቲናሳይፕ ጋመ አሳይ አማኔዛ። <verse eid="JHN 4:41"/><verse number="42" style="v" sid="JHN 4:42"/>ማ ኡንቲ አስትኮ፥ «Ꮊት ኑ አማንዛይ ኑ ኡባስ ኤ ግዛ ስኤዝ ግሾሳፕ አትን ኔኒ ማርካቴዝ ግሾስ ባያ። ማ ኤ ቱማ Ꮊ አላመ አሽዛ ማቅዛና ኑኒ ኤሬዛ» ዬጌዛ።<verse eid="JHN 4:42"/></para>
  <para style="s1">የሱሳ ፐቲ ሹማይ ናአ ፓዛ</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43"/>ናምኢ ጋላሳፕ ጉየ፥ የሱሳ የይፕ ከዚ ጋልላ ቢታ ቅቴዛ። <verse eid="JHN 4:43"/><verse number="44" style="v" sid="JHN 4:44"/>የሱሳ ፋ ኡባስ፥ «ናበ ፋ ቢታል ቦንችንቶያ» ዬጊ ቲናቲ ኦዴዛ። <verse eid="JHN 4:44"/><verse number="45" style="v" sid="JHN 4:45"/>የሱሳ ጋልላ ሄሌዝ ዎደ ጋልላ አሳይ ኤዛ ሞኬዛ። አብስ ጊኮ፥ ፓዝቃ ባለ ቦንችዛ ጋላስ ኡንቲ የሩሳላመ የዝ ግሾስ ኤ ኦዝ ባዝ ኡብታ በኤዛ።<verse eid="JHN 4:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46"/>የሱሳ ሃ ዎይነ ኡሽኮ ላሜዝ አቆ፥ ጋልላ የዝ ቃና ካታማ ቅቴዛ። ቅፍርናሆመ ካታይ ካራ ኦዝ ፐቲ ሹማይስ ናአይ ሀርግንቴዛ። <verse eid="JHN 4:46"/><verse number="47" style="v" sid="JHN 4:47"/>የሱሳ ይሁዳፕ ጋልላ የኤዛና የ ሹማይ ስኢ ኤዝኮ የኤዛ። Ꮊይቆዳይስ ኡኬዝ ፋ ናአ Ꮊንጊ ፓዳይ ጋርክ የሱሳና ዎሴዛ።<verse eid="JHN 4:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 4:48"/>የሱሳ ሹማይኮ፥ «ጾሳይ ኦዛ ማላባዝኔ ማላ በአምጽኮ ይ ኡባራ አማናም» ዬጌዛ።<verse eid="JHN 4:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 4:49"/>ሹማይ ማሂ፥ «ጎዳዮ፥ ታ ናአይ Ꮊይቀካ የዝን ታር የዬ» ዬጌዛ።<verse eid="JHN 4:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 4:50"/>የሱሳ፥ «ነ ካራ ቅቶባ፤ ነ ናአይ ፓጾዳ» ዬጌዛ።</para>
  <para style="p" vid="JHN 4:50">የ ሹማይ የሱሳ ጌዛና አማኒ ፋ ካራ Ꮊንጌዛ። <verse eid="JHN 4:50"/><verse number="51" style="v" sid="JHN 4:51"/>ኤ ፋ ካራ Ꮊማዳር ኤ አይልታይ ኤዝኮ ይእታር ኤዛ ኦገል ሄሊ፥ «ነ ናአይ ፓጼዛ» ጌዛ።<verse eid="JHN 4:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 4:52"/>ኤ አይልታ ፋ ናአይስ አፑን ሳተር ሎኤዛኮ ኦይጬዛ። ኡንቲ ማሂ፥ «ዝቅን ላፑን ሳተር ምሻይ አቴዛ» ዬጌዛ። <verse eid="JHN 4:52"/><verse number="53" style="v" sid="JHN 4:53"/>ናአይ አዳይ የሱሳ ፋኮ፥ «ነ ናአይ ፓጾዳ» ጌዛይ የ ሳተ ማቄዛና አካኬዛ። የይ ግሾስ፥ ኤዝኔ ኤ ካራ አስ ኡቢታይ አማኔዛ።<verse eid="JHN 4:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 4:54"/>የይ የሱሳ ይሁዳፕ ጋልላ ይኢ ኦዝ ናምእን ማላ።<verse eid="JHN 4:54"/></para>
  <chapter eid="JHN 4"/>
  <chapter number="5" style="c" sid="JHN 5"/>
  <para style="s1">የሱሳ ፐቲ ስላ አ ፓዛ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1"/>የይፕ ጉየ፥ የሱሳ አይሁድታይ ቦንችዛ ባላይስ የሩሳላመ Ꮊንጌዛ። <verse eid="JHN 5:1"/><verse number="2" style="v" sid="JHN 5:2"/>የሩሳላመ ዱርታይ ፐንገ ካለ እብራይስጸ ዶናር ቤተሳይዳ ግዝ ዴለ የዛ። የ ሃይ ላንቀ እችን ሸምፖ በስታይ የዛ። <verse eid="JHN 5:2"/><verse number="3" style="v" sid="JHN 5:3"/>[የይድ ሃይ ኤንኦዳና ናግዛ ጋመ ሀርግንቴዝታይ፥ ቶእታይ፥ ዎብታይኔ ጉንድታይ ዎይእዛ። <verse eid="JHN 5:3"/><verse number="4" style="v" sid="JHN 5:4"/>አብስ ጊኮ፥ ፐቲ ፐቲ ቶኬ ጎዳ ኪታንቻይ ሃ ዎ ኤንእስዛ። ሃይ ኤንኦዳር ቲን ገሌዝ አይ ፋና አይኬዝ አባ ሀርገፐካ ፓጽዛ።] <verse eid="JHN 5:4"/><verse number="5" style="v" sid="JHN 5:5"/>የ አቃይድ ሀስታማኔ ሆስፑን ላይ ሀርግንቴዝ ፐቲ አይ የዛ። <verse eid="JHN 5:5"/><verse number="6" style="v" sid="JHN 5:6"/>የሱሳ የ አ ብኢ፥ ማ ጋመ ዎደ ሀርግንቴዛና ኤሪ አይኮ፥ «ፓጾዳይስ ኮይኔ?» ዬጌዛ።<verse eid="JHN 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 5:7"/>ሀርግንቴዝ አይ ማቂ፥ «ጎዳዮ፥ ሃይ ኤንኦዳር ታና ሃይ ጋንጨ ኦልዛ አሲ ባያ። ታኒ ገሎድ ሀኖዳር ሀራይ ታፕ ቲናቲ ገልዛ» ዬጌዛ።<verse eid="JHN 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 5:8"/>የሱሳ ኤዝኮ፥ «ደንዲ ኤቆባ፤ ነ አርሳ ቶኪ ቅቶባ» ዬጌዛ። <verse eid="JHN 5:8"/><verse number="9" style="v" sid="JHN 5:9"/>አይ እዝር ኤልሲ ፓጼዛ፤ ፋ አርሳ ቶኪ ቅቴዛ።</para>
  <para style="p" vid="JHN 5:9">የይ ማላ ጋላሳር ሀኔዛ። <verse eid="JHN 5:9"/><verse number="10" style="v" sid="JHN 5:10"/>የይ ግሾስ፥ አይሁድታይ ፓጼዝ አይኮ፥ «Ꮊይኖ ሳአይ ማላ፤ ኔኒ ነ አርሳ ቶክዛይ ዎጋ ባያ» ዬጌዛ።<verse eid="JHN 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 5:11"/>ዝን አይ፥ «ታና ፓዛይ፥ ነ አርሳ ቶኪ ቅቶባ ጌዛ» ዬጊ ማሄዛ።<verse eid="JHN 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 5:12"/>ኡንቲ ኤዝኮ፥ «ነና፥ ነ አርሳ ቶኪ ቅቶባ ጌዛይ ኤ ኦኖ?» ዬጊ ኦይጬዛ።<verse eid="JHN 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 5:13"/>ዝን የሱሳ የ አቃይድ ጋመ አስ ጋንጨር ኤርሰካዛር ኣ ቅቴዝ ግሾስ አይ ፋና ፓዛይ ኦናዛኮ ኤሮያ። <verse eid="JHN 5:13"/><verse number="14" style="v" sid="JHN 5:14"/>የሱሳ ጉየፕ የ አ ጾስ ኬ ደንጊ፥ «Ꮊት፥ ኔኒ ፓጼዛ፤ Ꮊይፕ ኢታ ባዝ ነና ሄላማይ ጋርክ ማቂ ናጋራ ኦፐ» ዬጌዛ። <verse eid="JHN 5:14"/><verse number="15" style="v" sid="JHN 5:15"/>የይፕ ጉየ፥ አይ Ꮊንጊ ፋና ፓዛይ የሱሳ ማቄዛና አይሁድታይስ ኦዴዛ።<verse eid="JHN 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 5:16"/>የሱሳ የያ ማላ ጋላስ ኦዝ ግሾስ አይሁድታይ የሱሳና ባይእ አይኬዛ። <verse eid="JHN 5:16"/><verse number="17" style="v" sid="JHN 5:17"/>የሱሳ ማቂ፥ «ታ አዳይ ኡባ ዎደ ኦዛ፤ ታካ ኦዳይስ ቤዝዛ» ዬጌዛ።<verse eid="JHN 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 5:18"/>የሱሳ ማላ ቦንቼካ ግሾስ ኣዳ ባዝን ጾሳ ፋ አደ ግ ፋና ጾሳር ኡኩልሴዝ ግሾስ አይሁድታይ ኤዛ ዎዳይስ ቲናሳይፕ አ ኮይዛ።<verse eid="JHN 5:18"/></para>
  <para style="s1">ጾስ ናአይ ማዉተ</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19"/>የሱሳ ማሂ፥ «ታኒ ይንትስ ቱሮ ኦድዛ፤ ናአይ ፋ ኣዳስ አብካ ኦዳይስ ዳንዳኦያ። ኤ ፋ አዳይ ኦዳር በኤዛና አዳ ኦዛ። አዳይ ኦዛና ናአይካ ኦዛ። <verse eid="JHN 5:19"/><verse number="20" style="v" sid="JHN 5:20"/>አዳይ ፋ ናአ ቃዛ ግሾስ ኤ ኦዝ ኦ ኡባ ፋ ናአ ቤዝዛ። ይ ማላባዝ ጎዳይ ጋርክ ኤ Ꮊይፕ አዝ ኦሶ ፋ ናአ ቤዞዳ። <verse eid="JHN 5:20"/><verse number="21" style="v" sid="JHN 5:21"/>አዳይ Ꮊይቄዝታ Ꮊይቆፕ ደን ኡንትስ ደኦ እንግዛይ ጋርክ ናአይካ ፋ ኮይዝታይስ ደኦ እንግዛ። <verse eid="JHN 5:21"/><verse number="22" style="v" sid="JHN 5:22"/>አዳይ ናአይስ ፕርደ ማዉተ ኡባ እንጌዛፕ አትን ኤ ኦናካ ፕርዶያ። <verse eid="JHN 5:22"/><verse number="23" style="v" sid="JHN 5:23"/>አሳይ ኡቢታይ አዳ ቦንችዛይ ጋርክ ናአካ ቦንቾዳ። ናአ ቦንቾዋ ኦንካ ናአ ኪቴዝ አዳካ ቦንቾያ።<verse eid="JHN 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24"/>«ታኒ ይንትስ ቱሮ ኦድዛ፤ ታ ቃላ ስእዝታይኔ ታና አዛዜዛና አማንዛይ መና ደኦ የዛ። ኤ Ꮊይቆፕ ደኦ ፒንጌዝ ግሾስ ፕርድንታሚ። <verse eid="JHN 5:24"/><verse number="25" style="v" sid="JHN 5:25"/>ታኒ ይንትስ ቱሮ ኦድዛ፤ Ꮊይቄዝ አሳይ ጾስ ናአ ቃላ ስእዝ ዎደ የኦዳ፤ የይካ Ꮊተ። የ ቃላ ስእዛይ ደኦር የዞዳ። <verse eid="JHN 5:25"/><verse number="26" style="v" sid="JHN 5:26"/>አዳይስ ኤስ ደኦ የዛይ ጋርክ ናአይስካ ኤስ ደኦ የዞዳይ ጋርክ እንግንቴዛ። <verse eid="JHN 5:26"/><verse number="27" style="v" sid="JHN 5:27"/>አስ ናአ ማቅዝ ግሾስ አዳይ ናአይስ ፕርደ ማዉተ እንጌዛ።<verse eid="JHN 5:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 5:28"/>«ዱፎ የዝታይ ኤ ቃላ ስኢ ደንዶድ ዎደ የኦድ ግሾስ Ꮊያ ማላባዝ ጊፓተ። <verse eid="JHN 5:28"/><verse number="29" style="v" sid="JHN 5:29"/>ሎኦ ኦዝታይ ደኦር የዞዳይስ ማ ኢታ ኦዝታይ ፕርደ ኤኮዳይስ ዱፎፕ ደንዶዳ።<verse eid="JHN 5:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 5:30"/>«ታኒ ታ ማዉተር አባባዝካ ኦዳይስ ዳንዳኦያ። ጾሳይ ታስ ኦዴዛይ ጋርክ ፕርድዛ። ታኒ ታና ኪቴዛይ ኮይዝ ባዝ ኦዛፕ አትን ታ ኮይዝ ባዝ ኦዋ ግሾስ ታ ፕርዳይ ቱማ።<verse eid="JHN 5:30"/></para>
  <para style="s1">የሱሳስ ማርካቴዝ አስቶ</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 5:31"/>«ታኒ ታባዝ ማርካትኮ ታ ማርካትይ ቱማ ባያ። <verse eid="JHN 5:31"/><verse number="32" style="v" sid="JHN 5:32"/>ታ ባጋ ማርካትዛይ ሀራ የዛ፤ ኤ ታባዝ ማርካትዛይ ቱማ ማቅዛና ታኒ ኤርዛ።<verse eid="JHN 5:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 5:33"/>«ይ ዋንሳኮ አስ ኪትን ኤ ቱማስ ማርካቴዛ። <verse eid="JHN 5:33"/><verse number="34" style="v" sid="JHN 5:34"/>ታኒ የያ ይንትስ ኦድዛይ፥ ይ አቶድ ጋርክ ጌዛፕ አትን አስ ማርካት ታስ ኮሼዝ ግሾ ባያ። <verse eid="JHN 5:34"/><verse number="35" style="v" sid="JHN 5:35"/>ዋንሳ ሙቃዳ ጋርክ ኤጽታር ፖኤዛ። ይ ጽቃ ዎደስ ኤ ፖአይድ ኡፋይቴዛ።<verse eid="JHN 5:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 5:36"/>«ዝን ታስ ዋንሳፕ ኣዝ ማርካ የዛ። ታኒ ኦድ ጋርክ ታ አዳይ ታስ እንጌዝ ኦስታይ ታ ባጋ ማርካትዛ፤ አዳይ ታና አዛዜዛና ቤዝዛ።<verse eid="JHN 5:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 5:37"/>«ማ ታና ኪቴዝ አዳይ ፋ ኡባስ ታባዝ ማርካትዛ። ይ ኤ ቃላ ኡባራካ ስኤካ ዎይ ኤ ማላ ብእቤኤካያ። <verse eid="JHN 5:37"/><verse number="38" style="v" sid="JHN 5:38"/>ኤ አዛዜዛና ይ አማኖዋ ግሾስ ኤ ቃላይ ይ ዎዝና ጋንጨ ባያ።<verse eid="JHN 5:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 5:39"/>«ጌሻ ማጻፍታይፕ መና ደኦ ደማድባዝ ይንትስ ኣዝን ኡንታን ይ ፕላግዛ፤ ኡንቲ ታባዝ ማርካትዛ። <verse eid="JHN 5:39"/><verse number="40" style="v" sid="JHN 5:40"/>ዝን ይ ደኦ ደንጎዳይስ ታኮ የኦዳይስ ኮዮያ።<verse eid="JHN 5:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41"/>«አሳፕ ታኒ ቦንቾ ኮዮያ። <verse eid="JHN 5:41"/><verse number="42" style="v" sid="JHN 5:42"/>ዝን ታኒ ይ ዎዝና ጋንጨ ጾስስ ቃ ባዛ ኤርዛ። <verse eid="JHN 5:42"/><verse number="43" style="v" sid="JHN 5:43"/>ታኒ ታ አዳይ ማዉተር የኤዛ፥ ዝን ታና ሞከካያ። ሀራይ ፋ ማዉተር ይእዛ ዎደ ኤዛ ሞክዛ። <verse eid="JHN 5:43"/><verse number="44" style="v" sid="JHN 5:44"/>ይ ፐታይ ፐታይፕ ቦንቾ ኮይዝታይ፥ ፐቲ ጾሳፕ ይእዝ ጋላታ ኤኮዳይስ ኮዮዝታይ፥ ዋይዚ ታና አማኖዳይስ ዳንዳኤ?<verse eid="JHN 5:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 5:45"/>«ታኒ ታ አዳይ ቲና ይንታን ሞትዛባዝ ይንትስ ኣዝፐ። ይንታን ሞቶዳይ ይ ኡፋይሳር ናግዝ ሙሰ። <verse eid="JHN 5:45"/><verse number="46" style="v" sid="JHN 5:46"/>ይ ሙሰ አማኔዝ ባዝ ማቄዛኮ ኤ ታ ባጋ ጻፌዝ ግሾስ ታናካ አማኖዳዝን። <verse eid="JHN 5:46"/><verse number="47" style="v" sid="JHN 5:47"/>ዝን ይ ኤ ጻፌዛና አማናም እጽኮ ታ ቃላ ዋይዚ አማኖዴ?» ዬጌዛ።<verse eid="JHN 5:47"/></para>
  <chapter eid="JHN 5"/>
  <chapter number="6" style="c" sid="JHN 6"/>
  <para style="s1">የሱሳ እችን ሙኩሎ አስ ሙዜዛ</para>
  <para style="r">(<ref loc="MAT 14:13-21">ማቶ. 14:13-21</ref>፤ <ref loc="MRK 6:30-44">ማር. 6:30-44</ref>፤ <ref loc="LUK 9:10-17">ሉቃ. 9:10-17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1"/>የይፕ ጉየ፥ የሱሳ ጽብራዶሳ ግዝ ጋልላ አባፕ ሰኮ ፕኖ ፒንጌዛ። <verse eid="JHN 6:1"/><verse number="2" style="v" sid="JHN 6:2"/>ኤ ሀርግንቴዝታ ፓር ኦዝ ማላ በኤዝ ግሾስ ጋመ አሳይ ኤዛ ካሌዛ። <verse eid="JHN 6:2"/><verse number="3" style="v" sid="JHN 6:3"/>የሱሳ ደረል አፋ ከዚ፥ ኤዛይድ ፋ ታማርታይር ዎላ በቴዛ። <verse eid="JHN 6:3"/><verse number="4" style="v" sid="JHN 6:4"/>አይሁድታይ ቦንችዛ ፓዝቃ ባለ ጋላሳይ ሄሌዛ። <verse eid="JHN 6:4"/><verse number="5" style="v" sid="JHN 6:5"/>የሱሳ ጋመ አሳይ ፋኮ ይእዛና ብኢ ፍልጶሳኮ፥ «Ꮊ አሳ ኡብታ ሙዞዳይስ ግድዛ ካ አናፕ ዎማዴ?» ዬጌዛ። <verse eid="JHN 6:5"/><verse number="6" style="v" sid="JHN 6:6"/>ኤ የያ ፍልጶሳ ፋጮዳይስ ጌዛፕ አትን ኤ ፋ ኡባስ አብ ኦዳዛኮ ኤርዛ።<verse eid="JHN 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7"/>ፍልጶሳ ማሂ የሱሳኮ፥ «ሀራ አቶዝን፥ ኦማር ኦማር፥ ፐቲ ፐቲ ባ ሄልዳይስ፥ ናምኢ ጼት ዲናረር ሶሎ ዎንግኮካ ግዳሚ» ዬጌዛ።<verse eid="JHN 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 6:8"/>ማ የሱሳ ታማርታይፕ ፐታይ፥ ስሞን ጵጽሮሳ እሻይ እንድራሰ፥ <verse eid="JHN 6:8"/><verse number="9" style="v" sid="JHN 6:9"/>«እችን ባንጋ ሶሎራ ናምኢ ሞሎ አይኬዝ ፐቲ ናአይ Ꮊይዳ የዛ፥ ዝን Ꮊ አስ ኡባይስ የይ አብ ማዶዴ?» ዬጌዛ።<verse eid="JHN 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 6:10"/>የሱሳ ፋ ታማርታይኮ፥ «አሳ በትይታ» ዬጌዛ። የ አቃይድ ጋመ ማታ የዛ፤ አሳይ ኡቢታይ በቴዛ። ራ አስታይ ታይባይ እችን ሙኩሎ ማቃዳ። <verse eid="JHN 6:10"/><verse number="11" style="v" sid="JHN 6:11"/>የሱሳ ሶላ ኤኪ ጾስ ጋላቲ ማቂ ኤዛይድ በቴዝ አሳይስ ግሼዛ። ሞላካ ኤኪ Ꮊይ ጋርክ ኡዲ እንግን፥ አሳይ ፋ ኮዬዛይ ጋርክ ሜዛ። <verse eid="JHN 6:11"/><verse number="12" style="v" sid="JHN 6:12"/>ኡ ኡቢታይ ምዤዛይፕ ጉየ የሱሳ ፋ ታማርታይኮ፥ «ፐቲ ባዝካ ኢታም ጋርክ አቴዝ ጉፋ ሺሾይታ» ዬጌዛ። <verse eid="JHN 6:12"/><verse number="13" style="v" sid="JHN 6:13"/>የይ ግሾስ፥ ኡ ኡባ ሺሼዛ። አሳይ ሚን አቴዝ ባንጋ ሶሎ ጉፋ ሺሺ ታጶ ናምኢ ሌማተ ኩንዛ።<verse eid="JHN 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 6:14"/>አሳይ የሱሳ ኦዝ ማላ ብኢ «Ꮊይ ቱማ Ꮊ አላመ የኦድ ግንትንቴዝ ናበ» ዬጌዛ። <verse eid="JHN 6:14"/><verse number="15" style="v" sid="JHN 6:15"/>የሱሳ ኡ ኤዛ አይኪ ዎልቃር ካዉትሶዳይስ ቆፔዛና ኤሪ፥ ፋ ኣዳስ ደረል አፋ ማቂ ከዜዝ።<verse eid="JHN 6:15"/></para>
  <para style="s1">የሱሳ አባል አፋር የዛ</para>
  <para style="r">(<ref loc="MAT 14:22-33">ማቶ. 14:22-33</ref>፤ <ref loc="MRK 6:45-52">ማር. 6:45-52</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16"/>ሳአይ ኦማዳር የሱሳ ታማርታይ አባኮ ዎዛ። <verse eid="JHN 6:16"/><verse number="17" style="v" sid="JHN 6:17"/>ሳአይ ቃሜዝ ግሾስ የሱሳ ሀጋ ኡንትኮ የኤካ ግሾስ ኤ ታማርታይ ዎጎሎ ጋንጨ ገሊ አባ ፒንጊ ቅፍርናሆማ Ꮊማዳይስ ደንዴዛ። <verse eid="JHN 6:17"/><verse number="18" style="v" sid="JHN 6:18"/>ዎልቃማ ጫርኮ ጫርኬዝ ግሾስ አባይ ኤንእዛ። <verse eid="JHN 6:18"/><verse number="19" style="v" sid="JHN 6:19"/>እችን ዎይ ኡሱፑን ክሎ ምትረ ማቆዳይ ጋርክ ኡ አባ ፕ Ꮊንጌዛይፕ ጉየ የሱሳ አባል አፋር የታር ይእዛና ብኢ ያሽቴዛ። <verse eid="JHN 6:19"/><verse number="20" style="v" sid="JHN 6:20"/>ዝን ኤ፥ «ያሽትፋተ፥ ታናበ» ዬጌዛ። <verse eid="JHN 6:20"/><verse number="21" style="v" sid="JHN 6:21"/>ኡንቲ ኡፋይቲ ኤዛ ዎጎሎ ጋንጨ ገልሴዛ፤ እዝር ዎጎላይ ኡ Ꮊንግዛ አባ ጋጻ ሄሌዛ።<verse eid="JHN 6:21"/></para>
  <para style="s1">የሱሳ ደኦ ሶሎ</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22"/>ዎንት ጋላስ አባፕ ሰኮ ፕኖ አቴዝ ጋመ አሳይ ፐቲ ዎጎሎ አዳ የዛና በኤዝ ግሾስኔ የሱሳ ፋ ታማርታይር ዎጎሎ ጋንጨ ገሊ፥ ኡንታር Ꮊንጎዛኔ ኡ ፋ ኣዳስ Ꮊንጌዛና አካኬዛ። <verse eid="JHN 6:22"/><verse number="23" style="v" sid="JHN 6:23"/>ዝን ጽባራዶሳፕ ሀራ ዎጎልታይ የሱሳ ጾስ ጋላትን፥ አሳይ ሶሎ ሜዝ አቃ የኤዛ። <verse eid="JHN 6:23"/><verse number="24" style="v" sid="JHN 6:24"/>አሳይ የሱሳ ዎይ ኤ ታማርታይ ኤዛይድ ባዛና ብኢ፥ የሱሳ ኮዮዳይስ ዎጎልታይድ ገሊ ቅፍርናሆማ Ꮊንጌዛ።<verse eid="JHN 6:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25"/>አሳይ የሱሳ አባፕ ሰኮ ፕኖ ደንጌዝ ዎደ «አስታማራዮ፥ Ꮊይድ አይድ የኤኔ?» ዬጌዛ።<verse eid="JHN 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 6:26"/>የሱሳ ማሂ፥ «ታኒ ይንትስ ቱሮ ኦድዛ፤ ይ ታና ኮይዛይ ሶሎ ም ምዤዝ ግሾስፕ አትን ማላ በኤዝ ግሾስ ባያ። <verse eid="JHN 6:26"/><verse number="27" style="v" sid="JHN 6:27"/>ብዛ ካስ ኦፓተ፥ ዝን መናስ ደኦ እንግዝ ካስ ኦይታ። ጾስ አዳይ ኤ ኦድ ጋርክ ኤዝስ ማዉተ እንጌዝ ግሾስ የ ካ አስ ናአይ ይንትስ እማዳ ኤርሴዛ» ዬጌዛ።<verse eid="JHN 6:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28"/>የዝን ኡንቲ፥ «ኑኒ ጾስ ኦ ኦዳይስ አብ ኦዴ?» ዬጊ የሱሳ ኦይጬዛ።<verse eid="JHN 6:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 6:29"/>የሱሳ ማሂ፥ «ይ ኦድ ጋርክ ጾሳይ ኮይዝ ኦሳይ Ꮊያ፤ ኤ አዛዜዛና አማኖይታ» ዬጌዛ።<verse eid="JHN 6:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 6:30"/>ኡንቲ ማሂ፥ «ኑኒ ብኢ፥ ነና አማኖድ ጋርክ አባ ማላ ነ በሳደ? ነ አብ ኦዴ? <verse eid="JHN 6:30"/><verse number="31" style="v" sid="JHN 6:31"/>ጌሻ ማጻፋይድ፥ ‹ኡ ማድ ጋርክ ሶሎ ሳሎፕ እንጌዛ› ግንትንቲ ጻፍንቴዛይ ጋርክ ኑ አድታይ ሊዦ ደንባ ማና ሜዛ» ዬጌዛ።<verse eid="JHN 6:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 6:32"/>የሱሳ፥ «ታኒ ይንትስ ቱሮ ኦድዛ፤ ይንትስ ሳሎፕ ቱማ ሶሎ እንጌዛይ ታ አዳይፕ አትን ሙሰ ባያ። <verse eid="JHN 6:32"/><verse number="33" style="v" sid="JHN 6:33"/>ይኬ፥ ጾሳይ እንግዝ ሶላይ ሳሎፕ ዎዛይ አላማይስ ደኦ እንግዛ» ዬጌዛ።<verse eid="JHN 6:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 6:34"/>ኡንቲ ማሂ፥ «ጎዳዮ፥ ኑስ የ ሶላ ኡባ ጋላስ እንጎባ» ዬጌዛ።<verse eid="JHN 6:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 6:35"/>የሱሳ፥ «ታኒ ደኦ እንግዛ ሶሎ፤ ታኮ ይእዝ ኦንካ ኡባራካ ናይንተና። ማ ታና አማንዛ አይ ኡባራካ ሳምንተና። <verse eid="JHN 6:35"/><verse number="36" style="v" sid="JHN 6:36"/>ዝን ታኒ ይንትስ ኦዴዛ፤ ይ ታና በኤዛ፥ ዝን አማኖያ። <verse eid="JHN 6:36"/><verse number="37" style="v" sid="JHN 6:37"/>ታ አዳይ ታስ እንግዝ ኡቢታይ ታኮ የኦዳ፤ ማ ታኮ ይእዝ ኦናካ ባለ ዳካሚ። <verse eid="JHN 6:37"/><verse number="38" style="v" sid="JHN 6:38"/>ታኒ ታ ኮይዝ ባዝ ኦዳይስ ባዝን ታና ኪቴዛይ ኮይዝ ባዝ ኦዳይስ ሳሎፕ የኤዛ። <verse eid="JHN 6:38"/><verse number="39" style="v" sid="JHN 6:39"/>ታና ኪቴዛይ ኮይዛይ Ꮊያ፦ ታኒ ኤ ታስ እንጌዝ ኡብታካ ዉርስ ጋላስ Ꮊይቆፕ ደንዳይ ጋርከፕ አትን ፐታካ ብሶድ ጋርክ ኮዮያ። <verse eid="JHN 6:39"/><verse number="40" style="v" sid="JHN 6:40"/>ይኬ፥ ታ አዳይ ኮይዛይ የያ ናአ ብኢ አማንዛ ኡቢታይ መና ደኦ ኤኮዳ፤ ታኒ የ ኡብታ ዉርስ ጋላስ መና ደኦስ Ꮊይቆፕ ደንዳ» ዬጌዛ።<verse eid="JHN 6:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41"/>የሱሳ፥ «ታኒ ሳሎፕ ዎዝ ሶሎ» ጌዝ ግሾስ አይሁድታይ ኤዛ ዝግሬዛ። <verse eid="JHN 6:41"/><verse number="42" style="v" sid="JHN 6:42"/>ኡንቲ፥ «Ꮊይ ኑኒ ኤ አዳኔ ኤ እንዳት ኤርዛ ዮሴፋ ናአ የሱሳ ባሳኔ? የዝን፥ ኤ ዋይዚ፥ ‹ታኒ ሳሎፕ ዎዛ› ጎዳይስ ዳንዳእኔ?» ዬጌዛ።<verse eid="JHN 6:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43"/>የሱሳ ማሂ፥ «ፐታይ ፐታይራ ዝግርዛ አሾይታ። <verse eid="JHN 6:43"/><verse number="44" style="v" sid="JHN 6:44"/>ታና ኪቴዝ ታ አዳይ ታኮ ክእዛ አሳፕ አትን ታኮ የኦዳይስ ዳንዳእዛ ኦንካ ባያ። ታኒ ዉርስ ጋላስ ኤዛ መና ደኦስ Ꮊይቆፕ ደንዳ። <verse eid="JHN 6:44"/><verse number="45" style="v" sid="JHN 6:45"/>ናብታይ፥ ‹ጾሳይ አስ ኡባ ታማርሶዳ› ዬጊ ጻፌዛ። ኣዳ ስእዛይኔ ኤዝፕ ታማርዛ ኦንካ ታኮ ይእዛ። <verse eid="JHN 6:45"/><verse number="46" style="v" sid="JHN 6:46"/>ጾስ አዳ በኤዛይ ኦንካ ባያ፤ ኤ አዳይ አዳ በኤዛ።<verse eid="JHN 6:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 6:47"/>«ታኒ ይንትስ ቱሮ ኦድዛ፤ ታና አማንዛ ኦስካ መና ደኦ የዛ። <verse eid="JHN 6:47"/><verse number="48" style="v" sid="JHN 6:48"/>ታኒ ደኦ እንግዝ ሶሎ። <verse eid="JHN 6:48"/><verse number="49" style="v" sid="JHN 6:49"/>ይ አድታይ ሊዦ ደምባ ማኖ ሜዛ፥ ዝን Ꮊይቄዛ። <verse eid="JHN 6:49"/><verse number="50" style="v" sid="JHN 6:50"/>ሳሎፕ ይእዝ ሶላይ Ꮊያ፤ የ ሶላ ሚዝ ኦንካ Ꮊይቃሚ። <verse eid="JHN 6:50"/><verse number="51" style="v" sid="JHN 6:51"/>ሳሎፕ የኤዝ ደኦ ሶላይ ታና። ኦንካ Ꮊ ሶላ ሚኮ መናስ የዞዳ። ማ Ꮊ አላማይ ደኦር የዞድ ጋርክ ታኒ ይንትስ እማድ ሶላይ ታ አሾ» ዬጌዛ።<verse eid="JHN 6:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52"/>አይሁድታይ፥ «Ꮊ አይ ፋ አሾ ኑ ማድ ጋርክ ኑስ ዋይዚ እማዳይስ ዳንዳኤ?» ዬጊ ዎል ጋንጨ ፓላሜዛ።<verse eid="JHN 6:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 6:53"/>የይ ግሾስ፥ የሱሳ ኡንትኮ፥ «ታኒ ይንትስ ቱሮ ኦድዛ፤ አስ ናአ አሾ፥ ይ ማም እጽኮ፥ ኤ ሱ ይ ኡዣም እጽኮ፥ ይንትስ ደኦ ባያ። <verse eid="JHN 6:53"/><verse number="54" style="v" sid="JHN 6:54"/>ታ አሾ ሚዝ አይስኔ ታ ሱ ኡዥዝ አይስ መና ደኦ የዛ። ታኒ ዉርስ ጋላስ ኤዛ Ꮊይቆፕ ደንዳ። <verse eid="JHN 6:54"/><verse number="55" style="v" sid="JHN 6:55"/>ታ አሻይ ቱማ ሙንታ፤ ታ ሱይካ ቱማ ኡሺ። <verse eid="JHN 6:55"/><verse number="56" style="v" sid="JHN 6:56"/>ታ አሾ ሚዝ አይኔ ታ ሱ ኡዥዝ አይ ታር የዝዛ፤ ታካ ኤዛር የዝዛ። <verse eid="JHN 6:56"/><verse number="57" style="v" sid="JHN 6:57"/>ደኦ አዳይ ታና ኪትን፥ ታኒ ኤ ባጋር ደኦር የዛይ ጋርክ፥ ታና ሚዝ አይካ ታ ባጋር ደኦር የዞዳ። <verse eid="JHN 6:57"/><verse number="58" style="v" sid="JHN 6:58"/>ሳሎፕ ዎዝ ሶላይ Ꮊያ፦ ይ አድታይ ም Ꮊይቄዝ ማናይ ጋርክ ባያ፤ Ꮊ ሶላ ሚዝ አይ መናስ የዞዳ» ዬጌዛ።<verse eid="JHN 6:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 6:59"/>የሱሳ ቅፍርናሆማ ካታማ አይሁድታይ ዎሳ ኬ Ꮊያ ታማርሴዛ።<verse eid="JHN 6:59"/></para>
  <para style="s1">መና ደኦ ቃላ</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60"/>የሱሳ ታማርታይፕ ጋመ ባጋይ የያ ስኢ «Ꮊይ ገሎዋ ትምርተ፤ Ꮊይ ኦስ ገሌ?» ዬጌዛ።<verse eid="JHN 6:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="JHN 6:61"/>የሱሳ ፋ ታማርታይ የይስ ዝግሬዛና ኤሪ፥ «Ꮊይ ይንታን ቢኔ? <verse eid="JHN 6:61"/><verse number="62" style="v" sid="JHN 6:62"/>የዝን፥ አስ ናአይ ቲን የዛበሳ ፑደ ከሳዳር ይ ብኢ ዋጎደሻ? <verse eid="JHN 6:62"/><verse number="63" style="v" sid="JHN 6:63"/>አያናይ ደኦ እንግዛ፤ አስ ዎልቃ አብካ ማዶያ። ታ ይንትስ ኦድዛ ቃላይ ደኦ እንግዝ ጌሻ አያናፕ ይእዛ። <verse eid="JHN 6:63"/><verse number="64" style="v" sid="JHN 6:64"/>ዝን ይ ጋንጨ አማኖዝታይ የዛ» ዬጌዛ። አማኖዝታይ ኦናንታዛኮ የሱሳ ቲናፕ አይኪ ኤርዛ። ማ ፋና ኣ እማዳይ ኦናዛኮ ኤርዛ። <verse eid="JHN 6:64"/><verse number="65" style="v" sid="JHN 6:65"/>ማካ የሱሳ፥ «አዳይ Ꮊንጎባ ጌካ ኦንካ ታኮ የኦዳይስ ዳንዳኦያ ግ ታኒ ኦዴዛይ የይ ግሾስ» ዬጌዛ።<verse eid="JHN 6:65"/></para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66"/>የይ ግሾስ፥ የሱሳና ካልዝታይፕ ጋምታይ ኤዛ አሺ ጉየ ማቄዛ፤ ማቂ ኤዛ ካልበኤካያ። <verse eid="JHN 6:66"/><verse number="67" style="v" sid="JHN 6:67"/>የሱሳ ታጶ ናምኢ ፋ ታማርታ፥ «ይንትካ አሺ Ꮊማዳይስ ኮይኔ?» ዬጊ ኦይጬዛ።<verse eid="JHN 6:67"/></para>
  <para style="p">
    <verse number="68" style="v" sid="JHN 6:68"/>ስሞን ጵጽሮሳ ማሂ፥ «ጎዳዮ፥ ኑኒ ኦክ Ꮊማዴ? ነ መና ደኦ እንግዝ ቃላር የዛ። <verse eid="JHN 6:68"/><verse number="69" style="v" sid="JHN 6:69"/>ኔኒ ጌሻ ጾሳይ ናአ ማቄዛና ኑኒ አማንዛኔ ኤርዛ» ዬጌዛ።<verse eid="JHN 6:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="JHN 6:70"/>የሱሳ ኡንትኮ፥ «ታኒ ይንታን ታጶ ናምእታ ማራጸካሳ? ዝን ይንትፕ ፐታይ ጻላሄ» ዬጌዛ። <verse eid="JHN 6:70"/><verse number="71" style="v" sid="JHN 6:71"/>የሱሳ የያ ጌዛይ ስሞና ናአ አስቆሮቶ ይሁዳስ። ይሁዳ የሱሳና አ እማዳይስ የዝ ታጶ ናምኢ ታማርታይፕ ፐታ።<verse eid="JHN 6:71"/></para>
  <chapter eid="JHN 6"/>
  <chapter number="7" style="c" sid="JHN 7"/>
  <para style="s1">የሱሳራኔ ኤ እሽታይራ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1"/>የይፕ ጉየ፥ አይሁድታይ የሱሳ ዎዳይስ ኮይዝ ግሾስ ኤ ይሁዳ አሺ ጋልላር ዩዬዛ። <verse eid="JHN 7:1"/><verse number="2" style="v" sid="JHN 7:2"/>አይሁድታይ ቦንችዛ ዳሰ ባለ ቦንችንቶዳይስ ኡኬዛ። <verse eid="JHN 7:2"/><verse number="3" style="v" sid="JHN 7:3"/>የይ ግሾስ፥ የሱሳ እሽታይ፥ «ነ ታማርታይ ኔኒ ኦዝ ማልታ በአድ ጋርክ Ꮊይፕ ደንዲ ይሁዳ ቢታ ቅቶባ። <verse eid="JHN 7:3"/><verse number="4" style="v" sid="JHN 7:4"/>ፓስ ኤርንቶዳይስ ኮይዝ አስ ኦንካ ፋ ኦሳ ቆሶያ። ኔኒ Ꮊይትታ ኦ ነ ባጋ አላማ ኤርሶባ» ዬጌዛ። <verse eid="JHN 7:4"/><verse number="5" style="v" sid="JHN 7:5"/>ኤ እሽታይ የያ ጌዛይ ኤዛል አማናም እጼዝ ግሾስ።<verse eid="JHN 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 7:6"/>የሱሳ ኡንትኮ፥ «ታስ ዎዳይ ሄለካያ፥ ዝን ይንትስ ኡባ ዎዳይ ጊጋ። <verse eid="JHN 7:6"/><verse number="7" style="v" sid="JHN 7:7"/>አላማይ ይንታን እጾዳይስ ዳንዳኦያ፥ ዝን ታኒ አላማይ ኦሳይ ኢታ ማቅዛና ማርካትዝ ግሾስ ታና እጽዛ። <verse eid="JHN 7:7"/><verse number="8" style="v" sid="JHN 7:8"/>ይ ባላ Ꮊንጎይታ፤ ታ ዎዳይ ሄለካዛይ ግሾስ ታኒ ባላ Ꮊንጋሚ» ዬጌዛ። <verse eid="JHN 7:8"/><verse number="9" style="v" sid="JHN 7:9"/>ኤ የያ ግ ጋልላ አቴዛ።<verse eid="JHN 7:9"/></para>
  <para style="s1">የሱሳ ባላ ቦንቾዳይስ Ꮊንጌዛ</para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10"/>ኤ እሽታይ ባላ ቦንቾዳይስ Ꮊንጌዛይፕ ጉየ የሱሳ ኦናካ ኤርሰካዛር ቆሶር የ አቃ Ꮊንጌዛ። <verse eid="JHN 7:10"/><verse number="11" style="v" sid="JHN 7:11"/>አይሁድታይ ባላ ቦንችዛ አቃይድ፥ «ኤ አባ የኔ?» ዬጊ ኤዛ ኮዬዛ።<verse eid="JHN 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 7:12"/>አሳይ ካልካሺ ኤባጋ ኦድንቶዳር ባግታይ፥ «ኤ ሎኦ አስ» ጎዳር አቴዝ አሳይ ማ፥ «ዋኣ፥ ኤ ዎያ ባልዛ» ዬግዛ። <verse eid="JHN 7:12"/><verse number="13" style="v" sid="JHN 7:13"/>ዝን አይሁደ ሀላቅታይስ ያሽቴዝ ግሾስ ኦንካ ኤባጋ ጌሻ ኦድንቶዳይስ ዳንዳኤካያ።<verse eid="JHN 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14"/>ባላ ቦንቺ ጋባ ሄልዳር የሱሳ ጾሳ ኬ Ꮊንጊ ታማርሶ አይኬዛ። <verse eid="JHN 7:14"/><verse number="15" style="v" sid="JHN 7:15"/>አይሁድታይ፥ «Ꮊ አይ ትምርተ ታማረካዛር Ꮊያ ኡባ ዋይዚ ኤሬኔ?» ዬጊ ማላባዝ ጌዛ።<verse eid="JHN 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 7:16"/>የሱሳ ማሂ፥ «ታ ታማርስዛ ትምርታይ ታና ኪቴዝ ጾሳፕ ይእዝ ትምርተፕ አትን ታባዝ ባያ። <verse eid="JHN 7:16"/><verse number="17" style="v" sid="JHN 7:17"/>ጾስ አዛዞ ኦዳይስ ኮይዝ ኦንካ Ꮊ ትምርታይ ጾሳፕ ይእዛኮኔ ዎይ ታኒ ታፕ ኦድዛኮ ኤሮዳ። <verse eid="JHN 7:17"/><verse number="18" style="v" sid="JHN 7:18"/>ፓፕ ኦድዝ ኦንካ ፋ ኡባ ቦንቾ ኮይዛ። ዝን ፋና ኪቴዛይ ቦንቾ ኮይዝ ኦንካ ኤ ቱማንቾ፤ ኤዛር ዎርዶ ባያ። <verse eid="JHN 7:18"/><verse number="19" style="v" sid="JHN 7:19"/>ሙሰ ይንትስ ህገ እንጌዛ፥ ዝን ይንትፕ ኦንካ ህገ ናገካያ። የዝን አብስ ታና ዎዳይስ ኮዬ?» ዬጌዛ።<verse eid="JHN 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 7:20"/>አሳይ ማሂ፥ «ኔል ጻላሄ የዛ፤ ነና ዎዳይስ ኦኖ ኮይዛይ?» ዬጌዛ።<verse eid="JHN 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 7:21"/>የሱሳ፥ «ታኒ ፐቲ ማላ ኡድን ይ ኡቢታይ ማላባዝ ጌዛ። <verse eid="JHN 7:21"/><verse number="22" style="v" sid="JHN 7:22"/>ይንቲ፥ ይ ናእታ ዶካሎድ ጋርክ ሙሰ ኪቴዛ። ዝን ዶካሎ ይ ማይዝታይ ኡዶ አይኬዛፕ አትን ሙሰ ባያ። የይ ግሾስ፥ ይ ማላ ጋላስ ራ ናእታ ዶካልዛ። <verse eid="JHN 7:22"/><verse number="23" style="v" sid="JHN 7:23"/>ሙሰ ህጋይ ኪቴዝ ግሾስ ይ ማላ ጋላስ ዶካልዛባዝ ማቅኮ፥ ታኒ ፐቲ አሲ ኩን ጋላ ፓዝ ግሾስ ታር አብስ ካጬ? <verse eid="JHN 7:23"/><verse number="24" style="v" sid="JHN 7:24"/>ቱማ ፕርደ ፕርዶይታፕ አትን አስ ኣፈ ብኢ ፕርድፓተ» ዬጌዛ።<verse eid="JHN 7:24"/></para>
  <para style="s1">የሱሳ፥ ኤ ክርስቶሳ?</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25"/>የሩሳላመ አሳይፕ ፐታይ ፐታይ፥ «ኡ ዎዳይስ ኮይዝ አይ Ꮊያ ባሳ? <verse eid="JHN 7:25"/><verse number="26" style="v" sid="JHN 7:26"/>ዬዛኮ፥ ኤ ፕ ኦድዛ፤ ኡንቲ ኤዛ አብካ ጎያ። ኤ ክርስቶሳ ማቅዛና ሀላቅታይ ቱማ ኤርነሻ? <verse eid="JHN 7:26"/><verse number="27" style="v" sid="JHN 7:27"/>ክርስቶሳ ይእዛ ዎደ ኤ አናፕ ይእዛኮ ኦንካ ኤሮያ፥ ዝን ኤ አናፕ የኤዛኮ ኑ ኤርዛ» ዬጌዛ።<verse eid="JHN 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 7:28"/>የሱሳ ጾስ ኬ ታማርስታር ፋ ቃላ ቅ ኡዲ፥ «ቱማ ይ ታኒ ኦናዛኮኔ ታ አናፕ የኤዛኮ ኤርኔ? ታኒ ታ ማዉተር የኤካያ፥ ዝን ታና ኪቴዛይ ቱማ፤ ይ ኤዛ ኤሮያ። <verse eid="JHN 7:28"/><verse number="29" style="v" sid="JHN 7:29"/>ዝን ታኒ ኤ ኪትን ኤ ላንቀፕ የኤዝ ግሾስ ኤዛ ኤርዛ» ዬጌዛ።<verse eid="JHN 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 7:30"/>የይ ግሾስ፥ ኡንቲ ኤዛ አይኮዳይስ ኮዬዛ። ዝን ኤ ዎዳይ ሀጋ ሄለካዛይ ግሾስ ኦንካ ኤዛል አፋ ኩሸ ጋደካያ። <verse eid="JHN 7:30"/><verse number="31" style="v" sid="JHN 7:31"/>ዝን ጋመ አሳይ የሱሳ አማኒ፥ «ክርስቶሳ የኦዳር Ꮊ አይ ኦዝ ማልታይፕ ጋንግዛ ማልታ ኦደኔ?» ዬጌዛ።<verse eid="JHN 7:31"/></para>
  <para style="s1">የሱሳና አይኮዳይስ ዎታዳርታይ ኪትንቴዛ</para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32"/>ፈርሳወ አሳይ ጋመ አሳይ የሱሳ ኦሳይ ባጋ ካልካሾዳር ስኤዛ። ቄሰ ሀላቅታይኔ ፈርሳወ አሳይ ኤዛ አይኪ አጭሾዳይስ ጾስ ኬ ናግዝታ ኪቴዛ።<verse eid="JHN 7:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 7:33"/>የሱሳ፥ «ታኒ ይንታር ጽቃ ዎደ ጋምኦዳ፤ የይፕ ጉየ ታና ኪቴዛይኮ Ꮊማዳ። <verse eid="JHN 7:33"/><verse number="34" style="v" sid="JHN 7:34"/>ይ ታና ኮዮዳ፥ ዝን ደንጋሚ። ታኒ የዛ አቃ ይ የኦዳይስ ዳንዳኦያ» ዬጌዛ።<verse eid="JHN 7:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 7:35"/>አይሁድታይ ፐታይ ፐታይራ፥ «Ꮊይ ኑኒ ደንጎዋ አቆ አባ Ꮊማድ ሀኔ? ግርከ ካታማ ጋንጨ የዝ አይሁድታይኮ Ꮊንጊ ግርክታ ታማርሶዳይስ ሀንነኔ? <verse eid="JHN 7:35"/><verse number="36" style="v" sid="JHN 7:36"/>‹ይ ታና ኮዮዳ፥ ዝን ደንጋሚ› ማ፥ ‹ታኒ የዛበሳ ይ የኦዳይስ ዳንዳኦያ› ጉሳይ አብ ጉሶ?» ዬጌዛ።<verse eid="JHN 7:36"/></para>
  <para style="s1">ደኦ ሃ</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37"/>ባላ ቦንችዛ ጋላስታይፕ ዎልቃማነ ዉርስ ጋላስ የሱሳ ደንዲ፥ ፋ ቃላ ቅ ኡዲ፥ «ሳምንቴዝ ኦንካ ታኮ ይኢ ኡዦ። <verse eid="JHN 7:37"/><verse number="38" style="v" sid="JHN 7:38"/>ታና አማንዛ ኦንካ ጌሻ ማጻፈ ጌዛይ ጋርክ ደኦ እንግዝ ፑልቶ ሃይ ኤ ጋንጨፕ ጎጎዳ» ዬጌዛ። <verse eid="JHN 7:38"/><verse number="39" style="v" sid="JHN 7:39"/>ኤ የያ ጌዛይ ኤዛ አማኔዝታይ ኤኮዳይስ የዝ ጌሻ አያናባጋ። የሱሳ ሀጋ ቦንችንተካ ግሾስ የ ዎደ ጌሻ አያናይ እንግንተካያ።<verse eid="JHN 7:39"/></para>
  <para style="s1">አስ ጋንጨ ሻክንቶ መንቴዛ</para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40"/>የ አሳይፕ ጋምታይ ኤ ግዛ ስኢ፥ «ቱማ Ꮊይ ናበ» ዬጌዛ።<verse eid="JHN 7:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 7:41"/>Ꮊንክታይ ማ፥ «Ꮊይ ክርስቶሳ» ዬጌዛ።</para>
  <para style="p" vid="JHN 7:41">ዝን አቴዝ አሳይ ማ፥ «ክርስቶሳ ጋልላፕ የኦደኔ? <verse eid="JHN 7:41"/><verse number="42" style="v" sid="JHN 7:42"/>ጌሻ ማጻፋይ፥ ‹ክርስቶሳ ዳውተ ሼሻፕ ዳውተ የዜዝ ቤተለመ ካታማፕ የኦዳ› ዬጎሳኔ?» ዬጌዛ። <verse eid="JHN 7:42"/><verse number="43" style="v" sid="JHN 7:43"/>ዝን፥ የሱሳ ግሾስ አሳይ ዎል ጋንጨ ሻክንቴዛ። <verse eid="JHN 7:43"/><verse number="44" style="v" sid="JHN 7:44"/>የ አሳይፕ ፐታይ ፐታይ ኤዛ አይኮዳይስ ኮዬዛ፥ ዝን ኦንካ ኤዛል አፋ ኩሸ ጋደካያ።<verse eid="JHN 7:44"/></para>
  <para style="s1">አይሁደ ሀላቅታይ አማነካያ</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45"/>ጾሳ ኬ ናግዝታይ ቄሰ ሀላቅታይኮራኔ ፈርሳውታይኮ ጉየ ማቂ ይእን ኡንቲ፥ «አብስ ኤዛ ከኤካሳ?» ዬጊ ኦይጬዛ።<verse eid="JHN 7:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 7:46"/>ጾሳ ኬ ናግዝታይ ኡንትኮ፥ «Ꮊ አይ ኦድዛይ ጋርክ ኦንካ ኦድንቶያ» ዬጊ ማሄዛ።<verse eid="JHN 7:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 7:47"/>ፈርሳወ አሳይ ማሂ፥ «ኤ ይንታናካ ባልኔ? <verse eid="JHN 7:47"/><verse number="48" style="v" sid="JHN 7:48"/>አይሁደ ሀላቅታይፕ ዎይ ፈርሳወ አሳይፕ ኤዛ አማኔዝ አስ የኔ? <verse eid="JHN 7:48"/><verse number="49" style="v" sid="JHN 7:49"/>ሙሰ ህገ ኤሮዋ Ꮊ አሳይ ባድቴዛ» ዬጌዛ።<verse eid="JHN 7:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 7:50"/>ፈርሳውታይፕ ፐታይ ቃማ የሱሳኮ Ꮊንጌዝ ንቆድሞሳ ኡንትኮ፥ <verse eid="JHN 7:50"/><verse number="51" style="v" sid="JHN 7:51"/>«ፐቲ አሲ ግዝ ባዝ ስኤካዛር ዎይ ኤ አብ ኦዛኮ ኤረካዛር ቲናቲ ኤዛል አፋ ፕርድዛይ ኑ ህጋይድ የኔ?» ዬጌዛ።<verse eid="JHN 7:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 7:52"/>ኡንቲ ማቂ፥ «ኔካ ማ ጋልላ ቢታ አሶ? ጋልላ ቢታፕ ናበ ኬዛምዛ ጌሻ ማጻፋይፕ ፕላጊ ደንጎባ» ዬጌዛ። <verse eid="JHN 7:52"/><verse number="53" style="v" sid="JHN 7:53"/><note caller="+" style="f"><char style="fr" closed="false">7:53 </char><char style="ft" closed="false">ብኒ ፐቲ ፐቲ ማጻፍታይድ ዋን 7:53 ባያ።</char></note>ኡቢታይ ፋ ካራ ፋ ካራ ቅቴዛ።<verse eid="JHN 7:53"/></para>
  <chapter eid="JHN 7"/>
  <chapter number="8" style="c" sid="JHN 8"/>
  <para style="s1">ላግትታር አይክንቴዝ አስቶ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 8:1"/>የሱሳ ደብረ ዛይተ ደረል አፋ ቅቴዛ። <verse eid="JHN 8:1"/><verse number="2" style="v" sid="JHN 8:2"/>ማ ዎንት ጋላስ ጉራ ጾሳ ኬ ማቄዛ። ጋመ አሳይ ኤዝኮ ይእን በቲ ኡንታን ታማርሴዛ። <verse eid="JHN 8:2"/><verse number="3" style="v" sid="JHN 8:3"/>ህገ አስታማርታይኔ ፈርሳወ አሳይ ላግቶዳር አይኬዝ ፐቲ አስቶ ኤዝኮ ከኤዛ። ኡ አስ ኡባይ ቲና እዞ ኤሲ፥ <verse eid="JHN 8:3"/><verse number="4" style="v" sid="JHN 8:4"/>«አስታማራዮ፥ Ꮊ አስታ ላግቶዳር ኑ አይኬዝ። <verse eid="JHN 8:4"/><verse number="5" style="v" sid="JHN 8:5"/>ሙሰ ህጋይ Ꮊን ጋርክ አስታ ሹቻር ጫድንቲ Ꮊይቆድ ጋርክ ኪትዛ። የዝን፥ ኔኒ ዋጌ?» ዬጌዛ።<verse eid="JHN 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 8:6"/>ኡ የያ ጌዛይ የሱሳና ፓጪ ኤዛ ሞትዛባዝ ደማዳይሲ። ዝን የሱሳ ዙጊ ፋ ብራር ሳአል ጻፌዛ። <verse eid="JHN 8:6"/><verse number="7" style="v" sid="JHN 8:7"/>ኡ ኤዛ ማሂ ማሂ ኦይጪ አሻሚ እጽን፥ ፑደ ቅ ግ፥ «ይ ጋንጨ ናጋራ ኦካ አስ ቲናቲ እዞ ሹቻር ሾጮ» ዬጌዛ። <verse eid="JHN 8:7"/><verse number="8" style="v" sid="JHN 8:8"/>ማካ ዙጊ ሳአል ጻፌዛ።<verse eid="JHN 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 8:9"/>ኡንቲ የያ ስኤዝ ዎደ ጭምታይፕ አይኪ ፐታይ ፐታይ ከዝታር ዉሬዛ። የሱሳ ኣዳ የ አቃይድ ኤቄዝ አስትር አቴዛ። <verse eid="JHN 8:9"/><verse number="10" style="v" sid="JHN 8:10"/>ኤ ፑደ ቅ ግ አስትኮ፥ «Ꮊን አስተ፥ አሳይ አና Ꮊንጌኔ? ኔል ፕርዴዝ ኦንካ ባሳ?» ዬጌዛ።<verse eid="JHN 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 8:11"/>ያ አስታ፥ «ጎዳዮ፥ ኦንካ ባያ» ዬጌዛ።</para>
  <para style="p" vid="JHN 8:11">የሱሳ ማሂ፥ «ታንካ ኔል አፋ ፕርዳሚ። ቅቶባ፤ Ꮊንፕ ማቂ ናጋራ ኦፐ» ዬጌዛ።<verse eid="JHN 8:11"/></para>
  <para style="s1">የሱሳ አላመስ ፖኦ</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12"/>ማካ የሱሳ አሳይኮ፥ «ታኒ አላመስ ፖኦ። ታና ካልዛ ኦንካ ደኦ እንግዝ ፖአና ደንጎዳይፕ አትን ማ ጋንጨ ዉተና» ዬጊ ኦዴዛ።<verse eid="JHN 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13"/>ፈርሳወ አሳይ፥ «ነ ነባዝ ማርካትዛ፥ ዝን ነ ማርካትይ ቱማ ባያ» ዬጌዛ።<verse eid="JHN 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 8:14"/>የሱሳ ማሂ፥ «ታኒ ታባዝ ማርካትኮካ ታ ማርካትይ ቱማ። አብስ ጊኮ፥ ታኒ አናፕ የኤዛኮ ማ አና Ꮊንግዛኮ ኤርዛ፥ ዝን ይ ኤሮያ። <verse eid="JHN 8:14"/><verse number="15" style="v" sid="JHN 8:15"/>ይ አስ ቆፋል ፕርድዛ፤ ታኒ ፐቲ አሳላካ ፕርዳሚ። <verse eid="JHN 8:15"/><verse number="16" style="v" sid="JHN 8:16"/>ታኒ ፕርድዛ ባዝ ማቅኮካ ታ ፕርዳይ ቱማ። አብስ ጊኮ፥ ታና ኪቴዝ ታ አዳይ ታር የዛይፕ አትን ታኒ ታ ኣዳስ ባያ። <verse eid="JHN 8:16"/><verse number="17" style="v" sid="JHN 8:17"/>ናምኢ አስ ማርካት ሚንግዛ የይ ይ ህጋይድ ጻፍንቴዛ። <verse eid="JHN 8:17"/><verse number="18" style="v" sid="JHN 8:18"/>ታኒ ታባዝ ታ ኡባስ ማርካትዛ፤ ማ ታና ኪቴዝ ታ አዳይ ታባዝ ማርካትዛ» ዬጌዛ።<verse eid="JHN 8:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 8:19"/>ኡንቲ፥ «ነ አዳይ አባ የኔ?» ዬጊ ኤዛ ኦይጬዛ።</para>
  <para style="p" vid="JHN 8:19">የሱሳ ማሂ፥ «ይ ታና ዎይ ታ አዳ ኤሮያ። ታና ኤርዛ ማቄዛኮ፥ ይ ታ አዳካ ኤሮዳዝን» ዬጌዛ።<verse eid="JHN 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 8:20"/>የሱሳ ጾሳ ኬ ሙጻታ ሚሸ ኦልዝ ሳጽነ የዝ በሳ የያ ታማርሴዛ። ኤ ቃማይ ሀጋ ሄለካዛይ ግሾስ ኦንካ ኤዛ አይከካያ።<verse eid="JHN 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21"/>ማካ የሱሳ ኡንትኮ፥ «ታኒ Ꮊማዳዝን፤ ይ ታና ኮዮዳ፥ ዝን ይ አቶት ደንጋሚ ይ ናጋራራ Ꮊይቆዳ። ታኒ Ꮊንግዛ አቆ Ꮊማዳይስ ይ ዳንዳኦያ» ዬጌዛ።<verse eid="JHN 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 8:22"/>አይሁደ ሀላቅታይ፥ «ኤ፥ ‹ታኒ Ꮊንግዛ አቆ ይ Ꮊማዳይስ ዳንዳኦያ› ዬጌዛ። ኤ ፋና ፋ ኣዳስ ዎዳይሶኔ?» ዬጌዛ።<verse eid="JHN 8:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 8:23"/>የሱሳ ማሂ፥ «ይ ሳአፐ፤ ታ አፋፐ። ይ Ꮊ አላማይፐ፥ ታ Ꮊ አላማይፕ ባያ። <verse eid="JHN 8:23"/><verse number="24" style="v" sid="JHN 8:24"/>ይ አቶት ደንጋም ይ ናጋራራ Ꮊይቆድ ግ ታ ይንትስ ኦደዛይ Ꮊይሲ። ታኒ ታና ይ አማናም እጽኮ ይ አቶት ደንጋሚ ይ ናጋራራ Ꮊይቆዳ» ዬጌዛ።<verse eid="JHN 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 8:25"/>ኡንቲ፥ «ኔኒ ኦኖ?» ዬጊ ኦይጬዛ። የሱሳ ማሂ፥ «ታኒ፥ ቲናፕ ይንትስ ኦዴዛይ ታና። <verse eid="JHN 8:25"/><verse number="26" style="v" sid="JHN 8:26"/>ታኒ ይ ባዝ ኦዲ ፕርድዛ ባዝ ጋመ ባዝ የዛ። ዝን ታና ኪቴዛይ ቱማንቾ፤ ማ ታ ኤፕ ስኤዛን ኣዳ አላማይስ ኦድዛ» ዬጌዛ።<verse eid="JHN 8:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 8:27"/>የሱሳ ፋ አዳይባጋ ኦድዛና ኡ አካኬካያ። <verse eid="JHN 8:27"/><verse number="28" style="v" sid="JHN 8:28"/>የይ ግሾስ፥ የሱሳ ኡንትኮ፥ «ይ አስ ናአ ፑደ ቅ ኦዛ ዎደ ታኒ ታና ማቄዛና ይ ኤሮዳ። ማካ ታኒ ታ ስልጻነር አብካ ኦዳኔ ታ አዳይ ታና ታማርሴዛና ኦድዛ ይ ኤሮዳ። <verse eid="JHN 8:28"/><verse number="29" style="v" sid="JHN 8:29"/>ታና ኪቴዛይ ታር የዛ። ታኒ ኡባ ዎደ ኤዛ ኡፋይስዛ ባዝ ኦዛ ግሾስ ኤ ታና ታ ኡባስ አሸካያ» ዬጌዛ።<verse eid="JHN 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 8:30"/>የሱሳ የያ ኦዶዳር ስኤዝ ጋመ አሳይ ኤዛ አማኔዛ።<verse eid="JHN 8:30"/></para>
  <para style="s1">ናጋራ አይለትፕ ከሲ</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31"/>የሱሳ ፋና አማኔዝ አስታይኮ፥ «ይ ታ ትምርታይስ ኪትንትኮ ቱማ ታና ካልዝታ። <verse eid="JHN 8:31"/><verse number="32" style="v" sid="JHN 8:32"/>ይ ቱማ ኤሮዳ፤ ቱማይካ ይንታን ዎዚ ኤኮዳ» ዬጌዛ።<verse eid="JHN 8:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 8:33"/>ኡንቲ ማሂ፥ «ኑኒ አፍራመ ሼሺ፤ ኑኒ ኦስካ አይልትበኤካያ። ነ ዋጊ፥ ‹ይ ዎዝንቶዳ ጌ?» ዬጌዛ።<verse eid="JHN 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34"/>የሱሳ ማሂ፥ «ታኒ ይንትስ ቱሮ ኦድዛ፤ ናጋራ ኦዝ ኦንካ ናጋራ አይለ። <verse eid="JHN 8:34"/><verse number="35" style="v" sid="JHN 8:35"/>አይለ መናስ ካራ አሳር የዞያ፥ ዝን ናአይ መናስ ካራ አሳር የዝዛ። <verse eid="JHN 8:35"/><verse number="36" style="v" sid="JHN 8:36"/>ናአይ ይንታን ዎዝኮ ይ ቱማ ዎዝንቶዳ። <verse eid="JHN 8:36"/><verse number="37" style="v" sid="JHN 8:37"/>ይ አፍራመ ሼሽ ማቄዛና ታኒ ኤርዛ። ዝን ታ ቃላይ ይ ዎዝና ጋንጨ ባዛይ ግሾስ ታና ዎዳይስ ኮይዛ። <verse eid="JHN 8:37"/><verse number="38" style="v" sid="JHN 8:38"/>ታኒ ታ አዳይ ታና ቤዜዛና ኦድዛ፥ ዝን ይንትካ ይ አዳይፕ ስኤዛን ኦዛ» ዬጌዛ።<verse eid="JHN 8:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 8:39"/>ኡንቲ ማሂ፥ «ኑ አዳይ አፍራመ» ዬጌዛ።</para>
  <para style="p" vid="JHN 8:39">የሱሳ ኡንትኮ፥ «ይ አፍራመ ናእታ ማቄዛኮ ኤ ኦዛና ኦዳ። <verse eid="JHN 8:39"/><verse number="40" style="v" sid="JHN 8:40"/>ዝን ጾሳፕ ስኤዝ ቱማ ኦዴዝ ታና ይ ዎዳይስ ኮይዛ። አፍራመ Ꮊይ ጋርክ ኦካያ። <verse eid="JHN 8:40"/><verse number="41" style="v" sid="JHN 8:41"/>ይንቲ፥ ይ አዳይ ኦዛና ኦዛ» ዬጌዛ።</para>
  <para style="p" vid="JHN 8:41">ኡንቲ ማሂ፥ «ኑኒ ላግተር የልንቴዝ ናእታ ባያ፤ ኑስ ፐቲ አዳይ ጾሳይ ኣዳ የዛ» ዬጌዛ።<verse eid="JHN 8:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42"/>የሱሳ ኡንትኮ፥ «ጾሳይ ቱማ ይ አደ ማቄዛኮ ይ ታና ቃዳ፤ አብስ ጊኮ፥ ታ ጾስ ላንቀፕ ይኢ Ꮊይዳ የዛ። ታና ኤ ኪቴዛፕ አትን ታኒ ታ ማዉተር የኤካያ። <verse eid="JHN 8:42"/><verse number="43" style="v" sid="JHN 8:43"/>ታኒ ግዛ ይ ስኦዳይስ ኮዦዋ ግሾስ ታ ግዝ ባዝ ይንትስ ገሎያ። <verse eid="JHN 8:43"/><verse number="44" style="v" sid="JHN 8:44"/>ይንቲ፥ ይ አዳይ ጻለሃይ ናእታ። ማ ይንቲ፥ ይ አዳይ አሞትዝባዝ ኦዳይስ ኮይዛ። ኤ ቲናፕ አይኪ ሸምፖ ዎዛያ። ቱማ ኤዛር ባዛይ ግሾስ ኤ ቱማ እጽዛ። ዎርዶ ኤዝስ መ ማቄዝ ግሾኔ ኤ ዎርዶ አደኔ ዎርዶ ኦድንትታር ፓፕ ኦድንትዛ። <verse eid="JHN 8:44"/><verse number="45" style="v" sid="JHN 8:45"/>ታኒ ቱሮ ኦድዛ፥ ዝን ይ ታና አማኖያ። <verse eid="JHN 8:45"/><verse number="46" style="v" sid="JHN 8:46"/>ይንታፕ፥ ‹ኔኒ ናጋራ ኦዳር ታ በኤዛ› ጎዳይስ ዳንዳእዛይ ኦኖ? ታኒ ቱሮ ኦድንትዛባዝ ማቅኮ ታና አብስ ይ አማኖሳ? <verse eid="JHN 8:46"/><verse number="47" style="v" sid="JHN 8:47"/>ጾስ አሲ ጾሳይ ግዝ ባዝ ስእዛ። ይ ጾስ አስ ማቀካ ግሾስ ጾሳይ ግዝ ባዝ ስኦያ» ዬጌዛ።<verse eid="JHN 8:47"/></para>
  <para style="s1">የሱሳ አፍራመፕ ቲና</para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48"/>አይሁድታይ ማሂ፥ « ‹ኔኒ ሳማረ አሲ፤ ኔል ቱና አያና የዛ› ጉሳይድ ቡታ የኔ?» ዬጌዛ።<verse eid="JHN 8:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 8:49"/>የሱሳ ኡንትኮ «ታል አፋ ቱና አያና ባያ። ታኒ ታ አዳ ቦንችዛ፥ ዝን ይ ታና ካዉሽዛ። <verse eid="JHN 8:49"/><verse number="50" style="v" sid="JHN 8:50"/>ታኒ ታ ኡባስ ቦንቾ ኮዮያ፤ ታኒ ቦንችንቶድ ጋርክ ኮይዛይኔ ታስ ፕርድዛይ የዛ። <verse eid="JHN 8:50"/><verse number="51" style="v" sid="JHN 8:51"/>ታኒ ይንትስ ቱሮ ኦድዛ፤ ታ ቃላ ናግዝ ኦንካ Ꮊይቃሚ» ዬጌዛ።<verse eid="JHN 8:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 8:52"/>አይሁድታይ ማሂ፥ «ኔል አፋ ቱና አያና የዛና ኑኒ Ꮊት ኤሬዛ። አፍራመ Ꮊይቄዛ፤ ናብታይካ Ꮊይቄዛ። ዝን ኔኒ፥ ‹ታ ቃላ ናግዝ ኦንካ Ꮊይቃሚ› ዬግዛ። <verse eid="JHN 8:52"/><verse number="53" style="v" sid="JHN 8:53"/>ኔኒ Ꮊይቄዝ ኑ ኣዳ አፍራመፕ ኣኔ? ናብታይካ ማ Ꮊይቄዛ። ኔኒ ነና ኦና ግ ቆፔ?» ዬጌዛ።<verse eid="JHN 8:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 8:54"/>የሱሳ፥ «ታኒ ታና ቦንችኮ ታ ቦንቻይ ጨረ። ይ፥ ‹ኑ ጾሳ› ግዝ ታ አዳይ ኤ ታና ቦንችዛ። <verse eid="JHN 8:54"/><verse number="55" style="v" sid="JHN 8:55"/>ይ ኤዛ ኤራም እጽኮ ታኒ ኤዛ ኤርዛ። ታኒ ኤዛ ኤሮያ ጊኮ ይ ጋርክ ዎርዶትዛ። ዝን ታኒ ኤዛ ኤርዛ፤ ማ ኤ ቃላካ ታ ናግዛ። <verse eid="JHN 8:55"/><verse number="56" style="v" sid="JHN 8:56"/>አዳይ አፍራመ ታ ይእ ጋላሳ ብኢ ኡፋይቶዳይስ አሞቴዛ፤ ብእካ ኡፋይቴዛ» ዬጌዛ።<verse eid="JHN 8:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="JHN 8:57"/>አይሁድታይ ማሂ፥ «ሀራ አቶዝን፥ ኔስ እሻታም ላይ ኩመካዝን ዋይዚ አፍራመ በኤዛ ጌ?» ዬጌዛ።<verse eid="JHN 8:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="JHN 8:58"/>የሱሳ ኡንትኮ፥ «ታኒ ይንትስ ቱሮ ኦድዛ፤ አፍራመ የልንቶዳይፕ ቲን ታኒ የዛ» ዬጌዛ።<verse eid="JHN 8:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 8:59"/>የይ ግሾስ፥ ኡንቲ የሱሳ ሾጮዳይስ ሹች ኤኬዛ። ዝን የሱሳ ኡንታፕ ጌሚ ጾሳ ኬፕ ከዚ ቅቴዛ።<verse eid="JHN 8:59"/></para>
  <chapter eid="JHN 8"/>
  <chapter number="9" style="c" sid="JHN 9"/>
  <para style="s1">የሱሳ ቶአ ማቂ የልንቴዝ አ ፓዛ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1"/>የሱሳ Ꮊንግታር የልንቴዛይፕ ቶአ ማቂ የዝ ፐቲ አ በኤዛ። <verse eid="JHN 9:1"/><verse number="2" style="v" sid="JHN 9:2"/>ኤ ታማርታይ፥ «አስታማራዮ፥ Ꮊ አይ ቶአ ማቂ የልንቶድ ጋርክ ናጋራ ኦዛይ ኦኖ? ኤ ኦነኔ ኤዛ የሌዝታይ ኦኔ?» ዬጊ ኦይጬዛ።<verse eid="JHN 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 9:3"/>የሱሳ፥ «ጾሳ ኦሶ ኤዛል አፋ በንቶድ ጋርከፕ አትን ኤ ዎይ ኤዛ የሌዝታይ ናጋራ ኦዝ ግሾስ ባያ። <verse eid="JHN 9:3"/><verse number="4" style="v" sid="JHN 9:4"/>ጋላሳ የዝን ታና ኪቴዛይ ኦሳ ታ ኦዳይስ ቤዝዛ። ኦንካ ኦዳይስ ዳንዳኦዋ ቃማይ ይእዛ። <verse eid="JHN 9:4"/><verse number="5" style="v" sid="JHN 9:5"/>ታኒ አላማይድ የዛር አላማይስ ፖኦ» ዬጌዛ።<verse eid="JHN 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6"/>የሱሳ የያ ግ ሳአ ጩቴዛ። ፋ ጩቻይር ላፋ ቢታ ላክ የ ኡርቃይር ቶአ አይ አፋ ትዤዛ። <verse eid="JHN 9:6"/><verse number="7" style="v" sid="JHN 9:7"/>ዬዚ፥ «Ꮊንጊ ሳልሆመ ግዝ ተቅንቴዝ ሃ ነ አፋ ሜጭንቶባ» ዬጌዛ። (ሳላሆመ ጉሳይ ኪትንቴዛ ጉሲ) የይ ግሾስ፥ አይ Ꮊንጊ ፋ አፋ ሜጭንቲ ብእታር ማቄዛ።<verse eid="JHN 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 9:8"/>አይ ሾርታይኔ አይ ቲን ዎሶዳር በኤዝ አሳይ፥ «Ꮊይ በቲ ዎስዛ አ ባሳ?» ዬጌዛ።<verse eid="JHN 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 9:9"/>ፐቲ ፐቲ አሳይ፥ «Ꮊይ ኤዛ» ዬጌዛ።</para>
  <para style="p" vid="JHN 9:9">Ꮊንክታይ ማ፥ «ዋአ፥ Ꮊይ ኤዛ አዝዛፕ አትን ኤዛ ባያ» ዬጌዛ።</para>
  <para style="p" vid="JHN 9:9">ዝን አይ፥ «ኤ፥ ታና» ዬጌዛ።<verse eid="JHN 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 9:10"/>ኡንቲ ኤዝኮ፥ «የዝን ነ ኣፋይ ዋይዚ በኤኔ?» ዬጊ ኦይጬዛ።<verse eid="JHN 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 9:11"/>ኤ ማሂ፥ «የሱሳ ግዝ አይ ጽቃ ኡርቃ ላክ ታ አፋ ትዢ፥ ‹ሳልሆመ Ꮊንጊ ነ አፋ ሜጭንቶባ› ዬግን፥ ታኒ Ꮊንጊ ሜጭንቲ ብኢ አቴዛ» ዬጌዛ።<verse eid="JHN 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 9:12"/>ኡንቲ ኤዝኮ፥ «ኤ አባ የኔ?» ዬጊ ኦይጬዛ።</para>
  <para style="p" vid="JHN 9:12">አይ፥ «ታኒ ኤሮያ» ዬጌዛ።<verse eid="JHN 9:12"/></para>
  <para style="s1">ፈርሳወ አሳይ ሀኔዝባዛ ኤሮዳይስ ኮዬዛ</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13"/>ኡንቲ ቲን ቶአ፥ ዝን Ꮊት በኤዝ አ ፈርሳውታይኮ ካንጌዛ። <verse eid="JHN 9:13"/><verse number="14" style="v" sid="JHN 9:14"/>የሱሳ ኡርቃ ላክ አይ አፋ ፓዝ ጋላሳይ ማላ ጋላሲ። <verse eid="JHN 9:14"/><verse number="15" style="v" sid="JHN 9:15"/>የይ ግሾስ፥ አይ ዋይዚ በኤዛኮ ፈርሳወ አሳይ ኤዛ ማሂ ኦይጬዛ። አይ ኡንትኮ፥ «ኤ ታ ኣፋተ ጽቃ ኡርቃ ትዤዛ። ታ ኣፋ ሜጭንቲ Ꮊት ብእዛ» ዬጌዛ።<verse eid="JHN 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 9:16"/>ፈርሳውታይፕ ፐታይ ፐታይ፥ «Ꮊያ ኦዝ አይ ማላ ህገ ናጎዋ ግሾስ ጾሳፕ የኤካያ» ዬጌዛ።</para>
  <para style="p" vid="JHN 9:16">ዝን Ꮊንክታይ፥ «ናጋራንቾ አሲ Ꮊይ ጋርክ ማልታ ዋይዚ ኦዳይስ ዳንዳኤ?» ዬጊ ዎል ጋንጨ ሻክንቴዛ።<verse eid="JHN 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 9:17"/>የይ ግሾስ፥ ፈርሳወ አሳይ አይኮ፥ «ኤ ነ አፋ ብእሴዝ ግሾስ ነ ኤባዝ ዋጌ?» ዬጌዛ።</para>
  <para style="p" vid="JHN 9:17">አይ፥ «ኤ ናበ» ዬጌዛ።<verse eid="JHN 9:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 9:18"/>አይሁደ ሀላቅታይ፥ ኤ እንዳቶኔ አዳ ጼጊ ኦይጮድ ጋ፥ አይ ቲን ቶአ ማቄዛኔ Ꮊት ኤ ብእዛና አማነካያ። <verse eid="JHN 9:18"/><verse number="19" style="v" sid="JHN 9:19"/>ኡንቲ ኤ እንዳትኔ ኤ አዳይኮ፥ «ይ ‹ቶአ ማቂ የልንቴዛ› ግዝ ይ ናአይ Ꮊያ? የዝን፥ Ꮊት ዋይዚ በኤኔ?» ዬጊ ኦይጬዛ።<verse eid="JHN 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 9:20"/>ኤዛ የሌዝታይ፥ «Ꮊይ ኑ ናአ ማቄዛኔ ቶአ ማቂ ኤ የልንቴዛና ኑ ኤርዛ። <verse eid="JHN 9:20"/><verse number="21" style="v" sid="JHN 9:21"/>ዝን Ꮊት ኤ ዋይዚ በኤዛኮ ማ ኤ አፋ ኦኒ ፓዛኮ ኑኒ ኤሮያ። ኤዛ ኦይጮይታ። ኤ ፋና ኤሬዝ አስ ማቄዝ ግሾስ ፋባዝ ኦዶዳይስ ዳንዳእዛ» ዬጌዛ። <verse eid="JHN 9:21"/><verse number="22" style="v" sid="JHN 9:22"/>ኤዛ የሌዝታይ የያ ጌዛይ አይሁድታይስ ያሽቴዝ ግሾስ። አብስ ጊኮ፥ አይሁድታይ፥ የሱሳና ኤ ክርስቶሳ ዬጊ ማርካትዝ አሲ የዛኮ የ አ አይሁድታይ ዎሳ ኬፕ ባይኦዳይስ ቆፋ አጬዛ። <verse eid="JHN 9:22"/><verse number="23" style="v" sid="JHN 9:23"/>ኤዛ የሌዝታይ፥ «ኤ ፋና ኤሬዝ አሲ፤ ኤዛ ኦይጮይታ» ዬጌዛይ Ꮊያ።<verse eid="JHN 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24"/>የይ ግሾስ፥ ቶአ ማቂ የልንቴዝ አ ኡንቲ ማሂ ጼጊ፥ «ቱማ ኦዶዳይስ ጾሳ ቦንቾባ፤ Ꮊ አይ ናጋራንቾ ማቅዛና ኑ ኤርዛ» ዬጌዛ።<verse eid="JHN 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 9:25"/>አይ ማሂ፥ «ኤ ናጋራንቾ ማቄዛና፥ ታ ኤሮያ። ታኒ ቶአ ማቄዛናኔ Ꮊት ብእዛና ኣዳ ኤርዛ» ዬጌዛ።<verse eid="JHN 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 9:26"/>ኡንቲ ማሂ፥ «ኤ ኔስ አብ ኦኔ? ኤ ነ ኣፋ ዋይዚ ፓኔ?» ዬጌዛ።<verse eid="JHN 9:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 9:27"/>ኤ ኡንትኮ፥ «ታኒ ይንትስ ኦዴዛ፥ ዝን ይ ስኤካያ። አብስ ማቂ ማቂ ስኦዳይስ ኮይኔ? ይንትካ ኤ ታማረ ማቆዳይስ ኮይኔ?» ዬጌዛ።<verse eid="JHN 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 9:28"/>ኡንቲ ኤዛ ጫዢ፥ «ነ የ አይ ታማረ፤ ኑኒ ሙሰ ታማረ ጌዛ። <verse eid="JHN 9:28"/><verse number="29" style="v" sid="JHN 9:29"/>ጾሳይ ሙሰስ ኦዴዛና ኑኒ ኤርዛ፥ ዝን Ꮊ አይ ኤ አናፕ የኤዛኮካ ኑ ኤሮያ» ዬጌዛ።<verse eid="JHN 9:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 9:30"/>አይ ኡንትኮ፥ «ኤ አናፕ የኤዛኮ ይንቲ ኤሮዛይ ማላባዝ፥ ዝን ኤ ታ ኣፋ ፓዛ። <verse eid="JHN 9:30"/><verse number="31" style="v" sid="JHN 9:31"/>ጾሳ ቦንችዛኔ ኤ ኮይዝ ባዝ ኦዛ አ ጾስ ስኤዛፕ አትን ናጋራ ኦዝታ ስኦያ። <verse eid="JHN 9:31"/><verse number="32" style="v" sid="JHN 9:32"/>ሳሎ ሳአ መንቴዛይፕ ቶአ ማቂ የልንቴዝ አስ ኣፈ ፓዛይ ኦንካ ባያ። <verse eid="JHN 9:32"/><verse number="33" style="v" sid="JHN 9:33"/>Ꮊ አይ ጾሳፕ ኪትንተካዛኮ ፐትባዝካ ኦዳይስ ዳንዳኦያ» ዬጌዛ።<verse eid="JHN 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 9:34"/>ኡንቲ ማቂ፥ «ኔኒ ናጋራራ የልንቲ ድጬዛይ ኑና ታማርሶዳይስ ኮይኔ?» ዬጌዛ። ኡ ኤዛ አይሁድታይ ዎሳ ኬፕ ከሴዛ።<verse eid="JHN 9:34"/></para>
  <para style="s1">ዎዝና ቶአት</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35"/>የሱሳ ኡንቲ አ ባለ ከሴዛና ስኢ ኤዛ ሄሊ፥ «አስ ናአ ነ አማንኔ?» ዬጊ ኦይጬዛ።<verse eid="JHN 9:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 9:36"/>አይ የሱሳኮ፥ «ጎዳዮ፥ ታ ኤዛ አማኖድ ጋርክ ኤ ኦኖ? ታስ ኦዶየ?» ዬጌዛ።<verse eid="JHN 9:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 9:37"/>የሱሳ አይኮ፥ «ነ ኤዛ በኤዛ፤ Ꮊ ኔር ኦድንትዛይ ኤዛ» ዬጌዛ።<verse eid="JHN 9:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 9:38"/>አይ ማሂ፥ «ጎዳዮ፥ ታ አማንዛ» ዬጊ የሱሳስ ጎይኔዛ።<verse eid="JHN 9:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 9:39"/>የሱሳ፥ «ቶእታይ በአድ ጋርክ ብእዝታይ ቶኦዳይ ጋርክ ፕርዶዳይስ Ꮊ አላመ ታ የኤዛ» ዬጌዛ።<verse eid="JHN 9:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 9:40"/>ኤዛር የዝ ጽቃ ፈርሳወ አስታይ የያ ስኢ፥ «ኑ ቶአኔ?» ዬጊ ዎል ኦይጭቼዛ።<verse eid="JHN 9:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 9:41"/>የሱሳ፥ «ይ ቶእታ ማቄዛኮ ይንትስ ናጋራ ባያ። ዝን Ꮊት ይ ብእዛ ግዝ ግሾስ ይ፥ ይ ናጋራራ የዛ» ዬጌዛ።<verse eid="JHN 9:41"/></para>
  <chapter eid="JHN 9"/>
  <chapter number="10" style="c" sid="JHN 10"/>
  <para style="s1">ሄንግዛያኔ ኤ ዱርታ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1"/>የሱሳ፥ «ታኒ ይንትስ ቱሮ ኦድዛ፤ ዱር ካለ ጋንጨ ፐንገር ባዝን ሀራ ኦገር ገልዝ ኦንካ ካይዞኔ ፓኖ። <verse eid="JHN 10:1"/><verse number="2" style="v" sid="JHN 10:2"/>የያ ማቆዝን ፐንገር ገልዛይ ዱርታ ሄንግዛያ። <verse eid="JHN 10:2"/><verse number="3" style="v" sid="JHN 10:3"/>ፐንገ ናግዛይ ኤዝስ ፐንጋ ዶይዛ፤ ዱርታይካ ኤ ቃላ ስእዛ። ኤ ፋ ዱርታ ኡ ሱንይር ሱንይር ጼግዛ፤ ኡንታን ካል ባለ ከስዛ። <verse eid="JHN 10:3"/><verse number="4" style="v" sid="JHN 10:4"/>ኤ ኦዝ ፋስታ ባለ ከሴዛይፕ ጉየ ኡ ቲና ቲና የዛ። ኡንትካ ኤ ቃላ ኤርዛ ግሾስ ኤዛ ካልዛ። <verse eid="JHN 10:4"/><verse number="5" style="v" sid="JHN 10:5"/>ሀራ አስ ቃላ ኡንቲ ኤሮዋ ግሾስ ኤፕ ሃክዛፕ አትን ኤ ላሳ ካሎያ» ዬጌዛ።<verse eid="JHN 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 10:6"/>የሱሳ ኡንትስ Ꮊ ኣዝሳ ኦዴዛ፥ አብ ኦዴዛኮ ኡንቲ አካከካያ።<verse eid="JHN 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7"/>ማሂ የሱሳ ኡንትኮ፥ «ታኒ ይንትስ ቱሮ ኦድዛ፤ ታ ዱርታይስ ፐንገ። <verse eid="JHN 10:7"/><verse number="8" style="v" sid="JHN 10:8"/>ታፕ ቲን የኤዝ ኡቢታይ ካይዞኔ ፓኖ፥ የያ ማቃዳር ዱርታይ ኡንታን ስኤካያ። <verse eid="JHN 10:8"/><verse number="9" style="v" sid="JHN 10:9"/>ፐንጋይ ታና፤ ታ ባጋር ገልዛ ኦንካ አቶዳ። ኤ ታ ባጋር ገሎዳኔ ከዞዳ፤ ሎኦ ሄንግንትዝ አቆ ደማዳ። <verse eid="JHN 10:9"/><verse number="10" style="v" sid="JHN 10:10"/>ካይዞ ካስቶዳይስ፥ ሹኮዳይስኔ ብሶዳይስ ይእዛፕ አትን ሀራባዝስ የኦያ። ታኒ ኡንትስ ደኦ የዞድ ጋርከራኔ ኩሚ ፉጮድ ጋርክ የኤዛ።<verse eid="JHN 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11"/>«ታኒ ሎኦ ሄንንቾ፤ ሎኦ ሄንንቻይ ፋ ዱርታይ ግሾስ ፋ ሸምፖ ኣ እንግዛ። <verse eid="JHN 10:11"/><verse number="12" style="v" sid="JHN 10:12"/>ከራ ሄንግዝ አስ ዱርታይ ጎዳነ ሄንንቾ ባዛይ ግሾስ ፉገ ይእኮ ብኢ ዱርታ አሺ ሀልእዛ። የይ ግሾስ፥ ሱመ ዱርታ አይኪ ላልዛ። <verse eid="JHN 10:12"/><verse number="13" style="v" sid="JHN 10:13"/>ከራ ሄንግዛይ ሚሸስ ሄንግዝ ግሾኔ ዱርታይባዝ ኤዛ ቆፍሶዋ ግሾስ ዱርታ አሺ ላስዛ።<verse eid="JHN 10:13"/></para>
  <para style="p">
    <verse number="14-15" style="v" sid="JHN 10:14-15"/>«ታኒ ሎኦ ሄንንቾ። ታ አዳይ ታና ኤርዛይ ጋርክ ታንካ ታ አዳ ኤርዛ። የይ ጋርከካ፥ ታ ታ ዱርታ ኤርዛ፤ ታ ዱርታይካ ታና ኤርዛ። ታኒ ታ ዱርታይ ግሾስ ታ ሸምፖ ኣ እንግዛ። <verse eid="JHN 10:14-15"/><verse number="16" style="v" sid="JHN 10:16"/>Ꮊ ዉዳይድ ባ ሀራ ዱርታይ ታስ የዛ። ታኒ ኡንታናካ ኮኦዳይስ ቤዝዛ። ኡንቲ ታ ቃላ ስኦዳ፤ ኡንቲ ፐቲ ዉደ ማቃዳ፤ ሄንንቻይካ ፐታ።<verse eid="JHN 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 10:17"/>«ታኒ ታ ሸምፖ ኣ እንጊ ማሂ ኤክዝ ግሾስ ታ አዳይ ታና ዶሴዛ። <verse eid="JHN 10:17"/><verse number="18" style="v" sid="JHN 10:18"/>ታ ዶስዛ ታ ሸምፖ ኣ እንግዛይፕ አትን ታፕ ኦንካ ኤከና። ታ ታ ሸምፖ ኣ እማዳይስኔ ማሂ ኤኮዳይስ ስልጻኔ ታስ የዛ። ታኒ ኦድ ጋርክ ታ አዳይ ታና ኪቴዛይ Ꮊያ» ዬጌዛ።<verse eid="JHN 10:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 10:19"/>የያ ኤ ጌዝ ግሾስ አይሁድታይ ጋንጨ ማካ ሻኮተ መንቴዛ። <verse eid="JHN 10:19"/><verse number="20" style="v" sid="JHN 10:20"/>ኡንታፕ ጋመ ባጋይ፥ «ኤዛር ቱና አያና የዛ! ኤ ኤይዛ! ኤ ግዝ ባዝ አብስ ስእኔ?» ዬጌዛ።<verse eid="JHN 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 10:21"/>Ꮊንክታይ ማ፥ «ጻላሄ አይኬዝ አስ Ꮊይ ጋርክ ኦድንቶያ። ቱና አያና ቶአ ኣፈ ቤዞዳይስ ዳንዳእኔ?» ዬጌዛ።<verse eid="JHN 10:21"/></para>
  <para style="s1">የሱሳ አስ ናአ</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22"/>የሩሳላመ ጾሳ ኬ ኦሮዝ ጋላስታይ ቦንችዛ ባለ ሄሌዛ፤ የ ዎደ ሳአ ባርጎ። <verse eid="JHN 10:22"/><verse number="23" style="v" sid="JHN 10:23"/>የሱሳ ጾሳ ኬ ሶሎሞነ ባራንዳር ዩይዛ። <verse eid="JHN 10:23"/><verse number="24" style="v" sid="JHN 10:24"/>አይሁድታይ የሱሳ ላንቃይድ ሺቂ ኤቂ፥ «ኔኒ ኑና አይደ ሄሎዳይስ ስር ጋዶዴ? ኔኒ ክርስቶሳ ማቅኮ አን ኑስ ጌሺ ኦዶባ» ዬጌዛ።<verse eid="JHN 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 10:25"/>የሱሳ ማቂ ኡንትኮ፥ «ታኒ ይንትስ ኦዴዛ፤ ዝን ይ ታና አማኖያ። ታኒ ታ አዳይ ታስ እንጌዝ ማዉተር ኦዛ ኦሳይ ታባዝ ማርካትዛ። <verse eid="JHN 10:25"/><verse number="26" style="v" sid="JHN 10:26"/>ዝን ታኒ ይንትስ ኦዴዛይ ጋርክ ይ ታ ዱረ ማቀካ ግሾስ አማኖያ። <verse eid="JHN 10:26"/><verse number="27" style="v" sid="JHN 10:27"/>ታ ዱርታይ ታ ቃላ ስኦዳ። ታ ኡንታን ኤርዛ፤ ኡንትካ ታና ካልዛ። <verse eid="JHN 10:27"/><verse number="28" style="v" sid="JHN 10:28"/>ታኒ ኡንትስ መና ደኦ እንግዛ፤ ኡንቲ ኡባራካ ባሚ። ኦንካ ታ ኩሸፕ ኡንታን ቦንቂ ኤኮዳይስ ዳንዳኦያ። <verse eid="JHN 10:28"/><verse number="29" style="v" sid="JHN 10:29"/>ኡንታን ታስ እንጌዝ ታ አዳይ ኡባፕ ኣዛ ኦንካ ታ አዳይ ኩሸፕ ኡንታን ቦንቂ ኤኮዳይስ ዳንዳኦያ። <verse eid="JHN 10:29"/><verse number="30" style="v" sid="JHN 10:30"/>ታኔ ታ አዳይ ፐቶ» ዬጌዛ።<verse eid="JHN 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31"/>አይሁድታይ የሱሳ ሾጮዳይስ ማካ ሹች ደንዛ። <verse eid="JHN 10:31"/><verse number="32" style="v" sid="JHN 10:32"/>የሱሳ ኡንትኮ፥ «ታኒ ኦድ ጋርክ ታ አዳይ ታስ እንጌዝ ጋመ ሎኦ ኦስታ ይንታን ኦ ቤዝዛ። የይትታይፕ ኣያይ ግሾስ ታና ሹቻር ሾጮዳይስ ኮይኔ?» ዬጌዛ።<verse eid="JHN 10:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33"/>አይሁድታይ ማሂ፥ «ኑኒ ነና ነ ሎኦ ኦሶ ግሾስ ሹቻር ሾጮዳይስ ኮዮያ። ዝን ኔኒ ጾስ ጫዤዝ ግሾኔ አስ ማቅታር ነ ነና ጾስ ግዝ ግሾስ» ዬጌዛ።<verse eid="JHN 10:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 10:34"/>የሱሳ ማሂ፥ «ጌሻ ማጻፋይድ ጾሳይ፥ ‹ይ ጾስታ› ጌዛይ ጻፍንተካሳ? <verse eid="JHN 10:34"/><verse number="35" style="v" sid="JHN 10:35"/>ጌሻ ማጻፋይ መናስ ላምንታሚ። ጾሳይ ፋ ቃላ እንጌዝ አስታ፥ ‹ጾስታ› ግ ጼግኮ፥ <verse eid="JHN 10:35"/><verse number="36" style="v" sid="JHN 10:36"/>ታ ታና ጾስ ናአ ጌዛይስ፥ አዳይ ማራጺ Ꮊ አላመ ኪቴዝ ታና ጾስ ናአ ዋይዚ ‹ጾሳ ነ ጫዥዛ› ዬጌ? <verse eid="JHN 10:36"/><verse number="37" style="v" sid="JHN 10:37"/>ታኒ ታ አዳይ ኦዛና ኦም እጽኮ ታና አማንፓተ። <verse eid="JHN 10:37"/><verse number="38" style="v" sid="JHN 10:38"/>ዝን ታኒ ኦዛባዝ ማቅኮ ይንቲ ታና አማናም እጽኮካ፥ ታ አዳይ ታር የዛኔ ታካ ታ አዳይር የዛና ይ ኤሮድ ጋርክ ታ ኦሳ አማኖይታ» ዬጌዛ።<verse eid="JHN 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 10:39"/>ማካ ኡንቲ ኤዛ አይኮዳይስ ኮዬዛ፥ ዝን ኤ ኡንታፕ ቡቲ ከዜዝ።<verse eid="JHN 10:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 10:40"/>ዋንሳ ቲን ጻማቅዛ አቃ፥ ዮርዳኖሳ ቦርካፕ ሰኮ ፕኖ የሱሳ ፒንጊ ኤዛይድ ጋምኤዛ። <verse eid="JHN 10:40"/><verse number="41" style="v" sid="JHN 10:41"/>ጋመ አሳይ የሱሳኮ ይኢ፥ «ዋንሳ ማላታ ኦካያ፥ ዝን ኤ Ꮊ አያባዝ ኦዴዝባዛይ ኡባይ ቱማ» ዬጌዛ። <verse eid="JHN 10:41"/><verse number="42" style="v" sid="JHN 10:42"/>ኤዛይድ ጋመ አሳይ የሱሳ አማኔዛ።<verse eid="JHN 10:42"/></para>
  <chapter eid="JHN 10"/>
  <chapter number="11" style="c" sid="JHN 11"/>
  <para style="s1">አላዛራ Ꮊይቆ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1"/>ብታና ሄራ አላዛራ ግዝ ፐቲ አይ ሀርግንቴዛ። ብታና ማይራምራኔ እ ምሽት ማርታራ የዛ ሄራ። <verse eid="JHN 11:1"/><verse number="2" style="v" sid="JHN 11:2"/>ማይራማ ጎዳይ ቶካ ሽቶ ትዤዝ ፋ ብናናይራካ ኤ ቶካ ኡጬዛኖ። ሀርግንቴዛይ እ እሻ አላዛራ። <verse eid="JHN 11:2"/><verse number="3" style="v" sid="JHN 11:3"/>የይ ግሾስ፥ ምሹንካ፥ «ጎዳዮ፥ ነ ዶስዛይ ሀርግንቴዛ» ግ የሱሳኮ ኪቴዛ።<verse eid="JHN 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4"/>የሱሳ የያ ስኢ «Ꮊ ሀርጋይ፥ ጾሳይኔ ኤ ናአይ ቦንችንቶድ ጋርከፕ አትን Ꮊይቆስ ሄልዝ ሀርገ ባያ» ዬጌዛ።<verse eid="JHN 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 11:5"/>የሱሳ ማርታ፥ እ ምሽቶኔ አላዛራ ቃዛ። <verse eid="JHN 11:5"/><verse number="6" style="v" sid="JHN 11:6"/>ዝን አላዛረ ሀርግንቴዛ ግን የሱሳ ስኢ ፋ የዛ አቆ ናምኢ ጋላስ ጋምኤዛ። <verse eid="JHN 11:6"/><verse number="7" style="v" sid="JHN 11:7"/>የይፕ ጉየ፥ የሱሳ ፋ ታማርታይኮ፥ «ማሂ ይሁዳ ቢታ ዎላ Ꮊማዳ» ዬጌዛ።<verse eid="JHN 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 11:8"/>ኤ ታማርታይ ማሂ፥ «አስታማራዮ፥ ጽቃ ዎደፕ ቲን አይሁድታይ ነና ሹቻር ሾጪ ዎዳይስ ኮዬዛኔ፤ Ꮊተካ ገደ Ꮊማዴ?» ዬጌዛ።<verse eid="JHN 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 11:9"/>የሱሳ፥ «ፐቲ ጋላሳ ጋንጨ ታጶ ናምኢ ሳት ባሳኔ? ጋላስ የዝ አሲ Ꮊ አላመ ፖአ ብእዛ ግሾስ ብንታሚ። <verse eid="JHN 11:9"/><verse number="10" style="v" sid="JHN 11:10"/>ዝን ቃማ የዝ ኦንካ ፖኦ ባዛይ ግሾስ ብንትዛ» ዬጌዛ። <verse eid="JHN 11:10"/><verse number="11" style="v" sid="JHN 11:11"/>የሱሳ የያ ጌዛይፕ ጉየ ኡንትኮ፥ «ኑ ቃዛ አላዛረ ገንቴዛ፥ ዝን ኤዛ ደንዳይስ ታኒ Ꮊማዳ» ዬጌዛ።<verse eid="JHN 11:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 11:12"/>ኤ ታማርታይ ማሂ፥ «ጎዳዮ፥ ኤ ገንቴዝባዝ ማቅኮ ኤስ ሎኦዳ» ዬጌዛ።<verse eid="JHN 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 11:13"/>የሱሳ አላዛረ Ꮊይቄዛይ ግሾስ የያ ኦዴዛ፥ ዝን ኡንትስ ጨር ገንታ ኣዝዛ። <verse eid="JHN 11:13"/><verse number="14" style="v" sid="JHN 11:14"/>የይ ግሾስ፥ የሱሳ ቆንጭሲ ኡንትኮ፥ «አላዛረ Ꮊይቄዛ። <verse eid="JHN 11:14"/><verse number="15" style="v" sid="JHN 11:15"/>ይ አማኖድ ጋርክ ታኒ የ አቃይድ ባ ማቄዛይስ ይ ግሾስ ታና ኡፋይስዛ። አን የይታ፤ ኤዝኮ ዎላ Ꮊማዳ» ዬጌዛ።<verse eid="JHN 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16"/>የይፕ ጉየ፥ ድድሞሳ ግንትንትዝ ቶማሳ ፋ ላገ ታማርታይኮ፥ «አስታማራይር Ꮊይቆዳይስ ኑካ ዎላ Ꮊማዳ» ዬጌዛ።<verse eid="JHN 11:16"/></para>
  <para style="s1">የሱሳ ደንዶኔ ደኦ</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17"/>የሱሳ ብታና ሄሎዳር አላዛረ ሞግንትን ኦይዲ ጋላስ ማቄዛ። <verse eid="JHN 11:17"/><verse number="18" style="v" sid="JHN 11:18"/>ብታና የሩሳላመፕ ሀይ ክሎ ምትረ ጋርክ ሃክዛ። <verse eid="JHN 11:18"/><verse number="19" style="v" sid="JHN 11:19"/>ጋመ አይሁድታይ ማርታኔ ማይራሞ ኡ እሻይ Ꮊይቄዛይስ ምንዳይስ የኤዛ።<verse eid="JHN 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 11:20"/>ማርታ የሱሳ የኤዛና ስኢ ኤዛ ሞኮዳይስ ከዜዝ፥ ዝን ማይራማ ኬ አቴዛ። <verse eid="JHN 11:20"/><verse number="21" style="v" sid="JHN 11:21"/>ማርታ የሱሳኮ፥ «ጎዳዮ፥ ኔኒ Ꮊይዳ የዛ ማቄዛኮ ታ እሻይ Ꮊይቃም። <verse eid="JHN 11:21"/><verse number="22" style="v" sid="JHN 11:22"/>ዝን Ꮊት ማቅኮካ ኔኒ ዎስዛ ባዝ ጾሳይ ኔስ እማዳና ታኒ ኤርዛ» ዬጌዛ።<verse eid="JHN 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 11:23"/>የሱሳ፥ «ነ እሻይ Ꮊይቆፕ ደንዶዳ» ዬጌዛ።<verse eid="JHN 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 11:24"/>ማርታ ኤዝኮ፥ «ዉርስ ጋላስ ኤ Ꮊይቆፕ ደንዶዳና ታ ኤርዛ» ዬጌዛ።<verse eid="JHN 11:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 11:25"/>የሱሳ እዝኮ፥ «ታኒ ደንዶኔ ደኦ፤ ታና አማንዛ ኦንካ Ꮊይቅኮካ ደኦር የዞዳ። <verse eid="JHN 11:25"/><verse number="26" style="v" sid="JHN 11:26"/>ማ ደኦር የዛይኔ ታና አማንዛ ኦንካ Ꮊይቃም። የያ ነ አማንኔ?» ዬጌዛ።<verse eid="JHN 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 11:27"/>ማርታ ማሂ፥ «ጎዳዮ፥ ኤ ታኒ አማንዛ! ኔኒ ጾስ ናአ፥ አላመ የኦዳይስ የዛ ክርስቶሳ ማቅዛና ታኒ አማንዛ» ዬጌዛ።<verse eid="JHN 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28"/>ማርታ የያ ጌዛይፕ ጉየ፥ Ꮊንጊ ፋ ምሽቶ ጌማ ጼጊ፥ «አስታማራይ ይኢ ነና ኮይዛ» ዬጌዛ። <verse eid="JHN 11:28"/><verse number="29" style="v" sid="JHN 11:29"/>ማይራማ የያ ስኢ ኤልሲ ደንዲ የሱሳኮ Ꮊንጌዛ። <verse eid="JHN 11:29"/><verse number="30" style="v" sid="JHN 11:30"/>የ ዎደ የሱሳ ማርታ ኤዛ ሞኬዝ አቆ የዛ፤ ሀጋ ሄራ ሄለካያ። <verse eid="JHN 11:30"/><verse number="31" style="v" sid="JHN 11:31"/>ማይራሞ ምንታር እዝር ካራ የዝ አይሁድታይ፥ እዛ ደንዲ ኤልሲ ባለ ከዜዛያ ብኢ፥ ዱፎ Ꮊንጊ ዬኮዳይስ ሀንዛ ኣዝን እዞ ካሊ ከዜዝ።<verse eid="JHN 11:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32"/>ማይራማ የሱሳ የዛ አቃ Ꮊንጊ ኤዛ ብኢ ኤ ቶካይል አፋ ጉጲንጊ፥ «ጎዳዮ፥ ኔኒ Ꮊይዳ የዛ ማቄዛኮ ታ እሻይ Ꮊይቃምዝን» ዬጌዛ።<verse eid="JHN 11:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 11:33"/>የሱሳ ማይራምኔ ኢር የዝ፥ አይሁድታይ ዬክዛና ብኢ፥ ፋ ዎዝናር ኢታ ምጭንቲ፥ <verse eid="JHN 11:33"/><verse number="34" style="v" sid="JHN 11:34"/>«አባ ሞጌኔ?» ዬጊ ኦይጭን፥ «ጎዳዮ፥ ይኢ ቦኦባ» ዬጊ ማሄዛ።<verse eid="JHN 11:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 11:35"/>የሱሳ አፉጼዛ። <verse eid="JHN 11:35"/><verse number="36" style="v" sid="JHN 11:36"/>የይ ግሾስ፥ አይሁድታይ፥ «ኤ አላዛራ አብ ጋርክ ቃዛኮ ቦኦይታ» ዬጌዛ።<verse eid="JHN 11:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 11:37"/>ዝን ኡንታፕ ፐታይ ፐታይ፥ «Ꮊይ ቶአ ብእሴዛይ Ꮊ አይ Ꮊይቃም ጋርክ ኦዳይስ ዳንዳአሞኔ?» ዬጌዛ።<verse eid="JHN 11:37"/></para>
  <para style="s1">የሱሳ አላዛራ Ꮊይቆፕ ደንዛ</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38"/>ማካ የሱሳ ምጭንቲ፥ አላዛረ ሞግንቴዝ ዱፋ ቅቴዛ። የ ዱፋይ ሹቻር ጎርድንቴዝ ኮምኦ። <verse eid="JHN 11:38"/><verse number="39" style="v" sid="JHN 11:39"/>የሱሳ፥ «ሹቻ ደንይታ» ዬጊ ኪቴዛ።</para>
  <para style="p" vid="JHN 11:39">ማርታ፥ «ጎዳዮ፥ ኤ Ꮊይቄዛይፕ ኦይዲ ጋላስ ማቄዝ ግሾስ Ꮊት ዜቆዳ» ዬጌዛ።<verse eid="JHN 11:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 11:40"/>የሱሳ ማርታኮ፥ «ነ አማንዛባዝ ማቅኮ ጾስ ቦንቾ በአዳና ታኒ ኔስ ኦደካሳ?» ዬጌዛ። <verse eid="JHN 11:40"/><verse number="41" style="v" sid="JHN 11:41"/>ኡንቲ ሹቻ ደንን የሱሳ ሳሎ ፑደ ብኢ፥ «አዳዮ፥ ታና ነ ስኤዝ ግሾስ ነና ጋላትዛ። <verse eid="JHN 11:41"/><verse number="42" style="v" sid="JHN 11:42"/>ነ ኡባ ዎደ ታና ስእዛና ታኒ ኤርዛ። ዝን Ꮊይዳ ኤቄዝ አሳይ ኔኒ ታና አዛዜዛና አማኖዳይ ጋርክ ታኒ ኡ ግሾስ Ꮊያ ግዛ» ዬጌዛ። <verse eid="JHN 11:42"/><verse number="43" style="v" sid="JHN 11:43"/>የሱሳ የያ ጌዛይፕ ጉየ፥ ፋ ቃላ ቅ ኡዲ፥ «አላዛራ፥ Ꮊና ከዞባ!» ዬጌዛ። <verse eid="JHN 11:43"/><verse number="44" style="v" sid="JHN 11:44"/>Ꮊይቄዝ አይ ዝትር ኩሻይኔ ቶካይ ሻሎር አጭንቲ የዝን ኤ ኣፈ ባጋይ ጎዝንቴዝን ዱፋይፕ ከዜዝ። የሱሳ ኡንታን፥ «ብሎይታ! Ꮊመ ጎይታ!» ዬጌዛ።<verse eid="JHN 11:44"/></para>
  <para style="s1">ክርስቶሳል አፋ ቶቤዛ</para>
  <para style="r">(<ref loc="MAT 26:1-5">ማቶ. 26:1-5</ref>፤ <ref loc="MRK 14:1-2">ማር. 14:1-2</ref>፤ <ref loc="LUK 22:1-2">ሉቃ. 22:1-2</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45"/>የይ ግሾስ፥ ማይራምኮ የኤዝ አይሁድታይፕ ጋምታይ የሱሳ ኦዛና ብኢ ኤዛ አማኔዛ። <verse eid="JHN 11:45"/><verse number="46" style="v" sid="JHN 11:46"/>ዝን ኡንታፕ ፐታይ ፐታይ ፈርሳውታይኮ Ꮊንጊ የሱሳ ኦዛና ኡንትስ ኦዴዛ። <verse eid="JHN 11:46"/><verse number="47" style="v" sid="JHN 11:47"/>የይፕ ጉየ፥ ቄሰ ሀላቅታይኔ ፈርሳወ አሳይ ሻንጎ ሺሺ፥ «Ꮊ አይ ጋመ ማላ ኦዝ ግሾስ ኑ አብ ኡዶ? <verse eid="JHN 11:47"/><verse number="48" style="v" sid="JHN 11:48"/>ኑኒ ኤዛ ስእ ግ አሽኮ አስ ኡባይ ኤዛ አማኖዳ። ማ ኦሮመ ቢታ አሳይ ይኢ ኑ ጾሳ ካራኔ ኑ ጋዳ ብሶዳ» ዬጌዛ።<verse eid="JHN 11:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49"/>ኡንታፕ ፐታይ ቃያፋ ግዛይ፥ የ ላይ ቄሰ ሀላቃ ማቄዛይ፥ «ይ አብካ ኤሮያ! <verse eid="JHN 11:49"/><verse number="50" style="v" sid="JHN 11:50"/>አሳይ ኡቢታይ ብዛይፕ አስ ኡባይ ግሾስ ፐቲ አስ Ꮊይቅዛይ ሎኦ ማቅዛና ይ ኤሮሳ?» ዬጌዛ። <verse eid="JHN 11:50"/><verse number="51" style="v" sid="JHN 11:51"/>ኤ የያ ፓፕ ጌካያ። ዝን (የ ላይ ቄሰ ሀላቃ ማቅዝ ግሾስ የሱሳ አይሁደ አስ ግሾስ Ꮊይቆዳይስ ቤዝዛና ትንቢተ ኦዴዛ። <verse eid="JHN 11:51"/><verse number="52" style="v" sid="JHN 11:52"/>ማ የሱሳ አይሁደ አስ ኣዳስ ባዝን ላልንቲ የዝ ጾሳ አሲ ኡባ ዎላል ሺሾዳይስኔ ፐቲ አሲ ኦዳይስ Ꮊይቆዳ።)<verse eid="JHN 11:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 11:53"/>የ ጋላሳፕ አይኪ ኡንቲ ኤዛ ዎዳይስ ቶቤዛ። <verse eid="JHN 11:53"/><verse number="54" style="v" sid="JHN 11:54"/>የይ ግሾስ፥ የሱሳ አይሁድታይ ጋንጨ ጌሻር ዩየካያ። ዝን ሊዦ ደንባ ላንቀ የዝ ኤፍሬመ ሄራ Ꮊንጌዛ። ፋ ታማርታይር የ አቃይድ ጋምኤዛ።<verse eid="JHN 11:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55"/>አይሁድታይ ቦንችዛ ፓዝቃ ጋላሳይ ኡኬዛ። ማ ጋመ አሳይ ፋና ቃሾዳይስ ፓዝቃ ቦንችዛ ጋላሳይ ሄሎዳይፕ ቲና የ ቢታፕ የሩሳላመ ቅቴዛ። <verse eid="JHN 11:55"/><verse number="56" style="v" sid="JHN 11:56"/>ኡንቲ ጾሳ ኬ ኤቂ የሱሳ ይእ ናግዛ ግሾስ «አብ ቆፔ? የሱሳ ባላ ቦንቾዳይስ የኦሳ?» ዬጊ ፐታይ ፐታ ኦይጬዛ። <verse eid="JHN 11:56"/><verse number="57" style="v" sid="JHN 11:57"/>ቄሰ ሀላቅታይኔ ፈርሳወ አሳይ የሱሳ አይኮዳይስ፥ ኤ የዛበሳ ኤርዛ ኦንካ ፓስ ኦዶድ ጋርክ ኪቴዛ።<verse eid="JHN 11:57"/></para>
  <chapter eid="JHN 11"/>
  <chapter number="12" style="c" sid="JHN 12"/>
  <para style="s1">የሱሳና ሽቶ ትዤዝ አስቶ</para>
  <para style="r">(<ref loc="MAT 26:6-13">ማቶ. 26:6-13</ref>፤ <ref loc="MRK 14:3-9">ማር. 14:3-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1"/>ፓዝቃ ቦንችዛ ጋላስፕ ኡሱፑን ጋላስ ቲናቲ፥ የሱሳ Ꮊይቆፕ ደንዝ አላዛረ የዝ ሄራ፥ ብታና ቅቴዛ። <verse eid="JHN 12:1"/><verse number="2" style="v" sid="JHN 12:2"/>የ አቃይድ ኡንቲ ኤስ ካሆ ጊግሴዛ። አላዛረ የሱሳር ዎላል ሙንታል በቴዝን ማርታ ኡንታን ሞክዛ። <verse eid="JHN 12:2"/><verse number="3" style="v" sid="JHN 12:3"/>ማይራማ ናርዶሳ ግዝ ጋመ አልኦ ጌሽ ሽቶ ክኢ የሱሳ ቶካ ትዤዛ። ፋ ብናናይር ኤ ቶካ ኡጬዛ፤ ኬ ኡባይ ሽቶ ሳዎር ቶንክ ጌዛ።<verse eid="JHN 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 12:4"/>ዝን የሱሳ ታማርታይፕ ፐታይ፥ የሱሳ ኣ እንጎዳይ፥ አስቆሮቶ ይሁዳ፥ <verse eid="JHN 12:4"/><verse number="5" style="v" sid="JHN 12:5"/>«አብስ Ꮊ ሽታይ ሀይ ጼት ድናረ ባይዝንቲ፥ ሚሻይ ማንቅታይስ እንግንቶሳ?» ዬጌዛ። <verse eid="JHN 12:5"/><verse number="6" style="v" sid="JHN 12:6"/>(ኤ ካይዞ ማቄዝ ግሾስ የያ ጌዛፕ አትን ማንቅታይስ ቃንቲ ጌካያ። ኤ ሚሸ ቁርቦ አይክዛ ማቄዝ ግሾስ ኡባ ዎደ ኤዛይፕ ፓስ ኤክዛ።)<verse eid="JHN 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7"/>የሱሳ፥ «እዛ ፓስ የዛ ባዝ ታ ሞጎ ጋላስስ ምንጄዝ ግሾስ እዞ አሾይታ። <verse eid="JHN 12:7"/><verse number="8" style="v" sid="JHN 12:8"/>ማንቅታይ ኡባ ዎደ ይንታር የዞዳ፥ ዝን ታኒ ኡባ ዎደ ይንታር የዛሚ» ዬጌዛ።<verse eid="JHN 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9"/>የ ዎደ ጋመ አሳይ የሱሳ ብታና የዛና ስኢ ገደ Ꮊንጌዛ። ኡንቲ የሱሳ ኣዳ ባዝን ኤ Ꮊይቆፕ ደንዝ አላዛራካ በአዳይስ Ꮊንጌዛ። <verse eid="JHN 12:9"/><verse number="10" style="v" sid="JHN 12:10"/>የይ ግሾስ፥ ቄሰ ሀላቅታይ አላዛራካ ማ ዎዳይስ ቶቤዛ። <verse eid="JHN 12:10"/><verse number="11" style="v" sid="JHN 12:11"/>አብስ ጊኮ፥ አላዛራ ባጋር ጋመ አይሁድታይ ኡንታን እጺ የሱሳና አማንዛ።<verse eid="JHN 12:11"/></para>
  <para style="s1">የሱሳ ቦንቾር የሩሳላመ ገሌዛ</para>
  <para style="r">(<ref loc="MAT 21:1-11">ማቶ. 21:1-11</ref>፤ <ref loc="MRK 11:1-11">ማር. 11:1-11</ref>፤ <ref loc="LUK 19:28-40">ሉቃ. 19:28-40</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12"/>ዎንት ጋላስ ፓዝቃ ቦንችዛ አቆ የኤዝ ዎያ የሱሳ የሩሳላመ Ꮊንግዛ ስኢ፥ <verse eid="JHN 12:12"/><verse number="13" style="v" sid="JHN 12:13"/>ዛምባ ሀየ ኤኪ ኤዛ ሞኮዳይስ ከዜዝ። ፋ ቃላ ቅ ኡዲ፥</para>
  <para style="q1" vid="JHN 12:13">«ሆሳና! ጾሳይ ጋላትንቶ!</para>
  <para style="q1" vid="JHN 12:13">ጎዳይ ሱንር ይእዛይ አንጅንቶ!</para>
  <para style="q1" vid="JHN 12:13">ጾሳ እስሬለ ካታይ አንጅንቶ!»</para>
  <para style="m" vid="JHN 12:13">ዬጌዛ።<verse eid="JHN 12:13"/></para>
  <para style="p">
    <verse number="14-15" style="v" sid="JHN 12:14-15"/>ጌሻ ማጻፋይድ፥</para>
  <para style="q1" vid="JHN 12:14-15">«ጽዮነ ካታምትስ፥ ያሽትፐ!</para>
  <para style="q2" vid="JHN 12:14-15">ዬዛኮ፥ ነ ካታይ ሀረ ናአል አፋ በቲ ይእዛ»</para>
  <para style="m" vid="JHN 12:14-15">ጊንትንቴዛይ ጋርክ የሱሳ ሀረ ናአ ደንጊ ኤዛ ቶጌዛ።<verse eid="JHN 12:14-15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16"/>የሱሳ ታማርታይ የያ ቲን አካኬካያ። ዝን የሱሳ ቦንችንተዛይፕ ጉየ ኡንቲ የያ ኡባ አካኬዛ። የይ ኡባይ ጌሻ ማጻፋይ ጌዛይ ጋርክ ሀኔዛ።<verse eid="JHN 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17"/>የሱሳ አላዛራ ዱፎፕ ጼጊ፥ Ꮊይቆፕ ደንዝ ዎደ ኤዛር የዝ ጋመ አሳይ የሱሳ ኦሳ ማርካቴዛ። <verse eid="JHN 12:17"/><verse number="18" style="v" sid="JHN 12:18"/>ጋመ አሳይ ኤዛ ሞኮዳይስ ከዜዛይ፥ ኤ የ ማልታ ኦዛና ስኤዝ ግሾሲ። <verse eid="JHN 12:18"/><verse number="19" style="v" sid="JHN 12:19"/>የይ ግሾስ፥ ፈርሳወ አሳይ ፐታይ ፔታይኮ፥ «ኑ አብካ ኦዳይስ ዳንዳኦዛ ቦኦይታ፤ ዎያ ኡባይ ኤዛ ካልዛ» ዬጌዛ።<verse eid="JHN 12:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20"/>ፓዝቃ ቦንችዛ ጋላስ ጎይኖዳይስ የሩሳላመ Ꮊንጌዝታይ ጋንጨ ፐቲ ፐቲ ግርከ አሳይ የዛ። <verse eid="JHN 12:20"/><verse number="21" style="v" sid="JHN 12:21"/>ኡንቲ ጋልላ ቢታ ቤተሳይዳ ካታማፕ የኤዝ ፍልጶሳኮ Ꮊንጊ፥ «ጎዳዮ፥ ኑኒ የሱሳ በአዳይስ ኮይዛ» ዬጊ ዎሴዛ። <verse eid="JHN 12:21"/><verse number="22" style="v" sid="JHN 12:22"/>ፍልጶሳ Ꮊንጊ እንድራሰስ ኦድን ናምእታይ Ꮊንጊ፥ የሱሳስ ኦዴዛ።<verse eid="JHN 12:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 12:23"/>የሱሳ ኡንትኮ፥ «አስ ናአይ፥ ቦንችንትዛ ዎደ ሄሌዛ። <verse eid="JHN 12:23"/><verse number="24" style="v" sid="JHN 12:24"/>ታኒ ይንትስ ቱሮ ኦድዛ፤ ፐቲ ግስተ ኣፈ ቢታ ጋንጨ ዎ ዎቀካ አትኮ ፋ ኣዳስ አትዛ። ዝን የ ግስተ ኣፋይ ዎቅኮ ጋመ ኣፈ ኣፍዛ። <verse eid="JHN 12:24"/><verse number="25" style="v" sid="JHN 12:25"/>ፋ ሸምፖ ቃዛ ኦንካ ብስዛ፤ ፋ ሸምፖ Ꮊ አላማይድ እጽዛ ኦንካ መናስ ደኦስ ናግስዛ። <verse eid="JHN 12:25"/><verse number="26" style="v" sid="JHN 12:26"/>ታኒ የዛ አቆ ታር የዞድ ጋርክ ታስ ኦዳይስ ኮይዝ ኦንካ ታና ካሎዳይስ ቤዝዛ። ታስ ኦዛ ኦናካ ታ አዳይ ቦንቾዳ።<verse eid="JHN 12:26"/></para>
  <para style="s1">የሱሳ ፋ Ꮊይቆ ባጋ ቲናቲ ኦዴዛ</para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27"/>«Ꮊት ታ ሸምፓይ ጋመ ኡንእንቴዛ፤ የዝን ዋጎ? ‹ታ አዳዮ፥ ታና Ꮊ ሳታይፕ አሾዬ› ዬጎ? ዋኣ፥ ታኒ የኤዛይ መቶ ኤኮዳይሲ። <verse eid="JHN 12:27"/><verse number="28" style="v" sid="JHN 12:28"/>ታ አዳዮ፥ ነ ሱን ቦንቾባ» ዬጌዛ።</para>
  <para style="p" vid="JHN 12:28">የይፕ ጉየ ሳሎፕ፥ «ታኒ ታ ሱን ቦንቼዛ፤ ጉጅካ ቦንቾዳ» ዬግዝ ቃላ የኤዛ።<verse eid="JHN 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 12:29"/>የ አቃይድ ኤቄዝ ጋመ አሳይ የ ቃላ ስኢ፥ «የይ ዳዳ» ዬጌዛ።</para>
  <para style="p" vid="JHN 12:29">Ꮊንክታይ ማ፥ «ኪታንቻይ ኤስ ኦዴዛ» ዬጌዛ።<verse eid="JHN 12:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30"/>የሱሳ ማሂ ኡንትኮ፥ «Ꮊ ቃላይ ይ ግሾስ የኤዛይፕ አትን ታ ግሾስ ባያ። <verse eid="JHN 12:30"/><verse number="31" style="v" sid="JHN 12:31"/>Ꮊ አላማይ ፕርድንትዛ ዎዳይ Ꮊተ፤ Ꮊ አላማ አቅስዛና Ꮊት ባለ ኦሎዳ። <verse eid="JHN 12:31"/><verse number="32" style="v" sid="JHN 12:32"/>ማ ታኒ ሳአፕ ቅ ጌዝ ዎደ አስ ኡባ ታኮ ኮኦዳ» ዬጌዛ። <verse eid="JHN 12:32"/><verse number="33" style="v" sid="JHN 12:33"/>ኤ የያ ጌዛይ አብ ጋርክ Ꮊይቆ Ꮊይቆዳዛኮ ኡንትስ ኤርሶዳይሲ።<verse eid="JHN 12:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34"/>ጋመ አሳይ ማሂ፥ «ኑ ህጋይ ክርስቶሳ መናስ የዛና ኦድዛ። የዝን፥ ኔኒ ዋጊ፥ አስ ናአይ ቅ ጎዳይስ ቤዝዛ ጌ? ኤ፥ አስ ናአይ ኦኖ?» ዬጌዛ።<verse eid="JHN 12:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35"/>የሱሳ፥ «ፖአይ ይንታር ጽቃ ዎደ ጋምኦዳ። ይንትስ ማም ጋርክ ፖኦ የዝን፥ ፖአይር የይታ። ማር የዝ አስ አና Ꮊንግዛኮ ኤሮያ። <verse eid="JHN 12:35"/><verse number="36" style="v" sid="JHN 12:36"/>ፖኦ ናእታ ማቃዳይ ጋርክ ፖኦ የዝን ፖአና አማኖይታ» ዬጌዛ። የሱሳ የያ ኦዴዛይፕ ጉየ Ꮊንጊ ኡንታፕ ጌሜዛ።<verse eid="JHN 12:36"/></para>
  <para style="s1">አይሁድታይ አማነካያ</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 12:37"/>ኤ የይ ጋርክ ማልታ ኡ ቲናይድ ኦንካ አማነካያ። <verse eid="JHN 12:37"/><verse number="38" style="v" sid="JHN 12:38"/>ናበ ኢሳያሳ፥</para>
  <para style="q1" vid="JHN 12:38">«ጎዳዮ፥ ኑ ማርከት ኦኒ አማኔኔ?</para>
  <para style="q2" vid="JHN 12:38">ጎዳይ ዎልቃይ ኦስ ቤንቴኔ?»</para>
  <para style="m" vid="JHN 12:38">ጌዛይ ቱማ ማቃዳይ ጋርክ ኡንቲ ኤዛ አማነካያ።<verse eid="JHN 12:38"/></para>
  <para style="p">
    <verse number="39-40" style="v" sid="JHN 12:39-40"/>ማካ ኢሳያሳ፥</para>
  <para style="q1" vid="JHN 12:39-40">«ኡ ኣፋይ በኣማይ ጋርክ፥</para>
  <para style="q2" vid="JHN 12:39-40">ኡ ዎዝናይ አካካማይ ጋርክ፥</para>
  <para style="q2" vid="JHN 12:39-40">ኡንቲ ጾስኮ ማቅን፥ ኤ ኡንታን ፓማይ ጋርክ፥</para>
  <para style="q2" vid="JHN 12:39-40">ጾሳይ ኡ አፋ ቶእሴዛ።</para>
  <para style="q1" vid="JHN 12:39-40">ኡ ዎዛና ሚንዛ»</para>
  <para style="m" vid="JHN 12:39-40">ጌዝ ግሾስ ኡንቲ አማኖዳይስ ዳንዳኤካያ።<verse eid="JHN 12:39-40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 12:41"/>ኢሳያሳ የያ ጌዛይ፥ የሱሳ ቦንቾ በኤዝ ግሾኔ ኤባዝ ኦዴዛ።<verse eid="JHN 12:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 12:42"/>ማቅኮካ፥ አይሁድታይ ሀላቅታይፐካ ጋምታይ የሱሳና አማኔዛ። ዝን ፈርሳወ አስታይ ፋና አይሁድታይ ዎሳ ኬፕ ከስዛ ግ ያሽቴዝ ግሾስ አማኔዝ ግ ጌሻ ማርካተካያ። <verse eid="JHN 12:42"/><verse number="43" style="v" sid="JHN 12:43"/>የያ ኡንቲ ኦዛይ፥ ጾሳር ኤርንቶዳይፕ ኣ አሳር ኤርንቶዳና ዶሴዝ ግሾስ።<verse eid="JHN 12:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44"/>የሱሳ ፋ ቃላ ቅ ኡዲ፥ «ታና አማንዛ ኦንካ ታና ኪቴዛናካ አማኔዛይፕ አትን ታና ኣዳ አማኖያ። <verse eid="JHN 12:44"/><verse number="45" style="v" sid="JHN 12:45"/>ታና ብእዛ ኦንካ ታና ኪቴዛናካ ብእዛ። <verse eid="JHN 12:45"/><verse number="46" style="v" sid="JHN 12:46"/>ታና አማንዛ ኡባይ ማ ጋንጨ የዛም ጋርክ ፖኦ ማቂ አላመ ታኒ የኤዛ። <verse eid="JHN 12:46"/><verse number="47" style="v" sid="JHN 12:47"/>ታ ቃላ ስኢ ኪትንቶዋ ኦናካ ታኒ ፕርዳሚ። አብስ ጊኮ፥ ታኒ አላመ አሾዳይስ የኤዛይፕ አትን ፕርዶዳይስ የኤካያ። <verse eid="JHN 12:47"/><verse number="48" style="v" sid="JHN 12:48"/>ታና እጽዛኔ ታ ቃላ ኤኮዋ ኦናካ ፕርድዛይ የዛ። ታኒ ኦዴዝ ቃላይ ዉርስ ጋላስ የ አ ፕርዶዳ። <verse eid="JHN 12:48"/><verse number="49" style="v" sid="JHN 12:49"/>አብስ ጊኮ፥ ታኒ የያ ታፕ ኦደካያ፥ ዝን ታና ኪቴዝ ታ አዳይ ታኒ አብ ጎዳዛኮነ አብ ኦዶዳዛኮ ኪቴዛ። <verse eid="JHN 12:49"/><verse number="50" style="v" sid="JHN 12:50"/>ማ ኤ ኪታይ መናስ ደኦ ማቅዛና ታኒ ኤርዛ። የይ ግሾስ፥ ታኒ ኦድዛይ ታ አዳይ ታና ኦዶባ ጌዛና» ዬጌዛ።<verse eid="JHN 12:50"/></para>
  <chapter eid="JHN 12"/>
  <chapter number="13" style="c" sid="JHN 13"/>
  <para style="s1">የሱሳ ፋ ታማርታይ ቶካ ሜጬዛ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1"/>ፓዝቃ ቦንችዛ ጋላሳይ ሄሎዳይፕ ቲናቲ Ꮊ አላመ አሺ አዳይኮ Ꮊንግዛ ዎደ ሄሌዛና የሱሳ ኤሬዛ። Ꮊ አላማይድ የዝ ፋስታ ኡባ ዎደ ዶሴዛ፤ ፎሎ ሲቆራካ ኡንታን ዶሴዛ።<verse eid="JHN 13:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 13:2"/>የሱሳራ ኤ ታማርታይር ዎላ ካሆ ማዳር ጻላሄ ስሞና ናአ አስቆሮቶ ይሁዳ የሱሳ ኣ እማዳይ ጋርክ ኤ ዎዝና ጋንጨ ኢታ ቆፋ ጋዴዛ። <verse eid="JHN 13:2"/><verse number="3" style="v" sid="JHN 13:3"/>የሱሳስ አዳይ ኡባ ባዝ ኤ ኩሸ ጋዴዛና፥ ኤ ጾሳፕ የኤዛናኔ ማቂ ኤዝኮ Ꮊማዳና ኤሬዛ። <verse eid="JHN 13:3"/><verse number="4" style="v" sid="JHN 13:4"/>የሱሳ ካሆ ም ደንዲ ፋ ጉላንታ ቃሪ ጋዲ፥ ፖጻ ፋ ጼሳ ዳንጬዛ። <verse eid="JHN 13:4"/><verse number="5" style="v" sid="JHN 13:5"/>የይፕ ጉየ፥ ጋባተ ጋንጨ ሃ ቆል፥ ፋ ታማርታይ ቶኬ ሜጬዛ፤ ማ ፋ ጼሳይዳ ዳንጬዝ ፖጻይር ኡጬዛ።<verse eid="JHN 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 13:6"/>የሱሳ ስሞን ጵጽሮሳኮ የኦዳር ጵጽሮሳ፥ «ጎዳዮ፥ ነ ታ ቶካ ሜጮዴ?» ዬጌዛ።<verse eid="JHN 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 13:7"/>የሱሳ ማሂ ኤዝኮ፥ «ታኒ ኦዛና ነ Ꮊት ኤሮያ፥ ዝን ጉየፕ አካኮዳ» ዬጌዛ።<verse eid="JHN 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 13:8"/>የዝን፥ ጵጽሮሳ፥ «ነ ታ ቶካ ኡባራካ ሜጮዳይስ ዳንዳኦያ» ዬጌዛ።</para>
  <para style="p" vid="JHN 13:8">የሱሳ ኤዝኮ፥ «ታኒ ነ ቶኬ ሜጨካ አትኮ ኔስኔ ታስ ፐትፐተ ባያ» ዬጌዛ።<verse eid="JHN 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 13:9"/>ጵጽሮሳ የሱሳኮ፥ «ጎዳዮ፥ ዬዛኮ፥ ታ ቶካይ ኣዳ ባዝን ታ ኩሻኔ ታ ኦማ ሜጮባ» ዬጌዛ።<verse eid="JHN 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 13:10"/>የሱሳ ማሂ፥ «ጋላ ሜጭንቴዝ ኦንካ ቶከፕ ሀራ ባዝ ሜጭንቶዳይስ ቤዞያ፤ ኤ ኡባይ ጌሺ። ይ ጌሺ፥ ዝን ኡባ አሲ ጌሺ ባያ» ዬጌዛ። <verse eid="JHN 13:10"/><verse number="11" style="v" sid="JHN 13:11"/>የሱሳ ፋና ኣ እማድ አይ ኦናዛኮ ኤርዛ ግሾስ «ይ ኡቢታይ ጌሺ ባያ» ዬጌዛ።<verse eid="JHN 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 13:12"/>ኡ ቶኬ ሜጬዛይፕ ጉየ የሱሳ ፋ አፍላ ማሂ ማኤዛ። ማቂ ሙንታል አፋ በቲ ኡንትኮ፥ «ታኒ ይንትስ ኦዛና አካክኔ? <verse eid="JHN 13:12"/><verse number="13" style="v" sid="JHN 13:13"/>ይ ታና አስታማረኔ ጎዳ ግዛ፤ ታኒ ይ ግዛ ማቄዝ ግሾስ ሎኦ ጌዛ። <verse eid="JHN 13:13"/><verse number="14" style="v" sid="JHN 13:14"/>ታኒ ይንትስ ጎዳነ አስታማረ ማቅታር ይ ቶኬ ሜጭኮ ይንትካ ፐታይ ፐታይስ Ꮊይ ጋርክ ኦዳይስ ቤዝዛ። <verse eid="JHN 13:14"/><verse number="15" style="v" sid="JHN 13:15"/>ይኬ፥ ታኒ ይንትስ ኦዛይ ጋርክ ይንትካ ኦድ ጋርክ ይንትስ ኣዝሶ ማቄዛ። <verse eid="JHN 13:15"/><verse number="16" style="v" sid="JHN 13:16"/>ታኒ ይንትስ ቱሮ ኦድዛ፤ አይላይ ፋ ጎዳይፕ፥ ኪትንቴዛይ ኪቴዛይፕ ኣያ። <verse eid="JHN 13:16"/><verse number="17" style="v" sid="JHN 13:17"/>ይ የያ ኤሪ ኦዛባዝ ማቅኮ አንጅንቴዝታ።<verse eid="JHN 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 13:18"/>«ታኒ ይንታን ኡብታ ጎያ፤ ታኒ ማራጼዝታ ታ ኤርዛ። ዝን ጌሻ ማጻፋይድ፥ ‹ታፕ ሜዛይ ታል አፋ ፋ ቶካ ደንዛ› ግንትንትዛይ ቱማ ማቆዳይስ ቤዝዛ። <verse eid="JHN 13:18"/><verse number="19" style="v" sid="JHN 13:19"/>ታኒ ታና ማቄዛና ይ አማኖድ ጋርክ የይ ሀኖዳይፕ ቲናቲ ይንትስ ኦድዛ። <verse eid="JHN 13:19"/><verse number="20" style="v" sid="JHN 13:20"/>ታኒ ይንትስ ቱሮ ኦድዛ፤ ታኒ ኪቴዝ ኦናካ ሞክዛ አይ ታና ሞክዛ። ታና ሞክዝ ኦንካ ታና አዛዜዛና ሞክዛ» ዬጌዛ።<verse eid="JHN 13:20"/></para>
  <para style="s1">የሱሳ ፋና ኣ እማዳይ ኦናዛኮ ቲናቲ ኦዴዛ</para>
  <para style="r">(<ref loc="MAT 26:20-25">ማቶ. 26:20-25</ref>፤ <ref loc="MRK 14:17-21">ማር. 14:17-21</ref>፤ <ref loc="LUK 22:21-23">ሉቃ. 22:21-23</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21"/>የሱሳ የያ ኦዴዛይፕ ጉየ ፋ ዎዝናር ጋመ ኡንእንቲ፥ «ታኒ ይንትስ ቱሮ ኦድዛ፤ ታና ይንትፕ ፐታይ አ እማዳ» ግ ቆንጭሲ ኦዴዛ።<verse eid="JHN 13:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 13:22"/>ኤ ኦ ባጋ ኦድዛኮ ኤ ታማርታይስ ኤርንታም እጽን ፐታይ ፐታ በኤዛ። <verse eid="JHN 13:22"/><verse number="23" style="v" sid="JHN 13:23"/>ኤ ታማርታይፕ ፐታይ፥ የሱስ ዶስዛይ፥ የሱሳ ካለ በቴዛ። <verse eid="JHN 13:23"/><verse number="24" style="v" sid="JHN 13:24"/>የይ ግሾስ፥ ስሞን ጵጽሮሳ ኤዛ ቃምኦቲ፥ «ኤ ኦና ግዛኮ አን ኦይጮባ» ዬጌዛ።<verse eid="JHN 13:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 13:25"/>የይ ግሾስ፥ የ ታማራይ የሱሳኮ ሀየ ካለ ሺቂ፥ «ጎዳዮ፥ ኤ ኦኖ?» ዬጌዛ።<verse eid="JHN 13:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 13:26"/>የሱሳ ማሂ፥ «ታኒ ሶሎ ዱሺ ባርስዛያ» ዬጌዛ። ማ ሶሎ ዱ ኤኪ፥ ዱሺ፥ ስሞና ናአ አስቆሮቶ ይሁዳ ባርሴዛ። <verse eid="JHN 13:26"/><verse number="27" style="v" sid="JHN 13:27"/>ይሁዳና ሶሎ ባሬዛይፕ ጉየ ጻላሄ ኤልሲ ይሁዳ ጋንጨ ገሌዛ። የሱሳ ኤኮ፥ «ነ ኦዳይስ ቆፔዛኖ ኤልሲ ኦባ» ዬጌዛ። <verse eid="JHN 13:27"/><verse number="28" style="v" sid="JHN 13:28"/>ዝን ሙንታል አፋ በቴዝታይፕ ኦንካ የሱሳ የያ አብስ ጌዛኮ ኤረካያ። <verse eid="JHN 13:28"/><verse number="29" style="v" sid="JHN 13:29"/>ይሁዳ ሚሸ አይክዝ ግሾስ ኤ ታማርታይፕ ፐታይ ፐታይ የሱሳ ኤ፥ «ፓዝቃ ቦንችዛ ጋላስስ ፓስ ኮሽዛ ባዝ ዎንጎባ ዎይ ማንቅታይስ ሙጻታ እንጎባ ጌዛ» ዬጊ ቆፔዛ።<verse eid="JHN 13:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 13:30"/>ይሁዳ ሶሎ ባሬዛን ጋርክ እዝራ ባለ ከዜዝ። የ ዎደ ሳአ ቃማ።<verse eid="JHN 13:30"/></para>
  <para style="s1">ኦሮ ኪታ</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31"/>ይሁዳ ባለ ከዜዛይፕ ጉየ፥ የሱሳ፥ «Ꮊት አስ ናአይ ቦንችንቴዛ፤ ጾሳይካ ኤ ባጋር ቦንችንቴዛ። <verse eid="JHN 13:31"/><verse number="32" style="v" sid="JHN 13:32"/>ጾሳይ ኤ ባጋር ቦንችንትኮ ኤ ፋ ኦማስ አስ ናአ ቦንቾዳ፤ ማ ኤ የያ ኤልሲ ኦዳ። <verse eid="JHN 13:32"/><verse number="33" style="v" sid="JHN 13:33"/>ታ ናኡን፥ ታኒ ይንታር ጋመ ዎደ ጋምአሚ። ይ ታና ኮዮዳ፥ ዝን ታኒ አይሁድታይስ ኦዴዛን ጋርክ፥ ‹ይ ታኒ Ꮊንግዛ አቆ Ꮊማዳይስ ዳንዳኦያ› <verse eid="JHN 13:33"/><verse number="34" style="v" sid="JHN 13:34"/>ታኒ ይንትስ እንግዝ ኦሮ ኪታይ Ꮊያ፤ ፐታይ ፐታ ቃይታ። ታኒ ይንታን ቃዛይ ጋርክ ይ ፐታይ ፐታ ቃዳይስ ቤዝዛ። <verse eid="JHN 13:34"/><verse number="35" style="v" sid="JHN 13:35"/>ይ ፐታይ ፐታይራ ዶስንትኮ ይ ታ ታማረ ማቅዛና አሲ ኡባይ ኤሮዳ» ዬጌዛ።<verse eid="JHN 13:35"/></para>
  <para style="s1">ጵጽሮሳ ካዶዳና የሱሳ ቲናቲ ኦዴዛ</para>
  <para style="r">(<ref loc="MAT 26:31-35">ማቶ. 26:31-35</ref>፤ <ref loc="MRK 14:27-31">ማር. 14:27-31</ref>፤ <ref loc="LUK 22:31-34">ሉቃ. 22:31-34</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36"/>ስሞን ጵጽሮሳ የሱሳኮ፥ «ጎዳዮ፥ ነ አና Ꮊንጌ?» ዬጌዛ።</para>
  <para style="p" vid="JHN 13:36">የሱሳ ማሂ፥ «ታኒ Ꮊንግዛ አቆ ኔኒ Ꮊት ካሎዳይስ ዳንዳኦያ፥ ዝን ጉየፕ ታና ካሎዳ» ዬጌዛ።<verse eid="JHN 13:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 13:37"/>ጵጽሮሳ፥ «ጎዳዮ፥ ታኒ ነና Ꮊት ካሎዳይስ አብስ ዳንዳኦሳ? ታኒ ነ ግሾስ Ꮊይቆዳይስ ጊግ በቴዛ» ዬጌዛ።<verse eid="JHN 13:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 13:38"/>የሱሳ ማሂ፥ «ታ ግሾስ Ꮊይቆዳይስ ቱማ ጊግ በቴኔ? ታኒ ኔስ ቱሮ ኦድዛ፤ ሹጉላ ኡኮዳይፕ ቲና ኔኒ ታና ሀይ ቶክ ካዶዳ» ዬጌዛ።<verse eid="JHN 13:38"/></para>
  <chapter eid="JHN 13"/>
  <chapter number="14" style="c" sid="JHN 14"/>
  <para style="s1">የሱሳ አዳይኮ ካንግዛ ኦገ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1"/>የሱሳ ፋ ታማርታይኮ፥ «ይ ዎዝናይ ኡንእንትፐ፥ ጾሳ አማኖይታ፥ ታናካ አማኖይታ። <verse eid="JHN 14:1"/><verse number="2" style="v" sid="JHN 14:2"/>ታ አዳይ ካራ ጋመ አቆ የዛ። ታኒ ይንትስ በስ ጊግሶዳይስ Ꮊንግዛ። የያ ማቀካዛኮ ታኒ ይንትስ ኦዶድዝን። <verse eid="JHN 14:2"/><verse number="3" style="v" sid="JHN 14:3"/>ታኒ Ꮊንጊ በስ ጊግሴዛይፕ ጉየ ታኒ የዛ አቆ ይ የዞድ ጋርክ ማቂ ይኢ ይንታን ታኮ ካንጎዳ። <verse eid="JHN 14:3"/><verse number="4" style="v" sid="JHN 14:4"/>ይ ታኒ Ꮊንግዛ አቆ ካንግዝ ኦገ ይ ኤርዛ» ዬጌዛ።<verse eid="JHN 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5"/>የዝን፥ ቶማሳ፥ «ጎዳዮ፥ ኔኒ Ꮊንግዛ አቆ ኑኒ ኤሮያ፤ ኦጋ ዋይዚ ኤሮዳይስ ዳንዳኦዴ?» ዬጌዛ።<verse eid="JHN 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 14:6"/>የሱሳ ማሂ፥ «ኦገ፥ ቱማይኔ ደኦ ታና። ታ ባጋር ማቃም እጽኮ ኦንካ ታ አዳይኮ Ꮊማዳይስ ዳንዳኦያ። <verse eid="JHN 14:6"/><verse number="7" style="v" sid="JHN 14:7"/>ይ ታና ኤርዛ ባዝ ማቄዛኮ፥ ታ አዳካ ኤሮዳ። ዝን Ꮊይፕ አይኪ ይ ኤዛ ኤርዛኔ ኤዛ በኤዛ» ዬጌዛ።<verse eid="JHN 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 14:8"/>ፍልጶሳ የሱሳኮ፥ «ጎዳዮ፥ አዳ ኑና ቤዞባ፤ የይ ኑስ ግዶዳ» ዬጌዛ።<verse eid="JHN 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 14:9"/>የሱሳ ማሂ፥ «ታኒ Ꮊይ ጋርክ ዎደ ይንታር የዝንካ ታና ኤሮሳ? ታና በኤዝ አይ አዳካ በኤዛ። የዝን፥ ኔኒ ዋጊ፥ ‹ኣዳ ኑና ቤዞዬ› ጌ? <verse eid="JHN 14:9"/><verse number="10" style="v" sid="JHN 14:10"/>ታኒ አዳይር የዛኔ አዳይካ ታር የዛና ኔኒ አማኖሳኔ? ታኒ ይንትስ ኦድዝ ቃላ ታኒ ታፕ ኦዶያ፥ ዝን ታር የዛ አዳይ ፋ ኦ ኦዛ። <verse eid="JHN 14:10"/><verse number="11" style="v" sid="JHN 14:11"/>ታኒ አዳይር የዛናኔ አዳይካ ታር የዛና ይ አማኖይታ። የያ አማናምጽኮ ታ ኦዝ ማላ ባዝታይል ታና አማኖይታ።<verse eid="JHN 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 14:12"/>«ታኒ ይንትስ ቱሮ ኦድዛ፤ ታና አማንዛ አይ ታኒ ኦዛ ኦሶ ኦዳ። ታኒ አዳይኮ Ꮊንግዛ ግሾስ ታና አማንዛ ኦንካ Ꮊይፕ ኣዝ ኦስታ ኦዳ። <verse eid="JHN 14:12"/><verse number="13" style="v" sid="JHN 14:13"/>አዳይ ናአይ ባጋር ቦንችንቶድ ጋርክ ታ ሱንር ይ ዎስዛ ባዝ ኡባ ታ ይንትስ ኦዳ። <verse eid="JHN 14:13"/><verse number="14" style="v" sid="JHN 14:14"/>ታ ሱንር አባባዝካ ይ ኦይጭኮ ታ ይንትስ ኦዳ።<verse eid="JHN 14:14"/></para>
  <para style="s1">የሱሳ ጌሻ አያና እማዳይስ ቃላ ገሌዛ</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15"/>«ይ ታና ቃኮ ታ ኪታ ናጎዳ። <verse eid="JHN 14:15"/><verse number="16" style="v" sid="JHN 14:16"/>ታኒ አዳ ዎሶዳ፤ ይንታር መናስ የዞድ ጋርክ ምንዛ ይንትስ እማዳ። <verse eid="JHN 14:16"/><verse number="17" style="v" sid="JHN 14:17"/>Ꮊ አላመ አሳይ ኤዛ በኤካዛይ ግሾኔ ኤሮዋ ግሾስ ኤዛ ኤኮዳይስ ዳንዳኦያ ቱማ አያና። ዝን ኤ ይንታር የዛ ግሾኔ ይ ጋንጨ የዞድ ግሾስ ይ ኤዛ ኤሮዳ።<verse eid="JHN 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 14:18"/>«ታኒ ይንታን እንዳ አደ ባ ናአ ጋርክ ይ ኣዳ አሻሚ፤ ማቂ ይንትኮ የኦዳ። <verse eid="JHN 14:18"/><verse number="19" style="v" sid="JHN 14:19"/>ጽቃ ዎደፕ ጉየ አላማይ ታና ማሂ በኤና፥ ዝን ይ በአዳ። ታኒ ደኦር የዛ ግሾስ ይንትካ ደኦር የሳዳ። <verse eid="JHN 14:19"/><verse number="20" style="v" sid="JHN 14:20"/>ታኒ ታ አዳይር፥ ይ ታር፥ ማ ታኒ ይንታር የዛና ይ የ ጋላስ ኤሮዳ።<verse eid="JHN 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 14:21"/>«ታ ኪታ ኤኪ ናግዛይ ታና ቃዛ። ታና ቃዛና ታ አዳይካ ቃዛ፤ ታንካ ኤዛ ቃዛ፤ ታኒ ኤስ በንቶዳ» ዬጌዛ።<verse eid="JHN 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22"/>አስቆሮቶ ይሁዳ ባዝን Ꮊንኮ ይሁዳ የሱሳኮ፥ «ጎዳዮ፥ ኔኒ ዋይዚ አላማይስ ባዝን ኑስ ነና ቤዞዴ?» ዬጌዛ።<verse eid="JHN 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 14:23"/>የሱሳ ማሂ፥ «ታና ቃዛ ኦንካ ታ ቃላይስ ኪትንቶዳ። ታ አዳይ ኤዛ ቃዳ። ማ ታ አዳይራ ታራ ኤዝኮ ይኢ ኤዛር የዞዳ። <verse eid="JHN 14:23"/><verse number="24" style="v" sid="JHN 14:24"/>ታና ዶሶዋ ኦንካ ታ ቃላይስ ኪትንቶያ። ይ ስእዝ ቃላይ ታና ኪቴዝ አዳይ ባዛፕ አትን ታባዝ ባያ።»<verse eid="JHN 14:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25"/>«ታኒ ይንታር Ꮊት የዛር የያ ይንትስ ኦዴዛ። <verse eid="JHN 14:25"/><verse number="26" style="v" sid="JHN 14:26"/>ዝን አዳይ ታ ሱንር ኪቶዳ ምንዛ ጌሻ አያናይ፥ ይንታን ኡባ ባዝ ታማርሶዳ። ታኒ ይንትስ ኦዴዝ ኡባ ኤ ይንታን ሀሳይሶዳ። <verse eid="JHN 14:26"/><verse number="27" style="v" sid="JHN 14:27"/>ሳሮት ይንትስ አሾዳ። ታኒ ታ ሳሮት ይንትስ እማዳ። ታ እንግዝ ሳሮትይ አላማይ እንግዝ ሳሮትይ ጋርክ ባያ። የይ ግሾስ፥ ኡንእንትፓተ፥ ያሽትፓተ።<verse eid="JHN 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 14:28"/>«ታኒ Ꮊማዳ፥ ማቂ ይንትኮ የኦዳ» ጌዛና ይ ስኤዛ። ይ ታና ቱማ ዶስዝባዝ ማቄዛኮ ታ አዳይ ታፕ ኣዝ ግሾስ ታኒ ኤዝኮ Ꮊንግዛይድ ይ ኡፋይቶዳ። <verse eid="JHN 14:28"/><verse number="29" style="v" sid="JHN 14:29"/>የይ ሀኖዳር ይ አማኖድ ጋርክ የይ ሀነካዝን ቲናቲ ታኒ ይንትስ ኦዴዛ። <verse eid="JHN 14:29"/><verse number="30" style="v" sid="JHN 14:30"/>Ꮊ አላማ አቅስዛይ ይእዛ ግሾስ Ꮊይፕ ጉየ ይንታር ጋመ ኦድንታሚ። ታና ኤ አብካ ኦዳይስ ዳንዳኦያ። <verse eid="JHN 14:30"/><verse number="31" style="v" sid="JHN 14:31"/>ዝን ታኒ አዳ ቃዛና አላማይ ኤሮድ ጋርክ ታ አዳይ ታና አዛዜዛና ኡባ ኦዛ። ደንዶይታ፤ Ꮊይፕ ዎላ Ꮊማዳ።<verse eid="JHN 14:31"/></para>
  <chapter eid="JHN 14"/>
  <chapter number="15" style="c" sid="JHN 15"/>
  <para style="s1">ዎይኔ ቱራስ ኡባይ የሱሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1"/>«ታኒ ዎይነስ ቱማ ኡባ። ኦስዛይ ታ አዳ። <verse eid="JHN 15:1"/><verse number="2" style="v" sid="JHN 15:2"/>ታል አፋ የዚ ኣፈ ኣፎዋ ሻቆ ኡባ ኤ ካርዛ። ኣፍዝ ሻቆ ቲናሳይፕ ኣ ኣፎዳይ ጋርክ የ ሻቃ ኤ ጊግሶዳ። <verse eid="JHN 15:2"/><verse number="3" style="v" sid="JHN 15:3"/>ታኒ ይንትስ ኦዴዝ ቃላይ ግሾስ ይ ጌሽታ። <verse eid="JHN 15:3"/><verse number="4" style="v" sid="JHN 15:4"/>ታር የዞይታ፤ ታንካ ይንታር የዞዳ። ዎይኔ ሻቃይ ኡባይር የዘካ አትኮ የ ሻቃይ ፋ ኣዳስ ኣፈ ኣፎዳይስ ዳንዳኦያ። የይ ጋርከካ፥ ይንትካ ታል የዘካ አትኮ ኣፈ ኣፎዳይስ ዳንዳኦያ።<verse eid="JHN 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 15:5"/>«ታኒ ዎይነስ ኡባ፤ ይ ሻቂታ። ታር የዝዛይኔ ታኒ ኤዛር የዝዛይ፥ ኤ ጋመ ኣፈ ኣፎዳ። ታ ባዝን ይ ይ ኡባስ አብካ ኦዳይስ ዳንዳኦያ። <figure style="fig" alt="Grape vine on trellis" file="HK00112B.tif" size="span" ref="15:5">ዎይነ ምኔ እ ኣፈ</figure> <verse eid="JHN 15:5"/><verse number="6" style="v" sid="JHN 15:6"/>ታር የዞዋዛይ ሻቆ ጋርክ ባለ ኦልንቲ መሎዳ። ኡንታን ሺሺ ታማ ኦሎዳ፥ ኤጾዳ። <verse eid="JHN 15:6"/><verse number="7" style="v" sid="JHN 15:7"/>ይ ታር የዝኮ፥ ታ ቃላይካ ይንታር የዝኮ፥ ይ ኮይዝ ባዝ አብ ማቅኮካ ዎሶይታ፤ ይ ኤኮዳ። <verse eid="JHN 15:7"/><verse number="8" style="v" sid="JHN 15:8"/>ይ ጋመ ኣፈ ኣፍኮኔ ታ ታማረ ማቅኮ፥ የይድ ታ አዳይ ቦንችንቶዳ። <verse eid="JHN 15:8"/><verse number="9" style="v" sid="JHN 15:9"/>አዳይ ታና ቃዛይ ጋርክ ታንካ ይንታን ቃዛ፤ ታ ሲቃይር የዞይታ። <verse eid="JHN 15:9"/><verse number="10" style="v" sid="JHN 15:10"/>ታኒ ታ አዳይ ኪታ ናጊ ኤ ሲቃይድ የዜዛይ ጋርክ ይንትካ ታ ኪታ ናግኮ ታ ሲቃይድ የዞዳ።<verse eid="JHN 15:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 15:11"/>«ታ ኡፋይሳይ ይንታር ማቃዳይ ጋርከኔ ይ ኡፋይሳይ ፎሎ ማቃድ ጋርክ ታኒ ይንትስ የያ ኦዴዛ። <verse eid="JHN 15:11"/><verse number="12" style="v" sid="JHN 15:12"/>ታ ኪታይ Ꮊያ፤ ታኒ ይንታን ቃዛይ ጋርክ ይንትካ ዎል ዎል ቃይታ። <verse eid="JHN 15:12"/><verse number="13" style="v" sid="JHN 15:13"/>ፋ ሸምፖ ፋ ላጋይስ ኣ እንግዛይፕ ኣዝ ዳማ ሲቆ ባያ። <verse eid="JHN 15:13"/><verse number="14" style="v" sid="JHN 15:14"/>ታኒ ይንታን ኪቴዝ ኡብታ ይ ኦኮ ይ ታ ዳብታ።<verse eid="JHN 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 15:15"/>«አይለ ፋ ጎዳይ ኦዛባዝ ኤሮዋ ግሾስ ታኒ ይንታን Ꮊይፕ ጉየ አይልታ ጋሚ። ዝን ታ አዳይፕ ስኤዝ ኡብታ ታኒ ይንትስ ኦዴዝ ግሾስ ይንታን ዶስንቴዝታ ጌዛ። <verse eid="JHN 15:15"/><verse number="16" style="v" sid="JHN 15:16"/>ታኒ ይንታን ዶሬዛይፕ አትን ይ ታና ዶረካያ። ይ Ꮊንጊ ቦዋ ኣፈ ኣፎድ ጋርክ ታኒ ይንታን ሹሜዛ። ዬዛኮ ታ አዳይ ይ ታ ሱንር ዎሴዝባዝ ኡባ ይንትስ እማዳ። <verse eid="JHN 15:16"/><verse number="17" style="v" sid="JHN 15:17"/>ታ ኪታይ Ꮊያ፦ ዎል ዎል ቃይታ።<verse eid="JHN 15:17"/></para>
  <para style="s1">የሱሳ አላማይ ኤ ታማርታና እጾዳና ኦዴዛ</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18"/>«አላማይ ይንታን እጽኮ ቲናቲ ታና እጼዛ ኤሮይታ። <verse eid="JHN 15:18"/><verse number="19" style="v" sid="JHN 15:19"/>ይ አላመ ባዝ ማቄዛኮ አላማይ ፋባዝ ጋርክ ይንታን ቃዳ። ዝን ታኒ ይንታን አላመፕ ሻጊ ዶሬዝ ግሾኔ ይ አላመ ባዝ ባ ግሾስ አላማይ ይንታን እጽዛ። <verse eid="JHN 15:19"/><verse number="20" style="v" sid="JHN 15:20"/>‹አይለ ፋ ጎዳይፕ ኣያ› ግ ታኒ ይንትስ ኦዴዛና ቆፖይታ። ኡንቲ ታና ባይኤዝ ባዝ ማቅኮ ይንታናካ ባይኦዳ። ኡንቲ ታ ቃላ ናጌዝባዝ ማቅኮ ይ ቃላካ ናጎዳ። <verse eid="JHN 15:20"/><verse number="21" style="v" sid="JHN 15:21"/>ዝን ኡንቲ ታና አዛዜዛና ኤሮዋ ግሾስ Ꮊ ኡባ ታ ባጋር ይንታል አፋ ኦዳ። <verse eid="JHN 15:21"/><verse number="22" style="v" sid="JHN 15:22"/>ታኒ ይኢ ኦደካባዝ ማቄዛኮ ኡንትስ ናጋራ ማቀና። ዝን Ꮊት ኡንቲ ኦዝ ናጋራይስ ኦዶድ ሳላምበ ባያ። <verse eid="JHN 15:22"/><verse number="23" style="v" sid="JHN 15:23"/>ታና እጽዛይ ታ አዳካ እጽዛ። <verse eid="JHN 15:23"/><verse number="24" style="v" sid="JHN 15:24"/>ኦንካ ኦካ ኦሶ ታ ኡ ጋንጨ ኦበኤካባዝ ማቄዛኮ ኡንትስ ናጋራ ማቃም ዝን Ꮊት ኡንቲ ታኒ ኦዛ ብኢ ታናካ ታ አዳካ እጼዛ። <verse eid="JHN 15:24"/><verse number="25" style="v" sid="JHN 15:25"/>ዝን ኡ ህጋይድ፥ ‹ታና ጨር እጼዛ› ግንትንቲ ጻፍንቴዛይ ፖልንቶድ ጋርክ የይ ሀኔዛ።<verse eid="JHN 15:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 15:26"/>«አዳይፕ ይእዝ ቱማ ቤዝዛ አያና ታ ይንትስ ኪቶዳ። ኤ ይንታን ምንዳ፥ ታባዝ ማርኮቶዳ። <verse eid="JHN 15:26"/><verse number="27" style="v" sid="JHN 15:27"/>ይንትካ ቲናፕ አይኪ ታር የዛ ግሾስ ታባዝ ማርኮቶዳ።<verse eid="JHN 15:27"/></para>
  <chapter eid="JHN 15"/>
  <chapter number="16" style="c" sid="JHN 16"/>
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1"/>«ታኒ የያ ይ አማናይ ባም ጋርክ ይንትስ ኦዴዛ። <verse eid="JHN 16:1"/><verse number="2" style="v" sid="JHN 16:2"/>ኡ ይንታን አይሁድታይ ዎሳ ኬታይፕ ከሲ ዳኮዳ። የይ ጋርከካ፥ ይንታን ዎዛ ኦንካ ጾሲ ኮይዝ ባዝ ኦዛ አዝዛ ዎደ የኦዳ። <verse eid="JHN 16:2"/><verse number="3" style="v" sid="JHN 16:3"/>ኡንቲ የያ ይንታል አፋ ኦዛይ ታና ዎይ አዳ ኤሮዋ ግሾስ። <verse eid="JHN 16:3"/><verse number="4" style="v" sid="JHN 16:4"/>ዝን ኡንቲ የያ ይንታል አፋ ኦዛ ዎደ ሄሎዳር ታኒ ይንትስ ኦዴዛና ይ አካኮድ ጋርክ ታኒ ይንትስ Ꮊያ ኦዴዛ። ቲናቲ ታኒ Ꮊያ ይንትስ ኦደካ ጋምኤዛይ ታ ይንታር የዛ ግሾስ።<verse eid="JHN 16:4"/></para>
  <para style="s1">ጌሻ አያና ኦሶ</para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 16:5"/>«ዝን Ꮊት ታኒ ታና ኪቴዛይኮ Ꮊንግዛ፤ ይንታፕ ኦንካ፥ ‹አና Ꮊንጌ?› ግ ታና ኦይጭዛይ ባያ። <verse eid="JHN 16:5"/><verse number="6" style="v" sid="JHN 16:6"/>ዝን ታኒ የያ ኦዴዝ ግሾስ ይ ዎዝናይ አዛኖር ኩሜዛ። <verse eid="JHN 16:6"/><verse number="7" style="v" sid="JHN 16:7"/>ዝን ታኒ ይንትስ ቱሮ ኦድዛ፤ ታኒ Ꮊንግኮ ይንትስ ሎኦ። አብስ ጊኮ፥ ታኒ Ꮊንጋም እጽኮ ምንዛይ ይንትኮ የኤና። ዝን ታኒ Ꮊንጊ ኤዛ ይንትኮ ዳኮዳ። <verse eid="JHN 16:7"/><verse number="8" style="v" sid="JHN 16:8"/>ምንዛይ ይኢ፥ ናጋራባጋ፥ ጽሎት ባጋኔ ፕርዳ ባጋ Ꮊ አላመ አሳ ኤርሶዳ። <verse eid="JHN 16:8"/><verse number="9" style="v" sid="JHN 16:9"/>ናጋራባጋይ፥ አሳይ ታና አማኖዋ ግሾስ። <verse eid="JHN 16:9"/><verse number="10" style="v" sid="JHN 16:10"/>ጽሎትባጋይ፥ ታኒ አዳይኮ Ꮊንግዛ ግሾኔ ይ ታና ማቂ ቦኦዋ ግሾሲ። <verse eid="JHN 16:10"/><verse number="11" style="v" sid="JHN 16:11"/>ፕርዳባጋይ፥ ማ አላመ አቅስዛይ ፕርድንቴዝ ግሾሲ።<verse eid="JHN 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 16:12"/>«ታኒ ይንትስ ኦድዛ ጋመ ባዝ የዛ፥ ዝን Ꮊት ይንትስ ገሎያ። <verse eid="JHN 16:12"/><verse number="13" style="v" sid="JHN 16:13"/>ቱማ አያና ይኢ ይንታን ቱማት ኡባይኮ ካልዳ። ኤ ስኤዝ ባዝ ኦድዛፕ አትን ፓፕ አባባዝካ ኦዶያ። ማ ቲናፕ የኦድባዝ ይንትስ ኤ ኦዶዳ። <verse eid="JHN 16:13"/><verse number="14" style="v" sid="JHN 16:14"/>ኤ ታስ የዛይፕ ኤኪ ይንትስ ኦድዛ ግሾስ ኤ ታና ቦንቾዳ። <verse eid="JHN 16:14"/><verse number="15" style="v" sid="JHN 16:15"/>አዳይስ የዛ ባዝ ኡቢታይ ታባዝ፤ ‹አያናይ ታስ የዛይፕ ኤኪ ይንትስ ኦዶዳ› ታኒ ጌዛይ የይ ግሾሲ።<verse eid="JHN 16:15"/></para>
  <para style="s1">ይ አዛናይ ኡፋይሳር ላምንቶዳ</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16"/>«ጽቃ ዎደፕ ጉየ ይ ታና በኣሚ፤ ማካ ጽቃ ዎደፕ ጉየ ይ ታና በአዳ» ዬጌዛ።<verse eid="JHN 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17"/>ኤ ታማርታይፕ ፐታይ ፐታይ ዎል ጋንጨ፥ «ጽቃ ዎደፕ ጉየ ይ ታና በኣሚ፤ ማ ጽቃ ዎደፕ ጉየ ይ ታና በአዳ፤ ማካ ታኒ አዳይኮ Ꮊንግዛ ጉሳይ ዋጉሶ?» ዬጌዛ። <verse eid="JHN 16:17"/><verse number="18" style="v" sid="JHN 16:18"/>«ጽቃ ዎደፕ ጉየ ዋጉሶ? ኤ አብ ኦድንትዛኮ ኑስ ኤርንቶያ» ዬጌዛ።<verse eid="JHN 16:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 16:19"/>ኡንቲ ፋና ኦይጮዳይስ ኮይዛና የሱሳ ኤሪ፥ «ታኒ፥ ‹ጽቃ ዎደፕ ጉየ ይ ታና በኣሚ፤ ማ ጽቃ ዎደፕ ጉየ ይ ታና በአዳ› ዬጌዝ ግሾ ይ ዎል ዎል ኦይጭኔ? <verse eid="JHN 16:19"/><verse number="20" style="v" sid="JHN 16:20"/>ታኒ ይንትስ ቱሮ ኦድዛ፤ ይ ዬኮዳኔ አፉጾዳ፥ ዝን Ꮊ አላማይ ኡፋይቶዳ። Ꮊት ይ አዛኖዳ፥ ዝን ይ አዛናይ ኡፋይሳ ላምንቶዳ። <verse eid="JHN 16:20"/><verse number="21" style="v" sid="JHN 16:21"/>ዎደ አስታ ናአ የሎድ ሀኖዳር ፋ የሎ ዎዳይ ሄሌዝ ግሾስ ህርግዛ። ዝን ናአ የሌዛይፕ ጉየ ናአ Ꮊ አላማይል የልንቴዛይ ኡፋይስዛ ግሾስ ፋ መታ እዛ ዶግዛ። <verse eid="JHN 16:21"/><verse number="22" style="v" sid="JHN 16:22"/>የይ ጋርክ፥ ይንትካ ይ ዎዝናር አዛንዛ፥ ዝን ታኒ ይንታን ማቂ በአዳ። ይ ዎዝናይ ሎእ ኡፋይቶዳ፤ የ ኡፋይሳ ኦንካ ይንታፕ ኤከና።<verse eid="JHN 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 16:23"/>«የ ጋላስ ይ ታና አባባዝካ ዎሴና። ታኒ ይንትስ ቱሮ ኦድዛ፤ ይ ታ ሱንር ዎስዛ ባዝ ኡባ አዳይ ይንትስ እማዳ። <verse eid="JHN 16:23"/><verse number="24" style="v" sid="JHN 16:24"/>Ꮊኖ ሄሎዳይስ ታ ሱንር አባባዝካ ይ ዎሰካያ። ይ ኡፋይሳይ ፎሎ ማቃድ ጋርክ ጾሳ ዎሶይታ፤ ይ ኤኮዳ።<verse eid="JHN 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25"/>«ታኒ Ꮊኖ ሄሎዳይስ ይንትስ ኣዝሶር ኦዴዛ፥ Ꮊይፕ ታኒ ኣዝሶር ኦዶዋ ዎደ የኦዳ። ዝን አዳይባጋ ታኒ ይንትስ ቆንጭሲ ኦዶዳ። <verse eid="JHN 16:25"/><verse number="26" style="v" sid="JHN 16:26"/>የ ጋላስ ይ ታ ሱንር አዳ ዎሶዳ፤ ይ ግሾስ ታኒ አዳ ዎሳሚ። <verse eid="JHN 16:26"/><verse number="27" style="v" sid="JHN 16:27"/>አብስ ጊኮ፥ አዳይ ፋ ኡባስ ይንታን ቃዛ። ይ ታና ቃዛ ግሾኔ ታኒ አዳ ላንቀፕ የኤዛና ይ አማኔዝ ግሾስ ኤ ይንታን ቃዛ። <verse eid="JHN 16:27"/><verse number="28" style="v" sid="JHN 16:28"/>ታኒ አዳይ ላንቀፕ Ꮊ አላመ የኤዛ፤ ማ አላመ አሺ አዳይኮ Ꮊማዳ» ዬጌዛ።<verse eid="JHN 16:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29"/>ኤ ታማርታይ ማቂ፥ «ዬዛኮ፥ Ꮊት ኔኒ ቆንጨ ኦድዛ፤ ኣዝሶር አብካ ኦዶያ። <verse eid="JHN 16:29"/><verse number="30" style="v" sid="JHN 16:30"/>ኔኒ ኡባ ባዝ ኤርዛና ኑኒ Ꮊት ኤርዛ፤ ማ ነና ኦንካ ኦይጮድ ጋርክ ኔኒ ኮዮያ። የይ ኑና ኔኒ ጾሳፕ ኪትንቴዝ አስ ማቄዛይ አማንዛ» ዬጌዛ።<verse eid="JHN 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 16:31"/>የዝን፥ የሱሳ ማሂ ኡንትኮ፥ «Ꮊት አማንኔ? <verse eid="JHN 16:31"/><verse number="32" style="v" sid="JHN 16:32"/>ዬዛኮ፥ ይ፥ ይ ካራ ላልንትዝ ዎዳይኔ ታ ኡባስ ኦሊ አሺ ቆስንትዛ ዎዳይ የኦዳ፤ Ꮊተካ ይኢ ሄሌዛ። ዝን አዳይ ታር የዛ ግሾስ ታ ታ ኣዳ ባያ። <verse eid="JHN 16:32"/><verse number="33" style="v" sid="JHN 16:33"/>ይ ታር የዝኮ ሳሮ ይንትስ የዞዳይ ጋርክ ታኒ የያ ኦዴዛ። አላመል የዝታር ይ መትንቶዳ። ዝን ሚንጎይታ፤ ታኒ አላማ ጋሜዛ» ዬጌዛ።<verse eid="JHN 16:33"/></para>
  <chapter eid="JHN 16"/>
  <chapter number="17" style="c" sid="JHN 17"/>
  <para style="s1">የሱሳ ዎሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1"/>የሱሳ የያ ኦዴዛይፕ ጉየ ፑደ ሳሎ ብኢ፥ Ꮊይ ጋርክ ዬጌዛ፦ «አዳዮ፥ ሳታይ ሄሌዛ፤ ነ ናአይ ነና ቦንቾድ ጋርክ ኔኒ ነ ናአ ቦንቾባ። <verse eid="JHN 17:1"/><verse number="2" style="v" sid="JHN 17:2"/>ኔኒ ኤዝስ እንጌዝ ኡባይስ ኤ መናስ ደኦ እማዳይ ጋርክ አስ ኡባይል አፋ ኤዝስ ማዉተ እንጌዛ። <verse eid="JHN 17:2"/><verse number="3" style="v" sid="JHN 17:3"/>መና ደኦካ ነና፥ ፐቲ ቱማ ጾሳኔ ነ ኪቴዝ የሱስ ክርስቶሳ ኤሮ። <verse eid="JHN 17:3"/><verse number="4" style="v" sid="JHN 17:4"/>ነ ታ ኦድ ጋርክ እንጌዝ ኦሳ ፖሊ ነና ሳአል ቦንቼዛ። <verse eid="JHN 17:4"/><verse number="5" style="v" sid="JHN 17:5"/>Ꮊተካ፥ አዳዮ፥ አላመ መንቶዳይፕ ቲና ነ ካለ ታስ የዝ ቦንቻይር ታና ቦንቾባ።<verse eid="JHN 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 17:6"/>«አላመ አሳይፕ ኔኒ ታስ እንጌዝታ ነና ኤርሴዛ። ኡንቲ ኔስታ፤ ኔኒ ኡንታን ታስ እንጌዛ። ኡንቲ ነ ቃላይስካ ኪትንቴዛ። <verse eid="JHN 17:6"/><verse number="7" style="v" sid="JHN 17:7"/>ኔኒ ታስ እንጌዝ ኡባ ባዝ ኔፕ የኤዛና ኡንቲ Ꮊት ኤርዛ። <verse eid="JHN 17:7"/><verse number="8" style="v" sid="JHN 17:8"/>ኔኒ ታስ እንጌዝ ቃላ ታኒ ኡንትስ እንጌዛ፤ ኡንትካ የ ቃላ ኤኬዛ። ታኒ ነ ላንቀፕ የኤዛይ ቱማ ማቅዛና ኤሪ ኔኒ ታና ኪቴዛናካ አማኔዛ።<verse eid="JHN 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 17:9"/>«ታኒ ኡንትስ ዎስዛ። ኡ ኔስታ ማቄዝ ግሾስ ኔኒ ታስ እንጌዝ አሳይስ ዎስዛይፕ አትን አላማይስ ዎሳሚ። <verse eid="JHN 17:9"/><verse number="10" style="v" sid="JHN 17:10"/>ታስ የዛ ኡባባዛይ ነባዝ፤ ኔስ የዝ ኡቢታይካ ታባዝ። ታኒ ኡ ባጋር ቦንችንቴዛ። <verse eid="JHN 17:10"/><verse number="11" style="v" sid="JHN 17:11"/>ታኒ Ꮊይፕ ጉየ አላመል የዛሚ፤ ኡንቲ አላመል የዛ። ታኒ Ꮊት ኔኮ Ꮊንግዛ። ጌሻ አዳዮ፥ Ꮊ ኔኒ ታስ እንጌዝታይ ኔራኔ ታራ ፐቶ ማቄዛይ ጋርክ ኡንቲ ፐቶ ማቃድ ጋርክ ኡንታን ነ ታስ እንጌዝ ነ ሱንይር ናጎባ። <verse eid="JHN 17:11"/><verse number="12" style="v" sid="JHN 17:12"/>ታኒ ኡንታር ሳአል የዛር፥ ነ ታስ እንጌዝ ነ ሱንይ ዎልቃር ኡንታን ናጌዛ። ጌሻ ማጻፋይ ጌዛይ ፖልንቶድ ጋርክ ቦዳይስ ቤዝዛ አይፕ አትን ኡንታፕ ሀራ ኦንካ በካያ።<verse eid="JHN 17:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 17:13"/>«Ꮊት ታ ኔኮ Ꮊንግዛ። ታ ኡፋይሳይ ኡ ዎዝና ጋንጨ ፎሎ ማቃድ ጋርክ Ꮊያ ታኒ አላመል የዛር ኦድዛ። <verse eid="JHN 17:13"/><verse number="14" style="v" sid="JHN 17:14"/>ታኒ ኡንትስ ነ ቃላ እንጌዛ። ታኒ አላመፕ ማቀካዛይ ጋርክ፥ ኡንትካ አላመፕ ማቀካ ግሾስ አላመ ኡንታን እጼዛ። <verse eid="JHN 17:14"/><verse number="15" style="v" sid="JHN 17:15"/>ኔኒ ኢታፕ ኡንታን ናጎድ ጋርከፕ አትን አላመፕ ከሶዳይ ጋርክ ዎሳሚ። <verse eid="JHN 17:15"/><verse number="16" style="v" sid="JHN 17:16"/>ታኒ አላመፕ ማቀካዛይ ጋርክ ኡንትካ አላመፕ ባያ። <verse eid="JHN 17:16"/><verse number="17" style="v" sid="JHN 17:17"/>ኔኒ ነ ቱማትር ኡንታን ነባዝ ኦባ፤ ነ ቃላይካ ቱማ። <verse eid="JHN 17:17"/><verse number="18" style="v" sid="JHN 17:18"/>ኔኒ ታና አላመ ኪቴዛይ ጋርክ ታንካ ኡንታን አላመ ኪቴዛ። <verse eid="JHN 17:18"/><verse number="19" style="v" sid="JHN 17:19"/>ማ ኡንቲ ቱማ ጌሽ ማቃድ ጋርክ ታኒ ታ ኡባ ኡ ግሾስ ታና ታ ጌሽ ኡድዛ።<verse eid="JHN 17:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 17:20"/>«ታኒ ኡ ኣዳስ ባዝን ኡንቲ ቃላ ኦድን፥ ታና አማኖድ አስታይስካ ዎስዛ። <verse eid="JHN 17:20"/><verse number="21" style="v" sid="JHN 17:21"/>ኡንቲ ኡቢታይ ፐቶ ማቃድ ጋርክ ታኒ ዎስዛ። አዳዮ፥ ነ ታር የዛይ ጋርክ፥ ማ ታ ኔር የዛይ ጋርክ ኡንቲ ኑር የዞድ ጋርክ ዎስዛ። የ ዎደ ኔኒ ታና አዛዜዛና አላማይ አማኖዳ። <verse eid="JHN 17:21"/><verse number="22" style="v" sid="JHN 17:22"/>ኔኔ ታኔ ፐቶ ማቄዛይ ጋርክ፥ ኡንቲ ፐቶ ማቃድ ጋርክ፥ ኔኒ ታና ቦንቼዛይ ጋርክ፥ ታንካ ኡንታን ቦንቼዛ። <verse eid="JHN 17:22"/><verse number="23" style="v" sid="JHN 17:23"/>ታኒ ኡ ጋንጨ፥ ኔኒ ታር የዛይ ጋርክ ኡንቲ ፎሎ ፐቶ ማቃድ ጋርክ ነና ዎስዛ። የይካ፥ ነ ታና ኪቴዛናኔ ነ ታና ቃዝ ቃይር ኡንታን ቃዛና አላመ ኤሮድ ጋርከ።<verse eid="JHN 17:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 17:24"/>«አዳዮ፥ ኔኒ ታስ እንጌዝታይ ታኒ የዛ አቆ ታር የዞዳይ ጋርክ ኮይዛ። አላማይ መንቶዳይፕ ቲና ኔኒ ታና ቃዝ ግሾስ ታስ እንጌዝ ታ ቦንቻ ኡንቲ በአዳ።<verse eid="JHN 17:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 17:25"/>«ጌሻ አዳዮ፥ አላመ ነና ኤሮያ፥ ዝን ታን ነና ኤርዛ። ማ ኔኒ ታና አዛዜዛና Ꮊይትታይ ኤርዛ። <verse eid="JHN 17:25"/><verse number="26" style="v" sid="JHN 17:26"/>ኔኒ ታና ሲቄዝ ሲቃይ ኡንታር የዞድ ጋርክ፥ ማ ታኒ ኡንታር ማቃድ ጋርክ፥ ታኒ ነ ሱን ኡንታን ኤርሴዛ፤ ቲናስካ ኤርሶዳ» ዬጌዛ።<verse eid="JHN 17:26"/></para>
  <chapter eid="JHN 17"/>
  <chapter number="18" style="c" sid="JHN 18"/>
  <para style="s1">የሱሳ አይክንት</para>
  <para style="r">(<ref loc="MAT 26:47-56">ማቶ. 26:47-56</ref>፤ <ref loc="MRK 14:43-50">ማር. 14:43-50</ref>፤ <ref loc="LUK 22:47-53">ሉቃ. 22:47-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1"/>የሱሳ ዎሳ ዉርሰዛይፕ ጉየ ፋ ታማርታይር ቀድሮና ሎጳ ፒንጊ፥ የ በሳይድ የዝ ዎይራ ጋደ ጋንጨ ገሌዛ። <verse eid="JHN 18:1"/><verse number="2" style="v" sid="JHN 18:2"/>የሱሳ ጋመ ዎደ ፋ ታማርታይር ኤዛይድ ሺቅዛ ግሾስ የሱሳ ኣ እንጌዝ ይሁዳ የ አቃት ኤርዛ። <verse eid="JHN 18:2"/><verse number="3" style="v" sid="JHN 18:3"/>የይ ግሾስ፥ ይሁዳ ፓኖሰ፥ ዣበ፥ ቶራራኔ ጎንዳለራ አይኬዝ ጋመ ዎታዳርታ፥ ቄሰ ሀላቅታይኔ ፈርሳወ አሳይ ኪቴዝ ጾሳ ኬ ናግዝ ፖልስታ ካል ኤኪ፥ የ አቆ Ꮊንጌዛ።<verse eid="JHN 18:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 18:4"/>የሱሳ ፋና ሄሎድ ሀንዛ ባዝ ኡባ ኤሪ፥ ጋጻ ከዚ፥ «ኦና ኮዬ?» ዬጌዛ።<verse eid="JHN 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 18:5"/>ኡንቲ ማሂ፥ «ናዝረተ የሱሳ ኮይዛ» ዬጌዛ።</para>
  <para style="p" vid="JHN 18:5">ኤ ማሂ፥ «ታና» ዬጌዛ።</para>
  <para style="p" vid="JHN 18:5">የሱሳ ኣ እንጌዝ ይሁዳ ኤዛይድ ኡንታር ኤቄዛ። <verse eid="JHN 18:5"/><verse number="6" style="v" sid="JHN 18:6"/>ኤ፥ «ታና» ጌዝ ዎደ ኡንቲ ጉየ ሺቂ፥ ፎኬዛ። <verse eid="JHN 18:6"/><verse number="7" style="v" sid="JHN 18:7"/>የሱሳ ማካ፥ «ኦና ኮይኔ?» ዬጊ ኦይጬዛ።</para>
  <para style="p" vid="JHN 18:7">ኡንቲ፥ «ናዝረተ የሱሳ ኮይዛ» ዬጌዛ።<verse eid="JHN 18:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 18:8"/>ኤ ማሂ፥ «ታና ማቄዛና ታ ይንትስ ኦዴዛ። ይኬ፥ ይ ታና ኮይዝ ባዝ ማቅኮ Ꮊይትታ ዳኮይታ» ዬጌዛ። <verse eid="JHN 18:8"/><verse number="9" style="v" sid="JHN 18:9"/>ኤ የያ ጌዛይ፥ «አዳዮ፥ ኔኒ ታስ እንገዝታይፕ ሀራ አቶዝን ፐታካ ብሰካ» ጌዝ ቃላይ ፖልንቶድ ጋርከ።<verse eid="JHN 18:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10"/>ስሞን ጵጽሮሳ ማሻ አይኬዛ ግሾስ ፋ ማሻ ሾዲ ቄሰ ሀላቃ አይላይስ ኡሻች ሀይቶ፥ ቃ ኦሌዛ። የ አይላይ ሱንይ ማልኮሳ። <verse eid="JHN 18:10"/><verse number="11" style="v" sid="JHN 18:11"/>የሱሳ ጵጽሮሳኮ፥ «ነ ማሻ ሾካይድ ማሆባ። ታ አዳይ ታስ እንጌዝ ጹአይፕ ታ ኡዣማ ኔስ አዝኔ?» ዬጌዛ።<verse eid="JHN 18:11"/></para>
  <para style="s1">የሱሳ ቄስታይ ቲና ሺቄዛ</para>
  <para style="r">(<ref loc="MAT 26:57-58">ማቶ. 26:57-58</ref>፤ <ref loc="MRK 14:53-54">ማር. 14:53-54</ref>፤ <ref loc="LUK 22:54">ሉቃ. 22:54</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12"/>አይሁደ ዎታዳርታይር ኡ ሀላቃይ ጾሳ ኬ ናግዝ ፖልስታይራ ዎላ የሱሳ አይኪ አጬዛ። <verse eid="JHN 18:12"/><verse number="13" style="v" sid="JHN 18:13"/>ቲና የሱሳና ሃናኮ ካንጌዛ። ሃና የ ላይ ቄሰ ሀላቃ ማቅዝ ቃያፋ ቦለ። <verse eid="JHN 18:13"/><verse number="14" style="v" sid="JHN 18:14"/>ቃያፋ፥ «ዎያ ግሾስ ፐቲ አሲ Ꮊይቅኮ ሎኦ» ግ ቲና አይሁድታና ዞሬዛያ።<verse eid="JHN 18:14"/></para>
  <para style="s1">ጵጽሮሳ የሱሳና ካዴዛ</para>
  <para style="r">(<ref loc="MAT 26:69-70">ማቶ. 26:69-70</ref>፤ <ref loc="MRK 14:66-68">ማር. 14:66-68</ref>፤ <ref loc="LUK 22:55-57">ሉቃ. 22:55-57</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15"/>ስሞን ጵጽሮሳኔ ሀራ ፐቲ ታማራይ የሱሳ ካሊ ቅቴዛ። ቄሰ ሀላቃይ የ Ꮊንኮ ታማራ ሎእ ኤርዛ። የይ ግሾስ፥ ኤ የሱሳር ቄሰ ሀላቃይ ዛባ ገሌዛ። <verse eid="JHN 18:15"/><verse number="16" style="v" sid="JHN 18:16"/>ዝን ጵጽሮሳ ባለር ጋሰ ፐንገል ኤቄዛ። ቄሰ ሀላቃይ ኤርዛ ሀራ ታማራይ ባለ ከዚ፥ ፐንገ ናግዛ አስትስ ኦድን፥ ጵጽሮሳ ገልሴዛ። <verse eid="JHN 18:16"/><verse number="17" style="v" sid="JHN 18:17"/>ፐንገ ናግዝ አስታ ጵጽሮሳኮ፥ «ኔኒ፥ የ አይ ታማርታይፕ ፐታ ባሳ?» ዬጌዛ።</para>
  <para style="p" vid="JHN 18:17">ጵጽሮሳ ማሂ፥ «ዋኣ» ዬጌዛ።<verse eid="JHN 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 18:18"/>ሳአይ ሜግዛ ግሾስ አይልታይራኔ ናግዝታይ ጺፈ ታማ ኤ፥ ማሪ ኤቂ ካዥዛ። ጵጽሮሳካ ኡንታር ኤቂ ታማ ካዥዛ።<verse eid="JHN 18:18"/></para>
  <para style="s1">ቄሰ ሀላቃይ የሱሳና ኦይጬዛ</para>
  <para style="r">(<ref loc="MAT 26:59-66">ማቶ. 26:59-66</ref>፤ <ref loc="MRK 14:55-64">ማር. 14:55-64</ref>፤ <ref loc="LUK 22:66-71">ሉቃ. 22:66-71</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19"/>ቄሰ ሀላቃይ የሱሳ፥ ኤ ታማርታይባጋኔ ኤ ትምርታይባጋ ኦይጬዛ። <verse eid="JHN 18:19"/><verse number="20" style="v" sid="JHN 18:20"/>የሱሳ ማሂ፥ «ታኒ አስ ኡባስ ጌሻ ኦዴዛ። ታኒ አይሁደ ኡቢታይ ሺቅዛ አይሁድታይ ዎሳ ኬ ግዶኔ ጾሳ ኬ ኡባ ዎደ ታማርሴዛ። ጌማ አብካ ኦደካያ። <verse eid="JHN 18:20"/><verse number="21" style="v" sid="JHN 18:21"/>የዝን፥ ኔኒ ታና አብስ ኦይጨ? ታ ኦዶዳር ስኤዝ አሳ ኦይጮባ። የ አሳይ ታኒ ኦዴዛና ኤርዛ» ዬጌዛ።<verse eid="JHN 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 18:22"/>የሱሳ የያ ጌዝ ዎደ የ በሳይድ ኤቄዝ ዎታዳርታይፕ ፐታይ የሱሳ ባቂ፥ «ቄሰ ሀላቃይስ Ꮊይ ጋርክ ዬጊ ማህኔ?» ዬጌዛ።<verse eid="JHN 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 18:23"/>የሱሳ ማሂ፥ «ታኒ ኢታ ባዝ ኦድንቴዝ ማቅኮ ማርካ ኮኦባ። ዝን ታኒ ቱሮ ኦድንቴዝ ማቅኮ ታና አብስ ባቄ?» ዬጌዛ።<verse eid="JHN 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 18:24"/>የይ ግሾስ፥ ሃና፥ የሱሳ አጭንቴዛን ጋርክ ቄሰ ሀላቃ ቃያፋኮ ዳኬዛ።<verse eid="JHN 18:24"/></para>
  <para style="s1">ጵጽሮሳ የሱሳና ካዴዛ</para>
  <para style="r">(<ref loc="MAT 26:71-75">ማቶ. 26:71-75</ref>፤ <ref loc="MRK 14:69-72">ማር. 14:69-72</ref>፤ <ref loc="LUK 22:58-62">ሉቃ. 22:58-62</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25"/>ጵጽሮሳ ኤዛይድ ኤቂ፥ ታማ ካዦዳር፥ አቴዝ አሳይ ኤዝኮ፥ «ኔኒ Ꮊ አይ ታማርታይፕ ፐታ ባሳ?» ዬጌዛ።</para>
  <para style="p" vid="JHN 18:25">ጵጽሮሳ ማሂ፥ «ዋኣ፥ ታኒ ኤ ታማረ ባያ» ዬጊ ካዴዛ።<verse eid="JHN 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 18:26"/>ቄሰ ሀላቃይ አይልታይፐ ፐታይ፥ ጵጽሮሳ ሀያ ጋቼዝ አይ ዳባይ፥ ጵጽሮሳኮ፥ «ታኒ ነና ኤዛር አታክልታይ ጋንጨ በኤካሳኔ?» ዬጊ ኦይጬዛ።<verse eid="JHN 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 18:27"/>ጵጽሮሳ ማካ ካዴዛ። ኤ የያ ጌዛን ጋርክ ሹጉላ ኡኬዛ።<verse eid="JHN 18:27"/></para>
  <para style="s1">የሱሳ ጵላጾሳ ቲና</para>
  <para style="r">(<ref loc="MAT 27:1-2">ማቶ. 27:1-2</ref>፥ <ref loc="MAT 27:11-14">11-14</ref>፤ <ref loc="JHN 13:38">ዋን. 13:38</ref>፤ <ref loc="MRK 15:1-5">ማር. 15:1-5</ref>፤ <ref loc="LUK 23:1-5">ሉቃ. 23:1-5</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28"/>ዎንታ ጉራ፥ ኡንቲ የሱሳና ቃያፋ ካራፕ ጋደ አቅስዛይ ኦሶ ኬ ካንጌዛ። አይሁድታይ ፓዝቃ ባለ ካ ማዳይስ ፋና ቱንሳማይ ጋርክ ጋደ አቅስዛይ ኦሶ ኬ ገለካያ። <verse eid="JHN 18:28"/><verse number="29" style="v" sid="JHN 18:29"/>የይ ግሾስ፥ ጵላጾሳ ኡንትኮ ባለ ከዚ፥ «Ꮊ አ አብስ ሞቴ?» ዬጌዛ።<verse eid="JHN 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 18:30"/>ኡንቲ፥ «ኤ ኢታ ኦካባዝ ማቄዛኮ ኑኒ ኤዛ ኔኮ ከኣሚ» ዬጌዛ።<verse eid="JHN 18:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 18:31"/>ጵላጾሳ ማሂ፥ «ይ ኤዛ ኤኪ ካንጊ፥ ይ ህጋይ ግዛይ ጋርክ ኤዛል አፋ ፕርዶይታ» ዬጌዛ።</para>
  <para style="p" vid="JHN 18:31">አይሁድታይ፥ «ኦናካ ዎዛ ማዉተ ኑስ ባያ» ዬጌዛ፤ <verse eid="JHN 18:31"/><verse number="32" style="v" sid="JHN 18:32"/>የይ ሀኔዛይ የሱሳ አብ ጋርክ Ꮊይቆ Ꮊይቆዳዛኮ ኤርሶዳይስ ኦዴዝ ቃላይ ፖልንቶዳይሲ።<verse eid="JHN 18:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 18:33"/>ጵላጾሳ ፋ ኦሶ ኬ ማቂ ገሊ፥ የሱሳ ጼጊ፥ «ኔኒ አይሁደ ካቶ?» ዬጊ ኦይጬዛ።<verse eid="JHN 18:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 18:34"/>የሱሳ ጵላጾሳኮ፥ «Ꮊ ኦይቻ ኔኒ ኔፕ ኦይጭነኔ ዎይ ሀራ አሲ ኔስ ታባዝ ኦዴኔ?» ዬጌዛ።<verse eid="JHN 18:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 18:35"/>ጵላጾሳ ማሂ፥ «ታ አይሁደ አሶ? ነ አሳይራ ቄሰ ሀላቅታይ ነና ታስ ኣ እንጌዛ። ነ አብ ኦኔ?» ዬጌዛ።<verse eid="JHN 18:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 18:36"/>የሱሳ፥ «ታ ካተትይ Ꮊ አላማይድ ባያ። ኤ Ꮊይዳ ማቄዛኮ ታ አይሁድታይ ሀላቅታይስ ኣ እንግንቶድ ጋርክ ታ አይልታይ ታስ ኦልንቶዳ። ዝን ታ ካተትይ Ꮊ አላማይድ ባያ» ዬጌዛ።<verse eid="JHN 18:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 18:37"/>የይ ግሾስ፥ ጵላጾሳ የሱሳኮ፥ «የዝን፥ ኔኒ ካቶኔ?» ዬጊ ኦይጬዛ።</para>
  <para style="p" vid="JHN 18:37">የሱሳ ማሂ፥ «ቱማ ታ ካተ ማቅዛና ነ ጌዛ። ታኒ የልንቴዛይኔ Ꮊ አላመ የኤዛይ ቱማትስ ማርካቶዳይስ። ቱማ ባጋ ማቄዝ ኦንካ ታኒ ግዛ ስእዛ» ዬጌዛ።<verse eid="JHN 18:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 18:38"/>ጵላጾሳ፥ «ቱማ አባ ባዞ?» ዬጌዛ።</para>
  <para style="p" vid="JHN 18:38">ጵላጾሳ የያ ጌዛይፕ ጉየ አይሁድታይኮ ባለ ከዚ፥ «ታኒ ኤፕ አባ ኢታካ ደንገካያ። <verse eid="JHN 18:38"/><verse number="39" style="v" sid="JHN 18:39"/>ዝን ፓዝቃ ባለ ጋላስ፥ ፐቲ አሲ ይንትስ አቻፕ ብልእዝ ዎጋ የዛ። ታኒ ይንትስ አይሁድታይ ካታ ብሎድ ጋርክ ኮይኔ?» ዬጌዛ።<verse eid="JHN 18:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 18:40"/>ኡንቲ ማሂ፥ ፋ ቃላ ቅ ኡዲ፥ «ባርባና ብሎባፕ አትን ኤዛ ባያ» ዬጌዛ። ዝን ባርባና ፓኖ።<verse eid="JHN 18:40"/></para>
  <chapter eid="JHN 18"/>
  <chapter number="19" style="c" sid="JHN 19"/>
  <para style="s1">የሱሳ ሶትንቶዳይ ጋርከ ፕርዴዛ።</para>
  <para style="r">(<ref loc="MAT 27:27-32">ማቶ. 27:27-32</ref>፤ <ref loc="MRK 15:15-21">ማር. 15:15-21</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1"/>የይፕ ጉየ፥ ጵላጾሳ የሱሳና ጋራፍሴዛ። <verse eid="JHN 19:1"/><verse number="2" style="v" sid="JHN 19:2"/>ዎታዳርታይ አንጉን ዛዉደ መ ኤ ኦማይል ጋዴዛ። ማ ዞቆ አፍላ ኤዛ ማእሴዛ። <verse eid="JHN 19:2"/><verse number="3" style="v" sid="JHN 19:3"/>ኤዝኮ ሺቂ፥ «አይሁደ ካታዮ፥ መናስ ካዉቶባ» ዬጊ ኤዛ ባቄዛ።<verse eid="JHN 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 19:4"/>ጵላጾሳ ማካ ባለ ከዚ፥ አይሁድታይኮ፥ «ዬዛኮ፥ ታኒ ኤፕ አባ ኢታካ ደንገካዛ ይ ኤሮድ ጋርክ ኤዛ ይንትኮ ባለ ከሶዳ» ዬጌዛ። <verse eid="JHN 19:4"/><verse number="5" style="v" sid="JHN 19:5"/>የይፕ ጉየ፥ የሱሳ አንጉን ዛዉደ ፋ ኦማል ጋዲ፥ ዞቆ አፍላ ማኢ፥ ባለ ከዜዝ። ጵላጾሳ አይሁድታይኮ፥ «አ Ꮊያ ቦኦይታ» ዬጌዛ።<verse eid="JHN 19:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 19:6"/>ቄሰ ሀላቅታይኔ ጾሳ ኬ ናግዝታይ ኤዛ በኤዝ ዎደ ፋ ቃላ ቅ ኡዲ፥ «ማዝቃለል አፋ ሶቶባ! ሶቶባ!» ዬጌዛ።</para>
  <para style="p" vid="JHN 19:6">ጵላጾሳ ኡንትኮ፥ «ይ ኤዛ ካንጊ፥ ማዝቃለል አፋ ሶቶይታ። ታኒ ኤፕ አባ ኢታካ ደንገካያ» ዬጌዛ።<verse eid="JHN 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 19:7"/>አይሁድታይ ማሂ፥ «ኑስ ህጋይ የዛ። ኤ ፋና ጾስ ናአ ኦዝ ግሾስ ኑ ህጋይ ጋርክ ኤ Ꮊይቆዳይስ ቤዝዛ» ዬጌዛ።<verse eid="JHN 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 19:8"/>ጵላጾሳ የያ ስኤዝ ዎደ ቲናሳይፕ ኢታ ያሽቴዛ። <verse eid="JHN 19:8"/><verse number="9" style="v" sid="JHN 19:9"/>ማካ ጵላጾሳ ፋ ኦሶ ኬ ማቂ ገሊ የሱሳኮ፥ «ኔኒ አናፕ የኤኔ?» ዬጊ ኦይጬዛ። ዝን የሱሳ ኤዝስ አብካ ማሄካያ። <verse eid="JHN 19:9"/><verse number="10" style="v" sid="JHN 19:10"/>የይ ግሾስ፥ ጵላጾሳ፥ «ታስ ኦዶሳ? ነና ብሎዳይስ ዎይ ማዝቃለል አፋ ሶቶዳይስ ታስ ማዉተ የዛና ኤሮሳ?» ዬጌዛ።<verse eid="JHN 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 19:11"/>የሱሳ፥ «ጾሳይ ኔስ ስልጻኔ እንገካባዝ ማቄዛኮ ታል አፋ ስልጻኔ ኔስ ባቦናዝን። የይ ግሾስ፥ ታና ኔስ ኣ እንጌዛይ ኣዝ ናጋራ ኦዛ» ዬጌዛ።<verse eid="JHN 19:11"/></para>
  <para style="r">(<ref loc="MAT 27:15-31">ማቶ. 27:15-31</ref>፤ <ref loc="MRK 15:6-20">ማር. 15:6-20</ref>፤ <ref loc="LUK 23:13-25">ሉቃ. 23:13-25</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12"/>ጵላጾሳ የያ ስኤዝ ዎደ የሱሳ ብሎዳይስ ኦገ ኮዬዛ። ዝን አይሁድታይ ፋ ቃላ ቅ ኡዲ፥ «ኔኒ ኤዛ ብልዝባዝ ማቅኮ ካታይ ቄሳረ ባጋ ባያ። ፋና ካተ ግዝ ኦንካ ቄሳረስ ሞርከ» ዬጌዛ።<verse eid="JHN 19:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13"/>ጵላጾሳ የያ ስኢ የሱሳ ባለ ከሲ «ሎቼ ሹች» ዬግዝ ቤስ ፕርደ ኦይደል በቴዛ። እብራይስጸ ቃላይር የ አቃይ «ገበታ» ጉሲ። <verse eid="JHN 19:13"/><verse number="14" style="v" sid="JHN 19:14"/>የ ጋላሳይ ፓዝቃ ባለ ቦንቾዳይስ ጊግንቶ ጋላስ። የ ዎደ ሳአ ኡሱፑን ሳተ ሄራ። ጵላጾሳ አይሁድታይኮ፥ «ይ ካታ Ꮊያ ቦኦይታ» ዬጌዛ።<verse eid="JHN 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 19:15"/>አይሁድታይ ፋ ቃላ ቅ ኡዲ፥ «ብሶባ! ብሶባ! ማዝቃለል አፋ ሶቶባ» ዬጌዛ።</para>
  <para style="p" vid="JHN 19:15">ጵላጾሳ ማሂ፥ «ይ ካታ ታኒ ማዝቃለል አፋ ሶቶዳይስ ኮይኔ?» ዬጊ ኦይጬዛ።</para>
  <para style="p" vid="JHN 19:15">ቄሰ ሀላቅታይ፥ «ቄሳረፕ ሀራ ካት ኑስ ባያ» ዬጌዛ።<verse eid="JHN 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 19:16"/>የይፕ ጉየ፥ ኡንቲ የሱሳ ማዝቃለል አፋ ሶቶድ ጋርክ ጵላጾሳ ኡንትስ ኣ እንጌዛ።</para>
  <para style="p" vid="JHN 19:16">ኡንቲ የሱሳ አይኪ ካንጌዛ።<verse eid="JHN 19:16"/></para>
  <para style="s1">የሱሳ ሶትንታ</para>
  <para style="r">(<ref loc="MAT 27:32-44">ማቶ. 27:32-44</ref>፤ <ref loc="MRK 15:21-32">ማር. 15:21-32</ref>፤ <ref loc="LUK 23:26-43">ሉቃ. 23:26-43</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 19:17"/>የሱሳ ፋ ማዝቃላ ቶኪ፥ «ኦማ ኦታ» ግዝ አቆ Ꮊንጌዛ። «ኦማ ኦታ» ጉሳይ እብራይስጸ ቃላይር «ጎልጎታ» ጉሲ። <verse eid="JHN 19:17"/><verse number="18" style="v" sid="JHN 19:18"/>ኡንቲ የ አቃይድ ማዝቃለል አፋ የሱሳ ሶቴዛ። ማ ኤዛር ሀራ ናምኢ አስታ፥ ፐታ ገደ ባጋር Ꮊንካ Ꮊና ባጋር ማዝቃለል አፋ ሶቴዛ። <verse eid="JHN 19:18"/><verse number="19" style="v" sid="JHN 19:19"/>ጵላጾሳ፥ «አይሁድታይ ካት፥ ናዝረተ የሱሳ» ዬግዝ ጹፈ ጻፊ ማዝቃለል አፋ ጋዴዛ። <verse eid="JHN 19:19"/><verse number="20" style="v" sid="JHN 19:20"/>የሱሳ ማዝቃለል አፋ ሶትንቴዝ አቃይ ካታማስ ካለ የዝ ግሾስ ጋመ አይሁድታይ የ ጹፋ ናባቤዛ። ጹፋይ ጻፍንቴዛይ እብራይስጸ ዶናር፥ ላትኔ ዶናራኔ ግርከ ዶናራ። <verse eid="JHN 19:20"/><verse number="21" style="v" sid="JHN 19:21"/>የይ ግሾስ፥ ቄሰ ሀላቅታይ ጵላጾሳኮ፥ «‹Ꮊ አይ ፋና አይሁደ ካት ዬጌዛ› ግ ጻፎባፕ አትን ‹አይሁደ ካት› ግ ጻፍፐ» ዬጌዛ።<verse eid="JHN 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 19:22"/>የዝን፥ ጵላጾሳ፥ «ታ ጻፌዛና ጻፌዛ» ዬጊ ማሄዛ።<verse eid="JHN 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23"/>ዎታዳርታይ ማዝቃለል አፋ ኤዛ ሶቴዛይፕ ጉየ ኤ አፍላ ኤኪ፥ ኦይዲ አቆ ዎላ ቆእንቲ፥ ፐቶ ፐቶ ኤኬዛ። ኤ አፋር ኦሊ ማእዛ አዱሰ አፍላ ኤኬዛ። <verse eid="JHN 19:23"/><verse number="24" style="v" sid="JHN 19:24"/>ዎታዳርታይ፥ «ኦና ሄሎዳዛኮ፥ እጻ ኦሎዳይፕ አትን አፍላ ፐርአሚ» ዬጌዛ። የይ ሀኔዛይ ጌሻ ማጻፋይድ፥</para>
  <para style="q1" vid="JHN 19:24">«ታ አፍላ ሻኪ ኤኬዛ፤</para>
  <para style="q2" vid="JHN 19:24">ታ አዱሰ አፍላ ጉጅካ እጻ ኦሌዛ»</para>
  <para style="m" vid="JHN 19:24">ግንትንትዛይ ፖልንቶድ ጋርከ። የይ ግሾስ፥ ዎታዳርታይ የያ ኦዛ።<verse eid="JHN 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25"/>ዝን የሱሳ ማዝቃለ ካለ ኤ እንዳት፥ ኤ እንዳት ምሽት፥ ቀልዮጰ ማቻት ማይራምራ ማግዴላ ማይራማ ኤቄዛ። <verse eid="JHN 19:25"/><verse number="26" style="v" sid="JHN 19:26"/>የሱሳ ፋ እንዳትኔ ኤ ቃዛ ታማራይ ኤዛይድ ኤቄዝታ ብኢ፥ ፋ እንዳትኮ፥ «ታ እንዳቴ፥ ነ ናአ Ꮊያ ቦኦባ» ዬጌዛ።<verse eid="JHN 19:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 19:27"/>የይፕ ጉየ፥ የ ታማራይኮ፥ «ነ እንዳት Ꮊኖ ቦኦባ» ዬጌዛ። የ ታማራይ እዞ የ ዎደፕ አይኪ ፋ ካራ ካንጌዛ።<verse eid="JHN 19:27"/></para>
  <para style="s1">የሱሳ Ꮊይቄዛ</para>
  <para style="r">(<ref loc="MAT 27:45-56">ማቶ. 27:45-56</ref>፤ <ref loc="MRK 15:33-41">ማር. 15:33-41</ref>፤ <ref loc="LUK 23:44-49">ሉቃ. 23:44-49</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28"/>የይፕ ጉየ፥ የሱሳ ኡባይ Ꮊት ፖልንቴዛና ኤሪ፥ ጌሻ ማጻፋይድ ጻፍንቴዛይ ፖልንቶድ ጋርክ «ታና ሳምዛ» ዬጌዛ።<verse eid="JHN 19:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 19:29"/>የ አቃይድ ፐቲ ጹጋ ኩን ጫላ ዎይነ የዛ። ኡንቲ ዛንዛ የ ዎይናይድ ኦሊ፥ ህሶጰ ም ጼራል ጋዲ፥ የሱሳ ዶናይኮ ሺሼዛ። <verse eid="JHN 19:29"/><verse number="30" style="v" sid="JHN 19:30"/>የሱሳ ዎይና ጋንጺ ብኢ፥ «ፖልንቴዛ» ዬጌዛ።</para>
  <para style="p" vid="JHN 19:30">የይፕ ጉየ፥ ፋ ሞርጋ ዝቅ ኡዲ ፋ ሸምፓ እንጌዛ።<verse eid="JHN 19:30"/></para>
  <para style="s1">የሱሳ ምያ ቶራር ጫዴዛ</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31"/>የ ጋላስ ጊግንቶ ጋላስ ማቅዝ ግሾኔ ዎንት ጋላሳይ ቦንቾ ማላ ማቅዝ ግሾስ አሳይ አሃይ ማዝቃለል አፋ ማላ ጋላስ ፔዣም ጋርክ ኡንታን ቶካ መን፥ ማዝቃላይፕ ዎሶዳይ ጋርክ አይሁድታይ ጵላጾሳ ዎሴዛ። <verse eid="JHN 19:31"/><verse number="32" style="v" sid="JHN 19:32"/>የይ ግሾስ፥ ዎታዳርታይ Ꮊንጊ፥ የሱሳር ሶትንቴዝ ናምኢ አሳይ ቶካ መንዛ። <verse eid="JHN 19:32"/><verse number="33" style="v" sid="JHN 19:33"/>ዝን የሱሳኮ የኤዝ ዎደ ኤ Ꮊይቄዛ ብኢ፥ ኤ ቶካ መንካያ። <verse eid="JHN 19:33"/><verse number="34" style="v" sid="JHN 19:34"/>ዝን ዎታዳርታይፕ ፐታይ ኤ ምያ ቶራር ጫድን ኤለ ሱኔ ሃ ጎጌዛ። <verse eid="JHN 19:34"/><verse number="35" style="v" sid="JHN 19:35"/>ይ አማኖድ ጋርክ የያ በኤዛይ ማርካቴዛ። ኤ ማርካትይካ ቱማ። ማ የይፕ ኤ ኦሳ ኦድዛይ ቱማ ማቄዛ ኤርዛ። <verse eid="JHN 19:35"/><verse number="36" style="v" sid="JHN 19:36"/>የይ ሀኔዛይ ጌሻ ማጻፋይ፥ «ኤ መቀታይፕ ፐቲ ባዝካ መቀና» ጌዛይ ፖልንቶድ ጋርከ። <verse eid="JHN 19:36"/><verse number="37" style="v" sid="JHN 19:37"/>ማካ ጌሻ ማጻፋይ ሀራ አቆ፥ «ኡንትካ ፋ ጫዴዛና በአዳ» ዬጌዛ።<verse eid="JHN 19:37"/></para>
  <para style="s1">የሱሳ ሞግንቴዛ</para>
  <para style="r">(<ref loc="MAT 27:57-61">ማቶ. 27:57-61</ref>፤ <ref loc="MRK 15:42-47">ማር. 15:42-47</ref>፤ <ref loc="LUK 23:50-56">ሉቃ. 23:50-56</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38"/>የይፕ ጉየ፥ አርማታሳ ግዝ ካታማፕ የኤዝ ዮሴፋ የሱሳ አሃ ኤኮዳይስ ጵላጾሳ ዎሴዛ። ዮሴፋ አይሁድታይስ ያሽቴዝ ግሾስ ቆሶር የሱሳ ካልዛ።</para>
  <para style="p" vid="JHN 19:38">ጵላጾሳ፥ «ኤኮባ» ዬጌዛ። የይ ግሾስ፥ ዮሴፋ ሺቂ የሱሳ አሃ ኤኬዛ። <verse eid="JHN 19:38"/><verse number="39" style="v" sid="JHN 19:39"/>ማ የይፕ ንቆድሞሳ፥ Ꮊይፕ ቲን የሱሳኮ ቃማ የኤዛይ፥ ካርበኔ ጎዳረ ኡራ ዋላክንቴዝ ፐቲ ክሎ ግራመ ማቅዝ ሽቶ ኤኪ ዮሴፋር ዎላ የኤዛ። <verse eid="JHN 19:39"/><verse number="40" style="v" sid="JHN 19:40"/>የ ናምኢ አስታይ የሱስ አሃ ኤኪ፥ አይሁድታይ አሃ ዚ ዎጋር፥ ሽቶራ፥ ሞጎ አፍላር ሳዋጼዛ። <verse eid="JHN 19:40"/><verse number="41" style="v" sid="JHN 19:41"/>የሱሳ ሶትንቴዝ አቃይ አታክልተ ጋደ። የ አታክልተ ጋንጨ ሹቻፕ ዎጭንት ጊጌዝ ቲና ኦንካ ሞግንተካ ኦሮ ዱፋይ የዛ። <verse eid="JHN 19:41"/><verse number="42" style="v" sid="JHN 19:42"/>የ ዱፋይ ላንቀ የዝ ግሾኔ አይሁድታይ ማላስ ጊግንትዛ ጋላስ ማቄዝ ግሾስ የሱሳ አሃ ሞጌዛ።<verse eid="JHN 19:42"/></para>
  <chapter eid="JHN 19"/>
  <chapter number="20" style="c" sid="JHN 20"/>
  <para style="s1">የሱሳ Ꮊይቆፕ ደንዴዛ</para>
  <para style="r">(<ref loc="MAT 28:1-8">ማቶ. 28:1-8</ref>፤ <ref loc="MRK 16:1-8">ማር. 16:1-8</ref>፤ <ref loc="LUK 24:1-12">ሉቃ. 24:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1"/>ያ ሳምንታትስ ቲና ጋላስ ሳአ ጌዠካዝን፥ ማግዴላ ማይራማ፥ የሱሳ ሞግንቴዝ ዱፋይኮ Ꮊንጊ ሹቻይ የ ዱፋይ ዶናይፕ ሀልኤዛና በኤዛ። <verse eid="JHN 20:1"/><verse number="2" style="v" sid="JHN 20:2"/>እዛ ስሞን ጵጽሮሳኮኔ የሱሳ ቃዛ Ꮊንኮ ታማራይኮ ዎጺ Ꮊንጊ፥ «ዱፋይፕ ጎዳ ኤኪ ብሴዛ፤ ኤዛ አባ ጋዴዛኮ ኑ ኤሮያ» ዬጌዛ።<verse eid="JHN 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 20:3"/>የይ ግሾስ፥ ጵጽሮሳኔ Ꮊንኮ ታማራይ ከዚ ዱፎ Ꮊንጌዛ። <verse eid="JHN 20:3"/><verse number="4" style="v" sid="JHN 20:4"/>ናምእታይካ ዎላ ዎጼዛ፤ ዝን Ꮊንኮ ታማራይ ጵጽሮሳፕ ኣ ቲናቲ ዱፎ ሄሌዛ። <verse eid="JHN 20:4"/><verse number="5" style="v" sid="JHN 20:5"/>የ ታማራይ ዙጊ፥ ሞጎ አፍላ በኤዛ፥ ዝን ዱፎ ጋንጨ ዎካያ። <verse eid="JHN 20:5"/><verse number="6" style="v" sid="JHN 20:6"/>ስሞን ጵጽሮሳ ኤዛ ካሊ ይኢ፥ ዱፎ ዎ ሞጎ አፍላይ ኤዛይድ የዛና በኤዛ። <verse eid="JHN 20:6"/><verse number="7" style="v" sid="JHN 20:7"/>ማ የሱሳ ኦማስ ጻጽንቴዝ አፍላይ ዳክንንቲ ዱማ ፐቲ አቆ የዛና በኤዛ። የ አፍላይ ዱማ የዛይፕ አትን ሞጎ አፍላይር ዎላ ባያ። <verse eid="JHN 20:7"/><verse number="8" style="v" sid="JHN 20:8"/>የ ዎደ ቲናቲ ዱፎ ሄሌዝ Ꮊንኮ ታማራይ ገሊ ብኢ አማኔዛ። <verse eid="JHN 20:8"/><verse number="9" style="v" sid="JHN 20:9"/>የሱሳ Ꮊይቆፕ ደንዶ ቤዝዛና ኦድዛ ጌሻ ማጻፈ ቃላ ኡንቲ ሀጋ አካከካያ። <verse eid="JHN 20:9"/><verse number="10" style="v" sid="JHN 20:10"/>የይፕ ጉየ፥ ኤ ታማርታይ ፋ ካራ ማቂ Ꮊንጌዛ።<verse eid="JHN 20:10"/></para>
  <para style="s1">የሱሳ ማግዴላ ማይራምስ በንቴዛ</para>
  <para style="r">(<ref loc="MAT 28:9-10">ማቶ. 28:9-10</ref>፤ <ref loc="MRK 16:9-11">ማር. 16:9-11</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11"/>ዝን ማይራማ የ ዱፋይ ዶናይድ ኤቂ ዬክታር ዙጊ ዱፋይ ጋንጨ በኤዛ። <verse eid="JHN 20:11"/><verse number="12" style="v" sid="JHN 20:12"/>ቦ አፍላ ማኤዝ ናምኢ ኪታንችታይ የሱሳ አሃይ ዎይኤዝ አቃይድ ፐታይ ኦማ አቻራ Ꮊንካይ ቶኬ አቻራ በቴዝታ በኤዛ። <verse eid="JHN 20:12"/><verse number="13" style="v" sid="JHN 20:13"/>ኡንቲ ኢኮ፥ «Ꮊን አስተ፥ አብስ ዬኬ?» ዬጊ ኦይጬዛ።</para>
  <para style="p" vid="JHN 20:13">እዛ፥ «ኡንቲ ታ ጎዳ ኤኪ ቤዛ፤ ኡንቲ አባ ጋዴዛኮ ታኒ ኤሮያ» ዬጌዛ።<verse eid="JHN 20:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 20:14"/>የያ ጌዛይፕ ጉየ፥ እዛካ ጉየ ማቂ በአዳር የሱሳ ኤዛይድ ኤቄዛና በኤዛ። ዝን ኤ የሱሳ ማቄዛና ኤረካያ። <verse eid="JHN 20:14"/><verse number="15" style="v" sid="JHN 20:15"/>የሱሳ እዝኮ፥ «Ꮊን አስተ፥ አብስ ዬኬ? ኦና ኮዬ?» ዬጊ ኦይጬዛ።</para>
  <para style="p" vid="JHN 20:15">ማይራማ አታክልተ ናግዛ አሲ ኣዝን፥ «ጎዳዮ፥ ነ ኤኬዝባዝ ማቅኮ፥ ኤዛ አባ ጋዴዛኮ ታስ ኦዶየ። ታኒ ኤዛ ኤኮዳ» ዬጌዛ።<verse eid="JHN 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 20:16"/>የሱሳ እዝኮ፥ «ማይራመ» ዬጌዛ።</para>
  <para style="p" vid="JHN 20:16">እዛ ኤዝኮ ማሂ፥ እብራይስጸ ዶናር «ረቡኒ» ዬጌዛ። የይስ ብርሽይ «አስታማራዮ» ጉሲ።<verse eid="JHN 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 20:17"/>የሱሳ እዝኮ፥ «ታኒ ሀጋ ታ አዳይኮ Ꮊንገካ ግሾስ ታና አይኪ አሾዳይስ ኮይፐ። ዝን ታ እሽታይኮ Ꮊንጊ፥ ‹ታኒ ታ አዳይኮኔ ይ አዳይኮ፥ ታ ጾሳይኮኔ ይ ጾሳይኮ፥ Ꮊማዳ ጌዛ› ግ ኡንትስ ኦዶባ» ዬጌዛ።<verse eid="JHN 20:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 20:18"/>ማግዴላ ማይራማ ጎዳ በኤዛናኔ እዝስ የያ ኤ ኦዴዛና Ꮊንጊ ኤ ታማርታይስ ኦዴዛ።<verse eid="JHN 20:18"/></para>
  <para style="s1">የሱሳ ፋ ታማርታይስ በንቴዛ</para>
  <para style="r">(<ref loc="MAT 28:16-20">ማቶ. 28:16-20</ref>፤ <ref loc="MRK 16:14-18">ማር. 16:14-18</ref>፤ <ref loc="LUK 24:36-49">ሉቃ. 24:36-49</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19"/>ሳምንታይፕ ቲና ጋላስ ኦማርሰ፥ ኤ ታማርታይ አይሁድታይስ ያሽቲ እብ ጎርዲ ሺቂ በቴዝን፥ የሱሳ ይኢ፥ ኡ ጋንጨ ኤቂ፥ «ሳሮ ይንትስ ማቆ» ዬጌዛ። <verse eid="JHN 20:19"/><verse number="20" style="v" sid="JHN 20:20"/>የያ ግ ማቂ ፋ ኩሻኔ ፋ ምያ ኡንታን ቤዜዛ። ኤ ታማርታይ ጎዳ ብኢ ጋመ ኡፋይቴዛ። <verse eid="JHN 20:20"/><verse number="21" style="v" sid="JHN 20:21"/>የሱሳ ማሂ ኡንትኮ፥ «ሳሮ ይንትስ ማቆ፤ ታ አዳይ ታና ኪቴዛይ ጋርክ ታንካ ይንታን ኪትዛ» ዬጌዛ። <verse eid="JHN 20:21"/><verse number="22" style="v" sid="JHN 20:22"/>የያ ጌዛይፕ ጉየ፥ ኡንታል አፋ ኡፍ ግ ፑጌዛ። ማ፥ «ጌሻ አያና ኤኮይታ። <verse eid="JHN 20:22"/><verse number="23" style="v" sid="JHN 20:23"/>ይንቲ አቶ ጌዝ አሳይ ናጋራይ አቶ ግንትንቶዳ። ይ አቶ ጌካዝታይስ ናጋራይ አቶ ጊንትንታሚ» ዬጌዛ።<verse eid="JHN 20:23"/></para>
  <para style="s1">የሱሳራ ቶማሳ</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24"/>ዝን ታጶ ናምኢ ታማርታይፕ ፐታይ፥ ድድሞሳ ግንትንትዝ ቶማሳ፥ የሱሳ የኤዝ ዎደ ኡንታር ባያ። <verse eid="JHN 20:24"/><verse number="25" style="v" sid="JHN 20:25"/>የይ ግሾስ፥ Ꮊንኮ ኤ ታማርታይ ቶማሳኮ፥ «ኑኒ ጎዳ በኤዛ» ዬጌዛ።</para>
  <para style="p" vid="JHN 20:25">ዝን ቶማሳ ኡንትኮ፥ «ምስማረር ኤ ጫድንቴዝ ኤ ኩሻይድ የዝ ቤታ በኤካዛር የ ቤታ ታ ብራር ቦቼካዛር፥ ማ ታ ኩሻ ኤ ምያይድ ዳኪ በኤካዛር አማናሚ» ዬጌዛ።<verse eid="JHN 20:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26"/>ሳምንታፕ ጉየ፥ የሱሳ ታማርታይ ማካ ካራ ሺቂ በቴዛ፤ ቶማሳካ ኡንታር የዛ። እብ ጎርድንቲ የዝን የሱሳ ይኢ፥ ኡ ጋንጨ ኤቂ፥ «ሳሮ ይንትስ ማቆ» ዬጌዛ። <verse eid="JHN 20:26"/><verse number="27" style="v" sid="JHN 20:27"/>የይፕ ጉየ፥ የሱሳ ቶማሳኮ፥ «ታ ኩሻ ነ ብራር ቦቺ ቦኦባ። ማ ነ ኩሻ ታ ምያይድ ዳኪ ቦኦባ፤ ስፐ፥ አማኖባ» ዬጌዛ።<verse eid="JHN 20:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 20:28"/>ቶማሳ ማሂ፥ «ታ ጎዳዮ፥ ታ ጾሳዮ» ዬጌዛ።<verse eid="JHN 20:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 20:29"/>የዝን የሱሳ፥ «ኔኒ ታና በኤዝ ግሾስ አማኔዛ፥ ዝን ታና በኤካዛር አማኔዝታይ አንጅንቴዝታ» ዬጌዛ።<verse eid="JHN 20:29"/></para>
  <para style="s1">Ꮊ ማጻፋይ ቆፋ</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30"/>የሱሳ Ꮊ ማጻፋይ ጋንጨ ጻፍንቴዝ ባዝ ሀራ ጋመ ማልታ ፋ ታማርታይ ቲና ኦዛ። <verse eid="JHN 20:30"/><verse number="31" style="v" sid="JHN 20:31"/>ዝን የሱሳ ኤ ክርስቶሳ፥ ጾሳ ናአ ማቅዛና ይ አማኖድ ጋርክ አማኒ ኤ ሱንይር ደኦ ደማዳይ ጋርክ Ꮊይ ጻፍንቴዛ።<verse eid="JHN 20:31"/></para>
  <chapter eid="JHN 20"/>
  <chapter number="21" style="c" sid="JHN 21"/>
  <para style="s1">የሱሳ ላፑን ፋ ታማርታይስ በንቴዛ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1"/>የይፕ ጉየ፥ የሱሳ ጽባሮሳ አባ ካለ ፋ ታማርታይስ ማቂ በንቴዛ። ኤ ኡንትስ Ꮊይፕ ካሊ የዝ ሀኖር በንቴዛ። <verse eid="JHN 21:1"/><verse number="2" style="v" sid="JHN 21:2"/>ስሞን ጵጽሮሳ፥ ድድሞሳ ግንትንትዝ ቶማሳ፥ ቃና ጋልላፕ የኤዝ ናትናኤላ፥ ዛብዶሳ ናእታይኔ የሱሳ ታማርታይፕ ሀራ ናምእታይ ዎላ የዛ።<verse eid="JHN 21:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 21:3"/>ስሞን ጵጽሮሳ ኡንትኮ፥ «ታኒ ሞሎ አይኮዳይስ Ꮊንግዛ» ዬጌዛ።</para>
  <para style="p" vid="JHN 21:3">ኡንቲ፥ «ኑካ ኔር Ꮊማዳ» ዬጊ፥ ዎጎሎ ጋንጨ ገሌዛ። ዝን ኡንቲ የ ቃማ አባ ሞሎካ አይከካያ።<verse eid="JHN 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 21:4"/>ዎንታ ጉራ ጻልቀ ዶሎዳይፕ ቲና፥ የሱሳ አባ ጋጻ ኤቄዛ፥ ዝን ኤ ታማርታይ የሱሳ ማቄዛና ኤርበኤካያ። <verse eid="JHN 21:4"/><verse number="5" style="v" sid="JHN 21:5"/>የሱሳ ኡንትኮ፥ «ታ ላጊታዮ፥ ሞሎ አይከካሳ?» ዬጌዛ።</para>
  <para style="p" vid="JHN 21:5">ኡንቲ ማሂ፥ «አኮካ አይከካያ» ዬጌዛ።<verse eid="JHN 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 21:6"/>ኤ ማሂ፥ «ይ ግታ ዎጎላይፕ ኡሻች ባጋር ኦሎይታ፤ ይ ሞሎ አይኮዳ» ዬጌዛ። የይ ግሾስ፥ ኡንቲ ፋ ግታና ኡሻች ባጋር ኦሌዛ። ጋመ ሞሎ አይከዝ ግሾስ ጎቺ ከሶዳይስ ጋምንቴዛ።<verse eid="JHN 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 21:7"/>የሱሳ ቃዛ ታማራይ ጵጽሮሳኮ፥ «Ꮊይ ጎዳ ባይ!» ዬጌዛ። ስሞን ጵጽሮሳ ኤ ጌዛና ስኢ ካሎ የዝ ግሾስ ፋ አፍላ ማኢ አባ ግዶ ጉፒ ገሌዛ። <verse eid="JHN 21:7"/><verse number="8" style="v" sid="JHN 21:8"/>ዝን ዎጎሎ ግዶ አቴዝ Ꮊንኮ ታማርታይ ሞሎ ኩሜዝ ግታ ጎቺ፥ አባፕ ጋጻ ከዜዝ። ኡ አባፕ ናምኢ ጼት Ꮊ ጋርክ ሃክዛ ዝን። <verse eid="JHN 21:8"/><verse number="9" style="v" sid="JHN 21:9"/>ኡንቲ አባፕ ጋጻ ከዜዝ ዎደ ጺፈ ቃቃር ሞሎ የዛኔ ሶሎ በኤዛ።<verse eid="JHN 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 21:10"/>የሱሳ ኡንትኮ፥ «Ꮊት ይ አይኬዝ ሞላይፕ ጽቃ Ꮊና እንጎይታ» ዬጌዛ።<verse eid="JHN 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 21:11"/>ስሞን ጵጽሮሳ ዎጎልተ ገሊ፥ ጼት እሻታማኔ ሀይ ዳሞ ሞልታይ ኩሜዝ ግታ ጎቺ አባፕ ጋጻ ከሰዛ። ሞላይ የይ ጋርክ ጋመ ማቅኮኔ ግታይ ፌንተካያ።<verse eid="JHN 21:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 21:12"/>የሱሳ ኡንትኮ፥ «Ꮊና ይኢ ሞይታ» ዬጌዛ። ኤ ጎዳ ማቄዛና ኡንቲ ኤሬዝ ግሾስ ኤ ታማርታይፕ ፐታይካ፥ «ኔኒ ኦኖ?» ግ ኤዛ ኦይጮዳይስ ይባቴዛይ ባያ። ኤ ጎዳ ማቄዛና ኡቢታይ ኤሬዛ <verse eid="JHN 21:12"/><verse number="13" style="v" sid="JHN 21:13"/>የሱሳ ይኢ፥ ሶሎ ኤኪ ኡንትስ እንጌዛ፤ ሞላካ የይ ጋርክ እንጌዛ።<verse eid="JHN 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 21:14"/>የሱሳ Ꮊይቆፕ ደንዲ ፋ ታማርታይስ በንቶዳር Ꮊይ ሃይን።<verse eid="JHN 21:14"/></para>
  <para style="s1">የሱሳራኔ ጵጽሮሳራ</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15"/>ኡ ሜዛይፕ ጉየ፥ የሱሳ ስሞን ጵጽሮሳኮ፥ «ዮና ናአ ስሞና፥ ታና Ꮊይትታይፕ ኣ ቃኔ?» ዬጌዛ።</para>
  <para style="p" vid="JHN 21:15">ስሞን ጵጽሮሳ፥ «ኤ ጎዳዮ፥ ታኒ ነና ቃዛና ነ ኤርዛ» ዬጌዛ።</para>
  <para style="p" vid="JHN 21:15">የሱሳ ኤዝኮ፥ «ታ ዱር ናኡንን ሄንጎባ» ዬጌዛ።<verse eid="JHN 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 21:16"/>የሱሳ ናምአን፥ «ዮና ናአ ስሞና፥ ታና ቃኔ?» ዬጌዛ።</para>
  <para style="p" vid="JHN 21:16">ስሞን ጵጽሮሳ፥ «ኤ ጎዳዮ፥ ታኒ ነና ቃዛና ነ ኤርዛ» ዬጌዛ።</para>
  <para style="p" vid="JHN 21:16">የሱሳ፥ «ታ ሆግታ ሄንጎባ» ዬጌዛ።<verse eid="JHN 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 21:17"/>የሱሳ ሃይን፥ «ዮና ናአዮ ስሞና፥ ታና ቃኔ?» ዬጌዛ።</para>
  <para style="p" vid="JHN 21:17">የሱሳ ሃይን ስሞን ጵጽሮሳኮ፥ «ታና ቃኔ?» ዬጊ ኦይጬዝ ግሾስ ጵጽሮሳ አዛኒ፥ «ጎዳዮ፥ ኔኒ ኡባ ባዝ ኤርዛ፤ ታኒ ነና ቃዛና ነ ኤርዛ» ዬጌዛ።</para>
  <para style="p" vid="JHN 21:17">የሱሳ፥ «ታ ዱርታ ሄንጎባ። <verse eid="JHN 21:17"/><verse number="18" style="v" sid="JHN 21:18"/>ታኒ ኔስ ቱሮ ኦድዛ፤ ኔኒ ናአትር የዝ ዎደ ነ ኣዳስ ዳንጭንቲ፥ ነ ኮዤዝ በስ Ꮊንግዛ። ዝን ነ ጭሜዝ ዎደ ነ ኩሻ ምጪ ቤዞዳ። ሀራይ ዳንጭሶዳ፤ ነ አቆ በስ ካንጎዳ» ዬጌዛ። <verse eid="JHN 21:18"/><verse number="19" style="v" sid="JHN 21:19"/>የሱሳ የያ ጵጽሮሳ አብ ጋርክ Ꮊይቆ Ꮊይቂ፥ ጾሳ ቦንችሶዳዝኮ ኤርሶዳይስ ጌዛ። የያ ጌዛይፕ ጉየ፥ የሱሳ ጵጽሮሳኮ፥ «ታና ካሎባ» ዬጌዛ።<verse eid="JHN 21:19"/></para>
  <para style="s1">የሱሳራኔ Ꮊንኮ ታማራ</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20"/>ጵጽሮሳ ጉየ ማቂ፥ የሱሳ ቃዛ ታማራይ ፋፕ ጉየር ይእዛና በኤዛ። የ ታማራይ፥ ካሆ ሚዝ አቆ የሱሳኮ ሺቂ፥ «ጎዳዮ፥ ነና ኣ እማዳይ ኦኖ?» ጌዛና። <verse eid="JHN 21:20"/><verse number="21" style="v" sid="JHN 21:21"/>ጵጽሮሳ የ ታማራ ብኢ፥ «ጎዳዮ፥ Ꮊ አይ ማ ዋያዴ?» ዬጊ የሱሳ ኦይጬዛ።<verse eid="JHN 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 21:22"/>የሱሳ ኤዝኮ፥ «ታኒ የኦዳ ሄሎዳይስ ኤ ሸምፖር የዞድ ጋርክ ታኒ ኮይኮ፥ የይ ነና አብ መተኔ? ኔኒ ታና ካሎባ» ዬጌዛ።<verse eid="JHN 21:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 21:23"/>የይ ግሾስ፥ የ ታማራይ Ꮊይቃም ግዝ ኦዳይ ኤ እሽታ ኡብታ ሄሌዛ። ዝን የሱሳ፥ «ታኒ የኦድ ጋ፥ ኤ የዞድ ጋርክ ታኒ ኮይኮ ነና አብ መተኔ?» የጌዛይፕ አትን «Ꮊይቀና» ጌካያ።<verse eid="JHN 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 21:24"/>Ꮊ ኦዳይ ባጋ ማርካተዛይነ Ꮊያ ጻፌዛይ የ ታማራ። ኤ ማርካትይ ቱማ ማቅዛና ኑኒ ኤርዛ።<verse eid="JHN 21:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25"/>የሱሳ ኦዝ ሀራ ጋመ ባዝ የዛ። ታ ቆፕን፥ ኡባ ባዝ ኦማር ኦማር ጻፍንቴዛኮ፥ ጻፍንትዛ ማጻፍታይስ ኩን አላማይ ግዶድባዝ ኣዞያ።<verse eid="JHN 21:25"/></para>
  <chapter eid="JHN 21"/>
</usx>
