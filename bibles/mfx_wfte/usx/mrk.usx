<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MRK" style="id">- Melo New Testament Ethiopic</book>
  <para style="h">ማርቆሳ</para>
  <para style="toc1">ማርቆሳ ጻፌዝ የሱስ ክርስቶሳ ዎንግለ</para>
  <para style="toc2">ማርቆሳ</para>
  <para style="toc3">ማር.</para>
  <para style="mt1">ማርቆሳ ጻፌዝ የሱስ ክርስቶሳ ዎንግለ</para>
  <para style="imt">ገሎ</para>
  <para style="ip">ማርቆሳ ዎንግላይ፥ «Ꮊይ ጾስ ናአ የሱስ ክርስቶሳ ዎንግለ አይ» ጊታር ደንድዛ። Ꮊ ዎንግላይድ የሱሳ ኦሶ አስኔ ማዉተር የዝ አስ ማቂ ሺቄዛ። ኤ ማዉታይ ኤ ትምርታይር፥ ኢታ አያናል አፋ የዝ ዎልቃይራኔ አሲ ኦዝ ናጋራ ማሮር በንቴዛ። የሱሳ፥ «ታኒ፥ አሲ ኦዝ ናጋራ አይለትፕ ዋሎ ከሶዳይስኔ ታ ሸምፖ ኣ እማዳይስ የኤዝ አስ ናአ» ዬጊ ፋ ዶናር ኦዴዛ።</para>
  <para style="ip">ማርቆሳ የሱሳ ታርካ ሉሎ ኦገራኔ ዎልቃ ኩሜዝ ኦገር ኦዴዛ። ማርቆሳ ኦድዛይ የሱሳ ቃላኔ ትምርተ ኣዳ ባዝን ኦዝ ማላባዝታ ባይራ ኦድዛ። ማርቆሳ ጻማቅዛ ዋንሳ ታርካ፥ የሱሳ ጽንቃታኔ ኤ ፓጭንታ ሃታር ኦዲ ማቂ፥ የሱሳ ትምርታኔ ኤ ፓዛና ፓድዛ። አቅ አቅ Ꮊማዳር የሱሳ ታማርታይ የሱሳና ኡሳ ኤርታር Ꮊንጌዛይ ጋርክ የሱሳ እጽዝታይካ ኡሳ እጽታር Ꮊንጌዛ። ዉርስ ሸምፕታይ የሱሳ ፓ የዝን ዉርስ ሳምንታ ፖልንቴዝ ኦስታይ ባዝ ኦድዛ። የይትታይካ ኤ ሶጽንታኔ ኤ ደንዶ ባጋ ኦድዛ።</para>
  <para style="iot">ማርቆሳ ዎንግላይ አይኬዝ ቆፍታ</para>
  <para style="io1">Ꮊ ዎንግላይ አይ <char style="ior"><ref loc="MRK 1:1-13">1:1-13</ref> </char></para>
  <para style="io1">የሱሳ ጋልላ ቢታ ፋ ኦሳ አይኬዛ <char style="ior"><ref loc="MRK 1:14-9:50">1:14—9:50</ref> </char></para>
  <para style="io1">የሱሳ የሩሳላመ ቢታ ኦዝ ኦሶ <char style="ior"><ref loc="MRK 10:1-52">10:1-52</ref> </char></para>
  <para style="io1">ዉርስ ሳምንታ የሩሳላመ ሄራ <char style="ior"><ref loc="MRK 11:1-15:47">11:1—15:47</ref> </char></para>
  <para style="io1">የሱሳ Ꮊይቆፕ ደንዶ <char style="ior"><ref loc="MRK 16:1-8">16:1-8</ref> </char></para>
  <para style="io1">Ꮊይቆፕ ደንዴዝ ጎዳይ በንትኔ ደንዲ ሳሎ ቅቶ <char style="ior"><ref loc="MRK 16:9-20">16:9-20</ref> </char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="MRK 1"/>
  <para style="s1">ጻማቅዛ ዋንሳ ሳባኮ</para>
  <para style="r">(<ref loc="MAT 3:1-12">ማቶ. 3:1-12</ref>፤ <ref loc="LUK 3:1-18">ሉቃ. 3:1-18</ref>፤ <ref loc="JHN 1:19-28">ዋን. 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1"/>Ꮊይ ጾስ ናአ የሱስ ክርስቶሳ ዎንግለ አይ <verse eid="MRK 1:1"/><verse number="2" style="v" sid="MRK 1:2"/>ናበ ኢሳያሳ ጻፌዝ ማጻፋይ ጋንጨ ጾሳይ፥</para>
  <para style="q1" vid="MRK 1:2">«ዬዛኮ፥ ታኒ ታ ኪታ ናአ</para>
  <para style="q2" vid="MRK 1:2">ኔፕ ቲና ዳኮዳ።</para>
  <para style="q1" vid="MRK 1:2">ኤ ነ ኦጋ ፕጾዳ።<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="MAL 3:1">ሚል. 3:1</ref></char></note><verse eid="MRK 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3"/>ፐታይ ሊዦ ጋር ኡኪ ኦድታር፥</para>
  <para style="q2" vid="MRK 1:3">‹ጎዳይስ ኦገ ፕጾይታ፤</para>
  <para style="q1" vid="MRK 1:3">ኤ የዳይስ ጎሰ</para>
  <para style="q2" vid="MRK 1:3">ኤዝስ ሉልሶይታ ጌዛ»</para>
  <para style="m" vid="MRK 1:3">ጊንቲ ጻፍንቴዛ።<note caller="-" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="ISA 40:3">ኢሳ. 40:3</ref></char></note><verse eid="MRK 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4"/>ጻማቅዛ ዋንሳ አሳ ጻማቅታር፥ «ይ ናጋራይፕ ማቂ ጻማቅንቶይታ፤ ጾሳይ ይ ናጋራ ይንትስ አቶ ጎዳ» ዬጊ ቃላ ኦድታር ሊዦ ጋፕ የኤዛ። <verse eid="MRK 1:4"/><verse number="5" style="v" sid="MRK 1:5"/>ይሁዳ ቢታ የዝ አስ ኡቢታይኔ የሩሳላመ ካታማ አስ ኡቢታይ ዋንሳኮ ይእዛ። ፋ ናጋራ ቡጽን፥ ዋንሳ ኡንታን ዮርዳኖሳ ቦርካ ጻማቅዛ።<verse eid="MRK 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 1:6"/>ዋንሳ ግማለ እክሰፕ ዳድንቴዝ አፍላ ማእዛ። ፋ ጼሳይድ ዳፈ ዳንጭዛ፤ ማ ቦለራኔ ደገራ ኤሳራ ሚዛ።<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="2KI 1:8">2ካት. 1:8</ref></char></note> <verse eid="MRK 1:6"/><verse number="7" style="v" sid="MRK 1:7"/>ዋንሳ ቃላ ኦድታር፥ «ታፕ ጉየር ሎእ ሚንግዛይ ይእዛ። ሀራ አቶዝን፥ ታ ኤ ጫማ ዎዶራ ዙጊ ብሎዳይስ ቤዞያ። <verse eid="MRK 1:7"/><verse number="8" style="v" sid="MRK 1:8"/>ታ ይንታን ሃር ጻማቅዛ፥ ዝን ኤ ይንታን ጌሻ አያናር ጻማቆዳ» ዬጌዛ።<verse eid="MRK 1:8"/></para>
  <para style="s1">የሱሳ ጻማቅንቶኔ ፓጭንቶ</para>
  <para style="r">(<ref loc="MAT 3:13-17">ማቶ. 3:13-17</ref>፤ <ref loc="MAT 4:1-11">4:1-11</ref>፤ <ref loc="LUK 3:21-22">ሉቃ. 3:21-22</ref>፤ <ref loc="LUK 4:1-13">4:1-13</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9"/>የሱሳ የ ዎደ ጋልላ ቢታ የዝ ናዝረተ ካታማፕ ይእን፥ ዋንሳ ዮርዳኖሳ ቦርካ ኤዛ ጻማቄዛ። <verse eid="MRK 1:9"/><verse number="10" style="v" sid="MRK 1:10"/>የሱሳ ሃፕ ከዜዛን ጋርክ ሳሎ ዶይንትን፥ ጌሻ አያናይ ኤዛል አፋ ሆለ ጋርክ ዎዳር በኤዛ። <verse eid="MRK 1:10"/><verse number="11" style="v" sid="MRK 1:11"/>ማካ፥ «ታ ቃዛ ታ ናአይ ነና፤ ታ ኔል ኡፋይትዛ» ዬግዝ ግር ሳሎፕ የኤዛ።<note caller="-" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="GEN 22:2">መ. 22:2</ref>፤ <ref loc="PSA 2:7">ማዝ. 2:7</ref>፤ <ref loc="ISA 42:1">ኢሳ. 42:1</ref>፤ <ref loc="MAT 3:17">ማቶ. 3:17</ref>፤ <ref loc="MAT 12:18">12:18</ref>፤ <ref loc="MRK 9:7">ማር. 9:7</ref>፤ <ref loc="LUK 3:22">ሉቃ. 3:22</ref></char></note><verse eid="MRK 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12"/>እዝር ጌሻ አያናይ የሱሳ ሊዦ ጋ ካንጌዛ። <verse eid="MRK 1:12"/><verse number="13" style="v" sid="MRK 1:13"/>የሱሳ ሊዦ ጋ ጻላሄር ፓጭንትታር ኦይታም ጋላስ ጋምኤዛ። ዶእታይር የዜዛ፥ ዝን ኪታንችታይ ይኢ ኤዛ ማዴዛ።<verse eid="MRK 1:13"/></para>
  <para style="s1">የሱሳ ሞሎ አይክዝ ኦይዲ አስታና ጼጌዛ</para>
  <para style="r">(<ref loc="MAT 4:12-22">ማቶ. 4:12-22</ref>፤ <ref loc="LUK 4:14-15">ሉቃ. 4:14-15</ref>፤ <ref loc="LUK 5:1-11">5:1-11</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14"/>ዋንሳ አጭንቴዛይፕ ጉየ የሱሳ ጾስ ካተት ዎንግለ ኦድታር ጋልላ ቢታ Ꮊንጌዛ። <verse eid="MRK 1:14"/><verse number="15" style="v" sid="MRK 1:15"/>«ላይይ ሄሌዛ፤ ጾስ ካተትይ ኡኬዛ። ይ ናጋራይፕ ማቂ፥ ዎንግላ አማኖይታ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="MAT 3:2">ማቶ. 3:2</ref></char></note><verse eid="MRK 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16"/>የሱሳ ጋልላ አባ ላንቀር ኣታር፥ ሞሎ አይክዝ፥ ስሞናራኔ ኤ እሻ እንድራሰራ፥ ፋ ግተ አባል አፋ ኦልዝታ በኤዛ። <verse eid="MRK 1:16"/><verse number="17" style="v" sid="MRK 1:17"/>ኡንትኮ፥ «ታና ካሎይታ፤ ታ ይንታን አስ አይክ ታማርሶዳ» ዬጌዛ። <verse eid="MRK 1:17"/><verse number="18" style="v" sid="MRK 1:18"/>ኡንትካ እዝር ፋ ግትታ ኦሊ አሺ የሱሳና ካሎ አይኬዛ።<verse eid="MRK 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19"/>እዝፕ ጽቃል ቲን Ꮊንጊ፥ ናምኢ እሽታ ዛብዶሳ ናእታ፥ ያይቆባራኔ ዋንሳራ ዎጎሎ ጋንጨ ፋ ግተ ሎእዝታ በኤዛ። <verse eid="MRK 1:19"/><verse number="20" style="v" sid="MRK 1:20"/>የሱሳ ኤልሲ ኡንታን ጼጌዛ። ኡንትካ ፋ ኣዳ ዛብዶሳ፥ ኤ ኦሶ አስታይር ዎጎሎ ጋንጨ ኦሊ አሺ ኤዛ ካሊ Ꮊንጌዛ።<verse eid="MRK 1:20"/></para>
  <para style="s1">ቱና አያና አይኬዝ አይ ፓጼዛ</para>
  <para style="r">(<ref loc="LUK 4:31-37">ሉቃ. 4:31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21"/>ኡንቲ ቅፍርናሆመ ካታማ ገሌዛ። ማላ ጋላስ ሄሌዛን ጋርክ የሱሳ ኤልሲ አይሁደ ዎሳ ኬ ገሊ ታማርሶ አይኬዛ። <verse eid="MRK 1:21"/><verse number="22" style="v" sid="MRK 1:22"/>ማዉተር የዝ አስ ጋርክ ታማርስዛፕ አትን ሀገ አስታማርታይ ጋርክ ታማርሶዋ ግሾስ አሳይ ኤ ትምርታ Ꮊይ ማላባዝ ጌዛ።<note caller="-" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="MAT 7:28">ማቶ. 7:28</ref></char></note><verse eid="MRK 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23"/>የ ዎደ ቱና አያና አይኬዝ ፐቲ አይ አይሁድታይ ዎሳ ኬ ገሊ ኡኪ፥ <verse eid="MRK 1:23"/><verse number="24" style="v" sid="MRK 1:24"/>«ናዝረተ የሱሳ፥ ኔራኔ ኑር አባ አላለ የኔ? ኑና ብሶዳይስ የኤኔ? ነ ኦኖዛኮ ታ ኤርዛ፤ ነ ጾሳ ጌሻ» ዬጌዛ።<verse eid="MRK 1:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25"/>የሱሳ ያ ቱና አያና፥ «ሀይዞባ፥ Ꮊ አይፕ ከዞባ» ዬጊ አዛዜዛ።<verse eid="MRK 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 1:26"/>ቱና አያናይ አ ዛርድዛርድ ኡዲ፥ ጽላሲ ኡኪ ኤዛፕ ከዜዝ። <verse eid="MRK 1:26"/><verse number="27" style="v" sid="MRK 1:27"/>አሳይ ኡባይ ማላባዝ ግ፥ «Ꮊይ አባ? Ꮊ አይ ፋ ማዉተር ሀራ አቶዝን ቱና አያንታካ አዛዝዛ። ኡንትካ ኤስ አዛዝንትዛ፤ Ꮊይ አባ ኦሮ ትምርተ?» ዬጊ፥ ፋ ጋንጨር ፐታይ ፐታይ ዎል ኦይች አይኬዛ።<verse eid="MRK 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 1:28"/>የሱሳ ዋራይ ኤልሲ ጋልላ አዉራጃ የዝ ሄራ ኡባ ከዜዝ።<verse eid="MRK 1:28"/></para>
  <para style="s1">የሱሳ ጋመ ሀርጋንችታ ፓዛ</para>
  <para style="r">(<ref loc="MAT 8:14-17">ማቶ. 8:14-17</ref>፤ <ref loc="LUK 4:38-41">ሉቃ. 4:38-41</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29"/>የሱሳ የ ዎደ አይሁድታይ ዎሳ ኬፕ ከዚ፥ ያይቆባራ ዋንሳራ ስሞና ካራኔ እንድራሰ ካራ ገሌዛ። <verse eid="MRK 1:29"/><verse number="30" style="v" sid="MRK 1:30"/>ስሞና ማቻቲ እንዳት ኦጸ ምሻ ሀርገር ዎይኢ የዝን የሱሳ እዘ ሄልን ኤዝስ ኦዴዛ። <verse eid="MRK 1:30"/><verse number="31" style="v" sid="MRK 1:31"/>ኤ እዝኮ ሺቂ፥ እ ኩሻ አይኪ፥ እዞ ደን ኤሴዛ። ኦጸ ምሻ ሀርጋይ ኤልሲ እዞ ዳክን እዛ ኡንታን ሞኬዛ።<verse eid="MRK 1:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32"/>ሀርግንቴዝ አሳ ኡብታኔ ቱና አያንታይ አይኬዝ አሳ ኡባ ኦማ አዋ ገሊ ለምእለምኦዳር ኤዝኮ ከኤዛ። <verse eid="MRK 1:32"/><verse number="33" style="v" sid="MRK 1:33"/>ካታማ የዝ አስ ኡባይ ይኢ ኬይስ ባለ ሺቄዛ። <verse eid="MRK 1:33"/><verse number="34" style="v" sid="MRK 1:34"/>የሱሳ ዱማ ዱማ ሀርገር አይክንቴዝ ጋመ አስታ ፓ፥ ጋመ ቱና አያንታ ከሴዛ። ኤ ኦኖዛኮ ቱና አያንታይ ኤሬዛ። ዝን የሱሳ ኡንታን ናሾዳ ካዬዛ።<verse eid="MRK 1:34"/></para>
  <para style="s1">የሱሳ ጋልላ ቢታ ታማርሴዛ</para>
  <para style="r">(<ref loc="LUK 4:42-44">ሉቃ. 4:42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35"/>የሱሳ ዣባሮ ደንዲ፥ አሲ ባ አቆ ዎሶዳይስ Ꮊንጌዛ። <verse eid="MRK 1:35"/><verse number="36" style="v" sid="MRK 1:36"/>ስሞናራኔ ኤዛር የዝታይ ኤዛ ኮይታር Ꮊንጌዛ። <verse eid="MRK 1:36"/><verse number="37" style="v" sid="MRK 1:37"/>ኡንቲ ኤዛ ደንጊ፥ «አሳይ ኡቢታይ ነና ኮይዛ» ዬጌዛ።<verse eid="MRK 1:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38"/>የሱሳ ማ ኡንታን፥ «ሀራ አቆ ኡከ ሄርታ የይታ። ታ የኤዛይ ዎንግለ ኦዶዳይስ ማቄዝ ግሾስ ኤዛይዳካ ቃላ ኦዶዳይስ ቤዝዛ» ዬጌዛ። <verse eid="MRK 1:38"/><verse number="39" style="v" sid="MRK 1:39"/>አይሁድታይ ዎሳ ኬታይድ ቃላ ኦድታር፥ ቱና አያንታ ከስታር፥ ጋልላ ቢታ ኡባ ዉቴዛ።<note caller="-" style="x"><char style="xo" closed="false">1:39 </char><char style="xt" closed="false"><ref loc="MAT 4:23">ማቶ. 4:23</ref>፤ <ref loc="MAT 9:35">9:35</ref></char></note><verse eid="MRK 1:39"/></para>
  <para style="s1">የሱሳ ቦርቆንቶ ሀርገር የዝ አ ፓዛ</para>
  <para style="r">(<ref loc="MAT 8:1-4">ማቶ. 8:1-4</ref>፤ <ref loc="LUK 5:12-17">ሉቃ. 5:12-17</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40"/>ቦርቆንቶ ሀርገ አይኬዝ ፐቲ አይ የሱሳኮ ይኢ፥ ኤ ቲናይድ ጹጉኒ፥ «ነ ቃኮ ታና ጌሾዳይስ ዳንዳእዛ» ዬጊ ዎሴዛ።<verse eid="MRK 1:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41"/>የሱሳ ኤዝስ ቃንቲ፥ ፋ ኩሻ ዳኪ ኤዛ ቦቺ፥ «ታ ኮይዛ፥ ጌዦባ» ዬጌዛ። <verse eid="MRK 1:41"/><verse number="42" style="v" sid="MRK 1:42"/>እዝር ቦርቆንታይ አ ዳክን አይ ኤልሲ ጌዤዛ። <verse eid="MRK 1:42"/><verse number="43" style="v" sid="MRK 1:43"/>የሱሳ አይኮ ሚን ናግንቶባ ግ ሞይዜዛ። <verse eid="MRK 1:43"/><verse number="44" style="v" sid="MRK 1:44"/>የሱሳ ኤዛ፥ «ነና ኤሮባ፥ Ꮊኖ ኦስካ ኦድፐ። ዝን Ꮊንጊ ነ ጋላ ቄሰ ቤዞባ። ነ Ꮊት ጌሻ ማቄዛና አሳ ኤርሶዳይስ፥ ሙሰ ኪቴዝ ያርሾ ያርሾባ» ዬጊ ኪቴዛ።<note caller="-" style="x"><char style="xo" closed="false">1:44 </char><char style="xt" closed="false"><ref loc="LEV 14:1">ለዊ. 14:1</ref></char></note><verse eid="MRK 1:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45"/>ዝን አይ Ꮊንጊ፥ ሄራ ኡባይድ አስስ ኦዴዛ። የይ ግሾስ፥ የሱሳ ቆንጨር፥ ካታማ ገሎዳይስ ዳንዳኤካያ። ዝን አሲ ባ አቆ ጋጻ የዜዛ፤ ማ አሲ ኡባ አቆፕ ኤዝኮ ይእዛ።<verse eid="MRK 1:45"/></para>
  <chapter eid="MRK 1"/>
  <chapter number="2" style="c" sid="MRK 2"/>
  <para style="s1">የሱሳ ስላ አ ፓዛ</para>
  <para style="r">(<ref loc="MAT 9:1-8">ማቶ. 9:1-8</ref>፤ <ref loc="LUK 5:17-26">ሉቃ. 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1"/>ጽቃ ጋላሳፕ ጉየ የሱሳ ቅፍርናሆመ ማቂ፥ ካራ የዛ ግዝ ዎረ ስንቴዛ። <verse eid="MRK 2:1"/><verse number="2" style="v" sid="MRK 2:2"/>ሺቄዝ አሳ ኬይ ኤካም እጽን ሀራ አቶዝን ባላይካ ኡንኦድ ጋ ጋመ አስ ሺቅን፥ የሱሳ ቃላ ታማርሴዛ። <verse eid="MRK 2:2"/><verse number="3" style="v" sid="MRK 2:3"/>ኦይዲ አስታይ ፐቲ ስላ አ ቶኪ ኤዝኮ ከኤዛ። <verse eid="MRK 2:3"/><verse number="4" style="v" sid="MRK 2:4"/>አሳይ ጋንጌዝ ግሾስ አ የሱሳኮ ሺሾዳይስ ኡንትስ ዳንዳእንታም እጽን፥ የሱሳ የዛ ባጋይር ኬ ቃሪ፥ ሲትንጋ ቃዉጺ አ ኤ ዎይኤዝ አርሳትራ ሱለ ዳኪ የሱሳ ቲናይድ ዎዛ። <verse eid="MRK 2:4"/><verse number="5" style="v" sid="MRK 2:5"/>የሱሳ ኡ አማና ብኢ፥ ያ ስላ አ፥ «ታ ናአዮ፥ ነ ናጋራይ አቶ ግንቴዛ» ዬጌዛ።<verse eid="MRK 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6"/>ህገ አስታማርታይፕ የ አቃይድ በንቴዝ ፐቲ ፐቲ አስታይ ፋ ዎዝናይር፥ <verse eid="MRK 2:6"/><verse number="7" style="v" sid="MRK 2:7"/>«Ꮊ አይ Ꮊይ ጋርክ ኢታ ባዝ ጾሳል አፋ አብስ ኦድንቴ? ጾስ ኣዳፕ አትን ሀራ ኦ ናጋራ አቶ ጎዳይስ ዳንዳኤ?» ዬጊ ቆፔዛ።<verse eid="MRK 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8"/>ኡ ፋ ዎዝናይድ የይ ጋርክ ቆፔዛና የሱሳ ኤልሲ ፋ አያናር ኤሪ፥ ኡንትኮ፥ «ይንቲ ይ ዎዝናይር አብስ Ꮊይ ጋርክ ቆፔ? <verse eid="MRK 2:8"/><verse number="9" style="v" sid="MRK 2:9"/>ስላ አ፥ ‹ነ ናጋራይ አቶ ግንቴዛ› ግዛይ ሻዉክነኔ? ዎይ፥ ‹ደንዲ ኤቂ ነ አርሳ ቶኪ ቅቶባ› ግዛይ ሻዉከ? <verse eid="MRK 2:9"/><verse number="10" style="v" sid="MRK 2:10"/>ዝን ታስ፥ አስ ናአይስ፥ ሳአል አፋ የሳይ ናጋራ አቶ ጎዳይስ ዎልቃ የዛና ይ ኤሮድ ጋርክ» ዬጊ የ ስላ አይኮ፥ <verse eid="MRK 2:10"/><verse number="11" style="v" sid="MRK 2:11"/>«ታ ኔኮ Ꮊት ኦድዛ፥ ደንዲ ነ አርሳ ቶኪ ነ ካራ ቅቶባ» ዬጌዛ።<verse eid="MRK 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 2:12"/>አይ ኤል ደንዲ፥ ፋ አርሳ ቶኪ አስ ኡባይ ቲና ከዜዝ። አሳይ ኡባይ ማላባዝ ግ፥ «ኑኒ Ꮊይ ጋርክ ባዝ የሻ ብኢ ኤሮያ» ዬጊ ጾሳ ጋላቴዛ።<verse eid="MRK 2:12"/></para>
  <para style="s1">የሱሳ ለዋና ጼጌዛ</para>
  <para style="r">(<ref loc="MAT 9:9-13">ማቶ. 9:9-13</ref>፤ <ref loc="LUK 5:27-32">ሉቃ. 5:27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13"/>የሱሳ ማካ ጋልላ አባ ላንቀ Ꮊንጊ፥ ኤዝኮ የኤዝ አስ ኡብታ ታማርሴዛ። <verse eid="MRK 2:13"/><verse number="14" style="v" sid="MRK 2:14"/>ኤዛይር ኣዳር፥ ኢልፎሳ ናአ ለወ ግንትንትዛይ ቃራጸ ጋችስዛ አቆ በቴዝን ብኢ፥ «ታና ካሎባ» ዬጌዛ። ለዋይ ደንዲ ኤዛ ካሌዛ።<verse eid="MRK 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15"/>የሱሳ ካ ማዳይስ ለዋይ ካራ በቴዛ። ኤዛ ካልዛ አሳይ ጋመ ማቄዝ ግሾስ ቃራጸ ጋችስዛ ጋመ አሳይኔ ናጋራ ኦዛ አሳይ ኤዛራኔ ኤ ታማርታይር ዎላ በቴዛ። <verse eid="MRK 2:15"/><verse number="16" style="v" sid="MRK 2:16"/>ህገ አስታማረ ማቄዝ ፐቲ ፐቲ ፈርሳወ አሳይ የሱሳ ናጋራ ኦዝ አሳይራኔ ቃራጸ ጋችስዝታይር ካ ማዳር ብኢ፥ «ኤ አብስ ናጋራ ኦዝ አሳይራኔ ቃራጸ ጋችስዝታይር ካ ሜ?» ዬጊ፥ ኤ ታማርታይር ዎል ኦይጬዛ።<verse eid="MRK 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17"/>የሱሳ ኡ ግዛና ስኢ፥ «አክመ ሀርግንትዝታይሳፕ አትን ፓ አስስ ኮሾያ። ታኒ ናጋራ ኦዝታ ጼጎዳይስ የኤዛፕ አትን ጽልታ ጼጎዳይስ የኤካያ» ዬጊ ኡንትስ ማሄዛ።<verse eid="MRK 2:17"/></para>
  <para style="s1">ጾማ ባጋ ኤሮዳይስ ሺቄዝ ኦይች</para>
  <para style="r">(<ref loc="MAT 9:14-17">ማቶ. 9:14-17</ref>፤ <ref loc="LUK 5:33-39">ሉቃ. 5:33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18"/>ጻማቅዛ ዋንሳ ታማርታይኔ ፈርሳውታይ ጾምዛዝን፥ ፐቲ ፐቲ አሳይ የሱሳኮ ይኢ፥ «ዋንሳ ታማርታይኔ ፈርሳውታይ ታማርታይ ጾምዛ፥ ዝን ነ ታማርታይ አብስ ጾሞሳ?» ዬጌዛ።<verse eid="MRK 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19"/>የሱሳ ኡንትኮ፥ «ማቾ ኤክዛይ ኡንታር የዝን ላዛንታይ፥ ጾሞዳይስ ዳንዳእኔ? ማቾ ኤክዝ አይ ኡንታር የዝን፥ ጾሞዳይስ ዳንዳኦያ። <verse eid="MRK 2:19"/><verse number="20" style="v" sid="MRK 2:20"/>ዝን ማቾ ኤክዛ አይ ኡ ካለፕ ኤክንትዛ ቃማ የኦዳ፥ ኡ ያ ጋላስ ጾሞዳ።<verse eid="MRK 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21"/>«ጭማ አፍላል አፋ ኦሮ እራፈ ጋዲ ስክዛ አሲ ባያ። ጋዲ ስክኮ፥ ኦሮይ ጭማ አፍላና ፐርእዛ፤ ፐርእይካ ቲናሳይፕ ዳልግዛ። <verse eid="MRK 2:21"/><verse number="22" style="v" sid="MRK 2:22"/>ማ ማልአንቶ ዎይነ ጭማ ኦጎሮ ጋንጨ ቡልዝ አሲ ባያ። ቡልዝ ማቅኮ፥ የ ዎይናይ ኦጎራና ስዛ፥ ፋ ኡባስካ ላልንትዛ፥ ኦጎራይካ ኢትዛ። ዝን ማልአንቶ ዎይነ ኦሮ ኦጎሮ ጋንጨ ቡልንትዛ» ዬጌዛ።<verse eid="MRK 2:22"/></para>
  <para style="s1">ማላ ኤሮዳይስ ሺቄዝ ኦይች</para>
  <para style="r">(<ref loc="MAT 12:1-8">ማቶ. 12:1-8</ref>፤ <ref loc="LUK 6:1-5">ሉቃ. 6:1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23"/>የሱሳ ፐቲ ማላ ጋላስ ባንጋ ጋደ ጋንጨር ኣዳር፥ ኤ ታማርታይ ኤዛር ዎላ Ꮊንግታር ባንጋ ትዣ ምርኪ ሙስ አይኬዛ። <verse eid="MRK 2:23"/><verse number="24" style="v" sid="MRK 2:24"/>ፈርሳወ አሳይ የሱሳኮ፥ «የዝን፥ ነ ታማርታይ ማላ ጋላስ ዎጋ ባባዝ አብስ ኦ?» ዬጌዛ።<verse eid="MRK 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25"/>የሱሳ ኡንትኮ፥ «ዳዉተ ናይንቲ፥ ሚዝ ባዝ ኮዤዝ ዎደ ፓር የዝታይር ኦዛና ይ ናባበካሳ?<note caller="-" style="x"><char style="xo" closed="false">2:25-26 </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">1ሳም. 21:1-6</ref></char></note> <verse eid="MRK 2:25"/><verse number="26" style="v" sid="MRK 2:26"/>አብያታራ ቄሰ ሀላቃ ማቂ የዛ ዎደ ዳዉተ ጾሳ ኬ ገሊ፥ ቄስታይ ኣዳ ማዳይስ በዝዛፕ አትን ኦንካ ማዳይስ ዎጋ ባባዝ ጎዳይ ቲና ጋዴዝ ያርሾ ሶሎ ሜዛ፥ ፓር የዝታይስካ እንጌዛ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">2:26 </char><char style="xt" closed="false"><ref loc="LEV 24:9">ለዊ. 24:9</ref></char></note><verse eid="MRK 2:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27"/>ማካ የሱሳ ኡንትኮ፥ «ማላይ አስስ መንቴዛፕ አትን አሲ ማላስ መንተካያ። <verse eid="MRK 2:27"/><verse number="28" style="v" sid="MRK 2:28"/>የይ ግሾስ፥ አስ ናአይ፥ ሀራ አቶዝን ማላስካ ጎዳ» ዬጌዛ።<verse eid="MRK 2:28"/></para>
  <chapter eid="MRK 2"/>
  <chapter number="3" style="c" sid="MRK 3"/>
  <para style="s1">የሱሳ ኩሸ ስላ አ ፓዛ</para>
  <para style="r">(<ref loc="MAT 12:9-14">ማቶ. 12:9-14</ref>፤ <ref loc="LUK 6:6-11">ሉቃ. 6:6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1"/>የሱሳ አይሁድታይ ዎሳ ኬ ማቂ ገሌዛ። ኤዛይዳ ኩሸ ስሌዝ ፐቲ አይ የዛ። <verse eid="MRK 3:1"/><verse number="2" style="v" sid="MRK 3:2"/>ፐቲ ፐቲ አሳይ የሱሳ ሞቶዳይስ ኮዪ፥ ኩሸ ስሌዝ አ ማላ ጋላስ ኤ ፓዳዛኮኔ አሾዳዛኮ በአዳይስ ኮዪ ሚንጊ ናግዛ። <verse eid="MRK 3:2"/><verse number="3" style="v" sid="MRK 3:3"/>የሱሳ ኩሸ ስሌዝ አ፥ «ደንዲ Ꮊና ይኢ ኑ ጋንጨ ኤቆባ» ዬጌዛ። <verse eid="MRK 3:3"/><verse number="4" style="v" sid="MRK 3:4"/>የይፕ ጉየ፥ አስታይኮ፥ «ማላ ጋላስ ሎኦ ባዝ ኦዛይ ዎጋኔ ኢታ ባዝ ኦዛይ ዎጋ? አስ ሸምፖ አሾኔ ዎ?» ዬጊ ኦይጬዛ።</para>
  <para style="p" vid="MRK 3:4">ዝን አሳይ ስኤ ጌዛ። <verse eid="MRK 3:4"/><verse number="5" style="v" sid="MRK 3:5"/>የሱሳ ሸንቲ ኡንታን ፋ ካላይር የዝታ ዳኪ ብኢ፥ ኡ ዎዝና ዶጬዝታ ማቄዝ ግሾስ ኡንታን ካጬዛ። ያ አይኮ፥ «ነ ኩሻ ፕድ ኡዶባ» ዬጌዛ። አይ ፕድ ኡድን ኤ ኩሽታይ ፓጼዛ። <verse eid="MRK 3:5"/><verse number="6" style="v" sid="MRK 3:6"/>ኤልሲ ፈርሳዋይ አይሁድታይ ዎሳ ኬፕ ባለ ከዚ፥ የሱሳና ዋይዚ ዎዳዛኮ ቶቦዳይስ ሄሮዶሳ ባግታይር ፐቲ ካራ ሺቄዛ።<verse eid="MRK 3:6"/></para>
  <para style="s1">አሳይ የሱሳኮ ሺቄዛ</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7"/>የሱሳ ፋ ታማርታይር ጋልላ አባ ላንቀ Ꮊንጌዛ። ጋልላፐራ ይሁዳፕ የኤዝ ጋመ አሳይ ኤዛ ካሌዛ። <verse eid="MRK 3:7"/><verse number="8" style="v" sid="MRK 3:8"/>ማካ የሩሳላመፕ፥ ኤዶማሳፕ፥ ዮርዳኖሳ ሃ ፕንፐ፥ ጽሮሳ ካታማፐር ስዶና ግዝ ካታማፕ የሱሳ ኦዝ ባዝታ ስኢ፥ ጋመ አሳይ ኤዝኮ የኤዛ። <verse eid="MRK 3:8"/><verse number="9" style="v" sid="MRK 3:9"/>ሺቄዝ አሳይ ጋመትይፕ ደንዴዛይድ ኤዛ ዋይም ጋርክ ኤ ታማርታይ ዎጎሎ ኤዝስ ሎእዳይ ጋርክ አዛዜዛ።<note caller="-" style="x"><char style="xo" closed="false">3:9-10 </char><char style="xt" closed="false"><ref loc="MRK 4:1">ማር. 4:1</ref>፤ <ref loc="LUK 5:1-3">ሉቃ. 5:1-3</ref></char></note> <verse eid="MRK 3:9"/><verse number="10" style="v" sid="MRK 3:10"/>ጋመ አስታ ኤ ፓዝ ግሾስ ሀርግንትዛ አሳይ ኡቢታይ ኤዛ ቦቾዳይስ ኡርቅንትዛ። <verse eid="MRK 3:10"/><verse number="11" style="v" sid="MRK 3:11"/>ቱና አያና አይኬዝ አስታይ ኤዛ በኤዛን ጋርክ ኤ ቲና ጹጉኒ፥ ፋ ቃላ ቅ ኡዲ፥ «ነ ጾስ ናአያ ባሳ?» ዬጌዛ።<verse eid="MRK 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 3:12"/>የሱሳ ኡንታን ፋ ሱን ኦስካ ኦዳማይ ጋርክ ሚን አዛዜዛ።<verse eid="MRK 3:12"/></para>
  <para style="s1">የሱሳ ታጶ ናምኢ ሀዋርታ ዶሬዛ</para>
  <para style="r">(<ref loc="MAT 10:1-4">ማቶ. 10:1-4</ref>፤ <ref loc="LUK 6:12-16">ሉቃ. 6:12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13"/>የሱሳ ደረል አፋ ከዚ፥ ፋ ኮዤዝ አስታ ፋኮ ጼጌዛ፤ ኡንትካ ኤዝኮ Ꮊንጌዛ። <verse eid="MRK 3:13"/><verse number="14" style="v" sid="MRK 3:14"/>ኡንትካ ፓር የዞዳይ ጋርከኔ ቃላ ታማርሶዳይ ጋርክ ታጶ ናምእታ ዶሪ፥ ኡንታን፥ «ሀዋርታ»<note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="fqa" closed="false">ሀዋረ፦ </char><char style="ft" closed="false">ሀዋረ ጉሳይ ኪትንቴዝ አስ ጉሲ።</char></note> ግ ጼጌዛ። <verse eid="MRK 3:14"/><verse number="15" style="v" sid="MRK 3:15"/>ቱና አያንታካ ከሶዳይ ጋርክ ኡንትስ ማዉተ እንጌዛ።<verse eid="MRK 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 3:16"/>ኤ ዶሬዝ ታጶ ናምእታይ Ꮊይትታ፦ ጵጽሮሳ ዬግንቲ ጼግንትዝ ስሞና፥ <verse eid="MRK 3:16"/><verse number="17" style="v" sid="MRK 3:17"/>ቦአነርገሰ (ዳዳ ናእታ) ዬጊ ሱን ጋዴዝታ፥ ዛብዶሳ ናእታ ያይቆባራኔ ያይቆባ እሻ ዋንሳ፥ <verse eid="MRK 3:17"/><verse number="18" style="v" sid="MRK 3:18"/>እንድራሰ፥ ፍልጶሳ፥ ባርቶሎሞሳ፥ ማቶሳ፥ ቶማሳ፥ ኢልፎሳ ናአ ያይቆባ፥ ታዶሳ፥ ካናነፕ ማቄዝ ስሞናራኔ፥ <verse eid="MRK 3:18"/><verse number="19" style="v" sid="MRK 3:19"/>የሱሳ ኣ እንጌዝ አስቆሮቶ ይሁዳ።<verse eid="MRK 3:19"/></para>
  <para style="s1">የሱሳራኔ ብኤልዘቡላር</para>
  <para style="r">(<ref loc="MAT 12:22-32">ማቶ. 12:22-32</ref>፤ <ref loc="LUK 11:14-23">ሉቃ. 11:14-23</ref>፤ <ref loc="LUK 12:10">12:10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20"/>የይፕ ጉየ፥ የሱሳ ካራ ገሌዛ። ማ ጋመ አሳይ ሺቅን፥ ኤዛራ ኤ ታማርታይ ሀራ አቶዝን ካ ማዳይስካ ዳንዳኤካያ። <verse eid="MRK 3:20"/><verse number="21" style="v" sid="MRK 3:21"/>አሳይ ኤዛ፥ «ኤይዛ» ግዝ ግሾስ ኤ ዳብታይ የያ ስኢ ኤዛ አይኮዳይስ Ꮊንጌዛ።<verse eid="MRK 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22"/>ህገ አስታማርታይፕ ፐታይ ፐታይ የሩሳላመፕ ይኢ፥ «ኤዛል አፋ ብኤልዘቡላ የዛ»፥ ኤ፥ «ጻላሄ ዎልቃር ጻላሄ አያንታ ከስዛ» ዬጊ ዎላ ኦድንቴዛ።<note caller="-" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="MAT 9:34">ማቶ. 9:34</ref>፤ <ref loc="MAT 10:25">10:25</ref></char></note><verse eid="MRK 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23"/>የሱሳ አስታ ፋኮ ጼጊ ኣዝሶ ኦዴዛ። «ጻላሄ ጻላሄ ዋይዚ ከሶዳይስ ዳንዳኤ? <verse eid="MRK 3:23"/><verse number="24" style="v" sid="MRK 3:24"/>ፐቲ ካተትይ ፋ ጋንጨ ሻኮ ከስኮ ያ ካተትይ ኤቆዳይስ ዳንዳኦያ። <verse eid="MRK 3:24"/><verse number="25" style="v" sid="MRK 3:25"/>የይ ጋርክ፥ ፐቲ ካራ አሳይካ ዎል ጋንጨ ሻኮ መኮ ቦዳይፕ አትን የዞዳይስ ዳንዳኦያ። <verse eid="MRK 3:25"/><verse number="26" style="v" sid="MRK 3:26"/>ይኬ፥ ጻላሄ ዎልር ሞርክንቲ ዱጽኮ ቦዳይፕ አትን የዞዳይስ ዳንዳኦያ።<verse eid="MRK 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 3:27"/>«ዝን ቲናቲ ዎልቃማ አ አጨካዛር ኤ ካራ ገሊ፥ ኤ ሻላ ቦንቆዳይስ ዳንዳእዛ አሲ ባያ። አጪ ማቄዛይፕ ኤ ካራ ቦንቆዳይስ ዳንዳእዛ።<verse eid="MRK 3:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28"/>«ታ ይንትስ ቱሮ ኦድዛ፤ ጾሲ አስ ናእታይስ ናጋራ ኡባኔ ኡ ጫዤዝ ጫሽ ኡባ አቶ ጎዳ። <verse eid="MRK 3:28"/><verse number="29" style="v" sid="MRK 3:29"/>ዝን ጌሻ አያናል አፋ ኢታ ባዝ ኦድንትዛ ኦስካ መናስ ናጋራ ማቆዳይፕ አትን ጾሲ ኡባራካ ኤዛ ማራሚ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">3:29 </char><char style="xt" closed="false"><ref loc="LUK 12:10">ሉቃ. 12:10</ref></char></note> <verse eid="MRK 3:29"/><verse number="30" style="v" sid="MRK 3:30"/>የሱሳ የያ ጌዛይ፥ አሳይ፥ «ኤዛል አፋ ቱና አያና የዛ» ዬጌዝ ግሾሲ።<verse eid="MRK 3:30"/></para>
  <para style="s1">የሱሳ እንዳትራኔ ኤ እሽታ</para>
  <para style="r">(<ref loc="MAT 12:46-50">ማቶ. 12:46-50</ref>፤ <ref loc="LUK 8:19-21">ሉቃ. 8:19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31"/>ኤ እንዳትኔ ኤ እሽታይ ይኢ ባለ ኤቂ፥ ኤዛ ጼግሴዛ። <verse eid="MRK 3:31"/><verse number="32" style="v" sid="MRK 3:32"/>ኤ ላንቀ በቴዝ ጋመ አስታይ፥ «ነ እንዳትራኔ ነ እሽታይር ባለ ኤቂ ነና ኮይዛ» ዬጌዛ።<verse eid="MRK 3:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33"/>የሱሳ ማሂ፥ «ታ እንዳት ኦኖ? ማ ታ እሽታይ ኣይታ?» ዬጌዛ። <verse eid="MRK 3:33"/><verse number="34" style="v" sid="MRK 3:34"/>ፋ ካለ በቴዝ አሳ ዩዪ ብኢ፥ «ታ እንዳትኔ ታ እሽታይ Ꮊይትታ። <verse eid="MRK 3:34"/><verse number="35" style="v" sid="MRK 3:35"/>ጾስ አዛዞ ኦዝ ኡቢታይ ታ እሸ፥ ታ ምሾ ታ ኣዮ» ዬጌዛ።<verse eid="MRK 3:35"/></para>
  <chapter eid="MRK 3"/>
  <chapter number="4" style="c" sid="MRK 4"/>
  <para style="s1">ዘር ዘርዝ አይ ኣዝሶ</para>
  <para style="r">(<ref loc="MAT 13:1-9">ማቶ. 13:1-9</ref>፤ <ref loc="LUK 8:4-8">ሉቃ. 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1"/>የሱሳ ማካ ጋልላ አባ ካለ ታማርሶ አይኬዛ። አቆፕ ኣዝ ጋመ አስታይ ኤ ላንቃይር ሺቅን፥ አባይል የዝ ዎጎላይ ጋንጨ ገሊ በቴዛ፥ አሳይ ኡቢታይ አባ ላንቀ የዛ።<note caller="-" style="x"><char style="xo" closed="false">4:1 </char><char style="xt" closed="false"><ref loc="LUK 5:1">ሉቃ. 5:1</ref></char></note> <verse eid="MRK 4:1"/><verse number="2" style="v" sid="MRK 4:2"/>ኤ ኡንታን ጋመ ባዝ ኣዝሶር ታማርሴዛ። ታማርስታር Ꮊይ ጋርክ ዬጌዛ፦<verse eid="MRK 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 4:3"/>«ስኦይታ! ፐቲ አይ ዘር ዘሮዳይስ ከዜዝ። <verse eid="MRK 4:3"/><verse number="4" style="v" sid="MRK 4:4"/>ኤ ዘሮዳር፥ ፐቲ ፐቲ ዘርይ ኦገ አቻ ዎዛ፤ ካፍታይ ይኢ ሜዛ። <verse eid="MRK 4:4"/><verse number="5" style="v" sid="MRK 4:5"/>ፐቲ ፐቲ ዘርይ ስስንቆ ኣዳ የዝ ቢታል አፋ ዎዛ። አፋር ቢታ ባዛይ ግሾስ የ ዘርይ ኤልሲ ዶሌዛ። <verse eid="MRK 4:5"/><verse number="6" style="v" sid="MRK 4:6"/>ዝን አዋ ከዜዝ ዎደ ሹሌዛ። ሎእ ጻጶ ዳከካ ግሾስ ኤልሲ መሌዛ። <verse eid="MRK 4:6"/><verse number="7" style="v" sid="MRK 4:7"/>ፐቲ ፐቲ ዘርታይ አንጉ ጋንጨ ዎዛ። ዶሌዛኖ አንጉ ድጪ ጩሌዝ ግሾስ ኣፈ ኣፋም እጼዛ። <verse eid="MRK 4:7"/><verse number="8" style="v" sid="MRK 4:8"/>ፐቲ ፐቲ ዘርታይ አራዳ ቢታል ዎ ዶሌዛ። ድጪ ፐታይ ሀስታም፥ ፐታይ ኡሱፑንታም ፐታይ ጼት ኣፌዛ» ዬጌዛ። <verse eid="MRK 4:8"/><verse number="9" style="v" sid="MRK 4:9"/>«ስእዝ ሀየር የዝ ኦንካ ስኦ» ዬጌዛ።<verse eid="MRK 4:9"/></para>
  <para style="s1">የሱሳ ኣዝሶር ኦዴዛይ</para>
  <para style="r">(<ref loc="MAT 13:10-17">ማቶ. 13:10-17</ref>፤ <ref loc="LUK 8:9-10">ሉቃ. 8:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10"/>የሱሳ ካለር የዝ አስታይኔ ታጶ ናምኢ ታማርታይ የሱሳ ፋ ኣዳ የዝን፥ ኤዝኮ ሺቂ ያ ኣዝሳይስ ብልእ ኦይጬዛ። <verse eid="MRK 4:10"/><verse number="11" style="v" sid="MRK 4:11"/>የሱሳ ኡንትኮ Ꮊይ ጋርክ ዬጌዛ፦ «ይንትስ ጾስ ካተት ጹራ ኤረት እንግንቴዛ። ዝን Ꮊንክታይስ ካተትፕ ባለ የዝታይስ ኡባ ባዝ ኣዝሶር ኦድንትዛ። <verse eid="MRK 4:11"/><verse number="12" style="v" sid="MRK 4:12"/>የይካ፥</para>
  <para style="q1" vid="MRK 4:12">« ‹ኡ ቢእዛ፥ ዝን ደንጎያ።</para>
  <para style="q1" vid="MRK 4:12">ስእዛ፥ ዝን አካኮያ።</para>
  <para style="q1" vid="MRK 4:12">ኡ ደንግዛኮኔ አካክዛኮ፥</para>
  <para style="q2" vid="MRK 4:12">ጾስኮ ማቆዳ</para>
  <para style="q2" vid="MRK 4:12">ኤዝካ ኡንታን ማሮዳዝኒ› »</para>
  <para style="m" vid="MRK 4:12">ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="ISA 6:9">ኢሳ. 6:9</ref></char></note><verse eid="MRK 4:12"/></para>
  <para style="s1">ዘር ኣዝሳይስ ብልእ</para>
  <para style="r">(<ref loc="MAT 13:18-23">ማቶ. 13:18-23</ref>፤ <ref loc="LUK 8:11-15">ሉቃ. 8:11-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13"/>የሱሳ ኡንትኮ፥ «Ꮊ ኣዝሳይ ይንትስካ ገሎሳ? የዝን፥ Ꮊንኮ ኣዝስታ ኡባ ይ ዋይዚ አካኮዴ? <verse eid="MRK 4:13"/><verse number="14" style="v" sid="MRK 4:14"/>ዘርዛይ ጾስ ቃላ ዘርዛ። <verse eid="MRK 4:14"/><verse number="15" style="v" sid="MRK 4:15"/>ቃላይ ዘርንቶዳር ኦገ ካንታ ዎዝታይ ቃላ ስኤዝታ። ዝን ጻላሄ እዝር ይኢ፥ ኡ ዎዝናይድ ዘርንቴዝ ቃላ ማጺ ኤኬዛ። <verse eid="MRK 4:15"/><verse number="16" style="v" sid="MRK 4:16"/>የይ ጋርክ፥ ስስንቆ የዝ ቢታይል ዘርንቴዛይ ቃላ ስኢ፥ ኤልሲ ኡፋይቲ ኤክዝታ። <verse eid="MRK 4:16"/><verse number="17" style="v" sid="MRK 4:17"/>ዝን ኡንትስ ጻጶ ባዛይ ግሾስ ጨረ Ꮊተሳፕ አትን ጋምኦያ። ጽቃ ዎደፕ ጉየ ቃላ ግሾ መቶ ዎይ ባይእ ሄልኮ ኤልሲ ብንትዛ። <verse eid="MRK 4:17"/><verse number="18" style="v" sid="MRK 4:18"/>አንጉ ጋንጨ ዘርንቴዛይ ቃላ ስእዝታ። <verse eid="MRK 4:18"/><verse number="19" style="v" sid="MRK 4:19"/>ዝን Ꮊ ሳአ የስስ ህርጋ፥ ዱረት ቃኔ ሀራ ባዝ አሞት ኤ ዎዝናይድ ገሊ ቃላ ጩልዛ ግሾስ ኣፈ ኣፈካዛር አትዛ። <verse eid="MRK 4:19"/><verse number="20" style="v" sid="MRK 4:20"/>ዝን አራዳ ቢታል ዘርንቴዝታይ ቃላ ስኢ ኤክዝታ። ኡንትካ ፐታይ ሀስታም፥ ፐታይ ኡሱፑንታም ፐታይ ጼት ኣፍዛ» ዬጌዛ።<verse eid="MRK 4:20"/></para>
  <para style="s1">ጌማ የዝ ጾምፐ</para>
  <para style="r">(<ref loc="LUK 8:16-18">ሉቃ. 8:16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21"/>የሱሳ ጉጂ፥ «ጾምፐ አይ፥ ኦታ ጋንጨ ዎይ አርሳ ኦሞ ጋድዝ አሲ የኔ? ቃ አቆ ጋዶሳኔ?<note caller="-" style="x"><char style="xo" closed="false">4:21 </char><char style="xt" closed="false"><ref loc="MAT 5:15">ማቶ. 5:15</ref>፤ <ref loc="LUK 11:33">ሉቃ. 11:33</ref></char></note> <verse eid="MRK 4:21"/><verse number="22" style="v" sid="MRK 4:22"/>ይኬ፥ ቆስንቴዝ ባዝ ኡቢታይ ከዘካዛር፤ ዙርንቴዝ ባዝ ኡባይ ፕ በንተካዛር አታሚ።<note caller="-" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="MAT 10:26">ማቶ. 10:26</ref>፤ <ref loc="LUK 12:2">ሉቃ. 12:2</ref></char></note> <verse eid="MRK 4:22"/><verse number="23" style="v" sid="MRK 4:23"/>ስእዝ ሀየ የዝ ኦንካ ስኦ» ዬጌዛ።<verse eid="MRK 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24"/>ማ ኡንትኮ፥ «ይንቲ ስእዝ ባዝ አካኪ ስኦይታ! ጾስ ቃላ ይ ስእዛን ጋርክ ኤ ይንትስ አካካ እንጎዳ። ይ ማክዝ ባዛር ይንትስ ማኮዳ። ኤዛይፐካ ይንትስ ጋን እንጎዳ። <verse eid="MRK 4:24"/><verse number="25" style="v" sid="MRK 4:25"/>ፐቲ ባዝ የዛ አይስ ጉጅንቲ እንግንቶዳ፥ ባዛይፕ ሀራ አቶዝን፥ የዛን እዛካ ኤፕ ኤክንቶዳ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="MAT 13:12">ማቶ. 13:12</ref>፤ <ref loc="MAT 25:29">25:29</ref>፤ <ref loc="LUK 19:26">ሉቃ. 19:26</ref></char></note><verse eid="MRK 4:25"/></para>
  <para style="s1">ዘር ድጮ ኣዝሶ</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26"/>የሱሳ ማሂ፥ «ጾሳ ካተትይ ፋ ጋደ ዘር ዘርዝ አስ ጋርከ። <verse eid="MRK 4:26"/><verse number="27" style="v" sid="MRK 4:27"/>የ አይ ቃማ ገንትዛ፤ ጉራ ጎዲ ደንድዛ። ኤ ዋይዛኮ ኤረካዝን ያ ዘርይ ዶሊ ድጭዛ። <verse eid="MRK 4:27"/><verse number="28" style="v" sid="MRK 4:28"/>ቢታታ ፋ ኣዳስ ካ እንግዛ። ቲና ጫረ፥ የይፕ ኣፎዳይስ ጋምቡጽዛ፥ ዉርስላ ኩን ኣፈ ኣፍዛ። <verse eid="MRK 4:28"/><verse number="29" style="v" sid="MRK 4:29"/>ዝን ካይ ማጾስ ሄልኮ አይ ኤልሲ ማጾ አይክዛ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">4:29 </char><char style="xt" closed="false"><ref loc="JOL 3:13">ኢዩ. 3:13</ref></char></note><verse eid="MRK 4:29"/></para>
  <para style="s1">ሳናፍጨ ዘር ኣዝሶ</para>
  <para style="r">(<ref loc="MAT 13:31-34">ማቶ. 13:31-34</ref>፤ <ref loc="LUK 13:18-19">ሉቃ. 13:18-19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30"/>የሱሳ፥ «ኑኒ ጾስ ካተት አብ ኣዝዛ ጎደ? ዎይ አባር ኣዝሶዴ? <verse eid="MRK 4:30"/><verse number="31" style="v" sid="MRK 4:31"/>ጾስ ካተትይ ሳናፍጨ ኣፈ ኣዝዛ። የ ምቲ አፋ ዘሮዳር ሳአ የዝ ም ኣፈ ኡባይፕ ጽቅዛራ <verse eid="MRK 4:31"/><verse number="32" style="v" sid="MRK 4:32"/>ዘርኮ ዶሊ ድጪ ም ኡባይፕ ኣዝ፤ ግታ ሻቆ ከስዛ። ሳሎ ካፍታይ እ ሻቃይል አፋ ኬጺ በቶድ ጋ ዳዥዛ» ዬጌዛ።<verse eid="MRK 4:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33"/>የሱሳ Ꮊይ ጋርክ ኡንደና ኣዝሶ አስታይ አካኮዳይስ ዳንዳእዛይ ጋርክ ቃላ ኦዴዛ። <verse eid="MRK 4:33"/><verse number="34" style="v" sid="MRK 4:34"/>አሳይስ ኣዝሶ ባዝን ኦዶያ። ዝን የሱሳ ፋ ታማርታይር ኣዳ የዛ ዎደ ኡንትስ ብልኢ ኦዴዛ።<verse eid="MRK 4:34"/></para>
  <para style="s1">የሱሳ አባ ዙላ ስእ ኡዴዛ</para>
  <para style="r">(<ref loc="MAT 8:23-27">ማቶ. 8:23-27</ref>፤ <ref loc="LUK 8:22-25">ሉቃ. 8:22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35"/>የ ጋላስ ሳአይ ኦማን፥ የሱሳ ፋ ታማርታይኮ፥ «አባፕ ሰኮ ፕኖ ዎላ ፒንጎዳ» ዬጌዛ። <verse eid="MRK 4:35"/><verse number="36" style="v" sid="MRK 4:36"/>ኤ ታማርታይ ዎይታ ኦሊ አሺ፥ የሱሳ ቲና ገሊ በቴዝ ዎጎልተ ገሊ የሱሳና ፓር ካንጌዛ። ሀራ ዎጎልታይ ኤዛይድ የዛ። <verse eid="MRK 4:36"/><verse number="37" style="v" sid="MRK 4:37"/>ዎልቃማ ጎተካ ደንዲ፥ ዎጎላይ ጋንጨ ሃ ኩሞድ ጋ ዙላይ ሾጬዛ። <verse eid="MRK 4:37"/><verse number="38" style="v" sid="MRK 4:38"/>የ ዎደ የሱሳ ዎጎላይስ ጉየ ባጋር ቦርኮ ገንቴዛ። ኤ ታማርታይ ኤዛ ደን፥ «አስታማራዮ፥ ኑኒ ቦዳር ነ ስኤ ግ ብእኔ?» ዬጌዛ።<verse eid="MRK 4:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39"/>ኤ ባርኪ ጎታና፥ «ስኤ ጎባ» ዬጊ፥ አባናካ፥ «ሀይዞባ» ጌዛ። ጎታይካ ስኤ ግን ኡባ ባዝ ጭጭርክ ጌዛ። <verse eid="MRK 4:39"/><verse number="40" style="v" sid="MRK 4:40"/>የሱሳ ፋ ታማርታይኮ፥ «Ꮊይ ጋርክ ይንታን ያሾዳይ አባ? ይንትስ አማኖ አብስ ቤኔ?» ዬጌዛ።<verse eid="MRK 4:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41"/>ኡንቲ ኢታ ያሻ ያሽቲ ዎል ጋንጨ፥ «Ꮊይ ሀራ አቶዝን፥ ጎተነ አባ አዛዝንትዛይ ኦኖ?» ዬጌዛ።<verse eid="MRK 4:41"/></para>
  <chapter eid="MRK 4"/>
  <chapter number="5" style="c" sid="MRK 5"/>
  <para style="s1">ቱና አያና አይኬዝ አይ ፓጼዛ</para>
  <para style="r">(<ref loc="MAT 8:28-34">ማቶ. 8:28-34</ref>፤ <ref loc="LUK 8:26-39">ሉቃ. 8:26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1"/>የሱሳራኔ ኤ ታማርታይ አባ ፒንጊ፥ ገርገሶና ግዝ ጋደ ሄሌዛ። <verse eid="MRK 5:1"/><verse number="2" style="v" sid="MRK 5:2"/>የሱሳ ዎጎላይፕ ዎዛን ጋርክ ቱና አያና አይኬዝ ፐቲ አይ ዱፎፕ ከዚ ኤዛ ሄሌዛ። <verse eid="MRK 5:2"/><verse number="3" style="v" sid="MRK 5:3"/>የ አይ ዱፎ ጋንጨ አቅታር ፔዥታር የዛ። ኤዛ ኦንካ ሳንላተር አጮዳይስ ዳንዳኦያ። <verse eid="MRK 5:3"/><verse number="4" style="v" sid="MRK 5:4"/>ኤ ጋመ ዎደ ዱኩልንቲ ሳንላተር አጭንቲ የዛ። ዝን ሳንላታ ዱስርዛ፥ ዱካ መንርዛ። ኤዛ ካዮዳይስ ዳንዳእዛ ኦንካ ባያ። <verse eid="MRK 5:4"/><verse number="5" style="v" sid="MRK 5:5"/>ኤ ቃማኔ ጋላስ ያ ዱፋይዳኔ ደረል አፋ ኡክዛ፥ ፋ ጋላካ ሹቻር ካርዛ።<verse eid="MRK 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6"/>የሱሳና ሃኮር ብኢ ዎጺ Ꮊንጊ ኤ ቲናይድ ጹጉኒ ጎይኔዛ። <verse eid="MRK 5:6"/><verse number="7" style="v" sid="MRK 5:7"/>የ አይ ፋ ቃላ ቅ ኡዲ፥ «ኡባይፕ ኣ ጾሳ ናአ የሱሳ፥ ነናኔ ታና አባ ሄልዛይ? ታና ብሳማይ ጋርክ ታ ነና ጾሳ ሱንር ዎስዛ» ዬጌዛ። <verse eid="MRK 5:7"/><verse number="8" style="v" sid="MRK 5:8"/>ኤ የያ ጌዛይ የሱሳ ኤዛ፥ «ናት Ꮊ ቱና አያናዮ፥ Ꮊ አይፕ ከዞባ» ዬጊ ኪቴዝ ግሾሲ።<verse eid="MRK 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9"/>የሱሳ ኤዝኮ፥ «ነ ሱንይ ኦኖ?» ዬጊ ኦይጬዛ።</para>
  <para style="p" vid="MRK 5:9">ኤ፥ «ኑኒ ጋመ ማቄዝ ግሾስ ታ ሱንይ ሌጎና» ዬጌዛ። <verse eid="MRK 5:9"/><verse number="10" style="v" sid="MRK 5:10"/>ቱና አያንታይ ፋና ያ ጋዳይፕ ከሲ ዳካማይ ጋርክ የሱሳና ሚን ዎሴዛ።<verse eid="MRK 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11"/>የ ደራይል አፋ ጋመ ጉዳይለ ዉደ ሄንግንትዛ። <verse eid="MRK 5:11"/><verse number="12" style="v" sid="MRK 5:12"/>ቱና አያንታይ የሱሳኮ፥ «ኑና ሰኮ ጉዳይለ ዉዳይኮ ዳኮየ፥ ኡ ጋንጨ Ꮊንጊ ኑ ገሎዳ» ዬጊ ዎሴዛ። <verse eid="MRK 5:12"/><verse number="13" style="v" sid="MRK 5:13"/>የሱሳ ኡንትኮ፥ «ቅቶይታ» ዬጌዛ። ዬግን ቱና አያንታይ አይፕ ከዚ ጉዳይልታይል ገሌዛ። ናምኢ ሙኩለ ማቆድ ጉዳይለ ዉዳይ ጋጋ ዶናር ድርጊ Ꮊንጊ አባ ጋንጨ ገሊ ምትንቴዛ።<verse eid="MRK 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14"/>ጉዳይለ ዉደ ሄንግዝታይ ያሽቲ Ꮊንጊ ሀኔዝባዛና ካታማስኔ ጋጻረስ ኦዴዛ። የይፐ አሳይ ሀኔዝባዛና በአዳይስ ከዜዝ። <verse eid="MRK 5:14"/><verse number="15" style="v" sid="MRK 5:15"/>አሳይ የሱሳኮ ይእታር ቱና አያናይ ኤፕ ከዜዝ አ በኤዛ። ኤ ዎዝናይ ማቅን፥ አፍላ ማኢ፥ ኤዛይድ በቴዛና ብኢ ኡቢታይ ያሽቴዛ። <verse eid="MRK 5:15"/><verse number="16" style="v" sid="MRK 5:16"/>የያ በኤዝ አስታይ ቱና አያንታይ አይኬዛ አይል አፋኔ ጉዳይልታይል አፋ ሀኔዝባዛና ኡባ አስስ ኦዴዛ። <verse eid="MRK 5:16"/><verse number="17" style="v" sid="MRK 5:17"/>የይ ግሾስ፥ አሳይ ፋ ቢታይፕ የሱሳ ከዚ ቅቶዳይ ጋርክ ዎሴዛ።<verse eid="MRK 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18"/>የሱሳ ዎጎላይል አፋ ከሳዳር ቲን ቱና አያና አይኪ ዳኬዝ አይ፥ የሱሳር Ꮊማዳይስ ኤዛ ዎሴዛ። <verse eid="MRK 5:18"/><verse number="19" style="v" sid="MRK 5:19"/>ዝን የሱሳ እጺ ኤዝኮ፥ «ነ ካራ ማቂ፥ ጎዳይ ኔስ አብ ጋርክ ማሮት ኦዛኮ ኔስ ዋፋ ኬሄዛኮ ነ ካራ አሳይስ ኦዶባ» ዬጌዛ። <verse eid="MRK 5:19"/><verse number="20" style="v" sid="MRK 5:20"/>አይ Ꮊንጊ ታጲ ካታማ ግንትዝ አቆ ዩዪ፥ የሱሳ ኤዝስ አብ ጋርክ ማሮት ኦዛኮ ኦዴዛ። ኤ ኦዴዛና ስኤዝ አስ ኡቢታይ ማላባዝ ጌዛ።<verse eid="MRK 5:20"/></para>
  <para style="s1">Ꮊይቄዝ ናአቶኔ የሱሳ አፍላ ቦቼዝ አስቶ</para>
  <para style="r">(<ref loc="MAT 9:18-26">ማቶ. 9:18-26</ref>፤ <ref loc="LUK 8:40-56">ሉቃ. 8:40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21"/>የሱሳ ማቂ፥ ዎጎሎ ጋንጨ ገሊ፥ አባ ፒንጌዛይፕ ጉየ ጋመ አሳይ አባ ጋጻ ኤ ካለ ሺቄዛ። <verse eid="MRK 5:21"/><verse number="22" style="v" sid="MRK 5:22"/>ኢያሮሳ ግዝ አይሁድታይ ዎሳ ኬ ሀላቅታይፕ ፐታይ፥ የሱሳና በኤዝ ዎደ ኤዝኮ ይኢ ኤ ቶካይል አፋ ዎ፥ <verse eid="MRK 5:22"/><verse number="23" style="v" sid="MRK 5:23"/>«ታ ናአታ ሀርግንቲ Ꮊይቆድ ሀንዛ። እዛ ፓጾድ ጋርክ ይኢ ነ ኩሸ እዝል አፋ ጋዶዬ» ዬጊ የሱሳና ሚን ዎሴዛ።<verse eid="MRK 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 5:24"/>የሱሳ ኢያሮሳር Ꮊንጌዛ። ኤ Ꮊማዳር ጋመ አስ ኤዛ ካልታር ኡርቅዛ።<verse eid="MRK 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25"/>ታጶ ናምኢ ላይ እዝላፕ ሱ ጎጌዝ ፐቲ አስታ የዛ። <verse eid="MRK 5:25"/><verse number="26" style="v" sid="MRK 5:26"/>ጋመ አክምታይ እዞ አክሜዝን፥ እዛ ፓ ኤቃ ካእንትዛ። እዛ ፋ ሚሻ ኡባ ዉርስንካ ኢስ Ꮊና ኢቴዛይፕ አትን አብካ እዞ ማደካያ። <verse eid="MRK 5:26"/><verse number="27" style="v" sid="MRK 5:27"/>የ አስታ የሱሳ ዋራ ስኤዝ፥ ግሾስ አሳይፕ ኣ የሱሳስ ጉይጉር ይኢ ኤ አፍላ ቦቼዛ። <verse eid="MRK 5:27"/><verse number="28" style="v" sid="MRK 5:28"/>እዛ፥ «ታ ሀራ አቶዝን ኤ አፍላ ማንቻቶ ቦቼዛኮ ፓጾዳ» ግ ቆፔዛ።<verse eid="MRK 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 5:29"/>እዝፕ ጎግዝ ሱይ እዝር ኤቂ አቴዛ። እዛ ፋ ዋያይፕ ፓጼዛና ፋ ጋላይል ኤሬዛ። <verse eid="MRK 5:29"/><verse number="30" style="v" sid="MRK 5:30"/>የሱሳ ኤልሲ ፓፕ ዎልቃ ከዜዛና ፋ ኡባስ ኤሪ፥ ጋመ አሳይ ጋንጨ ጉየ ማቂ፥ «ታ አፍላ ቦቼዛይ ኦኖ?» ዬጌዛ።<verse eid="MRK 5:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31"/>ኤ ታማርታይ፥ «አሳይ ነና ኡርቅዛ ብእታር፥ ‹ኦኖ ታና ቦቼዛይ ዬጊ ዋይዚ ኦይጨ?› » ዬጌዛ።<verse eid="MRK 5:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32"/>የሱሳ የያ ኦ ኦዛኮ ኤሮዳይስ ዩዪ በኤዛ። <verse eid="MRK 5:32"/><verse number="33" style="v" sid="MRK 5:33"/>ዝን አስታ ፓስ ሀኔዝባዛና ኤሪ፥ ያሻር ኩኩርታር ይኢ የሱሳ ቲናይድ ጉጲንጊ፤ ፋ ጽላት ኡባ ኤስ ኦዴዛ። <verse eid="MRK 5:33"/><verse number="34" style="v" sid="MRK 5:34"/>ዬይን፥ የሱሳ እዝኮ፥ «ታናአተ፥ ነና ነ አማናይ ፓዛ፥ ሳሮ Ꮊንጎባ፥ ነ ዋያይፐካ ፓጾባ» ዬጌዛ።<verse eid="MRK 5:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35"/>የሱሳ ሀጋ Ꮊያ ኦዶዳር፥ አይሁደ ዎሳ ኬ ሀላቃይ ካራፕ ኪትንቴዝ አስታይ ይኢ፥ «ነ ናአታ Ꮊይቄዛ፥ Ꮊት አስታማራ አብስ ዳቡርሰ?» ዬጌዛ።<verse eid="MRK 5:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36"/>ዝን የሱሳ ኡ ግዛና ስኢ፥ አይሁድታይ ዎሳ ኬ ሀላቃይኮ፥ «አማኖ ኣዳ አማኖባፕ አትን ያሽትፐ» ዬጌዛ። <verse eid="MRK 5:36"/><verse number="37" style="v" sid="MRK 5:37"/>የሱሳ ጵጽሮሳፕ፥ ያይቆባፐኔ ያይቆባ እሻ ዋንሳፕ ሀራ ኦንካ ፋና ካላማይ ጋርክ ካዬዛ። <verse eid="MRK 5:37"/><verse number="38" style="v" sid="MRK 5:38"/>ኡንቲ አይሁደ ዎሳ ኬ ሀላቃይ ካራ ሄሎዳር የሱሳ አሳይ ዬኮዳር፥ ዘላሎዳራኔ ኡኮዳር በኤዛ። <verse eid="MRK 5:38"/><verse number="39" style="v" sid="MRK 5:39"/>ገሊ አስታይኮ፥ «Ꮊ ኡባ ዬፋይኔ ኡፋይ አብሶ? ናአታ ገንቴዛፕ አትን Ꮊይቀካያ» ዬጌዛ።<verse eid="MRK 5:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 5:40"/>አሳይ ኤዛ ለቂ ሚጬዛ። ዝን አስ ኡብታ ባለ ከሲ፥ ናአቲ ኣዳ፥ እንዳቶኔ ሀይ ታማርታ ፓር ኤኪ ናአታ የዛበሳ ገሌዛ። <verse eid="MRK 5:40"/><verse number="41" style="v" sid="MRK 5:41"/>የሱሳ ናአቲ ኩሻ አይኪ፥ «ጻልታ፥ ኩሚ» ጌዛ። ብልይካ (ጽቃ ናአተ፥ ነና ግዛ ደንዶባ) ጉሲ።<verse eid="MRK 5:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 5:42"/>እዛ ታጶ ናምኢ ላይ ናአዛር እዝር ደንዲ ኤቂ የ አይኬዛ። የይካ ሀኔዛ ብኢ አሳይ ማላባዝ ጌዛ። <verse eid="MRK 5:42"/><verse number="43" style="v" sid="MRK 5:43"/>የሱሳ የያ ኡ ኦስካ ኦዳማይ ጋርክ ኡንታን ሚን አዛዜዛ። ናአትስ ሚዝ ባዝ እማድ ጋርክ ኦዴዛ።<verse eid="MRK 5:43"/></para>
  <chapter eid="MRK 5"/>
  <chapter number="6" style="c" sid="MRK 6"/>
  <para style="s1">የሱሳ ናዝረተ እጽንቴዛ</para>
  <para style="r">(<ref loc="MAT 13:53-58">ማቶ. 13:53-58</ref>፤ <ref loc="LUK 4:16-30">ሉቃ. 4:16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1"/>የሱሳ የይፕ ከዚ፥ ፋ ታማርታ ካል፥ ፋ ካታማ ናዝረተ ቅቴዛ። <verse eid="MRK 6:1"/><verse number="2" style="v" sid="MRK 6:2"/>ማላ ጋላስ አይሁደ ዎሳ ኬ ታማርሶ አይኬዛ። ኤ ታማርስዛና ስኤዝ ጋመ አሳይ Ꮊይ ማላባዝ ግ፥ «Ꮊይ Ꮊ ኡባ አናፕ ደንጌኔ? Ꮊይ ኤስ እንግንቴዝ ኤጨትይ ዋፋ? Ꮊ ማላትታ ኦዛ ማዉታይ ኤስ ዋይዚ እንግንቴነ?<figure style="fig" alt="Man reading inside synagogue" file="LB00244B.tif" size="span" ref="6:2">ፐቲ አስ አይሁደ ዎሳ ከ ናባቦዳር</figure> <verse eid="MRK 6:2"/><verse number="3" style="v" sid="MRK 6:3"/>Ꮊይ አናጻ ባሳ? ማይራሚ ናአ፥ ያይቆባ፥ ዮሳ፥ ይሁዳራኔ ስሞና እሻ ባሳ? ኤ ምሹንካ ኑር Ꮊኔ የዙንን ባሳኔ?» ዬጊ፥ ኤ ኦድዛና ኤካም እጼዛ።<verse eid="MRK 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4"/>የሱሳ የ አስታይኮ፥ «ናበ ፋ ጋደላ፥ ፋ ዳብታይዳኔ ፋ ካራ አስ ጋንጨ ቦንችንቶያፕ አትን Ꮊንክታይ ካለ ቦንችንትዛ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="JHN 4:43">ዋን. 4:43</ref></char></note> <verse eid="MRK 6:4"/><verse number="5" style="v" sid="MRK 6:5"/>ኤ የ አቃይድ ፋ ኩሻ ሀርግንትዛ ጽቃ አስታይል አፋ ጋዲ ፓዛይፕ አትን ሀራ ማላታ ባዝ ኦዳይስ ዳንዳኤካያ። <verse eid="MRK 6:5"/><verse number="6" style="v" sid="MRK 6:6"/>አሳይ አማናም እጼዝ ግሾስ ፓላ ባዝ ጌዛ። የይፕ ጉየ፥ የሱሳ የ ሄራፕ ሀራ ሄራ ታማርሴዛ።<verse eid="MRK 6:6"/></para>
  <para style="s1">የሱሳ ታጶ ናምኢ ሀዋርታ ኪቴዛ</para>
  <para style="r">(<ref loc="MAT 10:5-15">ማቶ. 10:5-15</ref>፤ <ref loc="LUK 9:1-6">ሉቃ. 9:1-6</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 6:7"/>የሱሳ ታጶ ናምኢ ታማርታ ፋኮ ጼጊ፥ ናምኤ ናምኤ ዎል ሄል ኪቴዛ። ኡንትስ ቱና አያንታይል አፋ ማዉተ እንጌዛ። <verse eid="MRK 6:7"/><verse number="8" style="v" sid="MRK 6:8"/>ኡንታን፥ «ኦገስ ጉፈ ኣዳፕ አትን ካ፥ ቁርቦ፥ ይ ኪሰ ሚሸ አባባዝካ አይክፓቴ።<note caller="-" style="x"><char style="xo" closed="false">6:8-11 </char><char style="xt" closed="false"><ref loc="LUK 10:4-11">ሉቃ. 10:4-11</ref></char></note> <verse eid="MRK 6:8"/><verse number="9" style="v" sid="MRK 6:9"/>ይ ቶኬ ጫማ ኣይታ፥ ዝን ላመ አፍላካ አይክፓተ» ዬጌዛ። <verse eid="MRK 6:9"/><verse number="10" style="v" sid="MRK 6:10"/>ማካ፥ «ይንታን አሲ ሞኬዝ ካራ አባካ ማቅን የ አቃቶ አሺ ቅቶድ ጋ የ ካርቴ ጋምኦይታ። <verse eid="MRK 6:10"/><verse number="11" style="v" sid="MRK 6:11"/>ይንታን አሲ ሞኮዋ ካራ ዎይ ይ ኦድዛ ባዝ ስኦዋ ካራ አባካ ማቅኮ፥ የ ቢታተ የዝ አሳይስ የይ ማርካ ማቃዳይ ጋርክ የ አቃይፕ ከዝታር፥ ይ ቶካይፕ ቡልአ ትቅሶይታ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">6:11 </char><char style="xt" closed="false"><ref loc="ACT 13:51">ሀዋ. ኦ. 13:51</ref></char></note><verse eid="MRK 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12"/>ታጶ ናምኢ ታማርታይ Ꮊንጊ፥ አሳይ ፋ ናጋራይፕ ማቃዳይ ጋርክ ቃላ ኦዴዛ። <verse eid="MRK 6:12"/><verse number="13" style="v" sid="MRK 6:13"/>ኡንቲ አሳይፕ ጋመ ቱና አያንታ ከሴዛ። ጋመ ሀርግንቴዝታ ዛይተ ትዢ ፓዛ።<note caller="-" style="x"><char style="xo" closed="false">6:13 </char><char style="xt" closed="false"><ref loc="JAS 5:14">ያይ. 5:14</ref></char></note><verse eid="MRK 6:13"/></para>
  <para style="s1">ጻማቅዛ ዋንሳ Ꮊይቆ</para>
  <para style="r">(<ref loc="MAT 14:1-12">ማቶ. 14:1-12</ref>፤ <ref loc="LUK 9:7-9">ሉቃ. 9:7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14"/>የሱሳ ሱንይ ኡባ አቆ ከዜዛይ ግሾስ ካታይ ሄሮዶሳ ኤ ባጋ ስኤዛ። ፐቲ ፐቲ አሳይ፥ «ጻማቅዛ ዋንሳ Ꮊይቆፕ ደንዴዛ፥ የይ ባጋር Ꮊ ማላትታ ኦዛይ ኤዛ» ዬጌዛ።<verse eid="MRK 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15"/>ባግታይ፥ «Ꮊይ ኤላሳ» ዬጌዛ።</para>
  <para style="p" vid="MRK 6:15">Ꮊንክታይ ማ፥ «Ꮊይ ብኒ ዎደ ናብታይፕ ፐታይ ጋርክ ማቅ አታሚ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">6:14-15 </char><char style="xt" closed="false"><ref loc="MAT 16:14">ማቶ. 16:14</ref>፤ <ref loc="MRK 8:28">ማር. 8:28</ref>፤ <ref loc="LUK 9:19">ሉቃ. 9:19</ref></char></note><verse eid="MRK 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16"/>ዝን ሄሮዶሳ የያ ስኢ «Ꮊይ ታ ቆ ጋችሴዝ ጻማቅዛ ዋንሳ ኤ Ꮊይቆፕ ደንዴዛ» ዬጌዛ።<verse eid="MRK 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 6:17"/>ሄሮዶሳ ፋ እሻይ ፍልጶሳ ማቻቶ ሄሮዳዳ ኤኬዝ ግሾስ ዋንሳ አይ አጭሴዛ። <verse eid="MRK 6:17"/><verse number="18" style="v" sid="MRK 6:18"/>ዋንሳ ሄሮዶሳ፥ «ነ ነ እሻይ ማቻቶ ኤኮዳይስ ቤዞያ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">6:17-18 </char><char style="xt" closed="false"><ref loc="LUK 3:19-20">ሉቃ. 3:19-20</ref></char></note><verse eid="MRK 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 6:19"/>ሄሮዳዳ ዋንሳ ፋ ኡሎር ሞርኪ ኤዛ ዎሶዳይስ ኮዬዛ፥ ዝን ዳንዳኤካያ። <verse eid="MRK 6:19"/><verse number="20" style="v" sid="MRK 6:20"/>ዋንሳ ጽሎኔ ጌሽ አስ ማቄዛና ሄሮዶሳ ኤሬዝ ባጋር ኤዝስ ያሽቲ ሚን ናጌዛ። ሄሮዶሳ ዋንሳ ናሻ ስኢ ኡፋይትዛራካ ሞርእዛ።<verse eid="MRK 6:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21"/>ሄሮዶሳ ፋ የልንቴዝ ጋላሳ ቦንቾዳይስ ጋደ አቅስዝታይስ፥ ሻላቅታይስኔ ጋልላ የዝ ዳማ አሳይስ እማቶ ጊግሴዛ። የይ ሄሮዳዳስ ሎኦ ጋላስ ማቄዛ። <verse eid="MRK 6:21"/><verse number="22" style="v" sid="MRK 6:22"/>ሄሮዳዳ ናአታ እማ ሞክንትዛ አቃይድ ገሊ ዶንጊ፥ ሄሮዶሳኔ ኤ እማታ ኡፋይሴዛ። ካታይ ናአትስ፥ «ነ ኮይዝ ባዝ አብ ማቅኮካ ታና ኦይጮባ፥ ታ ኔስ እማዳ» ዬጌዛ። <verse eid="MRK 6:22"/><verse number="23" style="v" sid="MRK 6:23"/>ማ እዝስ ጫቂ፥ «ነ ኦይጭዝ ባዝ አብ ማቅኮካ፥ ታ ኔስ እማዳ። ሀራ አቶዝን፥ ታ ካተትይ ባጋ ማቅኮካ ታ ኔስ እማዳ» ዬጌዛ።<verse eid="MRK 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24"/>ናአታ ባለ ከዚ ፋ እንዳትኮ፥ «አብ እንጎባ ግ ኦይጮ?» ግ ኦይጬዛ።</para>
  <para style="p" vid="MRK 6:24">እ እንዳት፥ «ጻማቅዛ ዋንሳ ኦማ እንጎ ጎባ» ዬጌዛ።<verse eid="MRK 6:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25"/>ናአታ ኤልሲ ካታይኮ Ꮊንጊ፥ «ጻማቅዛ ዋንሳ ቆትፕ ጋቺ ፕልኦ ጋንጨ ጋዲ Ꮊት ታስ እማዳይ ጋርክ ታ ኮይዛ» ዬጌዛ።<verse eid="MRK 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26"/>ዬግን ካታይ ኡንደና ቂራዛ ዝን ፋ እማታይ ግሾ እዝስ ጫቄዝ ፋ ጫቃ መንዳይስ ኮየካያ። <verse eid="MRK 6:26"/><verse number="27" style="v" sid="MRK 6:27"/>የይ ግሾስ፥ ኤልሲ ናግዛ አ ዋንሳ ኦማ ኮኦዳይ ጋርክ ኪቴዛ። ናግዛ አይ አች ኬ Ꮊንጊ ዋንሳ ቆ ጋቼዛ። <verse eid="MRK 6:27"/><verse number="28" style="v" sid="MRK 6:28"/>የ ጋችንቴዝ ኦማ ፕልኦ ጋንጨ ጋዲ ክኢ ናአትስ እንጌዛ። ናአታካ ማ ፋ እንዳትስ እንጌዛ። <verse eid="MRK 6:28"/><verse number="29" style="v" sid="MRK 6:29"/>ዋንሳ ታማርታይ የያ ስኤዝ ዎደ Ꮊንጊ ኤ አሃ ኤኪ ካንጊ ሞጌዛ።<verse eid="MRK 6:29"/></para>
  <para style="s1">የሱሳ እችን ሙኩለ አሳ ሙዜዛ</para>
  <para style="r">(<ref loc="MAT 14:13-21">ማቶ. 14:13-21</ref>፤ <ref loc="LUK 9:10-17">ሉቃ. 9:10-17</ref>፤ <ref loc="JHN 6:1-14">ዋን. 6:1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30"/>ሀዋርታይ ማቂ ይኢ የሱሳኮ ሺቂ ኡ ኦዝባዝኔ ታማርሴዛ ባዝ ኡባ የሱሳስ ኦዴዛ። <verse eid="MRK 6:30"/><verse number="31" style="v" sid="MRK 6:31"/>ኡንትኮ ይእዛ አሳይኔ ቅትዛ አሳይ ጋንጌዝ ግሾስ የሱሳራኔ ኤ ታማርታይ፥ ሀራ አቶዝን ካ ማዳይስካ ኡንትስ ዎደ ቤዛ። ዬይን፥ የሱሳ ኡንትኮ፥ «ኑስካ ጽቃል ሸምፕ ኤኮዳይስ አሲ ባ አቆ የይታ» ዬጌዛ። <verse eid="MRK 6:31"/><verse number="32" style="v" sid="MRK 6:32"/>የይ ግሾስ፥ ኡንቲ ፋ ኣዳስ ዎጎሎ ጋንጨ ገሊ አሲ ባ አቆ Ꮊንጌዛ።<verse eid="MRK 6:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 6:33"/>ኡ Ꮊማዳር ጋመ አስታይ ኡንታን ብኢ ኤሬዛ። የዝን፥ ካታማ ኡባፕ አሲ ቶከር ዎጺ Ꮊንጊ ኡ Ꮊንግዛ አቃይድ ኡንታፕ ቲናቲ ሄሌዛ። <verse eid="MRK 6:33"/><verse number="34" style="v" sid="MRK 6:34"/>የሱሳ ዎጎሎፕ ዎ ጋመ ዎያ በኤዛ። አሳይ ሄንግዝ አሲ ባ ዱር ጋርክ ማቄዛና ብኢ ኡንትስ ቃንቲ ኡንታን ጋመ ባዝ ታማርሴዛ።<note caller="-" style="x"><char style="xo" closed="false">6:34 </char><char style="xt" closed="false"><ref loc="NUM 27:17">ታይ. 27:17</ref>፤ <ref loc="1KI 22:17">1ካት. 22:17</ref>፤ <ref loc="EZK 34:5">ኢዝቀ. 34:5</ref>፤ <ref loc="MAT 9:36">ማቶ. 9:36</ref></char></note><verse eid="MRK 6:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 6:35"/>ሳአይ አዋ ኣዳር የሱሳ ታማርታይ ኤዝኮ ይኢ፥ «Ꮊ አቃይ ሊዦ፤ Ꮊት ሳአይ ኦማዛ። <verse eid="MRK 6:35"/><verse number="36" style="v" sid="MRK 6:36"/>አሳይ ሄራራኔ ካታማር Ꮊንጊ ፓስ ሚዝ ባዝ ዎንጎድ ጋርክ አሳ ዳኮባ» ዬጌዛ።<verse eid="MRK 6:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37"/>ዝን የሱሳ ማሂ ኡንትኮ፥ «አሳይስ ሚዝ ባዝ ይ እንጎይታ» ዬጌዛ።</para>
  <para style="p" vid="MRK 6:37">ኡ፥ የዝን «ኑኒ Ꮊንጊ ናምኢ ጼት ዲናረር ሶሎ ዎንጊ እማደኔ?» ዬጊ ኦይጬዛ።<verse eid="MRK 6:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38"/>የሱሳ ኡንትኮ፥ «ይንትስ ኣፑን ሶሎ የኔ? አን Ꮊንጊ ቦኦይታ» ዬጌዛ።</para>
  <para style="p" vid="MRK 6:38">ኡ ብኢ፥ «እችን ሶሎራኔ ናምኢ ሞሎር የዛ» ዬጌዛ።<verse eid="MRK 6:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39"/>የሱሳ ፋ ታማርታ አሳ ኡባ ጩጋር ጩጋር ሻኪ ማታል በትዳይ ጋርክ ኪቴዛ። <verse eid="MRK 6:39"/><verse number="40" style="v" sid="MRK 6:40"/>አሳይ ባጋይ ጼት፥ ባግታይ እሻታም ማቂ ጩጋር ጩጋር ሻክንቲ በቴዛ። <verse eid="MRK 6:40"/><verse number="41" style="v" sid="MRK 6:41"/>የሱሳ እችን ሶሎራኔ ናምኢ ሞልታ ኤኪ፥ ሳሎ ብኢ ጾሳ ጋላቴዛ። ሶላ ዱ አሳይስ ግሾዳይ ጋርክ ፋ ታማርታይስ እንጌዛ። ማ ናምኢ ሞልታ ኡ ኡቢታይስ ሻኬዛ። <verse eid="MRK 6:41"/><verse number="42" style="v" sid="MRK 6:42"/>አስ ኡቢታይ ም ምዤዛ። <verse eid="MRK 6:42"/><verse number="43" style="v" sid="MRK 6:43"/>አቴዝ ሶሎ ጉፋኔ ሞሎ ጉፋ፥ ኤ ታማርታይ ታጶ ናምኢ ሌማተ ኩን ደንዛ። <verse eid="MRK 6:43"/><verse number="44" style="v" sid="MRK 6:44"/>ሶሎ ሜዝ ራ አስታይ ኣዳ እችን ሙኩለ ማቃዳ።<verse eid="MRK 6:44"/></para>
  <para style="s1">የሱሳ አባል አፋ የዛ</para>
  <para style="r">(<ref loc="MAT 14:22-33">ማቶ. 14:22-33</ref>፤ <ref loc="JHN 6:15-21">ዋን. 6:15-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45"/>ኤልሲ የሱሳ ፋ ታማርታይ ዎጎሎ ጋንጨ ገሊ፥ አባፕ ሰኮፍኖ የዝ ቢታ ቤተሳይዳ Ꮊንጎዳይፕ ቲናቲ ቅቶዳይ ጋርክ ኪቴዛ። <verse eid="MRK 6:45"/><verse number="46" style="v" sid="MRK 6:46"/>አሳ ሞይዜዛይፕ ጉየ ጾስ ዎሶዳይስ ደረል አፋ ከዜዝ።<verse eid="MRK 6:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="MRK 6:47"/>ሳአ ቃሞዳር ዎጎላይ አባ ጋንጨ የዝን፥ የሱሳ አባ ጋጻ ፋ ኣዳ የዛ። <verse eid="MRK 6:47"/><verse number="48" style="v" sid="MRK 6:48"/>ጫርኮ ኤ ታማርታይኮ ጫርክዝ ግሾስ አባ ፕይ ዋይዛና የሱሳ በኤዛ። ዎንትማ ሹጉላ ኡኮዳር ኤ አባል አፋር የታር ኡንትኮ ይኢ፥ ኡንታን ኦሊ ኣዳይስ ኮዬዛ። <verse eid="MRK 6:48"/><verse number="49" style="v" sid="MRK 6:49"/>ዝን ኤ አባል አፋ የዳር፥ ኡ ብኢ፥ ኡንትስ ሜሸ ኣዝን ኡኬዛ። <verse eid="MRK 6:49"/><verse number="50" style="v" sid="MRK 6:50"/>ኡ ኡቢታይ ኤዛ ብኢ፥ ያሽቲ ዳጋሜዛ።</para>
  <para style="p" vid="MRK 6:50">ዝን የሱሳ ኤልሲ ኡንትኮ፥ «ታና፥ አኮ ባያ፤ ያሽትፓተ» ዬጌዛ። <verse eid="MRK 6:50"/><verse number="51" style="v" sid="MRK 6:51"/>የሱሳ ዎጎላይድ ገሊ ኡንታር ዎላ በትን ጫርካይ ስእ አቴዛ። ኡንቲ ግታ ማላ ባዝ ጌዛ። <verse eid="MRK 6:51"/><verse number="52" style="v" sid="MRK 6:52"/>ኡ ዎዝናይ ዶጬዝ ግሾስ ሶላይል ኦዝ ማላታ ኡንቲ አካኬካያፕ አትን Ꮊይ ኡንትስ ማላባዝ ባቦናዝን።<verse eid="MRK 6:52"/></para>
  <para style="s1">የሱሳ ገንሳሬጼ ሀርግንቴዝታ ፓዛ</para>
  <para style="r">(<ref loc="MAT 14:34-36">ማቶ. 14:34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53"/>ኡንቲ አባ ፒንጊ፥ ገንሳሬጼ ቢታ ሄሊ፥ ዎጎላ ጋጻል ሺሺ አጬዛ። <verse eid="MRK 6:53"/><verse number="54" style="v" sid="MRK 6:54"/>ኡ ዎጎላይፕ ዎዳር አሳይ ኤልሲ የሱሳና ኤሬዛ። <verse eid="MRK 6:54"/><verse number="55" style="v" sid="MRK 6:55"/>ኡ ሄራ የዝ ቢታ ኡባ ዎጽቲ ሀርግንቴዝ አስታ ሀላር ቶኪ፥ «የሱሳ የዛ» ጌዝ አቃይድ ክእ አይኬዛ። <verse eid="MRK 6:55"/><verse number="56" style="v" sid="MRK 6:56"/>አሳይ ኤ Ꮊንጌዝ ካራ ኡባ፥ ጋጻረ ማቅን፥ ካታማ፥ የዝ ሀርግንቴዝ አስታ ቡጫል ካንግዛ። ሀርግንቴዝ አስታይ ኤ አፍላ ማንቻ ማቅኮካ ቦቾድ ጋርክ አሳይ ኤዛ ዎሴዛ። ቦቼዝ ኡቢታይ ፓጼዛ።<verse eid="MRK 6:56"/></para>
  <chapter eid="MRK 6"/>
  <chapter number="7" style="c" sid="MRK 7"/>
  <para style="s1">ብኒ አድታይ ዎጋ</para>
  <para style="r">(<ref loc="MAT 15:1-9">ማቶ. 15:1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1"/>የሩሳላመፕ የኤዝ ፈርሳውታይራ ፐቲ ፐቲ ህገ አስታማርታይ የሱሳ ካለ ሺቄዛ። <verse eid="MRK 7:1"/><verse number="2" style="v" sid="MRK 7:2"/>የሱሳ ታማርታይፕ ፐታይ ፐታይ ጌዠካ ኩሸር፥ የይካ ኩሸ ሜጭንተካዛር ካ ሚዝታ በኤዛ።<verse eid="MRK 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 7:3"/>ፈርሳውታይኔ አይሁድታይ አሲ ኡባይ ፋ አድታይ ዎጋይ ጋርክ ፋ ኩሸ ሎእ ሜጭንተካዛር ሞያ። <verse eid="MRK 7:3"/><verse number="4" style="v" sid="MRK 7:4"/>የይ ጋርክ፥ ኡንቲ ጋበፕ ማቂ ሜጨካዛር ሞያ። ማ ኡንቲ ፋ አድታይፕ ኤኬዝ ሀራ ጋመ ዎጋ የዛ፦ የይካ ዋንጫ፥ ኦታ፥ ብራታ ሚሸራ አርሳ ሜጭዝ ዎጋ ናግዛ።<verse eid="MRK 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5"/>ፈርሳውታይራኔ ህገ አስታማርታይ የሱሳ፥ «ነ ታማርታይ አብሶ አድታይ ዎጋ መን ፋ ኩሸ ሜጭንተካዛር ካ ሚዛይ?» ዬጊ ኦይጬዛ።<verse eid="MRK 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6"/>የሱሳ ኡንትኮ፥ «ናበ ኢሳያሳ ይንትስ ጩቢታይስ፥</para>
  <para style="q1" vid="MRK 7:6">« ‹Ꮊ አሳይ ታና ፋ እራን ኣዳር ቦንችዛ፥</para>
  <para style="q2" vid="MRK 7:6">ዝን ኡ ዎዝናይ ታፕ ሃኮ የዛ።<note caller="-" style="x"><char style="xo" closed="false">7:6-7 </char><char style="xt" closed="false"><ref loc="ISA 29:13">ኢሳ. 29:13</ref></char></note><verse eid="MRK 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7"/>አሲ ኮቼዝ ዎጋ ጾስ ህገ ኣዝሲ ታማርስዛ ግሾ</para>
  <para style="q2" vid="MRK 7:7">ኡ ታና ጨር ጎይንዛ› »</para>
  <para style="m" vid="MRK 7:7">ዬጊ ጻፌዛይ ቱሮ።<verse eid="MRK 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 7:8"/>«ይንቲ ጾስ ኪታ አሺ አስ ዎጋ ናግዛ» ዬጌዛ።<verse eid="MRK 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9"/>ማካ የሱሳ፥ «ይንቲ ይ ዎጋ ናጎዳይስ ግ ጾስ ኪታ ኦሊ አሼዛ <verse eid="MRK 7:9"/><verse number="10" style="v" sid="MRK 7:10"/>ሙሰ፥ ‹ነ አደኔ ነ እንዶ ቦንቾባ›፥ ማ ‹ፋ አዳኔ ዎይ ፋ እንዶ ጫዥዛይ Ꮊይቆዳይስ ቤዝዛ› ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">7:10 </char><char style="xt" closed="false"><ref loc="EXO 20:12">ከስ 20:12</ref>፤ <ref loc="NUM 5:16">ታይ. 5:16</ref>፤ <ref loc="EXO 21:17">ከስ 21:17</ref>፤ <ref loc="LEV 20:9">ለዊ. 20:9</ref></char></note> <verse eid="MRK 7:10"/><verse number="11" style="v" sid="MRK 7:11"/>ዝን ይ ዬግዛ ፐቲ አይ ፋ ኣዳ ዎይ ፋ እንዳቶ ማዶዳ አሺ፥ ‹Ꮊይ ጾሳ ያርሾ› ጊኮ፥ <verse eid="MRK 7:11"/><verse number="12" style="v" sid="MRK 7:12"/>ኤ ፋ ኣዳ ዎይ ፋ እንዳቶ ማዳም ጋርክ ይ ኡድዛ። <verse eid="MRK 7:12"/><verse number="13" style="v" sid="MRK 7:13"/>የይ ጋርክ፥ ይ Ꮊንክታ ታማርሴዝ ይ ዎጋይድ ጾሳ ቃላ ለቄዛ። የይ ጋርክ ሀራ ጋመ ባዝ ኦዛ» ዬጌዛ።<verse eid="MRK 7:13"/></para>
  <para style="s1">አስ ቱንስዛ ባዝ</para>
  <para style="r">(<ref loc="MAT 15:10-20">ማቶ. 15:10-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14"/>የሱሳ ጋመ አሳ ማካ ፋኮ ጼጊ፥ «ኡባይ ታ ኦድዛ ስኦይታኔ አካኮይታ። <verse eid="MRK 7:14"/><verse number="15" style="v" sid="MRK 7:15"/>አስ ዎዝናፕ ከዝዝ ባዝ አስ ቱንስዛፕ አትን ባለፕ አስ ኡሎ ገሊ አስ ቱንስዛ ባዝ አብካ ባያ። <verse eid="MRK 7:15"/><verse number="16" style="v" sid="MRK 7:16"/>ስእዝ ሀየር የዝ ኦንካ ስኦ» ዬጌዛ።<verse eid="MRK 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17"/>የሱሳ ጋመ አሳ ኦሊ አሺ ኬ ገልን ኤ ታማርታይ የ ኣዝሳይ ባጋ ኤዛ ኦይጬዛ። <verse eid="MRK 7:17"/><verse number="18" style="v" sid="MRK 7:18"/>ኤ ኡንትኮ፥ «ይንትስካ ማ ገለካሳ? ባለፕ አስ ጋንጨ ገልዛ ባዝ አብካ አስ ቱንሶዳይስ ዳንዳኦዛና አካኮሳኔ? <verse eid="MRK 7:18"/><verse number="19" style="v" sid="MRK 7:19"/>አብስ ጊኮ፥ ካ አስ ዶናር ኡሎ ጋንጨ ገሊ ኤዛይር ባለ ከዝዛይፕ አትን አስ ዎዝና ጋንጨ ገሎያ» ዬጌዛ። ኤዛይድ የሱሳ ካ ኡባይ ጌሺ ማቄዛና ኤርሴዛ።<verse eid="MRK 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20"/>ጉጅካ፥ የሱሳ፥ «አስ ቱንስዛ ባዝ አስ ዎዝና ጋንጨፕ ከዝዝ ባዚ። <verse eid="MRK 7:20"/><verse number="21" style="v" sid="MRK 7:21"/>አስ ዎዝና ጋንጨፕ ከዝዝ ባዝ ዎቦ ቆፋ፥ ላግታ፥ ካስቶ፥ አስ ዎ፥ <verse eid="MRK 7:21"/><verse number="22" style="v" sid="MRK 7:22"/>ላመ፥ ኢታ አሞት፥ ኢታት፥ ገነ፥ ቃይጸ፥ ዶሻ፥ ቅናተ፥ ጫሸ፥ ኡትራኔ ቦዛት። <verse eid="MRK 7:22"/><verse number="23" style="v" sid="MRK 7:23"/>Ꮊ ኢታ ባዝ ኡባይካ አስ ዎዝና ጋንጨፕ ከዚ አስ ቱንስዛ» ዬጌዛ።<verse eid="MRK 7:23"/></para>
  <para style="s1">ፐቲ አስቲ አማኖ</para>
  <para style="r">(<ref loc="MAT 15:21-28">ማቶ. 15:21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24"/>የሱሳ የይፕ ከዚ፥ ጽሮሳ ካታማ ካለ የዝ ጋደ Ꮊንጌዛ። ኤ ፐቲ ካራ ገሊ ኤዛይድ የዛና ኦንካ ኤሮድ ጋርክ ኮየካያ። ዝን ቆስንቲ ጋምኦዳይስ ዳንዳኤካያ። <verse eid="MRK 7:24"/><verse number="25" style="v" sid="MRK 7:25"/>ዝን እ ጽቃ ናአቶ ቱና አያና አይኬዝ ፐቲ አስታ የሱሳ ኦሳ ስኢ ኤልሲ ኤዝኮ ይኢ ኤ ቶካይል አፋ ዎዛ። <verse eid="MRK 7:25"/><verse number="26" style="v" sid="MRK 7:26"/>እዛ ግርከ አሲ፤ የልንቴዛይ ስሮፍንቀ ግዝ ቢታ። እዛ፥ ፋ ናአትፕ ቱና አያና ከሶዳይ ጋርክ የሱሳ ዎሴዛ።<verse eid="MRK 7:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 7:27"/>ዝን የሱሳ ማሂ፥ «ናእታይ ቲናቲ ካ ምዦ፤ ናእታይ ካ ኤኪ ካንታይስ ኦሎ ኮሾያ» ዬጌዛ።<verse eid="MRK 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28"/>አስታ ማቂ፥ «ታ ጎዳዮ የይ ቱማ፥ ዝን ሌማተ ካለ የዝ ካንታይ ናእታይፕ ዎዝ ጉፋ ሚነባይ» ዬጊ ማሄዛ።<verse eid="MRK 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29"/>የሱሳ ማ እዝኮ፥ «Ꮊ ነ ቃላይ ግሾስ ነ ካራ ቅቶባ፤ ቱና አያና ነ ናአትፕ ከዜዝ» ዬጌዛ።<verse eid="MRK 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30"/>እዛካ ፋ ካራ Ꮊንጎዳር ቱና አያና እ ናአትፕ ኬዝን አርሳል ዎይኤዛኖ ደንጌዛ።<verse eid="MRK 7:30"/></para>
  <para style="s1">የሱሳ ቱለኔ ሙመ አ ፓዛ</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31"/>የሱሳ ማ ጽሮሳ ካታማፕ ከዚ፥ ስዶናራነ ታጲ ካታምታ ግዝ ቢታር ኣ ጋልላ አባኮ Ꮊንጌዛ። <verse eid="MRK 7:31"/><verse number="32" style="v" sid="MRK 7:32"/>አሳይ ቱለኔ ደዳትዛ አስ የሱሳኮ ክኢ፥ ፋ ኩሸ ኤዛል አፋ ጋዶድ ጋርክ ኤዛ ዎሴዛ። <verse eid="MRK 7:32"/><verse number="33" style="v" sid="MRK 7:33"/>የሱሳ ኣዳ የ አ ጋመ አሳይፕ ጋጻ ከሲ፥ ፋ ብራ ኤ ሀያይድ ዳኬዛ። ማ የይፕ ጩቺ ጩቲ ኤ እራን ቦቼዛ። <verse eid="MRK 7:33"/><verse number="34" style="v" sid="MRK 7:34"/>ሳሎ ፉደ ቅ ግ ብኢ፥ ዎሲ፥ «ኤፍታህ» ጌዛ። ብልእይካ «ዶይንቶባ» ጉሲ። <verse eid="MRK 7:34"/><verse number="35" style="v" sid="MRK 7:35"/>አይ ሀያይ ኤልሲ ዶይንቴዛ፥ አጭንቴዝ እራንይካ ብልእንቴዛ፥ አይ ብልእንቲ ኦድንቴዛ።<verse eid="MRK 7:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 7:36"/>የሱሳ አሳይኮ፥ «Ꮊያ ኦስካ ኦድፓተ» ዬጌዛ። ዝን ኤ ሎእ ሚን ኦድፓተ ግን፥ አሳይ ኦዳ ገደ ዳልግሴዛ። <verse eid="MRK 7:36"/><verse number="37" style="v" sid="MRK 7:37"/>የያ ስኤዝ አስ ኡባይ ሎእ ማላባዝ ግ፥ «ኡባ ባዝ ኤ ሎእ ኦዛ። ሀራ አቶዝን፥ ቱለ ስስዛ፥ ሙመ ኦድስዛ» ዬጌዛ።<verse eid="MRK 7:37"/></para>
  <chapter eid="MRK 7"/>
  <chapter number="8" style="c" sid="MRK 8"/>
  <para style="s1">የሱሳ ኦይዲ ሙኩለ አሲ ሙዜዛ</para>
  <para style="r">(<ref loc="MAT 15:32-39">ማቶ. 15:32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1"/>ጽቃ ዎደፕ ጉየ፥ ጋመ አሳይ የሱሳኮ ሺቄዛ። አሳይስ ሚዝባዝ ብን የሱሳ ፋ ታማርታ ፋኮ ጼጊ፥ <verse eid="MRK 8:1"/><verse number="2" style="v" sid="MRK 8:2"/>«Ꮊ አሳይ ታር ሀይ ጋላስ ሄሎዳይስ ጋምኢ፥ አብካ ሚዝ ባዝ ደንገካዛይ ግሾስ ታና አሳይ ቃዛ። <verse eid="MRK 8:2"/><verse number="3" style="v" sid="MRK 8:3"/>ታ አሳ ናየር ካራ ዳካሚ፥ አሳይ Ꮊንግታር ኦገላ ዳቡሪ ፖኮዳ፥ ባጋ አሳይ ሃኮፕ የኤዛ» ዬጌዛ።<verse eid="MRK 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4"/>የሱሳ ታማርታይ ማሂ፥ «Ꮊ ሊዣይድ Ꮊ አሳ ኡባ ሙዞዳይስ ግድዛ ካ ደንጎዳይስ ዳንዳእዛይ ኦኖ?» ዬጌዛ።<verse eid="MRK 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5"/>የሱሳ ኡንትኮ፥ «ይንታር ኣፑን ሶሎ የኔ?» ዬጊ ኦይጬዛ።</para>
  <para style="p" vid="MRK 8:5">ኡ ማሂ፥ «ላፑን ሶሎ የዛ» ዬጌዛ።<verse eid="MRK 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6"/>የሱሳ አሳይ ሳአ በቶዳይ ጋርክ ኪቴዛ። ዬዜዛይፕ፥ ላፑን ሶሎ ኤኪ ጾስ ጋላቲ ማቂ የ ሶላ ዱር፥ አሳይስ ግሾድ ጋርክ ፋ ታማርታይስ እንጌዛ። ኤ ታማርታይ አሳይስ ግሼዛ። <verse eid="MRK 8:6"/><verse number="7" style="v" sid="MRK 8:7"/>ኡንትስ ማ ጽቃ ይሸ ሞልታይ የዛ። የሱሳ የ ሞልታይ ግሾስ ጾስ ጋላቲ፥ አሳይስ ግሾድ ጋርክ ፋ ታማርታ ኪቴዛ። <verse eid="MRK 8:7"/><verse number="8" style="v" sid="MRK 8:8"/>አሳይ ኡቢታይ ም ምዤዛ። ኤ ታማርታይ አቴዝ ጉፋ ላፑን ሌማተ ኩን ደንዛ። <verse eid="MRK 8:8"/><verse number="9" style="v" sid="MRK 8:9"/>ካ ሜዝ አሳይ ታይባይ ኦይዲ ሙኩለ ማቆዳ። የይፕ ጉየ፥ የሱሳ አሳ ዳኬዛ። <verse eid="MRK 8:9"/><verse number="10" style="v" sid="MRK 8:10"/>ኤ ማ ፋ ታማርታይር ኤል ዎጎሎ ጋንጨ ገሊ ዳልማኑታ ግንትዝ ቢታ ቅቴዛ።<verse eid="MRK 8:10"/></para>
  <para style="s1">ማላ ኦንቶዳይ ጋርክ ኦይጬዛ</para>
  <para style="r">(<ref loc="MAT 16:1-4">ማቶ. 16:1-4</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11"/>ፈርሳወ አስታይ ይኢ የሱሳ ፓጮዳይስ ኮዪ፥ ሳሎፕ ኡ ፋና ማላ ቤዞዳይ ጋርክ የሱሳር ፓላማ አይኬዛ።<note caller="-" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="MAT 12:38">ማቶ. 12:38</ref>፤ <ref loc="LUK 11:16">ሉቃ. 11:16</ref></char></note><verse eid="MRK 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 8:12"/>የሱሳ ሼምቲ፥ «Ꮊ ዎደ አሳይ አብስ ማላ ኮዬ? ታ ይንትስ ቱማ ኦድዛ፤ Ꮊ ዎደ አስስ አባ ማላካ እንግንቴና» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="MAT 12:39">ማቶ. 12:39</ref>፤ <ref loc="LUK 11:29">ሉቃ. 11:29</ref></char></note> <verse eid="MRK 8:12"/><verse number="13" style="v" sid="MRK 8:13"/>ኤ ኡንታን እዘ ኦሊ አሺ ማቂ ዎጎሎ ጋንጨ ገሊ አባይፕ ሰኮ ፕኖ ፒንጌዛ።<verse eid="MRK 8:13"/></para>
  <para style="s1">ፈርሳውታይኔ ሄሮዶሳ እርሾ</para>
  <para style="r">(<ref loc="MAT 16:5-12">ማቶ. 16:5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14"/>ኤ ታማርታይ ካ ኤኪ Ꮊሞ ዶጌዛ፤ ኡንትስ ዎጎላይ ጋንጨ ፐቲ ሶሎፕ ሀራ ካ ባያ። <verse eid="MRK 8:14"/><verse number="15" style="v" sid="MRK 8:15"/>የሱሳ ኡንትኮ፥ «ይንታን ኤሮይታ። ፈርሳውታይ እርሾፐኔ ሄሮዶሳ እርሾፕ ናግንቶይታ» ዬጊ አዛዜዛ።<note caller="-" style="x"><char style="xo" closed="false">8:15 </char><char style="xt" closed="false"><ref loc="LUK 12:1">ሉቃ. 12:1</ref></char></note><verse eid="MRK 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16"/>ኡንቲ ዎል ጋንጨ፥ «ኤ Ꮊያ ግዛይ ኑስ ሶሎ ባዛይ ግሾስ» ዬጌዛ።<verse eid="MRK 8:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17"/>የሱሳ ኡ ግዛና ኤሪ ኡንትኮ፥ «ይንትስ ሶሎ ባዛይ ግሾስ አብስ ኦድንቴ? Ꮊተካ ይ ኤሮሳ? ዎይ ይ አካኮሳ? ይ ዎዝናይ ዶጬኔ? <verse eid="MRK 8:17"/><verse number="18" style="v" sid="MRK 8:18"/>ይንትስ ኣፈ የዝን ቦኦሳ? ሀየ የዝን ስኦሳ? ይንትስ ዋይዚ አካክንቶሳ?<note caller="-" style="x"><char style="xo" closed="false">8:18 </char><char style="xt" closed="false"><ref loc="JER 5:21">ኤርም. 5:21</ref>፤ <ref loc="EZK 12:2">ኢዝቀ. 12:2</ref>፤ <ref loc="MRK 4:12">ማር. 4:12</ref></char></note> <verse eid="MRK 8:18"/><verse number="19" style="v" sid="MRK 8:19"/>ታ እችን ሶሎ እችን ሙኩለ አስስ ፔዝ ዎደ ኣፑን ሌማተ ኩን ጉፋ ደንኔ?» ዬጌዛ።</para>
  <para style="p" vid="MRK 8:19">ኡንትካ፥ «ታጶ ናምኢ ሌማተ ኩን» ዬጌዛ።<verse eid="MRK 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20"/>«የይ ጋርክ፥ ታ ላፑን ሶሎ ኦይዲ ሙኩለ አስስ ፔን ኣፑን ሌማተ ኩን ጉፋ ደንኔ?» ዬጌዛ።</para>
  <para style="p" vid="MRK 8:20">ኡንቲ፥ «ላፑን ሌማተ ኩን ደንዛ» ዬጌዛ።<verse eid="MRK 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21"/>የዝን፥ «Ꮊተካ ይንትስ ቆፍንቶሳ?» ዬጌዛ።<verse eid="MRK 8:21"/></para>
  <para style="s1">የሱሳ ቤተሳይዳ ፐቲ ኣፈ ቶአ ፓዛ</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22"/>ኡንቲ ቤተሳይዳ ካታማ Ꮊንጌዛ። ጽቃ አስታይ ቶአ አ የሱሳኮ ክኢ የ አ ቦቾድ ጋርክ ኤዛ ዎሴዛ። <verse eid="MRK 8:22"/><verse number="23" style="v" sid="MRK 8:23"/>የሱሳ ቶአ አይ ኩሻ አይኪ ካታማፕ ጋጻ ከሴዛ። ኤ ኣፋተ ጩቲ ፋ ኩሻ ኤዛል አፋ ጋዲ፥ «ኔስ አኮ በንትኔ?» ዬጊ ኦይጬዛ።<verse eid="MRK 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24"/>አይ ቅ ግ ብኢ፥ «ታስ አሳይ በንትዛ፥ ዝን አሳይ የታር ም ኣዝዛ» ዬጌዛ።<verse eid="MRK 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25"/>የይፕ ጉየ፥ የሱሳ ማሂ፥ አይ ኣፋይል ፋ ኩሸ ጋዴዛ። አይ ሎእ በኤዛ፥ ኤ ኣፋይ ፓጼዛ፥ ኡባ ባዝ ምልጽ ኡዲ በኤዛ። <verse eid="MRK 8:25"/><verse number="26" style="v" sid="MRK 8:26"/>የሱሳ አይኮ፥ «ነ ካራ ቅቶባ፥ ካታማ Ꮊንግፐ» ዬጊ ኪቴዛ።<verse eid="MRK 8:26"/></para>
  <para style="s1">ጵጽሮሳ አማኖኔ ማርካት</para>
  <para style="r">(<ref loc="MAT 16:13-20">ማቶ. 16:13-20</ref>፤ <ref loc="LUK 9:18-21">ሉቃ. 9:18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27"/>የሱሳ ፋ ታማርታይር ቅሳረ ፍልጶሳ ካለ የዝ ሄራ Ꮊንጌዛ። ኡ Ꮊማዳር ኦገል አፋ የሱሳ፥ «ታና አሳይ ኦና ግነሻ?» ዬጊ ፋ ታማርታ ኦይጬዛ።<verse eid="MRK 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28"/>ኤ ታማርታይ፥ «ፐቲ ፐቲ አሳይ ነና፥ ‹ጻማቅዛ ዋንሳ› ግዛ፤ Ꮊንክታይ፥ ‹ኤላሳ ግዛ› ማ Ꮊንክታይ፥ ‹ናብታይፕ ፐታ› ግዛ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">8:28 </char><char style="xt" closed="false"><ref loc="MRK 6:14">ማር. 6:14</ref></char></note><verse eid="MRK 8:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29"/>የሱሳ ኡንትኮ፥ «የዝን ይ ታና ኦና ጌ?» ዬጊ ኦይጬዛ።</para>
  <para style="p" vid="MRK 8:29">ጵጽሮሳ፥ «ነ ክርስቶሳ» ዬጊ ማሄዛ።<verse eid="MRK 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30"/>የሱሳ፥ «ታባጋ ኦስካ ኦዳማይ ጋርክ ናግንቶይታ» ዬጊ ኡንታን አዛዜዛ።<verse eid="MRK 8:30"/></para>
  <para style="s1">የሱሳ ፋና ሄሎድ መቶኔ ዋያ ኦዴዛ</para>
  <para style="r">(<ref loc="MAT 16:21-28">ማቶ. 16:21-28</ref>፤ <ref loc="LUK 9:22-27">ሉቃ. 9:22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31"/>የሱሳ ፋ ታማርታይኮ፥ «አስ ናአይ፥ ጋመ መቶ ኤኮዳይስ ቤዝዛ፤ ጭምታይ፥ ቄሰ ሀላቅታይኔ ህገ አስታማርታይ ኤዛ እጾዳይስ ቤዝዛ። ኡንቲ ኤዛ ዎዳይስኔ ሀይ ጋላሳፕ ጉየ፥ ኤ Ꮊይቆፕ ደንዶዳይስ ቤዝዛ» ዬጊ ኡንታን ታማርሴዛ። <verse eid="MRK 8:31"/><verse number="32" style="v" sid="MRK 8:32"/>ኤ የያ ኡንትስ ጌሺ ኦዴዛ። ጵጽሮሳ ኣዳ ፐቲ ባጋ ኣ ካጬዛ።<verse eid="MRK 8:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 8:33"/>ዝን የሱሳ ጉየ ማቂ፥ ፋ ታማርታ ብኢ፥ ጵጽሮሳር ካጭንቲ፥ «Ꮊ ጻላሃዮ፥ ታፕ ሃኮባ። ነ አሲ ዶስዝባዝ ቆፕዛፕ አትን ጾስ ዶስዝባዝ ቆፖያ» ዬጌዛ።<verse eid="MRK 8:33"/></para>
  <para style="s1">የሱሳ ካሎዳይስ ፋና ካዶ ኮሽዛ</para>
  <para style="r">(<ref loc="MAT 10:38-39">ማቶ. 10:38-39</ref>፤ <ref loc="MAT 16:24-28">16:24-28</ref>፤ <ref loc="LUK 9:23-27">ሉቃ. 9:23-27</ref>፤ <ref loc="LUK 14:26-27">14:26-27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34"/>ማካ የሱሳ ጋመ አስታይራ ፋ ታማርታ ፋኮ ጼጊ፥ «ታና ካሎዳይስ ኮይዝ ኦንካ ፋና ካዶ፤ ፋ ማዝቃላና ቶኪ ታና ካሎ።<note caller="-" style="x"><char style="xo" closed="false">8:34 </char><char style="xt" closed="false"><ref loc="MAT 10:38">ማቶ. 10:38</ref>፤ <ref loc="LUK 14:27">ሉቃ. 14:27</ref></char></note> <verse eid="MRK 8:34"/><verse number="35" style="v" sid="MRK 8:35"/>ፋ ሸምፖ አሾዳይስ ኮይዝ አይ ብስዛ። ዝን ታ ግሾኔ ዎንግለ ግሾስ ፋ ሸምፖ ብስዛ አይ አሽዛ።<note caller="-" style="x"><char style="xo" closed="false">8:35 </char><char style="xt" closed="false"><ref loc="MAT 10:39">ማቶ. 10:39</ref>፤ <ref loc="LUK 17:33">ሉቃ. 17:33</ref>፤ <ref loc="JHN 12:25">ዋን. 12:25</ref></char></note> <verse eid="MRK 8:35"/><verse number="36" style="v" sid="MRK 8:36"/>አሲ ሳአል የዝ ሻሎ ኡባ ደንጊ ፋ ሸምፖ ብስኮ ኤዛ አብ አዶዴ? <verse eid="MRK 8:36"/><verse number="37" style="v" sid="MRK 8:37"/>አሲ ፋ ሸምፖ ዎዞዳይስ አብ እንጎዳይስ ዳንዳኤ? <verse eid="MRK 8:37"/><verse number="38" style="v" sid="MRK 8:38"/>ጾስ አማኖዋ Ꮊ ኢታ የለትይድ፥ አሲ ታላኔ ታ ቃላይድ ዬላትኮ፥ አስ ናአይ፥ ፋ አዳይ ቦንቻይር ጌሽ ኪታንችታይር ይእታር ኤ ባጋር ዬላቶዳ» ዬጌዛ።<verse eid="MRK 8:38"/></para>
  <chapter eid="MRK 8"/>
  <chapter number="9" style="c" sid="MRK 9"/>
  <para style="s1">የሱሳ ጭራይ ላምንቴዛ</para>
  <para style="r">(<ref loc="MAT 17:1-13">ማቶ. 17:1-13</ref>፤ <ref loc="LUK 9:28-36">ሉቃ. 9:28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1"/>የሱሳ ኡንትኮ፥ «ታ ይንትስ ቱሮ ኦድዛ፤ ጾስ ካተትይ ዎልቃር ይእዛና በኤካዛር Ꮊይቃም ፐቲ ፐቲ አሳይ Ꮊይዳ የዛ» ዬጌዛ።<verse eid="MRK 9:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2"/>የሱሳ ኡሱፑን ጋላሳፕ ጉየ፥ ፓር ጵጽሮሳራ፥ ያይቆባራ ዋንሳራ ኣዳ ኤኪ ዳማ አምባል አፋ ከሲ ኡ ቲናይድ ላምንቴዛ።<note caller="-" style="x"><char style="xo" closed="false">9:2-7 </char><char style="xt" closed="false"><ref loc="2PE 1:17-18">2ጵጽ. 1:17-18</ref></char></note> <verse eid="MRK 9:2"/><verse number="3" style="v" sid="MRK 9:3"/>ኤ አፍላይካ ፎጭዛ፤ ሳአ አፍላ ሜጭዛ ኦንካ ጌሾዳይስ ዳንዳኦዛይ ጋርክ ሙልጽ ግ ቦጼዛ። <verse eid="MRK 9:3"/><verse number="4" style="v" sid="MRK 9:4"/>የ ዎደ ኤላሳራ ሙሰራ የሱሳር ዎላ ናሾዳር በኤዛ።<verse eid="MRK 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 9:5"/>ጵጽሮሳ የሱሳኮ፥ «አስታማራዮ፥ ኑኒ Ꮊይዳ የዜዛኮ ኑስ ሎኦ፤ ኑ ሀይ ሻቃራ ፐታ ኔስ፥ ፐታ ሙሰስ፥ ማ ፐታ ኤላሳስ አጮዳ» ዬጌዛ። <verse eid="MRK 9:5"/><verse number="6" style="v" sid="MRK 9:6"/>Ꮊንክታይ ኢታ ያሽቴዝ ግሾ ጵጽሮሳ አብ ግዛኮካ ኤረካያ።<verse eid="MRK 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7"/>የይፕ ጉየ፥ ሻራ ይኢ ኡንታን ጎልን ሻራይ ጋንጨፕ፥ «Ꮊይ ታ ቃዛ፥ ታ ናአያ፥ ኤ ግዝ ባዝ ስኦይታ» ግዝ ቃላ የኤዛ። <verse eid="MRK 9:7"/><verse number="8" style="v" sid="MRK 9:8"/>ኤልሲ ኡ ዩዪ በአዳር የሱሳፕ አትን ሀራ ኦናካ ፋ ካለ ኡ በኤካያ።<note caller="-" style="x"><char style="xo" closed="false">9:8 </char><char style="xt" closed="false"><ref loc="MAT 3:17">ማቶ. 3:17</ref>፤ <ref loc="MRK 1:11">ማር. 1:11</ref>፤ <ref loc="LUK 3:22">ሉቃ. 3:22</ref></char></note><verse eid="MRK 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9"/>ኡንቲ አምባላፕ ዎዳር፥ የሱሳ ኡንትኮ፥ «አስ ናአይ፥ Ꮊይቆፕ ደንዶድ ጋ፥ ይ በኤዝ ባዝ ኦስካ ኦድፓተ» ዬጊ አዛዘዛ።<verse eid="MRK 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 9:10"/>ኤ አዛዜዛና ኡ፥ «ኤሮ» ዬጊ፥ «Ꮊ Ꮊይቆፕ ደንዶ ጉሳይ አብ ጉሶ» ዬጊ፥ ፋ ጋንጨር ዎላ ኦድንቴዛ።<verse eid="MRK 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 9:11"/>ኡ ማቂ፥ «ህገ አስታማርታይ፥ ‹ኤላሳ ቲናቲ የኦዳይስ ቤዝዛ› አብስ ጌ?» ዬጊ ኦይጬዛ።<note caller="-" style="x"><char style="xo" closed="false">9:11 </char><char style="xt" closed="false"><ref loc="MAL 4:5">ሚል. 4:5</ref>፤ <ref loc="MAT 11:14">ማቶ. 11:14</ref></char></note><verse eid="MRK 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12"/>የሱሳ ማሂ «ኤላሳ ቲናቲ ይኢ፥ ኡባ ባዝ ሎእዛ፤ የዝን፥ አብስ ጌሻ ማጻፋይ፥ ‹አስ ናአይ ዴጾ መቶ ኤኮዳኔ ለቅንቶዳ› ዬጊ ጻፌዛይ ዋፋ? <verse eid="MRK 9:12"/><verse number="13" style="v" sid="MRK 9:13"/>ዝን ታ ይንትስ ኦድዛ፤ ኤላሳ ካሰ የኤዛ፤ ማ ኤ ባጋ ጌሻ ማጻፋይድ ጻፍንቴዛይ ጋርክ፥ አሳይ ኤዛል አፋ ፋ ኮዬዝ ባዝ ኡባ ኦዛ» ዬጌዛ።<verse eid="MRK 9:13"/></para>
  <para style="s1">የሱሳ ቱና አያና አይኬዝ ናአ ፓዛ</para>
  <para style="r">(<ref loc="MAT 17:14-21">ማቶ. 17:14-21</ref>፤ <ref loc="LUK 9:37-43">ሉቃ. 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14"/>የሱሳራኔ ሀይ ኤ ታማርታይ አቴዝታይኮ ማቂ የኦዳር ጋመ አስ ኡ ላንቃይድ በቴዝታኔ ህገ አስታማርታይ ኡንታር ፓላምዛና በኤዛ። <verse eid="MRK 9:14"/><verse number="15" style="v" sid="MRK 9:15"/>የ ጋመ አሳይ የሱሳ በኤዝ ዎደ ዳጋማር ማላባዝ ግ፥ ኤልሲ ኤዝኮ ላሲ ይኢ፥ ኤዛ ሳሮዛ። <verse eid="MRK 9:15"/><verse number="16" style="v" sid="MRK 9:16"/>የሱሳ ህገ አስታማርታይኮ፥ «ኡንታር ፓላምዛይ አብሶ?» ዬጊ ኦይጬዛ።<verse eid="MRK 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17"/>የ ዎይታይ ጋንጨፕ ፐቲ አይ ማቂ፥ «አስታማራዮ፥ ታ ናአይል አፋ ፖጎዳ ካይዝ ቱና አያና የዛ ግሾስ ኤዛ ታ ኔኮ ከኤዛ። <verse eid="MRK 9:17"/><verse number="18" style="v" sid="MRK 9:18"/>ያ አያናይ ደንዴዝ ዎደ፥ ኤዛ ሾጪ ኦሊ፤ ዶናይር ጋፑንቶ ክኢ፤ አች ጮንቺ፤ ጋላ ዛብሲ ጋምን ከሶዳይ ጋርክ ነ ታማርታይስ ኦድን፥ ኡ ከሶዳይስ ዳንዳኤካያ» ዬጌዛ።<verse eid="MRK 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19"/>የሱሳ ማሂ ኡንትኮ፥ «አማኖዋ Ꮊ ላይ አስታዮ! ታኒ ይንታር አይደ ሄሎዳይስ የዞዴ? ማ ይንታን አይደ ሄሎዳይስ ዳንዳኦዴ? ናአ ታኮ Ꮊና ኤኪ የኦይታ» ዬጌዛ። <verse eid="MRK 9:19"/><verse number="20" style="v" sid="MRK 9:20"/>ኡንቲ ናአ ኤዝኮ ከኤዛ፤ የ ቱና አያናይ የሱሳ በኤዛን ጋርክ ናአ ኩኩርሲ፤ ፖክሲ፥ ዶናር ጋፑንቶ ክእ አይኬዛ። <verse eid="MRK 9:20"/><verse number="21" style="v" sid="MRK 9:21"/>የሱሳ የ ናአይ አዳይኮ፥ «Ꮊ ነ ናአ አይኬዛይፕ ኣፑን ላይ ማቆደ?» ዬጊ ኦይጬዛ።</para>
  <para style="p" vid="MRK 9:21">ናአይ አዳይ፥ «ኤ ዱደዝን አይኬዛ። <verse eid="MRK 9:21"/><verse number="22" style="v" sid="MRK 9:22"/>ኤዛ ዎዳይስ ጋመ ዎደ ታማ ጋንጨኔ ሃ ጋንጨ ኦልዛ፥ ዝን ነ ዳንዳእኮ፥ ኑስ ቃየ፥ ኑና ማዶየ» ዬጌዛ።<verse eid="MRK 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23"/>የሱሳ፥ « ‹ነ ዳንዳእኮ ግኔ?› አማንዛ ኦስካ ኡባ ባዝ ዳንዳእንትዛ» ዬጌዛ።<verse eid="MRK 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24"/>ኤልሲ ናአይ አዳይ ፋ ቃላ ቅ ኡዲ፥ «ታ አማንዛ፥ ዝን ጉጂ አማኖዳይ ጋርክ ታና ማዶየ» ዬጌዛ።<verse eid="MRK 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25"/>የሱሳ አሳይ ጋንጊ ጋንጊ Ꮊንግዛና ብኢ፥ ቱና አያና፥ «Ꮊ ቱለኔ ሙመ አያናዮ፥ Ꮊ ናአይፕ ከዞባ ነና ታ አዛዝዛ፤ ማ ናምእን ማቂ ኤዛል ገልፐ» ዬጌዛ።<verse eid="MRK 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26"/>የ ቱና አያናይ ኡኪ፥ ናአ ኢታ ኩኩርሲ፥ ኤዛፕ ከዜዝ። ናአይ Ꮊይቄዛ ኣዝን፥ ጋመ አሳይ፥ «ናአይ Ꮊይቄዛ» ዬጌዛ። <verse eid="MRK 9:26"/><verse number="27" style="v" sid="MRK 9:27"/>ዝን የሱሳ ናአይ ኩሻ አይኪ ደንን፥ ናአይ ደንዲ ኤቄዛ።<verse eid="MRK 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28"/>የሱሳ ካራ ገሌዛይፕ ጉየ ኤ ታማርታይ፥ «ኑኒ የ ቱና አያና ከሶዳይስ አብስ ዳንዳኤካሳ?» ዬጊ የሱሳ ኣዳ ኦይጬዛ።<verse eid="MRK 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29"/>የሱሳ ማሂ፥ «የይ ጋርከዛይ ዎሳራኔ [ጾማራፕ] አትን ሀራባዛር ከዞዳይስ ዳንዳኦያ» ዬጌዛ።<verse eid="MRK 9:29"/></para>
  <para style="s1">የሱሳ ፋ Ꮊይቃኔ ደንዳ ማሂ ኦዴዛ</para>
  <para style="r">(<ref loc="MAT 17:22-23">ማቶ. 17:22-23</ref>፤ <ref loc="LUK 9:43-45">ሉቃ. 9:43-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30"/>ኡንቲ የ በሳይፕ ደንዲ፥ ጋልላር ኣ Ꮊንጌዛ፤ የሱሳ ፋ የዛበሳ ኦንካ ኤሮድ ጋርክ ኮየካያ። <verse eid="MRK 9:30"/><verse number="31" style="v" sid="MRK 9:31"/>ኤ ፋ ታማርታይኮ፥ «አስ ናአ፥ አሲ አስታይ ኩሸ ኣ እማዳኔ ዎዳ፤ ኤ ሀይ ጋላሳፕ ጉየ፥ Ꮊይቆፕ ደንዶዳ» ዬጊ ታማርሴዛ።<verse eid="MRK 9:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 9:32"/>ዝን ኡንትስ ኤ ጌዛይ ገለካያ፤ ማ ኤዛ ኦይጮዳይስካ ያሽቴዛ።<verse eid="MRK 9:32"/></para>
  <para style="s1">ኡባፕ ኣዛይ ኦኖ?</para>
  <para style="r">(<ref loc="MAT 18:1-5">ማቶ. 18:1-5</ref>፤ <ref loc="LUK 9:46-48">ሉቃ. 9:46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33"/>ኡንቲ ቅፍርናሆመ ካታማ Ꮊንጊ ካራ ገሌዛይፕ ጉየ የሱሳ ኡንትኮ፥ «ኦገል ይ አብስ ፓላምንቴ?» ዬጊ ኦይጬዛ። <verse eid="MRK 9:33"/><verse number="34" style="v" sid="MRK 9:34"/>ዝን ኡ፥ «ኑ ጋንጨ ኡባፕ ኣዳይ ኦኖ?» ዬጊ ፓላሜዝ ግሾስ ስኤ ጌዛ።<note caller="-" style="x"><char style="xo" closed="false">9:34 </char><char style="xt" closed="false"><ref loc="LUK 22:24">ሉቃ. 22:24</ref></char></note> <verse eid="MRK 9:34"/><verse number="35" style="v" sid="MRK 9:35"/>የሱሳ በቲ፥ ታጶ ናምኢ ታማርታ ጼጊ፥ «ኦንካ ቲና ኣዳይስ ኮይኮ፥ ኡባፕ ጉየ ኣ፥ ኡባይስ አይለ ማቆዳይስ ቤዝዛ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="MAT 20:26">ማቶ. 20:26</ref></char></note><verse eid="MRK 9:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 9:36"/>ፐቲ ጽቃ ናአ ኤኪ፥ ኡ ጋንጨ ኤሴዛ፤ የ ጽቃ ናአ እድንጊ ኡንትኮ፥ <verse eid="MRK 9:36"/><verse number="37" style="v" sid="MRK 9:37"/>«Ꮊይ ጋርክ ጽቃ ናእታይፕ ፐታ ታ ሱንይር ሞክዛ ኦንካ ታና ሞክዛ፤ ማ ታና ሞክዛ ኦንካ ታና ኪቴዛናካ ሞክዛፕ አትን ታ ኣዳ ሞኮያ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">9:37 </char><char style="xt" closed="false"><ref loc="MAT 10:40">ማቶ. 10:40</ref>፤ <ref loc="LUK 10:16">ሉቃ. 10:16</ref>፤ <ref loc="JHN 13:20">ዋን. 13:20</ref></char></note><verse eid="MRK 9:37"/></para>
  <para style="s1">ኑና እጾዋ ኡባይ ኑ ባጋ</para>
  <para style="r">(<ref loc="LUK 9:49-50">ሉቃ. 9:49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38"/>ዋንሳ፥ «አስታማራዮ፥ ፐቲ አሲ ነ ሱንር ቱና አያንታ ከሶዳር ኑ ብኢ፥ ኑ ባጋ ማቀካ ግሾስ ኤዛ ካዬዛ» ዬጌዛ።<verse eid="MRK 9:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39"/>ዝን የሱሳ፥ «ኦንካ ታ ሱንር ጾሲ ኦዝ ማላታ ባዝ ኦ፥ ኤልሲ ታል አፋ ኢታ ባዝ ኦድንቶዳይስ ዳንዳእዛይ ባ ግሾስ ካይፓተ። <verse eid="MRK 9:39"/><verse number="40" style="v" sid="MRK 9:40"/>ኑባዝ እጾዋ ኡቢታይ ኑ ባጋ።<note caller="-" style="x"><char style="xo" closed="false">9:40 </char><char style="xt" closed="false"><ref loc="MAT 12:30">ማቶ. 12:30</ref>፤ <ref loc="LUK 11:23">ሉቃ. 11:23</ref></char></note> <verse eid="MRK 9:40"/><verse number="41" style="v" sid="MRK 9:41"/>ታ ይንትስ ቱሮ ኦድዛ፤ ይ ታስታ ማቄዝ ግሾስ ኦንካ ይንትስ ታ ሱንር ሀለ ሃ ኡዦዳይስ እንግኮካ፥ ፋ ጋተ ባሚ።<note caller="-" style="x"><char style="xo" closed="false">9:41 </char><char style="xt" closed="false"><ref loc="MAT 10:42">ማቶ. 10:42</ref></char></note><verse eid="MRK 9:41"/></para>
  <para style="s1">ሀራስ በ ማቅፕ ናግንቶ</para>
  <para style="r">(<ref loc="MAT 18:6-9">ማቶ. 18:6-9</ref>፤ <ref loc="LUK 17:1-2">ሉቃ. 17:1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42"/>«ታና አማንዛ Ꮊ ጽቅታይፕ ፐታ ባልዳይፕ ኦንካ፥ ዳማ ዎጻ ፋ ቆል አጪ፥ አባ ጋንጨ ዎዛኮ ኤስ ሎኦዳ። <verse eid="MRK 9:42"/><verse number="43" style="v" sid="MRK 9:43"/>ነ ኩሻይ ነና ባልኮ፥ ጋቺ ኦሎባ። ኔኒ ናምኢ ኩሸር ቶኦዋ ጋናመ ታማ ጋንጨ ዎዛይፕ፥ ዱጻ ኩሸር መና ደኦ ገሎ ኔስ ሎኦዳ። <verse eid="MRK 9:43"/><verse number="44" style="v" sid="MRK 9:44"/>ጋናመ ጉጽነካ Ꮊይቆዋ፥ ታማይካ ቶኦዋ አቆ።<note caller="-" style="x"><char style="xo" closed="false">9:43-44 </char><char style="xt" closed="false"><ref loc="MAT 5:30">ማቶ. 5:30</ref></char></note> <verse eid="MRK 9:44"/><verse number="45" style="v" sid="MRK 9:45"/>ነ ቶካይ ነና ባልኮ፥ ጋቺ ኦሎባ። ነ ናምኢ ቶከር ጋናመ ታማ ጋንጨ ዎዛይፕ፥ ዎቦ ማቂ ደኦ ገልዛኮ ኔስ ሎኦ። <verse eid="MRK 9:45"/><verse number="46" style="v" sid="MRK 9:46"/>ጋናመ ጉጽነ Ꮊይቆዋ፥ ታማይካ ቶኦዋ አቆ። <verse eid="MRK 9:46"/><verse number="47" style="v" sid="MRK 9:47"/>ነ ኣፋይ ነና ባልኮ፥ ዎጪ ከሲ ኦሎባ። ነ ናምኢ ኣፈር ጋናመ ታማ ጋንጨ ዎዛይፕ፥ ፐቲ ኣፈር ጾስ ካተት ገልዛኮ ኔስ ሎኦ።<note caller="-" style="x"><char style="xo" closed="false">9:47 </char><char style="xt" closed="false"><ref loc="MAT 5:29">ማቶ. 5:29</ref></char></note> <verse eid="MRK 9:47"/><verse number="48" style="v" sid="MRK 9:48"/>ጋናመ ጉጽናይ Ꮊይቆዋ፥ ታማይካ ቶኦዋ አቆ።<note caller="-" style="x"><char style="xo" closed="false">9:48 </char><char style="xt" closed="false"><ref loc="ISA 66:24">ኢሳ. 66:24</ref></char></note><verse eid="MRK 9:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49"/>«ያርሾ ማጽነር ኦንትዛይ ጋርክ አሲ ኡባይ ታማር ሀርቅንቶዳ። <verse eid="MRK 9:49"/><verse number="50" style="v" sid="MRK 9:50"/>ማጽነ ሎኦ፥ ዝን ማልአም እጽኮ፥ ማቂ ዋይዚ ማልእደ? ይንታር ማጽነ የዞ። ዬዚ ፐታይ ፐታይር ሳሮ የዞይታ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">9:50 </char><char style="xt" closed="false"><ref loc="MAT 5:13">ማቶ. 5:13</ref>፤ <ref loc="LUK 14:34">ሉቃ. 14:34</ref></char></note><verse eid="MRK 9:50"/></para>
  <chapter eid="MRK 9"/>
  <chapter number="10" style="c" sid="MRK 10"/>
  <para style="s1">ማቾ አንጆዳይስ ቤዞያ</para>
  <para style="r">(<ref loc="MAT 19:1-2">ማቶ. 19:1-2</ref>፤ <ref loc="LUK 16:18">ሉቃ. 16:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1"/>የሱሳ የይፕ ደንዲ፥ ይሁዳ ቢታ Ꮊንጊ ዮርዳኖሳ ቦርካ ፒንጌዛ። ጋመ አሳይ ማቂ ኤዝኮ ሺቅን፥ ካሴሳይ ጋርክ ያ አሳ ታማርሴዛ።<verse eid="MRK 10:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2"/>ፈርሳወ አሳፕ ፋጮዳይስ ኮዪ የሱሳ፥ «ፐቲ አስ ፋ ማቻቶ አንጆድ ጋርክ ሙሰ ህጋይ ኪትኔ?» ዬጊ ኤዛ ኦይጬዛ።<verse eid="MRK 10:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3"/>ኤ ማሂ፥ «ሙሰ ይንታን ካሰ ዋጊ ኪቴኔ?» ዬጌዛ።<verse eid="MRK 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4"/>ኡንቲ፥ «ሙሰ፥ ‹ፐቲ አሲ ፋ ማቻትስ አንጆ ዋርቃተ እንጊ ዳኮ› ጌዛ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">10:4 </char><char style="xt" closed="false"><ref loc="NUM 24:1">ታይ. 24:1</ref></char></note><verse eid="MRK 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5"/>የሱሳ ማሂ፥ ኡንታን «ይ ዎዝናይ ሚን ማቄዝ ግሾስ ሙሰ Ꮊ አዛዛ ይንትስ ጻፌዛ። <verse eid="MRK 10:5"/><verse number="6" style="v" sid="MRK 10:6"/>ዝን ጾሳይ ቲና መታር ራራ ማቻር ኡዲ፥ መዛ።<note caller="-" style="x"><char style="xo" closed="false">10:6 </char><char style="xt" closed="false"><ref loc="GEN 1:27">መ. 1:27</ref>፤ <ref loc="GEN 5:1">5:1</ref></char></note> <verse eid="MRK 10:6"/><verse number="7" style="v" sid="MRK 10:7"/>የይ ግሾስ፥ ፐቲ አሲ ፋ አደኔ ፋ እንዶ አሺ፥ ፋ ማቻትር ዎላ ማድንትዛ።<note caller="-" style="x"><char style="xo" closed="false">10:7-8 </char><char style="xt" closed="false"><ref loc="GEN 2:24">መ. 2:24</ref></char></note> <verse eid="MRK 10:7"/><verse number="8" style="v" sid="MRK 10:8"/>ኡ ናምእታይ ፐቲ አሾ ማቅዛ፤ Ꮊይፕ፥ ኡ ፐቲ አሾ ማቆዳይፕ አትን ናምኤ ማቆያ። <verse eid="MRK 10:8"/><verse number="9" style="v" sid="MRK 10:9"/>የይ ግሾስ፥ ጾሳይ ዎላል ዋጼዛና አሲ ሻክፐ» ዬጌዛ።<verse eid="MRK 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10"/>ኡ ካራ ማቄዝ ዎደ ኤ ታማርታይ Ꮊ ኦዳይ ባጋ የሱሳ ናምእን ኦይጬዛ። <verse eid="MRK 10:10"/><verse number="11" style="v" sid="MRK 10:11"/>የሱሳ ኡንትኮ፥ «ፋ ማቻቶ አንጂ ሀራ ኤክዝ ኦንካ ላምዛ።<note caller="-" style="x"><char style="xo" closed="false">10:11-12 </char><char style="xt" closed="false"><ref loc="MAT 5:32">ማቶ. 5:32</ref>፤ <ref loc="1CO 7:10-11">1ቆሮ. 7:10-11</ref></char></note> <verse eid="MRK 10:11"/><verse number="12" style="v" sid="MRK 10:12"/>ማ ማቻታካ ፋ አዝናይፕ ከዚ ሀራ ኣዝን ገልኮ ላምዛ» ዬጌዛ።<verse eid="MRK 10:12"/></para>
  <para style="s1">የሱሳ ዱደ ናእታ አንጄዛ</para>
  <para style="r">(<ref loc="MAT 19:13-15">ማቶ. 19:13-15</ref>፤ <ref loc="LUK 18:15-17">ሉቃ. 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13"/>የሱሳ ዱደ ናእታ ቦቾድ ጋርክ፥ ፐቲ ፐቲ አሳይ ናእታ ኤዝኮ ክእዛ፥ ዝን ኤ ታማርታይ የ አስታ ካጬዛ። <verse eid="MRK 10:13"/><verse number="14" style="v" sid="MRK 10:14"/>የሱሳ የያ ብኢ፥ ፋ ታማርታ ጋይሌዛ፤ ኡንትኮ፥ «ዱደ ናእታይ ታኮ ይእዛና ካይፓተ፤ ጾስ ካተትይ Ꮊይትታይ ጋርከዝታይሲ። <verse eid="MRK 10:14"/><verse number="15" style="v" sid="MRK 10:15"/>ታ ይንትስ ቱሮ ኦድዛ፤ ጾስ ካተት ዱደ ናአ ጋርክ ኤኮዋ አስ ኦንካ የ ካተት ኡባራካ ገላሚ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="MAT 18:3">ማቶ. 18:3</ref></char></note> <verse eid="MRK 10:15"/><verse number="16" style="v" sid="MRK 10:16"/>የይፕ ጉየ ዱደ ናእታ እድንጊ፥ ፋ ኩሸ ኡንታል አፋ ጋዲ አንጄዛ።<verse eid="MRK 10:16"/></para>
  <para style="s1">ዱረትኔ ጾስ ካተት</para>
  <para style="r">(<ref loc="MAT 19:16-30">ማቶ. 19:16-30</ref>፤ <ref loc="LUK 18:18-30">ሉቃ. 18:18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17"/>የሱሳ Ꮊንጎዳይስ ከዞዳራ ፐቲ አይ ላሲ ይኢ፥ ኤ ቲናይድ ቡንቂትድነ፥ «ኬሃ አስታማራዮ፥ መናስ ደኦ ላቶዳይስ ታ አብ ኦ?» ዬጊ ኦይጬዛ።<verse eid="MRK 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18"/>የሱሳ፥ «አብስ ታና ኬሃዮ ግ ጼጌ? ጾስ ኣዳፕ አትን ሀራ ኬሃ ኦንካ ባያ። <verse eid="MRK 10:18"/><verse number="19" style="v" sid="MRK 10:19"/>ጾሳ ኪታይ፥ ዎፐ፤ ላምፐ፤ ካስትፐ፤ ዎርዶ ማርካትፐ፤ ዶሽፐ፤ ነ አደኔ ነ እንዶ ቦንቾባ ዬግዛና ነ ኤርዛ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">10:19 </char><char style="xt" closed="false"><ref loc="EXO 20:12-16">ከስ 20:12-16</ref>፤ <ref loc="NUM 5:16-20">ታይ. 5:16-20</ref></char></note><verse eid="MRK 10:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20"/>አይ፥ «አስታማራዮ፥ ታ Ꮊይትታ ኡባ ናአትፕ አይኪ Ꮊኖ ሄሎዳይስ ናግዛ» ዬጌዛ።<verse eid="MRK 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21"/>የሱሳ አ ዳኪ ብኢ ቃዛ፤ «ኔስ ፐትባዚ ፓጭዛ፤ Ꮊንጊ ኔስ የዛ ባዝ ኡባ ባይዚ፥ የ ሚሻ ማንቅታይስ እንጎባ፤ ነ ሳሎ ዱርቶዳ። ዬዚ ማቂ ታና ካሎባ» ዬጌዛ። <verse eid="MRK 10:21"/><verse number="22" style="v" sid="MRK 10:22"/>ዝን አይ የያ ስኢ፥ ኤ ቱቄዝ ዱረ ማቄዝ ግሾስ ፋ ስና ቱኬዛ፥ ኡፋይተካዛር አሺ ቅቴዛ።<verse eid="MRK 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23"/>የሱሳ ፋ ታማርታ ዩዪ ብኢ፥ «ዱረ አስ ጾሳ ካተት ገሎዳይ ዋይዚ መቶደሻ!» ዬጌዛ።<verse eid="MRK 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24"/>ኤ ታማርታይ ኤ ትምርታ ስኢ ማላባዝ ጌዛ። ዝን የሱሳ ማካ ኡንትኮ፥ «ናእቶ፥ ጾሳ ካተት ገሎዳይ ዋይዚ መቶደሻ! <verse eid="MRK 10:24"/><verse number="25" style="v" sid="MRK 10:25"/>ዱረ አስ ጾስ ካተት ገሎዳይፕ፥ ግማለ ናርፐ ሉኮር ኣዳይ ሻዉክዛ» ዬጌዛ።<verse eid="MRK 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26"/>ኤ ታማርታይ Ꮊይ ማላባዝ ግ፥ «የዝን፥ ኦኒ አቶዴ?» ዬጊ፥ ፐታይ ፐታ ኦይጬዛ።<verse eid="MRK 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27"/>የሱሳ ኡንታን ዳኪ ብኢ፥ «Ꮊይ ጾስስ ዳንዳእንትዛፕ አትን አስስ ዳንዳእንቶያ፤ ጾስስ ኡባ ባዝ ዳንዳእንትዛ» ዬጌዛ።<verse eid="MRK 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28"/>ጵጽሮሳ የሱሳኮ፥ «ዬዛኮ፤ ኑኒ ኑባዝ ኡባ አሺ፥ ነና ካሌዛ» ዬጌዛ።<verse eid="MRK 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29"/>የሱሳ «ታ ይንትስ ቱሮ ኦድዛ፤ ታ ግሾኔ ዎንግለ ግሾስ ፋ ካራ ዎይ እሽታ ዎይ ምሽታ ዎይ አደ ዎይ እንዶ ዎይ ማቾ ዎይ ናእታ ዎይ ጋደ አሼዛይ ኦንካ፥ <verse eid="MRK 10:29"/><verse number="30" style="v" sid="MRK 10:30"/>Ꮊት Ꮊ ዎዳይድ ባይእር ፋ ካራ፥ እሽታ፥ ምሽታ፥ እንድታ፥ ናእታ፥ ጋደ፥ ጼት ኩሸ ኤኮዳ። ቲናስ የኦድ አላመ መና ደኦ ኤኮዳ። <verse eid="MRK 10:30"/><verse number="31" style="v" sid="MRK 10:31"/>ዝን ጋምታይ ቲናቴዝታይ ጉይቶዳ፥ ማካ ጋምታይ ጉይቴዝታይ ቲናቶዳ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">10:31 </char><char style="xt" closed="false"><ref loc="MAT 20:16">ማቶ. 20:16</ref>፤ <ref loc="LUK 13:30">ሉቃ. 13:30</ref></char></note><verse eid="MRK 10:31"/></para>
  <para style="s1">የሱሳ ፋ Ꮊይቃኔ ፋ ደንዳይ ባጋ ሃይን ኦዴዛ</para>
  <para style="r">(<ref loc="MAT 20:17-19">ማቶ. 20:17-19</ref>፤ <ref loc="LUK 18:31-34">ሉቃ. 18:31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32"/>የሱሳራኔ ኤ ታማርታይር የሩሳላመ Ꮊማዳር፥ የሱሳ ፋ ታማርታይፕ ቲን ቲን የዛ። ኡ የያ ማላባዝ ጌዛ። ኤዛ ካልዝታይካ ያሽቴዛ። ናምእን፥ ታጶ ናምኢ ታማርታ ጋጻ ከሲ፥ ፋና ሄሎድ ባዛ ዱማ ኡንትስ Ꮊይ ጋርክ ዬጊ ኦዴዛ። <verse eid="MRK 10:32"/><verse number="33" style="v" sid="MRK 10:33"/>«ዬዛኮ፥ ኑኒ የሩሳላመ Ꮊት ዎላ ኬሳል የዛ። የይዳ አስ ናአ፥ ቄሰ ሀላቅታይስኔ ህገ አስታማርታይስ ኣ እንግንቶዳ። ኡ ኤዛል አፋ Ꮊይቆ ፕርዳ ፕርዶዳ፤ ማ አይሁደ ባ ዎያስ ኤዛ ኣ እማዳ። <verse eid="MRK 10:33"/><verse number="34" style="v" sid="MRK 10:34"/>የ አይሁደ ባ ዎያይ ኤዛ ቶቾዳ፥ ኤዛል አፋ ጩቶዳ፥ ልሶር ጋራፎዳኔ ዎዳ። ኤ ሀይ ጋላሳፕ ጉየ፥ Ꮊይቆፕ ደንዶዳ» ዬጌዛ።<verse eid="MRK 10:34"/></para>
  <para style="s1">ያይቆባራኔ ዋንሳ ዎሳ</para>
  <para style="r">(<ref loc="MAT 20:20-28">ማቶ. 20:20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35"/>ዛብዶሳ ናእታይ ያይቆባራኔ ዋንሳር የሱሳኮ ይኢ፥ «አስታማራዮ፥ ኑኒ ነና ዎስዛ ኡባ ባዝ ኑስ ኦዳይ ጋርክ ኮይዛ» ዬጌዛ።<verse eid="MRK 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36"/>ኤ ኡንትኮ፥ «ታኒ ይንትስ አብ ኦ?» ዬጌዛ።<verse eid="MRK 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37"/>ኡንቲ፥ «ኔኒ ነ ቦንቾ ካተት በትዛ ጋላስ ኑፕ ፐታ ኡሻች ባጋር ማ ፐታ ሀድርስ ባጋር በትየ» ዬጌዛ።<verse eid="MRK 10:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38"/>ዝን የሱሳ ኡንትኮ፥ «ይ አብ ዎስዛኮ ኤሮያ፥ ታ ኡዦዳይስ የዝ ጹአ ኡዦዳይስ ዳንዳእኔ? ማ ታ ጻማቅንቶዳይስ የዝ ጽንቃታ ጻማቅንቶዳይስ ዳንዳእኔ?» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">10:38 </char><char style="xt" closed="false"><ref loc="LUK 12:50">ሉቃ. 12:50</ref></char></note><verse eid="MRK 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39"/>ኡ ማሂ፥ «ኤ ኑ ዳንዳእዛ» ዬጌዛ።</para>
  <para style="p" vid="MRK 10:39">የሱሳ ማካ፥ «ቱማ ታ ኡዦዳይስ የዝ ጹአ ይ ኡዦዳ፥ ታ ጻማቅንቶዳይስ የዝ ጽንቃታ ይ ጻማቅንቶዳ። <verse eid="MRK 10:39"/><verse number="40" style="v" sid="MRK 10:40"/>ዝን ታፕ ኡሻች ባጋራኔ ሀድርስ ባጋር በቶድታ ዶሮ ታ ዎልቃ ባያ፥ ዝን የ አቃይ ጾሳይ እማዳይስ ጊግሲ ጋዴዝታይሲ» ዬጌዛ።<verse eid="MRK 10:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41"/>Ꮊንኮ ታጲ ታማርታይ የያ ስኢ ያይቆባላኔ ዋንሳል ጋይልንቴዛ። <verse eid="MRK 10:41"/><verse number="42" style="v" sid="MRK 10:42"/>የሱሳ ኡንታን ኡባ ፋኮ ጼጊ፥ «አይሁደ ባ አስታይስ ሀላቅታይ ጋደ አቅስዝታ ግንትንቲ ጼግንትዝታይ ሞድዝታይስ ፋ አስታይል አፋ ማዉተ የዛና ይ ኤርዛ።<note caller="-" style="x"><char style="xo" closed="false">10:42-44 </char><char style="xt" closed="false"><ref loc="LUK 22:25-26">ሉቃ. 22:25-26</ref>፤ <ref loc="MAT 23:11">ማቶ. 23:11</ref>፤ <ref loc="MRK 9:35">ማር. 9:35</ref>፤ <ref loc="LUK 22:26">ሉቃ. 22:26</ref></char></note> <verse eid="MRK 10:42"/><verse number="43" style="v" sid="MRK 10:43"/>ዝን ይ ጋንጨ የይ ጋርክ ባያ፤ ይንቲ ይ ጋንጨ ባይራዳይስ ኮይዝ ኦንካ ይንትስ አይለ ማቆዳይስ ቤዝዛ። <verse eid="MRK 10:43"/><verse number="44" style="v" sid="MRK 10:44"/>ማ ይ ጋንጨ ኡባፕ ቃ ማቆዳይስ ኮይዝ ኦንካ ይ ኡባይስ አይለ ማቆዳይስ ቤዝዛ። <verse eid="MRK 10:44"/><verse number="45" style="v" sid="MRK 10:45"/>ሀራ አቶዝን፥ አስ ናአይካ፥ አስስ ኦዳይስኔ ጋምታ ዎዞዳይስ ፋ ሸምፖ ኣ እማዳይስ የኤዛፕ አትን አሲ ኤዝስ ኦድ ጋርክ የኤካያ» ዬጌዛ።<verse eid="MRK 10:45"/></para>
  <para style="s1">የሱሳ ቶአ ባርጽሞሳ አፋ ፓዛ</para>
  <para style="r">(<ref loc="MAT 20:29-34">ማቶ. 20:29-34</ref>፤ <ref loc="LUK 18:35-43">ሉቃ. 18:35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46"/>ኡንቲ ኢያርኮ ካታማ Ꮊንጌዛ። የሱሳ ፋ ታማርታይራኔ ጋመ አስታይር ኢያርኮፕ ከሳዳር፥ ጽሞሳ ናአይ፥ ቶአይ፥ ባርጽሞሳ ግንትንትዛይ፥ ኦገ ጋጻ በቲ ዎስዛ። <verse eid="MRK 10:46"/><verse number="47" style="v" sid="MRK 10:47"/>ባርጽሞሳ፥ ኤ የ ኦጋይር ኣዛይ ናዝረተ የሱሳ ማቄዛና ስኢ ፋ ቃላ ቅ ኡዲ፥ «ዳዉተ ናአ የሱሳ፥ ታና ማሮየ!» ዬግታር ኡፎ አይኬዛ።<verse eid="MRK 10:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48"/>ጋመ አሳይ ኤዛ፥ «ሀይዞባ!» ዬጊ ቆዴዛ።</para>
  <para style="p" vid="MRK 10:48">ዝን፥ ኤ ፋ ቃላ ቲናሳይፕ ኣ፥ «ዳዉተ ናአዮ፥ ታና ሀያና ማሮየ!» ዬጌዛ።<verse eid="MRK 10:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49"/>የሱሳ ኤቂ፥ «ኤዛ Ꮊና ጼጎይታ» ዬጌዛ።</para>
  <para style="p" vid="MRK 10:49">ኡንቲ ቶአይኮ፥ «አኮ ባያ፥ ደንዲ ኤቆባ፥ ነና ጼግዛ» ዬጌዛ። <verse eid="MRK 10:49"/><verse number="50" style="v" sid="MRK 10:50"/>ቶአይ ፋ አፍላ ጊ ኦሊ፥ ጉፒ ደንዲ ኤቂ፥ የሱሳኮ Ꮊንጌዛ።<verse eid="MRK 10:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51"/>የሱሳካ፥ «ታ ኔስ አብ ኡዶድ ጋርክ ነ ኮዬ?» ዬጌዛ።</para>
  <para style="p" vid="MRK 10:51">ቶአይ፥ «አስታማራዮ፥ ታ በአዳይስ ኮይዛ» ዬጌዛ።<verse eid="MRK 10:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52"/>የሱሳ ኤዛ፥ «ቅቶባ፥ ነ አማናይ ነና ፓዛ» ዬጌዛ። እዝር ኤ ኣፋይ ብእን፥ ኦገር የሱሳ ላሳ ካሌዛ።<verse eid="MRK 10:52"/></para>
  <chapter eid="MRK 10"/>
  <chapter number="11" style="c" sid="MRK 11"/>
  <para style="s1">የሱሳ ጋመ ቦንቾር የሩሳላመ ገሌዛ</para>
  <para style="r">(<ref loc="MAT 21:1-11">ማቶ. 21:1-11</ref>፤ <ref loc="LUK 19:28-40">ሉቃ. 19:28-40</ref>፤ <ref loc="JHN 12:12-19">ዋን. 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1"/>ኡ የሩሳላመ ኡክታር፥ ደብረ ዛይተ ደረ ላንቀ የዝ ቤተፋገኔ ብታና ካታማ ሄሌዛ። የሱሳ ፋ ታማርታይፕ ናምእታ ቲና ኪቲ፥ <verse eid="MRK 11:1"/><verse number="2" style="v" sid="MRK 11:2"/>«ይንታፕ ቲና የዝ ሄራ Ꮊንጎይታ፤ እዘ ሄሌዛን ጋርክ ኦንካ ቶጊ በኤካ አቻ የዝ ሀረ ናአ ይ ደማዳ፥ ኤዛ ብሊ፥ Ꮊና ኤኪ የኦይታ። <verse eid="MRK 11:2"/><verse number="3" style="v" sid="MRK 11:3"/>ኦንካ ይንታን፥ ‹Ꮊያ አብሶ ዋይዘ?› ዬጊ ኦይጭኮ፥ ‹ጎዳይ ኤዛ ኮይዛ፥ ዬጎይታ ኤ ኤልሲ Ꮊና ዳኮዳ› ዬጎይታ» ዬጌዛ።<verse eid="MRK 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4"/>ኡ Ꮊንጊ፥ ሀረ ናአይካ ባለ ኦገ ካለ አጭንቲ የዛና ደንጊ ብሌዛ። <verse eid="MRK 11:4"/><verse number="5" style="v" sid="MRK 11:5"/>የ አቃይድ ኤቄዝ ፐቲ ፐቲ አሳይ ኡንትኮ፥ «ሀረ ናአ ዋይሳዳይስ ብሌ?» ዬጌዛ። <verse eid="MRK 11:5"/><verse number="6" style="v" sid="MRK 11:6"/>ኤ ታማርታይ ኤ ኡንታን አዛዜዛና ኦድን፥ አሳይ ዳኪ አሼዛ። <verse eid="MRK 11:6"/><verse number="7" style="v" sid="MRK 11:7"/>ኡ ሀረ ናአ የሱሳኮ ክኢ፥ ፋ አፍልታ ኤ ዞካይል ሂጽን የሱሳ ያ ሀረ ናአ ቶጌዛ። <verse eid="MRK 11:7"/><verse number="8" style="v" sid="MRK 11:8"/>ጋመ አሳይ ፋ አፍላ ኦገል ሂጼዛ፤ ማ አቴዝ አሳይ ም ሀየ ሻቂ፥ ኦገል አፋ ሂጼዛ። <verse eid="MRK 11:8"/><verse number="9" style="v" sid="MRK 11:9"/>የሱሳፕ ቲናር የዝታኔ ኤዛ ጉየር ካልዝ አስታይ ፋ ቃላ ቅ ኡዲ፥</para>
  <para style="q1" vid="MRK 11:9">«ሆሳና! ጎዳይ ሱንር ይእዛይ አንጅንቴዛያ።<note caller="-" style="x"><char style="xo" closed="false">11:9 </char><char style="xt" closed="false"><ref loc="PSA 118:25">ማዝ. 118:25</ref></char></note><verse eid="MRK 11:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MRK 11:10"/>ይእዛና፥ ኑ ኣዳ</para>
  <para style="q2" vid="MRK 11:10">ዳዉተ ካተትት እዛ አንጅንቴዛኖ። ሆሳና! ኡባፕ ኣ ሳሎ»</para>
  <para style="m" vid="MRK 11:10">ዬግታር ኡኬዛ።<verse eid="MRK 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11"/>የሱሳ የሩሳላመ Ꮊንጊ፥ ጾሳ ኬ ገሌዛ። ማ ኡባ ባዝ ዩዪ በኤዛይፕ ጉየ፥ ሳአይ ቃሜዛይስ ታጶ ናምኢ ታማርታይር ብታና ካታማ Ꮊንጌዛ።<verse eid="MRK 11:11"/></para>
  <para style="s1">የሱሳ ባዴዝ ባላሰ ምቶ</para>
  <para style="r">(<ref loc="MAT 21:18-19">ማቶ. 21:18-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12"/>ዎንት ጋላስ ኡንቲ ብታናፕ ከዚ Ꮊማዳር፥ የሱሳ ናይንቴዛ። <verse eid="MRK 11:12"/><verse number="13" style="v" sid="MRK 11:13"/>ሃኮር ፐቲ ባላሰ ምቶ ሀየ ቶኪ የዛኖ ብኢ፥ እዝል አፋ ኣፈ በንቶደሻ ግ፥ በአዳይስ እዝኮ Ꮊንጌዛ፥ ዝን እዝኮ ኤ Ꮊንጎዳር ሀየ ኣዳፕ አትን ፐቲ ኣፈካ ደንገካያ፤ አብስ ጊኮ፥ ባላሰ ካእዝ ዎደ ሄለካያ። <verse eid="MRK 11:13"/><verse number="14" style="v" sid="MRK 11:14"/>የሱሳ የ ባላሳቶ፥ «ይኬ፥ ኔፕ መናስ አሲ ኣፈ ሚፐ» ዬጌዛ። ኤ ታማርታይ ኤ ግዛ ስኤዛ።<verse eid="MRK 11:14"/></para>
  <para style="s1">የሱሳ ጾሳ ኬ ዛልእዝታ ከሴዛ</para>
  <para style="r">(<ref loc="MAT 21:12-17">ማቶ. 21:12-17</ref>፤ <ref loc="LUK 19:45-48">ሉቃ. 19:45-48</ref>፤ <ref loc="JHN 2:13-22">ዋን. 2:13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15"/>ኡ የሩሳላመ Ꮊንጌዛ፤ የሱሳ ጾሳ ኬ ገሊ፥ ኤዛይድ ባይዝዝታኔ ዎንግዝታ ባለ ባይእ አይኬዛ፤ ማ ሚሸ ላምዝታይ ጻርጴዛናኔ ሆለ ባይዝዝታይ ኦይዳ ሽሪ ኦሌዛ፥ <verse eid="MRK 11:15"/><verse number="16" style="v" sid="MRK 11:16"/>አሲ አባባዝካ ቶኪ፥ ጾሳ ኬ ጋንጨር ኣማይ ጋርክ ካዬዛ። <verse eid="MRK 11:16"/><verse number="17" style="v" sid="MRK 11:17"/>የሱሳ አስታ Ꮊይ ጋርክ ዬጊ ታማርሴዛ፦ «ጌሻ ማጻፋይድ፥ ‹ታ ካራይ አስ ኡባይ ጾሳ ዎስዛ ካራ ማቃዳ› ዬግንቲ ጻፍንተካሳ? ዝን ይ ኤዛ ፓንታይ ቆስንትዛ ኮምኦ ማሄዛ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">11:17 </char><char style="xt" closed="false"><ref loc="ISA 56:7">ኢሳ. 56:7</ref>፤ <ref loc="JER 7:11">ኤርም. 7:11</ref></char></note><verse eid="MRK 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18"/>ቄሰ ሀላቅታይኔ ህገ አስታማርታይ የያ ስኢ፥ ኤዛ ዎዳይስ ኦገ ኮሽ አይኬዛ። ዝን ዎያ ኡባይ ኤ ትምርታ ማላባዝ ግዝ ግሾስ ኤዝስ ያሽቴዛ።<verse eid="MRK 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19"/>ሳአ ለምእለምኦዳር የሱሳራኔ ኤ ታማርታይ ካታማፕ ጋጻ ከዜዝ።<verse eid="MRK 11:19"/></para>
  <para style="s1">ባላሰ ምት መሌዛ</para>
  <para style="r">(<ref loc="MAT 21:20-22">ማቶ. 21:20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20"/>ኡንቲ ዎንት ጋላስ የ ኦጋይር ኣታር፥ የ ባላሳታ ጻጶር መሌዛኖ በኤዛ። <verse eid="MRK 11:20"/><verse number="21" style="v" sid="MRK 11:21"/>ጵጽሮሳስ ኤልቂ ግን፥ «አስታማራዮ፥ ይናሸ፥ ነ ባዴዝ ባላሳት መሌዛ» ዬጌዛ።<verse eid="MRK 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22"/>የሱሳ ማሂ፥ «ጾሳ አማኖይታ። <verse eid="MRK 11:22"/><verse number="23" style="v" sid="MRK 11:23"/>ታ ይንትስ ቱሮ ኦድዛ፤ ኦንካ ፋ ዎዝናይድ ስካዛር ጌዝባዚ ሀኖዳና ፋ ዎዝናር አማኒ፥ Ꮊ አምባ፥ ‹ሾድንቲ አባ ጋንጨ ዎባ› ዬግኮ ኤዝስ ሀኖዳ።<note caller="-" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="MAT 17:20">ማቶ. 17:20</ref>፤ <ref loc="1CO 13:2">1ቆሮ. 13:2</ref></char></note> <verse eid="MRK 11:23"/><verse number="24" style="v" sid="MRK 11:24"/>የይ ግሾስ፥ ታ ይንትስ ኦድዛ፤ ጾሳ ይ ዎስዛባዝኔ ኦይጭዝ ባዝ አብ ማቅኮ ኤኬዛይ ጋርክ አማኖይታ፥ ይ ኤኮዳ። <verse eid="MRK 11:24"/><verse number="25" style="v" sid="MRK 11:25"/>ጾስ ዎሶዳይስ ይ ኤቆዳር ሳሎ የዝ ይ አዳይ ይ ናጋራ አቶ ጎዳይ ጋርክ፥ ኦንካ ይንታን ናቄዝ ባዝ ፐታካ የዝኮ፥ ኤዝስ አቶ ጎይታ። [ <verse eid="MRK 11:25"/><verse number="26" style="v" sid="MRK 11:26"/>ዝን አስ ናጋራ ይ አቶ ጋም እጽኮ፥ ሳሎ የዝ ይ አዳይካ ይ ናጋራ ይንትስ አቶ ጋሚ» ዬጌዛ።]<verse eid="MRK 11:26"/></para>
  <para style="s1">የሱሳ አባ ማዉተር ኦዛኮ ኦይጭንቴዛ</para>
  <para style="r">(<ref loc="MAT 21:23-27">ማቶ. 21:23-27</ref>፤ <ref loc="LUK 20:1-8">ሉቃ. 20:1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27"/>ኡ ማቅካ የሩሳላመ ቅቴዛ። የሱሳ ጾሳ ኬ የዳር፥ ቄሰ ሀላቅታይ፥ ህገ አስታማርታይኔ ጭምታይ ኤዝኮ ይኢ፥ <verse eid="MRK 11:27"/><verse number="28" style="v" sid="MRK 11:28"/>«ነ Ꮊይትታ ኦዳይስ ኔስ አባ ማዉተ የኔ? ዎይ ኔስ Ꮊ ማዉታ እንጌዛይ ኦኖ?» ዬጌዛ።<verse eid="MRK 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29"/>የሱሳካ ማሂ ኡንትኮ፥ «ታ ይንታን ፐትባዝ ኦይጮዳ፥ ታስ ኦዶይታ። ታ ማ Ꮊያ አባ ማዉተር ኦዛኮ፥ ይንትስ ኦዶዳ። <verse eid="MRK 11:29"/><verse number="30" style="v" sid="MRK 11:30"/>ዋንሳ ጽንቃታይ ጾሳፐኔ አሳፔ? ታስ ኦዶይታ» ዬጌዛ።<verse eid="MRK 11:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31"/>ኡ ዎል ጋንጨ ፓላማ አይኪ፥ «ኑ፥ ‹ጾሳፕ› ጊኮ፥ ኤ ኑኮ፥ ‹የዝን፥ ዋንሳ ኦዴዛና አብስ አማነካሳ?› ዬጎዳ። <verse eid="MRK 11:31"/><verse number="32" style="v" sid="MRK 11:32"/>‹አሳፔ ጊኮ› ኡባ አስ ዋንሳ ናበ ማቄዛ ኤርዛ።» የይ ግሾስ ዎያይስ ያሽቴዛ። <verse eid="MRK 11:32"/><verse number="33" style="v" sid="MRK 11:33"/>የይ ግሾስ፥ ኡ የሱሳኮ፥ «ኑ ኤሮያ» ዬጊ ማሄዛ፤</para>
  <para style="p" vid="MRK 11:33">የሱሳካ፥ «ታንካ Ꮊያ አባ ማዉተር ኦዛኮ፥ ይንትስ ኦዳሚ» ዬጌዛ።<verse eid="MRK 11:33"/></para>
  <chapter eid="MRK 11"/>
  <chapter number="12" style="c" sid="MRK 12"/>
  <para style="s1">ዎይነ ቱክዝ ቢታ ኦ አቅዝታይ ኣዝሶ</para>
  <para style="r">(<ref loc="MAT 21:33-46">ማቶ. 21:33-46</ref>፤ <ref loc="LUK 20:9-19">ሉቃ. 20:9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1"/>የሱሳ ኡንትስ ኣዝሶር ዬጊ ኦዳ አይኬዛ፤ «ፐቲ አይ ዎይነ ም ቱኪ፥ ዩሻ ጋሴዛ። ማ ዎይነ ቡልዝ ኦላካ ቦኬዛ። ናጎዳይስ አዱስ ሻኮ ሻክሴዛ። የይፕ ጉየ፥ ማታየ Ꮊንትዝ አሳይስ እንጊ፥ ሀራ ቢታ ቅቴዛ።<note caller="-" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="ISA 5:1">ኢሳ. 5:1</ref></char></note> <verse eid="MRK 12:1"/><verse number="2" style="v" sid="MRK 12:2"/>ዎይነ ኣፈ ማጽዛ ዎደ ሄልን፥ ፋና ሄልዛና ኤኪ የኦድ ጋርክ፥ ፐቲ ፋ አይላ ማታየ ኤኬዝታይኮ ኪቴዛ። <verse eid="MRK 12:2"/><verse number="3" style="v" sid="MRK 12:3"/>ማታየ ኤኬዝታይ ኤ አይላ አይኪ Ꮊ፥ ካሎ ኩሸ ዳኬዛ። <verse eid="MRK 12:3"/><verse number="4" style="v" sid="MRK 12:4"/>ናምአን ሀራ አይለ ኡንትኮ ኪትን፥ ኡንቲ የ አይላ ሹቻር ቃዉጺ ዬላ ዳኬዛ። <verse eid="MRK 12:4"/><verse number="5" style="v" sid="MRK 12:5"/>ዎይነ አታክልተ ጎዳይ ማካ ሀራ አይለ ኪቴዛ። ያ አይላ ዎዛ፥ ማ ሀራ ጋምታ ዳክን የይ ጋርክ፥ ፐታ ፐታ Ꮊ፥ ባግታ ዎዛ።<verse eid="MRK 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 12:6"/>«ዎይነ አታክልተ ጎዳይስ ኪቶዳይስ ኡባፕ ዉርስል ኤ ሎእ ቃዛ ናአይ ኣዳ አቴዛ። ኤ፥ ‹ኡ ታ ናአ ቦንቼካ አሻሚ› ዬጊ፥ ፋ ናአ ኡንትኮ ኪቴዛ።<verse eid="MRK 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 12:7"/>«ዝን ማታየ ኤኬዝታይ ፋ ጋንጨር፥ ‹ላቶዳይ Ꮊያ፤ የይታ ኤዛ ዎላ ዎዳ፤ ኤ ጋዳይ ኑስ ማቆዳ!› ዬጌዛ። <verse eid="MRK 12:7"/><verse number="8" style="v" sid="MRK 12:8"/>ናአ አይኪ ዎ፥ ኤ አሃ ዎይነ አታክልተ ጋንጨፕ ጋጻ ከሲ ኦሌዛ።<verse eid="MRK 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9"/>«ይኬ፥ ዎይነ አታክልተ ጎዳይ ዋይሳዴ? ይኢ የ ማታየ ኤኬዝታ ዎ፥ ዎይና ኦዛ ሀራ አሳይስ እማዳ።<verse eid="MRK 12:9"/></para>
  <para style="q1">
    <verse number="10-11" style="v" sid="MRK 12:10-11"/>« ‹ግምቢዝታይ ቦሪ እጼዝ ሹቻይ</para>
  <para style="q2" vid="MRK 12:10-11">ኬ ሙመር ቶክዛ ክርክሮ ጋርክ፤</para>
  <para style="q2" vid="MRK 12:10-11">ኡባፕ ኣዝ ሹች ማቄዛ።</para>
  <para style="q1" vid="MRK 12:10-11">Ꮊይ ጎዳይ ኦዝ ባዝ፤</para>
  <para style="q2" vid="MRK 12:10-11">ማ ኑ ኣፋይስካ ማላ ባዝ›</para>
  <para style="q2" vid="MRK 12:10-11">ዬግዛና ጌሻ ማጻፈፕ ናባበካሳ?»</para>
  <para style="m" vid="MRK 12:10-11">ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">12:10-11 </char><char style="xt" closed="false"><ref loc="PSA 118:22-23">ማዝ. 118:22-23</ref></char></note><verse eid="MRK 12:10-11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12"/>ቄሰ ሀላቅታይ፥ ህገ አስታማርታይኔ ጭምታይ የሱሳ የ ኣዝሳ ኡ ፋል አፋ ኣዝሴዛና ኤሬዝ ግሾስ ኤዛ አይኮዳይስ ኮዬዛ፥ ዝን አሳይስ ያሽቲ፥ አሺ ቅቴዛ።<verse eid="MRK 12:12"/></para>
  <para style="s1">ጊራ ባጋር ሺቄዝ ኦይች</para>
  <para style="r">(<ref loc="MAT 22:15-22">ማቶ. 22:15-22</ref>፤ <ref loc="LUK 20:20-26">ሉቃ. 20:20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13"/>ፈርሳውታይፐኔ ሄሮዶሳ ባግታይፕ ጽቃ አስታይ ኤ ኦዳይፕ ቡታ ደንጊ፥ ኤዛ አይኮዳይስ ኮዪ፥ ኤዝኮ ኪቴዛ። <verse eid="MRK 12:13"/><verse number="14" style="v" sid="MRK 12:14"/>ኡ ኤዝኮ ይኢ፥ «አስታማራዮ፥ ነ ቱሮ ኦድንትዛኔ አሳፕ አሰ ሻጎዛና ኑ ኤርዛ። ነ አሰ ሻጎያ፤ ማ ጾስ ኦገ ቱማር ታማርስዛ። ኑ ኦሮመ ቢታ ካት ቄሳረስ ጊራ ጋችዛይ ዎጋኔ ዎጋ ባሳ? ጊራ ጋቾኔ አሾ?» ዬጌዛ።<verse eid="MRK 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 12:15"/>ዝን ኡ ጩቦት የሱሳ ኤሪ፥ «ታና አብስ ፋጮዳይስ ኮዬ? አን ፐቲ ሳንተ Ꮊና ክኢ ታና ቤዞይታ» ዬጌዛ። <verse eid="MRK 12:15"/><verse number="16" style="v" sid="MRK 12:16"/>ኡንቲ ኤዝስ ከኤዛ፥ «Ꮊ ማላይኔ ሱንይ ኦሶ?» ዬጊ ኡንታን ኦይጬዛ።</para>
  <para style="p" vid="MRK 12:16">ኡንቲ፥ «ቄሳረስ» ዬጌዛ።<verse eid="MRK 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17"/>የሱሳ ማሂ፥ «ዬዛኮ፥ ቄሳሬሳና ቄሳረስ፥ ጾሲሳ ጾስስ እንጎይታ» ዬግን ኡ ኤ ኦዳ Ꮊይ ማላ ባዝ ጌዛ።<verse eid="MRK 12:17"/></para>
  <para style="s1">Ꮊይቆፕ ደንዶ ባጋ</para>
  <para style="r">(<ref loc="MAT 22:23-33">ማቶ. 22:23-33</ref>፤ <ref loc="LUK 20:27-40">ሉቃ. 20:27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18"/>Ꮊይቄዝ አሲ ደንዶያ ግዝ ሳዱቃውታይፕ ፐቲ ፐቲ አሳይ የሱሳኮ ይኢ፥ Ꮊይ ጋርክ ዬጊ፥ ኤዛ ኦይጬዛ።<note caller="-" style="x"><char style="xo" closed="false">12:18 </char><char style="xt" closed="false"><ref loc="ACT 23:8">ሀዋ. ኦ. 23:8</ref></char></note> <verse eid="MRK 12:18"/><verse number="19" style="v" sid="MRK 12:19"/>«አስታማራዮ፥ ሙሰ ኑስ ህገ ጻፍታር፥ ‹ማቾ ኤኬዝ አይ ናአ የለካ Ꮊይቅኮ፥ የ Ꮊይቄዛይስ እሻይ ኤ ማቻቶ ኤኪ፥ ፋ እሻይስ ናአ የሎዳይስ ቤዝዛ› ዬግዛና ጻፌዛ።<note caller="-" style="x"><char style="xo" closed="false">12:19 </char><char style="xt" closed="false"><ref loc="NUM 25:5">ታይ. 25:5</ref></char></note> <verse eid="MRK 12:19"/><verse number="20" style="v" sid="MRK 12:20"/>ብኒ ዎደ ላፑን እሽታይ የዝታይፕ ባይራይ ማቾ ኤኪ፥ ናአ የለካዛር Ꮊይቄዛ። <verse eid="MRK 12:20"/><verse number="21" style="v" sid="MRK 12:21"/>ናምእንይ እዞ ኤኬዛ፥ ኤዝካ ናአ የለካዛር Ꮊይቄዛ። ሃይንይካ የይ ጋርክ ሀኔዛ። <verse eid="MRK 12:21"/><verse number="22" style="v" sid="MRK 12:22"/>ላፑንታይካ የይ ጋርክ እዞ ኤኪ፥ ናአ የለካዛር Ꮊይቄዛ። ኡባፕ ጉየ፥ ማ የ አስታካ Ꮊይቄዛ። <verse eid="MRK 12:22"/><verse number="23" style="v" sid="MRK 12:23"/>የዝን፥ ላፑንታይ እዞ ኤኬዝ ግሾስ Ꮊይቄዝ አሳይ Ꮊይቆፕ ደንድዛ ጋላስ፥ እዛ ኡንታፕ ኣያይስ ማቾ ማቆደ?» ዬጌዛ።<verse eid="MRK 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24"/>የሱሳ ማሂ፥ «ይ ባልንትዛይ፥ ጌሻ ማጻፍታ ዎይ ጾስ ዎልቃ ኤረካ ግሾስ ባሳ? <verse eid="MRK 12:24"/><verse number="25" style="v" sid="MRK 12:25"/>Ꮊይቄዝ አሳይ Ꮊይቆፕ ደንድዛ ጋላስ፥ ሳሎ የዝ ኪታንችታይ ጋርክ ማቆዳይፕ አትን ራ አሳይ ኤኮያ፤ ማቺ አስታይ ገሎያ። <verse eid="MRK 12:25"/><verse number="26" style="v" sid="MRK 12:26"/>ዝን Ꮊይቄዝታይ ደንዶ ባጋ ማቅኮ፥ ጾሲ ሙሰኮ ቱሻ ጋንጨ ኤጽዝ ታማፕ ዋጌዛኮ ሙሰ ማጻፋይፕ ይ ናባበካሳ? የይካ ‹ታኒ፥ አፍራመ ጾሲ፥ እሳቃ ጾሲ፥ ያይቆባ ጾሲ› ዬጌዛያ<note caller="-" style="x"><char style="xo" closed="false">12:26 </char><char style="xt" closed="false"><ref loc="EXO 3:6">ከስ 3:6</ref></char></note> <verse eid="MRK 12:26"/><verse number="27" style="v" sid="MRK 12:27"/>የይ ግሾስ፥ ኤ፥ ፓ የዝታይ ጾሳፕ አትን Ꮊይቄዝታይ ጾስ ባያ። ይ አቆፕ ኣ ባልንትዛ» ዬጌዛ።<verse eid="MRK 12:27"/></para>
  <para style="s1">ኡባፕ ኣዝ ኪታ</para>
  <para style="r">(<ref loc="MAT 22:34-40">ማቶ. 22:34-40</ref>፤ <ref loc="LUK 10:25-28">ሉቃ. 10:25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28"/>ህገ አስታማርታይፕ ፐታይ ኡ ፓላምዛና ሺቂ ስኤዛ። ማ የሱሳ ኡንትስ ሎእ ማሄዛና ስኢ፥ «ኪታ ኡባፕ ኣዝ ኪታይ ኣያ?» ዬጊ የሱሳና ኦይጬዛ።<note caller="-" style="x"><char style="xo" closed="false">12:28-34 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">ሉቃ. 10:25-28</ref></char></note><verse eid="MRK 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29"/>የሱሳ ማሂ፥ ኤዝኮ Ꮊይ ጋርክ ዬጌዛ፦ «ኪታ ኡባፕ ኣዝ ኪታ ስኦይታ፤ ‹እስሬለ አሳይስ፥ ጎዳይ ኑ ጾሳይ ፐቲ ጎዳ።<note caller="-" style="x"><char style="xo" closed="false">12:29-30 </char><char style="xt" closed="false"><ref loc="NUM 6:4-5">ታይ. 6:4-5</ref></char></note> <verse eid="MRK 12:29"/><verse number="30" style="v" sid="MRK 12:30"/>ነ ጎዳ ነ ጾሳ ነ ኩን ዎዝናፕ፥ ነ ኩን ሸምፖፕ፥ ነ ኩን ቆፋፕ፥ ነ ኩን ዎልቃፕ ቃባ› ዬጌዛ። <verse eid="MRK 12:30"/><verse number="31" style="v" sid="MRK 12:31"/>ማ ኪታ ኡባፕ ኣዝ ናምእን ኪታይ Ꮊያ፤ ‹ነ ላጋ ነ ኡባይ ጋርክ ቃባ› ዬግዛ፤ Ꮊይትታይፕ ኣዝ ሀራ ኪታ ባያ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">12:31 </char><char style="xt" closed="false"><ref loc="LEV 19:18">ለዊ. 19:18</ref></char></note><verse eid="MRK 12:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32"/>ህገ አስታማራይ የሱሳኮ፥ «አስታማራዮ፤ ‹ጾሳይ ፐቶ። ኤዛፕ አትን ሀራ ባያ› ነ ጌዛይ ቱሮ።<note caller="-" style="x"><char style="xo" closed="false">12:32 </char><char style="xt" closed="false"><ref loc="NUM 4:35">ታይ. 4:35</ref></char></note> <verse eid="MRK 12:32"/><verse number="33" style="v" sid="MRK 12:33"/>ጾሳ ኩን ዎዝናፕ፥ ኩን ቆፋፐኔ ኩን ዎልቃፕ ቃዛይኔ ማ አስ ኡባ ፋ ኡባይ ጋርክ ቃዛይ ጹግዝ ያርሾፐኔ ሀራ ያርሾ ኡባይፕ ኣዛ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">12:33 </char><char style="xt" closed="false"><ref loc="HOS 6:6">ሆሳ. 6:6</ref></char></note><verse eid="MRK 12:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34"/>የሱሳ ህገ አስታማራይ ማህይ ኣ ኤራ አስ ማልሰ ማቄዛና ብኢ፥ «ነ ጾስ ካተትፕ ሃከካያ» ዬጌዛ፤ የይፕ ጉየ፥ የሱሳና ሀራ ባዝ ኦይጮዳይስ ኦንካ ምንገካያ።<note caller="-" style="x"><char style="xo" closed="false">12:28-34 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">ሉቃ. 10:25-28</ref></char></note><verse eid="MRK 12:34"/></para>
  <para style="s1">ክርስቶሳ ኦ ናአ</para>
  <para style="r">(<ref loc="MAT 22:41-46">ማቶ. 22:41-46</ref>፤ <ref loc="LUK 20:41-46">ሉቃ. 20:41-46</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35"/>የሱሳ ጾስ ኬ ታማርስታር፥ Ꮊይ ጋርክ ዬጌዛ፦ «ህገ አስታማርታይ ክርስቶሳ ዋጊ ፋና ዳዉተ ናአ ጌ? <verse eid="MRK 12:35"/><verse number="36" style="v" sid="MRK 12:36"/>ዳዉተ ጌሻ አያና ደንን፥</para>
  <para style="q1" vid="MRK 12:36">« ‹ጎዳይ፥ ታ ጎዳይኮ፥ «ታኒ ነ ሞርክታ</para>
  <para style="q2" vid="MRK 12:36">ነ ቶኬ የዝ አቆ ኡዶድ ጋ፥</para>
  <para style="q2" vid="MRK 12:36">Ꮊይዳ ታ ኡሻቻ በቶባ» ጌዛ</para>
  <para style="m" vid="MRK 12:36">ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">12:36 </char><char style="xt" closed="false"><ref loc="PSA 110:1">ማዝ. 110:1</ref></char></note> <verse eid="MRK 12:36"/><verse number="37" style="v" sid="MRK 12:37"/>ዳዉተ ፋ ኡባስ ክርስቶሳና፥ «ጎዳ ግ ጼግኮ፥ የዝን፥ ክርስቶሳ ዋይዚ፥ ዳዉተ ናአ ማቄ» ዬጌዛ።</para>
  <para style="p" vid="MRK 12:37">ዎያይ የሱሳ ግዛና ኡፋይቲ ስኤዛ።<verse eid="MRK 12:37"/></para>
  <para style="s1">የሱሳ ህገ አስታማርታ ቦሬዛ</para>
  <para style="r">(<ref loc="MAT 23:1-36">ማቶ. 23:1-36</ref>፤ <ref loc="LUK 20:45-47">ሉቃ. 20:45-47</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38"/>የሱሳ ታማርስታር፥ Ꮊይ ጋርክ ዬጌዛ፦ «ህገ አስታማርታይፕ ናግንቶይታ፤ ኡ አዱስ አፍላ ማኢ ዩይዝታኔ ጋበላካ አሳይ ኡንታን ቦንቺ ሳሮዛና ዶስዛ። <verse eid="MRK 12:38"/><verse number="39" style="v" sid="MRK 12:39"/>ኡንቲ አይሁድታይ ዎሳ ኬ ጋመ ሎኦ ኦይደ ዶስዛ፤ ማካ አሲ ፋና ሞክዛ አቆካ ቦንቾ አቆ ዶስዛ። <verse eid="MRK 12:39"/><verse number="40" style="v" sid="MRK 12:40"/>ኡ አሲ በኦ ግ ዎሳ አዱስስታር፥ አምእታይ ኬ ቦንቂዛ፤ ኡ ኡባፕ ኣዝ ፕርዳ ኤኮዳ» ዬጌዛ።<verse eid="MRK 12:40"/></para>
  <para style="s1">አምአት ሙጻታ</para>
  <para style="r">(<ref loc="LUK 21:1-4">ሉቃ. 21:1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41"/>የሱሳ ጾስ ኬ ጋንጨ ሙጻታ ኦልዛ ሳጽነ ካለ በቲ፥ አሳይ ፋ ሚሻ የ ሳጽናይድ ኦልዛና በኤዛ፤ ጋመ ዱረ አሳይ ጋመ ሚሸ የ ሳጽናተ ኦልዛ። <verse eid="MRK 12:41"/><verse number="42" style="v" sid="MRK 12:42"/>ፐቲ ማንቆ አምአት ይኢ፥ ናምኢ ስክና የ ሳጽንተ ኦሌዛ። <verse eid="MRK 12:42"/><verse number="43" style="v" sid="MRK 12:43"/>የሱሳ ፋ ታማርታ ጼጊ፥ «ታ ይንትስ ቱሮ ኦድዛ፤ ሙጻታ ሳጽነ ጋንጨ ኦሌዝ አስ ኡባፕ Ꮊ ማንቆ አምአት ኣ ኦሌዛ። <verse eid="MRK 12:43"/><verse number="44" style="v" sid="MRK 12:44"/>አብስ ጊኮ፥ Ꮊንክታይ ኡቢታይ ፓስ ፑጬዝ ሚሻይፕ ኦሌዛ። ዝን እዛ ፋ ፓጫትፕ፥ ፓስ የዛኖ ኡባር ኦሌዛ» ዬጌዛ።<verse eid="MRK 12:44"/></para>
  <chapter eid="MRK 12"/>
  <chapter number="13" style="c" sid="MRK 13"/>
  <para style="s1">የሱሳ ጾስ ኬይ ላልንቶዳና ቲናቲ ኦዴዛ</para>
  <para style="r">(<ref loc="MAT 24:1-2">ማቶ. 24:1-2</ref>፤ <ref loc="LUK 21:5-6">ሉቃ. 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1"/>የሱሳ ጾስ ኬፕ ከሳዳር፥ ኤ ታማርታይፕ ፐታይ፥ «አስታማራዮ፥ Ꮊይ ዋፋ ሎኦ ሹችኔ ዋፋ ሎኦ ሹች ኬዛኮ ነ ቦኦባ!» ዬጌዛ።<verse eid="MRK 13:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2"/>የሱሳ ማሂ፥ «Ꮊ ዳማ ሹች ኬ ነ ብእኔ? Ꮊ ኬይ ሹቺ ሹቻል አፋ ግምቢንቴዛይ ጋርክ ላልንተካዛር አታሚ፤ ፐቲ ሹችካ አተካዛር ኡቢታይ ላልንቶዳ» ዬጌዛ።<verse eid="MRK 13:2"/></para>
  <para style="s1">ዉርስ ላይስ የዝ ማላ</para>
  <para style="r">(<ref loc="MAT 24:3-14">ማቶ. 24:3-14</ref>፤ <ref loc="LUK 21:7-19">ሉቃ. 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3"/>የሱሳ ጾስ ኬፕ ቲና ባጋር ደብረ ዛይተ አምባል አፋ በቴዝን፥ ጵጽሮሳ፥ ያይቆባ፥ ዋንሳኔ እንድራሰራ ዎላ ኤዝኮ ይኢ፥ <verse eid="MRK 13:3"/><verse number="4" style="v" sid="MRK 13:4"/>«Ꮊይ አይደ ሀኖዳዛኮ፥ ኑስ ኦዶባ፤ Ꮊ ኡቢታይ ፖልንቶድ ዎዳ ኤርስዛ ማላይ አባ?» ዬጊ ኦይጬዛ።<verse eid="MRK 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5"/>የሱሳ ማካ ኡንትስ Ꮊይ ጋርክ ዬጊ ኦዴዛ፦ «ይንታን ኦንካ ባልማይ ጋርክ ናግንቶይታ። <verse eid="MRK 13:5"/><verse number="6" style="v" sid="MRK 13:6"/>ጋመ አሳይ ታ ሱንር፥ ‹ታኒ ክርስቶሳ› ዬግታር ይኢ፥ ጋመ አስታ ባልዳ። <verse eid="MRK 13:6"/><verse number="7" style="v" sid="MRK 13:7"/>ኦላኔ ኦላ ዎረ ይ ስኤዝ ጋላስ ዳጋምፓተ። የይ ጋርክ ባዝ ሀኖዳይ አታሚ፥ ዝን ዉርስይ ሀጋ። <verse eid="MRK 13:7"/><verse number="8" style="v" sid="MRK 13:8"/>ፐቲ ዎያ ሀራ ዎያር ኦልንቶዳ፤ ማ ፐቲ ካተትይ ሀራ ካተትር ኦልንቶዳ፤ ቢታ ኤንኦ ኡባ አቆ ሀኖዳ፤ ናየ ደንዶዳ፥ ዝን የይ ኡባይ የሎስ ማቺ እቅንትዝ ዞኬ ጋርከ።<verse eid="MRK 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9"/>«ዝን ይ፥ ይ ኡባስ ናግንቶይታ። አብስ ጊኮ፥ አሲ ይንታን አይኪ፥ ፕርደ ኬስ ኣ እማዳ፤ ማ አይሁድታይ ዎሳ ኬታይዳካ ይንታን አላንጋር አላንጎዳ፤ ጋደ አቅስዝታይ ቲናኔ ካትታይ ቲና ታ ግሾስ ይ ማርካቶዳይስ ኤቆዳ።<note caller="-" style="x"><char style="xo" closed="false">13:9-11 </char><char style="xt" closed="false"><ref loc="MAT 10:17-20">ማቶ. 10:17-20</ref>፤ <ref loc="LUK 12:11-12">ሉቃ. 12:11-12</ref></char></note> <verse eid="MRK 13:9"/><verse number="10" style="v" sid="MRK 13:10"/>ዉርስ ሄሎዳይፕ ቲና ዎንግለ አስ ኡባይስ ኦድንቶዳይስ ቤዝዛ። <verse eid="MRK 13:10"/><verse number="11" style="v" sid="MRK 13:11"/>ኡ ይንታን ፕርደ ኬ ክእዛ ዎደኔ ኣ እንግዛ ዎደ ዋጊ ኦዶደ ዬጊ ህርግፓተ፤ የ ሳታተ ጾሳይ ይንትስ እንግዛ ባዝ ኦዶይታ። ጌሻ አያናይ ኦድንትዛፕ አትን ይንታን ባያ።<verse eid="MRK 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 13:12"/>«ኢሻይ ፋ እሻ፥ አዳይ ፋ ናአ ኣ እማዳ። ናእታይ ፋና የሌዝታይል አፋ ደንዲ፥ ኡንታን ዎዳ። <verse eid="MRK 13:12"/><verse number="13" style="v" sid="MRK 13:13"/>አሲ ኡባይ ይንታን ታ ሱንይ ግሾስ እጾዳ፥ ዝን ዉርስ ሄሎዳይስ ጋርዤዛይ አቶዳ።<note caller="-" style="x"><char style="xo" closed="false">13:13 </char><char style="xt" closed="false"><ref loc="MAT 10:22">ማቶ. 10:22</ref></char></note><verse eid="MRK 13:13"/></para>
  <para style="s1">የሩሳላመል ሄሎድ ኢታ መቶ</para>
  <para style="r">(<ref loc="MAT 24:15-28">ማቶ. 24:15-28</ref>፤ <ref loc="LUK 21:20-24">ሉቃ. 21:20-24</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14"/>«ዝን ብስዛ ቱና ኦሶ ኤቆዳይስ ቤዞዋ አቆ ኤቄዝን ይ በአዳ።» የይ ዋጉስዛኮ ናባብዛይ አካኮ! «ይሁዳ ቢታ የዝታይ የ ዎደ አምባ ጉየ ቆስንቶ።<note caller="-" style="x"><char style="xo" closed="false">13:14 </char><char style="xt" closed="false"><ref loc="DAN 9:27">ዳነ. 9:27</ref>፤ <ref loc="DAN 11:31">11:31</ref>፤ <ref loc="DAN 12:11">12:11</ref></char></note> <verse eid="MRK 13:14"/><verse number="15" style="v" sid="MRK 13:15"/>ኬል የዝ አይካ ፐትባዝ ኤኮዳይስ፥ ፋ ካራ ገልፐ።<note caller="-" style="x"><char style="xo" closed="false">13:15-16 </char><char style="xt" closed="false"><ref loc="LUK 17:31">ሉቃ. 17:31</ref></char></note> <verse eid="MRK 13:15"/><verse number="16" style="v" sid="MRK 13:16"/>ጋደ ኦል የዛይ ፋ አፍላ ኤኮዳይስ ጉየ ማቅፐ። <verse eid="MRK 13:16"/><verse number="17" style="v" sid="MRK 13:17"/>የ ዎደ ዎደ ማችታይስኔ ንዛ ማችታ ኡንታን አየ። <verse eid="MRK 13:17"/><verse number="18" style="v" sid="MRK 13:18"/>ዝን Ꮊይ ኡቢታይ ሀኖዳር ዎዳይ ባርጎ ማቃማይ ጋርክ፥ ጾስ ዎሶይታ። <verse eid="MRK 13:18"/><verse number="19" style="v" sid="MRK 13:19"/>አብስ ጊኮ፥ ጾሲ አላመ መዝ ዎደፕ አይኪ፥ Ꮊኖ ሄሎዳይስ ሀንበኤካ መቶ ቲናፐካ ሀናም መቶ አሳል አፋ የ ዎደ ሀኖዳ።<note caller="-" style="x"><char style="xo" closed="false">13:19 </char><char style="xt" closed="false"><ref loc="DAN 12:1">ዳነ. 12:1</ref>፤ <ref loc="REV 7:14">ዋን. ቆን. 7:14</ref></char></note> <verse eid="MRK 13:19"/><verse number="20" style="v" sid="MRK 13:20"/>ጎዳይ የ ጋላስታይ ታይባ ሃትዛኮ፥ አስ ግዝ ኦንካ አታሚ። ዝን ኤ ፋ ዶሬዝ አሳይ ግሾስ የ ጋላስታይ ታይባ ቃንሴዛ።<verse eid="MRK 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 13:21"/>«የ ዎደ ኦንካ ይንታን፥ ‹Ꮊያ ቦኦይታ፥ ክርስቶሳ Ꮊይዳ የዛ ዎይ ክርስቶሳ ሰንዳይዳ የዛ› ዬግኮ፥ የያ አማንፓተ። <verse eid="MRK 13:21"/><verse number="22" style="v" sid="MRK 13:22"/>ዎርዶ ክርስቶስታይራኔ ዎርዶ ናብታይ ደንዲ ኡንትስ ዳንዳእንትኮ፥ ሀራ አቶዝን ጾሳይ ማራጼዝታካ ባልዳይስ ማላኔ ማላባዝ ቤዞዳ። <verse eid="MRK 13:22"/><verse number="23" style="v" sid="MRK 13:23"/>ዝን ይ ናግንቶይታ፤ ታ ይንትስ ኡባ ባዝ ቲናቲ ኦዴዛ።<verse eid="MRK 13:23"/></para>
  <para style="s1">ክርስቶሳ ናምእን ይእ</para>
  <para style="r">(<ref loc="MAT 24:29-31">ማቶ. 24:29-31</ref>፤ <ref loc="LUK 21:25-28">ሉቃ. 21:25-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24"/>«ዝን የ ዎደ የ ዋያይፕ ጉየ፥</para>
  <para style="q1" vid="MRK 13:24">« ‹አዋ ሞዳ፤</para>
  <para style="q2" vid="MRK 13:24">አግና ፋ ፎአ ካዮዳ፤<note caller="-" style="x"><char style="xo" closed="false">13:24 </char><char style="xt" closed="false"><ref loc="ISA 13:10">ኢሳ. 13:10</ref>፤ <ref loc="JER 2:10">ኤርም. 2:10</ref></char></note><verse eid="MRK 13:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="MRK 13:25"/>ጾልንትታይ ሳሎፕ ጉፎዳ፤</para>
  <para style="q2" vid="MRK 13:25">ማ ሳሎ የዝ ዎልቅታይካ ኤንኦዳ።›<note caller="-" style="x"><char style="xo" closed="false">13:25 </char><char style="xt" closed="false"><ref loc="ISA 34:4">ኢሳ. 34:4</ref>፤ <ref loc="JOL 2:10">ኢዩ. 2:10</ref>፤ <ref loc="REV 6:13">ዋን. ቆን. 6:13</ref></char></note><verse eid="MRK 13:25"/></para>
  <para style="m">
    <verse number="26" style="v" sid="MRK 13:26"/>የ ዎደ አስ ናአይ፥ ኣ ዎልቃራኔ ቦንቾራ ሻራ ጋንጨር የኦዳር ኡባይ በአዳ።<note caller="-" style="x"><char style="xo" closed="false">13:26 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳነ. 7:13</ref>፤ <ref loc="REV 1:7">ዋን. ቆን. 1:7</ref></char></note> <verse eid="MRK 13:26"/><verse number="27" style="v" sid="MRK 13:27"/>የ ዎደ ኤ ኪታንችታ ኪቶዳ፤ ኡንትካ ኦይዲ ጎንተ Ꮊንጊ ሳአ ጋጻፕ ሳሎ ጋጻ ሄሎዳይስ፥ ጾሲ ዶሬዝ አስታ ሺሾዳ።<verse eid="MRK 13:27"/></para>
  <para style="s1">ላይይ ሄሌዛና ኤርስዛ ባላሰ ምቶ</para>
  <para style="r">(<ref loc="MAT 24:32-35">ማቶ. 24:32-35</ref>፤ <ref loc="LUK 21:29-33">ሉቃ. 21:29-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28"/>«ኣዝሶ ባላሰ ምፕ አካኮይታ፤ ባላሳታ ፉርጮዳራኔ እ ሀያይ ብልእ አይክኮ ቦነ ኡኬዛና ይ ኤርዛ። <verse eid="MRK 13:28"/><verse number="29" style="v" sid="MRK 13:29"/>የይ ጋርከካ፥ ይ የ ኡባ ባዝ ሀንዛና ብእኮ ዎዳይ ኡኪ ፐንገ ሄሌዛና ኤሮይታ። <verse eid="MRK 13:29"/><verse number="30" style="v" sid="MRK 13:30"/>ታ ይንትስ ቱሮ ኦድዛ፤ Ꮊ ኡባባዛይ ሀኖድ ጋ Ꮊ የለት ኡቢታይ ኣሚ። <verse eid="MRK 13:30"/><verse number="31" style="v" sid="MRK 13:31"/>ሳሎኔ ሳአ ኣዳ፥ ዝን ታ ቃላይ ኡባራካ ኣሚ።<verse eid="MRK 13:31"/></para>
  <para style="s1">ጎዳይ የኦድ ጋላሳኔ ሳተ ኦንካ ኤሮያ</para>
  <para style="r">(<ref loc="MAT 24:36-44">ማቶ. 24:36-44</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32"/>«ዝን የ ጋላሳኔ የ ሳታ አዳይ ኣዳፕ አትን ሀራ አቶዝን ሳሎ የዝ ኪታንችታ ማቅን ዎይ ናአ ማቅን ኦንካ ኤርዛይ ባያ።<note caller="-" style="x"><char style="xo" closed="false">13:32 </char><char style="xt" closed="false"><ref loc="MAT 24:36">ማቶ. 24:36</ref></char></note> <verse eid="MRK 13:32"/><verse number="33" style="v" sid="MRK 13:33"/>የ ጋላሳይ አይደ ማቆዳዛኮ ይ ኤሮዋ ግሾስ ናግንቶይታ፥ ምንጎይታኔ ዎሶይታ። <verse eid="MRK 13:33"/><verse number="34" style="v" sid="MRK 13:34"/>ታ ይእይ ፋ ካራ አሺ፥ ኦገ Ꮊንግዛ አይ ጋርከ። አይ ፋ አይልታ ኦማር ኦማር ኦ አይ ኡንትስ ፋ ኦሳይስ ማዉተ እንጌዛ፤ ማ ናግዛናካ ሚን ናጎድ ጋርክ ኪቴዛ።<note caller="-" style="x"><char style="xo" closed="false">13:34 </char><char style="xt" closed="false"><ref loc="LUK 12:36">ሉቃ. 12:36</ref></char></note><verse eid="MRK 13:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 13:35"/>«የይ ግሾስ፥ ሚንጎይታ። አብስ ጊኮ፥ ካራ አዳይ ኦማ ማቆ ዎይ ግዲ ብላሄ ማቆ ዎይ ሹጉላ ኡፎ ማቆ ዎይ ዎንትማ ማቆ አይደ የኦዳዛኮ፥ ይ ኤሮያ። <verse eid="MRK 13:35"/><verse number="36" style="v" sid="MRK 13:36"/>ይ አካኬካዝን ኤ ይኢ ይንታን ይ ገንቲ የዝን ደንጋማይ ጋርክ ሚንጎይታ። <verse eid="MRK 13:36"/><verse number="37" style="v" sid="MRK 13:37"/>ታ ይንትስ ኦድዛን ጋርክ አስ ኡባስ፤ ሚንጎይታ» ዬጌዛ።<verse eid="MRK 13:37"/></para>
  <chapter eid="MRK 13"/>
  <chapter number="14" style="c" sid="MRK 14"/>
  <para style="s1">ክርስቶሳል አፋ ቶቤዛ</para>
  <para style="r">(<ref loc="MAT 26:1-5">ማቶ. 26:1-5</ref>፤ <ref loc="LUK 22:1-2">ሉቃ. 22:1-2</ref>፤ <ref loc="JHN 11:45-53">ዋን. 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1"/>ፓዝቃ ባለ ቦንችዛ ጋላስኔ ቦራ ባለ ቦንችዛ ጋላስ ሄሎዳይስ ናምኢ ጋላሲ አቴዛ። ቄሰ ሀላቅታይኔ ህገ አስታማርታይ ጩቦትር የሱሳና አይኪ ዎዛ ኦገ ኮይዛ።<note caller="-" style="x"><char style="xo" closed="false">14:1 </char><char style="xt" closed="false"><ref loc="EXO 12:1">ከስ 12:1</ref></char></note> <verse eid="MRK 14:1"/><verse number="2" style="v" sid="MRK 14:2"/>«አሳይ ካች ከሳማይ ጋርክ ፓዝቃ ቦንችዝ ጋላስ ኦሚ» ዬጌዛ።<verse eid="MRK 14:2"/></para>
  <para style="s1">የሱሳና ሽቶ ትዤዝ አስቶ</para>
  <para style="r">(<ref loc="MAT 26:6-13">ማቶ. 26:6-13</ref>፤ <ref loc="JHN 12:1-8">ዋን. 12:1-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3"/>የሱሳ ብታና ካታማ ቦርቆንቶ ሀርገር የዝ ስሞና ካራ ስብረል አፋ በቴዝን፥ ፐቲ አስታ አልባስጽሮሳ ግንትዝ ብልጋጸ ኩን ናርዶሰ ግንትዝ ጋመ አልኦ ሽቶ ኤኪ የኤዛ። የ ብልጋጻቶ መን ሽታ የሱሳ ኦማይል ሁልኤዛ።<note caller="+" style="f"><char style="fr" closed="false">14:3 </char><char style="ft" closed="false">አልበስጽሮሰ አልኦ ሹች ኮች</char></note><note caller="-" style="x"><char style="xo" closed="false">14:3 </char><char style="xt" closed="false"><ref loc="LUK 7:37">ሉቃ. 7:37</ref></char></note> <figure style="fig" alt="Alabaster jars" file="HK00142B.tif" size="span" ref="14:3">ኣልባስጽሮሰ ብልጋጸ</figure> <verse eid="MRK 14:3"/><verse number="4" style="v" sid="MRK 14:4"/>የ አቃይድ የዝ አሳይፕ ፐታይ ፐታይ ካጭንቲ፥ «Ꮊ ሽታይ ጨር ኢትዛይ አብሶ? <verse eid="MRK 14:4"/><verse number="5" style="v" sid="MRK 14:5"/>Ꮊ ሽታና ሀይ ጼት ድናረ ጋተ ከሶዳያ<note caller="+" style="f"><char style="fr" closed="false">14:5 </char><char style="fqa" closed="false">ሀይ ጼት ድናረ፦ </char><char style="ft" closed="false">ፐቲ አስስ ላይር ጭግንትዛ ሎኦ ዳሞዘፕ ኣ ማቅዝ ሚሸ።</char></note> ባይዚ፥ ሚሻ ማንቅታይስ እማዳይስ ዳንዳእንትዛዝን» ዬጊ ፋ ጋንጨር ዎላ ኦድንቴዛ። ዬዚ፥ የ አስቶ ቦሬዛ።<verse eid="MRK 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6"/>ዝን የሱሳ «Ꮊ አስቶ አሾይታ፤ እዞ አብስ ዋይ? እዛ ታስ ሎኦ ባዝ ኦዛ። <verse eid="MRK 14:6"/><verse number="7" style="v" sid="MRK 14:7"/>ማንቅታይ ኡባ ዎደ ይንታር የዛ። ይ ኮዤዝ ጋላስ አይደካ ኡንታን ማዶዳይስ ዳንዳእዛ፥ ዝን ታ ኡባ ዎደ ይንታር የዛሚ።<note caller="-" style="x"><char style="xo" closed="false">14:7 </char><char style="xt" closed="false"><ref loc="NUM 15:11">ታይ. 15:11</ref></char></note> <verse eid="MRK 14:7"/><verse number="8" style="v" sid="MRK 14:8"/>እዛ ፓስ ዳንዳእንቴዛይ ጋርክ ኦዛ፤ ማ ታና ሞጎስ ጊግሶዳይስ ቲናቲ ሽቶ ትዤዛ። <verse eid="MRK 14:8"/><verse number="9" style="v" sid="MRK 14:9"/>ታ ይንትስ ቱሮ ኦድዛ፤ ሳአ ኡባይል ዎንግለ ኦድንትዛ አባ ማቅኮካ፥ አሳይ እዞ ሀሳዮዳይ ጋርክ Ꮊ እዛ ኦዛይ ኦድንቶዳ» ዬጌዛ።<verse eid="MRK 14:9"/></para>
  <para style="s1">ይሁዳ የሱሳና ኣ እማዳይስ ቶቤዛ</para>
  <para style="r">(<ref loc="MAT 26:14-16">ማቶ. 26:14-16</ref>፤ <ref loc="LUK 22:3-6">ሉቃ. 22:3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10"/>ታጶ ናምኢ ታማርታይፕ ፐታይ አስቆሮቶ ይሁዳ ግንትንትዛይ የሱሳና ቄሰ ሀላቅታይስ ኣ እማዳይስ ኡንትኮ Ꮊንጌዛ። <verse eid="MRK 14:10"/><verse number="11" style="v" sid="MRK 14:11"/>ኡ የያ ስኢ ኡፋይቲ፥ «ኑ ኔስ ሚሸ እማዳ» ዬጌዝ ግሾስ፤ ይሁዳ የሱሳና ኣ እንጎዳይስ ጊጋ ጋላስ ኮዬዛ።<verse eid="MRK 14:11"/></para>
  <para style="s1">የሱሳ ፋ ታማርታይራ ፓዝቃ ሜዛ</para>
  <para style="r">(<ref loc="MAT 26:17-25">ማቶ. 26:17-25</ref>፤ <ref loc="LUK 22:7-14">ሉቃ. 22:7-14</ref>፥ <ref loc="LUK 22:21-23">21-23</ref>፤ <ref loc="JHN 13:21-30">ዋን. 13:21-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12"/>ቦራ ባለ ቦንችንትዛይፕ ቲና ጋላስ፥ ፓዝቃ ካ ማዳይስ ዱር ሹክዛ ጋላስ የሱሳ ታማርታይ ኤዝኮ፥ «ፓዝቃ ቦንችዛ ጋላስ ነ ማድ ካ ኑ ኣይድ Ꮊንጊ ማኮ?» ግ ኦይጬዛ።<verse eid="MRK 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13"/>የሱሳ ፋ ታማርታይፕ ናምእታ Ꮊይ ጋርክ ዬጊ ኪቴዛ፦ «ካታማ Ꮊንጎይታ፤ ይ Ꮊማዳር፥ ኦታር ሃ ቶኬዝ ፐቲ አይ ይንታን ሄሎዳ፤ ኤዛ ካሎይታ። <verse eid="MRK 14:13"/><verse number="14" style="v" sid="MRK 14:14"/>ኤ Ꮊንጊ ገልዛ ኬቲ ጎዳይኮ፥ ‹አስታማራይ ኔኮ፥ ታኒ ታ ታማርታይር ፓዝቃ ማዳይስ እማ ኬ አባ የኔ? ዬጌዛ› ዬጎይታ። <verse eid="MRK 14:14"/><verse number="15" style="v" sid="MRK 14:15"/>ካራ ጎዳይ ይንታን ፖቄል አፋ ሂጽንቲ ጊጊ የዝ ዳልገ ክፍለ ቤዞዳ፤ የ አቃይድ ማኮይታ» ዬጌዛ።<figure style="fig" alt="Two-story house with steps to roof" file="LB00235B.tif" size="span" ref="14:15">ኣይሁደ ኬ ካራ</figure><verse eid="MRK 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16"/>የ ታማርታይ ከዚ፥ ካታማ Ꮊንጌዛ፤ የሱሳ ኡንትስ ኦዴዛይ ጋርክ ደንጊ፥ ፓዝቃ ካ ማኬዛ።<verse eid="MRK 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17"/>ሳአ ኦማዳር የሱሳ ታጶ ናምኢ ታማርታይር የ አቃ Ꮊንጌዛ። <verse eid="MRK 14:17"/><verse number="18" style="v" sid="MRK 14:18"/>ኡ በቲ ካ ማዳር፥ የሱሳ ኡንትኮ፥ «ታ ይንትስ ቱሮ ኦድዛ፤ ይንታፕ ፐታይ ታር ሚዛይ፥ ታና ኣ እማዳ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">14:18 </char><char style="xt" closed="false"><ref loc="PSA 41:9">ማዝ. 41:9</ref></char></note><verse eid="MRK 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19"/>ኤ ታማርታይ ዳጋሚ፥ ፋ ኦማስ ኦማስ፥ «ቱማ ታናሻ?» ዬጊ ኤዛ ኦይጬዛ።<verse eid="MRK 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20"/>የሱሳ ማሂ፥ «የ አይ ይ ታጶ ናምእታይፕ ፐታ፤ ኤ ታር ዎላ ፍልኦ ጋንጨ ኩሸ ዳክዛያ። <verse eid="MRK 14:20"/><verse number="21" style="v" sid="MRK 14:21"/>አስ ናአይ፥ ጌሻ ማጻፋይድ Ꮊይቆዳ ጌዛይ ጋርክ Ꮊይቆዳ፥ ዝን አስ ናአ፥ ኣ እንግዛ አ ኤዛ አየ። የ አይ የልንተካ አቴዛኮ ኤስ ሎኦዝን» ዬጌዛ።<verse eid="MRK 14:21"/></para>
  <para style="s1">ጎዳይ ካሆ</para>
  <para style="r">(<ref loc="MAT 26:26-30">ማቶ. 26:26-30</ref>፤ <ref loc="LUK 22:14-20">ሉቃ. 22:14-20</ref>፤ <ref loc="1CO 11:23-25">1ቆሮ. 11:23-25</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22"/>ኡ ማዳር፥ የሱሳ ቦራ ኤኪ፥ ጾስ ጋላቴዛ፤ የ ቦራ ባጺ፥ ፋ ታማርታይስ እንግታር፥ «Ꮊሽተ፥ Ꮊይ ታ አሾ» ዬጌዛ።<verse eid="MRK 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23"/>ጹአ ደን፥ ጾስ ጋላቲ፥ ኡንትስ እንግን ኡቢታይካ የ ጹአይፕ ኡዤዛ። <verse eid="MRK 14:23"/><verse number="24" style="v" sid="MRK 14:24"/>የሱሳ፥ «Ꮊይ ጋመ አሳይስ ጎግዝ ኦሮ ጫቆ ታ ሱ። <verse eid="MRK 14:24"/><verse number="25" style="v" sid="MRK 14:25"/>ታ ይንትስ ቱሮ ኦድዛ፤ ታኒ ጾስ ካተት ኦሮ ዎይነ ኡዦድ ጋላሳይ ሄሎድ ጋ ማቂ Ꮊ ዎይናይፕ ኡዣሚ» ዬጌዛ።<verse eid="MRK 14:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26"/>ማዝሙረ የጼዛይፕ ጉየ ደብረ ዛይተ አምባል አፋ ከዜዝ።<verse eid="MRK 14:26"/></para>
  <para style="s1">ጵጽሮሳ ካዶዳና የሱሳ ቲናቲ ኦዴዛ</para>
  <para style="r">(<ref loc="MAT 26:31-35">ማቶ. 26:31-35</ref>፤ <ref loc="LUK 22:31-34">ሉቃ. 22:31-34</ref>፤ <ref loc="JHN 13:36-38">ዋን. 13:36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27"/>የሱሳ ኡንትኮ፥ «ይ ኡቢታይ ታና ኦሊ አሺ ላሲ ቦዳ፤</para>
  <para style="q1" vid="MRK 14:27">« ‹ጾሲ ሄንግዛና ሾጮዳ፥</para>
  <para style="q2" vid="MRK 14:27">ዱርታይ ኡባይ ላልንቶዳ› ዬግንቲ ጻፍንቴዛይ ጋርከ።</para>
  <para style="m" vid="MRK 14:27">ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">14:27 </char><char style="xt" closed="false"><ref loc="NUM 13:7">ታይ. 13:7</ref></char></note> <verse eid="MRK 14:27"/><verse number="28" style="v" sid="MRK 14:28"/>ዝን ታ Ꮊይቆፕ ደንዴዛይፕ ጉየ ይንታፕ ቲናቲ ጋልላ ኣዳ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">14:28 </char><char style="xt" closed="false"><ref loc="MAT 28:16">ማቶ. 28:16</ref></char></note><verse eid="MRK 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29"/>ጵጽሮሳ ማሂ፥ «ኡ ኡቢታይ ነና ኦሊ አሽኮካ፥ ታ ነና አሻሚ» ዬጌዛ።<verse eid="MRK 14:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30"/>የሱሳ ጵጽሮሳኮ፥ «ታ ኔስ ቱሮ ኦድዛ፤ Ꮊይኖ ቃማ ሹጉላ ናምኢ ቶክ ኡኮዳይፕ ቲና ነ ታና ሀይ ቶኬ ካዶዳ» ዬጌዛ።<verse eid="MRK 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31"/>ዝን ጵጽሮሳ ቲናሳይፕ ሚን፥ «ታ ሀራ አቶዝን፥ ኔር ዎላ Ꮊይቅዛኮካ፥ ነና ካዳሚ» ዬጌዛ። Ꮊንክታይ ኡቢታይካ የይ ጋርክ ጌዛ።<verse eid="MRK 14:31"/></para>
  <para style="s1">የሱሳ ጌተሰማነ ከዚ ዎሴዛ</para>
  <para style="r">(<ref loc="MAT 26:36-46">ማቶ. 26:36-46</ref>፤ <ref loc="LUK 22:39-46">ሉቃ. 22:39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32"/>የሱሳ ፋ ታማርታይር ጌተሰማነ ግንትዝ አቆ Ꮊንጊ፤ ፋ ታማርታይኮ፥ «ታ ጾሳ ዎሲ ማቆድ ጋ ይ Ꮊይዳ በቶይታ» ዬጌዛ።<verse eid="MRK 14:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 14:33"/>የሱሳ ጵጽሮሳ፥ ያይቆባራኔ ዋንሳ ፓር ኤኪ ቅቴዛ፤ ዋይንቴዛኔ ኡንእንቴዛ። <verse eid="MRK 14:33"/><verse number="34" style="v" sid="MRK 14:34"/>ማ ኡንትኮ፥ «ታ ሸምፓታ Ꮊይቆድ ጋ አዛኔዛ፥ Ꮊይዳ ጋምኦይታኔ፤ ሚንጎይታ» ዬጌዛ።<verse eid="MRK 14:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35"/>ጽቃ ቲና ሺቂ፥ ሳአ ጹጉኒ፥ ዳንዳእንትዛ ባዝ ማቅኮ፥ Ꮊ ዋየ ሳታይ ፓፕ ኣዳይ ጋርክ፥ ጾስ ዎሴዛ። <verse eid="MRK 14:35"/><verse number="36" style="v" sid="MRK 14:36"/>ማ፥ «አቦ፥<note caller="+" style="f"><char style="fr" closed="false">14:36 </char><char style="ft" closed="false">አባ፦ ጉሳይ አርማይኬ ዶናር ታ አዳዮ ጉሲ</char></note> አባቦ፥ ኡባ ባዝ ኔስ ዳንዳእንትዛ፥ Ꮊ ዋየ ጹአ ታፕ ሃሶባ። ዝን ነ ሸነ ሀኖፕ አትን ታ ሸነ ሀንፔ» ዬጌዛ።<verse eid="MRK 14:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37"/>የሱሳ ማቂ ይኢ፥ ኡ ገንቴዝን ደንጊ፥ ጵጽሮሳኮ፥ «ስሞና፥ ገንቴኔ? ሀራ አቶ ነ ፐቲ ሳተካ ባርኪ ናጎዳይስ ዳንዳኤካሳ? <verse eid="MRK 14:37"/><verse number="38" style="v" sid="MRK 14:38"/>ፓጨ ጋንጨ ይ ገላማይ ጋርክ ባርኪ ናጎይታኔ ጾሳ ሚንጊ ዎሶይታ። አያናይ፥ ጊግንቴዝን አሻይ ዳቡራ» ዬጌዛ።<verse eid="MRK 14:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39"/>ማካ Ꮊንጊ ቲናሳይ ጋርክ ጾሳ ዎሴዛ። <verse eid="MRK 14:39"/><verse number="40" style="v" sid="MRK 14:40"/>Ꮊተካ ኤ ጉየ ማቂ ኡንትኮ የኦዳር ገንቴዝን ደንጌዛ። ኡ አፋ ገንታ ጎዚ ጋዴዝ ግሾስ ኤዝኮ አብ ማሆዳዛኮካ ኤረካያ።<verse eid="MRK 14:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41"/>ሃይን ኡንትኮ ይኢ፥ «Ꮊኖ ሄሎዳይስካ ገንታላኔ ሸምፖል የኔ? ይኬ፥ ግዶዳ፤ ሳታት ሄሌዛ፤ ቦኦይታ! አስ ናአይ፥ ናጋራንቾ አሳይስ ኣ እንግንቶድ ዎዳይ ሄሌዛ። <verse eid="MRK 14:41"/><verse number="42" style="v" sid="MRK 14:42"/>ይኬ ደንዶይታ የይታ፤ ቦኦይታ፥ ታና ኣ እንግዛ አይ ሄሌዛ» ዬጌዛ።<verse eid="MRK 14:42"/></para>
  <para style="s1">የሱሳ ፋ ሞርክታይ ኩሸ ኣ እንግንቴዛ</para>
  <para style="r">(<ref loc="MAT 26:47-56">ማቶ. 26:47-56</ref>፤ <ref loc="LUK 22:47-53">ሉቃ. 22:47-53</ref>፤ <ref loc="JHN 18:3-12">ዋን. 18:3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43"/>የሱሳ የያ ሀጋ ኦዶዳር፥ ኤ ታጶ ናምኢ ታማርታይፕ ፐታይ፥ ይሁዳ፥ ኤልሲ ሄሌዛ። ማ ቄሰ ሀላቅታይ፥ ህገ አስታማርታይኔ ጭምታይ ኪትን፥ ማሻኔ ጉፈ አይኬዝ ጋመ አሳይ ኤዛር ዎላ የኤዛ። <verse eid="MRK 14:43"/><verse number="44" style="v" sid="MRK 14:44"/>የሱሳና ኣ እንጎዳይ የ ጋመ አሳይስ፥ «ታ ዬርዛይ ኤዛ፤ ኤዛ አይኪ፥ ሎእ ናጊ፥ ኤኪ ካንጎይታ» ዬጊ ማላ ኦዲ ጋዴዛ።<verse eid="MRK 14:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 14:45"/>ይሁዳ ሄሌዛን ጋርክ የሱሳኮ ሺቂ፥ «አስታማራዮ» ዬጊ የሱሳ ዬሬዛ። <verse eid="MRK 14:45"/><verse number="46" style="v" sid="MRK 14:46"/>የ ጋመ አሳይ የሱሳና አይኬዛ። <verse eid="MRK 14:46"/><verse number="47" style="v" sid="MRK 14:47"/>ኤ ታማርታይፕ ፐታይ ፋ ማሻ ሾዲ ቄሰ ሀላቃይ አይላ ሾጪ፥ ኤ ሀይቶ ቃ ኦሌዛ።<verse eid="MRK 14:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 14:48"/>የሱሳ ማሂ፥ አሳይኮ፥ «ይ ታና ፓኖ አይክዛይ ጋርክ አይኮዳይስ ማሻኔ ጉፈ አይኪ የኤኔ? <verse eid="MRK 14:48"/><verse number="49" style="v" sid="MRK 14:49"/>ታ ጾስ ካራ ጋንጨ ታማርስታር፥ ጋላስ ጋላስ ይንታር የዝን ታና አይከካዛር፥ ጌሻ ማጻፋይ ጌዛይ ፖልንቶዳይስ ቤዝዛ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">14:49 </char><char style="xt" closed="false"><ref loc="LUK 19:47">ሉቃ. 19:47</ref>፤ <ref loc="LUK 21:37">21:37</ref></char></note><verse eid="MRK 14:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 14:50"/>ኤ ታማርታይ ኡቢታይ ኤዛ ኦሊ አሺ ላሲ ቤዛ።<verse eid="MRK 14:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51"/>ላጻና ኣዳ ማኤዝ ፐቲ የላጋ አይ የሱሳ ካሎ አይኬዛ። <verse eid="MRK 14:51"/><verse number="52" style="v" sid="MRK 14:52"/>ዝን የ አይ ላጻና ኦሊ አሺ፥ ጺራ ካሎ ላሲ ቤዛ።<verse eid="MRK 14:52"/></para>
  <para style="s1">የሱሳና ፕርደ ሻንጎ ቲና ካንጌዛ</para>
  <para style="r">(<ref loc="MAT 26:57-68">ማቶ. 26:57-68</ref>፤ <ref loc="LUK 22:54-55">ሉቃ. 22:54-55</ref>፥ <ref loc="LUK 22:63-71">63-71</ref>፤ <ref loc="JHN 18:13-14">ዋን. 18:13-14</ref>፥ <ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53"/>አሳይ የሱሳ ቄሰ ሀላቃይ ካራ ካንጌዛ። ኤዛይድ ቄሰ ሀላቅታይ፥ ጭምታይኔ ህገ አስታማርታይ ሺቂ የዛ። <verse eid="MRK 14:53"/><verse number="54" style="v" sid="MRK 14:54"/>ጵጽሮሳ ቄሰ ሀላቃይ ዛባ ሄሎዳይስ ሃኮር ኤዛ ካሊ Ꮊንጊ ኤዛይድ ናግዝታይር በቲ ታማ ካዥዛ።<verse eid="MRK 14:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MRK 14:55"/>ቄሰ ሀላቅታይኔ ፕርደ ሻንግታይ ኡቢታይ የሱሳ ዎዳይስ ኤዛል አፋ ማርካ ኮዬዛ፥ ዝን አብካ ደንገካያ። <verse eid="MRK 14:55"/><verse number="56" style="v" sid="MRK 14:56"/>ጋመ አሳይ ኤዛል አፋ ዎርዶ ማርካቴዛ፥ ዝን ኡ ማርክተይ ፐቲ ቃላ ባያ።<verse eid="MRK 14:56"/></para>
  <para style="p">
    <verse number="57-58" style="v" sid="MRK 14:57-58"/>ፐቲ ፐቲ አስታይ ደንዲ ኤቂ የሱሳል አፋ፥ «ኤ፥ ‹ታኒ አሲ ኬጼዝ Ꮊ ጾሳ ኬ ላሊ፥ አሲ ኩሸ ኬጽንተካ ሀራ ጾስ ኬ ሀይ ጋላሳ ጋንጨ ኬጾድ› ጎዳር ኑ ስኤዛ» ዬጊ ዎርዶ ማርካቴዛ።<note caller="-" style="x"><char style="xo" closed="false">14:58 </char><char style="xt" closed="false"><ref loc="JHN 2:19">ዋን. 2:19</ref></char></note> <verse eid="MRK 14:57-58"/><verse number="59" style="v" sid="MRK 14:59"/>ማቆዝን፥ ኡ ማርከትይ ፐቶ ባያ።<verse eid="MRK 14:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60"/>ቄሰ ሀላቃይ አስ ኡቢታይ ቲናይድ ደንዲ ኤቂ፥ «Ꮊይታይ ነና ሞትዛ ሞታይስ ነ ማህዝባዝ ባሳ?» ዬጊ የሱሳና ኦይጬዛ። <verse eid="MRK 14:60"/><verse number="61" style="v" sid="MRK 14:61"/>ዝን የሱሳ ስኤ ጌዛ፤ አብካ ማሄካያ። ቄሰ ሀላቃይ፥ «አንጅንቴዝ ጾስ ናአይ፥ ክርስቶሳ ነናኔ?» ዬጊ ማሂ ኦይጬዛ።<verse eid="MRK 14:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62"/>የሱሳ ማሂ፥ «ኤ ታና፥ ይ አስ ናአይ፥ ዎልቃማ ጾሳፕ ኡሻች ባጋር በቴዝንኔ ሳሎ ሻራር የኦዳር በአዳ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">14:62 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳነ. 7:13</ref></char></note><verse eid="MRK 14:62"/></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63"/>ቄሰ ሀላቃይ ሸነር ፋ አፍላ ፔ፥ «ኑና ሀራ አብ ማርካ ኮሼ? <verse eid="MRK 14:63"/><verse number="64" style="v" sid="MRK 14:64"/>ይ ኤ ጫሻ ስኤዛ፤ ይንትስ አብ ኣዜ?» ዬጌዛ። ኡንቲ ኡቢታይ፥ «ኤ Ꮊይቆዳይስ ቤዝዛ» ዬጊ ኤዛል አፋ ፕርዴዛ።<note caller="-" style="x"><char style="xo" closed="false">14:64 </char><char style="xt" closed="false"><ref loc="LEV 24:15">ለዊ. 24:15</ref></char></note><verse eid="MRK 14:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MRK 14:65"/>ኡንታፕ ፐታይ ፐታይ ኤዛል አፋ ጩቲ ኤ አፋ ጎሊ ዡልትታር፥ «ነና Ꮊዛይ ኦኖ? አን ኑስ ኦዶባ!» ዬጌዛ። ናግዝታይ ኤዛ ጋራፍታር ኤኪ Ꮊንጌዛ።<verse eid="MRK 14:65"/></para>
  <para style="s1">ጵጽሮሳ የሱሳና ካዴዝ</para>
  <para style="r">(<ref loc="MAT 26:69-75">ማቶ. 26:69-75</ref>፤ <ref loc="LUK 22:56-62">ሉቃ. 22:56-62</ref>፤ <ref loc="JHN 18:15-18">ዋን. 18:15-18</ref>፥ <ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66"/>ጵጽሮሳ ቄሰ ሀላቃይ ዛባይድ ዬክ ባጋር የዝን፥ ቄሰ ሀላቃይ ጋንድታይፕ ፐታት እዘ የኤዛ። <verse eid="MRK 14:66"/><verse number="67" style="v" sid="MRK 14:67"/>ጵጽሮሳ ታማ ካዦዳር እዛ ዳኪ ብኢ፥ «ኔካ ናዝረተ የሱሳር የዛ ባይ» ዬጌዛ።<verse eid="MRK 14:67"/></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68"/>ዝን ጵጽሮሳ፥ «ነ ግዛይ አብዛኮ ታ ኤሮያ፥ ታስ አካክንቶያ» ዬጊ ካዴዛ። ዬጊ ማቂ ኤ ባለ ከዜዛን ጋርክ ሹጉላ ኡኬዛ<note caller="+" style="f"><char style="fr" closed="false">14:68 </char><char style="ft" closed="false">ፐቲ ፐቲ ማጻፈ ሹጉላ ኡኬዛ ግዛይ ባያ</char></note>።<verse eid="MRK 14:68"/></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69"/>የ ጋንዳታ ጵጽሮሳ ብኢ፥ እ ላንቀ ኤቄዝ አስታይኮ፥ «Ꮊ አይካ ኡንታር የዛ» ግ ማሂ ኦዴዛ። <verse eid="MRK 14:69"/><verse number="70" style="v" sid="MRK 14:70"/>ዝን ጵጽሮሳ ማካ ካዴዛ።</para>
  <para style="p" vid="MRK 14:70">ጽቃ ጋምኦዳር፥ ላንቀ ኤቄዝ አስታይ ማካ ጵጽሮሳኮ፥ «ነ ጋልላ ቢታ አስ ማቄዝ ግሾስ ቱማ ኡንታር የዛ» ዬጌዛ።<verse eid="MRK 14:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71"/>ዝን ጵጽሮሳ፥ «ታ ይ ግዝ አ ኤሮያ!» ዬጊ ፋና ባድኔ ጫቆ አይኬዛ።<verse eid="MRK 14:71"/></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72"/>እዝር ሹጉላ ናምእን ኡኬዛ። ጵጽሮሳ የሱሳ ኤዝኮ፥ «ነ ሹጉላ ናምኢ ቶክ ኡኮዳይፕ ቲና ሀይ ቶክ ታና ካዶዳ» ኤዝኮ ጌዛይ ኤልቂ ግን ዬኬዛ።<verse eid="MRK 14:72"/></para>
  <chapter eid="MRK 14"/>
  <chapter number="15" style="c" sid="MRK 15"/>
  <para style="s1">የሱሳና ጵላጾሳኮ ካንጌዛ</para>
  <para style="r">(<ref loc="MAT 27:1-2">ማቶ. 27:1-2</ref>፥ <ref loc="MAT 27:11-14">11-14</ref>፤ <ref loc="LUK 23:1-5">ሉቃ. 23:1-5</ref>፤ <ref loc="JHN 18:28-38">ዋን. 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1"/>ዎንት ጉር ኤልሲ ቄሰ ሀላቅታይ፥ ጭምታይ፥ ህገ አስታማርታይኔ ፕርደ ሻንጎ ኡቢታይ ሺቂ ቶቤዛ። ኡ የሱሳና አጪ ካንጊ ጵላጾሳስ ኣ እንጌዛ።<verse eid="MRK 15:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 15:2"/>ጵላጾሳ ኤዝኮ፥ «ነ አይሁድታይስ ካቶ?» ዬጊ ኦይጬዛ።</para>
  <para style="p" vid="MRK 15:2">የሱሳ ማሂ፥ «ነ ጌዛ» ዬጌዛ።<verse eid="MRK 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3"/>ቄሰ ሀላቅታይ የሱሳና ጋመ ባዛ ሞቴዛ። <verse eid="MRK 15:3"/><verse number="4" style="v" sid="MRK 15:4"/>ዝን ጵላጾሳ ማሂ የሱሳኮ፥ «ኔስ ማህዝባዝ ባሳ? ኡ ኔል አፋ አብ ጋርክ ሞቶ ክእዛኮ በአሞ?» ዬጌዛ።<verse eid="MRK 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5"/>ዝን የሱሳ ሀራ ባዝ ማሃም እጽን፥ ጵላጾሳ ማላባዝ ጌዛ።<verse eid="MRK 15:5"/></para>
  <para style="s1">የሱሳና Ꮊይቆ ግ ፕርዴዛ</para>
  <para style="r">(<ref loc="MAT 27:15-26">ማቶ. 27:15-26</ref>፤ <ref loc="LUK 23:13-25">ሉቃ. 23:13-25</ref>፤ <ref loc="JHN 18:39-40">ዋን. 18:39-40</ref>፤ <ref loc="JHN 19:1-16">19:1-16</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6"/>ጵላጾሳስ ፓዝቃ ባለ ቦንችዛ ጋላስ አስታይ ኮይዝ ፐቲ አ አቻፕ ብልእዝ ዎጋ የዛ። <verse eid="MRK 15:6"/><verse number="7" style="v" sid="MRK 15:7"/>የ ዎደ ፐቲ ባእርባና ግዝ አይ ዳፋ ከሲ ሸምፖ ዎዝ አስታይር ዎላ አች ካራ የዛ። <verse eid="MRK 15:7"/><verse number="8" style="v" sid="MRK 15:8"/>ጋመ አስታይ ጵላጾሳክ ይኢ ካሴሳይ ጋርክ ኦድ ጋርክ ኤዛ ኦይጬዛ። <verse eid="MRK 15:8"/><verse number="9" style="v" sid="MRK 15:9"/>ጵላጾሳ አሳና ማሂ፥ «ታ ይንትስ አይሁድታይ ካታ ብልኦዳና ኮይኔ?» ዬጊ ኦይጬዛ። <verse eid="MRK 15:9"/><verse number="10" style="v" sid="MRK 15:10"/>Ꮊ ኤ ጌዛይ፥ ቄሰ ሀላቅታይ የሱሳ ቅናተ ኣ እንጌዛና ኤርዝ ግሾሲ።<verse eid="MRK 15:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 15:11"/>ዝን ቄሰ ሀላቅታይ ባእርባና ብሎዳይ ጋርክ፥ የ ሺቄዝ አስታይ ጵላጾሳ ዎሶዳይ ጋርክ አስታ ደንዛ። <verse eid="MRK 15:11"/><verse number="12" style="v" sid="MRK 15:12"/>ጵላጾሳ ማሂ፥ «የዝን፥ ይ አይሁደ ካተ ግዛና ዋይሳዳይ ጋርክ ኮዬ?» ዬጌዛ።<verse eid="MRK 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13"/>አስታይ ጵላጾሳል አፋ ኡኪ፥ «ማዝቃለል አፋ ኤዛ ሶቶባ» ዬጌዛ።<verse eid="MRK 15:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14"/>ጵላጾሳ አሳይኮ፥ «አብሶ? ኤ አብ ኢታ ባዝ ኦኔ?» ዬጌዛ።</para>
  <para style="p" vid="MRK 15:14">ዝን አሳይ ቲናሳይፕ ጉጂ ኡኪ፥ «ማዝቃለል አፋ ኤዛ ሶቶባ» ዬጌዛ።<verse eid="MRK 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15"/>ጵላጾሳ አሳ ኡፋይሶዳይስ ኮዪ፥ ባእርባና አሳይስ ብልኤዛ፤ የይፕ የሱሳና አላንጊ፥ ማዝቃለል አፋ ሶቶዳይ ጋርክ ኣ እንጌዛ።<verse eid="MRK 15:15"/></para>
  <para style="s1">ዎታዳርታይ የሱሳና ቶቼዛ</para>
  <para style="r">(<ref loc="MAT 27:27-31">ማቶ. 27:27-31</ref>፤ <ref loc="JHN 19:2-3">ዋን. 19:2-3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16"/>የይፕ ጉየ፥ ዎታዳርታይ የሱሳ ፕራይቶራ ግንትዝ ዎታዳርታይ ዛባ ኤኪ ካንጊ፥ ሀራ ዎታዳርታ ኡባ ጼግሴዛ። <verse eid="MRK 15:16"/><verse number="17" style="v" sid="MRK 15:17"/>ማ ዞቆ አፍላ ኤዛ ማእሴዛ፤ አንጉ ዛዉደ ኮቺ፥ ኤ ኦማይድ ጋዴዛ። <verse eid="MRK 15:17"/><verse number="18" style="v" sid="MRK 15:18"/>የይፕ ጉየ፥ ኤዝኮ፥ «አይሁድታይ ካታዮ ሳሮ» ዬጊ፥ ኤስ ኩሸ ደንዛ። <verse eid="MRK 15:18"/><verse number="19" style="v" sid="MRK 15:19"/>ኤ ኦማይድ ጉፈር ሾጬዛ፤ ማ ኤዛል አፋ ጩቴዛ፤ ጹጉኒ ኤስ ጎይኔዛ። <verse eid="MRK 15:19"/><verse number="20" style="v" sid="MRK 15:20"/>ኤዛ ለቄዛይፕ ጉየ ዞቆ አፍላ ኤፕ ቃሪ ኤኪ፥ ኤ አፍላ ኤዛ ማእስ ማዝቃለል አፋ ኤዛ ሶቶዳይስ ኤኪ ካንጌዛ።<verse eid="MRK 15:20"/></para>
  <para style="s1">የሱሳና ሶቴዛ</para>
  <para style="r">(<ref loc="MAT 27:32-44">ማቶ. 27:32-44</ref>፤ <ref loc="LUK 23:26-43">ሉቃ. 23:26-43</ref>፤ <ref loc="JHN 19:17-27">ዋን. 19:17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21"/>ኡ Ꮊንግታር፥ ኢስክንድረራኔ ሩፎሳ ኣዳ፥ ስሞና ግዝ ቀረና ጋደ አስ፥ ጋጻረፕ ካታማ ይእዛና ሄሊ፥ የሱሳ ማዝቃላና ዎልቃን ቶሴዛ።<note caller="-" style="x"><char style="xo" closed="false">15:21 </char><char style="xt" closed="false"><ref loc="ROM 16:13">ኦሮ. 16:13</ref></char></note> <verse eid="MRK 15:21"/><verse number="22" style="v" sid="MRK 15:22"/>ዬዚ ጎልጎታ ግዝ አቆ የሱሳ ካንጌዛ። «ጎልጎታ» ጉሳይ «ኦማ ኦታ» ጉሲ። <verse eid="MRK 15:22"/><verse number="23" style="v" sid="MRK 15:23"/>ካርበ ግዝ ለር ዋላክንቴዝ ዎይነ ኡዦ ግ ኤስ እንጌዛ። ዝን ኤ ኡዣም እጼዛ። <verse eid="MRK 15:23"/><verse number="24" style="v" sid="MRK 15:24"/>ኡ ማዝቃለል አፋ ኤዛ ሶቴዛይፕ ጉየ ኦና አቢ ሄሎዳዛኮ ግ ኤ አፍላይል ዎላ እጻ ኦሊ ሻግንቲ ኤኬዛ።<verse eid="MRK 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 15:25"/>ኡ ማዝቃለል አፋ ኤዛ ሶቶዳር ዎንታፕ ሀይ ሳተ። <verse eid="MRK 15:25"/><verse number="26" style="v" sid="MRK 15:26"/>ኡንቲ፥ «አይሁድታይ ካታ» ዬጊ ኤዛ ሞትዛ ጹፈ ጻፊ ጋዴዛ። <verse eid="MRK 15:26"/><verse number="27" style="v" sid="MRK 15:27"/>የሱሳር ናምኢ ፓንታ ፐታ ኤዝፕ ኡሻች ባጋር Ꮊንካ ኤዝፕ ሀድርስ ባጋር ማዝቃለል አፋ ሶቴዛ። <verse eid="MRK 15:27"/><verse number="28" style="v" sid="MRK 15:28"/>ጌሻ ማጻፈ፥ «ኢታ ባዝ ኦዝ አስታይር ኤ ታይብንቴዛ» ዬግንቴዛይ ፖልንቴዛ።<note caller="+" style="f"><char style="fr" closed="false">15:27-28 </char><char style="ft" closed="false">ኢሳ። 53:12 ብኒ ኩሸር ጻፍንቴዝ ማጻፍታይድ Ꮊ ቁጹራይ ባያ</char></note><verse eid="MRK 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 15:29"/>ኦገር ኣዝ አሳይ የሱሳ ቶቺ፥ ፋ ኦማ ኤንእሲ ጫዤዛ፤ «የዝን! ጾስ ካራ ላሊ ሀይ ጋላሳ ጋንጨ ኬጽዛዮ፥<note caller="-" style="x"><char style="xo" closed="false">15:29 </char><char style="xt" closed="false"><ref loc="PSA 22:7">ማዝ. 22:7</ref>፤ <ref loc="PSA 109:25">109:25</ref>፤ <ref loc="MRK 14:58">ማር. 14:58</ref>፤ <ref loc="JHN 2:19">ዋን. 2:19</ref></char></note> <verse eid="MRK 15:29"/><verse number="30" style="v" sid="MRK 15:30"/>አን ማዝቃላይፕ ሱለ ዎ ነና አሾባ» ዬጌዛ።<verse eid="MRK 15:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31"/>የይ ጋርከካ፥ ቄሰ ሀላቅታይ ህገ ታማርስዝታይር ዎላ የሱሳ ቶቺ «Ꮊንክታ አሼዛ፥ ዝን ፋና አሾዳይስ ዳንዳኦያ፤ <verse eid="MRK 15:31"/><verse number="32" style="v" sid="MRK 15:32"/>ኑ ብኢ አማኖድ ጋርክ ክርስቶሳ፥ ኤ እስሬለ ካትዛኮ፥ አን ማዝቃላይፕ Ꮊት ዎ» ዬጌዛ። ማ ሀራ አቶዝን፥ ኤዛር ማዝቃለል አፋ ሶትንቴዝታይካ ኤዛ ቶቼዛ።<verse eid="MRK 15:32"/></para>
  <para style="s1">የሱሳ Ꮊይቆ</para>
  <para style="r">(<ref loc="MAT 27:45-56">ማቶ. 27:45-56</ref>፤ <ref loc="LUK 23:44-49">ሉቃ. 23:44-49</ref>፤ <ref loc="JHN 19:28-30">ዋን. 19:28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33"/>ኡሱፑን ሳተፕ አይኪ፥ ኡዱፉን ሳተ ሄሎዳይስ ቢታ ኡባይ ሜዛ። <verse eid="MRK 15:33"/><verse number="34" style="v" sid="MRK 15:34"/>ኡዱፉን ሳተል የሱሳ ፋ ቃላ ቅ ኡዲ፥ «ኤሎሄ፥ ኤሎሄ፥ ላማ ሳባቅታኒ?» ዬጊ ኡኬዛ። የያ ጉሳይ፥ «ታ ጾሳዮ፥ ታ ጾሳዮ፥ ታና አብስ አሼነ?» ጉሲ።<note caller="-" style="x"><char style="xo" closed="false">15:34 </char><char style="xt" closed="false"><ref loc="PSA 22:1">ማዝ. 22:1</ref></char></note><verse eid="MRK 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35"/>ያ አቃይድ ኤቄዝ አሳይፕ ፐታይ ፐታይ የያ ስኢ፥ «ዬዛኮ፥ ኤላሳ ጼግዛ» ዬጌዛ። <verse eid="MRK 15:35"/><verse number="36" style="v" sid="MRK 15:36"/>የ አሳይፕ ፐታይ ላሲ፥ ዛንዛር ጫላ ዎይነ ኩን፤ ጉፈ ጼራል ጋዲ፥ «ናጎይታ፤ ኤላሳ ማዝቃላይፕ ኤዛ ዎዳይስ የኦዳዛኮ አን ዎላ በአዳ» ዬጊ የሱሳ ዶናይኮ ኡሾዳይስ ሺሼዛ።<note caller="-" style="x"><char style="xo" closed="false">15:36 </char><char style="xt" closed="false"><ref loc="PSA 69:21">ማዝ. 69:21</ref></char></note><verse eid="MRK 15:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37"/>የሱሳ ፋ ቃላ ቅ ኡዲ ኡኪ፥ Ꮊይቄዛ።<verse eid="MRK 15:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38"/>ጾስ ካራ ሶትንቴዝ ማጋራዣይ ኣፋፕ ሳአ ሄሎዳይስ፥ ናምኢ ከዚ ፐርእንቲ ዎዛ።<note caller="-" style="x"><char style="xo" closed="false">15:38 </char><char style="xt" closed="false"><ref loc="EXO 26:31">ከስ 26:31</ref></char></note> <verse eid="MRK 15:38"/><verse number="39" style="v" sid="MRK 15:39"/>ማዝቃላይፕ ቲና ባጋር ኤዛይድ ኤቄዝ ፐቲ ማቶ ሀላቃይ፥ የሱሳ ዋይዚ Ꮊይቄዛኮ ብኢ «Ꮊ አይ ቱማ ጾስ ናአ» ዬጌዛ።<verse eid="MRK 15:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40"/>ያ ሃኮር ኤቂ ብእዛ ማችታይ የዛ። ኡ ጋንጨ ማግዴላ ማይራማ፥ ጌዶ ናአ ያይቆባስኔ ዮሳ እንዳት ማይራምራኔ ሳሎምራ የዛ። <verse eid="MRK 15:40"/><verse number="41" style="v" sid="MRK 15:41"/>የ ማች አስታይ የሱሳ ጋልላ ቢታ የዝ ዎደ ኤዛ ካለዝታኔ ኤዛ ሞኬዝታ። ማ የሱሳር ዎላ የሩሳላመ Ꮊንጌዝ ሀራ ጋመ ማች አስታይ ኤዛይድ የዛ።<note caller="-" style="x"><char style="xo" closed="false">15:40-41 </char><char style="xt" closed="false"><ref loc="LUK 8:2-3">ሉቃ. 8:2-3</ref></char></note><verse eid="MRK 15:41"/></para>
  <para style="s1">የሱሳ ሞግንቴዛ</para>
  <para style="r">(<ref loc="MAT 27:57-61">ማቶ. 27:57-61</ref>፤ <ref loc="LUK 23:50-56">ሉቃ. 23:50-56</ref>፤ <ref loc="JHN 19:38-42">ዋን. 19:38-42</ref>)</para>
  <para style="p">
    <verse number="42-43" style="v" sid="MRK 15:42-43"/>ሳአይ ኦማርሴዝ ግሾስ ሺቄዝ አሳይ ጋንጨ ቦንችንቴዝ አይሁደ ሻንግታይፕ ፐታይ፥ ዮሴፋ ግዝ አይ፥ ጾስ ካተትይ የኦዳ ጊታር የዛይ፥ አርማታሳ ካታማ አሳይ የኤዛ። ዎንት ማላ ዎንትዛ ጋላስ ማቄዝ ግሾ ዮሴፋ ሚንጊ ጵላጾሳክ Ꮊንጊ፥ የሱሳ አሃ ኤኮዳይስ ዎሴዛ። <verse eid="MRK 15:42-43"/><verse number="44" style="v" sid="MRK 15:44"/>ጵላጾሳካ የሱሳ Ꮊይቃ ስኢ ማላባዝ ጌዛ፤ ማቶ ሀላቃ ጼጊ፥ «ኤ Ꮊይቂ ጋምኤነኔ?» ዬጊ ኦይጬዛ። <verse eid="MRK 15:44"/><verse number="45" style="v" sid="MRK 15:45"/>ጵላጾሳ የሱሳ Ꮊይቃ ማቶ ሀላቃይፕ ስኢ ኤ አሃ ዮሴፋስ እንጌዛ። <verse eid="MRK 15:45"/><verse number="46" style="v" sid="MRK 15:46"/>ዮሴፋ ሞጎ አፍላ ዎንጊ፤ የሱሳ አሃ ማዝቃላይፕ ዎ፥ አፍላር ጻጺ፥ ዛላፕ ዎጭንቴዝ ዱፎ ጋንጨ ሞጌዛ። ማ የ ዱፋይ ዶናይድ ዳማ ሹች ጎልእሲ ጋዴዛ። <verse eid="MRK 15:46"/><verse number="47" style="v" sid="MRK 15:47"/>ማግዴላ ማይራምራ ዮሳ እንዳት ማይራምራ የሱሳ አሃ ኡንቲ አባ ጋድዛኮ ብእዛ።<verse eid="MRK 15:47"/></para>
  <chapter eid="MRK 15"/>
  <chapter number="16" style="c" sid="MRK 16"/>
  <para style="s1">የሱሳ Ꮊይቆፕ ደንዴዛ</para>
  <para style="r">(<ref loc="MAT 28:1-8">ማቶ. 28:1-8</ref>፤ <ref loc="LUK 24:1-12">ሉቃ. 24:1-12</ref>፤ <ref loc="JHN 20:1-10">ዋን. 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1"/>ማላ ጋላሳይ ኣዛይፕ ጉየ ማግዴላወ ማይራሞ፥ ያይቆባ እንዳት ማይራማኔ ሳሎመ Ꮊንጊ፥ የሱሳ አሃ ትዦዳይስ ሽቶ ዎንጌዛ። <verse eid="MRK 16:1"/><verse number="2" style="v" sid="MRK 16:2"/>ዎጋ ጋላስ ጉራ ዠርክዠርኮ ጻልቀ ከሳዳር፥ ዱፎ Ꮊንጌዛ። <verse eid="MRK 16:2"/><verse number="3" style="v" sid="MRK 16:3"/>ኡ ፋ ጋንጨ ፐታቲ ፐታትራ፥ «ዱፋይ ዶናፕ ኑስ ሹቻ ኦኖ ጎልእሲ ሃሶዳይ?» ዬጊ ዎላ ኦድንቴዛ።<verse eid="MRK 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 16:4"/>ኡ በአዳር የ ዳም አቴዝ ሹቻይ ጎልአልኢ ሀልኤዛና በኤዛ። <verse eid="MRK 16:4"/><verse number="5" style="v" sid="MRK 16:5"/>የሱሳ ሞግንቴዝ ዱፋይ ጋንጨ ገሎዳር ፐቲ የላጋ አይ ቦ አፍላ ማኢ፥ ኡሻች ባጋር በቴዛና ብኢ ዳጋሜዛ።<verse eid="MRK 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6"/>ዝን ኤ ኡንትኮ፥ «ዳጋምፓተ፤ ማዝቃለል አፋ ሶትንቴዝ፥ ናዝረተ የሱሳ ይ ኮይዛና ታ ኤርዛ። ኤ Ꮊይድ ባያ፥ Ꮊይቆፕ ደንዴዛ። ኡ ኤዛ ሞጌዝ አቃ Ꮊያ ቦኦይታ። <verse eid="MRK 16:6"/><verse number="7" style="v" sid="MRK 16:7"/>Ꮊት Ꮊንጊ የሱሳ ታማርታይስኔ ጵጽሮሳስ፥ ‹የሱሳ ይንታፕ ቲናቲ ጋልላ ኣዛ። ኤ ይንትስ ኦዴዛይ ጋርክ ይ ኤዛ ኤዛይድ በአዳ› ዬጊ ኦዶይታ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">16:7 </char><char style="xt" closed="false"><ref loc="MAT 26:32">ማቶ. 26:32</ref>፤ <ref loc="MRK 14:28">ማር. 14:28</ref></char></note><verse eid="MRK 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8"/>ማችታይ ያሻር ኩኩርታር ዱፋይፕ ከዚ ላሲ ቅቴዛ። ማ ኡ ያሽቴዝ ግሾስ የያ ኦስካ አብካ ኦደካያ።<note caller="+" style="f"><char style="fr" closed="false">16:8 </char><char style="ft" closed="false">ፐቲ ፐቲ ብኒ ማጻፍታይ ማርቆሳ ዎንግለ ታይቦ 8ናል አፋ ኤስዛ። ማ ፐቲ ፐቲ ማጻፍታይ ታይቦ 9-20 ሄሎዳይስ የዝ ቆፋና ጉጆያ። ማቆዝን፥ ታይቦ 8 ካል የዛና ጉጅዛ። የይካ [ማችታይ Ꮊንጊ፥ ኪታንቻይ ኦዴዝ ባዝ ኡባ ጵጽሮሳስኔ ኤዛር የዝታይስ ቃንር ኦዴዛ። የይፕ ጉየ፥ የሱሳ ፋ ታማርታ ጌሽኔ መናስ አሽዛ ዎንግለ ኪታ አዋ ከሳፕ አዋ ገሎ ሄሎዳይስ ኪቴዛ]</char></note><verse eid="MRK 16:8"/></para>
  <para style="s1">የሱሳ ማግዴላ ማይራምስ በንቴዛ</para>
  <para style="r">(<ref loc="MAT 28:9-10">ማቶ. 28:9-10</ref>፤ <ref loc="JHN 20:11-18">ዋን. 20:11-18</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9"/>የሱሳ Ꮊይቆፕ ደንዴዛይፕ ጉየ ዎጋ ጋላስ ጉራ፥ ላፑን ቱና አያንታ እዝፕ ኤ ከሴዝ ማግዴላ ማይራምስ ቲናቲ በንቴዛ። <verse eid="MRK 16:9"/><verse number="10" style="v" sid="MRK 16:10"/>እዛ Ꮊንጊ ቲና ኤዛር የዝታይስ፥ ኡ አዛንታራኔ ዬክታር የዝን ኦዴዛ። <verse eid="MRK 16:10"/><verse number="11" style="v" sid="MRK 16:11"/>ዝን የሱሳ ፓ የዛናኔ እዝስ በንቴዛና ኡ ስኤዝ ዎደ እዛ ግዛ አማነካያ።<verse eid="MRK 16:11"/></para>
  <para style="s1">የሱሳ ፋ ናምኢ ታማርታይስ በንቴዛ</para>
  <para style="r">(<ref loc="LUK 24:13-35">ሉቃ. 24:13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12"/>የይፕ ጉየ፥ ኡንታፕ ናምእታይ ካታማፕ ከዚ Ꮊማዳር፥ ኦገላ የሱሳ ቲናሳይፕ ዱማቲ ኡንትስ በንቴዛ። <verse eid="MRK 16:12"/><verse number="13" style="v" sid="MRK 16:13"/>ኡ ጉየ ማቂ፥ ሀራ አሳይስ ኦዴዛ፥ ዝን ሀራ አሳይካ ኡ ኦዳ ቱማ ጌካያ።<verse eid="MRK 16:13"/></para>
  <para style="s1">የሱሳ ፋ ታጶ ፐቲ ታማርታይስ በንቴዛ</para>
  <para style="r">(<ref loc="MAT 28:16-20">ማቶ. 28:16-20</ref>፤ <ref loc="LUK 24:36-49">ሉቃ. 24:36-49</ref>፤ <ref loc="JHN 20:19-23">ዋን. 20:19-23</ref>፤ <ref loc="ACT 1:6-8">ሀዋ. ኦ. 1:6-8</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14"/>ጉየፕ ታጶ ፐቲ ኤ ታማርታይ ካ ማዳር፥ የሱሳ ኡንትስ በንቴዛ። ኡንትስ አማኖ ባዛይ ግሾኔ Ꮊይቆፕ ኤ ደንዴዛና በኤዝ አሳይ ኦድን ኡ አማናም እጼዛይስ ኤ ኡንታን ቦሬዛ።<verse eid="MRK 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 16:15"/>ኤ ኡንትኮ፥ «ቢታ ኡባይል Ꮊንጊ አስ ኡባይስ ዎንግለ ኦዶይታ።<note caller="-" style="x"><char style="xo" closed="false">16:15 </char><char style="xt" closed="false"><ref loc="ACT 1:8">ሀዋ. ኦ. 1:8</ref></char></note> <verse eid="MRK 16:15"/><verse number="16" style="v" sid="MRK 16:16"/>አማኔዛይኔ ጻማቅንቴዛይ አቶዳ፥ ዝን አማነካዛይ ፕርድንቶዳ። <verse eid="MRK 16:16"/><verse number="17" style="v" sid="MRK 16:17"/>አማንዝታይስ Ꮊ ማላትታይ እንግንቶዳ። ኡ ታ ሱንይር ቱና አያንታ ከሶዳ፥ ኦሮ ዶና ናሾዳ። <verse eid="MRK 16:17"/><verse number="18" style="v" sid="MRK 16:18"/>ኡ ሾሽ አይክኮ ዎይ ዎዛ ባዝ ኡዥኮካ ኡንታን ቆሃሚ። ማ ኡ ፋ ኩሸ ሀርግንቴዝታይል አፋ ጋዲ ኡንታን ፓዳ» ዬጌዛ።<verse eid="MRK 16:18"/></para>
  <para style="s1">የሱሳ ፑደ ደንዲ ሳሎ ከዜዝ</para>
  <para style="r">(<ref loc="LUK 24:50-53">ሉቃ. 24:50-53</ref>፤ <ref loc="ACT 1:9-11">ሀዋ. ኦ. 1:9-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19"/>ጎዳ የሱሳ ታማርታይራ ናሼዛይፕ ጉየ ፑደ ደንዲ ሳሎ ከዜዝ፤ ጾሳፕ ኡሻች ባጋር በቴዛ።<note caller="-" style="x"><char style="xo" closed="false">16:19 </char><char style="xt" closed="false"><ref loc="ACT 1:9">ሀዋ. ኦ. 1:9</ref></char></note> <verse eid="MRK 16:19"/><verse number="20" style="v" sid="MRK 16:20"/>ኤ ታማርታይ Ꮊንጌዝ አቆ ኡባይድ ቃላ ኦዴዛ። ጎዳይካ ኡንታር ዎላ ኦዛ። ኡ ኦድዛ ቃላይ ቱማ ማቄዛ ጾሳይ ኡንትስ እንግዛ ማላይር ፋ ቃላ ሚንዛ።<verse eid="MRK 16:20"/></para>
  <chapter eid="MRK 16"/>
</usx>
