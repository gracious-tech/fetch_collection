<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1PE" style="id">- Melo New Testament Ethiopic</book>
  <para style="h">1ጵጽሮሳ</para>
  <para style="toc1">ጵጽሮሳ ጻፌዝ ቲና ኪታ</para>
  <para style="toc2">1ጵጽሮሳ</para>
  <para style="toc3">1ጵጽ.</para>
  <para style="mt1">ጵጽሮሳ ጻፌዝ ቲና ኪታ</para>
  <para style="imt">ገሎ</para>
  <para style="ip">ሀዋረ ጵጽሮሳ ጻፌዝ ቲና ኪታይ ጻፍንቴዛይ፥ «ዶርንቴዝ ጾስ አስታ» ግንትንቲ ጼግንቴዝታይስኔ ጽቃ ኢስያ ጋደ ፑደ ባጋ ላልንቴዝ አማንዛ አሳይስ። Ꮊ ኪታይስ ኣፈ ቆፋይ፥ አማኖፕ ደንዴዛይድ መቶኔ ዋየ ሄሌዝ አሳ ምንዳይሲ። Ꮊ ማጻፋቶ ጻፌዛይ፥ የሱሳ Ꮊይቆ፥ ኤ ደንዶ፥ ኤ ናምእን ይእ ኦድዛ የሱስ ክርስቶሳ ዎንግለ ቃላ ኡንታን ቆፕስዛ። የሱስ ክርስቶሳ ደኦ ኣዝሶ ኡዲ ብኢ፥ መቶ ዳንዳአር ካንድ ጋርክ ኡንታን ቆፍስዛ። የይር ዎል ሄል፥ መቶ ኡ አማናይ ጌሸት ፓጭዛኔ፥ «የሱስ ክርስቶሳ ቆንጭዝ ጋላስ» ቤዝዛ ዎይቶ ኡንቲ ኤኮዳይስ የዛና ቆፕስዛ።</para>
  <para style="ip">ጻፋይ፥ ኡንቲ መቶ ዳንዳኦድ ጋርክ ምንይል አፋ ክርስቶሳ ካልዛ አስታይ የዞዳይስ ቤዝዛ የስ የሳዳይ ጋርክ ቆፍስዛ።</para>
  <para style="iot">1 ጵጽሮሳ ኪታይ አይኬዝ ቆፍታ</para>
  <para style="io1">ሳሮ <char style="ior"><ref loc="1PE 1:1-2">1:1-2</ref> </char></para>
  <para style="io1">ጾሲ ኑስ እንጌዝ አቶት <char style="ior"><ref loc="1PE 1:3-12">1:3-12</ref> </char></para>
  <para style="io1">ጌሸት የስ <char style="ior"><ref loc="1PE 1:13-2:10">1:13—2:10</ref> </char></para>
  <para style="io1">መቶ ዎደ አማንዛ አሳይ ሀኖዳይስ ቤዝዛ ባዝ <char style="ior"><ref loc="1PE 2:11-4:19">2:11—4:19</ref> </char></para>
  <para style="io1">ክርስታንታይ ሃዮትኔ ኦሶ <char style="ior"><ref loc="1PE 5:1-11">5:1-11</ref> </char></para>
  <para style="io1">ኩስተ ቆፋ <char style="ior"><ref loc="1PE 5:12-14">5:12-14</ref> </char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="1PE 1"/>
  <para style="p">
    <verse number="1" style="v" sid="1PE 1:1"/>ታኒ፥ የሱስ ክርስቶሳ ሀዋራይ ጵጽሮሳ፤ ጳንጾሳ፥ ጋላትያ፥ ቃጳዶቃ፥ ኢሳኔ ብታና ጋደ በተ አስ ጋርክ ላልንቲ የዝ ጾሲ ዶሬዝ፥ አሳይስ Ꮊ ዳብዳባ ጻፌዛ። <verse eid="1PE 1:1"/><verse number="2" style="v" sid="1PE 1:2"/>የሱስ ክርስቶሳስ ይ ኪትንቶድ ጋርከኔ ኤ ሱይር ጌዦዳይ ጋርከ፥ ጾስ አዳይ ፋ ቲና ኤራር ዶሬዝታይስኔ ጌሻ አያናር ጌዤዝ፥ ይንትስ ኣ ኬሃትኔ ሳሮት ማቆ።<verse eid="1PE 1:2"/></para>
  <para style="s1">መና ኡፋይስ</para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 1:3"/>የሱስ ክርስቶሳና Ꮊይቆፕ ደን ፋ ግታ ማሮትይር ናምአን የልንታይር ቦዋ ኡፋይስ እንጌዝ ኑ ጎዳ የሱስ ክርስቶሳ አዳይ፥ ጾሳይ ጋላትንቶ። <verse eid="1PE 1:3"/><verse number="4" style="v" sid="1PE 1:4"/>ማ ጾሲ ይንትስ ቦዋ፥ ኢቶዛኔ ቡቆዋ ጋደ ሳሎ ጊግሴዛ። <verse eid="1PE 1:4"/><verse number="5" style="v" sid="1PE 1:5"/>የ ላታይ ዎደ ዉርስ ቆንጮዳይስ የዝ አቶትስ ጾስ ዎልቃር አማኖር ይንትስ ናግንቲ የዛ።<verse eid="1PE 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1PE 1:6"/>Ꮊት ጽቃ ዎደስ ይ ዱማ ዱማ ፓጨር ኡንእንትኮካ የይድ ኡፋይቶይታ። <verse eid="1PE 1:6"/><verse number="7" style="v" sid="1PE 1:7"/>የ ፓጫይ ይንታን ሄሌዛይ፥ ታማ ኦልን ብዛ ዎርቀፕ ይ አማናይ ኣኔ ቱማ ማቄዛና ቤዝዛ። የ ፓጭንቴዝ አማናይድ የሱስ ክርስቶሳ ማቂ የኦዳር ጋላታ፥ ቦንቾኔ ሳባ ይ ኤኮዳ። <verse eid="1PE 1:7"/><verse number="8" style="v" sid="1PE 1:8"/>ይ የሱሳ በኤካያ፥ ዝን ኤዛ ሲቅዛ። ይ Ꮊት ኤዛ በኤካ ባዝ ማቅኮካ፥ ኤዛ አማንዛ። ማ ኦዳር ቆንጭሶዳይስ ዳንዳእንቶዋ ኡፋይሳራኔ ቦንቾር ኩሜዛ። <verse eid="1PE 1:8"/><verse number="9" style="v" sid="1PE 1:9"/>ይ አማኖር ናግዛ ይ ሸምፖ አቶት ኤኮዳ።<verse eid="1PE 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 1:10"/>ኣ ኬሄትይ ባጋር ይንትስ ማቄዝ Ꮊ አቶትይ ባጋ ናብታይ ኤሮዳይስ ሎእ ፕላጊ ኮዬዛ። <verse eid="1PE 1:10"/><verse number="11" style="v" sid="1PE 1:11"/>ኡ ጋንጨ የዝ ክርስቶሳ አያናይ ኤዛ ሄሎድ ዋያኔ የይፕ ጉየ የኦድ ቦንቾ ባጋ ቲናቲ ማርካትታር፥ አይደ ዎይ ዋይዚ ሀኖዳዛኮ አካካር ፕላጊ ኮዬዛ። <verse eid="1PE 1:11"/><verse number="12" style="v" sid="1PE 1:12"/>ናብታይ ኦዴዝ ትንቢታይ ፓስ ባዝን ይንትስ ማቄዛና ጾሲ ኡንትስ ቆንጭሴዛ። Ꮊት አሳይ ይንትስ ኦዴዝ ዎንግለ ሳሎፕ ኪትንቴዝ ጌሻ አያና ዎልቃር ይንትስ ኦዴዛ። ኪታንችታይካ የያ በአዳይስ አሞትዛ።<verse eid="1PE 1:12"/></para>
  <para style="s1">ጌሻትር የስ</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 1:13"/>የይ ግሾስ፥ ይ ዎዝና ባርክ ኦሶስ ጊግንቲ፤ ይንታን ሞዲ የሱስ ክርስቶሳ ማቂ የኦዳር ይ ኤኮድ ኣ ኬሃት ኡፋይሳር ናጎይታ። <verse eid="1PE 1:13"/><verse number="14" style="v" sid="1PE 1:14"/>ኪትንትዛ ናእታ ኣዚ ኤረካዛር ቲና ይ የዜዝ ኢታ አሞ ካልፓተ። <verse eid="1PE 1:14"/><verse number="15" style="v" sid="1PE 1:15"/>ዝን ይንታን ጼጌዝ ጾሳይ ጌሺ ማቄዛይ ጋርክ ይንትካ ይ የሳ ኡባይድ ጌሽታ ማቆይታ። <verse eid="1PE 1:15"/><verse number="16" style="v" sid="1PE 1:16"/>ጌሻ ማጻፋይድ፥ «ታኒ ጌሽ ማቄዝ ግሾስ ይንትካ ጌሽታ ማቆይታ» ግንትንቲ ጻፍንቴዛ።<note caller="-" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="LEV 11:44-45">ለዊ. 11:44-45</ref>፤ <ref loc="LEV 19:2">19:2</ref></char></note><verse eid="1PE 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 1:17"/>አስ ስኖ በኤካዛር ፐታይስ ፐታይስ ኤ ኦሳይ ጋርክ ፕርድዛ ጾሳ፥ «አደ» ግ ጼግዝ ባዝ ማቅኮ፥ Ꮊ ሳአ እማት የሳ ያሻር የዞይታ። <verse eid="1PE 1:17"/><verse number="18" style="v" sid="1PE 1:18"/>ይ፥ ይ አድታይፕ ላቴዝ ፓዋ የሳይፕ ዎዝንቴዛይ፥ ብዛ ብራር ዎይ ዎርቃር ባዛና ይ ኤርዛ። <verse eid="1PE 1:18"/><verse number="19" style="v" sid="1PE 1:19"/>ቦሮ ዎይ ቦርሶ ባ ዱር ማቄዝ አልኦ ክርስቶሳ ሱር ይ ዎዝንቴዛ። <verse eid="1PE 1:19"/><verse number="20" style="v" sid="1PE 1:20"/>ኤ አላመ መንቶዳይፕ ቲና ኤርንቴዛ፥ ዝን Ꮊ ዉርስ ዎደ ይ ግሾስ ቆንጬዛ። <verse eid="1PE 1:20"/><verse number="21" style="v" sid="1PE 1:21"/>ይ አማናይኔ ይ ኡፋይሳይ ጾሳል ማቆዳይ ጋርክ ጾሲ ኤዛ Ꮊይቆፕ ደን፥ ቦንቼዝ ክርስቶሳ ባጋር ጾሳል አማንንቶዳ። <verse eid="1PE 1:21"/><verse number="22" style="v" sid="1PE 1:22"/>ይ ቱማስ አዛዝንትታር ኡትራባይ እሸት ሲቆር ሚን ዎልር ዎዝናፕ ሲቆይታ።<verse eid="1PE 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1PE 1:23"/>ይ ናምአን የልንቴዛይ ብዛ ዘርፕ ባዝን መናስ የዝ ጾስ ቃላይድ ቦዋ ሼሻፕ የልንቴዛ። <verse eid="1PE 1:23"/><verse number="24" style="v" sid="1PE 1:24"/>ጾስ ቃላይ፥</para>
  <para style="q1" vid="1PE 1:24">«አሾ ማኤዝ ኡባይ ማታ ጋርከ፤</para>
  <para style="q2" vid="1PE 1:24">ኤ ቦንቻይ ኡባይካ ማታ ፉ ጋርከ።</para>
  <para style="q1" vid="1PE 1:24">ማታይ መልዛ፥ ፉታይካ ጉፍዛ።<note caller="-" style="x"><char style="xo" closed="false">1:24-25 </char><char style="xt" closed="false"><ref loc="ISA 40:6-8">ኢሳ. 40:6-8</ref></char></note><verse eid="1PE 1:24"/></para>
  <para style="q2">
    <verse number="25" style="v" sid="1PE 1:25"/>ዝን ጎዳይ ቃላይ መናስ ሚንጊ የዞዳ»</para>
  <para style="m" vid="1PE 1:25">ዬግዛ። ይንትስ ኦድንቴዝ ዎንግለ ቃላይ Ꮊያ።<verse eid="1PE 1:25"/></para>
  <chapter eid="1PE 1"/>
  <chapter number="2" style="c" sid="1PE 2"/>
  <para style="s1">ደኦ ሹችኔ ዶርንቴዝ ዎያ</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 2:1"/>ይኬ ኢታት ኡባ፥ ዶሻ ኡባ፥ ጩቦት ቅናተኔ ዝግርስ ኡባ ይንትፕ ሃሶይታ። <verse eid="1PE 2:1"/><verse number="2-3" style="v" sid="1PE 2:2-3"/>ጎዳይ ኬሃ ማቄዛና ይ ኤሬዛይ ጋርክ Ꮊት የልንቴዝ ጽቃ ናእታይ ጋርክ ይ አቶትር ድጮዳይስ ገነ ባ ቃላ ማስ ኡባ ዎደ አሞቶይታ።<note caller="-" style="x"><char style="xo" closed="false">2:2-3 </char><char style="xt" closed="false"><ref loc="PSA 34:8">ማዝ. 34:8</ref></char></note><verse eid="1PE 2:2-3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1PE 2:4"/>አሳር ቦርንቲ ጾሳር ዶርንቴዝ ቦንቾ ማቄዝ ሹች፥ ጎዳ የሱሳኮ ሺቆይታ። <verse eid="1PE 2:4"/><verse number="5" style="v" sid="1PE 2:5"/>ይ ደኦ ሹችታ ማቂ፥ የሱስ ክርስቶሳ ባጋር ጾስ ኡፋይስዛ አያና ያርሾ ያርሽዛ ጌሽ ቄስታ ማቆዳይ ጋርክ አያና ኬ ማቂ ኬጽንቶይታ። <verse eid="1PE 2:5"/><verse number="6" style="v" sid="1PE 2:6"/>ጌሻ ማጻፋይድ፥</para>
  <para style="q1" vid="1PE 2:6">«ዬዛኮ፥ ታኒ ጽዮነ ካታማ ኬ ሙመር ቶኪ አይክዝ ክርክሮ ጋርክ፥</para>
  <para style="q2" vid="1PE 2:6">ዶርንቴዝ፥ ቦንቾ ሹች ጋዶዳ፤</para>
  <para style="q2" vid="1PE 2:6">ኤዛ አማንዛ ኦንካ የሻ ዬላታሚ»</para>
  <para style="m" vid="1PE 2:6">ዬግዛ።<note caller="-" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="ISA 28:16">ኢሳ. 28:16</ref></char></note> <verse eid="1PE 2:6"/><verse number="7" style="v" sid="1PE 2:7"/>Ꮊ ሹቻይ ይንትስ አማንዝታይስ ቦንቾ፥ ዝን አማኖዋዝታይስ፥</para>
  <para style="q1" vid="1PE 2:7">«ግምቢዝታይ ለቂ እጼዝ ሹቻይ</para>
  <para style="q2" vid="1PE 2:7">ኬ ሙመር ቶኪ አይክዝ ክርክሮ ጋርክ፥</para>
  <para style="q2" vid="1PE 2:7">ኡባይፕ ኣዝ ሹች ማቄዛ።»<note caller="-" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="PSA 118:22">ማዝ. 118:22</ref></char></note><verse eid="1PE 2:7"/></para>
  <para style="m">
    <verse number="8" style="v" sid="1PE 2:8"/>ማካ፥</para>
  <para style="q1" vid="1PE 2:8">«Ꮊ ሹቻይ አስ ቢዛ ሹችኔ አስ ፖክስዝ ዛላ»</para>
  <para style="m" vid="1PE 2:8">ዬግዛ። ኡንቲ የይስ ቃድንቴዝ ግሾስ ጾስ ቃላ ኪትንታም እጺ ብንቴዛ።<note caller="-" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="ISA 8:14-15">ኢሳ. 8:14-15</ref></char></note><verse eid="1PE 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1PE 2:9"/>ዝን ጾሲ ማፕ ማላልስዛ ፋ ፖአይኮ ይንታን ጼጌዛይ፥ ይ ኤ ሎኦት ሀርታይስ ኦዶዳይስ ዶርንቴዝ ኮች፥ ካት ቄሰ፥ ጌሻ የለትኔ ጾስ ዱማ ዎያ።<note caller="-" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="EXO 19:5-6">ከስ 19:5-6</ref>፤ <ref loc="ISA 43:20-21">ኢሳ. 43:20-21</ref>፤ <ref loc="DEU 4:20">ናምእ. 4:20</ref>፤ <ref loc="DEU 7:6">7:6</ref>፤ <ref loc="DEU 14:2">14:2</ref>፤ <ref loc="TIT 2:14">ትቶ 2:14</ref>፤ <ref loc="ISA 9:2">ኢሳ. 9:2</ref></char></note> <verse eid="1PE 2:9"/><verse number="10" style="v" sid="1PE 2:10"/>ይ ቲና ጾስ ዎያ ባያ፥ ዝን Ꮊት ይ ኤ ዎያ። ይ ቲና ማሮት ደንገካዝታ፥ ዝን Ꮊት ማሮት ደንጌዛ።<note caller="-" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="HOS 2:23">ሆሳ. 2:23</ref></char></note><verse eid="1PE 2:10"/></para>
  <para style="s1">ጾስ አይለ ጋርክ የስ</para>
  <para style="p">
    <verse number="11" style="v" sid="1PE 2:11"/>ታ እሹን፥ ይ Ꮊ ሳአ እማኔ በተ አስ ማቄዛይ ጋርክ ይ ሸምፖ ኦልዛ አሾ አሞፕ ሃኮድ ጋርክ ታኒ ይንታን ዎስዛ። <verse eid="1PE 2:11"/><verse number="12" style="v" sid="1PE 2:12"/>አማኖዋ አሳይ ይንታን ኢታ ኦዝ አስ ጋርክ ዝግርኮ ጾሲ ኑና በአዳይስ ይእዛ ጋላስ፥ ኡንቲ ይ ሎኦ ኦሳ ብኢ ጾስ ጋላቶዳይ ጋርክ ይንትስ ሎኦ ደኦ የዞ።<verse eid="1PE 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 2:13"/>ጎዳይ ግሾስ ግ ማዉተር የዝ አሳይስ ሃርንቶይታ፤ ኡባይፕ አፋ ማቄዝ ግሾስ ካታይስካ ሞድንቶይታ። <verse eid="1PE 2:13"/><verse number="14" style="v" sid="1PE 2:14"/>ኡንቲ ኢታ ኦዝታ ሴሮዳይስኔ ሎኦ ኦዝታ ሳቦዳይስ ካታይፕ ኪትንቴዝ ግሾስ ጋደ አቅዝታይስ ሃርንቶይታ። <verse eid="1PE 2:14"/><verse number="15" style="v" sid="1PE 2:15"/>ይ፥ ይ ሎኦ ኦሶር ኤሮዋ ቦዞ አሳይ ናሻ ዶና አይዳይ ጾስ ሸነ። <verse eid="1PE 2:15"/><verse number="16" style="v" sid="1PE 2:16"/>ጾስ አይለ ማቂ ዋሎ የዞይታፕ አትን ይ ዋሎት ኢታ ኦሶስ ካመ ኡድፓተ። <verse eid="1PE 2:16"/><verse number="17" style="v" sid="1PE 2:17"/>አስ ኡባ ቦንቾይታ፤ አማንዛ አሳ ሲቆይታ፤ ጾስስ ያሽቶይታ፤ ካት ቦንቾይታ።<verse eid="1PE 2:17"/></para>
  <para style="s1">ክርስቶሳ ዋያይስ ኣዝሶ</para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 2:18"/>አይሉን፥ ሎኦ ጎድታይስኔ ኬሃ ጎድታይስ ኣዳ ባዝን ኢትታይስካ ቦንቾር ሃርንቶይታ። <verse eid="1PE 2:18"/><verse number="19" style="v" sid="1PE 2:19"/>አሲ ጾስ ግሾስ ግ ቤዞዋ ዋየ ኤክኮ ጾሲ ኤዛ አንጆዳ። <verse eid="1PE 2:19"/><verse number="20" style="v" sid="1PE 2:20"/>ዝን ይ ናጋራ ኦን ይንታን Ꮊን ይ ዳንዳእኮ ይንትስ አባ ጋላታ የኔ? ዝን ሎኦ ባዝ ኡዲ ዋየ ዳንዳእኮ ጾሲ ይንታን የይስ አንጆዳ። <verse eid="1PE 2:20"/><verse number="21" style="v" sid="1PE 2:21"/>ጾሲ ይንታን ጼጌዛይ የይ ግሾስ፤ ክርስቶሳ ይንትስ ዋይንቴዛ፤ ይ ኤዛ ካሎዳይ ጋርክ፥ ይንትስ ኣዝሶ ማቄዛ። <verse eid="1PE 2:21"/><verse number="22" style="v" sid="1PE 2:22"/>ኤ ናጋራ ኦካያ፤ ኤ ዶናይዳካ ጩቦት በንተካያ።<note caller="-" style="x"><char style="xo" closed="false">2:22 </char><char style="xt" closed="false"><ref loc="ISA 53:9">ኢሳ. 53:9</ref></char></note> <verse eid="1PE 2:22"/><verse number="23" style="v" sid="1PE 2:23"/>ኡንቲ ኤዛ ጫዥዝን ኤ ማሂ ጫዠካያ። ዝን ዋየ ኤክታር ጽሎ ፕርድዛ ጾሳይስ ፋ ፕርዳ አሺ አሸነፕ አትን ማንደካያ።<note caller="-" style="x"><char style="xo" closed="false">2:23፦ </char><char style="xt" closed="false"><ref loc="ISA 53:7">ኢሳ. 53:7</ref></char></note> <verse eid="1PE 2:23"/><verse number="24" style="v" sid="1PE 2:24"/>ኑኒ ናጋራስ Ꮊይቂ ጽሎትስ የዞዳይ ጋርክ ክርስቶሳ ፋ አሻይድ ኑ ናጋራ ማዝቃለል አፋ ቶኬዛ፤ ይ ኤ ማዶይር ፓጼዛ።<note caller="-" style="x"><char style="xo" closed="false">2:24 </char><char style="xt" closed="false"><ref loc="ISA 53:5">ኢሳ. 53:5</ref></char></note> <verse eid="1PE 2:24"/><verse number="25" style="v" sid="1PE 2:25"/>ብኒ ይ ኦገ ባሊ ላልንቲ ቤዝ ዱር ጋርከ፥ ዝን Ꮊት ይ ሸምፖ ሄንግዛይኮኔ ናግዛይኮ ማቄዛ።<note caller="-" style="x"><char style="xo" closed="false">2:25 </char><char style="xt" closed="false"><ref loc="ISA 53:6">ኢሳ. 53:6</ref></char></note><verse eid="1PE 2:25"/></para>
  <chapter eid="1PE 2"/>
  <chapter number="3" style="c" sid="1PE 3"/>
  <para style="s1">አዝን ባጋኔ ማቺ ባጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 3:1"/>ማካ፥ ማችታዮ፥ ይ አዝንታይስ አዛዝንቶይታ። የይ ጋርክ ፐታይ ፐታይ ጾስ ቃላ አማኖዝታ ማቅኮካ ፋ ማችታይ ሀና ብኢ ቃላ ኦደካዝን አማኖዳይስ ዳንዳእዛ። <verse eid="1PE 3:1"/><verse number="2" style="v" sid="1PE 3:2"/>አማኖዳይስ ዳንዳእዛይ ያሻትራኔ ይ ጌሽ የሳ ብኢ።<note caller="-" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="EPH 5:22">ኤፍ. 5:22</ref>፤ <ref loc="COL 3:18">ቆላ. 3:18</ref></char></note> <verse eid="1PE 3:2"/><verse number="3" style="v" sid="1PE 3:3"/>ይ፥ ይ ኦማ ዳራኔ ዎርቀ ኣር ዎይ ሎኦ ማኦር ቡቁርንቶር ይ አሲ ቤዞር ማቅፐ።<note caller="-" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="1TI 2:9">1ጽማ. 2:9</ref></char></note> <verse eid="1PE 3:3"/><verse number="4" style="v" sid="1PE 3:4"/>ዝን ይ ዎዝናይ ጋንጨ የዝ የገልሳትይ ጾስ ቲና ይንትስ ጋመ አልኦ ማቂ ቦዋ፥ አሽከኔ ዳጭ ጌዝ አያና ማቆ። <verse eid="1PE 3:4"/><verse number="5" style="v" sid="1PE 3:5"/>ጾሲ እንጎድ ጌዛና አማኔዝ ጌሽ ማችታይ ብኒ ዎደ ፋ አዝንታይስ ሃርንቲ፥ ፋና የይ ጋርክ ኡሳ ሎእዛ። <verse eid="1PE 3:5"/><verse number="6" style="v" sid="1PE 3:6"/>የይ ጋርክ ሳራ አፍራመና፥ «ታ ጎዳዮ» ዬጊ ጼግታር፥ ኤስ ኪትንቴዛ፤ አኮካ ያሽተካር ሎኦ ባዝ ኦኮ ይንትካ እ ናእታ።<note caller="-" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="GEN 18:12">መ. 18:12</ref></char></note><verse eid="1PE 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 3:7"/>አዝንታዮ፥ ይ ማችታይ ይንትፕ ዳቡራ መ ማቄዛና ኤሪ፥ ኡንታን ቦንቾይታ፤ ይ ዎሳ ባማይ ጋርክ ጾሲ እንጌዝ ደኦ ኡንቲ ይንታር ዎላ ላትዛ ግሾስ ኡንታን ቦንቾይታ።<note caller="-" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="EPH 5:25">ኤፍ. 5:25</ref>፤ <ref loc="COL 3:19">ቆላ. 3:19</ref></char></note><verse eid="1PE 3:7"/></para>
  <para style="s1">ሎኦ ኦሶር መቶ ኤኮ</para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 3:8"/>Ꮊንፕ ጉየ፥ ኡቢታይ ፐቲ ቆፋር የዞይታ። Ꮊንክታይ መታይ ይንታን ሄሌዛይ ጋርክ ኡዶይታ፥ እሸት ሲቆር ዎል ሲቆይታ፤ ማ ፐታይ ፐታይስ ኬህታኔ አሽክታ ማቆይታ። <verse eid="1PE 3:8"/><verse number="9" style="v" sid="1PE 3:9"/>ኢታ ግሾስ ኢታ ዎይ ጫሽ ግሾስ ጫዢ ማህፓተ፤ የያ አሺ፥ ጾሲ ይንትስ አንጆ እንጎዳይስ ይንታን ጼጌዝ ግሾስ አንጆይታ። <verse eid="1PE 3:9"/><verse number="10" style="v" sid="1PE 3:10"/>አብስ ጊኮ፥ ጌሻ ማጻፋይ፥</para>
  <para style="q1" vid="1PE 3:10">«ደኦ ዶስዛይኔ ሎኦ ጋላስታ በአዳይስ ኮይዝ ኦና ማቅኮካ ፋ እንጻርሳ ኢታባዝኔ መተርሻ ዎርዶ ኦድንትዛና ካዮ።<note caller="-" style="x"><char style="xo" closed="false">3:10-12 </char><char style="xt" closed="false"><ref loc="PSA 34:12-16">ማዝ. 34:12-16</ref></char></note><verse eid="1PE 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="1PE 3:11"/>ኢታ ባዛፕ ሃኮ ሎኦ ባዝ ኦ፤</para>
  <para style="q2" vid="1PE 3:11">ሳሮትካ ኮዮኔ ካሎ።<verse eid="1PE 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="1PE 3:12"/>ጎዳይ ኣፍታይ ጽልታ ብእዛ፤</para>
  <para style="q2" vid="1PE 3:12">ኤ ሀይታይካ ኡባ ዎደ ኡ ዎሳ ስኦዳይስ ዶይንቲ የዛ።</para>
  <para style="q1" vid="1PE 3:12">ዝን ጎዳይ ኢታ ባዝ ኦዝታ ፋ ሸነ ኣፈር ብእዛ»</para>
  <para style="m" vid="1PE 3:12">ዬግዛ።<verse eid="1PE 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 3:13"/>ይ ሎኦ ባዝ ኦዳይስ አሞትኮ ይንታን ካዮዳይ ኦኖ? <verse eid="1PE 3:13"/><verse number="14" style="v" sid="1PE 3:14"/>ሀራ አቶዝን፥ ጽሎት ግሾስ ይ ዋይንትኮ አንጅንቴዝታ። አስስ ያሽቲፓተኔ ህርግፓተ።<note caller="-" style="x"><char style="xo" closed="false">3:14-15 </char><char style="xt" closed="false"><ref loc="MAT 5:10">ማቶ. 5:10</ref>፤ <ref loc="ISA 8:12-13">ኢሳ. 8:12-13</ref></char></note> <verse eid="1PE 3:14"/><verse number="15" style="v" sid="1PE 3:15"/>ክርስቶሳና ይ ዎዝናፕ ቦንቾይታኔ ጎድ ማሆይታ። ይንትስ እንጌዝ ኡፋይሳ ኦይጭዝ ኦስካ ማህ እንጎዳይስ ኡባ ዎደ ጊጊ በቶይታ፥ ዝን የያ ሃዮትራኔ ያሻር ኡዶይታ። <verse eid="1PE 3:15"/><verse number="16" style="v" sid="1PE 3:16"/>ማ ክርስቶሳር ይ የዝ ሎኦ የሳ ኢታ ባዝ ኦዛይ ጋርክ፥ ይንታን ጫዥዛ አሳይኔ ሀዎዝዝታይ ዬላቶዳይ ጋርክ ይ ካሃይ ጌሽ ማቆ። <verse eid="1PE 3:16"/><verse number="17" style="v" sid="1PE 3:17"/>ጾስ ሸነ ማቅኮ ኢታ ባዝ ኦ ዋየ ኤክዛይፕ ሎኦ ባዝ ኦ ዋየ ኤክዛይ ሎኦ። <verse eid="1PE 3:17"/><verse number="18" style="v" sid="1PE 3:18"/>ክርስቶሳ ኑና ጾስኮ ሺሾዳይስ ፋ ኡባስ ጌሽ ማቂ የዛር፥ ናጋራንችታይስ ኡቢታይስ ላማማይስ ፐቲ ቶኬ ናጋራ ግሾስ Ꮊይቄዛ፤ ኤ ፋ አሰትይር Ꮊይቄዛር፥ ዝን አያናር ፓ። <verse eid="1PE 3:18"/><verse number="19" style="v" sid="1PE 3:19"/>ማ የ አያናይር ኤ Ꮊንጊ አች ካራ የዝ ሸምፕታይስ ቃላ ኦዴዛ። <verse eid="1PE 3:19"/><verse number="20" style="v" sid="1PE 3:20"/>ኖሄ ማርካበ ኬጾዳር የ ሸምፕታይ ጾስስ ኪትንታም እጼዛ፥ ዝን ጾስ ኡንታን ዳንዳኤዛ። ሆስፑን አስ ኣዳ ማርካበ ገሊ፥ ፕርዳ ሃፕ አቴዛ።<note caller="-" style="x"><char style="xo" closed="false">3:20 </char><char style="xt" closed="false"><ref loc="GEN 6:1-7:24">መ. 6:1—7:24</ref></char></note> <verse eid="1PE 3:20"/><verse number="21" style="v" sid="1PE 3:21"/>የ ፕርዳ ሃይ Ꮊት ይንታን አሽዛ ጽንቃተ ኣዝሶ ማቄዛ። Ꮊ ጽንቃታይ ጋላ ቅታ ሜጮ ባዝን ሎኦ ካሃር ጾስ ቲና ቃላ ገሎ፥ ክርስቶሳ ደንዶ ባጋር ይንታን አሽዛ። <verse eid="1PE 3:21"/><verse number="22" style="v" sid="1PE 3:22"/>ኤ ሳሎ Ꮊንጊ ጾስ ኡሻቻ በቴዛ፥ ኪታንችታይ፥ ማዉተ አድታኔ ዎልቃምታ ሃርዛ።<verse eid="1PE 3:22"/></para>
  <chapter eid="1PE 3"/>
  <chapter number="4" style="c" sid="1PE 4"/>
  <para style="s1">ጾስስ የዞ</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 4:1"/>ክርስቶሳ ፋ አሾር ኑስ መቶ ኤኬዝ ግሾስ ይንትካ ኦላ ሚሸ ዳንጬዝ አስ ጋርክ የ ቆፋይር ሚንጊ ኤቆይታ። ክርስቶሳ ግሾስ ግ ፋ አሾር ዋየ ኤኬዝ አይ ናጋራ ኦም ግ ሙርቴዝ አሲ። <verse eid="1PE 4:1"/><verse number="2" style="v" sid="1PE 4:2"/>የ አይ ፋ አቴዝ ላይ ጾስ ሸነ ኦዳይስ ኮይነፕ አትን ኢታ አሾ አሞ ፖሎዳይስ ባያ። <verse eid="1PE 4:2"/><verse number="3" style="v" sid="1PE 4:3"/>ብኒ ይ አማኖዋ አሳይ የዜዛይ ጋርክ የዜዛ። ይ ቃይጸር፥ ኢታ አሾ አሞር፥ አቆፕ ኣ ኡሻር፥ ማር፥ ቱና ኦ ደንዛ የር፥ የላዛ ኤቃ ጎይኖር ቲና የዜዝ የሳይ ግዶዳ። <verse eid="1PE 4:3"/><verse number="4" style="v" sid="1PE 4:4"/>አማኖዋ አሳይራ ይ የይ ጋርክ ባዛር ቃይጽንቲ ላሶዋ ግሾስ ማላባዝ ግ ይንታን ጫዥዛ። <verse eid="1PE 4:4"/><verse number="5" style="v" sid="1PE 4:5"/>ዝን ኡንቲ ፓጽታይላኔ Ꮊይቄዝታይል አፋ ፕርዶዳይስ የዝ ጾሳይስ ማህ እንጎዳ። <verse eid="1PE 4:5"/><verse number="6" style="v" sid="1PE 4:6"/>Ꮊይቄዝታይስካ ዎንግላይ ሳባክንቴዛይ Ꮊይ ግሾስ። ኡንቲ አሳይሳይ ጋርክ ፋ አሾር ፕርድንቶዳ ማ ፋ አያናር ጾሳይ ጋርክ ደኦ የዞዳ።<verse eid="1PE 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 4:7"/>ይኬ፥ ኡባባዝስ ዉርስይ ኡኬዛ። የይ ግሾስ፥ ዎሶዳይስ ዳንዳእንቶድ ጋርክ ዳጭ ጌዝ ዎዝና ማራራ የዞይታ። <verse eid="1PE 4:7"/><verse number="8" style="v" sid="1PE 4:8"/>ሲቆ ጋመ ናጋራ ካምዛ ግሾስ ኡባይፕ ኣ ዎልር ዎዝናፕ ሲቅንቶይታ።<note caller="-" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="PRO 10:12">ኣዝ. 10:12</ref></char></note> <verse eid="1PE 4:8"/><verse number="9" style="v" sid="1PE 4:9"/>ኦሌካዛር ዎል እማትር ሞኮይታ። <verse eid="1PE 4:9"/><verse number="10" style="v" sid="1PE 4:10"/>ይ ጾሳይፕ ኣ ኬሃትይፕ ዱማ ዱማ እሞታ ኤኬዛይ ጋርክ ይ ፐታይ ፐታይ የ እማ ቤዝዛይ ጋርክ አይኪ ዎል ማዶይታ። <verse eid="1PE 4:10"/><verse number="11" style="v" sid="1PE 4:11"/>የሱስ ክርስቶሳ ባጋር ኡባ ባዛር ጾሲ ጋላትንቶዳይ ጋርክ ኦንካ ኦድዛ ባዝ ማቅኮ ጾሳፕ ቃላ ኤኬዛይ ጋርክ ኦዶ። ማ ኦንካ ማድዛ ባዝ ማቅኮ ጾሲ ኤስ እንግዛ ዎልቃይ ጋርክ ማዶ። ቦንቾኔ ዎልቃይ መናፕ መና ሄሎዳይስ ኤስ ማቆ። አምንኤ።<verse eid="1PE 4:11"/></para>
  <para style="s1">መቶ ጋንጨ ጋርዦ</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 4:12"/>ታ ባጉን፥ ይ ታማ ጋርክ ጹግዝ ዋየ ፓጨ ጋንጨር ኣዳር ኦሮባዝ ሀኔዛይ ጋርክ ማላባዝ ጊፓተ። <verse eid="1PE 4:12"/><verse number="13" style="v" sid="1PE 4:13"/>ዝን ኤ ፋ ቦንቻይር ማቂ የኦዳር ይ ኡፋይሳይ ኡሳ ጉጆዳይ ጋርክ ክርስቶሳ ዋየ ይ ኤክዛይድ ኡፋይቶይታ። <verse eid="1PE 4:13"/><verse number="14" style="v" sid="1PE 4:14"/>ክርስቶሳ ሱንይ ግሾስ አሲ ይንታን ጫዥኮ ጾስ ቦንቾ አያናይ ይንታል አፋ ሸምፕዛ ግሾስ ይ አንጅንቴዝታ። <verse eid="1PE 4:14"/><verse number="15" style="v" sid="1PE 4:15"/>ይንታፕ መቶ ኤክዝ ኦንካ ሸምፖ ዎዝታይ ጋርክ ዎይ ካስቴዝ ዎይ ኢታ ኦዛይ ጋርክ ዎይ ገልሶዋ አቆ ገሌዛይ ጋርክ ሀኒ መቶ ኤክፐ። <verse eid="1PE 4:15"/><verse number="16" style="v" sid="1PE 4:16"/>ሀኖ ዝን፥ ክርስታኔ ማቄዝ ግሾስ መቶ ኤክኮ ክርስቶሳ ሱንይ ግሾስ ጾሳ ጋላቶፕ አትን ዬላትፐ።<verse eid="1PE 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 4:17"/>ፕርዳ ጾስ አሳይፕ አይክዝ ዎደ ሄሌዛ። ይኬ፥ የ ፕርዳይ ቲና ኑል አይክዝባዝ ማቅኮ፥ ጾስ ዎንግላይስ ኪትንቶዋ አሳይ ዉርስይ አብ ማቆዴ? <verse eid="1PE 4:17"/><verse number="18" style="v" sid="1PE 4:18"/>ጽሎ ኡንአር አትዝባዝ ማቅኮ፥ ዡጭታይኔ ናጋራንችታይ የዝን ዋዮደ?<note caller="-" style="x"><char style="xo" closed="false">4:18 </char><char style="xt" closed="false"><ref loc="PRO 11:31">ኣዝ. 11:31</ref></char></note> <verse eid="1PE 4:18"/><verse number="19" style="v" sid="1PE 4:19"/>የይ ግሾስ፥ ጾስ ሸነ ጋርክ መቶ ኤክዝታይ ፋ ሸምፖ ሀዳራ ፋና መዝ፥ አማንዛ ጾሳይስ እንግታር ሎኦ ባዝ ኦ።<verse eid="1PE 4:19"/></para>
  <chapter eid="1PE 4"/>
  <chapter number="5" style="c" sid="1PE 5"/>
  <para style="s1">ጾስ ዎያ አቅሶ ዎጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 5:1"/>ይኬ፥ ዎሳ ኬ አቅስዛ ጭማ ማቄዝ ታ፥ ክርስቶሳ ኤኬዝ መታይስ ማርካ ማቄዛኔ ቆንጮዳይስ የዝ ቦንቻ ሻግንቶዳይስ የዝ ታኒ፥ ይ ጋንጨ የዝ ዎሳ ኬ አቅስዛ ጭምታ ዞርዛ። <verse eid="1PE 5:1"/><verse number="2" style="v" sid="1PE 5:2"/>ይ አደትይስ ኦሞር የዝ ጾስ ዉዳ ሄንጎይታ። ጾስ ሸነ ጋርክ ቃራኔ ዶሶራፕ አትን ዎልቃንር ሄንግፓተ። ማ ሚሸ ኮሻር ባዝን ሎኦ ቆፋር ሄንጎይታ።<note caller="-" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="JHN 21:15-17">ዋን. 21:15-17</ref></char></note> <verse eid="1PE 5:2"/><verse number="3" style="v" sid="1PE 5:3"/>ይ አደትፕ ኦሞር የዝ ዉደስ ሎኦ ኣዝሶ ማቆይታፕ አትን ጎዳትፓተ። <verse eid="1PE 5:3"/><verse number="4" style="v" sid="1PE 5:4"/>ሄንግዝታይ ሀላቃይ ማቂ የኦዳር ኣዋ ቦንቾ ዛዉደ ይ ኤኮዳ።<verse eid="1PE 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1PE 5:5"/>የይ ጋርከካ፥ የላግታዮ፥ ጭምታይስ ኪትንቶይታ። ይ ዎልስ ሃዮ ማቆይታ። ጌሻ ማጻፋይድ፥ «ጾስ ኡትርትዝታ እጽዛ፥ ዝን ሀይታይስ ኣ ኬሃትፕ እንግዛ» ዬግዛ።<note caller="-" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="PRO 3:34">ኣዝ. 3:34</ref></char></note> <verse eid="1PE 5:5"/><verse number="6" style="v" sid="1PE 5:6"/>ይኬ ጾሲ ፋ ዎደ ይንታን ቦንቾዳይ ጋርክ ዎልቃማ ጾስ ኩሸፕ ኦሞር ይንታን ካዉሾይታ።<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="MAT 23:12">ማቶ. 23:12</ref>፤ <ref loc="LUK 14:11">ሉቃ. 14:11</ref>፤ <ref loc="LUK 18:14">18:14</ref></char></note> <verse eid="1PE 5:6"/><verse number="7" style="v" sid="1PE 5:7"/>ኤ ይንትስ ቆፕዛ ግሾስ ይንታን ህርግስዛ ባዝ ኡባ ኤዛል አፋ ኦሎይታ።<verse eid="1PE 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 5:8"/>ይ ሞርከ ዳቡሎሳ፥ ምቶዳና ኮዪ፥ ጋሞ ጋርክ ጻግታር ይ ካንታር ዩይዛይ ግሾስ ይንታን ሃሮይታኔ ባርኮይታ። <verse eid="1PE 5:8"/><verse number="9" style="v" sid="1PE 5:9"/>አላመል የዝ ይ እሽታይ የይ ጋርክ መቶ ኤኮዳና ኤሪ፥ አማኖር ሚንጊ፥ ጻላሄር ኤቅንቶይታ። <verse eid="1PE 5:9"/><verse number="10" style="v" sid="1PE 5:10"/>ፋ መና ቦንቻይስ ክርስቶሳ የሱሳ ባጋር ይንታን ጼጌዝ ኣ ኬሃት ኡባይ ጾሳይ፥ ጽቃ ዎደስ ይ መቶ ኤኬዛይፕ ጉየ፥ ኤ ፋ ኦማስ ይንታን ፎሎ ኡዶዳ፥ ካትሶዳ፥ ሚን ኤሶዳ፥ ጻጵሶዳ። <verse eid="1PE 5:10"/><verse number="11" style="v" sid="1PE 5:11"/>መናፕ መና ሄሎዳይስ ቦንቾኔ ዎልቃ ኤስ ማቆ። አምንኤ።<verse eid="1PE 5:11"/></para>
  <para style="s1">ዉርስ ሳሮ</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 5:12"/>አማንንቴዝ እሸ ግ ታ ኤክዝ ስላሰ ባጋር Ꮊ ዳብዳባ ይንትስ ሃታር ጻፌዛ። ታ የያ ይንትስ ጻፌዛይ፥ ይንታን ዞሮዳይስኔ ጾስ ኣ ኬሃትይ ቱማ ማቄዛና ማርካታቶዳይሲ። የ ኣ ኬሃትይድ ሚንጊ ኤቆይታ።<note caller="-" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="ACT 15:22">ሀዋ. ኦ. 15:22</ref>፥ <ref loc="ACT 15:40">40</ref></char></note><verse eid="1PE 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 5:13"/>ይንታር ዎላ ዶርንቴዝ ባብሎነ<note caller="+" style="f"><char style="fr" closed="false">5:13 </char><char style="fqa" closed="false">ባብሎነር፦ </char><char style="ft" closed="false">Ꮊ አቆ ባብሎነ ጊንትንቴዛይ ኦሮመ ካታማ ማቅ አተና።</char></note> ግንትንትዝ ኦሮመ የዝ ዎሳ ኬ ታ ናአ ማርቆሳ ይንታን፥ «ሳሮ ሳሮ» ዬግዛ።<note caller="-" style="x"><char style="xo" closed="false">5:13 </char><char style="xt" closed="false"><ref loc="ACT 12:12">ሀዋ. ኦ. 12:12</ref>፥ <ref loc="ACT 12:25">25</ref>፤ <ref loc="ACT 13:13">13:13</ref>፤ <ref loc="ACT 15:37-39">15:37-39</ref>፤ <ref loc="COL 4:10">ቆላ. 4:10</ref>፤ <ref loc="PHM 1:24">ፍልሞ. 24</ref></char></note> <verse eid="1PE 5:13"/><verse number="14" style="v" sid="1PE 5:14"/>ሲቆ ዬራ ዬርንትታር፥ ዎል ሳሮይታ።</para>
  <para style="p" vid="1PE 5:14">ክርስቶሳር የዝ ይንትስ ኡባይስ ሳሮ ማቆ። አምንኤ።<verse eid="1PE 5:14"/></para>
  <chapter eid="1PE 5"/>
</usx>
