<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="TIT" style="id">- Melo New Testament Ethiopic</book>
  <para style="h">ትቶ</para>
  <para style="toc1">ጳዉሎሳ ትቶስ ጻፌዝ ኪታ</para>
  <para style="toc2">ትቶ</para>
  <para style="toc3">ትቶ</para>
  <para style="mt1">ጳዉሎሳ ትቶስ ጻፌዝ ኪታ</para>
  <para style="imt">ገሎ</para>
  <para style="ip">ትቶ አይሁደ ባያ፥ ዝን ጉየፕ አማኒ፥ ጳዉሎሳ ዎንግለ ኪታ ኦሳ ኦታር ዣመ ማቂ ኤዛ ማዴዝ አሲ። የ ዎደ ትቶ፥ ዎሳ ኬ በአዳይስኔ ናጎዳይስ ቃርጼሳ ቢታ አቴዛ። Ꮊ ኪታይ ሀይ ኣፈ ቆፍታ አይክዛ።</para>
  <para style="ili">1. ዎሳ ኬ አቅስዛ አሳይ፥ ኢታ የስ የዝ ቃርጼሳ አሳይ ላንቃይድ አብ ጋርክ ሎኦ የስ የዞዳይስ ቤዝዛኮ ትቶ አካክስዛ።</para>
  <para style="ili">2. ዎሳ ኬ ጋንጨ የዝ ዱማ ዱማ ጩግታ፥ የይካ፥ ጭማ አስታ፥ የላጋ ናእታኔ አይልታ ዋይዚ ታማርሶዳይስ ቤዝዛኮ ትቶና ዞርዛ።</para>
  <para style="ili">3. አማንዛ አሳይ አማኖ የስ ባዝ፥ ሳሮትራኔ ሲቆር የዞድ፥ ዎሳ ኬ ጋንጨፕ ካቺ፥ ፓላማኔ ጳልቂ ቦዳይ ጋርክ ትቶስ ዞረ እንግዛ።</para>
  <para style="iot">ትቶ ክታይ አይኬዝ ቆፍታ</para>
  <para style="io1">ገሎ <char style="ior"><ref loc="TIT 1:1-4">1:1-4</ref> </char></para>
  <para style="io1">ዎሳ ኬ ካልዝታይ ባጋ <char style="ior"><ref loc="TIT 1:5-16">1:5-16</ref> </char></para>
  <para style="io1">ዎሳ ኬ የዝ ዱማ ዱማ ጩግታይ ኦሶ <char style="ior"><ref loc="TIT 2:1-15">2:1-15</ref> </char></para>
  <para style="io1">ዞረኔ ናግሶ <char style="ior"><ref loc="TIT 3:1-11">3:1-11</ref> </char></para>
  <para style="io1">ኩስተ ቆፋ <char style="ior"><ref loc="TIT 3:12-15">3:12-15</ref> </char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="TIT 1"/>
  <para style="p">
    <verse number="1" style="v" sid="TIT 1:1"/>የሱስ ክርስቶሳ ሀዋረኔ ጾስ አይለ ማቄዝ፥ ጳዉሎሳ፥ ጻፌዝ ዳብዳበ። ጾሲ ዶሬዝ አሳይ አማና ድቾድ ጋርከኔ ቱማ አያና የስ ዋይዚ የሳዳዛኮ ቤዝዛ ቱማ ኤረትኮ ኡንታን ካልዳይስ ታኒ ኪትንቴዛ። <verse eid="TIT 1:1"/><verse number="2" style="v" sid="TIT 1:2"/>የ አማናይ መና ደኦ ኡፋይሳል አፋ ኤቄዛ። የይ ጋመ ዎደፕ ቲና ዎርዶቶዋ ጾሳይ ኑስ እንጎድ ግ ቃላ ገሌዛያ። <verse eid="TIT 1:2"/><verse number="3" style="v" sid="TIT 1:3"/>ኑና አሽዛ ጾሳይ ፋ ዎደ ሄልን Ꮊ ኪታ ኦዶዳይ ጋርክ ታስ ሀዳራ እንጌዛ።<verse eid="TIT 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="TIT 1:4"/>ኑስ ኮ ማቄዝ አማናይድ ታስ ቱማ ናአ ማቄዝ ትቶስ፥</para>
  <para style="p" vid="TIT 1:4">ጾስ አዳይፐኔ ኑና አሽዛ የሱስ ክርስቶሳፕ ኣ ኬሄትይ፥ ማሮትይኔ ሳሮትይ ኔስ ማቆ።<note caller="-" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="2CO 8:23">2ቆሮ. 8:23</ref>፤ <ref loc="GAL 2:3">ጋላ. 2:3</ref>፤ <ref loc="2TI 4:10">2ጽማ. 4:10</ref></char></note><verse eid="TIT 1:4"/></para>
  <para style="s1">ትቶ ቃርጼሳ ኦዝ ኦሳ</para>
  <para style="p">
    <verse number="5" style="v" sid="TIT 1:5"/>ታኒ ነና ቃርጼሳ አሼዛይ፥ ኔኒ አቴዝ ባዝ ሎእድ ጋርከኔ ታኒ ኪቴዛይ ጋርክ ካታማ ኡባይድ ዎሳ ኬ አቅስዝታ ዶሮድ ጋርከሲ። <verse eid="TIT 1:5"/><verse number="6" style="v" sid="TIT 1:6"/>ዎሳ ኬ ጭማ ቦርንቶዛ፥ ፐቲ ማቻት አዝን፥ የዳ የሳር ዎይ ኪትንቶ እጾር አሲ ቦሮዋ አማንዛ ናእታይ የዝ አስ ማቆዳይስ ቤዝዛ።<note caller="-" style="x"><char style="xo" closed="false">1:6-9 </char><char style="xt" closed="false"><ref loc="1TI 3:2-7">1ጽማ. 3:2-7</ref></char></note> <verse eid="TIT 1:6"/><verse number="7" style="v" sid="TIT 1:7"/>ዎሳ ኬ አቅስዝታይ ጾስ ኦሶ ሀዳራ ኤኬዝ ግሾስ ቦርንቶዛ፥ ኡትርቶዛ፥ ኤልሲ ይሎቶዛ፥ ማዛ፥ ኦዳ ኮዮዛኔ ቤዞዋ አዳስ ኩኩሮዛ ማቆዳይስ ቤዝዛ። <verse eid="TIT 1:7"/><verse number="8" style="v" sid="TIT 1:8"/>ዝን እማ ሞክዛያ፥ ሎኦ ባዝ ኡባ ቃዛያ፥ አካካር የዛያ፥ ሱረ፥ ጌሽኔ ፋና ሃርዛያ ማቆዳይስ ቤዝዛ። <verse eid="TIT 1:8"/><verse number="9" style="v" sid="TIT 1:9"/>ቱማ ትምርተ ታማርሶራ፥ ዞረራኔ የ ትምርታ እጽዝታይስ ማህ እንጎዳይስ ፋ ታማሬዝ አማንዛ ቃላይል ሚንጊ ኤቆ።<verse eid="TIT 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="TIT 1:10"/>ኪትንቶዝታይ፥ ፓዋ ኦዳ ኦድንትዝታይ፥ ዶሽዝታይ ኡባራካ ዶካልንቶ ዎጋ ናግዛ ጋመ አስታይ የዛ። <verse eid="TIT 1:10"/><verse number="11" style="v" sid="TIT 1:11"/>ኡንቲ ቤዞዋ ኦገር ሚሸ ደንጎዳይስ ኮዪ፥ ቤዞዋ ባዝ ታማርስታር ካራ አስ ኡባ ቡቂዝ ግሾስ ኡ ትምርታ ተቆዳይስ ቤዝዛ። <verse eid="TIT 1:11"/><verse number="12" style="v" sid="TIT 1:12"/>ኡንታፕ ፐታይ ኡንትስ ናበ ማቄዛይ፥ «ቃርጼሳ አሳይ ኡባ ዎደ ዎርዶ ኦድንትዝታ፤ ኢታ ዶእታኔ አዛላ ናፍሳምታ»<note caller="+" style="f"><char style="fr" closed="false">1:12 </char><char style="fqa" closed="false">ቃርጼሳ አሳይ ኡባ ዎደ ዎርዶ ኦድንትዛ፤ ኢታ ዶእታኔ አዛላ ያራምቢታ፦ </char><char style="ft" closed="false">የይ ዬጊ ኦዴዝ ናባይ ኤጲመንደሳ ግንትትዛ።</char></note> ዬጌዛ። <verse eid="TIT 1:12"/><verse number="13" style="v" sid="TIT 1:13"/>Ꮊ ማርካትይ ቱማ። የይ ግሾስ፥ ኡንትስ ቱማ አማኖ የዞዳይ ጋርክ ኡንታን ካጮይታ። <verse eid="TIT 1:13"/><verse number="14" style="v" sid="TIT 1:14"/>ቱማ እጽዛ አሳይ ትምርታኔ አይሁድታይ ፓዋ ቶሳ ስአማይ ጋርክ ኡንታን ሚን ሴሮባ። <verse eid="TIT 1:14"/><verse number="15" style="v" sid="TIT 1:15"/>ጌሽታይስ ኡባ ባዝ ጌሺ፥ ዝን ቱንታይስኔ አማኖዝታይስ ኡ ቆፋይኔ ካሃይ ቱኔዝ ግሾስ ኡንትስ አብካ ጌሺ ባያ። <verse eid="TIT 1:15"/><verse number="16" style="v" sid="TIT 1:16"/>ኡንቲ ኑ ጾስ ኤርዛ ግዛ፥ ዝን ፋ ኦሳይር ኤዛ ካድዛ። ኡንቲ ጾሳር እጽንቴዝታ፥ ኪትንቶዋዝታኔ ሎኦ ኦሶ ኡባ ኦዳይስ ፒልዝታ።<verse eid="TIT 1:16"/></para>
  <chapter eid="TIT 1"/>
  <chapter number="2" style="c" sid="TIT 2"/>
  <para style="p">
    <verse number="1" style="v" sid="TIT 2:1"/>ዝን ኔኒ ደኦ እንግዝ ትምርታ ቤዝዛይ ጋርክ ታማርሶባ። <verse eid="TIT 2:1"/><verse number="2" style="v" sid="TIT 2:2"/>ዎዛንቶ ራታይ ፋና ሞድዝታ፥ ጊጋር የዝዝታ፥ ቦንችንቴዝታ፥ አማኖር፥ ሲቆራኔ ዳንዳአር፥ ምንጎድ ጋርክ ዞሮባ። <verse eid="TIT 2:2"/><verse number="3" style="v" sid="TIT 2:3"/>የይ ጋርከካ፥ ዎዛንቶ ማችታይ ፋ የሳይድ ጌሽታ፥ ሀዎዞዋዚታ፥ ኡሽ ዣሮዝታኔ ሎኦ ባዝ ታማርዝታ ማቆዳይ ጋርክ ታማርሶባ። <verse eid="TIT 2:3"/><verse number="4" style="v" sid="TIT 2:4"/>ኡንቲ Ꮊይ ጋርክ ሀንኮ የላጋ ማችታይ ፋ አዝንታኔ ፋ ናእታ ሲቆዳይ ጋርከ። <verse eid="TIT 2:4"/><verse number="5" style="v" sid="TIT 2:5"/>ጾስ ቃላይ ቦርንታማይ ጋርክ ፋና ሞድዝታ፥ ጌሽታ፥ ፋ ካራ ካርስዝታ፥ ኬህታኔ ፋ አዝንስ ኪትንትዝታ ማቃድ ጋርክ የላጋ ማችታ ታማርሶ።<verse eid="TIT 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="TIT 2:6"/>የይ ጋርከካ፥ ፓንታይ ፋና ሃሮዳይ ጋርክ ዞሮባ። <verse eid="TIT 2:6"/><verse number="7" style="v" sid="TIT 2:7"/>ኔኒ ነ ኦማስ ሎኦ ኦሶ ኡባይር ኡንትስ ኣዝሶ ማቆባ። ኔኒ ነ ትምርታይር ኤቆራኔ አማንንቶር ነና ቤዞባ። <verse eid="TIT 2:7"/><verse number="8" style="v" sid="TIT 2:8"/>ኑ ሞርክታይ ኑና ዝግርዝ ኦገ ብን ኡንቲ ዬላቶዳይ ጋርክ ኔኒ ቦርንቶዋ ሎኦ ኦሶ ኦባ።<verse eid="TIT 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="TIT 2:9"/>አይልታይ ኡባ ባዛር ፋ ጎድታይስ ኪትንቶዳይ ጋርክ፥ ኡንታን ኡፋይሶድ ጋርከኔ ኡንታር ፓላማም ጋርክ ዞሮባ። <verse eid="TIT 2:9"/><verse number="10" style="v" sid="TIT 2:10"/>ኡንቲ ፋ ጎድታይፕ ሚሸ ካስታማይ ጋርክ ዞሮባ። የይካ፥ ኑና አሽዛ ጾሳይ ትምርተ፥ ኡባ ኦገር ቦንችንቴዛ ማቃዳይ ጋርክ ፋ ኦዛ ኦሳይድ ፎሎ አማንንትዝታ ማቄዛና ቤዞዳይ ጋርክ ኡንታን ዞሮባ።<verse eid="TIT 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="TIT 2:11"/>አስ ኡባ አሽዛ ጾስ ኣ ኬሄትይ ቆንጬዛ። <verse eid="TIT 2:11"/><verse number="12" style="v" sid="TIT 2:12"/>የ ኣ ኬሃትይ፥ ኑኒ ናጋራኔ Ꮊ አላማይ አሞ አሺ፥ Ꮊ ዎዳይድ ኑና ሞዲ፥ ቱማ አያና የስስኔ ጽሎትር የዞድ ጋርክ ኑና ታማርስዛ። <verse eid="TIT 2:12"/><verse number="13" style="v" sid="TIT 2:13"/>ኑኒ አንጅንቴዝ ኡፋይስ ማቄዝ ግታ ጾሳኔ ኑና አሽዛ የሱስ ክርስቶሳ ቦንቾ ቆንጭ ናጎል የዛ። <verse eid="TIT 2:13"/><verse number="14" style="v" sid="TIT 2:14"/>ኢታ ኦሶ ኡባይፕ ኑና ዎዞዳይስኔ ሎኦ ባዝ ኦዳይስ አሞትዝ ፓስ ጌሽ ዎያ ማሆዳይስ ፋና ኑ ግሾስ ኣ እንጌዛ።<note caller="-" style="x"><char style="xo" closed="false">2:14 </char><char style="xt" closed="false"><ref loc="PSA 130:8">ማዝ. 130:8</ref>፤ <ref loc="EXO 19:5">ከስ 19:5</ref>፤ <ref loc="DEU 4:20">ናምእ. 4:20</ref>፤ <ref loc="DEU 7:6">7:6</ref>፤ <ref loc="DEU 14:2">14:2</ref>፤ <ref loc="1PE 2:9">1ጵጽ. 2:9</ref></char></note><verse eid="TIT 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 2:15"/>ኔኒ Ꮊያ ታማርሶባ፥ ኩን ማዉተር ዞሮባ፥ ሴሮባ ኦንካ ነና ለቂፐ።<verse eid="TIT 2:15"/></para>
  <chapter eid="TIT 2"/>
  <chapter number="3" style="c" sid="TIT 3"/>
  <para style="s1">አማንዛ አስ ኦሶ</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 3:1"/>አሳይ ጋደ አቅስዝታይስኔ፥ ማዉተር የዝታይስ ሞድንቶድ ጋርክ፥ ሃዮትር ኪትንቶዳይስኔ ሎኦ ኦሶ ኡባ ኦዳይስ ጊግንቴዝታ ማቆዳይ ጋርክ ቆፕሶባ። <verse eid="TIT 3:1"/><verse number="2" style="v" sid="TIT 3:2"/>ማ ኡንቲ ኦላካ ኢታ ኦድንታማይ ጋርክ፥ ሳሮ አስ ማቃዳይ ጋርክ፥ አሽክታኔ አስ ኡባይስ ኬህዝታ ማቃዳይ ጋርክ ዞሮባ። <verse eid="TIT 3:2"/><verse number="3" style="v" sid="TIT 3:3"/>ኑኒ ቲና ቦዝታ፥ ኪትንቶዝታ፥ ባልንቴዝታ፥ ዱማ ዱማ አሾ ኡፋይስስኔ አሞስ አይልቴዝታ። ኑኒ ኢታትራኔ ቅናተር ኩሜዝታ፤ ኑ አስ እጽዝታ፥ አስካ ኑና እጽዝታ። <verse eid="TIT 3:3"/><verse number="4" style="v" sid="TIT 3:4"/>ዝን ለ ማቄዝ ጾስ ኬሄትኔ ሲቃይ ቆንጬዝ ዎደ <verse eid="TIT 3:4"/><verse number="5" style="v" sid="TIT 3:5"/>ኑ ኦዝ ጌሽ ኦሳይ ግሾስ ባዝን ፋ ማሮትይ ግሾስ ኑና አሼዛ። ኤ ኑና አሼዛይ፥ ናምአን የልንቶ ሜቻራኔ ጌሻ አያና ባጋር እንጌዝ ኦሮ የሳራ። <verse eid="TIT 3:5"/><verse number="6" style="v" sid="TIT 3:6"/>የ አያና፥ ጾሲ ኑና አሽዛ የሱስ ክርስቶሳ ባጋር ኑል አፋ ጋን ጎግሴዛ። <verse eid="TIT 3:6"/><verse number="7" style="v" sid="TIT 3:7"/>ፋ ኣ ኬሄትይ ባጋር ኑና ጽልሲ መና ደኦ ላታ ኡፋያሳ ኤኮድ ጋርክ የያ ኦዛ። <verse eid="TIT 3:7"/><verse number="8" style="v" sid="TIT 3:8"/>Ꮊ ቃላይ አማንንቴዛያ። ጾስ አማንዝታይ ሎኦ ኦሶ ኦዳይስ ጊጌዝታ ማቃዳይ ጋርክ ነ Ꮊ ቃላ ሚን ኦዶድ ጋርክ ታ ኮይዛ። የይትታይ አስ ኡባይስ ሎኦኔ ማድዝታ። <verse eid="TIT 3:8"/><verse number="9" style="v" sid="TIT 3:9"/>ዝን ቦዝታይ ፓላማይፐ፥ ኮቼ ታይቦፕ፥ ካቻፐኔ ህገፕ ደንዴዛይድ ደንድዛ ጫቻፕ ናግንቶባ። የይ ማዶዋ ዎ ባ ባዝ። <verse eid="TIT 3:9"/><verse number="10" style="v" sid="TIT 3:10"/>ጳልቂ መዛ አ ፐቲ ቶኬ ዎይ ናምኢ ቶኬ ዞሪ የይፕ ጉየ የይ ጋርክ አይፕ ሃኮባ። <verse eid="TIT 3:10"/><verse number="11" style="v" sid="TIT 3:11"/>የይ ጋርክ አስ ዡጫኔ ናጋራንቾ፤ ኤ ፋል አፋ ፕርዴዛና ኤሮባ።<verse eid="TIT 3:11"/></para>
  <para style="s1">ዉርስ ዞረ</para>
  <para style="p">
    <verse number="12" style="v" sid="TIT 3:12"/>ታኒ ባልጎ ኤዛይድ ሻጮዳይስ ቆፔዝ ግሾስ አርጸማሳ ዎይ ትክቆሳ ኔኮ ኪትዛ ዎደ ነ ታኮ ንቆጲሎና የኦዳይስ ምንጎባ።<note caller="-" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="ACT 20:4">ሀዋ. ኦ. 20:4</ref>፤ <ref loc="EPH 6:21-22">ኤፍ. 6:21-22</ref>፤ <ref loc="COL 4:7-8">ቆላ. 4:7-8</ref>፤ <ref loc="2TI 4:12">2ጽማ. 4:12</ref></char></note> <verse eid="TIT 3:12"/><verse number="13" style="v" sid="TIT 3:13"/>ህገ ኤርዝ ዜናሳኔ አጵሎሳ ኦገ Ꮊንጎዳር ኡንትስ ኮሽዛ ባዝ ፓጫማይ ጋርክ ኡንታን ማዶባ።<note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="ACT 18:24">ሀዋ. ኦ. 18:24</ref>፤ <ref loc="1CO 16:12">1ቆሮ. 16:12</ref></char></note> <verse eid="TIT 3:13"/><verse number="14" style="v" sid="TIT 3:14"/>ኑ አሳይካ ፓዋ አስ ማቂ አታማይ ጋርክ ፓስ ቤዝዛ ባዝ ደንጎዳይ ጋርክ ሎኦ ኦሶ ኦዳይስ ሚንጊ ታማሮ።<verse eid="TIT 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 3:15"/>ታራ የዝ ኡባይ ነና ሳሮ ግዛ፤ አማኖር ኑና ሲቅዛ አስታ ሳሮ ጎባ።</para>
  <para style="p" vid="TIT 3:15">ጾስ ኣ ኬሃትይ ይ ኡባይራ ማቆ። አምንኤ።<verse eid="TIT 3:15"/></para>
  <chapter eid="TIT 3"/>
</usx>
