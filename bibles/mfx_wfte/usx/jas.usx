<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JAS" style="id">- Melo New Testament Ethiopic</book>
  <para style="h">ያይቆባ</para>
  <para style="toc1">ያይቆባ ጻፌዝ ኪታ</para>
  <para style="toc2">ያይቆባ</para>
  <para style="toc3">ያይ.</para>
  <para style="mt1">ያይቆባ ጻፌዝ ኪታ</para>
  <para style="imt">ገሎ</para>
  <para style="ip">Ꮊይ ያይቆባ ኪታይ፥ አማንዛ አሲ ጋላስ ጋላስ ፋ የዞድ የሳ ታማርስዛ ቆፍታ አይኬዛ። Ꮊ ኪታይ ጻፍንቴዛይ፥ ቢታ ኡባይል ላልንቴዝ ታጶ ናምኢ አይሁደ ኮችታይሲ። Ꮊ ማጻፈ ጻፌዛይ፥ ኤጨት ኑኒ ኦሶል ፔሽዝ ሂላ፥ አማንዛ አሳ ሞኮባጋኔ ሎኦ አማለ ባጋ ኦገ ማቅዝ ባዝታ ምስለ ኦዳራ ጌሺ ቤዝዛ።</para>
  <para style="ip">ያይቆባ ኪታይ፥ ማንቆት ባጋ፥ ዱረት ባጋ፥ ፓጨ ባጋ፥ ሎኦ አማለ ባጋ፥ ቅናተባጋ፥ አማኖ ባጋ፥ ሎኦ ኦሶ ባጋ፥ እራን ሞዶ ባጋ፥ ኤጨት ባጋ፥ ፐታይ ፐታይር ካች ባጋ፥ ኡትራ ባጋ፥ ሃዮት ባጋ፥ ሀራ አሳል አፋ ፕርዳ ባጋ፥ ጬቅንቶ ባጋ፥ ጋርዦ ባጋ፥ ዎሳ ባጋኔ አማንዛ አሳይ ኦዳይስ ቤዝዛ ባዝ ኡባ ፓዲ ጻፌዛ።</para>
  <para style="ip">ያይቆባ ኪታይ፥ ክርስታነት የሳይ አማኖ ኦሶር በንትዝ ማቄዛና ቆንጭሲ ቤዝዛ።</para>
  <para style="iot">ያይቆባ ኪታይ አይኬዝ ቆፍታ</para>
  <para style="io1">ሳሮ <char style="ior"><ref loc="JAS 1:1">1:1</ref> </char></para>
  <para style="io1">አማኖኔ ኤጨት <char style="ior"><ref loc="JAS 1:2-8">1:2-8</ref> </char></para>
  <para style="io1">ማንቆትኔ ዱረት <char style="ior"><ref loc="JAS 1:9-11">1:9-11</ref> </char></para>
  <para style="io1">ፓጨ <char style="ior"><ref loc="JAS 1:12-18">1:12-18</ref> </char></para>
  <para style="io1">ጾስ ቃላ ስስኔ ኦሶል ፔሾ <char style="ior"><ref loc="JAS 1:19-27">1:19-27</ref> </char></para>
  <para style="io1">አስ አሳፕ ፓሮ ኮሾዋዛ <char style="ior"><ref loc="JAS 2:1-13">2:1-13</ref> </char></para>
  <para style="io1">አማኖኔ ኦሶ <char style="ior"><ref loc="JAS 2:14-26">2:14-26</ref> </char></para>
  <para style="io1">እራን ሞዶ ባጋ <char style="ior"><ref loc="JAS 3:1-18">3:1-18</ref> </char></para>
  <para style="io1">አማንዛ አስኔ Ꮊ አላማ <char style="ior"><ref loc="JAS 4:1-5:6">4:1—5:6</ref> </char></para>
  <para style="io1">ዱማ ዱማ ባዝታይስ እንግንቴዝ ዞርታ <char style="ior"><ref loc="JAS 5:7-20">5:7-20</ref> </char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="JAS 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1"/>ጾሳ ጎዳ የሱስ ክርስቶሳ አይላይ፥ ያይቆባ፥ አላመ ኡባይል ላልንቴዝ ታጶ ናምኢ ሼሽታይስ ኪቴዝ ኪታ።<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="MAT 13:55">ማቶ. 13:55</ref>፤ <ref loc="MRK 6:3">ማር. 6:3</ref>፤ <ref loc="ACT 15:13">ሀዋ. ኦ. 15:13</ref>፤ <ref loc="GAL 1:19">ጋላ. 1:19</ref></char></note></para>
  <para style="p" vid="JAS 1:1">ሳሮ፥ ይንትስ ማቆ።<verse eid="JAS 1:1"/></para>
  <para style="s1">አማኖኔ ኤጨት</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2"/>ታ እሹን፥ ይንታን ዱማ ዱማ ፓጨ ሄልኮ ይ ሎኦ ባዝ ደንጌዛይ ጋርክ ኡዲ ኩን ኡፋይሳር ኤኮይታ። <verse eid="JAS 1:2"/><verse number="3" style="v" sid="JAS 1:3"/>ይ አማናይ ፓጭንታይ ይንትስ ጋርዦ እንግዛና ይ ኤርዛ። <verse eid="JAS 1:3"/><verse number="4" style="v" sid="JAS 1:4"/>ይ ዉርስ ሄሎዳይስ ይባታር ዳንዳእኮ አብካ ፓጨካ ይንታን ፖሎኔ ኩን ማሆ። <verse eid="JAS 1:4"/><verse number="5" style="v" sid="JAS 1:5"/>ይንታፕ ኦስካ ኤጨት ብኮ ጾስ ዎሶ። ኤ ይንትስ እንጎዳ። ጾሳይ ኦናካ ቦረካዛር ኡባይስ ኬሃትር እንግዛ ጾስ። <verse eid="JAS 1:5"/><verse number="6" style="v" sid="JAS 1:6"/>ዝን ዎስታር አማኖር ሰኤካዛር ጾሳ ዎሶ። ሰእዛ ኦንካ ጫርኮ ኤንእስን ኤንእዛ አባ ዙሎ ጋርከ። <verse eid="JAS 1:6"/><verse number="7-8" style="v" sid="JAS 1:7-8"/>ናምኢ ቆፋ የዛይነ ፋ ኦጋይል ኤቆያ ኦንካ ጎዳይፕ አብካ ደማዳ ኣዝፐ።<verse eid="JAS 1:7-8"/></para>
  <para style="s1">ማንቆትኔ ዱረትስ</para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9"/>አማንዛ ማንቆ አሳይ፥ ጾሳይ ኡንታን ቅ ኡዶድ ግሾ ኡፋይቶ። <verse eid="JAS 1:9"/><verse number="10" style="v" sid="JAS 1:10"/>አስ ዱረት ፉ ጋርክ ብዛ ግሾስ አማንዛ ዱረ አሳይ ጾሳይ ኡንታን ዝቂ ኡድኮካ ኡፋይቶ።<note caller="-" style="x"><char style="xo" closed="false">1:10-11 </char><char style="xt" closed="false"><ref loc="ISA 40:6-7">ኢሳ. 40:6-7</ref></char></note> <verse eid="JAS 1:10"/><verse number="11" style="v" sid="JAS 1:11"/>አዋይ ፋ ምሻር ከዚ ማታ መልስዛ፥ ፉ ጉፍስዛ፤ ኤ ሎኦትይካ ብዛ። የይ ጋርከካ፥ ዱረ አሳይ ፋ ኦሶር ዳቡርታር ቦዳ።<verse eid="JAS 1:11"/></para>
  <para style="s1">አሰ ሄልዛ ፋጨ</para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12"/>መቶ ጋሚ ኣዛይፕ ጉየ፥ ጾሳይ ፋና ቃዝታይስ እማድ ግ ቃላ ጫቆ ገሌዝ ደኦ ዛዉደ ኤኮድ ግሾስ መቶር ጋርዥዛ አስ አንጅንቴዛያ። <verse eid="JAS 1:12"/><verse number="13" style="v" sid="JAS 1:13"/>ኦንካ ፓጭንትዛ ዎደ «ታና ጾሳይ ፓጬዛ» ጊፐ። ጾሳይ ኢታር ፋጮያ፤ ማ ኤ ኦናካ ፋጮያ። <verse eid="JAS 1:13"/><verse number="14" style="v" sid="JAS 1:14"/>ዝን ፐቲ ፐቲ አስ ፋ ኢታ አሞትር ጎሽንትታራነ ዶሽንትታር ፓጭንትዛ። <verse eid="JAS 1:14"/><verse number="15" style="v" sid="JAS 1:15"/>የይፐ ጉየ፥ አሞት ዎደጺ ናጋራ የልዛ፤ ማ ናጋራ ድጪ Ꮊይቆ የልዛ።<verse eid="JAS 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16"/>ታ ሲቆ እሹን፥ ዶሽንትፓተ። <verse eid="JAS 1:16"/><verse number="17" style="v" sid="JAS 1:17"/>ሎኦ እሞኔ ኩን አንጆ ኡቢታይ ሳሎፕ ይእዛ። የይካ ኩያ ጋርክ ኡባ ዎደ ዉቶዋ ዎይ ላምንቶዋ ፖእታይ አዳይ ጾሳይፕ ይእዛ። <verse eid="JAS 1:17"/><verse number="18" style="v" sid="JAS 1:18"/>ኑኒ፥ ኤ መትስ ባይራ ማቃድ ጋርክ ኑና ቱማ ቃላር ፋ ሸነር የሌዛ።<verse eid="JAS 1:18"/></para>
  <para style="s1">ስኤዛና ኦሶል አፋ ፔሾ</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19"/>ታ ሲቆ እሹን፥ Ꮊያ ዶግፓተ። አስ ኡባይ ስኦዳይስ ኤልሶ፥ ዝን ኦድንቶዳይስኔ ካጭንቶዳይስ ኤልስፐ። <verse eid="JAS 1:19"/><verse number="20" style="v" sid="JAS 1:20"/>አስ ካቺ ጾሳይ ጽሎት ኮኦያ። <verse eid="JAS 1:20"/><verse number="21" style="v" sid="JAS 1:21"/>የይ ግሾስ፥ ቱና ሀኖኔ ኢታት ኡባ ብሲ፥ ጾሳይ ይ ዎዝና ጋንጨ ቱኬዝ ይ ሸምፖ አሾዳይስ ዳንዳእዛ ቃላ ሃዮትር ኤኮይታ።<verse eid="JAS 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22"/>ዝን ጾስ ቃላ ኦሶል ፔሾይታፕ አትን ስእ ኣዳር ይንታን ዶሽፓተ። <verse eid="JAS 1:22"/><verse number="23" style="v" sid="JAS 1:23"/>ቃላ ስኢ ኦዋ አሲ፥ ኤ ፋና ማስቶተር ብእዝ አስ ጋርከ። <verse eid="JAS 1:23"/><verse number="24" style="v" sid="JAS 1:24"/>ኤ ፋና ብኢ ማቂ ቅትዛ፥ ዝን ኤ አብ ኣዝዛኮ ኤልሲ ዶግዛ። <verse eid="JAS 1:24"/><verse number="25" style="v" sid="JAS 1:25"/>ዝን ኦንካ ዋሎ ከስዛ ፎሎ ህገ አካካር ብኢ፥ ካሊ ናግዛይ፥ ስኤዛና ዶገካ ኦሶል ፔሽዛ አይ፥ ፋ ኦሶ ኡባይር አንጅንቶዳ።<verse eid="JAS 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 1:26"/>ፋ እራን ናገካዛር ጎይንዛ ግዝ አይ ፋና ዶሽዛ፤ ኤ ጎይናይ ጨረ። <verse eid="JAS 1:26"/><verse number="27" style="v" sid="JAS 1:27"/>ጾስ አዳይ ቲና ቦሮ ባ ጌሽ ጎይናይ Ꮊያ፦ ዥኦ ናእታኔ አምእታ ኡ መታይድ ማደኔ አላመ ቱናፕ ፋና ናጎ።<verse eid="JAS 1:27"/></para>
  <chapter eid="JAS 1"/>
  <chapter number="2" style="c" sid="JAS 2"/>
  <para style="s1">አሰ ቁርፐ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1"/>ታ እሹን፥ ይ ኑ ቦንቾ ጎዳ የሱስ ክርስቶሳ አማንዛ ማቅኮ፥ አስ ኣፈ ብኢ አስ ቦንችፓተ። <verse eid="JAS 2:1"/><verse number="2" style="v" sid="JAS 2:2"/>ኣዝሶስ፥ ዎርቀ ምግዶ ኣ፥ ሎኦ አፍላ ማኤዝ ዱረ አስ ይ ሺቃይድ የኤዛ። ማ ጩርቃ አፍላ ማኤዝ ማንቆ አስካ የኤዛ። <verse eid="JAS 2:2"/><verse number="3" style="v" sid="JAS 2:3"/>ሎኦ አፍላ ማኤዝ አ ይ ኣ ቦንቺ፥ «ነ Ꮊኔ ሎእዛ ኦይዳትል በቶባ» ግ፥ ማ ማንቆ አ፥ «ነ ኤዛይድ ኤቆባ ዎይ Ꮊኔ ታ ቶኬ ላንቃተ ሳአ በቶባ» ይ ዬግዛ። <verse eid="JAS 2:3"/><verse number="4" style="v" sid="JAS 2:4"/>የዝን፥ ይንቲ፥ ይ ጋንጨ ሻኮ መዝታኔ ኢታ ቆፋር የዝ ዳይንታይ ጋርክ ባሳኔ?<verse eid="JAS 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5"/>ታ ሲቆ እሹን፥ ስኦይታ። አማኖር ዱረ ማቃድ ጋርክ ፋና ቃዝታይስ እማድ ጌዝ ሳሎ ካተት ላቶድ ጋርክ Ꮊ ሳአል ዬዚ ማንቅታ ጾሳይ ዶረካሳኔ? <verse eid="JAS 2:5"/><verse number="6" style="v" sid="JAS 2:6"/>ዝን ይ ማንቅታ ቶችዛ። ይንታን ጪጵችዝታይኔ ፕርደ ኬ ጎችዝታይ ዱርታ ባሳኔ? ይንታን ዳይና ቲና ጎችዝታይ ኡንታን ባሳኔ? <verse eid="JAS 2:6"/><verse number="7" style="v" sid="JAS 2:7"/>ይ ጼግንቴዝ ቦንቾ ሱን ጫዥዝታይ ኡንታን ባሳኔ?<verse eid="JAS 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8"/>ዝን ጌሻ ማጻፋይድ፥ «አስ ኡባ ነና ነ ቃዛይ ጋርክ ቃባ» ግንትንቲ ጻፍንቴዝ ጾስ ካተት ህጋ ይ ፖልኮ ሎኦ ባዝ ኦዛ።<note caller="-" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="LEV 19:18">ለዊ. 19:18</ref></char></note> <verse eid="JAS 2:8"/><verse number="9" style="v" sid="JAS 2:9"/>ዝን ይ አስ ኣፈ ብኢ ቦንችኮ፥ ናጋራ ኦዛ፥ ማ ህጋይ ይንታን ህገ መንዝ አስ ጋርክ ፕርዶዳ። <verse eid="JAS 2:9"/><verse number="10" style="v" sid="JAS 2:10"/>ኦንካ ጾስ ህገ ኡባፕ ፐታ አሺ፥ አቴዝታ ኡባ ናግኮ ኡባና መንዛይ ጋርክ ታይብንትዛ። <verse eid="JAS 2:10"/><verse number="11" style="v" sid="JAS 2:11"/>«ላምፐ» ጌዝ ጎዳይ፥ ማ «ዎፐ» ጌዛ። ዝን ኔኒ ላመካ አቲ ዎዝ ማቅኮ፥ ህገ መንዛ።<note caller="-" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="EXO 20:13-14">ከስ 20:13-14</ref>፤ <ref loc="DEU 5:17-18">ናምእ. 5:17-18</ref></char></note> <verse eid="JAS 2:11"/><verse number="12" style="v" sid="JAS 2:12"/>ዋሎ ከስዛ ህገ ቲና ፕርደ ኤኮዳይስ የዝ አስ ጋርክ ኦድንቶይታነ ኦይታ። <verse eid="JAS 2:12"/><verse number="13" style="v" sid="JAS 2:13"/>አስ ማሮዋ ኦናካ ጾሲ ፕርዶዳ ማሮት ባይ ፕርዶዳ። ማቆዝን ማሮት ፕርዳ ጋምዛ።<verse eid="JAS 2:13"/></para>
  <para style="s1">አማኖኔ ኦሶ</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14"/>ታ እሹን፥ ይንትፕ ፐቲ አሲ ታስ አማኖ የዛ ግ፥ ፋ አማኖ ኦሶር ቤዘካ አትኮ ኤዛ አብ ማዶዴ? ኤ አማናይ ኤዛ አሾዳይስ ዳንዳእኔ? <verse eid="JAS 2:14"/><verse number="15" style="v" sid="JAS 2:15"/>ኣዝሶስ ፐቲ እሻይ ዎይ ፐቲ ምሽታ ካሎትኮኔ ኡንትስ ሚዝባዝ ብኮ፥ <verse eid="JAS 2:15"/><verse number="16" style="v" sid="JAS 2:16"/>ይንትፕ ፐቲ አሲ ኡንትኮ፥ «ሳሮ Ꮊንጎይታ! ይንታን ሆኦ! ም ምዦይታ!» ግ፥ ኮሽዛ ባዝ ኡንትስ እንገካ አትኮ ኡንታን አብ ማዴ? <verse eid="JAS 2:16"/><verse number="17" style="v" sid="JAS 2:17"/>የይ ግሾስ፥ ኦሶ ባ አማኖ ፋ ኣዳስ Ꮊይቆ።<verse eid="JAS 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18"/>ዝን ፐቲ አሲ፥ «ኔስ አማኖ የዛ፤ ማ ታስ ኦሶ የዛ። ነ ነ አማና ነ ኦሳይፕ ሻኪ ታና ቤዞባ፤ ታካ ታ አማና ታ ኦሶር ነና ቤዞዳ» ዬግዛ። <verse eid="JAS 2:18"/><verse number="19" style="v" sid="JAS 2:19"/>ኔኒ፥ ፐቲ ጾሲ የዛና አማንዛ፤ የይ የሰ። ቱና አያንታይካ አማንዛ፤ ያሻር ኩኩርዛ። <verse eid="JAS 2:19"/><verse number="20" style="v" sid="JAS 2:20"/>ነኖ ቦዛዮ! አማኖ ኦሶፕ ሻክንቲ Ꮊይቆ ማቄዛና ኤሮዳይስ ኮይኔ? <verse eid="JAS 2:20"/><verse number="21" style="v" sid="JAS 2:21"/>ኑ አዳይ አፍራመ፥ ፋ ናአ እሳቃ ያርሾ አቆል አፋ ጋዴዝ ዎደ ጽሌዛይ ፋ ኦሶር ባሳ?<note caller="-" style="x"><char style="xo" closed="false">2:21 </char><char style="xt" closed="false"><ref loc="GEN 22:1-14">መ. 22:1-14</ref></char></note> <verse eid="JAS 2:21"/><verse number="22" style="v" sid="JAS 2:22"/>ኤ አማናኔ ኤ ኦሳይ ዎላ ኦዛኔ ኤ አማናይ ኦሶር ፖልንቴዛና ቦኦሳ? <verse eid="JAS 2:22"/><verse number="23" style="v" sid="JAS 2:23"/>ጌሻ ማጻፋይ፥ «አፍራመ ጾስ አማኔዛ። ጾሳይ የያ ኤዝስ ጽሎት ኡዲ ታይቤዛ» ጌዛይ ፖልንቴዛ። ማ ኤ ጾስ ዳቦ ግንትንቲ ጼግንቴዛ።<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="GEN 15:6">መ. 15:6</ref>፤ <ref loc="2CH 20:7">2ዜና. 20:7</ref>፤ <ref loc="ISA 41:8">ኢሳ. 41:8</ref></char></note> <verse eid="JAS 2:23"/><verse number="24" style="v" sid="JAS 2:24"/>አሲ አማኖ ኣዳር ባዝን ኦሶር ጽልዛና ነ ብእኔ።<verse eid="JAS 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JAS 2:25"/>የይ ጋርከ፥ ዉሹምዛና ራአባ እስራኤለፕ ኪትንቴዝታ ሞኪ ሀራ ኦገር ኡንታን ሞይዜዝ ዎደ ፋ ኦሶር ጽለካሳ?<note caller="-" style="x"><char style="xo" closed="false">2:25 </char><char style="xt" closed="false"><ref loc="JOS 2:1-21">ኢያ. 2:1-21</ref></char></note><verse eid="JAS 2:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 2:26"/>ሸምፖፕ ሻክንቴዝ አሻይ Ꮊይቆ ማቄዛይ ጋርክ፥ ኦሶፕ ሻክንቴዝ አማናይካ Ꮊይቄዝባዝ።<verse eid="JAS 2:26"/></para>
  <chapter eid="JAS 2"/>
  <chapter number="3" style="c" sid="JAS 3"/>
  <para style="s1">እራን ናጎ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1"/>ታ እሹን፥ ይንታፕ ጋምታይ አስታማረ ማቅፐ። ኑ፥ አስታማርታይ Ꮊንክታይፕ ኣዝ ፕርዳ ኤኮዳና ይ ኤርዛ። <verse eid="JAS 3:1"/><verse number="2" style="v" sid="JAS 3:2"/>ኑ ኡቢታይ ጋመባዛር ባልንትዛ። ፋ ኦዳይር ባልንቶዋ ኦንካ ፋናት ናጎዳይስ ዳንዳእዛ ፎሎ አስ። <verse eid="JAS 3:2"/><verse number="3" style="v" sid="JAS 3:3"/>ፓርታይ ኑስ ኪትንቶድ ጋርክ ብጻላ ባርሲ ኑ ኮይዝ አቆ ኡባ ካንግዛ። <verse eid="JAS 3:3"/><verse number="4" style="v" sid="JAS 3:4"/>ማርካበ አብ ጋርክ ግታ ማቅኮካ ዎልቃማ ጫርኮር ኡርቅንትኮካ፥ ላግዛይ ፋ ኮይዝ አቆል ማሂ ላግዛ ጽቃ ምር ላግንቲ Ꮊንግዛ። <verse eid="JAS 3:4"/><verse number="5" style="v" sid="JAS 3:5"/>የይ ጋርክ እራን አሰት ክፕለፕ ጽቃት ማቅኮካ ጋመ ዳማባዛል ጬቅንትዛ።</para>
  <para style="p" vid="JAS 3:5">ጽቃ ታማ ዳማ ዎራ ጹግዛ። <verse eid="JAS 3:5"/><verse number="6" style="v" sid="JAS 3:6"/>እራን ታማ ጋርከ። እራን ኑ አሰት ጋንጨ የዝ ኢታ አላመ፤ አሰት ኡባ ቱንስዛ። ጋናመፕ ከዝዝ ታማ ጋርክ ኑ ደኦ ላሶ ኡባ ጹግዛ። ፋ ኦማስካ ጹግንቶዳ <verse eid="JAS 3:6"/><verse number="7" style="v" sid="JAS 3:7"/>ቢታ ዶእታኔ ካፍታ፥ ኡሎር ጎሽንትዝታኔ አባ የዝ መትታካ ኡባ አሲ ሞድዛ፤ ኡንትካ ሞድንቴዛ። <verse eid="JAS 3:7"/><verse number="8" style="v" sid="JAS 3:8"/>ዝን ኦንካ እራን ሞዶዳይስ ዳንዳኤካያ። እራን ዎዛ ማርዘ ኩሜዝ ሞድንቶዋ ኢታ መት። <verse eid="JAS 3:8"/><verse number="9" style="v" sid="JAS 3:9"/>ኑ እራንር ኑ ጎዳነ ኑ ኣዳ ጾሳ ጋላትዛ። ማ ኤዛር ጾስ ኣዚ መንቴዝ አስ ባድዛ። <verse eid="JAS 3:9"/><verse number="10" style="v" sid="JAS 3:10"/>ፐቲ ዶናፐ ጋላታኔ ባድ ከዝዛ። ታ እሹን፥ Ꮊይ ጋርክ ሀኖዳይስ ቤዞያ።<note caller="-" style="x"><char style="xo" closed="false">3:9-10 </char><char style="xt" closed="false"><ref loc="GEN 1:26">መ. 1:26</ref></char></note> <verse eid="JAS 3:10"/><verse number="11" style="v" sid="JAS 3:11"/>ፐቲ ኦላፕ ማልእዛ ሃኔ ጫንግዛ ሃ ፑልቶዳይስ ዳንዳእኔ? <verse eid="JAS 3:11"/><verse number="12" style="v" sid="JAS 3:12"/>ታ እሹን፥ ባላሰ ም ዎይራ ኣፎዳይስ ዳንዳእኔ? ዎይ ዎይነ ም ባላሰ ም ኣፈ ኣፎዳይስ ዳንዳእኔ? ጫሞ ሃፕ ማልእዛ ሃ በንቶዳይስ ዳንዳእኔ።<verse eid="JAS 3:12"/></para>
  <para style="s1">ሳሎ ኤጨትኔ ሳአ ኤጨት</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13"/>ይ ጋንጨ ኤጫኔ አካክዛይ ኦኖ? ፋ ሎኦ የሳር፥ ሃዮትር ኤጨትር ፋ ኦዝ ኦሳ ቤዞ። <verse eid="JAS 3:13"/><verse number="14" style="v" sid="JAS 3:14"/>ዝን ይ ዎዝናይድ ጫንግዛ ቅናተኔ ፋና ቃዝ ኤጨት የዝኮ ጋይርንትፓተ፤ ቱማል አፋ ዎርዶትፓተ። <verse eid="JAS 3:14"/><verse number="15" style="v" sid="JAS 3:15"/>የይ ጋርክ ኤጨትይ ሳሎፕ የኤዝ ባዝ ባዝን የይ አሾፐ፥ አላመፐኔ፥ ጻላሄፐ። <verse eid="JAS 3:15"/><verse number="16" style="v" sid="JAS 3:16"/>ቅናተኔ ፋና ዶሶ የዝ አቆ ካችኔ ኢታ ኦሶ ኡቢታይ የዛ። <verse eid="JAS 3:16"/><verse number="17" style="v" sid="JAS 3:17"/>የያ ማቆዝን ኣፋፕ ይእዝ ኤጨትይ ኡባይፕ ቲና ጌሺ። ማ የይፐ ሳሮት፥ ሎኦት፥ ስኢ ኤክዛ፥ ቃንትዛ፥ ሎኦ ኣፈ ኩሜዛኔ፥ አስ ሻጎዝታኔ ጩቦተ ባዛያ። <verse eid="JAS 3:17"/><verse number="18" style="v" sid="JAS 3:18"/>ሳሮት ዶስዝታይ ሳሮት ዘሪ ጽሎት ማጽዛ።<verse eid="JAS 3:18"/></para>
  <chapter eid="JAS 3"/>
  <chapter number="4" style="c" sid="JAS 4"/>
  <para style="s1">አላመል የዝ እታት እጾ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1"/>ካችኔ ኦላ ይ ጋንጨ አናፕ የኤኔ? የይትታይ ይ አሰትታይ ጋንጨ ኦልንትዛ ይ አሾ እናፕ ባሳኔ? <verse eid="JAS 4:1"/><verse number="2" style="v" sid="JAS 4:2"/>ይንቲ አሞትዛ፥ ዝን ደንጋሚ፤ የይ ግሾስ ዎዛ። ሚን ኮይዛ፥ ዝን ደንጎዳይስ ዳንዳኦያ፤ የይ ግሾስ ካጭንትዛኔ ኦልንትዛ። ይ ጾሳ ዎሶዋ ግሾስ ኮይዝ ባዝ ደንጋም። <verse eid="JAS 4:2"/><verse number="3" style="v" sid="JAS 4:3"/>ይ ዎስዛ፥ ዝን ደንጋሚ። ይ አሾ አሞ ፖሎዳይስ ዡጫ ኦገር ዎስዛ ግሾስ ደንጋሚ። <verse eid="JAS 4:3"/><verse number="4" style="v" sid="JAS 4:4"/>ይንታኖ፥ ካድዝታዮ! Ꮊ አላመ ዶስዛይ ጾሳር ሞርከ ማቅዛና ይ ኤሮሳ? Ꮊ አላማይር ዳቦቶዳይስ ኮይዝ ኦንካ ጾሳር ሞርከ። <verse eid="JAS 4:4"/><verse number="5" style="v" sid="JAS 4:5"/>ጌሻ ማጻፋይ፥ «ጾሳይ ኑር የዞድ ጋርክ ኦዝ አያናይ፥ ኑኒ ኤዝስ ቡዞ ማቃድ ጋርክ ሎእ አሞትዛ» ጌዛይ ጨረ ኦድዝባዝ ኣዝኔ? <verse eid="JAS 4:5"/><verse number="6" style="v" sid="JAS 4:6"/>ዝን ጌሻ ማጻፋይ፥ «ጾሳይ ኡትርትዛ አስታ እጽዛ፥ ዝን ሀይታይስ ኣ ኬሄት እንግዛ» ዬግዝ ግሾስ ጾሳይ ኣ ኬሄት ጋን እንግዛ።<note caller="-" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="PRO 3:34">ኣዝ. 3:34</ref></char></note><verse eid="JAS 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 4:7"/>የይ ግሾስ፥ ጾስስ ሞድንቶይታ፤ ዳቡሎሳር ኤቅንቶይታ፤ ኤ ይንታፕ ሃኮዳ። <verse eid="JAS 4:7"/><verse number="8" style="v" sid="JAS 4:8"/>ጾስኮ ሺቆይታ፤ ኤ ይንትኮ ሺቆዳ። ይንታኖ፥ ናጋራንችታዮ፥ ይ ኩሻ ሜጮይታ፤ ናምኢ ቆፋር የዝታዮ፥ ይ ዎዝና ጌሾይታ። <verse eid="JAS 4:8"/><verse number="9" style="v" sid="JAS 4:9"/>ካያቶይታ፥ ዬኮይታኔ አፉጾይታ። ይ ሚቻይ ዬፎር፥ ይ ኡፋይሳይ አዛኖር ላምንቶ። <verse eid="JAS 4:9"/><verse number="10" style="v" sid="JAS 4:10"/>ጎዳይ ቲና ይ ኡባ ዝቃ ኡዶይታ፤ ኤ ይንታን ቅ ቅ ኡዶዳ።<verse eid="JAS 4:10"/></para>
  <para style="s1">አሳል አፋ ፕርድፓተ</para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11"/>ታ እሹን፥ ፐታይ ፐታ ዝግርፓተ። ፋ እሻ ዝግርዛይኔ ኤዛል አፋ ፕርድዛይ ህገ ዝግርዛኔ ህገል አፋ ፕርድዛ። ኔኒ ህገል አፋ ፕርድኮ ህገል አፋ ፕርድዛ ማቅዛፕ አትን ህገ ፖልዛ አስ ነ ማቆያ። <verse eid="JAS 4:11"/><verse number="12" style="v" sid="JAS 4:12"/>ህገ እንግዛይኔ ፕርድዛይ ጾስ ኣዳ። አሾዳይስኔ ብሶዳይስ ዳንዳእዛይ ኤዛ። የዝን፥ አሳል አፋ ፕርድዛይ ነ ኦኖ?<verse eid="JAS 4:12"/></para>
  <para style="s1">ጬቅንትፓተ</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13"/>ይ፥ «ኑኒ Ꮊይኖ ዎይ ዎንታ የ ካታማ ዎይ Ꮊ ካታማ Ꮊማዳ፤ ኤዛይድ ላይ በቶዳ፤ ዛልእ ዎሶዳ» ዬግዝታዮ፥ ስኦይታ።<note caller="-" style="x"><char style="xo" closed="false">4:13-14 </char><char style="xt" closed="false"><ref loc="PRO 27:1">ኣዝ. 27:1</ref></char></note> <verse eid="JAS 4:13"/><verse number="14" style="v" sid="JAS 4:14"/>ዎንታ አቢ ሀኖዳዛኮ ይ ኤሮያ። ይ የሳይ ዋያዳዛኮ ኤርዛይ ኦኖ? ይንቲ ጽቃ ዎደ በንቲ ብዛ ሻራ ጋርከ። <verse eid="JAS 4:14"/><verse number="15" style="v" sid="JAS 4:15"/>የያ አሺ፥ «ጎዳይ ጊኮ ኑኒ የዞዳ፤ Ꮊያ ዎይ የያ ኦዳ» ዬጎዳይስ ቤዝዛ። <verse eid="JAS 4:15"/><verse number="16" style="v" sid="JAS 4:16"/>ዝን ይ Ꮊተ ኡትርትዛኔ ጬቅንትዛ። የይ ጋርክ ጬቅንታ ኡባይ ኢታ።<verse eid="JAS 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 4:17"/>የይ ግሾስ፥ ሎኦ ባዝ ኦዳይስ ኤርታር ኦዋ አይስ የይ ናጋራ።<verse eid="JAS 4:17"/></para>
  <chapter eid="JAS 4"/>
  <chapter number="5" style="c" sid="JAS 5"/>
  <para style="s1">ዱርታይስ እንግንቴዝ ናግሶ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1"/>Ꮊተካ ይንታኖ፥ ዱርታዮ፥ ይንታል አፋ ኢታ መታይ ይእዛ ግሾስ ዎ ዎ ግ ዬኮይታ። <verse eid="JAS 5:1"/><verse number="2" style="v" sid="JAS 5:2"/>ይ ሻላይ ቡቄዛ፤ ይ አፍላይካ ብላር ሚንትንቴዛ።<note caller="-" style="x"><char style="xo" closed="false">5:2-3 </char><char style="xt" closed="false"><ref loc="MAT 6:19">ማቶ. 6:19</ref></char></note> <verse eid="JAS 5:2"/><verse number="3" style="v" sid="JAS 5:3"/>ይ ዎርቃይኔ ይ ብራይ ባልቴዛ። የ ባልትይ ይንትስ ማርካ ማቃዳ። የይካ ይ አሻ ታማ ጋርክ ማዳ። ይ Ꮊ ዉሬዝ ቃምታይድ ይንትስ ሻሎ ጋንዛ። <verse eid="JAS 5:3"/><verse number="4" style="v" sid="JAS 5:4"/>ይንቲ ጋደ ኦ ፔዤዝ አሳይ ከራ ሚሸ ይ ጭግበኤካያ። የይ ይንታል አፋ ኡክዛ። የ አሳይ ኡፋይ ዎልቃማ ጎዳይ ሀየ ስንቴዛ።<note caller="-" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="DEU 24:14-15">ናምእ. 24:14-15</ref></char></note> <verse eid="JAS 5:4"/><verse number="5" style="v" sid="JAS 5:5"/>Ꮊ ሳአል ይንትስ ጊግን ኡፋይሳር የሳዳይስ ቆፒ፥ ሹኮስ ጊግንቴዝ መሄ ጋርክ ይንታን ክ ኦርድሴዛ። <verse eid="JAS 5:5"/><verse number="6" style="v" sid="JAS 5:6"/>ይንታር ኤቅንቶዋዝን ጽላያ ይ ፕርዴዛ፤ ኤዛ ዎዛ።<verse eid="JAS 5:6"/></para>
  <para style="s1">ጋርዦኔ ዎሳ</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7"/>ታ እሹን፥ ጎዳይ ይእ ጋርዢ ናጎይታ። ዎታር አቅዝ አይ ቶርቼል ቲና እራኔ ጉየ እራ የኦድ ጋ ጋርዢ አልኦ ካ ቢታፕ ዋይዚ ናጊ ሄል ኤክዛኮ ቆፖይታ። <verse eid="JAS 5:7"/><verse number="8" style="v" sid="JAS 5:8"/>ይንትካ ጋርዦይታ። ጎዳ ይእይ ኡኬዝ ግሾስ ኡፋይሳር ናጎይታ።<verse eid="JAS 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 5:9"/>ታ እሹን፥ ጾሳይ ይንታል አፋ ፕርዳም ጋርክ ፐታይ ፐታይል አፋ ዝግርፓተ። ፕርድዛይ ፐንገል ኤቄዛ። <verse eid="JAS 5:9"/><verse number="10" style="v" sid="JAS 5:10"/>ታ እሹን፥ ዋዬር ጋርዤዝ፥ ጎዳይ ሱንር ኦዴዝ ናብታ ኣዝሶ ኡዲ ኤኮይታ። <verse eid="JAS 5:10"/><verse number="11" style="v" sid="JAS 5:11"/>ዳንዳአር ጋርዤዝታ ኑኒ አንጅንቴዝታ ግዛ። ኢዮባ ዋይዚ ጋርዤዛኮ ይ ስኤዛ። ጎዳይ ዉርስል ኤዛ ዋይዚ ማዴዛኮ ይ በኤዛ። ኤ ማሮትኔ ቃ ኩሜዝ ጎዳ ማቄዝ ግሾስ የያ ኦዛ።<note caller="-" style="x"><char style="xo" closed="false">5:11 </char><char style="xt" closed="false"><ref loc="JOB 1:21-22">ኢዮ. 1:21-22</ref>፤ <ref loc="JOB 2:10">2:10</ref>፤ <ref loc="PSA 103:8">ማዝ. 103:8</ref></char></note><verse eid="JAS 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12"/>ዝን ኡባፕ ቲና፥ ታ እሹን፥ ሳሎር ማቅን ዎይ ሳአር ማቅን ዎይ ሀራ አባራካ ጫቂፓተ። ጾስ ፕርዳ ይ ገላማይጋርከ ይ ኦዳይ ኤ ማቅኮ፥ «ኤ» ጎይታ፤ ዋኣ ማቅኮ፥ «ዋኣ» ጎይታ።<note caller="-" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="MAT 5:34-37">ማቶ. 5:34-37</ref></char></note><verse eid="JAS 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13"/>ይ ጋንጨ መቶ ኤክዛ ኦንካ የዝኮ ጾሳ ዎሶ። ኡፋይትዛ ኦንካ የዝኮ ጋላታር የጾ። <verse eid="JAS 5:13"/><verse number="14" style="v" sid="JAS 5:14"/>ይንትፕ ሀርግንቴዝ ኦንካ የዝኮ ዎሳ ኬ ጭምታ ጼጎ። ኡ ጎዳይ ሱንር ዎይራ ዛይተ ትዢ ኤዝስ ጾሳ ዎሶ።<note caller="-" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="MAT 5:34-37">ማቶ. 5:34-37</ref></char></note> <verse eid="JAS 5:14"/><verse number="15" style="v" sid="JAS 5:15"/>አማኖር ዎሴዝ ዎሳይ ሀርገር የዛና ፓዛ። ጎዳይ ኤዛ፥ ሀርገፕ ደንዛ፤ ኤ ናጋራ ኦዝ ባዝ ማቅኮካ ጎዳይ ኤዛ ማርዛ። <verse eid="JAS 5:15"/><verse number="16" style="v" sid="JAS 5:16"/>የይ ግሾስ፥ ይ ፓጾድ ጋርክ ይ ናጋራ ፐታይ ፐታይስ ፓጾይታኔ ፐታይ ፐታይስ ዎሶይታ። ጽሎ አስ ዎሳይ ዎልቃማ ኦሶ ኦዛ። <verse eid="JAS 5:16"/><verse number="17" style="v" sid="JAS 5:17"/>ኤላሳ ኑ ጋርክ አስ ዝን እራ ሳአል ቡካማይ ጋርክ ሚን ጾስ ዎስን ሀይ ላይኔ ኡሱፑን አግና ሳአል እራ ቡከካያ።<note caller="-" style="x"><char style="xo" closed="false">5:17 </char><char style="xt" closed="false"><ref loc="1KI 17:1">1ካት. 17:1</ref>፤ <ref loc="1KI 18:1">18:1</ref></char></note> <verse eid="JAS 5:17"/><verse number="18" style="v" sid="JAS 5:18"/>ማቂ ኤ ጾሳ ዎስን ሳሎፕ እራ ቡኬዛ፤ ሳአይካ ካ ዶልሴዛ።<note caller="-" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="1KI 18:42-45">1ካት. 18:42-45</ref></char></note><verse eid="JAS 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 5:19"/>ታ እሹን፥ ይንታፕ ኦንካ ቱማ ኦገፐ ቡትኮ፥ ሀራይ ኤዛ ቱማኮ ማህኮ፥ <verse eid="JAS 5:19"/><verse number="20" style="v" sid="JAS 5:20"/>ናጋራ ኦዛና የ ቡታ ኦገፐ ማህዝ ኦንካ፥ ኤ ሸምፖ Ꮊይቆፕ አሽዛኔ ኤ ጋመ ናጋራይስ ማሮት እንግዛና ኤሮ።<note caller="-" style="x"><char style="xo" closed="false">5:20 </char><char style="xt" closed="false"><ref loc="PRO 10:12">ኣዝ. 10:12</ref>፤ <ref loc="1PE 4:8">1ጵጽ. 4:8</ref></char></note><verse eid="JAS 5:20"/></para>
  <chapter eid="JAS 5"/>
</usx>
