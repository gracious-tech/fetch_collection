<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ROM" style="id">- Melo New Testament Ethiopic</book>
  <para style="h">ኦሮመ</para>
  <para style="toc1">ጳዉሎሳ ኦሮመ አሳይስ ጻፌዝ ኪታ</para>
  <para style="toc2">ኦሮመ</para>
  <para style="toc3">ኦሮ.</para>
  <para style="mt1">ጳዉሎሳ ኦሮመ አሳይስ ጻፌዝ ኪታ</para>
  <para style="imt">ገሎ</para>
  <para style="ip">ሀዋረ ጳዉሎሳ ኪታይ ኦሮመ አሳይስ ጻፍንቴዛይ፥ ጳዉሎሳ ኦሮመ ጋንጨ የዝ ዎሳ ኬ በአዳይስ ቆፔዝ ግሾስ ኤ Ꮊንጎዳር ኡንቲ ጊግንቲ ናጎድ ጋርክ ኦዶዳሲ። ጳዉሎሳ ቆፋይ ኦሮመ ጋንጨ የዝ አማንዝታይራ ጽቃ ዎደ ኦዛይፕ ጉየ ኡንቲ ኤዛ ማድን እስፔነ Ꮊማዳይሲ። አማኖባ ባጋ ኤ ኤሬዛኔ አማንዛ አሳይ የ ትምርታ ኦሶል አፋ ፔሾድ ጋርክ ቆንጭሲ ጻፌዛ። Ꮊ ማጻፋይ ጋንጨ ጳዉሎሳ ኩን ኪታይ Ꮊ ቆፋ አይክዛ።</para>
  <para style="ip">ጳዉሎሳ ኦሮመ ጋንጨ የዝ አማንዛ አስታ ቲናቲ ሳሮ ማቂ፥ ኡንትስ ዎስዛና ኦዴዛይፕ ጉየ ፋ ኪታይስ ባሶ ቆፋ፥ «ዎንግላይድ ጾሳ ጽሎትይ በንቴዛ፤ የ ጽሎትይ ቲናፕ ዉርስ ሄሎዳይስ አማኖር በንቴዛ» ግ ኦድዛ (1:17)።</para>
  <para style="ip">የይፕ ጉየ፥ የ ቆፋ ዳልግሲ ጻፍዛ። አይሁድታ ማቅን አይሁደ ባ አታ ማቅን ኡቢታይ ናጋራስ ሞድንቴዝታ ማቄዝ ግሾስ ኡንቲ ጾሳር ዳቦቶዳይስ ኮሽዛ። አሳይ ጾሳር ዳቦቶዳይስ ዳንዳእዛይ የሱስ ክርስቶሳና አማኖራ። ኡንቲ ጾሳር መዛ Ꮊ ኦሮ ፐትፐተ ኣፋይ፥ ኦሮ የስ ማቅዛና ጳዉሎሳ ዳልግሲ ኦድዛ። አማንዛ አስ ጾሳር ሳሮ የዛ፤ ማ ጾሳ አያና ባጋር ናጋራፐኔ Ꮊይቆ ዎልቃፕ ከሲ ኤክዛ። ሸምፖ 5-8 ሄሎዳይስ ጳዉሎሳ ጾስ ህጋይኔ አማንዛ አስ የሳል ኦዝ ጾስ አያና ዎልቃ ቆፋይ አብዛኮ ኦድዛ። የይፕ ካሊ፥ ጳዉሎሳ፥ «ጾሳይ አስ ናእታይስ ቆፔዝ ቆፋ ጋንጨ አይሁድታይኔ አይሁደ ባ አሲ ዋይዚ ዎላ ዋጽንቶዳይስ ዳንዳኤ?» ዬግዝ ኦይቻይስ ማህ እማዳይስ ቡትቴዛ።</para>
  <para style="ip">ማ አይሁድታይ የሱሳ ኤካም እጼዛይ ጾስ ቆፋ ማቄዛና ኦድዛ። የይ ሀኔዛይ የሱስ ክርስቶሳ ባጋር ቆንጭሴዝ ኣ ኬሄትይ ጋንጨ አስ ኮች ኡባይ ኤኮዳይ ጋርከ። ማቆዝን፥ አይሁድታይ የሱሳ ኤኮድ ዎደ የኦዳና ጳዉሎሳ አማንዛ። ዉርሰል ጳዉሎሳ አማኖር ዋይዚ የዞዳይስ ቤዝዛኮ ኦድዛ። ጾስስ ኦ ባጋ፥ አማንዛ አሳይ ፋ ቢታስኔ አሳይስ ዎል ጋንጨ ፐታይ ፐታይስ የዝ አደትር ኦድባዝኔ ካሃ ባጋር መንትዛ ኦይችታይ ባጋ ፓዲ ኦድዛ።</para>
  <para style="iot">ኦሮመ ኪታይ አይኬዝ ቆፍታ</para>
  <para style="io1">ገሎ <char style="ior"><ref loc="ROM 1:1-15">1:1-15</ref> </char></para>
  <para style="io1">ኦሮመ ኪታ ኩስተ ቆፋ <char style="ior"><ref loc="ROM 1:16-17">1:16-17</ref> </char></para>
  <para style="io1">አስ ናአስ አቶት ኮሽዛ ባዝ <char style="ior"><ref loc="ROM 1:18-3:20">1:18—3:20</ref> </char></para>
  <para style="io1">ጾሲ አስ አሽዛ ኦገ <char style="ior"><ref loc="ROM 3:21-4:25">3:21—4:25</ref> </char></para>
  <para style="io1">ክርስቶሳር በንትዝ ኦሮ ደኦ <char style="ior"><ref loc="ROM 5:1-8:39">5:1—8:39</ref> </char></para>
  <para style="io1">እስሬለስ ጾስ ቆፋ <char style="ior"><ref loc="ROM 9:1-11:36">9:1—11:36</ref> </char></para>
  <para style="io1">አማንዛ አስ የስ <char style="ior"><ref loc="ROM 12:1-15:13">12:1—15:13</ref> </char></para>
  <para style="io1">ኩስተ ቆፋኔ ሳሮ <char style="ior"><ref loc="ROM 15:14-16:27">15:14—16:27</ref> </char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="ROM 1"/>
  <para style="p">
    <verse number="1" style="v" sid="ROM 1:1"/>የሱስ ክርስቶሳ አይለ ማቄዝ፥ ሀዋረ ማቃዳይስ ጼግንቴዛይፐኔ ጾሳ ዎንግለ ሳባኮዳይ ጋርክ ሻክንቴዝ ጳዉሎሳ ኪቴዝ ኪታ።<verse eid="ROM 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ROM 1:2"/>ጾሳይ ጋመ ዎደፕ ቲና ፋ ናብታይ ባጋር እማድ ጌዝ ጾስ ዎንግላይ ጌሻ ማጻፍታይድ ጻፍንቴዛ። <verse eid="ROM 1:2"/><verse number="3" style="v" sid="ROM 1:3"/>የ ዎንግላይ አሾር ዳዉተ ሼሻፕ የልንቴዝ፥ ጾስ ናአ፥ ኑ ጎዳ የሱስ ክርስቶሳ ባጋ ኦድዛ። <verse eid="ROM 1:3"/><verse number="4" style="v" sid="ROM 1:4"/>ማ ኤ ፋ ጌሻ አያናር Ꮊይቆፕ ደንዲ፥ ጾስ ናአ ማቅዛና ዳማ ዎልቃር ቤዜዛ። <verse eid="ROM 1:4"/><verse number="5" style="v" sid="ROM 1:5"/>ኤ ባጋር አይሁደ ባዝታይ ኡቢታይ፥ አማኒ ኪትንቶድ ጋርክ ክርስቶሳ ሱንይ ግሾስ ጾሳይ ኣ ኬሃትር ሀዋረት ማዉተ ኑስ እንጌዛ። <verse eid="ROM 1:5"/><verse number="6" style="v" sid="ROM 1:6"/>የሱስ ክርስቶሳስ ማቃድ ጋርክ ጼግንቴዝታይፕ ባግታይ ይንታና።<verse eid="ROM 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 1:7"/>ኦሮመ ጋንጨ የዝ፥ ጾሳይ ቃዝታይስኔ ኤ ጌሽ ዎያ ማቃድ ጋርክ ማራጼዝታይስ፦</para>
  <para style="p" vid="ROM 1:7">ጾሳ ኑ አዳይፐኔ ጎዳ የሱስ ክርስቶሳፕ ኣ ኬሄትኔ ሳሮትይ ይንትስ ማቆ።<verse eid="ROM 1:7"/></para>
  <para style="s1">ፓዉሎሳ ኦሮመ አሳ በአዳይስ አሞት የዛ</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 1:8"/>ኡባፕ ቲናቲ፥ ይ አማናይ ቢታ ኡባይል ስንቴዝ ግሾስ የሱስ ክርስቶስ ባጋር ይ ግሾስ ታ ጾሳ ጋላትዛ። <verse eid="ROM 1:8"/><verse number="9" style="v" sid="ROM 1:9"/>ታኒ ኤ ናአይ ዎንግላይ ባጋ ኩን ዎዝናር ኦድዛ ጾሳይ፥ ታኒ ታ ዎሳይድ ኡባ ዎደ ይንታን ቆፕዛይስ ኤ ማርካ። <verse eid="ROM 1:9"/><verse number="10" style="v" sid="ROM 1:10"/>ዉርስል፥ ጾስ ሸነ ማቅኮ፥ ታኒ ይንትኮ Ꮊማዳይስ ኦጋይ ታስ ኡሻቾድ ጋርክ ኡባ ዎደ ዎስዛ። <verse eid="ROM 1:10"/><verse number="11" style="v" sid="ROM 1:11"/>ታኒ ይንትስ አያና እሞት ሻጎዳይስኔ ይንታን በአዳይስ ላሞትዛ። <verse eid="ROM 1:11"/><verse number="12" style="v" sid="ROM 1:12"/>የይካ፥ ታኒ ይ አማናይር፥ ማ ይ ታ አማናይር ሚንጎዳይ ጋርከ።<verse eid="ROM 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 1:13"/>ታ እሹን፥ ታኒ አይሁደ ባ አሳይፕ ኣፈ ደንጌዛይ ጋርክ፥ ይንታፐካ ኣፈ ደንጎዳይስ ይንትኮ Ꮊማዳይስ ቆፔዛ፥ ዝን ታና ካዬዛ።<note caller="-" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="ACT 19:21">ሀዋ. ኦ. 19:21</ref></char></note> <verse eid="ROM 1:13"/><verse number="14" style="v" sid="ROM 1:14"/>ግርኬ አሳይስኔ ታማረካ አሳይስ ማ ኤጭታይስኔ ቦዝታይስ ታስ አጮ የዛ።<verse eid="ROM 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 1:15"/>የይ ግሾስ፥ ኦሮመ ጋንጨ የዝ ይንትስካ ዎንግለ ኦዶዳይስ ታ አሞትዛ።<verse eid="ROM 1:15"/></para>
  <para style="s1">ዎንግለ ዎልቃ</para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 1:16"/>ዎንግላይር ዬላታም፥ ቲናቲ አይሁደ፥ ኤዛይፕ ግርኬ አሳይስ አማንዝታ ኡባ አሾዳይስ ዎንግላይ ጾስ ዎልቃ።<note caller="-" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="MRK 8:38">ማር. 8:38</ref></char></note> <verse eid="ROM 1:16"/><verse number="17" style="v" sid="ROM 1:17"/>ጽሎ አማኖር ደኦ የዞዳ ግንትንቲ ጻፍንቴዛ። ጾስ ጽሎትይ በንቴዛ፤ ቲናፕ ዉርስ ሄሎዳይስ አሲ ጽልዛይ አማኖራ።<note caller="-" style="x"><char style="xo" closed="false">1:17 </char><char style="xt" closed="false"><ref loc="HEB 2:4">እብራ. 2:4</ref></char></note><verse eid="ROM 1:17"/></para>
  <para style="s1">ኢታት</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 1:18"/>ቱማይ ኤርንታም ጋርክ ፋ ኢታ ኦሶር ካይዛ አሳል አፋኔ ናጋራ ኡባይል አፋ፥ ጾስ ሴራ ሳሎፕ ዎዛ። <verse eid="ROM 1:18"/><verse number="19" style="v" sid="ROM 1:19"/>ጾሳይ ኡንትስ በንቶዳይስ ቤዝዛ ባዝ ቆንጭሴዝ ግሾስ ኡንቲ ጾስባዝ ኤርዛ። <verse eid="ROM 1:19"/><verse number="20" style="v" sid="ROM 1:20"/>አላመ መንቴዛይፕ አይኪ፥ አስስ በንቶዋ ጾስ ሀኖታ፥ የይካ ኤ መና ዎልቃኔ ጾሳትይ ኤ መትይር በንቲ የዛ ግሾስ አሳይ ፋ ኢታትስ ሳላምቦድባዝ ባያ።<verse eid="ROM 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 1:21"/>ኡንቲ ጾሳ ኤርታር፥ ኤዛ ቦንቼካያኔ ጋላተካያ። ኡ ቆፋይ ማዶዋ ባዝ ማቄዛ፤ ኡ አካኮዋ ዎዝናይ ሜዛ።<note caller="-" style="x"><char style="xo" closed="false">1:21 </char><char style="xt" closed="false"><ref loc="EPH 4:17-18">ኤፍ. 4:17-18</ref></char></note> <verse eid="ROM 1:21"/><verse number="22" style="v" sid="ROM 1:22"/>ኡንቲ ፋና ኤጭታ ግዛ፥ ዝን ቦዝታ። <verse eid="ROM 1:22"/><verse number="23" style="v" sid="ROM 1:23"/>ቦዋ ጾሳ ጎይኖዳና አሺ፥ Ꮊይቅዝ አስ ምስለ፥ ካፍታይ ምስለ፥ ዶእታይ ምስለኔ ኡሎር ጎችንትዛ ባዝታ ኣዝሲ ኦዝ ምስልታ ጎይኔዛ።<note caller="-" style="x"><char style="xo" closed="false">1:23 </char><char style="xt" closed="false"><ref loc="DEU 4:16-18">ናምእ. 4:16-18</ref></char></note><verse eid="ROM 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 1:24"/>የይ ግሾስ፥ ኡንቲ ፐታይ ፐታይር ቦርሶ ባዝ ኦ፥ ፋ ጋላ ቶቾድ ጋርክ ጾሳይ ኡንታን ኡ ዎዝናይ አሞትዝ ቱና ኦሶስ ኣ እንጌዛ። <verse eid="ROM 1:24"/><verse number="25" style="v" sid="ROM 1:25"/>የይ ሀኔዛይ ኡንቲ ጾስ ቱሮት ዎርዶር ላሜዝ ግሾኔ መዝ ጾሳ አሺ፥ መት ጎይኔዝ ግሾስ። ጾሳይ መናስ ጋላትንቴዛያ። አምንኤ።<verse eid="ROM 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 1:26"/>የይ ግሾስ፥ ጾሳይ ኡንታን ኡ ቦርሶ አሞትይስ ኣ እንጌዛ። ኡ ማችታይ ፓስ ቤዝዛ ራር አቆዳ አሺ፥ ቤዞዋ ባዝ ሀኒ ማቺ ማቻር ዎላ አቄዛ። <verse eid="ROM 1:26"/><verse number="27" style="v" sid="ROM 1:27"/>የይ ጋርክ፥ ራታይ ፓስ ቤዝዛ ማቻር አቅዛ አሺ፥ ራ ራር ዎላ አቄዛ። ራ ፐታይ ፐታይር አሞትር ጹግንቲ፥ ቦርሶ ባዝ ኦዛ። ፋ ኦዝ ቡታይስ ቤዝዛ ፕርደ ኤኬዛ።<verse eid="ROM 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 1:28"/>ኡንቲ ጾሳ ኤሮዳይስ እጼዝ ግሾስ ቤዞዋ ባዝ ኦድ ጋርክ ጾሳይ ኡ ካሃ ፓም ቆፋስ ኣ እንጌዛ። <verse eid="ROM 1:28"/><verse number="29" style="v" sid="ROM 1:29"/>ኡንታር ዡጫት፥ ኢታት፥ ኡዛት፥ ገነ፥ ቅናተ፥ ሸምፖ ዎ፥ ፓላማ፥ ዶሻኔ ኢታ አሞ ኩሜዛ። ኡንቲ ዝግርዝታ፥ <verse eid="ROM 1:29"/><verse number="30" style="v" sid="ROM 1:30"/>አስ ሱን ኢስዝታ፥ ጾስ እጽዝታ፥ ጫዥዝታ፥ ኡትርትዝታ፥ ጬቅንትዝታ፥ ኢታ ባዝ ኦዳይስ ኮይዝታኔ ፋ እንድስኔ ፋ አዴስ ኪትንቶዝታ፥ <verse eid="ROM 1:30"/><verse number="31" style="v" sid="ROM 1:31"/>አካኮዝታ፥ ጫቆ መንዝታ፥ ሲቆ ባዝታ፥ ቃ ባዝታ። <verse eid="ROM 1:31"/><verse number="32" style="v" sid="ROM 1:32"/>የይትታይ ጋርክ ኦዝታይስ Ꮊይቆ ቤዝዛ ግዝ ጾሳ ህገ ኤርታር፥ Ꮊይትታ ኦዛ። ኡ ፓስ ኦሶ ኣዳ ባዝን ኦዛ Ꮊንክታካ ሳቢዛ።<verse eid="ROM 1:32"/></para>
  <chapter eid="ROM 1"/>
  <chapter number="2" style="c" sid="ROM 2"/>
  <para style="s1">ጾስ ጽሎ ፕርደ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 2:1"/>የይ ግሾስ፥ ነኖ ሀራ አሳል አፋ ፕርድዛዮ፥ ኔኒ ሳንከ ሽሽዛባዝ ባያ። ኔኒ ሀራ አሳል አፋ ፕርድታር፥ የ ነ ፕርድዛ አይ ጋርክ ኦኮ፥ ነ፥ ኔል አፋ ፕርድዛ።<note caller="-" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="MAT 7:1">ማቶ. 7:1</ref>፤ <ref loc="LUK 6:37">ሉቃ. 6:37</ref></char></note> <verse eid="ROM 2:1"/><verse number="2" style="v" sid="ROM 2:2"/>የይ ጋርክ ኦዝታይል አፋ ጾሲ ጽሎ ፕርዳ ፕርድዛ ኑ ኤርዛ። <verse eid="ROM 2:2"/><verse number="3" style="v" sid="ROM 2:3"/>ነኖ፥ የይ ጋርክ ኦሶ ኦዝታይል አፋ ፕርድዛዮ፥ ኡንቲ ኦዛኒ ጋርክ ኦዛዮ፥ ኔኒ ጾስ ፕርዳፕ አቶድባዝ ኣዝኔ? <verse eid="ROM 2:3"/><verse number="4" style="v" sid="ROM 2:4"/>ዎይ ጾስ ኬሄት፥ ጋርዦኔ ዳንዳአ ዱረት ነ ለቅኔ? ጾሲ ኔስ ኬሄዛይ ነና ናጋራፕ ማሆዳይስ ማቅዛና ኤሮሳኔ?<verse eid="ROM 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 2:5"/>ዝን ይንትስ ምኖኔ ማሮተ ገሎዋ ዎዝና የዛ። የይ ግሾስ፥ ጾስ ሴራይኔ ጽሎ ፕርዳይ በንትዝ ጋላስ፥ ኔል አፋ ፕርዳይ ኩሮድ ጋርክ ኡድዛ። <verse eid="ROM 2:5"/><verse number="6" style="v" sid="ROM 2:6"/>ጾሳይ ፐታይስ ፐታይስ ኤ ኦሳት ጋርክ እማዳ።<note caller="-" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="PSA 62:12">ማዝ. 62:12</ref>፤ <ref loc="PRO 24:12">ኣዝ. 24:12</ref></char></note> <verse eid="ROM 2:6"/><verse number="7" style="v" sid="ROM 2:7"/>ሎኦ ኦሶር ሚንጊ፥ ጋላታ፥ ቦንቾኔ ቦዋ ደኦ ኮይዝታይስ ጾሳይ መና ደኦ እማዳ። <verse eid="ROM 2:7"/><verse number="8" style="v" sid="ROM 2:8"/>ዝን ፋና ሲቅዝታ፥ ቱማ እጽዝታኔ ኢታ ባዝ ኦዳይስ ኮይዝታይል አፋ ጾስ ሴራኔ ጋዶ የኦዳ። <verse eid="ROM 2:8"/><verse number="9" style="v" sid="ROM 2:9"/>ኢታ ባዝ ኦዝ አስ ኡብታ፥ ቲናቲ አይሁድታ፥ ኤዛይፕ ግርኬ አሳ መቶኔ ኡንአ ሄሎዳ። <verse eid="ROM 2:9"/><verse number="10" style="v" sid="ROM 2:10"/>ዝን ጾስ ሎኦ ኦሶ ኦዝ ኡባይስ፥ ቲናቲ አይሁድታይስ፥ ካሊ ግርኬስ ጋላታ፥ ቦንቾኔ ሳሮት እማዳ። <verse eid="ROM 2:10"/><verse number="11" style="v" sid="ROM 2:11"/>ጾሳይ አስ ኣፈ ብኢ ሻኮያ።<note caller="-" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="DEU 10:17">ናምእ. 10:17</ref></char></note><verse eid="ROM 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 2:12"/>ህገ ባ ናጋራ ኦዝ ኡቢታይ ህገ ባ ቦድ። ህገ የዝን፥ ናጋራ ኦዝ ኡባይ ህገር ፕርድንቶዳ። <verse eid="ROM 2:12"/><verse number="13" style="v" sid="ROM 2:13"/>ጾስ ቲና ጽልዝታይ ህገ ናግዝታይፕ አትን ህገ ስስ ኣዳ ስእዝታ ባያ። <verse eid="ROM 2:13"/><verse number="14" style="v" sid="ROM 2:14"/>ህገ ባ አይሁደ ባ አሳይ መር ህገ ኪትዛ ኦዛ። ኡንትስ ህጋይ ባ እጽኮካ ኡንቲ ፋ ዎዝናር ህገ ኤርዛ። <verse eid="ROM 2:14"/><verse number="15" style="v" sid="ROM 2:15"/>ኡ ሀኖታይ፥ ህገ ኪታይ ኡ ዎዝናይድ ጻፍንቴዛና ቤዝዛ። ማ ኡ ካሃይ ኡንታል አፋ ማርካትዛ። ኡ ቆፋይ ፐቲ ፐቲ ቶኬ ኡንታል ቡታ ግ ሞትዛ፤ ፐቲ ፐቲ ቶኬ ኡንታን ሉለ ግዛ። <verse eid="ROM 2:15"/><verse number="16" style="v" sid="ROM 2:16"/>ታ ታማርሴዝ ዎንግለ ጋርክ ጾሳይ የሱሳ ክርስቶሳ ባጋር አስ ዎዝና ጋንጨ ቆስንቴዝ ቆፋ ፕርድዛ ዎደ የይ ኤርንቶዳ።<verse eid="ROM 2:16"/></para>
  <para style="s1">አይሁድታኔ ኡ ህገ</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 2:17"/>ዝን ነ ነና አይሁደ ግዛ፤ ህገል ካትዛ፤ ጾሳር የዝ የሳይድ ነ ጋይርዛ። <verse eid="ROM 2:17"/><verse number="18" style="v" sid="ROM 2:18"/>ነ ኦድ ጋርክ ጾሲ ኮይዝ ባዝ አብዛኮ ኤርዛ። ህገ ታማሬዝ ግሾስ ቱማ ማቅዝባዝ ሻጊ ኤርዛ። <verse eid="ROM 2:18"/><verse number="19" style="v" sid="ROM 2:19"/>ኔኒ ቶእታ ካልዛ፥ ማ ማ የዝታይስ ፖኦ ማቅዛና ሻኪ ኤርዛ። <verse eid="ROM 2:19"/><verse number="20" style="v" sid="ROM 2:20"/>ኔኒ ህጋይፕ ደንጌዝ ኤረትይራኔ ቱማትይር ቦዝታ ኤርስዛኔ ዱድታ ታማርስዛ ማቅዛና ኤርዛ። <verse eid="ROM 2:20"/><verse number="21" style="v" sid="ROM 2:21"/>የዝን፥ ነ ሀራ አስ ታማርስዛይ ነ ነና አብስ ታማርሶሳ? ኔኒ፥ «ካስትፐ» ግ ሳባክታር፥ ኔኒ ነ ኡባስ ካስትኔ? <verse eid="ROM 2:21"/><verse number="22" style="v" sid="ROM 2:22"/>ኔኒ፥ «ላምፐ» ጊታር፥ ኔኒ ነ ኡባስ ላምኔ? ኔኒ ኤቃ እጽታር፥ ኤቃር የዝ ካራ ቦንቂኔ? <verse eid="ROM 2:22"/><verse number="23" style="v" sid="ROM 2:23"/>ኔኒ ጾስ ህጋይድ ጬቅንትዛ፥ ዝን ህጋይስ ኪትንታም እጺ ጾሳ ዬላኔ? <verse eid="ROM 2:23"/><verse number="24" style="v" sid="ROM 2:24"/>ጌሻ ማጻፋይድ፥ «ይ ሳንከር ጾሳ ሱንይ አይሁደ ባ አሳይር ጫዥንትዛ» ግንትንቲ ጻፍንቴዛ።<note caller="-" style="x"><char style="xo" closed="false">2:24</char><char style="xt" closed="false"><ref loc="ISA 59:7-8">ኢሳ. 59:7-8</ref></char></note><verse eid="ROM 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 2:25"/>ነ ህገስ ኪትንትኮ፥ ነ ዶካልንታይ አድዛ፥ ዝን ኔኒ ህገስ ኪትንታም እጽኮ ነ ዶኮልንተካዛይ ጋርክ ማቅዛ። <verse eid="ROM 2:25"/><verse number="26" style="v" sid="ROM 2:26"/>አይሁደ ማቀካ አስ ዶካልንተካ የዛር፥ ህገስ ኪትንትኮ፥ ጾሳይ ኤዛ ዶካልንቴዝ ጋርክ ፓይዶሳ? <verse eid="ROM 2:26"/><verse number="27" style="v" sid="ROM 2:27"/>ይ፥ አይሁደ አሳይ፥ ይንትስ ጻፍንቴዝ ህጋይኔ ዶኮልንቲ የዝን፥ ይ ህገስ ኪትንታም እጽኮ፥ አይሁደ ባ አሳይ ዶካልንታም እጽኮካ ህገስ ኪትንቲ፥ ይንታል አፋ ፕርዶዳ።<verse eid="ROM 2:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 2:28"/>ይኬ፥ ሱንር አይሁደ ማቄዝ ኡቢታይ ቱማ አይሁደ ባያ። በንትዝ አሾ ዶካልንታይ ቱማ ዶኮልንቶ ባያ። <verse eid="ROM 2:28"/><verse number="29" style="v" sid="ROM 2:29"/>ዝን ቱማ አይሁደት ጋንጨ ባጋር አይሁደ ማቅዛ። ቱማ ዶካልንታይ ጾስ አያናር ሀንዝ ዎዝና ዶካልንቶፕ አትን ጻፍንቴዝ ህጋይድ ሀንዝ ጋላ ጋቾ ባያ። የ አይ ጋላታ ጾሳፕ ኤክዛፕ አትን አሳፕ ባያ።<note caller="-" style="x"><char style="xo" closed="false">2:29 </char><char style="xt" closed="false"><ref loc="DEU 30:6">ናምእ. 30:6</ref></char></note><verse eid="ROM 2:29"/></para>
  <chapter eid="ROM 2"/>
  <chapter number="3" style="c" sid="ROM 3"/>
  <para style="s1">አይሁድታይ አማኖ እጾ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 3:1"/>የዝን፥ አይሁደት አብስ ማዴ? ዎይ ዶካልንቶስ አባ ማዴ የኔ? <verse eid="ROM 3:1"/><verse number="2" style="v" sid="ROM 3:2"/>ቱማ አይሁደ ማቅይ ጋመ ኦገር ማድዛ። ኡባፕ ቲን ጾሳይ ፋ ቃላ ሀዳራ አይሁድታይስ እንጌዛ።<verse eid="ROM 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 3:3"/>የዝን፥ ኡንታፕ ፐታይ ፐታይ ቃላ አማናም እጽኮ፥ ኡ እጻይ ጾስ ጌሸት ካይነኔ? <verse eid="ROM 3:3"/><verse number="4" style="v" sid="ROM 3:4"/>ካዮያ! አስ ኡባይ ዎርዶ ማቅኮካ ጾሳይ ቱማ ማቆ። ጌሻ ማጻፋይድ፥</para>
  <para style="q1" vid="ROM 3:4">«ነቃላይር ነ ጽሎዳ፤</para>
  <para style="q2" vid="ROM 3:4">ነና ሞትዛና ፕርዳር ላዳ»</para>
  <para style="m" vid="ROM 3:4">ግንትንቲ ጻፍንቴዛ።<note caller="-" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="PSA 51:4">ማዝ. 51:4</ref></char></note><verse eid="ROM 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 3:5"/>የዝን፥ ኑ ዎርዣይ ጾሳይ ጌሻ ማቅዛና ቤዝዛ ባዝ ማቅኮ፥ ኑ ዋጎዴ? ጾሳይ ኑ ናጋራ ግሾስ ኑል አፋ ፕርድኮ፥ ሉሎ ባሳኔ? Ꮊያ ታኒ አስ ቆፋ ጋርክ ግዛ። <verse eid="ROM 3:5"/><verse number="6" style="v" sid="ROM 3:6"/>የያ ባያ። የይ ጋርክ ሀንኮ፥ ጾሲ Ꮊ አላማይል አፋ ዋይዚ ፕርዶደ?<verse eid="ROM 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 3:7"/>ዝን ታ ዎርዶትይ ጾስ ቱማ ቆንጭሲ፥ ኤ ቦንቻ ዳምሲ ቤዝዛ ባዝ ማቅኮ፥ የዝን፥ አብስ ታል አፋ ናጋራንቾ ጋርክ ፕርድኔ? <verse eid="ROM 3:7"/><verse number="8" style="v" sid="ROM 3:8"/>ፐቲ ፐቲ አሳይ፥ «ሎኦ ባዝ የኦድ ጋርክ ኢታ ኦዛ» ዬጊ ታማርስዛይ ጋርክ ኡዲ ታና ሞትዛ። የይ ጋርክ አሳል ይእዛ ጾስ ፕርዳይ ቤዝዛያ።<verse eid="ROM 3:8"/></para>
  <para style="s1">ጽሎ ፐታካ ባያ</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 3:9"/>የዝን፥ ኑኒ ዋጎዴ? ኑ ኣኔ? የያ ባያ! አይሁደ ማቅን፥ ግርኬ ማቅን ኡቢታይ ናጋራ ኦሞ የዛና ታኒ ቲናቲ ይንትስ ኦዴዛ።<verse eid="ROM 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 3:10"/>ጌሻ ማጻፋይድ፥</para>
  <para style="q1" vid="ROM 3:10">«ጽሎ አስ ፐታካ ባያ።<note caller="-" style="x"><char style="xo" closed="false">3:10-12 </char><char style="xt" closed="false"><ref loc="PSA 14:1-3">ማዝ. 14:1-3</ref>፤ <ref loc="PSA 53:1-3">53:1-3</ref></char></note><verse eid="ROM 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ROM 3:11"/>አካክዛ አስ ባያ፥</para>
  <para style="q2" vid="ROM 3:11">ጾስ ኮይዝ ኦንካ ባያ።<verse eid="ROM 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ROM 3:12"/>ኡቢታይ ባልንቴዛ ፐትፐ አዶዝታ ማቄዛ ሃዮት ኦዛይ ባያ።</para>
  <para style="q2" vid="ROM 3:12">ፐቲ አስካ ባያ።<verse eid="ROM 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ROM 3:13"/>ኡ ዶናይ ዶይንቴዝ ዱፎ፥</para>
  <para style="q2" vid="ROM 3:13">ፋ እራንይር ዶሽዛ።</para>
  <para style="q1" vid="ROM 3:13">ኡ ዶናይፕ፥</para>
  <para style="q2" vid="ROM 3:13">ሾሺ ማርዘ ከዝዛ።<note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="PSA 5:9">ማዝ. 5:9</ref>፤ <ref loc="PSA 140:3">140:3</ref></char></note><verse eid="ROM 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ROM 3:14"/>ኡ ዶናይድ ጫሞ ኦዳኔ ባድ ኩሜዛ።<note caller="-" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="PSA 10:7">ማዝ. 10:7</ref></char></note><verse eid="ROM 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ROM 3:15"/>ኡ ቶካይ ሱ ላሎዳይስ ኤልስዛ።<note caller="-" style="x"><char style="xo" closed="false">3:15-17 </char><char style="xt" closed="false"><ref loc="ISA 59:7-8">ኢሳ. 59:7-8</ref></char></note><verse eid="ROM 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ROM 3:16"/>ኡ ኦጋይድ ቦኔ ዳቡርስ የዛ።<verse eid="ROM 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ROM 3:17"/>ኡንቲ ሳሮት ኦገ ኤሮያ።<verse eid="ROM 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ROM 3:18"/>ፋ የሳይድ ጾስስ ያሽቶያ»</para>
  <para style="m" vid="ROM 3:18">ግንትንቲ ጻፍንቴዛ።<note caller="-" style="x"><char style="xo" closed="false">3:18 </char><char style="xt" closed="false"><ref loc="PSA 36:1">ማዝ. 36:1</ref></char></note><verse eid="ROM 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 3:19"/>አስ ኡባ ዶና አይዳይስኔ አላማ ሙመር ጾስ ፕርደፕ ኦሞር ሺሾዳይስ፥ ህገ እንግንቴዛይ ህገፕ ኦሞ አቅዝታይስ ማቄዛና ኑ ኤርዛ። <verse eid="ROM 3:19"/><verse number="20" style="v" sid="ROM 3:20"/>የይ ግሾስ፥ ኦንካ ህገስ ኪትንቲ ጾስ ቲና ጽሎዳይስ ዳንዳኦያ። ህገ አስ ኡቢታይ ናጋራንቾ ማቄዛና ቤዝዛ።<note caller="-" style="x"><char style="xo" closed="false">3:20 </char><char style="xt" closed="false"><ref loc="PSA 143:2">ማዝ. 143:2</ref>፤ <ref loc="GAL 2:16">ጋላ. 2:16</ref></char></note><verse eid="ROM 3:20"/></para>
  <para style="s1">ጽሎት አማኖራ</para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 3:21"/>ዝን Ꮊት ህገኔ ናብታይ ማርካቴዝ ጾስ ጽሎትይ ህገ ባዝን ቆንጬዛ። <verse eid="ROM 3:21"/><verse number="22" style="v" sid="ROM 3:22"/>Ꮊ ጽሎት፥ ጾስ የሱስ ክርስቶሳ አማኖ ባጋር አስ ኡባስ ሻኮ ባዝን እንግዛ።<verse eid="ROM 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 3:23"/>አሲ ኡባይ ናጋራ ኦዛ፤ ጾሲ ኡንትስ እንጌዝ ቦንቻይፕ ፋጨዛ። <verse eid="ROM 3:23"/><verse number="24" style="v" sid="ROM 3:24"/>ዝን ኡንቲ ጾስ ኣ ኬሃትር፥ ዎዝዛ ክርስቶስ የሱሳ ባጋር ጨር ጽሌዛ። <verse eid="ROM 3:24"/><verse number="25" style="v" sid="ROM 3:25"/>ጾሳ የሱስ ክርስቶሳ ያርሾ ኡዲ እንጌዛይ፥ ኤዛ አማንዛ ኡቢታይ ኤ ሱይር ናጋራ ማሮት ደማድ ጋርከ። ጾሳይ የያ ኦዛይ ፋ ዳንዳአይር ቲን ናጋራ ታይበካ አሺ፥ ፋ ጽሎት ቤዞዳይስ። <verse eid="ROM 3:25"/><verse number="26" style="v" sid="ROM 3:26"/>Ꮊ ዎዳይድ የሱሳ አማንዛ ኡባ ጽልሶር፥ ጾሳይ ፋ ኡባስ ጽሎ ማቄዛና ቤዝዛ።<verse eid="ROM 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 3:27"/>የዝን፥ ኑ ጬቅንታይ አባ የኔ? የይካ አቴዛ። ኑኒ ጬቅንትዛይ ህገስ ኪትንትዛ ግሾኔ? ዋኣ! አማኖ ህገራፕ አትን። <verse eid="ROM 3:27"/><verse number="28" style="v" sid="ROM 3:28"/>ጾሲ አስ ጽልስዛይ አማኖራፕ አትን ህገ ናጎር ባዛና ኑ ኤርዛ።<verse eid="ROM 3:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ROM 3:29"/>ዎይ ጾሳይ አይሁድታይስ ኣዳ ጾሶኔ? አይሁደ ባዝታይስ ጾስ ባሳኔ? ቱማ፥ አይሁደ ባዝታይስካ ኤ ጾሰ። <verse eid="ROM 3:29"/><verse number="30" style="v" sid="ROM 3:30"/>ጾሲ ፐቶ፤ አይሁድታኔ አይሁደ ባዝታይስካ አማኖር ጽልስዛይ ኤዛ።<note caller="-" style="x"><char style="xo" closed="false">3:30 </char><char style="xt" closed="false"><ref loc="DEU 6:4">ናምእ. 6:4</ref>፤ <ref loc="GAL 3:20">ጋላ. 3:20</ref></char></note> <verse eid="ROM 3:30"/><verse number="31" style="v" sid="ROM 3:31"/>የዝን፥ ኑኒ ህገ አማኖ ግሾስ ሻሮዳ ጉሶኔ? የያ ባያ! ህገ ምንዳይፕ አትን።<verse eid="ROM 3:31"/></para>
  <chapter eid="ROM 3"/>
  <chapter number="4" style="c" sid="ROM 4"/>
  <para style="s1">አፍራመ አማኖር ጽሌዛ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 4:1"/>የዝን፥ ኑ አሾ አደ አፍራመ አብ ደንጌኔ? <verse eid="ROM 4:1"/><verse number="2" style="v" sid="ROM 4:2"/>አፍራመ ኦሶር ጽሌዝባዝ ማቄዛኮ፥ ኤ ጬቅንትዛባዝ የዛ፥ ማቆዝን፥ ጾስ ቲና ጬቅንቶዳይስ ዳንዳኦያ። <verse eid="ROM 4:2"/><verse number="3" style="v" sid="ROM 4:3"/>ጌሻ ማጻፋይ፥ «አፍራመ ጾሳ አማኔዛ፤ ጾሳይ የያ ኤዝስ ጽሎት ኡዲ ኤኬዛ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="GEN 15:6">መ. 15:6</ref>፤ <ref loc="GAL 3:6">ጋላ. 3:6</ref></char></note><verse eid="ROM 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ROM 4:4"/>ኦዛ አይ ኤክዛ ዳሞዛይ፥ ኤ ኦሶ ዎልቃስ ጭግንትዛ አጮፕ አትን ኤዝስ እሞታ ባያ። <verse eid="ROM 4:4"/><verse number="5" style="v" sid="ROM 4:5"/>ዝን ኦሶ ኦዋ ኦንካ ናጋራንቻና ጽልስዛ ጾሳ አማንኮ፥ ኤ አማናይ ኤዝስ ጽሎት ማቂ ፓይድንትዛ። <verse eid="ROM 4:5"/><verse number="6" style="v" sid="ROM 4:6"/>ጌሻ ማጻፋይድ ዳዉተ፥ ኦሶ ባዝን ጾሲ ጽልስዛ አይ አብ ጋርክ አንጅንቴዛኮ Ꮊይ ጋርክ ዬጊ ቆንጭሲ ቤዝዛ፦<verse eid="ROM 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ROM 4:7"/>«ኡ ቡታይ አቶ ግንትንትዝታይኔ</para>
  <para style="q2" vid="ROM 4:7">ኡ ናጋራይ ኡጭንቴዝታይ አንጅንቴዝታ።<note caller="-" style="x"><char style="xo" closed="false">4:7-8 </char><char style="xt" closed="false"><ref loc="PSA 32:1-2">ማዝ. 32:1-2</ref></char></note><verse eid="ROM 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ROM 4:8"/>ጎዳይ ኤ ናጋራ ፓይደካ አሲ አንጅንቴዛያ»</para>
  <para style="m" vid="ROM 4:8">ዬጌዛ።<verse eid="ROM 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 4:9"/>የዝን፥ ዳዉተ ኦዴዝ አንጆ ዶካልንቴዝ አስ ኣዳሶኔ? ዎይ ዶካልንተካ አስሶ? ኑኒ፥ «ጌሻ ማጻፋይ፥ አፍራመ ጾሳ አማኔዛ፤ ጾሳይ የያ ኤዝስ ጽሎት ኡዲ ኤኬዛ ዬጌዛ»። <verse eid="ROM 4:9"/><verse number="10" style="v" sid="ROM 4:10"/>የዝን፥ የይ አይደ ሀኔ? አፍራመ ዶካልንትነኔ? ዎይ ዶካልንተካ የዝን? ዶካልንቶዳይፕ ቲን ሀኔዛፕ አትን ጉየ ባያ።<verse eid="ROM 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 4:11"/>አፍራመ ዶካልንቶዳይፕ ቲና ኤ አማናይ ኤዝስ ጽሎት ማታመ ማቂ ፓይድንቴዛና ኤርሶዳይስ፥ ኤ ዶካሎስ ማላ ማቄዛ። የይ ግሾስ፥ አፍራመ ዶካልንተካ አማንዝታይስኔ አማኖር ጽልዝታይስ ኡቢታይስ አደ ማቄዛ።<note caller="-" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="GEN 17:10">መ. 17:10</ref></char></note> <verse eid="ROM 4:11"/><verse number="12" style="v" sid="ROM 4:12"/>ኤ ዶካልንቴዝታይስካ አደ። አፍራመ ኡንትስ አደ ማቄዛይ ኡንቲ ዶካልንቴዝ ግሾስ ኣዳ ባዝን ኤ ዶካልንቶዳይፕ ቲን አማኔዝ አማና ኡንቲ ካሌዝ ግሾስ።<verse eid="ROM 4:12"/></para>
  <para style="s1">ጾስ ኡፋይሳይ አማኖር ኤክንትዛ</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 4:13"/>አፍራመስኔ ኤ ሼሻይስ፥ «አላመ ታ ይንትስ እማድ» ዬጌዝ ኡፋይሳይ፥ አፍራመ አማኖር ጽሌዝ ግሾስፕ አትን ህገ ናጊ ፖሌዝ ግሾስ ባያ።<note caller="-" style="x"><char style="xo" closed="false">4:13 </char><char style="xt" closed="false"><ref loc="GEN 17:4-6">መ. 17:4-6</ref>፤ <ref loc="GEN 22:17-18">22:17-18</ref>፤ <ref loc="GAL 3:29">ጋላ. 3:29</ref></char></note> <verse eid="ROM 4:13"/><verse number="14" style="v" sid="ROM 4:14"/>ህገስ ኪትንቴዝታይ ጾሳይ እማድ ጌዝ ኡፋይሳ ኤክዝታ ማቅኮ፥ አስ አማኖ ጨረ፤ ጾስ ኡፋይሳይካ ሻርንቴዛ።<note caller="-" style="x"><char style="xo" closed="false">4:14 </char><char style="xt" closed="false"><ref loc="GAL 3:18">ጋላ. 3:18</ref></char></note> <verse eid="ROM 4:14"/><verse number="15" style="v" sid="ROM 4:15"/>ህገ መን ጾስ ካች ክእዛ፥ ዝን ህገ ባ አቆ ህገ መንካ ባያ።<verse eid="ROM 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 4:16"/>የይ ግሾስ፥ ጾሲ እንጌዝ ኡፋይሳይ አማኖር ኤክንትዛ። Ꮊ ኡፋይሳይ አፍራመ ሼሽ ኡባስ ጾስ ኣ ኬሄት ባጋር እንግንቴዛና ቤዝዛ። የይካ ህገ ናግዝታይ ኣዳስ ባዝን አፍራመ ጋርክ አማኔዝ ኡቢታይስ። አፍራመ ኑ ኡባይስ አደ።<note caller="-" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="GAL 3:7">ጋላ. 3:7</ref></char></note> <verse eid="ROM 4:16"/><verse number="17" style="v" sid="ROM 4:17"/>ጌሻ ማጻፋይድ፥ «ታ ነና ጋመ ዎይታይስ አደ ማሄዛ» ግንትንቲ አፍራመ ግሾስ ጻፍንቴዛ። Ꮊ ኡፋይሳይ አፍራመስ እንግንቴዛይ Ꮊይቄዝታይስ ደኦ እንግዛይኔ ኦሮባዝ ኦዛ ጾሳይ ኤዛ ማቅዛና ኤ አማኔዝ ግሾስ።<note caller="-" style="x"><char style="xo" closed="false">4:17 </char><char style="xt" closed="false"><ref loc="GEN 17:5">መ. 17:5</ref></char></note><verse eid="ROM 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 4:18"/>ጾሳይ አፍራመስ ጋመ ዘር እማዳና ጫቄዛ። ኡፋይስ ኦዳይስ አብካ ዳንዳእንቶዋ ዎደ አፍራመ ጾሳ አማኔዝ ግሾኔ ኡፋይስ ኦዝ ግሾስ ጋመ ዎይታይስ አደ ማቄዛ።<note caller="-" style="x"><char style="xo" closed="false">4:18 </char><char style="xt" closed="false"><ref loc="GEN 15:5">መ. 15:5</ref></char></note> <verse eid="ROM 4:18"/><verse number="19" style="v" sid="ROM 4:19"/>አፍራመስ ጼት ላይ ኩሞድ ሀንኮካ፥ ዳቡሬዝ ራትኔ ሳራ ናአ የሎዳይስ ዳንዳኦዛ ኤርታር ፋ አማናይር ዳቡረካያ።<note caller="-" style="x"><char style="xo" closed="false">4:19 </char><char style="xt" closed="false"><ref loc="GEN 17:17">መ. 17:17</ref></char></note><verse eid="ROM 4:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 4:20"/>ማቆዝን፥ ኤ ፋ አማናይር ሚንጊ ጾሳይስ ቦንቾ እንጌዛፕ አትን ጾሳይ እንጌዝ ኡፋይሳ አማናም እጺ፥ ስካያ። <verse eid="ROM 4:20"/><verse number="21" style="v" sid="ROM 4:21"/>አፍራመ፥ ጾሳይ ጫቄዝ ጫቃ ፖሎዳና ፋ ኩን ዎዝናር አማኔዛ። <verse eid="ROM 4:21"/><verse number="22" style="v" sid="ROM 4:22"/>የይ ግሾስ፥ ጾሲ ኤ አማና ጽሎት ኡዲ ፓይዴዛ።<verse eid="ROM 4:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 4:23"/>ዝን፥ «ኤዝስ ጽሎት ታይቤዛ» ግዝ ቃላይ አፍራመ ኣዳስ ጻፍንተካያ። <verse eid="ROM 4:23"/><verse number="24" style="v" sid="ROM 4:24"/>የ ቃላይ ኑ የሱሳ Ꮊይቆፕ ደንዝ ጾሳ አማንዛ ኑስካ ኑ አማኖ ጽሎትር ታይብንቶዳይ ጋርክ ጻፍንቴዛይ <verse eid="ROM 4:24"/><verse number="25" style="v" sid="ROM 4:25"/>ኑ ናጋራ ግሾስ Ꮊይቆስ አ እንጌዛ፤ ኤ ኑና ጽልሶዳይስ Ꮊይቆፕ ደንዴዛ።<note caller="-" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="ISA 53:4-5">ኢሳ. 53:4-5</ref></char></note><verse eid="ROM 4:25"/></para>
  <chapter eid="ROM 4"/>
  <chapter number="5" style="c" sid="ROM 5"/>
  <para style="s1">ጾሳር የዝ ሳሮት</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 5:1"/>ይኬ፥ ኑ አማኖር ጽሌዝ ግሾስ ኑ ጎዳ የሱስ ክርስቶሳ ባጋር ጾስ ባጋር ኑስ ሳሮት አይኮዳ። <verse eid="ROM 5:1"/><verse number="2" style="v" sid="ROM 5:2"/>ኑኒ ኤ ባጋር Ꮊት ኑ ኤቄዝ ኣ ኬሄትይ ጋንጨ አማኖር ገሌዛ። የይ ግሾስ፥ ኑ ጾሳይ ቦንቻ ሻክንቶዳይስ የዝ ኡፋይሳይር ጬቅንትዛ።<verse eid="ROM 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 5:3"/>የይ ኣዳ ባዝን መቶ ዳንዳአ ክእዛና ኑ ኤርዛ ግሾስ ኑ መቶ ጋንጨራካ ጬቅንትዛ። <verse eid="ROM 5:3"/><verse number="4" style="v" sid="ROM 5:4"/>ዳንዳአ ፋጨ ጋንጨ ጋርዦ ጋርዦካ ኡፋይስ እንግዛና ኑ ኤርዛ። <verse eid="ROM 5:4"/><verse number="5" style="v" sid="ROM 5:5"/>ጌሻ አያናይ ባጋር ጾሳይ ፋ ቃ ኑ ዎዝና ጋንጨ ጋዴዝ ግሾስ የ ኡፋይሳይ ኑና ዬላያ።<verse eid="ROM 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 5:6"/>ኑኒ ሀጋ ዳቡሬዝታ ማቂ የዝን፥ ጾስ ዎደ ሄልን፥ ክርስቶሳ ናጋራ ኦዝታይ ግሾስ Ꮊይቄዛ። <verse eid="ROM 5:6"/><verse number="7" style="v" sid="ROM 5:7"/>ጌሽ አስ ግሾስ Ꮊይቆድ አስ ዋዪ ደማዳ፥ ዝን ኬሃ አስ ግሾስ Ꮊይቆድ አስ ኦኒ ኤሬ በንተካ አታሚ። <verse eid="ROM 5:7"/><verse number="8" style="v" sid="ROM 5:8"/>ዝን ኑኒ ሀጋ ናጋራንቾ ማቂ የዝን፥ ክርስቶሳ ኑ ግሾስ Ꮊይቄዛ። ጾሳይ ኑና አብ ጋርክ ቃዛኮ ኤ ቃ ቤዝዛ። <verse eid="ROM 5:8"/><verse number="9" style="v" sid="ROM 5:9"/>ይኬ፥ ኑኒ ክርስቶሳ ሱይር ጽሌዝባዝ ማቅኮ፥ ኡባይፕ ኣ ኤ ባጋር ጾስ ሴራይፕ አቶዳ። <verse eid="ROM 5:9"/><verse number="10" style="v" sid="ROM 5:10"/>ኑኒ ቲና ጾሳር ሞርክታ፥ ዝን ኤ ናአይ Ꮊይቆ ባጋር ኤዛር እግንቴዛ። የይፕ ኣ፥ Ꮊት ኑኒ ጾሳር ዳቦቴዝ ኤ ናአይ ደኦ ባጋር ኑኒ አቶዳ። <verse eid="ROM 5:10"/><verse number="11" style="v" sid="ROM 5:11"/>የይ ኣዳ ባዝን Ꮊት ኑና ጾሳር ዳቦዝ ኑ ጎዳ የሱስ ክርስቶሳ ባጋር ኑ ጾሳር ጬቅንትዛ።<verse eid="ROM 5:11"/></para>
  <para style="s1">አዳማኔ ክርስቶሳ</para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 5:12"/>ዝን ፐቲ አይ ባጋር ናጋራ Ꮊ አላማ ገሌዛ። የ ናጋራይ ባጋር Ꮊይቆ የኤዛ። አሲ ኡቢታይ ናጋራ ኦዝ ግሾስ Ꮊይቆ አስ ኮች ኡባ ሄሌዛ።<note caller="-" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="GEN 3:6">መ. 3:6</ref></char></note> <verse eid="ROM 5:12"/><verse number="13" style="v" sid="ROM 5:13"/>ህገ እንግንቶዳይፕ ቲና አላመል ናጋራ የዛ፥ ዝን ህገ ባ ዎደ ናጋራ ናጋራ ማቂ ፓይድንተካያ። <verse eid="ROM 5:13"/><verse number="14" style="v" sid="ROM 5:14"/>ዝን አዳመፐ ሙሰ ሄሎዳይስ Ꮊይቆ አስ ኡባ ሞዴዛ። ሀራ አቶዝን፥ አዳማ ጋርክ ህገስ ኪትንታም እጺ፥ ናጋራ ኦካዝታይስ ጉጅካ Ꮊይቆ ካዉቴዛ።</para>
  <para style="p" vid="ROM 5:14">አዳማ የኦዳይስ የዛይስ ኣዝሶ። <verse eid="ROM 5:14"/><verse number="15" style="v" sid="ROM 5:15"/>ዝን ጾስ ኣ ኬሃትይ ፐቲ አይ ናጋራይ ጋርክ ባያ። ፐቲ አስ ናጋራ ባጋር ጋመ አሳይ Ꮊይቄዛ። ዝን የሱስ ክርስቶሳ ባጋር ጾስ ኣ ኬሄትይ ጋምታይስ ኣ ጋንጊ እንግንቴዛ። <verse eid="ROM 5:15"/><verse number="16" style="v" sid="ROM 5:16"/>ፐቲ አይ ናጋራይ ጋንጨኔ ጾስ እሞታይ ጋንጨ ጋመ ዱማት የዛ። ፐቲ አስ ናጋራ ባጋር ጾሲ ፕርዳ ከኤዛ። ዝን አሳይ ጋመ ናጋራ ኦኮካ ጾስ ኣ ኬሄትይ ጽሎት ከኤዛ። <verse eid="ROM 5:16"/><verse number="17" style="v" sid="ROM 5:17"/>ፐቲ አሳይ ናጋራ ባጋር Ꮊይቆ ካዉቴዛ። ዝን የሱስ ክርስቶሳ ባጋር ፑጬዝ ጾስ ኣ ኬሄትኔ ጽሎት እሞታ ኤክዛ ኡባይ፥ ጋሚ ደኦር የዞዳ።<verse eid="ROM 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 5:18"/>ይኬ፥ ፐቲ አሲ ናጋራ ኦዝ ባጋር አስ ኡባይል አፋ ፕርዳ የኤዛይ ጋርክ ፐቲ አሲ ጽሎ ኦዝ ባጋር፥ ጾስ አስ ኡባ ጽልሲ ደኦ እንጌዛ። <verse eid="ROM 5:18"/><verse number="19" style="v" sid="ROM 5:19"/>ፐቲ አሲ ኪትንታም እጼዝ ባጋር፥ ጋመ አሳይ ናጋራንቾ ማቄዛይ ጋርክ ፐቲ አስ ኪትንትር ጋመ አሳይ ጽሎ ማቆዳ።<verse eid="ROM 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 5:20"/>አሳይ ናጋራ ዎልቃ ኤሮድ ጋርክ ህገ የኤዛ፥ ዝን ናጋራ ዎልቃይ ጋንጌዝ ዎደ ጾስ ኣ ኬሄትይ ኣ ጋንጌዛ። <verse eid="ROM 5:20"/><verse number="21" style="v" sid="ROM 5:21"/>ናጋራ Ꮊይቆ ዎልቃር ካዉቴዛይ ጋርክ ጾስ ኣ ኬሄትይ ጽሎት ዎልቃር ካዉቲ፥ ኑ ጎዳ የሱስ ክርስቶሳ ባጋር ኑና መናስ ደኦኮ ካልዛ።<verse eid="ROM 5:21"/></para>
  <chapter eid="ROM 5"/>
  <chapter number="6" style="c" sid="ROM 6"/>
  <para style="s1">ናጋራስ Ꮊይቂ ክርስቶሳር የስ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 6:1"/>የዝን፥ ኑኒ ዋጎዴ? ጾስ ኣ ኬሄትይ ጋጎዳይ ጋርክ ናጋራራ ሚንጊ ዎላ የዞደነ? <verse eid="ROM 6:1"/><verse number="2" style="v" sid="ROM 6:2"/>ዋኣ፥ ኑኒ ናጋራስ Ꮊይቄዝባዝ ማቅኮ፥ የዝን፥ ኑኒ Ꮊይፕ ዋይዚ ናጋራራ የዞዴ? <verse eid="ROM 6:2"/><verse number="3" style="v" sid="ROM 6:3"/>ኑ ኡቢታይ የሱስ ክርስቶሳር ፐቶ ማቃዳይስ ጻማቅንቲ ኤ Ꮊይቃይድ ኤዛር ፐቶ ማቃዳይስ ጻማቅንቴዛና ኤሮሳ? <verse eid="ROM 6:3"/><verse number="4" style="v" sid="ROM 6:4"/>ኑ ጻማቅንቴዝ ዎደ ክርስቶሳር Ꮊይቂ ሞግንቴዛ። ክርስቶሳ ጾስ አዳይ ቦንቾ ዎልቃር Ꮊይቆፕ ደንዴዛይ ጋርክ ኑካ ኦሮ የስ የዞዳ።<note caller="-" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="COL 2:12">ቆላ. 2:12</ref></char></note><verse eid="ROM 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 6:5"/>ኑ ኤ Ꮊይቃይድ ኤዛር ፐቶ ማቅኮ፥ የይ ጋርከካ፥ ኤ ደንዳይድ ኤዛር ዎላ ፐቶ ማቃዳ። <verse eid="ROM 6:5"/><verse number="6" style="v" sid="ROM 6:6"/>ኑ Ꮊይፕ ጉየ ናጋራስ አይለ ማቃም ጋርከኔ ኑ ናጋራንቾ አሾ ዎልቃይ ቦድ ጋርክ ኑ ጭማ አሰትይ ክርስቶሳር ሶትንቴዛና ኤርዛ። <verse eid="ROM 6:6"/><verse number="7" style="v" sid="ROM 6:7"/>ፐቲ አስ Ꮊይቅዝ ባዝ ማቅኮ፥ ኤ ናጋራ ዎልቃፕ ዎዝንቲ ከዝዛ። <verse eid="ROM 6:7"/><verse number="8" style="v" sid="ROM 6:8"/>ኑኒ ክርስቶሳር Ꮊይቅኮ፥ ኤዛር ደኦ የዞዳና አማንዛ። <verse eid="ROM 6:8"/><verse number="9" style="v" sid="ROM 6:9"/>ክርስቶሳ Ꮊይቆፕ ደንዴዝ ግሾስ ማቂ ኤ Ꮊይቃምዛኔ Ꮊይቆ ቲናፕ ኤዛ ሞዳምዛና ኑ ኤርዛ። <verse eid="ROM 6:9"/><verse number="10" style="v" sid="ROM 6:10"/>ኤ Ꮊይቄዝ ዎደ ፐቲ ቶኬ ዉርሲ Ꮊይቄዛ፥ ዝን Ꮊት ደኦ ጾስስ የዝዛ። <verse eid="ROM 6:10"/><verse number="11" style="v" sid="ROM 6:11"/>የይ ጋርከካ፥ ይ ናጋራስ Ꮊይቂ፥ ጎዳ የሱስ ክርስቶሳ ባጋር ጾስስ ደኦ የዛና ቆፖይታ።<verse eid="ROM 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 6:12"/>የይ ግሾስ፥ ይንቲ፥ ይ አሾ እናስ ኪትንታም ጋርክ Ꮊይቅዝ ይ አሻይል ናጋራ ካዉትፐ። <verse eid="ROM 6:12"/><verse number="13" style="v" sid="ROM 6:13"/>ማ ይ አባ አሰት ክፍለ ናጋራ ኦዳይስ ዎርዠ ሚሸ ኡዲ እንግፓተ። ዝን ይ Ꮊይቆፕ ደንዲ፥ ደኦ የዛ አስ ጋርክ ይ አሾ ጾስስ እንጎይታ። ማ ይ ኩን አሾ ጽሎ ኦሶ ሚሸ ኡዲ ጾስስ ኣ እንጎይታ። <verse eid="ROM 6:13"/><verse number="14" style="v" sid="ROM 6:14"/>ይ ጾስ ኣ ኬሄትይ ኦሞር የዛፕ አትን ህገፕ ኦሞር ባ ግሾስ ናጋራ ይንታን ሞዶዳይስ ቤዞያ።<verse eid="ROM 6:14"/></para>
  <para style="s1">ጽሎትስ አይለ ማቅ</para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 6:15"/>የዝን፥ ኑ ዋጎዴ? ህገፕ ኦሞር ባዝን ጾስ ኣ ኬሄትይ ኦሞር የዛ ግሾስ ናጋራ ዎላ ኦኔ? ዋኣ! <verse eid="ROM 6:15"/><verse number="16" style="v" sid="ROM 6:16"/>ይ ኪትንቶዳይስ ይንታን አይለ ኡዲ እንግዝ ዎደ የ ይ ኪትንትዛይስ አይለ ማቅዛና ይ ኤርዛ። የይ ጋርከካ፥ ይ ናጋራስ ኪትንትኮ፥ ይንትስ Ꮊይቆ ክእዝ ናጋራስ አይለ ማቅዛ። ዎይ ይ ጾስስ ኪትንትኮ ጽሎት ክእዝ ጾሳይስ አይለ ማቅዛ። <verse eid="ROM 6:16"/><verse number="17" style="v" sid="ROM 6:17"/>ካሰ ይ ናጋራስ አይለ፥ ዝን Ꮊት ይ ይንታን ኣ እንጌዝ ቱማ ትምርታይስ ኩን ዎዝናፕ ኪትንቴዝ ግሾስ ጾስስ ጋላታ ማቆ። <verse eid="ROM 6:17"/><verse number="18" style="v" sid="ROM 6:18"/>ይ ናጋራ አይለት አቻፕ ብልንቲ ጽሎትስ አይለ ማቅዛ።<verse eid="ROM 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 6:19"/>ይንቲ ይ ቆፋር ዳቡራ ማቄዝ ግሾስ ታኒ ኦስካ ገልዛ ኦገር ኦድዛ። ካሰ ይንቲ፥ ይ አሰት ክፍለ ኡባ ቱናኔ ኢታ ባዝ ኦዳይስ አይለ ኡዲ እንጌዛይ ጋርክ Ꮊት ይ አሰት ክፍለ ኡባ ጌሽ ማቃድ ጋርክ ጽሎት አይለ ኡዲ እንጎይታ።<verse eid="ROM 6:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 6:20"/>ይ ናጋራስ አይለቲ የዛ ዎደ ጽሎትስ ሃኮር የዛ። <verse eid="ROM 6:20"/><verse number="21" style="v" sid="ROM 6:21"/>ይንታን Ꮊት ዬላዛ ቢን ይ ኢታ ኦሳይፕ አባ ኣፈ ደንጌኔ? የይስ ዉርስይ Ꮊይቆ። <verse eid="ROM 6:21"/><verse number="22" style="v" sid="ROM 6:22"/>ዝን ይ ናጋራ አይለት አቻፕ ብልንት፥ ጾስስ አይለ ማቅዛ። የይ ይንታን ጽሎ ኣፈ አፍስዛ ኤ ዉርስይ መና ደኦ። <verse eid="ROM 6:22"/><verse number="23" style="v" sid="ROM 6:23"/>ናጋራስ ዳሞዛይ Ꮊይቆ። ዝን ጾሳይ፥ ኑ ጎዳ ክርስቶስ የሱሳ ባጋር እንግንትዛይ መና ደኦ።<verse eid="ROM 6:23"/></para>
  <chapter eid="ROM 6"/>
  <chapter number="7" style="c" sid="ROM 7"/>
  <para style="s1">ኤኮኔ ገሎ ኣዝሶ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 7:1"/>ታ እሹን፥ ታኒ ኦድዛይ ህገ ኤርዛ አሳይሲ። ህገ ፐቲ አሲ ፓ የዛ ዎደ ኡባይድ ኤዛ ሞድዛ። <verse eid="ROM 7:1"/><verse number="2" style="v" sid="ROM 7:2"/>ኣዝሶስ፥ አዝን ገሌዝ አስታ እ አዝናይ ፓ የዛ ዎደ ህገር ኤዛር አጭንቴዛ። ዝን እ አዝናይ Ꮊይቅኮ ኤዛር እዛ ጫቄዝ ጫቃይ እዞ ሞዶያ። <verse eid="ROM 7:2"/><verse number="3" style="v" sid="ROM 7:3"/>የይ ግሾስ፥ እዛ ፋ አዝናይ ፓ የዝን፥ ሀራ ራ ገልኮ፥ እዛ ላሜዛኖ ግንትትዛ። ዝን እ አዝናይ Ꮊይቅኮ፥ ጫቃይ እዞ ሞዶዋ ግሾስ እዛ ሀራ አዝን ገልኮ፥ እዛ ላሜዛኖ ጊንትንቶያ።<verse eid="ROM 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ROM 7:4"/>የይ ግሾስ፥ ታ እሹን፥ ይ ክርስቶሳ አሾ ባጋር ህገ ዎልቃስ Ꮊይቂ፥ ጾስስ ኣፈ ኣፎዳይስ Ꮊይቆፕ ደንዴዝ ክርስቶሳስ ማቅዛ። <verse eid="ROM 7:4"/><verse number="5" style="v" sid="ROM 7:5"/>ኑ አሾ አሞ ኑና ሞድን፥ ኑ የዝን ህገ ጉጂ ናጋራ ኦድ ጋርክ ኑና ደንዛ። ኑ አሾ ጋንጨ ኢታ አሞት የዛ ግሾስ ኑኒ Ꮊይቆ ኣፈ ኣፎድ ጋርክ ኦዛ። <verse eid="ROM 7:5"/><verse number="6" style="v" sid="ROM 7:6"/>ዝን Ꮊት ኑኒ ኑና አጬዝ ህጋይስ Ꮊይቄዝ ግሾስ ኑኒ ህገ አቻፕ ብልንቴዛ። የይ ግሾስ፥ ኦሮዛ አያና ኦገል ጾስስ ኪትንትዛፕ አትን ጻፍንቴዝ ጭማ ህገስ ኪትንታሚ።<verse eid="ROM 7:6"/></para>
  <para style="s1">ህገኔ ናጋራ</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 7:7"/>ዬዝን፥ ኑ ዋጎዴ? ህገ ናጋራኔ? የያ ባያ! ዝን ህገ ናጋራ አብዛኮ ታና ኤርሴዛ። ህገ፥ «አሞትፐ» ጎዛኮ፥ አሞት አብዛኮ ታ ኤራምዝኒ።<note caller="-" style="x"><char style="xo" closed="false">7:7 </char><char style="xt" closed="false"><ref loc="EXO 20:17">ከስ 20:17</ref>፤ <ref loc="DEU 5:21">ናምእ. 5:21</ref></char></note> <verse eid="ROM 7:7"/><verse number="8" style="v" sid="ROM 7:8"/>ዝን ታ ኡባ ባዝ አሞቶድ ጋርክ ናጋራ ህገ ባጋር ታል ኦገ ደንጌዛ። ህገ ባዛኮ ናጋራ Ꮊይቄዛ።<verse eid="ROM 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 7:9"/>ካሰ ህገ ባ ዎደ ታ ፓ፥ ዝን ህገ እንግንቴዝ ዎደ ናጋራ ፓጽን ታ ማ Ꮊይቄዛ። <verse eid="ROM 7:9"/><verse number="10" style="v" sid="ROM 7:10"/>ታኒ ደኦር የዞድ ጋርክ ጾሳይ እንጌዝ ህጋይ ታስ Ꮊይቆ ከኤዛ። <verse eid="ROM 7:10"/><verse number="11" style="v" sid="ROM 7:11"/>ናጋራ ህገ ባጋር ታና ዶሽዛ ኦገ ደንጊ፥ ዎዛ።<note caller="-" style="x"><char style="xo" closed="false">7:11 </char><char style="xt" closed="false"><ref loc="GEN 3:13">መ. 3:13</ref></char></note><verse eid="ROM 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 7:12"/>የይ ግሾስ፥ ህገ ጌሺ፤ ኤዛር ጻፍንቴዝ ኪታይካ ጌሺ፥ ጽሎኔ ሎኦ።<verse eid="ROM 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 7:13"/>የዝን፥ ሎኦ ማቄዝ ባዝ ታል አፋ Ꮊይቆ ከኤነኔ? አኣ! ዝን ናጋራ ናጋራ ማቅዛይ በንቶድ ጋርክ ሎኦ ባዛር ማድንቲ ታስ Ꮊይቆ ከኤዛ። የይ ግሾስ፥ ናጋራ ናጋራትይ ህገ ባጋር ኣ ኤርንቴዛ።<verse eid="ROM 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 7:14"/>ኑኒ ህገ አያና ባዝ ማቅዛና ኤርዛ። ዝን ታኒ ናጋራስ ባይዝንቴዝ አሾ ኣሲ። <verse eid="ROM 7:14"/><verse number="15" style="v" sid="ROM 7:15"/>ታኒ ኦዛባዝ አካኮያ፤ ታኒ ዶስዛባዝ ኦዳና አሺ ታ እጽዛባዝ ኦዛ።<note caller="-" style="x"><char style="xo" closed="false">7:15 </char><char style="xt" closed="false"><ref loc="GAL 5:17">ጋላ. 5:17</ref></char></note> <verse eid="ROM 7:15"/><verse number="16" style="v" sid="ROM 7:16"/>ታ እጽዛባዝ ኦዛባዝ ማቅኮ፥ ህገ ሎኦ ማቅዛና ታ ማእዛ። <verse eid="ROM 7:16"/><verse number="17" style="v" sid="ROM 7:17"/>የያ ማቅኮ፥ የ ኦሳ ታር የዛ ናጋራይ ኦዛፕ አትን ታ ኦያ።<verse eid="ROM 7:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 7:18"/>ታር፥ የይካ ታ አሾር ሎኦ ባዝ ባዛና ታ ኤርዛ። ሎኦ ባዝ ኦዛ አሞት ታር የዛ፥ ዝን ሎኦ ባዝ ኦዳይስ ዳንዳኦያ። <verse eid="ROM 7:18"/><verse number="19" style="v" sid="ROM 7:19"/>ታኒ እጽዛ ኢታ ባዝ ኦዛፕ አትን ታ ቃዛ ሎኦ ኦ ባያ። <verse eid="ROM 7:19"/><verse number="20" style="v" sid="ROM 7:20"/>ታኒ እጽዛባዝ ኦዛባዝ ማቅኮ፥ የያ ታር የዛ ናጋራይ ኦዛፕ አትን ኦዛይ ታና ባያ።<verse eid="ROM 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 7:21"/>ይኬ፥ ታ ሎኦ ባዝ ኦዳይስ ዶሶዳር፥ ኢታ ባዝ ኦሶ ህገ ማቅዛና ደንጌዛ። <verse eid="ROM 7:21"/><verse number="22" style="v" sid="ROM 7:22"/>ታኒ ታ ዎዝናር ጾስ ህጋይድ ኡፋይትዛ። <verse eid="ROM 7:22"/><verse number="23" style="v" sid="ROM 7:23"/>ዝን ታ አሾ ጋንጨ የዛ ታ ካሃ ህገር ኦልንትዛ ዱማ ህገ ብእዛ። የ ህጋይ ታ አሾ ጋንጨ ኦዛ ናጋራ ህገስ ታና ድኢ አይለ ኡዴዛ። <verse eid="ROM 7:23"/><verse number="24" style="v" sid="ROM 7:24"/>ታኒ ዋይዚ ሶንቄዝ አሶ? Ꮊይቆስ ካንግዝ Ꮊ አሳትይፕ ታና አሾዳይ ኦኖ? <verse eid="ROM 7:24"/><verse number="25" style="v" sid="ROM 7:25"/>ኑ ጎዳ የሱስ ክርስቶሳ ባጋር ጾስስ ጋላታ ማቆ።</para>
  <para style="p" vid="ROM 7:25">ይኬ፥ ታኒ ታ ቆፋር ጾስ ህገስ ሞድንቴዛ፤ ዝን ታ አሻይር ናጋራ ህገስ ሞድንቴዛ።<verse eid="ROM 7:25"/></para>
  <chapter eid="ROM 7"/>
  <chapter number="8" style="c" sid="ROM 8"/>
  <para style="s1">ጌሻ አያናር የስ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 8:1"/>የይ ግሾስ፥ ክርስቶስ የሱሳር የዝታይስ Ꮊት ፕርዳ ባያ። <verse eid="ROM 8:1"/><verse number="2" style="v" sid="ROM 8:2"/>ክርስቶስ የሱሳ ባጋር ኑስ ደኦ እንግዝ ጌሻ አያና ህጋይ፥ ታና ናጋራኔ Ꮊይቆ ህገ አይለትፕ ከሴዛ። <verse eid="ROM 8:2"/><verse number="3" style="v" sid="ROM 8:3"/>ኑ ናጋራ አሻይ ባጋር፥ ህጋይ ዳቡሬዝ ማቄዝ ግሾስ ኑና አሾዳይስ ዳንዳኤካያ። ጾሳይ ፋ ናአ ናጋራንቾ አስ ኣዝሶር ናጋራስ ያርሾ ማቃድ ጋርክ ኪቲ የያ ኦዛ። ዬዚ፥ ጾሳይ ክርስቶሳ አሻይ ባጋር ናጋራ፥ ናጋራንቾ አስ ጋንጨ ፕርዴዛ። <verse eid="ROM 8:3"/><verse number="4" style="v" sid="ROM 8:4"/>ጾሳይ የያ ኦዛይ፥ ኑ አሾ አሞ ኮይዛይ ጋርክ ባዝን ጌሻ አያናይ ኮይዛይ ጋርክ የዛ ኑል አፋ ህገ ጌሽ ኪታይ ፖልንቶድ ጋርከ።<verse eid="ROM 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 8:5"/>ፋ አሾ አሞ ጋርክ የዝታይ ፋና ኡፋይስዝ ባዝ ቆፕዛ። ዝን ጌሻ አያና ሸነ ጋርክ የዝታይ ጌሻ አያና ባዝ ቆፕዛ። <verse eid="ROM 8:5"/><verse number="6" style="v" sid="ROM 8:6"/>አሾ ቆፋይ Ꮊይቆ፥ ዝን አያና ባጋ ቆፖ ደኦኔ ሳሮት። <verse eid="ROM 8:6"/><verse number="7" style="v" sid="ROM 8:7"/>አሾ ባጋ ቆፋ ጾስ ካንታ ሞርከት ጾስ ህገስ ኪትንቶያ ኪትንቶዳይስ ዳንዳኦዋ። <verse eid="ROM 8:7"/><verse number="8" style="v" sid="ROM 8:8"/>ፋ አሾ አሞስ ሞድንትዝታይ ጾስ ኡፋይሶዳይስ ዳንዳኦያ።<verse eid="ROM 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 8:9"/>ዝን ጾስ አያናይ ይንታር የዝኮኔ ይንታን ሞድኮ፥ ይ አያና ሸነር የዛፕ አትን አሾ አሞስ ሞድንቴና። ክርስቶሳ አያናይ ባ ኦንካ ክርስቶሳ ባዝ ባያ። <verse eid="ROM 8:9"/><verse number="10" style="v" sid="ROM 8:10"/>ዝን ክርስቶሳ ይንታር የዝኮ፥ ይ አሻይ ናጋራ ባጋር Ꮊይቄዛ። ዝን ይ አያናይ ጽሎት ባጋር ደኦ የዛ። <verse eid="ROM 8:10"/><verse number="11" style="v" sid="ROM 8:11"/>ዝን የሱሳ Ꮊይቆፕ ደንዝ ጾስ አያናይ ይንታር የዝኮ፥ ክርስቶሳ Ꮊይቆፕ ደንዝ ጾሳይ፥ ይንታር የዝ ፋ ጌሻ አያናይር Ꮊይቅዝ ይ አሻይስ ደኦ እማዳ።<note caller="-" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="1CO 3:16">1ቆሮ. 3:16</ref></char></note><verse eid="ROM 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 8:12"/>ይኬ፥ ታ እሹን፥ ኑል አጮ የዛ ኑ አሾ ሸነስ የዞዳይስ ኑ አሾስ ባያ። <verse eid="ROM 8:12"/><verse number="13" style="v" sid="ROM 8:13"/>ይንቲ፥ ይ አሾ አሞስ የዝኮ Ꮊይቆዳይስ የዛ፥ ዝን ጌሻ አያና ዎልቃር ናጋራ ኦሶ ዎኮ ይ ደኦር የዞዳ። <verse eid="ROM 8:13"/><verse number="14" style="v" sid="ROM 8:14"/>ጾሳ አያናይ ካልዛ ኡባይ ጾስስ ናእታ። <verse eid="ROM 8:14"/><verse number="15" style="v" sid="ROM 8:15"/>ኑኒ፥ «ኣቦ፥ አዳዮ» ዬጊ ጼግዝ፥ ጾስስ ናእታ ኡድዛ ጌሻ አያና ኤኬዛይፕ አትን ማቂ ያሻር የዞዳይስ አይለ ኡድዝ አያና ኤከካያ።<note caller="-" style="x"><char style="xo" closed="false">8:15 </char><char style="xt" closed="false"><ref loc="MRK 14:36">ማር. 14:36</ref>፤ <ref loc="GAL 4:6">ጋላ. 4:6</ref></char></note> <verse eid="ROM 8:15"/><verse number="16" style="v" sid="ROM 8:16"/>ጾስ አያናይ ኑ አያናይር ማቂ ኑ ጾስስ ናእታ ማቅዛ ማርካትዛ። <verse eid="ROM 8:16"/><verse number="17" style="v" sid="ROM 8:17"/>ኑኒ ኤ ናእታ ማቅኮ ጾሳ ላትዝታ፤ ክርስቶሳር ዎላ የያ ላቶዳ። ማ ኑኒ ክርስቶሳር መቶ ኤክኮ ኤዛር ዎላ ኤ ቦንቻ ሻክንቶዳ።<verse eid="ROM 8:17"/></para>
  <para style="s1">የኦድ ቦንቾ</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 8:18"/>ኑኒ Ꮊት ዋይንትዛ ዋያ፥ ቲናፕ ኑስ በንቶድ ቦንቻይር ዎልሄል በአዳር፥ አብካ ኣዚ በንቶዛ ታ ቆፕዛ። <verse eid="ROM 8:18"/><verse number="19" style="v" sid="ROM 8:19"/>መት ኡቢታይ ጾስ ናእታይ ቆንጭ ጋመ ላሞር ናግዛ። <verse eid="ROM 8:19"/><verse number="20" style="v" sid="ROM 8:20"/>መት ኡቢታይ ጨረ ባዝስ ሞድንቴዛ፤ የይካ፥ መት ዶሮር ባዝን ኡፋይስስ ሞድንቶድ ጋርክ ኦዝ ጾስ ሸነር ሀኔዛ።<note caller="-" style="x"><char style="xo" closed="false">8:20 </char><char style="xt" closed="false"><ref loc="GEN 3:17-19">መ. 3:17-19</ref></char></note> <verse eid="ROM 8:20"/><verse number="21" style="v" sid="ROM 8:21"/>መትይ ፋ ኦማር ብስዛ አይለትፕ ዎዝንቲ፥ ጾስ ናእታይር ዎላ ቦንቾ ዎዞ ሻክንቶዳ። <verse eid="ROM 8:21"/><verse number="22" style="v" sid="ROM 8:22"/>መትይ ኡባይ Ꮊኖ ሄሎዳይስ እቅ አይኬዝ ማች ጋርክ ኦለራኔ መቶር የዛና ኑ ኤርዛ። <verse eid="ROM 8:22"/><verse number="23" style="v" sid="ROM 8:23"/>ማ መት ኣዳ ባዝን ጌሻ አያና ባይራ እሞታ ጋርክ ኤኬዝ ኑኒ፥ ኑ ኡባስ ኑ አሻይስ ዎዞ ማቄዝ ጾስ ናእታ ማቃድ ኡፋይስ ናግታር ኑ አሻይር ኦልዛ።<note caller="-" style="x"><char style="xo" closed="false">8:23 </char><char style="xt" closed="false"><ref loc="2CO 5:2-4">2ቆሮ. 5:2-4</ref></char></note> <verse eid="ROM 8:23"/><verse number="24" style="v" sid="ROM 8:24"/>Ꮊ ኡፋይሳይር ኑኒ ፓጼዛ። ዝን ኑኒ ኡፋይስ ጋድዛባዛይ በንትዝ ማቅኮ የያ ኦኒ ኡፋይስ ኡዴ? <verse eid="ROM 8:24"/><verse number="25" style="v" sid="ROM 8:25"/>ዝን ኑ በኤካ ባዝ ደማዳ ግ ኡፋይሳር ናግኮ የያ ዳንዳአር ናግዛ።<verse eid="ROM 8:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 8:26"/>የይ ጋርክ ጌሻ አያናይ ኑ ዳቡርሳ ማድዛ። ኑኒ ጾሳ ዋይዚ ዎሶዳይስ ቤዝዛኮ ኤሮያ፥ ዝን አያናይ ፋ ኡባስ፥ አሲ ኦዶዳይስ ዳንዳእንቶዋ ቃላር ኑስ ጋናትዛ። <verse eid="ROM 8:26"/><verse number="27" style="v" sid="ROM 8:27"/>ማ አስ ዎዝና ኤርዛ ጾሳይ፥ ጌሻ አያና ቆፋይ አብዛኮ ኤርዛ። ጌሻ አያናይ ጾስ ሸናይ ጋርክ ጌሽታይስ ጋናትዛ።<verse eid="ROM 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 8:28"/>ጾሳ ቃዝታይስኔ ኤ ሸናይ ጋርክ ጼግንቴዝታይስ ጾሳይ ኡባ ባዝ ሎኦስ ኦዛና ኑ ኤርዛ። <verse eid="ROM 8:28"/><verse number="29" style="v" sid="ROM 8:29"/>ጾሳይ ቲናቲ ኤሬዝታ ፋ ናአ ኣዞድ ጋርከራ ናአይካ ጋመ እሽታይ አማንዝታይ ጋንጨ ባይራ ማቃድ ጋርክ ኡንታን ዱማሲ ጋዴዛ። <verse eid="ROM 8:29"/><verse number="30" style="v" sid="ROM 8:30"/>ጾሳይ ቲናቲ ቆፒ ጋዴዚታ ዝታ ጼጌዛ፤ ጼጌዝታ ጽልሴዛ፤ ጽልሴዝታ ማ ቦንቼዛ።<verse eid="ROM 8:30"/></para>
  <para style="s1">ጾስ ሲቆ</para>
  <para style="p">
    <verse number="31" style="v" sid="ROM 8:31"/>የዝን፥ ኑ Ꮊ ኡባይስ ዋጎዴ? ጾሳይ ኑ ባጋ ማቅኮ ኑር ኦኖ ኤቅንቶዳይ? <verse eid="ROM 8:31"/><verse number="32" style="v" sid="ROM 8:32"/>ኤ ሀራ አቶዝን፥ ፋ ናአይስ ቃካዛር፥ ኑ ግሾስ ኣ እንጌዛ። የዝን፥ ፋ ጋዛ ናአ ኑስ ኣ እንጌዛይ ዋይዚ ኡባ ባዝ ጨር እንጋሞ?<verse eid="ROM 8:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ROM 8:33"/>ጾስ ዶሬዝታ ሞቶዳይ ኦኖ? ጽልስዛይ ጾሰ የዝን ፕርዶዳይ ኦኖ? <verse eid="ROM 8:33"/><verse number="34" style="v" sid="ROM 8:34"/>Ꮊይቄዛይ Ꮊይቆፐካ ደንዲ ጾስ ኡሻቻ በቴዝ፥ ክርስቶስ የሱሳ፥ ኤ ኑስ ጋናትዛ።<verse eid="ROM 8:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="ROM 8:35"/>ይኬ፥ ኑና ክርስቶሳ ሲቆፕ ሻኮዳይ ኦኖ? መቶነ ዎይ ዋየነ ዎይ ባይእነ ዎይ ናየነ ዎይ ካሎትኔ ዎይ ያሻነ ዎይ ኦላነ? <verse eid="ROM 8:35"/><verse number="36" style="v" sid="ROM 8:36"/>ጌሻ ማጻፋይድ፥</para>
  <para style="q1" vid="ROM 8:36">«ኑ ነ ግሾስ ኡባ ጋላስ ቡትንትዛ፤</para>
  <para style="q2" vid="ROM 8:36">ሹክንትዛ ዱርታይ ጋርከካ ታይብንቴዛ»<note caller="-" style="x"><char style="xo" closed="false">8:36 </char><char style="xt" closed="false"><ref loc="PSA 44:2">ማዝ. 44:2</ref></char></note></para>
  <para style="m" vid="ROM 8:36">ግንትንቲ ጻፍንቴዛይ ጋርክ ማቄዛ።<verse eid="ROM 8:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="ROM 8:37"/>ዝን ኑ Ꮊ ኡባይድ ኑና ቃዝ ክርስቶሳር ጋምዝ ኡቢታይፕ ኣዛ።<verse eid="ROM 8:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ROM 8:38"/>የይ ግሾስ፥ Ꮊይቆ ማቅን የስ ማቅን ኪታንችታ ማቅን ሞድዝታ ማቅን Ꮊት የዛና ማቅን ቲናፕ የኦዳ ማቅን ዎልቃምታ ማቅን፥ <verse eid="ROM 8:38"/><verse number="39" style="v" sid="ROM 8:39"/>ቀካ ማቅን ዝቀካ ማቅን አባ መት ማቅን ኑ ጎዳ፥ ክርስቶሳ የሱሳር የዛ ጾስ ሲቃይፕ ኑና ሻኮዳይስ ዳንዳኦዛና ታኒ ኤርዛ።<verse eid="ROM 8:39"/></para>
  <chapter eid="ROM 8"/>
  <chapter number="9" style="c" sid="ROM 9"/>
  <para style="s1">እስሬልታይ ዶርንቶ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 9:1"/>ታኒ ክርስቶሳር ማቂ ቱሮ ኦድዛ፥ ዎርዶቶያ። ጌሻ አያናይ ካልዛ ታ ካሃይ ታኒ ዎርዶቶዛና ታስ ማርካትዛ። <verse eid="ROM 9:1"/><verse number="2" style="v" sid="ROM 9:2"/>ታ ዎዝናር እስራኤልታይስ ጋመ ቆፋራኔ ዱጾዋ ኡንአራ ቃማ ጋላስ ታ ቆፕዛ። <verse eid="ROM 9:2"/><verse number="3" style="v" sid="ROM 9:3"/>ታኒ፥ ታስ አሾር ዳቦ ማቄዝ ታ እሽታይ ግሾስ ክርስቶሳፕ ሻክንቲ ጾስ ባድ ጋንጨ የዜዛኮ ዶስዛዝን። <verse eid="ROM 9:3"/><verse number="4" style="v" sid="ROM 9:4"/>ኡንቲ እስራኤልታ፥ ጾሳይ ኡንታን ፋ ናእታ ኡዴዛ፥ ፋ ቦንቻ ኡንትስ ቆንጨ ኦዴዛ። ኡንታር ጫቄዛ፤ ህገ ኡንትስ እንጌዛ። ኡ ጾሳ ጎይኖድ ቱማ ኦጋ ቤዜዛ፤ ጾሳይ ኡፋይስ ቃላ ኡንትስ እንጌዛ።<note caller="-" style="x"><char style="xo" closed="false">9:4 </char><char style="xt" closed="false"><ref loc="EXO 4:22">ከስ 4:22</ref></char></note> <verse eid="ROM 9:4"/><verse number="5" style="v" sid="ROM 9:5"/>ኡ የለትይድ ማይዝታይ ኮች፤ ማ ክርስቶሳ አሾር ኮቼ ማቂ የኤዛ። ኡባይፕ ኣ ማቄዝ ጾሳይ መናስ ጋላትንቶ። አምንኤ!<verse eid="ROM 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 9:6"/>ማቆዝን፥ ጾሳ ቃላይ ፖልንተካ አቴዛ ጉስ ባያ። እስራኤለፕ የልንቴዝ አስ ኡቢታይ እስሬለ ባያ። <verse eid="ROM 9:6"/><verse number="7" style="v" sid="ROM 9:7"/>ማ አፍራመ ዛረ ኡቢታይ አፍራመ ናእታ ባያ። ጾሳይ አፍራመስ፥ «ነ ሼሻይ እሳቃ ባጋር ጼግንቶዳ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="GEN 21:12">መ. 21:12</ref></char></note> <verse eid="ROM 9:7"/><verse number="8" style="v" sid="ROM 9:8"/>የያ ጉሳይ አሾር የልንቴዝ ናእታይ ኡቢታይ ጾስ ናእታ ባያ። ዝን ቱማ እስሬለ ናእታይ ጾሳይ ገሌዝ ቃላይ ጋርክ የልንቴዝ ናእታ።<note caller="-" style="x"><char style="xo" closed="false">9:8 </char><char style="xt" closed="false"><ref loc="GEN 21:12">መ. 21:12</ref></char></note> <verse eid="ROM 9:8"/><verse number="9" style="v" sid="ROM 9:9"/>እንጎዳ ግ ገሌዝ ቃላይ፥ «ታኒ ላይ ዎደ Ꮊኖደ የኦዳ፤ ሳራካ ራ ናአ የሎዳ»<note caller="-" style="x"><char style="xo" closed="false">9:9 </char><char style="xt" closed="false"><ref loc="GEN 18:10">መ. 18:10</ref></char></note> ዬጌዛኖ።<verse eid="ROM 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 9:10"/>የይ ኣዳ ባዝን እርብቃ ማ ፐቲ ኑ አዳ እሳቃስ ዎደጼዝ ዎደ፤ <verse eid="ROM 9:10"/><verse number="11" style="v" sid="ROM 9:11"/>መንተ ናእታይ የልንቶዳይፕ ዎይ ኢታ ዎይ ሎኦ ኡደካዝን ጼግዛይፕ አትን ኦሶፕ ባዝን ዶሮ ጾሳ ቆፋይ ሚንጎዳይ ጋርከ <verse eid="ROM 9:11"/><verse number="12" style="v" sid="ROM 9:12"/>«ባይራይ ጌዳይስ ሃርንቶዳ» ዬጊ ጎዳይ ኢስ ኦዴዛ።<note caller="-" style="x"><char style="xo" closed="false">9:12 </char><char style="xt" closed="false"><ref loc="GEN 25:23">መ. 25:23</ref></char></note> <verse eid="ROM 9:12"/><verse number="13" style="v" sid="ROM 9:13"/>የይካ ጌሻ ማጻፋይድ፥ «ያይቆባ ዶሲ፥ ኤሳወ ታ እጼዛ»<note caller="-" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="MAL 1:2">ሚል. 1:2</ref></char></note> ግንትንቲ ጻፍንቴዛ።<verse eid="ROM 9:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 9:14"/>የዝን፥ ኑኒ ዋጎዴ? ጾሳይ አሰ አሳፕ ቁርኔ? ጾሲ ቁርዛ ጎዳይስ ኑ ዳንዳኦያ! <verse eid="ROM 9:14"/><verse number="15" style="v" sid="ROM 9:15"/>ጎዳይ ሙሰኮ፥</para>
  <para style="q1" vid="ROM 9:15">«ታ ማሮዳይስ ኮዬዝታና ማሮዳ፤</para>
  <para style="q2" vid="ROM 9:15">ታ ቃንቶዳይስ ኮይዛይስ ቃንቶዳ»<note caller="-" style="x"><char style="xo" closed="false">9:15 </char><char style="xt" closed="false"><ref loc="EXO 33:19">ከስ 33:19</ref></char></note> ዬጌዛ። <verse eid="ROM 9:15"/><verse number="16" style="v" sid="ROM 9:16"/>ይኬ፥ ጾስ ዶሮ አስ ሸነር ዎይ አስ ኦሶር ባዝን ኤ ማሮትይራ።<verse eid="ROM 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 9:17"/>ጌሻ ማጻፋይድ፥ ግብጸ ካታይኮ፥ «ታኒ፥ ታ ዎልቃ ኔል ቤዞዳይስኔ ታ ሱንይ አላመ ኡባይል ኤርንቶድ ጋርክ የይስ ነና ካዉትሴዛ»<note caller="-" style="x"><char style="xo" closed="false">9:17 </char><char style="xt" closed="false"><ref loc="EXO 9:16">ከስ 9:16</ref></char></note> ግንትንቲ ጻፍንቴዛ። <verse eid="ROM 9:17"/><verse number="18" style="v" sid="ROM 9:18"/>ይኬ፥ ጾሳይ ማሮዳይስ ኮይዛና ማርዛ፤ ዎዝና ሙምሶዳይስ ኮይዛይ ዎዝና ሙምስዛ።<verse eid="ROM 9:18"/></para>
  <para style="s1">ጾስ ካችኔ ማሮት</para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 9:19"/>ይንትፕ ፐታይ፥ «የዝን፥ ጾሳይ አስ አብስ ቦሮ? ጾስ እጽዛይ ኦኖ?» ዬጊ ኦይጮዳይስ ዳንዳእዛ።<verse eid="ROM 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 9:20"/>ዝን ነኖ አሶ፥ ጾሳር ፓላሞዳይስ ነ ኦኖ? ኦሶ ፋና ኦዛይኮ፥ «ታና Ꮊይ ጋርክ ኡዲ አብስ ኦኔ?»<note caller="-" style="x"><char style="xo" closed="false">9:20 </char><char style="xt" closed="false"><ref loc="ISA 29:16">ኢሳ. 29:16</ref>፤ <ref loc="ISA 45:9">45:9</ref></char></note> ግ ኦይጮዳይስ ዳንዳእኔ? <verse eid="ROM 9:20"/><verse number="21" style="v" sid="ROM 9:21"/>ዎይ ኡርቃ መዛይ ፐቲ ኡርቃፕ ፐታ ቦንቾ ሚሸ፥ Ꮊንካ ማ ቶሸ ሚሸ ኡዲ መዳይስ ማዉተ ባሳኔ?<verse eid="ROM 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 9:22"/>ጾሳይ ፋ ሴራ ቤዞዳይስኔ ፋ ዎልቃ ኤርሶዳይስ ኮይ ቦስ ጊግሴዝ ሴራ ሚሽታ ጋመ ጋርዦር ዳንዳኤዛኮ አብ ኤሬ? <verse eid="ROM 9:22"/><verse number="23" style="v" sid="ROM 9:23"/>ኤ የያ ኦዛይ ዳማ ቦንቾስ ጊግሴዝ፥ ፋ ዶሬዝ ናእታይስ ፋ ቦንቻ ኤርሶዳይሲ። <verse eid="ROM 9:23"/><verse number="24" style="v" sid="ROM 9:24"/>አይሁደ ማቅን፥ ዎይ አይሁደ ባ አስ ኡብታ ጾሲ ዶሬዛ።<verse eid="ROM 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 9:25"/>ናበ ሆሳኤ ማጻፋይ ጋንጨ፥</para>
  <para style="q1" vid="ROM 9:25">«ታ ታ ዎያ ባዝታካ፥ ‹ታ ዎያ› ግ ጼጎዳ።</para>
  <para style="q2" vid="ROM 9:25">ዶስንተካ ዎይታካ፥ ‹ዶስንቴዝታ› ግ ጼጎዳ።<note caller="-" style="x"><char style="xo" closed="false">9:25 </char><char style="xt" closed="false"><ref loc="HOS 2:23">ሆሳ. 2:23</ref></char></note><verse eid="ROM 9:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ROM 9:26"/>ኡንቲ ‹ታ ዎያ ባያ› ግንትንቲ ጼግንቴዝ አቃይድ፥</para>
  <para style="q2" vid="ROM 9:26">‹ደኦ ጾስ ናእታ› ግንትንቲ ጼግንቶዳ»<note caller="-" style="x"><char style="xo" closed="false">9:26 </char><char style="xt" closed="false"><ref loc="HOS 1:10">ሆሳ. 1:10</ref></char></note> ዬጌዛ።<verse eid="ROM 9:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 9:27"/>ናበ ኢስያሳ እስሬለ አስ ባዝ፥</para>
  <para style="q1" vid="ROM 9:27">«እስሬለ አስ አባ ሻፈ ጋርክ ጋንግኮካ፥</para>
  <para style="q2" vid="ROM 9:27">ኡንታፕ ጽቃ አስ አቶዳ።<note caller="-" style="x"><char style="xo" closed="false">9:27-28 </char><char style="xt" closed="false"><ref loc="ISA 10:22-23">ኢሳ. 10:22-23</ref></char></note><verse eid="ROM 9:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ROM 9:28"/>ጎዳይ ቢታ ኡባይል አፋ ኤልሲ ሙርቲ ኡከር Ꮊያ ኡዶዳ።» <verse eid="ROM 9:28"/><verse number="29" style="v" sid="ROM 9:29"/>ማካ ኢስያሳ፥</para>
  <para style="q1" vid="ROM 9:29">«ኡባፕ ዎልቃማ ጎዳይ ኑስ ጽቃ ዘር አሸካዛኮ፥</para>
  <para style="q2" vid="ROM 9:29">ኑኒ ሶዶማኔ ጋሞራ ካታማ ጋርክ ቦዳዝን»<note caller="-" style="x"><char style="xo" closed="false">9:29 </char><char style="xt" closed="false"><ref loc="ISA 1:9">ኢሳ. 1:9</ref></char></note></para>
  <para style="m" vid="ROM 9:29">ዬጊ ቲናቲ ኦዴዛ።<verse eid="ROM 9:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 9:30"/>የዝን፥ ኑ ዋጎዴ? ጽሎት ኮይበኤካ አይሁደ ባ አሳይ አማኖር ጽሎት ደንጌዛ። <verse eid="ROM 9:30"/><verse number="31" style="v" sid="ROM 9:31"/>ዝን ጽሎትይኮ ሄልዝ ህገ የዛ እስሬለ አሳይ ጽሎት ደንገካያ። <verse eid="ROM 9:31"/><verse number="32" style="v" sid="ROM 9:32"/>አብስ ደንገካሳ? ኡንቲ ጽሎት አማኖር ባዝን ኦሶር ኤኮዳይስ ኮዤዝ ግሾስ። የይ ግሾስ፥ ኡንቲ፥ «ቢዛ ሹቻር» ብንቴዛ። <verse eid="ROM 9:32"/><verse number="33" style="v" sid="ROM 9:33"/>ማጻፋይድ፥</para>
  <para style="q1" vid="ROM 9:33">«ቦኦይታ ታኒ ጽዮነ በ ሹችኔ ፎክስዝ ዛላ ጋዶዳ።</para>
  <para style="q2" vid="ROM 9:33">ኤዛ አማንዛ ኦንካ ዬላተና»<note caller="-" style="x"><char style="xo" closed="false">9:33 </char><char style="xt" closed="false"><ref loc="ISA 28:16">ኢሳ. 28:16</ref></char></note></para>
  <para style="m" vid="ROM 9:33">ግንትንቲ ጻፍንቴዛ።<verse eid="ROM 9:33"/></para>
  <chapter eid="ROM 9"/>
  <chapter number="10" style="c" sid="ROM 10"/>
  <para style="p">
    <verse number="1" style="v" sid="ROM 10:1"/>ታ እሹን፥ ታ ኩን ዎዝናር ታ አሞትዛይኔ ጾሳ ዎስዛይ እስሬልታይ አቶድ ጋርከ። <verse eid="ROM 10:1"/><verse number="2" style="v" sid="ROM 10:2"/>ኡንቲ ጾስስ ምጭንትዛዝን፥ ቱማ ኤረት ቦር ምጭንቶዛና ታ ማርካትዛ። <verse eid="ROM 10:2"/><verse number="3" style="v" sid="ROM 10:3"/>ኡንቲ ጾስ ጽሎት ኦገ ኤራም እጺ፥ ፋ ኣዳ ጽሎት ካሌዛፕ አትን ጾስ ጽሎት ኮየካያ። <verse eid="ROM 10:3"/><verse number="4" style="v" sid="ROM 10:4"/>አስ ኡባይ አማኖር ጽሎድ ጋርክ ክርስቶሳ ህገስ ፎሎ ማቄዛ።<verse eid="ROM 10:4"/></para>
  <para style="s1">አቶት ኡቢታይሲ</para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 10:5"/>ሙሰ አስ ህገ ናጊ ኤክዝ ጽሎትባዝ፥ «ህገ ናግዝ ኦንካ የ ህጋ ናጌዛይ ጋርክ ደኦ የዞዳ»<note caller="-" style="x"><char style="xo" closed="false">10:5 </char><char style="xt" closed="false"><ref loc="LEV 18:5">ለዊ. 18:5</ref></char></note> ዬጌዛ። <verse eid="ROM 10:5"/><verse number="6" style="v" sid="ROM 10:6"/>ዝን አማኖር ኤክዝ ጽሎት ባጋ ጊንትንቴዛይ Ꮊያ፦ «ነ ዎዝናር፥ ‹ኦኒ ሳሎ ከዞዴ?» ዬግፐ፤ የይ ክርስቶሳ ዎዳይስ።<note caller="-" style="x"><char style="xo" closed="false">10:6-8 </char><char style="xt" closed="false"><ref loc="DEU 30:12-14">ናምእ. 30:12-14</ref></char></note> <verse eid="ROM 10:6"/><verse number="7" style="v" sid="ROM 10:7"/>ዎይ፥ «ሱለ ሳአ ኦሞ ዎዳይ ኦኖ?» ጊፐ፤ የይ ክርስቶሳ ዱፎፕ ከሶዳይስ። <verse eid="ROM 10:7"/><verse number="8" style="v" sid="ROM 10:8"/>ዝን ዬጊ ጻፍንቴዝ፦ «ቃላይ ነ ካለ የዛ፤ ነ ዶና ጋንጨኔ ነ ዎዝና ጋንጨ የዛ» ኑኒ ይንትስ ኦድዝ አማኖ ቃላይ Ꮊያ።<verse eid="ROM 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 10:9"/>«የሱሳ ጎዳ» ግ ነ ዶናር ማርካትኮኔ ጾሳይ ኤዛ Ꮊይቆፕ ደንዛና ነ ዎዝናር አማንኮ፥ ነ አቶዳ። <verse eid="ROM 10:9"/><verse number="10" style="v" sid="ROM 10:10"/>አሲ ፋ ዎዝናር አማኒ ጽልዛ፤ ፋ ዶናር ማርካቲ አትዛ። <verse eid="ROM 10:10"/><verse number="11" style="v" sid="ROM 10:11"/>ማጻፋይ፥ «ኤዛ አማንዛ ኦንካ ዬላተና»<note caller="-" style="x"><char style="xo" closed="false">10:11 </char><char style="xt" closed="false"><ref loc="ISA 28:16">ኢሳ. 28:16</ref></char></note> ዬጌዛ። <verse eid="ROM 10:11"/><verse number="12" style="v" sid="ROM 10:12"/>ፐቲ ጾሳይ ኡቢታይ ጎዳ ማቄዝ ግሾስ አይሁድታይ ጋንጨኔ አይሁደ ባ አስ ጋንጨ ዱማት ባያ። ኤ ፋና ጼግዝ ኡባይስ ጋመ ኬሃ። <verse eid="ROM 10:12"/><verse number="13" style="v" sid="ROM 10:13"/>ጎዳ ሱን ጼግዝ ኦንካ አቶዳ።<verse eid="ROM 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 10:14"/>የዝን፥ ኡንቲ አማነካ የዝታር ዋይዚ ኤዛ ጼጎዳይስ ዳንዳኤ? ኡ ኤባዝ ስኤካ የዝታር ዋይዚ ኤዛ አማኖዳይስ ዳንዳእኔ? ማ ኡንትስ ቃላ ኦድዝ አስ ባዝን፥ ዋይዚ ስኦዳይስ ዳንዳእኔ? <verse eid="ROM 10:14"/><verse number="15" style="v" sid="ROM 10:15"/>ኪትንቴዝ አሲ ባዝን ቃላይ ዋይዚ ኦድንቶዳይስ ዳንዳኤ? ማጻፋይድ፥ «ኡፋይስ ዎንግለ ኦድዝ አስስ ቶክታይ ዋፋ ሎእነሻ»<note caller="-" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="ISA 52:7">ኢሳ. 52:7</ref></char></note> ዬጊ ጻፍንቴዛ።<verse eid="ROM 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 10:16"/>ዝን ኢስያሳ፥ «ጎዳዮ፥ ኑ ማርካት ኦኒ አማኔኔ?»<note caller="-" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="ISA 53:1">ኢሳ. 53:1</ref></char></note> ዬጌዛይ ጋርክ፥ ኡቢታይ ዎንግለ አማነካያ። <verse eid="ROM 10:16"/><verse number="17" style="v" sid="ROM 10:17"/>የይ ግሾስ፥ አማናይ ስሳፕ ይእዛ፤ ስስ ክርስቶሳ ቃላፕ ይእዛ።<verse eid="ROM 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 10:18"/>ማቆዝን፥ ኡ ቃላ ስኤካ ጉሶኔ? ዋኣ ስኤዛ። ማጻፋይድ፥</para>
  <para style="q1" vid="ROM 10:18">«ኡ ኦዳይ ቢታ ኡባይል ስንቴዛ፥</para>
  <para style="q2" vid="ROM 10:18">ኡ ቃላይ ሳአ ጋጻ ሄሌዛ»<note caller="-" style="x"><char style="xo" closed="false">10:18 </char><char style="xt" closed="false"><ref loc="PSA 19:4">ማዝ. 19:4</ref></char></note> ዬግንቴዛ። <verse eid="ROM 10:18"/><verse number="19" style="v" sid="ROM 10:19"/>ዝን እስሬለ አሳይ ኤረካያ ጉሶኔ? ሙሰ ቲና፥</para>
  <para style="q1" vid="ROM 10:19">«ታኒ ይንታን ለቂንቴዝ አሳይ ጋንጨ ቂርሶዳ፤</para>
  <para style="q2" vid="ROM 10:19">ማ አካኮዋ አሳይ ጋንጨ ይንታን ይሎሶዳ»<note caller="-" style="x"><char style="xo" closed="false">10:19 </char><char style="xt" closed="false"><ref loc="DEU 32:21">ናምእ. 32:21</ref></char></note></para>
  <para style="m" vid="ROM 10:19">ዬጌዛ።<verse eid="ROM 10:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 10:20"/>ማ ኢስያሳ፥</para>
  <para style="q1" vid="ROM 10:20">«ታና ኮየካ አሳይስ ታ በንቴዛ፤</para>
  <para style="q2" vid="ROM 10:20">ታና ኦይጨካ አሳይስ ታ ታና ቤዜዛ»<note caller="-" style="x"><char style="xo" closed="false">10:20 </char><char style="xt" closed="false"><ref loc="ISA 65:1">ኢሳ. 65:1</ref></char></note></para>
  <para style="m" vid="ROM 10:20">ዬጊ ያሽተካዛር ኦዴዛ።<verse eid="ROM 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 10:21"/>ዝን ኢሳያሳ እስሬልታይ ባጋ ኦድታር፥</para>
  <para style="q1" vid="ROM 10:21">«ጋላስ ሙዳ ኪትንቶዋ አሳይስኔ</para>
  <para style="q2" vid="ROM 10:21">ታና እጽዛ አሳይስ ታ ኩሸ ሚጬዛ»<note caller="-" style="x"><char style="xo" closed="false">10:21 </char><char style="xt" closed="false"><ref loc="ISA 65:2">ኢሳ. 65:2</ref></char></note></para>
  <para style="m" vid="ROM 10:21">ዬጌዛ።<verse eid="ROM 10:21"/></para>
  <chapter eid="ROM 10"/>
  <chapter number="11" style="c" sid="ROM 11"/>
  <para style="s1">ጾሳይ እስራኤልታ ኦሊ አሸካያ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 11:1"/>አን ታ ኦይጭዛ፦ የዝን፥ ጾሳይ ፋ ዎያ ኦሊ አሸነኔ? አሸካያ! ታኒ ታ ኡባስ እስሬለ፤ አፍራመ ሼሺ፤ ቢናማ ኮቼ።<note caller="-" style="x"><char style="xo" closed="false">11:1 </char><char style="xt" closed="false"><ref loc="PHP 3:5">ፍል. 3:5</ref></char></note> <verse eid="ROM 11:1"/><verse number="2" style="v" sid="ROM 11:2"/>ጾሳይ ቲን ዶሬዝ አስታ ኦሎያ። ማጻፋይድ፥ ኤላሳ እስራኤልታ ጾስ ቲና ዋይዚ ሞቴዛኮ፥ ይ ኤሮሳኔ? <verse eid="ROM 11:2"/><verse number="3" style="v" sid="ROM 11:3"/>ኤላሳ፥ «ጎዳዮ፥ ኡንቲ ነ ናብታ ዎዛ፥ ነ ያርሾ አቃካ ላሌዛ። ታ ታ ኣዳስ አቴዛ፤ ኡንቲ ታናካ ዎዳይስ ኮይዛ»<note caller="-" style="x"><char style="xo" closed="false">11:3 </char><char style="xt" closed="false"><ref loc="1KI 19:10">1ካት. 19:10</ref>፥ <ref loc="1KI 19:14">14</ref></char></note> ዬጌዛ።<verse eid="ROM 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ROM 11:4"/>ጾሳይ ኤኮ ዋጊ ማሄኔ? «ባኣለ ግዝ ኤቃስ ጎይነካ ላፑን ሙኩለ አሲ ታስ አሼዛ»<note caller="-" style="x"><char style="xo" closed="false">11:4 </char><char style="xt" closed="false"><ref loc="1KI 19:18">1ካት. 19:18</ref></char></note> ዬጌዛ።<verse eid="ROM 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 11:5"/>የይ ጋርከካ፥ Ꮊ ዎዳይድ ጾሳይ ፋ ኣ ኬሃትር ማራጼዝ ጽቅታይ [እስሬለ] የዛ። <verse eid="ROM 11:5"/><verse number="6" style="v" sid="ROM 11:6"/>ኤ ኡንታን ዶሬዛይ ፋ ኣ ኬሄትይራፕ አትን ኡ ኦሶር ባያ። ዶራይ ኦሶር ማቅኮ፥ ኤ ኣ ኬሄትይ ጨረ አቴዛ።<verse eid="ROM 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 11:7"/>የዝን፥ ዋየኔ? እስሬልታይ ፋ ኮይዝ ባዝ ደንገካያ፥ ዝን ጾሲ ዶሬዝ ጽቅታይ ደንጌዛ። አቴዝታይ ፋ ዎዛና ሙምሴዛ። <verse eid="ROM 11:7"/><verse number="8" style="v" sid="ROM 11:8"/>የይካ፥ ማጻፋይድ፥</para>
  <para style="q1" vid="ROM 11:8">«ኡ ኣፋይ ቦኦያ</para>
  <para style="q2" vid="ROM 11:8">ሀያይካ ስኦያ፥</para>
  <para style="q2" vid="ROM 11:8">Ꮊኖ ሄሎዳይስ ኡንትስ፤</para>
  <para style="q2" vid="ROM 11:8">ጾሳይ አዛላ አያና እንጌዛ»<note caller="-" style="x"><char style="xo" closed="false">11:8 </char><char style="xt" closed="false"><ref loc="DEU 29:4">ናምእ. 29:4</ref>፤ <ref loc="ISA 29:10">ኢሳ. 29:10</ref></char></note></para>
  <para style="m" vid="ROM 11:8">ግንትንቲ ጻፍንቴዛይ ጋርክ ሀኔዛ። <verse eid="ROM 11:8"/><verse number="9" style="v" sid="ROM 11:9"/>ማ ዳዉተ፥</para>
  <para style="q1" vid="ROM 11:9">«ኡ ሚዝ ሌማታይ ኡንታን ጽኬኔ ኦላ አይኮ፤</para>
  <para style="q2" vid="ROM 11:9">ኡንታን ጎልእስዛ ጋጋ ማቆ፤</para>
  <para style="q2" vid="ROM 11:9">ኡ ኢታትይ ኡንታን ሄሎ።<note caller="-" style="x"><char style="xo" closed="false">11:9-10 </char><char style="xt" closed="false"><ref loc="PSA 69:22-23">ማዝ. 69:22-23</ref></char></note><verse eid="ROM 11:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ROM 11:10"/>ኡ በአማይ ጋርክ ኡ ኣፋይ አይክንቶ፤</para>
  <para style="q2" vid="ROM 11:10">ኡባ ዎደ መቶ ኡንታን ኩንሶ» ዬጌዛ።<verse eid="ROM 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 11:11"/>የዝን፥ ብንቴዝታይ ፖኮድ ጋርከኔ? የያ ባያ! ኡ ዎይ አይሁደ ባ አሳይ አቶድ ጋርክ ሳንከ ማቄዛ። የይካ አይሁድታይ ኡንታል አፋ ቅናታማይ ጋርክ ኡዴዛ። <verse eid="ROM 11:11"/><verse number="12" style="v" sid="ROM 11:12"/>አይሁድታይ ናጋራይ አላማይስ ጋመ አንጆ ከኤዛ፤ ማ ኡ ጋምንትይ አይሁደ ባ አሳይስ ጋመ አንጆ ማቄዛ። የዝን፥ ዶርንቴዝ አይሁድታይ ኩን አትዝ ዎደ አንጆ አብ ጋርክ ዳሮደሻ?<verse eid="ROM 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 11:13"/>ታኒ፥ ይንትስ አይሁደ ባ አሳይስ ኦድዛ። አይሁደ ባ አሳይስ ሀዋረ ማቂ ኦዛይራ ታኒ ጋመ ጬቅንትዛ። <verse eid="ROM 11:13"/><verse number="14" style="v" sid="ROM 11:14"/>ታ የያ ኦዛይ ታስ አሾ ዳቦ ማቄዝ እስሬልታ ቂርሲ ኡንታፕ ጽቅታ አሾዳይሲ። <verse eid="ROM 11:14"/><verse number="15" style="v" sid="ROM 11:15"/>ጾሳይ ኡንታን ኦሊ አሼዝ ዎደ Ꮊ አላማይ ጾሳር ዳቦቴዛ። ጾሳይ ኡንታን ሺሺ ኤክዛ ዎደ Ꮊይቄዝ አሲ Ꮊይቆፕ ደንዳይ አብ ጋርክ ማቆዳይስ ዳንዳኤ?<verse eid="ROM 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 11:16"/>ቲና ኦሌዝ ሙኑቃይ ሎኦ ማቅኮ Ꮊንካይካ ጌሺ። ምስ ጻጶ ጌሺ ማቅኮ፥ ሻቃይካ ጌሺ ማቅዛ። <verse eid="ROM 11:16"/><verse number="17" style="v" sid="ROM 11:17"/>ጋደ ቱኬዝ ዎይራ ሻቆ ካርንትን፥ ይንቲ ዎራ ዶሌዝ ዎይራ ሻቆ ማቄዝታይ ኡ አቃይድ ንስንቲ ጻጶር ከዝዝ ዛይተ ሻክንቴዛ። <verse eid="ROM 11:17"/><verse number="18" style="v" sid="ROM 11:18"/>ይኬ፥ ይንቲ ሻቆ ጋርክ ካርንቲ ዎዛይል አፋ ኡትርትፓተ። ይ ኡትርትዛባዝ ማቅኮ፥ ጻጳይ ይንታን ቶኬዛፕ አትን ይ ጻጳ ቶከካዛ አካኮይታ።<verse eid="ROM 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 11:19"/>ኔኒ፥ «የ ሻቅታይ ካርንቴዛይ፥ ታኒ ኡ አቃይድ ንድንቶዳይ ጋርከ» ይ ጎዳይስ ዳንዳእዛ። <verse eid="ROM 11:19"/><verse number="20" style="v" sid="ROM 11:20"/>የይ ቱማ። ኡንቲ አማናም እጼዝ ግሾስ ካርንቴዛ። ኔኒ አማኔዝ ግሾስ የ አቃይድ ኤቄዛ። ነ ያሽቶዳይስ ቤዝዛፕ አትን ኡትርቶዳይስ ቤዞያ። <verse eid="ROM 11:20"/><verse number="21" style="v" sid="ROM 11:21"/>ጾሳይ መንቶ ሻቆ ማቄዝ አይሁድታይስ ቃንታም እጽኮ ይንትስካ ቃና።<verse eid="ROM 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 11:22"/>ይኬ፥ ጾሲ አብ ጋርክ ኬሃዛኮኔ አብ ጋርክ ምንዛኮ ቦኦይታ። ኤ ምንትይ ፎኬዝታይስ፥ ማ ኤ ኬህዛይ ይንትሲ። ሚንጊ ኤቃም እጽኮ ይንትካ ጋችንቶዳ። <verse eid="ROM 11:22"/><verse number="23" style="v" sid="ROM 11:23"/>ኡንቲ አማንኮ፥ ቲን ፋ የዛ አቃ ማቆዳ። ጾሳይ ዎልቃማ ኡንታን ማሂ፥ ጋዶዳይስ ዳንዳእዛ። <verse eid="ROM 11:23"/><verse number="24" style="v" sid="ROM 11:24"/>ይንታን ዎራ የዝ ዎይራ ማቄዝታ ጋቺ፥ ካራቻ ቱክንቴዝ ዎይራይል አፋ ይንታን ቱክኮ፥ መንቶ ጋደ ዎይራ ማቄዝታ ቲና አቃይድ ማሂ ቱኮዳይስ ዋይዚ ዳንዳእንቶሳ? <figure style="fig" alt="Olive tree with its fruits" file="BK00119B.tif" size="span" ref="11:24">ዎይራ ምኔ እ ኣፈ </figure><verse eid="ROM 11:24"/></para>
  <para style="s1">ጾሳ ማሮትይ ኡቢታይሲ</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 11:25"/>ታ እሹን፥ ይ ይንታን ኤራ ግ ጋይርፓተ። ታ ይንትስ ፐቲ ኦድዛ ጹሮድ ባዝ የዛ። የይካ እስራኤልታይፕ ባግታይ ዎዝና ሚን ስኣም እጼዛይ ዉርስ ሄሎዳይስ ባዝን አቶዳይስ የዝ አይሁደ ባ አስታይ ኡባይ ኩንር ጾስኮ የኦዳይ ጋርከ። <verse eid="ROM 11:25"/><verse number="26" style="v" sid="ROM 11:26"/>የይ ጋርከ፥ እስሬለ አስታይ ኡቢታይ አቶዳ። ማጻፋይድ፦</para>
  <para style="q1" vid="ROM 11:26">«ኑና ዎዝዛይ ጽዮነፕ የኦዳ፤</para>
  <para style="q2" vid="ROM 11:26">ያይቆባ ዘርፕ ኢታ ኡባ ብሶዳ።<note caller="-" style="x"><char style="xo" closed="false">11:26 </char><char style="xt" closed="false"><ref loc="ISA 59:20-21">ኢሳ. 59:20-21</ref></char></note><verse eid="ROM 11:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ROM 11:27"/>ታኒ ኡ ናጋራ አቶ ግዛይ</para>
  <para style="q2" vid="ROM 11:27">ኡንታር ጫቆድ ጫቃይ Ꮊያ»<note caller="-" style="x"><char style="xo" closed="false">11:27 </char><char style="xt" closed="false"><ref loc="ISA 27:9">ኢሳ. 27:9</ref></char></note></para>
  <para style="m" vid="ROM 11:27">ግንትንቲ ጻፍንቴዛ።<verse eid="ROM 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 11:28"/>ዎንግለ ኤካም እጺ፥ ይ ግሾስ ሞርከ ማቄዛ። ማቆዝን፥ Ꮊተካ ኡንቲ ዶርንቴዝታ፥ ጾሲ ኡ አድታይ ግሾስ ኡንታን ቃዛ። <verse eid="ROM 11:28"/><verse number="29" style="v" sid="ROM 11:29"/>ጾሲ ፋ እማይራኔ ፋ ጼሳይር ቂራቶያ። <verse eid="ROM 11:29"/><verse number="30" style="v" sid="ROM 11:30"/>ይንቲ ቲን ጾሳይስ ኪትንተካ፤ ዝን Ꮊት አይሁድታይ ኪትንታም እጽን፥ ይ ጾስ ማሮት ኤኬዝታ። <verse eid="ROM 11:30"/><verse number="31" style="v" sid="ROM 11:31"/>የይ ጋርከ፥ ይ ኤኬዝ ማሮት አይሁድታይ ኤኮድ ጋርክ Ꮊት ኡ ጾስስ ኪትንታም እጼዛ። <verse eid="ROM 11:31"/><verse number="32" style="v" sid="ROM 11:32"/>ጾሲ አስ ኡብታ ፋ ማሮት ቤዞዳይስ ኮይ፥ አሲ ኡቢታይ ኪትንታም እጾዳይ ጋርክ ጎርዴዛ።<verse eid="ROM 11:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ROM 11:33"/>ጾስ ዱረት፥ ኤጨትኔ ኤረት አካኪ ኦዶዳይ ኦኖ? ኤ ፕርዳይ ፕላግንቶያ፥ ኤ ኦጋይ ኤርንቶያ።<note caller="-" style="x"><char style="xo" closed="false">11:33 </char><char style="xt" closed="false"><ref loc="ISA 55:8">ኢሳ. 55:8</ref></char></note> <verse eid="ROM 11:33"/><verse number="34" style="v" sid="ROM 11:34"/>ማጻፋይድ፥</para>
  <para style="q1" vid="ROM 11:34">«ጾስ ካሃ ኤርዛይ ኦኖ?</para>
  <para style="q2" vid="ROM 11:34">ኤዛ ዞሮዳይስ ዳንዳእዛይ ኦኖ?<note caller="-" style="x"><char style="xo" closed="false">11:34 </char><char style="xt" closed="false"><ref loc="ISA 40:13">ኢሳ. 40:13</ref></char></note><verse eid="ROM 11:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="ROM 11:35"/>ጾስስ ታልእዛይኔ</para>
  <para style="q2" vid="ROM 11:35">ታልኤ ማሂ ኤክዛይ ኦኖ?»<note caller="-" style="x"><char style="xo" closed="false">11:35 </char><char style="xt" closed="false"><ref loc="JOB 41:11">ኢዮ. 41:11</ref></char></note></para>
  <para style="m" vid="ROM 11:35">ዬጌዛ።<verse eid="ROM 11:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ROM 11:36"/>ኡባይ ኤፕ፤ ኤዛራኔ ኤሲ፤ ኤስ መናስ ቦንቾ ማቆ። አምንኤ።<note caller="-" style="x"><char style="xo" closed="false">11:36 </char><char style="xt" closed="false"><ref loc="1CO 8:6">1ቆሮ. 8:6</ref></char></note><verse eid="ROM 11:36"/></para>
  <chapter eid="ROM 11"/>
  <chapter number="12" style="c" sid="ROM 12"/>
  <para style="s1">ክርስቶሳር ኦሮ የስ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 12:1"/>ይኬ፥ ታ እሹን፥ ይንቲ፥ ይ አሰት ጾስ ኡፋይስዛ፥ ፓኔ ጌሻ ያርሾ ኡዲ፥ እማድ ጋርክ ታ ይንታን ጾስ ከሃትይር ዎስዛ። ጾሳ ይ ጎይኖዳይስ ቤዝዛ ቱማ ኦጋይ የያ። <verse eid="ROM 12:1"/><verse number="2" style="v" sid="ROM 12:2"/>ሎኦ፥ ኡፋይስዛኔ ፎሎ ማቄዝ ጾሳ ኪታ ይ ሻኪ ኤሮዳይስ ይ ቆፋር ላምንቶይታፕ አትን Ꮊ አላማ ኣዝፓተ።<verse eid="ROM 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 12:3"/>ጾሲ ይንትስ ፐታይስ ፐታይስ እንጌዝ አማናይ ጋርክ ካሃር የዝ አስ ጋርክ ቆፖይታ። ቆፖዳይስ በዝዛይፕ ኣ ይንታን ዱማሲ፥ ኡትራር ቆፕፓተ ግ ታስ እንግንቴዝ ኣ ኬሃትይር ይንትስ ኦድዛ። <verse eid="ROM 12:3"/><verse number="4" style="v" sid="ROM 12:4"/>ኑ ፐቲ አሰትይል አፋ ዱማ ዱማ ክፍልታይ የዛ፤ የ ዱማ ዱማ ክፍልታይስ ዱማ ዱማ ኦሶ የዛ።<note caller="-" style="x"><char style="xo" closed="false">12:4-5 </char><char style="xt" closed="false"><ref loc="1CO 12:12">1ቆሮ. 12:12</ref></char></note> <verse eid="ROM 12:4"/><verse number="5" style="v" sid="ROM 12:5"/>የይ ጋርክ፥ ኑኒ ጋመ አስ ማቅኮካ ክርስቶሳር ፐቲ አሾ ማቄዛ። ኑኒ ፐቲ አሾ ማቂ ዱማ ዱማ ክፍልታይ ፐታይ ፐታይራ አይክንቴዛ። <verse eid="ROM 12:5"/><verse number="6" style="v" sid="ROM 12:6"/>ኑስ እንግንቴዝ ኣ ኬሃትር ዱማ ዱማ እሞትታይ የዛ። ኑ እሞትይ ትንቢተ ኦዶ ማቅኮ፥ ኑስ የዝ አማናይ ጋርክ ኦዶዳይስ ቤዝዛ።<note caller="-" style="x"><char style="xo" closed="false">12:6-8 </char><char style="xt" closed="false"><ref loc="1CO 12:4-11">1ቆሮ. 12:4-11</ref></char></note> <verse eid="ROM 12:6"/><verse number="7" style="v" sid="ROM 12:7"/>ኑ እሞትይ ሀራ አስ ማዴ ማቅኮ፥ የ ኦሳይር ምንጎዳይስ ቤዝዛ፤ ታማርሶ ማቅኮ፥ የ ታማርሳይር ምንጎዳይስ ቤዝዛ። <verse eid="ROM 12:7"/><verse number="8" style="v" sid="ROM 12:8"/>ኑ እማይ ሀራ አስ ዞር ማቅኮ፥ ሚንጊ ዞሮዳይስ ቤዝዛ። ኑ እሞትይ ኑስ የዛ ባዛፕ ሀራ አስስ እሞ ማቅኮ፥ ዎዝናፕ እንጎዳይስ ቤዝዛ። ኑ እሞትይ አቅሶ ማቅኮ፥ ሚንጊ አቅሶዳይስ ቤዝዛ። ኑ እሞትይ ሀራ አስስ ኬህ ማቅኮ፥ ኡፋይሳር ኬሆዳይስ ቤዝዛ። ኑ እሞትይ ማሮ ማቅኮ ኡፋይሳር ማሮዳይስ ቤዝዛ።<verse eid="ROM 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 12:9"/>ይ ሲቃይ ቆፕ ቆሞ ማቆዳይስ ቤዞያ። ኢታ ባዝ እጾይታ፤ ሎኦ ባዝ ሚን አይኮይታ። <verse eid="ROM 12:9"/><verse number="10" style="v" sid="ROM 12:10"/>ፐታይ ፐታይራ ዎል እሸ ጋርክ ዶስንቶይታ፤ ፐታይ ፐታ ቦንቾይታ። <verse eid="ROM 12:10"/><verse number="11" style="v" sid="ROM 12:11"/>ኦሶር አዛልፓተ ሚንጎይታ፤ ይ አያናር ጹግንቲ ጎዳይስ ሞድንቶይታ። <verse eid="ROM 12:11"/><verse number="12" style="v" sid="ROM 12:12"/>ጾሲ እንጌዝ ኡፋይሳይር ኡፋይቶይታ፤ መቶ ዳንዳኦይታ፤ ኡባ ዎደ ጾሳ ዎሶይታ። <verse eid="ROM 12:12"/><verse number="13" style="v" sid="ROM 12:13"/>አማንዛ ጌሽታ ኮሽዛ ባዛር ማዶይታ፤ እማታ ሞኮዳይስ ሚንጎይታ።<verse eid="ROM 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 12:14"/>ይንታን ባይእዝታ አንጆይታ፤ አንጆይታፕ አትን ባድፓተ።<note caller="-" style="x"><char style="xo" closed="false">12:14 </char><char style="xt" closed="false"><ref loc="MAT 5:44">ማቶ. 5:44</ref>፤ <ref loc="LUK 6:28">ሉቃ. 6:28</ref></char></note> <verse eid="ROM 12:14"/><verse number="15" style="v" sid="ROM 12:15"/>ኡፋይትዝታይር ኡፋይቶይታ፤ ዬክዝታይር ዬኮይታ። <verse eid="ROM 12:15"/><verse number="16" style="v" sid="ROM 12:16"/>ፐታይ ፐታይር ፐቲ ቆፋር የዞይታ። ኡትራ ቆፋ አሺ፥ ሃዮትር የዞዳይስ ሚንጎይታ። ይ ይንታን ኤጫ ግ ቆፕፓተ።<note caller="-" style="x"><char style="xo" closed="false">12:16 </char><char style="xt" closed="false"><ref loc="PRO 3:7">ኣዝ. 3:7</ref></char></note><verse eid="ROM 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 12:17"/>ኦንካ ይንትስ ኢታ ባዝ ኦኮ፥ የ አይስ ኢታ ባዝ ማህፓተ ኡባ አስ ቲና ሳቢስዛ ሎኦ ኦሶ ኦይታ። <verse eid="ROM 12:17"/><verse number="18" style="v" sid="ROM 12:18"/>ይንትስ ዳንዳእንትኮ ኡባ አሳር ሳሮ የዞይታ። <verse eid="ROM 12:18"/><verse number="19" style="v" sid="ROM 12:19"/>ታ እሹን፥ ይንቲ፥ ይ ኡባስ አስስ ኩሸ ከስፓተ። ጾሲ ኩሸ ከሶዳይ ጋርከ ኤዝስ አሺ አሾይታ። ጌሻ ማጻፋይድ፥</para>
  <para style="q1" vid="ROM 12:19">«ታ ኩሸ ከሶዳ፤</para>
  <para style="q2" vid="ROM 12:19">ታኒ ኩሸ ማሆዳ»<note caller="-" style="x"><char style="xo" closed="false">12:19 </char><char style="xt" closed="false"><ref loc="DEU 32:35">ናምእ. 32:35</ref></char></note></para>
  <para style="m" vid="ROM 12:19">ዬጌዛ ጎዳይ፥ ግንትንቲ ጻፍንቴዛ።<verse eid="ROM 12:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 12:20"/>ዝን ጌሻ ማጻፋይድ፥</para>
  <para style="q1" vid="ROM 12:20">«ነ ሞርካይ ናይንትኮ ሙዞባ፤</para>
  <para style="q2" vid="ROM 12:20">ኤ ሳምንትኮ ኡሾባ።</para>
  <para style="q1" vid="ROM 12:20">ነ የያ ኦኮ ኤ ኦማይል</para>
  <para style="q2" vid="ROM 12:20">ታማ ቃቃ ካችዛ»<note caller="-" style="x"><char style="xo" closed="false">12:20 </char><char style="xt" closed="false"><ref loc="PRO 25:21">ኣዝ. 25:21</ref></char></note></para>
  <para style="m" vid="ROM 12:20">ግንትንቲ ጻፍንቴዛ።<verse eid="ROM 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 12:21"/>ኢታ ሎኦር ጋሞይታፕ አትን ኢታር ጋምፓተ።<verse eid="ROM 12:21"/></para>
  <chapter eid="ROM 12"/>
  <chapter number="13" style="c" sid="ROM 13"/>
  <para style="s1">ጋደ አቅስዝታይስ አዛዝንቶ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 13:1"/>አባ ማውተካ ጾስ ሸነር እንግንትዛ ግሾስነ Ꮊት ማዉተር የዝታይካ ጾስ ሸነር ማዉተ ኤኬዝ ግሾስ አሲ ኡባይ ጋደ አቅስዝታይስ አዛዝንቶዳይስ ቤዝዛ። <verse eid="ROM 13:1"/><verse number="2" style="v" sid="ROM 13:2"/>የይ ግሾስ፥ ማዉተር የዝታይስ ኪትንታም እጽዛ ኦንካ ጾስ አዛዞ እጽዛ። ኪትንታም እጽዛ ኦንካ ፋል አፋ ፕርዳ ክእዛ። <verse eid="ROM 13:2"/><verse number="3" style="v" sid="ROM 13:3"/>አቅስዝታይ ኢታ ባዝ ኦዝታፕ አትን ሎኦ ኦዝታ ያሽሶያ። አቅስዝታይስ ያሽታማይስ ኮይኔ? የዛኮ ሎኦ ባዝ ኦባ፤ ነና ጋላቶዳ። <verse eid="ROM 13:3"/><verse number="4" style="v" sid="ROM 13:4"/>ኡንቲ ኔስ ሎኦ ባዝ ኦዳይስ ሹምንቴዝ ጾስ አይለ። ዝን ኔኒ ኢታ ባዝ ኦኮ፥ ኡንቲ ኢታ ባዝ ኦዛና ሴርዛ ግሾስ ኤዝስ ያሽቶባ ኡንቲ ቃዋ አይኬዛይ ጨረ ባያ። ኡንቲ ኢታ ባዝ ኦዝታ ሴሪ፥ ጾሲ ካጭዛና ቤዝዛ ጾስ አይለ። <verse eid="ROM 13:4"/><verse number="5" style="v" sid="ROM 13:5"/>የይ ግሾስ፥ ጾስ ካች ኣዳስ ባዝን ይ ካሃይ ማርካትዝ ግሾስ ጋደ አቅስዝታይስ ኪትንቶዳይስ ቤዝዛ።<verse eid="ROM 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 13:6"/>ይ ጊራ ጊርዛይካ የይ ግሾሲ። ጋደ አቅስዝታይ የ ኦሳ ኦዛይ፥ ኡንቲ ጾስ አይሊታ ማቄዝ ግሾስ።<note caller="-" style="x"><char style="xo" closed="false">13:6-7 </char><char style="xt" closed="false"><ref loc="MAT 22:21">ማቶ. 22:21</ref>፤ <ref loc="MRK 12:17">ማር. 12:17</ref>፤ <ref loc="LUK 20:25">ሉቃ. 20:25</ref></char></note> <verse eid="ROM 13:6"/><verse number="7" style="v" sid="ROM 13:7"/>ኡባይስ ቤዝዛና እንጎይታ። ጊራ ቤዝዝታይስ ጊሮይታ፤ ቃራጸ ቤዝዝታይስ ቃራጸ ጋቾይታ፤ ያሽቶዳይስ ቤዝዝታይስ ያሽቶይታ፤ ቦንቾ ቤዝዛና ቦንቾይታ።<verse eid="ROM 13:7"/></para>
  <para style="s1">ዎል ቃይታ</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 13:8"/>ፐታይ ፐታይር ሲቅንቶይታ። ሲቆ አጮፕ አትን ይንታል አፋ ሀራ አጮ የዝፐ። አስ ዶስዛ ኦንካ ህጋይ ግዛና ፖሌዛ። <verse eid="ROM 13:8"/><verse number="9" style="v" sid="ROM 13:9"/>«ላምፐ፤ ዎፐ፤ ካስትፐ፤ ዎርዶ ማርካትፐ፥ አሞትፐ» ግዝ አዛዛይኔ ሀራ አዛዞ ኡባይ፥ «ነ ዣማ ነ ኡባይ ጋርክ ቃባ» ግዝ አዛዞር አጭንቴዛ።<note caller="-" style="x"><char style="xo" closed="false">13:9 </char><char style="xt" closed="false"><ref loc="EXO 20:13-17">ከስ 20:13-17</ref>፤ <ref loc="DEU 5:17-19">ናምእ. 5:17-19</ref>፤ <ref loc="LEV 19:18">ለዊ. 19:18</ref></char></note> <verse eid="ROM 13:9"/><verse number="10" style="v" sid="ROM 13:10"/>ሲቆ ፋ ዣማይል አፋ ኢታ ባዝ ኦያ። የይ ግሾስ፥ ሲቆ ህገስ ፎሎ።<verse eid="ROM 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 13:11"/>ገንታፕ ይ ባርክዛ ዎዳይ Ꮊት ሄሌዝ ማቄዛይስ ላይ ኤሮይታ። ኑ አቶት ዎዳይ ቲና ኑ አማኔዝ ዎደፕ ኣ Ꮊት ኑኮ ኡኬዛ። <verse eid="ROM 13:11"/><verse number="12" style="v" sid="ROM 13:12"/>ቃማይ ኣዛ፤ ጋላሳይ ኡኬዛ። ይኬ፥ ኑኒ ማ ኦሶ አሺ ፖኦ ኦላ ሚሸ ዎላ አይኮዳ። <verse eid="ROM 13:12"/><verse number="13" style="v" sid="ROM 13:13"/>አን ጋላሳ ፖኦ የዝ አስ ጋርክ ዎላ ማራር የዞዳ። የራኔ ማራ፥ ላመራኔ ቃይጸራ<note caller="+" style="f"><char style="fr" closed="false">13:13 </char><char style="fqa" closed="false">ዉሹማር ዎላ ዱማ ዱማ ቱና ኦስታይር፦ ዎይ የር፥ ማር፥ ዉሹማር፥ ቃይጸር ማቅፐ ግ ብሎዳይስ ዳንዳእንትዛ። ዉሹማር ዎላል ዱማ ዱማ ቱና ኦስታይ አሲ ጾስ ሞድዛይፕ ባለ ከዚ ዶአ ጻባየ ኤኪ ፖልዛ ኦሶ ጉሲ።</char></note> ፓላማራኔ ቅናተራ ማቅፐ። <verse eid="ROM 13:13"/><verse number="14" style="v" sid="ROM 13:14"/>ጎዳ የሱስ ክርስቶሳና ማኦይታ፤ ይ ናጋራ ኦዝ አሻይ ፋ እና ፖሎድ ጋርክ ኤዝስ ቆፕፓተ።<verse eid="ROM 13:14"/></para>
  <chapter eid="ROM 13"/>
  <chapter number="14" style="c" sid="ROM 14"/>
  <para style="s1">አሳል አፋ ፕርድፓተ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 14:1"/>አማኖር ዳቡሬዝ ኦናካ ሺሺ ኤኮይታፕ አትን ኤ ቆፋይል አፋ ፕርድፓተ።<note caller="-" style="x"><char style="xo" closed="false">14:1-6 </char><char style="xt" closed="false"><ref loc="COL 2:16">ቆላ. 2:16</ref></char></note> <verse eid="ROM 14:1"/><verse number="2" style="v" sid="ROM 14:2"/>ኣዝሶስ፥ አማኖር ምንጌዝ ፐቲ አስ አባ ካካ ማዳይስ ዳንዳእዛ። ዝን አማኖር ሚንገካ አስ አታክልተ ኣዳ ሚዛ። <verse eid="ROM 14:2"/><verse number="3" style="v" sid="ROM 14:3"/>ሚዝ አስ ሞዋ አ ቦርፐ። ሞዋ አስ ሚዝ አይል ፕርድፐ። ጾሲ ኡብታ ኤኬዛ። <verse eid="ROM 14:3"/><verse number="4" style="v" sid="ROM 14:4"/>ሀራ አስ አይለል አፋ ፕርድዛይ ኔኒ ኦኖ? ኤ ዳቡርን ዎይ ምንግን ፋ ጎዳይሲ። ጎዳይ ኤዛ ኤሶዳይስ ዳንዳእዛ ግሾስ ኤ ሚንጊ ኤቆዳ።<verse eid="ROM 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 14:5"/>ማ «ፐቲ ጋላሲ Ꮊንኮ ጋላሳፕ ኣዛ» ዬጊ ቆፕዛ አሲ የዛ። ሀራይ ማ፥ «ጋላስታይ ኡቢታይ ዎል ጋርክ ግና ቦንቾር የዛ» ግ ቆፕዛ። ዝን ፐታይ ፐታይ ፋ ቆፋ አካኪ አጮ። <verse eid="ROM 14:5"/><verse number="6" style="v" sid="ROM 14:6"/>ጋላስ ቦንችዝ ኦንካ ጎዳይስ ግ ቦንችዛ። ኡባ ካ ሚዝ አሲ ጎዳይ ቦንቾስ ግ ሚዛ። ኤ ሚዝ የ ካት ግሾስ ጾሳ ጋላትዛ። ኡባ ካ ሞዋ አሲ ጎዳይ ቦንቾስ ሞያ፤ ማ ሜካ አሾራካ ጾሳ ጋላትዛ። <verse eid="ROM 14:6"/><verse number="7" style="v" sid="ROM 14:7"/>ኑፕ ኦንካ ፓስ ባያ፤ ማ ኑ ጋንጨፕ ኦንካ ፓስ Ꮊይቃም። <verse eid="ROM 14:7"/><verse number="8" style="v" sid="ROM 14:8"/>ኑ ሸምፖር የዝኮ ጎዳይስ የዞዳ፤ ማ Ꮊይቅኮካ ጎዳይስ Ꮊይቆዳ። ይኬ፥ ኑ ሸምፖር የዝን ዎይ Ꮊይቂን ጎዳይሲ።<verse eid="ROM 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 14:9"/>ክርስቶሳ Ꮊይቂ Ꮊይቆፕ ደንዴዛይ፥ ደኦር የዝታይስኔ Ꮊይቄዝታይስ ጎድ ማቃዳይሲ። <verse eid="ROM 14:9"/><verse number="10" style="v" sid="ROM 14:10"/>የዝን፥ ኔኒ ነ እሻይል አፋ አብስ ፕርዴ? ዎይ ኔኒ ነ እሻ አብስ ለቄ? ኑኒ ኡቢታይ ጾስ ፕርዳ ዙፋነ ቲና ኤቆዳ።<note caller="-" style="x"><char style="xo" closed="false">14:10 </char><char style="xt" closed="false"><ref loc="2CO 5:10">2ቆሮ. 5:10</ref></char></note><verse eid="ROM 14:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 14:11"/>ጌሻ ማጻፋይድ ጎዳይ፥</para>
  <para style="q1" vid="ROM 14:11">«ታኒ ፓ የዛ፤</para>
  <para style="q2" vid="ROM 14:11">አስ ኡቢታይ ታ ቲና ቡንቂቶዳ፤</para>
  <para style="q2" vid="ROM 14:11">ታኒ ጾስ ማቄዛና እንጻርስ ኡባይ ማርካቶዳ»<note caller="-" style="x"><char style="xo" closed="false">14:11 </char><char style="xt" closed="false"><ref loc="ISA 45:23">ኢሳ. 45:23</ref></char></note></para>
  <para style="m" vid="ROM 14:11">ዬጊ ጻፍንቴዛ። <verse eid="ROM 14:11"/><verse number="12" style="v" sid="ROM 14:12"/>ይኬ፥ ኑ ኦዝ ባዝስ ኑ ኦማር ኦማር ጾስ ቲና ሺቂ ማህ እማዳ።<verse eid="ROM 14:12"/></para>
  <para style="s1">ሀራ አስስ በ ማቅፐ</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 14:13"/>የይ ግሾስ፥ ኑኒ ፐታይ ፐታይል አፋ ፕርድዛና ዎላ አሾዳ። ዝን ይ እሻ ብዛ ዎይ ቃጽዛ ባዝ ኦማይ ጋርክ ናግንቶይታ። <verse eid="ROM 14:13"/><verse number="14" style="v" sid="ROM 14:14"/>ጎዳ የሱሳ አማንዛ አስ ጋርክ፥ ፋ ኡባስ ቱና ማቄዝ ባዝ ባዛና ታኒ ጌሺ ኤርዛ። ዝን ፐቲ አሲ ፐትባዝ ቱና ግ ቆፕኮ የይ ኤዝስ ቱና ማቅዛ። <verse eid="ROM 14:14"/><verse number="15" style="v" sid="ROM 14:15"/>ነ ሚዝ ካ ግሾስ ነ እሻ ቢዛባዝ ማቅኮ፥ ክርስቶሳር የዛ ነ እሻ ቃያ። ክርስቶሳ ኤ ግሾስ Ꮊይቄዝ አ ነ ሚዝ ካ ግሾስ ኤዛ ብስፐ። <verse eid="ROM 14:15"/><verse number="16" style="v" sid="ROM 14:16"/>ይኬ፥ ይንትስ የዝ ሎኦ ባዛ Ꮊንክታይ ቦሮድ ጋርከ ኦፓተ። <verse eid="ROM 14:16"/><verse number="17" style="v" sid="ROM 14:17"/>ጾስ ካተትይ ጌሻ አያናይር በንትዝ ጽሎት፥ ሳሮትኔ ቱማ ኡፋይሳፕ አትን ሙስ ባጋኔ ኡሽ ባጋ ባያ። <verse eid="ROM 14:17"/><verse number="18" style="v" sid="ROM 14:18"/>የይ ጋርክ ክርስቶሳስ ሞድንትዝ አስ ጾስ ኡፋይስዛ፤ አሳይ ጋንጨካ አንጅንትዛ።<verse eid="ROM 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 14:19"/>የይ ግሾስ፥ አን ኑኒ ሳሮት በንትዝ ኦገኔ ዎል አማኖር ሚንዛ ኦገ ካልዛ። <verse eid="ROM 14:19"/><verse number="20" style="v" sid="ROM 14:20"/>ካ ግሾስ ግ ጾሳ ኦሶ ብስፐ። ኡባ ካ ጌሺ፥ ዝን ሀራ አስ ሰእስዛ ካ ሙሲ ኢታ። <verse eid="ROM 14:20"/><verse number="21" style="v" sid="ROM 14:21"/>ነ እሻይ ብንታም ጋርክ አሾ ማም ዎይ ኡሽ ኡዣም ዎይ ቢዛ ሀራ ባዝ ኦምንጽኮ ሎኦ።<verse eid="ROM 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 14:22"/>ይኬ፥ Ꮊ ነ አማና ኔስኔ ነ ጾሳይ ጋንጨ ናጎባ። ልኬ ግ ቆፔዝባዝ ኦዛ ዎደ ኤ ካሃይ ሞቶዋ አይ አንጅንቴዛ። <verse eid="ROM 14:22"/><verse number="23" style="v" sid="ROM 14:23"/>ዝን ስታር ሚዝ አይስ ኤ ሙሳይ አማኖር ማቀካ ግሾስ ፕርድንትዛ። አማኖ ባይ ኦንቴዝ ኦሶ ኡቢታይ ናጋራ።<verse eid="ROM 14:23"/></para>
  <chapter eid="ROM 14"/>
  <chapter number="15" style="c" sid="ROM 15"/>
  <para style="s1">ሀራ አስታ ኡፋይሶ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 15:1"/>ኑ ምንታይ ዳቡሬዝታይ ዳቡራ ቶኮዳይስ ቤዝዛ። ኑኒ ኑና ኡፋይሶዳይስ ቤዞያ። <verse eid="ROM 15:1"/><verse number="2" style="v" sid="ROM 15:2"/>ኑኒ ዎል ምንዳይስ ዣምታ ማዶዳይስኔ ኡፋይሶዳይስ ቤዝዛ። <verse eid="ROM 15:2"/><verse number="3" style="v" sid="ROM 15:3"/>ክርስቶሳ ፋና ኡፋይስበኤካያ። ዝን ጌሻ ማጻፋይድ፥ «አሳይ ነና ጫዤዝ ጫሻይ ታና ሄሌዛ»<note caller="-" style="x"><char style="xo" closed="false">15:3 </char><char style="xt" closed="false"><ref loc="PSA 69:9">ማዝ. 69:9</ref></char></note> ግንትንቲ ጻፍንቴዛይ ጋርክ ሀኔዛ። <verse eid="ROM 15:3"/><verse number="4" style="v" sid="ROM 15:4"/>ጌሻ ማጻፋይ እንግዛ ጋርዦራኔ ምንራ ኑ ኡፋይሳ ኤኮድ ጋርክ ጌሻ ማጻፋይድ ጻፍንቴዝ ኡቢታይ ኑና ታማርሶዳይስ ጻፍንቴዛ።<verse eid="ROM 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 15:5"/>ጋርዦኔ ምኖት እንግዛ ጎዳይ ይንቲ የሱሳ ክርስቶሳ ካሎዳር ፐትፐተ ይንትስ እንጎ። <verse eid="ROM 15:5"/><verse number="6" style="v" sid="ROM 15:6"/>የይካ፥ ኑ ጎዳ የሱስ ክርስቶሳ ኣዳ፥ ጾሳ፥ ፐቲ ዎዛናራኔ ፐቲ ቃላር ይ ቦንቾድ ጋርከ።<verse eid="ROM 15:6"/></para>
  <para style="s1">ዎንግላይ አስ ኡቢታይስ</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 15:7"/>ክርስቶሳ ይንታን ኤኬዛይ ጋርክ ጾስ ቦንቾስ ፐታይ ፐታ ኤኮይታ። <verse eid="ROM 15:7"/><verse number="8" style="v" sid="ROM 15:8"/>ጾሲ ብኒ አድታይስ እንጌዝ ኡፋይሳይ ፖልንቶድ ጋርክ ኤ ቱማትይ ኤርንቶዳይ ጋርክ ክርስቶሳ ዶካልንቶ አይለ ማቂ የኤዛና ታ ይንትስ ኦድዛ። <verse eid="ROM 15:8"/><verse number="9" style="v" sid="ROM 15:9"/>ክርስቶሳ ዶካልንቶስ አይለ ማሄዝ ባዛይ ማ አይሁደ ባ አሳይ ጾሳ ኤ ማሮትይ ግሾስ ጋላቶድ ጋርከ። ጌሻ ማጻፋይድ፥</para>
  <para style="q1" vid="ROM 15:9">«ታ ነና አይሁደ ባ አስ ጋንጨ ጋላቶዳ፤</para>
  <para style="q2" vid="ROM 15:9">ነ ሱን ሳቦዳ»<note caller="-" style="x"><char style="xo" closed="false">15:9 </char><char style="xt" closed="false"><ref loc="2SA 22:50">2ሳም. 22:50</ref>፤ <ref loc="PSA 18:49">ማዝ. 18:49</ref></char></note></para>
  <para style="m" vid="ROM 15:9">ግንትንቲ ጻፍንቴዛይ ጋርክ ሀኔዛ።<verse eid="ROM 15:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 15:10"/>ማ፥ «አይሁደ ባ አሳይስ፥</para>
  <para style="q2" vid="ROM 15:10">ጾስ ዎያይራ ኡፋይቶይታ»<note caller="-" style="x"><char style="xo" closed="false">15:10 </char><char style="xt" closed="false"><ref loc="DEU 32:43">ናምእ. 32:43</ref></char></note> ዬግንቴዛ።<verse eid="ROM 15:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 15:11"/>ማ ማሂ፥ «አይሁደ ባ አሳይ ኡባይ፥</para>
  <para style="q2" vid="ROM 15:11">ጎዳ ጋላቶይታ፤</para>
  <para style="q2" vid="ROM 15:11">ካተት ኡቢታይ ኤዛ ሳቦይታ»<note caller="-" style="x"><char style="xo" closed="false">15:11 </char><char style="xt" closed="false"><ref loc="PSA 117:1">ማዝ. 117:1</ref></char></note></para>
  <para style="m" vid="ROM 15:11">ዬግንቴዛ።<verse eid="ROM 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 15:12"/>የይ ጋርክ ኢስያሳ፥</para>
  <para style="q1" vid="ROM 15:12">«ኢሳየ ጻጶፕ የልንቴዝ ፐታይ የኦዳ፤</para>
  <para style="q2" vid="ROM 15:12">ኤ ፋ ካተት ኡብታ አቅሶዳ።</para>
  <para style="q2" vid="ROM 15:12">ኡ ፋ ኡፋይሳ ኤዛል አፋ ጋዶዳ»<note caller="-" style="x"><char style="xo" closed="false">15:12 </char><char style="xt" closed="false"><ref loc="ISA 11:10">ኢሳ. 11:10</ref></char></note></para>
  <para style="m" vid="ROM 15:12">ዬጌዛ።<verse eid="ROM 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 15:13"/>ጌሻ አያና ዎልቃር ይ ድጮድ ጋርክ ኡፋይስ እንግዝ ጾሳይ፥ ይ አማናይ ባጋር ይንትስ ኡፋይሳራ ሳሮትር ኩን እንጎ።<verse eid="ROM 15:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 15:14"/>ታ እሹን ይንት ሎኦትኔ ኤረት ኩሜዛና ማ ፐታይ ፐታ ዞሮዳይስ ዳንዳእዛና ታ ጌሺ ኤርዛ። <verse eid="ROM 15:14"/><verse number="15" style="v" sid="ROM 15:15"/>ታኒ ይንታን ፐቲ ፐትባዝ ጉጂ አካክሶዳይስ ኮይ ያሽተካዛር Ꮊ ዳብዳባ ይንትስ ጻፌዛ። <verse eid="ROM 15:15"/><verse number="16" style="v" sid="ROM 15:16"/>ታኒ ክርስቶስ የሱሳ አይለ ማቂ፥ አይሁደ ማቀካ አሳይስ ቄሰ ጋርክ ኦ፥ ዎንግለ ኦዶድ ጋርከ ጾሳይ ታስ ኣ ኬሄት እንጌዛ። አይሁደ ባ አሳይ ጌሻ አያናር ጌዢ፥ ጾስ ኡፋይስዛ ያርሾ ማቃድ ጋርክ ጾሳይ የያ ኦዛ።<verse eid="ROM 15:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 15:17"/>ታኒ ክርስቶስ የሱሳር ማቂ ጾስስ ኦዛ ኦሶር ጬቅንትዛ። <verse eid="ROM 15:17"/><verse number="18" style="v" sid="ROM 15:18"/>አይሁደ ባ አሳይ ጾሳይስ ኪትንታ ማቃዳይ ጋርክ፥ ክርስቶሳ ታ ቃላኔ ታ ኦሶ ባጋር ኦዝ ኦሳይፕ አትን ሀራ ታ ጬቅንትዛባዝ ባያ። <verse eid="ROM 15:18"/><verse number="19" style="v" sid="ROM 15:19"/>ጾስ የያ ማላታራኔ ጌሻ አያና ዎልቃር ዋይዚ ኦዛኮ ታ ይንትስ ኦዶዳ። ታኒ የሩሳላመፕ አይኪ፥ ኢልዋርቆኔ ሄሎዳይስ ክርስቶሳ ዎንግለ ሳባኬዛ። <verse eid="ROM 15:19"/><verse number="20" style="v" sid="ROM 15:20"/>ታኒ ሀራ አስ ባሴዝ አቃይድ ኬጾዳይስ ኮዮያ። ክርስቶሳ ሱንይ ጼግንተካ አቆ ዎንግለ ሳባኮዳይስ አሞትዛ። <verse eid="ROM 15:20"/><verse number="21" style="v" sid="ROM 15:21"/>ጌሻ ማጻፋይድ፥</para>
  <para style="q1" vid="ROM 15:21">«ኤባጋ ኦድንተካ አሳይ ኤዛ በአዳ፤</para>
  <para style="q2" vid="ROM 15:21">ኤ ባጋ ስኤካ አሳይ አካኮዳ»<note caller="-" style="x"><char style="xo" closed="false">15:21 </char><char style="xt" closed="false"><ref loc="ISA 52:15">ኢሳ. 52:15</ref></char></note></para>
  <para style="m" vid="ROM 15:21">ግንትንቲ ጻፍንቴዛ።<verse eid="ROM 15:21"/></para>
  <para style="s1">ጳዉሎሳ ኦሮመ Ꮊማዳይስ ቆፔዛ</para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 15:22"/>የይ ባጋር፥ ታኒ ጋመ ዎደ ይንትኮ የኦዳይስ ኮይን ዳንዳእንተካያ።<note caller="-" style="x"><char style="xo" closed="false">15:22 </char><char style="xt" closed="false"><ref loc="ROM 1:13">ኦሮ. 1:13</ref></char></note> <verse eid="ROM 15:22"/><verse number="23" style="v" sid="ROM 15:23"/>ዝን ታኒ Ꮊተ Ꮊ ሄራር የዝ አቆ ኡባ ሄሌዝ ግሾስ ጋመ ላይፕ አይኪ ይንታን በአዳይስ ላሞቴዝ ግሾስ <verse eid="ROM 15:23"/><verse number="24" style="v" sid="ROM 15:24"/>ታኒ ኢስጴኔ Ꮊንግታር ይንታን በአዳይስ ቆፔዛ። ማ ጽቃ ዎደ ይንታር ኡፋይቴዛይፕ ጉየ ኢስጴኔ Ꮊንጎዳር ይ ታ ኦጋይስ ታና ማዶድ ጋርክ ኮይዛ።<verse eid="ROM 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 15:25"/>ዝን Ꮊተ ታኒ ጾሳ አስታ ማዶዳይስ የሩሳላመ Ꮊንግዛ። <verse eid="ROM 15:25"/><verse number="26" style="v" sid="ROM 15:26"/>ማቃዶናራኔ አካያ የዝ ጾስ አስታይ፥ የሩሳላመ ጌሽታይ ጋንጨ የዝ ማንቅታ ሚሸር ማዶዳይስ ኮዬዛ።<note caller="-" style="x"><char style="xo" closed="false">15:26 </char><char style="xt" closed="false"><ref loc="1CO 16:1-4">1ቆሮ. 16:1-4</ref></char></note> <verse eid="ROM 15:26"/><verse number="27" style="v" sid="ROM 15:27"/>ኡንቲ ማንቅታ ማዶዳይ ኡንትስ አቶዋ ባዝ ማቄዝ ግሾስ ፋ ኡባስ የያ ኦዳይስ ቆፋ አጬዛ። አይሁድታይ አይሁደ ባዝታይራ አያና አንጆ ሻግንትኮ፥ ኡንቲ ማ ፓስ የዛባዛር አይሁድታ ማዶዳይስ ቤዝዛ።<note caller="-" style="x"><char style="xo" closed="false">15:27 </char><char style="xt" closed="false"><ref loc="1CO 9:11">1ቆሮ. 9:11</ref></char></note> <verse eid="ROM 15:27"/><verse number="28" style="v" sid="ROM 15:28"/>የይ ግሾስ፥ ታኒ የ ሺቄዝ ሚሻ ኡንትስ እንገዛይፐኔ ኤኬዛና ኤሬዛፕ ጉየ ኢስጴኔ Ꮊንግታር ይ ላንቀር ኣዳ። <verse eid="ROM 15:28"/><verse number="29" style="v" sid="ROM 15:29"/>ታኒ ይንትኮ Ꮊንግዛ ዎደ ክርስቶሳ አንጆ ኩንር Ꮊማዳና ታ ኤርዛ።<verse eid="ROM 15:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 15:30"/>ታ እሹን፥ ታስ ጾስ ዎስታር ታ ቡትንቶዳር ታር ኤቆድ ጋርክ ጎዳ የሱስ ክርስቶሳራኔ ጌሻ አያና ሲቃይር ይንታን ዎስዛ። <verse eid="ROM 15:30"/><verse number="31" style="v" sid="ROM 15:31"/>ጾሳይ ታና ይሁዳ ጋንጨ የዝ አማኖዋ አስታይፕ አሾድ ጋርከኔ የሩሳላመ ታ ኦድ ኦሶ ጾስ አሳይ ላንቀ ኤክንቶድ ጋርክ ታስ ዎሶይታ። <verse eid="ROM 15:31"/><verse number="32" style="v" sid="ROM 15:32"/>ማ ጾስ ጊኮ፥ ታኒ ይንትኮ Ꮊንጊ ኡፋይሳር ይንታር ሸምፖድ ጋርክ ታስ ዎሶይታ። <verse eid="ROM 15:32"/><verse number="33" style="v" sid="ROM 15:33"/>ሳሮት ጾሳይ ይንታር ኡባይር ማቆ። አምንኤ።<verse eid="ROM 15:33"/></para>
  <chapter eid="ROM 15"/>
  <chapter number="16" style="c" sid="ROM 16"/>
  <para style="s1">ሳሮ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 16:1"/>ክንክራ ካታማ ጋንጨ የዝ ዎሳ ኬ ኦዛ ኑ ምሽት ፌበና ሎኦ ማች ማቅዛና ይ ኤሮድ ጋርክ ታ ኮይዛ። <verse eid="ROM 16:1"/><verse number="2" style="v" sid="ROM 16:2"/>ይ እዞ አማንዛ አስታይ ጎዳይ ሱንር ሞኮዳይስ ቤዝዛ አማንዛ አስታይፕ ፐታይ ጋርክ ሞኮይታ። እዛ ይንታፕ ኮይዝ ባዝ ኡባ እዞ ማዶይታ። እዛ ፋ ኡባስ ጋመ አስ ማዴዛ፤ ማ ታና ታ ባጋር ኡንደና ማዴዛ።<verse eid="ROM 16:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 16:3"/>ክርስቶሳ የሱሳ ኦሳ ታር ዎላ ኦዝ ጵርስቅላራኔ አቅላ ታ ቆ ሳሮ ጎይታ።<note caller="-" style="x"><char style="xo" closed="false">16:3 </char><char style="xt" closed="false"><ref loc="ACT 18:2">ሀዋ. ኦ. 18:2</ref></char></note> <verse eid="ROM 16:3"/><verse number="4" style="v" sid="ROM 16:4"/>ኡንቲ ታ ግሾስ ፋ ሸምፖ Ꮊይቆስ ኣ እንጌዛ። ታ ኣዳ ባዝን አይሁደ ባ አሳይ ዎሳ ኬታይ ኡቢታይ ኡንታን ጋላትዛ። <verse eid="ROM 16:4"/><verse number="5" style="v" sid="ROM 16:5"/>ኡ ካራ ሺቅዝ አማንዛ አሳ ታ ቆ ሳሮ ጎይታ።</para>
  <para style="p" vid="ROM 16:5">ኢስያ ቢታ ክርስቶሳና ቲን አማኔዛኔ፥ ታ ቃዛ ኤጳነጾሳስ ታ ሳሮ ኦዶይታ።<verse eid="ROM 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 16:6"/>ይ ግሾስ ኦሶር ጋመ ዳቡሬዝ ማይራሞ ሳሮ ጎይታ። <verse eid="ROM 16:6"/><verse number="7" style="v" sid="ROM 16:7"/>ታር አች ካራ ጋምኤዝታ አይሁደ ዳብታ አንድሮንቆሳራኔ ዩልያናራ ሳሮ ጎይታ። ኡንቲ የሱሳ ሀዋርታይ ጋንጨ ኤርንቴዝታ። ማ ኡንቲ ክርስቶሳ ታፕ ቲና አማኔዛ።<verse eid="ROM 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 16:8"/>ጎዳ አማንዛ ታ ሲቆ ላጋ፥ አምጲልያጾሳ ሳሮ ጎይታ። <verse eid="ROM 16:8"/><verse number="9" style="v" sid="ROM 16:9"/>ክርስቶሳ ኦሳ ኑር ዎላ ኦዝ ኡርባኖሰራ ታ ቃዛ እስታኩሳ ሳሮ ጎይታ። <verse eid="ROM 16:9"/><verse number="10" style="v" sid="ROM 16:10"/>ክርስቶሳር የሳይ ማርካትንቴዝ አጸልሳስ ታ ሳሮ ኦዶይታ። አርስጻቡሎ ካራ አሳይስ ታ ሳሮ ኦዶይታ። <verse eid="ROM 16:10"/><verse number="11" style="v" sid="ROM 16:11"/>ታ አይሁደ ላጋ ሄሮድዮና ሳሮ ጎይታ።</para>
  <para style="p" vid="ROM 16:11">ናርስሳራ ኤ ካራ አሳይፕ ክርስቶሳ አማኔዝታ ሳሮ ጎይታ።<verse eid="ROM 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 16:12"/>ጎዳይ ኦሶር ዳቡርዝ ማች ጽሩፋይናራኔ ጽሩፎሳ ሳሮ ጎይታ። ማ ጎዳይስ ጋመ ዳቡሪ ኦዝ፥ ታ ቃዛ ጸርስሶ ሳሮ ጎይታ። <verse eid="ROM 16:12"/><verse number="13" style="v" sid="ROM 16:13"/>ጎዳይ ኦሶር ሎእ ኤርንቴዝ ሩፎሳሳራኔ ታና ፋ ናአ ጋርክ ብእዛ ኤ እንዳትስ ታ ሳሮ ኦዶይታ።<note caller="-" style="x"><char style="xo" closed="false">16:13 </char><char style="xt" closed="false"><ref loc="MRK 15:21">ማር. 15:21</ref></char></note> <verse eid="ROM 16:13"/><verse number="14" style="v" sid="ROM 16:14"/>አስቂርጾሳ፥ ፍለሶንጻ፥ ሄርመንሳ፥ ጳትሮባሳስራ ኡንታር የዝ አማንዛ እሽታ ኡባይስ ታ ሳሮ ኦዶይታ። <verse eid="ROM 16:14"/><verse number="15" style="v" sid="ROM 16:15"/>ፍሎሎጉሳ፥ ዩልያ፥ ኔራ፥ ኤ ምሽቶ፥ ኦሉምፖሳራ ኡንታር የዝ ጌሽታ ኡብታ ሳሮ ጎይታ።<verse eid="ROM 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 16:16"/>ጌሽ ዬራ ዬርንትታር፥ ፐታይ ፐታ ሳሮይታ። ክርስቶሳ ዎሳ ኬ ኡቢታይ ይንታን ሳሮ ዬግዛ።<verse eid="ROM 16:16"/></para>
  <para style="s1">ዉርስ ዞረ</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 16:17"/>ታ እሹን፥ ይ ታማሬዝ ትምርታ እጺ፥ ይ ጋንጨ ሻክንቶኔ መቶ መዝ አስታይፕ ናግንቶይታ። ኡንታፕ ሃኮይታ። <verse eid="ROM 16:17"/><verse number="18" style="v" sid="ROM 16:18"/>የይ ጋርክ አሳይ ፋ ኡሎስ ኦዛፕ አትን ኑ ጎዳ ክርስቶሳስ ኦያ። ፋ ሊቆ ዶናራኔ ዎርዶ ቃላር ሃዮ ዎዛና ባልዛ። <verse eid="ROM 16:18"/><verse number="19" style="v" sid="ROM 16:19"/>ዎንግላይስ ይ ኪትንቴዛና አስ ኡቢታይ ስኤዛይ ታና ኡፋይስዛ። ዝን ይ ሎኦ ባዝስ ኤጫ ኢታ ባዝስ ቦዞዳና ታ ኮይዛ። <verse eid="ROM 16:19"/><verse number="20" style="v" sid="ROM 16:20"/>ሳሮ ጾሳይ ጻላሃና ይ ቶካይፕ ኦሞር ኤልሲ ጋጮዳ።</para>
  <para style="p" vid="ROM 16:20">ኑ ጎዳ የሱስ ክርስቶሳ ኣ ኬሄትይ ይንታር ማቆ።<verse eid="ROM 16:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 16:21"/>ታር ኦዝ ጽማቶሳ፥<note caller="-" style="x"><char style="xo" closed="false">16:21 </char><char style="xt" closed="false"><ref loc="ACT 16:1">ሀዋ. ኦ. 16:1</ref></char></note> ታ ዳብታይ ሉቅዮሳ፥ ያሶነራ ሶስጲጽሮሳ ይንታን ሳሮ ዬግዛ።<verse eid="ROM 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 16:22"/>Ꮊ ዳብዳባ ጻፌዝ ታኒ፥ ጻርጽዮሳ፥ ይንታን ጎዳይ ሱንር ሳሮ ዬግዛ።<verse eid="ROM 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 16:23"/>ታና ሞኬዛይኔ ዎሳ ኬ ኡቢታይ ሞክዛ ጋዮሳ፥ ይንታን ሳሮ ጌዛ። ካታማ ሚሸ አይክዝ ኤራስጾሳራ ኑ እሻ ቃርጾሳ ይንታን ሳሮ ዬግዛ።<note caller="-" style="x"><char style="xo" closed="false">16:23 </char><char style="xt" closed="false"><ref loc="ACT 19:29">ሀዋ. ኦ. 19:29</ref>፤ <ref loc="1CO 1:14">1ቆሮ. 1:14</ref>፤ <ref loc="2TI 4:20">2ጽማ. 4:20</ref></char></note> <verse eid="ROM 16:23"/><verse number="24" style="v" sid="ROM 16:24"/>[ኑ ጎዳ የሱስ ክርስቶሳ ኣ ኬሄትይ ይ ኡባይር ማቆ። አምንኤ።]<note caller="+" style="f"><char style="fr" closed="false">16:24 </char><char style="ft" closed="false">ብኒ ቲና ማጻፍታይድ ፓይዶ 24 ባያ።</char></note><note caller="-" style="x"><char style="xo" closed="false">16:24 </char><char style="xt" closed="false"><ref loc="ACT 19:29">ሀዋ. ኦ. 19:29</ref>፤ <ref loc="1CO 1:14">1ቆሮ. 1:14</ref>፤ <ref loc="2TI 4:20">2ጽማ. 4:20</ref></char></note><verse eid="ROM 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 16:25"/>ጾስስ ጋላታ ማቆ። ታኒ፥ የሱስ ክርስቶሳ ባዝ ኦድዝ ዎንግለ ቃላይር ብኒ ዎደፕ አይኪ ቆስንቲ ጋምኤዝ ቱማትር፥ ጾሳይ ይንታን አማኖር ሚን ኤሶዳይስ ዳንዳእዛ። <verse eid="ROM 16:25"/><verse number="26" style="v" sid="ROM 16:26"/>ዝን Ꮊት የ ቱማይ በንቴዛ። ካተት ኡቢታይ አማኒ ኪትንቶዳይ ጋርክ መና ጾሳ ኪታር ናብታይ የ ቱማባዝ ጻፌዛ።<verse eid="ROM 16:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 16:27"/>የሱስ ክርስቶሳ ባጋር ኤጨት ኤ ኣዳስ የዛ፥ ፐቲ ጾሳይስ መናስ ቦንቾ ማቆ። አምንኤ።<verse eid="ROM 16:27"/></para>
  <chapter eid="ROM 16"/>
</usx>
