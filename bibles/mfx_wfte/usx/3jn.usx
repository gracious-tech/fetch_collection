<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- Melo New Testament Ethiopic</book>
  <para style="h">3ዋንሳ</para>
  <para style="toc1">ዋንሳ ጻፌዝ ሀይን ኪታ</para>
  <para style="toc2">3ዋንሳ</para>
  <para style="toc3">3ዋን.</para>
  <para style="mt1">ዋንሳ ጻፌዝ ሃይን ኪታ</para>
  <para style="imt">ገሎ</para>
  <para style="ip">ዋንሳ ኪታ ሃይንና፥ የሱሳ ሀዋረ ማቄዝ ጭማይ፥ ዋንሳ ጻፌዛ። ኤ ጻፌዛይካ ጋዮሳ ግዝ ፐቲ ዎሳ ኬ አቅስዛይሲ። ጻፋይ ፐቲ ባጋር ጋዮሳ ሀራ አማንዝታ ማዴዝ ግሾስ ኤዛ ጋላትዛ፤ ማ ሀራ ባጋር ድዮትራፊሳ ግንትንትዛ ዎሳ ኬ ሀላቃ ማቆዳይስ ኮዬዝ ደሻ አይፕ ናግንቶዳይ ጋርክ ቆፍስዛ።</para>
  <para style="iot">3 ዋንሳ ኪታይ አይኬዝ ቆፍታ</para>
  <para style="io1">ገሎ <char style="ior"><ref loc="3JN 1:1-4">1-4</ref> </char></para>
  <para style="io1">ጋዮሳ ጋላትንቶ <char style="ior"><ref loc="3JN 1:5-8">5-8</ref> </char></para>
  <para style="io1">ድዮትራፊስ ቦርንታ <char style="ior"><ref loc="3JN 1:9-10">9-10</ref> </char></para>
  <para style="io1">ድመጽሮሲ ጋላትንቶ <char style="ior"><ref loc="3JN 1:11-12">11-12</ref> </char></para>
  <para style="io1">ኩስተ ቆፋ <char style="ior"><ref loc="3JN 1:13-15">13-15</ref> </char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="3JN 1"/>
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1"/>ታኒ ዎሳ ኬ ጭማ፥ ቱማ ዶስዛ ጋዮሳስ ኪቴዝ ኪታ።<note caller="-" style="x"><char style="xo" closed="false">1 </char><char style="xt" closed="false"><ref loc="ACT 19:29">ሀዋ. ኦ. 19:29</ref>፤ <ref loc="ACT 16:23">16:23</ref></char></note> <verse eid="3JN 1:1"/><verse number="2" style="v" sid="3JN 1:2"/>ታ ሲቃዮ፥ ኔኒ ነ ሸምፓይር ሎኦ የዛና ታ ኤሬዛይ ጋርክ ኔስ ጋላይ ሎኦ የዞዳ ጋርከኔ ነ ኦዛባዛይ ሱሮዳይ ጋርክ ኔስ ጾስ ዎስዛ። <verse eid="3JN 1:2"/><verse number="3" style="v" sid="3JN 1:3"/>ፐቲ ፐቲ አማንዛ አስታይ ይኢ፥ ኡባ ዎደ ኔኒ ቱማር የዛኔ ነ ቱማትይባጋ ማርካቴዝ ዎደ ታኒ ጋመ ኡፋይቴዛ። <verse eid="3JN 1:3"/><verse number="4" style="v" sid="3JN 1:4"/>ታ ናእታይ ቱማትር የዛ ስእዛይፕ ኣ፥ ታና ኡፋይስዛ ባዝ ባያ።<verse eid="3JN 1:4"/></para>
  <para style="s1">ጋዮሳ ጋላትንቶ</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5"/>ታ ሲቃዮ፥ ኡንቲ ኔስ እማ ማቅኮካ፥ ኔኒ አማንዛ አሳይስ አማንዛ ኦሶ ኦዛ። <verse eid="3JN 1:5"/><verse number="6" style="v" sid="3JN 1:6"/>ኡንቲ ነ ሲቃይባጋ ዎሳ ኬ ማርኬዛ። Ꮊተካ ኡንቲ Ꮊንጎዳር ኦገ ጾስ ዶስዛይ ጋርክ ኡዲ ኡንታን ማድኮ ነ ሎኦ ኦዛ። <verse eid="3JN 1:6"/><verse number="7" style="v" sid="3JN 1:7"/>ኡንቲ ክርስቶሳስ ኦዳይስ ከዚ፥ አማኖዋ አስታይፕ አኮካ ኤከካያ። <verse eid="3JN 1:7"/><verse number="8" style="v" sid="3JN 1:8"/>ኑኒ ቱማ ኦሳ ኡንታራ ፐትፕ ኦዳይስ Ꮊይ ጋርክ አስታ ማዶዳይስ ቤዝዛ።<verse eid="3JN 1:8"/></para>
  <para style="s1">ድዮትራፊሳኔ ድመጽሮሳ</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9"/>ታኒ ዎሳ ኬታይስ ዳብዳበ ጻፌዛ፥ ዝን ኡንታል ሀላቃ ማቆዳይስ ኮዬዝ ድዮትራፊሳ ኑኒ ግዛ ኤከካያ። <verse eid="3JN 1:9"/><verse number="10" style="v" sid="3JN 1:10"/>የይ ግሾስ፥ ታኒ ገድ Ꮊንጎዳር ኤ ኑል አፋ ኦድንትዛ ኢታ ኦዳኔ ኤ ኦዝ ኦሳ ኦዶዳ። ኤ የይ ጉጽዝ ግ፥ ኑ እሽታይ Ꮊማዳ ሞኮያ። ሀራ አቶዝን፥ ኡንታን ሞኮዳይስ ኮይዝታካ ካይ ዎሳ ኬይፕ ከሴዛ።<verse eid="3JN 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11"/>ታ ሲቃይ፥ ሎኦ ባዝ ኣዞባፕ አትን ኢታ ባዝ ኣዝፐ። ሎኦ ባዝ ኦዛ ኦንካ ጾስ አስ፥ ዝን ኢታ ባዝ ኦዛ ኦንካ ጾስ ኤሮያ።<verse eid="3JN 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="3JN 1:12"/>ድመጽሮሳ ሎኦ አስ ማቄዛና አስ ኡባይ ማርካትዛ። ቱማይ ፋ ኦማስ ኤባዝ ማርካትዛ፤ ኑካ ኤባዝ ማርካቶዳ፤ ኑ ማርካትይ ቱማ ማቄዛና ይ ኤርዛ።<verse eid="3JN 1:12"/></para>
  <para style="s1">ዉርስ ሳሮ</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13"/>ታኒ ኔስ ጻፎዳይስ ኮዬዝ ጋመ ባዝ የዛ፥ ዝን ዎርቃተር ጻፎዳይስ ኮየካያ። <verse eid="3JN 1:13"/><verse number="14" style="v" sid="3JN 1:14"/>ዝን ታኒ ኡከር ዎል ሄሊ በአዳይስ ቆፕዛ፤ የ ዎደ ኑኒ ኦድንቶዳይ።<verse eid="3JN 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15"/>ሳራይ ኔስ ማቆ።</para>
  <para style="p" vid="3JN 1:15">ነ ዳብታይ ነና ሳሮ ዬግዛ። ኑ ዳብታ ኡባ ኡ ሱን ሱን ጼጊ «ሳሮ ጌዛ» ዬጎባ።<verse eid="3JN 1:15"/></para>
  <chapter eid="3JN 1"/>
</usx>
