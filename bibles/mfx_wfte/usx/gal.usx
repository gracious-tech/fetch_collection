<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="GAL" style="id">- Melo New Testament Ethiopic</book>
  <para style="h">ጋላትያ</para>
  <para style="toc1">ጳዉሎሳ ጋላትያ አሳይስ ጻፌዝ ኪታ</para>
  <para style="toc2">ጋላትያ</para>
  <para style="toc3">ጋላ.</para>
  <para style="mt1">ጳዉሎሳ ጋላትያ አሳይስ ጻፌዝ ኪታ</para>
  <para style="imt">ገሎ</para>
  <para style="ip">የሱሳ አሽዛያ ማቄዛና ኦድዛ ዎንግለ ቃላይ ዱማ ዱማ አቆ ሳባክንትን፥ አይሁደ ባ አስታይ አማንታር አማንታር Ꮊማዳር «ክርስታነ ማቆዳይስ ሙሰ ህገ ፖሎዳይስ ኮሽነኔ ኮሾሳ?» ዬጊ ዎል ኦይጬዛ። የ ዎደ ጳዉሎሳ፥ «ክርስታኔ ማቆዳይስ ሙሰ ህገ ፖሎዳይስ ኮሾያ፤ የሱሳር ኦሮ ደኦ ደንጎዳይስ ኮሽዛይ የሱሳ አማኖ። አሳይ ጾስ ቲና ጽሎዳይስ ዳንዳእዛይ አማኖ ኣዳራ» ዬጊ ታማርሴዛ። ዝን ጽቃ ኢስያ ጋንጨ፥ ጋላትያ አዉራጃ የዝ ዎሳ ኬ የዝ አሳይ ጋንጨ፥ «አሲ ጾስ ቲና ጽሎዳይስ የሱሳና አማኖ ኣዳ ባዝን ሙሰ ህጋካ ፖሎዳይስ ኮሽዛ» ዬጊ ጳዉሎሳ ትምርታና እጽዛ አስታይ የዛ።</para>
  <para style="ip">ጳዉሎሳ ጋላትያ ማጻፈ ጻፌዛይ፥ የ ቡታ ትምርታይር ባልንቴዝ አሳ ቱማ አማናይኮኔ አማኖር የስኮ ማሆዳይሲ። ጳዉሎሳ የሱሳ ሀዋረ ማቅዛና ትልሲ ኦዶ አይኬዛ። ኤዛ ሀዋረ ኡዲ ጼጌዛይ አስ ባዝን ጾስ ማቄዛናኔ ኤ ኪትንቴዛይ አይሁደ ባ አሳይስ ማቄዛና ፓዲ ኦዴዛ። የይር አይስ አሳይ ጾስ ቲና ጽሎዳይስ ዳንዳእዛይ አማኖር ኣዳ ማቄዛና ኦድዛ። ዉርስ ሸምፕታይ አማኖር የሳይ የሱሳ አማኖር በንትዝ ሲቆፕ ከዝዛ ማቅዛና ኦድዛ።</para>
  <para style="iot">ጋላትያ ኪታይ አይኬዝ ቆፍታ</para>
  <para style="io1">ገሎ <char style="ior"><ref loc="GAL 1:1-10">1:1-10</ref> </char></para>
  <para style="io1">ጳዉሎሳ ሀዋረት ማዉተ <char style="ior"><ref loc="GAL 1:11-2:21">1:11—2:21</ref> </char></para>
  <para style="io1">ጾስ ኣ ኬሄት ዎንግለ <char style="ior"><ref loc="GAL 3:1-4:31">3:1—4:31</ref> </char></para>
  <para style="io1">ዋሎትኔ አማኖር የስ <char style="ior"><ref loc="GAL 5:1-6:10">5:1—6:10</ref> </char></para>
  <para style="io1">ኩስተ ቆፋ <char style="ior"><ref loc="GAL 6:11-18">6:11-18</ref> </char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="GAL 1"/>
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1"/>አሳፕ ዎይ አስ ባጋር ባዝን የሱስ ክርስቶሳፕ ኤዛ Ꮊይቆፕ ደንዝ ጾስ አዳይፕ ሀዋረ ማቃድ ጋርክ ኪትንቴዝ ታ ጳዉሎሳ፥ <verse eid="GAL 1:1"/><verse number="2" style="v" sid="GAL 1:2"/>ታር የዝ አማንዛ እሽታይ ኡቢታይፕ፥ ጋላትያ ጋደ የዛ ዎሳ ኬታይስ ኪትንቴዝ ኪታ።<verse eid="GAL 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 1:3"/>ጾስ ኑ አዳይፐ ኑ ጎዳ የሱስ ክርስቶሳፐ ይንትስ ኣ ኬሃትኔ ሳሮት ማቆ።<verse eid="GAL 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GAL 1:4"/>Ꮊ ኢታ አላማይፕ ኑና አሾዳይስ፥ ኑ ጾሳይኔ ኑ አዳይ ሸነር ክርስቶሳ ኑ ናጋራ ግሾስ ፋና ኣ እንጌዛ። <verse eid="GAL 1:4"/><verse number="5" style="v" sid="GAL 1:5"/>ጾሳይስ መናፕ መና ሄሎዳይስ ቦንቾ ማቆ። አምንኤ።<verse eid="GAL 1:5"/></para>
  <para style="s1">ቱማ ዎንግላይ ፐቶ</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6"/>ክርስቶሳ ኣ ኬሃትር ይንታን ጼጌዝ ጾሳ አሺ፥ ሀራ ዎንግላይኮ ይ ኤልሲ ዋይዚ ማቄዛኮ ታስ ማላባዝ ማቄዛ። <verse eid="GAL 1:6"/><verse number="7" style="v" sid="GAL 1:7"/>ይንታን ባልታራኔ ክርስቶሳ ዎንግለ ዎብሶዳይስ ኮይዝ ፐቲ ፐቲ አስታይ የዛፕ አትን ቱማ ዎንግላይ ፐቶ። <verse eid="GAL 1:7"/><verse number="8" style="v" sid="GAL 1:8"/>ዝን ኑና ማቅን ዎይ ሳሎ ኪታንቾ ማቅን ኑን ይንትስ ቲና ኦዴዝ ዎንግላይፕ ዱማትዛ ሀራ ዎንግለ ይንትስ ኦዴዝባዝ ማቅኮ፥ ኤ ጫዥንቴዛ ማቆ። <verse eid="GAL 1:8"/><verse number="9" style="v" sid="GAL 1:9"/>Ꮊይፕ ቲና ታኒ ጌዛይ ጋርክ Ꮊተካ ማሂ ግዛ። ይ ኤኬዝ ዎንግላይፕ ዱማትዛ ዎንግለ ኦንካ ይንትስ ኦድኮ የ አይ ጫዥንቴዛ ማቆ።<verse eid="GAL 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 1:10"/>የዝን፥ ታና አሲ ናሽቾድ ጋርክ ኮይነኔ? ጾሲ ናሽቾድ ጋርኬ? ታ አስ ኡፋይሶዳይሶኔ? ታ አስ ኡፋይሶዳይስ ኮይዝ ባዝ ማቅኮ፥ ክርስቶሳ አይለ ማቃምዝን።<verse eid="GAL 1:10"/></para>
  <para style="s1">ጳዉሎሳ ሀዋረተስ ጼግንቴዛ</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11"/>ታ እሹን፥ ታ ይንትስ ኦዴዝ ዎንግላይ አሳፕ ሀነካዛ ይ ኤሮድ ጋርክ ታ ኮይዛ። <verse eid="GAL 1:11"/><verse number="12" style="v" sid="GAL 1:12"/>ታስ Ꮊ ዎንግላ የሱስ ክርስቶሳ ዶዬዛፕ አትን አሳፕ ኤከካያ ዎይ አሲ ታና ታማርሰካያ።<verse eid="GAL 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 1:13"/>ታ ቲና አይሁድታይ አማናይድ የዝ ዎደ ዋይዚ የዜዛኮ፥ ይ ስኤዛ። ታ ጾሳ ዎሳ ኬ ባይኦዳይስኔ ብሶዳይስ ቡትቴዛ።<note caller="-" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="ACT 8:3">ሀዋ. ኦ. 8:3</ref>፤ <ref loc="ACT 22:4-5">22:4-5</ref>፤ <ref loc="ACT 26:9-11">26:9-11</ref></char></note> <verse eid="GAL 1:13"/><verse number="14" style="v" sid="GAL 1:14"/>አይሁድታይ አማና ናጎር ታኒ፥ ታ ዎዳይድ የዝ ጋመ አይሁደ ዳብታይፕ ኣዛ። ኑ አድታይ ዎጋይስካ ኡባፕ ኣ ምጭንትዛ።<note caller="-" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="ACT 22:3">ሀዋ. ኦ. 22:3</ref></char></note><verse eid="GAL 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 1:15"/>ዝን ታ ሀጋ የልንቶዳይፕ ቲና ጾሳይ ታና ዶሬዛ፤ ፋ ኣ ኬሃትራ ታና ጼጌዛ።<note caller="-" style="x"><char style="xo" closed="false">1:15-16 </char><char style="xt" closed="false"><ref loc="ACT 9:3-6">ሀዋ. ኦ. 9:3-6</ref>፤ <ref loc="ACT 22:6-10">22:6-10</ref>፤ <ref loc="ACT 26:13-18">26:13-18</ref></char></note> <verse eid="GAL 1:15"/><verse number="16" style="v" sid="GAL 1:16"/>አይሁደ ባ አሳይስ ዎንግለ ኦዶድ ጋርከ ጾሳይ ፋ ናአ ታስ ቆንጭሶዳይስ ኮዬዝ ዎደ ታ ኦራካ ዞርንተካያ። <verse eid="GAL 1:16"/><verse number="17" style="v" sid="GAL 1:17"/>ዎይ ታፕ ቲና ሀዋረ ማቄዝታይር ዎል ሄሎዳይስ የሩሳላመ Ꮊንገካያ። ዝን ታ ቲናቲ አራበ ቢታ Ꮊንጌዛ፤ የይፕ ማቂ ዳማስቆ ካታማ የኤዛ። <verse eid="GAL 1:17"/><verse number="18" style="v" sid="GAL 1:18"/>ሀይ ላይፕ ጉየ፥ ኬፋ ግንትዝ ጵጽሮሳ ሄሎዳይስ የሩሳላመ Ꮊንጊ ኤዛር ዎላ ታጶ እችን ቃማ በቴዛ።<note caller="-" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="ACT 9:26-30">ሀዋ. ኦ. 9:26-30</ref></char></note> <verse eid="GAL 1:18"/><verse number="19" style="v" sid="GAL 1:19"/>ዝን ጎዳይ እሻ ያይቆባፕ አትን Ꮊንኮ ሀዋርታ ታ በኤካያ።<verse eid="GAL 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GAL 1:20"/>ታ ይንትስ ጻፍዛይ ዎርዶ ባዛና ጾስ ቲና ይንትስ ኦድዛ።<verse eid="GAL 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 1:21"/>የይፕ ጉየ፥ ታኒ ሶራ ቢታኔ ክልቃ ቢታ Ꮊንጌዛ። <verse eid="GAL 1:21"/><verse number="22" style="v" sid="GAL 1:22"/>ይሁዳ ጋንጨ የዝ ዎሳ ኬ አሳይ ታና ብኢ ኤረካያ። <verse eid="GAL 1:22"/><verse number="23" style="v" sid="GAL 1:23"/>ዝን ኡንቲ፥ «ካሰ ኑና ባይእዝ አይ፥ Ꮊት ኤ ብሶዳይስ ኮይዝ አማናይ ባጋ ሳባክዛ» ዬግዛና ስኤዛ። <verse eid="GAL 1:23"/><verse number="24" style="v" sid="GAL 1:24"/>ስኤዝ ኡባይ ታ ባጋስ ጾሳ ጋላቴዛ።<verse eid="GAL 1:24"/></para>
  <chapter eid="GAL 1"/>
  <chapter number="2" style="c" sid="GAL 2"/>
  <para style="s1">ጳዉሎሳ ሀዋረትይ ኤርንቴዛ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1"/>ታጶ ኦይዲ ላይፕ ጉየ፥ ባርናባሳር ማቂ የሩሳላመ ታ Ꮊንጌዛ። የ ዎደ ትቶና ታ ታር ኤኪ Ꮊንጌዛ።<note caller="-" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="ACT 11:30">ሀዋ. ኦ. 11:30</ref>፤ <ref loc="ACT 15:2">15:2</ref></char></note> <verse eid="GAL 2:1"/><verse number="2" style="v" sid="GAL 2:2"/>ጾሳይ ታስ ቆንጭሴዝ ቆንጭይር ኤዛይድ Ꮊንጊ አይሁደ ባ አስ ጋንጨ ታ ሳባክዛ ዎንግላ ኡንትስ ቆንጨ ከሴዛ። ቲና ታ ዎጼዝ ዎይኔ Ꮊተካ ታ ዎጽዛ ዎይ ጨረ ማቃም ጋርክ ግ ካልዝታ ዱማ ሺሺ ኡንትስ ኦዴዛ። <verse eid="GAL 2:2"/><verse number="3" style="v" sid="GAL 2:3"/>ሀራ አቶዝን፥ ታር የዝ ትቶ ግርከ አስ ማቅኮካ፥ ዶካልንቶ ግ ኤዛ ጪጲቸካያ። <verse eid="GAL 2:3"/><verse number="4" style="v" sid="GAL 2:4"/>ማቆዝን፥ አማንዛ እሽታ ኣዚ ኑ ጋንጨ ገሌዝ ፐታይ ፐታይ ኤ ዶካልንቶድ ጋርክ ኮዬዛ። የ አስታይ ክርስቶስ የሱሳር ኑስ የዝ ዋሎት ቦንቂ ኤኮዳይስ ዙርቅንቲ ኑ ጋንጨ ገሊ ማሂ ኑና አይልዳይስ ኮይዛ። <verse eid="GAL 2:4"/><verse number="5" style="v" sid="GAL 2:5"/>ዝን ቱማ ዎንግላይ ይንታር ሚንጊ የዞድ ጋርክ ኑኒ ሀራ አቶዝን፥ ጽቃ ዎደስካ ኡንትስ ኩሸ እንገካያ።<verse eid="GAL 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 2:6"/>ዝን አቅስዝታ ኣዝዝ አሳይ ኦናትይ ታስ አብካ ማቀካያ። ጾሲ አስ ኣፈ ብኢ ፕርዶያ። Ꮊ አስታይ ታ ማርካትዝ ዎንግላይል አፋ ጉጄዝ ባዝ ባያ።<note caller="-" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="DEU 10:17">ናምእ. 10:17</ref></char></note> <verse eid="GAL 2:6"/><verse number="7" style="v" sid="GAL 2:7"/>ዝን ጵጽሮሳ፥ አይሁድታይስ ዎንግለ ኦዶ ግ ጾሳይ ኤዝስ ሀዳራ እንጌዛይ ጋርክ ታስካ አይሁደ ባ አሳይስ ዎንግለ ኦዶድ ሀዳራ እንጌዛና ኡንቲ ጉየፕ ኤሬዛ። <verse eid="GAL 2:7"/><verse number="8" style="v" sid="GAL 2:8"/>ይኬ፥ ጵጽሮሳ አይሁድታይ ሀዋረ ማቃዳይ ጋርክ ኦዝ ጾሳይ፥ ታናካ አይሁደ ባ አሳይስ ሀዋረ ማሄዛ። <verse eid="GAL 2:8"/><verse number="9" style="v" sid="GAL 2:9"/>ማ ቱስ ኣዚ በንትዝ ያይቆባ፥ ጵጽሮሳኔ ዋንሳ፥ ታስ እንግንቴዝ ኣ ኬሄት ብኢ ኑር ማድንቶዳይስ ታስኔ ባርናባሳስ ፋ ኡሻች ኩሻ እንጌዛ። ኑኒ አይሁደ ባ አሳይኮ፥ ማ ኡንትካ አይሁደ አስታይኮ Ꮊማዳይስ ማእንቴዛ። <verse eid="GAL 2:9"/><verse number="10" style="v" sid="GAL 2:10"/>ኡ ኑና ሚን ሀዳራ ጌዛይ፥ ኑኒ ማንቅታይስ ቆፖዳና። ካሰካ ታ የያ ኦዳይስ አሞትዛይሲ።<verse eid="GAL 2:10"/></para>
  <para style="s1">ጳዉሎሳ ጵጽሮሳ ሀና እጼዛ</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11"/>ጵጽሮሳ አንጾካ ካታማ Ꮊንጊ ባልንቴዝ ግሾስ ታኒ ኤ ቲና «ኔኒ ባልንቴዛ» ግ ጋይሌዛ። <verse eid="GAL 2:11"/><verse number="12" style="v" sid="GAL 2:12"/>ያይቆባ ኪቲ ዳኬዝ ጽቃ አሳይ የኦዳይፕ ቲና ኤ አይሁደ ባ አስታይር ዎላ ሚዛ፥ ዝን ኡንቲ የኤዛይፕ ጉየ፥ «አይሁደ ባ አሳይፕ አማኔዝታይ ዶካልንቶዳይስ ቤዝዛ» ግዝ አሳይስ ያሽቲ ኡንታፕ ሻክንቴዛ። <verse eid="GAL 2:12"/><verse number="13" style="v" sid="GAL 2:13"/>ማ Ꮊንኮ አማኔዝ አይሁድታይ ጵጽሮሳ ሀና ካሌዛ። ሀራ አቶዝን፥ ባርናባሳካ ኤ ቆፋይድ ገሌዛ።<verse eid="GAL 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GAL 2:14"/>ዝን ኡንቲ ዎንግለ ቱማትር ሉለ የዛና ታ ብኢ፥ ጵጽሮሳና አስ ኡቢታይ ቲና፥ «ኔኒ አይሁደ ማቅታር፥ አይሁደ ዎጋይ ጋርክ ባዝን አይሁደ ባ አስ ጋርክ የዝዛ፤ የዝን፥ ዋይዚ አይሁደ ባዝታይስካ፥ አይሁደ ዎጋይድ የዞይታ ግ ነ ዎልቃቴ?» ዬጌዛ።<verse eid="GAL 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 2:15"/>ኑኒ የልንቶ አይሁደ፥ ዝን ናጋራ ኦዝ አይሁደ ባ አስ ጋርክ ባያ። <verse eid="GAL 2:15"/><verse number="16" style="v" sid="GAL 2:16"/>ዝን አሲ የሱስ ክርስቶሳ አማኒ ጽልዛፕ አትን ህገ ናጊ ጽሎዛና ኑ ኤርዛ። ኦንካ ህገ ናጊ ጽሎዋ ግሾስ ኑካ ህገ ናጎር ባዝን ክርስቶሳ አማኒ ጽሎድ ጋርክ ክርስቶስ የሱሳና አማኔዛ።<note caller="-" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="PSA 143:2">ማዝ. 143:2</ref>፤ <ref loc="ROM 3:20">ኦሮ. 3:20</ref>፥ <ref loc="ROM 3:22">22</ref></char></note><verse eid="GAL 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 2:17"/>ክርስቶሳ ባጋር ጽሎዳይስ ኮይታር፥ ኑካ ናጋራ ኦዛባዝ ማቅኮ የዝን፥ ኑ ናጋራ ኦድ ጋርክ ደንዛይ ክርስቶሳ ጉሶኔ? ዋኣ! <verse eid="GAL 2:17"/><verse number="18" style="v" sid="GAL 2:18"/>ይኬ፥ ታ ላሌዛና ህገ ዎጋ ማሂ ኬጽዛ ማቅኮ ታኒ ታ ኡባስ ህገ መንዛ ማቄዛና ቤዝዛ። <verse eid="GAL 2:18"/><verse number="19" style="v" sid="GAL 2:19"/>ታኒ ጾስስ ፓ የዞዳይ ጋርክ ህገ ባጋር ህገስ Ꮊይቄዛ። <verse eid="GAL 2:19"/><verse number="20" style="v" sid="GAL 2:20"/>ታኒ ክርስቶሳር ዎላ ሶትንቴዛ። ታኒ Ꮊይፕ ታስ የዛሚ፥ ዝን ክርስቶሳ ታር የዛ። ታ Ꮊት የዝ የሳ፥ ታና ቃ ታ ግሾስ ፋና ኣ እንጌዝ ጾስ ናአ አማኒ የዛ። <verse eid="GAL 2:20"/><verse number="21" style="v" sid="GAL 2:21"/>ታኒ ጾስ ኣ ኬሄት ጨረ ኡዳሚ። ጽሎት አስስ ህገ ባጋር በንትዝ ባዝ ማቄዛኮ፥ ክርስቶሳ ጨር Ꮊይቄዝ ጉሲ።<verse eid="GAL 2:21"/></para>
  <chapter eid="GAL 2"/>
  <chapter number="3" style="c" sid="GAL 3"/>
  <para style="s1">ጽሎት በንትዛይ አማኖራ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1"/>ይንታኖ፥ አካካ ባ ጋላትያ አስታዮ፥ ይ ኣፋይ ቲናይድ ክርስቶሳ ማዝቃለል አፋ ሶትንቴዛይ ጋርክ ምስልንቲ ፕ በንትዛ። የዝን፥ ቱማስ ይ ኪትንታማይ ጋርክ ይንታን ብቴዛይ ኦኖ?<note caller="-" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="DEU 27:26">ናምእ. 27:26</ref></char></note> <verse eid="GAL 3:1"/><verse number="2" style="v" sid="GAL 3:2"/>ፐት ባዝ ታ ኤሮዳይስ ኮይዛ፤ ይ ጌሻ አያና ኤኬዛይ ህገ ናጎራኔ ዎይ ይ ስኤዝ ዎንግላ አማኖራ? <verse eid="GAL 3:2"/><verse number="3" style="v" sid="GAL 3:3"/>ይ Ꮊይ ጋርክ ቦዞ? ይ ጾስ አያናር አይኪ፥ Ꮊት አሾር ፖሎዳይስ ኮይኔ? <verse eid="GAL 3:3"/><verse number="4" style="v" sid="GAL 3:4"/>ይ ዎንግለ ባጋር ጋመ ዳቡሬዛይ ጨሬ? የ መቶ ኡባይ ጨረ ማቃሬ? <verse eid="GAL 3:4"/><verse number="5" style="v" sid="GAL 3:5"/>ጾሳይ ይንትስ ጌሻ አያና እንግዛይኔ ይ ጋንጨ ማላ ባዝ ኦዛይ፥ ይ ህገ ናጌዛይ ግሾኔ? ዎንግለ ስኢ አማኔዝ ግሾሶ?<verse eid="GAL 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 3:6"/>አን አፍራመና ቦኦይታ፥ «ኤ ጾሳና አማኔዛ፤ ጾሳይ ኤዝስ የያ ጽሎት ማሂ ታይቤዛ» ዬግንቲ ጻፍንቴዛ።<note caller="-" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="GEN 15:6">መ. 15:6</ref>፤ <ref loc="ROM 4:3">ኦሮ. 4:3</ref></char></note> <verse eid="GAL 3:6"/><verse number="7" style="v" sid="GAL 3:7"/>ይኬ፥ አማንዝታይ አፍራመ ናእታ ማቅዛና ኤሮይታ።<note caller="-" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="ROM 4:16">ኦሮ. 4:16</ref></char></note> <verse eid="GAL 3:7"/><verse number="8" style="v" sid="GAL 3:8"/>ጾሳይ አይሁደ ባ አስ አማኖር ጽልዳና ጌሻ ማጻፋይ ቲና ብኢ፥ «ዎያ ኡባይ ነ ባጋር አንጅንቶዳ» ዬጊ፥ ምሽራቾ ቃላ አፍራመስ ቲናቲ ኦዴዛ።<note caller="-" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="GEN 12:3">መ. 12:3</ref></char></note> <verse eid="GAL 3:8"/><verse number="9" style="v" sid="GAL 3:9"/>የይ ግሾስ፥ አማንዛ ኡባይ አማኔዝ አፍራመር ዎላ አንጅንቴዛ።<verse eid="GAL 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 3:10"/>ህገ ናጊ ጽሎድ ግዝ ኦንካ ጫዥንቴዛ። አብስ ጊኮ፥ ጌሻ ማጻፋይድ፥ «ህገ ማጻፋይ ጋንጨ ጻፍንቴዝ ኡባ ናጎዋ ኦንካ ጫዥንቴዛ ማቆ» ግንትንቲ ጻፍንቴዛ።<note caller="-" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="DEU 27:26">ናምእ. 27:26</ref></char></note> <verse eid="GAL 3:10"/><verse number="11" style="v" sid="GAL 3:11"/>«ጽሎ አስ አማኖር የዞዳ» ግንትንቲ ጻፍንቴዝ ግሾስ ኦንካ ጾስ ቲና ህገ ናጊ ጽሎዛይ ኤርንቴዝ ባዚ።<note caller="-" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="HEB 2:4">እብራ. 2:4</ref></char></note> <verse eid="GAL 3:11"/><verse number="12" style="v" sid="GAL 3:12"/>ህገ አማኖር ዎላ Ꮊንጎያ። ዝን፥ «ህገ ህገር የዞዳይስ ዳንዳእዛይ ህገ አዛዞ ኡባ ፖልኮ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="LEV 18:5">ለዊ. 18:5</ref></char></note><verse eid="GAL 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 3:13"/>«ምል አፋ ሶትንቲ Ꮊይቅዝ ኦንካ ጫዥንቴዛ» ግንትንቲ ጻፍንቴዝ ግሾስ ክርስቶሳ ኑ ግሾስ ጫዥንቴዛ ማቂ፥ ኑና ህገ ጫሻፕ ዎዜዛ።<note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="DEU 21:23">ናምእ. 21:23</ref></char></note> <verse eid="GAL 3:13"/><verse number="14" style="v" sid="GAL 3:14"/>ጾሳይ አፍራመስ እንጌዝ አንጆ፥ የሱስ ክርስቶሳ ባጋር አይሁደ ባ አስ ሄሎድ ጋርከኔ ጾሳይ እማድ ጌዝ ጌሻ አያና ኑኒ አማኖር ኤኮድ ጋርክ የያ ኦዛ።<verse eid="GAL 3:14"/></para>
  <para style="s1">ህገኔ ኡፋይስ ቃላ</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15"/>ታ እሹን፥ ታ ይንትስ አስ የሳር ጋምእ የዛ ባዝ ኣዝሶ ኡዲ ኦድዛ። አሲ ጫቄዝ ጫቆ ቃላይ ምንጌዛይፕ ጉየ፥ ኦንካ የ ጫቆ ቃላ ሻሮዳይስ ዎይ ኤዛል አፋ ሀራ ጉጆዳይስ ዳንዳኦያ። <verse eid="GAL 3:15"/><verse number="16" style="v" sid="GAL 3:16"/>ጾሳይ የ ኡፋይስ ቃላ አፍራመስኔ ኤ ሼሻይስ እንጌዛ። ጌሻ ማጻፋይ፥ ጋመ አስስ ኦድዛይ ጋርክ፥ «ነ ሼሽታይስ» ጎያ። ዝን ፐቲ አስስ ኦድዛይ ጋርክ፥ «ነ ሼሻይስ» ዬግዛ፤ ኤዝካ ክርስቶሳ።<note caller="-" style="x"><char style="xo" closed="false">3:16 </char><char style="xt" closed="false"><ref loc="GEN 12:7">መ. 12:7</ref></char></note><verse eid="GAL 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 3:17"/>ታኒ ግዛይ Ꮊያ፤ ኦይዲ ጼታኔ ሀስታም ላይፕ ጉየ እንግንቴዝ ህጋይ፥ ቲና ጾሳይ ምንዝ ጫቆ ቃላ ሻሪ ኡፋይስ ቃላ ብሶዳይስ ዳንዳኦያ።<note caller="-" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="EXO 12:40">ከስ 12:40</ref></char></note> <verse eid="GAL 3:17"/><verse number="18" style="v" sid="GAL 3:18"/>ጾሳይ እንግዝ ላታይ ህገር ኤክንትዛባዝ ማቄዛኮ ጾሳይ እንጌዝ ኡፋይሳይ ባጋር ማቅዛይ አትዛ። ዝን ጾሳይ ፋ ኣ ኬሃትር ላታ አፍራመስ ኡፋይስ ቃላ ባጋር እንጌዛ።<note caller="-" style="x"><char style="xo" closed="false">3:18 </char><char style="xt" closed="false"><ref loc="ROM 4:14">ኦሮ. 4:14</ref></char></note><verse eid="GAL 3:18"/></para>
  <para style="s1">ህገ አብስ እንግንቴዛኮ</para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 3:19"/>የዝን፥ ህጋይ አብስ እንግንተኔ? ህገ እንግንቴዛይ፥ አፍራመስ ኡፋይስ ቃላ እንግንቴዝ ዘርይ የኦድ ጋ ኢታ ኦሶ አብዛኮ ኤርሶዳይሲ። ህገ ኪታንችታይ ባጋር እንግንቲ፥ ጋንጨ ማቂ ዳቦዛ ፐቲ አስ ባጋር ኦሶል አፋ ፔዤዛ። <verse eid="GAL 3:19"/><verse number="20" style="v" sid="GAL 3:20"/>ጋንጨ ማቂ ዳቦዛ አይ ፐቲ ባጋ ኣዳፕ ባያ፥ ዝን ጾሳይ ፐቶ።<verse eid="GAL 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21"/>የዝን፥ ህጋይ ጾስ ኡፋይስ ቃላ እጽነኔ? እጾያ! ህገ እንግንቴዛይ ደኦ እማዳይስ ማቄዛኮ፥ ጽሎት ህገ ባጋር በንቶዳዝን። <verse eid="GAL 3:21"/><verse number="22" style="v" sid="GAL 3:22"/>ዝን የሱስ ክርስቶሳ አማንን በንትዝ ኡፋይስ ቃላይ አማንዝታይስ እንግንቶድ ጋርክ አላማይ ኩንይ ናጋራ አቻ የዛና ጌሻ ማጻፋይ ኦድዛ።<verse eid="GAL 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 3:23"/>ዝን አማኖ የኦዳይፕ ቲና ህገ ኑና አጪ ጋዴዛ። የ አማናይ በንቶድ ጋ ህጋይ ኑል አፋ ጎርዲ ጋዴዛ። <verse eid="GAL 3:23"/><verse number="24" style="v" sid="GAL 3:24"/>የይ ግሾስ፥ ኑኒ አማኖር ጽሎዳይ ጋርክ ክርስቶሳ የኦድ ጋ ህጋይ ናአ ናግዝ አስ ጋርክ ኑና ናግዛያ ማቄዛ። <verse eid="GAL 3:24"/><verse number="25" style="v" sid="GAL 3:25"/>ዝን Ꮊተ አማኖ የኤዝ ግሾስ ህገ Ꮊይፕ ጉየ ናአ ናግዝ አስ ጋርክ ማቄዝ ህጋይ ኦሞር አቅ አቴዛ።<verse eid="GAL 3:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GAL 3:26"/>ይ ኡቢታይ የሱስ ክርስቶሳና አማኒ ጾስ ናእታ ማቄዛ። <verse eid="GAL 3:26"/><verse number="27" style="v" sid="GAL 3:27"/>ክርስቶሳር ፐቶ ማቆዳይስ ጻማቅንቴዝ ኡቢታይ ክርስቶሳና አፍላ ጋርክ ማኤዛ። <verse eid="GAL 3:27"/><verse number="28" style="v" sid="GAL 3:28"/>ይ ኡቢታይ ክርስቶሳር ፐቶ ማቄዝ ግሾስ አይሁደ አስ ጋንጨኔ ግርኬ አስ ጋንጨ፥ አይለ ጋንጨኔ ዎማኖ ጋንጨ፥ ራ ጋንጨኔ ማች ጋንጨ ዱማት ባያ። <verse eid="GAL 3:28"/><verse number="29" style="v" sid="GAL 3:29"/>ይኬ፥ ይ ክርስቶሳስ ማቅኮ ይ አፍራመ ኮቺ። ጾስ ኡፋይስ ቃላይ ጋርክ ይ ላትዝታ።<note caller="-" style="x"><char style="xo" closed="false">3:29 </char><char style="xt" closed="false"><ref loc="ROM 4:13">ኦሮ. 4:13</ref></char></note><verse eid="GAL 3:29"/></para>
  <chapter eid="GAL 3"/>
  <chapter number="4" style="c" sid="GAL 4"/>
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1"/>Ꮊተካ ታ ግዛይ Ꮊያ። ላትዛ ናአይ ዱደት የዛ ዎደ፥ ሻሎ ኡባይ ኤባዝ ማቅኮካ፥ ኤ አይለፕ አባራካ ዱማቶያ። <verse eid="GAL 4:1"/><verse number="2" style="v" sid="GAL 4:2"/>ዝን ኤ አዳይ ጌዝ ዎዳይ ሄሎዳይስ ኤ ሀዳራ ኤኬዝታይ ኩሸኔ ናግዝታይ ኩሸ የዝዛ። <verse eid="GAL 4:2"/><verse number="3" style="v" sid="GAL 4:3"/>የይ ጋርክ፥ ኑኒ አያና ባዝስ ዱደ ማቂ የዝ ዎደ አላመ ዎጋስ አይልቴዛ። <verse eid="GAL 4:3"/><verse number="4" style="v" sid="GAL 4:4"/>ዝን ዎዳይ ሄልን ጾሳይ ማቻፕ የልንቴዝ ፋ ናአና ኪቴዛ። ኤዝካ ህገስ አዛዝንቴዛያ ማቄዛ። <verse eid="GAL 4:4"/><verse number="5" style="v" sid="GAL 4:5"/>ኤ የያ ኦዛይ፥ ህገስ ሃርንቲ የዝታ ዎዞዳይስኔ ኑና ፋ ናእታ ኦዳይሲ።<note caller="-" style="x"><char style="xo" closed="false">4:5-7 </char><char style="xt" closed="false"><ref loc="ROM 8:15-17">ኦሮ. 8:15-17</ref></char></note><verse eid="GAL 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 4:6"/>ኑ ጾስ ናእታ ማቄዝ ግሾስ «አቦ፥ ታ አዳዮ» ዬጊ ጼግዝ ፋ ናአይ አያና ኑ ዎዛና ጋንጨ ኪቴዛ። <verse eid="GAL 4:6"/><verse number="7" style="v" sid="GAL 4:7"/>የይ ግሾስ፥ Ꮊይፕ ኔኒ ጾስ ናአፕ አትን አይለ ባያ። ኔኒ ኤ ናአ ማቅኮ፥ ጾሳ ላትዛ አስ ማቅዛ።<verse eid="GAL 4:7"/></para>
  <para style="s1">ጳዉሎሳ ጋላትያ አሳይስ ቆፕዛ ቆፋ</para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8"/>ይ ቲና ጾስ ኤሮዋ ዎደ ጾስ ባዝታይስ አይለ ማቂ ሃርንቴዛ። <verse eid="GAL 4:8"/><verse number="9" style="v" sid="GAL 4:9"/>ዝን Ꮊት ይ ጾስ ኤሬዛ፤ ኡባራካ ጾሳር ኤርንቴዛ። የዝን ፓዛይኮኔ ማዶዋ አላመ ዎግታይኮ ጉየ ዋይዚ ማቄ? ዎ ኤቂ፥ ዋይዚ ኡንትስ አይለ ማቆዳይስ ኮዬ? <verse eid="GAL 4:9"/><verse number="10" style="v" sid="GAL 4:10"/>ዱማ ማቄዝ ጋላስታ፥ አግንታ፥ ዎድታኔ ላይታ ይ ሎእ ቦንችዛ። <verse eid="GAL 4:10"/><verse number="11" style="v" sid="GAL 4:11"/>ታ ይ ጋንጨ ይንትስ ዳቡሬዛይ ጨረ አቶደሻ ግ ታ ያሽቴዛ።<verse eid="GAL 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 4:12"/>ታ እሹን፥ ታ ይ ጋርክ ሀኔዝ ግሾስ ይንትካ ታ ጋርክ ሀኖይታ ግ ይንታን ዎስዛ። ይ ታና አባራካ ቆሄካያ። <verse eid="GAL 4:12"/><verse number="13" style="v" sid="GAL 4:13"/>ታኒ ቲና ሀርግንትታር ይንትስ ዎንግለ ኦዴዛና ይ ኤርዛ። <verse eid="GAL 4:13"/><verse number="14" style="v" sid="GAL 4:14"/>ታ ሀርጋይ ይንትስ ፓጨ ማቅኮካ፥ ይ ታና ሳልንተካያ፤ እጸካያ። ዝን ታና ጾስ ኪታንቾ ዎይ ክርስቶስ የሱሳ ሞክዛይ ጋርክ ሞኬዛ።<verse eid="GAL 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 4:15"/>የዝን፥ የ ይንትስ የዛ ኡፋይሳይ ኡባይ አና Ꮊንጌኔ? ይንትስ ዳንዳእንቴዛኮ፥ ይ ይ ኣፋ ከሲ ታስ እንግዛኮ እጻምዛና ታ ማርካትዛ። <verse eid="GAL 4:15"/><verse number="16" style="v" sid="GAL 4:16"/>የዝን፥ ታ ይንትስ ቱማ ኦዴዝ ግሾስ ይንትስ ሞርከ ማቃረኔ?<verse eid="GAL 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 4:17"/>የ አሳይ ይንታን ፋኮ ማሆዳይስ ኮይዛ፥ ዝን ኡ ቆፋይ ሎኦስ ባያ። ኡ ቆፋይ ይንታን ሻጎዳይስኔ ይ ኡንትስ ቆፖድ ጋርክ ኦዳይሲ። <verse eid="GAL 4:17"/><verse number="18" style="v" sid="GAL 4:18"/>ሎኦ ባዝ ኦዳይስ አሞትኮ ሎኦ፥ ዝን የይ ታ ይንታር የዝ ዎደ ኣዳ ባዝን ኡባ ዎደ ማቆ።<verse eid="GAL 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 4:19"/>ታ ሲቆ ናኡን፥ ክርስቶሳ ይንታል ምስልንቶድ ጋ የሎስ ማች እቅንትዛይ ጋርክ ታ ይ ግሾ ማካ እቅንትዛ። <verse eid="GAL 4:19"/><verse number="20" style="v" sid="GAL 4:20"/>ካሴሳይፕ ታ ቆፋ ላሞዳይስ ኮዬዛዝን ታስ ኤርንታም እጽን ታ መትንቴዛ።<verse eid="GAL 4:20"/></para>
  <para style="s1">አጋርኔ ሳራ ኣዝሶ</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21"/>ህገስ ሃርንቲ የዞዳይስ ኮይዝታዮ፥ አን ታስ ኦዶይታ፤ ህጋይ ዋግዛኮ ይ ኤሮሳ? <verse eid="GAL 4:21"/><verse number="22" style="v" sid="GAL 4:22"/>ጌሻ ማጻፋይ፥ «አፍራመስ ጋንዳትፐኔ ጎዳታትፕ የልንቴዝ ናምኢ ናእታይ የዛ» ዬግዛ።<note caller="-" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="GEN 16:15">መ. 16:15</ref>፤ <ref loc="GEN 21:2">21:2</ref></char></note> <verse eid="GAL 4:22"/><verse number="23" style="v" sid="GAL 4:23"/>ጋንዳቲ ናአይ አስ ናአ የልንትዛይ ጋርክ የልንቴዛ፥ ዝን ጎዳታቲ ናአይ ጾስ ኡፋይሳ ቃላር የልንቴዛ።<verse eid="GAL 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GAL 4:24"/>Ꮊ ማችታይ ናምኢ ጫቅታይስ ኣዝሶ ማቂ ኤክንትዛ። ኡንታፕ ፐታት፥ ሲና ደረላፐ የኤዛና፥ ፋ ናእታ አይለትስ የሌዛ፤ እዛካ አጋሮ። <verse eid="GAL 4:24"/><verse number="25" style="v" sid="GAL 4:25"/>አጋራ አራበ ቢታል የዝ ሲና ደረር ኣዝስንቲ Ꮊት የዝ የሩሳላመ ኣዝዛ። አብስ ጊኮ፥ እዛ ፋ ናእታይራ አይለት የዛ። <verse eid="GAL 4:25"/><verse number="26" style="v" sid="GAL 4:26"/>ዝን ሳሎፕ ማቄዝ የሩሳላመ አይለትር የዞያ፤ እዛ ኑስ ኡባይስ እንዶ። <verse eid="GAL 4:26"/><verse number="27" style="v" sid="GAL 4:27"/>ጽሎ ማጻፋይ፥</para>
  <para style="q1" vid="GAL 4:27">«ቡሽተ፥ የለካ ንቴ ኡፋይቶባ፤</para>
  <para style="q2" vid="GAL 4:27">ቡሽተ እቅንት ኤሮዛኔ እልሶባ።</para>
  <para style="q1" vid="GAL 4:27">አዝናር የዝ ማቻትፕ፥</para>
  <para style="q2" vid="GAL 4:27">አዝኒ ባ ማቻትስ ናእታይ ጋመ» ዬግዛ።<note caller="-" style="x"><char style="xo" closed="false">4:27 </char><char style="xt" closed="false"><ref loc="ISA 54:1">ኢሳ. 54:1</ref></char></note><verse eid="GAL 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GAL 4:28"/>ታ እሹን፥ ይ እሳቃ ጋርክ ጾስ ኡፋይስ ቃላር የልንቴዝ ናእታ። <verse eid="GAL 4:28"/><verse number="29" style="v" sid="GAL 4:29"/>ዝን የ ዎደ አስ ዎጋር የልንቶዳይስ፥ አያና ዎልቃር የልንቴዛና ባይኤዛ። Ꮊይኖካ የይ ጋርከ።<note caller="-" style="x"><char style="xo" closed="false">4:29 </char><char style="xt" closed="false"><ref loc="GEN 21:9">መ. 21:9</ref></char></note> <verse eid="GAL 4:29"/><verse number="30" style="v" sid="GAL 4:30"/>ዝን ጌሻ ማጻፋይ ዋጌ? «ጋንዳቲ ናአይ ጎዳታቲ ናአይራ ዎላ ላቶዋ ግሾ ጋንዳቶ እ ናአይራ ዎላ ከሲ ዳኮባ» ዬግዛ።<note caller="-" style="x"><char style="xo" closed="false">4:30 </char><char style="xt" closed="false"><ref loc="GEN 21:10">መ. 21:10</ref></char></note> <verse eid="GAL 4:30"/><verse number="31" style="v" sid="GAL 4:31"/>የይ ግሾ፥ ታ እሹን፥ ኑኒ ጎዳታቲ ናእታይፕ አትን ጋንዳቲ ናእታ ባያ።<verse eid="GAL 4:31"/></para>
  <chapter eid="GAL 4"/>
  <chapter number="5" style="c" sid="GAL 5"/>
  <para style="s1">ክርስቶሳር የዝ ዋሎት</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1"/>ኑኒ ዋሎትር የዞዳይ ጋርክ ክርስቶሳ ኑና አይለትፕ ከሴዛ። ይኬ፥ ሚንጊ ኤቆይታ፤ ማቂ አይለት ቃምባራይድ ገልፓተ።<verse eid="GAL 5:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 5:2"/>ታ፥ ጳዉሎሳ፥ ግዛ ስኦይታ። ይ «ዶካልንቶ ማድዛ» ግ ይ ዶካልንቶዳይስ ኮይኮ፥ ክርስቶሳ ይንታን አብካ ማዶያ። <verse eid="GAL 5:2"/><verse number="3" style="v" sid="GAL 5:3"/>ዶካልንትዛ ኦንካ ህጋይ ኪትዛ ኡብታ ፖሎዳይስ ቤዝዛና ማሂ ታ ኦድዛ። <verse eid="GAL 5:3"/><verse number="4" style="v" sid="GAL 5:4"/>ህገ ናጊ ጽሎዳይስ ኮይዝታይ፥ ክርስቶሳፕ ሻክንቴዛ፤ ጾስ ኣ ኬሃትይፕ ይ ሃኬዛ። <verse eid="GAL 5:4"/><verse number="5" style="v" sid="GAL 5:5"/>ዝን ኑኒ ጾስ አያና ባጋር አማኖር ጽሎዳይስ ኡፋይሳር ናግዛ። <verse eid="GAL 5:5"/><verse number="6" style="v" sid="GAL 5:6"/>ይኬ፥ ክርስቶስ የሱሳር የዝኮ፥ ሲቆር በንትዝ አማኖፕ አትን ዶካልንትን፥ ዶካልንተካ አትን ኑና አብካ ማዶያ።<verse eid="GAL 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 5:7"/>ቲና ይ ሎኦ ዎጽዛ፥ ዝን Ꮊት ቱማስ አዛዝንታማይ ጋርክ ይንታን ካዬዛይ ኦኖ? <verse eid="GAL 5:7"/><verse number="8" style="v" sid="GAL 5:8"/>Ꮊይ ጋርክ ኢታ ዶሻይ ይንታን ጼጌዝ ጾሳይፕ የኤካያ። <verse eid="GAL 5:8"/><verse number="9" style="v" sid="GAL 5:9"/>የይካ፥ «ጽቃ እርሾ ሙኑቆ ኡባ ደንዛ» ግንትንቲ ጻፍንቴዛይ ጋርክ።<note caller="-" style="x"><char style="xo" closed="false">5:9 </char><char style="xt" closed="false"><ref loc="1CO 5:6">1ቆሮ. 5:6</ref></char></note> <verse eid="GAL 5:9"/><verse number="10" style="v" sid="GAL 5:10"/>ይንትስ ሀራ ቆፋ ባዛይስ ታ ጎዳይል አማንንትዛ። ዝን ይንታን ቡቅዝ ኦንካ ጾሳፕ ፋ ፕርዳ ኤኮዳ።<verse eid="GAL 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 5:11"/>ታ እሹን፥ ታ Ꮊያ ሄሎዳይስ ዶካልንቶ ሳባክዛባዝ ማቅኮ፥ የዝን ታና አብስ ባይኤ? የይ ቱማ ማቄዛኮ ክርስቶሳ ማዝቃላይ ባጋ ታማርሳይ አስስ በ ማቃምዝን። <verse eid="GAL 5:11"/><verse number="12" style="v" sid="GAL 5:12"/>ይንታን ቡቅዝታይ ፋና ዶካል ኣዳ ባዝን ፋና ቃራትዛኮካ ታ ዶስዛ።<verse eid="GAL 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 5:13"/>ታ እሹን፥ ይ ዋሎ የዞዳይስ ጼግንቴዛ። ማቆዝን፥ ይ ዋሎትይ አሾ አሞት ፖሎዳይስ ይንትስ ሳንከ ማቅፐ፤ የይፕ ኣ ፐታይ ፐታ ሲቆር ማዶይታ። <verse eid="GAL 5:13"/><verse number="14" style="v" sid="GAL 5:14"/>ህገ ኡባይ፥ «አስ ነ ኡባይ ጋርክ ቃባ» ዬግዝ ፐቲ ቃላር አጭንትዛ።<note caller="-" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="LEV 19:18">ለዊ. 19:18</ref></char></note> <verse eid="GAL 5:14"/><verse number="15" style="v" sid="GAL 5:15"/>ዝን ይ ፐታይ ፐታይር ሳጽንትዝባዝኔ ሚንትንትዝባዝ ማቅኮ፥ ይ ዎል ዉርሳማይ ጋርክ ናግንቶይታ።<verse eid="GAL 5:15"/></para>
  <para style="s1">አያና የስኔ አሾ የስ</para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16"/>ይኬ፥ ታ ይንትስ ኦድዛ፤ አያናር የዞይታ፤ ይ አሾ አሞ የሻ ፖልፓተ። <verse eid="GAL 5:16"/><verse number="17" style="v" sid="GAL 5:17"/>አሾ አሞ አያና አሞር ሞርከ፤ ማ አያና አማይካ አሾ አሞራ ሞርከ። ኡንቲ ፐታይ ፐታይር እጽንትዛ ግሾስ ይ ዶስዛባዝ ኦዳይስ ዳንዳኦያ።<note caller="-" style="x"><char style="xo" closed="false">5:17 </char><char style="xt" closed="false"><ref loc="ROM 7:15-23">ኦሮ. 7:15-23</ref></char></note> <verse eid="GAL 5:17"/><verse number="18" style="v" sid="GAL 5:18"/>ዝን አያናይ ይንታን ካልዛ ባዝ ማቅኮ ህገ ይንታን ሃሮያ።<verse eid="GAL 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 5:19"/>አሾ ኦስታይ ኤርንቴዝታ፤ ኡንትካ፥ ላግተ፥ ቱና ኦ፥ ቃይጸ፥ <verse eid="GAL 5:19"/><verse number="20" style="v" sid="GAL 5:20"/>ኤቃስ ጎይኖ፥ ቢታ፥ ሞርክንቶ፥ ካቺ፥ ቅናተ፥ ጫሺ፥ ፋና ዶስ፥ ሻክንቶ፥ ኢታ ቶባ <verse eid="GAL 5:20"/><verse number="21" style="v" sid="GAL 5:21"/>ገነ፥ ማ፥ የኔ የይትታ ኣዝዝታ። ቲና ታ ይንትስ ኦዴዛይ ጋርክ Ꮊተካ ታ ይንትስ ኦድዛ። Ꮊይ ጋርክ ባዝታ ኦዝታይ ጾስ ካተት ላቶያ።<verse eid="GAL 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GAL 5:22"/>ዝን አያና ኣፋይ፥ ሲቆ፥ ኡፋይሲ፥ ሳሮት፥ ምን፥ ሃዮት፥ ሎኦት፥ አማኖ፥ <verse eid="GAL 5:22"/><verse number="23" style="v" sid="GAL 5:23"/>አሽከት፥ ፋና ሃሮ። Ꮊይ ጋርክ ባዝታ እጽዛ ህገ ባያ።<verse eid="GAL 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GAL 5:24"/>ክርስቶሳ የሱሳስ ማቄዝታይ ፋ አሾ ኤ ኢታ ቆፋይራኔ ኤ አማይራ ዎላ ማዝቃለል አፋ ሶቴዛ። <verse eid="GAL 5:24"/><verse number="25" style="v" sid="GAL 5:25"/>ኑ አያናር የዛ ባዝ ማቅኮ፥ ኑና አያናይ ካል። <verse eid="GAL 5:25"/><verse number="26" style="v" sid="GAL 5:26"/>አን ፐታይ ፐታ ይሎስታራኔ ቅናትታር ጨር ጬቅንት ዎላ አሾዳ።<verse eid="GAL 5:26"/></para>
  <chapter eid="GAL 5"/>
  <chapter number="6" style="c" sid="GAL 6"/>
  <para style="s1">ዎላ ማድንቶይታ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1"/>ታ እሹን፥ አሲ ባልንቲ ቡታ ባዝ ኦኮ፥ አያናር የዝ ይ የ አ አሽከትር ሉልሶይታ። ዝን ኔኒ የይ ጋርከ ባዛር ፓጭንታም ጋርክ ነና ናጎባ። <verse eid="GAL 6:1"/><verse number="2" style="v" sid="GAL 6:2"/>ፐታይ Ꮊንካይ ዴጾ ቶፋ ቶኮ፥ ዬዝኮ ክርስቶሳ ህጋ ይ ፖልዛ። <verse eid="GAL 6:2"/><verse number="3" style="v" sid="GAL 6:3"/>ፐቲ አሲ አኮካ ባዝን፥ ፋና Ꮊንክታይፕ ሎኦ ግ ቆፕኮ፥ ኤ ፋና ዶሽዛ። <verse eid="GAL 6:3"/><verse number="4" style="v" sid="GAL 6:4"/>ዝን ፐቲ ፐቲ አሲ ፋ ኦሳ ፋጮ። የይፕ ጉየ፥ ሀራ አሳር ፋና ቄልዛ አሺ ፓስ ጬቅንትዛ ባዝ ደንግዛ። <verse eid="GAL 6:4"/><verse number="5" style="v" sid="GAL 6:5"/>ፐቲ ፐቲ አሲ ፋ ቶፎ ፓስ ቶኮዳይስ ቤዝዛ።<verse eid="GAL 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 6:6"/>ጾስ ቃላ ታማርዛ ኦንካ ሎኦ ባዝ ኡባ ፋ አስታማራይራ ግሽንትዛ።<verse eid="GAL 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 6:7"/>ይ፥ ይንታን ባልፓተ። አሲ ፋ ዘሬዛኖ ማሂ ማጽዛ ግሾ ጾሳ ዶሽፓተ። <verse eid="GAL 6:7"/><verse number="8" style="v" sid="GAL 6:8"/>ፋ አሾ አሞ ኩንዳይስ ዘርዝ ኦንካ፥ ፋ አሾ እናፕ Ꮊይቆ ማጾዳ። ዝን አያና ኡፋይሶዳይስ ዘርዝ ኦንካ አያናፕ መና ደኦ ማጾዳ። <verse eid="GAL 6:8"/><verse number="9" style="v" sid="GAL 6:9"/>አን ሎኦ ኦሶ ኦዳይስ አዛልዛና ዎላ አሾዳ። ኑኒ አዛላም እጽኮ ዎዳይ ሄሌዝ ዎደ ኑ ዘሬዛና ማጾዳ። <verse eid="GAL 6:9"/><verse number="10" style="v" sid="GAL 6:10"/>ኑ ጊጋ ዎደ ደንግኮ፥ አስ ኡባይስ፥ ኣካ አማንዛ አስስ ሎኦ ባዝ ኦዳ።<verse eid="GAL 6:10"/></para>
  <para style="s1">ዉርስ ዞረኔ ሳሮ</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11"/>ታኒ ታ ኩሻይር፥ አብ ጋርክ ዳማ ፕዳለር ይንትስ ጻፌዛኮ ቦኦይታ። <verse eid="GAL 6:11"/><verse number="12" style="v" sid="GAL 6:12"/>አስ ቲና ሎኦ ማቂ በንቶዳይስ ኮይዝ አሳይ ይ ዶካልንቶድ ጋርክ ኮይዛ። ዝን የያ ኡንቲ ኦዛይ፥ ክርስቶሳ ማዝቃለ ግሾ ኡንታን ባይእ ሄላማይ ጋርከ። <verse eid="GAL 6:12"/><verse number="13" style="v" sid="GAL 6:13"/>ኡንቲ ይ ዶካልንታይር ጬቅንቶዳይስ ኮዪ ይንታን ዶካልንቶ ግዛፕ አትን ዶካልንቴዝታይካ ፋ ኡባስ ህገ ናጎያ።<verse eid="GAL 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GAL 6:14"/>ዝን ኑ ጎዳ የሱስ ክርስቶሳ ማዝቃላይፕ አትን ሀራ አላማይ ታስ ሶትንቴዛይኔ ታንካ አላማይስ ሶትንቴዝ ጬቅንታይ ታፕ ሃኮ። <verse eid="GAL 6:14"/><verse number="15" style="v" sid="GAL 6:15"/>ይኬ፥ ዶካልንትን ዶካልንተካ አትን አብካ ማዶያ። ማድዛይ የሱስ ክርስቶሳር ኦሮ መት ማቅ። <verse eid="GAL 6:15"/><verse number="16" style="v" sid="GAL 6:16"/>Ꮊ ዎጋ ካልዛ ኡቢታይስኔ ጾስስ ዎያ ማቄዝ እስራኤለስ ሳሮትኔ ማሮት ማቆ።<verse eid="GAL 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 6:17"/>ታኒ የሱሳስ ሾጭንቴዝ ታ አሻይል የዝ ቤታይ ታ የሱሳስ አይለ ማቄዛና ቤዝዛ ግሾ Ꮊይፕ ገደ ታና ኦንካ ዋይፐ።<verse eid="GAL 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 6:18"/>ታ እሹን፥ ኑ ጎዳ የሱስ ክርስቶሳ ኣ ኬሃትይ ይንታር ማቆ። አምንኤ።<verse eid="GAL 6:18"/></para>
  <chapter eid="GAL 6"/>
</usx>
