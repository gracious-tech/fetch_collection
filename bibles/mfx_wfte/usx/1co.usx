<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1CO" style="id">- Melo New Testament Ethiopic</book>
  <para style="h">1ቆሮንቶሳ</para>
  <para style="toc1">ጳዉሎሳ ቆሮንቶሳ አሳይስ ጻፌዝ ቲና ኪታ</para>
  <para style="toc2">1ቆሮንቶሳ</para>
  <para style="toc3">1ቆሮ.</para>
  <para style="mt1">ጳዉሎሳ ቆሮንቶሳ አሳይስ ጻፌዝ ቲና ኪታ</para>
  <para style="imt">ገሎ</para>
  <para style="ip">ጳዉሎሳ ቆሮንቶሳ አሳይስ ጻፌዝ ቲና ኪታይ ጻፍንቴዛይ፥ ጳዉሎሳ ቆሮንቶሳ ኤሴዝ ዎሳ ኬ አማንዛ አሳይ የሳይላኔ አማናይል አፋ ደንዴዝ መታይስ ማህ እንጎዳይሲ። የ ዎደ ቆሮንቶሳ ካታማይ ቢታል የዝ ዱማ ዱማ አሳይ የዝ ግርኬ ካታማ አካዛ ግዝ ኦሮመ አዉራጃስ ዋና ካታማ። የ ካታምታ ዛልኤር ኤርንቴዝ፥ ዎጋር ምንጌዝ፥ ዱማ ዱማ ኢታ የሲ ዳልጌዛኔ ሀይማኖተ ዳሮትር ኤርንቴዛኖ።</para>
  <para style="ip">ሀዋራይ ሚን ኦዶዳይስ ኮዬዛይ፥ የ ዎሳ ኬቲ ጋንጨ መንቴዝ ሻክንቶ ባጋ፥ ዱማ ዱማ ኢታ የስ ባጋ፥ ላግታ ባጋ፥ ኤኮ ገሎ ባጋ፥ ዎሳ ኬ ዎጋ ባጋ፥ ጌሻ አያና እሞትታይ ባጋኔ Ꮊይቆፐ ደንዶ ባጋ። ዎንግላይ Ꮊ ኦይችታ ዋይዚ ማህዛኮ ሀዋራይ ናግንቲ ኦድዛ።</para>
  <para style="ip">ሲቆ ጾሲ ፋ አሳይስ እንጌዝ ኣ እሞታ ማቄዛና ታጶ ሃይን ሸምፖይ ቆንጭስዛ፤ ማ Ꮊ ሸምፓይ Ꮊ ማጻፋይድ ኡባፕ ኣ ኤርንቴዝ ክፍለ ግንትንቲ ቆፕንትዛ።</para>
  <para style="iot">1 ቆሮንቶሳ ኪታይ አይኬዝ ቆፍታ</para>
  <para style="io1">ገሎ <char style="ior"><ref loc="1CO 1:1-9">1:1-9</ref> </char></para>
  <para style="io1">አማንዛ አሳይ ጋንጨ መንቴዝ ሻክንቶ <char style="ior"><ref loc="1CO 1:10-4:21">1:10—4:21</ref> </char></para>
  <para style="io1">ኢታ ሀኖኔ ካራ አሳይ የስ ዎጋ <char style="ior"><ref loc="1CO 5:1-7:40">5:1—7:40</ref> </char></para>
  <para style="io1">አማንዛ አሳኔ አማኖዋ አሳ <char style="ior"><ref loc="1CO 8:1-11:1">8:1—11:1</ref> </char></para>
  <para style="io1">ዎሳ ኬኔ ጎይኖ ዎጋ <char style="ior"><ref loc="1CO 11:2-14:40">11:2—14:40</ref> </char></para>
  <para style="io1">ክርስቶሳ ደንዶኔ አማንዛ አሳይ ደንዶ <char style="ior"><ref loc="1CO 15:1-58">15:1-58</ref> </char></para>
  <para style="io1">ይሁዳ የዝ መትንቴዝ አማንዛ አሳይስ ማዴ <char style="ior"><ref loc="1CO 16:1-4">16:1-4</ref> </char></para>
  <para style="io1">ኩስተ ቆፋ <char style="ior"><ref loc="1CO 16:5-24">16:5-24</ref> </char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="1CO 1"/>
  <para style="p">
    <verse number="1" style="v" sid="1CO 1:1"/>ጾስ ሸነር የሱስ ክርስቶሳስ ሀዋረ ማቆዳይስ ጼግንቴዝ ጳዉሎሳኔ፥ ኑ እሻ ሶስተናሳ፥ <verse eid="1CO 1:1"/><verse number="2" style="v" sid="1CO 1:2"/>ቆሮንቶሳ የዝ ጾስ ዎሳ ኬስ፥ የሱስ ክርስቶሳር ጌዤዝታኔ ጌሽ ማቆዳይ ጋርክ ጼግንቴዝታይስ፤ ማ ኡንትስኔ ኑስ ጎድ ማቄዝ ኑ ጎዳ የሱስ ክርስቶሳ ሱን ኡባ አቆ ጼግዝ ኡባይስ፤<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="ACT 18:1">ሀዋ. ኦ. 18:1</ref></char></note><verse eid="1CO 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 1:3"/>ጾስ፥ ኑ አዳይፐኔ ኑ ጎዳ የሱስ ክርስቶሳፕ ኣ ኬሄትኔ ሳሮት ይንትስ ማቆ።<verse eid="1CO 1:3"/></para>
  <para style="s1">ጳዉሎሳ ጾሳ ጋላትዛ</para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 1:4"/>ጾሳይ ክርስቶሳ የሱሳ ባጋር ይንትስ እንጌዝ ኣ ኬሃትይ ግሾስ ታኒ ኡባ ዎደ ጾሳ ጋላትዛ። <verse eid="1CO 1:4"/><verse number="5" style="v" sid="1CO 1:5"/>ኤዛይድ ኦዳራኔ ኤራት ኡባይር ይ ዱርቴዛ። <verse eid="1CO 1:5"/><verse number="6" style="v" sid="1CO 1:6"/>ታኒ ክርስቶሳ ባጋ ማርካቴዛይ ቱማ ማቄዛይ ይንታል ሚንጌዛ። <verse eid="1CO 1:6"/><verse number="7" style="v" sid="1CO 1:7"/>የይ ግሾስ፥ ይ ኑ ጎዳ የሱስ ክርስቶሳ ይእ ናግታር የዝን፥ አባ አያና እሞካ ይንትስ ፓጨና። <verse eid="1CO 1:7"/><verse number="8" style="v" sid="1CO 1:8"/>ኑ ጎዳ የሱስ ክርስቶሳ ማቅዝ ዎደ ይ ቦሮኔ ቦርሶ ባይ ዉርስ ሄሎዳይስ ይንታን ሚን ናጎዳ። <verse eid="1CO 1:8"/><verse number="9" style="v" sid="1CO 1:9"/>ፋ ናአ፥ ኑ ጎዳ የሱስ ክርስቶሳር ፐትፐተይ የዞዳይ ጋርክ ይንታን ጼጌዝ ጾሳይ አማንንትዛያ።<verse eid="1CO 1:9"/></para>
  <para style="s1">ዎሳ ኬ የዝ ሻክንቶ</para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 1:10"/>ታ እሹን፥ ይ ጋንጨ ሻክንቶ የዛማይ ጋርክ ይ ፐቲ ዎዛናራኔ ፐቲ ቆፋር ፐቶ ማቂ፥ የዞድ ጋርክ ኑ ጎዳ የሱስ ክርስቶሳ ሱንይር ታ ይንታን ዎስዛ። <verse eid="1CO 1:10"/><verse number="11" style="v" sid="1CO 1:11"/>ታ እሹን፥ ቀሎኤ ካራ አሳይ ይ ጋንጨ እጾ የዛና ታስ ኦዴዛ። <verse eid="1CO 1:11"/><verse number="12" style="v" sid="1CO 1:12"/>ታ ግዛይ ይንታፕ ፐታይ ፐታይ፥ «ታኒ ጳዉሎሳስ፤ ታኒ አጵሎሳስ፤ ታኒ ጵጽሮሳስ፤ ታኒ ክርስቶሳስ» ዬግዛ።<note caller="-" style="x"><char style="xo" closed="false">1:12 </char><char style="xt" closed="false"><ref loc="ACT 18:24">ሀዋ. ኦ. 18:24</ref></char></note> <verse eid="1CO 1:12"/><verse number="13" style="v" sid="1CO 1:13"/>ክርስቶሳ ሻክንቴኔ? ይ ግሾስ ማዝቃለል አፋ ሶትንቴዛይ ጳዉሎሳኔ? ዎይ ይ ጳዉሎሳ ሱንይር ጻማቅንቴነኔ?<verse eid="1CO 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 1:14"/>ታኒ ቃርስጶሳኔ ጋዮሳፕ አትን ይንትፕ ኦናካ ጻማቀካ ግሾስ ጾሳ ጋላትዛ።<note caller="-" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="ACT 18:8">ሀዋ. ኦ. 18:8</ref>፤ <ref loc="ACT 19:29">ሀዋ. ኦ. 19:29</ref>፤ <ref loc="ROM 16:23">ኦሮ. 16:23</ref></char></note> <verse eid="1CO 1:14"/><verse number="15" style="v" sid="1CO 1:15"/>የይ ግሾስ፥ ኦንካ ይንታን ታ ሱንይር ጻማቅንቴዛ ጎዳይስ ዳንዳኦያ። [ <verse eid="1CO 1:15"/><verse number="16" style="v" sid="1CO 1:16"/>ማ ኢስጼፋኖሳ ካራ አሳካ ታ ጻማቄዛ፥ ዝን ሀራ ኦና ጻማቄዛኮ ታስ ቆፕንቶያ።]<note caller="-" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="1CO 16:15">1ቆሮ. 16:15</ref></char></note> <verse eid="1CO 1:16"/><verse number="17" style="v" sid="1CO 1:17"/>ክርስቶሳ ታና ኪቴዛይ ዎንግለ ኦዶዳይ ጋርከፕ አትን ጻማቆዳይ ጋርክ ባያ። ክርስቶሳ ማዝቃለል አፋ Ꮊይቄዛይ ጨረ ማቃም ጋርክ ታኒ አስ ኤጨት ቃላር ባያ።<verse eid="1CO 1:17"/></para>
  <para style="s1">ክርስቶሳ ጾስ ዎልቃኔ ኤጨት</para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18"/>ክርስቶሳ ማዝቃለል አፋ Ꮊይቄዛና ኦድዛ ቃላይ ብዝታይስ ቦዞት፥ ዝን ኑስ አትዝታይስ ጾስ ዎልቃ። <verse eid="1CO 1:18"/><verse number="19" style="v" sid="1CO 1:19"/>ጌሻ ማጻፋይድ፥</para>
  <para style="q1" vid="1CO 1:19">«ታኒ ኤጭታይ ኤጨት ብሶዳ፤</para>
  <para style="q2" vid="1CO 1:19">አካካንችታይ አካካ ባልዳ»</para>
  <para style="m" vid="1CO 1:19">ዬግዛ።<note caller="-" style="x"><char style="xo" closed="false">1:19 </char><char style="xt" closed="false"><ref loc="ISA 29:14">ኢሳ. 29:14</ref></char></note><verse eid="1CO 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 1:20"/>የዝን፥ ኤጫ አባ የኔ? ህገ አስታማረ አባ የኔ? ዎይ Ꮊ ሳአ ኤራንቻይ አባ የኔ? ጾሲ Ꮊ ሳአ ኤጨት ኤያት ኦካሳ?<note caller="-" style="x"><char style="xo" closed="false">1:20 </char><char style="xt" closed="false"><ref loc="JOB 12:17">ኢዮ. 12:17</ref>፤ <ref loc="ISA 19:12">ኢሳ. 19:12</ref>፤ <ref loc="ISA 33:18">33:18</ref>፤ <ref loc="ISA 44:25">44:25</ref></char></note><verse eid="1CO 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 1:21"/>Ꮊ ሳአ አሳይ ፋ ኤጨተር ጾሳ ኤራማይ ጋርክ ጾሲ ፋ ኤጨትር ካይ፥ ቦዛትር ፓይድንትዛ፥ ኑኒ ኦድዛ ቃላይድ አማንዝታ አሾዳይስ ጾሳ ሸነ ማቄዛ። <verse eid="1CO 1:21"/><verse number="22" style="v" sid="1CO 1:22"/>አይሁድታይ ማላታ በአዳይስ ኮይዛ፤ ማ ግርክታይ ኤጨት ኮይዛ። <verse eid="1CO 1:22"/><verse number="23" style="v" sid="1CO 1:23"/>ዝን ኑኒ ማዝቃለል አፋ ሶትንቴዝ ክርስቶሳ ሳባክዛ። የይ አይሁድታይስ በ፤ ማ ግርክታይስ ቦዘት። <verse eid="1CO 1:23"/><verse number="24" style="v" sid="1CO 1:24"/>ዝን ጾሳይ ጼጌዝታይስ፥ አይሁደ ማቅን፥ ግርኬ ማቅን ክርስቶሳ ጾስ ዎልቃኔ ኤ ኤጨት። <verse eid="1CO 1:24"/><verse number="25" style="v" sid="1CO 1:25"/>ጾሳ ቦዘትይ አስ ኤጨትይፕ ኣዛ፤ ማ ጾስ ዳቡራይ አስ ምኖትይፕ ሚንግዛ።<verse eid="1CO 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 1:26"/>ይኬ፥ ታ እሹን፥ ጾሳይ ይንታን ጼጎዳር ይ አብ ጋርክ አስዛኮ ቆፖይታ። አስ ቆፋር ይ ጋንጨ ጋምታይ ኤጭታይ፥ ዎልቃምታይኔ ቃ ኮችታይ ባያ። <verse eid="1CO 1:26"/><verse number="27" style="v" sid="1CO 1:27"/>ዝን ጾሳይ ኤጭታ ዬላዳይስ አላመል የዝ ቦዝታ ዶሬዛ፤ ማ ምንታ ዬላዳይስ አላመል የዝ ዳቡሬዝታ ዶሬዛ። <verse eid="1CO 1:27"/><verse number="28" style="v" sid="1CO 1:28"/>ጾሳይ Ꮊ አላመል ግታ ግንትንቴዝባዝ ብሶዳይስ፥ Ꮊ ሳአ ካዉዤዝባዝ፥ እጽንቴዝባዝኔ ፓዋባዝ ዶሬዛ። <verse eid="1CO 1:28"/><verse number="29" style="v" sid="1CO 1:29"/>ኦንካ ጾስ ቲና ጬቅንታማይ ጋርክ የያ ኦዛ። <verse eid="1CO 1:29"/><verse number="30" style="v" sid="1CO 1:30"/>ዝን ጾሳይ ይንትስ ክርስቶሳ የሱሳር ፐትፐተር የዞድ ጋርክ ኦዛ። ኤ ኑስ ጾሳፕ ኤጨት፥ ጽሎት፥ ጌሸትኔ ዋሎት ማቄዛ። <verse eid="1CO 1:30"/><verse number="31" style="v" sid="1CO 1:31"/>የይ ግሾስ፥ ጌሻ ማጻፋይድ፥ «ጬቅንትዛ ኦንካ ጎዳይል ጬቆ» ዬግዛ።<note caller="-" style="x"><char style="xo" closed="false">1:31 </char><char style="xt" closed="false"><ref loc="JER 9:24">ኤርም. 9:24</ref></char></note><verse eid="1CO 1:31"/></para>
  <chapter eid="1CO 1"/>
  <chapter number="2" style="c" sid="1CO 2"/>
  <para style="s1">ሶትንቴዝ ክርስቶሳ ባጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1"/>ታ እሹን፥ ታኒ ቲና ጾሳ ቃላ ይንትስ ኦድታታር የኤዝ ዎደ ዶና ቢላሞትራኔ ኤጨትር የኤካያ። <verse eid="1CO 2:1"/><verse number="2" style="v" sid="1CO 2:2"/>ታኒ ይንታር የዛ ዎደ ማዝቃለል አፋ ሶትንቴዝ የሱስ ክርስቶሳፕ አትን ሀራ ባዝ ኤራም ግ ታ ሙርቴዛ። <verse eid="1CO 2:2"/><verse number="3" style="v" sid="1CO 2:3"/>ታ ይንታር የዝ ዎደ ዳቡራር፥ ያሻራኔ ኩኩርሳር የዛ።<note caller="-" style="x"><char style="xo" closed="false">2:3 </char><char style="xt" closed="false"><ref loc="ACT 18:9">ሀዋ. ኦ. 18:9</ref></char></note> <verse eid="1CO 2:3"/><verse number="4" style="v" sid="1CO 2:4"/>ታ ኪታኔ ታ ትምርታ ዶና ቢላሞትራኔ ኤጨትር ባዝን ጌሻ አያና ዎልቃ ቆንጭስራ። <verse eid="1CO 2:4"/><verse number="5" style="v" sid="1CO 2:5"/>የይካ፥ ይ አማናይ ጾሳ ዎልቃይራፕ አትን አስ ኤጨትል ካታማይ ጋርከሲ።<verse eid="1CO 2:5"/></para>
  <para style="s1">ጾስ ኤጨት</para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6"/>አያና ደኦር ድጬዝታይስ ኑኒ ኤጨት ቃላር ኦድዛ። ዝን Ꮊ ኤጨትይ፥ Ꮊ ሳአ ኤጨት ዎይ ቦስ የዝ Ꮊ ሳአ ሀርዝታይ ኤጨት ባያ። <verse eid="1CO 2:6"/><verse number="7" style="v" sid="1CO 2:7"/>ዝን ኑኒ ኦድዛ ኤጨትይ፥ ጋመ ዎደፕ ቲና ጾሳይ ኑ ቦንቻይስ ጊግሴዛኔ ጌማ የዝ ጹራ ኤጨት። <verse eid="1CO 2:7"/><verse number="8" style="v" sid="1CO 2:8"/>Ꮊ ሳአ ሀርዝታይፕ ፐታካ Ꮊ ኤጨት ኤረካያ። ኡንቲ ኤሬዝባዝ ማቄዛኮ፥ ቦንቾ ጎዳ ማዝቃለል አፋ ሶታምዝን። <verse eid="1CO 2:8"/><verse number="9" style="v" sid="1CO 2:9"/>ዝን ጌሻ ማጻፋይድ፥</para>
  <para style="q1" vid="1CO 2:9">«ኣፈ በኤካ ባዝ፥</para>
  <para style="q2" vid="1CO 2:9">ሀየ ስኤካባዝ፥</para>
  <para style="q2" vid="1CO 2:9">ዎዝና ቆፐካባዝ፥</para>
  <para style="q2" vid="1CO 2:9">ጾሳይ ፋ ዶስዝታይስ ጊግሴዛ» ዬግዛ።<note caller="-" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="ISA 64:4">ኢሳ. 64:4</ref></char></note><verse eid="1CO 2:9"/></para>
  <para style="m">
    <verse number="10" style="v" sid="1CO 2:10"/>ጾሳይ ፋ ጹራ ፋ አያና ባጋር ኑስ ቆንጭሴዛ። ጌሻ አያናይ ሀራ አቶዝን ጌሜዝ ጾስ ጹራ ኡባ ፕላግዛ። <verse eid="1CO 2:10"/><verse number="11" style="v" sid="1CO 2:11"/>አስ ጋንጨ የዝ አስ አያናፕ አትን አስባዝ ኦካ ኤሮያ። የይ ጋርከካ፥ ጾስ ባዝ ጾስ አያናፕ አትን ኦካ ኤሮያ። <verse eid="1CO 2:11"/><verse number="12" style="v" sid="1CO 2:12"/>ጾሳይ ኑስ ጨረ እንጌዝባዝ ኑ ኤሮዳይ ጋርክ ጾሳ አያና ኤኬዛፕ አትን Ꮊ ሳአ አያና ኤከካያ።<verse eid="1CO 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 2:13"/>ኑኒ አያና ባዝ፥ አያና አሳይስ አስ ኤጨትር ባዝን ጾስ አያናይ እንግዛ ኤጨትር ታማርስዛ። <verse eid="1CO 2:13"/><verse number="14" style="v" sid="1CO 2:14"/>ዝን ጌሻ አያና ባ አስ ጾስ አያና እሞትታ ኤካሚ። የይ ኤስ ቦዘት፤ ኡባይ ጌሻ አያናር ፕላግንትዝ ግሾስ ኤ ኤሮዳይስ ዳንዳኦያ። <verse eid="1CO 2:14"/><verse number="15" style="v" sid="1CO 2:15"/>ዝን ጌሻ አያና የዝ አሲ ኡባ ባዝ ፕላግዛ፥ ዝን ኤዛ ኦካ ፕላጎያ። <verse eid="1CO 2:15"/><verse number="16" style="v" sid="1CO 2:16"/>ጌሻ ማጻፋይድ፥</para>
  <para style="q1" vid="1CO 2:16">«ጎዳ ዎዝና ኤርዛይ ኦኖ?</para>
  <para style="q2" vid="1CO 2:16">ኤዛ ዞሮዳይስ ዳንዳእዛይ ኦኖ?»</para>
  <para style="m" vid="1CO 2:16">ግንትንቲ ጻፍንቴዛይ ጋርከ። ኑስ ክርስቶሳ ዎዝና የዛ።<note caller="-" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="ISA 40:13">ኢሳ. 40:13</ref></char></note><verse eid="1CO 2:16"/></para>
  <chapter eid="1CO 2"/>
  <chapter number="3" style="c" sid="1CO 3"/>
  <para style="s1">ቆሮንቶሳ ዎሳ ኬ መንቴዝ ሻኮት</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1"/>ታ እሹን፥ ይ አሾ አስኔ ክርስቶሳር ሀጋ ኦቼካ ዱደ ናአ ጋርክ የዝ ግሾስ ታኒ አያና ባዝ ይንትስ ኦዶዳይስ ዳንዳኤካያ። <verse eid="1CO 3:1"/><verse number="2" style="v" sid="1CO 3:2"/>ይ ሚን ካ ማዳይስ ዳንዳኤካ ግሾስ ታኒ ይንታን ማ ፓኬዛ፤ Ꮊተካ ይ ዳንዳኤካያ።<note caller="-" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="HEB 5:12-13">እብራ. 5:12-13</ref></char></note> <verse eid="1CO 3:2"/><verse number="3" style="v" sid="1CO 3:3"/>Ꮊተካ ይ አማኖዋ አስ ጋርክ የዛ። ይ ጋንጨ የዝ ቅናታይኔ ዎል እጻይ አማኖዋ አስ ጋርክ የዛና ኤርሶሳ? ይ አማኖዋ አስ ጋርክ ሀንዛ። <verse eid="1CO 3:3"/><verse number="4" style="v" sid="1CO 3:4"/>ይንታፕ ፐታይ፥ «ታኒ ጳዉሎሳስ» ሀራይ ማ፥ «ታኒ አጵሎሳስ» ጊኮ፥ አማኖዋ አስ ጋርክ ባሳኔ?<note caller="-" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="1CO 1:12">1ቆሮ. 1:12</ref></char></note><verse eid="1CO 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 3:5"/>የዝን፥ አጵሎሳ አባ? ጳዉሎሳ አባ? ኑኒ ይንታን አማንዝ ጾስ ኦሳንችታ። ጾሳይ ፐታይስ ፐታይስ እንጌዝ ኦሳይ ጋርክ ኦዛ ኦሳንችታ ባሳኔ? <verse eid="1CO 3:5"/><verse number="6" style="v" sid="1CO 3:6"/>ታ ቱኬዛ፤ አጵሎሳ ሃ ኡሼዛ፥ ዝን ድቼዛይ ጾሰ።<note caller="-" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="ACT 18:4-11">ሀዋ. ኦ. 18:4-11</ref>፥ <ref loc="ACT 18:24-28">24-28</ref></char></note> <verse eid="1CO 3:6"/><verse number="7" style="v" sid="1CO 3:7"/>የይ ግሾስ፥ ድቼዝ ጾሳይፕ አትን ቱክዛይካ ሃ ኡሽዛይካ አኮካ ባያ። <verse eid="1CO 3:7"/><verse number="8" style="v" sid="1CO 3:8"/>ቱክኔ ሃ ኡሾ ዎል ጋርከ፥ ዝን ፐታይ ፐታይ ፋ ኦሳይ ጋርክ ጾሳይ እንግዛ ዎይታ ኤኮዳ። <verse eid="1CO 3:8"/><verse number="9" style="v" sid="1CO 3:9"/>ኑኒ ፐትፕ ጾሳይስ ኦዛ ኤዝ ኦሳንችታ ማቄዝ ግሾስ ይ ጾስ ኦሶ ጋደ፤ ጾስ ኬ። <verse eid="1CO 3:9"/><verse number="10" style="v" sid="1CO 3:10"/>ጾሳይ ታስ እንጌዝ ኣ ኬሃትይ ጋርክ ሂላንቾ አናጸ ጋርክ ባሶ ባሴዛ። ሀራይ ኤዛል አፋ ኬጽዛ። ዝን ኤዛል አፋ ኬጽዛ ኦንካ ዋይዚ ኬጽዛኮ፥ ፋሳ ናግንቶ። <verse eid="1CO 3:10"/><verse number="11" style="v" sid="1CO 3:11"/>ፐቲ ቶኬ ባስንቴዝ ባሳይፕ ሀራ ባሶ ባሶዳይስ ኦንካ ዳንዳኦያ። የ ባሳይካ የሱስ ክርስቶሳ። <verse eid="1CO 3:11"/><verse number="12" style="v" sid="1CO 3:12"/>ዝን Ꮊ ባሳይል አፋ ኦንካ ዎርቃር ዎይ ብራር ማቅን፥ አልኦ ሹቻር ዎይ ምር ማቅን፥ ማታር ዎይ ሀዉለር ኬጽኮ፥ <verse eid="1CO 3:12"/><verse number="13" style="v" sid="1CO 3:13"/>ፐቲ ፐቲ አስ የ ባሳይል አፋ አባር ኬጼዛኮ ፕርዳ ጋላስ ታማር ፓጭንት ኤርንቶዳ። <verse eid="1CO 3:13"/><verse number="14" style="v" sid="1CO 3:14"/>ኦንካ የ ባሳይል አፋ ኬጼዝ ኬይ ታማር ጹግንተካ አትኮ፥ ፋ ዎይታ ኤኮዳ። <verse eid="1CO 3:14"/><verse number="15" style="v" sid="1CO 3:15"/>ዝን ኦ ኦሶይካ ታማር ጹግንትኮ፥ የ አይስ ዎይቶ ባያ። ሀኖ ዝን፥ ኤ ፋ ኦማስ ታማፕ ቡቲ ከዜዝ አስ ጋርክ አቶዳ።<verse eid="1CO 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 3:16"/>ይ ጾስ ኬ ማቄዛኔ ጾስ አያናይ ይንታራ የዛና ኤረካሳ?<note caller="-" style="x"><char style="xo" closed="false">3:16 </char><char style="xt" closed="false"><ref loc="1CO 6:19">1ቆሮ. 6:19</ref>፤ <ref loc="2CO 6:16">2ቆሮ. 6:16</ref></char></note> <verse eid="1CO 3:16"/><verse number="17" style="v" sid="1CO 3:17"/>ኦንካ ጾስ ኬ ላልኮ፥ ጾስካ ኤዛ ላሎዳ። ጾስ ኬይ ጌሺ፤ የ ኬይካ ይንታና።<verse eid="1CO 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 3:18"/>ኦንካ ፋና ዶሽፐ። Ꮊ ሳአ ኤጨተር ፋና ኤጫ ኡዲ ኤክዝ ኦንካ ጾስ ቲና ኤጫ ማቆዳይስ ቦዞ ማቆ። <verse eid="1CO 3:18"/><verse number="19" style="v" sid="1CO 3:19"/>Ꮊ ሳአ ኤጫትይ ጾስ ቲና ቦዘት። ጌሻ ማጻፋይድ፥</para>
  <para style="q1" vid="1CO 3:19">«ጾሲ ኤጭታ ኡ ገነ ቆፋይር አይኮዳ» ዬግንቴዛ።<note caller="-" style="x"><char style="xo" closed="false">3:19 </char><char style="xt" closed="false"><ref loc="JOB 5:13">ኢዮ. 5:13</ref></char></note><verse eid="1CO 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="1CO 3:20"/>ማ፥ «ኤጭታይ ቆፋይ ማዶዋባዝ ማቄዛና ጎዳይ ኤርዛ»</para>
  <para style="m" vid="1CO 3:20">ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">3:20 </char><char style="xt" closed="false"><ref loc="PSA 94:11">ማዝ. 94:11</ref></char></note><verse eid="1CO 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 3:21"/>የይ ግሾስ፥ ኡባይ ይንትስ ማቄዝ ግሾስ ኦንካ አሳል ጬቅንትፕ። <verse eid="1CO 3:21"/><verse number="22" style="v" sid="1CO 3:22"/>ጳዉሎሳ ማቆ፥ አጵሎሳኔ ጵጽሮሳ ማቆ፥ Ꮊ አላማ ማቆ፥ ደኦ ማቆ፥ Ꮊይቆ ማቆ፥ Ꮊት የዛያ ማቅን፥ ቲናፕ የኦድ ኡባይ ይንትሲ። <verse eid="1CO 3:22"/><verse number="23" style="v" sid="1CO 3:23"/>ይ ክርስቶሳሲ፤ ክርስቶሳካ ጾስሲ።<verse eid="1CO 3:23"/></para>
  <chapter eid="1CO 3"/>
  <chapter number="4" style="c" sid="1CO 4"/>
  <para style="s1">ክርስቶሳ ሀዋርታ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1"/>አሳይ ኑና ክርስቶሳ አይለ ጾስ ጹረ ቆንጭሶዳይስ ሀዳራ እንግንቴዝ አስ ጋርክ ኡዲ ቆፖ። <verse eid="1CO 4:1"/><verse number="2" style="v" sid="1CO 4:2"/>የ ሀዳራ ኤኬዝ አስታይ ፋ ጎዳይስ አማንንቴዝታ ማቆዳይስ ቤዝዛ። <verse eid="1CO 4:2"/><verse number="3" style="v" sid="1CO 4:3"/>ዝን ይንቲ ዎይ ሀራይ ታና ፕርድኮ፥ ታስ አኮካ ባያ። ሀራይ አቶ፥ ታካ ታል አፋ ፕርዳሚ። <verse eid="1CO 4:3"/><verse number="4" style="v" sid="1CO 4:4"/>ታ ኤርዛይ ጋርክ ማቅኮ ታ ካሃይ ካጮያ፥ የይካ ታ ፎሎ ጌሽ ማቄዛና ቤዞያ። ታል አፋ ፕርዶዳይ ጎዳይ ኣዳ። <verse eid="1CO 4:4"/><verse number="5" style="v" sid="1CO 4:5"/>የይ ግሾስ፥ ዎደ ሄለካዝን፥ ጎዳይ የኦዳይፕ ቲና ኦላካ ፕርድፓተ። ኤ ማ ጌንጌዝ ጹራ ፖኦ ከሶዳ፤ አስ ዎዛና ቆስንቴዝ ቆፋ ቆንጭሶዳ። የ ዎደ ፐታይ ፐታይ ጾሳይፕ ጋላታ ኤኮዳ።<verse eid="1CO 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 4:6"/>ታ እሹን፥ ይ ግሾስ ግ አጵሎሳናኔ ታና ኣዝሶ ኡዲ ይንትስ ኦዴዛ። የያ ታ ኦዛይ፥ «ጻፍንቴዛይፕ ኣፐ» ዬጊ ዞርዛና ይ ኑፕ ታማሮዳይ ጋርከሲ። የይ ግሾስ፥ ኦንካ ፐታ ጋይርንቶር Ꮊንካ ካዳይስ ቤዞያ። <verse eid="1CO 4:6"/><verse number="7" style="v" sid="1CO 4:7"/>ነ Ꮊንክታይፕ አባር ኣኔ? ኔኒ ኤከካባዝ አቢ የኔ? የዝን፥ ኔኒ ኤኬዝባዝ ሀራ አሳይፕ ኤኬዝ ማቅኮ፥ ኤከካ አስ ጋርክ አብስ ጬቅንትኔ?<verse eid="1CO 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 4:8"/>Ꮊት ይንትስ ቤዝዛ ባዝ ኡባ ይ ኤኬዛ። Ꮊት ይ ዱርቴዛ። ኑ ባይ ይ ኣዳ ካዉቴዛ። ይ ቱማ ካዉቴዝባዝ ማቄዛኮ፥ ኑካ ይንታር ካዉቶዳዝን። <verse eid="1CO 4:8"/><verse number="9" style="v" sid="1CO 4:9"/>ጾሳይ ኑና ሀዋርታ፥ Ꮊይቆስ ፕርድንቴዝ አስ ጋርክ አስ ኡባፕ ኑና ጉየ ኣዛ ታስ ኣዝዛ። ኑኒ Ꮊ አላማይስ፥ ኪታንችታይስኔ አሳይስ ካስባዝ ማቄዛ።<verse eid="1CO 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 4:10"/>ኑኒ ክርስቶሳ ግሾስ ቦዞ ማቄዛ፥ ዝን ይ ክርስቶሳር ኤጭታ ማቄዛ። ኑኒ ዳቡራ፥ ዝን ይ ሚን ማቄዛ። ይ ቦንችንቴዛ፥ ዝን ኑኒ ቶሽንቴዛ። <verse eid="1CO 4:10"/><verse number="11" style="v" sid="1CO 4:11"/>Ꮊኖ ሄሎዳይስ ኑ ናይንትዛ፥ ሳምንትዛ፥ ካሎትዛ፥ Ꮊንትዛ፤ የዞድ ካምፓ ብን ካእንትዛ። <verse eid="1CO 4:11"/><verse number="12" style="v" sid="1CO 4:12"/>ኑኒ ኑ ኩሸ Ꮊንታር አቆድ ግ ዳቡርዛ። ኑና አሲ ባዶዳር ኑ አንጅዛ፤ ኑና ባይእዳር ኑ ጋርዥዛ።<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="ACT 18:3">ሀዋ. ኦ. 18:3</ref></char></note> <verse eid="1CO 4:12"/><verse number="13" style="v" sid="1CO 4:13"/>ኑል አፋ ኢታ ባዝ ኦድንትዛ ዎደ ሎኦ ቃላ ኑ ማህዛ። ኑ Ꮊኖ ሄሎዳይስ Ꮊ አላመ ፕጻባዝኔ ዎራ ዎዝ ቡሬ ማቄዛ።<verse eid="1CO 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 4:14"/>ታኒ የያ ጻፍዛይ፥ ታ ሲቅዛ ናእታይ ጋርክ፥ ይንታን ዞሮዳይስ ጻፈዛይፕ አትን ዬላሶዳይስ ባያ። <verse eid="1CO 4:14"/><verse number="15" style="v" sid="1CO 4:15"/>ክርስቶሳር ይንታን ካልዛ ፓይዶፕ ኣ የዝኮካ፥ ጋመ አድታይ ባያ። ታ ይንታን ክርስቶሳ የሱሳ ዎንግላይር የሌዛ። <verse eid="1CO 4:15"/><verse number="16" style="v" sid="1CO 4:16"/>ይኬ፥ ይ ታና ኣዝሶ ኡዲ ካሎድ ጋርክ ይንታን ዎስዛ።<note caller="-" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="1CO 11:1">1ቆሮ. 11:1</ref>፤ <ref loc="PHP 3:17">ፍል. 3:17</ref></char></note> <verse eid="1CO 4:16"/><verse number="17" style="v" sid="1CO 4:17"/>የይ ግሾስ፥ አማንንቴዝ፥ ታ ሲቅዛ፥ ጎዳይ ባጋር ታ ናአ፥ ጽማቶሳ ይንትኮ ኪቴዛ። ኤ ዱማ ዱማ አቆ የዝ ዎሳ ኬ ታ ታማርሴዝ፥ ክርስቶሳ የሱሳር የዝ ታ ኦጋ ይንታን ቆፍሶዳ።<verse eid="1CO 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 4:18"/>ታኒ ይንትኮ የአምባዝ ኣዝን፥ ኡትርትዛ ፐቲ ፐቲ አስታይ የዛ። <verse eid="1CO 4:18"/><verse number="19" style="v" sid="1CO 4:19"/>ዝን ጎዳይ ጊኮ፥ ኡከራ ታኒ ይንትኮ የኦዳ። የ ዎደ ኡትራንችታይ ኦዳ ኣዳ ባዝን ኡንትስ አባ ዎልቃካ የዛኮ ታ ኤሮዳ። <verse eid="1CO 4:19"/><verse number="20" style="v" sid="1CO 4:20"/>ጾስ ካተትይ ኦዳ ኣዳ ባዝን ጾስ ዎልቃ። <verse eid="1CO 4:20"/><verse number="21" style="v" sid="1CO 4:21"/>ታኒ ይንትኮ ጉፈራ Ꮊንጎነ ሲቆራኔ ሃዮ አያናራ Ꮊንጎ? ይ ኣያ ዶርኔ?<verse eid="1CO 4:21"/></para>
  <chapter eid="1CO 4"/>
  <chapter number="5" style="c" sid="1CO 5"/>
  <para style="s1">አማንዛ አስ ጋንጨ የዝ ዬላዛ ኦሶ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1"/>ይ ጋንጨ ላግተ የዛይ ዝግርንትዛ። የይ ጋርክ ላግታ ሀራ አቶዝን፥ አማኖዋ አሳይካ ኦያ። ይ ጋንጨ ፋ አደ ማችራ ቱኔዝ አሲ የዛ።<note caller="-" style="x"><char style="xo" closed="false">5:1 </char><char style="xt" closed="false"><ref loc="DEU 22:30">ናምእ. 22:30</ref></char></note> <verse eid="1CO 5:1"/><verse number="2" style="v" sid="1CO 5:2"/>የዝን ይ ቂራዳይስኔ ዬላቶዳይስ ቤዝዛ፥ ዝን ኡትርትዛ። የይ ጋርክ ቦርሶ ባዝ ኦዝ አ ይ ጋንጨፕ ከሶዳይስ ቤዞሳ?<verse eid="1CO 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 5:3"/>ታኒ አሾር ይንታር የዛም እጽኮካ አያናር ታ ይንታር የዛ። ታኒ ይንታር የዝ አስ ጋርክ ሀኒ የይ ጋርክ ኦሳ ኦዝ አይል አፋ ፕርዴዛ። <verse eid="1CO 5:3"/><verse number="4" style="v" sid="1CO 5:4"/>ኑ ጎዳ የሱስ ክርስቶሳ ሱንር ይ ሺቆዳር ታኒ አያናር ይንታር የዞዳ። ኤዛይድ ጎዳ የሱስ ክርስቶሳ ዎልቃይ ይንታር ማቆዳ። <verse eid="1CO 5:4"/><verse number="5" style="v" sid="1CO 5:5"/>የ አይ ናጋራ አሻይ<note caller="+" style="f"><char style="fr" closed="false">5:5 </char><char style="fqa" closed="false">ናጋራ አሻይ፦ </char><char style="ft" closed="false">ናጋራ መይ ዎይ ናጋራ አሰትይ።</char></note> ብን፥ ኤ አያናይ ጎዳ የሱሳ ፕርዳ ጋላስ አቶዳይ ጋርክ ኤ ጻላሄስ ኣ እንግንቶ።<verse eid="1CO 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 5:6"/>ይ ጋይርንታይ ሎኦ ባያ። ጽቃ እርሾ ሙኑቆ ኡባ ደንዛና ይ ኤሮሳ?<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="GAL 5:9">ጋላ. 5:9</ref></char></note> <verse eid="1CO 5:6"/><verse number="7" style="v" sid="1CO 5:7"/>ይ Ꮊት እርሾ ባ ሙኑቆ ማቆዳይ ጋርክ፥ ናጋራ እርሾ ይንታፕ ከሶይታ። ኑስ ፓዝቃ ዱር ማቄዝ ክርስቶሳ ያርሽንቴዛ።<note caller="-" style="x"><char style="xo" closed="false">5:7 </char><char style="xt" closed="false"><ref loc="EXO 12:5">ከስ 12:5</ref></char></note> <verse eid="1CO 5:7"/><verse number="8" style="v" sid="1CO 5:8"/>የይ ግሾስ፥ ገነኔ ኢታት የዝ እርሾር ባዝን ቱማትራኔ ጌሻት የዝ ቦራር ኑ ባለ ቦንቾዳ።<note caller="-" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="EXO 13:7">ከስ 13:7</ref>፤ <ref loc="DEU 16:3">ናምእ. 16:3</ref></char></note><verse eid="1CO 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 5:9"/>ታ ቲና ጻፌዝ ዳብዳባይድ ይ ላግትዛ አሳና ሄላማይ ጋርክ ይንትስ ኦዴዛ። <verse eid="1CO 5:9"/><verse number="10" style="v" sid="1CO 5:10"/>የያ ጉሳይ Ꮊ አላመል የዝ ላግትዝታ ዎይ ናጋራስ ተንቶትዝታ ዎይ ሱቃትዝታ ዎይ ቦንቂዝታ ዎይ ኤቃስ ጎይንዝታ ኡባር ሄልፓተ ጉስ ባያ። የያ ማቅኮ፥ Ꮊ አላማይፕ ይ ከዞዳይስ ቤዝዛ ዝን አቴዛ። <verse eid="1CO 5:10"/><verse number="11" style="v" sid="1CO 5:11"/>ዝን አማንዛ ጊንቲ ላግትዝታ ዎይ ተንቶትዛ ዎይ ኤቃስ ጎይንዝታይር ዎይ ጫዥዝታይር ዎይ ማዝታይር ዎይ ቦንቂዝታይር ወል ሄልፓተ ግ ይንትስ ኦድዛ። የይ ጋርክ አሳይራ ሀራ አቶዝን፥ ካካ ሚፓተ።<verse eid="1CO 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 5:12"/>ዎሳ ኬፕ ባለር የዝታይል አፋ ፕርዶዳይስ ታና አብ ሄል? ዎሳ ኬ የዝታይል አፋ ይ ፕርዶሳኔ? <verse eid="1CO 5:12"/><verse number="13" style="v" sid="1CO 5:13"/>ዝን ባለራ የዝታይል አፋ ጾስ ፕርዶዳ። የ ኢታ ባዝ ኦዝ አ ይ ጋንጨፕ ከሶይታ።<note caller="-" style="x"><char style="xo" closed="false">5:13 </char><char style="xt" closed="false"><ref loc="DEU 13:5">ናምእ. 13:5</ref>፤ <ref loc="DEU 17:7">17:7</ref></char></note><verse eid="1CO 5:13"/></para>
  <chapter eid="1CO 5"/>
  <chapter number="6" style="c" sid="1CO 6"/>
  <para style="s1">አማንዛ አሳይ ጋንጨ የዝ ሞቶ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1"/>ይ ጋንጨፕ ፐታይ ፐታይር ሞቶ የዛኮ፥ የያ አማንዛ አሳይ ቲና ፕርድንቶዳና አሺ አማኖዋ አስ ቲና ፕርድንቶዳይስ ዋይዚ ቤዜ? <verse eid="1CO 6:1"/><verse number="2" style="v" sid="1CO 6:2"/>ጌሽታይ አላመል አፋ ፕርዶዳና ይ ኤሮሳ? የዝን፥ ይ አላመል አፋ ፕርድዛ ባዝ ማቅኮ፥ Ꮊይ ጋርክ ጽቃባዝ ፕርዶዳይስ ዋይዚ ዳንዳእንቶሳ? <verse eid="1CO 6:2"/><verse number="3" style="v" sid="1CO 6:3"/>ኑኒ ኪታንችታይል አፋ ፕርዶዳና ይ ኤሮሳ? የዝን፥ Ꮊ ሳአ የሳል አፋ ፕርዶዳይስ ይንታን ዋይዚ ጋመ? <verse eid="1CO 6:3"/><verse number="4" style="v" sid="1CO 6:4"/>የዝን፥ የይ ጋርክ መቶ ይ ጋንጨ መንትኮ፥ ዎሳ ኬ ፐትፐተፕ ባለር የዝታይኮኔ ቦርንቴዝ አሳይ ቲና ፕርድንቶዳይስ ዋይዚ ካንጌ? <verse eid="1CO 6:4"/><verse number="5" style="v" sid="1CO 6:5"/>ታኒ ይንታን ዬላሶዳይስ የያ ግዛ። ይ ጋንጨ ካጭንቴዝ አስታ እንግዳይስ ዳንዳእዛ አካክዛ አሲ ባሳ? <verse eid="1CO 6:5"/><verse number="6" style="v" sid="1CO 6:6"/>የዝን፥ ፐቲ አማንዛ እሻይ Ꮊንኮ አማንዛ እሻና ፕርዳ ኬ አማኖዋ አሳይ ቲና ሞቶዳይስ ቤዝኔ?<verse eid="1CO 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 6:7"/>ይኬ፥ ይ ፐታይ ፐታ ሞትዛባዝ ማቅኮ የይ ይ ፖክ ቤዝዛ። የይፕ ይ ቆህንትኮኔ ዶሽንትኮ ሎኣሞ? <verse eid="1CO 6:7"/><verse number="8" style="v" sid="1CO 6:8"/>ዝን ይ ዎል ጋንጨ አማንዝታይ ፐታይ ፐታ ቆህዛኔ ዶሽዛ፥ የይካ ይ እሽታ።<verse eid="1CO 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 6:9"/>ዎርዥታይ ጾስ ካተት ላታማና ይ ኤሮሳ? ይንታን ዶሽፓተ፤ ተንቶትዝታይኔ ላግትዝታይ ዎይ ኤቃ ጎይንዝታይ ዎይ ቃይጽንትዝታይ ዎይ ራ ራር ፔዥዝታይ፥ <verse eid="1CO 6:9"/><verse number="10" style="v" sid="1CO 6:10"/>ዎይ ካይዝታይ ዎይ ኡዝታይ ዎይ ማዝታይ ዎይ ጫዥታይ ዎይ ቦንቅዝታይ ጾስ ካተት ላታሚ። <verse eid="1CO 6:10"/><verse number="11" style="v" sid="1CO 6:11"/>ይንታፕ ፐቲ ፐቲ አሳይ ቲና የይ ጋርከ። ዝን ይ Ꮊት ጎዳ የሱስ ክርስቶሳ ሱንራኔ ጾስ አያናር ሜጭንቴዛ፤ ጌዤዛ፤ ጽሌዛ።<verse eid="1CO 6:11"/></para>
  <para style="s1">ይ አሰትይር ጾስ ቦንቾይታ</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12"/>«ታስ ኡባ ባዝ እንግንቴዛ» ዝን ኡባይ ታና አዳሚ። «ታስ ኡባ ባዝ እንግንቴዛ»፥ ዝን አብካ ታና ሃራሚ።<note caller="-" style="x"><char style="xo" closed="false">6:12 </char><char style="xt" closed="false"><ref loc="1CO 10:23">1ቆሮ. 10:23</ref></char></note> <verse eid="1CO 6:12"/><verse number="13" style="v" sid="1CO 6:13"/>«ካ ኡሎስ፤ ኡሎካ ካስ» ዝን ጾሳይ ኡሎካ ካካ ብሶዳና ታ ይንትስ ኦድዛ። ኑ አሰትይ ጎዳይስፕ አትን ላግታስ ባያ። ጎዳይካ ኑ አሰትይስ። <verse eid="1CO 6:13"/><verse number="14" style="v" sid="1CO 6:14"/>ጾሳይ ጎዳ Ꮊይቆፕ ደንዛይ ጋርክ፥ ኑናካ Ꮊይቆፕ ፋ ዎልቃር ደንዳ።<verse eid="1CO 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 6:15"/>ይ አሰትይ ክርስቶሳ አሰትይፕ ባጋ ማቄዛና ኤሮሳኔ? የዝን፥ ታኒ ክርስቶሳ አሰትይፕ ባጋ ካንጊ ላግታ አሰት ማቆዳይ ጋርክ ኡዶ? ሀነና! <verse eid="1CO 6:15"/><verse number="16" style="v" sid="1CO 6:16"/>ላግትዛ አይ ኤ ፔዥዝ አስትራ ፐቲ አሰት ማቄዛና ይ ኤሮሳ? ጌሻ ማጻፋይድ፥ «ኡንቲ ናምአይ ፐቲ አሰት ማቆዳ» ግንትንት ጻፍንቴዛ።<note caller="-" style="x"><char style="xo" closed="false">6:16 </char><char style="xt" closed="false"><ref loc="GEN 2:24">መ. 2:24</ref></char></note> <verse eid="1CO 6:16"/><verse number="17" style="v" sid="1CO 6:17"/>ዝን ጎዳይራ ፐትፕዛ አይ ኤዛር አያናራካ ፐቶ ማቅዛ።<verse eid="1CO 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 6:18"/>ላግታፕ ሃኮይታ። ፐቲ አይ ኦዝ ሀራ ናጋራ ኤ አሰትፕ ባለራ ኦስንትዛ፥ ዝን ላግትዛ አስ ፋ አሰትይል ናጋራ ኦዛ። <verse eid="1CO 6:18"/><verse number="19" style="v" sid="1CO 6:19"/>ይ አሰትይ ጾሳይ ይንትስ እንጌዝ ይንታር የዝ ጌሻ አያና ካራ ማቄዛና ይ ኤሮሳኔ? ይ ይንትስ ባያ።<note caller="-" style="x"><char style="xo" closed="false">6:19 </char><char style="xt" closed="false"><ref loc="1CO 3:16">1ቆሮ. 3:16</ref>፤ <ref loc="2CO 6:16">2ቆሮ. 6:16</ref></char></note> <verse eid="1CO 6:19"/><verse number="20" style="v" sid="1CO 6:20"/>ጾሳይ ይንታን ጋተር ዎንጌዛ። የይ ግሾስ፥ ይ አሰትይር ጾስ ቦንቾይታ።<verse eid="1CO 6:20"/></para>
  <chapter eid="1CO 6"/>
  <chapter number="7" style="c" sid="1CO 7"/>
  <para style="s1">ኤኮ ገሎ ባጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 7:1"/>ይ ታስ ጻፌዝ ዳብዳባይ ባጋ አሲ ማች ቦቻምንጽኮ ሎኦ። <verse eid="1CO 7:1"/><verse number="2" style="v" sid="1CO 7:2"/>ዝን ላግታፕ አቶዳይስ ፐታይ ፐታይ ማቾ ፓስ ኤኮ፤ ማ ፐቲ ፐቲ ማችስካ አዝኒ የዞ።<verse eid="1CO 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 7:3"/>አዝናይ ፋ ማችስ፥ ማ ማቻት ፋ አዝናይስ ቤዝዛ ባዝ ኡዶ። <verse eid="1CO 7:3"/><verse number="4" style="v" sid="1CO 7:4"/>ማቻት ፋ አሰትይል አፋ ኢስ ማዉተ ባያ፥ ዝን ማዉተ እ አዝናይስ። የይ ጋርከካ፥ አዝናይስ ኤ አሰትይል አፋ ማዉተ ባያ፥ ዝን ማዉታይ ማቻትስ። <verse eid="1CO 7:4"/><verse number="5" style="v" sid="1CO 7:5"/>ይ ዎሳር ጽቃ ዎደ ጋምኦዳይስ ዞረር ማቃም እጽኮ፥ ፐታይ ፐታ ካይፓተ። የይፕ ደንዴዛይድ ይንትናት ሃሮዳይስ ጋምንትን፥ ጻላሄ ይንታን ፓጫማይ ጋርክ ዎላ የዞይታ። <verse eid="1CO 7:5"/><verse number="6" style="v" sid="1CO 7:6"/>ዝን ታኒ ይንታን ዞሮዳይስ Ꮊያ ጌዛይፕ አትን አዛዞ ባያ። <verse eid="1CO 7:6"/><verse number="7" style="v" sid="1CO 7:7"/>አሲ ኡባይ ታ ጋርክ ማቾ ኤከካ የዝዛኮ ታ ዶስዛ፥ ዝን ጾሳይ ፐታይስ ፐታይስ እንጌዝ ዱማ ዱማ እሞታይ የዛ። ፐታይስ Ꮊይ ጋርክ Ꮊንካይስ ሀራ እሞታይ የዛ።<verse eid="1CO 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 7:8"/>ማቾ ኤከካዝታይስኔ አዝን ገለካዝታይስ ማ አምእታይስ ታኒ ግዛይ፥ ታ ጋርክ የዞይታ ግ ዞርዛ። <verse eid="1CO 7:8"/><verse number="9" style="v" sid="1CO 7:9"/>ዝን አሞር ጹግንቶዳይፕ ኤክዛይኔ ገልዛይ ሎኦ ማቄዝ ግሾስ ኡንቲ ፋና ሃሮዳይስ ዳንዳአም እጽኮ፥ ኤኮነ ገሎ።<verse eid="1CO 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 7:10"/>ታኒ ኤኬዝታይስኔ ገሌዝታይስ Ꮊይ ጋርክ ግ ዞርዛ፤ ታና ባያ ጎዳይ አዛዝዛ፤ ማቻት ፋ አዝናይፕ ሻክንትፐ።<note caller="-" style="x"><char style="xo" closed="false">7:10-11 </char><char style="xt" closed="false"><ref loc="MAT 5:32">ማቶ. 5:32</ref>፤ <ref loc="MAT 19:9">19:9</ref>፤ <ref loc="MRK 10:11-12">ማር. 10:11-12</ref>፤ <ref loc="LUK 16:18">ሉቃ. 16:18</ref></char></note> <verse eid="1CO 7:10"/><verse number="11" style="v" sid="1CO 7:11"/>ዝን ሻክንትኮ ሀራ አዝን ገለካ ፋ ኡባስ የዞ ዎይ ፋ አዝናይራ ጊጎ። አዝናይ ፋ ማቻት ብልፐ።<verse eid="1CO 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 7:12"/>ዝን Ꮊንክታይስ ጎዳ ባዝን ታኒ Ꮊይ ጋርክ ግዛ። አማኖዋ ማቻ የዝ አማንዛ አዝናይ የዚኮ፥ ማቻት ኤዛር ፐትፕ የዞዳይስ ኮይኮ እዞ ብልፐ። <verse eid="1CO 7:12"/><verse number="13" style="v" sid="1CO 7:13"/>ማ አማኖዋ አዝኒ የዝ አማንዛ ማቻ የዚኮ፥ እ አዝናይ ኢር ፐትፕ የዞዳይስ ኮይኮ ኤፕ ብልንትፔ። <verse eid="1CO 7:13"/><verse number="14" style="v" sid="1CO 7:14"/>አማኖዋ አዝናይ ፋ አማንዛ ማቻት ባጋር ጌዥዛ፤ ማ አማኖዋ ማቻት ፋ አማንዛ አዝናይ ባጋር ጌዥዛ። የያ ባዛኮ፥ ይ ናእታይ ቱና ማቅዛ፥ ዝን Ꮊት ኡንቲ ጌሺ። <verse eid="1CO 7:14"/><verse number="15" style="v" sid="1CO 7:15"/>ዝን አማኖዋ አዝና ዎይ ማቻት ብሎዳይስ ኮይኮ ብሎ። አማንዛ ማቻ ዎይ አዝናይ የይ ጋርክ ባዛር አጭንትፐ። ጾሳይ ኑና ሳሮትር የዞዳይ ጋርክ ጼጌዛ። <verse eid="1CO 7:15"/><verse number="16" style="v" sid="1CO 7:16"/>አማንዛ አስተ፥ አማኖዋ ነ አዝናይ ነ ባጋር አማኖዳዛኮ ነ ኤርኔ? ዎይ አማንዛ አዮ፥ አማኖዋ ነ ማቻት ነ ባጋር አማኖዳዛኮ ነ ኤርኔ?<verse eid="1CO 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 7:17"/>ፐቲ ፐቲ አስ ጎዳይ ኤስ እንጌዝ እሞታይ ጋርከኔ ጾሳይ ኤዛ ጼጌዛይ ጋርክ የዛ። ዎሳ ኬ ኡባይድ ታኒ ታማርሴዝ ዎጋይ Ꮊያ። <verse eid="1CO 7:17"/><verse number="18" style="v" sid="1CO 7:18"/>ኦንካ ዶካልንቲ ጼግንቴዝባዝ ማቅኮ፥ ዶካልንቴካዛይ ጋርክ ሀንፔ። ዶካልንተካ አማኔዝ ኦንካ የዝኮ፥ ዶካልንቶዳይስ ኮይፐ። <verse eid="1CO 7:18"/><verse number="19" style="v" sid="1CO 7:19"/>ጾስ ኪታ ፖሎዳይስ ቤዝዛይፕ አትን ዶካልንትን ዶካልንታም እጽን አኮስካ አዶያ።<verse eid="1CO 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 7:20"/>ፐቲ ፐቲ አስ ጾሳይ ፋና ጼጌዝ ዎደ የዛን ጋርክ የዛ። <verse eid="1CO 7:20"/><verse number="21" style="v" sid="1CO 7:21"/>ጾሳይ ነና ጼጌዝ ዎደ ኔኒ አይለ? አኮካ ባያ የይስ ኡንእንትፐ። ዝን ኔኒ አይለትፕ ዎዝንቶዳይስ ዳንዳእኮ ዎዝንቶባ። <verse eid="1CO 7:21"/><verse number="22" style="v" sid="1CO 7:22"/>አይለ ማቂ የዛር ጎዳር ጼግንቴዝ አስ ጎዳይፕ ደንዴዛይድ አይለትፕ ዎዝንቴዛ። የይ ጋርከካ፥ አይለ ማቀካ የዛር፥ ጎዳይር ጼግንቴዝ አስ ክርስቶሳ አይለ። <verse eid="1CO 7:22"/><verse number="23" style="v" sid="1CO 7:23"/>ጾሳይ ይንታን ጋተ ጭግ ዎንጌዝ ግሾስ አስ አይለ ማቅፓተ። <verse eid="1CO 7:23"/><verse number="24" style="v" sid="1CO 7:24"/>ታ እሹን፥ ይ ፐታይ ፐታይ ጼግንቴዝ ዎደ የዝ የሳይር ጾሳር ዎላ የዞይታ።<verse eid="1CO 7:24"/></para>
  <para style="s1">ኤከካ፥ ገለካ አሳይ ባጋኔ አምእታይ ባጋ</para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 7:25"/>ዉድርታይኔ ፓንታይ ባጋ ጎዳይ ታና አዛዜዝ ባዝ ባያ። ዝን ጎዳይ ታስ እንጌዝ ማሮትይ ጋርክ ታኒ ይንታን ዞርዛ። <verse eid="1CO 7:25"/><verse number="26" style="v" sid="1CO 7:26"/>ይኬ፥ Ꮊ ዎዳይድ የዝ መታይ ግሾስ ኤከካ ዎይ ገለካ የስ ታስ ሎኦ ኣዝዛ። <verse eid="1CO 7:26"/><verse number="27" style="v" sid="1CO 7:27"/>ነ ማቾ ኤኬዝ ባዝ ማቅኮ፥ አንጆዳይስ ኮይፐ። ነ ማቾ ኤከካባዝ ማቅኮ፥ ኤኮዳይስ ኮይፐ። <verse eid="1CO 7:27"/><verse number="28" style="v" sid="1CO 7:28"/>ዝን ነ ማቾ ኤክኮ ናጋራ ባያ። የይ ጋርክ ዉድርታካ አዝን ገልኮ ናጋራ ባያ። ዝን ኤክዛ ገልዛ አሳይስ Ꮊ ሳአ ኢታ መቶ የዛ ግሾስ ይ የይፕ አቶዳይ ጋርክ ታ ኮይዛ።<verse eid="1CO 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 7:29"/>ታ እሹን፥ ታ ግዛይ የያ፤ ዎደ ዉሬዛ። ይከፕ ቲና ማቻ የዛይ ማቾ ኤከካዛይ ጋርክ የዞ። <verse eid="1CO 7:29"/><verse number="30" style="v" sid="1CO 7:30"/>ዬክዝታይ ዬኮዝታይ ጋርክ ማቆ፥ ኡፋይትዝታይ ኡፋይቶዚታይ ጋርክ፥ ዎንግዝታይ አኮካ ባዚታይ ጋርክ ፋና ፓይዶ። <verse eid="1CO 7:30"/><verse number="31" style="v" sid="1CO 7:31"/>Ꮊ ሳአ ሻሎር ማድንትንትዝታይ ማድንቶዚታይ ጋርክ ማቆ። Ꮊ አላመ ማላይ ኣዳ።<verse eid="1CO 7:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="1CO 7:32"/>ይ ህርጋ ባይ የዞዳይ ጋርክ ታ ዶስዛ። ማቾ ኤከካዛይ ጎዳ ኡፋይሶዳይስ ኮይዝ ግሾስ ጎዳይባዝ ቆፕዛ። <verse eid="1CO 7:32"/><verse number="33" style="v" sid="1CO 7:33"/>ዝን ማቾ ኤኬዛይ ፋ ማቻቶ ኡፋይሶዳይስ ኮይዝ ግሾስ Ꮊ ሳአባዝ ቆፕዛ። <verse eid="1CO 7:33"/><verse number="34" style="v" sid="1CO 7:34"/>ኤ ቆፋይ ናምእ አቆ ሻክንትዛ። አዝን ገለካ ዉድርታ ፋ አሰትይራኔ ፋ ሸምፓይድ ጌዢ ጎዳ ኡፋይሶዳይስ ኮዬዝ ግሾስ ጎዳይ ባዝ ቆፕዛ። ዝን ኣዝን ገሌዛና ፋ አዝና ኡፋይሶዳይስ ኮይዝ ግሾስ ሳአባዝ ቆፕዛ።<verse eid="1CO 7:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 7:35"/>ታኒ የያ ይንትስ ኦዴዛ፥ ይ ማድንቶዳይ ጋርከፕ አትን ጽኬ ጋንጨ ገሊ ይ ኡንእንቶዳይ ጋርክ ባያ። ዝን ይ ቆፋይ ላልንተካ ማራር የዚ ጎዳ ኡፋይስዛ ባዝ ይ ኡዶድ ጋርክ ታኒ ኦድዛ።<verse eid="1CO 7:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 7:36"/>ኦንካ ፋ ኦይጬዝ ዉድርቶ ገሎ ዎደ ኣዛ ግ እዞ አሾዳይስ ቆፕኮ፥ የይ ማ ኢስ ሎኦ ባዛይ ስእንትኮ፥ ፋ ኮዬዛ ኦ፤ ኡ ዎል ኤክኮ፥ ገልኮ፤ የይ ናጋራ ባያ። <verse eid="1CO 7:36"/><verse number="37" style="v" sid="1CO 7:37"/>ዝን ፐቲ አስ ኡንእዛ ባዝ ብኮ፥ ፋ ዎዝናይር ሚንጊ፥ ፋና ሃሪ፥ ፋ ኦይጬዝ ዉድርቶ ኤከካ አሾዳይስ ኮይኮ ሎኦ ኡዴዛ። <verse eid="1CO 7:37"/><verse number="38" style="v" sid="1CO 7:38"/>የይ ግሾስ፥ ዉድርቶና ኤኬዝ አይ ሎኦ ኦዛ፤ ማ ኤከካ አይ ኡባር ሎኦ ኦዛ።<verse eid="1CO 7:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 7:39"/>ማቻታ አዝናይ ፓጻ የዝ ዎደ ኡባይድ ኤዛር አጭንቴዛኖ። ዝን እ አዝናይ Ꮊይቅኮ፥ ፋ ዶሴዝ አዝና ገሎዳይስ ዳንዳእዛ። ሀኖ ዝን፥ እዛ ገልዛ አይ አማንዛ አስ ማቆዳይስ ቤዝዛ። <verse eid="1CO 7:39"/><verse number="40" style="v" sid="1CO 7:40"/>ታ ቆፋር ማቅኮ፥ እዛ ገለካ የዝኮ ኡፋይሳር የዞዳ። ማ ታስ፥ ታር ጾሳ አያና የዛ ኣዝዛ።<verse eid="1CO 7:40"/></para>
  <chapter eid="1CO 7"/>
  <chapter number="8" style="c" sid="1CO 8"/>
  <para style="s1">ኤቃስ ያርሽንቴዝ ካ ባጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1"/>ኤቃስ ያርሽንቴዝ ካ ባጋ ማቅኮ ኑ ኡባይ ኤርዛ። ኤራት ኡትርስዛ፥ ዝን ሲቆ ድችዛ። <verse eid="1CO 8:1"/><verse number="2" style="v" sid="1CO 8:2"/>ኦንካ ፋና ኤርዛ ግ ቆፕኮ፥ ኤ ሀጋ ኤሮዳይስ ቤዝዛይ ጋርክ ሀጋ ኤረካያ። <verse eid="1CO 8:2"/><verse number="3" style="v" sid="1CO 8:3"/>ዝን ኦንካ ጾስ ሲቅኮ ኤ ጾስ ካንታ ኤርንቴዛያ።<verse eid="1CO 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 8:4"/>የይ ግሾስ፥ ኤቃስ ያርሽንቴዝ ካ ሙስባጋ ማቅኮ Ꮊ አላመል ጎዲ ፐቲ ጾሳይፕ አትን ሀራ ባ ግሾስ ኤቃ ፓዋ ባዝ ማቄዛና ኑኒ ኤርዛ። <verse eid="1CO 8:4"/><verse number="5" style="v" sid="1CO 8:5"/>ጾስ ባዛር ሳሎራኔ ሳአር ጾሰ ግንትንቲ ጼግንትዝ ጋመ ጾስታይኔ ጎድታይ የዝኮካ፥ <verse eid="1CO 8:5"/><verse number="6" style="v" sid="1CO 8:6"/>ኡባ ባዝ መዝ፥ ኑ ኤ<note caller="-" style="x"><char style="xo" closed="false">8:6 </char><char style="xt" closed="false"><ref loc="NUM 10:17">ታይ. 10:17</ref></char></note>ባጋ ማቄዝ፥ ፐቲ ጾሳይ፥ አዳይ ኣዳ፥ ኑስ የዛ። ኡባይ ኤ ባጋር መንቴዛ፥ ኑካ ኤ ባጋር የዝዝ ፐቲ ጎዳይ፥ የሱስ ክርስቶሳ ኑስ የዛ።<verse eid="1CO 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 8:7"/>ዝን የያ ኤርዝታይ ኡብታ ባያ። ፐቲ ፐቲ አሳይ ኤቃ ጎይንዛ ግሾስ ካ ሚዝ ዎደ ኤቃስ ያርሽንቴዝ ባዝ ኡዲ ኤክዛ። የ ዎደ ኡ ካሃይ ዳቡራ ማቄዝ ግሾስ ቱንዛ። <verse eid="1CO 8:7"/><verse number="8" style="v" sid="1CO 8:8"/>ዝን ካ ኑና ጾሳር ዳቦያ። ኑ ማም እጽኮ አኮካ ቆህንታሚ፤ ማ ሚኮካ ማዳሚ።<verse eid="1CO 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 8:9"/>ዝን ይ ኮዬዝ ባዝ ማዳይስ ማዉተ ይንትስ የዝኮካ የይ አማኖር ምንገካዝታ ባማይ ጋርክ ናግንቶይታ። <verse eid="1CO 8:9"/><verse number="10" style="v" sid="1CO 8:10"/>ኔኒ ነና ኤራንቾ ግ ኤቃስ ያርሽንቴዝ ካ ማዳይስ ኤቃ ካራ በቴዝን፥ አማኖር ምንጌካዛይ ነና ብእኮ የይ ኤዛ ኤቃስ ያርሽንቴዝ ካ ማዳይ ጋርክ ደንሳኔ? <verse eid="1CO 8:10"/><verse number="11" style="v" sid="1CO 8:11"/>ይኬ፥ ነ ኤራትይፕ ደንዴዛይድ ክርስቶሳ ኤ ግሾስ Ꮊይቄዝ፥ አማኖር ምንገካ ነ እሻይ፥ ብዛ። <verse eid="1CO 8:11"/><verse number="12" style="v" sid="1CO 8:12"/>የይ ጋርክ ኡዲ፥ አማኖር ምንገካ ይ እሽታ ቆህታራኔ ኡ ካሃ ሱታር ክርስቶሳና ቆህዛ። <verse eid="1CO 8:12"/><verse number="13" style="v" sid="1CO 8:13"/>የይ ግሾስ፥ ካ ታ እሻ ቢዛባዝ ማቅኮ፥ ኤ ብንታማይ ጋርክ አሾ የሻ ታ ማሚ።<verse eid="1CO 8:13"/></para>
  <chapter eid="1CO 8"/>
  <chapter number="9" style="c" sid="1CO 9"/>
  <para style="s1">ሀዋርታይ ማዉተ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1"/>ታኒ ማዉተር የዛ አስ ባሳኔ? ታ ሀዋረ ባሳኔ? ታኒ ኑ ጎዳ የሱስ ክርስቶሳ በኤካሳኔ? ጎዳይር ይ ታ ዳቡራ ኣፈ ባሳኔ? <verse eid="1CO 9:1"/><verse number="2" style="v" sid="1CO 9:2"/>ይ ጎዳይባዝ ማቄዝ ግሾስ ታ Ꮊንክታይስ ሀዋረ ማቃም እጽኮካ፥ ይንትስ ሀዋረ ማቅይስ ይ ማርካ።<verse eid="1CO 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 9:3"/>ታና ሀዋረ ባያ ግዝ አሳይስ ታ እንግዛ ማህይ Ꮊያ። <verse eid="1CO 9:3"/><verse number="4" style="v" sid="1CO 9:4"/>ኑ ማዳይስኔ ኡዦዳይስ ቱማ ኑስ ማዉተ ባሳኔ? <verse eid="1CO 9:4"/><verse number="5" style="v" sid="1CO 9:5"/>Ꮊንኮ ሀዋርታይ ጋርከኔ፥ ጎዳይ እሽታይ ጋርክ፥ ጵጽሮሳ ጋርክ፥ አማንዛ ኑ ማችታ ኤኪ የዳይስ ኑስ ማዉተ ባሳ? <verse eid="1CO 9:5"/><verse number="6" style="v" sid="1CO 9:6"/>ዎይ ኦር አቆዳይስ ቤዝዛይ ታራኔ ባርናባሳ ኣዳ? <verse eid="1CO 9:6"/><verse number="7" style="v" sid="1CO 9:7"/>ፋ ሚሻይር ዎታዳረት ኦዛይ ኦኖ? ዎይ ዎይነ ቱኪ፥ ኤዛይፕ ኣፈ ሞዛይ ኦኖ? ዎይ ዉደ ሄንግታር፥ የ ዉዳይፕ ማ ኡዦዛይ ኦኖ?<verse eid="1CO 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 9:8"/>ታኒ የያ አስ ቆፋ ጋርክ ግነነ? ህገ የያ ግን ባሳ? <verse eid="1CO 9:8"/><verse number="9" style="v" sid="1CO 9:9"/>ሙሰ ህጋይድ፥ «ዉዱማ ካ ቡክዛ ገማተ ዶና አጭፐ» ግንትንት ጻፍንቴዛ። የዝን ጾሳይ የያ ገማታይስ ቆፒ ጌኔ?<note caller="-" style="x"><char style="xo" closed="false">9:9 </char><char style="xt" closed="false"><ref loc="DEU 25:4">ናምእ. 25:4</ref>፤ <ref loc="1TI 5:18">1ጽማ. 5:18</ref></char></note> <verse eid="1CO 9:9"/><verse number="10" style="v" sid="1CO 9:10"/>ጾሳይ የያ ጌዛይ ኑስ ቆፒ ባሳኔ? ኤ ኑ ግሾሲ። ቢታ ኦዛይካ፥ ካ ጌሽዛይካ ፋና ሄልዛ ግሻ ኤኮድ ግ ኡፋይሳር ኦዳይስ ቤዝዛ ጊንትንቴዛይ ቱማ ኑ ግሾስ ጻፍንቴዛ። <verse eid="1CO 9:10"/><verse number="11" style="v" sid="1CO 9:11"/>ኑኒ ይ ጋንጨ አያና ዘር ዘሬዝ ማቅኮ አሾስ ቤዝዛ ባዝ ኑ ይንትፕ ማጽኮ፥ የይ ዳማ ባዞኔ?<note caller="-" style="x"><char style="xo" closed="false">9:11 </char><char style="xt" closed="false"><ref loc="ROM 15:27">ኦሮ. 15:27</ref></char></note> <verse eid="1CO 9:11"/><verse number="12" style="v" sid="1CO 9:12"/>Ꮊንክታይ የያ ይንትፕ ኤኮዳይስ ኡንትስ ማዉተ የዝኮ፥ ኑስ ኡንቲሳይፕ ኣ ማዉተ የዛ።<note caller="-" style="x"><char style="xo" closed="false">9:12 </char><char style="xt" closed="false"><ref loc="MAT 10:10">ማቶ. 10:10</ref>፤ <ref loc="LUK 10:7">ሉቃ. 10:7</ref></char></note></para>
  <para style="p" vid="1CO 9:12">ዝን ኑኒ ክርስቶሳ ዎንግለስ በ ማቃም ጋርክ፥ ኡባ ጋርዥነፕ አትን የ ማዉታይር ማድንተካያ። <verse eid="1CO 9:12"/><verse number="13" style="v" sid="1CO 9:13"/>ጾስ ካራ ኦዛ አስታይ ፋ ካ ጾስ ካራፕ ኤክዛኔ ማ ያርሾ አቆ ኦዝታይ ያርሾላፕ ኤኪ ሚዛና ይ ኤሮሳኔ?<note caller="-" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="DEU 25:4">ናምእ. 25:4</ref>፤ <ref loc="1TI 5:18">1ጽማ. 5:18</ref></char></note> <verse eid="1CO 9:13"/><verse number="14" style="v" sid="1CO 9:14"/>የይ ጋርከካ፥ ዎንግለ ማርካትዝታይ የስስ ቤዝዛ ባዝ ዎንግላይፕ ኤኮዳይ ጋርክ ጎዳይ አዛዜዛ።<verse eid="1CO 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 9:15"/>ዝን ታኒ Ꮊ ማዉተ ኡቢታይድ አኮካ ማድንተካያ። ታኒ Ꮊያ ጻፌዛይ ታ ማዉተ ቦንችሶዳይስ ኮዪ ባያ። ኦንካ ታ ጬቃ ጨረ አሾዳይፕ Ꮊይቆ ታስ ሎኦ። <verse eid="1CO 9:15"/><verse number="16" style="v" sid="1CO 9:16"/>ታኒ ዎንግለ ኦድዛይ ኪትንቴዝ ግሾሳፕ አትን ታና ጬቅስዛባዝ ባያ። ዎንግለ ኦዳም እጽኮ፥ ታና አየ። <verse eid="1CO 9:16"/><verse number="17" style="v" sid="1CO 9:17"/>ታኒ ዎንግለ ዶሶር ሳባክኮ ታስ ዎይቶ የዛ። ዝን ታኒ ዎንግለ ዶሰካ አዛዝንቲ ሳባክዛባዝ ማቅኮ የያ ታ ሀዳራ ፖሌነፕ አትን ሀራ ታ ኦዝ ባዝ ባያ። <verse eid="1CO 9:17"/><verse number="18" style="v" sid="1CO 9:18"/>የዝን፥ ታ ዎይታይ አባ? ታኒ ዎንግለ ሳባክዛ ዎደ ታ ማዉተር ማድንተካ ዎንግለ ዳሞዘ ባይ ጨረ ሳባክዛይ ታስ ዎይቶ።<verse eid="1CO 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 9:19"/>ታኒ ኦስካ አይለ ባያ፥ ዝን ጋምታ አሾዳይስ ኡባይስ አይለ ማቄዛ። <verse eid="1CO 9:19"/><verse number="20" style="v" sid="1CO 9:20"/>ታኒ አይሁድታ አሾዳይስ ኡንታር ኡንታን ማቄዛ። ታ ኦማስ ህገፕ ኦሞር ባያ፥ ዝን ህገፕ ኦሞር የዝታ አሾዳይስ ህገፕ ኦሞ የዝ አስ ማቄዛ። <verse eid="1CO 9:20"/><verse number="21" style="v" sid="1CO 9:21"/>ጾስ ህጋይፕ ባለ ከዘካ፥ ክርስቶሳ ህጋይስ ኪትንትታር፥ ህገ ባዝታ አሾዳይስ ህገ ባ አስ ጋርክ ታ ማቄዛ። <verse eid="1CO 9:21"/><verse number="22" style="v" sid="1CO 9:22"/>ታኒ ዳቡሬዝታ አሾዳይስ ዳቡራ ማቄዛ። ታኒ ጽቃ አስታ አሾዳይስ ኡባይር ኡባ ማቄዛ። <verse eid="1CO 9:22"/><verse number="23" style="v" sid="1CO 9:23"/>ታኒ ዎንግለ አንጆ ሻክንቶዳይስ፥ Ꮊ ኡባ ዎንግለ ግሾስ ሀኔዛ።<verse eid="1CO 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 9:24"/>ላሶ ኣላልዝ ኡባይ ላስዛ፥ ዝን ፐታይ ኣዳ ዎይቶ ኤክዛና ኤሮሳኔ? የይ ጋርክ ይንትካ ዎይታ ኤኮዳይስ ላሶይታ። <verse eid="1CO 9:24"/><verse number="25" style="v" sid="1CO 9:25"/>ላስዛ አስ ኡባይ ኡባ ባዛር ፋና ሃርዛ። ኡንቲ የያ ዳቡርዛይ ቦድ ዛዉደ ዎይቶ ኤኮዳይሲ። ዝን ኑኒ ዳቡርዛይ መና ዛዉደ ዎይታ ኤኮዳይሲ። <verse eid="1CO 9:25"/><verse number="26" style="v" sid="1CO 9:26"/>የይ ግሾስ፥ ታኒ ቆፋ ባ አስ ጋርክ ላሳም። ጫርኮ ዡልትዝ አስ ጋርክ ጨረ ኩሸ ዳካሚ። <verse eid="1CO 9:26"/><verse number="27" style="v" sid="1CO 9:27"/>ዝን ታኒ ሀራይስ ዎንግለ ሳባኬዛይፕ ጉየ ታ ኦማስ ዎዝ አስ ማቃማይ ጋርክ ታ አሰት ዎልቃር ዡልትታር ታስ አዛዝንቶዳይ ጋርክ ኡድዛ።<verse eid="1CO 9:27"/></para>
  <chapter eid="1CO 9"/>
  <chapter number="10" style="c" sid="1CO 10"/>
  <para style="s1">ኤቃስ ጎይናማይ ጋርክ ናግሶ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1"/>ታ እሹን፥ ታኒ ይ Ꮊያ አካኮዳይ ጋርክ ኮይዛ። ኑ አድታይ ኡባይ ሻራ ካልን ሻራ ኦሞራ የዛ፤ ኡባይ አባ ፒንጌዛ።<note caller="-" style="x"><char style="xo" closed="false">10:1 </char><char style="xt" closed="false"><ref loc="EXO 13:21-22">ከስ 13:21-22</ref>፤ <ref loc="EXO 14:22-29">14:22-29</ref></char></note> <verse eid="1CO 10:1"/><verse number="2" style="v" sid="1CO 10:2"/>ኡንቲ ሙሰራ ፐትፖዳይስ ሻራራኔ አባ ጻማቅንቴዛ። <verse eid="1CO 10:2"/><verse number="3" style="v" sid="1CO 10:3"/>ኡንቲ ኡባይ ፐቲ አያና ካ ሜዛ።<note caller="-" style="x"><char style="xo" closed="false">10:3 </char><char style="xt" closed="false"><ref loc="EXO 16:35">ከስ 16:35</ref></char></note> <verse eid="1CO 10:3"/><verse number="4" style="v" sid="1CO 10:4"/>ማ ኡባይ ፐቲ አያና ኡሽ ኡዤዛ። ኡንታን ካልዛ አያና ዛላፕ ፑልቴዝ ኡሻ ኡዤዛ፤ የ ዛላይካ ክርስቶሳ።<note caller="-" style="x"><char style="xo" closed="false">10:4 </char><char style="xt" closed="false"><ref loc="EXO 17:6">ከስ 17:6</ref>፤ <ref loc="NUM 20:11">ታይ. 20:11</ref></char></note> <verse eid="1CO 10:4"/><verse number="5" style="v" sid="1CO 10:5"/>ዝን ጾሳይ ኡንታፕ ጋምታይል ኡፋይተካዛይ ግሾስ ኡ አሃይ ሊዦ ደምባ ዎ አቴዛ።<note caller="-" style="x"><char style="xo" closed="false">10:5 </char><char style="xt" closed="false"><ref loc="NUM 14:29-30">ታይ. 14:29-30</ref></char></note><verse eid="1CO 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 10:6"/>ኡንቲ ኢታ ባዝ አሞቴዛይ ጋርክ፥ ኑካ ኢታ ባዝ አሞታማይ ጋርክ የይ ኡባይ ኑስ ኣዝሶ ማቄዛ።<note caller="-" style="x"><char style="xo" closed="false">10:6 </char><char style="xt" closed="false"><ref loc="NUM 11:4">ታይ. 11:4</ref></char></note> <verse eid="1CO 10:6"/><verse number="7" style="v" sid="1CO 10:7"/>ጌሻ ማጻፋይድ፥ «አሳይ ማዳይስኔ ኡዦዳይስ በቴዛ፤ ማ የጾዳይስ ደንዴዛ» ግንትንቴዛይ ጋርክ ኡንታፕ ፐታይ ፐታይ ኤቃ ጎይኔዛይ ጋርክ ይ ኤቃ ጎይንፓተ።<note caller="-" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="EXO 32:6">ከስ 32:6</ref></char></note> <verse eid="1CO 10:7"/><verse number="8" style="v" sid="1CO 10:8"/>ኡንታፕ ፐታይ ፐታይ ላሜዛይ ጋርክ ኑካ ናጋራ ኦ። የይፕ ደንዴዛይድ ኡንታፕ ፐቲ ጋላስ ላታማኔ ሀይ ሙኩሎ አስ Ꮊይቄዛ።<note caller="-" style="x"><char style="xo" closed="false">10:8 </char><char style="xt" closed="false"><ref loc="NUM 25:1-18">ታይ. 25:1-18</ref></char></note> <verse eid="1CO 10:8"/><verse number="9" style="v" sid="1CO 10:9"/>ኡንታፕ ፐታይ ፐታይ ጎዳ ፓጪ ሾሻር ዱክንቲ Ꮊይቄዛይ ጋርክ ኑ ጎዳ ፋጮዳይስ ቤዞያ።<note caller="-" style="x"><char style="xo" closed="false">10:9 </char><char style="xt" closed="false"><ref loc="NUM 21:5-6">ታይ. 21:5-6</ref></char></note> <verse eid="1CO 10:9"/><verse number="10" style="v" sid="1CO 10:10"/>ኡንታፕ ፐታይ ፐታይ ኦሊ Ꮊይቆ ክእዝ ኪታንቻይር ቤዛይ ጋርክ ይንትካ ኦልፓተ።<note caller="-" style="x"><char style="xo" closed="false">10:10 </char><char style="xt" closed="false"><ref loc="NUM 16:41-49">ታይ. 16:41-49</ref></char></note><verse eid="1CO 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 10:11"/>Ꮊ ኡንታል አፋ ሄሌዝ ኡባይ ኑ ናግንቶዳይ ጋርክ ኑስ ኣዝሶ ማቄዛ። ማ ዎደ ዉርስል አፋ የዝ ኑስ ትምርተ ማቆዳይ ጋርክ Ꮊ ኡባይ ጻፍንቴዛ።<verse eid="1CO 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 10:12"/>የይ ግሾስ፥ ኤቄዛ ኣዝዝ ኦንካ ፖካማይ ጋርክ ፋና ናጎ። <verse eid="1CO 10:12"/><verse number="13" style="v" sid="1CO 10:13"/>አስ ኡባ ሄልዛ ፓጨፕ አትን ዱማ ፓጨ ይንታን ሄለካያ። ይ ዎልቃይ ዳንዳእዛይፕ ኣ ፓጨር ይ ፓጭንታማይ ጋርክ ኣ እንጎዋ ጾሳይ አማንንቴዛያ። ይንታን ፓጨ ሄልዛ ዎደ የ ፓጫይድ ኤ ይንታን ዳንዳእሶዳ። ማ የ ፓጫይፕ ይ ከዞድ ኦጋ ኤ ጊግሶዳ።<verse eid="1CO 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 10:14"/>ይኬ፥ ታ አልኦ እሹን፥ ኤቃ ጎይኖፕ ሃኮይታ። <verse eid="1CO 10:14"/><verse number="15" style="v" sid="1CO 10:15"/>ይ ካሃማ አስ ማቄዝ ግሾስ ታ Ꮊያ ኦድዛ። ታኒ ግዛይ ቱማ ማቄዛና ይ ይ ኡባስ ፕርዶይታ። <verse eid="1CO 10:15"/><verse number="16" style="v" sid="1CO 10:16"/>ኑኒ ጾስ ጋላቲ ሻክንትዛ አንጆ ጹአይ ክርስቶሳ ሱር ፐትፐተ የዛ ባሳኔ? ማ ኑኒ ሚዝ ቦራይ ክርስቶሳ አሻይራ ፐትፐተ የዛ ባሳኔ?<note caller="-" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="MAT 26:26-28">ማቶ. 26:26-28</ref>፤ <ref loc="MRK 14:22-24">ማር. 14:22-24</ref>፤ <ref loc="LUK 22:19-20">ሉቃ. 22:19-20</ref></char></note> <verse eid="1CO 10:16"/><verse number="17" style="v" sid="1CO 10:17"/>ኑኒ ጋመ ማቅኮካ ቦራይ ፐቶ፥ ኑ የ ፐቲ ቦራ ሻክንትዛ ግሾስ ፐቲ አሰት።<verse eid="1CO 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 10:18"/>አን እስሬለ አሳይ ኦዛ አካኮይታ። ያርሽንቴዝ ያርሾ ሚዝታይስ ያርሾ በሳይራ ፐትፐተ ባሳኔ?<note caller="-" style="x"><char style="xo" closed="false">10:18 </char><char style="xt" closed="false"><ref loc="LEV 7:6">ለዊ. 7:6</ref></char></note> <verse eid="1CO 10:18"/><verse number="19" style="v" sid="1CO 10:19"/>ታኒ አብ ጎዳይስ ኮዪ ግኔ? ኤቃስ ያርሽንቴዝ ካይ ዎይ ኤቃይ ፓዛባዝ ጉሶኔ? <verse eid="1CO 10:19"/><verse number="20" style="v" sid="1CO 10:20"/>ዋኣ፥ ኡንቲ ያርሽዛይ ጾስስ ባዝን ቱና አያንታይሲ። የይ ግሾስ፥ ይንትስ ቱና አያንታይራ ፐትፐተ የዞዳይ ጋርክ ታ ኮዮያ። <verse eid="1CO 10:20"/><verse number="21" style="v" sid="1CO 10:21"/>ይ ጎዳይ ጹአይፕ ኡዥታር፥ ማ ቱና አያንታይ ጹአይፕ ኡዦዳይስ ይ ዳንዳኦያ። ጎዳ ጋይታይፕ ሚታር ማ ቱና አያንታይ ጋይታይፕ ማዳይስ ዳንዳኦዋ። <verse eid="1CO 10:21"/><verse number="22" style="v" sid="1CO 10:22"/>ኑ የያ ኡዲ ጎዳ ሸን? ኑ ምኖትር ኤፕ ኣነኔ?<note caller="-" style="x"><char style="xo" closed="false">10:22 </char><char style="xt" closed="false"><ref loc="DEU 32:21">ናምእ. 32:21</ref></char></note><verse eid="1CO 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23"/>ይ «ኡባ ባዝ ኑስ እንግንቴዛ» ዝን ኡባይ አዶያ። «ኡባ ባዝ ኑስ እንግንቴዛ» ግዛ ዝን ኡባ ባዝ አዶያ።<note caller="-" style="x"><char style="xo" closed="false">10:23 </char><char style="xt" closed="false"><ref loc="1CO 6:12">1ቆሮ. 6:12</ref></char></note> <verse eid="1CO 10:23"/><verse number="24" style="v" sid="1CO 10:24"/>ፐቲ ፐቲ አስ፥ ሀራ አስ ማድዛ ባዝ ቆፖዳይስ ቤዝነፕ አትን ፋና ማድዛ ባዝ ኣዳ ቆፕፐ።<verse eid="1CO 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 10:25"/>ይ ካሃይድ ስ መዛ ሃሲ ጋበል ባይዝንትዛ አሾ ስእ ግ ሞይታ። <verse eid="1CO 10:25"/><verse number="26" style="v" sid="1CO 10:26"/>አብስ ጊኮ፥ «ሳአኔ ሳአል የዝ ኡባይ ጎዳይሲ።»<note caller="-" style="x"><char style="xo" closed="false">10:26 </char><char style="xt" closed="false"><ref loc="PSA 24:1">ማዝ. 24:1</ref></char></note><verse eid="1CO 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 10:27"/>ፐቲ አማኖዋ አስ ይንታን እማቶስ ኮይ ጼግኮ Ꮊንጎዳይስ ኮይኮ Ꮊንጎይታ። ይ ካሃይድ ስካ ይ ቲና ኣዛባዝ ኡባ ሞይታ። <verse eid="1CO 10:27"/><verse number="28" style="v" sid="1CO 10:28"/>ዝን ፐቲ አስ፥ «Ꮊይ ኤቃስ ያርሽንቴዝ ባዚ» ጊኮ፥ የ ይንትስ ኦዴዝ አይ ግሾኔ ኤ ካሃይ ግሾስ የ ካ ሚፓተ። <verse eid="1CO 10:28"/><verse number="29" style="v" sid="1CO 10:29"/>ታኒ፥ ካሃ ግሾስ ግ ይንትስ ኦድዛይ አይ ካሃ ግነፕ አትን ይ ካሃ ባያ።</para>
  <para style="p" vid="1CO 10:29">ሀራ አስ ካሃ ግሾስ ግ ታኒ ታ ዋሎትይል አብስ ፕርዶ? <verse eid="1CO 10:29"/><verse number="30" style="v" sid="1CO 10:30"/>ታኒ ሚዝ ካ ጾስ ጋላቲ ሚኮ ባልንቴዛያ ጋርክ አብስ ቦርንቶዴ?<verse eid="1CO 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="1CO 10:31"/>ይኬ፥ ይ አብ ሚኮ አብ ኡዥኮ፥ ዎይ አብ ኦኮካ ኡባ ባዝ ጾስ ቦንቾስ ኦይታ። <verse eid="1CO 10:31"/><verse number="32" style="v" sid="1CO 10:32"/>አይሁድታ ማቅን ግርክታ ማቅን ዎይ ጾስ ዎሳ ኬ ማቅን ኦስካ በ ማቅፓተ። <verse eid="1CO 10:32"/><verse number="33" style="v" sid="1CO 10:33"/>ታኒ ኡባ ዎደ ጋምታ አሾዳይስ ኡንቲ ማድንትዛ ኦገ ኮይነፕ አትን ታና ማድዛ ኦገ ኮዮያ።<verse eid="1CO 10:33"/></para>
  <chapter eid="1CO 10"/>
  <chapter number="11" style="c" sid="1CO 11"/>
  <para style="p">
    <verse number="1" style="v" sid="1CO 11:1"/>ታኒ ክርስቶሳ ኣዝዛይ ጋርክ፥ ይንትካ ታና ኣዞይታ።<note caller="-" style="x"><char style="xo" closed="false">11:1 </char><char style="xt" closed="false"><ref loc="1CO 4:16">1ቆሮ. 4:16</ref>፤ <ref loc="PHP 3:17">ፍል. 3:17</ref></char></note><verse eid="1CO 11:1"/></para>
  <para style="s1">ጎይኖ ዎጋ</para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 11:2"/>ይ ኡባ ባዛር ታና ቆፕዛ ግሾኔ ታ ታማርሴዝ ትምርትታ ሚን ናጌዝ ግሾስ ታ ይንታን ጋላትዛ። <verse eid="1CO 11:2"/><verse number="3" style="v" sid="1CO 11:3"/>ዝን ክርስቶሳ ራ ኡቢታይስ ኦማ፥ ራ ማችስ ኦማ፥ ማ ጾሳይ ክርስቶሳስ ኦማ ማቄዛና ይ ኤሮዳይ ጋርክ ታ ኮይዛ። <verse eid="1CO 11:3"/><verse number="4" style="v" sid="1CO 11:4"/>ፋ ኦማ ጉላንቲ ጾስ ዎስዛ ዎይ ትንቢተ ኦድዛ ራ ኡባይ ኦማ ማቄዝ ክርስቶሳ ቶችዛ። <verse eid="1CO 11:4"/><verse number="5" style="v" sid="1CO 11:5"/>ፋ ኦማ ቃጨካ ጾስ ዎስዝ ዎይ ትንቢተ ኦድዝ ማቻት ኦማ ማቄዝ ፋ አዝና ቶችዛ። ፋ ኦማ ቃጨካ ማቻት ፋ ኦማ ሜድንቴዝ ማች አስ ጋርክ ፋይድንትዛ።<verse eid="1CO 11:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 11:6"/>ማች አሲ ፋ ኦማ ቃጫም እጽኮ፥ ፋ ኦማ ጋችንቶ። ዝን ኢስ ኦማ ጋቾ ዎይ ሜዶ ቦርሶ ባዝ ማቅኮ ፋ ኦማ ቃጮ። <verse eid="1CO 11:6"/><verse number="7" style="v" sid="1CO 11:7"/>ራ ጾስ ኣዝሶኔ ጾስ ቦንቾ ማቄዝ ግሾስ ፋ ኦማ ቃጮዳይስ ቤዞያ፥ ዝን ማቺ ራ ቦንቾ።<note caller="-" style="x"><char style="xo" closed="false">11:7 </char><char style="xt" closed="false"><ref loc="GEN 1:26-27">መ. 1:26-27</ref></char></note> <verse eid="1CO 11:7"/><verse number="8" style="v" sid="1CO 11:8"/>ማቺ ራፕ መንቴዛፕ አትን ራ ማቻፕ መንተካያ።<note caller="-" style="x"><char style="xo" closed="false">11:8-9 </char><char style="xt" closed="false"><ref loc="GEN 2:18-23">መ. 2:18-23</ref></char></note> <verse eid="1CO 11:8"/><verse number="9" style="v" sid="1CO 11:9"/>ማች አስ ራስ መንቴነፕ አትን ራ ማችስ መንተካያ። <verse eid="1CO 11:9"/><verse number="10" style="v" sid="1CO 11:10"/>Ꮊይ ግሾኔ ኪታንችታይ ግሾስ ማች አሲ ፓስ ማዉተ የዛና ቤዝዛ ማላ ፋ ኦማ ቃጮዳይስ ቤዝዛ።<verse eid="1CO 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 11:11"/>ዝን ጎዳይ ቆፋይድ ማች አሲ ር ባይ የዛሚ፤ ራካ ማች ባይ የዛም። <verse eid="1CO 11:11"/><verse number="12" style="v" sid="1CO 11:12"/>ማች አሲ ራፕ መንቴዛይ ጋርክ ራካ ማቻፕ የልንቴዛ። ዝን ኡባይካ ጾሳፕ መንቴዛ።<verse eid="1CO 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 11:13"/>አን ይ ፕርዶይታ። ማች ፋ ኦማ ቃጨካ ጾስ ዎሶዳይስ ቤዝኔ? <verse eid="1CO 11:13"/><verse number="14" style="v" sid="1CO 11:14"/>ራ ፋ ኦማ ድችኮ ኤስ ቦርሶ ማቄዛና ሀራ አቶዝን መት ታማርሶሳኔ? <verse eid="1CO 11:14"/><verse number="15" style="v" sid="1CO 11:15"/>ዝን ማች ፋ ኦማ ድችኮ ኢስ ቦንቾ ባሳኔ? ማችስ ኦማ እንግንቴዛይ እዛ ፋና ካሞዳይ ጋርከ። <verse eid="1CO 11:15"/><verse number="16" style="v" sid="1CO 11:16"/>ዝን Ꮊይል አፋ ፓላሞዳይስ ኮዬዝ አስ የዝኮ፥ ኑስ ማቅን ዎይ ጾስ ዎሳ ኬታይስ ማቅን Ꮊይፕ ሀራ ዎጋ ባያ።<verse eid="1CO 11:16"/></para>
  <para style="s1">ጎዳይ ካሆ ኤክዛ ማራ</para>
  <para style="r">(<ref loc="MAT 26:26-29">ማቶ. 26:26-29</ref>፤ <ref loc="MRK 14:22-25">ማር. 14:22-25</ref>፤ <ref loc="LUK 22:14-20">ሉቃ. 22:14-20</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 11:17"/>ይ ፐትፕ ሺቅዛይ ማድዛ ባዝ ባዝን ቆህዛ ማቄዝ ግሾስ Ꮊት ታ እንግዛ አዛዛይድ ይንታን ናሽቻሚ። <verse eid="1CO 11:17"/><verse number="18" style="v" sid="1CO 11:18"/>ታ ቲና ስኤዛይ፥ ይ ዎሳ ኬ ሺቆዳር ይ ጋንጨ ሻኮት የዛ። የያ ታ ስኤዛይፕ ባጋይ ቱማ ማቄዛና ታ አማንዛ። <verse eid="1CO 11:18"/><verse number="19" style="v" sid="1CO 11:19"/>ይ ጋንጨፕ ቱማር የዝታይ ኦናንታዛኮ ኤርንቶዳይ ጋርክ ይ ጋንጨ ሻኮ የስ አታሚ። <verse eid="1CO 11:19"/><verse number="20" style="v" sid="1CO 11:20"/>ይ ፐትፕ ሺቅዛ ዎደ ይ ሺቂ ሚዛይ ጎዳይ ካሆ ባያ። <verse eid="1CO 11:20"/><verse number="21" style="v" sid="1CO 11:21"/>ይ ካ ሚዝ ዎደ ፐታይ ፐታ ናገካ ፓሳ ፓሳ ሚዝ ግሾስ ፐታይ ናይንትዛ Ꮊንካይ ማ ማዛ። <verse eid="1CO 11:21"/><verse number="22" style="v" sid="1CO 11:22"/>ቱማ ይ ማዳይኔ ኡዦዳይስ ይንትስ ካራ ባሳ? ዎይ ጾስ ዎሳ ኬ ካኔ? አኮካ ባ ማንቅታ ዬላዳይሶኔ? ታ ይንታን ዋጎ? Ꮊይር ታ ይንታን ናሽቾ? ናሽቻሚ።<verse eid="1CO 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 11:23"/>ታኒ ይንትስ እንጌዝ ትምርትታ ጎዳይፕ ኤኬዛ። ጎዳ የሱሳ ኣ እንግንትዝ ቃማ ቦራ ኤኪ፥ <verse eid="1CO 11:23"/><verse number="24" style="v" sid="1CO 11:24"/>ጾስ ጋላቲ። ቦራ ባጺ «Ꮊሽተ፤ ሞይታ። Ꮊይ ይንትስ እንግንትዛ ታ አሾ። Ꮊያ ሚታር ታና ቆፖይታ» ዬጌዛ። <verse eid="1CO 11:24"/><verse number="25" style="v" sid="1CO 11:25"/>የይ ጋርከካ፥ ካሃ ም ማቅን፥ ጹአ ኤኪ፥ «Ꮊ ጹአይ ታ ሱር ጫቅዝ ኦሮ ጫቆ። ይ ኤዛይፕ ኡዥታር ኡባ ዎደ ታና ቆፖይታ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">11:25 </char><char style="xt" closed="false"><ref loc="EXO 24:6-8">ከስ 24:6-8</ref>፤ <ref loc="JER 31:31-34">ኤርም. 31:31-34</ref></char></note> <verse eid="1CO 11:25"/><verse number="26" style="v" sid="1CO 11:26"/>ይ Ꮊ ቦራ ሚዝ ዎደኔ Ꮊ ጹአ ኡዥዝ ዎደ ኡባይድ ጎዳይ የኦድ ሄሎዳይስ ኤ Ꮊይቃ ኦዶዳ።<verse eid="1CO 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 11:27"/>የይ ግሾስ፥ ቤዞዋ ኦገር ጎዳይ ቦራ ሚዝ ዎይ ጎዳይ ጹአ ኡዥዝ ኦንካ ኤዝ አሻኔ ሱ ቶቼዝ ግሾስ ፋ ናጋራይስ ኦይጭንትዛ። <verse eid="1CO 11:27"/><verse number="28" style="v" sid="1CO 11:28"/>ዝን አስ ፋና ፋጮ። ዬዚ ቦራ ሙዬ፤ ጹአይፐካ ኡዦ። <verse eid="1CO 11:28"/><verse number="29" style="v" sid="1CO 11:29"/>ጎዳይ አሻይ ባጋ ሻኪ ኤረካ፥ ቦራ ሚኮኔ ጹአይፕ ኡዥኮ፥ ፋል አፋ ፕርዳ ሺሽዛ። <verse eid="1CO 11:29"/><verse number="30" style="v" sid="1CO 11:30"/>የይ ግሾስ፥ ይ ጋንጨፕ ጋምታይ ዳቡሬዛ፤ ሀርግንቴዛ፤ ማ ጋመ አስታይ Ꮊይቄዛ። <verse eid="1CO 11:30"/><verse number="31" style="v" sid="1CO 11:31"/>ዝን ኑ ኑና ፓጪ በኤዝ ባዝ ማቄዛኮ፥ ኑል አፋ ፕርድንታሚ። <verse eid="1CO 11:31"/><verse number="32" style="v" sid="1CO 11:32"/>አላመ ፕርድንትዛ ዎደ ኑ አላማይራ ፕርድንታማይ ጋርክ Ꮊት ጎዳይ ኑና ሴርዛ።<verse eid="1CO 11:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 11:33"/>የይ ግሾስ፥ ታ እሹን፥ ጎዳይ ካሆ ማዳይስ ይ ሺቅዛ ዎደ ዎል ናጎይታ። <verse eid="1CO 11:33"/><verse number="34" style="v" sid="1CO 11:34"/>ይ ሺቃይ ፕርዳስ ማቃማይ ጋርክ ናይንቴዝ ኦንካ የዝኮ፥ ፋ ካራ ሙየ።</para>
  <para style="p" vid="1CO 11:34">አቴዝባዝ ታኒ ገድ Ꮊንጊ ይንትስ ኦዶዳ።<verse eid="1CO 11:34"/></para>
  <chapter eid="1CO 11"/>
  <chapter number="12" style="c" sid="1CO 12"/>
  <para style="s1">ጌሻ አያና እሞትታ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1"/>ታ እሹን፥ ጌሻ አያና እሞትታይ ባዝካ ይ ኤሮዳይ ጋርክ ታ ኮይዛ። <verse eid="1CO 12:1"/><verse number="2" style="v" sid="1CO 12:2"/>ይ ጾስ አማኖዋ ዎደ ዶና ባ ኤቃኮ ጎሽንት፥ ይ ኤሮዋዝታይራካ Ꮊንጌዛና ይ ኤርዛ። <verse eid="1CO 12:2"/><verse number="3" style="v" sid="1CO 12:3"/>ጾስ አያናይ ካልዛ አስ ኦንካ፥ «የሱስ ቃንግንቶ» ዬጎያ። ማ ጌሻ አያናይ ካልካዝን፥ ኦንካ፥ «የሱስ ጎዳ» ጎዳይስ ዳንዳኦዛና ይ ኤሮዳይ ጋርክ ታ ኮይዛ።<verse eid="1CO 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 12:4"/>ዱማ ዱማ አያና እሞትታይ የዛ፥ ዝን እሞትታ እንግዛ አያናይ ፐታ።<note caller="-" style="x"><char style="xo" closed="false">12:4-11 </char><char style="xt" closed="false"><ref loc="ROM 12:6-8">ኦሮ. 12:6-8</ref></char></note> <verse eid="1CO 12:4"/><verse number="5" style="v" sid="1CO 12:5"/>ኑ ጎዳይስ ኦዛ ዱማ ዱማ ኦስታይ የዛ፥ ዝን ጎዳይ ፐታ። <verse eid="1CO 12:5"/><verse number="6" style="v" sid="1CO 12:6"/>ኑ ጎዳይስ ኦዛ ዱማ ዱማ ኦግታይ የዛ፥ ዝን የ ኦጋይር አስ ኡባይር ኦዝ ጾሳይ ፐታ። <verse eid="1CO 12:6"/><verse number="7" style="v" sid="1CO 12:7"/>ዝን ፐታይስ ፐታይስ እንግንቴዝ ቆንጭ እሞትታይ ዎላ ማድንቶዳይ ጋርክ።<verse eid="1CO 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 12:8"/>ጌሻ አያናይ ፐታይስ ኤጨት ኩሜዝ ቃላ እንግዛ፤ ማ ፐታይስ ኤራት ኩሜዝ ቃላ እንግዛ። <verse eid="1CO 12:8"/><verse number="9" style="v" sid="1CO 12:9"/>የ ጌሻ አያናይ ፐታይስ አማኖ፥ Ꮊንካይስ ማ ፓዛ ዎልቃ እንግዛ። <verse eid="1CO 12:9"/><verse number="10" style="v" sid="1CO 12:10"/>ጌሻ አያናይ ፐታይስ ማላታ ኦዛ ዎልቃ፥ ፐታይስ ትንቢተ ኦድዛ ዎልቃ እንግዛ። ፐታይስ አያናፕ አያና ሻኪ ኤርዛ ዎልቃ፥ ፐታይስ ዱማ ዱማ ዶናር ኦድዛ ዎልቃ፥ ማ ፐታይስ ዱማ ዱማ ዶናር ኦድንቴዛና ብልዝ ዎልቃ እንግዛ። <verse eid="1CO 12:10"/><verse number="11" style="v" sid="1CO 12:11"/>ዝን Ꮊ ኡባ ኦዛይ የ ፐቲ ጌሻ አያና። ኤ ኮዬዛይ ጋርክ ፐታይስ ፐታይስ ዱማ ዱማ እሞታ እንግዛ።<verse eid="1CO 12:11"/></para>
  <para style="s1">ፐቲ አሰትል ዱማ ዱማ ብልትታ</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 12:12"/>ፐቲ አሰትል ጋመ ብልትታይ የዛ፥ ዝን የ ዱማ ዱማ ብልትታይ ፐቲ አሰት ማቅዛ። የይ ጋርከካ፥ ክርስቶሳ ዱማ ዱማ ብልትታይ የዝ ፐቲ አሰት ጋርከ።<note caller="-" style="x"><char style="xo" closed="false">12:12 </char><char style="xt" closed="false"><ref loc="ROM 12:4-5">ኦሮ. 12:4-5</ref></char></note> <verse eid="1CO 12:12"/><verse number="13" style="v" sid="1CO 12:13"/>ኑኒ አይሁደ ማቅን ግርኬ ማቅን አይለ ማቅን ዎማኖ ማቅን፥ ኡባይ ፐቲ አሰት ማቆዳይስ ጌሻ አያናር ጻማቅንቴዛ። ማ ኑ ኡባይ ፐቲ ጌሻ አያና ኤኬዛ።<verse eid="1CO 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 12:14"/>ኑ አሰትል ዱማ ዱማ ብልትታይ የዛፕ አትን ፐቲ ብልተ ኣዳ ባያ። <verse eid="1CO 12:14"/><verse number="15" style="v" sid="1CO 12:15"/>ቶካይ፥ «ታኒ ኩሸ ማቀካ ግሾስ ብልተ ባያ» ጊኮ፥ ኤ የያ ጌዝ ግሾስ ብልተትይ አትኔ? <verse eid="1CO 12:15"/><verse number="16" style="v" sid="1CO 12:16"/>ሀየ፥ «ታኒ ኣፈ ማቀካ ግሾስ ብልተ ባያ» ጊኮ፥ ኤ የያ ጌዝ ግሾስ አሰትፕ ፐቲ ብልተ ማቅይ አትነኔ? <verse eid="1CO 12:16"/><verse number="17" style="v" sid="1CO 12:17"/>አሰት ኡባይ ኣፈ ኣዳ ማቅኮ፥ ኑ አባር ስኦዴ? ማ አሰት ኡባይ ሀየ ኣዳ ማቅኮ ኑ አባር ስንጎደ?<verse eid="1CO 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 12:18"/>ዝን ጾሳይ ፋ ኮዬዛይ ጋርክ፥ አሰት ጋንጨ ዱማ ዱማ ብልትታ ጋዴዛ። <verse eid="1CO 12:18"/><verse number="19" style="v" sid="1CO 12:19"/>ኡባይ ፐቲ ብልተ ማቄዛኮ አሰት አናፕ በንቶደ? <verse eid="1CO 12:19"/><verse number="20" style="v" sid="1CO 12:20"/>ዝን ብልትታይ ጋመ ማቅኮካ፥ አሰትይ ፐቶ።<verse eid="1CO 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 12:21"/>ኣፈ ኩሸኮ፥ «ነ ታስ ኮሾያ» ጎዳይስ ዳንዳኦያ፥ ዎይ ኦማ ቶሄኮ፥ «ነ ታስ ቤዞያ» ጎዳይስ ዳንዳኦያ። <verse eid="1CO 12:21"/><verse number="22" style="v" sid="1CO 12:22"/>ዝን ዳቡራ ኣዝዝ አሰት ብልትታይ ኑስ ኡሳ ኮሽዛ። <verse eid="1CO 12:22"/><verse number="23" style="v" sid="1CO 12:23"/>ቦንቾ ኮሾዋ ግ ኑ ቆፕዛ ኑ ብልትታ ሎእ ቦንቾዳ። ማ ኑ ቦርስንትዛ ኑ አሰት ብልትታ ኣ ቦንቺ ናጎዳ። <verse eid="1CO 12:23"/><verse number="24" style="v" sid="1CO 12:24"/>ኑ ብእን ቦርሶዋ አሰት ብልታይስ ቦንቾ ኮሾያ። ዝን ጾሳይ ኑ አሰት ብልትታ ዎል ሄል ቦርስዛ ብልታይስ ኣዝ ቦንቾ እንጌዛ። <verse eid="1CO 12:24"/><verse number="25" style="v" sid="1CO 12:25"/>አሰት ብልትታይ ፐታይ ፐታይር ሻኮ መካ ዎል ቆፖዳይ ጋርክ ኡዲ መዛ። <verse eid="1CO 12:25"/><verse number="26" style="v" sid="1CO 12:26"/>አሰት ብልትታይፕ ፐታይ ሀርግንትኮ ብልትታይ ኡባይ ኤዛር ሀርግንትዛ። አሰት ብልትታይፕ ፐታይ ቦንችንትኮ ብልትታይ ኡባይ ኤዛር ኡፋይትዛ።<verse eid="1CO 12:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 12:27"/>ይ ኡባይ ክርስቶሳ አሰት፤ ማ ይ ፐታይ ፐታይ ኤ ብልትታ። <verse eid="1CO 12:27"/><verse number="28" style="v" sid="1CO 12:28"/>ዎሳ ኬ ጾሳይ፥ ቲና ሀዋርታ፥ ናምእን ናብታ፥ ሃይን አስታማርታ፥ ካሊ ማላትታ ኦዝታ፥ ፓዝታ፥ Ꮊንክታ ማድዝታ፥ ዎሳ ኬ አቅዝታኔ፥ ዱማ ዱማ ዶናር ኦድዝታ ጋዴዛ።<note caller="-" style="x"><char style="xo" closed="false">12:28 </char><char style="xt" closed="false"><ref loc="EPH 4:11">ኤፍ. 4:11</ref></char></note> <verse eid="1CO 12:28"/><verse number="29" style="v" sid="1CO 12:29"/>ኡባይ ሀዋረ? ኡባይ ናበ? ኡባይ አስታማረ? ኡባይ ማላታ ኡድነ? <verse eid="1CO 12:29"/><verse number="30" style="v" sid="1CO 12:30"/>ኡባይ ፓኔ? ኡባይ ዱማ ዱማ ዶናር ኦድንትኔ? ኡባይ ዱማ ዱማ ዶናር ኦድንትዛና ብልእኔ? <verse eid="1CO 12:30"/><verse number="31" style="v" sid="1CO 12:31"/>ዝን ኡባይፕ ኣዝ እሞታ ሚን ኮዮይታ።</para>
  <para style="p" vid="1CO 12:31">ማ ኡባይፕ ኣዝ ኦጋ ታ ይንታን ቤዞዳ።<verse eid="1CO 12:31"/></para>
  <chapter eid="1CO 12"/>
  <chapter number="13" style="c" sid="1CO 13"/>
  <para style="s1">ቱማ ሲቆ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 13:1"/>ታኒ አስ ዶናራኔ ኪታንቾ ዶናር ኦድንቶዳይስ ዳንዳእኮካ፥ ታስ ሲቆ ብኮ፥ ጊርዝ ዳላ ዎይ ኦሽዝ ዎርለ ጋርከ። <verse eid="1CO 13:1"/><verse number="2" style="v" sid="1CO 13:2"/>ትንቢተ ኦድዝ እሞታ ታስ የዝኮካ፥ ጹራ ኡባ ኤርኮካ፥ ኤራት ኡባይ የዝኮካ፥ ማ አምባ ደን ሀራ አቆ ካንግዛ አማኖ ታስ የዝኮካ፥ ሲቆ ብኮ፥ ታ ጨር ሀንዛ።<note caller="-" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="MAT 17:20">ማቶ. 17:20</ref>፤ <ref loc="MAT 21:21">21:21</ref>፤ <ref loc="MRK 11:23">ማር. 11:23</ref></char></note> <verse eid="1CO 13:2"/><verse number="3" style="v" sid="1CO 13:3"/>ታስ የዛ ባዝ ኡባ ማንቆስ እንግኮካ፥ ሀራ አቶዝን፥ ታና ታማስ ኣ እንግኮካ፥ ሲቆ ብኮ ታና አኮካ አዳሚ።<verse eid="1CO 13:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 13:4"/>ሲቆ ዳንዳእዛ። ሲቆ ኬሃ። ሲቆ ቃናቶያ። ሲቆ ጬቅንቶያ። ሲቆ ኡትርቶያ። <verse eid="1CO 13:4"/><verse number="5" style="v" sid="1CO 13:5"/>ሲቆ ቤዞዋባዝ ኦያ። ሲቆ ኡዛቶያ። ሲቆ ይሎቶያ። ሲቆ ቆሆ ፓይዶያ። <verse eid="1CO 13:5"/><verse number="6" style="v" sid="1CO 13:6"/>ሲቆ ቱማር ኡፋይትነፕ አትን ዎርዠር ኡፋይቶያ። <verse eid="1CO 13:6"/><verse number="7" style="v" sid="1CO 13:7"/>ሲቆ ኡባ ዳንዳእዛ፤ ኡባ አማንዛ፤ ሎኦ ባዝ ሀኖዳ ግ፥ ኡፋይሳር ናግዛ፤ ኡባ ባዛር ሚንግዛ።<verse eid="1CO 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 13:8"/>ሲቆ ዉርስ ሄሎዳይስ ቦያ። ዝን ትንቢተ አቶዳ፤ ዱማ ዱማ ዶናር ኦድንትዛይ አቶዳ፤ ኤራትይካ ኣዳ። <verse eid="1CO 13:8"/><verse number="9" style="v" sid="1CO 13:9"/>ኑ ኤራትፕ ላፋ ኤርዛ፤ ትንቢተፕ ባጋ ኦድዛ። <verse eid="1CO 13:9"/><verse number="10" style="v" sid="1CO 13:10"/>ዝን ፎሎ ማቄዛይ የኤዝ ዎደ ፎሎ ባዛይ አቶዳ።<verse eid="1CO 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 13:11"/>ታኒ ናአዛር ናአ ጋርክ ናሽዛ፤ ናአ ጋርክ ቆፕዛ፤ ናአ ጋርክ አካክዛ። ታ ዎዛናማ ማቄዝ ዎደ ናአት ሀና አሼዛ። <verse eid="1CO 13:11"/><verse number="12" style="v" sid="1CO 13:12"/>Ꮊት ፖኦ ባ አቆ ማስቶተር ብእዛይ ጋርክ ኑ ብእዛ፥ ዝን የ ዎደ ኑ ቆንጨር በአዳ። Ꮊት ኑ ኤረትፕ ጽቃ ኤርዛ፥ ዝን የ ዎደ ጾሳይ ኑና ኤርዛይ ጋርክ ፎሎ ኤሮዳ።<verse eid="1CO 13:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 13:13"/>ይኬ፥ አማኖ፥ ኡፋይስኔ ሲቆ፥ Ꮊ ሃይታይ ኤቂ የዞዳ። ዝን Ꮊይትታይፕ ኣዛይ ሲቆ።<verse eid="1CO 13:13"/></para>
  <chapter eid="1CO 13"/>
  <chapter number="14" style="c" sid="1CO 14"/>
  <para style="s1">ትንቢተኔ ዱማ ዱማ ዶናር ኦድንቶ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1"/>ሲቆ ካሎይታ። አያና እሞትታ ሚን ኮዮይታ፤ ኡባፕ ኣ፥ ትንቢተ እሞታ ሚን ኮዮይታ። <verse eid="1CO 14:1"/><verse number="2" style="v" sid="1CO 14:2"/>ዱማ ዱማ ዶናር ኦድንትዛ አሲ ጾሳይስ ኦድዛፕ አትን አስስ ኦዶያ። ዝን አስስ ቆንጨካ ጹራ አያና ዎልቃር ኦድንትዛ ግሾስ ኦንካ ኤ ኦድንትዛና አካኮያ። <verse eid="1CO 14:2"/><verse number="3" style="v" sid="1CO 14:3"/>ዝን ትንቢተ ኦድዝታይ አስ ድቾዳይስ፥ ምንዳይስኔ ጻልሶዳይስ አስስ ኦድዛ። <verse eid="1CO 14:3"/><verse number="4" style="v" sid="1CO 14:4"/>ዱማ ዱማ ዶናር ኦድዛ አስ ፋና ድችዛ። ዝን ትንቢተ ኦድዛ አስ ዎሳ ኬ ድችዛ።<verse eid="1CO 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 14:5"/>ይ ኡባይ ዱማ ዱማ ዶናር ኦድንትዛኮ ታ ዶስዛ፥ ዝን ትንቢተ ኦድዛኮ ታ ኡሳ ዶስዛ። ዱማ ዱማ ዶናር ኦድንትዛና ዎሳ ኬ ድችስ ብልእዝ አስ ብኮ፥ ዱማ ዱማ ዶና ኦድንትዛይፕ ትንቢተ ኦድዛይ ኣዛ።<verse eid="1CO 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 14:6"/>ዝን ታ እሹን፥ ታኒ ይንትኮ Ꮊንጊ ቆንጭር ዎይ ኤራትር ዎይ ትንቢተ ኦዶር ዎይ ትምርተ ባይ ዱማ ዱማ ዶናር ኦደንትኮ ይንታን አብ ማዶዴ? <verse eid="1CO 14:6"/><verse number="7" style="v" sid="1CO 14:7"/>ዱማ ዱማ የ ሚሻይስ ፐቲ ግር የዝኮ፥ ሹልሹሎ ግርስነ ዲ ግርስ ዋይዚ ሻኪ ኤሮዴ? <verse eid="1CO 14:7"/><verse number="8" style="v" sid="1CO 14:8"/>ማ ቱልቱሎ ፑጎ ሻኪ ኤርንታም እጽኮ ኦላስ ጊግንትዛይ ኦኖ? <verse eid="1CO 14:8"/><verse number="9" style="v" sid="1CO 14:9"/>የይ ጋርከካ፥ ዱማ ዱማ ዶናር ይ ኦድንትዛይ ቆንጨ ማቃም እጽኮ ይ ኦድዛ ኦኒ ኤሮዴ? የይ ጫርኮር ኦድንትዛይ ጋርከ።<verse eid="1CO 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 14:10"/>Ꮊ አላመል ጋመ ዶንታይ የዛ፤ የ ኡባይስ ብልእ የዛ። <verse eid="1CO 14:10"/><verse number="11" style="v" sid="1CO 14:11"/>ዝን ፐቲ አሲ ኦድንትዛ ዶና ታኒ ኤራም እጽኮ ኤ ታስ እማ ማቅዛ፤ ታካ ኤስ እማ ማቅዛ። <verse eid="1CO 14:11"/><verse number="12" style="v" sid="1CO 14:12"/>የይ ጋርከካ፥ ጌሻ አያና እሞታ ይ ኤኮዳይስ ሚን ኮይኮ፥ ዎሳ ኬ ድቻይስ ኡባፕ ኣዝ እሞታ ኮዮይታ።<verse eid="1CO 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 14:13"/>ዱማ ዱማ ዶናር ኦድንትዛ አስ ፋ ኦዳ ብሎዳይስ ብርሽ እሞታይ እንግንቶዳይ ጋርክ ጾሳ ዎሶ። <verse eid="1CO 14:13"/><verse number="14" style="v" sid="1CO 14:14"/>ታኒ ዱማ ዱማ ዶናር ጾስ ዎስኮ፥ ታ አያናይ ዎስዛ፥ ዝን ታ ዎዝናይ አኮካ ማድንቶያ። <verse eid="1CO 14:14"/><verse number="15" style="v" sid="1CO 14:15"/>የዝን፥ ታ አብ ኦዳይስ ኮሼ? ታኒ ታ አያናር ዎስዛ፤ ታ ካሃይራካ ዎስዛ። ታኒ ታ አያናር የጽዛ፤ ታ ካሃይራካ የጽዛ። <verse eid="1CO 14:15"/><verse number="16" style="v" sid="1CO 14:16"/>የያ ማቃም እጽኮ ኔኒ ነ አያናር ጾስ ጋላትዛ ዎደ የ አቃይድ ኔኒ ግዛ ኤረካ አስ ነ ጋላትዛ ዎደ፥ «አምንኤ» ጎደ? <verse eid="1CO 14:16"/><verse number="17" style="v" sid="1CO 14:17"/>ኔኒ ጾስ ጋላትዛይ ሎኦ፥ ዝን ሀራ አስ ማዶያ።<verse eid="1CO 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 14:18"/>ታ ይ ኡባይፕ ኣ ዱማ ዱማ ዶናር ኦድንትዛ ግሾስ ጾስ ጋላትዛ። <verse eid="1CO 14:18"/><verse number="19" style="v" sid="1CO 14:19"/>ዝን ታኒ ዎሳ ኬ ሀርታ ታማርሶዳይስ ዱማ ዱማ ዶናር ታጲ ሙኩሎ ቃላ ኦድንትዛይፕ ኤርንትዛ ዶናር እችን ቃላ ኦዶ ዶስዛ።<verse eid="1CO 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 14:20"/>ታ እሹን፥ ይ ኢታ ቆፋስ ናእታይ ጋርክ ማቆይታፕ አትን ቆፓር ናአ ማቅፓተ ዎዛናምታ ማቆይታ። <verse eid="1CO 14:20"/><verse number="21" style="v" sid="1CO 14:21"/>ጎዳይ፥ ጌሻ ማጻፋይድ፥</para>
  <para style="q1" vid="1CO 14:21">«ታኒ Ꮊ አሳይስ፥</para>
  <para style="q2" vid="1CO 14:21">ዱማ ዱማ ዶናር ኦድንትዛ አሳይራኔ</para>
  <para style="q2" vid="1CO 14:21">እማ ዶናር ኦድንትዛ አሳይር ኦድዛ።</para>
  <para style="q1" vid="1CO 14:21">ዝን የይ ሀንንካ ታና ስኦያ» ዬግዛ።<note caller="-" style="x"><char style="xo" closed="false">14:21 </char><char style="xt" closed="false"><ref loc="ISA 28:11-12">ኢሳ. 28:11-12</ref></char></note><verse eid="1CO 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 14:22"/>ይኬ፥ ዱማ ዱማ ዶናር ኦዳይ፥ አማኖዋ አሳይስ ማላ ማቅነፕ አትን አማንዛ አሳይስ ባያ። ትንቢተ አማንዛ አሳይስ ማላ ማቅነፕ አትን አማኖዋ አሳይስ ባያ።<verse eid="1CO 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 14:23"/>ዎሳ ኬ አሳይ ፐትፕ ሺቄዝ ዎደ ኡባይ ዱማ ዱማ ዶናር ኦድንትኮ ኤሮዋ ዎይ አማኖዋ አሳይ ይ ሺቆ ይኢ፥ «Ꮊይትታይ ኤይዛ» ጎሳነ? <verse eid="1CO 14:23"/><verse number="24" style="v" sid="1CO 14:24"/>ዝን ኤሮዋ ዎይ አማኖዋ አሳይ ዎሳ ኬ ገልዛ ዎደ አሳይ ትንቢተ ኦዶዳር፥ ስእኮ ፋ ናጋራ አካኮዳ፤ ማ ኤ ስኤዝ ቃላይድ ፕርድንቶዳ። <verse eid="1CO 14:24"/><verse number="25" style="v" sid="1CO 14:25"/>ኡንቲ ኤ ዎዛና ጌሜዝ ቆፋ ቆንጭሶዳ። የይ ጋርከካ፥ «ቱማ ጾሳይ ይ ጋንጨ የዛ» ዬጊ ማርካቲ፥ ጹጉኒ ጾሳይስ ጎይኖዳ።<verse eid="1CO 14:25"/></para>
  <para style="s1">ጎይኖ ዎጋ</para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 14:26"/>ታ እሹን፥ ኑ ዋጎ? ይ ፐትፕ ሺቅዛ ዎደ ፐታይስ ማዝሙረ የዛ፤ ፐታይስ ታማርሶ እሞታይ የዛ፤ ፐታይስ ቆንጭ የዛ፤ ፐታይስ ዱማ ዱማ ዶናር ኦድንቶ የዛ፤ ፐታይስ ብልእዝ እሞታይ የዛ። የ ኡባይ ዎሳ ኬና ድችዛባዝ ማቆዳይስ ቤዝዛ። <verse eid="1CO 14:26"/><verse number="27" style="v" sid="1CO 14:27"/>ዱማ ዱማ ዶናር ኦድንትዛ አስታይ የዝኮ፥ ናምኤ ዎይ ጋንግኮ ሀይዝ ማቅኮ ማራር ማራር ናግንቲ ኦዶዳይስ ቤዝዛ። ኡንቲ ኦድንትዛና ሀራ አስ ብሎ። <verse eid="1CO 14:27"/><verse number="28" style="v" sid="1CO 14:28"/>ዝን ብልዝ አስ ብኮ፥ ዱማ ዱማ ዶናር ኦድንትዛይ ዎሳ ኬ ስእ ጎ። ፋስኔ ፋ ጾሳይስ ኦዶ።<verse eid="1CO 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 14:29"/>ትንቢተ ኦድዝታይ ናምኤ ዎይ ሀይዝ ማቂ ኦዶ። ማ Ꮊንክታይ ኡንቲ ግዝባዝ ሻኮ። <verse eid="1CO 14:29"/><verse number="30" style="v" sid="1CO 14:30"/>የ ሺቃይድ የዝ ሀራ አስስ ፐትባዝ ቆንጭኮ ቲና ኦድንትዛይ ስእ ጎ። <verse eid="1CO 14:30"/><verse number="31" style="v" sid="1CO 14:31"/>ኡባይ ታማሮዳይ ጋርከኔ ኡባይ ሚንጎዳይ ጋርክ ማራር ማራር ትንቢተ ኦዶዳይስ ዳንዳእዛ። <verse eid="1CO 14:31"/><verse number="32" style="v" sid="1CO 14:32"/>ናብታይ አያናይ ናብታይስ አዛዝንትዛ። <verse eid="1CO 14:32"/><verse number="33" style="v" sid="1CO 14:33"/>ጾሳይ ሳሮት ጾሳፕ አትን ጫቦ ጾስ ባያ። ጌሽታይ ዎሳ ኬታይ ኡባይ የይጋርከ።<verse eid="1CO 14:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="1CO 14:34"/>ማችታይ ዎሳ ኬ ሺቆ ስእ ጎ። ህገ ግዛይ ጋርክ ኡንቲ ሃርንቶፕ አትን ዎሳ ኬ ኦዶዳይስ ኡንትስ ማዉተ ባያ። <verse eid="1CO 14:34"/><verse number="35" style="v" sid="1CO 14:35"/>ማችታይ ዎሳ ኬ ኦድንቶ ቦርሶ ማቄዝ ግሾስ ፐቲ ፐትባዝ ኤሮዳይስ ኮይኮ ካራ ፋ አዝና ኦይጮ።<verse eid="1CO 14:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 14:36"/>ጾስ ቃላ ቲና ይ ከኤኔ? ዎይ ጾስ ቃላይ ይ ኣዳኮ የኤኔ? <verse eid="1CO 14:36"/><verse number="37" style="v" sid="1CO 14:37"/>ኦንካ ፋና ናበ ዎይ ፋና ጾስ አስ ግ ቆፕኮ፥ ታኒ ይንትስ ጻፌዛይ ጎዳይ አዛዞ ማቄዛና አካኮ። <verse eid="1CO 14:37"/><verse number="38" style="v" sid="1CO 14:38"/>ዝን ኦንካ ኤራም እጽኮ ኤካ ኤርንትፐ።<verse eid="1CO 14:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 14:39"/>የይ ግሾስ፥ ታ እሹን፥ ትንቢተ ኦዶዳይስ ሚን አሞቶይታ፤ ማ ዱማ ዱማ ዶናር ኦድንታካ ካይፓተ። <verse eid="1CO 14:39"/><verse number="40" style="v" sid="1CO 14:40"/>ዝን ኡባይካ ዎጋራኔ ማራር ማቆ።<verse eid="1CO 14:40"/></para>
  <chapter eid="1CO 14"/>
  <chapter number="15" style="c" sid="1CO 15"/>
  <para style="s1">ክርስቶሳ Ꮊይቆፕ ደንዶ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1"/>ታ እሹን፥ ታ ይንትስ ማርካቴዝ ዎንግለ ይ ኤኬዛኔ ይ አማናይድ ሚንጊ ኤቄዛና ይ አካኮዳይ ጋርክ ታ ኮይዛ። <verse eid="1CO 15:1"/><verse number="2" style="v" sid="1CO 15:2"/>ታ ታማርሴዝ ዎንግለ ሚን አይክኮ ይ ኤዛይር አቶዳ። የይ ሀናም እጽኮ ይ አማናይ ጨረ ማቃዳ።<verse eid="1CO 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 15:3"/>ታኒ ኤኬዝ ኡባይፕ ኣዝ ኪታ ቲናቲ ይንትስ እንጌዛ። የይካ፥ ጌሻ ማጻፋይ ግዛይ ጋርክ፥ ክርስቶሳ ኑ ናጋራ ግሾስ Ꮊይቄዛ።<note caller="-" style="x"><char style="xo" closed="false">15:3 </char><char style="xt" closed="false"><ref loc="ISA 53:5-12">ኢሳ. 53:5-12</ref></char></note> <verse eid="1CO 15:3"/><verse number="4" style="v" sid="1CO 15:4"/>ሞግንቴዛ፤ ጌሻ ማጻፋይ ግዛይ ጋርክ፥ ሃይን ጋላስ Ꮊይቆፕ ደንዴዛ።<note caller="-" style="x"><char style="xo" closed="false">15:4 </char><char style="xt" closed="false"><ref loc="PSA 16:8-10">ማዝ. 16:8-10</ref>፤ <ref loc="MAT 12:40">ማቶ. 12:40</ref>፤ <ref loc="ACT 2:24-32">ሀዋ. ኦ. 2:24-32</ref></char></note> <verse eid="1CO 15:4"/><verse number="5" style="v" sid="1CO 15:5"/>ጵጽሮሳስ ቆንጬዛ። የይፕ ጉየ፥ ታጶ ናምኢ ሀዋርታይስ በንቴዛ።<note caller="-" style="x"><char style="xo" closed="false">15:5 </char><char style="xt" closed="false"><ref loc="MAT 28:16-17">ማቶ. 28:16-17</ref>፤ <ref loc="MRK 16:14">ማር. 16:14</ref>፤ <ref loc="LUK 24:34">ሉቃ. 24:34</ref>፥ <ref loc="LUK 24:36">36</ref>፤ <ref loc="JHN 20:19">ዋን. 20:19</ref></char></note> <verse eid="1CO 15:5"/><verse number="6" style="v" sid="1CO 15:6"/>እችን ጼታፕ ጋንግዛ አማንዝታይስ ፐቲ ቶኬ በንቴዛ። ኡንታፕ ጋምታይ Ꮊኖ ሄሎዳይስ ፓጻ የዛ፥ ዝን ጽቅታይ Ꮊይቄዛ። <verse eid="1CO 15:6"/><verse number="7" style="v" sid="1CO 15:7"/>የይፕ ጉየ፥ ያይቆባስ በንቴዛ፤ ጉየፐካ ፋ ሀዋርታይስ ኡባይስ በንቴዛ።<verse eid="1CO 15:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 15:8"/>ማ ዉርስ ቡል ጋርክ ማቄዝ ታስ በንቴዛ።<note caller="-" style="x"><char style="xo" closed="false">15:8 </char><char style="xt" closed="false"><ref loc="ACT 9:3-6">ሀዋ. ኦ. 9:3-6</ref></char></note> <verse eid="1CO 15:8"/><verse number="9" style="v" sid="1CO 15:9"/>ታኒ የሱሳ ሀዋርታይ ኡባይፕ ላፋ። ታኒ ጾስ ዎሳ ኬ ባይእዝ ግሾስ የሱሳ ሀዋረ ግንትንቲ ጼግንቶዳይስ ቤዞዋዛ።<note caller="-" style="x"><char style="xo" closed="false">15:9 </char><char style="xt" closed="false"><ref loc="ACT 8:3">ሀዋ. ኦ. 8:3</ref></char></note> <verse eid="1CO 15:9"/><verse number="10" style="v" sid="1CO 15:10"/>ዝን ጾስ ኣ ኬሃትይድ Ꮊት ማቄዛይ ታና፤ ኤ ታስ እንጌዝ ኣ ኬሃትይ ጨር አተካያ። ታኒ Ꮊንኮ ሀዋርታይፕ ኣ ዳቡሬዛ። ዝን ታራ የዝ ጾስ ኣ ኬሃትይ ኦነፕ አትን ታና ባያ። <verse eid="1CO 15:10"/><verse number="11" style="v" sid="1CO 15:11"/>ይኬ፥ ታና ማቅን ኡንቲ፥ ኑ ኡባይ ታማርስዛይ የያ፤ ይንትካ የ ኪታ አማኔዛ።<verse eid="1CO 15:11"/></para>
  <para style="s1">Ꮊይቆፕ ደንዶ</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 15:12"/>ክርስቶሳ Ꮊይቆፕ ደንዴዛና ኑ ሳባክዛ ዎደ ይንትፕ ፐታይ ፐታይ የዝን፥ ዋይዚ፥ «Ꮊይቆፕ ደንዶ ባያ» ዬግኔ? <verse eid="1CO 15:12"/><verse number="13" style="v" sid="1CO 15:13"/>Ꮊይቆፕ ደንዶ ባባዝ ማቅኮ ክርስቶሳ Ꮊይቆፕ ደንደካ ጉሲ። <verse eid="1CO 15:13"/><verse number="14" style="v" sid="1CO 15:14"/>ክርስቶሳ Ꮊይቆፕ ደንደካባዝ ማቅኮ ኑ ትምርታይካ ይ አማናይካ ጨረ። <verse eid="1CO 15:14"/><verse number="15" style="v" sid="1CO 15:15"/>Ꮊይቆፕ ደንዶ ባዝን፥ ኑኒ ጾሳይ፥ «ክርስቶሳና Ꮊይቆፕ ደንዛ» ዬጊ ሳባክታር ዎርዶ ጾስ ማርክታ ማቄዝ ጉሲ። <verse eid="1CO 15:15"/><verse number="16" style="v" sid="1CO 15:16"/>Ꮊይቄዝ አሳይ Ꮊይቆፕ ደንዶዋባዝ ማቅኮ ይኬ፥ ክርስቶሳ Ꮊይቆፕ ደንደካያ። <verse eid="1CO 15:16"/><verse number="17" style="v" sid="1CO 15:17"/>ክርስቶሳ Ꮊይቆፕ ደንደካባዝ ማቅኮ፥ ይ አማናይ ጨረ፤ ማ ይ Ꮊኖ ሄሎዳይስ ይ ናጋራራ የዛ። <verse eid="1CO 15:17"/><verse number="18" style="v" sid="1CO 15:18"/>ይኬ፥ ክርስቶሳ አማኒ Ꮊይቄዝታይካ ቤዛ ጉሲ። <verse eid="1CO 15:18"/><verse number="19" style="v" sid="1CO 15:19"/>ኑኒ Ꮊ አላመ የስ ኣዳስ ክርስቶሳር ኡፋይሳ ኦዝባዝ ማቅኮ፥ Ꮊ ሳአል የዝ አስ ኡባይፕ ኑባዝ ኣ አዛንዛባዝ ማቃዳ።<verse eid="1CO 15:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 15:20"/>ዝን ክርስቶሳ Ꮊይቄዝታይስ Ꮊይቆፕ ደንዶር ባይራ ማቂ ቱማ ደንዴዛ። <verse eid="1CO 15:20"/><verse number="21" style="v" sid="1CO 15:21"/>Ꮊይቆ ፐቲ አስ ባጋር Ꮊ አላመ የኤዛይ ጋርክ Ꮊይቆፕ ደንዶካ ፐቲ አስ ባጋር የኤዛ። <verse eid="1CO 15:21"/><verse number="22" style="v" sid="1CO 15:22"/>አዳመ ባጋር አስ ኡባይ Ꮊይቄዛይ ጋርክ ክርስቶሳ ባጋር አስ ኡባይ ደኦ የዝዛ። <verse eid="1CO 15:22"/><verse number="23" style="v" sid="1CO 15:23"/>ዝን ፐታይ ፐታይ ፋ ሙራር ሙራር ደንዶዳ። ክርስቶሳ ኡባይፕ ባይራቲ ደንዴዛ፤ የይፕ ጉየ፥ ክርስቶሳስታይ ኤ ይእዛ ዎደ ደንዶዳ።<verse eid="1CO 15:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 15:24"/>የይፕ ጉየ፥ ክርስቶሳ ሀርዝታ፥ ማዉተኔ ዎልቃ ኡባ ብሲ፥ ካተት ጾስ አዳይስ እንግዛ ዎደ ዎደ ዉርስይ የኦዳ። <verse eid="1CO 15:24"/><verse number="25" style="v" sid="1CO 15:25"/>ጾሳይ ኤ ሞርክታ ኡባ ኤ ቶኬ ኦሞ ኦሎድ ሄሎዳይስ ክርስቶሳ ካዉቶዳይስ ቤዝዛ።<note caller="-" style="x"><char style="xo" closed="false">15:25 </char><char style="xt" closed="false"><ref loc="PSA 110:1">ማዝ. 110:1</ref></char></note> <verse eid="1CO 15:25"/><verse number="26" style="v" sid="1CO 15:26"/>ዉርስል ኤ ብሶዳይስ የዝ ሞርካይ Ꮊይቆ። <verse eid="1CO 15:26"/><verse number="27" style="v" sid="1CO 15:27"/>ጌሻ ማጻፋይድ፥ «ጾሳይ ኡባ ባዝ ኤ ማዉተ ኦሞ ሃርሴዛ» ግንትንቲ ጻፍንቴዛ። ዝን ኡባ ኤ ማዉታይፕ ኦሞ ሃርሴዛ ግዛይ፥ ጾስ አዳይ ኣዳ አትኮ ኡባ ባዝ ኤ ማዉታይፕ ኦሞ ሃርሴዛ።<note caller="-" style="x"><char style="xo" closed="false">15:27 </char><char style="xt" closed="false"><ref loc="PSA 8:6">ማዝ. 8:6</ref></char></note> <verse eid="1CO 15:27"/><verse number="28" style="v" sid="1CO 15:28"/>ኡባ ባዝ ክርስቶሳ ማዉታይፕ ኦሞ ሃርንቴዛይፕ ጉየ ክርስቶሳ ማ ፋ ኦማስ ኡባ ባዝ ፓስ ሃርሴዝ ጾሳይስ ሃርንቶዳ። የ ዎደ ጾሳይ ፋ ኣዳ ኡባ ሃሮዳ።<verse eid="1CO 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 15:29"/>Ꮊይቄዝታይ ደንዶዋባዝ ማቅኮ ኡ ግሾስ ጻማቅንትዛ አሳይ አብስ ዋይኔ? Ꮊይቄዝታይ ደንዶዋባዝ ማቅኮ የዝን፥ አብስ፥ አሳይ Ꮊይቄዝታይ ግሾስ ጻማቅንትኔ?<verse eid="1CO 15:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="1CO 15:30"/>የዝን፥ ኑኒ አብስ ኡባ ዎደ ኑናት መቶስ ኣ እንግኔ? <verse eid="1CO 15:30"/><verse number="31" style="v" sid="1CO 15:31"/>ታ እሹን፥ ታ ጋላስ ጋላስ Ꮊይቆስ ኣ እንግንትዛ። የይካ፥ ጎዳ የሱስ ክርስቶሳል የዝ ደኦ ፐትፐተይድ ይንታል ጬቅዛ ግሾስ። <verse eid="1CO 15:31"/><verse number="32" style="v" sid="1CO 15:32"/>አስ ቆፋ ጋርክ ማቅኮ፥ ታኒ ኤፈሶነ ዶአራ ቡትቴዛይ ታና አብ ማዴ? Ꮊይቄዝታይ Ꮊይቆፕ ደንዶዋባዝ ማቅኮ፥ «ዎንቲ ኑ Ꮊይቅዝ ግሾስ Ꮊይኖ ማዳ ኡዦዳ» ዬግዝ አሳይ ጋርክ ማቅዛ።<note caller="-" style="x"><char style="xo" closed="false">15:32 </char><char style="xt" closed="false"><ref loc="ISA 22:13">ኢሳ. 22:13</ref></char></note><verse eid="1CO 15:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 15:33"/>ባልንትፓተ! ኢታ ዣመት ሎኦ ሀኖ ኢስዛ። <verse eid="1CO 15:33"/><verse number="34" style="v" sid="1CO 15:34"/>ይ ካሃይኮ ማቆይታ። ናጋራ ኦፓተ። ይንታፕ ፐቲ ፐቲ አሳይ ጾስ ኤሮያ። ታኒ ይንታን ዬላዳይስ የያ ግዛ።<verse eid="1CO 15:34"/></para>
  <para style="s1">ደንዶ አሰት</para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35"/>ፐቲ አስ፥ «Ꮊይቄዝ አሳይ ዋይዚ ደንዴ? ኡንቲ አብ ጋርክ አሰትራ የኦዴ?» ዬግ አታሚ። <verse eid="1CO 15:35"/><verse number="36" style="v" sid="1CO 15:36"/>ነኖ ቦዛዮ፥ ኔኒ ቢታል ዘርዝ ዘርይ Ꮊይቀካ ዶሎያ። <verse eid="1CO 15:36"/><verse number="37" style="v" sid="1CO 15:37"/>ኔኒ ዘርዛይ ግስተ ማቆ ዎይ ሀራ ካ ዎቆዋ አፋ ኣዳ ዘርነፕ አትን ዶሌዝ ዶላ ባያ። <verse eid="1CO 15:37"/><verse number="38" style="v" sid="1CO 15:38"/>ዝን ጾሳይ ዘረታይስ ፋ ዶሴዛይ ጋርክ መት እንግዛ። ዱማ ዱማ ዘርታይስ ዱማ ዱማ አሰት እንግዛ። <verse eid="1CO 15:38"/><verse number="39" style="v" sid="1CO 15:39"/>መት ኡባይ አሾ ፐቶ ባያ። ዝን አስ አሾ ፐቶ፤ መሄ አሾ ሀራ፤ ካፍታይ አሾ ሀራ፤ ማ ሞሎ አሾካ ሀራ።<verse eid="1CO 15:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="1CO 15:40"/>ሳሎ አሰት የዛ፤ ማ ሳአ አሰትካ የዛ። ዝን ሳሎ አሰት ቦንቾ ፐቲ ማላ፤ ማ ሳአ አሳተ ቦንቾ ሀራ። <verse eid="1CO 15:40"/><verse number="41" style="v" sid="1CO 15:41"/>አዋ ቦንቾ ሀራ፤ አጌና ቦንቾ ሀራ፤ ጾልንትታይ ቦንቾ ሀራ፤ ፐቲ ጾልንታይ ሀራ ጾልንቶፕ ቦንቾር ዱማትዛ።<verse eid="1CO 15:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="1CO 15:42"/>Ꮊይቄዝታይ Ꮊይቆፕ ደንድዛ ዎደ የይ ጋርክ ሀኖዳ። ዎቅዛ አሰትይ ዘርንትዛ፤ ዎቆዋ አሰት ማቂ ደንድዛ። <verse eid="1CO 15:42"/><verse number="43" style="v" sid="1CO 15:43"/>ቶቼር ዘርንቲ፥ ቦንቾር ደንዶዳ፤ ዳቡርሳር ዘርንቲ፥ ዎልቃር ደንዶዳ። <verse eid="1CO 15:43"/><verse number="44" style="v" sid="1CO 15:44"/>መት አሰትር ዘርንቲ፥ አያና አሰት ማቂ ደንዶዳ። መታ አሰት የዝኮ፥ አያና አሰት የዛ።<verse eid="1CO 15:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="1CO 15:45"/>የይ ጋርከካ፥ ጌሻ ማጻፋይድ፥ «ቲና አይ፥ አዳማ፥ ፓ የዝ አስ ማቂ መንቴዛ»<note caller="-" style="x"><char style="xo" closed="false">15:45 </char><char style="xt" closed="false"><ref loc="GEN 2:7">መ. 2:7</ref></char></note> ዬግዛ። ዝን ጉየ አዳማ፥ ክርስቶሳ፥ ደኦ እንግዛ አያና ማቄዛ። <verse eid="1CO 15:45"/><verse number="46" style="v" sid="1CO 15:46"/>ዝን መታ አስ ቲና ይእን፥ ጉየፕ አያና አስ የኤነፕ አትን አያና አስ ቲና የኤካያ። <verse eid="1CO 15:46"/><verse number="47" style="v" sid="1CO 15:47"/>ቲና አዳም ቢታፕ መንቴዝ ቢታ አስ፤ ናምእን አዳማ ሳሎፕ የኤዛ። <verse eid="1CO 15:47"/><verse number="48" style="v" sid="1CO 15:48"/>ቢታፕ መንቴዝታይ ቢታይፕ መንቴዛና ኣዝዛ። ሳሎስታይ ሳሎፕ የኤዛና ኣዝዛ። <verse eid="1CO 15:48"/><verse number="49" style="v" sid="1CO 15:49"/>ኑኒ ቢታፕ መንቴዝ አ ኣዝዛይ ጋርክ ሳሎፕ የኤዝ አካ ኣዝዛ።<verse eid="1CO 15:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="1CO 15:50"/>ታ እሹን፥ ታ ግዛይ የያ፤ አሾኔ ሱ ጾስ ካተት ላቶዳይስ ዳንዳኦያ። ዎቅዛ አሰትይ ዎቆዋ አሰት ላቶያ።<verse eid="1CO 15:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="1CO 15:51"/>ታ ይንትስ ፐቲ ጹረ ኦዶዳ። ኑ ኡባይ Ꮊይቃሚ፥ ዝን ዉርስል ኡባይ ላምንቶዳ።<note caller="-" style="x"><char style="xo" closed="false">15:51-52 </char><char style="xt" closed="false"><ref loc="1TH 4:15-17">1ተሰ. 4:15-17</ref></char></note> <verse eid="1CO 15:51"/><verse number="52" style="v" sid="1CO 15:52"/>ቱልቱሎ ፑግንቶዳር ኣፈ ቅጲ በአዳይስ ቆፐካ ላምንቶዳ። Ꮊይቄዝ አሳይ ዎቃም አስ ማቂ ደንዶዳ፤ ኑካ ላምንቶዳ። <verse eid="1CO 15:52"/><verse number="53" style="v" sid="1CO 15:53"/>Ꮊይ ዎቅዛይ ዎቃማና፥ Ꮊይ Ꮊይቅዛይ Ꮊይቃማና ማኦዳይስ ቤዝዛ።<verse eid="1CO 15:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="1CO 15:54"/>Ꮊይ ዎቅዛይ ዎቃማና፥ ማ Ꮊይ Ꮊይቅዛይ Ꮊይቃማና ማእዛ ዎደ ጌሻ ማጻፋይድ፥ «Ꮊይቆ ጋምር ምትንቴዛ»<note caller="-" style="x"><char style="xo" closed="false">15:54 </char><char style="xt" closed="false"><ref loc="ISA 25:8">ኢሳ. 25:8</ref></char></note> ግዝ ቃላይ ፖልንቶዳ። <verse eid="1CO 15:54"/><verse number="55" style="v" sid="1CO 15:55"/>የይ ጋርከካ፥</para>
  <para style="q1" vid="1CO 15:55">«Ꮊይቆ፥ ነ ጋምይ አባ የኔ?</para>
  <para style="q2" vid="1CO 15:55">Ꮊይቆ፥ ነ ዪሻይ አባ የኔ?»<note caller="-" style="x"><char style="xo" closed="false">15:55 </char><char style="xt" closed="false"><ref loc="HOS 13:14">ሆሳ. 13:14</ref></char></note><verse eid="1CO 15:55"/></para>
  <para style="p">
    <verse number="56" style="v" sid="1CO 15:56"/>Ꮊይቆ ዱክዛ ዪሻይ ናጋራ፤ ማ ናጋራ ዎልቃይ ህገ። <verse eid="1CO 15:56"/><verse number="57" style="v" sid="1CO 15:57"/>ዝን ኑ ጎዳ የሱስ ክርስቶሳ ባጋር ኑስ ጋም እንግዛ ጾሳና ጋላታ ሄሎ።<verse eid="1CO 15:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="1CO 15:58"/>የይ ግሾስ፥ ታ ሲቆ እሹን፥ ኤንኤካ ሚንጊ ኤቆይታ። ጎዳይ ኦሳይድ ይ ዳቡርዛይ ጨረ ባዛና ኤሪ ኡባ ዎደ ጎዳይ ኦሳ አዛለካዛር ኦይታ።<verse eid="1CO 15:58"/></para>
  <chapter eid="1CO 15"/>
  <chapter number="16" style="c" sid="1CO 16"/>
  <para style="s1">አማንዛ አሳይስ ሺቄዝ ታምኤ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1"/>አማንዛ አሳይስ ሚሻ ሺሾ ባጋ ጋላትያ ዎሳ ኬታይስ ታኒ አዛዜዛይ ጋርክ ይንትካ ኦይታ።<note caller="-" style="x"><char style="xo" closed="false">16:1 </char><char style="xt" closed="false"><ref loc="ROM 15:25-26">ኦሮ. 15:25-26</ref></char></note> <verse eid="1CO 16:1"/><verse number="2" style="v" sid="1CO 16:2"/>ሚሸ ሺሾ ታ ይንትኮ Ꮊንጎዳር ማቃማይ ጋርክ ፐታይ ፐታይ ሳምንታፕ ቲና ጋላስ፥ ዎጋ ዎደ ዎጋ ዎደ ፋ ደንግዛ ባዛፕ ከሲ ፋ ካራ ጋን። <verse eid="1CO 16:2"/><verse number="3" style="v" sid="1CO 16:3"/>ታኒ ገድ Ꮊንጌዝ ዎደ ሚሸ የሩሳላመ ሄልዳይ ጋርክ ይ ዶሬዝ አሳይስ ዳብዳበ እንጊ ኡንታን የሩሳላመ አዛዞዳ። <verse eid="1CO 16:3"/><verse number="4" style="v" sid="1CO 16:4"/>ኡንታር ታና Ꮊሞ ቤዝዛ ባዝ ማቅኮ ኡንቲ ታራ Ꮊንጎዳይስ ዳንዳእዛ።<verse eid="1CO 16:4"/></para>
  <para style="s1">ጳዉሎሳ ቆፋ</para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 16:5"/>ታኒ ማቃዶናር ኣዳይስ ቆፔዝ ግሾስ ገድ Ꮊንጊ ይንትኮ የኦዳ።<note caller="-" style="x"><char style="xo" closed="false">16:5 </char><char style="xt" closed="false"><ref loc="ACT 19:21">ሀዋ. ኦ. 19:21</ref></char></note> <verse eid="1CO 16:5"/><verse number="6" style="v" sid="1CO 16:6"/>ታ Ꮊንግዛ አቆ አና ማቅኮካ፥ ታ Ꮊማይድ ይ ታና ማዶዳይ ጋርክ ይ ካለ ጽቃ ዎደ ጋምኤካ አታሚ። ባርጎ አግንታ ይ ካለ ኣ ዋዪ አሾዳ። <verse eid="1CO 16:6"/><verse number="7" style="v" sid="1CO 16:7"/>ታኒ ኦገራ ኣታር ይንታን በአዳይስ ኮዮያ። ጎዳይ ጊኮ፥ ይ ካለ ኡንደና ዎደ ካታምኦዳይስ ቆፕዛ።<verse eid="1CO 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 16:8"/>ዝን ታኒ ጰንጸቆስጸ ባለ ሄሎዳይስ ኤፈሶና ጋምኦዳ። <verse eid="1CO 16:8"/><verse number="9" style="v" sid="1CO 16:9"/>ታስ ኦሶ ኩሜዛ ዳልገ ፔንጋይ ዶይንቴዛ፥ ዝን ጋመ ኤቅንትዛ ሞርክታይ የዛ።<note caller="-" style="x"><char style="xo" closed="false">16:9 </char><char style="xt" closed="false"><ref loc="LEV 23:15-21">ለዊ. 23:15-21</ref>፤ <ref loc="DEU 16:9-11">ናምእ. 16:9-11</ref>፤ <ref loc="ACT 19:8-10">ሀዋ. ኦ. 19:8-10</ref></char></note><verse eid="1CO 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 16:10"/>ኤ ታ ጋርክ ጎዳ ኦሶ ኦዛ አስ ማቄዝ ግሾስ ጽማቶሳ ይንትኮ Ꮊንግኮ፥ ይ ካለ ኤ ያሽተካዛር የዞዳይ ጋርክ ኦይታ።<note caller="-" style="x"><char style="xo" closed="false">16:10 </char><char style="xt" closed="false"><ref loc="1CO 4:17">1ቆሮ. 4:17</ref></char></note> <verse eid="1CO 16:10"/><verse number="11" style="v" sid="1CO 16:11"/>ኦንካ ኤዛ ካፐ። ኤ ታኮ ሳሮ ማቆዳይ ጋርክ ኤዛ ማዲ ሞይዞይታ። ታኒ ኤ Ꮊንኮ አማንዝታይር ማቆዳና ናግዛ።<verse eid="1CO 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 16:12"/>ኑ እሻ አጵሎሳ Ꮊንኮ አማንዝታይር ይንትኮ Ꮊማዳይ ጋርክ ታ ኤዛ ሚን ዎሴዛ። Ꮊት ይንትኮ Ꮊንጎዳይስ ኮየካያ፥ ዝን ኤስ ጊጌዝ ዎደ ይንትኮ Ꮊማዳ።<verse eid="1CO 16:12"/></para>
  <para style="s1">ዉርስ ዞረኔ ሳሮ</para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 16:13"/>ባርኮይታ፤ አማኖር ኤቆይታ፤ ጻሎይታ፤ ሚንጎይታ። <verse eid="1CO 16:13"/><verse number="14" style="v" sid="1CO 16:14"/>ኦሶ ኡባ ሲቆር ኦይታ።<verse eid="1CO 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 16:15"/>ታ እሹን፥ ኢስጽፋኖሰኔ ኤ ካራ አሳይ አካያ ቢታ ኡንቲ ቲና አማኔዝታ ማቄዛኔ አማንዝታ ማዶዳይስ ፋና ኣ እንጌዛና ይ ኤርዛ።<note caller="-" style="x"><char style="xo" closed="false">16:15 </char><char style="xt" closed="false"><ref loc="1CO 1:16">1ቆሮ. 1:16</ref></char></note> <verse eid="1CO 16:15"/><verse number="16" style="v" sid="1CO 16:16"/>ይንትካ ኡ ጋርክ አስስኔ፥ ኡንታራ ኦሶር ዳቡርዛ ኡባይስ ኪተንቶዳይ ጋርክ ታ ይንታን ዎስዛ።<verse eid="1CO 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 16:17"/>እስጸፋኖሳ፥ ፍርዶናጽሰኔ አካይቆሳ ታኮ የኤዛይ ታና ኡፋይሴዛ። ይ ባ አቆ ኡንቲ ይንታን ማቂ ታ ፓጫ ኩንዛ። <verse eid="1CO 16:17"/><verse number="18" style="v" sid="1CO 16:18"/>ኡንቲ ይንታን ኡፋይሴዛይ ጋርክ ታናካ ኡፋይሴዛ። የይ ጋርክ አስታ ደንይታ።<verse eid="1CO 16:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 16:19"/>ኢሳ ዎሳ ኬ አሳይ ይንታን ሳሮ ግዛ። አቅላኔ ጵርስቅላ ፋ ካራ ሺቅዛ ዎሳ ኬ አሳይራ ፐትፕ ይንታን ጎዳይ ሱንይር ሳሮዛ።<note caller="-" style="x"><char style="xo" closed="false">16:19 </char><char style="xt" closed="false"><ref loc="ACT 18:2">ሀዋ. ኦ. 18:2</ref></char></note> <verse eid="1CO 16:19"/><verse number="20" style="v" sid="1CO 16:20"/>አማንዛ እሽታይ ኡባይ ይንታን ሳሮ ዬግዛ።</para>
  <para style="p" vid="1CO 16:20">ጌሽ ዬርንቶ ዬርንትታር ዎል ሳሮይታ። <verse eid="1CO 16:20"/><verse number="21" style="v" sid="1CO 16:21"/>ታኒ፥ ጳዉሎሳ፥ Ꮊ ሳሮ ታ ኩሸር ጻፌዛ።<verse eid="1CO 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 16:22"/>ጎዳ ዶሶዋ አስ የዝኮ፥ ባድንቴዛ ማቆ። ኑ ጎዳዮ፥ Ꮊና የኦባ!<verse eid="1CO 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 16:23"/>ጎዳ የሱስ ክርስቶሳ ኣ ኬሃትይ ይንታር ማቆ።<verse eid="1CO 16:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 16:24"/>ታ ሲቃይ ክርስቶሳ የሱሳር የዝ ይ ኡባይራ ማቆ። አምንኤ።<verse eid="1CO 16:24"/></para>
  <chapter eid="1CO 16"/>
</usx>
