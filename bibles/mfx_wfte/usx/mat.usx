<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Melo New Testament Ethiopic</book>
  <para style="h">ማቶሳ</para>
  <para style="toc1">ማቶሳ ጻፌዝ የሱስ ክርስቶሳ ዎንግለ</para>
  <para style="toc2">ማቶሳ</para>
  <para style="toc3">ማቶ.</para>
  <para style="mt1">ማቶሳ ጻፌዝ የሱስ ክርስቶሳ ዎንግለ</para>
  <para style="imt">ገሎ</para>
  <para style="ip">ማቶሳ ዎንግላይ፥ የሱሳ ይእ ኡፋይሳይ ካሰ ኤ ባጋ ኦድንቴዛይኔ አሽዛያ ማቄዛና ጾሲ ቲና ጫቃይድ ፋ አሳይስ እንጌዝ ኡፋይስ ቃላ ፖሌዛይ ኤ ባጋር ማቄዛና ኦድዛ ዎንግለ። Ꮊ ዎንግላይ የሱሳ ኡ ጋንጨ የልንቲ ድጬዝ አይሁድታይ ኣዳስ ባዝን አላመ ኡባይሲ።</para>
  <para style="ip">ማቶሳ ዎንግላይ፥ ሎእ ናግንቶር ጻፍንቴዝ ማጻፈ። ማቶሳ ፋ ማጻፋ የሱሳ የልንቴዛይፕ አይኪ፥ ኤ ጻማቅንታኔ ኤ ፓጭንታ ኦዲ ማቂ፥ ጋልላ ቢታ ኤ ሳባኬዝ ባዝ፥ ታማርሴዝ ባዝኔ ሀርግንቴዝታ ፓዝ ባዝታ ኦድዛ። ኤዛይላካ፥ የሱሳ ጋልላፕ የሩሳላመ Ꮊንጌዛኔ ኤ Ꮊ ሳአል የዜዝ ዎደ ዉርስ ሳምንታ ሀኔዝ ባዝታ ቤዝዛ። የይካ ኤ ሶትንታ፥ ኤ Ꮊይቃኔ ኤ ደንዳ ዎላል ኦድዛ።</para>
  <para style="ip">Ꮊ ዎንግላይ፥ የሱሳ ጾስ ህገ ብሎዳይስ ማዉተር የዛኔ ጾስ ካተት ባዝ ታማርስዛ ባይራ አስታማረ ኡዲ ሺሽዛ። ኤ ትምርታይፕ ጋንግዛ ባጋይ ዱማ ዱማ ሙራር እችን አቆ ሻክንትፍዛ።</para>
  <para style="ili">1. ጾስ ካተት አሳይ ሀኖት፥ ኦሶ፥ ማዉተኔ ኡ ዉርስ አንጃ ኦድዛ አምባል አፋ ትምርተ (ሸም 5—7)።</para>
  <para style="ili">2. ታጶ ናምኢ ታማርታይ ዎንግለ ሳባኮዳይስ Ꮊንጌዝ ዎደ ኡንትስ እንግንቴዝ ህገ (ሸም 10)።</para>
  <para style="ili">3. ጾሳ ካተት ባዝ ታማርሶዳይስ ሺቄዝ ዱማ ዱማ ኣዝሶ (ሸም 13)።</para>
  <para style="ili">4. ኤ ታማረ ማቅስ የዝ ብል ኦድዝ ትምርተ (ሸም 18)።</para>
  <para style="ili">5. Ꮊ አላማይ ዉርስኔ ጾስ ካተትይ ፎሎ ይእ ባጋ ኦድዝ ትምርተ (ሸም 24—25)።</para>
  <para style="iot">ማቶሳ ዎንግላይ አይኬዝ ቆፍታ</para>
  <para style="io1">የሱስ ክርስቶሳ ዛረ ጹስኔ ኤ የልንቶ <char style="ior"><ref loc="MAT 1:1-2:23">1:1—2:23</ref> </char></para>
  <para style="io1">ጻማቅዛ ዋንሳ ኦሶ <char style="ior"><ref loc="MAT 3:1-12">3:1-12</ref> </char></para>
  <para style="io1">የሱሳ ጽንቃተኔ ፓጭንቶ <char style="ior"><ref loc="MAT 3:13-4:11">3:13—4:11</ref> </char></para>
  <para style="io1">የሱሳ ጋልላ ቢታ ፋ ኦሶ አይኬዛ <char style="ior"><ref loc="MAT 4:12-18:35">4:12—18:35</ref> </char></para>
  <para style="io1">የሱሳ ጋልላፕ የሩሳላመ ሄሎዳይስ ኦዝ ኦሶ <char style="ior"><ref loc="MAT 19:1-20:34">19:1—20:34</ref> </char></para>
  <para style="io1">የሱሳስ ዉርስ ሳምንታኔ፥ የሩሳላመ ሄራ <char style="ior"><ref loc="MAT 21:1-27:66">21:1—27:66</ref> </char></para>
  <para style="io1">ጎዳይ Ꮊይቆፕ ደንዶኔ በንት <char style="ior"><ref loc="MAT 28:1-20">28:1-20</ref> </char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="MAT 1"/>
  <para style="s1">የሱሳ የለት ጹሲ</para>
  <para style="r">(<ref loc="LUK 3:23-38">ሉቃ. 3:23-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1"/>ዳዉተ ናአ አፍራመ ናአ ማቄዝ የሱስ ክርስቶሳ የለት።<verse eid="MAT 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 1:2"/>አፍራመ እሳቃ የሌዛ፤</para>
  <para style="q1" vid="MAT 1:2">እሳቃ ያይቆባ የሌዛ፤</para>
  <para style="q1" vid="MAT 1:2">ያይቆባ ይሁዳራኔ ኤ እሽታ የሌዛ፤<verse eid="MAT 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 1:3"/>ይሁዳ ትእማርፕ ፓረሳኔ ዛራ የሌዛ፤</para>
  <para style="q1" vid="MAT 1:3">ፓረሳ አስሮመ የሌዛ፤</para>
  <para style="q1" vid="MAT 1:3">አስሮማ ራመ የሌዛ፤<verse eid="MAT 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 1:4"/>ራመ አምናዳባ የሌዛ፤</para>
  <para style="q1" vid="MAT 1:4">አምናዳባ ናአሶና የሌዛ፤</para>
  <para style="q1" vid="MAT 1:4">ናአሶና ሳልሞነ የሌዛ፤<verse eid="MAT 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 1:5"/>ሳልሞና ራአብፐ ቦኤዛ የሌዛ፤</para>
  <para style="q1" vid="MAT 1:5">ቦኤዛ ኡርትፐ ኢዮቤደ የሌዛ፤</para>
  <para style="q1" vid="MAT 1:5">ኢዮቤደ ኢሳየ የሌዛ፤<verse eid="MAT 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 1:6"/>ኢሳየ ካታ ዳውተ የሌዛ፤</para>
  <para style="q1" vid="MAT 1:6">ካት ዳውተ ኦርዮ ማቻትፐ ሶሎሞነ የሌዛ፤<verse eid="MAT 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 1:7"/>ሶሎሞነ ሮብአማ የሌዛ፤</para>
  <para style="q1" vid="MAT 1:7">ሮብአመ አብያ የሌዛ፤</para>
  <para style="q1" vid="MAT 1:7">አብየ ኣሳፈ የሌዛ፤<verse eid="MAT 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 1:8"/>ኣሳፈ ኢዮሳፈጸ የሌዛ፤</para>
  <para style="q1" vid="MAT 1:8">ኢዮሳፍጸ ኢዮራመ የሌዛ፤</para>
  <para style="q1" vid="MAT 1:8">ኢዮራመ ኦዛኔ የሌዛ፤<verse eid="MAT 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 1:9"/>ኦዛኔ ኢዮአታመ የሌዛ፤</para>
  <para style="q1" vid="MAT 1:9">ኢዮአታመ አካዛ የሌዛ፤</para>
  <para style="q1" vid="MAT 1:9">አካዛ ህዝቃሳ የሌዛ፤<verse eid="MAT 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 1:10"/>ህዝቃሳ ምናሰ የሌዛ፤</para>
  <para style="q1" vid="MAT 1:10">ምናሰ አሞጻ የሌዛ፤</para>
  <para style="q1" vid="MAT 1:10">አሞጻ ኢዮሳሳ የሌዛ፤<verse eid="MAT 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 1:11"/>ኢዮሳሳ ኢኮናናራኔ ኤ እሽታ የሌዝ ያ ላይተ እስሬለ አሳይ ድእንቲ ባብሎነ ቢታ Ꮊንጌዛ።<note caller="-" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="2KI 24:14-15">2ካት. 24:14-15</ref>፤ <ref loc="2CH 36:10">2ዜና. 36:10</ref>፤ <ref loc="JER 27:20">ኤርም. 27:20</ref></char></note><verse eid="MAT 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 1:12"/>ባብሎነ ቢታ እስሬለ አሳይ ድእንቲ Ꮊንጌዛይፕ ጉዬ ኢኮናና ሳላትያለ የሌዛ።</para>
  <para style="q1" vid="MAT 1:12">ሳላትያለ ዘሩባበላ የሌዛ፤<verse eid="MAT 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 1:13"/>ዘሩባበላ አብድዩ የሌዛ፤</para>
  <para style="q1" vid="MAT 1:13">አብድዩ ኤልያቀመ የሌዛ፤</para>
  <para style="q1" vid="MAT 1:13">ኤልያቀመ ኣዞራ የሌዛ፤<verse eid="MAT 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="MAT 1:14"/>ኣዞራ ሳዶቀ የሌዛ፤</para>
  <para style="q1" vid="MAT 1:14">ሳዶቀ አክመ የሌዛ፤</para>
  <para style="q1" vid="MAT 1:14">አክመ ኤልዩዳ የሌዛ፤<verse eid="MAT 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 1:15"/>ኤልዩዳ አላዛራ የሌዛ፤</para>
  <para style="q1" vid="MAT 1:15">አላዛረ ማታነ የሌዛ፤</para>
  <para style="q1" vid="MAT 1:15">ማታነ ያይቆባ የሌዛ፤<verse eid="MAT 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 1:16"/>ያይቆባ ዮሴፋ የሌዛ፤</para>
  <para style="q1" vid="MAT 1:16">ዮሴፋ ክርስቶሳ ግዝ የሱሳና የሌዝ ማይራሚ አዝና።<verse eid="MAT 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17"/>ይኬ፥ የለት አፍራመፕ ዳዉተ ሄሎዳይስ ታጶ ኦይደ። ዳዉተፕ Ꮊንጊ ባብሎነ ድአ ሄሎዳይስ ታጶ ኦይደ። ባብሎነ ድአይፕ Ꮊንጊ ክርስቶሳ ሄሎዳይስ ታጶ ኦይዲ የለት ማቅዛ።<verse eid="MAT 1:17"/></para>
  <para style="s1">የሱስ ክርስቶሳ የለት</para>
  <para style="r">(<ref loc="LUK 2:1-7">ሉቃ. 2:1-7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18"/>የሱስ ክርስቶሳ የልንቶ ታርካይ Ꮊይፕ ካልዛ። ኤ እንዳት ማይራማ ዮሴፋስ ኦይጭንቲ የዛር ዮሴፋር ዎላ አቀካዛር ጌሻ አያናፕ ዎደጼዛ።<note caller="-" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="LUK 1:27">ሉቃ. 1:27</ref></char></note> <verse eid="MAT 1:18"/><verse number="19" style="v" sid="MAT 1:19"/>ዮሴፋ ጌሻ አስ ማቄዝ ግሾ እዞ አሲ ኦዶዳይ ጋርክ ኮየካዛይ ግሾስ ጌማር አሾዳይስ ቆፔዛ። <verse eid="MAT 1:19"/><verse number="20" style="v" sid="MAT 1:20"/>ኤ የ ቆፋል የዝን ጾሳ ኪታንቻይ አቡካር ኤስ በንቲ፥ «ዳዉተ ናአ፥ ዮሴፋ፥ ማይራማ ዎደጼዛይ ጌሻ አያናፕ ማቄዝ ግሾ እዞ ኤኮዳይስ ያሽትፐ» ዬጌዛ። <verse eid="MAT 1:20"/><verse number="21" style="v" sid="MAT 1:21"/>እዛ ራ ናአ የሎዳ፥ ኤ ዎይታ ኡ ናጋራይፕ አሽዛይ ግሾ ኤ ሱን ነ የሱሳ ግ ጼጎዳ።<note caller="-" style="x"><char style="xo" closed="false">1:21 </char><char style="xt" closed="false"><ref loc="LUK 1:31">ሉቃ. 1:31</ref></char></note><verse eid="MAT 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22"/>ጎዳይ ናባይ ዶናር፥ <verse eid="MAT 1:22"/><verse number="23" style="v" sid="MAT 1:23"/>«ይኬ ዉድርታ ዎደጾዳ፤ ራ ናአካ የሎዳ፤ ኤ ሱንይ አማኑኤላ ግንትንቶዳ» ጌዛይ ፖልንቶዳይ ጋርክ Ꮊ ኡባይ ሀኔዛ። አማኑኤላ ጉሳይስ ብርሽይ «ጾሳይ ኑር የዛ» ጉሲ።<note caller="-" style="x"><char style="xo" closed="false">1:23 </char><char style="xt" closed="false"><ref loc="ISA 7:14">ኢሳ. 7:14</ref></char></note><verse eid="MAT 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24"/>ዮሴፋ ገንታፕ ባርኪ ጎዳይ ኪታንቻይ ኪቴዛይ ጋርክ ማይራሞ ፋ ካራ ካንጌዛ። <verse eid="MAT 1:24"/><verse number="25" style="v" sid="MAT 1:25"/>ዝን ፋ ባይራ ናአ የሎድ ጋ እዞ ቦቼካያ፤<note caller="+" style="f"><char style="fr" closed="false">1:25 </char><char style="fqa" closed="false">ኢዞ ቦቼካያ፦ </char><char style="ft" closed="false">ማችር አዝናር አቅዛይ ጋርክ ዎላ አቀካ ጉሲ።</char></note> የልንቴዝ ናአካ የሱሳ ጊ ጼጌዛ።<note caller="-" style="x"><char style="xo" closed="false">1:25 </char><char style="xt" closed="false"><ref loc="LUK 2:21">ሉቃ. 2:21</ref></char></note><verse eid="MAT 1:25"/></para>
  <chapter eid="MAT 1"/>
  <chapter number="2" style="c" sid="MAT 2"/>
  <para style="s1">አዋ ከስ ባጋፕ የኤዝ አስታ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1"/>ካት ሄሮዶሳ ዎደ የሱሳ ይሁዳ ቢታ ቤተለመ ካታማ የልንቴዛይፕ ጉየ ጾልንቶ ፍላግዝታይ አዋ ከስ ባጋፕ የሩሳላመ ይኢ፥ <verse eid="MAT 2:1"/><verse number="2" style="v" sid="MAT 2:2"/>«የልንቴዝ አይሁድታይ ካታይ አባ የኔ? ኑ አዋ ከስ ባጋር ከዜዝ ጾልንቶ ብኢ ኤዝስ ጎይኖዳይስ የኤዛ» ዬጊ ኦይጬዛ።<verse eid="MAT 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3"/>ካት ሄሮዶሳ የያ ስኢ ዳጋሜዛ። የሩሳላመ የዝ አስ ኡባይካ ዳጋሜዛ። <verse eid="MAT 2:3"/><verse number="4" style="v" sid="MAT 2:4"/>ሄሮዶሳ ቄሰ ሀላቅታኔ ህገ አስታማርታ ፋኮ ጼጊ «ክርስቶሳ አባ የልንቶደሻ?» ዬጊ ኡንታን ኦይጬዛ። <verse eid="MAT 2:4"/><verse number="5" style="v" sid="MAT 2:5"/>ኡንትካ፥ «ይሁዳ ቤተለመ ናባይ፥<verse eid="MAT 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6"/>« ‹ይሁዳ የዝ ቤተለመ፥<note caller="-" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="MIC 5:2">ሚካ. 5:2</ref></char></note></para>
  <para style="q2" vid="MAT 2:6">ይሁዳ የዝ ጋደ አቅስዝታይፕ፥</para>
  <para style="q2" vid="MAT 2:6">ነ አባራካ ካዉዦያ።</para>
  <para style="q1" vid="MAT 2:6">ታ ዎያ እስሬለ ሃርዛይ፥</para>
  <para style="q2" vid="MAT 2:6">ኔፕ ከዞዳ ኤካ ታ ዎያ እስሬለ ሄንግዛ ማቃዳ›</para>
  <para style="m" vid="MAT 2:6">ግ ጻፌዛ» ዬጌዛ።<verse eid="MAT 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7"/>የይፕ ጉየ፥ ሄሮዶሳ አዋ ከስ ባጋፕ የኤዝ አስታ ጌማር ጼጊ፥ ጾልንቶ ኡ በኤዝ ላይ ኡንታፕ ሎእ ኦይጪ ኤሬዛ። <verse eid="MAT 2:7"/><verse number="8" style="v" sid="MAT 2:8"/>ኤ ኡንታን ቤተለመ ዳክታር፥ «Ꮊንጊ የልንቴዝ ናአ ሚን ኮዦይታ፤ ኤዛ ይ ደንግኮ ታካ Ꮊንጊ ኤዝስ ጎይኖድ ጋርክ ማቅታር ታስ ኦዶይታ» ዬጌዛ። <verse eid="MAT 2:8"/><verse number="9" style="v" sid="MAT 2:9"/>ኡንትካ ካታይ ሄሮዶሳ ኦዴዛና ስኢ ቅቴዛ። ኡ አዋ ከስ ባጋር በኤዝ ጾልንታይ ኡንታን ካልታር ናአይ የዛ አቃይድ ኤቆድ ሄሎዳይስ ካንጊ ሄልዛ። <verse eid="MAT 2:9"/><verse number="10" style="v" sid="MAT 2:10"/>ኡ የ ጾልንታ ብኢ አቆፕ ኣ ኡፋይስ ኡፋይቴዛ። <verse eid="MAT 2:10"/><verse number="11" style="v" sid="MAT 2:11"/>ካራ ገሊ ናአይ ፋ እንዳት ማይራምር የዛና በኤዛ። ኤስ ጹጉኒ ጎይኔዛ። ፋ ሳጽና ዶዪ ዎርቀራ፥ እጻነራኔ ካርበራ ኤስ እንጌዛ። <verse eid="MAT 2:11"/><verse number="12" style="v" sid="MAT 2:12"/>ኡ ሄሮዶሳኮ ጉየ ማቃማይ ጋርክ ጾሳይ አቡካር ኡንትስ ኦድን፥ ሀራ ኦገር ፋ ቢታ ማቄዛ።<verse eid="MAT 2:12"/></para>
  <para style="s1">ናአ ኤኪ ግብጸ ቆስንቶ</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13"/>አዋ ከስ ባጋፕ የኤዝ አሳይ ቅቴዛይፕ ጉየ፥ ጎዳይ ኪታንቻይ ዮሴፋስ አቡካር በንቲ፥ «ሄሮዶሳ ናአና ዎዳይስ ኮይዝግሾስ ደንዶባ፤ ኤልሲ ናአይራ ናአይ እንዳትራ ኤኪ ግብጸ ቢታ Ꮊንጎባ። ነ ማቃድ ጋላሳ ኔስ ኦዶድ ጋ ኤዛይድ ጋምኦባ» ዬጌዛ።<verse eid="MAT 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14"/>የይ ግሾስ፥ ዮሴፋ ቃማር ደንዲ፥ ናአይራ ናአይ እንዳትራ ኤኪ ግብጸ Ꮊንጌዛ። <verse eid="MAT 2:14"/><verse number="15" style="v" sid="MAT 2:15"/>ናበ ዶናር ጾሲ፥ «ታኒ፥ ታ ናአ፥ ግብጸ ቢታፕ ጼጌዛ»<note caller="-" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="HOS 11:1">ሆሳ. 11:1</ref></char></note> ግንትንቴዝ ቃላይ ፖልንቶድ ጋርክ ሄሮዶሳ Ꮊይቆድ ሄሎዳይስ ኤ ኤዛይድ ጋምኤዛ።<verse eid="MAT 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16"/>የይፕ ጉየ፥ አዋ ከስ ባጋፕ የኤዝ አሳይ ኤዛ ዶሼዛና ኤሪ ኢታ ይሎቴዛ። ኤ ቲና ኡንታፕ ስኤዛይ ጋርክ ቤተለመኔ የ ሄራ የዝ ናምኢ ላይ ኩመዝታኔ ናምኢ ላይፕ ሱለ የዝ ራ ናእታ ኡባ ፋ ዎታዳርታ ዳኪ ዎሴዛ።<verse eid="MAT 2:16"/></para>
  <para style="p">
    <verse number="17-18" style="v" sid="MAT 2:17-18"/>ናበ እርማሳ ዶናር፥</para>
  <para style="q1" vid="MAT 2:17-18">«ዬፎኔ ዘላልሲ፥</para>
  <para style="q2" vid="MAT 2:17-18">ራማ ስንቴዛ።</para>
  <para style="q1" vid="MAT 2:17-18">እራሄላ ፋ ናእታይስ ዬክዛ፤</para>
  <para style="q2" vid="MAT 2:17-18">ኡ Ꮊይቄዝ ግሾስ</para>
  <para style="q1" vid="MAT 2:17-18">ምንጎዳይስ ዳንዳኤካያ»</para>
  <para style="m" vid="MAT 2:17-18">ግ ኦዴዛይ ፖልንቴዛ።<note caller="-" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="JER 31:15">ኤርም. 31:15</ref></char></note><verse eid="MAT 2:17-18"/></para>
  <para style="s1">ግብጸፕ ናዝረተ ማቅ</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19"/>ሄሮዶሳ Ꮊይቄዛይፕ ጉየ ጎዳ ኪታንቻይ ዮሴፋስ ግብጸ አቡካር በንቲ፥ <verse eid="MAT 2:19"/><verse number="20" style="v" sid="MAT 2:20"/>«ናአ ዎዳይስ ኮይዝታይ Ꮊይቄዝ ግሾስ ደንዲ ናአይራ ናአይ እንዳትራ ኤኪ እስሬለ ቢታ ማቆባ» ዬጌዛ።<verse eid="MAT 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21"/>ዮሴፋ ደንዲ ናአይራ ናአይ እንዳትራ ኤኪ እስሬለ ቢታ ማቄዛ። <verse eid="MAT 2:21"/><verse number="22" style="v" sid="MAT 2:22"/>ዝን አርክሎሳ ይሁዳል ፋ አዳይ ሄሮዶሳ አቆ ካዉቴዛና ስኢ የ አቃ Ꮊማዳይስ ያሽቴዛ። ጾሳይ አቡካር ኤዛ ቤዝን ጋልላ ቢታ Ꮊንጌዛ። <verse eid="MAT 2:22"/><verse number="23" style="v" sid="MAT 2:23"/>ናብታይ ዶናር፥ «ናዝረተ አስ ግንትንቶዳ» ግ ኦድንቴዛይ ፖልንቶድ ጋርክ ናዝረተ ካታማ Ꮊንጊ ኤዛይድ ጋምኤዛ።<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="MRK 1:24">ማር. 1:24</ref>፤ <ref loc="LUK 2:39">ሉቃ. 2:39</ref>፤ <ref loc="JHN 1:45">ዋን. 1:45</ref></char></note><verse eid="MAT 2:23"/></para>
  <chapter eid="MAT 2"/>
  <chapter number="3" style="c" sid="MAT 3"/>
  <para style="s1">ጻማቅዛ ዋንሳ ትምርተ</para>
  <para style="r">(<ref loc="MRK 1:1-8">ማር. 1:1-8</ref>፤ <ref loc="LUK 3:1-17">ሉቃ. 3:1-17</ref>፤ <ref loc="JHN 1:19-28">ዋን. 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1-2" style="v" sid="MAT 3:1-2"/>የ ዎደ ጻማቅዛ ዋንሳ፥ «ጾስ ካተት ኡኬዝ ግሾስ ይ ናጋራይፕ ማቆይታ» ዬጊ ሳባክታር ይሁዳ ሊዦ ጋር የኤዛ።<note caller="-" style="x"><char style="xo" closed="false">3:1-2 </char><char style="xt" closed="false"><ref loc="MAT 4:17">ማቶ. 4:17</ref>፤ <ref loc="MRK 1:15">ማር. 1:15</ref></char></note> <verse eid="MAT 3:1-2"/><verse number="3" style="v" sid="MAT 3:3"/>ናበ ኢሳያሳ ኦዴዛይ ዋንሳ ባጋ፥</para>
  <para style="q1" vid="MAT 3:3">«ሊዦ ጋ፥</para>
  <para style="q2" vid="MAT 3:3">ፐቲ አይ ፋ ቃላ ቅ ኡዲ፥</para>
  <para style="q1" vid="MAT 3:3">‹ጎዳይ ጎሳ ሎእይታ።</para>
  <para style="q1" vid="MAT 3:3">ኤ ኦጋ ፕትካ ሉልሶይታ› ጌዛ»<note caller="-" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="ISA 40:3">ኢሳ. 40:3</ref></char></note></para>
  <para style="m" vid="MAT 3:3">ዬግንቴዛይ ኤሲ ዬጌዛ።<verse eid="MAT 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4"/>ዋንሳ ግማለ እክሰፕ ዳድንቴዝ አፍላ ማእዛ። ፋ ጼሳይዳካ ዳፈ ዳንጭዛ። ኤ ሚዝ ካይካ ቦለራኔ ደገራ ኤሳራ።<note caller="-" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="2KI 1:8">2ካት. 1:8</ref></char></note> <verse eid="MAT 3:4"/><verse number="5" style="v" sid="MAT 3:5"/>አሳይ የ ዎደ የሩሳላመ ካታማፐ፥ ይሁዳ ቢታ ኡባይፐራኔ ዮርዳኖሳ ቦርካ ሄራፐ ኤኮ ይእዛ። <verse eid="MAT 3:5"/><verse number="6" style="v" sid="MAT 3:6"/>ፋ ናጋራ ቡጽታር ዮርዳኖሳ ቦርካ ኤ ኩሸ ጻማቅንትዛ።<verse eid="MAT 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7"/>ኤዝካ፥ ጋመ ፈርሳውታይፐኔ ሳዱቃውታይፕ ጋምታይ ጻማቅንቶዳይስ ፋኮ ይእዝታ ብኢ፥ ኡንትኮ፥ «Ꮊ ሾሽ ናኡን፥ የኦድ ጾስ ካቻይፕ ቆስንቶዳይ ጋርክ ይንታን ዞሬዛይ ኦኖ?<note caller="-" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="MAT 12:34">ማቶ. 12:34</ref>፤ <ref loc="MAT 23:33">23:33</ref></char></note> <verse eid="MAT 3:7"/><verse number="8" style="v" sid="MAT 3:8"/>ይኬ፥ ይንቲ፥ ይ ናጋራይፕ ማቄዛና ቤዝዛ ኣፈ ኣፎይታ። <verse eid="MAT 3:8"/><verse number="9" style="v" sid="MAT 3:9"/>ይ፥ ይ ዎዝናራ፥ ‹አፍራመ፥ ኑ አደ ግ ይ ቆፕዛይ ጋርክ› ይንትስ ማቅፐ። ሎእ ስኦይታ! ጾሳይ Ꮊ ሹችታይፕ አፍራመስ ናአ ከሶዳይስ ዳንዳእዛ።<note caller="-" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="JHN 8:33">ዋን. 8:33</ref></char></note> <verse eid="MAT 3:9"/><verse number="10" style="v" sid="MAT 3:10"/>ጋንደ ምንጻይ ጻጳይድ ጊጊ በቴዛ፤ ሎኦ ኣፈ ኣፎዋ ም ኡባይ ጋችንቲ ታማ ጋንጨ ዎዳ።<note caller="-" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="MAT 7:19">ማቶ. 7:19</ref></char></note><verse eid="MAT 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11"/>«ይ፥ ይ ናጋራይፕ ማቄዛና ኤርሶዳይስ ታ ይንታን ሃር ጻማቅዛ። ዝን ታፕ ጉየር ይእዛይ ይንታን ጌሻ አያናራኔ ታማር ጻማቆዳ። ኤ ታፕ ሎእ ሚንግዛ፤ ታ ሀራ አቶዝን ኤ ጫማ ቶኮዳይስ ቤዞያ። <verse eid="MAT 3:11"/><verse number="12" style="v" sid="MAT 3:12"/>ካ ጌሽዝ ፕ ኤ ኩሻይድ የዛ። ካ ሎእ ጌሽዛ፤ ግስታ ፋ ሻላይድ ኦሎዳ፥ ዝን ቡና ቶኦዋ ታማይድ ጹጎዳ» ዬጌዛ።<verse eid="MAT 3:12"/></para>
  <para style="s1">የሱሳ ጻማቅንቶ</para>
  <para style="r">(<ref loc="MRK 1:9-11">ማር. 1:9-11</ref>፤ <ref loc="LUK 3:21-22">ሉቃ. 3:21-22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13"/>የ ዎደ የሱሳ ዋንሳ ኩሻይድ ጻማቅንቶዳይስ ጋልላፐ ዮርዳኖሳ ቦርካ Ꮊንጌዛ። <verse eid="MAT 3:13"/><verse number="14" style="v" sid="MAT 3:14"/>ዝን ዋንሳ ኤዛ ካዮዳይስ ኮዪ፥ «ታ ነ ኩሻይድ ጻማቅንቶዳይስ ቤዞዳር ነ ታኮ ይእኔ?» ዬጌዛ። <verse eid="MAT 3:14"/><verse number="15" style="v" sid="MAT 3:15"/>የሱሳ ማሂ፥ «ጾሲ ኑፐ ኮዥዝ ባዝ ኡባ ኑ ፖሎዳይስ ቤዝዛይ ግሾስ Ꮊት ታስ ኤሮ ጎባ» ዬጌዛ። ዋንሳ ኤዝስ ኤሮ ግ ኤዛ ጻማቄዛ። <verse eid="MAT 3:15"/><verse number="16" style="v" sid="MAT 3:16"/>የሱሳ ጻማቅንቴዛን ጋርክ ቦርካፕ ከዜዝ። እዝራካ ሳሎ ዶይንትን ጾሳ አያናይ ሆለ ጋርክ ይኢ ኤዛል ዎዳር በኤዛ። <verse eid="MAT 3:16"/><verse number="17" style="v" sid="MAT 3:17"/>የ ዎደ «ታ ቃዛ ናአይ፥ ታ ኡፋይትዛ ናአይ Ꮊያ» ዬግዝ ቃላ ሳሎፕ የኤዛ።<note caller="-" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="MAT 12:18">ማቶ. 12:18</ref>፤ <ref loc="MAT 17:5">17:5</ref>፤ <ref loc="MRK 1:11">ማር. 1:11</ref>፤ <ref loc="LUK 9:35">ሉቃ. 9:35</ref></char></note><verse eid="MAT 3:17"/></para>
  <chapter eid="MAT 3"/>
  <chapter number="4" style="c" sid="MAT 4"/>
  <para style="s1">የሱሳ ፓጭንቶ</para>
  <para style="r">(<ref loc="MRK 1:12-13">ማር. 1:12-13</ref>፤ <ref loc="LUK 4:1-13">ሉቃ. 4:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1"/>የይፕ ጉየ፥ ዳቡሎሳ የሱሳና ፋጮድ ጋርክ ጌሻ አያናይ የሱሳና ሊዦ ጋ ካንጌዛ።<note caller="-" style="x"><char style="xo" closed="false">4:1 </char><char style="xt" closed="false"><ref loc="HEB 2:18">እብራ. 2:18</ref>፤ <ref loc="HEB 4:15">4:15</ref></char></note> <verse eid="MAT 4:1"/><verse number="2" style="v" sid="MAT 4:2"/>ኤዛይድ ኦይታም ቃማኔ ኦይታም ጋላስ ጾሜዛይፕ ጉየ ናይንቴዛ። <verse eid="MAT 4:2"/><verse number="3" style="v" sid="MAT 4:3"/>ፓጭዛይ የሱሳኮ ይኢ «ነ ጾስ ናአዛኮ፥ አን Ꮊ ሹቹንን ቦራ ማቆዳይ ጋርክ አዛዞባ» ዬጌዛ።<verse eid="MAT 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4"/>የሱሳ ማሂ ኤኮ፥ « ‹አሲ ጾስ ዶናፕ ከዝዝ ቃላ ኡባይር የዝዛፕ አትን ቦራ ኣዳር የዞያ› ዬግንቲ ጾሳ ቃላይድ ጻፍንቴዛ»<note caller="-" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="DEU 8:3">ናምእ. 8:3</ref></char></note> ዬጌዛ።<verse eid="MAT 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5"/>ኤዛይፕ ማቅካ፥ ዳቡሎሳ የሱሳና ጌሻ ካታማ ካንጊ፥ ጾስ ኬ ኩስተል አፋ ከሲ፥ <verse eid="MAT 4:5"/><verse number="6" style="v" sid="MAT 4:6"/>«ነ ጾስ ናአ ማቅኮ፥ አን ሱል ጉፒ ዎባ።» አብስ ጊኮ፥<note caller="-" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="PSA 91:11">ማዝ. 91:11</ref></char></note></para>
  <para style="q1" vid="MAT 4:6">« ‹ነ ቶካይ ሹቻር ብንታማይ ጋርክ፥</para>
  <para style="q2" vid="MAT 4:6">ፋ ኩሸር ነና ደንዳይ ጋርክ፥</para>
  <para style="q2" vid="MAT 4:6">ጾሳይ ፋ ኪታንችታ ነ ግሾስ ኪቶዳ›</para>
  <para style="m" vid="MAT 4:6">ዬግንቲ ጾሳ ቃላይድ ጻፍንቴዛ» ዬጌዛ።<verse eid="MAT 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7"/>የሱሳ ኤኮ፥ «ማካ፥ ‹ጾሳ ቃላይድ ነ ጎዳ፥ ነ ጾሳ ፓጭፐ› ዬግንቲ ጻፍንቴዛ» ግ ማሄዛ።<note caller="-" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="DEU 6:16">ናምእ. 6:16</ref></char></note><verse eid="MAT 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8"/>ዉርስል ዳቡሎሳ የሱሳና ፐቲ ዳማ አምባ ጼራል ከሲ አላመ ካተት ኡ ቦንቻይር ዎላ ቤዚ፥ <verse eid="MAT 4:8"/><verse number="9" style="v" sid="MAT 4:9"/>«ነ ታስ ጹጉኒ ጎይንኮ ታ ኔስ Ꮊያ ኡባ እማዳ» ዬጌዛ።<verse eid="MAT 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10"/>የሱሳ ማሂ ኤኮ፥ «Ꮊ ጻላሃዮ፥ ታፕ ሃኮባ! ‹ነ ጎዳ፥ ነ ጾሳይስ ጎይኖባ፥ ኤዛ ኣዳ ጎይኖባ› ዬግንቲ ጾሳ ቃላይድ ጻፍንቴዛ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="DEU 6:13">ናምእ. 6:13</ref></char></note><verse eid="MAT 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11"/>የይፕ ጉየ፥ ኤዛ ጻላሃይ አሺ ቅቴዛ፤ ኪታንችታይ ይኢ ኤዛ ማዴዛ።<verse eid="MAT 4:11"/></para>
  <para style="s1">የሱሳ ታማርሶ</para>
  <para style="r">(<ref loc="MRK 1:14-15">ማር. 1:14-15</ref>፤ <ref loc="LUK 4:14-15">ሉቃ. 4:14-15</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12"/>የሱሳ፥ ዋንሳ አጭንቴዛና ስኢ ጋልላ ቢታ Ꮊንጌዛ።<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="MAT 14:3">ማቶ. 14:3</ref>፤ <ref loc="MRK 6:17">ማር. 6:17</ref>፤ <ref loc="LUK 3:19-20">ሉቃ. 3:19-20</ref></char></note> <verse eid="MAT 4:12"/><verse number="13" style="v" sid="MAT 4:13"/>ናዝረተ ካታማ አሺ ዛብሎናኔ ንፍታለመ ሄራ፥ አባ ላንቀ የዝ ቅፍርናሆመ ካታማ Ꮊንጊ ኤዛይድ ጋምኤዛ።<note caller="-" style="x"><char style="xo" closed="false">4:13 </char><char style="xt" closed="false"><ref loc="JHN 2:12">ዋን. 2:12</ref></char></note> <verse eid="MAT 4:13"/><verse number="14" style="v" sid="MAT 4:14"/>የይ ሀኔዛይ ናበ ኢሳያሳ ዶናር፥<verse eid="MAT 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15"/>«ዛብሎነ ቢታ፥ ንፍታለመ ቢታ፥</para>
  <para style="q2" vid="MAT 4:15">ዮርዳኖስ ቦርካፕ ሰኮ ፕኖ፥</para>
  <para style="q2" vid="MAT 4:15">አባኮ ካንግዝ ኦገ ጋጻ የዝ፥</para>
  <para style="q2" vid="MAT 4:15">አይሁደ ባ አሳይ ጋንጨ የዝ ጋልላ ቢታ፥<note caller="-" style="x"><char style="xo" closed="false">4:15-16 </char><char style="xt" closed="false"><ref loc="ISA 9:1-2">ኢሳ. 9:1-2</ref></char></note><verse eid="MAT 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16"/>ማ የዝ ዎያ፥</para>
  <para style="q2" vid="MAT 4:16">ዎልቃማ ፖኦ በኤዛ።</para>
  <para style="q1" vid="MAT 4:16">Ꮊይቆ ኩያ በቴዝታይስካ፥</para>
  <para style="q2" vid="MAT 4:16">ፖኦ ከዜዝ»</para>
  <para style="m" vid="MAT 4:16">ዬጊ ኦድንቴዝ ቃላይ ፖልንቶድ ጋርከ።<verse eid="MAT 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17"/>የ ዎደፕ አይኪ የሱሳ፥ «ጾስ ካተትይ ኡኬዝ ግሾስ ይ ናጋራፕ ማቆይታ» ዬጊ ቃላ ሳባኮ አይኬዛ።<note caller="-" style="x"><char style="xo" closed="false">4:17 </char><char style="xt" closed="false"><ref loc="MAT 3:2">ማቶ. 3:2</ref></char></note><verse eid="MAT 4:17"/></para>
  <para style="s1">የሱሳ ቲን ጼጌዝ ታማርታ</para>
  <para style="r">(<ref loc="MRK 1:16-20">ማር. 1:16-20</ref>፤ <ref loc="LUK 5:1-11">ሉቃ. 5:1-11</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18"/>የሱሳ ጋልላ አባ ላንቀር ኣታር ናምኢ እሽታ፥ ጵጽሮሳ ግንትንትዝ ስሞናራኔ ኤ እሻ እንድራሰ በኤዛ። ኡንቲ ሞሎ አይክዝታ ማቄዝ ግሾስ ፋ ግታና አባ ጋንጨ ኦልዛና በኤዛ። <verse eid="MAT 4:18"/><verse number="19" style="v" sid="MAT 4:19"/>የሱሳ ኡንታን፥ «Ꮊና የኦይታ፤ ታና ካሎይታ! ሞሎ አይክዛይ ጋርክ፥ ታ ይንታን አስ አይ ታማርሶዳ» ዬጌዛ። <verse eid="MAT 4:19"/><verse number="20" style="v" sid="MAT 4:20"/>ኡንትካ፥ ኤልሲ ፋ ግታና ኦሊ አሺ የሱሳና ካሎ አይኬዛ።<verse eid="MAT 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21"/>የሱሳ የይፕ ጽቃ ገደ ቲናል Ꮊንጊ ሀራ ናምኢ እሽታ፥ ዛብዶሳ ናእታ፥ ያይቆባራ ዋንሳራ በኤዛ። ፋ አዳ ዛብዶሳራ ዎላ ዎጎሎ ጋንጨ ፋ ግተ ሎእዝን ብኢ ጼጌዛ። <verse eid="MAT 4:21"/><verse number="22" style="v" sid="MAT 4:22"/>ኡንትካ፥ ኤልሲ ፋ ዎጎሎ ጋንጨ ፋ አዳ አሺ የሱሳና ካሌዛ።<verse eid="MAT 4:22"/></para>
  <para style="s1">የሱሳ ሀርግንትዝታ ፓዛ</para>
  <para style="r">(<ref loc="LUK 6:17-19">ሉቃ. 6:17-19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23"/>የሱሳ አይሁድታይ ዎሳ ኬ ታማርስታር፥ ሳሎ ካተት ዎንግለ ኦድታራ ዱማ ዱማ ሀርገፕ አሳ ፓታር ጋልላ ቢታ ኡባ ዩዬዛ።<note caller="-" style="x"><char style="xo" closed="false">4:23 </char><char style="xt" closed="false"><ref loc="MAT 9:35">ማቶ. 9:35</ref>፤ <ref loc="MRK 1:39">ማር. 1:39</ref></char></note><verse eid="MAT 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 4:24"/>የይፕ ደንዴዛይድ ኤ ዋራይ ሶራ ቢታ ኡባ ስእንቴዛ። ዱማ ዱማ ሀርገር ዎቤዝታኔ መትንትዝታ፥ ቱና አያና አይክንቴዝታ፥ ሾጪ ኦልዝ ሀርገር የዝታኔ፥ ስሌዝታ ኤዝኮ ካንጌዛ፤ ኤዝካ ኡንታን ፓዛ።<verse eid="MAT 4:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 4:25"/>አሳይ ጋልላፕ፥ ታጲ ካታምታይፕ፥ የሩሳላመፕ፥ ይሁዳፐራ ዮርዳኖሳፕ ሰኮ ፕኖ የዝ ቢታፕ የኤዝ ጋመ አሳይ ኤዛ ካሌዛ።<verse eid="MAT 4:25"/></para>
  <chapter eid="MAT 4"/>
  <chapter number="5" style="c" sid="MAT 5"/>
  <para style="s1">የሱሳ አምባል አፋ ታማርሴዝ ትምርተ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1"/>ጋመ ዎያ ሺቄዛና የሱሳ ብኢ አምባል አፋ ከዚ በቴዛ። ኤ ታማርታይ ኤዝኮ ሺቅን፥ <verse eid="MAT 5:1"/><verse number="2" style="v" sid="MAT 5:2"/>Ꮊይ ጋርክ ዬጊ ታማርሴዛ፦<verse eid="MAT 5:2"/></para>
  <para style="s1">ቱማ ኡፋይስ</para>
  <para style="r">(<ref loc="LUK 6:2-23">ሉቃ. 6:2-23</ref>)</para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3"/>«አያናር ማንቅታይ አንጅንቴዝታ፥<note caller="+" style="f"><char style="fr" closed="false">5:3 </char><char style="ft" closed="false">አያናር ማንቅታይ ጉሳይ ጾሳል አፋ ካትዝታኔ አማንንትዛ አሳ ጉሲ።</char></note></para>
  <para style="q2" vid="MAT 5:3">ሳሎ ካተትይ ኡንትሲ።<verse eid="MAT 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4"/>ዬክዝታይ አንጅንቴዝታ፥</para>
  <para style="q2" vid="MAT 5:4">ኡ ምን ደማዳ።<note caller="-" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="ISA 61:2">ኢሳ. 61:2</ref></char></note><verse eid="MAT 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5"/>ሃይታይ አንጅንቴዝታ፥</para>
  <para style="q2" vid="MAT 5:5">ኡ ሳአ ላቶዳ።<note caller="-" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="PSA 37:11">ማዝ. 37:11</ref></char></note><verse eid="MAT 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6"/>ጌሸት ናይንትዝታይኔ ሳምንትዝታይ አንጅንቴዝታ፥</para>
  <para style="q2" vid="MAT 5:6">ኡ ምዦዳ።<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="ISA 55:1">ኢሳ. 55:1</ref></char></note><verse eid="MAT 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7"/>ማርዝታይ አንጅንቴዝታ፥</para>
  <para style="q2" vid="MAT 5:7">ኡ ማሮት ደማዳ።<verse eid="MAT 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8"/>ዎዝና ጌሽታይ አንጅንቴዝታ፥</para>
  <para style="q2" vid="MAT 5:8">ኡ ጾሳ በአዳ።<note caller="-" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="PSA 24:3">ማዝ. 24:3</ref></char></note><verse eid="MAT 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9"/>እግንዝታይ አንጅንቴዝታ፥</para>
  <para style="q2" vid="MAT 5:9">ኡ ጾስ ናእታ ግንትንቲ ጼግንቶዳ።<verse eid="MAT 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10"/>ጌሽ ባዝስ ግ፥</para>
  <para style="q2" vid="MAT 5:10">ባይእንትዝታይ አንጅንቴዝታ፥</para>
  <para style="q2" vid="MAT 5:10">ሳሎ ካተትይ ኡንትሲ።<note caller="-" style="x"><char style="xo" closed="false">5:10 </char><char style="xt" closed="false"><ref loc="1PE 3:14">1ጵጽ. 3:14</ref></char></note><verse eid="MAT 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11"/>«አሳይ ይንታን ታ ግሾስ ግ ጫዢ ባይኢ ይንታል አፋ ኢታ ባዝ ኡባ ዎርዶር ኦድኮ ይ አንጅንቴዝታ።<note caller="-" style="x"><char style="xo" closed="false">5:11 </char><char style="xt" closed="false"><ref loc="1PE 4:14">1ጵጽ. 4:14</ref></char></note> <verse eid="MAT 5:11"/><verse number="12" style="v" sid="MAT 5:12"/>ይ ሳሎ Ꮊንጊ ኤኮድ ዎይታይ ዳማ ማቄዝ ግሾስ ኡፋይቶይታ፥ ሀባ ጎይታ። ይንታፕ ቲና የዝ ናብታ Ꮊይ ጋርክ ባይኤዛ።»<note caller="-" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="2CH 36:16">2ዜና. 36:16</ref>፤ <ref loc="ACT 7:52">ሀዋ. ኦ. 7:52</ref></char></note><verse eid="MAT 5:12"/></para>
  <para style="s1">አላማይስ ማጽነኔ ፖኦ ማቅ</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13"/>«ይ ቢታስ ማጽነ፤ ማጽነ ፋ ማጽነት አሽኮ፥ ፋ ማልኦት ዋይዚ ማሂ ደማዴ? ባለ ኦልን አሳር የንቶዳይፕ አትን አብስካ ማዶያ።<note caller="-" style="x"><char style="xo" closed="false">5:13 </char><char style="xt" closed="false"><ref loc="MRK 9:50">ማር. 9:50</ref>፤ <ref loc="LUK 14:34-35">ሉቃ. 14:34-35</ref></char></note><verse eid="MAT 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14"/>«ይ ቢታስ ፖኦ፤ ደረል አፋ የዝ ካታምታ ጌሞዳይስ ዳንዳኦያ።<note caller="-" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="JHN 8:12">ዋን. 8:12</ref>፤ <ref loc="JHN 9:5">9:5</ref></char></note> <verse eid="MAT 5:14"/><verse number="15" style="v" sid="MAT 5:15"/>ጾምፐ አይ ካራ የዝ አስ ኡባይስ ፖኦዳይ ጋርክ ቃ አቆ ጋድዛፕ አትን ኦታ ጋንጨ ጋድዛይ ባያ።<note caller="-" style="x"><char style="xo" closed="false">5:15 </char><char style="xt" closed="false"><ref loc="MRK 4:21">ማር. 4:21</ref>፤ <ref loc="LUK 8:16">ሉቃ. 8:16</ref>፤ <ref loc="LUK 11:33">11:33</ref></char></note> <verse eid="MAT 5:15"/><verse number="16" style="v" sid="MAT 5:16"/>የይ ጋርክ አሳይ ይ ሎኦ ኦሳ ብኢ፥ ሳሎ የዝ ይ አዳ ቦንቾዳይ ጋርክ ይ ፖአይ አስ ቲና ፖኦ።<note caller="-" style="x"><char style="xo" closed="false">5:16 </char><char style="xt" closed="false"><ref loc="1PE 2:12">1ጵጽ. 2:12</ref></char></note><verse eid="MAT 5:16"/></para>
  <para style="s1">ሙሰ ህገ</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17"/>«ታኒ ሙሰ ህጋኔ ናብታይ ቃላ ሻሮዳይስ የኤዛ ይንትስ ኣዝፐ። ታ፥ ፖሎዳይስ የኤዛፕ አትን ሻሮዳይስ የኤካያ። <verse eid="MAT 5:17"/><verse number="18" style="v" sid="MAT 5:18"/>ታ ይንትስ ቱሮ ኦድዛ፤ ሳሎኔ ሳአ ኣድ ሄሎዳይስ ህገ ኡባይ ፖልንቶዳይፕ አትን ህጋይፕ ፐቲ ቃላ ዎይ ፕዳለ ጹቃካ ኣሚ።<note caller="-" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="LUK 16:17">ሉቃ. 16:17</ref></char></note> <verse eid="MAT 5:18"/><verse number="19" style="v" sid="MAT 5:19"/>የይ ግሾስ፥ Ꮊ ኪትታይፕ ጽቅዛ ፐቲ ኪታ መንዛ ኦንካ ማ Ꮊንክታ የይ ጋርክ ኦድ ጋርክ ታማርስዛይ ኦንካ ሳሎ ካተት ኡባፕ ላፋ ማቆዳ። ዝን Ꮊ ኪታ ፖልዝታይኔ Ꮊንክታካ ፖሎድ ጋርክ ታማርስዛይ ሳሎ ካተት ኣ ማቆዳ። <verse eid="MAT 5:19"/><verse number="20" style="v" sid="MAT 5:20"/>ታ ይንትስ ኦድዛ፤ ይ ጽሎትይ ፈርሳውታይ ጽሎትይፐኔ ህገ አስታማርታይ ጽሎትይፕ ኣካ አትኮ፥ ሳሎ ካተት ይ የሻ ገላሚ።<verse eid="MAT 5:20"/></para>
  <para style="s1">ሸምፖ ዎ ባጋ</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21"/>«ይ ማይዝታይስ፥ ‹ዎፓተ፤ ሸምፖ ዎዝ ኦንካ ፕርድንቶዳ› ግንትንቴዛና ይ ስኤዛ።<note caller="-" style="x"><char style="xo" closed="false">5:21 </char><char style="xt" closed="false"><ref loc="EXO 20:13">ከስ 20:13</ref>፤ <ref loc="DEU 5:17">ናምእ. 5:17</ref></char></note> <verse eid="MAT 5:21"/><verse number="22" style="v" sid="MAT 5:22"/>ዝን ታ ይንትስ ኦድዛ፤ ፋ እሻይር ካጭንትዝ ኡባይ ፕርድንቶዳ። ፋ እሻ ጩርቃይ ግዝ ኦንካ ዳይና ቲና ፕርዳስ ሺቆዳ። ፋ እሻይኮ፥ ‹ቱላይ› ግዝ ኦንካ ጋናመ ታማ ፕርድንቶዳ።<verse eid="MAT 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23"/>«የይ ግሾስ፥ ኔኒ ነ ያርሻ ያርሾዳር ነ እሻ ሽፍሼዝ ባዝ ኔስ ቆፍንትኮ፥ <verse eid="MAT 5:23"/><verse number="24" style="v" sid="MAT 5:24"/>ነ ያርሻ ያ አቃይድ አሺ ቅቶባ፤ ቲናቲ Ꮊንጊ ነ እሻይር ጊጎባ፤ ዬዚ ማቂ፥ ነ ያርሻ ጾስስ ያርሾባ።<verse eid="MAT 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25"/>«ነና ሞትዛይራ ፕርደ ኬ Ꮊንግታር ኦገል አፋ ኤዛር ዳቦቶባ። የይ አቶ ጊኮ ኤ ነና ዳይና ቲና ካንጎዳ። ዳይናይ ነና አጭዛይስ ኣ እማዳ፤ ኤ ነና ዎይነ ኦሎዳ። <verse eid="MAT 5:25"/><verse number="26" style="v" sid="MAT 5:26"/>ታ ቱሮ ኦድዛ፤ ሚሻይፕ ፐቲ ሳንትፈ አተካዝ ጭጊ ሃሶድ ሄሎዳይስ አች ኬፕ ነ ኬዛሚ።<verse eid="MAT 5:26"/></para>
  <para style="s1">ላሞዳይስ ቤዞያ</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27"/>« ‹ላምፓተ› ግንትንቴዛና ይ ስኤዛ።<note caller="-" style="x"><char style="xo" closed="false">5:27 </char><char style="xt" closed="false"><ref loc="EXO 20:14">ከስ 20:14</ref>፤ <ref loc="DEU 5:18">ናምእ. 5:18</ref></char></note> <verse eid="MAT 5:27"/><verse number="28" style="v" sid="MAT 5:28"/>ዝን ታ ይንትስ ኦድዛ፥ ማች ብኢ፥ አሞቴዝ ኡባይ ፋ ዎዝና ጋንጨ እዝር ላሜዛ። <verse eid="MAT 5:28"/><verse number="29" style="v" sid="MAT 5:29"/>ነ ኡሻች ኣፋይ ነና ናጋራ ቤዝዛ ማቅኮ፥ ከሲ ኦሎባ። ነ አሻይ ኩንዝን ጋናመ ታማ ጋንጨ ዎዳይፕ ነ አሳተይፐ ፐታይ ብኮ ኔስ ሎኦ።<note caller="-" style="x"><char style="xo" closed="false">5:29 </char><char style="xt" closed="false"><ref loc="MAT 18:9">ማቶ. 18:9</ref>፤ <ref loc="MRK 9:47">ማር. 9:47</ref></char></note> <verse eid="MAT 5:29"/><verse number="30" style="v" sid="MAT 5:30"/>ነ ኡሻች ኩሻይ ነና ናጋራ ኦስዛ ማቅኮ፥ እዞ ጋቺ ኦሎባ። ነ ጋላይ ኩንዝን ጋናመ ታማ ጋንጨ ዎዳይፕ ነ አሳተይፐ ፐታይ ብኮ፥ ኔስ ሎኦ።<note caller="-" style="x"><char style="xo" closed="false">5:30 </char><char style="xt" closed="false"><ref loc="MAT 18:8">ማቶ. 18:8</ref>፤ <ref loc="MRK 9:43">ማር. 9:43</ref></char></note><verse eid="MAT 5:30"/></para>
  <para style="s1">ማቾ አንጆ ባጋ</para>
  <para style="r">(<ref loc="MAT 19:9">ማቶ. 19:9</ref>፤ <ref loc="MRK 10:11-12">ማር. 10:11-12</ref>፤ <ref loc="LUK 16:18">ሉቃ. 16:18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31"/>«ፋ ማቻቶ ዳክዝ ኦንካ አንጆ ዋርቃተ እንጎ» ግንትንቴዛ።<note caller="-" style="x"><char style="xo" closed="false">5:31 </char><char style="xt" closed="false"><ref loc="MAT 19:7">ማቶ. 19:7</ref>፤ <ref loc="MRK 10:4">ማር. 10:4</ref></char></note> <verse eid="MAT 5:31"/><verse number="32" style="v" sid="MAT 5:32"/>ዝን ታ ይንትስ ኦድዛ፤ ፋ ማቻቶ ላግተካዝን ብልእዝ ኦንካ እዛ ላሞድ ጋርክ ኦዛ። የይ ጋርከካ፥ አንጅንቴዝ አስቶ ኤክዛ ኡባይ ላምዛ።<note caller="-" style="x"><char style="xo" closed="false">5:32 </char><char style="xt" closed="false"><ref loc="MAT 19:9">ማቶ. 19:9</ref>፤ <ref loc="MRK 10:11-12">ማር. 10:11-12</ref>፤ <ref loc="LUK 16:18">ሉቃ. 16:18</ref>፤ <ref loc="1CO 7:10-11">1ቆሮ. 7:10-11</ref></char></note><verse eid="MAT 5:32"/></para>
  <para style="s1">ጫቆ ባጋ</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33"/>«ይ ማይዝታይኮ፥ ‹ዎርዶር ጫቂፓተ፤ ይ ጾስ ቲና ጫቀዛና ፖሎይታ› ግንትንቴዛ ይ ስኤዛ።<note caller="-" style="x"><char style="xo" closed="false">5:33 </char><char style="xt" closed="false"><ref loc="LEV 19:12">ለዊ. 19:12</ref>፤ <ref loc="NUM 30:2">ታይ. 30:2</ref>፤ <ref loc="DEU 23:21">ናምእ. 23:21</ref></char></note> <verse eid="MAT 5:33"/><verse number="34" style="v" sid="MAT 5:34"/>ዝን ታ ይንትስ ኦድዛ፤ ኡባራካ ጫቂፓተ። ጾሳይ በትዛ ዙፋነ ማቄዝ ግሾስ ሳሎር ጫቂፓተ።<note caller="-" style="x"><char style="xo" closed="false">5:34 </char><char style="xt" closed="false"><ref loc="MAT 23:22">ማቶ. 23:22</ref></char></note> <verse eid="MAT 5:34"/><verse number="35" style="v" sid="MAT 5:35"/>ኤ ቶካይ የዝ አቆ ማቄዝ ግሾስ ሳአራካ ጫቂፓተ። ግታ ካት ካታማ ማቄዝ ግሾስ የሩሳላመራካ ጫቂፓተ።<note caller="-" style="x"><char style="xo" closed="false">5:35 </char><char style="xt" closed="false"><ref loc="ISA 66:1">ኢሳ. 66:1</ref>፤ <ref loc="PSA 48:2">ማዝ. 48:2</ref></char></note> <verse eid="MAT 5:35"/><verse number="36" style="v" sid="MAT 5:36"/>ይ ብናናይፕ ፐታካ ቦ ዎይ ካር ኡዶዳይስ ዳንዳኦዋ ግሾስ ይንቲ ይ ኡባራካ ጫቂፕፓተ። <verse eid="MAT 5:36"/><verse number="37" style="v" sid="MAT 5:37"/>የይ ግሾስ፥ ይ ቃላይ፥ ‹ኤ› ዎይ ‹ዋኣ› ማቆ። የይፕ አቴዛይ ኢታፕ ይእዛ።<verse eid="MAT 5:37"/></para>
  <para style="s1">ኩሸ ከሶዳይስ ቤዞያ</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38"/>« ‹ኣፈ ግሾስ ኣፈ፤ አች ግሾስ አች› ግንትንቴዛ ይ ስኤዛ።<note caller="-" style="x"><char style="xo" closed="false">5:38 </char><char style="xt" closed="false"><ref loc="EXO 21:24">ከስ 21:24</ref>፤ <ref loc="LEV 24:20">ለዊ. 24:20</ref>፤ <ref loc="DEU 19:19">ናምእ. 19:19</ref></char></note> <verse eid="MAT 5:38"/><verse number="39" style="v" sid="MAT 5:39"/>ዝን ታ ይንትስ ኦድዛ፤ ይንታል አፋ ኢታ ባዝ ኦዝ አካ እጽፓተ። ኦንካ ነ ኡሻች ሻንጋላ ባቂኮ ነ ሀድርስ ሻንጋላካ ቤዞባ። <verse eid="MAT 5:39"/><verse number="40" style="v" sid="MAT 5:40"/>ፐቲ አሲ ነ ሻምዥቶ ኤኮዳይስ ነና ዳይናል ሞትኮ፥ ነ ኮታቶ ጉጂ እንጎባ። <verse eid="MAT 5:40"/><verse number="41" style="v" sid="MAT 5:41"/>ኦንካ አሲ ነና ዎልቃር ፋባዝ ቶሲ ፐቲ ክሎ ምትረ ባጋ ኦገ ፋር Ꮊንጎድ ጋርክ ነና ጭጵችኮ፥ ኤዛር ናምእ ዳኮ ኦገ Ꮊንጎባ። <verse eid="MAT 5:41"/><verse number="42" style="v" sid="MAT 5:42"/>ዎስዛ ኦስካ እንጎባ፤ ኔፐ ጋርጾዳይስ ኮይዝ ኦናካ ካይፐ።»<verse eid="MAT 5:42"/></para>
  <para style="s1">ነ ሞርክታ ቃባ</para>
  <para style="r">(<ref loc="LUK 6:27-28">ሉቃ. 6:27-28</ref>፥ <ref loc="LUK 6:32-36">32-36</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43"/>« ‹ነና ቃዛና ቃባ፤ ነና እጽዛና እጾባ› ግንትንቴዛና ይ ስኤዛ። <verse eid="MAT 5:43"/><verse number="44" style="v" sid="MAT 5:44"/>ዝን ታ ይንትስ ኦድዛ፤ ይ ሞርክታ ቃይታ፤ ይንታን ቆህዝታይስ ዎሶይታ። <verse eid="MAT 5:44"/><verse number="45" style="v" sid="MAT 5:45"/>የይ ጋርክ ይ ኦኮ፥ ሳሎ የዝ ይ አዳይስ ይ ናእታ ማቆዳ። ኤ ኢትታይስኔ ሎእታይስ አዋ ከስዛ፤ ጽልታይስኔ ናጋራንችታይስ ፋ እራ ቡክስዛ። <verse eid="MAT 5:45"/><verse number="46" style="v" sid="MAT 5:46"/>ይንታን ቃዛ አስ ኣዳ ይ ቃኮ፥ ይንትስ አባ ዎይቶ የኔ? ሀራ አቶዝን፥ ቃራጸ ጋችስዝታይካ ይኖ ኦሳ? <verse eid="MAT 5:46"/><verse number="47" style="v" sid="MAT 5:47"/>ይንቲ፥ ይ እሽታይ ኣዳ ሳሮኮ፥ Ꮊንክታይፕ አብ ሀራ ኣዝባዝ ኦኔ? ሀራ አቶዝን፥ ጾስ አማኖዋ አሳይካ ይኖ ኦሳ? <verse eid="MAT 5:47"/><verse number="48" style="v" sid="MAT 5:48"/>ይኬ፥ ሳሎ የዝ ይ አዳይ ፎሎ ማቄዛይ ጋርክ ይንትካ ፎሎ ማቆይታ።»<note caller="-" style="x"><char style="xo" closed="false">5:48 </char><char style="xt" closed="false"><ref loc="LEV 19:2">ለዊ. 19:2</ref>፤ <ref loc="DEU 18:13">ናምእ. 18:13</ref></char></note><verse eid="MAT 5:48"/></para>
  <chapter eid="MAT 5"/>
  <chapter number="6" style="c" sid="MAT 6"/>
  <para style="s1">ማንቅታይስ እንግ ባጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1"/>«ጉጅካ የሱሳ Ꮊይ ጋርክ ዬጌዛ፤ አሲ ቦኦ ግ ይ ሎኦ ኦሳ አስ ቲና ኦማይ ጋርክ ናግንቶይታ። የይፕ አትኮ ሳሎ የዝ ይ አዳይፕ ዎይቶ ደንጋሚ።<note caller="-" style="x"><char style="xo" closed="false">6:1 </char><char style="xt" closed="false"><ref loc="MAT 23:5">ማቶ. 23:5</ref></char></note><verse eid="MAT 6:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2"/>«ይንቲ ማንቅታይስ እንግታር አስ ቲና ቦንችንቶዳይስ ግ ጩቢታይ ኦገ ዶናይዳኔ አይሁድታይ ዎሳ ኬታይድ ኦዛይ ጋርክ አሲ ቦኦ ግ ቱልቱላ ፑግስፓተ። ታ ይንትስ ቱሮ ኦድዛ፤ ኡንቲ ፋ ዋጋ ኤኬዛ። <verse eid="MAT 6:2"/><verse number="3" style="v" sid="MAT 6:3"/>ዝን ይ ማንቅታይስ እንጎዳር ይ ኡሻች ኩሻይ ኦዛና ይ ሀድርስ ኩሻይ ኤርፐ፤ <verse eid="MAT 6:3"/><verse number="4" style="v" sid="MAT 6:4"/>ይኬ እማይ ጌማ ማቆ። ጌማ ኦዛና ብእዛ ይ አዳይ ይንትስ ዎይቶ ፕ እማዳ።<verse eid="MAT 6:4"/></para>
  <para style="s1">ዎሳ ባጋ</para>
  <para style="r">(<ref loc="LUK 11:2-4">ሉቃ. 11:2-4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5"/>«ዎሳ ዎስታር ጩቦ አሳይ ጋርክ ሀንፓተ። ኡ ፋና አሲ ቦኦ ግ አይሁድታይ ዎሳ ኬ ጋንጨኔ ኦገ ዶናል ኤቂ ዎስዛና ዶስዛ። ታ ይንትስ ቱሮ ኦድዛ፤ ኡንቲ ፋ ኩን ጋተ ኤኬዛ።<note caller="-" style="x"><char style="xo" closed="false">6:5 </char><char style="xt" closed="false"><ref loc="LUK 18:10-14">ሉቃ. 18:10-14</ref></char></note> <verse eid="MAT 6:5"/><verse number="6" style="v" sid="MAT 6:6"/>ዝን ነ ዎስታር ነ ቆልአ ገሊ ጋዛራ ጎርዲ ጌማ የዝ ነ አዳይኮ ዎሶባ፤ ጌማ ኦስንቴዝ ባዝ ብእዛ ነ አዳይ ኔስ ነ ጋታ እማዳ። <verse eid="MAT 6:6"/><verse number="7" style="v" sid="MAT 6:7"/>ይ ዎስታር አማኖዋ አስ ጋርክ ጨረ ቃላ ማሂ ማሂ አዱስስ ዎስፓተ። ኡ አዱስስ ዎስኮ ጾሲ ስእዛ ግ ቆፕዛ። <verse eid="MAT 6:7"/><verse number="8" style="v" sid="MAT 6:8"/>የይ ግሾስ ኡንቲሳይ ጋርክ ሀንፓተ። አብስ ጊኮ ይ አዳይ ይንትስ አቢ ኮሽዛኮ ይ ዎሶዳይፕ ቲናቲ ኤርዛ። <verse eid="MAT 6:8"/><verse number="9" style="v" sid="MAT 6:9"/>ይኬ፥ ይ ዬጊ ዎሶይታ፦</para>
  <para style="q1" vid="MAT 6:9">« ‹ሳሎ የዝ ኑ አዳዮ፥</para>
  <para style="q1" vid="MAT 6:9">ነ ሱንይ አንጅንቶ።<verse eid="MAT 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10"/>ነ ካተትይ የኦ፥</para>
  <para style="q2" vid="MAT 6:10">ነ ሸናይ ሳሎ ሀኔዛይ ጋርክ</para>
  <para style="q2" vid="MAT 6:10">ሳአላካ ሀኖ።<verse eid="MAT 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11"/>ጋላሳ ካ Ꮊይኖ ኑስ እንጎባ።<verse eid="MAT 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12"/>ኑኒ ኑና ቆሄዝታይስ፥ አቶ ግዛይ ጋርክ፥</para>
  <para style="q2" vid="MAT 6:12">ኑስካ ኑ ቆሄዝ ባዝ አቶ ጎባ።<verse eid="MAT 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13"/>ኑና ኢታፕ አሾባፕ አትን</para>
  <para style="q2" vid="MAT 6:13">ፓጨ ጋንጨ ገልስፐ።</para>
  <para style="q1" vid="MAT 6:13">ካተት፥ ዎልቃኔ ቦንቾ</para>
  <para style="q2" vid="MAT 6:13">መናስ ኔሲ። አምንኤ።›<note caller="+" style="f"><char style="fr" closed="false">6:13</char><char style="fqa" closed="false">ካተት፥ ዎልቃኔ ቦንቾ መናስ ኔሲ። አምንኤ፦ </char><char style="ft" closed="false">ግዛይ ፐቲ ፐቲ ብኒ ማጻፍታይድ ባያ።</char></note><verse eid="MAT 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14"/>«ይ ይንታን ቆሄዝታይስ አቶ ጊኮ፥ ሳሎ የዝ ይ አዳይ ይ ቆሄዝ ባዝካ አቶ ጎዳ።<note caller="-" style="x"><char style="xo" closed="false">6:14-15 </char><char style="xt" closed="false"><ref loc="MRK 11:25-26">ማር. 11:25-26</ref></char></note> <verse eid="MAT 6:14"/><verse number="15" style="v" sid="MAT 6:15"/>ዝን ይ ሀራ አስ ናጋራ አቶ ጋም እጽኮ ይ አዳይ ይ ናጋራ አቶ ጋሚ።»<verse eid="MAT 6:15"/></para>
  <para style="s1">ጾማ ባጋ</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16"/>«ይ ጾምታር ጩቢታይ ጋርክ ሹልፓተ። አብስ ጊኮ፥ ኡንቲ ጾምዛና አሲ ኤሮድ ጋርክ ፋ ስና ካይስዛ። ታ ቱሮ ኦድዛ፤ ኡንቲ ፋ ጋታ ኤኬዛ።<verse eid="MAT 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 6:17"/>«ዝን ነ ጾምታር ነ አፋ ሜጮባ፥ ነ ኦማ ትዥንቶባ። <verse eid="MAT 6:17"/><verse number="18" style="v" sid="MAT 6:18"/>የይ ጋርክ ነ ኦኮ ነ ጾምዛ ጾማይ አሳፕ ጌምዛ፥ ዝን ጌማ የዝ ነ አዳይ ኤርዛ ጾማ ማቃዳ። ጌማ ኦስንቴዝ ባዝ ብእዛ ነ አዳይ ኔስ ዎይቶ እማዳ።<verse eid="MAT 6:18"/></para>
  <para style="s1">ሻሎ ሳሎ ሺሾ ባጋ</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19"/>«ብላኔ ዎሾ ብስዛ አቆ፥ ካይዞ ቦኪ ኤክዛ አቆ፥ Ꮊ ሳአል፥ ይንትስ ሻሎ ሺሽፓተ።<note caller="-" style="x"><char style="xo" closed="false">6:19 </char><char style="xt" closed="false"><ref loc="JAS 5:2">ያይ. 5:2</ref></char></note> <verse eid="MAT 6:19"/><verse number="20" style="v" sid="MAT 6:20"/>ዝን ብላኔ፥ ዎሾ፥ ብሶዋ፥ ካይዞ ቦኪ ኤኮዋ አቆ ሳሎ ይንትስ ሻሎ ሺሾይታ። <verse eid="MAT 6:20"/><verse number="21" style="v" sid="MAT 6:21"/>ነ ሻላይ የዛ አቆ ነ ዎዝናይካ ኤዛይድ የዞዳ።<verse eid="MAT 6:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22"/>«ኣፈ አሰት ኡባስ ጾምፐ። የይ ግሾስ፥ ነ ኣፋይ ፓ ማቅኮ ነ ጋላይ ኡባይ ፖኦ ማቅዛ። <verse eid="MAT 6:22"/><verse number="23" style="v" sid="MAT 6:23"/>ነ ኣፋይ ሀርግንትዛ ማቅኮ ነ ኩን አሰትይ ማ ማቅዛ። ይኬ፥ ኔል የዝ ፖአይ ማ ማቅኮ፥ ማይ አብ ጋርክ ኣ ሞደሻ!<verse eid="MAT 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24"/>«ፐቲ አሲ ናምኢ ጎድታይስ ሞድንቶዳይስ ዳንዳኦያ። ፐታ ቃኮ Ꮊንካ እጽዛ፤ ዎይ ፐታ ቦንችኮ Ꮊንካ ለቂዛ። ጾስስኔ ሚሸስ ሞድንቶዳይስ ዳንዳኦያ።<verse eid="MAT 6:24"/></para>
  <para style="s1">ኡንእንትፓተ</para>
  <para style="r">(<ref loc="LUK 12:22-31">ሉቃ. 12:22-31</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25"/>«ይኬ፥ ስኦይታ! ይ ሸምፓይስ፥ ‹አብ ማዴ? አብ ኡዦደ?<note caller="+" style="f"><char style="fr" closed="false">6:25</char><char style="fqa" closed="false">አብ ኡዦደ </char><char style="ft" closed="false">ግዛይ ብኒ ማጻፍታይድ ባያ።</char></note> አብ ማኦደ?› ግ ቆፕፓተ፤ ሸምፖ ካፕ፥ ጋላ ማኦፕ ኣሳኔ? <verse eid="MAT 6:25"/><verse number="26" style="v" sid="MAT 6:26"/>ሳሎ ካፍታ ቦኦይታ፤ ኡንቲ ዘሮያ፥ ቡጮያ፥ ሻለ ኦሎያ፥ ዝን ይ ሳሎ አዳይ ኡንታን ሙዝዛ። የዝን ይ ኡንታፕ ሎእ ኣሳኔ? <verse eid="MAT 6:26"/><verse number="27" style="v" sid="MAT 6:27"/>ይ ጋንጨፕ ኡንእንቲ ፋ ላይል አፋ ፐቲ ጋላስ ጉጆዳይስ ዳንዳእዛይ የኔ?<verse eid="MAT 6:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28"/>«ማ ይንቲ ማእዛባዝስ አብስ ኡንእንትኔ? ዎራ የዝ ፉታ ቦኦይታ፥ ኡ ኦሶር ዳቡሮያ ዎይ ሱቆያ። <verse eid="MAT 6:28"/><verse number="29" style="v" sid="MAT 6:29"/>ሀራ አቶዝን፥ ካት ሶሎሞነ ፋ ቦንቾ ኡባይር Ꮊ ፉታይፕ ፐታይ ጋርክ ማኤካያ።<note caller="-" style="x"><char style="xo" closed="false">6:29 </char><char style="xt" closed="false"><ref loc="1KI 10:4-7">1ካት. 10:4-7</ref>፤ <ref loc="2CH 9:3-6">2ዜና. 9:3-6</ref></char></note> <verse eid="MAT 6:29"/><verse number="30" style="v" sid="MAT 6:30"/>ይንታኖ፥ አማኖ ፓጬዝታዮ፥ ጾሳይ Ꮊይኖ በንቲ ዎንታ ታማ ጋንጨ ዎዳይስ የዝ ማታ ዬዚ ማእስዛ ማቅኮ፥ ይንታን ኡንታፕ ኣ ዋይዚ ማእሶሳ? <verse eid="MAT 6:30"/><verse number="31" style="v" sid="MAT 6:31"/>የይ ግሾስ፥ ‹አብ ማዴ? አብ ኡዦደ? አብ ማኦደ?› ግ ኡንእንትፐተ። <verse eid="MAT 6:31"/><verse number="32" style="v" sid="MAT 6:32"/>Ꮊያ ኡባ ጾስ አማኖዋ አሳይ ጋን ደንጎዳይስ ኡንእንትዛ። ይ ሳሎ አዳይ የ ኡባይ ይንትስ ኮሽዛና ኤርዛ። <verse eid="MAT 6:32"/><verse number="33" style="v" sid="MAT 6:33"/>ዝን ኡባፕ ቲን ጾስ ካተትኔ ኤ ጽሎት ኮዦይታ፤ የ ኡባይ ይንትስ ጉዥንቶዳ። <verse eid="MAT 6:33"/><verse number="34" style="v" sid="MAT 6:34"/>የይ ግሾስ፥ ዎንታስ ቆፕታር ኡንእንትፓተ። ዎንታ ፓስ መትንቶ፤ ፐቲ ፐቲ ጋላሳይስ ኤ ኢታትይ ግዶዳ።<verse eid="MAT 6:34"/></para>
  <chapter eid="MAT 6"/>
  <chapter number="7" style="c" sid="MAT 7"/>
  <para style="s1">ሀራ አሳል አፋ ፕርድፓተ</para>
  <para style="r">(<ref loc="LUK 6:37-42">ሉቃ. 6:37-42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1"/>«ይንታል አፋ ፕርድንታማይ ጋርክ ሀራ አሳል አፋ ፕርድፓተ። <verse eid="MAT 7:1"/><verse number="2" style="v" sid="MAT 7:2"/>አብስ ጊኮ፥ ሀራ አሳል አፋ ይ ፕርድዛይ ጋርክ ይንታል አፋ ፕርዶዳ ይ ሀራ አስስ ማኬዝ ባዛር ይንትስ ማሂ ማክንቶዳ።<note caller="-" style="x"><char style="xo" closed="false">7:2 </char><char style="xt" closed="false"><ref loc="MRK 4:24">ማር. 4:24</ref></char></note> <verse eid="MAT 7:2"/><verse number="3" style="v" sid="MAT 7:3"/>ነ ኣፈ የዝ ቱሳ በኤካዛር ነ እሻይ ኣፈ የዝ ቡጻ አብስ በኤ? <verse eid="MAT 7:3"/><verse number="4" style="v" sid="MAT 7:4"/>ነ ኣፈ ቱስ የዝን ነ እሻይ ኣፈ የዝ ቡጻ ከሶ ጎዳይስ ዋይዚ ዳንዳኤ? <verse eid="MAT 7:4"/><verse number="5" style="v" sid="MAT 7:5"/>ነኖ ጩባዮ፥ ቲናቲ ነ ኣፋይድ የዝ ቱሳ ከሶባ። ኤዛይፕ ጉየ ነ እሻይ ኣፋይድ የዝ ቡጻ ከሶዳይስ ነ ምልጽ ኡዲ በአዳ።<verse eid="MAT 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6"/>«ጉየ ማቂ ይንታን ቃማይ ጋርክ ጌሽ ባዝ ካንታይስ ኦልፓተ። ፋ ቶካይር የ ኢሳማይ ጋርክ ይ አልኦ እንቁ ጉዱዳይልታይ ቲና ኦልፓተ።<verse eid="MAT 7:6"/></para>
  <para style="s1">ዎሶይታ፥ ኮዦይታ፥ ጼጎይታ</para>
  <para style="r">(<ref loc="LUK 11:9-13">ሉቃ. 11:9-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7"/>«ዎሶይታ ይንትስ እንግንቶዳ፥ ኮዦይታ ይ ደማዳ ባለ ይኢ ጼጎይታ ይንትስ ዶይንቶዳ። <verse eid="MAT 7:7"/><verse number="8" style="v" sid="MAT 7:8"/>ዎስዛ ኦስካ እንግንቶዳ ኮይዝ ኦስካ በንቶዳ ባለ ይኢ ጼግዝ ኦስካ ዶይንቶዳ።<verse eid="MAT 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 7:9"/>«ይንታፕ ናአ ዳቦ ዎስኮ ሹች እንግዛይ ኦኖ? <verse eid="MAT 7:9"/><verse number="10" style="v" sid="MAT 7:10"/>ዎይ ሞሎ ዎስኮ ሾሽ እንግዛይ የኔ? <verse eid="MAT 7:10"/><verse number="11" style="v" sid="MAT 7:11"/>የዝን ይ ኢትታይ ይ ናእታይስ ሎኦ ባዝ እሞ ኤርኮ ሳሎ የዝ ይ አዳይ ፋና ዎስዝታይስ ሎኦ ባዝ ዋይዚ ጋን እንጋሞ? <verse eid="MAT 7:11"/><verse number="12" style="v" sid="MAT 7:12"/>Ꮊንክታይ ይንትስ ኦድ ጋርክ ይ ኮዥዝ ባዝ ኡባ ይንትካ ሀራ አስስ ኦይታ። አብስ ጊኮ፥ ሙሰ ህጋይኔ ናብታይ ታማርስዛይ Ꮊያ።<note caller="-" style="x"><char style="xo" closed="false">7:12 </char><char style="xt" closed="false"><ref loc="LUK 6:31">ሉቃ. 6:31</ref></char></note><verse eid="MAT 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13"/>«ኡንአ ፐንገር ገሎይታ፤ ቦ ካንግዝ ኦጋይ ዳማ፥ ፐንጋይካ ዳልገ። ኤዛይር ገልዛ አሳይካ ጋመ። <verse eid="MAT 7:13"/><verse number="14" style="v" sid="MAT 7:14"/>ዝን ደኦኮ ካንግዝ ኦጋይኔ ፐንጋይ ኡንአ፤ ኤዛይር ገልዛ አሳይካ ጽቃ።<verse eid="MAT 7:14"/></para>
  <para style="s1">ም ፋ ኣፈር ኤርንትዛ</para>
  <para style="r">(<ref loc="LUK 6:43-44">ሉቃ. 6:43-44</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15"/>«አፋ ባጋር ዱረ ኣዚ ጋንጨር ፉገ ማቂ ቦንቆዳይስ ይ ጋንጨ ገልዛ ዎርዶ ናብታይፕ ናግንቶይታ። <figure style="fig" alt="Sheep and wolves" file="LB00011B.tif" size="span" ref="7:15">ዱርኔ ፉገ</figure> <verse eid="MAT 7:15"/><verse number="16" style="v" sid="MAT 7:16"/>ይ ኡንታን፥ ኡ ኣፋይር ኤሮዳ፤ አንጉፕ ዎይኔ፥ ግጀፕ ባላሰ ማጽንቶያ። <verse eid="MAT 7:16"/><verse number="17" style="v" sid="MAT 7:17"/>የይ ጋርክ ሎኦ ም ኡባይ ሎኦ ኣፈ ኣፍዛ፤ ኢታ ም ኢታ ኣፈ ኣፍዛ። <verse eid="MAT 7:17"/><verse number="18" style="v" sid="MAT 7:18"/>ሎኦ ም ኢታ ኣፈ ኣፎያ፥ ማ ኢታ ም ሎኦ ኣፈ ኣፎዳይስ ዳንዳኦያ። <verse eid="MAT 7:18"/><verse number="19" style="v" sid="MAT 7:19"/>ሎኦ ኣፈ ኣፎዋ ም ኡቢታይ ጋችንቲ ታማ ጋንጨ ኦልንቶዳ።<note caller="-" style="x"><char style="xo" closed="false">7:19 </char><char style="xt" closed="false"><ref loc="MAT 3:10">ማቶ. 3:10</ref>፤ <ref loc="LUK 3:9">ሉቃ. 3:9</ref></char></note> <verse eid="MAT 7:19"/><verse number="20" style="v" sid="MAT 7:20"/>የይ ግሾስ፥ ይ ኡንታን፥ ኡ ኣፋትር ኤሮዳ።<note caller="-" style="x"><char style="xo" closed="false">7:20 </char><char style="xt" closed="false"><ref loc="MAT 12:33">ማቶ. 12:33</ref></char></note><verse eid="MAT 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21"/>«ሳሎ የዝ ታ አዳይ አዛዞ ኦዛ አይ ሳሎ ካተት ገሎዳይፕ አትን ጨር ታና ‹ጎዳዮ፥ ጎዳዮ› ግዝ ኡባይ ሳሎ ካተት ገሎያ። <verse eid="MAT 7:21"/><verse number="22" style="v" sid="MAT 7:22"/>የ ዎደ ጋምታይ፥ ‹ጎዳዮ፥ ጎዳዮ፥ ነ ሱንር ትንቢተ ኑ ኦደካሳ? ነ ሱንር ቱና አያንታ ኑ ከሰካሳ? ነ ሱንር ጋመ ማላታ ኑ ኦካሳ?› ዬጎዳ። <verse eid="MAT 7:22"/><verse number="23" style="v" sid="MAT 7:23"/>የ ዎደ፥ ‹ታ ይንታን የሻ ኤሮያ፥ ይንቲ ዉጭታይ ታፕ ሃኮይታ› ዬጎዳ።<note caller="-" style="x"><char style="xo" closed="false">7:23 </char><char style="xt" closed="false"><ref loc="PSA 6:8">ማዝ. 6:8</ref></char></note><verse eid="MAT 7:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24"/>«ይኬ፥ Ꮊ ታ ቃላ ስኢ ኦዛ ኦንካ ፋ ኬ ዛላል አፋ ኬጼዝ ዎዛናማ አስ ጋርከ። <verse eid="MAT 7:24"/><verse number="25" style="v" sid="MAT 7:25"/>እራ ቡኬዛ፥ ድኦ ድኤዛ፥ ጫርኮካ ጫርኪ የ ኬና ኡርቄዛ። ዝን ኬይ ዛላል አፋ ኬጽንቴዝ ግሾስ ዎደካያ። <verse eid="MAT 7:25"/><verse number="26" style="v" sid="MAT 7:26"/>Ꮊ ታ ቃላ ስኢ ኦዋ ኦንካ ፋ ኬ ሻፈል አፋ ኬጼዝ ቦዞ አይ ጋርከ። <verse eid="MAT 7:26"/><verse number="27" style="v" sid="MAT 7:27"/>እራ ቡኪ፥ ድኦ ድኢ፥ ጫርኮካ ጫርኪ፥ የ ኬ ኡርቅን፥ የ ኬይ ዎዴዛ፤ ኤ ዎድይካ ዎልቃማ» ዬጌዛ።<verse eid="MAT 7:27"/></para>
  <para style="p">
    <verse number="28-29" style="v" sid="MAT 7:28-29"/>የሱሳ ፋ ኦዳ ዉርሴዛይፕ ኤ ትምርታይ ህገ አስታማርታይ ጋርክ ማቀካ ማዉተር የዝ አሳይሳይ ጋርክ ማቅዝ ግሾስ አሳይ ኤ ትምርታ Ꮊይ ማላባዝ ጌዛ።<note caller="-" style="x"><char style="xo" closed="false">7:28-29 </char><char style="xt" closed="false"><ref loc="MRK 1:22">ማር. 1:22</ref>፤ <ref loc="LUK 4:32">ሉቃ. 4:32</ref></char></note><verse eid="MAT 7:28-29"/></para>
  <chapter eid="MAT 7"/>
  <chapter number="8" style="c" sid="MAT 8"/>
  <para style="s1">የሱሳ ቦርቆንቶር የዝ አ ፓዛ</para>
  <para style="r">(<ref loc="MRK 1:40-45">ማር. 1:40-45</ref>፤ <ref loc="LUK 5:12-16">ሉቃ. 5:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1"/>የሱሳ ደረላፕ ዎዝ ዎደ ጋመ ዎያ ኤዛ ካሌዛ። <verse eid="MAT 8:1"/><verse number="2" style="v" sid="MAT 8:2"/>ፐቲ ቦርቆንቶር ሀርግንትዛይ ኤዝኮ ሺቂ፥ ኤ ቲናይድ ጹጉኒ፥ «ጎዳዮ፥ ነ ሸነ ማቅኮ ታና ጌሺ ፓዳይስ ነ ዳንዳእዛ» ዬጌዛ። <verse eid="MAT 8:2"/><verse number="3" style="v" sid="MAT 8:3"/>የሱሳ ፋ ኩሻ ዳኪ ኤዛ ቦቺ፥ «ኤ ታ ሸነ፥ ጌዦባ» ዬጌዛ። አይ ቦርቆንታይፕ እዝር ጌዢ አቴዛ። <verse eid="MAT 8:3"/><verse number="4" style="v" sid="MAT 8:4"/>የሱሳ ኤዝኮ፥ «ነ ፓጻ ኦስካ ኦድፐ። ዝን Ꮊንጊ ነ ጌዢ ፓጼዛና ቄሰ ቤዞባ። ነ ፓጼዛይስ ማርካ ማቆዳይ ጋርክ Ꮊንጊ ሙሰ ኪቴዝ ያርሻ ያርሾባ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">8:4 </char><char style="xt" closed="false"><ref loc="LEV 14:1">ለዊ. 14:1</ref></char></note><verse eid="MAT 8:4"/></para>
  <para style="s1">ማቶ ሀላቃይ አማና</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5"/>የሱሳ ቅፍርናሆመ ግዝ ካታማ ሄሌዝ ዎደ ፐቲ ማቶ ሀላቃይ ኤዝኮ ሺቂ፥ <verse eid="MAT 8:5"/><verse number="6" style="v" sid="MAT 8:6"/>«ጎዳዮ፥ ታ አይላይ ጋላይ ስልን ኢታ ሀርግንቲ ካራ ዎይኢ የዛ» ዬጊ ዎሴዛ።<verse eid="MAT 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7"/>የሱሳ ማሂ ኤዝኮ፥ «ታኒ Ꮊንጊ ኤዛ ፓዳ» ዬጌዛ።<verse eid="MAT 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8"/>ዝን ማቶ ሀላቃይ ማሂ፥ «ጎዳዮ ነ ታ ካራ ገሎዳይስ ታ ቤዝዛ አስ ባያ፥ ዝን ነ Ꮊኔ በቲ ቃላ ኣዳ ኦዶባ ታ አይላይ ፓጾዳ። <verse eid="MAT 8:8"/><verse number="9" style="v" sid="MAT 8:9"/>ታፕ አፋር ታና ኪትዛ አሳይ የዛ፥ ማ ታፕ ኣሞር ታስ ኪትንትዝታይ የዛ። ኡንታፕ ፐታ፥ ‹ቅቶባ› ጊኮ ቅትዛ፤ ማ Ꮊንካና ‹Ꮊና የኦባ!› ጊኮ ይእዛ። ታ አይላ፥ ‹Ꮊኖ ኦባ› ጊኮ ኦዛ» ዬጌዛ።<verse eid="MAT 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10"/>የሱሳ የያ ስኢ ማላባዝ ግ፥ ፋና ካልዛ አሳይኮ፥ «ታ ይንትስ ቱሮ ኦድዛ፤ ታኒ Ꮊይ ጋርክ ጻላ አማኖ እስሬለ አሳይ ጋንጨካ በኤካያ። <verse eid="MAT 8:10"/><verse number="11" style="v" sid="MAT 8:11"/>ታ ይንትስ ኦድዛ፤ ጋምታይ አዋ ከስኔ አዋ ገሎ ባጋፕ ይኢ፥ ሳሎ ካተት አፍራመር፥ እሳቃራኔ ያይቆባራ ዎላ እማቶል በቶዳ።<note caller="-" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="LUK 13:29">ሉቃ. 13:29</ref></char></note> <verse eid="MAT 8:11"/><verse number="12" style="v" sid="MAT 8:12"/>ዝን ሳሎ ካተት ላቶዳይስ ቤዞዳር አቴዝታይ ባለ ማ ኦልንቶዳ። ኤዛይድ ኡንትስ ዬፎኔ አች ጮንች ማቃዳ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="MAT 22:13">ማቶ. 22:13</ref>፤ <ref loc="MAT 25:30">25:30</ref>፤ <ref loc="LUK 13:28">ሉቃ. 13:28</ref></char></note><verse eid="MAT 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13"/>የሱሳ ማቶ ሀላቃይኮ፥ «ነ ካራ ቅቶባ፥ ነ አማናቲ ጋርክ ኔስ ሀኖ» ዬጌዛ። ኤ አይላይ ያ ሳታተ ፓጼዛ።<verse eid="MAT 8:13"/></para>
  <para style="s1">የሱሳ ጋመ ሀርግንቴዝታ ፓዛ</para>
  <para style="r">(<ref loc="MRK 1:29-34">ማር. 1:29-34</ref>፤ <ref loc="LUK 4:38-41">ሉቃ. 4:38-41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14"/>የሱሳ ጵጽሮሳ ካራ ገሎዳር ጵጽሮሳ ማቻት እንዳት ኦጸ ምሻ ሀርገር ሀርግንቲ ዎይኢ የዛኖ በኤዛ። <verse eid="MAT 8:14"/><verse number="15" style="v" sid="MAT 8:15"/>የሱሳ እ ኩሻ ቦቼዛን ጋርክ ኦጻይኔ ምሻይ ኤቄዛ። ፓጺ ደንዲ ኤዛ ሞኬዛ።<verse eid="MAT 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16"/>የ ዎደ ኦማ ቱና አያናር አይክንቴዝ ጋመ አስታ፥ አሳይ የሱሳኮ ከኤዛ። ኤዝካ ቱና አያንታ ፋ ቃላር ከሴዛ፥ ሀርግንቴዝታ ኡብታ ፓዛ። <verse eid="MAT 8:16"/><verse number="17" style="v" sid="MAT 8:17"/>የይዳካ ናበ ኢሳያሳ፥</para>
  <para style="q1" vid="MAT 8:17">«ኤ ኑ ዳቡርሳ ፋስ ኤኬዛ፥</para>
  <para style="q2" vid="MAT 8:17">ኤ ኑ ሀርጋ ቶኬዛ»</para>
  <para style="m" vid="MAT 8:17">ጌዝ ቃላይ ፖልንቴዛ።<note caller="-" style="x"><char style="xo" closed="false">8:17 </char><char style="xt" closed="false"><ref loc="ISA 53:4">ኢሳ. 53:4</ref></char></note><verse eid="MAT 8:17"/></para>
  <para style="s1">የሱሳ ካልዝታ ሄልዝ መቶ</para>
  <para style="r">(<ref loc="LUK 9:57-62">ሉቃ. 9:57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18"/>የሱሳ ጋመ አሳይ ኤ ካለ ኤቄዝታ ብኢ፥ አባፕ ሰኮ ፕኖ ፒንጎድ ጋርክ ፋ ታማርታ ኪቴዛ። <verse eid="MAT 8:18"/><verse number="19" style="v" sid="MAT 8:19"/>ህገ አስታማርታይፕ ፐታይ፥ «አስታማራዮ፥ ነ Ꮊንግዛ አቆ ኡባ ታ ካሎዳ» ዬጌዛ።<verse eid="MAT 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20"/>የሱሳ ኤዝኮ «ሻንታይስ ኦላ የዛ፥ ሳሎ ካፍታይስ ኬ የዛ። ዝን አስ ናአይስ ፋ ኦማ ሸምፕስዛ አቆ ባያ» ዬጌዛ።<verse eid="MAT 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21"/>የሱሳ ካልዛ አስታይፕ ፐታይ፥ «ጎዳዮ፥ ታኒ ቲናቲ Ꮊንጊ ታ አዳ ሞጊ የኦዳ» ዬጌዛ።<verse eid="MAT 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22"/>ዝን የሱሳ፥ «Ꮊይቄዝታይ ፋ Ꮊይቂታ ሞጎ፤ ኔኒ ታና ካሎባ» ዬጌዛ።<verse eid="MAT 8:22"/></para>
  <para style="s1">የሱሳ ጎተ ስኢ ኡዴዛ</para>
  <para style="r">(<ref loc="MRK 4:35-41">ማር. 4:35-41</ref>፤ <ref loc="LUK 8:22-25">ሉቃ. 8:22-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23"/>የሱሳ Ꮊማዳይስ ዎጎሎ ጋንጨ ገሎዳር ኤ ታማርታይካ ኤዛር Ꮊማዳይስ ካሌዛ። <verse eid="MAT 8:23"/><verse number="24" style="v" sid="MAT 8:24"/>ኡንቲ ቆፐካ የዝን፥ ዎልቃማ ጎተ አባል አፋ ደንድን ዎጎላይ ምትንቶዳይስ ሄሌዛ። ዝን የሱሳ ገንቴዛ። <verse eid="MAT 8:24"/><verse number="25" style="v" sid="MAT 8:25"/>ኤ ታማርታይ ኤዝኮ ሺቂ ኤዛ ባርክ፥ «ጎዳዮ፥ ኑ ቦሆ ኑና አሾዬ» ዬጊ ደንዛ።<verse eid="MAT 8:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26"/>የሱሳ ኡንትኮ፥ «ይንታኖ፥ አማኖ ፓጬዝታዮ፥ አብስ ያሽተ?» ዬጌዛ። ደንዲ፥ ጫርካኔ ጎታ ሴርን ኤልሲ ኡባ ባዝ ጭጭርክ ጌዛ።<verse eid="MAT 8:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27"/>ኤ ታማርታይ ማላባዝ ግ፥ «Ꮊይ፥ ሀራ አቶዝን፥ ጎተነ አባ ኪትንትዛይ ዋፋ አሶ?» ዬጌዛ።<verse eid="MAT 8:27"/></para>
  <para style="s1">ቱና አያና አይኬዝ ናምኢ አስታ</para>
  <para style="r">(<ref loc="MRK 5:1-20">ማር. 5:1-20</ref>፤ <ref loc="LUK 8:26-39">ሉቃ. 8:26-39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28"/>የሱሳ አባፕ ሰኮ ፕኖ የዝ ገርገሶነ ግዝ ቢታ ሄሎዳር ቱና አያና አይኬዝ ናምኢ አስታይ ዱፎፕ ከዚ ኤዛ ሄሌዛ። ኡ ኢታ ያሽዝ አስታ ማቄዝ ግሾስ አሲ የ አቃይር ኣዳይስ ዳንዳኦያ። <verse eid="MAT 8:28"/><verse number="29" style="v" sid="MAT 8:29"/>ኡንትካ፥ «ጾስ ናአዮ፥ ኑራኔ ኔራ አቢ ዎል ሄል? ኑ ቃማይ ሄለካዝን ኑና ፕርዶዳይስ ነ የኤኔ?» ግ ኡኬዛ።<verse eid="MAT 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30"/>ኡንታፕ ጋመ ሃከካዛር ጉዳይለ ዉደ ሄንግንትዝታይ የዛ። <verse eid="MAT 8:30"/><verse number="31" style="v" sid="MAT 8:31"/>ቱና አያንታይ የሱሳ፥ «ነ ኑና ከስዛ ባዝ ማቅኮ፥ ሰኮ ጉዳይለ ዉዳይ ጋንጨ ዳኮየ» ዬጊ ዎሴዛ።<verse eid="MAT 8:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32"/>የሱሳ፥ «Ꮊንጎይታ» ዬጌዛ። ቱና አያንታይ ከዚ ጉዳይልታይል ገሌዛ። ጉዳይልታይ ኡባይ ጋጋ ዶናር ድርጊ Ꮊንጊ አባ ጋንጨ ምትንቲ Ꮊይቄዛ።<verse eid="MAT 8:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 8:33"/>ጉዳይለ ዉደ ሄንግዝታይ ቆስንቲ ካታማ Ꮊንጊ፥ ሀኔዝባዝኔ ቱና አያናይ አይኬዝ አሳይል አፋ ኦስንቴዝ ባዝ ኡብታ ኦዴዛ። <verse eid="MAT 8:33"/><verse number="34" style="v" sid="MAT 8:34"/>የዝን፥ ካታማ ጋንጨ የዝ አስ ኡቢታይ የሱሳ በአዳይስ ከዜዝ። ኡንቲ የሱሳ በኤዝ ዎደ ፋ ቢታፕ ከዚ ቅቶድ ጋርክ ዎሴዛ።<verse eid="MAT 8:34"/></para>
  <chapter eid="MAT 8"/>
  <chapter number="9" style="c" sid="MAT 9"/>
  <para style="s1">ስሌዝ አይ ፓጾ</para>
  <para style="r">(<ref loc="MRK 2:1-12">ማር. 2:1-12</ref>፤ <ref loc="LUK 5:17-26">ሉቃ. 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1"/>የይፕ ጉየ፥ የሱሳ ዎጎሎ ጋንጨ ገሊ፥ አባ ፒንጊ ፋ ካታማ Ꮊንጌዛ። <verse eid="MAT 9:1"/><verse number="2" style="v" sid="MAT 9:2"/>አሳይ ፐቲ ስላ አ አርሳር ቶኪ የሱሳኮ ከኤዛ። የሱሳ ኡ አማና ብኢ፥ ስላ አ፥ «ታ ናአዮ፥ ያሽትፐ! ነ ናጋራይ አቶ ግንትንቴዛ» ዬጌዛ።<verse eid="MAT 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3"/>የ ሳታይድ፥ አይሁድታይ ህገ አስታማርታይፕ ፐታይ ፐታይ፥ «Ꮊይ ጾስ ጫዥዛ» ዬጊ ኡ ፋ ዎዝናር ቆፔዛ።<verse eid="MAT 9:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4"/>የሱሳ ኡ ቆፋ ኤሪ፥ «ኢታ ባዝ ይ ዎዝናር አብስ ቆፔ? ዬጌዛ <verse eid="MAT 9:4"/><verse number="5" style="v" sid="MAT 9:5"/>ዝን፥ ‹ነ ናጋራይ አቶ ግንትንቴዛ› ግዛይፐነ ‹ደንዲ ቅቶባ› ግዛይፕ ኣይ ኣ? <verse eid="MAT 9:5"/><verse number="6" style="v" sid="MAT 9:6"/>ዝን ቢታል አፋ ናጋራ አቶ ጎዳይስ አስ ናአይስ ማዉተ የዛና ታ ይንታን ኤርሶዳ» ዬጊ፥ ስላ አይኮ፥ «ደንዲ ነ አርሳ ቶኪ፥ ነ ካራ Ꮊንጎባ» ዬጌዛ።<verse eid="MAT 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 9:7"/>ስላ አይ ደንዲ ፋ ካራ ቅቴዛ። <verse eid="MAT 9:7"/><verse number="8" style="v" sid="MAT 9:8"/>ዎያይ የያ ብኢ ማላባዝ ጌዛ። የይ ጋርክ ማዉተ አስስ እንጌዝ ጾሳ ጋላቴዛ።<verse eid="MAT 9:8"/></para>
  <para style="s1">ማቶሳ ጼግንት</para>
  <para style="r">(<ref loc="MRK 2:13-17">ማር. 2:13-17</ref>፤ <ref loc="LUK 5:27-32">ሉቃ. 5:27-32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9"/>የሱሳ የይፕ ደንዲ Ꮊንግታር ማቶሳ ግዝ አይ ቃራጸ ጋችስዝ አቆ በቴዝን ብኢ፥ «ታና ካሎባ» ዬጌዛ።</para>
  <para style="p" vid="MAT 9:9">ኤዝካ ደንዲ ካሌዛ።<verse eid="MAT 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10"/>የሱሳ ማቶሳ ካራ ሙንታል አፋ በቴዝን፥ ቃራጸ ጋችዝ ጋመ አስታይኔ ናጋራ ኦዝ አሳይ ይኢ ኤዛራኔ ኤ ታማርታይር ዎላ ማዳይስ በቴዛ።<note caller="-" style="x"><char style="xo" closed="false">9:10-11 </char><char style="xt" closed="false"><ref loc="LUK 15:1-2">ሉቃ. 15:1-2</ref></char></note> <verse eid="MAT 9:10"/><verse number="11" style="v" sid="MAT 9:11"/>ፐቲ ፐቲ ፈርሳወ አሳይ የያ ብኢ፥ የሱሳ ታማርታ፥ «ይ አስታማራይ ቃራጸ ጋችሽዝታይራኔ ናጋራ ኦዝታይር አብስ ሜ?» ዬጌዛ።<verse eid="MAT 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12"/>የሱሳ የያ ስኢ፥ «አክመ ኮሽዛይ ሀርግንቴዝታይስፕ አትን ፓታይስ ባያ። <verse eid="MAT 9:12"/><verse number="13" style="v" sid="MAT 9:13"/>ዝን ይ Ꮊንጊ፥ ‹ታኒ ይ ያርሻ ባዝን ማሮት ኮይዛ› ጉሳይ ዋጉስዛኮ ኤሮይታ። አብስ ጊኮ፥ ታ ናጋራ ኦዝታ ጼጎዳይስ የኤዛፕ አትን ጽልታ ጼጎዳይስ የኤካያ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="MAT 12:7">ማቶ. 12:7</ref>፤ <ref loc="HOS 6:6">ሆሳ. 6:6</ref></char></note><verse eid="MAT 9:13"/></para>
  <para style="s1">የሱሳ ጾማ ባጋ ኦይጭንቴዛ</para>
  <para style="r">(<ref loc="MRK 2:18-22">ማር. 2:18-22</ref>፤ <ref loc="LUK 5:33-39">ሉቃ. 5:33-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14"/>የ ዎደ ዋንሳ ታማርታይ የሱሳኮ ሺቂ፥ «ኑራኔ ፈርሳወ አሳይ ጾምዛ፥ ዝን ነ ታማርታይ አብስ ጾሞሳ?» ዬጊ ኦይጬዛ።<verse eid="MAT 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15"/>የሱሳ ማሂ ኡንትኮ፥ «ማቾ ኤክዛይ ኡንታር የዝን ላዛንታይ አዛኖዳይስ ዳንዳእኔ? ማቾ ኤክዛይ ኡ አቻፕ ኤክንቶድ ዎደ የኦዳ፥ ኡ የ ዎደ ጾሞዳ።<verse eid="MAT 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16"/>«ኦሮ ማኦፕ ፔ ጭማ ማኦል አፋ ስክዛ ኦንካ ባያ። የይ ጋርክ ኦኮ ኦሮይ ጭማና ፐርእዛ። ፐርእይካ ጉጂ ዳልግዛ። <verse eid="MAT 9:16"/><verse number="17" style="v" sid="MAT 9:17"/>ኦሮ ዎይነ ጭማ ኦጎሮ ጋንጨ ዳኪ ጋድዛ ኦንካ ባያ። የይ ጋርክ ኦኮ ኦሮ ዎይናይ ጭማ ኦጎራ ስዛ ዎይናይካ ላልንትዛ፤ ኦጎራይካ ናምአን አዶዋ ባዝ ማቅዛ። ዝን ኦሮ ዎይነ ኦሮ ኦጎሮ ጋንጨ ኦልንቶዳይስ ቤዝዛ። የይ ጋርክ ኦስንትኮ ናምእታይካ ኢተካዛር ናግንትዛ» ዬጌዛ። <figure style="fig" alt="Wineskin" file="LB00145B.tif" size="span" ref="9:17">ዎይነ ኦጎሮ</figure><verse eid="MAT 9:17"/></para>
  <para style="s1">Ꮊይቄዝ ናአቶኔ የሱሳ አፍላ ቦቼዝ አስቶ</para>
  <para style="r">(<ref loc="MRK 5:21-43">ማር. 5:21-43</ref>፤ <ref loc="LUK 8:40-56">ሉቃ. 8:40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18"/>የሱሳ የያ ኦዶል አፋ የዝን፥ አይሁደ ሀላቅታይፕ ፐታይ ኤዝኮ ይኢ፥ ኤ ቲናይድ ጹጉኒ፥ «ታ ናአታ Ꮊት Ꮊይቄዛ፥ ዝን እዛ ፓጾድ ጋርክ ነ ይኢ ነ ኩሻ እዝል አፋ ጋዶየ» ግ ዎሴዛ። <verse eid="MAT 9:18"/><verse number="19" style="v" sid="MAT 9:19"/>የሱሳ ደንዲ ኤዛር Ꮊንጌዛ፤ ኤ ታማርታይካ ካሌዛ።<verse eid="MAT 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20"/>ኤ Ꮊማዳር ታጶ ናምኢ ላይ ኩን ሱ ጎግ ዋይዛ ፐቲ አስታ ጉየር ሺቂ የሱሳ አፍላ ማጫራ ቦቼዛ። <verse eid="MAT 9:20"/><verse number="21" style="v" sid="MAT 9:21"/>እዛ ፋ ዎዝናር፥ «ታ ኤ አፍላ ማጫርቶ ኣዳ ቦችዛኮ ፓጾዳ» ዬጊ ቆፔዛ።<verse eid="MAT 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22"/>የሱሳ ጉየ ማቂ እዞ ብኢ፥ «ታ ናአተ፥ ያሽትፐ! ነና ነ አማናይ ፓዛ» ዬጌዛ። የ አስታ እዝር ፓጺ አቴዛ።<verse eid="MAT 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23"/>የሱሳ አይሁደ ሀላቃይ ካራ ሄሎዳር ድንከ ፑግዝታኔ ዬክዝታ ብኢ፥ <verse eid="MAT 9:23"/><verse number="24" style="v" sid="MAT 9:24"/>«አን ሀልኦይታ፤ ጽቃ ናአታ ገንቴዛፕ አትን Ꮊይቀካያ» ዬጌዛ። ዝን አሳይ ኤዛል አፋ ሚጬዛ። <verse eid="MAT 9:24"/><verse number="25" style="v" sid="MAT 9:25"/>አሳ ባለ ከሴዛይፕ ጉየ ካራ ገሊ፥ ናአት ኩሻ አይክን፥ ናአታ ደንዲ ኤቄዛ። <verse eid="MAT 9:25"/><verse number="26" style="v" sid="MAT 9:26"/>የ ዋራይ የ ቢታ ኡባ ሄሌዛ።<verse eid="MAT 9:26"/></para>
  <para style="s1">የሱሳ ናምኢ ቶእታ ፓዛ</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27"/>የሱሳ ኤዛይር ገደ ቲና Ꮊንጎዳር ናምኢ ቶእታይ ፋ ቃላ ቅ ኡዲ፥ «ዳዉተ ናአዮ፥ ኑና ማሮየ» ግ ኡክታር ኤዛ ካሌዛ።<verse eid="MAT 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28"/>የሱሳ ካራ ገሎዳር ቶእታይ ኤዛ ካል የኤዛ። የሱሳ ኡንትኮ፥ «ታኒ የያ ኦዳይስ ዳንዳእዛና ይ አማንኔ?» ዬጌዛ።</para>
  <para style="p" vid="MAT 9:28">ኡንትካ፥ «ኤ፥ ጎዳዮ» ዬጊ ማሄዛ።<verse eid="MAT 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29"/>የይፕ ጉየ፥ የሱሳ ኡ ኣፋና ቦቺ ኡንትኮ፥ «ይንትስ፥ ይ አማናይ ጋርክ ሀኖ» ዬጌዛ። <verse eid="MAT 9:29"/><verse number="30" style="v" sid="MAT 9:30"/>ኡ ኣፋይካ ዶይንቴዛ። የሱሳ ኡንትኮ፥ «Ꮊያ ኦስካ ኦድፓተ» ዬጊ ሚን ኦዴዛ። <verse eid="MAT 9:30"/><verse number="31" style="v" sid="MAT 9:31"/>ዝን አስታይ Ꮊንጊ የሱሳ ኦሳ የ ቢታ ኡባይል ኦዴዛ።<verse eid="MAT 9:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32"/>ኡንቲ የይፕ ከሳዳር አሳይ ቱና አያናይ አይኬዝ ፐቲ ሙመ አስ የሱሳኮ ከኤዛ። <verse eid="MAT 9:32"/><verse number="33" style="v" sid="MAT 9:33"/>ቱና አያናይ ከዜዛይፕ ጉየ ሙመ አይ ኦድንቴዛ፥ ዎይታይካ ማላባዝ ግ፥ «Ꮊይ ጋርክ ኦሮ ባዝ እስሬለ ቢታል የሻ ሀነካ ባዝ» ዬጌዛ።<verse eid="MAT 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34"/>ዝን ፈርሳውታይ፥ «ቱና አያንታይ ሀላቃይር ቱና አያንታ ከስዛ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">9:34 </char><char style="xt" closed="false"><ref loc="MAT 10:25">ማቶ. 10:25</ref>፤ <ref loc="MAT 12:24">12:24</ref>፤ <ref loc="MRK 3:22">ማር. 3:22</ref>፤ <ref loc="LUK 11:15">ሉቃ. 11:15</ref></char></note><verse eid="MAT 9:34"/></para>
  <para style="s1">የሱሳ ዎያይስ ቃንቴዛ</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35"/>የሱሳ አይሁድታይ ዎሳ ኬ ታማርስታር፥ ሳሎ ካተት ዎንግለ ሳባክታር፥ አሳ ሀርገ ኡባይፕ ፓታር ካታምታይራኔ ሄራ ኡባይር ዩዬዛ።<note caller="-" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="MAT 4:23">ማቶ. 4:23</ref>፤ <ref loc="MRK 1:39">ማር. 1:39</ref>፤ <ref loc="LUK 4:44">ሉቃ. 4:44</ref></char></note> <verse eid="MAT 9:35"/><verse number="36" style="v" sid="MAT 9:36"/>ጋመ ዎያ፥ ሄንግዝ አስ ባ ዱር ጋርክ ኡንታን ብእዛ አስ ብን ኡንእንቴዝታኔ ላልንቲ የዝታ ብኢ ኡንትስ ቃንቴዛ።<note caller="-" style="x"><char style="xo" closed="false">9:36 </char><char style="xt" closed="false"><ref loc="NUM 27:17">ታይ. 27:17</ref>፤ <ref loc="1KI 22:17">1ካት. 22:17</ref>፤ <ref loc="2CH 18:16">2ዜና. 18:16</ref>፤ <ref loc="EZK 34:5">ኢዝቀ. 34:5</ref>፤ <ref loc="MRK 6:34">ማር. 6:34</ref></char></note> <verse eid="MAT 9:36"/><verse number="37" style="v" sid="MAT 9:37"/>ፋ ታማርታይኮ፥ «ሺቆድ ቶርቼ ካይ ጋመ፥ ዝን ቶርቼ ካ ሺሽዛ አሳይ ጽቃ።<note caller="-" style="x"><char style="xo" closed="false">9:37-38 </char><char style="xt" closed="false"><ref loc="LUK 10:2">ሉቃ. 10:2</ref></char></note> <verse eid="MAT 9:37"/><verse number="38" style="v" sid="MAT 9:38"/>የይ ግሾስ፥ ጎዳይ ቶርቼ ካ ሺሾዳይስ ኦሶ አስታ ዳኮድ ጋርክ ቶርቼ ጎዳ ዎሶይታ» ዬጌዛ።<verse eid="MAT 9:38"/></para>
  <chapter eid="MAT 9"/>
  <chapter number="10" style="c" sid="MAT 10"/>
  <para style="s1">የሱሳ ኪቴዝ ታጶ ናምኢ ሀዋርታ</para>
  <para style="r">(<ref loc="MRK 3:13-19">ማር. 3:13-19</ref>፤ <ref loc="LUK 6:12-16">ሉቃ. 6:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1"/>የሱሳ ታጶ ናምኢ ታማርታ ፋኮ ጼጊ፥ ቱና አያንታ ከሶድ ጋርከኔ ሀርገ ኡባ ፓዳይ ጋርክ ኡንትስ ማዉተ እንጌዛ።<verse eid="MAT 10:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 10:2"/>ታጶ ናምኢ ሀዋርታይ ሱን፦ ኡንትካ ጵጽሮሳ ግዝ ስሞናራኔ ኤ እሻ እንድራሰ፥ ዛብዶሳ ናአ ያይቆባራ ኤ እሻ ዋንሳ፥ <verse eid="MAT 10:2"/><verse number="3" style="v" sid="MAT 10:3"/>ፍልጶሳ ባርቶሎሞሳ፥ ቶማሳ ቃራጸ ጋችስዝ ማቶሳ፥ ኢልፎሳ ናአ ያይቆባ፥ ታዶሳ፥ <verse eid="MAT 10:3"/><verse number="4" style="v" sid="MAT 10:4"/>ቀነና ስሞናራኔ የሱሳ ኣ እንጌዝ አስቆሮቶ ይሁዳ።<verse eid="MAT 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5"/>የ ታጶ ናምእታ የሱሳ ኪቲ ዳክታር፥ «አይሁደ ባዝታይኮ Ꮊንግፓተ፥ ማ ሳማርታይ ካታማ ገልፓተ። <verse eid="MAT 10:5"/><verse number="6" style="v" sid="MAT 10:6"/>ዝን እስሬለ ካራፕ ማቄዝ ሰክ ቤዝ ዱርታይኮ Ꮊንጎይታ። <verse eid="MAT 10:6"/><verse number="7" style="v" sid="MAT 10:7"/>Ꮊንጊ፥ ‹ሳሎ ካተትይ ኡኬዛ› ግ ኦዶይታ።<note caller="-" style="x"><char style="xo" closed="false">10:7-15 </char><char style="xt" closed="false"><ref loc="LUK 10:4-12">ሉቃ. 10:4-12</ref></char></note> <verse eid="MAT 10:7"/><verse number="8" style="v" sid="MAT 10:8"/>ሀርግንቴዝታ ፓይታ፥ Ꮊይቄዝታ Ꮊይቆፐ ደንይታ፥ ቦርቆንቶ ሀርገር የዝታ ጌሺ ፓይታ፥ ቱና አያንታ ከሶይታ። ይ ጨር ኤኬዛና ጨር እንጎይታ። <verse eid="MAT 10:8"/><verse number="9" style="v" sid="MAT 10:9"/>ይ ኪሰ ዎርቀ፥ ዎይ ብራ ሳንተ አይክፓተ። <verse eid="MAT 10:9"/><verse number="10" style="v" sid="MAT 10:10"/>ይ ኦገስ ቁርቦ፥ ናምኢ አፍላ፥ ዎይ ጫማ ዎይ ጉፈ አይክፓተ፤ ኦሶ ኦዝታይስ ካ ኮሽዛ።<note caller="-" style="x"><char style="xo" closed="false">10:10 </char><char style="xt" closed="false"><ref loc="1CO 9:14">1ቆሮ. 9:14</ref>፤ <ref loc="1TI 5:18">1ጽማ. 5:18</ref></char></note><verse eid="MAT 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11"/>«ይ ካታማ ዎይ ሄራ ገሎዳር ይንታን ሞኪ ኤኮዳይስ ኡፋይትዛ አ ኮዢ ኤ ካራ ሸምፖይታ፤ ይ ከዚ Ꮊማድ ጋላሳ ሄሎዳይስ ኤዛይድ ጋምኦይታ። <verse eid="MAT 10:11"/><verse number="12" style="v" sid="MAT 10:12"/>ማ ኦ ካራካ ገልታር ሳሮይታ። <verse eid="MAT 10:12"/><verse number="13" style="v" sid="MAT 10:13"/>የ ኬይ ይንታን ሞክኮ ይ ሳሮዝ ሳራይ ኡንታን ሄሎ፥ ዝን ኡ ሞካም እጽኮ ይ ሳሮዝ ሳራይ ይንትስ ጉየ ማቆ። <verse eid="MAT 10:13"/><verse number="14" style="v" sid="MAT 10:14"/>ኦንካ ይንታን ሞኮዋ ባዝ ማቅኮኔ ይ ኦዴዝባዝ ስአም እጽኮ የ ካርትፕ ዎይ የ ካታምትፕ ከዝታር ይ ቶከል የዝ ቡልአ ፕቲ ከዞይታ።<note caller="-" style="x"><char style="xo" closed="false">10:14 </char><char style="xt" closed="false"><ref loc="ACT 13:51">ሀዋ. ኦ. 13:51</ref></char></note> <verse eid="MAT 10:14"/><verse number="15" style="v" sid="MAT 10:15"/>ታ ይንትስ ቱሮ ኦድዛ፤ ጾስ ፕርዳ ጋላስ የ ካታማትፐ ሶዶመስራኔ ጋሞራ ካታምታይስ ፕርዳይ ካዉዦዳ።<note caller="-" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="MAT 11:24">ማቶ. 11:24</ref>፤ <ref loc="GEN 19:24">መ. 19:24</ref></char></note><verse eid="MAT 10:15"/></para>
  <para style="s1">ባይእ</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16"/>«ታ ይንታን ዱርታይ ጋርክ ፉግታይ ጋንጨ ዳኮዳ። የይ ግሾስ፥ ሾሽ ጋርክ ኤጭታ፥ ሆለ ጋርክ ሀይታ ማቆይታ።<note caller="-" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="LUK 10:3">ሉቃ. 10:3</ref></char></note> <verse eid="MAT 10:16"/><verse number="17" style="v" sid="MAT 10:17"/>አሳይ ይንታን ፕርዳ ዳይንታይስ ኣ እማዳ፥ ማ አይሁድታይ ዎሳ ኬይድ ይንታን አላንጎዳ። የይ ግሾስ፥ ኡንታፕ ናግንቶይታ።<note caller="-" style="x"><char style="xo" closed="false">10:17-20 </char><char style="xt" closed="false"><ref loc="MRK 13:9-11">ማር. 13:9-11</ref>፤ <ref loc="LUK 12:11-12">ሉቃ. 12:11-12</ref>፤ <ref loc="LUK 21:12-15">21:12-15</ref></char></note> <verse eid="MAT 10:17"/><verse number="18" style="v" sid="MAT 10:18"/>ታ ግሾስ ግ ይንታን ጋደ አቅስዝታይ ቲናኔ ካትታይ ቲና ካንጎዳ። ኡ ቲናይዳኔ አይሁደ ባ ዎያ ቲና ኤቂ ይ ታባዝ ማርካቶዳ። <verse eid="MAT 10:18"/><verse number="19" style="v" sid="MAT 10:19"/>ዝን ይንታን ፕርዳስ ኣ እንጎዳር ዋጎ አብ ማሆ ግ ኡንእንትፓተ፤ የ ሳተ ይ ጎድባዝ ጾስ ይንትስ እማዳ። <verse eid="MAT 10:19"/><verse number="20" style="v" sid="MAT 10:20"/>አብስ ጊኮ፥ ይንታር ማቂ ኦድዛይ ይ አዳይ አያናፕ አትን ይንታን ባያ።<verse eid="MAT 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21"/>«ኢሻይ ፋ እሻ፥ አዳይ ፋ ናአ፥ Ꮊይቆስ ኣ እማዳ፥ ናእታይ ፋና የሌዝታይል አፋ ደንዲ ዎዳ።<note caller="-" style="x"><char style="xo" closed="false">10:21 </char><char style="xt" closed="false"><ref loc="MRK 13:12">ማር. 13:12</ref>፤ <ref loc="LUK 21:16">ሉቃ. 21:16</ref></char></note> <verse eid="MAT 10:21"/><verse number="22" style="v" sid="MAT 10:22"/>ታ ሱንይ ግሾስ ግ አሲ ኡባይ ይንታን እጾዳ፥ ዝን ዉርስይ ሄሎዳይስ ጋርዤዛይ አቶዳ።<note caller="-" style="x"><char style="xo" closed="false">10:22 </char><char style="xt" closed="false"><ref loc="MAT 24:9">ማቶ. 24:9</ref>፤ <ref loc="MRK 13:13">ማር. 13:13</ref>፤ <ref loc="LUK 21:17">ሉቃ. 21:17</ref>፤ <ref loc="MAT 24:13">ማቶ. 24:13</ref>፤ <ref loc="MRK 13:13">ማር. 13:13</ref></char></note> <verse eid="MAT 10:22"/><verse number="23" style="v" sid="MAT 10:23"/>ፐቲ ካታማፕ ይንታን ኡ ባይእኮ ሀራ ካታማ ቆስንቶይታ። ታኒ ይንትስ ቱሮ ኦድዛ፤ አስ ናአይ የኦድ ሄሎዳይስ፥ ይ እስሬለ ካታማ ኡባ ፖላሚ።<verse eid="MAT 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24"/>«ታማራይ ፋ አስታማራይፕ፥ አይላይ ፋ ጎዳይፕ ኣያ።<note caller="-" style="x"><char style="xo" closed="false">10:24 </char><char style="xt" closed="false"><ref loc="LUK 6:40">ሉቃ. 6:40</ref>፤ <ref loc="JHN 13:16">ዋን. 13:16</ref>፤ <ref loc="JHN 15:20">15:20</ref></char></note> <verse eid="MAT 10:24"/><verse number="25" style="v" sid="MAT 10:25"/>ታማራይ ፋ አስታማራ፥ አይላይ ፋ ጎዳ ኣዝኮ ኤዝስ ግዶዳ። ካራ አዳ ብኤልዘቡላ ጊኮ ኤ ካራ አሳ ዋይዚ ኢሲ ጼጎዴ?<note caller="-" style="x"><char style="xo" closed="false">10:25 </char><char style="xt" closed="false"><ref loc="MAT 9:34">ማቶ. 9:34</ref>፤ <ref loc="MAT 12:24">12:24</ref>፤ <ref loc="MRK 3:22">ማር. 3:22</ref>፤ <ref loc="LUK 11:15">ሉቃ. 11:15</ref></char></note><verse eid="MAT 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26"/>«ይኬ፥ አስስ ያሽትፓተ፥ ካምንቴዝ ባዝ ቆንጮዳ፥ ቆስንቴዝ ባዝ ፕ ከዘካዛር አታሚ።<note caller="-" style="x"><char style="xo" closed="false">10:26 </char><char style="xt" closed="false"><ref loc="MRK 4:22">ማር. 4:22</ref>፤ <ref loc="LUK 8:17">ሉቃ. 8:17</ref></char></note> <verse eid="MAT 10:26"/><verse number="27" style="v" sid="MAT 10:27"/>ታ ይንትስ ማ ኦድዛና ይ ፖኦ ኦዶይታ፤ ታ ይንትስ ሀየ ካለ ካልካሼዝ ባዝ ደረል አፋ ዎያስ አዋጆይታ። <verse eid="MAT 10:27"/><verse number="28" style="v" sid="MAT 10:28"/>አሾፕ አትን ሸምፖ ዎዳይስ ዳንዳኦዝታይስ ያሽትፓተ። ዝን ሸምፖኔ አሾ ጋናመ ብሶዳይስ ዳንዳእዛ ጾሳይስ ኣ ያሽቶይታ። <verse eid="MAT 10:28"/><verse number="29" style="v" sid="MAT 10:29"/>ናምኢ ሱንታይ ፐቲ ባካና ባይዝንቶሳኔ? ዝን፥ ኡንታፕ ፐታካ ይ አዳይ ጌካዝን ሳአ ዎ አቶያ። <verse eid="MAT 10:29"/><verse number="30" style="v" sid="MAT 10:30"/>ሀራ አቶዝን፥ ይ ኦማ ብናናይካ ፓይድንቲ የዛ። <verse eid="MAT 10:30"/><verse number="31" style="v" sid="MAT 10:31"/>ይኬ፥ ጋመ ሱንታይፕ ይ ኣዝ ግሾስ ያሽትፓተ።<verse eid="MAT 10:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32"/>«አስ ቲና ታስ ማርካትዝ ኡባይስ ታንካ ሳሎ የዝ ታ አዳይ ቲና ማርካቶዳ። <verse eid="MAT 10:32"/><verse number="33" style="v" sid="MAT 10:33"/>ዝን አስ ቲና ታና ካድዛና ታንካ ሳሎ የዝ ታ አዳይ ቲና ኤዛ ካዶዳ።<note caller="-" style="x"><char style="xo" closed="false">10:33 </char><char style="xt" closed="false"><ref loc="2TI 2:12">2ጽማ. 2:12</ref></char></note><verse eid="MAT 10:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34"/>«ታ ሳአል ሳሮ ኮኦዳይስ የኤዛ ይንትስ ኣዝፐ። ታ ኦላፕ አትን ሳሮት ኮኦዳይስ የኤካያ። <verse eid="MAT 10:34"/><verse number="35" style="v" sid="MAT 10:35"/>ታ የኤዛይ፥</para>
  <para style="q1" vid="MAT 10:35">«‹ናአ አዳይፕ</para>
  <para style="q2" vid="MAT 10:35">ናአቶ እንዳትፕ፤</para>
  <para style="q2" vid="MAT 10:35">ናአይ ማቻቶ አዝናይ እንዳትፕ ሻኮዳይሲ።<note caller="-" style="x"><char style="xo" closed="false">10:35-36 </char><char style="xt" closed="false"><ref loc="MIC 7:6">ሚካ. 7:6</ref></char></note><verse eid="MAT 10:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="MAT 10:36"/>አስስ ሞርኬ ኤ ካራ አስታ ማቃዳ።›<verse eid="MAT 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37"/>«ታፕ ኣ ፋ ኣዳ ዎይ ፋ እንዳቶ ዶስዛይ፥ ታስ ማቆዳይስ ቤዞያ። ፋ ራ ናአ ዎይ ፋ ማች ናአቶ ታፕ ኣ ዶስዛይ፥ ታባዝ ማቆዳይስ ቤዞያ። <verse eid="MAT 10:37"/><verse number="38" style="v" sid="MAT 10:38"/>ፋ ማዝቃለ ቶኪ ታና ካሎዋ ኦንካ ታባዝ ማቆዳይስ ቤዞያ።<note caller="-" style="x"><char style="xo" closed="false">10:38 </char><char style="xt" closed="false"><ref loc="MAT 16:24">ማቶ. 16:24</ref>፤ <ref loc="MRK 8:34">ማር. 8:34</ref>፤ <ref loc="LUK 9:23">ሉቃ. 9:23</ref></char></note> <verse eid="MAT 10:38"/><verse number="39" style="v" sid="MAT 10:39"/>ፋ ሸምፖ አሾዳይስ ኮይዛይ ብሶዳ፥ ዝን ፋ ሸምፖ ታ ግሾስ ኣ እንግዛይ አሾዳ።<note caller="-" style="x"><char style="xo" closed="false">10:39 </char><char style="xt" closed="false"><ref loc="MAT 16:25">ማቶ. 16:25</ref>፤ <ref loc="MRK 8:35">ማር. 8:35</ref>፤ <ref loc="LUK 9:24">ሉቃ. 9:24</ref>፤ <ref loc="LUK 17:33">17:33</ref>፤ <ref loc="JHN 12:25">ዋን. 12:25</ref></char></note><verse eid="MAT 10:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40"/>«ይንታን ሞክዛይ ታና ሞክዛ፥ ታና ሞክዛይ ማ ታና ኪቴዝ ታ ኣዳ ሞክዛ።<note caller="-" style="x"><char style="xo" closed="false">10:40 </char><char style="xt" closed="false"><ref loc="LUK 10:16">ሉቃ. 10:16</ref>፤ <ref loc="JHN 13:20">ዋን. 13:20</ref>፤ <ref loc="MRK 9:37">ማር. 9:37</ref>፤ <ref loc="LUK 9:48">ሉቃ. 9:48</ref></char></note> <verse eid="MAT 10:40"/><verse number="41" style="v" sid="MAT 10:41"/>ናባና ናበ ሱንር ሞክዛይ፥ ናባይ ጋርክ ዎይትንቶዳ፤ ማ ጽላና ጽሎ ሱንር ሞክዛይ፥ ጽልታይ ጋርክ ዎይትንቶዳ። <verse eid="MAT 10:41"/><verse number="42" style="v" sid="MAT 10:42"/>ታ ይንትስ ቱሮ ኦድዛ፤ Ꮊ ታ ታማርታይፕ ጽቅዛ ፐታይስ ታና ካልዛ ግሾስ ሀራ አቶዝን ሀለ ሃ እርጻ እንግኮ ኤ ዎይታይ በና» ዬጌዛ።<verse eid="MAT 10:42"/></para>
  <chapter eid="MAT 10"/>
  <chapter number="11" style="c" sid="MAT 11"/>
  <para style="s1">ጻማቅዛ ዋንሳ ኪቴዝ አስታ</para>
  <para style="r">(<ref loc="LUK 7:18-35">ሉቃ. 7:18-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1"/>የሱሳ ታጶ ናምኢ ታማርታይስ አዛዛ እንጌዛይፕ ጉየ ኤዛይፕ ደንዲ ታማርሶዳይስኔ ሳባኮዳይስ ጋልላ ካታምታይኮ ቅቴዛ።<verse eid="MAT 11:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2"/>ዋንሳ አች ካራ የዛር ክርስቶሳ ኦዝ ባዝታ ስኢ፥ ፋ ታማርታይፕ ናምእታ ኤዝኮ ኪቲ፥ <verse eid="MAT 11:2"/><verse number="3" style="v" sid="MAT 11:3"/>«የኦዳ ጊንትንቴዛይ ነናኔ? ኑ ሀራ ናጎ?» ዬጊ ኦይጬዛ።<verse eid="MAT 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4"/>የሱሳ ኡንትኮ ማሂ፥ «Ꮊንጊ ይ ስእዝባዝኔ ይ በኤዝ ባዝ ዋንሳስ ኦዶይታ። <verse eid="MAT 11:4"/><verse number="5" style="v" sid="MAT 11:5"/>ቶእታይ በአዳ፥ ሾልዝታይ የዳ፥ ቦርቆንቶር ሀርግንቴዝ አስታይ ጌዦዳ፥ ቱልታይ ስኦዳ፥ Ꮊይቄዝታይ Ꮊይቆፕ ደንዶዳ፤ ማንቅታይስ ዎንግላይ ሳባክንቶዳ።<note caller="-" style="x"><char style="xo" closed="false">11:5 </char><char style="xt" closed="false"><ref loc="ISA 35:5">ኢሳ. 35:5</ref></char></note> <verse eid="MAT 11:5"/><verse number="6" style="v" sid="MAT 11:6"/>ታል ብንተካዛይ አንጅንቴዛያ» ዬጌዛ።<verse eid="MAT 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7"/>ዋንሳ ታማርታይ ጉየ ማቂ ቅትን፥ የሱሳ ዎያይስ ዋንሳ ባዝ ኦድታር፥ «Ꮊ ሊዦ ጋይድ አብ በአዳይስ ከዜኔ? ጫርኮ ኤንእስዛ ማቃ በአዳይስ የኤነኔ? <verse eid="MAT 11:7"/><verse number="8" style="v" sid="MAT 11:8"/>የዝን፥ አብ በአዳይስ ከዜኔ? ሎኦ አፍላ ማኤዝ አስ በአዳይሶኔ? ሎኦ አፍላ ማኤዝታይ ካትታይ ኬ የዛ። <verse eid="MAT 11:8"/><verse number="9" style="v" sid="MAT 11:9"/>የዝን፥ አብ በአዳይስ ከዜኔ? ናበ በአዳይሶኔ? ዬዛኮ፥ ይ ናበፐካ ኣዛና ብእዛ።<verse eid="MAT 11:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 11:10"/>«ነ ኦጋ ነ ቲናይር ጊግስዛ</para>
  <para style="q2" vid="MAT 11:10">ኪትንቴዛና ኔፕ ቲና ኪቶዳ»</para>
  <para style="m" vid="MAT 11:10">ዬግንቲ ጻፍንቴዛይ ኤሲ።<note caller="-" style="x"><char style="xo" closed="false">11:10 </char><char style="xt" closed="false"><ref loc="MAL 3:1">ሚል. 3:1</ref></char></note><verse eid="MAT 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 11:11"/>ታ ይንትስ ቱሮ ኦድዛ፤ ማቻፕ የልንቴዝታይ ጋንጨፕ ጻማቅዛ ዋንሳፕ ኣዛይ ኦንካ ባያ፤ ሳሎ ካተት ኡባይፕ ጽቅዛይ፥ ኤዝፕ ኣዳ፥ <verse eid="MAT 11:11"/><verse number="12" style="v" sid="MAT 11:12"/>ጻማቅዛ ዋንሳ ዎደፕ አይኪ Ꮊይኖ ሄሎዳይስ ሳሎ ካተትይ ጋመ ኡርቅንትዛ፥ ሚንጊ ቡትንቴዝታይ የ አቃ ገሎዳ።<note caller="-" style="x"><char style="xo" closed="false">11:12-13 </char><char style="xt" closed="false"><ref loc="LUK 16:16">ሉቃ. 16:16</ref></char></note> <verse eid="MAT 11:12"/><verse number="13" style="v" sid="MAT 11:13"/>ናብታይ ኡቢታይኔ ሙሰ ህጋይ ዋንሳ ዎደ ሄሎዳይስ ሀኖድ ባዝ ትንቢተ ኦዴዛ። <verse eid="MAT 11:13"/><verse number="14" style="v" sid="MAT 11:14"/>ይኬ፥ ይ ኡ ኪታ አማኖድ ማቅኮ፥ የኦድ ግንትንቴዝ ኤላሳ፥ የይ ኤ ዋንሳ።<note caller="-" style="x"><char style="xo" closed="false">11:14 </char><char style="xt" closed="false"><ref loc="MAL 4:5">ሚል. 4:5</ref>፤ <ref loc="MAT 17:10">ማቶ. 17:10</ref></char></note> <verse eid="MAT 11:14"/><verse number="15" style="v" sid="MAT 11:15"/>ይኬ፥ ስእዝ ሀየር የዛይ ስኦ።<verse eid="MAT 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16"/>«ይኬ፥ Ꮊ ዎደ የለት አባራ ኣዝሶ? ጋበ ጋንጨ በቲ ዎል ጼጊ፥<verse eid="MAT 11:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17"/>« ‹ኑ ይንትስ እምፕልተ ፑግን፤</para>
  <para style="q2" vid="MAT 11:17">ይ የጾያ።</para>
  <para style="q1" vid="MAT 11:17">ኑ ሳቢ ዘላልን፤</para>
  <para style="q2" vid="MAT 11:17">ይ ዬኮያ›</para>
  <para style="m" vid="MAT 11:17">ዬግዝ ናእታ ኣዝዛ። <verse eid="MAT 11:17"/><verse number="18" style="v" sid="MAT 11:18"/>ጻማቅዛ ዋንሳ ሜካዛራኔ ኡዠካዛር ይእን፥ ‹ቱና አያናር የዛ› ይ ዬጌዛ። <verse eid="MAT 11:18"/><verse number="19" style="v" sid="MAT 11:19"/>አስ ናአይ ሚታራኔ ኡዥታር ይእን፥ ‹ዥምባራኔ ኡሺ ዣረ፥ ቃራጸ ጋችስዝታይኔ ናጋራንችታይ ዳቦ› ዬጌዛ። ይኬ፥ ኤጨት ቱማትይ ኤ ኦሳይር በንትዛ» ዬጌዛ።<verse eid="MAT 11:19"/></para>
  <para style="s1">አማናም እጼዝ ካታምቶ</para>
  <para style="r">(<ref loc="LUK 10:13-15">ሉቃ. 10:13-15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20"/>የይፕ ጉየ፥ የሱሳ ጋመ ማላትታ ኦዝ ካታምታይድ የዝ አሳይ ፋ ናጋራፕ ማቂ ማሮት ገላም እጼዝ ግሾስ ኡንታን፥ <verse eid="MAT 11:20"/><verse number="21" style="v" sid="MAT 11:21"/>«አየ ኮራዝኔ ካታማስ፥ አየ ቤተሳይዳ ካታማስ፥ አብስ ጊኮ፥ ይ ጋንጨ ኦንቴዝ ማላታይ ጽሮሳኔ ስዶና ኦንቴዝ ማቄዛኮ፥ ኡ ብኒ ቡዶ ትዥንቲ፥ ካዮ አፍላ ማኢ ፋ ናጋራይፕ ማቂ አቶዳ።<note caller="-" style="x"><char style="xo" closed="false">11:21 </char><char style="xt" closed="false"><ref loc="ISA 23:1-18">ኢሳ. 23:1-18</ref>፤ <ref loc="EZK 26:1-28:26">ኢዝቀ. 26:1—28:26</ref>፤ <ref loc="JOL 3:4-8">ኢዩ. 3:4-8</ref>፤ <ref loc="AMO 1:9-10">አሞ. 1:9-10</ref>፤ <ref loc="ZEC 9:2-4">ዛክ. 9:2-4</ref></char></note> <verse eid="MAT 11:21"/><verse number="22" style="v" sid="MAT 11:22"/>ዝን ታ ይንትስ ኦድዛ፤ ፕርዳ ጋላስ ይንታፕ ኣ ጽሮሳስኔ ስዶናስ ፕርዳይ ካዉዦዳ። <verse eid="MAT 11:22"/><verse number="23" style="v" sid="MAT 11:23"/>ማ Ꮊኔ ቅፍርናሆማ፥ ነ ፑደ ሳሎ ከዞዳይስ ኮይኔ? ሀናሚ! ኔኒ ስኦለ ዎዳ። አብስ ጊኮ፥ ነ ጋንጨ ኦንቴዝ ማላትታይ ሶዶማ ኦስንቴዛኮ ሶዶመ Ꮊይኖ ሄሎዳይስ የሳዳዝን።<note caller="-" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="ISA 14:13">ኢሳ. 14:13</ref></char></note> <verse eid="MAT 11:23"/><verse number="24" style="v" sid="MAT 11:24"/>ዝን ታ ኔስ ኦድዛ፤ ፕርዳ ጋላስ ኔፕ ኣ ሶዶማስ ፕርዳይ ካዉዦዳ» ዬጊ ካጬዛ።<note caller="-" style="x"><char style="xo" closed="false">11:24 </char><char style="xt" closed="false"><ref loc="MAT 10:15">ማቶ. 10:15</ref>፤ <ref loc="LUK 10:12">ሉቃ. 10:12</ref></char></note><verse eid="MAT 11:24"/></para>
  <para style="s1">ክርስቶሳር የዝ ሸምፖ</para>
  <para style="r">(<ref loc="LUK 10:21-22">ሉቃ. 10:21-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25"/>የ ዎደ የሱሳ፥ «አዳዮ፥ ሳሎኔ ሳአ ጎዳዮ፥ ኔኒ Ꮊያ ኤራንችታይፐኔ ኤጭታይፕ ቆሲ ዱደ ናእታይስ ቆንጭሴዝ ግሾስ ነና ታ ጋላትዛ። <verse eid="MAT 11:25"/><verse number="26" style="v" sid="MAT 11:26"/>ኤ፥ ታ አዳዮ፥ Ꮊይ ነ ሎኦ ሸናይ ጋርክ ሀኔዛ።<verse eid="MAT 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27"/>«ኡባይ ታስ ታ አዳይፕ እንግንቴዛ። አዳይፕ ሀራ ናአ ኤርዛይ ባያ፥ ናአይፐኔ ኤ ኡንትስ ቆንጭሶዳይስ ኮይዝታይፕ ሀራ ኣዳ ኤሮዳይስ ዳንዳእዛይ ባያ።<note caller="-" style="x"><char style="xo" closed="false">11:27 </char><char style="xt" closed="false"><ref loc="JHN 3:35">ዋን. 3:35</ref>፤ <ref loc="JHN 1:18">ዋን. 1:18</ref>፤ <ref loc="JHN 10:15">10:15</ref></char></note><verse eid="MAT 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28"/>«ይንታኖ፥ ዳቡሬዝታዮ፥ ቶፎ ዴጼዝ ኡቢታዮ ታኮ Ꮊና የኦይታ፤ ታ ይንታን ሸምፕሶዳ። <verse eid="MAT 11:28"/><verse number="29" style="v" sid="MAT 11:29"/>ታኒ ታ ዎዝናር ኬሃኔ ሃዮ ማቄዝ ግሾስ ታ ቃምባራይድ ገሎይታ፥ ታፕ ታማሮይታ፤ ይንቲ፥ ይ ሸምፖስ ሸምፖ ደማዳ።<note caller="-" style="x"><char style="xo" closed="false">11:29 </char><char style="xt" closed="false"><ref loc="JER 6:16">ኤርም. 6:16</ref></char></note> <verse eid="MAT 11:29"/><verse number="30" style="v" sid="MAT 11:30"/>ታ ቃምባራይ ሊቃማ፥ ማ ታ ቶፋይካ ሻዉኮ» ዬጌዛ።<verse eid="MAT 11:30"/></para>
  <chapter eid="MAT 11"/>
  <chapter number="12" style="c" sid="MAT 12"/>
  <para style="s1">ማላ ቦንቾ ባጋ</para>
  <para style="r">(<ref loc="MRK 2:23-28">ማር. 2:23-28</ref>፤ <ref loc="LUK 6:1-5">ሉቃ. 6:1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1"/>የይፕ ጉየ፥ ማላ ጋላስ፥ የሱሳ ጋደ ጋንጨር ኣዛ። የሱሳ ታማርታይ ናይንቴዝ ግሾስ ባንጋ ትዣ ምርኪ ሙስ አይኬዛ።<note caller="-" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="DEU 23:25">ናምእ. 23:25</ref></char></note> <verse eid="MAT 12:1"/><verse number="2" style="v" sid="MAT 12:2"/>ዝን ፈርሳውታይ የያ ብኢ የሱሳኮ፥ «Ꮊያ ቦኦባ፥ ነ ታማርታይ ማላ ጋላስ ኦዳይስ ቤዞዋ ባዝ ኦዛ» ዬጌዛ።<verse eid="MAT 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3"/>የሱሳ ኡንትኮ ማሂ፥ «ዳውተ ናይንቴዝ ዎደ ኤዛር የዝታይራ አብ ኦዛኮ ይ ናባበካሳ?<note caller="-" style="x"><char style="xo" closed="false">12:3-4 </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">1ሳም. 21:1-6</ref></char></note> <verse eid="MAT 12:3"/><verse number="4" style="v" sid="MAT 12:4"/>ዳውተ ጾስ ኬ ገሊ ቄስታይ ኣዳፕ አትን ኤዝኔ ኤዛር የዝታይስ ቤዞዋ ያርሽንቴዝ ዳቦ ሜዛ።<note caller="-" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="LEV 24:9">ለዊ. 24:9</ref></char></note> <verse eid="MAT 12:4"/><verse number="5" style="v" sid="MAT 12:5"/>ካህንታይ ማላ ዎጋ ሻሪ ጾሳ ኬ ማላ ጋላስ ኦሶ ኦኮ ኡንትስ ናጋራ ማቆዛና ሙሰ ህጋይፕ ይ ናባበካሳ?<note caller="-" style="x"><char style="xo" closed="false">12:5 </char><char style="xt" closed="false"><ref loc="NUM 28:9-10">ታይ. 28:9-10</ref></char></note> <verse eid="MAT 12:5"/><verse number="6" style="v" sid="MAT 12:6"/>ዝን ስኦይታ! ጾስ ኬፕ ኣዛይ Ꮊይዳ የዛ። <verse eid="MAT 12:6"/><verse number="7" style="v" sid="MAT 12:7"/>‹ታኒ ይ ያርሻ ባዝን ይ ሀራ አስ ማሮድ ጋርክ ኮይዛ› ግዝ ቃላይ ዋጉስዛኮ ይ ኤሬዛኮ ጌሽ አሳል አፋ ፕርዳሚ።<note caller="-" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="MAT 9:13">ማቶ. 9:13</ref>፤ <ref loc="HOS 6:6">ሆሳ. 6:6</ref></char></note> <verse eid="MAT 12:7"/><verse number="8" style="v" sid="MAT 12:8"/>አስ ናአይ ማላስ ጎዳ» ዬጌዛ።<verse eid="MAT 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9"/>የሱሳ የይፕ Ꮊንጊ አይሁድታይ ዎሳ ኬ ገሌዛ። <verse eid="MAT 12:9"/><verse number="10" style="v" sid="MAT 12:10"/>ኤዛይድ ኩሸ ስሌዝ ፐቲ አይ የዛ። የሱሳና ሞቶዳይስ ሳንከ ኮይዝ አሳይ፥ «ማላ ጋላስ አስ ፓዳይስ ቤዝነኔ ቤዞሳ?» ዬጊ ኦይጬዛ።<verse eid="MAT 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11"/>ኤ ኡንትኮ፥ «ይ ጋንጨፕ ፐታይስ ዱሪ ማላ ጋላስ ኦላ ዎኮ፥ ጎቺ ከሶዛይ ኦኖ?<note caller="-" style="x"><char style="xo" closed="false">12:11 </char><char style="xt" closed="false"><ref loc="LUK 14:5">ሉቃ. 14:5</ref></char></note> <verse eid="MAT 12:11"/><verse number="12" style="v" sid="MAT 12:12"/>የዝን አሲ ዱራፕ ዋይዚ ሎእ ኣሳ? የይ ግሾስ፥ ማላ ጋላስ ሎኦ ባዝ ኦዳይስ ቤዝዛ» ዬጌዛ።<verse eid="MAT 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 12:13"/>የይፕ ጉየ፥ የሱሳ አይኮ፥ «ነ ኩሻ ፕድ ኡዶባ» ዬግን፥ አይካ ፕድ ኡዴዛ። ኤ ኩሻይ ፓጺ Ꮊንኮ ኩሻይ ጋርክ ሀኔዛ። <verse eid="MAT 12:13"/><verse number="14" style="v" sid="MAT 12:14"/>ዝን ፈርሳውታይ የይፕ ባለ ከዚ፥ የሱሳ ዋይዚ ዎዳዛኮ ዎላ ቶቤዛ።<verse eid="MAT 12:14"/></para>
  <para style="s1">ጾሳይ ዶሬዝ አይላ</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15"/>የሱሳ ኡ ቆፋ ኤሪ የ አቃ አሺ ሀራ አቆ ቅቴዛ። ጋመ አሲ ኤዛ ካሊ Ꮊንጌዛ፥ ሀርግንቴዝታ ኡባ ኤ ፓዛ። <verse eid="MAT 12:15"/><verse number="16" style="v" sid="MAT 12:16"/>የሱሳ፥ «ታ ባጋ ኦስካ ኦድፓተ» ዬጊ ሚን ኦዴዛ። <verse eid="MAT 12:16"/><verse number="17" style="v" sid="MAT 12:17"/>የይካ ናበ ኢሳያሳ፥<verse eid="MAT 12:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18"/>«ይኬ ታ ማራጼዝ አይላይ፥</para>
  <para style="q2" vid="MAT 12:18">ታ ዶስዛይ፥ ታና ኡፋይስዛይ፥</para>
  <para style="q2" vid="MAT 12:18">ታኒ ታ አያና፥ ኤዛል አፋ ሸምፕሶዳ፤<note caller="-" style="x"><char style="xo" closed="false">12:18-21 </char><char style="xt" closed="false"><ref loc="ISA 42:1-4">ኢሳ. 42:1-4</ref></char></note></para>
  <para style="q2" vid="MAT 12:18">ኤ፥ አይሁደ ባ ዎያስ ሉለ ፕርደባዝ አዋጆዳ።<verse eid="MAT 12:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19"/>ኤ ፓላሞያ ዎይ ካጮያ፤</para>
  <para style="q2" vid="MAT 12:19">ፋ ቃላካ ደንባል ጨር ስሶያ።<verse eid="MAT 12:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20"/>ሉለ ፕርዳር ጋሞድ ሄሎዳይስ፥</para>
  <para style="q2" vid="MAT 12:20">ሎሜዝ ማቃ መንያ፥</para>
  <para style="q2" vid="MAT 12:20">ጩይዝ ሙቃዳ ቶእሶያ።<verse eid="MAT 12:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="MAT 12:21"/>አይሁደ ባ ዎያ ኡቢታይ ኤል ኡፋይቶዳ»</para>
  <para style="m" vid="MAT 12:21">ዬጊ ኦድንቴዛይ ፖልንቶዳይ ጋርከ።<verse eid="MAT 12:21"/></para>
  <para style="s1">የሱሳራ ብኤልዘቡላራ</para>
  <para style="r">(<ref loc="MRK 3:20-30">ማር. 3:20-30</ref>፤ <ref loc="LUK 11:14-23">ሉቃ. 11:14-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22"/>የይፕ ጉየ፥ ቱና አያና አይኬዝ ቶአኔ ሙመ አስ የዛና ኤዝኮ ከኤዛ። የሱሳ አ ፓን፥ አይ በኤዛኔ ኦድንቴዛ። <verse eid="MAT 12:22"/><verse number="23" style="v" sid="MAT 12:23"/>ዎያ ኡባይ ማላባዝ ግ፥ «Ꮊይ ዳዉተ ናአ ማቃደሻ?» ዬጌዛ።<verse eid="MAT 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24"/>ዝን ፈርሳውታይ የያ ስኢ፥ «Ꮊ አይ ቱና አያንታ ከስዛይ ቱና አያንታይ ሀላቃ ብኤልዘቡላ ዎልቃራ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">12:24 </char><char style="xt" closed="false"><ref loc="MAT 9:34">ማቶ. 9:34</ref>፤ <ref loc="MAT 10:25">10:25</ref></char></note><verse eid="MAT 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25"/>የሱሳ ኡ ቆፋ ኤሪ፥ «ፐቲ ካተት ሻክንቲ ዎላል ኤቅንትዛ ማቅኮ የ ካተትይ ዎዳ፤ ማ ዎል ጋንጨ ሻኮት መዝ ካታማ ዎይ ኬ ሚንጊ ኤቆዳይስ ዳንዳኦያ። <verse eid="MAT 12:25"/><verse number="26" style="v" sid="MAT 12:26"/>ጻላሄ ጻለሄ ከስዛ ባዝ ማቅኮ ፋ ጋንጨ ሻግንቴዝ ጉሲ። የይ ጋርከ ሀንዛ ባዝ ማቅኮ ኤ ካተትይ ዋይዚ ሚንጊ ኤቆዳይስ ዳንዳኤ? <verse eid="MAT 12:26"/><verse number="27" style="v" sid="MAT 12:27"/>ታኒ ቱና አያና ከስዛይ ብኤልዘቡላ ዎልቃር ማቅኮ ይንታን ካልዛ አሳይ ኦ ዎልቃር ከሶዴ? የይ ግሾስ፥ ይንታን ካልዛ አሳይ ይንታን ፕርዶዳ። <verse eid="MAT 12:27"/><verse number="28" style="v" sid="MAT 12:28"/>ዝን ታኒ ቱና አያንታ ከስዛይ ጾስ አያናር ማቅኮ፥ ጾስ ካተትይ ይንትኮ የኤዛ።<verse eid="MAT 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29"/>«ዎይ ፐቲ አስ ዎልቃማ አስ ካራ ገሊ ኤ ሻላና ቦንቆዳይስ ኮይኮ ቲናቲ የ አ አጨካ አትኮ ዋይዚ ቦንቆዳይስ ዳንዳኤ? አጬዛይፕ ጉየ ኤ ሻላና ቦንቆዳይስ ዳንዳእዛ።<verse eid="MAT 12:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30"/>«ታር ባዛይ ኦንካ ታና እጽዛ፤ ማ ታር ዎላ ሺሾዋ ኡባይ ላልዛ።<note caller="-" style="x"><char style="xo" closed="false">12:30 </char><char style="xt" closed="false"><ref loc="MRK 9:40">ማር. 9:40</ref></char></note> <verse eid="MAT 12:30"/><verse number="31" style="v" sid="MAT 12:31"/>የይ ግሾስ፥ ስኦይታ፤ አሳይ ኦዛ አባ ናጋራካ ጫሺ ኡባይ አቶ ግንትንቶዳ፥ ዝን ጌሻ አያና ጫዤዝ ኦስካ ኤ ናጋራይ አቶ ጊንትንታሚ።<note caller="-" style="x"><char style="xo" closed="false">12:31-32 </char><char style="xt" closed="false"><ref loc="LUK 12:10">ሉቃ. 12:10</ref></char></note> <verse eid="MAT 12:31"/><verse number="32" style="v" sid="MAT 12:32"/>ኦንካ አስ ናአል አፋ ኢታ ባዝ ኦድንትኮ ኤስ አቶ ግንትንቶዳ፥ ዝን ጌሻ አያናል አፋ ኢታ ባዝ ኦድንትዛ ኦስካ Ꮊ ሳአል ማቅን የኦድ አላማይላካ ኤ ናጋራይ አቶ ጊንትንታሚ።<note caller="-" style="x"><char style="xo" closed="false">12:32 </char><char style="xt" closed="false"><ref loc="LUK 12:10">ሉቃ. 12:10</ref></char></note><verse eid="MAT 12:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33"/>«ሎኦ ም ሎኦ ኣፈ ኣፍዛ፤ ማ ኢታ ም ኢታ ኣፍዛ። ይኬ፥ ም ኤርንትዛይ ፋ ኣፋይራ። <verse eid="MAT 12:33"/><verse number="34" style="v" sid="MAT 12:34"/>ይንታኖ፥ ሾሽ ናኡን፥ ይ ኢታ ማቅታር ዋይዚ ሎኦ ባዝ ኦድንቶዳይስ ዳንዳእኔ? አሲ ፋ ዎዛና ጋንጨ ኩሚ ፑጬዝ ባዛፕ ዶናር ኦድንትዛ።<note caller="-" style="x"><char style="xo" closed="false">12:34 </char><char style="xt" closed="false"><ref loc="MAT 3:7">ማቶ. 3:7</ref>፤ <ref loc="MAT 23:33">23:33</ref>፤ <ref loc="LUK 3:7">ሉቃ. 3:7</ref>፤ <ref loc="MAT 15:18">ማቶ. 15:18</ref>፤ <ref loc="LUK 6:45">ሉቃ. 6:45</ref></char></note> <verse eid="MAT 12:34"/><verse number="35" style="v" sid="MAT 12:35"/>ሎኦ አሲ ፋ ዎዝና ጋንጨ ጋዴዝ ሎኦ ባዛፕ፥ ሎኦ ባዝ ከስዛ፤ ኢታ አሲ ፋ ዎዝና ጋንጨ ጋዴዝ ኢታ ባዛፕ፥ ኢታ ባዝ ከስዛ። <verse eid="MAT 12:35"/><verse number="36" style="v" sid="MAT 12:36"/>ዝን ስኦይታ፥ አሲ ኦድንትዛ ጨረ ኦዳ ኡባይስካ ፕርዳ ጋላስ ማልሰ እማዳ። <verse eid="MAT 12:36"/><verse number="37" style="v" sid="MAT 12:37"/>አብስ ጊኮ፥ ነ ኦድንትዛ ነቃላይር ጽሎዳ፤ ነ ኦድንትዛ ነ ቃላይ ኔል አፋ ፕርዶዳ» ዬጌዛ።<verse eid="MAT 12:37"/></para>
  <para style="s1">ማላታ በአዳይስ ሺቄዝ ኦይች</para>
  <para style="r">(<ref loc="MRK 8:11-12">ማር. 8:11-12</ref>፤ <ref loc="LUK 11:29-32">ሉቃ. 11:29-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38"/>የይፕ ጉየ፥ ፐቲ ፐቲ ፈርሳውታይኔ ህገ አስታማርታይ የሱሳኮ፥ «አስታማራዮ፥ ኔኒ ማላታ ኦ ኑና ቤዞዬ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">12:38 </char><char style="xt" closed="false"><ref loc="MAT 16:1">ማቶ. 16:1</ref>፤ <ref loc="MRK 8:11">ማር. 8:11</ref>፤ <ref loc="LUK 11:16">ሉቃ. 11:16</ref></char></note><verse eid="MAT 12:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39"/>ዝን የሱሳ ማሂ፥ «አማኖዝታይኔ ኢታ የለትታይ ማላታ ኮይዛ። ዝን ናበ ዮናሳ ማላታፕ ሀራ ማላታ ኤስ እንግንቶያ።<note caller="-" style="x"><char style="xo" closed="false">12:39 </char><char style="xt" closed="false"><ref loc="MAT 16:4">ማቶ. 16:4</ref>፤ <ref loc="MRK 8:12">ማር. 8:12</ref></char></note> <verse eid="MAT 12:39"/><verse number="40" style="v" sid="MAT 12:40"/>ዮናሳ ግታ ሞሎ ኡሎ ጋንጨ ሀይ ጋላስኔ ሀይ ቃማ ጋምኤዛይ ጋርክ አስ ናአይ ሀይ ጋላስኔ ሀይ ቃማ ቢታ ጋንጨ ጋምኦዳ።<note caller="-" style="x"><char style="xo" closed="false">12:40 </char><char style="xt" closed="false"><ref loc="JHN 1:17">ዋን. 1:17</ref></char></note> <verse eid="MAT 12:40"/><verse number="41" style="v" sid="MAT 12:41"/>ነነወ አሳይ ፕርደ ጋላስ ደንዲ Ꮊ የለትይል አፋ ፕርዶዳ፤ አብስ ጊኮ፥ ኡ ዮናሳ ስብካታ ስኢ ፋ ናጋራይፕ ማቄዛ። ይኬ፥ ዮናሳፕ ኣዛይ Ꮊይዳ የዛ።<note caller="-" style="x"><char style="xo" closed="false">12:41 </char><char style="xt" closed="false"><ref loc="JHN 3:5">ዋን. 3:5</ref></char></note> <verse eid="MAT 12:41"/><verse number="42" style="v" sid="MAT 12:42"/>ፕርዳ ጋላስ ሱለ ባጋ ካታታ ደንዲ Ꮊ የለትይር ዎላ ፕርዶዳ፤ አብስ ጊኮ፥ እዛ ሶሎሞነ ኤጨት ስኦዳይስ ቢታ ጋጻፕ የኤዛ። ዬዛኮ፥ ሶሎሞነፕ ኣዛይ Ꮊይዳ የዛ።<note caller="-" style="x"><char style="xo" closed="false">12:42 </char><char style="xt" closed="false"><ref loc="1KI 10:1-10">1ካት. 10:1-10</ref>፤ <ref loc="2CH 9:1-12">2ዜና. 9:1-12</ref></char></note><verse eid="MAT 12:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43"/>«ቱና አያናይ አሳፕ ከዜዛይፕ ጉየ ፋስ ሸምፕዛ አቆ ኮዪ ሃ ባ መላ አቆ ዳቡርዛ፥ ዝን ፋ ኮይዝ ሸምፖ ደንጎያ። <verse eid="MAT 12:43"/><verse number="44" style="v" sid="MAT 12:44"/>የይ ግሾስ፥ ‹ታ አሺ ከዜዝ ካራ ማቂ Ꮊማዳ› ዬግዛ። ኤ ማቂ የኦዳር ኬይ ካይሳ ማቅዛኔ ፕትንቲ ጊጊ በቴዛና ደንግዛ። <verse eid="MAT 12:44"/><verse number="45" style="v" sid="MAT 12:45"/>ይኬ፥ ማቂ Ꮊንጊ፥ ፓፕ ኢታ ሀራ ላፑን ኢታ አያንታ ኤኪ ይእዛ፤ ኡንትካ አይ ጋንጨ ገሊ የዝዛ። የ አይስ ቲናሳይፕ ጉዬሳይ ኡሳ ኢትዛ። Ꮊ ኢታ የለትይል የይ ጋርክ ባዝ ሀኖዳ» ዬጌዛ።<verse eid="MAT 12:45"/></para>
  <para style="s1">የሱሳ እንዳትኔ ኤ እሽታ</para>
  <para style="r">(<ref loc="MRK 3:31-35">ማር. 3:31-35</ref>፤ <ref loc="LUK 8:19-21">ሉቃ. 8:19-21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46"/>የሱሳ ዎያይስ ኦዳል አፋ የዝን ኤ እንዳትኔ ኤ እሽታይ ኤር ናሾዳይስ ኮዪ ባለ ኤቄዛ። <verse eid="MAT 12:46"/><verse number="47" style="v" sid="MAT 12:47"/>ፐቲ አሲ ኤዝኮ፥ «ነ እንዳትኔ ነ እሽታይ ኔር ናሾዳይስ ኮዪ ባለ ኤቄዛ» ዬጌዛ።<verse eid="MAT 12:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48"/>የሱሳ ማሂ፥ «ታ እንዳት ኦኖ? ታ እሽታይካ ኦናንታራ?» ዬጌዛ። <verse eid="MAT 12:48"/><verse number="49" style="v" sid="MAT 12:49"/>ፋ ኩሻይር ታማርታ ማልታር፥ «ቦኦይታ፥ ታ እንዳታነ ታ እሽታይ Ꮊይትታ። <verse eid="MAT 12:49"/><verse number="50" style="v" sid="MAT 12:50"/>ሳሎ የዝ ታ አዳይ ሸነ ኦዛ ኡቢታይ ታ እሸ፥ ታ ምሾኔ ታ እንዶ» ዬጌዛ።<verse eid="MAT 12:50"/></para>
  <chapter eid="MAT 12"/>
  <chapter number="13" style="c" sid="MAT 13"/>
  <para style="s1">ዘር ዘርዝ አይ ኣዝሶ</para>
  <para style="r">(<ref loc="MRK 4:1-9">ማር. 4:1-9</ref>፤ <ref loc="LUK 8:4-8">ሉቃ. 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1"/>የ ጋላስ የሱሳ ካራፕ ከዚ አባ ካንታ በቴዛ። <verse eid="MAT 13:1"/><verse number="2" style="v" sid="MAT 13:2"/>ጋመ ዎያ ኤ ላንቀ ሺቅን አሳ አባ ጋጻ አሺ ዎጎሎ ጋንጨ ገሊ በቴዛ።<note caller="-" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="LUK 5:1">ሉቃ. 5:1</ref></char></note> <verse eid="MAT 13:2"/><verse number="3" style="v" sid="MAT 13:3"/>አሳይስ ጋመ ባዝ ኣዝሶር ዬጊ ኦዴዛ፦</para>
  <para style="p" vid="MAT 13:3">«ፐቲ ቢታ ኦዝ አይ ዘር ዘሮዳይስ ከዜዝ። <verse eid="MAT 13:3"/><verse number="4" style="v" sid="MAT 13:4"/>ኤ ዘሮዳር ፐቲ ፐቲ ዘርይ ኦገ ጋጻ ዎዛ፤ ኡንታናካ ካፍታይ ይኢ ማጺ ሜዛ። <verse eid="MAT 13:4"/><verse number="5" style="v" sid="MAT 13:5"/>ፐቲ ፐቲ ዘርታይ ስስልቆ ቢታል አፋ ዎዛ። ጋመ ቢታ ባ ግሾስ ኤልሲ ዶሌዛ። <verse eid="MAT 13:5"/><verse number="6" style="v" sid="MAT 13:6"/>ዝን አዋ ኬዝን ሹሌዛ፤ ጻጶ ባዛይ ግሾስ መሌዛ። <verse eid="MAT 13:6"/><verse number="7" style="v" sid="MAT 13:7"/>ፐቲ ፐቲ ዘርይ አንጉ ጋንጨ ዎዛ፤ አንጉይ ድጪ የ ዶላ ጩሌዛ። <verse eid="MAT 13:7"/><verse number="8" style="v" sid="MAT 13:8"/>Ꮊንክታይ ማ እርኮ ቢታል አፋ ዎዛ፤ ዶሊ ኣፈ ኣፌዛ። ፐታይ ጼት፥ ፐታይ ኡሱፑንታም፥ ፐታይ ማ ሀስታም ኣፌዛ። <verse eid="MAT 13:8"/><verse number="9" style="v" sid="MAT 13:9"/>ስእዝ ሀየር የዝ አይ ስኦ» ዬጌዛ።<verse eid="MAT 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10"/>የሱሳ ታማርታይ ኤዝኮ ሺቂ፥ «አብስ ኔኒ ዎያይስ ኣዝሶር ኦዴ?» ዬጊ ኦይጬዛ።<verse eid="MAT 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11"/>ኤ ማሂ፥ «ይንትስ ሳሎ ካተት ጹራ እንግንቴዛ፥ ዝን ኡንትስ እንግንተካያ። <verse eid="MAT 13:11"/><verse number="12" style="v" sid="MAT 13:12"/>የዛ ኡባይስ ጉዥንቶዳ፥ ኤዝስ ጋንጎዳ፥ ዝን ባዛይፕ ሀራ አቶዝን ኤዝስ የዛናካ ኤክንቶዳ።<note caller="-" style="x"><char style="xo" closed="false">13:12 </char><char style="xt" closed="false"><ref loc="MAT 25:29">ማቶ. 25:29</ref>፤ <ref loc="MRK 4:25">ማር. 4:25</ref>፤ <ref loc="LUK 8:18">ሉቃ. 8:18</ref>፤ <ref loc="LUK 19:26">19:26</ref></char></note> <verse eid="MAT 13:12"/><verse number="13" style="v" sid="MAT 13:13"/>የይ ግሾስ፥ ታኒ ኡንቲ፥ ብእታር ደንጋማይ ጋርክ፥ ስእታር ስአም ጋርክ ዎይ አካካማይ ጋርክ ኡንትስ ኣዝሶር ኦድዛ።<verse eid="MAT 13:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 13:14"/>«ኢሳያሳ ፋ ማጻፋይ ግዶ ኦዴዛይ ኡንታል አፋ ፖልንቴዛ። ኤ ኦድታር፥</para>
  <para style="q1" vid="MAT 13:14">« ‹ይ ስስ ስእዛ፥ ዝን አካኮያ፤</para>
  <para style="q2" vid="MAT 13:14">ይ ብእ ብእዛ፥ ዝን ደንጎያ።<verse eid="MAT 13:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15"/>አብስ ጊኮ፥ Ꮊ አሳይ ዎዝናይ ኦርዴዛ፤</para>
  <para style="q2" vid="MAT 13:15">ፋ ሀያ ኤርታር ቱልሴዛ፥</para>
  <para style="q2" vid="MAT 13:15">ፋ ኣፋ ጎዜዛ።</para>
  <para style="q1" vid="MAT 13:15">የይ ባዛኮ ኡ ፋ ኣፋትር ብኢ፥</para>
  <para style="q2" vid="MAT 13:15">ፋ ሀየር ስኢ፥</para>
  <para style="q2" vid="MAT 13:15">ፋ ዎዝናር አካኪ፥</para>
  <para style="q2" vid="MAT 13:15">ታኮ ማቆዳ፥</para>
  <para style="q2" vid="MAT 13:15">ታካ ኡንታን ፓዳዝን› ዬጌዛ።<verse eid="MAT 13:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16"/>«ዝን ይ ኣፋይ ብእዛ ግሾ ይ ሀያይ ስእዝ ግሾስ ይ አንጅንቴዝታ።<note caller="-" style="x"><char style="xo" closed="false">13:16-17 </char><char style="xt" closed="false"><ref loc="LUK 10:23-24">ሉቃ. 10:23-24</ref></char></note> <verse eid="MAT 13:16"/><verse number="17" style="v" sid="MAT 13:17"/>ታ ይንትስ ቱሮ ኦድዛ፤ ጋመ ናብታይኔ ጌሽ አስታይ ይ በኤዛና በአዳይስነ ይ ስእዛና ስኦዳይስ አሞቴዛ፥ ዝን ኡንትስ ሀነካያ።<verse eid="MAT 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18"/>«ይኬ፥ Ꮊ ዘር ዘርዝ አይ ኣዝሳ ስኦይታ። <verse eid="MAT 13:18"/><verse number="19" style="v" sid="MAT 13:19"/>ኦገ ጋጻ ዎዝ ዘር ኣዝሳይ Ꮊያ፦ ሳሎ ካተት ቃላ ስኢ አካኮዋ አይ ዎዝናይፕ ጻላሄ ይኢ ኤ ዎዛና ጋንጨ የዝ ዘር ማጺ ሃሴዛ። <verse eid="MAT 13:19"/><verse number="20" style="v" sid="MAT 13:20"/>ስስልቆ ቢታል አፋ ዘርንቴዛይ ቤዝዛይ ቃላ ስኢ ኤልሲ ኡፋይሳር ኤክዝታ። <verse eid="MAT 13:20"/><verse number="21" style="v" sid="MAT 13:21"/>ዝን Ꮊተሳፕ አትን ጻጶ ዳከካያ። ቃላ ግሾ መቶ ዎይ ባይእ ይእዛ ዎደ ኤልሲ ብንትዛ። <verse eid="MAT 13:21"/><verse number="22" style="v" sid="MAT 13:22"/>አንጉ ጋንጨ ዘርንቴዛይ Ꮊያ ቃላ ስኤዛ፥ ዝን Ꮊ አላመ የስስ ህርጋይኔ ዱረትስ ቆፋይ ቃላ ጩልዛ ግሾስ ኣፈ ኣፈካዛር አትዛ። <verse eid="MAT 13:22"/><verse number="23" style="v" sid="MAT 13:23"/>ዝን አራዳ ቢታል ዘርንቴዝ ዘርይ Ꮊያ አካካር ቃላ ስኤዝ አ። ኤ ኣፈ ኣፍዛ፤ ፐታይ ጼት፥ ፐታይ ኡሱፑንታም ፐታይ ማ ሀስታም እንግዛ» ዬጌዛ።<verse eid="MAT 13:23"/></para>
  <para style="s1">ሌሾር ኣዝሶ</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24"/>የሱሳ ኡንትስ ሀራ ኣዝሶ ኦዴዛ፥ «ጾስ ካተትይ ፋ ዎታ ጋንጨ ሎኦ ዘር ዘሬዝ አ ኣዝዛ። <verse eid="MAT 13:24"/><verse number="25" style="v" sid="MAT 13:25"/>ዝን አስ ኡባይ ገንትን ኤ ሞርካይ ይኢ ግስተ ጋንጨ ሌሾ ዘሪ ቅቴዛ። <verse eid="MAT 13:25"/><verse number="26" style="v" sid="MAT 13:26"/>ግስታይ ድጪ ካእዝ ዎደ ሌሾካ ኤ ጋንጨ በንቴዛ።<verse eid="MAT 13:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 13:27"/>«ጋደ ጎዳይ አይልታይ ጎዳይኮ Ꮊንጊ፥ ‹ጎዳዮ፥ ነ ዎታይድ ነ ሎኦ ዘር ዘረካሳ? የዝን፥ ሌሾ አናፕ የኤኔ?› ዬጌዛ።<verse eid="MAT 13:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28"/>«ኤ ኡንትኮ፥ ‹የያ ሞርከ ኦዛ› ዬጌዛ።</para>
  <para style="p" vid="MAT 13:28">«አይልታይ ጎዳይኮ፥ ‹ኑ Ꮊንጊ ሌሻ ሾዶድ ጋርክ ነ ኮይኔ?› ዬጌዛ።<verse eid="MAT 13:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29"/>«ዝን ኤ፥ ‹አቶ ቦችፓተ፤ ይ ሌሻ ሾድዝ ጎዳር ግስተካ ሾድንቶዳ። <verse eid="MAT 13:29"/><verse number="30" style="v" sid="MAT 13:30"/>ቦችፓተ፤ ማጾ ዎደ ሄሎዳይስ ዎላ ድጮ። የ ዎደ ማጽዛ አስታይ ሌሻ ቲናቲ ማጺ ታማ ጋንጨ ጹጎዳይስ ምርቀር ምርቀር ምርቆይታ። ዝን ግስታ ሺሺ ታ ሻላይድ ኦሎይታ› ዬጎዳ» ዬጌዛ።<verse eid="MAT 13:30"/></para>
  <para style="s1">ሳናፍጨ ኣፈ ኣዝሶ</para>
  <para style="r">(<ref loc="MRK 4:30-32">ማር. 4:30-32</ref>፤ <ref loc="LUK 13:18-19">ሉቃ. 13:18-19</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31"/>ማ ሀራ ኣዝሶ ዬጊ ኦዴዛ፤ «ሳሎ ካተትይ ፐቲ አሲ ፋ ዎታ ጋንጨ ባኬዝ ሳናፍጨ ኣፈ ኣዝዛ። <verse eid="MAT 13:31"/><verse number="32" style="v" sid="MAT 13:32"/>የ ምት ኣፋይ ሀራ ም ኣፍታይፕ ጽቃ፥ ዝን ዶሊ ድጪ ሀራ ም ኡባይፕ ኣ ዳሚ ድጭዛ። እ ሻቅታይል አፋ ካፍታይ ኬጺ በቶድ ሄሎዳይስ ዳማ ም ማቅዛ» ዬጌዛ።<verse eid="MAT 13:32"/></para>
  <para style="s1">እርሾ ኣዝሶ</para>
  <para style="r">(<ref loc="LUK 13:20-21">ሉቃ. 13:20-21</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33"/>ማቅካ፥ የሱሳ ሀራ ኣዝሶ ኦዴዛ፤ «ሳሎ ካተትይ ፐቲ ማቺ ሀይ ጎንገ ላ ኤኪ ሙኑቂ፥ ሙኑቃይ ደንዶዳይ ጋርክ ኤዛይድ ዳኬዝ እርሾ ኣዝዛ» ዬጌዛ።<verse eid="MAT 13:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34"/>የሱሳ ዎያይስ የ ኣዝሶ ኡባ ኦዴዛ። ኣዝሶ ባዝን ፐትባዝካ ኦደካያ። <verse eid="MAT 13:34"/><verse number="35" style="v" sid="MAT 13:35"/>ናባይ ፋ ማጻፋይ ጋንጨ፥</para>
  <para style="q1" vid="MAT 13:35">«ታኒ ታ ዶና፥ ኣዝሶር ዶዮዳ፤</para>
  <para style="q2" vid="MAT 13:35">ሳሎኔ ሳአ መንቴዛይፐ፥</para>
  <para style="q2" vid="MAT 13:35">ጌመዛና ታ ኦድዛ»</para>
  <para style="m" vid="MAT 13:35">ዬጊ ኦዴዛይ የይድ ፖልንቴዛ።<note caller="-" style="x"><char style="xo" closed="false">13:35 </char><char style="xt" closed="false"><ref loc="PSA 78:2">ማዝ. 78:2</ref></char></note><verse eid="MAT 13:35"/></para>
  <para style="s1">ሌሾ ኣዝሳይስ ብርሽ</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36"/>የሱሳ ዎይታ አሺ ካራ ገሌዛ። ኤ ታማርታይ ኤዝኮ ሺቂ፥ «ዎታይድ የዝ ሌሻይ ብል ኑስ ኦዶባ» ዬጌዛ።<verse eid="MAT 13:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37"/>ኤ ማሂ፥ «ሎኦ ዘር ዘሬዛይ አስ ናአ፥ <verse eid="MAT 13:37"/><verse number="38" style="v" sid="MAT 13:38"/>ዎታይ Ꮊ አላማ። ሎኦ ዘርይ ሳሎ ካተት ናእታ። ሌሻይ ጻላሄ ናእታ። <verse eid="MAT 13:38"/><verse number="39" style="v" sid="MAT 13:39"/>ሌሾ ዘሬዛይ ሞርከ ጻላሄ፥ ማጾ ዎዳይ ዎደ ዉርስ፥ ማጽዝታይ ኪታንችታ።<verse eid="MAT 13:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 13:40"/>«ሌሻይ ማጽንቲ ታማ ጋንጨ ጹግንትዛይ ጋርክ ዎደ ዉርስላ Ꮊይ ጋርክ ሀኖዳ። <verse eid="MAT 13:40"/><verse number="41" style="v" sid="MAT 13:41"/>አስ ናአይ ፋ ኪታንችታ ኪቶዳ። ኡ ናጋራስ ሳንከ ማቄዝታኔ ኢታ ኦዝ ኡብታ ማጺ ኤ ካተትይፕ ከሶዳ። <verse eid="MAT 13:41"/><verse number="42" style="v" sid="MAT 13:42"/>ማጺ ሺሺ ዬፎኔ አች ጮንቺ የዝ ቶኦዋ ታማ ጋንጨ ኦሎዳ። <verse eid="MAT 13:42"/><verse number="43" style="v" sid="MAT 13:43"/>የ ዎደ ጽልታይ ፋ አዳይ ካተትይድ አዋ ጋርክ ፖኦዳ። ስእዝ ሀየ የዛይ ስኦ!<verse eid="MAT 13:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44"/>«ጾስ ካተትይ ዎታ ጋንጨ ሞግንቴዝ ሚሸ ኣዝዛ። ፐቲ አሲ የ ሚሻ ደንጊ ማሂ ሞጌዛ። ጋመ ኡፋይቲ Ꮊንጊ ፓስ የዛ ባዝ ኡባ ባይዚ የ ጋዳት ዎንጌዛ።<verse eid="MAT 13:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45"/>«የይ ጋርክ፥ ማ ሳሎ ካተትይ እንቆ ግዝ አልኦ ሹችታ ኮይዝ ዛልኤ አስ ኣዝዛ። <verse eid="MAT 13:45"/><verse number="46" style="v" sid="MAT 13:46"/>ጋመ አልኦ እንቆ ደንጊ Ꮊንጊ ፓስ የዛ ባዝ ኡባ ባይዚ ኤ ዎንጌዛ።<verse eid="MAT 13:46"/></para>
  <para style="s1">ሞሎ አይክዝ ግተ ኣዝሶ</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47"/>«ማ ጾስ ካተትይ አባ ጋንጨ ኦልንቴዝ ዱማ ዱማ ሞሎ ኮች አይክዝ ግተ ኣዝዛ። <verse eid="MAT 13:47"/><verse number="48" style="v" sid="MAT 13:48"/>ሞሎ አይክዝ አሳይ ሞሎ ግታይድ ኩምን አባፕ ጋጻ ከሴዛ። ኤዛይድ በቲ ሎኣ ሎኣ ቁሪ ዳቾ ጋንጨ ኦሌዛ፥ ዝን ኢታ ሞልታ አላ ኦሌዛ። <verse eid="MAT 13:48"/><verse number="49" style="v" sid="MAT 13:49"/>ዎደ ዉርስል የይ ጋርክ ሀኖዳ። ኪታንችታይ ይኢ ናጋራ ኦዝታ ጽልታይፕ ቁሮዳ። <verse eid="MAT 13:49"/><verse number="50" style="v" sid="MAT 13:50"/>ዬፎኔ አች ጮንቺ የዛ ቶኦዋ ታማ ጋንጨ ኦሎዳ።<verse eid="MAT 13:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51"/>«Ꮊ ኡቢታይ ይንትስ ገሌኔ?» ዬጊ ኡንታን ኦይጬዛ።</para>
  <para style="p" vid="MAT 13:51">ኡ ማሂ፥ «ኤ» ዬጌዛ።<verse eid="MAT 13:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52"/>የሱሳ፥ «ይኬ፥ ሳሎ ካተት ጹራ ኤኪ ህገ ታማርስዛ ኡቢታይ፥ ፋ ምንጄዝ ሻላይፕ ኦሮኔ ጭማ ከስዛ ሻሎ ጎዳ ኣዝዛ» ዬጌዛ።<verse eid="MAT 13:52"/></para>
  <para style="s1">የሱሳና ናዝረተ ሄሌዝ እጾ</para>
  <para style="r">(<ref loc="MRK 6:1-6">ማር. 6:1-6</ref>፤ <ref loc="LUK 4:16-30">ሉቃ. 4:16-30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53"/>የሱሳ Ꮊ ኣዝሳ ኦዲ ዉርሴዛይፕ ጉየ ኤዛይፕ ደንዲ ቅቴዛ። <verse eid="MAT 13:53"/><verse number="54" style="v" sid="MAT 13:54"/>ፋ የልንቴዝ ቢታ Ꮊንጊ አይሁድታይ ዎሳ ካራ ታማርሶ አይኬዛ። ኡ ማላ ባዝ ግ፥ «Ꮊ አይ Ꮊ ኤጨትኔ Ꮊ ማላታ ኦዛ ዎልቃ አናፕ ኤኬኔ? <verse eid="MAT 13:54"/><verse number="55" style="v" sid="MAT 13:55"/>Ꮊይ አናጻይ ናአ ባሳኔ? ኤ እንዳቲ ሱንይ ማይራሞ ባሳኔ? ኤ እሽታይ ያይቆባ፥ ዮሴፋ፥ ስሞናራኔ ይሁዳ ባሳኔ? <verse eid="MAT 13:55"/><verse number="56" style="v" sid="MAT 13:56"/>ኤ ምሹንካ ኑር የዙንና ባሳኔ? የዝን፥ Ꮊ አይ Ꮊ ኡባ አናፕ ኤኬኔ?» ዬጌዛ። <verse eid="MAT 13:56"/><verse number="57" style="v" sid="MAT 13:57"/>የይ ግሾስ፥ ኤ ግዝ ባዛ ኤካም እጼዛ።<note caller="-" style="x"><char style="xo" closed="false">13:57 </char><char style="xt" closed="false"><ref loc="JHN 4:43">ዋን. 4:43</ref></char></note></para>
  <para style="p" vid="MAT 13:57">ዝን የሱሳ፥ «ናበ ፋ የልንቴዝ ቢታይዳኔ ፋ ካራ አሳይ ካለ ቦንችንቶያ» ዬጌዛ። <verse eid="MAT 13:57"/><verse number="58" style="v" sid="MAT 13:58"/>ኡ አማናም እጼዝ ግሾስ ጋመ ማላታ የ አቃይድ ኦካያ።<verse eid="MAT 13:58"/></para>
  <chapter eid="MAT 13"/>
  <chapter number="14" style="c" sid="MAT 14"/>
  <para style="s1">ጻማቅዛ ዋንሳ Ꮊይቆ</para>
  <para style="r">(<ref loc="MRK 6:14-29">ማር. 6:14-29</ref>፤ <ref loc="LUK 9:7-9">ሉቃ. 9:7-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1"/>የ ዎደ ጋልላ አቅስዝ ሄሮድሳ<note caller="+" style="f"><char style="fr" closed="false">14:1 </char><char style="fqa" closed="false">ሄሮድሳ፦ </char><char style="ft" closed="false">Ꮊይ ካታ ሄሮዶሳ ኣንትጳሳ። ኤ ይሁዳራ ፔራ ክርስቶሳ የልንቶዳይፕ ቲን 4-39 ማላ ሄሎዳይስ ሞዴዛ። ኤ ካት ሄሮዶሳስ ናአ።</char></note> የሱሳ ዋራ ስኤዛ። <verse eid="MAT 14:1"/><verse number="2" style="v" sid="MAT 14:2"/>ፋ አይልታይኮ፥ «Ꮊይ ጻማቅዛ ዋንሳ፤ ኤ Ꮊይቆፕ ደንዴዛ። የይ ግሾስ Ꮊ ኡባ ማላትታ ኤ ኦዛ» ዬጌዛ።<verse eid="MAT 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3"/>ኤ የያ ጌዛይ ሄሮድሳ ፋ እሻ ፍልጶሳ ማቻት ሄሮድያዳ ግሾስ ዋንሳ አች ኬ ገልሴዝ ግሾስ። <verse eid="MAT 14:3"/><verse number="4" style="v" sid="MAT 14:4"/>ዋንሳ ሄሮድሳ፥ «ነ እዞ ኤኮዳይስ ዎጋ ባያ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">14:3-4 </char><char style="xt" closed="false"><ref loc="LUK 3:19-20">ሉቃ. 3:19-20</ref>፤ <ref loc="LEV 18:16">ለዊ. 18:16</ref>፤ <ref loc="LEV 20:21">20:21</ref></char></note> <verse eid="MAT 14:4"/><verse number="5" style="v" sid="MAT 14:5"/>ሄሮድሳ ዋንሳ ዎዳይስ ኮዬዛ፥ ዝን ዎያይ ዋንሳ ናበ ኡዲ ብእዝ ግሾስ ያሽቴዛ።<verse eid="MAT 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6"/>ሄሮድሳ ፋ የልንቴዝ ጋላሳ ቦንችዛ ዎደ ሄሮድያዳ ናአት አስ ቲና የር ዶንጊ ኤዛ ኡፋይሴዛ። <verse eid="MAT 14:6"/><verse number="7" style="v" sid="MAT 14:7"/>የዝን፥ ኤ፥ «እዛ ኮይዝ ባዝ ኡባ ኢስ እማዳ ግ» ጫቄዛ። <verse eid="MAT 14:7"/><verse number="8" style="v" sid="MAT 14:8"/>ናአታ ፋ እንዳት ዞረ ስኢ ሄሮድሳኮ፥ «ጻማቅዛ ዋንሳ ቆይፕ ጋቺ ኦማ ፍልኦ ጋንጨ ጋዲ ታስ እንጎባ» ዬጌዛ። <verse eid="MAT 14:8"/><verse number="9" style="v" sid="MAT 14:9"/>እዛ ዬግን ካታይ ቂራዛ፥ ዝን ፋ ጫቃይ ግሾኔ ፓር የዝ እማታይ ግሾስ ግ እ ኦይቻይ ፖልንቶድ ጋርክ አዛዜዛ። <verse eid="MAT 14:9"/><verse number="10" style="v" sid="MAT 14:10"/>ካታይ አስ ኪቲ ዋንሳ አች ኬ የዝን ኤ ቆ ጋችሴዛ። <verse eid="MAT 14:10"/><verse number="11" style="v" sid="MAT 14:11"/>ኤ ኦማ ፍልኦ ጋንጨ ኣ ክኢ ናአትስ እንጌዛ፤ ናአታካ ኤኪ ፋ እንዳትስ ካንጌዛ። <verse eid="MAT 14:11"/><verse number="12" style="v" sid="MAT 14:12"/>ዋንሳ ታማርታይ ይኢ ኤ አሃ ካንጊ ሞጌዛ። ኤዛይፐ ጉየ ሀኔዝባዝ ኡባ Ꮊንጊ የሱሳስ ኦዴዛ።<verse eid="MAT 14:12"/></para>
  <para style="s1">የሱሳ እችን ሙኩለ አስታ ሙዜዛ</para>
  <para style="r">(<ref loc="MRK 6:30-44">ማር. 6:30-44</ref>፤ <ref loc="LUK 9:10-17">ሉቃ. 9:10-17</ref>፤ <ref loc="JHN 6:1-14">ዋን. 6:1-14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13"/>የሱሳ ሀኔዝባዛና ስኢ ዎጎሎ ጋንጨ ገሊ የ በሳይፐ ፐቲ ጌምዛ አቆ ፋ ኣዳስ Ꮊንጌዛ። አሳይ የያ ስኢ ካታምታይፕ ደንዲ ቶከር ኤዛ ካሌዛ። <verse eid="MAT 14:13"/><verse number="14" style="v" sid="MAT 14:14"/>የሱሳ ዎጎሎፕ ዎ ጋመ አሳ ብኢ ኡንትስ ቃንቴዛ። ኡ ጋንጨ የዝ ሀርግንቴዝ አስታ ፓዛ።<verse eid="MAT 14:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15"/>ሳአይ ኦማታር Ꮊንግን የሱሳ ታማርታይ ኤዝኮ ሺቂ፥ «Ꮊ አቃይ ሊዦ፥ ሳአይካ ቃሜዛ። የይ ግሾስ፥ ሄራ Ꮊንጊ ፓስ ዎንጊ ማድ ጋርክ ዎያ ዳኮባ» ዬጌዛ።<verse eid="MAT 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16"/>ዝን የሱሳ ኡንትኮ፥ «ዎያይ ሜካዛር Ꮊማዳይስ ኮሾያ፤ ኡ ማድባዝ ይ እንጎይታ» ዬጌዛ።<verse eid="MAT 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17"/>ኡ ማሂ፥ «ኑስ Ꮊኔ እችን ሶሎራኔ ናምእ ሞሎፕ ሀራ ባያ» ዬጌዛ።<verse eid="MAT 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18"/>ኤዝካ፥ «አን እዞ Ꮊና ኮኦይታ» ዬጌዛ። <verse eid="MAT 14:18"/><verse number="19" style="v" sid="MAT 14:19"/>ማ ማቅካ፥ ዎያይ ማታል በቶዳይ ጋርክ ኦዴዛ። እችን ሶሎራ ናምእ ሞልታ ኤኪ፥ ሳሎ ብኢ ጋላቲ ማቂ፥ ሶላ ዱ ፋ ታማርታይስ እንጌዛ፤ ኡንቲ ማ ዎያይስ እንጌዛ። <verse eid="MAT 14:19"/><verse number="20" style="v" sid="MAT 14:20"/>ኡባይ ም ምዤዛ። የሱሳ ታማርታይ ማዳር አቴዛና ታጶ ናምኢ ሌማተ ደንዛ። <verse eid="MAT 14:20"/><verse number="21" style="v" sid="MAT 14:21"/>ካ ሜዝ አሳይ ማችኔ ናአ አትን እችን ሙኩለ ማቅዛ።<verse eid="MAT 14:21"/></para>
  <para style="s1">የሱሳ አባል የዛ</para>
  <para style="r">(<ref loc="MRK 6:45-52">ማር. 6:45-52</ref>፤ <ref loc="JHN 6:15-21">ዋን. 6:15-21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22"/>የሱሳ ፋ ታማርታይ ዎጎሎ ጋንጨ ገሊ ፓፕ ቲናቲ አባይፕ ሰኮ ፍን ፒንጎዳይ ጋርክ ኪቲ ፋስ ዎያ ሞይዞዳይስ ጉየ አቴዛ። <verse eid="MAT 14:22"/><verse number="23" style="v" sid="MAT 14:23"/>ዎያ ሞይዚ ማቂ ፋ ኣዳስ ዎሶዳይስ ፐቲ ደረል አፋ ከዜዝ። ሳአ ቃምንካ ኤ ፋ ኣዳስ ኤዛይድ ጋምኤዛ። <verse eid="MAT 14:23"/><verse number="24" style="v" sid="MAT 14:24"/>የ ዎደ ዎጎላይ አባል አፋር Ꮊማዳር ቲና ባጋር ጫርኮ ደንድን ጎታይ ዎጎላና ጭጵቼዛ።<verse eid="MAT 14:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25"/>ዎንትማላ የሱሳ አባል አፋ የታር ፋ ታማርታይኮ የኤዛ። <verse eid="MAT 14:25"/><verse number="26" style="v" sid="MAT 14:26"/>ኤ ታማርታይ፥ ኤ አባል አፋ የታር ኡንትኮ ይእዛና ብኢ ያሽቴዛ። ኡንትካ፥ «Ꮊይ ሜሸ» ግ ያሽቲ ኡኬዛ።<verse eid="MAT 14:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27"/>ዝን የሱሳ ኤልሲ፥ «አኮ ባያ! ያሽትፓተ! Ꮊይ ታና» ዬጌዛ።<verse eid="MAT 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28"/>ጵጽሮሳ ኤዝኮ፥ «ጎዳዮ፥ ነና ማቅኮ፥ ታ ሃል አፋር የ ኔኮ Ꮊንጎድ ጋርክ ታና አዛዞባ» ዬጌዛ።<verse eid="MAT 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29"/>የሱሳ ጵጽሮሳኮ፥ «Ꮊና የኦባ» ዬጌዛ።</para>
  <para style="p" vid="MAT 14:29">ጵጽሮሳ ዎጎሎፕ ዎ ሃይል አፋ የታር የሱሳኮ Ꮊሞ አይኬዛ። <verse eid="MAT 14:29"/><verse number="30" style="v" sid="MAT 14:30"/>ዝን ጫርካይ ወልቃ ብኢ ያሽቴዛ። ሃይ ኤዛ ምቶ አይክን «ጎዳዮ፥ ታና አሾዬ» ዬጊ ኡኬዛ።<verse eid="MAT 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31"/>የሱሳ ኤልሲ ፋ ኩሻ ዳኪ ኤዛ አይኪ፥ «ናት፥ አማኖ ፓጬዛዮ አብስ ስ» ዬጌዛ።<verse eid="MAT 14:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32"/>የሱሳራኔ ጵጽሮሳራ ዎጎሎ ጋንጨ ገልን ጫርካይ ጭጭርኪ ጌዛ። <verse eid="MAT 14:32"/><verse number="33" style="v" sid="MAT 14:33"/>ዎጎሎ ጋንጨ የዝ ኤ ታማርታይ፥ «ኔኒ ቱማካ ጾስ ናአ» ግ ጎይኔዛ።<verse eid="MAT 14:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34"/>ኡ አባ ፒንጊ ገንሳሬጸ ቢታ ሄሌዛ። <verse eid="MAT 14:34"/><verse number="35" style="v" sid="MAT 14:35"/>ያ ቢታይል የዝ አሳይ የሱሳና ኤሪ ፋ ሾሮ ሄራ የዝ ኡባይስ ኪታ ዳኬዛ። አሳይ ሀርግንቴዝ አስታ ኡባ ኤዝኮ ከኤዛ። <verse eid="MAT 14:35"/><verse number="36" style="v" sid="MAT 14:36"/>ሀርግንቴዝ አስታይ ኤ አፍላ ማንቻ ኣዳ ቦቾዳይስ ኤዛ ዎሴዛ። ቦቼዝ ኡቢታይካ ፓጼዛ።<verse eid="MAT 14:36"/></para>
  <chapter eid="MAT 14"/>
  <chapter number="15" style="c" sid="MAT 15"/>
  <para style="s1">አድታይ ዎጋ ባጋ</para>
  <para style="r">(<ref loc="MRK 7:1-13">ማር. 7:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1"/>የይፕ ጉየ፥ ፐቲ ፐቲ ፈርሳውታይኔ ህገ አስታማርታይ የሩሳላመፕ የሱሳኮ ይኢ፥ <verse eid="MAT 15:1"/><verse number="2" style="v" sid="MAT 15:2"/>«ነ ታማርታይ አብስ ኑ አድታይ ዎጋ መን? ኡ ካ ማዳይፕ ቲና ፋ ኩሻ ሜጭንቶያ» ዬጊ ኦይጬዛ።<verse eid="MAT 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3"/>የሱሳ ማሂ፥ «ይንቲ፥ ይ ዎጋ ግሾስ ጾሳ ኪታ ፖልዛና አብስ እጼ? <verse eid="MAT 15:3"/><verse number="4" style="v" sid="MAT 15:4"/>አብስ ጊኮ፥ ጾሳይ፥ ‹ነ አደኔ ነ እንዶ ቦንቾባ። ፋ አደ ዎይ ፋ እንዶ ጫዥዛይ Ꮊይቆ ጌካሳ?› ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">15:4 </char><char style="xt" closed="false"><ref loc="EXO 20:12">ከስ 20:12</ref>፤ <ref loc="DEU 5:16">ናምእ. 5:16</ref>፤ <ref loc="EXO 21:17">ከስ 21:17</ref>፤ <ref loc="LEV 20:9">ለዊ. 20:9</ref></char></note> <verse eid="MAT 15:4"/><verse number="5" style="v" sid="MAT 15:5"/>ዝን ይ፥ ፐቲ አስ ፋ ኣዳ ዎይ ፋ እንዳት ማዶድ ባዝ የዝን፥ ‹Ꮊያ ታ ጾስስ ያርሼዛ ጊኮ፥ <verse eid="MAT 15:5"/><verse number="6" style="v" sid="MAT 15:6"/>ፋ ኣዳ ዎይ ፋ እንዳት ቦንቾዳይስ ቤዞያ› ይ ዬግዛ። ዬዚ ይንቲ፥ ይ ዎጋ ፖሎዳይስ ጾሳ ቃላ መንዛ። <verse eid="MAT 15:6"/><verse number="7" style="v" sid="MAT 15:7"/>ይንትኖ፥ ጩቢታዮ፥ ኢሳያሳ ይ ባዝ ቱሮ ኦዴዛ፥<verse eid="MAT 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8"/>« ‹Ꮊ አሳይ ታና ፋ ዶናር ቦንችዛ፥</para>
  <para style="q2" vid="MAT 15:8">ዝን ኡ ዎዝናይ ታፕ ሃኮ የዛ።<verse eid="MAT 15:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9"/>አሳይ ታና ጨር ጎይንዛ፤</para>
  <para style="q2" vid="MAT 15:9">ኡ አሲ መዝ ዎጋ፥</para>
  <para style="q2" vid="MAT 15:9">ጾሳ ህገ ኣዝሲ ታማርስዛ› ጌዛ» ዬጌዛ።<verse eid="MAT 15:9"/></para>
  <para style="s1">አስ ቱንስዛ ባዝ</para>
  <para style="r">(<ref loc="MRK 7:14-23">ማር. 7:14-23</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10"/>የሱሳ ጋመ አስታ ፋኮ ጼጊ፥ «ስኦይታ! አካኮይታ! <verse eid="MAT 15:10"/><verse number="11" style="v" sid="MAT 15:11"/>አስ ቱንስዛ ባዛይ ዶናር ገልዝ ባዝ ባዝን ዶናፐ ከዝዝ ባዝ» ዬጌዛ።<verse eid="MAT 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12"/>የይፕ ጉየ፥ የሱሳ ታማርታይ ኤዝኮ ይኢ፥ «ፈርሳውታይ ኔኒ ኦዴዛ ስኢ ብንቴዛና ነ ኤሬኔ?» ዬጌዛ።<verse eid="MAT 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13"/>ዝን የሱሳ ኡንትኮ ማሂ፥ «ሳሎ የዝ ታ አዳይ ቱከካ ም ኡባይ ሾድንቶዳ። <verse eid="MAT 15:13"/><verse number="14" style="v" sid="MAT 15:14"/>ኡ ባጋ ህርግፓተ፤ ኡ ቶአ ካልዛይካ ቶእታ። ቶአይ ቶአ ካልኮ፥ ናምእታይካ ጋጋ ቅትዛ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">15:14 </char><char style="xt" closed="false"><ref loc="LUK 6:39">ሉቃ. 6:39</ref></char></note><verse eid="MAT 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15"/>ጵጽሮሳ ማሂ፥ «Ꮊ ኣዝሳይስ ብል ኑስ ኦዶየ» ዬጌዛ።<verse eid="MAT 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16"/>የሱሳ ኡንትኮ፥ «ይንትስካ Ꮊኖ ሄሎዳይስ ገለካሳ? <verse eid="MAT 15:16"/><verse number="17" style="v" sid="MAT 15:17"/>ዶናር ገልዝ ባዝ ኡባይ ኡሎ ገሊ ባለ ከዝዛና ይ ኤሮሳ? <verse eid="MAT 15:17"/><verse number="18" style="v" sid="MAT 15:18"/>ዝን ዶናር ከዝዝ ባዝ ዎዝናፕ ከዝዛ። አስ ቱንስዛ ባዝታይ Ꮊይትታ።<note caller="-" style="x"><char style="xo" closed="false">15:18 </char><char style="xt" closed="false"><ref loc="MAT 12:34">ማቶ. 12:34</ref></char></note> <verse eid="MAT 15:18"/><verse number="19" style="v" sid="MAT 15:19"/>ኡንትካ አስ ዎዝና ጋንጨፕ ከዝዝ ኢታ ቆፋ፥ ዎ፥ ላግተ፥ ላመ፥ ካይዞ፥ ዎርዶ ማርካት፥ አስ ሱን ብሶ፥ ጫሸ። <verse eid="MAT 15:19"/><verse number="20" style="v" sid="MAT 15:20"/>የያ ኣዝዝባዝታይ አስ ቱንስዛፕ አትን ሜጭንተካ ኩሸር ሚዛይ ቱንሶያ» ዬጌዛ።<verse eid="MAT 15:20"/></para>
  <para style="s1">ፐቲ አስቲ አማኖ</para>
  <para style="r">(<ref loc="MRK 7:24-30">ማር. 7:24-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21"/>የይፕ ጉየ፥ የሱሳ ኤዛይፕ ከዚ ጽሮሳኔ ስዶና ካታምታይ የዝ ቢታ Ꮊንጌዛ። <verse eid="MAT 15:21"/><verse number="22" style="v" sid="MAT 15:22"/>ፐቲ ካናኔ ቢታ አስታ የሱሳኮ ይኢ፥ ፋ ቃላ ቂ ኡዲ፥ «ጎዳዮ፥ ዳዉተ ናአዮ፥ ታስ ቃንቶየ፤ ታ ናአቶ ቱና አያና አይኪ ኢታ ዋይዛ» ዬጌዛ።<verse eid="MAT 15:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23"/>ዝን የሱሳ ፐቲ ቃላካ ማሄካዛር ሲኤ አቴዛ። የሱሳ ታማርታይ ኤዝኮ ይኢ፥ «Ꮊ አስታ ኑ ላሳ ካልታር፥ ኡክዛ ግሾስ፥ ነ እዞ ሞይዞዬ» ዬጊ ዎሴዛ።<verse eid="MAT 15:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24"/>የሱሳ ማሂ፥ «ታኒ ዉደፕ ቤዝ ዱር ጋርክ እስሬለ ካራፕ ቤዝ አስታይ ኣዳስ ኪትንቴዛ» ዬጌዛ።<verse eid="MAT 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25"/>ዝን እዛ፥ ኤ ቲና ጹጉኒ፥ «ጎዳዮ፥ ታና ማዶየ?» ዬጌዛ።<verse eid="MAT 15:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26"/>ኤ ማሂ፥ «ናእታይ ካ ኤኪ ካንታይስ ኦሎዳይስ ቤዞያ» ዬጌዛ።<verse eid="MAT 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27"/>እዛካ፥ «ጎዳዮ፥ የይ ቱማ፥ ዝን ሀራ አቶዝን ካንታይ ፋ ጎድታይ ማዳር፥ ጋይታፕ ዎዝ ጉፋ ሚዛ» ዬጌዛ።<verse eid="MAT 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28"/>የሱሳ ማሂ፥ «አስት Ꮊኔ፥ ነ አማናይ ግታ፤ ነ ኮዬዛይ ጋርክ ኔስ ሀኖ» ዬጌዛ። እ ናአታ እዝር ፓጼዛ።<verse eid="MAT 15:28"/></para>
  <para style="s1">የሱሳ ጋመ ሀርግንቴዝታ ፓዛ</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29"/>የሱሳ የይፕ ደንዲ ጋልላ አባ ላንቀ ቅቴዛ። አምባል አፋ ከዚ፥ ኤዛይድ በቴዛ። <verse eid="MAT 15:29"/><verse number="30" style="v" sid="MAT 15:30"/>ጋመ አሳይ ፋር፥ ዎብታ፥ ቶእታ፥ ስሌዝታ፥ ዶና ሙሜዝታኔ፥ ሀራ ጋመ ሀርግንቴዝ አስታ ኤኪ፥ ኤዝኮ ክኢ ኤ ቲናይድ ጋዴዛ። የሱሳ ኡንታን ፓዛ። <verse eid="MAT 15:30"/><verse number="31" style="v" sid="MAT 15:31"/>የይ ግሾስ፥ ሙምታይ ናሾዳር፥ ስሌዝታይ ፓጾዳር፥ ዎብታይ የዳር፥ ቶእታይ በአዳር አሳይ ብኢ Ꮊይ ማላባዝ ግ፥ እስሬለ ጾሳ ጋላቴዛ።<verse eid="MAT 15:31"/></para>
  <para style="s1">የሱሳ ኦይዲ ሙኩለ አሳ ሙዜዛ</para>
  <para style="r">(<ref loc="MRK 8:1-10">ማር. 8:1-10</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32"/>የሱሳ ፋ ታማርታ ፋኮ ጼጊ፥ «Ꮊ ጋመ አሳይ ታር ሀይ ጋላስ ጋምኤዝ ግሾኔ ኡንትስ Ꮊት ሚዝባዝ ባዛይ ግሾስ ታ ኡንትስ ቃንትዛ። ኡ ኦገል ዳቡሪ ፎካም ጋርክ አኮ ሙዘካ ኡንታን ጨር ዳኮዳይስ ታ ኮዮያ» ዬጌዛ።<verse eid="MAT 15:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33"/>ኤ ታማርታይ ማሂ፥ «ኑኒ Ꮊ ሊዣይድ Ꮊይ ጋርክ አሳይስ ግድዛ ካ አናፕ ደማዴ?» ዬጌዛ።<verse eid="MAT 15:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34"/>የሱሳ ኡንትኮ፥ «ይንትስ ኣፑን ሶሎ የኔ?» ዬጊ ኦይጬዛ።</para>
  <para style="p" vid="MAT 15:34">ኡ ማሂ፥ «ላፑን ሶሎኔ ይሸ ሞልታይፕ ጽቃ የዛ» ዬጌዛ።<verse eid="MAT 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35"/>የሱሳ ዎይታ ሳአ በቶይታ ዬጊ አዛዜዛ። <verse eid="MAT 15:35"/><verse number="36" style="v" sid="MAT 15:36"/>የይፕ ጉየ፥ የ ላፑን ሶላይራ ሞላ ኤኪ ጾስ ጋላቴዛ። ዱስር ፋ ታማርታይስ እንጌዛ። ኤ ታማርታይ አሳይስ ግሼዛ።<verse eid="MAT 15:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 15:37"/>አሳይ ኡባይ ም ምዤዛ። ኤ ታማርታይ፥ ማዳር አቴዝ ጉፋ ላፑን ግታ ሌማተ ኩን ደንዛ። <verse eid="MAT 15:37"/><verse number="38" style="v" sid="MAT 15:38"/>ሜዝ አሳይ ማችኔ ናአ ፓይደካዝን ራ ኣዳ ኦይዲ ሙኩሎ። <verse eid="MAT 15:38"/><verse number="39" style="v" sid="MAT 15:39"/>የሱሳ ዎይታ ዳከዛይፕ ጉየ ዎጎሎ ጋንጨ ገሊ ማጋዶና ግዝ ቢታ ቅቴዛ።<verse eid="MAT 15:39"/></para>
  <chapter eid="MAT 15"/>
  <chapter number="16" style="c" sid="MAT 16"/>
  <para style="s1">ሳሎፕ ማላታ በአዳይስ ኦይጬዝ ኦይች</para>
  <para style="r">(<ref loc="MRK 8:11-13">ማር. 8:11-13</ref>፤ <ref loc="LUK 12:54-56">ሉቃ. 12:54-56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1"/>ፈርሳውታይኔ ሳዱቃውታይ የሱሳኮ ይኢ። ኤዛ ፋጮዳይስ ኮዪ፥ ፋና ሳሎፕ ማላታ ቤዞ ግ ኦይጬዛ።<note caller="-" style="x"><char style="xo" closed="false">16:1 </char><char style="xt" closed="false"><ref loc="MAT 12:38">ማቶ. 12:38</ref>፤ <ref loc="LUK 11:16">ሉቃ. 11:16</ref></char></note> <verse eid="MAT 16:1"/><verse number="2" style="v" sid="MAT 16:2"/>ዝን ኤ ኡንትኮ፥ «ሳአ ኦማዳር ‹ሳሎ ዞቂ በንትኮ ዎንታ ሳአ ቦቃሎዳ› ይ ግዛ። <verse eid="MAT 16:2"/><verse number="3" style="v" sid="MAT 16:3"/>ዎንትታር ‹ሳሎ ዞቂ ሻራ አይክኮ Ꮊይኖ እራ ቡኮዳ› ይ ግዛ። የዝን ይ ሳሎ ብኢ ማሊ ኤርዝን ዎደ ብኢ ማሊ ኤሮዳይስ ዳንዳኤካያ። <verse eid="MAT 16:3"/><verse number="4" style="v" sid="MAT 16:4"/>ኢትታይኔ አማኖዋ የለትይ ማላታ ኮይዛ። ዝን ኤስ ዮናሳ ማላታይፕ ሀራ ማላታ እንግንቶያ» ዬጌዛ። የይፕ ጉየ፥ ኡንታን ኤዛይድ አሺ ሀራ አቆ ቅቴዛ።<note caller="-" style="x"><char style="xo" closed="false">16:4 </char><char style="xt" closed="false"><ref loc="MAT 12:39">ማቶ. 12:39</ref>፤ <ref loc="LUK 11:29">ሉቃ. 11:29</ref></char></note><verse eid="MAT 16:4"/></para>
  <para style="s1">ፈርሳውታይኔ ሳዱቃውታይ እርሾ</para>
  <para style="r">(<ref loc="MRK 8:14-21">ማር. 8:14-21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5"/>ኡ አባፕ ሰኮ ፕኖ ፒንጌዝ ዎደ ሶሎ ኤኪ የኦዳና ዶጌዛ። <verse eid="MAT 16:5"/><verse number="6" style="v" sid="MAT 16:6"/>የሱሳ ኡንትኮ፥ «ፈርሳውታይፐነ ሳዱቃውታይ እርሾፕ ናግንቶይታ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">16:6 </char><char style="xt" closed="false"><ref loc="LUK 12:1">ሉቃ. 12:1</ref></char></note> <verse eid="MAT 16:6"/><verse number="7" style="v" sid="MAT 16:7"/>ኡንትካ ፋ ጋንጨ፥ «ኤ የያ ጌዛይ ኑ ሶሎ ኤኪ የኤካ ግሾስ ማቃዳ» ዬጌዛ። <verse eid="MAT 16:7"/><verse number="8" style="v" sid="MAT 16:8"/>የሱሳ ኡ ቆፋ ኤሪ፥ «ይንታኖ፥ አማኖ ፓጬዝታዮ! ሶሎ ኤከካ የኤዝ ግሾስ ይ ዎል ግዶ አብስ ኦድንቴ? <verse eid="MAT 16:8"/><verse number="9" style="v" sid="MAT 16:9"/>Ꮊተካ ይ አካኮሳ? እችን ሙኩለ አሳይስ እችን ሶሎ ግሼዛኔ ኡ ም ምዥን ይ ኣፑን ሌማተ ኩን ደንዛኮ ይ ዶጌኔ?<note caller="-" style="x"><char style="xo" closed="false">16:9 </char><char style="xt" closed="false"><ref loc="MAT 14:17">ማቶ. 14:17</ref></char></note> <verse eid="MAT 16:9"/><verse number="10" style="v" sid="MAT 16:10"/>የይ ጋርከካ፥ ላፑን ሶሎ ኦይዲ ሙኩለ አሳይስ ግሼዛኔ ኡ ም ምዥን፥ ይ ኣፑን ሌማተ ኩን ደንዛካ ይ አካኮሳ?<note caller="-" style="x"><char style="xo" closed="false">16:10 </char><char style="xt" closed="false"><ref loc="MAT 15:34">ማቶ. 15:34</ref></char></note> <verse eid="MAT 16:10"/><verse number="11" style="v" sid="MAT 16:11"/>ይኬ፥ ታኒ ፈርሳውታይኔ ሳዱቃውታይ እርሾፕ ናግንቶይታ ግ ኦድዛይ ሶሎባጋ ባዛና ይ አካኮሳ?» ዬጌዛ። <verse eid="MAT 16:11"/><verse number="12" style="v" sid="MAT 16:12"/>የዝን፥ ኤ ታማርታይ የሱሳ ኦድዛይ ሙኑቆ ደንዳይስ ዎዝ እርሾባጋ ባዝን ፈርሳውታይኔ ሳዱቃውታይ ትምርታይፕ ናግንቶ ባጋ ማቄዛና አካኬዛ።<verse eid="MAT 16:12"/></para>
  <para style="s1">ጵጽሮሳ የሱሳ መስህ ማቄዛና ኦዴዛ</para>
  <para style="r">(<ref loc="MRK 8:27-30">ማር. 8:27-30</ref>፤ <ref loc="LUK 9:18-21">ሉቃ. 9:18-21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13"/>የሱሳ ቅሳረ ፍልጶሳ ቢታ ሄሌዝ ዎደ ፋ ታማርታይኮ፥ «አሳይ፥ አስ ናአ ኦና ጌ?» ዬጊ ኦይጬዛ።<verse eid="MAT 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14"/>ኡንትካ፥ «ፐታይ ፐታይ ጻማቅዛ ዋንሳ፥ Ꮊንክታይ ኤላሳ፥ ማ Ꮊንክታይካ እርማሳ ዎይ ናብታይፕ ፐታ ግዛ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">16:14 </char><char style="xt" closed="false"><ref loc="MAT 14:1">ማቶ. 14:1</ref></char></note><verse eid="MAT 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15"/>የሱሳ ማሂ፥ «የዝን፥ ይ ታና ኦና ጌ?» ግ ኡንታን ኦይጬዛ።<verse eid="MAT 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16"/>ስሞና ጵጽሮሳ ማሂ፥ «ኔኒ ክርስቶሳ፥ ደኦ ጾስ ናአ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">16:16 </char><char style="xt" closed="false"><ref loc="JHN 6:68">ዋን. 6:68</ref></char></note><verse eid="MAT 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17"/>የሱሳ ጵጽሮሳኮ፥ «ዮና ናአ ስሞና፥ ነ አንጅንቴዛያ! Ꮊያ ኔስ ቤዜዛይ ሳሎ የዝ ታ አዳይፕ አትን አስ ባያ። <verse eid="MAT 16:17"/><verse number="18" style="v" sid="MAT 16:18"/>ታ ኔስ ኦድዛ ጵጽሮሳ፥ ኔኒ ዛላ! ታኒ Ꮊ ዛላይል አፋ ታ ዎሳ ኬ ኬጾዳ። Ꮊይቆ ዎልቃይካ እዞ ጋመና። <verse eid="MAT 16:18"/><verse number="19" style="v" sid="MAT 16:19"/>ሳሎ ካተት ቁልፕታ ታ ኔስ እማዳ። ሳአ ነ አጬዝ ባዝ ኡባ ሳሎ ጾስ ካለ አጭንቴዝ ባዝ ማቃዳ። ሳአ ኔኒ ብልኤዝ ባዝ ኡባይ ሳሎ ጾስ ካለ ብልንቴዝ ባዝ ማቃዳ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">16:19 </char><char style="xt" closed="false"><ref loc="MAT 18:18">ማቶ. 18:18</ref>፤ <ref loc="JHN 20:23">ዋን. 20:23</ref></char></note><verse eid="MAT 16:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 16:20"/>የይፕ ጉየ፥ ኤ፥ ክርስቶሳ ማቄዛና ኦስካ ኦዳማይ ጋርክ ፋ ታማርታ ሚን አዛዜዛ።<verse eid="MAT 16:20"/></para>
  <para style="s1">የሱሳ ፋና ሄሎድ መታ ቲናቲ ኦዴዛ</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21"/>የ ዎደፕ አይኪ የሱሳ ፋ ታማርታይስ፥ «ታኒ የሩሳላመ Ꮊማዳይስ ቤዝዛ። ኤዛይድ ጋደ ጭምታይፕ፥ ቄሰ ሀላቅታይፐኔ ህገ አስታማርታይፕ ታ መቶ ኤኮዳይስ ቤዝዛ። ኡ ታና ዎዳ፥ ዝን ታኒ ሃይን ጋላስ Ꮊይቆፕ ደንዶዳ» ዬጊ ጌሺ ኦዴዛ።<verse eid="MAT 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22"/>ጵጽሮሳ የሱሳና ጋጻ ከሲ፥ «ጎዳዮ፥ የይ ሀነና! የይ ጋርክ ባዝ ነና የሻ ሄልፐ!» ዬጊ ጋይሌዛ።<verse eid="MAT 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23"/>የሱሳ ጵጽሮሳኮ ጉየ ማቂ፥ «Ꮊ ጻላሃዮ፥ ታፕ ሃኮባ! ኔኒ አስ ቆፋ ቆፕዛፕ አትን ጾስ ቆፋ ቆፖዋ ግሾስ ታስ በ ማቅዛ» ዬጌዛ።<verse eid="MAT 16:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24"/>የይፕ ጉየ፥ የሱሳ ፋ ታማርታይኮ፥ «ኦንካ ታና ካሎዳይስ ኮይዝ ባዝ ማቅኮ ፋና ካዶ፥ ፋ ማዝቃላ ቶኪ ታና ካሎ።<note caller="-" style="x"><char style="xo" closed="false">16:24 </char><char style="xt" closed="false"><ref loc="MAT 10:38">ማቶ. 10:38</ref>፤ <ref loc="LUK 14:27">ሉቃ. 14:27</ref></char></note> <verse eid="MAT 16:24"/><verse number="25" style="v" sid="MAT 16:25"/>ፋ ሸምፖ አሾዳይስ ኮይዝ ኡቢታይ ብስዛ። ዝን ፋ ሸምፖ ታ ግሾስ ግ ኣ እንግዛይ አሽዛ።<note caller="-" style="x"><char style="xo" closed="false">16:25 </char><char style="xt" closed="false"><ref loc="MAT 10:39">ማቶ. 10:39</ref>፤ <ref loc="LUK 17:33">ሉቃ. 17:33</ref>፤ <ref loc="JHN 12:25">ዋን. 12:25</ref></char></note> <verse eid="MAT 16:25"/><verse number="26" style="v" sid="MAT 16:26"/>አሲ አላመ ኩን ፋባዝ ኡዲ፥ ፋ ሸምፖ ብስኮ ኤዛ አብ ማዴ? ዎይ አሲ ፋ ሸምፖ ዎዞዳይስ አብ እንጎዳይስ ዳንዳኤ? <verse eid="MAT 16:26"/><verse number="27" style="v" sid="MAT 16:27"/>አስ ናአይ ፋ አዳይ ቦንቻይር ፋ ኪታንችታይር የኦዳ። የ ዎደ ፐቲ ፐቲ አይስ ኤ ኦሳት ጋርክ እማዳ።<note caller="-" style="x"><char style="xo" closed="false">16:27 </char><char style="xt" closed="false"><ref loc="MAT 25:31">ማቶ. 25:31</ref>፤ <ref loc="PSA 62:12">ማዝ. 62:12</ref>፤ <ref loc="ROM 2:6">ኦሮ. 2:6</ref></char></note> <verse eid="MAT 16:27"/><verse number="28" style="v" sid="MAT 16:28"/>ታ ቱሮ ኦድዛ፤ አስ ናአይ ካተትይር ማቂ የኦዳር በአድ ሄሎዳይስ Ꮊይዳ ኤቄዝ አሳይፕ Ꮊይቃምዝታይ የዛ» ዬጌዛ።<verse eid="MAT 16:28"/></para>
  <chapter eid="MAT 16"/>
  <chapter number="17" style="c" sid="MAT 17"/>
  <para style="s1">የሱሳ ማላይ ላምንቴዛ</para>
  <para style="r">(<ref loc="MRK 9:2-13">ማር. 9:2-13</ref>፤ <ref loc="LUK 9:28-36">ሉቃ. 9:28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1"/>ኡሱፑን ጋላሳፕ ጉየ የሱሳ ጵጽሮሳ፥ ያይቆባኔ ኤ እሻ ዋንሳ ፓር ኤኪ ኡ ኣዳ ዳማ አምባል አፋ ከዜዛ።<note caller="-" style="x"><char style="xo" closed="false">17:1 </char><char style="xt" closed="false"><ref loc="2PE 1:17-18">2ጵጽ. 1:17-18</ref></char></note> <verse eid="MAT 17:1"/><verse number="2" style="v" sid="MAT 17:2"/>ኤዛይድ ኡ ቲና የሱሳ ማላይ ላምንቴዛ፤ ኤ ስናይካ አዋ ጋርክ ፖኤዛ። ኤ አፍላይካ ቦ ፖኦ ጋርክ ፖጬዛ። <verse eid="MAT 17:2"/><verse number="3" style="v" sid="MAT 17:3"/>ይኬ፥ ሙሰኔ ኤላሳ ኤዛር ናሾዳር በኤዛ። <verse eid="MAT 17:3"/><verse number="4" style="v" sid="MAT 17:4"/>ጵጽሮሳ የሱሳኮ፥ «ኑኒ ነ ኮይኮ ፐቶ ኔስ፥ ፐቶ ሙሰሲ፥ ፐቶ ኤላሳስ Ꮊይዳ ሀይ ሻቃራ አጮዳ» ዬጌዛ። <verse eid="MAT 17:4"/><verse number="5" style="v" sid="MAT 17:5"/>ጵጽሮሳ የያ ሀጋ ኦዶዳር ቦ ሻራ ኡንታን ካሜዛ። ሻራይ ጋንጨ፥ «ታና ኡፋይስዛ፥ ታ ቃዛ ናአይ Ꮊያ፥ ኤዛ ስኦይታ!» ዬግዝ ጊር የኤዛ።<note caller="-" style="x"><char style="xo" closed="false">17:5 </char><char style="xt" closed="false"><ref loc="GEN 22:2">መ. 22:2</ref>፤ <ref loc="PSA 2:7">ማዝ. 2:7</ref>፤ <ref loc="ISA 42:1">ኢሳ. 42:1</ref>፤ <ref loc="MAT 3:17">ማቶ. 3:17</ref>፤ <ref loc="MAT 12:18">12:18</ref>፤ <ref loc="MRK 1:11">ማር. 1:11</ref>፤ <ref loc="LUK 3:22">ሉቃ. 3:22</ref>፤ <ref loc="DEU 18:15">ናምእ. 18:15</ref></char></note> <verse eid="MAT 17:5"/><verse number="6" style="v" sid="MAT 17:6"/>የሱሳ ታማርታይ የያ ስኢ ዳጋሚ ፋ ስናይር ሳአ ጉጲንጌዛ። <verse eid="MAT 17:6"/><verse number="7" style="v" sid="MAT 17:7"/>ዝን የሱሳ ኡንትኮ ሺቂ ኡንታን ቦቺ፥ «ደንዶይታ፥ ያሽትፓተ!» ዬጌዛ። <verse eid="MAT 17:7"/><verse number="8" style="v" sid="MAT 17:8"/>ኡ ቅ ግ በአዳር የሱሳፕ ሀራ ኦናካ በኤካያ።<verse eid="MAT 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9"/>ኡ አምባላፕ ዎዳር የሱሳ ኡንትኮ፥ «አስ ናአይ Ꮊይቆፕ ደንዶድ ሄሎዳይስ Ꮊያ ይ በኤዝ ባዛና ኦስካ ኦድፓተ» ግ አዛዜዛ። <verse eid="MAT 17:9"/><verse number="10" style="v" sid="MAT 17:10"/>የሱሳ ታማርታይ፥ «የዝን፥ ህገ አስታማርታይ ኤላሳ ክርስቶሳፕ ቲናቲ የኦድ ጌዛይ አብሶ?» ዬጊ ኦይጬዛ።<note caller="-" style="x"><char style="xo" closed="false">17:10 </char><char style="xt" closed="false"><ref loc="MAL 4:5">ሚል. 4:5</ref></char></note><verse eid="MAT 17:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11"/>የሱሳ ማሂ፥ «ኤ! ኤላሳ ቲና ይኢ ኡባ ባዝ ሎእዳ። <verse eid="MAT 17:11"/><verse number="12" style="v" sid="MAT 17:12"/>ዝን ታ ይንትስ ቱሮ ኦድዛ፤ ኤላሳ ቲናቲ የኤዛ። ኡንትካ ኤዛል አፋ ኮዬዝ ባዝ ኦዛይፕ አትን ኤዛ ሻኪ ኤረካያ። የይ ጋርክ አስ ናአይ ኡ ኩሸ መቶ ኤኮዳ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">17:12 </char><char style="xt" closed="false"><ref loc="MAT 11:14">ማቶ. 11:14</ref></char></note><verse eid="MAT 17:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 17:13"/>የ ዎደ የሱሳ ጌዛይ ጻማቅዛ ዋንሳ ባጋ ማቄዛና ኡ አካኬዛ።<verse eid="MAT 17:13"/></para>
  <para style="s1">የሱሳ ቱና አያና አይኬዝ ናአ ፓዛ</para>
  <para style="r">(<ref loc="MRK 9:14-29">ማር. 9:14-29</ref>፤ <ref loc="LUK 9:37-43">ሉቃ. 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14"/>ኡ አምባላፕ አሳይኮ ማቄዛን ጋርክ ፐቲ አይ የሱሳ ቲና ቡንቅቲ፥ <verse eid="MAT 17:14"/><verse number="15" style="v" sid="MAT 17:15"/>«ጎዳዮ፥ ማጋነ ታ ናአይስ ቃንቶየ፤ ኤዛ አግናር አግናር ደንዲ ታማ ጋንጨኔ ሃ ጋንጨ ሾጪ ኦልዝ ኢታ ሀርገ የዛ። <verse eid="MAT 17:15"/><verse number="16" style="v" sid="MAT 17:16"/>ነ ታማርታይኮ ታ ክእን፥ ኡ ፓዳይስ ዳንዳኤካያ» ዬጌዛ።<verse eid="MAT 17:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17"/>የሱሳ ማሂ፥ «ይንታኖ፥ አማኖዋ ዡጫ የለትታዮ አይደ ሄሎዳይስ ታ ይንታር የዞዴ? አይደ ሄሎዳይስ ታ ይንታን ዳንዳኦዴ? አን ናአ Ꮊና ኤኪ የኦይታ» ዬጌዛ። <verse eid="MAT 17:17"/><verse number="18" style="v" sid="MAT 17:18"/>የሱሳ ቱና አያና ቆድን፥ ቱና አያናይ ናአይፕ ከዜዝ፤ የ ሳታተ ናአይ ፓጼዛ። <verse eid="MAT 17:18"/><verse number="19" style="v" sid="MAT 17:19"/>የይፕ ጉየ፥ የሱሳ ታማርታይ ፋ ኣዳስ ኤዝኮ ሺቂ፥ «ኑኒ ቱና አያና ከሶዳይስ ዳንዳኤካዛይ አብሶ?» ዬጊ ኦይጬዛ። <verse eid="MAT 17:19"/><verse number="20" style="v" sid="MAT 17:20"/>ኤ ኡንትኮ፥ «ይንትስ አማኖ ጽቄዝ ግሾሲ። ታ ይንትስ ቱሮ ኦድዛ፤ ሳናፍጨ ኣፈ ጋርክ አማኖ ይንትስ የዛኮ ‹Ꮊ አምባ Ꮊይፕ ደንዲ ገደ ኣባ› ጊኮ ይንትስ ኪትንቶዳ። ይንትስ ዳንዳእንቶዋ ባዝ ባያ። <verse eid="MAT 17:20"/><verse number="21" style="v" sid="MAT 17:21"/>[ዝን የይ ጋርከዛይ ዎሳፐኔ ጾማፕ አትን ሀራር ከዞያ]» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">17:20-21 </char><char style="xt" closed="false"><ref loc="MAT 21:21">ማቶ. 21:21</ref>፤ <ref loc="MRK 11:23">ማር. 11:23</ref>፤ <ref loc="1CO 13:2">1ቆሮ. 13:2</ref></char></note><note caller="+" style="f"><char style="fr" closed="false">17:21 </char><char style="fqa" closed="false">ፐቲ ፐቲ ብኒ ማጻፍታይድ ታይቦ 21 ባያ።</char></note><verse eid="MAT 17:21"/></para>
  <para style="s1">የሱሳ ፋ Ꮊይቆ ባጋ ማሂ ኦዴዛ</para>
  <para style="r">(<ref loc="MRK 9:30-32">ማር. 9:30-32</ref>፤ <ref loc="LUK 9:43-45">ሉቃ. 9:43-45</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22"/>የሱሳ ታማርታይ ጋልላ ቢታ ሺቂ የዝን የሱሳ ኡንትኮ፥ «አስ ናአይ አስ ኩሸ ኣ እንግንቶዳ። <verse eid="MAT 17:22"/><verse number="23" style="v" sid="MAT 17:23"/>ኡንቲ ኤዛ ዎዳ፥ ዝን ኤ ሃይን ጋላስ Ꮊይቆፕ ደንዶዳ» ዬጌዛ።</para>
  <para style="p" vid="MAT 17:23">ኤ ታማርታይካ ኢታ አዛኔዛ።<verse eid="MAT 17:23"/></para>
  <para style="s1">ጊራ ጋቾ</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24"/>የሱሳራ ኤ ታማርታይራ ቅፍርናሆመ ካታማ ሄሌዝ ዎደ ጾሳ ኬ ጊራ ኤክዝታይ ጵጽሮሳኮ ይኢ፥ «ይ አስታማራይ ዎሳ ኬ ጊራ ጊርነኔ?» ዬጊ ኦይጬዛ።<note caller="-" style="x"><char style="xo" closed="false">17:24 </char><char style="xt" closed="false"><ref loc="EXO 30:13">ከስ 30:13</ref></char></note><verse eid="MAT 17:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25"/>ጵጽሮሳ ማሂ፥ «ጊርዛ» ዬጌዛ። ጵጽሮሳ ካራ ገሎዳር የሱሳ ቲናቲ፥ «ጵጽሮሳ፥ ኔስ አብ ኣዜ? Ꮊ ሳአ ካተትይ ቃራጸኔ ጊራ ኦፕ ኤክኔ? ጋደ አሳይፐኔ አስ ጋደ አሳፕ?» ዬጊ ኦይጬዛ።<verse eid="MAT 17:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26"/>ጵጽሮሳ «አስ ጋደ አሳፔ» ግ ማሄዛ።</para>
  <para style="p" vid="MAT 17:26">የሱሳ ማሂ፥ «ጋደ አስ ጊራ ጊሮዋ ጉሶ? <verse eid="MAT 17:26"/><verse number="27" style="v" sid="MAT 17:27"/>ዝን ኡ ብንታማይ ጋርክ አባ Ꮊንጊ ሞሎ አይክዝ ማንጻቆ ኦሎባ። ቲና ነ አይክዝ ሞላይ ዶና ዶዪ ጊራስ ግድዛ ሚሸ ኤኪ ነ ግሾኔ ታ ግሾስ ካንጊ ጊሮባ» ዬጌዛ።<verse eid="MAT 17:27"/></para>
  <chapter eid="MAT 17"/>
  <chapter number="18" style="c" sid="MAT 18"/>
  <para style="s1">ኡባፕ ኣዛይ ኦኖ?</para>
  <para style="r">(<ref loc="MRK 9:33-37">ማር. 9:33-37</ref>፤ <ref loc="LUK 9:46-48">ሉቃ. 9:46-48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1"/>የ ዎደ የሱሳ ታማርታይ ይኢ፥ «ሳሎ ካተት ኡባፕ ኣዛይ ኦኖ?» ዬጊ ኦይጬዛ።<note caller="-" style="x"><char style="xo" closed="false">18:1 </char><char style="xt" closed="false"><ref loc="LUK 22:24">ሉቃ. 22:24</ref></char></note> <verse eid="MAT 18:1"/><verse number="2" style="v" sid="MAT 18:2"/>የሱሳ ፐቲ ዱደ ናአ ጼጊ ኡ ጋንጨ ኤሲ Ꮊይ ጋርከ ዬጌዛ። <verse eid="MAT 18:2"/><verse number="3" style="v" sid="MAT 18:3"/>«ታ ይንትስ ቱሮ ኦድዛ፤ ይ ላምንታምጽኮኔ ዱደ ናአ ጋርክ ሀናም እጽኮ ሳሎ ካተት ገሎዳይስ የሻ ዳንዳኦያ።<note caller="-" style="x"><char style="xo" closed="false">18:3 </char><char style="xt" closed="false"><ref loc="MRK 10:15">ማር. 10:15</ref>፤ <ref loc="LUK 18:17">ሉቃ. 18:17</ref></char></note> <verse eid="MAT 18:3"/><verse number="4" style="v" sid="MAT 18:4"/>ይኬ፥ Ꮊ ዱደ ናአይ ጋርክ ፋና ካዉሽዛ ኦንካ ሳሎ ካተት ኡባፕ ኣዛ ማቃዳ። <verse eid="MAT 18:4"/><verse number="5" style="v" sid="MAT 18:5"/>Ꮊይ ጋርክ ዱደ ናአ ታ ሱንር ሞክዛ ኦንካ ታና ሞክዛ።<verse eid="MAT 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6"/>«ዝን ታና አማንዛ Ꮊ ጽቅታይፕ ፐታ ናጋራ ኦድ ጋርክ በ ማቅዝ ኦንካ ዳማ ዎጻ ፋ ቆል አጪ ጪሞ አባ ጋንጨ ምትንትኮ ኤስ ሎኦ። <verse eid="MAT 18:6"/><verse number="7" style="v" sid="MAT 18:7"/>አላመል አሲ ናጋራ ኦድ ጋርክ ኦዛባዝ የዛ ግሾስ አላመ አየ። የይ ጋርክ ባዝ የኤካ አታሚ፥ ዝን በ ኤ ባጋር ይእዝ አ አየ።<verse eid="MAT 18:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 18:8"/>«ነ ኩሸ ዎይ ነ ቶኬ ነና ባልኮ ኔፕ ጋቺ ኦሎባ። ኔኒ ናምኢ ኩሸር ዎይ ናምኢ ቶከር መና ታማ ጋንጨ ዎዳይፕ ኩሸ ዎይ ቶኬ ዱጻ ማቂ መና ደኦ ደንግዛይ ኔስ ሎኦ።<note caller="-" style="x"><char style="xo" closed="false">18:8 </char><char style="xt" closed="false"><ref loc="MAT 5:30">ማቶ. 5:30</ref></char></note> <verse eid="MAT 18:8"/><verse number="9" style="v" sid="MAT 18:9"/>ማ ነ ኣፋይ ነና ባልኮ እዞ ዎጪ ከሲ ኦሎባ። ኔኒ ናምኢ ኣፈር ጋናመ ታማ ጋንጨ ዎዳይፕ ፐቲ ኣፈር መና ደኦ ገልዛኮ ኔስ ሎኦ።<note caller="-" style="x"><char style="xo" closed="false">18:9 </char><char style="xt" closed="false"><ref loc="MAT 5:29">ማቶ. 5:29</ref></char></note><verse eid="MAT 18:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10"/>«ታ ይንትስ ኦድዛ፤ ሳሎ የዝ ኡንታን ናግዝ ኪታንችታይ ኡባ ዎደ ሳሎ የዝ ታ አዳይ ቲና የዝ ግሾስ ይ Ꮊ ጽቅታይፕ ፐታካ ሌቃም ጋርክ ናግንቶይታ።<note caller="-" style="x"><char style="xo" closed="false">18:10-11 </char><char style="xt" closed="false"><ref loc="LUK 19:10">ሉቃ. 19:10</ref></char></note> <verse eid="MAT 18:10"/><verse number="11" style="v" sid="MAT 18:11"/>አስ ናአይ ቤዝታ አሾዳይስ የኤዛ»<note caller="+" style="f"><char style="fr" closed="false">18:11 </char><char style="ft" closed="false">አስ ናአይ ቤዝታ አሾዳይስ የኤዛ፦ ዬግዛና ፐቲ ፐቲ ብኒ ማጻፍታይ ታይቦ 11 ጉጅዛ።</char></note> ዬጌዛ።<verse eid="MAT 18:11"/></para>
  <para style="s1">ቤዝ ዱር ኣዝሶ</para>
  <para style="r">(<ref loc="LUK 15:3-7">ሉቃ. 15:3-7</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12"/>ማ የሱሳ፥ «ይንትስ አብ ኣዜ? ፐቲ አይስ ጼት ዱርታይ የዝታይፐ ፐታይ ብኮ ኡዱፉን ታማኔ ኡዱፉንታ አምባል አፋ ኦሊ አሺ የ ቤዛና ኮዮዳይስ Ꮊንጎሳ? <verse eid="MAT 18:12"/><verse number="13" style="v" sid="MAT 18:13"/>ታ ቱሮ ኦድዛ፤ ኤ ደንጌዝ ዎደ ኡዱፉን ታማኔ ኡዱፉንታይፕ ኣ ቢ በንቴዝ ፐቲ ዱራይል ኡፋይትዛ። <verse eid="MAT 18:13"/><verse number="14" style="v" sid="MAT 18:14"/>የይ ጋርከካ፥ ሳሎ የዝ ይ አዳይ Ꮊ ጽቅታይፕ ፐታይ ቦድ ጋርክ ኮዮያ።<verse eid="MAT 18:14"/></para>
  <para style="s1">ቆሄዝ አሲ ዋይሳደ?</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15"/>«ነ እሻይ ነና ቆህኮ ነ ኣዳስ ኤዝኮ Ꮊንጊ ኤ ቡታ ኤዝስ ኦዶባ። ኤ ነና ስእኮ ነ እሻ ኔስ ሻሎ ኡዶባ።<note caller="-" style="x"><char style="xo" closed="false">18:15 </char><char style="xt" closed="false"><ref loc="LUK 17:3">ሉቃ. 17:3</ref></char></note> <verse eid="MAT 18:15"/><verse number="16" style="v" sid="MAT 18:16"/>ዝን ኤ ነና ስአም እጽኮ፥ ናምኢ ዎይ ሀይ አስ ማርካር ሞቲ ዎዛ ግሾስ ፐቲ ዎይ ናምኢ አስ ኤኪ ኤዝኮ Ꮊንጎባ።<note caller="-" style="x"><char style="xo" closed="false">18:16 </char><char style="xt" closed="false"><ref loc="DEU 19:15">ናምእ. 19:15</ref></char></note> <verse eid="MAT 18:16"/><verse number="17" style="v" sid="MAT 18:17"/>ኤ ኡንታን ስአም እጽኮ፥ ዎሳ ኬስ ኦዶባ። ዎሳ ኬ ግዝ ባዝ ስአም እጽኮ አማኖዋ አስ ጋርክ ዎይ ቃራጸ ጋችስዝ አስ ጋርክ ኤዛ ታይቦባ።<verse eid="MAT 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18"/>«ታ ይንትስ ቱሮ ኦድዛ፤ ሳአ ይ አጭዝ ባዝ ኡቢታይ ሳሎ ጾስ ካለ አጭንቴዝ ባዝ ማቃዳ። ሳአ ይ ብሌዝ ባዝ ኡቢታይ ሳሎ ጾስ ካለ ብልንቴዝ ባዝ ማቃዳ።<note caller="-" style="x"><char style="xo" closed="false">18:18 </char><char style="xt" closed="false"><ref loc="MAT 16:19">ማቶ. 16:19</ref>፤ <ref loc="JHN 20:23">ዋን. 20:23</ref></char></note><verse eid="MAT 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19"/>«ማካ ታ ይንትስ ኦድዛ፤ ሳአ ይንትፕ ናምእታይ ፐቲ ዎዝናር ማቂ ጾስ ዎስዛ ባዝ ማቅኮ ሳሎ የዝ ታ አዳይ ይንትስ ኦዳ። <verse eid="MAT 18:19"/><verse number="20" style="v" sid="MAT 18:20"/>ታና ካልዝታይፕ ናምኢ ዎይ ሀይ ማቂ ሺቅዛ በሳ ታ ኡ ጋንጨ በንቶዳ» ዬጌዛ።<verse eid="MAT 18:20"/></para>
  <para style="s1">አቶ ጉስ ባጋ</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21"/>የ ዎደ ጵጽሮሳ የሱሳኮ ይኢ፥ «ጎዳዮ፥ ታ እሻይ ታና ቆህኮ ኣፑን ቶኬ ታ አቶ ጎዳይስ ቤዝኔ? ላፑን ቶኬ ሄሎዳይሶኔ?» ግ ኦይጬዛ።<note caller="-" style="x"><char style="xo" closed="false">18:21-22 </char><char style="xt" closed="false"><ref loc="LUK 17:3-4">ሉቃ. 17:3-4</ref></char></note><verse eid="MAT 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22"/>የሱሳ ማሂ፥ «የያ ባያ፥ ላፑን ታም ቶኬ ላፑንፕ አትን ላፑን ቶኬ ባያ።<note caller="-" style="x"><char style="xo" closed="false">18:22 </char><char style="xt" closed="false"><ref loc="GEN 4:24">መ. 4:24</ref></char></note><verse eid="MAT 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23"/>«የይ ግሾስ፥ ጾስ ካተትይ ፋ ኦሶ አስታይር ፋ ምሻይ ፓጨዛኮኔ ፉጬዛኮ በአዳይስ ቆፔዝ ካታ ኣዝዛ። <verse eid="MAT 18:23"/><verse number="24" style="v" sid="MAT 18:24"/>የ ካታይ ሚሻይ ፓጨዛኮኔ ፉጬዛኮ ብእዛ ዎደ ጋመ ሙኩለ አጮ የዝ ፐቲ አ ኤዝኮ ከኤዛ። <verse eid="MAT 18:24"/><verse number="25" style="v" sid="MAT 18:25"/>ዝን የ አይላይ አጫ ጭጎዳይስ ጋምንትን ኤዛ፥ ኤ ማቻትራ፥ ኤ ናእታይራኔ ኤዝስ የዛ ባዝ ኡባይ ባይዝንቲ አጮ ጭግንቶድ ጋርክ ኤዛ ጎዳይ አዛዜዛ። <verse eid="MAT 18:25"/><verse number="26" style="v" sid="MAT 18:26"/>የዝን አይላይ ፋ ጎዳይ ቶካይል አፋ ዎ፥ ‹ታ ጎዳዮ፥ ሀያና ጽቃስ ጋምኦዬ፥ ታ ኡባ ጭጎዳ› ዬጊ ዎሴዛ። <verse eid="MAT 18:26"/><verse number="27" style="v" sid="MAT 18:27"/>ካታይ ኤዝስ ቃንቲ፥ ዳኪ አሼዛ፤ ኤ አጫካ ማሬዛ።<verse eid="MAT 18:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28"/>«ዝን የ አይላይ ከዚ Ꮊንጊ ፋ ላጌ ኦሶ አስታይፕ ፐታይ ኤዛፕ ጽቃ ሚሸ ታልኤዛና፥ ‹ኔል አፋ የዝ ታ ሚሻ ታስ ጭጎባ› ግ አይስ ቆት ጩሌዛ።<verse eid="MAT 18:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29"/>«የ ኤ ላጌ አይላይ ኤ ቶካይል ዎ፥ ‹ሀያና ጽቃል ጋምኦዬ ታ ኔስ ኡባ ጭጎዳ› ዬጊ ዎሴዛ።<verse eid="MAT 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 18:30"/>«ዝን እጺ ኤኪ ካንጊ ፋ ላጋይ ኣጫ ጭጎድ ሄሎዳይስ አች ኬ ገልሴዛ። <verse eid="MAT 18:30"/><verse number="31" style="v" sid="MAT 18:31"/>የይ ግሾስ፥ ሀራ ላጌ ኦሶ አስታይ የያ ብኢ ኢታ ይሎቲ፥ Ꮊንጊ ፋ ጎዳይስ ኤ ኦዝ ባዝታ ኡባ ኦዴዛ።<verse eid="MAT 18:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 18:32"/>«የዝን ጎዳይ የ አይላ ጼግሲ፥ ‹Ꮊ ኢታ አይላዮ፥ ኔኒ ታና ዎሴዝ ግሾስ ታ ነ አጫ ኡባ ነና ማሬዛ። <verse eid="MAT 18:32"/><verse number="33" style="v" sid="MAT 18:33"/>የዝን፥ ታኒ ነ አጫ ማሬዛይ ጋርክ ኔኒ ነ ላጌ ማቄዝ አይላይ አጫ ማሮዳይስ ኔስ ቤዞሳ?› ዬጌዛ። <verse eid="MAT 18:33"/><verse number="34" style="v" sid="MAT 18:34"/>የይ ግሾስ፥ ጎዳይ ኢታ ይሎቲ፥ ኤ ፋ አጫ ኡባ ጭጎድ ሄሎዳይስ ፓ ካእንቶዳይ ጋርክ አች ኬስ ኣ እንጌዛ።<verse eid="MAT 18:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35"/>«የይ ጋርከ፥ ይ ፐታይ ፐታይ ይ እሻ ዎዝናፕ ማራም እጽኮ ሳሎ የዝ ታ አዳይ ይንታን Ꮊይ ጋርክ ኦዳ» ዬጌዛ።<verse eid="MAT 18:35"/></para>
  <chapter eid="MAT 18"/>
  <chapter number="19" style="c" sid="MAT 19"/>
  <para style="s1">ኤኮ ባጋኔ ገሎ ባጋ</para>
  <para style="r">(<ref loc="MRK 10:1-12">ማር. 10:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1"/>የሱሳ የያ ኦዲ ሃሴዛይፕ ጉየ ጋልላፕ ደንዲ ዮርዳኖሳ ቦርካፕ ሰኮ ፕኖ የዝ ይሁዳ ቢታ ቅቴዛ። <verse eid="MAT 19:1"/><verse number="2" style="v" sid="MAT 19:2"/>ጋመ አሳይ ኤዛ ካሊ Ꮊንግን ኡ ጋንጨፕ ሀርግንቴዝ አስታ ፓዛ።<verse eid="MAT 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3"/>ፈርሳወ አስታይ ኤዛ ፋጮዳይስ ኮዪ ኤዝኮ ይኢ፥ «ፐቲ አሲ አባባዝ ግሾስካ ፋ ማቻቶ ዳኮዳይስ ቤዝኔ?» ዬጊ ኦይጬዛ።<verse eid="MAT 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4"/>የሱሳ ማሂ፥ «ጾሲ ቲና ራኔ ማች ኡዲ መዛና ይ ናባበካሳ?<note caller="-" style="x"><char style="xo" closed="false">19:4 </char><char style="xt" closed="false"><ref loc="GEN 1:27">መ. 1:27</ref>፤ <ref loc="GEN 5:1">5:1</ref></char></note> <verse eid="MAT 19:4"/><verse number="5" style="v" sid="MAT 19:5"/>‹የይ ግሾስ፥ ፐቲ አሲ ፋ አደኔ ፋ እንዶ አሺ ፋ ማቻትር ፐቶ ማቅዛ፥ ናምእታይካ ፐቲ አሾ ማቅዛ›<note caller="-" style="x"><char style="xo" closed="false">19:5 </char><char style="xt" closed="false"><ref loc="GEN 2:24">መ. 2:24</ref></char></note> <verse eid="MAT 19:5"/><verse number="6" style="v" sid="MAT 19:6"/>የይ ግሾስ፥ ኡንቲ ፐቲ አሾ ማቆዳይፕ አትን ናምኤ ማቆያ። ይኬ፥ ጾሲ አጬዛና አሲ ብልፐ» ዬጌዛ።<verse eid="MAT 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7"/>ፈርሳወ አስታይ፥ «የዝን፥ ሙሰ ፐቲ አስ አንጆ ዋርቃተ እንጊ ፋ ማቻቶ ዳኮዳይ ጋርክ አብስ አዛዜኔ?» ዬጊ ኦይጬዛ።<note caller="-" style="x"><char style="xo" closed="false">19:7 </char><char style="xt" closed="false"><ref loc="GEN 24:1">መ. 24:1</ref></char></note><verse eid="MAT 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8"/>የሱሳ ማሂ፥ «ይንቲ፥ ይ ማችታ ዳኮድ ጋርክ ሙሰ ይንታን አዛዜዛይ፥ ይ ዎዛና ምኖትይ ግሾፕ አትን ቲናፕ የይ ጋርክ ባያ። <verse eid="MAT 19:8"/><verse number="9" style="v" sid="MAT 19:9"/>ታ ይንትስ ኦድዛ፤ ፋ ማቻት ላግተካዝን ዳኪ ሀራ ኤክዝ ኦንካ ላምዛ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">19:9 </char><char style="xt" closed="false"><ref loc="MAT 5:32">ማቶ. 5:32</ref>፤ <ref loc="1CO 7:10">1ቆሮ. 7:10</ref></char></note><verse eid="MAT 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10"/>ኤ ታማርታይ ኤዝኮ፥ «አዝንኔ ማቺ ባጋ የይ ጋርክ ማቅኮ ኤኮኔ ገሎ አትኮ ሎኦ» ዬጌዛ።<verse eid="MAT 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11"/>የሱሳ ማሂ፥ «የይ ጋርክ ትምርታይ ጾሲ ዳንዳአ እንጌዝታይሳፕ አትን አስ ኡቢታይስ ባያ። <verse eid="MAT 19:11"/><verse number="12" style="v" sid="MAT 19:12"/>ይኬ፥ የልንትታር ሲላ ማቂ የልንቴዝታይ የዛ፥ ማ አሲ ቃራቴዝታይ የዛ፥ ማ ሳሎ ካተት ግሾስ ዬጊ ፋና ሲሊሴዝታይ የዛ። የይ ግሾስ፥ Ꮊያ ኤኮዳይስ ዳንዳእዛ ኦንካ ኤኮ» ዬጌዛ።<verse eid="MAT 19:12"/></para>
  <para style="s1">የሱሳ ጽቃ ናእታ አንጄዛ</para>
  <para style="r">(<ref loc="MRK 10:13-16">ማር. 10:13-16</ref>፤ <ref loc="LUK 18:15-17">ሉቃ. 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13"/>የሱሳ ፋ ኩሻ ዱደ ናእታይል አፋ ጋዲ ኡንትስ ዎሶድ ጋርክ ፐቲ ፐቲ አሳይ ናእታ ኤዝኮ ከኤዛ። ዝን ኤ ታማርታይ አሳይል ካጭንቴዛ። <verse eid="MAT 19:13"/><verse number="14" style="v" sid="MAT 19:14"/>ዝን የሱሳ፥ «ጾስ ካተትይ Ꮊይትታይ ጋርከዝታይስ ማቄዝ ግሾስ ዱደ ናእታይ ታኮ ይእዛና ካይፓተ፤ የኦ ጎይታ» ዬጌዛ።<verse eid="MAT 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 19:15"/>ፋ ኩሻ ኡንታል አፋ ጋዴዛይፕ ጉየ የ አቃይፕ አሺ ቅቴዛ።<verse eid="MAT 19:15"/></para>
  <para style="s1">ሳአ ዱረትኔ ሳሎ ካተት</para>
  <para style="r">(<ref loc="MRK 10:17-31">ማር. 10:17-31</ref>፤ <ref loc="LUK 18:18-30">ሉቃ. 18:18-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16"/>ፐቲ ጋላስ ፐቲ አይ የሱሳኮ ይኢ፥ «አስታማራዮ፥ ታኒ መና ደኦ ደንጎዳይስ አብ ሎኦ ባዝ ኦ?» ዬጌዛ። <verse eid="MAT 19:16"/><verse number="17" style="v" sid="MAT 19:17"/>የሱሳ ኤዝኮ፥ «ሎኦ ባዝ ባጋ ነ ታና አብስ ኦይጨ? ፐቲ ጾሳፕ አትን ሀራ ሎኦ ባያ። ዝን ነ መና ደኦ ኤኮዳይስ ኮይኮ አዛዝታ ናጎባ» ዬጌዛ።<verse eid="MAT 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18"/>አይ ማሂ፥ «አዛዝታይ ኣይታ?» ዬጊ ኦይጬዛ።</para>
  <para style="p" vid="MAT 19:18">የሱሳ ማሂ፥ «ዎፐ፥ ላምፐ፥ ካስትፐ፥ ዎርዶ ማርካትፐ፥<note caller="-" style="x"><char style="xo" closed="false">19:18 </char><char style="xt" closed="false"><ref loc="EXO 20:13-16">ከስ 20:13-16</ref>፤ <ref loc="DEU 5:17-20">ናምእ. 5:17-20</ref></char></note> <verse eid="MAT 19:18"/><verse number="19" style="v" sid="MAT 19:19"/>ነ አዳኔ ነ እንዳቶ ቦንቾባ፥ ነ ላጋ ነ ኡባይ ጋርክ ቃባ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">19:19 </char><char style="xt" closed="false"><ref loc="EXO 20:12">ከስ 20:12</ref>፤ <ref loc="DEU 5:16">ናምእ. 5:16</ref>፤ <ref loc="LEV 19:18">ለዊ. 19:18</ref></char></note><verse eid="MAT 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20"/>የ ፓንይ፥ «ታኒ Ꮊይትታ ኡባ ናአትፕ አይኪ ፖልታር የዛ። የዝን፥ ሀራ ታስ ፓጭዛባዝ አባ?» ዬጊ ኦይጬዛ።<verse eid="MAT 19:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21"/>የሱሳ ማሂ፥ «ነ ፎሎ ማቆዳይስ ኮይኮ Ꮊንጊ ኔስ የዛ ባዝ ባይዚ ማንቅታይስ እንጎባ፤ ኔኒ ሳሎ ዱርቶዳ። ዬዚ ማቂ ይኢ ታና ካሎባ» ዬጌዛ።<verse eid="MAT 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22"/>ዝን የ አይ ዱረ ማቄዝ ግሾስ የያ ስኢ አዛንታር አሺ ቅቴዛ። <verse eid="MAT 19:22"/><verse number="23" style="v" sid="MAT 19:23"/>የይፕ ጉየ፥ የሱሳ ፋ ታማርታይር፥ «ታኒ ይንትስ ቱሮ ኦድዛ፤ ዱረ ሳሎ ካተት ገሎዳይ ጋመ መቶ። <verse eid="MAT 19:23"/><verse number="24" style="v" sid="MAT 19:24"/>ዱረ አሲ ጾስ ካተት ገሎዳይፕ ግማለ ናርፐ ሉኮር ኣዳይ ካዉዥዛ» ዬጌዛ። <figure style="fig" alt="Man leading unloaded camel" file="LB00039B.tif" size="span" ref="19:24">ግማለ </figure><verse eid="MAT 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25"/>የሱሳ ታማርታይ የያ ስኢ ማላባዝ ግ፥ «የዝን፥ ኦኒ አቶዳይስ ዳንዳኤ?» ዬጊ ኦይጬዛ።<verse eid="MAT 19:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26"/>የሱሳ ኡንታን ዳኪ ብኢ፥ «Ꮊይ አስስ ዳንዳእንቶያ፥ ዝን ጾስስ ኡባይ ዳንዳእንትዛ» ዬጌዛ።<verse eid="MAT 19:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27"/>ጵጽሮሳ ማሂ፥ «ኑኒ ኡባ ባዝ አሺ ነና ካሌዛ። የዝን፥ ኑኒ አብ ደማዴ?» ዬጌዛ። <verse eid="MAT 19:27"/><verse number="28" style="v" sid="MAT 19:28"/>የሱሳ ኡንትኮ Ꮊይ ጋርከ ዬጌዛ፦ «ታኒ ይንትስ ቱሮ ኦድዛ፤ አስ ናአይ የኦድ አላማይድ ፋ ቦንቾ ዙፋነል በትዛ ዎደ ይ ታጶ ናምእታይ፥ ታና ካሌዝ፥ ታጶ ናምኢ ዙፋነል በቲ ታጶ ናምኢ እስሬለ ዘርታይል አፋ ፕርዶዳ።<note caller="-" style="x"><char style="xo" closed="false">19:28 </char><char style="xt" closed="false"><ref loc="MAT 25:31">ማቶ. 25:31</ref>፤ <ref loc="LUK 22:30">ሉቃ. 22:30</ref></char></note> <verse eid="MAT 19:28"/><verse number="29" style="v" sid="MAT 19:29"/>ታ ሱንይ ግሾስ ኬታ ዎይ እሽታ ዎይ ምሽታ፥ ዎይ አደ ዎይ እንዶ ዎይ ናእታ ዎይ ፋ ኦሶ ጋደ አሼዛይ ኦንካ ጼት ኩሸ ኤኮዳ። ማ መና ደኦካ ኤኮዳ። <verse eid="MAT 19:29"/><verse number="30" style="v" sid="MAT 19:30"/>ዝን ጋምታይ ቲንታይ ጉይታ፥ ማ ጉይታይ ቲንታ» ማቃዳ ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">19:30 </char><char style="xt" closed="false"><ref loc="MAT 20:16">ማቶ. 20:16</ref>፤ <ref loc="LUK 13:30">ሉቃ. 13:30</ref></char></note><verse eid="MAT 19:30"/></para>
  <chapter eid="MAT 19"/>
  <chapter number="20" style="c" sid="MAT 20"/>
  <para style="s1">ዎይነ ጋንጨ ኦዝ ኦሶ አስታይ ኣዝሶ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1"/>«ጾስ ካተትይ ፋ ዎይነ ጋንጨ ኦሶ አስታ ኦስሶዳይስ ዎንታ ጉራ ከዜዝ ጋደ ጎዳ ኣዝዛ። <verse eid="MAT 20:1"/><verse number="2" style="v" sid="MAT 20:2"/>ኤ የ ኦሶ አስታይስ ፐቲ ጋላስስ ፐቲ ዲናረ<note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="fqa" closed="false">ፐቲ ዲናረ፦ </char><char style="ft" closed="false">ፐቲ አሲ ፐቲ ጋላስ ኦ ፔዢ ኤክዛ ሚሸ።</char></note> ጋቾዳይስ ኡንታር ጊጊ፥ ኡንታን ፋ ዎይነ ጋንጨ ዳኬዛ።<verse eid="MAT 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3"/>«ማ ዎንታፕ ሀይ ሳተ ማቆዳር ከዚ ኦሶ ብን ጋበል አፋ ኤቄዝ ሀራ አስታካ ደንጌዛ። <verse eid="MAT 20:3"/><verse number="4" style="v" sid="MAT 20:4"/>ኤ ኡንትኮ፥ ‹ይንትካ ታ ዎይነ ጋንጨ Ꮊንጊ ኦይታ፥ ታ ይንትስ ቤዝዛ ዳሞዘ ጋቾዳ› ዬጌዛ። <verse eid="MAT 20:4"/><verse number="5" style="v" sid="MAT 20:5"/>ኡንትካ Ꮊንጌዛ። ማካ ኤ ኡሱፑን ሳተራኔ ኡዱፉን ሳተር ከዚ Ꮊይ ጋርክ ኦዛ። <verse eid="MAT 20:5"/><verse number="6" style="v" sid="MAT 20:6"/>ታጶ ፐቲ ሳተ ማቅን ኤ ከሳዳር Ꮊንክታ ኤቄዝታ ደንጊ፥ ‹ይ ኦሶ ኦካ ጋላስ ሙዳ Ꮊይዳ አብስ ኤቂ ፔዤኔ?› ዬጌዛ።<verse eid="MAT 20:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7"/>«ኡ ማሂ፥ ‹ኑና ኦስስዛ አሲ ቤዝ ግሾስ› ዬጌዛ።</para>
  <para style="p" vid="MAT 20:7">«ኤዚ፥ ‹ይንትካ ታ ዎይነ ጋንጨ Ꮊንጊ ኦይታ› ዬጌዛ።<verse eid="MAT 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8"/>«ሳአ ኦማን፥ ዎይነ ጎዳይ ኦሶ አስታይ ሀላቃይኮ፥ ‹ኦሶ አስታ ጼጊ ጉየፕ ኦሶ ገለዝታይፕ አይኪ ቲና ገሌዝታ ሄሎዳይስ ኡንትስ ዳሞዘ ጋቾባ› ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">20:8 </char><char style="xt" closed="false"><ref loc="LEV 19:13">ለዊ. 19:13</ref>፤ <ref loc="DEU 24:15">ናምእ. 24:15</ref></char></note> <verse eid="MAT 20:8"/><verse number="9" style="v" sid="MAT 20:9"/>ታጶ ፐቲ ሳተር ኦሶ አይኬዝታይ ይኢ፥ ኦማር ኦማር ፐቲ ፐቲ ድናረ ኤኬዛ። <verse eid="MAT 20:9"/><verse number="10" style="v" sid="MAT 20:10"/>ቲና ኦሶ አይኬዝታይ ይኢ፥ ፓስ ጋመ እንግንቶዳ ግ ቆፔዛ። ዝን ኡንትካ ኦማር ኦማር ፐቲ ፐቲ ድናረ ኤኬዛ። <verse eid="MAT 20:10"/><verse number="11" style="v" sid="MAT 20:11"/>ፋ ሚሻ ኤኪ ማቂ ጋደ ጎዳይል አፋ ኦሌዛ። <verse eid="MAT 20:11"/><verse number="12" style="v" sid="MAT 20:12"/>‹Ꮊይትታይ ጉየፕ ይኢ ፐቲ ሳተ ኣዳ ኦዛ። ዝን ጋላስ ሙዳ አዋ ምሻር ዳቡሪ ፔዤዝ ኑር ኡንቲ ዋይዚ ፐቶ ማቆደ› ዬጌዛ።<verse eid="MAT 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13"/>«ዎይኔ ቱኬዝ ጎዳይ ኦሶ አስታይፕ ፐታይኮ፥ ‹ታ እሻዮ፥ ታኒ ነና ቆሄካያ፤ ነ ታር ጊግንቴዛይ ፐቲ ዲናረስ ባሳ? <verse eid="MAT 20:13"/><verse number="14" style="v" sid="MAT 20:14"/>ነ ግሽቶ ኤኪ ነ ካራ ቅቶባ። ታ ኦማ የኤዛይስካ ኔሳይ ጋርክ እማዳይስ ኮይዛ። <verse eid="MAT 20:14"/><verse number="15" style="v" sid="MAT 20:15"/>ታኒ ታ ሚሻይር ኮዬዝ ባዝ ኦዳይስ ታስ ማዉተ ባሳ? ዎይ ታኒ ኬሃ ማቄዝ ግሾስ ነና ቅናትስኔ?› ዬጌዛ።<verse eid="MAT 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16"/>«የይ ጋርክ Ꮊተ ጉይታይ፥ ቲናቶዳ ማ ቲንታይ ጉይቶዳ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">20:16 </char><char style="xt" closed="false"><ref loc="MAT 19:30">ማቶ. 19:30</ref>፤ <ref loc="MRK 10:31">ማር. 10:31</ref>፤ <ref loc="LUK 13:30">ሉቃ. 13:30</ref></char></note><verse eid="MAT 20:16"/></para>
  <para style="s1">የሱሳ ፋ Ꮊይቆባ ባጋ ሃይን ኦዴዛ</para>
  <para style="r">(<ref loc="MRK 10:32-34">ማር. 10:32-34</ref>፤ <ref loc="LUK 18:31-34">ሉቃ. 18:31-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17"/>የሱሳ የሩሳላመ Ꮊንግታር፥ ታጶ ናምኢ ታማርታ ዱማ ጋጻ ከስ ኡንትኮ ዬጌዛ፦ <verse eid="MAT 20:17"/><verse number="18" style="v" sid="MAT 20:18"/>«ዬዛኮ፥ ኑኒ Ꮊት የሩሳላመ Ꮊሞል አፋ የዛ። ኤዛይድ አስ ናአይ ቄሰ ሀላቅታይስኔ ህገ አስታማርታይስ ኣ እንግንቶዳ። ኡንትካ ኤዛል አፋ Ꮊይቆ ፕርደ ፕርዶዳ። <verse eid="MAT 20:18"/><verse number="19" style="v" sid="MAT 20:19"/>ኤዛ አይሁደ ባ ዎያስ ኣ እማዳ። ኡንቲ ኤዛ ካዉሾዳ፥ አላንጎዳ፥ ኤዛ ማዝቃለል አፋካ ሶቶዳ። ዝን ኤ ሃይን ጋላስ Ꮊይቆፕ ደንዶዳ» ዬጌዛ።<verse eid="MAT 20:19"/></para>
  <para style="s1">ዛብዶሳ ናእታይ እንዳቲ ዎሳ</para>
  <para style="r">(<ref loc="MRK 10:35-45">ማር. 10:35-45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20"/>የ ዎደ ዛብዶሳ ማቻት ፋ ናምኢ ራ ናእታይር የሱሳኮ ይኢ፥ ኤ ቲናይድ ቡንቂቲ ፐትባዝ ኤዛ ዎሴዛ።<verse eid="MAT 20:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21"/>የሱሳ እዝኮ፥ «ነ አብ ኮዬ?» ዬጌዛ።</para>
  <para style="p" vid="MAT 20:21">እዛ ማሂ፥ «ነ ካተትይድ Ꮊ ታ ናምኢ ናእታይፕ ፐታይ ኔስ ኡሻቻ ፐታይ ነ ሀድርሳ በቶ ጎየ!» ዬጌዛ።<verse eid="MAT 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22"/>ዝን የሱሳ ማሂ፥ «ይ አብ ዎስዛኮ ኤሮያ፤ ታኒ ኡዦዳይስ የዝ መቶ ጹአ ኡዦዳይስ ዳንዳእኔ?» ዬጌዛ።</para>
  <para style="p" vid="MAT 20:22">ኡንትካ፥ «ኤ ኑ ዳንዳእዛ» ዬጌዛ።<verse eid="MAT 20:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23"/>የሱሳ፥ «ቱማ ታ ኡዦዳይስ የዝ ጹአይፐ ይንቲ ኡዦዳ። ዝን ታ ኡሻቻኔ ሀድርሳ በቶድታና ዶሬዛይ ታና ባያ። የ አቃይ እንግንትዛይ፥ ታ አዳይ እማዳይስ ጊግሴዝ አስታይሲ» ዬጌዛ።<verse eid="MAT 20:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24"/>አቴዝ ታጲ ኤ ታማርታይ የያ ስኢ ናምኢ እሽታይል አፋ ካጭንቴዛ። <verse eid="MAT 20:24"/><verse number="25" style="v" sid="MAT 20:25"/>ዝን የሱሳ ኡንታን ኡብታ ጼጊ Ꮊይ ጋርክ ዬጌዛ። «አይሁደ ባ አሳ አቅስዝታይ ፋ አሳል አፋ ጎዳትዛነ ኡንታን ካልዝታይ ዎልቃር አቅስዛና ይ ኤርዛ። <verse eid="MAT 20:25"/><verse number="26" style="v" sid="MAT 20:26"/>ዝን ይ ጋንጨ Ꮊይ ጋርክ ማቅፐ። ይንትፕ ባይራት ኮይዝ ኦንካ ይንትስ አይለ ማቆ።<note caller="-" style="x"><char style="xo" closed="false">20:26-27 </char><char style="xt" closed="false"><ref loc="MAT 23:11">ማቶ. 23:11</ref>፤ <ref loc="MRK 9:35">ማር. 9:35</ref>፤ <ref loc="LUK 22:26">ሉቃ. 22:26</ref></char></note> <verse eid="MAT 20:26"/><verse number="27" style="v" sid="MAT 20:27"/>ይ ጋንጨ ኡባይፕ ኣ ማቆዳይስ ኮይዝ ኦንካ ይንትስ አይለ ማቆዳይስ ቤዝዛ። <verse eid="MAT 20:27"/><verse number="28" style="v" sid="MAT 20:28"/>የይ ጋርከካ፥ አስ ናአይ አስ ማዶዳይስኔ ጋመ አስ ዎዞዳይስ ፋ ሸምፖ እማዳይስ የኤዛፕ አትን አሳር ማድንቶዳይስ የኤካያ» ዬጌዛ።<verse eid="MAT 20:28"/></para>
  <para style="s1">የሱሳ ናምኢ ቶእታ ፓዛ</para>
  <para style="r">(<ref loc="MRK 10:46-52">ማር. 10:46-52</ref>፤ <ref loc="LUK 18:35-43">ሉቃ. 18:35-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29"/>የይፕ ጉየ፥ የሱሳ ፋ ታማርታይር ኢያርኮፕ ከዚ Ꮊማዳር፥ ጋመ አሳይ ኡንታን ካሌዛ። <verse eid="MAT 20:29"/><verse number="30" style="v" sid="MAT 20:30"/>ኦገ ጋጻ በቴዝ ናምኢ ቶእታይ የሱሳ ኤዛይር ኣዛና ስኢ፥ «ጎዳዮ፥ ዳዉተ ናአዮ፥ ኑስ ቃንቶየ» ዬጊ ኡኬዛ። <verse eid="MAT 20:30"/><verse number="31" style="v" sid="MAT 20:31"/>ጋመ አሳይ ኡንታን፥ «ሀይዞይታ» ዬጊ ቆዴዛ። ዝን ኡንቲ፥ «ጎዳዮ፥ ዳዉተ ናአዮ፥ ሀያና ኑና ማሮየ» ግ ጉጂ ኡኬዛ።<verse eid="MAT 20:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32"/>የሱሳ ኤቂ፥ ኡንታን ጼጊ፥ «ታ ይንትስ አብ ኡዶድ ጋርክ ኮይኔ?» ዬጊ ኦይጬዛ።<verse eid="MAT 20:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33"/>ኡንትካ፥ «ጎዳዮ፥ ኑ ኣፋይ በአዳይ ጋርክ ኑ ኮይዛ» ዬጌዛ። <verse eid="MAT 20:33"/><verse number="34" style="v" sid="MAT 20:34"/>የሱሳ ኡንትስ ቃንቲ፥ ኡ ኣፋ ቦቼዛ። ኤልሲ ኡ ኣፋይ ብእን፤ ኡ ኤዛ ካሊ ቅቴዛ።<verse eid="MAT 20:34"/></para>
  <chapter eid="MAT 20"/>
  <chapter number="21" style="c" sid="MAT 21"/>
  <para style="s1">የሱሳ ግታ ቦንቾር የሩሳላመ ገሌዛ</para>
  <para style="r">(<ref loc="MRK 11:1-11">ማር. 11:1-11</ref>፤ <ref loc="LUK 19:28-40">ሉቃ. 19:28-40</ref>፤ <ref loc="JHN 12:12-19">ዋን. 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1"/>የሱሳራ ኤ ታማርታይራ የሩሳላመ ኡኪ፥ ደብረ ዛይተ አምባል አፋ የዝ ቤተፋገ ግዝ ሄራ ሄልታር፥ የሱሳ ፋ ታማርታይፕ ናምእታ ፓፕ ቲና ኪቴዛ፦ <verse eid="MAT 21:1"/><verse number="2" style="v" sid="MAT 21:2"/>«ይ ቲና የዝ ሄራ Ꮊንጎይታ። ኤዛይድ ፐቲ ሀረ አቻ የዛኖ እ ናአይራ ይ ኤልሲ ደማዳ። ኡንታን ብሊ Ꮊና ኤኪ የኦይታ። <verse eid="MAT 21:2"/><verse number="3" style="v" sid="MAT 21:3"/>ኦንካ ይንታን ኦይጭኮ፥ ‹ጎዳይ ኡንታን ኮይዛ› ዬጎይታ። ኤ ኡንታን ኤልሲ ዳኮዳ» ዬጌዛ። <verse eid="MAT 21:3"/><verse number="4" style="v" sid="MAT 21:4"/>ናባይ፥<verse eid="MAT 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5"/>«ጽዮነ ካታማ፥</para>
  <para style="q2" vid="MAT 21:5">‹ይኬ፥ ነ ካታይ አሽከ ማቂ፥ ሀረል አፋኔ</para>
  <para style="q2" vid="MAT 21:5">ሀረ ናአል አፋ በቲ፥ ኔኮ ይእዛ› ዬጎይታ»</para>
  <para style="m" vid="MAT 21:5">ዬጊ ጻፌዛይ ፖልንቶድ ጋርክ የይ ሀኔዛ።<note caller="-" style="x"><char style="xo" closed="false">21:5 </char><char style="xt" closed="false"><ref loc="ZEC 9:9">ዛክ. 9:9</ref></char></note><verse eid="MAT 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6"/>ኤ ታማርታይ Ꮊንጊ የሱሳ ኡንታን አዛዜዛይ ጋርክ ኦዛ። <verse eid="MAT 21:6"/><verse number="7" style="v" sid="MAT 21:7"/>ሀርቶኔ ሀረ ናአ ክኢ አፋር ማኤዝ ፋ አፍላ ኡ ዞካይል ኦሌዛ። የሱሳ አፍላይል አፋ በቴዛ። <verse eid="MAT 21:7"/><verse number="8" style="v" sid="MAT 21:8"/>ዎያይ ፋ አፍላ ኦገል ሂጼዛ። Ꮊንክታይ ሀራታ ሻቂ ኦገል ኦሌዛ። <verse eid="MAT 21:8"/><verse number="9" style="v" sid="MAT 21:9"/>የሱሳፕ ቲናር የዝታይኔ ኤዛፕ ጉየር ካልዛ ዎይታይ፥</para>
  <para style="q1" vid="MAT 21:9">«ሆሳና!<note caller="+" style="f"><char style="fr" closed="false">21:9 </char><char style="fqa" closed="false">ሆሳና፦ </char><char style="ft" closed="false">እብራይስጸ ዶናር ሆሳና ጉሳይ «ኑና አሾባ ጉሲ።» ማ አሳይ ጾስ ጋላቶዳይስ ማድንትዛ ቃላ።</char></note> ዳዉተ ናአይ ጋላትንቶ!</para>
  <para style="q2" vid="MAT 21:9">ጎዳይ ሱንር ይእዛይ አንጅንቴዛያ!</para>
  <para style="q1" vid="MAT 21:9">ቦንቾ ኡባፕ ቃ ሳሎ ጾሳይስ ማቆ!»</para>
  <para style="m" vid="MAT 21:9">ዬጊ ኡኬዛ።<note caller="-" style="x"><char style="xo" closed="false">21:9 </char><char style="xt" closed="false"><ref loc="PSA 118:25">ማዝ. 118:25</ref></char></note><verse eid="MAT 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10"/>የሱሳ የሩሳላመ ካታማ ገሌዝ ዎደ የ ካታማ የዝ አስ ኡቢታይ፥ «Ꮊይ ኦኖ?» ዬጊ ሻርክሻርኬዛ።<verse eid="MAT 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11"/>አሳይ፥ «Ꮊይ ጋልላ ቢታ የዝ ናዝረተ ካታማፕ የኤዝ ናበ የሱሳበ» ዬጌዛ።<verse eid="MAT 21:11"/></para>
  <para style="s1">የሱሳ ጾስ ኬ ገሌዛ</para>
  <para style="r">(<ref loc="MRK 11:15-19">ማር. 11:15-19</ref>፤ <ref loc="LUK 19:45-48">ሉቃ. 19:45-48</ref>፤ <ref loc="JHN 2:13-22">ዋን. 2:13-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12"/>የሱሳ ጾስ ኬ ገሊ፥ ኤዛይድ ባይዝዝታኔ ዎንግዝታ ኡባ ባይኢ ባለ ከሴዛ። ሚሸ ላምዝታይ ጻርጴዝታኔ ሆልታ ባይዝዝታይ ኦይዲታ ሽሪ ኦሌዛ። <verse eid="MAT 21:12"/><verse number="13" style="v" sid="MAT 21:13"/>ኤዝካ ኡንትኮ፥ «ጾስ ቃላይድ፥ ‹ታ ኬይ ጾስ ዎስዛ ኬ ግንትንቶዳ› ዬግንቲ ጻፍንቴዛ። ዝን ይ ፓንታይ ቆስንትዝ ኮምኦ ኡዴዛ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">21:13 </char><char style="xt" closed="false"><ref loc="ISA 56:7">ኢሳ. 56:7</ref>፤ <ref loc="JER 7:11">ኤርም. 7:11</ref></char></note><verse eid="MAT 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14"/>የሱሳ ጾስ ካራ ጋንጨ የዝን ቶእታይኔ ጉንዴዝታይ ኤዝኮ ይእን ኡንታን ፓዛ። <verse eid="MAT 21:14"/><verse number="15" style="v" sid="MAT 21:15"/>ዝን ቄሰ ሀላቅታይኔ ህገ አስታማርታይ የሱሳ ኦዝ ማላትታ ብእዝታይኔ ጽቃ ናእታይ ጾስ ኬ ጋንጨ፥ «ዳዉተ ናአይ፥ ጋላትንቶ» ዬጊ ኡክዛና ስኢ ካጭንቴዛ። <verse eid="MAT 21:15"/><verse number="16" style="v" sid="MAT 21:16"/>ኡ የሱሳኮ፥ «Ꮊይትታይ ግዛ ነ ስእኔ?» ዬጌዛ።</para>
  <para style="p" vid="MAT 21:16">የሱሳ፥ «ኤ ስእዛ፥ ጾስ ቃላይድ፥ ‹ዱደ ናእታይ ዶናኔ ንግዝ ናእታይ ዶና ጋላታ ኩንዛ› ዬግንቲ ጻፍንቴዛና ይ ናባበካሳ?» ዬጌዛ። <verse eid="MAT 21:16"/><verse number="17" style="v" sid="MAT 21:17"/>ኡንታን እዘ አሺ ብታና ካታማ Ꮊንጊ አቄዛ።<verse eid="MAT 21:17"/></para>
  <para style="s1">ጎዳይ ባዴዝ ባላሰ ምቶ</para>
  <para style="r">(<ref loc="MRK 11:12-14">ማር. 11:12-14</ref>፥ <ref loc="MRK 11:20-24">20-24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18"/>የሱሳ ዎንታ ጉራ ካታማ ማቂ ይእታር ናይንቴዛ። <verse eid="MAT 21:18"/><verse number="19" style="v" sid="MAT 21:19"/>ኦገ ጋጻ ፐቲ ባላሰ ምቶ ብኢ እዝኮ Ꮊንጌዛ። ዝን ሀየፕ አትን ሀራ አብካ ደንገካያ። የይ ግሾስ፥ እዞ፥ «Ꮊንፕ መናስ ኔፕ ኣፈ በንትፐ!» ዬጌዛ። የ ባላሰ ምታ እዝር መሌዛ።<verse eid="MAT 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20"/>ኤ ታማርታይ የያ ብኢ፥ «Ꮊ ባላሳት ዋይዚ ኤልሲ መላረ?» ዬጊ ማላባዝ ጌዛ።<verse eid="MAT 21:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21"/>የሱሳ ማሂ፥ «ታኒ ይንትስ ቱማ ኦድዛ፤ ይንትስ አማኖ ዬዛኮ፥ ማ ይ ስምጽኮ ባላሰል አፋ ታኒ ኦዛን ጋርክ ኣዳ ኦሚ፥ ዝን ‹Ꮊ አምባ ሾድንቲ አባ ጋንጨ ዎባ› ዬግኮ ይንትስ ሀኖዳ።<note caller="-" style="x"><char style="xo" closed="false">21:21 </char><char style="xt" closed="false"><ref loc="MAT 17:20">ማቶ. 17:20</ref>፤ <ref loc="1CO 13:2">1ቆሮ. 13:2</ref></char></note> <verse eid="MAT 21:21"/><verse number="22" style="v" sid="MAT 21:22"/>አማኒ ይ ዎስዛ ባዝ አባባዝ ማቅኮካ ይ ኤኮዳ» ዬጌዛ። <figure style="fig" alt="Fig tree" file="LB00085B.tif" size="span" ref="21:22">ባላሰ ም</figure><verse eid="MAT 21:22"/></para>
  <para style="s1">የሱሳ ማዉታይ ኦይጭንቴዛ</para>
  <para style="r">(<ref loc="MRK 11:27-33">ማር. 11:27-33</ref>፤ <ref loc="LUK 20:1-8">ሉቃ. 20:1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23"/>የሱሳ ጾሳ ኬ ገሊ ታማርሶዳር፥ ቄሰ ሀላቅታይኔ አይሁደ ጭምታይ ኤዝኮ ይኢ፥ «ኔኒ Ꮊያ ኡባ አባ ማዉተር ኦ? ኔስ Ꮊ ማዉታ እንጌዛይ ኦኖ?» ዬጊ ኦይጬዛ።<verse eid="MAT 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24"/>የሱሳ ኡንትኮ፥ «ታንካ ይንታን ፐትባዝ ኦይጭዛ፤ ይ ታስ እዞ ማህኮ፥ ታኒ አባ ማዉተር ኦዛኮ ይንትስ ኦዶዳ። <verse eid="MAT 21:24"/><verse number="25" style="v" sid="MAT 21:25"/>ዋንሳ ጻማቆድ ጋርክ ማዉታይ አናፕ እንግንቴኔ? ጾሳፐኔ አሳፔ?» ዬጌዛ።</para>
  <para style="p" vid="MAT 21:25">ኡንቲ ዎል ጋንጨ ቶቢ፥ «ኑኒ፥ ‹ጾሳፕ› ጊኮ፥ ኤ ኑና፥ ‹የዝን አብስ አማነካሳ?› ጎዳ። <verse eid="MAT 21:25"/><verse number="26" style="v" sid="MAT 21:26"/>ኑኒ፥ ‹አሳፔ› ጊኮ፥ አሲ ኡባይ ዋንሳና ናበ ኡዲ ብእዛ ግሾስ ዎያይ ኑና ያሽዛ» ዬጌዛ። <verse eid="MAT 21:26"/><verse number="27" style="v" sid="MAT 21:27"/>የይ ግሾስ፥ «ኑኒ ኤሮያ» ዬጊ ማሄዛ።</para>
  <para style="p" vid="MAT 21:27">ኤዝካ፥ «ይኬ፥ ታንካ Ꮊያ አባ ማዉተር ኦዛኮ ይንትስ ኦዳሚ» ዬጌዛ።<verse eid="MAT 21:27"/></para>
  <para style="s1">ናምኢ ናእታይ ኣዝሶ</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28"/>«የሱሳ ማቅካ Ꮊይ ጋርክ ዬጌዛ፦ ፐቲ አይስ ናምኢ ራ ናእታይ የዛ። የ አይ ባይራ ናአይኮ Ꮊንጊ፥ ‹ታ ናአዮ፥ Ꮊይኖ ዎይነ ጋንጨ Ꮊንጊ Ꮊንቶባ› ዬጌዛ። <verse eid="MAT 21:28"/><verse number="29" style="v" sid="MAT 21:29"/>ናአይ ማሂ፥ ‹ኢእኖ Ꮊንጋሚ› ዬጌዛ። ዝን ጉየፐ ፋ ዎዝናር ቆፒ ኤኪ Ꮊንቶዳይስ ቅቴዛ። <verse eid="MAT 21:29"/><verse number="30" style="v" sid="MAT 21:30"/>አዳይ ፋ ጉየ ናአይኮ Ꮊንጊ፥ ፋ ባይራ ናአይኮ ጌዛይ ጋርክ አዛዜዛ። ኤዝካ፥ ‹ኤሮ፥ ታ አዳዮ› ዬጌዛ። ዝን Ꮊንገካያ። <verse eid="MAT 21:30"/><verse number="31" style="v" sid="MAT 21:31"/>Ꮊ ናምኢ ናእታይፕ ፋ አዳይስ አዛዝንቴዛይ ኣያ?» ዬጌዛ።</para>
  <para style="p" vid="MAT 21:31">ኡንትካ፥ «ባይራ» ዬጌዛ።</para>
  <para style="p" vid="MAT 21:31">የሱሳ ኡንትኮ፥ «ታ ይንትስ ቱማ ኦድዛ፤ ቃራጸ ጋችሽዝታይኔ ላምዝታይ ይንትፕ ቲናቲ ጾስ ካተት ገሎዳ። <verse eid="MAT 21:31"/><verse number="32" style="v" sid="MAT 21:32"/>ጻማቅዛ ዋንሳ ሉሎ ኦገ ታማርስታር ይእን ኤ ግዛና ይ አማነካያ። ዝን ቃራጸ ጋችስዝታይኔ ላምዝታይ አማኔዛ። ይ ሀራ አቶዝን፥ ኡንታን ብእካ ይ ናጋራይፕ ማቂ አማነካያ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">21:32 </char><char style="xt" closed="false"><ref loc="LUK 3:12">ሉቃ. 3:12</ref>፤ <ref loc="LUK 7:29-30">7:29-30</ref></char></note><verse eid="MAT 21:32"/></para>
  <para style="s1">ዎይነ ቱኪዝ አስታይ ኣዝሶ</para>
  <para style="r">(<ref loc="MRK 12:1-12">ማር. 12:1-12</ref>፤ <ref loc="LUK 20:9-19">ሉቃ. 20:9-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33"/>ማካ የሱሳ Ꮊይ ጋርክ ዬጌዛ፤ «ሀራ ኣዝሶ ስኦይታ፥ ዎይነ ቱኬዝ ፐቲ አይ የዛ። የ ዎይነ ጋጻና ጋሴዛ። ዎይነ ቡልዝ ኦላካ ቦኬዛ። ዎይና ናጎዳይስ ሻኮካ ኮቼዛ። የይፕ ጉየ፥ ጋዳ ማታየ እንጊ ሀራ ጋደ ቅቴዛ።<note caller="-" style="x"><char style="xo" closed="false">21:33 </char><char style="xt" closed="false"><ref loc="ISA 5:1-2">ኢሳ. 5:1-2</ref></char></note> <verse eid="MAT 21:33"/><verse number="34" style="v" sid="MAT 21:34"/>ዎይነ አፋ ማጽዛ ዎደ ሄልን ፋና ሄልዛ ባጋ ኤኪ የኦድ ጋርክ ፋ አይልታ ኡንትኮ ዳኬዛ። <verse eid="MAT 21:34"/><verse number="35" style="v" sid="MAT 21:35"/>ማታየ ኤኬዝታይ ኤ አይልታ አይኪ ፐታ Ꮊዛ፥ Ꮊንካ ዎዛ ማ አቴዛና ሹቻር ሾጬዛ። <verse eid="MAT 21:35"/><verse number="36" style="v" sid="MAT 21:36"/>ዎይነ አታክልተ ጎዳይ ካሴስታይፕ ጋመ ሀራ አይልታ ኪቴዛ። ማታየ ኤኬዝታይ ኡንታል ጉጅካ Ꮊንክታይል አፋ ኦዛይ ጋርክ ኦዛ። <verse eid="MAT 21:36"/><verse number="37" style="v" sid="MAT 21:37"/>ዉርስል ኤ፥ ‹ታ ናአ ኡ ቦንቾዳ!› ዬጊ ፋ ናአ ኡንትኮ ኪቴዛ።<verse eid="MAT 21:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 21:38"/>«ዝን ማታየ ኤኬዝታይ ናአ ብኢ ዎል ጋንጨ ‹ጋዳ ላቶዳይ Ꮊያ፥ ኤዛ ዎ ጋዳ ኑኒ ኤኮዳ!› ዬጌዛ። <verse eid="MAT 21:38"/><verse number="39" style="v" sid="MAT 21:39"/>ናአ አይኪ ዎይነ ጋንጨፐ ጋጻ ከሲ ዎዛ።<verse eid="MAT 21:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40"/>«ይኬ፥ ዎይነ አታክልተ ጎዳይ ይኢ የ ማታየ ኤኬዝታ ዋይሳዴ?» ዬጊ ኦይጬዛ።<verse eid="MAT 21:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41"/>ኡ ማሂ፥ «ኤ የ ኢታ አሳ ኢታ ዎ ዎ፥ ዎይናይ ካእዝ ዎደ ኤዛ ሄልዝ ባጋ ዎደር ዎደር እንግዛ ሀራ አስስ እማዳ» ዬጌዛ።<verse eid="MAT 21:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42"/>የሱሳ ማሂ ኡንትኮ፥ ጾሳ ቃላይ፥</para>
  <para style="q1" vid="MAT 21:42">«‹ግምቢዝታይ ቦሪ እጼዝ ሹቻይ፥</para>
  <para style="q2" vid="MAT 21:42">ኬ ሙመር ቶክዛ ክርክሮ ጋርክ፥</para>
  <para style="q2" vid="MAT 21:42">ኡባፕ ኣዝ ሹች ማቄዛ።</para>
  <para style="q1" vid="MAT 21:42">Ꮊይ ጎዳይ ኦዝ ባዝ፤</para>
  <para style="q2" vid="MAT 21:42">ኑ ኣፋይስካ ማላ ባዝ›</para>
  <para style="m" vid="MAT 21:42">ዬግንቲ ጻፍንቴዛና ይ ናባበካሳ?<note caller="-" style="x"><char style="xo" closed="false">21:42 </char><char style="xt" closed="false"><ref loc="PSA 118:22">ማዝ. 118:22</ref></char></note><verse eid="MAT 21:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43"/>«የይ ግሾስ፥ ታ ይንትስ ኦድዛ፤ ጾሳ ካተትይ ይንትፕ ኤክንቲ ሎኦ ኣፈ ኣፍዝ አስታይስ እንግንቶዳ። <verse eid="MAT 21:43"/><verse number="44" style="v" sid="MAT 21:44"/>[Ꮊ ሹቻይል አፋ ዎዝ ኡቢታይ መቅቶዳ። ማ የ ሹቻይ ኤዛል አፋ ዎዝ አይካ ጋጭንቶዳ]»<note caller="+" style="f"><char style="fr" closed="false">21:44 </char><char style="ft" closed="false">ፐቲ ፐቲ ብኒ ማጻፍታይ ታይቦ 44 ጉጅዛ (ሉቃ። 20:18) ቦኦይታ።</char></note> ዬጌዛ።<verse eid="MAT 21:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45"/>ቄሰ ሀላቅታይኔ ፈርሳውታይ የሱሳ ኦዴዝ ኣዝሶ ፋና ኦዴዛና ኤሬዛ። <verse eid="MAT 21:45"/><verse number="46" style="v" sid="MAT 21:46"/>ኡ የሱሳ አይኮዳይስ ኮዬዛ፥ ዝን አሳይ የሱሳ ናበ ኡዲ ብእዛ ግሾስ አሳይስ ያሽቴዛ።<verse eid="MAT 21:46"/></para>
  <chapter eid="MAT 21"/>
  <chapter number="22" style="c" sid="MAT 22"/>
  <para style="s1">ቦስ ጼስ ኣዝሶ</para>
  <para style="r">(<ref loc="LUK 14:15-24">ሉቃ. 14:15-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1"/>የሱሳ Ꮊተካ አሳይስ Ꮊይ ጋርክ ዬጊ ኣዝሶ ኦዴዛ። <verse eid="MAT 22:1"/><verse number="2" style="v" sid="MAT 22:2"/>«ሳሎ ካተትይ ፋ ናአይስ ቦስ ማኬዝ ካታ ኣዝዛ። <verse eid="MAT 22:2"/><verse number="3" style="v" sid="MAT 22:3"/>የ ካታይ ቦስ የኦዳይ ጋርክ ኦዴዝ አሳ ጼጎዳይስ ፋ አይልታ ኪቴዛ። ዝን አሳይ የኦዳይስ ኮየካያ። <verse eid="MAT 22:3"/><verse number="4" style="v" sid="MAT 22:4"/>ማ ሀራ አይልታ ጼጊ፥ ጼግንቴዝ አስታይኮ Ꮊንጊ፥ ‹ታኒ ታ ሳንግታኔ ሞዝ መህታ ሹኬዛ፤ ኡባ ባዝ ጊጌዛ። ታ ቦሳይኮ የኦይታ ዬጎይታ› ዬጊ ኪቴዛ። <verse eid="MAT 22:4"/><verse number="5" style="v" sid="MAT 22:5"/>ዝን ጼግንቴዝታይ ጼሳ እጺ፥ ፋ Ꮊንታስ Ꮊንታስ ቅቴዛ። ፐታይ ፋ ዎታስ፥ Ꮊንካይ ፋ ዛልኤስ ቅቴዛ። <verse eid="MAT 22:5"/><verse number="6" style="v" sid="MAT 22:6"/>Ꮊንክታይ ማ ካታይ አይልታ አይኪ፥ ካዉሽሽ Ꮊ ዎዛ።<verse eid="MAT 22:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 22:7"/>«ካታይ ኢታ ሸንቲ፥ ፋ ዎታዳርታ ዳኪ ሸምፖ ዎዝታ ዎሴዛ፥ ኡ ካታምቶካ ጹጌዛ። <verse eid="MAT 22:7"/><verse number="8" style="v" sid="MAT 22:8"/>የይፕ ጉየ፥ ፋ አይልታይኮ፥ ‹ቦሳይ ጊጌዛ፥ ዝን ጼግንቴዝታይ ቦሳይስ ቤዝዛ አስታ ባያ። <verse eid="MAT 22:8"/><verse number="9" style="v" sid="MAT 22:9"/>የይ ግሾስ፥ ዳሞ ጎሳ አይኪ Ꮊንጊ፥ ደንጌዝ አስ ኡብታ ቦሳ የኦድ ጋርክ ጼጎይታ› ዬጌዛ። <verse eid="MAT 22:9"/><verse number="10" style="v" sid="MAT 22:10"/>አይልታይ ኦገል ከዚ ፋ ደንጌዝ አስ ኡባ ሎእታኔ ኢትታ ክኢ ቦሳ ሻቃራ ገልሲ ኩንዛ።<verse eid="MAT 22:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11"/>«ዝን ካታይ ሙንታ ማዳይስ በቴዝ አሳ በአዳይስ ገሎዳር ቦስ አፍላ ማኤካ ፐቲ አስ ደንጌዛ። <verse eid="MAT 22:11"/><verse number="12" style="v" sid="MAT 22:12"/>ኤዝኮ፥ ‹ናት ነ ቦስ አፍላ ማኤካዛር ዋይዚ Ꮊይዳ ገሌኔ?› ዬጌዛ። ዝን አይ ስኤ አቴዛ።<verse eid="MAT 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 22:13"/>«ካታይ ፋ አይልታይኮ፥ ‹Ꮊ አይስ ኩሻኔ ቶካ አጪ፥ ባለ ማ ከሲ ኦሎይታ። ኤዛይድ ኤዝስ ዬፎኔ አች ጮንቺ ማቃዳ› ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">22:13 </char><char style="xt" closed="false"><ref loc="MAT 8:12">ማቶ. 8:12</ref>፤ <ref loc="MAT 25:30">25:30</ref>፤ <ref loc="LUK 13:28">ሉቃ. 13:28</ref></char></note><verse eid="MAT 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14"/>«የይ ጋርክ፥ ጾስ ካተትይስ ጼግንቴዝታይ ጋመ ዝን ዶርንቴዝታይ ጽቃ» ዬጌዛ።<verse eid="MAT 22:14"/></para>
  <para style="s1">ጊራ ጋቾ ባጋ</para>
  <para style="r">(<ref loc="MRK 12:13-17">ማር. 12:13-17</ref>፤ <ref loc="LUK 20:20-26">ሉቃ. 20:20-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15"/>የይፕ ጉየ፥ ፈርሳውታይ Ꮊንጊ፥ የሱሳ ዋይዚ ኦዳር አይኮዳዛኮ ቶቤዛ። <verse eid="MAT 22:15"/><verse number="16" style="v" sid="MAT 22:16"/>ፋ ታማርታኔ ሄሮዶሳ ባግታይፕ ፐታ ፐታ ኪቴዛ። ኡንትካ፥ «አስታማራዮ፥ ነ ቱሮ ኦድዛና ኑ ኤርዛ። ኔኒ አሳፕ አስ ሻኪ ኤሮያ፥ አሲ ዋጎዴ ግ አብካ ኦ ኤሮያ፥ ጾስ ኦገ ቱሮራ ታማርስዛ። <verse eid="MAT 22:16"/><verse number="17" style="v" sid="MAT 22:17"/>አን ኑስ ኦዶባ፥ ኑኒ ኦሮመ ካታይስ ጊራ ጊሮዳይስ ቤዝነኔ ቤዞሳ?» ዬጌዛ።<verse eid="MAT 22:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18"/>ዝን የሱሳ ኡ ኢታ ቆፋ ኤሪ፥ «Ꮊ ጩቢታዮ፥ ታና አብስ ፓጬ? <verse eid="MAT 22:18"/><verse number="19" style="v" sid="MAT 22:19"/>ጊራ ጊርዛ ሚሽቶ ታና ቤዞይታ» ዬጌዛ። ኡንትካ ኤዝስ ድናረ ክኢ ቤዜዛ። <verse eid="MAT 22:19"/><verse number="20" style="v" sid="MAT 22:20"/>ኤ፥ «Ꮊ ሱንይኔ ማላይ ኦ ባዞ?» ዬጌዛ።<verse eid="MAT 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21"/>ኡንቲ፥ «ሮመ ካታይሲ» ዬጌዛ።</para>
  <para style="p" vid="MAT 22:21">የሱሳ ኡንትኮ፥ «የዝን፥ ካታይስ ቤዝዛና ካታይስ፥ ጾስስ ቤዝዛና ጾስስ እንጎይታ» ዬጌዛ።<verse eid="MAT 22:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22"/>ኡ የያ ስኢ ማላ ባዝ ግ አሺ ቅቴዛ።<verse eid="MAT 22:22"/></para>
  <para style="s1">Ꮊይቆፕ ደንዶ ባጋ</para>
  <para style="r">(<ref loc="MRK 12:18-27">ማር. 12:18-27</ref>፤ <ref loc="LUK 20:27-40">ሉቃ. 20:27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23"/>የ ጋላስ Ꮊይቆፕ ደንዶ ባያ ዬግዝ ሳዱቃውታይ የሱሳኮ ይኢ፥ ዬጊ ኤዛ ኦይጬዛ።<note caller="-" style="x"><char style="xo" closed="false">22:23 </char><char style="xt" closed="false"><ref loc="ACT 23:8">ሀዋ. ኦ. 23:8</ref></char></note> <verse eid="MAT 22:23"/><verse number="24" style="v" sid="MAT 22:24"/>«አስታማራዮ፥ ‹ሙሰ፥ ፐቲ አሲ ማቾ ኤኪ ናአ የለካዛር Ꮊይቅኮ፥ የ Ꮊይቄዛይስ እሻይ ኤ ማቻቶ ኤኪ፥ ፋ እሻይስ ናአ የሎ› ዬጊ አዛዜዛ።<note caller="-" style="x"><char style="xo" closed="false">22:24 </char><char style="xt" closed="false"><ref loc="DEU 25:5">ናምእ. 25:5</ref></char></note> <verse eid="MAT 22:24"/><verse number="25" style="v" sid="MAT 22:25"/>ኑ ኤርዛ ላፑን እሽታይ የዛ። ባይራይ ማቾ ኤኪ ናአ የለካዛር Ꮊይቄዛ። ኤ ማቻቶ ኤ ካሎ እሻይ ኤኬዛ። <verse eid="MAT 22:25"/><verse number="26" style="v" sid="MAT 22:26"/>የይ ጋርከካ፥ የ አስቶ ኤኬዝ ናምአንይካ፥ ሃይንይካ፥ Ꮊንጊ ላፑንታይ ዉሮድ ጋ ኡቢታይ Ꮊይቄዛ። <verse eid="MAT 22:26"/><verse number="27" style="v" sid="MAT 22:27"/>ኡባፕ ዉርስል የ አስታካ Ꮊይቄዛ። <verse eid="MAT 22:27"/><verse number="28" style="v" sid="MAT 22:28"/>የዝን፥ ላፑንታይ ኡቢታይ እዞ ኤኬዝ ግሾስ Ꮊይቆፕ ደንድዛ ጋላስ፥ የ አስታ ላፑንታይፕ ኣያይስ ማቾ ማቃዴ?» ዬጌዛ።<verse eid="MAT 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29"/>የሱሳ ማሂ፥ «ይ ጾስ ቃላይ ታማርሴዝ ባዝ ዎይ ኤ ዎልቃ ኤሮዋ ግሾስ ባልንትዛ። <verse eid="MAT 22:29"/><verse number="30" style="v" sid="MAT 22:30"/>አሳይ Ꮊይቆፐ ደንድዛ ዎደ ሳሎ የዝ ኪታንችታይ ጋርክ ማቆዳይፕ አትን ኤኮያኔ ገሎያ። <verse eid="MAT 22:30"/><verse number="31" style="v" sid="MAT 22:31"/>ማ Ꮊይቄዝ አሳይ Ꮊይቆፕ ደንዶድ ባዝ ጾስ ይንትስ ኦዴዛና ይ ናባበካሳ? <verse eid="MAT 22:31"/><verse number="32" style="v" sid="MAT 22:32"/>ጾሳይ፥ ‹ታኒ አፍራመ ጾስ፥ እሳቃ ጾስ፥ ያይቆባ ጾስ› ዬጌዛ። የይ ግሾስ፥ ጾሳይ ፓ የዝታይ ጾሳፕ አትን Ꮊይቄዝታይ ጾስ ባያ»<note caller="+" style="f"><char style="fr" closed="false">22:32 </char><char style="fqa" closed="false">ጾሳይ ፓ የዝታይ ጾሳፕ አትን Ꮊይቄዝታይ ጾስ ባያ፦ </char><char style="ft" closed="false">የሱሳ Ꮊ በሳ ኦድዛይ ጾሳይ Ꮊ Ꮊይቄዝ ሃይታይ ጾስ ማቅኮ ኡንቲ ፓ የዛ ዬግንትዛ።</char></note> ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">22:32 </char><char style="xt" closed="false"><ref loc="EXO 3:6">ከስ 3:6</ref></char></note><verse eid="MAT 22:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33"/>ጋመ አሳይ የያ ስኢ፥ ኤ ትምርታ ማላባዝ ጌዛ።<verse eid="MAT 22:33"/></para>
  <para style="s1">ኡባፕ ባይራትዛ ኪታ</para>
  <para style="r">(<ref loc="MRK 12:28-34">ማር. 12:28-34</ref>፤ <ref loc="LUK 10:25-28">ሉቃ. 10:25-28</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34"/>የሱሳ ሳዱቃውታይስ ጎድባዝ ብሴዛና ፈርሳውታይ ስኢ ዎላ ሺቄዛ። <verse eid="MAT 22:34"/><verse number="35" style="v" sid="MAT 22:35"/>ኡ ጋንጨፕ ፐቲ ህገ አስታማራይ የሱሳ ፓጨ ኦይች ኦይጬዛ። <verse eid="MAT 22:35"/><verse number="36" style="v" sid="MAT 22:36"/>«አስታማራዮ፥ ህገ ኡባይፕ ኣዛይ ኣያ?» ዬጊ ኦይጬዛ።<verse eid="MAT 22:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37"/>የሱሳ ማሂ፥ «‹ነ ጎዳ፥ ነ ጾሳ፥ ነ ኩን ዎዝናይፕ፥ ነ ኩን ሸምፖፕ፥ ነ ኩን ቆፋፕ ቃባ።<note caller="-" style="x"><char style="xo" closed="false">22:37 </char><char style="xt" closed="false"><ref loc="DEU 6:5">ናምእ. 6:5</ref></char></note> <verse eid="MAT 22:37"/><verse number="38" style="v" sid="MAT 22:38"/>ኡባፕ ኣዛይኔ ባይራ ኪታይ Ꮊያ። <verse eid="MAT 22:38"/><verse number="39" style="v" sid="MAT 22:39"/>ናምእን ኡባይፕ ኣዝ ኪታይ፥ አስ ኡባ ነ ነና ዶስዛይ ጋርክ ዶሶባ› ዬግዛያ።<note caller="-" style="x"><char style="xo" closed="false">22:39 </char><char style="xt" closed="false"><ref loc="LEV 19:18">ለዊ. 19:18</ref></char></note> <verse eid="MAT 22:39"/><verse number="40" style="v" sid="MAT 22:40"/>ሙሰ ህጋይኔ ናብታይ ትምርታይ ኡባይ Ꮊ ኪትታይል አፋ ካትዛ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">22:40 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">ሉቃ. 10:25-28</ref></char></note><verse eid="MAT 22:40"/></para>
  <para style="s1">ክርስቶሳ ባጋ ኦይጬዝ ኦይች</para>
  <para style="r">(<ref loc="MRK 12:35-37">ማር. 12:35-37</ref>፤ <ref loc="LUK 20:41-44">ሉቃ. 20:41-44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41"/>ፈርሳውታይ ፐትፕ ሺቂ የዝን፥ የሱሳ ኡንታን፥ <verse eid="MAT 22:41"/><verse number="42" style="v" sid="MAT 22:42"/>«ክርስቶሳ ባጋ ይ ዋጌ? ኤ ኦ ናአ?» ዬጊ ኦይጬዛ።</para>
  <para style="p" vid="MAT 22:42">ኡ፥ «ኤ ካታ ዳዉተ ናአ» ዬጊ ማሄዛ።<verse eid="MAT 22:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43"/>የሱሳ ኡንትኮ፥ «የዝን፥ ዳዉተ ጌሻ አያናር ማቂ ዋይዚ ክርስቶሳ፥ ‹ጎዳ› ግ ጼጌ? ዳዉተ ጊታር፥<verse eid="MAT 22:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44"/>« ‹ጾሳይ፥ ታ ጎዳይኮ፥<note caller="+" style="f"><char style="fr" closed="false">22:44 </char><char style="fqa" closed="false">ታ ጎዳይኮ፦ </char><char style="ft" closed="false">Ꮊ በሳይድ ዳውተ ታ ጎዳ ግ ጼግዛይ ክርስቶሳ።</char></note><note caller="-" style="x"><char style="xo" closed="false">22:44 </char><char style="xt" closed="false"><ref loc="PSA 110:1">ማዝ. 110:1</ref></char></note></para>
  <para style="q2" vid="MAT 22:44">ነ ሞርክታ ነ ቶካይስ የዝ አቆ ኦድ ጋ፥</para>
  <para style="q2" vid="MAT 22:44">Ꮊይዳ ታፕ ኡሻች ባጋር<note caller="+" style="f"><char style="fr" closed="false">22:44 </char><char style="fqa" closed="false">ኡሻቻ ባጋር፦ ጉሳይ </char><char style="ft" closed="false">ማኡተኔ ቦንቾ አቆ።</char></note> በቶባ› ጌዛ።<note caller="-" style="x"><char style="xo" closed="false">22:44 </char><char style="xt" closed="false"><ref loc="PSA 110:1">ማዝ. 110:1</ref></char></note><verse eid="MAT 22:44"/></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45"/>ይኬ፥ ዳዉተ ክርስቶሳ ጎዳ ግ ጼግኮ፥ ዋይዚ ክርስቶሳ ዳዉተ ናአ ማቄ?» ዬጌዛ።<verse eid="MAT 22:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 22:46"/>የሱሳስ ፐቲ ቃላ ማሆዳይስ ዳንዳኤዝ አስ ኦንካ ባያ። ማ የ ጋላሳፕ አይኪ ሀራ ኦይች ኦይጮዳይስ ኦንካ ዳንዳኤካያ።<verse eid="MAT 22:46"/></para>
  <chapter eid="MAT 22"/>
  <chapter number="23" style="c" sid="MAT 23"/>
  <para style="s1">ህገ አስታማርታይኔ ፈርሳውታይ ኢታት</para>
  <para style="r">(<ref loc="MRK 12:38-39">ማር. 12:38-39</ref>፤ <ref loc="LUK 11:43-46">ሉቃ. 11:43-46</ref>፤ <ref loc="LUK 20:45-46">20:45-46</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1"/>የይፕ ጉየ፥ የሱሳ ዎያስኔ ፋ ታማርታይስ Ꮊይ ጋርክ ዬጌዛ። <verse eid="MAT 23:1"/><verse number="2" style="v" sid="MAT 23:2"/>«ህገ አስታማርታይኔ ፈርሳወ አሳይ ሙሰ ህገ ታማርሶዳይስ ሙሰ ኦይደላ በቴዛ። <verse eid="MAT 23:2"/><verse number="3" style="v" sid="MAT 23:3"/>የይ ግሾስ፥ ኡ ይንታን አዛዝዛ ባዝ ኡብታ ኦይታኔ ናጎይታ። ዝን ኡ ኦዛይ ጋርከ ኦፓተ። አብስ ጊኮ፥ ኡ ኦድዛይ ጋርክ ኦያ። <verse eid="MAT 23:3"/><verse number="4" style="v" sid="MAT 23:4"/>ኡንቲ ቶክን ደንዶዋ ዴጾ ቶፎ አጪ አስ ቶስዛ። ዝን ፓስ ሀራ አቶዝን፥ የ ቶፋ አሳይ ቶኮዳር ፋ ኩሸ ግልአ ጼራር ቦቾዳይስ ኮዮያ።<verse eid="MAT 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 23:5"/>«ዝን ኡ ፋ ኦሶ ኡባ አሲ በአዳይ ጋርክ ኦዛ። ፋ ስኖላኔ ቀሴል አጭዝ ማጻፈ ጽቅሰ የዝ ኪታፐ ዳልግስዛ፥ ፋ አፍላ ማንቻ አዱስዛ።<note caller="+" style="f"><char style="fr" closed="false">23:5 </char><char style="fqa" closed="false">ስኖላኔ ቀሰል አጭዝ ማጻፈ ... አፍላ ማጫራ አዱስዛ፦ </char><char style="ft" closed="false">የያ ኡ ኦዛይ ጾሳይስ ታ እንግንቴዛያ ግ ፋና ቤሳዳይስ (ናምእ። 15:37-41)።</char></note><note caller="-" style="x"><char style="xo" closed="false">23:5 </char><char style="xt" closed="false"><ref loc="MAT 6:1">ማቶ. 6:1</ref>፤ <ref loc="DEU 6:8">ናምእ. 6:8</ref>፤ <ref loc="NUM 15:38">ታይ. 15:38</ref></char></note> <verse eid="MAT 23:5"/><verse number="6" style="v" sid="MAT 23:6"/>ሞክንትዛ አቆ ቦንቾ አቆኔ አይሁድታይ ዎሳ ኬ ጋመ ሎእዛ ኦይደ ዶስዛ። <verse eid="MAT 23:6"/><verse number="7" style="v" sid="MAT 23:7"/>አሳይ ጋበ ጋንጨ ኡንታን ቦንቾር ሳሮዳናኔ ‹አስታማራዮ› ግ ጼጎድ ጋርክ ኮይዛ።<verse eid="MAT 23:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8"/>«ዝን ይ አስታማራይ ፐታይ ኣዳ ማቄዝ ግሾኔ ይ ኡቢታይ ኤ እሽታ ማቄዝ ግሾስ ‹አስታማራዮ› ግንትንቲ ጼግንትፓተ። <verse eid="MAT 23:8"/><verse number="9" style="v" sid="MAT 23:9"/>ይንትስ ሳሎ ፐቲ አዳይ ኣዳ የዝ ግሾስ Ꮊ ሳአ ኦናካ ‹አዳዮ› ግ ጼግፓተ። <verse eid="MAT 23:9"/><verse number="10" style="v" sid="MAT 23:10"/>ይንትስ ፐቲ ጎዳይ ክርስቶሳ ኣዳ የዛ ግሾስ ‹ጎዳ› ግንትንቲ ጼግንትፓተ። <verse eid="MAT 23:10"/><verse number="11" style="v" sid="MAT 23:11"/>ይንታፕ ኣዛይ ይንትስ አይለ ማቆ።<note caller="-" style="x"><char style="xo" closed="false">23:11 </char><char style="xt" closed="false"><ref loc="MAT 20:26">ማቶ. 20:26</ref></char></note> <verse eid="MAT 23:11"/><verse number="12" style="v" sid="MAT 23:12"/>ፋና ቅ ኡድዝ ኦንካ ካዉዦዳ፤ ፋና ካዉዥስዛ ኦንካ ቂ ጎዳ።<note caller="-" style="x"><char style="xo" closed="false">23:12 </char><char style="xt" closed="false"><ref loc="LUK 14:11">ሉቃ. 14:11</ref>፤ <ref loc="LUK 18:14">18:14</ref></char></note><verse eid="MAT 23:12"/></para>
  <para style="s1">ህገ አስታማርታይኔ ፈርሳወ አስታይ ቦርንቴዛ</para>
  <para style="r">(<ref loc="MRK 12:40">ማር. 12:40</ref>፤ <ref loc="LUK 11:39-42">ሉቃ. 11:39-42</ref>፥ <ref loc="LUK 11:44">44</ref>፥ <ref loc="LUK 11:52">52</ref>፤ <ref loc="LUK 20:47">20:47</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13"/>«ይንታኖ፥ ጩቢታዮ፥ ህገ አስታማርታይኔ ፈርሳዉታዮ፥ አስ ቲና ሳሎ ካተት ጎርድዝታዮ ይንታን አየ። ይንቲ፥ ይ ኡባስ ገላሚ ማ Ꮊንክታካ ገልሳሚ።<verse eid="MAT 23:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 23:14"/>[«ይንታኖ ጩቢታዮ፥ ህገ አስታማርታይኔ፥ ፈርሳዉታዮ፥ አምእታይ ኬ ይ ቦንቂታር፥ አሲ ቦኦ ግ ዎሳ አዱስዛ። የይ ግሾስ፥ ይንታን አየ። ኡባፕ ኣዝ ፕርዳይ ይንታን ናግዛ።]<note caller="+" style="f"><char style="fr" closed="false">23:14 </char><char style="ft" closed="false">ፐቲ ፐቲ ብኒ ማጻፍታይ ታይቦ 14 ጉጅዛ።</char></note><verse eid="MAT 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15"/>«ይንታኖ፥ ጩቢታዮ፥ ህገ አስታማርታይኔ ፈርሳዉታዮ፥ ይንቲ ፐቲ አ አማንዳይስ አባራኔ ሳአር ዩይዛ። ዝን ይ ኤዛ አማንዝ ዎደ የ አ ይንትፕ ኣ ጋናመስ ጊግስዛ ኦሶ ኦዛ ግሾስ ይንታን አየ።<verse eid="MAT 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16"/>«ኦንካ ጾስ ኬ ጫቂኮ አኮካ ባያ። ዝን ጾስ ኬ የዝ ዎርቃ ጫቂኮ፥ የ ጫቃይ ኤዝስ ጎሞዳ ግዝ ቶእታዮ፥ ይ ይ ኡባስ ቶኢ ሀራ አስ ካልዝታዮ፥ ይንታን አየ። <verse eid="MAT 23:16"/><verse number="17" style="v" sid="MAT 23:17"/>ይንታኖ፥ ቦዝታዮ፥ ቶእታዮ፥ ዎርቃይ ኣነኔ? ዎርቃ ጾሳይስ ዱማስዛ ጾስ ኬይ ኣ? <verse eid="MAT 23:17"/><verse number="18" style="v" sid="MAT 23:18"/>ማ ‹ኦንካ ያርሾ ያርሽዛ አቆ ጫቂኮ፥ አኮካ ባያ። ዝን ኦንካ ኤዛል አፋ የዛ ያርሻ ጫቂኮ፥ የ ጫቃይ ኤስ ጎሞዳ› ዬጊ ታማርስዛ። <verse eid="MAT 23:18"/><verse number="19" style="v" sid="MAT 23:19"/>ይንታኖ፥ ቱልታዮ ቶእታዮ፥ ያርሾ ኣነኔ? ያርሾ ጾሳይስ ዱማስዛ አቃይ ኣ? <verse eid="MAT 23:19"/><verse number="20" style="v" sid="MAT 23:20"/>የይ ግሾስ፥ ያርሾ አቃይር ጫቂዛ አይ፥ የ ያርሾ በሳይዳነ ኤዛል አፋ የዛ ኡባባዛል ጫቂዛ። <verse eid="MAT 23:20"/><verse number="21" style="v" sid="MAT 23:21"/>ጾስ ኬ ጫቂዛ አይ፥ የ ጾስ ኬ ግዶኔ ኤዛይድ የዛ ጾሳ ጫቂዛ። <verse eid="MAT 23:21"/><verse number="22" style="v" sid="MAT 23:22"/>ሳሎ ጫቂዛ አይ ጾስ ዙፋናኔ የ ዙፋናይል አፋ በትዝ ጾሳ ጫቂዛ።<note caller="-" style="x"><char style="xo" closed="false">23:22 </char><char style="xt" closed="false"><ref loc="ISA 66:1">ኢሳ. 66:1</ref>፤ <ref loc="MAT 5:34">ማቶ. 5:34</ref></char></note><verse eid="MAT 23:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23"/>«ይንታኖ፥ ጩቢታዮ፥ ህገ አስታማርታዮኔ ፈርሳዉታዮ፥ ይንታን አየ። ይ ካር ጋላፕ፥ ሻሽንቸፐኔ ቦ ጋላፕ አስራታ ከስዛ። ዝን ህጋይድ የዝ ኣ ኮሽዝታ አሽዛ፦ የይካ ሉለ ፕርደ፥ ቃነ ኡባባዛል አማንንቶ። ሀራባዝታካ አሸካዛር Ꮊይትታ ይ ኦዳይስ ቤዝዛ።<note caller="-" style="x"><char style="xo" closed="false">23:23 </char><char style="xt" closed="false"><ref loc="LEV 27:30">ለዊ. 27:30</ref></char></note> <verse eid="MAT 23:23"/><verse number="24" style="v" sid="MAT 23:24"/>ይንትስ ቶኢ ሀራ አስ ካልዝታዮ፥ ይ ኡሻፕ ዉኑኖ ከሲ ግማለ ምትዛ።<verse eid="MAT 23:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25"/>«ይንታኖ፥ ጩቢታዮ፥ ህገ አስታማርታዮኔ ፈርሳወ አሳዮ፥ ይንታን አየ። ይ ሻተስኔ ከረስ አፋ ባጋ ጌሽዛ። ዝን ጋንችጬ ባጋይ ቦንቃኔ ኡዛት ኩሜዛ። <verse eid="MAT 23:25"/><verse number="26" style="v" sid="MAT 23:26"/>ነኖ ቶአ ፈርሳዋዮ፥ ሻተስኔ ከረስ ጋንጫ ቲና ጌሾባ። የይፕ ጉየ፥ አፋ ባጋይካ ጌሺ ማቃዳ።<verse eid="MAT 23:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27"/>«ይንታኖ፥ ጩቢታዮ፥ ህገ አስታማርታዮኔ ፈርሳዉታዮ፥ ይንታን አየ። ይ አፋ ባጋር ቦርሾንቶር ትዥንት ሎእ፥ ጋንጨ መቀኔ ዎቄዝባዝ ኩሜዝ ዱፎ ኣዝዛ።<note caller="-" style="x"><char style="xo" closed="false">23:27 </char><char style="xt" closed="false"><ref loc="ACT 23:3">ሀዋ. ኦ. 23:3</ref></char></note> <verse eid="MAT 23:27"/><verse number="28" style="v" sid="MAT 23:28"/>የይ ጋርከካ፥ አፋ ባጋር አስስ ሎኦ ኣዝዛ። ዝን ይ ጋንጨ ጩቦትኔ ኢታት ኩሜዛ።<verse eid="MAT 23:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29"/>«ይንታኖ፥ ጩቢታዮ፥ ህገ አስታማርታዮኔ ፈርሳውታዮ፥ ይንታን አየ። ይ ናብታይስ ዱፎ ግንቢዛ፥ ማ ጽልታይ ዱፋካ ሎእዛ። <verse eid="MAT 23:29"/><verse number="30" style="v" sid="MAT 23:30"/>ማ ይንቲ፥ ‹ኑኒ ብኒ ኑ አድታይ ዎደ የዛ ባዝ ማቄዛኮ፥ ኡንታር ዎላ ናብታይ ሱ ላላምዝን› ዬግዛ። <verse eid="MAT 23:30"/><verse number="31" style="v" sid="MAT 23:31"/>የይ ግሾስ፥ ይ ናብታ ዎዝ አስ ናእታ ማቄዛና ይንቲ ይ ኡባስ ማርካትዛ። <verse eid="MAT 23:31"/><verse number="32" style="v" sid="MAT 23:32"/>ዬዛኮ፥ ይ አድታይ አይኬዛና ይ ፖሎይታ።<verse eid="MAT 23:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33"/>«Ꮊ ሾሹን፥ ጎፐ ናኡን፥ ይ ጋናመ ፕርዳፕ ዋይዚ አቶዴ?<note caller="-" style="x"><char style="xo" closed="false">23:33 </char><char style="xt" closed="false"><ref loc="MAT 3:7">ማቶ. 3:7</ref>፤ <ref loc="MAT 12:34">12:34</ref>፤ <ref loc="LUK 3:7">ሉቃ. 3:7</ref></char></note> <verse eid="MAT 23:33"/><verse number="34" style="v" sid="MAT 23:34"/>የይ ግሾስ፥ ታ ኦድዛና ስኦይታ፤ ታኒ ናብታ፥ ኤጫ አስታኔ አስታማርታ ይንትኮ ኪቶዳ። ኡንታፕ ፐታ ፐታ ይ ዎዳ ማዝቃለል አፋ ሶቶዳ። ባግታ አይሁድታይ ዎሳ ኬ ገልሲ አላንጎዳ ካታማፕ ካታማ ባይኦዳ። <verse eid="MAT 23:34"/><verse number="35" style="v" sid="MAT 23:35"/>የይ ግሾስ፥ ጽላ አቤላ ዎዝ ዎደፕ አይኪ፥ ጾስ ኬስኔ ያርሾ አቆፕ ግዶ ይ ዎዝ ባራክዩ ናአ ዛክሬሳ ሱ ሄሎዳር Ꮊይቄዝ ጌሽ አስ ኡባይ ግሾስ ይ ሴርንቶዳ።<note caller="-" style="x"><char style="xo" closed="false">23:35 </char><char style="xt" closed="false"><ref loc="GEN 4:8">መ. 4:8</ref>፤ <ref loc="2CH 24:20">2ዜና. 24:20</ref></char></note> <verse eid="MAT 23:35"/><verse number="36" style="v" sid="MAT 23:36"/>ታኒ ይንትስ ቱሮ ኦድዛ፤ ይንትኔ ይ አድታይ ኦዝ ቡታይስ Ꮊ ፕርዳ ኡባይ Ꮊ የለትይል አፋ ሄሎዳ።<verse eid="MAT 23:36"/></para>
  <para style="s1">የሱሳ የሩሳላመስ ዬኬዛ</para>
  <para style="r">(<ref loc="LUK 13:34-35">ሉቃ. 13:34-35</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37"/>«የሩሳላመ፥ የሩሳላመ፥ ናብታ ዎዛኔ! ጾሳይ ኔኮ ኪቴዝታ ሹቻር ሾጭዛኔ! ሹጉላ ፋ ናእታ ፋ ቀፈር ሀጵዛይ ጋርክ ታኒ ነ ናእታ ታ ሺሾዳይስ ኣፑን ቶኬ ኮየኔ! ዝን ታና ነ ካዬዛ። <verse eid="MAT 23:37"/><verse number="38" style="v" sid="MAT 23:38"/>ይኬ፥ ይ ኬይ ካይሳ ማቃዳ።<note caller="-" style="x"><char style="xo" closed="false">23:38 </char><char style="xt" closed="false"><ref loc="JER 22:5">ኤርም. 22:5</ref></char></note> <verse eid="MAT 23:38"/><verse number="39" style="v" sid="MAT 23:39"/>ታኒ ይንትስ ኦድዛ፤ ‹ጎዳይ ሱንር ይእዛይ አንጅንቴዛያ› ይ ጎድ ጋ Ꮊይፕ ጉየ ታና ይ በአሚ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">23:39 </char><char style="xt" closed="false"><ref loc="PSA 118:26">ማዝ. 118:26</ref></char></note><verse eid="MAT 23:39"/></para>
  <chapter eid="MAT 23"/>
  <chapter number="24" style="c" sid="MAT 24"/>
  <para style="s1">የሱሳ ጾስ ኬይ ላልልንቶዳና ቲናቲ ኦዴዛ</para>
  <para style="r">(<ref loc="MRK 13:1-2">ማር. 13:1-2</ref>፤ <ref loc="LUK 21:5-6">ሉቃ. 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1"/>የሱሳ ጾስ ኬፕ ከዚ Ꮊማዳር፥ ኤ ታማርታይ ኤዝኮ ይኢ፥ ጾስ ኬ ግምባ ቤዜዛ። <verse eid="MAT 24:1"/><verse number="2" style="v" sid="MAT 24:2"/>የሱሳ ኡንትኮ ማሂ፥ «ኤ! Ꮊያ ኡብታ ይ ብእኔ? ታኒ ይንትስ ቱሮ ኦድዛ፤ ሹች ሹቻል አፋ ግንቢንቴዛይ ላልንተካዛር አታሚ» ዬጌዛ።<verse eid="MAT 24:2"/></para>
  <para style="s1">ቲናስ ሀኖድ ባዝታ</para>
  <para style="r">(<ref loc="MRK 13:3-13">ማር. 13:3-13</ref>፤ <ref loc="LUK 21:7-19">ሉቃ. 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3"/>የሱሳ ደብረዛይተ አምባል አፋ በቴዝን፥ ኤ ታማርታይ ፋ ኣዳስ ኤዝኮ ይኢ፥ «የይ አይደ ሀኖዳዛኮ ኑስ ኦዶባ። ማ ነ ይእይስኔ ዎደ ዉርስይስ ማላይ አባ?» ዬጊ ኦይጬዛ።<verse eid="MAT 24:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4"/>የሱሳ ማሂ፥ «ይንታን ኦንካ ባልም ጋርክ ናግንቶይታ! <verse eid="MAT 24:4"/><verse number="5" style="v" sid="MAT 24:5"/>አብስ ጊኮ፥ ጋመ አሳይ ታ ሱንር፥ ‹ታኒ ክርስቶሳ› ጊታር ታ ሱንር ይኢ ጋመ አስ ባልዳ። <verse eid="MAT 24:5"/><verse number="6" style="v" sid="MAT 24:6"/>ኦላኔ ኦላ ባዝ ናሾዳር ይ ስኦዳይስ የዛ። የይ ሀኖዳይስ ቤዝዛ ግሾስ ህርግፓተ። ዝን ዉርስይ ሀጋ። <verse eid="MAT 24:6"/><verse number="7" style="v" sid="MAT 24:7"/>ዎያይ ዎያራ፥ ፐቲ ካተትይ ሀራ ካተትር ኦልንቶዳ። ናየኔ ቢታ ኤንኦ ጋመ አቆ ሀኖዳ። <verse eid="MAT 24:7"/><verse number="8" style="v" sid="MAT 24:8"/>የይ ኡባይ የሎ እቅ ዞኬ አይ ጋርከ።<verse eid="MAT 24:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9"/>«የ ዎደ አሳይ ይንታን መቶስ ኣ እማዳ፥ ዎዳ። ታ ሱንይ ግሾስ አሲ ኡባይ ይንታን እጾዳ።<note caller="-" style="x"><char style="xo" closed="false">24:9 </char><char style="xt" closed="false"><ref loc="MAT 10:22">ማቶ. 10:22</ref></char></note> <verse eid="MAT 24:9"/><verse number="10" style="v" sid="MAT 24:10"/>የ ዎደ ጋምታይ አማኖ አሾዳ። ፋ ጋንጨ ፐታይ ፐታ ኣ እማዳ፥ ፐታይ ፐታ እጾዳ። <verse eid="MAT 24:10"/><verse number="11" style="v" sid="MAT 24:11"/>ማ ጋመ ዎርዶ ናብታይ ደንዲ ጋምታ ባልዳ። <verse eid="MAT 24:11"/><verse number="12" style="v" sid="MAT 24:12"/>ዉጨት ጋንግዛይ ግሾስ ጋመ አሳይስ ሲቆ እርጾዳ። <verse eid="MAT 24:12"/><verse number="13" style="v" sid="MAT 24:13"/>ዝን ዉርስ ሄሎዳይስ ጋርዥዛ አይ አቶዳ።<note caller="-" style="x"><char style="xo" closed="false">24:13 </char><char style="xt" closed="false"><ref loc="MAT 10:22">ማቶ. 10:22</ref></char></note> <verse eid="MAT 24:13"/><verse number="14" style="v" sid="MAT 24:14"/>አስ ኡባስ ማርካ ማቃድ ጋርክ ጾስ ካተት ዎንግላይ ቢታ ኡባይል ሳባክንቶዳ። የይፕ ጉየ፥ ዉርስይ የኦዳ።<verse eid="MAT 24:14"/></para>
  <para style="s1">ብጻ ቤዝዝ መቶ</para>
  <para style="r">(<ref loc="MRK 13:14-23">ማር. 13:14-23</ref>፤ <ref loc="LUK 21:20-24">ሉቃ. 21:20-24</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15"/>«የይ ግሾስ፥ ናበ ዳለነ ኦዴዝ ብስዛ ቱና ኦሶ ጌሽ አቆ ኤቄዛና ይ በአዳ።<note caller="-" style="x"><char style="xo" closed="false">24:15 </char><char style="xt" closed="false"><ref loc="DEU 9:27">ናምእ. 9:27</ref>፤ <ref loc="DEU 11:31">11:31</ref>፤ <ref loc="DEU 12:11">12:11</ref></char></note> ናባብዛይ አካኮ! <verse eid="MAT 24:15"/><verse number="16" style="v" sid="MAT 24:16"/>የ ዎደ ይሁዳ ቢታል የዝታይ አምባል ቆስንቶ። <verse eid="MAT 24:16"/><verse number="17" style="v" sid="MAT 24:17"/>ኬ ኩስተል የዝ አይ ፋ ካራ የዝ ባዝ ኤኮዳይስ ዎፐ።<note caller="-" style="x"><char style="xo" closed="false">24:17-18 </char><char style="xt" closed="false"><ref loc="LUK 17:31">ሉቃ. 17:31</ref></char></note> <verse eid="MAT 24:17"/><verse number="18" style="v" sid="MAT 24:18"/>ጋደ ኦሶል የዛይ ፋ አፍላ ኤኮዳይስ ጉየ ማቅፐ። <verse eid="MAT 24:18"/><verse number="19" style="v" sid="MAT 24:19"/>የ አግናይድ ዎደ ማችታይስኔ አምስዛ ማችታይስ ኢታ መቶ ማቃዳ። <verse eid="MAT 24:19"/><verse number="20" style="v" sid="MAT 24:20"/>ይ ቆስንታይ ባርጎር ዎይ ማላ ጋላስ ማቃም ጋርከ ጾሳ ዎሶይታ። <verse eid="MAT 24:20"/><verse number="21" style="v" sid="MAT 24:21"/>አብስ ጊኮ፥ ሳአ መንቴዛይፕ Ꮊይኖ ሄሎዳይስ ሀነካ ባዝ፥ ማ ቲናስካ የሻ ሀናም መቶ የ ዎደ ሀኖዳ።<note caller="-" style="x"><char style="xo" closed="false">24:21 </char><char style="xt" closed="false"><ref loc="GEN 12:1">መ. 12:1</ref>፤ <ref loc="REV 7:14">ዋን. ቆን. 7:14</ref></char></note> <verse eid="MAT 24:21"/><verse number="22" style="v" sid="MAT 24:22"/>የ ጋላስታይ ፓይዳ ሃትሰካዛኮ አሾ ማኤዝ ኦንካ አታሚ። ዝን ኤ ፋ ዶሬዝ አሳይ ግሾስ የ ጋላስታይ ፓይዳ ሃትዳ።<verse eid="MAT 24:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23"/>«የ ዎደ ኦንካ ይንታን፥ ‹Ꮊይሼ፥ ክርስቶሳ Ꮊይዳ› ዎይ ‹ሰንዳይዳ የዛ› ዬግኮ አማንፓተ። <verse eid="MAT 24:23"/><verse number="24" style="v" sid="MAT 24:24"/>አብስ ጊኮ፥ ዎርዶ ክርስቶስታይራኔ ዎርዶ ናብታይራ ደንዶዳ። ኡንትስ ዳንዳእንትኮ፥ ሀራ አቶዝን ጾሲ ዶሬዝታካ ባልድ ሄሎዳይስ ማላኔ ማላባዝ ቤዞዳ። <verse eid="MAT 24:24"/><verse number="25" style="v" sid="MAT 24:25"/>አካኮይታ፥ ታኒ ይንትስ Ꮊያ ቲናቲ ኦዴዛ።<verse eid="MAT 24:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26"/>«የይ ግሾስ፥ አሳይ ይንትኮ፥ ‹ክርስቶሳ ሊዦ የዛ› ጊኮ፥ እዘ Ꮊንግፓተ፥ ዎይ ይንትኮ፥ ‹ቆልአ የዛ› ጊኮ፥ አማንፓተ።<note caller="-" style="x"><char style="xo" closed="false">24:26-27 </char><char style="xt" closed="false"><ref loc="LUK 17:23-24">ሉቃ. 17:23-24</ref></char></note> <verse eid="MAT 24:26"/><verse number="27" style="v" sid="MAT 24:27"/>አብስ ጊኮ፥ ዜልን ሳሎ ዜልንጊ፥ አዋ ከሳፕ አዋ ገሎ ሄሎዳይስ በንትዛይ ጋርክ፥ አሲ ናአ ይእይ Ꮊይ ጋርክ ሀኖዳ።<verse eid="MAT 24:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 24:28"/>«ጋዉጻ የዛ አቆ አንኮ ሺቅዛ።<note caller="-" style="x"><char style="xo" closed="false">24:28 </char><char style="xt" closed="false"><ref loc="LUK 17:37">ሉቃ. 17:37</ref></char></note><verse eid="MAT 24:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29"/>«የ ዎደ የ መቶ ጋላስታይፕ ጉየ፥</para>
  <para style="q2" vid="MAT 24:29">ኤለ አዋ ሞዳ፥</para>
  <para style="q2" vid="MAT 24:29">አግና ፋ ፖኦ ካዮዳ።<note caller="-" style="x"><char style="xo" closed="false">24:29 </char><char style="xt" closed="false"><ref loc="ISA 13:10">ኢሳ. 13:10</ref>፤ <ref loc="JER 2:10">ኤርም. 2:10</ref></char></note></para>
  <para style="q1" vid="MAT 24:29">ጾልንትታይ ሳሎፕ ዎዳ፥</para>
  <para style="q2" vid="MAT 24:29">ማ ሳሎ የዝ ዎልቅታይካ ቡቅንቶዳ።<verse eid="MAT 24:29"/></para>
  <para style="m">
    <verse number="30" style="v" sid="MAT 24:30"/>የ ዎደ አስ ናአ ማላይ ሳሎል አፋ በንቶዳ። ሳአ የዝ አስ ኡባይ ዬኮዳ። ማ አስ ናአይ፥ ዎልቃራኔ ግታ ቦንቾር ሳሎ ሻራ ጋንጨር የኦዳር ኡንቲ በአዳ።<note caller="-" style="x"><char style="xo" closed="false">24:30 </char><char style="xt" closed="false"><ref loc="DEU 7:13">ናምእ. 7:13</ref>፤ <ref loc="ZEC 12:10">ዛክ. 12:10</ref></char></note> <verse eid="MAT 24:30"/><verse number="31" style="v" sid="MAT 24:31"/>ኤ ፋ ኪታንችታ ፑግዛ ዳማ ቱልቱላር ኪቶዳ። ኡ ሳአ ኦይዲ ዞዘ Ꮊንጊ፥ ጋጻፕ ጋጻ ሄሎዳይስ የዝ ኤስ ዶርንቴዝታ ሺሾዳ።<verse eid="MAT 24:31"/></para>
  <para style="s1">ጎዳይ የኦድ ጋላሳይስ ማላ</para>
  <para style="r">(<ref loc="MRK 13:28-31">ማር. 13:28-31</ref>፤ <ref loc="LUK 21:29-33">ሉቃ. 21:29-33</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32"/>«በለሰ<note caller="+" style="f"><char style="fr" closed="false">24:32 </char><char style="ft" closed="false">በለሰ፦ ኑ ቢታ ቤላ ፉኮ ቦነ ከዝዛይ ጋርከ</char></note> ምፕ ታማሮይታ። እ ጼራይ ጪዥኮ ሀይታይ አጮ አይክኮ ቦነ ኡኬዛና ይ ኤርዛ። <verse eid="MAT 24:32"/><verse number="33" style="v" sid="MAT 24:33"/>የይ ጋርከካ፥ ይ Ꮊ ኡባ በአዳር አስ ናአይ ይእዛ ዎዳይ ፔንገል የዛና ኤሮይታ። <verse eid="MAT 24:33"/><verse number="34" style="v" sid="MAT 24:34"/>ታኒ ይንትስ ቱሮ ኦድዛ፤ Ꮊ ኡባ ባዝ ፖልንቶድ ሄሎዳይስ፥ Ꮊ የለትይ ኣሚ። <verse eid="MAT 24:34"/><verse number="35" style="v" sid="MAT 24:35"/>ሳሎኔ ሳአይ ኣዳ፥ ዝን ታ ቃላይ ኣሚ።<note caller="-" style="x"><char style="xo" closed="false">24:35 </char><char style="xt" closed="false"><ref loc="GEN 6:5">መ. 6:5</ref></char></note><verse eid="MAT 24:35"/></para>
  <para style="s1">ጎዳይ የኦድ ጋላሳና ኦንካ ኤሮያ</para>
  <para style="r">(<ref loc="MRK 13:32-37">ማር. 13:32-37</ref>፤ <ref loc="LUK 17:26-30">ሉቃ. 17:26-30</ref>፥ <ref loc="LUK 17:34-36">34-36</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36"/>«የ ጋላሳትኔ የ ሳታቲ ባጋ ሳሎ የዝ ታ አዳይፕ አትን ሀራ ሳሎ ኪታንችታ ማቅን ዎይ ናአ ማቅን ኦንካ ኤሮያ። <verse eid="MAT 24:36"/><verse number="37" style="v" sid="MAT 24:37"/>አስ ናአ ይእይ፥ ኖሄ ዎደ ሀኔዛይ ጋርክ ማቃዳ።<note caller="-" style="x"><char style="xo" closed="false">24:37 </char><char style="xt" closed="false"><ref loc="GEN 6:5">መ. 6:5</ref></char></note> <verse eid="MAT 24:37"/><verse number="38" style="v" sid="MAT 24:38"/>የ አግንተ ቦ ሃይ የኦዳይፕ ቲና ኖሄ ማርካበ ጋንጨ ገሎድ ሄሎዳይስ፥ አሳይ ሚታራኔ ኡዥታር፥ ኤክታራኔ ገልታር ጋምኤዛ። <verse eid="MAT 24:38"/><verse number="39" style="v" sid="MAT 24:39"/>ቦ ሃይ ይኢ፥ ኡንታን ኡባ ብሶድ ሄሎዳይስ አካኬካያ። አስ ናአ ይእይካ Ꮊይ ጋርክ ሀኖዳ።<verse eid="MAT 24:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 24:40"/>«የ ዎደ ናምኢ አሳይ ጋደ ጋንጨ ኦዳ። ኡንታፕ ፐታይ ኤክንቶዳ፥ Ꮊንካይ አቶዳ። <verse eid="MAT 24:40"/><verse number="41" style="v" sid="MAT 24:41"/>ናምኢ ማችታይ ዎላ ጋጮዳ። ኡንታፕ ፐታት ኤክንቶዳ Ꮊንካት አቶዳ።<verse eid="MAT 24:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42"/>«ይኬ፥ ይ ጎዳይ አባ ጋላስ የኦዳዛኮ ኤሮዋ ግሾስ ሚንጊ ናጎይታ። <verse eid="MAT 24:42"/><verse number="43" style="v" sid="MAT 24:43"/>ዝን ካይዞ ቃማፕ ኣፑን ሳተል የኦዳዛኮ ካራ አዳይ ኤርዛኮ፥ ፋ ካራ ቦክንታማይ ጋርክ ባርክ ናጎዳዝን።<note caller="-" style="x"><char style="xo" closed="false">24:43-44 </char><char style="xt" closed="false"><ref loc="LUK 12:39-40">ሉቃ. 12:39-40</ref></char></note> <verse eid="MAT 24:43"/><verse number="44" style="v" sid="MAT 24:44"/>የይ ጋርክ፥ አስ ናአይ ይ ቆፐካ ሳተ የኦድ ግሾስ ይንትካ ጊግንቲ የዞይታ።<verse eid="MAT 24:44"/></para>
  <para style="s1">ኢታኔ ሎኦ አይለ ኣዝሶ</para>
  <para style="r">(<ref loc="LUK 12:41-48">ሉቃ. 12:41-48</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45"/>«የዝን፥ ፋ ካራ አሳይስ ካ ቤዝዛ ዎደር እማድ ጋርክ ኤ ጎዳይ ዶሬዝ አማንዛይኔ ዎዛናማ አይላይ ኦኖ? <verse eid="MAT 24:45"/><verse number="46" style="v" sid="MAT 24:46"/>ኤ ፋ ጎዳይ አዛዜዛና ኦዳር ኤ ጎዳይ ይኢ ደንግዛ አይላይ አንጅንቴዛያ። <verse eid="MAT 24:46"/><verse number="47" style="v" sid="MAT 24:47"/>ታኒ ይንትስ ቱሮ ኦድዛ፤ ጎዳይ የ አይላ ፋባዝ ኡባይል አፋ ሹሞዳ። <verse eid="MAT 24:47"/><verse number="48" style="v" sid="MAT 24:48"/>ኢታ አይላይ፥ ‹ታ ጎዳይ ጋምኢ የኦዳ› ዬጊ ፋ ዎዝናር ቆፒ፥ <verse eid="MAT 24:48"/><verse number="49" style="v" sid="MAT 24:49"/>ፋ ኦሶ ላግታ Ꮊ አይክኮ፥ ማዝታይራ ሚኮኔ ኡዥኮ፥ <verse eid="MAT 24:49"/><verse number="50" style="v" sid="MAT 24:50"/>የ አይላይ ጎዳይ ኤ ቆፐካ ጋላስኔ ኤ ኤረካ ሳተር፥ <verse eid="MAT 24:50"/><verse number="51" style="v" sid="MAT 24:51"/>ይኢ ኤዛ ናምኢ ከሲ ጳልቆዳ። ኤ አንጃካ ጩቢታይር ኡዶዳ። ኤዛይድ ኤስ ዬፎኔ አች ጮንች ማቃዳ።<verse eid="MAT 24:51"/></para>
  <chapter eid="MAT 24"/>
  <chapter number="25" style="c" sid="MAT 25"/>
  <para style="s1">ታጲ ዉድርታይ ኣዝሶ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1"/>«የ ዎደ ሳሎ ካተትይ ፋ ኩራዘ አይኪ፥ ማቾ ኮኦዳይስ Ꮊንጌዝ አ ሞኮዳይስ ከዜዝ ታጲ ዉድርታ ኣዝዛ።<note caller="-" style="x"><char style="xo" closed="false">25:1 </char><char style="xt" closed="false"><ref loc="LUK 12:35">ሉቃ. 12:35</ref></char></note> <verse eid="MAT 25:1"/><verse number="2" style="v" sid="MAT 25:2"/>ኡንታፕ እችንታይ ቦዝታ፥ እችንታይ ኤጭታ። <verse eid="MAT 25:2"/><verse number="3" style="v" sid="MAT 25:3"/>ቦዝታይ ኩራዘ አይኬዛ፥ ዝን ሀራ ላምባ አይከካያ። <verse eid="MAT 25:3"/><verse number="4" style="v" sid="MAT 25:4"/>ዝን ኤጭታይ ፋ ኩራዛኔ ሀራ ጉጆ ላምባ አይኬዛ። <verse eid="MAT 25:4"/><verse number="5" style="v" sid="MAT 25:5"/>ማቾ ኤክዛ አይ ጋምእን፥ የ ዉድርታይ ኡንታን ገንታ አይክን ገንቴዛ።<verse eid="MAT 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6"/>«ግዲ ብላሄ ማቆዳር ‹ማቻቶ ኤክዛይ የኤዛ፥ ኤዛ ሞኮዳይስ ከዞይታ› ዬግዝ ግታ ጫቦት ስንቴዛ።<verse eid="MAT 25:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7"/>«የ ዎደ የ ዉድርታይ ኡቢታይ ባርኪ፥ ፋ ኩራዛ ጊግሴዛ። <verse eid="MAT 25:7"/><verse number="8" style="v" sid="MAT 25:8"/>ቦዝታይ ኤጭታይኮ፥ ‹ኑ ጾምፓይ ቶኦድ ሀንዛ ግሾስ ይ ላምባይፕ ኑስ እንጎይታ› ዬጌዛ።<verse eid="MAT 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9"/>«ዝን ኤጭታይ ኡንትኮ ማሂ፥ ‹የይ ሀናሚ፥ ኑስኔ ይንትስ ግድዛ ላምባ ባያ። የይ ግሾስ፥ ይንትስ Ꮊንጊ ዎንጊ ኤኮይታ› ዬጌዛ። <verse eid="MAT 25:9"/><verse number="10" style="v" sid="MAT 25:10"/>ቦዞ ዉድርታይ ላምባ ዎንጎዳይስ ቅቴዝን፥ ማቻት ኤክዛ አይ ፑት ጌዛ። ጊግንቲ በቴዝ እችን ዉድርታይ ኤዛር ዎላ ቦሳ ስብረል ገሌዛ፤ ፐንጋይካ ጎርድንቴዛ።<verse eid="MAT 25:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11"/>«ጉየፕ Ꮊንኮ ዉድርታይ ይኢ፥ ‹ጎዳዮ፥ ጎዳዮ፥ ኑስ ዶዮዬ› ዬጌዛ።<verse eid="MAT 25:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12"/>«ዝን ኤ ኡንትኮ ማሂ፥ ‹ታኒ ይንትስ ቱሮ ኦድዛ፤ ታ ይንታን ኤሮያ!›<verse eid="MAT 25:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13"/>«ይኬ፥ አስ ናአይ የኦድ ጋላሳ ዎይ ሳታ ይ ኤሮዋ ግሾስ ባርኪ ናጎይታ።<verse eid="MAT 25:13"/></para>
  <para style="s1">ሀይ ኦሶ አስታይ ኣዝሶ</para>
  <para style="r">(<ref loc="LUK 19:11-27">ሉቃ. 19:11-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14"/>«ጾስ ካተትይ ፋ አይልታ ጼጊ ፋስ የዛ ባዝ ኡንትስ ሀዳሪ ኦገ Ꮊማዳይስ ከዜዝ አ ኣዝዛ።<note caller="-" style="x"><char style="xo" closed="false">25:14-30 </char><char style="xt" closed="false"><ref loc="LUK 19:11-27">ሉቃ. 19:11-27</ref></char></note> <verse eid="MAT 25:14"/><verse number="15" style="v" sid="MAT 25:15"/>ኡንትስ ኦማር ኦማር ኡ ዎልቃይ ጋርክ ፐታይስ እችን መክልተ<note caller="+" style="f"><char style="fr" closed="false">25:15 </char><char style="ft" closed="false">መክልተ ጉሳይ ፐቲ ጋላሳ ኦ ኦዝ አይስ ታጶ እችን ላይ ዳሞዘ ጉሲ</char></note>፥ ፐታይስ ናምኢ መክልተ ማ ፐታይስ ፐቲ መክልተ እንጊ ሀራ ጋደ ቅቴዛ። <verse eid="MAT 25:15"/><verse number="16" style="v" sid="MAT 25:16"/>እችን መክልተ ኤኬዝ አይላይ ኤለ Ꮊንጊ ዛልእ፥ ሀራ እችን መክልተ ትርፕሴዛ። <verse eid="MAT 25:16"/><verse number="17" style="v" sid="MAT 25:17"/>የይ ጋርከካ፥ ማ ናምኢ መክልተ ኤኬዝ አይላይ ሀራ ናምኢ መክልተ ትርፕሴዛ። <verse eid="MAT 25:17"/><verse number="18" style="v" sid="MAT 25:18"/>ዝን ፐቲ መክልተ ኤኬዛይ Ꮊንጊ፥ ኦላ ቦኪ፥ ፋ ጎዳይ ሚሻ ሞጌዛ።<verse eid="MAT 25:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19"/>«ጋመ ዎደፕ ጉየ የ አይልታይ ጎዳይ ይኢ፥ ፋ ሚሻ ኡንታን ኦይጬዛ። <verse eid="MAT 25:19"/><verse number="20" style="v" sid="MAT 25:20"/>እችን መክልተ ኤኬዝ አይላይ ይኢ፥ ሀራ እችን መክልተ ክኢ፥ ‹ታ ጎዳዮ፥ ነ ታስ እችን መክልተ እንጌዛ። ዝን ታ ሀራ እችን መክልተ ትርፕሴዛ› ዬጌዛ። <verse eid="MAT 25:20"/><verse number="21" style="v" sid="MAT 25:21"/>ኤ ጎዳይ፥ ‹ዛምባይ! ኔኒ ሎኦ አማንዛ አይለ፤ ኔኒ ጽቃ ባዛል አማንቴዛ። ታኒ ነና ጋመ ባዛል ሹሞዳ፤ Ꮊና ነ ጎዳይ ኡፋይሳይድ ገሎባ› ዬጌዛ።<verse eid="MAT 25:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22"/>«ማ ናምኢ መክልተ ኤኬዛይ ይኢ፥ ‹ታ ጎዳዮ፥ ኔኒ ታስ ናምኢ መክልተ እንጌዛ። ዝን ታኒ ሀራ ናምኢ መክልተ ትርፕሴዛ› ዬጌዛ። <verse eid="MAT 25:22"/><verse number="23" style="v" sid="MAT 25:23"/>ኤ ጎዳይ፥ ‹ዛምባይ! ኔኒ ሎኦ አማንዛ አይለ፤ ኔኒ ጽቃ ባዛል አማንቴዛ። ታኒ ነና ጋመ ባዛል ሹሞዳ፤ Ꮊና ነ ጎዳይ ኡፋይሳይድ ገሎባ› ዬጌዛ።<verse eid="MAT 25:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24"/>«ማ ፐቲ መክልተ ኤኬዛይ ይኢ፥ ‹ታ ጎዳዮ፥ ኔኒ ዘረካ አቆፕ ቡጭዝ ላለካ አቆፕ ማጽዝ ኢታ አስ ማቄዛና ታኒ ኤርዛ። <verse eid="MAT 25:24"/><verse number="25" style="v" sid="MAT 25:25"/>ታ ያሽቲ ነ መክልታ ቢታ ጋንጨ ሞጌዛ። ነ መክልታ Ꮊናሸ› ዬጌዛ።<verse eid="MAT 25:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26"/>«ኤ ጎዳይ ማሂ፥ ‹Ꮊ ኢታ አዛላ አይላዮ፥ ታኒ ዘረካ አቆፕ ቡጭዛኔ ላለካ አቆፕ ማጽዛ አስ ማቄዛ ነ ኤርኔ? <verse eid="MAT 25:26"/><verse number="27" style="v" sid="MAT 25:27"/>ይኬ፥ ኔኒ ታ ሚሽቶ ባንከ ጋዴዛኮ ዎር ኤኮዳኖ ነ ካዬዛ። <verse eid="MAT 25:27"/><verse number="28" style="v" sid="MAT 25:28"/>የይ ግሾስ፥ ሚሻ ኤፕ ኤኪ፥ ታጲ መክልተ የዛይስ እንጎይታ። <verse eid="MAT 25:28"/><verse number="29" style="v" sid="MAT 25:29"/>አብስ ጊኮ፥ የዛ ኡባይስ ጉጅንቶዳ ጋንጎዳ። ዝን ባዛይፕ ሀራ አቶዝን፥ የ ኤዝስ የዛ ጽቃታካ ኤክንቶዳ።<note caller="-" style="x"><char style="xo" closed="false">25:29 </char><char style="xt" closed="false"><ref loc="MAT 13:12">ማቶ. 13:12</ref>፤ <ref loc="MRK 4:25">ማር. 4:25</ref>፤ <ref loc="LUK 8:18">ሉቃ. 8:18</ref></char></note> <verse eid="MAT 25:29"/><verse number="30" style="v" sid="MAT 25:30"/>Ꮊ ማዶዋ አይላ ባለ ማ ከሲ ኦሎይታ። ኤዛይድ ኤዝስ ዬፎኔ አች ጮንች ማቃዳ› ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">25:30 </char><char style="xt" closed="false"><ref loc="MAT 8:12">ማቶ. 8:12</ref>፤ <ref loc="MAT 22:13">22:13</ref>፤ <ref loc="LUK 13:28">ሉቃ. 13:28</ref></char></note><verse eid="MAT 25:30"/></para>
  <para style="s1">ዎደ ዉርስል ሀኖድ ፕርደ</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31"/>«አስ ናአይ፥ ኪታንቾ ኡቢታይራ፥ ፋ ቦንቾር ይኢ ኤ ፋ ቦንቾ ካተት ዙፋናይል አፋ በቶዳ።<note caller="-" style="x"><char style="xo" closed="false">25:31 </char><char style="xt" closed="false"><ref loc="MAT 16:27">ማቶ. 16:27</ref>፤ <ref loc="MAT 19:28">ማቶ. 19:28</ref></char></note> <verse eid="MAT 25:31"/><verse number="32" style="v" sid="MAT 25:32"/>አስ ኮች ኡቢታይ ኤ ቲና ሺቆዳ። ሄንግዝ ናአይ ዱርታ ዴሽታይፕ ቁርዛይ ጋርክ ኤ የ አሳ ናምኢ አቆ ሻጎዳ። <verse eid="MAT 25:32"/><verse number="33" style="v" sid="MAT 25:33"/>ዱርታ ኡሻች ባጋር ዴሽታ ሀድርስ ባጋር ኤሶዳ።<verse eid="MAT 25:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34"/>«የ ዎደ፥ ካታይ ኡሻች ባጋር የዝታይኮ Ꮊይ ጋርክ ዬጎዳ፦ ‹ታ አዳይ አንጄዝታዮ፥ Ꮊና ይኢ ሳአ መንቴዛይፕ አይኪ ይንትስ ጊጌዝ ካተት ላቶይታ። <verse eid="MAT 25:34"/><verse number="35" style="v" sid="MAT 25:35"/>አብስ ጊኮ፥ ታኒ ናይንትን ይ ታና ሙዜዛ፥ ሳምንትን ኡሼዛ፥ እማ ማቂ Ꮊንግን ሞኬዛ፥ <verse eid="MAT 25:35"/><verse number="36" style="v" sid="MAT 25:36"/>ካሎቲን ማእሴዛ፥ ሀርግንትን ኦይጬዛ፥ አጭንትን ታና ይ በኤዛ› ዬጎዳ።<verse eid="MAT 25:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37"/>«የይፕ ጉየ፥ ጽልታይ ማሂ፥ ‹ጎዳዮ፥ ኔኒ ናይንትን አይደ ብኢ ነና ኑ ሙዜኔ? ዎይ ኔኒ ሳምንትን አይደ ብኢ ነና ኑ ኡሼኔ? <verse eid="MAT 25:37"/><verse number="38" style="v" sid="MAT 25:38"/>ኔኒ እማ ማቂ ይእን አይደ ብኢ ነና ኑ ሞከኔ? ዎይ ኔኒ ካሎቲን አይደ ነና ኑ ማእሴኔ? <verse eid="MAT 25:38"/><verse number="39" style="v" sid="MAT 25:39"/>ኔኒ ሀርግንትን ዎይ አጭንትን ኔኮ Ꮊንጊ አይደ ነና ኑ ኦይጬኔ?› ዬጎዳ። <verse eid="MAT 25:39"/><verse number="40" style="v" sid="MAT 25:40"/>ካታይ ማሂ፥ ‹ታኒ ይንትስ ቱሮ ኦድዛ፤ ይንቲ ታና ካልዛ Ꮊ ኡባይፕ ጽቅዛ እሽታይፕ ፐታይስ ኦዛና ታስ ኦዛ› ዬጎዳ።<verse eid="MAT 25:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41"/>«የ ዎደ ሀድርስ ባጋር የዝታይኮ፥ ‹Ꮊ ባድንቴዝታዮ፥ ታ ላንቃይፕ ሃኮይታ። ጻላሄስኔ ኤ ኪታንችታይስ ጊጌዝ መና ታማ ጋንጨ Ꮊንጎይታ። <verse eid="MAT 25:41"/><verse number="42" style="v" sid="MAT 25:42"/>አብስ ጊኮ፥ ናይንትን ታና ይ ሙዘካያ፤ ሳምንትን ታና ይ ኡሸካያ። <verse eid="MAT 25:42"/><verse number="43" style="v" sid="MAT 25:43"/>ታኒ እማ ማቂ Ꮊንግን ታና ይ ሞከካያ፥ ካሎቲን ማእሰካያ፥ ሀርግን አጭንትን ታና ኦይጨካያ› ዬጎዳ።<verse eid="MAT 25:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44"/>«የ ዎደ ኡንቲ፥ ‹ጎዳዮ፥ ኔኒ ናይንትን ዎይ ሳምንትን ዎይ እማ ማቂ Ꮊንግን ዎይ ካሎቲን ዎይ ሀርግንትን ዎይ አጭንትን ብኢ ነና አይደ ማዳም እጼኔ?› ዬጊ ማሆዳ።<verse eid="MAT 25:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45"/>«የ ዎደ ካታይ ማሂ ኡንትኮ፥ ‹ታኒ ይንትስ ቱሮ ኦድዛ፤ ይንቲ ታና ካልዛ Ꮊ ኡባፕ ጽቅዝታይፕ ፐታ ማዳም እጼዛይ፥ ታና ማዳም እጼዛ› ዬጎዳ። <verse eid="MAT 25:45"/><verse number="46" style="v" sid="MAT 25:46"/>የይ ግሾስ፥ የ አሳይ መና ፕርደስ ማ ጽልታይ መና ደኦስ Ꮊማዳ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">25:46 </char><char style="xt" closed="false"><ref loc="DAN 12:2">ዳነ. 12:2</ref></char></note><verse eid="MAT 25:46"/></para>
  <chapter eid="MAT 25"/>
  <chapter number="26" style="c" sid="MAT 26"/>
  <para style="s1">የሱሳል ቶቤዛ</para>
  <para style="r">(<ref loc="MRK 14:1-2">ማር. 14:1-2</ref>፤ <ref loc="LUK 22:1-2">ሉቃ. 22:1-2</ref>፤ <ref loc="JHN 11:45-53">ዋን. 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1"/>የሱሳ Ꮊ ትምርታ ኡባ ዉርሴዛይፕ ፋ ታማርታይኮ፥ <verse eid="MAT 26:1"/><verse number="2" style="v" sid="MAT 26:2"/>«ናምኢ ጋላሳፕ ጉየ፥ ፓዝቃ ባለ ቦንችዛ ጋላስ ማቅዛና ይ ኤርዛ። የ ጋላስ አስ ናአይ ማዝቃለል አፋ ሶትንቶዳይስ አስ ኩሸ ኣ እንግንቶዳ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">26:2 </char><char style="xt" closed="false"><ref loc="EXO 12:1">ከስ 12:1</ref></char></note><verse eid="MAT 26:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3"/>የ ዎደ ቄሰ ሀላቅታይኔ ጋደ ጭምታይ፥ ቃያፋ ግዝ ቄሰ ሀላቃይ ካራ ሺቂ፥ <verse eid="MAT 26:3"/><verse number="4" style="v" sid="MAT 26:4"/>አሲ ኤረካዝን የሱሳ አይኪ፥ ዎዳይስ ቶቤዛ። <verse eid="MAT 26:4"/><verse number="5" style="v" sid="MAT 26:5"/>ዝን ኡንቲ፥ «አሳይ ጫቦታማይ ጋርክ ግ፥ ፓዝቃ ቦንችዛ ጋላስ የያ ኦሚ» ዬጌዛ።<verse eid="MAT 26:5"/></para>
  <para style="s1">የሱሳና ሽቶ ትዤዝ አስቶ</para>
  <para style="r">(<ref loc="MRK 14:3-9">ማር. 14:3-9</ref>፤ <ref loc="JHN 12:1-8">ዋን. 12:1-8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6"/>የሱሳ ብታና ካታማ ጋንጨ ቦርቆንቶ ሀርገር የዝ ስሞና ካራ የዛ። <verse eid="MAT 26:6"/><verse number="7" style="v" sid="MAT 26:7"/>የሱሳ ሙንትታል የዝን ፐቲ አስታ አልባስጽሮሳ ብልጋጸ ኩን ጋመ አልኦ ሽቶ ኤኪ ይኢ የሱሳ ኦማይል ቆሌዛ።<note caller="-" style="x"><char style="xo" closed="false">26:7 </char><char style="xt" closed="false"><ref loc="LUK 7:37">ሉቃ. 7:37</ref></char></note> <verse eid="MAT 26:7"/><verse number="8" style="v" sid="MAT 26:8"/>ዝን የሱሳ ታማርታይ የያ ብኢ ካጭንቲ፥ «Ꮊ ሽታ ጨረ ኢስዛይ አብሶ? <verse eid="MAT 26:8"/><verse number="9" style="v" sid="MAT 26:9"/>Ꮊ ሽታይ አልኦ ዋጋር ባይዝንቲ፥ ሚሻይ ማንቅታይስ እንግንቶዳይስ ዳንዳእንትዛዝን» ዬጌዛ።<verse eid="MAT 26:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10"/>የሱሳ ኡንቲ ጌዛና ኤሪ፥ ኡንትኮ፥ «Ꮊ አስቶ አብስ ዋይ? እዛ ታስ ሎኦ ባዝ ኦዛ። <verse eid="MAT 26:10"/><verse number="11" style="v" sid="MAT 26:11"/>ማንቅታይ ኡባ ዎደ ይንታር የዞዳ። ዝን ታኒ ይንታር ኡባ ዎደ የዛሚ።<note caller="-" style="x"><char style="xo" closed="false">26:11 </char><char style="xt" closed="false"><ref loc="DEU 15:11">ናምእ. 15:11</ref></char></note> <verse eid="MAT 26:11"/><verse number="12" style="v" sid="MAT 26:12"/>እዛ Ꮊ ሽታ ታል አፋ ቆሌዛይ ታና ሞጎስ ጊግሴዛ። <verse eid="MAT 26:12"/><verse number="13" style="v" sid="MAT 26:13"/>ታኒ ይንትስ ቱሮ ኦድዛ፤ ቢታ ኡባይል Ꮊ ዎንግላይ ሳባክንትዛ አቆ አባ ማቅኮካ፥ አሳይ እዝስ ቆፕሶ ማቃዳይ ጋርክ ኦድንቶዳ» ዬጌዛ።<verse eid="MAT 26:13"/></para>
  <para style="s1">ይሁዳ የሱሳና ኣ እማዳይስ ጊግንቴዛ</para>
  <para style="r">(<ref loc="MRK 14:10-11">ማር. 14:10-11</ref>፤ <ref loc="LUK 22:3-6">ሉቃ. 22:3-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14"/>የ ዎደ ታጶ ናምኢ የሱሳ ታማርታይፕ ፐታይ፥ አስቆሮንቶ ይሁዳ ግንትንትዛይ ቄሰ ሀላቅታይኮ፥ <verse eid="MAT 26:14"/><verse number="15" style="v" sid="MAT 26:15"/>Ꮊንጊ፥ «ታኒ ይንትስ የሱሳ ኣ እንግኮ፥ ይ ታስ አብ እማዴ?» ዬጊ ኡንታን ኦይጬዛ።<note caller="-" style="x"><char style="xo" closed="false">26:15 </char><char style="xt" closed="false"><ref loc="DEU 11:12">ናምእ. 11:12</ref></char></note> ኡንቲ ቶቢ ሀስታም ብራ<note caller="+" style="f"><char style="fr" closed="false">26:15 </char><char style="fqa" closed="false">ብራ ሳንተ፦ </char><char style="ft" closed="false">አኮካ ጉዥንተካ ጌሽ ብራ ጉሲ።</char></note><note caller="+" style="f"><char style="fr" closed="false">26:15 </char><char style="fqa" closed="false">ሀስታም ብራ ሳንተ፦ </char><char style="ft" closed="false">ሀስታም ብራ ሳንትፈ እስሬለ ቢታ አይለ ዎንግትዛኔ ባይዝንትዛ ጋቴ።</char></note> እንጌዛ። <verse eid="MAT 26:15"/><verse number="16" style="v" sid="MAT 26:16"/>የይፕ ጉየ፥ ይሁዳ የሱሳ ኣ እማዳይስ ጊጋ ጋላስ ኮይዛ።<verse eid="MAT 26:16"/></para>
  <para style="s1">የሱሳ ፓዝቃ ካሆ ፋ ሀዋርታይር ሜዛ</para>
  <para style="r">(<ref loc="MRK 14:12-21">ማር. 14:12-21</ref>፤ <ref loc="LUK 22:7-14">ሉቃ. 22:7-14</ref>፥ <ref loc="LUK 22:21-23">21-23</ref>፤ <ref loc="JHN 13:21-30">ዋን. 13:21-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17"/>ቦራ ባለ ቦንችዛ ቲና ጋላስ፥ የሱሳ ታማርታይ ኤዝኮ ይኢ፥ «ፓዝቃ ቦንችዛ ጋላስ ኔኒ ማድ ካ ኑኒ አባ ማኮ?» ዬጌዛ።<verse eid="MAT 26:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18"/>የሱሳ ኡንትኮ፥ «ካታማ ይ ገሎዳር ሄሌዝ አይኮ Ꮊንጊ፥ ‹አስታማራይ፥ ታስ ዎደ ሄሌዝ ግሾ ታ ታማርታይር ፓዝቃ ቦንችዛ ጋላሳ ነ ካራ ኣዳ ዬጌዛ› ጎይታ» ጌዛ።<verse eid="MAT 26:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 26:19"/>ኤ ታማርታይ የሱሳ ኪቴዛይ ጋርክ ኡዲ፥ ፓዝቃ ባለ ጋላስ ማድ ካ ጊግሴዛ።<verse eid="MAT 26:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20"/>ሳአይ ኦማዳር የሱሳ ታጶ ናምኢ ሀዋርታይር ካ ማዳይስ በቴዛ። <verse eid="MAT 26:20"/><verse number="21" style="v" sid="MAT 26:21"/>ኡ ማዳር፥ የሱሳ ኡንትኮ፥ «ታኒ ይንትስ ቱሮ ኦድዛ፤ ይንታፕ ፐታይ ታና ኣ እማዳ» ዬጌዛ።<verse eid="MAT 26:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22"/>ኡ ኢታ ዳጋሚ፥ ኦማር ኦማር፥ «ጎዳዮ፥ ቱሮ ታናሻ?» ግ ኤዛ ኦይጬዛ።<verse eid="MAT 26:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23"/>የሱሳ ማሂ፥ «ፋ ኩሻ ታር ዎላ ፍልኦ ጋንጨ ዳክዛይ ኤ ታና ኣ እማዳ።<note caller="-" style="x"><char style="xo" closed="false">26:23 </char><char style="xt" closed="false"><ref loc="PSA 41:9">ማዝ. 41:9</ref></char></note> <verse eid="MAT 26:23"/><verse number="24" style="v" sid="MAT 26:24"/>አስ ናአይ፥ ጾስ ቃላይድ ኤዝስ ጻፍንቴዛይ ጋርክ Ꮊይቆዳ። ዝን አስ ናአ ኣ እንግዛ አ አየ፤ የ አይ የልንተካ አቴዛኮ ኤዝስ ሎኦዝን» ዬጌዛ።<verse eid="MAT 26:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25"/>ኤዛ ኣ እማዳይስ የዝ ይሁዳ ማሂ፥ «አስታማራዮ፥ ነ ግዛይ ታናኔ?» ዬጌዛ።</para>
  <para style="p" vid="MAT 26:25">የሱሳ ማሂ፥ «ነ ጌዛይ ጋርክ» ዬጌዛ።<verse eid="MAT 26:25"/></para>
  <para style="s1">ጎዳይ ካሆ</para>
  <para style="r">(<ref loc="MRK 14:22-26">ማር. 14:22-26</ref>፤ <ref loc="LUK 22:15-20">ሉቃ. 22:15-20</ref>፤ <ref loc="1CO 11:23-25">1ቆሮ. 11:23-25</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26"/>ኡንቲ ማዳር፥ የሱሳ ቦራ ኤኪ ጾሳ ጋላቴዛ። የ ቦራ ባጺ ፋ ታማርታይስ እንጊ፥ «Ꮊሽቴ፥ ሞይታ፥ Ꮊይ ታ አሾ» ዬጌዛ።<verse eid="MAT 26:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27"/>ጹአ ኤኪ፥ ጾሳ ጋላቴዛ። ኡንትስ እንጊ፥ «ኡባይ Ꮊይፕ ኡዦይታ። <verse eid="MAT 26:27"/><verse number="28" style="v" sid="MAT 26:28"/>Ꮊይ ጋመ አሳይ ናጋራይ አቶ እንትንቶዳይ ጋርክ ጎግዝ ኦሮ ታ ጫቆ ሱ።<note caller="-" style="x"><char style="xo" closed="false">26:28 </char><char style="xt" closed="false"><ref loc="EXO 24:8">ከስ 24:8</ref>፤ <ref loc="JER 31:31">ኤርም. 31:31</ref></char></note> <verse eid="MAT 26:28"/><verse number="29" style="v" sid="MAT 26:29"/>ዝን ታኒ ይንትስ ኦድዛ፤ ታኒ ታ አዳይ ካተት ኦሮ ዎይነ ኡሽ ይንታር ኡዦድ ጋላሳ ሄሎዳይስ Ꮊንፕ ገደ Ꮊ ዎይነ ኡሻ ኡዣሚ» ዬጌዛ።<verse eid="MAT 26:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30"/>ጋላታ ማዝሙረ የጼዛይፕ ጉየ ደብረ ዛይተ አምባል ቅቴዛ።<verse eid="MAT 26:30"/></para>
  <para style="s1">የሱሳ ጵጽሮሳ ካዶዳና ቲናቲ ኦዴዛ</para>
  <para style="r">(<ref loc="MRK 14:27-31">ማር. 14:27-31</ref>፤ <ref loc="LUK 22:31-34">ሉቃ. 22:31-34</ref>፤ <ref loc="JHN 13:36-38">ዋን. 13:36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31"/>የ ዎደ የሱሳ ኡንትኮ፥</para>
  <para style="q1" vid="MAT 26:31">«‹ጾሳይ ሄንግዛና ሾጮዳ</para>
  <para style="q2" vid="MAT 26:31">ዱርታይካ ላልንቶዳ›</para>
  <para style="m" vid="MAT 26:31">ግንትንቲ ጾስ ቃላይድ ጻፍንቴዛይ ጋርክ Ꮊይኖ ቃማ ይ ኡቢታይ ታል ብንቶዳ።<note caller="-" style="x"><char style="xo" closed="false">26:31 </char><char style="xt" closed="false"><ref loc="ZEC 13:7">ዛክ. 13:7</ref></char></note> <verse eid="MAT 26:31"/><verse number="32" style="v" sid="MAT 26:32"/>ዝን ታኒ Ꮊይቆፕ ደንዴዛይፕ ጉየ ይንትፕ ቲናቲ ጋልላ Ꮊማዳ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">26:32 </char><char style="xt" closed="false"><ref loc="MAT 28:16">ማቶ. 28:16</ref></char></note><verse eid="MAT 26:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33"/>ጵጽሮሳ ማሂ፥ «ኡንቲ ኡባይ ነና አሺ ብኮካ፥ ታኒ ነና አሻሚ» ዬጌዛ።<verse eid="MAT 26:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34"/>የሱሳ ጵጽሮሳኮ፥ «ታኒ ኔስ ቱሮ ኦድዛ፤ Ꮊይኖ ቃማ ሹጉላ ኡኮዳይፕ ቲና ኔኒ ታና ሀይ ቶኬ ካዶዳ» ዬጌዛ።<verse eid="MAT 26:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35"/>ጵጽሮሳ ማሂ፥ «ታኒ ኔር ዎላ Ꮊይቆፕ አትን ነና የሻ ካዳሚ» ዬጌዛ።</para>
  <para style="p" vid="MAT 26:35">Ꮊንኮ ኤ ታማርታይ ኡቢታይካ Ꮊይ ጋርክ ጌዛ።<verse eid="MAT 26:35"/></para>
  <para style="s1">የሱሳ ጌተሰማነ ግዝ አቆ ዎሴዛ</para>
  <para style="r">(<ref loc="MRK 14:32-42">ማር. 14:32-42</ref>፤ <ref loc="LUK 22:39-46">ሉቃ. 22:39-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36"/>ኤዛይፕ ጉየ፥ የሱሳ ፋ ታማርታይር ጌተሰማነ ግዝ አቆ Ꮊንጊ፥ ኡንትኮ፥ «ታኒ ሰንዳይድ Ꮊንጊ ጾስ ዎሶዳ፥ ይ Ꮊይዳ በቶይታ» ዬጌዛ። <verse eid="MAT 26:36"/><verse number="37" style="v" sid="MAT 26:37"/>ጵጽሮሳኔ ዛብዶሳ ናአ ናምእታ ፓር ኤኪ Ꮊንጊ አዛኖኔ ይሎ አይኬዛ። <verse eid="MAT 26:37"/><verse number="38" style="v" sid="MAT 26:38"/>ማካ ኡንትኮ፥ «ታኒ Ꮊይቆድ ሄሎዳይስ አዛኔዛ። Ꮊይዳ ጋምኦይታኔ ባርኪ ናጎይታ» ዬጌዛ።<verse eid="MAT 26:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39"/>ጽቃ ቲናል Ꮊንጊ ቢታል ፋ ስናይር ጹጉኒ፥ «ታ አዳዮ፥ ዳንዳእንትዛ ባዝ ማቅኮ Ꮊ መቶ ጹአይ ታፕ ኣ። ዝን ነ ሸነ ሀኖፕ አትን ታ ሸናይ ሀንፐ» ዬጊ ጾሳ ዎሴዛ።<verse eid="MAT 26:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40"/>የሱሳ ፋ ታማርታይኮ ማቂ ይኢ ኡንቲ ገንቴዝን ደንጊ፥ ጵጽሮሳኮ፥ «ይንቲ ፐቲ ሳተዛኮኔ ገንተካዛር ታር ምንጎዳይስ ዳንዳኤካሳ? <verse eid="MAT 26:40"/><verse number="41" style="v" sid="MAT 26:41"/>ፓጨ ጋንጨ ይ ገላማይ ጋርክ ባርኪ ናጎይታኔ ጾሳ ዎሶይታ። አያናይ እንግንቲ የዝን አሾ ዳቡሬዛ» ዬጌዛ።<verse eid="MAT 26:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42"/>የሱሳ ማ ናምእን Ꮊንጊ ዎሲ፥ «ታ አዳዮ፥ ታኒ Ꮊ መቶ ጹአይፕ ኡዠካዝን ኣዳይስ ዳንዳእንቶዋ ባዝ ማቅኮ ነ ሸናይ ሀኖ» ዬጊ ጾሳ ዎሴዛ። <verse eid="MAT 26:42"/><verse number="43" style="v" sid="MAT 26:43"/>ማካ ማቂ የኦዳር ኤ ታማርታይ ገንታ ጋምን፥ ዎይኤዝን ደንጌዛ።<verse eid="MAT 26:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 26:44"/>ማካ ኡንታን አሺ Ꮊንጊ፥ ቲና ጌዝ ቃላቶ እዞ ማሂ ሃይን ዎሴዛ። <verse eid="MAT 26:44"/><verse number="45" style="v" sid="MAT 26:45"/>የይፕ ጉየ፥ ፋ ታማርታይኮ ይኢ፥ «Ꮊኖ ሄሎዳይስ ገንታላኔ ሸምፖል የኔ? ይኬ ገንቶይታ። ይኬ፥ አስ ናአይ፥ ናጋራ ኦዝታይ ኩሸ ኣ እንግንትዛ ሳታይ ሄሌዛ። <verse eid="MAT 26:45"/><verse number="46" style="v" sid="MAT 26:46"/>ደንዲ የይታ፥ ታና ኣ እንግዛይ Ꮊይሼ ሄሌዛ» ዬጌዛ።<verse eid="MAT 26:46"/></para>
  <para style="s1">የሱሳ ሞርክታይ ኩሸ አይክንቴዛ</para>
  <para style="r">(<ref loc="MRK 14:43-50">ማር. 14:43-50</ref>፤ <ref loc="LUK 22:47-53">ሉቃ. 22:47-53</ref>፤ <ref loc="JHN 18:3-12">ዋን. 18:3-12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47"/>የሱሳ ሀጋ የያ ኦድንቶዳር፥ ታጶ ናምኢ ታማርታይፕ ፐታይ፥ ይሁዳ የኤዛ። ቄሰ ሀላቅታይኔ ጋደ ጭምታይ ኪቴዝ ጋመ አሳይ ማሻኔ ጉፈ አይኬዝታይ ኤዛር ዎላ የኤዛ። <verse eid="MAT 26:47"/><verse number="48" style="v" sid="MAT 26:48"/>የሱሳ ኣ እንግዝ ይሁዳ የ ጋመ አሳይኮ፥ «ታኒ ዬርዛይ ይ ኮይዛይ ኤዛ፥ ኤዛ አይኮይታ» ዬጊ ማላ እንጊ ጋዴዛ።<verse eid="MAT 26:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 26:49"/>ኤልሲ የሱሳኮ ሺቂ፥ «አስታማራዮ፥ ሳሮ ኔስ ማቆ» ዬጊ ኤዛ ዬሬዛ።<verse eid="MAT 26:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50"/>የሱሳ ኤዝኮ፥ «ታ ዳባዮ፥ ኔኒ አብስ የኤኔ»<note caller="+" style="f"><char style="fr" closed="false">26:50 </char><char style="ft" closed="false">ታ ላጋዮ፥ ኔኒ ኦድ ባስቶ ኦ አሾባ፦ ዎይ ሀራ ብርሽይ ታ ላጋዮ፥ ነ Ꮊይዳ አብ ኦ?</char></note> ዬጌዛ።</para>
  <para style="p" vid="MAT 26:50">የይፕ ጉየ፥ ሺቂ፥ ፋ ኩሻ የሱሳል ጋዲ አይኬዛ። <verse eid="MAT 26:50"/><verse number="51" style="v" sid="MAT 26:51"/>የሱሳር የዝታይፕ ፐታይ ፋ ማሻ ሾዲ ቄሰ ሀላቃይ አይላ ሾጪ፥ ኤ ሀያ ጋቺ ኦሌዛ። <verse eid="MAT 26:51"/><verse number="52" style="v" sid="MAT 26:52"/>ዝን የሱሳ፥ «ነ ማሻ ጉየ ሾካይድ ማሆባ። አብስ ጊኮ፥ ማሻ ሾድዝ ኡቢታይ ማሻር Ꮊይቆዳ። <verse eid="MAT 26:52"/><verse number="53" style="v" sid="MAT 26:53"/>ታ፥ ታ አዳና ዎስዛኮ ጋመ ሙኩሎ ፓይድንትዝ ኪታንችታ ዳኮዳይስ ዳንዳኦዋ ባዝ ኔስ ኣዝኔ? <verse eid="MAT 26:53"/><verse number="54" style="v" sid="MAT 26:54"/>የያ ማቅኮ፥ ጾሳ ቃላይድ Ꮊይ ጋርክ ሀኖዳይስ ቤዝዛ ግንትንትዛይ ዋይዚ ፖልንቶደ?» ዬጌዛ።<verse eid="MAT 26:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55"/>የ ሳተ፥ የሱሳ የ ሺቄዝ ጋመ ዎያይኮ፥ «ታና ፓኖ ማሂ አይኮዳይስ ማሻኔ ጉፈ አይኪ የኤኔ? ታኒ ጾስ ኬ ጋላስ ጋላስ ታማርስታር ይንታር የዝ ዎደ ይ ታና አይክበኤካያ።<note caller="-" style="x"><char style="xo" closed="false">26:55 </char><char style="xt" closed="false"><ref loc="LUK 19:47">ሉቃ. 19:47</ref>፤ <ref loc="LUK 21:37">21:37</ref></char></note> <verse eid="MAT 26:55"/><verse number="56" style="v" sid="MAT 26:56"/>ዝን Ꮊይ ኡባይ ሀኔዛይ ናብታይ ጾስ ቃላይድ ጻፌዛይ ፖልንቶዳይ ጋርከ» ዬጌዛ።</para>
  <para style="p" vid="MAT 26:56">የ ዎደ ኤ ታማርታይ ኡቢታይ ኤዛ አሺ ቆስንቴዛ።<verse eid="MAT 26:56"/></para>
  <para style="s1">የሱሳ ፕርደ ሻንጎ ቲና ሺቄዛ</para>
  <para style="r">(<ref loc="MRK 14:53-65">ማር. 14:53-65</ref>፤ <ref loc="LUK 22:54-55">ሉቃ. 22:54-55</ref>፥ <ref loc="LUK 22:63-71">63-71</ref>፤ <ref loc="JHN 18:13-14">ዋን. 18:13-14</ref>፥ <ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57"/>የሱሳ አይኬዝታይ ቄሰ ሀላቃ ቀያፋኮ ኤዛ ካንጌዛ። ኤዛይድ ህገ አስታማርታይኔ ቢታ ጭምታይ ሺቂ የዛ። <verse eid="MAT 26:57"/><verse number="58" style="v" sid="MAT 26:58"/>ዝን ጵጽሮሳ ቄሰ ሀላቃይ ዛባ ሄሎዳይስ ሃኮር ኤዛ ካሌዛ። ኤ ዉርስ በአዳይስ ዛባ ገሊ ናግዝታይር በቴዛ።<verse eid="MAT 26:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59"/>ቄሰ ሀላቅታይኔ ሺቄዝ አስ ኡቢታይ የሱሳ ዎዳይስ ኤዛል አፋ ዎርዶ ማርካ ኮዬዛ። <verse eid="MAT 26:59"/><verse number="60" style="v" sid="MAT 26:60"/>ጋምታይ ይኢ ኤዛል አፋ ዎርዶ ማርካ ማርካቴዛ፥ ዝን አብካ ደንገካያ። ጉየፕ ናምኢ አሳይ ይኢ፥ <verse eid="MAT 26:60"/><verse number="61" style="v" sid="MAT 26:61"/>«Ꮊ አይ፥ ‹ታኒ ጾሳ ኬ ላሊ ሀይ ጋላሳር ማሂ ኬጾዳይስ ዳንዳእዛ› ጌዛ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">26:61 </char><char style="xt" closed="false"><ref loc="JHN 2:19">ዋን. 2:19</ref></char></note><verse eid="MAT 26:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62"/>ቄስታይ ሀላቃይ ደንዲ ኤቂ የሱሳኮ፥ «Ꮊይትታይ ነና ሞትዛ ሞታይስ ኔኒ ማህዝባዝ ባሳ?» ዬጌዛ። <verse eid="MAT 26:62"/><verse number="63" style="v" sid="MAT 26:63"/>ዝን የሱሳ ስእ አቴዛ። ማካ ቄሰ ሀላቃይ፥ «ታኒ ነና ደኦ ጾሳ ሱንር አይክዛ፤ ኔኒ ጾሳ ናአ ክርስቶሳ ማቅኮ ኑስ ኦዶባ» ዬጌዛ።<verse eid="MAT 26:63"/></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64"/>የሱሳ ማሂ፥ «የያ ነ ጌዛ። ዝን ታኒ ይንትስ ኦድዛ፤ Ꮊይፕ ጉየ፥ አስ ናአይ ዎልቃማ ጾሳ ኡሻች ባጋር በቴዝን፥ ሳሎ ሻራር የኦዳር ይ በአዳ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">26:64 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳነ. 7:13</ref></char></note><verse eid="MAT 26:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65"/>የ ዎደ ቄሰ ሀላቃይ ፋ አፍላ ፔ፥ «Ꮊያ ቦኦይታ ጾስ ጫዤዛ! ኑና ሀራ ማርካ አብ ኮሼ? ኤ Ꮊት ጫዤዛና ይ ስኤዛ።<note caller="-" style="x"><char style="xo" closed="false">26:65-66 </char><char style="xt" closed="false"><ref loc="LEV 24:15-16">ለዊ. 24:15-16</ref></char></note> <verse eid="MAT 26:65"/><verse number="66" style="v" sid="MAT 26:66"/>ይ ቆፋይ አባ?» ዬጌዛ።</para>
  <para style="p" vid="MAT 26:66">ኡንትካ፥ «ኤዝስ Ꮊይቆ ቤዝዛ» ዬጊ ማሄዛ።<verse eid="MAT 26:66"/></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67"/>የ ዎደ፥ ኡ ኤ ስናይድ ጩቲ ዡልቴዛ፥ Ꮊንክታይ ኤዛ ባቂ፥<note caller="-" style="x"><char style="xo" closed="false">26:67 </char><char style="xt" closed="false"><ref loc="ISA 50:6">ኢሳ. 50:6</ref></char></note> <verse eid="MAT 26:67"/><verse number="68" style="v" sid="MAT 26:68"/>«ክርስቶሳ! ነና ሾጬዛይ ኦኖ? አን ኑስ ትንቢተ ኦዶባ» ዬጌዛ።<verse eid="MAT 26:68"/></para>
  <para style="s1">ጵጽሮሳ የሱሳና ካዴዛ</para>
  <para style="r">(<ref loc="MRK 14:66-72">ማር. 14:66-72</ref>፤ <ref loc="LUK 22:56-62">ሉቃ. 22:56-62</ref>፤ <ref loc="JHN 18:15-18">ዋን. 18:15-18</ref>፥ <ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69"/>ጵጽሮሳ ዛባይድ በቴዝን፥ ፐቲ ጋንዳታ ኤዝኮ ይኢ፥ «ኔካ ጋልላ የሱሳር ዎላ የዛ ባሳ» ዬጌዛ።<verse eid="MAT 26:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70"/>ዝን ኤ ኡ ኡቢታይ ቲና የ ጋንዳትኮ፥ «ነ ግዝ ባዛይ አብዛኮ ታ ኤሮያ» ዬጊ ካዴዛ።<verse eid="MAT 26:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71"/>ማ Ꮊንጊ ጋሰ ፐንገኮ ሄሎዳር Ꮊንካት ኤዛ ብኢ፥ እዘ የዛ አሳይኮ፥ «Ꮊ አይ ናዝረተ የሱሳር የዛ» ዬጌዛ።<verse eid="MAT 26:71"/></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72"/>ጵጽሮሳካ ናምእን ጫቂ፥ «ታኒ የ አ ኤሮያ!» ዬጌዛ።<verse eid="MAT 26:72"/></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73"/>ጽቃ ጋምኦዳር፥ እዘ ኤቄዝ አሳይ ጵጽሮሳኮ ይኢ፥ «ኔካ ቱሮ ኡንታር ዎላ የዛ ባይ፤ ኔኒ ነ ናሻይር ኤርንትዛ» ዬጌዛ።<verse eid="MAT 26:73"/></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74"/>የይፕ ጉየ፥ ጵጽሮሳ፥ «ታኒ የ አ ኤሮያ!» ዬጊ፥ ፋና ባድኔ ጫቆ አይኬዛ።</para>
  <para style="p" vid="MAT 26:74">የ ዎደ እዝር ሹጉላ ኡኬዛ። <verse eid="MAT 26:74"/><verse number="75" style="v" sid="MAT 26:75"/>የሱሳ ኤዝኮ፥ «ኔኒ ሹጉላ ኡኮዳይፕ ቲና ታና ሀይ ቶኬ ካዶዳ» ጌዛና ጵጽሮሳስ ኤልቂ ግን፥ ባለ ከዚ ዱካ ሱ ዬኬዛ።<verse eid="MAT 26:75"/></para>
  <chapter eid="MAT 26"/>
  <chapter number="27" style="c" sid="MAT 27"/>
  <para style="s1">ይሁዳ ፋና ሶቴዛ</para>
  <para style="r">(<ref loc="MRK 15:1">ማር. 15:1</ref>፤ <ref loc="LUK 23:1-3">ሉቃ. 23:1-3</ref>፤ <ref loc="JHN 18:28-32">ዋን. 18:28-32</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1"/>ዎንታ ጉራ ቄሰ ሀላቅታይኔ ጋደ ጭምታይ ኡቢታይ የሱሳና ዎዳይስ ቶቤዛ። <verse eid="MAT 27:1"/><verse number="2" style="v" sid="MAT 27:2"/>ኡንቲ የሱሳ አጪ ካንጊ ጋደ አቅስዝ ጵላጾሳስ ኣ እንጌዛ።<verse eid="MAT 27:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3"/>የ ዎደ የሱሳና አይዝ ይሁዳ፥ ጵላጾሳ የሱሳል አፋ ፕርዴዛና ብኢ፥ ቂራቲ፥ የ ሀስታም ብራ ቄሰ ሀላቅታይስኔ ጋደ ጭምታይስ ጉየ ማሄዛ።<note caller="-" style="x"><char style="xo" closed="false">27:3-8 </char><char style="xt" closed="false"><ref loc="ACT 1:18-19">ሀዋ. ኦ. 1:18-19</ref></char></note> <verse eid="MAT 27:3"/><verse number="4" style="v" sid="MAT 27:4"/>«ታኒ ጌሽ አስ Ꮊይቆስ አ እንጊ ናጋራ ኦዛ» ዬጌዛ።</para>
  <para style="p" vid="MAT 27:4">ዝን ኡንቲ፥ «የይ ኑ መቶ ባያ ነ መቶ» ዬጌዛ።<verse eid="MAT 27:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5"/>ይሁዳ ምሽቶ ጾስ ኬ ኦሊ አሺ ኡ ላንቃይፕ Ꮊንጊ፥ ሶትንቲ Ꮊይቄዛ።<verse eid="MAT 27:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6"/>ቄሰ ሀላቅታይ ሚሻ ኤኪ፥ «Ꮊ ሚሻይ ሱ ሚሸ ማቄዝ ግሾስ ኑኒ ጾስ ካራ ሚሸር ዋላኮዳይስ ቤዞያ» ዬጌዛ። <verse eid="MAT 27:6"/><verse number="7" style="v" sid="MAT 27:7"/>የይፕ ጉየ፥ ዎላ ቶቢ፥ በተ አስ ሞጎዳይስ ዢጨ ቢታ ዎንጌዛ። <verse eid="MAT 27:7"/><verse number="8" style="v" sid="MAT 27:8"/>የይ ግሾስ፥ የ ጋዳይ Ꮊይኖ ሄሎዳይስ ሱ ቢታ ግንትንቲ ጼግንትዛ።<verse eid="MAT 27:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 27:9"/>የ ዎደ ናበ ኤርማሳ ጌዛይ ጋርክ «እስሬለ ናእታይ ዋቼዝ ኤ ጋታ ሀስታም ብራ ኤኬዛ<note caller="-" style="x"><char style="xo" closed="false">27:9-10 </char><char style="xt" closed="false"><ref loc="ZEC 11:12-13">ዛክ. 11:12-13</ref></char></note> <verse eid="MAT 27:9"/><verse number="10" style="v" sid="MAT 27:10"/>ጎዳይ ታና አዛዜዛይ ጋርክ ዢጨ ቢታ ዎንጎዳይስ እንጌዛ» ጌዛይ የ ዎደ ፖልንቴዛ።<verse eid="MAT 27:10"/></para>
  <para style="s1">የሱሳ ጵላጾሳ ቲና ሺቄዛ</para>
  <para style="r">(<ref loc="MRK 15:2-5">ማር. 15:2-5</ref>፤ <ref loc="LUK 23:3-5">ሉቃ. 23:3-5</ref>፤ <ref loc="JHN 18:33-38">ዋን. 18:33-38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11"/>የሱሳ ጋደ አቅስዛ ጵላጾሳ ቲና ሺቅን፥ ጵላጾሳ ኤዝኮ፥ «ኔኒ አይሁደ ካቶ» ዬጊ ኦይጬዛ።</para>
  <para style="p" vid="MAT 27:11">የሱሳ ማሂ፥ «ነ ጌዛ» ዬጌዛ።<verse eid="MAT 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12"/>ቄሰ ሀላቅታይኔ ጋደ ጭምታይ ኤዛ ሞቶዳር ኡንትስ አባ ማልሰካ ማሄካያ።<verse eid="MAT 27:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 27:13"/>የ ዎደ ጵላጾሳ የሱሳኮ፥ «Ꮊይትታይ ነና ሞትዛ ሞታ ኡባ ነ ስኦሳ?» ዬጌዛ።<verse eid="MAT 27:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 27:14"/>የሱሳ ሀራ አቶዝን፥ ፐቲ ቃላካ ማሃም እጽን፥ ጋደ አቅስዛይ Ꮊይ ማላባዝ ጌዛ።<verse eid="MAT 27:14"/></para>
  <para style="s1">የሱሳል አፋ Ꮊይቆ ፕርደ ፕርድንቴዛ</para>
  <para style="r">(<ref loc="MRK 15:6-15">ማር. 15:6-15</ref>፤ <ref loc="LUK 23:13-25">ሉቃ. 23:13-25</ref>፤ <ref loc="JHN 18:39-40">ዋን. 18:39-40</ref>፤ <ref loc="JHN 19:1-16">19:1-16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15"/>ጋደ አቅስዛይ ላይ ላይ ፓዝቃ ባለ ቦንችዛ ጋላስ፥ ዎያይ ኮይዝ ፐቲ አስ አቻፕ ብልእዝ ዎጋ የዛ። <verse eid="MAT 27:15"/><verse number="16" style="v" sid="MAT 27:16"/>የ ዎደ ፐቲ ባርባና ግዝ ዳፋር ኤርንቴዝ ኢታ አሳይ አች ኬ የዛ። <verse eid="MAT 27:16"/><verse number="17" style="v" sid="MAT 27:17"/>የይ ግሾስ፥ ጋመ አስ ሺቂ የዝን ጵላጾሳ፥ «ታኒ ይንትስ ባርባና፥ ብሎነ የሱሳ ግዝ ክርስቶሳና ብልኦ?» ዬጊ ዎያ ኦይጬዛ። <verse eid="MAT 27:17"/><verse number="18" style="v" sid="MAT 27:18"/>ኤ የያ ጌዛይ ኡ ቅናቲ የሱሳ ኣ እንጌዛና ኤርዛ ግሾስ።<verse eid="MAT 27:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19"/>ጵላጾሳ ፕርደ ካራ በቴዝን፥ ኤ ማቻት፥ «ታኒ Ꮊይኖ ቃማ አቡካር ኤ ባጋ ኢታ ዋይታር አቄዝ ግሾስ የ ጌሽ አይል አፋ አባባዝካ ኦፐ» ዬጊ ኪቴዛ።<verse eid="MAT 27:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20"/>ዝን ቄሰ ሀላቅታይኔ ጋደ ጭምታይ ጵላጾሳ ባርባና ብልኢ፥ የሱሳ ዎድ ጋርክ፥ ዎያይ ኤዛ ዎሶድ ጋርክ፥ ዎያ ዶሼዛ።<verse eid="MAT 27:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21"/>ጵላጾሳ ማሂ ኡንትኮ፥ «ታኒ ኡ ናምአይፕ ይንትስ ኦና ብሎድ ጋርክ ኮይኔ?» ዬጊ ኦይጬዛ።</para>
  <para style="p" vid="MAT 27:21">ኡ፥ «ባርባና ብሎድ ጋርክ ኑ ኮይዛ» ዬጌዛ።<verse eid="MAT 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22"/>ጵላጾሳ፥ «የዝን፥ የሱሳ ግዝ ክርስቶሳ አብ ኡዶ?» ዬጊ ኡንታን ኦይጬዛ።</para>
  <para style="p" vid="MAT 27:22">ኡባይ ማሂ፥ «ሶትንቶ» ዬጌዛ።<verse eid="MAT 27:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23"/>ጵላጾሳ ዎያይኮ፥ «አብሶ? ኤ አብ ኢታ ባዝ ኦኔ?» ዬጊ ኦይጬዛ።</para>
  <para style="p" vid="MAT 27:23">ዝን አሳይ ቲናሳይፕ አ፥ «ማዝቃለል አፋ ኤዛ ሶቶባ» ግ ኡኬዛ።<verse eid="MAT 27:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24"/>ጵላጾሳ ጫቦ ደንፕ ሀራ አባባዝካ ኦዳይስ ዳንዳእንታምዛ ብኢ፥ ዉርሲ ሃ ኤኪ፥ «Ꮊ አይ Ꮊይቃይድ ታኒ ባያ። የያ ኦዛይ ይንታን» ዬጊ ዎያ ቲና ፋ ኩሸ ሜጬዛ።<note caller="-" style="x"><char style="xo" closed="false">27:24 </char><char style="xt" closed="false"><ref loc="DEU 21:6">ናምእ. 21:6</ref></char></note><verse eid="MAT 27:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25"/>አስ ኡቢታይ ማሂ፥ «ኤ ሱይ ኑላኔ ኑ ናእታይል አፋ ማቆ» ዬጌዛ።<verse eid="MAT 27:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26"/>የዝን፥ ጵላጾሳ ባርባና ኡንትስ ብልኢ፥ የሱሳ ጋራፊ፥ ማዝቃለል አፋ ሶትንቲ Ꮊይቆድ ጋርክ ኣ እንጌዛ።<verse eid="MAT 27:26"/></para>
  <para style="s1">ዎታዳርታይ የሱሳና ለቄዛ</para>
  <para style="r">(<ref loc="MRK 15:16-20">ማር. 15:16-20</ref>፤ <ref loc="JHN 19:2-3">ዋን. 19:2-3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27"/>የይፕ ጉየ፥ ጵላጾሳ ዎታዳርታይ የሱሳና ጋደ አቅስዛይ ዛባ ካንግን፥ ዎታዳርታይ ኤ ካላይድ ሺቄዛ። <verse eid="MAT 27:27"/><verse number="28" style="v" sid="MAT 27:28"/>ኤ አፍላ ቃሪ ኤኪ ዞቆ አፍላ<note caller="+" style="f"><char style="fr" closed="false">27:28 </char><char style="fqa" closed="false">ዞቆ አፍላ፦ </char><char style="ft" closed="false">ብኒ ዎደ ካትታይ አፋር ማእዝ አፍላ።</char></note> ማእሴዛ። <verse eid="MAT 27:28"/><verse number="29" style="v" sid="MAT 27:29"/>ማ አንጉ ዛዉደ ኮቺ፥ ኤ ኦማይል ጋዴዛ። ኤ ኡሻች ኩሻይድ ሾምቦቆ ጉፈ አይ፥ ኤ ቲናይድ ቡንቂቲ፥ «አይሁደ ካታዮ ሳሮ ኔስ ማቆ!» ዬጊ፥ ኤዛል አፋ ቃልዴዛ። <verse eid="MAT 27:29"/><verse number="30" style="v" sid="MAT 27:30"/>ኤዛል አፋ ጩቴዛ። የ ሾምቦቆ ጉፋ ኤኪ፥ ኤ ኦማይድ ሾጬዛ። <verse eid="MAT 27:30"/><verse number="31" style="v" sid="MAT 27:31"/>ኡንቲ ኤዛል አፋ ቃልዴዛይፕ ጉየ ዞቆ አፍላ ኤፕ ቃሪ ኤኪ፥ ኤ አፍላ ኤዛ ማእስ ሶቶዳይስ ኤኪ ካንጌዛ።<verse eid="MAT 27:31"/></para>
  <para style="s1">የሱሳ ሶትንቶ</para>
  <para style="r">(<ref loc="MRK 15:21-32">ማር. 15:21-32</ref>፤ <ref loc="LUK 23:25-43">ሉቃ. 23:25-43</ref>፤ <ref loc="JHN 19:17-27">ዋን. 19:17-27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32"/>ኡንቲ ባለ ከዚ፥ ፐቲ ስሞና ግዝ ቀረና ቢታ አ ደንጊ፥ የሱሳ ማዝቃላ ዎልቃር ቶሴዛ። <verse eid="MAT 27:32"/><verse number="33" style="v" sid="MAT 27:33"/>ጎልጎታ ግዝ አቆ ሄሌዛ። «ጎልጎታ» ጉሳይ «ኦማ ኦታ አቆ» ጉሲ። <verse eid="MAT 27:33"/><verse number="34" style="v" sid="MAT 27:34"/>የይድ ኡ ጭዠር ዋላክንቴዝ ዎይነ ኡሺ ኡዦ ግ ኤስ እንጌዛ። ዝን ኤ የያ ጋንጺ ብኢ፥ ኡዣም እጼዛ።<note caller="-" style="x"><char style="xo" closed="false">27:34 </char><char style="xt" closed="false"><ref loc="PSA 69:21">ማዝ. 69:21</ref></char></note><verse eid="MAT 27:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 27:35"/>ኡንቲ ማዝቃለል አፋ ኤዛ ሶቴዛይፕ ጉየ ኤ አፍላ ሻኪ፥ እጻ ኦሊ ኤኬዛ።<note caller="-" style="x"><char style="xo" closed="false">27:35 </char><char style="xt" closed="false"><ref loc="PSA 22:18">ማዝ. 22:18</ref></char></note> <verse eid="MAT 27:35"/><verse number="36" style="v" sid="MAT 27:36"/>የይፕ ጉየ፥ ኤዛይድ በቲ ኤዛ ናጌዛ። <verse eid="MAT 27:36"/><verse number="37" style="v" sid="MAT 27:37"/>ማ፥ «Ꮊይ አይሁደ ካት የሱሳ» ዬግዝ ኤ ዳፋ ቤዝዝ ሞቶ ጹፈ ኤ ኦማ አቻ ጋዴዛ። <verse eid="MAT 27:37"/><verse number="38" style="v" sid="MAT 27:38"/>የሱሳር የ ዎደ ናምኢ ፓንታይፕ ፐታ ኤፕ ኡሻች ባጋር፥ Ꮊንካ ኤፕ ሀድርስ ባጋር፥ ማዝቃለል አፋ ሶቴዛ።<verse eid="MAT 27:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 27:39"/>ኦገር ኣዝ አሳይ ፋ ኦማ ኤንእስታር የሱሳ ጫዥታር፥<note caller="-" style="x"><char style="xo" closed="false">27:39 </char><char style="xt" closed="false"><ref loc="PSA 22:7">ማዝ. 22:7</ref>፤ <ref loc="PSA 109:25">109:25</ref></char></note> <verse eid="MAT 27:39"/><verse number="40" style="v" sid="MAT 27:40"/>«ጾስ ካራ ላሊ ሀይ ጋላስ ጋንጨ ኬጽዛዮ፥ ነና አሾባ። ኔኒ ጾስ ናአ ማቅኮ፥ አን ማዝቃላይፕ ዎባ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">27:40 </char><char style="xt" closed="false"><ref loc="MAT 26:61">ማቶ. 26:61</ref>፤ <ref loc="JHN 2:19">ዋን. 2:19</ref></char></note><verse eid="MAT 27:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41"/>የይ ጋርከካ፥ ቄሰ ሀላቅታይ፥ ህገ አስታማርታይኔ ቢታ ጭምታይ ዎላ የሱሳል አፋ ቃልዴዛ። Ꮊይ ጋርክ ዬጌዛ፦ <verse eid="MAT 27:41"/><verse number="42" style="v" sid="MAT 27:42"/>«ሀራ አሳ አሼዛ፥ ዝን ፋና አሾዳይስ ዳንዳኤካያ። ኤ እስሬለ ካት ማቅኮ፥ አን ማዝቃላይፕ Ꮊት ዎ፥ ኑካ ኤዛ አማኖዳ። <verse eid="MAT 27:42"/><verse number="43" style="v" sid="MAT 27:43"/>ጾሳል ኤ አማንንትዛ፥ ጾሳይ ኤዛ አሾዳይስ ኮይኮ አን አሾ። አብስ ጊኮ፥ ኤ ፋና፥ ‹ታኒ ጾስ ናአ› ግዛ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">27:43 </char><char style="xt" closed="false"><ref loc="PSA 22:8">ማዝ. 22:8</ref></char></note><verse eid="MAT 27:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 27:44"/>ማ ሀራ አቶዝን፥ ኤዛር ማዝቃለል አፋ ሶትንቴዝ ፓንታይፕ ፐታይ Ꮊይ ጋርክ ግ ኤዛል አፋ ቃልዴዛ።<verse eid="MAT 27:44"/></para>
  <para style="s1">የሱሳ Ꮊይቆ</para>
  <para style="r">(<ref loc="MRK 15:3-41">ማር. 15:3-41</ref>፤ <ref loc="LUK 23:44-49">ሉቃ. 23:44-49</ref>፤ <ref loc="JHN 19:28-30">ዋን. 19:28-30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45"/>ኡሱፑን ሳተፕ Ꮊንጊ፥ ኡዱፉን ሳተ ሄሎዳይስ ቢታ ኡባይ ሜዛ። <verse eid="MAT 27:45"/><verse number="46" style="v" sid="MAT 27:46"/>ኡዱፉን ሳተ ማቄዛን ጋርክ የሱሳ፥ «ኤሎሄ፥ ኤሎሄ፥ ላማ ሳባቅታኒ?» ግ ግታ ኡፎ ኡኬዛ። «ኤሎሄ፥ ኤሎሄ፥ ላማ ሳባቅታኒ?» ጉሳይስ ብርሽይ «ታ ጾሳዮ፥ ታ ጾሳዮ፥ ታና አብስ አሻሬ?» ጉሲ።<note caller="-" style="x"><char style="xo" closed="false">27:46 </char><char style="xt" closed="false"><ref loc="PSA 22:1">ማዝ. 22:1</ref></char></note><verse eid="MAT 27:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47"/>ኤዛይድ ኤቄዝ አሳይፕ ፐታይ ፐታይ የያ ስኢ፥ «Ꮊ አይ ኤላሳ ጼግዛ» ዬጌዛ። <verse eid="MAT 27:47"/><verse number="48" style="v" sid="MAT 27:48"/>እዝር ኡንታፕ ፐታይ ዎጺ Ꮊንጊ፥ ዛንዛር ጫላ ዎይነ ኡሽ ኤኪ። የያ ሾምቦቆ ጉፈ ጼራል ጋዲ ኡሾዳይስ ኤ ዶናይኮ ኡክዛ።<note caller="-" style="x"><char style="xo" closed="false">27:48 </char><char style="xt" closed="false"><ref loc="PSA 69:21">ማዝ. 69:21</ref></char></note> <verse eid="MAT 27:48"/><verse number="49" style="v" sid="MAT 27:49"/>ዝን Ꮊንክታይ፥ «አሾይታ፥ ኤላሳ ኤዛ አሾዳይስ የኦዳዛኮ አን ዎላ በአዳ» ዬጌዛ። <verse eid="MAT 27:49"/><verse number="50" style="v" sid="MAT 27:50"/>የሱሳ ናምእን ግታ ኡፎ ኡኪ፥ Ꮊይቄዛ።<verse eid="MAT 27:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51"/>የ ሳታይድ ጾስ ካራ ሶጽንቴዝ ማጋራዣይ ዎኮ ጼራፕ የኮ ጼራ ሄሎዳይስ ናምኢ ከዚ፥ ፐርእንቲ ዎዛ። ቢታ ኤንኤዛ፥ ዛልታይካ ጳልቂንቴዛ።<note caller="-" style="x"><char style="xo" closed="false">27:51 </char><char style="xt" closed="false"><ref loc="EXO 26:31">ከስ 26:31</ref></char></note> <verse eid="MAT 27:51"/><verse number="52" style="v" sid="MAT 27:52"/>ዱፍታይ ዶይንትን ጌሽ አስታይፕ ጋምታይ Ꮊይቆፕ ደንዴዛ። <verse eid="MAT 27:52"/><verse number="53" style="v" sid="MAT 27:53"/>የሱሳ Ꮊይቆፕ ደንዴዛይፕ ጉየ ኡንቲ ዱፎፕ ከዚ፥ ጌሽ ካታማ ቅቴዛ፤ ኤዛይድ ኡንደና አሳይስ በንቴዛ።<verse eid="MAT 27:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54"/>ማቶ ሀላቃይኔ ኤዛር የሱሳ ናግዛ ዎታዳርታይ ቢታይ ኤንኤዛኔ አቃይድ ሀኔዝባዛ በኤዝ ዎደ ጋመ ያሽቲ «ቱማ Ꮊይ ጾስ ናአ» ዬጌዛ።<verse eid="MAT 27:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55"/>የይድ ጋመ ማችታይ፥ ጋልላፕ አይኪ የሱሳ ማድታር ካሌዝታይ ሃኮር ኤቂ ብእዛ።<note caller="-" style="x"><char style="xo" closed="false">27:55-56 </char><char style="xt" closed="false"><ref loc="LUK 8:2-3">ሉቃ. 8:2-3</ref></char></note> <verse eid="MAT 27:55"/><verse number="56" style="v" sid="MAT 27:56"/>ኡ ጋንጨ ማግዴላ ማይራማ፥<note caller="+" style="f"><char style="fr" closed="false">27:56 </char><char style="fqa" closed="false">ማግዴላ ማይራሞ፦ </char><char style="ft" closed="false">ጉሳይ ማግዴላ ግዝ ካታማፕ የኤዛ ማይራሞ ጉሲ።</char></note> ያይቆባራኔ ዮሴፋ እንዳት ማራማኔ ዛብዶሳ ናእታይ እንዳት የዛ።<verse eid="MAT 27:56"/></para>
  <para style="s1">የሱሳ ሞግንቴዛ</para>
  <para style="r">(<ref loc="MRK 15:42-47">ማር. 15:42-47</ref>፤ <ref loc="LUK 23:50-56">ሉቃ. 23:50-56</ref>፤ <ref loc="JHN 19:38-42">ዋን. 19:38-42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57"/>ሳአ ለምእለምኦዳር ዮሴፋ ግዝ ፐቲ ዱረ አይ፥ አርማታሳ ካታማፕ የኤዛ። ኤ ፋ ኡባስካ የሱሳ ካልዛ አሲ። <verse eid="MAT 27:57"/><verse number="58" style="v" sid="MAT 27:58"/>ዮሴፋ ጵላጾሳኮ Ꮊንጊ፥ የሱሳ አሃ ኤኮዳይስ ዎሴዛ። ጵላጾሳ አሃይ ዮሴፋስ እንግንቶድ ጋርክ አዛዜዛ። <verse eid="MAT 27:58"/><verse number="59" style="v" sid="MAT 27:59"/>የሱሳ አሃ ኤኪ፥ ጌሽ አፍላር ሳዋጼዛ። <verse eid="MAT 27:59"/><verse number="60" style="v" sid="MAT 27:60"/>ሹቻፕ ዎጬዝ ኦሮ ዱፎ ጋንጨ አሃ ጋዴዛ። ማ የ ዱፋይ ዶናይድ ዳማ ሹች ጎልእሲ ጋዲ ቅቴዛ። <verse eid="MAT 27:60"/><verse number="61" style="v" sid="MAT 27:61"/>ማግዴላ ማይራምራ Ꮊንኮ ማይራማ የ ዱፋይኮ ማቂ በቴዛ።<verse eid="MAT 27:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62"/>ዎንት ማላ ጋላስ፥ ቄሰ ሀላቅታይኔ ፈርሳውታይ ጵላጾሳኮ ይኢ፥ Ꮊይ ጋርክ ዬጌዛ፦ <verse eid="MAT 27:62"/><verse number="63" style="v" sid="MAT 27:63"/>«ጎዳዮ፥ Ꮊ ባልዛይ ፓ የዛር፥ ‹ታኒ ሀይ ጋላሳፕ ጉየ Ꮊይቆፕ ደንዶዳ› ዬጌዛይ ኑስ ኤልቂ ጌዛ።<note caller="-" style="x"><char style="xo" closed="false">27:63 </char><char style="xt" closed="false"><ref loc="MAT 16:21">ማቶ. 16:21</ref>፤ <ref loc="MAT 17:23">17:23</ref>፤ <ref loc="MAT 20:19">20:19</ref>፤ <ref loc="MRK 8:31">ማር. 8:31</ref>፤ <ref loc="MRK 9:31">9:31</ref>፤ <ref loc="MRK 10:33">10:33</ref></char></note> <verse eid="MAT 27:63"/><verse number="64" style="v" sid="MAT 27:64"/>የይ ግሾስ፥ ኤ ሞግንቴዝ ዱፋ ሀይ ጋላስ ሄሎዳይስ፥ ሚን ናጎድ ጋርክ አዛዞባ። የይ ሀናም እጽኮ፥ ኤ ታማርታይ Ꮊንጊ ኤ አሃ ካስቲ ብሲ፥ ‹Ꮊይቆፕ ደንዴዛ› ዬጊ ዎያይስ ኦድኮ ናምእን ባልይ ቲናሳይፕ ኡባ Ꮊና ኢቶዳ» ዬጌዛ።<verse eid="MAT 27:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65"/>ጵላጾሳ ኡንትኮ፥ «ይንትስ ናግዝታይ የዛ፤ Ꮊንጊ ይንትስ ዳንዳእንቴዛይ ጋርክ ናግሶይታ» ዬጌዛ።<verse eid="MAT 27:65"/></para>
  <para style="p">
    <verse number="66" style="v" sid="MAT 27:66"/>የይ ግሾስ፥ ኡንቲ Ꮊንጊ ዱፋይ ቦችንታማይ ጋርክ ሹቻይል አፋ ማታመ አታሚ ዎታዳርታይር ዎላ ጎርዲ ናግሴዛ።<verse eid="MAT 27:66"/></para>
  <chapter eid="MAT 27"/>
  <chapter number="28" style="c" sid="MAT 28"/>
  <para style="s1">የሱሳ Ꮊይቆፕ ደንዶ</para>
  <para style="r">(<ref loc="MRK 16:1-10">ማር. 16:1-10</ref>፤ <ref loc="LUK 24:1-12">ሉቃ. 24:1-12</ref>፤ <ref loc="JHN 20:1-10">ዋን. 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1"/>ማላ ጋላሳይ ኣዝ ዎጋ ዎደ ጉራ፥ ማግዴላ ማይራምራ Ꮊንኮ ማይራማ የሱሳ ሞግንቴዝ ዱፋ በአዳይስ Ꮊንጌዛ። <verse eid="MAT 28:1"/><verse number="2" style="v" sid="MAT 28:2"/>ቆፐካ ዎልቃማ ቢታ ኤንኦ ሀኔዛ። ጎዳይ ኪታንቻይ ሳሎፕ ዎ ዱፋይ ዶናይል የዝ ሹቻ ጎልእሲ ኤዛል አፋ በቴዛ። <verse eid="MAT 28:2"/><verse number="3" style="v" sid="MAT 28:3"/>ኤ ጭራይ ዜልን ኣዝዛ። ኤ አፍላይካ ሻች ጋርክ ቦ። <verse eid="MAT 28:3"/><verse number="4" style="v" sid="MAT 28:4"/>ናግዝታይ ኪታንቻ ብኢ፥ ያሻር ኩኩሪ፥ Ꮊይቄዝ አስ ጋርክ ሀኔዛ።<verse eid="MAT 28:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5"/>ኪታንቻይ ማችታይኮ፥ «ያሽትፓተ ይ ማዝቃለል አፋ ሶትንቴዝ የሱሳ ኮይዛና ታ ኤርዛ። <verse eid="MAT 28:5"/><verse number="6" style="v" sid="MAT 28:6"/>ኤ ቲን ኦዴዛይ ጋርክ Ꮊይቆፕ ደንዴዛ፤ Ꮊይዳ ባያ። Ꮊና ይኢ ኤዛ ዎይዝ አቃ ቦኦይታ። <verse eid="MAT 28:6"/><verse number="7" style="v" sid="MAT 28:7"/>ይ Ꮊት ኤልሲ Ꮊንጊ፥ ኤ ታማርታይስ፥ ‹የሱሳ Ꮊይቆፕ ደንዴዛ። ማ ኤ ይንትፕ ቲናቲ ጋልላ Ꮊማዳ፤ ይ ኤዛ ኤዛይድ በአዳ› ዬጊ ኦዶይታ። ታኒ ይንትስ Ꮊያ ኦዶዳይስ የኤዛ» ዬጌዛ።<verse eid="MAT 28:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8"/>ኡንቲ ያሽትታራኔ ጋመ ኡፋይትታር፥ ዱፋይ ላንቃይፕ ኤልሲ Ꮊንጊ፥ ኤ ታማርታይስ ኦዶዳይስ ዎጼዛ።<verse eid="MAT 28:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 28:9"/>ቆፐካዝን የሱሳ ኡንታር ዎል ሄሊ ኡንትኮ፥ «ሳሮ ይንትስ ማቆ» ዬጌዛ። ኡንቲ ኤዝኮ ሺቂ፥ ኤ ቶካ አይኪ ኤዝስ ጎይኔዛ። <verse eid="MAT 28:9"/><verse number="10" style="v" sid="MAT 28:10"/>የ ዎደ የሱሳ ኡንትኮ፥ «ያሽትፓተ፤ Ꮊንጊ ታ ታማርታይ ጋልላ Ꮊማድ ጋርክ ኡንትስ ኦዶይታ። ኡ ኤዛይድ ታና በአዳ» ዬጌዛ።<verse eid="MAT 28:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11"/>የ ማችታይ Ꮊማዳር፥ ዱፋ ናግዛ ዎታዳርታይፕ ባግታይ ካታማ Ꮊንጊ፥ ሀኔዝባዛ ኡብታ ቄሰ ሀላቅታይስ ኦዴዛ። <verse eid="MAT 28:11"/><verse number="12" style="v" sid="MAT 28:12"/>ቄሰ ሀላቅታይኔ ጭምታይ ሺቂ ቶቢ፥ ዎታዳርታይስ ጋመ ሚሸ እንጌዛ። <verse eid="MAT 28:12"/><verse number="13" style="v" sid="MAT 28:13"/>«‹ኑኒ ገንቴዝን ኤ ታማርታይ ቃማ ይኢ፥ ኤ አሃ ካስቴዛ› ዬጎይታ። <verse eid="MAT 28:13"/><verse number="14" style="v" sid="MAT 28:14"/>Ꮊ ኦዳ ጋደ አቅስዛይ ስእኮ፥ የይ ይ ቡታ ባዛ ኑኒ ኤዛ ኦዲ አማንዳ። ይንታን አብካ ህርግስፐ» ዬጌዛ።<verse eid="MAT 28:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 28:15"/>ዎታዳርታይ ሚሸ ኤኪ፥ ኪትንቴዛይ ጋርክ ኡዴዛ። Ꮊ ኦዳይ አይሁድታይ ካለ Ꮊይኖ ሄሎዳይስ ኦድንትታር የዛ።<verse eid="MAT 28:15"/></para>
  <para style="s1">ዳማ ኪታ</para>
  <para style="r">(<ref loc="MRK 16:14-18">ማር. 16:14-18</ref>፤ <ref loc="LUK 24:36-49">ሉቃ. 24:36-49</ref>፤ <ref loc="JHN 20:19-23">ዋን. 20:19-23</ref>፤ <ref loc="ACT 1:6-8">ሀዋ. ኦ. 1:6-8</ref>፤ <ref loc="1CO 15:3-8">1ቆሮ. 15:3-8</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16"/>ታጶ ፐቲ ኤ ታማርታይ የሱሳ ኡንታን Ꮊንጎይታ ጌዝ ጋልላ ደረል አፋ Ꮊንጌዛ።<note caller="-" style="x"><char style="xo" closed="false">28:16 </char><char style="xt" closed="false"><ref loc="MAT 26:32">ማቶ. 26:32</ref>፤ <ref loc="MRK 14:28">ማር. 14:28</ref></char></note> <verse eid="MAT 28:16"/><verse number="17" style="v" sid="MAT 28:17"/>ኤዛይድ ኡንቲ ኤዛ በኤዝ ዎደ ኤዝስ ጎይኔዛ፥ ዝን ኡንታፕ ፐታይ ፐታይ ስዛ።<verse eid="MAT 28:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 28:18"/>የሱሳ ኡንትኮ ሺቂ፥ «ሳሎኔ ሳአ ማዉተ ኡባይ ታስ እንግንቴዛ። <verse eid="MAT 28:18"/><verse number="19" style="v" sid="MAT 28:19"/>ይኬ፥ ይንቲ ኡባ አቆ Ꮊንጊ፥ ዎንግላ ሳባኪ ታና ካልዝታ ማሆይታ፥ ኣዳ፥ ናአ፥ ጌሻ አያና ሱንር ዎያ ኡባ ጻማቆይታ።<note caller="-" style="x"><char style="xo" closed="false">28:19 </char><char style="xt" closed="false"><ref loc="ACT 1:8">ሀዋ. ኦ. 1:8</ref></char></note> <verse eid="MAT 28:19"/><verse number="20" style="v" sid="MAT 28:20"/>ታኒ ይንታን ኪቴዛ ኡባ ኡ ናጎድ ጋርክ ታማርሶይታ። ታኒ ዎደ ዉርስ ሄሎዳይስ ኡባ ዎደ ታ ይንታር የዛ» ዬጌዛ።<verse eid="MAT 28:20"/></para>
  <chapter eid="MAT 28"/>
</usx>
