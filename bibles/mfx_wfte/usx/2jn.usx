<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2JN" style="id">- Melo New Testament Ethiopic</book>
  <para style="h">2ዋንሳ</para>
  <para style="toc1">ዋንሳ ጻፌዝ ናምእን ኪታ</para>
  <para style="toc2">2ዋንሳ</para>
  <para style="toc3">2ዋን.</para>
  <para style="mt1">ዋንሳ ጻፌዝ ናምእን ኪታ</para>
  <para style="imt">ገሎ</para>
  <para style="ip">ዋንሳ ጻፌዝ ናምእን ኪታ፥ የሱሳ ሀዋረ ማቄዝ ጭማይ፥ ዋንሳ ጻፌዛ። ጻፍንቴዛይካ ማራጽንቴዝ ጎዳታትስነ እ ናእታይስ። ኦኒ ኤሬ፥ የይካ ፐቲ ዎሳ ኬትስኔ እዘ ጎይንዛ አሳይስ ማቀካ አታሚ። Ꮊ ቃን ኪታይ ጻፍንቴዛይ፥ ኡንቲ ዎል ሲቅንቶድ ጋርክ አካክሶዳይስኔ ዎርዶ አስታማርታይፐኔ ኡ ትምርታይፕ ናግንቶዳይ ጋርክ ቆፍሶዳይስ።</para>
  <para style="iot">2 ዋንሳ ኪታይ አይኬዝ ቆፍታ</para>
  <para style="io1">ሳሮ <char style="ior"><ref loc="2JN 1:1-3">1-3</ref> </char></para>
  <para style="io1">ሲቆ ኡባይፕ ኣ <char style="ior"><ref loc="2JN 1:4-6">4-6</ref> </char></para>
  <para style="io1">ዎርዶ ትምርታይፕ ናግንቶ <char style="ior"><ref loc="2JN 1:7-11">7-11</ref> </char></para>
  <para style="io1">ኩስተ ቆፋ <char style="ior"><ref loc="2JN 1:12-13">12-13</ref> </char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="2JN 1"/>
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1"/>ታ ጭማይ ማራጽንቴዝ ጎዳታትስኔ እ ናእታይስ ኪቴዝ ኪታ። ታ ኣዳ ባዝን ቱማ ኤርዝታይ ኡባይ ይንታን ዶስዛ። <verse eid="2JN 1:1"/><verse number="2" style="v" sid="2JN 1:2"/>Ꮊ ቱማይ ኑር የዛ ግሾኔ ቲናስ መናስካ ኑር የዞዳይ ግሾስ ታኒ ይንታን ቱሮ ዶስዛ።<verse eid="2JN 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2JN 1:3"/>ጾስ አዳይፕ ኤ ናአ የሱስ ክርስቶሳፕ ኣ ኬሃትይ፥ ማሮትይኔ ሳሮትይ ቱማራኔ ሲቆር ዎላ ኑር ማቆ።<verse eid="2JN 1:3"/></para>
  <para style="s1">ቱማባጋኔ ሲቆ ባጋ</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4"/>አዳይ ኑና አዛዜዛይ ጋርክ፥ ነ ናእታይፕ ፐታይ ፐታይ፥ ቱማር ሚንጊ ኤቄዛና ብኢ ታኒ ሎእ ኡፋይቴዛ። <verse eid="2JN 1:4"/><verse number="5" style="v" sid="2JN 1:5"/>ጎዳቴ፥ Ꮊተካ ኑኒ ኡባይ ፐታይ ፐታ ሲቆዳይ ጋርክ ታኒ ነና ዎስዛ። Ꮊ አዛዛይ ቲናፕ ኑር የዛ አዛዞፕ አትን ታኒ ኔስ ጻፍዛይ ኦሮ አዛዞ ባያ።<note caller="-" style="x"><char style="xo" closed="false">5 </char><char style="xt" closed="false"><ref loc="JHN 13:34">ዋን. 13:34</ref>፤ <ref loc="JHN 15:12">15:12</ref>፥ <ref loc="JHN 15:17">17</ref></char></note> <verse eid="2JN 1:5"/><verse number="6" style="v" sid="2JN 1:6"/>ቱማ ሲቃይ ኑኒ ጾስ አዛዛ ፎሎ። ማ ቲናፕ ይ ስኤዛይ ጋርክ ኤ አዛዛይ፥ ይ ኡባይ ሲቆር የዞዳይ ጋርከስ።<verse eid="2JN 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7"/>የሱስ ክርስቶሳ አስ ማቂ የኤዛና አማኖዋ፥ ባለዛ ጋመ አስታይ፥ አላመል ደንዴዛ። የይ ጋርክ አስ ኦንካ ባለዛያኔ ክርስቶሳ ሞርከ። <verse eid="2JN 1:7"/><verse number="8" style="v" sid="2JN 1:8"/>ይ ኦዝ ኩን ዎይታ ኤኮዳይስ ሚንጎይታ። ይ ኦዛይ ባማይ ጋርክ ናግንቶይታ።<verse eid="2JN 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2JN 1:9"/>ክርስቶሳ ትምርታይድ ሚንጊ ኤቆዛይራኔ ኤ ትምርታይፕ ሃክታር Ꮊንግዛ አይር ጾሲ ባያ። ክርስቶሳ ትምርታይድ ሚንጊ ኤቄዛይር አዳይኔ ናአይ የዛ። <verse eid="2JN 1:9"/><verse number="10" style="v" sid="2JN 1:10"/>ኦንካ ይንትኮ ይእታር Ꮊ ትምርታ ኤከካ ይእኮ፥ ይ ካራ ገልስፓተ፤ ሳሮካ ጊፓተ። <verse eid="2JN 1:10"/><verse number="11" style="v" sid="2JN 1:11"/>ኤዛ ሳሮ ግዝ ኦንካ ኤ ኢታ ኦሳይድ ኤዛር ሻክንትዛ።<verse eid="2JN 1:11"/></para>
  <para style="s1">ዉርስ ሳሮ</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12"/>ታኒ ይንትስ ጻፎዳይስ ኮዬዝ ጋመ ባዝ የዛ፥ ዝን ዎርቃተር ጻፎዳይስ ኮዮያ። ኑ ኡፋይሳይ ፖልንቶዳይ ጋርክ ይንታር ዎል ሄሊ ኦድንቶዳይስ ይንትኮ Ꮊንጎዳ ግ ቆፕዛ።<verse eid="2JN 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13"/>ጾሲ ዶሬዝ ነ ምሽቲ ናእታይ ነና ሳሮ ዬግዛ።<verse eid="2JN 1:13"/></para>
  <chapter eid="2JN 1"/>
</usx>
