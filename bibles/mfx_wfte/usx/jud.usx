<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JUD" style="id">- Melo New Testament Ethiopic</book>
  <para style="h">ይሁዳ</para>
  <para style="toc1">ይሁዳ ጻፈዝ ኪታ</para>
  <para style="toc2">ይሁዳ</para>
  <para style="toc3">ይሁ.</para>
  <para style="mt1">ይሁዳ ጻፌዝ ኪታ</para>
  <para style="imt">ገሎ</para>
  <para style="ip">ይሁዳ ኪታይ ጻፍንቴዛይ፥ አማነካዛር አማንዛ አሲ ኣዚ ዎርዶ ትምርተ ዘርዝ አስታይፕ ክርስታንታይ ናግንቶድ ጋርክ አካክሶዳይሲ። Ꮊ ሃታ ኪታይ ፋ ጋንጨ አይኬዝ ቆፋይ ናምእን ጵጽሮሳ ኪታና ኣዝዛ። ጻፋይ፥ «አማንዛ አስስ ጾሲ ላማማይስ ፐቲ ቶኬ እንግንቴዝ አማኖስ ሚንጊ ኦልንቶይታ» ዬጊ ናባብዝታ ሚን ቆፍስዛ።</para>
  <para style="iot">ይሁዳ ኪታይ አይኬዝ ቆፍታ</para>
  <para style="io1">ሳሮ <char style="ior"><ref loc="JUD 1:1-2">1-2</ref> </char></para>
  <para style="io1">ዎርዶ አስታማርታይ ትምርተኔ ኡ ፎክ <char style="ior"><ref loc="JUD 1:3-16">3-16</ref> </char></para>
  <para style="io1">አማኖ ናጎድ ጋርክ እንግንቴዝ ዞረ <char style="ior"><ref loc="JUD 1:17-23">17-23</ref> </char></para>
  <para style="io1">ጋላታ ዎሳ <char style="ior"><ref loc="JUD 1:24-25">24-25</ref> </char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="JUD 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JUD 1:1"/>ታ ይሁዳ፥ የሱስ ክርስቶሳ አይላይ፥ ያይቆባ እሻይ፤</para>
  <para style="p" vid="JUD 1:1">ጾሲ ጼጌዝታይስ፥ ጾስ አዳይ ዶስዝታይስኔ የሱስ ክርስቶሳር ናግንተዝታይስ፥<note caller="-" style="x"><char style="xo" closed="false">1 </char><char style="xt" closed="false"><ref loc="MAT 13:55">ማቶ. 13:55</ref>፤ <ref loc="MRK 6:3">ማር. 6:3</ref></char></note><verse eid="JUD 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JUD 1:2"/>ማሮት፥ ሳሮትኔ ሲቆ ይንትስ ኩሞ።<verse eid="JUD 1:2"/></para>
  <para style="s1">ዎርዶ አስታማርታ</para>
  <para style="p">
    <verse number="3" style="v" sid="JUD 1:3"/>ታ ሲቆ እሽታዮ፥ ኑ ፐትፕ ዎላ ሻግንትዛ ፋጾትይ ባጋ ይንትስ ጻፎዳይስ ታ ኢታ አሞቴዛ ዝን አማንዛ አሳይስ ላማማይስ ፐቲ ቶኬ እንግንቴዝ አማናይስ ኦልንቶዳይ ጋርክ ይንታን ዞርታር ጻፎዳይስ ታስ ኮሽዛ ባዝ ማቄዛ። <verse eid="JUD 1:3"/><verse number="4" style="v" sid="JUD 1:4"/>ኡ ፕርዳይ ብንፕ ጻፍንቲ በቴዝ ፐቲ ፐቲ አስታይ ኦካ ኤረካዝን ይ ጋንጨ ዙርቅንቲ ገሌዛ። ኡንቲ ጾስ ኤሮዝታ፥ ኡ ኑ ጾሳይ ኣ ኬሄት ጋሰ ኡዲ ጋንጨር ቱና ባዝ ኡድዛ። ፋ ኣዳስ ካትኔ ጎዳ ማቄዝ፥ የሱሳ ክርስቶሳ ካድዛ።<verse eid="JUD 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JUD 1:5"/>Ꮊ ኡባ ፐቲ ቶኬ ኤርዛ ባዝ ማቅኮካ፥ ጎዳይ እስሬለ አሳ ግብጸ ቢታፕ ዋይዚ ከሴዛኮ፥ ማ ጉየፕ አማኖዝታ ብሴዛ ታ ይንታን አካክሶዳይስ ኮይዛ።<note caller="-" style="x"><char style="xo" closed="false">5 </char><char style="xt" closed="false"><ref loc="EXO 12:51">ከስ 12:51</ref>፤ <ref loc="NUM 14:29-30">ታይ. 14:29-30</ref></char></note> <verse eid="JUD 1:5"/><verse number="6" style="v" sid="JUD 1:6"/>ፋ የዛበሳ አሺ፥ ፓስ እንግንቴዝ ማዉታ ናገካ ኪታንችታ፥ ግታ ፕርደ ጋላስ ሄሎዳይስ ጾሳይ ኡንታን ማ ጋንጨ መናስ ሳንላተር አጪ ጋዴዛ። <verse eid="JUD 1:6"/><verse number="7" style="v" sid="JUD 1:7"/>የይ ጋርክ፥ ሶዶማኔ ጋሞራ አስታይኔ ኡ ላንቀ የዝ ካታምታይድ የዝ አስታይ ላግቴዛ፤ ላግታር ዎላ ቱና ቤዞዋ ባዝ ኦዛ። ኡንቲ መናስ ታማ ጋንጨ ሴርንትዝታይስ ኣዝሶ ማቄዛ።<note caller="-" style="x"><char style="xo" closed="false">7 </char><char style="xt" closed="false"><ref loc="GEN 19:1-24">መ. 19:1-24</ref></char></note><verse eid="JUD 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JUD 1:8"/>የይ ጋርከካ፥ Ꮊ ኤልሞትዝታይ ፋ አሻ ቱንሴዛ፤ ማዉተር የዝ አድታ ለቂዛ፤ ሳሎ የዝ ቦንችንቴዝ መትታካ ጫዥዛ። <verse eid="JUD 1:8"/><verse number="9" style="v" sid="JUD 1:9"/>ኪታንችታይ ሀላቃ ምካኤለካ ሙሰ አሃይስ ዳቡሎሳር ፓላሜዝ ጋላስ «ጎዳይ ነና ሴሮ» ዬጌዛፕ አትን ኤዛል አፋ ጫዦዳይስ ኮየካያ።<note caller="-" style="x"><char style="xo" closed="false">9 </char><char style="xt" closed="false"><ref loc="DAN 10:13">ዳነ. 10:13</ref>፥ <ref loc="DAN 10:21">21</ref>፤ <ref loc="DAN 12:1">12:1</ref>፤ <ref loc="REV 12:7">ዋን. ቆን. 12:7</ref>፤ <ref loc="DEU 34:6">ናምእ. 34:6</ref>፤ <ref loc="ZEC 3:2">ዛክ. 3:2</ref></char></note> <verse eid="JUD 1:9"/><verse number="10" style="v" sid="JUD 1:10"/>ዝን Ꮊ አስታይ ፓስ ኤሮዋ ባዝ ኡባ ጫዥዛ፤ ማ ኡንቲ ዎዝና ባ መሄ ጋርክ መትይር ኤርኮካ፥ እዛ ኡንታን ብሶዳ። <verse eid="JUD 1:10"/><verse number="11" style="v" sid="JUD 1:11"/>ኡንታን አየ! ኡ ቃኤላ ኦገ Ꮊንጌዛ። ሚሸ ኮዪ ባላማ ጋርክ ቡታ ጋንጨ ዎዛ። ቆረ ጾሳል አፋ ደንዴዛይ ጋርክ ኡ ጾሳል ደንዲ ቤዛ።<note caller="-" style="x"><char style="xo" closed="false">11 </char><char style="xt" closed="false"><ref loc="GEN 4:3-8">መ. 4:3-8</ref>፤ <ref loc="NUM 22:1-35">ታይ. 22:1-35</ref>፤ <ref loc="NUM 16:1-35">16:1-35</ref></char></note><verse eid="JUD 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JUD 1:12"/>Ꮊ አሳይ፥ ዬላ ባይ ይ ሲቆ እማቶ ሚዝ አቆ ይንታር ማዳይስ በቲ ቃይጽንትዛ ላፍታ። ኡ ፋባዝ ኣዳስ ቆፕዝታ። ኡ ጫርኮ ጋርከኔ እራ ባ ሻራ ጋርከ። ማ ኣፍዝ ዎደ ኣፈ ኣፈካዛር፥ ጻጶር ሾድንቲ፥ ናምኢ ቶኬ መሌዝ ም ጋርከ። <verse eid="JUD 1:12"/><verse number="13" style="v" sid="JUD 1:13"/>ኡ ኤንእዛ አባ ዙሎ ጋርክ ፋ ዬላስ ጋፑንትዝታ። ኡንቲ መናስ ልንጽ ጌዝ ማ ናግዝ ዳቡርዛ ጾልንትታ።<verse eid="JUD 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JUD 1:14"/>አዳመፕ አይኪ፥ ላፑን የለት ማቄዝ ሄኖኬ፥ Ꮊ አሳይ ባዝ ትንቢተ ኦድታር፥ «ዬዛኮ፥ ጎዳይ፥ ፋ ጋመ ሙኩለ ጌሽታይር የኦዳ።<note caller="-" style="x"><char style="xo" closed="false">14 </char><char style="xt" closed="false"><ref loc="GEN 5:18">መ. 5:18</ref>፥ <ref loc="GEN 5:21-24">21-24</ref></char></note> <verse eid="JUD 1:14"/><verse number="15" style="v" sid="JUD 1:15"/>አስ ኡባ ፕርዶዳ፤ ኡባ ኡ ኦዝ ኢታ ኦ ኡባይ ግሾኔ ኤርታር ኡ ጾሳል ኦድንቴዝ ኢታ ኦዳይ ኡባይ ግሾ ፕርዶዳ» ዬጌዛ። <verse eid="JUD 1:15"/><verse number="16" style="v" sid="JUD 1:16"/>የ አሳይ ኡባ ዎደ ዝግርዝታኔ ኦዳ ኮይዝታ። ማ ፋ ኢታ አሞ ካልዛ፤ ፓስ ጬቅንትዛ ፋና አድዛ ባዝ ደንጎዳይስ ሀራ አስታ ገሽንትዛ።<verse eid="JUD 1:16"/></para>
  <para style="s1">ናግሶኔ ዞረ</para>
  <para style="p">
    <verse number="17" style="v" sid="JUD 1:17"/>ዝን ታ ሲቅታዮ፥ ኑ ጎዳ የሱሳ ክርስቶሳ ሀዋርታይ ቲን ይንትስ ኦዴዝ ቃላ አካኮይታ። <verse eid="JUD 1:17"/><verse number="18" style="v" sid="JUD 1:18"/>ኡ፥ «ዉርስ ዎደ፥ ጾስ ሸነፕ ሃኪ ፋ አሞ ካሊ ቶችዝታይ የኦዳ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">18 </char><char style="xt" closed="false"><ref loc="2PE 3:3">2ጵጽ. 3:3</ref></char></note> <verse eid="JUD 1:18"/><verse number="19" style="v" sid="JUD 1:19"/>የ አሳይ አስ ጋንጨ ጳልቂ መዝታ፥ ፋ አሾ አሞስ ሞድንትዝታኔ ጌሻ አያና ባዝታ።<verse eid="JUD 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JUD 1:20"/>ዝን ታ እሹን፥ ጌሽ ማቄዝ ይ አማናትር ድጮዳይስ ምንጎይታ፤ ማ ጌሻ አያና ዎልቃር ዎሶይታ። <verse eid="JUD 1:20"/><verse number="21" style="v" sid="JUD 1:21"/>ይንታን መና የዝዝ የስኮ ሄልድ ኑ ጎዳ የሱሳ ክርስቶሳ ማሮት ናግታር ይንታን ጾሳይ ሲቃይር ናጎይታ።<verse eid="JUD 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JUD 1:22"/>ሰእዛ አሳይስ ቃይታ። <verse eid="JUD 1:22"/><verse number="23" style="v" sid="JUD 1:23"/>ፐቲ ፐቲ አሳ ታማፕ ከሲ ኤኮይታ። ማ የይፕ ኢታ አሞር ቱኔዝ ኡ አፍላ እጽታር ሀራ አሳይስ ያሻር ማሮይታ።<verse eid="JUD 1:23"/></para>
  <para style="s1">ጋላታ ዎሳ</para>
  <para style="p">
    <verse number="24" style="v" sid="JUD 1:24"/>ይ ፎካማይ ጋርክ ኦዳይስኔ ቦሮ ባዝታ፥ ኡፋይሳር ኩሜዝታ ኡዲ ፋ ቦንቾ ቲና ይንታን ሺሾዳይስ ዳንዳእዛ፥ <verse eid="JUD 1:24"/><verse number="25" style="v" sid="JUD 1:25"/>ኑና አሽዛ ፐቲ ጾሳይስ፥ ኑ ጎዳ የሱሳ ክርስቶሳ ባጋር ቦንቾ፥ ዴታይ፥ ዎልቃይ፥ ማዉታይ፥ ብንካ፥ Ꮊተካ፥ መናስካ ኤስ ማቆ። አምንኤ።<verse eid="JUD 1:25"/></para>
  <chapter eid="JUD 1"/>
</usx>
