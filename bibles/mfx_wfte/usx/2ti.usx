<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2TI" style="id">- Melo New Testament Ethiopic</book>
  <para style="h">2ጽማቶሳ</para>
  <para style="toc1">ጳዉሎሳ ጽማቶሳስ ጻፌዝ ናምእን ኪታ</para>
  <para style="toc2">2ጽማቶሳ</para>
  <para style="toc3">2ጽማ.</para>
  <para style="mt1">ጳዉሎሳ ጽማቶሳስ ጻፌዝ ናምአን ኪታ</para>
  <para style="imt">ጋሎ</para>
  <para style="ip">ጳዉሎሳ ጽማቶሳስ ጻፌዝ ናምአን ኪታይ፥ ጳዉሎሳር ዎላ ኦዛኔ ጳዉሎሳ ካለ ማድዛ የላጋ ጽማቶሳና ዞሬዝ ዞራ አይኬዛ። የ ዞራይስ ኣፈ ቆፋይ፥ «ጋርዦር ሚንጎዳይ ጋርክ» ዬግዛ። ጽማቶሳ ዞረኔ ምን ቃላ ኤኬዛይ፥ የሱስ ክርስቶሳ ባጋ ቱማ ማርካቶዳይ ጋርክ ዎንግለ ቃላኔ ካሰ ጫቆ ትምርታ ሚን አይኮዳይ ጋርከ መቶኔ እጾ ጋንግኮካ ታማርሶራኔ ዎንግለ ሳባኮር ሚንጎዳይ ጋርከሲ።</para>
  <para style="ip">ጽማቶሳ ጨረ ቦዘት ፓላማፕ ሃኮዳይ ጋርክ ዱማ ምኖ ዞረ ኤስ እንግንቴዛ። የይ ጋርክ ኦዳይ አስ ብስዛፕ አትን አኮካ ማዶያ።</para>
  <para style="ip">የ ኡባይድ ጽማቶሳ አካኮዳይስ ቤዝዛይ፥ ጳዉሎሳ ሀናነ ኤ የሳ የይካ፥ ኤ አማኖ፥ ኤ ጋርዦ፥ ኤ ሲቆ፥ ኤ ሚንትኔ ኤዛ ሄሌዝ መታ ኣዝሶ ኡዲ ካሎዳይ ጋርከ። ጳዉሎሳ ፋ ላሶ ሃሲ Ꮊይቆስ ጊግንቴዝ ዎደ Ꮊ ኪታ ጻፌዛ።</para>
  <para style="iot">2 ጽማቶሳ ኪታይ አይኬዝ ቆፍታ</para>
  <para style="io1">ገሎ <char style="ior"><ref loc="2TI 1:1-2">1:1-2</ref> </char></para>
  <para style="io1">ጽማቶሳስ እንግንቴዝ ዞረ <char style="ior"><ref loc="2TI 1:3-2:13">1:3—2:13</ref> </char></para>
  <para style="io1">ዉርስ ዎደ ባጋ <char style="ior"><ref loc="2TI 2:14-4:5">2:14—4:5</ref> </char></para>
  <para style="io1">ጳዉሎሳ ሀኒ የዝ የሳይ <char style="ior"><ref loc="2TI 4:6-18">4:6-18</ref> </char></para>
  <para style="io1">ኩስተ ቆፋ <char style="ior"><ref loc="2TI 4:19-22">4:19-22</ref> </char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="2TI 1"/>
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1"/>ጾስ ሸነር፥ የሱስ ክርስቶሳፕ በንቴዝ ደኦ ኡፋይሳፕ ደንዴዛይድ የሱስ ክርስቶሳስ ሀዋረ ማቄዝ ጳዉሎሳፕ፥ <verse eid="2TI 1:1"/><verse number="2" style="v" sid="2TI 1:2"/>ታ ዶስዛ ናአ ጽማቶሳስ፤</para>
  <para style="p" vid="2TI 1:2">ጾስ አዳይፐኔ ኑ ጎዳ ክርስቶሳ የሱሳፐ ኣ ኬሄት፥ ማሮትኔ ሳሮት ማቆ።<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="ACT 16:1">ሀዋ. ኦ. 16:1</ref></char></note><verse eid="2TI 1:2"/></para>
  <para style="s1">ጽማቶሳስ እንግንቴዝ ዞረ</para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3"/>ታኒ፥ ታ ዎሳይድ ቃማኔ ጋላስ ነና ቆፕዛ። ታኒ ዎስዛ ዎደ ታ አድታይ ጋርክ ታ ሎኦ ካሃር ኤስ ኦዛ ጾሳ ነ ግሾስ ጋላትዛ። <verse eid="2TI 1:3"/><verse number="4" style="v" sid="2TI 1:4"/>ታኒ ነ አፉ ቆፕዛ፤ ነና ብኢ ኡፋይትዛና ጋመ ላሞትዛ።<verse eid="2TI 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2TI 1:5"/>ማ ኔስ የዝ ቱማ አማና ኤርዛ። የ አማናይ ብኒ ነ ዎጋ እንዳት ሎይድራኔ ነ እንዳት ኤዉንቀስ የዝ አማናይ ጋርከ።<note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="ACT 16:1">ሀዋ. ኦ. 16:1</ref></char></note> <verse eid="2TI 1:5"/><verse number="6" style="v" sid="2TI 1:6"/>የይ ግሾስ፥ ታኒ ታ ኩሻ ኔል አፋ ጋዴዝ ዎደ ጾሲ ኔስ እንጌዝ እሞታ ኔኒ ማሂ ኤዳይ ጋርክ ታ ነና ቆፍስዛ። <verse eid="2TI 1:6"/><verse number="7" style="v" sid="2TI 1:7"/>አብስ ጊኮ፥ ጾሲ ኑስ ዎልቃ፥ ሲቆኔ ኑ ኡባ ሃርዛ ጌሻ አያና እንጌዛፕ አትን ያሻ አያና እንገካያ።<verse eid="2TI 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 1:8"/>ይኬ፥ ኑ ጎዳይስ ማርካቶዳይስ ዬላትፐ፤ ማ ኤ ግሾስ አጭንቴዝ ታ ባጋራካ ዬላትፐ። ዝን ጾሲ ኔስ እንግዛ ዎልቃር ዎንግለ ግሾስ ታር መቶ ኤኮባ። <verse eid="2TI 1:8"/><verse number="9" style="v" sid="2TI 1:9"/>ጾሲ ፋ ሸነራኔ ፋ ኣ ኬሄትይር ኑና ዱማሲ፥ ፋ ጌሻ ዎያ ኡዶዳይስ ኑና ዶሬዛፕ አትን ኑኒ ኦዝ ኦሶ ግሾስ ባያ። Ꮊ ኣ ኬሃት ክርስቶሳ የሱሳ ባጋር አላመ መንቶዳይፕ ቲን ኑስ እንጌዛ። <verse eid="2TI 1:9"/><verse number="10" style="v" sid="2TI 1:10"/>Ꮊት Ꮊ ኣ ኬሄትይ ኑና አሽዛ ክርስቶስ የሱሳ ይእይር በንቴዛ። ኤ Ꮊይቆ ዎልቃ ብሲ፥ ዎንግለ ባጋር Ꮊይቆዋ ደኦ ኑስ ቆንጭሴዛ።<verse eid="2TI 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 1:11"/>ታኒ ዎንግለ ሳባኬ፥ ሀዋረኔ አስታማረ ማቃዳይ ጋርክ ጾሲ ታስ ማዉተ እንጌዛ።<note caller="-" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="1TI 2:7">1ጽማ. 2:7</ref></char></note> <verse eid="2TI 1:11"/><verse number="12" style="v" sid="2TI 1:12"/>ታኒ የይ ግሾስ Ꮊ መታ ኤክዛ፤ ዝን ታ አማኔዛይ ኦናዛኮ ኤርዛ ግሾስ ዬላታሚ። ታስ እንግንቴዝ ሀዳራ የሱሳ ማቂ የኦድ ጋላሳይ ሄሎዳይስ ኤ ናጎዳይስ ዳንዳእዛና ታ ኤርዛ።<verse eid="2TI 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2TI 1:13"/>ታኒ ነና ታማርሴዝ ቱማ ቃላ ኣዝሶ ኦሳ አይኪ ክርስቶሳ የሱሳር የዝ አማናይራኔ ሲቃይር የዞባ። <verse eid="2TI 1:13"/><verse number="14" style="v" sid="2TI 1:14"/>ኑ ጋንጨ የዝ ጌሻ አያና ዎልቃር ኔስ እንግንቴዝ ሎኦ ሀዳራ ናጎባ።<verse eid="2TI 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15"/>ኢሳ አዉራጃ የዝ ኡባይ ታፕ ሃኬዛና ነ ኤርዛ፤ ኡ ጋንጨ ፍገሉሳራኔ ሄርሞገኔሳራ የዛ።<verse eid="2TI 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 1:16"/>አነስፎራ ታና ኡንደና ዎደ ምንዝ ግሾስ ጎዳይ ኤ ካራ አሳይስ ቃንቶ። ታኒ አች ካራ የዝ ዎደ ኤ ታ አቻይዳካ ዬላተካያ። <verse eid="2TI 1:16"/><verse number="17" style="v" sid="2TI 1:17"/>የይል አፋ ኤ ኦሮመ ካታማ የኤዛን ጋርክ ታና ሚን ኮይ ደንጌዛ። <verse eid="2TI 1:17"/><verse number="18" style="v" sid="2TI 1:18"/>ዉርስ ጋላስ ጎዳይ ኤስ ቃንቶዳይ ጋርክ ታኒ ጎዳ ዎስዛ። ኤፈሶና ካታማ የዝ ዎደ ኤ ታና አብ ጋርክ ማዴዛኮ ነ ሎእ ኤርዛ።<verse eid="2TI 1:18"/></para>
  <chapter eid="2TI 1"/>
  <chapter number="2" style="c" sid="2TI 2"/>
  <para style="s1">የሱስ ክርስቶሳስ አማንንቴዝ ዎታዳረ ማቅ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1"/>ይኬ፥ ታ ናአዮ፥ ክርስቶሳ የሱሳር የዝ ኣ ኬሄትይር ምንጎባ። <verse eid="2TI 2:1"/><verse number="2" style="v" sid="2TI 2:2"/>ጋመ ማርክትር ቲና ታኒ ነና ታማርሴዝ ትምርታ፥ ሀራ ታማርሶዳይስ ዳንዳእዛ አማንንቴዝ አሳይስ ሀዳራ እንጎባ።<verse eid="2TI 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 2:3"/>የሱስ ክርስቶሳስ ሎኦ ዎታዳረ ማቂ ታር ዎላ መቶ ኤኮባ። <verse eid="2TI 2:3"/><verse number="4" style="v" sid="2TI 2:4"/>ዎታዳረ ፋና አዛዜዝ ፋ ሀላቃ ኡፋይሶዳይስ ጊግንትዛይፕ አትን ሀራ ኦሶር ፋና ግቶያ። <verse eid="2TI 2:4"/><verse number="5" style="v" sid="2TI 2:5"/>የይ ጋርከካ፥ ኣላሎ ዎጽዛ ኦንካ ህጋይስ ቤዝዛ ኦገር ዎጻም እጽኮ ጋም ዎይቶ ኤኮያ። <verse eid="2TI 2:5"/><verse number="6" style="v" sid="2TI 2:6"/>ቢታ ዎታር ዳቡርዛ ኦሶ አይ ፋ ዳቡራ ኣፋይፕ ሚዝ ቲና አስ ማቆዳይስ ቤዝዛ። <verse eid="2TI 2:6"/><verse number="7" style="v" sid="2TI 2:7"/>ጎዳይ ኡባባዛር ኔስ አካካ እንጎድ ግሾስ ታ ኔስ ኦዴዝባዛና ነ ዎዝናይድ ናጎባ።<verse eid="2TI 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 2:8"/>ታኒ ማርካትዝ ዎንግላይ Ꮊያ፥ Ꮊይቆፐ ደንዴዝ፥ ዳዉተ ዘረ ማቄዝ የሱስ ክርስቶሳ ቆፖባ። <verse eid="2TI 2:8"/><verse number="9" style="v" sid="2TI 2:9"/>ታኒ ዎንግለ ኦድዛ ግሾስ ዳፋ ኦዝ አስ ጋርክ፥ አጭንቲ መቶ ኤኬዛ። ዝን ጾሳ ቃላይ አጭንቶያ። <verse eid="2TI 2:9"/><verse number="10" style="v" sid="2TI 2:10"/>የይ ግሾስ፥ ጾሲ ማራጼዝ አስታይ ክርስቶሳ የሱሳፕ ደንጌዝ አቶትይ ባጋር መና ቦንቾ ኤኮዳይ ጋርክ ኡ ግሾስ ኡባ ባዛር ታ ዋይዛ።<verse eid="2TI 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 2:11"/>Ꮊይ ጋርክ ዬግዝ ቃላይ አማንንቴዛያ፤</para>
  <para style="q1" vid="2TI 2:11">«ኑኒ ኤዛር Ꮊይቄዝ ባዝ ማቅኮ፥</para>
  <para style="q2" vid="2TI 2:11">ኤዛር ዎላ ደኦር የዞዳ።<verse eid="2TI 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="2TI 2:12"/>ኑኒ ጋርዦር ምንግኮ፥</para>
  <para style="q2" vid="2TI 2:12">ኤዛር ዎላ ካዉቶዳ።</para>
  <para style="q1" vid="2TI 2:12">ኑኒ ኤዛ ካድኮ፥</para>
  <para style="q2" vid="2TI 2:12">ኤዝካ ኑና ካዶዳ።<verse eid="2TI 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="2TI 2:13"/>ኑኒ አማንንታም እጽኮ፥<note caller="-" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="MAT 10:33">ማቶ. 10:33</ref>፤ <ref loc="LUK 12:9">ሉቃ. 12:9</ref></char></note></para>
  <para style="q2" vid="2TI 2:13">ኤ አማንንቴዛያ ማቂ የዞዳ።</para>
  <para style="q1" vid="2TI 2:13">አብስ ጊኮ፥ ኤ ፋና</para>
  <para style="q2" vid="2TI 2:13">ካዶዳይስ ዳንዳኦያ» ዬግዛ።<verse eid="2TI 2:13"/></para>
  <para style="s1">ምኖ ኦሳንቾ</para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14"/>ኔኒ ኡንታን Ꮊያ ቆፕሶባ፤ ኡ ቃላይፕ ደንዴዛይድ ፓላማማይ ጋርክ፥ ጾስ ቲና ኡንታን ዞሮባ። የይ ስእዝታ ብስዛፕ አትን አኮካ ማዶያ። <verse eid="2TI 2:14"/><verse number="15" style="v" sid="2TI 2:15"/>ኔኒ ቱማ ቃላ ሉለትር ታማርስዛኔ ዬላዋ ኦሶ አስ ማቂ፥ ጾሳር ዶስንቴዝ አስ ጋርክ፥ ነናት ኤስ እንጎዳይስ ምንጎባ። <verse eid="2TI 2:15"/><verse number="16" style="v" sid="2TI 2:16"/>ዝን Ꮊ አላማይስ ሀንዛ ማዶዋ ባልቡቂ ኦዳይፕ ሃኮባ። የይ ጋርክ ኦዳይ አስ ጾሳፕ ሃክዛ። <verse eid="2TI 2:16"/><verse number="17" style="v" sid="2TI 2:17"/>የይ ጋርክ ትምርታይ አሰት ም ሃስዝ ጭቶ ክጻ ጋርከ። የይ ጋርክ ኦዳ ኦድንትዝታይ ጋንጨፕ ሄመኖሳራኔ ፍልጾሳር የዛ። <verse eid="2TI 2:17"/><verse number="18" style="v" sid="2TI 2:18"/>Ꮊ አስታይ ቱማ ኦጋ አሺ፥ «Ꮊይቄዝ አሳይ Ꮊይቆፐ ብኒ ደንዴዛ» ዬጊ ፐቲ ፐቲ አስታይ አማና ብሴዛ።<verse eid="2TI 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 2:19"/>ሀኖ ዝን፥ «ጎዳይ ኤስ ማቄዝታ ኤርዛ» ኡባራክ «ጎዳይ ሱን ጼግዝ ኦንካ ኢታ ኦሶፕ ሃኮ» ዬግዝ ማታመር የዝ ኤንኦዋ ጾስ ባሳይ ሚንጊ የዞዳ።<note caller="-" style="x"><char style="xo" closed="false">2:19 </char><char style="xt" closed="false"><ref loc="NUM 16:5">ታይ. 16:5</ref></char></note><verse eid="2TI 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2TI 2:20"/>ፐቲ ዳማ ኬ ዎርቃፕ ዎይ ብራፕ ኦስንቴዝ ሚሸ ኣዳ ባዝን ምፐኔ ዢጨ ቢታፕ ኦስንቴዝ ሚሽታይካ የዛ። የይትታይፕ ባግታይ ቦንቾ ኦሶስ፥ ማ ባግታይ ቶሽንትዛ ኦሶስ ፔዥዛ። <verse eid="2TI 2:20"/><verse number="21" style="v" sid="2TI 2:21"/>የይ ግሾስ፥ ኦንካ ኢታ ኡባ አሽኮኔ ፋና ጌሽኮ፥ ቦንቾ ኦሶ ኦዛ ሚሸ ማቆዳ። ኡ የሳይ ጌሽኔ ጎዳ ኡፋይስዝ ባዝ፥ ማ ኡንቲ ሎኦ ኦሶ ኡባ ኦዳይስ ዳንዳእዝታ ማቆዳ።<verse eid="2TI 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 2:22"/>ናአት ኢታ አሞትፐ ሃኮባ። ጌሽ ዎዝናር ጎዳ ጼግዝ አሳይር ፐትፕ፥ ጽሎት፥ አማኖ፥ ሲቆኔ ሳሮት ካሎባ።<verse eid="2TI 2:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2TI 2:23"/>ዝን ካች መዛና ኤሪ ቦዘትኔ ጨረ ፓላማፕ ሃኮባ። <verse eid="2TI 2:23"/><verse number="24" style="v" sid="2TI 2:24"/>ጎዳ ኦሳንቻይ አስ ኡባይስ ኬሃ፥ ሎኦ ታማርስዛኔ ዳንዳአንቾ ማቆዳይስ ቤዝዛፕ አትን ካጭንቶዳይስ ቤዞያ። <verse eid="2TI 2:24"/><verse number="25" style="v" sid="2TI 2:25"/>ኤ ፓር ኤቅንትዝታ አሽከትር ሴርዛ ማቆዳይስ ቤዝዛ። ኡንቲ ፋ ናጋራይፕ ማቂ ቱማ ኤሮዳይ ጋርክ ጾሲ ኦዳዛኮ ኦኒ ኤረ። <verse eid="2TI 2:25"/><verse number="26" style="v" sid="2TI 2:26"/>ኡንቲ ፋ ዎዛናኮ ማቂ ፋ ሸነ ኡዶድ ጋርክ ኡንታን አይኬዝ ጻላሄ ጽካይፕ ቡቶዳ።<verse eid="2TI 2:26"/></para>
  <chapter eid="2TI 2"/>
  <chapter number="3" style="c" sid="2TI 3"/>
  <para style="s1">ዉርስ ጋላስ ሀኖድ ኢታ ባዝታ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1"/>ዉርስ ጋላስ ኡንእዛ ዎደ የኦዳና ኤሮባ። <verse eid="2TI 3:1"/><verse number="2" style="v" sid="2TI 3:2"/>አሳይ ፋና ዶስዝታ፥ ሚሸ ዶስዝታ፥ ጬቅንትዝታ፥ ኡትርትዝታ፥ ጫዥዝታ፥ ፋና የሌዝታይስ ኪትንቶዝታ፥ ጋላቶዝታ፥ ጌሸት ባዝታ፥ <verse eid="2TI 3:2"/><verse number="3" style="v" sid="2TI 3:3"/>ሲቆ ባዝታ፥ ማሮዝታ፥ ዝግርዝታ፥ ፋና ሃሮዝታ፥ ቃ ባዝታ፥ ሎኦ ዶሶዝታ፥ <verse eid="2TI 3:3"/><verse number="4" style="v" sid="2TI 3:4"/>ካድዝታ፥ ኤልስዝታ፥ ኡትራር ዳፍንትዝታ፥ ጾሳፕ ኣ አሾ ኡፋይሶዳይስ ዶስዝታ ማቆዳ። <verse eid="2TI 3:4"/><verse number="5" style="v" sid="2TI 3:5"/>ኡንቲ ጾስ ጎይንዝታ ኣዝዛፕ አትን ኤ ዎልቃ ካድዝታ፤ ኔኒ የይ ጋርክ አሳይፕ ሃኮባ።<verse eid="2TI 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 3:6"/>ኡንታፕ ፐታይ ፐታይ አስ ካራ ዙርቅንቲ ገሊ ጋመ ናጋራ ዶርንቴዝታኔ ዱማ ዱማ አሞር ጹግንትዝ አያና ዳቡሬዝ ማችታ ባልዝታይ ጋርከ። <verse eid="2TI 3:6"/><verse number="7" style="v" sid="2TI 3:7"/>የ ማችታ ኡባ ዎደ ታማርስዛ፥ ዝን ቱማ ኤሮዳይስ ዳንዳኦያ። <verse eid="2TI 3:7"/><verse number="8" style="v" sid="2TI 3:8"/>ያነሳኔ ያምባሬሳ ሙሰር ኤቅንትቴዛይ ጋርክ Ꮊ አስታይ ካሃ ኦዝታኔ አማኖር ዳቡሬዝ አስታ ማቄዝ ግሾስ ቱማር ካዝንትዛ።<note caller="-" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="EXO 7:11">ከስ 7:11</ref></char></note> <verse eid="2TI 3:8"/><verse number="9" style="v" sid="2TI 3:9"/>ዝን ኢያነሳኔ ኢያምብሬሳ ቦዘትይ ቆንጬዛይ ጋርክ ኡ ቦዘትይካ አስ ኡባይ ቲና ቆንጮድ ግሾስ ኡንትስ ሀነና።<verse eid="2TI 3:9"/></para>
  <para style="s1">ዉርስ ዞረ</para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10"/>ዝን ኔኒ ታ ትምርታ፥ ታ የሳ፥ ታ ቆፋ፥ ታ አማና፥ ታ ዳንዳአ፥ ታ ሲቃ፥ ታ ጋርዣ፥ <verse eid="2TI 3:10"/><verse number="11" style="v" sid="2TI 3:11"/>ታ ባይእንትኔ ታ መታ ነ ኤርዛ። አንጾካ፥ ኢቆኖነ፥ ልስጽራ ካታምታይድ ታና ሄለዝባዝኔ ታኒ ዳንዳኤዝ መታ ነ ኤርዛ፤ ጎዳይ ታና የ ኡባይፕ አሼዛ።<note caller="-" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="ACT 13:14-52">ሀዋ. ኦ. 13:14-52</ref>፤ <ref loc="ACT 14:1-20">14:1-20</ref></char></note> <verse eid="2TI 3:11"/><verse number="12" style="v" sid="2TI 3:12"/>ክርስቶሳ የሱሳር ጾስ ኡፋይስዛ የስ የዞዳይስ ኮይዝ ኡባይ ባይእንቶዳ። <verse eid="2TI 3:12"/><verse number="13" style="v" sid="2TI 3:13"/>ኢታ አሳይኔ ባልዝታይ ፓስ ባልንትታራኔ ሀርታ ባልታር ካሴሳይፕ ኣ ኢትታር ኢትታር Ꮊማዳ።<verse eid="2TI 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 3:14"/>ዝን ነ ታማሬዛይዳኔ ነ አማኔዝ ቱማይድ ሚንጊ ኤቆባ። ነ ኦፕ ታማሬዛኮ ነ ኤርዛ። <verse eid="2TI 3:14"/><verse number="15" style="v" sid="2TI 3:15"/>ኔኒ ነ ናአትፕ አይኪ ክርስቶሳ የሱሳ አማኒ አቶት ደንግዝ ኤጨት እንጎዳይስ ዳንዳእዛ ጌሻ ማጻፍታ ታማሪ ኤሬዛ። <verse eid="2TI 3:15"/><verse number="16" style="v" sid="2TI 3:16"/>ጌሻ ማጻፈ ኡባይ ጾስ አያና ጻፎድ ባዝ እንግን ጻፕንቴዝ ቃላ። የ ማጻፋይ ቱማ ታማርሶዳይስ፥ ባልንቴዝታ ሴሮዳይስ፥ ቡታ ሉልሶዳይስኔ ጽሎት የስስ ኮሽዛ ባዝ ዞሮዳይስ ማድዛ። <verse eid="2TI 3:16"/><verse number="17" style="v" sid="2TI 3:17"/>ጾስ አሲ ፖሎኔ ሎኦ ኦሶ ኡባይስ ጊግንቴዛ ማቆዳይ ጋርክ ማድዛ።<verse eid="2TI 3:17"/></para>
  <chapter eid="2TI 3"/>
  <chapter number="4" style="c" sid="2TI 4"/>
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1"/>ታኒ ነና ጾስ ቲና፥ ፓ የዝታይላኔ Ꮊይቄዝታይል ፕርዶዳይስ የዝ ክርስቶሳ የሱሳ ቲና ኤ ቆንጭይራኔ ኤ ካተትይር ዞርዛ። <verse eid="2TI 4:1"/><verse number="2" style="v" sid="2TI 4:2"/>ቃላ ሳባኮባ፤ ዎደ ጊግን ጊገካ አትን ሚንጊ ማርካቶባ። ጋመ ዳንዳአራኔ ታማርሶር አሳ ዞሮባ፥ ሴሪ ሉልሶባኔ ደንባ። <verse eid="2TI 4:2"/><verse number="3" style="v" sid="2TI 4:3"/>አሳይ ቱማ ትምርተ ስኣም እጾድ ዎደ የኦዳ። ኡንቲ ፋ አሞ ካሊ፥ ፓስ ስኦዳይስ ኡፋይስዝ ባዝ ኦድዝ አስታማርታ ሺሾዳ። <verse eid="2TI 4:3"/><verse number="4" style="v" sid="2TI 4:4"/>ኡንቲ ቱማ ባጋ ኦድዝ ትምርተ አሺ፥ ቱማ ማቀካ ኦዳ ስኦዳይስ ፋ ሀየ ማሆዳ። <verse eid="2TI 4:4"/><verse number="5" style="v" sid="2TI 4:5"/>ዝን ኔኒ ኡባ ባዛር ናግንቶባ። መቶ ዳንዳኦባ። ዎንግለ ማርካት ኦሶ ኡዶባ። ኔስ እንግንቴዝ ጾስ ኦሶ ኡባ ፖሎባ።<verse eid="2TI 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6"/>ታኒ ያርሾ ያርሽዛይ ጋርክ ያርሽንቶዳይስ ዎዳይ ሄሌዛ፤ Ꮊ አላማ አሺ Ꮊንግዛ ዎዳይ ሄሌዛ። <verse eid="2TI 4:6"/><verse number="7" style="v" sid="2TI 4:7"/>ታኒ ሎኦ ኦላ ኦልንቴዛ፤ ታ ኣላሎ ላሳ ሃሴዛ፤ አማና ናጌዛ። <verse eid="2TI 4:7"/><verse number="8" style="v" sid="2TI 4:8"/>Ꮊይፕ ጉየስ ጽሎት ዛዉደ<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="fqa" closed="false">ጽሎት ዛዉዳይ፦ </char><char style="ft" closed="false">ጽሎት የዝ ግሾስ ታ ኤኮድ ዛዉደ። ጽሎት ታስ ዛዉደ ኡዲ እንግዛ ጉሲ።</char></note> ታና ናግዛ። የያ ጌሽ ፕርዳ ፕርድዝ ጎዳይ የ ጋላስ ታስ እንጎዳ። የይ ታ ኣዳስ ባዝን ኤ ማቂ ይእ አሞትዝ ኡባይስ እንጎዳ።<verse eid="2TI 4:8"/></para>
  <para style="s1">ጳዉሎሳ ቡዞ ቆፍታ</para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9"/>ኤልሲ ታኮ የኦዳይስ ምንጎባ። <verse eid="2TI 4:9"/><verse number="10" style="v" sid="2TI 4:10"/>ዴማሳ Ꮊ አላማ ዶሲ፥ ታና አሺ፥ ተሰሎንቀ ካታማ ቅቴዛ። ቀርቅስማ ጋላትያ፥ ትቶኔ ድልማጻ ቢታ ቅቴዛ።<note caller="-" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="COL 4:14">ቆላ. 4:14</ref>፤ <ref loc="PHM 1:24">ፍልሞ. 24</ref>፤ <ref loc="2CO 8:23">2ቆሮ. 8:23</ref>፤ <ref loc="GAL 2:3">ጋላ. 2:3</ref>፤ <ref loc="TIT 1:4">ትቶ 1:4</ref></char></note> <verse eid="2TI 4:10"/><verse number="11" style="v" sid="2TI 4:11"/>ሉቃሳ ኣዳ ታር የዛ። ማርቆሳ ጾስ ኦሶር ታና ማዶዳይስ ዳንዳእዛ ግሾስ ኔር ኤኪ የኦባ።<note caller="-" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="COL 4:14">ቆላ. 4:14</ref>፤ <ref loc="PHM 1:24">ፍልሞ. 24</ref>፤ <ref loc="ACT 12:12">ሀዋ. ኦ. 12:12</ref>፥ <ref loc="ACT 12:25">25</ref>፤ <ref loc="ACT 13:13">13:13</ref>፤ <ref loc="ACT 15:37-39">15:37-39</ref>፤ <ref loc="COL 4:10">ቆላ. 4:10</ref></char></note> <verse eid="2TI 4:11"/><verse number="12" style="v" sid="2TI 4:12"/>ታኒ ትክቆሳና ኤፈሶና ካታማ ኪቴዛ።<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="ACT 20:4">ሀዋ. ኦ. 20:4</ref>፤ <ref loc="EPH 6:21-22">ኤፍ. 6:21-22</ref>፤ <ref loc="COL 4:7-8">ቆላ. 4:7-8</ref></char></note> <verse eid="2TI 4:12"/><verse number="13" style="v" sid="2TI 4:13"/>ኔኒ ይእታር፥ ጽሮአዳ ካታማ ካርፖሳ ላንቀ አሺ የኤዝ ታ ኮታኔ ማጻፍታ ታስ ኤኪ የኦባ። ኡባይፐካ ጻ ማጻፍታ ኤከካዛር ይእፐ።<verse eid="2TI 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 4:14"/>ጻርቂማለ ኦዝ ኢስክንድረ ታና ኢታ ቆሄዛ፤ ጎዳይ ኤ ኦሳይ ጋርክ ኤስ ጭጎዳ።<note caller="-" style="x"><char style="xo" closed="false">4:14 </char><char style="xt" closed="false"><ref loc="1TI 1:20">1ጽማ. 1:20</ref>፤ <ref loc="PSA 62:12">ማዝ. 62:12</ref>፤ <ref loc="ROM 2:6">ኦሮ. 2:6</ref></char></note> <verse eid="2TI 4:14"/><verse number="15" style="v" sid="2TI 4:15"/>ኤ ኑ ትምርታ እጽዛ ግሾስ ኤፕ ነና ናጎባ።<verse eid="2TI 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 4:16"/>ቲና ታ ሞትንቴዝ ዎደ ኡባይ አሺ ቅቴዛፕ አትን ኦንካ ታና ማደካያ። ጾሲ የ ቡታ ኡንትስ ታይብፐ። <verse eid="2TI 4:16"/><verse number="17" style="v" sid="2TI 4:17"/>ዝን ታኒ ኩን ኪታ አይሁደ ባ አስ ኡባይስ ማርካትን፥ ኡንቲ ስኦዳይ ጋርክ ጎዳይ ታ ካንታ ኤቂ ታስ ዎልቃ እንጌዛ። ማ ጋሞ ጋርክ ዶና ዶዬዝ Ꮊይቆፕ ታና አሼዛ። <verse eid="2TI 4:17"/><verse number="18" style="v" sid="2TI 4:18"/>ጎዳይ ታና ኢታ ኡባይፕ አሺ ሳሎ ካተት ሳሮር ሄልዳ። ኤስ መናፕ መና ሄሎዳይስ ቦንቾ ማቆ። አምንኤ።<verse eid="2TI 4:18"/></para>
  <para style="s1">ዉርስ ሳሮ</para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19"/>ጵርስቅላስ፥ አቂላስኔ አነስፎራ ካራ አሳይስ ታ ሳሮ ሄልባ።<note caller="-" style="x"><char style="xo" closed="false">4:19 </char><char style="xt" closed="false"><ref loc="ACT 18:2">ሀዋ. ኦ. 18:2</ref>፤ <ref loc="2TI 1:16-17">2ጽማ. 1:16-17</ref></char></note> <verse eid="2TI 4:19"/><verse number="20" style="v" sid="2TI 4:20"/>ኤራስጾሳ ቆሮንቶሳ ካታማ አቴዛ። ጽሮፍሞሳ ሀርግንቴዝ ግሾስ ምልጸ ካታማ ኤዛ አሼዛ።<note caller="-" style="x"><char style="xo" closed="false">4:20 </char><char style="xt" closed="false"><ref loc="ACT 19:22">ሀዋ. ኦ. 19:22</ref>፤ <ref loc="ROM 16:23">ኦሮ. 16:23</ref>፤ <ref loc="ACT 20:4">ሀዋ. ኦ. 20:4</ref>፤ <ref loc="ACT 21:29">21:29</ref></char></note> <verse eid="2TI 4:20"/><verse number="21" style="v" sid="2TI 4:21"/>ባርጎ ገሎዳይፕ ቲና ኤልሲ የኦባ።</para>
  <para style="p" vid="2TI 4:21">ኤዉቡሎሳ፥ ጱዴሳ፥ ልኖሳ፥ ቅላደኔ ሀራ አማንዛ አስታይ ኡባይ ነና ሳሮ ሳሮ ግዛ።<verse eid="2TI 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 4:22"/>ጎዳ የሱስ ክርስቶሳ ኔር ማቆ።</para>
  <para style="p" vid="2TI 4:22">ጾስ ኣ ኬሄትይ ይንታር ኡባይር ማቆ።<verse eid="2TI 4:22"/></para>
  <chapter eid="2TI 4"/>
</usx>
