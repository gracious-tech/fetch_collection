<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ACT" style="id">- Melo New Testament Ethiopic</book>
  <para style="h">ሀዋርታይ ኦሶ</para>
  <para style="toc1">ሀዋርታይ ኦሶ</para>
  <para style="toc2">ሀዋርታይ ኦሶ</para>
  <para style="toc3">ሀዋ. ኦ.</para>
  <para style="mt1">ሀዋርታይ ኦሶ</para>
  <para style="imt">ገሎ</para>
  <para style="ip">ሀዋርታይ ኦሶ ማጻፋይ፥ ሉቃሳ ዎንግለፕ ካሊ ጻፍንቴዝ ማጻፈ። Ꮊ ማጻፋይስ የዝ ዋና ቆፋይ ቲና የሱሳና ካሌዝ አስታይ ጌሻ አያናይ ካልን፥ ኤባዝ ኦድዛ ዎንግለ ቃላ፥ የሩሳላመ፥ ይሁዳ ቢታ ኡባይል፥ ሳማረ፥ ሳአ ጋጻፕ ጋጻ ሄሎዳይስ (1:8) ዋይዚ ሄልዛኮ ኦድዛ። ማጻፋይ፥ አማኖ አይሁደ አስታይፕ አይኪ፥ ኩን አላመል የዝ አስ ኡባይስ አማኖ ማቆድ ሄሎዳይስ ዋይዚ ዳልጌዛኮ ኦድዛ ታርከ። Ꮊ ማጻፋ ጻፌዛይ፥ አማንዛ አስታይ ኦሮመ ካተት ላሎዳይስ ጋንጨር ቶብንትዛ አስ ባዛኔ አማኖ አይሁድታይ ሀይማኖተ ፎሎ ኦዛ ማቄዛና ኤርሶዳይስ ሚንጊ ኦዛ።</para>
  <para style="ip">ሀዋርታይ ኦሶ ማጻፋይድ የሱሳ ባጋ ኦድዛ ዎንግላይ ሄልዛ አቆ ኡባ ዎደ ዳልግታር ዳልግታር Ꮊንግዛኔ ዎሳ ኬ ኤቆ ቆንጭስዝ ሀይ ኣፈ አቆ ሻክንቶዳይስ ዳንዳእዛ፦</para>
  <para style="ili">1. አማኖ የሩሳላመ ጃማሬዛይ የሱሳ ሳሎ ከዝኒ።</para>
  <para style="ili">2. አማኖ እስሬለ ጋደ ኡባ ሄሎ ባጋ።</para>
  <para style="ili">3. ኦሮመ ጉጂ መድትራነ አባ ዩሻር የዝ ጋደ ኡባይድ ዳልጌዛና ቤዝዛ።</para>
  <para style="ip">ሀዋርታይ ኦሶ ማጻፋይድ ኣ በንትዛይ ጌሻ አያና ኦሶ ማቆዳር፥ ጰንጸቆስጸ ጋላስ የሩሳላመ የዝ አማንዝታይል አፋ ዎልቃር ዎዛና ኦድዛ። የይ ጋርከካ፥ ማጻፋይ ጋንጨ ቆንጬዝ ኦስታ ኡባይል በንቴዛይ ጋርክ ጌሻ አያናይ ዎሳ ኬኔ ዎሳ ኬ አቅስዝታ ካልዛኔ ምንዛ ጉጂ ኦድዛ። ሀዋርታይ ኦሳይ ጋንጨ ኦስንቴዝ ኦስታይካ ኪታይ አማንዛ አሳይ ደኦላኔ ዎሳ ኬ ፐትፐተይድ የዝ ዎልቃይ አብ ጋርክ ዳማዛኮ ቤዝዛ።</para>
  <para style="iot">ሀዋርታይ ኦሶ ማጻፋይ አይኬዝ ቆፍታ</para>
  <para style="io1">ማርካተስ ጊግንቶ <char style="ior"><ref loc="ACT 1:1-26">1:1-26</ref> </char></para>
  <para style="io2">የሱሳ ዉርስ ኪታኔ ጌሻ አያና ባጋ እንጌዝ ቃላ <char style="ior"><ref loc="ACT 1:1-14">1:1-14</ref> </char></para>
  <para style="io2">ይሁዳ አቆ ማታሳ ዶርንቶ <char style="ior"><ref loc="ACT 1:15-26">1:15-26</ref> </char></para>
  <para style="io1">የሩሳላመ ማርካት <char style="ior"><ref loc="ACT 2:1-8:3">2:1—8:3</ref> </char></para>
  <para style="io1">ይሁዳኔ ሳማረ ማርካት <char style="ior"><ref loc="ACT 8:4-12:25">8:4—12:25</ref> </char></para>
  <para style="io1">ጳዉሎሳ ሀዋረት ኦሳ <char style="ior"><ref loc="ACT 13:1-28:31">13:1—28:31</ref> </char></para>
  <para style="io2">ቲና ሀዋረትስ Ꮊሞ <char style="ior"><ref loc="ACT 13:1-14:28">13:1—14:28</ref> </char></para>
  <para style="io2">የሩሳላመ ሺቆ <char style="ior"><ref loc="ACT 15:1-35">15:1-35</ref> </char></para>
  <para style="io2">ናምአን ሀዋረት Ꮊሞ <char style="ior"><ref loc="ACT 15:36-18:22">15:36—18:22</ref> </char></para>
  <para style="io2">ሃይን ሀዋረት Ꮊሞ <char style="ior"><ref loc="ACT 18:23-21:16">18:23—21:16</ref> </char></para>
  <para style="io2">ጳዉሎሳ የሩሳላመ፥ ቅሳራኔ ኦሮመ አጭንት <char style="ior"><ref loc="ACT 21:17-28:31">21:17—28:31</ref> </char></para>
  <chapter number="1" style="c" sid="ACT 1"/>
  <para style="p">
    <verse number="1-2" style="v" sid="ACT 1:1-2"/>ቶፍሎሳ፥ የሱሳ ፋ ኦሳ አይኬዝ ዎደፕ ሳሎ Ꮊንጌዝ ጋላስ ሄሎዳይስ፥ ኦዝባዝኔ ታማርሴዝባዝ ኡባ ታኒ ታ ቲና ማጻፋይድ ጻፌዛ። ሳሎ Ꮊንጎዳይፕ ቲና ኤ ፋ ዶሬዝ ሀዋርታ ጌሻ አያናር አዛዜዛ።<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="LUK 1:1-4">ሉቃ. 1:1-4</ref></char></note> <verse eid="ACT 1:1-2"/><verse number="3" style="v" sid="ACT 1:3"/>ኤ ፋ ኢታ ዋያ ኤኬዛይፕ ጉየ Ꮊይቆፕ ደንዴዛና ጋመ ማርካትር ስ ባይ ቆንጭሲ ኡንትስ ፋና ቤዜዛ። ኦይታም ጋላስ ኡንትስ ቆንጪ ጾስ ካተትባጋ ኡንታን ታማርሴዛ። <verse eid="ACT 1:3"/><verse number="4" style="v" sid="ACT 1:4"/>ፐቲ ዎደ ኡንታራ ዎላ የዛር ኡንታን Ꮊይ ጋርክ ዬጊ ኪቴዛ፦ «ታ ይንትስ ኦዴዛ፥ ታ አዳይ እማድ ጌዝ ኡፋይስ ቃላ ናጎይታፕ አትን የሩሳላመፕ ኬዝፓተ።<note caller="-" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="LUK 24:49">ሉቃ. 24:49</ref></char></note> <verse eid="ACT 1:4"/><verse number="5" style="v" sid="ACT 1:5"/>አብስ ጊኮ፥ ዋንሳ ሃር ጻማቄዛ፥ ዝን ጽቃ ዎደፕ ጉየ ጌሻ አያናር ይ ጻማቅንቶዳ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="MAT 3:11">ማቶ. 3:11</ref>፤ <ref loc="MRK 1:8">ማር. 1:8</ref>፤ <ref loc="LUK 3:16">ሉቃ. 3:16</ref>፤ <ref loc="JHN 1:33">ዋን. 1:33</ref></char></note><verse eid="ACT 1:5"/></para>
  <para style="s1">የሱሳ ሳሎ Ꮊንጌዛ</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6"/>ሀዋርታይ የሱሳና ሄሊ ኤኮ፥ «ጎዳዮ፥ እስራኤልታይስ ነ ካተት ማህዝ ዎዳይ Ꮊያኔ?» ዬጊ ኦይጬዛ።<verse eid="ACT 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 1:7"/>የሱሳ ኡንትኮ፥ «ታ አዳይ ፋ ማዉተር ኦዛ ዎዳኔ ላይ ይ ኤሮዳይስ ዳንዳኦያ። <verse eid="ACT 1:7"/><verse number="8" style="v" sid="ACT 1:8"/>ዝን ጌሻ አያናይ ይንታል አፋ ዎዝ ዎደ ይ ዎልቃ ኤኮዳ። የይፕ፥ ጉየ የሩሳላመ፥ ይሁዳ ጋደ ኡባይል፥ ሳማረራኔ ቢታ ጋጻፕ ጋጻ ሄሎዳይስ ይ ታስ ማርክታ ማቆዳ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="MAT 28:19">ማቶ. 28:19</ref>፤ <ref loc="MRK 16:15">ማር. 16:15</ref>፤ <ref loc="LUK 24:47-48">ሉቃ. 24:47-48</ref></char></note><verse eid="ACT 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 1:9"/>የያ ጌዛይፕ ጉየ ኡንቲ በአዳር፥ ቅ ቅ ግ፥ ሳሎ ኬዝን ሻራካ ኤዛ ኡ ኣፋይፕ ጌንዛ።<note caller="-" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="MRK 16:19">ማር. 16:19</ref>፤ <ref loc="LUK 24:50-51">ሉቃ. 24:50-51</ref></char></note><verse eid="ACT 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 1:10"/>የሱሳ Ꮊማዳር ኡንቲ ሳሎ ፉደ በአዳር፥ ቦ ማኦ ማኤዝ ናምኢ አስታይ ቆፐካዝን ኡ አቻ ኤቂ፥ <verse eid="ACT 1:10"/><verse number="11" style="v" sid="ACT 1:11"/>«ጋልላ አሳዮ፥ ሳሎ ብእታር፥ ይ አብስ ኤቄኔ? Ꮊ ይ በአዳር ሳሎ ቅቴዝ የሱሳ Ꮊኒ ጋርክ ማቂ የኦዳ» ዬጌዛ።<verse eid="ACT 1:11"/></para>
  <para style="s1">ይሁዳ አቆ ማታሳ ዶርንቴዛ</para>
  <para style="r">(<ref loc="MAT 27:3-10">ማቶ. 27:3-10</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12"/>የይፕ ጉየ፥ ሀዋርታይ ዳብረ ዛይተ አምባላፕ የሩሳላመ ማቄዛ። ዳብረ ዛይተ አምባይ የሩሳላመፕ ማላ ጋላሳ የ ጋርክ ሃክዛ። <verse eid="ACT 1:12"/><verse number="13" style="v" sid="ACT 1:13"/>ኡንቲ የሩሳላመ ገሊ፥ ፎቄል አፋ ከዜዛ። ኡንትካ<note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="ft" closed="false">ማላ ጋላስ የ ጋርክ ጉሳይ ፐቲ ክሎ መትረ ኦገ ጉስ</char></note>፦ ጵጽሮሳ፥ ዋንሳ፥ ያይቆባ፥ እንድራሰ፥ ፍልጶሳ፥ ቶማሳ፥ ባርቶሎሞሳ፥ ማቶሳ፥ ኢልፎሳ ናአ ያይቆባ፥ ቃናትዛ<note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="ft" closed="false">ቅናትዛ ጉሳይ አይሁድታይ አማኖ ዎጋስኔ ፋ ጋደስ ምጭንትዛ አስ</char></note> ስሞናኔ ያይቆባ ናአ ይሁዳ።<note caller="-" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="MAT 10:2-4">ማቶ. 10:2-4</ref>፤ <ref loc="MRK 3:16-19">ማር. 3:16-19</ref>፤ <ref loc="LUK 6:14-16">ሉቃ. 6:14-16</ref></char></note> <verse eid="ACT 1:13"/><verse number="14" style="v" sid="ACT 1:14"/>Ꮊይትታይ ኡባይ ማችታይር፥ የሱሳ እንዳት ማራምራኔ የሱሳ እሽታይራ ኡባይ ፐቲ ዎዝናር ማቂ ኡባ ዎደ ሚንጊ ዎስዛ።<verse eid="ACT 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 1:15"/>የ ዎደ ጵጽሮሳ ጼታኔ ላታም ማቅዝ አማንዛ አሳይ ሺቄዝ አቆ ደንዲ ኤቂ፥ Ꮊይ ጋርክ ዬጌዛ፦ <verse eid="ACT 1:15"/><verse number="16" style="v" sid="ACT 1:16"/>«ታ እሹን፥ የሱሳና አይኬዝታ ካልዝ ይሁዳ ባጋ ጌሻ አያናይ ቲና ዳዉተ ዶናር ኦዴዝ ጾስ ቃላይ ፖልንቶዳይስ ቤዝዛ። <verse eid="ACT 1:16"/><verse number="17" style="v" sid="ACT 1:17"/>ይሁዳ ኑር ዎላ Ꮊ ኦሳ ኦዳይስ ማራጽንቴዝ አሲ።»<verse eid="ACT 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 1:18"/>ዝን ይሁዳ ኢታ ኦሶር ደንጌዝ ሚሻይር ጋደ ዎንጌዛ። ኤ ስኖር ፖክን፥ ኤ ኡላይ ፔንትን፤ ኤ ማራጫይ ዛዝንቴዛ። <verse eid="ACT 1:18"/><verse number="19" style="v" sid="ACT 1:19"/>ይሁዳል አፋ ሀኔዝባዛ የሩሳላመ የዝ አስ ኡባይ ስኤዛ። የይ ግሾስ፥ የ ጋዳ ፋ ጋደ ዶናር «አካልዳማ» ጌዛ። አኬልዳማ ጉሳይ ሱ ቢታ ጉሲ።<verse eid="ACT 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 1:20"/>«የይካ ማዝሙረ ማጻፋይድ፥</para>
  <para style="q1" vid="ACT 1:20">«‹ኤ ካራይ ካሎ አቶ፤</para>
  <para style="q2" vid="ACT 1:20">ኦንካ ኤዛይድ የዝፔ።</para>
  <para style="q1" vid="ACT 1:20">ማ ኤ ሹማት ሀራይ ኤኮ› ግንትንቲ ጻፍንቴዛ።»<verse eid="ACT 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 1:21"/>«የይ ግሾስ፥ ጎዳ የሱሳ ኑ ጋንጨ ዩዜዝ ዎደ ኡባይድ ኑር የዝታይፐ፥ <verse eid="ACT 1:21"/><verse number="22" style="v" sid="ACT 1:22"/>ማ ጻማቅዛ ዋንሳ ዎዳይፕ አይኪ ጎዳ የሱሳ ሳሎ Ꮊንጌዝ ጋላስ ሄሎዳይስ ኑር የዝታይፕ ፐቲ አሲ ኤ ደንዳይስ ኑር ማርካ ማቆዳይስ ቤዝዛ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="MAT 3:16">ማቶ. 3:16</ref>፤ <ref loc="MRK 1:9">ማር. 1:9</ref>፤ <ref loc="LUK 3:21">ሉቃ. 3:21</ref></char></note><verse eid="ACT 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 1:23"/>የይ ግሾስ፥ አሳይ ዶሮዳይስ ዮስጾሳ ግዝ ባርሳባሳ ግንትንትዛ ዮሴፋኔ ማታሳ ናምእታ ሺሼዛ። <verse eid="ACT 1:23"/><verse number="24" style="v" sid="ACT 1:24"/>የይፕ ጉየ፥ ጾስ ዎስታር፥ «አስ ኡባ ዎዝና ኤርዛ ጎዳዮ፥ Ꮊ ናምእታይፕ ነ ኦና ዶሬዛኮ ኑና ቤዞባ። <verse eid="ACT 1:24"/><verse number="25" style="v" sid="ACT 1:25"/>ይሁዳ ፋ አቃ ቅቲ፥ አሼዝ ኦሳኔ ሀዋረት ኦሳ ኤኮዳይ ጋርክ Ꮊይትታይፕ ኑና ቤዞባ» ዬጌዛ። <verse eid="ACT 1:25"/><verse number="26" style="v" sid="ACT 1:26"/>ኡንታል አፋ እጻ ኦልን ኢጻይ ማታሳል አፋ ዎን ማታሳ ታጶ ፐቲ ሀዋርታይል አፋ ጉዥንቴዛ።<verse eid="ACT 1:26"/></para>
  <chapter eid="ACT 1"/>
  <chapter number="2" style="c" sid="ACT 2"/>
  <para style="s1">ጌሻ አያና ዎ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1"/>ጰንጸቆስጸ ግዝ ጋላሳይ ሄሌዝ ዎደ አማንዛ አስ ኡባይ ፐቲ አቆ ሺቂ የዛ።<note caller="-" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="LEV 23:15-21">ለዊ. 23:15-21</ref>፤ <ref loc="DEU 16:9-11">ናምእ. 16:9-11</ref></char></note> <verse eid="ACT 2:1"/><verse number="2" style="v" sid="ACT 2:2"/>ቆፐካዝን ዎልቃማ ጎተ ጋርክ ጉምዝ ጉምይ ሳሎፕ ይኢ ኡንቲ የዝ ኬ ኩሜዛ። <verse eid="ACT 2:2"/><verse number="3" style="v" sid="ACT 2:3"/>ታማ ላ ኣዝዝ እራንታይ ኡንትስ በንትታር፥ ሻግንቲ ሻግንቲ ኡንታል ኡባይል አፋ በቴዛ። <verse eid="ACT 2:3"/><verse number="4" style="v" sid="ACT 2:4"/>ኡንቲ ኡባይ ጌሻ አያናር ኩሚ ዱማ ዱማ ዶናር ኦድንቶዳይ ጋርክ ጌሻ አያናይ ኡንታን ኡድን ኦድንቶ አይኬዛ።<verse eid="ACT 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 2:5"/>የ ዎደ ቢታ ኡባፕ የኤዝ ጾስስ Ꮊሽትዝ አይሁድታይ የሩሳላመ የዛ። <verse eid="ACT 2:5"/><verse number="6" style="v" sid="ACT 2:6"/>የ ጉም ስኢ ጋመ አሳይ ሺቄዛ። አማንዛ አሳይ ኡ ጋደ ዶናር ኦድንቶዳር ስኤዝ ግሾስ <verse eid="ACT 2:6"/><verse number="7" style="v" sid="ACT 2:7"/>Ꮊይ ማላባዝ ግ፥ «Ꮊ ኦድንትዛ አስ ኡባይ ጋልላ አስ ባሳ? <verse eid="ACT 2:7"/><verse number="8" style="v" sid="ACT 2:8"/>የዝን፥ ኑኒ፥ ኑ የልንቴዝ ቢታ ዶናር ኡንቲ ኦድንቶዳር ዋይዚ ስኦዳይስ ዳንዳኤኔ? <verse eid="ACT 2:8"/><verse number="9" style="v" sid="ACT 2:9"/>ኑኒ ጳርጸ፥ ሜደ፥ ኤላመ፥ መሶጶታመ<note caller="+" style="f"><char style="fr" closed="false">2:9 </char><char style="ft" closed="false">መሶጶታመ ጉሳይ ናምኢ ሃታይ ጋንጨ ጉሲ የ ሃታይካ ኤጲራቶሳኔ ትግራ</char></note> የዝታይ፥ ይሁዳ፥ ቃጳዶቃ፥ ጳንጾሳ፥ ኢስያ፥ <verse eid="ACT 2:9"/><verse number="10" style="v" sid="ACT 2:10"/>ጵርገ፥ ጵንፍለ፥ ግብጸ፥ ቃርና አቻ የዝ ሊባ የዝታ። ኑፕ ባግትይካ ኦሮመፕ የኤዝ አስታ። <verse eid="ACT 2:10"/><verse number="11" style="v" sid="ACT 2:11"/>አይሁድታይኔ አይሁደት አማኖ ገሌዝ አስታይ፥ ቃርጼሳኔ አራበ አስታይ፥ ጾሲ ኦዝ ግታ ኦሳ ኑ ቃላይር ኦዶዳር ስእዛ» ዬጌዛ። <verse eid="ACT 2:11"/><verse number="12" style="v" sid="ACT 2:12"/>ኡባይ ማላባዝ ግ፥ ጎድባዝ ብን ዎልኮ፥ «Ꮊይ አብ ማቆደሻ?» ዬጌዛ። <verse eid="ACT 2:12"/><verse number="13" style="v" sid="ACT 2:13"/>ዝን Ꮊንክታይ፥ «የይትታይ ኡዢ ማምባይ» ዬጊ ኡንታል አርኤዛ።<verse eid="ACT 2:13"/></para>
  <para style="s1">ጵጽሮሳ ናሻ</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14"/>ዝን ጵጽሮሳ፥ ታጶ ፐቲ ሀዋርታይራ ደንዲ ኤቂ፥ ፋ ቃላ ቅ ኡዲ፥ ኡንትኮ Ꮊይ ጋርክ ዬጊ ኦዴዛ፦ «አይሁድታዮ፥ የሩሳላመ የዝ ኡቢታዮ፥ ታኒ ኦድዛ ስኦይታ። <verse eid="ACT 2:14"/><verse number="15" style="v" sid="ACT 2:15"/>ዎንታፕ ሀይ ሳተ ማቄዝ ግሾስ ይ ቆፕዛይ ጋርክ Ꮊ አስታይ ማካያ፤ የይ ይንትስ ኤርንቶ። <verse eid="ACT 2:15"/><verse number="16" style="v" sid="ACT 2:16"/>ዝን Ꮊይ ሀኔዛይ ናበ ኢዩኤላ ኦዴዛይ ፖልንቶዳይ ጋርከስ<verse eid="ACT 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 2:17"/>«‹ጾሲ፥ ዎደ ዉርስ Ꮊይ ጋርክ ሀኖዳ ዬግዛ፦</para>
  <para style="q2" vid="ACT 2:17">ታኒ አስ ኡባይል አፋ ታ አያና ጎግሶዳ።</para>
  <para style="q1" vid="ACT 2:17">ይ ራ ናእታይኔ ማች ናእታይ፥</para>
  <para style="q2" vid="ACT 2:17">ትንቢተ ኦዶዳ።</para>
  <para style="q1" vid="ACT 2:17">ይ ፓንታይ ቆንጭ በአዳ፤</para>
  <para style="q2" vid="ACT 2:17">ይ ጭምታይ አሁሞ አሁሞዳ።<note caller="-" style="x"><char style="xo" closed="false">2:17-21 </char><char style="xt" closed="false"><ref loc="JOL 2:28-32">ኢዩ. 2:28-32</ref></char></note><verse eid="ACT 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 2:18"/>የ ጋላሳታይድ ታና</para>
  <para style="q2" vid="ACT 2:18">አማንዛ ራ አይልታይል አፋኔ ማች አይልታይል አፋ</para>
  <para style="q2" vid="ACT 2:18">ታኒ ታ አያና ጎግሶዳ፤</para>
  <para style="q2" vid="ACT 2:18">ኡንቲ ትንቢተ ኦዶዳ።<verse eid="ACT 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ACT 2:19"/>ማ ታኒ አፋ ሳሎር ኦሮ ባዝ፥</para>
  <para style="q2" vid="ACT 2:19">ኦሞ ሳአራካ ማላ ቤዞዳ።</para>
  <para style="q1" vid="ACT 2:19">ሱ፥ ታማኔ ዎልቃማ ጩያ ፉሎ በንቶዳ።<verse eid="ACT 2:19"/></para>
  <para style="q2">
    <verse number="20" style="v" sid="ACT 2:20"/>ግታኔ ቦንቾ ማቄዝ ጎዳይ ጋላሳይ</para>
  <para style="q2" vid="ACT 2:20">ሄሎዳይፕ ቲና አዋ ሞዳ፤</para>
  <para style="q2" vid="ACT 2:20">አጌናካ ሱ ኣዞዳ።<verse eid="ACT 2:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ACT 2:21"/>የ ዎደ Ꮊይ ጋርክ ሀኖዳ፤</para>
  <para style="q2" vid="ACT 2:21">ጎዳይ ሱን ጼግዝ ኦንካ አቶዳ›</para>
  <para style="m" vid="ACT 2:21">ዬጌዛ።<verse eid="ACT 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 2:22"/>«እስሬለ አሳዮ፥ Ꮊ ቃላ ስኦይታ። ናዝረተ የሱሳ ኦናትይ፥ ጾሲ ይ ጋንጨ ኦዝ ዎልቃማ ኦሳይራኔ ማላትታይር ይንትስ ቆንጭዛ ይ፥ ይ ኡባስ ኤርዛ። <verse eid="ACT 2:22"/><verse number="23" style="v" sid="ACT 2:23"/>ጾስ ቲና ፋ ኤራራኔ ፋ ሸናይር የሱሳ ይንትስ አ እንግንቴዛ። ይ ኤዛ ህገ ባ አስታይ ኩሸር ማዝቃለል አፋ ሶትስ ይ ዎዛ።<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="MAT 27:35">ማቶ. 27:35</ref>፤ <ref loc="MRK 15:24">ማር. 15:24</ref>፤ <ref loc="LUK 23:33">ሉቃ. 23:33</ref>፤ <ref loc="JHN 19:18">ዋን. 19:18</ref></char></note> <verse eid="ACT 2:23"/><verse number="24" style="v" sid="ACT 2:24"/>ዝን ጾስ Ꮊይቆ ዎልቃ ብሲ ኤዛ ደንዛ። የይ ግሾስ፥ Ꮊይቆ ኤዛ አይኮዳይስ ዳንዳኤካያ።<note caller="-" style="x"><char style="xo" closed="false">2:24 </char><char style="xt" closed="false"><ref loc="MAT 28:5-6">ማቶ. 28:5-6</ref>፤ <ref loc="MRK 16:6">ማር. 16:6</ref>፤ <ref loc="LUK 24:5">ሉቃ. 24:5</ref></char></note> <verse eid="ACT 2:24"/><verse number="25" style="v" sid="ACT 2:25"/>ዳዉተ ኤ ባጋ ኦድታር፥</para>
  <para style="q1" vid="ACT 2:25">«‹ታኒ ዳጋማማይ ጋርክ፥</para>
  <para style="q1" vid="ACT 2:25">ጎዳይ ታ ኡሻቻ የዛ።</para>
  <para style="q1" vid="ACT 2:25">ጎዳ ኡባ ዎደ ታ ታ ቲና ብእዛ።<verse eid="ACT 2:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 2:26"/>የይ ግሾስ፥ ታ ዎዝናይ ኡፋይቴዛ፤</para>
  <para style="q2" vid="ACT 2:26">ታ ዶናይ ኡፋይሳር ኩሜዛ፤</para>
  <para style="q2" vid="ACT 2:26">Ꮊይቅዝ ታ አሰትይ ኡፋይሳር የዞዳ።<verse eid="ACT 2:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 2:27"/>አብስ ጊኮ፥ ታ ሸምፓ ስኦለ አሻሚ።</para>
  <para style="q2" vid="ACT 2:27">ማ ነ ጽላይ አሃ ዎቅም።<verse eid="ACT 2:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ACT 2:28"/>ኔኒ ታና ደኦ ኦጋ ኤርሴዛ።</para>
  <para style="q2" vid="ACT 2:28">ነ ታር የዛይ ግሾስ ታ ኡፋይሳይ ኩን ማቅዛ›<note caller="-" style="x"><char style="xo" closed="false">2:25-28 </char><char style="xt" closed="false"><ref loc="PSA 16:8-11">ማዝ. 16:8-11</ref></char></note> ዬጌዛ።<verse eid="ACT 2:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 2:29"/>«ታ እሹን፥ ኑ አዳ ዳዉተ ባጋ ታ ይንትስ ጌሺ ኦዶዳ። ዳዉተ Ꮊይቂ ሞግንቴዛ፤ ኤ ዱፋይ Ꮊይኖ ሄሎዳይስ ኑ ካለ የዛ። <verse eid="ACT 2:29"/><verse number="30" style="v" sid="ACT 2:30"/>ዳዉተ ናበ ማቄዝ ግሾስ ጾስ ኤ ሼሻይፕ ፐታ ኤ ካተት ዙፋናይል አፋ በትዳይስ ኤስ ጫቄዝ ጫቃ ኤርዛ። <verse eid="ACT 2:30"/><verse number="31" style="v" sid="ACT 2:31"/>የይ ግሾስ፥ ክርስቶሳ ደንዳ ቲና ብኢ፥ ‹ኤ ሸምፓይ ስኦለ አተካያ፤ ኤ አሰትይካ ዎቀካያ› ግ ኦዴዛ።<note caller="-" style="x"><char style="xo" closed="false">2:31 </char><char style="xt" closed="false"><ref loc="PSA 132:11">ማዝ. 132:11</ref>፤ <ref loc="2SA 7:12-13">2ሳም. 7:12-13</ref></char></note><verse eid="ACT 2:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 2:32"/>«ጾሲ፥ Ꮊ የሱሳ Ꮊይቆፕ ደንዛይስ ኑኒ ኡባይ ማርካ። <verse eid="ACT 2:32"/><verse number="33" style="v" sid="ACT 2:33"/>የይ ግሾስ፥ ጾሲ ፋ ኡሻቻ ኤዛ ቅ ቅ ኡዲ፥ ኤስ እንጎድ ግንትንቴዝ ጌሻ አያናይ ኡፋይሳ ፋ ጾስ አዳይፕ ኤኪ፥ Ꮊያ ይ Ꮊት ብእዛኔ ስእዛ ኑል አፋ ጎግሴዛ። <verse eid="ACT 2:33"/><verse number="34-35" style="v" sid="ACT 2:34-35"/>የይካ፥ ዳዉተ ፋ ኦማስ ሳሎ Ꮊንገካያ ዝን፦</para>
  <para style="q1" vid="ACT 2:34-35">«‹ጎዳይ፥ ታ ጎዳ፥</para>
  <para style="q1" vid="ACT 2:34-35">«ታኒ ነ ሞርክታ</para>
  <para style="q2" vid="ACT 2:34-35">ነ ቶከስ የ አቆ ኡዶድ ሄሎዳይስ</para>
  <para style="q2" vid="ACT 2:34-35">Ꮊይዳ ታፕ ኡሻች ባጋ በቶባ ጌዛ»</para>
  <para style="m" vid="ACT 2:34-35">ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">2:34-35 </char><char style="xt" closed="false"><ref loc="PSA 110:1">ማዝ. 110:1</ref></char></note><verse eid="ACT 2:34-35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 2:36"/>«የይ ግሾስ፥ Ꮊ ይ ማዝቃለል አፋ ሶቴዝ የሱሳ፥ ጾሲ ኤዛ ጎዳኔ ክርስቶሳ ማሄዛና እስሬለ አስ ኡባይ ቱማፕ ኤሮ» ዬጌዛ።<verse eid="ACT 2:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 2:37"/>አሳይ ጵጽሮሳ ጌዛ ስእን ኡ ዎዝናይ ቦችንትን ጵጽሮሳኔ Ꮊንኮ ሀዋርታይኮ፥ «ኑ ኢሹን፥ የዝን ኑኒ አብ ኡዶ?» ዬጌዛ።<verse eid="ACT 2:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 2:38"/>ጵጽሮሳ ኡንትኮ፥ «ይ ናጋራይ አቶ ግንትንቶዳይ ጋርክ ናጋራይፕ ማቂ፥ ይ ፐታይ ፐታይ የሱስ ክርስቶሳ ሱንር ጻማቅንቶይታ። ጾስ እንግዛ ጌሻ አያና ይ ኤኮዳ። <verse eid="ACT 2:38"/><verse number="39" style="v" sid="ACT 2:39"/>የይካ ጾሲ እንጎድ ጌዝ ኡፋይስ ቃላይ ይንትሲ፥ ይ ናእታይስኔ ጎዳይ ኑ ጾሳይ ፋክ ጼግዝ ሃኮ የዝ ኡቢታይስ» ዬጌዛ።<verse eid="ACT 2:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 2:40"/>ጵጽሮሳ ኡንትስ ሀራ ቃላካ ጉጂ ማርካቲ፥ «Ꮊ ዎደ ዡጫ አሳይል አፋ የኦዳይስ የዝ ፕርዳይፕ ይንታን አሾይታ» ዬጊ ዞሬዛ። <verse eid="ACT 2:40"/><verse number="41" style="v" sid="ACT 2:41"/>ጵጽሮሳ ኦዴዛና ኤኬዝታይ ጻማቅንቴዛ። የ ጋላስ ሀይ ሙኩለ ማቅዝ አሳይ አማኒ ጉጅንቴዛ። <verse eid="ACT 2:41"/><verse number="42" style="v" sid="ACT 2:42"/>ኡንቲ ሀዋርታይ ትምርታይድ፥ ፐትፐተር፥ ካ ዎላ ሙሳራኔ ጾስ ዎሳር ሚንጌዛ።<verse eid="ACT 2:42"/></para>
  <para style="s1">አማንዛ አሳይ ፐትፐተ የስ</para>
  <para style="p">
    <verse number="43" style="v" sid="ACT 2:43"/>ሀዋርታይ ኩሸ ጋመ ኦሮባዝኔ ማላባዝ ሀኔዛይ ግሾስ አስ ኡባይ ያሽቴዛ። <verse eid="ACT 2:43"/><verse number="44" style="v" sid="ACT 2:44"/>አማኔዝ ኡቢታይ ዎላ የዝዛ፤ ፓስ የዛ ባዝ ኡባ ፐትፕ ሻግንቴዛ።<note caller="-" style="x"><char style="xo" closed="false">2:44 </char><char style="xt" closed="false"><ref loc="ACT 4:32-35">ሀዋ. ኦ. 4:32-35</ref></char></note> <verse eid="ACT 2:44"/><verse number="45" style="v" sid="ACT 2:45"/>ኡንቲ ፓስ የዛ ባዝ ባይዚ ሚሸ ፐታይስ ፐታይስ ኮሽዛይ ጋርክ ሻግዛ። <verse eid="ACT 2:45"/><verse number="46" style="v" sid="ACT 2:46"/>ኡባ ጋላስ ፐቲ ዎዝናር ማቂ ጾስ ካራ ሺቅዛ። ፋ ካራ ፐታይ ፐታ ጼጊ ኡፋይሳራኔ አሽከ ዎዝናር ካ ሚዛ። <verse eid="ACT 2:46"/><verse number="47" style="v" sid="ACT 2:47"/>ጾስ ጋላትታር አስ ኡባይር ሳብንቴዛ። ጎዳይ አማኒ አትዝታ ጋላስ ጋላስ ኡንታል አፋ ጉጅዛ።<verse eid="ACT 2:47"/></para>
  <chapter eid="ACT 2"/>
  <chapter number="3" style="c" sid="ACT 3"/>
  <para style="s1">ዎቦ አይ ፓጼዛ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1"/>ፐቲ ጋላስ ጵጽሮሳኔ ዋንሳ ጾስ ዎሶዳይስ ኡዱፉን ሳተር ጾስ ካራ Ꮊንጌዛ። <verse eid="ACT 3:1"/><verse number="2" style="v" sid="ACT 3:2"/>የልንቴዝ ጋላሳፕ አይኪ ቶኬ ስሌዝ ፐቲ አይ ጾስ ካራ ገልዛ አሳይፕ ሚሸ ዎሶዳይ ጋርክ ኡባ ዎደ ሎኦ ግዝ ጾስ ካራ ፐንገ ጋላስ ጋላስ ክኢ ጋድዛዝን። <verse eid="ACT 3:2"/><verse number="3" style="v" sid="ACT 3:3"/>የ ቶኬ ስሌዝ አይ ጵጽሮሳኔ ዋንሳ ጾስ ካራ ገሎድ ሀኖዳር ብኢ ኡንታን ሚሸ ዎሴዛ።<verse eid="ACT 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 3:4"/>ኡንትካ ኤዛ ዳኪ ብኢ፥ ጵጽሮሳ «ኑኮ Ꮊና ቦኦባ» ዬጌዛ። <verse eid="ACT 3:4"/><verse number="5" style="v" sid="ACT 3:5"/>ቶኬ ስላ አይ ኡንታፕ አኮ ባዝ ደማዳ ኣዝን ኡንታን በኤዛ። <verse eid="ACT 3:5"/><verse number="6" style="v" sid="ACT 3:6"/>ዝን ጵጽሮሳ ኤዝኮ፥ «ታስ ብራኔ ዎርቃ ባያ፥ ዝን ታስ የዛ ባዝ ታ ኔስ እማዳ። ናዝረተ የሱስ ክርስቶሳ ሱንር ደንዲ የባ» ዬጌዛ።<verse eid="ACT 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 3:7"/>የይፕ ጉየ፥ ስላ አይስ ኡሻች ኩሻ አይኪ ደንዛ። ኤልሲ ኤ ቶካይኔ ቅልጫይ ሚንጊ አቴዛ። <verse eid="ACT 3:7"/><verse number="8" style="v" sid="ACT 3:8"/>አይ ጉፒ ደንዲ ኤቄዛ። ገደኔ Ꮊና የ አይኬዛ። የይፕ ጉየ፥ የታራኔ፥ ጉፕታር ጾስ ጋላትታር ኡንታር ዎላ ጾስ ካራ ገሌዛ።<verse eid="ACT 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 3:9"/>ኤ የዳራኔ ጾስ ጋላቶዳር አሲ ኡባይ ኤዛ በኤዛ። <verse eid="ACT 3:9"/><verse number="10" style="v" sid="ACT 3:10"/>በኤዝ ኡቢታይካ ሚሸ ዎሶዳይስ ሎኦ ግዝ ጾስ ካራ ፐንገል በቴዛይ ኤዛ ማቄዛ ኤሬዛ፤ ኤ ሀኔዝባዛ ብኢ ማላባዝ ጌዛ።<verse eid="ACT 3:10"/></para>
  <para style="s1">ጵጽሮሳ ጾስ ካራ ኦዴዝ ስብካታ</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 3:11"/>አይ ጵጽሮሳፐኔ ዋንሳፕ ዱጻም ግ አይኪ የዝን አሲ ኡባይ ማላባዝ ግ፥ ሶሎሞነ ባራንዳ ግዝ አቆ ዎላ ኡንትኮ ዎጼዛ። <verse eid="ACT 3:11"/><verse number="12" style="v" sid="ACT 3:12"/>ጵጽሮሳ አሳ ብኢ አሳይኮ፥ «እስሬለ አሳዮ፥ አብስ Ꮊያ ማላባዝ ጌ? ዎይ አብስ ኑና ዳኪ በኤ? ኑኒ ኑ ዎልቃር ዎይ ኑ ሎኦትይር Ꮊ አ የዝባዝ ይንትስ ኣዝኔ? <verse eid="ACT 3:12"/><verse number="13" style="v" sid="ACT 3:13"/>አፍራመ፥ እሳቃ፥ ያይቆባ ጾሳይ፥ ኑ አድታይ ጾሳይ፥ ፋ ናአ የሱሳ ቦንቼዛ። ዝን ይ Ꮊይቆስ ኣ እንጌዛ ጵላጾሳ ብልኦዳይስ ኮይኮካ ይ ኤ ቲና፥ ‹ኑኒ ኤዛ ኮዮያ› ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="EXO 3:15">ከስ 3:15</ref></char></note> <verse eid="ACT 3:13"/><verse number="14" style="v" sid="ACT 3:14"/>ይ ጌሻኔ ጽላ፥ ካዲ፥ ሸምፖ ዎዛ ይንትስ ብሎዳይ ጋርክ ጵላጾሳ ዎሴዛ።<note caller="-" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="MAT 27:15-23">ማቶ. 27:15-23</ref>፤ <ref loc="MRK 15:6-14">ማር. 15:6-14</ref>፤ <ref loc="LUK 23:13-23">ሉቃ. 23:13-23</ref>፤ <ref loc="JHN 9:12-15">ዋን. 9:12-15</ref></char></note> <verse eid="ACT 3:14"/><verse number="15" style="v" sid="ACT 3:15"/>ደኦ እንግዛ ይ ዎዛ፥ ዝን ጾሲ Ꮊይቆፕ ኤዛ ደንዛ። የይስ ኑኒ ማርካ። <verse eid="ACT 3:15"/><verse number="16" style="v" sid="ACT 3:16"/>Ꮊ ይ ብእዛይኔ ኤርዛ አሳይ ፓጺ ምንጌዛይ የሱሳ ሱንር አማኔዝ ግሾ። Ꮊ ይ ኡባይ ቲና ኤዛ Ꮊይ ጋርክ ፓዛይ ኤ የሱሳ አማኔዝ ግሾስ።<verse eid="ACT 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 3:17"/>«Ꮊተካ ታ እሹን፥ ይንትካ ይንታን ካልዝታይካ፥ ኤረካዛር ኦዛና ታኒ ኤርዛ። <verse eid="ACT 3:17"/><verse number="18" style="v" sid="ACT 3:18"/>ዝን ጾሲ ብኒ ናብታይ ኡባ ዶናር፥ ‹ክርስቶሳ ዋየ ኤኮዳይስ ቤዝዛ› ዬጌዛይ ፖልንቶዳይ ጋርክ ኡዴዛ። <verse eid="ACT 3:18"/><verse number="19" style="v" sid="ACT 3:19"/>ይኬ፥ ጾሲ ይ ናጋራ አቶ ጎዳይ ጋርክ ማሮቶ ገሊ ጎዳይኮ ማቆይታ። <verse eid="ACT 3:19"/><verse number="20" style="v" sid="ACT 3:20"/>ጎዳይ ካለፕ ምን ዎደ ይንትስ የኦዳ። ጎዳይ ቲናቲ ዶሬዝ ክርስቶሳ ይንትስ ዳኮዳ። <verse eid="ACT 3:20"/><verse number="21" style="v" sid="ACT 3:21"/>ጾሲ ፋ ጌሽ ናብታይ ዶናር ብኒ ኦዴዛይ ጋርክ ኡባ ባዝ ኦሮጽዛ ዎደ ሄሎዳይስ Ꮊ የሱሳ ሳሎ ጋምኦዳይስ ቤዝዛ። <verse eid="ACT 3:21"/><verse number="22" style="v" sid="ACT 3:22"/>ሙሰ፥ ‹ጎዳ ጾሳይ ታና ደንዛይ ጋርክ ይ ጋንጨፕ ይንትስ ናበ ደንዳ። ይ ኤ ግዛ ኡባ ስኦይታ።<note caller="-" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="DEU 18:15">ናምእ. 18:15</ref>፥ <ref loc="DEU 18:18">18</ref></char></note> <verse eid="ACT 3:22"/><verse number="23" style="v" sid="ACT 3:23"/>የ ናባይ ኦዳ ስኦዋ አስ ኦንካ አስ ጋንጨፕ ሻክንቲ ቦ› ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">3:23 </char><char style="xt" closed="false"><ref loc="DEU 18:19">ናምእ. 18:19</ref></char></note><verse eid="ACT 3:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 3:24"/>«ማ ሳምኤላፕ አይኪ የዝ ናብታይ ኡቢታይ Ꮊ ዎደ ባጋ ኦዴዛ። <verse eid="ACT 3:24"/><verse number="25" style="v" sid="ACT 3:25"/>ይ ናብታይ ናእታ፤ ማ ጾስ አፍራመስ፥ ‹ሳአል የዝ አስ ኡባ ታኒ ነ ሼሻይ ባጋር አንጆዳ› ዬጊ ኑ አድታይስ ገሌዝ ቃላ ጫቆ ላትዛ ናእታ።<note caller="-" style="x"><char style="xo" closed="false">3:25 </char><char style="xt" closed="false"><ref loc="GEN 22:18">መ. 22:18</ref></char></note> <verse eid="ACT 3:25"/><verse number="26" style="v" sid="ACT 3:26"/>ጾስ ይንታን ኡባ ይ ኢታ ኦጋይፕ ማሂ አንጆዳይ ጋርክ ፋ ናአ ደን ይንትስ ቲና ዳኬዛ» ዬጌዛ።<verse eid="ACT 3:26"/></para>
  <chapter eid="ACT 3"/>
  <chapter number="4" style="c" sid="ACT 4"/>
  <para style="s1">ጵጽሮሳኔ ዋንሳ አይሁደ ሻንጎ ቲና</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1"/>ጵጽሮሳኔ ዋንሳ አሳይስ ኦዶዳር ቄስታይ፥ ጾስ ካራ ናግዝታይ ሀላቃይኔ ሳዱቃውታይ ኡንትኮ የኤዛ። <verse eid="ACT 4:1"/><verse number="2" style="v" sid="ACT 4:2"/>ኡንቲ የሱሳ Ꮊይቆፕ ደንዴዛኔ የይፕ ደንዴዛይድ Ꮊይቆፕ ደንዶ የዛና ዎያ ታማርሴዝ ግሾስ ይሎቴዛ። <verse eid="ACT 4:2"/><verse number="3" style="v" sid="ACT 4:3"/>የይ ግሾ፥ ኡንታን አይኪ ሳአ ኦማዛይፕ ዎንቶድ ሄሎዳይስ አች ካራ ገልሴዛ። <verse eid="ACT 4:3"/><verse number="4" style="v" sid="ACT 4:4"/>ዝን ቃላ ስኤዝታይፕ ጋምታይ አማኔዛ። አማኔዝ ራ አሳይ ታይባይ እችን ሙኩለ ሄሌዛ።<verse eid="ACT 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 4:5"/>ዎንት ጋላስ ካልዝታይ፥ ጭምታይኔ፥ ህገ አስታማርታይ የሩሳላመ ሺቄዛ። <verse eid="ACT 4:5"/><verse number="6" style="v" sid="ACT 4:6"/>የ አሳይ ጋንጨ ቄሰ ሀላቃ ሃና፥ ቃያፋ፥ ዋንሳ፥ ኢስክንድረኔ ቄሰ ሀላቃይ ካራ አስታይ ኡባይ የዛ። <verse eid="ACT 4:6"/><verse number="7" style="v" sid="ACT 4:7"/>ሀዋርታ ፋ ቲና ኤስ፥ «አባ ዎልቃር ዎይ ኦ ሱንር Ꮊያ ይ ኦኔ?» ዬጊ ኦይጬዛ።<verse eid="ACT 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 4:8"/>የ ዎደ ጵጽሮሳ ጌሻ አያናር ኩሚ፥ «ዎያ ሀላቅታዮኔ፥ ጭምታዮ፥ <verse eid="ACT 4:8"/><verse number="9" style="v" sid="ACT 4:9"/>Ꮊይኖ Ꮊ ዎቦ አይስ ኦስንቴዝ ሎኦ ኦሳይል ኤ ዋይዚ ፓጼዛኮ ይ ኑና ኦይጭኮ፥ <verse eid="ACT 4:9"/><verse number="10" style="v" sid="ACT 4:10"/>ማዝቃለል አፋ ይ ሶጽን፥ ጾሲ Ꮊይቆፕ ደንዝ ናዝረተ የሱስ ክርስቶሳ ሱንይር Ꮊ አይ ፓጺ ይ ቲና ኤቄዛይ ይንትስኔ እስሬለ አስ ኡባይስ ኤርንቶ።<verse eid="ACT 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ACT 4:11"/>«‹ይንቲ ግምቢዝታይ ቦሪ እጼዝ ሹቻይ፥</para>
  <para style="q2" vid="ACT 4:11">ኬ ሙመር ቶኪ አይክዝ ክርክሮ ጋርከ፥</para>
  <para style="q2" vid="ACT 4:11">ኡባይፕ ኣዝ ሹች ማቄዛ፤</para>
  <para style="q2" vid="ACT 4:11">የ ሹቻይ የሱሳ።›<note caller="-" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="PSA 118:22">ማዝ. 118:22</ref></char></note><verse eid="ACT 4:11"/></para>
  <para style="m">
    <verse number="12" style="v" sid="ACT 4:12"/>የይ ግሾስ፥ አቶት ኤ ባጋራፕ አትን ሀራ ኦ ባጋራካ ባያ። ኑኒ ኤ ሱንር አቶድ ጋርክ አስ ኡባይስ ጾሲ ሳሎፕ ኦሞር እንጌዝ ሀራ ሱን ባያ» ዬጌዛ።<verse eid="ACT 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 4:13"/>ሺቄዝ አሳይ ጵጽሮሳኔ ዋንሳ ያሻ ባይ ቆንጨ ኦዴዛና ብኢ ዎደ ኡንቲ ታማረካ ጨረ አስ ማቄዛና አካኪ ማላባዝ ጌዛ፤ ኡንቲ የሱሳር የዛያና ኤሬዛ። <verse eid="ACT 4:13"/><verse number="14" style="v" sid="ACT 4:14"/>ማ ፓጼዝ አይ ጵጽሮሳራኔ ዋንሳራ ኤቄዛና አሳይ ብእን ጎድባዝ ቤዛ። <verse eid="ACT 4:14"/><verse number="15" style="v" sid="ACT 4:15"/>ዝን ጵጽሮሳኔ ዋንሳ ባለ ከዞዳይ ጋርክ ኡዲ ፋ ጋንጨ፥ <verse eid="ACT 4:15"/><verse number="16" style="v" sid="ACT 4:16"/>«Ꮊ አስታ ኑ አብ ኡዶ? ኡ ኩሸ ኦስንቴዝ ግታ ማላ ባዛይ የሩሳላመ የዝ ኡባይስ በንትዛ። ኑኒ የያ ኤሮዋ ጎዳይስ ዳንዳኦያ። <verse eid="ACT 4:16"/><verse number="17" style="v" sid="ACT 4:17"/>ዝን Ꮊ ኦዳይ አስ ጋንጨ ላልንታማይ ጋርክ ይከፕ ጉየ Ꮊ አስታይ የሱሳ ሱንይር ኦስካ ኦዳማይኔ ታማርሳማይ ጋርክ ሚን ኦዲ» ዬጊ ዞርንቴዛ።<verse eid="ACT 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 4:18"/>ኡንታን ጼጊ፥ የሱሳ ሱንይር Ꮊንፕ ገደ የሻ ኦዳማይ ጋርከኔ ታማርሳማይ ጋርክ ኪቴዛ። <verse eid="ACT 4:18"/><verse number="19" style="v" sid="ACT 4:19"/>ዝን ጵጽሮሳኔ ዋንሳ ኡንትኮ ማሂ፥ «ጾስስ ኪትንቶዳይፐኔ ይንትስ ኪትንቶዳይፕ ጾስ ቲና ኣይ ሎኦዛኮ አን ይ ፕርዶይታ። <verse eid="ACT 4:19"/><verse number="20" style="v" sid="ACT 4:20"/>ኑኒ በኤዝ ባዝኔ ስኤዝባዝ ኦዳ አሾዳይስ ዳንዳኦያ» ዬጌዛ።<verse eid="ACT 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 4:21"/>ዎያ ጭምታይኔ ካልዝታይ ካሴሳይፕ ሚን ናግሲ ኡንታን ዳኪ አሼዛ። አሳይ ሀኔዝባዛይስ ጾስ ጋላትዛ ግሾስ ኡንታን ሴሮዳይስ ዳንዳእበኤካያ። <verse eid="ACT 4:21"/><verse number="22" style="v" sid="ACT 4:22"/>የ ማላታይር ሀርገፕ ፓዝ አይስ ላይይ ኦይታማፕ ኣ።<verse eid="ACT 4:22"/></para>
  <para style="s1">አማንዛ አሳይ ዎሳ</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23"/>ጵጽሮሳኔ ዋንሳ ብልእንቲ ኡንታር አማንዛ ዳብታይኮ Ꮊንጊ፥ ቄሰ ሀላቅታይኔ ጭምታይ ፋኮ ጌዝባዝ ኡባ ኡንትስ ኦዴዛ። <verse eid="ACT 4:23"/><verse number="24" style="v" sid="ACT 4:24"/>ኡንቲ የያ ስኤዝ ዎደ ፐቲ ዎዝናር ማቂ ጾሳ Ꮊይ ጋርክ ዬጊ ዎሴዛ፦ «ኡባ ሞድዝ ጎዳዮ፥ ሳሎ፥ ሳአ፥ አባኔ ኡ ጋንጨ የዝ ኡባ ባዝ መዛዮ፥<note caller="-" style="x"><char style="xo" closed="false">4:24 </char><char style="xt" closed="false"><ref loc="EXO 20:11">ከስ 20:11</ref>፤ <ref loc="NEH 9:6">ናህ. 9:6</ref>፤ <ref loc="PSA 146:6">ማዝ. 146:6</ref></char></note> <verse eid="ACT 4:24"/><verse number="25" style="v" sid="ACT 4:25"/>ኔኒ ነ አይላና፥ ኑ አደ ዳዉተ ዶና ጌሻ አያናር፥</para>
  <para style="q1" vid="ACT 4:25">«‹ዎያ አብስ ይሎቴኔ?</para>
  <para style="q2" vid="ACT 4:25">አሳይ አብስ ጨረ ቶቤኔ?<note caller="-" style="x"><char style="xo" closed="false">4:25-26 </char><char style="xt" closed="false"><ref loc="PSA 2:1-2">ማዝ. 2:1-2</ref></char></note><verse eid="ACT 4:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 4:26"/>ሳአ ካትትይኔ</para>
  <para style="q2" vid="ACT 4:26">ጋደ ሀርዝታይ ፐትፕ ጎዳይል አፋኔ</para>
  <para style="q2" vid="ACT 4:26">ኤ ክርስቶሳል አፋ ደንዴዛ› ዬጌዛ።<verse eid="ACT 4:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 4:27"/>«ቱማካ፥ ሄሮዶሳኔ ጰንጸ ጵላጾሳ አይሁደ ባ አሳይራኔ እስሬለ አሳይራ ነ ትዤዝ ነ ጌሻ ናአ የሱሳል አፋ ደንዶዳይስ Ꮊ ካታማይ ሺቄዛ።<note caller="-" style="x"><char style="xo" closed="false">4:27 </char><char style="xt" closed="false"><ref loc="MAT 27:1-2">ማቶ. 27:1-2</ref>፤ <ref loc="MRK 15:1">ማር. 15:1</ref>፤ <ref loc="LUK 23:1">ሉቃ. 23:1</ref>፥ <ref loc="LUK 23:7-11">7-11</ref>፤ <ref loc="JHN 18:28-29">ዋን. 18:28-29</ref></char></note> <verse eid="ACT 4:27"/><verse number="28" style="v" sid="ACT 4:28"/>ማ ነ ዎልቃይዳኔ ነ ሸናይድ ኡዶድ ግ ቆፕ በቴዛ ኡባ ኡንቲ ፖሌዛ። <verse eid="ACT 4:28"/><verse number="29" style="v" sid="ACT 4:29"/>Ꮊተካ ጎዳዮ፥ ኡ ማንድ ቦኦባ፤ ኑኒ ነ አይልታይ ነ ቃላ ኩን ዎዝናር ኦዶዳ ጋርክ ኑና ዳንዳእሶባ። <verse eid="ACT 4:29"/><verse number="30" style="v" sid="ACT 4:30"/>ነ ጌሻ ኦሳንቾ የሱሳ ሱንር ሀርጋንችታ ፓዳይስ፥ ኦራባዝኔ ማላትታይ ኦስንቶዳይ ጋርክ ነ ኩሸ ምጮባ» ግ ዎሴዛ።<verse eid="ACT 4:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 4:31"/>ኡንቲ ጾስ ዎሴዛይፕ ጉየ የ ኡንቲ ሺቄዝ አቃይ ኤንኤዛ። ኡ ኡባይ ጌሻ አያናር ኩምን ጾስ ቃላ ጎብ ኦዴዛ።<verse eid="ACT 4:31"/></para>
  <para style="s1">ቲና አማኔዝ አሳይ ፐትፐተ</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 4:32"/>አማንዝታይ ኡባይ ቆፋራኔ ዎዝናር ፐቶ ማቄዛ። ኡንቲ ፓስ የዛ ባዝ ታባዝ ጌካዛር ፐትፕ ሻክንትዛ።<note caller="-" style="x"><char style="xo" closed="false">4:32 </char><char style="xt" closed="false"><ref loc="ACT 2:44-45">ሀዋ. ኦ. 2:44-45</ref></char></note> <verse eid="ACT 4:32"/><verse number="33" style="v" sid="ACT 4:33"/>ሀዋርታይ ጎዳ የሱሳ Ꮊይቆፕ ደንዝ ግታ ዎልቃር ማርካትዛ። ጾስ ኡንትስ ኡባይስ ኣ ኬሃትይፕ ጋን እንጌዛ። <verse eid="ACT 4:33"/><verse number="34" style="v" sid="ACT 4:34"/>ቢታ ዎይ ካምፓ የዝታይ ኡባይ ባይዚ ኤኬዝ ሚሻ ክእዛ ግሾስ አማንዝታይ ጋንጨ መትንቴዛይ ፐታካ ባያ። <verse eid="ACT 4:34"/><verse number="35" style="v" sid="ACT 4:35"/>ሚሸ ክኢ ሀዋርታይስ እንግዛ፤ የ ሚሻ ፐታይስ ፐታይስ ኮሽዛይ ጋርክ ሻጊ ሻጊ እንግዛ።<verse eid="ACT 4:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 4:36"/>ቆጲሮሳ ግዝ አቆ የልንቴዝ ዮሴፋ ግዝ ለወ ሼሻይፕ ማቄዝ ፐታይ የዛ። ኤ ሱን ሀዋርታይ ባርናባሳ ጌዛ። ባርናባሳ ጉሳይ ምን ናአ ጉሲ ጌዛ። <verse eid="ACT 4:36"/><verse number="37" style="v" sid="ACT 4:37"/>ባርናባሳ ፓስ የዝ ቢታ ባይዚ ሚሻ ክኢ ሀዋርታይስ እንጌዛ።<verse eid="ACT 4:37"/></para>
  <chapter eid="ACT 4"/>
  <chapter number="5" style="c" sid="ACT 5"/>
  <para style="s1">ሀናናኔ ኤ ማቻት ሳጵሮ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 5:1"/>ፐቲ ሀናና ግዝ አይ ፋ ማቻት ሳጵርር ዎላ ጋደ ባይዜዛ። <verse eid="ACT 5:1"/><verse number="2" style="v" sid="ACT 5:2"/>የ ባይዜዝ ሚሻይፕ ፋ ማቻት ኤሮዳር ሻጊ አሺ፥ አቴዛና ክኢ ሀዋርታይ ቶኬ ካለ ጋዴዛ።<verse eid="ACT 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 5:3"/>ዝን ጵጽሮሳ ሀናናኮ፥ «ኔኒ ጌሻ አያና ዶሾዳይ ጋርኬኔ ቢታ ባይዜዝ ሚሻይፕ ሻጊ አሾዳይ ጋርክ ጻላሄ ነ ዎዛና አብስ ገሌኔ? <verse eid="ACT 5:3"/><verse number="4" style="v" sid="ACT 5:4"/>ኔኒ ባይዞዳይፕ ቲና ቢታይ ኔስ ባሳኔ? ማ ነ ባይዝ ማቅንካ ሚሻይ ኔስ ባሳኔ? የዝን፥ የይ ጋርክ ኦዳይስ አብስ ነ ዎዝናር ቆፔኔ? ኔኒ ጾሳል አፋ ዎርዶቴነፕ አትን አሳል አፋ ዎርዶተካያ» ዬጌዛ።<verse eid="ACT 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 5:5"/>ሀናኔ የ ቃላ ስኤዛን ጋርክ ፖኪ Ꮊይቄዛ፤ የያ ስኤዝ ኡባይ ኢታ ያሽቴዛ። <verse eid="ACT 5:5"/><verse number="6" style="v" sid="ACT 5:6"/>ናአት አስታይ ደንዲ ኤ አሃ ዚ አፍላር ጻጺ ካንጊ ሞጌዛ።<verse eid="ACT 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 5:7"/>ሀይ ሳተፕ ጉየ ሀናና ማቻት የያ ኤረካዛር ጵጽሮሳ የዛ አቆ ገሌዛ። <verse eid="ACT 5:7"/><verse number="8" style="v" sid="ACT 5:8"/>ጵጽሮሳ ኢኮ፥ «ይ ቢታ Ꮊኒ ጋርክ ሚሸስ ባይዜኔ? አን ታስ ኦዶባ» ዬጌዛ።</para>
  <para style="p" vid="ACT 5:8">እዛካ፥ «ኤ፥ Ꮊይ ጋርክ ሚሸስ ባይዜዝ» ዬጌዛ።<verse eid="ACT 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 5:9"/>ጵጽሮሳ ኢኮ፥ «ኔራኔ ነ አዝናይራ ጎዳ አያና ፋጮዳይስ አብስ ዞርንቴኔ? ዬዛኮ፥ ነ አዝና ሞጌዝ አሳይ ባለር የዛ፤ ነናካ ኡንቲ ባለ ከሶዳ» ዬጌዛ።<verse eid="ACT 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 5:10"/>እዛካ እዝር ጵጽሮሳ ቶኬ አቻ ፖኪ Ꮊይቂ አቴዛ፤ ናአትታይ ገሎዳር Ꮊይቄዛኖ ደንጊ ባለ ከሲ፥ እ አዝናይ ካለ ሞጌዛ። <verse eid="ACT 5:10"/><verse number="11" style="v" sid="ACT 5:11"/>ዎሳ ኬ ኡባይኔ የያ ስኤዝ ሀራ አስ ኡባይ እታ ያሽቴዛ።<verse eid="ACT 5:11"/></para>
  <para style="s1">ኦሮባዝታኔ ማላ ብዝታ</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12"/>ሀዋርታይ ጋመ ማላትታኔ ኦሮባዝታ አስ ጋንጨ ኦዛ። አማንዛ ኡባይ ሶሎሞነ ባራንዳ ፐትፕ ሺቄዛ። <verse eid="ACT 5:12"/><verse number="13" style="v" sid="ACT 5:13"/>ሀራ አሳይፕ ፐቲ አስካ ኡንታን ሄሎዳይስ ምንገካያ፥ ዝን አሳይ ኡንታን ቦንችዛ። <verse eid="ACT 5:13"/><verse number="14" style="v" sid="ACT 5:14"/>አማንዛ ራታይኔ ማችታይ ታይባይ ካሴሳይፕ ጋንግታር ጋግታር ቅቴዛ። <verse eid="ACT 5:14"/><verse number="15" style="v" sid="ACT 5:15"/>የይ ግሾስ፥ አሳይ ሀርጋንችታ ሀላራኔ አርሳር ቶኪ ጵጽሮሳ ኣዳር ኤ ኩያይ ኡንታፕ ፐታይል ፐታይል አፋ ሸምፖዳይ ጋርክ ኦገ ዶና ከሲ ጋዴዛ። <verse eid="ACT 5:15"/><verse number="16" style="v" sid="ACT 5:16"/>ማ ጋመ አሳይ የሩሳላመ ካለ የዝ ካታምታይፕ ሀርጋንችታኔ ቱና አያና ዋይስዛ አስታ ኤኪ ይእዛ፤ ኡባይካ ፓጼዛ።<verse eid="ACT 5:16"/></para>
  <para style="s1">ሀዋርታይል አፋ ባይእ ደንዴዝ</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 5:17"/>ቄሰ ሀላቃይኔ ኤዛር የዝ ሳዱቃውታይ ኡባይ ቅናተር ኩሚ ሀዋርታይል አፋ ደንዴዛ። <verse eid="ACT 5:17"/><verse number="18" style="v" sid="ACT 5:18"/>ሀዋርታና አይኪ ዎያ አች ካራ ኦሌዛ። <verse eid="ACT 5:18"/><verse number="19" style="v" sid="ACT 5:19"/>ዝን ጎዳ ኪታንቻይ ቃማ አች ካራ ፐንጋ ዶዪ ሀዋርታ ባለ ከሲ፥ <verse eid="ACT 5:19"/><verse number="20" style="v" sid="ACT 5:20"/>«Ꮊንጊ፥ ጾስ ካራ ኤቂ Ꮊ ደኦ ቃላ አስ ኡባይስ ኦዶይታ» ዬጌዛ። <verse eid="ACT 5:20"/><verse number="21" style="v" sid="ACT 5:21"/>ሀዋርታይ የያ ስኤዝ ዎደ ዎንት ጉራ ጾስ ካራ ገሊ ታማርሶ አይኬዛ።</para>
  <para style="p" vid="ACT 5:21">ቄስታይ ሀላቃይኔ ኤዛር የዝታይ ይኢ፥ እስሬለ ጭምታ ኡባ ጼጊ ሺሺ ሀዋርታ ፋ ቲና ኮኦዳይ ጋርክ ዎታዳርታ አች ካራ ኪቴዛ። <verse eid="ACT 5:21"/><verse number="22" style="v" sid="ACT 5:22"/>ዝን ዎታዳርታይ አች ካራ Ꮊንጊ ሀዋርታ ደንገካያ። ጉየ ማቂ ይኢ ዎያስ፥ <verse eid="ACT 5:22"/><verse number="23" style="v" sid="ACT 5:23"/>«ኑኒ Ꮊንጎዳር አች ካራ እብይ ሚን ጎርደትን፥ ናግዝታይ ፐንገል ኤቄዝታ ደንጌዝ። ዝን ኑኒ ፐንጋ ዶዮዳር ጋንጨ ሀራ አቶዝን ፐቲ አስካ ባያ» ዬጌዛ። <verse eid="ACT 5:23"/><verse number="24" style="v" sid="ACT 5:24"/>የይ ግሾስ፥ ጾስ ካራ ዎታዳርታ ኪትዛይኔ ቄሰ ሀላቅታይ የያ ስኤዝ ዎደ «ሀዋርታይል አፋ አብ ሀነኔ?» ዬጊ ታዌዛ።<verse eid="ACT 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 5:25"/>የ ዎደ ፐቲ አይ ኡንትኮ ይኢ፥ «አች ካራ ይ ገልሴዝ አስታይ ጾስ ካራ ኤቂ አሳ ታማርስዛ» ዬጊ ኡንትስ ኦዴዛ። <verse eid="ACT 5:25"/><verse number="26" style="v" sid="ACT 5:26"/>ጾስ ካራ ዎታዳርታ ኪትዛይ ፋ ዎታዳርታይራ Ꮊንጊ ሀዋርታ ከኤዛ። ዝን ኡንቲ ፋና አሳይ ሹቻር ሾጮዳ ግ ያሽቴዝ ግሾስ ኡንታን አዳሺ ከኤዛ።<verse eid="ACT 5:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 5:27"/>ኡንቲ ሀዋርታ ክኢ፥ ሺቄዝ ሻንጎ ቲና ክእን ቄሰ ሀላቃይ ኡንትኮ፥ <verse eid="ACT 5:27"/><verse number="28" style="v" sid="ACT 5:28"/>«ይንታን ኑኒ ያ አይ ሱንር ታማርሳማይ ጋርክ ሚን ኪተካሳ? ዬዛኮ፥ ይ ትምርታ ይ የሩሳላመ ካታማ ኡባ ሄልዛ። የ አይ ሸምፖይስ ኑና ኦይጭሾዳይስ ይ ቆፕነ?» ዬጊ ኦይጬዛ።<note caller="-" style="x"><char style="xo" closed="false">5:28 </char><char style="xt" closed="false"><ref loc="MAT 27:25">ማቶ. 27:25</ref></char></note><verse eid="ACT 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 5:29"/>ጵጽሮሳኔ Ꮊንኮ ሀዋርታይር ኡንትስ ማህታር፥ «ኑኒ አስስ ኪትንቶዳይፕ ጾስስ ኪትንቶዳይስ ኑስ ቤዝዛ። <verse eid="ACT 5:29"/><verse number="30" style="v" sid="ACT 5:30"/>ማዝቃለል አፋ ይ ሶቲ ዎዝ የሱሳ ኑ አድታይ ጾሳይ Ꮊይቆፕ ደንዛ። <verse eid="ACT 5:30"/><verse number="31" style="v" sid="ACT 5:31"/>እስሬልታይ ናጋራይፕ ማቆዳይ ጋርከኔ ኡ ናጋራይ አቶ ግንትንቶዳይ ጋርክ ጾሲ የሱሳ ሃርዛኔ አሽዛ ኡዲ ቦንቾር ፋፐ ኡሻች ባጋር በትዛ። <verse eid="ACT 5:31"/><verse number="32" style="v" sid="ACT 5:32"/>የይስ ኑኒ ማርካ፤ ማ ጾሲ ፋስ ኪትንትዝታይስ እንጌዝ ጌሻ አያናይካ ማርካ» ዬጌዛ።<verse eid="ACT 5:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 5:33"/>ሺቄዝ አሳይ የያ ስኤዝ ዎደ ኢታ ይሎቲ፥ ሀዋርታ ዎዳይስ ቆፔዛ። <verse eid="ACT 5:33"/><verse number="34" style="v" sid="ACT 5:34"/>ዝን አስ ኡባይድ ሎኦ ቦንችንቴዝ፥ ህገ አስታማራይ፥ ጋማላለ ግዝ ፐቲ ፈርሳዋይ ደንዲ ኤቂ ሀዋርታ ጽቃ ዎደስ ባለ ከሶዳይ ጋርክ አዛዘዛ። <verse eid="ACT 5:34"/><verse number="35" style="v" sid="ACT 5:35"/>የይፕ ጉየ፥ ሺቄዝ አሳይኮ፥ «እስሬለ አሳዮ፥ Ꮊ አስታይል አፋ ይ ኡዶዳይስ ቆፕዛባዝፕ ናግንቶይታ። <verse eid="ACT 5:35"/><verse number="36" style="v" sid="ACT 5:36"/>አብስ ጊኮ፥ Ꮊይፕ ቲና ተዎዳሳ ፋና፥ ‹ታኒ ዳማ› ግ ደንድን፥ ኦይዲ ጼት ማቅዝ አስታይ ኤዛር ማእንቴዛ። ዝን ኤዛ ዎን፥ ኤዛ ካሌዝ ኡባይ ላልንቲ ፓዋ አስታ ማቄዛ። <verse eid="ACT 5:36"/><verse number="37" style="v" sid="ACT 5:37"/>የይፕ ጉየ፥ አሳይ ታይብንትዛ ዎደ ጋልላ የዝ ይሁዳ ደንዲ ጋመ አስ ፓንጋ ማሂ ካልዝ፥ ዝን ኤዛካ ዎን ኤዛ ካሌዝ አስ ኡባይ ላልንቴዛ። <verse eid="ACT 5:37"/><verse number="38" style="v" sid="ACT 5:38"/>Ꮊተካ ታ ይንትስ ኦድዛ፤ Ꮊ አስታይፕ ሻክንቶይታ፤ ኡንታን ቦችፓተ። አብስ ጊኮ፥ Ꮊ ቆፋኔ Ꮊ ኦሳ አሲ ኦዛባዝ ማቅኮ ቦዳ። <verse eid="ACT 5:38"/><verse number="39" style="v" sid="ACT 5:39"/>ዝን Ꮊ ቆፋይኔ Ꮊ ኦሳይ ጾሳፕ የኤዝ ባዝ ማቅኮ፥ ይ ኡንታን ብሶዳይስ ዳንዳኦዋ። ዬይታር ይ ጾሳር ካጭንቶዳ» ዬጊ ኦዴዛ። የይ ግሾስ፥ ሺቄዝ አሳይ ጋማላለ ዞርዛ ኤኬዛ።<verse eid="ACT 5:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 5:40"/>ሀዋርታ ካራ ጼጊ ገልሲ አላንጋር ጋራፌዛ። የይፕ ጉየ፥ ኡንትኮ፥ «የሱሳ ሱን ናምእን ደንፓተ» ግ ብልእ ዳኬዛ። <verse eid="ACT 5:40"/><verse number="41" style="v" sid="ACT 5:41"/>የሱሳ ሱንይ ግሾስ ኡንቲ ካዉዦዳይ ቤዝዛ ባዝ ማቄዛና ኤሬዝ ግሾስ ሻንግታይ ቲናፕ ኡፋይትታር ከዜዝ። <verse eid="ACT 5:41"/><verse number="42" style="v" sid="ACT 5:42"/>ኡንቲ ኡባ ዎደ ጾስ ኬኔ አስ ካራ የሱሳ ኤ ክርስቶሳ ማቄዛና ታማርስዛናኔ ሳባክዛና አሸካያ።<verse eid="ACT 5:42"/></para>
  <chapter eid="ACT 5"/>
  <chapter number="6" style="c" sid="ACT 6"/>
  <para style="s1">ላፑን አስታይ ዶርንቶ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1"/>የ ዎደ ካልዝታይ ታይባይ ጋንጊ ጋንጊ Ꮊንጎዳር፥ ግርኬ ዶና ኦድንትዛ አይሁድታይ ይሁዳ የልንቲ የዝ አይሁድታይል አፋ ኦሌዛ። አብስ ጊኮ፥ ግርኬ ዶና ኦድንትዛ አይሁድታይ፥ «ጋላስ ጋላስ እንግንትዛ ካይፕ አዝኒ Ꮊይቄዝ ማችታ ኡ ዶግዛይ ግሾስ» ዬጌዛ። <verse eid="ACT 6:1"/><verse number="2" style="v" sid="ACT 6:2"/>ታጶ ናምኢ ሀዋርታይ ዎሳ ኬ አስ ኡባ ጼጊ፥ «ኑኒ ጾስ ቃላ ኦድዛና አሺ ካ ግሾዳይስ ኑስ ቤዞያ። <verse eid="ACT 6:2"/><verse number="3" style="v" sid="ACT 6:3"/>ይኬ፥ ኑ እሹን፥ ሎኦ አስታ፥ ጌሻ አያናራኔ ኤጨትር ኩሜዝ ላፑን አስታ ይ ጋንጨፕ ዶሮይታ፤ ኑኒ ኡንታን Ꮊ ኦሳይስ ሹሞዳ። <verse eid="ACT 6:3"/><verse number="4" style="v" sid="ACT 6:4"/>ዝን ኑኒ፥ ኑ ኩን ዎደ ጾሳ ዎሳላኔ ቃላ ታማርሶል ፔሾዳ» ዬጌዛ።<verse eid="ACT 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 6:5"/>ሀዋርታይ ኦዴዝ ኦዳይ አስ ኡባ ኡፋይሴዛ። የይ ግሾስ፥ አማኖራኔ ጌሻ አያናር ኩሜዝ ኢስጽፋኖሰ፥ ፍልጶሳ፥ ጵሮኮሮሳ፥ ንቃሮነ፥ ጽሞና፥ ጳርሜናኔ አይሁደ አማኖ ገሊ ማቄዝ አንጾካ ንቆሎሳ ማራጼዛ። <verse eid="ACT 6:5"/><verse number="6" style="v" sid="ACT 6:6"/>ኡንታን ሀዋርታይ ቲና ክእን፥ ሀዋርታይ ኡንታል አፋ ኩሸ ጋዲ ጾስ ዎሴዛ።<verse eid="ACT 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 6:7"/>ጾስ ቃላይ ዳልግታር ዳልግታር Ꮊንጌዛ። የሩሳላመ የዝ አማንዝታይ ታይባይ ጋንጊ ጋንጊ ቅቴዛ፤ ቄስታይፐካ ጋምታይ አማኔዛ።<verse eid="ACT 6:7"/></para>
  <para style="s1">ኢስጸፋኖሰ አይክንቴዛ</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 6:8"/>ኢስጸፋኖሰ አ ኬሃተይራኔ ዎልቃር ኩሚ አስ ጋንጨ ኦሮባዝታኔ ማላባዝታ ኡድዛ። <verse eid="ACT 6:8"/><verse number="9" style="v" sid="ACT 6:9"/>አይለትፕ ከዝዝታይስ ግንትንተዝ አይሁደ ዎሳ ኬ አሳይ ቀረናፐኔ ኢስክንድረፐ ክልቀፐኔ ኢስያፕ የኤዝ ፐቲ ፐቲ አስታይ ደንዲ ኢስጽፋኖሳር ፓላሜዛ። <verse eid="ACT 6:9"/><verse number="10" style="v" sid="ACT 6:10"/>ዝን ኢስጽፋኖሰ ኦድንትታር የዝ ኤጨትኔ አያና ኡንቲ ኤቅንቶዳይስ ዳንዳኤካያ።<verse eid="ACT 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 6:11"/>የ ዎደ ኡንቲ፥ «ሙሰናኔ ጾሳ ኤ ጫዦዳር ስኤዛ» ግዝ ዎርዶ ማርክታ ደንዛ። <verse eid="ACT 6:11"/><verse number="12" style="v" sid="ACT 6:12"/>የይ ጋርክ ኡዲ ዎያ ጋደ ጭምታኔ ህገ አስታማርታ ኤዛል አፋ ደንሴዛ። ኢስጽፋኖሰና አይኪ ሻንጎ ቲና ካንጌዛ። <verse eid="ACT 6:12"/><verse number="13" style="v" sid="ACT 6:13"/>ኤዛል አፋ ፓይዴዝ ዎርዶ ማርክታይ፥ «Ꮊ አይ Ꮊ ጾስ ካራኔ ሙሰ ህጋ ማሂ ማሂ ጫዥዛ። <verse eid="ACT 6:13"/><verse number="14" style="v" sid="ACT 6:14"/>ኤ፥ ‹Ꮊይ ናዝረተ የሱሳ፥ Ꮊ ጾስ ካራ ላሎዳ፤ ማ ሙሰ ኑስ እንጌዝ ህጋ ላሞዳ› ዬጎዳር ኑኒ ስኤዝ» ዬጌዛ።<verse eid="ACT 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 6:15"/>ሻንጎ ሺቆል በቴዝ አስ ኡባይ ኢስጽፋኖሰ ዳኪ በአዳር ኤ ስናይ ኪታንቾ ስኖ ኣዝዛ።<verse eid="ACT 6:15"/></para>
  <chapter eid="ACT 6"/>
  <chapter number="7" style="c" sid="ACT 7"/>
  <para style="s1">ኢስጽፋኖሰ ናሻ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1"/>ቄስታይ ሀላቃይ ኢስጽፋኖሰኮ፥ «Ꮊ ሞታይ ቱማ?» ዬጊ ኦይጬዛ።<verse eid="ACT 7:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 7:2"/>ኢስጽፋኖሰ፥ «ታ እሹን፥ ታ አድታዮ፥ ስኦይታ! ኑ አዳ አፍራመ ካራነ የዞዳይስ Ꮊንጎዳይፕ ቲና ማሰጰጾመ የዝን፥ ቦንቾ ጾሳይ ኤስ ቆንጪ፥<note caller="-" style="x"><char style="xo" closed="false">7:2-3 </char><char style="xt" closed="false"><ref loc="GEN 12:1">መ. 12:1</ref></char></note> <verse eid="ACT 7:2"/><verse number="3" style="v" sid="ACT 7:3"/>‹ነ ጋዳይፐኔ ነ ዳብታይፕ ሻክንቲ ታኒ ነና ቤዝዛ ቢታ ቅቶባ› ዬጌዛ። <verse eid="ACT 7:3"/><verse number="4" style="v" sid="ACT 7:4"/>የ ዎደ አፍራመ ካላዳውታይ ቢታፕ ከዚ ካራነ የዞዳይስ ቅቴዛ። ኤ አዳይ Ꮊይቄዛይፕ ጉየ ጾሲ ኤዛ Ꮊ ቢታ Ꮊት ይ የዝ ጋዳ ከኤዛ።<note caller="-" style="x"><char style="xo" closed="false">7:4 </char><char style="xt" closed="false"><ref loc="GEN 11:31">መ. 11:31</ref>፤ <ref loc="GEN 12:4">12:4</ref></char></note> <verse eid="ACT 7:4"/><verse number="5" style="v" sid="ACT 7:5"/>ኤ ሀራ አቶዝን ቶካይ የዝ አቆካ አፍራመስ እንገካ። ዝን ናአ ኤስ ባ ዎደ ጾስ Ꮊ ቢታ ኤስኔ ኤ ሼሻይስ ላታ ኡዲ እንጎዳና ቃላ ገሌዛ።<note caller="-" style="x"><char style="xo" closed="false">7:5 </char><char style="xt" closed="false"><ref loc="GEN 12:7">መ. 12:7</ref>፤ <ref loc="GEN 13:15">13:15</ref>፤ <ref loc="GEN 15:18">15:18</ref>፤ <ref loc="GEN 17:8">17:8</ref></char></note> <verse eid="ACT 7:5"/><verse number="6" style="v" sid="ACT 7:6"/>ጾሲ አፍራመኮ፥ ‹ነ ሼሻይ ሀራ ቢታ እማትር የዞዳ፤ ኤዛይድ ኦይዲ ጼት ላይ ኡንቲ አይለት ሃርንቶዳ። <verse eid="ACT 7:6"/><verse number="7" style="v" sid="ACT 7:7"/>ዝን ታኒ ነ ሼሻ ሞድዝ ጋዳይል አፋ ፕርዶዳ። የይፕ ጉየ፥ ኡንቲ የ ቢታይፕ ከዚ Ꮊይዳ ታስ ጎይኖዳ› ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">7:7 </char><char style="xt" closed="false"><ref loc="EXO 3:12">ከስ 3:12</ref></char></note> <verse eid="ACT 7:7"/><verse number="8" style="v" sid="ACT 7:8"/>ጾሲ አፍራመ ሼሻይ ዶካልንቶዳይ ጋርክ ኤዛር ጫቂን፥ እሳቃ የልንቴዝ ሆስፑን ጋላሳር ዶካሌዛ። እሳቃ ያይቆባና ዶካሌዛ፤ ማ ያይቆባ ፋ ታጶ ናምኢ ናእታ፥ ኑ አድታይ ማይዝታ ዶካሌዛ።<note caller="-" style="x"><char style="xo" closed="false">7:8 </char><char style="xt" closed="false"><ref loc="GEN 17:10-14">መ. 17:10-14</ref>፤ <ref loc="GEN 21:2-4">21:2-4</ref>፤ <ref loc="GEN 25:26">25:26</ref>፤ <ref loc="GEN 29:31-35">29:31-35</ref></char></note><verse eid="ACT 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 7:9"/>«ያይቆባ ናእታይ ዮሴፋና ቅናቲ ግብጸ ቢታ አይለትስ ባይዜዛ፥ ዝን ጾሲ ኤዛር የዛ።<note caller="-" style="x"><char style="xo" closed="false">7:9 </char><char style="xt" closed="false"><ref loc="GEN 37:11">መ. 37:11</ref>፥ <ref loc="GEN 37:28">28</ref>፤ <ref loc="GEN 39:2">39:2</ref>፥ <ref loc="GEN 39:21">21</ref></char></note> <verse eid="ACT 7:9"/><verse number="10" style="v" sid="ACT 7:10"/>ኤዛ፥ ኤ ዋየ ኡባይፕ ከሴዛ። ግብጸ ካት ፓሮና ቲና ዴተኔ ኤጨት ኤስ እንጌዛ። ግብጸ ካታይ ዮሴፋስ ግብጸ ቢታኔ ፋ ካራ ኡባ አቅሶድ ሀላቃት እንጌዛ።<note caller="-" style="x"><char style="xo" closed="false">7:10 </char><char style="xt" closed="false"><ref loc="GEN 41:39-41">መ. 41:39-41</ref></char></note><verse eid="ACT 7:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 7:11"/>«ግብጸ ቢታይዳኔ ካንአነ ጋደ ኡባይድ ናየ ገሊ ጋመ አሳ ኡንእዛ። የ ዎደ ኑ ማይዝታይ ካ ደንጎዳይስ ዳንዳእበኤካያ። <verse eid="ACT 7:11"/><verse number="12" style="v" sid="ACT 7:12"/>ያይቆባ ግብጸ ቢታ ካ የዛና ስኢ ኑ አድታይ ቲና ገድ ኤዛ ዳኬዛ። <verse eid="ACT 7:12"/><verse number="13" style="v" sid="ACT 7:13"/>ናምእን Ꮊማይር ዮሴፋ ፋ እሽታይስ ፋና ኤርሴዛ። ግብጸ ካት ፋሮና ዮሴፋ ሼሻና ኤሬዛ።<note caller="-" style="x"><char style="xo" closed="false">7:13 </char><char style="xt" closed="false"><ref loc="GEN 45:1">መ. 45:1</ref>፥ <ref loc="GEN 45:16">16</ref></char></note> <verse eid="ACT 7:13"/><verse number="14" style="v" sid="ACT 7:14"/>ዮሴፋ ፋ አደ ያይቆባኔ ፋ ዳቦ ኡባ፥ ላፑን ታማን እችን አሳይ ፋኮ የኦዳይ ጋርክ ኪቲ ክእሴዛ።<note caller="-" style="x"><char style="xo" closed="false">7:14 </char><char style="xt" closed="false"><ref loc="GEN 45:9-10">መ. 45:9-10</ref>፥ <ref loc="GEN 45:17-18">17-18</ref>፤ <ref loc="GEN 46:27">46:27</ref></char></note> <verse eid="ACT 7:14"/><verse number="15" style="v" sid="ACT 7:15"/>ያይቆባ ግብጸ ቢታ ዎዛ፤ ኤነ ኤ ናእታይ ኤዛይድ Ꮊይቄዛ።<note caller="-" style="x"><char style="xo" closed="false">7:15 </char><char style="xt" closed="false"><ref loc="GEN 46:1-7">መ. 46:1-7</ref>፤ <ref loc="GEN 49:33">49:33</ref></char></note> <verse eid="ACT 7:15"/><verse number="16" style="v" sid="ACT 7:16"/>ኡ መቀ የ አቃይፕ ሴኬመ ቶክንቲ Ꮊንጊ፥ ኤዛይድ አፍራመ ሀሞረ ናእታይፕ ጋም ብራር ዎንጌዝ ዱፋይድ ሞጌዛ።<note caller="-" style="x"><char style="xo" closed="false">7:16 </char><char style="xt" closed="false"><ref loc="GEN 23:3-16">መ. 23:3-16</ref>፤ <ref loc="GEN 33:19">33:19</ref>፤ <ref loc="GEN 50:7-13">50:7-13</ref>፤ <ref loc="JOS 24:32">ኢያ. 24:32</ref></char></note><verse eid="ACT 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 7:17"/>«ዝን ጾሳይ አፍራመስ እንጎድ ጌዛ ፖልዛ ላይ ሄሎዳይስ ሄሌዝ ዎደ ግብጸ ቢታይድ የዝ ኑ አሳይ ጋንጊ ጋንጊ ቅቴዛ።<note caller="-" style="x"><char style="xo" closed="false">7:17-18 </char><char style="xt" closed="false"><ref loc="EXO 1:7-8">ከስ 1:7-8</ref></char></note> <verse eid="ACT 7:17"/><verse number="18" style="v" sid="ACT 7:18"/>የይፕ ጉየ፥ ዮሴፋ ኤሮዋ ሀራ ካት ግብጸ ቢታይድ ካዉቶድ ሄሎዳይሲ። <verse eid="ACT 7:18"/><verse number="19" style="v" sid="ACT 7:19"/>የ ካታይ ኑ ዘር ገኒ ጽቃ ናእታይ Ꮊይቆዳይ ጋርክ ኡንታን ባለ ከሲ ኦሎዳይ ጋርክ ኑ አድታ ኡንእዛ።<verse eid="ACT 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 7:20"/>«የ ዎደ ሙሰ የልንቴዝ፤ ኤ ጾስ ቲና ኡሳ ሎኦ ናአ። ፋ አዳይ ካራ ሀይ አግና ሄሎዳይስ ድጬዛ።<note caller="-" style="x"><char style="xo" closed="false">7:20 </char><char style="xt" closed="false"><ref loc="EXO 1:10-11">ከስ 1:10-11</ref>፥ <ref loc="EXO 1:22">22</ref></char></note> <verse eid="ACT 7:20"/><verse number="21" style="v" sid="ACT 7:21"/>ሙሰ ዎራ ጋዴዝ ዎደ ግብጸ ካታይ ናእታ ደንጊ ኤኪ ፋ ናአ ኡዲ ኤዛ ድቼዛ።<note caller="-" style="x"><char style="xo" closed="false">7:21 </char><char style="xt" closed="false"><ref loc="EXO 2:2">ከስ 2:2</ref></char></note> <verse eid="ACT 7:21"/><verse number="22" style="v" sid="ACT 7:22"/>ሙሰ ግብጽታይ ኤጨት ኡባ ታማሪ ኦዳራኔ ኦሶር ምኖ አስ ማቄዛ።<note caller="-" style="x"><char style="xo" closed="false">7:22 </char><char style="xt" closed="false"><ref loc="EXO 2:3-10">ከስ 2:3-10</ref></char></note><verse eid="ACT 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 7:23"/>«ሙሰስ ላይይ ኦይታም ኩሜዝ ዎደ ፋ እሽታ፥ እስራኤልታ በአዳይስ ፋ ዎዝናይድ ቆፔዛ። <verse eid="ACT 7:23"/><verse number="24" style="v" sid="ACT 7:24"/>እስራኤልታይፕ ፐታያ ግብጸ አስ ፐታይ ቆሆዳር ብኢ የ እስሬለ አ ማዲ፥ የ ቆሄዝ ግብጸ አ ዎ ኩሸ ማሄዛ።<note caller="-" style="x"><char style="xo" closed="false">7:24 </char><char style="xt" closed="false"><ref loc="EXO 2:11-15">ከስ 2:11-15</ref></char></note> <verse eid="ACT 7:24"/><verse number="25" style="v" sid="ACT 7:25"/>ሙሰ ፋ እሽታ ፋ ባጋር ጾሲ አሾዳይስ ሀንዛና ኡንቲ አካኮዳ ግ ቆፔዛ፥ ዝን ኡንቲ አካኬካ።<verse eid="ACT 7:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 7:26"/>«ዎንት ጋላስ ናምኢ እስሬለ አስታይ ፐታይ ፐታይር Ꮊንቶዳር ደንጌዛ ኡንታን ዳቦዳይስ ከዚ፥ ‹አሱን፥ ይ እሽታ፤ አብስ ፐታይ ፐታ ቆህነ?› ዬጌዛ።<verse eid="ACT 7:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 7:27"/>«ዝን ፐታይ ፋ ላጋ ቆህዛይ ሙሰኮ፥ ‹ነና ኑል አፋ ሃርዛኔ ዳይና ኦዛይ ኦኖ? <verse eid="ACT 7:27"/><verse number="28" style="v" sid="ACT 7:28"/>ኔኒ ዝቅን ግብጸ አ ዎዛይ ጋርክ ታና ዎዳይስ ኮይኔ?› ዬጊ ሙሰና ኡርቂ ዳኬዛ። <verse eid="ACT 7:28"/><verse number="29" style="v" sid="ACT 7:29"/>ሙሰ የያ ስኢ ግብጸፕ በቲ ሚዳመ ቢታ በተ አስ ማቂ የዝታር ናምኢ ራ ናእታ የሌዛ።<note caller="-" style="x"><char style="xo" closed="false">7:29 </char><char style="xt" closed="false"><ref loc="EXO 18:3-4">ከስ 18:3-4</ref></char></note><verse eid="ACT 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 7:30"/>«ጎዳይ ኪታንቻይ ኦይታም ላይፕ ጉየ ሲና አምባ ካለ የዝ ሊዦ ቱሸ ጋንጨ ኤጽዝ ታማ ላጮ ጋንጨ ሙሰስ በንቴዛ።<note caller="-" style="x"><char style="xo" closed="false">7:30-34 </char><char style="xt" closed="false"><ref loc="EXO 3:1-10">ከስ 3:1-10</ref></char></note> <verse eid="ACT 7:30"/><verse number="31" style="v" sid="ACT 7:31"/>ሙሰ ፋ በኤዛይድ ማላባዝ ግ፥ ሎእ በአዳይስ ቱሻይኮ ሺቂ የዝን፥ ጎዳ፥ <verse eid="ACT 7:31"/><verse number="32" style="v" sid="ACT 7:32"/>‹ታኒ ነ አድታይ፥ አፍራመ ጾስ፥ እሳቃ ጾስ፥ ያይቆባ ጾስ› ዬግታር ሙሰኮ የኤዛ። ሙሰ ያሻር ኩኩሪ በአዳይስ ዳንዳኤካ።<verse eid="ACT 7:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 7:33"/>«ጎዳይ ሙሰኮ፥ ‹ኔኒ ኤቄዝ ቢታይ ጌሽ ማቄዝ ግሾስ ነ ቶካይድ የዝ ጫማ ከሶባ። <verse eid="ACT 7:33"/><verse number="34" style="v" sid="ACT 7:34"/>ታኒ ግብጸ የዝ ታ አሳይ ኡንእንታ በኤዛ። ኡ ኡፋ ስኢ ኡንታን አሾዳይስ ዎዛ። Ꮊት Ꮊና የኦባ! ታኒ ነና ግብጸ ኪቶዳ› ዬጌዛ።<verse eid="ACT 7:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 7:35"/>«እስሬልታይ ሙሰ፥ ‹ነና ኑና ሃርዛኔ ዳይና ኦዛይ ኦኖ?› ዬጊ እጼዛ። ዝን ሙሰ ቱሸ ጋንጨ ኤስ በንቴዝ ኪታንቻይ ባጋር ሃርዛኔ አሽዛ ኡዲ ጾሲ ኪቴዛ።<note caller="-" style="x"><char style="xo" closed="false">7:35 </char><char style="xt" closed="false"><ref loc="EXO 2:14">ከስ 2:14</ref></char></note> <verse eid="ACT 7:35"/><verse number="36" style="v" sid="ACT 7:36"/>የ ሙሰ እስራኤልታ ግብጸ ቢታይር ዞቆ አባኔ ሊዦ ቢታር ኦይታም ላይ ማላባዝታኔ ኦሮባዝታ ኦታር ኡንታን ካል ከሴዛ።<note caller="-" style="x"><char style="xo" closed="false">7:36 </char><char style="xt" closed="false"><ref loc="EXO 7:5">ከስ 7:5</ref>፤ <ref loc="EXO 14:21">14:21</ref>፤ <ref loc="NUM 14:33">ታይ. 14:33</ref></char></note><verse eid="ACT 7:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 7:37"/>«እስሬለ አሳይኮ፥ ‹ጾሲ ታና ደንዛይ ጋርክ ይ ሼሻይ ጋንጨፕ ታ ጋርክ ናበ ይንትስ ደንዳ› ዬጌዛይ Ꮊ ሙሰ።<note caller="-" style="x"><char style="xo" closed="false">7:37 </char><char style="xt" closed="false"><ref loc="DEU 18:15">ናምእ. 18:15</ref>፥ <ref loc="DEU 18:18">18</ref></char></note> <verse eid="ACT 7:37"/><verse number="38" style="v" sid="ACT 7:38"/>ሊዦ ቢታ ሺቄዝ እስሬለ አሳይራ የዜዛይ፥ ኑ አድታይራኔ ሲና አምባል አፋ ኤስ ኦዴዝ ኪታንቻይራ የዜዝ። የ ሙሰ ደኦ ቃላ ኑስ እንጎዳይስ ኤኬዛ።<note caller="-" style="x"><char style="xo" closed="false">7:38 </char><char style="xt" closed="false"><ref loc="EXO 19:1-20:17">ከስ 19:1—20:17</ref>፤ <ref loc="DEU 5:1-33">ናምእ. 5:1-33</ref></char></note><verse eid="ACT 7:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 7:39"/>«ዝን ኑ ማይዝታይ ሙሰስ አዛዝንቶዳይስ ኮየካያ፤ ኤዛ እጺ ጉየ ግብጸ ማቆዳይስ አሞቴዛ። <verse eid="ACT 7:39"/><verse number="40" style="v" sid="ACT 7:40"/>ማ አሮናኮ፥ ‹ኑና ካልዛ ጾስታ ኑስ ኦባ። አብስ ጊኮ፥ Ꮊይ ኑና ግብጸፕ ከኤዝ ሙሰ፥ ዋዬዛኮ ኑኒ ኤሮያ› ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">7:40 </char><char style="xt" closed="false"><ref loc="EXO 32:1">ከስ 32:1</ref></char></note> <verse eid="ACT 7:40"/><verse number="41" style="v" sid="ACT 7:41"/>የ ዎደ ኦጎና አዝዝ ኤቃ ኦዛ። የ ኤቃይስ ያርሾ ያርሼዝ ፋ ኩሸር ኦዝ ኦሳይር ኡፋይቴዛ።<note caller="-" style="x"><char style="xo" closed="false">7:41 </char><char style="xt" closed="false"><ref loc="EXO 32:2-6">ከስ 32:2-6</ref></char></note> <verse eid="ACT 7:41"/><verse number="42" style="v" sid="ACT 7:42"/>ዝን ጾሲ ኡንትስ ዞኮ ማሄዛ። ኡንቲ ሳሎ ጾልንትታ ጎይኖዳይ ጋርክ ኡንታን አሺ አሼዛ። ናብታይ ማጻፋይድ፥</para>
  <para style="q1" vid="ACT 7:42">«‹እስሬለ አስታዮ፥ ኦይታም ላይ ኩን</para>
  <para style="q2" vid="ACT 7:42">ሊዦ ቢታ ሹኬዝ መሄኔ</para>
  <para style="q2" vid="ACT 7:42">ያርሼዝ ያርሻ ታስ ያርሼነኔ?<note caller="-" style="x"><char style="xo" closed="false">7:42-43 </char><char style="xt" closed="false"><ref loc="AMO 5:25-27">አሞ. 5:25-27</ref></char></note><verse eid="ACT 7:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="ACT 7:43"/>ይ፥ ይንትስ ጎይኖዳይስ ኮቼዝ ኤቃነ ሞሎኬ ዱንካና</para>
  <para style="q2" vid="ACT 7:43">ረፋና ግዝ ይ ጾሳ ጾልንቶ ምስላ ቶኬዛ።</para>
  <para style="q1" vid="ACT 7:43">ታኒ ይንታን ባብሎነፕ</para>
  <para style="q2" vid="ACT 7:43">ሰኮ ባጋ ዳኮዳ› ግንትንቲ ጻፍንቴዛ።<verse eid="ACT 7:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 7:44"/>«ኑ አድታይስ ሊዦ ቢታ ማርካ ዱንካናይ የዛ። ኤዛካ ጾሲ ሙሰ አዛዜዛኔ ኤ ቤዜዛይ ጋርክ ኦዛ።<note caller="-" style="x"><char style="xo" closed="false">7:44 </char><char style="xt" closed="false"><ref loc="EXO 25:9">ከስ 25:9</ref>፥ <ref loc="EXO 25:40">40</ref></char></note> <verse eid="ACT 7:44"/><verse number="45" style="v" sid="ACT 7:45"/>ማ ኑ አድታይ የ ዱንካና ፋ አድታይፕ ኤኪ ጾስ ቲና ባይእዝ አይሁደ ማቀካ አሳይ ቢታ አይኬዝ ዎደ ኢያሱር ዎል ኤኪ ገሌዛ። የ ዱንካናይ ዳዉተ ዎደ ሄሎዳይስካ የ ጋዳይድ የዜዛ።<note caller="-" style="x"><char style="xo" closed="false">7:45 </char><char style="xt" closed="false"><ref loc="JOS 3:14-17">ኢያ. 3:14-17</ref></char></note> <verse eid="ACT 7:45"/><verse number="46" style="v" sid="ACT 7:46"/>ዳዉተ ጾሳር ሳብንቴዛ። ማ ያይቆባ ጾሳይስ ኬ ኬጾዳይስ ጾሳ ዎሴዛ።<note caller="-" style="x"><char style="xo" closed="false">7:46 </char><char style="xt" closed="false"><ref loc="2SA 7:1-16">2ሳም. 7:1-16</ref>፤ <ref loc="1CH 17:1-14">1ዜና. 17:1-14</ref></char></note> <verse eid="ACT 7:46"/><verse number="47" style="v" sid="ACT 7:47"/>ዝን ኤስ ኬ ኬጼዛይ ሶሎሞነ።<note caller="-" style="x"><char style="xo" closed="false">7:47 </char><char style="xt" closed="false"><ref loc="1KI 6:1-38">1ካት. 6:1-38</ref>፤ <ref loc="2CH 3:1-17">2ዜና. 3:1-17</ref></char></note><verse eid="ACT 7:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 7:48"/>«ሀኖ ዝን፥ ኡባይፕ አፋ ጾሳይ አሲ ኬጼዝ ኬ የዞያ። ናበ ጌዛይ ጋርክ፥<verse eid="ACT 7:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="ACT 7:49"/>«‹ሳሎ ታ ዙፋነ፥</para>
  <para style="q2" vid="ACT 7:49">ሳአይካ ታ ቶካይ የዝ አቆ።</para>
  <para style="q1" vid="ACT 7:49">የዝን፥ ታስ ይ አብ ጋርክ ኬ ኬጾደ?</para>
  <para style="q2" vid="ACT 7:49">ዎይ ታኒ ሸምፕዛ አቃይ አባ የኔ?<note caller="-" style="x"><char style="xo" closed="false">7:49 </char><char style="xt" closed="false"><ref loc="ISA 66:1-2">ኢሳ. 66:1-2</ref></char></note><verse eid="ACT 7:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="ACT 7:50"/>Ꮊ ኡባ ኦዛይ ታ ኩሸ ባሳ?›</para>
  <para style="m" vid="ACT 7:50">ዬግዛ ጎዳይ።<verse eid="ACT 7:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="ACT 7:51"/>«ይ ዋይዚ ስኦዋ አሶ? ይ ዎዝናይ ጾስ ቃላ ኤኮዳይስ አብስ እጼኔ? ይ ሀያይ አብስ ቱሌኔ? ይ፥ ይ አድታይካ ኡባ ዎደ ጌሻ አያናራ ኤቅንትዛ። <verse eid="ACT 7:51"/><verse number="52" style="v" sid="ACT 7:52"/>ናብታይ ጋንጨፕ ይ አድታይ ባይኤዛይ ኦኖ? ጽላይ የኦዳና ቲናቲ ኦዴዛና ዎዛ። Ꮊት ይ ኤዛ ኣ እንጊ ዎዛ።<note caller="-" style="x"><char style="xo" closed="false">7:52 </char><char style="xt" closed="false"><ref loc="ISA 63:10">ኢሳ. 63:10</ref></char></note> <verse eid="ACT 7:52"/><verse number="53" style="v" sid="ACT 7:53"/>ይ ኪታንቻ ኩሸፕ ጾስ ህጋ ኤኬዛ፥ ዝን ኪትንተካያ» ዬጌዛ።<verse eid="ACT 7:53"/></para>
  <para style="s1">ኢስጽፋኖሰ ሹቻር ጫድንቴዛ</para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54"/>ኡንቲ የያ ስኤዝ ዎደ ፋ ዎዝናይድ ኢስጽፋኖሰል አፋ ጋመ ይሎቲ፥ ፋ አች ቂ ማንዴዛ። <verse eid="ACT 7:54"/><verse number="55" style="v" sid="ACT 7:55"/>ዝን ኢስጽፋኖሰ ጌሻ አያናር ኩሚ፥ ሳሎ ኡዴ ብኢ፥ ጾስ ቦንቾኔ የሱሳ ጾስ ኡሻች ባጋር ኤቄዛና በኤዛ። <verse eid="ACT 7:55"/><verse number="56" style="v" sid="ACT 7:56"/>«ዬዛኮ፥ ታኒ ሳሎ ዶይንትን፥ አስ ናአይ፥ ጾሳ ኡሻቻ ኤቄዛ በኤዛ» ዬጌዛ።<verse eid="ACT 7:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="ACT 7:57"/>ቃላ ቅ ኡዲ ኡክታር፥ ፋ ሀያ ቱጪ ዎላ ኤኮ ዎጼዛ <verse eid="ACT 7:57"/><verse number="58" style="v" sid="ACT 7:58"/>ኤዛ ካታማይፕ ጋጻ ከሲ፥ ሹቻር ጫዴዛ። ማርካቲ ፋ ማአ ፐቲ ሳኦላ ግዝ ናአትይ ካለ ጋዴዛ።<verse eid="ACT 7:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="ACT 7:59"/>ኢስጽፋኖሰ፥ «ታ ጎዳ የሱሳ፥ ታ ሸምፓ ኤኮባ» ዬጊ ጼጎዳር ኡንቲ ኤዛ ሹቻር ጫዴዛ። <verse eid="ACT 7:59"/><verse number="60" style="v" sid="ACT 7:60"/>ቡንቅቲ፥ ፋ ቃላ ቅ ኡዲ፥ «ታ ጎዳዮ፥ Ꮊ ናጋራ ኡንትስ አቶ ጎባ» ዬጌዛ። የያ ጌዛፕ ማቂ Ꮊይቄዛ።<verse eid="ACT 7:60"/></para>
  <chapter eid="ACT 7"/>
  <chapter number="8" style="c" sid="ACT 8"/>
  <para style="s1">ሳኦላ አማንዛ አሳ ባይኤዛ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 8:1"/>ሳኦላ ኢስጽፋኖሰ Ꮊይቃይድ ማእንቴዛ። የ ጋላስ የሩሳላመ የዝ ዎሳ ኬ ግታ ባይእ ደንዴዛ። ሀዋርታይ አትን አማንዝታይ ኡባይ ይሁዳ ቢታኔ ሳማረ ቢታ ላልንቴዛ። <verse eid="ACT 8:1"/><verse number="2" style="v" sid="ACT 8:2"/>ፐቲ ፐቲ ጾስ አስታይ ኢስጽፋኖሰ ሞጌዛ፤ ማ ኤስ ኢታ ዬኬዛ። <verse eid="ACT 8:2"/><verse number="3" style="v" sid="ACT 8:3"/>ዝን ሳኦላ ዎሳ ኬ ብሶዳይስ ኮይዛ። ካራ ካራ ዩዪ ገሊ፥ አማንዛ ራታኔ ማችታ ጎቺ ጎቺ ከሲ አች ካራ ገልሴዛ።<note caller="-" style="x"><char style="xo" closed="false">8:3 </char><char style="xt" closed="false"><ref loc="ACT 22:4-5">ሀዋ. ኦ. 22:4-5</ref>፤ <ref loc="ACT 26:9-11">26:9-11</ref></char></note><verse eid="ACT 8:3"/></para>
  <para style="s1">ዎንግላይ ሳማረ ሳባክንቴዛ</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 8:4"/>ላልንቴዝ አማንዝታይ Ꮊንጌዝ አቆ ኡባይድ ቃላ ኦዴዛ። <verse eid="ACT 8:4"/><verse number="5" style="v" sid="ACT 8:5"/>ፍልጶሳ ሳማረ ካታማ Ꮊንጊ ክርስቶሳ ባጋ አሳይስ ኦዴዛ። <verse eid="ACT 8:5"/><verse number="6" style="v" sid="ACT 8:6"/>ጋመ አሳይ ፍልጶሳ ጌዛ ስኤዝ ዎደኔ ኤ ኦዛ ማላባዝታ በኤዝ ዎደ ኤዛ አካኪ ስኤዛ። <verse eid="ACT 8:6"/><verse number="7" style="v" sid="ACT 8:7"/>ቱና አያንታይ ኡኪ ጋመ አሳይፕ ከዜዝ፤ ማ ጋመ ጉንድታይኔ ዎብታይ ብልእንቴዛ። <verse eid="ACT 8:7"/><verse number="8" style="v" sid="ACT 8:8"/>የ ካታማይድ የዝ አሳይ ጋመ ኡፋይቴዛ።<verse eid="ACT 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 8:9"/>ዝን ስሞና ግዝ ፐቲ አይ የ ካታምተ የዛ። ኤ፥ «ታኒ ግታ ግታ አስ» ግ ሳማረ አሳ ካዮር Ꮊይ ማላባዝየግስታር ጋምኤዛ። <verse eid="ACT 8:9"/><verse number="10" style="v" sid="ACT 8:10"/>ጽቃፕ አይኪ ዳማ ሄሎዳይስ የዝ አስ ኡባይ፥ «ዳማ ጾሳ ዎልቃይ Ꮊያ» ግ ኤዛ ስኤዛ። <verse eid="ACT 8:10"/><verse number="11" style="v" sid="ACT 8:11"/>ጋመ ዎደፕ አይኪ ካዮር ሳማረ አሳ ማላባዝ ግሴዝ ግሾስ አሳይ ኤዛ ስኤዛ። <verse eid="ACT 8:11"/><verse number="12" style="v" sid="ACT 8:12"/>ዝን ፍልጶሳ ጾሳ ካተትኔ የሱስ ክርስቶሳ ሱንባጋ ራታይስነ ማችታይስ ኦድን፥ ኡንቲ ኤባዝ አማኒ ጻማቅንቴዛ። <verse eid="ACT 8:12"/><verse number="13" style="v" sid="ACT 8:13"/>ማ ስሞናካ አማኒ ጻማቅንቲ ፍልጶሳራ ዎላ Ꮊንጊ በኤዝ ባዝ ኡባይዳኔ ኦስንቴዝ ግታ ማላትታ ብኢ ማላባዝ ጌዛ።<verse eid="ACT 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 8:14"/>የሩሳላመ የዝ ሀዋርታይ ሳማረ አሳይ ጾስ ቃላ ኤኬዛ ስኢ ጵጽሮሳኔ ዋንሳ ኡንትኮ ዳኬዛ። <verse eid="ACT 8:14"/><verse number="15" style="v" sid="ACT 8:15"/>ጵጽሮሳኔ ዋንሳ Ꮊንጊ፥ አማንዝታይ ጌሻ አያና ኤኮዳይ ጋርክ ኡንትስ ጾሳ ዎሴዛ። <verse eid="ACT 8:15"/><verse number="16" style="v" sid="ACT 8:16"/>አብስ ጊኮ፥ ሳማረ አስታይ ጎዳ የሱሳ ሱንር ኣዳ ጻማቅንቴነፕ አትን ኡንታፕ ፐታይል አፋካ ጌሻ አያና ሀጋ ዎካ። <verse eid="ACT 8:16"/><verse number="17" style="v" sid="ACT 8:17"/>የ ዎደ ጵጽሮሳኔ ዋንሳ ፋ ኩሸ ኡንታል አፋ ጋድን፥ ኡንቲ ጌሻ አያና ኤኬዛ።<verse eid="ACT 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 8:18"/>ሀዋርታይ ፋ ኩሸ ኡንታል አፋ ጋድን፥ ኡንትስ ጌሻ አያናይ እንግንቴዛ ስሞና በኤዝ ዎደ ጵጽሮሳስኔ ዋንሳስ ሚሸ ክኢ፥ <verse eid="ACT 8:18"/><verse number="19" style="v" sid="ACT 8:19"/>«ታንካ ታ ኩሸ ጋዴዝ ኡባይ ጌሻ አያና ኤኮዳይ ጋርክ Ꮊ ማዉተ ታስካ እንጎይተ» ዬጌዛ።<verse eid="ACT 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 8:20"/>ዝን ጵጽሮሳ ኤኮ፥ «ኔኒ ጾስ እሞታ ሚሸር ዎንጎዳይስ ቆፔዛይ ግሾስ ነ ሚሽትር ነና ኤኪ ቦ። <verse eid="ACT 8:20"/><verse number="21" style="v" sid="ACT 8:21"/>ነ ዎዝናይ ጾስ ቲና ሉሎ ማቀካ ግሾስ ኔስ Ꮊይዳ ሻጎ ዎይ ቃዳ ባያ። <verse eid="ACT 8:21"/><verse number="22" style="v" sid="ACT 8:22"/>ይኬ፥ Ꮊ ነ ዎዝና ኢታትይ ግሾስ ናጋራይፕ ማቆባ። ነ ዎዛና የዝ ኢታ ቆፋ ጾሲ አቶ ጎዳይ ጋርክ ጎዳ ዎሶባ። <verse eid="ACT 8:22"/><verse number="23" style="v" sid="ACT 8:23"/>ነ ኢታ ጫሞ ቅናተራኔ ናጋራ አቻ የዛያ ታኒ ብእዛ» ዬጌዛ።<verse eid="ACT 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 8:24"/>ስሞና ማሂ፥ «ይ ጌዛይፕ ፐታካ ታና ሄላማይ ጋርክ ታስ ጎዳ ዎሶይታ» ዬጌዛ።<verse eid="ACT 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 8:25"/>ጵጽሮሳኔ ዋንሳ ማርካቴዛይፐኔ ጎዳ ቃላ ኦዴዛይፕ ጉየ የሩሳላመ ማቄዛ። ሳማረ የዝ ጋመ ሄራ ዎንግለ ኦዴዛ።<verse eid="ACT 8:25"/></para>
  <para style="s1">ፍልጶሳ ቶጰ ዣንዳርባና ጻማቄዝ</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26"/>ጎዳ ኪታንቻይ ፍልጶሳኮ፥ «ደንዲ ሱለ ባጋር የሩሳላመፕ ጋዛ ካንግዛ ሊዦ ቢታ ኦጋይኮ Ꮊንጎባ» ዬጌዛ። <verse eid="ACT 8:26"/><verse number="27" style="v" sid="ACT 8:27"/>ፍልጶሳ ደንዲ ቅቴዛ። ህንደኬ ግዝ ቶጰ ካታትስ እ ሚሻ ኡባ ናግዛ ቶጰ አስ የዛ። ኤካ ጎይኖዳይስ የሩሳላመ ቅቴዛ። <verse eid="ACT 8:27"/><verse number="28" style="v" sid="ACT 8:28"/>ጋረል በቲ፥ የሩሳላመፕ ፋ ቢታ ማቅታር ናበ ኢስያሳ ማጻፈ ናባብዛ።<verse eid="ACT 8:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 8:29"/>ጌሻ አያናይ ፍልጶሳኮ፥ «የ ጋራይኮ Ꮊንጊ ካለ ሺቆባ» ዬጌዛ።<verse eid="ACT 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 8:30"/>የዝን ፍልጶሳ ዎጺ Ꮊንጊ ሄሎዳር ዣንዳርባይ ናበ ኢስያሳ ማጻፈ ናባቦዳር ስኢ፥ «ነ ናባብዛይ ኔስ ገልኔ?» ዬጌዛ።<verse eid="ACT 8:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 8:31"/>ዣንዳርባይ፥ «ታና ታማርስዛ አስ ባዝን ዋይዚ ገሎደ?» ዬጌዛ። ጋረል ከዚ በቶዳይ ጋርክ ፍልጶሳ ዎሴዛ። <verse eid="ACT 8:31"/><verse number="32" style="v" sid="ACT 8:32"/>ዣንዳርባይ ናባብዛ ማጻፋይ ክፍላይ Ꮊያ፥</para>
  <para style="q1" vid="ACT 8:32">
    <note caller="-" style="x">
      <char style="xo" closed="false">8:32-33 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 53:7-8">ኢሳ. 53:7-8</ref>
      </char>
    </note>«ኤ ዱር ጋርክ ሹክንቶዳይስ ላግንቴዛ፤</para>
  <para style="q2" vid="ACT 8:32">ዱር ናአ ፋ እክሳ ሜድዝታይ ቲና ስእ ግዛይ ጋርክ፥</para>
  <para style="q2" vid="ACT 8:32">ኤካ ፋ ዶና ዶየካያ።<verse eid="ACT 8:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="ACT 8:33"/>ኤ ካዉዤዛ፤ ኤስ ጽሎ ፕርዳካ ቤዛ።</para>
  <para style="q2" vid="ACT 8:33">ኤ የሳይ Ꮊ ሳአይፕ ጋችንቴዝ ግሾስ</para>
  <para style="q2" vid="ACT 8:33">ኤ ሼሽባጋ ኦኖ ኦዶዳይ?» ዬግዛ።<verse eid="ACT 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 8:34"/>ዣንዳርባይ ማሂ ፍልጶሳኮ፥ «ናበ ኦባዝ ኦዴ? ፋ ባጋ ኦድነኔ ሀራ አስባዝ ኦዴ? ታስ ኦዶየ» ዬጌዛ። <verse eid="ACT 8:34"/><verse number="35" style="v" sid="ACT 8:35"/>ፍልጶሳ ማሂ፥ ጾስ ቃላ የ አቃይፕ አይኪ፥ የሱሳ ባጋ ኦድዛ ዎንግለ ኤስ ኦዴዛ።<verse eid="ACT 8:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 8:36"/>ኡንቲ Ꮊንግታር ሃ የዛ አቆ ሄሌዛ። ዣንዳርባይ፥ «ሃ Ꮊያ ቦኦባ፤ ታ ጻማቅንታማይ ጋርክ አቢ ካየ?» ዬጌዛ።<verse eid="ACT 8:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 8:37"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">8:37 </char>
      <char style="ft" closed="false">ፐቲ ፐቲ ብራና ማጻፍታይ ፓይዶ 37 የዝ ቆፓ ጉጅዛ ዝን ብኒ ማጻፍታይ ጉጆያ</char>
    </note>ፍልጶሳ ኤኮ፥ «ኔኒ ነ ኩን ዎዝናይፕ አማንኮ ዳንዳእዛ» ዬጌዛ።</para>
  <para style="p" vid="ACT 8:37">ኤ ማሂ፥ «የሱስ ክርስቶስ ጾሳ ናአ ማቄዛና ታኒ አማንዛ» ዬጌዛ።<verse eid="ACT 8:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 8:38"/>ጋራይ ኤቆድ ጋርክ ዣንዳርባይ ኪትን፥ ናምአይ ዎ ሃ ገሌዛ፤ ፍልጶሳ ኤዛ ጻማቄዛ። <verse eid="ACT 8:38"/><verse number="39" style="v" sid="ACT 8:39"/>ኡንቲ ሃፕ ጋጻ ከዜዛን ጋርክ ጎዳ አያናይ ፍልጶሳ ቆፐካዝን ኤኬዛ። ናምእን ዣንዳርባይ ፍልጶሳ በኤካያ፥ ዝን ፋ ኦጋ ኡፋይትታር ቅቴዛ። <verse eid="ACT 8:39"/><verse number="40" style="v" sid="ACT 8:40"/>ፍልጶሳ አዛጾና ኦሌዛ። ማ ቅሳረ የኦድ ሄሎዳይስ ካታምታይር ዩዪ ዎንግለ ማርካቴዛ።<verse eid="ACT 8:40"/></para>
  <chapter eid="ACT 8"/>
  <chapter number="9" style="c" sid="ACT 9"/>
  <para style="s1">ሳኦላ አማኔዛ</para>
  <para style="r">(<ref loc="ACT 22:6-16">ሀዋ. ኦ. 22:6-16</ref>፤ <ref loc="ACT 26:12-18">26:12-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1"/>የ ዎደ ሳኦላ ጎዳ ካልዝታ ዎዳይስ ማንድታር ቄሰ ሀላቅታይኮ Ꮊንጌዛ። <verse eid="ACT 9:1"/><verse number="2" style="v" sid="ACT 9:2"/>ጎዳይ ኦገ ካልዛ ራታኔ ማችታ ደንግኮ፥ አጪ የሩሳላመ ኮኦዳይስ፥ ዳማስቆ የዝ አይሁደ ዎሳ ኬታይስ ዳብዳበ ጻፍንቶዳይ ጋርክ ኤዛ ዎሴዛ።<verse eid="ACT 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 9:3"/>ኤ Ꮊንጊ፥ ዳማስቆ ካታማ ሄሎዳይስ ኡኮዳር፥ ቆፐካ ሳሎፕ ዎልቃማ ፖኦ ኤ ዩሻይር ፖኤዛ። <verse eid="ACT 9:3"/><verse number="4" style="v" sid="ACT 9:4"/>ኤ ሳአ ፖኬዛዝን፥ «ሳኦላ፥ ሳኦላ፥ አብስ ታና ባይኔ?» ግዝ ቃላ ስኤዛ።<verse eid="ACT 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 9:5"/>ሳኦላ፥ «ጎዳዮ፥ ነ ኦኖ?» ዬጊ ኦይጬዝ።</para>
  <para style="p" vid="ACT 9:5">«ታኒ፥ ነ ባይእዝ የሱሳ» ዬጌዛ።<verse eid="ACT 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 9:6"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">9:6 </char>
      <char style="ft" closed="false">ፐቲ ፐቲ ማጻፍታይ ኩኩርታራኔ ማላባዝ ጊታራ ዬግዛኖ ጉጅዛ</char>
    </note>ጎዳይ ኤኮ፥ «ደንዲ ካታማ ገሎባ፤ ነ ኦዳይስ ቤዝዛባዛይ ኤዛይድ ኔስ ኦድንቶዳ» ዬጌዛ።<verse eid="ACT 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 9:7"/>ሳኦላራ ኦገ Ꮊንግዝ አስታይ አኮካ ኦድንተካ ኤቂ አቴዛ። ጊር ስእንትዛ፥ ዝን ኦንካ በንቶያ። <verse eid="ACT 9:7"/><verse number="8" style="v" sid="ACT 9:8"/>ሳኦላ ፖኬዝ አቃይፕ ደንዲ በአዳር ኤ ኣፋይ ደንጋም እጼዛ። የይ ግሾስ፥ ኡንቲ ኤ ኩሻ አይኪ ካል ዳማስቆ ገልሴዛ። <verse eid="ACT 9:8"/><verse number="9" style="v" sid="ACT 9:9"/>ሀይ ጋላስ ሄሎዳይስ ኤ በአዳይስ ዳንዳኤካያ፤ አኮካ ሜካያ፤ ኡዠካያ።<verse eid="ACT 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 9:10"/>ዳማስቆ ፐቲ ሀናና ግዝ የሱሳ ታማራይ የዛ። ጎዳይ ቆንጭር፥ «ሀናና» ዬጊ ጼጌዛ።</para>
  <para style="p" vid="ACT 9:10">ሀናኔ ማሂ፥ «ታ ጎዳዮ፥ ታ Ꮊይዳ የዛ» ዬጌዛ።<verse eid="ACT 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 9:11"/>ጎዳይ ኤኮ፥ «ደንዲ ሉሎ ግንትንትዝ ኦገ Ꮊንጊ፥ ይሁዳ ካራ ሳኦላ ግዝ ጸርሰሰፕ የኤዝ ዎስ ዎስዝ አ ኮዮባ። <verse eid="ACT 9:11"/><verse number="12" style="v" sid="ACT 9:12"/>ማ ሀናና ግንትዝ አይ ገሊ፥ ሳኦላ ናምእን በአዳይ ጋርክ ፋ ኩሸ ኤዛል አፋ ጋዶዳር ቆንጭር በኤዛ» ዬጌዛ።<verse eid="ACT 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 9:13"/>ሀናና ማሂ፥ «ጎዳዮ፥ የሩሳላመ ነ ጌሽ አሳይል አፋ የ አይ አብ ጋርክ ኢታ ባዝ ኦዛኮ ታኒ ጋመ አሳይፕ ስኤዛ። <verse eid="ACT 9:13"/><verse number="14" style="v" sid="ACT 9:14"/>ማ ዳማስቆ ነ ሱን ጼግዝታ ኡባ አጮዳይስ፥ ቄሰ ሀላቅታይ ኤስ ማዉተ እንጌዛ» ዬጌዛ።<verse eid="ACT 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 9:15"/>ዝን ጎዳይ ኤኮ፥ «ሳኦላ አይሁደ ማቀካ አሳይ ቲና፥ ካትታይ ቲናኔ እስሬለ አሳይ ቲና፥ ታ ሱን ኤርሶዳይስኔ ታስ ኦዳይስ ማራጽንቴዝ ሚሻ ማቄዝ ግሾስ ነ ኤኮ Ꮊንጎባ። <verse eid="ACT 9:15"/><verse number="16" style="v" sid="ACT 9:16"/>አብስ ጊኮ፥ ታ ሱንይ ግሾስ ኤ ዋፋ ዋየ ኤኮዳይስ ቤዝዛኮ ታኒ ኤዛ ቤዞዳ» ዬጌዛ።<verse eid="ACT 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 9:17"/>ሀናኔ Ꮊንጊ፥ ካራ ገሊ፥ ፋ ኩሸ ሳኦላል አፋ ጋዲ፥ «ታ እሻ ሳኦላ፥ ነ የኤዝ ኦጋይል ኔስ በንቴዝ ጎዳ የሱሳ፥ ነ በአዳይ ጋርከኔ ጌሻ አያናር ኩሞዳይ ጋርክ ታና ኪቴዛ» ዬጌዛ። <verse eid="ACT 9:17"/><verse number="18" style="v" sid="ACT 9:18"/>ኤልሲ፥ ሳኦላ ኣፋይፕ ፐቲ ፑቆ ጋርከዝ ባዛይ ዎን፥ ሳኦላ ናምእን በኤዛ። ማ ደንዲ ጻማቅንቴዛ። <verse eid="ACT 9:18"/><verse number="19" style="v" sid="ACT 9:19"/>ካ ም ሚንጌዛ፥ ዳማስቆ የዝ አማንዝታይር ጽቃ ጋላስ ጋምኤዛ።<verse eid="ACT 9:19"/></para>
  <para style="s1">ሳኦላ ዳማስቆ ታማርሴዛ</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 9:20"/>ኤልሲ ሳኦላ፥ «የሱሳ ጾስ ናአ» ዬጊ ዳማስቆ የዝ አይሁደ ዎሳ ኬታይድ ቃላ ታማርሴዛ።<verse eid="ACT 9:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 9:21"/>የያ ስኤዝ ኡባይ ማላባዝ ግ፥ «Ꮊይ የሩሳላመ የሱሳ ሱን ጼግዝታ ብስዛ ባሳኔ? ማ Ꮊና የኤዛይ ኡንታን አጪ፥ ቄሰ ሀላቅታይ ቲና ካንጎዳይስ ባሳኔ?» ዬጌዛ።<verse eid="ACT 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 9:22"/>ዝን ሳኦላ ቃላ ኦዶር ምንግታር ምንግታር Ꮊንጌዛ። የሱሳ፥ ኤ ክርስቶሳ ማቄዛና ምልጽ ኡዲ ኦዴዝ ግሾስ ዳማስቆ የዝ አይሁድታይ ኤስ ማሆድባዝ ቤዛ።<verse eid="ACT 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 9:23"/>ጋመ ጋላሳፕ ጉየ አይሁድታይ ሺቂ፥ ሳኦላ ዎዳይስ ቶቤዛ።<note caller="-" style="x"><char style="xo" closed="false">9:23-25 </char><char style="xt" closed="false"><ref loc="2CO 11:32-33">2ቆሮ. 11:32-33</ref></char></note> <verse eid="ACT 9:23"/><verse number="24" style="v" sid="ACT 9:24"/>ዝን አይሁድታይ ፋና ዎዳይስ ቆፔዛ ሳኦላ ስኤዛ። ኡንቲ ኤዛ ዎዳይስ ቃማኔ ጋላስ ካታማ ፐንገ ናግዛ። <verse eid="ACT 9:24"/><verse number="25" style="v" sid="ACT 9:25"/>ዝን ኤ ታማርታይ ኤዛ ቃማ ካንጊ፥ ግምበ ጋሰ ሉኮር ዳቾራ ዎሴዛ።<verse eid="ACT 9:25"/></para>
  <para style="s1">ሳኦላ የሩሳላመ ታማርሴዛ</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26"/>ሳኦላ የሩሳላመ ሄሌዝ ዎደ አማንዝታይር ዋላክንቶዳይስ ኮዬዛ። ዝን ኤ ክርስቶሳ አማኔዛይ ኡንትስ ቱማ ኣዛም እጽን ኤስ ያሽቴዛ። <verse eid="ACT 9:26"/><verse number="27" style="v" sid="ACT 9:27"/>ዝን ባርናባሳ ሳኦላ ሀዋርታይኮ ካንጌዝ። ኦገል ጎዳይ ዋይዚ ቆንጬዛኮኔ ናሼዛኮ፥ ማ ሳኦላ ዳማስቆ የሱሳ ሱንይር ያሽተካ ዋይዚ ቃላ ኦዴዛኮ ኡንትስ ጌሺ ኦዴዛ። <verse eid="ACT 9:27"/><verse number="28" style="v" sid="ACT 9:28"/>ሳኦላ የሩሳላመ ዉቲ ጎዳይ ሱንይር ያሽተካ ቃላ ኦድታር፥ ሀዋርታይራ ዎላ የዛ። <verse eid="ACT 9:28"/><verse number="29" style="v" sid="ACT 9:29"/>ማ ሳኦላ ግርኬ ቃላ ኦዴዝ አይሁድታይራ ኦድንትታር ፓላምዛ። ዝን ኡንቲ ኤዛ ዎዳይስ ኮዬዛ። <verse eid="ACT 9:29"/><verse number="30" style="v" sid="ACT 9:30"/>አማንዛ አስታይ የያ ስኢ፥ ሳኦላ ቅሳረ ካንጊ ተርሰሰ ዳኬዛ።<verse eid="ACT 9:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 9:31"/>ይሁዳ፥ ጋልላራኔ ሳማረ ኡባይድ የዝ ዎሳ ኬታይ ሳሮር የዜዛ። ማ ሚንጌዛ፤ ጎዳይስ Ꮊሽትታር ጌሻ አያና ምንር ጋንጊ ጋንጊ Ꮊንጌዛ።<verse eid="ACT 9:31"/></para>
  <para style="s1">ጵጽሮሳ ሊዳራኔ ዮጰ ታማርሴዛ</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 9:32"/>ጵጽሮሳ ጋደ ኡባ ዩይታር ሊዳ የዝ አማንዛ አስታይኮ ሄሌዛ። <verse eid="ACT 9:32"/><verse number="33" style="v" sid="ACT 9:33"/>ኤዛይድ ሆስፑን ላይ ሙዳ ስሊ አርሳል ዎይኢ የዝ ኤንያ ግዝ አ ደንጌዛ። <verse eid="ACT 9:33"/><verse number="34" style="v" sid="ACT 9:34"/>ጵጽሮሳ፥ «ኤንያ፥ የሱስ ክርስቶሳ ነና ፓዛ፤ ደንዲ ነ ሂጻ ደንባ» ዬጌዛ። ኤካ ኤልሲ ደንዲ ኤቄዛ። <verse eid="ACT 9:34"/><verse number="35" style="v" sid="ACT 9:35"/>ሊዳራኔ ሳሮና የዝ አስ ኡባይ ኤንያ ብኢ፥ ጎዳይኮ ማቄዛ።<verse eid="ACT 9:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36"/>ዮጰ ካታማ ፐቲ ጻብቶ ግንትዝ አማንዛ አስታ የዛ። (ጻብቶ ጉሳይ ገንኤ ጉሲ) እዛ ፋ የዛ ዎደ ኡባይድ ሎኦ ባዝ ኦታራኔ ማንቅታ ማድታር የዜዛ። <verse eid="ACT 9:36"/><verse number="37" style="v" sid="ACT 9:37"/>የ ዎደ እዛ ሀርግንቲ Ꮊይቂን፥ አሳይ እ አሃ ሜጪ፥ ፖቄል አፋ ከሲ ዎይዛ። <verse eid="ACT 9:37"/><verse number="38" style="v" sid="ACT 9:38"/>ሊዳ ዮጰስ ካለ የዛ። አማንዝታይ ጵጽሮሳ ሊዳ የዛ ስኢ፥ «ሀያና ኑኮ ኤልሲ የኦባ» ዬግዝ ኪታ ናምኢ አስታ ኤኮ ኪቴዛ።<verse eid="ACT 9:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 9:39"/>የይ ግሾስ፥ ጵጽሮሳ ደንዲ፥ ኡንታራ Ꮊንጌዛ። ሄሊ፥ ፖቄል አፋ የዝ ክፍለ ኤዛ ገልሴዛ። አምእታይ ጵጽሮሳ ካላይር ኤቂ ዬክታር ዶርቃ ኡንታራ ፓጻ የዛር ኦዝ ቃምስታኔ አፍልታ ኡባ ጵጽሮሳ ቤዜዛ። <verse eid="ACT 9:39"/><verse number="40" style="v" sid="ACT 9:40"/>ጵጽሮሳ ኡንታን ኡባ ባለ ከሲ፥ ጉልባቲ ጾሳ ዎሴዛ። ማ አሃይኮ ማቂ፥ «ጻብተ፥ ደንዶባ» ዬጌዛ። ጻብታ ፋ አፋ ዶዪ ጵጽሮሳ ብኢ፥ ደንዲ በቴዛ። <verse eid="ACT 9:40"/><verse number="41" style="v" sid="ACT 9:41"/>ጵጽሮሳ እዞ ፋ ኩሸር ማዲ ደን ኤሴዛ። የይፕ ጉየ፥ አማንዝታኔ አምእታ ጼጊ፥ ደንዴዛኖ ኡ ቲና ከኤዛ።<verse eid="ACT 9:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 9:42"/>Ꮊ ኦዳይ ዮጰ ካታማ ኡባ ሄሌዛ። ጋመ አሳይ ጎዳ አማኔዛ። <verse eid="ACT 9:42"/><verse number="43" style="v" sid="ACT 9:43"/>ጵጽሮሳ ዮጰ ስሞና ግዝ ደገላይ ካራ ኡንደና ጋላስ ጋምኤዛ።<verse eid="ACT 9:43"/></para>
  <chapter eid="ACT 9"/>
  <chapter number="10" style="c" sid="ACT 10"/>
  <para style="s1">ጵጽሮሳኔ ቆርነሎሳራ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1"/>ቅሳረ፥ «ጻለ ኦላ አስታይ ጩጋ» ግንትንትዝ ኦላ አስታይ ጋንጨ ፐቲ ቆርነሎሳ ግንትንትዝ ማቶ ሀላቃይ የዛ። <verse eid="ACT 10:1"/><verse number="2" style="v" sid="ACT 10:2"/>ቆርነሎሳ ፋ ካራ አሳይራ ጾሳ ሚን አማንዛ አስኔ ጾሳ ጎይንዛ አስ። አይሁደ ማንቅታካ ጋመ ማድዛ፥ ማ ጾሳ ኡባ ዎደ ዎስዛ። <verse eid="ACT 10:2"/><verse number="3" style="v" sid="ACT 10:3"/>ፐቲ ጋላስ ኡዱፉን ሳተ ሄራ ጾስ ኪታንቻይ ኤኮ ይኢ፥ «ቆርነሎሳ» ግ ጼጎዳር ኤ ቆንጭር ጌሺ በኤዛ።<verse eid="ACT 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 10:4"/>ቆርነሎሳ ዳጋሚ ኪታንቻ ቶል ኡዲ ብኢ፥ «ጎዳዮ፥ አባ?» ዬጌዛ።</para>
  <para style="p" vid="ACT 10:4">ኪታንቻይ ማሂ፥ «ነ ዎሳኔ ማንቅታ ነ ማድዛይ ጾስ ቲና ቆፍንቴዛ። <verse eid="ACT 10:4"/><verse number="5" style="v" sid="ACT 10:5"/>Ꮊት ዮጰ አስ ኪቲ፥ ጵጽሮሳ ግዝ ስሞና ክእሶባ። <verse eid="ACT 10:5"/><verse number="6" style="v" sid="ACT 10:6"/>ጵጽሮሳ አባ ካለር ደገላ ስሞና ካራ እማት በቴዛ» ዬጌዛ።<verse eid="ACT 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 10:7"/>ቆርነሎሳ ፓስ ኦዴዝ ኪታንቻይ Ꮊንግን፥ ፋ አይልታይፕ ናምእታኔ ጾስ ጎይንዛ ፋ ካለ ዎታዳርታይፕ ፐታ ጼጊ፥ <verse eid="ACT 10:7"/><verse number="8" style="v" sid="ACT 10:8"/>ኡንትስ ኡባ ባዝ ኦዲ ዮጰ ኪቴዛ።<verse eid="ACT 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9"/>ዎንት ጋላስ ኡንቲ Ꮊንጊ፥ ዮጰ ካታማ ኡኮዳር ኡሱፑን ሳተ ሄራ ጾስ ዎሶዳይስ ጵጽሮሳ ፖቄል አፋ ከዜዝ። <verse eid="ACT 10:9"/><verse number="10" style="v" sid="ACT 10:10"/>ኤ ናይንቲ ካ ማዳይስ ኮዬዝ፥ ዝን ካ ካጾዳር ኤ አሁሞ በኤዛ። <verse eid="ACT 10:10"/><verse number="11" style="v" sid="ACT 10:11"/>ሳሎ ዶይንትን፥ ዳማ አፍላ ኣዝዛባዝ ኦይዲ ባጋር አይክንቲ ዎዳር ኤ በኤዛ። <verse eid="ACT 10:11"/><verse number="12" style="v" sid="ACT 10:12"/>ኤዛይድ ኦይዲ ቶከር የዝ መህታይ፥ ዎራ ዶእታ፥ ኡሎራ ጎችንትዛ መትይኔ ሳሎ ካፍታ ኡባይ የዛ። <verse eid="ACT 10:12"/><verse number="13" style="v" sid="ACT 10:13"/>የ ዎደ «ጵጽሮሳ፥ ደንዲ ኤቂ ሹኪ ሞባ» ግዝ ቃላ ኤኮ የኤዝ።<verse eid="ACT 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 10:14"/>ዝን ጵጽሮሳ፥ «ጎዳዮ፥ ዋኣ! ታ ቱና ባዝ ኡባራካ ም ኤሮያ» ዬጌዛ።<verse eid="ACT 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 10:15"/>ማ፥ «ጾሳይ ጌሼዛ ኔኒ ቱና ጊፐ» ግዝ ቃላ ናምእን ኤኮ የኤዝ። <verse eid="ACT 10:15"/><verse number="16" style="v" sid="ACT 10:16"/>የይካ፥ ሀይ ቶኬ ሀኔዛይፕ ጉየ የ ግታ አፍላ ኣዝዛይ ኤልሲ ኡዴ ሳሎ ኤክንቴዛ።<verse eid="ACT 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 10:17"/>ጵጽሮሳ ፋ በኤዝ ቆንጭይስ ብልእይ፥ «አብ ማቃደሻ?» ግ ፋ ዎዝናር ቆፖዳር፥ ቆርነሎሳ ኪቴዝ አስታይ ስሞና ካራ ኦይጭች ደንጊ ባለር ኤቄዛ። <verse eid="ACT 10:17"/><verse number="18" style="v" sid="ACT 10:18"/>ፋ ቃላ ኡ ቅ ኡዲ፥ «ጵጽሮሳ ግንትዝ ስሞና እማይ Ꮊይዳ የኔ?» ዬጊ ኦይጬዛ።<verse eid="ACT 10:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 10:19"/>ጵጽሮሳ ቆንጭር በኤዝ ባዛ ቆፕል አፋ የዝን፥ ጌሻ አያና ኤኮ፥ «ዬዛኮ፥ ሀይ አስታይ ነና ኮይዛ። <verse eid="ACT 10:19"/><verse number="20" style="v" sid="ACT 10:20"/>ደንዲ ዎባ፥ ታኒ ኡንታን ኪቴዝ ግሾስ ሰኤካ ኡንታር Ꮊንጎባ» ዬጌዛ።<verse eid="ACT 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 10:21"/>ጵጽሮሳ አስታይኮ ዎ፥ «ይ ኮይዛይ ታናኔ፤ ይ አብስ የኤኔ?» ዬጌዛ።<verse eid="ACT 10:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 10:22"/>ኡንቲ ማሂ፥ «ኑና ማቶ ሀላቃይ ቆርነሎሳ ኪቴዛ። ኤ ጌሻ፥ ጾሳ ጎይንዛ አስኔ አይሁደ አስ ኡባይድ ጋመ ቦንችንቴዝ አስ። ቆርነሎሳ፥ ነና ፋ ካራ ካንጊ ቃላ ኔፕ ስኦዳይ ጋርክ ጌሻ ኪታንቻይ ኤስ ኦዴዛ» ዬጌዛ። <verse eid="ACT 10:22"/><verse number="23" style="v" sid="ACT 10:23"/>ጵጽሮሳ አስታ ካራ ገልሲ ሞኬዛ።</para>
  <para style="p" vid="ACT 10:23">ዎንት ጋላስ፥ ደንዲ ኡንታራ ቅቴዛ። ዮጰ ካታማ የዝ አማንዝታይፕ ፐታይ ፐታይ ኤዛር ዎላ Ꮊንጌዛ። <verse eid="ACT 10:23"/><verse number="24" style="v" sid="ACT 10:24"/>ዎንት ጋላስ፥ ቅሳረ ሄሌዛ። ቆርነሎሳ ፋ እግንታኔ ፋ ላግታ ፐትፕ ጼጊ ሺሺ፥ ጵጽሮሳ ናግዛ። <verse eid="ACT 10:24"/><verse number="25" style="v" sid="ACT 10:25"/>ጵጽሮሳ ካራ ገሎድ ሀኖዳር፥ ቆርነሎሳ ኤዛ ሄሊ ኤ ቲና ጹጉኒ ኤስ ጎይኖዳይስ ኮዬዛ። <verse eid="ACT 10:25"/><verse number="26" style="v" sid="ACT 10:26"/>ዝን ጵጽሮሳ፥ «ደንዶባ፥ ታካ ታ ኦማስ ነ ጋርክ አስ» ዬጊ ኤዛ ደንዛ።<verse eid="ACT 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 10:27"/>ጵጽሮሳ ቆርነሎሳር ኦድንትታር ካራ ገሎዳር ጋማይ አሳይ ሺቄዛ ደንጌዛ። <verse eid="ACT 10:27"/><verse number="28" style="v" sid="ACT 10:28"/>ኤ አሳይኮ፥ «አይሁደ አስ ሀራ ጋደር ፐትፖዳይስ ዎይ ዎል ሄሎዳይስ ዎጋ ባዛ ይ ኤርዛ። ዝን ታኒ ኦናካ ቱና ዎይ ጌሽ ባያ ጋማይ ጋርክ ጾስ ታና ቤዜዛ። <verse eid="ACT 10:28"/><verse number="29" style="v" sid="ACT 10:29"/>የይ ግሾስ፥ ይ ታኮ ኪትን እጾ ባይ የኤዛ። Ꮊት ታና አብስ ጼግሴዛኮ ታስ ኦዶይታ» ዬጌዛ።<verse eid="ACT 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 10:30"/>ቆርነሎሳ፥ «ታኒ Ꮊይኖ ኦይዲ ጋላሳፕ ቲና Ꮊኖንተ ኡዱፉን ሳተ ዎሳ ዎሶዳር፥ ፎጭዝ ማኦ ማኤዝ አስ ታ ቲና ኤቄዛ። <verse eid="ACT 10:30"/><verse number="31" style="v" sid="ACT 10:31"/>ኤ ታኮ፥ ‹ቆርነሎሳ፥ ጾሲ ነ ዎሳ ስኤዛ፥ ኔኒ ማንቅታ ማዴዛናካ ቆፔዛ። <verse eid="ACT 10:31"/><verse number="32" style="v" sid="ACT 10:32"/>ይኬ፥ አስ ዮጰ ኪቲ፥ ስሞን ጵጽሮሳ ግዛ ጼግሶባ። ኤ፥ ስሞና ግዝ ደገላ አይ ካራ አባ ዶናር በቴዛ› ዬጌዛ። <verse eid="ACT 10:32"/><verse number="33" style="v" sid="ACT 10:33"/>የይ ግሾስ፥ ታኒ ኔኮ ኤልሲ ኪቴዛ፤ ነ ይእይር ሎኦ ኦዛ። ይኬ፥ ጾሲ ነና ኪቴዝባዝ ኡባ ስኦዳይስ Ꮊት ኑኒ ኡባይ Ꮊይዳ ጎዳይ ቲና የዛ» ዬጌዛ።<verse eid="ACT 10:33"/></para>
  <para style="s1">ጵጽሮሳ ናሻ</para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 10:34"/>ካልካ፥ ጵጽሮሳ፥ «ጾሲ አስ ኣፈ ብኢ አሳፕ አሰ ሻኮያ።<note caller="-" style="x"><char style="xo" closed="false">10:34 </char><char style="xt" closed="false"><ref loc="DEU 10:17">ናምእ. 10:17</ref></char></note> <verse eid="ACT 10:34"/><verse number="35" style="v" sid="ACT 10:35"/>ዝን ዱማ ዱማ ቢታ አስ ኡባ ኦና ማቅኮካ ፓስ ያሽትዛኔ ጽሎ ኦሶ ኦዛይድ ጾሲ ኡፋይትዛ ታኒ ቱማ አካኬዛ። <verse eid="ACT 10:35"/><verse number="36" style="v" sid="ACT 10:36"/>ጾሳይ፥ ኡባ ጎዳ ማቄዝ የሱስ ክርስቶሳ ባጋር ሳሮት ኦድታር Ꮊ ዎንግላ እስሬለ አሳይስ ኪቴዛ ይ ኤርዛ። <verse eid="ACT 10:36"/><verse number="37" style="v" sid="ACT 10:37"/>ዋንሳ ጽንቃተባጋ ሳባኬዛይፕ አይኪ ጋልላፕ አይኪ ይሁዳ ቢታ ኡባ ሄሎዳይስ ሀኔዝባዛ ይ ኤርዛ። <verse eid="ACT 10:37"/><verse number="38" style="v" sid="ACT 10:38"/>ጾሲ ናዝረተ የሱሳና ጌሻ አያናር ትዤዛኔ ዎልቃ እንጌዛ። ጾሲ ኤዛር የዝ ግሾስ ሎኦ ባዝ ኦታር ሀርግንቴዝታ ፓታራኔ ጻላሄ ኩሸ ሃርንቴዝ ኡባ ከስታር ዩዬዛ።<verse eid="ACT 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 10:39"/>«አይሁደ ቢታኔ የሩሳላመ ኤ ኦዝ ኡባ ባዛይስ ኑኒ ማርክታ። ኡንቲ ማዝቃለል አፋ ሶቲ ኤዛ ዎዛ። <verse eid="ACT 10:39"/><verse number="40" style="v" sid="ACT 10:40"/>ዝን ጾሲ ሃይን ጋላስ Ꮊይቆፕ ኤዛ ደን አሳይስ በንቶዳይ ጋርክ ኡዴዛ። <verse eid="ACT 10:40"/><verse number="41" style="v" sid="ACT 10:41"/>የ በንትይ ጾስ ቲና ማራጼዝ ኤስ ማርካ ማቄዝ ኑስ ማርካትዛፕ አትን አስ ኡባይስ ባያ። ኤ Ꮊይቆፕ ደንዴዛይፕ ጉየ ኑር ሜዛኔ ኡዤዛ። <verse eid="ACT 10:41"/><verse number="42" style="v" sid="ACT 10:42"/>ኑኒ ዎንግለ አሳይስ ኦዶዳይ ጋርከኔ ፓጻ የዝታይል አፋኔ Ꮊይቄዝታይል አፋ ፕርዶዳይስ ጾሲ ሹሜዛይ የሱሳ ማቄዛና ማርካቶዳይ ጋርክ ኑና ኪቴዛ። <verse eid="ACT 10:42"/><verse number="43" style="v" sid="ACT 10:43"/>ጾስ አማንዛ ኡባይ ናጋራይ፥ ኤ ሱንይር አቶ ግንትንትዛ ናብታይ ማርካትዛ» ዬጌዛ።<verse eid="ACT 10:43"/></para>
  <para style="s1">አይሁደ ማቀካ አስታይ አማኒ ጌሻ አያና ኤኬዛ</para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44"/>ጵጽሮሳ ሀጋ ኦዳ ሃሰካዝን ቃላ ስኦዳር ኡባይል አፋ ጌሻ አያና ጎጌዛ። <verse eid="ACT 10:44"/><verse number="45" style="v" sid="ACT 10:45"/>ጵጽሮሳር ዮጰፕ የኤዝ አማንዛ ዶካልንቴዝ አይሁደ ኡባይ፥ አይሁደ ባዝታይላካ ጌሻ ሻያና ጎጌዝ ግሾስ ማላባዝ ጌዛ። <verse eid="ACT 10:45"/><verse number="46" style="v" sid="ACT 10:46"/>የያ ጎዳይስ ዳንዳኤዛ፥ ኡንቲ ዱማ ዱማ ዶናር ናሽታራኔ ጾሳ ጋላቶዳር ስኤዝ ግሾስ።</para>
  <para style="p" vid="ACT 10:46">የ ዎደ ጵጽሮሳ ማሂ፥ <verse eid="ACT 10:46"/><verse number="47" style="v" sid="ACT 10:47"/>«የይትታይ ማ ኑ ጋርክ ጌሻ አያና ኤኬዝታይ ሃር ጻማቅንታማይ ጋርክ ካዮዳይስ ዳንዳእዛይ ኦኖ?» ዬጌዛ። <verse eid="ACT 10:47"/><verse number="48" style="v" sid="ACT 10:48"/>ኡንቲ የሱስ ክርስቶሳ ሱንይር ጻማቅንቶዳይ ጋርክ ኡንታን አዛዜዛ። የይፕ ጉየ፥ ኡንቲ ፓር ጽቃ ጋላስ በቶዳይ ጋርክ ጵጽሮሳና ዎሴዛ።<verse eid="ACT 10:48"/></para>
  <chapter eid="ACT 10"/>
  <chapter number="11" style="c" sid="ACT 11"/>
  <para style="s1">ጵጽሮሳ ፋ ኦዝባዛ የሩሳላመ ዎሳ ኬስ ኦዴዛ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1"/>ሀዋርታይኔ ይሁዳ የዝ አማንዝታይ፥ አይሁደ ባዝታይካ ጾሳ ቃላ ኤኬዛ ስኤዛ። <verse eid="ACT 11:1"/><verse number="2" style="v" sid="ACT 11:2"/>ጵጽሮሳ የሩሳላመ Ꮊንጌዝ ዎደ ዶካልንቴዝ አማንዝታይ፥ <verse eid="ACT 11:2"/><verse number="3" style="v" sid="ACT 11:3"/>ኤኮ፥ «ኔኒ ዶካልንተካዝትይኮ ገሊ ኡንታራ ካ አብስ ሜኔ?» ዬጊ ፋላሜዛ።<verse eid="ACT 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 11:4"/>ዝን ጵጽሮሳ ሀኔዝባዝ ቲናፕ አይኪ ማራር ኦዴዛ፦ <verse eid="ACT 11:4"/><verse number="5" style="v" sid="ACT 11:5"/>«ታኒ ዮጰ ካታማ ጾስ ዎስታር አጁታ በኤዛ። ዳማ አፍላ ኣዝዛባዝ ኦይዲ ባጋር አይክንቲ ሳሎፕ ዎታር ታኮ የኤዝ። <verse eid="ACT 11:5"/><verse number="6" style="v" sid="ACT 11:6"/>ታኒ ዳኪ በአዳር ኦይዲ ቶከር የዝ መህታ፥ ዎራ ዶእታ፥ ኡሎራ ጎችንትዛ መትታኔ ሳሎ ካፍታ በኤዛ። <verse eid="ACT 11:6"/><verse number="7" style="v" sid="ACT 11:7"/>‹ጵጽሮሳ፥ ደንዶባ፥ ሹኪ ሞባ› ግዝ ቃላ ስኤዛ።<verse eid="ACT 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 11:8"/>«ዝን ታኒ፥ ‹ጎዳዮ፥ ዋኣ፥ ቱና ባዝ ዎይ ጌዠካባዝ ኡባራካ ታ ዶናኮ ሄሊ ኤሮያ› ዬጌዛ።<verse eid="ACT 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 11:9"/>«‹ጾሳይ ጌሼዛ ኔኒ ቱና ጊፐ› ዬግዝ ቃላ ናምእን ሳሎፕ የኤዝ።<verse eid="ACT 11:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 11:10"/>«የይ ሀይ ቶኬ ሀኔዛ፥ ማሂ ኡባይ ሳሎ ፉድ ኤክንቴዛ። <verse eid="ACT 11:10"/><verse number="11" style="v" sid="ACT 11:11"/>የ ሳታተካ ሀይ አስታይ ቅሳረፕ ታኮ ኪትንቲ ታኒ የዝ ካራ ሄሌዛ። <verse eid="ACT 11:11"/><verse number="12" style="v" sid="ACT 11:12"/>ስካዛር ኡንታራ Ꮊማዳይ ጋርክ አያና ታስ ኦዴዛ። ማ Ꮊ ኡሱፑን እሽታይ ዮጰፕ ታራ ቅሳረ Ꮊንጌዝታይር ቆርነሎሳ ካራ ገሌዛ። <verse eid="ACT 11:12"/><verse number="13" style="v" sid="ACT 11:13"/>ኪታንቻይ ኤ ካራ ጋንጨ ኤቂ፥ ‹ዮጰ ኪቲ ጵጽሮሳ ግንትንትዝ ስሞና ጼግሶባ። <verse eid="ACT 11:13"/><verse number="14" style="v" sid="ACT 11:14"/>ነናኔ ነ ካራ አስ ኡባ አሽዛ ቃላ ኤ ኔስ ኦዶዳ› ጌዛና ቆርነሎሳ ኑስ ኦዴዛ።<verse eid="ACT 11:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 11:15"/>«ታኒ ናሻ አይኮዳር ጌሻ አያና ቲን ኑል አፋ ዎዛይ ጋርክ ኡንታል አፋካ ዎዛ። <verse eid="ACT 11:15"/><verse number="16" style="v" sid="ACT 11:16"/>የ ዎደ ‹ዋንሳ ሃር ጻማቄዝ፥ ዝን ይ ጌሻ አያናር ጻማቅንቶዳ› ዬጌዝ ጎዳ ቃላይ ታስ ቆፕንቴዛ። <verse eid="ACT 11:16"/><verse number="17" style="v" sid="ACT 11:17"/>ጾሳይ ኑስ ጎዳ የሱስ ክርስቶሳ አማኔዝታይስ እንጌዝ እሞታ እዞ አይሁደ ባዝታይስካ እንግኮ፥ የዝን ጾሳ ካዮዳይስ ታኒ ኦኖ?» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">11:17 </char><char style="xt" closed="false"><ref loc="ACT 1:5">ሀዋ. ኦ. 1:5</ref></char></note><verse eid="ACT 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 11:18"/>ኡንቲ የያ ስኤዝ ዎደ ፋ ፓላማ አሺ፥ «የያ ማቅኮ፥ ጾሳይ አይሁደ ባዝታይካ ናጋራፕ ማቂ ደኦ የዞዳይ ጋርክ ማሮተ እንጌዛ» ዬጊ ጾስ ጋላቴዛ።<verse eid="ACT 11:18"/></para>
  <para style="s1">አንጾካ ዎሳ ኬ</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19"/>እስጸፋኖሳና Ꮊይቆስ ሄልዝ ባይእይፕ ደንዴዛይድ ላልንቴዝ አማንዝታይ ቃላ አይሁድታይ ኣዳስ ኦድታር ፕንቀ፥ ቆጲሮሳኔ አንጾካ ሄሎዳይስ ዩዬዛ።<note caller="-" style="x"><char style="xo" closed="false">11:19 </char><char style="xt" closed="false"><ref loc="ACT 8:1-4">ሀዋ. ኦ. 8:1-4</ref></char></note> <verse eid="ACT 11:19"/><verse number="20" style="v" sid="ACT 11:20"/>ዝን ቆጲሮሳፐኔ ቀረናፕ የኤዝ ፐቲ ፐቲ አማንዛ አስታይ አንጾካ Ꮊንጊ፥ ጎዳ የሱሳ ዎንግለ ግርኬ አሳይስካ ኦዴዛ። <verse eid="ACT 11:20"/><verse number="21" style="v" sid="ACT 11:21"/>ጎዳ ዎልቃይ ኡንታራ የዛ፤ ማ ጋመ አሳይ አማኒ ጎዳይኮ ማቄዛ።<verse eid="ACT 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 11:22"/>የ ኦዳ የሩሳላመ የዝ ዎሳ ኬይ ስኤዝ ግሾስ ባርናባሳና አንጾካ ኪቴዛ። <verse eid="ACT 11:22"/><verse number="23" style="v" sid="ACT 11:23"/>ባርናባሳ አንጾካ Ꮊንጌዝ ዎደ ጾሲ ፋ ኣ ኬሄትይፕ ፋ ዎያይስ ዋይዚ እንጌዛኮ ብኢ ኡፋይቴዛ። ኡንቲ ኡባይ ፋ ኩን ዎዝናር ጎዳይል ሚንጊ የዞዳይ ጋርክ ኡንታን ዞሬዛይ፦ <verse eid="ACT 11:23"/><verse number="24" style="v" sid="ACT 11:24"/>ባርናባሳ ጌሻ አያናራኔ አማኖር ኩሜዝ ኬሃ አስ ማቄዝ ግሾሲ። ጋመ አሳይካ ጎዳ አማኔዛ።<verse eid="ACT 11:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 11:25"/>የይፕ ጉየ፥ ባርናባሳ ሳኦላ ኮዮዳይስ ጸርሴሰ ቅቴዛ። <verse eid="ACT 11:25"/><verse number="26" style="v" sid="ACT 11:26"/>ኤዛይድ ሳኦላ ደንጊ አንጾካ ኤኪ የኤዛ። ባርናባሳኔ ሳኦላ ዎሳ ኬ አሳይራ ላይ ሙዳ በቲ ጋመ አሳ ታማርሴዛ። አማንዝታይ አንጾካ «ክርስታነ» ግንትንቲ ቲና ጼግንቴዛ።<verse eid="ACT 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 11:27"/>የ ዎደ ፐቲ ፐቲ ናብታይ የሩሳላመፕ አንጾካ ዎዛ። <verse eid="ACT 11:27"/><verse number="28" style="v" sid="ACT 11:28"/>ኡ ጋንጨፕ አጋቦሳ ግዛይ ደንዲ ጋደ ኡባይል ኢታ ናየ ደንዶዳና አያና ዎልቃር ትንቢተ ኦዴዛ። የይ ሀኔዛይ ኦሮመ ካታይ ቃላዉዶሳ ዎዳይዳ።<note caller="-" style="x"><char style="xo" closed="false">11:28 </char><char style="xt" closed="false"><ref loc="ACT 21:10">ሀዋ. ኦ. 21:10</ref></char></note> <verse eid="ACT 11:28"/><verse number="29" style="v" sid="ACT 11:29"/>አማንዝታይ ኦማር ኦማር ፋ ዎልቃ ጋርክ ሚሸ ከሲ ይሁዳ የዝ አማንዝታይስ ማዴ ዳኮዳይስ ቆፋ አጬዛ። <verse eid="ACT 11:29"/><verse number="30" style="v" sid="ACT 11:30"/>ኡንቲ የይ ጋርክ ኡዲ፥ ሚሻ ባርናባሳላኔ ሳኦላል ዎሳ ኬ ጭምታይስ ዳኬዛ።<verse eid="ACT 11:30"/></para>
  <chapter eid="ACT 11"/>
  <chapter number="12" style="c" sid="ACT 12"/>
  <para style="s1">ዎሳ ኬል አፋ ደንዴዝ ዎልቃማ ባይእ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1"/>የ ዎደ ካታይ ሄሮዶሳ<note caller="+" style="f"><char style="fr" closed="false">12:1 </char><char style="fqa" closed="false">ካታይ ሄሮዶሳ፦ </char><char style="ft" closed="false">Ꮊይ ካታይ ሄሮዶሳ፥ ዳማ ሄሮዶሳ ኣግርጳ ግዛይ ኤ፥ 37-44 ማሮት ላይ ሄሎዳይስ ሃሬዛ። ኤ ካት ሄሮዶሳስ ናአ ናአ</char></note> ዎሳ ኬ አሳይፕ ባጋ ባይእ አይኬዛ። <verse eid="ACT 12:1"/><verse number="2" style="v" sid="ACT 12:2"/>ዋንሳ እሻ ያይቆባ ማሻር ዎሴዛ። <verse eid="ACT 12:2"/><verse number="3" style="v" sid="ACT 12:3"/>የይ አይሁድታ ኡፋይሴዛና ብኢ፥ ጉጂ ጵጽሮሳካ አይስሴዛ። የይ ሀኔዛይ ቦራ ባለ ቦንችዛ ጋላስታይዳ። <verse eid="ACT 12:3"/><verse number="4" style="v" sid="ACT 12:4"/>ጵጽሮሳና አይኪ አጬዛ። ፓዝቃ ቦንችዛ ጋላስታይፕ ጉየ ዎያ ቲና ኤዛ ከሶዳይስ ቆፒ፥ ኦይዲ ኦይዲ ዎታዳርታይ ኦይዲ አቆ ናግዝታይ ኤዛ ናጎዳይ ጋርክ ኣ እንጌዛ።<note caller="-" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">ከስ 12:1-27</ref></char></note> <verse eid="ACT 12:4"/><verse number="5" style="v" sid="ACT 12:5"/>የይ ግሾስ፥ ጵጽሮሳ አች ካራ ናግንትዛ። ዝን ዎሳ ኬ አሳይ ኤስ ሚን ጾስ ዎስዛ።<verse eid="ACT 12:5"/></para>
  <para style="s1">ኪታንቻይ ጵጽሮሳና አች ካራፕ ከሴዛ</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 12:6"/>ሄሮዶሳ ጵጽሮሳና ዎያ ቲና ሺሾዳይፕ ቲና ቃማ ጵጽሮሳ ናምኢ ባጋር ናምኢ ዎታዳርታይ ጋንጨ ሳንላተር አጭንቲ ገንቴዛ። ናግዝታይ አች ካራይ ፐንግታይድ ኤቂ ናግዛ። <verse eid="ACT 12:6"/><verse number="7" style="v" sid="ACT 12:7"/>ቆፐካዝን ጎዳ ኪታንቻይ ቆንጬዛ። አች ካራይድ ፖኦ ፖኤዛ። ኪታንቻይ ጵጽሮሳ ምያ ቦቺ ባርክ «ኤለ ደንዶባ» ዬጌዛ። እዝራካ ሳንላታይ ኤ ኩሻይፕ ዎዛ። <verse eid="ACT 12:7"/><verse number="8" style="v" sid="ACT 12:8"/>ኪታንቻይ ኤኮ፥ «ነ ማአ ማኦባ፥ ነ ጫማካ ኣባ» ዬጌዛ። ጵጽሮሳ የይ ጋርክ ኦዛ፤ ኪታንቻይ፥ «ነ አፋር ማእዝ ማአ ማኢ ታና ካሎባ» ዬጌዛ።<verse eid="ACT 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 12:9"/>ጵጽሮሳ አች ካራፕ ከዚ ኪታንቻ ካሌዛ። ኤስ አሁሞ ብእዛይ ጋርክ ኣዝዛፕ አትን ኪታንቻይ ኦዛባዛይ ቱማ ኣዘካያ። <verse eid="ACT 12:9"/><verse number="10" style="v" sid="ACT 12:10"/>ኪታንቻይራኔ ጵጽሮሳራ ቲናሳኔ ናምእን ዎታዳራ ኣ ካታማ ካንግዛ ብራታ ፐንጋይኮ ሄሌዛ። ፐንጋይካ ኡንትስ ፋ ኣዳስ ዶይንቴዛ። ኡንቲ ከዚ ፐቲ ሁሳ ኦገል ከዘዛን ጋርክ ቆፐካዝን ኪታንቻይ ጵጽሮሳፕ ሻክንቴዛ።<verse eid="ACT 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 12:11"/>ጵጽሮሳስ ዎዝናይ ማቅን፥ «ታ ጎዳይ ፋ ኪታንቻ ኪቲ፥ ሄሮዶሳ ኩሸፐኔ ናጊ በቴዝ አይሁደ አስ ኡባይፕ አሼዛና Ꮊት ቱማ ታ ኤሬዛ» ዬጌዛ።<verse eid="ACT 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 12:12"/>ኤ የያ አካኬዝ ዎደ ጋመ አሳይ ፐትፕ ሺቂ ጾሳ ዎስዛ አቃ፥ ማርቆሳ ግዝ ዋንሳ እንዳት ማይራሚ ካራ Ꮊንጌዛ። <verse eid="ACT 12:12"/><verse number="13" style="v" sid="ACT 12:13"/>ኤዛይድ ባለር ኤቂ ጼጌዛ። ፐቲ ሮዳ ግዝ ኦሶ አስታ ፐንጋ ኤስ ዶዮዳይስ የኤዛ። <verse eid="ACT 12:13"/><verse number="14" style="v" sid="ACT 12:14"/>ሮዳ ጵጽሮሳ ቃላ ማቄዛና ኤሪ ኡፋይሳር ኩሚ ጋዛራ ዶዮዳ አሺ ጉየ ዎጺ Ꮊንጊ፥ «ጵጽሮሳ ባለ ኤቄዛ» ዬጊ አሳይስ ኦዴዛ።<verse eid="ACT 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 12:15"/>አሳይ ኢኮ፥ «ኔኒ ኤይኔ!» ዬጌዛ። ሮዳ ጵጽሮሳ ማቄዛ ጌሺ ኦዴዛ። ኡንቲ፥ «የይ ኤ ኪታንቻ» ዬጌዛ።<verse eid="ACT 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 12:16"/>ዝን ጵጽሮሳ ባለር ኤቂ ጼስ አሻም እጽን አሳይ ጋዛራ ዶዪ ኤዛ ብኢ ማላባዝ ጌዛ። <verse eid="ACT 12:16"/><verse number="17" style="v" sid="ACT 12:17"/>ዝን ኡንቲ ስእ ጎዳይ ጋርክ ጵጽሮሳ ፋ ኩሻይር ማሊ ጎዳይ አች ኬይፕ ኤዛ ዋይዚ ከሴዛኮ ኡንትስ ቆንጭሲ ኦዲ፥ «Ꮊያ ያይቆባስኔ አማንዛ አሳይስ ኦዶይታ» ግ ኤዛይፕ ከዚ ሀራ አቆ ቅቴዛ።<verse eid="ACT 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 12:18"/>ሳአ ዎንቶዳር «ጵጽሮሳ አና ቅቴኔ» ግ ዎታዳርታይ ዎል ጋንጬ ጋመ ዋላሴዛ። <verse eid="ACT 12:18"/><verse number="19" style="v" sid="ACT 12:19"/>ሄሮዶሳ ጵጽሮሳ ኮይን በንተካዛይ ግሾስ ናግዝታ ቁሪ፥ ኡንታን ዎዳይ ጋርክ አዛዜዛ። የይፕ ጉየ፥ ሄሮዶሳ ይሁዳፕ ቅሳረ ዎ ኤዛይድ ጽቃ ዎደ በቴዛ።<verse eid="ACT 12:19"/></para>
  <para style="s1">ሄሮዶሳ Ꮊይቆ</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 12:20"/>ሄሮዶሳ ጽሮሳ አሳይራኔ ስዶና አሳይር ዎላ ሞርከ። ኡንቲ ቢታይ ካ ሄሮዶሳ ቢታፕ ደንግዛ ግሾስ ኡንቲ ፐትፕ ማቂ ኤ ዣንዳርባ ብላስጾሳ ፓስ ጭማ ኡዲ ዳቦቶዳይስ ሄሮዶሳኮ Ꮊንጌዛ።<verse eid="ACT 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 12:21"/>ሄሮዶሳ ሱንዝ ጋላስ ፋ ካተት አፍላ ማኢ፥ ዙፋናይል አፋ በቲ አሳይስ ኦዴዛ። <verse eid="ACT 12:21"/><verse number="22" style="v" sid="ACT 12:22"/>አሳይ፥ «የይ ጾስ ቃላ፥ አስ ቃላ ባያ» ዬጊ ኡኬዛ። <verse eid="ACT 12:22"/><verse number="23" style="v" sid="ACT 12:23"/>ሄሮዶሳ ጾሳ ቦንቼካ ግሾስ እዝራ ጎዳ ኪታንቻይ ኤዛ ሾጭን ጉጽነር ምንትንቲ Ꮊይቄዛ።<verse eid="ACT 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 12:24"/>ዝን ጾስ ቃላይ ድጭታራኔ ዳልግታር ኪቴዛ።<verse eid="ACT 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 12:25"/>ባርናባሳኔ ሳኦላ ፋ ኦሳ ፖሊ ማርቆሳ ግዝ ዋንሳ ፓር ኤኪ የሩሳላመፕ ማቄዛ።<verse eid="ACT 12:25"/></para>
  <chapter eid="ACT 12"/>
  <chapter number="13" style="c" sid="ACT 13"/>
  <para style="s1">ባርናባሳኔ ሳኦላ ኪትንቴዛ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1"/>አንጾካ የዝ ዎሳ ኬ ናብታይኔ አስታማርታይ የዛ። ኡንቲ ባርናባሳ፥ ካር ግንትንትዝ ስሞና፥ ቀረናፕ የኤዝ ሉኮሳ፥ ካታይ ሄሮድሳራ ድጬዝ ምናሄኔ ሳኦላ። <verse eid="ACT 13:1"/><verse number="2" style="v" sid="ACT 13:2"/>ኡንቲ ጎዳ ጎይንታራኔ ጾምታራኔ ጌሻ አያናይ፥ «ታኒ ጼጌዝ ኦሳይስ ባርናባሳኔ ሳኦላ ታስ ሻጎይታ» ዬጌዛ።<verse eid="ACT 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 13:3"/>የይ ግሾስ፥ ኡንቲ ጾሜዛፐኔ ዎሴዛይፕ ጉየ ፋ ኩሻ ኡንታል አፋ ጋዲ ዎሲ ዳኬዛ።<verse eid="ACT 13:3"/></para>
  <para style="s1">ባርናባሳኔ ሳኦላ ቆጲሮሳ Ꮊንጌዛ</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4"/>የይ ግሾስ፥ ጌሻ አያና ኡንታና ኪቴዛ። ሰለዉቀ Ꮊንጌዛ፤ ኤዛይፕ ማርካበ ገሊ ቆጲሮሳ ሃር ተቅንቴዝ ቢታ Ꮊንጌዛ። <verse eid="ACT 13:4"/><verse number="5" style="v" sid="ACT 13:5"/>ኡንቲ ስልማና ሄሊ አይሁደ ዎሳ ኬታይድ ጾስ ቃላ ኦዴዛ። ዋንሳ<note caller="+" style="f"><char style="fr" closed="false">13:5 </char><char style="fqa" closed="false">ዋንሳ፦ </char><char style="ft" closed="false">Ꮊ አቃ ጻፍንቴዝ ዋንሳ፥ ሀዋረ ዋንሳ ባዝን ዋንሳ ማርቆሳ ግንትንትዝ ማርቆሳ ዎንግለ ጻፌዛያ።</char></note> ማድታር ኡንታር የዛ።<verse eid="ACT 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 13:6"/>ኡንቲ ቆጲሮሳ ሃር ተቅንቴዝ ቢታ ካን ጳፉ ሄልዛ ዎደ ፐቲ ዎርዶ ናበ ባር-የሱሳ ግዝ አይሁደ አምታ ደንጌዛ። <verse eid="ACT 13:6"/><verse number="7" style="v" sid="ACT 13:7"/>አቅስዝ ሳርጎሳ ጳዉሎሳ ግዝ ዎዛናማ አይራ የዛ። ሳርጎሳ ጳዉሎሳ ባርናባሳነ ሳኦላ ፋኮ ጼጊ ጾስ ቃላ ስኦዳይስ ኮዬዛ። <verse eid="ACT 13:7"/><verse number="8" style="v" sid="ACT 13:8"/>ዝን ግርኬ ዶናር አምታይ ሱንይ «ኤልማሳ» ብልይ ጋደ ሃርዛይ አማናማይ ጋርክ ካዮዳይስ ኮዪ ባርናባሳራኔ ጳዉሎሳር ኤቅንቴዛ።<verse eid="ACT 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 13:9"/>ዝን ጳዉሎሳ ግዝ ሳኦላ ጌሻ አያናር ኩሚ አምታና ዳኪ ብኢ፥ <verse eid="ACT 13:9"/><verse number="10" style="v" sid="ACT 13:10"/>«ናት፥ ጻላሄ ናአዮ፥ ኢታት ኡባይ ኩሜዛዮ፥ ጽሎት ኡባይስ ሞርካዮ፥ ሉለ ጎዳ ኦጋ ምርቅዛ አሻሞ? <verse eid="ACT 13:10"/><verse number="11" style="v" sid="ACT 13:11"/>ዬዛኮ፥ Ꮊት ጎዳይ ካች ኩሻይ ኔል አፋ የዛ። ኔኒ ቆቀ ማቆዳ፤ ጽቃ ዎደስ አዋ ፖኦ በአሚ» ዬጌዛ።</para>
  <para style="p" vid="ACT 13:11">እዝር ጫጋናኔ ማ ኤ አፋ ጎዝን፥ ፋ ኩሻ አይኪ ካልዛ አስ ኮይታር ዩዬዛ። <verse eid="ACT 13:11"/><verse number="12" style="v" sid="ACT 13:12"/>ጋደ ሃርዛይ የያ በኤዝ ዎደ ጎዳባዝ ታማርስዛይድ ማላባዝ ግ አማኔዛ።<verse eid="ACT 13:12"/></para>
  <para style="s1">ባርናባሳኔ ጳዉሎሳ ጵስዳ አንጾካ Ꮊንጌዛ</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 13:13"/>ጳዉሎሳኔ ኤዛር የዝታይ ጳፉፕ ደንዲ፥ ጵንፍላ የዝ ጰርገ ማርካበር Ꮊንጌዛ። ዋንሳ ኡንታፕ ሻክንቲ የሩሳላመ ማቄዛ። <verse eid="ACT 13:13"/><verse number="14" style="v" sid="ACT 13:14"/>ዝን ኡንቲ ጰርገፕ ኣ ጵስዳ የዝ አንጾካ ሄሌዛ። ማላ ጋላስ ጋላስ አይሁደ ዎሳ ኬ ገሊ በቴዛ። <verse eid="ACT 13:14"/><verse number="15" style="v" sid="ACT 13:15"/>ሙሰ ህጋይድ ናብታይ ማጻፋይ ናባብንቴዛይፕ ጉየ አይሁደ ዎሳ ኬ ሀላቅታይ፥ «ኑ እሹን፥ አስ ምንዛ ቃላ ይንትስ የዛኮ አሳይስ ኦዶይተ» ዬጊ ኡንትኮ ኪቴዛ።<verse eid="ACT 13:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 13:16"/>ጳዉሎሳ ደንዲ ኤቂ ፋ ኩሸር ማሊ፥ «እስሬለ አስታኔ፥ ጾሳ ጎይንዛ አይሁደ ማቀካ አሳዮ፥ ስኦይታ። <verse eid="ACT 13:16"/><verse number="17" style="v" sid="ACT 13:17"/>Ꮊ እስሬለ አሳ ጾሳይ፥ ኑ ማይዝታ ዶሬዛ። ግብጸ ቢታ እማትር ኡንቲ የዝን፥ ኡንታን ጋን ፋ ግታ ዎልቃር ግብጸ ቢታፕ ከሴዛ።<note caller="-" style="x"><char style="xo" closed="false">13:17 </char><char style="xt" closed="false"><ref loc="EXO 1:7">ከስ 1:7</ref>፤ <ref loc="EXO 12:51">ከስ 12:51</ref></char></note> <verse eid="ACT 13:17"/><verse number="18" style="v" sid="ACT 13:18"/>ሊዦ ቢታ ኦይታም ላይ ማቆዳ ኡንታን ዳንዳኤዛ።<note caller="-" style="x"><char style="xo" closed="false">13:18 </char><char style="xt" closed="false"><ref loc="NUM 14:34">ታይ. 14:34</ref>፤ <ref loc="DEU 1:31">ናምእ. 1:31</ref></char></note> <verse eid="ACT 13:18"/><verse number="19" style="v" sid="ACT 13:19"/>ካንአነ ቢታ አይሁደ ማቀካ ላፑን ካተትታ ሃሲ ኡ ቢታ ፋ አሳ ላትሴዛ።<note caller="-" style="x"><char style="xo" closed="false">13:19 </char><char style="xt" closed="false"><ref loc="DEU 7:1">ናምእ. 7:1</ref>፤ <ref loc="JOS 14:1">ኢያ. 14:1</ref></char></note> <verse eid="ACT 13:19"/><verse number="20" style="v" sid="ACT 13:20"/>የይ ኡባይ ኦይዲ ጼታኔ እሻታም ማቃድ ላይ ጋንጨ ሀኔዛ። የይፕ ጉየ ናበ ሳምኤላ ዎደ ሄሎዳይስ ዳይንታይ አቅሶዳይ ጋርክ እንጌዛ።<note caller="-" style="x"><char style="xo" closed="false">13:20 </char><char style="xt" closed="false"><ref loc="DEU 2:16">ናምእ. 2:16</ref>፤ <ref loc="1SA 3:20">1ሳም. 3:20</ref></char></note><verse eid="ACT 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 13:21"/>«የይፕ ጉየ፥ ኡንቲ ፓስ ካት እንጎዳይ ጋርክ ዎስን፥ ጾሲ ቢናመ ሼሻይፕ ቂሰ ናአ፥ ሳኦላ ኦይታም ላይ ካዉቶዳይ ጋርክ ኡንትስ እንጌዛ።<note caller="-" style="x"><char style="xo" closed="false">13:21 </char><char style="xt" closed="false"><ref loc="1SA 8:5">1ሳም. 8:5</ref>፤ <ref loc="1SA 10:21">10:21</ref></char></note> <verse eid="ACT 13:21"/><verse number="22" style="v" sid="ACT 13:22"/>ጾሳይ ሳኦላ ሻሬዛይፕ ጉየ ኡንታል አፋ ዳዉተ ካዉትሴዛ። ጾሳይ ዳዉተ ባጋ ማርካትታር፥ ‹ታኒ ታ ሸነ ኡባ ኦዝ ታ ዎዝና ማቄዝ ኢሳየ ናአ ዳዉተ ደንጌዛ› ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">13:22 </char><char style="xt" closed="false"><ref loc="1SA 13:14">1ሳም. 13:14</ref>፤ <ref loc="1SA 16:12">16:12</ref>፤ <ref loc="PSA 89:20">ማዝ. 89:20</ref></char></note><verse eid="ACT 13:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 13:23"/>«ጾሳይ፥ ‹ታኒ ዳዉተ ሼሻይፕ እስሬለ አሽዛ ኮኦዳ› ግ ቃላ ገሌዛይ ጋርክ የሱሳና ከኤዛ። <verse eid="ACT 13:23"/><verse number="24" style="v" sid="ACT 13:24"/>የሱሳ የኦዳይፕ ቲና እስሬለ አስ ኡባይ ፋ ናጋራይፕ ማቂ ጻማቅንቶዳይ ጋርክ ዋንሳ ቃላ ኦዴዛ።<note caller="-" style="x"><char style="xo" closed="false">13:24 </char><char style="xt" closed="false"><ref loc="MRK 1:4">ማር. 1:4</ref>፤ <ref loc="LUK 3:3">ሉቃ. 3:3</ref></char></note> <verse eid="ACT 13:24"/><verse number="25" style="v" sid="ACT 13:25"/>ማ ዋንሳ ፋ ኦሳ ዉርሶድ ሀንታር አሳይኮ፥ ‹ታና ይ ኦና ግ ቆፔ? ታኒ ይ ናግዛ ክርስቶሳ ባያ፥ ዝን ታኒ ኤ ጫማ ብሎዳይስ ታስ ቤዞዋዛይ ታፕ ጉየር ይእዛ› ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">13:25 </char><char style="xt" closed="false"><ref loc="MAT 3:11">ማቶ. 3:11</ref>፤ <ref loc="MRK 1:7">ማር. 1:7</ref>፤ <ref loc="LUK 3:16">ሉቃ. 3:16</ref>፤ <ref loc="JHN 1:20">ዋን. 1:20</ref>፥ <ref loc="JHN 1:27">27</ref></char></note><verse eid="ACT 13:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 13:26"/>«ኑ ኢሹን፥ አፍራመ ሼሹን፥ ማ Ꮊይዳ አይሁደ ባዝን ጾስስ ያሽትዝታዮ፥ Ꮊ አቶት ቃላይ ኑስ ኪትንቴዛ። <verse eid="ACT 13:26"/><verse number="27" style="v" sid="ACT 13:27"/>አብስ ጊኮ፥ የሩሳላመ የዝ አሳይኔ ኡ ሀላቅታይ የሱሳና ኤረካያ። ማላ ጋላስ ኡባይድ ናባብንትዛ ናብታይ ቃላ አካኬካ ግሾስ ኤዛል አፋ ፕርዲ ናብታይ ኦዴዝ ቃላ ፖሌዛ። <verse eid="ACT 13:27"/><verse number="28" style="v" sid="ACT 13:28"/>የሱሳ ዎሶዳይስ ፐቲ ሳንከካ ብን ጵላጾሳ ኤዛ ዎዳይ ጋርክ ዎሴዛ።<note caller="-" style="x"><char style="xo" closed="false">13:28 </char><char style="xt" closed="false"><ref loc="MAT 27:22-23">ማቶ. 27:22-23</ref>፤ <ref loc="MRK 15:13-14">ማር. 15:13-14</ref>፤ <ref loc="LUK 23:21-23">ሉቃ. 23:21-23</ref>፤ <ref loc="JHN 19:15">ዋን. 19:15</ref></char></note> <verse eid="ACT 13:28"/><verse number="29" style="v" sid="ACT 13:29"/>ኡንቲ የሱሳባዝ ጌሻ ማጻፋይድ ጻፍንቴዝባዝ ኡባ ፖሌዝ ዎደ ማዝቃለፕ ኤዛ ዎሲ ሞጌዛ<note caller="+" style="f"><char style="fr" closed="false">13:29 </char><char style="ft" closed="false">ሞጌዛይ ቢታ ጋንጨ ባዝን ሹቻፕ ዎጭንቴዝ ዱፎ ጋንጨ ጋዴዝ ጉሲ</char></note>።<note caller="-" style="x"><char style="xo" closed="false">13:29 </char><char style="xt" closed="false"><ref loc="MAT 27:57-61">ማቶ. 27:57-61</ref>፤ <ref loc="MRK 15:42-47">ማር. 15:42-47</ref>፤ <ref loc="LUK 23:50-56">ሉቃ. 23:50-56</ref>፤ <ref loc="JHN 19:38-42">ዋን. 19:38-42</ref></char></note> <verse eid="ACT 13:29"/><verse number="30" style="v" sid="ACT 13:30"/>ዝን ጾሳይ Ꮊይቆፕ የሱሳ ደንዛ። <verse eid="ACT 13:30"/><verse number="31" style="v" sid="ACT 13:31"/>የይፕ ጉየ፥ ኤ ፓር ጋልላፕ የሩሳላመ የኤዝታይስ ኡንደና ጋላስ በንቴዛ። ኡንቲ Ꮊት ኤባዝ አሳይስ ማርካትዛ።<note caller="-" style="x"><char style="xo" closed="false">13:31 </char><char style="xt" closed="false"><ref loc="ACT 1:3">ሀዋ. ኦ. 1:3</ref></char></note><verse eid="ACT 13:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 13:32"/>«ጾሲ ኑ አድታይስ እማድ ጌዝ ዎንግለ ኑኒ ይንትስ ኦድዛ። <verse eid="ACT 13:32"/><verse number="33" style="v" sid="ACT 13:33"/>ዳዉተ ፋ ማዝሙረ ማጻፋይድ ናምእን ሸምፓይድ፥</para>
  <para style="q1" vid="ACT 13:33">« ‹ኔኒ፥ ታ ናአ፥</para>
  <para style="q2" vid="ACT 13:33">ታኒ Ꮊይኖ ነና የሌዛ›</para>
  <para style="m" vid="ACT 13:33">ጊንትንቴዛይ ጻፍንቴዛ የሱሳ፥ ጾሲ Ꮊይቆፕ ደን ኑ ማይዝታይስ እንጎድ ጌዛ ኑስ ኡ ናእታይስ ፖሌዛ።<note caller="-" style="x"><char style="xo" closed="false">13:33 </char><char style="xt" closed="false"><ref loc="PSA 2:7">ማዝ. 2:7</ref></char></note> <verse eid="ACT 13:33"/><verse number="34" style="v" sid="ACT 13:34"/>ኤ ዎቃማይ ጋርክ ጾሳይ Ꮊይቆፕ ኤዛ ደንር ኤርሶዳይስ፥</para>
  <para style="q1" vid="ACT 13:34">« ‹ታኒ ዳዉተስ እንጎድ ጌዝ</para>
  <para style="q2" vid="ACT 13:34">አማንንቴዝ ጌሽ አንጆ ይንትስ እንጎዳ› ዬጊ ኦዴዛ።<note caller="-" style="x"><char style="xo" closed="false">13:34 </char><char style="xt" closed="false"><ref loc="ISA 55:3">ኢሳ. 55:3</ref></char></note><verse eid="ACT 13:34"/></para>
  <para style="m">
    <verse number="35" style="v" sid="ACT 13:35"/>የይ ግሾስ፥ ማዝሙረ ማጻፋይድ ሀራ አቆ ማ</para>
  <para style="q1" vid="ACT 13:35">‹ነ ጽላይ አሃ ዎቅሳሚ ዬግዛ።›<note caller="-" style="x"><char style="xo" closed="false">13:35 </char><char style="xt" closed="false"><ref loc="PSA 16:10">ማዝ. 16:10</ref></char></note><verse eid="ACT 13:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 13:36"/>«ዳዉተ ፋ ዎደ ጾሳ ቆፋ ፖሌዛይፕ ጉየ Ꮊይቂ ፋ አድታይር ሞግንቲ ዎቄዛ። <verse eid="ACT 13:36"/><verse number="37" style="v" sid="ACT 13:37"/>ዝን ጾሳይ Ꮊይቆፕ ደንዛይ ዎቀካያ።<verse eid="ACT 13:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 13:38"/>«የይ ግሾስ፥ ታ እሹን፥ ናጋራ አቶትይ የሱሳ ባጋር ቲናቲ ይንትስ ኦድንቴዛ ኤሮይታ። ሙሰ ህጋይ ናጋራፕ ጽልሶዳይስ ዳንዳኦያ። <verse eid="ACT 13:38"/><verse number="39" style="v" sid="ACT 13:39"/>ዝን የሱሳ አማንዛ ኡባይ ናጋራፕ ጽልዛ። <verse eid="ACT 13:39"/><verse number="40" style="v" sid="ACT 13:40"/>የይ ግሾስ፥ ናብታይ ጌዛይ ይንታል አፋ ሄላማይ ጋርክ ናግንቶይታ።<verse eid="ACT 13:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="ACT 13:41"/>« ‹ጾሳይ ጌዝባዝ ሌቅስዙን! ቦኦይታ! ማላባዝ ጎይታ! ቦይታ!</para>
  <para style="q2" vid="ACT 13:41">ኦንካ ኦድን፥ ይ አማኖዋ ኦሳ</para>
  <para style="q2" vid="ACT 13:41">ታኒ ይ ዎደ ኦዳ› » ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">13:41 </char><char style="xt" closed="false"><ref loc="HEB 1:5">እብራ. 1:5</ref></char></note><verse eid="ACT 13:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 13:42"/>ጳዉሎሳኔ ባርናባሳ አይሁደ ዎሳ ኬፕ ከሳዳር፥ ካልዛ ማላ ጋላሳይድ የያ ጉጂ ኦዶዳይ ጋርክ አሳይ ኡንታን ዎሴዛ። <verse eid="ACT 13:42"/><verse number="43" style="v" sid="ACT 13:43"/>ሺቆ ላልንቴዛይፕ ጉየ ጋመ አይሁድታይኔ አይሁድታይ አማናይድ ገሊ ጾሳ ጎይንዛ ጋምታይ ጳዉሎሳኔ ባርናባሳ ካሌዛ። አማኔዝታይ ጾስ ኣ ኬሃትይድ ሚንጊ የዞዳይ ጋርክ ኡንታን ዞሬዛ።<verse eid="ACT 13:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 13:44"/>ካልዛ ማላ ጋላስ ካታማ የዝ አሳይፕ ኦንክ አተካ ጎድ ሄሎዳይ ጋምታይ ጾስ ቃላ ስኦዳይስ ሺቄዛ። <verse eid="ACT 13:44"/><verse number="45" style="v" sid="ACT 13:45"/>ዝን አይሁድታይ ጋመ አሳ በኤዝ ዎደ ጳዉሎሳ ቅናቲ ኤ ናሻ እጺ ኤዛ ጫዤዛ።<verse eid="ACT 13:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="ACT 13:46"/>ጳዉሎሳኔ ባርናባሳ ያሽተካያ፥ «ጾሳ ቃላይ ቲናቲ ይንትስ ኦድንቶዳይስ ኮሽዛ። ዝን ይ ቃላ እጺ መና ደኦ ኤኮዳይስ ኑስ ቤዞያ ግ ይ፥ ይ ኦማስ ፕርዴዝ ግሾስ ይኬ ኑኒ አይሁደ ባዝታይኮ ማቆዳ። <verse eid="ACT 13:46"/><verse number="47" style="v" sid="ACT 13:47"/>የይካ ጎዳይ፥</para>
  <para style="q1" vid="ACT 13:47">« ‹አላመ ኩንይ ነ ባጋር አቶዳይ ጋርክ፥</para>
  <para style="q2" vid="ACT 13:47">ታኒ ነና አይሁደ ባ ዎያስ ፖኦ ኦዛ ዬጊ ኑና ኪቴዛ› » ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">13:47 </char><char style="xt" closed="false"><ref loc="ISA 42:6">ኢሳ. 42:6</ref>፤ <ref loc="ISA 49:6">49:6</ref></char></note><verse eid="ACT 13:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 13:48"/>አይሁደ ባዝታይ የያ ስኢ ኡፋይቲ ጾስ ቃላ ቦንቼዛ። ማ መና ደኦስ ማራጽንቴዝ ኡባይ አማኔዛ።<verse eid="ACT 13:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="ACT 13:49"/>ጎዳ ቃላይ የ ጋደ ኡባ ሄሌዛ። <verse eid="ACT 13:49"/><verse number="50" style="v" sid="ACT 13:50"/>ዝን አይሁድታይ፥ አይሁደ ባዛር ጾሰ ጎይንዛ ቦንችንቴዝ ማችታኔ ካታማ የዝ ግታ አስታ ጳዉሎሳል አፋኔ ባርናባሳል አፋ ደንዛ። የ አስታይ ኡንታን ባይእ አይኪ ፋ ቢታፕ ከሴዛ። <verse eid="ACT 13:50"/><verse number="51" style="v" sid="ACT 13:51"/>ዝን ጳዉሎሳራኔ ባርናባሳራ እጽዝታይስ ማላ ማቆዳይ ጋርክ ፋ ቶኬ ቡልአ ትቅሲ ኢቆኖኔ ካታማ Ꮊንጌዛ።<note caller="-" style="x"><char style="xo" closed="false">13:51 </char><char style="xt" closed="false"><ref loc="MAT 10:14">ማቶ. 10:14</ref>፤ <ref loc="MRK 6:11">ማር. 6:11</ref>፤ <ref loc="LUK 9:5">ሉቃ. 9:5</ref>፤ <ref loc="LUK 10:11">10:11</ref></char></note> <verse eid="ACT 13:51"/><verse number="52" style="v" sid="ACT 13:52"/>ማ አንጾካ የዝ አማንዝታይ ጌሻ አያናራኔ ኡፋይሳር ኩሜዛ።<verse eid="ACT 13:52"/></para>
  <chapter eid="ACT 13"/>
  <chapter number="14" style="c" sid="ACT 14"/>
  <para style="s1">ጳዉሎሳኔ ባርናባሳ ኢቆኖነ Ꮊንጌዛ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1"/>ካሴሳይ ጋርክ፥ ጳዉሎሳኔ ባርናባሳ ኢቆኖነ አይሁድታይ ዎሳ ኬ ገሊ ጋመ አይሁድታይኔ አይሁደ ባዝታይ አማኖድ ሄሎዳይስ ቃላ ኦዴዛ። <verse eid="ACT 14:1"/><verse number="2" style="v" sid="ACT 14:2"/>ዝን አማነካ አይሁድታይ፥ አይሁደ ባዝታይ ዎዛና ላሚ እሽታይል አፋ ደንዛ። <verse eid="ACT 14:2"/><verse number="3" style="v" sid="ACT 14:3"/>ሀዋርታይ ኤዛይድ ጋመ ዎደ ጋምኤዛ። ኡንቲ ያሽተካ ጎዳይ ባጋ ኦዴዛ። ጎዳይ ማላትታኔ ኦርባዝ ኡንቲ ኦዳይ ጋርክ ኡንትስ ማዉተ እንጊ ፋ ኣ ኬሄት ቃላይ ቱማ ማቄዛና ቤዜዛ። <verse eid="ACT 14:3"/><verse number="4" style="v" sid="ACT 14:4"/>ዝን የ ካታማ አሳይ ሻክንቲ፥ ባጋይ አይሁድታይር ባጋይ ማ ሀዋርታይር ማቄዛ።<verse eid="ACT 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 14:5"/>አይሁደ ባዝታይኔ አይሁድታይ ፋ ሀላቅታይር ዎላ ማቂ ሀዋርታ ቆሆዳይስኔ ሹቻር ሾጮዳይስ ኮዬዛ። <verse eid="ACT 14:5"/><verse number="6" style="v" sid="ACT 14:6"/>ሀዋርታይ የያ ኤሪ፥ ልስጽራኔ ደርበ ግዝ ልቃኦነ ካታምታኔ ኡ ሄራ የዝ ቢታ ቆስንቴዛ። <verse eid="ACT 14:6"/><verse number="7" style="v" sid="ACT 14:7"/>ኤዛይድ ዎንግለ ኦዴዛ።<verse eid="ACT 14:7"/></para>
  <para style="s1">ጳዉሎሳኔ ባርናባሳ ልስጽራራኔ ደርበር</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 14:8"/>የልንቴዛይፕ አይኪ ናምእ ቶክታይ ስሌዝ የ ኤሮዋ ፐቲ አይ ልስጽራ የዛ። <verse eid="ACT 14:8"/><verse number="9" style="v" sid="ACT 14:9"/>የ አይ ጳዉሎሳ ኦዶዳር በቲ ስእዛዝን። ጳዉሎሳ ኤዛ ዳኪ በአዳር ፓጾዳይስ ኤስ አማኖ የዛ ብኢ፥ <verse eid="ACT 14:9"/><verse number="10" style="v" sid="ACT 14:10"/>ፋ ቃላ ቅ ኡዲ፥ «ስት ግ ነ ቶካይር ኤቆባ» ዬጌዛ። የዝን፥ ፑክ ግ ደንዲ ኤቂ የ አይኬዛ።<verse eid="ACT 14:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 14:11"/>ጳዉሎሳ ኦዛ አሳይ ብኢ ኡ ፋ ቃላ ቅ ኡዲ ልቃኦነ ዶናር፥ «ጾስታይ አስ ኣዚ ኑኮ ዎዛ» ዬጌዛ። <verse eid="ACT 14:11"/><verse number="12" style="v" sid="ACT 14:12"/>ባርናባሳና፥ «ድያ» ግ፥ ጳዉሎሳ Ꮊይዳ ኦዳር ኤርንቴዛያ ማቄዝ ግሾስ ኤዛ፥ «ሄርሜሳ» ግ ሱንዛ። <verse eid="ACT 14:12"/><verse number="13" style="v" sid="ACT 14:13"/>ካታማይፕ ጋጻ የዝ ድያ ግዝ ኤቃ ካራ ካህናይ ኮርምታኔ ፉ ዶስታ ሀዋርታይስ ያርሾዳይስ ከዚ ካታማ ጋጻ ከኤዛ።<verse eid="ACT 14:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 14:14"/>ዝን ባርናባሳኔ ጳዉሎሳ የያ ስኢ ፋ ማአ ፔዛ። አሳይ ጋንጨ ዎጺ ገሊ፥ <verse eid="ACT 14:14"/><verse number="15" style="v" sid="ACT 14:15"/>ፋ ቃላ ቅ ኡዲ፥ «አሳዮ፥ Ꮊያ አብስ ኦ? ኑንካ ይ ጋርክ አሰ። Ꮊ ፓዋባዛይፕ ሳሎኔ ሳአ፥ አባኔ ኡ ጋንጨ የዝ ኡባ ባዝ መዝ ደኦ ጾሳይኮ ይ ማቆዳይ ጋርክ ይንትስ ኑኒ ዎንግለ ኦዶዳ።<note caller="-" style="x"><char style="xo" closed="false">14:15 </char><char style="xt" closed="false"><ref loc="EXO 20:11">ከስ 20:11</ref>፤ <ref loc="PSA 146:6">ማዝ. 146:6</ref></char></note> <verse eid="ACT 14:15"/><verse number="16" style="v" sid="ACT 14:16"/>ኤ ብኒ አሳይ ፋ ኦገ ፋ ኦገ Ꮊማዳይ ጋርክ ዳኪ አሼዛ። <verse eid="ACT 14:16"/><verse number="17" style="v" sid="ACT 14:17"/>ዝን እራ ሳሎፕ ቡክሴዛ፥ ካካ ዎደር ዎደር እንጌዝ፥ ካ እንጊ ይንታን ጋመ ኡፋይሴዛ፥ ዬዚ ይንትስ ሎኦ ባዝ ኡዲ ፓስ ማርካ ብሰካ» ዬጌዛ። <verse eid="ACT 14:17"/><verse number="18" style="v" sid="ACT 14:18"/>ሀዋርታይ የያ ግ ፓስ አሳይ ያርሻማይ ጋርክ ዋየር ካይሴዛ።<verse eid="ACT 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 14:19"/>አንጾካፐኔ ኢቆኖነፐ የኤዝ አይሁድታይ፥ አሳ ፋ ባጋ ማሂ ሹቻር ጳዉሎሳ ጫዴዛ። ኡንትስ ኤ Ꮊይቄዝባዝ ኣዝን ካታማፕ ጋጻ ጎቺ ካንጊ ኦሌዛ። <verse eid="ACT 14:19"/><verse number="20" style="v" sid="ACT 14:20"/>ዝን አማንዝታ ይኢ፥ ኤ ዩሻይድ ጋልቺ ኤቄዛዝን ኤ ደንዲ ካታማ ገሌዛ። ዎንት ጋላስ ባርናባሳር ፐትፕ ደርበ ቅቴዛ።<verse eid="ACT 14:20"/></para>
  <para style="s1">ጳዉሎሳኔ ባርናባሳ ሶረ አንጾካ ማቄዛ</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 14:21"/>ኡንቲ ደርበ ካታማ ዎንግለ ኦዲ ጋምታ አማንዛይፕ ጉየ ልስጽራ፥ ኢቆኖነኔ ጵስዳ አንጾካ ማቄዛ። <verse eid="ACT 14:21"/><verse number="22" style="v" sid="ACT 14:22"/>የ ካታምታይድ የዝ አማንዝታ ምህታራ ኡንቲ አማኖር ምንጎድ ጋርክ ዞርታር፥ «ጾሳ ካተት ገሎዳይስ ኑኒ ጋመ ዋየ ኤኮዳይስ ቤዝዛ» ዬጊ ታማርሴዛ። <verse eid="ACT 14:22"/><verse number="23" style="v" sid="ACT 14:23"/>ማ ዎሳ ኬታይስ ኦማስ ኦማስ ጭምታ ዶሬዛ። ጾሜዛይፐኔ ዎሴዛይፕ ጉየ ኡንቲ አማኔዝ ጎዳይስ ኡ ሀዳራ እንጌዛ።<verse eid="ACT 14:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 14:24"/>ጵስዳ ቢታ ካን ኣ ጵንፍለ Ꮊንጌዛ። <verse eid="ACT 14:24"/><verse number="25" style="v" sid="ACT 14:25"/>ጰርገ ቃላ ኦዴዛይፕ ጉየ አጻላ Ꮊንጌዛ። <verse eid="ACT 14:25"/><verse number="26" style="v" sid="ACT 14:26"/>የይፕ ኡንቲ ፋ ፖሌዝ ኦሳይስ ጾስ ኣ ኬሃትይስ ኡንታን ሀዳራ እንጌዝ አንጾካ ማርካበር ማቄዛ።<verse eid="ACT 14:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 14:27"/>አንጾካ ሄሊ ዎሳ ኬ አሳ ሺሺ ጾሳይ ኡንታራ ኦዝ ኦሳ ኡባይኔ አይሁደ ማቀካ አሳይ አማኖዳይ ጋርክ ኡንትስ ዋይዚ ኦገ ዶዬዛኮ ኦዴዛ። <verse eid="ACT 14:27"/><verse number="28" style="v" sid="ACT 14:28"/>ኤዛይድ አማንዝታይር ጋመ ዎደ ጋምኤዛ።<verse eid="ACT 14:28"/></para>
  <chapter eid="ACT 14"/>
  <chapter number="15" style="c" sid="ACT 15"/>
  <para style="s1">የሩሳላመ ሺቆ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 15:1"/>ፐቲ ፐቲ አሳይ ይሁዳፕ አንጾካ Ꮊንጊ፥ «ሙሰ ዎጋይ ጋርክ ይ ዶካልንታም እጽኮ አቶዳይስ ዳንዳኦያ» ግ አማንዝታ ታማርሶ አይኬዛ።<note caller="-" style="x"><char style="xo" closed="false">15:1 </char><char style="xt" closed="false"><ref loc="LEV 12:3">ለዊ. 12:3</ref></char></note> <verse eid="ACT 15:1"/><verse number="2" style="v" sid="ACT 15:2"/>የይ ጳዉሎሳኔ ባርናባሳ ኡንታር ጋመ ፓላሞዳይ ጋርከኔ ዋጮዳይ ጋርክ ኦዛ። የይ ግሾስ፥ አንጾካ የዝ ፐቲ ፐቲ አሳይ ጳዉሎሳራኔ ባርናባሳራ የሩሳላመ Ꮊንጊ ሀዋርታይራኔ ጭምታይር ዎል ሄሊ የ ኦዳ ብሎዳይ ጋርክ ቆፋ አጬዛ።<verse eid="ACT 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 15:3"/>ዎሳ ኬይ ኡንታን ኪትን Ꮊንጌዛ። ኡንቲ ፍንቀ ሳማረራ ኣታር አይሁደ ባዝታይ ጾስኮ ዋይዚ ማቄዛኮ ኦዴዛ። የይ አማንዝታ ኡባ ጋመ ኡፋይሴዛ። <verse eid="ACT 15:3"/><verse number="4" style="v" sid="ACT 15:4"/>ኡንቲ የሩሳላመ ሄልን ዎሳ ኬይ፥ ሀዋርታይኔ ጭምታይ ኡንታን ሞኬዛ። ጾሳይ ኡንታር ኦዝ ባዝታ ኡባ ኡ ኦዴዛ። <verse eid="ACT 15:4"/><verse number="5" style="v" sid="ACT 15:5"/>ዝን ፈርሳውታይ ባጋፕ አማኔዝ ፐቲ ፐቲ አሳይ ደንዲ ኤቂ፥ «አይሁደ ባዛር አማኔዝ አሳይ ዶካልንቶዳይስኔ ሙሰ ህጋ ናጎዳይስ ቤዝዛ» ዬጌዛ።<verse eid="ACT 15:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 15:6"/>ሀዋርታይኔ ጭምታይ የያ ቶቦዳይስ ሺቄዛ። <verse eid="ACT 15:6"/><verse number="7" style="v" sid="ACT 15:7"/>ጋመ ኦድንቴዛይፕ ጉየ፥ ጵጽሮሳ ደንዲ ኤቂ፥ «ታ እሹን፥ አይሁደ ባዝታይ ዎንግለ ቃላ ታ ዶናይፕ ስኢ አማኖዳይ ጋርክ ቲናቲ ታና ጾሲ ይ ጋንጨፕ ዶሬዛና ይ ኤርዛ።<note caller="-" style="x"><char style="xo" closed="false">15:7 </char><char style="xt" closed="false"><ref loc="ACT 10:1-43">ሀዋ. ኦ. 10:1-43</ref></char></note> <verse eid="ACT 15:7"/><verse number="8" style="v" sid="ACT 15:8"/>አስ ዎዝና ኤርዛ ጾሳይ ጌሻ አያና ኑስ እንጌዛይ ጋርክ ኡንትስካ እንጌዛና ማርካቴዛ።<note caller="-" style="x"><char style="xo" closed="false">15:8 </char><char style="xt" closed="false"><ref loc="ACT 2:4">ሀዋ. ኦ. 2:4</ref>፤ <ref loc="ACT 10:44">10:44</ref></char></note> <verse eid="ACT 15:8"/><verse number="9" style="v" sid="ACT 15:9"/>አማኖር ኡ ዎዝና ጌሼዝ ግሾስ ኑ ጋንጨኔ ኡ ጋንጨ ዱማት ጋደካያ። <verse eid="ACT 15:9"/><verse number="10" style="v" sid="ACT 15:10"/>የይ ግሾስ፥ ኑ አድታይኔ ኑኒ ቶኮዳይስ ዳንዳእንቶዋ ቃምባራ አማንዝታይ ሞርጋይል ጋዲ Ꮊት አብስ ጾሳ ፓጨ? <verse eid="ACT 15:10"/><verse number="11" style="v" sid="ACT 15:11"/>ጎዳ የሱሳ ኣ ኬሃትይድ ኡንቲ አቴዛይ ጋርክ ኑካ አቴዛና አማኖዳ» ዬጌዛ።<verse eid="ACT 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 15:12"/>አሳይ ስእ ግ፥ ባርናባሳኔ ጳዉሎሳ አይሁደ ማቀካ አሳይ ጋንጨ ፋ ባጋር ጾሲ ኦዝ ማላትታኔ ኦሮባዝ ኡባ ኦዶዳር ስኤዛ።<verse eid="ACT 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 15:13"/>ኡንቲ ናሻ ሃሴዛይፕ ጉየ ያይቆባ፥ «ኢሹን፥ ታ ግዛ ስኦይታ። <verse eid="ACT 15:13"/><verse number="14" style="v" sid="ACT 15:14"/>ጾሲ አይሁደ ባዝታይ ጋንጨፕ ፋ አስ ዶሮዳይስ ከዚ ኡንታን ቲን ዋይዚ ቆፔዛኮ ስሞና ኦዴዛ። <verse eid="ACT 15:14"/><verse number="15" style="v" sid="ACT 15:15"/>ናብታይ ቃላይ Ꮊይር ቃርዛ። ጌሻ ማጻፋይድ፥<verse eid="ACT 15:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ACT 15:16"/>«‹Ꮊይፕ ጉየ፥ ታኒ ማቆዳ፥</para>
  <para style="q2" vid="ACT 15:16">ዎዝ ዳዉተ ኬ ደንዳ።</para>
  <para style="q2" vid="ACT 15:16">
    <note caller="-" style="x">
      <char style="xo" closed="false">15:16-18 </char>
      <char style="xt" closed="false">
        <ref loc="AMO 9:11-12">አሞ. 9:11-12</ref>
      </char>
    </note>ላልንቴዝ ኬካ ታ ማሂ ኤሶዳ።<verse eid="ACT 15:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 15:17"/>አቴዝ አስ ኡባይ ታኮ የኦዳ፥</para>
  <para style="q2" vid="ACT 15:17">ታኒ ጼጌዝ አይሁደ ማቀካ አስ ኡባይ ታና ኮዮዳ።<verse eid="ACT 15:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 15:18"/>ብንፕ አይኪ የይ ኤርንቶዳይ ጋርክ ኡዴዝ</para>
  <para style="q2" vid="ACT 15:18">ጎዳይ፥ ታና› ዬግዛ።<verse eid="ACT 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 15:19"/>«የይ ግሾስ፥ ታ ቆፋይ ጾስኮ ማቄዝ አይሁደ ባዝታ ኑኒ ዋይማይ ጋርከ። <verse eid="ACT 15:19"/><verse number="20" style="v" sid="ACT 15:20"/>ዝን ኡንቲ ኤቃስ ያርሽንቲ ቱኔዝባዝ ማማይ ጋርክ፥ ላግታማይ ጋርክ፥ ባዉታ ማማይ ጋርከኔ ሱ ኡዣምኔ ማማይ ጋርክ ኡንትስ ኑኒ ዳብዳበ ጻፎዳይስ ኮሽዛ።<note caller="-" style="x"><char style="xo" closed="false">15:20 </char><char style="xt" closed="false"><ref loc="EXO 34:15-17">ከስ 34:15-17</ref>፤ <ref loc="LEV 17:10-16">ለዊ. 17:10-16</ref>፤ <ref loc="LEV 18:6-23">18:6-23</ref></char></note> <verse eid="ACT 15:20"/><verse number="21" style="v" sid="ACT 15:21"/>ሙሰ ህጋይ ብንፕ አይኪ ማላጋላስ አይሁደ ዎሳ ኬ ናባብንትዛ ካታማ ኡባይድ ሳባክንትዛ» ዬጌዛ።<verse eid="ACT 15:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22"/>የይፕ ጉየ፥ ሀዋርታይኔ ጭምታይ ዎሳ ኬ አስ ኡባይር ዎላ ፋ ጋንጨፕ ጽቃ አስታ ዶሪ ጳዉሎሳራኔ ባርናባሳራ አንጾካ ዳኮዳይስ ቆፋ አጬዛ። ኡንቲ ኡንደና ኤርንቴዝ ካልዛ ናምኢ አስታ ባርሳባሳ ግንትንትዛ ኤ ይሁዳኔ ስላሰ ዶሬዛ። <verse eid="ACT 15:22"/><verse number="23" style="v" sid="ACT 15:23"/>Ꮊይ ጋርክ ግንትንቲ ጻፍንቴዝ ዳብዳባ ኡንታል አፋ ዳኬዛ፦ «ኑኒ ሀዋርታይኔ ጭምታይ ይ እሽታይ፥ አንጾካ፥ ሶራራኔ ክልቀ የዝ አይሁደ ማቀካ እሽታይስ ኑ ሳሮ ኪቶዳ።<verse eid="ACT 15:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 15:24"/>«ኑኒ ኪተካ አስታይ ኑ ጋንጨፕ Ꮊንጊ፥ ‹ይ ዶካልንቶዳይስኔ ህገ ናጎዳይስ ቤዝዛ ግ› ይንታን ዋይዛኔ ይሎዛ ኑ ስኤዛ። <verse eid="ACT 15:24"/><verse number="25" style="v" sid="ACT 15:25"/>ኑኒ ዶስዛ ባርናባሳኔ ጳዉሎሳ ዶርንቴዝ አሳይር ዎላ ይንትኮ ኪቶዳይስ ፐቲ ዎዝናር ኑ ሙርቴዛ። <verse eid="ACT 15:25"/><verse number="26" style="v" sid="ACT 15:26"/>ኡንቲ ኑ ጎዳ የሱስ ክርስቶሳ ግሾስ ፋ ሸምፖ ኣ እንጌዛ። <verse eid="ACT 15:26"/><verse number="27" style="v" sid="ACT 15:27"/>የይ ግሾስ፥ ኑኒ ጻፌዛና ኡንቲ ፋ ዶናራካ ጉጂ ይንትስ ኦዶዳይ ጋርክ ኤ ይሁዳኔ ስላሰ ኪቴዛ።<verse eid="ACT 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 15:28"/>«Ꮊ ኮሽዝታይፕ አትን ሀራ ቶፎ ይንታን ቶሳማይ ጋርክ ኑኔ ጌሻ አያናይ ሎኦ ቆፋ ማቄዛና በኤዛ <verse eid="ACT 15:28"/><verse number="29" style="v" sid="ACT 15:29"/>ኤቃስ ያርሽንት ቱኔዝባዝ ሚፓተ፥ ሱ ኡዥፓተ፥ ባዉታ ሚፓተ፥ ላግተ አይክፓተ። Ꮊ ኡባይፕ ይ፥ ይንታን ናግኮ ሎኦ ባዝ ኡድዛ። ሳሮ የዞይታ» ዬጌዛ።<verse eid="ACT 15:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 15:30"/>የይ ግሾስ፥ ኪትንቴዝታይ ሞይዝንቲ አንጾካ Ꮊንጊ አማንዛ አስታ ሺሺ፥ ዳብዳበ እንጌዛ። <verse eid="ACT 15:30"/><verse number="31" style="v" sid="ACT 15:31"/>ኡንቲ የ ምን ዳብዳባ ናባቤዛይፕ ኡፋይቴዛ። <verse eid="ACT 15:31"/><verse number="32" style="v" sid="ACT 15:32"/>ማ ኤ ይሁዳኔ ስላሰ ኡ ፋ ኦማስ ናብታ ማቄዝ ግሾስ አማንዝታ ሎእ ዞሪ ምንዛ። <verse eid="ACT 15:32"/><verse number="33" style="v" sid="ACT 15:33"/>ኡንቲ አንጾካ ጽቃ ጋላስ በቴዛይፕ ጉየ እሽታይ ሎኦር ሞይዝን ፋና ኪቴዝታይኮ ማቄዛ። <verse eid="ACT 15:33"/><verse number="34" style="v" sid="ACT 15:34"/><note caller="+" style="f"><char style="fr" closed="false">15:34 </char><char style="ft" closed="false">ፐቲ ፐቲ ኩሸር ጻፍንቴዝ ብኒ ማጻፍታይድ ፓይዶ 34 ባያ።</char></note> [ዝን ስላሰ ኤዛይድ አቶዳይስ ኮዬዛ።]<verse eid="ACT 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 15:35"/>ማ ጳዉሎሳራኔ ባርናባሳር ሀራ ጋመ አስታይር ዎላ ጎዳይ ቃላ ታማርስታራኔ ዎንግለ ኦድታር አንጾካ ጋምኤዛ።<verse eid="ACT 15:35"/></para>
  <para style="s1">ጳዉሎሳ ባርናባሳፕ ሻክንቴዛ</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 15:36"/>ጽቃ ጋላሳፕ ጉየ ጳዉሎሳ ባርናባሳኮ፥ «ኑኒ ጎዳይ ቃላ ኦዴዝ ካታማ ኡቢታይድ አማንዝታይ ዋፋ የዛኮ ጉየ ማቅታር ዎላ በአዳኔ ኤሮዳ» ዬጌዛ። <verse eid="ACT 15:36"/><verse number="37" style="v" sid="ACT 15:37"/>ባርናባሳ ማርቆሳ ግንትንትዛ ዋንሳ ፓር Ꮊንጎዳይ ጋርክ ኮዬዛ። <verse eid="ACT 15:37"/><verse number="38" style="v" sid="ACT 15:38"/>ዝን ጳዉሎሳ ማርቆሳ ፓር Ꮊንጎዳይ ጋርክ ኮየካያ። የይካ፥ ኤ ጵንፍላ ሻክንቲ ኡንታር ኦዳይስ Ꮊንገካ ግሾስ።<note caller="-" style="x"><char style="xo" closed="false">15:38 </char><char style="xt" closed="false"><ref loc="ACT 13:13">ሀዋ. ኦ. 13:13</ref></char></note> <verse eid="ACT 15:38"/><verse number="39" style="v" sid="ACT 15:39"/>ኡ ጋንጨ ኢታ ካቺ ኬዝን ፐታይ ፐታይፕ ሻክንቴዛ። ባርናባሳ ማርቆሳ ኤኪ ማርካበር ቆጲሮሳ ከዜዝ። <verse eid="ACT 15:39"/><verse number="40" style="v" sid="ACT 15:40"/>ዝን ጳዉሎሳ ስላሰና ዶሬዛ፤ አማንዝታይ ጳዉሎሳ ጾስ ኣ ኬሃትይስ ሀዳራ እንጌዛይፕ ጉየ ኤ ቅቴዛ። <verse eid="ACT 15:40"/><verse number="41" style="v" sid="ACT 15:41"/>ዬዚ፥ ዎሳ ኬታ ምንታር ሶራራኔ ክልቃራ ኣዛ።<verse eid="ACT 15:41"/></para>
  <chapter eid="ACT 15"/>
  <chapter number="16" style="c" sid="ACT 16"/>
  <para style="s1">ጽማቶሳ ጳዉሎሳናኔ ስላሰ ሄሌዛ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1"/>ጳዉሎሳ ደርበኔ ልስጽራ ሄሌዛ። ኤዛይድ ጽማቶሳ ግዝ አማንዛ አስ የዛ። ኤ እንዳታካ አማንዛ አይሁደ ማች፥ ኤ አዳይ ግርኬ አሲ። <verse eid="ACT 16:1"/><verse number="2" style="v" sid="ACT 16:2"/>ልስጽራራኔ ኢቆኖነ የዝ አምዝታይ ጽማቶሳ ባጋ ሎእ ማርካቴዛ። <verse eid="ACT 16:2"/><verse number="3" style="v" sid="ACT 16:3"/>ጳዉሎሳ ጽማቶሳ ፓር ካንጎዳይስ ኮዬዛ፥ ኤ አዳይ ግርኬ አስ ማቄዛ የ አቆ የዝ አይሁደ ኡባይ ኤርዛ ግሾስ ኤዛ ዶካሌዛ። <verse eid="ACT 16:3"/><verse number="4" style="v" sid="ACT 16:4"/>ኡንቲ ካታምታይራ Ꮊንግታር የሩሳላመ የዝ ሀዋርታይኔ ጭምታይ አጬዝ ቆፋ አማንዝታይ ናጎዳይ ጋርክ ኡንትስ ኦድታር ኣዛ። <verse eid="ACT 16:4"/><verse number="5" style="v" sid="ACT 16:5"/>የይ ግሾስ፥ ዎሳ ኬታይ አማኖር ምንግታር፥ ፓይዶራካ ጋላስ ጋላስ ጋንጊ ጋንጊ Ꮊንጌዛ።<verse eid="ACT 16:5"/></para>
  <para style="s1">ጳዉሎሳ ማቃዶና Ꮊማዳይ ጋርክ ጼግንቴዛ</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6"/>ኢስያ ቃላ ኦዳማይ ጋርክ ጌሻ አያናይ ኡንታን ካዬዝ ግሾስ ጵርገራኔ ጋላትያ ቢታር ኣዛ። <verse eid="ACT 16:6"/><verse number="7" style="v" sid="ACT 16:7"/>ኡንቲ ሚሳ ዛዋ ሄሌዝ ዎደ ብታና Ꮊማዳይስ ቡትንቴዛ። ዝን የሱሳ አያናይ ኡንታን ካዬዛ። <verse eid="ACT 16:7"/><verse number="8" style="v" sid="ACT 16:8"/>የይ ግሾስ፥ ኡንቲ ሚሳ ካንታር ኣታር ጽሮአዳ ዎዛ። <verse eid="ACT 16:8"/><verse number="9" style="v" sid="ACT 16:9"/>ጳዉሎሳ ቃማ ቆንጭር ፐቲ ማቃዶና አስ ፋኮ፥ «ማቃዶና ፒንጊ ኑና ማዶየ» ዬግታር ኤቂ ዎሶዳር በኤዛ። <verse eid="ACT 16:9"/><verse number="10" style="v" sid="ACT 16:10"/>አጁታ ኤ በኤዛይፕ ጉየ ኤልሲ ኑኒ ማቃዶና Ꮊማዳይስ ኮዬዛ። የይካ፥ ዎንግለ ኤዛይድ የዝ አሳይስ ኦዶዳይስ ጾሳይ ኑና ጼጌዝ አዜዛ።<verse eid="ACT 16:10"/></para>
  <para style="s1">ሊዳ ክርስቶሳ አማኔዛ</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11"/>ጽሮአዳፕ ደንዲ ማርካበ ገሊ ሳሞትራቀ Ꮊንጌዛ፥ ዎንት ጋላስ ናጱለ Ꮊንጌዛ። <verse eid="ACT 16:11"/><verse number="12" style="v" sid="ACT 16:12"/>የይፕ ደንዲ ማቃዶና ቢታ የዝ ፍልጲሶሳ ግዝ ኤርንቴዝ ዎራዳ ካታማ Ꮊንጌዛ። ማ ፍልጲሶሳ ኦሮመ ካታይ ኦላር ሞዴዝ ካታማ። ኑኒ የ ካታማይድ ጽቃ ጋላስ በቴዛ።<verse eid="ACT 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 16:13"/>ማላ ጋላስ ካታማይፕ ጋጻ ቦርካ ካለ አይሁድታይ ጾስ ዎስዛ አቆ የዛና ቆፒ ገድ Ꮊንጌዛ። የ አቃይድ ሺቄዝ ማችታይስ ቃላ ኦዴዛ።<verse eid="ACT 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 16:14"/>ኑና ስእዝ አሳይፕ ፐቲ ሊዳ ግንትንትዛና ትያትሮና ካታማፕ የኤዛ፥ ጾስ አማኔዛ ዞቆ አፍላ ዛልእዛ፥ አስታ የዛ። ጳዉሎሳ ኦድዛ እዛ ስኦዳ ጋርክ ጎዳይ እ ዎዝና ዶዬዛ። <verse eid="ACT 16:14"/><verse number="15" style="v" sid="ACT 16:15"/>ሊዳ ፋ ካራ አሳይር ፐትፕ ጻማቅንቴዛይፕ ጉየ ኑኮ፥ «ይ ታና ጎዳ ቱማ አማኔዛ ጊኮ ታ ካራ ይኢ የዞይታ» ግ ሚን ዎሴዛ።<verse eid="ACT 16:15"/></para>
  <para style="s1">ጳዉሎሳራኔ ስላሰራ አጭንቴዛ</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 16:16"/>ኑኒ ጾሳ ዎስዛ አቃ Ꮊማዳር ኢታ አያና ኢል አፋ የዛና ካዮር ፋ ጎድታይ ጋመ ሚሸ ክእዝ ፐቲ አይላታ ኑና ሄሌዛ። <verse eid="ACT 16:16"/><verse number="17" style="v" sid="ACT 16:17"/>ጳዉሎሳኔ ኑና ካሊ፥ «Ꮊይትታይ ኡባይፕ አፋ ጾስ አይልታ! ኡንቲ ይ አቶዳ ኦጋ ኦድዝታ» ግ ኡኬዛ።<verse eid="ACT 16:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 16:18"/>ኡባ ጋላስ የይ ጋርክ ግዛ። ዝን ጳዉሎሳ ይሎቲ ጉየ ማቂ፥ የ አያና፥ «የሱስ ክርስቶሳ ሱንይር እዝፐ ከዞባ» ግ ኪቴዛ። እዝራካ ኢታ አያናይ እዝፐ ከዜዝ።<verse eid="ACT 16:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 16:19"/>ዝን እ ጎድታይ ኡ ሚሸ ደንግዝ ኦጋይ ቤዛ ብኢ፥ ጳዉሎሳኔ ስላሰ አይኪ፥ አዉዳረ ዳይንታይ ቲና ጎቺ ካንጌዛ። <verse eid="ACT 16:19"/><verse number="20" style="v" sid="ACT 16:20"/>ዳይንታይ ቲና ኡ ካንጊ፥ «Ꮊይትታይ አይሁደ አስ ማቅታር ኑ ካታማ አሳ ኢታ ዋይዛ። <verse eid="ACT 16:20"/><verse number="21" style="v" sid="ACT 16:21"/>ኑኒ ኦሮመ ጋደ አስ ማቆዳር ኤኮዳይስኔ ኦዳይስ ዎጋ ባባዝ ታማርስዛ» ዬጌዛ።<verse eid="ACT 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 16:22"/>አሳይ ፐቲ ባጋ ማቂ፥ ጳዉሎሳል አፋኔ ስላሰል አፋ ደንዴዛ። ዳይንታይ ኡ አፍላ ቃሪ ጉፈር ኡንታን ሾጮዳይ ጋርክ ኪቴዛ። <verse eid="ACT 16:22"/><verse number="23" style="v" sid="ACT 16:23"/>ኡንታን ጋመ Ꮊዛይፕ ጉየ አች ካራ ገልሴዛ። አች ኬ ናግዛይ ኡንታን ሚን ናጎድ ጋርክ ኪቴዛ። <verse eid="ACT 16:23"/><verse number="24" style="v" sid="ACT 16:24"/>አች ካራ ናግዛይ የ ኪታ ኤኪ፥ ጳዉሎሳኔ ስላሰ አች ካራይስ ቆልአ ገልሴዛ። ኡ ቶካ ዱር ዱጼዛ።<verse eid="ACT 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 16:25"/>ዝን ግዲ ብላሄ ማቆዳር ጳዉሎሳራኔ ስላሰራ ዎስታራኔ ማዝሙረ የጽታር ጾሳ ጋላትዛ። አች ካራ የዝ ሀራ አስታይካ ኡንቲ ግዝባዝ ስእዛ። <figure style="fig" alt="Paul and Silas in stocks" file="LB00337B.tif" size="span" ref="16:25">ጳዉሎሳኔ ስላሰ ዱጽንቶ</figure> <verse eid="ACT 16:25"/><verse number="26" style="v" sid="ACT 16:26"/>ቆፐካ አች ካራ ባሳይ ኤንኦድ ሄሎዳይስ ቢታ ኤንኦ ማቄዛ። የ ሳታተካ ፐንገ ኡባይ ዶይንቴዛ፤ አጭንቴዝ አስ ኡባ ሳንላታይ ብልንቲ ዎዛ። <verse eid="ACT 16:26"/><verse number="27" style="v" sid="ACT 16:27"/>አች ካራ ናግዛይ ገንታፕ ባርኮዳር አች ካራ ፐንገ ኡባይ ዶይንቴዛ ብኢ አች አሳይ ከዚ ቅቴዛ ኣዝን ፋና ዎዳይስ ማሻ ኤኬዛ። <verse eid="ACT 16:27"/><verse number="28" style="v" sid="ACT 16:28"/>ዝን ጳዉሎሳ ቃላ ቅ ኡዲ «ኑ ኡባይ Ꮊይዳ የዛ ነና ቆህፐ» ዬጌዛ።<verse eid="ACT 16:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 16:29"/>አች ካራ ናግዛይ ጾምፐ ዎሲ ኤኪ ኤልሲ ጋንጨ ላሲ ኩኮርታር ጳዉሎሳ ቲናኔ ስላሰ ቲና ጹጉኔዛ። <verse eid="ACT 16:29"/><verse number="30" style="v" sid="ACT 16:30"/>ኡንታን ባለ ከሲ፥ «ታ ጎድታዮ፥ ታኒ አቶዳይስ አብ ኡዶዳይስ ቤዜ?» ዬጌዛ።<verse eid="ACT 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 16:31"/>ጳዉሎሳራኔ ስላሰር ኤዝኮ፥ «ጎዳ የሱስ ክርስቶሳ አማኖባ፤ ኔራኔ ነ ካራ አሳይራ አቶዳ» ዬጌዛ። <verse eid="ACT 16:31"/><verse number="32" style="v" sid="ACT 16:32"/>ኡንቲ ኤስኔ ኤ ካራ የዝ ኡባይስ ጎዳይ ቃላ ኦዴዛ። <verse eid="ACT 16:32"/><verse number="33" style="v" sid="ACT 16:33"/>ቃማ የ ሳታተካ አች ካራ ናግዛይ ኡንታን ካንጊ ኡ ሳምባራ ሜጬዛ። ኤልሲ ፋ ካራ አስ ኡባይር ጻማቅንቴዛ። <verse eid="ACT 16:33"/><verse number="34" style="v" sid="ACT 16:34"/>ጳዉሎሳኔ ስላሰ ፋ ካራ ካንጊ ኡንትስ ካ ኣዛ። ኤ ፋ ካራ አስ ኡባይር ጾስ አማኔዝ ግሾስ ኡፋይቴዛ።<verse eid="ACT 16:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35"/>ሳአይ ዎንትን ዳይንታይ፥ «የ አስታ ብልኦባ» ዬጊ ፖልሰ ሀላቅታ ኤዝኮ ኪቴዛ። <verse eid="ACT 16:35"/><verse number="36" style="v" sid="ACT 16:36"/>አች ካራ ናግዛይ፥ «ይ ብልንቶዳይ ጋርክ ዳይንታይ አዛዜዛ። ይኬ፥ ከዚ ሳሮ Ꮊንጎይታ» ዬጊ የ ኪታ ጳዉሎሳስ ኦዴዛ።<verse eid="ACT 16:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 16:37"/>ዝን ጳዉሎሳ የ ፖልሰ ሀላቅታይኮ፥ «ኑኒ ኦሮመ አስ<note caller="+" style="f"><char style="fr" closed="false">16:37 </char><char style="fqa" closed="false">ኦሮመ አስ፦ </char><char style="ft" closed="false">ጳዉሎሳ ፋና ኦሮመ አስ ዬጊ ጼጌዛይ የ ዎደ አይሁደ ቢታ ሃርዛይ ኦሮመ ካተት ማቄዝ ግሾሲ። የ ዎደ ኦሮመ ቢታ የዝ አሳይ ፕርዳ ባይ ጋራፍንቶያ።</char></note> ማቃዳር ኡንቲ ኑና ፕርዳ ባጋ አሳይ ቲና Ꮊ፥ አች ካራ ኦሌዛ። Ꮊት ኑና ጌማር ከዚ ቅቶ ግኔ? ሀነና፥ ኡንቲ ፋ ኦማስ ይኢ ኑና ከሶ» ዬጌዛ።<verse eid="ACT 16:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 16:38"/>ፖልሰ ሀላቅታይ ዳይናይስ የያ ኦድን፥ ጳዉሎሳራኔ ስላሰራ ኦሮመ ጋደ አስ ማቄዛ ስኤዝ ዎደ ያሽቴዛ። <verse eid="ACT 16:38"/><verse number="39" style="v" sid="ACT 16:39"/>የይ ግሾስ፥ ዳይንታይ ይኢ ኡንትኮ፥ «ኑኒ ይንታን ቆሄዛ» ጌዛ። አች ካራፕ ባለ ኡንታን ከሲ፥ ካታማይፕ ከዚ ቅቶዳይ ጋርክ ዎሴዛ። <verse eid="ACT 16:39"/><verse number="40" style="v" sid="ACT 16:40"/>ጳዉሎሳራኔ ስላሰራ አች ካራፕ ከዚ ሊዳ ካራ Ꮊንጌዛ። ኤዛይድ አማንዝታ ሄሊ ኡንታን ምን ከዚ ቅቴዛ።<verse eid="ACT 16:40"/></para>
  <chapter eid="ACT 16"/>
  <chapter number="17" style="c" sid="ACT 17"/>
  <para style="s1">ጳዉሎሳራ ስላሰር ተሰሎንቀ ቅቴዛ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1"/>ጳዉሎሳራኔ ስላሰራ አምፍጶሊናራኔ አጶሎናር ኣ ተሰሎንቀ Ꮊንጌዛ። ኤዛይድ አይሁደ ዎሳ ኬ የዛ። <verse eid="ACT 17:1"/><verse number="2" style="v" sid="ACT 17:2"/>ጳዉሎሳ ካሴሳይ ጋርክ ኤዛይድ ገሌዛ። ኤዛይድ ሀይ ሳምንታ ጾስ ቃላፕ አሳይስ ኦዴዛ። <verse eid="ACT 17:2"/><verse number="3" style="v" sid="ACT 17:3"/>ክርስቶሳ ዋየ ኤኮዳይስኔ Ꮊይቆፕ ደንዶዳይስ ቤዝዛና ኡንትስ ቆንጨር ኦድታር፥ «የሱሳ Ꮊ ታኒ ይንትስ ኦድዛይ ክርስቶሳ» ዬጌዛ። <verse eid="ACT 17:3"/><verse number="4" style="v" sid="ACT 17:4"/>ኡንታፕ ፐታይ ፐታይ ኦዳይ ቱማ ማቄዛና ማኢ ጳዉሎሳራኔ ስላሰራ ቶቤዛ። የይ ጋርከካ፥ ጾሳ ጎይንዛ ጋመ ግርኬ አሳይኔ ጋመ ቦንችንቴዝ ማችታይካ ኡንታር ቶቤዛ።<verse eid="ACT 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 17:5"/>ዝን አይሁድታይ ቅናቲ አዛልዛ ኢታ አስታ ጋበ ኦገፕ ሺሼዛ። ካታማ ጋንጨ ጫቦ መዛ፤ ጳዉሎሳኔ ስላሰ አሳይስ ኣ እማዳይስ ከዚ ያሶነ ካራ ኤልሲ ቅቴዛ። <verse eid="ACT 17:5"/><verse number="6" style="v" sid="ACT 17:6"/>ጳዉሎሳኔ ስላሰ ኡንትስ በንታም እጽን፥ ያሶነኔ እሽታይፕ ፐቲ ፐቲ አማንዝታ ካታማ ሀላቅታይኮ ጎቺ ካንጊ፥ «የይትታይ ቢታ ኡባ ቡቂዝታይ Ꮊት ማ ኑኮ የኤዛ። <verse eid="ACT 17:6"/><verse number="7" style="v" sid="ACT 17:7"/>ያሶነ ኡንታን ፋ ካራ ጋዴዛ። Ꮊይትታይ፥ ‹የሱሳ ግዝ ሀራ ካታይ የዛ› ግ ቄሳረ ኪታ እጽዝታ» ዬጊ ኡኬዛ።<verse eid="ACT 17:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 17:8"/>ሺቄዝ አሳይኔ ካታማ ሀላቅታይ የያ ስእን ኤዝስ ሀኖድ ባዝ ቤዛ። <verse eid="ACT 17:8"/><verse number="9" style="v" sid="ACT 17:9"/>ሀላቅታይ ያሶናኔ ሀርታ ዋሰር ብልኤዛ።<verse eid="ACT 17:9"/></para>
  <para style="s1">ጳዉሎሳኔ ስላሰ ቤራ ጋደ ታማርሴዛ</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 17:10"/>አማንዝታይ ጳዉሎሳኔ ስላሰ ቃማር ቤራ ዳኬዛ። ቤራ ሄሊ፥ አይሁደ ዎሳ ኬ ገሌዛ። <verse eid="ACT 17:10"/><verse number="11" style="v" sid="ACT 17:11"/>ቤራ አስታይ ተሰሎንቀ አስታይፕ ኣዝ ዎዝና ሉልታ። ኡንቲ ቃላ ኩን ዎዝናፕ ኤኬዛ፤ ጋላስ ጋላስ ጌሻ ማጻፍታ ናባብታር ጳዉሎሳ ጌዛይ ቱማ ማቄዛና ሻኪ ኤሬዛ። <verse eid="ACT 17:11"/><verse number="12" style="v" sid="ACT 17:12"/>የይ ግሾስ፥ ኡንታፕ ጋምታይ፥ ግርክታይፐካ ቦንችንቴዝ ጽቃ ማችታይኔ ራታይ አማኔዛ።<verse eid="ACT 17:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 17:13"/>ዝን ተሰሎንቀ የዝ አይሁድታይ ጳዉሎሳ ጾስ ቃላ ቤራ ጋደካ ኦዴዛና ስኢ ቤራ ይኢ አሳ ቡቄዛ። <verse eid="ACT 17:13"/><verse number="14" style="v" sid="ACT 17:14"/>የይፕ ጉየ፥ አማንዝታይ ኤልሲ ጳዉሎሳ አባ ካለ ዳኬዛ። ዝን ስላሰኔ ጽማቶሳ ቤራ አቴዛ። <verse eid="ACT 17:14"/><verse number="15" style="v" sid="ACT 17:15"/>ጳዉሎሳና ሞይዜዝ አሳይ አቴና ሄል አሼዛ። የ አሳይ ስላሰኔ ጽማቶሳ ኡንትስ ዳንዳእንትኮ ኤልሲ ፋኮ የኦድ ጋርክ ጳዉሎሳ ኪቴዝ ኪታ ኤኪ ቤራ ማቄዛ።<verse eid="ACT 17:15"/></para>
  <para style="s1">ጳዉሎሳ አቴና ቢታል</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16"/>ጳዉሎሳ አቴና ስላሰናኔ ጽማቶሳ ናግታር፥ ካታማይ ኤቃር ኩሜዛና ብኢ ሸንቴዛ። <verse eid="ACT 17:16"/><verse number="17" style="v" sid="ACT 17:17"/>የይ ግሾስ፥ አይሁደ ዎሳ ኬ አይሁድታይራኔ ጾሳ ጎይንዛ አይሁደ ማቀካ አሳይር ማ ጋበላካ ፋና ሄሌዝ አሳይር ኡባ ዎደ ፓላምዛ። <verse eid="ACT 17:17"/><verse number="18" style="v" sid="ACT 17:18"/>ኤጲቆሮሳ ባጋፐኔ ኢስቶይካንታ ግንትንትዝ ኤራንችታይፕ ፐታይ ፐታይ ጳዉሎሳር ፓላሜዛ። ኡንታፕ ፐታይ ፐታይ፥ «Ꮊ ዶናንቻይ አብ ኦዶዳይስ ኮይነሻ?» ዬጌዛ።</para>
  <para style="p" vid="ACT 17:18">Ꮊንክታይ ጳዉሎሳ የሱሳኔ Ꮊይቆፕ ደንዶ ባጋ ኡንትስ ኦዴዝ ግሾስ «ኦሮ ኤቅታይ ባጋ ኦድዝ ኣዝዛ» ዬጌዛ።<verse eid="ACT 17:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 17:19"/>ጳዉሎሳ አይኪ አርዮስፓጎሳ ግንትዝ ሺቆ አቃ ካንጊ፥ «Ꮊ ኔኒ ታማርስዛ ኦሮባዛይ አብዛኮ ኑና ኤርሳሞ? <verse eid="ACT 17:19"/><verse number="20" style="v" sid="ACT 17:20"/>አብስ ጊኮ፥ ኔኒ ኑስ ኦሮባዝ ኦድዛይ፤ አብዛኮ ኑኒ ኤሮዳይስ ኮይዛ» ዬጌዛ። <verse eid="ACT 17:20"/><verse number="21" style="v" sid="ACT 17:21"/>አቴና አስ ኡባይኔ ኤዛይድ የዝ እማታይ ኦሮባዝ ኦድንተካዛራኔ ስኤካ ፔዦያ።<verse eid="ACT 17:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 17:22"/>ጳዉሎሳ አርዮስፓጎሳ ሺቄዝ አሳይ ቲና ኤቂ፥ «አቴና አሳዮ፥ ይ ጾስታይስ ኡባ ባዛር ጋመ ያሽትዛ ታኒ ብእዛ። <verse eid="ACT 17:22"/><verse number="23" style="v" sid="ACT 17:23"/>ታኒ ይ ካታማይር ዩይታር ይ ጎይንዛ አቅታ በአዳር ‹ኤርንቶዋ ጾስስ› ግንትንቲ ጻፍንቴዝ ያርሾ አቆ ደንጌዛ። Ꮊ ይ ኤረካዛር ጎይንዛና ታኒ ይንትስ ኦድዛ። <verse eid="ACT 17:23"/><verse number="24" style="v" sid="ACT 17:24"/>ሳአኔ ሳአል የዝ ኡባ ባዝ መዝ ጾሳይ፥ ሳሎኔ ሳአ ጎዳይ፥ አሲ ኬጼዝ ኬ የዞያ።<note caller="-" style="x"><char style="xo" closed="false">17:24-25 </char><char style="xt" closed="false"><ref loc="1KI 8:27">1ካት. 8:27</ref>፤ <ref loc="ISA 42:5">ኢሳ. 42:5</ref>፤ <ref loc="ACT 7:48">ሀዋ. ኦ. 7:48</ref></char></note> <verse eid="ACT 17:24"/><verse number="25" style="v" sid="ACT 17:25"/>ኤ ደኦኔ፥ ሸምፖኔ ኡባ ባዝ አስ ኡባይስ እንግዛ ግሾስ ፓጨ የዝ አስ ጋርክ አስ ማዴ ኮዮያ። <verse eid="ACT 17:25"/><verse number="26" style="v" sid="ACT 17:26"/>አሲ የዞድ ዎዳይስኔ አቃይስ ዛዋ እንጌዛ። ጾሳይ አስ ዘር ኡባ ፐቲ አይፕ መ ቢታ ኡባይድ ጋዴዛ። <verse eid="ACT 17:26"/><verse number="27" style="v" sid="ACT 17:27"/>ኤ የያ ኦዛይ አሲ ኤዛ ኮዮዳይ ጋርከኔ ኮዪ ደማዳይ ጋርከሲ። ሀንኮካ ኤ ኑፕ ሃከካያ። <verse eid="ACT 17:27"/><verse number="28" style="v" sid="ACT 17:28"/>ይንትፕ ፐቲ ፐቲ የጽዝታይ፥ ‹ኑኒ ኤ ናእታ› ጌዛይ ጋርክ፥ ኑኒ ኤዛይድ ፓ የዚ፥ ኤንእዛ። <verse eid="ACT 17:28"/><verse number="29" style="v" sid="ACT 17:29"/>ይኬ፥ ኑኒ ጾስ ናእታ ማቅዝ ግሾስ ‹ጾሳይ አስ ኤጨትራኔ ቆፋር ዎርቃፕ ዎይ ብራፕ ዎይ ሹቻፕ ኦስንቴዝባዝ ኣዝዛ› ዬጊ ቆፖዳይስ ቤዞያ። <verse eid="ACT 17:29"/><verse number="30" style="v" sid="ACT 17:30"/>የይ ግሾስ፥ ጾሲ ቲና አሳይ ኤረካ ኦዛና አሺ ኣዛ፥ ዝን Ꮊት ኡባ አቆ የዝ አስ ኡባይ ናጋራፕ ማቆዳይ ጋርክ አዛዝዛ። <verse eid="ACT 17:30"/><verse number="31" style="v" sid="ACT 17:31"/>አብስ ጊኮ፥ ጾሲ ፋ ዶሬዝ አይር ሳአል የዝ አስ ኡባይል አፋ ጽሎ ፕርዳ ፕርዶዳይስ ቃማ ጊግሲ ጋዴዛ። ኤዛ Ꮊይቆፕ ደን የያ አስ ኡባይስ ቱማሴዛ» ዬጌዛ።<verse eid="ACT 17:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 17:32"/>ኡንታፕ ፐቲ ፐቲ አስታይ Ꮊይቆፕ ደንዶ ባጋ ጳዉሎሳፕ ስኢ፥ ኤዛል አፋ አርኤዛ። ዝን Ꮊንክታይ፥ «ኑኒ የያ ኔፕ ጉጂ ስኦዳይስ ኮይዛ» ዬጌዛ። <verse eid="ACT 17:32"/><verse number="33" style="v" sid="ACT 17:33"/>የይ ግሾስ፥ ጳዉሎሳ ኡ ጋንጨፕ ከዜዝ። <verse eid="ACT 17:33"/><verse number="34" style="v" sid="ACT 17:34"/>ዝን ፐቲ ፐቲ ታይ ጳዉሎሳ ሄሊ አማኔዛ። ኡ ጋንጨፕ አርዮስፓጎሳ ፕርደ ዳይና ድዮናሶሳ ግንትዝ አስታ፥ ዳማርሶ ግንትዝ ፐቲ አስትኔ Ꮊንክታይ የዛ።<verse eid="ACT 17:34"/></para>
  <chapter eid="ACT 17"/>
  <chapter number="18" style="c" sid="ACT 18"/>
  <para style="s1">ጳዉሎሳ ቆሮንቶሳ ቅቴዛ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 18:1"/>የይፕ ጉየ፥ ጳዉሎሳ አቴናፕ ከዚ፥ ቆሮንቶሳ ቅቴዛ። <verse eid="ACT 18:1"/><verse number="2" style="v" sid="ACT 18:2"/>ኤዛይድ አቂላ ግንትዝ ጳንጾሳ የልንቴዝ ፐቲ አይሁደ አስ ደንጌዛ። አይሁደ አስ ኡባይ ኦሮመፐ ከዞዳይ ጋርክ ካታይ ቃላዉዶሳ ኪቴዝ ግሾስ ጽቃ ዎደፕ ቲና ኤ ፋ ማቻት ጵርስቅላር ኢጻለፕ የኤዛ። ጳዉሎሳ ኡንታን ሄሎዳይስ የኤዛ። <verse eid="ACT 18:2"/><verse number="3" style="v" sid="ACT 18:3"/>ኤ ኦሳይ ኡንቲሳይ ጋርክ ዱንካነ ስኮ ማቄዝ ግሾስ ኡንታር በቲ ዎላ ኦዛ። <verse eid="ACT 18:3"/><verse number="4" style="v" sid="ACT 18:4"/>ጳዉሎሳ ማላ ጋላስ ኡባይድ አይሁድታኔ ግርክታ አማንዳይስ አይሁደ ዎሳ ኬ ኡንታር ኦድንትዛ።<verse eid="ACT 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 18:5"/>ስላሰኔ ጽማቶሳ መቅዶናፕ ይእን ጳዉሎሳ ፋ ዎደ ኡባ እንጊ አይሁድታይስ የሱሳ ኤ፥ ክርስቶሳ ግ አዛላ ባይ ማርካትታር ቃላ ኦዴዛ። <verse eid="ACT 18:5"/><verse number="6" style="v" sid="ACT 18:6"/>ዝን ኡንቲ ጳዉሎሳና እጺ ኤዛ ጫዥን ጳዉሎሳ ፋ አፍላይፕ ቡልአ ትቂስታር፥ «ይ ሱይስ ይንታን ኦይጮ፤ ታኒ Ꮊንፕ ጌሽ። Ꮊንፕ ማቂ፥ ታኒ አይሁደ ማቀካ አሳይኮ Ꮊማዳ» ዬጌዛ።<verse eid="ACT 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 18:7"/>የይፕ ከዚ ጾስ ጎይንዛ ትቶሳ ዮስጾሳ ግዝ አይ ካራ Ꮊንጌዛ። ዮስጾሳ ካራይ አይሁደ ዎሳ ኬይ ካለ የዛ። <verse eid="ACT 18:7"/><verse number="8" style="v" sid="ACT 18:8"/>አይሁደ ዎሳ ኬ ሀላቃይ ቃርስጶሳ ፋ ካራ አስ ኡባይር ጎዳ አማኔዛ። ቆሮንቶሳ አስታይፐካ ጋምታይ ጾስ ቃላ ስኤዝ ዎደ አማኒ ጻማቅንቴዛ።<verse eid="ACT 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 18:9"/>ጎዳይ ፐቲ ቃማ ጳዉሎሳስ ቆንጭር ይኢ፥ «ያሽትፐ፤ ኦዶባፕ አትን ስእ ጊፐ። <verse eid="ACT 18:9"/><verse number="10" style="v" sid="ACT 18:10"/>ታኒ ኔር የዛ። ታስ Ꮊ ካታማይድ፥ ጋመ አስ የዝ ግሾስ ነና ቆህ ኢታ ባዝ ኦድ አስ ኦንካ ባያ» ዬጌዛ። <verse eid="ACT 18:10"/><verse number="11" style="v" sid="ACT 18:11"/>የይ ግሾስ፥ ጳዉሎሳ ጾስ ቃላ አሳ ታማርስታር ፐቲ ላይኔ ኡሱፑን አጌና ኡንታር በቴዛ።<verse eid="ACT 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12"/>ጋሎሳ አካያ ቢታ አቅሶዳር አይሁድታይ ፐትፕ ጳዉሎሳል አፋ ደንዲ ፕርደ ኬ ካንጊ፥ <verse eid="ACT 18:12"/><verse number="13" style="v" sid="ACT 18:13"/>«Ꮊ አይ ህገ እጺ፥ አሳይ ጾስ ጎይኖዳይ ጋርክ ኡድዛ» ዬጌዛ።<verse eid="ACT 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 18:14"/>ጳዉሎሳ ናሾድ ሀኖዳር፥ ጋሎሳ አይሁድታይኮ፥ «አይሁድታዮ፥ የይ ኢታ ኦሶ ዎይ ናቆ ማቄዛኮ ታኒ ይ ባጋ ዳንዳእ ስኦዳይስ ቤዝዛ። <verse eid="ACT 18:14"/><verse number="15" style="v" sid="ACT 18:15"/>ዝን ቃላስ፥ ይ ሱንይስኔ ይ ህጋይስ ይ ፓላምዛ ባዝ ማቅኮ ይ፥ ይንትስ ብሎይታ፤ የያ ታኒ ፕርዳሚ» ዬጌዛ። <verse eid="ACT 18:15"/><verse number="16" style="v" sid="ACT 18:16"/>ዬዚ፥ ኡንታን ፕርዳ ኬይፕ ባለ ከሴዛ። <verse eid="ACT 18:16"/><verse number="17" style="v" sid="ACT 18:17"/>የይፕ ጉየ፥ አስ ኡባይ አይሁደ ዎሳ ኬ ሀላቃ ሶስቴንሳ አይኪ ፕርደ ኬ ቲና Ꮊዛ። ዝን ጋሎሳስ የይ አብካ ኣዘካያ።<verse eid="ACT 18:17"/></para>
  <para style="s1">ጳዉሎሳ አንጾካ ማቄዛ</para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18"/>ጳዉሎሳ ጋመ ጋላስ ቆሮንቶሳ በቴዛይፕ ጉየ አማንዛ አሳ ሳሮ፥ ጵርስቅልራኔ አቂላራ ማርካበር ሶራ Ꮊንጌዛ። ዝን ኤ Ꮊንጎዳይፕ ቲና ኤስ ጋ የዝ ግሾስ ክንክሮሳ ካታማይድ ፋ ኦማ ሜዴዛ።<note caller="-" style="x"><char style="xo" closed="false">18:18 </char><char style="xt" closed="false"><ref loc="NUM 6:18">ታይ. 6:18</ref></char></note> <verse eid="ACT 18:18"/><verse number="19" style="v" sid="ACT 18:19"/>ኡንቲ ኤፈሶነ ሄሊ ጳዉሎሳ ጵርስቅላኔ አቂላ ኤዛይድ አሼዛ። ዝን ፓስ አይሁደ ዎሳ ኬ ገሊ አይሁድታይራ ኦድንቴዛ። <verse eid="ACT 18:19"/><verse number="20" style="v" sid="ACT 18:20"/>ኡንቲ ፓር ጋመ ዎደ በቶዳይ ጋርክ ጳዉሎሳና ዎሴዛ ዝን ኤ እጼዛ። <verse eid="ACT 18:20"/><verse number="21" style="v" sid="ACT 18:21"/>ኡንታፕ ሻክንቲ፥ «ጾሲ ጊኮ ይንትኮ ማቂ የኦዳ» ዬጊ ኤፍሶነፕ ማርካበር ደንዴዛ። <verse eid="ACT 18:21"/><verse number="22" style="v" sid="ACT 18:22"/>ቅሳረ ሄሊ የሩሳላመ Ꮊንጊ ዎሳ ኬ አሳይ ሳሮዛይፕ ጉየ አንጾካ ቅቴዛ።<verse eid="ACT 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 18:23"/>ኤዛይድ ጽቃ ዎደ ጋምኤዛይፕ ጉየ ታማርታ አስታ ኡባ ምንታር ጋላትያራኔ ጵርገር ኣዛ።<verse eid="ACT 18:23"/></para>
  <para style="s1">አጵሎሳ ኤፈሶናላኔ ቆሮንቶሳላ</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 18:24"/>ኢስክንድረ የለታ ማቄዝ ፐቲ አጵሎሳ ግዝ አይሁደ አስ ኤፈሶነ ቅቴዛ። ኤ ኦዳ ኤርዛ አስኔ ጾስ ቃላ ሎእ ኤርዛ አሲ። <verse eid="ACT 18:24"/><verse number="25" style="v" sid="ACT 18:25"/>ኤ ጎዳ ኦጋ ታማሪ፥ አያናር ጹግንቲ የሱሳ ባጋ ሉለ ኦድዛኔ ታማርስዛ። ሀኖ ዝን፥ ዋንሳ ጽንቃታ ኣዳ ኤርዛ። <verse eid="ACT 18:25"/><verse number="26" style="v" sid="ACT 18:26"/>ኤ አይሁደ ዎሳ ኬ ያሽተካዛር ታማርሴዛ። ጵርስቅላኔ አቂላ ኤ ኦድዛና ስኢ ኤዛ ፓር ካራ ካንጊ ጾሳ ኦጋ ቲናሳይፕ ኣ ኤስ ኦዴዛ።<verse eid="ACT 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 18:27"/>አጵሎሳ አካዛ Ꮊማዳይስ ኮይን ኤፈሶና የዝ አማንዛ አሳይ ኤ ቆፋ ኤኪ አካያ የዝ አማንዝታይ ኤዛ ሞኮዳይ ጋርክ ኡንትስ ዳብዳበ ጻፌዛ። ኤ ኤዛይድ ሄሊ ጾስ ኣ ኬሄትር የሱስ ክርስቶሳ አማኔዝታ ጋመ ማዴዛ። <verse eid="ACT 18:27"/><verse number="28" style="v" sid="ACT 18:28"/>የሱሳ ኤ ክርስቶሳ ማቄዛና አይሁድታይስ ጾስ ቃላይፕ ቆንጭሲ ዎያ ኡባይ ቲና ሚን ታማርሴዛ።<verse eid="ACT 18:28"/></para>
  <chapter eid="ACT 18"/>
  <chapter number="19" style="c" sid="ACT 19"/>
  <para style="s1">ጳዉሎሳ ኤፈሶና ቅቴዛ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 19:1"/>አጵሎሳ ቆሮንቶሳ የዝን፥ ጳዉሎሳ ዎክ ባጋ ጋደር ኣ ኤፈሶነ ሄሌዛ። ኤዛይድ ፐቲ ፐቲ አማንዛ አስታ ደንጌዛ። <verse eid="ACT 19:1"/><verse number="2" style="v" sid="ACT 19:2"/>ኡንታናካ፥ «ይ አማኔዝ ዎደ ጌሻ አያና ኤኬኔ?» ዬጊ ኦይጬዛ።</para>
  <para style="p" vid="ACT 19:2">ኡንቲ፥ «ዋኣ፥ ኤከካያ፤ ሀራ አቶዝን፥ ጌሻ አያና የዛናካ ኑ ስኤካያ» ዬጌዛ።<verse eid="ACT 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 19:3"/>ጳዉሎሳ ኡንትኮ፥ «የዝን፥ ይ አባር ጻማቅንቴኔ?» ዬጌዛ።</para>
  <para style="p" vid="ACT 19:3">ኡንቲ፥ «ኑኒ ዋንሳ ጽንቃታ ጻማቅንቴዛ» ዬጊ ማሄዛ።<verse eid="ACT 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 19:4"/>ጳዉሎሳ፥ «ዋንሳ ፓፕ ጉየር ይእዝ የሱስና አሳይ አማኖዳይ ጋርክ አሳይስ ኦድታር፥ ማሮትስ ቤዝዛ ጽንቃታ ጻማቄዛ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">19:4 </char><char style="xt" closed="false"><ref loc="MAT 3:11">ማቶ. 3:11</ref>፤ <ref loc="MRK 1:4">ማር. 1:4</ref>፥ <ref loc="MRK 1:7-8">7-8</ref>፤ <ref loc="LUK 3:4">ሉቃ. 3:4</ref>፥ <ref loc="LUK 3:16">16</ref>፤ <ref loc="JHN 1:26-27">ዋን. 1:26-27</ref></char></note><verse eid="ACT 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 19:5"/>ኡንቲ የያ ስኢ ጎዳ የሱሳ ታማርታ ማቆዳይስ ኤ ሱንር ጻማቅንቴዛ ጋላስ ጋላስ ጌሻ ማጻፍታ ናባብዛ። <verse eid="ACT 19:5"/><verse number="6" style="v" sid="ACT 19:6"/>ጳዉሎሳ ፋ ኩሻ ኡንታል አፋ ጋድን ጌሻ አያና ኡንታል አፋ ዎን፥ ዱማ ዱማ ዶናር ኦድንቴዛ፤ ማ ትንቢተ ኦዴዛ። <verse eid="ACT 19:6"/><verse number="7" style="v" sid="ACT 19:7"/>የ አቃይድ ታጶ ናምኤ ማቅዝ አስታይ የዛ።<verse eid="ACT 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 19:8"/>ጳዉሎሳ አይሁደ ዎሳ ኬ ገሊ፥ ጾስ ካተት ባጋ ያሽተካዛር ፓላምታራኔ ሎእ ቆንጭስታር ኡንታር ሀይ አጌና ሄሎዳይስ ጋምኤዛ። <verse eid="ACT 19:8"/><verse number="9" style="v" sid="ACT 19:9"/>ዝን ኡንታፕ ፐታይ ፐታይ በ ማቂ ጋመ አሳይ ቲና ጎዳይ ኦጋ ጫዢ አማናም እጼዛ። ጳዉሎሳ አማንዝታ ኡንታፕ ሻጊ ኤኪ ጽራኖሳ ግዝ ትምርተ ኬ ኡባ ዎደ ኡንታን ታማርሴዛ። <verse eid="ACT 19:9"/><verse number="10" style="v" sid="ACT 19:10"/>ጳዉሎሳ ናምኢ ላይ ሄሎዳይስ ቃላ ኦዴዛ። የይ ግሾስ፥ ኢስያ የዝ አስ ኡባይ፥ አይሁድታይኔ አይሁደ ባዝታይ ጎዳይ ቃላ ስኤዛ።<verse eid="ACT 19:10"/></para>
  <para style="s1">ጾሳይ ጳዉሎሳ ኩሸ ኦዝ ማላትታ</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 19:11"/>ጾሳይ ጳዉሎሳ ኩሸ ዎልቃማ ማላባዝታ ኦዛ። <verse eid="ACT 19:11"/><verse number="12" style="v" sid="ACT 19:12"/>የይ ግሾስ፥ አሳይ ኤ ጋላ ቦቼዝ ማራበ ዎይ ማኦ ሀርግንቴዝ አሳይስ ካንግዛ። ኡንትካ ፓጽዛ፤ ቱና አያንታይካ ኡንታፕ ከዝዛ።<verse eid="ACT 19:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 19:13"/>ቱና አያንታ ከስታር ዩይዛ አይሁድታይፕ ፐታይ ፐታይ፥ «ጳዉሎሳ ሳባክዛ የሱሳ ሱንይር ከዞይታ ግ ይንታን አዛዝዛ» ዬጊ፥ ቱና ጋለንታይ አይኬዝ አስታይል አፋ ጎዳ የሱሳ ሱን ጼጌዛ <verse eid="ACT 19:13"/><verse number="14" style="v" sid="ACT 19:14"/>አይሁደ ቄሰ ሀላቅታይፕ ፐታ ማቄዝ አስቄዋ ግንትዝ አይስ የያ ኦዛ ላፑን ራ ናእታይ የዛ።<verse eid="ACT 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 19:15"/>ዝን ቱና አያናይ ኡንትኮ፥ «ታኒ የሱሳካ ጳዉሎሳ ባጋካ ኤርዛ፥ ዝን ይንቲ ኦናንታራ?» ዬጌዛ።<verse eid="ACT 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 19:16"/>ቱና አያና አይኬዝ አይ ኡንታል አፋ ዶንጊ ዎ፥ ኡንታል ማዶ ከሲ፥ የ ካርትፕ ካሎ ላሲ ቦድ ሄሎዳይስ ዎልቃሚ ጋሜዛ። <verse eid="ACT 19:16"/><verse number="17" style="v" sid="ACT 19:17"/>ኤፈሶና የዝ አይሁድታይኔ አይሁደ ባዝታይ ኡባይ የያ ስኢ ኢታ ያሽቴዛ። ጎዳ የሱሳ ሱንይ ጋመ ቦንችንቴዛ። <verse eid="ACT 19:17"/><verse number="18" style="v" sid="ACT 19:18"/>አማንዝታይፕ ጋምታይ ፋ ኦዝ ኢታ ኦሳ ቡጽታራኔ ቆንጨ ኦድታር ይእዛ። <verse eid="ACT 19:18"/><verse number="19" style="v" sid="ACT 19:19"/>ሙሩንታይፕ ጋምታይ ፋ ማጻፍታ ሺሺ አስ ኡባይ ቲና ምቼዛ። የ ማጻፍታይ ዋጋይ ዋጋይ እሻታም ሙኩለ ብራ<note caller="+" style="f"><char style="fr" closed="false">19:19 </char><char style="fqa" closed="false">ሹች ብራ፦ </char><char style="ft" closed="false">ማቶሳ 26:15 ቦኦይታ።</char></note> ማቄዛ። <verse eid="ACT 19:19"/><verse number="20" style="v" sid="ACT 19:20"/>የይ ጋርክ ሀኒ ጾስ ቃላይ ዎልቃር ድጭታራኔ ዳልግታር ቅቴዛ።<verse eid="ACT 19:20"/></para>
  <para style="s1">ኤፈሶነ ካታማ ጫቦት ደንዴዛ</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 19:21"/>የይ ፖልንቴዛፕ ጉየ ጳዉሎሳ፥ «ታኒ የሩሳላመ ማቂ ኦሮመ Ꮊማዳይስ ቤዝዛ» ዬጊ ማቃዶናራኔ አካያራ ኣ የሩሳላመ Ꮊማዳይስ ቆፋ አጬዛ። <verse eid="ACT 19:21"/><verse number="22" style="v" sid="ACT 19:22"/>ማ ፋና ማድዝታይፕ ናምእታ ጽማቶሳኔ ኤራስጾሳ ማቃዶና ኪቲ፥ ፓስ ኢስያ ጽቃ ዎደ ጋምኤዛ።<verse eid="ACT 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 19:23"/>የ ዎደ Ꮊ ኦጋይ ግሾስ ኢታ ካቺ ከዜዝ። <verse eid="ACT 19:23"/><verse number="24" style="v" sid="ACT 19:24"/>ፐቲ ብራ ኦዝ ድመጽሮሳ ግንትዝ አይ አርጸምሳ ኤቃ ካራ ምስለ ብራፕ መ ጋመ ዎ ደንግዛዝን። <verse eid="ACT 19:24"/><verse number="25" style="v" sid="ACT 19:25"/>የይ ግሾስ፥ የይ ጋርክ ኦሶ ኦዝታ ፐትፕ ሺሺ፥ «አሳዮ፥ ኑ ዱረትይ Ꮊ ኦሳይፕ ማቄዛና ይ ኤርዛ። <verse eid="ACT 19:25"/><verse number="26" style="v" sid="ACT 19:26"/>ጳዉሎሳ፥ Ꮊይ ‹አስ ኩሸ ኦስንቴዝታይ ጾስ ባያ› ዬጊ፥ ኤፈሶናራኔ ጽቃ ቢትታይፕ አትን ሙመ ኢሳ ቢታ ኡባይል የዝ ጋመ አሳይስ ኦዲ አማንዛኔ ማሄዛ ይ በኤዛኔ ስኤዛ። <verse eid="ACT 19:26"/><verse number="27" style="v" sid="ACT 19:27"/>መቶ ማቄዛይ፥ ኑ ኦሳይ ለቅንቴዝታ ኣዳ ባዝን ኢሳኔ ጋደ ኡባይል የዝ አስ ጎይንዛ ግታ ጾስኔ አርጸምሳ <figure style="fig" alt="Artemis" file="HK00286B.tif" size="span" ref="19:25">ኣርጽምሰ</figure>ካራይ ኦድንተካ አቶዳይኔ ኤ ዳሞትይካ ዎዳይ ያሽዛ» ዬጌዛ።<verse eid="ACT 19:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 19:28"/>አሳይ የያ ስኢ ሸነር ኩሚ፥ «ኤፍሶና አርጸምሳ ባይራ» ዬጊ ኡኬዛ። <verse eid="ACT 19:28"/><verse number="29" style="v" sid="ACT 19:29"/>የ ኡፋይ ካታማ ኡባ ሄሌዛ። ጳዉሎሳ ላግታ ማቃዶና አስታ፥ ጋዮሳኔ አርስጽሮኮሳ ኡንታር ዎላ ዳፍ ኤኪ ካእዛ አቃ ዎጼዛ። <verse eid="ACT 19:29"/><verse number="30" style="v" sid="ACT 19:30"/>ጳዉሎሳካ አሳይ ሺቄዝ አቆ ገሎዳይስ ኮዬዛ፥ ዝን አማኔዝታይ ኤዛ ካዬዛ። <verse eid="ACT 19:30"/><verse number="31" style="v" sid="ACT 19:31"/>ኢሳ ቢታ ሀላቅታይፕ ጳዉሎሳስ ዣመ ማቄዝ ፐታይ ፐታይ ጳዉሎሳኮ ኪቲ፥ «ካእዛ አቆ ቆንጨር ከዚ በንትፐ» ግ ኤዛ ዎሴዛ።<verse eid="ACT 19:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 19:32"/>ሺቄዝ አሳይስ ሀኖድ ባዝ ቤዛ፤ ጋንግዛ ባጋ አሳይ ሀራ አቶዝን አብስ ሺቄዛኮ ኤረካዛይ ግሾስ ፐታይ ፐትባዝ ግ ኡክዛ ማ Ꮊንክታይ ሀራ ባዝ ግ ኡክዛ። <verse eid="ACT 19:32"/><verse number="33" style="v" sid="ACT 19:33"/>አይሁድታይ ኢስክንድሮሰ ግዝ አ ዎያ ጋንጨፕ ቲና ኡርቄዝ፥ ፐቲ ፐቲ አሳይ ኤ ጎድባዛ ኦድን ኤዚ አሳይ ስእ ጎዳይ ጋርክ ፋ ኩሻይር ማሊ ቤዚ፥ አሳይስ ሞትንቶዳይስ ኤቄዛ። <verse eid="ACT 19:33"/><verse number="34" style="v" sid="ACT 19:34"/>ዝን ኢስክንድረ አይሁደ አስ ማቄዝ አሳይ ኤሪ ናምኢ ሳተ ማቆድ ሄሎዳይስ ኡባይ ፐቲ ቃላር፥ «ኤፈሶና አርጸምሳ ዳማ» ዬጊ ኡኬዛ።<verse eid="ACT 19:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 19:35"/>ዉርስ የ ካታምቲ ጻፋይ ዎያ ስኢ ኡዲ፥ «ኤፈሶና አሶ! ኤፈሶና ካታማይ ግታ አርጸሚሳስ ኤቃ ካራኔ ሳሎፕ ዎዝ፥ ግታ ሹች ናግዛ ማቄዛና ኤሮዋ አስ ኦኖ? <verse eid="ACT 19:35"/><verse number="36" style="v" sid="ACT 19:36"/>Ꮊያ ላህዛ አስ ባ ማቅኮ ይ ስእ ጎዳይስነ ኤልሲ እታ ባዝ ኦፕ ናግንቶዳይስ ቤዝዛ። <verse eid="ACT 19:36"/><verse number="37" style="v" sid="ACT 19:37"/>ይ Ꮊ አስታ፥ ኤቃ ኬ ሚሸ ካስተካዝታኔ ኑ ጾስታ ጫዢ በኤካዝታ ከኤዛ። <verse eid="ACT 19:37"/><verse number="38" style="v" sid="ACT 19:38"/>የይ ግሾስ፥ ድመጽሮሳኔ ኤዛር የዝ ኦሳንችታይ ኦራካ ሞትንቶ ኮይኮ፥ ፕርደ ኬ የዛ፤ ዳይንታይካ የዛ፤ ኡ ሞቶዳይስካ ዳንዳእዛ። <verse eid="ACT 19:38"/><verse number="39" style="v" sid="ACT 19:39"/>ዝን ይ ሀራ ኦዳ ኮይኮ፥ ሻንጎ ሺቆል ኦዳይ ብእንቶ። <verse eid="ACT 19:39"/><verse number="40" style="v" sid="ACT 19:40"/>የይ ማቃም እጽኮ Ꮊይኖ ሀኔዝባዛይስ ኦሮመ ካተትይ ኑና ኦይጮዳ። Ꮊ ቡቅይስ ጋሶ ባ ግሾስ ኑኒ ማልሰ ማሆዳይስ ዳንዳኦያ» <verse eid="ACT 19:40"/><verse number="41" style="v" sid="ACT 19:41"/>ዬጊ ሺቃ ላሌዛ።<verse eid="ACT 19:41"/></para>
  <chapter eid="ACT 19"/>
  <chapter number="20" style="c" sid="ACT 20"/>
  <para style="s1">ጳዉሎሳ ማቃዶናኔ ግርኬ ቅቴዛ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1"/>ጫቦትይ ሀይዜዝን ጳዉሎሳ አማንዛ አስታ ጼግሲ ኡንታን ምንዛይፕ ጉየ ሳሮ ማቃዶና Ꮊማዳይስ ከዜዝ። <verse eid="ACT 20:1"/><verse number="2" style="v" sid="ACT 20:2"/>ኤ ኣዝ ቢታይድ የዝ አማንዛ አሳይስ ዞረ ቃላ ኦዲ ምንዛይፕ ጉየ ግርኬ ጋደ ቅቴዛ። <verse eid="ACT 20:2"/><verse number="3" style="v" sid="ACT 20:3"/>ኤ ኤዛይድ ሀይ አጌና በቲ፥ ማርካበር ሶራ Ꮊማዳይስ ሙርቲ የዝን፥ አይሁድታይ ኤዛ ዎዳይስ ኮዥዛና ኤሪ ማቃዶናር ጉየ ማቆዳይስ ኮዤዛ።<verse eid="ACT 20:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 20:4"/>ጳዉሎሳ ሞይዜዛ ቤራፐ ጳርሁሳ ናአ ሶጳጽሮሳ፥ ተሰሎንቀፕ አርስጽሮኮሳኔ ስኮንዱሳ፥ ደርበፕ ጋዮሳ፥ ኢስያፕ ትክቆሳ፥ ጽሮፍሞሳኔ ጽማቶሳ። <verse eid="ACT 20:4"/><verse number="5" style="v" sid="ACT 20:5"/>የይትታይ ቲና Ꮊንጊ ኑና ጽሮአዳል ናግዛ። <verse eid="ACT 20:5"/><verse number="6" style="v" sid="ACT 20:6"/>ኑኒ ቦራ ባለ ቦንቼዛይፕ ጉየ ፕልጲሶሳፕ ማርካበር ደንዲ፥ እችን ጋላስ ኡንታን ጽሮአዳ ሄሊ ኤዛይድ ላፑን ጋላስ ጋምኤዛ።<verse eid="ACT 20:6"/></para>
  <para style="s1">አዉጽኮሳ ጽሮአዳ Ꮊማዳይስ ደንዴዛ</para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7"/>ሳምንታፕ ቲና ጋላስ ኑኒ ቦራ ዎላ ማዳይስ ሺቂ የዝን፥ ጳዉሎሳ ዎንት Ꮊማዳይስ ቆፔዝ ግሾስ ኡንትስ ቃላ ኦድታር ግዲ ብላሄ ሄሎዳይስ ኦዳ አዱስሴዛ። <verse eid="ACT 20:7"/><verse number="8" style="v" sid="ACT 20:8"/>ኑኒ ሺቂ በቴዝ ፖቃይል ፖኦ ዋዢ ጌዝን። <verse eid="ACT 20:8"/><verse number="9" style="v" sid="ACT 20:9"/>ኤዉጽኮሳ ግንትዝ ፐቲ ፓንይ ማስኮተል አፋ በቲ፥ ፋና ዶጊ ገንቴዛ። ጳዉሎሳ ኦዳ አዱሴዛይፕ ኤዉጽኮሳ ገንታ ኣፈር ሃይን ፖቃይፕ ዎ Ꮊይቄዛና አሳይ ደንዛ። <verse eid="ACT 20:9"/><verse number="10" style="v" sid="ACT 20:10"/>ዝን ጳዉሎሳ ዎ፥ ኤዛል አፋ ጹጉኒ። ኤዛ እድንጊ፥ «ኤ Ꮊይቀካያ፥ ህርግፓተ» ዬጌዛ። <verse eid="ACT 20:10"/><verse number="11" style="v" sid="ACT 20:11"/>የይፕ ጉየ፥ ፉደ ፖቄል አፋ ከዚ ቦራ ባጺ ሜዛ። ሳአ ዎንቶድ ሄሎዳይስ አሳይስ ኦዴዛይፕ ጉየ ደንዲ ቅቴዛ። <verse eid="ACT 20:11"/><verse number="12" style="v" sid="ACT 20:12"/>የ ፓጼዝ ፓን ካራ ካንጊ ጋመ ኡፋይቴዛ።<verse eid="ACT 20:12"/></para>
  <para style="s1">ጳዉሎሳ ጽሮአዳፕ ምልጸ ቅቴዛ</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13"/>ዝን ጳዉሎሳ ፋና ኤዛይፕ ሞኮዳይ ጋርክ ኑስ ኦዴዛይ ግሾስ ኑ ቲናቲ ማርካበኮ Ꮊንጊ፥ አሶና Ꮊማዳይስ ደንዴዛ። አብስ ጊኮ፥ ኤ ቶከር Ꮊማዳይስ ቆፔዝ ግሾስ ኑና የይ ጋርክ ኪቴዛ። <verse eid="ACT 20:13"/><verse number="14" style="v" sid="ACT 20:14"/>ኤ ኑና አሶና ሄልን ማርካበር ኤዛ ኤኪ ምጽልነ የኤዛ። <verse eid="ACT 20:14"/><verse number="15" style="v" sid="ACT 20:15"/>ዎንት ጋላስ ኤዛይፕ ደንዲ ማርካበር ክዮሳስ ቲና ባጋር የዝ አቃ ሄሌዛ፤ ማ ዎንት ጋላስ ሳሞሳ ፒንጊ ካልዛ ጋላስ ምልጸ ሄሌዛ። <verse eid="ACT 20:15"/><verse number="16" style="v" sid="ACT 20:16"/>ጳዉሎሳ ኢስያ ጋመ ጋምኦዳይስ ኮየካ ግሾስ ኤፈሶነ ካንታር ኣዳይስ ቆፔዛ። ፓስ ዳንዳእንትኮ ጰንጸቆስጸ ባለ ጋላስ የሩሳላመ ሄሎዳይስ ኤልስዛ።<verse eid="ACT 20:16"/></para>
  <para style="s1">ጳዉሎሳ ኤፈሶነ ጭምታና ዞሬዛ</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 20:17"/>ጳዉሎሳ ምሊጸፕ ኤፈሶና ኪቲ ዎሳ ኬ ጭምታ ጼግሴዛ። <verse eid="ACT 20:17"/><verse number="18" style="v" sid="ACT 20:18"/>ዎሳ ኬ ጭምታይ ኤዝኮ ይእን፥ ኡንትኮ Ꮊይ ጋርክ ዬጌዛ፦ «ታኒ ኢሳ ገሌዝ ቲና ጋላሳፕ አይኪ ይንታር የዜዝ ዎደ ኡባይድ ዋይዚ የዜዛኮ ይ ኤርዛ። <verse eid="ACT 20:18"/><verse number="19" style="v" sid="ACT 20:19"/>አይሁድታይ ማቅንቲ ታል አፋ መቶ ሄልኮካ ታኒ ሃዮትራኔ ጋመ አፉር ጎዳይስ ኦዛ። <verse eid="ACT 20:19"/><verse number="20" style="v" sid="ACT 20:20"/>አይደካ ይ ካራ ካራ ይንታን ታማርስታር ይንታን ማዴዛይፕ ፐትባዝካ ፓጭንቸካያ። <verse eid="ACT 20:20"/><verse number="21" style="v" sid="ACT 20:21"/>ታኒ አይሁድታይስኔ አይሁደ ባዝታይስ ናጋራፕ ጾስኮ ማቆዳይ ጋርከኔ ኑ ጎዳ የሱሳ አማኖዳይ ጋርክ ማርካቴዛ።<verse eid="ACT 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 20:22"/>«ኤዛይድ ታና አብ ሄሎዳዛኮ ኤሮያ፥ Ꮊት ታኒ ጌሻ አያናስ ኪትንቲ የሩሳላመ Ꮊንግዛ፦ <verse eid="ACT 20:22"/><verse number="23" style="v" sid="ACT 20:23"/>ዝን ጌሻ አያናይ አችኔ ዋየ ታና ናግዛና ካታማ ኡባይድ ታስ ማርካቴዛ። <verse eid="ACT 20:23"/><verse number="24" style="v" sid="ACT 20:24"/>ዝን ታ ላሶ ፖሎዳይስኔ ጎዳ የሱሳፕ ኤኬዝ ኦሳ፥ ጾስ ኣ ኬሃት ዎንግለ ማርካትዛ ፖልዛ ታ ሸምፓቶ ፓዋ ባዝ ጋርክ ፓይድዛ።<note caller="-" style="x"><char style="xo" closed="false">20:24 </char><char style="xt" closed="false"><ref loc="2TI 4:7">2ጽማ. 4:7</ref></char></note><verse eid="ACT 20:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 20:25"/>«ታኒ Ꮊተካ ጾስ ካተት ማርካትታር ይ ኡቢታይ ጋንጨር ዩዬዛ። ይከፕ ጉየ ይንትፕ ኦንካ ታና በአማና ኤርዛ። <verse eid="ACT 20:25"/><verse number="26" style="v" sid="ACT 20:26"/>የይ ግሾስ፥ ይንትፕ ፐቲ አስ ብኮካ ታ ኦይጭንታማና Ꮊይኖ ይንትስ ምልጽ ኡዲ ኦድዛ። <verse eid="ACT 20:26"/><verse number="27" style="v" sid="ACT 20:27"/>ጾስ ዞረ ኡባ ይንትስ አብካ አሸካዛር ኦዴዛ።<verse eid="ACT 20:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 20:28"/>«ፋ ኣዳስ ፋ ሱር ዎዜዝ ጾሳ ዎሳ ኬ ናጎይታ። ጌሻ አያናይ ይንታን ዉደ ሄንግዝታ ኡዲ ሹሜዝ ዉዳይስኔ ይ ኡባይስ ናግንቶይታ። <verse eid="ACT 20:28"/><verse number="29" style="v" sid="ACT 20:29"/>ታኒ Ꮊንጌዛይፕ ጉየ፥ ዉዳይስ ቃንቶዋ ኢታ ፑግታይ ይ ጋንጨ ገሎዳና ታ ኤርዛ። <verse eid="ACT 20:29"/><verse number="30" style="v" sid="ACT 20:30"/>አማንዝታ ፋ ላሳ ካልዛ ዎርዶ አስታማርታይ ይ ጋንጨፕ ደንዶዳ። <verse eid="ACT 20:30"/><verse number="31" style="v" sid="ACT 20:31"/>የይ ግሾስ፥ ታኒ ሀይ ላይ ቃማኔ ጋላስ አፉር ይንታን ኦማስ ኦማስ ምንዛ ቆፕታር ናግንቶይታ።<verse eid="ACT 20:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 20:32"/>«Ꮊተካ ይንታን ምንዳይስ ጌሽ አሳይር ላትሶዳይስ ዳንዳእዛ ጾስስኔ ኤ ኣ ኬሃተ ቃላይስ ይንታን ሀዳራ እንግዛ።<verse eid="ACT 20:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 20:33"/>«ታኒ ኦፐካ ብራ ዎይ ዎርቃ ዎይ አፍላ አሞተካያ። <verse eid="ACT 20:33"/><verse number="34" style="v" sid="ACT 20:34"/>ታኒ ታ ኩሸር ኦ ታናኔ ታር የዝታ ኮሽዛ ባዝ ማዴዛ ይ፥ ይ ኦማስ ኤርዛ። <verse eid="ACT 20:34"/><verse number="35" style="v" sid="ACT 20:35"/>ይ Ꮊይ ጋርክ ዳቡሪ ኦታር ዳቡሬዝታ ማዶዳያኔ ጎዳ የሱሳ፥ ‹ኤክዛይፕ እንግዛይ አንጅንቴዛ› ጌዝ ቃላ ይ ቆፖዳይስ ቤዝዛ ታኒ ይንታን ኡባ ባዛር ቤዜዛ» ዬጌዛ።<verse eid="ACT 20:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 20:36"/>ጳዉሎሳ የያ ኦዲ ሃሲ ኡ ኡቢታይራ ጉልባቲ ጾሳ ዎሴዛ። <verse eid="ACT 20:36"/><verse number="37" style="v" sid="ACT 20:37"/>ኡ ኡቢታይካ ጳዉሎሳና እድንጊ ዬክታር ዬሬዛ። <verse eid="ACT 20:37"/><verse number="38" style="v" sid="ACT 20:38"/>ኤ ማሂ፥ «Ꮊይኖፕ ጉየ ታና ይ በኣሚ» ዬጌዝ ቃላይ ኡንታን ኢታ አዛንዛ። ኡንቲ ማርካባ ሄሎዳይስ ኤዛ ሞይዜዛ።<verse eid="ACT 20:38"/></para>
  <chapter eid="ACT 20"/>
  <chapter number="21" style="c" sid="ACT 21"/>
  <para style="s1">ጳዉሎሳ የሩሳላመ ቅቴዛ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1"/>ኑኒ ኤፈሶና ጭምታይፕ ሻክንቴዛን ጋርክ ማርካበር ቆሰ Ꮊንጌዛ። ዎንት ጋላስ ሩደ ሄሊ ኤዛይፕ ጳጽራ Ꮊንጌዛ። <verse eid="ACT 21:1"/><verse number="2" style="v" sid="ACT 21:2"/>ፕንቀ ፒንግዝ ማርካበ ደንጊ ኤዛይድ ገሊ Ꮊማዳይስ ደንዴዛ። <verse eid="ACT 21:2"/><verse number="3" style="v" sid="ACT 21:3"/>ኑኒ ቆጲሮሳ በኤዛን ጋርክ፥ ሀድርስ ባጋ አሺ ሶራ Ꮊንጌዛ። ማርካባይ ፋ ጫና ኤዛይድ ዎዳይስ ኮዬዝ ግሾስ ጽሮሳ Ꮊንጌዛ። <verse eid="ACT 21:3"/><verse number="4" style="v" sid="ACT 21:4"/>ኤዛይድ አማንዛ አስታ ደንጌዛ ኡንታር ላፑን ጋላስ በቴዛ። ጳዉሎሳ የሩሳላመ Ꮊንጋማይ ጋርክ ኡንቲ ኤስ አያናር ኦዴዛ። <verse eid="ACT 21:4"/><verse number="5" style="v" sid="ACT 21:5"/>ኑኒ ኡንታር በትዛ ዎዳይ ዉርን ከዚ Ꮊንጌዛ። ኡንቲ ኡባይ ፋ ማችታይራኔ ፋ ናእታይር ፐቲ ካታማፕ ጋጻ ከሲ ኑና ሞይዜዛ። ኑኒ አባ ላንቀ ቡንቂቲ ጾሳ ዎሴዛ። <verse eid="ACT 21:5"/><verse number="6" style="v" sid="ACT 21:6"/>የይፕ ጉየ፥ ዎል ሳሮ ኑ ማርካባይድ ገሌዛ፤ ኡንትካ ፋ ካራ ማቄዛ።<verse eid="ACT 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 21:7"/>ኑኒ አባል አፋር ኦጋ ሃሲ፥ ጽሮሳፕ ጰጸለማሳ ሄሌዛ። ኤዛይድ አማንዛ አስታ ሳሮ፥ ኡ ካለ ፐቲ ጋላስ ፔዤዛ። <verse eid="ACT 21:7"/><verse number="8" style="v" sid="ACT 21:8"/>ዎንት ጋላስ ከዚ፥ ቅሳረ Ꮊንጌዛ። ሳባኬ ፍልጶሳ ካራ ሄሊ ኤ ካለ በቴዛ። ኤ የሩሳላመ ቲን ዶርንቴዝ ላፑንታይፕ ፐታ።<note caller="-" style="x"><char style="xo" closed="false">21:8 </char><char style="xt" closed="false"><ref loc="ACT 6:5">ሀዋ. ኦ. 6:5</ref>፤ <ref loc="ACT 8:5">8:5</ref></char></note> <verse eid="ACT 21:8"/><verse number="9" style="v" sid="ACT 21:9"/>ፍልጶሳስ ናበ ማቄዝ ኦይዲ ዉድር ናእታይ የዛ።<verse eid="ACT 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 21:10"/>ኑኒ ኡንደና ጋላስ ኤዛይድ በቲ የዝን አጋቦሳ ግዝ ናባይ ይሁዳፕ ቅሳረ የኤዛ።<note caller="-" style="x"><char style="xo" closed="false">21:10 </char><char style="xt" closed="false"><ref loc="ACT 11:28">ሀዋ. ኦ. 11:28</ref></char></note> <verse eid="ACT 21:10"/><verse number="11" style="v" sid="ACT 21:11"/>ኑኮ ይኢ ጳዉሎሳፕ ሳቃ ኤኪ ፋ ኩሻኔ ፋ ቶካ አጪ፥ «ጌሻ አያናይ Ꮊ ሳቃይ ጎዳ፥ የሩሳላመ አይሁድታይ Ꮊይ ጋርክ አጪ፥ አይሁደ ማቀካ አሳይስ ኣ እማዳ ዬግዛ» ዬጌዛ።<verse eid="ACT 21:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 21:12"/>ኑኒ የያ ስኢ ኑኔ ኤዛይድ የዝ አስታይ ጳዉሎሳ የሩሳላመ Ꮊንጋማይ ጋርክ ዎሴዛ። <verse eid="ACT 21:12"/><verse number="13" style="v" sid="ACT 21:13"/>ዝን ጳዉሎሳ ማሂ፥ «ይ Ꮊይ ጋርክ ዬክታር አብስ ታ ዎዝና ሹግሸ? ታኒ፥ ጎዳ የሱሳ ሱንይ ግሾስ አች ኣዳ ባዝን የሩሳላመ Ꮊይቆዳይስካ ጊግንቴዛ» ዬጌዛ።<verse eid="ACT 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 21:14"/>ኑ ዞራ ኤ ኤካም እጽን፥ «ጎዳይ ሸነ ማቆ» ዬጊ ስኢ ጌዛ።<verse eid="ACT 21:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 21:15"/>ኤዛይድ ጽቃ ዎደ ጋምኤዛይፕ ጉየ ጊግንቲ የሩሳላመ Ꮊማዳይስ ከዜዝ። <verse eid="ACT 21:15"/><verse number="16" style="v" sid="ACT 21:16"/>ቅሳረ የዝ አማንዛ አስታይፕ ጽቅታይ ኑር Ꮊንጎይታ ጌዛ። ኡንቲ ኑኒ ሸምፖዳይስ ምናሶና ግዝ ቆጲሮሳ አይ ካራ ካንጌዛ። ምናሶና ቲን አማኔዝ አሳይፕ ፐታ።<verse eid="ACT 21:16"/></para>
  <para style="s1">ጳዉሎሳ የሩሳላመ ሄሌዛ</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 21:17"/>ኑኒ የሩሳላመ ሄልን አማንዛ አሳይ ኑና ኡፋይሳር ሞኬዛ። <verse eid="ACT 21:17"/><verse number="18" style="v" sid="ACT 21:18"/>ዎንት ጋላስ ጳዉሎሳ ኑር ዎላ ያይቆባኮ Ꮊንጌዛ። ዎሳ ኬ ጭምታይ ኡቢታይካ ኤዛይድ የዛ። <verse eid="ACT 21:18"/><verse number="19" style="v" sid="ACT 21:19"/>ጳዉሎሳ ኡንታን ሳሮዛይፕ ጉየ አይሁደ ማቀካ አሳይ ጋንጨ ፋ ባጋር ጾሲ ኦዝ ባዝታ ኡባ ኡንትስ ኦዴዛ።<verse eid="ACT 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 21:20"/>ኡንቲ የያ ስኢ ጾሳ ጋላቲ ጳዉሎሳኮ Ꮊይ ጋርክ ዬጌዛ፦ «ኑ እሻዮ፥ አይሁድታይ ጋንጨ ኣፑን ሙኩልታይ ጾሳ አማኔዛኮ ነ ብእዛ፤ ኡንቲ ኡባይካ ህጋ ሚን ናግዛ። <verse eid="ACT 21:20"/><verse number="21" style="v" sid="ACT 21:21"/>ኔኒ አይሁደ ባዝታይ ቢታ የዝ አይሁደ ኡባይ ፋ ናእታ ዶካላማይ ጋርክ፥ አይሁድታይ ዎጋ ካላማይ ጋርከኔ ሙሰ ህጋ እጾዳይ ጋርክ ኔኒ ታማርስዛና የሩሳላመ የዝ አይሁድታይ ስኤዛ። <verse eid="ACT 21:21"/><verse number="22" style="v" sid="ACT 21:22"/>የዝን አቢ ሎኦ? ኔ ይእ ቱማካ ኡ ስኦዳ።<verse eid="ACT 21:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 21:23"/>«የይ ግሾስ፥ ኑኒ ኔስ ኦድዛና ስኦባ፤ ጋ የዝ ኦይዲ አስታይ ኑ ካለ የዛ።<note caller="-" style="x"><char style="xo" closed="false">21:23-24 </char><char style="xt" closed="false"><ref loc="NUM 6:13-21">ታይ. 6:13-21</ref></char></note> <verse eid="ACT 21:23"/><verse number="24" style="v" sid="ACT 21:24"/>ኡንታን ኤኪ ኡንታራ ጌዦባ፤ ማ ኡንቲ ፋ ኦማ ሜድንቶዳይ ጋርክ ኡንትስ ሚሸ እንጎባ። ኡንቲ ቲና ነ ባጋ ስኤዛይ ቱማ ባዛኔ ኔኒ ነ ኡባስካ ህገ ናግዛ አስ ማቄዛና ኡባይ ኤሮዳ።<verse eid="ACT 21:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 21:25"/>«ዝን አማኔዝ አይሁደ ማቀካ አስታ ማቅኮ፥ ኡንቲ ኤቃስ ያርሽንቴዝ ባዝ ማማይ ጋርክ፥ ሱ ኡዣማይ ጋርክ፥ ባዉታ ማማይ ጋርከኔ ላግታማይ ጋርክ፥ ኑኒ ኦዳ አጪ፥ ኡንትስ ዳብዳበ ጻፌዛ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">21:25 </char><char style="xt" closed="false"><ref loc="ACT 15:29">ሀዋ. ኦ. 15:29</ref></char></note><verse eid="ACT 21:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 21:26"/>የይፕ ጉየ፥ ጳዉሎሳ ዎንት ጋላስ አስታ ኤኪ፥ Ꮊንጌዛ። ኤ ፋ ጌዥዝ ጋላሳይ አይደ ፖልንቶዳዛኮ ኤርሶዳይስኔ ፋ ያርሾ አይደ ያርሾዳዛኮ ኤርሶዳይስ ጾስ ኬ ገሌዛ።<verse eid="ACT 21:26"/></para>
  <para style="s1">ጳዉሎሳ አይክንቴዛ</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27"/>ላፑን ጋላሳይ ዉሮድ ሀኖዳር፥ ኢሳፕ የኤዝ አይሁድታይ ጾስ ኬ ጳዉሎሳ ብኢ፥ አስ ኡባ ደን ጳዉሎሳ አይኬዛ። <verse eid="ACT 21:27"/><verse number="28" style="v" sid="ACT 21:28"/>«እስሬለ አሳዮ፥ ኑና ማዶይታ፤ Ꮊ አይ፥ ኑ ህጋኔ Ꮊ ጾስ ካራና እጾዳይ ጋርክ አስ ኡባ ኡባ አቆ ታማርስዛ አይ Ꮊያ። የይካ ግዳም እጽን አይሁደ ባዝታ ጾስ ካራ ገልሲ፥ Ꮊ ጌሽ አቃ ቱንሴዛ» ዬጊ ኡኬዛ። <verse eid="ACT 21:28"/><verse number="29" style="v" sid="ACT 21:29"/>ኡንቲ የያ ጌዛይ ቲና ኤፈሶና ጽሮፍሞሳና ጳዉሎሳር ዎላ ካታማይድ በኤዝ ግሾስ Ꮊት ጳዉሎሳ ጾስ ካራ ኤዛ ኤኪ ገሌዝባዝ ኡንትስ ኣዜዛ።<note caller="-" style="x"><char style="xo" closed="false">21:29 </char><char style="xt" closed="false"><ref loc="ACT 20:4">ሀዋ. ኦ. 20:4</ref></char></note><verse eid="ACT 21:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 21:30"/>ካታማ ኡባይ ሻርክሻርኬዛ፤ አሲ ኡባይ ሺቂ ጳዉሎሳ አይኪ ጾስ ካራፕ ጎቺ ባለ ከሴዛ። ጾስ ካራ ፐንግታይ ኤልሲ ጎርድንቴዛ። <verse eid="ACT 21:30"/><verse number="31" style="v" sid="ACT 21:31"/>አሳይ ጳዉሎሳ ዎድ ሀኖዳር፥ «የሩሳላመ ካታማ ኩንይ ቡቂንቴዛ» ግዝ ኦዳይ ኦሮመ ሻላቃይኮ ሄሌዛ። <verse eid="ACT 21:31"/><verse number="32" style="v" sid="ACT 21:32"/>ሻላቃይ ዎታዳርታኔ ማቶ ሀላቅታ ኤኪ ላስታር የኤዛ። አሳይ ሻላቃኔ ዎታዳርታ ብኢ ጳዉሎሳ Ꮊዛና አሼዛ።<verse eid="ACT 21:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 21:33"/>የ ዎደ ሻላቃይ ሺቂ፥ ጳዉሎሳ አይኪ፥ ናምኢ ሳንላተር አጭንቶዳይ ጋርክ ኪቴዛ። ዬዚ፥ ኤ ኦናዛኮኔ አብ ኡዴዛኮ አሳ ኦይጬዛ። <verse eid="ACT 21:33"/><verse number="34" style="v" sid="ACT 21:34"/>አሳይፕ ባጋይ Ꮊያ ግ ኡኮዳር Ꮊንክታይ የያ ግ ኡክዛ። ጫቦታይ ዳሬዝ ግሾስ ሻላቃይ ቱማ ሻኮዳይስ ዳንዳእንታም እጽን፥ ዎታዳርታይ ጳዉሎሳ ፋ የዛ አቆ ካንጎዳይ ጋርክ አዛዜዛ። <verse eid="ACT 21:34"/><verse number="35" style="v" sid="ACT 21:35"/>ጳዉሎሳ የ ከዜዝ ደ ሄሎዳር አስ ኡርቅይ ግሾስ ዎታዳርታይ ኤዛ ቶኬዛ። <verse eid="ACT 21:35"/><verse number="36" style="v" sid="ACT 21:36"/>ጋመ አሳይ፥ «ኤ Ꮊይቆ!» ዬጊ ኡክታር ካልዛ።<verse eid="ACT 21:36"/></para>
  <para style="s1">ጳዉሎሳ ሞታይስ ማህ እንጌዛ</para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 21:37"/>ዎታዳርታይ ጳዉሎሳ ፋ የዛ አቆ ገልሶድ ሀኖዳር፥ ጳዉሎሳ ሻላቃይኮ፥ «ታ ኔስ ፐትባዝ ኦዶዳይ ጋርክ ኡዶዴ?» ዬጌዛ።</para>
  <para style="p" vid="ACT 21:37">ኤ ጳዉሎሳኮ፥ «ኔኒ ግርኬ ዶና ኤርኔ? <verse eid="ACT 21:37"/><verse number="38" style="v" sid="ACT 21:38"/>ኔኒ Ꮊይፕ ቲና ቡቅ መ ሸምፖ ዎዝ ኦይዲ ሙኩለ አስታ ኤኪ ሊዦ ጋ ገሌዝ ግብጸ አይ ነና ባሳ?» ዬጌዛ።<verse eid="ACT 21:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 21:39"/>ዝን ጳዉሎሳ፥ «ታኒ፥ ክልቃ የዝ ኤርንቴዝ ተርሰሰ ካታማ አስ ማቄዝ አይሁደ አሲ። ሀያና ታና አሳይስ ኦድሶየ?» ዬጌዛ።<verse eid="ACT 21:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 21:40"/>ሻላቃይ ኤዝኮ፥ «ኦዶባ» ዬግን ጳዉሎሳ ደል አፋ ኤቂ፥ አሳይ ስእ ጎዳይ ጋርክ ፋ ኩሸር ማሌዛ። አሳይ ስእ ግን እብራይስጸ ዶናር Ꮊይ ጋርክ ዬጌዛ፦<verse eid="ACT 21:40"/></para>
  <chapter eid="ACT 21"/>
  <chapter number="22" style="c" sid="ACT 22"/>
  <para style="p">
    <verse number="1" style="v" sid="ACT 22:1"/>«ታ እሹን፥ ታ አዱን፥ ታኒ Ꮊት ይንትስ እንግዛ ማልሳ ስኦይታ።» <verse eid="ACT 22:1"/><verse number="2" style="v" sid="ACT 22:2"/>ጳዉሎሳ ኡንትስ እብራይስጸ ዶናር ኦድዛ ስኢ ካሴሳይፕ አ ስኢ አቴዛ። ኤ ዬጌዛ፥<verse eid="ACT 22:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 22:3"/>«ታኒ ክልቃ የዝ ጸርሴሰ የልንቲ Ꮊ ካታማይድ ድጬዛ። ታ አስታማረይካ ጋማላለ፤ ታኒ ኑ አድታይ ህጋ ሚን ታማሬዛ፥ Ꮊይኖ ይ ኡባይ ሀንዛይ ጋርክ ጾሳይስ ምሽንትዛ አይሁደ አሲ። <verse eid="ACT 22:3"/><verse number="4" style="v" sid="ACT 22:4"/>ታኒ Ꮊ ኦጋ ካልዛ ማችታይኔ ራታ አይኪ አች ኬ ኦልታራኔ ኡንታን ዎሶድ ሄሎዳይስ መቶ ቤዜዝ አሲ።<note caller="-" style="x"><char style="xo" closed="false">22:4 </char><char style="xt" closed="false"><ref loc="ACT 8:3">ሀዋ. ኦ. 8:3</ref>፤ <ref loc="ACT 26:9-11">26:9-11</ref></char></note> <verse eid="ACT 22:4"/><verse number="5" style="v" sid="ACT 22:5"/>የይ ጋርከካ፥ ቄሰ ሀላቃይኔ ሻንጎ ኡባይ ታባዝ ማርካቶዳይስ ዳንዳእዛ። ታኒ ዳማስቆ የዝ ኡ እሽታይስ ኡንታፕ ዳብዳበ ኤኪ ኤዛይድ የዝ አስታይ አጭንቲ ሴርንቶድ ጋርክ የሩሳላመ ኮኦዳይስ Ꮊንጌዛ።»<verse eid="ACT 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 22:6"/>«ታኒ Ꮊንጊ ዳማስቆ ሄሎዳር ሴታ ጋላስ ቆፐካ ሳሎፕ ግታ ፖኦ ታ ካላይር ፖኤዛ። <verse eid="ACT 22:6"/><verse number="7" style="v" sid="ACT 22:7"/>ታኒ ሳአ ፖኪ የዝን፥ ‹ሳኦላ፥ ሳኦላ፥ ታና አብስ ባይእኔ?› ግዝ ቃላ ስኤዛ። <verse eid="ACT 22:7"/><verse number="8" style="v" sid="ACT 22:8"/>ታኒ ማሂ፥ ‹ጎዳዮ፥ ኔኒ ኦኖ?› ዬጌዛ።</para>
  <para style="p" vid="ACT 22:8">«ኤ ማሂ፥ ‹ታኒ፥ ነ ባይእዝ ናዝረተ የሱሳ› ዬጌዛ። <verse eid="ACT 22:8"/><verse number="9" style="v" sid="ACT 22:9"/>ታር የዝታይ ፖአ በኤዛይፕ አትን ታስ ኦድዛ ቃላ ስኤካያ።<verse eid="ACT 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 22:10"/>«ታኒ፥ ‹ጎዳዮ፥ ታ አብ ኡዶ?› ዬጌዛ።</para>
  <para style="p" vid="ACT 22:10">«ጎዳይ ታኮ፥ ‹ደንዲ ዳማስቆ Ꮊንጎባ። ነ ኡዶዳይ ጋርክ ጾስ ቆፔዝባዝ ኡባ ባዝ ኤዛይድ ኔስ ኦድንቶዳ› ዬጌዛ። <verse eid="ACT 22:10"/><verse number="11" style="v" sid="ACT 22:11"/>የ ዎልቃማ ፖአይፕ ደንዴዛይድ ታ ኣፋይ በአም እጽን፥ ታር የዝ አስታይ ታ ኩሻ አይኪ፥ ታና ጎችን ዳማስቆ ሄሌዛ።<verse eid="ACT 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 22:12"/>«ዳማስቆ የዝ አይሁደ ኡባይ ኡንደና ቦንችዛ ፐቲ ሀናና ግዝ አይ፥ ኑ ህጋ ቦንችዛይኔ ጾሳ ሚን ዎስዛይ የዛ። <verse eid="ACT 22:12"/><verse number="13" style="v" sid="ACT 22:13"/>ሀናና ታኮ ይኢ፥ ታ ካለ ኤቂ፥ ‹ታ እሻዮ ሳኦላ፥ ቦኦባ› ዬጌዛ። ኤልሲ ታኒ ኤዛ በኦ አይኬዛ።<verse eid="ACT 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 22:14"/>«ኤ ታኮ፥ ‹ኑ አድታይ ጾሳይ ኔኒ ኤ ሸነ ኤሮዳይ ጋርክ፥ ጽላ በአዳይ ጋርከኔ ኤ ዶናፕ ቃላ ስኦዳይ ጋርክ ቲናቲ ነና ዶሬዛ። <verse eid="ACT 22:14"/><verse number="15" style="v" sid="ACT 22:15"/>ነ በኤዝባዝኔ ስኤዝ ባዝ አስ ኡባ ቲና ኤስ ማርካ ማቆዳ። <verse eid="ACT 22:15"/><verse number="16" style="v" sid="ACT 22:16"/>Ꮊት አብስ ጋምኤ? ደንዲ ጻማቅንቶባ፤ ኤ ሱን ጼግታር ነ ናጋራይፕ ሜጭንቶባ› ዬጌዛ።<verse eid="ACT 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 22:17"/>«ታኒ ጉየ የሩሳላመ ማቂ ጾስ ኬ ዎሶዳር፥ ታስ ቆንጭ በንቴዛ። <verse eid="ACT 22:17"/><verse number="18" style="v" sid="ACT 22:18"/>ቆንጭር ጎዳይ ታኮ፥ ‹ነ ታስ ማርካትዝ ማርካት አሳይ ኤከካ ግሾስ ኤልሲ የሩሳላመፕ ከዞባ› ዬጎዳር ታ በኤዛ።<verse eid="ACT 22:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 22:19"/>«ታኒ፥ ‹ጎዳዮ፥ አይሁደ ዎሳ ኬ ኡባይድ ነና አማንዝታ አይኪ Ꮊዛኔ አች ካራ ኦሌዛ ኡንቲ ኤርዛ። <verse eid="ACT 22:19"/><verse number="20" style="v" sid="ACT 22:20"/>ኡንቲ ነ ማርካ ኢስጽፋኖሰ ዎዳር ታኒ የ ኦዳይድ አሳይር ቶቤዛ። ማ ኡ ካለ ኤቂ ኤዛ ዎዝታይስ ማኦ ናግዛ› ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">22:20 </char><char style="xt" closed="false"><ref loc="ACT 7:58">ሀዋ. ኦ. 7:58</ref></char></note><verse eid="ACT 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 22:21"/>«ጎዳይ ታኮ፥ ‹ታኒ ነና አይሁደ ማቀካ አሳይኮ ሃኮ አቆ ኪቴዛይ ግሾስ ደንዲ ቅቶባ› » ዬጌዛ።<verse eid="ACT 22:21"/></para>
  <para style="s1">ጳዉሎሳ ኦሮመ አስ ማቄዛና ቆንጭሴዛ</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22"/>ጳዉሎሳ የ ቃላ ኦዲ ሃሶድ ሄሎዳይስ አሳይ ኤ ግዛ ስእዛ። የይፕ ጉየ፥ ፋ ቃላ ቅ ኡዲ፥ «Ꮊያ ቢታይፕ ብሶባ! ኤ ሸምፖር የዞዳይስ ቤዞያ» ዬጌዛ።<verse eid="ACT 22:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 22:23"/>ኡንቲ ኡክታራኔ፥ ፋ ማኦ አፋ ዳክታራኔ ባና አፋ ደንዳር፤ <verse eid="ACT 22:23"/><verse number="24" style="v" sid="ACT 22:24"/>ሻላቃይ ብኢ ዎታዳርታይ ጳዉሎሳና ኡ ፋ የዛ አቆ ካንጎዳይ ጋርክ ኪቴዛ። ማ አሳይ አብስ የይ ጋርክ ኡክዛኮ ኤሮዳይስ ኮዪ ጳዉሎሳ አላንጋር ጋራፊ ፕላጎዳይ ጋርክ ኡንታን ኪቴዛ። <verse eid="ACT 22:24"/><verse number="25" style="v" sid="ACT 22:25"/>ዝን ዎታዳርታይ ጳዉሎሳ ዳፈር ሚን አጪ ጋራፎድ ሀኖዳር ጳዉሎሳ ፋ ካለ ኤቄዝ ማቶ ሀላቅታይኮ፥ «ኦሮመ አስ ፕርዳ ባይ ጋራፍዛይ ይንትስ ዎጋ?» ዬጌዛ።<verse eid="ACT 22:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 22:26"/>ማቶ ሀላቃይ የያ ስኢ ሻላቃይኮ Ꮊንጊ፥ «Ꮊ አይ ኦሮመ አሲ። ኔኒ አብ ኦዳይስ ቆፔኔ?» ዬጊ ኦይጬዛ።<verse eid="ACT 22:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 22:27"/>ሻላቃይ ጳዉሎሳኮ ሺቂ፥ «ኔኒ ኦሮመ አሶ? አን ታስ ኦዶባ» ዬጌዛ።</para>
  <para style="p" vid="ACT 22:27">ጳዉሎሳ፥ «ኤ» ዬጌዛ።<verse eid="ACT 22:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 22:28"/>ሻላቃይ ማሂ፥ «ታኒ Ꮊ ጋደት ጋመ ሚሸር ዎንጌዛ» ዬጌዛ።</para>
  <para style="p" vid="ACT 22:28">ዝን ጳዉሎሳ፥ «ታ Ꮊ ጋደት የለትር ደንጊ ኤኬዛ» ዬጌዛ።<verse eid="ACT 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 22:29"/>የይ ግሾስ፥ ጳዉሎሳ ፕላጎዳይስ ቆፔዝታይ እዝር ኤፕ ሻክንቴዛ። ሻላቃይ ኦሮመ አስ ማቄዛና ኤሪ አጭሴዛይስ ያሽቴዛ።<verse eid="ACT 22:29"/></para>
  <para style="s1">ጳዉሎሳ አይሁደ ሻንጎ ቲና ሺቄዛ</para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 22:30"/>ዎንት ጋላስ ሻላቃይ፥ አይሁድታይ ጳዉሎሳ አብስ ሞቴዛኮ ጌሺ ኤሮዳይስ ኮዬዛ። ቄሰ ሀላቅታይኔ ሻንጎ ኡባይ ሺቆዳይ ጋርክ አዛዜዛ፤ ማ ጳዉሎሳ አቻፕ ብልእሲ ኡ ቲና ኤሴዛ።<verse eid="ACT 22:30"/></para>
  <chapter eid="ACT 22"/>
  <chapter number="23" style="c" sid="ACT 23"/>
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1"/>ጳዉሎሳ ሻንጋና ዳኪ ብኢ፥ «ታ እሹን፥ ታኒ Ꮊይኖ ሄሎዳይስ ጾስ ቲና ታ የስ ኡባይድ ሎኦ ዎዝናር የዛ» ዬጌዛ። <verse eid="ACT 23:1"/><verse number="2" style="v" sid="ACT 23:2"/>ቄሰ ሀላቃይ ሀናና፥ ጳዉሎሳ ዶናተ ባቆዳይ ጋርክ ኤ ካለ ኤቄዛና ኪቴዛ። <verse eid="ACT 23:2"/><verse number="3" style="v" sid="ACT 23:3"/>የ ዎደ ጳዉሎሳ ኤኮ፥ «ናት ነ ቦርሾንቶ ትዤዝ ጋባራ ኣዝዛዮ፥ ጾሳይ ነና ባቆዳ። ኔኒ ታል አፋ ህገ ጋርክ ፕርዶዳይስ በቲ ህገ መን ታና ባቆዳይ ጋርክ ኪትኔ?» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">23:3 </char><char style="xt" closed="false"><ref loc="MAT 23:27-28">ማቶ. 23:27-28</ref></char></note><verse eid="ACT 23:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 23:4"/>ጳዉሎሳ ካንታ ኤቄዝታይ ኤኮ፥ «ነ ጾስ ቄሰ ሀላቃ ጫዥኔ?» ዬጌዛ።<verse eid="ACT 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 23:5"/>ጳዉሎሳ፥ «ታ እሹን፥ ኤ ቄሰ ሀላቃ ማቄዛ ታ ኤረካያ፤ አብስ ጊኮ ጾስ ቃላይድ፥ ‹ነ ዎያ አቅስዛይል አፋ ኢታ ቃላ ኦድፐ› ግንትንቲ ጻፍንቴዛ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">23:5 </char><char style="xt" closed="false"><ref loc="EXO 22:28">ከስ 22:28</ref></char></note><verse eid="ACT 23:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 23:6"/>ዝን ጳዉሎሳ የ አቃይድ የዝ አሳይፕ ባግታይ ሳዱቃውታ፥ ባግታይ ፈርሳውታ ማቄዛና ኤሪ፥ «ታ እሹን፥ ታኒ ፈርሳወኔ ፈርሳወ ናአ፤ ‹Ꮊይቄዝታይ Ꮊይቆፕ ደንዶዳ› ግ ታኒ ኡፋይሳር ናግዛ ግሾስ ኡንቲ ታል አፋ ፕርድዛ» ዬጊ ኦዴዛ።<note caller="-" style="x"><char style="xo" closed="false">23:6 </char><char style="xt" closed="false"><ref loc="ACT 26:5">ሀዋ. ኦ. 26:5</ref>፤ <ref loc="PHP 3:5">ፍል. 3:5</ref></char></note><verse eid="ACT 23:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 23:7"/>ጳዉሎሳ የያ ጌዝ ዎደ ፈርሳውታይ ጋንጨኔ ሳዱቃውታይ ጋንጨ ካቺ ኬዝን ሻክንቴዛ። <verse eid="ACT 23:7"/><verse number="8" style="v" sid="ACT 23:8"/>አብስ ጊኮ፥ ሳዱቃውታይ፥ «Ꮊይቄዝ አስ ደንዶያ፤ ኪታንቾካ አያንካ ባያ» ዬግዛ። ዝን ፈርሳውታይ ኡባካ አማንዛ።<note caller="-" style="x"><char style="xo" closed="false">23:8 </char><char style="xt" closed="false"><ref loc="MAT 22:23">ማቶ. 22:23</ref>፤ <ref loc="MRK 12:18">ማር. 12:18</ref>፤ <ref loc="LUK 20:27">ሉቃ. 20:27</ref></char></note> <verse eid="ACT 23:8"/><verse number="9" style="v" sid="ACT 23:9"/>ኦላ ኡፎ ከሴዛ፤ ፈርሳውታይ ባጋ ማቄዝ ህገ አስታማርታይ ደንዲ ኤቂ፥ «Ꮊ አይል አፋ አባ ቡታካ ደንጌካያ፤ ኤስ አያና ዎይ ኪታንቻይ ኦዶ አተና» ዬጊ ፓላሜዛ።<verse eid="ACT 23:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 23:10"/>ካቻይ ሜእ አይክን አሳይ ጳዉሎሳ ሻቅርቻማይ ጋርክ ግ፥ ሻላቃይ ፋ ዎታዳርታይ ዎ ኡንታን ጋንጨፕ ኤዛ ኤልሲ ከሲ ኡ ፋ የዛ አቆ ካንጎዳይ ጋርክ ኪቴዛ።<verse eid="ACT 23:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 23:11"/>የ ቃማ ጎዳይ ጳዉሎሳ ካለ ኤቂ፥ «ጳዉሎሳ፥ ኔኒ ታስ የሩሳላመ ማርካቴዛ ኦሮመካ ማርካቶዳይስ ቤዝዛ፤ ምንጎባ፤ አኮ ባያ» ዬጌዛ።<verse eid="ACT 23:11"/></para>
  <para style="s1">ጳዉሎሳና ዎዳይስ ማቅንቴዛ</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 23:12"/>ዎንት ጋላስ አይሁድታይ፥ «ጳዉሎሳና ዎካዛር ካ ማሚ ሃ ኡዣሚ» ግ ጫቄዛ። <verse eid="ACT 23:12"/><verse number="13" style="v" sid="ACT 23:13"/>ጳዉሎሳል አፋ የያ ማቅንቴዝ አስታይ ኦይታማፕ ጋመ። <verse eid="ACT 23:13"/><verse number="14" style="v" sid="ACT 23:14"/>ኡንቲ ቄሰ ሀላቅታይኮኔ ጋደ ጭማታይኮ Ꮊንጊ፥ «ኑኒ ጳዉሎሳ ዎካዛር ካ ግዝባዝ ማሚ ግ ጫቄዝ። <verse eid="ACT 23:14"/><verse number="15" style="v" sid="ACT 23:15"/>ይኬ፥ ይንታን ሻንጋይ ኤባዝ ጌሺ ፕላጎድባዝ የዝ ኣዝሲ፥ ጳዉሎሳ ይንትኮ ኮኦዳይ ጋርክ ሻላቃ ኦይጮይታ። ኑኒ ኤ Ꮊ ሺቆ ሄሎዳይፕ ቲና ኤዛ ዎዳይስ ጊጊ በቴዛ» ዬጌዛ።<verse eid="ACT 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 23:16"/>ዝን ጳዉሎሳ ምሺ ናአይ የ ማቅንታ ስኢ Ꮊንጊ ዎታዳርታይ የዛ አቆ ገሊ፥ ጳዉሎሳስ ኦዴዛ። <verse eid="ACT 23:16"/><verse number="17" style="v" sid="ACT 23:17"/>ጳዉሎሳ ማቶ ሀላቅታይፕ ፐታ ጼጊ፥ «Ꮊ ናአይ ሻላቃይስ ኦድዛ ባዝ የዛ ግሾስ ኤዛ ሻላቃይኮ ካንጎባ» ዬጌዛ።<verse eid="ACT 23:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 23:18"/>ማቶ ሀላቃይ ናአ ሻላቃይኮ ካንጊ፥ «አች ካራ የዝ ጳዉሎሳ ታና ፋኮ ጼጊ፥ Ꮊ ናአይ ኔስ ኦድዛ ባዝ የዝ ግሾስ ኤዛ ኔኮ ኮኦዳይ ጋርክ ታና ዎሴዛ» ዬጌዛ።<verse eid="ACT 23:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 23:19"/>ሻላቃይ ናአይ ኩሻ አይኪ፥ ዱማ ባለ ከሲ፥ «ኔኒ ታስ ኦዶድባዛይ አባ?» ዬጊ ኦይጬዝ።<verse eid="ACT 23:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 23:20"/>ናአይ ሻላቃይኮ፥ «አይሁድታይ ጳዉሎሳ ባጋ ካሰፕ ሚን ፕላጎዳይስ ኮዬዝ ባዝ ኣዝሲ ኔኒ ዎንታ ኤዛ ሺቆ ኮኦዳይ ጋርክ ነና ዎሶዳይስ ዞረ አጬዛ። <verse eid="ACT 23:20"/><verse number="21" style="v" sid="ACT 23:21"/>ዝን ኔኒ ኡንቲ ግዝባዝ ስእፐ። አብስ ጊኮ፥ ኦይታማፕ ጋመ አስታይ ጳዉሎሳ ዎካዛር ‹ካ ማሚ፥ ሃ ኡዣሚ› ግ ጫቂ፥ ቆስንቲ ኤዛ ናግዛ። Ꮊት ነ ግዝባዝ ኣዳ ስኦዳይስ ናግዛ» ዬጌዛ።<verse eid="ACT 23:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 23:22"/>ሻላቃይ ማሂ፥ «Ꮊያ ነ ታስ ኦዴዛና ሀራ ኦስካ ኦድፐ» ዬጊ ናአ ጉየ ዳኬዛ።<verse eid="ACT 23:22"/></para>
  <para style="s1">ጳዉሎሳና ፍልክሰኮ ዳኬዛ</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 23:23"/>ሻላቃይ ማቶ ሀላቅታይፕ ናምእታ ጼጊ፥ «ቃማፕ ሀይ ሳተር ቅሳረ Ꮊንጎዳይስ፥ ናምኢ ጼት ዎታዳርታ፥ ላፑን ታም ፋራ አስታኔ ናምእ ጼት ቶራንችታ ጊግሶይታ። <verse eid="ACT 23:23"/><verse number="24" style="v" sid="ACT 23:24"/>ጋደ አቅስዛ ፍልክሳኮ ጳዉሎሳ ሳሮር ሄሎዳይ ጋርክ ቶጋ መህታ ጊግሶይታ» ዬጊ ኡ ኪቴዛ። <verse eid="ACT 23:24"/><verse number="25" style="v" sid="ACT 23:25"/>ሻላቃይ ፍልክሳስ Ꮊይ ጋርክ ግዝ ዳብዳበ ጻፌዛ፦<verse eid="ACT 23:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 23:26"/>«ቃላዉዶሳ ሉሶሳፐ ጋደ አቅስዛ ቦንቾ ፍልክሳስ፥ ሳሮ ኔስ ማቆ። <verse eid="ACT 23:26"/><verse number="27" style="v" sid="ACT 23:27"/>አይሁድታይ Ꮊ አ አይኪ ዎድ ሀኖዳር፥ ኤ ኦሮመ ጋደ አስ ማቄዛያ ኤሪ ዎታዳርታይራ ሄሊ ኤዛ አሼዛ። <verse eid="ACT 23:27"/><verse number="28" style="v" sid="ACT 23:28"/>ታ ኡንቲ ኤዛ አብስ ሞትዛኮ ኤሮዳይስ ኮዪ ኡንታን ኡ ሻንግታይኮ ኤዛ ሺሼዛ። <verse eid="ACT 23:28"/><verse number="29" style="v" sid="ACT 23:29"/>ኡንቲ ፋ ህጋይስ ኤዛ ሞቴዛይፕ አትን ኤዛ ዎስዛባዝ ዎይ አጭስዝባዝ ባዛ ታ ደንጌዛ። <verse eid="ACT 23:29"/><verse number="30" style="v" sid="ACT 23:30"/>ኡንቲ Ꮊ አይል አፋ ማቅንቴዝ ዝግርሳይ ታና ሄልን፥ ታኒ ኤልሲ ኤዛ ኔኮ ዳኬዛ። ኤዛ ሞትዝታይ ነ ቲና Ꮊንጊ ሞቶዳይ ጋርክ አዛዜዛ» ዬጌዛ።<verse eid="ACT 23:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 23:31"/>የይ ግሾስ፥ ዎታዳርታ አዛዜዛይ ጋርክ ጳዉሎሳ ኤኪ፥ ቃማ አንትጳጽርሳ ሄልዛ። <verse eid="ACT 23:31"/><verse number="32" style="v" sid="ACT 23:32"/>ዎንት ጋላስ ፓር አስታይ ኤዛ ኤኪ Ꮊማዳይ ጋርክ አሺ ቶኬ አስታይ ጉየ ማቄዛ። <verse eid="ACT 23:32"/><verse number="33" style="v" sid="ACT 23:33"/>ቶጋር የዝ አሳይ ቅሳረ ሄሊ ዳብዳበ ጋደ አቅስዛይስ እንጊ፥ ጳዉሎሳና ኤ ቲና ሺሼዛ። <verse eid="ACT 23:33"/><verse number="34" style="v" sid="ACT 23:34"/>ጋደ አቅስዛይ ዳብዳባ ናባቤዛይፕ ጉየ «ጳዉሎሳ፥ ነ አባ አዉራጃ አሶ?» ግ ኤዛ ኦይጬዛ። ኤ ክልቃ አስ ማቄዛያ ኤሪ <verse eid="ACT 23:34"/><verse number="35" style="v" sid="ACT 23:35"/>«ታኒ ነና ሞትዝታይ ይእኮ ነ ግዛ ስኦዳ» ዬጌዛ። ዎታዳርታይ ጳዉሎሳ ሄሮዶሳ ዛባ ናግንቶዳይ ጋርክ አዛዜዛ።<verse eid="ACT 23:35"/></para>
  <chapter eid="ACT 23"/>
  <chapter number="24" style="c" sid="ACT 24"/>
  <para style="s1">ጳዉሎሳ አይሁድታይ ሞቴዛ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1"/>እችን ጋላሳፐ ጉየ ቄሰ ሀላቃይ ሀናኔ፥ ጭምታይራኔ ጸርጸሉሳ ግዝ ፐቲ አፋካታይር ዎላ ቅሳረ ቅቴዛ። ኡንቲ ጋደ አቅስዛይል አፋ ጳዉሎሳና ሞቴዛ። <verse eid="ACT 24:1"/><verse number="2" style="v" sid="ACT 24:2"/>ጳዉሎሳ ጼግንቲ ገሌዝ ዎደ ጸርጸሉሳ ኤዛ Ꮊይ ጋርክ ዬጊ ሞቴዛ፦</para>
  <para style="p" vid="ACT 24:2">«ቦንቾ ፍልክሳ፥ ኑኒ ነ ባጋር ኡንደና ሳሮት ደንጌዛ፥ ነ ሎኦ አቅሳይድ ኑ ቢታይ ኡንደና ላምንቴዛ። <verse eid="ACT 24:2"/><verse number="3" style="v" sid="ACT 24:3"/>ቦንችንቴዝ ፍልክሳ፥ ኑኒ አባካ አይደካ ማቅን ኡንደና ጋላታር የያ ኤኮዳ። <verse eid="ACT 24:3"/><verse number="4" style="v" sid="ACT 24:4"/>ታኒ ነና ጋምእሰካዛር ኔኒ ነ ኬሄትይር ኑባዝ ኤለር ስኦድ ጋርክ ነና ዎስዛ። <verse eid="ACT 24:4"/><verse number="5" style="v" sid="ACT 24:5"/>Ꮊ አይ በ ማቂ ጋደ ኡባይድ የዝ አይሁድታይ ጋንጨ ጫቦ መ ናዝራውታይ ባጋ አሳ ካልዛ ማቄዛና ኑ ኤሬዛ። <verse eid="ACT 24:5"/><verse number="6" style="v" sid="ACT 24:6"/>ሀራ አቶዝን፥ ጾስ ካራ ቱንሶድ ሀኖዳር ኑ ኤዛ አይኬዛ፤ ኑ ህጋይ ግዛይ ጋርክ ኤዛል አፋ ፕርዶዳይስ ቆፔዛ። <verse eid="ACT 24:6"/><verse number="7" style="v" sid="ACT 24:7"/><note caller="+" style="f"><char style="fr" closed="false">24:7 </char><char style="ft" closed="false">ፓይዶ 24:6 ኑ ህጋይ ግዛይፕ አይኪ ፓይዶ 24:7 ጉጂ Ꮊንጊ 24:8 ባጋ ሄሎዳይስ የዛይ ፐቲ ፐቲ ግርኬ ማጻፍታይድ ባያ።</char></note> ዝን ሻላቃ ሉስዮሳ ይኢ፥ ዎልቃር ኑ ኩሸፐ ኤዛ ከሲ ኤኬዛ። <verse eid="ACT 24:7"/><verse number="8" style="v" sid="ACT 24:8"/>ኤዛር ሞትንትዝታይካ ኔኮ የኦድ ጋርክ ኪቴዛ። ኔኒ ነ ኦማስ Ꮊ አ ፕላጊ ኑ ኤዛ ሞትዛ ሞታ ኡባ ኤሮዳይስ ዳንዳእዛ» ዬጌዛ።<verse eid="ACT 24:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 24:9"/>አይሁድታይካ፥ «Ꮊ ኦዳይ ቱማ» ግ ኤ ቆፋ ማኤዛ።<verse eid="ACT 24:9"/></para>
  <para style="s1">ጳዉሎሳ ሞታይስ ማህ እንጌዛ</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 24:10"/>ጋደ አቅስዛይ ጳዉሎሳ ኦዶድ ጋርክ ማልን ጳዉሎሳ Ꮊይ ጋርክ ዬግ ማሄዛ፦ «ኔኒ ኡንደና ዎደፕ አይኪ፥ Ꮊ አሳይስ ፕርድታር የዛና ኤሪ ታኒ ኦዳይስ ኡፋይሳር ማህ እንግዛ። <verse eid="ACT 24:10"/><verse number="11" style="v" sid="ACT 24:11"/>ታኒ ጎይኖዳይስ የሩሳላመ ኬዝን ታጶ ናምኢ ጋላሳፕ ኣዛና ኔኒ ነ ኦማስ ኤሮዳይስ ዳንዳእዛ። <verse eid="ACT 24:11"/><verse number="12" style="v" sid="ACT 24:12"/>አይሁድታይ ታና ጾስ ካራ ማቅን አይሁደ ዎሳ ካራ ማቅን ካታማ ማቅን ኦራካ ፓላሞዳር ዎይ አስ ሺሺ ሳሮ ብሶዳይስ ቶቦዳር ፐቲ አስካ ታና ደንገካያ። <verse eid="ACT 24:12"/><verse number="13" style="v" sid="ACT 24:13"/>Ꮊተካ ኡንቲ ታና ሞትዛባዛይስ ማርካ ደንጎዳይስ ዳንዳኦያ።<verse eid="ACT 24:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 24:14"/>«ዝን ታኒ ፐትባዝ አማንዛ፤ ታኒ ህገር የዛባዝኔ ናብታይ ጻፌዝ ኡባ ባዝ አማኒ፥ ኑ አድታይ ጾሳ፥ ኡንትካ ዎርዶ ግዝ ኦጋይር ታ ጎይንዛ። <verse eid="ACT 24:14"/><verse number="15" style="v" sid="ACT 24:15"/>ኡንቲ ፋ ኣዳስ አማንዛይ ጋርክ ጽልታይኔ ጽሎባዝታይካ Ꮊይቆፕ ደንዶዳና ታካ አማንዛ። <verse eid="ACT 24:15"/><verse number="16" style="v" sid="ACT 24:16"/>የይ ግሾስ፥ ታኒ ጾስ ቲናኔ አስ ቲና ኡባ ዎደ ሎኦኔ ካሃማ ዋዝና ታስ የዞዳይ ጋርክ ሚንግዛ።<verse eid="ACT 24:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 24:17"/>«ታኒ የሩሳላመፐ ከዜዛይፕ ኡንደና ላይፕ ጉየ ታ ዳቦ ማንቅታይስ ማዴ እማዳይስኔ ያርሾ ያርሾዳይስ የሩሳላመ Ꮊንጌዛ። <verse eid="ACT 24:17"/><verse number="18" style="v" sid="ACT 24:18"/>ታኒ ጾስ ካራ የያ ኡዲ ቃሾ ዎጋ ፖሊ ማቅን ታና ደንጌዛ። የ ዎደ ታራ ጋመ ዎያ ባያ፥ ካችካ ከዘካያ።<note caller="-" style="x"><char style="xo" closed="false">24:17-18 </char><char style="xt" closed="false"><ref loc="ACT 21:17-28">ሀዋ. ኦ. 21:17-28</ref></char></note> <verse eid="ACT 24:18"/><verse number="19" style="v" sid="ACT 24:19"/>ዝን ኢሳፕ የኤዝ ፐቲ ፐቲ አይሁድታይ ኤዛይድ የዛ፤ ኡንቲ ታል አፋ ኦዳ ኮይኮ ይኢ ታና ኔል አፋ ሞቶዳይስ ዳንዳእዛ። <verse eid="ACT 24:19"/><verse number="20" style="v" sid="ACT 24:20"/>ዎይ ታኒ ሻንጎ ቲና ሺቄዝ ዎደ ኦዝ ቡታ የዝኮ Ꮊይትታይ ነ ቲና የዝታይ ኦዶ። <verse eid="ACT 24:20"/><verse number="21" style="v" sid="ACT 24:21"/>‹ታኒ ኡ ጋንጨ ኤቂ፥ Ꮊይቄዝታይ ደንዶዳ› ግ ኡኪ ኦዴዝ ግሾስ Ꮊይኖ ይ ቲና ፕርዳስ ሺቄዛ፥ የይፕ ሀራ ባዝ ኦካያ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">24:21 </char><char style="xt" closed="false"><ref loc="ACT 23:6">ሀዋ. ኦ. 23:6</ref></char></note><verse eid="ACT 24:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 24:22"/>ዝን ፍልክሳ ጎዳይ ኦጋይ ባጋ ጌሺ ኤሬዝ ግሾስ «ታኒ ይ ኦዳ ጋቼዛ» ዬጊ ዎዳ አዱስሴዛ። <verse eid="ACT 24:22"/><verse number="23" style="v" sid="ACT 24:23"/>ማቶ ሀላቃይ ጳዉሎሳና ናግታር ማዶድ ጋርከኔ ኤ ዳብታይፕ ኦንካ ኦይጮዳይስ የኦዳር ካያማይ ጋርክ ማቶ ሀላቃይስ ኪቴዛ።<verse eid="ACT 24:23"/></para>
  <para style="s1">ጳዉሎሳ ፍልክሳ ቲናኔ ድሩስላ ቲና ሺቄዛ</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 24:24"/>ጽቃ ጋላሳፕ ጉየ፥ ፍልክሳ አይሁደ ባጋ ማቄዝ ፋ ማቻት ድሩስላራ ይኢ ጳዉሎሳ ኪቲ ክእሲ ክርስቶሳ የሱስ አማኖ ባጋ ኤፕ ስኤዛ። <verse eid="ACT 24:24"/><verse number="25" style="v" sid="ACT 24:25"/>ጳዉሎሳ ጽሎት ባጋ፥ ፋ ኡባ አቅሶ ባጋኔ የኦዳይስ የዝ ፕርዳ ባጋ ኦዶዳር፥ ፍልክሳ ያሽቲ፥ «ኔኒ Ꮊተስ ቅቶባ ታስ ጊጌዝ ዎደ ነና ጼግሶዳ» ዬጌዛ። <verse eid="ACT 24:25"/><verse number="26" style="v" sid="ACT 24:26"/>የ ዎደ ጳዉሎሳፕ ጉቦ ኤኮዳይስ ቆፒ ኤዛ ማሂ ማሂ ጼጊ ኤሪ ኦድንትዛ።<verse eid="ACT 24:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 24:27"/>ናምኢ ላይፕ ጉየ፥ ፍልክሳ አቃና ጶርቂዮዳ ፍስጾሳ ኤኬዝ። ፍልክሳ አይሁድታ ኡፋይሶዳይስ ከዚ ጳዉሎሳ ብለካ አሼዛ።<verse eid="ACT 24:27"/></para>
  <chapter eid="ACT 24"/>
  <chapter number="25" style="c" sid="ACT 25"/>
  <para style="s1">ጳዉሎሳ ኦሮመ ካታይስ አ ዋርቃተ ጻፈዛ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1"/>ፍስጾሳ ፋ አቅስዛ አዉራጃ ገሊ ሃይን ጋላሳፕ ጉየ ቅሳረፕ የሩሳላመ ከዜዝ። <verse eid="ACT 25:1"/><verse number="2" style="v" sid="ACT 25:2"/>ኤዛይድ ቄሰ ሀላቅታይኔ አይሁድታይ ባይርታይ ጳዉሎሳ ሞቴዛ። <verse eid="ACT 25:2"/><verse number="3" style="v" sid="ACT 25:3"/>ጳዉሎሳና የሩሳላመ ኮኦር ፓስ ሎኦ ባዝ ኦዳይ ጋርክ ግ ፍስጾሳና ኡ ዎሴዛ። የያካ ጌዛይ ኦገል ቆስንቲ ኤዛ ዎዳይስ ኡንትስ ጊጎዳይ ጋርከ <verse eid="ACT 25:3"/><verse number="4" style="v" sid="ACT 25:4"/>ፍስጾሳ ኡንትኮ፥ «ጳዉሎሳ፥ ቅሳረ አች ካራ የዛ፤ ታኒ ታ ኡባስካ ኤልሲ ገድ ጉየ ማቃድ ሀንዛ። <verse eid="ACT 25:4"/><verse number="5" style="v" sid="ACT 25:5"/>ኤ ቡቴዝባዝ የዛኮ ይ ጋንጨ ማዉተር የዝታይ ታር ቅሳረ Ꮊንጊ ኤዛ ሞቶ» ዬጊ ማሄዛ።<verse eid="ACT 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 25:6"/>ፍስጾሳ ኡ አቻ ሆስፑን ዎይ ታጲ ጋላስ ጋርክ ጋምኤዛይፕ ጉየ ቅሳረ ቅቴዛ። ዎንት ጋላስ ፕርዳ ኦይደል በቲ ጳዉሎሳ ኮኦዳይ ጋርክ ኪቴዛ። <verse eid="ACT 25:6"/><verse number="7" style="v" sid="ACT 25:7"/>ኤ ይእን የሩሳላመፕ የኤዝ አይሁድታይ ኤ ካላይድ ኤቂ ኡንቲ ላዳይስ ዳንዳኦዋ ዴጾ ሞቶ ሺሼዛ። <verse eid="ACT 25:7"/><verse number="8" style="v" sid="ACT 25:8"/>ጳዉሎሳ ማሂ፥ «ታኒ አይሁደ ህጋ ማቅን ጾስ ካራ ዎይ ኦሮመ ካታ ቄሳረካ ቆሄካያ» ዬጌዛ።<verse eid="ACT 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 25:9"/>ዝን ፍስጾሳ አይሁድታ ኡፋይሶዳይስ ከዚ ጳዉሎሳኮ፥ «የሩሳላመ Ꮊንጊ Ꮊ ሞታይባጋ ኤዛይድ ታ ቲና ፕርድንቶዳይስ ኮይኔ?» ዬጊ ኦይጬዝ።<verse eid="ACT 25:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 25:10"/>ዝን ጳዉሎሳ፥ «ታኒ ፕርድንቶዳይስ ቤዝዛ ቄሳረ ፕርደ ኬ ኤቄዛ። ኔኒ ሎእ ኤርዛይ ጋርክ ታኒ አይሁድታ አባራካ ቆሄካያ። <verse eid="ACT 25:10"/><verse number="11" style="v" sid="ACT 25:11"/>ይኬ፥ ታኒ ቆሄዝባዝ Ꮊይቆስካ ሄልዛ ባዝ ቡታ ኦዝባዝ ማቅኮ Ꮊይቆፕ ታና አሾባ ጋሚ። ዝን ኡንቲ ታና ሞትዛ ሞታይ ጨረ ማቅኮ ኦንካ ታና ኡንትስ አ እንጎዳይስ ዳንዳኦያ። ቄሳረ ታባዝ ፕርዶ ግ ኦይጭዛ» ዬጌዛ።<verse eid="ACT 25:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 25:12"/>የ ዎደ ፍስጾሳ ፋ ዞራንችታይራ ዞርንቲ፥ «ኔኒ ቄሳረ ታባዝ ፕርዶባ ግ ኦይጬዛ፤ ቄሳረኮ Ꮊንግዛ» ዬጊ ማሄዛ።<verse eid="ACT 25:12"/></para>
  <para style="s1">ጳዉሎሳ አግርጳ ቲናኔ ባርኒቀ ቲና ሺቄዛ</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13"/>ጽቃ ጋላሳፕ ጉየ ካታይ አግርጳኔ ባርኒቀ ፍስጾሳ ሳሮዳይስ ቅሳረ Ꮊንጌዛ። <verse eid="ACT 25:13"/><verse number="14" style="v" sid="ACT 25:14"/>ኤዛይድ ኡንቲ ኡንደና ጋላስ ጋምእን፥ ፍስጾሳ ካዋይስ ጳዉሎሳባጋ Ꮊይ ጋርክ ዬጊ ኦዴዛ፤ «ፍልክሳ ብለካ አሺ Ꮊንጌዝ ፐቲ አይ Ꮊይዳ የዛ። <verse eid="ACT 25:14"/><verse number="15" style="v" sid="ACT 25:15"/>ታኒ የሩሳላመ Ꮊንጌዝ ዎደ ቄሰ ሀላቅታይኔ አይሁደ ጭምታይ ኤዛል አፋ ፕርዶዳይ ጋርክ ታና ዎሲ ኤባዝ ታስ ኦዴዛ። <verse eid="ACT 25:15"/><verse number="16" style="v" sid="ACT 25:16"/>ታኒ፥ ‹ሞትንትዛ አይ ታና ሞትዝታይ ቲና ኤቂ ፋና ሞቴዝባዛይስ ማህ እንገካዝን፥ ኦና ማቅኮካ ኣ እንግንትዛይ ኦሮመ ዎጋ ባያ› ዬጊ ኡንትስ ማሄዛ።<verse eid="ACT 25:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 25:17"/>«የይ ግሾስ፥ ኡንቲ Ꮊይዳ ሺቄዝ ዎደ ታኒ ጋምኤካ ዎንት ጋላስ ፕርደ ኬ ገሊ ጳዉሎሳ ኮኦዳይ ጋርክ ኪቴዛ። <verse eid="ACT 25:17"/><verse number="18" style="v" sid="ACT 25:18"/>ኤዛ ሞትዝታይ ኤ ካንታር ማር ኤቂ፥ ኢታባዛር ኤዛ ሞተካ አሸና ግ ታኒ ቆፔዛይ ጋርክ ኤዛ ሞተካያ። <verse eid="ACT 25:18"/><verse number="19" style="v" sid="ACT 25:19"/>ዝን ኡንቲ ፋ አማኖ ባጋኔ ጳዉሎሳ፥ ‹ኤ ፓ የዛ› ግዝ Ꮊይቄዝ የሱሳ ግንትንትዝ አይ ባጋ ኤዛር ፓላምዛዛ። <verse eid="ACT 25:19"/><verse number="20" style="v" sid="ACT 25:20"/>ታካ Ꮊ ኦዳ ሻኮዳይስ መትዝ ግሾስ ጳዉሎሳ የሩሳላመ Ꮊንጊ፥ ኤዛይድ ፕርድንቶዳይስ ኮይዛኮ ግ ኤዛ ኦይጬዛ። <verse eid="ACT 25:20"/><verse number="21" style="v" sid="ACT 25:21"/>ዝን ጳዉሎሳ ፋ ኦዳ ቄሳረ ብሎድ ሄሎዳይስ አች ኬ ጋምኦዳይስ ኦይጬዛ። ታኒ ኤዛ ቄሳረኮ ዳኮድ ሄሎዳይስ ኤ አጭንቶዳይ ጋርክ ኪቴዛ» ዬጌዛ።<verse eid="ACT 25:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 25:22"/>የይ ግሾስ፥ አግርጳ ፍስጾሳኮ፥ «ታኒ ታ ኡባስካ የ አይ ግዝባዝ ስኦዳይስ ኮይዛ» ዬጌዛ።</para>
  <para style="p" vid="ACT 25:22">ፍስጾሳ ኤኮ፥ «ኔኒ ዎንታ ኤ ግዝባዝ ስኦዳ» ዬጌዛ።<verse eid="ACT 25:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 25:23"/>ዎንት ጋላስ አግርጳኔ ባርንቀ ግታ ቦንቾር ሻላቅታይራኔ ካታማ የዝ ዎልቃማ አስታይር ይኢ ፕርደ ኬ ገሌዛ። ፍስጾሳ ጳዉሎሳ ጼግሲ ከኤዛ። <verse eid="ACT 25:23"/><verse number="24" style="v" sid="ACT 25:24"/>ፍስጾሳ፥ «ካት አግርጳ፥ Ꮊይዳ ኑር የዝ አስታዮ፥ አይሁድታይ የሩሳላመካ Ꮊይ ጋርክ ኡኪ፥ ‹ኤ ይከፕ ጉየ ፓ የዞዳይስ ቤዞያ› ዬጊ፥ ታና ዎሴዝ አ Ꮊያ ይ ብእዛ። <verse eid="ACT 25:24"/><verse number="25" style="v" sid="ACT 25:25"/>ዝን ኤዛ Ꮊይቆስ ሄልዛ ባዝ አብካ ታኒ ደንገካያ። ኤ ፋ ኦማስ፥ ‹ቄሳረ ታባዝ ፕርዶ ዬጊ ኦይጬዛ› ጌዝ ግሾስ ቄሳረኮ ኤዛ ዳኮዳይስ ቆፋ አጬዛ። <verse eid="ACT 25:25"/><verse number="26" style="v" sid="ACT 25:26"/>ታኒ ኤባዝ ታ ካት ቄሳረስ ጻፍስዛ ኦገ አብካ ባያ። የይ ግሾስ፥ ኤባዝ ይ ብእኮ ታ ጻፍዛይ በንቶዳዛኮ ግ ይ ቲና ኡባራካ ካት፥ አግርጳ፥ ነ ቲና ኤዛ ከኤዛ። <verse eid="ACT 25:26"/><verse number="27" style="v" sid="ACT 25:27"/>አብስ ጊኮ፥ አጭንቴዝ አስ ቃ ዳይናስ ኣታር ኤ አብስ ሞትንቴዛኮ ኤርሰካዛር አሽዛይ ታስ ቦዘት ኣዝዛ» ዬጌዛ።<verse eid="ACT 25:27"/></para>
  <chapter eid="ACT 25"/>
  <chapter number="26" style="c" sid="ACT 26"/>
  <para style="s1">ጳዉሎሳ ኣግርጳ ቲና እንጌዝ ማህ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1"/>አግርጳ ጳዉሎሳኮ፥ «ኔኒ ነ ባጋ ኦዶዳይስ ዳንዳእዛ» ዬጌዛ። የ ዎደ ጳዉሎሳ ፋ ኩሸ ደን Ꮊይ ጋርክ ዬጌዛ፦<verse eid="ACT 26:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 26:2"/>«ካት፥ አግርጳ፥ አይሁድታይ ታና ሞቴዝ ባዝ ኡባይስ ማህ እንጎዳይስ Ꮊይኖ ነ ቲና ኤቂታር ታ አንጃይ ሎኦ ግ ቆፕዛ። <verse eid="ACT 26:2"/><verse number="3" style="v" sid="ACT 26:3"/>የይካ ኔኒ አይሁደ ዎጋኔ ፓላማ ኡባ ሎእ ኤርዛ የይ ግሾስ ታና ዳንዳአር ስኦዳይ ጋርክ ታ ነና ዎስዛ።<verse eid="ACT 26:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 26:4"/>«ታኒ ናአትፕ አይኪ ታ አሳይ ጋንጨራኔ የሩሳላመ የዜዝ ታ የሳ አይሁደ ኡባይ ኤርዛ። <verse eid="ACT 26:4"/><verse number="5" style="v" sid="ACT 26:5"/>ታኒ ቲናፕ አይኪ፥ ኑ አማኖ ዎጋ ሚን ናግዛ ፈርሳውታይ ባጋይፕ ማቄዛና ኡንቲ ማርካቶዳይስ ኮይኮ ኤርዛ።<note caller="-" style="x"><char style="xo" closed="false">26:5 </char><char style="xt" closed="false"><ref loc="ACT 23:6">ሀዋ. ኦ. 23:6</ref>፤ <ref loc="PHP 3:5">ፍል. 3:5</ref></char></note> <verse eid="ACT 26:5"/><verse number="6" style="v" sid="ACT 26:6"/>Ꮊተካ ታኒ ጾስ ኑ አድታይስ እንጎድ ጌዝ ኡፋይሳ ናግዛ ግሾስ ሞትንቲ Ꮊይዳ ኤቄዛ። <verse eid="ACT 26:6"/><verse number="7" style="v" sid="ACT 26:7"/>ማ ታጶ ናምኢ ኑ አድታይ ሼሻይ ጾሳ ቃማኔ ጋላስ ሚን ጎይንታር ጾስ እንጎድ ጌዛ ኤኮዳይስ ኡፋይሳር ናግዛ። ካት አግርጳ፥ አይሁድታይ ታና ሞትዛይ ታኒ ኡፋይሳር የያ ናግዛ ግሾስ። <verse eid="ACT 26:7"/><verse number="8" style="v" sid="ACT 26:8"/>ጾስ Ꮊይቄዝታ ደንዛያ ማቄዛይ ይ ካንታ አብስ አማንንቶሳ?<verse eid="ACT 26:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 26:9"/>«ብኒ ታኒ ታ ኡባስካ ናዝረተ የሱሳ ሱን እጽዛ ዳንዳእንቴዝባዝ ኡባ ኦዳይስ ቤዝዛ ግ ቆፔዛ።<note caller="-" style="x"><char style="xo" closed="false">26:9-11 </char><char style="xt" closed="false"><ref loc="ACT 8:3">ሀዋ. ኦ. 8:3</ref>፤ <ref loc="ACT 22:4-5">22:4-5</ref></char></note> <verse eid="ACT 26:9"/><verse number="10" style="v" sid="ACT 26:10"/>ታኒ የሩሳላመ ኦዛይ Ꮊያ። ቄሰ ሀላቅታይፕ ማዉተ ኤኪ ጾሳ አስታይፕ ጋምታ አጭሴዛ። ኡንታን ዎዳር ኡ Ꮊይቆዳና ታ ዶሴዛ። <verse eid="ACT 26:10"/><verse number="11" style="v" sid="ACT 26:11"/>ጋመ ዎደ አይሁደ ዎሳ ኬ ኡባይድ ኡንቲ ሴርንቶዳይ ጋርከኔ የሱሳና ጫዦዳይ ጋርክ ታ ዎጽቴዛ። ታኒ አቆፕ ኣ ኡንታን ካጬዛ ሀራ አቶዝን፥ ሀራ ቢታ ካታምታ ሄሎዳይስ Ꮊንጊ ታ ኡንታን ባይእዛ።<verse eid="ACT 26:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 26:12"/>«ታኒ Ꮊ ኦዳይስ ቄሰ ሀላቅታፕ ማዉተኔ ኪታ ኤኪ ዳማስቆ Ꮊንግዛ። <verse eid="ACT 26:12"/><verse number="13" style="v" sid="ACT 26:13"/>ካታዮ፥ ታኒ ሴታ ጋላስ ኦገል የዝን አዋ ፖኦፕ ሎእ ኣዝ ፖኦ ታ ዩሻይራኔ ታራ Ꮊንግዝታይ ዩሻይር ሳሎፕ ፖኦዳር በኤዛ። <verse eid="ACT 26:13"/><verse number="14" style="v" sid="ACT 26:14"/>ኑኒ ኡባይካ ሳአ ፖኬዝን እብራይስጸ ዶናር፥ ‹ሳኦላ፥ ሳኦላ፥ ታና አብስ ባይኔ? ኔኒ ነና ጫድዛ ብራታ ቃክኮ ነና ቆህዛ› ዬጊ ታስ ኦዶዳር ስኤዛ።<verse eid="ACT 26:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 26:15"/>«ታኒ፥ ‹ጎዳዮ፥ ኔኒ ኦኖ?› ዬጌዛ።</para>
  <para style="p" vid="ACT 26:15">«ጎዳይ፥ ‹ታኒ፥ ኔኒ ባይእዝ የሱሳ፤ <verse eid="ACT 26:15"/><verse number="16" style="v" sid="ACT 26:16"/>ዝን ደንዶባ። Ꮊይኖ ኔኒ በኤዛይፐኔ ቲናፕ ታ ነና ቤዞዳና ሀራስ ማርካቶዳይ ጋርክ ታስ ኦሳንቾ ኡዲ ነና ሹሞዳይስ ኔስ ታ በንቶዳ። <verse eid="ACT 26:16"/><verse number="17" style="v" sid="ACT 26:17"/>እስሬለ አስታይፐኔ ታኒ ነና ኡንትኮ ኪትዛ አይሁደ ባዝታይፕ ነና አሾዳ። <verse eid="ACT 26:17"/><verse number="18" style="v" sid="ACT 26:18"/>ኔኒ ኡ አፋ ዶዮዳይ፥ ማፕ ፖኦኮ፥ ጻላሄ ኩሸፕ ጾስኮ ኡንታን ማሆዳ። ኡንቲ ታና አማኒ ናጋራ አቶት ኤኮዳ። ጾስ ጌሼዝ አሳይ ጋንጨ ፋ ላታ ደንጎዳ› ዬጌዛ።<verse eid="ACT 26:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 26:19"/>«ካት አግርጳ፥ የይ ግሾስ፥ ታስ ሳሎፕ በንቴዝ ቆንጭይስ ኪትንቴዛ። <verse eid="ACT 26:19"/><verse number="20" style="v" sid="ACT 26:20"/>ዝን ታኒ ቲናቲ ዳማስቆ የዝታይ የይፕ ጉየ የሩሳላመኔ ይሁዳ ቢታ ኡቢታይድ የዝታይኔ አይሁደ ባዝታይካ ፋ ናጋራፕ ጾስኮ ማቆዳይ ጋርከኔ ናጋራይፕ ማቆዳይስ ቤዝዛ ኦሶ ኦድ ጋርክ ቃላ ኦዴዛ።<note caller="-" style="x"><char style="xo" closed="false">26:20 </char><char style="xt" closed="false"><ref loc="ACT 9:20">ሀዋ. ኦ. 9:20</ref>፥ <ref loc="ACT 9:28-29">28-29</ref></char></note> <verse eid="ACT 26:20"/><verse number="21" style="v" sid="ACT 26:21"/>የይ ግሾስ፥ አይሁድታይ ታና ጾስ ካራ አይኪ ዎዳይስ ኮዬዛ። <verse eid="ACT 26:21"/><verse number="22" style="v" sid="ACT 26:22"/>Ꮊይኖ ሄሎዳይስ ጾስ ማዴ ታፕ ሻክንተካያ፤ የይ ግሾስ፥ ጽቅታይስኔ ዳምታይስ ማርካትታር Ꮊይዳ ኤቄዛ። ናብታይኔ ሙሰ ሀኖዳ ግ ኦዴዛይፕ ሀራ ፐትባዝካ ታኒ ኦዴዝባዝ ባያ። <verse eid="ACT 26:22"/><verse number="23" style="v" sid="ACT 26:23"/>የይካ፥ ‹ክርስቶሳ ዋየ ኤኮዳይስ ቤዝዛ፤ ማ Ꮊይቆፕ ቲና ደንዲ አይሁድታይስኔ አይሁደ ባዝታይስ ፖኦ ቤዞዳይስ ኤስ ቤዝዛ› ጌዛ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">26:23 </char><char style="xt" closed="false"><ref loc="1CO 15:20">1ቆሮ. 15:20</ref>፤ <ref loc="ISA 42:6">ኢሳ. 42:6</ref>፤ <ref loc="ISA 49:6">49:6</ref></char></note><verse eid="ACT 26:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 26:24"/>ጳዉሎሳ የያ ዬጊ ማሆዳር፥ ፍስጾሳ ፋ ቃላ ቅ ኡዲ፥ «ጳዉሎሳ፥ ነ ኤዬዛ፤ ነ ጋመ ትምርታይ ነና ኤይሶስ ሄልዛ» ዬጌዛ።<verse eid="ACT 26:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 26:25"/>ዝን ጳዉሎሳ፥ «ቦንቾ ፍስጾሳ፥ ታኒ ቱማባዝኔ ቤዝዛ ባዝ ኦድዛፕ አትን ኤየካያ። <verse eid="ACT 26:25"/><verse number="26" style="v" sid="ACT 26:26"/>ታኒ ቆንጨ ኦድዛ ኦዳ ካታይ ኤርዛ። Ꮊ ኦዳይ ጌማ ኦስንተካ ግሾስ ፐታካ ኤፕ ቆስንቲ አታማያ ታኒ ሎእ ኤርዛ።<verse eid="ACT 26:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 26:27"/>«ካት አግርጳ፥ ኔኒ ናብታ አማንኔ? ኔኒ ኡንታን አማንዛና ታኒ ኤርዛ» ዬጌዛ።<verse eid="ACT 26:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 26:28"/>ካታይ አግርጳ፥ ጳዉሎሳኮ፥ «Ꮊ ጽቃ ሳታይድ ታና ክርስታኔ ማሆዳይስ ኮይኔ?» ዬጌዛ።<verse eid="ACT 26:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 26:29"/>ጳዉሎሳ፥ «ጋመ ዎደ ማቅን ጽቃ ዎደ ነ ኣዳ ባዝን Ꮊይኖ ታ ኦዳ ስእዝ ኡባይ Ꮊ አቻይፕ አትን ታ ጋርክ ማቆዳይ ጋርክ ታ ጾስ ዎስዛ» ዬጌዛ።<verse eid="ACT 26:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 26:30"/>የይፕ ጉየ፥ ካት አግርጳ፥ ጋደ አቅስዝ ፍስጾሳ፥ ባርንቀኔ ኡንታር በቴዝ ኡቢታይካ ደንዴዛ። <verse eid="ACT 26:30"/><verse number="31" style="v" sid="ACT 26:31"/>የይፕ ከዚ Ꮊንግታር ፐታይ ፐታይር፥ «Ꮊ አይ Ꮊይቆስ ዎይ አችስ ሄልዛ ባዝ አኮካ ኦካያ» ዬጊ ኦድንቴዛ። <verse eid="ACT 26:31"/><verse number="32" style="v" sid="ACT 26:32"/>አግርጳ ፍስጾሳኮ፥ «Ꮊ አይ ‹ቄሳረ ታባዝ ፕርዶ› ጌካዛኮ ብልንቶዳይስ ዳንዳእዛዝን አቴዛ» ዬጌዛ።<verse eid="ACT 26:32"/></para>
  <chapter eid="ACT 26"/>
  <chapter number="27" style="c" sid="ACT 27"/>
  <para style="s1">ጳዉሎሳ ኦሮመ ቅቴዛ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1"/>ኑኒ ማርካበር ኢጻለ ዳኮዳይስ ኡ ሙርቴዝ ዎደ ካትታይ ካት ዎታዳርታ ግንትንትዝታይፕ ፐቲ ዩልዮሳ ግዝ ማቶ ሀላቃይስ ጳዉሎሳኔ ሀራ ጽቃ አች አስታ እንጌዛ። <verse eid="ACT 27:1"/><verse number="2" style="v" sid="ACT 27:2"/>ኢሳ ላንቀ የዝ ሄርታ Ꮊንጎዳር አድራምጾሳ ማርካበ ገሊ ደንዴዛ። ማቃዶና አስ ማቄዝ ተሰሎንቀ አርስጽሮኮሳ ኑር የዛ።<verse eid="ACT 27:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 27:3"/>ዎንት ጋላስ ኑኒ ስዶና ሄሎዳር፥ ዩሎሳ ጳዉሎሳስ ቃንቲ ፋ ላግታይኮ Ꮊንጊ ኮሽዛ ባዝ ማድንቶዳይ ጋርክ ኡንትኮ ዳኬዛ። <verse eid="ACT 27:3"/><verse number="4" style="v" sid="ACT 27:4"/>የይፕ ደንዲ ኑ ቲናር ጫርክዛ ግሾስ ሃር ተቅንቴዝ ቢታ፥ ቆጲሮሳር ምይ ኣዛ። <verse eid="ACT 27:4"/><verse number="5" style="v" sid="ACT 27:5"/>ክልቃኔ ጵንፍላ የዝ አባ ፒንጊ ሉቃ የዝ ሙራ ሄሌዛ። <verse eid="ACT 27:5"/><verse number="6" style="v" sid="ACT 27:6"/>ኤዛይድ ማቶ ሀላቃይ ኢጻለ Ꮊንግዝ ኢስክንድረ ማርካበ ደንጊ፥ እዘ ኑና ገልሴዛ።<verse eid="ACT 27:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 27:7"/>ኑኒ ጋመ ጋላስ ሎደራ Ꮊንጊ፥ ጋመ ኡንአር ቃንዶሳ ካታማ ካለ ሄሌዛ። ኤዛይር Ꮊንጎዳይስ ኑና ጫርኮ ካይን ሳልሞናር ኣ ሃር ተቅንቴዝ ቢታ፥ ቃርጼሳ ምይ ኣዛ። <verse eid="ACT 27:7"/><verse number="8" style="v" sid="ACT 27:8"/>ጋመ መቶር ጋጻ ጋጻ አይኪ ላሳ ካታማስ ኡከ የዝ ሎኦ ግንትንትዝ ማርካበ ሸምፕዛ ሄራ ከዜዝ።<verse eid="ACT 27:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 27:9"/>ኑኒ ኤዛይድ ኡንደና ዎደ ጋምኤዛይፕ ጉየ ጾማ ዎደ ኣዝ ግሾ፥ ማርካበር Ꮊሞ መትዛ ግሾስ ጳዉሎሳ ኡንታን ዞሬዛ። <verse eid="ACT 27:9"/><verse number="10" style="v" sid="ACT 27:10"/>«ይንታኖ አስታዮ፥ ኑ Ꮊማይ ግታ ቦኔ ጋመ ቆሆ የዛይ ታስ በንትዛ፤ ቆሀይ ጫናል አፋኔ ማርካበል አፋ ኣዳ ባዝን ኑ ሸምፓይል አፋካ ሄሎዳ» ዬጌዛ። <verse eid="ACT 27:10"/><verse number="11" style="v" sid="ACT 27:11"/>ዝን ማቶ ሀላቃይ ጳዉሎሳ ጌዛይፕ ኣ ማርካባ ላግዛይኔ ማርካባ ጎዳይ ግዛ አማኔዛ። <verse eid="ACT 27:11"/><verse number="12" style="v" sid="ACT 27:12"/>የ አባ ዶና የዝ ካታማይ ባልጎ አግና አዳይስ ኡንትስ ጊገካ ግሾስ ጋመ አስታይ ፓስ ዳንዳእንትኮ ፍንቀ ካታማ ሄሊ ባልጎ አጌና ኤዛይድ አዳይስ ዞርንቴዛ። ፍንቀ አዋ ገሎስ ፑደ ባጋፐኔ አዋ ገሎፕ ሱለ ባጋስ ጋንጨ አባ ካንታ የዝ ማርካበ ኤቂ ጫን ዎስዝ አቆ።<verse eid="ACT 27:12"/></para>
  <para style="s1">አባል አፋ ጎተ ደንዴዛ</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 27:13"/>ካዉሻ ሱለ ጫርኮ ሎዳር ጫርኬዝ ዎደ ፋ ቆፔዛይ ጋርክ ሀኔዝባዝ ኣዝን ደንዲ፥ ማርካበ ኤንአማይ ጋርክ አይክዝ ብራታ ኡዴ ኤኪ ቃርጼሳ ካንታር ኣዛ። <verse eid="ACT 27:13"/><verse number="14" style="v" sid="ACT 27:14"/>ዝን ጋመ ጋምኤካዛር «አዉራቅሳ» ግዝ ዎልቃማ ጎተ ሃር ተቅንቴዝ ቢታፕ ሱለ ኡንታል አፋ ደንዴዛ። <verse eid="ACT 27:14"/><verse number="15" style="v" sid="ACT 27:15"/>የ ጎታይ ማርካባ ኡርቂ Ꮊሞ ካዬዝ ግሾስ ጫርካይ ማርካባይ ፋ ዶሴዝ ኦገ ካንጎዳይ ጋርክ አሺ አሼዛ።<verse eid="ACT 27:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 27:16"/>ኑኒ ቄዳ ግዝ ሃር ተቅንቴዝ ቢታ ምይ Ꮊንግታር ጋመ መትንቲ ማርካብት ዎጎልቶ አይኪ አሾዳይስ ዳንዳኤዛ። <verse eid="ACT 27:16"/><verse number="17" style="v" sid="ACT 27:17"/>ኡንቲ ዎጎላ ፑደ ከሴዛይፕ ጉየ ዎዶሮር ማርካባይል አፋ ጻጺ፥ ሚን አጬዛ። ስርቲሳ ግዝ ሻፈል ዶምእንቶዳ ግ ህርጊ፥ ማርካበ ሻራ ዎ ማርካባይ ጨረ ላግንቶድ ጋርክ ዳኪ አሼዛ።<verse eid="ACT 27:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 27:18"/>ጎታይ ዎልቃምታር Ꮊንግን ዎንት ጋላስ ጫናይፕ ባጋ አባ ጋንጨ ኦሎ አይኬዛ። <verse eid="ACT 27:18"/><verse number="19" style="v" sid="ACT 27:19"/>ሃይን ጋላስ ማርካበ ሚሸ ኤኪ ኑ ኩሻይር ጌዛ። <verse eid="ACT 27:19"/><verse number="20" style="v" sid="ACT 27:20"/>ኑኒ ጋመ ጋላስ አዋኔ ጾልንቶ በኤካዛይ ግሾኔ ዎልቃማ ጫርኮ ኑል አፋ ምንጌዝ ግሾስ ቲናፕ ሸምፖር አቶዳ ግ ቆፐካያ።<verse eid="ACT 27:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 27:21"/>የ ዎደ ኡንቲ ኡንደና ጋላስ ካ ሜካ ጋምኤዝ ግሾስ ጳዉሎሳ ኡ ጋንጨ ደንዲ ኤቂ፥ «አስታዮ፥ ይ ታ ዞራ ኤኪ ቃርጼሰፕ ደንደካዛኮ Ꮊ መታይኔ ቆሀይ ኑና ሄላምዝን። <verse eid="ACT 27:21"/><verse number="22" style="v" sid="ACT 27:22"/>ዝን ታኒ ይንታን ያሽትፓተ ግ ዞርዛ፤ አብስ ጊኮ፥ Ꮊ ማርካባይ ቦዳይፕ አትን ይንትፕ ፐቲ አስ ሸምፖካ በና። <verse eid="ACT 27:22"/><verse number="23" style="v" sid="ACT 27:23"/>ዝን ቃማ ታ ኤባዝ ማቄዛይኔ ታ ጎይንዛ ጾሳይ ኪቴዝ ኪታንቻይ ታ ካለ ኤቂ፥ <verse eid="ACT 27:23"/><verse number="24" style="v" sid="ACT 27:24"/>‹ጳዉሎሳ፥ ያሽትፐ፤ ኔኒ ኦሮመ ካታይ ቄሳረ ቲና ኤቆዳይስ ቤዝዛ። ዬዛኮ ጾስ ነ ግሾስ ኔር Ꮊንግዝታ ኔስ እንጌዛ› ዬጌዛ። <verse eid="ACT 27:24"/><verse number="25" style="v" sid="ACT 27:25"/>የይ ግሾስ፥ አስታዮ፥ ያሽፓተ። የ ኪታንቻይ ታስ ኦዴዛይ ሀኖዳና ታኒ ጾሳል አማንንትዛ። <verse eid="ACT 27:25"/><verse number="26" style="v" sid="ACT 27:26"/>ዝን ጫርኮ ኑና ካንጊ ፐቲ ሃር ተቅንቴዝ ቢታ ጋጻ ኦሎዳ» ዬጌዛ።<verse eid="ACT 27:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27"/>ታጶ ኦይዳን ቃማ አድራ አባ ኑና ጫርካይ ገደኔ Ꮊና ኡርቆዳር፥ ግዲ ብላሄ ማቄዝ ዎደ ማርካበ ኦዝታይስ ቢታኮ ኡኬዛ አዜዛ። <verse eid="ACT 27:27"/><verse number="28" style="v" sid="ACT 27:28"/>ኡንቲ ጪሞት ኤሮዳይስ ኮዪ ዎዶሮ ጼራ ዴጽዛባዝ አጪ አባ ጋንጨ ኦልን፥ አባይ ሆስፑን ታም Ꮊ ማቄዛ። ጽቃ ጋምኢ፥ ማሂ ኦልን ኡሱፑንታም Ꮊ ማቄዛ። <verse eid="ACT 27:28"/><verse number="29" style="v" sid="ACT 27:29"/>ኡንቲ አባ ጋጻ የዝ ሹቻር ዶምእንታማይ ጋርክ ያሽቲ፥ ማርካባይ Ꮊንጋማይ ጋርክ አይክዝ ኦይዲ ብራትታ ማርካባይፕ ጉየር አባ ኦሊ፥ ሳአ ዎንቶዳይ ጋርክ ጾስ ዎስዛ። <verse eid="ACT 27:29"/><verse number="30" style="v" sid="ACT 27:30"/>ማርካበል ኦዝታይ ማርካባይፕ ዎጺ ከዚ፥ ማርካባይ Ꮊንጋማይ ጋርክ አይክዝ ብራትታ ማርካባይፕ ቲና ባጋር አባ ኦልዛ ኣዝን ዎጎላ አባ ጋንጨ ኦሌዛ። <verse eid="ACT 27:30"/><verse number="31" style="v" sid="ACT 27:31"/>ጳዉሎሳ ማቶ ሀላቃይኮኔ ዎታዳርታይኮ፥ «የይትታይ ማርካባይድ ሸምፒ በታም እጽኮ ይ አቶዳይስ ዳንዳኦዋ» ዬጌዛ። <verse eid="ACT 27:31"/><verse number="32" style="v" sid="ACT 27:32"/>የይ ግሾስ፥ ዎታዳርታይ ዎጎላይ አጭንቴዝ ዎዶራ ጋቺ ዳኪ አሼዛ።<verse eid="ACT 27:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 27:33"/>ሳአ ዎንቶድ ሀኖዳር ኡቢታይ ካ ማዳይ ጋርክ ጳዉሎሳ አሳይኮ፥ «ይ ካ ሜካ ናግታር Ꮊይኖር ታጶ ኦይዲ ጋላስ ጋምኤዛ። <verse eid="ACT 27:33"/><verse number="34" style="v" sid="ACT 27:34"/>የይ ግሾስ፥ ጽቃ ካ ይ ማዳይ ጋርክ ታ ይንታን ዎስዛ። ይንትስ ሎኦ ማቃዳ፤ ሀራ አቶዝን ይ ኦማ ብናናይፕ ፐታካ ባሚ» ዬጌዛ። <verse eid="ACT 27:34"/><verse number="35" style="v" sid="ACT 27:35"/>ጳዉሎሳ የያ ግ ቦራ ኤኪ ኡባይ ቲና ጾስ ጋላቴዛ፤ ባጺ ሙንታ አይኬዛ። <verse eid="ACT 27:35"/><verse number="36" style="v" sid="ACT 27:36"/>ኡባይ ሚንጊ ፋ ኡባስ ካ ኤኪ ሜዛ። <verse eid="ACT 27:36"/><verse number="37" style="v" sid="ACT 27:37"/>ኑኒ ማርካባይድ የዝታይ ናምኢ ጼታኔ ላፑን ታም ኡሱፑን። <verse eid="ACT 27:37"/><verse number="38" style="v" sid="ACT 27:38"/>ኡንቲ ም ምዤዝ ዎደ ጫኔዝ ግስታ አባ ጋንጨ ኦሊ ማርካባይ ዴጻ ሻዉክሴዛ።<verse eid="ACT 27:38"/></para>
  <para style="s1">ማርካባት መቄዛ</para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 27:39"/>ሳአ ዎንትን ማርካባ ኦሳንችታይ አባ ሄሌዛኮ ኤረካዛር፥ አባ ጋጻ የዝ ሻፈኔ ስልማ በኤዛ። ፓስ ዳንዳእንትኮ ማርካባ የ ስልማይኮ ሺሾዳይስ ቆፔዛ። <verse eid="ACT 27:39"/><verse number="40" style="v" sid="ACT 27:40"/>ዬዚ፥ ማርካባይ Ꮊንጋማይ ጋርክ አይክዝ ብራትታ ብልእ አባ ጋንጨ ኦሌዛ። የ ዎደ ላግዛ ም አጭዝ ዎዶራ ብልኤዛ። የይፕ ጉየ፥ ጫርካይ ማርካባ ቲና ኡርቆዳይ ጋርክ ማርካባ ካንግዛ ሻራ ቲና ባጋር ቅ ኡዲ Ꮊሞ አይኬዛ። <verse eid="ACT 27:40"/><verse number="41" style="v" sid="ACT 27:41"/>ዝን ማርካባይ ሻፈ ደር ዶምእንቲ ምትንቴዛ። ማርካባይስ ቲና ባጋይ ሞግንቲ ኤንአም እጽን፥ ጉየ ባጋይ ዙሎ ኡርቅይፕ ደንዲ መቅቶ አይኬዛ።<verse eid="ACT 27:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 27:42"/>ዎታዳርታይ አች አሳይፕ ፐታካ ሃ Ꮊ ኬዛማይ ጋርክ ኡንታን ዎዳይስ ቶቤዛ። <verse eid="ACT 27:42"/><verse number="43" style="v" sid="ACT 27:43"/>ዝን ማቶ ሀላቃይ ጳዉሎሳ አሾዳይስ ቆፕ ዎታዳርታይ ቶባ እጼዛ። ሃ Ꮊ ኤርዛ ኡባይ ማርካባይፕ ሃይድ ዶንጊ ዶንጊ ዎ ቲናቲ ጋጻ ከዞዳይ ጋርክ ኪቴዛ። <verse eid="ACT 27:43"/><verse number="44" style="v" sid="ACT 27:44"/>አቴዝታይ ሳንቃል አፋኔ፥ ማርካበ መቃይል አፋ ከዞዳይ ጋርክ ኪቴዛ ኡባይ ጋጻ ሳሮር ከዜዝ።<verse eid="ACT 27:44"/></para>
  <chapter eid="ACT 27"/>
  <chapter number="28" style="c" sid="ACT 28"/>
  <para style="s1">ጳዉሎሳ ማላጻ ግዝ ሃር ማርንቴዝ ቢታ ቅቴዛ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1"/>ኑኒ ጋጻ ሳሮ ከዜዝ ዎደ ሄሌዝ ሃር ተቅንቴዝ ቢታይ ማላጻ ግንትንትዛና ኤሬዛ። <verse eid="ACT 28:1"/><verse number="2" style="v" sid="ACT 28:2"/>ማላጻ አሳይ ኑና ቃ ኡፋይሳር ኤኬዛ። እራ ቡክዛ ግሾኔ ሜግዛ ግሾስ ታማ ኤ ኑና ኡባ ሞኬዛ። <verse eid="ACT 28:2"/><verse number="3" style="v" sid="ACT 28:3"/>ጳዉሎሳ ጋመ አፍራ ሺሺ ታማ ጋዶዳር፥ ሾሺ ታማይ ምቼዝ ግሾስ ከዚ ኤ ኩሻይል አፋ ጻጽንቲ ኤዛ ዱኬዛ። <verse eid="ACT 28:3"/><verse number="4" style="v" sid="ACT 28:4"/>ማላጻ አሳይ ሾሺ ጳዉሎሳ ኩሻይል ጻጽንቴዛ ብኢ ፐታይ ፐታይኮ፥ «ቱማ Ꮊ አይ ሸምፖ ዎዝ አስ፤ ሀራ አቶዝን አባፕ ኤ አትንካ ጾሳ ፕርዳይፐ አቲ ፓ የዞዳይስ ዳንዳኤካያ» ዬጌዛ። <verse eid="ACT 28:4"/><verse number="5" style="v" sid="ACT 28:5"/>ዝን ጳዉሎሳ ፋ ኩሻይፕ ሾሻ ዉጻርኪ፥ ታማ ኦሌዛ፤ ኤዛ አኮካ ቆሄካ። <verse eid="ACT 28:5"/><verse number="6" style="v" sid="ACT 28:6"/>ኡንቲ፥ «ኤ አሰትይ አይደፕ አይደ፥ ኤልዛ ዎይ ፖኪ Ꮊይቅዛ» ግ ናግዛ። ዝን ኡንደና ዎደ ናጌዝን ኤ አሰትይል አብካ ላምንቴዝባዝ ብን፥ «Ꮊይ ቱማ ጾሰ» ዬጊ ፋ ቆፋ ላሜዛ። <verse eid="ACT 28:6"/><verse number="7" style="v" sid="ACT 28:7"/>የ ሄራ ሃር ተቅንቴዝ ቢታይስ ሀላቃ፥ ፑፕሎሳ ግዛይስ ጋደ የዛ፤ ሀይ ጋላስ ሄሎዳይስ ኤ ኑና ሲቆር ሞኬዛ። <verse eid="ACT 28:7"/><verse number="8" style="v" sid="ACT 28:8"/>ፑፕሎሳ አዳይ ኦጸ፥ ምሻራኔ ጉሶር ሀርግንቲ ዎይኢ የዛ። ጳዉሎሳ ኤ ካራ ገሊ ኤስ ጾሳ ዎሴዛ፤ ፋ ኩሻ ኤዛል አፋ ጋዲ ፓዛ። <verse eid="ACT 28:8"/><verse number="9" style="v" sid="ACT 28:9"/>የይፕ ጉየ፥ ማላጻ የዝ ሀርግንትዛ ሀራ አስታይካ ይኢ ፓጼዛ። <verse eid="ACT 28:9"/><verse number="10" style="v" sid="ACT 28:10"/>ኡንቲ ኑና ጋመ ቦንቼዛ፤ ኑኒ ማርካበር Ꮊንጎዳይስ ደንዴዝ ዎደ ኦገስ ቤዝዛ ባዝ ኑስ እንጌዛ።<verse eid="ACT 28:10"/></para>
  <para style="s1">ጳዉሎሳ ማላጻፕ ኦሮመ ቅቴዛ</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11"/>ሀይ አጌናፕ ጉየ፥ ማላጻ ባልጎ ኣ ኢስክንድረ ማርካበር Ꮊማዳይስ ደንዴዛ። የ ማርካባይል አፋ ድዮስቆሮሳ ግዝ መንተ ኤቅታይ ምስለ የዛ። <verse eid="ACT 28:11"/><verse number="12" style="v" sid="ACT 28:12"/>ስራኩሰ ካታማ ገሊ ኤዛይድ ሀይ ጋላስ በቴዛ። <verse eid="ACT 28:12"/><verse number="13" style="v" sid="ACT 28:13"/>የይፕ ደንዲ ረግዩመ ካታማ ሄሌዛ። ፐቲ ጋላሳፕ ጉየ፥ ሱለ ባጋ ጫርካይ ጫርክን፥ ዎንት ጋላስ ፑትዮለ ካታማ ሄሌዛ። <verse eid="ACT 28:13"/><verse number="14" style="v" sid="ACT 28:14"/>ኤዛይድ ኑኒ ፐቲ ፐቲ አማንዛ አስታ ደንግን፥ ፓር ሳምንታ ጋምኦድ ጋርክ ኑና ዎሴዛ። የይፕ ጉየ፥ ኦሮመ Ꮊንጌዛ።<verse eid="ACT 28:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 28:15"/>ኦሮመ የዝ አማንዛ አስታይ ኑ ባጋ ስኢ፥ ኣፎሳ ፋሩስናኔ፥ ሀይ አቅዛ አቆ ግዝ አቆ ሄሎዳይስ ኑና ሞኮዳይስ የኤዛ። ጳዉሎሳ ኡንታን ብኢ ጾሳ ጋላቴዛ ኤ ዎዝናይካ ሚንጌዛ።<verse eid="ACT 28:15"/></para>
  <para style="s1">ጳዉሎሳ ኦሮመ</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 28:16"/>ኑኒ ኦሮመ ገሌዝ ዎደ ጳዉሎሳ ፋና ናግዛ ዎታዳርታይር ፋ ኣዳስ በቶድ ጋርክ ግንትንቴዛ።<verse eid="ACT 28:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 28:17"/>ሀይ ጋላሳፕ ጉየ፥ ጳዉሎሳ አይሁድታይ ሀላቅታ ፋኮ ጼግሴዛ። ኡንቲ ሺቄዝ ዎደ ኡንትኮ፥ «ታ እሹን፥ ታኒ ኑ አሳይ ዎይ ኑ አድታይ ዎጋል አፋ አባ ቆሆካ ኦካያ፥ ዝን ታና የሩሳላመ አጪ ኦሮመ አሳይስ ኣ እንጌዛ። <verse eid="ACT 28:17"/><verse number="18" style="v" sid="ACT 28:18"/>ኡንቲ ታ ሞታ ብኢ Ꮊይቆስ ሄልዛ ባዝ ታል አፋ አብካ ደንገካ ግሾስ ታና ብልኦዳይስ ቆፔዛ። <verse eid="ACT 28:18"/><verse number="19" style="v" sid="ACT 28:19"/>ዝን አይሁድታይ የያ እጽን ‹ታባዝ ቄሳረ ፕርዶ› ዬጌዛፕ አትን ታኒ ታ ጋድታ ሞትዛባዝ የዝን ባያ። <verse eid="ACT 28:19"/><verse number="20" style="v" sid="ACT 28:20"/>ታኒ ይንታን ጼግሴዛይ ይንታን በአዳይስኔ ይንትስ Ꮊያ ኦዶዳዳይሲ። ታኒ Ꮊ ሳንላታይር አጭንቴዛይ እስሬለ አሳይ ናግዛ ኡፋይሳይ ግሾስ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">28:20 </char><char style="xt" closed="false"><ref loc="ACT 25:11">ሀዋ. ኦ. 25:11</ref></char></note><verse eid="ACT 28:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 28:21"/>አይሁደ ሀላቅታይ ጳዉሎሳኮ፥ «ኑስ ይሁዳፕ ኔስ ጻፍንቴዝ ዳብዳበ ሄለካያ። የይፕ የኤዝ አስታይፕ ፐታካ ኔስ ኢታ ኦዴዛይ ባያ። <verse eid="ACT 28:21"/><verse number="22" style="v" sid="ACT 28:22"/>ዝን Ꮊ ነ ካልዛ አማና ዱማ ዱማ አቆ አሳይ እጽዛና ኑኒ ኤርዛ ግሾስ ነ ቆፋ ስኦዳይስ ኮይዛ» ዬጌዛ።<verse eid="ACT 28:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23"/>ኡንቲ ፋ የኦድ ጋላስ ጳዉሎሳስ ቃማ ኤኪ፥ የ ጋላስ ጋንጊ ኤ የዛ አቆ የኤዛ። ኤ ዎንታፕ ኦማ ሄሎዳይስ ጾስ ካተት ባጋ ኡንትስ ማርካቴዛ። ማ ኡንቲ የሱሳ ባጋ አማኖዳይ ጋርክ ሙሰ ህገኔ ናብታይ ማጻፍታ ሎእ ታማሬዛ። <verse eid="ACT 28:23"/><verse number="24" style="v" sid="ACT 28:24"/>ፐታይ ፐታይ ጳዉሎሳ ጌዛና አማኔዛ፥ ዝን Ꮊንክታይ አማነካያ። <verse eid="ACT 28:24"/><verse number="25" style="v" sid="ACT 28:25"/>ኡንቲ ዎል ጋንጨ ኦዳይል ማኣም እጼዛይፕ ጳዉሎሳ ፐትባዝ ጌዛይፕ ጉየ Ꮊንጌዛ። ኤ Ꮊይ ጋርክ ዬጌዛ፦ «ጌሻ አያናይ ኑ አድታይስ ናበ ኢስያሳ ዶናር ኦዴዛይ ቱማ።<verse eid="ACT 28:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 28:26"/>«‹ኔኒ Ꮊ አሳይኮ Ꮊንጊ፥</para>
  <para style="q2" vid="ACT 28:26">ይ ስስ ስእዛ፥ ዝን አካኮያ፤</para>
  <para style="q1" vid="ACT 28:26">ይ በኦ ብእዛ፥ ዝን ደንጎያ።<note caller="-" style="x"><char style="xo" closed="false">28:26-27 </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">ኢሳ. 6:9-10</ref></char></note><verse eid="ACT 28:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 28:27"/>Ꮊ አሳይ ዎዝናይ ሙሜዛ፤</para>
  <para style="q2" vid="ACT 28:27">ኡ ሀያይ ቱሌዛ፤</para>
  <para style="q2" vid="ACT 28:27">ኡ ኣፋይካ ጎዝንቴዛ።</para>
  <para style="q1" vid="ACT 28:27">የይ ባዛኮ፥</para>
  <para style="q2" vid="ACT 28:27">ኡንቲ ፋ ኣፋይር ብኢ፥</para>
  <para style="q2" vid="ACT 28:27">ፋ ሀያይር ስኢ፥ ፋ ዎዛናይር አካኪ፥</para>
  <para style="q2" vid="ACT 28:27">ታኮ ማቆዳዝን፤</para>
  <para style="q2" vid="ACT 28:27">ታካ ኡንታን ፓዳዝን› ዬጎባ» ዬጌዛ።<verse eid="ACT 28:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 28:28"/>«ይኬ፥ Ꮊይ ጾስ አቶት ኪታይ አይሁደ ባዝታይስ ማቄዛና ኤርዛ። ኡንትካ ስኦዳ» ዬጌዛ።<verse eid="ACT 28:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 28:29"/>ጳዉሎሳ የያ ጌዛይፕ ጉየ አይሁድታይ ዎል ጋንጨ ዳሮ ፓላምታር ከዚ ቅቴዛ።<verse eid="ACT 28:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 28:30"/>ጳዉሎሳ ከራ ኬ ናምኢ ላይ ሙዳ በቴዛ፤ ኤዛይድ የዛር ፋኮ የኤዝታ ኡባ ሞክዛ። <verse eid="ACT 28:30"/><verse number="31" style="v" sid="ACT 28:31"/>ያሻ ባይኔ ኦካ ካየካዝን ጾስ ካተትባዝ ሳባኬዛ፤ ጎዳ የሱስ ክርስቶሳ ባጋ ምልጽ ኡዲ ታማርሴዛ።<verse eid="ACT 28:31"/></para>
  <chapter eid="ACT 28"/>
</usx>
