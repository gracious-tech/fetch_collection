<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="HEB" style="id">- Melo New Testament Ethiopic</book>
  <para style="h">እብራወ</para>
  <para style="toc1">ኢብራወ አሳይስ ጻፍንቴዝ ኪታ</para>
  <para style="toc2">እብራወ</para>
  <para style="toc3">እብራ.</para>
  <para style="mt1">እብራወ አሳይስ ጻፍንቴዝ ኪታ</para>
  <para style="imt">ገሎ</para>
  <para style="ip">Ꮊ ኪታይ ጻፍንቴዛይ፥ ዴጾ መቶ ሄልን፥ ፋ አማና አሾዳይስ ሄሌዝ አማንዛ አሳይሲ። Ꮊ ማጻፍቶ ጻፌዛይ፥ የሱስ ክርስቶሳ ዉርስኔ ቱማ ጾስ ቆንጭ ማቄዛና እብራወ አሳይስ ቤዝዛ። የ አማንዛ አሳይ ፋ አማናይድ ሚንጎዳይ ጋርክ ኡንታን ምንዛ። ኤ የያ ኡድታር ሀይዝ ቱምታ ኣ ቤዝዛ።</para>
  <para style="ili">1. የሱሳ ፋ ኤኬዝ መታይድ አዳይስ ቱማ ኪትንቴዝ መና ጾስ ናአ። ኤ ጾስ ናአ ማቄዝ ግሾስ ጭማ ጫቆ ዎደ የዝ ናብታይፐ፥ ኪታንችታይፐኔ ሙሰፐ ሎእ ኣዛ።</para>
  <para style="ili">2. የሱሳ ጭማ ጫቆ ቄስታይፕ ኡባር ኣዝ መና ቄሰ ማቄዛና ጾሲ ፋ ኦማስ ማርካቴዛ።</para>
  <para style="ili">3. የሱሳ ባጋር አማንዛ አስ ናጋራፐ፥ ያሻፐነ Ꮊይቆፐ አትዛ። የሱሳ ቄሰ ሀላቃ ማቄዛ፥ ቲና እብራውታይ አማኖ ዎጋኔ መሄ ያርሾር ኤሾ ጋርክ በንትዝ አቶት Ꮊት ቱማ ኦዛ።</para>
  <para style="ip">ጻፋይ እስሬለ አሳይ ታርከኔ ዋረር የዝ አሳይ አማኖ ኣዝሶ ኡዲ ኤኪ (ሸም 11) Ꮊ ማጻፍቶ ናባብዛ አስታይ ፋ አማናይድ ሚንጎዳይ ጋርክ አካክስዛ። የይ ጋርከካ፥ ሸምፖ 12 ናባብዝታይ ፋ አፋ የሱሳ አፋ ጋዲ፥ ፋ አማናይድ ሚንጎዳይ ጋርከኔ አባ መቶኔ ዋየ ሄልኮካ፥ ኡንቲ ጋርዦዳይ ጋርክ ዞርዛ። ዉርስ ዞራይዳኔ አካክሶ ቃላይድ ፋ ኪታ ኣዛ።</para>
  <para style="iot">እብራወ ኪታይ አይኬዝ ቆፍታ</para>
  <para style="io1">ገሎ፦ ጾሲ ክርስቶሳር ቆንጬዛ <char style="ior"><ref loc="HEB 1:1-3">1:1-3</ref> </char></para>
  <para style="io1">ክርስቶሳ ኪታንችታይፕ አፋ <char style="ior"><ref loc="HEB 1:4-2:18">1:4—2:18</ref> </char></para>
  <para style="io1">ክርስቶሳ ሙሰፐኔ ኢያሶፕ ኣ <char style="ior"><ref loc="HEB 3:1-4:13">3:1—4:13</ref> </char></para>
  <para style="io1">ክርስቶሳ ቄሰትይ ኡባይፕ ኣ <char style="ior"><ref loc="HEB 4:14-7:28">4:14—7:28</ref> </char></para>
  <para style="io1">ክርስቶሳ ቃላ ጫቃይ ኡባፕ ኣ <char style="ior"><ref loc="HEB 8:1-9:22">8:1—9:22</ref> </char></para>
  <para style="io1">ክርስቶሳ ያርሽንታይ ፑጫ <char style="ior"><ref loc="HEB 9:23-10:39">9:23—10:39</ref> </char></para>
  <para style="io1">አማኖ ባይራት <char style="ior"><ref loc="HEB 11:1-12:29">11:1—12:29</ref> </char></para>
  <para style="io1">ጾስ ኡፋይሶ <char style="ior"><ref loc="HEB 13:1-19">13:1-19</ref> </char></para>
  <para style="io1">ዉርስ ዎሳ <char style="ior"><ref loc="HEB 13:20-22">13:20-22</ref> </char></para>
  <para style="io1">አንጆኔ ኩስተ <char style="ior"><ref loc="HEB 13:22-25">13:22-25</ref> </char></para>
  <chapter number="1" style="c" sid="HEB 1"/>
  <para style="s1">ናአይ ኪታንችታይፕ ኣ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1"/>ብኒ ብንኮ ጾስ፥ ኑ አድታይስ ናብታይ ባጋር ዱማ ዱማ ኦገር ጋመ ዎደ ኦዴዛ። <verse eid="HEB 1:1"/><verse number="2" style="v" sid="HEB 1:2"/>ዝን Ꮊ ዉርስ ዎደ ኡባ ባዝ ኤዛ ላትሴዝ፥ ማ አላማካ ኤ ባጋር መዝ ፋ ናአይ ባጋር ኑስ ኦዴዛ። <verse eid="HEB 1:2"/><verse number="3" style="v" sid="HEB 1:3"/>ናአይ ጾስ ቦንቾ ፖጭኔ ሀናይር ሙመር ጾስ ኣዚ ኩን ጾስ ጾሳት ኤኪ፥ ፋ ማዉተ ቃላይር Ꮊ አላማ ሚን አይኬዛ። አሳ ኡ ናጋራይፕ ሻግሼዛይፕ ጉየ ኡባፕ አፋ ጾስ ኡሻች ሳሎ በቴዛ።<verse eid="HEB 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 1:4"/>ኤስ እንግንቴዝ ሱንይ ኪታንችታይ ሱንይፕ ኣ ማቄዛይ ጋርክ ኤ ኡንታፕ ሎእ ኣዝ ግሾሲ። <verse eid="HEB 1:4"/><verse number="5" style="v" sid="HEB 1:5"/>ይኬ፥ ጾስ ኪታንችታይፕ ኦኮ፥</para>
  <para style="q1" vid="HEB 1:5">«ኔኒ ታ ናአ፤</para>
  <para style="q2" vid="HEB 1:5">ታ Ꮊይኖ ኔስ አደ ማቄዛ» ዬጌኔ?</para>
  <para style="m" vid="HEB 1:5">ዎይ ኦኮ፥</para>
  <para style="q1" vid="HEB 1:5">«ታኒ ኤስ አደ ማቆዳ፤</para>
  <para style="q2" vid="HEB 1:5">ኤካ ታስ ናአ ማቆዳ» ዬጌኔ?<note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="PSA 2:7">ማዝ. 2:7</ref>፤ <ref loc="2SA 7:14">2ሳም. 7:14</ref>፤ <ref loc="1CH 17:13">1ዜና. 17:13</ref></char></note><verse eid="HEB 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 1:6"/>ማ ጾሲ ፋ ባይራ ናአ Ꮊ አላመ ኪትታር፥</para>
  <para style="q1" vid="HEB 1:6">«ጾስ ኪታንችታይ ኡባይ ኤስ ጎይኖ»</para>
  <para style="m" vid="HEB 1:6">ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="DEU 32:43">ናምእ. 32:43</ref></char></note> <verse eid="HEB 1:6"/><verse number="7" style="v" sid="HEB 1:7"/>ጾስ ኪታንችታይ ባጋ ኦድታር፥</para>
  <para style="q1" vid="HEB 1:7">«ጾሲ ፋ ኪታንችታ ጫርክታ፥</para>
  <para style="q2" vid="HEB 1:7">ፋ አይልታ ታማ ላ ኡድዛ»</para>
  <para style="m" vid="HEB 1:7">ዬግዛ።<note caller="-" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="PSA 104:4">ማዝ. 104:4</ref></char></note> <verse eid="HEB 1:7"/><verse number="8" style="v" sid="HEB 1:8"/>ዝን ፋ ናአይ ባጋ ኦድታር፥</para>
  <para style="q1" vid="HEB 1:8">«ጾሶ፥ ነ ካተትይ መናስ የዝዛ።</para>
  <para style="q2" vid="HEB 1:8">ነ ካተት ነ ጽሎትር አቅሶዳ።<note caller="-" style="x"><char style="xo" closed="false">1:8-9 </char><char style="xt" closed="false"><ref loc="PSA 45:6-7">ማዝ. 45:6-7</ref></char></note><verse eid="HEB 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9"/>ኔኒ ጽሎት ዶሴዛ፤ ኢታት እጼዛ።</para>
  <para style="q2" vid="HEB 1:9">ጾሳይ፥ ነ ጎዳይ፥ ነና ነ ዣምታይፕ ኣ ዶሬዛ፥</para>
  <para style="q2" vid="HEB 1:9">ኡፋይስ ዛይተ<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="fqa" closed="false">ኡፋይስ ዛይተ፦ </char><char style="ft" closed="false">ኤ ካዉትዛ ዎደ አሳይ ኡፋይሳር እልሊ ኤዛ ካዉትስዛ ቤዝዛ።</char></note> ነና ትዤዛ»</para>
  <para style="m" vid="HEB 1:9">ዬግዛ።<note caller="-" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="PSA 61:1">ማዝ. 61:1</ref>፥ <ref loc="PSA 61:3">3</ref></char></note> <verse eid="HEB 1:9"/><verse number="10" style="v" sid="HEB 1:10"/>ጾሲ ማሂ፥</para>
  <para style="q1" vid="HEB 1:10">«ጎዳዮ፥ ቲና ኔኒ ሳአ መዛ፤</para>
  <para style="q2" vid="HEB 1:10">ሳልታይ ነ ኩሸ ኦስታ።<verse eid="HEB 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11"/>የይትታይ ኡባይ ቦዳ፤</para>
  <para style="q2" vid="HEB 1:11">ዝን ኔኒ የዞዳ።</para>
  <para style="q2" vid="HEB 1:11">ኡንቲ ኡባይ አፍላ ጋርክ ዉሮዳ።<verse eid="HEB 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12"/>ኔኒ ኡንታን ሳልነ ጋርክ ጻጾዳ፤</para>
  <para style="q2" vid="HEB 1:12">ማ ኡንቲ አፍላ ጋርክ ላምንቶዳ።</para>
  <para style="q1" vid="HEB 1:12">ዝን ኔኒ ኡባ ዎደ ነና፤</para>
  <para style="q2" vid="HEB 1:12">ነ ላይታይስካ ዉርስ ባያ»</para>
  <para style="m" vid="HEB 1:12">ዬግዛ።<note caller="-" style="x"><char style="xo" closed="false">1:10-12 </char><char style="xt" closed="false"><ref loc="PSA 102:25-27">ማዝ. 102:25-27</ref></char></note> <verse eid="HEB 1:12"/><verse number="13" style="v" sid="HEB 1:13"/>ዝን ጾሲ ኪታንችታይፕ ኦኮ፥</para>
  <para style="q1" vid="HEB 1:13">«ታኒ ነ ሞርክታ ነ ቶካይ</para>
  <para style="q2" vid="HEB 1:13">የዝ አቆ ኡዶድ ሄሎዳይስ፥</para>
  <para style="q2" vid="HEB 1:13">Ꮊይዳ ታፕ ኡሻች ባጋር በቶባ» ዬጌኔ?<note caller="-" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="PSA 110:1">ማዝ. 110:1</ref></char></note><verse eid="HEB 1:13"/></para>
  <para style="m">
    <verse number="14" style="v" sid="HEB 1:14"/>ኪታንችታይ ኡባይ አቶት ደንጎዳይስ የዝ አስታ ማዶዳይስ ጾስ ኪቴዝ አያንታ ባሳኔ?<verse eid="HEB 1:14"/></para>
  <chapter eid="HEB 1"/>
  <chapter number="2" style="c" sid="HEB 2"/>
  <para style="s1">ዳማ አቶት</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1"/>የይ ግሾስ፥ ኑኒ ስኤዝ ቱማይፕ ሀራ ባዝ ኑና ኤካማይ ጋርክ የ ኑ ስኤዛና ሚን ናጎዳይስ ቤዝዛ። <verse eid="HEB 2:1"/><verse number="2" style="v" sid="HEB 2:2"/>ይኬ፥ ኪታንችታይ ባጋር ኦድንቴዝ ቃላይ ቱማ ማቅኮ፥ ኤዛ ለቆኔ ኪትንታም እጻይ ፕርዳ ክእዛባዝ ማቅኮ፥ <verse eid="HEB 2:2"/><verse number="3" style="v" sid="HEB 2:3"/>የዝን፥ ኑኒ Ꮊይ ጋርክ ግታ አቶት እጽኮ፥ ዋይዚ ቡቲ አቶዴ? ቲና ጎዳይ ፋ ኦማስ የ አቶት ኦዴዛ፤ ማ ኤፕ ስኤዝታይ ኑስ ጌሺ ማርካቴዛ። <verse eid="HEB 2:3"/><verse number="4" style="v" sid="HEB 2:4"/>ማ ጾሲ ማልታይር፥ ኦሮባዝታይር፥ ዱማ ዱማ ማላ ባዝታይዳኔ ፋ ሸነ ጋርክ እንጌዝ ጌሻ አያና እሞትታይር ማርካት ሚንዛ።<verse eid="HEB 2:4"/></para>
  <para style="s1">የሱሳ አስ አቶትስ ኩስተ</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5"/>ጾሲ Ꮊ ኑኒ ኦድዛ ቲናፕ የኦድ አላማ፥ ኪታንችታይስ ሞድሰካያ። <verse eid="HEB 2:5"/><verse number="6" style="v" sid="HEB 2:6"/>ጌሻ ማጻፋይ ፐቲ አቆ Ꮊይ ጋርክ ዬግዛ፦</para>
  <para style="q1" vid="HEB 2:6">«ኔኒ አስስ ቆፖዳይስ አስ ናአ አባ ባዞ?</para>
  <para style="q2" vid="HEB 2:6">ዎይ ኔኒ ኤዛ ናጎዳይስ አስ ናአ አባ ባዞ?<note caller="-" style="x"><char style="xo" closed="false">2:6-8 </char><char style="xt" closed="false"><ref loc="PSA 8:4-6">ማዝ. 8:4-6</ref></char></note><verse eid="HEB 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7"/>ነ ኤዛ ኪታንችታይፕ ጽቃር ላፍዛ፤</para>
  <para style="q2" vid="HEB 2:7">ኤ ኦማይል ቦንቾኔ ጋላታ ዛዉደ ጋዴዛ።<verse eid="HEB 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HEB 2:8"/>ማ ኡባ ባዝ ኤ ቶኬ ኦሞ ጋዴዛ»</para>
  <para style="m" vid="HEB 2:8">ዬግዛ። ጾሲ ኡባ ባዝ ኤስ ሞድሴዝ ዎደ ኤስ ሞድንቴካ አብካ ባያ። ዝን Ꮊት ኡባ ባዝ ኤስ ሃርንቶዳር ኑኒ ሀጋ በኤካያ። <verse eid="HEB 2:8"/><verse number="9" style="v" sid="HEB 2:9"/>ዝን ኑኒ ኪታንችታይፕ ጽቃር ላፌዛ የሱሳ ጾስ ኣ ኬሃትይፕ ደንዴዛይድ የሱሳ አስ ኡባይስ Ꮊይቄዛ። ኤ ዋየ Ꮊይቆ Ꮊይቄዝ ግሾስ ቦንቾኔ ጋላታ ዛዉደ ኤ ኦማይል ጋድን በአዳ። <verse eid="HEB 2:9"/><verse number="10" style="v" sid="HEB 2:10"/>ኡባ ባዝ ኤፐኔ ኤስ መንቴዛይ፥ ጋመ ናእታ ፓር ቦንቾኮ ኮኦዳይስ ኡንትስ አቶት ኩስተኔ ዋዬር ፎሎ ማቃዳይ ጋርክ ኦዳይስ ኤስ ቤዝዛ።<verse eid="HEB 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 2:11"/>የሱሳኔ Ꮊ ኤ ጌሼዝ አሳይ ኡባይ ፐቲ አዳይ ናእታ። የሱሳ ኡንታን፥ «ታ እሹን» ግ ጼጎዳይስ ዬላተካዛይ የይሲ። <verse eid="HEB 2:11"/><verse number="12" style="v" sid="HEB 2:12"/>የሱሳ፥</para>
  <para style="q1" vid="HEB 2:12">«ታኒ ነ ሱን ታ እሽታይስ አዋጆዳ፤</para>
  <para style="q2" vid="HEB 2:12">ዎያ ጋንጨ ነና የር ጋላቶዳ»</para>
  <para style="m" vid="HEB 2:12">ዬግዛ።<note caller="-" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="PSA 22:22">ማዝ. 22:22</ref></char></note> <verse eid="HEB 2:12"/><verse number="13" style="v" sid="HEB 2:13"/>ማ ኤ፥ «ታኒ ኤዛል አፋ አማንቶዳ» ዬግዛ። ማካ፥ «ታኔ ጾሲ ታስ እንጌዝ ናእታይር ታ Ꮊይዳ የዛ» ዬግዛ።<note caller="-" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="ISA 8:17-18">ኢሳ. 8:17-18</ref></char></note><verse eid="HEB 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14"/>ይኬ ናእታይ አሾኔ ሱ የዝታ ማቄዝ ግሾስ የሱሳካ ኡ ጋርክ አስ ማቄዛ። ኤ የያ ኡዴዛይ፥ Ꮊይቆል አፋ ዎልቃ የዝ ጻላሄ ፋ Ꮊይቃይር ሻሮዳይሲ። <verse eid="HEB 2:14"/><verse number="15" style="v" sid="HEB 2:15"/>ማ ፋ የዛ ላይ ኡባይድ Ꮊይቆስ ያሻር አይልቲ የዝታ አይለትፕ ዎዞዳይሲ።<verse eid="HEB 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 2:16"/>የሱሳ የኤዛይ አፍራመ ዘረ ማዶዳይሳፕ አትን ኪታንችታ ማዶዳይስ ባያ።<note caller="-" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="ISA 41:8-9">ኢሳ. 41:8-9</ref></char></note> <verse eid="HEB 2:16"/><verse number="17" style="v" sid="HEB 2:17"/>አስ ናጋራስ ያርሽንቶዳይስ ጾስ ቲና ማርዛኔ አማንንቴዝ ቄሰ ሀላቃ ማቄዛ። የይ ግሾስ፥ ኤ ኡባ ባዛር ፋ እሽታ ኣዞዳይስ ቤዝዛ። <verse eid="HEB 2:17"/><verse number="18" style="v" sid="HEB 2:18"/>ኤ ፋ ኦማስ ፓጭንት ዋየ ኤኬዝ ግሾስ ፓጭንትዝታ ማዶዳይስ ዳንዳእዛ።<verse eid="HEB 2:18"/></para>
  <chapter eid="HEB 2"/>
  <chapter number="3" style="c" sid="HEB 3"/>
  <para style="s1">የሱሳ ሙሰፕ ኣዛ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1"/>የይ ግሾስ፥ ጾስ ጼስ ሻግንቴዝ ጌሽ እሹን፥ ኑ አማኖስ ጎዳ ግ ጼግዝ ሀዋረኔ ቄሰ ሀላቃ የሱሳ ቦኦይታ። <verse eid="HEB 3:1"/><verse number="2" style="v" sid="HEB 3:2"/>ሙሰ ጾስ ካራ ኡባይድ አማንንቴዛይ ጋርክ የሱሳካ ፋና ሹሜዝ ጾሳይስ አማንንቴዛያ። <verse eid="HEB 3:2"/><verse number="3" style="v" sid="HEB 3:3"/>ኬ ኬጽዛይ ኬይፕ ኣ ቦንችንትዛይ ጋርክ የሱሳ ሙሰፕ ኣዝ ቦንቾ ኤኮዳይስ ቤዝዛ። <verse eid="HEB 3:3"/><verse number="4" style="v" sid="HEB 3:4"/>ፐቲ ፐቲ ኬስ ኬጼዝ አሲ የዛ፥ ዝን ኡባ ሀንሴዛይ ጾሰ። <verse eid="HEB 3:4"/><verse number="5" style="v" sid="HEB 3:5"/>ሙሰ ጾስ ካራ ኡባይድ አማንንቴዝ አይለ ማቂ፥ ጾሲ ቲናፕ ጎድባዛይስ ማርካ ማቄዛ። <verse eid="HEB 3:5"/><verse number="6" style="v" sid="HEB 3:6"/>ዝን ክርስቶሳ ጾስስ ናአ ጋርክ አማንንቴዛያ። ኑኒ ኤኮዳ ግ ያሻ ባይ ጬቆር ናግዛ ኡፋይሳ ሚን ናግኮ ኑ ኤ ካራ።<verse eid="HEB 3:6"/></para>
  <para style="s1">ጾስ ዎያስ የዝ ሸምፖ</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7"/>የይ ግሾስ፥ ጌሻ አያናይ ግዛይ ጋርክ፥</para>
  <para style="q1" vid="HEB 3:7">«Ꮊይኖ ይ ጾሳይ ግዛ ስእኮ<verse eid="HEB 3:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 3:8"/>ሊዦ ቢታ ይ ታና ፓጬዝ ጋላስ፥</para>
  <para style="q2" vid="HEB 3:8">ይ ዎርዣቴዛይ ጋርክ፥</para>
  <para style="q2" vid="HEB 3:8">ይ ዎዝና ምንፓተ።<verse eid="HEB 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 3:9"/>ኤዛይድ ይ አድታይ ታና ፓጬዛ፤</para>
  <para style="q2" vid="HEB 3:9">ኦይታም ላይ ታ ኦሳ በኤዛ።<verse eid="HEB 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 3:10"/>የይ ግሾስ፥ ታ የ የለት ሴሬዛ፥</para>
  <para style="q2" vid="HEB 3:10">‹ኡንቲ ኡባ ዎደ ፋ ዎዛናይር ባልንትዛ፤</para>
  <para style="q2" vid="HEB 3:10">ታ ኦጋ ኤረካያ› ታ ዬጌዛ።<verse eid="HEB 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 3:11"/>የይ ግሾስ፥</para>
  <para style="q2" vid="HEB 3:11">‹ታ ሸምፖ አቃ ኡባራካ ገላሚ› ዬጊ፥</para>
  <para style="q2" vid="HEB 3:11">ታኒ ታ ሴራይድ ጫቄዛ፥ ዬጌዛ» ዬግዛ።<note caller="-" style="x"><char style="xo" closed="false">3:7-11 </char><char style="xt" closed="false"><ref loc="PSA 95:7-11">ማዝ. 95:7-11</ref></char></note><verse eid="HEB 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12"/>ታ እሹን፥ ይንትፕ ኦ ጋንጨካ፥ ደኦ ጾሳይፕ ይንታን ሻክዛ ኢታኔ አማኖዋ ዎዝና የዛማይ ጋርክ ናግንቶይታ። <verse eid="HEB 3:12"/><verse number="13" style="v" sid="HEB 3:13"/>ይንትፕ ኦናካ ናጋራ ባልን፥ ፋ ዎዝና ምንማይ ጋርክ «Ꮊይኖ» ዬግንቲ ጼግንቶዳር ጋላስ ጋላስ ዎልር ዞርንቶይታ። <verse eid="HEB 3:13"/><verse number="14" style="v" sid="HEB 3:14"/>ኑ ቲና አማና ኑኒ ዉርስ ሄሎዳይስ ሚን ናግኮ፥ ክርስቶሳር ፐትፕ ላቶዳ። <verse eid="HEB 3:14"/><verse number="15" style="v" sid="HEB 3:15"/>ጌሻ ማጻፋይድ፥</para>
  <para style="q1" vid="HEB 3:15">«Ꮊይኖ ጾስ ግዛ ይ ስእዝ ዎደ</para>
  <para style="q2" vid="HEB 3:15">የ ዎደ ኡንቲ ዎርዠትር ሀኔዛይ ጋርክ፥</para>
  <para style="q2" vid="HEB 3:15">ይ ዎዝና ሚንፓተ»</para>
  <para style="m" vid="HEB 3:15">ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">3:15 </char><char style="xt" closed="false"><ref loc="PSA 95:7-8">ማዝ. 95:7-8</ref></char></note><verse eid="HEB 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16"/>ጾስ ግዝባዝ ስኢ ዎርዠቴዝታይ ኦናንታራ? ሙሰ ግብጸፕ ካል ከሴዝ ኡብታ ባሳኔ?<note caller="-" style="x"><char style="xo" closed="false">3:16-18 </char><char style="xt" closed="false"><ref loc="NUM 14:1-35">ታይ. 14:1-35</ref></char></note> <verse eid="HEB 3:16"/><verse number="17" style="v" sid="HEB 3:17"/>ጾስ ኦይታም ላይ ኦና ሴሬኔ? ናጋራ ኦዝታኔ ኡ አሃይ ሊዦ ቢታ ዎ አቴዝ አስታ ባሳኔ? <verse eid="HEB 3:17"/><verse number="18" style="v" sid="HEB 3:18"/>ማ ጾስ፥ «ታ ሸምፖ አቃ ኡ ገላሚ» ዬጊ ጫቄዛይ፥ ኤስ ኪትንታም እጼዝ አሳይሳፕ አትን ኦሶ? <verse eid="HEB 3:18"/><verse number="19" style="v" sid="HEB 3:19"/>ይኬ፥ ኡንቲ የ ሸምፖ አቃ ገለካ አቴዛይ አማነካ ግሾስ ማቄዛና ኑ ቦኦዳ።<verse eid="HEB 3:19"/></para>
  <chapter eid="HEB 3"/>
  <chapter number="4" style="c" sid="HEB 4"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1"/>ይኬ፥ ጾሲ ኑና ፋ ሸምፖ አቆ ገልሶዳ ጌዝ ቃላይ ሀጋ ቲናፕ የዝ ግሾስ ይንትፕ ኦንካ የ ሸምፖ አቃ ገለካ አታማይ ጋርክ ዎላ ናግንቶዳ። <verse eid="HEB 4:1"/><verse number="2" style="v" sid="HEB 4:2"/>ኡንትስ ዎንግላይ ሳባክንቴዛይ ጋርክ፥ ኑስካ ሳባክንቴዛ። ዝን ኡንቲ ስኤዝባዝ አማኖር ኤከካ ግሾስ ኡንታን ማደካያ። <verse eid="HEB 4:2"/><verse number="3" style="v" sid="HEB 4:3"/>ሀኖ ዝን፥ አላመ መንቴዛይፕ አይኪ ጾሳ ኦሳይ ፖልንቴዝ ማቅኮካ፥ ጾሲ፥</para>
  <para style="q1" vid="HEB 4:3">«ታኒ ታ ካቻይድ ጫቄዛ፥</para>
  <para style="q2" vid="HEB 4:3">ታ ሸምፖ አቆ ኡባራካ ኡ ገላሚ»</para>
  <para style="m" vid="HEB 4:3">ጌዛይ ጋርክ፥ ኑኒ አማኔዝታይ ኤ ሸምፖ አቆ ገሎዳ።<note caller="-" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="PSA 95:11">ማዝ. 95:11</ref></char></note> <verse eid="HEB 4:3"/><verse number="4" style="v" sid="HEB 4:4"/>ላፑን ጋላስባጋ ፐቲ አቆ፥ «ጾሲ ላፑን ጋላሳ ፋ ኦሶ ኡባይፕ ሸምፔዛ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="GEN 2:2">መ. 2:2</ref></char></note> <verse eid="HEB 4:4"/><verse number="5" style="v" sid="HEB 4:5"/>ማካ የ አቃይድ፥ «ኡንቲ ታ ሸምፖ አቃ ኡባራካ ገላሚ» ዬግዛ።<note caller="-" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="PSA 95:11">ማዝ. 95:11</ref></char></note> <verse eid="HEB 4:5"/><verse number="6" style="v" sid="HEB 4:6"/>ቲና ዎንግለ ስኤዝታይ ኪትንታም እጺ ሸምፖ አቃ ገለካያ። የያ ማቅኮካ፥ Ꮊተካ የ ሸምፖ አቃ ገሎ ግንትንቴዝ ፐቲ ፐቲ አስታይ የዛ። <verse eid="HEB 4:6"/><verse number="7" style="v" sid="HEB 4:7"/>የይ ግሾስ፥ ጾሲ፥ «Ꮊይኖ» ግ ጼጎዳር ፐቲ ጋላስ ኑስ ቃማ ጋዴዛ። ጋመ ዎደፕ ጉየ ጾሲ ዳዉተ ባጋር፥</para>
  <para style="q1" vid="HEB 4:7">«ጾሲ ግዝባዝ Ꮊይኖ ይ ስእዝ ዎደ</para>
  <para style="q2" vid="HEB 4:7">ይ ዎዝና ምንፓተ»</para>
  <para style="m" vid="HEB 4:7">ዬጊ ኦዴዛ።<note caller="-" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="PSA 95:7-8">ማዝ. 95:7-8</ref></char></note> <verse eid="HEB 4:7"/><verse number="8" style="v" sid="HEB 4:8"/>ኢያሶ ኡንትስ ሸምፖ እንጌዝባዝ ማቄዛኮ፥ ጾሲ ሀራ ጋላሰ ባጋ ጉየፐ ኦዳምዝን።<note caller="-" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="DEU 31:7">ናምእ. 31:7</ref>፤ <ref loc="JOS 22:4">ኢያ. 22:4</ref></char></note> <verse eid="HEB 4:8"/><verse number="9" style="v" sid="HEB 4:9"/>ይኬ፥ ጾስ አሳይስ ማላ ጋላስ ሸምፖ ጋርክ ሸምፓይ ናግንቲ የዛ። <verse eid="HEB 4:9"/><verse number="10" style="v" sid="HEB 4:10"/>ጾስ ሸምፖ አቃ ገልዛ ኦንካ፥ ጾሲ ፋ ኦሳይፕ ሸምፔዛይ ጋርክ ኤካ ፋ ኦሳይፕ ሸምፖዳ።<note caller="-" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="GEN 2:2">መ. 2:2</ref></char></note> <verse eid="HEB 4:10"/><verse number="11" style="v" sid="HEB 4:11"/>የይ ግሾስ፥ ኦንካ የ አሳይ ኪትንቶ እጻ ካሊ፥ ፖካማይ ጋርክ ዎላ ጾስ ሸምፖ አቃ ገሎዳይስ ምንጎዳ።<verse eid="HEB 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12"/>ጾስ ቃላይ ደኦር የዛኔ ኦዛያ። ናምኢ ባጋር ሌፍንቴዝ ማሻፕ ኣ ኦጮ። ኤ ሸምፖ፥ አያና፥ ጻጶኔ ኮልእዘ ሄሎዳይስ ሳትሲ ጫድዛ። ማ አስ ዎዛና የዝ ቆስንቴዝ ቆፋኔ አሞ ሻኪ ፕርድዛ። <verse eid="HEB 4:12"/><verse number="13" style="v" sid="HEB 4:13"/>ጾስ ቲናፕ ቆስንቴዝ አባ መትካ ባያ። ኤ ኣፈ ቲና ኡባ ባዝ ቆንጨኔ ካሎ የዛ። ኑኒ ማህ እንጎዳይስ ቤዝዛይ ኤ ቲናይዳ።<verse eid="HEB 4:13"/></para>
  <para style="s1">የሱሳ ኡባይፕ ኣ ቄሰ ሀላቃ</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14"/>ይኬ፥ ሳልታይል አፋ ከዜዝ ኡባይፕ ኣ ቄሰ ሀላቃይ፥ ጾስ ናአ የሱሳ፥ ኑስ የዛ ግሾስ ኑ አማና ሚን ናጎዳ። <verse eid="HEB 4:14"/><verse number="15" style="v" sid="HEB 4:15"/>ኑ ቄሰ ሀላቃይ ኑ ዳቡሮዳር ኑስ ቃንቶዳይስ ዳንዳእዛያ። ኤ ናጋራ ኦካ፥ ዝን ኑ ጋርክ ኡባ ባዛር ፓጭንቴዛ። <verse eid="HEB 4:15"/><verse number="16" style="v" sid="HEB 4:16"/>ይኬ፥ ማሮት ኤኮዳይስኔ ማዴ ኮሽዛ ዎደ ኣ ኬሃትይፕ ደንጎዳይስ ኣ ኬሃትይ የዛ አቆ ጾስ ዙፋናይኮ ያሽተካ ሺቆዳ።<verse eid="HEB 4:16"/></para>
  <chapter eid="HEB 4"/>
  <chapter number="5" style="c" sid="HEB 5"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1"/>ፐቲ ፐቲ ቄስታይ ሀላቃ አሳይ ጋንጨፕ ማራጽንቲ፥ ጾሳር ሄልዛ ባዛ አሳይ ግሾስ እሞታራኔ ናጋራ ያርሾ ያርሾዳይስ ሹምንትዛ። <verse eid="HEB 5:1"/><verse number="2" style="v" sid="HEB 5:2"/>ኤ ፋ ኦማስ ዳቡራ ማቄዝ ግሾስ ኤሮዝታይስኔ ባልንትዝታይስ ቃንቶዳይስ ዳንዳእዛ። <verse eid="HEB 5:2"/><verse number="3" style="v" sid="HEB 5:3"/>ኤ ፋ ናጋራ ግሾኔ አስ ኡባ ናጋራ ግሾስ ያርሾ ያርሾዳይስ ቤዝዛይ የይሲ።<note caller="-" style="x"><char style="xo" closed="false">5:3 </char><char style="xt" closed="false"><ref loc="LEV 9:7">ለዊ. 9:7</ref></char></note><verse eid="HEB 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 5:4"/>ኦንካ Ꮊ ቦንቻ ፓስ ኤኮዳይስ ዳንዳኦዋ፥ ዝን ኣሮና ቄስታይ ሀላቃ ማቆዳይስ ጼግንቴዛይ ጋርክ ጾሳር ጼግንቶዳይስ ቤዝዛ።<note caller="-" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="EXO 28:1">ከስ 28:1</ref></char></note> <verse eid="HEB 5:4"/><verse number="5" style="v" sid="HEB 5:5"/>የይ ጋርከካ፥ ክርስቶሳ ቄስታይ ሀላቃ ማቅ ቦንቻ ታስ ቤዝዛ ግ ፋ ኦማስ ኤከካያ። ዝን ጾሲ ኤዛ፥</para>
  <para style="q1" vid="HEB 5:5">«ኔኒ ታ ናአ።</para>
  <para style="q2" vid="HEB 5:5">Ꮊይኖ ነና ታ የሌዛ» ኤኮ</para>
  <para style="m" vid="HEB 5:5">ዬግዛ።<note caller="-" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="PSA 2:7">ማዝ. 2:7</ref></char></note> <verse eid="HEB 5:5"/><verse number="6" style="v" sid="HEB 5:6"/>ማ ሀራ አቆ፥</para>
  <para style="q1" vid="HEB 5:6">«ማልከጻድቀ ቄሰ ማቄዛይ ጋርክ፥</para>
  <para style="q2" vid="HEB 5:6">ኔኒ መናስ ቄሰ ማቆዳ»</para>
  <para style="m" vid="HEB 5:6">ዬግዛ።<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="PSA 110:4">ማዝ. 110:4</ref></char></note><verse eid="HEB 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7"/>የሱሳ አስ ማቂ Ꮊ አላመል የዝ ዎደ ፋና Ꮊይቆፐ አሾዳይስ ዳንዳእዛ ጾሳ ጋመ ዬፎራኔ አፉር ዎሴዛ። ኤ፥ ኤዛ ቦንቺ ኪትንቴዝ ግሾስ ጾስ ኤ ዎሳ ስኤዛ።<note caller="-" style="x"><char style="xo" closed="false">5:7 </char><char style="xt" closed="false"><ref loc="MAT 26:36-46">ማቶ. 26:36-46</ref>፤ <ref loc="MRK 14:32-42">ማር. 14:32-42</ref>፤ <ref loc="LUK 22:39-46">ሉቃ. 22:39-46</ref></char></note> <verse eid="HEB 5:7"/><verse number="8" style="v" sid="HEB 5:8"/>የሱሳ ጾስ ናአ ማቅኮካ ፋ ዋይንቴዝ ዋያይድ ኪትንታ ታማሬዛ። <verse eid="HEB 5:8"/><verse number="9" style="v" sid="HEB 5:9"/>የይዳካ፥ የሱሳ ፎሎ ማቄዛይፕ ጉየ ፓስ ኪትንትዛ ኡባይ መና አቶት ደንጎዳይ ጋርክ ኦገ ማቄዛ። <verse eid="HEB 5:9"/><verse number="10" style="v" sid="HEB 5:10"/>ጾስ ማልከጻድቀ ቄሰትስ ሹሜዛይ ጋርክ ቄስታይ ሀላቃ ኡዲ ኤዛ ሹሜዛ።<verse eid="HEB 5:10"/></para>
  <para style="s1">አማኖር ድጮዳይ ጋርክ እንግንቴዝ ናግሶ</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11"/>ያ ኑ ኦዳይል አፋ ጉጂ ናሾድ ጋመ ባዝ የዛ፥ ዝን ይ አካካይ ጽቃ ማቄዝ ግሾስ ይንትስ ኦዲ ገልሶዳይ ዋይዛ። <verse eid="HEB 5:11"/><verse number="12" style="v" sid="HEB 5:12"/>ይ Ꮊኖንተ አስታማረ ማቆዳይስ ቤዝዛ፥ ዝን ጾስ ቃላ ቲና ትምርታ ይንታን ማሂ ታማርስዛ ሀራ አስ ኮሽዛ። ይ ምኖ ካ ማዳይስ ዳንዳኦዛይ ግሾስ ማ ኮሽዛ።<note caller="-" style="x"><char style="xo" closed="false">5:12-13 </char><char style="xt" closed="false"><ref loc="1CO 3:2">1ቆሮ. 3:2</ref></char></note> <verse eid="HEB 5:12"/><verse number="13" style="v" sid="HEB 5:13"/>ማ ፓክንትዛ ኦንካ ዱደ ናአ ማቄዝ ግሾስ ሎኦኔ ኢታ ሻኪ ኤሮያ። <verse eid="HEB 5:13"/><verse number="14" style="v" sid="HEB 5:14"/>ዝን ምኖ ካ ሎኦኔ ኢታ ሻኪ ኤሮር ሎሄዝ አሳይሲ።<verse eid="HEB 5:14"/></para>
  <chapter eid="HEB 5"/>
  <chapter number="6" style="c" sid="HEB 6"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1"/>ይኬ፥ ክርስቶሳ ባጋ ታማርስዛ ቲና ትምርታ አሺ ክርስቶሳር ፎሎኮ Ꮊማዳ። Ꮊይቄዝ ኦሶፕ ገሎኔ ጾስ አማኖ ባጋ ቲና ትምርታይኮ ጉየ ማቂ ማሂ ባሳሚ። <verse eid="HEB 6:1"/><verse number="2" style="v" sid="HEB 6:2"/>የይትታይካ፥ ጽንቃትታይ ባጋ፥<note caller="+" style="f"><char style="fr" closed="false">6:2 </char><char style="fqa" closed="false">ጽንቃትታይ ባጋ፦ </char><char style="ft" closed="false">ያ አቆ ጽንቃትታይ ባጋ ጊንትንቴዛይ ዱማ ዱማ ጌሾ ዎግታይባጋ ኦዶዳዳይስ።</char></note> ኩሸ ጋዶ ባጋ፥ Ꮊይቆፕ ደንዶ ባጋኔ መና ፕርዳ ባጋ ማሂ ታማራም። <verse eid="HEB 6:2"/><verse number="3" style="v" sid="HEB 6:3"/>ጾስ ጊኮ ኑ የያ ኡዶዳ።<verse eid="HEB 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4"/>ፐቲ ቶኬ ፖኦ ኡንትስ ፖኤዝታ፥ ሳሎ እሞታ ኤኬዝታ፥ ጌሻ አያናር ሻክንቴዝታ፥ <verse eid="HEB 6:4"/><verse number="5" style="v" sid="HEB 6:5"/>ሎኦ ጾስ ቃላኔ ቲናፕ የኦድ አላማይ ዎልቃ በኤዝታ፥ <verse eid="HEB 6:5"/><verse number="6" style="v" sid="HEB 6:6"/>ጉየፐ ካዴዝታ ናጋራይፕ ናምእን ማሆዳይስ ዳንዳእንቶያ። አብስ ጊኮ፥ ኡንቲ ፋ ቦስ ጾስ ናአ ማሂ ሶትዛይ ጋርክ ማዝቃለል አፋ ኤዛ ሶቴዛ ዎያ ቲና ካዉሽዛ።<verse eid="HEB 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 6:7"/>ኡባ ዎደ ኢል አፋ ቡክዛ እራ ኡዢ፥ ዎቴዝ አ ማድዛ ካ እንግዛ ቢታይ ጾስ አንጄዛኖ። <verse eid="HEB 6:7"/><verse number="8" style="v" sid="HEB 6:8"/>ዝን አንጉንኔ ግጀ ዶልዝ ቢታት አብካ አዳሚ፤ ኢስ ቃንግ ኡኬዛ፤ ዉርስል እዛ ጹግንቶዳ።<verse eid="HEB 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9"/>ኑ ሲቆ እሹን፥ ኑኒ Ꮊይ ጋርክ ኦድዛ ባዝ ማቅኮካ፥ ይንታን አቶትኮ ካልዛ ሎኦ ባዝ ይንትስ የዛና ኤርዛ።<note caller="-" style="x"><char style="xo" closed="false">6:9</char><char style="xt" closed="false"><ref loc="GEN 3:17-18">መ. 3:17-18</ref></char></note> <verse eid="HEB 6:9"/><verse number="10" style="v" sid="HEB 6:10"/>ጾስ ሉለ ፕርድዛ። ጾስ፥ ይ ኦዝ ኦሶኔ ቲና ማቅን Ꮊተካ አማንዝታ ማዲ፥ ኤስ የዝ ሲቆ ቤዜዛና ዶጎያ። <verse eid="HEB 6:10"/><verse number="11" style="v" sid="HEB 6:11"/>ይ ኡባይ ኡፋይሳር ናግዛና ደንጎድ ሄሎዳይስ Ꮊ ምኖት ዉርስ ሄሎዳይስ ቤዞዳይ ጋርክ ኑ አሞትዛ። <verse eid="HEB 6:11"/><verse number="12" style="v" sid="HEB 6:12"/>ይ አማኖራኔ ዳንዳአር ናግዛ ኡፋይሳ ላትዛ አሳ ኣዞዳይ ጋርከፐ አትን አዛላ ማቆዳና ኑ ኮዮያ።<verse eid="HEB 6:12"/></para>
  <para style="s1">ጾስ እንጌዝ ኡፋይሳይ ስሶያ</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13"/>ጾሲ አፍራመስ ኡፋይስ ቃላ እንጎድ ግ ጫቆዳር ፋፐ ኣዝ ሀራ ግታ ባ ግሾስ ፋ ኦማስ ጫቄዛ። <verse eid="HEB 6:13"/><verse number="14" style="v" sid="HEB 6:14"/>ኤኮ፥ «ታኒ ነና አንጆዳ፤ ነ ዘርካ ጋንዳ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">6:14 </char><char style="xt" closed="false"><ref loc="GEN 22:16-17">መ. 22:16-17</ref></char></note> <verse eid="HEB 6:14"/><verse number="15" style="v" sid="HEB 6:15"/>አፍራመ ዳንዳአር ናጌዝ ጾሳይ እንጎድ ጌዝ ኡፋይሳ ኤኬዛ።<verse eid="HEB 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 6:16"/>አሲ ጫቂታር ፋፕ ዳምዛ አይር ጫቂዛ፤ ኡ ፋ ኦዳ ጫቆር ሚን፥ ዎል ጋንጨ የዝ ፓላማ ኡባ ተቅዛ። <verse eid="HEB 6:16"/><verse number="17" style="v" sid="HEB 6:17"/>የይ ግሾስ፥ ጾስ ፋ ላምንቶዋ ቆፋ ኡፋይስ ቃላ ላትዝታይስ ቆንጭሶዳይስ ኮዬዝ ግሾስ ጫቆር ኡንትስ ሚንዛ። <verse eid="HEB 6:17"/><verse number="18" style="v" sid="HEB 6:18"/>ጾስ ላምንቶዋዝታኔ ዎርዶቶዋ ናምኢ ባዝታ ጉሳይ ኡፋይስኔ ጫቃ ኑስ እንጌዛ። Ꮊ ናምኢ ባዝታይፕ ደንዴዛይድ ኑ ቲናይድ የዝ ኡፋይሳ ሚን አይኮዳይስ ዳንዳኦዳይስ ዘምፖ ደንጎዳይስ ኤኮ ቆስንቴዝ ኑኒ ዎልቃማ ምን ደንጎዳ።<verse eid="HEB 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 6:19"/>ያ ኡፋይሳይ ኑ ሸምፖስ፥ ማርካበ ኤንአማይ ጋርክ ሚን አይክዝ ዎዶሮ ጋርከ። የ ኡፋይሳይ ማጋራዣፕ ጉየ ባጋ የዝ ጌሽ አቃ ገልዛ።<note caller="-" style="x"><char style="xo" closed="false">6:19 </char><char style="xt" closed="false"><ref loc="LEV 16:2">ለዊ. 16:2</ref></char></note> <verse eid="HEB 6:19"/><verse number="20" style="v" sid="HEB 6:20"/>የሱሳ ማልከጻድቀ ሹማተይ ጋርክ መናስ ቄስታይ ሀላቃ ማቂ፥ ኑ ግሾስ ኑፕ ቲናቲ የ አቃ ገሌዛ።<verse eid="HEB 6:20"/></para>
  <chapter eid="HEB 6"/>
  <chapter number="7" style="c" sid="HEB 7"/>
  <para style="s1">ቄሰ ማልከጻድቀ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1"/>ማልከጻድቄ፥ ሳሌመ ካታይ፥ ኡባፕ ኣ ጾስ ቄሰ። የ ማልከጻድቀ አፍራመ ካትታና ኦሊ ጋሚ ማቆዳር ኤዛ ሄሊ አንጄዛ።<note caller="-" style="x"><char style="xo" closed="false">7:1-2 </char><char style="xt" closed="false"><ref loc="GEN 14:17-20">መ. 14:17-20</ref></char></note> <verse eid="HEB 7:1"/><verse number="2" style="v" sid="HEB 7:2"/>አፍራመ ፋ የዛ ባዝ ኡባይፕ ኤስ አስራታ ከሲ እንጌዛ። ማልከጻድቀ ሱንይ ቲና «ጽሎት ካት»፥ ናምእን፥ «ሳሌመ ካት» ብልእይ፥ «ሳሮት ካት» ጉሲ። <verse eid="HEB 7:2"/><verse number="3" style="v" sid="HEB 7:3"/>ማልከጻድቀስ እንዳ ዎይ አደ ዎይ ዛረ ታይቦ ባያ። ኤ ላይይስ ደንዶ ዎይ ኤ ላይይስ ዉርስ ባያ፥ ዝን ጾስ ናአ ኣዚ መናስ ቄሰ ማቄዛ።<verse eid="HEB 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4"/>ማልከጻድቀ አብ ጋርክ ዳማዛኮ ቦኦይታ። ኑ አድታይስ ማይዛይ፥ አፍራመ፥ ፋ የዛ ባዛይፕ ኤስ አስራታ እንጌዛ። <verse eid="HEB 7:4"/><verse number="5" style="v" sid="HEB 7:5"/>ቄሰ ማቄዝ ለወ ዛራይ እስሬለ አሳይፕ፥ የይካ አፍራመ ዘረ ማቄዝ ፋ እሽታይፕ አስራታ ኤኮዳይ ጋርክ ህገ ኪትዛ።<note caller="-" style="x"><char style="xo" closed="false">7:5 </char><char style="xt" closed="false"><ref loc="NUM 18:21">ታይ. 18:21</ref></char></note> <verse eid="HEB 7:5"/><verse number="6" style="v" sid="HEB 7:6"/>ማልከጻድቀ ለወ ዛረ ማቃም እጽኮካ አፍራመፕ አስራታ ኤኬዛ፤ ኡፋይስ ቃላ የዝ አፍራመና አንጄዛ። <verse eid="HEB 7:6"/><verse number="7" style="v" sid="HEB 7:7"/>ጽቃይ ዳማይር አንጅንትዛይ ፓላምያ።<verse eid="HEB 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 7:8"/>ፐቲ ባጋር፥ አስራታ ኤክዝታይ Ꮊይቅዝ አስታ፥ ዝን ሀራ ባጋር አስራታ ኤክዛይ Ꮊይቀካ የዛ ዬጊ ኦድንቴዝ መልከጻድቀ። <verse eid="HEB 7:8"/><verse number="9" style="v" sid="HEB 7:9"/>ይኬ፥ አስራታ ኤክዝ ለወ፥ አፍራመ ባጋር አስራታ እንጌዝ ጎዳይስ ዳንዳእንትዛ። <verse eid="HEB 7:9"/><verse number="10" style="v" sid="HEB 7:10"/>አብስ ጊኮ፥ ማልከጻድቀ አፍራመር ዎል ሄሎዳር ለወ ሀጋ የልንተካ ማቅኮካ፥ ፋ ማይዛ አፍራመ ጉልባታይድ የዛ።<verse eid="HEB 7:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11"/>እስሬለ አሳይስ ህገ ለወ ቄሰትይ ባጋር እንግቴዛ። የ ለወ ቄሰትይ ፎሎ ማቄዝ ባዝ ማቄዛኮ ኣሮናሳይ ጋርክ ባዝን፥ ማልከጻድቀ ጋርክ ሀራ ቄሰ ሹሞዳይስ ኮሻምዝን። <verse eid="HEB 7:11"/><verse number="12" style="v" sid="HEB 7:12"/>ይኬ፥ ቄስታይ ላምንቶዳር ህጋይካ ማ ላምንቶዳይስ ቤዝዛ። <verse eid="HEB 7:12"/><verse number="13" style="v" sid="HEB 7:13"/>የያ ኑ ኤባዝ ኦድዛ አይ ሀራ ዛረ፤ ኤ ሼሻይፕ ኦንካ ያርሾ አቆ ቄሰት ኦካያ። <verse eid="HEB 7:13"/><verse number="14" style="v" sid="HEB 7:14"/>ኑ ጎዳይ ይሁዳ ሼሻይፕ የኤዛይ ኤርንቴዛያ። ሀኖ ዝን፥ ሙሰ ቄስታይ ባጋ ኦድታር ይሁዳ ኮች ባጋ አብካ ኦደካያ።<verse eid="HEB 7:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 7:15"/>ማልከጻድቀ ጋርክ ሀራ ቄሰ የኤዝባዝ ማቄዛኮ Ꮊ ኑ ኦድዛባዛይ ኣ ቆንጮዳ። <verse eid="HEB 7:15"/><verse number="16" style="v" sid="HEB 7:16"/>ኤ ቄሰ ማቄዛይ ቦዋ ደኦ ዎልቃይራፕ አትን ኤ ማይዛ ህገራኔ ዎጋይር ባያ። <verse eid="HEB 7:16"/><verse number="17" style="v" sid="HEB 7:17"/>ጌሻ ማጻፋይ፥</para>
  <para style="q1" vid="HEB 7:17">«ማልከጻድቀ ቄሰትይ ጋርክ፥</para>
  <para style="q2" vid="HEB 7:17">ኔኒ መናስ ቄሰ»</para>
  <para style="m" vid="HEB 7:17">ዬጊ ማርካትዛ።<note caller="-" style="x"><char style="xo" closed="false">7:17 </char><char style="xt" closed="false"><ref loc="PSA 110:4">ማዝ. 110:4</ref></char></note> <verse eid="HEB 7:17"/><verse number="18" style="v" sid="HEB 7:18"/>ቲና ህጋይ ዳቡራኔ ማዳማ ማቄዝ ግሾስ ሻርንቴዛ። <verse eid="HEB 7:18"/><verse number="19" style="v" sid="HEB 7:19"/>ሙሰ ህጋይ አባራካ ፎሎ ማቆዳይስ ዳንዳኤካያ። ዝን ኑኒ Ꮊት ጾስኮ ሺቆዳይስ ኡባይፕ ኣዝ ኡፋይስ ቃላይ ኑስ እንግንቴዛ።<verse eid="HEB 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 7:20"/>ክርስቶሳ ቄሰ ማቄዝ ዎደ ጾሲ ጫቄዛ፥ ዝን Ꮊንክታይ ቄሰ ማቄዝ ዎደ የይ ጋርክ ጫቃይ ባያ። <verse eid="HEB 7:20"/><verse number="21" style="v" sid="HEB 7:21"/>ዝን የሱሳ ቄሰ ማቄዛይ ጾስ ጫቆራ፤</para>
  <para style="q1" vid="HEB 7:21">«ጎዳይ ኤኮ ‹ኔኒ መና ቄሰ› ዬጊ ጫቄዛ፤ ኤ ፋ ቆፋ ላሞያ»</para>
  <para style="m" vid="HEB 7:21">ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">7:21 </char><char style="xt" closed="false"><ref loc="PSA 110:4">ማዝ. 110:4</ref></char></note> <verse eid="HEB 7:21"/><verse number="22" style="v" sid="HEB 7:22"/>ያ ጫቃይፕ ደንዴዛይድ የሱሳ ኑስ ኡባይፕ ኣዝ ቃላ ጫቃይስ ዋሰ ማቄዛ።<verse eid="HEB 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23"/>ቲና ቄስታይ ታይባይ ጋመ ዝን ቄሰት ኦማይ ጋርክ Ꮊይቆ ኡንታን ካዬዛ። <verse eid="HEB 7:23"/><verse number="24" style="v" sid="HEB 7:24"/>ዝን የሱሳ መናስ የዝዛ ግሾስ ኤ ቄሰትይ ላምንቶያ። <verse eid="HEB 7:24"/><verse number="25" style="v" sid="HEB 7:25"/>የይ ግሾስ፥ ኤ ኡባ ዎደ ኡ ግሾስ ጉሮዳይስ መናስ የዝ ግሾስ ጾስኮ ኤ ባጋር ይእዝታ ፎሎ አሾዳይስ ዳንዳእዛ።<verse eid="HEB 7:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 7:26"/>ይኬ፥ ኑስ ቤዝዛ ባዝ እንግዛ፥ ጌሻይ፥ ቦሮኔ ቱና ባዛይ፥ ናጋራንችታይፐ ሻክንቴዛይኔ ሳሎፕ ኣ ቄዝ ቄሰ ሀላቃይ ኑስ ኮሽዛ። <verse eid="HEB 7:26"/><verse number="27" style="v" sid="HEB 7:27"/>ኤ Ꮊንኮ ቄሰ ሀላቅታይ ጋርክ ቲና ፋ ናጋራ ግሾስ ካሊ አስ ናጋራ ግሾስ ጋላስ ጋላስ ያርሾ ያርሾዳይስ ኮሾያ። ኤ ፋና ያርሼዝ ዎደ Ꮊያ ላማማይስ ፐቲ ቶኬ ዉርሲ አሼዛ<note caller="-" style="x"><char style="xo" closed="false">7:27 </char><char style="xt" closed="false"><ref loc="LEV 9:7">ለዊ. 9:7</ref></char></note> <verse eid="HEB 7:27"/><verse number="28" style="v" sid="HEB 7:28"/>ሙሰ ህጋይ ዳቡራ አሳ ቄሰ ሀላቃ ኡዲ ሹምዛ። ዝን ህጋይፕ ጉየ የኤዝ ጫቆ ቃላይ መናስ ፎሎ ማቄዝ ጾስ ናአና ሹሜዛ።<verse eid="HEB 7:28"/></para>
  <chapter eid="HEB 7"/>
  <chapter number="8" style="c" sid="HEB 8"/>
  <para style="s1">የሱሳ ኦሮ ጫቆ ቄስታይ ሀላቃ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1"/>ኑኒ ኦዴዝ ባዛይፕ ኣፈ ቆፋይ የያ። ሳሎ ኡባፕ አፋ ጾስ ዙፋናይፕ ኡሻች ባጋ በቴዝ Ꮊይ ጋርክ ቄሰ ሀላቃይ ኑስ የዛ።<note caller="-" style="x"><char style="xo" closed="false">8:1 </char><char style="xt" closed="false"><ref loc="PSA 110:1">ማዝ. 110:1</ref></char></note> <verse eid="HEB 8:1"/><verse number="2" style="v" sid="HEB 8:2"/>ኤ ኦዛይ ቱማ ዱንካነ ማቄዝ ጌሽ አቆ፥ የ ዱንካናት ቱክንቴዛና አስ ኩሸር ባዝን ጎዳይ ኩሸራ።<verse eid="HEB 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 8:3"/>ቄሰ ሀላቃ ኡባይ ሙጻታስኔ ያርሾ ያርሾዳይስ ሹምንትዛ። የይ ግሾስ፥ Ꮊ ቄሳይ ያርሾዳይስ ፐትባዚ የዞዳይስ ኮሽዛ። <verse eid="HEB 8:3"/><verse number="4" style="v" sid="HEB 8:4"/>ህገ ኪትዛይ ጋርክ ያርሽዛ ቄስታይ የዝ ግሾስ ክርስቶሳ ሳአ የዛ ባዝ ማቄዛኮ ቄሰ ባያ። <verse eid="HEB 8:4"/><verse number="5" style="v" sid="HEB 8:5"/>ኡንቲ ቄሰት ኦዛ ዱንካናይ ሳሎ የዛይስ ኣዝሶኔ ኤሾ። ሙሰ ዱንካና ኤስዛ ዎደ ጾሲ ኤኮ፥ «ታኒ ነና ደረል አፋ ቤዜዝ ኣዝሳ ካሊ ናግንቶር ኦባ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">8:5 </char><char style="xt" closed="false"><ref loc="EXO 25:40">ከስ 25:40</ref></char></note> <verse eid="HEB 8:5"/><verse number="6" style="v" sid="HEB 8:6"/>Ꮊት ማቅኮ የሱሳ ጋንጨ ገሊ ዳቦዛ ቃላ ጫቃይ፥ ቲና ቃላ ጫቃይፕ ኣዛይ ግሾስ ኤ ኤኬዝ ኦሳይ ኡንቲሳይፕ ኣዛ። የይ ኤቄዛይ ኣዝ ኡፋይስ ቃላይዳ።<verse eid="HEB 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7"/>ቲና ቃላ ጫቃይድ ቦሮ ባ ማቄዛኮ ናምእን ቃላ ጫቆ ኮሾያ። <verse eid="HEB 8:7"/><verse number="8" style="v" sid="HEB 8:8"/>ዝን ጎዳይ ኤዛ ቦሪ፥ Ꮊይ ጋርክ ዬጌዛ፦</para>
  <para style="q1" vid="HEB 8:8">«ታኒ እስሬለ አሳይራኔ ይሁዳ አሳይራ</para>
  <para style="q2" vid="HEB 8:8">ኦሮ ቃላ ጫቆ ጫቂዛ ዎደ የኦዳ።<note caller="-" style="x"><char style="xo" closed="false">8:8-12 </char><char style="xt" closed="false"><ref loc="JER 31:31-34">ኤርም. 31:31-34</ref></char></note><verse eid="HEB 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9"/>የ ቃላ ጫቃይ ታ ኡ አድታይ ግብጸ ቢታፕ ኩሸ አይኪ፥</para>
  <para style="q2" vid="HEB 8:9">ጎቺ ከሴዝ ዎደ ኡንታር ጫቄዝ ጫቃይ ጋርክ ባያ።</para>
  <para style="q1" vid="HEB 8:9">ጎዳይ ኡንቲ ታ ጫቃይድ አማንንተካዛይ ግሾስ</para>
  <para style="q2" vid="HEB 8:9">ታኒ ኡንታን ኦሊ አሼዛ ዬግዛ።<verse eid="HEB 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10"/>ዝን ይከፕ ጉየ እስሬለ አሳይራ</para>
  <para style="q2" vid="HEB 8:10">ታ ጫቆድ ጫቃይ Ꮊያ ዬግዛ ጎዳይ።</para>
  <para style="q1" vid="HEB 8:10">ታኒ ታ ህጋ ኡ ካሃይድ ጋዶዳ፤</para>
  <para style="q2" vid="HEB 8:10">ኡ ዎዝናይዳካ ጻፎዳ።</para>
  <para style="q1" vid="HEB 8:10">ታኒ ኡ ጾሳ ማቆዳ፤</para>
  <para style="q2" vid="HEB 8:10">ኡንትካ ታ ወያ ማቆዳ።<verse eid="HEB 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11"/>ኡንታፕ ኦንካ ፋ ሾራ ዎይ ፋ እሻ፥</para>
  <para style="q2" vid="HEB 8:11">‹ጎዳ ኤሮባ› ዬጊ ታማርሳሚ።</para>
  <para style="q1" vid="HEB 8:11">ኡንቲ ጽቃፕ ዳማ ሄሎዳይስ</para>
  <para style="q2" vid="HEB 8:11">ኡባይ ታና ኤሮዳ።<verse eid="HEB 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12"/>ታኒ ኡ ናቃ አቶ ጎዳ፤</para>
  <para style="q2" vid="HEB 8:12">ኡ ቆሃ ማሂ ቆፓሚ»</para>
  <para style="m" vid="HEB 8:12">ዬግዛ።<verse eid="HEB 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 8:13"/>ጾሲ Ꮊ ጫቃ «ኦሮ ቃላ ጫቆ» ጉሳይ ቲናሳ ጭማ ማሄዛ። ይኬ፥ ጭማይኔ ጬጋይ ብዛ ዎደ ሄሌዛ።<verse eid="HEB 8:13"/></para>
  <chapter eid="HEB 8"/>
  <chapter number="9" style="c" sid="HEB 9"/>
  <para style="s1">ጭማ ጫቆ ዎደ ጎይኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1"/>ቲና ጫቃይስ ጾስ ጎይኖ ዎጋይኔ ሳአ ዱንካናይ የዛ። <verse eid="HEB 9:1"/><verse number="2" style="v" sid="HEB 9:2"/>ቲና ዱንካናይ ጊጌዛ። ኤዛይድ ጾምፐ ጋድዝ ኮች፥ ጻርጴዛኔ ያርሾ ቦራ የዛ፤ የ አቃይ ጌሺ ግንትትዛ።<note caller="-" style="x"><char style="xo" closed="false">9:2 </char><char style="xt" closed="false"><ref loc="EXO 26:1-30">ከስ 26:1-30</ref>፤ <ref loc="EXO 25:31-40">25:31-40</ref></char></note> <verse eid="HEB 9:2"/><verse number="3" style="v" sid="HEB 9:3"/>ናምአን ማጋራዣይፕ ጉየ ባጋር የዝ አቃይ ኡባይፕ ኣ ጌሽ አቆ ግንትንትዛ።<note caller="-" style="x"><char style="xo" closed="false">9:3 </char><char style="xt" closed="false"><ref loc="EXO 26:31-33">ከስ 26:31-33</ref></char></note> <verse eid="HEB 9:3"/><verse number="4" style="v" sid="HEB 9:4"/>ኤ ጋንጨ እጻኔ ጩይሽዝ ዎርቃ ቀንደለኔ ዎርቃር ጎልንቴዝ ቃላ ጫቆ ታቦታይ የዛ። የ ጫቆ ታቦታይድ ማና የዝ ዎርቃ ጻሮ፥ አጬዝ ኣሮና ጉፋይኔ ሙሰ ህገ ጻፍንቴዝ ናምኢ ሎቼ ሹችታይ የዛ።<note caller="-" style="x"><char style="xo" closed="false">9:4 </char><char style="xt" closed="false"><ref loc="EXO 30:1-6">ከስ 30:1-6</ref>፤ <ref loc="EXO 25:10-16">25:10-16</ref>፤ <ref loc="EXO 16:33">16:33</ref>፤ <ref loc="NUM 17:8-10">ታይ. 17:8-10</ref>፤ <ref loc="EXO 25:16">ከስ 25:16</ref>፤ <ref loc="DEU 10:3-5">ናምእ. 10:3-5</ref></char></note> <verse eid="HEB 9:4"/><verse number="5" style="v" sid="HEB 9:5"/>የ ታቦታይል አፋ ባጋር አቶት ካመ ፋ ቀፋይድ ካምዛ ቦንቾ ክሩቤልታይ የዛ። ዝን Ꮊት የ ኡባ ቆንጭሲ ኦዶዳይስ ዳንዳኦያ።<note caller="-" style="x"><char style="xo" closed="false">9:5 </char><char style="xt" closed="false"><ref loc="EXO 25:18-22">ከስ 25:18-22</ref></char></note><verse eid="HEB 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6"/>ያ ኡባይ Ꮊይ ጋርክ ጊጌዛይፕ ጉየ፥ ቄስታይ ኡባ ዎደ ፋ ኦሳ ኦዳይስ ዱንካናይስ ቲና ባጋ ክፍላ ገልዛ።<note caller="-" style="x"><char style="xo" closed="false">9:6 </char><char style="xt" closed="false"><ref loc="NUM 18:2-6">ታይ. 18:2-6</ref></char></note> <verse eid="HEB 9:6"/><verse number="7" style="v" sid="HEB 9:7"/>ዝን ቄሰ ሀላቃይ ኣዳ ዱንካናይስ ናምእን ክፍለ ላይፕ ፐቲ ቶኬ ገልዛ። ኤ የያ ገልታር ፋ ናጋራ ግሾኔ አሳይ ኤረካ ኦዝ ናጋራ ግሾስ ሱ ያርሾ ኤከካ ገሎያ።<note caller="-" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="LEV 16:2-34">ለዊ. 16:2-34</ref></char></note> <verse eid="HEB 9:7"/><verse number="8" style="v" sid="HEB 9:8"/>ቲና ዱንካናይ ኤቂ የዝን፥ ኡባፕ ጌሽ አቆ ካንግዛ ኦገ ሀጋ ዶይንተካዛ ጌሻ አያናይ የያ ኤርስዛ።<verse eid="HEB 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 9:9"/>የይ Ꮊ ዎዳይስ ኣዝሶ፤ ጾስስ እንግንትዛ እማኔ ያርሻይ ጎይንዛ አይ ካሃ ጌሾዳይስ ዳንዳኦዛና Ꮊይ ቤዝዛ። <verse eid="HEB 9:9"/><verse number="10" style="v" sid="HEB 9:10"/>የይትታይ ሙስ ባጋ፥ ኡሽ ባጋ ዱማ ዱማ ሜች ዎግታይ ኦድዝታ። ኡንቲ ኦሮጽዛ ዎደ የኦድ ሄሎዳይስ ኦስንትዛ ባለ ዎግታ ባጋ።<verse eid="HEB 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11"/>ዝን ክርስቶሳ Ꮊት ኑ ደንጌዝ ሎኦ ባዝታይስ ቄስታይ ሀላቃ ማቂ የኤዛ። ኤ ገሌዝ ዱንካናይ ዳማኔ ፎሎ ማቄዛ። የ ዱንካናይ አስ ኩሸር ኦስንተካዛኔ Ꮊ አላማይፕ መንቴዛኖ። <verse eid="HEB 9:11"/><verse number="12" style="v" sid="HEB 9:12"/>ክርስቶሳ ኡባፕ ጌሽ አቆ ገልታር ዴሽ ሱኔ ኦጎና ሱ ኤኪ ገለካያ። ዝን መና አቶት እንጎዳይስ ፋ ሱ ኤኪ ላማማይስ ፐቲ ቶኬ ገሌዛ። <verse eid="HEB 9:12"/><verse number="13" style="v" sid="HEB 9:13"/>ዴሽ ሱኔ ዎፋኖ ሱ፥ ጹግንቴዝ ኡስ ቡዶ፥ ቱኔዝ አሳይል አፋ ርጭንቲ ኡንታን ጌሽዛባዝ ማቅኮ፥<note caller="-" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="LEV 16:15-16">ለዊ. 16:15-16</ref>፤ <ref loc="NUM 19:9">ታይ. 19:9</ref>፥ <ref loc="NUM 19:17-19">17-19</ref></char></note> <verse eid="HEB 9:13"/><verse number="14" style="v" sid="HEB 9:14"/>መና አያና ባጋር ቦሮ ባ ያርሾ ኡዲ፥ ጾሳይስ ፋና እንጌዝ ክርስቶሳ ሱ፥ የዛ ደኦ ጾስ ጎይኖዳይ ጋርክ Ꮊይቆ ካልዛ ኦሳይፕ ኑ ካሃ ዋይዚ ኣ ጌሾሳ?<verse eid="HEB 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15"/>የይ ግሾስ፥ ጼግንቴዝታይ ጾሲ እንጌዝ መና ላታ ኤኮዳይ ጋርክ ክርስቶሳ ኦሮ ጫቃይስ ጋንጨ ገሊ ዳቦዛ ማቄዛ። የይ ሀኔዛይ አሳይ ቲና ጫቃይፕ ኦሞ የዝ ዎደ ኦዝ ናጋራይፕ ኡንታን ዎዞዳይስ ኤ Ꮊይቃይዳ።<verse eid="HEB 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 9:16"/>ይኬ፥ ኬኬ ዬዝኮ፥ የ ኬኬዝ አይ Ꮊይቅይ ኤርንቶዳይስ ኮሽዛ። <verse eid="HEB 9:16"/><verse number="17" style="v" sid="HEB 9:17"/>ኬኬዝ አይ Ꮊይቅኮ ኤ ኬካይ ሚንግዛ። ኬኬዝ አይ Ꮊይቀካ አትኮ ኤ ኬካይ ኦያ።<verse eid="HEB 9:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 9:18"/>ሀራ አቶዝን፥ ቲና ጫቃይካ ሱ ባይ ምንገካ። <verse eid="HEB 9:18"/><verse number="19" style="v" sid="HEB 9:19"/>ሙሰ ህገ አዛዝታ ኡባ አሳይስ ኦዴዛይፕ ጉየ ኦጎና ሱኔ ዴሽ ሱ ሃር ዋላኪ፥ ዞቆ ዱር እክሰኔ ህሶጰ ኤኪ፥ ማጻፋይል አፋኔ አሳይል አፋ ዉርጼዛ።<note caller="-" style="x"><char style="xo" closed="false">9:19-20 </char><char style="xt" closed="false"><ref loc="EXO 24:6-8">ከስ 24:6-8</ref></char></note> <verse eid="HEB 9:19"/><verse number="20" style="v" sid="HEB 9:20"/>ሙሰ አሳይኮ፥ «ይ ናጎዳይ ጋርክ ጾሲ ኪቴዝ ሱ ጫቃይ Ꮊያ» ዬጌዛ። <verse eid="HEB 9:20"/><verse number="21" style="v" sid="HEB 9:21"/>የይ ጋርከካ፥ ዱንካናይዳኔ ኦዛ ሚሸ ኡባይል አፋ ሱ ዉርጼዛ።<note caller="-" style="x"><char style="xo" closed="false">9:21 </char><char style="xt" closed="false"><ref loc="LEV 8:15">ለዊ. 8:15</ref></char></note> <verse eid="HEB 9:21"/><verse number="22" style="v" sid="HEB 9:22"/>ቱማካ ህጋይ ግዛይ ጋርክ ጽቃባዝታይፕ አትን ኡባ ባዝ ሱር ጌዥዛ። ሱ ላልንተካዝን ናጋራ ባራንችንቶያ።<note caller="-" style="x"><char style="xo" closed="false">9:22 </char><char style="xt" closed="false"><ref loc="LEV 17:11">ለዊ. 17:11</ref></char></note><verse eid="HEB 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23"/>ሳሎባዝ ኣዝሶ ማቄዝታይ ኡባይ መሄ ያርሾር ጌዦዳይስ ኮሽዛ። ዝን ሳሎባዝታይ ፋ ኦማስ የይፕ ኣዝ ያርሾር ጌዦዳይስ ኮሽዛ።<verse eid="HEB 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 9:24"/>ክርስቶሳ ቱማ ጾስ ኬይስ ኣዝሶ ማቄዛ፥ አስ ኩሸር ኦስንቴዝ ኡባፕ ጌሽ አቆ ገለካያ። ዝን ኤ Ꮊት ኑ ግሾስ ጾስ ቲና በንቶዳይስ ሳሎ ገሌዛ። <verse eid="HEB 9:24"/><verse number="25" style="v" sid="HEB 9:25"/>ቄሰ ሀላቃይ ላይ ላይ ፋ ሱ ባዛ ኤኪ፥ ኡባይፕ ኣዝ ጌሽ አቆ ገልዛይ ጋርክ ክርስቶሳ ጋመ ቶኬ ፋና ያርሾዳይስ ማቂ ማቂ ገለካያ። <verse eid="HEB 9:25"/><verse number="26" style="v" sid="HEB 9:26"/>የይ ጋርክ ሀኔዝባዝ ማቄዛኮ፥ ክርስቶሳ አላመ መንቴዛይፕ አይኪ ጋመ ቶኬ ዋይንቶዳይስ ኮሽዛ። ዝን Ꮊተ ዎደ ዉርስ ናጋራ ብሶዳይስ ፋና ያርሼዝ ላምሶዋ ኦገር ፐቲ ቶኬ በንቴዛ።<verse eid="HEB 9:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="HEB 9:27"/>አስ ኡባይስ ፐቲ ቶኬ Ꮊይቆዳይስ የይፕ ጉየ ፕርድንቶዳይስ ቤዝዛ። <verse eid="HEB 9:27"/><verse number="28" style="v" sid="HEB 9:28"/>የይ ጋርከካ፥ ክርስቶሳ ጋመ አሳይ ናጋራ ብሶዳይስ ፐቲ ቶኬ ያርሽንቴዛ። ማቅካ ኤ ናጋራ ቶኮዳይስ ባዝን ፋና ናግዝታ አሾዳይስ ናምእን ቆንጮዳ።<note caller="-" style="x"><char style="xo" closed="false">9:28 </char><char style="xt" closed="false"><ref loc="ISA 53:12">ኢሳ. 53:12</ref></char></note><verse eid="HEB 9:28"/></para>
  <chapter eid="HEB 9"/>
  <chapter number="10" style="c" sid="HEB 10"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1"/>ሙሰ ህጋይ የኦዳይስ የዝ ሎኦ ባዝታይስ ኤሾፕ አትን ጋማ ባያ። የይ ግሾስ፥ ላይ ላይ ፓጨ ባይ ያርሽንትዝ ያርሻይ ጎይኖዳይስ ሺቅዛ አሳይ ፎሎ ኦዳይስ ዳንዳኦያ። <verse eid="HEB 10:1"/><verse number="2" style="v" sid="HEB 10:2"/>ህገ ኡንታን ፎሎ ኦዳይስ ዳንዳኤዛኮ ኡንቲ ያርሾ ያርሽዛ አሾዳዝን። ማ ጎይኖዳይስ ሺቅዛ አሳይ ፋ ናጋራይፕ ጌዦዳ፤ ኡ ካሃይካ ኡንታን ባላ ግ ሞታሚ። <verse eid="HEB 10:2"/><verse number="3" style="v" sid="HEB 10:3"/>ዝን የ ያርሽታይ ላይ ላይ ናጋራ ቆፍስዛ። <verse eid="HEB 10:3"/><verse number="4" style="v" sid="HEB 10:4"/>አብስ ጊኮ፥ ዎፋኖ ሱኔ ዴሽ ሱ ናጋራ ካዮዳይስ ዳንዳኦያ።<verse eid="HEB 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 10:5"/>የይ ግሾስ፥ ክርስቶሳ Ꮊ አላመ የኤዝ ዎደ Ꮊይ ጋርክ ዬጌዛ፦</para>
  <para style="q1" vid="HEB 10:5">«ኔኒ ያርሾኔ እሞ ኮየካያ፤</para>
  <para style="q2" vid="HEB 10:5">ዝን ታስ አሾ ጊግሴዛ።<note caller="-" style="x"><char style="xo" closed="false">10:5-7 </char><char style="xt" closed="false"><ref loc="PSA 40:6-8">ማዝ. 40:6-8</ref></char></note><verse eid="HEB 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6"/>ኔኒ ጹግንትዝ ያርሻይዳኔ</para>
  <para style="q2" vid="HEB 10:6">ናጋራ ያርሻይድ ኡፋይተካያ።<verse eid="HEB 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7"/>የ ዎደ ‹ታ ግሾስ ማጻፋይድ ጻፍንቴዛይ ጋርክ፥</para>
  <para style="q2" vid="HEB 10:7">ጎዳዮ፥ ታኒ ነ ሸነ ኦዳይስ የኤዛ› ዬጌዛ።»<verse eid="HEB 10:7"/></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 10:8"/>ያርሾ ያርሽንቶዳይ ጋርክ ህገ ኪትዛባዝ ማቅኮካ፥ ክርስቶሳ ቲና፥ «ኔኒ ያርሾኔ ሙጻታ፥ ጹግንትዝ ያርሾኔ ናጋራ ያርሾ ኮየካያ፤ ኡንታል ኡፋይተካያ» ዬጌዛ። <verse eid="HEB 10:8"/><verse number="9" style="v" sid="HEB 10:9"/>ካልካ ኤ፥ «ጎዳዮ፥ ዬዛኮ ታኒ ነ ሸነ ኦዳይስ የኤዛ» ዬጌዛ። የይ ግሾስ፥ ክርስቶሳ ናምአንና ኤሶዳይስ ቲናሳ ሻሬዛ። <verse eid="HEB 10:9"/><verse number="10" style="v" sid="HEB 10:10"/>የሱስ ክርስቶሳ ጾስ ሸነ ኡዲ፥ ላማማይስ ፐቲ ቶኬ ፋ አሾ ያርሼዝ ግሾስ ኑኒ ጌዤዛ።<verse eid="HEB 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11"/>ቄሰ ኡባይ፥ ናጋራ ብሶዳይስ ዳንዳኦዳይ የ ያርሽታ ጋላስ ጋላስ ያርሽታር ኤቂ ፋ ኦሳ ኦዛ።<note caller="-" style="x"><char style="xo" closed="false">10:11 </char><char style="xt" closed="false"><ref loc="EXO 29:38">ከስ 29:38</ref></char></note> <verse eid="HEB 10:11"/><verse number="12" style="v" sid="HEB 10:12"/>ዝን ክርስቶሳ መናስ ማቄዝ ፐቲ ናጋራ ያርሾ ያርሼዝ፥ ጾሳይፕ ኡሻች ባጋ በቴዛ።<note caller="-" style="x"><char style="xo" closed="false">10:12-13 </char><char style="xt" closed="false"><ref loc="PSA 110:1">ማዝ. 110:1</ref></char></note> <verse eid="HEB 10:12"/><verse number="13" style="v" sid="HEB 10:13"/>የ ዎዳይፕ አይኪ ኤ ሞርክታይ ኤ ቶካይስ የዝበሳ ኡዶድ ሄሎዳይስ ናግዛ። <verse eid="HEB 10:13"/><verse number="14" style="v" sid="HEB 10:14"/>ኤ ፐቲ ቶኬ ፋና ያርሼዝ ያርሻይድ ጌሽታ መናስ ፎሎ ኡዴዛ።<verse eid="HEB 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 10:15"/>ማ ጌሻ አያናይ ኑስ Ꮊይስ ማርካትዛ። ቲና Ꮊይ ጋርክ ዬጌዛ፦<verse eid="HEB 10:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16"/>«የ ጋላስታይፕ ጉየ፥</para>
  <para style="q2" vid="HEB 10:16">ታኒ ኡንታር ጫቂዛ ጫቃይ Ꮊያ፦</para>
  <para style="q1" vid="HEB 10:16">ታኒ ታ ህጋ ኡ ካሃይድ ጋዶዳ፤</para>
  <para style="q2" vid="HEB 10:16">ኡ ዎዝናይድ ጻፎዳ»</para>
  <para style="m" vid="HEB 10:16">ዬግዛ።<note caller="-" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="JER 31:33">ኤርም. 31:33</ref></char></note> <verse eid="HEB 10:16"/><verse number="17" style="v" sid="HEB 10:17"/>ካልካ፥</para>
  <para style="q1" vid="HEB 10:17">«ታኒ ኡ ናጋራኔ</para>
  <para style="q2" vid="HEB 10:17">ኡ ኢታ ኦሳ ማሂ ቆፓሚ»</para>
  <para style="m" vid="HEB 10:17">ዬግዛ።<note caller="-" style="x"><char style="xo" closed="false">10:17 </char><char style="xt" closed="false"><ref loc="JER 31:34">ኤርም. 31:34</ref></char></note> <verse eid="HEB 10:17"/><verse number="18" style="v" sid="HEB 10:18"/>ይኬ፥ ናጋራ አቶ ግንትንቴዛይፕ ጉየ ናጋራስ ያርሽንትዛ ያርሻይ ኮሾያ።<verse eid="HEB 10:18"/></para>
  <para style="s1">ጾስኮ ሺቆዳ</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19"/>ይኬ፥ ታ እሹን፥ ኑኒ የሱሳ ሱ ባጋር ኡባፕ ጌሽ አቆ ገሎዳይስ ኑስ አማንዛባዝ ደንጌዛ። <verse eid="HEB 10:19"/><verse number="20" style="v" sid="HEB 10:20"/>ኑ ገሎዳና ክርስቶሳ ፋ ማጋራዣ፥ የይካ ፋ አሾ ባጋር ኑስ ዶዬዝ ኦሮኔ ደኦ ማቄዝ ኦጋይራ። <verse eid="HEB 10:20"/><verse number="21" style="v" sid="HEB 10:21"/>ኑስ ጾስ ካራል አፋ ሹምንቴዝ ግታ ቄሰ የዛ። <verse eid="HEB 10:21"/><verse number="22" style="v" sid="HEB 10:22"/>ኑኒ ኢታ ካሃይፕ ጌዦዳይስ ኑ ዎዝና ዉርጽንቲ፥ ኑ አሰት ጽሎ ሃር ሜጭንቲ፥ ሉለ ዎዝናራኔ ፎሎ አማኖር ጾስኮ ሺቆዳ።<note caller="-" style="x"><char style="xo" closed="false">10:22 </char><char style="xt" closed="false"><ref loc="LEV 8:30">ለዊ. 8:30</ref>፤ <ref loc="EZK 36:25">ኢዝቀ. 36:25</ref></char></note><verse eid="HEB 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 10:23"/>ኑስ ኡፋይስ ቃላ እንጌዝ ጾሳይ አማንንቴዛይ ግሾስ ኑ ማርካትዝ ኡፋይሳ ኡሻች ሀድርስ ጌካ ሚን አይኮዳ። <verse eid="HEB 10:23"/><verse number="24" style="v" sid="HEB 10:24"/>ፐታይ ፐታ ሲቆራኔ ሎኦ ኦሶር ኑ ዋይዚ ባርክ የዞዳይስ ቤዝዛኮ ቆፕሶ። <verse eid="HEB 10:24"/><verse number="25" style="v" sid="HEB 10:25"/>ፐታይ ፐታይ ካሴ ሺቅዝ ሺቃ አሸካዛይ ጋርክ ኑኒ ፐትፕ ሺቅ ዞርንትዛና አሻሚ። ማቅካ ጎዳ ጋላሳይ ኡኬዛያ ይ ብእዛ ግሾስ የያ ካሴሳይፕ ኣ ኦይታ።<verse eid="HEB 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26"/>ኑኒ ቱማ ኤራት ኤኬዛይፕ ጉየ ኤርታር ናጋራ ኦኮ፥ ይከፕ ኑ ናጋራ ግሾስ ያርሽንቶድ ያርሻይ ባያ። <verse eid="HEB 10:26"/><verse number="27" style="v" sid="HEB 10:27"/>ይኬ አቴዛይ ያሽዝ ፕርዳኔ ጾስ ሞርክታ ጹጎዳይስ ማቄዝ ዎልቃማ ታማ።<note caller="-" style="x"><char style="xo" closed="false">10:27 </char><char style="xt" closed="false"><ref loc="ISA 26:11">ኢሳ. 26:11</ref></char></note> <verse eid="HEB 10:27"/><verse number="28" style="v" sid="HEB 10:28"/>ሙሰ ህጋ ኪትንታም እጼዝ ኦንካ ናምኢ ዎይ ሀይ አስ ኤዛል አፋ ማርካትኮ ማሮት ባይ Ꮊይቅዛ።<note caller="-" style="x"><char style="xo" closed="false">10:28 </char><char style="xt" closed="false"><ref loc="DEU 17:6">ናምእ. 17:6</ref>፤ <ref loc="DEU 19:15">19:15</ref></char></note> <verse eid="HEB 10:28"/><verse number="29" style="v" sid="HEB 10:29"/>የዝን፥ ጾስ ናአ ካዝ አይ፥ ፋና ጌሼዝ ጾስ ቃላ ጫቆ ሱ ቱና ባዝ ጋርክ ቆፔዝ አይ፥ ማ ኣ ኬሃት አያና ጫዤዝ አይ፥ አብ ጋርክ ኢታ ፕርዳ ኤኮዳይስ ቤዝዛኮ አን ቆፖይታ።<note caller="-" style="x"><char style="xo" closed="false">10:29 </char><char style="xt" closed="false"><ref loc="EXO 24:6-8">ከስ 24:6-8</ref></char></note><verse eid="HEB 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 10:30"/>ይኬ፥ «ኩሸ ከሶ ታባዝ፥ ታ ኩሸ ከሶዳ» ጌዛ ኑ ኤርዛ። ማካ፥ «ጎዳይ ፋ አሳይ ፕርዶዳ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">10:30 </char><char style="xt" closed="false"><ref loc="DEU 32:35">ናምእ. 32:35</ref>፥ <ref loc="DEU 32:36">36</ref></char></note> <verse eid="HEB 10:30"/><verse number="31" style="v" sid="HEB 10:31"/>ደኦ ጾስ ኩሸ ፖክ ኢታ ያሽዛ።<verse eid="HEB 10:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32"/>ይንትስ ጾስ ፖኦ ፖኤዛይፕ ጉየ ይ ጋመ ዋዬር፥ ግታ ቡተር ጋርዤዝ ብኒ ዎደ ቆፖይታ። <verse eid="HEB 10:32"/><verse number="33" style="v" sid="HEB 10:33"/>ፐቲ ፐቲ ቶኬ ይ አስ ቲና ጫዥንቴዛ፤ ባይእንቴዛ፤ ፐቲ ፐቲ ቶኬ የይ ጋርክ ዋየ ሄሌዝ አሳይር ፐትፕ ዋዬዛ። <verse eid="HEB 10:33"/><verse number="34" style="v" sid="HEB 10:34"/>ኣዋኔ ኡባ ዎደ የዝዝ ሚሸ ይንትስ ሳሎ የዛና ኤሬዛይግሾስ አቻ የዝ አሳይስ ታ ቃዛ፥ ይ ሻላይ ኤክንቶዳራካ ዳንዳአር የያ ይ ኡፋይሳር ኤኬዛ። <verse eid="HEB 10:34"/><verse number="35" style="v" sid="HEB 10:35"/>ግታ ዎይቶ የዛ ግሾስ ይ ጎበት ኦልፓተ። <verse eid="HEB 10:35"/><verse number="36" style="v" sid="HEB 10:36"/>ጾስ ሸነ ኦ ይንትስ እንግንቴዝ ኡፋይስ ቃላ ይ ደማድ ጋርክ ይባቲ ናጎዳይስ ኮሽዛ። <verse eid="HEB 10:36"/><verse number="37" style="v" sid="HEB 10:37"/>ሀጋ ጽቃ ዎደ የዛ፥ «የኦዳይስ የዛይ የኦዳ ጋምኤና። <verse eid="HEB 10:37"/><verse number="38" style="v" sid="HEB 10:38"/>ጌሽ አሲ አማኖር የዝዛ፥ ጉየ ሶልእኮ ታ ሸምፓታ ኤዛል ኡፋይቶያ።»<note caller="-" style="x"><char style="xo" closed="false">10:38 </char><char style="xt" closed="false"><ref loc="HAB 2:3-4">እንባ. 2:3-4</ref></char></note> <verse eid="HEB 10:38"/><verse number="39" style="v" sid="HEB 10:39"/>ኑና ማቅኮ ፋ ሸምፖ አሾዳይስ አማንዛ አሳይር የዛፕ አትን ቦስ ጉየ ሶልእዝ አሳይር ባያ።<verse eid="HEB 10:39"/></para>
  <chapter eid="HEB 10"/>
  <chapter number="11" style="c" sid="HEB 11"/>
  <para style="s1">አማኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1"/>አማኖ ጉሳይ ኡፋይስ ጋዲ በኤካ ባዝ በኤዛይ ጋርክ ኡዲ ቤዝዛ ባዝ። <verse eid="HEB 11:1"/><verse number="2" style="v" sid="HEB 11:2"/>ብኒ አሳይ ባዝ ማርካትንቴዛይ አማኖራ።<verse eid="HEB 11:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 11:3"/>አላማይ ጾስ ቃላር መንቴዛና ኑ ኤርዛይ አማኖራ፥ የይ ግሾስ በንትዝ ባዝ ኡባይ በንቶዋ ባዛፕ ሀኔዛና ኑ ኤርዛ።<note caller="-" style="x"><char style="xo" closed="false">11:3 </char><char style="xt" closed="false"><ref loc="GEN 1:1">መ. 1:1</ref>፤ <ref loc="PSA 33:6">ማዝ. 33:6</ref>፥ <ref loc="PSA 33:9">9</ref>፤ <ref loc="JHN 1:3">ዋን. 1:3</ref></char></note><verse eid="HEB 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4"/>አቤላ ቃኤላሳይፕ ኣዝ ያርሾ ሺሼዛይ አማኖራ። ጾሳይ አቤላ ያርሻ ኡፋይሳር ኤክን አቤላ ፋ አማናይር ጌሽ ማቄዛይ ማርካትንቴዛ፥ ኤ Ꮊይቄዝባዝ ማቅኮካ ኤ አማናይ ባጋር Ꮊተካ ኦድታር የዛ።<note caller="-" style="x"><char style="xo" closed="false">11:4 </char><char style="xt" closed="false"><ref loc="GEN 4:3-10">መ. 4:3-10</ref></char></note><verse eid="HEB 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 11:5"/>እኖኬ Ꮊይቆ በአማይ ጋርክ ፉደ ኤክንቴዛይ አማኖራ፥ ጾሲ ኤዛ ኤኬዝ ግሾስ በንተካያ፥ ኤ ኤክንቶዳይፕ ቲና ኤ ጾስ ኡፋይሴዛይ ኤስ ማርካትንቴዛ።<note caller="-" style="x"><char style="xo" closed="false">11:5 </char><char style="xt" closed="false"><ref loc="GEN 5:21-24">መ. 5:21-24</ref></char></note> <verse eid="HEB 11:5"/><verse number="6" style="v" sid="HEB 11:6"/>አማኖ ባይ ጾሳ ኡፋይሶዳይስ ዳንዳኦያ፥ ጾስኮ ሺቅዛ ኣ ጾስ የዛናኔ ኤዛ ኮይዝ አሳይስ እሞታ እንግዛ ማቄዛና አማኖዳይስ ቤዝዛ።<verse eid="HEB 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 11:7"/>ኖሄ ሀጋ ኣፈር በንቶዋ ባዝታይስ ጾሲ ኤዛ ናግንቶዳይ ጋርክ ኤርሴዝ ዎዳ ጾስስ ያሽትታር ፋ ካራ አሳ አሾዳይስ አማኖር ማርካበ ኮቼዛ፥ ኖሄ አማናይር አላማይ ናጋራንቾ ማቄዛይ ኤርንትን ፕርድንቴዛ፥ ኖሄ አማኖር በንትዝ ጽሎት ላቴዛ።<note caller="-" style="x"><char style="xo" closed="false">11:7 </char><char style="xt" closed="false"><ref loc="GEN 6:13-22">መ. 6:13-22</ref></char></note> <verse eid="HEB 11:7"/><verse number="8" style="v" sid="HEB 11:8"/>አፍራመ ኤስ ኦድንቴዛና ፋ ጋደ ኡዲ ኤኮዳይስ ከዞ ግ ጼግን አና Ꮊንግዛኮ ኤረካዛር ከዜዛይ አማኖራ።<note caller="-" style="x"><char style="xo" closed="false">11:8 </char><char style="xt" closed="false"><ref loc="GEN 12:1-5">መ. 12:1-5</ref></char></note> <verse eid="HEB 11:8"/><verse number="9" style="v" sid="HEB 11:9"/>ኤዛር ዎላ ኡፋይሳ ቃላ ላትዝታ ማቄዝታይ እሳቃራኔ ያይቆባር ዎላ በተት ጋደ እማ ማቂ ዱንካነ የዜዛይ አማኖራ<note caller="-" style="x"><char style="xo" closed="false">11:9 </char><char style="xt" closed="false"><ref loc="GEN 35:27">መ. 35:27</ref></char></note> <verse eid="HEB 11:9"/><verse number="10" style="v" sid="HEB 11:10"/>ባሶር የዛኖ ጾሲ መዛኖኔ ኮቼዝ ካታምቶ ኤኮዳይስ ናግታር የዛ።<verse eid="HEB 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 11:11"/>ሳርስ ኡፋይስ እንጌዝ ጾሳይ አማንንትዛ ማቄዛና ኤሬዝ ግሾስ ላይ ዉርኮካ ዎደጾዳይስ ዎልቃ ደንጌዛይ አማኖራ።<note caller="-" style="x"><char style="xo" closed="false">11:11 </char><char style="xt" closed="false"><ref loc="GEN 18:11-14">መ. 18:11-14</ref>፤ <ref loc="GEN 21:2">21:2</ref></char></note> <verse eid="HEB 11:11"/><verse number="12" style="v" sid="HEB 11:12"/>የይ ግሾስ Ꮊይቄዝ አስ ጋርክ ታይብንቴዝ ፐቲ አፍራመፕ ሳሎ ጾልንቶ ጋርከኔ ሳአ ሻፈ ጋርክ ኮቺ በንቴዛ።<verse eid="HEB 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13"/>Ꮊይትታይ ኡቢታይ አማኖር የዛር Ꮊይቄዛ፥ ጾሳይ ኡንትስ እማዳይስ ቃላ ገሌዛኖካ ደንገካያ፥ ማቆዝን ሃኮር ብኢ ደንጌዛይ ጋርክ ኡዲ ኡፋይሳር ኤኬዛ። ቢታል አፋ ኡ እማኔ በተ ማቄዛናካ ኤሬዛ።<note caller="-" style="x"><char style="xo" closed="false">11:13 </char><char style="xt" closed="false"><ref loc="1CH 29:15">1ዜና. 29:15</ref>፤ <ref loc="PSA 39:12">ማዝ. 39:12</ref></char></note> <verse eid="HEB 11:13"/><verse number="14" style="v" sid="HEB 11:14"/>Ꮊይ ጋርክ ዬግዝ አሳይ ፓስ ማቅዝ ጋደ ናግዛና ቲሺ ኡዲ ቤዝዛ። <verse eid="HEB 11:14"/><verse number="15" style="v" sid="HEB 11:15"/>ኡ ፋ ከዜዝ ጋዳ ቆፔዛኮ ገድ ጉየ ማቆዳይስ ዳንዳኦዳዝኒ። <verse eid="HEB 11:15"/><verse number="16" style="v" sid="HEB 11:16"/>Ꮊት ማቅኮ ኣዝ ሳሎ የዝ ጋዳ ላሞትዛ፥ የይ ግሾስ ጾስ ኡንትስ ካታማ ጊግሴዝ ግሾስ ኑ ጎዳ ግ ጼጎዳይስ ዬላያ።<verse eid="HEB 11:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17"/>አፍራመ ፓጭንቴዝ ዎደ እሳቃና ያርሾስ ሺሼዛይ አማኖራ። ኤ ኡፋይስ ቃላ ኤኬዛይ ፋ ምጺ ናአ ያርሾዳይሲ።<note caller="-" style="x"><char style="xo" closed="false">11:17 </char><char style="xt" closed="false"><ref loc="GEN 22:1-14">መ. 22:1-14</ref></char></note> <verse eid="HEB 11:17"/><verse number="18" style="v" sid="HEB 11:18"/>የዝን ጾሲ እሳቃ ኮቻር ጼግንትዛ ጌዝን።<note caller="-" style="x"><char style="xo" closed="false">11:18 </char><char style="xt" closed="false"><ref loc="GEN 21:12">መ. 21:12</ref></char></note> <verse eid="HEB 11:18"/><verse number="19" style="v" sid="HEB 11:19"/>ጾሳይ Ꮊይቆፕ ደንዳይስ ዳንዳእዛና አፍራመ አማኔዝ ግሾስ Ꮊይቄዝ ኣዝዝ አፍራመ እሳቃ ደንጌዛ።<note caller="-" style="x"><char style="xo" closed="false">11:19 </char><char style="xt" closed="false"><ref loc="GEN 21:12">መ. 21:12</ref></char></note><verse eid="HEB 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 11:20"/>እሳቃ ቲናፕ ሀኖድ ባዝ ብኢ ያይቆባኔ ኤሳወ አንጄዛይ አማኖራ።<verse eid="HEB 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 11:21"/>ያይቆባ Ꮊይቆስ ሄሊ ጉፈር ኤቂ ዮሴፋ ናእታ አንጄዛይ አማኖራ።<note caller="-" style="x"><char style="xo" closed="false">11:21 </char><char style="xt" closed="false"><ref loc="GEN 27:27-29">መ. 27:27-29</ref>፥ <ref loc="GEN 27:39-40">39-40</ref></char></note> <verse eid="HEB 11:21"/><verse number="22" style="v" sid="HEB 11:22"/>ዮሴፋካ Ꮊይቆስ ሄሊ አማኖር እስሬለ ናእታይ ከሲ ባጋ ቆፔዛ። ፋ መቀይ ባጋካ ኬኬዛ። <verse eid="HEB 11:22"/><verse number="23" style="v" sid="HEB 11:23"/>ሙሰ የልንቴዝ ዎደ ካራ አሳይ የገልስ ናአ ማቄዛና ብኢ ሀይዝ አግና ቆሴዛይ አማኖራ። ካታይ አዋጃይስካ ያሽተካያ።<verse eid="HEB 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24"/>ሙሰካ ድጬዛይፕ ጉየ ፋሮናስ ናአ ናአ ግንቶዳና እጼዛይ አማኖራ።<note caller="-" style="x"><char style="xo" closed="false">11:24 </char><char style="xt" closed="false"><ref loc="EXO 2:10-12">ከስ 2:10-12</ref></char></note> <verse eid="HEB 11:24"/><verse number="25" style="v" sid="HEB 11:25"/>የይ ግሾስ ኤዚ ናጋራራ በንትዝ ኡፋይሳፕ ኣ ጾስ ዎያር መቶ ኤኮዳና ዶሬዛ። <verse eid="HEB 11:25"/><verse number="26" style="v" sid="HEB 11:26"/>ቲናስካ ፋ ኤኮድ ጋታ ትሽ ኡዲ በኤዝ ግሾስ ግብጸ ሻሎፕ ክርስቶሳ ግሾስ ካዉዥዛይ ኣ ማቄዛና ቆፔዛ። <verse eid="HEB 11:26"/><verse number="27" style="v" sid="HEB 11:27"/>ካታይ ካቻይስ ያሽተካዛር ግብጸፕ ከዜዛይ አማኖራ፥ ኣፈር በኤካ ጎዳካ በኤዛይ ጋርክ ኡዲ ፋ ቆፋይድ ሚንጌዛ። <verse eid="HEB 11:27"/><verse number="28" style="v" sid="HEB 11:28"/>ባይራ ናእታ ዎዳይስ ኪትንቴዝ ኪታንችታይ እስሬልታይ ካራ ገላማይ ጋርክ ፓዝቃ ኡዴዛይኔ ሾንችታ ሱ ትዤዛይ አማኖራ።<note caller="-" style="x"><char style="xo" closed="false">11:28 </char><char style="xt" closed="false"><ref loc="EXO 12:21-30">ከስ 12:21-30</ref></char></note> <verse eid="HEB 11:28"/><verse number="29" style="v" sid="HEB 11:29"/>እስሬልታይ መላ ቢታር ፒንጎዳይ ጋርክ ኡድን ዞቆ አባ ፒንጌዛይ አማኖራ፥ ግብጸ አሳይ ኡንቲሳይ ጋርክ ቁሊ ገሊ ምትንቴዛ። <verse eid="HEB 11:29"/><verse number="30" style="v" sid="HEB 11:30"/>እስሬልታይ ኢያርኮ ጋሰ ካለር ላፑን ጋላስ ዉቴዛይፕ ጉየ ኬይ ዎዴዛይ አማኖራ።<note caller="-" style="x"><char style="xo" closed="false">11:30 </char><char style="xt" closed="false"><ref loc="JOS 6:12-21">ኢያ. 6:12-21</ref></char></note> <verse eid="HEB 11:30"/><verse number="31" style="v" sid="HEB 11:31"/>ዉሹምዛ ራአባ አዉዥዝታ ሳሮር ሞኬዝ ግሾስ አዛዝንቶዋ አሳይር Ꮊይቀካ አቴዛይ አማኖራ።<note caller="-" style="x"><char style="xo" closed="false">11:31 </char><char style="xt" closed="false"><ref loc="JOS 2:1-21">ኢያ. 2:1-21</ref>፤ <ref loc="JOS 6:22-25">6:22-25</ref></char></note><verse eid="HEB 11:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32"/>ይክ ታ ሀራ አብ ጎ ጌዶና ባጋ፥ ባረቃ ባጋ፥ ሳምሶኔ ባጋ፥ ዮፍታሄ ባጋ፥ ዳዉተ ባጋ፥ ሳምኤላ ባጋ፥ ናብታይ ባጋ ታ ቶሳማይ ጋርክ ታስ ዎዳይ ሃቴዛ<note caller="-" style="x"><char style="xo" closed="false">11:32 </char><char style="xt" closed="false"><ref loc="1KI 6:11-8:32">1ካት. 6:11—8:32</ref></char></note> <verse eid="HEB 11:32"/><verse number="33" style="v" sid="HEB 11:33"/>ኡንቲ አማኖር ካተትታ ላዛ<note caller="-" style="x"><char style="xo" closed="false">11:33 </char><char style="xt" closed="false"><ref loc="DAN 4:6-5:31">ዳነ. 4:6—5:31</ref>፤ <ref loc="JDG 6:11-8:32">ዳኒ. 6:11—8:32</ref>፤ <ref loc="JDG 13:2-16:31">13:2—16:31</ref>፤ <ref loc="JDG 11:1-12:7">11:1—12:7</ref>፤ <ref loc="1SA 16:1-2:11">1ሳም. 16:1—1ካት. 2:11</ref>፤ <ref loc="1SA 1:1-25:1">1ሳም. 1:1—25:1</ref></char></note> ጽሎ ኦሶካ ኦዛ፥ ኡንትስ እንግንቴዝ ኡፋይስ ቃላ ደንጌዛ ጋምታይ ዶናካ ጎርዴዛ። <verse eid="HEB 11:33"/><verse number="34" style="v" sid="HEB 11:34"/>ታማ ዎልቃ ብሴዛ፥ ማሻ ኦጮፐ ቡቴዛ፥ ዳቡርሳፕ ምኖት ላምንቴዛ፥ ኦላር ቃርታ ማቄዛ፥ አላጋ ኦላንችታ ባይኤዛ።<note caller="-" style="x"><char style="xo" closed="false">11:34 </char><char style="xt" closed="false"><ref loc="JDG 6:1-27">ዳኒ. 6:1-27</ref></char></note> <verse eid="HEB 11:34"/><verse number="35" style="v" sid="HEB 11:35"/>ማችታይ Ꮊይቄዝ ኡ ዳብታይ ደንድን በኤዛ፥ ባግታይ አቶት ደንገካዛር ቲናፕ ደንዶዳይስ ቆፕ ዱማ ዱማ መቶ ኤኬዛ።<note caller="-" style="x"><char style="xo" closed="false">11:35 </char><char style="xt" closed="false"><ref loc="JDG 3:1-30">ዳኒ. 3:1-30</ref></char></note> <verse eid="HEB 11:35"/><verse number="36" style="v" sid="HEB 11:36"/>Ꮊንክታይ ካስ ባዝ ማቂ ሾጭንቲ የይፕ ኣ አቻር ዱጽንቲ ዎይነ ዎዛ። <verse eid="HEB 11:36"/><verse number="37" style="v" sid="HEB 11:37"/>ሹቻር ሾጭንቲ፥ ማጋዘር ቆእንቴዛ፥ ማሻር ጋችንቲ Ꮊይቄዛ፥ ኡባ ባዝ ብን መትንቴዛ፥ ማንቆነ በተ አስ ጋርክ ዋዬዛ፥ ዴሽ ማኦኔ ዱር ማኦ ማኢ ዩዬዛ።<note caller="-" style="x"><char style="xo" closed="false">11:37 </char><char style="xt" closed="false"><ref loc="1KI 22:26">1ካት. 22:26</ref>፤ <ref loc="2CH 18:25">2ዜና. 18:25</ref>፥ <ref loc="2CH 18:26">26</ref>፤ <ref loc="JER 20:2">ኤርም. 20:2</ref>፤ <ref loc="JER 37:15">37:15</ref>፤ <ref loc="JER 38:6">38:6</ref></char></note> <verse eid="HEB 11:37"/><verse number="38" style="v" sid="HEB 11:38"/>ሊዦ ጋራ፥ አምባ ጼራራ፥ ቢታ ኦላ ጋንጨራ ኮምኦር ዩዬዛ። የይ ጋርክ Ꮊን አላማት ኡንትስ ቤዝዛ አቆ ማቀካያ።<note caller="-" style="x"><char style="xo" closed="false">11:38 </char><char style="xt" closed="false"><ref loc="2CH 24:21">2ዜና. 24:21</ref></char></note><verse eid="HEB 11:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39"/>Ꮊይትታይ ኡቢታይ ኡ አማናይ ባጋ ማርካትኮካ ኡንትስ እንግንቴዝ ኡፋይሳ ሀጋ ደንጌካያ። <verse eid="HEB 11:39"/><verse number="40" style="v" sid="HEB 11:40"/>ኑ ባይ ኡ ፎሎ ማቃማይ ጋርክ ጾሳይ ኑስ ኡባፕ ኣ ባዝ ብኢ ጋዴዛ።<verse eid="HEB 11:40"/></para>
  <chapter eid="HEB 11"/>
  <chapter number="12" style="c" sid="HEB 12"/>
  <para style="s1">ጾስ ኑ አደ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1"/>ይኬ Ꮊይትታ ኣዝዝ ማርክታይ ሻራ ጋርክ ኑ ላንቃይር የዝኮ ኑካ ቶፎ ኡባ ኤልሲ ኑና ማርዛ ናጋራ ኑፕ ሃሲ፥ ኑ አማናይስ ኦማኔ ፎሎ ማቅዝ የሱሳና ብኢ ኑ ቲናይድ የዝ ዎ ዳንዳአር ዎላ ዎጾዳ። <verse eid="HEB 12:1"/><verse number="2" style="v" sid="HEB 12:2"/>ኤዚ ኢታ ባዝ ኡባ ለቂ ፋ ቲናይድ የዝ ኡፋይሳይስ ማዝቃለል ጋርዢ ጾስ ዙፋነ ኡሻቻ በቴዛ። <verse eid="HEB 12:2"/><verse number="3" style="v" sid="HEB 12:3"/>ይኬ ይ አዛለካዛራኔ ዳቡረካዛር ናጋራንችታይፕ ኤዛ ሄሌዝ እጾ ኡባ ጋርዤዝ የሱሳና ቦኦይታ። <verse eid="HEB 12:3"/><verse number="4" style="v" sid="HEB 12:4"/>ይ ናጋራራ ቡትንትታር ሀጋ ሱ ላልንቶድ ጋ እጸካያ። <verse eid="HEB 12:4"/><verse number="5" style="v" sid="HEB 12:5"/>ጾሲ ፋ ናአ ጋርክ ይንታን፥ ዬጊ ዞሬዛና ይ ዶጌዛ።<note caller="-" style="x"><char style="xo" closed="false">12:5-6 </char><char style="xt" closed="false"><ref loc="JOB 5:17">ኢዮ. 5:17</ref>፤ <ref loc="PRO 3:11-12">ኣዝ. 3:11-12</ref></char></note></para>
  <para style="q1" vid="HEB 12:5">«ታ ናአዮ ጎዳይ ሴራ ለቂፐ፥</para>
  <para style="q2" vid="HEB 12:5">ኤ ነና ካጭዝ ዎደ ዳቡርፐ፥<verse eid="HEB 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6"/>ጎዳይ ፋ ቃዛ ናአ ካጭዛ»</para>
  <para style="q2" vid="HEB 12:6">ፋ ናአ ጋርኪ ኡዲ ቢኢዛና ሴሪዛ።<verse eid="HEB 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 12:7"/>ጾሲ ፋ ናአ ግ ይንታን ሴርዛ ግሾስ ዳንዳኦይታ። አደ ሴሮዋ ናአ ኦኖ? <verse eid="HEB 12:7"/><verse number="8" style="v" sid="HEB 12:8"/>ናአ ማቄዝ ኡቢታይ ኤክዛ ሴራ ይንትካ ኤካም እጽኮ አደ ኤርንቶዋ ናእታፕ አትን ናእታ ባያ። <verse eid="HEB 12:8"/><verse number="9" style="v" sid="HEB 12:9"/>የይፐካ ኣ ኑና ሴርዛ አሾ አድታይስ ኑካ ያሽትዛ፥ የዝን ሸምፖር የዞዳይስ አያና አደ ማቄዛይስ አዛዝንቶዳይስ ዋይዚ ቤዞሳ? <verse eid="HEB 12:9"/><verse number="10" style="v" sid="HEB 12:10"/>ኡንቲ ፓስ ሎኤዛይ ጋርክ ጽቃ ዎደስ ኑና ሴሬዛ፥ ኤዛ ማቅኮ ኑና ኤ ጽሎት ግሽንቶድ ጋርክ ኑና አዶዳይስ ሴርዛ። <verse eid="HEB 12:10"/><verse number="11" style="v" sid="HEB 12:11"/>ሴራ ኡባይ የ ሳታይድ አዛንዛ ባዛፕ አትን ኡፋይስዛ ኣዞያ፥ ጉየፕ ኤሪ ዉርኮ ሳሮት ኩሜዝ ጽሎት ኣፈ ቤዝዛ።<verse eid="HEB 12:11"/></para>
  <para style="s1">ዞረኔ ናግሶ</para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12"/>የይ ግሾስ ዶልኤዝ ኩሽታኔ ልቄዝ ይ ቡንቂታ ምንይታ።<note caller="-" style="x"><char style="xo" closed="false">12:12 </char><char style="xt" closed="false"><ref loc="ISA 35:3">ኢሳ. 35:3</ref></char></note> <verse eid="HEB 12:12"/><verse number="13" style="v" sid="HEB 12:13"/>ሾልዛይ ፓጾድ ጋርከፕ አትን ቡርቃማይ ጋርክ ይ ቶካይስ ሉለ ኦገ ኦይታ።<note caller="-" style="x"><char style="xo" closed="false">12:13 </char><char style="xt" closed="false"><ref loc="PRO 4:26">ኣዝ. 4:26</ref></char></note><verse eid="HEB 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14"/>ጌሸት ባይ አሲ ጾሳ በአዳይስ ዳንዳኦዋ ግሾስ አስ ኡባር ሳሮ የዞይታ፥ ጌሸትር የዞዳይስ ሚንጎይታ። <verse eid="HEB 12:14"/><verse number="15" style="v" sid="HEB 12:15"/>ይንትፕ ኦስካ ጾስ ኣ ኬሄት ፓጫማይ ጋርክ ናግንቶይታ የይ ጋርከካ አባ ጫሞ ኣፈ ኣፍዝ ጻጶ ይ ጋንጨ ዶላማይ ጋርከኔ ይንትፕ ጋምታ ዋይማይ ጋርክ፥ ቱንሳማይ ጋርክ ይ ጋንጨ የዛማይ ጋርክ ናግንቶይታ።<note caller="-" style="x"><char style="xo" closed="false">12:15 </char><char style="xt" closed="false"><ref loc="DEU 29:18">ናምእ. 29:18</ref></char></note> <verse eid="HEB 12:15"/><verse number="16" style="v" sid="HEB 12:16"/>ተንቶትዛኔ ፐቲ ቶኬ ሙስስ ግ ፋ ባይራት ባይዜዝ ኤሳወ ጋርክ ማቃማይ ጋርክ ናግንቶይታ።<note caller="-" style="x"><char style="xo" closed="false">12:16 </char><char style="xt" closed="false"><ref loc="GEN 25:29-34">መ. 25:29-34</ref></char></note> <verse eid="HEB 12:16"/><verse number="17" style="v" sid="HEB 12:17"/>ኤሳወ ጉየፕ አንጆ ኤኮዳይስ ኮይንካ አንጆ ካይንቴዛና ይ ኤርዛ፥ ዬኪ አፉጽ ሚንጊ ኮይንካ ደማዳይስ ዳንዳኤካያ፥ ማሮትስካ ዎደ ደንገካያ።<note caller="-" style="x"><char style="xo" closed="false">12:17 </char><char style="xt" closed="false"><ref loc="GEN 27:30-40">መ. 27:30-40</ref></char></note><verse eid="HEB 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18"/>ኩሸር አይክንቶዳይስ ዳንዳእንትዛ ኤጽዝ ታማይኮ፥ ሻራይኮ፥ ማይኮ፥ ጎታይኮ፥ ናሳይኮ፥ <verse eid="HEB 12:18"/><verse number="19" style="v" sid="HEB 12:19"/>የ ቱልቱላ ጊርይኮ ዎይ ኦድንትዛ ቃላ ስእንትዛይኮ ይ ሄለካያ፥ ያ ቃላ ስኤዝ አሳይ ሀራ ቃላ ኑስ ጉጅንትፐ ግ ዎሴዛ።<note caller="-" style="x"><char style="xo" closed="false">12:18-19 </char><char style="xt" closed="false"><ref loc="EXO 4:11-12">ከስ 4:11-12</ref>፤ <ref loc="EXO 19:16-22">19:16-22</ref>፤ <ref loc="EXO 20:18-21">20:18-21</ref></char></note> <verse eid="HEB 12:19"/><verse number="20" style="v" sid="HEB 12:20"/>«ሀራ አቶዝን ዶአ የ አምባቶ ቦችኮ ሹቻር ሾጭንቲ Ꮊይቆ» ዬግዝ አዛዛይ ዴጼዝ ግሾስ ጋርዦዳይስ ዳንዳኤካያ።<note caller="-" style="x"><char style="xo" closed="false">12:20 </char><char style="xt" closed="false"><ref loc="EXO 19:12-13">ከስ 19:12-13</ref></char></note> <verse eid="HEB 12:20"/><verse number="21" style="v" sid="HEB 12:21"/>ሙሰካ «ታ ያሽትዛ ታ ኩኩርዛ» ጎድ ጋ በንትዝ ባዝ ኡባይ ጋመ ያሽዝ ባዝ።<note caller="-" style="x"><char style="xo" closed="false">12:21 </char><char style="xt" closed="false"><ref loc="DEU 9:19">ናምእ. 9:19</ref></char></note><verse eid="HEB 12:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22"/>ይንታን ማቅኮ ጽዮነ አምባኮ ኡኬዛ፥ እዛካ ደኦ ጾሳይስ ካታማ ሳሎ የዝ የሩሳላማቶ፥ ይንቲ ፓይዶባ ኪታንችታይኮ ኡኬዛ። <verse eid="HEB 12:22"/><verse number="23" style="v" sid="HEB 12:23"/>ኡ ሱንይ ሳሎ ጻፍንቴዝ፥ ዎሳ ኬስ ባይራ ናአ ማቄዝ አማንዛ አሳይ ሺቆ፥ ኡባይስ ፕርድዝ ጎድ ማቄዛይኮ፥ ፎሎ ደንጌዝ ጌሽ ሸምፕታይኮ ይ ኡኬዛ። <verse eid="HEB 12:23"/><verse number="24" style="v" sid="HEB 12:24"/>ኦሮ ጫቆስ ግዶ ማቄዝ የሱሳኮ፥ አቤላ ሱይፕ ኣ ኦድዝ ዉርጽንቴዝ ሱይኮ ይ ኡኬዛ።<note caller="-" style="x"><char style="xo" closed="false">12:24 </char><char style="xt" closed="false"><ref loc="GEN 4:10">መ. 4:10</ref></char></note><verse eid="HEB 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25"/>የ ኦድዛና ይ ኤካሚ ጋማይ ጋርክ ናግንቶይታ፥ የይትታይ ሳአ አሲ ኦዴዝ ባዝ ስኤካ አቲ ቡተካዝን ኑኒ ሳሎፕ ኦድንቴዝ ባዝ ኤካም እጺ ዋይዚ ቡቶደ?<note caller="-" style="x"><char style="xo" closed="false">12:25 </char><char style="xt" closed="false"><ref loc="EXO 20:22">ከስ 20:22</ref></char></note> <verse eid="HEB 12:25"/><verse number="26" style="v" sid="HEB 12:26"/>የ ዎደ ኤ ጊርይ ቢታ ኤንእሴዛ፥ Ꮊት ማቅኮ «ታ ሳአ ኣዳ ባዝን ፐቲ ቶኬ ማሂ ሳሎካ ኤንእሶዳ» ዬጊ ቃላ ገሌዛ።<note caller="-" style="x"><char style="xo" closed="false">12:26 </char><char style="xt" closed="false"><ref loc="HAG 2:6">ሀጌ. 2:6</ref></char></note> <verse eid="HEB 12:26"/><verse number="27" style="v" sid="HEB 12:27"/>ሀኖ ዝን ፐቲ ቶኬ ታ ማሂ ግዛይ ኤንኦዋ ባዝታይ ጻጲ የዞዳይ ጋርክ ኤንእዛ ባዝታይ መንቴዝ ባዝ ማቄዛይስ ቦዳና ቤዝዛ። <verse eid="HEB 12:27"/><verse number="28" style="v" sid="HEB 12:28"/>ይኬ ኑኒ ኤንኦዋ ካተት ኤኮድ ግሾስ ጾሳ ቦንችታራኔ ያሻር ጾሳ ኡፋይስታር ጎይንዛ አያና ዎላ አይኮዳ። <verse eid="HEB 12:28"/><verse number="29" style="v" sid="HEB 12:29"/>ኑ ጾሳይ ጹግዝ ታማ።<note caller="-" style="x"><char style="xo" closed="false">12:29 </char><char style="xt" closed="false"><ref loc="DEU 4:24">ናምእ. 4:24</ref></char></note><verse eid="HEB 12:29"/></para>
  <chapter eid="HEB 12"/>
  <chapter number="13" style="c" sid="HEB 13"/>
  <para style="s1">ጾስ ኡፋይስዛ ጎይኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1"/>ኡባ ዎደ እሸት ሲቆ ይንትስ የሰ። <verse eid="HEB 13:1"/><verse number="2" style="v" sid="HEB 13:2"/>እማ ሞኮ ዶግፓተ ፐቲ ፐቲ አሳይ እማ ሞክታር ኤረካዛር ፐቲ ጋላስ ኪታንቾ ሞኬዛ።<note caller="-" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="GEN 18:1-8">መ. 18:1-8</ref>፤ <ref loc="GEN 19:1-3">19:1-3</ref></char></note> <verse eid="HEB 13:2"/><verse number="3" style="v" sid="HEB 13:3"/>ኡንታር ዎላ አጭንቴዝ አስ ጋርክ አጭንቴዝ አሳ ዶግፓተ፥ መቶ ኡንታር ዎላ ኤክዛ አስ ማቂ መትንቴዝ አሳ ቆፖይታ። <verse eid="HEB 13:3"/><verse number="4" style="v" sid="HEB 13:4"/>ገሎኔ ኤኮ ኡባ አስ ካለ ቦንችንቴዛ ሂጻይካ ጌሽ ማቆ፥ ናጋራስ ተንቶትዝታ ላምዝታ ጾሳይ ፕርዶዳ፥ ማችኔ አዝኒ አማንንታም እጺ ገሎኔ ኤኮ ቱንስፐ።<verse eid="HEB 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 13:5"/>ሚሸ ዣረፕ ሃኮይታ፥ ይንትስ የዛና ግዶ፥ ጾስ «ታ ኡባር ነና አሻሚ ኡባራካ ኦላሚ» ዬጌዛ።<note caller="-" style="x"><char style="xo" closed="false">13:5 </char><char style="xt" closed="false"><ref loc="DEU 31:6">ናምእ. 31:6</ref>፥ <ref loc="DEU 31:8">8</ref>፤ <ref loc="JOS 1:5">ኢያ. 1:5</ref></char></note> <verse eid="HEB 13:5"/><verse number="6" style="v" sid="HEB 13:6"/>የይ ግሾስ ኤዛል አማንንቲ «ጎዳይ ታና ማዶዳ ታ ያሽታሚ፤ አሲ ታና አብ ኡዶዴ?» ኑ ዬግዛ።<note caller="-" style="x"><char style="xo" closed="false">13:6 </char><char style="xt" closed="false"><ref loc="PSA 118:6">ማዝ. 118:6</ref></char></note><verse eid="HEB 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7"/>ይንትስ ቲና ጾሳ ቃላ ኦዴዝ ዋንታ አስታ ቆፖይታ፥ ኡ የሳኔ ኡ ኦሳይ አፋ ብኢ ቆፒ አማኖር ኣዞይታ።<verse eid="HEB 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 13:8"/>የሱስ ክርስቶሳ ዝቅነኔ Ꮊይኖ መና ሄሎዳይስካ ኤ ኤዛ። <verse eid="HEB 13:8"/><verse number="9" style="v" sid="HEB 13:9"/>ዱማ ዱማ ኦሮ ትምርተር ኤክንትፓተ፥ ይ ዎዝናይ ሙስ ዎጋር ባዝን ጾስ ኣ ኬሃትር ጻጲኮ ሎኦ፥ ሙስ ዎጋ ካሌዝ አሳይ ማድንተካያ።<verse eid="HEB 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 13:10"/>ኑስ ያርሾ አቆ የዛ፥ ማቅኮካ ዱንካነ ጋንጨ ኦዛ ቄስታይ ያርሾ አቆ ካ ኤኪ ማዳይስ ዳንዳኦያ። <verse eid="HEB 13:10"/><verse number="11" style="v" sid="HEB 13:11"/>አይሁደ ቄስታይ ሀላቃይ ናጋራ ባራንቾዳይስ መሄ ሱ ኤኪ ጾስ ካራ ቆልአ ገልዛ፥ አሻና ሄራፕ ጋጻ ከሲ ጹግዛ።<note caller="-" style="x"><char style="xo" closed="false">13:11 </char><char style="xt" closed="false"><ref loc="LEV 16:27">ለዊ. 16:27</ref></char></note> <verse eid="HEB 13:11"/><verse number="12" style="v" sid="HEB 13:12"/>የሱሳ የይ ጋርክ ፋ ጋዛ ሱይር አሳ ጌሾዳይስ ካታማይፕ ጋጻ ከዚ መቶ ኤኬዛ። <verse eid="HEB 13:12"/><verse number="13" style="v" sid="HEB 13:13"/>ኑካ ሄራፕ ከዚ ዎላ ኤኮ Ꮊማዳ፥ ኤ ካዉሻትካ ዎላ ሻግንቶዳ። <verse eid="HEB 13:13"/><verse number="14" style="v" sid="HEB 13:14"/>ኑኒ ሀጋ የኦዳይስ የዝ ካታምቶ ናግነፕ አትን ሚንጊ የዝዝ ካታማ Ꮊ ሳአል ኑስ ባያ።<verse eid="HEB 13:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 13:15"/>ይኬ የሱስ ክርስቶሳ ባጋር ጋላታ ያርሾ ኡባ ዎደ ጾስስ ዎላ ሺሾዳ፥ የይካ ኤ ሱንይስ ማርካትዝ መተርሽታይፕ ሺቅዛ ጋላታ ያርሾ። <verse eid="HEB 13:15"/><verse number="16" style="v" sid="HEB 13:16"/>ሎኦ ባዝ ኦኔ የዛ ባዛፕ ሀራስ ሻጎ ዶግፓተ፥ ጾስ ኡፋይስዛይ የይ ጋርክ ያርሾ።<verse eid="HEB 13:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17"/>ይንታን አቅስዝታይስ ኪትንቶይታ፥ ኡ ማዉታይፐካ ኦሞር የዞይታ፥ ኡንቲ ኦይጭንትዝ ማዉተ የዛ ግሾ ይ ሸምፓይስ ዋይዛ፥ ይ ኡንትስ ኪትንትኮ ኡ ፋ ኦሳ ኡፋይሳር ኦዳ፥ የይፕ አትኮ አዛንታር ኦዛ፥ የይ ይንታን ማድዛ ባዝ ባያ።<verse eid="HEB 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18"/>ኑስ ዎሶይታ፥ ኡባ ባዛር ኑ ሎኦር የዞዳይ ጋርክ ኑስ ሎኦ ካሃ ኑስ የዛና ኑ ኤሬዛ። <verse eid="HEB 13:18"/><verse number="19" style="v" sid="HEB 13:19"/>ኡባራካ ታ ይንትኮ ኤልሲ ማቃዳይ ጋርክ ሚንጊ ዎሶይታ።<verse eid="HEB 13:19"/></para>
  <para style="s1">ዉርስ ዎሳ</para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20"/>መና ጫቆ ሱር ባይራ ዱርታይስ ሄንንቾ ማቄዝ ኑ ጎዳ የሱሳና Ꮊይቆፕ ደንዝ ሳሮት ጎዳ <verse eid="HEB 13:20"/><verse number="21" style="v" sid="HEB 13:21"/>ኤ ሸና ፖሎድ ጋርክ ሎኦ ኦሶ ኡባር ይንታን ዳንጭሾ፥ ኤዛ ኡፋይስዛ ባዝ የሱስ ክርስቶሳ ባጋር ኑል ኦ፥ የሱስ ክርስቶሳስ መናፕ መና ሄሎዳይስ ቦንቾ ማቆ አምንኤ።<verse eid="HEB 13:21"/></para>
  <para style="s1">ዉርስ</para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22"/>ታ እሹን Ꮊና ታ ጻፌዛና ሃታ ኪታ ማቄዝ ግሾስ ታ ዞረ ቃላቶ ዳንዳአር ናጎድ ጋርክ ሚን ታ ይንታን ዎስዛ። <verse eid="HEB 13:22"/><verse number="23" style="v" sid="HEB 13:23"/>ኑ እሻ ጽማቶሳ አቻፕ ብልእንቴዛና ኤሮይታ። ኤ ኤልሲ Ꮊና ይእኮ ታ ኤዛር ዎላ ይንታን በአዳይስ Ꮊማዳ።<verse eid="HEB 13:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24"/>ይንታን አቅስዛ አሳይስኔ ጌሽ አስ ኡባይስ ሳሮ ሺሾይታ፥ ጻላነፕ ይኢ Ꮊይዳ የዝ አማኔዝ አሳይ ሳሮ ይንትስ ሺሽዛ።<verse eid="HEB 13:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25"/>ኣ ኬሄት ኑር ኡባይር ማቆ አምንኤ።<verse eid="HEB 13:25"/></para>
  <chapter eid="HEB 13"/>
</usx>
