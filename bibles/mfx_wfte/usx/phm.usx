<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- Melo New Testament Ethiopic</book>
  <para style="h">ፍልሞና</para>
  <para style="toc1">ጳዉሎሳ ፍልሞናስ ጻፌዝ ዳብዳበ</para>
  <para style="toc2">ፍልሞና</para>
  <para style="toc3">ፍልሞ.</para>
  <para style="mt1">ጳዉሎሳ ፍልሞናስ ጻፌዝ ዳብዳበ</para>
  <para style="imt">ገሎ</para>
  <para style="ip">ፕልሞና አማኖር ኤርንቴዝ አሲ። አሳይ ኤዛና ቆላስያሳ ዎሳ ኬ አስ ማቃዳ ዬጊ ቆፕዛ። ፕልሞናስ አናስሞሳ ግዝ አይላይ የዛ። Ꮊ አይላይካ ፋ ጎዳይ ካራፕ በተ Ꮊንግታር አች ኬ የዝ ጳዉሎሳር ዎል ሄሌዛ። ጳዉሎሳ ባጋር ጾሳ አማኔዛ። ጳዉሎሳ ፕልሞናስ ጻፌዝ ኪታይ ፕልሞና ማቂ ኤኮ ይእል የዝ አይላይር ዳቦቶዳይ ጋርክ ቆፕስዛያ። ማ ጉጅካ አናስሞሳ ጾስ አማንዛ ግሾስ ይከፕ አማንዛ አስ ጋርክ ኤኮዳይፕ አትን ይከፕ አይለ ጋርክ ፓይድፐ ዬጊ ኦድዛ።</para>
  <para style="iot">ፍልሞና ኪታይ አይኬዝ ቆፋ</para>
  <para style="io1">ገሎ <char style="ior"><ref loc="PHM 1:1-3">1-3</ref> </char></para>
  <para style="io1">ጳዉሎሳ ፍልሞናና ጋላቶ <char style="ior"><ref loc="PHM 1:4-7">4-7</ref> </char></para>
  <para style="io1">ጳዉሎሳ አናስሞሳስ ሺሼዝ ምኖ ዎሳ <char style="ior"><ref loc="PHM 1:8-22">8-22</ref> </char></para>
  <para style="io1">ኩስተ ቆፋ <char style="ior"><ref loc="PHM 1:23-25">23-25</ref> </char></para>
  <chapter number="1" style="c" sid="PHM 1"/>
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1"/>የሱስ ክርስቶሳስ አጭንቴዝ ታ ጳዉሎሳፐኔ ኑ እሻ ጽማቶሳፕ ዶስንቴዝ ኑር ዎላ ኦዝ ፍልሞናስ <verse eid="PHM 1:1"/><verse number="2" style="v" sid="PHM 1:2"/>ኑ ምሽቲ ኣፍብያስኔ ኑር ክርስቶሳስ ዎታዳረ ማቄዝ ኣርክጳሳስኔ ነ ካራ ሺቅዛ አማንዛ አስ ኡባይስ <verse eid="PHM 1:2"/><verse number="3" style="v" sid="PHM 1:3"/>ጾሳ ኑ አዳይፐኔ ኑ ጎዳ የሱስ ክርስቶሳ ኣ ኬሃትይኔ ሳሮትይ ይንትስ ማቆ።<verse eid="PHM 1:3"/></para>
  <para style="s1">ፍልሞና ሲቆኔ አማኖ</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4"/>ታ ዎሳይድ ኡባ ዎደ ነና ቆፕ ታ ጾሳ ጋላትዛ። <verse eid="PHM 1:4"/><verse number="5" style="v" sid="PHM 1:5"/>ጎዳ የሱሳል የዝ ነ አማናኔ አማንዛ አሳይስ የዝ ነ ቃ ታ ስኤዛ። <verse eid="PHM 1:5"/><verse number="6" style="v" sid="PHM 1:6"/>ኔኒ ነ አማና ሀራ አስስ ሻግዛይ ኑስ ክርስቶስ የሱሳ ባጋር ይእዛ ሎኦ ባዝ ኡባይ ኤርንቶድ ጋርክ ታኒ ጾሳ ዎስዛ። <verse eid="PHM 1:6"/><verse number="7" style="v" sid="PHM 1:7"/>ታ እሻዮ አማንዝታይ ዎዝናይ ነ ኦሳይር ሼምፔዝ ግሾስ ነ ሲቃይር ጋመ ኡፋይስኔ ምን ታ ደንጌዛ። <verse eid="PHM 1:7"/><verse number="8" style="v" sid="PHM 1:8"/>የይ ግሾስ ነ ኦዳይስ ቤዝዛ ባዝ ኦባ ግ ክርስቶሳ ባጋር ያሻ ባይ ኪቶዳዝን፥ <verse eid="PHM 1:8"/><verse number="9" style="v" sid="PHM 1:9"/>ኡባር Ꮊይ ጋርክ ሀኔዝ ታ ጳዉሎሳ ጭማይ፥ Ꮊተካ ማ የሱስ ክርስቶሳስ አች ማቄዛይ፥ ሲቆ ባጋ ዎስዛ። <verse eid="PHM 1:9"/><verse number="10-11" style="v" sid="PHM 1:10-11"/>ካሰ ነና ማደካ አትኮካ Ꮊት ማቅኮ ነናካ ታናካ ማድዛ ግሾስ ታ አቻ የዛር ክርስቶሳ ባጋር የሌዝ ታ ናአ አናስሞሳ ግሾ ዎስዛ። <verse eid="PHM 1:10-11"/><verse number="12" style="v" sid="PHM 1:12"/>ታ ኤዛ ኔኮ ማሂ ዳኮዳ፥ ኔኒ ታ ዎዝናይ ጋርክ ኔኮ ዳኬዛይ ጋርክ ኡዲ ኤኮባ። <verse eid="PHM 1:12"/><verse number="13" style="v" sid="PHM 1:13"/>ታ ዎንግለ ግሾስ አጭንቲ የዝን ኤ ነ አቆ ታና ማዶድ ጋርክ ታ ኤዛ አሾድ ጌዝን። <verse eid="PHM 1:13"/><verse number="14" style="v" sid="PHM 1:14"/>ዝን ነ ሎኦትይ ዎልቃንር ባዝን ዶሶር ማቃድ ጋርከ ግ ኔር ዞርንተካዛር አሾዳይስ ታኮየካያ። <verse eid="PHM 1:14"/><verse number="15" style="v" sid="PHM 1:15"/>ኤ ኔፕ ሻግንቲ ጋምኤዛይ ኡባ ዎደ ኔር የዞድ ግሾስ ማቃዳ። <verse eid="PHM 1:15"/><verse number="16" style="v" sid="PHM 1:16"/>Ꮊይፕ ጉየ ኔር የዞዳይ አይለ ጋርክ ባዝን አይለፕ ኣ ዶስንቴዝ እሸ ጋርከ፥ ኤ ታስ ዶስንቴዝ እሸ ማቅኮ ኔስ አሾራኔ አያናር ሲቆ እሸ ዋይዚ ማቆሳ? <verse eid="PHM 1:16"/><verse number="17" style="v" sid="PHM 1:17"/>ይኬ ታና ኔስ እሸ ኡዲ ኤክኮ ኤዛካ ታ ጋርክ ኡዲ ኤኮባ። <verse eid="PHM 1:17"/><verse number="18" style="v" sid="PHM 1:18"/>አባባዝካ ነና ቆሄዝ ባዝ የዝኮኔ አጮ ኤዛል የዝኮ ታል ኦሎባ። <verse eid="PHM 1:18"/><verse number="19" style="v" sid="PHM 1:19"/>ታ ጳዉሎሳ ታ ኩሸር ኤ አጫ ጭጎዳ ግ ኔስ ጻፌዛ፥ ነ ነ ኡባስ ታ አጮር የዛና ታ ቆፕሳሚ። <verse eid="PHM 1:19"/><verse number="20" style="v" sid="PHM 1:20"/>ይኬ ታ እሻዮ Ꮊ ሎኦ ኦሳ ነ ታስ ኦድ ጋርክ ታ ነና ዎስዛ። ሀያና ታ ዎዝና ጎዳይ ባጋር ሸምፕሶባ <verse eid="PHM 1:20"/><verse number="21" style="v" sid="PHM 1:21"/>ታ ኔስ ጌዛይፕ ኣ ነ ኦዛይ ግሾስነ አዛዝንትዛ ግሾስ ታ ኤሪ ኦድዛ። <verse eid="PHM 1:21"/><verse number="22" style="v" sid="PHM 1:22"/>የይዳካ ጾሳይ ይ ዎሳ ስኢ ታና ይንትኮ ካማዳና ታ ኡፋይትዛ ግሾስ ታስ ሸምፕዛ አቆ ጊግሶይታ። <verse eid="PHM 1:22"/><verse number="23" style="v" sid="PHM 1:23"/>የሱስ ክርስቶሳ ግሾ ታር አጭንቴዝ ኤጳፍራ ሳሮ ሺሽዛ። <verse eid="PHM 1:23"/><verse number="24" style="v" sid="PHM 1:24"/>ታር ዎላ ኦዛ ማርቆሳራ አርስጽሮኮሳ ዴማሳ ሉቃሳካ ሳሮ ሺሽዛ። <verse eid="PHM 1:24"/><verse number="25" style="v" sid="PHM 1:25"/>ጎዳ የሱስ ክርስቶሳ ኣ ኬሄትይ ይንታር ማቆ።<verse eid="PHM 1:25"/></para>
  <chapter eid="PHM 1"/>
</usx>
