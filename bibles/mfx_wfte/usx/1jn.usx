<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1JN" style="id">- Melo New Testament Ethiopic</book>
  <para style="h">1ዋንሳ</para>
  <para style="toc1">ዋንሳ ጻፌዝ ኪታ</para>
  <para style="toc2">1ዋንሳ</para>
  <para style="toc3">1ዋን.</para>
  <para style="mt1">ዋንሳ ጻፌዝ ቲና ኪታ</para>
  <para style="imt">ገሎ</para>
  <para style="ip">ሀዋረ ዋንሳ ጻፌዝ ቲና ኪታይ፥ ናምኢ ኣፈ ቆፍታ አይኬዛ። የይካ ናባብዝታይ ጾሳራኔ ኤ ናአ የሱስ ክርስቶሳር ፐትፐተ የዞዳይ ጋርክ ምንዳይስኔ የ ፐትፐተ ብስዛ ዎርዶ ትምርታይፕ ሃኮዳይ ጋርክ ኡንታን ቆፕሶዳይሲ። የ ዎደ ደንዴዝ ዎርዶ ትምርታይ፥ «ጾስ በንቶዋ አያና አላመ መዛ። Ꮊ በንትዝ አላማኔ ኑ አሰት ጾስ መካ ግሾስ ኢታ። ማ Ꮊ በንትዝ አላማኔ ኑ አሰትይ ኑ አያና ቆሆዳይስኔ ቱንሶዳይስ ዳንዳኦያ» ዬጊ ታማርስዛ። የያ ጉሳይ፥ ቲና፥ የሱሳ አስ ማቂ የኤካያ። ናምአንይ፥ ፐቲ አስ ፋ አያና ቱንሰካ የዛር ፋ አሾር ናጋራ ኦዳይስ ዳንዳእዛ ዬግዛ።</para>
  <para style="ip">የይ ግሾስ፥ ዋንሳ ፋ ኪታይድ፥ የሱሳ አስ ማቅዛ ካድዛ ኦንካ ጾስ ናአ ባያ (4:2-3)። ማ ጾሳፕ የልንቴዝ ኦንካ ኡባ ዎደ ናጋራራ የዞያ (3:6) ዬጊ ጻፌዛ።</para>
  <para style="ip">የ ዎርዶ አስታማርታይ፥ «አቶት ጉሳይ፥ Ꮊ ሳአ የስስ ኡንእንቶፕ ከዚ ዋሎ ከስ ጉስ» ዬግዛ። የይል አፋ ጉጂ፥ «ኢታኔ ሎኦ ሻኪ አይክ ማቅን፥ ማ ሀራ አስ ሲቆ ማቅን አቶትር አብካ ሄልዛ ባዝ ባያ» ዬግዛ።</para>
  <para style="ip">ጻፋይ Ꮊ ትምርታ እጺ፥ «የሱስ ክርስቶሳ ፎሎ አስ፤ የሱሳ አማንዝታይኔ ጾስ ሲቅዝታይ ኡባይ ፋ ጋንጨ ፐታይ ፐታይር ሲቅንቶዳይስ ቤዝዛ» ዬጊ ኦዴዛ።</para>
  <para style="iot">1 ዋንሳ ኪታይ አይኬዝ ቆፍታ</para>
  <para style="io1">ገሎ <char style="ior"><ref loc="1JN 1:1-4">1:1-4</ref> </char></para>
  <para style="io1">ፖኦኔ ማ <char style="ior"><ref loc="1JN 1:5-2:29">1:5—2:29</ref> </char></para>
  <para style="io1">ጾስ ናእታኔ ዳቡሎሳ ናእታ <char style="ior"><ref loc="1JN 3:1-24">3:1-24</ref> </char></para>
  <para style="io1">ቱማኔ ዎርዶ <char style="ior"><ref loc="1JN 4:1-6">4:1-6</ref> </char></para>
  <para style="io1">ሲቆ ኦሶ <char style="ior"><ref loc="1JN 4:7-21">4:7-21</ref> </char></para>
  <para style="io1">ጋምዝ አማኖ <char style="ior"><ref loc="1JN 5:1-21">5:1-21</ref> </char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="1JN 1"/>
  <para style="s1">ደኦ ቃላ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 1:1"/>ቲናፕ አይኪ የዝ፥ ደኦ ቃላይ ባጋ ኑ ይንትስ ጻፍዛ። Ꮊ ደኦ ቃላይ ኑ ኑ ሀየር ስኤዝ፥ ኑ ኣፈር በኤዝ፥ ኑ ኩሸር አይኬዛያ።<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="JHN 1:1">ዋን. 1:1</ref></char></note> <verse eid="1JN 1:1"/><verse number="2" style="v" sid="1JN 1:2"/>የ ደኦ እንግዛይ ቆንጭን፥ ኑኒ ኤዛ ብኢ፥ ኤባዝ ማርካትዛ። አዳይ ካለ የዛይ ኑስ ቆንጬዝ፥ መና ደኦባጋ ይንትስ ኦዶዳ።<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="JHN 1:14">ዋን. 1:14</ref></char></note> <verse eid="1JN 1:2"/><verse number="3" style="v" sid="1JN 1:3"/>ኑራ ይንትስ ፐትፐት የዞዳይ ጋርክ ኑኒ በኤዛናኔ ስኤዛና ይንትስ ኦዶዳ። ኑ ፐትፐትይ አዳይራኔ ኤ ናአ የሱስ ክርስቶሳር ዎላ። <verse eid="1JN 1:3"/><verse number="4" style="v" sid="1JN 1:4"/>ኑ ኡፋይሳይ ፎሎ ማቆዳይ ጋርክ Ꮊያ ይንትስ ኑ ጻፎዳ።<verse eid="1JN 1:4"/></para>
  <para style="s1">ጾስ ፖኦ</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5"/>ኑኒ ኤፕ ስኢ፥ ይንትስ ኦድዛ ኪታይ፦ «ጾሲ ፖኦ፤ ኤዛር ማ የሻ ባያ» ዬግዛያ። <verse eid="1JN 1:5"/><verse number="6" style="v" sid="1JN 1:6"/>ኑስ ኤዛር ፐትፐተ የዛ ዬግታር ኑ ማ የዝኮ፥ ኑኒ ዎርዶትዛ። ቱማካ ኑር ባያ። <verse eid="1JN 1:6"/><verse number="7" style="v" sid="1JN 1:7"/>ዝን ኤ ፖኦ የዛይ ጋርክ፥ ኑካ ፖኦ የዝኮ፥ ኑስ ዎል ጋንጨ ፐትፐተ የዛ። ኤ ናአ፥ የሱሳ ሱይ ናጋራ ኡባይፕ ኑና ጌሽዛ።<verse eid="1JN 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1JN 1:8"/>ኑኒ፥ ኑር ናጋራ ባያ ጊኮ ኑ ኑና ዶሽዛ፤ ኑር ቱማትካ ባያ። <verse eid="1JN 1:8"/><verse number="9" style="v" sid="1JN 1:9"/>ዝን ጾሳይስ ኑ ናጋራ ቡጽኮ፥ ኤ ኑ ናጋራ አቶ ጎዳይስኔ ኑ ቆሆ ኦሶ ኡባይፕ ኑና ጌሾዳይስ፥ አማንንቴዛያኔ ጌሻ። <verse eid="1JN 1:9"/><verse number="10" style="v" sid="1JN 1:10"/>ኑኒ ናጋራ ኦካ ጊኮ ጾሳና ዎርዶ ከስዛ፤ ኤ ቃላይካ ኑር ባያ።<verse eid="1JN 1:10"/></para>
  <chapter eid="1JN 1"/>
  <chapter number="2" style="c" sid="1JN 2"/>
  <para style="s1">ክርስቶሳ ኑ ኣፋካቶ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1"/>ታ ናኡን፥ ናጋራ ይ ኦማይ ጋርክ ታኒ Ꮊያ ይንትስ ጻፍዛ። ዝን ኦንካ ናጋራ ኦኮ ጾስ አዳይ ካንታ ኑ አፋካታይ፥ ኤካ ጽላይ፥ የሱስ ክርስቶሳ፥ የዛ። <verse eid="1JN 2:1"/><verse number="2" style="v" sid="1JN 2:2"/>ኑ ናጋራይ ክርስቶሳ ባጋር አቶ ግንትትዛ። ኤ ኑ ናጋራ ኣዳ ባዝን አላመ ኡባይ ናጋራስ ያርሽንቴዛ።<verse eid="1JN 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 2:3"/>ኑኒ ጾስ ኪታ ናግኮ፥ ስ ባይ፥ ቱማ ኑ ኤዛ ኤርዛ። <verse eid="1JN 2:3"/><verse number="4" style="v" sid="1JN 2:4"/>ኦንካ፥ «ታኒ ኤዛ ኤርዛ» ዬግታር፥ ኤ አዛዛ ናጋም እጽኮ የ አይ ዎርዶ፤ ቱማት ኤዛር ባያ። <verse eid="1JN 2:4"/><verse number="5" style="v" sid="1JN 2:5"/>ዝን ኤ ቃላይስ ኑ አዛዝንትዛ ኡባይስ ጾሳይስ የዝ ሲቃይ ፎሎ ማቅዛ። ኑኒ ጾሳር የዝ የሳይስ የይ ፓስ ቱማ ማርካ። <verse eid="1JN 2:5"/><verse number="6" style="v" sid="1JN 2:6"/>ታኒ፥ «ጾሳር የዛ» ግዝ ኦንካ ክርስቶሳ የዜዛይ ጋርክ የዞዳይስ ቤዝዛ።<verse eid="1JN 2:6"/></para>
  <para style="s1">ኦሮ አዛዞ</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 2:7"/>ታ ሲቆ እሹን፥ ታኒ ይንትስ ቲናፕ የዝ አዛዛ ጻፍነፕ አትን ኦሮ ኪታ ጻፋሚ። የይካ ይ ስኤዝ ብኒ አዛዛ።<note caller="-" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="JHN 13:34">ዋን. 13:34</ref></char></note> <verse eid="1JN 2:7"/><verse number="8" style="v" sid="1JN 2:8"/>ማቆፕ አትን፥ ክርስቶሳራኔ ይ የሳይድ ቱማ ማቂ የዝ፥ ኦሮ አዛዛ ጻፍዛ። ማይ ሀልእን፥ Ꮊት ቱማ ፖአይ ፖእዛ።<verse eid="1JN 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 2:9"/>«ታ ፖኦ የዛ» ጊታር ፋ እሻ እጽዛ ኦንካ፥ Ꮊኖ ሄሎዳይስ ማ የዛ። <verse eid="1JN 2:9"/><verse number="10" style="v" sid="1JN 2:10"/>ፋ እሻ ቃዛ ኦንካ ፖኦ የዛ። የ አይር ሀራ አስ ቢዛባዝ ባያ። <verse eid="1JN 2:10"/><verse number="11" style="v" sid="1JN 2:11"/>ዝን ፋ እሻ እጽዛ ኦንካ ማ የዛ፤ ማር የዛ። ማ ኤ አፋ ቶእሴዝ ግሾስ አና Ꮊንግዛኮ ኤሮያ።<verse eid="1JN 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1JN 2:12"/>ታ ናኡን፥ ክርስቶሳ ሱንይ ባጋር ይ ናጋራይ አቶ ግንትንቴዝ ግሾስ ታኒ ይንትስ ጻፖዳ። <verse eid="1JN 2:12"/><verse number="13" style="v" sid="1JN 2:13"/>አዱን፥ ቲናፕ የዛና፥ ይ ኤሬዝ ግሾስ ይንትስ ጻፎዳ። የላግታዮ፥ ጻላሄ ይ ጋሜዝ ግሾስ ይንትስ ጻፎዳ። <verse eid="1JN 2:13"/><verse number="14" style="v" sid="1JN 2:14"/>ናኡን፥ ጾስ ኣዳ ይ ኤሬዝ ግሾስ ይንትስ ጻፌዛ። አዱን፥ ቲናፕ የዝ ኤዛ ይ ኤሬዝ ግሾስ ይንትስ ጻፌዛ። ናኡን፥ ይ ምኖ ማቄዝ ግሾስ ጾስ ቃላይ ይንታር የዛ ግሾኔ ጻላሄና ይ ጋሜዝ ግሾስ ይንትስ ጻፌዛ።<verse eid="1JN 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 2:15"/>አላመ ዎይ አላመ ባዝ ኡባ ዶስፓተ። አላመ ዶስዛ ኦንካ ጾስ ኣዳ ዶሶያ። <verse eid="1JN 2:15"/><verse number="16" style="v" sid="1JN 2:16"/>አላመል የዝ ኡባይ፥ አሾ አሞት፥ ኣፈስ ሎእዝ ባዝ አሞትኔ ሚሸር ጬቅንት አላመባዛፕ አትን ጾሳፕ ባያ። <verse eid="1JN 2:16"/><verse number="17" style="v" sid="1JN 2:17"/>አላመኔ አሞት ኡባይ ኣዳ፥ ዝን ጾስ ሸነ ፖልዛ ኦንካ መናስ የሳዳ።<verse eid="1JN 2:17"/></para>
  <para style="s1">ክርስቶሳና እጽዝታይፕ ናግንቶ</para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 2:18"/>ታ ናኡን፥ ዎደ ዉርስይ ኡኬዛ። ክርስቶሳ እጽዛይ ቲናፕ የኦዳና ይ ስኤዛይ ጋርክ ሀራ አቶዝን፥ Ꮊተካ ኤዛ እጽዝታይ ጋምታይ ደንዴዛ። የይ ግሾስ፥ ዎደ ዉርስይ ኡኬዛያ Ꮊይር ኑኒ ኤርዛ። <verse eid="1JN 2:18"/><verse number="19" style="v" sid="1JN 2:19"/>የ ጽዝታይ ኑ ባጋ ማቀካ ግሾስ ኑ ጋንጨፕ ከዜዝ። ኡንቲ ኑ ባጋ ማቄዛኮ ኑራ ጋርዢ የዞዳ፥ ዝን ኡንታፕ ኦንካ ኑ ባጋፕ ባዛይ ኤርንቶዳይ ጋርክ ኑ ጋንጨፕ ከዜዝ።<verse eid="1JN 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 2:20"/>ዝን ክርስቶሳ ይንታን ፋ ጌሻ አያናር ትዤዛ፤ የይ ግሾስ ይ ኡባይ ኡባ ባዝ ኤርዛ። <verse eid="1JN 2:20"/><verse number="21" style="v" sid="1JN 2:21"/>ቱማ ይ ኤርዛ ግሾኔ ቱማር አባ ዎርዶካ ባዛያ ይ ኤርዛ ግሾስ ታኒ ይንትስ ጻፍነፕ አትን ቱማ ይ ኤሮዋ ግሾስ ባያ።<verse eid="1JN 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1JN 2:22"/>የሱሳና፥ ጾስ ዶሬዛ ባያ ግ ካድዛ አሳይፕ ሀራ ዎርዳንቻይ ኦኖ? የይ ጋርክ አስ ክርስቶሳ ሞርከ። ናአ ካድኮ አዳካ ካድዛ። <verse eid="1JN 2:22"/><verse number="23" style="v" sid="1JN 2:23"/>ናአ ካድዛ ኦስካ አደ ባያ፤ ማ ናአይስ ማርካትዝ ኦስካ አደ የዛ።<verse eid="1JN 2:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1JN 2:24"/>የይ ግሾስ፥ ቲና ይ ስኤዝ ቃላ ይ ዎዝናይድ ሚን ናጎይታ። ቲና ስኤዝ ቃላይድ ሚንጊ የዝኮ ይንትስ ናአይራኔ አዳይራ ፐትፐተ የዞዳ። <verse eid="1JN 2:24"/><verse number="25" style="v" sid="1JN 2:25"/>Ꮊይካ ክርስቶሳ ኑስ እንጌዝ ኡፋይሳይ መና ደኦ።<verse eid="1JN 2:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1JN 2:26"/>ይንታን ባልዛ አሳይ ግሾስ ታኒ Ꮊያ ይንትስ ጻፌዛ። <verse eid="1JN 2:26"/><verse number="27" style="v" sid="1JN 2:27"/>ክርስቶሳፕ ይ ኤኬዝ አያናይ ይ ጋንጨ የዝዛይ ግሾስ ሀራ አስታማረ ኮሾያ። ኤ ይንታን ኡባ ባዝ ታማርሶዳ አያናይ ይንታን ቱማ ታማርስነፕ አትን ዎርዶ ባያ። የይ ግሾስ ጌሻ አያናይ ይንታን ታማርሴዛይ ጋርክ ክርስቶሳር የዞይታ።<verse eid="1JN 2:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1JN 2:28"/>ይኬ፥ ታ ናኡን፥ ኤ ቆንጭዝ ዎደ ኑኒ ያሻ ባይኔ ኤ ማቂ ይእዛ ጋላስ ኤ ቲና ኑ ዬላታማይ ጋርክ ኤዛር የዞይታ። <verse eid="1JN 2:28"/><verse number="29" style="v" sid="1JN 2:29"/>ክርስቶሳ ጌሽ ማቄዛና ይ ኤርኮ ጌሽ ኦሶ ኦዛ ኡባይ ጾሳፕ የልንቴዛ ማቄዛና ኤሮይታ።<verse eid="1JN 2:29"/></para>
  <chapter eid="1JN 2"/>
  <chapter number="3" style="c" sid="1JN 3"/>
  <para style="s1">ጾስ ናእታ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1"/>ኑኒ ጾስ ናእታ ግንትንቲ ጼግንቶድ ጋርክ ጾሲ ኑና አብ ጋርክ ዶሴዛኮ ቦኦይታ። ኑኒ ቱማካ ጾስ ናእታ። Ꮊ አላማይ ጾሳ ኤረካ ግሾስ ኑናካ ኤሮያ።<note caller="-" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="JHN 1:12">ዋን. 1:12</ref></char></note> <verse eid="1JN 3:1"/><verse number="2" style="v" sid="1JN 3:2"/>ታ ሲቆ እሹን፥ Ꮊት ኑኒ ጾስ ናእታ፤ ኑኒ ሀሮንተስ አብ ሀኖዳዛኮ ሀጋ ኤርንተካያ። ዝን ክርስቶሳ ቆንጭዝ ዎደ ኑኒ ኤዛር የዞዳና ኤርዛ። ኤ ቱማ የዛና ኑኒ በአዳ። <verse eid="1JN 3:2"/><verse number="3" style="v" sid="1JN 3:3"/>ክርስቶሳ ቦኦዳ ግ ኡፋይሳር ናግዛ ኦንካ፥ ክርስቶሳ ጌሽ ማቄዛይ ጋርክ ፋና ጌሽዛ።<verse eid="1JN 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 3:4"/>ናጋራ ህገ መን ማቄዝ ግሾስ ናጋራ ኦዛ ኡባይ ጾስ ህገ መንዛ። <verse eid="1JN 3:4"/><verse number="5" style="v" sid="1JN 3:5"/>ክርስቶሳ አሳይ ናጋራ ብሶዳይስ ቆንጬዛና ይ ኤርዛ፤ ኤዛር ናጋራ ባያ።<note caller="-" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="JHN 1:29">ዋን. 1:29</ref></char></note> <verse eid="1JN 3:5"/><verse number="6" style="v" sid="1JN 3:6"/>የይ ግሾስ ክርስቶሳር የዝ ኦንካ ናጋራራ ኦያ። ማ ናጋራራ የዝ ኦንካ ኤዛ በኤካያ ዎይ ኤረካያ።<verse eid="1JN 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 3:7"/>ታ ናኡን፥ ይንታን ኦንካ ባልፐ። ክርስቶሳ ጌሽ ማቄዛይ ጋርክ ጌሽ ኦዛ ኦንካ ጌሺ። <verse eid="1JN 3:7"/><verse number="8" style="v" sid="1JN 3:8"/>ዳቡሎሳ ቲናፕ አይኪ ናጋራ ኦዝ ግሾስ ናጋራ ኡባ ዎደ ኦዛ ኦንካ ዳቡሎሳ ዳቦ። የይ ግሾስ፥ ጾስ ናአይ ዳቡሎሳ ኦሶ ላሎዳይስ ቆንጬዛ። <verse eid="1JN 3:8"/><verse number="9" style="v" sid="1JN 3:9"/>ጾሳፕ የልንቴዝ ኦንካ ጾስ አያናይ ኤዛል የዝ ግሾስ ኤ ኡባ ዎደ ናጋራራ ኦያ። ጾሳፕ የልንቴዝ ማቄዝ ግሾስ ናጋራራ ኦያ ኦዳይስ ዳንዳኦያ። <verse eid="1JN 3:9"/><verse number="10" style="v" sid="1JN 3:10"/>ጾስ ናእታይኔ ጻላሄ ናእታይ የዝ ዱማትይ Ꮊይር ኤርንትዛ፤ ጌሽ ኦዋዛይኔ ዎይ ፋ እሻ ዶሶዋ አስ ጾስ ናአ ባያ።<verse eid="1JN 3:10"/></para>
  <para style="s1">ዎል ዶሶይታ</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11"/>ስሳፕ ይ ስኤዝ ኪታይ፥ «ዎል ዶሶዳይስ ቤዝዛ» ዬግዝ ኪታ።<note caller="-" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="JHN 13:34">ዋን. 13:34</ref></char></note> <verse eid="1JN 3:11"/><verse number="12" style="v" sid="1JN 3:12"/>ኑኒ ቃኤላ ጋርክ ማቆዳይስ ቤዞያ። ቃኤላ ጻላሄ ዳቦ ማቂ ፋ እሻ ዎዛ። ኤ ፋ እሻ አብስ ዎኔ? ኤ ኦሳይ ኢታ ማቄዝ ግሾኔ ኤ እሻይ ኦሳይ ሎኦ ማቄዝ ግሾስ ዎዛ።<note caller="-" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="GEN 4:8">መ. 4:8</ref></char></note><verse eid="1JN 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 3:13"/>ታ እሹን፥ Ꮊ አላማይ ይንታን እጽኮ ማላባዝ ጊፐተ። <verse eid="1JN 3:13"/><verse number="14" style="v" sid="1JN 3:14"/>ኑኒ ኑ እሽታ ዶስዛ ግሾስ Ꮊይቆፕ ደኦ ፒንጌዛና ኤርዛ። ፋ እሻ ዶሶዋ ኦንካ Ꮊይቆ ኩያ የዛ።<note caller="-" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="JHN 5:24">ዋን. 5:24</ref></char></note> <verse eid="1JN 3:14"/><verse number="15" style="v" sid="1JN 3:15"/>ፋ እሻ እጽዛ ኦንካ ሸምፖ ዎዛያ። ማ ሸምፖ ዎዝ ኦስካ መና ደኦ ባዛና ይ ኤርዛ። <verse eid="1JN 3:15"/><verse number="16" style="v" sid="1JN 3:16"/>ክርስቶሳ ፋ ሸምፓ ኑ ግሾስ ኣ እንጌዛይድ ሲቆ አብዛኮ ኑኒ ኤሬዛ። ኑካ ኑ እሽታይ ግሾስ ኑ ሸምፓ ኣ እንጎዳይስ ቤዝዛ። <verse eid="1JN 3:16"/><verse number="17" style="v" sid="1JN 3:17"/>ዝን ሀራ ማዶዳይስ ሳሎ የዝ ኦንካ መትንቴዛና ብእታር፥ ኤስ ቃንታም እጽኮ ፋ ዎዛናይር ጾስ ዶስዛ ጎዳይስ ዋይዚ ዳንዳኤ? <verse eid="1JN 3:17"/><verse number="18" style="v" sid="1JN 3:18"/>ታ ናኡን፥ ኑኒ ኦሶራኔ ቱማትር ኑ ሲቆ ቤዞዳይስ ቤዝዛፕ አትን ጨረ ኦዳ ኣዳር ዎይ ዶና ማልእ ኣዳር ሲቅንቶዳይስ ቤዞያ።<verse eid="1JN 3:18"/></para>
  <para style="s1">ጾስስ አማንንቶ</para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 3:19"/>Ꮊይራካ ቱማ አስታ ማቄዝታኔ ጾስ ቲና ህራ ባይ አማንንቲ ሺቆዳይስ ዳንዳእዛና ኤርዛ። <verse eid="1JN 3:19"/><verse number="20" style="v" sid="1JN 3:20"/>ኑ ዎዝናይ ኑል አፋ ፕርድዛ ባዝ ማቅኮካ፥ ጾሲ ኑ ዎዝናይፕ ግታ ማቄዝ ግሾስ ኤ ኡባ ባዝ ኤርዛ።<verse eid="1JN 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 3:21"/>ታ ሲቆ እሹን፥ ኑ ዎዝናይ ኑል አፋ ፕርዶዋ ባዝ ማቅኮ ኑና ጾስ ቲና ያሽዝ ባዝ ባያ። <verse eid="1JN 3:21"/><verse number="22" style="v" sid="1JN 3:22"/>ኑኒ ኤ አዛዛ ናግዛ ግሾኔ ኤዛ ኡፋይስዝ ባዝ ኦዛ ግሾስ ኑ ዎስዛ ኡባ ኤፕ ኤኮዳ። <verse eid="1JN 3:22"/><verse number="23" style="v" sid="1JN 3:23"/>ክርስቶሳ ኑና አዛዜዛይ ጋርክ ጾስ ናአ የሱስ ክርስቶሳ ሱንይር አማኖዳይ ጋርከኔ ዎል ሲቆዳይ ጋርክ ጾሲ ኑና አዛዜዛ።<note caller="-" style="x"><char style="xo" closed="false">3:23 </char><char style="xt" closed="false"><ref loc="JHN 13:34">ዋን. 13:34</ref>፤ <ref loc="JHN 15:12">15:12</ref>፥ <ref loc="JHN 15:17">17</ref></char></note> <verse eid="1JN 3:23"/><verse number="24" style="v" sid="1JN 3:24"/>ጾስ አዛዛ ናግዛ ኦንካ ጾሳር የዛ፤ ጾሳይካ ኤዛር የዛ። ጾሲ ኑስ እንጌዝ ጌሻ አያናይ ባጋር ኤ ኑር የዛና ኤርዛ።<verse eid="1JN 3:24"/></para>
  <chapter eid="1JN 3"/>
  <chapter number="4" style="c" sid="1JN 4"/>
  <para style="s1">ቱማ አያናኔ ዎርዶ አያና</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1"/>ታ ሲቆ እሹን፥ ዎርዶ ናብታይ አላመል ደንዴዝ ግሾስ አያና ኡባ አማንፓተ፥ ዝን Ꮊ አያንታይ ጾሳፐዛኮኔ ሀራፐባዛኮ ፓጪ ቦኦይታ። <verse eid="1JN 4:1"/><verse number="2" style="v" sid="1JN 4:2"/>ጾሲ አያና ማቄዛና ይ Ꮊይር ኤሮዳ፤ «የሱስ ክርስቶሳ አስ ማቂ አሾ ማኢ የኤዛና ማርካትዝ» አያና ኡባይ ጾሳፕ ይእዛ። <verse eid="1JN 4:2"/><verse number="3" style="v" sid="1JN 4:3"/>ክርስቶሳ አስ ማቂ የኤዛና አማኖዋ አያና ኡባይ ጾሳፕ ባያ። የይ ክርስቶሳር ኤቅንትዛ አያና። ይ የ አያናይ የኦዳና ቲና ስኤዛ፤ ኤ ሀራ አቶዝን Ꮊተካ አላመል የዛ።<verse eid="1JN 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 4:4"/>ታ ናኡን፥ ይ ጾስሲ። ይ ጋንጨ የዝ ጌሻ አያናይ አላመል የዝ አያናይፕ ዎልቃማ ማቄዝ ግሾስ ዎርዶ ናብታ ይ ጋሜዛ። <verse eid="1JN 4:4"/><verse number="5" style="v" sid="1JN 4:5"/>ዎርዶ ናብታይ Ꮊ አላማይ አስ ማቄዝ ግሾስ Ꮊ አላማይ ባጋ ኦድዛ፤ Ꮊ አላማይ አሳይ ኡ ኦዳ ስእዛ። <verse eid="1JN 4:5"/><verse number="6" style="v" sid="1JN 4:6"/>ኑኒ ጾስሲ፤ ጾስ ኤርዛ ኦንካ ኑና ስእዛ። ጾስስ ማቀካዝታይ ኑና ስኦያ። ኑኒ ቱማ አያናኔ ዎርዶ አያና ሻጊ ኤርዛይ የይራ።<verse eid="1JN 4:6"/></para>
  <para style="s1">ጾስ ሲቆ</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7"/>ታ ሲቆ እሹን፥ ሲቆ ጾሳፕ ማቄዝ ግሾስ ዎላ ሲቅንቶዳ። ሲቅዛ ኦንካ ጾስ ናአ፤ ኤ ጾሳካ ኤርዛ። <verse eid="1JN 4:7"/><verse number="8" style="v" sid="1JN 4:8"/>ጾሲ ሲቆ ማቄዝ ግሾስ ሲቅንቶዋ ኦንካ ጾስ ኤሮያ። <verse eid="1JN 4:8"/><verse number="9" style="v" sid="1JN 4:9"/>ኑኒ ክርስቶሳ ባጋር ደኦ ደንጎዳይ ጋርክ ጾሲ ፋ ፐቲ ናአ Ꮊ አላማይል ዳኬዛ። ጾሲ ኑና ፋ ሲቃ የይር ቤዜዛ። <verse eid="1JN 4:9"/><verse number="10" style="v" sid="1JN 4:10"/>ቱማ ሲቆ ጉሳይ Ꮊያ፦ ኑኒ ጾስ ሲቄዝ ግሾስ ባዝን ጾሲ ኑና ሲቄዝ ግሾኔ ኑ ናጋራይስ ያርሽንቲ ኑና ማሮዳይስ ፋ ናአ ኪቴዝ ግሾሲ።<verse eid="1JN 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 4:11"/>ታ ሲቆ እሹን፥ ጾሲ ኑና Ꮊይ ጋርክ ሲቅኮ፥ ኑንካ ዎል ሲቆዳይስ ቤዝዛ። <verse eid="1JN 4:11"/><verse number="12" style="v" sid="1JN 4:12"/>ኦንካ ጾስ በኤዛይ ባያ። ኑኒ ዎል ሲቅኮ ጾሲ ኑር የዛ፤ ኤ ሲቃይካ ኑር ፎሎ ማቅዛ።<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="JHN 1:18">ዋን. 1:18</ref></char></note><verse eid="1JN 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 4:13"/>ጾሲ ፋ አያና ኑስ እንጌዝ ግሾስ ኑኒ ጾሳር የዛኔ ኤካ ኑር የዛና ኑ ኤርዛ። <verse eid="1JN 4:13"/><verse number="14" style="v" sid="1JN 4:14"/>አዳይ ፋ ናአ፥ Ꮊ አላማ አሽዛያ ኡዲ አዛዜዛና ኑኒ በኤዛኔ ማርካትዛ። <verse eid="1JN 4:14"/><verse number="15" style="v" sid="1JN 4:15"/>የሱሳ ጾስ ናአ ማቄዛና አማንዛ ኦ ጋንጨካ ጾሲ የዛ፤ ኤካ ጾሳር የዛ። <verse eid="1JN 4:15"/><verse number="16" style="v" sid="1JN 4:16"/>ጾሲ ኑና ሲቅዛና ኑኒ ኤርዛኔ አማንዛ።</para>
  <para style="p" vid="1JN 4:16">ጾሲ ሲቆ፤ ሲቆር የዝ ኦንካ ጾሳር የዛ፤ ጾሳይካ ኤዛር የዝዛ። <verse eid="1JN 4:16"/><verse number="17" style="v" sid="1JN 4:17"/>ኑ የሳይ አላመል ክርስቶሳ የዜዛይ ጋርክ ማቄዝ ግሾስ ፕርዳ ጋላስ ያሻባይ ኤ ቲና ሺቆዳይስ ኤ ሲቃይ ኑር ፎሎ ማቅዛ። <verse eid="1JN 4:17"/><verse number="18" style="v" sid="1JN 4:18"/>ፎሎ ሲቆ ያሻ ከሲ ኦልዛፕ አትን ሲቆር ያሻ። ያሻ ሴራር ፐትፕ Ꮊንግዛ ግሾስ ያሽትዝ አይ ሲቃይ ፎሎ ባያ።<verse eid="1JN 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 4:19"/>ጾሲ ቲና ኑና ሲቄዝ ግሾስ ኑካ ሲቆዳ። <verse eid="1JN 4:19"/><verse number="20" style="v" sid="1JN 4:20"/>ኦንካ፥ «ጾስ ሲቅዛ» ጊታር ፋ እሻ እጽኮ፥ ኤ ዎርዶ። አብስ ጊኮ፥ ብእዛ ፋ እሻ ሲቆዋ ኦንካ በኤካ ጾሳ ዋይዚ ሲቆዳይስ ዳንዳኤ? <verse eid="1JN 4:20"/><verse number="21" style="v" sid="1JN 4:21"/>ክርስቶሳ ኑስ እንጌዝ ኪታይ Ꮊያ፤ «ጾስ ዶስዛ ኦንካ ፋ እሻ ሲቆዳይስ ቤዝዛ» ዬጌዛ።<verse eid="1JN 4:21"/></para>
  <chapter eid="1JN 4"/>
  <chapter number="5" style="c" sid="1JN 5"/>
  <para style="s1">አማኖር አላመ ጋም</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1"/>የሱሳ፥ ኤ ክርስቶሳ ዬጊ፥ አማንዛ ኦንካ ጾስ ናአ። አዳ ሲቅዛ ኦንካ ኤ ናአካ ሲቅዛ። <verse eid="1JN 5:1"/><verse number="2" style="v" sid="1JN 5:2"/>ኑኒ ጾስ ሲቅዛ ግሾኔ ኤ አዛዛ ናግዛ ግሾስ ጾስ ናእታ ሲቅዛና ኤርዛ። <verse eid="1JN 5:2"/><verse number="3" style="v" sid="1JN 5:3"/>ጾስ ዶስዛ ጉሳይ፥ ኤ አዛዛ ናጎ። ኤ አዛዛይካ ዴጾ ባያ።<note caller="-" style="x"><char style="xo" closed="false">5:3 </char><char style="xt" closed="false"><ref loc="JHN 14:15">ዋን. 14:15</ref></char></note> <verse eid="1JN 5:3"/><verse number="4" style="v" sid="1JN 5:4"/>ጾስ ናአ ማቄዛ ኦንካ Ꮊ አላማ ጋሞዳይስ ዳንዳእዛ። ኑኒ Ꮊ አላማ ጋሞዳይ ኑ አማናይራ። <verse eid="1JN 5:4"/><verse number="5" style="v" sid="1JN 5:5"/>የሱሳ ጾስ ናአ ማቄዛና አማንዛ አስ ኣዳፕ አትን ሀራ Ꮊ አላማ ጋሞዳይስ ዳንዳእዛይ ኦኖ?<verse eid="1JN 5:5"/></para>
  <para style="s1">ክርስቶሳ ባጋ ማርካት</para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 5:6"/>የሱስ ክርስቶሳ ጽንቃታ ቤዝዝ ሃራኔ ፋ Ꮊይቆ ቤዝዝ ሱር የኤዛ። ኤ፥ ሃራኔ ሱር የኤነፕ አትን ሃ ኣዳር የኤካያ። ጌሻ አያናይ ቱማ ማቄዝ ግሾስ የይ ቱማ ማቄዛና ማርካትዛ። <verse eid="1JN 5:6"/><verse number="7" style="v" sid="1JN 5:7"/>ሀይ ማርክታይ የዛ። <verse eid="1JN 5:7"/><verse number="8" style="v" sid="1JN 5:8"/>የይትታይ፥ አያና፥ ሃኔ ሱ። Ꮊ ሃይታይ ማርካትይ ፐቶ። <verse eid="1JN 5:8"/><verse number="9" style="v" sid="1JN 5:9"/>ኑ አስ ማርካት አማንዛ፥ ዝን ጾስ ማርካትይ አሳይሳይፕ ሎእ ኣዛ። ጾሲ ፋ ናአይስ ማርካቴዝ ማርካትይ Ꮊያ። <verse eid="1JN 5:9"/><verse number="10" style="v" sid="1JN 5:10"/>ጾስ ናአ አማንዛ አስ ዎዝናይድ Ꮊ ማርካትይ የዛ። ጾሳ አማኖዋ ኦንካ ጾሲ ፋ ናአይስ ማርካቴዝ ማርካት አማነካ ግሾስ ጾሳና ዎርዶ ኡድዛ።<verse eid="1JN 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 5:11"/>ይኬ፥ ማርካትይ Ꮊይ፤ ጾሲ ኑስ መና ደኦ እንጌዛ፤ የ ደአይካ ኤ ናአይር የዝ ዬግዛያ።<note caller="-" style="x"><char style="xo" closed="false">5:11 </char><char style="xt" closed="false"><ref loc="JHN 3:36">ዋን. 3:36</ref></char></note> <verse eid="1JN 5:11"/><verse number="12" style="v" sid="1JN 5:12"/>ጾስ ናአይ የዝ ኦስካ ደኦ የዛ። ጾስ ናአይ ባ ኦስካ ደኦ ባያ።<verse eid="1JN 5:12"/></para>
  <para style="s1">መና ደኦ</para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 5:13"/>ጾስ ናአይ ሱን አማንዛ ይንትስ መና ደኦ የዛና ይ ኤሮዳይ ጋርክ Ꮊያ ይንትስ ታ ጻፌዛ። <verse eid="1JN 5:13"/><verse number="14" style="v" sid="1JN 5:14"/>ጾስ ሸነ ጋርክ አብካ ኤዛ ኑ ዎስኮ፥ ኤ ስእዛና ኑ አማንዛ። <verse eid="1JN 5:14"/><verse number="15" style="v" sid="1JN 5:15"/>ኑኒ ዎስዛ ኡባ ኤ ስእዛ ኤርኮ፥ ኑኒ ዎስዛ ባዝ ኤ እንጎዳና ኤርዛ።<verse eid="1JN 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 5:16"/>ኦንካ ፋ እሻ Ꮊይቆስ ሄልዋ ናጋራ ኦዳር ብእኮ፥ ጾስ ኤስ ዎሶዳይስ ቤዝዛ። Ꮊይቆ ሄልዛ ናጋራ ኦዛይስ ጾስ ደኦ እንጎዳ። Ꮊይቆ ሄልዛ ናጋራ የዛ። ታኒ ይንታን የይስ ጾስ ዎሶይታ ጋሚ። <verse eid="1JN 5:16"/><verse number="17" style="v" sid="1JN 5:17"/>ኢታ ኦሶ ኡባይ ናጋራ፥ ዝን Ꮊይቆ ሄልዋ ናጋራ የዛ።<verse eid="1JN 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 5:18"/>ጾስ ናአይ የሱስ ክርስቶሳ ኤዛ ናግዛይ ግሾስ ጾስ ናአ ማቄዝ ኦንካ ናጋራራ ኡባ ዎደ የዞዋዛ ኑኒ ኤርዛ። ጻላሄ ኤዛ ቆሆዳይስ ዳንዳኦያ። <verse eid="1JN 5:18"/><verse number="19" style="v" sid="1JN 5:19"/>ኑኒ ጾስስ ማቄዛኔ Ꮊ ኩን አላማይ ጻላሄስ ሃርንትዛና ኤርዛ።<verse eid="1JN 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 5:20"/>ኑኒ ቱማ ጾሳ ኤሮዳይ ጋርክ ጾስ ናአይ የኤዛኔ ኑስ አካካ እንጌዛና ኑ ኤርዛ። ኑኒ ኤ ናአ፥ የሱስ ክርስቶሳራኔ ቱማ ጾሳር ፐትፐት የዛ። የሱሳ ቱማ ጾስኔ መና ደኦ።<verse eid="1JN 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 5:21"/>ታ ናኡን፥ ኤቅታይስ ጎይኖፕ ይ ሃኮይታ።<verse eid="1JN 5:21"/></para>
  <chapter eid="1JN 5"/>
</usx>
