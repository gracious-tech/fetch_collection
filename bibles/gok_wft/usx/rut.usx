<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="RUT" style="id">- Gawli Old Testment</book>
  <para style="h">ರುತ್</para>
  <para style="toc3">ರುತ್</para>
  <para style="toc2">ರುತ್</para>
  <para style="toc1">ರುತ್</para>
  <para style="mt2">ರುತಾಚ಼ ಪುಸ್ತಕ್</para>
  <para style="mt1">ರುತಾಚ಼ ಪುಸ್ತಕ್</para>
  <para style="imt">ವಳಕ್</para>
  <para style="ip">ರುತ್ ಪುಸ್ತಕ್ ಇಸ್ರಾಯೆಲಾಂಚಾ ಕಾಲಾತ್ ಜಾ಼ಲ್ಯಾಲಿ ಯಕಾ ಕುಟ್ಮಾಚಿ ವಿಚಿತ್ರ ಗಟ್ನಾ ವಿವರ್ನಾ ಕರ್ತ. ಹಿ ಕ್ಯಾಯ್ನಿ ನವೊಮಿ ಮಂತ್ಯಾಲಿ ಬಾಯಿಲ್ಮಾನುಸ್ ಆಪ್ಲಾ ಘೊ ಆನಿ ದೊಗ ಲ್ಯಾಕ್ ಮೊವಾಬ್ ದೆಶೆತ್ ಆಸ್ತಾನಾಸ್ ಮೆಲ ಮನ್ಹುನ್, ಖುಬ್ ದುಕ್ ಜಾ಼ಲ್ಯಾಲ್ಯಾನಿ ಸುರುವ್ಹತಿ. ಫನ್ ಮೊವಾಬ್ಯಾತ್ಲಿ ರುತ್ ಮಂತ್ಯಾಲಿ ಸುನ್ ನವೊಮಿಸಂಗ ಇಸ್ರಾಯೆಲತ್ ಮಾಗಾರಿ ಯತಿ ಆನಿ ತಿಲಾ ಮಜ಼ತ್ಕರಾಯಾ ಬರ‍್ವಾಸಾ ದಿತಿ. ಮಂಗ್ ಬೊವಜ ಮಂತ್ಯಾಲಾ ಕುಟ್ಮಾಚಾ ವಸಾತ್ಲಾ ನವೊಮಿ ಆನಿ ರುತಾಲಾ ಮಜ಼ತ್ಕರ್ತೊ ಆನಿ ರುತಾಲಾ ಲಗಿನ್ ವ್ಹಯಾ ಹು ಮಂತೊ. ನ್ಯಾಯದಿಸ್ವರಾಂಚಾ಼ ಯೊಳ್ ವಾಯಿಟ್ ಜಾ಼ಲ್ತಾ, ಖುಬ್ ಇಸ್ರಾಯೆಲಾಂಚಿ ಲೊಕ ಕ್ಯಾಯದ್ಯಾಲಾ ಮರ‍್ಯಾದ್ ದಿಯಿತ್ನವ್ತಿತ, ದೆವಾಚ಼ ನೆಮ್ ಪ್ಯಾಳತ್ಯಾಲ್ಯಾ ನವೊಮಿ, ರುತ್ ಆನಿ ಬೊವಜಾಂಚೆ ನಿಸ್ಟೆ ಆನಿ ಬಕ್ತಿಲಾ ಚಾ಼ಂಗ್ಲಿ ಉದಾರನ್ ಜಾ಼ಲೆ.</para>
  <para style="ip">ರುತ್ ಪುಸ್ತಕ್ ಲಿವಲ್ಯಾಲ ಕುನಿ ಮನ್ಹುನ್ ಕುನಾಲಾಸ್ ಠಾವನಾಹಿ ಆನಿ ಕವಾ ಮನ್ಹುನ್ಬಿ ಠಾವ ನಾಹಿ. ಹ್ಯ ಇಸ್ರಾಯೆಲಾನಾ ಶೊಡಲ್ಯಾ ನಂತರ್ ಲಿವ್ಲ ಆಸಲ್ ಮನ್ಹುನ್ ಥುಡಿಜ಼ನ ಮಂತ್ಯಾತ, ಕಾ ಮಂಜೆ ಹ್ಯಾತ್ಲಿ ಹಿಬ್ರು ಬಾಸೆಚೆ ಥೆರಿಚಾ ಕಾಲಾಚೆಗತ್ ಹಾ. ರುತ್, ಇಸ್ರಾಯೆಲಾಚಿ ನಸ್ಲಿತರಿ, ದಾವೀದ್ ರಾಜಾಚಿ ಪಂಜಿ ಜಾ಼ಲ್ತಿ ಮನ್ಯಾಚ಼ ಮತ್ವಾಚ಼ ಜಾ಼ಲ್ಯಾ. ದೆವ್ ಬಗತ್ಯಾಲಾ ತು ಕುಟಲ್ಯಾ ಕಟ್ಮಾಚಾ಼ ಮನ್ಹುನ್ ನವ್ಹ, ಮನ್ ಬಕ್ತೊ.</para>
  <para style="iot">ರುತ್ ಪುಸ್ತಕಾಚ಼ ಬಾಗ್ :</para>
  <para style="io1">ಅದ್ಯಾಯ್ <char style="ior"><ref loc="RUT 1">1</ref></char> ನವೊಮಿಚಾ಼ ಕುಟುಮ್ ಆನಿ ತ್ಯಂಚೆ ಮೊರ‍್ಹ ಆಲ್ಯಾಲ್ಯಾ ದುಖಾಚಾ ಖನ್ಕತಿ, ಮಂಗ್ ನೊವೊಮಿ ಆನಿ ರುತ್ ಇಶ್ರಾಯೆಲತ್ ಪರ್ತಾಚ಼.</para>
  <para style="io">ಅದ್ಯಾಯ್ <char style="ior"><ref loc="RUT 2">2</ref></char> ರುತ್ ಬೊವಜಾಚಾ ಸೆತಾತ್ ರಾಯಲ್ಯಾಲಿ ಲೊಂಬ ಯಚ಼ತಾನಾ ಬೊವಜಾಚಿ ಭೆಟ್ ವ್ಹತ್ಯಾಲಿ.</para>
  <para style="io">ಅದ್ಯಾಯ್ <char style="ior"><ref loc="RUT 3">3</ref></char> ನವೊಮಿ, ರುತಾಪ ಬೊವಜಾಲಾ ಲಗಿನ್ ವ್ಹಯಾ ಇಚಾರಾಯಾ ಪಾರಕ್ ದಿಯಾಚಿ, ಬೊವಜಾ ತ್ಯಂಚಾ ವಸಾತ್ಲಾ, ತ್ಯಂಚಿ ಕ್ಯಾಳಜಿ ಗಿಹ್ಯಾಚಿ.</para>
  <para style="io">ಅದ್ಯಾಯ್ <char style="ior"><ref loc="RUT 4">4</ref> </char>ಬೊವಜಾ ನವೊಮಿಚಾ ಮೆಲ್ಯಾಲ್ಯಾ ಗ್ವಾಚಿ ಆಸ್ತಿ ಖರೆದಿ ಕರುನ್, ರುತಾಲಾ ಲಗಿನ್ ವ್ಹತ್ಯಾಲ.</para>
  <chapter number="1" style="c" sid="RUT 1" />
  <para style="s">ಎಲಿಮೆಲೆಕಾಚಾ಼ ಕುಟುಮ್ ಮೊವಾಬ್ ದೆಸೆತ್ ಗೆಲ್ಯಾಲಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="RUT 1:1" />ನ್ಯಾಯಿ ಕರತ್ಯಾಲ್ಯಾಂಚಾ ಕಾಲಾತ್ ಇಸ್ರಾಯಲ್ ದೆಶೆತ್ ಬರ್ಗಾಲ್ ಆಲ್ತ, ತವಾ ಬೆತ್ಲೆಹೆಮಿತ್ಲಾ ಯೊಕ್ ಮಾನುಸ್ ಆಪ್ಲೆ ದನ್ಗರಿಲಾ ಆನಿ ದೊಗಾ ಲೆಕಾನಾ ಗಿಹುನ್ ಮೋವಾಬ್ ದೆಶೆತ್ ರಾಹ್ಯಾಲಾ ಗೆಲಾ . <verse eid="RUT 1:1" /><verse number="2" style="v" sid="RUT 1:2" />ತ್ಯಾ ಮಾನ್ಸಾಚ಼ ನಾವ್ ಎಲೀಮೆಲೆಕ್. ತ್ಯಚೆ ಬ್ಯಾಯ್ಕೊಚ಼ ನಾವ್ ನೊವೊಮಿ . ತ್ಯಚಾ ಯಕಾ ಲೆಕಾಚ಼ ನಾವ್ ಮಹ್ಲೋನ್, ಆನಿ ಯಕಾಚ಼ ನಾವ್ ಕಿಲ್ಯೊನ್. ಹಿ ಇಸ್ರಾಯೆಲ್ ವಂಶಾಚೆ ಎಪ್ರಾತ ಕುಳಾತ್ಲ, ಬೆತ್ಲೆಹೆಮಿತ್ಲಿ. ಮೊವಾಬ್ ದೆಸೆತ್ ರಾಲ್ತಿತ. <verse eid="RUT 1:2" /><verse number="3" style="v" sid="RUT 1:3" />ತವಾ ನೊವೊಮಿಚಾ಼ ಘೋ ಎಲೀಮೆಲೆಕ್ ಮೆಲಾ. ತಿ ಆಪಲ್ಯಾ ದೊಗ ಲೆಕಾನಾ ಗಿಹುನ್ ತಿಥಸ್ ರಾಹ್ಲಿ . <verse eid="RUT 1:3" /><verse number="4" style="v" sid="RUT 1:4" />ದೊಗ ಲ್ಯಾಕ್,ಮೋವಾಬ್ ದೆಶತಲ್ಯಾ ಪುರಿನಾ ಲಗಿನ್ ವ್ಹತ್ಯಾತ. ಯಕಿಚ಼ ನಾವ್ ಒರ‍್ಪಾ ಆನಿ ಯಕಿಚ಼ ರುತ್. ತಿ ಜ಼ವ ಜ಼ವಳ್ ಧಾ ವರ್ಸ ತಿಥ ರಾಯ್ಲಿತ. <verse eid="RUT 1:4" /><verse number="5" style="v" sid="RUT 1:5" />ತಿ ತಿಥ ಆಸ್ತಾನಾಸ್ ಮಹ್ಲೋನ ಆನಿ ಕಿಲ್ಯೊನ ದೊಗಬಿ ಮೆಲ . ತೀ ಬಾಯಿಲ್ ಮಾನುಸ್ ದೊಗಾ ಲೆಕಾ ಆನಿ ಘ್ವಾ ಮ್ಹಾಗ್ ವ್ಹವುನ್ ತಿಥಸ್ ರಾಹ್ಲಿ.<verse eid="RUT 1:5" /></para>
  <para style="s">ನವೊಮಿ ಆನಿ ರುತ್ ಬೆತ್ಲೆಹೆಮಿತ್ ಪರ್ತುನು ಆಲ್ಯಾಲ್ಯಾ</para>
  <para style="p">
    <verse number="6" style="v" sid="RUT 1:6" />ಪರಮೆಸ್ವರ್ ಸ್ವಾಮಿಚಾ ಆಸಿರ್ವದಾನಿ ಆಪ್ಲೆ ದೆಸೆತ್ ಚಾ಼ಂಗ್ಲಾ ಪಾವುಸ್ ಪಾನ್ಯಾನಿ ಪೀಕಲ್ಯಾ ಮನ್ಹುನ್ ಮೊವಾಬೆತ್ಲೆ ನವೊಮಿಲಾ ಸಮಾಜ಼್ಲ ಆನಿ ಸುನಂಚೆ ಸಂಗ ಮಾಗಾರಿ ಜಾ಼ಯಾ ನಿಗಾಲಿ <verse eid="RUT 1:6" /><verse number="7" style="v" sid="RUT 1:7" />ತೀ ದುಗಿ ಸುನಾಂಚಿಸಂಗ ಆಪ್ನು ಆಸಲ್ಯಾಲ್ಯಾ ಜಾ಼ಗ್ಯಾವ್ನಿ ಯುದಾಯಾತ್ ಜಾ಼ತ್ಯಾಲೆ ವಾಟನಿ ಜಾ಼ತಾನಾ, <verse eid="RUT 1:7" /><verse number="8" style="v" sid="RUT 1:8" />ತಿನಿ ಆಪ್ಲೆ ಸುನನಾ," ತುಮಿ ತುಮ್ಚಾ-ತುಮ್ಚಾ ಮಾಹ್ಯಾರ್ಚಾ ಗರ‍್ಹಾತ್ನಿ ಜಾ಼ವಾ. ತುಮಿ , ಮಾಜಿ ಆನಿ ಮೆಲ್ಯಾಲ್ಯಾ ಮಾಜಾ ಲೆಕಾಂಚಿ ಮಾಯಾ ಕಸಿ ಕಿಲಿಸಾ ತಸಿಸ್ ದೆವ್ ತುಮ್ಚಿ ಮಾಯಾ ಕರುನಿ ಆನಿ ತುಮ್ಚಿವ ದಯಾ ಥಿವುನಿ. <verse eid="RUT 1:8" /><verse number="9" style="v" sid="RUT 1:9" />ತುಮಿ ದುಗಿಬಿ ಲಗಿನ್ ವ್ಹವುನ್ ತುಮ್ಚಾ ದನ್ಗಾರಾಂಚಾ ಗರ‍್ಹಾತ್ನಿ ಸುಕಾನಿ ರಾಹಿಸಾರ ದೆವ್ ಕರುನಿ," ಮನ್ಹುನ್ ಸಾಂಗುನ್. ಮುಕ ಗೆತ್ಲ ಆನಿ ತ್ಯಾ ಮೊಟ್ಯಾ ದುಖಾನಿ ರಡಯಾ ಲಾಗಲ್ಯಾ, <verse eid="RUT 1:9" /><verse number="10" style="v" sid="RUT 1:10" />ಆನಿ ತ್ಯಾ ತಿಲಾ ಆಮಿ ತುಜಿ ಸಂಗ ತುಜಾ ಲೊಕಾಂಚಿಪ ಯತಾವ್ ಮನಲ್ಯಾ. <verse eid="RUT 1:10" /><verse number="11" style="v" sid="RUT 1:11" />ತವಾ ನವೊಮಿ, "ಲಿಕಿನು, ತುಮಿ ಮಾಗಾರ‍್ಯಾ ಜಾ಼ವಾ. ಮಾಜಿ ಸಂಗ ಕಶಾಲಾ ಯತಾಸಾ? ತುಮಾನಾ ದನ್ಗಾರ್ ದಿಯಾ ಮಾಜಾ ಪೊಟಾಸ್ ದಿಸ್ರ ಲ್ಯಾಕ್ ಹಾತಕ್ಯಾ? <verse eid="RUT 1:11" /><verse number="12" style="v" sid="RUT 1:12" />ಲಿಕಿನು ತುಮಿ ಮಾಗಾರ‍್ಯಾ ಜಾ಼ವಾ. ಆನಿ ಲಗಿನ್ ವ್ಹಯಾಲಾ ಮಾಜಿ ವಯಾ ವ್ಹವುನ್ಗೆಲೆ. ಏಕ ವೆಳಿ ತಸ್ಲೆ ಆಸೆನಿ ಮಿ ಆತಾಸ್ ಆನಿಕ್ ಲಗಿನ್ ವ್ಹವುನ್ ಮನಾ ಪೊರ ಜಾ಼ಲಿತ ತರಿ, <verse eid="RUT 1:12" /><verse number="13" style="v" sid="RUT 1:13" />ತಿ ಮುಟಿ ವ್ಹಯಿಸ್ಪರ‍್ಯಾತ್ ತುಮಿ ರಾಖಿತ್ರಾನಾರ್ ಕ್ಯಾ? ತಬರ್ ತುಮಿ ಲಗಿನ್ ವ್ಹಯಾಚೆ ಆಂದಿ ರಾನ್ಹಾರಕ್ಯಾ? ನಕೊ, ಮಾಜಾ ಲಿಕಿನು, ಪರ್ಮೆಶ್ವರಾಚಾ಼ ಹಾತ್ ಮನಾ ದುರ್ ಜಾ಼ಲ್ಯಾ, ತುಮ್ಚಿಸಾಟಿ ಮನಾ ತುಮ್ಚೆ ಪರಾಸ್ ದುಕ್ ಜಾ಼ಲ್ಯಾ,” ಮನ್ಲಿ. <verse eid="RUT 1:13" /><verse number="14" style="v" sid="RUT 1:14" />ತವಾ ತ್ಯಾ ಮೊಟ್ಯಾನಿ ರಡಲ್ಯಾ. ಮಂಗ್ ಒರ‍್ಪಾ ಸಾಸೊಚಾ಼ ಮುಕಾ ಗಿಹುನ್ ನಿಗುನ್ ಆಪಲ್ಯಾ ಮಾಹ್ಯಾರಾಸ್ ಗಿಲಿ. ಫನ್ ರುತ್ ಸಾಸೊಲಾ ಸೂಡುನ್ ಗಿಲಿ ನಾಹಿ. <verse eid="RUT 1:14" /><verse number="15" style="v" sid="RUT 1:15" />ತವಾ ನೊವೊಮಿ ಮಂಥಿ, “ರುತಾಲಾ, ತುಜಿ ಜಾ಼ವ್ ಪರ್ತುನ್ ಆಪಲ್ಯಾ ಲೊಕಾಂಚಿಪ, ಆನಿ ಆಪಲ್ಯಾ ದೆವಾಂಚಿಪ ಗಿಲಿ . ತೂಬಿ ತಿಚಿಗತ್ ತುಜಾ ಲೊಕಾಂಚಿಪ ಜಾ಼," ಮನ್ಲಿ . <verse eid="RUT 1:15" /><verse number="16" style="v" sid="RUT 1:16" />ತವಾ ರುತ್" ತುಲಾ ಸುಡುನ್ ಮಾಗಾರಿ ಜಾ಼ ಮನ್ಹುನ್ ಮನಾ ಬಳಜು಼ರಿ ಕರು ನಕೊಸ್ . ತು ಕುಠ ಜಾ಼ಸಿಲ್ ತಿಥ ಮಿ ಯನಾರ್. ತು ಕುಠ ರಾಸಿಲ್ ತಿಥ ಮಿ ರಾಥೆ ತುಜಿ ಲೊಕಸ್ ಮಾಜಿ ಲೊಕ, ತುಜಾ಼ ದೆವುಸ್ ಮಾಜಾ಼ ದೆವ್, <verse eid="RUT 1:16" /><verse number="17" style="v" sid="RUT 1:17" />ತು ಕುಠ ಮರ್ಸಿಲ್ ತಿಥಸ್ ಮಿ ಮರ್ನಾರ್ ತಿಥಸ್ ಮನಾ ಮಾತಿ ದಿಯಾ ವ್ಹಯಿ. ಮರ್ನಾ ಸಿವಾರ್ ಮಿ ತುಲಾ ಸುಡುನ್ ಗೆಲೆತ ದೆವಾನಿ ಮನಾ ಖುಬ್ ಶಿಕ್ಷೆ ದೆವಾವ," ಮನ್ಲಿ . <verse eid="RUT 1:17" /><verse number="18" style="v" sid="RUT 1:18" />ತಿನಿ ಆಪ್ಲೆ ಸಂಗಸ್ ಯಯಾ ಯವಜ಼ಲ್ಯಾ ಮನ್ಹುನ್ ನೊವೊಮಿನಿ ಸಮಜು಼ನ್ ಗಪ್ ಜಾ಼ಲಿ. <verse eid="RUT 1:18" /><verse number="19" style="v" sid="RUT 1:19" />ತಶಾಸ್ ತ್ಯಾ ದುಗಿ ಚಾ಼ಲತ್ ಬೆತ್ಲೆಹೆಮಿತ್ ಪೊಚ಼ಲ್ಯಾ. ತ್ಯಾ ಆಲ್ಯಾಲ್ಯಾ ಖನ್ಕತ್ ಐಕುನ್ ಲೊಕ ಆಜಾಬ್ ಜಾ಼ಲ್ಹಿತ. ಗಾವಾತ್ಲಿ ಬ್ಯಾಯ್ಕಾ ಮಾನ್ಸ, "ಹಿ ನೊವೊಮಿ ನವ್ಹ ಕ್ಯಾ?" ಮನ್ಲಿತ. <verse eid="RUT 1:19" /><verse number="20" style="v" sid="RUT 1:20" />ತವಾ ತೀ ತ್ಯನಾ “ಮನಾ' ನೊವೊಮಿ ಮನ್ಹುನ್ ಹಾಕ್ಟು ನಕೊಸಾ; ಮನಾ ಮಾರಾ<note caller="+" style="f"><char style="fr" closed="false">1:20 </char><char style="ft" closed="false">ಮಾರಾ ಮಂಜೆ ಕಡು ಮನ್ಹುನ್ ಆರ್ತ</char></note> ಮನ್ಹುನ್ ಹಾಕ್ಟಾ. ಕಾ ಮಂಜೆ ಸರ್ವಶಕ್ತಾನಿ ಮಾಜಾ಼ ಜಿವ್ನಾ ಖುಬ್ ತರಾಸಾತ್ ಗ್ಯಾತಲ್ಯಾ. <verse eid="RUT 1:20" /><verse number="21" style="v" sid="RUT 1:21" />ಮಿ ಸರವ್ಯಾನಿ ಬರುನ್ ಗೆಲ್ಯಾಲಿ ಮೊಕಳ್ಯಾ ಹಾತಾನಿ ಮಾಗಾರಿ ಯಯಿಸಾರಿ ಕೆಲ್ಯಾ. ದೆವ್ ಮನಾ ಇರೊದ್ ಜಾ಼ಲ್ಯಾ, ಸರ್ವಶಕ್ತಾನಿ ಮನಾ ಹಾರಿವಲ್ಯಾ ಆಸ ಆಸ್ತಾನಾ ತುಮಿ ಮನಾ ನೊವೊಮಿ ಮನ್ಹುನ್ ಹಾಕ್ಟಾಚ಼ ಬರ ಕ್ಯಾ? ಮನ್ಲಿ . <verse eid="RUT 1:21" /><verse number="22" style="v" sid="RUT 1:22" />ಆಸಿ ನವೊಮಿ ಮೋವಾಬ್ಯಾತ್ಲಿ ರುತ್ ಮಂತ್ಯಾಲೆ ಆಪ್ಲೆ ಸುನಸಂಗ ಬೆತ್ಲೆಹೆಮತ್ ಆಲಿ. ತವಾ ಬಾರ್ಲಿಚಿ ಲ್ಯಾನ್ ಬೆತ್ಲೆಹೇಮತ್ ಚಾ಼ಲ್ಲಿಹುತ್ತಿ.<verse eid="RUT 1:22" /></para>
  <chapter eid="RUT 1" />
  <chapter number="2" style="c" sid="RUT 2" />
  <para style="s">ರುತಾನಿ ಬೊವಜಾಚಾ ಸೆತಾತ್ ಕಾಮ್ಕೆಲ್ಯಾಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="RUT 2:1" />ನವೊಮಿಚಾ಼ ದನ್ಗೊರ್ ಎಲಿಮೆಲೆಕಾಚಾ ವಂಶಾತ್ಲಾ ಬೊವಜ ಮಂಥ್ಯಾಲಾ ಪಾವ್ನಾ ಹುತ್ತಾ. ತ್ಯೊ ಸಾವ್ಕೊರ್ ಮಾನುಸ್ ತ್ಯಚ಼ ನಾವ್ ಬೊವಜ್. <verse eid="RUT 2:1" /><verse number="2" style="v" sid="RUT 2:2" />ಎಕಸಿ ಮೊವಾಬ್ಯಾತ್ಲಿ ರುತ್ ನವೊಮಿಲಾ," ಮನಾ ಕುನಿತರಿ ಆವಕಾಸ್ ದಿಲ್ಯಾವ ಮಿ ಶೆತಾತ್ನಿ ಜಾ಼ವುನ್ ಲೊಂಬ ಎಚು಼ನ್ ಆಂತೆ ಮನ್ಲಿ. ತವಾ ನೊವೊಮಿ, "ಜಾ಼ ಮಾಜೆ ಲಿಕಿ,” ಮನ್ಲಿ. <verse eid="RUT 2:2" /><verse number="3" style="v" sid="RUT 2:3" />ರುತ್ ಕ್ಯಾಪತ್ಯಾಲ್ಯಾಂಚೆ ಮಾಗ್ನಿ ಜಾ಼ವುನ್ ಜಿಥ-ಜಿಥ ಪಡಲ್ಯಾಲಿ ಲೊಂಬ ಎಚಿತಿ. ತ್ಯ ಶಾತ್ ಎಲಿಮೆಲೆಕಾಚಾ ವಂಶಾತ್ಲಾ ಜಾ಼ಲ್ಯಾಲ್ಯಾ ಬೊವಜಾಚ಼ ಜಾ಼ಲ್ತ. <verse eid="RUT 2:3" /><verse number="4" style="v" sid="RUT 2:4" />ತವಾ, ಬೊವಜ ಬೆತ್ಲೆಹೆಮಿತ್ನಿ ತಿಥ ಆಲಾ. ತ್ಯನಿ, “ ಕಾಮ್ಯಾರಾನಾ ಪರಮೆಸ್ವರ್ ತುಮ್ಚಿ ಸಂಗ ರಾಹುನಿ!” ಮನ್ಲಾ, ತವಾ ತಿಬಿ “ಪರಮೆಸ್ವರ್ ತುಮಾನಾಬಿ ಆಶಿರ್ವಾದ್ ಕರುನಿ!" ಮನ್ಲಿತ. <verse eid="RUT 2:4" /><verse number="5" style="v" sid="RUT 2:5" />ಬೊವಜಾನಿ ಮುಕಾದಾಮಾಲಾ ಹಾಕ್ಟುನ್, “ಹಿ ಬಾಯಿಲ್ ಮಾನುಸ್ ಕುನಾಚಾ ಗರ‍್ಹಾತ್ಲಿ?” ಮನ್ಹುನ್ ಇಚಾರ್ಲ. <verse eid="RUT 2:5" /><verse number="6" style="v" sid="RUT 2:6" />ತವಾ ತ್ಯಾ ಮುಕಾದಮಾನಿ, “ಹಿ ಮೋವಾಬಿ, ನವೊಮಿ ಸಂಗ ಮೋವಾಬ್ ದೆಶೆತ್ನಿ ಮಾಗಾರಿ ಆಲ್ಯಾಲಿ. <verse eid="RUT 2:6" /><verse number="7" style="v" sid="RUT 2:7" />ಹಿನಿ ಕ್ಯಾಪತ್ಯಾಲ್ಯಾಂಚೆ ಮಾಗ್ನಿ ಜಾ಼ವುನ್ ಲೊಂಬ ಎಚಾ಼ಯಾ ಹುಕ್ಕುಮ್ ಇಚಾರ್ಲಾ. ಸಖಾಳ್ಚಿ ನಸ್ಕಾತ್ ಆಲ್ಯಾಲಿ ಆಜು಼ನ್‍ ಹಿತ್ತಸ್ ಹಾ.ಜ಼ರಾಬಿ ಇಸ್ರಾಮಾಗೆತ್ಲಾ ನಾಹಿ ಆತಾಸ್ ಜ಼ರಾ ಸಾವ್ಲಿಸ್ ಬಸ್ಲೆ” ಮನ್ಲಾ. <verse eid="RUT 2:7" /><verse number="8" style="v" sid="RUT 2:8" />ಮಂಗ್ ಬೊವಜ ರುತಾಲಾ, “ಬಗ್ ಬಾಯಿ ಮಾಜ಼ ಶಾತ್ ಸೂಡುನ್ ಆನಿ ಕುಂಡ ಲೊಂಬ ಎಚಾ಼ಯಾ ಜಾ಼ವುನಕೊ. ಮಾಜಾ ಕಾಮ್ಯಾರ‍್ಯಾ ಬ್ಯಾಯಕಾಮಾನ್ಸಾಂಚೆ ಸಂಗ ರ‍್ಹಾ. <verse eid="RUT 2:8" /><verse number="9" style="v" sid="RUT 2:9" />ತಿ ಕುಠ ಪೀಕ್ ಕ್ಯಾಪತ್ಯಾತ ತ್ಯಂಚೆ ಮಾಗ್ನಿ ಜಾ಼ವುನ್ ಲೊಂಬ ಏಚ಼್. ತುಲಾ ಕುನಿ ತರಾಸ್ ದಿಯಾಚಾ಼ ನಾಹಿ ಮನ್ಹುನ್ ಮಿ ಮಾಜಾ ಗಡ್ಯಾನಾ ಸಾಂಗಲ್ಯಾ. ತುಲಾ ತಾನ್ ಲಾಗ್ಲಿತ ಜಾ಼ವುನ್ ಮಾಜಾ ಆಳಾಂಚಾನಿ ಬರ‍್ಹುನ್ ಥೆವಲ್ಯಾಲ್ಯಾ ಬಿನಗ್ಯಾತ್ಲ ಪಿ,” ಮನ್ಲಾ. <verse eid="RUT 2:9" /><verse number="10" style="v" sid="RUT 2:10" />ತವಾ ತಿನಿ ತ್ಯಲಾ ಖಾಲ್ ವಾಕುನ್ ನಮಸ್ಕಾರ್ ಕರುನ್. “ಮಾಲ್ಕಾನು, ಪರದೆಶಿ ಆಸಲ್ಯಾಲಿ ಮಾಜಿವ ಯವ್ಡಿ ದಯಾ ಕಾ?" ಮನ್ಲಿ. <verse eid="RUT 2:10" /><verse number="11" style="v" sid="RUT 2:11" />ತವಾ ಬೊವಜಾನಿ, “ತುಜಾ಼ ಘೊ ಮರುನ್ಗೆಲ್ಯಾಸ್ಟಾವ್ನಿ ತು ಸಾಸೊಸಾಟಿ ಕೆಲ್ಯಾಲ ಸಗ್ಳ ಐಕಲ್ಯಾ. ತು ಕಸಿ ತುಜಿ ಆಯಿ ಬಾ ಆನಿ ಸ್ವತಾಚಿ ದೆಶಾ ಸೂಡುನ್, ವಳಕ್ ನಸಲ್ಯಾಲ್ಯಾ ಲೊಕಾಂಚೆ ಸಂಗ ರಾಹ್ಯಾ ಆಲೆಸ್ ಮನ್ಹುನ್ ಮನಾ ಠಾವ ಹಾ. <verse eid="RUT 2:11" /><verse number="12" style="v" sid="RUT 2:12" />ತು ಕೆಲ್ಯಾಲ್ಯಾ ಕಾಮಾಲಾ ದೆವ್ ತುಲಾ ಶಾರ್ಕ ಫಲ ದಿವುನಿ. ಇಸ್ರಾಯೆಲಾಂಚಾ ದೆವ್ ಜಾ಼ಲ್ಯಾಲಾ ಪರಮೆಸ್ವರಾಚಾ಼ ಆಸ್ರಾ ಗಿಹ್ಯಾ ಆಲೆಸ್. ತ್ಯೊ ತುಲಾ ಖುಬ್ ಗಾಹುನಿ!“ ಮನ್ಲಾ. <verse eid="RUT 2:12" /><verse number="13" style="v" sid="RUT 2:13" />ತವಾ ತಿ, ಮಾಲ್ಕಾನು ತುಮಿ ಮನಾ ಮೊಟಾ ಉಪ್ಕಾರ್ ಕೆಲ್ಯಾಸಾ . ಮಿ ತುಮ್ಚಿ ಚಾ಼ಕ್ರಿನ್ ಮನ್ಹನ್ ಗಿಹ್ಯಾಲಾಬಿ ಲಾಯಿಕ್ನಾಹಿ. ತರಿಬಿ ತು ಮನಾ ದಯಾ ಮಾಯಾನಿ ಬುಲಿವ್ಲಿಸ್.” ಮನ್ಲಿ. <verse eid="RUT 2:13" /><verse number="14" style="v" sid="RUT 2:14" />ಜೆವ್ನಾಚಾ ಯಳಾಲಾ ಬೊವಜಾನಿ ರುತಾಲಾ ಹಾಕಟ್ಲಿ. “ ಹಿಕ್ಡ ಯೆ, ಬಾಕ್ರಿ ಗಿಹುನ್ ಆಂಬಾಟ್ ದರಾಕ್ಶಿಚಾ ರಸಾತ್‍ ಬುಡವುನ್ ಖಾ,” ಮನ್ಲಾ. ತಿ ಕಾಮ್ಯಾರ‍್ಯಾಂಚೆ ಸಂಗ ಬಸ್ಲಿ. ಆನಿ ತ್ಯಚಿ ಸಂಗ ಬೊವಜಾನಿ ತಿಲಾ ಬ್ಯಾಜ಼ಲ್ಯಾಲಿ ಕನ್ಸ ದಿಲಿತ. ತಿನಿ ಪ್ವಾಟ್ಬ ಖಾವುನ್ ಥುಡಿ ಉರಿವ್ಲಿತ. <verse eid="RUT 2:14" /><verse number="15" style="v" sid="RUT 2:15" />ತಿ ಆನಿ ಲೊಂಬ ಎಚಾಯಾ ಗಿಲಿ ತವಾ, ಬೊವಜಾನಿ ಆಪಲ್ಯಾ ಆಳಾನಾ, ಬಾರ‍್ಯಾಂಚೆ ಮದ್ದಿಬಿ ತಿ ಲೊಂಬ ಎಚು಼ನಿ; ಥಾಂಬ್ವು ನಕೊಸಾ. <verse eid="RUT 2:15" /><verse number="16" style="v" sid="RUT 2:16" />ತುಮಿ ಬ್ಯಾಂತಾನಾ ಥುಡಿ ಲೊಂಬ ಆಡ್ವಾತ್ನಿ ಕಾಡುನ್ ಬುಡಿ ಟಾಕಾ. ತಿ ಎಚು಼ನಿ; ಕೊನ್ ತಿಲಾ ದಪಕ್ಯಾವುನಕೊಸಾ,” ಮನ್ಲಾ. <verse eid="RUT 2:16" /><verse number="17" style="v" sid="RUT 2:17" />ತಸಸ್ ರುತಾನಿ ಶಾನ್ಪರ‍್ಯಾತ್ ಲೊಂಬ ಎಚು಼ನ್. ತಿ ಬಡಿವ್ಲಿತ ತಿ ಕಮಿಸ್ಕಮಿ ಚಾರ್ ಪ್ಯಾಯ್ಲಿ ಬಾರ್ಲಿ ಗಾವ್ಲಿ. <verse eid="RUT 2:17" /><verse number="18" style="v" sid="RUT 2:18" />ತಿ ಗಿಹುನ್ ಗಾವಾತ್ ಜಾ಼ವುನ್ ಆಪ್ಲೆ ಸಾಸೊಲಾ ದ್ಯಾವ್ಲಿ. ತಸಸ್ ಆಪಲ್ಯಾಲಾ ಖಾಯಾ ದಿಲ್ಯಾಲ್ಯಾತ್ಲ ಉರಿವಲ್ಯಾಲ ಸಾಸೊಲಾ ದಿಲ. <verse eid="RUT 2:18" /><verse number="19" style="v" sid="RUT 2:19" />ತ್ಯ ಬಗುನ್ ನವೊಮಿ, “ ತು ಆಜ಼್ ಕುಠ ಲೊಂಬ ಎಚ್ಲಿತಸ್? ಕುನಾಚಾ ಶೆತಾತ್ ಕಾಮ್ ಕೇಲಸ್? ತುಜಿವ ದಯಾ ದ್ಯಾವಲ್ಯಾಲಾ ಚಾ಼ಂಗ್ಲವ್ಹವುನಿ!” ಮನ್ಲಿ. ತ್ಯಲಾ ರುತಾನಿ, ಮಿ ಲೊಂಬ ಎಚಲ್ಯಾಲ ಶಾತ್ ಬೊವಜಾಚ಼,” ಮನ್ಲಿ. <verse eid="RUT 2:19" /><verse number="20" style="v" sid="RUT 2:20" />ಹ್ಯ ಐಕುನ್ ನವೊಮಿ ಗಡ್ಬಡಿನಿ , “ಜಿತ್ತಿ ಆಸಲ್ಯಾಲ್ಯಾನಾ ಮೆಲ್ಯಾಲ್ಯಾನಾ ಕೆಲ್ಯಾಲ ವಾಗ್ದಾನ್ ಗಢಿವ್ನಾರಾ ಪರಮೆಸ್ವರ್ ತ್ಯಲಾ ಆಶಿರ್ವಾದ ಕರುನಿ!” ಮನ್ಲಿ, ತ್ಯೊ ಮಾನುಸ್ ಆಮ್ಚೆ ಜ಼ವಳಚಾ಼ಸ್ ವಾರ್ಸಿ, ಆಮಾನಾ ಪ್ಯೊಸ್ನಾರಾ,” ಮನ್ಲಿ. <verse eid="RUT 2:20" /><verse number="21" style="v" sid="RUT 2:21" />ತವಾ ಮೊವಾಬ ದೆಶೆತ್ಲಿ ರುತ್, “ಲ್ಯಾನ್ ಸಪಪರ‍್ಯಾತ್ ಮಾಜಾ ಆಳಾಂಚೆ ಸಂಗ ರ‍್ಹಾ ಮನ್ಹುನ್ ಸಾಂಗ್ಲ, ಮನ್ಲಿ. <verse eid="RUT 2:21" /><verse number="22" style="v" sid="RUT 2:22" />ತವಾ ನವೊಮಿ ಆಪ್ಲೆ ಸುನಾಲಾ, “ವ್ಹಯ್ ಕ್ಯಾ, ಲಿಕಿ, ತು ತ್ಯಂಚಾ ಕಾಮ್ಯಾರ‍್ಯಾ ಬ್ಯಾಯ್ಕಾಂಚಿಸಂಗ ರಾಹ್ಯಾಚ಼ಸ್ ಬರ; ದುಸರ‍್ಯಾಂಚಾ. ಶೆತಾತ್ ತುಲಾ ಬೆಜಾರ್ ಕರ್ತಿಲ,” ಮನ್ಲಿ. <verse eid="RUT 2:22" /><verse number="23" style="v" sid="RUT 2:23" />ತಸಸ್ ರುತ್ ಸಾಸೊಸಂಗ ರಾಹುನ್ ಬಾರ್ಲಿಚಿ ಗವ್ಹಾಚಿ ಲ್ಯಾನ್ ಸಪಪರ‍್ಯಾತ್ ಬೊವಜಾಚಾ ಕಾಮ್ಯಾರ‍್ಯಾ ಬ್ಯಾಯ್ಕಾಂಚಿಸಂಗ ಜಾ಼ವುನ್ ಲೊಂಬ ಯಚಿತಿ.<verse eid="RUT 2:23" /></para>
  <chapter eid="RUT 2" />
  <chapter number="3" style="c" sid="RUT 3" />
  <para style="s">ರುತಾಲಾ ಘೊ ಗಾವಲ್ಯಾಲಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="RUT 3:1" />ಯಕಸಿ ನವೊಮಿ ರುತಾಲಾ, “ಲಿಕಿ, ತು ಆನಿಕ್ ಗರ್ತಿನ್ ವ್ಹವುನ್ ಸುಕಾನಿ ರಾಹಿಸಾರಿ ತಯಾರಿ ಕರಾಚ಼ ಮಾಜ಼ ಕಾಮ್ ನವ್ಹ ಕ್ಯಾ? <verse eid="RUT 3:1" /><verse number="2" style="v" sid="RUT 3:2" />ತ್ಯೊ ಬೊವಜಾ ಆಮ್ಚಾ ವಸಾಚಾ಼. ತ್ಯಚಾ ಕಾಮ್ಯಾರ‍್ಯಾ ಬ್ಯಾಯ್ಕಾಂಚಿಸಂಗ ತು ಲೊಂಬ ಯಚಿತಿಸ್ನವ್ಹ? ಆತಾ ಮಿ ಸಾಂಗತ್ಯಾಲ ಐಕ್; ಆಜ಼್ ರ‍್ಯಾಚಾ಼ ಬೊವಜಾ ಖಳ್ಯಾತ್ ಬಾರಲ್ಯಾ ವಾರ‍್ಯಾ ಕರ‍್ನಾರ್. <verse eid="RUT 3:2" /><verse number="3" style="v" sid="RUT 3:3" />ತು ಆಂಗುಳ್ಕರುನ್ ವಾಸಾಚ಼ ತ್ಯಾಲ್ ಲಾವುನ್, ಚಾ಼ಂಗ್ಲ ಕಪ್ಡ ಗಾಲ್ಹುನ್. ಖಳ್ಯಾತ್ ಜಾ಼. ತ್ಯೊ ಖಾವುನ್ಪಿವುನ್ ವ್ಹಯಿಪರ‍್ಯಾತ್ ತ್ಯಲಾ ದಿಸುನಕೊ. <verse eid="RUT 3:3" /><verse number="4" style="v" sid="RUT 3:4" />ತ್ಯೊ ಕುಠ ನಿಸ್ತೊ ಮನ್ಹುನ್ ಬಗ್. ತ್ಯೊ ನಿಜ಼ಲಾಕಿ ತಿಥ ಜಾ. ತ್ಯಚಾ ಪಾಯಾಕ್ಲ ಕಾಂಬ್ರುನ್ ಹಾಳುಸ್ಕಾಡುನ್ ಪ್ಯಾಯ್ಶಾಕ್ಡ ನಿಜ಼್. ಮಂಗ್ ತು ಕ್ಯಾ ಕರಾಯಾ ವ್ಹಯಿಸ್ಮನ್ಹುನ್ ತ್ಯೊಸ್ ಸಾಂಗಿಲ್,” ಮನ್ಲಿ.<verse eid="RUT 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="RUT 3:5" />ತವಾ ರುತ್ ಸಾಸೊಲಾ: “ತು ಸಾಂಗಲ್ಯಾಸಾರಸ್ ಮಿ ಕರ್ತೆ,” ಮನ್ಲಿ. <verse eid="RUT 3:5" /><verse number="6" style="v" sid="RUT 3:6" />ತಸಸ್ ರುತಾನಿ ಖಳ್ಯಾತ್ ಜಾ಼ವುನ್ ಸಾಸೊನಿ ಸಾಂಗಲ್ಯಾಸಾರ ಕೆಲ. <verse eid="RUT 3:6" /><verse number="7" style="v" sid="RUT 3:7" />ಬೊವಜಾ ಖಾವುನ್ಪಿವುನ್ ಬಾರ್ಲಿಚೆ ರಾಸಿಪ ಜಾ಼ವುನ್ ನಿಜ಼ಲಾ. ರುತ್ ಗಪ್ ಗಿಲಿ. ತ್ಯಚಾ ಪ್ಯಾಯ್ಶಾಕ್ಡ ಆಸಲ್ಯಾಲ ಕಾಂಬ್ರುನ್ ಸಾವ್ಕಾಸ್ ಕಾಡುನ್, ತಿಥಸ್ ನಿಜ಼ಲಿ. <verse eid="RUT 3:7" /><verse number="8" style="v" sid="RUT 3:8" />ಆರ್ದೆ ರ‍್ಯಾಚಾ಼ ತ್ಯೊ ಜಾ಼ಗಾ ಜಾ಼ಲ್ಹಾ. ವಾಕುನ್ ಬಗ್ಲ ತವಾ ಯಾಕ್ ಬ್ಯಾಯ್ಕಾ ಮನುಸ್ ಪ್ಯಾಯ್ಶಾಕ್ಡ ನಿಜ಼ಲ್ಯಾಲ ಬಗುನ್ ಆಜಾಬ್ ಜಾ಼ಲ್ಹಾ, <verse eid="RUT 3:8" /><verse number="9" style="v" sid="RUT 3:9" />ಆನಿ “ತು ಕೊನ್?” ಮನ್ಹುನ್ ಇಚಾರ್ಲ. ತವಾ ತಿ, "ಮಾಲ್ಕಾನು" ಮಿ ತುಮ್ಚಿ ಚಾ಼ಕ್ರಿನ್ ರುತ್. ತುಮಿ ಆಮ್ಚಾ ಜ಼ವಳಚಾ ವಸಾಚಾ಼ ಮನ್ಹುನ್ ದಯಾಥಿವುನ್ ತುಮ್ಚಾ ಕಾಂಬ್ರುನಾಚಾ಼ ಕೊನಾ ಮಾಜಿವ ಗಾಲ್ಹಾ,” ಮನ್ಲಿ.<verse eid="RUT 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="RUT 3:10" />ಬೊವಜಾ: ಲಿಕಿ ಪರಮೆಸ್ವರ್ ತುಲಾ ಆಶಿರ್ವಾದ್ ಕರುನಿ! ತು ಗರಿಬ್, ಸಾವ್ಕೊರ್, ತರ‍್ನಾ ಪ್ಯೊರ‍್ಗಾ ನಿವಡ್ಲಾ ನಾಹಿಸ್. ತು ಮನಾ ದ್ಯಾವಲ್ಯಾಲಿ ಮರ‍್ಯಾದ್ ಹಿತ್ನಿ ಮಾಗ ತು ದ್ಯಾವಲ್ಯಾಲೆ ಮರೆದಿವ್ನಿ ಮೂಟಿ ಜಾ಼ಲ್ಹೆ. <verse eid="RUT 3:10" /><verse number="11" style="v" sid="RUT 3:11" />ಲಿಕಿ, ಬಿಹು ನಕೊಸ್, ತು ಚಾ಼ಂಗಲ್ಯಾ ಗುನಾಚಿ ಮನ್ಹುನ್ ಗಾವಾಲಾ ಸಗಳ್ಯಾ ಠಾವಿ ಹಾ; ತು ಮಾಗಲ್ಯಾಲ ದೆತೊ. <verse eid="RUT 3:11" /><verse number="12" style="v" sid="RUT 3:12" />ಮಿ ತುಮಾನಾ ಜ಼ವಳಚಾ಼ ವಾರ‍್ಸಿ ಖರ ಹಾ. ಫನ್ ಮಾಜಿವ್ನಿ ಜ಼ವಳಚಾ಼ ವಾರ‍್ಸಿ ಯೊಕ್ ಹಾ. <verse eid="RUT 3:12" /><verse number="13" style="v" sid="RUT 3:13" />ಆಜ಼್ ರ‍್ಯಾಚಿ ಹಿತಸ್ ರ‍್ಹಾ. ತ್ಯೊ ತುಲಾ ಬಾಳಗಿಲ್ ಕ್ಯಾ ನಾಹಿ ತ್ಯ ಸಕಾಳ್ ಇಚಾರುಯಾ. ತ್ಯೊ ಹು ಮನ್ಲಾತ ಬರಜಾ಼ಲ್ಹ. ನಾಹಿ ಮಂಜೆ ಮಿಸ್ ತಿ ಜವಾಬ್ದಾರಿ ಗೆಥೊ ಮನ್ಹುನ್ ಜಿವಸ್ವರುಪಾಚಾ ದೆವಾಚಾ ನಾವಾನಿ ಸಬ್ದ ದೆತೊ. ಆತಾ ಚಿಂತಾ ನಸ್ತಾನಾ ನಿಜ಼್,” ಮನ್ಲಾ.<verse eid="RUT 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="RUT 3:14" />ತಸಿಸ್ ತಿ ತ್ಯಚಾ ಪ್ಯಾಯ್ಶಾಕ್ಡ ನಿಜ಼ಲಿ. ಎಕ್ ಬ್ಯಾಯ್ಕಾ ಮಾನುಸ್ ಆಲ್ಯಾಲಿ ಕುನಾಲಾ ಸಮಜಾ಼ಯಾ ನಕೊ ಮನ್ಹುನ್ ನಸ್ಕಾತುಸ್ ಉಟ್ ಮನ್ಹುನ್ ಬೊವಜಾನಿ ಸಾಂಗ್ಲ. <verse eid="RUT 3:14" /><verse number="15" style="v" sid="RUT 3:15" />ಬೊವಜಾನಿ ತಿಲಾ,“ತುಜಾ಼ ಪದೊರ್ ಹಾತರ್,” ಮನ್ಹುನ್ ಸಾಂಗುನ್ ತ್ಯಾತ್ ಕಮಿಸ್ಕಮಿ ಸಾ ಪಡ್ಯಾ ಬಾರಲ್ಯಾ ವತುನ್ ವಾವಲ್ಯಾ. ತಿ ತ್ಯ ಗಿಹುನ್ ಗಾವಾತ್ ಗಿಲಿ. <verse eid="RUT 3:15" /><verse number="16" style="v" sid="RUT 3:16" />ರುತ್ ಸಾಸೊಪ ಆಲಿತವಾ,“ ತಿನಿ ಲಿಕಿ ತು ಗೆಲ್ಯಾಲ ಕಾಮ್ ಕ್ಯಾ ಜಾ಼ಲ್ಹ?” ಮನ್ಹುನ್ ಇಚಾರಲ್ಯಾಲ್ಯಾಲಾ, ರುತಾನಿ ತಿಥ ಚಾ಼ಲ್ಯಾಲ ಸಗ್ಳ ಸಾಂಗ್ಲ. <verse eid="RUT 3:16" /><verse number="17" style="v" sid="RUT 3:17" />ಯವ್ಡಸ್ನವ್ಹ, ಸಾಸೊಪ ಮೊಕಳ್ಯಾ ಹಾತಾನಿ ಜಾ಼ವುನಕೊ, ಮನ್ಹುನ್ ಸಾಂಗುನ್ ಹ್ಯಾ ಯವಡ್ಯಾ ಬಾರಲ್ಯಾ ದಿಲ್ಯಾತಾ,”ಮನ್ಲಿ. <verse eid="RUT 3:17" /><verse number="18" style="v" sid="RUT 3:18" />ತವಾ ನವೊಮಿ, “ಲಿಕಿ, ಹ್ಯಚಾ಼ ಪರಿನಾಮಾ ಕ್ಯಾ ವ್ಹತ್ಯೊ ಮನ್ಹುನ್ ಸಮಜ಼ಪರ‍್ಯಾತ್ ಸಮಾದಾನಾನಿ ರ‍್ಹಾ. ಬೊವಜಾ ಹೆ ಗುಸ್ಟಿಚಾ಼ ಇಚಾರ್ ಕರಿಸ್ಪರ‍್ಯಾತ್ ಗಪ್ರಾನಾರ‍್ನಾಹಿ,” ಮನ್ಲಿ.<verse eid="RUT 3:18" /></para>
  <chapter eid="RUT 3" />
  <chapter number="4" style="c" sid="RUT 4" />
  <para style="s">ಬೊವಜಾಸಂಗ ರುತಾಚ಼ ಲಗಿನ್</para>
  <para style="p">
    <verse number="1" style="v" sid="RUT 4:1" />ಹಿಕ್ಡ ಬೊವಜಾ ಗಾವಾಚೆ ಬೈಟಕಿಚಾ ಜಾ಼ಗ್ಯಾವ ಜಾ಼ವುನ್ ಬಸ್ಲಾ. ತ್ಯವಡ್ಯಾತ್, ಬೊವಜಾನಿ ಆಂದಿ ಸಾಂಗಲ್ಯಾಲಾ ಎಲಿಮೆಲೆಕಾಲಾ ಜ಼ವಳಚಾ಼ ವಾರ‍್ಸಿ ಜಾ಼ಲ್ಯಾಲಾ ತಿಥ ಆಲಾ. ತವಾ ಬೊವಜಾನಿ ತ್ಯಲಾ: “ಎ ಬಾಬಾ ಹಿತ ಭಸ್,” ಮನ್ಹುನ್ ಹಾಕಟ್ಲಾ, ತ್ಯೊ ಯವುನ್ ಕಡಸ್ ಬಸ್ಲಾ. <verse eid="RUT 4:1" /><verse number="2" style="v" sid="RUT 4:2" />ಮಂಗ್ ಬೊವಜಾನಿ ದಾಯೆಕ್ ಜಾಂತ್ಯಾನಾ ಹಾಕಟ್ಲ. ತೆಬಿ ತಿಥ ಯವುನ್ ಬಸ್ಲ. <verse eid="RUT 4:2" /><verse number="3" style="v" sid="RUT 4:3" />ಮಂಗ್ ಬೊವಜಾನಿ ತ್ಯಾ ವಾರ‍್ಸಿಲಾ, “ಆಮಚಾ಼ ಸ್ವತಾಚಾ಼ ಜಾ಼ಲ್ಯಾಲ್ಯಾ ಎಲಿಮೆಲೆಕಾಚ಼ ಥೊಡ ಶಾತ್ ಹಾ, ತ್ಯ ಮೊವಾಬ್ ದೆಶೆತ್ನಿ ಮಾಗಾರಿ ಆಲ್ಯಾಲಿ ನೊವೊಮಿ ಇಕ್ತೊ ಮಂತೆ. <verse eid="RUT 4:3" /><verse number="4" style="v" sid="RUT 4:4" />ಹ್ಯ ತುಲಾ ಸಾಂಗಾಯಾ ವ್ಹಯಿ ಮನ್ಲೊ. ತ್ಯ ಶಾತ್ ಗಿಹ್ಯಾ ತುಲಾ ಮನ್ ಆಸ್ಲತ ಹಿತ ಬಸಲ್ಯಾಲ್ಯಾ ಜಾಂತ್ಯಾಂಚೆ ಮೊರ‍್ಹ ಗಿಹ್ಯಾಚಾ಼ ಹಾಕ್ ಆಂದಿ ತುಲಾಸ್, ಮಂಗ್ ಮನಾ ಶೊಡಲ್ಯಾಲ; ದಿಸರ‍್ಯಾನಾ ನಾಹಿ,” ಮನ್ಲಾ, ತವಾ ತ್ಯೊ ಮಾನುಸ್: “ಮಿಸ್ ಗೆಥೊ,” ಮನ್ಲಾ.<verse eid="RUT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="RUT 4:5" />ತವಾ ಬೊವಜಾ, “ತು ತ್ಯ ಶಾತ್ ಗಿಹ್ಯಾಚಾ಼ ಆಸ್ಲಾಸ್ತ, ತಿಚಿ ಸುನ್ ಮೊವಾಬ್ ದೆಶೆತ್ಲೆ ರುತಾಲಾ ತು ಲಗಿನ್ ವ್ಹಯಾ ವ್ಹಯಿಸ್. ತವಾ ತ್ಯಾ ಶೆತಾಚಾ಼ ಖಾತಾ ಮೆಲ್ಯಾಲ್ಯಾ ಲೆಕಾಚಾ ನಾವಾವಸ್ ರಾನ್ಹಾರ್,”ಮನ್ಲಾ. <verse eid="RUT 4:5" /><verse number="6" style="v" sid="RUT 4:6" />ತವಾ ತ್ಯೊ ವಾರ‍್ಸಿ, “ತಸಜಾ಼ಲ್ಯಾ ಶಾತ್ ಹ್ಯಚಾ಼ ಹಾಕ್ ಮಿ ಸುಡುನ್ದೆತೊ. ನಾಹಿತ ಮಾಜಾ ಕುಟ್ಮಾಲಾ ಆಸಲ್ಯಾಲೆ ಆಸ್ತಿಲಾ ದಕ್ಕಾ ಬಸ್ನಾರ್. ಮನ್ಹುನ್ ತ್ಯೊ ಹಾಕ್ ತುಸ್ಗೆ, ಮನಾ ವ್ಹಯಿತ್ನಾಹಿ,” ಮನ್ಲಾ.<verse eid="RUT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="RUT 4:7" />ಇಸ್ರಾಯೆಲಾಂಚಾತ್ ಆಸ್ತಿ ಪಾಸ್ತಿ ಇಕ್ತಾನಾ ನಾಹಿತ ಸದ್ಲಾಬದಲ್ ಕರ್ತಾನಾ ಎಕ್ ಪದತ್ ಚಾ಼ಲ್ತಿ ಹುತಿ; ತಿ ದೆತ್ಯಾಲ್ಯಾನಿ ಗೆತ್ಯಾಲ್ಯಾಲಾ ಆಪಲ್ಯಾ ಪಾಯಾತ್ಲಾ ಜೋ಼ಡ್ ದಿಯಾಚಾ಼. ಆಸಾ ಇಸ್ರಾಯೆಲಾಂಚೆ ಮದ್ದಿ ಯವಾರ್ ಸಪ್ವಿತಿತ. <verse eid="RUT 4:7" /><verse number="8" style="v" sid="RUT 4:8" />ತಸಸ್ ತ್ಯಾ ವಾರ್ಶಾನಿ, “ಶಾತ್ ತುಸ್ ಘೆ,” ಮನ್ಹುನ್ ಸಾಂಗುನ್ ಪಾಯಾತ್ಲಾ ಜೊ಼ಡ್ ಕಾಡುನ್ ಬೊವಜಾಲಾ ದಿಲಾ. <verse eid="RUT 4:8" /><verse number="9" style="v" sid="RUT 4:9" />ತವಾ ಬೊವಜಾನಿ ಗಾವಾತಲ್ಯಾ ಸಗಳ್ಯಾ ಜಾಂತ್ಯಾನಾ ಆನಿ ತಿಥ ಜ಼ಮಲ್ಯಾಲ್ಯಾ ಲೊಕಾನಾ, “ಎಲಿಮೆಲೆಕಲಾ ಆನಿ ಕಲ್ಯೊನ್, ಮಹ್ಲೊನ್ ಹ್ಯನಾ ಸಮನ್ನ್ ಆಸಲ್ಯಾಲಿ ಆಸ್ತಿ ಸಗಳಿ ನವೊಮಿಪ್ನಿ ಇಕತ್ಗೆತ್ಲೆ. ಹ್ಯಲಾ ತುಮಿ ಸಗ್ಳಿ ಸಾಕ್ಶಿ, <verse eid="RUT 4:9" /><verse number="10" style="v" sid="RUT 4:10" />ಆನಿ, ಮಹ್ಲೊನಾಚಿ ಬ್ಯಾಯ್ಕೊ ಜಾ಼ಲ್ಯಾಲಿ ಮೊವಾಬ್ಯಾತ್ಲೆ ರುತಾಲಾ ಮಿ ಬ್ಯಾಯ್ಕೊ ಕರುನ್ ಗೆತ್ಲಿ. ಹ್ಯನಿ ಶೆತಾಚಾ಼ ಖಾತಾ ಮೆಲ್ಯಾಲ್ಯಾ ಮಹ್ಲೊನಾಚಾ ನಾವಾವಸ್ ರಾನ್ಹಾರ್. ತ್ಯವ್ಡಸ್ನವ್ಹ, ತ್ಯಚಾ಼ ವಂಸಾ ತ್ಯಚಾ ಬಂದ್ಬಳ್ಗಾತ್ ಗಾವಾತ್ ಉಬಾರಾನ್ಹಾರ್. ಹ್ಯಲಾ ತುಮಿ ಸಗ್ಳಿ ಸಾಕ್ಶಿ,” ಮನ್ಲಾ.<verse eid="RUT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="RUT 4:11" />ತವಾ ಗಾವಾತ್ಲ ಜಾಂತ ಆನಿ ಜ಼ಮಲ್ಯಾಲಿ ಬೈಟಕ್: “ವ್ಹಯ್, ಆಮಿ ಸಗ್ಳಿ ಸಾಕ್ಶಿ. ಇಸ್ರಾಯೆಲಾಚ಼ ಗರ‍್ಹಾನ ವಾಡಿವಲ್ಯಾಲೆ ರಾಹೆಲ್ ಆನಿ ಲೆಯಾ ಮಂತ್ಯಾಲೆ ಬ್ಯಾಯ್ಕಾಂಚೆಗತ್ ಪರಮೆಸ್ವರ್ ಆಸಿರ್ವಾದ್ ಕರುನಿ! ಎಪ್ರಾತ್ ಕುಳಾತ್ ಅಬಿವ್ರದಿ ಹೊ; ಬೆತ್ಲೆಹೆಮತ್ ಮೊಟನಾವ್ ವ್ಹವುನಿ! <verse eid="RUT 4:11" /><verse number="12" style="v" sid="RUT 4:12" />ತೆ ಬ್ಯಾಯ್ಕಾಮಾನ್ಸಾಸ್ಲಾಗುನ್ ಪರಮೆಸ್ವರ್ ತುಲಾ ದೆತ್ಯಾಲ್ಯಾ ವಂಶಾನಿ ತುಜ಼ ಗರ‍್ಹಾನ, ಯೆಹುದಾಲಾ ತಾಮಾರಾಚಾ ಪೊಟಾಸ್ ಜ಼ಲಾಮಲ್ಯಾಲ್ಯಾ ಪೆರೆಸಾಚಾ ಗರ‍್ಹಾನ್ಯಾಚೆಗತ್ ಖುಬ್ ವ್ಹವುನಿ!” ಮನ್ಹುನ್ ಆಸಿರ್ವಾದ್ ಕೆಲಾ.<verse eid="RUT 4:12" /></para>
  <para style="s">ಬೊವಜಾ ಆನಿ ತ್ಯಚಾ಼ ವಂಸಾ</para>
  <para style="p">
    <verse number="13" style="v" sid="RUT 4:13" />ಬೊವಜಾ ರುತಾಲಾ ಲಗಿನ್ ಜಾ಼ಲಾ. ಆನಿ ಪರಮೆಸ್ವರಾಚಾ ಆಸಿರ್ವದಾನಿ ಗರ್ವಾರ್ ರಾಹುನ್ ಯೊಕ್ ಲ್ಯೊಕ್ ಜಾ಼ಲ್ಹಾ. <verse eid="RUT 4:13" /><verse number="14" style="v" sid="RUT 4:14" />ಗಾವಾತಲ್ಯಾ ಬ್ಯಾಯ್ಕಾ ನವೊಮಿಲಾ: “ಪರಮೆಸ್ವರ್ ಥೊರ್! ತುಲಾ ಯೊಕ್ ವಂಸಾ ದಿಲ್ಯಾ ಇಸ್ರಾಯೆಲ್ ದೆಶೆತ್ ತ್ಯಾ ಮುಲಾಚ಼ ನಾವ್ ವಾಜು಼ನಿ! <verse eid="RUT 4:14" /><verse number="15" style="v" sid="RUT 4:15" />ತ್ಯೊ ತುಲಾ ನವಾ ಜಿವ್ನಾ ದಿವುನ್ ಮಾಥಾರೆ ಫನಿತ್ ತುಜಿ ಸಂರಕ್ಶನ್ ಕರ್ನಾರ್. ಸಾತ್ ಲೆಕಾಂಚಿವ್ನಿ ತುಲಾ ಆವಾಡಲ್ಯಾಲಿ ತುಜೆ ಮಾಯೆಚೆ ಸುನನಿ ಹ್ಯಲಾ ತುಲಾ ದಿಲ್ಯಾ!” ಮನಲ್ಯಾ. <verse eid="RUT 4:15" /><verse number="16" style="v" sid="RUT 4:16" />ನವೊಮಿನಿ ತ್ಯಾ ಮುಲಾಲಾ ಆಪಲ್ಯಾ ಪದರಾತ್ ಗಿಹುನ್ ಬಾಳಗ್ಲಾ.<verse eid="RUT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="RUT 4:17" />ಆಜೊ಼ ಬಾಜೊ಼ಚಾ ಬ್ಯಾಯ್ಕಾ, “ನವೊಮಿಲಾ ಯೊಕ್ ಲ್ಯೊಕ್ ಜ಼ಲಾಮಲ್ಯಾ! ತ್ಯಚ಼ ನಾವ್ “ಓಬೆದ್” ಥೆವ್ಲ. ಹ್ಯೊಸ್ ಇಶಾಯಾಚಾ಼ ಬಾ, ಇಸಾಯಾ ದಾವಿದಾಚಾ಼ ಬಾ. <verse eid="RUT 4:17" /><verse number="18" style="v" sid="RUT 4:18" />ಪೆರೆಚಾ ದರ್ನಿ ದಾವಿದಾಪರ‍್ಯಾತ್ಚಿ ವಂಶಾವಳಿ: ಪೆರೆಚಾಲಾ ಹೆಚ್ರೊನ್ ಜ಼ಲಾಮ್ಲಾ, <verse eid="RUT 4:18" /><verse number="19" style="v" sid="RUT 4:19" />ಹೆಚ್ರೊನಾಲಾ ರಾಮ್ ಜ಼ಲಾಮ್ಲಾ, ರಾಮಾಲಾ ಆಮಿನಾದಾಬ್ ಜ಼ಲಾಮ್ಲಾ, <verse eid="RUT 4:19" /><verse number="20" style="v" sid="RUT 4:20" />ಆಮಿನಾದಾಬಾಲಾ ನಹಶೊನ್ ಜ಼ಲಾಮ್ಲಾ, ನಹಶೊನಾಲಾ ಸಲ್ಮೊನ್ ಜ಼ಲಾಮ್ಲಾ, <verse eid="RUT 4:20" /><verse number="21" style="v" sid="RUT 4:21" />ಸಲ್ಮೊನಾಲಾ ಬೊವಜಾ ಜ಼ಲಾಮ್ಲಾ. ಬೊವಜಾಲಾ ಓಬೆದ್ ಜ಼ಲಾಮ್ಲಾ, <verse eid="RUT 4:21" /><verse number="22" style="v" sid="RUT 4:22" />ಓಬೆದಾಲಾ ಇಶಾಯ್ ಜ಼ಲಾಮ್ಲಾ, ಇಶಾಯಲಾ ದಾವಿದ್ ಜ಼ಲಾಮ್ಲಾ.<verse eid="RUT 4:22" /></para>
  <chapter eid="RUT 4" />
</usx>