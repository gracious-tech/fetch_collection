<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JON" style="id">Gawli Marathi</book>
  <para style="toc3">ಯೊನ</para>
  <para style="toc2">ಯೊನ</para>
  <para style="toc1">ಯೊನ್</para>
  <para style="mt2">ಯೊನಾಚ಼ ಪುಸ್ತಕ್</para>
  <para style="mt1">ಯೊನಾಚ಼ ಪುಸ್ತಕ್</para>
  <para style="imt">ವಳಕ್</para>
  <para style="ip">ಯೊನಾನಿ ನಿನವೆ ಶೆರಾಲಾ ಕೆಲ್ಯಾಲ ಸೆವಾ ಆನಿ ಉಪ್ದೆಸಾಚ಼ ಸಾಂಗ್ತ. ಆಸ ಪ್ರವಾದಿಂಚಾ ಪುಸ್ತಕಾವ್ನಿ ಹ್ಯ ಪುಸ್ತಕ್ ದೆವಾಚಾ ಸಂದೆಸಾವ್ನಿ ಜಾಸ್ತಿ ಯೊನಾಚಾ಼ ಕರ್ತೆವ್ ಆನಿ ಕಾಮಾಂಚಾನಿ ಬರಲ್ಯಾ. ಯೊನಾಚಿ ಸೆವಾ ಇಸ್ರಾಯೆಲಾಚಾ಼ ರಾಜಾ಼ ಯರೊಬಾಮ್ ಕಾಲಾತ್ ಮಂಜೆ ಸುಮಾರ್ ಕ್ರಿ.ಪೂ. ಆಟ್ಸೆಸ್ನಿ-ಸಾಡಸಾತ್ಚೆ ಇಸ್ವಿಚೆ ಮಾಗ್ಲ ಮನ್ಹುನ್ ಇಸ್ವಾಸ್ ಥೆವತ್ಯಾತ, ಫನ್ ಹ್ಯ ಪುಸ್ತಕ್ ಕವಾ ಲಿವಲ್ಯಾಲ ಮನ್ಹುನ್ ಪಂಡಿತಾನಾ ಶಾರ್ಕ ಠಾವ ನಾಹಿ. ದೆವಾನಿ ಯೊನಾಲಾ ನಿನೆವೆವ ಆಡ್ವಾ ಉಪ್ದೆಸ್ ಸಾಂಗಾಲಾ ಲಾವುಂದಿಲಾ, ಫನ್ ಯೊನಾ ದೆವಾಚ಼ ಐಕಾಚೆ ಆಂದಿ <char style="xt"><ref loc="JON 1:1-3">1:1-3</ref></char> ತ್ಯೊ ತಾರ್ಶಿಸ್ ಮಂಥ್ಯಾಲ್ಯಾ ಶೆರಾತ್ ಜಾ಼ತ್ಯಾಲೆ ವ್ಹಡಿತ್ ಬಸ್ಲಾ. ವ್ಹಡಿ ಸಮಿಂದೊರಾತ್ ಜಾ಼ತಾನಾ ದೆವಾನಿ ಮೊಟಿ ವಾರಮ್ಯೊಡ್ ಶುಡ್ಲಿ. ನಾವಿಕ್ ಖುಬ್ ಬಿಹ್ಯಾಲ ಆನಿ ದೆವಾಚಾ಼ ರಾಗ್ ಥಂಡ್ ವ್ಹಯಾ ತ್ಯಂಚಾನಿ ಯೊನಾಲಾ ಸಮಿಂದೊರಾತ್ ಜು಼ಗ್ಯಾರ್ಲಾ. ಮಂಗ್ ದೆವಾನಿ ತ್ಯಲಾ ಉರ್ವಾಲಾ ಮೊಟ್ಯಾ ಮಾಶಾಲಾ ಯೊನಾಲಾ ಗಿಳಾಯಾ ಲಾವುಂದಿಲಾ. ಯೊನಾ ಖುಬ್ ಪಚಾತಾಪ್ ಪಡ್ಲಾ ಆನಿ ದೆವಾನಿ ತ್ಯಲಾ ಉರ್ವಾಲಾ ಹುಕ್ಕುಮ್ ದಿಲಾ. ಸರ್ತಾನಾ ಯೊನ್ ನಿನ್ವೆತ್ ಜಾ಼ವುನ್ ಉಪ್ದೆಸ್ ಕರ್ತೊ, ಆನಿ ತ್ಯಾ ಶೆರಾತ್ಲಿ ಲೊಕ ಪಚಾತಾಪ್ ಪಡ್ಲಿತ. ಯೊನಾಚ಼ ಪುಸ್ತಕಾತ್ ದೆವಾನಿ ಕೆವ್ಡಿ ಮಾಯಾಕರತೊ ಮನ್ಹುನ್ ದ್ಯಾವ್ತ, ಕಾ ಮಂಜೆ ಯೊನಾಲಾ ದೆವಾನಿ ಮಾಯಾ ದಾವಾಚಿ ನಕೊಜಾ಼ಲ್ತಿ (<char style="xt"><ref loc="JON 4:2">4:2</ref></char>).</para>
  <para style="iot">ಭಾಗ್</para>
  <para style="io1">ಆದ್ಯಾಯ <char style="ior"><ref loc="JON 1">1</ref></char> ಹ್ಯ ಪುಸ್ತಕ್ ಯೊನಾ ದೆವಾಪ್ನಿ ಚು಼ಕ್ವುನ್ ಗಿಯಾ ಯತ್ನ ಕರ್ತೊ ಆನಿ ಮಾಶಾಚಾ ಪೊಟಾತ್ ರಾತ್ಯಾಲ.</para>
  <para style="io1">ಆದ್ಯಾಯ <char style="ior"><ref loc="JON 2">2</ref></char> ಯೊನ್ ಮಾಶಾಚಾ ಪೊಟಾತ್ ದೆವಾಪ ಮಾಗ್ನ ಕರ್ತೊ.</para>
  <para style="io1">ಆದ್ಯಾಯ<char style="ior"><ref loc="JON 3">3</ref></char> ಯೊನಾ ನಿನವೆಚಾ ಶೆರಾತ್ ಉಪ್ದೆಸ್ ಕರ್ತೊ ಆನಿ ಲೊಕ ಪಚಾತಾಪ ವ್ಹತ್ಯಾತ. ದೆವ್ ತ್ಯನಾ ಮಾಪಿ ಕರ್ತೊ.</para>
  <para style="io1">ಆದ್ಯಾಯ <char style="ior"><ref loc="JON 4">4</ref></char> ಯೊನಾ ದೆವಾನಿ ನಿನವೆತಲ್ಯಾ ಲೊಕಾವ್ನಿ ಮಾಯಾ ದ್ಯಾವ್ಲಿ ಮನ್ಹುನ್ ರಾಗ್ ಕರ್ತೊ. ದೆವಾನಿ ಯೊನಾಲಾ ಆಪ್ಲಿ ಮಾಯಾ ಸಗಳ್ಯಾ ಲೊಕಾವ್ನಿ ಹಾ ಮನ್ಹುನ್ ದಾವುಂದಿಲಿ.</para>
  <chapter number="1" style="c" sid="JON 1" />
  <para style="s">ಯೊನಾ ದೆವಾಲಾ ಆಡ್ವಾ ಜಾ಼ಲ್ಯಾಲಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 1:1" />ಎಕಸಿ ಅಮೀತೈಯಾಚಾ಼ ಲ್ಯೊಕ್ ಯೊನಾ ಸಂಗ ಪರಮೆಶ್ವರ್ ಬೊಲ್ಲಾ. ಆನಿ ಮನ್ಲಾ, <verse eid="JON 1:1" /><verse number="2" style="v" sid="JON 1:2" />“ನಿನವೆ ಮೊಟ್ಯಾ ಶೆರಾತಲ್ಯಾ ಲೊಕಾಂಚಿ ವಾಯಿಟ್ ಕಾಮ್ ಮಾಜೆ ಮೊರ‍್ಹ ದಿಸುನ್ ಆಲ್ಯಾತ. ತು ತಿತ್ತ ಜಾ಼ವುನ್ ಖಡ್ಯಾವುನ್ ಸಾಂಗ್.” <verse eid="JON 1:2" /><verse number="3" style="v" sid="JON 1:3" />ಫನ್ ಪರಮೆಸ್ವರಾನಿ ಸಾಂಗಲ್ಯಾಲ ಐಕಾಚ಼ ಯೊನಾಚಾ ಮನಾತ್ ನವ್ತ, ಮನ್ಹುನ್ ಪರಮೆಸ್ವರಾಲಾ ಚು಼ಕುವುನ್ ಪಳುನ್ ಜಾ಼ಯಾ ಯವಜು಼ನ್ ಯೊಪಾತ್ ಗೆಲಾ. ಆನಿ ಯೊಪಾತ್ನಿ ತಾರ್ಶಿಸ್ಲಾ ಜಾ಼ತ್ಯಾಲಿ ವ್ಹಡಿ ಬಗುನ್ ತ್ಯಚೆ ತಿಕ್ಟಾಚ಼ ಪೈಸದಿವುನ್ ತಾರ್ಶಿಸ್ಲಾ ಜಾ಼ಯಾ ನಾವಿಕಾ ಸಂಗ ಚ಼ಡ್ಲಾ.<verse eid="JON 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JON 1:4" />ತವಾ ಪರಮೆಸ್ವರಾನಿ ಸಮಿಂದೊರಾವರ್ ಜೊ಼ರಾನಿ ವಾರಮ್ಯೊಡ್ ಎಯಿಸಾರಿ ಕಿಲಿ ಸಮಿಂದೊರ್ ಹಲಾಯಾ ಲಾಗ್ಲಾ ಆನಿ ವ್ಹಡಿ ಪುಠುನ್ ಜಾ಼ಯಿಸಾರಿ ಜಾ಼ಲಿ. <verse eid="JON 1:4" /><verse number="5" style="v" sid="JON 1:5" />ತವಾ ವ್ಹಡಿತ್ಲ ನಾವಿಕ್ ಬಿಹುನ್ ಆಪಲ್ಯಾ ಆಪಲ್ಯಾ ದೆವಾನಾ ಹಳ್ಯಾ ಮಾರಾಯಾ ಲಾಗ್ಲಿತ ಆನಿ ವ್ಹಡಿತ್ ವಜ಼ ಕಮ್ಮಿ ಹ್ವಯಾಸಾಟಿ ತ್ಯಾತ್ಲ ಸಾಮಾನ್ ಸಗ್ಳ ಪಾನ್ಯಾತ್ ಟ್ಯಾಕ್ಲ ಖರ ಯೊನ್ ವ್ಹಡಿತ್ ತಳಾತಲ್ಯಾ ಬಾಘಾತ್ ಬೆಭಾನ್ ನಿಜ಼ಲಾ ಹುತ್ತಾ.<verse eid="JON 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JON 1:6" />ತವಾ ವ್ಹಡಿತ್ಲಾ ಫುಡಾರಿ ಯವುನ್ ”ಹ್ಯ ಕ್ಯಾ ತು ನಿಜ಼ಲ್ಯಾಸ್ ನವ್ಹ? ಉಟುನ್ ತುಜಾ ದೆವಾಲಾ ತರಿ ಹಳ್ಳಿ ಮ್ಯಾರ್ ತ್ಯೊ ಅಮಾನಾ ಉರಿವ್ಲತ ಉರ್ವಿಲ್.<verse eid="JON 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JON 1:7" />ತವಾ ನಾವಿಕ್ ಸಗ್ಳ ಆಪಲ್ಯಾ ಆಪಲ್ಯಾತುಸ್ ಬುಲುನ್ ಹ್ಯೊ ದೊಖಾ ಯಾಯಾ ಕೊನ್ ಕಾರಣ ಅಮಾನಾ ಸಮ್ಜಾಯಾ ಚಿಟಿ ಗಾಲುಯಾ ಮನ್ಹುನ್ ಚಿಟ್ ಗ್ಯಾತ್ಲಿ ತಿ ಯೊನಾಚಾ ನಾವಾನಿ ಆಲಿ. <verse eid="JON 1:7" /><verse number="8" style="v" sid="JON 1:8" />ತವಾ ನಾವಿಕಾಂಚಾನಿ “ಹ್ಯೊ ದೊಖಾ ಆಮ್ಚಿವ ಕಾ ಆಲ್ಯಾ ಸಾಂಗ್: ತುಜ಼ ಕಾಮ್ ಕ್ಯಾ? ಕುಟ್ನಿ ಆಲ್ಯಾಸ್? ತು ಕಚೆ ದೆಶೆತ್ಲಾ? ತು ಕುಟ್ಲೆ ಜಾ಼ತಿಚಾ಼?” ಮನ್ಹುನ್ ಇಚಾರ್ಲ.<verse eid="JON 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 1:9" />ತ್ಯೊ ತ್ಯನಾ “ಮೀ ಹಿಬ್ರಿಯಾಂಚಾ಼. ದರ್ಥಿ, ಆಬಾಳ್ ಆನಿ ಸಮಿಂದೋರ್ ಕೆಲ್ಯಾಲ್ಯಾ ಪರಮೆಸ್ವರಾಚಾ಼ ಭಗತ್”, ಮನ್ಹುನ್ ಸಾಂಗ್ಲ. <verse eid="JON 1:9" /><verse number="10" style="v" sid="JON 1:10" />ತ್ಯೊ ಪರಮೆಸ್ವರಾಪ್ನಿ ಪಳುನ್ ಜಾ಼ತ್ಯೊ ಮನ್ಹುನ್ ತ್ಯನಿ ಸಾಂಗಲ. ಹ್ಯ ಐಕುನ್ ನಾವಿಕ್ ಸಗ್ಳ ಬಿಹ್ಯಾಲ. “ಹ್ಯ ಕ್ಯಾ ಕೆಲಸ್!” ಮನ್ಹುನ್ ತ್ಯಲಾ ಖಡ್ಯಾವ್ಲಾ. <verse eid="JON 1:10" /><verse number="11" style="v" sid="JON 1:11" />ನಂತರ್ ಸಮಿಂದೊರ್ ಲಸ್ ಉಸ್ಳಾಯಾ ಲಾಗ್ಲಾ ತವಾ ತ್ಯಂಚಾನಿ ಸಮಿಂದೊರ್ ಥಂಡ್ ವ್ಹಯಾ ಅಮಿ ತುಲಾ ಕ್ಯಾ ಕರಾವ? ಮನ್ಹುನ್ ತ್ಯಲಾ ಇಚಾರ್ಲ.<verse eid="JON 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JON 1:12" />ತ್ಯನಿ ತ್ಯನಾ “ಮನಾ ಉಚ್ಲು಼ನ್ ಸಮಿಂದೊರಾತ್ ಟಾಕಾ ತವಾ ಸಮಿಂದೊರ್ ಥಂಡ್ ವ್ಹಯಿಲ್ ಹ್ಯ ಮೊಟ ವಾರ ಮಾಜಿಸ್ ಲಾಗುನ್ ಅಲ್ಯಾ ಮನ್ಹುನ್ ಮನಾ ಠಾವ ಹಾ” ಮನ್ಲಾ.<verse eid="JON 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JON 1:13" />ನಾವಿಕಾನಾ ಮನ್ ಜಾ಼ಲ್ಹ ನಾಹಿ ಅಮಿ ಮಾಗಾರಿ ಜಾ಼ವುಯಾ ಮನ್ಹುನ್ ಪರಾತ್ಲಿತ ಜಾ಼ತಾನಾ ವ್ಹಡಿಚಾ಼ ಹುಟ್ ಮಾರುನ್ ದಮ್ಲಿತ ಸಮಿಂದೊರಾಚಾ಼ ಲಸ್ ಉಸ್ಸೊಳ್ ವ್ಹಯಾ ಲಾಗ್ಲಾ. <verse eid="JON 1:13" /><verse number="14" style="v" sid="JON 1:14" />ತವಾ ತ್ಯಂಚಾನಿ “ಪರಮೆಸ್ವರಾಲಾ ಹಾತ್ ಜು಼ಡುನ್ ದೆವಾ ಹ್ಯಾ ಮಾನ್ಸಾಸ್ ಲಾಗುನ್ ಅಮಾನಾ ಮಾರು ನಕೊಸ್ ಚು಼ಕ್ ನಸಲ್ಯಾಲ್ಯಾ ಮಾನಸಾಚಾ ಮರ್ನಾಚ಼ ಕತೊಸ್ ಅಮ್ಚಿವ ಗಾಲು ನಕೊಸ್. ದೆವಾ ಹ್ಯ ತುಜಾ಼ ಮನಾ ಸಾರ ಕೆಲ್ಯಾಸ್ ನವ್ಹ ಮನ್ಹುನ್ ದೆವಾಪ ಮಾಗ್ನ ಕೆಲ”. <verse eid="JON 1:14" /><verse number="15" style="v" sid="JON 1:15" />ಪರಮೆಸ್ವರಾ ತುಜಾ ಮನಾಶಾರ್ಕ ಕೆಲ್ಯಾಸ್ ಮನ್ಹುನ್ ಯೊನಾಲಾ ಉಚ್ಲು಼ನ್ ಸಮಿಂದೊರಾತ್ ಟ್ಯಾಕ್ಲಾ ತವಾ ಸಮಿಂದೊರಾಚಾ ಉಸ್ಸೊಳ್ ಥಂಡ್ ಜಾ಼ಲಾ. <verse eid="JON 1:15" /><verse number="16" style="v" sid="JON 1:16" />ಹ್ಯ ಬಗುನ್ ತಿ ಲೊಕ ಪರಮೆಸ್ವರಾಲಾ ಲಸ್ ಬಿಹ್ಯಾಲಿತ ಆನಿ ತ್ಯಲಾ ಬಲಿ ದಿವುನ್ ಮಾಗ್ನಿ ಫಾರಿಕ್ ಕೆಲಿತ.<verse eid="JON 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JON 1:17" />ಯೊನಾಲಾ ಗಿಳಾಯಾ ದೆವಾನಿ ಯಕಾ ಮಾಶಾಲಾ ಸಾಂಗ್ಲ ಯೊನಾಲಾ ಮಾಶಾನಿ ಗಿಳ್ಳಾ ಆನಿ ಯೊನ್ ತಿಂದ್ರೊಜ಼್ ರ‍್ಯಾತ್ ದಿಸ್ ಮಾಶಾಚಾ ಪೊಟಾತ್ ರಾಯ್ಲಾ.<verse eid="JON 1:17" /></para>
  <chapter eid="JON 1" />
  <chapter number="2" style="c" sid="JON 2" />
  <para style="s">ಯೊನಾಚ಼ ಮಾಗ್ನ</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 2:1" />ಆಸ ಯೊನಾನಿ ತ್ಯಾ ಮಾಶಾಚಾ ಪೊಟಾತ್ ರಾಹುನ್ ಪರಮೆಸ್ವರಾಲಾ ಮಾಗ್ನ ಕೇಲ.<verse eid="JON 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JON 2:2" />“ ಮಿ ಕಶ್ಟಾತ್ ದೆವಾಲಾ</para>
  <para style="q2" vid="JON 2:2">ಪಾತಾಳಾಚಾ ಪೋಟಾತ್ನಿ ಹಳ್ಳಿ ಮ್ಯಾರ್ಲಿ</para>
  <para style="q1" vid="JON 2:2">ತೀ ಹಳ್ಳಿ ಮಾಜಿ ತು ಐಕ್ಲಿ.</para>
  <para style="q2" vid="JON 2:2">ಆನಿ ತ್ಯನಿ ಮನಾ ಉತ್ತರ್ ದಿಲಾ<verse eid="JON 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JON 2:3" />ಕಾ ಮಂಜೆ ತು ಮನಾ ಖೊಲ್ ದರ‍್ಯಾತ್ ಟ್ಯಾಕ್ಲಸ್,</para>
  <para style="q2" vid="JON 2:3">ಪಾನ್ಯಾನಿ ಯಡಾ ಗ್ಯಾತ್ಲಾ;</para>
  <para style="q2" vid="JON 2:3">ಇಸೊಬ್ ನಾಹೀ ಯವಡ್ಯಾ ಲಾಟಾ</para>
  <para style="q2" vid="JON 2:3">ಮಾಜೆ ವೈನೀ ಗೇಲ್ಯಾ.<verse eid="JON 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JON 2:4" />ತುಜಾ ಡೋಳ್ಯಾ ಆಡ್ ಕೆಲ್ಯಾಸ್ ಮನ್ಲೊ</para>
  <para style="q2" vid="JON 2:4">ತರಿಬಿ ಅನೀಕ್ ತುಜ಼ ಪವಿತ್ರ ದೀವುಳ್ ಬಗೀನ್.<verse eid="JON 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JON 2:5" />ಪಾನ್ಯಾಚಿ ಲಾಟ್ ಮಾಜಾ ಜಿವಾವರ್ ಆಲಿ;</para>
  <para style="q2" vid="JON 2:5">ಮೊಟಾ ಸಮಿಂದೊರಾನಿ ಉಸಾಸ್ ಬ್ಯಾಂದಲ್ಯಾ ಸಾರಾ ಎಡಾ ಗ್ಯಾತ್ಲಾ,</para>
  <para style="q2" vid="JON 2:5">ಶಿವ್ಳಿ ಮಾಜೆ ಡೂಯಿಲಾ ಗುತ್ಪಾಳ್ಳಿ,<verse eid="JON 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JON 2:6" />ಪರ್ವತಾಚಾ ತಳಾಸ್ ಉತಾರ್ಲೋ.</para>
  <para style="q2" vid="JON 2:6">ಭೂಲೋಕಾಚಾ ಆಗಳ್ಯಾ ಕಂದಿಸ್ ಕಾಡಾ ಹೊಯಿತ್ ನಸಲ್ಯಾಚೆಗತ್ ಮಾಜೆ ಮಾಗ ಗ್ಯಾತಲ್ಯಾ.</para>
  <para style="q2" vid="JON 2:6">ಫನ್ ಮಾಜಾ ದೆವಾ ಪರಮೆಸ್ವರಾ</para>
  <para style="q2" vid="JON 2:6">ತು ಮಾಜಾ಼ ಜೀವ್ ಪಾತಾಳಾತ್ನಿ ಉಚ಼ಲ್ಲಾಸ್.<verse eid="JON 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JON 2:7" />ಮಾಜಾ ಜಿವಾನಿ ಆಶಾ ಸಗ್ಳಿ ಶೂಡ್ಲಿಹುತ್ತಿ,</para>
  <para style="q2" vid="JON 2:7">ತರಿಬಿ ಪರಮೆಸ್ವರಾ ತುಜಿ ಯಾದ್ ಕರಿತೋ,</para>
  <para style="q2" vid="JON 2:7">ಮಾಜ಼ ಮಾಗ್ನ ತುಜಾ ಪವಿತ್ರ ದೆವ್ಳಾತ್ ಪಾವ್ಲಿ.<verse eid="JON 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JON 2:8" />ಜಿವ್ ನಸಲ್ಯಾಲ್ಯಾ ಪಾಶಾನಾಲಾ ನಂಬುನ್</para>
  <para style="q2" vid="JON 2:8">ಕರ್ನಾ ಅಸಲ್ಯಾಲ್ಯಾ ದೆವಾಲಾ ಇಸಾರತ್ಯಾತ.<verse eid="JON 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JON 2:9" />ಮೀ ತರಿ ಸ್ತೋತ್ರ ಗೀತ್ ಸಾಂಗಿತ್;</para>
  <para style="q2" vid="JON 2:9">ತುಲಾ ಕಾನ್ಕಿ ದೆತೊ</para>
  <para style="q2" vid="JON 2:9">ಮಾಗಲ್ಯಾಲ ನವಾಸ್ ಫೆಡ್ತೊ .</para>
  <para style="q2" vid="JON 2:9">ಕಾ ಮಂಜೆ ರಕ್ಶಾನ್ ವ್ಹನಾರ್ ಪರಮೆಸ್ವರಾಪ್ನಿಸ್<verse eid="JON 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 2:10" />ಪರಮೆಸ್ವರಾನಿ ಮಾಶಾಲಾ ಸಾಂಗ್ಲ ತವಾ ಮಾಸಾ ಯೊನಾಲಾ ಕೊರ‍್ಡೆ ಜಿಮ್ನಿವ ವಕ್ಲಾ.<verse eid="JON 2:10" /></para>
  <chapter eid="JON 2" />
  <chapter number="3" style="c" sid="JON 3" />
  <para style="s">ಯೊನಾಚಾ಼ ಸಬೊತ್ ಐಕ್‌ಲ್ಯಾಲ್ಯಾ ನಿನವೆಚಾಂಚ಼ ಮನ್ ಪರಾತ್ಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 3:1" />‍ ಯೊನಾಲಾ ದೊನವ್ಯಾನಿ ಪರಮೆಸ್ವರಾಚ಼ ವಚ಼ನ್ ಗವಲ್ಯಾಲ “ಆಸ ಸಾಂಗ್ತ, <verse eid="JON 3:1" /><verse number="2" style="v" sid="JON 3:2" />ತು ಉಠುನ್ ತ್ಯಾ ಮೊಟ್ಯಾ ನಿನ್ವೆಲಾ ಜಾ಼ವುನ್ ಮೀ ಸಾಂಗಲ್ಯಾಲ ಸಂದೆಸ್ ತಿತಲ್ಯಾ ಲೊಕಾನಾ ಸಾಂಗ್” <verse eid="JON 3:2" /><verse number="3" style="v" sid="JON 3:3" />ತವಾ ಯೊನ್ ಉಠುನ್ ದೆವಾಚಾ ಸಬ್ದಾ ಶಾರ್ಕಾ ನಿನವೆತ್ ಗೇಲಾ ನಿನವೆ ತೀನ್ ದಿಸಾಚೆ ವಾಟ ಯವ್ಡಿ ಹುತ್ತಿ. <verse eid="JON 3:3" /><verse number="4" style="v" sid="JON 3:4" />ಯೊನಾನಿ ಸೆರಾತ್ ಜಾ಼ವುನ್ ಯೇಕ್ ದಿಸಾಚಿ ವಾಟ್ ಚಾ಼ಲತ್ ಚಾಳಿಸ್ ದಿಸ್ ಜಾ಼ಲ್ಯಾವ ನಿನವೆಲಾ ಪ್ಯಾಡ್ನಾರ್ ಮನ್ಹುನ್ ಸಾಂಗ್ಲ.<verse eid="JON 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JON 3:5" />ಹ್ಯ ಐಕುನ್ ನಿನವೆತ್ಲಿ ದೆವಾವ ಇಸ್ವಾಸ್ ಥಿವುನ್ ಉಪಾಸಾಚ಼ ದೀಸ್ ನೆಮುನ್ ಥೊರ್‌ಲ್ಯಾಂಚೆ ದರ್ನಿ ಬ್ಯಾರಕ್ಯಾಂಚೆ ಪರ‍್ಯಾತ್ ಸಗಳ್ಯಾಂಚಾನಿ ಗೊಂತ ಬಾಂದುನ್ ಗೇತ್ಲ.<verse eid="JON 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JON 3:6" />ಯೊನಾಚಾ಼ ಸಬೊತ್ ನಿನವೆಚಾ ರಾಜಾಲಾ ಐಕು ಆಲಾ ತ್ಯೊ ಆಪ್ಲೆ ರಾಜಾದಿಕಾರಾಚೆ ಕುರ್ಚಿವ್ನಿ ಉತ್ರುನ್ ಅಪ್ಲಿ ಆಂಗಿ ಕಾಡೂನ್ ಚಿಲಾಚಾ಼ ಗೊಂತಾ ಬಾಂದುನ್ ರಾಖತ್ ಬಸ್ಲಾ. <verse eid="JON 3:6" /><verse number="7" style="v" sid="JON 3:7" />ತಸಸ್ ತ್ಯನಿ ನಿನವೆತ್ ರಾಜಾ ಆಜ್ಞೆ ಸಾಂಗುನ್: “ರಾಜಾಚಾ಼ ತ್ಯವ್ಡನವ್ಹ ಅಪಲ್ಯಾ ರಾಜ಼ವಾಡ್ಯಾಚಾ಼ ಸಬೊತ್ ಮನ್ಹುನ್ ಜ಼ನಾವರಾಂಚಾನಿ ಮಾನ್ಸಾಂಚಾನಿ ಕಾಯಿಸ್ ಖಾಯಾಚ ನಾಹಿ ಪಿಯಾಚ಼ ನಾಹಿ ಚ಼ವ್ ಬಗಾಚಿ ನಾಹಿ. <verse eid="JON 3:7" /><verse number="8" style="v" sid="JON 3:8" />ಮಾನ್ಸಾಂಚಾನಿ ಜ಼ನಾವರಾಂಚಾನಿ ಚಿಲಾಚಾ಼ ಗೊಂತಾ ಬಾಂದುನ್ ಸಗಳ್ಯಾಂಚಾನಿ ಅಪ್ಲಿ ಅಪ್ಲಿ ಬುರ್ಸಿಫನ ಕರಾಚಿ ಸೂಡೂನ್ ಪರಮೆಸ್ವರಾಕ್ಡ ಪರ್ತಾ. <verse eid="JON 3:8" /><verse number="9" style="v" sid="JON 3:9" />ಕುನಾಲಾ ಠಾವ ಏಕ್ ಯಳಿ ದೆವಾಚ಼ ಮನ್ ಪರ್ತ್ತೂನ್; ಅಪ್ಲಾ ಮೊಟಾ ರಾಗ್ ಥಂಡ್ಕರುನ್ ಅಮಾನಾ ಉರಿವ್ಲತ ಉರ‍್ವಿಲ್!”<verse eid="JON 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 3:10" />ಪರಮೆಸ್ವರಾಲಾ ನಿನವೆತಲ್ಯಾಂಚ಼ ಕಾಮ್ ಬಗೂನ್ ತೀ ಅಪ್ಲಿ ವಾಯಿಟ್ ಕಾಮ್ ಸೂಡೂನ್ ಪರಾತ್ಲಿತ ಮನ್ಹುನ್ ಸಮಜು಼ನ್ ಮನ್ ಪರ್ತುನ್ ತ್ಯನಾ ಕರ್ತೊ ಮನಲ್ಯಾಲಾ ನಾಸ್ ಕರಾಚೆ ಆಂದಿ ಥಾಂಬಲ್.<verse eid="JON 3:10" /></para>
  <chapter eid="JON 3" />
  <chapter number="4" style="c" sid="JON 4" />
  <para style="s">ಯೊನಾಚಾ಼ ರಾಗ್ ಆನಿ ದೆವಾಚಿ ಮಾಯಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 4:1" />ಹ್ಯಚಿಸ್ ಲಾಗುನ್ ಯೊನಾಲಾ ಖುಬ್ ಬೆಜಾರ್ ಆನಿ ರಾಗ್ ಎತೊ <verse eid="JON 4:1" /><verse number="2" style="v" sid="JON 4:2" />ಓ ದೆವಾ “ಪರಮೆಸ್ವರಾ ಐಕ್ ಮೀ ಮಾಜೆ ದೆಶೆತ್ ಅಸ್ತಾನಾ ಮನಾ ಸಮಾಜ್ಲಹುತ್ತ. ತು ದಯ್ಯಾ, ಕನಿಕರಾ, ಮಾಯಾ, ಲ ಶಾಂತಿ, ಲ ಕೃಪಾ ಆಸಲ್ಯಾಲಾ ದೆವ್. ಕರಾವ ಮನಲ್ಯಾಲಾ ನಾಸ್. ಮನ್ ಪರ್ತುನ್ ಕರ್ನಾರನಾಹಿ ಮನ್ಹುನ್ ಸಮಜು಼ನ್ ತಾರ್ಶಿಶ್ಲಾ ಪಳುನ್ ಜಾ಼ಯಿತೊ. <verse eid="JON 4:2" /><verse number="3" style="v" sid="JON 4:3" />“ಅತಾ ಪರಮೆಸ್ವರಾ ಮಾಜಾ಼ ಜೀವ್ ಕ್ಯಾಡ್ ಮೀ ಜ಼ಗಾಚೆ ವಾಟ್ನಿಸ್ ಮೆಲ್ಯಾಲಬರ” ಮನ್ಲಾ.<verse eid="JON 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JON 4:4" />ತವಾ ಪರಮೆಸ್ವರ ಮಂಥೊ “ತು ರಾಗ್ ಕರಾಚಾ಼ ಬರಾಕ್ಯಾ?” ಮನ್ಲಾ.<verse eid="JON 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JON 4:5" />ನಂತರ್ ಯೊನ್ ಶೆರಾಚೆ ಉಗಾವ್ತೆ ಬಾಜು಼ಕ್ಡ ಯಾಕ್ ಖೊಪಾಟ್ ಗಾಲುನ್ ತ್ಯ ಶಾರ್ ಕ್ಯಾ ವ್ಹತ್ಯಾ ಮನ್ಹುನ್ ಬಗಾಯಾ ಬಸ್ಲಾ. <verse eid="JON 4:5" /><verse number="6" style="v" sid="JON 4:6" />ತವಾ ಪರಮೆಸ್ವರಾನಿ ಯೊನಾಚಾ ಖೊಪ್ಟಾವರ್ ಯೊಕ್ ಯೊಲ್ ಗ್ಯಾತ್ಲಾ ತ್ಯೊ ಇರ್ಡುನ್ ತ್ಯಚಾ ಖೊಪ್ಟಾವ ಸಾವಲ್ ಪಡ್ಲಿ. ತೀ ಸಾವಲ್ ಯೊನಾಚಾ ತೊಂಡಾವ ಪಡ್ಲಿ. ಹ್ಯನಿ ಯೊನಾಲಾ ಖುಬ್ ಸಂತೊಸ್ ಜಾ಼ಲ್ಹ <verse eid="JON 4:6" /><verse number="7" style="v" sid="JON 4:7" />ದುಸ್ರೇದಿಶಿ ಸಖಾಳಚ಼ ಪರಮೆಸ್ವರಾನಿ ಯಕಾ ಕೀಡ್ಯಾಲಾ ಯಲಾಲಾ ಚಾ಼ವಾಲಾ ನೆಮ್ಲಾ. ಜಾ಼ವುನ್ ತ್ಯಾ ಕೀಡ್ಯಾನಿ ಯಲಾಲಾ ಚಾವ್ಲಾ ತ್ಯೊ ಯೊಲ್ ವಾಳ್ಳಾ. <verse eid="JON 4:7" /><verse number="8" style="v" sid="JON 4:8" />ದಿಸ್ ಉಗ್ವುನ್ ವರ ಯತಾನಾ ಉಗಾವ್ತೆ ಬಾಜೊ಼ಕ್ನಿ ಪರಮೆಸ್ವರಾನಿ ಊನ್ ವಾರ ಶೊಡ್ಲ. ತ್ಯ ಯೊನಾಚೆ ಡೂಯಿವ ಪಡ್ಲ. ತವಾ ಯೊನಾಲಾ ಬವಂಡ್ ಎವುನ್ ಮನಾ ಮರಾನ್ದೆ ಆನಿ “ಮೀ ಜ಼ಗಾಚೆವಾಟ್ನಿಸ್ ಮೆಲ್ಯಾವ ಬರ” ಮನ್ಹುನ್ ದೆವಾಪ ಮಂತ್ತೋ.<verse eid="JON 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 4:9" />ತವಾ “ಪರಮೆಸ್ವರ್ ಯೊನಾಲಾ ತು ರಾಗ್ ಕರಾಚ಼ ಬರಾಕ್ಯಾ?”. ಮನ್ಹುನ್ ಇಚಾರ್ತೊ.ತವಾ ಯೊನಾ ವ್ಹಯ್ ಮಿ ಮರ‍ಯವ್ಡಾ ರಾಗ್ ಕರಾಚ಼ ಬರ!” ಮನ್ಲಾ<verse eid="JON 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 4:10" />ಪರಮೆಸ್ವರ್ ಮಂತೊ ತು. “ತೆ ಯಲಿಸಾಟಿ ಕ್ಯಾ ಕೆಲಸ್ ತ್ಯಚಿ ಮೆನ್ಹತ್ ಕಿಲಿಸ್, ತ್ಯಲಾ ಬಾಳಗ್ಲಾ ನಾಹಿಸ್; ತ್ಯೊ ಎಕ್ ರಾತಿತ್ ಉಗ್ವುನ್ ಎಕ್ ರಾತಿತ ಮೆಲಾ. ತೆ ಯಲಿ ಸಾಟಿ ಯವ್ಡಿ ಕ್ಯಾಳಜಿ ಕಾ? <verse eid="JON 4:10" /><verse number="11" style="v" sid="JON 4:11" />ತಿ ಕರತ್ಯಾಲಿ ಚು಼ಕ್ ತ್ಯನಾ ಸಮಜ಼ತ್ನಸಲ್ಯಾಲಿ ಎಕ್ ಲಾಕ್ ಇಸ್ ಹಜಾ಼ರ್, ಮಾನ್ಸ ಆನಿ ಜ಼ನಾವರ ಆಸಲ್ಯಾಲ ಮೊಟ ಶಾರ್, ನಿನವೆವ ಮೀ ದಯಾ ದಾವು ನಾಹಿ ಕ್ಯಾ!” ಮನ್ಲಾ.<verse eid="JON 4:11" /></para>
  <chapter eid="JON 4" />
</usx>