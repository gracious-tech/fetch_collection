<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="AMO" style="id">- Gowli</book>
  <para style="h">ಆಮೊಸ್</para>
  <para style="toc1">ಆಮೊಸ್ ಪ್ರವನಾಚ಼ ಪುಸ್ತಕ್</para>
  <para style="toc2">ಆಮೊಸ್</para>
  <para style="toc3">ಆಮೊ</para>
  <para style="mt2">ಆಮೊಸಾನಿ ಲಿವಲ್ಯಾಲ ಪುಸ್ತಕ್</para>
  <para style="mt1">ಆಮೊಸಾನಿ ಲಿವಲ್ಯಾಲ ಪುಸ್ತಕ್</para>
  <para style="imt">ವಳಕ್</para>
  <para style="ip">ಹ್ಯಾ ಪುಸ್ತಕಾತ್ ಆಮೊಸ್ ಪ್ರವಾದಿಚ಼ ಸಂದೆಸ್ ಹಾತ. ಆಮೊಸ್ ಮೆಂಡಕಾರ್ (<char style="xt"><ref loc="AMO 1:1">1:1</ref></char>) ಆನಿ ಶೆತ್ಕರಿ ಹುತ್ತಾ (<char style="xt"><ref loc="AMO 7:14">7:14</ref></char>). ದೆವಾನಿ ತ್ಯಲಾ ಆಪಲಾ ಪ್ರವಾದಿ ಕರುನ್ ಗೆತ್ಲಾ. ಆಮೊಸ್ ದಕ್ಶಿನ್ ರಾಜಾಚಾ ಯಹುದಾತಲ್ಯಾ ತೆಕೊವಿತ್ಲಾ, ಫನ್ ತ್ಯಚ಼ ಖುಬ್ ಸಂದೆಸ್ ಮಾವಾಳತ್ಯಾ ರಾಜಾಚಾ ಇಸ್ರಾಯೆಲಾನಾ ತ್ಯವ್ಡಸ್ ಹಾತ. ಆಮೊಸ್, ಹ್ಯ ಸುಮಾರ್ ಕ್ರಿ.ಪೂ. ಸಾತ್ಚೆ ಪನ್ನಾಸಾಚಾ ಕಾಲಾತ್ ಜಾ಼ಲ್ಹ.</para>
  <para style="ip">ಆಮೊಸ್ ಪಯಲ್ಯಾ ದೊನ್ ಆದ್ಯಾಯಾತ್ನಿ ಖುಬ್ ದೆಸೆತ್ನಾ ದೆವಾಚ಼ ನಿಯತಾಚ಼ ಇಚಾರ್ ಸಾಂಗ್ತೊ, ಫನ್ ತ್ಯಚ಼ ಖುಬ್ ಸಂದೆಸ್ ಇಸ್ರಾಯಲಾಂಚೆ ಸಾಟಿ ಹುತ್ತ. ಹ್ಯಾ ಕಾಲಾತ್ ಇಸ್ರಾಯೆಲ್ ಖುಬ್ ಪೈಶಾನಿ ಸಾವ್ಕರ್ಕಿನಿ ಬರಲ್ಯಾಲಿ ಹುತ್ತಿ. ತ್ಯಾ ಸಾವ್ಕರಕಿಚಾ ಕಾಲಾತ್ ತಿ ದೆವಾಲಾ ಇಸಾರ್ಲಿತ. ಆನಿ ಗರಿಬಾನಾ ಲ ತರಾಸ್ ದಿಯಿತಿತ (<char style="xt"><ref loc="AMO 2:6">2:6</ref></char>).ತ್ಯನಾ ಗುಲಾಮ್ಗಿರಿತ್ ಗಾಲಾಚಾ಼ ದೆವಾಚಾ಼ ಜ಼ಡ್ತಿಚಾ಼ ಇಚಾರ್ ಹುತ್ತಾ (<char style="xt"><ref loc="AMO 7:17">7:17</ref></char>). ಫನ್ ದೆವಾನಿ ಇಸ್ರಾಯೆಲಾ ತಲ್ಯಾನಾ ಮಾಗಾರಿ ಪರ್ತುನ್, ತ್ಯಂಚಾನಿ ಪೈಯಲ್ಯಾ ಶಾರ್ಕ ಉರಲ್ಯಾಲ್ಯಾ ಸಗಳ್ಯಾ ದೆಸೆತ್ನಾ ಮಾಗಸಾರಿ ಶಾರ್ಕಾ ಬರೊಸಾ ದಿಲಾ (<char style="xt"><ref loc="AMO 9:12">9:12</ref></char>).</para>
  <para style="iot">ರುಪರೆಖಾ</para>
  <para style="io1">ಆಮೊಸ್ತಾಚಿ ವಳಕ್ ಕರುಂದೆತೊ (<char style="ior"><ref loc="AMO 1:1">1:1</ref></char>).</para>
  <para style="io1">ತ್ಯಾ ನಂತರ್ 1 ಆನಿ 2 ಆದ್ಯಾಯಾತ್ನಿ, ಖುಬ್ ಲೊಕಾಂಚೆ ವರ್ ನಿಯತಿಚ಼ ಇಚಾರ್ ದಾವುಂದೆತೊ.</para>
  <para style="io1">ಆದ್ಯಾಯ 3 ದರ್ನಿ <char style="ior"><ref loc="AMO 9:11">9:11</ref></char> ಚೆಆತ್ ಇಸ್ರಾಯೆಲಾಂಚೆವರ್ ಜ಼ಡ್ತಿ ಆನಿ ಕ್ಯೊಂಡಲ್ಯಾಲ್ಯಾಚ ಇಚಾರ್ ಸಾಂಗ್ತೊ.</para>
  <para style="io1">ಸರ್ತಾನಾ, ಆದ್ಯಾಯ <char style="ior"><ref loc="AMO 9:12-15">9:12-15</ref> </char>ಪರ‍್ಯಾತ್ ದೆವ್ ಉರಲ್ಯಾಲ್ಯಾ ಲೊಕಾನಾ ಮಾಗಾರಾ ಪರತ್ತೊ ಮನ್ಹುನ್ ಬರೊಸಾ ದೆತೊ.</para>
  <chapter number="1" style="c" sid="AMO 1" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1" />ಜೂ಼ದಾಯಾತ್ ಮೊಟ ಭುಕಂಪ್ ವ್ಹಯಾಚೆ ದೊನ್ ವರ್ಸ ಆಂದಿ, ತೆಕೊವಾತಲ್ಯಾ ಕುರ್ಬುರಾತಲ್ಯಾ ಯಕಾ ಆಮೊಸಾಲಾ ಇಸ್ರಾಯೆಲ್ಚೆ ಗುಸ್ಟಿತ್ ದೆವಾಪ್ನಿ ಆಲ್ಯಾಲಿ ಹಿ ದರ್ಶಾನ. ತವಾ ಯುದಾಯ್ ಸಿಮಾ ಉಜ್ಜಿಯಾ ಮಂತ್ಯಾಲಾ ರಾಜಾ಼ ಆಳ್ವಿಕೆ ಕರತ್ಯಾಲ ಕಾಲ್. ತಸಸ್ ಯೊಹೊಶಾಚಾ಼ಲ್ಯೊಕ್ ಯೊರೊಬಾಮ್ ಇಸ್ರಾಯೆಲಾತ್ ಆಳ್ವಿಕೆ ಕರತ್ಯಾಲ ಕಾಲ್ ಹುತ್ತಾ.<verse eid="AMO 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="AMO 1:2" />ಆಮೊಸಾನಿ ಸಾಂಗಲ್ಯಾಲ;</para>
  <para style="b" vid="AMO 1:2" />
  <para style="q1" vid="AMO 1:2">ಗರಾಜ಼ತ್ಯೊ ಪರಮೆಸ್ವರ್</para>
  <para style="q2" vid="AMO 1:2">ಚಿಯೊನಿತ್ನಿ ಆರ್ಬಾಟ್ ಕರ್ತ್ಯೊ ಯೆರುಸಲೆಮಿತ್ನಿ;</para>
  <para style="q1" vid="AMO 1:2">ಬಾವತ್ಯಾತ ಕುರ್ಬುರಾಂಚಿ ರಾನ್ಮಾಳ</para>
  <para style="q2" vid="AMO 1:2">ವಾಳುನ್ಜಾತೊ ಕರ್ಮೆಲ್ ಪರ್ವತಾಚಾ ಮಾತ್ಯಾ.<verse eid="AMO 1:2" /></para>
  <para style="s">ಸಿರಿಯಾ</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 1:3" />ಪರಮೆಸ್ವರ್ ಆಸಾ ಮಂತ್ಯೊ: ದಮಸ್ಕಾತಲ್ಯಾ ಲೊಕಾಂಚಾನಿ ತಿನ್ ಖೆಪಾ ವ್ಹಯ್ ಚಾರ್ ಖೆಪಾ ಕೆಲ್ಯಾಲೆ ಚು಼ಕಿಂಚಿಸಾಟಿ ವ್ಹಯಾವ್ಹಯಿ ಜಾ಼ಲ್ಯಾಲಿ ಸಿಕ್ಶಾ ಮೀ ಥಾಂಬಿವ್ನಾರ್ನಾಹಿ. ಲೊಖಾಂಡಾಚಾ ದಾಂಡ್ಯಾನಿ ದಾನ ಮಳ್ಯಾಸಾರ ತ್ಯಂಚಾನಿ ಗಿಲ್ಯಾದ್ ಲೊಕಾನಾ ಬಡಿವಲ್ಯಾತ. <verse eid="AMO 1:3" /><verse number="4" style="v" sid="AMO 1:4" />ಮಿ ಹಜಾಲಾಚಾ ಗರ‍್ಹಾಲಾ ಆಗ್ ಲಾವ್ನಾರ್. ತಿ ಬೆನ್ಹದಾಚಾ ಬಂಗ್ಲ ನಾಸ್ಕರ್ನಾರ್ <verse eid="AMO 1:4" /><verse number="5" style="v" sid="AMO 1:5" />ದಮಸ್ಕಾಚಿ ಪ್ರವೆಸ್ದಾರ ಮ್ಯೊಡ್ನಾರ್. ಆವೆನಿಚೆ ಖನಿತ್ ಸಿಂಹಾಸನಾವ ಬಸಲ್ಯಾಲ್ಯಾಲಾ ಆನಿ ಬೆತ್ ಏದೆನಿತ್ನಿ ಆಡಳಿತ್ ಆದಿಕಾರ‍್ಯಾಲಾ ನಿರ್ನಾಮ್ ಕರ್ನಾರ್. ಸಿರಿಯಾಚಾ ಲೊಕಾನಾ.” ಹ್ಯೊ ಪರಮೆಸ್ವರ್ ದೆವಾಚಾ಼ ಸಬ್ದ.<verse eid="AMO 1:5" /></para>
  <para style="s">ಪಿಲಿಸ್ಟಿಚಿ</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 1:6" />ಪರಮೆಸ್ವರ್ ಆಸಾ ಮಂತ್ಯೊ: “ಗಾಜಾತಲ್ಯಾ ಲೊಕಾಂಚಾನಿ ತಿನ್ ಖೆಪಾ ವ್ಹಯ್ ಚಾರ್ ಖೆಪಾ ಕೆಲ್ಯಾಲ್ಯಾ ದ್ರೊಹಾನಾ ತ್ಯನಾ ವ್ಹಯಾವ್ಹಯಿತಿ ಸಿಕ್ಶೆ ಮಿ ಥಾಂಬಿವ್ನಾರ್ನಾಹಿ, ತ್ಯಂಚಾನಿ ಸರವ್ಯಾ ಲೊಕಾನಾ ಕುಂಡುನ್ ಎದೊಮ್ ಸಿಮತ್ನಿ ಗಡಿಪಾರ್ ಕೆಲ್ಯಾತ. <verse eid="AMO 1:6" /><verse number="7" style="v" sid="AMO 1:7" />ಮನ್ಹೂನ್ ಮಿ ಗಾಜಾಚೆ ಕೊಟೆಲಾ ಆಗ್ ಲ್ಯಾವ್ನಾರ್. ತಿ ತ್ಯಚಾ ಕೊಟೆ ಸಗಳ್ಯಾ ನಾಸ್ಕರ್ನಾರ್. <verse eid="AMO 1:7" /><verse number="8" style="v" sid="AMO 1:8" />ಮಿ ಅಶ್ಡೊದಿಸಾತ್ ಸಿಂಹಾಸನಾವ ಆಸಲ್ಯಾಲ್ಯಾಲಾ ಅಶ್ಕೆಲೊನಿತ್ ಆಡಳಿತ ಅದಿಕಾರ‍್ಯಾಲಾ ನಿರ್ನಾಮಾ ಕರ್ನಾರ್. ಎಕ್ರೊನಿಚೆ ಪೆಠನಾ ಹಾತ್ ಉಚ಼ಲ್ನಾರ್. ಫಿಲಿಶ್ಟಾತ್ಲಿ ಥುಡಿಮುಡಿ ರಾಯಲ್ಯಾಲಿ ಸಗ್ಳಿ ನಾಸ್ವನಾರ್,” ಹ್ಯೊ ಪರಮೆಸ್ವರ್ ದೆವಾಚಾ಼ ಸಬ್ದ.”<verse eid="AMO 1:8" /></para>
  <para style="s">ಥೈರಾ</para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 1:9" />ಪರಮೆಸ್ವರ್ ಆಸಾ ಮಂತ್ಯೊ: “ಥೈರಾತಲ್ಯಾ ಲೊಕಾಂಚಾನಿ ತಿನ್ ಖೆಪಾ ವ್ಹಯ್ ಚಾರ್ ಖೆಪಾ ಕೆಲ್ಯಾಲ್ಯಾ ದ್ರೊಹಾನಾ ತ್ಯನಾ ವ್ಹಯಾವ್ಹಯಿತಿ ಸಿಕ್ಶೆ ಮಿ ಥಾಂಬಿವ್ನಾರ್ನಾಹಿ. ಬಾವ್ಹಾಚೆ ಮಾಯೆಚಿ ಶಪ್ಪತ್ ತಿ ಇಸಾರ್ಲಿತ. ತ್ಯಂಚಾನಿ ಸರವ್ಯಾ ಲೊಕಾನಾ ಕುಂಡುನ್ ಎದೊಮ್ ಸಿಮಚಾ ತ್ಯಾಬ್ಯಾತ್ ದಿಲಿತ. <verse eid="AMO 1:9" /><verse number="10" style="v" sid="AMO 1:10" />ಮನ್ಹೂನ್ ಮಿ ಥೈರಾಚೆ ಕೊಟೆಲಾ ಆಗ್ ಗ್ಯಾಲ್ನಾರ್. ತಿ ತ್ಯಚಾ ಕೊಟೆ ಸಗಳ್ಯಾ ನಾಸ್ಕರ್ನಾರ್.”<verse eid="AMO 1:10" /></para>
  <para style="s">ಎದೊಮಾ</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 1:11" />ಪರಮೆಸ್ವರ್ ಆಸಾ ಮಂತ್ಯೊ: “ಎದೊಮಾತಲ್ಯಾ ಲೊಕಾಂಚಾನಿ ತಿನ್ ಖೆಪಾ ವ್ಹಯ್ ಚಾರ್ ಖೆಪಾ ಕೆಲ್ಯಾಲ್ಯಾ ದ್ರೊಹಾನಾ ತ್ಯನಾ ವ್ಹಯಾವ್ಹಯಿತಿ ಸಿಕ್ಶೆ ಮಿ ಥಾಂಬಿವ್ನಾರ್ನಾಹಿ. ತ್ಯಂಚಾನಿ ಆಪ್ಲ ಬಾಹು ಜಾ಼ಲ್ಯಾಲ್ಯಾ ಇಸ್ರಾಯೆಲಾನಾ ತಲ್ವಾರ ದಾವುನ್ ಪಳವುನ್ ಗ್ಯಾತ್ಲ. ತ್ಯಂಚಿವ ಕರ್ನಾನಸ್ತಾನಾ, ಸರ್ತೆ ಯಳಪರ‍್ಯಾತ್ ರಾಗುಸ್ ಶಾದ್ಲಾ. <verse eid="AMO 1:11" /><verse number="12" style="v" sid="AMO 1:12" />ಮನ್ಹೂನ್ ಮಿ ತೇಮಾನ್ ಪೆಠಲಾ ಆಗ್ ಲ್ಯಾವ್ನಾರ್. ತಿ ಬೊಚ್ರಾಚಾ ಕೊಟೆ ಸಗಳ್ಯಾ ನಾಸ್ಕರ್ನಾರ್.<verse eid="AMO 1:12" /></para>
  <para style="s">ಆಮೊನ್</para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 1:13" />ಪರಮೆಸ್ವರ್ ಆಸಾ ಮಂತ್ಯೊ: “ಅಮೊನ್ಯಾಂಚಾನಿ ತಿನ್ ಖೆಪಾ ವ್ಹಯ್ ಚಾರ್ ಖೆಪಾ ಕೆಲ್ಯಾಲ್ಯಾ ಪಾಪಾಲಾ ತ್ಯನಾ ವ್ಹಯಾವ್ಹಯಿತಿ ಸಿಕ್ಶೆ ಮಿ ಥಾಂಬಿವ್ನಾರ್ನಾಹಿ. ಗಿಲ್ಯಾತಲ್ಯಾಂಚಾನಿ ಆಪ್ಲಿ ಥಳ ವಿಸ್ತರನ್ ಕರಾಯಾ ಗರ್ವಾರ್ಕರ್ನಿಂಚಿ ಪೊಟ ಫಾಳಿತ. <verse eid="AMO 1:13" /><verse number="14" style="v" sid="AMO 1:14" />ಮನ್ಹೂನ್ ಮಿ ರಬ್ಬಾಚೆ ಕೊಟೆಲಾ ಆಗ್ ಲ್ಯಾವ್ನಾರ್. ತಿ ತ್ಯಚಾ ಕೊಟೆ ಸಗಳ್ಯಾ ನಾಸ್ಕರ್ನಾರ್. ತವಾ ಲಡಾಯಿಚ಼ ಆರ್ಬಾಟ್ ವಾವ್ಡಳಿಚೆಗತ್ ಲಡಾಯಿ ಸುರು ವ್ಹನಾರ್ <verse eid="AMO 1:14" /><verse number="15" style="v" sid="AMO 1:15" />ರಾಜಾಲಾ ಆನಿ ರಾಜಾಚಾ಼ ಆದಿಕಾರ‍್ಯಾನಾ ಯಂಗ್ದಾಸ್ ಕ್ಯೊಂಡ್ನಾರ್.” ಹ್ಯೊ ಪರಮೆಸ್ವರ್ ದೆವಾಚಾ಼ ಸಬ್ದ.<verse eid="AMO 1:15" /></para>
  <chapter eid="AMO 1" />
  <chapter number="2" style="c" sid="AMO 2" />
  <para style="s">ಮೊವಾಬ್</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 2:1" />ಪರಮೆಸ್ವರ್ ಆಸಾ ಮಂತ್ಯೊ: ಮೊವಾಬ್ಯಾತಲ್ಯಾ ಲೊಕಾಂಚಾನಿ ತಿನ್ ಖೆಪಾ ವ್ಹಯ್ ಚಾರ್ ಖೆಪಾ ಕೆಲ್ಯಾಲೆ ಚು಼ಕಿಂಚಿಸಾಟಿ ವ್ಹಯಾವ್ಹಯಿ ಜಾ಼ಲ್ಯಾಲಿ ಸಿಕ್ಶಾ ಮೀ ಥಾಂಬಿವ್ನಾರ್ನಾಹಿ.ತ್ಯಂಚಾನಿ ಎದೊಮಿಚಾ ರಾಜಾಚಿ ಹಾಡ ಜಾ಼ಳುನ್ ರಾಕ್ ಕೆಲೆ. <verse eid="AMO 2:1" /><verse number="2" style="v" sid="AMO 2:2" />ಮನ್ಹೂನ್ ಮೊವಾಬಿವ ಇಸ್ತು ಗ್ಯಾಲ್ನಾರ್. ತಿ ಕೆರೊಯೊತಿಚಾ ಕೊಟೆ ಸಗಳ್ಯಾ ನಾಸ್ಕರ‍್ನಾರ್. ಸೈನಿಕಾಂಚ಼ ಆರ್ಬಾಟ್, ವರೊಡ್, ನಗಾರಿಚಾ ನಾದಾನಿ ಮೊವಾಬ್ ಮರ್ನಾರ್. <verse eid="AMO 2:2" /><verse number="3" style="v" sid="AMO 2:3" />ಮಿ ತ್ಯಂಚಾ ದನ್ಯಾಲಾ ಮಾರುನ್, ಆದಿಕಾರ‍್ಯಾನಾಬಿ ಮ್ಯಾರ‍್ನಾರ್,” ಹ್ಯೊ ಪರಮೆಸ್ವರ್ ದೆವಾಚಾ಼ ಸಬ್ದ.<verse eid="AMO 2:3" /></para>
  <para style="s">ಜೂದೆಯಾ</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 2:4" />ಪರಮೆಸ್ವರ್ ಆಸಾ ಮಂತ್ಯೊ: “ದಮಸ್ಕಾತಲ್ಯಾ ಲೊಕಾಂಚಾನಿ ತಿನ್ ಖೆಪಾ ವ್ಹಯ್ ಚಾರ್ ಖೆಪಾ ಕೆಲ್ಯಾಲೆ ಚು಼ಕಿಂಚೆಸಾಟಿ ವ್ಹಯಾವ್ಹಯಿ ಜಾ಼ಲ್ಯಾಲಿ ಸಿಕ್ಶಾ ಮೀ ಥಾಂಬಿವ್ನಾರ್ನಾಹಿ. ಕಾ ಮಂಜೆ ಯಹುದ್ಯಾಂಚಾನಿ ಪರಮೆಸ್ವರಾಚಾ಼ ದರ್ಮ ಶಾಸ್ತಾರ್ ಮ್ಯಾನ್ಲನಾಹಿ. ಮಾಜಾ ಆಜ್ಞಾ ಪ್ಯಾಳ್ಯಾನಾಹಿತಾ. ತ್ಯಂಚಾ ವಾಡವಡ್ಲಾಂಚಾನಿ ಪುಜಾಕೆಲ್ಯಾಲ್ಯಾ ಲಬಡ್ಯಾ ದೆವಾಂಚಿ ಪುಜಾಕರಿತ್ ವಾಟ್ ಚು಼ಕಲ್ಯಾತ. <verse eid="AMO 2:4" /><verse number="5" style="v" sid="AMO 2:5" />ಮನ್ಹೂನ್ ಮಿ ಯಹುದ್ಯಾವ ಇಸ್ತು ಗ್ಯಾಲ್ನಾರ್. ತಿ ಯೆರೊಸಲೆಮಿಚಾ ಕೊಟೆ ಸಗಳ್ಯಾ ನಾಸ್ಕರ‍್ನಾರ್."<verse eid="AMO 2:5" /></para>
  <para style="s">ಇಸ್ರಾಯೆಲ್</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 2:6" />ಪರಮೆಸ್ವರ್ ಆಸಾ ಮಂತ್ಯೊ: ಇಸ್ರಾಯೆಲ್ ಲೊಕಾಂಚಾನಿ ತಿನ್ ಖೆಪಾ ವ್ಹಯ್ ಚಾರ ಖೆಪಾ ಕೆಲ್ಯಾಲೆ ಚು಼ಕಿಂಚಿಸಾಟಿ ವ್ಹಯಾವ್ಹಯಿ ಜಾ಼ಲ್ಯಾಲಿ ಸಿಕ್ಶಾ ಮೀ ಥಾಂಬಿವ್ನಾರ‍್ನಾಹಿ. ತಿ ಚಾ಼ಂಗಲ್ಯಾನಾ ಚಾ಼ಂದಿಸಾಟಿ, ಪಾಯಾತಲ್ಯಾ ಯಕಾ ಜೊ಼ಡಾಚ಼ ರಿನ್ ಫೆಡಾಯಾ ವ್ಹಯಿತ್ನಸಲ್ಯಾಲ್ಯಾ ಗರಿಬ್ನಾಚಾ಼ರ‍್ಯಾನಾ ಇಕತ್ಯಾತ. <verse eid="AMO 2:6" /><verse number="7" style="v" sid="AMO 2:7" />ಗರಿಬಾಂಚಾ ಡೊಯಾ ಪಾಂದಿವಲ್ಯಾ ದುಳ್ಯಾಚೆಗತ್ ತುಡಿವತ್ಯಾತ. ದುಖಾತ್ ಆಸಲ್ಯಾಲ್ಯಾನಾ ನ್ಯಾಯಾ ಗಾಹುನಾಹಿಸ ಕರ್ತ್ಯಾತ. ಬಾನಿ ಆನಿ ಲೆಕಾನಿ ಯಕಸ್ ಬ್ಯಾಯ್ಕೊ ಮಾನ್ಸಾಸಂಗ ಶಾರಿರಿಕ್ ಸಂಬದ್ ಥಿವುನ್ ಮಾಜಾ ಪವಿತ್ರ ನಾವಾಲಾ ಬಠಾ ಆಂತ್ಯಾತ. <verse eid="AMO 2:7" /><verse number="8" style="v" sid="AMO 2:8" />ಪರ್ತೆಕ್ ಬಲಿಪಿಟಾಚಾ ಬಾಜು಼ಲಾ ನಿಸತ್ಯಾತ . ಗರಿಬಾಂಚಿಪ್ನಿ ಆಡು ಥಿವುನ್ಗೆತಲ್ಯಾ ದಢೊತಾಂಚಿವ ಬಸತ್ಯಾತ. ಇಲಾಜ಼್ ನಸ್ತಾನಾದಂಡ್ ದಿಯಾ ವ್ಹಯಿ ಜಾ಼ಲ್ಯಾಲ್ಯಾಂಚಿಪ್ನಿ ದರಾಕ್ಶಿಚಾ ರಸ್ ಆನುನ್ ದೆವ್ಳಾತುಸ್ ಪಿತ್ಯಾತ.<verse eid="AMO 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 2:9" />“ಫನ್ ಮಾಜಾ ಲೊಕಾನು, ತುಮ್ಚೆ ಆಡ್ವಿ ಉಬಿರಾಯಲ್ಯಾಲ್ಯಾ ಅಮೊರ‍್ಯಾಂಚಾ಼ ನಾಸ್ಕೆಲಾ. ದೆವ್ದಾರ್ ಜಾ಼ಢಾಚೆಗತ್ ಉಚ಼್ ವ್ಹವುನ್, ಅಲ್ಲೋನ್ ಜಾ಼ಢಾಚೆಗತ್ ಗಟ್ಮುಟ್ ಆಸ್‌ಲ್ಯಾಲ್ಯಾ ತುಮಚಾ ವಾದಿ ಅಮೋರಿಯಾನಾ ನಾಸ್ ಕೆಲಾ. ಜಾ಼ಢಾಚೆ ವೈಲ ಫಳ್ ಆನಿ ಖಾಯ್ಲ ಮೂಳ್ ಕ್ಯಾಡತ್ಯಾಚೆಗತ್ ತ್ಯಂಚಾ಼ ನಿರ್ನಾಮಾ ಕರ್ನಾರ್. <verse eid="AMO 2:9" /><verse number="10" style="v" sid="AMO 2:10" />ಮಿಸ್ ತುಮಾನಾ ಈಜಿಪ್ಟಾತ್ನಿ ಬಾಹಿರ್ ಆನಲ್ಯಾಲಿ . ಚಾಳಿಸ್ ವರ್ಸಾಪರ‍್ಯಾತ್ ರಾನಾತ್ಲೆ ವಾಟನಿ ತುಮಾನಾ ಚಾ಼ಲವುನ್ ಆನಲ್ಯಾಲ, ಆಮೊರಿಯಂಚಾ಼ ಪರದೆಶ್ ತುಮಾನಾ ದಿಲ್ಯಾಲಾ, <verse eid="AMO 2:10" /><verse number="11" style="v" sid="AMO 2:11" />ತುಮ್ಚಾ ಪ್ಯೊರಗ್ಯಾತಲ್ಯಾ ಥೊಡ್ಯಾನಾ ಪ್ರವಾದಿ, ತುಮ್ಚಾ ತರನ್ಯಾ ಪ್ಯೊರಗ್ಯಾತಲ್ಯಾ ಥೊಡ್ಯಾನಾ ಗೌರವಾನ್ವಿತ್ ಕೆಲ್ಯಾಲ ಮಿಸ್. ಇಸ್ರಾಯೆಲ್ ಲೊಕಾನು, ಹ್ಯ ಖರನವ್ಹ ಕ್ಯಾ? ತುಮಿಸ್ ಸಾಂಗಾ. <verse eid="AMO 2:11" /><verse number="12" style="v" sid="AMO 2:12" />ತುಮಿತರಿ, ಗೌರವಾನ್ವಿತಲ್ಯಾನಾ ದಾರು ಪಿಯಿಸಾರ ಕೆಲಸಾ. ಪ್ರವಾದಿಂಚಾನಿ ಪ್ರವಾದನ್ಯಾ ಸಾಂಗಾಚಾನಾಹಿತಾ ಮನ್ಹುನ್ ಆಜ್ಞಾಕಿಲಿಸಾ. <verse eid="AMO 2:12" /><verse number="13" style="v" sid="AMO 2:13" />ಬಗ್ ದಾನ್ಯಾನಿ ಬರಲ್ಯಾಲಿ ಗಾಡಿ ಲಪಲ್ಯಾಸಾರಿ ತುಮಾನಾ ಹಾಸಾ ತಿಥಸ್ ದಡಪ್ನಾರ್. <verse eid="AMO 2:13" /><verse number="14" style="v" sid="AMO 2:14" />ಮೊಟಾ ಧಿರ್ ಆಸಲ್ಯಾಲಾ ತುಮ್ಚಾತ್ ಜೊ಼ರಾನಿ ಪಳತ್ಯಾಲಾಬಿ ಚು಼ಕ್ನಾರ‍್ನಾಹಿ. ಬಳ್ ಆಸಲ್ಯಾಲ್ಯಾಚ಼ ಬಳ್ ನಾಹಿವ್ಹನಾರ್. ಜಿವ್ ಉರ‍್ವಾಯಾ ವ್ಹನಾರ‍್ನಾಹಿ. <verse eid="AMO 2:14" /><verse number="15" style="v" sid="AMO 2:15" />ಬಾನ್ ದರಲ್ಯಾಲಾಬಿ ಥಾಂಬ್ನಾರ‍್ನಾಹಿ. ಪಳತ್ಯಾಲಾ ಸಾಪಾಡ್ನಾರ್. ಗೊಡಾ ಚಾ಼ಲಿವ್ನಾರಾ ಜಿತ್ತಾ ರಾನ್ಹಾರ‍್ನಾಹಿ. <verse eid="AMO 2:15" /><verse number="16" style="v" sid="AMO 2:16" />ಖುಬ್ ಧಿರ ಆಸಲ್ಯಾಲ್ಯಾತ್ ಮೊಟಾ ಧಿರ್ ಆಸಲ್ಯಾಲಾ ನಾಗಡ್ಯಾನಿಸ್ ಪಳುನ ಜಾ಼ನಾರ್.”ಹ್ಯೊ ಪರಮೆಸ್ವರಾಚಾ಼ ಸಬ್ದ.<verse eid="AMO 2:16" /></para>
  <chapter eid="AMO 2" />
  <chapter number="3" style="c" sid="AMO 3" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1" />ಇಸ್ರಾಯಲಾಂಚಾ ಲೊಕಾನು, ಕಾನ್ದೆವಾ. ಈಜಿಪ್ಟ್ ದೆಶತ್ನಿ ತುಮಾನಾ ಸುಡ್ವುನ್ ಆನಲ್ಯಾಲಾ ಪರಮೆಸ್ವರ್ ತುಮ್ಚೆ ಅಡ್ವಾ ಸಾಂಗತ್ಯಾಲ ಸಬ್ದ ಐಕಾ: <verse eid="AMO 3:1" /><verse number="2" style="v" sid="AMO 3:2" />“ದುನೆವಲ್ಯಾ ಲೊಕಾತ್ನಿ ಮನಾ ವ್ಹಯಿಜಾ಼ಲ್ಯಾಲಿ ಮಂಜೆ ತುಮಿ. ತ್ಯಚಾಕಾರ್ನಾತ್ ತುಮಿ ಕೆಲ್ಯಾಲ್ಯಾ ಸಗಳ್ಯಾ ಪಾಪಾನಾ ಶಿಕ್ಶೆ ವ್ಹಯಿಶಾರ್ಕ ಕರ್ನಾರ್.”<verse eid="AMO 3:2" /></para>
  <para style="s">ಪ್ರವಾದಿಚ಼ ಕಾಮ್</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 3:3" />ಠಾವನಸಲ್ಯಾಲ ಕೊಂತರಿದೊಗ ಸಂಗನಿ ಜಾ಼ಯಾವ್ಹಯಿಲಕ್ಯಾ?<verse eid="AMO 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 3:4" />ಶಿಕಾರಿ ದಿಸಾಚೆಆಂದಿ ಸಿವ್ ರಾನಾತ್ ವರಾಡ್ತೊಕ್ಯಾ?</para>
  <para style="p" vid="AMO 3:4">ಕಾಯ್ ದರಾಚೆಆಂದಿ ತರ್ನಾಸಿವ್ ಗಬಿತ್ ಗುರ್ಗುರಲಕ್ಯಾ?<verse eid="AMO 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="AMO 3:5" />ದಾನನಸ್ತಾನಾ ಪಾಖುರ್ ಬಲ್ಯಾತ್ ಪಡಲ್ ಕ್ಯಾ?</para>
  <para style="p" vid="AMO 3:5">ಕಾಯ್ ಆಡ್ಕನಸ್ತಾನ ಪಿಂಜ್ರಾ಼ ವರ್ ಜಾ಼ಯಿಲ್ ಕ್ಯಾ?<verse eid="AMO 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 3:6" />ನಗಾರಿ ವಾಜಿವಲ್ಯಾವ ಲೊಕ ಬಿಹ್ಯಾಚೆ ಆಂದಿ ರಾತಿಲ ಕ್ಯಾ?</para>
  <para style="p" vid="AMO 3:6">ಪರಮೆಸ್ವರಾಪ್ನಿ ಶೆರಾತ್ ವಾಯಿಟ್ ವ್ಹಯಿಲ್ ಕ್ಯಾ?<verse eid="AMO 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 3:7" />ಆಪಲಾ ಪರಚಾರ್ಕರತ್ಯಾಲ್ಯಾ ಪ್ರವಾದಿ ಆಪಲಾ ಉದ್ದೆಸ್ ಸಾಂಗಾಚೆ ಆಂದಿ ಪರಮೆಸ್ವರ ದೆವ್ ಕಾಯ್ ಕರಿತ್ನಾಹಿ.<verse eid="AMO 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 3:8" />ಸಿವ್ ಗುರ್ಗುರತ್ಯಾಲ್ಯಾ ಐಕುನ್ ಬಿಹಿತ್ನಸಲ್ಯಾಲಾ ಕೊನ್? ದೆವ್ ಪರಮೆಸ್ವರಾಚ಼ ಬೊಲ್ನ ಐಕುನ್ ಸಾಂಗಚೆಆಂದಿ ರಾಹ್ಯಾಚಾ಼ ಕೊನ್?<verse eid="AMO 3:8" /></para>
  <para style="s">ಸಮಾರ‍್ಯಾಚಾ಼ ನಾಸ್</para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 3:9" />ಅಷ್ಡೋದಿಸಿ ಕೊಟ್ಯಾತ್ನಿಬಿ ಇಜಿಪ್ಟಿತಲ್ಯಾ ಕೊಟ್ಯಾತ್ನಿಬಿ ಆಸಮನ್ಹುನ್ ಸಾಂಗಾ; “ಸಮಾರ‍್ಯಾಚಾ ಗುಢ್ಯಾವ್ನಿ ಮಿಳುನ್ಯವಾ. ಶೆರಾತ್ನಿ ಕಿತಿಕಿ ಗೊಂದೊಳ್, ಕಿತಿಕಿ ಕ್ರುರಿಫನ್ ಚಾ಼ಲತ್ಯಾಲಿ, ಬಗಾ.”<verse eid="AMO 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 3:10" />ಲೊಕಾನಾ ನಿಯೆತ್ ಧರ್ಮ ಸಮಜ಼ತ್ನಾಹಿ, “ಹ್ಯ ಪರಮೆಸ್ವರಾಚಾ಼ ಸಬ್ದ. “ಕ್ರುರಿಫನಾನಿ ಆನಿ ಲುಟ್ಯಾವುನ್ ಕಮಿವಲ್ಯಾಲ ಲೊಕಾಂಚಾನಿ ಆಪಲ್ಯಾ ಗುಡಾನಾತ್ನಿ ಬರುನ್ತೆವಲ್ಯಾ. <verse eid="AMO 3:10" /><verse number="11" style="v" sid="AMO 3:11" />ಆಸಮನ್ಹುನ್ ದೆವ್ ಪರಮೆಸ್ವರ್ ಸಾಂಗತೊ ಕ್ಯಾ ಮಂಜೆ: “ವಾದಿ ತುಮ್ಚಾ ಕೊಟ್ಯಾಚಾ಼ ಎಡಾ ಗ್ಯಾಲ್ನಾರ್. ತುಮ್ಚಾ ಕೊಟ್ಯಾಸಗಳ್ಯಾ ದುರ್ದೆಸ್ನಾಕರ್ನಾರ್.ತುಮ್ಚ ಮೊಟಬಂಗಲ ಲುಟ್ಯಾರ್ನಾರ್.”<verse eid="AMO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 3:12" />ದೆವ್ ಪರಮೆಸ್ವರ ಆಸಮಂಥೊ: “ಸಿವಾಚಾ ತೊಂಡಾತ್ ಗಾವಲ್ಯಾಲ್ಯಾ ಬಕರ‍್ಯಾಚಾ ಬಾಘಾತ್ಲ ಕಾನ್‌ಪ್ಯಾ ತೆವ್ಡಸ್ ಕರುಬುರಾಲಾ ಗಾವ್ಲ. ತಸಸ್ ಸಮಾರ‍್ಯಾಚಾ ಹಾತ್ರುನಾಚಾ ಕೊನ್ಯಾಯವ್ಡಾ ಮಂಚಾವ ಆರಾಮಾನಿ ವಡ್ಗುನ್ ರಾಯ್‌ಲ್ಯಾಲಿ ಇಸ್ರಾಯಲಾಂಚಾತ್ ಥುಡಿಸ್ ಥುಡಿ ತೆವ್ಡಿಸ್ ಉರ್ನಾರ್. <verse eid="AMO 3:12" /><verse number="13" style="v" sid="AMO 3:13" />ಸರವ್ಯಾಚಾ಼ ದೆವ್ ಪರಮೆಸ್ವರ ಆಸಾ ಸಾಂಗ್ತೊ,” ಯಕೊಬಾಚಾ ವಂಶಾತಲ್ಯಾನಾ ಖಡ್ಯಾವುನ್ ಸಾಂಗಾ: <verse eid="AMO 3:13" /><verse number="14" style="v" sid="AMO 3:14" />ಇಸ್ರಾಯಲಾಂಚಾ ಪಾಪಕ್ರುರಿಫನಾನಾ ತ್ಯನಾ ಶಿಕ್ಶೆದೆನಾರ್. ಬೇತೇಲೆತಲ್ಯಾ ಯಜ್ಞವೆದಿನಾ ತುಕ್ಡತುಕ್ಡ ಕರ್ನಾರ್.ತ್ಯಾ ಯಜ್ಞಾವೆದಿಂಚಿ ಕೊನ್ಯಾವ್ಲಿ ಸಿಂಗ ತುಡುನ್ ಪಾಂದಿವಪಾಡಿಲ್ . <verse eid="AMO 3:14" /><verse number="15" style="v" sid="AMO 3:15" />ಥಂಡಿಚಾ, ಉನ್ಯಾಳಚಾಕಾಲತ್ ಮೂಟಿಘರ‍್ಹ ನಾಸ್‌ಕರ್ನಾರ್. ಹಾತ್ತಿಚಾ ಸುಳ್ಯಾನಿ ನಟಿವಲ್ಯಾಲಿ ಗರ‍್ಹ ದುರ್ದೆಸ್ನಾವ್ಹನಾರ್. ಮೊಟಬಂಗಲ ಜಿಮ್ನಿಶಾರ್ಕ ವ್ಹನಾರ್. ದೆವ್ ಪರಮೆಸ್ವರಾಚಾ಼ ಸಬ್ದ.”<verse eid="AMO 3:15" /></para>
  <chapter eid="AMO 3" />
  <chapter number="4" style="c" sid="AMO 4" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 4:1" />ಸಮಾರ‍್ಯಾಚಾ ಗುಡ್ಯಾವ ಆಸಲ್ಯಾಲ್ಯಾ ಬಾಶಾನಿಚಾ ಗಯಿನು, ಐಕಾ: ತುಮಿ ಬ್ಯಾಯ್ಕಾನು ಗರಿಬಾನಾ ದುಕುವುನ್, ತ್ಯನಾ ದಡ್ಪುನ್, ತುಮ್ಚಾ ದನ್ಗಾರಾನಾ,“ದಾರು ಆನಾ, ಪಿವುಯಾ” ಮನ್ಹುನ್ ಸಾಂಗತ್ಯಾಲ್ಯಾನು ಹ್ಯ ಐಕಾ: <verse eid="AMO 4:1" /><verse number="2" style="v" sid="AMO 4:2" />ದೆವ್ ಪರಮೆಸ್ವರಾನಿ ಆಪಲ್ಯಾ ಪವಿತ್ರಾ ಪಾನಾವ ಶೆಪತ್ ಗಾಲುನ್ ಸಾಂಗಲ್ಯಾ. ಬಕ್, “ತವಾ ತುಮಾನಾ ಬೆಡ್ಯಾಗಾಲುನ್ ವಡುನ್ ನಿಥಿಲ; ತುಮ್ಚಾತ್ಲ ಉರಲ್ಯಾಲ್ಯಾನಾ ಗರಿತ್ ಗಾವಲ್ಯಾಲ್ಯಾ ಮಾಶಾಚೆಗತ್ ವಡುನೆತ್ಯಾಲ ದಿಸ್ ಯತಿಲ. <verse eid="AMO 4:2" /><verse number="3" style="v" sid="AMO 4:3" />ತುಮಿ ಸಗ್ಳಿ ಆಪೊಆಪ್ ಯಕಾ ಮಾಗ ಏಕ್ ಬಿಥಿಚಾ ಕರ್ಕಾ ಬರ್ಬರ್ ಹೆರ್ಮೊನಾಕ್ಡ ರೆಟಾಲಾಗಲ್.” ಹ್ಯ ಪರಮೆಸ್ವರ್ ದೆವಾಚಾ಼ ಸಬ್ದ.”<verse eid="AMO 4:3" /></para>
  <para style="s">ಇಸ್ರಾಯೆಲಾಂಚಿ ಸಿಕ್ತಾನಾ ಹಾರಲ್ಯಾಲಿ</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 4:4" />ಪಾಪ್ ಕರಾವ್ಹಯಿತ, ಬೆತೆಲಿತ್ ಜಾ಼ವುನ್ ಕರಾ. ಗಿಲ್ಗಾಲಿತ್ ಜಾ಼ವುನ್ ವ್ಹಯಿತಸಾ ಮೊಸ್ಕರಾ. ಖಾಯಿಮ್ ಸಖಾಳ್ಚಾ ರಾಕ್ನಾ ದೆವಾ.ತಿನ್ ದಿಸಾತ್ನಿಯಂಗ್ದಾ ಧಾತ್ಲಾ ಯೊಕ್ ಭಾಗ್ ದೆವಾ. <verse eid="AMO 4:4" /><verse number="5" style="v" sid="AMO 4:5" />ಆಂಬಾಟ್ ಪಿಠಾಚಾ ಬಾಕ್ರಿ ಉಪಕಾರ್ ಮನ್ಹಿಶಾರ್ಕ ದೆವಾ. ಮನ್ ಯಯಿಲ್ತಸ ಕಾನಕ್ಯಾ ದಿವುನ್ ಫಿರುನ್ಸಾಂಗಾ. ಒ ಇಸ್ರಾಯಲಾಚಾ ಲೊಕಾನು, ಕರಾಚ಼ ತುಮಾನಾ ವ್ಹಯಿಜಾ಼ಲ್ಯಾಲ!”ಹ್ಯ ಪರಮೆಸ್ವರ ದೆವಾಚಾ಼ ಸಬ್ದ.<verse eid="AMO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 4:6" />"ತುಮ್ಚಾ ಶೆರಾತ್ ಪೊಟಾಲಾ ಪ್ಯೂಟ್ಗಿನಸಶಾರ್ಕ ಕೆಲ್ಯಾಲ ಮಿಸ್. ತುಮಿ ಜಾ಼ಯಿಲ್ತಿಥ ತುಮಾನಾ ಬಾಕ್ರಿ ಗಾವುನಾಹಿಶಾರ್ಕ ಕೆಲ್ಯಾಲ ಮಿಸ್. ಫನ್ ತುಮಿ ಮಾಜಿಪ ಮಾಗಾರಿ ಆಲಾನಾಹಿಸಾ.” ಹ್ಯೊ ಪರಮೆಸ್ವರ ದೆವಾಚಾ಼ ಸಬ್ದ. <verse eid="AMO 4:6" /><verse number="7" style="v" sid="AMO 4:7" />ಮಿ "ಸುಗ್ಗಿಲಾ ತೀನ್ ಮೈನ ಆಸ್ತಾನಾ ಪಾವುಸ್ ಥಾಂಬಿವಲ್ಯಾಲಾ. ಯಕಾ ಗಾವಾತ್ ಪಾವುಸ್ ಲಾಗಶಾರ್ಕಾ ಆನಿ ಯಕಾ ಗಾವಾತ್ ಪಾವುಸ್ ಲಾಗುನಾಹಿ ಶಾರ್ಕಾ ಕೆಲ್ಯಾಲಾ, ಯಕಾ ಶೆತಾತ್ ಪಾವುಸ್ ಲಾಗಶಾರ್ಕಾ, ಆನಿ ಯಕಾ ಶೆತಾತ್ ಪಾವುಸ್ ನಸ್ತಾನಾ ವಾಳುನ್ ಜಾ಼ಯಿಸಾರ ಕೆಲ.<verse eid="AMO 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 4:8" />ತಿನ್ ನಾಹಿತ ಚಾರ್ ಪೆಠಾತ್ನಿ ಪಿಯಾಚಾ ಪಾನ್ಯಾಸಾಟಿ ಫಿರತ್ ಪೇಠತ್ ಗಿಲಿತ ತ್ಯಂಚಿ ತಾನ್ ಗಿಲಿ ನಾಹಿ. ಫನ್ ತುಮಿ ಮಾಜಿಪ ಮಾಗಾರಿ ಆಲಾನಾಹಿಸಾ.” ಮಂಥೊ ಪರಮೆಸ್ವರ್.<verse eid="AMO 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 4:9" />"ಉನ್ ವಾರ ಸುಡುನ್ ತುಮ್ಚಿ ಪಿಕ ವಾಳ ಶಾರ್ಕಿ ಕಿಲಿತ. ತುಮ್ಚ ಪಿಕ್ ದುಖಾಟಾನಿ ನಾಸ್ ವ್ಹಯಿಶಾರ್ಕ ಕೆಲ. ತುಮ್ಚಾ ಬಾಗತ್ಲ ಝಾ಼ಡ ದರಾಕ್ಶಿಚ಼ ತೊಟ ಹಾಳ್ ಕೆಲ. ತುಮ್ಚಿ ಅಂಜುರಾಚ಼ ಡಾಳ ತೆಲಾಚಿ ಝಾ಼ಡ ಟ್ವಾಳಾಂಚಾನಿ ಖಾಯಿಶಾರ್ಕ ಕೆಲ. ತರಿಬಿ ತುಮಿ ಮಾಜಿಪ ಮಾಗಾರಿ ಆಲಾನಾಹಿಸಾ.” ಮಂಥೊ ಪರಮೆಸ್ವರ್.<verse eid="AMO 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 4:10" />"ಇಜಿಪ್ಟಾತ್ ಮಿ ಕೆಲ್ಯಾಲ ಪಿಡಾ ತುಮಾನಾ ಯಾದ್ ವ್ಹಯಿಸಾರಕೆಲ. ತುಮ್ಚಿ ತರ್ನಿಲೊಕ ತಲ್ವಾರಾತ್ ಗಾವಶಾರ್ಕ ಕೆಲ. ತುಮ್ಚ ಗೊಢ ಲುಟುನ್ ಗಿಹಿಶಾರ್ಕ ಕೆಲ. ತುಮ್ಚೆ ಹಿಂಡಾತಲ್ಯಾಂಚಿ ಮಡಿ ಕುಜು಼ನ್ ಕುಚ್ಕಿ ಘ್ಯಾನ್ ತುಮ್ಚಾ ನಾಕಾಲಾ ಲಾಗಶಾರ್ಕಾ ಕೆಲ. ತರಿಬಿ ತುಮಿ ಮಾಜಿಪ ಮಾಗಾರಿ ಆಲಾನಾಹಿಸಾ,” ಮಂಥೊ ಪರಮೆಸ್ವರ್.<verse eid="AMO 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 4:11" />"ಸೊದೊಮ್ ಆನಿ ಗೊಮಾರಾಚಾ ಶೆರಾತ್ನಿ ಪ್ಯಾಡಲ್ಯಾ ಶಾರ್ಕಿ ಮಿ ತುಮ್ಚಾತ್ಲಿಬಿ ಪಾಡಲ್ಯಾತ, ಪೆಟ್ಯಾಲ್ಯಾ ಇಸತ್ಯಾತ್ನಿ ವಡಲ್ಯಾಲ್ಯಾ ಕೊಲ್ತಾಶಾರ್ಕಿ ತುಮಿ ಹುತ್ತಾಸಾ. ತರಿಬಿ ತುಮಿ ಮಾಜಿಪ ಮಾಗಾರಿ ಆಲಾನಾಹಿಸಾ,” ಮಂಥೊ ಪರಮೆಸ್ವರ್. <verse eid="AMO 4:11" /><verse number="12" style="v" sid="AMO 4:12" />“ಮನ್ಹುನ್ ಇಸ್ರಾಯಲಾನು ಮಿ ತುಮಾನಾ ಆಸ ಕರತೊ ಮನಲ್ಯಾಲ, ತುಮಾನಾ ದಿಯಿ ಶಾರ್ಕ ಕರ್ನಾರ್ . ಓ ಇಸ್ರಾಯಲಾಂಚಾನು, ನ್ಯಾಯಿಚಾ಼ ತಿರ್ಮಾನ್ ದಿಯಾಲಾ ಯತಾಲ್ಯಾ ತುಮ್ಚಾ ದೆವಾಲಾ ಬೆಠಾಲಾ ತಯಾರಕರುನ್ಗೆವಾ.”<verse eid="AMO 4:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="AMO 4:13" />ಬಗಾ, ಗುಡ್ಡ ಕೆಲ್ಯಾಲ</para>
  <para style="q2" vid="AMO 4:13">ವಾರಮ್ಯೊಡ್ ವಾವ್ಡಳ್ ಕೆಲ್ಯಾಲಿ</para>
  <para style="q1" vid="AMO 4:13">ತುಮ್ಚ ಮನ್ ನಿರ್ಮಾನ್ ಕೆಲ್ಯಾಲಾ</para>
  <para style="q2" vid="AMO 4:13">ರ‍್ಯಾತಿಚಾ಼ ದಿಸ್ ಕೆಲ್ಯಾಲಾ</para>
  <para style="q2" vid="AMO 4:13">ದರ್ಥಿವ ಮೊಟ್ಯಾ ಸ್ಥಾನಾತ್ ಚಾ಼ಲತ್ಯಾಲಾ</para>
  <para style="q1" vid="AMO 4:13">ಸರವ್ಯಾಚಾ಼ ದೆವಜಾ಼ಲ್ಯಾಲಾ ಪರಮೆಸ್ವರುಸ್ ತ್ಯಚ಼ ನಾವ್.<verse eid="AMO 4:13" /></para>
  <chapter eid="AMO 4" />
  <chapter number="5" style="c" sid="AMO 5" />
  <para style="s">ಮನ್ ಬದ್ಲಾವನ್ ಕರಾಲಾ ಹಾಳ್ಳಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 5:1" />ಇಸ್ರಾಯಲಾಚಾ ವಂಸಾತಲ್ಯಾನು, ತುಮ್ಚೆ ಗುಸ್ಟಿತ್ ಮೀ ಗ್ಯಾವತ್ಯಾಲ ಹ್ಯ ದುಖಾಚ಼ ಗಾನ ಐಕಾ:<verse eid="AMO 5:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="AMO 5:2" />“ಇಸ್ರಾಯಲ್ ಮಂಥ್ಯಾಲಿ ಕನ್ಯಾ ಖಾಲ್ ಪಡ್ಲಿ,</para>
  <para style="q1" vid="AMO 5:2">ತಿ ಆನಿ ಕಂದಿಸ್ ವರ್ ಉಟ್ನಾರ‍್ನಾಹಿ.</para>
  <para style="q1" vid="AMO 5:2">ತಿ ದರ್ಥಿವ ಲೊಳ್ತೆ .</para>
  <para style="q1" vid="AMO 5:2">ತಿಥ ತಿಲಾ ಉಚ಼ಲತ್ಯಾಲ ಕೊನ್ ನಾಹಿ."<verse eid="AMO 5:2" /></para>
  <para style="b" />
  <para style="p">
    <verse number="3" style="v" sid="AMO 5:3" />ದನ್ಹಿಜಾ಼ಲ್ಯಾಲಾ ಪರಮೆಸ್ವರ್ ಆಸಾ ಮಂತ್ಯೊ: “ಪೆಠತ್ಲ ಲಡಾಯಿಲಾ ಜಾ಼ತ್ಯಾಲ್ಯಾ ಹಾಜಾ಼ರ‍ಜ಼ನಾತ್ಲ ಪೇಠತ್ ಮಾಗಾರ ಆಲ್ಯಾಲ ಶಂಬರಜಾ಼ನುಸ್: ಲಡಾಯಿಲಾ ಗೆಲ್ಯಾಲ ಶಂಬರಜ಼ನಾತ್ಲ ಇಸ್ರಾಯೆಲಾಲಾ ಮಾಗಾರ ಆಲ್ಯಾಲಾ ಧಾ ಜಾ಼ನುಸ್.”<verse eid="AMO 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 5:4" />ಇಸ್ರಾಯಲಾಚಾ ಗರಾನ್ಯಾಲಾ ಪರಮೆಸ್ವರ್ ಸಾಂಗತ್ಯಾಲಾ ಕ್ಯಾ ಮಂಜೆ: “ಮನಾ ಸೊದಾ ಆನಿ ತುಮಿ ಜ಼ಘಾ. <verse eid="AMO 5:4" /><verse number="5" style="v" sid="AMO 5:5" />“ಬೇತೇಲಾತ್ ಜಾ಼ವುನಕೊಸಾ. ಗಿಲ್ಗಾಲಿತ್ ಮಿಸ್ಳು ನಕೊಸಾ. ಬೇರ್ಶೆಬಾತ್ ಯಾತ್ರಾ ಕರುನಕೊಸಾ. ಕಾ ಮಂಜೆ ಗಿಲ್ಗಾಲ್ ಸಿಮತ್ನಿ ಬಾಹಿರ್ ರಾನ್ಹಾರ್. ಬೇತೇಲ್ ಮಾಳಾವ ಪಡ್ನಾರ್."<verse eid="AMO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 5:6" />ಪರಮೆಸ್ವರ್ ದೆವಾಕ್ಡ ಪರ್ತಾ, ತುಮಿ ಜ಼ಗ್ಸಿಲಾ. ನಾಹಿತ ತ್ಯೊ ಇಸತ್ಯಾಚೆಗತ್ ಯೊಸೆಪಾಚಾ ಗರ‍್ಹಾನ್ಯಾವ ದಾವಲ್. ಬೇತೇಲಾಸಾಟಿ ಇಸ್ತು ಇಜ಼ವಾಯಾ ಕೊನ್ ರಾನ್ಹಾರ‍್ನಾಹಿ. <verse eid="AMO 5:6" /><verse number="7" style="v" sid="AMO 5:7" />ಏ ತುಮಿ ನ್ಯಾಯಿ ಕಡು ಕರ‍್ನಾರ‍್ಯಾನು, ದರ‍್ಮಾಚಾ಼ ಕ್ಯೊರ್ ಕರ‍್ನಾರ‍್ಯಾನು!<verse eid="AMO 5:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="AMO 5:8" />ಕಾತ್ವೊಡ್, ಮಿರುಗ್,</para>
  <para style="q2" vid="AMO 5:8">ಮಂಥ್ಯಾಲಿ ಮೂಟ್ಯಾ ಉಜಿಡಾಚಿ ನಕ್ತಾರ್</para>
  <para style="q1" vid="AMO 5:8">ನಿರ‍್ಮಾನ್ ಕೆಲ್ಯಾಲಾ ಆಂದಾರಾಚಾ಼ ಉಜಿಡ್,</para>
  <para style="q2" vid="AMO 5:8">ದಿಸಾಚಿ ರ‍್ಯಾತ್ ಕರ‍್ನಾರಾ,</para>
  <para style="q1" vid="AMO 5:8">ಸಮಿಂದೊರಾತ್ಲ ಪಾನಿ ಆಗಾಸಾತ್ ವರ‍್ನಿಹುನ್</para>
  <para style="q2" vid="AMO 5:8">ದರ್ಥಿವ ಪಾವುಸ್ ಆನಿಶಾರ್ಕಾ ಕರತೊ.</para>
  <para style="q1" vid="AMO 5:8">ಪರಮೆಸ್ವರ್ ದೆವ್ ಮನ್ಹುನ್ ತ್ಯಚ಼ ನಾವ್ ,<verse eid="AMO 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 5:9" />ತಾಕವಾನಾಲಾ ನಾಸ್ ಯಕ್ದಮ್ ಯಯಿಶಾರ್ಕ ಕರುನ್ ಕೊಟ್ಯಾವ್ನಿ ನಾಸ್ ಆನ್ನಾರಾ ತ್ಯೊಸ್, .<verse eid="AMO 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 5:10" />ದಿಸಲ್ಯಾಲಿ ಚು಼ಕ್ ಮಾಂಡ್ವಾತುಸ್ ಖಡ್ಯಾವತ್ಯಾಲ್ಯಾಚಾ಼ ತುಮಿ ರಾಗ್ ಕರ‍್ತಾಸಾ; ನ್ಯಾಯಿ ನಿವಡತ್ಯಾಲ್ಯಾಂಚಿವ ರಾಗ್ ಕರ್ತಾಸಾ. <verse eid="AMO 5:10" /><verse number="11" style="v" sid="AMO 5:11" />ಗೊರ‍್ಗರಿಬಾನಾ ತುಡಿವ್ತಾಸಾ; ದಾನದುನ ಕಾಡುನ್ಗೆತಾಸಾ. ಮನ್ಹುನ್ ತುಮಿ ತ್ಯಾಸಲ್ಯಾಲ್ಯಾ ದೊಂಡ್ಯಾಂಚಾನಿ ಬ್ಯಾಂದಲ್ಯಾಲ್ಯಾ ಗರ‍್ಹಾತ್ನಿ ರಾನ್ಹಾರ‍್ನಾಹಿಸಾ. ತುಮಿ ಲ್ಯಾವಲ್ಯಾಲೆ ಚಾಂಗಲ್ಯಾ ದರಾಕ್ಶಿಚಾ ತೊಟ್ಯಾತಲ್ಯಾ ಫಳಾಂಚಾ಼ ರಸ್ ಪಿನಾರ‍್ನಾಹಿಸಾ. <verse eid="AMO 5:11" /><verse number="12" style="v" sid="AMO 5:12" />ಚಾ಼ಂಗಲ್ಯಾನಾ ತರಾಸ್ ದಿವುನ್, ಲಂಚಾಲಾ ಹಾತ್ ಗ್ಯಾಲತ್ಯಾಲ್ಯಾನು, ನ್ಯಾಯಸಬೆತ್ ಗರಿಬಾನಾ ನ್ಯಾಯಿ ದಿಯಿತ್ನಸಲ್ಯಾಲ್ಯಾನು, ತುಮ್ಚಾ ಚು಼ಕಿ ಖುಬ್ ಜಾಲ್ಯಾತಾ! ತುಮ್ಚಿ ಪಾಪ ಖುಬ್ ಜಾ಼ಲ್ಯಾತ! ಹ್ಯ ಮನಾ ಠಾವ ಹಾ. <verse eid="AMO 5:12" /><verse number="13" style="v" sid="AMO 5:13" />ಕಾಲ್ ಬುರ್ಸ ಹಾತ ಮನ್ಹುನ್ ಶಾನ್ಯಾನಿ ಗಪ್ ರಾಹ್ಯಾಚ಼ ಬರ. ಕಾ ಮಂಜೆ ಹ್ಯೊ ಬುರ್ಸಾ ಕಾಲ್<verse eid="AMO 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 5:14" />ವಾಯಿಟ್ ಆಸಲ್ಯಾಲ ಸುಡುನ್ದೆವಾ. ಚಾ಼ಂಗ್ಲತ್ಯ ಹವ್ಸನಿ ಕರಾ; ತುಮಿ ಜ಼ಗ್ಸಿಲಾ. ತವಾ ತುಮಿ ಸಾಂಗಿಜೊ಼ಕ್ತಿ, ಸರವ್ಯಾಚಾ಼ ದೆವಜಾ಼ಲ್ಯಾಲಾ ಪರಮೆಸ್ವರ್ ತುಮ್ಚೆ ಸಂಗ ರಾನ್ಹಾರ್. <verse eid="AMO 5:14" /><verse number="15" style="v" sid="AMO 5:15" />ಬುರ‍್ಶಾಲಾ ದೂರ್ ಕರಾ, ಚಾಂಗಲ್ಯಾಚಿ ಮಾಯಾ ಕರಾ. ನ್ಯಾಯಸಬೆತ್ ಖರ‍್ಯಾಲಾ ಜಯ ಗಾವ್ಹಸಾರ ಬಗಾ. ತವಾ ಸರವ್ಯಾಚಾ಼ ದೆವಜಾ಼ಲ್ಯಾಲಾ ಪರಮೆಸ್ವರ್ ಕಾಯ್ತೊಡಿ ರಾಯಲ್ಯಾಲ್ಯಾ ಯೊಸೆಪಾಚಾ ವಂಶಾಲಾ ಕರ‍್ನಾ ದಾವ್ಲಿತ ದಾವಿಲ್.<verse eid="AMO 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="AMO 5:16" />ಸರವ್ಯಾಚಾ಼ ದೆವಜಾ಼ಲ್ಯಾಲಾ ಪರಮೆಸ್ವರ್ ಆಸಾ ಮಂತ್ಯೊ: “ವಾಟಚಾ ಕತರ‍್ಯಾವ್ನಿ ವರೊಡ್ ರಾನ್ಹಾರ್. ಪಾಂದಿವ್ನೆ ಸಗಳೆ ‘ಆಯಾಯಿ’ಮನ್ಹುನ್ ಲೊಕ ರಡ್ನಾರ್. ರಡಾಯಾಸಾಟಿ ರೈತಾನಾ ದುಖಾಚ಼ ಗಿತ್ಗಾವಾಯಾ ಲೊಕಾನಾ ಹಾಕಟ್ನಾರ್. <verse eid="AMO 5:16" /><verse number="17" style="v" sid="AMO 5:17" />ಸಗ್‌ಳ್ಯಾ ದರಾಕ್ಶಿಚಾ ಮಳ್ಯಾತ್ನಿ ಲೊಕ ರಡ್ನಾರ್. ಕಾ ಮಂಜೆ ತುಮಾನಾ ಶಿಕ್ಶಾದಿಯಾ ತುಮ್ಚೆ ಮದ್ನಿ ಮಿ ಜಾ಼ನಾರ್,” ಹ್ಯೊ ಪರಮೆಸ್ವರ್ ದೆವಾಚಾ಼ ಸಬ್ದ.<verse eid="AMO 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="AMO 5:18" />ದೆವಾಚಾ ತ್ಯಾ ದಿಸಾಸಾಟಿ ಧನ್ ಥಿವುನ್ ರ‍್ಯಾಖತ್ಯಾಲ್ಯಾನು,ಆಯಿ ತುಮಾನಾ ನಾಸ್; ತಿಸಿ ಕ್ಯಾ ವ್ಹನಾರ್ ಮನ್ಹುನ್ ತುಮಾನಾ ಠಾವ ಹಾ ಕ್ಯಾ? ದೆವಾಚಾ ತ್ಯೊ ದಿಸ್ ತುಮಾನಾ ಉಜಿಡಾನಿ ರಾನ್ಹಾರ‍್ನಾಹಿ, ಆಂದಾರಾಚಾ಼ ದಿಸ್ ವ್ಹನಾರ್. <verse eid="AMO 5:18" /><verse number="19" style="v" sid="AMO 5:19" />ತ್ಯೊ ಕಸಾ ಮಂಜೆ: ಸಿವಾಚಾ ತೊಂಡಾತ್ನಿ ಚು಼ಕ್ವುನ್ ಪಳುನ ಜಾ಼ತ್ಯಾಲ್ಯಾಲಾ ಆಸ್ವಲ್ ಗಾವಲ್ಯಾಸಾರಿ ವ್ಹನಾರ್ ನಾಹಿತ ತ್ಯೊ ತಿತ್ನಿ ಗರ‍್ಹಾತ್ ಪಳುನ್ ಯವುನ್ ಗ್ವಾಡಿಲಾ ವರಾಮ್ತಾನಾ ತ್ಯಲಾ ಸಾಪ್ ಡಸಲ್ಯಾಸಾರ ವ್ಹನಾರ್! <verse eid="AMO 5:19" /><verse number="20" style="v" sid="AMO 5:20" />ಖರ‍್ಯಾನಿ ದೆವಾಚಾ ದಿಸಾತ್ ಉಜಿಡ್ ರಾನ್ಹಾರ‍್ನಾಹಿ, ಆಂದಾರ್ ರಾನ್ಹಾರ್, ಏಕ್ ಚಾನ್ನಿಬಿ ನಸಲ್ಯಾಲಾ ಕಾಳೊಕಿರ್ ರಾನ್ಹಾರ.<verse eid="AMO 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="AMO 5:21" />ತುಮ್ಚ಼ ಸನ್ವಾರ್ ಮ್ಯಾನ್ನಾರ್ನಾಹಿ, ರಾಗ್ಕರ‍್ತೊ. “ತಮ್ಚಾ ಉತ್ಸವಾಚಾ಼ ಬೈಟಕಿ ಮನಾ ನಕೊ. <verse eid="AMO 5:21" /><verse number="22" style="v" sid="AMO 5:22" />ತುಮಿ ಮನಾ ದಹನಬಲಿ, ದಾನ್ಯಾಂಚ಼ ನಿವದ್ ದಿಯಾ ಆಲಾಸಾತರಿ ಮಿ ತ್ಯ ಮಾನುನ್ಗಿಹಿತ್ನಾಹಿ.ಸಮಾದಾನಾಚ಼ ಯಜ್ಞ ಬಲಿ ಮನ್ಹುನ್ ತುಮಿ ದೆತ್ಯಾಲಿ ಮಾತಲ್ಯಾಲಿ ಜ಼ನಾವಾರ ಮಿ ಬಗಿತ್ನಾಹಿ. <verse eid="AMO 5:22" /><verse number="23" style="v" sid="AMO 5:23" />ತುಮ್ಚಾ ಗಿತಾಂಚಾ ಆವಾಜ಼ ಮಾಜಿಪ್ನಿ ದೂರ್ ಕರಾ; ಹಾರ್ಪ್ ಮಂಥ್ಯಾಲೆ ತಂತಿಚಾ ವಾಜ಼ಪಾಚಾ ನಾದ್ ಮಿ ಐಕಿತ್ನಾಹಿ. <verse eid="AMO 5:23" /><verse number="24" style="v" sid="AMO 5:24" />ತೆಚೆ ಬದ್ಲಾಸ್ ನ್ಯಾಯಿ ನಿಯೆತ್ ವ್ಹಾಳಚೆಗತ್ ವ್ಹಾವುನಿ; ಚಾ಼ಂಗ್ಲಫನ್ ಮೊಟೆ ನ್ಹಚೆಗತ್ ವ್ಹಾವುನಿ.<verse eid="AMO 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="AMO 5:25" />“ಇಸ್ರಾಯಲಾಚಾ ವಂಶಾತಲ್ಯಾನು, ಚಾಳಿಸ್ ವರ್ಸ ತುಮಿ ರಾನಾತ್ ಆಸ್ತಾನಾ, ಜ಼ನಾವಾರ, ದಾನ್ಯಾಚ಼ ನಿವದ್ ದಿಯಾವ್ಹಯಿಸಾ ಮನ್ಹುನ್ ಮಿ ಇಚಾರ‍್ಲ ಹುತಕ್ಯಾ? <verse eid="AMO 5:25" /><verse number="26" style="v" sid="AMO 5:26" />ಫನ್ ಆತಾ ತುಮಿ ಬನಿವಲ್ಯಾಲಿ ಪಾಶಾನ, ಸಿಕ್ಕೊತ್ ರಾಜಾ಼ಲಾ ಆನಿ ಕಿಯೂನ್ ಮಂತ್ಯಾಲೆ ಚಾನ್ನಿ ದೆವಿಲಾ ತುಮಿಸ್ ಉಚ಼ಲುನ್ ನಿಹ್ಯಾಚ಼ ಲಾಗ್ನಾರ್. <verse eid="AMO 5:26" /><verse number="27" style="v" sid="AMO 5:27" />ಕಾ ಮಂಜೆ ಮಿ ತುಮಾನಾ ದಮಸ್ಕಾತ್ನಿ ತ್ಯಾಂಗ್ನಿ, ಕುಂಡುನ್ ಲಾವುನ್ದೆನಾರ್.” ಹ್ಯೊ ಸರವ್ಯಾಚಾ಼ ಪರಮೆಸ್ವರ್ ದೆವಾಚಾ಼ ಸಬ್ದ.<verse eid="AMO 5:27" /></para>
  <chapter eid="AMO 5" />
  <chapter number="6" style="c" sid="AMO 6" />
  <para style="s">ಇಸ್ರಾಯಲಾಚಾ ನಾಸ್</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 6:1" />ಚಿಯೊನಾತ್ ಆರಾಮಾನಿ ಆಸಲ್ಯಾಲ್ಯಾಂಚಾನು, ಸಮಾರ‍್ಯಾಚಾ ಗುಢ್ಯಾವ ಕ್ಯಾಳಜಿ ನಸ್ತಾನಾ ಆಸಲ್ಯಾಲ್ಯಾನು, ಇಸ್ರಾಯೆಲಾಂಚಾ ವಂಶಾತಲ್ಯಾನು ತುಮ್ಚಿ ಮಜ಼ತ್ ಮಾಗಿತ್ ತುಮಾನಾ ಸುದಿತ್ ಯಯಿಯವ್ಡ ಮತ್ವಾಚಿ ಜಾ಼ಲ್ಯಾಲ್ಯಾನು, ತುಮ್ಚಿ ಗತಿ ಕ್ಯಾಸಾಂಗು! <verse eid="AMO 6:1" /><verse number="2" style="v" sid="AMO 6:2" />ಕಲ್ನೆ ಪೆಠತ್ ಜಾ಼ವುನ್ ಬಗಾ. ತಿತ್ನಿ ಮುಟಿ ಪ್ಯಾಟ್ ಜಾ಼ಲ್ಯಾಲೆ ಹಮಾತಿಲಾ ಜಾ಼ವಾ. ಹಮಾತಿತ್ನಿ ಪಿಲಿಸ್ಟಿಯಾಂಚಾ಼ ಶಾರ್ ಗತಾತ್ ಉತ್ರುನ್ ಜಾ಼ವಾ.ತಿ ತುಮ್ಚಾ ರಾಜಾವ್ನಿ ಮುಟಿಕ್ಯಾ? ತ್ಯಂಚ಼ ಪ್ರಾಂತ್ಯ, ತಮ್ಚಾ ಪ್ರಾಂತ್ಯಾವ್ನಿ ಮೊಟಕ್ಯಾ? <verse eid="AMO 6:2" /><verse number="3" style="v" sid="AMO 6:3" />ಬಗಾ ತುಮಿ ತ್ಯಾ ವಾಯಿಟ್ ದಿಸಾತ್ನಿ ಚು಼ಕುವುನ್ ಗಿಹ್ಯಾ ಯತ್ನ ಕರತ್ಯಾಲ್ಯಾನು ,ಆನಿಜ಼ರಾ ತರಾಸ್ ಜ಼ವಳ್ ಆನುನ್ಗೆನ್ಹಾರ್. <verse eid="AMO 6:3" /><verse number="4" style="v" sid="AMO 6:4" />ಹಾತ್ತಿಚಾ ದಾತಾಚಾ ಪಲಂಗಾವ ನಿಸತ್ಯಾಲ್ಯಾ ಲೊಕಾನು, ಸುಕಾಚೆ ಮಂಚಾವ ಆರಾಮ್ ವರಾಂಗಲ್ಯಾಲ್ಯಾನು, ಹಿಂಡಾತ್ಲಿ ಬಕ್ರಿ, ಗೊಟ್ಯಾತ್ಲಿ ವಾಸ್ರ ಮಾರುನ್ ಖಾತ್ಯಾಲ್ಯಾನು, ತುಮ್ಚಿ ಗತಿ ಕ್ಯಾಸಾಂಗು! <verse eid="AMO 6:4" /><verse number="5" style="v" sid="AMO 6:5" />ತುಮಿ ಹಾರ್ಪ ಮಂಥ್ಯಾಲ ವಾಜಾ಼ಪ್ ವಾಜ಼ವಿತ್ ಮನ್ ಯಯಿಲ್ತಸ ಗ್ಯಾವತ್ಯಾಸಾ, ದಾವಿದಾಚೆಗತ್ ನವಿ ಗಿತ ರಚಿವತ್ಯಾಸಾ. <verse eid="AMO 6:5" /><verse number="6" style="v" sid="AMO 6:6" />ಬಗುನ್ಯಾತ್ನಿ ದರಾಕ್ಶಿಚಾ಼ ರಸ್ ಪಿತ್ಯಾಲ್ಯಾನು, ಚಾ಼ಂಗ್ಲಿ ವಾಸಾಚಿ ತೆಲ ಲಾವುನ್ ಗೆತ್ಯಾಲ್ಯಾನು, ಫನ್ ಯೊಸೆಪಾಚಾ ವಂಶಾ ನಾಸಿವ್ಲಾ ತರಿ ಚಿಂತಾ ನಸ್ತಾನಾ ಹಾಸಾ. <verse eid="AMO 6:6" /><verse number="7" style="v" sid="AMO 6:7" />ಮನ್ಹುನ್ ಸಿಮಚೆ ಬಾಹಿರ್ ಥೆವಾಚಾತ್ ತುಮಿಸ್ ಪೈಲಿ ವ್ಹನಾರ್. ತವಾ ತುಮ್ಚಾ ಸುಕಾತ್ ಬಸತ್ಯಾಲಿ ಆನಿ ಮೊಟಫನ್ ಸಾವ್ಕರ್ಕಿ ನಾಹಿವ್ಹನಾರ್.<verse eid="AMO 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 6:8" />ಸರವ್ಯಾಚಾ಼ ದೆವ್ ಪರಮೆಸ್ವರಾನಿ ಶಪತ್ಕರುನ್ ಸಾಂಗಲ್ಯಾಲ ಕ್ಯಾ ಮಂಜೆ: “ಯಾಕೊಬ್ ವಂಶಾಚಾ ಮೊಟ್ಯಾಫನಾಲಾ ಕಂಟಾಳ್ತೊ. ತ್ಯಂಚಾ ಮಸ್ತಿಚಾ ಬಂಗಲ್ಯಾಂಚಾ಼ ತಿಟ್ಕಾರಾಯತೊ. ಮನ್ಹುನ್ ಪೆಠಲಾ ಆನಿ ತ್ಯಾತ್ಲ ಸರ‍ವ್ಯಾಲಾ ತರಾಸ್ ದೆನಾರ್.”<verse eid="AMO 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 6:9" />ಯಕಾ ಗರ‍್ಹಾತ್ ಧಾ ಲೊಕ ಉರ್ಲಿತರಿ ತಿ ಸಗ್ಳಿ ಮರ‍್ನಾರ್. <verse eid="AMO 6:9" /><verse number="10" style="v" sid="AMO 6:10" />ಮಡ ಆಡ್ಶಾಕರಾಲಾ ಆಲ್ಯಾಲಿ ಮಾಯೆದಾಯೆಚಿ ಮಡ ಗರ‍್ಹಾತ್ನಿ ಗಿಹುನ್ಗಿಲಿತ ತವಾ, “ತುಮಚಾತ್ ಕೊನ್ತರಿ ರಾಯಲ್ಯಾತಕ್ಯಾ?” ಮನ್ಹುನ್ ಗರ‍್ಹಾತ್ ಚು಼ಕುನ್ ರಾಯಲ್ಯಾಲ್ಯಾಲಾ ಇಚಾರಲತ, ತ್ಯೊ “ನಾಹಿ” ಮನ್ಹಾರ್. ತವಾ ತ್ಯೊ ಮಾಯೆದಾಯೆಚಾ಼, “ಗಪರ‍್ಹಾ! ಪರಮೆಸ್ವರ್ ದೆವಾಚ಼ ನಾವ್ ಗಿಹ್ಯಾಚ಼ ನಾಹಿ” ಮನ್ಹುನ್ ಸಾಂಗ್ನಾರ್.<verse eid="AMO 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 6:11" />ಬಗಾ,ಪರಮೆಸ್ವರ್ ಮಂತ್ಯೊ, ಮೊಟ ಬಂಗ್ಲ ತುಕ್ಡ ತುಕ್ಡ ವ್ಹನಾರ್, ಬಾರಿ ಬಾರಿಕ್ ಗರ‍್ಹ ಕುಸ್ಕಾರುನ್ ಪಡ್ನಾರ್. <verse eid="AMO 6:11" /><verse number="12" style="v" sid="AMO 6:12" />ವಾರು ದುಂಢಿವ ಪಳ್ತೊಕ್ಯಾ? ಬೈಲಾಂಚಾ ಜೊ಼ತಾನಿ ಸಮಿಂದೊರ್ ನಾಂಗ್ರಿಲಕ್ಯಾ? ತುಮಿ, ನ್ಯಾಯಿ ನಿತಿಚ಼ ಇಸ್ ಕೆಲಸಾ,ಚಾ಼ಂಗಲ್ಯಾಲಾ ಕಡು ಕೆಲಸಾ.<verse eid="AMO 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 6:13" />ತುಮಿ ‘ಲೊದೆ-ಬಾರಿತ್’ ಸುಕಿ ವನ್ಹಾರ್! “ಸ್ವತಾಚಾ ಬಳಾನಿ ಕರ‍್ನಾಯಿಮ್ ಜಯಿಸ್ಲೆ ಮಂತಾಸಾ”<verse eid="AMO 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 6:14" />ಸರವ್ಯಾಚಾ಼ ಪರಮೆಸ್ವರ್ ಆಸಾ ಮಂತ್ಯೊ: ಓ ಇಸ್ರಾಯಲಾಂಚಾನು “ತುಮ್ಚೆ ಇರೊದ್ ಯಕಾ ದೆಸೆತ್ಲಾ ಉಟಿವ್ನಾರ್; ತುಮಾನಾ ಹಮಾತಿಚೆ ವಾಟದರ‍್ನಿ ಅರಬಾ ವ್ಹಾಳ ಪರ‍್ಯಾತ್ ದಡಪ್ನಾರ್.”<verse eid="AMO 6:14" /></para>
  <chapter eid="AMO 6" />
  <chapter number="7" style="c" sid="AMO 7" />
  <para style="s">ಟೊಳಾಂಚ಼ ಯಾಕ್ ದರ್ಶಾನ್</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1" />ದನ್ಹಿಜಾ಼ಲ್ಯಾಲ್ಯಾ ಪರಮೆಸ್ವರಾನಿ ಮನಾ ದ್ಯಾವಲ್ಯಾಲ ದರ‍್ಹಾನ್ ಹ್ಯ:ತವಾ ತ್ಯನಿ ಟೊಳಾಂಚಿ ಏಕ್ ರ‍್ಯಾಸ್ ಲಾವುನ್ದಿಲಿ. ತವಾ ಪಿಕ್ ಚಾ಼ಂಗ್ಲ ಯಯಾಲಾಗ್ ಹುತ್ತ. ಆತಾಸ್ ಪೈಲ ರಾಜಾಚ಼ ಗವಾತ್ ಕಾಪುನ್ ದೊನವ್ಯಾನಿ ಗವಾತ್ ಯತ್ಯಾಲ ಹುತ್ತ. <verse eid="AMO 7:1" /><verse number="2" style="v" sid="AMO 7:2" />ಟೊಳಾಂಚಾನಿ ದೆಸೆತ್ಲ ಪಿಕ್ ಗವಾತ್ ಸಗ್ಳ ಖಾಲ. ಮಂಗ್ ಮಿ ಪ್ರಬುಪ ಆಸ ಮಾಗ್ನ ಕೆಲ: “ದನ್ಯಾ ಪರಮೆಸ್ವರಾ, ಆಮಾನಾ ಬಗ್, ಸಂಬ್ಯಾಳ್; ಖುಬ್ ಬಾರಿಕ್ ಯಾಕೊಬ್ ಹೆ ಪಿಡತ್ನಿ ರಾಹಿಲಕ್ಯಾ?”<verse eid="AMO 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 7:3" />ಹ್ಯ ಐಕುನ್ ಪರಮೆಸ್ವರಾನಿ ಮನ್ ಪರ‍್ತುನ್. “ಹ್ಯ ದರ್ಶಾನ್ ಗಡ್ನಾರ‍್ನಾಹಿ” ಮನ್ಲಾ.<verse eid="AMO 7:3" /></para>
  <para style="s">ಇಸತ್ಯಾಚ಼ ದರ್ಶಾನ್</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4" />ದನ್ಹಿ ಪರಮೆಸ್ವರಾನಿ ಮನಾ ಹ್ಯ ದ್ಯಾವ್ಲ. “ಪರಮೆಸ್ವರಾನಿ ಆಪಲ್ಯಾ ಲೊಕಾನಾ ಸಿಕ್ಶೆ ದಿಯಾ ಇಸ್ತು ಆನ್ಲಾ. ತ್ಯೊ ಸಮಿಂದೊರಾಲಾ ಬಸ್ಮಾ ಕೆಲಾ ಆನಿ ದೆಶಾ ಸಗ್ಳಿ ಬಸ್ಮಾ ಕರತ್ಯಾಲ್ಯಾತ್ ಹುತ್ತಾ. <verse eid="AMO 7:4" /><verse number="5" style="v" sid="AMO 7:5" />ತವಾ ಮಿ ಸಾಂಗಲ ಸರವ್ಯಾಚಾ಼ ದೆವಾ ಪರಮೆಸ್ವರಾ: “ಬಗ್, ಹೆ ಪಿಡಲಾ ಥಾಂಬಿವ್, ಯಾಕೊಬ್ ಮೊರ‍್ಹ ಕಸಾ ರಾಹಿಲ್? ತ್ಯೊ ಖುಬ್ ಬಾರಿಕ್! <verse eid="AMO 7:5" /><verse number="6" style="v" sid="AMO 7:6" />ದನ್ಹಿ ಪರಮೆಸ್ವರಾನಿ ಹ್ಯ ಐಕುನ್ ಮನ್ ಬದ್ಲುನ್: “ಹ್ಯ ಗಡ್ನಾರ‍್ನಾಹಿ” ಮನ್ಹುನ್ ಪರಮೆಸ್ವರ್ ಮನ್ಲಾ.<verse eid="AMO 7:6" /></para>
  <para style="s">ಯಕಾ ವಳಂಬ್ಯಾಚ಼ ದರ್ಶಾನ್</para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7" />ತ್ಯಾ ದೆವಾಪ್ನಿ ಮನಾ ಆನಿ ಯಾಕ್ ದರ್ಶಾನ್ ಜಾ಼ಲ. ದೆವ ವಳಂಬ್ಯಾತ್ ಬ್ಯಾಂದಲ್ಯಾಲೆ ಬಿಥಿಚೆ ಬಾಜು಼ಲಾ ಉಬಾ ಹುತಾ. ತ್ಯಚಾ ಹಾತಾತ್ ಯೊಕ್ ವಳಂಬಾ ಹುತ್ತಾ. <verse eid="AMO 7:7" /><verse number="8" style="v" sid="AMO 7:8" />ಪರಮೆಸ್ವರಾನಿ ಮನಾ ಇಚಾರ್ಲ: “ಆಮೊಸಾ, ತುಜಾ ಡೊಳ್ಯಾಲಾ ದಿಸತ್ಯಾಲ ಕ್ಯಾ?”</para>
  <para style="p" vid="AMO 7:8">“ತವಾ ಮಿ ಯೊಕ್ ವಳಂಬಾ,”</para>
  <para style="p" vid="AMO 7:8">ಮನ್ಲೊ. ಆತಾ, “ಮಾಜಿ ಲೊಕಜಾ಼ಲ್ಯಾಲ್ಯಾ ಇಸ್ರಾಯೆಲಾಂಚೆ ಮಧಿ ವಳಂಬಾ ಥಿವುನ್, ತ್ಯಂಚಾ ಚಾ಼ಲನ್ಯಾಚಿ ಭಿತ್ ನಿಟ್ನಾಹಿ ಮನ್ಹುನ್ ದ್ಯಾವ್ನಾರ್.ತ್ಯನಾ ಬಗುನ್ ದಿಸಜೊ಼ಗ, ಶಿಕ್ಶೆ ದಿವುನುಸ್ ದೆನಾರ್. <verse eid="AMO 7:8" /><verse number="9" style="v" sid="AMO 7:9" />ಇಸಾಕಾಚಾ ವಂಶಾಚಿ ಉಚ಼್ ಜಾ಼ಗ ಜಿಮ್ನಿಸ್ಲಾಗ್ನಾರ್. ಇಸ್ರಾಯೆಲಾಚಿ ಪವಿತ್ರಗರ‍್ಹ ಬಂಜಾರ್ ಪಡ್ನಾರ್. ಯಾರೊಬಾಮಾಚ಼ ಗರ‍್ಹಾನ ತಲ್ವಾರಾಚಾ ತೊಂಡಾತ್ಗಾವ್ನಾರ್,” ಮನ್ಲಾ.<verse eid="AMO 7:9" /></para>
  <para style="s">ಆಮೊಸ್ ಆನಿ ಆಮಾಜಿಯಾ</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10" />ಮಂಗ್ ಬೇತೇಲಿಚಾ಼ ಯಾಜಕ್ ಜಾ಼ಲ್ಯಾಲಾ ಅಮಚಾ ಇಸ್ರಾಯಲಾಚಾ಼ ರಾಜಾ಼ ಯಾರೊಬಾಮಾಲಾ ಆಸ ಸಾಂಗುನ್ ಲಾವುನ್ದಿವುನ್: “ಆಮೊಸ್ ತುಜೆ ಆಡ್ವಾ ಇಸ್ರಾಯಲಾಂಚಾತ್ ಮಸ್ಲತ್ ಕೆಲೆ. ತ್ಯಚಾ ಬೊಲ್ಯಾ ದುನೆಲಾ ಸೊಸಂತಾ.” <verse eid="AMO 7:10" /><verse number="11" style="v" sid="AMO 7:11" />ಕಾ ಮಂಜೆ," ಯಾರೊಬಾಮ್ ಹಾತ್ಯಾರ‍್ಯಾನಿ ಮರ‍್ನಾರ್. ಇಸ್ರಾಯೇಲ್ಲಾ ಆಪ್ಲೆ ದೆಶೆತ್ನಿ ಪರ್ದೆಶೆತ್ ಖರ‍್ಯಾನಿ ಕೂಂಡುನ್ ನೆನ್ಹಾರ್.”<verse eid="AMO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 7:12" />ಮಂಗ್ ಅಮಚಾನಿ ಆಮೋಸಾಲಾ,“ಬವಿಶಾ ಸಾಂಗತ್ಯಾಲ್ಯಾ, ಚ಼ಲಾಯಾಲಾಗ್, ಯುದಾಯಾ ಸಿಮತ್ ಪಳುನ್ ಜಾ಼; ತಿಥ ಬವಿಶಾ ಸಾಂಗುನ್ ಪ್ವಾಟ್ಬರ್. <verse eid="AMO 7:12" /><verse number="13" style="v" sid="AMO 7:13" />ಫನ್ ಹಿತ್ನಿ ಮೊರ‍್ಹ ಬೇತೇಲಿತ್ ಆನಿ ಬವಿಶಾ ಸಾಂಗುನಕೊ. ಹಿ ರಾಜಾಚಾ ಪವಿತ್ರ ಜಾ಼ಗಾ, ದೆಸೆತ್ಚ಼ ಪಪಿತ್ರ್ ದಿವುಳ್”.<verse eid="AMO 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 7:14" />ತ್ಯಲಾ ಆಮೊಸ್ ಪರ್ತುನ್: “ಮಿ ಪ್ರವಾದಿ ನವ್ಹ, ಪ್ರವಾದಿಚಾ಼ ಲ್ಯೊಕ್ಬಿ ನವ್ಹ. ಮಿ ಗುರ ವಳತ್ಯಾಲಾ, ಹುಂಬ್ರಾಚಿ ಫಳ ಕ್ಯಾಡತ್ಯಾಲಾ. <verse eid="AMO 7:14" /><verse number="15" style="v" sid="AMO 7:15" />ಬಕ್ರಿ ವಳಾಚಿ ಮನಾ ಪರಮೆಸ್ವರಾನಿ ನಿವ್ಡುನ್. ತು ಜಾ಼ವುನ್ ಮಾಜಾ ಇಸ್ರಾಯೆಲ್ ಲೊಕಾನಾ ಬವಿಶಾ ಸಾಂಗ್ ಮನ್ಹುನ್ ಸಾಂಗ್ಲ. <verse eid="AMO 7:15" /><verse number="16" style="v" sid="AMO 7:16" />ಆತಾ ಪರಮೆಸ್ವರ್ ದೆವಾಚ಼ ವಾಕ್ಯಾ ಐಕ್: ತು ಸಾಂಗತೊಸ್ ಇಸ್ರಾಯೇಲಚೆ ಆಡವ್ಯಾ ಬವಿಶಾ ಕರುನಕೊ; ಇಸಾಕಾಚಾ ಗರ‍್ಹಾನ್ಯಾಚೆ ಆಡ್ವ ಸಬ್ದ ಉಚ಼ಲು ನಕೊಸ್, <verse eid="AMO 7:16" /><verse number="17" style="v" sid="AMO 7:17" />ತಸ ಮನ್ಹುನ್ ಪರಮೆಸ್ವರ್ ಆಸಾ ಮಂತ್ಯೊ: “ತುಜಿ ಬ್ಯಾಯ್ಕೊ ಪೆಠತ್ ಸುಳಿ ವ್ಹನಾರ್ ಆನಿ ತುಜ಼ ಲ್ಯಾಕ್ ಲಿಕಿ ತಲ್ವಾರಾನಿ ಮರ್ನಾರ್, ತುಜಿ ದೆಶಾ ವೈರಿ ತಾಬ್ಯಾತ್ಗಿಹುನ್ ವಾಟುನ್ಗೆನ್ಹಾರ್.ತುಬಿ ಅಪವಿತ್ರ ದೆಶೆತ್ ಮರ‍್ನಾರ್. ಇಸ್ರಾಯೆಲಾಂಚಿ ಖರ‍್ಯಾನಿ ಆಪ್ಲೆ ದೆಶೆತ್ನಿ ಪರ್ದೆಶೆತ್ ಕುಂಡುನ್ ನೆನ್ಹಾರ್.’”<verse eid="AMO 7:17" /></para>
  <chapter eid="AMO 7" />
  <chapter number="8" style="c" sid="AMO 8" />
  <para style="s">ಫಳಾಚೆ ಬುಠಿಚ಼ ದರ್ಶಾನ್</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1" />ದೆವಜಾ಼ಲ್ಯಾಲ್ಯಾ ಪರಮೆಸ್ವರಾನಿ ಮನಾ ಹ್ಯ ದರ್ಶಾನ್ ದ್ಯಾವ್ಲ: ಪಿಕಲ್ಯಾಲ್ಯಾ ಫಳಾಂಚಿ ಬುಟ್ಟಿ ಏಕ್ ದಿಸ್ಲಿ. <verse eid="AMO 8:1" /><verse number="2" style="v" sid="AMO 8:2" />ತ್ಯನಿ ಮನಾ: ಆಮೊಸಾ, ತುಜಾ ಡೊಳ್ಯಾನಾ ದಿಸತ್ಯಾಲ ಕ್ಯಾ?</para>
  <para style="p" vid="AMO 8:2">“ಮನ್ಹುನ್ ಇಚಾರ್ಲ,” ಪಿಕಲ್ಯಾಲ್ಯಾ ಫಳಾಂಚಿ ಏಕ್ ಬುಟ್ಟಿ” ಮನ್ಹುನ್ ಸಾಂಗ್ಲ.</para>
  <para style="p" vid="AMO 8:2">ತವಾ ಪರಮೆಸ್ವರ್ ಮನಾ ಆಸಮನ್ಹುನ್: “ಇಸ್ರಾಯಲಾಂಚಾನಾ ಮಾಜಾ ಲೊಕಾನಾ ಸೆವ್ಟಕಾಲ್ ಜ಼ವಳ್ ಆಲ. ಆತಾ ತ್ಯನಾ ಬಗುನ್ ಬಗಾಚೆಆಂದಿ ರಾನ್ಹಾರ್ನಾಹಿ. ತ್ಯನಾ ಸಿಕ್ಶೆದಿವುನುಸ್ ದೆನಾರ್. <verse eid="AMO 8:2" /><verse number="3" style="v" sid="AMO 8:3" />ತ್ಯಾ ದಿಸಾತ್ ತ್ಯಾ ಜಾ಼ಗ್ಯಾವ ಗಿತ ಮರ್ನಾಚಿ ಗಿತ ವ್ಹನಾರ್. ಮಡಿ ಕುಂಡ ಕುಂಡ ಪಡಲ್ಯಾಲಿ ರಾನ್ಹಾರ್. ತಿ ಗಪ್ಚಿಪ್ ಹುಂಡ್ಯಾರ್ನಾರ್.” ಹ್ಯ ಪರಮೆಸ್ವರ ದೆವಾಚಾ಼ ಸಬ್ದ.<verse eid="AMO 8:3" /></para>
  <para style="s">ಇಸ್ರಯೆಲಾಚಾ಼ ನಾಸ್</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 8:4" />ಹ್ಯ ಐಕಾ ಮಾಗ ಮೊರ‍್ಹ ನಸಲ್ಯಾಲ್ಯಾನಾ ತುಡಿವ್ನಾರಕ್ಯಾ, ದೆಶಾತಲ್ಯಾ ಗರಿಬಾಂಚಾ಼ ನಾಸ್ ಕರ್ನಾರಕ್ಯಾ, <verse eid="AMO 8:4" /><verse number="5" style="v" sid="AMO 8:5" />ತುಮಿ ಸಾಂಗತಾಸಾ ದಾನ್ಯ ಇಕಾಲಾ ವ್ಹಯಿತ. ಹಿ ಆವಾಸ್ ಸಪಾಚಿ ಕಂದಿ? ಗಹು ಇಕಾಯಾ ವ್ಹಯಿತ. ಐತ್ವಾರಾಚಾ಼ ದಿಸ್ ಸಪಾಚಾ಼ ಕಂದಿ? ಮಾಪ್ ಬಾರಿಕ್ ಕರುನ್, ತೊಲ್ ಮೊಟಾ ಕರುನ್, ಚೂ಼ರ್ಟಿ ತಾಗ್ಡಿ ವಾಪ್ರುನ್; <verse eid="AMO 8:5" /><verse number="6" style="v" sid="AMO 8:6" />ಗರಿಬಾನಾ ಚಾ಼ಂದಿಲಾ, ಮಾಗಮೊರ‍್ಹ ನಸ್ನಾರ‍್ಯಾನಾ ಏಕ್ ಜು಼ಡಿ ವ್ಹಾನ್ ಇಕತ್ ಗಿಯಾ; ಗವ್ಹಾಚ಼ ಕನ್ನಿಕೊಂಡಾ ಸೊಡಾಚೆ ಆಂದಿ ಇಕುಯಾ.”<verse eid="AMO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 8:7" />ಯಾಕೊಬಾಚಾ ಮಯ್ಮಲಾ ಪರಮೆಸ್ವರಾನಿ ಶೆಪ್ಪತ್ ದಿವುನ್ ಸಾಂಗಲ್ಯಾಲ ಕ್ಯಾಮಂಜೆ: “ಖರ‍್ಯಾನಿ ತ್ಯಂಚಿ ಬುರ್ಶಿ ಕಾಮ ಕಚಿಸ್ ಕಂದಿಸ್ ಮಿ ಇಸ್ರಾಚೊನಾಹಿ. <verse eid="AMO 8:7" /><verse number="8" style="v" sid="AMO 8:8" />ತೆಂಚಾ ಬುರ್ಶಾಕಾಮಾಚಾ ನಿಮ್ತಾನಿಸ್ ದೆಶಾ ಹಾದ್ರಲ್ ನವ್ಹ; ತಿಥ ಆಸಲ್ಯಾಲ್ಯಾ ಸಗಳ್ಯಾನಾ ದುಕ್ ವ್ಹನಾರ್. ದೆಶಾ ಸಗ್ಳಿ ನೈಲ್‌ ನ್ಹಚೆಗತ್ ಫುಗನಾರ್. ಉಸ್ಸೋಳ್ ವ್ಹವುನ್ ಇಜಿಪ್ಟಾಚೆ ನ್ಹಚೆಗತ್ ಬಾರಿಕ್ ವ್ಹವುನ್ ಇರ್ಗಾಳ್ನಾರ್. <verse eid="AMO 8:8" /><verse number="9" style="v" sid="AMO 8:9" />ದೆವ್ ಪರಮೆಸ್ವರ್ ಆಸಾ ಮಂಥೊ: “ತೆ ದಿಸಿ ಸರ್ಮದ್ದಿ ದುಪ್ಯಾರ್ಚಾ಼ ದಿಸ್ ಬುಡಿವ್ನಾರ್. ದುಪ್ಯಾರ್ಚಾ಼ಸ್ ದರ್ಥಿವ ಕಾಳೊಕ್ ಕರ್ನಾರ್. <verse eid="AMO 8:9" /><verse number="10" style="v" sid="AMO 8:10" />ತುಮ್ಚ ಆನಂದಾಚ಼ ದಿಸ್ ಕಸ್ಟಾಚ಼ ದಿಸ್ಕಸ ಕರಿನ್. ತುಮ್ಚ ಕುಸಿಚಿ ಗಿತ ಮರ್ನಾಚಿ ಗಿತಕರುನ್ ಬದ್ಲಿನ್.ತುಮಿ ಸಗ್ಳಿ ಕಂಬ್ರಸ್ ಚಿಲಾಚ಼ ಗೊಂತ ಬಾಂದುನ್, ಡುಯಿ ಬೊಳ್ಸುಂಗಿಹಿಸಾರಿ ಕರ್ನಾರ್. ಏಕ್ಚಾ ಯೊಕ್ ಲ್ಯೊಕ್ ಮರುನ್ಜಾತೊ ತಸ್ ರಡುನ್ ಗಪವ್ಹಯಿಸಾರ್ ಕರ್ನಾರ್. ತ್ಯೊ ದಿಸ್ ತುಮಾನಾ ವಾಯಿಟ್ ದಿಸ್ ವ್ಹನಾರ್.<verse eid="AMO 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 8:11" />ಬಗಾ“ ದಿಸ್ ಯಯಾಚ಼ ಹಾತ. ತಿಸಿ ದೆಶೆವ ಬರ್ಗಾಲ್ ಯಯಿಸಾರಿ ಕರ್ನಾರ್. ತ್ಯ ಆನಾಸಾಟಿ ಬರ್ಗಾಲ್ ನವ್ಹ, ಪಾನ್ಯಾಸಾಟಿ ಬರ್ಗಾಲ್ ನವ್ಹ; ಪರಮೆಸ್ವರಾಚಾ಼ ವಚ಼ನಾಲಾ ಬುಖಚ಼ ಬರ್ಗಾಲ್. ದೆವ್ ಪರಮೆಸ್ವರ್ ಆಸಾ ಮಂಥೊ. <verse eid="AMO 8:11" /><verse number="12" style="v" sid="AMO 8:12" />ಲೊಕ ಸಮಿಂದೊರಾತ್ನಿ ಸಮಿಂದೊರಾಪರ‍್ಯಾತ್ ಉತ್ತರಾತ್ನಿ ಪೂರ್ವಾ ಪರ‍್ಯಾತ್ ಮಾಗ ಮೊರ‍್ಹ ದೆವಾಚ಼ ವಾಕ್ಯ ಸೂದಿತ್ ದಮ್ನಾರ್. ತರಿಬಿ ತ್ಯ ಗಾವ್ನಾರ್ನಾಹಿ. <verse eid="AMO 8:12" /><verse number="13" style="v" sid="AMO 8:13" />ತ್ಯಾ ದಿಸಾತ್ ಗಟ್ಮುಟ್ ಆಸಲ್ಯಾಲ ಪ್ಯೊರ್ಗ ಪೂರಿ ತಾನಚಾ ಸೊಕಾನಿ ಬವಂಡ್ಯವುನ್ ಪಡ್ನಾರ್. <verse eid="AMO 8:13" /><verse number="14" style="v" sid="AMO 8:14" />ಕೊನ್ ಸಮಾರ‍್ಯಾಚಾ ಮುರತ್ಯಾವ್ನಿ ಶಿಪ್ತಿ ಗಾಲುನ್ ದಾನ್, ತುಜಾ಼ ದೆವಾ ಜಿವಂತ ಹಾ ’ ಬೆರ್ಶೆತಲ್ಯಾ ಯಾತ್ರಾ ಜಿವಂತ್ ಹಾ’ ಮನ್ಹುನ್ ಸಾಂಗತಾಸಾ ಹ್ಯ ಸಗ್ಳ ಪಡ್ನಾರ ಆನಿ ಕಂದಿಸ್ ಉಠ್ನಾರ್ನಾಹಿ.<verse eid="AMO 8:14" /></para>
  <chapter eid="AMO 8" />
  <chapter number="9" style="c" sid="AMO 9" />
  <para style="s">ದೆವಾಚಾ಼ ಸಾಂಗ್</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1" />ತವಾ ಪರಮೆಸ್ವರ್ ಸ್ವಾಮಿ ಬಲಿದೆತ್ಯಾಲ್ಯಾ ಜಾ಼ಗ್ಯಾಪ ಉಬಾರಾಲ್ಯಾಲಾ ಬಗ್ಲಾ. ತ್ಯಂಚಾನಿ ಮನಾ ಆಸಿ ಆಜ್ಞಾ ಕಿಲಿ: “ಹುಂಬ್ರ ಹಾಲಶಾರ್ಕ ಖಾಂಬಾಚಾ ತಳಾವ ಜೊ಼ರಾನಿ ಮ್ಯಾರ್. ತೆ ಹಾಲುನ್ ಸಗಳ್ಯಾಂಚೆ ಡುಯಿವ ಪಡುಂತ. ಉರಲ್ಯಾಲ್ಯಾನಾ ತಲ್ವಾರಾನಿ ಕ್ಯಾಡತೊ.ತ್ಯಂಚಾತ್ಲಿ ಕೊನ್ ಪಳುನ್ ಜಾ಼ನಾರರ್ನಾಹಿತ; ಕೊನ್ ಚು಼ಕ್ನಾರ್ನಾಹಿ. <verse eid="AMO 9:1" /><verse number="2" style="v" sid="AMO 9:2" />ತೇ ಪಾತಾಳಾತ್ ಉತ್ರುನ್ ಗೆಲತರಿ ತ್ಯನಾ ತಿತ್ನಿ ಮಾಜಾ಼ ಹಾತ್ ವಡುನ್ ಆನ್ನಾರ್. ಆಬ್ಳಾತ್ ಚ಼ಡ್ಲತರಿ ತಿತ್ನಿ ಉತ್ತರ್ನಾರ್. <verse eid="AMO 9:2" /><verse number="3" style="v" sid="AMO 9:3" />ಕರ್ಮೆಲಿಚಾ ಗುಢ್ಯಾಚಾ ಟೊಕಾವ ದಡ್ಲತರಿ ತ್ಯನಾ ಸೂದುನ್ ತಿತ್ನಿ ದರುನ್ ಆನ್ನಾರ್. ಮಾಜಾ಼ ಡೊಳಾ ಚು಼ಕ್ವುನ್ ಸಮಿಂದೊರಾಚಾ ತಳಾತ್ ದಡ್ಲತರಿ, ತಿಥಬಿ ತ್ಯನಾ ಚಾ಼ವಾಯಾ ಸಾಪಾಲಾ ಆಜ್ಞೆ ಕರ‍್ನಾರ. <verse eid="AMO 9:3" /><verse number="4" style="v" sid="AMO 9:4" />ಶತ್ರುಂಚಾನಿ ದರುನ್ ಕ್ಯೊಂಡ್ಲತರಿ ತಿಥಬಿ ತಲ್ವಾರ್ ಮಾಜೆ ಆಜ್ಞೆಸಾರ ತ್ಯನಾ ಮ್ಯಾರ‍್ನಾರ್; ತ್ಯಂಚಾ ಬರ‍್ಯಾಲಾ ನವ್ಹ, ವಾಯಿಟಾಲಾಸ್ ತ್ಯಂಚಿವ ಡೊಳಾ ಥೆವ್ನಾರ್.”<verse eid="AMO 9:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="AMO 9:5" />ಸರವ್ಯಾಚಾ಼ ದೆವ್ ಪರಮೆಸ್ವರಾನಿ ಹಾತ್ ಲ್ಯಾವಲ್ಯಾಲ್ಯಾಲಾ ಇರ್ಗಾಳ್ನಾರ್ ದರ್ಥಿ.</para>
  <para style="q2" vid="AMO 9:5">ಆನಿ ದುಖಾತ್ ಪಡ್ನಾರ್ ಸಗ್ಳಿ ಲೊಕ,</para>
  <para style="q2" vid="AMO 9:5">ಆನಿ ಫುಗ್ನಾರ್ ದೆಶಾಸಗ್ಳಿ ನೈಲ್ ನ್ಹಚೆಗತ್,</para>
  <para style="q1" vid="AMO 9:5">ಆನಿ ಬಾರಿಕ್ ವ್ಹವುನ್ ಇರ್ಗಾಳ್ನಾರ್ ಈಜಿಪ್ಟಾಚಾ ನ್ಹಚೆಗತ್.<verse eid="AMO 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 9:6" />ವರ್ ಖುಬ್ ಮಾಡ್ಯಾ ಬಾಂದುನ್</para>
  <para style="q2" vid="AMO 9:6">ದರ‍್ಥಿವ ಆಬಾಳ್ ಸ್ತಾಪನ್ ಕೆಲ್ಯಾಲಾ</para>
  <para style="q1" vid="AMO 9:6">ಸಮಿಂದೊರಾಚ಼ ಪಾನಿ ಆನುನ್</para>
  <para style="q2" vid="AMO 9:6">ದರ‍್ಥಿವ ವತ್ಯಾಲಾ ತ್ಯಚ಼</para>
  <para style="q1" vid="AMO 9:6">ನಾವ್ ಪರಮೆಸ್ವರ್ ದೆವ್.<verse eid="AMO 9:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="AMO 9:7" />ದೆವ್ ಮಂಥೊ "ಇಸ್ರಾಯೆಲಚಾ ಲೊಕಾನು, ಮಾಜೆ ನದ್ರಲಾ ತುಮಿ ನಾಹಿತ ಎಥಿಯೊಪ್ಯಾತ್ಲಿ, ಎಕುಸ್ ನವ್ಹಕ್ಯಾ? ಮಿ ತುಮಾನಾ ಇಜಿಪ್ಟಾತ್ನಿ ಹಾಕ್ಟುನ್ ಆನಲ್ಯಾಸಾರ ಪಿಲಿಶ್ಟಾನಾ ಕಪ್ತೊರಿತ್ನಿ, ಅರಾಮ್ಯಾನಾ ಕಿರಾತ್ನಿ ಆನ್ಲಿ ನಾಹಿತ ಕ್ಯಾ? <verse eid="AMO 9:7" /><verse number="8" style="v" sid="AMO 9:8" />ಬಗಾ "ದನ್ಹಿ ಪರಮೆಸ್ವರ್ ಜಾಲ್ಯಾಲೊ ಮಿ ಹ್ಯಾ ಪಾಪಿ ರಾಜಾವ ಡೊಳಾ ಥೆವಲ್ಯಾಮನ್ಯಾಚ಼ ಲಕ್ಶೆತ್ ಥೆವಾ. ಹ್ಯ ದರ‍್ಥಿವ್ನಿ ನಾಸ್ಕರ‍್ನಾರ್. ಫನ್ ಯಾಕೋಬಾಚ಼ ಗರ‍್ಹಾನ ಸರ‍್ವ ನಾಸ್ಕರ್ನಾಹಿ.” ಹ್ಯೊ ಪರಮೆಸ್ವರ್ ದೆವಾಚಾ಼ ಸಬ್ದ.<verse eid="AMO 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 9:9" />“ಬಗ್, ದಾನ ಚಾ಼ಳ್ನಿನಿ ಚಾಳ್ಯಾಚೆಗತ್ ಇಸ್ರಾಯೆಲಾನಾ ಸಗಳ್ಯಾ ಲೊಕಾತ್ನಿ ಮಿಸಳುನ್ ಚಾ಼ಳಾಯಾ ವ್ಹಯಿ ಮನ್ಹುನ್ ಆಜ್ಞಾ ಕರ‍್ನಾರ್. ಯೊಕ್ ದಾನಾಬಿ ಜಿಮ್ನಿವ ಶಾಂಡನಾರ್ನಾಹಿ. <verse eid="AMO 9:9" /><verse number="10" style="v" sid="AMO 9:10" />ಆಮಾನಾ ಕಾಯ್ ವಾಯಿಟ್ ವ್ಹನಾರ‍್ನಾಹಿ. ಕಾಯ್ ಆಪಾಯ್ ಆಡ್ವ ಯನಾರ‍್ನಾಹಿ’ ಮಂತ್ಯಾಲ್ಯಾ ಮಾಜಾ ಲೊಕಾತ್ಲಿ ಪಾಪಿ ಸಗ್ಳಿ ತಲ್ವಾರಾನಿ ಮರ‍್ನಾರ್.”’<verse eid="AMO 9:10" /></para>
  <para style="s">ಇಸ್ರಾಯೆಲ್ ಪರ್ತುನ್ ಬ್ಯಾನ್ನಾರ್</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 9:11" />ಪರಮೆಸ್ವರ್ ಆಸಾ ಮಂತ್ಯೊ: “ ದಿಸ್ ಯನಾರ್. ತವಾ ಪಡಲ್ಯಾಲ ದಾವಿದಾಚ಼ ಖೊಪಾಟ್ ಆನಿಕ್ ಉಚ಼ಲ್ನಾರ್. ತ್ಯಚಾ ಕರ್ಕಾ ಜಾಕ್ನಾರ್. ಪಡಲ್ಯಾಲ ಉಚ಼ಲುನ್ ಉಬ ಕರ‍್ನಾರ್. ಆಂದಿ ಹುತ್ತ ತಸಸ್ ಆನಿಕ್ ಬ್ಯಾನ್ನಾರ್. <verse eid="AMO 9:11" /><verse number="12" style="v" sid="AMO 9:12" />ಆಸ ಮಾಜಿ ಲೊಕ ಎದೊಮಿಚಾ಼ ಉರಲ್ಯಾಲಾ ಭಾಗ್ ಪರಮೆಸ್ವರಾಚಿ ಪರ‍್ಜೆ ಮಂತ್ಯಾಲ್ಯಾ ಸಗಳ್ಯಾ ಲೊಕಾನಾ ತಾಬ್ಯಾತ್ ಗೆನ್ಹಾರ್.” ಹ್ಯ ಕಾಮ್ ಸಾದಸ್ನಾರ‍್ಯಾ ಪರಮೆಸ್ವರ್ ದೆವಾಚಿ ಬುಲಿ ಹಿ:<verse eid="AMO 9:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="AMO 9:13" />“ಪರಮೆಸ್ವರ ಮಂಥೊ ಕಾಲ್ ಯನಾರ್”:</para>
  <para style="q2" vid="AMO 9:13">ತವಾ ನವಿನಿ ಪೆರ‍್ನಾರ್ ಕ್ಯಾಪ್ನಾರ‍್ಯಾಚೆ ಮಾಗಸ್;</para>
  <para style="q2" vid="AMO 9:13">ನವ ಪಿಕ್ ತಯಾರ್ ವ್ಹನಾರ್ ದ್ರಾಕ್ಶಿ ತುಡಿವತ್ಯಾಲ್ಯಾಚೆ ಮೊರ‍್ಹಸ್.</para>
  <para style="q1" vid="AMO 9:13">ದ್ರಾಕ್ಶಿಚ಼ ಪಿಕ್ ಎನಾರ್,</para>
  <para style="q2" vid="AMO 9:13">ತವಾ ಪರ್ವತಾವ ಗೊಡ್ ದರಾಕ್ಶಿಚಾ಼ ರಸ್ ವತ್ನಾರ್ ತವಾ ಬಾರಿಕ್ ಗುಡ್ಡ ವ್ಹಾವ್ನಾರ್.<verse eid="AMO 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 9:14" />ಇಸ್ರಾಯಲಾಚಿ ಮಾಜಿ ಲೊಕ ಬಂಜಾರ್ ಪಡಲ್ಯಾಲ್ಯಾ ಪೆಠಾ</para>
  <para style="q2" vid="AMO 9:14">ಆನಿಕ್ ಬಾಂದುನ್ ತ್ಯಾತ್ ರಾನ್ಹಾರ್.</para>
  <para style="q2" vid="AMO 9:14">ದ್ರಾಕ್ಶಿಚ಼ ಮಳ ಲಾವುನ್ ವ್ಹಯಿತಸಿ ದರಾಕ್ಶಿಚಾ ರಸ್ ಪಿನ್ನಾರ್.</para>
  <para style="q2" vid="AMO 9:14">ಬಾಗಾ ಲಾವುನ್ ವ್ಹಯಿತಸಿ ಫಳ ಖಾನಾರ್.<verse eid="AMO 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 9:15" />ಸ್ವತಾಚಾ ಗಾವಾತ್ ತ್ಯನಾ ಮಿ ಲ್ಯಾವ್ನಾರ್</para>
  <para style="q2" vid="AMO 9:15">ಮಿ ದಿಲ್ಯಾಲ್ಯಾ ಜಾ಼ಗ್ಯವ್ನಿ ಕಂದಿಸ್ ಉಠ್ವಾವನ್ನಾರ್ನಾಹಿ”</para>
  <para style="q1" vid="AMO 9:15">ಹ್ಯೊ ತುಜಾ಼ ದೆವ್ ಜಾಲ್ಯಾಲ್ಯಾ ಪರಮೆಸ್ವರಾಚಾ಼ ಸಬ್ದ.<verse eid="AMO 9:15" /></para>
  <chapter eid="AMO 9" />
</usx>