<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- Gawli Marathi</book>
  <para style="h">3 ಯೊಹಾನ್</para>
  <para style="toc3">3 ಯೊಹಾನ್</para>
  <para style="toc2">3 ಯೊಹಾನ್</para>
  <para style="toc1">ಯೊಹಾನಾನಿ ಲಿವ್‌ಲ್ಯಾಲ ತಿನ್ವ ಪತ್ರ</para>
  <para style="mt2">ಯೊಹಾನನು ಬರೆದ ಮುರನೆ ಪತ್ರ</para>
  <para style="mt1">ಯೊಹಾನಾನಿ ಲಿವ್‌ಲ್ಯಾಲ ತಿನ್ವ ಪತ್ರ</para>
  <para style="imt">ವಳಕ್</para>
  <para style="ip">ಯೊಹಾನಾನಿ ಲಿವಲ್ಯಾಲ ತಿನ್ವ ಪತ್ರ ಅಪೊಸ್ತಲ್ ಯೊಹಾನ್ ಕ್ರಿಸ್ತ ಜ಼ಲಾಮಲ್ಯಾವ ಪನ್ನಾಸಾಸ್ನಿ ಶೆಂಬರ್ ವರ್ಸಾಂಚೆ ಮದ್ದಿ ಲಿವಲ್ಯಾ ಯೊಹಾನಾನಿ ಆಪ್ನಿಸ್ ಲಿವಲ್ಯಾ ಆಸ ದಾವುನ್ದಿಲ ನಾಹಿ ಖರ ಆಪ್ನು ಯೊಕ್ ಜಾಂತಾ ಆಸಾ ಮನ್ಹುನ್ ಗೆತೊ<char style="xt"><ref loc="3JN 1:1">1:1</ref> </char>ತ್ಯನಿ ಆಪನಿ ಲಿವಲ್ಯಾಲ್ಯಾ ದೊನವ್ಯಾ ಪತರ‍್ಯಾತ್ ಸಾಂಗಲ್ಯಾ ಶಾರ್ಕ ಸಾಸ್ತೊ<char style="xt"><ref loc="3JN 1:1">1:1</ref> </char>ಯೊಹಾನಾನಿ ಲಿವಲ್ಯಾಲಿ ಬರಿ ಖಬರ್ ಆನಿ ತಿನ್ ಪತ್ರಿ ಎಕ್ ದೊನ್ ತಿನ್ ಯೊಹಾನ್ ಹ್ಯೊ ಯೊಹಾನ್ ಎಪೆಸಾತ್ ರಾತಾನಾ ಲಿವಲ್ಯಾ ಮನ್ಹುನ್ ಇಸ್ವಾಸ್ ಥಿವುನ್ ಹಾ.</para>
  <para style="ip">ಯೊಹಾನಾನಿ ಹ್ಯ ಪತ್ರ ಗಾಯುಸ್ ಮಂತ್ಯಾಲ್ಯಾ ನಾವಾಚಾ ಯಕಾ ಮಾನ್ಸಾಲಾ ಲಿವಲ್ಯಾ ತ್ಯೊ ಗಾಯಸ್ಲಾ ಆಪ್ಲಾ ವಾಂಗೊಡ್ದಾರ್ ಮಂತೊ ಆನಿ ತ್ಯಾ ಜಾ಼ಗ್ಯಾವ್ನಿ ಪ್ರಯಾನ್ ಕರ್ತ್ಯಾಲ್ಯಾ ಕ್ರಿಸ್ತಾವ ಇಸ್ವಾಸ್ ಥೆವಲ್ಯಾಲ್ಯಾ ಬಾವ್ಹಾಂಚಾ಼ ಉಪಚಾರ್ ಕರಾಯಾ ತ್ಯಲಾ ಸುಸ್ನಾ ದೆತೊ.</para>
  <para style="iot">ಭಾಗ</para>
  <para style="io1">1. ಯೊಹಾನ್ ಆಪಲ್ಯಾ ಪತರ‍್ಯಾಚಿ ವಳಕ್ ಕರುನ್ ದೆತೊ<char style="ior"><ref loc="3JN 1:1">1:1</ref> </char></para>
  <para style="io1">2. ಮಂಗ್ ತ್ಯೊ ಗಾಯುಸ್ಲಾ ಉಮೆದ್ ದೆತೊ ಆನಿ ಬಾವ್ಹಾಂಚಾ಼ ಉಪ್ಚಾರ್ ಕರಾಯಾ ತ್ಯಲಾ ಸುಸ್ನಾ ದೆತೊ<char style="ior"><ref loc="3JN 1:2-8">1:2-8</ref> </char></para>
  <para style="io1">3. ಮಂಗ್ ದ್ರಿಯೊತಿಪಸ್ ಆನಿ ದೆಮೆತ್ರಿ ಮಂತ್ಯಾಲ್ಯಾ ದೊನ್ ಮಾನ್ಸಾಂಚೆ ಗುಸ್ಟಿತ್ ಬೊಲ್ತೊ<char style="ior"><ref loc="3JN 1:9-12">1:9-12</ref> </char></para>
  <para style="io1">4. ಸರ್ತ ತ್ಯೊ ಆಪ್ಲ ಪತ್ರ ಸಪಿವತೊ<char style="ior"><ref loc="3JN 1:13-14">1:13-14</ref> </char></para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />ಸಭೆಚಾ಼ ಜಾಂತಾ ಮೀ, ಪುರ‍್ಯಾ ಮನಾನಿ ಮಾಯಾ ಕರ್ನಾರ‍್ಯಾ ಮಾಯೆಚಾ ಗಾಯಾ ಮಂಥ್ಯಾಲ್ಯಾಲಾ ಲಿವಾಚ಼ ಕ್ಯಾಮಂಜೆ; <verse eid="3JN 1:1" /><verse number="2" style="v" sid="3JN 1:2" />ಮಾಯೆಚಾ, ತು, ತುಜಾ ಮನಾಚೆ ಗುಸ್ಟಿತ್ ವರ್ ಆಲ್ಯಾಸ್ ತಸಾ, ಸಗ್‍ಳ್ಯಾ ಗುಸ್ಟಿತ್ನಿ ವರ್ ಯವುನ್, ಬರಾ ವ್ಹಯಾ ವ್ಹಯಿಸ್ ಮನ್ಹುನ್ ಮೀ ಮಾಗ್ನ ಕರ್ತೊ. <verse eid="3JN 1:2" /><verse number="3" style="v" sid="3JN 1:3" />ಬನ್ಹಿ ಬಾಹು ತವಾ ತವಾ ಮಾಜಿಪ ಯವುನ್, ತುಜಿಪ್ಲ ಖರ‍್ಯಾಚೆ ಗುಸ್ಟಿತ್ ಆನಿ ತು ಖರ‍್ಯಾನಿ ಹಾಸ್ ಮನ್ಹುನ್ ಸಾಂಗ್‍ತ್ಯಾಲ ಐಕ್ಲ ತವಾ, ಮನಾ ಖುಬ್ ಆನಂದ್ ಜಾ಼ಲ್ಹಾ. <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />ಮಾಜಿ ಲೊಕ ಖರ‍್ಯಾನಿ ಚಾ಼ಲತ್ಯಾತ ಮನ್ಹುನ್ ಐಕ್‍ಲ್ಯಾಲ್ಯಾವ್ನಿ ಖುಬ್ ಆನಂದ್ ಮನಾ ನಾಹಿ.<verse eid="3JN 1:4" /></para>
  <para style="s">ಗಾಯಾಚೆ ಗುಸ್ಟಿತ್ ಸಾಂಗಾಚ಼</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5" />ಮಾಯೆಚಾ, ತು ಇಸ್ವಾಸಿ ಬನ್ಹಿ ಬಾವ್ಹಾಂಚೆ ಮದ್ದಿ ಇಸ್ವಾಸಾನಿ ಕಾಮ ಕರ್ತೊಸ್. <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />ತೇ ಮಂಡಳಿಚೆ ಮೊರ‍್ಹ ತು ದ್ಯಾವ್‍ಲ್ಯಾಲೆ ಮಾಯೆಚೆ ಗುಸ್ಟಿತ್ ಸಾಕ್ಷಿ ದೆತ್ಯಾತ. ತೇ ಆಪ್ಲ ಜಾ಼ನ ಆಜು಼ನ್ ಮೊರ‍್ಹ ಸುರುಕರಾಯಾ ದೇವಾಲಾ ಆವ್ಡಸಾರ ತು ಕರಾಯಾವ್ಹಯಿ. <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />ಕಾಮಂಜೆ, ತೇ ಕ್ರಿಸ್ತಾಚಾ ನಾವಾಸಾಟಿ ಬಾಹಿರ್ ಪಡ್‍ಲ್ಯಾತ. ಇಸ್ವಾಸಾತ್ ನಸ್‌ಲ್ಯಾಲ್ಯಾನಾ ಕಾಯ್ ಗೆನ್ಹಾರ ನವ್ಹತ. <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />ಮನ್ಹುನ್, ಆಮಿ ಖರ‍್ಯಾಸಾರ ಚಾ಼ಲ್ತಾವ್ , ತಸ್‍ಲ್ಯಾನಾ ಮಿಳಿವ್‍ನಾರ‍್ಯಾ ಉಪಕಾರಾತ್ ಹಾವ್.<verse eid="3JN 1:8" /></para>
  <para style="s">ದಿಯೊತ್ರೆ ಆನಿ ದೆಮೆತ್ರಿ</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />ತುಮ್ಚೆ ಮಂಡಳಿಲಾ ಮೀ ಥೊಡ್ಯಾ ಬೊಲ್ಯಾ ಲಿವ್‍ಲ್ಯಾತಾ; ತಿತ್ಲೆ ಮಂಡಳಿಲಾ ದಿಯೊತ್ರೇಫ ಆಪ್ನುಸ್ ಫುಡಾರಿ ವ್ಹಯಾಲಾ ಬಗ್ತೊ ಮನ್ಹುನ್ ಆಮ್ಚಾ ಬೊಲ್ಯಾ ಐಕತ್ನಾಹಿ. <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />ಮನ್ಹುನ್, ಮೀ ತಿಥ ಆಲೊ ತವಾ ತ್ಯನಿ ಕೆಲ್ಯಾಲ್ಯಾ ಕಾಮಾಚೆ ಗುಸ್ಟಿತ್ ಸಗ್‍ಳ್ಯಾನಾ ಸಾಂಗ್ನಾರ್. ತ್ಯೊ ಪೊಕಾಂಡ್ಯಾ ಸಾಂಗಿತ್, ಆಮ್ಚೆ ಗುಸ್ಟಿತ್ ಆವ್ಮಾನ್ ಕರ್ತೊ. ಹ್ಯಾಸ್ ಲಾಗುನ್ ಕಚಾ಼ಸ್ ಬಾಹು ಮಿಳ್ವುನ್ ಗಿಹಿತ್ನಾಹಿ ಆನಿ ಮೀ ಮಿಳ್ವುನ್ ಗೆತ್ಯೊ ಮಂಜೆ ಥಾಂಬ್ವುನ್ ತ್ಯನಾ ಮಂಡಳಿತ್ನಿ ಬಾಹಿರ್‌ಗ್ಯಾಲ್ತೊ.<verse eid="3JN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11" />ಮಾಯೆಚಾ, ತು ವಾಯಿಟ್ ವಾಟನಿ ಜಾ಼ಯಾಚೆ ಆಂದಿ, ಚಾ಼ಂಗ್ಲೆ ವಾಟನಿ ಚಾ಼ಲ್; ಬರ ಕರ್ನಾರಾ ದೇವಾಚಾ಼ ಲ್ಯೊಕ್ ಜಾ಼ಲ್ಯಾ. ವಾಯಿಟ್ ಕರ್ನಾರ‍್ಯಾನಿ ದೇವಾಲಾ ಬಗ್‍ಲ್ಯಾಲಾ ನಾಹಿ.<verse eid="3JN 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="3JN 1:12" />ದೇಮೇತ್ರಿ ಸಂಗಳ್ಯಾಚಾಪ್ನಿ, ಚಾ಼ಂಗ್ಲಾ ಮನ್ಹುನ್ ಗೆತ್ಯಾಲಾ. ನಾಹಿತ ಸಾಕ್ಷಿ ಗೆತಲ್ಯಾಲಾ; ಆಮ್ಚಿ ಸಾಕ್ಷಿ ಖರಿ ಹಾ ಮನ್ಹುನ್ ತುಲಾ ಠಾವಿ ಹಾಕ್ಯಾ.<verse eid="3JN 1:12" /></para>
  <para style="s">ಸರತಾ ನಮಸ್ಕಾರ್</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />ಮೀ ತುಲಾ ಲಿವಾಯಾ ವ್ಹಯಿತಾ ತ್ಯಾ ಖುಬ್ ಗುಸ್ಟಿ ಹಾತಾ, ಫನ್ ಪೆನಿಚೆ ಸಾಯಿನಿ ಲಿವಾಯಾ ಮನಾ ಮನ್ ನಾಹಿ. <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />ಮೀ ಬಿಗಿನ್ ಯವುನ್ ತುಲಾ ಬಗಾಯಾ ಮನ್ ಕರ್ತೊ. ತವಾ ಆಮಿ ಯಕಾ ಮಕಾಸಂಗ ಬುಲುಯಾ. <verse eid="3JN 1:14" /><verse number="15" style="v" sid="3JN 1:15" />ತುಲಾ ಥಂಡ್ಪನ್ ರಾವುನಿ. ಸುಪ್ತಿ ತುಲಾ ನಮಸ್ಕಾರ್ ಸಾಂಗ್ತಿಲ. ತಿಥ ಪರ್ತೆಕ್ ಸೊಪ್‍ತ್ಯಾನಾ ಸಗ್‍ಳ್ಯಾನಾ ನಾವ್ ಗಿಹುನ್ ನಮಸ್ಕಾರ್ ಸಾಂಗ್.<verse eid="3JN 1:15" /></para>
  <chapter eid="3JN 1" />
</usx>