<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PHM" style="id"/>
  <para style="h">ಪಿಲೊಮೊನ್</para>
  <para style="toc3">ಪಿಲೊಮೊನ್</para>
  <para style="toc2">ಪಿಲೊಮೊನ್</para>
  <para style="toc1">ಪೌಲಾನಿ ಪಿಲೆಮೋನಾಲಾ ಲಿವ್‌ಲ್ಯಾಲ ಪತ್ರ</para>
  <para style="mt2">ಪೌಲನು ಪಿಲೆಮೊನನಿಗೆ ಬರೆದ ಪತ್ರಿಕೆ</para>
  <para style="mt1">ಪೌಲಾನಿ ಪಿಲೆಮೋನಾಲಾ ಲಿವ್‌ಲ್ಯಾಲ ಪತ್ರ</para>
  <para style="imt">ವಳಕ್‌</para>
  <para style="ip">ಫಿಲೆಮೊನಾಲಾ ಲಿವ್‌ಲ್ಯಾಲ ಪತ್ರ ಮಂಥ್ಯಾಲ ಬ್ಯಾರ್ಕ ಪುಸ್ತಕ್ ಅಪೊಸ್ತಲ್ ಪೌಲಾನಿ ಲಿವ್‌ಲ್ಯಾ <char style="xt"><ref loc="PHM 1:1">1:1</ref></char> ಹ್ಯ ಪತ್ರ ಲಿವ್ತಾನಾ ಪೌಲ್ ತುರುಂಗಾತ್ ಹುತ್ತಾ. ಆಸ ಆಸ್ಥಾನಾ ಖುಬ್ ಕರುನ್ ತ್ಯನಿ ಹ್ಯ ಪತ್ರ ರೊಮ್ ಪೆಠತ್ ಲಿವ್‌ಲ್ಯಾಲ ಆಸಲ್. ತ್ಯೊ ರೊಮಾತ್ ಆಸ್ಲಾತ ಹ್ಯ ಪತ್ರ ಕ್ರಿಸ್ತ್ ಜ಼ಲ್ಮುನ್ 61 ವರ್ಸಾ ನಂತರ್ ಲಿವ್‍ಲ್ಯಾ. ಕೊಲೊಸ್ಸೆತ್‌ಲ್ಯಾನಾ ಲಿವ್‌ಲ್ಯಾಲ ಪತ್ರ ಸಾಹಿತ್ ಹ್ಯಾಸ್ ಯಳಾತ್ ಲಿವ್‌ಲ್ಯಾ.</para>
  <para style="ip">ಹ್ಯ ಪತ್ರ ತ್ಯನಿ ಫಿಲೆಮೊನ್ ಮಂಥ್ಯಾಲ್ಯಾ ಯಕಾ ಮಾನ್ಸಾಲಾ ಲಿವ್‌ಲ್ಯಾ. ಫಿಲೆಮೊನ್ ಯಕ ಸಭೆಚಾ಼ ಸದಸ್ಯ ಜಾ಼ಲ್ಥಾ ತ್ಯಚೆ ಸಂಗ ಯೊಕ್ ಗುಲಾಮಾಚಾ಼ ದನ್ಹಿ ಜಾ಼ಲ್ಥಾ. ಪೌಲಾನಿ ಫಿಲೆಮೊನಾಲಾ ಆಪ್ಲಾ ಗುಲಾಮ್ ಜಾ಼ಲ್ಯಾಲ್ಯಾ ಒನೆಸಿಮ್ ಮಂಥ್ಯಾಲ್ಯಾಲಾ ಶಿಕ್ಷೆ ದಿವುನಾಹಿ ಮನ್ಹುನ್ ಸಾಂಗಾಯಾ ಲಿವ್‌ತ್ಯೊ ಕಾ ಮಂಜೆ ಒನೆಸಿಮ್ ಫಿಲೆಮೊನಾಪ್ನಿ ಚು಼ರಿ ಕರುನ್ ಪಳುನ್ ಗೆಲ್ತಾ. ರೊಮಾಚಾ ಕಾನುನಾಚೆಗತ್ ಫಿಲೆಮೊನ್ ಒನೆಸಿಮನಾಲಾ ಮರ್ನಾಚಿ ಶಿಕ್ಷಾ ದಿಯಾಚಾ಼ ಹಾಕ್ ಹುತ್ತಾ. ಪೌಲ್ ಫಿಲೆಮೊನಾಲಾ ಒನೆಸಿಮನಾಲಾ ಯಕಾ ಇಸ್ವಾಸಿ ಬಾವ್ಹಾಚೆಗತ್ ಗಿಹ್ಯಾ ವ್ಹಯಿ. ಆನಿ ಪೌಲಾಪ್ನಿ ಒನೆಸಿಮನಾಲಾ ಯೊಕ್ ಸಂಗಚಾ಼ ಸೇವಕ್ ರಾಹ್ಯಾ ಸುಡುನ್ ದಿಯಾ ವ್ಹಯಿ ಮನ್ಹುನ್ ಸಲಹಾ ದೆತ್ಯಾಲ್ಯಾ ಫಿಲೆಮೊನಾಚ಼ ಮನ್ ಗೊಳ್ವಾಚ಼ ಸಂಬಾಶನ್ ಉಪೇಗ್ ಕರ್ತೊ <char style="xt"><ref loc="PHM 1:13-14">1:13-14</ref> </char></para>
  <para style="iot">ಭಾಗ್</para>
  <para style="io1">1. ಪೌಲಾನಿ ಫಿಲೆಮೊನಾಲಾ ವಂದಸ್‌ಲ್ಯಾಲ <char style="ior"><ref loc="PHM 1:1-3">1:1-3</ref> </char></para>
  <para style="io1">2. ನಂತರ್ ಪೌಲ್ ಫಿಲೆಮೊನಾಲಾ ಒನೆಸಿಮಲಾ ಯಕಾ ಇಸ್ವಾಸಿ ಬಾವ್ಹಾಚೆಗತ್ ಗಿಹ್ಯಾ ವ್ಹಯಿ ಮನ್ಹುನ್ ಮಾಗ್ತೊ <char style="ior"><ref loc="PHM 1:4-21">1:4-21</ref> </char></para>
  <para style="io1">3. ಪೌಲಾನಿ ಆಪ್ನು ಗಾವಾಯಾ ವ್ಹಯಿ ಮನ್ಹಾಚಾ಼ ಉದ್ದೆಶ್ ಸಾಂಗಿತ್ ಆನಿ ವಂದನ್ ಕರೀತ್ ಪತ್ರ ಸುಪಿವ್ತೊ <char style="ior"><ref loc="PHM 1:22-25">1:22-25</ref> </char></para>
  <chapter number="1" style="c" sid="PHM 1"/>
  <para style="s">ಸೊಪ ದೀಸ್</para>
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1"/>ಕ್ರಿಸ್ತ ಯೇಸುಚ಼ ತುರುಂಗಾಚಾ಼ ಆಳ್ ಜಾ಼ಲ್ಯಾಲಾ ಪೌಲ್, ಬಾಹು ಜಾ಼ಲ್ಯಾಲಾ ತಿಮೊಥೆ, ಆಮಾನಾ ಮಾಯೆಚೆ ಸಂಗ ಸೇವಕ್ ಜಾ಼ಲ್ಯಾಲಾ ಫಿಲೊಮೊನ್ ಮಂಥ್ಯಾಲ್ಯಾ ತುಲಾಬಿ, <verse eid="PHM 1:1"/><verse number="2" style="v" sid="PHM 1:2"/>ಆನಿ ಭನ್ ಜಾ಼ಲ್ಯಾಲಿ ಅಪ್ಪಿಯಲಾಲಾಬಿ, ಲಡಾಯಿತ್ ಸಂಗ ಆಸಲ್ಯಾಲ್ಯಾ ಅರ್ಖಿಪ್ಪಲಾಬಿ ತುಜಾ ಗರ‍್ಹಾತ್ ಮಿಳುನ್ ಯತ್ಯಾಲೆ ಸಭೆಲಾಬಿ ಲಿವಾಚ಼ ಕ್ಯಾ ಮಂಜೆ: <verse eid="PHM 1:2"/><verse number="3" style="v" sid="PHM 1:3"/>ಆಮಚಾ಼ ಬಾ ಜಾ಼ಲ್ಯಾಲ್ಯಾ ದೇವಾಪ್ನಿಬಿ, ಪ್ರಭು ಜಾ಼ಲ್ಯಾಲಾ ಯೇಸು ಕ್ರಿಸ್ತಾಪ್ನಿಬಿ ತುಮಾನಾ ಕ್ರಪಾ, ಶಾಂತಿ ವ್ಹವುನಿ.<verse eid="PHM 1:3"/></para>
  <para style="s">ಫಿಲೆಮೊನಾಚಿ ಮಾಯಾ ಆನಿ ಇಸ್ವಾಸ್</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4"/>ಪ್ರಭು ಜಾ಼ಲ್ಯಾಲ್ಯಾ ಯೇಸುವ ಥೆವ್‌ಲ್ಯಾಲಾ ಇಸ್ವಾಸ್ ಮಾಯಾ ಆನಿ ದೇವಾಚಾ ಲೊಕಾಂಚಿವ ಆಸ್‌ಲ್ಯಾಲೆ ತುಜೆ ಮಾಯೆಚೆ ಗುಸ್ಟಿತ್ ಐಕಲ್ಯಾ ಮನ್ಹುನ್, <verse eid="PHM 1:4"/><verse number="5" style="v" sid="PHM 1:5"/>ಮಿ ಮಾಗ್ನ ಕರ್ತಾನಾ ಕವಾಬಿ ತುಜಿ ಯಾದಕರುನ್ ಮಿ ದೆವಾಲಾ ಸ್ತೊತ್ರ ಕರ್ತೊ ಆನಿ ಇನಂತಿ ಕರ್ತೊ. <verse eid="PHM 1:5"/><verse number="6" style="v" sid="PHM 1:6"/>ಕ್ರಿಸ್ತಾಪ ಆಮಾನಾ ಗಾವಲ್ಯಾಲ್ಯಾ ಸಗ್‌ಳ್ಯಾ ಚಾ಼ಂಗಲ್ಯಾ ಗುಶ್ಟಿತ್ ತು ಸಮಜು಼ನ್ ಗೆಥೊಸ್. ಕ್ರಿಸ್ತಾಚಾ ಇಸ್ವಾಸಾತ್ ವಾಟದಾರ್ ವ್ಹವುನ್ ಕ್ರಿಸ್ತಾಲಾ ಖುಬ್ ಮೈಮಾ ವ್ಹಯಾ ವ್ಹಯಿ ಮನ್ಹುನ್ ಮಾಗ್ನ ಕರ್ತೊ. <verse eid="PHM 1:6"/><verse number="7" style="v" sid="PHM 1:7"/>ಮಾಜಾ ಬಾವ್ಹಾ, ತುಜಿಸ್ ಲಾಗುನ್ ಸಗ್‌ಳ್ಯಾ ದೇವಾಚಾ ಲೊಕಾಂಚಾ ಮನಾಲಾ ಉಮೇದ್, ಪ್ರೆರನ್ ಆಲೆಮನ್ಹುನ್ ತ್ಯಂಚೆ ಗುಶ್ಟಿತ್ ಆಸ್‌ಲ್ಯಾಲೆ ಮಾಯೆನಿ ಮನಾ ಖುಬ್ ಸಂತೊಶ್ , ಸಮಾದಾನ್ ಜಾ಼ಲ್ಹಾ.<verse eid="PHM 1:7"/></para>
  <para style="s">ಒನೆಸಿಮಾಸಾಟಿ ಪೌಲಾಚಿ ಇನಂತಿ</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8"/>ಹ್ಯಾ ಕಾರ್ನಾಸಾಟಿ ಕ್ರಿಸ್ತಾಪ ಮನಾ ವ್ಹಯಿ ತ್ಯವ್ಡಾ ಧೀರ್ ಹಾ ಮನ್ಹುನ್ ತು ಕರಾಯಾ ವ್ಹಯಿ ಜಾ಼ಲ್ಯಾಲಿ ಕಾಮ ತುಲಾ ದೆತೊ, <verse eid="PHM 1:8"/><verse number="9" style="v" sid="PHM 1:9"/>ತರಿಬಿ ಮಾಯೆಸ್ಲಾಗುನ್ ಮಿ ತುಜಿಪ ಮಾಕ್ತೊ, ಮಾಥಾರಾ ಆನಿ ಕ್ರಿಸ್ತಾಸಾಟಿ ಕ್ಯೊಂಡ್‌ಲ್ಯಾಲಾ ಪೌಲ್ ಹ್ಯ ಕರ್ತ್ಯೊ. <verse eid="PHM 1:9"/><verse number="10" style="v" sid="PHM 1:10"/>ಮಿ ತುರುಂಗಾತ್ ಕ್ಯೊಂಡ್‌ಲ್ಯಾಲಾ ವ್ಹವುನ್ ಮಾಜಾ ಲೇಕಾಚೆಗತ್ ಆಲ್ಯಾಲ್ಯಾ ಒನೆಸಿಮಾಚೆ ಗುಶ್ಟಿತ್ ತುಜಿಪ ಮಾಗ್ತೊ. <verse eid="PHM 1:10"/><verse number="11" style="v" sid="PHM 1:11"/>ತ್ಯೊ ಆಂದಿ ತುಲಾ ಉಪೇಗ್ ನಸ್‌ಲ್ಯಾಲಾ ಹುತ್ತಾ. ಆತಾ ತುಲಾಬಿ ಮನಾಬಿ ಉಪೇಗ್ ಆಸ್‌ಲ್ಯಾಲಾ ಜ಼ಾಲ್ಯಾ.<verse eid="PHM 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PHM 1:12"/>ಮನಾ ಜೀವಾತ್ಲಾ ಮಾಯೆಚಾ಼ ಜಾ಼ಲ್ಯಾಲ್ಯಾ ತ್ಯಲಾ ತುಜಿಪ ಲಾವುನ್ ದೇತ್ಯೊ. <verse eid="PHM 1:12"/><verse number="13" style="v" sid="PHM 1:13"/>ಮೀ ಬರೆ ಖಬರಿಸ್ ಲಾಗುನ್ ತುರುಂಗಾತ್ ಆಸ್ಥಾನಾ ಮನಾ ಸಿಕಿವ್‌ತ್ಯಾಚೆಗತ್ ತುಜೆ ಬದ್ಲಿ ತ್ಯಲಾ ಮಾಜಿಪಸ್ ಥಿವುನ್ ಗಿಹ್ಯಾ ವ್ಹಯಿ ಮನ್ಹುನ್ ಯವಜ್ನಾ ಕೆಲೆ. <verse eid="PHM 1:13"/><verse number="14" style="v" sid="PHM 1:14"/>ಫನ್ ತುಜಾ಼ ಉಪ್ಕಾರ್ ಪುರ‍್ಯಾ ಮನಾತ್ನಿ ರಾಹ್ಯಾ ವ್ಹಯಿ ಮನ್ಹುನ್ ಯವಜು಼ನ್ ತುಜಾ಼ ಹುಕುಮ್ ನಸ್ಥಾನಾ ಕಾಯ್ ಕರಾಯಾ ಮನಾ ಮನ್ ನಾಹಿ.<verse eid="PHM 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PHM 1:15"/>ತ್ಯೊ ಥೊಡಾ ಯೊಳ್ ತುಜಿಪ್ನಿ ದೂರ್ ಗೆಲ್ಯಾಲಾ ತು ತ್ಯಲಾ ಖಾಯಿಮುಸ್ ಸಂಗ ಗಿಹುನ್ ಗಿಹ್ಯಾಸಾಟಿಸ್ ಆಸಲ್; <verse eid="PHM 1:15"/><verse number="16" style="v" sid="PHM 1:16"/>ಹಿತ್ನಿ ಮೊರ‍್ಹ ತ್ಯೊ ಸೆವಕಾಚೆಗತ್ ರಾಹ್ಯಾಚ಼ ಸುಡುನ್ ಸೇವಕಾವ್ನಿ ಮೊಟಾ ಆಸ್‌ಲ್ಯಾಲಾ ಮಾಯೆಚಾ ಬಾವ್ಹಾಚೆಗತ್ ರಾಹ್ಯಾವ್ಹಯಿ. ತ್ಯೊ ಮನಾ ಖುಬ್ ಮಾಯೆಚಾ಼ ಆಸ್ಥಾನಾ ತುಲಾ ದುನೆಚೆಗತ್, ಪ್ರಭುಚಾ ಸಂಬಂದಾತ್ಬಿ ಆನಿ ಖುಬ್ ಮಾಯೆಚಾ಼ ರಾನ್ಹಾರ್.<verse eid="PHM 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17"/>ತು ಮನಾ ಸಂಗಚಾ಼ ಮನ್ಲಾಸ್ತ ಮನಾ ಗೆತಲ್ಯಾಚೆಗತ್ ತ್ಯಲಾಬಿ ಘೆ. <verse eid="PHM 1:17"/><verse number="18" style="v" sid="PHM 1:18"/>ಯೆಕ ಯಳಿ ತ್ಯಚಿಪ್ನಿ ತುಲಾ ಕಾಯ್ತರಿ ಲುಕ್ಷಾನ್ ಜಾ಼ಲಿತ ತ್ಯನಿ ತುಜ಼ ರೀನ್ ಕಾಯ್ತರಿ ದಿಯಾಚ಼ ರಾಯ್ಲತ ತ್ಯ ಮಾಜಾ ಲೆಖ್ಯಾತ್ ಗ್ಯಾಲ್. <verse eid="PHM 1:18"/><verse number="19" style="v" sid="PHM 1:19"/>ಮೀಸ್ ಫೆಡ್ತೊ ಮನ್ಹುನ್ ಪೌಲ್ ಮಂಥ್ಯಾಲಾ ಮಿ ಮಾಜಾ ಹಾತಾನಿಸ್ ಲಿವ್‌ಲ್ಯಾ. ತುಜಾ ಆತ್‌ಮ್ಯಾಚೆ ಗುಶ್ಟಿತ್ ತುಸ್ ಮನಾ ಹೊನೆಗಾರ್ ಜಾ಼ಲ್ಯಾಸ್ ಮನ್ಹುನ್ ಮೀ ಸಾಂಗಾಯಾ ವ್ಹಯಿ ಮನ್ಹುನ್ ನಾಹಿ. <verse eid="PHM 1:19"/><verse number="20" style="v" sid="PHM 1:20"/>ವ್ಹಯ್, ಬಾವ್ಹಾ, ಪ್ರಭುಪ ತುಜಿಪ್ನಿ ಮನಾ ಉಪಯೊಗ್ ವ್ಹಯಿಸಾರ. ಕ್ರಿಸ್ತಾಪ ಮಾಜ಼ ಮನ್ ಹೌಸ ಕರ್.<verse eid="PHM 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PHM 1:21"/>ತುಜೆ ವಿಧಯೆತ್ ಭರ್ವಾಸಾ ಆಸ್‌ಲ್ಯಾಶಾರ್ಕಾ ಹ್ಯ ಪತ್ರ ತುಲಾ ಲಿವ್‌ಲ್ಯಾ. ಮಿ ಸಾಂಗ್‌ತ್ಯಾಲ್ಯಾವ್ನಿ ಆಗಾವ್ ತು ಕರ್ನಾರ್ ಮನ್ಹುನ್ ಮನಾ ಠಾವ ಹಾ.<verse eid="PHM 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PHM 1:22"/>ಯವ್ಡಸ್ ನವ್ಹ ದೇವಾನಿ ತುಮ್ಚ಼ ಮಾಗ್ನ ಐಕುನ್ ಮಿ ತುಮ್ಚಿಪ ಯಯಾಲಾ ಕ್ರಪಾ ಕರ್ನಾರ್ ಮಂಥ್ಯಾಲಿ ಆಶಾ ಮನಾ ಹಾ.ಮನ್ಹುನ್ ಮಿ ರಾಹ್ಯಾಲಾ ಯೊಕ್ ಸೊಪಾ ತಯಾರ್ ಕರ್.<verse eid="PHM 1:22"/></para>
  <para style="s">ಸರ್ತಾ ನಮಸ್ಕಾರ್</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23"/>ಕ್ರಿಸ್ತ್ ಯೇಸುಸ್ ಲಾಗುನ್ ಮಾಜಿ ಸಂಗ ತುರುಂಗಾತ್ ಆಸ್‌ಲ್ಯಾಲಾ ಎಪಫ್ರ ತುಲಾ ದನ್ಯಾವಾದ್ ಸಾಂಗತ್ಯೊ. <verse eid="PHM 1:23"/><verse number="24" style="v" sid="PHM 1:24"/>ಆನಿ ತುಜಿ ಸಂಗ ಕಾಮ್ದಾರ್ ಜಾ಼ಲ್ಯಾಲಾ ಮಾರ್ಕ್, ಅರಿಸ್ತಾರ್ಕ, ದೇಮ, ಲುಕ್ ಹೇ ಸಗ್ಳ ತುಲಾ ದನ್ಯಾವಾದ್ ಸಾಂಗ್‌ತ್ಯಾತ.<verse eid="PHM 1:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25"/>ಆಮಚಾ಼ ಪ್ರಭು ಜಾ಼ಲ್ಯಾಲ್ಯಾ ಯೇಸು ಕ್ರಿಸ್ತಾಚಿ ಕ್ರಪಾ ತುಮ್ಚಾ ಆತ್‌ಮ್ಯಾ ಸಂಗ ರಾಹುನಿ. ತಸಸ್ ವ್ಹವುನಿ.<verse eid="PHM 1:25"/></para>
  <chapter eid="PHM 1"/>
</usx>
