<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HAB" style="id">- Gawli Marathi</book>
  <para style="h">ಹಬಕುಕ್</para>
  <para style="toca1">ಹಬಕುಕ್</para>
  <para style="toc2">ಹಬಕುಕ್</para>
  <para style="toc3">ಹಬಕುಕ್</para>
  <para style="mt2">ಪ್ರವಾದಿ ಹಬಕುಕಾಚ಼ ಪುಸ್ತಕ್</para>
  <para style="mt1">ಪ್ರವಾದಿ ಹಬಕುಕಾಚ಼ ಪುಸ್ತಕ್</para>
  <para style="imt">ವಳಕ್</para>
  <para style="ip">ಹ್ಯ ಪುಸ್ತಕ್ ಹಬಕುಕಾಚಾ ಪ್ರವಾದನೆನಿ ಬರಲ್ಯಾ. ಹಬಕುಕಾಚ಼ ಪುಸ್ತಕ್ ಇಸ್ರಾಯೆಲ್ ನಾಹಿತ ಯಹುದಾರಾಜಾನಾ ನಿಟ್ ಸಂದೆಸ್ ದಿಲ್ಯಾಲ ಪ್ರವಾದಿಂಚಾ ಪುಸ್ತಕಾತ್ ತರತರಚ಼ ಹಾ. ಹ್ಯಚೆ ಬದ್ಲಾಸ್, ಹ್ಯ ಹಬಹುಕಾಚಿ ದೊನ್ ಫಿರ‍್ಯಾದಿನಿ ಆನಿ ಮಾಗನ್ಯಾನಿ ಬರಲ್ಯಾ. ದೆವಾನಿ ತ್ಯಾ ಮಾಗನ್ಯಾನಾ ಉತ್ತರ್ ದಿಲಾ. ಹಬಕುಕಾನಿ ಯೆರೆಮಿಚಾ ಕಾಲಾತ್, ಸಂಗರಾಹುನ್ ರಾಜಾ಼ ಯೊಸಿಯಾ ಆನಿ ರಾಜಾ಼ ಯೆಹೊಯಾಕಿಮ್ ತ್ಯಂಚ಼ ಆಳ್ವಿಕಿತ ಜ಼ಗಲ್ಯಾತ ಮನ್ಹುನ್ ಶಾನ ನಂಬಲ್ಯಾತ. ಫನ್ ಹಬಕುಕ್ ಪುಸ್ತಕಾತ್ ನತ್ಹ ದುಸರ್‍ಯಾ ಕುಟಲ್ಯಾ ಪವಿತ್ರ ಗ್ರಂಥಾತ್ ತ್ಯೊ ಕುಟಲ್ಯಾ ಕಾಲಾತ್ ಹುತ್ತಾ ಮನ್ಹುನ್ ಶಾರ್ಕ ಠಾವ ನಾಹಿ.</para>
  <para style="ip">ಹಬಕುಕಾನಿ ಪಯಲ ದೆವಾಚೆ ಮೊರ್‍ಹ ಚು಼ಕ್ ಸಾಂಗ್ಲಿ: ತ್ಯೊ ತರಾಸ್ ಆನಿ ಆಡ್ವಫನ ಬಗಿತಾ, ಫನ್ ದೆವಲಾ ಮಜ಼ತಿಲಾ ಕೇಲ್ಯಾಲಾ ಮಾಗನ್ಯಾನಾ ಉತ್ತರ್ ದಿಯಿತ್ನಾಹಿಕಾನು. ಹಿ ಗಟ್ನಾ ಯೆಹೂದ್ ದೆಶೆತ್ ಜಾ಼ಲಿಆಸಲ್. ಹ್ಯಲಾ ದೆವಾನಿ ದಿಲ್ಯಾಲಾ ಉತ್ತರ್: “ಮಿ ಬಾಬಿಲೊನಾನಾ ಉಟಿವತ್ಯೊ; ತಿ ಯೆಹೂದ್ ನಾಸ್ ಕರ್ನಾರಿ ಹಾತ್ತ. “ಮಂಗ್ ಹಬಕುಕಾನಿ ಆನಿ ಯಂಗ್ದಾ ಫಿರ‍್ಯಾದ್ ಸಾಂಗ್ಲಿ. ದೆವಾನಿ ಕಠೊರಾನಾ ವಾಪ್ರುನ್ ಥೊಡ್ಯಾ ಕಠೊರಾನಾ ಸಿಕ್ಶೆ ದೆತ್ಯೊ ಮನ್ಹುನ್.ಸರ್ತಾನಾ, ಬಾಬಿಲೊನಿಯಾತ್ಲಬಿ ನ್ಯಾಯಿ ತಿರ್ಮಾಲಾ ರಾಯ್ಯಾವ್ಹಯಿತ ಹಬಕುಕ್ ದೆವಾಪ ಮಾಗ್ನ ಕರತೊ ದಯಾ ಸ್ಯೊಡ್ ಮನ್ಹುನ್ ಮಾಗ್ತೊ. ದೆವಾನಿ ಮಾಗಲ್ಯಾ ದಿಸಾತ್ನಿ ಕೆಲ್ಯಾಲಿ ಮತ್ವಾಚಿ ಕಾಮ ಹಬಕುಕ್ಕಾನಿ ಯಾದ್ ಕಿಲಿ.</para>
  <para style="iot">ಭಾಗ್</para>
  <para style="io1">ಅಧ್ಯಾಯ <char style="ior"><ref loc="HAB 1:1">1:1</ref>,<ref loc="HAB 1:4">4</ref></char> ಹಬಕುಕಾಚಿ ಪಯ್ಲಿ ಫಿರ‍್ಯಾದ್</para>
  <para style="io1">ಅಧ್ಯಾಯ<char style="ior"><ref loc="HAB 1:5">1:5</ref>,<ref loc="HAB 1:11">11</ref></char> ದೆವಾಚಾ಼ ಪಯ್ಲಾ ಉತ್ತರ್</para>
  <para style="io1">ಅಧ್ಯಾಯ <char style="ior"><ref loc="HAB 1:12">1:12</ref></char> <char style="ior"><ref loc="HAB 2:1">2:1</ref></char> ಹಬಕುಕಾಚಿ ದುನ್ವಿ ಫಿರ‍್ಯಾದ್</para>
  <para style="io1">ಅಧ್ಯಾಯ <char style="ior"><ref loc="HAB 2:2">2:2</ref>,<ref loc="HAB 2:20">20</ref></char> ದೆವಾಚಾ಼ ದೊನ್ವಾ ಉತ್ತರ್</para>
  <para style="io1">ಅಧ್ಯಾಯ <char style="ior"><ref loc="HAB 3">3</ref></char> ಹಬಕುಕಾಚಾ಼ ಜಾ಼ಬ್</para>
  <chapter number="1" style="c" sid="HAB 1" />
  <para style="p">
    <verse number="1" style="v" sid="HAB 1:1" />ಹಬಕುಕ್ ಪ್ರವಾದಿಲಾ ದಿಸಲ್ಯಾಲ ದೆವಾಚ಼ ದರ್ಶಾನ್.<verse eid="HAB 1:1" /></para>
  <para style="s">ಅನ್ನೆವಾಸಾಟಿ ಹಬಕುಕಾಚಿ ಫಿರ‍್ಯಾದ್</para>
  <para style="p">
    <verse number="2" style="v" sid="HAB 1:2" />ಪರಮೆಸ್ವರಾ ಮಿ ತುಜಿಪ ಕಿತ್ಕದಿಸ್, ಮಾಗ್ನ ಕರಾಯ ವ್ಹಯಿ? ತು ಮಾಜ಼ ಐಕಾಚೆ ಆಂದಿ ಕ್ಯವ್ಡದಿಸ್ ಗಪ್ರಾನ್ಹಾರ್? ತರಾಸ್ ವ್ಹತ್ಯೊ ಮನ್ಹುನ್ ಮಿ ವರಾಡ್ಲೊ; ತರಿಬಿ ರಕ್ಶನ್ಕರಾಚೆ ಆಂದಿ ತು ಗಪುಸ್ ಹಾಸ್ಕಾ? <verse eid="HAB 1:2" /><verse number="3" style="v" sid="HAB 1:3" />ಮಿ ನಾಸ್ ಬಗಿಶಾರ್ಕ ಕಾ ಕೆಲಾಸ್? ಮಿ ತರಾಸ್ ಬಗಿಸಾರಾ ಕಾ ಕೆಲಾಸ್? ಹಿಂಶಾ ದುಕ್ ಹಿಸ್ ಮಾಜಾ ಡೊಳ್ಯಾಮೊರ್ಹ. ಆತಾ, ಕಳ್ ಚಾ಼ಲ್ಲೆ, ವಾದ್ ಚಾ಼ಲ್ಯಾತ. <verse eid="HAB 1:3" /><verse number="4" style="v" sid="HAB 1:4" />ಮನ್ಹುನ್ ನ್ಯಾಯಿ ಕರಾಚಾ಼ ಲಾಗ್ತೊ, ನ್ಯಾಯಿ ತಿರ್ಪ್ ಕಂದಿಸ್ ಎಯಿತ್ನಾಹಿ” ದುಶ್ಟಾಂಚಾನಿ ನಿಯೆಂತಿಚಾನಾ ಎಡಾ ಗ್ಯಾತಲ್ಯಾ ಮನ್ಹುನ್ ಚು಼ಕಿನಿ ನ್ಯಾಯಿ ತಿರ್ಮಾನ್ ನಿಗ್ತೊ.<verse eid="HAB 1:4" /></para>
  <para style="s">ಪರಮೆಸ್ವರಾಚಾ಼ ಜ಼ಬಾಬ್</para>
  <para style="p">
    <verse number="5" style="v" sid="HAB 1:5" />ತವಾ ಪರಮೆಸ್ವರಾನಿ ಆಪಲ್ಯಾ ಲೊಕಾನಾ ಆಸ ಸಾಂಗ್ಲ: “ಲೊಕಾಂಚೆ ಮದ್ದಿ ಚಾ಼ಲತ್ಯಾಲ ನದ್ರನಿ ಬಗಾ. ಬಗಲ್ಯಾವ ಆಜಾಬ್ ವನ್ಹಾರ್. ತುಮ್ಚಾ ಕಾಲಾತ್ ಮಿ ಯಾಕ್ ಕಾಮ್ಕರ್ನಾರ್. ತ್ಯಚೆ ಗುಸ್ಟಿತ್ ತುಮಿ ತುಮ್ಚಾ ಕಾನಾನಿ ಐಕ್ಲಸಾ ತರಿ ತುಮಿ ಖರ ಮನ್ಹಾರ್ನಾಹಿಸಾ. <verse eid="HAB 1:5" /><verse number="6" style="v" sid="HAB 1:6" />ಆತಾ, ಬಾಬಿಲೊನಿತಲ್ಯಾನಾ ಬುಲ್ಹಿವ್ನಾರ್. ತಿ ಗಾತ್ಕಿ ಆನಿ ಆರ್ಮುಟ್ . ತಿ ದುನೆತ್ ಸಗಳಿಕ್ಡ ಪಗಳುನ್ ಆಪ್ಲಿ ನವ್ಹಜಾ಼ಲ್ಯಾಲೆ ಪ್ರದೆಶಾತ್ ಆಕ್ರಮನ್ಕರಾಯಾ ಜಾ಼ನಾರ್. <verse eid="HAB 1:6" /><verse number="7" style="v" sid="HAB 1:7" />ತಿ ಗಾತ್ಕಿ, ಬಯಂಕಾರ್ . ಆಪ್ಲಾಸ್ ಜಾ಼ಲ್ಯಾಲಾ ನ್ಯಾಯಿ ನಿಯೆತ್ ರಚಿವತ್ಯಾಲಿ; ಆಪಲ್ಯಾಲಾ ಆಪ್ನುಸ್ ಮರ‍್ಯಾದ್ ದೆತ್ಯಾಲಿ ಮೊಟ್ಯಾಫನಾಚಿ.<verse eid="HAB 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HAB 1:8" />ತ್ಯಂಚ಼ ಗೊಢ ನ್ಯಾನಗ್ಯಾಂಚಿವ್ನಿ ಘಟ್; ಬುಖಚಾ ಕುಳಿಸನ್ಯಾಂಚಿವ್ನಿ ಚುರುಕ್. ತ್ಯಂಚ಼ ಗೊಢ ಸವಾರ್ ಜೊ಼ರಾನಿ ಉಡಿ ಗೆನ್ಹಾರ್. ಸಿಕಾರಿಲಾ ಹಾವರ‍್ಯಾಫನಾನಿ ತಳಾಪತ್ಯಾಲೆ ಗಾರ‍್ಹಚೆಗತ್ ದುರ್ನಿಸ್ ದಾವ್ನಾರ್. <verse eid="HAB 1:8" /><verse number="9" style="v" sid="HAB 1:9" />ತರಾಸ್ ಮನಾತ್ ಥಿವುನ್ ಮೊರ‍್ಹ ಮೊರ‍್ಹ ಯನಾರ್. ವ್ಹಾಳತ್ಲೆ ರಿತಿಚಾ ಖಡ್ಯಾಂಚೆಗತ್ ಇಸೊಬ್ ನಾಹಿ ಯವಡ್ಯಾ ಲೊಕಾನಾ ಕ್ಯೊಂಡನಾರ್.<verse eid="HAB 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HAB 1:10" />“ತಿ ರಾಜಾನಾ ಹಿರ್ಮಟ್ನಾರ್; ಅದಿಕಾರ್ಯಾನಾ ಪರಿಹಾಶ ಕರ್ನಾರ್. ಕೊಟೆಂಚಾ಼ ದುಳ್ಳಾ ಕರ್ನಾರ್. ಮಾತಿಚ಼ ಟೆಂಬ ಗಾಲ್ಹುನ್ ಆಕ್ರಮನ್ಕರ್ನಾರ್. <verse eid="HAB 1:10" /><verse number="11" style="v" sid="HAB 1:11" />ವಾರಮುಡಿಚೆಗತ್ ಯವುನ್ ನಾಪತ್ಯಾ ವ್ಹನಾರಿ ತಿ; ಸ್ವತಾಚ ಬಳುಸ್ ದೈವ ಮಂತ್ಯಾಲಿ ಆಪರಾದಿ.”<verse eid="HAB 1:11" /></para>
  <para style="s">ದೆವಾಪ ಹಬಕುಕಾಚಿ ಪರ್ತುನ್ ಫಿರ‍್ಯಾದ್</para>
  <para style="p">
    <verse number="12" style="v" sid="HAB 1:12" />ಪರಮೆಸ್ವರ್, ಮಾಜಾ ಪವಿತ್ರಾ ದೆವಾ, ಪರಮ್ ಪಾವನ್ ದೆವಾ, ತು ಆಂದಿಸ್ಟಾವ್ನಿ ಆಸಲ್ಯಾಲಾ . ಆಮಿ ಖರ‍್ಯಾನಿ ಮರ‍್ನಾರ‍್ನಾಹಿ. ಆಮಾನಾ ಸಿಕ್ಶೆದಿಯಾ ತ್ಯಾ ಬಾಬಿಲೊನಿತಲ್ಯಾನಾ ಥರಿವಲ್ಯಾಲಿ ತುಸ್; ತ್ಯನಾ ಬಳಕಟಲ್ಯಾಲಿ ತುಸ್. ಆಮಚಾ಼ ಖಡೊಕ್ ತುಸ್. <verse eid="HAB 1:12" /><verse number="13" style="v" sid="HAB 1:13" />ವಾಯಿಟ್ ಬಗಿತ್ನಾಹಿ ಯವ್ಡ ನಿಸ್ಕಳಂಕ್ ತುಜ಼ ಡೊಳ. ವಾಯಿಟ್ ಸೊಸತ್ನಾಹಿ ಯವ್ಡಾ ಪವಿತ್ರ್ ತು. ಆಸ ಆಸ್ತಾನಾ ವಾಯಿಟಾಲಾ ಬಗುನ್ ಕಾ ಹಾಸ್? ದುಸ್ಟ ಸಿಸ್ಟಾನಾ ತಾಬಿವತ್ಯಾಲ ಬಗುನ್ ಗಪ್ ಕಾ ಹಾಸ್?<verse eid="HAB 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HAB 1:14" />ಮಾನ್ಸಾನಾ ಸಮಿಂದೊರಾತಲ್ಯಾ ಮಾಶಾ ಸಮಾನ್ ಕೆಲಸ್, ಕಾ? ಫುಡಾರಿ ನಸಲ್ಯಾಲ್ಯಾ ಕಿಡ್ಯಾಂಚಿ ಗತಿ ಕಾ ಆನ್ಲಿಸ್. <verse eid="HAB 1:14" /><verse number="15" style="v" sid="HAB 1:15" />ಹ್ಯಾ ಸ್ಲಾಗುನ್ ತೆ ಬಾಬಿಲೊನಾತ್ಲಿ ಮನ್ಸಾನಾ ಮಾಶಾಚೆ ಗರಿನಿ ವಡುನ್ಗೆತ್ಯಾತ; ಜಾ಼ಳ್ಯಾತ್ನಿ ಬರುನ್ಗೆತ್ಯಾತ; ಆಪ್ಲಿಪ ರ‍್ಯಾಸ್ ಗ್ಯಾಲತ್ಯಾತ. ಆನಿ ಖುಬ್ ಕುಸ್ ವ್ಹತ್ಯಾತ. <verse eid="HAB 1:15" /><verse number="16" style="v" sid="HAB 1:16" />ಆಪಲ್ಯಾ ಜಾ಼ಳ್ಯಾನಾ ಬಲಿ ದೆತ್ಯಾತ; ಧುಪ್ ಗ್ಯಾಲತ್ಯಾತ. ತ್ಯನಿಸ್ ತ್ಯಂಚಾ಼ ಜಿವ್ನಾ ಗಟ್; ತ್ಯಂಚ಼ ಖಾನ ಪಿನ.<verse eid="HAB 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HAB 1:17" />ಆಸ ತ್ಯಂಚಾನಿ ಖಾಯಿಮ್ ಆಪಲ್ಯಾ ಜಾ಼ಳ್ಯಾಂಚಾನಿ ವರ್ದನ್ ಗಿಹಿತ್ರಾಹ್ಯಾ ವ್ಹಯಿಕ್ಯಾ? ದಯಾ ಮಾಯಾ ನಸ್ತಾನಾ ದೆಶಾತ್ನಿ ನಾಸ್ ಕರಿತ್ರಾಹ್ಯಾ ವ್ಹಯಿಕ್ಯಾ?<verse eid="HAB 1:17" /></para>
  <chapter eid="HAB 1" />
  <chapter number="2" style="c" sid="HAB 2" />
  <para style="s">ಹಬಕುಕಾಲಾ ಪರಮೆಸ್ವರಾಚಾ ಜ಼ವಾಬ್</para>
  <para style="p">
    <verse number="1" style="v" sid="HAB 2:1" />“ಮಿ ರಾಕ್ನಿ ವ್ಹವುನ್ ರಾನ್ಹಾರ್. ರ‍್ಯಾಖತ್ಯಾಲ್ಯಾ ಮಾಳ್ಯಾವ ಚ಼ಡುನ್ ಉಬಾರಾನ್ಹಾರ್. ಪರಮೆಸ್ವರ್ ಮನಾ ಕ್ಯಾ ಸಾಂಗಿಲ್, ಕ್ಯಾ ಜ಼ವಾಬ್ ದಿಯಿಲ್, ಮನ್ಹುನ್ ವಾಟ್ ಬಗ್ನಾರ್.”<verse eid="HAB 2:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="HAB 2:2" />ತವಾ ಪರಮೆಸ್ವರಾನಿ ಮನಾ ದಿಲ್ಯಾಲಾ ಉತ್ತರ್ ಹ್ಯೊ: ತು ಬಗಲ್ಯಾಲ ದರ್ಶಾನ್ ಲಿವ್. ವಾಚ್ವಾಲಾ ಬಿಗಿನಿ ವಾಚ್ವಿಶಾರ್ಕ ಫಳಿವ ಲಿವ್. <verse eid="HAB 2:2" /><verse number="3" style="v" sid="HAB 2:3" />ನೆಮಲ್ಯಾಲ್ಯಾ ಕಾಲಾತ್ ತ್ಯ ದರ್ಶಾನ್ ಉಜಿಡಾಸ್ ಎನಾರ್. ತ್ಯಚ಼ ಸರ್ತ ದಿಸ್ ಬಿಗಿನಿಸ ಸಮಾಜ್ನಾ಼ರ್. ಯೊಳ್ ಜಾ಼ಲಾತರಿ ವಾಟ್ಬಗ್; ಫಸಿವ್ನಾರ‍್ನಾಹಿ. ತ್ಯ ಖರ‍್ಯಾನಿ ಗಡ್ನಾರ್; ಉಶಿರ್ ವ್ಹನಾರ್ನಾಹಿ. <verse eid="HAB 2:3" /><verse number="4" style="v" sid="HAB 2:4" />ಬಗ್, ಮನ್ ಶಾರ್ಕ ನಸಲ್ಯಾಲಾ, ಫುಗಲ್ಯಾಲಾ ತ್ಯೊ ಬುರ್ಸಾ ರಾನ್ಹಾರ‍್ನಾಹಿ; ದೆವಾ ಸಂಗ ಚಾ಼ಂಗ್ಲಾ ರಾಯಲ್ಯಾಲಾ ಇಸ್ವಾಸಾನಿಸ್ ಜ಼ಗ್ನಾರ್.<verse eid="HAB 2:4" /></para>
  <para style="s">ಬುರ್ಶಾ ಲೊಕಾನಾ ವ್ಹತ್ಯಾಲಾ ಸಂಕಟ್</para>
  <para style="p">
    <verse number="5" style="v" sid="HAB 2:5" />ಸಾವ್ಕರ್ಕಿ ಫಸಿವ್ತಿ, ನಿಶಾ ಚ಼ಡಲ್ಯಾಲಾ ಗುಂಗಿನಿ ಯಕಿಕ್ಡ ರಾಹಿತ್ನಾಹಿ. ತ್ಯಚಿ ಆಶಾ ಪಾತಾಳಾ ಯವ್ಡಿ. ಮರ‍್ನಾಚೆಗತ್ ತ್ಯಲಾ ತ್ರುಪ್ತಿ ನಾಹಿ. ಸರವ್ಯಾ ದೆಶೆತಲ್ಯಾನಾ ಜಾ಼ಳ್ಯಾತ್ ಗೊಳಾ ಕರ‍್ತೊ. ಸಗಳ್ಯಾ ಲೊಕಾಂಚಿ ರ‍್ಯಾಸ್ ಕರ‍್ತೊ. <verse eid="HAB 2:5" /><verse number="6" style="v" sid="HAB 2:6" />ಫನ್ ಆಸ ತ್ಯಚಿಪ್ನಿ ವಲ್ಯಾಲ ತ್ಯಚಾ಼ ಸಮಾಚಾರ್ ಉಚ಼ಲುನ್ ಕಿಂಡಲ್ ಕರತ್ಯಾಲ್ಯಾಂಚಿ ಗ್ಯಾಟ್ಮಾರುಂಥಿವ್ತಿಲ. ಆಪ್ಲ ನಸಲ್ಯಾಲ ಲ ಖುಬ್ ಬರ್ವುನ್ ಥೆವತ್ಯಾಲ್ಯಾಚಿ ಗತಿ ಕ್ಯಾ! ದುಸರ‍್ಯಾಂಚಿ ಆಸ್ತಿ ಆಡು ಥೆವಲ್ಯಾಲ್ಯಾಂಚಿ ಗತಿ ಕ್ಯಾ ಸಾಂಗು! ಕೆವ್ಡ ದಿಸ್ ಆಸ ಕರ್ನಾರ್?<verse eid="HAB 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HAB 2:7" />ತುಜ಼ ರಿನ್ಕರಿಸ್ ತವಾಸ್ ತುಜಿವ ಪರಾತ್ನಾರ್; ಉರಲ್ಯಾಲಸ್ ಉಟುನ್ ತುಲಾ ಭ್ಯಾ ಗ್ಯಾಲ್ನಾರ್. ಲೊಕಾತ್ಲಿ ಥುಡಿಮುಡಿ ಉರಲ್ಯಾಲಿ ತುಲಾ ಲುಟ್ನಾರ್. <verse eid="HAB 2:7" /><verse number="8" style="v" sid="HAB 2:8" />ತು ಲ ಲೊಕಾನಾ ಲುಟಲ್ಯಾತಸ್. ಲೊಕಾಂಚ಼ ರಗಾತ್ ಶಾಂಡಲ್ಯಾಸ್. ದೆಶೆನಾ ಪೆಠನಾ ತ್ಯಾತಲ್ಯಾ ಮಾನ್ಸಾನಾ ತರಾಸ್ ದೆತ್ಯೊಸ್. ಹ್ಯಾ ಕಾರ್ನಾತ್,<verse eid="HAB 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HAB 2:9" />ಗೊಲ್ಯಾತ್ನಿ ಉರವಾಲಾ ತುಜ಼ ಘರ್ ಉಚ಼್ ಕರುನ್ ಬ್ಯಾಂದಲ್ಯಾ. ತುಜಾ ಕುಟ್ಮಾಸಾಟಿ ದುಸರ‍್ಯಾಂಚಿ ಆಸ್ತಿ ಫಸ್ವುನ್ ಕಾಡುನ್ ಗಿತ್ಲಿಸ್, ತುಜಿ ಗತಿ ಕ್ಯಾ ಸಾಂಗು! <verse eid="HAB 2:9" /><verse number="10" style="v" sid="HAB 2:10" />ತುಜಾ ಯವಜ್ನಾ಼ನಿ ತುಜಾ ಗರ‍್ಹಾನ್ಯಾಲಾ ಕಳಂಕಾ ಆನುನ್ ಗೆತ್ಲಸ್. ಖುಬ್ ದೆಸೆತ್ನಾ ಸತ್ಯಾನಾಸ್ ಕರುನ್ ತುಜಾ ವಂಶಾಲಾ ದೊಖಾ ಯಯಿಸಾರಾ ಕರುನ್ಗೆತ್ಲಾಸ್. <verse eid="HAB 2:10" /><verse number="11" style="v" sid="HAB 2:11" />ಬಿತ್ತಿತ್ ಆಸಲ್ಯಾಲ ದೊಂಡಸ್ ತುಜೆ ಆಡ್ವ ವರಾಡ್ನಾರ್. ಗರ‍್ಹಾಚಿ ಬಾರ ಫನ್ ತ್ಯಲಾ ಸಾತ್ ದಿವುನ್ ಉಬಿರಾನ್ಹಾರ್.<verse eid="HAB 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HAB 2:12" />ಮಾನ್ಸಾನಾ ರಗಾತ್ ಪಾಡುನ್ ಶಾರ್ ಬ್ಯಾಂತ್ಯಾಲ್ಯಾನಾ ಆನಿ ಮೊಸಾನಿ ಪೆಠಾ ಬ್ಯಾಂದಲ್ಯಾಲ್ಯಾಂಚಿ ತುಜಿ ಗತಿ ಕ್ಯಾ ಸಾಂಗು! <verse eid="HAB 2:12" /><verse number="13" style="v" sid="HAB 2:13" />ಲೊಕ ರಾಬಲ್ಯಾಲ ಇಸತ್ಯಾತ ಪಡ್ನಾರ್. ಲೊಕ ಪಡಲ್ಯಾಲ ಮೆನ್ಹತ್ ಹಾಳ್ ವ್ಹನಾರ್. ಹ್ಯ ಸಗ್ಳ ಪರಮೆಸ್ವರ್ ದೆವಾಚ಼ ಮನ್ಹ ತ್ಯವ್ಡಸ್. <verse eid="HAB 2:13" /><verse number="14" style="v" sid="HAB 2:14" />ಸಮಿಂದೊರ್ ಪಾನ್ಯಾನಿ ಬರಲ್ಯಾಲ್ಯಾಚೆಗತ್ ಜ಼ಗತಿವ ಪರಮೆಸ್ವರ್ ದೆವಾಚಾ ಮನಾನಿ ಆನಿ ಬುದ್ದಿನಿ ಬರುನ್ ರಾನ್ಹಾರ್.<verse eid="HAB 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HAB 2:15" />ತುಜಾ಼ ರಾಗ್ ದಾರ್ವವ ಗಾಲುನ್, ಆನಿ ತುಜೆ ಸರ‍್ಬವ್ಹಾರ್ ರಾಥ್ಯಾಲ್ಯಾನಾಬಿ ಪಾಜು಼ನ್, ತ್ಯನಾ ನಾಗಡ್ಯಾನಿ ಬಕ್ತೊ ಮಂಥ್ಯಾಲಾ ತುಲಾ ತುಜಿ ಗತಿ ಕ್ಯಾ ಸಾಂಗು! <verse eid="HAB 2:15" /><verse number="16" style="v" sid="HAB 2:16" />ತು ಮರ‍್ಯಾದಿಸಾ ನವ್ಹಸ್, ಕೊಠ್ಯಾಫನಾನಿ ಬರಲ್ಯಾಸ್; ತು ಪಿವು ಪಿವುನ್ ನಾಗ್ಡಾ ಹೊ. ಪರಮೆಸ್ವರಾಚಾ ಉಜ಼ವ್ಯಾ ಹಾತಾತ್ಲಿ ರಾಗಾಚಿ ಗಾಗ್ಹರ್ ತುಜೆ ವಾಟ್ನಿಲಾ ಯನಾರ್. ರಾಗುಸ್ ತುಜೆ ಮರೆದಿಲಾ ಎಡಾ ಗ್ಯಾಲ್ನಾರ್. <verse eid="HAB 2:16" /><verse number="17" style="v" sid="HAB 2:17" />ತು ಲೊಕಾಂಚ಼ ರಗಾತ್ ಶಾಂಡಲ್ಯಾಸ್. ದೆಶೆನಾ ಪೇಠಾನಾ ತ್ಯಾತಲ್ಯಾ ಲೊಕಾನಾ ತರಾಸ್ ದಿಲ್ಯಾಸ್. ಲೆಬನೊನಚಿ ರಾನ ತುಡುನ್ ಗ್ಯಾತಲ್ಯಾತಸ್. ಆತಾ ತುಲಾ ತುಡುನ್ ಗಾಲ್ಹಾವ್ಹಯಿ. ತ್ಯಾತ್ಲಿ ಜ಼ನಾವಾರ ಪಕ್ಶಿ ನಾಸ್ ಕೇಲ್ಯಾತಸ್. ಆತಾ ತಿ ತುಲಾ ಇರುಕ್ಶಾಚೆಗತ್ ವ್ಹನಾರ್<verse eid="HAB 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HAB 2:18" />ಬನಿವಲ್ಯಾಲ್ಯಾ ಪಾಶಾನಾನಿ ಉಪೆಗ್ ಕ್ಯಾ? ತ್ಯ ಬರ್ದಿ ಮಾನ್ಸಾಚ಼ ಕಾಮ್, ಲಬಾಡ್ ಸಾಂಗಾಯಾ ಥೆವಲ್ಯಾಲ ಮಾಯೆಚ಼ ಬಾವ್ಲ. ತ್ಯಲಾ ಕೆಲ್ಯಾಲ್ಯಾಲಾ ತ್ಯ ಕ್ಯಾ ಚಾಂಗ್ಲ ಕರಾಚ಼ ಹುತ್ತ? ತ್ಯ ಬೊಲಾಯಾ ಯಯಿತ್ನಸಲ್ಯಾಲ ಮುಕ ಬಾವ್ಲ ತೆವ್ಡಸ್. <verse eid="HAB 2:18" /><verse number="19" style="v" sid="HAB 2:19" />ಜಾ಼ಢಾಚಾ ಕಂಡ್ಯಾಲಾ, ‘ಜಾ಼ಗಾ ಹೊ’; ಜಿವ್ ನಸಲ್ಯಾಲ್ಯಾ ದೊಂಡ್ಯಾಲಾ, ‘ಉಟ್’ ಮನ್ಹುನ್ ಸಾಂಗತ್ಯಾಲಾ ಖರಸ್ ಬುದ್ದಿನಸಲ್ಯಾಲಾ. ಬಾವ್ಲ ಬೊಲಲಕ್ಯಾ? ಚಾ಼ಂದಿ ಸೊನ ತ್ಯಲಾ ಗ್ಯಾತ್ಲಸಾ ಖರ. ತ್ಯಲಾ ಜಿವ್ ನಾಹಿಸ್ನಾಹಿ.<verse eid="HAB 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HAB 2:20" />ಫನ್ ಪರಮೆಸ್ವರ್ ಪವಿತ್ರಾ ದೆವ್ಳಾತ್ ರಾನ್ಹಾರ್; ದುನ್ಯಾ ಸಗಳಿ ಗಪ್ ರಾಹುನಿ ತ್ಯಚಾ ಪವಿತ್ರಾ ದೆವ್ಳಾತ್.<verse eid="HAB 2:20" /></para>
  <chapter eid="HAB 2" />
  <chapter number="3" style="c" sid="HAB 3" />
  <para style="s">ಹಬಕುಕಾಚ಼ ಮಾಗ್ನ</para>
  <para style="p">
    <verse number="1" style="v" sid="HAB 3:1" />ಹ್ಯ ಪ್ರಾವಾದಿ ಹಬಕುಕಾನಿ ಕೆಲ್ಯಾಲ ಮಾಗ್ನ.<verse eid="HAB 3:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="HAB 3:2" />ಪರಮೆಸ್ವರಾ ತುಜಾ ಕಿರತ್ಯಾ ಐಕಲ್ಯಾತಾ</para>
  <para style="q2" vid="HAB 3:2">ತುಜಿ ಮತ್ವಾಚಿ ಕಾಮ ಐಕುನ್ ಹಾಸ್ಮುಕ್ ಜಾ಼ಲೊ.</para>
  <para style="q1" vid="HAB 3:2">ತಿ ಸಾಂಗಸಾರಿ ಪರ್ತುನ್ ಕರ್</para>
  <para style="q2" vid="HAB 3:2">ತ್ಯನಾ ರಾಗ್ ಕೆಲಾತರಿ</para>
  <para style="q1" vid="HAB 3:2">ದಯಾ ಕರಾಚಿ ಇಸ್ರು ನಕೊ<verse eid="HAB 3:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="HAB 3:3" />ತೆಮಾನಾತ್ನಿ ಉತ್ರುನ್ ಯತ್ಯಾಲಾ ದೆವ್</para>
  <para style="q2" vid="HAB 3:3">ಆಲಾ ನಿರ್ಮಳ್ ಆಸಲ್ಯಾಲ್ಯಾ ತ್ಯಾ ಪಾರಾನಾ ಪರ್ವತಾವ್ನಿ.</para>
  <para style="q1" vid="HAB 3:3">ಆಗಾಸಾತ್ ಉಜಿಡ್ ಪಡ್ನಾರ್</para>
  <para style="q2" vid="HAB 3:3">ದರ್ಥಿ ತ್ಯಚೆ ಮಹಿಮನಿ ಬರ್ನಾರ್.<verse eid="HAB 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 3:4" />ದಿಸಾಚೆಗತ್ ತ್ಯಚಾ ಉಜಿಡ್ ವ್ಹಯಿತ್</para>
  <para style="q2" vid="HAB 3:4">ತ್ಯಚಾ ಹಾತಾತ್ನಿ ಕಿರ್ನ ಬಾಹಿರ್ ಪಡ್ನಾರ್</para>
  <para style="q2" vid="HAB 3:4">ದಡಾಲ್ಯಾ ತ್ಯಚ಼ ಬಳ್ ತಿಥಸ್.<verse eid="HAB 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 3:5" />ಜಾ಼ತ್ಯಾತ ದುಕ್ನಿ ತ್ಯಚೆ ಮೊರ‍್ಹ</para>
  <para style="q2" vid="HAB 3:5">ಯತ್ಯಾ ಪಾವ್ಲಾಸ್ ಮರಾನ್ ತ್ಯಚೆ ಮಾಗ್ನಿ.<verse eid="HAB 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 3:6" />ಹಾಲ್ತಿ ದರ್ಥಿ ತ್ಯೊ ಉಬಾರಾತಾನಾ</para>
  <para style="q2" vid="HAB 3:6">ಹಾದಾರ‍್ತಿ ದುನ್ಯಾ ತ್ಯೊ ಬಕ್ತಾನಾ</para>
  <para style="q1" vid="HAB 3:6">ಚಿಂಬಾಳ್ನಾರ್ ಜು಼ನ್ನ ಗುಡ್ಡ</para>
  <para style="q2" vid="HAB 3:6">ಇರ್ಗಾಳುನ್ ಪಡ್ನಾರ್ ಪುರ್ವಿತ್ಲ ಗುಡ್ಡ</para>
  <para style="q2" vid="HAB 3:6">ಪುರ್ವಿದರ್ನಿ ತ್ಯಚ಼ ಯನ ತಸಸ್ .<verse eid="HAB 3:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="HAB 3:7" />ಬಗ್, ತಳ್ಮಾಳ್ ಜಾ಼ಲ್ಯಾ ಕುಶಾನಿತಲ್ಯಾ ಖೊಪ್ಟಾಂಚಾ಼</para>
  <para style="q2" vid="HAB 3:7">ಹಾಲತ್ಯಾತ ಮಿದ್ಯಾನ್ ದೆಶೆತ್ಲಿ ಪಾಕ್ಟ.<verse eid="HAB 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 3:8" />ಡಘಾಂಚಿವ್ನಿ ಆಲಾಸ ಕಾ?</para>
  <para style="q2" vid="HAB 3:8">ಪರಮೆಸ್ವರಾ, ತುಲಾ ನ್ಹಂಚಿವ ರಾಗ್?</para>
  <para style="q1" vid="HAB 3:8">ವ್ಹಾಳಾಂಚಿವಸ್ ರಾಗ್ ರೊಸ್</para>
  <para style="q2" vid="HAB 3:8">ಸಮಿಂದೊರಾವ ಸಗ್ಳಾ ರಾಗ್ ?</para>
  <para style="q1" vid="HAB 3:8">ತುಜಾ ಜಿಕಲ್ಯಾಲ್ಯಾ ಗೊಡ್ಯಾಂಚಾ</para>
  <para style="q2" vid="HAB 3:8">ರಥಾತ್ ಬಸುನ್ ಯತಾನಾ<verse eid="HAB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HAB 3:9" />ಕ್ಯಾಡ್ಲಾ ಬಿಲ್ ಬಾವಳ್ಯಾತ್ನಿ</para>
  <para style="q2" vid="HAB 3:9">ಶೊಡ್ಲ ಬಾನ್ ತ್ಯಾತ್ನಿ</para>
  <para style="q1" vid="HAB 3:9">ಚಿಂಬಳ್ಳೆ ದರ್ಥಿ ನ್ಹಂಚಾನಿ.<verse eid="HAB 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 3:10" />ತುಲಾ ಬಗುನ್ ಹಾಲ್ಲ ಗುಢ</para>
  <para style="q2" vid="HAB 3:10">ವ್ಹಾವ್ನಾರ್ ಪಾನ್ಯಾಚಾ಼ ಲ್ವಾಟಾ</para>
  <para style="q1" vid="HAB 3:10">ಉಸ್ಸೊಳ್ ವ್ಹನಾರ್ ದರ‍್ಯಾತ್.<verse eid="HAB 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 3:11" />ಫುರ್ಕಾನಿನಿ ಪಳತ್ಯಾಲ ತುಜ಼ ಬಾನಾಂಚಾ ಉಜಿಡಾಲಾ</para>
  <para style="q2" vid="HAB 3:11">ಫಳ್ಪಳತ್ಯಾಲೆ ತುಜೆ ಬರ್ಚಿಚಾ ಉಜಿಡಾವ</para>
  <para style="q2" vid="HAB 3:11">ದಿಸ್ ಚಾ಼ಂದ್ ಥಾಂಬತ್ಯಾತ ತಿಥಸ್.<verse eid="HAB 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 3:12" />ದರ್ಥಿವ ತು ಆರ್ಬಾಟಾನಿ ಜಾ಼ನಾರ್</para>
  <para style="q2" vid="HAB 3:12">ಮೊಟ್ಯಾ ರಾಗಾನಿ ದೆಶಾ ತುಡಿವ್ನಾರ್.<verse eid="HAB 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 3:13" />ನಿಗಾಲಾಸ್ ತು ತುಜಾ ಲೊಕಾಂಚೆ ರಕ್ವಾಲಿಲಾ</para>
  <para style="q2" vid="HAB 3:13">ತು ಅಬಿಶೆಕ್ ಕೆಲ್ಯಾಲ್ಯಾಚಾ಼ ಜೀವ್ ಉರ‍್ವಾಲಾ.</para>
  <para style="q1" vid="HAB 3:13">ಜೆಜ಼ರ‍್ನಾರ್ ಬುರಶಾಂಚಾ ದನ್ಯಾಚಾ ಡೊಯಾ</para>
  <para style="q2" vid="HAB 3:13">ಜಿಮ್ನಿಸಾರ ಕರ್ನಾರ್ ಮಾಂಡಿದರ‍್ನಿ ಬಾವಳ್ಯಾ ಪರ‍್ಯಾತ್.<verse eid="HAB 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 3:14" />ಗರಿಬಾನಾ ದಡ್ಪುನ್ ಮೊಟಾವ್ಹತ್ಯಾಲ್ಯಾಚೆಗತ್</para>
  <para style="q2" vid="HAB 3:14">ಮನಾ ಪಳ್ವಾಯಾ ಆಲ ತ್ಯಚ಼ ಸಿಪಾಯಿ ವಾವ್ಡಳಿಚೆಗತ್,</para>
  <para style="q2" vid="HAB 3:14">ತ್ಯಚಾ ಹಾತ್ಯಾರ‍್ಯಾಂಚಾನಿ ತ್ಯಂಚಾ ಡೊಯಾ ತು ಮ್ಯಾರಲ್ಯಾಸ್.<verse eid="HAB 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 3:15" />ವಾರ‍್ವಾವ ಬಸುನ್ ತು ಸಮಿಂದೊರಾವ್ನಿ ಗೆಲಾಸ್</para>
  <para style="q2" vid="HAB 3:15">ಪ್ಯೊಸ್ ಆಲ್ಯಾಲಿ ಪಾನ್ಯಾಚಿ ರ‍್ಯಾಸ್ ವಲ್ಯಾಂಡುನ್ಗೆಲಾಸ್.<verse eid="HAB 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 3:16" />ಹ್ಯ ಐಕುನ್ ಬಿಹುನ್ ಕ್ಯಾಪರ‍್ಯಾನಿ ಮಾಜ಼ ಮನ್</para>
  <para style="q2" vid="HAB 3:16">ಹಾದಾರ್ಲ ತ್ಯಾ ಸಬ್ದಾಲಾ ಮಾಜ಼ ವಟ್</para>
  <para style="q1" vid="HAB 3:16">ಕುಜ಼ಲ್ಯಾಸಾರಿ ಜಾ಼ಲ್ಯಾತ ಮಾಜಿ ಹಾಡ</para>
  <para style="q2" vid="HAB 3:16">ಉಬಿರಾಲ್ಯಾಲ್ಯಾ ಜಾ಼ಗ್ಯಾವಸ್ ಥರ್ತರ‍್ಲ ಮಾಜ಼ ಪ್ಯಾ</para>
  <para style="b" vid="HAB 3:16" />
  <para style="q1" vid="HAB 3:16">ಆಪತ್ ಯನಾರ್ ಆಮ್ಚಿವ ಆಕ್ರಮನಕೆಲ್ಯಾಲ್ಯಾವ</para>
  <para style="q2" vid="HAB 3:16">ರ‍್ಯಾಕ್ನಾರ್ ಮಿ ಥಂಡ್ಫನಾನಿ ತಬರ್. <verse eid="HAB 3:16" /><verse number="17" style="v" sid="HAB 3:17" />ಹುಂಬ್ರಾಚಾ ಝಾ಼ಡ್ ನವ ಆಲನಸ್ಲತರಿ</para>
  <para style="q2" vid="HAB 3:17">ದರಾಕ್ಶಿಚೆ ಯಲಿಲಾ ಫಳ ಲಾಗ್ಲಿ ನಾಹಿತರಿ,</para>
  <para style="q1" vid="HAB 3:17">ತೆಲಾಚಾ ಝಾಡಾಂಚಿ ಉತ್ಪನ್ ನಸ್ಲಿತರಿ</para>
  <para style="q2" vid="HAB 3:17">ಶೆತಾಬಾತಾಂಚಿ ಉತ್ಪನ್ ನಸ್ಲಿತರಿ</para>
  <para style="q1" vid="HAB 3:17">ಶೆಳ್ಯಾಮೆಂಡ್ಯಾ ಸಾಟಾತ್ ನಸಲ್ಯಾತರಿ</para>
  <para style="q2" vid="HAB 3:17">ಗೊಟ್ಯಾತ್ ಗುರ ನಸ್ಲಿತರಿ,<verse eid="HAB 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="HAB 3:18" />ಕುಸ್ ವ್ಹನಾರ್ ಮಿ ಪರಮೆಸ್ವರಾಪ</para>
  <para style="q2" vid="HAB 3:18">ಆನಂದ ವ್ಹನಾರ್ ಮನಾ ಉರಿವತ್ಯಾಲ್ಯಾ ದೆವಾಪ.<verse eid="HAB 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="HAB 3:19" />ಪರಮೆಸ್ವರ್ ದೆವ್ ದೆನಾರ ಮನಾ ಧಿರ್</para>
  <para style="q2" vid="HAB 3:19">ಹಾಲ್ಕಾಯಿ ದೆನಾರ್ ಮಾಜಾ ಪಾಯಾನಾ ಚಿತ್ಳಾಚೆಗತ್.</para>
  <para style="q2" vid="HAB 3:19">ಕನ್ಯಾಗುಢ್ಯಾತ್ನಿ ಮಿ ಚಾ಼ಲಶಾರ್ಕ ಕರ್ತೊ.</para>
  <para style="q1" vid="HAB 3:19">ಕಾ ಮಂಜೆ ಪ್ರದಾನ ಗೀತ ಗ್ಯಾವ್ನಾರ‍್ಯಾ</para>
  <para style="q1" vid="HAB 3:19">ಕಿರ್ತಾನಾತ್ನಿ ಗೆತಲ್ಯಾಲ;</para>
  <para style="q1" vid="HAB 3:19">ತಂತಿಚಾ ವಾಜ಼ಪಾಸಂಗ ಗಾವಾಚ಼.<verse eid="HAB 3:19" /></para>
  <chapter eid="HAB 3" />
</usx>