<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PHP" style="id">- Gawli Marathi</book>
  <para style="h">ಪಿಲಿಪ್ಪಿ</para>
  <para style="toc3">ಪಿಲಿಪ್ಪಿ</para>
  <para style="toc2">ಪಿಲಿಪ್ಪಿ</para>
  <para style="toc1">ಪೌಲಾನಿ ಪಿಲಿಪ್ಯಾತ್‌ಲ್ಯಾನಾ ಲಿವ್‌ಲ್ಯಾಲ ಪತ್ರ</para>
  <para style="mt2">ಪೌಲನು ಪಿಲಿಪಿಯದವರಿಗೆ ಬರೆದ ಪತ್ರಿಕೆ</para>
  <para style="mt1">ಪೌಲಾನಿ ಪಿಲಿಪ್ಯಾತ್‌ಲ್ಯಾನಾ ಲಿವ್‌ಲ್ಯಾಲ ಪತ್ರ</para>
  <para style="imt">ವಳಕ್</para>
  <para style="ip">ಪಿಲಿಪ್ಪಿತ್‌ಲ್ಯಾನಾ ಲಿವ್‌ಲ್ಯಾಲ್ಯಾ ಪತರ‍್ಯಾಚಿ ವಳಕ್ ಪೌಲಾನಿ ಕ್ರಿಸ್ತ ಜ಼ಲಾಮಲ್ಯಾ ನಂತರ್ ಲ ಕರುನ್ 61 ವರ್ಸಾತ್ ಹ್ಯ ಪತ್ರ ಪಿಲಿಪ್ಪಿ ನಗರಾತ್‌ಲ್ಯಾ ಇಸ್ವಾಸಿನಾ ಲಿವ್‌ಲ್ಯಾ, ಹ್ಯಾ ಯಳಾತ್ ತ್ಯೊ ಲ ಕರುನ್ ರೊಮಾಚಾ ತುರುಂಗಾತ್ ಹುತ್ತಾ <char style="xt"><ref loc="PHP 1:13">1:13</ref></char> ಹ್ಯ ಪತ್ರ ಪಿಲಿಪ್ಪಿ ಪೆಠತ್ ಆಸ್‌ಲ್ಯಾಲೆ ಸಭೆಲಾ ಲಿವ್‌ಲ್ಯಾ. ಅಪೊಸ್ತಲಾಚಾ ಪುಸ್ತಕಾತ್ ಪಿಲಿಪ್ಪಿಚೆ ಗುಶ್ಟಿತ್ ಆಮಿ ಥೊಡ್ಯಾ ಗುಶ್ಟಿ ಸಿಕ್ವಾವ ಪಿಲಿಪ್ಪಿ ಪ್ಯಾಟ್ ಮೆಕೆದೊನ್ಯಾ ಪ್ರಾಂತ್ಯಾಚಿ ರಾಜ್ಧಾನಿ ಜಾ಼ಲ್ಥಿ. ಹಿ ಸಭಾ ಮೆಕೆದೊನ್ಯಾತ್ ಬ್ಯಾಂದ್‌ಲ್ಯಾಲಿ ಪೈಲಿ ಸಭೆ ಜಾ಼ಲ್ಥಿ. ಪೌಲಾನಿ ಆನಿ ಸಿಲಾನಿ ಹಿ ಸಬಾ ಸರ್ವಾತ್ ಕಿಲಿ ಆನಿ ತಿಥ ಆಸ್ಥಾನಾ ಯಕ್ ರ‍್ಯಾತ್ ತುರುಂಗಾತ್ ಥೆವ್ಲ ಹುತ್ತ.<char style="xt"><ref loc="ACT 16">ಅಪೊಸ್ತಲ್ 16</ref> </char></para>
  <para style="ip">ಹ್ಯ ಪತ್ರ ಲಿವಾಯಾ ಪೌಲಾಚ಼ ಖುಬ್ ಉದ್ದೆಸ್ ಆಸ್ಥಿಲ. ತ್ಯನಿ ಹ್ಯೊ ಅವ್ಕಾಸ್ ಆಮಿ ತುರುಂಗಾತ್ ಹಾವ್ ಮನ್ಹುನ್ ಐಕುನ್ ತ್ಯಂಚಾನಿ ಲಾವುನ್ ದಿಲ್ಯಾಲ್ಯಾ ಬಹುಮಾನಾಸಾಟಿ ಸಬೆಲಾ ದನ್ಯವಾದ್ ಸಾಂಗಾಯಾ ವಾಫರ್ತೊ <char style="xt"><ref loc="PHP 4:10-19">4:10-19</ref></char> ತ್ಯೊ ತುರುಂಗಾತ್ ಆಸ್‌ಲ್ಯಾಲೆ ಆಪ್ಲೆ ಪರಸ್ಥಿತಿ ಲಿವ್ತೊ ಆನಿ ತಿಮೊಥೆ ಆನಿ ಎಪಪ್ರೊದಿತಾಚಿ ಸಬೆಲಾ ವಳಕ್ ಕರ್ತೊ <char style="xt"><ref loc="PHP 2:19-30">2:19-30</ref> </char>ಆನಿ ತೀ ತ್ಯನಾ ವವ್ಯಾಳಾಯಾ ಆನಿ ತ್ಯಂಚಾ ಫುಡಾರಿ ಫನಾಲಾ ಮರ‍್ಯಾದ್ ದಿಯಾ ಶಾರ್ಕ ಕೆಲ.</para>
  <para style="iot">ಪಿಠಿಕೆ</para>
  <para style="io1">1. ಪೌಲ್ ಪಿಲಿಪ್ಪಿ ಸಬೆಲಾ ನಮಸ್ಕಾರ್ ಕರಿತ್ ಪತ್ರ ಸುರು ಕರ್ತೊ <char style="ior"><ref loc="PHP 1:1-2">1:1-2</ref> </char></para>
  <para style="io1">2. ಮಂಗ್ ತ್ಯೊ ಆಪ್ಲೆ ಪರಸ್ಥಿತಿಚೆ ಗುಶ್ಟಿತ್ ಥುಡಿ ಬಾತ್ನಿ ಸಾಂಗ್ತೊ ಆನಿ ತ್ಯಲಾ ಆಸ್‌ಲ್ಯಾಲೆ ಥೊಡೆ ಕ್ಯಾಳ್ಜಿಚೆ ಗುಶ್ಟಿತ್ ಸಾಂಗ್ತೊ<char style="ior"><ref loc="PHP 1:3-2:30">1:3—2:30</ref></char></para>
  <para style="io1">3. ಮಂಗ್ ತ್ಯೊ ಕ್ರಿಸ್ತಾಚಾ಼ ಜೀವ್ನಾ ಕರಾಯಾ ಖುಬ್ ಕಾಮಾಚಾ ವಾಟಂಚಿ ಸುಸ್ನಾ ದೆತೊ<char style="ior"><ref loc="PHP 3:1-4:9">3:1—4:9</ref> </char></para>
  <para style="io1">4. ಪೌಲ್ ಪಿಲಿಪ್ಪಿ ಸಬೆಲಾ ತ್ಯನಿ ಲಾವುನ್ ದಿಲ್ಯಾಲ್ಯಾ ಬೊಮಾನಾಸಾಟಿ ದನ್ಯವಾದ್ ಸಾಂಗುನ್ ಆಪ್ಲ ನಮಸ್ಕಾರ್ ಸಾಂಗಿತ್ ಪತ್ರ ಸುಪಿವ್ತೊ<char style="ior"><ref loc="PHP 4:10-23">4:10-23</ref> </char></para>
  <chapter number="1" style="c" sid="PHP 1"/>
  <para style="p">
    <verse number="1" style="v" sid="PHP 1:1"/>ಕ್ರಿಸ್ತ್ ಯೇಸುಚ಼ ದಾಸ್ ಜಾ಼ಲ್ಯಾಲ ಪೌಲ್ ಆನಿ ತಿಮೊಥೆ, ಪಿಲಿಪ್ಪಿತ್ ಕ್ರಿಸ್ತ್ ಯೇಸುಸ್ಲಾಗುನ್ ದೇವಾಚಿ ಲೊಕ ಜಾ಼ಲ್ಯಾಲ್ಯಾ ಸಗ್‌ಳ್ಯಾನಾ ಆನಿ ತ್ಯಂಚಿ ಸಂಗ ಆಸ್‌ಲ್ಯಾಲ್ಯಾ ಸಭೆಚಾ ಫುಡಾರಿ ಸಭೆಚಾ ಮಜ಼ತ್ ಕರ್ನಾರ‍್ಯಾನಾ ಲಿವಾಚ಼ ಕ್ಯಾ ಮಂಜೆ,<verse eid="PHP 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 1:2"/>ಆಮ್‍ಚ಼ಾ ಬಾ ಜಾ಼ಲ್ಯಾಲ್ಯಾ ದೇವಾಪ್ನಿಬಿ ಪ್ರಭು ಜಾ಼ಲ್ಯಾಲ್ಯಾ ಯೇಸು ಕ್ರಿಸ್ತಾಪ್ನಿ ತುಮಾನಾ ಕ್ರಪಾ, ಶಾಂತಿ ಗಾವುನಿ.<figure style="fig" alt="City of Philippi" file="hk00363c.tif" size="col" copy="Horace Knowles ©" ref="1:1">ಪಿಲಿಪಿ ಪೆಠಚಾ಼ದ್ರಶ</figure><verse eid="PHP 1:2"/></para>
  <para style="s">ವಾಚಿವ್‌ತ್ಯಾಲ್ಯಾಂಚಿಸಾಟಿ ಪೌಲಾಚ಼ ಮಾಗ್ನ</para>
  <para style="p">
    <verse number="3" style="v" sid="PHP 1:3"/>ಮಿ ತುಮ್ಚಿ ಯಾದ್ ಕರ‍್ತಾನಾಸ್ ಮಾಜಾ ದೇವಾಲಾ ದನ್ಯವಾದ್ ಕರ್ತೊ. <verse eid="PHP 1:3"/><verse number="4" style="v" sid="PHP 1:4"/>ಮಿ ತುಮ್ಚಿಸಾಟಿ ದೇವಾಪ ಮಾಗ್ನ ಕರ್ತ್ಯಾಲ್ಯಾ ಸಗ್‌ಳ್ಯಾ ಯಳಾತ್ ಆನಂದಾನಿಸ್ ಮಾಗ್ನ ಕರ್ತ್ಯಾಲಾ ಜಾ಼ಲ್ಯೊ. <verse eid="PHP 1:4"/><verse number="5" style="v" sid="PHP 1:5"/>ಕಾ ಮಂಜೆ ತುಮಿ ಆಂದಿಸ್ಟಾವ್ನಿ ಆಜ಼್ಪರ‍್ಯಾತ್ ಬರೆ ಖಬರಿಚಾ ಸಾಂಗ್‌ನ್ಯಾತ್ ಮಜ಼ತ್ಕರ್ತ್ಯಾಲ ಜಾ಼ಲ್ಯಾಸಾ. <verse eid="PHP 1:5"/><verse number="6" style="v" sid="PHP 1:6"/>ಹ್ಯ ಚಾ಼ಂಗ್ಲ ಕಾಮ್ ತುಮ್ಚಿಪ ಸುರ್ವಾತ್ ಕೆಲ್ಯಾಲಾ ತ್ಯ ಚಾ಼ಲ್ವುನು ಯೇಸು ಕ್ರಿಸ್ತ್ ಯಯಾಚಾ ದಿಸಾಪರತ್ ಪುರ ಕರಾಯಾ ಆನ್ನಾರ್ ಮನ್ಹುನ್ ಮನಾ ಖಾತ್ರಿ ಹಾ. <verse eid="PHP 1:6"/><verse number="7" style="v" sid="PHP 1:7"/>ತುಮ್ಚೆ ಸಗ್‌ಳ್ಯಾಂಚೆ ಗುಶ್ಟಿತ್ ಮನಾ ಆಸ ವಾಟಾಚ಼ ಶಾರ್ಕ ಹಾ. ಮಿ ತುರಂಗಾತ್ ಆಸ್ಥಾನಾ, ಬರೆ ಖಬರಿಚಾ ಪರತೇಕ್ ವಾದಾತ್ನಿ ತುಮಿ ಸಗ್ಳಿ ಮಾಜಿ ಸಂಗ ದೇವಾಚೆ ಕ್ರಪೆತ್ ವಾಟ್ನಿದಾರ್ ಜಾ಼ಲ್ಯಾಸಾ ಮನ್ಹುನ್ ತುಮಿ ಮಾಜಾ ಮನಾತ್ ಹಾಸಾ. <verse eid="PHP 1:7"/><verse number="8" style="v" sid="PHP 1:8"/>ಕ್ರಿಸ್ತ ಯೇಸುಪ ಆಸ್‌ಲ್ಯಾಲೆ ಕನಿಕಾರಾಲಾ ತುಮ್ಚೆ ಸಗ್‌ಳ್ಯಾಂಚೆ ಸಾಟಿ ಕ್ಯವ್ಡಾ ತಳಮಳ್ತೊ. ಹ್ಯಲಾ ದೇವುಸ್ ವಳಕ್.<verse eid="PHP 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PHP 1:9"/>ಆನಿ ತುಮ್ಚಿ ಮಾಯಾ ಆಜು಼ನ್ ಖುಬ್ ಪುರ‍್ಯಾ ಗಿನ್ಯಾನಾನಿ ಇಚಾರಾನಿ ವಾಡುನಿ ಮನ್ಹುನ್ ಮಿ ತುಮ್ಚಿ ಸಾಟಿ ಮಾಗ್ನ ಕರ್ತೊ. <verse eid="PHP 1:9"/><verse number="10" style="v" sid="PHP 1:10"/>ಆಸಿ ಚಾ಼ಂಗ್ಲಿ ಕಾಮ ಕಚಿ ಮನ್ಹುನ್ ಸಗ್ಳಾ ಇಚಾರ್ ಕರಾಯಾ ವ್ಹಯಿ. ಮನ್ಹುನ್ ಆನಿ ಕ್ರಿಸ್ತ ಯಯಾಚಾ ದಿಸಾತ್ ತುಮಿ ನಿರ್ಮಳ್, ದೊಶ್ ನಸ್ನಾರಿ, ರಾಹ್ಯಾ ವ್ಹಯಿಸಾ <verse eid="PHP 1:10"/><verse number="11" style="v" sid="PHP 1:11"/>ದೇವಾಚೆ ಮಹಿಮೆಸಾಟಿ ಆನಿ ಸ್ತೊತ್ರಾಸಾಟಿ ಯೇಸು ಕ್ರಿಸ್ತಾನಿ ಉತ್ಪನ್ ಕೆಲ್ಯಾಲ ಖರ‍್ಯಾ ಜಾ಼ಲ್ಯಾಲ್ಯಾ ಚಾ಼ಂಗಲ್ಯಾ ಗುನಾನಿ ತುಮ್‍ಚಾ಼ ಜೀವ್ನಾ ಬರ್ನಾರ್.<verse eid="PHP 1:11"/></para>
  <para style="s">ಜಿವ್ನಾ ಕರಾಯಾ ಕ್ರಿಸ್ತ್</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 1:12"/>ಬನ್ಹಿ ಬಾವ್ಹಾನು, ದೆವಾಚೆ ಮೈಮಾ ಆನಿ ಸ್ತೊತ್ರಾಸಾಟಿ ಯೆಸುಕ್ರಿಸ್ತ ಹ್ಯ ಸಗ್ಳ ಬರಿ ಖಬರ್ ಸಾಂಗಾಯಾ ಮಜ಼ತ್ ಜಾ಼ಲಿ ಮನ್ಹುನ್ ತುಮಿ ಸಮಜು಼ನ್ ಗಿಹ್ಯಾ ವ್ಹಯಿಸಾ ಮನ್ಹುನ್ ಮನ್‌ ಕರ್ತೊ. <verse eid="PHP 1:12"/><verse number="13" style="v" sid="PHP 1:13"/>ಕಸ ಮಂಜೆ ಮಿ ತುರಂಗಾತ ರಾಯಲ್ಯಾಲೊ ಕ್ರಿಸ್ತಾಸ್ ಲಾಗುನುಸ್ ಮನ್ಹುನ್ ರಾಜ಼ವಾಡ್ಯಾಚಾ ರಾಖನ್ದಾರಾನಾ ಆನಿ ಬಾಕಿಚಾ ಸಗ್‌ಳ್ಯಾನಾ ಸಮಾಜ಼್ಲ ಹುತ್ತ. <verse eid="PHP 1:13"/><verse number="14" style="v" sid="PHP 1:14"/>ಯವ್ಡಸ್ ನವ್ಹ ಬನ್ಹಿ ಬಾವ್ಹಾತ್‍ಲ್ಯಾ ಖುಬ್ ಜ಼ನಾನಾ ಮನಾ ಕೊಂಡಲ್ಯಾಲ್ಯಾಸ್ ಲಾಗುನ್ ಪ್ರಭುಪ ಇಸ್ವಾಸಾನಿ ದೇವಾಚಿ ಬರಿ ಖಬರ್ ಭೆ ನಸ್ಥಾನಾ ಆನಿ ಸಾಂಗಾಯಾ ಖುಬ್ ಧೀರ್ ಆಲಾ.<verse eid="PHP 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 1:15"/>ಥೊಡಜಾ಼ನ್ ಖೊಟ್ಯಾಫನಾನಿ ದುಯಿ ಗಾಲ್ಹಾಯಾ ವ್ಹಯಿ ಮನ್ಹುನ್ ಸಾಂಗ್‌ತ್ಯಾತ ಆನಿ ಥೊಡ ಚಾ಼ಂಗಲ್ಯಾ ಮನಾನಿ ಕ್ರಿಸ್ತಾಚೆ ಗುಸ್ಟಿತ್ ಸಾಂಗ್‌ತ್ಯಾತ. <verse eid="PHP 1:15"/><verse number="16" style="v" sid="PHP 1:16"/>ಹೆ ತರಿ ಬರೆ ಖಬರಿಚೆ ಗುಶ್ಟಿತ್ ಉತ್ತರ್ ಸಾಂಗಾಯಾ ಸಾಟಿ ಮನಾ ಹಿತ್ತ ಗ್ಯಾತ್‌ಲ್ಯಾ ಮನ್ಹುನ್ ಸಮಜು಼ನ್ ಮಾಯೆನಿ ಹ್ಯ ಕರ್ತ್ಯಾತ. <verse eid="PHP 1:16"/><verse number="17" style="v" sid="PHP 1:17"/>ತೇ ದುಸ್ರೆ ತರಚ಼ ಆಸ್‌ಲ್ಯಾವ ಮಿ ಬೆಡ್ಯಾಂಚಾನಿ ಬ್ಯಾಂದ್‌ಲ್ಯಾಲೊ ಹುತೊ ತವಾಬಿ ಮನಾ ತರಾಸ್ ಜಾಸ್ತಿ ಕರಾಯಾ ವ್ಹಯಿ ಮನ್ಹುನ್ ಯವಜು಼ನ್, ಪ್ರಾಮಾನಿಕ್ ನಸ್‌ಲ್ಯಾಲ್ಯಾನಿ ಸ್ವತಾಚಾ ಉದ್ದೆಶಾನಿ ಕ್ರಿಸ್ತಾಚೆ ಗುಸ್ಟಿತ್ ಸಾಂಗ್ನಾರ ಜಾ಼ಲ್ಯಾತ.<verse eid="PHP 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="PHP 1:18"/>ಕಸ ಜಾ಼ಲತರಿ ಕ್ಯಾ? ಕಚೆ ತರನಿಬಿ ಕಪ್‌ಟ್ಯಾನಿ ನಾಹಿತ ಖರ‍್ಯಾನಿ ವ್ಹವುನಿ ಕ್ರಿಸ್ತಾಚ಼ ಸಾಂಗ್‌ಲ್ಯಾಲ ಹಾ, ಹ್ಯನಿ ಮನಾ ಸಂತೊಶ್ ಜಾ಼ಲ್ಯಾ. ಮೊರ‍್ಹಬಿ ಸಂತೊಶ್ ವ್ಹನಾರ್. <verse eid="PHP 1:18"/><verse number="19" style="v" sid="PHP 1:19"/>ಕಾ ಮಂಜೆ ತುಮ್ಚಾ ಮಾಗ್‌ನ್ಯಾನಿ ಆನಿ ಯೇಸು ಕ್ರಿಸ್ತಾಚಾ ಆತ್‌ಮ್ಯಾಚೆ ಮಜ಼ತಿನಿ ಹ್ಯ ಮಾಜೆ ಸುಟ್ನುಕಿಲಾ ಪ್ಯಾಯ್ದಾ ವ್ಹಯಿಲ್ ಮನ್ಹುನ್ ಮನಾ ಠಾವ ಹಾ. <verse eid="PHP 1:19"/><verse number="20" style="v" sid="PHP 1:20"/>ಕಸ ಮಂಜೆ ಮಿ ಕಸ್ಲೆ ಗುಶ್ಟಿತ್ ಲಾಜಾ಼ಚೆ ಆಂದಿ ಖಾಯಿಮ್ಚೆಗತ್ ಆತ್ತಾಬಿ ಖುಬ್ ದಿರ‍್ಹಾನಿ ಹಾ ಮನ್ಹುನ್ ಜ಼ಗ್ಲೊ ತರಿ ಶಾರ್ಕ ಮೆಲೊ ತರಿ ಶಾರ್ಕ ಮಾಜಾ ಶರೀರಾಸ್ ಲಾಗುನ್ ಕ್ರಿಸ್ತಾಲಾ ಮೈಮಾ ವ್ಹಯಾ ವ್ಹಯಿ ಮನ್ಹುನ್ ಮಾಜ಼ ಖುಬ್ ಮನ್ ಜಾ಼ಲ್ಹ. ತಸಸ್ ವ್ಹನಾರ್ ಮನ್ಹುನ್ ಆಶಾ ಹಾ. <verse eid="PHP 1:20"/><verse number="21" style="v" sid="PHP 1:21"/>ಮನಾತರಿ ಜ಼ಗಾಚ಼ ಮಂಜೆ ಕ್ರಿಸ್ತುಸ್, ಮರಾಚಾ಼ ಪ್ಯಾಯ್ದಾ. <verse eid="PHP 1:21"/><verse number="22" style="v" sid="PHP 1:22"/>ಶರೀರಾತ್ ಜೀವ್ನಾ ಕರಾಯಾ ಸಾಟಿ ಮಾಜ಼ ಕಾಮ್ ಕರುನ್ ಪ್ಯಾಯ್ದಾ ಗಿಹ್ಯಾ ಮನಾ ವ್ಹನಾರ್ ಆಸ ಆಸ್ಥಾನಾ ಕಚ಼ ನಿವ್ಡುನ್ ಗಿಹ್ಯಾ ವ್ಹಯಿ ಮನ್ಹುನ್ ಮನಾ ಸಮಜ಼ನಾ. <verse eid="PHP 1:22"/><verse number="23" style="v" sid="PHP 1:23"/>ಹೇ ದುನಿಚೆ ಮದ್ದಿ ಗಾವುನ್ ಪಡ್ಲೊ, ಹೀತ್ನಿ ನಿಗುನ್ ಕ್ರಿಸ್ತಾಚೆ ಸಂಗ ರಾಹ್ಯಾಚ಼ಸ್ ಮಾಜ಼ ಮನ್, ತ್ಯ ಖುಬ್ ಬರಜಾ಼ಲ್ಯಾ. <verse eid="PHP 1:23"/><verse number="24" style="v" sid="PHP 1:24"/>ಫನ್ ಮೀ ಆಜು಼ನ್ ಶರೀರಾನಿ ಜಿತ್ತಾ ಹಾ ಮನ್ಹುನ್ ತುಮ್ಚಿ ಸಾಟಿ ಖುಬ್ ಗರಜ಼್ ಹಾ. <verse eid="PHP 1:24"/><verse number="25" style="v" sid="PHP 1:25"/>ಮನ್ಹುನ್ ತುಮಾನಾ ಕ್ರಿಸ್ತಾಚಾ ಇಸ್ವಾಸಾತ್ ವಾಡತ್ ಸಂತೊಸ್ ವ್ಹಯಾ ಸಾಟಿ ಮೀ ಜಿತ್ತಾ ರಾಹುನ್ ತುಮ್ಚಿ ಸಂಗ ರಾನ್ಹಾರ್ ಮನ್ಹುನ್ ಘಟ್ ಇಸ್ವಾಸ್ ಹಾ. <verse eid="PHP 1:25"/><verse number="26" style="v" sid="PHP 1:26"/>ಆಸಾ ಮೀ ಪರ್ತುನ್ ತುಮ್ಚಿಪ ಯತ್ಯೊ ಮನ್ಹುನ್ ತುಮಿ ಕ್ರಿಸ್ತ ಯೇಸುಚೆ ಗುಸ್ಟಿತ್ ಸಂತೊಸ್ ವ್ಹಯಾ ಸಾಟಿ ಮಾಜಿಪ್ನಿ ಖುಬ್ ಕಾರನ್ ವ್ಹನಾರ್.<verse eid="PHP 1:26"/></para>
  <para style="s">ಇಸ್ವಾಸಿಂಚಾನಿ ಬರೆ ಖಬರಿಲಾ ಯೊಗ್ಯ ರಾಹ್ಯಾ ವ್ಹಯಿ ಮನ್ಹುನ್ ಶಿಕ್ಷೆನ್</para>
  <para style="p">
    <verse number="27" style="v" sid="PHP 1:27"/>ಕಸಬಿ ಕ್ರಿಸ್ತಾಚೆ ಬರೆ ಖಬರಿಲಾ ಚಾ಼ಂಗ್ಲ ವ್ಹವುನ್ ಚಾ಼ಲಾ. ತವಾ ಮಿ ಯವುನ್ ತುಮಾನಾ ಬಗ್ಲ ತರಿ , ದುರ್ ರಾಹುನ್ ತುಮ್ಚೆ ಗುಶ್ಟಿತ್ ಐಕ್ಲತರಿ ತ್ಯವ್ಡಸ್. ತುಮಿ ತುಮ್ಚಾ ವಾದಿನಾ ಕಚೆಸ್ ಗುಸ್ಟಿತ್ ಬಿಹ್ಯಾಚೆಆಂದಿ ಯಕಾ ಮನಾನಿ ಘಟ್ ಉಬ ರಾಹುನ್ ಬರೆ ಖಬರಿವ ಥೆವ್‌ಲ್ಯಾಲ್ಯಾ ಇಸ್ವಾಸಾ ಸಾಟಿ ಯಕಾ ಮನಾನಿ ಮಿಳುನ್ ಲಡತ್ಯಾಲಿ ಜಾ಼ಲ್ಯಾಸಾ ಮನ್ಹುನ್ ಮಿ ಸಮಜು಼ನ್ ಗೆನ್ಹಾರ್. <verse eid="PHP 1:27"/><verse number="28" style="v" sid="PHP 1:28"/>ತುಮ್ಚಾ ವಿರೊದಿನಾ ಬಿಹು ನಕೊಸಾ ಕಾ ಮಂಜೆ ತುಮಿ ಆಸಿ ರಾಹ್ಯಾಚ಼ ವಾದಿಂಚಾ ನಾಸಾಲಾಬಿ , ತುಮ್ಚೆ ರಕ್ಷೆನೆಲಾಬಿ ಯೆಕ್ ವಳಕ್ ಜಾ಼ಲೆ. ಹ್ಯ ದೆವ್ ಕರ್ತ್ಯೊ. <verse eid="PHP 1:28"/><verse number="29" style="v" sid="PHP 1:29"/>ಕಾ ಮಂಜೆ ಕ್ರಿಸ್ತಾವ ಇಸ್ವಾಸ್ ಥೆವಾಚಾ಼ ತ್ಯವ್ಡಸ್ ನವ್ಹ ತ್ಯಚಿ ಸಾಟಿ ದುಖ್ ಗಿಹ್ಯಾಚ಼ ತುಮಾನಾ ಯೊಕ್ ಬರಾ ಅವಕಾಸ್ ಗಾವಲ್ಯಾ. <verse eid="PHP 1:29"/><verse number="30" style="v" sid="PHP 1:30"/>ಆಸ ತುಮಿ ಮಾಜಿಪ ಬಗ್‌ಲ್ಯಾಲ ಆನಿ ಆತಾ ಮಾಜೆ ಗುಶ್ಟಿತ್ ಐಕ್‌ತ್ಯಾಲಾ ತ್ಯೊಸ್ ತರಾಸ್ ತುಮಾನಾಬಿ ಹಾ.<verse eid="PHP 1:30"/></para>
  <chapter eid="PHP 1"/>
  <chapter number="2" style="c" sid="PHP 2"/>
  <para style="s">ಕ್ರಿಸ್ತಾಚಿ ದೀನತೆ ಆನಿ ಗಿಹ್ಯಾವ್ಹಯಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 2:1"/>ಕ್ರಿಸ್ತಾಪ್ನಿ ಉಮೇದ್, ಮಾಯೆಚ಼ ಸಮಜಾವ್ನ, ಪವಿತ್ರಾತ್ಮಾಚಿ ಯಕಿ, ಕನಿಕರಾ, ಗಾವ್ಹಾಚಿ ಜಾ಼ಲ್ಯಾವ <verse eid="PHP 2:1"/><verse number="2" style="v" sid="PHP 2:2"/>ತುಮಿ ಸಗ್ಳಿ ಯಕಾ ಮನಾನಿ, ಯಕ ಮಾಯೆನಿ, ಯಕ ಬಾವ್ನಾನಿ ಆಸ್‌ಲ್ಯಾಲಿ ರಾಹುನ್ ಆನಿ ಯೆಕುಸ್ ಮುಜ಼ರಾ ಥಿವುನ್ ಮಾಜಿ ಹಾವುಸ್ ಪುರಾ ಕರಾ. <verse eid="PHP 2:2"/><verse number="3" style="v" sid="PHP 2:3"/>ಆನಿ ಇರೊದಾನಿ ನಾಹಿತ ಫಕಳ್ಯಾಫನಾನಿ ಕಾಯೇಕ್ ಕರಾಚೆ ಆಂದಿ ಪರತೇಕ್ ಯೊಕ್ ನ್ಹಾನ್ ವ್ಹವುನ್ ಆನಿ ಯಕಾಲಾ ಆಪ್ಲಿವ್ನಿ ಮೊಟಾ ಮನ್ಹುನಿ. <verse eid="PHP 2:3"/><verse number="4" style="v" sid="PHP 2:4"/>ತುಮ್ಚಾತ್‌ಲ್ಯಾ ಪರತೇಕ್ ಯಕಾನಿ ಸ್ವತಾ ಆಪ್ಲಿ ತ್ಯವ್ಡಿಸ್ ನವ್ಹ ಆಂದಿ ದುಸ್‌ರ‍್ಯಾಂಚಿಬಿ ಚಿಂತಾ ಕರುನಿ. <verse eid="PHP 2:4"/><verse number="5" style="v" sid="PHP 2:5"/>ಕ್ರಿಸ್ತ ಯೇಸುಪ ಆಸ್‌ಲ್ಯಾಲ ಮನ್ ತುಮ್ಚಿಪಬಿ ರಾಹುನಿ.<verse eid="PHP 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="PHP 2:6"/>ತ್ಯೊ ದೇವಾಸಾರಾ ಆಸ್ಲಾತರಿ ದೇವಾಚೆ ಸರೊಸರ್ ರಾನ್ಹಾರಿ ಮುಟಿ ಪದ್ವಿ ಸುಡಿತ್ನಾಹಿ ಮನ್ಹುನ್ ಯವಜಾ಼ಚೆ ಆಂದಿ,<verse eid="PHP 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="PHP 2:7"/>ಆಪ್‌ಲ್ಯಾಲಾ ರಿಕ್ಕಾಮಾ ಕರುನ್ ಸೇವಕಾಚ಼ ರುಪ್ ಗಿಹುನ್ ಮಾನ್ಸಾಚೆಗತ್ ಜಾ಼ಲ್ಹಾ. ಮಾನ್ಸಾಚಾ ಆವ್ತಾರಾತ್ ದಿಸ್ಲಾ.<verse eid="PHP 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PHP 2:8"/>ತ್ಯನಿ ಆಪ್‌ಲ್ಯಾಲಾ ಖಾಲ್ ಕರುನ್ ಮರಾನ್ ಮಂಜೆ ಶಿಲುಬೆಚ಼ ಮರಾನ್ ಗಿಹಿಸಾರ ವಿಧೆಯ್ ಜಾ಼ಲ್ಹಾ.<verse eid="PHP 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="PHP 2:9"/>ಹ್ಯಾ ಕಾರ್ನಾನಿ ದೇವಾನಿ ತ್ಯಲಾ ಸಗ್‌ಳ್ಯಾತ್ ಮೊಟ್ಯಾ ಜಾ಼ಗ್ಯಾವ ಚ಼ಡುವುನ್, ಸಗ್‌ಳ್ಯಾ ನಾವಾವ್ನಿ ಚಾ಼ಂಗ್ಲ ಜಾ಼ಲ್ಯಾಲ ನಾವ್ ತ್ಯಲಾ ದಿಲ.<verse eid="PHP 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PHP 2:10"/>ಮನ್ಹುನ್ ಸ್ವರ್ಗಾತ್ ದರ್ಥಿವ ಆನಿ ಪಾತಾಳಾತ್ ಆಸ್‌ಲ್ಯಾಲಿ ಸಗ್ಳಿ ಯೇಸುಚಾ ನಾವಾನಿ ನಡ್ಗ ಗಾಲ್ನಾರ್ ,<verse eid="PHP 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="PHP 2:11"/>ಬಾ ಜಾ಼ಲ್ಯಾಲ್ಯಾ ದೇವಾಚೆ ಮೈಮೆ ಸಾಟಿ ಪರತೇಕ್ ಯೊಕ ಆಪಲ್ಯಾ ತೊಂಡಾನಿ ಯೇಸು ಕ್ರಿಸ್ತುಸ್ ಪ್ರಭು ಮನ್ಹುನ್ ಕಬುಲ್ ವ್ಹನಾರ್.<verse eid="PHP 2:11"/></para>
  <para style="s">ಚಾನ್ಯಾಂಚೆಗತ್ ಚ಼ಕ್ಮಕಾಚ಼</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 2:12"/>ಆಸ ಆಸ್ಥಾನಾ ಮಾಜೆ ಮಾಯೆಚಾನು, ತುಮಿ ಮಾಜಾ ಸಾಂಗ್‌ನ್ಯಾ ಸಾರಿ ಚಾ಼ಲ್ಯಾಸಾ ತಸಿಸ್ ಆತಾಬಿ ಚಾ಼ಲಾ. ಮಿ ತುಮ್ಚಿಪ ಆಸ್ಥಾನಾ ತ್ಯವ್ಡಸ್ ನವ್ಹ ಮಿ ನಸ್ಥಾನಾಬಿ ಖುಬ್ ಮನಾಚಾ ಭ್ಯಾನಿ ವಾಡತ್ ತುಮ್ಚಿ ತುಮ್ಚಿ ರಕ್ಷೆನ್ ಸಾದುನ್ ಗೆವ್ಹಾ. <verse eid="PHP 2:12"/><verse number="13" style="v" sid="PHP 2:13"/>ಕಾ ಮಂಜೆ ದೇವಾನಿಸ್ ಆಪ್‌ಲ್ಯಾ ಮನಾಚೆಗತ್ ಕರಾಯಾ ವ್ಹಯಿ ಮನ್ಹುನ್ ತುಮ್ಚಿಪ ಉದ್ದೆಶ್ ಆನಿ ಯತ್ನ ಕೆಲ್ಯಾಲಾ ಜಾ಼ಲ್ಯಾ.<verse eid="PHP 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 2:14"/>ಟುರ್ಟುರಾಚೆ ಆಂದಿ ವಾದ್ ವಿವಾದ್ ನಸ್ಥಾನಾ ಸಗ್ಳ ಕರಾ. <verse eid="PHP 2:14"/><verse number="15" style="v" sid="PHP 2:15"/>ಆಸಿ ತುಮಿ ಚು಼ಕ್ ಕೆಲ್ಯಾ ನಸ್‌ಲ್ಯಾಲಿ ಆನಿ ಖರ ಮನ್ ಆಸ್‌ಲ್ಯಾಲಿ ವ್ಹವುನ್ ವಾಕ್ಡಿ ಬುದ್ ಆಸ್‌ಲ್ಯಾಲೆ ಮುರ್ಖ ಜಾ಼ತಿಚೆ ಮದ್ದಿ ಕಳಂಕ್ ನಸ್‌ಲ್ಯಾಲಿ ದೇವಾಚಿ ಪೊರ ವ್ಹನಾರ್. <note caller="-" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="DEU 32:5">ಧರ್ಮೋಪದೇಶ 32:5</ref></char></note> <verse eid="PHP 2:15"/><verse number="16" style="v" sid="PHP 2:16"/>ಹ್ಯಂಚಾತ್ ತುಮಿ ಸಗ್‌ಳ್ಯಾನಾ ಜೀವಾಚಾ ವಾಕ್ಯಾ ದ್ಯಾವ್‌ತ್ಯಾಲಿ ವ್ಹವುನ್, ದುನೆತ್ ಚ಼ಮಕತ್ಯಾಲ್ಯಾ ಚಾನ್ಯಾಂಚೆಗತ್ ದಿಸ್ತಾಸಾ. ತುಮಿ ಆಸಿ ಚಾ಼ಲ್ಲಾಸಾತ ಮಿ ಬರೆ ಖಬರಿಸಾಟಿ ಪಳಾಲ್ಯಾಲೊ ಉಗಸ್ ನವ್ಹ, ಮಿ ತರಾಸ್ ಖಾಲ್ಯಾಲಾ ಉಗಸ್ ನವ್ಹ ಮನ್ಯಾಚ಼ ವವ್ಯಾಳ್ನ ಕ್ರಿಸ್ತಾಚಾ ದಿಸಾತ್ ಮನಾ ಗಾವ್ನಾರ್.<verse eid="PHP 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 2:17"/>ತುಮಚಾ಼ ಇಸ್ವಾಸ್ ಮಂಥ್ಯಾಲಾ ಯಜ್ಞ ದೇವಾಲಾ ದಿತ್ಯಾಲೆ ಸೆವೆತ್ ಮಿಸ್ ಪಾನದ್ರವ್ಯ ವ್ಹವುನ್ ಅರ್ಪನ್ ವ್ಹಯಾವ್ಹಯಿ ಜಾ಼ಲ್ಹತರಿ ಮನಾ ಸಂತೊಶ್ ಹಾ, ತುಮ್ಚೆ ಸಗ್‌ಳ್ಯಾಂಚೆ ಸಂಗ ಸಂತೊಶ್ ವ್ಹತ್ತೊ. <verse eid="PHP 2:17"/><verse number="18" style="v" sid="PHP 2:18"/>ತಸಿಸ್ ತುಮಿಬಿ ಸಂತೊಶ್ ವ್ಹವಾ, ಮಾಜಿ ಸಂಗಬಿ ಸಂತೊಶ್ ವ್ಹವಾ.<verse eid="PHP 2:18"/></para>
  <para style="s">ತಿಮೊಥಿ ಆನಿ ಎಪಪ್ರೊದೀತ್</para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 2:19"/>ಫನ್ ಮಿ ತಿಮೊಥೆಲಾ ಬಿಗಿನಿ ತುಮ್ಚಿಪ ಲಾವುನ್ ದಿಯಾ ವ್ಹಯಿ ಮನ್ಹುನ್ ಪ್ರಭು ಜಾ಼ಲ್ಯಾಲ್ಯಾ ಯೇಸುಪ ಆಶಾ ಕರ್ತೊ. ತ್ಯಚಿಸ್ ಲಾಗುನುಸ್ ತುಮ್ಚಾ ಖನ್ಕತಿ ಸಮಜು಼ನ್ ಮಿಬಿ ಉಮೇದ್ ಗೆನ್ಹಾರ್. <verse eid="PHP 2:19"/><verse number="20" style="v" sid="PHP 2:20"/>ತ್ಯಂಚಿಗತ್ ತುಮ್ಚೆ ಚಾ಼ಂಗ್ಲೆ ಗುಶ್ಟಿತ್ ಉಗಡಲ್ಯಾಲ್ಯಾ ಮನಾನಿ ಯವಸ್‌ತ್ಯಾಚೆಗತ್ ಮಾಜೆ ಸಂಗ ಆನಿ ಕೊನ್ ನಾಹಿ. <verse eid="PHP 2:20"/><verse number="21" style="v" sid="PHP 2:21"/>ಬಾಕಿಚಿ ಸಗ್ಳಿ ಸ್ವತಾಚಾ ಕಾಮಾವಸ್ ಮನ್ ಥೆವ್‌ತ್ಯಾತ ಖರ ಯೇಸು ಕ್ರಿಸ್ತಾಚಾ ಕಾಮಾವ ಮನ್ ಥಿವಿತ್ನಾಹಿತ. <verse eid="PHP 2:21"/><verse number="22" style="v" sid="PHP 2:22"/>ಫನ್ ತಿಮೊಥೆ ಕ್ಯವ್ಡಾ ಚಾ಼ಂಗ್ಲಾ ಮನ್ಹುನ್ ತುಮಾನಾ ಠಾವಾ ಹಾ. ಲ್ಯೊಕ್ ಬಾಲಾ ಕಸಾ ತಸಾಸ್ ತ್ಯನಿ ಮಾಜಿ ಸಂಗ ಬರಿ ಖಬರ್ ಸಾಂಗಾಯಾ ಸಾಟಿ ಸೇವಾ ಕೆಲೆ ಮನ್ಹುನ್ ತುಮಾನಾ ಠಾವ ಹಾ. <verse eid="PHP 2:22"/><verse number="23" style="v" sid="PHP 2:23"/>ಮನ್ಹುನ್ ಮಾಜೆ ಗುಶ್ಟಿತ್ ಕಸ ವ್ಹಯಾಚ಼ ತ್ಯ ಸಮಾಜ಼ಲ್ಯಾ ಬರ್ಬರ್ ತ್ಯಲಾ ಲಾವುನ್ ದಿಯಾ ಮನ್ ಕರ್ತೊ. <verse eid="PHP 2:23"/><verse number="24" style="v" sid="PHP 2:24"/>ಯವ್ಡಸ್ ನವ್ಹ ಮಿ ಸಾಹಿತ್ ಬಿಗಿನಿ ಯನಾರ್ ಮನ್ಹುನ್ ಪ್ರಭುವ ಘಟ್ ಇಸ್ವಾಸ್ ಹಾ.<verse eid="PHP 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PHP 2:25"/>ಮಾಜಿ ಗರಾಜ಼್ ಕಾಡಾಯಾ ತುಮಿ ಲಾವುನ್ ದಿಲ್ಯಾಲಾ, ಮಾಜಾ಼ ಬಾಹು, ಸಂಗಚಾ಼ ಸೇವಕ್ ಜಾ಼ಲ್ಯಾಲಾ ಎಪೊಪ್ರೊದೀತಲಾ ತುಮ್ಚಿಪ ಲಾವುನ್ ದಿಯಾಚ಼ ಅವಶ ಹಾ. <verse eid="PHP 2:25"/><verse number="26" style="v" sid="PHP 2:26"/>ತ್ಯನಿ ತುಮ್ಚೆ ಸಗ್‌ಳ್ಯಾಂಚೆ ಗುಶ್ಟಿತ್ ಆಶಾ ಆನಿ ಆಪ್ನು ಬರಾ ನಸ್‌ಲ್ಯಾಲಿ ಬಾತ್ನಿ ತುಮಿ ಐಕ್ಲಿಸಾ ಮನ್ಹುನ್ ತ್ಯಲಾ ಹುರ್ವುರಾ ಲಾಗುನ್ ಚಿಂತನಿ ಠಕ್ಲಾ.<verse eid="PHP 2:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="PHP 2:27"/>ತ್ಯೊ ರೊಗ್ಡಾ ವ್ಹವುನ್ ಮರಾಯಾ ಠಕ್ಲಾ ವ್ಹತ್ತಾ ತ್ಯ ಖರಸ್, ಫನ್ ದೇವಾನಿ ತ್ಯಚಿವ ದಯಾ ದ್ಯಾವ್ಲಿ. ತ್ಯಲಾ ತ್ಯವ್ಡಸ್ ನವ್ಹ ಮನಾ ದುಖಾವ ದುಖ್ ಯವು ನಾಹಿ ಮನ್ಹುನ್ ಮಾಜಿವ ದಯಾ ದ್ಯಾವ್ಲಿ. <verse eid="PHP 2:27"/><verse number="28" style="v" sid="PHP 2:28"/>ಮನ್ಹುನ್ ತುಮಿ ತ್ಯಲಾ ಪರತ್ ಬಗುನ್ ಸಂತೊಶ್ ವ್ಹಯಾವ್ಹಯಿಸಾ ಮನ್ಹುನ್ ಮಾಜ಼ ದುಖ್ ಕಮ್ಮಿ ವ್ಹಯಾ ವ್ಹಯಿ ಮನ್ಹುನ್ ಮಿ ತ್ಯಲಾ ಖುಬ್ ಆಶಾನಿ ಲಾವುನ್ ದಿಲ್ಯಾ. <verse eid="PHP 2:28"/><verse number="29" style="v" sid="PHP 2:29"/>ತಸ ಆಸ್ಥಾನಾ ತುಮಿ ತ್ಯಲಾ ಪುರ‍್ಯಾ ಮನಾನಿ ಸಂತೊಶಾನಿ ಪ್ರಭುಚಾ ನಾವಾನಿ ಮಿಳ್ವುನ್ ಗೆವ್ಹಾ ಆನಿ ತಸ್‌ಲ್ಯಾನಾ ಮರ‍್ಯಾದ್ ದೇವಾ. <verse eid="PHP 2:29"/><verse number="30" style="v" sid="PHP 2:30"/>ಆಸ ಆಸ್ಥಾನಾ ತುಮಿಸ್ ಮನಾ ಕರಾಯಾ ವ್ಹಯಿ ಮಂಥ್ಯಾಲ್ಯಾ ಉಪ್ಕಾರಾಚೆ ಗುಶ್ಟಿತ್ ಕಮ್ಮಿ ಜಾ಼ಲ್ಯಾಲ ಪುರ ಕರಾಯಾ ತ್ಯೊ ಆತ್‌ಲ್ಯಾ ಜೀವಾಚೆ ಆಶೆಲಾ ದ್ಯಾನ್ ದಿಯಾಚೆ ಆಂದಿ ಕ್ರಿಸ್ತಾಚಾ ಕಾಮಾಸಾಟಿ ಮೆಲ್ಯಾಚೆಗತ್ ಜಾ಼ಲ್ಥಾ.<verse eid="PHP 2:30"/></para>
  <chapter eid="PHP 2"/>
  <chapter number="3" style="c" sid="PHP 3"/>
  <para style="s">ಖರಿ ನಿಯೆತ್</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 3:1"/>ಸರ್ತೆ ಪಾವ್ಟಿ, ಮಾಜಾ ಬನ್ಹಿ ಬಾವ್ಹಾನು, ಪ್ರಭುಪ ಸಂತೊಶಾನಿ ರಾವ್ಹಾ, ಆಂದಿ ಸಾಂಗ್‌ಲ್ಯಾಲ್ಯಾ ತ್ಯಾ ಗುಶ್ಟಿ ಪರ್ತುನ್ ತುಮಾನಾ ಲಿವಾಯಾ ಕಂಟಾಳಾ ಕರಿತ್ನಾಹಿ, ಫನ್ ತ್ಯ ತುಮಾನಾ ಜ಼ಪುನ್ ಥೆವ್ನಾರ್. <verse eid="PHP 3:1"/><verse number="2" style="v" sid="PHP 3:2"/>ತ್ಯ ಬುರ್ಸ ಕಾಮ್ ಕರ್ತ್ಯಾಲ್ಯಾ ಕುತ್‌ರ‍್ಯಾಂಚಿಪ್ನಿ ಹುಶಾರ್ ರಾವ್ಹಾ, ಮುಂಜಿ ಮನ್ಹುನ್ ಸಾಂಗುನ್ ಶರೀರ್ ಬಲಿ ದೆತ್ಯಾಲ್ಯಾಂಪ್ನಿ ಹುಶಾರ್ ರಾವ್ಹಾ. <verse eid="PHP 3:2"/><verse number="3" style="v" sid="PHP 3:3"/>ಖರ‍್ಯಾನಿ ಮುಂಜಿ ಕೆಲ್ಯಾಲ ಕೊನ್ ಮಂಜೆ, ದೆವಾಚಾ ಆತ್‍ಮ್ಯಾನಿ ಬರ‍್ಹುನ್ ವವ್ಯಾಳ್ನಾರ ಯೆಸು ಕ್ರಿಸ್ತಾಪ ಸಂತೊಶ್ ವ್ಹತ್ಯಾತ ಆನಿ ಶರಿರಾಲಾ ಜು಼ಡುನ್ ಆಸ್‍ಲ್ಯಾಲ್ಯಾವ ಆಶಾ ಥೆವ್ನಾರ ಇಸ್ವಾಸ್ ನಸ್ನಾರ ಜಾ಼ಲ್ಯಾಲ ಆಮಿಸ್. <verse eid="PHP 3:3"/><verse number="4" style="v" sid="PHP 3:4"/>ಮಿ ತರಿ ಶರಿರಾಲಾ ಸಮ್ಮನ್ ಆಸಲ್ಯಾಲ್ಯಾವ ಇಸ್ವಾಸ್ ಥೆವಾಯಾ ಆವ್ಕಾಸ್ ಹಾ. ದುಸರ್ಯಾನಿ ಕುನಿತರಿ ಶರಿರಾಲಾ ಸಮನ್ಆಸ್‌ಲ್ಯಾಲ್ಯಾವ ಆಶಾ ಥೆವಾಯಾ ವ್ಹಯಿ ಮನ್ಹುನ್ ಯವಜಾ಼ಚ಼ ಜಾ಼ಲ್ಯಾವ ತ್ಯಚಿವ್ನಿ ಆಗಾವ್ ತಸ ಯವಜಾ಼ಯಾ ವ್ಹಯಿಲ್. <verse eid="PHP 3:4"/><verse number="5" style="v" sid="PHP 3:5"/>ಜ಼ಲಾಮ್‌ಲ್ಯಾಲ್ಯಾ ಆಟ್ವೆ ದಿಸಿ ಮಾಜಿ ಮುಂಜಿ ಜಾ಼ಲಿ, ಮಿ ಇಸ್ರಾಯೆಲ್ ಲೊಕಾತ್ಲಾ, ಬೆನ್ಯಾಮಿನ್ ವಂಶಾತ್ಲಾ, ಇಬ್ರಿಯಾಂಚಿಪ್ನಿ ಜ಼ಲಾಮ್‍ಲ್ಯಾಲಾ ಇಬ್ರಿಯ, ದರ್ಮಶಾಸ್ತಾರಾಚೆಗತ್ ಬಗ್‍ಲ್ಯಾವ ಮಿ ಪರಿಸಾಯ್. <verse eid="PHP 3:5"/><verse number="6" style="v" sid="PHP 3:6"/>ಫನ್ ಧರ್ಮಾನಿ ಬಗಾಯಾ ವ್ಹಯಿತ ಮಿ ಕ್ರಿಸ್ತ ಮಂಡಳಿಲಾ ತರಾಸ್ ದಿಲ್ಯಾಲಾ, ದರ್ಮಶಾಸ್ತಾರಾತ್ ಸಾಂಗ್‍ಲ್ಯಾಲಿ ನೀಯತ್ ಬಗ್‍ಲ್ಯಾವ ಮಿ ದೊಸ್ ನಸ್ನಾರಾ. <verse eid="PHP 3:6"/><verse number="7" style="v" sid="PHP 3:7"/>ತರಿಬಿ ಮಾಜ಼ ಫ್ಯಾಯ್‍ದ್ಯಾಚ಼ ಸಗ್ಳ ಕ್ರಿಸ್ತಾಸಾಟಿ ಲುಕ್ಷಾನಿಚ಼ ಮನ್ಹುನ್ ಸಮ್‍ಜ಼ುನ್ ಗೆತ್ಲ. <verse eid="PHP 3:7"/><verse number="8" style="v" sid="PHP 3:8"/>ಯವ್ಡಸ್ ನವ್ಹ, ಮಾಜಾ಼ ಪ್ರಭು ಜಾ಼ಲ್ಯಾಲ್ಯಾ ಕ್ರಿಸ್ತ ಯೆಸುಲಾ ಸಮಜು಼ನ್ ಗಿಹ್ಯಾಚ಼ಸ್ ಖುಬ್ ಬರ ಮನ್ಹುನ್ ಬಾಕಿಚ಼ ಸಗ್ಳ ಲುಕ್ಷಾನಿಚ಼ ಮಂತೊ. ಮನಾ ಕ್ರಿಸ್ತಾಚಾ಼ ಫ್ಯಾಯ್ದಾ ವ್ಹಯಾ ಪ್ಯಾಯ್ದಾ ಜಾ಼ಲ್ಯಾಲ ಬಾಕಿ ಸಗ್‍ಳ್ಯಾಲಾ ಕ್ಯೊರ್ ಮಂತ್ಯೊ. <verse eid="PHP 3:8"/><verse number="9" style="v" sid="PHP 3:9"/>ಹ್ಯಾತ್ ಮಾಜ಼ ಮನ್ಹ ಕ್ಯಾ ಮಂಜೆ, ಮಿ ಕ್ರಿಸ್ತಾಲಾ ಕಮವುನ್, ದರ್ಮಶಾಸ್ತಾರಾಚ಼ ಫಳ್ ಜಾ಼ಲ್ಯಾಲೆ ಸ್ವತಾಚೆ ನೀಯತಿಲಾ ನವ್ಹ, ಕ್ರಿಸ್ತಾವ ಇಸ್ವಾಸ್ ಥೆವಲ್ಯಾಲ್ಯಾಸ್ ಲಾಗುನ್ ಗಾವತ್ಯಾಲ ಮಂಜೆ ಕ್ರಿಸ್ತಾವಲ್ಯಾ ಇಸ್ವಾಸಾಚಾ ಆದಾರಾನಿ ದೆವ್ ದೆತ್ಯಾಲಿ ನಿಯೆತ್ ಗಿಹುನ್ ಕ್ರಿಸ್ತಾಪ ರಾಥ್ಯಾಲಾ ವ್ಹಯಾ ವ್ಹಯಿ. <verse eid="PHP 3:9"/><verse number="10" style="v" sid="PHP 3:10"/>ತ್ಯಲಾ ಆನಿ ತ್ಯಚಾ ಪುನರುತ್ತಾನಾತ್ ಆಸ್‍ಲ್ಯಾಲ್ಯಾ ಬಳಾಲಾ, ತ್ಯಚಾ ತರಾಸಾತ್ ವಾಟದಾರ್ ಜಾ಼ಲ್ಯಾಲೆ ಪದ್ವಿಲಾ ಸಮಜ಼ುನ್ ತ್ಯಚಾ ಮರ್ನಾಚೆ ಗುಸ್ಟಿತ್ ತ್ಯಚಿಗತ್ ವ್ಹಯಾವ್ಹಯಿ ಮನ್ಹುನ್ ಮಾಜ಼ ಮನ್. <verse eid="PHP 3:10"/><verse number="11" style="v" sid="PHP 3:11"/>ಆಸ ಜಾ಼ಲ್ಯಾವ ಮೆಲ್ಯಾಲ್ಯಾತ್ ಥೊಡ್ಯಾನಾ ವ್ಹತ್ಯಾಲ್ಯಾ ಪುನರುಥಾನಾಚ಼ಾ ಅನ್ಬವ್ ಮನಾಬಿ ವ್ಹಯಿಲ್.<verse eid="PHP 3:11"/></para>
  <para style="s">ಬಕ್ಸಿಸಾಸಾಟಿ ಪಳಾಚ಼</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 3:12"/>ಯವ್‌ಡ್ಯಾತ್ ಮಿ ಹ್ಯ ಸಗ್ಳ ಗಿಹುನ್ ಪುರ್ನ ಜಾ಼ಲ್ಯೊ ಮನ್ಹುನ್ ಸಾಂಗಿತ್ನಾಹಿ. ಫನ್ ಮಿ ಕಚ಼ ಗಿಹ್ಯಾಸಾಟಿ ಕ್ರಿಸ್ತ ಯೆಸುನಿ ಮನಾ ದರ್ಲ್ಯಾ ತ್ಯ ಗಿಹ್ಯಾಸಾಟಿ ತ್ಯಚೆ ಮಾಗ ಲಾಗ್‍ಲ್ಯೊ. <verse eid="PHP 3:12"/><verse number="13" style="v" sid="PHP 3:13"/>ಬನ್ಹಿ ಬಾವ್ಹಾನು ಮನಾ ಗಾವಲ್ಯಾ ಮನ್ಹುನ್ ಮಿ ಆಜು಼ನ್ ಸಮಜ಼ುನ್ ಗೆತ್ಲನಾಹಿ. ಫನ್ ಯಾಕ್, ಮಿ ಮಾಗ್‍ಲ್ಯಾ ಗುಸ್ಟಿ ಇಸ್ರುನ್ ಮೊರಲ್ಯಾ ದರಾಯಾ ಶಾತಿ ಫುಗುವುನ್, <verse eid="PHP 3:13"/><verse number="14" style="v" sid="PHP 3:14"/>ದೆವಾನಿ ಕ್ರಿಸ್ತಾಸ್ಲಾಗುನ್ ಆಮಾನಾ ಮೊಟ್ಯಾ ಫನಾಲಾ ಹಾಕ್ಟುನ್ ಆಮಾನಾ ಥೆವ್‌ಲ್ಯಾಲ್ಯಾ ಬಕ್ಷಿಸಾವ್ಲಾ ಮುಜ಼್ರಾ ಪೊಚಾ಼ಯಾಸಾಟಿ ಪಳ್‍ತ್ಯೊ.<verse eid="PHP 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 3:15"/>ಆಮ್ಚಿಪ ತಯಾರ್ ಆಸ್‍ಲ್ಯಾಲಿ ಸಗ್ಳಿ ಹೆ ಗುಸ್ಟಿತ್ ಹ್ಯಾಸ್ ಇಚಾರಾತ್ ರಾವ್ಹಾ. ಆನಿ ಕಚೆತರಿ ಯಕ ಗುಸ್ಟಿತ್ ದಿಸ್ರಾ ಇಚಾರ್ ಕೆಲಾಸಾತ ತ್ಯೊ ದೆವ್ ತುಮಾನಾ ದಾವುನ್ ದೆನಾರ್. <verse eid="PHP 3:15"/><verse number="16" style="v" sid="PHP 3:16"/>ಆಮಿತರಿ, ಕಚಾ ನೇಮಾನಿ ಇತ್ಪರ‍್ಯಾತ್ ಆಲ್ಯಾವ್ ತ್ಯಾ ನೆಮಾಚೆಗತುಸ್ ಚಾ಼ಲುಯಾ.<verse eid="PHP 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 3:17"/>ಬನ್ಹಿ ಬಾವ್ಹಾನು, ತುಮಿ ಸಗ್ಳಿ ಮಾಜಿ ಸಂಗ ಮಿಳುನ್ ಮಾಜಿಗತ್ ಚಾ಼ಲತ್ಯಾಲಿ ವ್ಹವಾ ಆನಿ ಆಮಿ ಸಾಂಗ್‌ಲ್ಯಾಲ್ಯಾ ನೆಮಾಶಾರ್ಕಿ ಚಾ಼ಲತ್ಯಾಲ್ಯಾಂಚಿವ ಧ್ಯಾನ್ ರಾಹುನಿ. <verse eid="PHP 3:17"/><verse number="18" style="v" sid="PHP 3:18"/>ಕಾಮಂಜೆ ಖುಬ್ ಜಾ಼ನ್ ಕ್ರಿಸ್ತಾಚೆ ಶಿಲಬೆಚ಼ ವಾದಿ ವ್ಹವುನ್ ಚಾ಼ಲತ್ಯಾತ. ತ್ಯಂಚೆ ಗುಸ್ಟಿತ್ ತುಮಾನಾ ಖುಬ್ ಖೆಪಾ ಸಾಂಗ್‍ಲ್ಯಾ ಮನ್ಹುನ್ ಆತಾಬಿ ರಡುನ್ ಸಾಂಗ್ತೊ. <verse eid="PHP 3:18"/><verse number="19" style="v" sid="PHP 3:19"/>ಶೆವಟ್ ತ್ಯಂಚಾ಼ ನಾಸುಸ್, ಪ್ವಾಟ್ ತ್ಯಂಚಾ಼ ದೆವ್, ಲಾಜ಼ಚಾ ಕಾಮಾತ್ನಿಸ್ ತ್ಯನಾ ಮರ‍್ಯಾದ್, ತಿ ದುನೆತ್‍ಲ್ಯಾ ಗುಸ್ಟಿಂಚಾ಼ ಇಚಾರ್ ಕರತ್ಯಾತ. <verse eid="PHP 3:19"/><verse number="20" style="v" sid="PHP 3:20"/>ಆಮಿತರಿ ಸ್ವರಗಾತ್ಲಿ ಪ್ರಜಾ, ಪ್ರಭು ಜಾ಼ಲ್ಯಾಲಾ ಯೇಸು ಕ್ರಿಸ್ತ ತಿತ್ನಿಸ್ ರ‍್ಯಾಕ್ನಾರಾ ವ್ಹವುನ್ ಯಯಾಚಿ ವಾಟ್ ಬಗ್‍ತ್ಯಾಲ ಹಾವ್. <verse eid="PHP 3:20"/><verse number="21" style="v" sid="PHP 3:21"/>ತ್ಯೊ ಸಗ್ಳ ಆಪ್‍ಲ್ಯಾ ತಾಬ್ಯಾತ್ ಗಿಹ್ಯಾ ಬಳ್ ಗಿಹುನ್ ನೀಚ಼್ ಸ್ಥಿತಿತ್ ಆಸ್‍ಲ್ಯಾಲ ಆಮ್ಚ ಶರಿರ್ ಉಜಿಡಾಚಾ ಆಪ್‌ಲ್ಯಾ ಶರಿರಾಚೆಗತ್ ಕರ್ನಾರ್.<verse eid="PHP 3:21"/></para>
  <chapter eid="PHP 3"/>
  <chapter number="4" style="c" sid="PHP 4"/>
  <para style="s">ಸುಸ್ನಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 4:1"/>ಆಸ ಆಸ್ತಾನಾ ಮಾಜೆ ಮಾಯೆಚಾ ಬನ್ಹಿ ಬಾವ್ಹಾನು ಮನಾ ಸಂತೊಶ್ ಆನಿ ಕಿರಿಟ್ ಜಾ಼ಲ್ಯಾಲ್ಯಾನು, ಮಿ ಸಾಂಗ್‍ಲ್ಯಾ ಶಾರ್ಕ ಪ್ರಭುಪ ಘಟ್ ಉಬಿ ರಾವ್ಹಾ:<verse eid="PHP 4:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 4:2"/>ಪ್ರಭುಪ ಯಕಾ ಮನಾನಿ ರಾವ್ಹಾ ಮನ್ಹುನ್ ಯುವೊದಿಪ ಆನಿ ಸಂತುಕಿಪ ಮಾಗ್ತೊ. <verse eid="PHP 4:2"/><verse number="3" style="v" sid="PHP 4:3"/>ಮಾಜಾ ಖರ‍್ಯಾ ಸಂಗಚಾ ಸೆವಕಾ, ತ್ಯಾ ಬಾಯಿಲ್ಮಾನ್ಸಾನಾ ಮಜ಼ತ್ ಕರ್ನಾರಾ ವ್ಹವುನ್ ರಾಹ್ಯಾವ್ಹಯಿಸ್ ಮನ್ಹುನ್ ತುಲಾ ಸಾಂಗ್ತೊ. ತ್ಯಾ ಕ್ಲೇಮೆನ್ಸ ದಿಸ್ರಿ ಮಾಜೆ ಸಂಗಚಾ ಕಾಮ್ಯಾರ‍್ಯಾನಾ ಮಾಜಿಸಂಗ ಬರೆ ಖಬರಿಸಾಟಿ ತರಾಸ್ ಖಾಲ್ಯಾಲ್ಯಾನಾ ಮಜ಼ತ್ ಕರ್. ತ್ಯಂಚಿ ನಾವ ಶಾಸ್ವತ್ ಜಿವಾಚಾ ಪುಸ್ತಕಾತ್ ಲಿವ್‍ಲ್ಯಾತ.<verse eid="PHP 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PHP 4:4"/>ಕವಾಬಿ ಪ್ರಭುಪ ಆನಂದಾನಿ ರಾವ್ಹಾ, ಆನಂದಾನಿ ರಾವ್ಹಾ ಮನ್ಹುನ್ ಪುನ್ಹಾ ಸಾಂಗ್ತೊ.<verse eid="PHP 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="PHP 4:5"/>ತುಮಚ಼ ಥಂಡ್ಫನ್ ಸಗ್‍ಳ್ಯಾ ಲೊಕಾನಾ ಸಮಜು಼ನಿ, ಪ್ರಭುಚ಼ ಯನ ಜ಼ವಳ್ ಹಾ. <verse eid="PHP 4:5"/><verse number="6" style="v" sid="PHP 4:6"/>ಕಶಾಚಿ ಚಿಂತಾ ಕರಾಚೆ ಆಂದಿ ಸರ್ವ್ಯಾ ಗುಶ್ಟಿತ್ನಿ ದೇವಾಚೆ ಮೊರ‍್ಹ ಕ್ರತಜ್ಞತಾ ಸ್ತುತಿ ಮಾಗ್ನಿ ಇನಂತಿ ಕರಿತ್ ತುಮಾನಾ ವ್ಹಯಿತ್ಯ ಪ್ರಭುಲಾ ಸಾಂಗಾ. <verse eid="PHP 4:6"/><verse number="7" style="v" sid="PHP 4:7"/>ತವಾ ಸಗ್ಳೆ ಸಮಜು಼ಕಿವ್ನಿ ಆಗಾವ್ ಆಸ್‍ಲ್ಯಾಲಿ ದೆವಾಚಿ ಶಾಂತಿ ತುಮ್ಚಿ ಮನ, ಯವಜ಼್ನಾ ಕ್ರಿಸ್ತ ಯೆಸುಪ ರಾಖುನಿ.<verse eid="PHP 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PHP 4:8"/>ಸರ್ತ್ಯಾಯಳಾಲಾ, ಭನ್ಹಿ ಬಾವ್ಹಾನು, ಕಚ಼ ಖರ, ಕಿಮ್ತಿಚ಼, ನೀಯತಿಚ಼, ನಿರ್ಮಳ್, ಮಾಯೆಚ಼, ಮರೆದಿಚ಼ ಹಾ, ಕಚ಼ ಚಾ಼ಂಗಲ್ಯಾ ಗುನಾಚ಼ ಹಾ, ಕಚ಼ ಮರೇದಿಲಾ ಚಾ಼ಂಗ್ಲ ಹಾ, ತ್ಯಾ ಸಗ್‌ಳ್ಯಾಂಚಿ ಕ್ಯಾಳ್ಜಿ ಕರಾ. <verse eid="PHP 4:8"/><verse number="9" style="v" sid="PHP 4:9"/>ತುಮಿ ಮಾಜಿಪ್ನಿ ಕ್ಯಾ ಶಿಕ್‍ಲ್ಯಾಸಾ, ಆನಿ ಮಾಜ಼ ಕ್ಯಾ ಐಕುನ್ ಬಗ್‌ಲ್ಯಾಸಾ ತ್ಯಸ್ ಕರಿತ್ ಯವಾ. ಆಸ ಕೆಲ್ಯಾವ ಥಂಡ್ಪನಾಚಾ಼ ದೆವ್ ತುಮ್ಚಿ ಸಂಗ ರಾನ್ಹಾರ್.<verse eid="PHP 4:9"/></para>
  <para style="s">ಬಹುಮಾನಾಸಾಟಿ ದನ್ಯವಾದ್</para>
  <para style="p">
    <verse number="10" style="v" sid="PHP 4:10"/>ಮಾಜಿವ ತುಮಾನಾ ಆಸ್‍ಲ್ಯಾಲಿ ಕ್ಯಾಳ್ಜಿ ಇತ್‍ಕ್ಯಾ ದಿಸಾನಂತರ್ ಆನಿಕ್ ಫುಟ್ಲಿ ಮನ್ಹುನ್ ಮಿ ಪ್ರಭುಪ ಖುಬ್ ಸಂತೊಸ್ ವ್ಹತೊ. ಆಸ್ಲಿ ಯವಜ಼್ನಾ ತುಮ್ಚಿಪ ಆಂದಿದರ‍್ನಿ ಆಸ್‌ಲ್ಯಾವ, ಮಜ಼ತ್ ಕರಾಯಾ ಶಾರ್ಕಾ ಯೊಳ್ ಮಿಳುನ್ ಆಲಾನವ್ಥಾ. <verse eid="PHP 4:10"/><verse number="11" style="v" sid="PHP 4:11"/>ಮನಾ ವ್ಹಯಿ ಜಾ಼ಲ್ಯಾಲೆ ಗುಶ್ಟಿತ್ ಹ್ಯ ಮೀ ಸಾಂಗಿತ್ನಾಹಿ ಮೀ ಹಾ ತ್ಯಾತುಸ್ ಸಮಾದಾನಾನಿ ರಾಹ್ಯಾ ಸಿಕ್‌ಲ್ಯೊ. <verse eid="PHP 4:11"/><verse number="12" style="v" sid="PHP 4:12"/>ಗರಿಬ್ತಿತಿತ್ ರಾಹ್ಯಾಚ಼, ಸಗ್ಳ ಆಸ್ತಾನಾ ಕಸ ರಾಹ್ಯಾಚ಼ ಮನಾ ಠಾವ ಹಾ. ಮಿ ತ್ರಪ್ತ, ಬುಕಚಾ಼, ಸಗ್ಳ ಆಸ್ನಾರಾ, ಕಾಯ್ನಸ್ನಾರಾ, ಜಾ಼ಲೊತರಿ ಕಸ್ಲೆ ಪರಸ್ತಿತಿತ್ ಆಸ್ಲೊತರಿ ತ್ಯಚಿ ಪಾರಕ್ ಮನಾ ಹಾ. <verse eid="PHP 4:12"/><verse number="13" style="v" sid="PHP 4:13"/>ಮನಾ ಬಳ್ ದೆತ್ಯಾಲ್ಯಾ ಕ್ರಿಸ್ತಾಸ್ ಲಾಗುನ್ ಮಿ ಸಗ್ಳ ಕರಾಯಾ ಬಳಿಜಾ಼ಲ್ಯೊ.<verse eid="PHP 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 4:14"/>ಆಸ ಆಸ್ತಾನಾ ತುಮಿ ಮಾಜಾ ತರಾಸಾತ್ ವಾಟದಾರ್ ಜಾ಼ಲ್ಯಾಲ ಬರಜಾ಼ಲ್ಹ. <verse eid="PHP 4:14"/><verse number="15" style="v" sid="PHP 4:15"/>ಫಿಲಿಪಿತಲ್ಯಾನು, ಆಂದಿ ತುಮ್ಚಿಪ ಬರಿ ಖಬರ್ ಸಾಂಗುನ್, ಮಕೆದೊನ್ಯಾತ್ನಿ ನಿಗುನ್ ಜಾ಼ತಾನಾ ದೆನ್ಯಾ ಗೆನ್ಯಾಚೆ ಗುಸ್ಟಿತ್ ತುಮ್ಚೆ ಶಿವಾರ್ ದಿಸ್ರೆ ಕಚೆಸ್ ಮಂಡಳಿನಿ ಮನಾ ಮಜ಼ತ್ ಕಿಲಿನಾಹಿ ಮನ್ಹುನ್ ತುಮಾನಾ ಠಾವ ಹಾ. <verse eid="PHP 4:15"/><verse number="16" style="v" sid="PHP 4:16"/>ಮಿ ಥೆಸಲೊನಿಕಾತ್ ಆಸ್ತಾನಾಬಿ ತುಮಿ ಯಂಗ್ದಾ ದೊಂದಾ ಮಾಜಿ ಗರಜ಼್ ಬಾಗಿವ್ಲಿಸಾ. <verse eid="PHP 4:16"/><verse number="17" style="v" sid="PHP 4:17"/>ಮಿ ತುಮ್ಚಿಪ್ನಿ ದಿನ್ಗಿಚಿ ಆಶಾ ಕರಿತ್ನಾಹಿ ಫನ್ ತುಮ್‌ಚಾ಼ ಇಸೊಬ್ ವಾಡ್ವಾಚಾ಼ ಇಚ್ಚಾ ಹಾ. <verse eid="PHP 4:17"/><verse number="18" style="v" sid="PHP 4:18"/>ಮನಾ ವ್ಹಯಿತ್ಯ ಹಾ, ಸಗ್ಳ ಆಸ್ನಾರಾ ಹಾ. ತುಮಿ ಎಪೊಪ್ರೊದಿಪಾಪ ಲಾವುನ್ ದಿಲ್ಯಾಲ ಮಾಜಿಪ ಪೊಚ್‌ಲ್ಯಾ ತ್ಯನಿ ಮಿ ಬರ‍್ಹುನ್ ಉತ್ತು ಆಲ್ಯೊ. ತ್ಯ ದೆವಾಲಾ ದಿಲ್ಯಾಲ ವಾಸಾಚ಼ ಯಜ್ಞ ಹ್ಯಸ್ ದೇವಾಲಾ ಮಾನ್ಯ ಜಾ಼ಲ್ಯಾ. <verse eid="PHP 4:18"/><verse number="19" style="v" sid="PHP 4:19"/>ಮಾಜಾ ದೆವಾನಿ ಕ್ರಿಸ್ತ ಯೆಸುಪ್ನಿ ಆಪ್‌ಲ್ಯಾ ಉಜಿಡಾಚೆ ಸಾವ್ಕರಿಚೆಗತ್ ತುಮ್ಚಿ ಗರಜ಼್ ಬಾಗಿವ್ನಾರ್. <verse eid="PHP 4:19"/><verse number="20" style="v" sid="PHP 4:20"/>ಆಮ್ಚಾ ಬಾ ದೆವಾಲಾ ಖಾಯಿಮ್ ಮೈಮೆ ವ್ಹವುನಿ. ತಸಸ್ ವ್ಹವುನಿ.<verse eid="PHP 4:20"/></para>
  <para style="s">ಸರ್ತ ಸಲಾಮ್</para>
  <para style="p">
    <verse number="21" style="v" sid="PHP 4:21"/>ಕ್ರಿಸ್ತ ಯೇಸುಪಲ್ಯಾ ಸಗ್‌ಳ್ಯಾ ದೇವಾಚಾ ಲೊಕಾನಾ ಮಾಜ಼ ದನ್ಯಾವಾದ್ ಸಾಂಗಾ. ಮಾಜೆ ಸಂಗಚಿ ಬನ್ಹಿ ಬಾಹು ತುಮಾನಾ ನಮಸ್ಕಾರ್ ಸಾಂಗ್‍ತ್ಯಾತ. <verse eid="PHP 4:21"/><verse number="22" style="v" sid="PHP 4:22"/>ಹಿತ್ತ ಆಸ್‌ಲ್ಯಾಲ್ಯಾ ಸಗ್‌ಳ್ಯಾ ದೇವಾಚಾ ಲೊಕಾಂಚಾನಿ ತುಮಾನಾ ನಮಸ್ಕಾರ್ ಸಾಂಗಲ್ಯಾ. ಲ ಕರುನ್ ಕೈಸರ್ ರಾಜಾಚಾ ಗರ‍್ಹಾತ್ಲಿ ತುಮಾನಾ ನಮಸ್ಕಾರ್ ಸಾಂಗತ್ಯಾತ. <verse eid="PHP 4:22"/><verse number="23" style="v" sid="PHP 4:23"/>ಪ್ರಭು ಯೇಸು ಕ್ರಿಸ್ತಾಚಿ ಕ್ರಪಾ ತುಮ್ಚಾ ಆತ್ಮಾಸಂಗ ರಾಹುನಿ.<verse eid="PHP 4:23"/></para>
  <chapter eid="PHP 4"/>
</usx>
