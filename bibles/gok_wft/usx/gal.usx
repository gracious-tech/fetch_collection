<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GAL" style="id">- Gawli Marathi</book>
  <para style="h">ಗಲಾತ್ಯ</para>
  <para style="toc3">ಗಲಾಥ್ಯ</para>
  <para style="toc2">ಗಲಾತ್ಯಾತ್‌ಲ್ಯಾನಾ</para>
  <para style="toc1">ಪೌಲಾನಿ ಗಲಾತ್ಯಾತಲ್ಯಾನಾ ಲಿವ್‌ಲ್ಯಾಲ ಪತ್ರ</para>
  <para style="mt2">ಪೌಲನು ಗಲಾತ್ಯದವರಿಗೆ ಬರೆದ ಪತ್ರಿಕೆ</para>
  <para style="mt1">ಪೌಲಾನಿ ಗಲಾತ್ಯಾತ್‌ಲ್ಯಾನಾ ಲಿವ್‌ಲ್ಯಾಲ ಪತ್ರ</para>
  <para style="imt">ವಳಕ್</para>
  <para style="ip">ಗಲಾತ್ಯಾತ್‌ಲ್ಯಾನಾ ಲಿವ್‌ಲ್ಯಾ ಪತ್ರ ಅಪೊಸ್ತಲ್ ಪೌಲಾನಿ ಲಿವ್‌ಲ್ಯಾ<char style="xt"><ref loc="GAL 1:1">1:1</ref> </char>ಹ್ಯ ಪತ್ರ ಪೌಲಾನಿ ಗಲಾತ್ಯಾತ್ಲೆ ಸಭೆನಾ ಕ್ರಿಸ್ತ್ ಜ಼ಲಾಮ್‌ಲ್ಯಾವ 48-57 ವರ್ಸಾಂಚೆ ಮದ್ದಿ ಲಿವ್‌ಲ್ಯಾ. ಗಲಾತ್ಯಾತ್ಲಿ ರೊಮ್ ಸಾಮರಾಜಾಚಾ ಗಲಾತ್ಯ ಮಂಥ್ಯಾಲ್ಯಾ ಪ್ರಾಂತ್ಯಾತ್ ಜೀವ್ನಾ ಕರಿತಿತ. ಹ್ಯ ಪತ್ರ ಲಿವ್ತಾನಾ ಪೌಲ್ ಕುಠ ಹುತ್ತಾ ಮನ್ಹುನ್ ವಿದ್ವಾಂಸಾನಾ ಖಾತ್ರಿ ಜಾ಼ಲ್ಹ ನಾಹಿ. ಫನ್ ಎಫೆಸಾ ಆನಿ ಕೊರಿಂಥ ಹ್ಯಾ ದುನಿ ಪೆಠತ್ನಿ ತ್ಯೊ ರಾಯ್ಲಾ ಆಸಲ್.</para>
  <para style="ip">ಪೌಲಾನಿ ಹ್ಯ ಪತ್ರ ಗಲಾತ್ಯಾತಲ್ಯಾ ಸಬೆನಾ ಯೆಹುದಿ ಆನಿ ಯೆಹುದಿ ನಸ್‌ಲ್ಯಾಲ್ಯಾ ಇಸ್ವಾಸಿಂಚಾ ಉದೆಸಾನಿ ಲಿವ್‌ಲ್ಯಾ. ತ್ಯೊ ಖುಬ್ ಕರುನ್ ಇಸ್ವಾಸಿ ಜು಼ನ್ಯಾ ಕರಾರಾತ್ ಯೆಹುದ್ಯಾಂಚಾ ನೆಮಾ ಶಾರ್ಕ ಚಾ಼ಲಾಯಾ ವ್ಹಯಿ ಲ ಕರುನ್ ಮುಂಜಿ ಕರುನ್ ಗಿಹ್ಯಾ ವ್ಹಯಿ ಮಂಥ್ಯಾಲ್ಯಾ ಲಬಾಡ್ ಸಾಂಗ್‌ನ್ಯಾಚೆ ಆಡ್ವ ಲಿವ್‌ಲ್ಯಾ. ಇಸ್ವಾಸಿಂಚೆ ಮದ್ದಿ ಯೆಹುದಿ ಮಂಥ್ಯಾಲ್ಯಾ ಯೆಹುದಿ ನಸ್‌ಲ್ಯಾಲ್ಯಾ ಇಸ್ವಾಸಿನಾ ಮುಂಜಿ ಕರಾಯಾ ವ್ಹಯಿ ಮನ್ಹುನ್ ಸಾಂಗ್‌ತ್ಯಾಲಾ ಯೊಕ್ ತಂಡಾ ಹುತ್ತಾ. ತೇ ಪೌಲಾಚಾ ಅಪೊಸ್ತಲಾಚೆ ಅಧಿಕಾರ‍್ಯಾಚೆ ಗುಶ್ಟಿತ್ ಪ್ರಶ್ನೆ ಸಾಹಿತ್ ಕೆಲ್ತಾ. ಪೌಲ್ ಆಪ್ಲಿ ಕ್ಯಾಯ್ನಿ ಸಾಂಗಿತ್ ಅಪೊಸ್ತಲಾಂಚೆ ಗುಶ್ಟಿತ್ ಉತ್ತರ ದೇತೊ. <char style="xt"><ref loc="GAL 1:11-2:14">1:11—2:14</ref> </char>ಆನಿ ಯೇಸು ಕ್ರಿಸ್ತಾಪ ಆಸ್‌ಲ್ಯಾಲ್ಯಾ ಇಸ್ವಾಸಾನಿ ತ್ಯವ್ಡಿಸ್ ಸುಟ್ನುಕ್ ಗಾವ್ನಾರ್ ಮನ್ಹುನ್ ವಿವರನಾ ಸಾಂಗಿತ್ ಬರಿ ಖಬರಿಚ಼ ಉತ್ತರ್ ದೆತೊ <char style="xt"><ref loc="GAL 2:16">2:16</ref> </char>ಹ್ಯ ಮಾನ್ಸಾಪ್ನಿ ನವ್ಹತ ದೇವಾನಿ ದ್ಯಾವ್‌ಲ್ಯಾಲ್ಯಾ ಕನಿಕರಾಚ಼ ಯಾಕ್ ಪ್ರತಿ ಫಳ್ ಜಾ಼ಲ್ಯಾ.</para>
  <para style="iot">ಪಿಠಿಕೆ</para>
  <para style="io1">1. ಪೌಲ್ ಗಲಾತ್ಯಾತ್‌ ಆಸ್‌ಲ್ಯಾಲ್ಯಾ ಸಭೆನಾ ಸ್ವಾಗತ್ ಕರಿತ್ ಪತ್ರ ಸುರ್ವಾತ್ ಕರ್ತೊ <char style="ior"><ref loc="GAL 1:1-5">1:1-5</ref> </char></para>
  <para style="io1">2. ಪೌಲ್ ಆಪ್ನು ಧರ್ಮಶಾಸ್ತಾರ ಶಾರ್ಕ ಜೀವ್ನಾ ಕರಾಯಾ ಯತ್ನ ಕಿಲಿತ ಫನ್ ತ್ಯ ಉಪೇಗ್ ಜಾ಼ಲ್ಹ ನಾಹಿ ಮನ್ಹುನ್ ಸಾಂಗಾಯಾ ಆನಿ ಸಿಕ್ವಾಯಾ ಆಪ್‌ಲ್ಯಾ ಜೀವ್ನಾಚಾ ಥೊಡ್ಯಾ ಖನ್ಕತಿ ವಿವರನ್ ಕರ್ತತೊ <char style="ior"><ref loc="GAL 1:6-2:21">1:6—2:21</ref> </char></para>
  <para style="io1">3. ನಂತರ್ ತ್ಯೊ ಧರ್ಮಶಾಸ್ತಾರಾಚ಼ ಪಾತ್ರ ಆನಿ ಸುಟ್ನುಕಿಚಿ ಕ್ರುಪೆಚೆ ಗುಶ್ಟಿತ್ ವಿವರನ್ ಕರ್ತೊ. <char style="ior"><ref loc="GAL 3-4">3—4</ref></char></para>
  <para style="io1">4. ನಂತರ್ ತ್ಯೊ ಚಾ಼ಂಗ್ಲಾ ಕ್ರಿಸ್ತಾಚಾ಼ ಜಿವ್ನಾ ಕರಾಯಾ ಥೊಡ್ಯಾ ಸುಸ್ನಾ ದೇತೊ. <char style="ior"><ref loc="GAL 5:1-6:10">5:1—6:10</ref></char></para>
  <para style="io1">5. ಮುಂಜಿ ಕರುನ್ ಗೆಥ್ಯಾಲಿ ಬಾಹಿರ್ಲ್ಯಾ ನೆಮಾವ್ನಿ ಯಕಾ ನವ್ಯಾ ಮಾನ್ಸಾಪಾ ದೇವಾನಿ ಆನ್‌ಲ್ಯಾಲಿ ಬದಲಾವನೆ ಯದತ್ ಥೆವಾಯಾ ಇನಂತಿ ಕರ್ತೊ ಆನಿ ನಮಸ್ಕಾರ್ ಸಾಂಗಿತ್ ಆಪ್ಲ ಪತ್ರ ಸುಪಿವ್ತೊ.<char style="ior"><ref loc="GAL 6:11-18">6:11-18</ref> </char></para>
  <chapter number="1" style="c" sid="GAL 1" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1" />ಮಾನ್ಸಾಪ್ನಿ ವ್ಹವುನಿ ಮಾನ್ಸಾಚಾ ಅಧಿಕಾರಾನಿ ವ್ಹವುನಿ ಅಪೊಸ್ತಲ್ ವ್ಹಯಾಚೆ ಆಂದಿ ಯೇಸು ಕ್ರಿಸ್ತಾಸ್ ಲಾಗುನ್ ಆನಿ ತ್ಯಲಾ ಮೇಲ್ಯಾಲ್ಯಾತ್ನಿ ಉಠಿವಲ್ಯಾಲ್ಯಾ ಬಾ ಜಾ಼ಲ್ಯಾಲ್ಯಾ ದೇವಾಪ್ನಿಬಿ ಥರಿವ್‌ಲ್ಯಾಲಾ ಅಪೊಸ್ತಲ್ ಪೌಲ್ ಮಂಥ್ಯಾಲಾ ಮಿ <verse eid="GAL 1:1" /><verse number="2" style="v" sid="GAL 1:2" />ಆನಿ ಮಾಜೆ ಸಂಗ ಆಸ್‌ಲ್ಯಾಲಿ ಭನ್ಹಿ ಬಾಹು ಸಗ್ಳ ಗಲಾತ್ಯಾತ್ ಆಸ್‌ಲ್ಯಾಲೆ ಸೆಭೆಲಾ ಲಿವಾಚ಼ ಕ್ಯಾ ಮಂಜೆ:<verse eid="GAL 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 1:3" />ಬಾ ಜಾ಼ಲ್ಯಾಲ್ಯಾ ದೇವಾಪ್ನಿ ಆಮಚಾ಼ ಪ್ರಭು ಜಾ಼ಲ್ಯಾಲ್ಯಾ ಯೇಸು ಕ್ರಿಸ್ತಾಪ್ನಿ ತುಮಾನಾ ಕ್ರಪಾ ಶಾಂತಿ ವ್ಹವುನಿ.<verse eid="GAL 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GAL 1:4" />ತ್ಯನಿ ಆಮಾನಾ ಆತಾಚಾ ಬುರ್ಶಾ ಕಾಲಾತ್ನಿ ಸೊಡ್ವಾಯಾ ವ್ಹಯಿ ಮನ್ಹುನ್ ಬಾ ಜಾ಼ಲ್ಯಾಲ್ಯಾ ದೇವಾಚಾ ಮನಾಚೆಗತ್, ಆಮ್ಚಾ ಪಾಪಾಸ್ ಲಾಗುನ್ ಆಪ್‌ಲ್ಯಾಲಾ ಮರ್ನಾಚಾ ತಾಬ್ಯಾತ್ ದಿಲಾ. <verse eid="GAL 1:4" /><verse number="5" style="v" sid="GAL 1:5" />ದೇವಾಲಾ ಖಾಯಿಮ್ ಮೈಮೆ ವ್ಹವುನಿ. ತಸಸ್ ವ್ಹವುನಿ.<verse eid="GAL 1:5" /></para>
  <para style="s">ಎಕುಸ್ ಬರಿ ಖಬರ್</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6" />ಕ್ರಿಸ್ತಾಚೆ ಕ್ರಪೆನಿ ತುಮಾನಾ ಹಾಕಟ್‌ಲ್ಯಾಲ್ಯಾಲಾ ಸುಡುನ್, ಯವ್ಡೆ ಬಿಗಿ ದುಸ್ರೆ ಖಬರಿಕ್ಡ ತುಮಿ ಪರಾತ್‌ಲ್ಯಾಸಾ ಮನ್ಹುನ್ ಮನಾ ಆಜಾಬ್ ವಾಟ್ಯಾ. <verse eid="GAL 1:6" /><verse number="7" style="v" sid="GAL 1:7" />ಖರ‍್ಯಾನಿಸ್ ದುಸ್ರಿ ಖಬರ್ ನಾಹಿ, ಫನ್ ಥುಡಿ ಜ಼ನ ತುಮ್ಚಿಪ ಬೇದ್ಬಾವ್ ಗಾಲ್ಹುನ್ ಕ್ರಿಸ್ತಾಚಿ ಖಬರ್ ಬದ್ಲಾಯಾ ಯತ್ನ ಕರ್ತ್ಯಾತ. <verse eid="GAL 1:7" /><verse number="8" style="v" sid="GAL 1:8" />ಫನ್ ಆಮಿ ತುಮಾನಾ ಸಾಂಗ್‌ಲ್ಯಾಲೆ ಖಬರಿಲಾ ಆಡ್ವಾ ಜಾ಼ಲ್ಯಾಲ, ಆಮಿಸ್ ವ್ಹವುನಿ ನಾಹಿತ ಸ್ವರ್ಗಾತ್ನಿ ಆಲ್ಯಾಲಾ ದೇವ್ ದುತ್ ವ್ಹವುನಿ, ತುಮಾನಾ ಸಾಂಗ್ಲತ ತ್ಯಲಾ ಸರಾಪ್ ಲಾಗುನಿ <verse eid="GAL 1:8" /><verse number="9" style="v" sid="GAL 1:9" />ಆಮಿ ಆಂದಿ ಸಾಂಗ್‌ಲ್ಯಾಚೆಗತುಸ್ ಆತಾಬಿ ಮೀ ಪರ್ತುನ್ ಸಾಂಗ್ತೊ. ತುಮಿ ಗೆತಲ್ಯಾಲೆ ಖಬ್ರಿಲಾ ಆಡ್ವ ಆಸ್‌ಲ್ಯಾಲ ಕೊನ್ತರಿ ತುಮಾನಾ ಸಾಂಗ್ಲತ ತ್ಯಲಾ ಸರಾಪ್ ಲಾಗುನಿ.<verse eid="GAL 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 1:10" />ಆತಾ ಮೀ ಕುನಾಲಾ ಮಿಳ್ವುನ್ ಗೆತೊ? ಮಾನ್ಸಾನಾ ಕ್ಯಾ ದೇವಾಲಾ? ಮೀ ಮಾನ್ಸಾನಾ ಆವ್ಡಾಯಾಸಾಟಿ ಯತ್ನ ಕರ್ತ್ಯೊ ಕ್ಯಾ? ಆಜು಼ನ್ ಮಾನ್ಸಾನಾ ಆಡ್ವಾಯಾ ಕೆಲ ಆಸ್ಥತ ಮಿ ಕ್ರಿಸ್ತಾಚಾ಼ ಸೇವಕ್ ವ್ಹವುನ್ ರಾಹಿತ್ ನವ್ಥೊ.<verse eid="GAL 1:10" /></para>
  <para style="s">ಅಪೊಸ್ತಲ್ ವ್ಹಯಾಲಾ ಹಾಕಟ್‌ಲ್ಯಾಲ</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11" />ಬನ್ಹಿ ಬಾವ್ಹಾನು, ಮೀ ಸಾಂಗ್‌ಲ್ಯಾಲಿ ಖಬರ್ ತರಿ ನಿಸ್ಥಿ ಮಾನ್ಸಾಪ್ನಿ ಆಲ್ಯಾಲಿ ನವ್ಹ ಮನ್ಹುನ್ ತುಮಿ ಸಮಜು಼ನ್ ಗಿಹ್ಯಾ ವ್ಹಯಿಸಾ ಮನ್ಹುನ್ ಮಂತೊ. <verse eid="GAL 1:11" /><verse number="12" style="v" sid="GAL 1:12" />ಮೀ ತ್ಯ ಮಾನ್ಸಾಪ್ನಿ ಗೆತ್ಲ ನಾಹಿ, ಮನಾ ಕುನಿ ಸಾಂಗ್ಲ ನಾಹಿ, ಫನ್ ಯೇಸು ಕ್ರಿಸ್ತಾಪ್ನಿಸ್ ತ್ಯ ಮನಾ ಸಮಾಜ಼್ಲ<verse eid="GAL 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 1:13" />ಆಂದಿ ಮಿ ಯೆಹುದಿಂಚೆ ಸಿಕ್ಷೆತ್ ಆಸ್ಥಾನಾ ಮಾಜ಼ ಚಾ಼ಲ್ನ ಕಸ್ಲ ಮನ್ಹುನ್ ತುಮಿ ಐಕ್ಲಸಾ. ಆಮಿ ದೇವಾಚಿ ಸಭಾ ಖುಬ್ ತರಾಸ್ ದಿವುನ್ ಹಾಳ್ ಕರೀತೊ. <verse eid="GAL 1:13" /><verse number="14" style="v" sid="GAL 1:14" />ಯವ್ಡಸ್ ನವ್ಹ ಮಾಜಾ ವಡ್ಲಾಂಚಿಪ್ನಿ ಆಲ್ಯಾಲಿ ಪದ್ದತಿಚೆ ಗುಶ್ಟಿತ್, ಮಾಜೆ ವಯೆಚಾ ಮಾನ್ಸಾತ್ನಿ ಯೆಹುದ ದರ್ಮಾತ್ ಖುಬ್ ಹುರುಪ್ ಆಸ್‌ಲ್ಯಾಲಾ ಜಾ಼ಲ್ತೊ.<verse eid="GAL 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 1:15" />ಫನ್ ಮಿ ಮಾಜೆ ಆಯಿಚಾ ಪೊಟಾತ್ ಆಸ್ಧಾನಾ ನಿವ್ಡುನ್ ಆಪ್ಲೆ ಕ್ರಪೆನಿ ಸೆವೆತ್ ಹಾಕಟ್‌ಲ್ಯಾಲ್ಯಾ ದೇವಾನಿ, <note caller="-" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="ISA 49:1">ಯೆಶಾಯ್ 49:1</ref>,<ref loc="ISA 49:5">5</ref> </char></note><note caller="-" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="JER 1:5">ಯೆರೆಮೀಯ 1:5</ref> </char></note> <verse eid="GAL 1:15" /><verse number="16" style="v" sid="GAL 1:16" />ಆಪ್‌ಲ್ಯಾ ಲೇಕಾಚಿ ಖಬರ್ ಇಸ್ವಾಸ್ ನಸ್‌ಲ್ಯಾಲ್ಯಾನಾ ಸಾಂಗಾಯಾ ವ್ಹಯಿ ಮನ್ಹುನ್ ದೇವಾಚ಼ ಚಿತ್ ಜಾ಼ಲ್ಥ.ಮಿ ತವಾಸ್ ಮಾನ್ಸಾಂಚಿ ಯವಜ಼್ನಾ ಐಕಾಚೆ ಆಂದಿ. <verse eid="GAL 1:16" /><verse number="17" style="v" sid="GAL 1:17" />ಯೇರುಸಲೇಮಿತ್ ಮಾಜೆ ಆಂದಿ ಅಪೊಸ್ತಲ್ ಜಾ಼ಲ್ಯಾಲ್ಯಾಂಚಿಪಬಿ ಜಾ಼ಯಾಚೆ ಆಂದಿ ಅರಬ ದೆಶಾತ್ ಜಾ಼ವುನ್ ಪರ್ತುನ್ ದಮಸ್ಕ ಪೆಠತ್ ಆಲೊ.<verse eid="GAL 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 1:18" />ತೀನ್ ವರ್ಸ ಜಾ಼ಲ್ಯಾವ ಪೇತ್ರ ವಳಕ್ ಕರುನ್ ಗಿಹ್ಯಾ ವ್ಹಯಿ ಮನ್ಹುನ್ ಯೇರುಸಲೇಮಿತ್ ಜಾ಼ವುನ್ ತ್ಯಚಿಪ ಪಂದ್ರಾ ದೀಸ್ ಹುತ್ತೊ. <verse eid="GAL 1:18" /><verse number="19" style="v" sid="GAL 1:19" />ಫನ್ ಪ್ರಭುಚಾ಼ ಬಾಹು ಜಾ಼ಲ್ಯಾಲಾ ಯಾಕೊಬಾಲಾ ಸುಡುನ್ ಅಪೊಸ್ತಲಾತ್ ದುಸ್‌ರ‍್ಯಾಲಾ ಕುನಾಲಾಸ್ ಮೀ ಬಗ್ಲಾ ನಾಹಿ.<verse eid="GAL 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GAL 1:20" />ಮೀ ತುಮಾನಾ ಲಿವ್‌ತ್ಯಾಲ್ಯಾ ಗುಶ್ಟಿ ಲಬಾಡ್ ನವ್ಹತ ಮನ್ಹಾಯಾ ಹಬಕ್, ದೇವುಸ್ ವಳಕ್.<verse eid="GAL 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 1:21" />ನಂತರ್ ಸಿರಿಯಾ ಆನಿ ಕಿಲಿಕ್ಯ ಸಿಮತ್ ಗೆಲೊ. <verse eid="GAL 1:21" /><verse number="22" style="v" sid="GAL 1:22" />ಫನ್ ಕ್ರಿಸ್ತಾಪ ಆಸ್‌ಲ್ಯಾಲೆ ಯುದಾಯಾಚೆ ಸಬೆಲಾ ಆಜು಼ನ್ ಮಾಜಿ ವಳಕ್ ನವ್ಥಿ. <verse eid="GAL 1:22" /><verse number="23" style="v" sid="GAL 1:23" />ಪೈಲ್ಯಾ ಕಾಲಾತ್ ಆಮ್ಚಿ ನಿಂದಾ ಕೆಲ್ಯಾಲಾ. ಆಪ್ನು ಹಾಳ್ ಕರ್ತ್ಯಾಲಾ ಇಸ್ವಾಸ್ ಆತಾ ಸಾಂಗ್‌ತ್ಯೊ ಮನ್ಯಾಚಿ ಖಬರ್ ತ್ಯಂಚಾನಿ ಐಕ್ಲಿ, <verse eid="GAL 1:23" /><verse number="24" style="v" sid="GAL 1:24" />ಮಾಜೆ ಸಂಗ ದೇವಾಲಾ ವವ್ಯಾಳಾ.<verse eid="GAL 1:24" /></para>
  <chapter eid="GAL 1" />
  <chapter number="2" style="c" sid="GAL 2" />
  <para style="s">ಪೌಲ್ ಆನಿ ಉರಲ್ಯಾಲ ಅಪೊಸ್ತಲ್</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1" />ಚೌ಼ದಾ ವರ್ಸಾಚೆ ನಂತರ್ ಮಿ ಬಾರ್ನಬಾಚೆ ಸಂಗ ತೀತಾಲಾ ಸಾಹಿತ್ ಗಿಹುನ್ ಆನಿ ಯಂಗ್ದಾ ಯೆರುಸಲೆಮತ್ ಗೆಲೊ. <verse eid="GAL 2:1" /><verse number="2" style="v" sid="GAL 2:2" />ದೇವಾಚಾ ಹುಕ್ಮಾನಿ ಜಾ಼ವುನ್ ಯೆಹುದಿ ನಸ್‌ಲ್ಯಾಲ್ಯಾ ಲೊಕಾನಾ ಮಿ ಸಾಂಗ್‌ತ್ಯಾಲಿ ಬರಿ ಖಬರ್ ಕ್ಯಾ ಮನ್ಯಾಚಿ ಜಾಂತ್ಯಾನಾ ಯಕಾನ್ಸಿ ಸಾಂಗ್ಲ ಕಾಮಂಜೆ ಮೀ ಬರೆ ಖಬರಿಸಾಟಿ ಖಾಲ್ಯಾಲಿ ಖಟ್ಪಟ್ ಆತಾ ಖಾತ್ಯಾಲಿ ಖಟ್ಪಟ್ ಉಗಸ್ ವ್ಹವು ನಾಹಿ ಮನ್ಹುನ್ ಸಾಂಗ್ಲ. <verse eid="GAL 2:2" /><verse number="3" style="v" sid="GAL 2:3" />ಮಾಜೆ ಸಂಗಚಾ಼ ತೀತ್ ಗ್ರೀಕ್ ಜಾ಼ಲ್ಹಾ ತರಿ ತ್ಯಚಿ ಮುಂಜಿ ವ್ಹಯಾವ್ಹಯಿ ಮನ್ಹುನ್ ಕುನಿ ಬಳ್ ಜು಼ರಿ ಕೆಲಿ ನಾಹಿ. <verse eid="GAL 2:3" /><verse number="4" style="v" sid="GAL 2:4" />ಫನ್ ಚು಼ರುನ್ ಆತ್ ಆಲ್ಯಾಲ ಲಬ್ಡ ಬಾಹು ಆಮಾನಾ ಗುಲಾಮಾತ್ ಗಾಲ್ವಾಯಾ ವ್ಹಯಿ ಮನ್ಹುನ್ ಕ್ರಿಸ್ತ ಯೇಸುಪ ಆಸ್‌ಲ್ಯಾಲಾ ಸ್ವತಂತ್ರ ಕುನಾಲಾ ಸಮಜಾ಼ಚೆ ಆಂದಿ. ಇಚಾರಾಯಾ ಆಲ್ತ <verse eid="GAL 2:4" /><verse number="5" style="v" sid="GAL 2:5" />ಬರೆ ಖಬರಿಚ಼ ಖರ ತುಮ್ಚಿಪ ಶಾರ್ಕ ರಾಹ್ಯಾ ವ್ಹಯಿ ಮನ್ಹುನ್ ಆಮಿ ತ್ಯಂಚಾ ತಾಬ್ಯಾತ್ ಜ಼ರಾಬಿ ಗಾವ್ಲಾವ್ ನಾಹಿ.<verse eid="GAL 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 2:6" />ಫನ್ ಕೊನ್ ಫುಡಾರಿ ಮನ್ಹುನ್ ಗಿಹ್ಯಾ ವ್ಹಯಿ ಮಂಥ್ಯಾತ, ಮಿ ಸಾಂಗ್ತೊ ಹ್ಯ ಮಾಜಿಪ ಆನಿ ತ್ಯಂಚಿಪ ಕಾಯ್ ವ್ಯತ್ಯಾಸ್ ಆನಿತ್ ನಾಹಿ; ದೇವ್ ಸಗ್‌ಳ್ಯಾನಾ ಯೇಕುಸ್ ತರನಿ ಬಗ್ತೊ. ಮನ್ಹುನ್ ತ್ಯಾ ಫುಡಾರ‍್ಯಾಂಚಾಪ್ನಿ ಮನಾ ಕಾಯ್ ಗಾವ್ಲ ನಾಹಿ. <note caller="-" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="DEU 10:17">ಧರ್ಮೋಪದೇಶ 10:17</ref></char></note> <verse eid="GAL 2:6" /><verse number="7" style="v" sid="GAL 2:7" />ಫನ್ ಮುಂಜಿ ಜಾ಼ಲ್ಯಾಲ್ಯಾನಾ ಬರಿ ಖಬರ್ ಸಾಂಗಾಚ಼ಸ್ ಕಾಮ್ ಕಸ ಪೇತ್ರಾಲಾ ದಿಲ್ಯಾ ತಸಸ್ ಯೆಹುದಿ ನಸ್‌ಲ್ಯಾಲ್ಯಾ ಲೊಕಾನಾ ತ್ಯ ಸಾಂಗಾಚ಼ ಕಾಮ್ ಮನಾ ದಿಲ್ತ. <verse eid="GAL 2:7" /><verse number="8" style="v" sid="GAL 2:8" />ಕಾ ಮಂಜೆ ಮುಂಜಿ ಜಾ಼ಲ್ಯಾಲ್ಯಾತ್ ಅಪೊಸ್ತಲ್ ಚಾ಼ಲ್ವಾಯಾ ಸಾಟಿ ಪೇತ್ರಾಚಾ ತಾಬ್ಯಾತ್ ದಿಲ್ಯಾಲ್ಯಾ ದೇವಾನಿ, ಮುಂಜಿ ನಸ್‌ಲ್ಯಾಲ್ಯಾನಾ ತ್ಯ ಚಾ಼ಲ್ವಾಯಾ ಸಾಟಿ ಮನಾ ದಿಲ. <verse eid="GAL 2:8" /><verse number="9" style="v" sid="GAL 2:9" />ಸಭೆಚ಼ ಫುಡಾರಿ ಮನ್ಹುನ್ ಹಾಕ್ಟುನ್ ಗೆತಲ್ಯಾಲ ಯಾಕೊಬ್ ಪೇತ್ರಾ ಯೊಹಾನ್ ದೇವಾನಿ ದಿಲ್ಯಾಲ ಮನಾ ವರ ಸಮಜು಼ನ್ ಗಿಹುನ್ ಯಕಿ ದಾವಾಯಾ ಸಾಟಿ ಮನಾ ಬಾರ್ನಬಲಾ ಮಜ಼ತ್ ಕರುನ್ ಹಾತ್ ದಿವುನ್ ತುಮಿ ಯೆಹುದಿ ನಸ್‌ಲ್ಯಾಲ್ಯಾ ಲೊಕಾಪ್ನಿ ಜಾ಼ವಾ ಆಮಿ ಮುಂಜಿ ಕೆಲ್ಯಾಲ್ಯಾ ಲೊಕಾಪ್ನಿ ಜಾ಼ತಾವ್ ಮನ್ಲ. <verse eid="GAL 2:9" /><verse number="10" style="v" sid="GAL 2:10" />ಫನ್ ತುಮಿ ಗರೀಬ್ ಲೊಕಾನಾ ಇಸ್ರು ನಾಹಿಸಾ ಮನ್ಹುನ್ ಯೆಕುಸ್‌ ಗ್ಯೊಸ್ಟ್ ಮಾಗತ್ಯಾತ, ತಸ ಕರ್ತ್ಯಾಲ್ಯಾತ್ ಮಿ ಮನ್ ಆಸ್ನಾರಾ ಜಾ಼ಲ್ಯೊ.<verse eid="GAL 2:10" /></para>
  <para style="s">ಪೌಲಾನಿ ಅಂತಿ ಯೊಕ್ಯಾತ್ ಪೇತ್ರಾಚಿ ಚು಼ಕ್ ದಾವುನ್ ದಿಲ್ಯಾಲಿ</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11" />ಪೇತ್ರಾ ಅಂತಿಯೊಕ್ಯಾತ್ ಅಲ್ಲಾ ತವಾ ತ್ಯಂಚಿಪ ಚು಼ಕ್ ದಿಸ್ಲಿ ಮನ್ಹುನ್ ಮೀ ತ್ಯಲಾ ತೊಂಡಾ ಸಮುರ್ ಖಡ್ಯಾವ್ಲಾ. <verse eid="GAL 2:11" /><verse number="12" style="v" sid="GAL 2:12" />ಕಾ ಮಂಜೆ ಯಾಕೊಬಾಪ್ನಿ ಥುಡಿ ಜ಼ನ ಯಯಾಚೆ ಆಂದಿ ಪೇತ್ರಾ ಯೆಹುದಿ ನಸ್‌ಲ್ಯಾಲ್ಯಾಂಚೆ ಸಂಗ ಜೆವತಾ. ತೇ ಅಲ್ಯಾ ನಂತರ್ ಮುಂಜಿ಼ ಜಾ಼ಲ್ಯಾಲ್ಯಾನಾ ತ್ಯೊ ಭೀವುನ್, ಯೆಹುದಿ ನಸ್‌ಲ್ಯಾಲ್ಯಾ ಲೊಕಾನಾ ಸುಡುನ್ ಆಪ್ನು ಯಗಾಳ್ಯಾಲಾ ದಿಸ್ತೊ. <note caller="-" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="ACT 11:28">ಅಪೊಸ್ತಲ್ 11:28</ref>; <ref loc="ACT 12:1-3">12:1-3</ref></char></note> <verse eid="GAL 2:12" /><verse number="13" style="v" sid="GAL 2:13" />ಯವ್ಡಸ್‍ನವ್ಹ ರಾಯ್‌ಲ್ಯಾಲಿ ಯಹುದ್ಯಿ ತ್ಯಂಚಿ ಸಂಗ ಮಿಳುನ್ ಕಸ ಕಪಟ್ ಕರ್‌ತ್ಯಾತ. ತಸಸ್ ಬಾರ್ನಬಾ ಸಾಯಿತ್ ತ್ಯಂಚಾ ಕಪಟಾತ್ ಪಡ್ತೊ. <verse eid="GAL 2:13" /><verse number="14" style="v" sid="GAL 2:14" />ತೇ ಬರೆ ಖಬ್ರಿಚಾ ಖರ‍್ಯಾ ಶಾರ್ಕ ಚಾ಼ಲತ್ ನಾಹಿತ ಮನ್ಹುನ್ ಮೀ ಬಗ್ಲ ತವಾ ಸಗ್‌ಳ್ಯಾಂಚೆ ಮೊರ್ಹ ಪೇತ್ರಾಲಾ ಸಾಂಗ್‍ಲ್ಯಾಲ ಕ್ಯಾ ಮಂಜೆ, ತು ಯಹುದ್ಯಿ ವ್ಹವುನ್ ಯಹುದ್ಯಾಂಚೆಗತ್ ಚಾ಼ಲಾಚೆ ಆಂದಿ ಯೆಹುದಿ ನಸ್‌ಲ್ಯಾಚೆಗತ್ ಜೀವ್ನಾ ಕರುನ್, ದುಸರ‍್ಯಾ ಲೊಕಾನಾ, ತುಮಿ ಯಹುದ್ಯಿ ಲೊಕಾಂಚೆಗತ್ ಚಾ಼ಲಾಯಾ ವ್ಹಯಿಸಾ ಮನ್ಹುನ್ ಕಶಾಲಾ ಬಳ್ ಜು಼ರಿ ಕರ್ತೊಸ್?<verse eid="GAL 2:14" /></para>
  <para style="s">ಯಹುದ್ಯಾನಾ ಆನಿ ಯೆಹುದಿ ನಸ್‌ಲ್ಯಾಲ್ಯಾನಾ ಇಸ್ವಾಸಾನಿ ರಕ್ಷನ್</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 2:15" />ಆಮಿ ತರಿ ಜ಼ಲ್ಮಾತ್ ಯಹುದ್ಯಿ ಪಾಪಿ ಮನ್ಹುನ್ ಗೆತಲ್ಯಾಲ್ಯಾ ಯೆಹುದಿ ನಸ್‌ಲ್ಯಾಲ್ಯಾನಾ ನವ್ಹ. <verse eid="GAL 2:15" /><verse number="16" style="v" sid="GAL 2:16" />ಕುನಿ ತರಿ ಯೇಸು ಕ್ರಿಸ್ತಾವ ಇಸ್ವಾಸ್ ತೆವ್‌ಲ್ಯಾಲ್ಯಾಸ್ ಲಾಗುನ್ ಧರ್ಮಶಾಸ್ತಾರಾಚ಼ ನೆಮ್ ಪ್ಯಾಳ್ಯಾತ ಮನ್ಹುನ್ ನೀಯತಿಚಾ಼ ಮನ್ಹುನ್ ಥರತ್ನಾಹಿ ಮನ್ಹುನ್ ಆಮಾನಾ ಸಮಾಜ಼ಲ್ಯಾ ಮನ್ಹುನ್ ಆಮಿ ಸಾಯಿತ್ ಧರ್ಮಶಾಸ್ತಾರಾಚ಼ ನೆಮ್ ಸುಡುನ್ ಕ್ರಿಸ್ತ ಯೇಸುವ ಇಸ್ವಾಸ್ ಥೆವ್ತಾವ್. ಕಾ ಮಂಜೆ ಕೊನ್ ಧರ್ಮಶಾಸ್ತಾರಾಚಾ ನೆಮಾ ಶಾರ್ಕ ಚಾ಼ಲತ್ಯಾಲಾ ನೀಯತಿಚಾ಼ ಮನ್ಹುನ್ ಥರತ್ ನಾಹಿತ. <verse eid="GAL 2:16" /><verse number="17" style="v" sid="GAL 2:17" />ಫನ್ ಆಮಿ ಕ್ರಿಸ್ತಾಸ್ ಲಾಗುನ್ ನೀಯತಿಚ಼ ಮನ್ಹುನ್ ನಿರ್ಧಾರ್ ಗಿಹ್ಯಾ ಯತ್ನ ಕರ್ತಾನಾ, ಆಮಿ ಪಾಪಿ ಮನ್ಹುನ್ ದಿಸುನ್ ಆಲ್ಯಾವ ಕ್ರಿಸ್ತ ಪಾಪಾಲಾ ಮಜ಼ತ್ ಕರ್ನಾರಾ ಕ್ಯಾ? ಕಂದಿಸ್ನಾಹಿ. <verse eid="GAL 2:17" /><verse number="18" style="v" sid="GAL 2:18" />ಮೀ ಪ್ಯಾಡ್‌ಲ್ಯಾಲ ಪರ್ತುನ್ ಬ್ಯಾಂದ್‌ಲ್ಯಾವ ಮನಾಸ್ ಮೀಸ್ ಗುನ್ಹದಾರ್ ಮನ್ಹುನ್ ದಿಸ್ತೊನವ್ಹ. <verse eid="GAL 2:18" /><verse number="19" style="v" sid="GAL 2:19" />ಮೀ ತರಿ ದೇವಾ ಸಾಟಿ ಜೀವ್ನಾ ಕರಾಯಾ ಸಾಟಿ ಧರ್ಮಶಾಸ್ತಾರಾಸ್ ಲಾಗುನ್ ಧರ್ಮಶಾಸ್ತಾರಾ ಸಾಟಿ ಮೆಲ್ಯೊ. ಮೀ ಸಾಯಿತ್ ಕ್ರಿಸ್ತಾ ಸಂಗ ಶಿಲ್ಬೆವ ಹಾ, <verse eid="GAL 2:19" /><verse number="20" style="v" sid="GAL 2:20" />ಮನ್ಹುನ್ ಹೀತ್ನಿ ಮೊರ್ಹ ಜೀವ್ನಾ ಕರ್ನಾರಾ ಮಿನವ್ಹ, ಫನ್ ಕ್ರಿಸ್ತ ಮಾಜಿಪ ಜೀವ್ನಾ ಕರ್ನಾರ್. ಆತಾ ಶರೀರಾನಿ ಆಸ್‌ಲ್ಯಾಲಾ ಮೀ ಜೀವ್ನಾ ಕರಾಚೊ಼ ಕಸಾ ಮಂಜೆ ದೇವಾಚಾ ಲೇಕಾವಲ್ಯಾ ಇಸ್ವಾಸಾನಿಸ್. ತ್ಯನಿ ಮಾಜಿ ಮಾಯಾ ಕರುನ್ ಮಾಜಿ ಸಾಟಿ ಆಪ್‌ಲ್ಯಾಲಾಸ್ ದಿಲಾ. <verse eid="GAL 2:20" /><verse number="21" style="v" sid="GAL 2:21" />ಮೀ ದೇವಾಚೆ ಕ್ರಪೆಚಿ ನಕ್ವಾಟ್ ಕರಿತ್ನಾಹಿ. ಧರ್ಮಶಾಸ್ತಾರಾಸ್ ಲಾಗುನ್ ನೀಯತಿಚ಼ ವ್ಹಯಾಚ಼ ಜಾ಼ಲ್ಯಾವ ಕ್ರಿಸ್ತ ಮೆಲ್ಯಾಲಾ ಪುಕಟ್.<verse eid="GAL 2:21" /></para>
  <chapter eid="GAL 2" />
  <chapter number="3" style="c" sid="GAL 3" />
  <para style="s">ಧರ್ಮಶಾಸ್ತಾರ್ ಕ್ಯಾ ಇಸ್ವಾಸ್</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1" />ಆರ ಬುದ್ದಿ ನಸ್‌ಲ್ಯಾಲ್ಯಾ ಗಲಾತಿ ಕರಾನು! ತುಮಾನಾ ಕುನಿ ಪುಲಿವ್ಲಿತ? ಯೇಸು ಕ್ರಿಸ್ತಾನಿ ಶಿಲ್ಬೆವ ಗಾಲ್ಹುನ್ ಗಿಹುನ್ ತುಮ್ಚಾ ಡೊಳ್ಯಾಂಚೆ ಮೊರ್ಹ ವರ್ನನ್ ಕೆಲಾ ನವ್ಹ? <verse eid="GAL 3:1" /><verse number="2" style="v" sid="GAL 3:2" />ಎಕುಸ್ ಗ್ಯೊಸ್ಟ ತುಮ್ಚಿಪ್ನಿ ಸಮಜು಼ನ್ ಗಿಹ್ಯಾವ್ಹಯಿ. ತುಮಿ ದೇವಾಚ಼ ಆತ್ಮ ಗೆತಲ್ಯಾಲ ಧರ್ಮಶಾಸ್ತಾರಾಚ಼ ನೆಮ್ ಪ್ಯಾಳ್‍ತ್ಯಾಲ್ಯಾನಿ ಕ್ಯಾ ತುಮಿ ಐಕ್‌ಲ್ಯಾಲ್ಯಾ ಬರಿ ಖಬರಿಚಾ ಇಸ್ವಾಸಾನಿ? <verse eid="GAL 3:2" /><verse number="3" style="v" sid="GAL 3:3" />ತುಮಿ ಇತ್ಕಿ ಖುಳಿ ಕ್ಯಾ? ದೇವಾಚಾ ಆತ್ಮಾನಿ ಸುರ್ವಾತ್ ಕರುನ್ ಆತಾ ತುಮ್ಚಾ ಬಳಾನಿ ಸರ್ತ ಕರ್ನಾರ್ ಕ್ಯಾ?<verse eid="GAL 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GAL 3:4" />ತುಮಿ ಹಿ ಸಗ್ಳಿ ದುಖ ಸುಸಿವ್‌ಲ್ಯಾಲಿ ಉಗಸ್ ಕ್ಯಾ? ಉಗಸುಸ್ ಮನ್ಹಾಯಾ ವ್ಹಯಿ ಕ್ಯಾ? <verse eid="GAL 3:4" /><verse number="5" style="v" sid="GAL 3:5" />ದೇವಾನಿ ಆಪ್ಲ ಆತ್ಮ ತುಮಾನಾ ಖುಬ್ ದಿವುನ್ ತುಮ್‌ಚಿ಼ಪ ಮೊಟಿ ಮೊಟಿ ಕಾಮ ಕರಿತ್ ಆಲ್ಯಾಲಾ, ತುಮಿ ಧರ್ಮಶಾಸ್ತಾರಾ ಸಾರ ಚಾ಼ಲಾಸಾ ಮನ್ಹುನ್ ಕ್ಯಾ ಬರಿ ಖಬರ್ ಐಕುನ್ ಇಸ್ವಾಸ್ ತೆವ್ಲಾಸಾ ಮನ್ಹುನ್?<verse eid="GAL 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 3:6" />ಅಬ್ರಹಾಮಾನಿ ದೇವಾವ ಇಸ್ವಾಸ್ ಥೆವ್ಲಾ, ತ್ಯೊ ಇಸ್ವಾಸ್ ತ್ಯಲಾ ನೀಯತಿಚಾ಼ ಮನ್ಹುನ್ ಥರ್ತೊ<note caller="-" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="GEN 15:6">ಉತ್ಪತಿ 15:6</ref></char></note> ಮನ್ಹುನ್ ಪವಿತ್ರ ಗ್ರಂಥಾತ್ ಲೀವ್‌ಲ್ಯಾನವ್ಹ. <verse eid="GAL 3:6" /><verse number="7" style="v" sid="GAL 3:7" />ಮನ್ಹುನ್ ಇಸ್ವಾಸ್ ಕರ್ನಾರಿ ಅಬ್ರಹಾಮಾಚಿ ಪೊರ ಮನ್ಹುನ್ ಸಮಜು಼ನ್ ಗೆವಾ.<verse eid="GAL 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 3:8" />ದೇವಾನಿ ದುಸ್‌ರ‍್ಯಾ ಲೊಕಾನಾ ಇಸ್ವಾಸಾಸ್ ಲಾಗುನ್ ನೀಯತಿಚಿ ಮನ್ಹುನ್ ತಿರ್ಮಾನ್ ಕೆಲ್ಯಾ ತಸಸ್ ಪವಿತ್ರ ಗ್ರಂಥಾತ್‌ ಅಬ್ರಹಾಮಾಲಾ, <note caller="-" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="GEN 12:3-18:18">ಉತ್ಪತಿ 12:3—18:18</ref></char></note> ತುಜಿಸ್ ಲಾಗುನ್ ಸಗ್‌ಳ್ಯಾ ಲೊಕಾನಾ ಆಶೀರ್ವಾದ್ ಗಾವ್ನಾರ್ ಮನ್ಯಾಚಿ ಬರಿ ಖಬರ್ ಆಂದಿಸ್ ಸಾಂಗ್ಲೆ. <verse eid="GAL 3:8" /><verse number="9" style="v" sid="GAL 3:9" />ಆಸ ಆಸ್ತಾನಾ ಕೊನ್ ಇಸ್ವಾಸ್ ಥೆವ್ತೊ, ತ್ಯೊ ಇಸ್ವಾಸ್ ಥೆವ್‌ಲ್ಯಾಲ್ಯಾ ಅಬ್ರಹಾಮಾ ಸಂಗ ಆಶಿರ್ವಾದ್ ಗೆನಾರ್.<verse eid="GAL 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 3:10" />ಮೊಶೆಚಾ ಧರ್ಮಶಾಸ್ತಾರಾಚ಼ ನೆಮ್ ಆಧಾರ್ ಕೆಲ್ಯಾಲಿ ಸಗ್ಳಿ ಸರಾಪ್ ಲಾಗಲ್ಯಾಲಿ ಜಾಲ್ಯಾತ. ಕಸ ಮಂಜೆ, “<note caller="-" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="DEU 27:26">ಧರ್ಮೋಪದೇಶ 27:26</ref></char></note>ಧರ್ಮಶಾಸ್ತಾರಾತ್ ಲಿವ್‌ಲ್ಯಾಲ ಸಗ್ಳ ಖಾಯಿಮ್ ಪಾಳಿತ್ ನಸ್ನಾರಾ ಪರ್ತೆಕ್ ಯೊಕ್ ಸರಾಪ್ ಲಾಗಲ್ಯಾಲಾ ” ಮನ್ಹುನ್ ಧರ್ಮಶಾಸ್ತಾರಾತ್ ಲಿವ್‌ಲ್ಯಾ. <note caller="-" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="JAS 2:10-12">ಯಾಕೊಬ್ 2:10-12</ref></char></note> <verse eid="GAL 3:10" /><verse number="11" style="v" sid="GAL 3:11" />ಯವ್ಡಸ್ನವ್ಹ ಧರ್ಮಶಾಸ್ತಾರಾನಿ ಕೊನುಸ್ ದೇವಾಪ ನೀಯತಿಚ಼ ವ್ಹಯಾ ವ್ಹಯಿತ್ನಾಹಿ ಮನ್ಹುನ್ ಠಾವಹಾ, ಕಾ ಮಂಜೆ ನೀಯತಿಚಾ಼ ಇಸ್ವಾಸಾನಿಸ್ ಜ಼ಗಲ್ ಮನ್ಹುನ್ ಸಾಂಗ್‌ಲ್ಯಾ.<verse eid="GAL 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 3:12" />ತಸಸ್ ಮೊಶೆಚಾ ಧರ್ಮಶಾಸ್ತಾರಾಲಾ ಇಸ್ವಾಸಾವ ಆಧಾರ್ ಜಾ಼ಲ್ಹ ನಾಹಿ, <note caller="-" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="LEV 18:5">ಯಾಜಕ 18:5</ref>; <ref loc="ROM 10:5">ರೊಮಾಪುರಾತ್‌ಲ್ಯಾನಾ 10:5</ref></char></note>“ಕೊನ್ ಧರ್ಮಶಾಸ್ತಾರಾಚ಼ ನೆಮ್ ಫ್ಯಾಳ್ತೊ ತ್ಯೊ ತ್ಯನಿಸ್ ಜ಼ಗ್ನಾರ್” ಮನ್ಹುನ್ ಲಿವ್‌ಲ್ಯಾ.<verse eid="GAL 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 3:13" />ಯೇಸು ಕ್ರಿಸ್ತ ಆಮಾನಾ ಸರ್ಪಾತ್ನಿ ಸೊಡ್ವಾಯಾ ಸಾಟಿ ಆಪ್ನುಸ್ ಸರಾಪ್ ಲಾಗಲ್ಯಾಲಾ ಜಾ಼ಲಾ. “ಕಾ ಮಂಜೆ ಮೊಶೆಚಾ ಧರ್ಮಶಾಸ್ತಾರಾತ್ ಲಿವ್‌ಲ್ಯಾ ಶಾರ್ಕ <note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="GAL 3:13">3:13</ref>; <ref loc="DEU 21:23">ಧರ್ಮೋಪದೇಶ 21:23</ref></char></note>ಜಾ಼ಢಾವ ಟ್ಯಾಂಗ್‌ಲ್ಯಾಲಾ ಪರ್ತೆಕ್ ಸರಾಪ್ ಲಾಗಲ್ಯಾಲಾ ಮನ್ಹುನ್ ಸಮಜು಼ನ್ ಗೆತಲ್ಯಾ.<verse eid="GAL 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GAL 3:14" />ಅಬ್ರಹಾಮಾಲಾ ದಿಲ್ಯಾಲಾ ಆಶಿರ್ವಾದ್, ಕ್ರಿಸ್ತ ಯೇಸುಪ ಯೆಹುದಿ ನಸ್‌ಲ್ಯಾಲ್ಯಾ ಲೊಕಾನಾ ಸಗ್‌ಳ್ಯಾ ಗಾವಸಾರ ಆನಿ ದೇವಾನಿ ಸಬ್ದದಿಲ್ಯಾಸಾರ ಪರಿಶುದ್ಧ ಆತ್ಮ ಆಮಾನಾ ಇಸ್ವಾಸಾಸ್ ಲಾಗುನ್ ಗಾವಸಾರ, ಆಪ್‌ಲ್ಯಾ ಮರ್ನಾಸ್ ಲಾಗುನ್ ಕ್ರಿಸ್ತಾನಿ ಆಮಾನಾ ಗಿತ್ಲಿತ.<verse eid="GAL 3:14" /></para>
  <para style="s">ಧರ್ಮಶಾಸ್ತಾರ್ ಆನಿ ಸಬ್ದ</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15" />ಬನ್ಹಿ ಬಾವ್ಹಾನು, ಖಾಯಿಮ್ಚಾ ಜೀವ್ನಾನಿ ಯೆಕ್ ಉದಾಹರನ್ ತುಮಾನಾ ಸಾಂಗ್ತೊ, ಯಕಾನಿ ಆನಿ ಯಕಾ ಸಂಗ ಕೆಲ್ಯಾಲಾ ಕರಾರ್ ನಿಸ್ತಾ ಮಾನ್ಸಾಚಾ಼ ಜಾ಼ಲ್ಯಾವ, ತ್ಯೊ ಕುನಿ ಮುಡುನಾಹಿ ಆನಿ ತ್ಯಲಾ ಕಾಯ್ ಯೇಕ್ ಜೊ಼ಡ್ವಾಚ಼ ನಾಹಿ. <verse eid="GAL 3:15" /><verse number="16" style="v" sid="GAL 3:16" />ತಸಸ್, ದೇವಾನಿ ಅಬ್ರಹಾಮಾಲಾ ಆನಿ ತ್ಯಂಚೆ ಪೀಳ್ಗಿಲಾ ಸಬ್ದ ದಿಲ್ಯಾ. ಪನ್ ಪೀಳ್ಗಿ ಮನ್ಹುನ್ ಸಾಂಗ್‌ಲ್ಯಾವ, ತೇ ಪೀಳ್ಗಿತ್ ಆಸ್‌ಲ್ಯಾಲ್ಯಾ ಸಗ್‌ಳ್ಯಾನಾ ನವ್ಹ, ಅಬ್ರಹಾಮಾಚೆ ಪೀಳ್ಗಿತ್‌ಲ್ಯಾ ಯಕಾ ಮಾನ್ಸಾಲಾ ದ್ಯಾವ್ತ. ತ್ಯೊ ಯೊಕುಸ್ ಕ್ರಿಸ್ತ್.<verse eid="GAL 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 3:17" />ಮೀ ಸಾಂಗಾಚ಼ ಕ್ಯಾ ಮಂಜೆ, ದೇವಾನಿ ಆಂದಿ ಕೆಲ್ಯಾಲಾ ಕರಾರ್, ಚಾರ್ಸೆ ತೀಸ್ ವರ್ಸಾಚೆ ನಂತರ್ ಆಲ್ಯಾಲ ಮೊಶೆಚ ಧರ್ಮಶಾಸ್ತಾರಾಲಾ ತ್ಯಾ ಸಬ್ದಾಲಾ ಮೊಡಾಯಾ ವ್ಹಯಿತ್ನಾಹಿ. <note caller="-" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="EXO 12:40">ಇಮೊಚನ್ 12:40</ref></char></note> <verse eid="GAL 3:17" /><verse number="18" style="v" sid="GAL 3:18" />ಕಾ ಮಂಜೆ ಯಕ ಯಳಿ ದೇವಾಚ಼ ದೆನ ಧರ್ಮಶಾಸ್ತಾರಾವ ಆದಾರ ಜಾ಼ಲತ, ತ್ಯ ತ್ಯಚಾ ಸಬ್ದಾವ ಆಧಾರ್ ವ್ಹವುನ್ ನಾಹಿ ಮನ್ಹುನ್ ಜಾ಼ಲ್ಹ. ಫನ್ ದೇವಾನಿ ಅಬ್ರಹಾಮಾಲಾ ಆಪ್‌ಲ್ಯಾ ಸಬ್ದಾಸ್ ಲಾಗುನ್ ತೀ ದಿನ್ಗಿ ದಿಲ್ತಿ.<verse eid="GAL 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 3:19" />ತಸ ಜಾ಼ಲ್ಯಾ ಮೊಶೆಚ಼ ಧರ್ಮಶಾಸ್ತಾರ್ ಕಾ? ಸಬ್ದಾನಿ ದಾವುನ್ ದಿಲ್ಯಾಲಾ ಜ಼ಲ್ಮುನ್ ಯಯಿ ಪರತ್ ದೇವಾನಿ ಆಮ್ಕಿ ಆಮ್ಕಿ ಚು಼ಕ್ ಮನ್ಹುನ್ ದಾವಾಯಾ ಸಾಟಿ ತ್ಯೊ ಸಬ್ದಾಚೆ ನಂತರ್ ನಿವ್ಡುನ್ ದೇವ್ದುತಾಚಾ ತೊಂಡಾನಿ ಯಕಾ ದೆಢ್ಯಾಚಾ ಹಾತಾತ್ ದಿಲ.<verse eid="GAL 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GAL 3:20" />ಯಕ್ಲಾ ಆಸ್ಥಾನಾ ಮದ್ದಿ ಕೊನ್ ನಕೊ. ದೇವ್ ಯಕ್ಲಾಸ್.<verse eid="GAL 3:20" /></para>
  <para style="s">ಧರ್ಮಶಾಸ್ತಾರಾಚ಼ ಉದ್ದೆಶ್</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21" />ತಸ ಜಾ಼ಲ್ಯಾವ ಮೊಶೆಚ಼ ಧರ್ಮಶಾಸ್ತಾರ್ ದೇವಾಚಾ ಸಬ್ದಾನಾ ಆಡ್ವ ಕ್ಯಾ? ತಸ ಕಂದಿಸ್ ಸಮಜು಼ನ್ ಗಿಹುನಾಹಿ. ಜ಼ಗಿವ್ನಾರ ಧರ್ಮಶಾಸ್ತಾರ್ ದಿಲ್ಯಾವ ತ್ಯಚೆಗತ್ ಚಾ಼ಲ್ಯಾವ ಅನ್ಮಾನ್ ನಸ್ತಾನಾ ನೀಯತ್ ಆಲಿಆಸ್ತಿ. <verse eid="GAL 3:21" /><verse number="22" style="v" sid="GAL 3:22" />ಸಗ್ಳಿ ದುನ್ಯಾ ಪಾಪಾಚಾ ತಾಬ್ಯಾತ್ ಹಾ ಮನ್ಹುನ್ ಪವಿತ್ರ ಪುತೀಕ್ ದ್ಯಾವ್ತ. ಆಸ ಆಸ್ತಾನಾ ವಾಗ್ದಾನ್ ಕೆಲ್ಯಾಲ ಫಳ್ ಯೇಸು ಕ್ರಿಸ್ತಾವ ಇಸ್ವಾಸ್ ಥೆವ್ನಾರ‍್ಯಾನಾ ತ್ಯಚಾ ಇಸ್ವಾಸಾಚಾ ಆಧಾರಾವ ದೇತ್ಯಾತ.<verse eid="GAL 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 3:23" />ಪನ್ ಯೆಸು ಕ್ರಿಸ್ತಾಚಾ ಇಸ್ವಾಸಾತ್ ಜೀವ್ನಾ ಕರಾಚ಼ ದಿಸ್ ಯಯಾಚೆ ಆಂದಿ ಆಮಿ ಮೊರ್ಹ ದಿಸ್ನಾರ‍್ಯಾ ತ್ಯಾ ಇಸ್ವಾಸಾತ್ ಗಾವಾಯಾ ಸಾಟಿ ಮೊಶೆಚಾ ಧರ್ಮಶಾಸ್ತಾರಾಚಾ ಬಾದ್ನಾತ್ ಗಾವಲ್ಯಾವ್. <verse eid="GAL 3:23" /><verse number="24" style="v" sid="GAL 3:24" />ಆಮಿ ಇಸ್ವಾಸಾನಿ ಯೇಸು ಕ್ರಿಸ್ತಾಪ ನೀಯತಿಚ಼ ಮನ್ಹುನ್ ನಿರ್ಧಾರ್ ಗೆನಾರ ದಿಸ್ ಯಯಿ ಪರತ್, ಮೊಶೆಚ಼ ಧರ್ಮಶಾಸ್ತಾರ್ ಆಮಾನಾ ಮೊರ್ಹ ನೆನಾರ‍್ಯಾ ಫುಡಾರ‍್ಯಾಚೆಗತ್ ಹಾ. <verse eid="GAL 3:24" /><verse number="25" style="v" sid="GAL 3:25" />ಫನ್ ಆತಾ ಇಸ್ವಾಸ್ ಆಲ್ಯಾ ಮನ್ಹುನ್ ಆಮಿ ಫುಡಾರಿ ಜಾ಼ಲ್ಯಾಲ್ಯಾ ಧರ್ಮಶಾಸ್ತಾರಾಚಾ ತಾಬ್ಯಾತ್ನಾಹಿ<verse eid="GAL 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GAL 3:26" />ಕಾ ಮಂಜೆ ತುಮಿ ಸಗ್ಳಿ ಕ್ರಿಸ್ತ ಯೇಸುವ ಥೆವ್‌ಲ್ಯಾಲ್ಯಾ ಇಸ್ವಾಸ್ ಲಾಗುನ್ ದೇವಾಚಿ ಪೊರ ಜಾ಼ಲ್ಯಾಸಾ.<verse eid="GAL 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GAL 3:27" />ಕಸ ಮಂಜೆ ಕ್ರಿಸ್ತಾಪ ಮಿಳಾಯಾ ಬಾಪ್ತಿಸ್ಮಾ ಗೆತಲ್ಯಾಲಿ ತುಮಿ ಸಗ್ಳಿ ಕ್ರಿಸ್ತಾಚೆಗತ್ ಹುತ್ತಾಸಾ. <verse eid="GAL 3:27" /><verse number="28" style="v" sid="GAL 3:28" />ತುಮಿ ಸಗ್ಳಿ ಕ್ರಿಸ್ತ ಯೇಸುಪ ಎಕುಸ್ ಹಾಸಾ ಮನ್ಹುನ್ ಯೆಹುದ್ಯಿ ನಾಹಿತ ಗ್ರೀಕ್ ವ್ಹವುನಿ, ಗುಲಾಮ್ ನಾಹಿತ ಸ್ವತಂತ್ರ, ಧನ್ಹಿ ಆನಿ ಆಳ್ ಗಡಿ ಆನಿ ಬ್ಯಾಯ್ಕಾ ಮಾನುಸ್ ಆಸಾ ಭೇದ್ ಭಾವ್ನಾಹಿ. <verse eid="GAL 3:28" /><verse number="29" style="v" sid="GAL 3:29" />ತುಮಿ ಕ್ರಿಸ್ತಾಚಿ ಜಾ಼ಲ್ಯಾವ ಅಬ್ರಹಾಮಾಚೆ ಪೀಳ್ಗಿಚಿ ವ್ಹವುನ್ ತಸಸ್ ದೇವಾಚಾ ವಾಗ್ದಾನಾಲಾ ಹಾಕ್ದಾರ್ ಜಾ಼ಲ್ಯಾಸಾ.<verse eid="GAL 3:29" /></para>
  <chapter eid="GAL 3" />
  <chapter number="4" style="c" sid="GAL 4" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1" />ಫನ್ ಮೀ ಸಾಂಗಾಚ಼ ಕ್ಯಾ ಮಂಜೆ, ವಾರ್ಸಿ, ಆಪ್ನು ಸಗ್ಳೆ ಆಸ್ತಿಲಾ ದನ್ಹಿ ಆಸ್ಲಾತರಿ ಬಾರಿಕ್ ಆಸ್ಥಾನಾ ಗುಲಾಮಾಚೆಗತುಸ್ ರಾನ್ಹಾರ್. <verse eid="GAL 4:1" /><verse number="2" style="v" sid="GAL 4:2" />ಬಾನಿ ಥರಿವ್‌ಲ್ಯಾಲ್ಯಾ ಯಳಾಪರತ್ ಬಾಚಾ ಆನಿ ಕಾಮ್ದಾರಾಚಾ ತಾಬ್ಯಾತ್ ಆಸ್ತೊ. <verse eid="GAL 4:2" /><verse number="3" style="v" sid="GAL 4:3" />ತಸಿಸ್ ಆಮಿ ಸಾಯಿತ್ ಮುಲ್ ಆಸ್ತಾನಾ ದುನೆಚಾ ಪೈಲ್ಯಾ ಶಿಕ್ಷಾನಾಚಾ ತಾಬ್ಯಾತ್ ರಾಥಾವ್. <verse eid="GAL 4:3" /><verse number="4" style="v" sid="GAL 4:4" />ಪನ್ ಶಾರ್ಕಾ ಯೊಳ್ ಆಲಾತವಾ ದೇವಾನಿ ಆಪ್‍ಲ್ಯಾ ಲೆಕಾಲಾ ಲಾವುನ್ದಿಲಾ. ತ್ಯೊ ಬ್ಯಾಯ್ಕಾ ಮಾನ್ಸಾಚಾಪೊಟಾತ್ ಜ಼ಲ್ಮುನ್ , ಧರ್ಮಶಾಸ್ತಾರಾಚೆಗತ್ ಆಲ್ಲಾ. <verse eid="GAL 4:4" /><verse number="5" style="v" sid="GAL 4:5" />ಹ್ಯಚಿಸ್ ಲಾಗುನ್ ಧರ್ಮಶಾಸ್ತಾರಾಚಾ ತಾಬ್ಯಾತ್ ಆಸ್‌ಲ್ಯಾಲ್ಯಾನಾ ಸುಟ್ನುಕ್ ದಿಯಾ ಅಲ್ಯಾ. ಮನ್ಹುನ್ ಆಮಿ ದೇವಾಚಿ ಪೊರ ಜಾ಼ಲ್ಯಾವ್<verse eid="GAL 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 4:6" />ತುಮಿ ಲೆಕ್ರ ಜಾ಼ಲ್ಯಾಸಾ ಮನ್ಹುನ್ ದೆವಾಲಾ ಬಾ ಮಾಜಾ ಬಾ, ಮನ್ಹುನ್ ವರಾಡ್‍ತ್ಯಾಲ್ಯಾ ಆಪ್‌ಲ್ಯಾ ಲೆಕಾಚ಼ ಆತ್ಮ ಆಮ್ಚಾ ಶರೀರಾತ್ ಲಾವುನ್ದಿಲ. <verse eid="GAL 4:6" /><verse number="7" style="v" sid="GAL 4:7" />ಆಸ ಆಸ್ತಾನಾ ಆಜು಼ನ್ ತು ಸೇವಕ್ ನವ, ಲ್ಯೊಕ್. ಲ್ಯೊಕ್ ಜಾ಼ಲ್ಯಾವ ದೇವಾಪ್ನಿ ವಾರ್ಸಿ ಜಾ಼ಲ್ಯಾಸ್.<verse eid="GAL 4:7" /></para>
  <para style="s">ಗಲಾತ್ಯಾತಲ್ಯಾಂಚೆ ಗುಸ್ಟಿತ್ ಪೌಲಾಚಿ಼ ಕ್ಯಾಳ್ಜಿ</para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8" />ಆಸಿ ತುಮಿ ದೇವಾಲಾ ಸಮಜು಼ನ್ ಗಿಹ್ಯಾಚೆ಼ ಆಂದಿ, ಸಜ಼್ ದೇವ್ ನವ್ಹತ್ಯನಾ ಗುಲಾಮ್ ಜಾ಼ಲ್ತಾಸಾ. <note caller="-" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="ISA 37:19">ಯೆಶಾಯ್ 37:19</ref>; <ref loc="JER 2:11">ಯೆರೆಮೀಯ 2:11</ref></char></note> <verse eid="GAL 4:8" /><verse number="9" style="v" sid="GAL 4:9" />ಆತಾ ತರಿ ತುಮಿ ದೇವಾಲಾ ಸಮಜು಼ನ್ ಗೆತಲ್ಯಾಸಾ. ಖುಬ್ ಕರುನ್ ದೇವಾನಿ ತುಮಾನಾ ಸಮಜು಼ನ್ ಗೆತಲ್ಯಾ. ಆಸ ಆಸ್ತಾನಾ ತುಮಿ ಬಳ್ ನಸ್‌ಲ್ಯಾಲ್ಯಾ, ಕಾಮಾಲಾ ಯಯಿ ನಸ್‌ಲ್ಯಾಲ, ಆಮ್ಚೆ ಉಪೇಗಿಚ಼ ನಸ್‌ಲ್ಯಾಲ್ಯಾತ್ ಮಾಗಾರಿ ಪರ್ತುನ್ ತ್ಯಲಾ ಗುಲಾಮ್ ವ್ಹಯಾ ಕಾ ಮನ್ ಕರ್ತಾಸಾ? <verse eid="GAL 4:9" /><verse number="10" style="v" sid="GAL 4:10" />ತುಮಿ ಶಾರ್ಕ ದಿಸ್, ಮೈನ್ಹ, ಕಾಲ್, ಸಗ್ಳಿ ವರ್ಸ ಶಾರ್ಕಿ ಪ್ಯಾಳ್ಳಿಸಾ. <verse eid="GAL 4:10" /><verse number="11" style="v" sid="GAL 4:11" />ಮೀ ತುಮ್ಚಿ ಸಾಟಿ ಖಟ್ಪಟ್ ಕೆಲ್ಯಾಲಿ ಪುಕಟ್ ಜಾ಼ಲಿ ಕ್ಯಾ ಮನ್ಹುನ್ ತುಮ್ಚೆ ಗುಸ್ಟಿತ್ ಬಿಥೊ.<verse eid="GAL 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 4:12" />ಬನ್ಹಿ ಬಾವ್ಹಾನು, ಮೀ ತುಮ್ಚೆಗತ್ ಜಾ಼ಲೊ ತಸಾ ತುಮಿ ಮಾಜಿಗತ್ ವ್ಹಯಾವ್ಹಯಿಸಾ ಮನ್ಹುನ್ ತುಮ್ಚಿಪ ಮಾಕ್ತೊ. ತುಮಿ ಮನಾ ಕಾಯ್ ಅನೆವ್ ಕೆಲಾನಾಹಿಸಾ. <verse eid="GAL 4:12" /><verse number="13" style="v" sid="GAL 4:13" />ಮಾಜಾ ಆಂಗಾತ್ ದುಕ್ನ ಹಾ ಮನ್ಹುನ್ ತುಮ್ಚಿಪ ರಾವುನ್ ಪೈಲೆ ಪಾವ್ಟಿ ತುಮಾನಾ ಬರಿ ಖಬರ್ ಸಾಂಗ್‍ಲ್ಯಾಲಿ ತುಮಾನಾ ಠಾವಿ ಹಾ. <verse eid="GAL 4:13" /><verse number="14" style="v" sid="GAL 4:14" />ಮಾಜಾ ಆಂಗಾಚಾ ದುಕ್‌ನ್ಯಾನಿ ತುಮಾನಾ ತರಾಸ್ ಜಾ಼ಲಾತರಿ, ತುಮಿ ಮನಾ ಟ್ಯಾಕ್ಲಾನಾಹಿಸಾ, ನಕ್ವಾಟ್ ಕಿಲಿನಾಹಿಸಾ. ಮನಾ ದೇವ್ ದುತಾಚೆಗತ್, ಕ್ರಿಸ್ತ ಯೇಸುಪ ಗೆತ್ಲಾಸಾ. <verse eid="GAL 4:14" /><verse number="15" style="v" sid="GAL 4:15" />ತವಾ ಆಮಾನಾ ಬರಜಾ಼ಲ ಮನ್ಹುನ್ ತುಮಿ ಮಂಥಾಸಾನವ್ಹ, ತ್ಯ ತುಮಚ಼ ಬರಫನ್ ಕುಂಡಗೆಲ? ಸಾದ್ಯಾ ಜಾ಼ಲ್ಯಾವ ತುಮಚ಼ ಡೊಳ ಕಾಡುನ್ ಮನಾ ದಿಸಿಲಾ ಮನ್ಹುನ್ ತುಮ್ಚೆ ಗುಸ್ಟಿತ್ ಸಾಕ್ಷಿ ಸಾಂಗ್ತೊ. <verse eid="GAL 4:15" /><verse number="16" style="v" sid="GAL 4:16" />ಆಸ ಆಸ್ತಾನಾ ಮೀ ತುಮಾನಾ ಖರ ಸಾಂಗ್ತೊ ಮನ್ಹುನ್ ತುಮಾನಾ ಆತಾ ವಾದಿ ಜಾ಼ಲೊ ಕ್ಯಾ? <note caller="-" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="AMO 5:10">ಆಮೊಸ 5:10</ref></char></note><verse eid="GAL 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 4:17" />ತೀ ತುಮಾನಾ ವವ್ಯಾಳಾಲಾ ಮನ್ ದ್ಯಾವತ್ಯಾತ ಫನ್ ಬರ‍್ಯಾಲಾ ನವ್ಹ, ತುಮಿ ತ್ಯಂಚಿ ಸಾಟಿ ಮನ್ ದ್ಯಾವ್ತಾಸಾ ತಸಿಸ್ ತುಮಾನಾಬಿ ತ್ಯಂಚಾನಿ ಮನ್ ದಾವಾಯಾ ವ್ಹಯಿ ಮನ್ಹುನ್ ತೀ ತುಮಾನಾ ಬಾಹಿರ್ ಗಾಲಾಯಾ ಬಕ್‍ತ್ಯಾತ. <verse eid="GAL 4:17" /><verse number="18" style="v" sid="GAL 4:18" />ಮೀ ತುಮ್ಚಿ ಸಂಗ ಆಸ್ತಾನಾ ತ್ಯವ್ಡಸ್ನವ್ಹ ಕವಾಬಿ ಬರೆ ಗುಸ್ಟಿಸಾಟಿ ತುಮಿ ಮನ್ ದಾವಾಚ಼ ಬರಸ್. <verse eid="GAL 4:18" /><verse number="19" style="v" sid="GAL 4:19" />ಮಾಜೆ ಮಾಯಾಚಾ ಗಲಾತ್ಯಾತಲ್ಯಾ ಮುಲಾನು, ಕ್ರಿಸ್ತಾಚಾ಼ ರುಪ್ ತುಮ್ಚಿಪ ಉತ್ಪನ್ ವ್ಹಯಿ ಪರತ್ ಮೀ ತುಮ್ಚಿ ಸಾಟಿ ಬಾಳ್ತಿನಿಚ಼ಯಾಗ್ ಕ್ಯಾಡ್ತೊ. <verse eid="GAL 4:19" /><verse number="20" style="v" sid="GAL 4:20" />ತುಮ್ಚೆ ಗುಸ್ಟಿತ್ ಕ್ಯಾ ಕರಾಯಾವ್ಹಯಿ ಮನ್ಹುನ್ ಮನಾ ಸಮಜ಼ನಾ. ಮನಾವಾಟ ನಿಟ್ ತುಮ್ಚಿಪ ಯವುನ್, ತುಮ್ಚೆ ಮದ್ದಿಸ್ ರಾವುನ್ ಮಾಜೆ ಬುಲಿಚಿ ಥಿರಿ ಬದಲ್ಯಾವ ಚಾ಼ಂಗ್ಲ ವ್ಹಯಾಚ಼ ವ್ಹತ!<verse eid="GAL 4:20" /></para>
  <para style="s">ಸಾರಾಚಿ ಆನಿ ಹಾಗರಾಚಿ ಉದಾಹರನ್</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21" />ಧರ್ಮಶಾಸ್ತಾರಾಚೆಗತ್ ಚಾ಼ಲಾಯಾ ಮನ್ ಕರ್ತ್ಯಾಲ್ಯಾನು, ಧರ್ಮಶಾಸ್ತಾರ್ ಕ್ಯಾ ಸಾಂಗ್‌ತ್ಯಾ ಮನ್ಹುನ್ ತುಮಾನಾ ಸಮಾಜ಼್ಲನಾಹಿ ಕ್ಯಾ? ಮನಾ ಸಾಂಗಾ. <verse eid="GAL 4:21" /><verse number="22" style="v" sid="GAL 4:22" />ತ್ಯಾತ್ ಲಿವ್‌ಲ್ಯಾಲ ಕ್ಯಾ ಮಂಜೆ, ಅಬ್ರಹಾಮಾಲಾ ದೊಗ ಲ್ಯಾಕ್ ಹುತ್ತ. ಯೊಕ್ ಚಾ಼ಕ್ರಿನಿಚಾ ಪೊಟಾತ್ ಜ಼ಲಾಮ್‌ಲ್ಯಾಲಾ, ಆನಿ ಯೊಕ್ ಸ್ವತಾಚೆ ಬಾಯ್ಕೊಚಾ ಪೊಟಾತ್ ಜ಼ಲಾಮ್‌ಲ್ಯಾಲಾ. <note caller="-" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="GEN 16:5">ಉತ್ಪತಿ 16:5</ref>; <ref loc="GEN 21:2">21:2</ref></char></note> <verse eid="GAL 4:22" /><verse number="23" style="v" sid="GAL 4:23" />ಚಾ಼ಕ್ರಿನಿಚಾ಼ ಲ್ಯೊಕ್ ಸಜ಼್ ಜ಼ಲಾಮ್‌ಲ್ಯಾಲಾ, ಸ್ವತಂತ್ರ ಆಸ್‌ಲ್ಯಾಲಿಚಾ಼ ಲ್ಯೊಕ್ ವಾಗ್ದಾನಾನಿ ಜ಼ಲಾಮ್‌ಲ್ಯಾಲಾ. <verse eid="GAL 4:23" /><verse number="24" style="v" sid="GAL 4:24" />ಹ್ಯಾ ಗುಸ್ಟಿ ಯಕಾಚೆಗತುಸ್ ಹಾತಾ. ಕಶಾ ಮಂಜೆ ತ್ಯಾ ದುಗಿ ಬ್ಯಾಯ್ಕಾಮಾನ್ಸ ದೊನ್ ಕರಾರ್, ಯೊಕ್ ಕರಾರ್ ಸೀನಾಯಿ ಪರ್ವತಾತ್ನಿ ಗುಲಾಮಾತ್ ರಾಯಾವ್ಹಯಿತ್ಯಾ ಪೊರಾನಾ ಜ಼ಲ್ಮದೆನಾರ್, ತೀಸ್ ಹಾಗರಳ್. <verse eid="GAL 4:24" /><verse number="25" style="v" sid="GAL 4:25" />ಹಾಗರಳ್ ಮಂಜೆ ಅರಬಾಚಾ ಜಾ಼ಗ್ಯಾವ್ಲಾ ಸೀಪಾಯಿ ಪರ್ವತ ಮನ್ಹುನ್ ದ್ಯಾವತ್ಯಾಲ ಆತಾಚಾ ಯೆರುಸಲೇಮ್ ಮಂತ್ಯಾಚೆಗತ್ ಹಾ, ಕಾ ಮಂಜೆ ತೀ ಆಪ್‌ಲ್ಯಾ ಪೊರಾ ಸಂಗ್ನಿ ಹ್ಯಾ ಗುಲಾಮಾತ್ ಹಾ. <verse eid="GAL 4:25" /><verse number="26" style="v" sid="GAL 4:26" />ಫನ್ ವೈಲಿ ಯೆರುಸಲೇಮ್ ಮಂತ್ಯಾಲಿ ಸ್ವತಂತ್ರಿ, ಹಿಸ್ ಆಮಾನಾ ಆಯಿ.<verse eid="GAL 4:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="GAL 4:27" />ಕಾ ಮಂಜೆ, <note caller="-" style="x"><char style="xo" closed="false">4:27 </char><char style="xt" closed="false"><ref loc="ISA 54:1">ಯೆಶಾಯ್ 54:1</ref></char></note>“ವಾಂಜೊ಼ಳೆ, ಸಂತೊಸ್ ಹೊ.</para>
  <para style="q2" vid="GAL 4:27">ಬಾಳತ್ ಪನಾಚ಼ ಯಾಗ್ ನಸ್ನಾರೆ, ಸಂತೊಶಾನಿ ವರಾಡ್,</para>
  <para style="q1" vid="GAL 4:27">ದನ್ಗೊರ್ ಆಸ್‌ಲ್ಯಾಲಿವ್ನಿ ದನ್ಗೊರ್ ಶೊಡ್‌ಲ್ಯಾಲಿಲಾ ಪೊರ ಖುಬ್”</para>
  <para style="m" vid="GAL 4:27">ಮನ್ಹುನ್ ಲಿವ್‌ಲ್ಯಾಲ ಹಾ ನವ್ಹ.<verse eid="GAL 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GAL 4:28" />ಬನ್ಹಿ ಬಾವ್ಹಾನು, ಆಮಿ ಇಸಾಕಾಚೆಗತ್ ಸಬ್ದಾಚೆಗತ್ ಜ಼ಲಾಮ್‍ಲ್ಯಾಲಿ ಪೊರಜಾ಼ಲ್ಯಾವ್. <verse eid="GAL 4:28" /><verse number="29" style="v" sid="GAL 4:29" />ಫನ್ ಆಂದಿ ಶರೀರಾನಿ ಜ಼ಲಾಮ್‍ಲ್ಯಾಲಾ, ದೇವಾಚಾ ಆತ್‍ಮ್ಯಾಚಾ ಬಳಾನಿ ಜ಼ಲಾಮ್‌ಲ್ಯಾಲ್ಯಾಲಾ ತರಾಸ್ ದಿಲ್ಯಾಸಾರಾ ಆತಾಬಿ ವ್ಹತ್ಯಾ. <verse eid="GAL 4:29" /><verse number="30" style="v" sid="GAL 4:30" />ಫನ್ ಪವಿತ್ರ ಗ್ರಂಥ ಕ್ಯಾ ಸಾಂಗ್‌ತ್ಯಾ? <note caller="-" style="x"><char style="xo" closed="false">4:30 </char><char style="xt" closed="false"><ref loc="GEN 21:10">ಉತ್ಪತಿ 21:10</ref></char></note>ಚಾಕ್ರಿನಿಲಾ ತಿಚಾ ಪೊರಾನಾ ಬಾಹಿರ್‌ ಗ್ಯಾಲ್. ಚಾ಼ಕ್ರಿನಿಚಾ಼ ಲ್ಯೊಕ್ ಸ್ವತಂತ್ರಿಚಾ ಲೆಕಾಸಂಗ ಕವಾಸ್ ವಾರಸ್ದಾರ್ ವ್ಹವುನಾಯಿ ಮನ್ಹುನ್ ಸಾಂಗ್ತ. <verse eid="GAL 4:30" /><verse number="31" style="v" sid="GAL 4:31" />ಬನ್ಹಿ ಬಾವ್ಹಾನು, ಆಮಿ ಚಾ಼ಕ್ರಿನಿಚಿ ಪೊರನವ್ಹ, ಸ್ವತಂತ್ರಿಚಿ ಪೊರ ಜಾ಼ಲ್ಯಾವ್.<verse eid="GAL 4:31" /></para>
  <chapter eid="GAL 4" />
  <chapter number="5" style="c" sid="GAL 5" />
  <para style="s">ಕ್ರಿಸ್ತಾಪ ಸ್ವತಂತ್ರ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1" />ಕ್ರಿಸ್ತಾನಿ ಆಮಾನಾ ಸ್ವತಂತ್ರಿ ರಾಹ್ಯಾವ್ಹಯಿ ಮನ್ಹುನ್ ಸುಟ್ಕಿ ಕಿಲಿತ. ತ್ಯಾತ್ ಘಟ್ ಉಬಿರಾವ್ಹಾ, ಗುಲಾಮಾಚಾ ತಾಬ್ಯಾತ್ ಆನಿಕ್ ಗಾಹುನಕೊಸಾ.<verse eid="GAL 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 5:2" />ಬಗಾ, ಪೌಲ್ ಮಂಥ್ಯಾಲಾ ಮೀ ತುಮಾನಾ ಸಾಂಗ್ತೊ, ತುಮಿ ಮುಂಜಿ ಕರುನ್ ಗೆತಲ್ಯಾವ ಕ್ರಿಸ್ತಾಪ್ನಿ ತುಮಾನಾ ಕ್ಯಾ ಪ್ಯಾಯ್ದಾ ನಾಹಿ ನವ್ಹ. <verse eid="GAL 5:2" /><verse number="3" style="v" sid="GAL 5:3" />ಮುಂಜಿ ಕರುನ್ ಗೆತ್ಯಾಲ್ಯಾ ಪರ್ತೆಕಾಲಾ, ತು ಧರ್ಮಶಾಸ್ತಾರಾತ್ ಸಾಂಗ್‌ಲ್ಯಾಲ ಸಗ್ಳ ಕರಾಚಾ ಲಾಜಿಮಾತ್ ಹಾಸ್ ಮನ್ಹುನ್ ಪರ್ತುನ್ ಖರ‍್ಯಾನಿ ಸಾಂಗ್ತೊ. <verse eid="GAL 5:3" /><verse number="4" style="v" sid="GAL 5:4" />ತುಮ್ಚಾತ್ ಕೊನ್ ಕೊನ್ ದರ್ಮಶಾಸ್ತಾರಾನಿ ನೀಯತಿಚ಼ ವ್ಹಯಾವ್ಹಯಿ ಮನ್ಹುನ್ ಮನ್ ಕರ್ತಾಸಾ ತೀ ಕ್ರಿಸ್ತಾಪ್ನಿ ಯಗಾಳ್ಯಾಲಿ ಜಾ಼ಲ್ಯಾಸಾ. ಕ್ರಪೆತ್ನಿ ಮಾಗ ಗೆಲ್ಯಾಲಿ ಜಾ಼ಲ್ಯಾಸಾ. <verse eid="GAL 5:4" /><verse number="5" style="v" sid="GAL 5:5" />ಆಮಿತರಿ ದೇವಾಚಾ ಆತಮ್ಯಾಸ್ ಲಾಗುನ್ ಇಸ್ವಾಸಾನಿ ನೀಯತಿಚ಼ ವ್ಹತಾವ್ ಮನ್ಹುನ್ ಆಶಾ ಪುರಿವ್ಹನಾರ್ ಮನ್ಹುನ್ ವಾಟ್ ಬಕ್ತಾವ್. <verse eid="GAL 5:5" /><verse number="6" style="v" sid="GAL 5:6" />ಯೇಸು ಕ್ರಿಸ್ತಾಪ ಆಸ್‌ಲ್ಯಾಲ್ಯಾನಾ ಮುಂಜಿ ಜಾ಼ಲಿತರಿ ನಾಹಿ ಜಾ಼ಲಿತರಿ ಪ್ಯಾಯ್ದಾನಾಹಿ, ಪನ್ ತ್ಯಂಚಿಪ ಮಾಯೆನಿ ಯತ್ಯಾಲಾ ಇಸ್ವಾಸುಸ್ ಪ್ಯಾಯ್ದಾ ಜಾ಼ಲ್ಯಾ.<verse eid="GAL 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 5:7" />ಚಾ಼ಂಗ್ಲಿ ಚಾ಼ಲತಾಸಾ. ಫನ್ ತುಮಿ ಖರ‍್ಯಾ ಶಾರ್ಕ ಚಾ಼ಲುನಾಹಿ ಆಸ ತುಮಚ಼ ಮನ್ ವಳಿವ್‌ಲ್ಯಾಲ ಕುನಿ? <verse eid="GAL 5:7" /><verse number="8" style="v" sid="GAL 5:8" />ಹ್ಯ ಮನ್ ವಳ್ವಾಚ಼ ತುಮಾನಾ ಹಾಕಟ್‌ಲ್ಯಾಲ್ಯಾಪ್ನಿ ಆಲ್ಯಾಲ ನವ್ಹ. <verse eid="GAL 5:8" /><verse number="9" style="v" sid="GAL 5:9" />ಥೊಡ್ಯಾ ಆಮ್ಟಾನಿ ಪೀಟ್ ಸಗ್ಳ ಆಂಬಾಟ್ ವ್ಹತ್ತ. <verse eid="GAL 5:9" /><verse number="10" style="v" sid="GAL 5:10" />ಪ್ರಭುಪ ತುಮ್ಚೆ ಗುಸ್ಟಿತ್ ಮನಾ ಇಸ್ವಾಸ್ ಹಾ. ತುಮ್ಚಾತ್ ಗೊಂದೊಳ್‍ ಆನ್ನಾರಾ ಕೊನ್ ಆಸ್ಲಾತರಿ, ತ್ಯಲಾ ಶಿಕ್ಷಾ ವ್ಹನಾರ್.<verse eid="GAL 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 5:11" />ಬನ್ಹಿ ಬಾವ್ಹಾನು, ಮೀತರಿ ಮುಂಜಿ ವ್ಹಯಾವ್ಹಯಿ ಮನ್ಹುನ್ ಆಜು಼ನ್ ಸಾಂಗ್‍ತ್ಯಾಲಾ ಜಾ಼ಲ್ಯಾವ ಮನಾ ಜಾ಼ಚ಼್ ವ್ಹಯಾಚಾ಼ ಕಾ? ತಸ ಆಸ್ತಾನಾ ಶಿಲ್ಬೆಸ್ ಲಾಗುನ್ ವ್ಹನಾರಾ ತರಾಸ್ ಸಪ್ಲಾನವ್ಹ? <verse eid="GAL 5:11" /><verse number="12" style="v" sid="GAL 5:12" />ತುಮಚಾ಼ ತಳ್ಮಳಾ ಕರ್ನಾರ‍್ಯಾನಿ ಆಪ್ಲ ಆಂಗ್ ಆಪ್ನುಸ್ ಕಾಪುನ್ ಗೆತಲ್ಯಾವ ಬರ.<verse eid="GAL 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 5:13" />ಬನ್ಹಿ ಬಾವ್ಹಾನು, ತುಮಿ ಸ್ವತಂತ್ರಿ ವ್ಹಯಾವ್ಹಯಿಸಾ ಮನ್ಹುನ್ ದೇವಾನಿ ತುಮಾನಾ ಹಾಕಟ್ಲ. ಫನ್ ತುಮಚ಼ ಸ್ವತಂತ್ರ ಶರೀರಾಚಾ ಸ್ವಬಾವಾ ಶಾರ್ಕ ವಾಪ್ರಾಚೆ ಆಂದಿ, ಮಾಯೆನಿ ಯಕಾಮಕಾಚಿ ಚಾ಼ಕ್ರಿ ಕರಾ. <verse eid="GAL 5:13" /><verse number="14" style="v" sid="GAL 5:14" />ತುಜಾ ಸೇಜಾ಼ರ‍್ಯಾಚಿ ತುಜೆಗತುಸ್ ಮಾಯಾಕರ್ ಮಂಥ್ಯಾಲ್ಯಾ ಯಕಾಸ್ ಸಬ್ದಾತ್ ಧರ್ಮಶಾಸ್ತಾರ್ ಅಡ್ಕುನ್ ಹಾ. <note caller="-" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="JDG 19:18">ನ್ಯಾಯಸ್ತಾಪಕ 19:18</ref>; <ref loc="MAT 22:39-40">ಮತ್ತಾಯಾ 22:39-40</ref></char></note> <verse eid="GAL 5:14" /><verse number="15" style="v" sid="GAL 5:15" />ಫನ್ ತುಮಿ ಜ಼ನಾವಾರಾಚೆಗತ್ ಯಕಾಮಕಾಲಾ ಚಾ಼ವುನ್, ಫಾಟುನ್, ಖಾತ್ಯಾಲ ಜಾ಼ಲ್ಯಾವ ಯಕಾಮಕಾಪ್ನಿ ಮರುನ್ ಜಾ಼ಸಿಲಾ ಹುಶಾರ್ ರಾವ್ಹಾ.<verse eid="GAL 5:15" /></para>
  <para style="s">ಪವಿತ್ರಾತ್ಮ ಆನಿ ಮಾನ್ಸಾಚಾ಼ ಸ್ವಬಾವ್</para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16" />ಮೀ ಸಾಂಗಾಚ಼ ಕ್ಯಾ ಮಂಜೆ ಪವಿತ್ರಾತ್ಮಾಚೆಗತ್ ಚಾ಼ಲಾ, ತವಾ ತುಮಿ ಶರೀರಾಚಿ಼ ಆಶಾ ಜ಼ರಾಬಿ ಕರಿತ್ನಾಹಿಸಾ. <verse eid="GAL 5:16" /><verse number="17" style="v" sid="GAL 5:17" />ಕಾ ಮಂಜೆ ಶರೀರಾಚಿ ಆಶಾ ಆತಮ್ಯಾಲಾ ಆಡ್ವಿ ಜಾ಼ಲೆ. ಆತಮ್ಯಾಚಿ ಆಶಾ ಶರೀರಾಲಾ ಆಡ್ವಿ ಹಾ ತುಮಿ ಕರಾಯಾವ್ಹಯಿ ಮಂತ್ಯಾಲ ಕರಾಚೆ ಆಂದಿ ಹೀ ಯಕಾ ಮಕಾಚೆ ಆಡ್ವಿ ಹಾತ. <verse eid="GAL 5:17" /><verse number="18" style="v" sid="GAL 5:18" />ಫನ್ ತುಮಿ ಆತಮ್ಯಾನಿ ಚಾ಼ಲ್ವಾಚ಼ ಜಾ಼ಲ್ಯಾವ ಧರ್ಮಶಾಸ್ತಾರಾಚಾ ತಾಬ್ಯಾತ್ನಾಹಿಸಾ.<verse eid="GAL 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 5:19" />ಆಮ್ಚಾ ಶರೀರಾಚ಼ ಸ್ವಬಾವ್ ದಿಸತ್ಯಾಲಸ್ ಹಾತ, ತೇ ಕಚ಼ ಮಂಜೆ, ವ್ಯಭಿಚಾರ್, ಬಾಹಿರ್ಲಿ ಸಂಗತ್, ಲಾಜ಼ಚ಼ ಕಾಮ್, <verse eid="GAL 5:19" /><verse number="20" style="v" sid="GAL 5:20" />ಪಾಶಾನ ಪುಜಾ಼ಚಿ, ಘಾಡ್ಪನ್, ವಾದ್, ಕಳ್, ಖೊಟಫನ್, ರಾಗ್, ಬೇಧ್‍ಬಾವ್, ಬಿನ್ನಮತ್, <verse eid="GAL 5:20" /><verse number="21" style="v" sid="GAL 5:21" />ಡಾವ್, ಪಿದೊಡ, ಗೊಂದೊಳ್, ಉದ್ಳ ಆಸ್ಲಿಸ್. ಆಸ್ಲಿ ಕಾಮ ಕರ್ನಾರ ದೇವಾಚಾ ರಾಜಾಚ಼ ವಾರಸ್ದಾರ್ ವ್ಹಯಿತ್ನಾಹಿತ ಮನ್ಹುನ್ ಮೀ ಹ್ಯಚೆ ಆಂದಿ ಸಾಂಗ್‌ಲ್ಯಾಸಾರ ಆತಾಬಿ ತುಮಾನಾ ಹುಶಾರ್ಕಿ ದೆತೊ.<verse eid="GAL 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GAL 5:22" />ಫನ್ ದೇವಾಚಾ ಆತಮ್ಯಾಚ಼ ಫಳ್ ಕ್ಯಾ ಮಂಜೆ, ಮಾಯಾ, ಆನಂದ, ಸಮಾಧಾನ್, ಧಂಡ್ಫನ್, ದಯಾ, ದುಸರ‍್ಯಾನಾ ಮಜ಼ತ್ ಕರಾಚಿ, ಇಸ್ವಾಸ್, <verse eid="GAL 5:22" /><verse number="23" style="v" sid="GAL 5:23" />ಸಾಬಫನ್, ಆಪ್ಲ ಮನ್ ಆಪ್‌ಲ್ಯಾ ತಾಬ್ಯಾತ್ ಥೆವಾಚ಼. ಹ್ಯಂಚೆ ಆಡ್ವ ಕಚ಼ಸ್ ಧರ್ಮಶಾಸ್ತಾರ್ ನಾಹಿ. <verse eid="GAL 5:23" /><verse number="24" style="v" sid="GAL 5:24" />ಕ್ರಿಸ್ತ ಯೇಸುಪ ಆಸ್‌ಲ್ಯಾಲಿ ಆಪಲ್ಯಾ ಶರೀರಾಚಿ ಭಾವ್ನಾ ತ್ಯಚಿ ಆಶಾ ಕರಾಚಿ, ಹೌರ‍್ಯಾ ಪನಾ ಸಕಟ್ ಶಿಲ್ಬೆವ ಗಾಲ್ನಾರಿ ಜಾ಼ಲ್ಯಾತ.<verse eid="GAL 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GAL 5:25" />ಆಮಿ ಆತಮ್ಯಾಸಾರಾ ಜಿವ್ನಾ ಕರ್ತ್ಯಾವ್ ಮನ್ಹುನ್ ತ್ಯಚೆಗತ್ ಚಾ಼ಲುಯಾ. <verse eid="GAL 5:25" /><verse number="26" style="v" sid="GAL 5:26" />ಬಡಾಯಿ ಕರ್ನಾರ, ಯಕಾಮಕಾಲಾ ಚಿ಼ಡಿವ್ನಾರ, ಯಕಾಮಕಾವ ರಾಗ್‌ ಕರ್ತ್ಯಾಲ ವ್ಹಯಾಚೆ ಆಂದಿ ರಾಹುಯಾ.<verse eid="GAL 5:26" /></para>
  <chapter eid="GAL 5" />
  <chapter number="6" style="c" sid="GAL 6" />
  <para style="s">ಯಕಾ ಮಕಾಚ಼ ವಜ಼ ವಾಟುನ್ ಗೆವ್ಹಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1" />ಬನ್ಹಿ ಬಾವ್ಹಾನು, ತುಮ್ಚಾತ್ ಕೊನ್ತರಿ ಕಸ್‌ಲೆತರಿ ಚು಼ಕಿತ್ ಗಾವಲ್ಯಾಲಾ ಆಸ್ಲಾತ ತಸ್‌ಲ್ಯಾಲಾ ಆತಮ್ಯಾನಿ ಬರ್ಲ್ಯಾಲ ತುಮಿ ಥಂಡ್ಪನಾನಿ ಸಾಂಗುನ್ ಶಾರ್ಕಾ ಕರಾಯಾ ವ್ಹಯಿ, ಫನ್ ತುಮಿ ಪರೀಕ್ಷೆತ್ ಗಾವ್ಹುನಾಹಿ ಆಸ ತುಮ್ಚೆ ಗುಸ್ಟಿತ್ ಹುಶಾರ್ ರಾವ್ಹಾ. <verse eid="GAL 6:1" /><verse number="2" style="v" sid="GAL 6:2" />ತುಮಿ ಯಕಾಮಕಾಚ಼ ವಜ಼ ಉಚ್ಲು಼ನ್ ಗೆವಾ, ಆಸ ಕ್ರಿಸ್ತಾಚ಼ ನೇಮ್ ಪುರ್ತಿಕರಾ. <verse eid="GAL 6:2" /><verse number="3" style="v" sid="GAL 6:3" />ಕಾ ಮಂಜೆ ಕಚಾನಿ ತರಿ ಬಾರಿಕ್ ರಾಹುನ್ ಆಪ್ನು ಮೊಟಾ ಮನ್ಹುನ್ ಯವಜ಼್‌ಲ್ಯಾವ ಆಪ್‍ಲ್ಯಾಲಾಸ್ ಆಪ್ನು ಪಸಿವಲ್ಯಾಚೆಗತ್ ವ್ಹನಾರ್. <verse eid="GAL 6:3" /><verse number="4" style="v" sid="GAL 6:4" />ಪರ್ತೆಕಾನಿ ಆಪ್ನು ಕೇಲ್ಯಾಲ್ಯಾ ಕಾಮಾಚಿ ಪಾರಕ್ ಕರಾಯಾ ವ್ಹಯಿ. ತವಾ ತ್ಯೊ ಆಪ್‌ಲ್ಯಾಲಾ ಆಪ್ನುಸ್ ಮೊಟಾ ಮನ್ಹುನ್ ಗಿಹ್ಯಾವ್ಹಯಿಲ್ ಖರ ಆನಿಯಕಾ ಸಂಗ ಮಿಳುನ್ ಮೊಟಾ ವ್ಹಯಾ ವ್ಹಯಿ ಮನ್ಹುನ್ ನಾಹಿ. <verse eid="GAL 6:4" /><verse number="5" style="v" sid="GAL 6:5" />ಕಾ ಮಂಜೆ ಪರತೇಕಾನಿ ಆಪ್ಲ ವಜ಼ ಆಪ್ನುಸ್ ಗಿಹ್ಯಾವ್ಹಯಿ.<verse eid="GAL 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 6:6" />ಕ್ರಿಸ್ತಾಚಾ಼ ಸಂದೆಶ್ ಸಿಕ್ನಾರ‍್ಯಾನಿ, ತ್ಯ ಸಿಕಿವ್ನಾರ‍್ಯಾಲಾ ಆಪ್ಲಿಪ ಆಸ್‌ಲ್ಯಾಲ್ಯಾ ಸಗ್‍ಳ್ಯಾ ಚಾ಼ಂಗಲ್ಯಾತ್ ವಾಟ್ನಿ ದಿಯಾವ್ಹಯಿ.<verse eid="GAL 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 6:7" />ಪಸುನಕೊಸಾ. ದೇವಾಲಾ ನಿಂದಾ ಕರಾಯಾ ವ್ಹಯಿತ್ನಾಹಿ. ಮಾನುಸ್ ಆಪ್ನು ಕ್ಯಾ ಪೆರ್ತೊ ತ್ಯಸ್ ಕಾಪಾಯಾವ್ಹಯಿ. <verse eid="GAL 6:7" /><verse number="8" style="v" sid="GAL 6:8" />ಆಪ್‌ಲ್ಯಾ ಶರೀರಾಚಿ ಬಾವ್ನಾ ಪೆರ್ನಾರಾ ತೆ ಬಾವ್ನಾನಿಸ್ ಹಾಳ್‍ ವ್ಹನಾರ್. ಆತಮ್ಯಾಚೆ ಗುಸ್ಟಿತ್ ಪೆರ್ನಾರಾ ಆತಮ್ಯಾಪ್ನಿಸ್ ಶಾಶ್ವತ್ ಜೀವ್ ಗೆನ್ಹಾರ್. <verse eid="GAL 6:8" /><verse number="9" style="v" sid="GAL 6:9" />ಬರ ಕಾಮ್ ಕರಾಯಾ ಕಂಟಾಳಾ ಕರಾಚೆಆಂದಿ ರಾಹುಯಾ. ಕಾಮಂಜೆ ಮನಾತ್ ಬೆಜಾರ್ ನಸ್‌ಲ್ಯಾವ ಶಾರ್ಕ್ಯಾ ಯಳಾಲಾ ಪೀಕ್ ಗಾವ್ನಾರ್. <verse eid="GAL 6:9" /><verse number="10" style="v" sid="GAL 6:10" />ಮನ್ಹುನ್ ಯೊಳ್ ಗಾವಲ್ತವಾ ಸಗ್‌ಳ್ಯಾನಾ ಬರ ತ್ಯ ಕರುಯಾ, ಲ ಕರುನ್ ಯಕಾ ಗರ‍್ಹಾತ್ ಆಸ್‍ಲ್ಯಾಚೆಗತ್ ಆಸ್‌ಲ್ಯಾಲ್ಯಾ ಕ್ರಿಸ್ತ ಇಸ್ವಾಸಿನಾ ಕರುಯಾ.<verse eid="GAL 6:10" /></para>
  <para style="s">ಸರ್ತ್ಯಾ ಹುಶಾರ್ಕಿ ಆನಿ ನಮಸ್ಕಾರ್</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11" />ಹಬ, ಮಾಜಾ ಹಾತಾನಿಸ್ ಕ್ಯವ್ಡಿ ಮುಟಿ ಆಕ್ಷಾರ ತುಮಾನಾ ಲಿವ್‌ತ್ಯೊ! <verse eid="GAL 6:11" /><verse number="12" style="v" sid="GAL 6:12" />ಶರೀರಾಲಾ ಮರ‍್ಯಾದ್ ವ್ಹಯಿ ಮಂಥ್ಯಾಲ ಮುಂಜಿ ಕರುನ್ ಗಿಹುಂತ ಮನ್ಹುನ್ ತುಮನಾ ಜು಼ಲ್ಮಿ ಕರ್ತ್ಯಾತ ಕಾ ಮಂಜೆ ಕ್ರಿಸ್ತಾಚೆ ಸೇವೆಸ್ ಲಾಗುನ್ ತಿತಲ್ಯಾನಾ ಜಾ಼ಚ಼್ ವ್ಹಯಾ ನಕೊ ಮನ್ಹುನ್ ತ್ಯಂಚ಼ ಮನ್ಹ. <verse eid="GAL 6:12" /><verse number="13" style="v" sid="GAL 6:13" />ಮುಂಜಿ ಕರುನ್ ಗೆತ್ಯಾಲಸ್ ಧರ್ಮಶಾಸ್ತಾರಾಚೆಗತ್ ಚಾ಼ಲತ್ ನಾಹಿತ. ತೇ ಆಪ್ಲೆ ಸಿಲುಬೆಚೆ ಗುಶ್ಟಿತ್ ಮೊಟ ಮನ್ಹುನ್ ಗಿಹ್ಯಾ ತುಮಾನಾ ಮುಂಜಿ ವ್ಹಯಾ ವ್ಹಯಿ ಮನ್ಹುನ್ ಮನ್ ಕರ್ತ್ಯಾತ. <verse eid="GAL 6:13" /><verse number="14" style="v" sid="GAL 6:14" />ಮನಾ ತರಿ ಆಮ್ಚಾ ಪ್ರಭು ಯೇಸು ಕ್ರಿಸ್ತಾಚೆ ಶಿಲುಬೆಚಿ ಗುಶ್ಟಿತ್ ಮನ್ಹುನ್ ದುಸ್‌ರ‍್ಯಾ ಕಸ್ಯಾತ್ ಮೊಟ ಮನ್ಹುನ್ ಗಿಹ್ಯಾಚ಼ ನಕೊ ಮನ್ಹುನ್ ಮಿ ದುನೆಲಾ, ಆನಿ ದನಿಯಾ ಮಾಜಿಸಾಟಿ ಶಿಲ್ಬೆವ ಮೇಲೆ. <verse eid="GAL 6:14" /><verse number="15" style="v" sid="GAL 6:15" />ಮುಂಜಿ ಕರುನ್ ಗಿಹ್ಯಾಚಿ ಕ್ಯಾ ನಾಹಿ ಕರುನ್ ಗಿಹ್ಯಾಚಿ ಮುಖ್ಯ ನವ್ಹ ನವಿನಿ ಉತ್ಪನ್ ವ್ಹಯಾಚ಼ಸ್ ಮುಖ್ಯ ಜಾ಼ಲ್ಯಾ. <verse eid="GAL 6:15" /><verse number="16" style="v" sid="GAL 6:16" />ಹ್ಯಾ ನೇಮಾಶಾರ್ಕ ಚಾ಼ಲತ್ಯಾಲ್ಯಾ ಸಗ್‌ಳ್ಯಾನಾ ಆನಿ ದೇವಾಚಾ ಇಸ್ರಾಯಲ್ ಲೊಕಾನಾ ಥಂಡ್ಪನ್, ಕರುನಾ ಗಾಹುನಿ.<verse eid="GAL 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 6:17" />ಹಿತ್ನಿ ಮೊರ‍್ಹ ಕುನಿ ಮನಾ ತರಾಸ್ ಕರುನಾಹಿ, ಮಾಜಾ ಶರಿರಾವ ಯೇಸು ಕ್ರಿಸ್ತಾಚಿ ವಳಕ್ ಕರುನ್ಗೆತ್ಲೆ. <verse eid="GAL 6:17" /><verse number="18" style="v" sid="GAL 6:18" />ಬನ್ಹಿ ಬಾವ್ಹಾನು, ಆಮ್ಚಾ ಯೇಸು ಕ್ರಿಸ್ತಾಚಿ ಕ್ರಪಾ ತುಮ್ಚಾ ಆತ್ಮಾ ಸಂಗ ರಾವ್ಹುನಿ. ತಸಸ್ ವ್ಹವುನಿ.<verse eid="GAL 6:18" /></para>
  <para style="p" />
  <chapter eid="GAL 6" />
</usx>