<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="OBA" style="id">- Gowli</book>
  <para style="h">ಒಬ</para>
  <para style="toc1">ಒಬದ್ಯಾ</para>
  <para style="toc2">ಒಬದ್ಯಾ</para>
  <para style="toc3">ಒಬದ್ಯಾ</para>
  <para style="mt1">ಒಬದ್ಯಾನಿ ಲಿವಲ್ಯಾಲ ಪುಸ್ತಕ್</para>
  <para style="mt2">ಒಬದ್ಯಾನಿ ಲಿವಲ್ಯಾಲ ಪುಸ್ತಕ್</para>
  <para style="imt">ವಳಕ್</para>
  <para style="ip">ಹ್ಯಾ ಪುಸ್ತಕಾತ್ ಒಬದ್ಯಾಚ಼ ಪ್ರವಾದನೆ ಹಾತ. ಒಬದ್ಯಾಚ಼ ಸಂದೆಸ್ ಏಸಾವಾಚಾ ವಂಸಾಜಾ಼ಲ್ಯಾಲ್ಯಾ ಏದೊಮಿಚಾ ಲೊಕಾಂಚೆ ಆಡ್ವಾ ತಿರ್ಮಾನ್ ಸಾಂಗ್ತ. ಒಬದ್ಯಚ಼ ಪುಸ್ತಕ್ ಕವಾ ಲಿವ್ಲ ಮನ್ಹುನ್ ಶಾನ್ಯಾನಾ ಶಾರ್ಕ ಠಾವನಾಹಿ. ಹ್ಯ ಬಾಬಿಲೊನ್ ಯೆರೊಸಲೆಮಿಲಾ ಆಕ್ರಮನ್ ಕೆಲ್ಯಾಲ್ಯಾ ಯಳಾಲಾ ಆಸಲ್. ಮಂಜೆ ತವಾ ಎದೊಮಿತಲ್ಯಾಂಚಾನಿ ಇಸ್ರಾಯೆಲಾನಾ ಮಾರುನ್ ಟ್ಯಾಕ್ಲ ನಾಹಿ. ಹ್ಯ ಖರ ಆಸ್ಲತ ಕ್ರಿ.ಪೂ ಸಾಸೆಚಾ ಆಜು಼ಬಾಜು಼ ಲಿವ್ಲ ಆಸಲ್. ಒಬದ್ಯಾನಿ ಆಂದಿ ನಿಸ್ತಾ ಎದೊಮಿಚೆ ಆಡ್ವಾ ತಿರ್ಮಾನ್ ಸಾಂಗ್ತೊ. ಖರ ಪಂದ್ರಾವ್ಯಾ ವಚನಾತ್ ಸಗಳ್ಯಾ ಲೊಕಾಂಚಿವ ಹ್ಯೊ ತಿರ್ಮಾನ್ ಗ್ಯಾಲ್ತೊ. ಸರ್ತಾನಾ, ಒಬದ್ಯಾ ಯಂಗ್ದಾ ಇಸ್ರಾಯೆಲಾಚಿ ಕ್ಯೊಂಡಲ್ಯಾಲಿ ಮಾಗಾರಿ ಯವುನ್ ಆಪ್ಲಿ ಜಿಮಿನ್ ಪರ್ತುನ್ ಗೆನ್ಹಾರ್ ಮನ್ಹುನ್ ಸಾಂಗ್ತೊ.</para>
  <para style="iot">ಭಾಗ್</para>
  <para style="io1">ಯಕಾಸ್ನಿ ಚ಼ವ್ದಾ ವಚ಼ನಾತ್ ಎದೊಮಿವ ತಿರ್ಮಾನ್ ಸಾಂಗಲ್ಯಾಲ.</para>
  <para style="io1">ಪಂದ್ರಾಸ್ನಿ ಇಸಾವ ಏಕ್ ವಚ಼ನ್ ಸಗ್ಳಿ ಲೊಕ ಆಪ್ಲೆ ಗಮ್ಹೆಂಡಿನಿ ತಿರ್ಮಾನ್ ಗೆನ್ಹಾರ್ ಆನಿ ಇಸ್ರಾಯೆಲಾತ್ಲಿ ಕ್ಯೊಂಡಲ್ಯಾಲಿ ಪರ್ತುನ್ ಯವುನ್ ಆಪ್ಲಿ ಜಿಮಿನ್ ತಾಬ್ಯಾತ್ ಗೆನ್ಹಾರ್, ತ್ಯವ್ಡಸನವ್ಹ ಎದೊಮಿಚಾ ದೆಶಾವ ಆದಿಕಾರ್ ಚಾ಼ಲಿವ್ನಾರ್ ಮನ್ಹುನ್ ಸಾಂಗತ್ಯಾತ.</para>
  <chapter number="1" style="c" sid="OBA 1" />
  <para style="p">
    <verse number="1" style="v" sid="OBA 1:1" />ಓಬದ್ಯಾಲಾ ಜಾ಼ಲ್ಯಾಲ ದೆವಾಚ಼ ದರ್ಶಾನ್: ಎದೊಮ್ ರಾಸಟ್ರಾಚೆ ಗುಶ್ಟಿತ್ ಸ್ವಾಮಿ ಪರಮೆಸ್ವರ್ ಆಸಾ ಮಂಥ್ಯೊ:</para>
  <para style="s" vid="OBA 1:1">ಪರಮೆಸ್ವರಾನಿ ಎದೊಮಾವ ಶಿಕ್ಶೆ ದಿಲ್ಯಾಲಿ</para>
  <para style="p" vid="OBA 1:1">“ತೆ ಆಪಲ್ಯಾ ದುತಾ ಸಂಗ ಪರಮೆಸ್ವರ್ ದೆಸೆತ್ನಿ ಲಾವುಂದೆತೊ. ತ್ಯಂಚಿಪ್ನಿ ಆಲ್ಯಾಲಾ ಸಮಾಚಾರ್ ಆಮಿ ಐಕಲ್ಯಾ ಚ಼ಲಾ, ಎದೊಮಿಚಾ ರಾಸಟ್ರಾವ ಲಡಾಯಿ” ಕರಾಲಾ<verse eid="OBA 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="OBA 1:2" />"ಎದೊಮೆ, ಬಗ್,</para>
  <para style="q2" vid="OBA 1:2">ದೆಸೆತ್ನಿ ತುಲಾ ಯಗ್ದಮ್ ಗಾಳ್ ಕರ್ನಾರ್;</para>
  <para style="q2" vid="OBA 1:2">ತು ಖುಬ್ ನಕ್ವಾಟ್ಲೆಸ್.<verse eid="OBA 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="OBA 1:3" />ತುಜೆ ಗಮ್ಮೆಂಡಿನಿ ತುಲಾ ನಾಸಿವ್ಲೆ.</para>
  <para style="q1" vid="OBA 1:3">ವೈಲ್ಯಾ ಸ್ತಾನಾತ್ ಹಾಸ್;</para>
  <para style="q2" vid="OBA 1:3">ದೊಂಢ್ಯಾಂಚೆ ಚಿರತ್ನಿ ಬದ್ರತಿ ಹಾಸ್,</para>
  <para style="q2" vid="OBA 1:3">‘ಮನಾ ಜಿಮ್ನಿವ</para>
  <para style="q2" vid="OBA 1:3">ಉತರ್ನಾರಾ ಕೊನ್?’ ಮಂಥೊಸ್.<verse eid="OBA 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="OBA 1:4" />“ತು ಘಾರ್ ತಳಾಪ್ತಿ</para>
  <para style="q2" vid="OBA 1:4">ತ್ಯವ್ಡಿ ವರ್ ತಳಾಪ್ಲಿಸ್ತರಿ,</para>
  <para style="q2" vid="OBA 1:4">ಚಾನ್ಯಾಂಚಾ ಡಿಗಾತ್ ರಾಯ್ಲತರಿ,</para>
  <para style="q1" vid="OBA 1:4">ತಿತ್ನಿಬಿ ತುಲಾ ಉತ್ರುನ್ ಶೊಡ್ನಾರ್, ಪರಮೆಸ್ವರ್ ಮಂಥೊ.<verse eid="OBA 1:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="OBA 1:5" />“ತುಜಿಪ ಚ್ವಾ಼ರ್,</para>
  <para style="q2" vid="OBA 1:5">ನಾಹಿತ ರ‍್ಯಾಚ಼ ಲುಟ್ಯಾರ</para>
  <para style="q1" vid="OBA 1:5">ಆಲ್ಯಾವ ತೆ ಆಪಲ್ಯಾಲಾ</para>
  <para style="q2" vid="OBA 1:5">ವ್ಹಯಿ ಜಾ಼ಲ್ಯಾಲ ತೆವ್ಡಸ್</para>
  <para style="q1" vid="OBA 1:5">ಗಿಹುನ್ ಗೆಲಾಸ್ತನವ್ಹ?<verse eid="OBA 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="OBA 1:6" />ಫನ್ ಏಸಾವಾಚಾ಼ ಖಜಿನಾ ಸಗ್ಳಾ ಲುಟಲ್ಯಾ.<verse eid="OBA 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="OBA 1:7" />ತುಜ಼ ಸೊಪ್ತಿ ತುಜೆ ಪಾಟಿ ಲಾಗಲ್ಯಾತ;</para>
  <para style="q2" vid="OBA 1:7">ತುಲಾ ಸಿಮಚೆ ಬಾಹಿರ್ ಟ್ಯಾಕಲ್ಯಾ.</para>
  <para style="q1" vid="OBA 1:7">ತುಜೆ ಮಾಯೆತಲ್ಯಾಂಚಾನಿ ತುಲಾ ಫಸ್ವುನ್ ಹಾರಿವಲ್ಯಾ.</para>
  <para style="q2" vid="OBA 1:7">ತುಜ಼ ‘ಆನ್ ಖಾಲ್ಯಾಲ್ಯಾಂಚಾನಿಸ್ ಸಮಜ಼ತ್ ನಸ್ತಾನಾ ತುಲಾ ಫಾಸಿದಿಲ್ಯಾ.’<verse eid="OBA 1:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="OBA 1:8" />ಸರವೆಸ್ವರ ಆಸಾ ಮಂಥ್ಯೊ:</para>
  <para style="q2" vid="OBA 1:8">“ತ್ಯಾ ದಿಸಾತ್ ಎದೊಮಿಚಾ ಶಾನ್ಯಾನಾ ಎಸಾವಾಚಾ ಗುಡ್ಯಾತಲ್ಯಾ ಬುದ್ದಿ ಆಸಲ್ಯಾಲ್ಯಾ ಜಿವಿನಾ</para>
  <para style="q2" vid="OBA 1:8">ಮಿ ನಾಸ್ ಕರಾಚೆ ಆಂದಿ ಶೊಡ್ನಾರ್ ಕ್ಯಾ?<verse eid="OBA 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="OBA 1:9" />ತೇಮಾನ್ ಮುಲ್ಕಾತಲ್ಯಾನು, ತುಜ಼ ಸಮರ್ಥಶಾಲಿ ಮಾನುಸ್ ಬಿತ್ತಿಲ;</para>
  <para style="q2" vid="OBA 1:9">ಎಸಾವಾಚಾ ಪರ್ವತಾವ ಸಗಳ್ಯಾಂಚಾ಼ ನಾಸ್ ವ್ಹನಾರ್.<verse eid="OBA 1:9" /></para>
  <para style="s">ಎದೊಮಾಚೆ ಸಿಕ್ಶೆಲಾ ಕಾರ‍್ನ</para>
  <para style="p">
    <verse number="10" style="v" sid="OBA 1:10" />ತುಜಾ಼ ಬಾಹು ಯಾಕೋಬಾಚೆ ಆಡ್ವಿ ಕೆಲ್ಯಾಲಿ ಬೆಜಾರಾಚಾ ಕಾಮಾಂಚೆಸಾಟಿ,</para>
  <para style="q2" vid="OBA 1:10">ತುಲಾ ಅವಮಾನ್ ವ್ಹಯಿಲ್.</para>
  <para style="q2" vid="OBA 1:10">ಶಾಸ್ವಿತ್ ನಾಸಾತ್ ಪಡ್ಶಿಲ್.<verse eid="OBA 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="OBA 1:11" />ತುಜಾ ಬಾವ್ಹಾಚ಼ ಧನ್ ಲುಟ್ಯಾರಲ್ಯಾಲ್ಯಾ ದಿಸಾತ್</para>
  <para style="q2" vid="OBA 1:11">ತು ಗಪ್ ಬಗಿತ್ ರಾಯ್ಲಾಸ್.</para>
  <para style="q1" vid="OBA 1:11">ಪರದೆಶೆತ್ಲ ತೆಚೆ ಸಿಮತ್ನಿ ದಾರಾಚೆ ಆತ್ ಆಲ</para>
  <para style="q2" vid="OBA 1:11">ತವಾ ಯೆರುಸಲೆಮಿಚಾ ಖಜಿನ್ಯಾಸಾಟಿ ಚಿಟಿ ಗ್ಯಾತ್ಲಿ</para>
  <para style="q2" vid="OBA 1:11">ತವಾ ತು ತೆಂಚಿಗತುಸ್ ಹುತ್ತಾಸ್.<verse eid="OBA 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="OBA 1:12" />ತುಜಾ಼ ಬಾವ್ಹಾಚಾ ಸಂಕಟಾಚಾ ದಿಸಾತ್,</para>
  <para style="q2" vid="OBA 1:12">ತೆಂಚಾ ತರಾಸಾಚಾ ದಿಸಾತ್</para>
  <para style="q1" vid="OBA 1:12">ತು ಗಪ್ ಬಗಿತ್ ಉಬರಾಹ್ಯಾಚ಼ ನವ್ಹ.</para>
  <para style="q2" vid="OBA 1:12">ಯಹುದಾಂಚಾ ಸಂಕಟಾಚಾ ದಿಸಾತ್</para>
  <para style="q1" vid="OBA 1:12">ಆನಂದ್ ವ್ಹಯಾನಕೊ ಜಾ಼ಲ್ತಾಸ್.</para>
  <para style="q2" vid="OBA 1:12">ಸಂಕಟಾತ್ ತು ಬಡಾಯಿ ಕರಾನಕೊಹುತ್ತಿಸ್.<verse eid="OBA 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="OBA 1:13" />ಮಾಜಿ ಲೊಕ ತರಾಸಾತ್ ಆಸ್ತಾನಾ</para>
  <para style="q2" vid="OBA 1:13">ತು ತೆಂಚೆ ಯಸಿತ್ನಿ ಆತ್ ಯಯಾನಕೊಜಾ಼ಲ್ತಸ್.</para>
  <para style="q2" vid="OBA 1:13">ತ್ಯಂಚಾ ಖಜಿನ್ಯಾಲಾ ಹಾತ್</para>
  <para style="q2" vid="OBA 1:13">ಗಾಲಾಯಾ ನಕೊ ಜಾ಼ಲ್ತಾಸ್.<verse eid="OBA 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="OBA 1:14" />ಚು಼ಕ್ವುನ್ ಪಳುನ್ ಜಾ಼ತ್ಯಾಲ್ಯಾ ತ್ಯನಾ ಮಾರಾಯಾ</para>
  <para style="q2" vid="OBA 1:14">ವಾಟಾ ಮಿಳಾಲ್ಯಾಲೆ ಕತ್ರಿವ ಉಬರಾಹುನಾಹಿ ಜಾ಼ಲ್ತಸ್.</para>
  <para style="q1" vid="OBA 1:14">ಕಸ್ಟಾಚೆ ಪರಸ್ಥಿತಿತ್ ಚು಼ಕ್ವುನ್ ಗೆಲ್ಯಾಲ್ಯಾನಾ</para>
  <para style="q2" vid="OBA 1:14">ವೈರಿಂಚಾ ಹಾತಾತ್ ದಿಯಾಚ಼ ನವ್ಹಸ್.<verse eid="OBA 1:14" /></para>
  <para style="s">ದೆವ್ ದೆಸೆತಲ್ಯಾಂಚ಼ ನ್ಯಾಯಿ ಕರಿಲ್</para>
  <para style="q1">
    <verse number="15" style="v" sid="OBA 1:15" />"ಸಗಳ್ಯಾ ದೆಸೆತ್ನಿಬಿ</para>
  <para style="q2" vid="OBA 1:15">ಪರಮೆಸ್ವರಾಚಾ಼ ದಿಸ್ ಜ಼ವಳ್ ಆಲ್ಯಾ.</para>
  <para style="q1" vid="OBA 1:15">ತು ಕೆಲ್ಯಾಲಸ್ ತುಲಾ ಕರ್ನಾರ್.</para>
  <para style="q2" vid="OBA 1:15">ತುಜಿ ದುಶ್ಕರ್ಮ ತುಜೆ ಡುಯಿವ ಯನಾರ್.<verse eid="OBA 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="OBA 1:16" />ಲೊಕಾನು, ಪವಿತ್ರ ಪರ್ವತಾವ</para>
  <para style="q2" vid="OBA 1:16">ವರ್ ಮಾಜೆ ಸಿಕ್ಶೆಲಾ ಪಿವುನ್.</para>
  <para style="q1" vid="OBA 1:16">ತಸಸ್ ದುಸ್ರಿ ರಾಸಟ್ರ ಪಿವುನ್.</para>
  <para style="q2" vid="OBA 1:16">ವ್ಹಯ್, ಆನಿ ಆನಿಕ್ ಪಿವುನ್ ಜೆಲ್ಪಾಟ್ನಾರ್;</para>
  <para style="q2" vid="OBA 1:16">ಸರತ್ಯಾ ಯಳಾಲಾ ನಾಹಿವ್ಹನಾರ್.<verse eid="OBA 1:16" /></para>
  <para style="s">ಇಸ್ರಾಯೆಲಾಂಚ಼ ಜಿತ್</para>
  <para style="q1">
    <verse number="17" style="v" sid="OBA 1:17" />“ಫನ್ ಚು಼ಕವುನ್ ಗೆತಲ್ಯಾಲ</para>
  <para style="q2" vid="OBA 1:17">ಚಿಯೊನ್ ಪರ್ವತಾವ ರಾನ್ಹಾರ್.</para>
  <para style="q1" vid="OBA 1:17">ತ್ಯ ಪವಿತ್ರ ಜಾ಼ಗಾ ಮನ್ಹೂನ್ ಗೆನ್ಹಾರ್;</para>
  <para style="q2" vid="OBA 1:17">ಯಾಕೊಬಾಚಾ ವಂಶಾತ್ಲ ಆಪ್ಲಿ ಸ್ವತಾಚಿ ಆಸ್ತಿ ಪರ್ತುನ್ ಅನ್ಬವಸ್ನಾರ್.<verse eid="OBA 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="OBA 1:18" />ಯಾಕೊಬಾಚಾ಼ ವಂಸಾ ಆಗ್ನಿಚೆಗತ್; ಯೊಸೆಪಾಚಾ಼ ವಂಸಾ ಜ಼ಳ್ಹಿಚೆಗತ್;</para>
  <para style="q2" vid="OBA 1:18">ಹೆ ದುನಿ ಮಿಳುನ್ ಸಡಾಂಚೆಗತ್ ಆಸಲ್ಯಾಲ್ಯಾ</para>
  <para style="q2" vid="OBA 1:18">ಎಸಾವಾಚಾ ವಂಶಾಲಾ ದಗ್ದಗುನ್ ಜಾ಼ಳುನ್ ಬಸ್ಮಾ ಕರ್ನಾರ್.</para>
  <para style="q2" vid="OBA 1:18">ಎಸಾವಾಚಾ ವಂಶಾತ್ ಕೊನ್ ಉರ್ನಾರ್ನಾಹಿ.</para>
  <para style="q1" vid="OBA 1:18">“ಹ್ಯೊ ಪರಮೆಸ್ವರ್ ದೆವಾಚಾ಼ ಸಬ್ದ.<verse eid="OBA 1:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="OBA 1:19" />ತವಾ ನೆಗೆವಾತ್ಲಿ ಲೊಕ ಏಸಾವಾಚಾ಼ ಪರ್ವತ ಆಪಲ್ಯಾ ತಾಬ್ಯಾತ್ ಗೆನ್ಹಾರ್.</para>
  <para style="q2" vid="OBA 1:19">ಶೆಫೆಲ್ ಸಿಮತ್ಲಿ ಪಿಲಿಸ್ಟಿ ಆಪಲ್ಯಾ ತಾಬ್ಯಾತ್ ಗೆನ್ಹಾರ್.</para>
  <para style="q1" vid="OBA 1:19">ಇಸ್ರಾಯಲಾಂಚಿ ಎಪ್ರಾಯಮ್ ಆನಿ ಸಮಾರ‍್ಯಾಚಿ ಜಿಮಿನ್ ಆಪಲ್ಯಾ ತಾಬ್ಯಾತ್ ಗೆನ್ಹಾರ್.</para>
  <para style="q2" vid="OBA 1:19">ಬೆನ್ಯಾಮಿಚಾ ವಂಶಾತ್ಲ ಗಿಲ್ಯಾದ್ ಆಪಲ್ಯಾ ತಾಬ್ಯಾತ್ ಗೆನ್ಹಾರ್.<verse eid="OBA 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="OBA 1:20" />ಕ್ಯೊಂಡಲ್ಯಾಲಾ ಇಸ್ರಾಯಲಾಚ಼ ಸೈನಿ ಕಾನಾನ್</para>
  <para style="q2" vid="OBA 1:20">ಪರದೆಸ್ ಚಾರೆಪತ್ತಿಪರ‍್ಯಾತ್ ಆಪಲ್ಯಾ ತಾಬ್ಯಾತ್ ಗೆನ್ಹಾರ್.</para>
  <para style="q1" vid="OBA 1:20">ಶೆಪ್ಹಾರ ಮಂಥ್ಯಾಲಾ ಕ್ಯೊಂಡಲ್ಯಾಲ</para>
  <para style="q2" vid="OBA 1:20">ಎರೊಸಲೆಮಿತ್ಲ ನೆಗೆವಾತ್ಲಿ ಶೆರ ಆಪಲ್ಯಾ ತಾಬ್ಯಾತ್ ಗೆನ್ಹಾರ್.<verse eid="OBA 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="OBA 1:21" />ಸೂಡಿವ್ನಾರಾ ಎಸಾವಾಚಾ಼ ಪರ್ವತ್ ತಾಬ್ಯಾತ್ ಗಿಯ್ಯಾ</para>
  <para style="q2" vid="OBA 1:21">ಚಿಯೊನ್ ಪರ್ವತಾವ ಚ಼ಡ್ನಾರ್.</para>
  <para style="q1" vid="OBA 1:21">ತವಾ ರಾಜ಼್ಭಾರ್ ಪರಮೆಸ್ವರ್ ದೆವಾಚಾ಼ ವನ್ಹಾರ್.”<verse eid="OBA 1:21" /></para>
  <chapter eid="OBA 1" />
</usx>