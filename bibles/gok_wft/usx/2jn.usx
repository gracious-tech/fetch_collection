<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2JN" style="id">- Gawli Marathi</book>
  <para style="h">ಯೊಹಾನಾನಿ ಲಿವ್‌ಲ್ಯಾಲಿ ದೊನ್ವಿ ಪತ್ರಿಕೆ</para>
  <para style="toc3">2 ಯೊಹಾನ್</para>
  <para style="toc2">2 ಯೊಹಾನ್</para>
  <para style="toc1">ಯೊಹಾನಾನಿ ಲಿವ್‌ಲ್ಯಾಲ ದೊನ್ವ ಪತ್ರ</para>
  <para style="mt2">ಯೊಹಾನನು ಬರೆದ ಎರಡನೆ ಪತ್ರ</para>
  <para style="mt1">ಯೊಹಾನಾನಿ ಲಿವ್‌ಲ್ಯಾಲ ದೊನ್ವ ಪತ್ರ</para>
  <para style="imt">ವಳಕ್</para>
  <para style="ip">ಯೊಹಾನಾನಿ ಲಿವಲ್ಯಾಲ ದೊನ್ವಪತ್ರ ಅಪೊಸ್ತಲ ಜಾ಼ಲ್ಯಾಲಾ ಯೊಹಾನ್ ಕ್ರಿಸ್ತ ಜ಼ಲಾಮಲ್ಯಾವ ಪನ್ನಾಸಾಸ್ನಿ ಶಂಬರ್ ವರ್ಸಾಂಚೆ ಮದಿ ಲಿವಲ್ಯಾ ಯೊಹಾನಾನಿ ಆಪ್ನಿಸ್ ಲಿವಲ್ಯಾ ಮನ್ಹುನ್ ದಾವುನ್ ದಿಲ್ಯಾಲ ನಾಹಿ, ಹ್ಯಚೆ ಬದ್ಲಿಸ್ ತ್ಯೊ ಆಪ್ನಿ ಯೊಕ್ ಜಾಂತಾ ಆಸಾ ಬುಲುನ್ ಗೆಥೊ<char style="xt"><ref loc="2JN 1:1">1:1</ref></char> ಯೊಹಾನಾಚಾ ದೊನವ್ಯಾ ಪತ್‍ರ್ಯಾತ್ ಯೊಹಾನಾನಿ ಲಿವಲ್ಯಾಲೆ ಬರೆ ಖಬರಿತ್ ದಿಸುನ್ ಯತ್ಯಾಲೆ ಗುಸ್ಟಿತ್ ಖುಬ್ ಜ಼ವಳ್ ದಿಸುನ್ ಯತ.ಲತ್ಯ ಹ್ಯ ಯಕಾಮಕಾಚಿ ಮಾಯಾ ಕರಾ ಮಂತ್ಯಾಲೆ ಯೆಸುಬಿ ಆಪಲ್ಯಾ ಹುಕಮಾ ಶಾರ್ಕಾ ಚಾ಼ಲಾ ಮಂತ್ಯಾಲೆ ಗುಸ್ಟಿಂಚಾ಼ ವಿವರನ್ ಕರತ್ಯಾಚೆಗತ್ ದಿಸುನ್ ಯತ <char style="xt"><ref loc="2JN 1:5-6">1:5-6</ref>,</char><char style="xt"><ref loc="JHN 15:1-9">ಯೋಹಾನ್ 15:1-9</ref></char> ಯೊಹಾನಾನಿ ಲಿವಲ್ಯಾಲಿ ಬರಿ ಖಬರ್ ಆನಿ ತ್ಯಚಿ ತಿನ್ ಪತ್ರಿ 1, 2, ಯೊಹಾನ್ ತ್ಯೊ ಎಪೆಸಾತ್ ಆಸ್ತಾನಾ ಯೊಹಾನಾನಿಸ್ ಲಿವಲ್ಯಾ ಆಸಾ ಇಸ್ವಾಸ್ ಹುತಾ.</para>
  <para style="ip">ಯೊಹಾನಾನಿ ಹ್ಯ ಪತ್ರ ನಿವಡಲ್ಯಾಲಿ ಬಾಯಿಲ್ಮಾನುಸ್ ಆನಿ ತಿಚಾ ಪೊರಾಂಚಾ ಉದೆಸಾನಿ ಲಿವಲ್ಯಾ.ತ್ಯನಿ ಹ್ಯ ಯಕಾ ತಂಡ್ಯಾಲಾ ಲಿವಲ್ಯಾ. ಲಬಾಡ ಸಿಕಿವತ್ಯಾಲ್ಯಾ ತಂಡ್ಯಾಚೆ ಗುಸ್ಟಿತ್ ಉಮೆದ ದಿಯಾಚಾ ಉದೆಶಾನಿ ಯೊಹಾನಾನಿ ಹ್ಯ ಪತ್ರ ಲಿವಲ್ಯಾ.</para>
  <para style="iot">ಭಾಗ್</para>
  <para style="io1">1. ಯೊಹಾನ್ ವಾಚಿವತ್ಯಾಲ್ಯಾನಾ ನಮಸ್ಕಾರ್ ಕರಿತ್ ಆನಿ ಕುನಾಸಾಟಿ ಲಿವಲ್ಯಾ ಮನಹುನ್ ಸಾಂಗಿತ್ ಪತರ‍್ಯಾಚಿ ವಳಕ್ ಕರುನ್ ದೆತೊ<char style="ior"><ref loc="2JN 1:1-3">1:1-3</ref> </char></para>
  <para style="io1">2. ಮಂಗ್ ತ್ಯೊ ತಂಡ್ಯಾಲಾ ಉಮೆದ್ ದೆತೊ ಆನಿ ಲ ಕಿಮ್ತಿಚಾ಼ ಹುಕುಮ್ ತ್ಯನಾ ಯಾದ್ ಕರುನ್ ದೆತೊ <char style="ior"><ref loc="2JN 1:4-6">1:4-6</ref> </char></para>
  <para style="io1">3. ಮಂಗ್ ತ್ಯೊ ಲಬಾಡ್ ಸಿಕಿವನಾರ‍್ಯಾಂಚೆ ಆಡ್ವ ತ್ಯನಾ ಶಾನತ್ ದೆತೊ <char style="ior"><ref loc="2JN 1:7-11">1:7-11</ref> </char></para>
  <para style="io1">4. ಯೊಹಾನ್ ಆಪ್ನಿ ಜಿವ್ನಾ ಕರ್ತ್ಯಾಲ್ಯಾ ಜಾ಼ಗ್ಯಾವಲ್ಯಾ ಇಸ್ವಾಸಿ ಲೊಕಾನಾ ನಮಸ್ಕಾರ್ ಸಾಂಗಿತ್ ಪತ್ರ ಸಪಿವತೊ<char style="ior"><ref loc="2JN 1:12-13">1:12-13</ref> </char></para>
  <chapter number="1" style="c" sid="2JN 1"/>
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1"/>ಸಬೆಚಾ಼ ಜಾಂತಾ ಜಾ಼ಲ್ಯಾಲಾ ಮಿ, ದೇವಾನಿ ನಿವಡ್‌ಲ್ಯಾಲ್ಯಾ ಆಯಿಸನಾ ಆನಿ ತಿಂಚಾ ಪೊರಾನಾ ಲಿವಾಚ಼ ಕ್ಯಾ ಮಂಜೆ; <verse eid="2JN 1:1"/><verse number="2" style="v" sid="2JN 1:2"/>ತುಮ್ಚಿಪ ಆಸ್‌ಲ್ಯಾಲ ಆನಿ ಖಾಯಿಮ್ ಆಮ್ಚಿ ಸಂಗ ಆಸ್‌ಲ್ಯಾಲ್ಯಾ ಖರ‍್ಯಾಸ್ ಲಾಗುನ್, ಮಿ ತುಮಾನಾ ಖರ‍್ಯಾನಿ ಮಾಯಾ ಕರ್ತೊ. ಮಿ ತ್ಯವ್ಡಾಸ್‌ನವ್ಹ, ಖರ‍್ಯಾಚಿ ಮಾಯಾ ಕರ್ತ್ಯಾಲಿ ಸಗ್ಳಿ ತುಮಾನಾ ಮಾಯಾ ಕರ್ತ್ಯಾತ.<verse eid="2JN 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2JN 1:3"/>ಬಾ ದೇವಾಪ್ನಿ, ದೇವಾಚಾ಼ ಲ್ಯೊಕ್ ಜಾ಼ಲ್ಯಾಲ್ಯಾ ಯೇಸು ಕ್ರಿಸ್ತಾಪ್ನಿ, ಕ್ರಪಾ, ದಯಾ, ಥಂಡ್ಪನ್, ಖರ, ಮಾಯಾ ಖಾಯಿಮ್ ಆಮ್ಚಿ ಸಂಗ ರಾವ್ಹುನಿ.<verse eid="2JN 1:3"/></para>
  <para style="s">ಖರ ಆನಿ ಮಾಯಾ</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4"/>ಬಾಪ್ನಿ ಆಮಿ ಗೆತಲ್ಯಾಲೆ ಆಜ್ಞೆ ಶಾರ್ಕ, ತುಮ್ಚಾ ಪೊರಾತ್ನಿ ಥುಡಿ, ಖರ‍್ಯಾನಿ ಚಾ಼ಲತ್ಯಾಲಿ ಬಗುನ್ ಮಿ ಖುಬ್ ಸಂತೊಸ್ ಜಾ಼ಲಾ. <verse eid="2JN 1:4"/><verse number="5" style="v" sid="2JN 1:5"/>ಐಸಾನು, ಮಿ ನವಿ ಆಜ್ಞೆ ತುಮಾನಾ ಲಿವಿತ್ನಾಹಿ, ಆಂದಿ ದರ್ನಿ ಆಮಾನಾ ಆಸ್‌ಲ್ಯಾಲಿ ಆಜ್ಞೆ ತುಮಾನಾ ಲಿವ್ನಾರಾ ವ್ಹವುನ್; ಆಮಿ ಯಕಾ ಮಕಾಚಿ ಮಾಯಾ ಕರುಯಾ ಮನ್ಲಾ. <verse eid="2JN 1:5"/><verse number="6" style="v" sid="2JN 1:6"/>ದೇವಾಚೆ ಆಜ್ಞಾಂಚೆಗತ್ ವಾಗಾಚ಼ಸ್ ಮಾಯಾ ಜಾಲೆ. ಮಾಯೆನಿ ಚಾ಼ಲಾಯಾವ್ಹಯಿ ಮಂತ್ಯಾಲಿಸ್ ತುಮಿ ಪೈಲೆ ದರ್ನಿ ಐಕ್‌ಲ್ಯಾಲಿ ಆಜ್ಞೆ ಜಾಲೆ.<verse eid="2JN 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7"/>ಕಾ ಮಂಜೆ, ಯೇಸು ಕ್ರಿಸ್ತ ಮಾನುಸ್ ವ್ಹವುನ್ ಆಲಾ ಮನ್ಹುನ್ ಹುಮನಾಚೆ ಆಂದಿ ಆಸ್‌ಲ್ಯಾಲಿ ಖುಬ್ ಗಾತ್ ಕರ್ನಾರ ಲೊಕಾತ್ನಿ ನಿಗುನ್ ಆಲ್ಯಾತ. ಆಸ್ಲಸ್, ಯೇಸುಲಾ ಮಾನಿತ್ ನಸಲ್ಯಾಲ ಗತ್ ಕರೀತ್, ಕ್ರಿಸ್ತಾಚ಼ ವಾದಿ ಜಾ಼ಲ್ಯಾತ. <verse eid="2JN 1:7"/><verse number="8" style="v" sid="2JN 1:8"/>ತುಮಿ ಖಟ್ಪಟ್ ಕಾವುನ್ ಕೆಲ್ಯಾಲಿ, ಸಾಂಡುನ್ ಗಿಹ್ಯಾಚೆ಼ ಆಂದಿ ಪುರ ಪ್ರತಿ ಫಳ್ ಗಿಹ್ಯಿಸಾರ ಜಾ಼ಗ್ರುತ್‌ ರಾವ್ಹಾ<verse eid="2JN 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2JN 1:9"/>ಕ್ರಿಸ್ತಾಚಾ಼ ಶಿಕ್ಷನಾತ್ ರಾಹ್ಯಾಚೆ಼ ಆಂದಿ ತ್ಯ ವಲ್ಯಾಂಡುನ್ ಜಾ಼ನಾರ‍್ಯಾಲಾ ದೇವ್‍ನಾಹಿ. ತ್ಯಾ ಶಿಕಿವನ್ಯಾತ್ ರಾನಾರ‍್ಯಾಲಾ ಬಾಚಿ ಆನಿ ಲೆಕಾಚಿ ಮಾಯಾ ರಾತಿ. <verse eid="2JN 1:9"/><verse number="10" style="v" sid="2JN 1:10"/>ಹ್ಯ ಶಿಕ್ಷೆನ್ ವಲ್ಯಾಂಡ್ನಾರಾ ಕೊನ್ತರಿ ತುಮ್ಚಿಪ ಆಲಾತ ತ್ಯಲಾ ಗರ‍್ಹಾತ್ ಗಿಹುನಕೊಸಾ. ತ್ಯಲಾ ಬರ ವ್ಹವುನಿ ಮನ್ಹುನ್ ಸಾಂಗು ನಕೊಸಾ. <verse eid="2JN 1:10"/><verse number="11" style="v" sid="2JN 1:11"/>ಕಾ ಮಂಜೆ, ತ್ಯಲಾ ಬರ ವ್ಹವುನಿ ಮನ್ಹುನ್ ಸಾಂಗ್ನಾರಾ ತ್ಯಚಾ ಬುರ್ಶಾ ಕಾಮಾತ್ ಹಾ.<verse eid="2JN 1:11"/></para>
  <para style="s">ಸರ್ತ್ಯಾ ಬೊಲ್ಯಾ</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12"/>ತುಮಾನಾ ಲಿವಾಯಾ ಮನಾ ಖುಬ್ ಗುಶ್ಟಿ ಆಸ್‌ಲ್ಯಾತರಿ, ತ್ಯಾ ಸಾಯಿನಿ ಕಾಗ್ದಾವ ಲಿವುನ್ ಸಾಂಗಾಯಾ ಮನಾ ಮನ್‍ ನಾಹಿ. ಫನ್, ಮಿ ತುಮ್ಚಿಪ ಯವುನ್, ತುಮ್ಚಿ ಸಂಗ ಬೊಲಾಯಾ ಆಶಾ ಕರ್ತೊ. ತವಾ, ತುಮಚಾ಼ ಸಂತೊಸ್ ಪುರ್ನ ವ್ಹಯಿಲ್.<verse eid="2JN 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13"/>ದೇವಾನಿ ನಿವಡಲ್ಯಾಲೆ, ತುಮ್ಚೆ ಬನ್ಹಿಚಿ ಪೊರ ತುಮಾನಾ ನಮಸ್ಕಾರ್ ಸಾಂಗ್ನಾರ್.<verse eid="2JN 1:13"/></para>
  <chapter eid="2JN 1"/>
</usx>
