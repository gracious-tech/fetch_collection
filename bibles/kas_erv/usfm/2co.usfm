\id 2CO - DMT Kashmiri
\toc1 2 کورنتھین
\mt1 2 کورنتھین
\c 1
\p
\v 1 بہٕ پولُسؔ چُھس توٚہہِ یہِ نامہٕ لیٚکھان، تہٕ تیمُتھیس، سون سٲتھی ایماندار چُھ مےٚ سٟتؠ۔ خداین ژورُس بہٕ یسوع مسیحؔ سنٛزِ نمایندگی باپتھ، تکیازِ یی اوس خدایہِ سُنٛد یژھُن تہِ۔ یہِ نامہٕ چُھس بہٕ سوزان توٚہہِ یِم خدایس پٮ۪ٹھ ایمان تھاون واجنہِ جمٲژ ہنٛدؠ حصہٕ چھِ یِم کورنتھ شہرس منٛز روزان چھِ۔ بہٕ چُھس یہِ نامہٕ سوزان تِمن سارنےٕ سٲتھی ایماندارن تہِ یِم اخیہ کِس علاقس منٛز روزان چھِ۔
\v 2 اسہِ سارنےٕ ہُنٛد بب خدا تہٕ خداوند یسوع مسیحؔ روزِن توٚہہِ پٮ۪ٹھ مہربان تہٕ تھٲوؠ نو امنہٕ سان۔
\v 3 أسؠ گژھو روزٕنؠ تعریف کران خدایہ سنٛدؠ یُس بب چُھ سٲنِس یسوع مسیحؔ سُنٛد۔ سُے چُھ سون ترس کھیٚنہٕ وول بب تہٕ اسہِ تسلی دِنہٕ وول سون خدا۔
\v 4 ییٚلہ تہِ أسؠ تکلیفس منٛز چھِ آسان خدا چُھ اسہٕ تسلی دِوان۔ سُہ چُھ یہِ کران تاکہِ أسؠ ہیٚکو باقین تسلی دِتھ یِم کُنہِ تہِ طریقہٕ تکلیفس منٛز چھِ۔ خدا چُھ اسہِ تِمن تِتھے پٲٹھؠ تسلی دِنس قٲبل بناوان یتھٕ پٲٹھؠ سُہ اسہِ تسلی چُھ دِوان۔
\v 5 توٚہؠ وُچھِو، مسیحؔ ہن کٟتؠ دۅکھ تُلؠ سانہِ باپتھ، تہٕ وۅنؠ چھِ أسؠ تہِ دۅکھ تُلان تکیازِ أسؠ چھِ تٔسؠ سٟتؠ جورِتھ۔ مگر مسیحؔ تہِ چُھ وۅنؠ اسہِ امی دۅکھٕ حسابہٕ بسیار تسلی دِوان روزان۔
\v 6 اوے تہِ ییٚلہِ لوٗکھ اسہِ دۅکھ دِن، تِتھے پٲٹھؠ ییہِ خدا توٚہہِ تسلی دِنہِ تہٕ روحٲنی طور توٚہہِ بچاونہِ۔ ییٚلہِ تہِ اسہِ خدا تسلی دِیہ، سُہ دِیہ توٚہہِ تہِ تسلی۔ خدا کرِ یہِ اوٕ کِنؠ زِ توٚہؠ چُھو صبرٕ سان ژالان روزان تم دۅکھ تہٕ اِذا یِم لوٗکھ توٚہہِ واتناوان چُھو۔ یتھٕ پٲٹھؠ زن یِم لوٗکھ اسہِ تہِ دۅکھ واتناوان چھِ۔
\v 7 اسہِ چھےٚ خبر زِ خدا دِیو توٚہہِ تہِ تسلی ییٚلہِ توٚہہِ کانٛہہ تکلیف واتہِ یتھٕ پٲٹھؠ زن اسہِ تہِ تکلیف واتان چُھ۔ اوے تہِ چُھ اسہِ اطمنان زِ توٚہؠ تھٲیو یسوعسؔ پٮ۪ٹھ پنٕنؠ پژھ قٲیم۔
\v 8 مِثالہِ پٲٹھؠ ونو أسؠ توٚہہِ سٲتھی ایماندارن، زِ اسہِ کیا کیا آو بٔنِتھ آسیہؔ کِس علاقس منٛز۔ تِم لوٗکھ ٲسؠ تیتیاہ ویکھٕتؠ زِ اسہِ باسیو أسؠ ما ہیٚکو نہٕ تِمن ہُنٛد ویٚترٲوتھےٕ۔ اسہِ گو پوٗرٕ یقین زِ اسہِ ما نیرِ وۅنؠ زُو۔
\v 9 اسہِ باسیوو زِ أکِس نفرس چُھ باسان ییٚلہِ أمؠ أکِس منصفس یہِ ونان بوزمُت چُھ، "بہٕ چُھس تۅہہِ مرنٕچ مزمت کران۔ "مگر خداین وۅتلوو اسہِ منٛز یہِ احساس زِ پزِ پانس پٮ۪ٹھ بھروسہٕ کرنہٕ بدلہٕ خدایس پٮ۪ٹھ بھروسہٕ کرُن۔ سُہ چُھ مودؠ مٕتٮ۪ن لوٗکن دوبارٕ زندٕ روزنُک تہِ سبب بنان۔
\v 10 یوٚدوے زن اسہِ زُو راونُک پوٗرٕ یقین اوس، خداین دیُت اسہِ نجات تِمو لوٗکو نِشہ یِم اسہِ مارنس پٮ۪ٹھ وٲتمٕتؠ ٲسؠ۔ تہٕ سُہ روزِ ہر وِزِ اسہِ حفاظت کران یِتھیٚو لوٗکو نِشہ۔ اسہِ چُھ پوٗرٕ بھروسہٕ زِ سُہ بچاوِ اسہِ یمہِ یور تہِ۔
\v 11 یتھٕ پٲٹھؠ توٚہؠ اسہِ پننہِ دُعا سٟتؠ مدد چُھو کران۔ مہربٲنی کٔرِتھ روز اسہِ دعا کران تاکہِ بیٚیہِ بیٚیہِ لوٗکھ تہِ کرن خدایہِ سنٛدؠ تعریف تمہِ باپتھ یہِ سُہ سانہِ باپتھ پننہِ عظمتہٕ کرِ تکیازِ واریہو لوٗکو کوٚر سانہِ باپتھ دعا۔
\v 12 اسہِ چُھ فخر زِ أسؠ ہیٚکو ایماندٲری سان یہِ ؤنِتھ زِ اسہِ کوٚر لوٗکن سٟتؠ بڈٕ راستبٲزی سان تہٕ خلوصہٕ سان سلوک۔ یہ کرنس لایق أسؠ خداین بنٲوؠ۔ أسؠ چھِنہٕ تہِ کران یتھ بے دین لوٗکھ دٲنش منٛدی زانان چھِ بلکہِ چُھ خدا پننہِ فضلہٕ سان اسہِ وتھ ہاوان۔ خاص پٲٹھؠ ییٚلہِ کتھ باتھ أسؠ توٚہہِ سٟتؠ کران آسو۔
\v 13 یہِ زاننہٕ باپتھ، وُچھِو یِم میٲنؠ نامہٕ۔ پننٮ۪ن سارنےٕ نامن منٛز چُھ مےٚ چھرا تی لیٚوکھمُت یتھ توٚہؠ آرام سان پٔرِتھ تہٕ سمجھِتھ ہیٚکو۔ مےٚ چھےٚ امید زِ جلدےٕ ہیٚکو توٚہؠ سانہِ لیٚکھنُک مٮعنہِ سمجھِتھ۔
\v 14 یتھٕ پٲٹھؠ توٚہہِ گۅڈے اڈلیوٚک سمجمُت چُھ۔ پتہٕ ییٚلہِ سون خداوند یسوع واپس ییہِ، توٚہہِ آسہ توتہِ فخر اسہِ پٮ۪ٹھ یوٗتاہ اسہِ توٚہہِ پٮ۪ٹھ فخر آسہ۔
\p
\v 15‏-16 اوٕ کِنؠ زِ مےٚ اوس پوٗرٕ اعتماد زِ توٚہہِ چُھ مےٚ پٮ۪ٹھ فخر، مےٚ کوٚر مکدُنیہ چہِ وتہِ پکنس دوران منٛزؠ توٚہہِ تہِ سمکھنہِ ینُک ارادٕ۔ تہٕ تور واپس پھیرنس دوران دُبارٕ سمکھنُک ارادٕ۔ امہِ آیہِ میلہِ توٚہہِ مےٚ سٟتؠ روزنُک دۅگنہٕ فٲیدٕ۔ تہٕ امہِ مزید ہیٚکو توٚہؠ مےٚ یہُوداؔ کِس علاقس کُن گژھنہٕ باپتھ ضرورے سامانہٕ سٟتؠ تہِ اتھہٕ روٚٹ کٔرِتھ۔
\v 17 مےٚ کریاو یِمن دوٚن وقتن پٮ۪ٹھ توٚہہِ سمکھنُک ارادٕ مگر بہٕ آس نہٕ دویمہِ پھرِ توٚہہِ نِش۔ امیُک تر چُھنہٕ یہِ زِ مےٚ بدلوو پنُن اِرادٕ بٔلؠ۔ بہٕ چُھسنہٕ کُنہِ تہِ وقتہٕ پنٕنؠ اِرادٕ نِوان یا بدلاوان پننہِ مرضی۔ بہٕ چُھسنہٕ ونان، "آ، بہٕ کرٕ یہِ" تہٕ سٟتؠ چُھس ونان، "نہ، بہٕ کرٕ نہٕ یہِ"
\v 18 یتھٕ پٲٹھؠ زن خدا أکسےٕ کتھہِ پٮ۪ٹھ قٲیِم چُھ روزان، أسؠ تہِ چھِ پوٗرِ پوٗر پننِس وننس دپنس پٮ۪ٹھ قٲیِم۔ أسؠ ونو نہٕ زانہٛہ، "آ" ییٚلہِ آسہ "نَہ" آسہ ونُن۔
\v 19 مےٚ، سلوانسنؔ تہٕ تیمُتھیسن کٔرِو توٚہؠ زٲنؠ یاب خدایہِ سنٛدِس گۅبرِس، یسوع مسیحؔ ہس متعلق۔ توٚہہِ چُھو خبر زِ سُہ ونہِ نہٕ زانہٛہ تہِ "آ" یوٚدوے تس "نَہ" ونُن آسہ۔ تکیازِ یہِ زٲنِتھ زِ سُہ کُس چُھ، تس متعلق سون پٲغام تہِ چُھ بھروسہٕ منٛد تہٕ کُنہِ تقاضہٕ ورٲے۔
\v 20 یسوعؔ سنٛدؠ کِنؠ ہیٚکو أسؠ خدا سنٛدِس پرٮ۪تھ وعدس پٮ۪ٹھ بھروسہٕ کٔرِتھ۔ یسوع چُھ تِم سٲری پوٗرٕ کران۔ اوے تہِ چُھ یسوعؔ سُہ یُس اسہِ یہِ وننس لایق چُھ بناوان، "آ یہِ چُھ پوٚز" ییٚلہِ أسؠ خدایہِ سنٛدؠ تعریف کران چھِ۔
\v 21 یہِ چُھ خدا یُس اسہِ توٚہہِ ہٮ۪تھ، مسیحؔ ہس پٮ۪ٹھ یقین قٲیِم کرناوان چُھ۔ خدایہ نےَ بخُش اسہِ سُہ روح یُس اسہِ أمِس خدمت کرنس لایق بناوان چُھ۔
\v 22 خداین کوٚر اسہِ پاک روح عنایت یُس اسہِ منٛز بسِتھ چُھ۔ یہِ کتھ چھےٚ اسہِ زٕ چیز باوان۔ اکھ یہِ زِ أسؠ چھِ امسنٛدؠ تہٕ بیاکھ یہِ زِ سُہ کرِ سانہِ باپتھ تہِ سورےٕ یمیُک تٔمؠ اسہِ وعدٕ دیُتمُت چُھ۔
\v 23 اوے ونو بہٕ توٚہہِ وۅنؠ زِ مےٚ کیازِ بدلوو پنُن ارادٕ تہٕ آسو نہٕ توٚہہِ سمکھنہِ دُبارٕ یہِ زن ارادٕ کوٚرمُت اوسُم۔ خدا نِین مےٚ زُو کٔڈِتھ یوٚدوے بہٕ اپُز ونہٕ، مگر تس چھےٚ پتاہ بہٕ چُھسو توٚہہِ پوٚز ونان۔ میانہِ یور کورنتھ نہ یِنُک وجہہ اوس یہِ زِ مےٚ پیٚیہِ نہٕ توٚہہِ سختی سان تہنٛزن تِمن غلطین متعلق ونن یِم توٚہہِ کَریٚو۔
\v 24 ییٚلہِ بہٕ توٚہہِ یہِ ونان چُھس میون مطلب چُھنہٕ یہِ باوُن زِ أسؠ کیا چھِ تہنٛدؠ مٲلک یِم توٚہہِ حکم دِن زِ کیا چُھ کرُن کتھ چھےٚ پژھ کرٕنؠ تہٕ کیا چُھ کرُن۔ امہِ بجایہ۔ یِتہِ أسؠ توٚہہِ ونان چھِ خدایہِ سنٛدِ باپتھ زُونہٕ باپتھ تاکہِ توٚہؠ پھٔلیٚو خوشی سٟتؠ۔ اسہِ چھنہٕ ضرورت توٚہہِ حکم دِنچ۔ تکیازِ خدا چُھ توٚہہِ پانہٕ ونان کتھ چُھ یقین کرُن تہٕ کیا چُھ کرُن۔
\c 2
\p
\v 1 بہٕ آس نہٕ توٚہہِ سمکھنہِ مےٚ تروو توٚہہِ سمکھُن اوٕ کِنؠ زِ یوٚدوے یہِ توٚہہِ تہٕ مےٚ دِل زالہِ، یتھٕ پٲٹھؠ زن پتمہِ لٹہِ سپُد ییٚلہِ بہٕ توٚہہِ سمکھیوس۔
\v 2 مےٚ کوٚر توٚہہِ بیٚیہِ نہ سمکھنُک فٲصلہٕ تکیازِ ییٚلہِ بہٕ توٚہہِ دِل زالہٕ۔ بہٕ چُھس تِمن لوٗکن ہُند زالان یِم مےٚ مسرت بخشان چھِ۔
\v 3 مےٚ لیٚوکھ توٚہہِ برونٛٹھےٕ پننس پتمِس نامس منٛز تہِ سورےٕ یہِ بہٕ توٚہہِ وُنکٮ۪س ونان چُھس۔ مےٚ لیٚوکھ تمن چیزن متعلق تاکہِ ییٚلہِ بہٕ برونٛہہ کُن توٚہہِ سمکھٕ۔ توٚہؠ زٲلِو نہٕ میون دِل تہٕ بہٕ تھاوٕ توٚہہِ متعلق دل خوش۔ یہِ زن مےٚ پزِ۔ مےٚ لیٚکھؠ تتھ نامس منٛز یِتھؠ چیز اوٕ کِنؠ زِ مےٚ ٲس امید زِ توٚہؠ روزیٚو خوش ییٚلہِ بہٕ خوش آسہٕ۔
\v 4 مےٚ آو دِل کوٗرنہٕ تہٕ انٛدری سپدُس چھۅکل ییٚلہِ مےٚ سُہ پتِم نامہٕ توٚہہِ لیٚوکھ۔ پوٚز ہے بوزِو مےٚ ووٚد یہِ لیٚکھنس دوران۔ مےٚ سوزُو سُہ توٚہہِ تاکہِ توٚہؠ کٔرِو انٛدازٕ بہٕ کوتاہ پرواہ چُھس تُہنٛد کران۔ میون ارادٕ اوس نہٕ توٚہؠ دۅکھل بناوٕنؠ۔
\v 5 وۅنؠ گو، سُہ کانٛہہ تہِ شخص یُس باقین دۅکھل کرٕ چُھنہٕ ہرگِز تہِ مےٚ دۅکھل بناوان۔ بلکہِ چُھ یُتھ شخص توٚہہِ منٛزےٕ کینٛژن چھۅکھ دِوان۔ مےٚ ورتوو لفظ "کینژن" تاکہِ بہٕ گنٛزرکھ نہٕ یِمن سٟتؠ سٲری یِمن سُہ شخص چھۅکل بناوان چُھ۔
\v 6 توٚہہِ منٛزِ چُھ واریہو سمِتھ سُہ شخص سمبولمُت وۅنؠ گو یہِ پزنہٕ توٚہہِ کرُن یمہِ اپور۔
\v 7 اوے تہِ پزِ توٚہہِ تس شخصس یتھٕ پٲٹھؠ سنبالنہٕ بدلہٕ معاف کرُن تہٕ تس حوصلہٕ دِنؠ۔ نتہٕ سپدِ سُہ شخص دل ملول تہٕ ہارِ ہمت۔
\v 8 اوے تہِ چُھسو بہٕ توٚہہِ حوصلہٕ دِوان لوٗکن منٛز یہِ ہاونہٕ باپتھ زِ توٚہؠ کوتاہ پرواہ چُھو تس شخصہٕ سُنٛد کران۔
\v 9 پننس پتمِس نامس منٛز یہِ لیٚکھنُک بیاکھ وجہہ اوس زِ میون غرض یمہ کتھ ہنٛد یقین کرن زِ توٚہؠ کٔرِو تہِ سورےٕ یہِ بہٕ توٚہہِ ونان چُھس کرنہٕ باپتھ۔
\v 10 چھیکرس ونو، زِ ییٚلہِ توٚہؠ کٲنسہِ شخصس کُنہِ کتھہِ باپتھ معاف کٔرِیو، بٕتہ کرٕ معاف تس شخصس معاف۔ پزر گو مےٚ چُھ تس شخصس معاف کوٚرمُت تٔمہِ باپتھ یہ تٔمؠ کوٚر۔ یوٚدوے زن ژکہِ سُہ کہینؠ اوسنہٕ، مےٚ کوٚر یہِ توٚہہِ مدد کرنہٕ باپتھ یہِ مسیحؔ سُنٛد یژھُن اوس۔
\v 11 اسہِ پزِ بیٚین معاف کرُن تاکہِ شیطان رٹہِ نہٕ اسہِ پانس تل۔ حالانکہ أسؠ چھِ پزی زانان تسٕنٛدؠ سٲری ژھل اسہِ تل تل رٹنٕکؠ۔
\v 12 وۅنؠ پھیرٕ بہٕ پننس سفرس کُن، ییٚلہِ بہٕ ترواسؔ شہر ووتُس، خداوند یسوعنؔ بنوو یہِ میانہِ باپتھ ممکن زِ بہٕ واتناوٕ مسیحؔ سنٛز شیٚچھ پورٕ اثرٕ سان۔
\v 13 وۅنؠ گو چونکہِ میون ایماندار سٲتھی طِطُس اوسنہٕ ترواس شہرس منٛز، بہٕ رودُس پریشان زِ اما تمہِ وِزِ کیا سپُد ییٚلہِ سُہ توٚہہِ سمُکھ۔ اوے تہِ کوٚر مےٚ اتکٮ۪ن ایماندارن الوداع تہِ دراس مکدُنیہ کُن۔
\v 14 وۅنؠ کرَو أسؠ شکُر خدایہِ سُنٛد! سُے چُھ یمؠ أسؠ مسیحؔ ہس سٟتؠ جورِتھ تھٲوؠ تہٕ چُھ اسہِ پانس کُن رٔٹِتھ دشمنن تلفس تل انان۔ امہِ مزید چُھ سُہ سانہِ وصیلہٕ لوٗکن منٛز جایہِ جایہِ پنن آسُن ظٲہر کران۔
\v 15 پزر گو أسؠ چھِ زنتہٕ سۅ خوش بۅے یۅسہ مسیحؔ سنٛدِ پٮ۪ٹھٕ وۅتلان چھےٚ تہٕ یۅسہ خدایس خوش چھےٚ کران۔ أسؠ چھِ زنتہٕ یہےَ خۅشبوے ییٚلہِ أسؠ تمن لوٗکن سٟتؠ چھِ آسان یِمن خداین نجات بخُش تہٕ ییٚلہِ أسؠ چھِ تمن لوٗکن سٟتؠ آسن یِم مران چھِ۔
\v 16 تِم یِم مران چھِ، چھِ سونچان زنتہٕ أسؠ چھِ سۅ بۅے ہِش یۅسہ مرن والیٚن وۅتھان چھےٚ تہٕ تِمن ماران چھےٚ۔ دویمہِ پاسہٕ چھِ تِم یِمن خدا چُھ بوٚٹھ لاگان چھِ سونچان زِ اسؠ چھِ زنتہٕ سۅ بۅے یۅسہ زنٛدٕ زُوون وۅتھان چھےٚ تہٕ تِمن زُو بخشان چھےٚ۔ کانٛہہ تہِ ہیٚکہِ نہٕ خوش خبری ہنٛز تُرے یتھٕ پٲٹھؠ دِتھ۔
\v 17 توٚہؠ ہیٚکو ؤنِتھ زِ أسؠ چھِنہٕ صحیح پٲٹھؠ خوش خبر دِتھ ہیٚکان۔ تکیازِ أسؠ چھِنہٕ خدایہ سُنٛد پٲغام پونٛسن کٕنان۔ یہِ زن واریاہ لوٗکھ کران چھِ۔ بلکہِ چھِ أسؠ صرف خدایہِ سنٛز خدمت یژھان کرنؠ۔ نہ زِ کینٛہہ نفع پراونہٕ باپتھ۔ یقیناً چھِ أسؠ رٕژِ شیٚچھِ ہنٛز تۅرے دِوان۔ تکیازِ امی باپتھ سوزؠ أسؠ خداین۔ تِمن لوٗکن ہنٛدؠ پٲٹھؠ یِم خداین مسیحؔ ہس سٟتؠ جورِتھ تھٲوؠ یمن خداین اتحاد کوٚر مسیحؔ ہس سٟتؠ، چھِ أسؠ خوش خبر خدایس خوش کرنہٕ باپتھ پھٲلاوان، نہ زِ لوٗکن۔
\c 3
\p
\v 1 أسؠ چھِنہٕ یژھان توٚہہِ پننہِ بھروسہٕ منٛد آسنُک دوٚیمہِ پھرِ ثبوت دیُن۔ توٚہؠ یتھٕ پٲٹھؠ زانان چُھو، توٚہہِ چُھنہٕ سانہٕ بھروسہٕ مندی ہنٛدِ ثبوت باپتھ کینٛہہ لیکھِتھ دِنچ یا کینٛہہ لیکھِتھ اننچ ضرورت، یوٚدوے زن توٚہہِ یہِ کرنچ ضرورت آسہ باقین لوٗکن باپتھ۔
\v 2 توٚہؠ چُھو پٲنؠ پانے سُہ لیکھُت یُس سانہِ بھروسہٕ مندی ہُنٛد ثبوت چُھ۔ ییٚلہِ أسؠ اکھ أکؠ سُنٛد پرواہ برَو سٲری لوٗکھ زانن پانے زِ أسؠ چھِ بھروسہٕ منٛد۔ زنتہٕ تِم تُہنٛد لیکھُت پرن۔
\v 3 ہر کانٛہہ چُھ زانان زِ توٚہؠ چُھو سُہ لیٚکھُت یُس مسیحؔ ہن لیٚوکھ تہٕ اسہِ واتنوو۔ مسیحؔ ہن لیوکھ نہٕ یہِ لیکھُت کُنہِ پوترِ کنہِ پٮ۪ٹھ یا کُنہِ رنگہٕ سٟتؠ۔ بلکہِ زٲنتو زِ تٔمؠ لیٚوکھ تُہندس اندرونس منٛز پاک روح سٕنٛدِ وصیلہٕ۔ یُس صرف پزی خدا چُھ۔
\v 4 بہٕ چُھسو تِمہٕ کتھہٕ ونان زِ اسہِ چُھ پوٗرٕ یقین خدا کیا چُھ اسہِ متعلق سونچان۔ اسہِ چُھ یقین تکیازِ اسہِ چُھ پانہٕ مسیحؔ یہِ یقین دِوان۔
\v 5 وۅنؠ گو أسؠ ہیٚکو نہٕ یہِ خوش خبر پٲنؠ پانے دِتھ۔ أسؠ ہیٚکو نہٕ یِتہِ سونچِتھ زِ أسؠ کیا ہیٚکو پانہٕ کینٛہہ رُت چیز کٔرِتھ بلکہِ چُھ اسہِ خدا "خوش خبر" واتناونُک توفیق بخشان۔
\v 6 تٔمی کٔرؠ أسؠ نو عہد نامٕکؠ خٲدم بننس لایق۔ پاک روح چُھ یہِ نو عہد نامہٕ عنایت کران، اوے تہِ چھِنہٕ یِم چھرا لفظ یِم کٲنسہِ لیٚکھؠ۔ یہِ چُھ اہم تکیازِ تِم لوٗکھ یِم دٔرِتھ رودؠ پاک روحس پٮ۪ٹھ پراون زندگی تہٕ تِم یِم زن کٲنسہِ ہندٮ۪ن لیٚکھؠ مٕتٮ۪ن لفظن تھپھ کٔرِتھ رودؠ، سپدن ہلاک۔
\v 7 مزید، ییٚلہِ موسیٰؔ ہن پرانہِ عہد نامہٕ مطٲبق عمل کٔر یمؠ لوٗکن موتُک سزا دیُت، خداین لیٚکھؠ یِم کلامہٕ پوتٕرؠ کنہِ پٮ۪ٹھ۔ یہِ موسیٰؔ ہن کوٚر تمیُک جلال اوس یُتھ زِ اسرائیلی ہیٚکؠ نہٕ امہِ پتہٕ تمسنٛدِس بُتھِس کُن وُچھنس دٔرؠ تھےٕ تکیازِ یہِ اوس خدایہِ سنٛدِ جلالُک پرتو، یوٚدوے زن یہِ وارٕ وارٕ ہمیوو۔
\v 8 اوے تہِ ییٚلہِ لوٗکھ نٔوِس عہد نامس متعلق عمل کرن یُس پاک روحن عنایت کوٚر، یُس زن واریاہ جلال وول چُھ۔
\v 9 یقیناً، ییٚلہِ موسیٰؔ ہن پرٲنِس عہدنامس پٮ۪ٹھ عمل کٔر یم خداین لوٗکن سزا دیاونوو، لوٗکن مزمت کران، یہِ اوس پُر جلال۔ اوے تہ، ییٚلہ لوٗکھ نٔوِس عہدنامس پٮ۪ٹھ عمل کرن، یُس لوٗکن راستبٲزی کُن نِوان چُھ، یہِ چُھ سٮ۪ٹھا زیادٕ جلال وول!
\v 10 بوزوے تہٕ پرُون عہد نامہٕ چُھنہٕ نٔوِس عہد نامس برونٛہہ کنہِ کہین جلال وول۔
\v 11 یقیناً پرُون عہد نامہٕ یُس لوسنہِ لوٚگمُت چُھ اوس پُرجلال۔ تہٕ نوو عہدنامہٕ یُس ہمیشہٕ ہمیشہٕ پوشہٕ وُن روزِ چُھ زیادٕ جلال وول۔
\v 12 اوے تہِ، چونکہِ أسؠ چھِ پوٗرٕ اعتمادٕ سان پُر امید یِم پُر جلال چیز حٲصل سپدنس متعلق، أسؠ چھِ واریاہ دلیری سان کتھ کران۔
\v 13 أسؠ چھِنہٕ موسیٰؔ سٕنٛدؠ پٲٹھؠ یُس پننس بُتھِس نقابس تل رٹان اوس ژورِ۔ یتھٕ پٲٹھؠ ژیون نہٕ اسرائیلی لوٗکو بالکل زِ تمندِس بُتھِس کِتھہٕ روو جلال یُس خدایہِ سنٛدِ جلالُک پرتو اوس۔
\v 14 پزر گو یہِ زِ اسرائیل یو زونُے نہٕ خدایہِ سُنٛد پٲغام۔ یِتہِ چُھنہٕ پزرےٕ ییٚلہِ کانٛہہ تِم صحیفہٕ پران چُھ یتھ منٛز پرُون عہد نامہٕ چُھ۔ باسان چُھ زنتہٕ سُہ نقاب یُس موسیٰؔ لاگان اوس، چُھ لوٗکن اتھ زاننس منٛز ٹھوٚر بنان۔ یہِ چُھ اوٕ کِنؠ زِ کانٛہہ تہِ ہیٚکہِ نہٕ یِم صحیفہٕ زٲنِتھ یوٚتام نہٕ خدا تِمن مسیحؔ ہس سٟتؠ جورِ۔
\v 15 بے شک وُنکٮ۪س تہِ ییٚلہِ کانٛہہ موسیٰؔ سنٛز شریعت پران چُھ، زنتہٕ چُھ موسیٰؔ سُنٛد نقاب تمن اتھ زاننس منٛز ٹھوٚر بنان۔
\v 16 ییٚلہِ لوٗکھ خداوندس خدایس پٮ۪ٹھ پژھ ہیٚن کرٕنؠ، خدا بناوِ تِمن موسیٰؔ سنٛز شریعت سمجھنس لایق۔ زنتہٕ خداین سُہ موسیٰؔ سُنٛد نقاب تھوٚد تُلہِ۔
\v 17 ییٚلہِ بہٕ خداوند خدا سنٛز کتھ چُھس کران میون مطلب چُھ پاک روح۔ یہِ چُھ پاک روح یُس لوٗکن یِم صحیفہ زاننس لایق بناوان چُھ۔
\v 18 اوے تہِ چھِ أسؠ سٲری یِمن یٮقین تھاون وٲلؠ یہِ ہٲوِتھ دِوان زِ خداوند خدا کوتاہ پُرجلال چُھ۔ تہٕ أسؠ چھِ یہِ بُتھؠ کنہِ نقابس تل رٹنہٕ ورٲے کران۔ خدا چُھ اسہِ لگاتار تھٕران روزان تاکہِ أسؠ بنو مسیحؔ ہس ہیٚوؠ۔ یتھٕ پٲٹھؠ چُھ پُرجلال خداوند یُس پاک روح چُھ اسہِ تہِ جلال بخشان۔
\c 4
\p
\v 1 تِموےٕ چیزو کِنؠ تہٕ خدایہِ سنٛزِ رحمتہٕ سٟتؠ بنٲوؠ أسؠ خداین پننہِ نوِ عہد نامہٕ مطٲبق عمل کرنس لایق۔ أسؠ سپٕدؠ نہٕ ہرگز پس ہمت۔
\v 2 بلکہِ چھِ أسؠ تٔمہِ پرٮ۪تھ کامہِ نِشہ پوٚت ہیٚوان یۅسہ اسہِ ژوٗرِ تھٲو تکیازِ سۅ آسہ شرمنٛدٕ کرن واجِنؠ۔ أسؠ چھِنہٕ باقین سٟتؠ تارن گری ہنٛز کوشش کران تہٕ أسؠ چھِنہٕ خدایہِ سنٛدِس کلامس تبدیلی کران۔ بلکہِ چھِ أسؠ پزرُک واتنیار کران۔ تہٕ پرٮ۪تھ کٲنسہِ یہِ ثبوت دِوان زِ خدا چُھ اسہِ بھروسہٕ منٛد زانان۔
\v 3 پزر چُھ یہِ زِ چھرا تِم لوٗکھ یِم نہٕ رٕژ شیٚچھ سمجھان چھِ یِمن ہُنٛد أسؠ اعلان چھِ کران، تِم چھِ تِم لوٗکھ یِم گُذران چھِ۔
\v 4 یتھ دنیہس پٮ۪ٹھ وُنکٮ۪س حکمرٲنی کرن وول شیطان چُھ پژھ نہ تھاون والیٚن یِمن لوٗکن أمچہِ زانکٲری نِشہ مُچھِ تھاوان۔ یتھ پٲٹھؠ شاندار مسیحؔ ہس متعلق رٕژ شیٚچھ، یُس یہٕ ظٲہر چُھ کران زِ خدا کیُتھ چُھ، چُھنہٕ تمن بدلاوان۔
\v 5 بہٕ چُھس ونان زِ رٕژ شیٚچھ چھےٚ مسیحؔ ہس متعلق۔ تکیازِ أسؠ چھِنہٕ پانس متعلق باقےٕ لوٗکن ونان۔ بلکہ چُھ ونان یسوع مسیحؔ خداوندس متعلق تہٕ بیٚیہِ أسؠ کِتھہٕ کِنؠ چھِ تسنٛدؠ کِنؠ تہنٛز خدمت کران۔
\v 6 أسؠ چھِ یہِ کران اوٕ کِنؠ زِ خداین ؤنؠ یِم کلامہٕ: "یہِ کینژھا تہِ انہِ گوٚٹ چُھ تہِ بنہِ گاش۔ "تٔمؠ بنٲوؠ أسؠ یہِ پوٚز زاننس لایق زِ سُہ کیُتھ جلال وول چُھ۔ زنتہٕ تٔمؠ اسہِ پٮ۪ٹھ پنُن گاہ تروو۔ خداین کوٚر یہِ ظٲہِر یسوع مسیحؔ سٕنٛدؠ دٔسؠ۔
\v 7 أسؠ چھِ یہِ ژٮ۪تراوان تہٕ یِمن عٲلیشان کتھن ہنٛز تۅرے دِوان۔ مگر پانہٕ چھِ أسؠ لیٚژؠ تہٕ بے وقعت۔ یتھٕ پٲٹھؠ چھےٚ یہِ کتھ صاف گژھان زِ خدا چُھ یِمن چیزن پُرقوت بناوان نہ زِ اسہ۔
\v 8 أسؠ چھِ واریاہ مشکل چیزن ژیتران۔ لوٗکھ چھِ اسہِ ستاوان، مگر تِم چھِنہٕ اسہِ پٮ۪ٹھ قابو کران۔ اسہِ چُھنہٕ سٮ۪کہٕ پتاہ آسان زِ کیا چُھ کرُن، مگر أسؠ چھِنہٕ ہاران۔
\v 9 لوٗکھ چھِ اسہِ ستاوان مگر خدا چُھنہٕ اسہِ مشراوان۔ لوٗکھ چھِ اسہِ خلاف گژھان مگر اسہِ چھِنہٕ شِکس دِتھ ہیٚکان۔
\v 10 أسؠ چھِ لگاتار یسوع سٕنٛدؠ پٲٹھؠ جسمٲنی عِذا تُلان۔ تاکہِ یِتھٕ پٲٹھؠ کرِ اسہِ خدا دُبارٕ زنٛدٕ یتھٕ پٲٹھؠ تٔمؠ یسوع دُبارٕ زنٛدٕ کوٚر۔
\v 11 بے شک سٲنِس زنٛدٕ کالس دوران چُھ خدا اسہِ یسوع سٕنٛدؠ کِنؠ لگاتار دۅکھ تُلناوان۔ امہِ طریقہٕ یوٚدوے أسؠ مرو، خدا تُلہِ اسہِ دُبارٕ زنٛدٕ یتھٕ پٲٹھؠ تٔمؠ یسوع زنٛدٕ کوٚر۔
\v 12 یہِ زن توٚہؠ پانہٕ وُچِھتھ ہیٚکو، خدا چُھ اسہِ دۅکھن منٛز ضروٗر تراوان مگر سُہ تھاوِ توٚہہِ زنٛدٕ۔
\v 13 أسؠ چھِ تِم یِمن خدایس پٮ۪ٹھ ایمان چُھ۔ تمِس شخصہٕ سٕنٛدؠ پٲٹھؠ یمؠ زبورس منٛز لیٚوکھ مےٚ کٔر خدایس پٮ۪ٹھ پژھ۔ اوے کۅرُم کلام، "اسہِ تہِ کٔر خدایس پٮ۪ٹھ پژھ تہٕ اوے کوٚر کلام"
\v 14 أسؠ چھِ یہِ کران تکیازِ أسؠ چھِ زانان زِ خداین کوٚر یسوعؔ زنٛدٕ تہٕ اوے کرِ اسہِ تہِ دُبارٕ زنٛدٕ۔ امہِ پتہٕ روزو أسؠ یسوعسؔ تہٕ توٚہہِ سٟتؠ خدایس برونٛہہ کنہِ۔
\v 15 یِم چیز چھِ أسؠ کران توٚہہِ پلزنہٕ باپتھ۔ تِتھٕ پٲٹھؠ کرِ خدا زیادٕ کھۅتہٕ زیادٕ لوٗکن پٮ۪ٹھ مہربٲنی۔ لوٗکھ کرن خدایہِ سُنٛد زیادٕ کھۅتہٕ زیادٕ شکُر ادا۔ یُس تس عزت بخشہِ۔
\v 16 اوے چھِنہٕ أسؠ ہمت ہاران۔ یوٚدوے زن لوٗکھ سانٮ۪ن کینٛژن تانن ضایہِ گژھان وچُھن۔ خدا چُھ کینٛژن تانن زُو زٮ۪تہٕ بخشان روزان یِمنہٕ لوٗکھ وُچھان چھِ۔
\v 17 أسؠ چھِنہٕ ہاران ہمت، تکیازِ ییٚلہِ أسؠ غٲر ضروری تہٕ کینٛژِ وقتہٕ باپتھ دۅکھ تُلان چھِ، یہِ چُھ اسہِ اہم پٲٹھؠ ہمیشہٕ باپتھ پُرجلال بناوان۔ تِتھٕ پٲٹھؠ یِنہٕ أسؠ سونٛچ تھےٕ ہیٚکو۔
\v 18 اوے چھِ أسؠ توجہ دِوان تتھ کُن یِنہٕ أسؠ وُچھو، نہ زِ یہِ أسؠ وُچھو۔ تکیازِ یِنہٕ أسؠ وُچھو تہِ چُھ ہمیشہٕ روزٕ وُن۔ تہٕ یہِ وُچھو تہِ مۅکلہِ۔
\c 5
\p
\v 1 یقیناً چھِ أسؠ اخز کران زِ یتھ زمینہِ پٮ۪ٹھ سٲنؠ بدن مرن۔ زٲنؠ تو یِمہٕ چھِ خٟمہٕ یِمن لوٗکھ اورؠ ترٲوِتھ ژھٕنان چھِ۔ وۅنؠ گو خدا دییہِ اسہِ بدل بدن یِم ہمیشہٕ پوشوٕنؠ آسن۔ زٲنؠ تو یِم آسن زنتہٕ تِم عمارژٕ یِمن خدا آسمٲنؠ جاین منٛز تعمیر کرِ۔
\v 2 وۅنؠ گو أسؠ چھِ ماتم کران یِمن بدنن منٛز پننہِ زندگی پٮ۪ٹھ۔ أسؠ چھِ یژھان زِ خدا دِیِن اسہِ نٔوؠ بدن۔ زنتہٕ سُہ اسہِ نٔوؠ پلو نٲلؠ تراوِ یِم نٔوؠ پلو چھِ زنتہٕ نوِ عمارژٕ یِم خدا اسہِ آسمانہٕ پٮ۪ٹھ سوزِ۔
\v 3 ییٚلہِ تہِ أسؠ نٔوؠ بدن پراوو۔ یِم آسن زنتہٕ پلو یِمہٕ اسہِ نٮ۪تھہٕ نوٚن آسنہٕ نِشہ مُچھِ تھاون۔
\v 4 امہِ مزید بیٚیہِ ییٚلہِ زن اسہِ یِمہٕ خٟمہٕ ہِوؠ بدن میسر چھِ۔ أسؠ چھِ ماتم کران روزان تہٕ یِم بدن چھِ سٲنؠ زندگی مشکل بناوان۔ مگر تو کِنؠ چھِنہٕ أسؠ ہرگز ہرگز یژھان زِ أسؠ روزو پننیٚو بدنو ورٲے۔ یہِ بوزؠ تو پلوو ورٲے روزُن۔ بلکہِ چھِ یژھان نٔوؠ بدن پراوٕنؠ۔ یہِ زن نٔوؠ پلو لاگنس برابر چُھ۔ یتھٕ پٲٹھؠ روزو أسؠ ہمیشہٕ زنٛدٕ کُنہِ مرنچہِ شینکہِ ورٲے۔
\v 5 خدا چُھ سُہ یُس اسہِ تیار کران چُھ نٔوؠ بدن پراونہٕ باپتھ۔ سُہ چُھ اسہِ دِوان پاک روح، یُس یہِ ہاوان چُھ زِ سُہ دییہِ اسہِ تہِ سورےٕ یمیُک تٔمؠ وعدٕ دیُتمُت چُھ۔
\v 6 اوے چھِ أسؠ پرٮ۪تھ ساعتہٕ پُر اعتماد تتھ متعلق یہِ اسہِ خدا دِیہ۔ أسؠ چھِ یتہِ اخز کران زِ یوٚتام أسؠ یتھ بدنس منٛز چھِ أسؠ چھِنہٕ پننِس خداوند مسیحؔ ہس سٟتؠ۔
\v 7 یقیناً، أسؠ یہِ کران چھِ تہِ چھِ کران اوٕ کِنؠ زِ اسہِ چھےٚ پژھ خداوند مسیحؔ ہس پٮ۪ٹھ۔ اوٕ کِنؠ نہ زِ اسہِ وُچھ سُہ۔
\v 8 یہِ زن مےٚ ووٚن، أسؠ چھِ پُر اعتماد تتھ متعلق یہِ خدا دییہِ اسہِ۔ بیٚیہِ أسؠ کرو پننیٚو بدنو ورٲے روزُن قبول مگر خداوند یسوعسؔ ورٲے نہٕ۔
\v 9 اوے تہِ چھِ أسؠ کوشش کران خداوند یسوعسؔ خوش تھاونہٕ موجُب یوٚدوے أسؠ تس نِش آسو یا نہٕ۔
\v 10 أسؠ چھِ یہِ کران اوٕ کِنؠ زِ اسہِ سارنےٕ چُھ مسیحؔ ہس برونٛہہ کنہِ کھڑا گژھُن تہٕ سُہ کرِ فٲصلہٕ زِ اسہِ منٛزٕ کٔمؠ کوٚر غلط تہٕ کٔمؠ صحیح۔ امہِ پتہٕ دِیہ اسہِ سارنےٕ یمن بدنن منٛز روزن کالس دوران پننہِ پننہِ کرنہٕ مطٲبق تہٕ یتھ لایق أسؠ آسو۔
\v 11 تو پتہٕ، چونکہِ أسؠ چھِ ژیتراون خداوند یسوعؔ سُنٛد خوف۔ أسؠ چھِ باقین تہِ امسُنٛد خوف باور کرناوان۔ خدا چُھ زانان زِ أسؠ چھِ بھروسہٕ منٛد تہٕ بہٕ چُھس یژھان زِ توٚہؠ تہِ زٲنِو زِ أسؠ چھِ بھروسہٕ منٛد۔
\v 12 أسؠ چھِنہٕ توٚہہِ دُبارٕ پننہِ بھروسہٕ منٛدی ہُنٛد ثبوت دِوان۔ بلکہ چھِ أسؠ توٚہہِ پننِس بارَس منٛز عظیم کتھ وننس قٲبل بناوان۔ یتھٕ پٲٹھؠ ہیٚکِو توٚہؠ کٲنٛسہِ تہِ شخصس جواب دِتھ یُس اتھ متعلق عظیم کتھٕ ونان چُھ زِ لوٗکھ کِتھ کِنؠ چھِ نٮ۪برِمہِ طرفہٕ ظٲہِر گژھان تہٕ نہ زِ تَتھ متعلق یہ لوٗکن چُھ پٔزی اندرون۔
\v 13 لہٰذا، ییٚلہ أسؠ پاگل چھِ باسان، أسؠ چھِ خدایہ سنٛز خدمت کران۔ ییٚلہِ أسؠ عام پٲٹھؠ سونٛچان چھِ، أسؠ چھِ توٚہہِ خدمت کران۔
\v 14 تِم چیز چھِ پٔزؠ تکیازِ مسیحؔ چُھ اسہِ لول بران، تہٕ سُہ چُھ اسہِ ہدایت دوان طور طریقو سان کٲم کرنہٕ باپتھ۔ یتھٕ پٲٹھؠ چھِ اتھ بارس منٛز أسؠ سونٛچان: اکھ شخص مسیحؔ مود تمام لوٗکن بچاونہٕ باپتھ۔ امہِ وجہ کِنؠ، زنتہٕ تمام لوک مودؠ۔
\v 15 امہِ مزید، یہٕ چُھ اوٕ کِنؠ زِ سُہ مود تمام لوکھ بچاونہٕ باپتھ: یتھ پأٹھؠ، یم روحٲنی طریقہٕ روزان چھِ تم کرن نہٕ تہِ مزید یہِ تِم یژھان چھِ۔ امہِ بجایہ، تم کرن تہِ یہٕ مسیحؔ چُھ یژھان، یوٚدوے زن سُہ تِم بچاونہٕ باپتھ مود تہٕ خداین کوٚر سُہ بیٚہٕ زندٕ۔
\v 16 تکیازِ امہِ تمام وجہ کِنؠ، چُھنہٕ أسؠ کٲنسہِ ہنٛدِس بارس منٛز وۅنؠ صرف انسٲنؠ طریقو سونچان۔ درحقیقت، یوٚدوے اکہِ وقتہٕ أسؠ مسیحؔ ہس متعلق محض انسٲنی طریقو ٲسؠ سونٛچان، وۅنؠ چھِنہٕ أسؠ أمِس متعلق تِمو طریقو سونٛچان۔
\v 17 لہٰذا، ییٚلہِ تہِ خدا لوٗکن مسیحؔ ہس سٟتؠ جوڈان چُھ، سُہ چُھ تِمن نٔوؠ لوٗکھ بناوان۔ یہِ تِمہٕ ٲسؠ تہِ چُھ غٲب گوٚمُت۔ وُچھِو یِتہِ کینٛژھا وُنکٮ۪ن چُھ، چُھ نوو کینٛہہ!
\v 18 خدا چُھ سُہ یُس اسہِ یِمو چیزو منٛزٕ پریتھ اکھ چیز چُھ دِوان۔ مسیحؔ سٕنٛدِ ذریعہ کٲم کرنہٕ سٟتؠ کٔرؠ تٔمؠ أسؠ پانس سٟتؠ روزنس قٲبل۔ مزید، چُھ خدا اسہِ عمل کرنُک اختیار دِوان تاکہِ باقٕے تہِ ہیٚکن أمِس سٟتؠ روزِتھ۔
\v 19 یتھٕ پٲٹھؠ چُھ یہِ کٲم کران: خدا چُھ مسیحؔ سنٛدِ ذریعہ کٲم کران تاکہ پرٮ۪تھ کانٛہہ شخص روزِ تَس سٟتؠ۔ یہِ کرنہٕ سٟتؠ چُھ سُہ لوٗکن معاف کران یہِ تِمو غلط چُھ کوٚرمُت۔ امہِ مزید، چُھ سُہ اسہِ باقین یہِ وننہٕ خاطرٕ تعینات کران زِ تِم کِتھٕ پٲٹھؠ ہیکن خدایس سٟتؠ روزِتھ۔
\v 20 تکیازِ خداین کٔرؠ أسؠ تعینات، توے چھِ أسؠ مسیحؔ سنٛز نمایندگی کران، خدا چُھ سانہِ ذریعہ باقین حوصلہٕ افزٲئی کران۔ أسؠ چھِ مسیحؔ سٕنٛدِ باپتھ کتھ کران ییٚلہِ أسؠ توٚہہِ ونان چُھو زِ توٚہؠ کٔرِو رٕژِ شیٚچھِ پٮ۪ٹھ یقین تاکہِ توٚہؠ ہیٚکو خدایس سٟتؠ روزِتھ۔
\v 21 یسوعنؔ ہن کوٚر نہٕ گناہ۔ امہِ باوجود، اوس خدا تٔمس سٟتؠ سانہِ باپتھ تیُتھ سلوک کران زنتہٕ اوس تٔمؠ گناہ کوٚرمُت۔ اَمہِ موجُب چُھ خدا اسہِ یسوعسؔ سٟتؠ رلٲوِتھ اسہِ راستباز بناوان۔
\c 6
\p
\v 1 یتھ کِنؠ زن تِم یِم خدایہ سنٛز خدمت چھِ کران، أسؠ چھِ توٚہہ مکمل پٲٹھؠ حوصلہٕ افزأئی کران تہِ قبول کرنہٕ باپتھ یُس خداین مہربٲنی سان چُھ توٚہہِ خاطرٕ کوٚرمُت، تاکہِ یہٕ بدلہِ زِ توٚہؠ کِتھٕ پٲٹھؠ چُھو روزان۔
\v 2 توٚہہِ پزِ تہِ کرُن تکیازِ خدا چُھ پننِس صحیفس منٛز ونان:
\q1 "ییٚلہ بہٕ یہِ صحیح وق سمجھان اوسُس، مےٚ بوز تُہنٛد تہٕ کٔرٕم عمل۔
\q1 درحقیقت، ییٚلہ بہٕ لوٗکھ اوسسکھ بچاوان، مےٚ کٔرمو توٚہہِ معاونت۔"
\m وۅنؠ ییٚلہِ خدا اتھ بہتر وقت سمجھان چُھ! درحقیقت، چُھ وۅنؠ سُہ وق ییٚلہ خدا لوٗکن بچاوان چُھ!
\p
\v 3 أسؠ چھِ کانٛہہ تہِ کٲم کرنہٕ نِش پتھ روازان یمہِ سٟتؠ باقی ناراض گژھن۔ یتھٕ پٲٹھؠ ہیٚکہٕ نہٕ کانٛہہ تہٕ تنقید کٔرِتھ زِ أسؠ کِتھ پأٹھؠ چھِ خدایہ سنٛز خدمت کران۔
\v 4 بلکہِ، چھِ أسؠ یہٕ ثأبت کران زِ أسؠ چھِ پرٮ۪تھ طریقہٕ بھروسہٕ منٛد ییٚلہ أسؠ خدایہ سنٛز خدمت چھِ کران۔ أسؠ چھِ ہمیشہٕ تٔمہِ وِزِ ثٲبت قدمی کران ییٚلہِ لوٗکھ اسہِ تکلیف دِوان تہٕ ستاوان چھِ۔
\v 5 أسؠ چھِ ثٲبت قدمی کران ییٚلہِ لوٗکھ اسہِ پٮ۪ٹھ حملہٕ چھِ کران، اسہِ جیلَس منٛز چھِ تراوان، تہٕ اسہِ خلاف ہجوٗم بڑاوان۔ أسؠ چھِ ثٲبت قدمی کران ییٚلہ أسؠ سخت کٲم چھِ کران، زیادٕ چُھنہٕ شۅنگان، تہٕ چھِ روزدر روزان۔
\v 6 أسؠ چھِ بُرٕ چیزو نِش آزاد، أسؠ چھِ زانان پوٚز کیا چُھ، تہٕ اسہِ چُھنہٕ آسٲنی سان شرارت کھسان۔ اسہِ چُھ خیال باقین ہُنٛد، اسہِ چُھ پاک روح، تہٕ أسؠ چھِ لوٗکن خلوص سان لول بران۔
\v 7 أسؠ چھِ یہٕ اعلان کران زِ پوٚز کیا چُھ، تہٕ خدا چُھ اسہِ یہِ کٲم کرنُک طاقت بخشان۔ أسؠ چھِ راستباز، زنتہٕ أکِس اتھس منٛز تلوار تہٕ دوٚیمِس اتھس منٛز ڈھال چھےٚ۔
\v 8 کینٛہہ لوٗکھ چھِ اسہِ عزت کران، تہٕ باقٕے چھِ اسہِ شرمنٛدٕ کران۔ کینٛہہ لوٗکھ چھِ اسہِ متعلق خراب کَتھٕ ونان، تہٕ باقٕے چھِ اسہِ متعلق اصل کَتھٕ ونان۔ کینٛہہ لوٗکھ چھِ سونچان زِ أسؠ چھِ اپُز ونان، مگر پٔزؠ کِنؠ چھِ أسؠ تی ونان یہِ پوٚز چُھ۔
\v 9 کینٛہہ لوٗکھ چھِ سونچان زِ کانٛہہ تہِ چُھنہٕ اسہِ تسلیم کران، مگر پٔزؠ پٲٹھؠ چُھ اسہِ خدا تسلیم کران۔ کینٛہہ لوٗکھ چھِ سونچان زِ أسؠ چھِ مران، مگر پٔزؠ کِنؠ چھِ أسؠ زِنٛدٕ! کینٛہہ لوٗکھ چھِ سونچان زِ خدا چُھ اسہِ سزا دِوان، مگر حقیقتن چُھنہٕ تٔمؠ سانہِ مرنُک فٲصلہٕ کوٚرمُت۔
\v 10 کینٛہہ لوٗکھ چھِ سونچان زِ أسؠ چھِ ماتم کران، مگر حقیقتس منٛز، أسؠ چھِ لگاتار خوش گژھان۔ کینٛہہ لوٗکھ چھِ سونچان زِ أسؠ چھِ ضروٗرت منٛد، مگر حقیقتن چھِ أسؠ واریہن لوٗکن قٟمتی چیز حٲصِل کرنس منٛز مدد کران۔ کینٛہہ لوکھ چھِ سونچان زِ اسہِ چُھنہٕ کِہین، مگر حقیقتس منز چُھ اسہِ پرٮ۪تھ کینٛہہ۔
\v 11 کورنتھ شہرس منٛز ایماندار سٲتھیو، اسہِ چُھو توٚہہِ ووٚنمُت زِ صحیح کیا چُھ، تہٕ أسؠ چھِ تُہنٛد واریاہ خیال تھاوان۔
\v 12 أسؠ چھِنہٕ تِم یِمو تُہنٛد خیال تھاوُن تروو بلکہِ چُھو توٚہؠ تِم یِمو سون خیال تھاوُن تروو۔
\v 13 وۅنؠ کرٕ بہٕ توٚہہِ سٟتؠ کتھ یتھٕ پٲٹھؠ توٚہہِ سادگی سان سونٛچو شُرٮ۪ن ہنٛدؠ پٲٹھؠ: یوٚدوے زن اسہِ تُہنٛد خیال چُھ، یہِ روزِ تیٚلہِ ٹھیک ییٚلہِ توٚہؠ سون خیال تھٲیو۔
\v 14 تِمن لوٗکن سٟتؠ مہٕ کٔرِو شمولیت یِمہٕ نہٕ مسیحؔ ہس پٮ۪ٹھ بھروسہٕ چھِ کران۔ بہٕ چُھس ونان یہِ تکیازِ صحیح کیا چُھ تہٕ غلط کیا چُھ، اتھ منز چُھنہٕ کہین تہِ ہیوٗ۔ امہِ مزید یہ تہِ کینژھا اصل چُھ تتھ چُھنہٕ بُرٕ چیزن سٟتؠ کہین۔
\v 15 مسیحؔ چُھنہٕ کُنہٕ تہِ چیزس متعلق اتفاق کران بلِیعال شیطانس سٟتؠ۔ امہِ مزید، یِمن لوٗکن مسیحؔ ہس پٮ۪ٹھ بھروسہٕ چُھ تِم چُھنہٕ تمن لوٗکن سٟتؠ تعلق تھاوان یمن نہٕ مسیحؔ ہس پٮ۪ٹھ بھروسہٕ چُھ۔
\v 16 خدایہ سُنٛد ہیکل چُھنہٕ باقےٕ خداین سٟتؠ رلان۔ درحقیقت، چُھ یہِ زنتہٕ أسؠ یم یقین چھِ تھاوان ٲسؠ واحد حقیقی خدا سنٛدؠ ہیکل۔ توٚہؠ ہیٚکِو ؤنِتھ زِ أسؠ چھِ خدا سُنٛد ہیکل تکیازِ خداین ؤنؠ صحیفس منٛز یم کلام:
\q1 "بہٕ روزٕ پننؠن لوٗکن سٟتؠ۔
\q1 درحقیقت، تراوکھ نہٕ بہٕ تِمہٕ۔
\q1 تِم مانن مےٚ پنُن خدا
\q1 تہٕ بہٕ مانکھ تِم پنٕنؠ لوٗکھ۔"
\p
\v 17 لہٰذا، اسہِ پزِ تی کرُن یہِ خداوند خدا صحیفس منٛز چُھ ونان:
\q1 "لوٗکن نِش گٔژھِو دوٗر یِم نہٕ مےٚ خدمت چھِ کران۔
\q1 یقینی بنأیو زِ توٚہؠ چُھو الگ تِمو نِشہ۔
\q1 تٔمہِ نِشہ روزیٚو دوٗر یُس توٚہہِ ناپسند کرِ"
\q1 سُہ چُھ ونان، "پتہٕ کرے بہٕ ژےٚ خۅشی سان خۅش آوے"
\p
\v 18 امہِ مزید، چُھ خداوند خدا، ونان یُس تمام چیزن پٮ۪ٹھ حکومت چُھ کران،
\q1 "بہٕ آسہٕ تُہنٛد بب۔
\q1 توٚہؠ ٲسِو میٲنؠ گۅبر تہٕ کورِ۔"
\c 7
\p
\v 1 امہِ پتہٕ، ایماندار سٲتھیو یِمن بہٕ لول چُھس بران، تکیازِ خداین چُھ اسہِ یمن چیزن ہنٛد وعدٕ کوٚڑمُت، اسہِ پزِ تٔمہِ پرٮ۪تھ چیزٕ نِشہ نجات حأصل کرُن یُس اسہِ نٮ۪برؠ کِنؠ تہٕ انٛدرؠ کِنؠ ناپاک چُھ کران۔ اسہِ پَزِ پوٗرٕ پٲٹھؠ پاک بنُن تکیازِ أسؠ چھِ خدایس کھوٚژان۔
\v 2 أسؠ چُھ توٚہہِ ونان زِ سون کٔرِو خیال! اسہِ چُھنہٕ کانٛہہ ناراض کوٚرمُت، کٲنسہِ دوکھہٕ دِیُتمُت یا کانٛہہ بُرباد کوٚرمُت۔
\v 3 بہٕ چُھس نہٕ یِم چیز توٚہہِ پٮ۪ٹھ الزام لگاونہٕ خٲطرٕ ونان۔ درحقیقت، یتھٕ پٲٹھؠ زن مےٚ گۅڈے یتھ نامس منٛز لیٚوکھمُت چُھ۔ أسؠ چھِ تُہنٛد واریاہ خیال تھاوان، چاہے کینٛہہ تہِ سپدِ۔
\v 4 مےٚ چُھ یقین زِ توٚہؠ کٔرِو تہِ یہِ صحیح چُھ۔ حقیقتس منٛز، بہٕ چُھس اکثر توٚہہِ مُتعلِق عظیم کتھہٕ ونان۔ توٚہؠ چُھو مےٚ واریاہ حوصلہٕ افزٲئی کران، تہٕ بہٕ چُھس تُہنٛدِس بارس منٛز واریاہ خوشی محسوس کران ییٚلہِ زن أسؠ مصیبتس منٛز چھِ۔
\v 5 وۅنؠ واپس یِنہٕ خٲطرٕ کِتھہٕ کِنؠ کوٚر مےٚ سفر، ییٚلہِ أسؠ مکدُنیہ وٲتؠ، سانہِ خٲطرٕ گۓ نہٕ حالات سہَل۔ بلکہِ، آے اسہِ واریہو طریقو تکلیف۔ باقٕے لوٗکو کرِ اسہِ سٟتؠ لڑایہِ، تہٕ أسؠ ٲسؠ اکثر پانہٕ کھوٚژان۔
\v 6 تاہم چُھ خدا تِمن لوٗکن حوصلہٕ افزٲئی کران یم حوصلہٕ شکنی محسوس چھِ کران۔ تٔمؠ کٔر طِطُس اسہِ منٛز شٲمل گٔژھِتھ اسہِ حوصلہٕ افزٲیی۔
\v 7 خداین کٔر اسہِ حوصلہٕ افزٲئی طِطُس سُنٛد جزوی طور اسہِ منٛز شٲمل گژھنہٕ سٟتؠ، مگر امہِ کھۅتہٕ تہِ زیادٕ یتھٕ پٲٹھؠ زن توٚہہِ طِطُس سنٛز حوصلہٕ افزٲئی کٔرٕو۔ تٔمؠ چُھ اسہِ ووٚنمُت زِ توٚہؠ چُھو یژھان مےٚ وچُھن، زِ توٚہہِ چُھو افسوس تٔمہِ خٲطرٕ یہِ توٚہہِ کوٚرمُت چُھو، تہٕ تٔمہِ خٲطرٕ زِ توٚہؠ کٔرِو مےٚ عزت دِنٕچ کوٗشش۔ تکیازِ تِمو چیزو کِنؠ گےَ مےٚ زیادٕ خوشی یہِ مےٚ گۅڈٕ کوٚر۔
\v 8 مےٚ چُھنہٕ افسوس زِ مےٚ چُھ پتِم نامہٕ لیٚوکھمُت، حالانکہ مےٚ چُھ توٚہہِ دۅکھ واتنوومُت یہِ مےٚ لیٚکھمُت چُھ۔ درحقیقت، میانہِ افسوس کرنُک واحد وجہ آسہ زِ مےٚ لیٚوکھ یہ صرف زِ مےٚ چُھ پتاہ زِ چِٹھہِ سٟتؠ واتہِ توٚہہِ تکلیف، حالانکہ صرف کینٛژس کالس خٲطرٕ۔
\v 9 تاہم، وۅنؠ یہِ زن طِطُسن اسہِ توٚہہِ متعلق ووٚنمُت اوس، بہٕ چُھس واریاہ خۅش۔ بہٕ چُھس خۅش نہٕ زِ مےٚ واتنوو توٚہہِ تکلیف۔ بلکہ، بہٕ چُھس خۅش تکیازِ ییٚلہ مےٚ توٚہہِ تکلیف واتنوو، توٚہہِ گوٚو افسوس تہنٛدِ کرِمتہِ باپتھ تہٕ رُکیوو یہٕ کرنہٕ نِشہ۔ درحقیقت، کوٚرُو توٚہہِ تِتھٕ پٲٹھؠ تکلیف محسوس یمہِ سٟتؠ خدایس احترام چُھ واتان۔ لہٰذا چُھو نہٕ اسہِ توٚہؠ کُنہِ تہِ اصل چیزٕ نِشہ محروم تھٲوؠ مٕتؠ۔
\v 10 یہِ چُھ تکیازِ، ییٚلہِ لوٗکھ چھِ تکلیف محسوس کران یتھٕ پٲٹھؠ خدایس چُھ عزت واتان، امہِ سٟتؠ چُھ تِمن افسوس گژھان تہنٛدِ کَرِمتہٕ باپتھ تہٕ کرن بند یہِ کرُن۔ تمن چُھنہٕ افسوس زِ تمن ووت تکلیف، تکیازِ تمن بچاونہٕ خٲطرٕہ چُھ خدا تِمن استعمال کران زِ تِمہٕ کیُتھ چھِ محسوس کران۔ تاہم، ییٚلہِ لوکھ زیادٕ تر لوٗکن ہنٛد طریقہٕ تکلیف محسوس چھِ کران، تم کیُتھ چھِ محسوس کران چھِ بالآخر تمن مرنک سبب بنان۔
\v 11 یوٚت تام تُہنٛد تعلُق چُھ، ییٚلہ توٚہہِ یتھِ پٲٹھؠ تکلیف چُھ واتان یمہِ سٟتؠ خدایس عزت چُھ واتان، امہِ سٟتؠ چُھو توٚہؠ واریاہ بے تاب سپدان صحیح کرنہٕ خاطرٕ۔ توٚہہِ مونو نہٕ زِ توٚہؠ ٲسِو قصوروار۔ توٚہؠ ٲسِو مایوس یہِ تہِ سپُدمُت اوس۔ توٚہہِ اوس خوف یہِ کینٛژھا تہِ سپدِ۔ توٚہؠ ٲسِو یژھان اسہِ وچُھن۔ توٚہہِ کٔرٕو کوشش اسہِ عزت کرنٕچ۔ توٚہہِ دِتُو تمِس شخصس سزا یمؠ غلط اوس کوٚرمُت۔ تمام تِم چیز کرنہٕ سٟتؠ، چُھو توٚہہِ ہومُت زِ توٚہہِ چُھو تہِ کوٚرمُت یہِ صحیح چُھ تٔمکِس جوابس منٛز یہِ سپُدمُت چُھ۔
\v 12 لہٰذا، ییٚلہِ مےٚ توٚہہِ پتِم نامہٕ سوز، بہٕ اوسُس نہٕ بنیٲدی طور تمِس نفرس سٟتؠ رٲبطہٕ کران یمؠ تہِ اوس کوٚرمُت یہِ غلط اوس۔ امہِ علاوٕ اوسُس نہٕ بہٕ بنیٲدی طور تمِس نفرس سٟتؠ تہِ رٲبطس منٛز یمِس تٔمؠ دۅکھ اوس دیُتمُت، بلکہ چُھ میون ارادٕ توٚہہِ یہٕ ہاونُک زِ توٚہؠ کٲتیاہ آنٛتھٕ چُھو سانہِ باپتھ صحیح کرنہٕ خاطرٕ یہِ خداین منظور کوٚر۔
\v 13 ییٚلہِ زن توٚہہِ یتھٕ پٲٹھؠ جواب دِتُو، توٚہہِ کٔرٕو اسہِ حوصلہٕ افزٲئی۔
\p درحقیقت، یوٚدوے توٚہہِ اسہِ حوصلہٕ افزٲئی کٔرٕو، أسؠ چھِ زیادٕ خوش اوٕ کِنؠ زِ توٚہہِ کِتھہٕ کِنؠ کوٚروُن طِطُس خوش۔ توٚہہِ کوٚرو یہِ ییٚلہِ توٚہہِ سارِوٕے أمِس تسلی تہٕ حوصلہٕ دِتُو۔
\v 14 أسؠ ٲسؠ خوش تکیازِ توٚہہِ کٔرو نہٕ مےٚ بدنٲمی ییٚلہِ زن مےٚ توٚہہِ مُتعلق طِطُسس عظیم کتھہٕ ونمژٕ آسہٕ۔ امہِ بجایہ لٔج طِطُسس پتاہ تِمن عظیم کتھن ہنٛز یِم اسہِ آسہٕ ژےٚ متعلق تَس ونمژٕ، آسہٕ بالکل پزٕ۔ یہٕ چُھ تِتھے پٲٹھؠ یتھٕ پٲٹھؠ پرٮ۪تھ کینٛہہ یہِ اسہِ ووٚن اوس پوٚز۔
\v 15 طِطُس چُھ یاد پاوان زِ توٚہہِ کِتھ پٲٹھؠ کٔرٕو سٲنؠ اطاعت، خصوصاً ییٚلہِ سُہ آو توٚہہِ کیُتھ خوف اوس۔ امہِ وجہہ کِنؠ چُھ سُہ وۅنؠ تُہنٛد زیادٕ خیال تھاوان۔
\v 16 بہٕ چُھس خۅش زِ مےٚ چُھ پوٗرٕ یقین زِ توٚہؠ چُھو تہِ کران یہِ صحیح چُھ۔
\c 8
\p
\v 1 میٲنیو ایماندار سٲتھیو، أسؠ چُھو توٚہہِ یہِ ونُن یژھان زِ خداین کیا کرنس لایق چھےٚ پننہِ فضلہٕ سٟتؠ مکدُنیہ صوبچؠ اکھ ایماندار جماتھ بنٲومٕژ۔
\v 2 یوٚدوے زن تِمو بڈٕ عِذا تُلؠ یِمو تُہنٛد ردِ عمل آزمو۔ تِم رودؠ اتھہٕ مُژرِتھ تہ یہِ کران رودؠ تِم خوش ہرگاہ زن تِمن پانس کمےٕ اوس۔
\v 3 بہٕ ہیٚکہٕ پزرٕ سان یہِ ؤنِتھ زِ تِمو کوٚر تہِ سورےٕ پیش یہِ پیش کرُن لایق اوسکھ، بلکہِ پننہِ سکتہٕ علاوٕ تہِ۔ یہِ تِمو کوٚر تہِ ژور تِمو پانہٕ۔
\v 4 یہِ تِمن دیُن اوس تہِ قبول کرناونہٕ باپتھ رودؠ تِم اسہِ پتے۔ تِم ٲسؠ خدایہِ سنٛدٮ۪ن لوٗکن ہنٛز خدمت کرنہٕ کِس کارس منٛز شریک روزُن یژھان۔
\v 5 تِمو کوٚر سانہِ امید کھۅتہٕ ژوٚر اسہِ پیش۔ تِمو تھوو پنُن پان آیہِ تن گۅڈٕ خداوند یسوع سنٛزِ خدمت باپتھ امہِ پتہٕ سانہِ باپتھ تہِ۔ یعنی یتھٕ پٲٹھؠ زن خدا یژھان چُھ۔
\v 6 اوٕ کِنؠ کٔر اسہِ طِطُسس حوصلہٕ افزٲیی زِ سُہ انٛزراوِ تُہنٛد دیُت قبول کٔرِتھ یہِ کٲم۔ یۅسہ تٔمؠ برونٛٹھےٕ خاص پٲٹھؠ شروع ٲس کٔرمٕژ۔
\v 7 یوٚت تام تُہنٛد سوال چُھ، توٚہؠ چُھو واریہو لِکھو پنٕنؠ پنٕنؠ کٲم رٕتؠ پٲٹھؠ انٛد واتناوان۔ اتھ منٛز چھےٚ شٲمل خدایس پٮ۪ٹھ تہنٛز پژھ تہِ۔ تہٕ بیٚیہِ یہِ توٚہؠ ونان چُھو، یوٗت کینٛژا توٚہؠ زانان چُھو، بیٚیہِ توٚہؠ کٲتیاہ پُر جوش چُھو صحیح کٲم کرنہٕ باپتھ تہٕ أسؠ کوتاہ چُھو توٚہہِ لول بران۔ اوے تہِ پزِ توٚہہِ پننٮ۪ن ایماندار سٲتھین ہنٛدِ باپتھ وژھٕ وٲنجہِ خٲرات کرُن۔
\v 8 بہٕ چُھسو نہٕ توٚہہِ حکم دِوان پونٛسہٕ دِنہٕ باپتھ بلکہِ چُھس بہٕ یہِ ہاوُن یژھان زِ توٚہؠ چُھو پزنہٕ پٲٹھؠ واے بران سٲتھی ایماندارن ہنٛدِ باپتھ، تُہنٛد مقابلہٕ تِمن سٟتؠ کٔرِتھ یِم ہر وِزِ خٲرات کرنس تیار چھِ روزان۔
\v 9 توٚہہِ پزِ خٲرات کرنہٕ باپتھ ہر وِزِ تیار روزُن تکیازِ توٚہہِ پزِ ژٮ۪تراوُن زِ سٲنؠ خداوندن یسوع مسیحؔ ہن کِتھہٕ پٲٹھؠ تھوو توٚہہِ مدد کرنہٕ باپتھ پرٮ۪تھ کینٛہہ آیتن۔ تٔمؠ کوٚر یہِ یوٚدوے تس واریاہ کینٛہہ اوس۔ تٔمؠ یوٚژھ توٚہہِ پننہِ اتھہٕ سٲری چیز دِنؠ یِم تس نِش ٲسؠ۔
\v 10 بہٕ چُھسو توٚہہِ خٲرات کرنس متعلق چھرا پنٕنؠ راے دِوان، تکیازِ میٲنؠ راے بوزُن کرِ توٚہہِ مدد۔ پتمہِ وریہ یوٚژھو توٚہہِ تہٕ کوٚرو شروع خٲرات دیُن۔
\v 11 وۅنؠ پزِ توٚہہِ یہِ پنٕنؠ کٲم خٲرات کرنٕچ انٛد واتناوٕنؠ۔ یِتھے پٲٹھؠ سپدِ تُہنٛد یژھُن تُہنٛدس کرنس موٲفق۔ تہِ زن گو پننہِ آسنہٕ منٛزٕ کینٛہہ دیُن۔
\v 12 خدا چُھ وۅنؠ قبول کران یہِ لوٗکھ دِن پننہِ آسنہٕ منٛزٕ، نہ زِ تمہِ منٛزٕ یہِ تِمن چُھ یی نہٕ۔ یہِ چُھ پوٚز یوٚتام لوٗکھ دِنہٕ باپتھ تیار روزن۔
\v 13 تہٕ یہِ گو نہٕ زِ بہٕ چُھس یژھان توٚہہِ عِذا دیُن ییٚلہِ باقےٕ ایماندار پننِس مزس منٛز روزن۔ بلکہِ چُھس بہٕ یژھان زِ ایماندار باگراون برابری سان یہِ تِمن نِش چُھ۔
\v 14 فِلحال یہِ توٚہہِ نِش زیادٕ آسہ تہِ ہیٚکہِ اتھہٕ روٚٹ کٔرِتھ کم آسن والیٚن لوٗکن۔ تہٕ پتہٕ ییٚلہِ تِمن لوٗکن تہِ زیادٕ بنہِ تِم ہیٚکن توٚہہِ اتھہٕ روٚٹ کٔرِتھ کم آسنہٕ وِزِ۔ یتھٕ پٲٹھؠ بنن سٲری ایماندار پانہٕ وٲنؠ ٲگرن بٲگرن کٔرِتھ اکھ أکِس برابر۔
\v 15 أسؠ چھِ یژھان اتھ تِتھے پٲٹھؠ یتھٕ پٲٹھؠ زن کٔمؠ تام لیٚوکھمُت چُھ ییٚلہِ خداین پننہِ قوت سان اسرائیل ین غذا سوز:
\q1 "یِمن لوٗکن واریاہ اوس تِمن اوسنہٕ پننہِ ضرورتہٕ ژوٚر۔
\q1 یِمن کمےٕ اوس تِمن اوسنہٕ پننہِ ضرورتہٕ کم۔"
\p
\v 16 أسؠ چھِ خدایہِ سُنٛد شکُر کران طِطُسس تُہنٛد پرواہ برنکہِ غرضہٕ ۅوٹہِ اننہٕ باپتھ، یتھٕ پٲٹھؠ زن اسہِ تہِ تُہنٛد پرواہ چُھ۔
\v 17 سُہ چُھ بے شک توٚہہِ سمکھنہِ یِوان یمہِ کِنؠ تہِ زِ تٔمؠ تھوو یہِ کرنہٕ باپتھ سٲنِس وننس کن۔ وۅنؠ گو زیادٕ پہن اوس سُہ پانہٕ پُر جوش تُہنٛد پرواہ برنہٕ باپتھ تہٕ تٔمؠ کوٚر پانہٕ توٚہہِ سمکھنُک اِرادٕ۔
\v 18 اسہِ ژور پنُن اکھ ایماندار سٲتھی طِطُسس سٟتؠ گژھنہٕ باپتھ۔ ایماندارن ہنٛزٕ واریاہ جمٲژ چھےٚ امسنٛز امہِ کامہِ ہنٛدؠ تعریف کران۔ امہِ وجہ سٟتؠ زِ سُہ کیا چُھ کران رٕژِ شیٚچھِ باپتھ۔
\v 19 امہِ علاوٕ ژور سُہ ایماندارو ہنٛزو جمٲژو مےٚ سٟتؠ سفرٕ باپتھ۔ سُہ چُھ اسہِ خٲرات رنگؠ یروشلم شہرکٮ۪ن ایماندارن ہنٛدِ خٲطرٕ پونٛسہٕ رٹنس منٛز اتھہٕ روٚٹ کران۔ یہِ پونٛسہٕ قبول کرُن چُھ خداوند خدایس عزت بخشان۔ تہٕ یہِ ہاوان زِ أسؠ کٲتیاہ جوشہٕ ۂتؠ چھِ ایماندار سٲتھین ہُنٛد پرواہ برنس منٛز۔
\v 20 اوے چھِ أسؠ تہِ کران یمہِ سٟتؠ أسؠ باقین پننہِ اتھہٕ پونٛسہٕ رٹنچہِ کامہِ پٮ۪ٹھ تنقید کرنہٕ نِشہ پوٚت رٹو۔ یُس لوکو دِل کھولِتھ دیُت۔
\v 21 یہِ زن توٚہؠ پانہٕ تہِ وُچِھتھ ہیٚکو، یہِ پونٛسہٕ رٹنچ کٲم شروع کرنہٕ برونٛہہ کٔر اسہِ رٕتؠ پٲٹھؠ پونٛسہٕ جمع کرنہٕ باپتھ پوٗرٕ منصوبہ بندی۔ اسہِ تھوو نظرِ تل یہِ خداوند خدا یژھان چُھ، مگر اسہِ تھوو یِتہِ نظرِ تل یہِ زن باقےٕ لوٗکھ یژھان چھِ۔
\v 22 اسہِ چُھ ژورمُت بیاکھ ایماندار سٲتھی طِطُسس تہٕ باقےٕ لوٗکن سٟتؠ گژھنہٕ باپتھ یتھ متعلق بہٕ لٔگؠ تھےٕ ونان رودُس۔ اسہِ پرکھوو سُہ تہٕ اسہِ چُھ پوٗرٕ یقین زِ سُہ چُھ خدایہِ سنٛز خدمت کرنہٕ باپتھ پزنہٕ پٲٹھؠ جوشہٕ ہوٚت۔ پزر گو تس چُھ سٮ۪کہٕ اعتماد زِ توٚہؠ کٔرِو ہر وِزِ صحی، فلحال چُھ سُہ توٚہہِ سٟتؠ خدمت کرنُک جوش ہٮ۪تھ۔
\v 23 بہٕ چُھس یِمن سارنےٕ ہنٛز سُفٲرِش کران طِطُس چُھ میٲنِس کرنس کراونس منٛز میون شریک تہٕ مےٚ سٟتؠ سٟتؠ تُہنٛز خدمت کرنہٕ باپتھ۔ ایماندارن ہنٛزِ جمٲژ چھےٚ باقےٕ دوٚن ایماندارن سوزان تہٕ یِم چھِ مسیحؔ سُنٛد احترام کران۔
\v 24 اوے تہِ ہٲیِو یِمن تریٚن نفرن تہٕ باقےٕ ایماندارن ہنٛزن جمٲژن زِ توٚہؠ پزنہٕ پٲٹھؠ ایماندارن ساتھین ہُنٛد واے بران تہٕ توٚہہِ متعلق سانہِ بجہٕ کتھہٕ چھےٚ بلکل پزٕ۔
\c 9
\p
\v 1 پزر گو، مےٚ چھنہٕ ضرورت توٚہہِ یہِ وننچ زِ أسؠ کِتھہٕ پٲٹھؠ چھِ یروشلم شہرس منٛز خدایہِ سنٛدٮ۪ن لوٗکن خدمت کران۔
\v 2 اوِ کِنؠ زِ بہٕ چُھس خٲرات دِنہٕ باپتھ تُہنٛد جوش پرزٕناوان۔ پوٚز گو بہٕ چُھس توٚہہِ متعلق تھزٕ تھزٕ کتھہٕ ونان مکدُنیہ علاقہٕ کٮ۪ن ایماندارن۔ بہٕ چُھس تِمن ونان زِ توٚہؠ اخیہ جایہِ ہنٛدؠ ایمان وٲلؠ ٲسِو پتمہِ وریہ پیٚٹھےَ دِنہٕ باپتھ تیار۔ خٲرات دِنہٕ باپتھ تہنٛز بے تٲبی ہُنٛد بوزِتھ میجؠ اتہِ تہِ واریہن امہِ باپتھ ہٮ۪متھ۔
\v 3 وۅنؠ گو یوٚدوے زن أسؠ تہنٛز بے تٲبی زانان چھِ اسہِ ژٲرؠ یِم ترےٚ ایماندار سٲتھی توٚہہِ سمکھنہِ یِنہٕ باپتھ تاکہِ یہِ بناوو یقینی زِ یِمہٕ تھزٕ کتھہٕ أسؠ تہنٛزِ بے تٲبی متعلق ونان چھِ نیرن پزٕ۔ تِمہٕ چھِ توٚہہِ سمکھنہِ یِوان تاکہِ توٚہؠ واتنٲیو انٛد یہِ خٲرات دِنٕچ کٲم تہٕ یتھٕ پٲٹھؠ ؤسِو تِمن کتھن پٮ۪ٹھ پوٗرٕ یِم مےٚ توٚہہِ متعلق مکدُنیہ کٮ۪ن لوٗکن ونہِ۔
\v 4 دویمہِ پاسہٕ سونٛچِو یِتہِ زِ تیٚلہِ کیا ہیٚو بنہِ یوٚدوے مکدُنیہ صوبٕکؠ کینٛہہ ایماندار مےٚ سٟتؠ توٚہہِ سمکھنہِ یِن تہٕ وچُھن زِ خٲرات دِنچ تہٕ سۅمبراونچ کٲم چھےٚ وُنہِ تہِ انٛد واتنےَ۔ تُہنٛد امہِ کرنہٕ کِنؠ یِمو أسؠ مندچھاونہٕ تہٕ توٚہؠ تہِ سپدِو یقیناً شرمسار۔
\v 5 یی نظرِ تل تھٲوِتھ کوٚر مےٚ فٲصلہٕ زِ مےٚ چھےٚ ضرورت یِمن ترین ایماندار سٲتھین یہِ وننچ زِ تم نیرن توٚہہِ سمکھنہِ میانہِ کرنہٕ برونٛہہ تہٕ کرن توٚہہِ کامہِ منٛز اتھہٕ روٚٹ یہِ توٚہہِ ووٚنو زِ توٚہؠ دِیو۔ یتھٕ پٲٹھؠ آسیٚو توٚہہِ تہِ سورےٕ أنٛزرومُت یہِ توٚہؠ دِوان چُھو تکیازِ یہِ کرُن چُھو توٚہؠ پانہٕ یژھان۔ نہ زِ اوٕ کِنؠ زِ أسؠ چُھو توٚہہِ یہِ کرُن مانراوان۔
\v 6 اکھ مِثال بوزِو یہِ شٮ۪کلاوِ توٚہہِ زِ دیُن کِتھہٕ پٲٹھؠ چُھ۔ ییٚلہِ کٔمِلؠ کینٛژےٕ بیلؠ پھٔلؠ چھِ ووان، تِم لوٚنن کمےٕ فصل۔ ییٚلہِ کٔمِلؠ واریاہ بیول ووَن، تِم لوٚنن واریاہ فصٕل ہردٕ۔ یِتھے پٲٹھؠ ییٚلہِ توٚہؠ باقےٕ لوٗکن مدد کٔرِو، کانٛہہ نتہٕ کانٛہہ کرِ توٚہہِ تہِ مدد ضرورتہٕ وزِ۔
\v 7 توٚہہِ پزِ پرٮ۪تھ أکِس پانے خٲرات کرنُک رقم پننہِ باپتھ مقرر کرُن زِ کوتاہ دِیو۔ مہٕ کٔرِو مقرر زِ کوتاہ چُھ دیُن تکیازِ نتہٕ سپدِ توٚہہِ شرمندگی یا توٚہہِ چُھ یہِ دِنےُ دیُن۔ بہٕ چُھسو ونان تہِ تکیازِ خدا چُھ تِمن لوٗکن ہُنٛد واے بران یِم خوشی سان دِن۔
\v 8 خدا ہکیٚو توٚہہِ پننٮ۪و حاجتو ژوٚر دِتھ۔ توٕ کِنؠ آسیٚو توٚہہِ ہر وِزِ مویسر تہِ یہِ کُنہِ تہِ حالٔژ منٛز توٚہہِ حاجت آسہ، توٚہؠ ہیٚکو ہمیشہٕ پرٮ۪تھ کینٛہہ رُت کٔرِتھ۔
\v 9 توٚہؠ ہیٚکو ؤنِتھ تہِ چُھ پوٚز اوٕ کِنؠ زِ کٔمؠ تام چُھ لیٚوکھمُت یِتھِس کٲنٛسہِ انسانس متعلق صحیفن منٛز،
\q1 "تِم چھِ دِوان خٲرات واریہن لوٗکن۔
\q1 آ، تِم چھِ حاجت مندن اتھہٕ شہلاوان۔
\q1 تِم کرن ہر وِزِ رُت تہٕ صحی۔"
\p
\v 10 خدا چُھ ووَن وٲلِس بیول دِوان تہٕ سُہ چُھ لوٗکن کھٮ۪نہٕ باپتھ غذا تہِ دِوان۔ لہٰذا دِیہ سُہ تہِ یہِ توٚہہِ حاجت آسہ اکھتُے تمہِ ژوٚر۔ مزید ییٚلہِ توٚہؠ درُست قدم تُلِو سُہ پکناوِ توٚہہِ رٕتؠ چیز حٲصِل کرنس کُن۔
\v 11 خدا چُھ لٔگؠ تھےٕ تہنٛدِ ضرورتہٕ کھۅتہٕ ژوٚر بخشن وول تاکہِ توٚہؠ تہِ دِیو اتھہٕ مُژرِتھ باقین لوٗکن۔ ییٚلہِ توٚہؠ اتھہٕ مُژرِتھ دِوان چُھو أسؠ چھِ تہنٛدؠ تحفہٕ باقےٕ ایماندار سٲتھین تام واتناوان تہٕ تِم چھِ شکُر کران خدایہِ سُنٛد۔
\v 12 پوٚز گو ییٚلہِ توٚہؠ خدایہِ سنٛدٮ۪ن لوٗکن یروشلم شہرس منٛز خدمت کران چُھو تِمن خٲرات دِتھ، یہِ چُھ تہِ فراہم کران یہِ تِمن ضرورت چُھ۔ حالانکہ امہِ کھۅتہٕ تہِ ژوٚر، امہِ سٟتؠ چھِ تِم خدایہِ سُنٛد سٮ۪ٹھا شُکُر کران۔
\v 13 توٚہؠ چُھو خدایہِ سنٛدٮ۪ن لوٗکن ۂنٛز خدمت کٔرِتھ پنُن پان ثٲبت کران یروشلمس منٛز۔ لہٰذا، تِم کرن خدایس عزت تکیازِ توٚہؠ چُھو دراصل تی کران یہِ مسیحؔ ہس متعلق رٕژِ شیٚچھِ ضرورت چھےٚ، یۅسہ سۅے رٕژ شیٚچھ چھےٚ یۅسہ توٚہؠ ونان چُھو زِ تتھ پٮ۪ٹھ چُھو توٚہہِ بھروسہٕ۔ تِم کرن خدایس عزت امہِ وجہ کِنؠ تہِ زِ توٚہؠ چُھو فراخ دِلی سٲتؠ بٲگران تِمن سٟتؠ تہٕ سارنےٕ ایماندارن سٟتؠ یہِ توٚہہِ نِش چُھ۔
\v 14 امہِ مزید، تِم یژھن توٚہہِ وچُھن تکیازِ تِم چھِ توٚہہِ خٲطرٕ دُعا کران، تکیازِ توٚہؠ چُھو سٮ۪ٹھا مہربٲنی سان دِوان یتھٕ کِنؠ خدا توٚہہِ اتھ لایق بناوان چُھ۔
\v 15 أسؠ چھِ خدایہِ سُنٛد شکُر ادا کران زِ تٔمؠ دِتؠ اسہِ یِم چیز یِم زیادٕ اصل چھِ تٔمہِ کھۅتہٕ یہِ أسؠ ؤنِتھ ہیٚکو۔
\c 10
\p
\v 1 وۅنؠ کرٕ بہٕ پولُسؔ پانس متعلق کتھ۔ بہٕ چُھسو توٚہہِ بڈٕ عٲجزی تہٕ ویژھیہِ سان تہِ کرنہٕ باپتھ زور دِوان یہِ درُست چُھ یتھٕ پٲٹھؠ مسیحؔ نرم تہٕ فہمہٕ وول اوس۔ کینٛہہ لوٗکھ چھِ ونان ییٚلہِ بہٕ خۅد توٚہہِ سٟتؠ اوسُس، بہٕ اوسُس توٚہہِ سٟتؠ بڈٕ نرم، مگر وۅنؠ ییٚلہِ بہٕ توٚہہِ دوٗر چُھس، بہٕ چُھس توٚہہِ سٟتؠ زبردستی سان آسان۔
\v 2 مےٚ چُھنہٕ زبردستی ہُنٛد اِرادٕ آسان ییٚلہِ بہٕ تِمن لوٗکن دلیری سان بُتھِ لگان چُھس یِم یہِ سونچان چھِ زِ بہٕ تہٕ تِم یِم خدمت چھِ کران چھِ چھرا جسمٲنی تقاضو عمل کران۔ اوے چُھسو بہٕ توٚہہِ ونان تہِ کرُن یہِ درُست آسہ تاکہِ مےٚ پیٚیہِ نہٕ توٚہہِ سٟتؠ تہِ کانٛہہ زبردستی کرٕنؠ ییٚلہِ بہٕ توٚہہِ سمکھنہِ یِمہٕ۔
\v 3 پزر گو یہِ زِ یوٚدوے أسؠ انسٲنی عمل کران چھِ مگر أسؠ چھِنہٕ یہِ کرنہٕ باپتھ پنُن بچاو انسٲنی لِکھو کران۔
\v 4 پوٚز چُھ یہِ زِ أسؠ چھِنہٕ باقےٕ انسانن ہنٛدؠ پٲٹھؠ تِمو چیزو سٟتؠ پنُن بچاو کران یہِ زن تِم کران چھِ۔ بلکہِ چُھ اسہِ خدا قوت بخشان یُس أسؠ پنُن بچاو کرنہٕ باپتھ ورتاوان چھِ۔ تاکہِ أسؠ دِمو شِکس تتھ یہِ باقےٕ لوٗکھ پنٕنؠ کِنؠ مظبوط دلیلہٕ پیش چھِ کران۔
\v 5 أسؠ چھِ تِمن سارنےٕ چیزن ہارناوُن یژھان یِمن لوٗکھ خدا زاننہٕ کھۅتہٕ تھوٚد درجہٕ دِوان چھِ۔ مزید چھِ أسؠ لوٗکن ہنٛدٮ۪ن سونٛچن متٲثِر کٔرِتھ تِمن مسیحؔ سُنٛد فرمانبردار بناوٕنؠ یژھان۔
\v 6 یمہِ وِزِ توٚہؠ مسیحؔ سٕنٛدؠ مکمل فرمانبردار بٔنیو، أسؠ سپدو تیار سارنےٕ نافرمانن سزا دِنہٕ باپتھ۔
\v 7 سونٛچِو تتھ پٮ۪ٹھ یہِ بلکل صاف تہٕ واضیح چُھ۔ فرض کرو زِ لوٗکن چُھ یقین زِ تِم چھِ مسیحؔ سٕنٛدؠ نمایندٕ۔ یِتھٮ۪ن لوٗکن پزِ ژٮ۪تس تھاوُن زِ أسؠ تہِ چھِ مسیحؔ سنٛدؠ نمایندٕ یتھٕ پٲٹھؠ تِم تہِ چھِ۔
\v 8 یقیناً چُھس نہٕ بہٕ پانس کانٛہہ عزت والان یوٚدوے بہٕ بجہِ بجہِ کتھہٕ کران چُھس زِ خداوند یسوعنؔ کِتھہٕ پٲٹھؠ بنٲوؠ أسؠ پنٕنؠ نمایندٕ۔ تٔمؠ کوٚر یہِ تاکہِ أسؠ ہیٚکو توٚہہِ حوصلہٕ افزٲیی تہٕ مدد کٔرِتھ خدایس پٮ۪ٹھ پوٗرٕ پژھ کرنہٕ باپتھ، نہ زِ توٚہہِ خدایس پٮ۪ٹھ پژھ تھآونہٕ نِشہ مُچھِ تھٲوِتھ۔
\v 9 لہٰذا، ہیٚکو توٚہؠ ؤنِتھ زِ بہٕ چُھس نہٕ توٚہہِ کھوٚژناوان ییٚلہِ بہٕ توٚہہِ یِم نامہٕ زبردستی سان سوزان چُھس۔
\v 10 بہٕ چُھس یہِ لیٚکھان اوٕ کِنؠ زِ کینٛہہ لوٗکھ چھِ مےٚ متعلق ونان، "سُہ چُھ اسہِ سخ تہٕ تیز نامہٕ سوزان۔ مگر ییٚلہِ سُہ اسہِ سٟتؠ آسان چُھ تیٚلہِ چُھ نرم آسان تہٕ لۅژِ آوازِ منٛز کتھ کران۔"
\v 11 یِمہٕ لوٗکھ یِژھٕ کتھہٕ کران چھِ تِمن پزِ زانُن زِ أسؠ یہِ تہنٛدِ ناوٕ یِمن نامن منٛز دوٗر روزِتھ لیٚکھان چھِ۔ تہِ چُھ برابر تی یہِ توٚہہِ سٟتؠ روزِتھ سٲنؠ عمل درشاوان چھےٚ۔
\v 12 أسؠ چھِ بڈٕ انکسٲری سان ونان زِ أسؠ تہِ چھِ تِمنےٕ لوٗکن ہنٛدؠ پٲٹھؠ رٕتؠ خٲر یژھن وٲلؠ یِمن توٚہؠ زانان چُھو یِم پانس بھروسہٕ منٛد ونان چھِ۔ تِم لوٗکھ چھِ احمق ییٚلہِ تِم پانس عظیم ونان چھِ تِم چھِ بس پانس کُن وُچھان۔
\v 13 اتھ اُلٹہٕ چھِنہٕ أسؠ پانس متعلق کانٛہہ تِژھ تٔھز کتھ لاگان یِنہٕ أسؠ عملن چھِ۔ بلکہِ چھِ أسؠ ضرور تِمہٕ تھزٕ کتھہٕ پانس کُن لاگان یِمہٕ اسہِ خدا دِلس سٟتؠ ہِشراوان چُھ۔ اتھ منٛز چھےٚ سۅ عمل تہِ شٲمل یۅسہ أسؠ تہنٛزِ حٲضری منٛز کران چھِ۔
\v 14 پوٚز گو یوٚدوے أسؠ پزنہٕ پٲٹھؠ توٚہہِ سمکھیمٕتؠ ٲسہٕ ہُو نہ یہِ زن خداین اسہِ کرنُک توفیق دیُتمُت اوس، أسؠ کرہو نہٕ توٚہؠ اتھ منٛز شٲمل۔ بے شک، چھِ أسؠ پزی توٚہہِ برونٛٹھےٕ سمکھیمٕتؠ تہٕ چھیٚو توٚہہِ ؤنؠ مٕژ مسیحؔ ہس متعلق رٕژ شیٚچھ۔
\v 15 أسؠ چھِنہٕ پانس متعلق تھزٕ تھزٕ کتھہٕ ونان امہِ کِنؠ زِ باقےٕ کیا چھِ کران بلکہ امہِ کِنؠ زِ أسؠ کیا چھِ کران۔ پوٚز گو زِ أسؠ چھِ پُر اعتماد زِ خدا دِیہ اسہِ توٚہہِ سٟتؠ زیادٕ رُت کرنُک توقفیق۔ یہِ سپدِ تیٚلی ممکن ییٚلہِ توٚہؠ خدایس پٮ۪ٹھ دٔر پژھ تھٲیو۔
\v 16 یتھٕ پٲٹھؠ ہیٚکو أسؠ رٕژ شیٚچھ تِمن لوٗکن تام واتنٲوِتھ یِم تہنٛدِ نِشہ تہِ سانہِ کھۅتہٕ تہِ دوٗر روزان چھِ۔ اوے چھِ أسؠ یہ کرنُک اِرادٕ کران امہِ بجایہ زِ پانس متعلق کرو تھزٕ کتھہٕ تکیازِ یہِ زن باقےٕ لوٗکو چُھ کوٚرمُت یہِ تِمن خداین کٲم کرنُک توفیق بخُش۔
\v 17 پرٮ۪تھ کٲنٛسہِ پزِ تی کرُن یہِ یرمیاہ نبین لیٚوکھ،
\q1 پرٮ۪تھ کانٛہہ یُس تھزٕ کتھہٕ ونہِ پزن یِمہٕ کتھہٕ خداوند خدایس کُن لاگنہِ۔"
\p
\v 18 پرٮ۪تھ کٲنٛسہِ پزِ یہِ کرُن تکیازِ خداوند یسوع چُھ تِمن مازان یِم بھروسہٕ منٛد آسن۔ نہ زِ تِمن یِم چھرا تھزٕ تھزٕ کتھہٕ کرن پانس متعلق۔
\c 11
\p
\v 1 امہِ پتہٕ، مےٚ چھےٚ امید زِ توٚہؠ روزیٚو صبرٕ سان مےٚ سٟتؠ میانہِ یِمہٕ کتھہٕ بوزان یِمہٕ میانہِ لِکھہٕ ھنا لوٚت وایہِ چھےٚ۔ بہٕ چُھس زانان زِ توٚہؠ چُھ صبرٕ سان مےٚ سٟتؠ۔
\v 2 بہٕ ونہٕ لوٚت وایہِ کتھہٕ تکیازِ بہٕ چُھس تُہنٛد رٲچھ در۔ یتھٕ پٲٹھؠ زن خدا تُہنٛد رٲچھ در چُھ۔ پزر گو ییٚلہِ مےٚ توٚہہِ رٕژ شیٚچھ ؤنؠ زٲنؠ تو بہٕ اوسُس أکِس مٲلِس ہِیٚو یمؠ توٚہہِ بیٚیِس نفرس دِنُک وعدٕ کوٚر تس سنٛز خاندارِنؠ زٲنِتھ۔ یتھٕ پٲٹھؠ زن یہِ مول چُھ یژھان پننہِ کورِ چھرا امسےٕ أکِس نفرس سٟتؠ روزن۔ اوے چُھس بہٕ یژھان زِ توٚہؠ تھٲیو بس مسیحؔ ہس پٮ۪ٹھ پژھ۔
\v 3 وۅنؠ گو بہٕ چُھس کھوٚژان زِ توٚہہِ گوٚژھ نہٕ کانٛہہ ناوِ والُن یتھٕ پٲٹھؠ زن شیطانن حواؔ ناوِ وٲج۔ بہٕ چُھس کھوٚژان زِ یُتھ ہیٚو نفر انہِ تہنٛدِس تتھ سونٛچس کھُر یُس مسیحؔ سنٛزِ فرمانبردٲری منٛز بسِتھ چُھ۔
\v 4 بہٕ چُھس توٚہہِ متعلق پریشان تکیازِ بہٕ چُھس زانان زِ لوٗکھ یِن توٚہہِ سمکھنہِ تہٕ وننو یسوعسؔ متعلق، مگر یہِ چُھنہٕ سُہ یسوع یس متعلق اسہِ توٚہہِ ونُو۔ باقےٕ چُھو توٚہہِ روح پیش کران مگر یہِ چُھنہٕ سُہ پاک روح یُس اسہِ توٚہہِ پیش کوٚر۔ باقےٕ چُھو رٕژ شسچھ ونان مگر یہِ چھنہٕ سۅ رٕژ شیٚچھ یتھ پٮ۪ٹھ توٚہہِ گۅڈٕ یقین کوٚرُو۔ امہِ باوجود چُھو توٚہؠ صبرٕ سان ییٚلہِ لوٗکھ توٚہہِ یِمن چیزن متعلق ونان چھِ۔
\v 5 بہٕ چُھس یژھان زِ توٚہؠ کٔرِو تتھ پٮ۪ٹھ یقین یہِ اسہِ توٚہہِ گۅڈٕ ووٚن تکیازِ بہٕ چُھس سونچان زِ مسیحؔ چُھ تِتھے پٲٹھؠ میانہِ ذریعہ عمل کران یتھٕ پٲٹھؠ سُہ تہنٛدِ ذریعہ عمل کران چُھ یِم یہِ ونان چھِ زِ تِم چھِ یسوع سٕنٛدؠ بہترین نمایندٕ۔
\v 6 یوٚدوے زن مےٚ رٕتؠ پٲٹھؠ کتھہٕ کرنہِ ہٮ۪چھمژٕ چھیٚنہٕ امہِ باوجود چُھم ہیوٚچھمُت زِ پوٚز کیا چُھ۔ ییٚلہِ تہِ بہٕ ونہٕ یا کرٕ، بہٕ ہاوو پوٚز کیا چُھ۔
\v 7 توٚہؠ چُھو زانان زِ مےٚ کوٚر نہٕ کانٛہہ اتُر توٚہہِ سٟتؠ توٚہہِ کانٛہہ پونٛسہٕ نہ منٛگِتھ خدایہِ سٕنٛدِ طرفہٕ رٕژ شیٚچھ واتناونہٕ باپتھ۔ یہِ کرنہٕ سٟتؠ بنوو مےٚ توٚہہِ مقابلہٕ پنُن پان کم پایہ توٚہؠ زیادٕ اہم زاننہٕ باپتھ۔
\v 8 پزر گو یہِ زِ مےٚ میلؠ بدل ایماندار جمٲژو پٮ۪ٹھٕ پونٛسہٕ۔ مےٚ کٔرؠ تہنٛدؠ پونٛسہٕ قبول تاکہِ بہٕ ہیٚکہٕ تُہنٛز خدمت کٔرِتھ۔
\v 9 مزید ییٚلہِ بہٕ توٚہہِ نِش اوسُس، مےٚ اوسنہٕ پننہِ ضرورتُک پرٮ۪تھ کانٛہہ چیز میسر۔ مگر مےٚ دیُت نہٕ توٚہہِ کانٛہہ عِذا یِمو ضرورژو باپتھ پونٛسہٕ منٛگِتھ۔ مےٚ ہیوٚک یہِ کٔرِتھ اوٕ کِنؠ زِ مکدُنیہ پٮ۪ٹھٕ مےٚ سٟتؠ یوٚت سفر کرن والیٚو ایماندار سٲتھیٚو دیُت مےٚ ضرورتُک پرٮ۪تھ کانٛہہ چیز۔ بے شک کرو نہٕ بہٕ توٚہؠ کُنہِ تہِ وِزِ تہٕ کُنہِ تہِ حالژ منٛز تنگ پننہِ باپتھ پونٛسہٕ منٛگِتھ۔
\v 10 اخیہ صوبس منٛز کُنہِ جایہِ تہِ کانٛہہ تہِ روزن وول ہیٚکہِ نہٕ مےٚ تھزٕ کتھ وننہٕ نِشہ پتھ رٔٹِتھ۔ یتھ کتھہِ متعلق زِ مےٚ دیُت نہٕ توٚہہِ کانٛہہ عِذا۔ یہِ بہٕ توٚہہِ ونان چُھس تہِ چُھ تیوت پوٚز زنٛتہٕ مسیحؔ چُھ اتھ پانہٕ ونان۔
\v 11 میون توٚہہِ کانٛہہ عِذا نہ دِنُک مطلب چُھنہٕ یہِ زِ مےٚ چھنہٕ تُہنٛد پرواہ۔ خدا چُھ گواہ زِ بہٕ کوتاہ چُھس تُہنٛد پرواہ کران۔
\v 12 بلکہِ چُھ یِتہِ میون اکھ وجہ زِ بہٕ کیازِ کرَو نہٕ توٚہؠ ہٮ۪تھےٕ پریشان۔ تِتھٕ پٲٹھؠ دِمہٕ بہٕ کٲنٛسہِ تہِ ٲسس تھوٚپ یِم پانس متعلق تھزٕ تھزٕ کتھہٕ ونان چھِ یتھٕ پٲٹھؠ أسؠ پانس متعلق ونان چھِ۔ مےٚ چھےٚ خبر زِ کینٛہہ لوٗکھ چھِ یہِ کرُن یژھان۔
\v 13 یِم لوٗکھ چھِنہٕ تِم یِم مسیحؔ ہن پنٕنؠ رسول یا نمایندٕ بنٲوِتھ سوزؠ۔ یِم لوٗکھ چھِ پننہِ کرنہٕ کراونہٕ سٟتؠ لوٗکن دھوکہٕ دِوان۔ یِم چھِ چھرا مسیحؔ سنٛزِ نمایندگی ہُنٛد برٮ۪م دِوان۔
\v 14 یہُنٛد یہِ کرُن گژھِ نہٕ اسہِ حٲران کرُن۔ شیطان تہِ چُھ جلالہٕ وول روحٲنی وجود آسنُک برٮ۪م دِوان۔
\v 15 اوے تہِ پزِ اسہِ یہِ کتھ تہِ ژٮ۪تس تھاوٕنؠ زِ تِم یِم تمِس یعنی شیطانس خدمت کران چھِ تہِ ہیٚکن لوٗکن رٕژِ یا صحیح وتہِ پٮ۪ٹھ تھاونچہِ خدمژ ہُنٛد برٮ۪م دِتھ۔ چھیکرس دِیہ تِمن خدا پوٗرِ پوٗر ماوضہ پننہِ کرنُک۔
\v 16 بہٕ چُھس بیٚیہِ ونان یہِ مےٚ گۅڈے ووٚن۔ بہٕ چُھس یژھان زِ کانٛہہ زانہِ نہٕ مےٚ احمق۔ وۅنؠ گو یوٚدوے توٚہؠ مےٚ احمق زانان چُھو تیٚلہِ دِیو مےٚ کینٛژھا احمقٲزی کرنہٕ۔ یتھٕ پٲٹھؠ ہیٚکہٕ بہٕ تہِ کینٛہہ تھزٕ کتھہٕ پانس متعلق ؤنِتھ۔
\v 17 یہِ بہٕ وۅنؠ ونُن چُھس یژھان چُھنہٕ تہِ یہِ بہٕ خداوند یسوع سنٛز نمایندگی کرنہٕ وِزِ ونان چُھس۔ بلکہِ چُھس بہٕ احمقٲزی سان یہِ ثٲبت کرنہٕ باپتھ کتھ کران زِ بہٕ تہِ ہیٚکہٕ پانس متعلق تھزِ تھزٕ کتھہٕ کٔرِتھ۔
\v 18 بیٚہِ تہِ واریاہ لوٗکھ چھِ انسٲنؠ تقاضو کِنؠ تھزٕ تھزٕ کتھہٕ کران۔ اوے ونہٕ بہٕ تہِ پانس متعلق تھزٕ تھزٕ کتھہٕ۔
\v 19 بہٕ چُھس زانان زِ توٚہؠ تھٲیِو مےٚ کن۔ اوٕ کِنؠ زِ توٚہؠ چُھو پانس دانا لوٗکھ گنٛزران۔ اوے چُھو توٚہؠ لوت واے عمل کرن والیٚن لوٗلن خۅشی سان برداشت کران۔
\v 20 پزر گو یہِ زِ توٚہؠ چُھو روزان صبرٕ سان ییٚلہِ کینٛہہ لوٗکھ توٚہہِ سٟتؠ ویکھت ویوہار کران چھِ۔ تِم ما کرنو توٚہہِ مجبور تہنٛدِس پٮ۪ٹھ عمل کرنہٕ باپتھ۔ تِم ما ورتاون تہِ سورےٕ یہِ توٚہہِ چُھو۔ تِم ما والن توٚہہِ ناوِ تہِ۔ تِم ما ونن زِ تِم چھِ تہنٛدِ کھۅتہٕ بہتر۔ تِم ما والن توٚہہِ عزت۔ بہرحال توٚہؠ چُھو تِمن وُنہِ تہِ برداشت کٔرِتھ۔
\v 21 یوٚدوے توٚہہِ سٟتؠ سلوک کرنہٕ باپتھ طاقتور لوٗکن ہنٛز وتھےٕ درُست چھےٚ، تیٚلہِ چُھس بہٕ مانان زِ تٔمہِ ویوہار تہٕ سلوک باپتھ یُس اسہِ توٚہہِ سٟتؠ روا تھوو، چھِ أسؠ شرمسار تہٕ بیٚیہِ سٲنؠ کمزوری درشاوان۔ اتھ برعکس یہِ کینٛژا باقےٕ لوٗکو کرنُک بل ہوو۔ بہٕ تہِ ہیٚکہٕ تہِ کرنُک بل ہٲوِتھ۔ بہٕ چُھس یِمہٕ کتھہٕ اوٕ کِنؠ ونان تکیازِ بہٕ چُھس پننہِ احمقٲزی کِنؠ عمل کران۔
\v 22 تِم لوٗکھ چھِ ونان زِ تِم چھِ عِبرٲنؠ بولن وٲلؠ یہُودؠ۔ مگر بہٕ تہِ چُھس یہُودؠ تہٕ بولان عبرٲنؠ۔ تِم چھِ ونان تِم چھِ اسرائیلی، مگر بہٕ تہِ چُھس اسرائیلی۔ تِم چھِ پانس ابرہام سنٛدؠ زُرؠ ونان، مگر بہٕ تہِ چُھس اکھ زُر ابرہام سُنٛد۔
\v 23 تِم چھِ پانس مسیحؔ سٕنٛدؠ خدمت گار گنٛزران، مگر بےٕ چُھس تہنٛدِ کھۅتہٕ ژوٚر خدمت گار مسیحؔ سُنٛد۔ بے شک چُھس بہٕ أکِس دیوانہٕ سٕنٛدؠ پٲٹھؠ کتھ کران۔ بہرحال مےٚ چُھ تہنٛدِ کھۅتہٕ ژوٚر زُو ژوٚٹمُت۔ لوٗکو بوٚرُس بہٕ بٲنٛدؠ وان تہنٛدِ کھۅتہٕ ژرِ لٹہِ۔ لوٗکو دیُت مےٚ مار تہنٛدِ کھۅتہٕ ژوٚر۔ بہٕ مودُس واریاہ پھرِ۔
\v 24 بیوٚن بیوٚن پانٛژِ لٹہِ لایہِ نوو مےٚ یہُودؠ زِٹھیو کٔمس تام اتھِ زیادٕ کھوٚتہٕ زیادٕ کُنتٲجی پھرِ۔
\v 25 یِمو زِٹھیو والہٕ نٲوؠ مےٚ ترییو بیون بیون وِزو لوریٚو سٟتؠ۔ اکہِ پھرِ لایکھ مےٚ کنہِ مےٚ مارنہٕ باپتھ۔ ترٮ۪ن سفرن دوران پھچہِ سۅدرس تِمہٕ ناوے یِمن منٛز بہٕ سوار اوسُس۔ بہٕ رودُس سٕدرس منٛزباگ ژوُہن گٲنٹن زِنٛدٕ۔
\v 26 بہٕ چُھس اکثر سفر کران روزان۔ بہٕ چُھس وٲناکھ جایو پکان روزان، یِمن منٛز دریاو، سریہ، سیٚکِلؠ تہٕ سُدٕرؠ تہِ چھِ۔ یِمن جاین چھِ ہمیشہٕ تِم لوٗکھ آسان یِم مےٚ عِذا واتنٲوِتھ ہیٚکن، یِمن منٛز ژوٗر، یہُودؠ لوٗکھ، غٲر یہُودؠ لوٗکھ، تہٕ ایماندار آسنُک برٮ۪م دِنہٕ وٲلؠ لوٗکھ چھِ۔
\v 27 بہٕ چُھس پزی زُو ژٹان۔ بہٕ چُھس نہٕ اکثر پوٗرٕ شۅنگان تہِ۔ مےٚ چُھنہٕ پوٗرٕ کھٮ۪ن چٮ۪ن تہِ میلان۔ اکثر چُھس بہٕ بۅچھِ ہوٚتُے آسان۔ بعضے چُھس بہٕ تٟیرِ سٟتؠ شِٹھان۔ مےٚ چھِنہٕ پوٗرٕ پلو تہِ آسان۔
\v 28 باقےٕ چیزو علاوٕ یِم بہٕ بیان کٔرِتھ ہیٚکہٕ چُھس بہٕ فِکرِ منٛز روزان سارنےٕ ایماندار جمٲژن ہنٛدِ باپتھ۔
\v 29 ییٚلہِ کانٛہہ ایماندار سٲتھی لیٚوژ آسہ بہٕ تہِ چُھس لیٚوژےٕ روزان۔ ییٚلہِ کانٛہہ ایماندار سٲتھیس گنہس کُن نِیہِ مےٚ چُھ سخ شرارتھ کھسان۔
\v 30 اوٕ کِنؠ زِ مےٚ چھےٚ ضرورت پانس متعلق تھیٚکنٕچ، بہٕ چُھس یژھان تھیٚکُن زِ بہٕ کوتاہ لیٚوژ چُھس
\v 31 أسؠ سٲری کرو ہمیشہٕ تعظیم خدایہِ سُنٛد خداوند یسوع سٕنٛدِس ببس۔ سُہ ہیٚکہِ میانہِ کتھہِ سنَد بخشِتھ زِ بہٕ چُھس پوٚز ونان۔
\v 32 ییٚلہِ بہٕ دمشق شہرس منٛز اوسُس، بادشاہ ارِتاس سٕنٛدِ طرفہٕ مقرر مقٲمی حٲکمن لٲگؠ پنٕنؠ سِپاہ سٲرؠ سےٕ شہرس منٛز مےٚ ژھارنس تہٕ رٹنس۔
\v 33 مگر پننیٚو ایماندار سٲتھیو بچووُس بہٕ أمِس مقٲمی حٲکمہٕ سنٛزِ تُپہِ منٛز یِنہٕ نِش۔ تِمو بوٚرُس بہٕ أکِس بجہِ ٹوکرِ یہِ گٔنٛڈٕکھ أکِس رزِ تہٕ ترٲوٕکھ شہرچہِ قلایہ ہنٛزِ اکہِ دارِ کِنؠ بوٚن۔
\c 12
\p
\v 1 مےٚ چُھ پانس متعلق تھیٚکُنٕچ ضروٗرت۔ یوٚدوے یہِ کانٛہہ مدد کرِنہٕ، مگر بہٕ چُھس کتھ جٲری تھٲوِتھ زِ خداوند یسوعؔ کِتھہٕ پٲٹھؠ چُھ خصوصی طور مخصوس لوٗکن چیز ہاوان۔
\v 2 ژۅداہ ؤری برونٛٹھ، خداین کھول اکھ مسیحیؔ تریمِس آسمانس پٮ۪ٹھ۔ مےٚ چُھنہٕ پوٗرٕ پوٗرٕ پے زِ خداین نِوا سُہ کایہِ سان کنہٕ خوابس منٛز کُنہِ روحٲنی طور۔ چھرا زانہِ خدا یہِ کِتھہٕ پٲٹھؠ سپُد۔
\v 3 وۅنؠ ونہٕ بہٕ تس خاص مسیحؔ ہس متعلق دُبارٕ زیادٕ کتھہٕ وہرٲوِتھ۔ بہٕ ہیٚکہٕ نہٕ سٮ۪کہٕ پٲٹھؠ ؤنِتھ زِ خداین کھولا سُہ آسمان کِس تریمِس درجس پٮ۪ٹھ کایہِ سان کنہٕ خوابس منٛز یا روحٲنی طور۔ چھرا ہیٚکہِ خدایی یوت وثوقہٕ سان ؤنِتھ یہِ کِتھہٕ پٲٹھؠ سپُد۔
\v 4 خداین واتنوو سُہ جنتس منٛز تتھ جایہِ یتٮ۪تھ مودؠ مٕتؠ ایماندار ٲسؠ۔ اتہِ بوزٕ أمؠ بڈٕ حٲران کروٕنہِ کتھہٕ یِمہٕ سُہ بیٚیہِ کٲنٛسہِ ؤنِتھ ہیٚکہِ ہے نہٕ۔
\v 5 بہٕ ہیٚکہٕ تتھ متعلق واریاہ تھٮیکنل کتھہٕ ؤنِتھ اوٕ کِنؠ زِ یس متعلق بہٕ کتھ ونان اوسُس چُھس بہٕ پانہٕ۔ وۅنؠ گو، بہٕ تھٮ۪کہٕ چھرا یہِ زِ بہٕ کوتاہ لیٚوژ چُھس۔
\v 6 پوٚز گو، فرض کٔرِو زِ بہٕ چُھس نہٕ یژھان پانس متعلق تھیٚکُن۔ چونکہِ بہٕ چُھس ونان پزر بہٕ آسنہٕ احمقٲزی کران۔ یوٚدوے بہٕ فٲصلہٕ کرٕ زِ بہٕ تھٮ۪کہٕ نہٕ پانس متعلق، تتھ پٮ۪ٹھ پرکھاون مےٚ لوٗکھ چھرا میون وتھُن بیہُن تہٕ ونُن کرُن نظرِ تل رٔٹِتھ۔
\v 7 تہٕ اوے تہِ آو مےٚ خدایہِ سٕنٛدِ اِجازتہٕ پھرِ پھرِ بٔنِتھ تاکہِ بہٕ رٹنہٕ یِمو کتھو کِنؠ چاو زِ خداین کوٚر مےٚ پٮ۪ٹھ یِمن تھزن کتھن ہُنٛد اِظہار۔ خاص پٲٹھؠ اوٚن شیطان سنٛدِ طرفہٕ آمٕتؠ أکؠ بد روحن مےٚ بٔنِتھ تاکہِ یتھٕ پٲٹھؠ رٹنہٕ بہٕ چاو۔
\v 8 مےٚ ووٚن خداوند یسوعس تریٚیہِ پھرِ مےٚ پٮ۪ٹھ مصیبت ٹالنہٕ باپتھ۔
\v 9 تسُنٛد ونُن اوس اورٕ، "ییٚلہِ بہٕ ژےٚ سٟتؠ نرمی ورتاوٕ۔ ژےٚ روزی کیا امہِ علاوٕ حاجت۔ پزر گو بہٕ چُھس لوٗکن قوت بخشان ییٚلہِ تِم لیٚژؠ آسن۔ "اوے تہِ تھٮیٚکہٕ بہٕ ژوٚر ژوٚر زِ بہٕ کوتاہ لیٚوژ چُھس۔ یتھٕ پٲٹھؠ بناوِ مےٚ مسیحؔ ہر وِزِ طاقتہٕ سان عمل کرنس لایق۔
\v 10 اوے تہِ چُھس بہٕ خوش گژھان ییٚلہِ مےٚ کینٛہہ بٔنِتھ یِوان چُھ۔ توٕ کِنؠ زِ بہٕ چُھس خدمت کران مسیحؔ سنٛز۔ اتھ خدمژ منٛز چُھ شٲمل میون لیٚوژ آسُن، لوٗکن ہنٛزٕ یِژھٕ تہٕ تِژھٕ کتھہٕ، لوٗکن ہُنٛد مےٚ عِذا دیُن تہٕ پتہٕ لگُن ییٚلہِ بہٕ جدوجہد کران چُھس، بہٕ چُھس خوش تکیازِ خدا چُھ مےٚ قوت بخشان ییٚلہِ بہٕ لیٚوژ آسان چُھس۔
\v 11 بہٕ چُھس لگاتار احمقٲزی ونان۔ تہٕ یہٕ کرنووس بہٕ توٚہہِ۔ توٚہہِ اوٚنُو مےٚ ژٮ۪ل تاکہِ توٚہؠ روزیٚو مےٚ بھروسہٕ منٛد یا معتبر زانان وۅنؠ گو توٚہؠ چُھو نہٕ یہِ ونان مگر توٚہہِ پزِ یہِ ونُن توٕ کِنؠ زِ بہٕ تہِ چُھس تیوتاہ عظیم یوٗتاہ تِم لوٗکھ چھِ یِم پانس مسیحؔ سٕنٛدؠ بہترین نمایندٕ ونان چھِ۔ یہِ چُھ پزر یوٚدوے زن بہٕ ہرگِز شانہٕ بوٚڈ چُھس نہٕ۔
\v 12 بہٕ رودُس پننہِ عملہِ منٛز دٔرِتھ۔ یُس یہِ ثٲبت کران چُھ تہنٛدِ باپتھ زِ بہٕ چُھس پزنہٕ پٲٹھؠ مسیحؔ سٕنٛدِ طرفہٕ سوزنہٕ آمُت تسُنٛد نمایندٕ۔ میانہِ دٔسؠ آے کٲتؠ جلالہٕ تہٕ حٲران کروٕنؠ چیز بارسس۔
\v 13 مزید مےٚ کوٚر نہٕ توٚہہِ سٟتؠ تیُتھ ویوہار زنتہٕ توٚہؠ باقےٕ ایماندار جمٲژو کھۅتہٕ وسِتھ ٲسِو۔ اکہِ چیزٕ کِنؠ روز میٲنؠ عمل بیوٚن۔ سۅ گییہِ زِ مےٚ کٔرِو نہٕ پریشان یا تنگ پونٛسہٕ منٛگِتھ۔ یوٚدوے تہِ غلط اوس، مہربٲنی کٔرِتھ کٔرِو مےٚ معاف!
\v 14 دھیان تھٲیو! بہٕ چُھس یمہِ پھرِ توٚہہِ سمکھنہِ یِنہٕ وول تہٕ بیٚیہِ تہِ کرنہٕ بہٕ توٚہہِ پریشان پونٛسہٕ منٛگِتھ۔ اوٕ کِنؠ زِ بہٕ چُھس یژھان زِ توٚہؠ کٔرِو مےٚ پٮ۪ٹھ تہٕ مسیحؔ ہس پٮ۪ٹھ پژھ۔ بہٕ چُھس نہٕ یژھان تِم چیز یِم توٚہہِ چُھو۔ اوٕ کِنؠ زِ بہٕ چُھس زنتہٕ تُہنٛد مول موج۔ مےٚ پزِ تہنٛدِ باپتھ پونٛسہٕ بچاوُن۔ مزید اوٕ کِنؠ زِ توٚہؠ چُو میٲنؠ شُرؠ ہیوؠ۔ توٚہہِ پزِنہٕ میانہِ باپتھ پونٛسہٕ بچاوُن۔
\v 15 بہٕ ویٚتراوٕ کینٛہہ تہِ خوشی سان توٚہہِ مدد کرنہٕ باپتھ۔ ییٚلہِ بہٕ توٚہہِ برونٛٹھمہِ کھۅتہٕ ژوٚر لول برٕ، توٚہہِ تہِ پزِ برونٛٹھمہِ کھۅتہٕ ژوٚر لول مےٚ برُن۔
\v 16 توٚہہِ ہیٚکو اتفاق کٔرِتھ زِ بہٕ چُھس نہٕ توٚہہِ ذٲتی طور پریشان کران توٚہہِ پونٛسہٕ منٛگِتھ۔ وۅنؠ گو شاید ما چُھس بہٕ چالاک۔ خبر آسن ما مےٚ توٚہہِ تارن گٔری کٔرِتھ پونٛسہٕ ہیٚتؠ مٕتؠ۔
\v 17 وۅنؠ گو مےٚ چُھنہٕ کانٛہہ تہِ توٚہہِ بدلہٕ پنُن نمایندٕ بنٲوِتھ سوزمُت توٚہہِ تارنہٕ باپتھ۔
\v 18 مثالہِ پٲٹھؠ مےٚ ووٚن طِطُسس توٚہہِ سمکھنہٕ باپتھ۔ تہٕ مےٚ تھوو تمِس سٟتؠ پنُن اکھ ایماندار سٲتھی تہِ۔ توٚہؠ چُھو زانان زِ طِطُسن کٔر نہٕ توٚہہِ سٟتؠ تارن گٔری۔ سُہ تہٕ بہٕ چھِ اکے ژۅلہِ ۅوتھان، زُوان تہٕ اکے آیہِ کار کران۔
\v 19 توٚہہِ پزِ یہِ زانُن زِ توٚہہِ یِمہٕ کتھہٕ وننُک مطلب چُھنہٕ یہِ وٮ۪ژھناون زِ بہٕ تہٕ باقےٕ تمام یِم تہنٛز خدمت کران چھِ، کیا چھِ معتبر۔ بلکہِ تِمن لوٗکن ہنٛدؠ پٲٹھؠ یِم خداین ملنٲوؠ مسیحؔ ہس سٟتؠ، چھِ أسؠ تی ونان یہِ خدایس خوش کرِ۔ میانیو ایماندار سٲتھیو، یِمن أسؠ لول بران چھِ سون غرض چُھ پرٮ۪تھ کینٛہہ یہِ أسؠ ونان چھِ تہٕ توٚہہِ وۅتھہٕ واشر دِنہٕ باپتھ مدد کران چھِ۔
\v 20 مےٚ ونہِ یِمہٕ کتھہٕ توٕ کِنؠ زِ مےٚ چھےٚ ژیٚپھ زِ سپدِ کیا ییٚلہِ بہٕ توٚہہِ سمکھٕ۔ مےٚ چُھ ژٮ۪پہِ زِ بہٕ ما وُچھہٕ توٚہہِ پننہِ یژھنہٕ مطٲبق عمل نہ کران۔ تہٕ توٚہؠ ما لٔبیٚو سُہ پننہِ یژھنہٕ مطٲبق عمل نہ کرن وول۔ مےٚ چُھ ژٮ۪پہِ زِ توٚہؠ ما ٲسِو پانہٕ وٲنؠ ژُوان، توٚہہِ ما آسہ پانہٕ وٲنؠ حسد۔ توٚہؠ ما ٲسِو اکھ أکِس سٟتؠ ژکھہِ سان اکھ أکِس تلفس تل اننچہِ کوششہِ منٛز بدکلٲمی کران۔ پانہٕ وٲنؠ غلط بیٲنی کران۔ پانس متعلق تھیٚکان تہٕ لوٗکن اکھ أکِس خلاف اُکساوان۔
\v 21 مےٚ چُھ ژٮ۪پہِ زِ سپدِ کیا ییٚلہِ بہٕ توٚہہِ تریٚمہِ لٹہِ سمکھٕ۔ خدا ما کرِ مےٚ تہنٛدِ باپتھ شرمنٛدٕ۔ مزید بہٕ ما سپدٕ دۅکھٕ دٲوؠ واریہن لوٗکن ہنٛدِ باپتھ یِمو برونٛہہ کالہِ تہِ آسہ کوٚرمُت یہِ غلط چُھ تہٕ آسیٚکھ تہٕ غٲر اخلٲقی جنسی حرکت بند کٔرمٕژ۔
\c 13
\p
\v 1 مقدس کتابہٕ چھےٚ لیٚکھان: "کمس کم گژھن کُنہِ چیزس یا کٲنٛسہِ نفرس متعلق زٕ یا ترےٚ گواہ آسٕنؠ امہِ برونٛہہ زِ اتھ ییہِ پوٚز زٲنِتھ یقین کرنہٕ۔ "آگاہ روزیٚو آینٛدٕ ییٚلہِ بہٕ توٚہہِ سمکھنہِ یِمہٕ، سۅ آسہ تریٚیِم وِز۔ ییٚلہِ بہٕ تہنٛدِس کرنس کراونس گواہ بنہٕ۔
\v 2 ییٚلہِ بہٕ توٚہہِ دوٚیمہِ پھرِ سمکھنہِ آیاس، مےٚ کٔرِو توٚہؠ خبردار زِ بہٕ دِمہٕ تِمن سارنےٕ سزا یِمہٕ کانٛہہ گناہ کران آسن۔ وۅنؠ چُھسو بہٕ بیٚیہِ توٚہؠ خبردار کران ییٚلہِ زن بہٕ وُنہِ توٚہہِ دوٗرےٕ چُھس۔ ییٚلہِ بہٕ یِمہٕ تریٚمہِ لٹہِ توٚہہِ سمکھنہِ، بہٕ دِمہٕ تِمن سارنےٕ سزا یِم گناہ کران آسن رودؠ مٕتؠ۔
\v 3 بہٕ چُھسو توٚہہِ یہِ اوٕ کِنؠ ونان زِ توٚہہِ مونگُو زِ بہٕ دِمو توٚہہِ ثبوت زِ ییٚلہِ بہٕ کتھ کران چُھس یہِ چُھ پانہ مسیحؔ بولان آسان۔ توٚہؠ زٲنِو یہِ ییٚلہِ مسیحؔ توٚہہِ قٲعدس منٛز انہِ۔ سُہ روزِنہٕ توٚہہِ سٟتؠ تمہِ وِزِ نرم۔ بلکہِ روزِ توٚہہِ سٟتؠ تکرٕ۔
\v 4 توٚہہِ وُچھو أکِس انسٲنؠ کایہِ منٛز رود مسیحؔ بڈٕ نرم تہٕ حلیم ییٚلہِ لوٗکو تس کِلؠ ٹھٲسؠ صلیبس پٮ۪ٹھ۔ وۅنؠ گو خدا چُھ قوت وول تہٕ تٔمؠ بخٕش تس بیٚیہِ زندگی۔ أسؠ تہِ چھِ لیٚژؠ انسٲن یتھٕ پٲٹھؠ سُہ اوس۔ وۅنؠ گو خدا چُھ اسہِ منٛز تہِ پننہِ قوت سان عمل کران۔ اسہِ نوو زُو دِنہٕ باپتھ یتھٕ پٲٹھؠ مسیحؔ ہس دِتُن۔ اوے روزو أسؠ توٚہہِ منٛز قوت سان عمل کران۔
\v 5 توٚہہِ پزِ پرٮ۪تھ أکِس یہِ سوال پانس پرژھُن، "کیا بہٕ چُھسا مسیحؔ ہس پٮ۪ٹھ پژھ کران تہٕ تسٕنٛدِس ہدایتس پٮ۪ٹھ زُوان؟ "پرٮ۪تھ أکِس پزِ پانس آزمٲیش کرٕنؠ یِتھے پٲٹھؠ۔ تیلی زٲنِو توٚہؠ زِ توٚہؠ چُھو یسوع مسیحؔ ہس سٟتؠ پزی میلِتھ زُوان۔ یہِ چُھ پوٚز یوٚتام نہٕ توٚہؠ اتھ ازمٲیشہِ منٛز ناکام روزیٚو۔
\v 6 یوٚتام سون سوال چُھ۔ مےٚ چُھ یٮقین زِ توٚہؠ چُھو زانان زِ أسؠ چھِ امہِ ازمٲیشہٕ تٔرؠ مٕتؠ۔
\v 7 أسؠ چھِ خدایس منٛگان زِ توٚہؠ مہٕ ٲسِو کۅکار کران۔ أسؠ چھِنہٕ منٛگان یہِ اوٕ کِنؠ زِ لوٗکھ مازن اسہِ کامیاب توٚہؠ قٲعدس تحت اننہٕ باپتھ، بلکہِ اوٕ کِنؠ زِ توٚہؠ ٲسِو رٕتؠ کار کران۔ أسؠ چھِ یہِ یژھان توٚہہِ متعلق یوٚدوے امیُک مطلب یِتہِ نیرِ زِ لوٗکھ زانن اسہِ ناکام تکیازِ توٚہہِ چھنہٕ سٲنؠ ضرورت۔
\v 8 أسؠ چھِ یژھان زِ توٚہؠ کٔرِو رٕژٕ کامہِ۔ یوٚدوے زن یہِ نتہٕ ہیٚکو نہٕ أسؠ توٚہہِ قٲعدس تحت أنِتھ تہٕ توٚہؠ باسیو طاقتور تکیازِ اسہِ پزِ خدایہِ سنٛدِ پزِ پٲغامچ تابعدٲری کرٕنؠ۔ أسؠ ہیٚکو نہٕ کہین کٔرِتھ یہِ زن خدایہِ سٕنٛدِس پٔزِس پٲغامس متضاد آسہ۔
\v 9 أسؠ چھِ خۅش ییٚلہِ لوٗکھ یہِ سونٛچن زِ أسؠ چھِ لیٚژؠ اوے کِنؠ زِ توٚہؠ چُھو بل دار خدایس مازنس منٛز سانہِ طرفہٕ کُنہِ قٲعدہٕ قانونہٕ ورٲے۔ یوٚہے چُھ سُہ چیز یمہِ خاطرٕ أسؠ دعا چھِ کران، تاکہ توٚہؠ ہیٚکو خدایس پٮ۪ٹھ پوٗرٕ پٲٹھؠ بھروسہٕ کرنُک تہٕ تابعدٲری کرنُک فٲصلہٕ کٔرتھ۔
\v 10 یہِ چُھ اوٕ کِنؠ زِ بہٕ چُھس یژھان زِ توٚہؠ کٔرِو پژھ تہٕ فرمانبردٲری خدایہِ سنٛز سٲری یژھِ ایمان سان تہٕ توے کِنؠ چُھس لیٚکھان توٚہہِ ییٚتہِ دوٗرِ پٮ۪ٹھٕ یِمن سارنےٕ چیزن متعلق۔ پتہٕ ییٚلہِ بہٕ توٚہہِ نِش واتہٕ، مےٚ پیٚیِو نہٕ توٚہؠ بڈٕ سختی سان أکِس ظٲبطس منٛز انٕنؠ۔ خداوندن بخُش مےٚ پنُن نمایندٕ آسنُک درجہٕ۔ وۅنؠ گو تٔمؠ کوٚر یہِ اوٕ کِنؠ زِ بہٕ دِمہٕ توٚہہِ ہمت تہٕ حوصلہٕ تہٕ بیٚیہِ کرَو خدایس پٮ۪ٹھ پژھ کرنچہِ اتھ کامہِ منٛز اتھہٕ روٚٹ۔ نہ زِ بہٕ کرَو توٚہؠ پس ہمت خدایس پٮ۪ٹھ پژھِ نِش۔
\v 11 یِم چھےٚ کینٛہہ ٲخری کتھہٕ یِم بہٕ توٚہہِ وننہِ چُھس یژھان، میانیٚو ایماندار سٲتھیو۔ خوش روزیٚو! خدایہِ سٕنٛدِ یژھنہٕ مطٲبق روزیٚو لسان بسان۔ یِم چیز مےٚ توٚہہِ ؤنیٚو تِم دِنو توٚہہِ حوصلہٕ خدایس پٮ۪ٹھ زیادٕ پژھ کرنہٕ باپتھ۔ اکھ أکِس سٟتؠ تھٲیِو اتفاق اہم چیزن پٮ۪ٹھ۔ اکھ أکِس سٟتؠ روزیٚو امنہٕ سان۔ یوٚدوے توٚہؠ یِم چیز کٔرِو، خدا روزِ توٚہہِ سٟتؠ سٟتؠ۔ سُہ چُھ توٚہہِ پانہٕ وٲنؠ ماے محبت تہٕ امن تھاونس لایق بناون وول۔
\v 12 اکھ أکِس کٔرِو خوش آوے مایہِ تہٕ لولہٕ سان تِتھٕ پٲٹھؠ یُس خدا سنٛدؠ خاندان کٮ۪ن فردن شوٗبہِ۔
\v 13 یتہِ چھِ خداوند یسوع مسیحؔ سٕنٛدؠ سٲری بنٛدٕ توٚہہِ نیک خواہشات سوزان۔
\v 14 خداوند یسوع مسیحؔ روزِن توٚہہِ پٮ۪ٹھ مہربان۔ خدایہِ سُنٛد لول پوشؠ نو تہٕ پاک روح روزؠ نو سٟتؠ سٟتؠ تہٕ تھٲوؠ نو پانہٕ وٲنؠ سمُت۔
