\id RUT - DMT Kashmiri
\toc1 رُوت
\mt1 رُوت
\c 1
\p
\v 1 ییٚلہِ قٲضؠ اسرائیلس پٮ۪ٹھ حکومتھ کران ٲسؠ، تمہِ وزِ ووٚتھ تتھ ملکس منٛز دراگ۔ اسرائیل کہِ یہُوداؔ علاقہٕ، بیت لحم قصبہٕ منٛزٕ دراو اکھ شخص موآبؔ ملکس منٛز کینٛہہ کال روزنہٕ خٲطرٕ۔ تٔمؠ سنٛز خاندارِنؠ تہٕ زٕ نیٚچوؠ وٲتؠ تمِس سٟتؠ۔\f + \fr 1‏:1 \ft پرانہِ عہد نامٕکؠ قٲضؠ ٲسؠ بنیٲدی طور موجودٕ دورٕکٮ۪ن واریاہ معاشرن ہنٛدٮ۪ن سردارن ہنٛدؠ پٲٹھؠ۔ \f*
\v 2 أمِس شخصس اوس ناو الیملکؔ تہٕ خاندارنہِ ہُنٛد ناو اوسُس نعومی۔ أکِس نیٚچوِس اوسُس محلون ناو تہٕ بیٚیِس کلیون۔ تم ٲسؠ یہُوداہسؔ منٛز بیت لحمؔ کِس افرٲتؠ قبیلس سٟتؠ وابستہٕ۔ تم آے موآبؔ ملکس منٛز تہٕ رودؠ تٔتؠ۔
\v 3 پتہٕ گذریو نعومی ہُنٛد خاندار الیملکؔ تہٕ نعومی نِش رودؠ صرف تمسنٛدؠ زٕ نیٚچوؠ۔
\v 4 یمو نٮ۪چیو کوٚر موآبؔ چَن زنیٚن سٟتؠ خانٛدر۔ کِلنؔ سنٛزِ زنانہِ ہُنٛد ناو اوس عُرفہ تہٕ محلون سنٛزِ زنانہِ ہُنٛد ناو اوس رُوتؔ۔ مگر اتھ علاقس منٛز رودؠ یم قریبن دہن ؤرین۔\f + \fr 1‏:4 \ft محلونن کوٚر روُتس سٟتؠ خاندر تہٕ کِلنن کوٚر عُرفہس سٟتؠ خاندر۔ \f*
\v 5 پتہٕ گُذریاے یم دوٚنوے محلون تہِ تہٕ کلیون تہِ۔ لہٰذا روز نعومی بیٚیہِ کُنی زٔنؠ دوٚن شُرین یا خاندارس بغٲر۔
\v 6 اکہ پھرِ ییٚلہِ نعومیؔ موآبسؔ منٛز ٲس تٔمؠ بوز کُستام یُس اسرائیل پٮ۪ٹھ آمُت اوس یہِ ونان زِ یہُوواہؔ چُھ پننٮ۪ن لوٗکن مدد کوٚرمُت تہٕ وُنؠ چُھ اسرائیلس منٛز کھیٚن وفور۔ لہٰذا گییہِ سۅ پننٮ۪ن دون نۅشن سٟتؠ بیت الحمؔ واپس گژھنہٕ خٲطرٕ آمادٕ۔
\v 7 لہٰذا دراے نعومیؔ تہٕ زٕ نوشہٕ تتہِ یتہِ تم بسان آسہ تہٕ لجہِ یہُوداؔ کُن نیرنہ۔
\v 8 ییٚلہِ تم پکان آسہ، نعومی لٔج پننٮ۪ن نۅشن عُرفہؔ تہٕ رُوتؔس وننہِ۔ "توٚہہِ دونونی پزِ واپس پنُن ماجہِ ہُنٛد گژُھن۔ بہٕ کرٕ یہُوواہؔ ہس عرضی زِ سُہ کرِ توٚہہِ سٟتؠ تِتھے پٲٹھؠ وفادٲری یتھ کِنؠ توٚہہِ پننٮ۪ن گُزریامتن خاندارن تہٕ مےٚ سٟتؠ کٔروٕ
\v 9 بہٕ کرٕ یہُوواہسؔ عرضی زِ سُہ دییہِ توٚہہ بیاکھ خاندر کرنُک اجازت یمہِ سٟتؠ توٚہؠ محفوظ روزِتھ ہیکیٚو۔ پتہٕ کٔرؠ نعموینؔ تمن ماہ تہٕ میٹھؠ تہٕ تمہٕ لجہِ بڈِ بڈِ ودنہِ۔ تِمن دۅشوٕنؠ نۅشن۔
\v 10 تِمو ووٚن "نہٕ أسؠ یمو توٚہہِ سٟتؠ تُہنٛدین رشتہٕ دارن نِش۔"
\v 11 مگر نعومی وُننَکھ، ناے میانیو کوریو! گرَے گٔژھیو واپس۔ مےٚ سٟتؠ ینہٕ سٟتؠ یِیو نہٕ توٚہہِ کانٛہہ فٲیدٕ۔ مےٚ ہیکن نہٕ ۅ نیٚچوؠ زیٚتھ یم تُہنٛدؠ خاندار بنَن۔
\v 12 میانیٚو کوریو۔ توٚہہِ پزِ واپس گژُھن۔ بہٕ چُھس واریاہ وٲنسہِ بیٚیِس خانٛدارس سٟتؠ خانٛدر کرنچ امید تھاوان۔ اگر یتہِ مانو زِ مےٚ میلہِ دویم خاندار، تہٕ أزؠ گژھِ خاندر تہِ تہٕ پتہٕ زیون مےٚ شُرؠ تہِ
\v 13 توٚہؠ ہیٚکیو نہٕ تہنٛدس بالیغ سپدنس پرٲرِتھ تہٕ تۅتام خاندرٕ رۅستےٕ روزِتھ! نَہ، میانیٚو کوریو، یہُوواہنؔ بنٲو میانؠ زنٛدگی واریاہ کریٹھ، مگر تُہنٛزِ زِنٛدگی چھنہٕ میانہِ زندگی ہنٛدؠ پٲٹھؠ کریچھرس منٛز روزنچ ضرورت۔"
\p
\v 14 پتہٕ لٔگؠ رُوتؔ تہٕ عُرفہ بیٚیہِ بڈِ بڈِ ودنہِ۔ عرفؔہ ہن کٔرؠ پننہِ ہشہِ رخصت ہیٚوان میٹھؠ تہٕ درایہ، مگر روت روز نومیؔ سٟتی۔
\v 15 نعومیؔ ووٚن رُوتس، "وُچھ چٲنؠ بٲے کاکٕنؠ عُرفہ درایہِ پننٮ۪ن عٲشناون تہٕ دیوتاہن نِشہ واپس گژھنہٕ باپتھ! تمسےٕ سٟتؠ گژھِ واپس۔"
\v 16 مگر رُوتؔ ؤژھ در جواب، "نَہ! مہربٲنی کٔرِتھ مہٕ کٔرِو اصرار زِ بہٕ دِمہٕ توٚہہِ گژھنہٕ یا بہٕ پھیرٕ تہٕ ٹھٔہرٕ توٚہہِ یِنہٕ نِشہ، یتہِ ژٕ روزَکھ بٕتہ روزٕ تٔتؠ۔ چٲنؠ رشتہٕ دار آسن میانؠ رشتہٕ دار تہٕ یمِس خدایہ سنٛز ژٕ عبادت کرکھ سُے آسہ میٚون خدا تہِ۔
\v 17 یتِتھ چون وفات سَپدِ تٔتی گژھٕ بٕتہ مَرٕنؠ تہٕ دفن گژھنؠ۔ میٚون یہُوواہؔ دِیِن مےٚ سخت سزا اگر مےٚ موتہٕ سِوٲے ژےٚ نِشہ کانٛہہ جُدا کرِ۔
\v 18 ییٚلہِ نعومی زون زِ رُوت چھےٚ پۅختہٕ اِرادٕ ہیٚتھ مےٚ سٟتؠ یِنس! تٔمہِ کوٚر أمِس گرٕ واپس یِنُک زور کرُن بنٛد۔
\v 19 یتھ کٔنؠ روزٕ دوٚنوے خاتونہٕ نعومہ تہٕ رُوت قدماہ قدماہ دِوان یۅتام تمہٕ بیت لحمؔ شہرس منٛز دٲخل سپزٕ۔ قصبس منٛز ہیوٚت واریہو لوٗکو تِمَن مُتعلِق بڈِ بڈِ کتھٕ کرنہِ شروع۔ شہرٕچو زنیٚو ووٚن، "یہِ چُھ مشکل یقین کرُن زِ یہِ چھےٚ نعومیؔ!"
\v 20 نعومیؔ وُن تِمن، "توٚہؠ مٕہ ؤنِو وُنؠ مےٚ نعومیؔ بلکہ مارا، تکیازِ نعومی گو خوش قسمت تہٕ مارا گو بدقسمت، تہٕ قدرت وٲلؠ خداین میانؠ زنٛدگی بد قسمت۔
\v 21 ییٚلہِ بہٕ یتہِ درایس مےٚ اوس ضرورَتُک پرٮ۪تھ اکھ چیز، وُنؠ أنِس بہٕ یہُوواہنؔ ژھرےٕ تہٕ چٔھنی واپس۔ لہٰذا مٕہ ؤنِو مےٚ نعومی۔ یہُوواہنؔ چھِ مےٚ مُخٲلِفت کٔرمٕژ زِ قدرت وٲلؠ خداین بنٲو میٲنؠ زندگی واریاہ کریٹھ۔
\v 22 غرض نعومی وٲژ واپس پنٕنؠ نۅش رُوتؔ ہیٚتھ یمہٕ موآبؔ ملکہٕ پٮ۪ٹھٕ یور آیہ۔ ییٚلہِ تم بیت لحمؔ شہرس منٛز واژٕ تمہِ وزِ اوس اتہِ کنٕکھ لوننُک وق ووتمُت۔
\c 2
\p
\v 1 بیتھلیمس منٛز اکھ نفر یُس نعومی سٕنٛدِس مرحوم خاندار سُنٛد اکھ رشتہٕ دار روزان۔ سُہ اوس الیملکؔ قبیلُک اکھ اہم تہٕ امیر شخص۔ تہٕ تمِس اوس بوعزؔ ناو۔
\v 2 اکہِ دوٚہہ ؤژھ موآبٕچ رُوت نعومی کُن، "مےٚ دِ ژٕ زِرات کھہَس پٮ۪ٹھ گژھنہٕ تہٕ سُہ پھل اننہٕ یُس پھسٕل لوٚنَن والیٚن پتھ کُن ہران چُھ۔ بہٕ پکہٕ کٲنٛسہِ پھسٕل لونَن وٲلِس پتہٕ پتہٕ یُس مےٚ پھلوال سونٛبرنہٕ دِیہ۔ نعومیؔ دِتُس جواب، "میانؠ کورؠ، نیر گژھِ۔"\f + \fr 2‏:2 \ft احبار 19:9-10؛ 23:22؛ تثنِیہ 24:19-22 \f*
\v 3 تہٕ رُوت گییہ۔ ییٚلہِ سۅ کھہَس پٮ۪ٹھ وٲژ تہٕ لٔج پھسٕل لونَن وٲلِس پتہٕ پتہٕ پھلوال سونٛبراونہِ۔ زمینُک یہِ حصہٕ اوس الیملکؔ سٕنٛدِس رشتہٕ دار بوعزؔ سُنٛد۔
\v 4 کینٛہہ کال پتہٕ ووت بوعزؔ بیت لحم پٮ۪ٹھٕ واپس۔ تٔمؠ دِژ پھسٕل لونن والیٚن شابٲشی تہٕ وننَکھ، "یہُوواہؔ ٲسِن توٚہہِ پٮ۪ٹھ رٲضؠ۔ "تِمو دتُس جواب، "یہُوواہؔ کٔرنؠ توٚہہِ برکتھ۔
\v 5 أتھؠ سؔتؠ پییہِ بوعزَس رُوتؔہِ کُن نظر تہٕ پرِژھن پننِس مُہنوِس، "ہۅ جوان زٔنؠ کۅسہٕ چھےٚ؟
\v 6 مہنیٚوؠ دِتُس جواب، "یہِ چھےٚ موآبؔ پٮ۪ٹھٕ آمٕژ سۅ زٔنؠ یۅسہ تتہِ پٮ۪ٹھٕ نعومیؔ سٟتؠ یور آیہِ۔
\v 7 امہِ ووٚن مےٚ، مہربٲنی کٔرتھ دِتہٕ مےٚ یہِ پھلوال تُلنہٕ یۅسہ یم پھسٕل لونَن وٲلؠ پتھ کُن تراوان چھِ۔ یہِ چھےٚ سیٹھاہ سُلہِ یہِ پھلوال تُلنہِ آمٕژ تہٕ ونیُک تام چھےٚ أتی، منٛزٕ کوٚرُن پارِ منٛز آرام تہِ۔
\v 8 پتہٕ وُتھ بوعزؔ رُوتہِؔ کُن، "ہے جوان کورؠ، بوز میانؠ کتھ۔ ژےٚ چھےٚ نہٕ کُنہٕ بیٚیس کھہَس پٮ۪ٹھ یا بیٚیہِ کُنہِ جایہِ پھلوال سومبرنہِ گژھنٕچ ضرورت۔ ژٕ بیٚہہ یتی میانہِ نوکرانہٕ سٟتؠ۔
\v 9 تہٕ وُچھ مہنیٚوؠ کتِتھ لونَن پھسٕل تہٕ پکھ میانیٚن یمن نوکرانیٚن سٟتؠ سٟتؠ۔ مےٚ کوٚر یِمن مُہنوین حکم یِم پھسٕل لونان چھِ، یُتھنہٕ أمِس روب کٔریو۔ ییٚلہ تریش لگیٚو تہٕ گٔژھؠ زیٚو تہٕ چیٚؠ زیٚو ہُمو نٹیٚو منٛزٕ یم میانیٚو نوکرو بٔرِتھ چھِ تھٲوؠ مٕتؠ۔"
\p
\v 10 پتہٕ دِتؠ رُوتن زمینس اتھٕ تہٕ نمییہِ تمِس برونٛہہ کنہِ۔ تمہِ پرُوژھ عٲجِزی سان تمِس، "توٚہؠ کیازِ چُھو مےٚ پٮ۪ٹھ یوٚت مہربان؟ مےٚ اوس نہٕ یہِ سونچمُت تہِ زِ توٚہؠ دِیو مےٚ کُن یتھٕ کٔنؠ توجو۔ تکیازِ بہٕ چھیٚس وۅپر ملکٕچ!
\v 11 بوعزن دِتُس جواب، "مےٚ ووٚن لوکو سورےٕ زِ خاندار مرنہٕ پتہٕ کیاہ کیاہ ورتووُتھ ژےٚ پننہِ ہشہِ سٟتؠ۔ تِمو ووٚن مےٚ زِ ژےٚ ترووُتھ پنُن وطن تہٕ مول موج تہٕ آیکھ یور یمن سٟتؠ روزنہٕ خٲطرٕ۔ یم نہٕ ژٕ زانہٕ ہَکھےٕ۔
\v 12 بہٕ کرٕ دُعا زِ یہُوواہؔ دی نےَ ژےٚ امیٚک پوٗرٕ اجَر یہِ ژےٚ کۅرتھ۔ آ، اسرائیلُک خدا، یہُوواہؔ یمہِ سٕنٛدِ حفاظتٕچ ژےٚ آش چھےَ، دی نےَ پوٗرٕ اجَر۔
\v 13 تمہِ ووٚن در جواب، "جناب، مےٚ چھےٚ پوٗرٕ امید زِ بہٕ روزٕ توٚہہِ ہعتھےٕ خوش کران۔ توٚہہِ دِتو مہربان سَپدِتھ مےٚ خٲدِم زٲنِتھ حوصلہٕ۔ ییٚلہِ زن مےٚ چانیٚن نوکرانیٚن ہنٛز حثیت چھنہٕ۔"
\v 14 ییٚلہِ کھیٚن چیٚنُک موقہٕ ووت، بوعزنؔ وُن رُوتس، "ۅلہٕ یورؠ تہٕ کھیٚہ کینٛہہ، تُل یہِ ژۅٹ تہٕ وزو سٔرکس منٛز تہٕ کھیٚہ۔ "پتہٕ ییٚلہِ سۅ پھسٕل لونَن والیٚن نشہٕ بیٹھ تہٕ تٔمؠ کوٚر تس روٚنمُت کھیٚن پیش۔ تٔمؠ کھیٚو تیٚوتاہ یہِ تس گژھِ ہے تہٕ اوٚڈ ہُریو۔
\v 15 پتہٕ یلہِ سۅ دُبارٕ کٲم کرنہِ ؤژھ، بوعزنؔ دیُت پننٮ۪ن مُزورن حکم، "اگر یہِ پنُن سوٚمبرومُت پھل یمن پھل گیٚجن سٟتؠ تھاوِ یمہٕ توٚہہِ لونیٚو، أمِس گژھِ نہٕ کِہین ونُن۔
\v 16 اکھتُے چُھس بہٕ یتہِ یژھان زِ توٚہؠ ٲسِو گیٚجو منٛزٕ کینٛہہ ہیٚلؠ دٲرِتھ تہِ دِوان تاکہِ یہِ آسہ سُہ تلان۔ یہِ گژھِ نہٕ تنٛگ کرٕنؠ۔"
\v 17 رُوت روز شام تام کھہَس منٛز پھل جمع کران۔ پتہٕ لٲگؠ تٔمؠ تمہٕ کنٕکہٕ لٲے چھونٛبٕنؠ، دانہٕ کنکہٕ گھاسہٕ نِشہ الگ گژھنہٕ باپتھ یمہٕ تٔمؠ سومبرٲومٕتؠ ٲسؠ، یتھ کِنؠ ٲسؠ کٕنکٕچ اکھ بٔڈ ٹوکٕر برنہٕ خٲطرٕ کٲفی۔ \f + \fr 2‏:17 \ft تقریباً 10 کِلو جَو\f*
\v 18 پتہٕ درایہِ رُوت یہِ ہیٚتھ شہر کُن تہٕ وٲژ پننہِ ہشہِ نِش تہٕ ہونَس مےٚ کوتاہ پھل چُھ جمع کوٚرمُت۔ تٔمؠ دیُت پننہِ ہشہِ روٚنمُت پھل تہِ یُس تمِس دُپہرکہ کھیٚنہٕ منٛزٕ بچومُت اوس۔
\v 19 تمؠ سنٛزِ ہشہِ پرُوژھ تمِس، "از کتہِ کۅرتھ ژےٚ یہِ سورےٕ پھل جمع؟ ژٕ کہنٛدِس کھہَس منٛز ٲسکھ کٲم کران؟ بہٕ چھیٚس خدایس منٛگان زِ تس شخصس کٔرنؠ خدا برکتھ یُس ژےٚ پٮ۪ٹھ یوٚت مہربان سپُدمت چُھ۔ پتہٕ ؤژھ رُوت تہٕ وُننَس تس شخصس متعلق یس سٟتؠ تٔمؠ کٲم ٲس کٔرمژ۔ تمہِ ووٚن، "تمِس شخصس سُنٛد ناو چُھ بوعزؔ یُس تمہِ زمینُک مٲلکھ چُھ یتہِ بہٕ از کٲم ٲسٕس کران۔
\v 20 نعومیؔ وُن پننہِ نۅشہِ، "یہُوواہؔ کٔرنؠ تس برکتھ۔ یہُوواہؔ ہن کٔر نہٕ اسہِ سٟتؠ یمہٕ زندٕ چھِ تہٕ سانیٚن خاندارن سٟتؠ یمہٕ گذریامٕتؠ چھِ وفادٲری کرٕنؠ بند۔ "پتہٕ ونُن بیٚیہِ، "سُہ شخص چُھ الیملکؔ سُنٛد قریبی رشتہٕ دار۔ دراصل چُھ سُہ سٲنس خاندانس رٲچھ کرن والیٚو ذمہٕ دارو منٛز اکھ۔
\v 21 موآبٕچ رُوتؔ ؤژھٕس یورٕ، "تٔمؠ وُن مےٚ اکھتُے یتہِ زِ تۅتام روز میانیٚن مُزورن بالکل سٟتؠ، یۅتام تِمہ میٚون سورےٕ پھسٕل لوٚنِتھ انُن۔"
\v 22 نعومیؔ وُن پننہِ نۅشہِ رُوتؔس در جواب، "میانؠ کورؠ، یہِ روزِ چانہِ خٲطرٕ بہتر زِ ژٕ گژھکھ تمؠ سنٛزن مُزور کوریٚن سٟتؠ تمِسنٛدس کھہَس منٛز کٲم کرنہِ۔ تکیازِ اگر ژٕ بیٚیہِ کٲنٛسہِ ہنٛدس کھہَس منٛز گژھکھ خبر تتہِ ما کٔری کانٛہہ ٹَھٹھٕ۔
\v 23 لہٰذا گٔییہِ رُوت بوعز سنٛزن نوکرانیٚن سٟتؠ کٲم کرنہِ۔ تٔمؠ کوٚر تتہِ تۅتام پھسٕل جمع یۅتام مُزورو کٕنکھ تہٕ وُشکہٕ پورٕ پٲٹھؠ لونِتھ مۅکلٲوؠ۔ اتھ وقتس دوران ٲس سۅ نعومی سٟتی روزان۔
\c 3
\p
\v 1 اکہ دوٚہہ وُن نعومی پننہِ نۅشہِ رُوتہِؔ، "میانؠ کورؠ، بہٕ چھٮ۪س یژھان توٚہہِ أکِس اصل خانٛدارَس سٟتؠ اکھ محفوٗظ گرٕ بناونُک اِنتِظام کرُن۔
\v 2 وُنؠ چھیٚکھ ژٕ بوعزؔ سنٛزن نوکرانیٚن سٟتؠ کام کران، تہٕ ژٕ چھیٚکھ زانان زِ سُہ چُھ سون نزدیکی رشتہٕ دار۔ ژٕ بوز غورٕ سان از راتس آسہ سُہ تتہِ یتہِ تِم کنٕکھ چُھمبان چھِ۔ سُہ آسہ پھل ژھٹان۔
\v 3 ژٕ کرِ سران تہٕ بیٚیہِ مَل عطر۔ پٮ۪ٹھٕ ول پوٗرٕ ژادر۔ پتہٕ گژھِ تتھ جایہِ یتہِ سُہ کٕنکھ چُھمبان چُھ۔ مگر یۅتام نہٕ سُہ کہیٚتھ چیٚتھ مۅکلاوِ تۅتام کٔرزینہٕ تس شک زِ بہٕ چھیٚس یتہِ۔
\v 4 ییٚلہِ سُہ شونٛگُن ہیٚیہِ ژٕ تھٲوؠ زِ ظۅن سُہ کتِتھ شونٛگہِ۔ پتہٕ گژھؠ زِ تس نِش تہٕ شونٛگؠ زِ تسنٛدین کھۅرن تل۔ ییٚلہِ سُہ ہُشار گژھِ تہٕ سُہ پرِژھی ژےٚ زِ کیاہ چُھ کرُن۔ \f + \fr 3‏:4 \ft روتھن یہٕ کوٚر سُہ اوس تحفظ منٛگنُک اکھ علامتی طریقہٕ۔ \f*
\v 5 رُوتؔ ؤژھٕس در جواب، "بہٕ کرٕ تہِ سورےٕ یہِ کینٛژھا ژےٚ ونُتھ۔"
\v 6 لہٰذا گٔییہِ سۅ تتھ جایہِ یتِتھ کٕنکھ چُھمبان ٲسؠ۔ تتہِ کوٚر تمہِ تہِ سورےٕ یہِ ہشہِ ماجہِ ونمُت اوسُس۔
\v 7 ییٚلہ بوعزؔ کھیٚتھ چیٚتھ مۅکلیو سُہ اوس بڈٕ خوش، سُہ گو پھل ڈھیرٕ کِس کوٗنس نِش تہٕ شونٛگ تتہِ۔ رُوت گییہِ ژۅپہٕ کٔرتھ تمِس نِشہ۔ تمہِ تُج تمؠ سنٛزو کھۅرو پٮ۪ٹھٕ ژادر تھوٚد تہٕ شونٛج تٔتی۔
\v 8 نیصف رٲژ گو سُہ اچانک ہُشار۔ سُہ ووٚتھ تہٕ رود بہِتھ، اتہِ باسیاس زِ اکھ زٔنؠ چھےٚ تس کھۅرن تل پیٚمٕژ۔
\v 9 تٔمؠ وُن تس، "ژٕ کۅسہٕ چھیٚکھ؟" تمہِ دِتُس جواب "بہٕ چھیٚس چٲنؠ نوکرٲنؠ، رُوت۔ چونکہِ توٚہؠ چُھو میانِس مرحوم خاندار سٕنٛدِ خاندانٕکؠ ذمہٕ دار، توٚہؠ چُھو نزدیکی رِشتہٕ دار لہٰذا بچٲوؠ تو مےٚ پننِس نِکہَس منٛز اوٚنتھ
\v 10 بوعزؔ وتُھس یورٕ" میانؠ ٹٲٹھؠ! خداوند یہُوواہؔ کٔرنے فضل۔ گۅڈٕ ٲسکھ ژٕ پننہِ ہشہِ ماجہِ ہنٛز سَخ وفادار، مگر وُنؠ چھیٚکھ ژٕ زیادے وفادٲری یہِ زٲنِتھ ہاوان زِ ژٕ چھیٚکھ نہٕ خاندرٕ باپتھ۔ کٲنٛسہِ امیر یا غریب نوجوانس پتہٕ۔"
\v 11 اے میٲنؠ ٹٲٹھؠ کوری، وُنؠ کرٕ بہٕ تہِ سورےٕ یہِ ژٕ ونان چھیٚکھ۔ کھۅژ مٕہ، یمہٕ شہرٕکؠ سٲری لوٗکھ چھِ یہِ زانان زِ ژٕ چھیٚکھ اکھ پاک سیرت خوتون۔
\v 12 حالانکہ بہٕ چُھس نعومی ہنٛدیو قریبی رشتہٕ دارو منٛزٕ، لہٰذا چُھس بہٕ توٚہہِ دونونی ہُنٛد ذمہٕ دار، بیاکھ اکہ شخص تہِ چُھ یَس میانہِ کھۅتہٕ زیادٕ تُہنٛز ذمہٕ دٲری چھےٚ۔ تکیازِ سُہ چُھ نعومی زیادٕ نزدیک رشتہٕ دار۔
\v 13 ژٕ روز راتس ییٚتؠ۔ پگاہ صبحٲے ونہٕ بہٕ تس نفرس توٚہہِ متعلق۔ اگر تٔمؠ مون زِ سُہ تھاوِ تُہنٛد خیال، گو ٹھیک، تیٚلہِ ہیٚکہِ سُہ توٚہہ سٟتؠ خاندر کٔرتھ۔ اگر سُہ تُہنٛز کفالت کرٕنؠ مٹہِ ہیٚیہِ نہٕ تیٚلہِ چُھسے بہٕ وعدہ کران زِ یہُوواہؔ حٲضر نٲضر رٔٹتھ کرٕ بہٕ پانہٕ ژےٚ سٟتؠ خاندر تہٕ کرٕ مکمل پٲٹھؠ چٲنؠ رٲچھ راوٕٹ، اوے کِنؠ پیٚیی ژےٚ صبحس تام یتؠ روزُن۔
\v 14 پتہٕ وُننَس بوعزن یتہِ زِ، "بہتر گٔیاو، اگر نہٕ کٲنٛسہِ یہِ پے لگہ ہے زِ کانٛہہ زٔنؠ کیا آیہ یور۔ لہٰذا روز سۅ صبحس تام تمسںنٛدین کھۅرن کُن شونٛگِتھ۔ سۅ درایہ صُبحن نِکہِ نِکہِ گاشہٕ یُتھ نہٕ تس کانٛہہ پرزٕ ناوِ۔ اتہِ تاکہِ تس وُچھنہٕ کانٛہہ۔
\v 15 بوعزن ونُس پتہٕ، "پنٕنؠ گوٚب ژادر ان یورؠ تہٕ کرُس تھف۔ "ییٚلہِ تمہِ یہِ کوٚر تٔمؠ بوٚر اتھ منٛز تقریباً ترٕہ کلو کٕنکھ تہٕ تُلنَس اتھٕ۔ پتہٕ درایہِ سۅ شہر کُن۔ \f + \fr 3‏:15 \ft تقریباً 24 کِلو \f*
\v 16 ییٚلہِ رُوت گرٕ وٲژ تمہِ سنٛزِ ہَشہِ وُن تس، "میانؠ کورؠ کتھؠ حالات چھِ چانہِ طرفہٕ؟ پتہٕ ؤنِس رُوتؔہِ یورٕ سۅ سٲرےٕ دلیل یۅسہ بوعزن تمِس ؤنؠ تہٕ یہِ تٔمؠ ورتوو۔
\v 17 تمہِ ؤنؠ نعومی یہَن تہِ، "تٔمؠ دِتؠ مےٚ یم سٲری کنٕکھ تہٕ وُننم بہٕ گژھنہٕ خوش زِ ژٕ گژھکھ پننہِ ہشہِ نِش ژھریو اتھو۔
\v 18 نعومیؔ ونُس یورٕ، "میانؠ کورؠ بس وُنؠ کرِ ژٕ یتی انتظار، یۅتام أسؠ وُچھو زِ کیاہ سَپدِ۔ یہِ شخص تھاوِ یقینی طور از امہِ معاملُک خیال۔"
\c 4
\p
\v 1 اتھ دوران گو بوعزؔ شہرکہِ دروازٕ انٛدر تتھ جایہ یتہِ لوٗکو پنُن دفترے کاروبار کوٚر، تہٕ بیٚوٹھ تٔتی۔ کمےٕ کال گٔژھتھ آو سُہ نزدیکی رشتہٕ دار تہِ یمسُنٛد بوعزؔن ذکِر کوٚرمُت اوس۔ بوعزنؔ کوٚر تمِس ناو دِتھ آلو تہٕ وُننَس، "ولہٕ یورؠ یہِ بیٚہہ" سُہ نفر آو تہٕ بیٚوٹھ۔ \f + \fr 4‏:1 \ft شہرُک دروازٕ چُھ شہر کِس دٲخلی دروازس نزدیک اجتمہچ جائے ییٚتہِ مقٲمی لوٗکھ اکثر سمٲجی موقعن پٮ۪ٹھ جمع چھِ گژھان۔ \f*
\v 2 پتہٕ أنؠ بوعزنؔ شہرٕکؠ داہ بزرگ معتبر نفر ناد دِتھ تہٕ ونُن تِمن، "مہربٲنی کٔرِتھ بِہیتو یَتِن تاکہِ توٚہؠ وُچھو سٲنؠ کٲم۔ "لہٰذا بیٹھؠ تِم پتھر۔
\v 3 پتہٕ وُن بوعزن پننِس تس رشتہٕ دارس، کیا ژٕ چُھکھٕ یہِ زانان زِ سٲنِس رشتہٕ دار الیملکؔ سُنٛد زمینہٕ ڈور چُھ خرچاونہٕ باپتھ؟ نعومیؔ یۅسہ حال حالےٕ موآبؔ پٮ۪ٹھٕ واپس آیہ چھےٚ سُہ کٔنُن یژھان۔
\v 4 مےٚ سونچ زِ بہٕ ونے ژےٚ، تاکہٕ ژٕ کرکھ یمن معتبر نفرن تھی یم گواہ روزنہٕ خٲطرٕ آمادٕ گے، اتھ زمینہٕ ڈورِس پٮ۪ٹھ قبضہٕ۔
\v 5 اگر ژٕ یہِ پننِس خاندانس منٛز واپس تھاونہٕ باپتھ مٔلؠ یژھٕ ہن ہیٚنؠ، ہیہَن تیٚلہ۔ وُنؠ اگر ژٕ تہِ یژھکھ نہٕ تیٚلہِ ون مےٚ، تکیازِ ژٕ چُھکھ الیملکؔ سُنٛد ساروٕے کھۅتہٕ قریبی رشتہٕ دار تہٕ بہٕ چُھس ژےٚ پتہٕ۔ أمؠ نفرن ونُس، "آبہٕ ہیٚمہٕ!" پتہٕ وُن بوعزن تمِس، "مگر ییٚلہِ ژٕ نعومی سُنٛد زمین ہیٚکھ ژےٚ پیٚیی تیٚلہِ سانہٕ رشتہٕ دار مآب سنٛزِ بیوہ رُوت سٟتؠ تہِ خاندر کرُن یُتھ تمِس لڑکہٕ زیٚوِ تہٕ پتہٕ امہِ وراثتُک مٲلکھ بنہِ تاکہِ تمسنٛدس مرحوم مٲلؠ سُنٛد ناو روزِ زندٕ۔"
\v 6 أمؠ قریبی رشتہٕ دارن ونُس یورٕ "تیٚلہِ ہیٚکہٕ نہٕ بہٕ یہِ واپس ہیٚتھ، اگر مےٚ تہِ کوٚر تِتھ کٔنؠ گژھِ مےٚ پننِس نیٚچو سنٛز وراثت ادرٕ کھلہ، میانہِ کھۅتہٕ ہکیٚو توٚہؠ امہِ زمینٕکؠ تہٕ زنہِ ہنٛدؠ ذمہٕ دار بنِتھ۔ بہٕ ہیٚکہٕ نہٕ یہِ کٔرتھ۔"
\v 7 اسرائیلس منٛز اوس اتھ زمانس منٛز یہِ ریواج زِ اگر زٕ زٔنؠ پانہٕ وٲنؠ کانٛہہ چیژ مۅکلاونَس یا بدلاونس پٮ۪ٹھ رٲضؠ سپدہن تہٕ اکھ نفر اوس پنُن کھۅربانہٕ کڈان تہٕ دویمِس نفرس دِوان۔ یتھؠ پٲٹھؠ ٲسؠ تِم سودا یا مہادٕ اسرائیلس منٛز مکمل کران۔ \f + \fr 4‏:7 \ft بوُٹھ اوس اسرائیلس منٛز اکہِ قٕسمٕچ طاقتٕچ علامت سمجھنہٕ یوان، باقین جاین ہنٛدؠ پٲٹھؠ، تہٕ سینڈل یا بوٗٹھ تُلنہٕ سٟتؠ اوس طاقت یا حقوقن ہنٛد ہتھیار تراونُک اِشارٕ دِنہٕ یوان۔ \f*
\v 8 رشتہٕ دارن ووٚن پتہٕ بوعزسؔ، "ژٕ ہیٚہِ پانہٕ یہِ زمین" تہٕ تٔمؠ کۅڈ پنُن کھۅربانہٕ کھۅر تہٕ دِتُن بوعزسؔ۔
\v 9 پتہٕ وُن بوعزنؔ معزز نفرن تہٕ تتہِ موجود سارنےٕ لوٗکن، "توٚہؠ سٲری چُھو گواہ زِ مےٚ ہیٚوت نعومی یس نِشہ سُہ سورےٕ جائیداد مٔلؠ یُس الیملکؔ، کلیون، تہٕ محلون سُنٛد اوس۔
\v 10 بہٕ چُھسن محلون سنٛز بیوہ موٲبؠ رُوت تہِ پنٕنؠ خاندارِنؠ بناوان۔ یمہِ غرضہٕ زِ تس زیوِ نیٚچو یُس پتہٕ محلون سُنٛد گنٛزرنہٕ ییہِ تہٕ تمسنٛدِ جائیدادک وٲرث بنہِ۔ یُس تمسنٛدین رشتہٕ دارنت تہٕ آبٲئی شہرس منٛز تمسنٛدِ خاندانُک ناو جٲری تھاوِ۔ اتھ سٲرسےٕ چُھو توٚہؠ گواہ۔ از چُھو توٚہہِ یِم چیٖز وُچھمٕتؠ تہٕ بوزؠ مٕتؠ، تہٕ ہیکِو تِمن مُتعلِق کٲنسہِ تہِ سٕتؠ کتھ کٔرِتھ یُس تہِ تِمن متٮعلق پرٕژھیٚو۔"
\v 11 ساروٕے معزز تہٕ باقی لوکو یمہٕ اتہِ شہرٕکِس دروازس پٮ۪ٹھ موجود ٲسؠ کوٚر اتھ سٟتؠ اتفاق تہٕ ونُکھ، اسہِ وُچھ تہٕ بوز۔ أسؠ چھِ دُعا کران زِ یہُوواہؔ بنٲوِن أمِس زنہٕ یۅسہ چٲنِس گرس منٛز ینہٕ واجِنؠ چھےٚ راخِلؔ تہٕ لیاہؔ ہَس ہِش، تمہٕ دوشوے یمو سانین جدن اجدادن زایُن دیُت تہٕ سون اسرائیلی قوم بارسس اوٚن۔ أسؠ چھِ یژھان زِ توٚہؠ گٔژھیٚو افراتہ قبیلکؠ امیر تہٕ بیت لحمسؔ منٛز معروف سپدٕنؠ۔
\v 12 أسؠ چھِ دُعا کران زِ تُہنٛد خاندان بٔنِن تُہنٛدین جد اجداد فارصؔ کیٚن یہُوداؔ تہٕ تمر سںنٛدین نیٚچوٮ۪ن ہیٚوٗ۔ تکیازِ واریاہ نسٕل آسن یم یہُوواہؔ ژےٚ دییہِ أمِس جواں خوتونہِ ہنٛدِ ذریعہ۔ \f + \fr 4‏:12 \ft فارص اوس افرات قبیلُک جد، یتھ سٟتؠ بوعز پانہٕ تعلُق تھاوان اوس۔ \f*
\v 13 لہٰذا أنؠ بوعزن رُوت تہٕ سۅ بنییہِ تمؠ سنٛز خاندارِنؠ تہٕ کٔرن تمِس سٟتؠ صحبت۔ یہُوواہؔ سٕنٛدِ یژھنہٕ روز سۅ بیٚیہِ زُووٕ تہٕ تمہِ دیُت أکِس گۅبرس زایُن۔
\v 14 ییٚلہِ بچن زایُن لوٚب، بیت لحم چیو زنیٚو وُن نعومیؔ، "یہُوواہسؔ کُن کرِ شُکر یمؠ ژےٚ از پننہِ خاندانٕچ حفاظت کرنہٕ باپتھ اکھ مرد عطا کوٚرےٕ۔ أسؠ چھِ یژھان زِ سارے اسرائیل لٕکؠ لوٗکھ گٔژھؠ تمسُنٛد ناو زاننؠ۔
\v 15 چٲنؠ نۅش یۅسہ ژےٚ محبت کران چھےَ چھی امہِ کھۅتہٕ بہتر زِ ژےٚ آسہ ہنےِ ستتھ نِچیٚوؠ۔ یمہِ أمِس زایُن دیُت۔ لہٰذا دِیی ژےٚ یہِ جوٲنی ہُنٛد احساس۔ تہٕ یہِ بنی ژےٚ بُجرس منٛز غذا دِنہ وول۔
\v 16 نعومی تُل یہِ بچہٕ تہٕ رۅٚٹُن پانس نِشہ تہٕ یتھٕ کِنؠ تھوو تٔمؠ تمسُنٛد خیال۔ \f + \fr 4‏:16 \ft تٔمؠ روٚٹ یہِ بچہٕ کھۅنہِ منٛز زنتہٕ منٛگتہ یمہِ سٟتؠ امسنٛزِ دایہِ ہنٛدؠ پٲٹھؠ ذِمہٕ دٲری بنییہِ۔ \f*
\v 17 تمہٕ زنہِ یمہٕ تمِس انٛدؠ پٔکؠ آسہٕ روزان لجہِ وننہِ زِ نعومیؔ اوس ؤنؠ اکھ نیٚچو۔ تِمو کوٚر تس عبیدؔ ناو۔ پتہٕ بنیاو عبیدؔ یسّیؔ سُنٛد مول، یُس بادشاہ داوود سُنٛد وٲلد اوس۔
\v 18 تہٕ فارصؔ سُنٛد نسب نامہٕ چُھ یتھ کٔنؠ۔ حصرونؔ چُھ فارص سُنٛد نیٚچو۔
\v 19 حصرونؔ سُنٛد نیٚچو اوس رام تہٕ رامؔ سُنٛد اولاد اوس عِمیندآبؔ
\v 20 عِمیندآبؔ سُنٛد اولاد گو نحسونؔ۔ تہٕ نحسونؔ سُنٛد سلمون۔
\v 21 سلمون سُنٛد نیٚچو اوس بوعزؔ تہٕ بوعزؔ سُنٛد نیٚچو گو عبیدؔ۔
\v 22 عبیدؔ سُنٛد اولاد اوس یسّیؔ تہٕ یسّیؔ سُنٛد اولاد اوس بادشاہ داوود۔ \f + \fr 4‏:22 \ft یہٕ داوود چُھ پتہٕ اسرائیل لُک مشہور بادشاہ داووُدؔ\f*
