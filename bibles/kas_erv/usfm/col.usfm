\id COL - DMT Kashmiri
\toc1 کلسیوں
\mt1 کلسیوں
\c 1
\p
\v 1 بہٕ، پولُسؔ، چھُس توٚہہِ یہِ نامہٕ لیٚکھان، تہٕ تیمُتھیس سون سٲتھی ایمان وول چھُ مےٚ سٟتؠ۔ خداین سوزُس بہٕ یسوع مسیحؔ سٕنٛز نمایندگی کرنہٕ خٲطرٕ، تکیازِ یہِ کرنُک چُھ خداین انتخاب کوٚرمُت۔ \f + \fr 1‏:1 \ft یہِ خط چُھ پولُسؔ لیٚکھان، تیمُتھیس سُپد تس صرف مبارکبٲدی پؠٹھ شٲمل۔ \f*
\v 2 بہٕ چُھس یہِ نامہٕ توٚہہ سوزان یم خدایہِ سٕنٛدؠ لوٗکھ چھِ تہٕ وفادار سٲتھی ایمان وٲلؠ چھِ مسیحسؔ سٟتؠ مُتحِد، یِم کُلُسّے کِس شہرس منٛز چھُ روزان۔ خدا سون بب تہٕ خداوند یسوع مسیحؔ روزِن توٚہہِ سٟتؠ مہربان تہٕ بنٲوِن توٚہہِ پُر امن۔
\v 3 أسؠ چھِ اکثر توٚہہِ خٲطرٕ دُعا کران۔ ییٚلہِ أسؠ کران چھِ، أسؠ چھِ خدایہِ سُنٛد شُکر ادا کران، سٲنِس خداوند یسوع مسیحؔ سُنٛد بب،
\v 4 تکیازِ ہیٚچھمُت چُھ زِ توٚہؠ چھُو یسوع مسیحسؔ پیٚٹھ بھروسہٕ کران تہٕ یہٕ زِ توٚہؠ چھُو خدایہِ سنٛدین تمام لوٗکن لول بران۔
\v 5 توٚہؠ چھُو یِمہٕ کامہِ کران تکیازِ توٚہؠ چھُو اعتمادٕ سان پرٛتھ چیزُک انتظار کران یُس خدا آسمانس منٛز توٚہہِ خٲطرٕ تھاوان چُھ۔ توٚہہ ہیٚچھو گۅڈٕ تِمن تمام چیزن مُتعلق یِمہٕ خدایس توٚہہِ خٲطرٕ چھِ ییٚلہِ توٚہہِ پوٚز پٲغام بوزُو، یۅسہٕ مسیحسؔ متعلق رٕژ شیٚچھ چھےٚ۔
\v 6 یتھٕ پٲٹھؠ توٚہہِ کلیسس منٛز یہِ رٕژ شیٚچھ بوزٕو تہٕ اتھ پیٚٹھ ایمان أنوٕ، واریاہن جاین منٛز لوٗکن ہُنٛد بڑٕوُن تعداد تہِ چھِ بوزان تہٕ اتھ پیٚٹھ یقین کران۔ یِم لوٗکھ چھِ ووٚنؠ مختلف طریقو روزان، یتھٕ کِنؠ زن توٚہہِ گۅڈنکہِ لٹہِ اتھ متعلق ہیٚچھنہٕ پتہٕ چھُو مختلف طریقو روزان تہٕ صحیح پٲٹھؠ چُھو تجربہٕ کوٚرمُت زِ خدا کِتھہٕ پأٹھؠ چُھ اسہِ پیٚٹھ مہربان۔
\v 7 یہٕ چُھ تہِ، یہِ توٚہہِ سٲنِس سٲتھی ماتحتس ایپفراسن ووٚنمُت چھُ زِ سپدِ۔ سُہ چُھ اسہِ سٟتؠ مسیحؔ سٕنٛدِ باپتھ کٲم کران، تہٕ أسؠ چھِ تس لول بران۔ سُہ چُھ وفادٲری سان مسیحسؔ خدمت کران سانہِ نمایندٕ رنٛگؠ۔
\v 8 تٔمؠ ووٚن اسہِ زِ توٚہؠ چھُو لول بران تمام خدایہِ سنٛدین لوٗکن، یتھٕ کِنؠ خدایہِ سٕنٛدؠ روحن چُھ توٚہہِ یہٕ کرنہٕ خٲطرٕہ بااختیار بنٲوؠ مٕتؠ۔
\v 9 پرٛتھ چیزٕ کہِ وجہ سٟتؠ یِم ایپافراسن اسہِ ؤنؠ، تمہِ وقتہٕ پیٚٹھٕ ییٚلہِ تٔمؠ اسہِ گۅڈنِکہِ لٹہِ ووٚن توٚہہِ متعلق، أسؠ گے مسلسل توٚہہِ خٲطرٕ دعا کرنس منٛز أمِس سٟتؠ شٲمِل۔ ییٚلہِ أسؠ توٚہہِ خاطرٕ دعا چِھ کران، أسؠ چھِ خدایس ونان زِ سُہ ہاوِ توٚہہ سٲری چیز یِم سُہ یژھان چھُ زِ توٚہؠ گٔژھِو کرٕنؠ تہٕ بناوِ توٚہہ سُوٛ چیز سمجھنس قٲبل یُس خدایہِ سُنٛد روح ہیٚچھناوان چُھ۔
\v 10 أسؠ چھِ دعا کران زِ توٚہہِ لگہِ پتاہ زِ خدا کیا چُھ یژھان تاکہِ توٚہؠ ہیٚکِو تِتھٕ پٲٹھؠ زِنٛدٕ روزِتھ یمہِ سٟتؠ خداوندس عزت واتہِ تہٕ سُہ گژھِ پرٛتھ طریقہٕ خوش۔ ییٚلہِ توٚہؠ یتھٕ کِنؠ روزِو، توٚہؠ روزِو پرٛتھ قٕسمٕچ اصل کٲم کران تہٕ لگاتار خدایس بہتر پٲٹھؠ زانان۔
\v 11 یودوے توٚہؠ یتھٕ پٲٹھؠ روزِو خدا کرِ توٚہہِ واریاہ مضبوط زِ توٚہؠ کٔرِو تمام حالاتن منٛز صبر سان برداشت، تہٕ یہِ خوشی سان کرنہٕ خٲطرٕ۔ خدا ہیٚکہِ توٚہہِ واریاہ مضبوط بنٲوِتھ تکیازِ سُہ چُھ شاندار طاقتہٕ وول۔
\v 12 پتہٕ کٔرِو توٚہؠ لگاتار بب سُنٛد سٲنِس خدایہِ سُنٛد شکُر ادا۔ تکیازِ تٔمؠ چُھو توٚہؠ تتھ پرٛتھ چیزس منٛز حصہٕ نِنس لائق بنٲوؠ مٕتؠ یُس تمِس پننین لوٗکن دیُن چُھ ییٚلہِ تِم تمِس سٟتؠ آسن۔
\v 13 خداین سٲنؠ ببن چھِ أسؠ بد خواہ نِشہٕ بچٲوؠ مٕتؠ، یُس اسہِ قابو اوس کران، تہٕ تٔمؠ چھِ أسؠ پننِس گۅبرس دِیتمٕتؠ، یمِس سُہ لول چھُ بران، تاکہِ ووٚنؠ ہیٚکو أسؠ أمؠ سنٛدِس گۅبرؠ سٕنٛز اطاعت کٔرِتھ۔
\v 14 تکیازِ أسؠ چِھ أمؠ سٕنٛدِس گۅبرس سٟتؠ مُتحِد، خداین چھِ أسؠ آزاد کٔرؠ مٕتؠ۔ یعنی تٔمؠ چھِ سٲنؠ گناہ معاف کٔرؠ مٕتؠ۔
\v 15 خداے سُنٛد گۅبرؠ چُھ پوٗرٕ پٲٹھؠ ظٲہِر کران زِ خدا کُس چُھ، حالانکہِ کانٛہہ تہِ ہیٚکہِ نہٕ خدایس وُچھِتھ۔ خدایہِ سٕنٛدِ کینٛہہ تہٕ تخلیق کرنہٕ برونٛہہ اوس گوبر موجود، تہٕ أمِس چُھ گۅڈنیُک مقام حٲصِل پرٛتھ چیزس پیٚٹھ یُس خداین بنوومُت چُھ۔
\v 16 توٚہؠ ہیٚکِو زٲنِتھ زِ گۅبر اوس کُنہِ تہِ چیزٕ برونٛہہ موجود تہٕ پرٛتھ چیزس پیٚٹھ چُھ گۅڈنیُک مقام تھاوان تکیازِ ببن تہٕ گۅبرؠ بنٲوؠ یِکہٕ وٹہٕ سٲری چیز یِمہٕ موجود چھِ۔ اتھ منٛز چھِ شٲمل آسمانس تہٕ زمینس پیٚٹھ پرٛتھ کانہٛہ چیز، تہٕ پرٛتھ کانہٛہ چیز یُس أسؠ وُچھِتھ ہیٚکو تہٕ پرٛتھ کانہٛہ چیز یُس نہٕ أسؠ وُچھِتھ ہیٚکو، بشمول روحٲنی مخلوق یتھ منز زَن تخت، تسلط، حکمران تہٕ حکام چھِ۔ ببن تہٕ گۅبر بنوو یِکہٕ وٹہٕ پرٛتھ کانہٛہ چیز، تہٕ گۅبرس عزت کرنہٕ خٲطرٕ چُھ پرٛتھ کانہٛہ چیز موجود۔
\v 17 نیٚچو اوس کُنہِ تہِ تخلیق کہِ وجود برونٛٹھ موجود، تہٕ سُہ چُھ اتھ سٲرؠ سےٕ قٲیم تھاوان تہٕ جوڑان۔ \f + \fr 1‏:17 \ft مُکاشفہ 1:8\f*
\v 18 کلیسیا کہِ حوالہٕ، یعنی سٲری ایماندار، سُہ چھُ اتھ پیٚٹھ حکمرٲنی کران یتھٕ پٲٹھؠ لوٗکن ہُنٛد کلہٕ چِھ تُہنٛدین جسمس پیٚٹھ حکمرٲنی کران۔ تٔمؠ بنوو یہٕ ممکن زِ کلیسیا گژھہِ شروع ییٚلہِ سُہ مرنہٕ پتہٕ دوبارٕ زندٕہ روزن وول گۅڈنیُک شخص اوس، دُبارٕ زانٛہہ تہِ مرِ نہٕ۔ تمِس مُتعلِق یِمو چیزو ۂنٛدِ وجہ سٟتؠ چھُ سُہ کُنہِ تہِ چیزٕ تہٕ بیٚیہِ کٲنٛسہِ تہِ کھۅتہٕ زیادٕ اہم۔
\v 19 گۅبر چُھ پرٛتھ چیزس پیٚٹھ حکمرٲنی کران تکیازِ گۅبر چُھ مکمل پٲٹھؠ خدا، یتھٕ پٲٹھؠ زَن ببن خوشی سٟتؠ تس یہِ بننُک ارادٕ چھُ کوٚرمُت۔
\v 20 ببَ خداین تہِ چُھ گۅبرؠ سٕنٛدِ ذریعہٕ کٲم کرنُک انتخاب پورٕ کایناتس منز پننس پانس سٟتؠ پرٛتھ کُنہِ آسمانکِس تہٕ زمین ہنٛدِس چیزس سٟتؠ صلح کرنہٕ خٲطرٕہ کوٚرمُت تہٕ پرٛتھ اکھ نفر یُس تٔمؠ تخلیق چھُ کوٚرمُت۔ خداین کوٚر یہِ پننِس گۅبرؠ سٕنٛدؠ ذریعہٕ ییٚلہِ تٔمسُنٛد گۅبر صلیبس پیٚٹھ مود، یمہٕ سٟتؠ خدا تہٕ تمسٕنٛدِس تخلیقس درمیان سورےٕ کینٛہہ پُر امن بنیو۔
\v 21 مسیحسؔ پیٚٹھ یقین تھاونہٕ برونہٛہ ٲسِو نہٕ توٚہؠ خدایس نزدیک روزُن یژھان، تہٕ توٚہہِ ٲسٕو تمِس سٟتؠ دشمنی تکیازِ پرٛتھ کانہٛہ سُہ چیز یُس توٚہہِ سونچُو تہٕ کوٚرو، اوس بُرٕ۔
\v 22 مگر تہِ چُھ سورےٕ بدلیومُت ووٚنؠ زِ توٚہؠ چھُو یسوعس پیٚٹھ یقین تھاوان! خداین یعنی بب خداین چِھ پننس گۅبرٕ سٕنٛدِ ذریعہٕ پانس تہٕ توٚہہ درمیان تعلقن ہنٛز مرمت کٔرمژ ییٚلہِ تٔمؠ سُنٛد گۅبر انسان بنیو تہٕ مود۔ خداین یعنی ببن کٔر تعلقاتن ہنٛز مرمت تاکہِ توٚہؠ ہیٚکو أمِس سٟتؠ تِمن لوٗکن ۂنٛدؠ پأٹھؠ روزِتھ یِم گنہو نِش مکمل پٲٹھؠ پاک چِھ۔
\v 23 یہٕ چھُ توٚہہِ مُتعلق سورےٕ پوٚز یۅتام توٚہؠ اعتمادٕ سان مسیحسؔ پیٚٹھ یقین کرُن جٲری تھٲوِو، تہٕ یۅتام نہٕ توٚہہِ اعتمادٕ سان یہٕ امید ترایو زِ خدا سُنٛد یہٕ وعدٕ چُھ پوٗرٕ کرُن تتھ رٕژِ شیٚچھِ منٛز یۅسہ توٚہہِ بوزمٕژ چھےٚ تہٕ یہٕ زِ پورٕ دنیاہس منز لوٗکو بوزمٕژ چھےٚ۔ بہٕ، پولُسؔ، چُھس یمہِ رٕژِ شیٚچھِ ہُنٛد لوٗکن منٛز اعلان کٔرتھ آسمان کِس خدایہِ سٕنٛز خدمت کران
\v 24 موجودٕ وقتس منٛز چُھس بہٕ خوشی سان دُکھ تُلان تکیازِ یہِ چھُ تُہنٛدِ فٲیدٕ خٲطرٕ۔ بہٕ چُھس جسمٲنی طور تِم دُکھ مکمل کرنہٕ خٲطرٕہ دُکھ برداشت کران یُس مسیحنؔ پننین لوٗکن، کلیسیا کہِ طرفہٕ شروع کوٚر، یُس مسیحؔ سنٛدِس پننِس جسمس ہیو چُھ۔
\v 25 خداین دیُت مےٚ ناد پننِس کلیسیا ہس خدمت کرنہٕ خٲطر، تہٕ تٔمؠ کوٚرُس بہٕ پنُن منصوبہ انجام دِنہٕ خٲطرٕ خاص پٲٹھؠ مقرر، یُس توٚہہِ متعلق چھُ۔ یمہٕ منصوبُک میون حصہٕ چُھ توٚہہ غأر یہودٮ۪ن خدایہِ سٕنٛدِ طرفہٕ مکمل پٲغامُک اعلان کرُن۔
\v 26 خداین تھوو یہٕ پٲغام اکھ راز، تہٕ تھووُن یہٕ واریاہس کالس لوٗکن نِش کٔھٹِتھ۔ مگر ووٚنؠ چھُ تٔمؠ پننٮ۪ن لوٗکن امہِ پٲغامچ زٲنؠ یٲبی دِژمٕژ۔
\v 27 خدا چُھ پننین لوٗکن یہِ واریاہ شاندار پٲغام ونُن یژھان یُس راز اوس، یُس غأر یہُودین تہٕ یہُودین پیٚٹھ تہٕ لاگو چُھ گژھان۔ راز چُھ یہٕ زِ مسیحؔ چُھ توٚہہِ غٲر یہُودین سٟتؠ مُتحِد، یمیُک مطلب چُھ زِ توٚہؠ ہیٚکِو اعتماد سان مسیحؔ سنٛدؠ پٲٹھؠ شاندار مخلوق بننٕچ امید کٔرِتھ۔
\v 28 یہٕ چُھ مسیحؔ یمسُنٛد اعلان أسؠ پرٛتھ کٲنسہِ خٲطرٕ چِھ کران۔ ییٚلہِ أسؠ أمِس متعلق کتھ چِھ کران، أسؠ چھِ پرٛتھ شخصس تیژ دٲنشمندی سان خبردٲری کران تہٕ ہچھناوان ییژاہ أسؠ کٔرِتھ ہیٚکو۔ أسؠ چھِ یِمہٕ کامہِ کران تاکہ یِمو لوٗکو منٛزٕ بنہِ مسیحسؔ سٟتؠ پرٛتھ شخصہٕ سٕنٛدِس میلنس منٛز پرٛتھ کانہٛہ روحأنی طور بالغ
\v 29 بہٕ چُھس یہٕ مقصد پورٕ کرنہٕ خٲطرٕ یُس بہٕ کران چُھس سخٕت محنت کران۔ بہٕ ہیٚکہٕ یہٕ کٔرتھ تکیازِ مسیحؔ چُھ طاقتہٕ سان مےٚ یہٕ کرنس قٲبل بناوان۔
\c 2
\p
\v 1 بہٕ چُھس یِم چیز لیٚکھان تکیازِ بہٕ چُھس یژھان توٚہہِ یہِ زٲنؠ راوُن زِ بہٕ کٲژاہ محنت چُھس کران۔ بہٕ چُھس سخٕت محنت کران تہنٛدِ باپتھ، تِمن سٲتھی ایمان والیٚن باپتھ یم لودیہ شہرس منٛز روزان چھِ، تہٕ تِمن سارنےٕ سٲتھی ایمان والیٚن باپتھ یمنہٕ مےٚ ذٲتی طور سمکھیمٕتؠ چِھ۔
\v 2 بہٕ چُھس یہِ سخت کٲم کران توٚہہ سارنی ہنٛز حوصلہٕ افزٲئی کرنہٕ خٲطرٕ یم نہٕ مےٚ سمکھیمٕتؠ چھِ تاکہِ توٚہؠ کٔرِو پنُن پان اکھ أکس سٟتؠ لولہٕ سان یِکوٹہٕ۔ بہٕ چُھس یژھان توٚہؠ سمجھِو مکمل پٲٹھؠ تہٕ اعتمادٕ سان سُہ راز یُس خداین گۅڈٕ کٔھٹِتھ تھومُت اوس۔ یہِ راز چُھ مسیحسؔ متعلق۔
\v 3 یہِ راز، یُس مسیحؔ چُھ، اتھ منٛز چھِ تِم سٲری چیز شٲمل یِم عٲلیشان تہٕ قٟمتی چھِ دٲنشمندانہٕ سوچس سان۔
\v 4 بہٕ چھُس توٚہہِ اتھ رازس متعلق ونان تاکہِ کانٛہہ تہِ شخص یُس ترغیب دِنہٕ والہِ طریقہٕ واد واد کرِ ہیٚکہِ نہٕ توٚہہِ تتھ پیٚٹھ یقین کرنہٕ خٲطرٕ رٲضی کٔرِتھ یہِ چھُ نہٕ پوٚز۔
\v 5 توٚہؠ ہیٚکِو زٲنِتھ زِ یِم لوٗکھ قائل کرنہٕ خٲطرٕ بحث چھِ کران تِم چھِ غلط تکیازِ بہٕ چُھس تُہنٛد پرواہ کران روحٲنی تہٕ توٚہہِ مُتعلِق سونچان، حالانکہِ بہٕ چُھس نہٕ ذٲتی طور توٚہہِ سٟتؠ۔ بہٕ چھُس واریاہ خوش یہِ وُچھِتھ زِ توٚہؠ چھُو صحیح پٲٹھؠ برتاؤ کران تہٕ توٚہؠ چھُو مسیحسؔ پیٚٹھ پوٗرٕ پٲٹھؠ یقین تھاوان۔
\v 6 ووٚنؠ ییٚلہِ مےٚ توٚہہِ رٕژِ شیٚچھِ تہِ پانس متعلق پوٚز چُھ ووٚنمُت، بہٕ چھُس یژھان زِ توٚہؠ کٔرِو تِتھے پٲٹھؠ برتاؤ یتھٕ پٲٹھؠ زن بہتر روزِ یہِ زن خداین توٚہؠ مسیحسؔ سٟتؠ متحد کٔرِمٕتؠ چھُو۔ توٚہہِ پزِ تِتھے پٲٹھؠ برتاؤ کرُن یتھٕ پٲٹھؠ توٚہہِ کوٚرُو ییٚلہِ توٚہہِ یسوع مسیحؔ خداوند قبول کوٚروُن۔
\v 7 یتھٕ پٲٹھؠ برتاو کرنس منٛز چُھ شٲمل أمِس سٟتؠ مضبوطی سان متحد روزُن، یتھ پٲٹھؠ کُلیٚن ۂنٛدؠ موٗل چھِ اتھ مضبوطی سان تھاوان۔ اتھ منز چُھ یِتہٕ شٲمل مکمل طور تمِس پیٚٹھ منحصر روزُن، یتھٕ پٲٹھؠ اکھ مکان چُھ پننِس کٕنس پیٚٹھ دٔرِتھ آسان۔ اتھ منز چُھ یِتہٕ شٲمل اعتمادٕ سان مسیحسؔ پیٚٹھ بھروسہٕ کرُن، یتھٕ پٲٹھؠ زَن ایپافراسن توٚہؠ ہیٚچھنٲوِو، تہٕ زیادٕ کھۅتہٕ زیادٕ شُکر ادا کوٚرُن\f + \fr 2‏:7 \ft اپپراسؔ چُھ یتٮ۪ن وۅستاد\f*۔
\v 8 ہوشیار روزِو تاکہِ کانٛہہ تہِ سُہ یُس توٚہہِ پزرٕ نِشہٕ دوٗر کرنٕچ کوٗشِش کرِ گژھِ نہٕ کامیاب۔ کانٛہہ تہِ سُہ یُس توٚہہِ نِنٕچ کوشِش کرِ سُہ کرِ انسٲنی سونٛچ استعمال یُس بے معنی تہٕ دوکھہٕ دِنہٕ وول آسہِ۔ یُتھ غلط پٲغام چُھ یوان یمہٕ سٟتؠ پرانہِ پُیہِ نوین پوٚین ہٮ۪چھناوان چِھ زِ انسان کیا چھُ عام پٲٹھؠ دنیاہس متعلق سونٛچان، نَہ زِ مسیحؔ سٕنٛدِ سٟتؠ۔
\v 9 بہٕ چُھس مسیحؔ سُنٛد ذِکر کران تکیازِ سُہ، اکھ انسان، چُھ مکمل پٲٹھؠ خدا۔
\v 10 أمہٕ علاوٕ، چھُ توٚہہ نِش سورےٕ کینٛہہ یہِ توٚہہِ ضرورت چُھ تکیازِ خداین چُھو توٚہؠ مسیحسؔ سٟتؠ متحد کٔرؠ مٕتؠ، یُس روحٲنی وجودن پیٚٹھ حکمرٲنی کران چُھ، یتھ منٛز پرٛتھ کانہٛہ حٲکم تہٕ پرٛتھ کانہٛہ اختیار شٲمل چُھ۔
\v 11 ییٚلہِ خداین توٚہؠ مسیحسؔ سٟتؠ مُتحِد کٔرِو، یہٕ اوس زنتہٕ ببن یعنی خداین توٚہہِ ختنہٕ کوٚرمُت۔ میون مطلب چُھنہٕ یہِ زِ اکھ انسان چُھ جسمٲنی طور توٚہہِ ماز ژٹان۔ بلکہٕ ماز ژٹنہٕ بجائے، خداین کٔرؠ تُہنٛدؠ کمزور تہٕ گناہ گار حصہٕ جُدا۔ خداین کوٚر تُہنٛد یتھٕ پٲٹھؠ ختنہٕ یتھٕ پٲٹھؠ مسیحنؔ سرانجام دِیت۔
\v 12 ییٚتہِ چھُ سمجھنُک یہِ بیاکھ طریقہٕ زِ خداین کیا چُھ توٚہہِ خٲطرٕ کوٚرمُت: ییٚلہِ تِمو توٚہہِ بپتسمہ دیُت، یہِ اوس زن توٚہؠ مودِو تہٕ لوٗکو کٔرِو توٚہؠ دفن تکیازِ خدا یعنی ببن کٔرِو توٚہؠ شٲمل ییٚلہِ مسیحؔ مود تہٕ لوکو کوٚر سُہ دفن۔ تہٕ یہٕ اوس زنتہٕ خداین یعنی ببن کٔرِو توٚہؠ واپس زِندٕ تکیازِ تٔمؠ کٔرِو توٚہؠ شٲمل ییٚلہِ تٔمؠ مسیحؔ بیٚیہِ زِندٕ کوٚر۔ یہٕ سپدیاو تکیازِ توٚہہِ اوس یقین زِ خدا یعنی بب چُھ طاقتہٕ سان کٲم کران، خاص کر ییٚلہِ تٔمؠ مسیحؔ بیٚیہِ زِندٕ کوٚر۔
\v 13 توٚہؠ ٲسِو روحٲنی طور مودمٕتؠ، تکیازِ توٚہہِ ٲسِو اکثر خدایس خلاف گناہ کٔرؠ مٕتؠ تکیازِ توٚہؠ ٲسِو غٲر یہودی تہٕ نہ زِ خداے سنٛدین لوٗکن ہُنٛد حصہٕ۔ مگر خداین یعنی ببَ خداین انیوو توٚہؠ روحٲنی طور زندگی منٛز واپس تکیازِ تٔمؠ کٔرِو توٚہؠ شٲمل ییٚلہِ تٔمؠ مسیحؔ واپس زندٕ کوٚر۔ أمیُک مطلب چُھ یہِ زِ تٔمؠ چُھ اسہِ تمن تمام غلط چیزن خٲطرٕ معاف کوٚرمُت یِم تمس أمِس خلاف چھِ کٔرؠ مٕتؠ۔
\v 14 یہٕ اوس زنتہٕ خدایس نِش تمن قرضن ہُنٛد اکھ سرکٲرؠ فہرست یم اسہِ ادا کرٕنؠ چھِ، یم سٲنؠ گناہ چِھ۔ ییٚلہِ تٔمؠ اسہِ معاف کوٚڑ، تٔمؠ مِٹوو گُنہن ہُنٛد سُہ فہرست یُس اسہِ خلاف گنٛزرنہٕ یوان اوس، تہٕ تٔمؠ رکٲوؠ یِم اسہِ تہٕ تس درمیان یِنہٕ نِشہٕ۔ خداین کوٚڑ یہِ تمہ وقتہٕ پورٕ ییٚلہ مسیحؔ صلیبس پیٚٹھ مود، زنتہٕ یقینی طور تمؠ اوس فہرستس صلیبس پیٚٹھ کیُل دیتمُت۔
\v 15 أمہِ مزید، خداین دِژ دنیاہس پیٚٹھ حکمرٲنی کرن والیٚن روحٲنی مخلوقن شِکست، تہٕ تٔمؠ ہوو عوٲمی طور زِ تٔمؠ دیُت تِمن شِکست، یتھٕ کِنؠ زَن تٔمؠ ٲسؠ تِم قٟدین ہنٛدؠ پٲٹھؠ اٹؠ اٹؠ کٔڈؠ مٕتؠ۔ خداین کوٚر یہِ ییٚلہِ مسیحؔ مود صلیب پیٚٹھ۔
\v 16 یمن چیزن ہنٛدِ وجہہ کِنؠ یِم خداین تُہنٛدِ خٲطرٕ کٔرؠ، اتھ متعلق مہٕ کٔرِو فِکر زِ باقٕے لوٗکھ کیاہ چھِ ونان زِ توٚہہ کیاہ پزِ کرُن۔ تِمن ہیٚکن رایہِ ٲسِتھ زِ کیا چُھ کھیٚون تہٕ کیا چھُ چیٚوُن۔ تِمن ہیٚکن اتھ بارس منٛز رایہِ أسِتھ کمن خاص دوٚہن ہنٛد مُشاہدٕ کرنہٕ باپتھ، بشمول خدایہِ سنٛدِ عبادتہٕ خاطرٕ دوٚہہ، ییٚلہِ نٔو زوٗن آسہٕ جشن مناونہٕ خاطرٕ دوٚہہ، یا آرام کرنہٕ خاطرٕ دوٚہہ۔
\v 17 خداین کٔرؠ استعمال یِم چیز اتھ کتھہِ کُن اشارٕ کران زِ تٔمؠ کیا اوس مستقبلس خٲطرٕہ منصوبہ بنومُت، یُس پانہٕ مسیحؔ سُنٛد یُن چُھ۔
\v 18 توٚہؠ سمکھِو کینٛژن لوٗکن یِم عٲجز آسنُک بہانہ کرنس تہٕ فرشتن ہنٛز عبادت کرنُک بہانہ کرنس منٛز مزٕ چھِ تُلان تہٕ یِم حٲرت انگیز چیزن متعلق کتھ کرٕنؠ پسنٛد چھِ کران یِم تِمو وُچھمٕتؠ چھِ۔ تم چھِ یتھٕ کِنؠ کٲم کران زنتہٕ تِم عظیم چھِ۔ حالانکہ اصل وجہ بغأر، تکیازِ تِم چھِ صرف انسأنؠ طریقو سونٛچان۔ یِمن لوٗکن مہٕ تھٲیِو کَن یِم تہِ نِنٕچ کوٗشِش چھِ کران چھِ یِم خداے توٚہہِ دِنہٕ خٲطرٕ تیار چھُ۔
\v 19 یِم لوٗکھ چِھنہٕ مسیحسؔ وفادار روزان۔ یہِ چُھ سُہ یُس کلیسیاہچ قیادت چُھ کران، یتھٕ پٲٹھؠ زن لوٗکن ہُنٛد کلہٕ چھُ تہنٛدِ جسمٕچ قیادت کران۔ کلہٕ چُھ ہدایت کران زِ پورٕ جسم، پرٛتھ حصہٕ کِتھہٕ کٔنؠ چُھ اتھ ضرورت تہٕ یہِ کِتھہٕ پٲٹھؠ چُھ یِکوٹہٕ کٲم کران۔ یتھٕ پٲٹھؠ چُھ جسم بڑان۔ بالکل یِتھے پٲٹھؠ، چُھ مسیحؔ کلیسیاہچ قیادت کران تاکہِ یہِ بڑِ یتھٕ پٲٹھؠ خدا چھُ یژھان۔
\v 20 یہِ چُھ یتھٕ کِنؠ زنتہٕ چھُو توٚہؠ مودؠ مٕتؠ، تکیازِ خداین کٔرِو توٚہؠ شٲمل ییٚلہِ مسیحؔ مود۔ یہِ چُھ توٚہہ آزاد کران تِمن روحٲنی مخلوقن نِش یِم یتھ دنیاہس پیٚٹھ حکومت چھِ کران۔ لہٰذا، توٚہہِ پَزِ نہٕ تِمن اصولن ۂنٛز اطاعت کرٕنؠ یِم یِمو لوٗکو توٚہہِ دِتمٕتؠ چھِ۔ یہٕ کرُن مطلب چُھ زِ توٚہؠ ٲسِو پٔزی پٲٹھؠ وُنہِ تہِ یمہِ دنیاہِکؠ حصہٕ۔
\v 21 یمن اصولن منز چھِ احکام یتھٕ پٲٹھؠ شٲمل، "کینٛہہ چیز مہٕ کٔرِو محسوس، کینٛژن غذہن ہنٛز مہٕ کٔرِو کوشش، کینٛہہ چیزن مہٕ رٔٹِو\f + \fr 2‏:21 \ft 1تیمُتھیس 4:3\f*"
\v 22 یِتھؠ تمام اصول چِھ تمن چیزن سٟتؠ تعلق تھاوان یم تمہٕ وقتہٕ ختم گژھان چِھ ییٚلہِ لوٗکھ یِمن ہنٛد استعمال چِھ کران۔ أمہٕ مزید، لوٗکھ، نَہ زِ خدا، چِھ یم اصول ہٮ۪چھناوان تہٕ یِمن ہنٛز ضرورت چھےٚ۔
\v 23 یمن اصولن پیٚٹھ عمل کرُن ہیٚکہٕ تِمن لوٗکن خاطرٕ اکھ دٲنشمندانہٕ چیز بٲسِتھ یِم خدایہِ سٕنٛز عبادت چِھ کران یتھٕ پأٹھؠ تِم یژھان چھِ، یِم عٲجز آسنُک بہانہٕ چِھ کران، تہٕ یم پننن جسمن سٟتؠ بُرٕ سلوٗک چھِ کران پننہِ مذہبکہِ حصہٕ رنگؠ۔ ووٚنؠ گوو، یِمن اصولن پیٚٹھ عمل کرٕنؠ کرِ نہٕ توٚہہِ گناہ کرُن رُکاونس منٛز مدد۔
\c 3
\p
\v 1 یہِ مےٚ توٚہہِ برونٛہہ وون زِ واپس یُن گوو یتھٕ پٲٹھؠ ہرگاہ خداین توٚہؠ بیٚیہِ زندٕ کرِو، تکیازِ تمؠ کریو توٚہؠ شٲمل، ییٚلہِ تمؠ مسیحؔ دُبارٕ زندٕ کوٚڑ۔ أمی سببہٕ چُھس بہٕ یژھان تُہند توجو روزِ آسمانکین چیزن کن، ییٚلہِ زن مسیحؔ تٔتی چُھ۔ سُہ چُھ ببَ خدایس لرِ تختس پیٚٹھ بہتھ تہٕ ہر کُنہِ چیزن پٹؠھ چُھ راج کران۔ \f + \fr 3‏:1 \ft متی 6:20\f*
\v 2 بہٕ چُھس سونچان زِ توٚہؠ کریو خوٲہِش تمِچ یہِ خداین آسمانس منٛز تیار تھومُت چُھ نہٕ کہ تمچؠ یہِ زمیٖنہِ پیٚٹھ چُھ۔
\v 3 توٚہہِ پزِ یمہِ اندازٕ سونٛچن، زنتہِ توٚہؠ مودؠ مٕتؠ ٲسؠ ہو۔ توٚہؠ چھُو روحٲنی طور صرف أمی سببہٕ زندٕ تکیازِ خداین چھُو توٚہؠ پانس سٟتؠ قریبی تعلقاتن منٛز مسیحسؔ سٟتؠ متحد کٔرِمٕتؠ، تہٕ یہِ ہیکیو نہٕ وونؠ زمیٖنس پیٚٹھ وُچھِتھ۔
\v 4 توٚہؠ چھُو زندٕ تکیازِ خداین چھُو توٚہہِ مسیحسؔ سٟتؠ اتحاد کوٚرمُت۔ لہٰذا ییٚلہِ سُہ زمیٖنہِ پیٚٹھ واپس دُبارٕ واتہِ تہٕ تمس وُچھِ ہر کانٛہہ، تمہِ وزِ ٲسیٚو توٚہؠ تمس سٟتؠ۔ پتہٕ وُچھِ ہر کانٛہہ زِ توٚہؠ تہِ چھُو تمؠ سنٛدؠ پٲٹھؠ جلال وٲلؠ وجود بنیمٕتؠ۔ \f + \fr 3‏:4 \ft مسیح یُس سٲنؠ زندگی چُھ۔ \f*
\v 5 یہِ چُھ تُہند منٛزلِ مقصود تکیازِ تِمن خٲہِشن متعلق سونٛچِو یِم توٚہہِ یتھ دنیاہس منٛز بُرٕ کامہِ کرنہِ چھِ تِمن دشمنن ہندؠ پٲٹھؠ یِم توٚہہِ ہلاک پزن کرنؠ۔ تِمن بُرٕ کامیٚن منٛز چُھ زنا کرُن، ناپاک کامہِ کرنہِ، بدکٲری کرنؠ، بُرٕ کامیٚن ہنٛز خوٲہِش کرنؠ بییٚہِ لالچ کرنؠ، اپزٮ۪ن خداین عبادت کرنس برابر چھِ۔
\v 6 تکیازِ لوٗکن چھِ یِم خوٲہِشہٕ، خداے چُھ یِمن پیٚٹھ ناراض تہٕ تِمن دییہِ سزا۔
\v 7 توٚہؠ چھُو تِمنے ہندؠ پٲٹھؠ بُرٕ کامہِ کرنکؠ عٲدی۔ سُہ اوس تیلہِ ییٚلہِ توٚہہِ یِمن خٲہِشن پیٚٹھ عمل کٔروٕ۔
\v 8 مگر وونؠ چھُو توٚہہِ ایمان اوٚنمُت، توٚہہِ پزِ یِمو بُرٕ کامیو نِشہٕ لوٚب روزُن۔ یِمن بُرٕ کامیٚن منٛز چھے شرارتہٕ سان کٲم کرنؠ، باقین سٟتؠ شرارت ورتاوُن، باقین ہنٛدؠ جزبات مجروح کرنؠ، باقین ہنٛز غٲبت کرنؠ بییٚہِ بد کلٲمی کرنؠ شٲمل۔ \f + \fr 3‏:8 \ft افسینؔ 4:23، 24\f*
\v 9 توٚہہِ پزِ نہٕ بیین اپز ونُن۔ توٚہؠ چھُو نہٕ تِم لوٗکھ یِم توٚہؠ ٲسوٕ، تِم لوٗکھ یِم بدی ہندؠ طریقہٕ ورتاوان ٲسؠ۔
\v 10 ژےٚ چُھکھ وونؠ اکھ نوٚو شخص، اکھ سُہ شخص یِمس منٛز خداے کٲم کران چُھ یتھ ژےٚ سُہ اصل پٲٹھؠ زانہِ ہین۔ ژےٚ چُھکھ اکھ نوٚو شخص، یُس خدایس ہیو چُھ، یِم ژےٚ أکس نٔوِس شخصس منٛز تبدیٖل کوٚرکھ۔
\v 11 چونکہ توٚہؠ سٲری لوٗکھ چھُو نوے ییٚلہِ زن یہِ ضروری چُھنہٕ چاہے کانٛہہ چھا اکھ غٲر یہُودؠ یا اکھ یہودی، کٲنسہِ ختنہٕ چھا کنہٕ نہٕ، یا کانٛہہ شخص پردیسی چھا یا غٲر مہذب چھا یا کانٛہہ غلام چھا یا نہٕ۔ امہِ بجایہ چُھ مسیحؔ یُس زیادٕ ضروری چُھ، تہٕ خداین چُھ توٚہہِ سارنےٕ تمس سٟتؠ اتحاد کوٚرمُت۔
\v 12 خداین چھُو توٚہؠ ژٲرمٕتؠ، تمؠ چھُو توٚہؠ پننٕؠ لوٗکھ الگ کٔرمٕتؠ، سُہ چھُو توٚہہِ لول بران۔ یِمو کامیو تہٕ نوے لوٗکھ آسنہٕ سببہٕ پزِ توٚہہِ باقین سٟتؠ ہمیشہِ اصل پٲٹھؠ سلوٗک کرُن۔ اتھ منٛز چُھ تِمن متعلق فِکِر منٛد روزُن، تِمن پیٚٹھ مہربان آسُن، گمنڈ نہٕ کرُن، بد سلوٗکی نہٕ کرنؠ، زیادٕ کالس نہٕ ناراضگی تھاونؠ شٲمل۔
\v 13 توٚہہِ پزِ نہٕ آسٲنی سان اکھ أکس ناراض گژھُن۔ ییٚلہِ توٚہؠ باقین لوٗکن تِمن کامیٚن پیٚٹھ الزام چھُو دِوان یِم تِمو کٔرمٕژ چھےٚ، توٚہہِ پزِ تِمن معاف کرُن۔ توٚہہِ شۅبہِ یاد پاوُن زِ خداوندن چھُو توٚہہِ اکھ أکس معاف کرنہٕ باپتھ معٲفی دِژمٕژ۔
\v 14 ٲخرس پیٚٹھ، یہِ مےٚ ونمُت چُھ یُس ہر کُنہِ چیزٕ کھۅتہٕ اہم چُھ زِ توٚہہِ چُھ اکھ أکس لول برُن۔ یمہِ سٟتؠ توٚہؠ پانہٕ وٲنؠ اتفاق روزیٚو، یتھٕ کِنؠ زن خداین چُھ توٚہہِ یہِ کرنہٕ خٲطرٕ ووٚنمُت۔
\v 15 توٚہہِ پزِ امن قٲیم کرُن یُس مسیحنؔ توٚہہِ اکھ بنیٲدی عنصر دِیت ییٚلہِ توٚہؠ یہِ انتخاب کریو زِ کیاہ کرو۔ توٚہہِ پزِ یہِ کرُن تکیازِ خداین چھُو توٚہؠ امن قٲیم کرنہٕ خٲطرٕ ژٲرمٕتؠ یتھ کِنؠ سُہ توٚہہِ پانہٕ وٲنؠ نزدیک انان چُھ، زن چھُو توٚہؠ أکس نفرٕ سُنٛد جسم۔ بییٚہِ پزِ توٚہہِ خداۓ سٕنٛز شُکر گذٲری کرنؠ۔
\v 16 یتھۓ توٚہؠ سونچِو بییٚہِ کٲم کرِو، توٚہہِ پزِ مسیحؔ سُنٛد کلام پوٚرٕ پٲٹھؠ نظرِ تل تھاوُن۔ توٚہہِ پزِ صیحیفن منٛز یسوعس متعلق بٲتھ استعمال کرِتھ، بییٚہِ پاک روحن توٚہہِ بٲتھ عطا کٔرمٕتؠ چھِ اکھ أکس سؠٹھاہ دانٲییٔ سان ہیٚچھناوٕنؠ۔ توٚہہِ پزِ شُکر گُذٲری تہٕ خلوصہٕ سان خدایس کُن بٲتھ گیٚوٕنؠ۔
\v 17 ییٚلہِ تہِ زانٛہہ توٚہؠ کینٛہہ ونیو یا کرِو، ہر حالتس منٛز شۅبہِ توٚہہِ تِمن لوٗکن ہندؠ پٲٹھؠ پیش یُن یِم خداوند یسوع سٕنٛز نمایندگی کران چھِ۔ بییٚہِ پزِ توٚہہِ خداے سُنٛد شُکر کرُن، یُس سون ببَ خدا چُھ۔ توٚہؠ ہیکیو صرف یہِ مسیحؔ سنٛزِ کامہِ سببہٕ کرِتھ۔
\v 18 زنانن پزِ خاوند پننہِ گھریُک سربراہ مانُن، چونکہ یہِ چُھ منٲسب سلوک تِمن ہندِ باپتھ یِمن خداین خداوندس سٟتؠ اتحاد کوٚرمُت چُھ۔ \f + \fr 3‏:18 \ft افسینؔ 5:22\f*
\v 19 خاندارن پزِ پنہٕ نین زنانن لول برُن تہٕ تِمن سٟتؠ پزِ نہٕ تلخی سان سلوک کرُن۔
\v 20 شُریٚن پزِ ہر حالتس منٛز پننِس مٲلس ماجہِ ہنٛز فرمانبردٲری کرنؠ۔ یہِ چُھ خدایس خوش یوان بییٚہِ چُھ یہِ تِمن ہندِ خٲطرٕ منٲسب یِمن خداین خداوندس سٟتؠ اتحاد کوٚرمُت چُھ۔
\v 21 مالیٚن پزن نہٕ پننٕؠ شُرؠ ناراض کرنؠ۔ نتہٕ ہیکہِ شُریٚن منٛز ترک کرنُک احساس پٲدٕ سپدِتھ۔
\v 22 غلامن پزِ یتھ دنیاہس اندر پنہٕ نؠن مٲلکن ہنٛد پریتھ کُنہِ حالتس منٛز فرمانبردٲر روزُن۔ تِمن پزِ فرمانبردٲری کرنؠ نہٕ صرف کہ امہِ وزِ ییٚلہِ تِمن پننٕؠ مٲلکھ وُچھان آسان چھِ، یُس زن تِم صرف انسانن خوش کرنہٕ باپتھ ہاوان چھِ۔ تمہِ بجایہ پزِ تِمن پنہٕ نؠن مٲلکن اصل پٲٹھؠ فرمانبردٲری کرنؠ تکیازِ تِم چھِ خداوندس احترام کران۔
\v 23 توٚہہِ پزِ ہر کانٛہہ کٲم دل دِتھ کرنؠ، یتھ زن توٚہؠ خداوند سنٛدِ خٲطرٕ ٲسیٚو کٲم کران نہٕ کہ صرف انسٲنی مٲلکن ہندِ خٲطرٕ۔
\v 24 توٚہہِ پزِ امی طریقہٕ فرمانبردٲری تہٕ خدمت کرنؠ تکیازِ توٚہؠ چھُو زانان زِ خداوند دیہِ توٚہہِ یہِ اصل پٲٹھؠ واپس یہِ تمؠ تُہندِ خٲطرٕ تھومُت چھُ۔ یاد تھٲیو زِ خداوند مسیحؔ چُھ اصلی مٲلکھ یمؠ سنٛدِ خٲطرٕ توٚہؠ کٲم کران چھُو۔
\v 25 توٚہہِ پزِ یاد تھاون زِ کُس چُھ اصلی مٲلکھ تکیازِ خداے دِیہِ تمس بُرٲیی ہند سزا یُس بُرٕ عمل کرِ۔ تکیازِ خداے چُھنہٕ لوٗکن ہندؠ فٲصلہٕ اتھ پیٚٹھ کران زِ سُہ کیُتھ چُھ باسان یا سُہ کُس چُھ بلکہ تِمو کیاہ چُھ کوٚرمُت۔ \f + \fr 3‏:25 \ft عملہٕ 10:34، رومین 2:11\f*
\c 4
\p
\v 1 مٲلکن پزِ پننؠن غلامن سٟتؠ اصل پٲٹھؠ رُت سلوک کرُن۔ تکیازِ توٚہہِ چھُو زانان زِ توٚہؠ تہِ چھُو أکس مٲلکس خدمت کران یُس آسمانس پیٚٹھ چُھ\f + \fr 4‏:1 \ft احبار 25:43، 53\f*۔
\v 2 خدایس روزیو لگاتار دعا منٛگان۔ دِل دِتھ منٛگِو دعا، بییٚہِ کریو خداے سٕنٛز شُکر گذٲری\f + \fr 4‏:2 \ft رومین 12:12، افسینؔ 6:18، فلپین 4:6، 1تھسلونینؔ 5:17\f*۔
\v 3 ییٚلہِ توٚہؠ دعا چھُو منٛگان، سانہِ خٲطرٕ تہِ منٛگِو دعا\f + \fr 4‏:3 \ft 1کورنتھین 16:9، 2کورنتھین 2:12\f*۔ یہِ دعا منٛگِو زِ خداے بناوِ پٲغام پھہلاوُن سانہِ خٲطرٕ آسان، یُس زن مسیحسؔ متعلق راز چُھ یُس أسؠ وونؠ باقین نِشہٕ واتناون چھِ۔ تکیازِ اسہِ کوٚر أمہِ پٲغامُک اعلان، توے چُھس بہٕ ونہِ قٲد خانس منٛز۔
\v 4 دعا منٛگِو یتھ زن بہٕ رٕژ شیچھِ ہنٛز وضاحت صاف پٲٹھؠ کرنس لایق بنہٕ، یمہِ خٲطرٕ خداین مےٚ حکم دِیتمُت چُھ۔
\v 5 تِمن سٟتؠ کرِو گاٹہٕ جارٕ سان برتاو یِمن نہٕ مسیحسؔ پیٚٹھ ایمان چُھ۔ یہِ کرنہٕ خٲطرٕ تُلیو پرٛتھ کُنہِ موقُک فٲیدٕ\f + \fr 4‏:5 \ft 1تھسلونینؔ 4:12\f*۔
\v 6 ییٚلہِ توٚہؠ تِمن سٟتؠ کتھ کرِو، توٚہہِ پزِ ہمیشہِ أکس خوشگوار تہٕ دلچسپ اندازس منٛز کتھ کرِن۔ ییٚلہِ توٚہؠ یہِ کرِو، توٚہؠ دِیو ہر أکس شخصس منٲسب جواب۔
\v 7 تُخِکسؔ ونہِ توٚہہِ سورے زِ مےٚ سٟتؠ کیاہ چُھ سپدان۔ سُہ چُھ اکھ سٲتھی ماتحت یُس مےٚ ٹوٹھ چُھ، سُہ چُھ مےٚ وفادٲری سان مدد کران بییٚہِ چُھ مےٚ سٟتؠ رٔلِتھ اکھ سُہ نفر یمِس خداین خداوندس سٟتؠ اتحاد کوٚرمُت چُھ۔
\v 8 بہٕ چُھس تھیچکسؔ یہِ چٹھؠ ہیٚتھ توٚہہِ کُن سوزان تکیازِ بہٕ چُھس یژھان زانُن زِ توٚہؠ کیاہ چھُو کران چونکہ تھیچکسؔ کرِ توٚہہِ زندگی حوصلہٕ سان گُزارس منٛز مدد۔
\v 9 بہٕ چُھسن سُہ انیسمسسؔ سٟتؠ تۅٚہہِ کُن سوزان، یُس اکھ وفادار ایمان وول چُھ یُس مےٚ ٹوٹھ چُھ۔ سُہ چُھ تُہنٛزی جمٲژ منٛز۔ تھیچکسؔ تہٕ انیسمسؔ ونن توٚہہِ تہِ سورےٕ یہِ مےٚ سٟتؠ ییتہِ پیش یوان چُھ۔
\v 10 ارسترسخُسؔ، یُس مےٚ سٟتؠ قٲدس منٛز چُھ، بییٚہِ مرقُسؔ، یُس برنباسنؔ پِتٕر بوے چُھ چھُو توٚہہِ سلام سوزان۔ توٚہؠ چھُو برونہٛےٕ زانان زِ توٚہہِ پزِ مرقُسسؔ خوش آوے کرنؠ ہرگاہ سُہ توٚہہِ نِشہٕ ووٚت۔
\v 11 یسوع یمِس توٚہؠ یوستُسؔ ناوٕ سٟتؠ زانان چھُو، سُہ تہِ چُھ توٚہہِ سلام سوزان۔ یِم نفر ارِترخسؔ، مرقُسؔ بییٚہِ یوستُسؔ چھےٚ یہُودؠ یِم مےٚ سٟتؠ خداے سنٛزِ بادشٲہی خٲطرٕ مےٚ سٟتؠ کٲم چھِ کران۔ تِمو کٔر مےٚ یتھ کامہِ منٛز حوصلہٕ افزٲئی۔
\v 12 ایپفراسؔ، یُس تُہنٛزی جمٲژ منٛز چُھ تہٕ سُہ چُھ یسوع مسیحسؔ خدمت کران، سُہ تہِ چُھ توٚہہِ سلام سوزان۔ سُہ چُھ اکثر جانفشٲنی سان تُہندِ خٲطرٕ دعا منٛگان۔ سُہ چُھ دعا منٛگان زِ خداے بناوِ توٚہہِ تتھ قٲبل یمہِ خٲطرٕ توٚہہِ خداین ونمُت چھُو بییٚہِ اعتمادٕ سان روزتھ کرِو خداے سٕنٛز مرضی پیٚٹھ عمل۔
\v 13 توٚہؠ چھُو زانان زِ سُہ أمہِ اندازٕ تُہندِ خٲطرٕ دعا منٛگان تکیازِ بہٕ چُھس اتھ ذٲتی طور گواہ۔ بہٕ ونہو توٚہہِ زِ سُہ چُھ تُہندِ خٲطرٕ سخ محنت کران، یِم لوٗکھ لودیہ کہِ شہرس منٛز روزان چھِ، بییٚہِ تِمن لوٗکن ہندِ خٲطرٕ یِم ہیراپلس شہرس منٛز روزان چھِ۔
\v 14 میٚون ٹوٹھ ڈاکٹر لوقاؔ بییٚہِ دیماسؔ چھُو توٚہہِ سلام سوزان۔
\v 15 لودیہ کہِ منٛز روزن والین سٲتھی ایماندارن، نمفاس تہٕ نمفاس گھرس منٛز روزن سٲتھی ایماندارن ہنٛزِ جمٲژ ونیو سٲنؠ سلام۔
\v 16 ییٚلہِ پرن وول نفر یہِ چٹھؠ پرِتھ مۅکلاوِ پتہٕ سوزیو یہِ لودیہ کہِ تاکہ کانٛہہ اکھ ہیٚکہِ یہِ سٲتھی ایماندارن ہنٛزِ جمٲژ منٛز بییہِ تہِ پرٛتھ۔ اکھتُے کرِزو تمہِ چٹھِ ہنٛز تہِ پرژھٕ غٲر یوسہٕ مےٚ لودیہ کہِ کین ایمان والین سوز یتھ زن توٚہؠ ہیکیو یہِ پرٛتھ۔
\v 17 توٚہہِ پزِ ارخپُسؔ ونُن زِ سۅ کٲم ضروری مکمل یِس تمس خداین سپرد کٔرمٕژ چھے ییٚلہِ خداین تمس مسیحسؔ سٟتؠ اتحاد کوٚر۔
\v 18 بہٕ پولُسؔ چُھس توٚہہِ سلام سوزان۔ بہٕ چُھس یِم ٲخری الفاظ کٲتبس اتھِ لیٚکھناونہٕ بجایہ پانہٕ لیٚکھان۔ توٚہہِ پزِ نہٕ مشراون زِ بہٕ چُھس قٲد خانس منٛز۔ بہٕ چُھس دعا منٛگان زِ خداے روزِن توٚہہِ پیٚٹھ مہربان\f + \fr 4‏:18 \ft 1کورنتھین 16:21، غلتین 6:11، 2 تھسلونینؔ 3:17، 4:18\f*۔
