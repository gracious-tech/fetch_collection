\id GAL - DMT Kashmiri
\toc1 گلتی
\mt1 گلتی
\c 1
\p
\v 1 بہٕ پولُسؔ چھُس توٚہہِ یہِ نامہٕ لیٚکھان۔ بہٕ چھُسو توٚہہِ ژٮ۪تس پاوان زِ بہٕ سوزُس خداین پنُن نمایندٕ بنٲوِتھ۔ اوٕ کِنؠ نہ زِ لوٗکن ہنٛزِ أکؠ جمٲژ کوٚرُس بہٕ مقرر، نہ امہِ کِنؠ زِ کٲنٛسہ انسانن سوزُس بہٕ رسول بننہٕ خٲطرٕ بلکہِ کوٚرُس بہٕ یسوع مسیحؔ تہٕ خداین پنٕنؠ ببن مقرر تہٕ سوزُس بہٕ رسول بننہٕ خٲطرٕ آ خداین یعنی ببن یمؠ مسیحؔ بیٚیہِ زنٛدٕ کوٚر مرنہٕ پتہٕ۔
\v 2 تمام ایمان وٲلؠ سٲتھی یِم مےٚ سٟتؠ چھِ یتھ پٲغامس منظوری بخشان یُس بہٕ توٚہہِ سوزان چھُس۔ بہٕ چھُس یہِ نامہٕ سوزان تَتھ سٲرؠ سےٕ مجلسہِ یۅسہٕ گلتیہ کِس صوبس منٛز چھےٚ۔ \f + \fr 1‏:2 \ft یہِ رومکھ صوبہٕ گلیتہِ اوس ایشیاۓ صغیرس منٛز، یُس جدید دورُک ترکی ملک چُھ۔ \f*
\v 3 خدا سون بب تہٕ خداوند یسوع مسیحؔ روزِن توٚہہِ پیٚٹھ لگؠ تھےٕ مہربان امنہٕ سان۔
\v 4 مسیحنؔ کوٚر پنُن پان قربٲنی باپتھ پیش تاکہِ سُہ ہٹاوِ جرُم یُس اسہِ گناہ کرنہٕ کِنؠ چھُ وۅتلیومُت۔ تٔمؠ کوٚر یہِ اوٕ کِنؠ زِ سُہ ہیٚکہِ اسہِ یِم بُرٕ کامہِ نہ کرنس لایق بنٲوِتھ یِم زن تس نہ زانن وٲلؠ کران چھِ۔ تٔمؠ کوٚر یہِ اوٕ کِنؠ زِ سون بب خدا تہِ چھُ یی یژھان۔
\v 5 تکیازِ تہِ چھُ پوٚز۔ ؤلیٚو أسؠ کرو ہمیشہٕ خدایہِ سٕنٛدؠ تعریف تہٕ یی ٲسِن پوٚز۔
\v 6 بہٕ چھُس سٮ۪ٹھا دِل ملول زِ مسیحسؔ پیٚٹھ پژھ کٔرِتھ چھُو توٚہؠ خدایس نِش دور گژھان۔ خداین ژٲرِو توٚہؠ اکہِ تِتھہِ رِشتہٕ باپتھ یمچ بنیاد مسیحؔ سٕنٛز رحم دلی چھےٚ۔ بہٕ چھُس دل ملول زِ توٚہہِ کٔرٕو أکِس بدل شیچھِ پیٚٹھ پژھ یۅسہٕ کٔمؠ سٕنٛدؠ تام کِنؠ پوٚز چھےٚ۔
\v 7 تُہنٛد پٲغام چھُنہٕ کانہٛہ رٕژ خبر یہِ سپُد تہِ چھُ یہِ زِ خبر کٔمؠ تام اوٚن تہُنٛدِس دماغس کھُر۔ تُہنٛد غرض چھُ مسیحسؔ متعلق رٕژ شیٚچھ بدلاوٕنؠ۔ تِم چھِ تھاوان بدل شیٚچھ۔
\v 8 مگر یودوے أسؠ رسول یا آسمٲنؠ فرشتہٕ تہِ تتھ رٕژِ شیٚچھِ یۅسہٕ اسہِ توٚہہِ برونٛہےٕ دِژ، کانہٛہ بدل شیٚچھ ونن۔ بہٕ چھُس خدایس زارٕ پارٕ کران زِ سُہ دِین تس ہمیشہٕ ہمیشہٕ پوشہٕ وُن سزا۔
\v 9 یہِ زن اسہِ توٚہہِ برونٛہےٕ ووٚن۔ بہ چھُسو توٚہہِ بیٚیہِ ونان کُستام چھُو توٚہہِ ونان زِ تسُنٛد ونُن چھےٚ رٕژ شیٚچھ۔ مگر یہِ چھُ تمہِ رٕژِ خبرِ نِشہٕ وُلٹہٕ یۅسہٕ مےٚ توٚہہِ دِژ۔ اوے چھُس بہٕ خدایس منٛگان زِ تمِس نفرس ژٕھنِنِ ابدی لعنت نٲلؠ
\v 10 مےٚ ووٚن یہِ اوٕ کِنؠ زِ بہٕ چھُس نہٕ یژھان زِ مےٚ کرن لوٗکھ تٲیید۔ تٔمہِ بدلہٕ یہِ زن مےٚ متعلق کینٛہہ لوٗکھ ونان چھِ۔ خدا گژھِ مےٚ تٲیید کرُن منظور تھاوُن۔ یی چھُ میون یژھُن۔ خاص پٲٹھؠ بہٕ چھُس نہٕ کینٛہہ ونان یا کران لوٗکھ خوش کرنہٕ باپتھ۔ اگر یہِ وُنتہِ لوٗکھےٕ چھِ یِمن بہٕ خوش کرُن چھُس یژھان تیٚلہِ چھُس نہٕ بہٕ سُہ یُس پننہِ رضامندی کِنؠ حتمی طور بس مسیحسؔ خدمت کران چھُ۔
\v 11 میانیٚو ایماندار سٲتھیو! بہٕ چھُس یژھان زِ توٚہؠ زٲنِو زِ یُس پٲغام بہٕ مسیحسؔ متعلق لوٗکن واتناوان چھُس چھُنہٕ کانہٛہ انسان سُنٛد بنومُت بیان۔
\v 12 مےٚ دیُت نہٕ یہِ پٲغام کٲنٛسہِ انسانن، نہ ہٮ۪چھنووُس بہٕ یہِ کٲنٛسہِ انسانن۔ یہِ اوس خدا یمؠ یسوع مسیحؔ مےٚ پیٚٹھ ظٲہر کوٚر۔
\v 13 لوٗکو چھُو توٚہہِ ووٚنمُت زِ میون وطیرٕ کیا اوس۔ ییٚلہِ بہٕ یہُودؠ اوسُس تِمو ووٚنو توٚہہِ زِ بہٕ اوسُس خدایس پژھ کرن والیٚن جمٲژن لگاتار عِذا واتناوان۔ تِمو ونُو توٚہہِ یِتہِ زِ بہٕ اوسُس تِمن لوٗکن مُلہٕ مۅنٛجہِ گالُن یژھان۔
\v 14 بہٕ اوسُس شدومد تہٕ مکمل پٲٹھؠ مذہب پالن پننٮ۪ن ہم عمرن ہنٛدِ کھۅتہٕ گٔژھؠ تھےٕ یہُودؠ مذہب پالان۔ بہٕ اوسُس بڈٕ جوشہٕ سان پننٮ۪ن بزرگن ہنٛز روایژ باقےٕ لوٗکھ مٲنراوٕنؠ یژھان۔
\v 15 ووٚنؠ گو پننہِ زیٚنہٕ برونہٛےٕ اوسُس بہٕ خداین اکہِ خاص کامہِ باپتھ منتخب کوٚرمُت تہٕ ژورمُت بڈِ مہربٲنی سان۔ ییٚلہِ خداین سونچ زِ یہِ چھُ رُت، \f + \fr 1‏:15 \ft یسعیاہؔ 49:15، یرمیاہ 1:5\f*
\v 16 تٔمؠ ہوو مےٚ زِ کُس چھُ تسُنٛد اصلی گۅبرِس درحقیقت۔ تٔمؠ کوٚر یہِ اوٕ کِنؠ زِ بہٕ واتناوٕ یہِ رٕژ شیٚچھ امسنٛدِس گۅبرِس متعلق باقےٕ عدالتن منٛز غٲر یہودٮ۪ن تام تہِ۔ مگر بہٕ گوس نہٕ ؤلؠ باقےٕ انسانن نِش تاکہِ مےٚ میلہِ وقت یہِ پٲغام پانہٕ تہِ سمجھنُک۔
\v 17 مےٚ تروو نہٕ ؤلؠ ؤلؠ دمشق شہر تہِ یروشلم گژھنہٕ باپتھ تمن یسوع سنٛدین نمایندن کن یِم مےٚ برونہٛہ ٲسؠ بلکہ مےٚ ٲس عرب علاقن کُن أکِس صحرٲیؠ زمینہِ کُن۔ پتہٕ آس بہٕ دُبارٕ دمشق واپس۔
\v 18 پتہٕ تریٚیہِ ؤہرؠ خداین کٔر یہِ رٕژ شیٚچھ مےٚ پیٚٹھ ظٲہِر پتہٕ گوس بہٕ یروشلم شہرس کُن تاکہِ اتہِ ما سمکھہٕ بہٕ پطرسس\f + \fr 1‏:18 \ft پطرس چُھ یونٲنؠ لفظ "سپاس" یمیک منعے چُھ "چٹان"\f* مگر بہٕ رودُس تتہِ تمِس سٟتؠ چھرا پندہن دوٚہن۔
\v 19 مےٚ وُچھ یعقوب تہٕ سٲنِس خداوند یسوع سُنٛد نمایندٕ تہٕ بوے۔ مگر مےٚ وُچھ نہٕ یسوع سنٛدؠ باقےٕ نمایندٕ کینٛہہ۔
\v 20 خدا چھُ زانان زِ یہِ بہٕ توٚہہِ لیٚکھان چھُس تہِ چھُ پوٗرٕ پوٗرٕ درُست۔
\v 21 ییٚلہِ مےٚ یروشلم تروو بہٕ گوس صوریہ تہٕ کلکیہ صوبن منٛز۔
\v 22 أمہِ وقتہٕ اوسُس نہٕ یہُوداؔ کِس صوبس انٛدر مسیحیؔ مجلس منٛز لوٗکو بہٕ وُچھمُت۔
\v 23 تِمو اوس چھرا بوزمُت باقین لوٗکن ہنٛزِ ذکرِ منٛز میون۔ پولُسؔ یُس برونہٛہ کالہِ اسہِ خلاف عِذا واتناون واجنہِ کامہِ اوس کران چھُ ووٚنؠ سُہ پٲغام بوزناوان یتھ پیٚٹھ اسہِ پژھ چھےٚ تہٕ یتھ پٲغامس سُہ کینٛہہ کال برونہٛہ لوٗکن پژھ کرنس تھوٚس اوس انان۔
\v 24 تِم رودؠ لگاتار خدایہِ سٕنٛدؠ تعریف کران تکیازِ تٔمؠ اوس مےٚ منٛز یسوع سٕنٛز پژھ وۅتلٲومٕژ تہٕ بیٚیہِ اوسُس بہٕ ووٚنؠ تس متعلق لوٗکن رٕژ شیٚچھ باوان۔
\c 2
\p
\v 1 ییٚلہِ ژۅداہ ؤری ادا سپٕدؠ بہٕ گوس بیٚیہِ برنباسسؔ سٟتؠ یروشلم۔ اکھتُے تُلم طِطُس تہِ سٟتؠ۔
\v 2 یہِ مےٚ پیٚٹھ خداین ظٲہِر کوٚر تمہِ کِنؠ گوس بہٕ تور اوٕ موجُب نہٕ کینٛہہ زِ کٲنٛسہِ نفرن کیا ووٚنُم تور یِنہٕ باپتھ۔ مےٚ بوو تمہِ رٕژِ شیٚچھِ ہُنٛد مُدعا یمچ بہٕ غٲر یہودٮ۪ن تعلیم دِوان اوسُس۔ مگر مےٚ کٔر الگ پٲٹھؠ تِمن لوٗکن سٟتؠ کتھ یِمن تہنٛدؠ نٔوؠ وۅستاد سٮ۪ٹھا عزت کران چھِ تاکہِ یہِ بہٕ کران چھُس تہٕ کران آس روزِ نہٕ بےٚ کار۔ یہِ سپدِ ہے یودوے لوٗکھ میانہِ شیٚچھہِ یہِ زٲنِتھ نکارن زِ بہٕ چھُس اپُز ہٮ۪چھناوان۔ یہِ سپدِ ہے یودوے یروشلم شہرٕکؠ زِٹھؠ میٲنِس پٲغامس نہنکل دِہن۔
\v 3 بوزوے تہٕ یِمن یونٲنؠ لوٗکن کھوٚت نہٕ طِطُس تہِ ٹارِ یُس وُنہِ ختنہٕ ورٲے اوس تہٕ ووٚنؠ اوسُس ختنہٕ کرُن۔
\v 4 مگر یہِ مسلہٕ ووٚتھ یمہِ کِنؠ تکیازِ کینٛژو کٔر منٛگ زِ طِطُسس گژھِ ختنہٕ کرنہٕ یُن پتہٕ دیُت تِمو اکھتُے بڈٕ کامیٲبی سان یہِ تاثُر زِ تِم چھِ سٲنؠ ایمان بٲجؠ تہٕ پٔز پژھ تھاون والیٚن سٟتؠ سٟتؠ۔ تِم رلییہِ پٔز پژھ تھاون والیٚن سٟتؠ اوٕ کِنؠ زِ تِم ہیٚکن ژرژتھ نکھہٕ روزِتھ أسؠ کران کیا چھِ تکیازِ أسؠ چھِ یہُودؠ قانون تہٕ رسمہٕ رواج ماننہٕ نِشہٕ آزاد اوٕ کِنؠ زِ اسہِ چھُ یسوع مسیحسؔ سٟتؠ نکھہٕ رِشتہٕ۔ تِم لوٗکھ ٲسؠ اسہِ تِمن رواجن ہنٛدؠ غلام بناوٕنؠ یژھان اسہِ یہِ کتھ مانرٲوِتھ زِ أسؠ ہیٚکو نہٕ چھرا مسیحسؔ سےٕ یوت پژھ کٔرِتھ بلکہِ پزِ اسہِ یہُودؠ قانون تہٕ رواج پالٕنؠ۔
\v 5 مگر اسہِ کوٚر نہٕ رژھ تہِ تہِ یہِ تِم اسہِ ختنہٕ کِس بارس منٛز کرناوُن یژھان ٲسؠ۔ مگر اسہِ کوٚر یورٕ دَرٮ۪ر تاکہِ توٚہہِ میلہِ لگاتار فٲیدٕ، پزِ صحیح تہٕ کُنہِ ژٹہٕ واٹہٕ وراے رژِ شیٚچھِ ہُنٛد۔
\v 6 یروشلم شہرٕکؠ زِٹھؠ یِمن تُہنٛدؠ نٔوؠ وۅستاد عزت کران چھِ، چھِنہٕ بالکل تتھ کتھِ کینٛہہ مذید ہُررٲوِتھ ہیٚکان یمچ بہٕ باوتھ کران چھُس۔ تہٕ بہٕ چھُس یِتہِ ونان زِ تِمن کُس تہٕ کیا مقام چھُ تمیُک چھُنہٕ مےٚ کینٛہہ تہِ، توٕ کِنؠ زِ خدا چھُنہٕ تھوٚد مقام والیٚن تہٕ قوت والیٚن باقین پیٚٹھ کانہٛہ ترجیع دِوان۔ \f + \fr 2‏:6 \ft 2کورنتھین 11:5، تثنِیہ شرع 10:17\f*
\v 7 اتھ برعکس میانہِ شیٚچھِ ہُرراون وٲلؠ زِٹھؠ چھِ زانان زِ خداین دِژ مےٚ یہِ رٕژ شیٚچھ یۅسہٕ بہٕ غٲر یہودٮ۪ن واتناوٕ۔ یتھٕ پٲٹھؠ زن خداین پطرسس رٕژ شیٚچھ دِژ تاکہِ سُہ ونہِ یہِ یہودٮ۪ن۔
\v 8 یعنی یتھٕ کِنؠ خداین پطرسس باحکم تہٕ پُرقوت بنوو تاکہِ سُہ بنہِ یسوع سُنٛد نمایندٕ خدایہِ سُنٛد پٲغام یہودٮ۪ن واتناونہٕ باپتھ۔ تٔمؠ کوٚرُس بٕتہِ معتبر تہٕ پُر قوت تاکہِ بٕتہِ بنہٕ یسوع سُنٛد نمایندٕ خدایہِ سُنٛد پٲغام غٲر یہُودین تام واتناونہٕ باپتھ۔
\v 9 کیفسؔ سان تِم زِٹھؠ ٲسؠ زانان زِ خداین اوس مہربٲنی سان مےٚ یہِ خصوصی مِشن دِیُتمُت۔ لہٰذا یعقوب، پیٹر، تہٕ یوحنا، یمن ہنٛد تُہنٛد نو وۅستاد احترام چھُ کران تکیازِ تم چھِ ایمان والیٚن ہنٛدؠ زِٹھؠ، یہٕ ظأہر کرنہٕ خاطرٕ کوٚر اسہِ سٟتؠ اتھہٕ واس زِ تم چھِ اتھ کتھہٕ پیٚٹھ اتفاق کران زِ برنباس تہٕ بہٕ چھِ خداوند سٕنٛز خدمت کران یتھٕ کِنؠ زن تم چھِ، تہٕ یہٕ زِ أسؠ چھِ أمے پٲغامُک تبلیغ کران یمیُک تِم تبلیغ چھِ کران۔ تِمو کوٚر اتھ کتھہِ پیٚٹھ تہِ اتفاق زِ أسؠ چھِ تِم یِمن خدا پنُن پٲغام غٲر یہُودین وننہٕ خٲطرٕہ سوزان چُھ، مگر یہٕ زِ خدا چُھ تمن پنُن پٲغام یہُودین وننہٕ خٲطرٕہ سوزان۔
\v 10 تِمو کوٚر اسہِ صرف زور زِ یروشلمس منٛز روزن وٲلؠ ایمان وٲلؠ سٟتؠ بٲجؠ گژھن غریبن ہُنٛد مدد کرُن وُنہِ تہِ یاد۔ بالکل چُھس بہٕ یہٕ کرنہٕ خاطرٕ بے تاب رودمُت۔
\v 11 مگر پتہٕ گوٚو پطرس\f + \fr 2‏:11 \ft پطرس چُھ یونٲنؠ لفط "سپاس" یمیک مانے چُھ "چٹان"\f* غلط کٲم کرنُک قصوروار۔ یہِ سپُد تمہِ وِزِ ییٚلہِ سُہ انطاکیہؔ شہرس منٛز اسہِ نِش یِوان اوس۔ توَے کوٚر مےٚ تِمن چیزن مُتعلِق سیوٚدُے أمِس مقابلہٕ۔
\v 12 تہِ گوو یہٕ: پطرس اوس تتہِ غٲر یہودی ایمان والیٚن سٟتؠ کھیوان۔ مگر پتہٕ آے کینٛہہ نفر یم یروشلمس منٛز یہُودؠ ایمان والیٚن ہنٛزِ جمٲژ منٛز ٲسؠ یعقوب اوس قیادت کران۔ یمو نفرو ووٚن زِ ایمان والیٚن پزن یہُودؠ قانون برقرار تھاوٕنؠ۔ پطرسس اوس خوف زِ تِم لوٗکھ یم یہُودؠ ایمان والیٚن یہودی قانون برقرار تھاوٕنؠ یژھان چھِ تم کیا ہیکن کرِتھ، تہٕ امہِ موجُب کوٚر تٔمؠ غأر یہُودین نش دستبردار گژھُن تہٕ صرف یہُودؠ ایمان والیٚن سٟتؠ کھیٚون شروع۔ \f + \fr 2‏:12 \ft عملہٕ 10:28، 11:2۔ 3 \f*
\v 13 امہِ مزید، باقیٚو یہُودؠ ایمان والیٚو یم انطاکیاہس منٛز ٲسؠ کٔر یتھٕ پأٹھؠ کٲم یۅسہٕ تم زانان ٲسؠ زِ پطرسس سٟتؠ، ییٚلہِ تِمو پنُن پان غأر یہُودؠ ایمان والیٚن نِش الگ کوٚر۔ نتیجہٕ اوس یہٕ زِ تِم رودؠ برنباس تہٕ غٲر یہُودؠ ایمان والیٚن سٟتؠ وابستگی بند کرنس پیٚٹھ قائل۔
\v 14 مےٚ اوس ژیونمُت زِ تِم ٲسؠ نہٕ واضیح پٲٹھؠ تہٕ تِتھٕ پٲٹھؠ کٲم کران یُس مسیحؔ سنٛزِ رٕژِ شیٚچھِ ہنٛدِس بارس منٛز خوشخبری ہنٛد صحیح حقائق تہٕ تعلیماتن مطٲبق اوس۔ لہٰذا ییٚلہِ تمام ایمان وٲلؠ سٟتؠ بٲجؠ یِکہٕ وٹہٕ آمٕتؠ ٲسؠ، مےٚ ووٚن پطرسس یہٕ "اگرچہِ ژٕ اکھ یہُودؠ چھُکھ، مگر توٚہؠ چھُو اکثر غٲر یہُودین ہنٛدؠ پٲٹھؠ کھیٚن کِس بارس منٛز یہُودؠ قانون نظر انداز کٔرتھ پنُنے ورتاوان۔ ییٚلہِ توٚہؠ غٲر یہُودین منز ٲسِو، توٚہؠ چھُو نہٕ عام پٲٹھؠ پنُن پان یہُودین ہندؠ پٲٹھؠ ورتاوان۔ لہٰذا، چُھ ووٚنؠ یہٕ غلط زِ توٚہؠ چھُو غأر یہُودین یہٕ سوچنُک سبب بنان زِ تمن پزِ تمام یہُودؠ رسمن ہنٛز اطاعت کرٕنؠ!
\v 15 أسؠ زاے یہُودؠ۔ أسؠ زاے نہٕ غٲر یہُودؠ۔ اسہِ یہودیٚو زٲنؠ ہر ہمیشہٕ غٲر یہُودؠ گناہ گار تکیازِ تِم چھِنہٕ یہُودؠ رواج کیو قانون مانان۔
\v 16 مگر ووٚنؠ چھِ أسؠ یہُودؠ ایمان وٲلؠ زانان زِ یہِ چھُنہٕ اوٕ کِنؠ زِ کینٛہہ شخص چھِ تِم چیز مانان یہِ خداین حکم کوٚر شریعتس منٛز یۅسہٕ تٔمؠ یہودٮ۪ن دِژ زِ خدا چھُ کٲنٛسہِ شخصس راستباز بناوان۔ خدا چھُ کٲنٛسہِ شخصس راستباز بناوان صرف اوٕ کِنؠ اگر سُہ شخص یسوع مسیحس پٮ۪ٹھ بھروسہٕ چھُ کران۔ اسؠ یہُودؠ تہِ چھِ یسوع مسیحسؔ پٮ۪ٹھ بھروسہٕ کران۔ اسہِ کوٚر تہِ تاکہِ خدا زانہِ اسہِ صحیح، تکیازِ اسہِ کوٚر مسیحسؔ پٮ۪ٹھ بھروسہٕ۔ \f + \fr 2‏:16 \ft رومین 3:20۔ 22، فلپین 3:9\f*
\v 17 خدا چھُ کٲنٛسہِ راستباز بناوان ییٚلہِ سُہ یسوع مسیحسؔ پیٚٹھ پژھ تھاوِ۔ اوے چھُ اسہِ یہودیٚو تہِ یسوع مسیٮعس پیٚٹھےٕ پژھ قٲیِم کٔرمٕژ۔ اسہِ کوٚر یہِ تاکہِ خدا کرِ پننہِ نظرِ منٛز سانہِ پٲکی تہِ صحیح آسنُک اظہار تکیازِ اسہِ کٔر پژھ مسیحسؔ پیٚٹھ نہ کہ أسؠ چھِ تِمن قانونن پیٚٹھ واتنٕچ کوشش کران یِم خداین موسیٰ ہس دِتؠ۔ امیُک ہرتر دراو یہِ زِ أسؠ تہِ چھِ غٲر یہودٮ۪ن ہنٛدؠ پٲٹھؠ یِمن أسؠ گناہ گار ونان چھِ تِمن قانون تہٕ رواجن نکار کران یِم خداین موسیٰ ہس دِتؠ مگر أسؠ کڈَو نہٕ یقیناً امیُک یہِ مطلب زِ أسؠ بنٲوؠ مسیحنؔ گناہ گار۔ بالکل نہٕ۔ مسیحؔ چھُنہٕ کٲنٛسہِ تہِ گناہ گار بناوان۔
\v 18 یودوے مےٚ بیٚیہِ تہِ یہِ پژھ تھٲو زِ خدا تھاوِ مےٚ پرہیز گار تِمن قانونن شریعتس ماننٕکؠ یِم موسیٰ ہس دِتؠ، بہٕ چھُس تیٚلہِ تس انسانس ہیٚوٗ یُس سۅے عمارت بیٚیہِ کھالنہِ لگان چھُ یۅسہٕ تٔمؠ پانے وٲجمٕژ ٲس۔ اگر بتہِ کرٕ تیٚلہِ چھُس پانے پننہِ غلط کار آسنُک اظہار کران۔
\v 19 مےٚ ژیون زِ خدا گنٛزراونہٕ مےٚ پتہٕ راستباز تکیازِ مےٚ مٲنؠ تِم قانون یِم تٔمؠ موسیٰ ہس دِتؠ۔ اوے کوٚر مےٚ فٲصلہٕ تِمن قانونن ہنٛز نہن کل دِنٕچ یتھٕ پٲٹھؠ زن اکھ زوٚر کُنہِ تہِ آوازِ نہ بوزُن کران چھِ۔ مےٚ کوٚر فٲصلہٕ یہِ کرنُک تاکہِ بہٕ گُذارٕ زندگی صرف خدایہِ سنٛزِ خدمژ منٛز۔ یہِ گو زنٛتہٕ بہٕ تٔمہِ وِزِ مسیحسؔ سٟتؠ اوسُس ییٚلہِ سُہ دارس پیٚٹھ مورُکھ۔
\v 20 میٲنؠ پرٲنؠ زندگی مۅکلییہِ تمی وِزِ ییٚلہِ مےٚ مسیحسؔ پیٚٹھ پژھ قٲیِم کرٕنؠ ہیٚژ۔ ووٚنؠ چھنہٕ کُنہِ لوٗکھ تہِ تہِ کران یہِ بہٕ کران اوسُس۔ مسیحسؔ پیٚٹھ پژھ کرنہٕ برونہٛہ۔ ووٚنؠ چھُ مسیحؔ مےٚ ہاوان بہٕ کِتھہٕ کرٕ عمل۔ تہٕ یہِ بہٕ ووٚنؠ کران چھُس یتھ زمینی زندگی منٛز تہِ چھُس بہٕ کران خدایہِ سٕنٛدِس نیٚچوِس پیٚٹھ پژھ تھٲوِتھ۔ سُہ چھُ بس یُس مےٚ لول بران چھُ تہٕ یمؠ میانہِ بدلہٕ پنُن پان قۅربٲنی باپتھ پیش کوٚر۔
\v 21 بہٕ چُھس نہٕ فضول زٲنِتھ نکار کران۔ یس خداین مےٚ سٟتؠ پننہِ مہربٲنی کوٚر۔ یہِ زن میٲنؠ مخٲلف کران چھِ۔ یودوے خدا لوٗکن پرہیز گار مانان چھُ تکیازِ تِم چھِ تِم قانون مانان یِم خداین موسیٰؔ ہس دِتؠ۔ تیٚلہِ گو مسیح یمہِ عالمہٕ بلی۔
\c 3
\p
\v 1 اے! گلاتینس منٛز روزن والیٚو میانیٚو پژھ باجیٚو توٚہؠ چھُو دماغ ورٲے عمل کران۔   ضرور آسیٚو کٲنٛسہِ جود کوٚرمُت۔   مےٚ ہَے توٚہہِ صاف صاف فکرِ تورُو زِ یسوع مسیحنؔ کیا پروو ییٚلہِ سُہ صلیبس پیٚٹھ مود۔  
\v 2 اوے تہِ یژھٕ بہٕ توٚہہِ یہِ اکھ کتھ ونٕنؠ۔   خداین بخُش نہٕ توٚہہِ یہِ پاک روح اوٕ کِنؠ زِ توٚہؠ چھُو موسیٰ سُنٛد سُہ شریعت مانان یُس تمِس دنہٕ آو۔   یقیناً پزِ توٚہہِ زانُن زِ تٔمؠ بخُش توٚہہِ پاک روح اوٕ کِنؠ زِ توٚہؠ یُتھےٕ رٕژ شیٚچھ بوزِو توٚہؠ کٔرِو مسیحسؔ پیٚٹھ پژھ۔  \f + \fr 3‏:2 \ft غلتین 3:5،  عملہٕ 15:8۔  10\f*
\v 3 توٚہؠ چھُو بالکل عقلہِ ورٲے کران عمل۔   توٚہؠ بٔنِو گۅڈٕ عیسٲیی تکیازِ خدایہِ سٕنٛدؠ بخشمٕتؠ روحن بنٲیو توٚہؠ اتھ قٲبل۔   اوے پزِ نہٕ توٚہہِ ووٚنؠ یہِ سونٛچُن زِ موسیٰ ہس دِنہٕ آمتٮ۪ن قانونن پیٚٹھ عمل کٔرِتھ کیا روزِو روحٲنی ترقی پراوان۔  
\v 4 یہِ کتھ تھٲیو دماغس منٛز زِ اگر خداین یہِ تُہنٛدِ باپتھ کوٚر تہِ کوٚرُن اوٕ کِنؠ زِ توٚہؠ مٲنِو شریعت یُس خداین موسیٰ ہس بخش تہٕ مسیحسؔ پیٚٹھ پژھ قٲیِم کرنہٕ کِنؠ تیٚلہِ تلُو توٚہہِ بٔلؠ یوٗت تکلیف۔   مےٚ چھُ پوٗرٕ یقین زِ توٚہہِ تلُو نہٕ یہِ عِذا بٔلؠ۔  
\v 5 اوے تہِ ییٚلہِ توٚہہِ خدا یتھٕ پٲٹھؠ کھُلہٕ دِلہٕ پنُن روح بخشان چھُ تہٕ تہنٛدِ باپتھ بجہِ بجہِ کامہِ أنٛزراوان چُھ،  چھُنہٕ اوٕ کِنؠ زِ توٚہؠ چھُو موسیٰ ہس دِنہٕ آمٕتؠ قانون مانان۔   یقیناً چھُو توٚہؠ پانہٕ زانان زِ ییٚلہِ توٚہؠ رٕژ شیٚچھ بوزِو مسیحسؔ متعلق توٚہؠ کٔرِو اتھ پژھ۔  
\v 6 یمیُک توٚہہِ پانس تہِ تجربہٕ چھُ یتھٕ پٲٹھؠ زن موسیٰ ہن پننٮ۪ن مذہبی صحیفن منٛز لیٚوکھ ابرہامس متعلق تٔمؠ لیٚوکھ ابرہامس ٲس اتھ کتھِ پیٚٹھ پژھ تہٕ امیُک پھل دراو زِ خداین زون ابرہام راستباز۔  \f + \fr 3‏:6 \ft پیدٲیش 15:6\f*
\v 7 توٚہہِ پزِ ژٮ۪ترُن زِ یہ چھُ صرف تم یم مسیحؔ سٕنٛدِس کرنس پیٚٹھ پژھ چھِ کران۔   تِمے چھِ ابرہام سٕنٛدؠ زُرؠ تکیازِ ابرہام سٕنٛدؠ پٲٹھؠ خدایس پیٚٹھ پژھ تھاوان۔  
\v 8 امہِ مزید اوس خداین گۅڈے یہِ سونچمُت زِ یُتھےٕ غٲر یہُودؠ تس پیٚٹھ پژھ قٲیِم کرن سُہ زانہِ تِمن راستباز۔   موسیٰؔ ہن لیٚوکھ پننِس صحیفس منٛز یہِ رُت پٲغام زِ خداین ووٚن ابرہامس،  "چانہِ کِنؠ دِمہٕ بہٕ تمام قومن برکت"\f + \fr 3‏:8 \ft پیدٲیش 12:3،  18:18\f*
\v 9 اوے ہیٚکو أسؠ یہِ اخز کٔرِتھ زِ یِم لوٗکھ چھِ تِمے یِمو پژھ کٔر مسیحؔ سٕنٛدِس کرنس پیٚٹھ یمِس فضل کوٚر خداین ابراہامؔ سنٛدؠ پٲٹھؠ یمؠ برونہٛہ کالہِ تس پیٚٹھ پژھ کٔر۔  
\v 10 یعنی خدا دِیہِ تِمن ہمیشہٕ باپتھ سزا یِم غلط فہمی کِنؠ سونٛچن زِ تتھ شریعتس پیٚٹھ یُس خداین موسیٰ ہس دیُت عمل کرنہٕ سٟتؠ کیاہ مانہِ تِمن راستباز۔   موسیٰ ہن یہِ صحیفن منٛز لیٚوکھ چھُ یہِ زِ خدا دِیہِ تِمن لوٗکن ہمیشہٕ پوشہٕ وُن سزا یِم لٔگؠ تھےٕ تہٕ مکمل پٲٹھؠ خدایہِ سنٛدین سارنےٕ قانونن پیٚٹھ عمل کرن نہٕ یمؠ شریعتس منٛز لیٚکھنُک خداین تس ہدایت دیُت۔  \f + \fr 3‏:10 \ft تثنِیہ شرع 27:26،  یعقوب2:20، 12\f*
\v 11 خدا چھُنہٕ کٲنٛسہِ نفرس راستباز مانان موسیٰ سنٛزِ کتابہِ پیٚٹھ پژھ تھاونچ کوشش کرنہٕ سٟتؠ۔   یہِ چھُ صاف ظٲہِر توٕکِنؠ زِ صحیفن منٛز چھُ آمُت،  "پرٛتھ کانہٛہ چھُ روزان راستباز خدایس پیٚٹھ پننہِ پژھِ کِنؠ۔  \f + \fr 3‏:11 \ft حبقوقؔ2:4\f*
\v 12 مگر ییٚلہِ خداین یہودٮ۪ن کتاب بخشؠ تٔمؠ بنٲوؠ نہٕ تِم پانس پیٚٹھ پژھ تھاون وٲلِس کٲنٛسہِ شخصس ماتحت۔   اتھ برعکس ووٚن خداین یہ چھِ چھرا تِم یِم خدا سنٛدین سارنےٕ کتابن قانونن ہیٚتھےٕ مانن تہٕ مکمل پٲٹھؠ تس مٲنِتھ زُوان روزن۔  \f + \fr 3‏:12 \ft احبار18:5\f*
\v 13 یودوے زن اسہِ انسانو خدایہِ سٕنٛدؠ قانون مُتوٲتِر تہٕ مکمل پٲٹھؠ پوٗرِ پوٗر مانہِ نہ مسیحنؔ بخش اسہِ نجات خدایہِ سٕنٛدِ پوشہٕ وٕنہِ عزابہٕ نِشہٕ مسیحنؔ دیُت اسہِ نجات پانہٕ خدا سُنٛد سزا قبول کٔرِتھ أمہِ بدلہٕ زِ خدا دِیہِ ہے اسہِ سزا۔   یہِ موسیٰ ہن پننٮ۪ن صحیفن منٛز لیٚوکھ چھُ ہاوان زِ یی چھُ پوٚز۔   خدا چھُ تس پرٛتھ نفرس بد دعا دِوان یَس لوٗکھ صلیبس پٮ۪ٹھ مارن پننہِ کُنہِ اترِ باپتھ۔  \f + \fr 3‏:13 \ft تثنِیہ شرع21:23\f*
\v 14 مسیحنؔ بخُش اسہِ نجات پننہِ تہِ کرنہٕ سٟتؠ یہِ تٔمؠ سانہِ باپتھ کوٚر۔   خدایس تہِ چھُ غٲر یہودٮ۪ن فضل کرُن یتھٕ پٲٹھؠ خداین ابرہامس فضل کوٚر امیُک وجہہ چھُ یہِ۔   مسیحسؔ پیٚٹھ سانہِ پژھ کرنہٕ سٟتؠ ما کرو أسؠ سٲری پاک روح حٲصل یہِ دنُک اسہِ خداین وعدٕ چھُ دیُتمُت۔  
\p
\v 15 میانیٚو ایماندار سٲتھیٚو! ووٚنؠ کرٕ بہٕ أمِچ وضاحت انسٲنی رشتن ہنٛدِس حوالس منٛز۔   ییٚلہِ زٕ نفر پانہٕ وٲنؠ کانہٛہ مہادٕ کرن۔   کانہٛہ تہِ ہیٚکہِ اتھ نکار کٔرِتھ یا ہُرٮ۪ر کٔرِتھ۔  
\v 16 خداین ووٚن ابرہامس تہٕ تسنٛدِس زُرِس زِ سُہ چھُ وعدٕ کران ابرہامس فضل کرنُک۔   خداین یہِ ووٚن تتھ منٛز اوسنہٕ "تہٕ چانہِ قبیلچہِ زُریٲژ" سُہ اوسنہٕ واریاہن لوٗکن متعلق کتھ کان۔   بلکہِ اوس سُہ اکِس خاص انسانس متعلق ونان۔   یُس مسیحؔ چھُ۔   توٕکِنؠ زِ یِم لفظ تٔمؠ ؤنؠ ٲسؠ "تہٕ چٲنِس زُرِس"\f + \fr 3‏:16 \ft متی1:1\f*
\p
\v 17 یی تہِ چھُس بہٕ ونان،  "خداین کوٚر اکھ مہادٕ ابرہامس سٟتؠ زِ یِم قانون تٔمؠ یہودٮ۪ن 430 ؤری گژھِتھ دِژ ہیٚکہِ نہٕ رد کٔرِتھ تتھ وعدس۔  \f + \fr 3‏:17 \ft خروج12:40\f*
\v 18 بہٕ چھُس یژھان زِ توٚہؠ زٲنِو زِ اگر یہِ اوٕ کِنؠ چھُ زِ أسؠ چھِ مانان قانون یِم خداین یہودٮ۪ن دِتؠ تہٕ تمہِ کِنؠ دِتِن اسہِ تہِ یہِ وعدٕ کوٚرمُت چھُن اسہِ سٟتؠ۔   تیٚلہِ دیُت نہٕ تٔمؠ اسہِ تہِ یہِ وعدٕ چھُن کوٚرمُت۔   ووٚنؠ گو خداین دیُت پننہِ مہربٲنیہِ تہٕ یہِ تٔمؠ ابرہامس سٟتؠ وعدٕ کوٚر تکیازِ خداین اوس تس سٟتؠ وعدٕ کوٚرمُت۔   یِتھے پٲٹھؠ چھُنہٕ یہِ اوٕ کِنؠ زِ اسہِ مٲنؠ خدایہِ سٕنٛدؠ دِتمٕتؠ قانون زِ خداین دیُت پننہِ فٲصلہٕ سٟتؠ اسہِ تہِ یہِ وعدٕ کوٚرُن۔  
\p
\v 19 اوے تہِ یودوے کانہٛہ پرژِھ،  "خدا کیازِ چھُ پتہٕ پہن قانون موسیٰ ہس دِوان۔   بہٕ ونس یورٕ،  "زِ یہِ اوس اوٕ کِنؠ زِ لوٗکھ ژٮ۪ترٮ۪ن زِ تِم کٲتیاہ گناہ گار ٲسؠ۔   تِم قانون ٲسؠ درُست یوٚتام یسوع آو۔   سُہ زُر یمہِ سُنٛد حوالہٕ خداین دیُت ییٚلہِ تٔمؠ ابرہامس سٟتؠ مہادٕ کوٚر۔   خداین دِتؠ پنٕنؠ قانون موسیٰ ہس تمس فرشتس اتھہٕ واتنٲوِتھ۔   موسیٰؔ اوس منٛزِمیور،  سُہ یمؠ قانون لوٗکن تام واتنٲوؠ۔  
\v 20 ووٚنؠ،  ییٚلہِ زن اکھ منٛزِمیور کٲم کرِ اکھ دوٚر چھُنہٕ بیٚیِس دٔرِس سٟتؠ سیٚدِ سیٚود کتھ کران،  مگر خداین کوٚر پانہٕ سیٚدِ سیٚود وعدٕ ابرہامس سٟتؠ۔  
\v 21 یودوے کانہٛہ پرژھِ ییٚلہِ خداین موسیٰ ہس قانون دِتؠ،  تمہِ پتہٕ واریاہہِ کٲلؠ ییٚلہِ تٔمؠ ابرہامس ووٚن زِ سُہ چھُ تس دِنُک وعدٕ کران۔   سُہ اوس پننہِ کتھہِ نِش پھِران۔   تس آو بدل سونچ۔   بہٕ ونہٕ خداین بدلوو نہٕ پنُن سونچ ییٚلہِ تٔمؠ یہِ کوٚر۔   یودوے خداین تیوٚتھ قانون آسہِ ہے دیُتمُت یُس لوٗکن ابدی زندگی لسنس قٲبل بناوِ ہے۔   ابدی تہٕ روحٲنی طور تیٚلہِ آسہِ ہے یہِ یقیناً ممکن اتھ قانونس پیٚٹھ عمل کرنہٕ سٟتؠ یمہِ سٟتؠ خدا لوٗکن راستباز مانہِ ہے۔  
\v 22 مگر ژکہِ چھُ یہِ ناممکن زِ قانون بنٲوؠ انسانن ابدی تہٕ روحٲنی طور لسنس لایق۔   اتھ برعکس صحیفن منٛز درج قانونو پھسٲوؠ لوٗکھ سزہن منٛز پننیٚو گناہو باپتھ۔   یتھٕ پٲٹھؠ بٲنٛدؠ وانہٕ منٛزٕ لوٗکھ ژٔلِتھ ہیٚکان چھِنہٕ خداین کوٚر یی تاکہِ سُہ دیہِ یسوع مسیحسؔ پیٚٹھ پژھ تھاون والیٚن تہِ یمیُک تٔمؠ تِمن وعدٕ کوٚرمُت چھُ تکیازِ تِم چھِ تس پیٚٹھ پژھ کران۔  
\v 23 أمہِ برونہٛہ زِ خدا کرِ اظہار مسیحسؔ پیٚٹھ پژھ تھاونچہِ رٕژِ شیٚچھِ ہُنٛد۔   خدایہِ سنٛدِ طرفہٕ موسیٰ ہس میلن وٲلؠ قانون ٲسؠ اسہِ گٔنٛڈِتھ تھاوان۔   یتھٕ پٲٹھؠ اکھ بٲنٛدؠ وانس منٛز آسان چھِ۔   یہِ سپدِ توٚت تام زِ اسہِ کر مٲنؠ مسیحسؔ متعلق رٕژ شیٚچھ۔   سۅ رٕژ شیٚچھ ییٚلہِ خدا اوس ظٲہر کرنس تیار تہٕ ووٚنؠ کرِنؠ اظہار
\v 24 یتھٕ پٲٹھؠ اکھ مول پننس نابالغ شُرِس نگرٲنی کران چھُ بچہٕ سُنٛد خیال تھاونہٕ باپتھ تسٕنٛدِ باپتھ اکھ نوکر مقرر کٔرِتھ۔   خدا اوس یِمو قانون سٟتؠ سٲنؠ نگرٲنی کران یوٚت تام مسیحؔ آو۔   تٔمؠ کوٚر یہ تاکہِ سُہ کرِ پننہِ نظرِ منٛز سانہِ راستباز آسنُک اعلان۔   چھرا اوٕ کِنؠ زِ أسؠ چھِ،  مسیحس پیٚٹھ پژھ کران۔  
\v 25 مگر ووٚنؠ ییٚلہِ زن خداین مسیحسؔ پیٚٹھ پژھ تھاونُک پنُن پٲغام ظٲہِر کوٚر۔   خدایہِ سٕنٛدؠ طرفہٕ موسیٰ ہس میلؠ مٕتؠ قانون چھِنہٕ اسہِ نگرٲنی کران۔  
\v 26 ووٚنؠ توٚہؠ سٲری یہُودؠ تہٕ غٲر یہُودؠ چھُو زنتہٕ توٚہؠ خدایہِ سٕنٛدؠ شُرؠ تکیازِ توٚہؠ چھُو یسوع مسیحسؔ پیٚٹھ پژھ کران۔  \f + \fr 3‏:26 \ft یوحناؔ 1:12\f*
\v 27 توٚہؠ چھُو ووٚنؠ سٮ۪ٹھا چیٚرٕ روحٲنی یکتِس منٛز مسیحسؔ سٟتؠ۔   ییٚلہِ زن توٚہؠ بپتسمہ دِنہٕ آوُو،  توٚہؠ اوو ہِشراونہٕ مسیحسؔ سٟتؠ۔  
\v 28 اگر توٚہؠ مسیحسؔ مانان چھُو خدایس نِش چھنہٕ اتھ کانہٛہ قدر زِ توٚہؠ چھُو یہُودؠ کنہٕ غٲر یہُودؠ،  غلام کنہٕ آزاد،  مرد کِنہٕ زنہِ تکیازِ توٚہؠ سٲری چھُو ہِوِی،  یسوع مسیحسؔ سٟتؠ پننہِ رِشتہٕ سٟتؠ۔  
\v 29 أمہِ مزید،  چونکہِ توٚہؠ چھُو مسیح سٕنٛدؠ،  توٚہؠ چھُو زنتہٕ ابرہام سٕنٛدؠ زُرؠ۔   تکیازِ توٚہؠ چُھو خدایس مٹہ یتھٕ پٲٹھؠ ابرہامس نِش أسؠ تہٕ توٚہؠ تہِ کٔریٚو حٲصِل یہِ تٔمؠ ابرہامس وعدٕ کوٚرمُت اوس۔
\c 4
\p
\v 1 ووٚنؠ کرٕ بہٕ کتھ شُریٚن تہٕ وٲرثن متعلق۔ وٲرِث گو سُہ یُس پتہٕ مٲلؠ سنٛز وراثت رٹہ تہٕ سمبالہِ۔ ووٚنؠ گو ییتِس کالس یہِ وٲرِث شُر روزِ باقےٕ چھِ أمِس سمبالان روزان۔ أمیُک مطلب چھُ یہِ زِ یہِ چھُ غلام ہیو آسان۔ حالانکہِ سُہ چھُ سارنےٕ ہُنٛد آقا۔
\v 2 ییتِس کالس امسنٛدؠ مٲلؠ یہِ مقرر کوٚرمُت آسہِ، سُہ بیاکھ نفر روزِ أمِس شُرِس تہٕ امسنٛدِ وراثتس رٲچھ راوٹ کران۔
\v 3 یِتھے پٲٹھؠ ییٚلہِ أسؠ روحٲنی طور آچھرؠ آسو اوٕ کِنؠ زِ اسہِ چھنہٕ وُنہِ مسیحسؔ پیٚٹھ پژھ قٲیِم کٔرمٕژ، أسؠ چھِ تِمن قانونن تحت روزان یِمن تل باقےٕ دُنیہکؠ لوٗکھ تہِ روزان چھِ۔ یِم نفر چھِ اسہِ پننس حکمس تل رٹان۔ یتھٕ پٲٹھؠ زن اکھ آغہٕ پننیٚن غلامن رٹان چُھ۔
\v 4 مگر تتھ وقتس پیٚٹھ یُس خداین برونہٛےٕ مقرر کوٚرمُت اوس سوز تٔمؠ یتھ دُنیہس منٛز پنُن نیٚچو یسوعؔ۔ یسوعؔ زاو انسٲنی ماجہِ تہٕ تس پییہِ تِم قانون پالٕنؠ یِم خداین موسیٰ ہس بخٕش۔
\v 5 خداین سوز یسوع تِم قانون نہ پالنکہِ سزا نِشہٕ اسہِ نجات دِنہٕ باپتھ یِم قانون تٔمؠ موسیٰ ہس دِتؠ۔ خداین کوٚر یہِ اوٕ کِنؠ یُتھ اسہِ تہِ تسٕنٛدؠ شُرؠ آسنُک مقام میلہِ۔
\v 6 أمہِ ہُریمانہٕ سوز خداین اسہِ پیٚٹھ پاک روح یُس اسہِ انٛدرٕ وجودس منٛز آسہِ تکیازِ اسہِ چھُ ووٚنؠ خدایس سٟتؠ تیوٗت نکھہٕ تعلُق زنتہٕ أسؠ تسٕنٛدؠ گوبر چھِ۔ یہِ چھُ یوٚہے تسُنٛد روح یُس اسہِ ہکہٕ ونناوان چھُ خدایس میانہِ ببا! ہے ببا!
\v 7 اوے تہِ کوٚڑ یہِ خداین۔ توٚہہ منٛزٕ چھُنہٕ کانہٛہ تہِ غلام، بلکہِ چھُ توٚہہِ منٛزٕ پرٛتھ کانہٛہ زنتہٕ خدایہِ سُنٛد نیٚچو۔ خداین بنوو توٚہہِ منٛزٕ پرٛتھ کانہٛہ پنُن وٲرث یمِس سُہ پرٛتھ کینٛہہ دیہِ یہِ تٔمؠ وعدٕ دیُتمُت چھُ۔
\v 8 ییٚلہِ توٚہہِ خدایس سٟتؠ رشتے آسہِ نہٕ تیٚلہِ کٔرِو توٚہؠ تِمن خداین ہنٛز عبادت یِمنہٕ وجودسےٕ چھِ\f + \fr 4‏:8 \ft یسعیاہؔ 37:19، یرمیاہ 2:11\f*۔ توٚہؠ ٲسِو تمہِ وِزِ غلام ہیوؠ تکیازِ توٚہؠ ٲسِو روحٲنی طور گٔنٛڈِتھ۔ ووٚنؠ چھو توٚہہِ خدایہِ سٕنٛز پٲرؠ زان حٲصل۔
\v 9 مگر ووٚنؠ چھُو توٚہؠ خدایس نزدیک پٲٹھؠ زانان۔ شاید روزِ بہتر یہِ ونُن زِ ووٚنؠ زٲنیٚو توٚہہِ سارِنےٕ خدا سٮ۪ٹھا بٲریکی سان۔ لہٰذا چھُو توٚہؠ ووٚنؠ احمقٲزی کران۔ توٚہؠ چھُو بیٚیہِ تہِ یہِ پژھ تھاوان زِ یِمن قانونن تہٕ رواجن پالنہٕ سٟتؠ واتہِ توٚہہِ روحٲنی فٲض۔ تِم قانون چھِ بے اثر تہٕ ناکٲفی۔ توٚہؠ چھُو یژھان تِمن قانونن ہنٛز پٲروی کرٕنؠ کٲنٛسہِ آغہٕ سنٛدین غلامن ہنٛدؠ پٲٹھؠ۔
\v 10 توٚہؠ غٲر یہُودؠ چھُو بڈٕ احتیاطہٕ سان یہُودؠ قانونن تہٕ رسمن ہنٛز مشق کران زِ آیا یِم یہُودؠ خاص دوٚہہ کتھ مناوو خاص رٮ۪تن منٛز خاص موسمن تہٕ وری کِس خاص وقتس پیٚٹھ۔
\v 11 بہٕ چھُس تہنٛدٮ۪ن غلط خیالن پیٚٹھ سخ پریشان۔ کاش مےٚ آسہِ ہے نہٕ ییٖژِ مشقتہٕ سان بٔلؠ تہنٛز خدمت کٔرمٕژ۔
\v 12 میانیٚو ایماندار سٲتھیو! بہٕ چھُسو توٚہہِ زور دِتھ توٚہہِ اُکساوان تہِ کرنہٕ باپتھ یہِ بہٕ کران چھُس۔ ترٲیِو یہِ خیال زِ توٚہؠ چھُو یہُودؠ اصول تہٕ رسمی قانون پالٕنؠ یِم موسیٰ سٕنٛدؠ تجویز کرنہٕ آمٕتؠ قانون چھِ ییٚلہِ بہٕ توٚہہِ سٟتؠ اوسُس بہٕ اوسُس تہٕ پالان یِم سٲری یہُودؠ اصول تہٕ رسمی قانون یتھٕ پٲٹھؠ زن توٚہؠ تہِ چھُو نہٕ پالان۔ تٔمہِ وقتہٕ ٲسِو توٚہؠ پزنہٕ پٲٹھؠ مےٚ نفرت کران۔
\v 13 توٚہؠ تھٲیِو یِمہٕ کتھہٕ ژٮ۪تس زِ مےٚ ونہِ توٚہِ گۅڈے رٕژٕ شٮ۪چھہٕ تکیازِ بہٕ اوسُس جسمٲنی طور لیٚوژ تہٕ اوسُس وۅنؠ بلُن ہیٚوان امے موقعہٕ کِنؠ یُس مےٚ پننہِ بٮ۪مارِ دیُت گوس بہٕ یتھ لایق زِ بہٕ ونہٕ توٚہہِ رٕژ شیٚچھ۔
\v 14 یودوے زن مےٚ کُن تُہنٛد سلوک حقارتہٕ بوٚرُت تہِ ہیٚکہِ ہے ٲسِتھ میانہِ جسمٲنؠ مینٛدؠ لد آسنہٕ کِنؠ مگر تُہنٛد سلوک اوسنہٕ حقارتہٕ بوٚرُت۔ نہ منسووُس بہٕ توٚہہِ۔ اتھ برعکس کٔرٕو توٚہہِ مےٚ خوش آوے یتھٕ پٲٹھؠ زن توٚہؠ کٲنٛسہِ خدایہِ سٕنٛدِ طرفہٕ آمتس فرشتس کرؠ ہو۔ توٚہہِ کٔرٕو مےٚ خوش آوے یتھٕ پٲٹھؠ زن توٚہہِ پانہٕ یسوع مسیحسؔ کٔرٕو۔
\v 15 مےٚ چھُ دِل تنگ گوٚمُت زِ توٚہہِ مشرووُو زِ تیٚلہِ ٲسِو توٚہؠ مےٚ پیٚٹھ خوش۔ مےٚ چھُ پوٗرٕ یقین زِ توٚہؠ کٔرِو مےٚ مدد کرنہٕ باپتھ کینٛہہ تہِ۔
\v 16 اوے چھُس بہٕ نا امید زِ توٚہؠ چھُو ووٚنؠ یتھٕ پٲٹھؠ عمل کران زنتہٕ بہٕ توٚہہِ خلاف چھُس گوٚمُت تکیازِ بہٕ رودُس لگاتار مسیحسؔ متعلق توٚہہِ پوٚز پٲغام ونان۔ \f + \fr 4‏:16 \ft عاموس 5:10\f*
\v 17 تِمن یِم زن زور دِوان چھِ یہُودؠ قانونن ہنٛز پیروی کرنہٕ باپتھ چھےٚ توٚہہِ سٟتؠ لاگے۔ مگر تِمن چھنہٕ یہِ لاگے کُنہِ رٕتہِ غرضہٕ توٚہہِ سٟتؠ۔ تِم چھِ اوٕ کِنؠ یہِ کران تاکہِ توٚہؠ رٔلِو نہٕ مےٚ سٟتؠ یا تِمن باقین سٟتؠ یِم مسیحسؔ متعلق پزر چھِ ہٮ۪چھناوان۔ تِمن چھُ غرض زِ اسہِ سٟتؠ میلنہٕ بدلہٕ روزِو توٚہؠ تِمن ستؠ لاگیہِ ہُنٛد شوق۔
\v 18 مگر ہر وِزِ رٕژِ کامہِ ہنٛز لادنے چھُ اکھ عزت۔ بہٕ چھُس یژھان زِ توٚہہِ تہِ روزِ صحیح کٲم کرنٕچ لادنے میانہِ موجوگی منٛز تہِ تہٕ غٲر موجودگی منٛز تہِ۔
\v 19 توٚہؠ چھُو برابر میانٮ۪ن گۅبرن ہنٛدؠ پٲٹھؠ۔ مےٚ چھےٚ گۅڈے تُہنٛز فِکر تہٕ مےٚ روزٕ ہر وِزِ تُہنٛز فِکر یوٚتام توٚہؠ پننس سونچس منٛز تہِ کرنس کراونس منٛز مسیحسؔ ہیٚوؠ بٔنیِو۔
\v 20 مگر بہٕ چھُس یژھان زِ بہٕ گوٚژھُس وُنکٮ۪س توٚہہِ نِش آسُن تاکہِ بہٕ کرہا وارٕ نرمی سان توٚہہِ سٟتؠ کتھ تکیازِ وُنکٮ۪س چھُنہٕ مےٚ تارےٕ یِوان زِ توٚہہِ سٟتؠ کیا کرٕ بہٕ۔
\v 21 توٚہہِ منٛزٕ چھِ کینٛہہ یژھان تِم سٲری قانون پالٕنؠ یِم خداین موسیٰ ہس بخٕش۔ بہٕ چھُسو ونان زِ توٚہؠ سونٛچِو تِمن اثراتن متعلق تہِ یہِ موسیٰ ہن یِمن صحیفن منٛز لیٚوکھ۔
\v 22 تٔمؠ لیٚوکھ زِ ابرہام بنیو دوٚن شُریٚن ہُنٛد مول۔ تمؠ سنٛزِ نوکرانہِ ہاجرسؔ زاو اکھ لڑکہٕ تہٕ تسنٛزِ آشنہِ سارس یۅسہٕ نوکرٲنؠ اوسنہٕ بیاکھ شُر۔
\v 23 بیٚیہِ اوس یِمن شُریٚن منٛز بیٚنٮ۪ر۔ اسماعیل یُس شُر زن نوکرانہِ ہاجرسؔ زاو، آو دنیاہس فطری آیہِ۔ مگر یُس شُر سارس زاو یۅسہٕ زن نوکرٲنؠ ٲس نہٕ، آو دنیاہس معجزٕ کِنؠ تکیازِ اتھ منٛز اوس خدایہِ سُنٛد دخل یُس ابرہامس سٟتؠ پنُن عہد پوٗرٕ کرُن یژھان اوس۔
\v 24 بہٕ چھُسو یہِ وضاحتہٕ باپتھ لیٚکھان زِ یِم زٕ زنانہٕ چھےٚ علامتہٕ دوٚن سمجھوتن ہنٛزٕ۔ خداین کوٚر فٲصلہٕ زِ یتھ منٛز شرط اوس تِمن قانونن ہنٛز پیروی یِم خداین موسیٰ ہس سینا ناوٕ کِس بالس پیٚٹھ دتؠ تکیازِ أمہِ فٲصلہٕ کِنؠ اوس یِمن مانن والیٚن ہنٛدٕ باپتھ یِم قانون مستقل پٲٹھؠ تہ کُلہُم پٲٹھؠ پالٕنؠ ضروری۔ یہِ زٲنؠ تو زنتہ اکہِ نوکرٲنؠ ماجہِ نوکر زاو۔ اوے تہِ چھے ہاجرہ نوکرٲنؠ أمہِ مہادٕچ علامت۔
\v 25 تہٕ ہاجرہ چھےٚ أمہِ سمجھوتچ علامت تمام قانونو تہٕ رسمو سان یِم خداین سینا کِس بالس پیٚٹھ موسیٰ ہس دِتؠ أکِس عرب مُلکس منٛز۔ ہاجرؔ چھےٚ مزید یہُودؠ مزہبٕچ تہِ علامت۔ یہُودؠ مذہب چھُ زنتہٕ اکھ نوکرٲنؠ موج تہٕ یہُودؠ مذہب پالُن زنتہٕ نوکر شُرؠ۔ تکیازِ یِمن سارِنےٕ پزن خدایہِ سٕنٛدِ طرفہٕ موسیٰ ہس دِنہٕ آمٕتؠ قانون پالٕنؠ۔
\v 26 مگر ہُپٲرؠ چھُ اکھ روحٲنی یروشلم تہِ۔ أسؠ چھِ أمے روحٲنی یروشلمٕکؠ۔ زٲنتو یہِ چھِ اسہِ سارِنےٕ ہنٛز موج یِم یسوعسؔ مانان چھِ۔ أمہِ روحٲنی یروشلمٕکؠ چھِ تِم سٲری مۅکٕلؠ۔ موسیٰ ہس دِنہٕ آمٕتؠ قانون پالنہٕ نِشہٕ تہِ مۅکٕلؠ تہٕ عذاب نِشہٕ یُس یِمن نہ پالن والس میلہِ۔
\v 27 سٲنِس نٔوِس شہرس منٛز آسن تِم زیادٕ لوٗکھ یِم وُنکٮ۪س یروشلمس منٛز روزان چھِ۔ یہِ آسہِ زنتہٕ تی یہِ عیساین گۅڈٕ ؤنِتھ تھوو تِمن لوٗکن متعلق یِم یروشلم شہرس کُن واپس یِن تس ٲس امید زِ واپس پھیرن وٲلؠ آسن تِمہٕ زیادٕ یِم ملک بدر کرنہ آمٕتؠ ٲسؠ. تِم یِم یروشلم شہرس منٛز روزان چھِ مناون شٲدؠ۔ وُنؠ کٮ۪س چھِنہٕ توٚہہِ اولاد أکِس ہانٹھہِ زنانہِ ہنٛدؠ پٲٹھؠ یۅسہٕ شُریٚن زایُن ہیٚکنہٕ دِتھ مگر کُنہِ دوٚہہ دِیو توٚہؠ خوشی سٟتؠ کریکہٕ۔ یوٗتاہ تھود ہیٚکو تیوتاہ۔ یودوے توٚہؠ وُنکٮ۪س کمےٕ چھُو أکِس ہانٹھہِ زنانہِ ہنٛدؠ پٲٹھؠ یۅسہٕ زایُن ہیٚکنہٕ دِتھ تہٕ توے چھُو اکِتھ کُن مایوس پیمٕتؠ، توٚہؠ گٔژھِو خوش، توٚہہِ آسن واریاہ شُرؠ یِم توٚہہِ کُن یِن۔ یِم شُرؠ آسن تمہِ کھۅتہٕ زیادٕ یِم أکِس رٲنؠ واجنہِ زنانہِ ٲسِتھ ہیٚکن۔ \f + \fr 4‏:27 \ft یسعیاہؔ 54:1\f*
\v 28 ووٚنؠ بوزِو میانیو ایماندار سٲتھیو توٚہؠ بٔنیِو خدایہِ سٕنٛدؠ شُرؠ تکیازِ خداین کوٚر اضحاق سنٛدؠ پٲٹھؠ پنن ابرہامس سٟتؠ پنُن عہد پوٗرٕ۔
\v 29 سٮ۪ٹھا برونٛہہ کالہِ دیُت ابرہام سنٛدؠ نیٚچِوؠ اسماعیلس یُس فطری آیہِ زاو۔ پننس ابراہیمؔ سٕنٛدِس نیٚچوِس اضحاقسؔ اِذا یُس زن معجزٲتی زاو تِتھے پٲٹھؠ یِم ونان چھِ زِ اسہ پزن خدایہِ سٕنٛدِ طرفہٕ موسیٰ ہس دِنہٕ آمٕتؠ قانون پالٕنؠ تاکہِ خدا دِیہِ اسہِ نجات أسؠ چھِ تِمن ہنٛدِ خٲطرٕ اِذا وۅتلاوان یِم ابراہیمؔ سٕنٛدِس زُرِس مسیحسؔ پیٚٹھ پژھ قٲیم کران چھِ۔ \f + \fr 4‏:29 \ft پیدٲیش 21:9\f*
\v 30 مگر موسیٰ ہن لیٚکھؠ یم لفظ پیدٲیِشی ہنٛزِ اکہ کتابہِ ہنٛدِس عبارتس منٛز، "تٔمس آشنہِ ہُند نیٚچو یۅسہٕ نوکرٲنؠ آسہِ نہٕ ترِ پننِس مٲلؠ سٕنٛز ملکِیت وراثتس منٛز۔ نوکرانہِ ہُنٛد نیٚچو پراوِ نہٕ تمہِ منٛزٕ کانہٛہ چیز تہِ۔ اوے کٔڈٕکھ یمہِ جایہِ دور نوکرٲنؠ تہٕ تسُنٛد نیٚچو دۅشوے۔ \f + \fr 4‏:30 \ft پیدٲیش 21:10\f*
\v 31 میانیو ایمان باجیو۔ ہاجرؔ چھےٚ علامت تِمن قانون ہنٛز یِم موسیٰ یس خداین دِتؠ مگر أسؠ چھِنہٕ تِم یِمن یِم قانون پراوٕنؠ لٲزمی چھِ یِم خداین موسیٰ ہس دِتؠ۔ أسؠ چھِنہٕ نوکرانہِ ہاجرؔ ہنٛدؠ زُرؠ کینٛہہ۔ ییٚلہِ زن سارایہِ ہنٛدؠ زُرؠ تِم چھِ یِم زن خدایہ سنٛدِ یژھنہٕ زایُن لبان چھِ یمیُک خداین ابرہامس وعدٕ دیُتمُت اوس اوے چھِ أسؠ سارایہِ ہنٛدؠ روحٲنی زُرؠ یۅسہٕ نوکرٲنؠ ٲس نہٕ۔
\c 5
\p
\v 1 مسیحنؔ دیُت اسہِ ایمان والیٚن نجات تِم قانون یا سۅ کتاب پالنہٕ نِش یِم خداین یہودٮ۪ن دِتؠ تاکہِ اسہِ پیٚن نہٕ تِم پالٕنؠ۔ اوے تہِ روزو خداوندس کُن لٔگؠ تھےٕ۔ یِنہٕ کٲنٛسہِ پانس پیٚٹھ یِم پالنہٕ باپتھ جبر دِیو کرنہٕ یِم قانون پالنہٕ باپتھ۔ بیٚیہِ زنتہٕ توٚہؠ غلام چھُو یِمن قانونن ہنٛدؠ۔
\v 2 بہٕ چھُس پولُسؔ۔ دھیان تھٲیِو بہٕ کیا چھُسو ونان۔ یودوے توٚہؠ کٲنٛسہِ ختنہٕ کرنہٕ دِیو تیٚلہِ کرنہِ توٚہہِ مسیحؔ سٕنٛز تہنٛز باپتھ دنہِ آمٕژ قربٲنی کانہٛہ مدد۔
\v 3 بہٕ چھُس بیٚیہِ سنٛجیدگی سان ونان زِ یُس کٲنٛسہِ تہِ پانس ختنہٕ کرنہٕ دِیہِ تاکہِ سُہ پالہِ تِم سٲری قانون یِم خداین یہودٮ۪ن دِتؠ تاکہِ تِم بنن راستباز۔
\v 4 یِم یتھٕ پٲٹھؠ پانس راستباز بناونچ کوشش چھِ کران تِم قانون پٲلِتھ یِم خداین یہودٮ۪ن دِتؠ۔ تیٚلہِ چھُو توٚہؠ مسیحسؔ نِش الگ کران۔ خدا کرِ نہٕ توٚہہِ پیٚٹھ کانہٛہ مہربٲنی۔
\v 5 یہِ چھُ اوٕ کِنؠ زِ أسؠ ایمان وٲلؠ چھِ بڈٕ اعتمادٕ سان امید کران زِ مسیحسؔ پیٚٹھ پژھ تھاونہٕ کِنؠ بناوِ اسہِ خدا راستباز۔ پاک روح بناوِ اسہِ یہِ کرنس لایق۔
\v 6 یہِ چھُ اوٕ کِنؠ زِ ییٚلہِ أسؠ خداین یسوع مسیحسؔ سٟتؠ جوڑؠ لوٗکن چھا ختنہٕ کِنہٕ نہ اتھ چھیٚنہٕ کہینؠ اہمیت۔ بلکہ، چھےٚ مسیحسؔ پیٚٹھ سانہِ پژھ اہمیت۔ أسؠ چھِ مسیحسؔ پیٚٹھ پنٕنؠ پژھ ہاوان باقین سٟتؠ پننہِ لولہٕ سٟتؠ۔
\v 7 توٚہؠ ٲسِو روحٲنی طور ترقی ہنٛزِ وتہِ پیٚٹھ بڈٕ رٕتؠ پٲٹھؠ۔ توٚہہِ پزِ ہے نہٕ کانہٛہ اتھ منٛز پانس رُکاوٹ بننہٕ دیُن۔ ژکہِ زنتہٕ توٚہہ زونمُتےٕ چُھنہٕ پزر کیاہ چُھ۔
\v 8 خدا چھُ سُہ یُس توٚہہِ ناد لایان چھُ۔ سُہ چھُنہٕ توٚہہِ پتہٕ لٔگِتھ یہِ کرنہٕ باپتھ
\v 9 یہِ اپٕز تعلیم والہِ توٚہہِ سارِنےٕ وُنہٕ۔ یتھٕ پٲٹھؠ مانٛڈنہٕ آمتِس ٲٹِس منٛز چھرا خمیرٕ پیونٛت چھُ اتھ ہُپہٕ راوان۔ \f + \fr 5‏:9 \ft 1 کورنتھین 5:6\f*
\v 10 تکیازِ خداین کوٚر اسہِ خداوندس سٟتؠ یکُت۔ مےٚ چھُ یقین زِ توٚہؠ سونچِو تہٕ کٔرِو چھرا میٲنِس وننس پیٚٹھےٕ یوت پژھ۔ اتھ اُلٹہٕ دِیہِ خدا یقیناً تِمن سزا یِم توٚہہِ پراکندہ کران چھُو۔ یِمن چیزن متعلق چاہے تِم کم تہِ چھِ۔
\v 11 میانیٚو ایمان والیٚو باجیٚو یودوے مےٚ بیٚیہِ یہِ ونُن پیٚیہِ زِ اسہِ پزِ کٲنٛسہِ اتھہِ ختنہٕ کرناوُن راستباز بننہٕ باپتھ تیٚلہِ ستایہِ ہےنہٕ کانہٛہ مےٚ۔ یہِ چھُ اوٕ کِنؠ تہِ ونُن زِ سُہ مۅکلاوِ ہے تصوُر زِ یسوع سُنٛد مرُن کوتاہ جارہانہٕ چھُ۔
\v 12 بیٚیہِ یِم توٚہہِ ڈالان چھُو سپدن پانہٕ آختہٕ۔
\v 13 ایماندار سٲتھیو، خداین دِتُو توٚہہِ ناد نجاتس کُن۔ تِمو قانونو نِشہٕ یِم خداین یہودٮ۪ن دِتؠ۔ مگر تٔمؠ کٔرِو نہٕ توٚہؠ آزاد تِمو قانونو نِشہٕ تاکہِ توٚہؠ کرِو گناہ۔ گناہ کرنہٕ بجایہ کرو اکھ أکِس سٟتؠ محبت۔
\v 14 یہِ کٔرِو تکیازِ اکھ حکم چھُ سارنےٕ قانونن ہُنٛد ہرتر یِم قانون خدایہ سنٛدؠ یہودٮ۪ن حکم چھِ۔ پرٛتھ کٲنٛسہِ نفرس بٔرِو لول یوٗتاہ توٚہؠ پانس بران چھُو۔ \f + \fr 5‏:14 \ft احبار 19:18، متی 22:39۔ 40\f*
\v 15 ووٚنؠ اگر توٚہؠ اکھ أکِس اِذا دِوان روزِو ونہٕ ہاپتن ہنٛدؠ پٲٹھؠ، خبردار روزِو توٚہؠ کٔرِو پٲنؠ پانس ختم۔
\v 16 بہٕ چھُسو ونان پننِس مقدس روحس دِیو پنُن رہنما بننہٕ، یودوے توٚہؠ تہِ کٔرِو نہٕ تہِ یہِ تُہنٛد گناہگار نفس یژھِ کرُن تہِ بنہِ۔
\v 17 یہِ چھُ اوٕ کِنؠ زِ تُہنٛد گناہگار نفس چھُ تہِ کرُن یژھان یہِ زن پاک روح سنٛدِس وننس مخٲلف چھُ۔ مذید یتہِ پاک روح یژھان چھُ تہِ کرُن یہِ گناہگار نفسس مخٲلف چھُ۔ یہِ چھُ اوٕ کِنؠ زِ یِم دۅشوے چھِ اکھ أکِس مخٲلف۔ نتیجہٕ چھُ یہِ زِ توٚہؠ چھُو نہٕ ہر وِزِ تہِ کٔرِتھ ہیٚکان یژھنہٕ باوجود تہِ۔
\v 18 یودوے توٚہہِ پاک روح رہنما بنہِ تِم قانون یِم خداین یہودٮ۪ن دِتؠ رٹن توٚہہِ تَل۔
\v 19 توٚہہِ چھَو پانس صاف صاف خبر زِ لوٗکھ کیا چھِ کران پننیٚو گناہ گار نفسو۔ تِم چھِ کران غٲر اخلٲقی جنسی کامہ، بدکٲری تہٕ ویکھٕتؠ کار۔
\v 20 تِم چھِ اپزٮ۪ن خداین پوٗزان، جٲدؠ کران، اِذا واتناوان، لوٗکن سٟتؠ لڑایہ تُلان، حسد تھاوان، ژکھہِ سان خۅد غرضی کران، لوٗکہٕ جمٲژن منٛز شیطٲنؠ کار کران تہٕ لوٗکن منٛز بیٚنٮ۪ر تراوان۔
\v 21 تِم چھِ لوٗکن ہنٛز دٕے تہِ تھاوان، شرابہٕ نشہٕ کٔرِتھ روزان، نشس منٛز باقےٕ گناہ تہٕ اتٕرؠ کران۔ بہٕ چھُسو خبردار کران اتریٚو تہٕ گنہو نِشہٕ۔ یتھٕ پٲٹھؠ مےٚ توٚہؠ برونہٛہ تہِ خبردار کٔرِو۔ سُہ کانہٛہ تہِ یُس یِم کۅکار ہیٚتھےٕ کران روزِ، سُہ سپدیٚنہٕ خدایہِ سٕنٛدِس سلطنتس منٛز شٲمِل۔
\v 22 پاک روح کرِ توتہِ اسہِ مسیحسؔ مانن والیٚن باقین سٟتؠ لول بٲگراونس تہٕ خوشی تہٕ امنہٕ سان جان پٲٹھؠ روزنس، صبرٕ تہٕ رحم دلی تہٕ وفادٲری،
\v 23 شریف تہٕ پانس پیٚٹھ ضبط تھاونس لایق، کانہٛہ تہِ قانون چھُنہٕ یُس یہِ کرنس ٹھاک کرِ۔
\v 24 اسہِ یِمن مسیحسؔ سٟتؠ تعلق چُھ، چُھ تہِ کرُن تروومُت یہِ سون گناہ گار نفس محسوس کران تہٕ کرناوُن یژھان چھُ۔
\v 25 چونکہِ پاک روحن کٔرؠ أسؠ روحٲنی طور بیدار۔ اسہِ پزِ پاک روحس پنٕنؠ رہبری کرنہٕ دِنؠ۔
\v 26 تھیٚکنل مہٕ بٔنِو۔ اَکھ أکِس مہٕ کھٲلِو ژَکھ۔ اکھ أکِس سٟتؠ مہٕ کٔرِو حسد۔
\c 6
\p
\v 1 ایمان باجیٚو! یودوے توٚہہِ پتاہ لگہِ زِ کانہٛہ ایمان وول چھُ کیاہتام غلط کران۔ توٚہہِ منٛزٕ روحٲنی طور سمجھدارن پزِ سُہ نفر بڈٕ نرمی سان درُست کرُن۔ یہِ کرنس دوران پزِ توٚہہِ بڈٕ احتیاط کرُن یُتھنہٕ توٚہہِ پانس کینٛہہ اتُر گژھِ۔
\v 2 اکھ أکِس کٔرِو پنٕنؠ مسلہٕ أنٛزراونس منٛز اتھہٕ روٚٹ۔ یہِ کرنہٕ سٟتؠ چھُ توٚہؠ مسیحؔ سنٛدین حکمن پالان۔
\v 3 بہٕ چھُسو ونان یہِ اوٕ کِنؠ زِ یِم لوٗکھ غلطی کِنؠ یہِ سونچان چھِ زِ تِم چھِ باقیو کھۅتہٕ بہتر، تِم چھِ پٲنؠ پانس تاران تہِ مٲنِتھ یِنہٕ پوٚز چھُ۔
\v 4 أمہِ بدلہٕ پزِ پرٛتھ کٲنٛسہِ پنُن کرُن کراوُن برابر پرکھاوُن روزُن۔ تیٚلی ہیٚکِو توٚہؠ پزنہٕ پٲٹھؠ پننِس کرنس کراونس پیٚٹھ تھیکنس لایق بٔنِتھ أمہِ بدلہٕ زِ توٚہؠ تھیٚکِو بٔلؠ زِ ہُمؠ یمؠ کیا کوٚر۔
\v 5 بہٕ چھُسو یہِ اوٕ کِنؠ ونان زِ توٚہہِ پزِ تی کرُن یہِ خداین کرنہٕ باپتھ دِتو۔
\v 6 یودوے توٚہؠ ایماندار سٲتھی یہِ رُت ہیٚچھنٲوؠ نو زِ خداین کیا چھُ ووٚنمُت، تیٚلہِ پزِ توٚہہِ تہِ باقین تہِ بٲگراوُن یہِ تِمن نِشہٕ توٚہہِ ہٮیٚچھُو۔
\v 7 پانس مہٕ کٔرِو تارن گٔری۔ کانہٛہ ہیٚکہِ نہٕ خدایس مذاق کٔرِتھ۔ یہِ چھُ اوٕ کِنؠ زِ کانہٛہ کمیُل چھُ تی لوٚنان یُس پھسٕل تٔمؠ وۅو لوٗکھ رٹن تمیُک پھل یہِ تِمو کوٚر۔
\v 8 یِم لوٗکھ تی کرن یہِ پنن گناہ گار کرن ونٮ۪کھ لونن پننہِ کرنُک پھل۔ خدا دِیہِ تِمن پوشہٕ وُن عذاب۔ ووٚنؠ گو یِم پاک روحس خوش تھاون تُلن رُت مزٕ أمی کرنُک، پاک روح بناوِ تِمن خدایس سٟتؠ پوشہٕ وٕنؠ زندگی پراونس لایق۔
\v 9 اسہِ پزِ نہٕ رٕژِ کامہِ کرنہٕ سٟتؠ تھکُن تکیازِ منٲسب وقتس پیٚٹھ لبو أسؠ پننہِ کرِمژِ أمہِ رٕژِ کامہِ ہنٛد رُت پھل۔ یہِ سپدِ یودوے اسؠ رٕژِ کامہِ کرنہِ تراوو نہٕ۔
\v 10 اوے پزِ اسہِ یوٗتاہ پِلہِ تیوٗتاہ سارنےٕ سٟتؠ رُت کرُن۔ اسہِ پزِ خاص پٲٹھؠ مسیحؔ سنٛدین ایماندار سٲتھیٚن سٟتؠ خاص پٲٹھؠ رُت کرُن۔
\v 11 بہٕ چھُسو یہِ نامہٕ توٚہہِ پننہِ قلمہٕ لیٚکھان، یہِ تھٲیِو دماغس منٛز زِ یِم نامہٕ کٲتیاہ زیٹھؠ چھِ۔
\v 12 تِم سٲری یِم یہودٮ۪ن مُتٲثر چھِ کرُن یژھان زِ تم کِتھہٕ کِنؠ چھِ ظٲہری طور ظٲہر گژھان، چُھ توٚہہِ مجبور کرنٕچ کوشش کران زِ کٲنٛسہِ چُھ توٚہہِ ختنہٕ کرُن۔ تِم کرن صرف یہِ یہُودین یہِ یقین کرنہٕ خاطرٕ تمن ستاونہٕ نش پتھ رٹنہٕ باپتھ مسیحؔ گُزریاو صلیبس پیٚٹھ اسہِ بچاونہٕ خاطرٕ۔
\v 13 بہٕ چُھس یہٕ ونان تکیازِ تم لوکھ تہِ چھِنہٕ قانون پالان یمن ختنہٕ چُھکھ کوٚرمُت یِم خداین یہودٮ۪ن دِتؠ۔ بلکہ چھِ تِم تُہنٛد ختنہٕ کرُن یژھان فخر کرنہٕ خٲطرٕ زِ توٚہؠ کِتھہٕ کِنؠ چھُو ظٲہِر گژھان۔
\v 14 یوٚت تام میون تعلق چھُ، بہٕ کرٕ زانٛہہ تہِ پننِس خداوند عیسیٰ مسیحؔ سٕنٛدِس صلیبس پیٚٹھ گُزرنکِس بارس منٛز فخر اسہِ بچاونہٕ باپتھ۔ تکیازِ یسوع گُزریاو صلیبس پیٚٹھ، گناہ گار دنیا چُھ میانہِ خٲطرٕہ زنتہٕ اکھ مۅردٕ شخص بنیامُت، تہٕ بہٕ چُھس زنتہٕ گناہ گار دنیاہس منز اکھ مۅردٕ شخص بنیامُت۔
\v 15 بہٕ ہیٚکہٕ مسیحؔ سٕنٛدِس صلیبس پیٚٹھ مرنس پیٚٹھ فخر کرتھ تکیازِ لوٗکن ہنٛد ختنہٕ چھا یوان کرنہٕ کیٚنہٕ نَہ، چُھنہٕ اہم۔ بلکہ، پاک روح چھُ تِمن نٔوؠ لوٗکھ بناوان چُھ اہم۔ \f + \fr 6‏:15 \ft غلتین 5:6\f*
\v 16 بہٕ چھُس دُعا کران زِ خدا بناوِ پرٛتھ کٲنٛسہِ پُر امن یُس یِتھٕ پٲٹھؠ برتاو چھُ کران تہٕ کرِ تِمن پیٚٹھ رحم۔ بہٕ چھُس یِمن چیزن ہُنٛد دُعا تہِ کران اسرائیلین خاطرٕ یِم مسیحسؔ پیٚٹھ بھروسہٕ چھِ کران تہٕ خدایس سٟتؠ تعلق چھِ تھاوان!
\v 17 مےٚ چھِ میٲنِس جسمَس پیٚٹھ داغ\f + \fr 6‏:17 \ft پولُسؔ سنٛدؠ یِم نشان چھِ ہاوان زِ سُہ اوس یسوع مسیح سُنٛد اکھ خاص خدمت گار\f* تکیازِ مےٚ کٔر یسوعس متعلق سچٲیی ۂنٛز تۅرے تاکہِ کٲنسہِ مہٕ دِیو پریشان کرنٕچ وَتھ دُبارٕ یِمن معاملن متعلق۔
\v 18 ایماندار سٲتھیو، بہٕ چُھس دعا کران زِ سون خداوند عیسیٰ مسیحؔ گژھہِ توٚہہ سارنےٕ خٲطرٕ روحٲنی مہربان! یہِ گژھہِ آسُن!
