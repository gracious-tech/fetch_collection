\id JUD - DMT Kashmiri
\toc1 یہُوداؔ
\mt1 یہُوداؔ
\c 1
\p
\v 1 مےٚ یہُوداہنؔ، کٔر یسوع مسیحؔ سنٛز خدمت، تہٕ بہٕ چُھس یعقوبؔ سُنٛد بوے۔ بہٕ چُھس لیٚکھان توٚہہ یَس خداین چُھ ناد دیُتمُت، توٚہہِ یٔمِس بب خدا چُھ لول بران، توٚہہِ یٔمِس یسوع مسیحؔ چُھ پننہٕ خاطرٕ تھاوان۔
\v 2 بہٕ چُھس دُعا کران زِ خدا کرِ توٚہہِ سٟتؠ پنٕنہِ رحم دلی ہنٛزِ کاروٲیی منٛز ہُرٮ۪ر تہٕ بناوِ توٚہہِ زیادٕ پُر امن تہٕ کرناوِ توٚہہِ پننہِ لولُک مزید تجربہٕ۔
\v 3 ایماندار سٲتھیو یمن بہٕ لول چُھس بران، مےٚ کٔر توٚہہِ اکھ نامہٕ لیٚکھنٕچ پورٕ کوشش زِ خداین کِتھہٕ کِنؠ چھِ أسؠ سٲری بچٲوؠ مٕتؠ یم یقین چھِ تھاوان۔ تاہم، مےٚ پیٚیہِ امہِ بدلہٕ یہٕ نامہٕ لیٚکھنٕچ ضرورت تاکہِ توٚہہِ دِمو تِمن حقیقی چیزن ہنٛدِ دفاع کرنہٕ خٲطرٕ زور یِمن پٮ۪ٹھ اسہِ یقین چُھ۔ یم چھِ چیز یِم خداین ہر وقتہٕ تِمن تمام لوٗکن چھِ دِتؠ مٕتؠ یِم تٔمؠ پاک چھِ بنٲومٕتؠ۔
\v 4 بہٕ چُھسو توٚہہِ یہٕ کرنہٕ خٲطرٕ زور دِوان تکیازِ کینٛہہ مرد چھِ ژورِ پٲٹھؠ تُہنٛزن مجلسن منٛز یِوان۔ تِم چھِ مرد یِم خداین واریاہ کال برونٛہہ مزمت کرنہٕ باپتھ ژٲرؠ مٕتؠ چھِ۔ تم چھِ غأر خدا کامہِ کران۔ تیٚہُنٛد خیال چُھ زِ سون خدا چُھ لوکن جنسی طور غأر اخلٲقی گژھنُک اجازت دِوان تکیازِ سُہٕ چُھ مہربان۔ تِم چھِ یسوعسؔ مسیحس تہِ انکار کران، یُس کُنے زُن اسہِ مٲلک چُھ تہٕ چُھ اسہِ پٮ۪ٹھ حکمرٲنی چُھ کران۔
\v 5 حالانکہ توٚہؠ ٲسِو گۅڈَے یِم تمام چیز زانان، بہٕ چُھس یژھان توٚہہِ تِمن ہُنٛد یاد دیُن۔ یاد تھٲیِو زِ ییٚلہ یسوعن مِصرٕ ملکہٕ منٛزٕ اسرائیلٕکؠ لوٗکھ بچٲوؠ، تٔمؠ کٔرؠ تِم لوٗکھ تباہ تِمو منٛزٕ یِمنہٕ تمِس پٮ۪ٹھ بھروسہٕ ٲسؠ کران۔
\v 6 امہِ علاوٕ، رودؠ نہٕ کینٛہہ فرشتہٕ پننٮ۪ن منٲسب جاین پٮ۪ٹھ ییٚتہِ تِمن اختیار اوس مگر تم ترٲوِکھ۔ تکیازِ تِمو کوٚر یہِ خداین ٲسؠ تِم ہمیشہٕ خٲطرٕ انہِ گٔٹِس منٛز جہنمس منٛز قٲد کٔرؠ مٕتؠ۔ خداین کوٚر یہ تِمن پٮ۪ٹھ فٲصلہٕ کرنہٕ باپتھ اہم دوٚہہ ییٚلہ سُہٕ پرٮ۪تھ چیزُک فٲصلہِ کرِ۔
\v 7 یہٕ چُھ تِمن لوٗکن متعلق درُست یِم سدومؔ تہٕ عمورہ کٮ۪ن شہرن منٛز روزان چھِ تہٕ یمن نزدیکی شہرن منٛز۔ تمو کٔر جنسی طور غٲر اخلٲقی طریقہٕ کٲم یتھٕ کٔنؠ زن تِمو فرشتو کوٚر۔ تِمو نِیو پرٮ۪تھ قسمٕچن نامُنٲسب جنسی عملن منٛز حصہٕ۔ یمن فرشتن تہٕ لوٗکن جہنم کس نارس منٛز ابدیت خاطرٕ مصائب برداشت کٔرِتھ، چُھ خدا یِمن اکھ مثال بناوان تِمن لوٗکن ہنٛز یم تمِس انکار چھِ کران۔
\v 8 یِتھے پٲٹھؠ، یِم اپٕزؠ وۅستاد چھِ خواب وچُھن وٲلؠ یم نہ صرف غأر اخلٲقی پٲٹھؠ زندٕ روزِتھ پنُن جسم گندٕ بناوان چھِ، مگر خداوند سنٛدٮ۪ن حکمن تہٕ چھِ مسترد کران۔ تِم چھِ خدا سنٛدٮ۪ن شاندار فرشتن ۂنٛز بے عزتی تہِ کران۔
\v 9 یوٚت تام نہٕ مُقرب فرشتہٕ مِیکائیل تہِ تیوٗت جُرت منٛد اوس زِ سُہٕ کرِہا شیطانس خلاف توہین آمیز الزام ییٚلہ تٔمؠ موسیٰؔ سنٛزِ مۅردٕ لاشہِ متعلق تس سٟتؠ بحث کوٚر۔ امہِ بجایہ ووٚن تٔمؠ، "خداوند چھُے ژےٚ بٮ۪وٲری کران!"
\v 10 امہِ برعکس، یم اپٕزؠ وۅستاد چھِ روحٲنی چیزن متعلق بُرٕ لفظ بولان یِمنہٕ تِم سمجھان چھِ۔ تم چھِ بالکل چارواین ۂنٛدؠ پأٹھؠ یِم نہٕ عقلی طور سونچِتھ ہیٚکن۔ تِم چیز یِم تِم قدرتی طور سمجھنس قٲبل چھِ، چھِ تِمن تباہ کران۔
\v 11 یہِ کوتاہ دۅکھ چُھ تِمن خٲطرٕ! تم چھِ قٲینؔ سٕنٛدؠ پأٹھؠ کٲم کران، یمؠ پنُن بوے قتل کوٚر۔ تِمو چُھ پنُن پان سُہ گناہ کرنہٕ خٲطرٕ وقف کوٚرمُت یُس بلعامنؔ پونٛسہٕ حٲصِل کرنہٕ خٲطرٕ کوٚرمُت اوس۔ خدا کرِ یقینی طور تِمن تباہ یتھٕ پٲٹھؠ تٔمؠ قورحؔ تباہ کوٚر تہٕ تِم یِمو بغاوت کٔر تمِس سٟتؠ موسیٰؔ ہس خلاف۔
\v 12 یِم لوٗکھ چھِ بے شرمی سان توٚہہِ سٟتؠ کھیٚوان۔ تُہنٛدِس رفاقتہٕ کِس کھیٚنس منٛز چھِ تِم آبس تَل چُھپِتھ کنٮ۪ن ۂنٛدؠ پٲٹھؠ یِمن سٟتؠ جہاز ٹکران چھِ۔ تم چھِ صرف پنُن خیال تھاوان۔ تِم چھِ بیکار، اوٚبرٕکؠ پأٹھؠ یتھ ہوا چُھ پکناوان روٗد پیٚنہٕ برونٛٹھ۔ تم چھِ بیکار، کُلٮ۪ن ہنٛدؠ پأٹھؠ یِمنہٕ پھل چھِ دِوان فصلکہِ کٹاوکہِ وقتہٕ۔ تِم چھِ کُلٮ۪ن ہنٛدؠ پأٹھؠ یِم دویہِ لٹہِ مران چھِ تکیازِ خدا کڑِ تِمن موٗلو۔
\v 13 تِم چھِ بے قابو، سمندرچن لہرن ہنٛدؠ پأٹھؠ۔ تِم چھِ پننہِ شرمناک حرکژٕ ظٲہِر کران یتھٕ کِنؠ لہرٕ پھوٚس چھےٚ کھالان۔ تِم چھِ زنتہٕ تارکن ہنٛدؠ پٲٹھؠ یِم نہٕ آسمانس تتِتھ چھِ روزان ییٚتہِ تِمن روزُن پزِ۔ خدا چُھ تُہنٛدِ باپتھ جہنمچ تاریک اُداسی ہمیشہ خاطرٕ محفوظ تھاوان۔
\v 14 یوٚت تام حنوکنؔ، آدمؔ سٕنٛدِ پٮ۪ٹھٕ ینہٕ والیٚن لوٗکن ہنٛزِ لٲنہِ منٛز سٔتِم شخص، کٔر یِمن اپزؠ وۅستادن ہنٛدس بارس منٛز کتھ ییٚلہ زن تٔمؠ ووٚن: "یہِ بوزیٚو احتیاطہٕ سان: خداوند ییہِ یقینی طور پننٮ۪ن پاک فرشتن ۂنٛدِس بے شمار تعدادس سٟتؠ۔
\v 15 تِم یِن پرٮ۪تھ کٲنسہِ ہُنٛد فٲصلہٕ کرنہٕ خٲطرٕ تہٕ پرٮ۪تھ کٲنسہِ تُہنٛدِ تمام غٲر خدٲئی عملہِ ہنٛز ملامت کرنہٕ خٲطرٕہ یِم تِمو غٲر خدٲیی طریقو کرِمژٕ چھےٚ، تہٕ تمن سارنےٕ لوٗکن سخت بے عزتی کرنہٕ خٲطرٕہ، یِم گناہ گار چھِ تہٕ خدایس بے عزتی کران چھِ، یسوعس خلاف کتھ چھِ کران۔"
\v 16 یِم اپٕزؠ وۅستاد چھِ پننس پانس کُن گڑبڑ کران تہٕ باقین شکایت کران۔ تم چھِ پننیٚو گناہ گار خوٲہشو مطابق زُووان تہٕ پننس بارس منٛز بڑائی کران۔ تم چھِ لوٗکن سٟتؠ چاپلوٗسی کران تہِ حٲصِل کرنہٕ خٲطرٕ یہِ تِم تِمن نِش یژھان چھِ۔
\v 17 مگر توٚہؠ سٲتھی ایماندار یہُنٛد مےٚ لول چُھ، یاد تھٲیِو زِ سٲنؠ خداوند یسوع مسیحؔ سنٛدیو رسولو کیا اوس واریاہ برونٛہہ ووٚنمُت۔
\v 18 یاد تھٲیِو زِ تِمو ووٚن توٚہہِ، "ٲخری دوٚہُن منٛز یسوع سٕنٛدِ واپس یِنہٕ برُونٛہہ، اتہِ آسن تِم لوٗکھ یِم تِمن پزٮ۪ن چیزن ہُند مذاق بناون یِم خداین اسہِ ؤنؠ مٕتؠ چھِ۔ تِم روزن زنٛدٕ پننیٚو گناہ گار خوٲہشو مطٲبق یم خدایس بے عزتی چھِ کران۔"
\v 19 یِم مذاق بناون وٲلؠ چھِ تِم لوٗکھ یِم ایماندارن اکھ اکس سٟتؠ ناراض چھِ کران۔ تِم چھِ پننہٕ فطری جبلتہٕ مطابق روزان۔ پاک روح چُھنہٕ یِمن اندر روزان۔
\v 20 تاہم، توٚہؠ سٲتھی ایماندار یہُنٛد مےٚ لول چُھ، خدایس پٮ۪ٹھ پنن بھروسہٕ بڑٲوِتھ تہٕ پاک روح کہِ مدتہٕ سٟتؠ دعا کرتھ،
\v 21 روزیٚو تِتھٕ پأٹھؠ یُس توٚہہِ خدایہ سنٛدِ لولُک تجربہٕ کرنس قٲبل بناوِ۔ یہٕ کٔرِو سٲنِس خداوند یسوع مسیحؔ سٕنٛدِ رحم دلی ہنٛزِ واپسی ہنٛز امید کران، یمہ کِس نتیجس منٛز ابدی طور تمِس سٟتؠ زنٛدٕ روزن۔
\v 22 تہٕ تِمن سٟتؠ گژھہٕ رحم کرُن یم اُلجِھتھ چھِ اتھ متعلق زِ تِمن کتھ پٮ۪ٹھ پزِ یقین کرُن۔
\v 23 مگر باقٕے لوٗکھ بچٲے ووکھ جلدےٕ، زنٛتہٕ چھوکھ توٚہؠ تِم جہنمکہِ نارٕ منٛزٕ نٮ۪بر کڈان۔ تہٕ کٔرِو کینژن باقےٕ لوٗکن سٟتؠ تہِ رحم، مگر تِمن سٟتؠ روزیٚو محتاط، زنٛتہٕ گژھِو توٚہؠ تہنٛدٮ۪ن پلون سٟتؠ اتھہٕ لٲگِتھ گناہ گار۔
\v 24 خدا چُھ قٲدر توٚہہِ گناہ گار زِنٛدگی منٛز واپس اننُک۔ سُہ چُھ یتھ پٮ۪ٹھ تہِ قٲدر زِ سُہ انہِ توٚہہ گناہ ورٲے پننہِ جلالہٕ واجنہِ موجودگی منٛز۔ توٚہؠ روزیٚو یتہِ کھڑا سٮ۪ٹھاہ خوشی سان۔
\v 25 صرف چُھ یتہِ اکھ خدا۔ تٔمؠ بچٲوؠ أسؠ امہِ کِس نتیجس منٛز زِ سٲنؠ خداوند یسوع مسیحؔ ہن کٔر اسہِ خٲطرٕ کٲم۔ بہٕ چُھس دعا کران زِ پرٮ۪تھ کانٛہہ کرِ تسلیم زِ خدا چُھ جلالہٕ وول، شاندار، طاقتور، تہٕ عظیم اختیارٕ سان حکمرٲنی کران۔ سُہ اوس یُتھ، وقت شروع گژھنہٕ برونٛہہ۔ سُہ چُھ اَز تیُتھے، تہٕ سُہ روزِ تیُتھُے ہمیشہٕ! یہِ گژھِ پٔزی تیُتھ آسُن!
