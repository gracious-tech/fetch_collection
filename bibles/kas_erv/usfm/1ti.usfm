\id 1TI - DMT Kashmiri
\toc1 1 تِیموتھیُس
\mt1 1 تیمُتھیس
\c 1
 تیموتھیسؔ سٕنٛدِ ناوٕ پولُسؔ رسول سنٛز گوٚڈنچ چِٹھؠ۔
\p
\v 1 پولُسؔ سٕنٛدِ طرفہٕ یُس مسیحؔ یسوع سنٛز نمایندگی چُھ کران۔ یہِ چُھ تی یہِ کرنس دِیُت مےٚ اسہِ نجات دِنہٕ وٲلؠ خداین تہٕ سٲنؠ خداوند یسوع مسیحؔ ہن حکم یمسنٛز اسہِ امید چھےٚ۔
\v 2 ژٕ تیمُتھیس چُھکھ ایمانکہ لحاظٕ پزِؠ پٲٹھؠ میون زنتہٕ اکھ نیٚچو۔ بب خدا تہٕ سون خداوند یسوع مسیحؔ روزِن ژےٚ پٮ۪ٹھ مہربان تہٕ کٔرِن ژےٚ پٮ۪ٹھ رحم تہٕ تھٲونَے امنہٕ سان۔
\v 3 وۅنؠ چُھسے بہٕ تلقین کران، یتھٕ پٲٹھؠ مےٚ مکدُنیہ صوبس کُن گژھنہٕ وِزِ ژےٚ افسس شہرس اندر روزنُک تلقین کوٚرمُت اوس۔ تتہِ روز تاکہِ ژٕ ہیٚککھ تتہِ کینٛژن نفرن تِمن چیزن ہنٛزِ تعلیم دِنہٕ نِشہ روٚٹ کٔرِتھ یِم تٔمہِ نِشہ بیوٚن چھِ یہِ پوٚز چُھ۔\f + \fr 1‏:3 \ft افیسسؔ اوس ایشیا صغیرس منز اکھ بندرؔ شہر یُس جدید ترکی چُھ۔ مکدونیا اوس اکھ صوبہٕ۔\f*
\v 4 تِمن دِیو ہدایت زِ تِم بناون نہٕ پرانہِ دلیلہٕ تہٕ لاانتہا نسب نامہٕ استعمال کٔرِتھ مرکزی نقطٕ۔ یِمن چیزن پٮ۪ٹھ پتہٕ لوٗکھ أکس بیٚس سٟتؠ بحث کران چھِ۔ تِم چُھنہٕ خدایہِ سنٛز کتھ برونٛہہ کُن پکناونس منٛز مدد کرن۔ تہِ چُھ تیلے سپدان ییٚلہِ اسہِ خدایس پٮ۪ٹھ ایمان آسہ۔
\v 5 أسؠ چھِ یِمن کامٮ۪ن پٮ۪ٹھ زور دِوان زِ خدایہِ سٕنٛدؠ لوٗکھ برن اکھ أکس لول۔ تِم کرن یہِ تیٚلہِ ییٚلہِ تِم صرف رُت کانٛچھن، ییٚلہِ تِمن اعتمادٕ سان مولوم آسہ زِ تِم چھِ رٕژٕ کامہِ کران بیٚیہِ آسیٚکھ خدایس پٮ۪ٹھ پزؠ پٲٹھؠ ایمان۔
\v 6 کینٛژو لوٗکو چھِ یِمن رٕتٮ۪ن چیزن انکار کۅرمُت۔ اتھ بجایہ چھِ تِم بےکار چیزن ہنٛز تعلیم دِنس ترجیح دِوان۔
\v 7 تِم چھِ یژھان شریعتٕکؠ وۅستاد بنٕنؠ، یہِ خداین موسیٰؔ ہس عطا کوٚر، مگر تِمن چُھنہٕ تِم چیز فکرِ تران یِمن متعلق تِم کتھہٕ چھِ کران، نہ چُھ تِمن یِمن چیزن متعلق علم یِمن پٮ۪ٹھ تِم پوٚز آسنس پٮ۪ٹھ زور دِوان چھِ۔
\v 8 مگر أسؠ چھِ زانان زِ یُس شریعت خداین موسیٰؔ ہس عطا کوٚر سُہ کرِ لوٗکن مدد ہرگاہ تِم تتھ اصل پٲٹھؠ عملہِ منٛز انن۔
\v 9 أسؠ چھِ زانان زِ خدا چُھنہٕ راستباز لوٗکن ہنٛدِ خٲطرٕ شریعت بناون، مگر تِمن لوٗکن ہنٛدِ باپتھ یِم کٲم چھِ کران زنتہٕ کانٛہہ شریعت چھنہٕ تہٕ یم کٲنسہِ ہنٛز اطاعت کرنس تہِ چھِ انکار کران۔ خدایہِ چُھ یہِ شریعت تِمن لوٗکن ہنٛدِ خٲطرٕ سوزان یِم خدایس انکار کران چھِ، تہٕ تِمن خٲطرٕ یِم گناہ گار چھِ، تِمن خٲطرٕ یِمنہٕ خدایس احترام کران چھِ تہٕ تس کُن چُھنہٕ پھیران، تٔمؠ بنوو یہِ شریعت تِمن ہنٛدِ خٲطرٕ یِم پننِس مٲلس ماجہِ قتل چھِ کران، تہٕ بیٚیہِ تِمن خٲطرٕ یِم باقےٕ لوٗکن قتل چھِ کرن۔
\v 10 خداین دِیُت شریعت تِمن لوٗکن ہنٛدِ خٲطرٕ یِم زنا کران چھِ، مونٛڈٕ باز چھِ، یِم لوٗکن غلامی خٲطرٕ کننہٕ باپتھ ژوٗرِ نِوان چھِ، یِم لوٗکھ اپُز ونن وٲلؠ چھِ، یِم لوٗکھ عدالتن منٛز اپٕز گوٲہی دِنہٕ وٲلؠ چھِ، تہٕ بیٚیہِ تٔمس پرٮ۪تھ أکؠ سٕنٛدِ خٲطرٕ یُس سانہِ پزِ تعلیمہ برعکس عمل کرِ۔
\v 11 یہِ تعلیم چھےٚ سٲنس جلالہٕ وٲلِس خدایہِ سنٛزِ رٕژِ شیٚچھِ سٟتؠ واتان، یمِس أسؠ تعریف کران چھِ۔ یہِ چھےٚ سۅ رٕژ شیٚچھ یۅسہ تٔمؠ مےٚ بخشؠ باقین نِشہ اعلان کرنہٕ خٲطرٕ۔
\v 12 بہٕ چُھس سٲنس خداوند یسوع مسیحؔ سُنٛد شکُر گُزار یمؠ بہٕ یہِ کٲم کرنس لایق بنووُس، تکیازِ تٔمؠ زون زِ سُہ ہیٚکہِ مےٚ پٮ۪ٹھ بھروسہٕ کٔرِتھ۔ اوے کۅرُس بہٕ تٔمؠ پنُن خدمت گار مقرر۔
\v 13 برونٛہہ کالہِ ونہِ مےٚ أمِس متعلق اپزِ کتھہٕ، مےٚ واتنوو تٔمؠ سنٛدین لوٗکن تکلیف، تہٕ مےٚ کوٚر تِمن پٮ۪ٹھ سؠٹھاہ تشدد۔ مگر مسیحؔ رود مےٚ پٮ۪ٹھ مہربان ییٚلہِ مےٚ مولوم اوسنہٕ زِ بہٕ یہِ کران اوسُس تہِ اوس غلط تکیازِ مےٚ اوسنہٕ تٔمس پٮ۪ٹھ ایمان۔
\v 14 سٲنؠ خداوندن کوٚر مےٚ پٮ۪ٹھ فضل یمیُک نہٕ بہٕ حقدار اوسس، زِ تٔمؠ کوٚر مےٚ مسیحؔ یسوعس پٮ۪ٹھ ایمان عطا تہٕ یُس تہِ کانٛہہ تٔمس سٟتؠ پکان چُھ تٔمس لول برُن۔
\v 15 پرٮ۪تھ أکس پزِ یتھ کتھہِ پٮ۪ٹھ بھروسہٕ کرُن تہٕ اصٕل پٲٹھؠ یہِ مانُن: "یسوع مسیحؔ آو دنیاہس منٛز گناہ گارن نجات دِنہٕ خٲطرٕ یُتھ زن خدا تِمن تِہنٛدین گنہن ہُنٛد سزا دِیہ نہٕ۔ "یوٚت تام زن میون تعلُق چُھ، مےٚ چھِ باقین ہنٛدِ کھوٚتہٕ بدتر گناہ کٔرؠ مٕتؠ۔
\v 16 مگر یسوع مسیحؔ ہن کوٚر مےٚ پٮ۪ٹھ رحم۔ ییٚلہِ زن مےٚ باقین ہنٛدِ کھوٚتہٕ بدتر گناہ کٔرؠ متٕؠ چھِ، تٔمؠ کٔر لوٗکن ہاونہٕ خٲطرٕ میٲنؠ اکھ مثال قٲیم زِ سُہ کوتاہ صٲبِر چُھ۔ تمؠ یوٚژھ یہِ لوٗکن ہاوُن زِ یُس پتہٕ تہِ ایمان انہِ تہٕ یتھٕ پٲٹھؠ روزِ سُہ ہمیشہِ خٲطرٕ زنٛدٕ۔
\v 17 لہٰذا ؤلِو أسؠ کرو تٔمس ابدی بادشاہس احترام تہٕ تعریف، یس نہٕ کانٛہہ اکھ تہِ وُچِھتھ ہیٚکہِ تہٕ یُس نہٕ زانٛہہ تہِ مٔرِتھ ہیٚکہ! سُہ چُھ کُن خدا۔ ؤلِو أسؠ کرو تمسنٛدؠ ہمیشہِ ہمیشہِ تعریف۔ آمین!
\v 18 تیمُتھیس، ژٕ چُھکھ مےٚ أکس نیٚچوؠ سٕنٛدؠ پٲٹھؠ۔ بہٕ چُھسے ژےٚ ونان تِمہٕ کامہِ کرنہِ برابر یِمن ہنٛز پیشن گویی ژےٚ متعلق برونٛٹھے کرنہٕ آمٕژ چھےٚ۔ بہٕ چُھس یژھان زِ تِم کلام کرن ژےٚ خدایہِ سنٛز خدمت کرنس منٛز محنتہٕ سان مدد یتھٕ پٲٹھؠ اکھ سِپاہ أکس حکم دِنہٕ وٲلِس افسرس تٲبین روزِ۔
\v 19 خداوند یسوعس پٮ۪ٹھ تھاو ایمان قٲیم تہٕ تی کٔرِو یہِ توٚہؠ صحیح زانِکھ! کینٛژو لوٗکو چُھ یہِ کرُن بند کوٚرمُت تہٕ اوے کوٚر تِمو خدایس سٟتؠ پنُن رشتہٕ خراب۔
\v 20 یِمن منٛز چھِ ہمنیسؔ تہٕ سکندرؔ شٲمل۔ مےٚ ترٲوؠ تِم شیطان سنٛدین اتھن منٛز یُتھ تِمن شیطان سٕنٛدؠ دٔسؠ تکلیف واتہِ یمہِ سٟتؠ تِم ہیٚچھن زِ تِمن پزِ نہٕ خدایس توہین کرُن۔
\c 2
\p
\v 1 تِمنےٕ چیزن ہنٛدِ سببہٕ، چُھ سؠٹھاہ ضروٗری چیز یتھ پٮ۪ٹھ بہٕ سارنےٕ ایماندارن چُھس نصیحت کران زِ پرٮ۪تھ أکؠ سٕنٛدِ خٲطرٕ گژھِ ہمیشہِ خدایس دعا منگُن۔ تِمن پزِ خدایس رزق منگُن، بیٚیہِ باقین ہنٛدِ خٲطرٕ تہِ رزق منگُن، بیٚیہِ پزِ تِمن خدایہِ سنٛز شکُر گزٲری تمہِ خٲطرٕ کرٕنؠ یہِ سُہ کران چُھ۔
\v 2 تِمن پزِ بادشاہن ہنٛدِ خٲطرٕ بیٚیہِ باقین پٮ۪ٹھ حکومت کرن والیٚن ہنٛدِ خٲطرٕ تہِ دعا منگُن یُتھ أسؠ امنہٕ تہٕ اطمنانہٕ سان زندگی ہیٚکو بسر کرِتھ۔ امہِ طریقہٕ ہیٚکو ٲسؠ سۅ کٲم کرِتھ یۅسہ خدا تہٕ باقی صحیح تہٕ منٲسب سمجھان چھِ۔
\v 3 یتھٕ پٲٹھؠ دعا کرُن چُھ رُت۔ امہِ سٟتؠ چُھ خدا خوش سپدان، یُس اسہِ نجات دِوان چُھ۔
\v 4 خدا چُھ یژھان زِ سارنےٕ لوٗکن گژھِ نجات میلُن۔ سُہ چُھ یژھان زِ پرٮ۪تھ کانٛہہ گوٚژھ پوٚرٕ پٲٹھؠ پزر زانُن تہٕ تس ایمان انُن۔
\v 5 تکیازِ خدا چُھ اکھ تہٕ صرف ہیٚکہِ اکھ شخص خدایس تہٕ انسانن رلٲوتھ، سُہ چُھ یسوع مسیحؔ یُس پانہٕ تہِ انسان چُھ۔
\v 6 یمؠ پننُ پان سارنے لوٗکن ہنٛدِ خٲطرٕ چھپہِ دِیُت، تِمن گنہو تہٕ موتہٕ نِشہ بچاونہٕ باپتھ۔ تٔمؠ دِیُت پان چھپہِ منٲسب وقتس پٮ۪ٹھ تہٕ تمسنٛدؠ موتن ہوو زِ خدایہِ سُنٛد مقصد چُھ سارنے لوٗکن نجات دیُن۔
\v 7 یمہِ پٲغامُک مقصد چُھ زِ خداین چُھس بہٕ تمسنٛدِ خٲطرٕ وننہٕ باپتھ نمایندٕ مقرر کوٚرمُت۔ یقین سان چُھس بہٕ مسیحؔ سُنٛدےٕ، بہٕ چُھس پزر ونان۔ بہٕ چُھس نہٕ اپُز ونان! خداین چُھس بہٕ غٲر یہُودینؔ ہیٚچھناونہٕ خٲطرٕ سوزمُت زِ تِمن پزِ خدایہِ سنٛدِس پٔزِس پٲغامس پٮ۪ٹھ ایمان انُن۔
\v 8 اوے چُھس بہٕ یژھان زِ لوٗکھ کرن پرٮ۪تھ جایہِ، یتٮ۪ن ایمان تھٲون وٲلؠ عبادت چھِ کران خدایس کُن دُعا۔ تِمن پزِ سۅ زندگی گُذارٕنؠ یمہِ سٟتؠ خدا خوش سپدِ، کٲنسہِ سٟتؠ ناراضگی یا لڑایہِ بدلہٕ تُلن تِم پنٕنؠ اتھہٕ ہیٚور کُن تہٕ منٛگن دُعا۔
\v 9 یتھے پٲٹھؠ، ییٚلہِ عبادت خٲطرٕ جمع سپدن، زنانن پزِ حیادار تہٕ حساس لباس لاگُن۔ تِمن پزِ نہٕ پانس سجاونٕچ کوشش کرٕنؠ یا سۅنہٕ یا جوٲہرو یا قٟمتی پوشاک سٟتؠ پان سجاون۔
\v 10 تمہِ بدلہٕ پزن تِمن نیک کامہِ کرنہِ یمہٕ خٲطرٕ تِم خدایس عبادت کران چھِ۔ تِمن پزن باقے لوٗکن ہنٛدِ خٲطرٕ رٕژٕ کامہِ کرنہِ۔
\v 11 زنانن پزِ اجتماع کؠن سردارن نِشہ ژھوٚپہٕ کٔرِتھ ہیٚچُھن تہٕ روزُن ہمیشہٕ تِمن تحت۔
\v 12 مگر بہٕ چُھس نہٕ زنانن مردن تعلیم دِنُک اجازت دِوان، نَہ تِمن مردن پؠٹھ اختیار تھاونُک۔ تمہِ بدلہٕ پزِ زنانن عبادتس دوران خاموش روزُن۔
\v 13 تمیُک وجہ چُھ زِ خداین بنوو گۅڈٕ آدمؔ تہٕ تمہِ پتہٕ بنٲو تٔمؠ حواؔ، \f + \fr 2‏:13 \ft پیدٲیش 2:7، 18:24\f*
\v 14 تہٕ سرفن دِیُت نہٕ آدمس دوکھہٕ۔ تٔمؠ دِیُت زنانہِ دوکھہٕ تکیازِ تمہِ کوٚر تہِ یہِ نہٕ تس خداین کرُن ووٚنمُت اوس تہٕ سۅ سپدییہِ گناہ گار۔
\v 15 مگر تہِ کرنہٕ پتہٕ تہِ بچاوِ خدا زنانن ہرگاہ تِمن وُنہِ تہِ چھےٚ شُرین زایُن دِنٕچ دگ وٮ۪تراوٕنؠ پیٚوان، ہرگاہ تِم خدایس پٮ۪ٹھ بھروسہٕ کرن، تہٕ باقین لول برن، تہٕ روزن تِتھٕ پٲٹھؠ یمہِ سٟتؠ خدا خوش گژھِ، تہٕ سادٕ پٲٹھؠ پیش یِن۔
\c 3
\p
\v 1 پرٮ۪تھ کٲنسہِ پزِ یتھ کتھِ پٮ۪ٹھ بھروسہٕ کرُن: "ہرگاہ کانٛہہ اکھاہ ایمان والیٚن ہُنٛد سردار بننُک آرِزو کران چُھ، سُہ چُھ اکھ رٕژ کٲم کرنچؠ خٲہِش کران۔"
\v 2 تمی وجہ کِنؠ گژھِ سُہ ایمان والیٚن ہُنٛد اکھ سردار تیُتھ آسن یمِس نہٕ پزؠ پٲٹھؠ کانٛہہ اکھ تہِ ہیٚکہِ خراب کٲم کرنُک الزام کھٲلتھ۔ سُہ گژھِ پننہِ آشنہِ وفادار آسُن۔ تٔمس پزِ نہٕ ضرورت کھوٚتہٕ زیادٕ کینٛہہ کرُن۔ تٔمس پزِ عقلمندی ہنٛدیو طریقو سٟتؠ سونٛچُن۔ تٔمس پزِ اصل پٲٹھؠ برتاو کرُن۔ تٔمس پزِ مہمانن پننِس گرس منٛز خوش آوے کرٕنؠ۔ سُہ گژھِ لوٗکن تعلیم دِنس لایق آسُن۔
\v 3 سُہ گژھِ نہٕ شرٲبؠ آسُن تہٕ نَہ گژھِ لڑایہِ گوٚر آسُن۔ بلکہِ گژھِ سُہ شریف آسُن نَہ کہِ لڑٲے مٔلؠ ہیٚنہٕ وول۔ تٔمس گژھِ نہٕ پونٛسس سٟتؠ لول آسُن۔
\v 4 سُہ گژھِ اصل پٲٹھؠ پننِس عیالس واتُن۔ تمسنٛدین شُرؠن پزِ تس وفادار روزُن تہٕ تس اصل پٲٹھؠ عزت کرُن۔
\v 5 امہِ باوجود، ییٚلہِ نہٕ کٲنٛسہِ أکس مولوم چُھ زِ پنُن گرٕ پننہِ عیالٕکؠ بٲژ کِتھہٕ پٲٹھؠ گژھن سنبالٕنؠ، سُہ ہیٚکہِ نہٕ یقیناً خدایہِ سنٛدین لوٗکن ہُنٛد خیال تھٲوِتھ!
\v 6 اکھ نوو ایمان انن وول مہٕ بنٲؠ وُن ایمان والیٚن ہُنٛد سردار، تکیازِ تس ما گژھِ تکبُر۔ پتہٕ دِیہ تس خدا سُے سزا یُس تٔمؠ شیطانس دِیُت۔
\v 7 ایمان والیٚن ہنٛدس رہنماہس پزِ پانہٕ تہِ تیُتھ برتاو کرُن زِ بے دین کرن أمِس متعلق اصل کتھہٕ۔ پتہٕ کرن نہٕ لوٗکھ أمِس بدنٲمی تہٕ جانور سٕنٛدؠ پٲٹھؠ پھسہِ نہٕ شیطان سنٛدِس کُنہِ تہِ زالس منٛز۔
\v 8 یتھۓ پٲٹھؠ پزِ رہنماہن ہنٛدین خٲدمن سنٛجیدٕ تہٕ بالغ آسُن، نہ زِ دُ دلٲلؠ۔ تِم گژھن کتھ کرنہٕ وِزِ مخلص آسٕنؠ۔ تِمن پزِ نہٕ زیادٕ شراب چیٚون تہٕ تِم گژھن نہٕ پونٛسن ہنٛز زیادٕ کل آسٕنؠ۔\f + \fr 3‏:8 \ft پادرین ہندؠ مددگار۔\f*
\v 9 تِمن گژھِ ہمیشہِ تتھ پٲغامس پٮ۪ٹھ ایمان آسُن یُس خداین وۅنؠ اسہِ نِشہ ظٲہر کوٚرمُت چُھ، ییٚلہِ تِم پانس سام ہیٚن زِ خدا چُھ تمیُک تٲیید کران یہِ تِم کران چھِ۔
\v 10 مگر گۅڈٕ گژھِ تِمن مددگارن ہُنٛد برتاو رہنماہن ہنٛدؠ پٲٹھؠ آزماونہٕ یُن۔ ہرگاہ تِم کُنہِ قصور ورٲے ٲسؠ، توٚہؠ دِیو تِمن خدمت کرنہٕ۔
\v 11 یتھۓ پٲٹھؠ گژھن تِہنٛزٕ آشنہِ تہِ سنٛجیدٕ تہٕ بالغ آسنہِ، تِم گژھن نہٕ لوٗکن ہنٛز بدنٲمی کرنؠ تہٕ تِمن پزِ اعتدال خٲطرٕ پرٛتھ کانٛہہ کٲم کرٕنؠ۔ تمن پزِ پرٮ۪تھ تتھ کامہِ پٮ۪ٹھ بھروسہٕ منٛد آسُن یۅسہ تِم کران چھِ۔
\v 12 کلیسُک اکھ مددگار گژھِ پننہِ زنانہِ ہُنٛد وفادار آسُن تہٕ سُہ گژھِ پننِس گرس منٛز پننؠن شُرین تہٕ باقی نفرن ہُنٛد اصل پٲٹھؠ تھاون تہٕ تِمن راہنمٲییٔ کرُن۔
\v 13 یِم خٲدِم لگاتار امی طریقہٕ خدمت کرن لوٗکھ کرن تِمن عزت تہٕ تِم ہیٚچھن یسوع مسیحؔ ہس متعلق ہٮ۪متہٕ سان کتھ کرٕنؠ یتھ پؠٹھ تِمن ایمان آسہ۔
\v 14 مےٚ چھےٚ امید زِ بہٕ واتہٕ توٚہہِ نِشہ جلد۔ مگر وۅنؠ چُھس بہٕ توٚہہِ یِم کتھہٕ لیٚکھان
\v 15 زِ ہرگاہ مےٚ ژیر لوٚگ۔ بہٕ چُھس یژھان زِ توٚہؠ زانِو زِ ایمان والیٚن کِتھہٕ پٲٹھؠ پزِ کلیسس منٛز برتاو کرُن، یہِ چھےٚ سۅ جماتھ یِمن یسوع ہس تہٕ زندٕ خدایس پٮ۪ٹھ ایمان چُھ۔ اتھ جمٲژ سٟتؠ وابستہٕ لوٗکن چُھ ایمان تہٕ پزِ شیٚچھِ ہنٛز تعلیم چھِ دِوان۔
\v 16 تہٕ پرٮ۪تھ أکس پزِ مانُن زِ خداین یُس پوٚز کلام اسہِ نِشہ ظٲہر کوٚرمُت چُھ سُہ چُھ حٲرت انگیز:
\q "مسیحؔ اوس خدایہ یُس انسان سنٛدِس جسمس اندر دنیاہس آو۔
\q پاک روحن کوٚر ثٲبت زِ سُہ اوس پننِس دعواہس منز صیحی۔
\q خدایہِ سٕنٛدیو شیٚچھِ والیٚو وُچھ سُہ۔
\q ایمان تھٲون والیو کوٚر تمسٕنٛدِس قومن منٛز تمؠ سُنٛد اعلان۔
\q دنیاہ کیٚو واریہو جایو پٮ۪ٹھٕ اوٚن تس پٮ۪ٹھ لوٗکو ایمان۔
\q خداین نیٚو سُہ پننہِ طاقتہٕ سٟتؠ آسمانس منٛز پانس نِش۔"
\c 4
\p
\v 1 وۅنؠ چُھ خدایہِ سُنٛد روح اسہِ صاف پٲٹھؠ ونان زِ ینہٕ وٲلِس زمانس منٛز ہین کینٛہہ لوٗکھ یسوع سنٛدِس پٔزِس کلامس پؠٹھ ایمان اننہٕ نِشہ پوٚت۔ تِم تھاوین بدروحن ہنٛدِس کن یِم لوکن دۅکھٕ دِوان چھِ بیٚیہِ تِمن اپزین کتھن یمِچ یِم بدروح تعلیم دِین۔
\v 2 بدروح چھِ یِم چیز تِمن لوٗکن ہنٛدؠ دٔسؠ ہیٚچھِ ناوان یِم اپُز ونان چھِ صرف یہِ کرنُک بہانہٕ کران زِ یہِ چُھ صحیح۔ یِمن لوٗکن چُھنہٕ جرُم باسان ییٚلہِ تِم اپٕزؠ چیز ہیٚچھِ ناوان چھِ۔
\v 3 تِم چھِ لوٗکن خاندر کرنہٕ نشہٕ رُکاوان۔ تِم چھِ تِمن ونان زِ تِمن پزِ خاص قسمٕکؠ غذا کھؠنہٕ نِشہ پرہیز کرُن مگر خداین کٔرؠ تِم غذا سانہٕ خٲطرٕ پٲدٕ یمہِ خٲطرٕ ٲسؠ تمؠ سنٛز شکُرگُذٲری کرو۔ تٔمؠ کٔرؠ یِم سانہِ خٲطرٕ پٲدٕ یِم تمِس پٮ۪ٹھ ایمان تھاون وٲلؠ تہٕ پوٚز زانن وٲلؠ چھِ۔\f + \fr 4‏:3 \ft پیدٲیش 1:31\f*
\v 4 خداین چُھ پرٮ۪تھ کانٛہہ چیز رُت بنوومُت۔ کانٛہہ تہِ غذا چُھ قبول کرنس لایق ہرگاہ ٲسؠ کھیٚنہٕ وِزِ خدایہِ سنٛز شکُر گُذٲری کرو۔
\v 5 ییٚلہِ ٲسؠ خدایس دعا مونٛگو تہٕ تمسٕنٛدِس کلامس پٮ۪ٹھ یقین کرو، زِ سُہ پریتھ کانٛہہ چیز چُھ رُت یُس تٔمؠ پٲدٕ کوٚر، پتہٕ چُھ سُہ غذا یُس أسؠ کھیوان چھِ تمس قٲبلِ قبول۔
\v 6 ہرگاہ ژےٚ پننؠن ایمان والیٚن باین روزکھ تعلیم دِوان، ژٕ آسکھ اصٕل پٲٹھؠ یسوع مسیحؔ سنٛز خدمت کران۔ چون روحٲنی طاقت سپدِ مضبوط یوٗت ژےٕ تتھ پٔزِس کلامس پٮ۪ٹھ عمل کرکھ یتھ پٮ۪ٹھ اسہِ سارنےٕ ایمان چُھ۔ سُہ پوٚز کلام چُھ سۅ رٕژ تعلیم یتھ پٮ۪ٹھ ژٕ عمل کران چُھکھ رودمُت۔
\v 7 مگر ژےٚ چھے نہٕ بیکار تہٕ بے ہوٗدٕ دلیلن سٟتؠ کانٛہہ کٲم۔ تمہِ بدلہٕ بناو پنُن پان تِم کامہِ کرنس لایق یِمو سٟتؠ خدا خوش سپدِ۔
\v 8 یاد تھاو "پننِس جسمس تربیت دِنہٕ سٟتؠ چُھے ژےٚ اکھ رٔژھا مدد میلان، مگر تِمہٕ کامہِ ہیٚچھنہٕ سٟتؠ میلی ژےٚ پرٮ۪تھ اندٕ مدد یِم خدایس خوش کرن۔ یہِ چُھ تُہنٛدِ خٲطرٕ جان، ییٚلہِ توٚہؠ زمینس پٮ۪ٹھ تہِ زنٛدٕ ٲسِو تہٕ ییٚلہِ یِنہٕ کالس منٛز خدایس سٟتؠ تہِ زنٛدٕ روزیٚو"
\v 9 پرٮ۪تھ أکس پزِ یتھ کتھِ پٮ۪ٹھ بھروسہٕ کرُن بیٚیہِ مکمل پٲٹھؠ مانُن۔
\v 10 اوے چھِ أسؠ تیژھا محنت کرن ییژاہ أسؠ ہیٚکو، تکیازِ اسہِ چھےٚ پوٗرٕ پٲٹھؠ امید زِ زندٕ خدا کرِ تِم کامہِ یِمن ہُنٛد تٔمؠ وعدٕ چُھ دِیتمُت۔ سُہ چُھ سارنےٕ انسانن نجات دِنہٕ وول، مگر خاص پٲٹھؠ تِمن نجات دِنہٕ وول یِمن تمِس پٮ۪ٹھ ایمان چُھ۔
\v 11 ایمان تھاون والیٚن دِ یِمن چیزن متعلق تعلیم تہٕ یِم کامہِ کرنُک کرکھ تٲکید۔
\v 12 کٲنسہِ مٕہ دِ یہِ وننُک موقعہ زِ ژٕ چھُکھ نہٕ مُجراہ سےٕ تکیازِ ژٕ چھُکھ جوان۔ تمہِ بدلہٕ ہاو باقے سٲتھین زِ زندگی کِتھٕ پٲٹھؠ چھےٚ گزارٕنؠ۔ تِمن ہاو یہِ پننہِ کلامہٕ سٟتؠ، برتاوٕ سٟتؠ، لولہٕ سٟتؠ، خدایس پٮ۪ٹھ پننہِ بھروسہٕ سٟتؠ تہٕ پننہِ جنسی پٲکیزگی سٟتؠ۔
\v 13 یوٚت تام بہٕ ژےٚ نِشہ واپس واتہٕ ژٕ تھاو ایمان تھٲون والیٚن برونٛہہ کنہِ، ییٚلہِ توٚہؠ سمان ٲسِو، صحیفہٕ پرٕنؠ جٲری، صحیفن ہنٛز تعلیم دِنؠ تہٕ تِمن پٮ۪ٹھ عمل کرناونٕچ گُزٲرش کرٕنؠ جٲری۔
\v 14 سۅ نعمت کر یقینہٕ سان استعمال یوسہٕ ژےٚ حٲصل چُھے، یس ژےٚ خداین تمہِ ساعتہٕ بخشی ییٚلہ کلیسیا کیٚو زٹھیو ژےٚ پننٕؠ اتھٕ ڈٲلی تہٕ ونہے ژےٚ زِ خداین کیاہ چُھ چانہِ باپت تِمن پؠٹھ ظٲہر کوٚرمُت۔
\v 15 یِمن سارنےٕ کتھن پٮ۪ٹھ کر عمل، یِمہٕ مےٚ ژےٚ کرنہٕ باپتھ وونمُت چُھۓ! یِمن چیزن پٮ۪ٹھ روز دٔرِتھ یُتھ زن چٲنؠ ترقی سارنےٕ پٮ۪ٹھ ظٲہر سپدِ۔
\v 16 پنٕنؠ تہٕ پننہِ تعلیمہ ۂنٛز تھاو خبر اتر۔ یِمہٕ کامہِ روز کران، تکیازِ یہِ کرنہٕ سٟتؠ چُھ خدا ژےٚ یوت نہٕ کینٛہہ بلکہِ تِمن تہِ نجات دِوان یِم لوٗکھ چون بوزان چھِ۔
\c 5
\p
\v 1 تمِس نفرس سٟتؠ مہٕ کر تروشرٕ سان کتھ یُس چانہِ کھوٚتہٕ زیادٕ بزرگ آسہ۔ تمہِ بدلہٕ دِیس تتھٕ پٲٹھؠ مشورٕ زنتہِ سُہ ژےٚ پنن مول آسہ۔ جوانن کر تتھٕ پٲٹھؠ نصیحت زن تہِ تِم ژےٚ باے چِھی۔
\v 2 اکھ زنان یۅسہ چانہِ نِشہ زِٹھ چھےٚ تس کر پنٕنؠ موج زٲنِتھ نصیحت تہٕ پننہِ کھوٚتہٕ کم وٲنسہِ زنانن کر پننہِ بیٚنہِ زٲنِتھ نصیحت۔ یوٚدوے ژٕ یہِ سورےٕ کرکھ ژےٚ پزی پوٗرٕ پٲٹھؠ یہِ اکہِ منٲسب طریقہٕ سٟتؠ کرُن۔
\v 3 یہِ کتھ بنٲیِو یقینی زِ جماتھ چھا پزؠ پٲٹھؠ تِمن مونڈن ہُنٛد خیال تھاوان یِمن نہٕ پزی کانٛہہ تہِ چُھنہٕ خیال تھاونہٕ باپتھ۔
\v 4 ہرگاہ کٲنسہِ موٚنڈِ آسن شُرؠ یا زُرؠ، یِمن پزِ گوٚڈٕ پنُن گرٕ سنبالُن ہیٚچھن۔ امی سٟتؠ ہیکن تِم پننِس مٲلس ماجہِ تہٕ نانہِ بٔڈؠ ببس خدمت کٔرِتھ یہِ تِمو تِہنٛدِ خٲطرٕ کوٚرمُت اوس ییٚلہِ تِم جوان ٲسؠ، تکیازِ یِمو کامیو سٟتؠ چُھ خدا خوش سپدان۔
\v 5 یۅسہ مونٛڈ پزؠ پٲٹھؠ کُنے زٔنؠ چھےٚ تہٕ سۅ چھےٚ لاچار، تس چھےٚ خدایہِ سنٛز امید۔ سۅ چھےٚ لگاتار دُعا منٛگان تہٕ سۅ چھِ روزان خدایس مدتہٕ خٲطرٕ زارٕ پارٕ کران۔\f + \fr 5‏:5 \ft یرمیاہ 49:11\f*
\v 6 مگر یۅسہ اکھ مونٛڈ پانس خوش تھاونہٕ خٲطرٕ زنٛدٕ روزان چھےٚ، سۅ چھےٚ روحٲنی ممٕژ یوٚدوے سۅ جسمٲنی وُنہِ تہِ زندٕ چھےٚ۔
\v 7 ژےٚ ہیٚچھناوُکھ تِم اصٕل پٲٹھؠ یُتھ زن نہٕ کانٛہہ اکھ ونہِ زِ ایمان تھاون وٲلؠ چھِ خراب عمل کرن۔
\v 8 ہرگاہ کانٛہہ پننؠن رشتہٕ دارن خاص کٔرِتھ پننِس گرس منٛز روزن والیٚن ہُنٛد خیال تھاوِ نہٕ تٔمؠ چُھ سُہ ایمان رد کوٚرمُت یتھ پٮ۪ٹھ اسہِ یقین چُھ۔ سُہ چُھ تمس أکس نفرٕ سٕنٛدِ کھۅتہٕ بدتر یٔمِس نہٕ مسیحؔ ہس پٮ۪ٹھ ایمان چُھ۔
\v 9 سۅے مونٛڈ گژھِ فہرستس منٛز شٲمل کرٕنؠ یۅسہ تقریباً شیٹھٕ ؤرِش آسہ۔ سۅ گژھِ پننِس رٲنِس وفادار ٲسمٕژ آسٕنؠ۔
\v 10 لوٗکھ گژھن گوٲہی دِنؠ زِ تمہِ کرِ رژٕ کامہِ، شُرؠ پٲلِن اصل پٲٹھؠ، مہمانن ٲس خوش آوے کران، ایمان تھاون والیٚن ٲس حلیمی سان خدمت کران، مصیبت زدن ٲس مدد کران تہٕ سارے قسمچہِ نیک کامہِ کرنہٕ خٲطرٕ ٲس بیتاب روزن۔
\v 11 مگر جوان مونٛڈ گژھِ نہٕ اصلی مونڈن ہنٛدس فہرستس منٛز شٲمل کرنہِ یِنؠ۔ ییٚلہِ تِمن زیادٕ خٲہشات وۅتلن، تِم گژھن مسیحؔ ہس خدمت کرنُک پنُن ارادٕ بدلاوٕنؠ تہٕ تِم چھِ دُبارٕ خٲندر یژھان کرُن۔
\v 12 ییٚلہِ تِم یہِ کرن تیلہِ چھِ تِم مونٛڈٕ روزنُک قسم پُھٹراوان تہٕ چھِ قصور وار سپدان۔
\v 13 تمہِ علاوٕ چھِ تِمہٕ بےکار روزنٕکؠ عٲدی بنان۔ تِمہٕ چھِ گرٕ گرٕ کُنہِ کامہِ ورٲے پھران لوٗکن ہنٛزٕ کتھٕ کران تہٕ باقی لوٗکن ہنٛدین مسلن منٛز مداخلت کران۔ تِم چھِ تمہِ کامہِ کران یِمنہٕ تِمن کرنہِ پزن۔
\v 14 امی خٲطرٕ چُھس بہٕ جوان مونڈن دُبارٕ خاندر کرنُک مشورٕ دِوان تہٕ شُرؠ کرن پٲدٕ۔ یِمن زنانن پزن پنٕنؠ گرٕ اصل پٲٹھؠ سنبالٕنؠ۔ امہِ طریقہٕ دِن نہٕ تِمہٕ دشمن شیطانس اکھ سُہ موقعہ یمہِ سٟتؠ تِمن غلط الزام لگہ۔
\v 15 یِمہٕ کتھٕ چُھس بہٕ امہِ سببہٕ لیٚکھان تکیازِ کینٛہہ جوان مونٛڈٕ چُھنہٕ وۅنؠ مسیحؔ سنٛز فرمانبردٲری کران، بلکہِ چھےٚ تِم شیطانس پتہٕ درامژٕ۔
\v 16 ہرگاہ کٲنٛسہِ ایمان واجنہِ زنانہِ رشتہٕ دارن منٛز مونٛڈٕ چھۓ تس پزِ تِمن مدد کرُن۔ یتھٕ پٲٹھؠ پیٚیہِ نہٕ جمٲژ پٮ۪ٹھ زیادٕ مونڈن ہُنٛد خیال تھاونُک بار۔ کلیسہٕ کرِ پتہٕ تِمن مونڈن مدد یِمہٕ پزؠ پٲٹھؠ لاچار چھےٚ۔
\v 17 ایمان والیٚن پزِ تِمن عزت تہٕ ماوضہٕ دیُن یِم تِمن اصل پٲٹھؠ وتھ ہاوان چھِ خاص پٲٹھؠ تِمن بزرگن یِم تبلیغ تہٕ تعلیم دِنس پٮ۪ٹھ پنُن زُو ژٹان چھِ۔
\v 18 أسؠ چھِ زانان زِ یہِ چُھ صحیح تکیازِ أسؠ چھِ یِمن صحیفن منٛز پران یِم موسیٰؔ ہن لیٚکھؠ: "ییٚلہِ اکھ داند پھل منٛڈان چُھ، توٚہؠ گژھیٚو نہٕ تمسُنٛد چونٛٹ بند کرٕنؠ یُتھ زن نہٕ پھل ہیٚکہِ کھیٚتھ۔ "یسوعن تہِ چُھ وونمُت، "لوٗکن پزِ تِمن ماوضہٕ ادا کرُن یِم تِمن ہنٛدِ خٲطرٕ کٲم کران چھِ۔"\f + \fr 5‏:18 \ft تثنِیہ شرع 25:4، لوقا 10:7، متہ 10:10\f*
\v 19 یُس دعویٰ أکس بزرگس خلاف آسہ دوٚیو یا ترییٚو شٲہدو ورٲے گژھِ نہٕ بوزُن۔\f + \fr 5‏:19 \ft تثنِیہ شرع 19:15 \f*
\v 20 ییٚلہِ توٚہؠ عبادت کرنہٕ باپتھ سمان ٲسِو گناہ کرن والیٚن کٔرِو سارنےٕ برونٛٹھ کنہِ درُستی یُتھ زن باقے لوٗکھ گناہ کرنس کھوٚژن۔
\v 21 بہٕ چُھس خدا تہٕ یسوع مسیحؔ تہٕ خدایہِ سٕنٛدؠ برگزیدٕ ملٲیکھ گواہ تٲرتھ یہِ باند باند کران زِ ژٕ کر تِمن ہدایتن پٮ۪ٹھ عمل یِم مےٚ ونؠ ژےٚ دِتی۔ پرٮ۪تھ معاملُک فٲصلہٕ کر منصفانہٕ پٲٹھؠ تہٕ کٲنسہِ نفرٕ سنٛز طرفدٲری مہٕ کر۔
\v 22 ایمان والیٚن ہنٛزِ جمٲژ ہند زیٹھ مقرر کرنس منٛز مہٕ کر جلدی۔ ہرگاہ سُہ گناہ کرِ، سُہ گناہ آسیٚتھ زن ژےٚ کوٚرمُت، لہٰذا مہٕ کر تہِ۔ گناہ کرنہٕ نِشہ روز لوٚب۔
\v 23 وۅنؠ مہٕ روز ژٕ صرف تریش چٮ۪وان بلکہ چےٚ کم کینژھا شربت تہِ یتھ ژٕ وقتہٕ وقتہٕ میادٕ دٲدِس راحت میلی۔\f + \fr 5‏:23 \ft یہِ شربت ٲسؠ سِوِتھ دچھِ رس کڈتھ بناونہٕ یوان تہٕ اتھ اوس نہٕ شرابُک تٲثیر آسان کینٛہہ۔\f*
\v 24 ییٚلہِ کینٛہہ لوٗکھ گناہ کران چھِ پرٮ۪تھ أکس چھےٚ خبر لگان مگر کینژن لوٗکن ہنٛدؠ گناہ چھِ پتے پہن نٔنؠ نیران۔
\v 25 یتھٕ کِنؠ چُھ لوٗکن ہنٛزٕ رٕژٕ کامہِ پرٮ۪تھ اکھ زانان مگر ییٚلہِ لوٗکھ پوشیدٕ پٲٹھؠ رٕژٕ کامہِ کرین پرٮ۪تھ أکس سپدِ مولوم پتے پہن۔
\c 6
\p
\v 1 سارنےٕ ایمان تھاون والیٚن غلامن پزِ پننؠن مٲلکن پرٮ۪تھ رنگہٕ احترام کرُن۔ پتہٕ ییہِ نہٕ لوٗکن خدایس متعلق یا تِمن کتھن متعلق یِمہٕ أسؠ ہیٚچھِ ناوان چھِ بُرٕ کتھ وننُک کانٛہہ تہِ وار۔
\v 2 بیٚیہِ، یِمن غلامن ہنٛدین مٲلکن مسیحؔ ہس پٮ۪ٹھ ایمان چُھ تِمن پزِ نہٕ تِمن مٲلکن بے عزتی کرٕنؠ تکیازِ تِم چھِ تِمن ہنٛدؠ ایمان رنگؠ بٲے۔ تمہِ بدلہٕ پزِ تِمن پننؠن مٲلکن ہناہ زیادے پہن خدمت کرٕنؠ تکیازِ تِم چھِ پننہِ کامہِ سٟتؠ مسیحیؔ باین فٲیدٕ واتناوان تہٕ خدا چُھ تِمن لول بران۔ سانؠن لوٗکن دِیو یِمن کتھن ہنٛز تعلیم تہٕ یِمن پٮ۪ٹھ عمل کرنچؠ کٔرِو تِمن گُزارش۔
\v 3 کینٛہہ لوٗکھ چھِ اپزِ کتھٕ ہیٚچھناون۔ تِم چھِنہٕ سٲنس خداوند یسوع مسیحؔ ہس متعلق قٲبلِ بھروسہٕ پٲغام مانان۔ تِم چھِنہٕ سۅ زندگی بسر کرنٕچؠ تعلیم مانان یمہِ سٟتؠ خدا خوش سپدان چُھ۔
\v 4 یِمن لوٗکن چُھ گُمنڈ، مگر تِمن چھنہٕ کانٛہہ کتھ فِکرے تران۔ تمہ بجایہ چھِ تِم پھٲترن ہنٛدؠ پٲٹھؠ غٲر ضروٗری معاملن تہٕ کینٛژن لفظن متعلق بحث کران۔ تِہنٛد برتاو چُھ تِمن باقے لوٗکن حسدی بناون۔ تِم چھِ لوٗکن سٟتؠ جھگڑٕ کران، تِم چھِ لوٗکن متعلق بُرٕ کتھٕ ونان، تِمن چھےٚ بد گمٲنی گژھان۔
\v 5 تِم چھِ لگاتار باقے لوٗکن سٟتؠ ۂر کران۔ تِہنٛدِ سونٛچنہ کیٚو ساروےٕ طریقو چھِ تِم پورٕ پٲٹھؠ غلط بنیمٕت۔ تِمو چھِ اصلی تعلیم پتھ کُن ترٲومٕژ۔ تمیُک نتیجہِ چُھ یہِ زِ تِم چھِ سمجھان زِ خدا پرستی گییہِ دولت جمع کرٕنؠ۔
\v 6 مگر اسہِ چُھ بوٚڈ فٲیدٕ حٲصل سپدان ییٚلہِ أسؠ خدایہِ سنٛدٮ۪ن طریقن پٮ۪ٹھ پننٕؠ زندگی گزارو تہٕ ییٚلہِ أسؠ تتھ پٮ۪ٹھ چھِ مطمئن یہِ اسہِ نِشہ چُھ۔
\v 7 یہِ چُھ پوٚز تکیازِ اسہِ اوٚن نہٕ پانس سٟتؠ یتھ دنیاہس منٛز کانٛہہ چیز ییٚلہِ أسؠ پٲدٕ گَے تہٕ أسؠ نِمو نہٕ کانٛہہ چیز امہِ منٛزٕ ییٚلہِ أسؠ دنیا منٛزٕ نیرو۔\f + \fr 6‏:7 \ft ایوب 1:21، زبور 49:17\f*
\v 8 لہٰذا اگر اسہِ غذا تہٕ پلو آسن، اسہِ پزِ یِمو چیزو سٟتؠ مطمئن روزُن۔
\v 9 مگر کینژن لوٗکن چُھ امیٖر بننُک زبردس تمناہ آسان۔ توے چھِ تِم دولت حٲصل کرنہٕ بٲپتھ غلط کامہِ کران۔ پتہٕ چھِ تِمن خراب واقہٕ پیش یوان یِمن منٛز تِم پٔھسِتھ روزان چھِ۔ تِم چھِ نادٲنی سٟتؠ واریہن چیزن ہُنٛد تمناہ کران یِمو سٟتؠ دوکھہٕ لگان چُھ، تہٕ ٲخرس پٮ۪ٹھ، چھِ یمَے چیز تِمن برباد کران۔\f + \fr 6‏:9 \ft امثال 23:4، 15:27\f*
\v 10 ژٕ چُھکھ وُچھان، لوٗکھ چھِ تمام قسمٕچہ بُرٲییہِ کران ییٚلہِ تِمن پونٛسہٕ حٲصل کرنُک زبردس تمناہ آسان چُھ۔ کینٛژو لوٗکو کوٚر دولت حٲصل کرنُک آرِزو شروع تہٕ یسوعس پتہٕ پتہٕ پکُن ترووُکھ۔ یہِ کرنہٕ سٟتؠ کوٚر تِمو پنُن پان واریہو اندو پریشان۔
\v 11 مگر، ژےٚ أکس خدایہِ سنٛز خدمت کرن وٲلِس ہوِس نفرس پزِ یِمو بُرٕ کامیٚو نشہٕ لوٚب روزُن۔ بلکہِ پانہٕ فٲصلہٕ کرُن زِ کۅس جان کٲم ییہِ کرنہٕ تہٕ ژٕ کرکھ پنٕنؠ زندگی خدایس خوش کرنہٕ باپتھ بسر۔ خدایس پٮ۪ٹھ کر بھروسہٕ تہٕ باقین بر لول۔ یِم تکلیف ژےٚ واتان چھی تِمن پٮ۪ٹھ کر صبر۔ لوٗکن سٟتؠ یہِ شرافتہٕ سان پیش۔
\v 12 یتھ پٮ۪ٹھ ژےٚ ایمان چھُے تٔمی مطٲبق کر پنٕنؠ زندگی سنٛجیدگی سان بسر، یہِ زٲنتھ زِ یہِ کٲم چھےٚ کرنہٕ باپتھ رٕژ۔ بھروسہٕ دِ زِ ژےٚ چُھو ابدی زندگی ہُنٛد انعام، خداین ژورُکھ ژٕ اوے امہِ خٲطرٕ ییٚلہِ ژٕ واریہن گواہ ہن برونٛہہ کنہِ کھُلہٕ پٲٹھؠ دعوا کرکھ زِ ژےٚ چھی مسیحؔ ہس پٮ۪ٹھ ایمان۔
\v 13 أسؠ چھِ خدایہِ سنٛزن نظرن تل یُس سارنےٕ چیزن زندگی بخشن وول چُھ۔ أسؠ چھِ یسوع مسیحؔ سنٛزن نظرن تل یمؠ پنطیس، پیلاطسؔ برونٛہہ کنہِ عدالتس منٛز دلیری سان اعلان کوٚر یہِ پزر اوس۔ تہنٛزِ موجودگی منٛز چُھسے بہٕ ژےٚ یہِ حکم دِوان:
\v 14 تِمن حکمن ہنٛز کر فرمانبردٲری یِم مسیحؔ ہن اسہِ دِتمٕتؠ چھِ۔ کانٛہہ غلط کٲم مہٕ کر۔ امہِ سٟتؠ روزِ نہٕ ژےٚ تنقید کرنُک کٲنسہِ أکس تہِ طاقت۔ توٚت تام کٔرِو فرمانبردٲری یوٚت تام خداوند یسوع مسیحؔ سُنٛد ظہور دُبارٕ سپدِ۔
\v 15 خدا انہِ یسوعس منٲسب وقتس پٮ۪ٹھ واپس۔ أسؠ چھِ خدایہِ سٕنٛدؠ تعریف کران یُس کُنے حکمران چُھ! سُہ چُھ سارنےٕ بادشاہن ہُنٛد بادشاہ تہٕ سارنےٕ خداوندن ہُنٛد خداوند!
\v 16 خدا چُھ کُنے یُس نہٕ زانٛہہ مَرِ۔ سُہ چُھ آسمانس منٛز گاشش منٛز روزان زِ تیوٚت چمکہٕ ووٚن زِ تس تام واتہِ نہٕ کانٛہہ اکھ تہِ! سُہ چُھ سُہ ذاتھ یِس نہٕ زانہہ کٲلؠ کٲنسہِ وُچھمُت چُھ یمِس نہٕ کانٛہہ وچھتھ ہیٚکہِ! میٲنؠ خٲہِش چھےٚ زِ سٲری لوٗکھ کرن تس احترام تہٕ تمؠ سنٛز بادشٲہی روزِن تا ابد قٲیم! آمین!\f + \fr 6‏:16 \ft 1 تیموتھیس 1:17\f*
\v 17 یمہِ دنیاہ کؠن أزؠ کیٚن ایمان والیٚن دولت مندن ؤنِو زِ تِمن پزِ نہٕ مغرور سپدُن۔ تِمن پزِ نہٕ پننِس دولتس پٮ۪ٹھ بھروسہٕ کرُن تکیازِ تِم ہیٚکن نہٕ یقین کٔرِتھ زِ یہِ کوٚت تام پوشہِ تِمن۔ تِمن ون تمہِ بدلہٕ کٔرِیو خدایس پٮ۪ٹھ بھروسہٕ۔ سُہ چُھ سُہ کُنےٕ یُس اسہِ بےحساب پرٮ۪تھ کانٛہہ چیز دِوان چُھ تہٕ سُہ چُھ یژھان اسہِ امیُک لُطف تلُن۔\f + \fr 6‏:17 \ft زبور 62:10\f*
\v 18 یِمن ایمان والیٚن دولت مندن ؤنِو رٕژٕ کامہِ کٔرِو۔ واریاہ دولت جمع کرنہٕ بدلہٕ پزن تِمن واریاہ رٕژٕ کامہِ کرنہِ۔ تِم گژھن فراغ دل آسٕنؠ تہٕ سخاوت کرنہٕ باپتھ گژھن رٲزی آسن۔
\v 19 تِم ہرگاہ تہِ کرن، یہِ آسہ زنتہِ آسمانس پٮ۪ٹھ پننہِ یِنہٕ واجنہِ زندگی خٲطرٕ واریاہ رٕتؠ چیز ذخیرٕ کرن۔ یِمہٕ سارے رٕژٕ کامہِ کرنہٕ پتہٕ سپدن تِم تٔمہِ زندگی ہنٛدِ خٲطرٕ تیار یۅسہ خدا اسہِ یژھان چُھ گزارٕنؠ یۅسہ اصلی زندگی چھےٚ
\v 20 تیمُتھیس، خداین یُس پوٚز پٲغام ژےٚ عطا کوٚرمُت چھُے تتھ کر حفاطت۔ تِمو لوٗکو نشہٕ روز لوٚب یِم ژےٚ سٟتؠ تِمہٕ کتھہٕ کرنہِ یژھان چھِ یِمہٕ خدایس نِشہ غٲر ضروری چھےٚ۔ بیٚیہِ روز اپٕزؠ یارٮ۪ن نِشہ دوٗر یِم پوٚز علم تھاونُک دعوا کران چھِ مگر تِم چھِ تِمہٕ کتھہٕ کران یِمہٕ سانہِ پزِ تعلیمہ خلاف چھےٚ۔
\v 21 یِمن کتھن پٮ۪ٹھ کوٚر کینٛژو لوٗکو یقین تہٕ خدایس متلق پزرس پٮ۪ٹھ ایمان تھاونس منٛز ڈٔلؠ۔ خدا روزِن توٚہہِ سارنےٕ مہربان۔
