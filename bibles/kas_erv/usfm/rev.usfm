\id REV - DMT Kashmiri
\toc1 مکاشفہ
\mt1 مکاشفہ
\c 1
\p
\v 1 یہ کتاب چھےٚ تِمن چیزن متعلق یم یسوعؔ مسیحنؔ مےٚ، یوحناؔ ہس ہٲوؠ خداین کٔرؠ یِم چیز یسوعسؔ پیٚٹھ ظٲہِر یُتھ سُہ تِم پنٮ۪ن خٲدمن تام واتناوِ۔ یِم چیز سپدن جلدےٕ واقعہٕ، پنُن فرشتہٕ مےٚ پننِس خٲدِم یوحناہسؔ نِش سوزِتھ، واتناوِ تمؠ یمہٕ کتھٕ مےٚ تام یُس وفادٲری سان تمسنٛز خدمت کران اوس۔ \f + \fr 1‏:1 \ft مکاشفہ 22:6 \f*
\v 2 اکِس گواہ سنٛدِ رنٛگؠ چُھس بہٕ، یوحناؔ تمہِ پرٛتھ کُنہِ چیزٕچ خبر واتناوان یمہٕ مےٚ خدایہ سنٛدِس کلامس متعلق تہٕ تِمن پزٮ۪ن بیانن متعلق دنہٕ آے یمہٕ مےٚ وُچھ تہٕ بوزؠ مسیحس نِش۔
\v 3 خدا ورتاوِ تمِس کانٛسہِ تہِ شخصس سٟتؠ رُت یُس یہ کلام پرِ تہٕ بییہِ تمِس سٟتؠ یُس یہ تمہِ ساعتہٕ بوزِ ییٚلہِ یہ تھدِ پرنہٕ ییہِ۔ سُہ ورتاوِ تِمن سٟتؠ رٕژر یمہٕ حٮ۪سہٕ سان اتھ کن تھاون تہٕ اتھ تمہِ ساعتہٕ پٲروی کرن ییٚلہ یِم سٲری چیز واقع سپدن یُس جلدےٕ نزدیک یوان چُھ۔
\v 4 بہٕ، یوحناؔ چُھس آسیہ صوبہٕ کٮ۪ن ستن ایمان واجنیٚن جمٲژن یہ کتھ لیٚکھان۔ خدا روزِنؠ توٚہہِ پیٚٹھ مہربان تہٕ توٚہہِ دینو بٲطنی امن۔ خدا چُھ موجود سُہ اوس ہمیشہٕ موجود، تہٕ سُہ ییہِ آینٛدٕ ضرور تہٕ کرِ پرٛتھ أکؠ سُنٛد فٲصلہٕ۔ خدایہ سنٛدِس تختس برونٛہہ کنہِ موجود ستھ روح تہِ روزن توٚہہِ پیٚٹھ مہربان تہٕ توٚہہِ بنٲوِن پُر امن۔ \f + \fr 1‏:4 \ft ایشیا اوس رومی صوبہٕ یُس وۅنؠ جنوب مغربی ترکی منٛز چھُ۔ \f*
\v 5 یسوعؔ مسیحؔ تہِ روزِنؠ توٚہہِ پیٚٹھ مہربان تہٕ بنٲوؠ نو پُر امن۔ تمؠ ووٚن اسہِ خدایہ سُنٛد پٲغام بہتر پٲٹھؠ۔ سُہ چُھ گۅڈنیُک شخص یُس خداین مرنہٕ پتہٕ دوبارٕ زندٕ کوٚر۔ سُے چُھ یُس دنیا کٮ۪ن بادشاہن پیٚٹھ حکومت کران چُھ۔ تکیازِ سُہ چُھ اسہِ سٟتؠ لول ورتاوان، تہٕ تمؠ ژُھن سانٮ۪ن گناہن ہُنٛد تحریر نُہنٲوِتھ سانہِ باپتھ پنُن خوٗن دِتھ، ییٚلہ تٔمؠ صلیبس پیٚٹھ زُوو دیُت۔ \f + \fr 1‏:5 \ft پننہِ قربانی ہنٛدِ وجہ کٔرؠ أسؠ تمؠ پننیٚو گنہو نِشہٕ آزاد۔ \f*\f + \fr 1‏:5 \ft کلسیوں 1:8\f*
\v 6 یسوعؔ چُھ سُہ یمؠ أسؠ تِتھؠ لوٗکھ بنٲوؠ یِمن پیٚٹھ خدا حکمرٲنی کران چُھ۔ تمؠ بنٲوؠ أسؠ کاہن تہِ یمہٕ خدایہ سنٛز خدمت کران چھِ، یُس یسوع سُنٛد بب چُھ۔ لوٗکھ پٔرِن یسوعؔ سنٛز تسبیح تہٕ تمِس کرِن ہمیشہٕ باپتھ پنُن حکمران تسلیم۔ یی سپدِن!\f + \fr 1‏:6 \ft خروج 19:6، یشعیا 61:6\f*
\v 7 دِیو نظر! یسوعؔ چُھ آسمانہٕ پیٚٹھٕ اُبرٕ منٛزؠ ینہٕ وول۔ پرٛتھ کانٛہہ وُچھِ تمِس، تِمو لوٗکو سان یمو سُہ صلیبس پیٚٹھ کِلؠ ٹھٲسِتھ قتٕل کوٚر۔ زمیٖنس پیٚٹھ آسہِ پرٛتھ کانٛہہ قبیلہٕ غمگین تہٕ دۅکھٕ زد ییٚلہِ تِم أمِس شخصس یوان وُچھن، یوٚہے چُھ پزر!\f + \fr 1‏:7 \ft زکر 12:10\f*
\v 8 خداوند خدا چُھ فرماوان: " بےٕ چُھس سُہ یمؠ سٲری چیز شُروع کٔرؠ۔ تہٕ بےٕ چُھس سُہ یُس سارنی چیزن انٛد واتناونُک سبب بنہِ یعنی۔ بہٕ چُھس سُہ یُس موجود چُھ، یُس ہمیشہٕ موجود اوس تہٕ یُس ہمیشہٕ پٲٹھؠ موجود اوس، تہٕ یُس یِنہٕ کالس منٛز ییہِ تہٕ پرٛتھ کٲنٛسہِ ہُنٛد انصاف کرِ۔ بےٕ چُھس سُہ یُس پرٛتھ کُنہِ چیزس تہٕ پرٛتھ کانٛسہِ پیٚٹھ حکمرٲنی کران چُھ"\f + \fr 1‏:8 \ft یشعیا \f*\f + \fr 1‏:8 \ft مکاشفہ 22:13، یشعیا 41:4، 44:6\f*
\v 9 بہٕ، یوحناؔ چُھس یسوعسؔ پیٚٹھ ایمان انان یتھ کنؠ توٚہؠ انان چُھو۔ تُہنٛدی پٲٹھؠ چُھس بتہِ صبرٕ سان تمہٕ مصیبت برداش کران یمہٕ پرٛتھ کانٛسہِ تُلٕنؠ چھِ پیٚوان یمسنٛزِ زندگی پیٚٹھ یسوعؔ حکومت کران چُھ۔ رومی حکومتن تھووُس بہٕ اوٕ کِنؠ جلایہِ وطنی منٛز پاٹموس جزیرس پیٚٹھ تکیازِ بہٕ اوسُس لوٗکن خدایہ سُنٛد پٲغام ونان زِ یسوعؔ کُس چُھ۔
\v 10 یہ ٲس آتھوار یمہِ دوٚہہ ایمان وٲلؠ عبادت خٲطرٕ جمع سپدان چھِ، تکیازِ خداین کوٚر تمہِ دوٚہہ یسوعؔ دوبارٕ زندٕ۔ پاک روحن کوٚرس بہٕ آمادٕ یُتھ بہٕ رویا ہس منٛز وُچِھتھ کینٛہہ چیز بوزٕ۔ مےٚ وُچھ مےٚ پتہٕ کنہِ اوس کُستام ونان۔ تمسنٛز آواز ٲس تیٖژ بڈِ زنتہٕ ترے وزان ٲس۔
\v 11 تٔمؠ شخصن ووٚن مےٚ، "یہ کینٛژھا ژٕ یتھ طُمارس پیٚٹھ وُچھان چُھکھ یہ لیٚکھ تہٕ یہ ژےٚ لیٚوکُھتھ یہ واتناو ایمان والیٚن ہنٛزن ستن جمٲژن تام۔ بییہِ واتناو افسس، سمُرنہ، پرگُمن، تھواتیرہؔ، سردیس، فِلدلفیہؔ تہٕ لودیہ کہ شہرن ہنٛدین ایمان والیٚن نِش"
\v 12 ییٚلہ مےٚ یہ آواز بوز تہٕ مےٚ دِژ پتھ کُن نظر یہ کُس چُھ مےٚ سٟتؠ کتھٕ کران۔ پتھ کُن پھیرِتھ وُچھِم اتہِ ستھ سۅنہٕ سنٛدؠ ژٲنگؠ تار۔
\v 13 ستن ژٲنگؠ تارن منٛزباگ وُچھ مےٚ آدمؔ سُنٛد گوبر۔ تمِس ٲس اکھ زیٹھ ژادر ؤلِتھ یۅسہٕ تس کھۅرن تام وٲژمٕژ ٲس، تمِس ٲس سینس پیٚٹھ سُنہرؠ رنٛگہٕ کپرٕچ اکھ پٔٹ تہِ گنٛڈِتھ۔ \f + \fr 1‏:13 \ft دانی ایل 7:13، عزرا 1:26\f*
\v 14 تمسنٛدِ کلُک مس اوس سفید ییرٕکؠ نتہٕ سفید شینٕکؠ پٲٹھؠ چمکان۔ تمسنٛزٕ أچھ آسہٕ نارٕ مشالہِ ہشہٕ روشن۔ \f + \fr 1‏:14 \ft دانی ایل 7:9، 10:6\f*
\v 15 تمسنٛدؠ کھۅر ٲسؠ صاف سرتلہِ ہی پرٮ۪زلان زن ٲسؠ نارٕ بچھِ منٛزٕ صاف کرنہٕ آمٕتؠ۔ ییٚلہ تٔمؠ کلام کوٚر، تمسنٛز گرٮ۪زوٕنؠ آواز ٲس وسہٕ ونہِ بڈِ دریاوٕکؠ پٲٹھؠ گرٮ۪زان۔ \f + \fr 1‏:15 \ft عزار 1:7، 43:2\f*
\v 16 سُہ، یُس اکھ انسان ہیٚو باسان اوس، ٲسِس پننِس دٔچھنِس اتھس منٛز ستھ تارک رٹِتھ تھٲمٕتؠ، دُودار واجِنؠ تیز تلوار ٲس تمسنٛدِ ٲسہٕ منزٕ نیران۔ تٔمسُنٛد بُتھ اوس تِتھ کنؠ چمکان زنتہٕ دوپہرُک آفتاب روشن اوس۔ \f + \fr 1‏:16 \ft متی 17:2، مکاشفہ 19:15\f*
\v 17 ییٚلہِ مےٚ سُہ وُچھ تہٕ بہٕ پیوس تس برُونٛہہ کنہِ سجدس منٛز، تہٕ گوس تیوت مغلوب زِ بہٕ ہیٚوکُس نہٕ حرکت تہِ کٔرِتھ۔ مگر تٔمؠ تھوو پنُن دٔچُھن اتھٕ مےٚ پیٚٹھ تہٕ لوٚگ مےٚ وننہِ، "کھۅژ مہٕ! بےٕ چُھس سُہ اکھ یمؠ تمام چیز پٲدٕ کٔرؠ تہٕ بےٕ چُھس سُہ یُس سٲری چیز ختم کرن وول چُھ۔ \f + \fr 1‏:17 \ft یشعیا 44:6، دانی ایل 8:17\f*
\v 18 بہٕ چُھس ہمیشہٕ باپتھ زندٕ۔ ییٚلہ بہٕ دھرتی پیٚٹھ آس، تہٕ بہٕ مودُس، مگر ووٚنؠ چُھس بہٕ یقینی طور ہمیشہٕ خٲطرٕ زنٛدٕ۔ مےٚ چُھ پانس یہ اختیار زِ یُس مودمُت آسہِ سُہ کرن بہٕ دوبارٕ زنٛدٕ۔ \f + \fr 1‏:18 \ft رومؔ 6:9، 14:9\f*
\v 19 بس یُس یہ رویا یتھ منٛز ژٕ مےٚ وُچھان چُھکھ تھاو لیٚکِھتھ۔ بہٕ کرے ژےٚ پیٚٹھ پزرُک اِظہار زِ وُنہ کٮ۪ن کیاہ چُھ سپدان تہٕ آینٛدٕ کیاہ سپدِ۔ بہٕ چُھس یژھان زِ ژٕ لیٚکھکھ تمہٕ چیز تہِ۔
\v 20 بہٕ کرے ژٕ تِمن ستن تارکن ہُنٛد علامتی معنی تہِ بیان یمہٕ ژےٚ مینِس دٔچھنِس اتھس کٮ۪تھ وُچھتھکھ تہٕ سۅنہٕ سنٛدؠ ستھ ژٲنگؠ تار۔ ستھ تارک چھِ ایمان والیٚن ہنٛدین ستن جمٲژن ہنٛدین فرشتن کُن اِشارٕ کران تہٕ ستھ سۅنہٕ سنٛدؠ ژٲنگؠ تار چھِ ستن ایمان والیٚن ہنٛزن جمٲژن کُن اِشارٕ:
\c 2
\p
\v 1 لیٚکھ یہ پٲغام افسس شہرس منٛز روزن والیٚن ایمان واجنہِ جمٲژ ہنٛدِس فرشتس: " بہٕ چُھس سُہ اکھ یُس پننِس دٔچھنِس اتھس منٛز ستھ تارک رٔٹِتھ چُھ تہٕ یُس سۅنہٕ سنٛدین ستن ژانٛگیٚن منٛزباگ پکان چُھ۔ بہٕ چُھسے ژےٚ یہ ونان:
\v 2 "بہٕ چُھس چانٮ۪ن سارنی کامٮ۪ن وٲقف، ژےٚ کٲژاہ محنت کرتھ میانہٕ خٲطرٕ۔ بہٕ چُھس زانان زِ ژےٚ کِتھٕ کنؠ کٔرِتھ صبرٕ سان مشکِل وقت برداش۔ مےٚ چُھ یتہِ معلوم زِ ژٕ چھہکھ نہٕ بدکار لوٗکھ قبول کران۔ ییٚلہِ لوٗکھ اپٕزؠ دعوا کران چھِ زِ تِم چھِ حقیقی رہنما، ژٕ چھُکھ ثٲبت کران زِ تِم چھِ اپُز ونان۔
\v 3 بہٕ چُھس زانان زِ ژےٚ کوتاہ ژولُتھ صبٕر سان۔ بہٕ چُھس یتہِ زانان زِ ژےٚ تلُتھ میانہِ باپتھ دۅکھ تہٕ یہِ ویٚتراونہٕ باوجود تہِ ترٲوٕتھ نہٕ ژےٚ میانس دامنس تھف یلہٕ۔
\v 4 امہِ باوجود تہِ چھےٚ مےٚ توٚہہ سٟتؠ یہ شکایت زِ ژٕ چُھکھ نہٕ ووٚنؠ مےٚ سٟتؠ تِتھ کٔنؠ لول ورتاوان یُس ژےٚ گۅڈٕ ایمان اننہٕ وزِ اوسےٕ۔
\v 5 لہٰذا پاو یاد زِ ژٕ کیٚوتھ لول اوسُکھ مےٚ سٟتؠ ورتاوان۔ مےٚ سٟتؠ ورتاو بییہِ تیتُھےٕلول یُتھ گۅڈٕ ورتاوان اوسُکھ۔ ووٚنؠ اگر ژےٚ مےٚ سٟتؠ بییہِ تیٚوتھےٕ لول ورتووُتھ نہٕ، تہٕ بہٕ نمہ تیٚلہ فٲصلہٕ زِ بہٕ دِمے نہٕ ژےٚ پژھ، والیٚن ہنٛز جماتس سٟتؠ بدستور روزنُک اجازت۔
\v 6 حالانکہ بہٕ چُھس چٲنؠ تعریف کران تکیازِ ژٕ چُھکھ بہترین کامہ کران۔ ژٕ چُھکھ نہٕ نیکولسؔ سنٛدین شٲگردن ہنٛدؠ پٲٹھؠ سُہ کھیٚن کھیٚوان یُس لوٗکھ موٗرژن نذر کران چھِ تہٕ تِم چھِ بدکٲری تہِ کران۔ بہٕ چُھس پانہٕ تِمن کامٮ۪ن سٟتؠ مکمل نفرت کران یمہٕ تِم کران چھِ\f + \fr 2‏:6 \ft زبور 139:21\f*۔
\v 7 پرٛتھ کانٛسہِ یُس روحٲنی طور فرق کرن وول آسہِ پزٮ۪س یتھ کتھِ کُن توجہ دیُن زِ خدایہِ پاک روح کیاہ چُھ ایمان واجنیٚن جمٲژن ونان۔ بہٕ دمہٕ کانٛسہ تہِ فتح منٛد شخصس تمہِ کُلیُک پھل کھیٚنس اِجازت یُس زندگی دِوان چُھ۔ سُہ کُل چُھ خدایہ جنتس باغس منٛز\f + \fr 2‏:7 \ft لوق 23.43؛ 2 کورنتھ 12.3\f*"
\v 8 پتہٕ لیٚکھ تہٕ یہ پٲغام سمُرنہ شہرٕ کِس ایمان واجنہِ جمٲژ ہنٛدِس فرشتس، "بےٕ چُھس سُہ یمؠ سٲری چیز شروع کٔرؠ تہٕ یُس سارنے چیزن انٛد واتناوِ۔ بہٕ چُھس سُہ یُس مود تہٕ پتہٕ دوبارٕ زنٛدٕ سپُد، بہٕ چُھسے ژےٚ یہ ونان۔
\v 9 بہٕ چُھس زانان زِ لوٗکو ستووہکھ ژٕ۔ بہٕ چُھس زانان زِ ژٕ چُھکھ غریب، حالانکہ ژےٚ نِش چُھ تہِ سورےٕ یہ ژےٚ روحٲنی طور ضرورت چُھ۔ مےٚ چُھ معلوم زِ لوٗکھ چھی ژےٚ ذلالت کران۔ تِم لوٗکھ چھِ یہُودؠ آسنُک دعوا کران، مگر تِم چھنہٕ تژھٕ کامہِ کران یمہِ سٟتؠ تِم پٔزؠ پٲٹھؠ خدایہ سنٛدؠ بنہٕ ہن۔ ییٚلہ تِم یِکوٹہٕ سپدان چھِ تِم خدایہ سنٛزٕ کامہِ کرنہٕ بجایہ شیطان سنٛزٕ کامہِ کران۔
\v 10 تِم لوٗکھ واتناونے ژےٚ تکلیف۔ کھوژؠ زیٚنہٕ کینٛہہ! مگر حیٚسہٕ روزؠ زِ! شیطان کرِ تِمن جلدےٕ رہنمائی یُتھ تُہنٛدیٚو منٛزٕ کینٛژن نفرن قٲد کرن۔ شیطان چُھ یہ وچُھن یژھان زِ اگر توٚہہِ تکلیف واتیٚو تہٕ توٚہؠ ترٲیو مےٚ پیٚٹھ ایمان اننُے۔ توٚہہِ پیٚنو دہن دوہُن یِم تکلیف وٮ۪تراوٕنؠ۔ مگر مےٚ سٟتؠ روزؠ زیٚو وفادار اگر زن مرُن تہِ پیٚیو۔ اگر توٚہؠ یہ کٔریٚو تہٕ بہٕ دِمہٕ توٚہہِ انعام رٔنٛگؠ ابدی زندگی\f + \fr 2‏:10 \ft یعقوب 1:12\f*۔
\v 11 پرٛتھ کانٛہہ شخص یُس روحٲنی طور تمیز کرن وول آسہِ دییہِ یتھ کتھِ کُن توجہ زِ خدایہِ سُنٛد پاک روح کیاہ چُھ ایماندار جمٲژن ونان۔ یُس تہِ کانٛہہ فتح حٲصل کرِ سُہ مرِنہٕ دوبارٕ زانٛہہ"
\v 12 بیاکھ پٲغام لیٚکھ ژٕ پرگُمن شہرٕ کٮ۪ن ایمان والیٚن فرشتن ہنٛدِس فہرستس: "بہٕ چُھس سُہ یمِس نِش دُودار واجِنؠ تلوار چھےٚ۔ یہ چُھسے بہٕ ژےٚ ونان:
\v 13 بہٕ چُھس زانان زِ ژٕ کتہِ چُھکھ روزان۔ یہ چھےٚ سۅ جاے یتہِ لوٗکن شیطان کاپہِ رٔٹِتھ چُھ۔ بہٕ چُھس یتہِ زانان زِ ژٕ چُھکھ میٚون وفادار۔ ژےٚ ترٲوٕتھ نہٕ میانؠ پژھ ییٚلہِ زن لوکو چٲنِس سٲتھی ایمان وٲلِس انتِپاسسؔ پیٚٹھ حملہٕ کوٚر۔ تٔمؠ ووٚن باقین مےٚ متعلق، تہٕ رود میٚون وفادار۔ لوکو مور سُہ توٚہہِ برُونٛہہ کنہِ تکیازِ تُہنٛدِس شہرس پیٚٹھ چُھ شیطان سُنٛد تیٚوتھ اثر۔
\v 14 توتہِ چھےٚ مےٚ کینٛژن کتھن پیٚٹھ توٚہہِ تنقید کرِنؠ۔ تُہنٛزِ جمٲژ منٛزٕ چھِ کینٛہہ نفر پۅختہٕ یقین تھاوان زِ تِمن پزِ تی کرُن یہ پرٲنؠ نبی بلعامنؔ تِم ہیٚچھنٲوؠ۔ یہ اوس سُہ بلعامؔ یمؠ موآبؔ کِس بادشاہ بلقؔ ہس ہوو زِ کِتھٕ پٲٹھؠ یِن اسرائیلی لوٗکھ گُنہو باپتھ آمادٕ کرنہٕ۔ بلقنؔ نی اسرائیلی لوٗکھ سُہ ماز کھیٚنہٕ باپتھ یُس لوٗکو بُتو باپتھ قربان کوٚرمُت اوس۔ بلقنؔ ہٲو اسرائیلی لوٗکن بدکٲری کرنٕچ وتھ تہِ\f + \fr 2‏:14 \ft گنتی سبق 22-24\f*۔
\v 15 مگر یتھٕ پٲٹھؠ بلقنؔ بلعام سنٛدِس وننس پیٚٹھ عمل کٔر تِتھے پٲٹھؠ چھِ چانہِ جمٲژ منٛزٕ کینٛہہ نفر پۅختہٕ یقین تھاوان زِ تِم تہِ ہیٚکن تِتھے پٲٹھؠ کرِتھ یہ نیکولسؔ سنٛدؠ شٲگردن ہیٚچھناوان چھِ۔ تِم چھِ سُہ کھیٚن کھیٚوان یُس لوٗکو پنٮ۪ن بُتن نظر کوٚر تہٕ تِم بدکٲری کران۔
\v 16 مگر نَکُولسؔ سنٛدؠ شٲگردن یہ کینٛژھا ہیٚچھناوان چھِ تہِ چُھ غلط۔ لہٰذا پزِ تُہنٛزِ جمٲژ منٛز پرٛتھ کانٛسہِ تِم چیز کرنہٕ نِشہٕ باز یُن! ووٚنؠ اگر نہٕ توٚہہِ منٛزٕ کانٛہہ باز آو تہٕ بہٕ کرٕ جلدےٕ تِمن لوٗکن ہُنٛد فٲصلہٕ۔ بہٕ بوزٕ ناوو تِمن خلاف فٲصلہٕ تہٕ دمہٕ تِمن سزا۔
\v 17 پرٛتھ اکھ شخص یُس روحٲنی طور بیدار چُھ توجہ دِتھ ژیترِنؠ یہ کتھ زِ پاک روح کیاہ چُھ ایمان واجنیٚن جمٲژن کُن ونان۔ تمِس اکِس فتح منٛد شخصس دمہٕ بہٕ اکھ خاص ژۅٹ یۅسہٕ مےٚ تمسنٛدِ باپتھ ژوٗرِ تھٲومٕژ چھےٚ۔ بییہِ دمہٕ بہٕ تس اکھ سفید کنہِ پھوٚل یتھ پیٚٹھ مےٚ تمسُنٛد اکھ نُوو ناو لیٚوکھمُت چُھ۔ کہنؠ ہیٚکہِ نہٕ زٲنِتھ زِ یہ نُوو ناو کیاہ چُھ تمِس أکِس بغٲر یس بہٕ یہ دِوان چُھس"
\v 18 بیاکھ یہ پٲغام لیٚکھ تہٕ تھواتیرہؔ شہرٕ کٮ۪ن ایمان والیٚن فرشتن ہنٛزِ جمٲژ ہنٛدِس فہرستس: "بہٕ چھُس خدایہ سُنٛد گوبر، یمسنٛز أچھ نارٕ مشالہِ ہنٛدؠ پٲٹھؠ چمکان چھےٚ تہٕ یمسنٛدؠ کھۅر شیشٕکؠ پٲٹھؠ نپان چھِ، چُھسو توٚہہ یی ونان\f + \fr 2‏:18 \ft دانی ایل 10:6\f*۔
\v 19 زِ یہ توٚہؠ کران چُھو بہٕ چُھس تتھ سٲرسےٕ وٲقف۔ بہٕ چُھس زانان زِ توٚہؠ چُھو اکھ اکِس سٟتؠ لول ورتاوان تکیازِ توٚہہِ چُھ میٚون محبت۔ بہٕ چُھس زانان زِ توٚہؠ چُھو میانؠ وفادار۔ توٚہؠ کِتھٕ پٲٹھؠ چُھو میانؠ خدمت کران تتھ چُھس بہٕ وٲقف۔ بہٕ چُھس زانان زِ توٚہؠ چُھو صبرٕ سان برداشت کران۔ ٲخٕر چُھس بہٕ یتہِ زانان زِ ووٚنؠ چھُو توٚہؠ تمہِ کھۅتہٕ زیادٕ کران یہِ توٚہؠ تمہِ ساعتہٕ کوٚرُو ییٚلہِ توٚہہِ گۅڈٕ مےٚ پیٚٹھ ایمان اوٚنُو۔
\v 20 مگر توتہِ چُھس بہٕ أکِس کتھِ پیٚٹھ توٚہہِ تنقید کرٕنؠ یژھان۔ توٚہؠ چُھون پننہِ مجلسہِ منٛز اکھ خوتون برداش کران یۅسہٕ پتھ کالچہِ ایزبل نٲوؠ بدکار ملکایہِ ہنٛدؠ پٲٹھؠ چھےٚ۔ سۅ چھےٚ یہ نبیہ آسنُک اپُز دعوا کران زِ سۅ چھےٚ خدایہ سنٛدِ پزرٕچ تعلیم دِوان۔ مگر اصلی یہ سۅ ہیٚچھناوان چھےٚ، سۅ چھےٚ تِمن لوٗکن گمراہ کران یمہٕ مےٚ پیٚٹھ پژھ تھاوان چھِ۔ سۅ چھےٚ تِمن بدکٲری کرنٕچ تہٕ سُہ ماز کھیٚنٕچ تعلیم دِوان یُس باقی لوٗکھ بُتن نذر کران چھِ۔
\v 21 یودوے مےٚ تس یمو غلط کامیٚو نِشہٕ باز پھیرنہٕ باپتھ واریاہ وقت دیُت، مگر تمہِ ہیٚوت نہٕ یمو کامیٚو نِشہٕ پتھ، سۅ روز یمہٕ غٲر اخلٲقی حرکژٕ کران۔
\v 22 دھیان تھٲزیٚو! بہٕ دمہٕ تس سزا اکھ خوفناک بٮ۪مٲرؠ ژھنِتھ۔ بہٕ کرکھ تمہٕ لوٗکھ تہِ انیٖکھ مصیبتن منٛز مبتلا یمہٕ تمسنٛدی پٲٹھؠ بدکار کران چھِ اگر نہٕ تِمو یِمو کامیٚو نِشہٕ پتھ ہیٚوت۔ یہ سۅ کران چھےٚ۔
\v 23 تہٕ تمِس خلاف یہ فٲصلہٕ نِتھ مارکھ بہٕ تِم تمام شُرؠ تمسنٛزِ بدکٲری ہنٛدِس نتیجس منٛز تمہٕ زاے۔ پتہٕ ترِ ایمان والیٚن ہنٛزن تمام جمٲژن فکرِ زِ بہٕ چُھس ژرژان زِ کُس کیاہ چُھ سونٛچان تہٕ کیاہ چُھ یژھان۔ بہٕ دمہٕ توٚہہِ منٛزٕ پرٛتھ کانٛسہِ سزا یا جزا یُس یتھ لایکھ آسہِ۔
\v 24 مگر تھواتیرہؔ شہرس منٛز کٔر نہٕ توٚہہِ منٛزٕ باقی ایمان والیٚو امِس زنہِ ہنٛزِ تعلیمہِ پیٚٹھ عمل۔ توٚہہِ نیٚو نہٕ تمؠ سنٛزن تِمن پوشیدٕ کامٮ۪ن منٛز حصہٕ یمہٕ شیطان تس ہیٚچھناوان اوس۔ مگر مےٚ چُھ توٚہہِ تہِ کینٛہہ ونُن۔ بہٕ ونہٕ توٚہہِ کرنہٕ خٲطرٕ صرف اکھ کٲم۔
\v 25 یۅتام بہٕ واپس واتہٕ تۅتام روزؠ زیٚو پزرٕچہِ اتھ تعلیمہِ پیٚٹھ عمل کران یۅسہٕ توٚہہِ رٔٹو۔
\v 26 یُس فتح منٛد سپُد تہٕ میانٮ۪ن حکمن ہنٛز تعمیل کران رود یۅتام سُہ مرِ تۅتام دمہٕ بہٕ تس لوٗکہٕ جمٲژن پیٚٹھ حکومت کرنُک اختیار۔
\v 27 یِمن بہٕ یہ اختیار دمہٕ تمہٕ کرن کُنہِ ناکٲمی بغٲر طاقتہٕ سان لوریٚو سٟتؠ لوٗکہٕ جمٲژن پیٚٹھ حکومت۔ تِم کرن بدکارن تتھٕ پٲٹھؠ تباہ زنتہٕ کتریٚو بانہٕ آسن پُھٹراوان۔
\v 28 تِم کرن زور دار حکومت تکیازِ بہٕ دمہٕ تِمن تِم اختیار یِم مےٚ پننِس بب خدا مٲلِس نش میلمٕتؠ چھِ۔ بہٕ کرٕ تِمن یمہِ کتھِ ہنٛز تہِ یقین دہٲنی زِ خدا چُھ اکہِ شاندار نیہِ دورُک آغاز کرن وول\f + \fr 2‏:28 \ft زبور 2.8-9\f*۔
\v 29 پرٛتھ کانٛسہ شخصس یُس تہِ روحٲنی طور سمجھدار چُھ پزِ اتھ کُن توجہ کرُن زِ پاک روح کیاہ چُھ ایمان واجنیٚن جمٲژن ونان"
\c 3
\p
\v 1 یہ پٲغام لیٚکھ تہٕ سردیسؔ شہرٕ کٮ۪ن ایمان والیٚن ہنٛدِس فرشتس: بہٕ چُھس سُہ اکھ یمِس نِش خدایہ سنٛدؠ ستھ روح تہٕ ستھ ستارٕ چھِ۔ مےٚ چھِ توٚہہِ وننہٕ خٲطرٕ یِم چیز: بہٕ چُھس تُہنٛزن کامٮ۪ن وٲقف، توٚہہ چھےٚ اکھ پرتیٖتھ روحٲنی طور مضبوط آسنہٕ موکھٕ، مگر توٚہؠ چھو نہٕ پزنہٕ پٲٹھؠ میانہِ باپتھ جوشہٕ سان کٲم کران۔
\v 2 حیٚسہٕ روزیٚو! توٚہہ چُھ مکمل پٲٹھؠ میٚون عقیدٕ راونُک اہتمال لاحق۔ تتھ عقیدس منٛز أنِو نویٚر یُس وُنہِ تہِ توٚہہِ منٛز باقےٕ چھُ۔ توٚہہِ چُھنہٕ ازتام تہِ سورےٕ کوٚرمُت یہ خدا زانان چھُ زِ توٚہہِ گوٚژھُو آسُن کوٚرمُت۔
\v 3 یاد کریٚو، ییٚلہ توٚہہ خدایہ سنٛدؠ ہِدایت بوزیٚو توٚہہ کمہِ بےٚ تٲبی سان کریٚو تِم قبول۔ پننہِ نافرمٲنی پیٚٹھ روزیٚو نٲدم تہٕ کریٚو دوبارٕ فرمانبردٲری کرٕنؠ شروع۔ اگر توٚہؠ میانؠ کتھ ماننس منٛز محتاط چھو نہٕ، تہٕ بہٕ کرٕ تُہنٛد فٲصلہٕ ییٚلہ زن نہٕ توٚہؠ تمیُک توقع کران ٲسِو۔ توٚہہ لگہِ نہٕ پتہےٕ زِ بہٕ کر آسہٕ توٚہہِ سزا دنہٕ وول۔
\v 4 حالانکہ امہِ باوجود چھِ سردیس شہرس منٛز کینٛہہ ایمان وٲلؠ یِم نہٕ غلط کامہِ کران چھِ۔ تِم روزن ہمیشہٕ مےٚ سٟتؠ تہٕ پرٛتھ رنٛگہٕ روزن پاک۔ یہ چُھ تہِ یمِکؠ تِم مستحق چھِ۔
\v 5 یتھٕ پٲٹھؠ کرن بہٕ سُہ فتح پراون وول مکمل پٲٹھؠ پاک. بہٕ بناوٕ یہ کتھ یقینی زِ امسُنٛد ناو روزِ زندگی ہنٛزِ کتابہِ منٛز ہمیشہٕ موجود۔ بہٕ ونہٕ پننِس بب تہٕ تمسنٛدٮ۪ن فرشتن زِ ذٲتی طور زانن بہٕ یہ۔ \f + \fr 3‏:5 \ft مکاشفہ 21:27\f*
\v 6 پرٛتھ کانٛہہ شخص یُس روحٲنی طور سمجھدار آسہِ دییہِ یور کُن توجہ زِ پاک روح کیاہ چُھ ایمان والیٚن ہنٛزن جمٲژن ونان"
\v 7 فِلدلفیہؔ شہرٕچہِ ایمان واجنہِ جمٲژ ہنٛدِس فرشتہٕ سنٛدِ ناوٕ لیٚکھیٚو یہ پٲغام: " بہٕ چُھس سُہ یُس ہمیشہٕ تہِ کران یہ بہتر چُھ۔ بہٕ چُھس سُہ یُس ہمیشہٕ پوٚز ونان چُھ۔ یتھ پٲٹھؠ بادشاہ داوودسؔ لوٗکن یروشلمہٕ کِس قدیم شہرس منٛز دٲخل سپدنُک اِجازت دِنُک اختیار اوس، تِتھے پٲٹھؠ چُھ مےٚ لوٗکن جنتس منٛز دٲخل سپدنُک اِجازت دِنُک اختیار حٲصِل۔ اگر بہٕ کانٛسہٕ تہِ اکِس یہ موقعہ فراہم کرٕ تہٕ کانٛہہ ہیٚکہِ نہٕ تمسنٛدِس تتھ موقس انکار کرِتھ۔ ووٚنؠ اگر بہٕ کانٛسہِ سُہ اکھ موقہٕ فراہم کرٕنہٕ نشہٕ انکار کرٕ۔ یِمہ کتھٕ چھےٚ مےٚ نِش توٚہہِ وننہٕ خٲطرٕ:\f + \fr 3‏:7 \ft ایوب 12:14، یشعیا 22:22\f*
\v 8 "بہٕ چُھس زانان زِ توٚہؠ کیاہ چُھو کران، بہٕ چُھس زانان زِ یودوے توٚہؠ کمزور چُھو مگر توٚہہِ کٔرو میانٮ۪ن احکامن ہنٛز تعمیل، توٚہہ کوٚرو تصدیق زِ توٚہؠ چُھو مےٚ پیٚٹھ پژھ تھاوان۔ حٮ۪سہٕ روزیٚو بہٕ چُھسو توٚہہِ اکھ موقہٕ فراہم کرن وول، یتھ نہٕ توٚہہِ کانٛہہ اکھ تہِ انکار کٔرِتھ ہیٚکہِ۔
\v 9 دھیان تھٲوؠ زیٚو! کینٛہہ لوٗکھ چھِ یتھ کتھِ انکار کران زِ توٚہؠ چھُو میٲنؠ لوٗکھ۔ تِم لوٗکھ چھِ دعوا کران زِ أسؠ چھِ یہُودؠ مگر تِم چھِنہٕ تمہِ طریقہٕ عمل کران یِتھٕ پٲٹھؠ تِم لوٗکھ کران چھِ یِم پٔزؠ پٲٹھؠ خدایہِ سنٛدؠ چھِ۔ ییٚلہ تِم یِکوٹہٕ سمان چھِ تِم چھِ خدایہ سنٛز خدمت کرنہٕ بجایہ شیطانس مدد کران۔ ظۅن تھٲیو بہٕ زٲنراوکھ تِم لوٗکھ زِ بہٕ چُھسو توٚہہ محبت کران۔ ییٚلہِ تِم یہ زانن تِم ین تہٕ کرن توٚہہ کٲفی عزت۔
\v 10 توٚہہ مونو میٚون ییٚلہ مےٚ توٚہہ صبرٕ سان مصیبت برداشت کرنُک حکم دیُت۔ تہٕ یتھٕ پٲٹھؠ تھاوو بہٕ توٚہؠ مصیبتہٕ نِشہٕ محفوظ یمیُک بُتھ عنقریب سٲرسےٕ انسٲنیتس وُچھن پییہِ۔ پرٛتھ جایہ ہنٛدؠ لوٗکھ کِتھٕ پٲٹھؠ کرن امہِ مصیبتُک مقابلہٕ تہِ دِیہِ ہٲوِتھ زِ حقیقتاً کِتھؠ چھِ تِم۔
\v 11 بہٕ چُھس جلدےٕ ینہٕ وول۔ لہٰذا تھٲیو مےٚ پیٚٹھ پژھ قٲیِم۔ کانٛسہِ مہٕ دِیو تمہِ انعامہٕ نِشہٕ محروم روزنُک موقہٕ یُس خدا توٚہہِ عطا کرُن یژھان چُھ۔
\v 12 بہٕ تھاون سُہ اکھ خدا سنٛدِ ہیکل کہ ستونٕکؠ پٲٹھؠ محفوظ یُس فتح یاب سپدِ۔ سُہ روزِ ہمیشہٕ باپتھ خدا سنٛدِس ہیکلس منٛز۔ بہٕ لیٚکھٕ تمِس پیٚٹھ پننِس خدایہ سُنٛد ناو۔ بہٕ لیٚکھٕ تمِس پیٚٹھ پننِس خدایہ سنٛدِ شہرُک ناو تہِ۔ سُہ شہر چُھ نوو یروشلم۔ سُہ وسہِ میانِس خدا سنٛدِ طرفہٕ آسمانہٕ پیٚٹھٕ بوٚن۔ بہٕ لیٚکھٕ پنُن نوو ناو تہِ تمِس پیٚٹھ یُس فتح یاب آسہِ۔ \f + \fr 3‏:12 \ft مکاشفہ 21:2، یشعیا 65:15، عزرا 48:35\f*
\v 13 پرٛتھ کانٛہہ فرد یُس روحٲنی طور سمجھدار چُھ تھاوِ اور کُن توجو زِ پاک روح کیاہ چُھ ایمان واجنیٚن جمٲژن ونان"
\v 14 یہ پٲغام لیٚکھ لودیہ کہِ شہرچہِ ایمان واجنہِ فرشتن ہنٛزِ جمٲژ ہنٛدِس فہرشتس: " بہٕ چُھس سُہ یُس خدا سنٛدین تمام وعدن ہنٛز تصدیق کران چُھ۔ بہٕ چُھس سُہ یُس خدایس متعلق پورٕ اعتبارٕ سان گوٲہی دِوان چُھ۔ بہٕ چُھس خدایہ سنٛدین تمام مخلوقن ہُنٛد حٲکم۔ مےٚ نِش چھِ یِم چیز یِم بہٕ توٚہہ ونہٕ،
\v 15 "بہٕ چُھس زانان زِ توٚہؠ کیاہ چُھو کران، توٚہہِ ژھنُوو نہٕ پنُن ایمان ترٲوِتھ۔ مگر توٚہؠ چُھو نہٕ مےٚ سٟتؠ زیادٕ محبت کران، بہٕ چُھس یژھان زِ توٚہؠ جوڑیو پنُن پان مےٚ سٟتؠ یا روزیٚو مےٚ خلاف!
\v 16 مگر توٚہؠ چُھو کمتر، توٚہؠ چُھو نہٕ مےٚ سٟتؠ زیادٕ محبت کران، مگر امہ باوجود چُھو توٚہؠ یہ دعوا کران زِ توٚہہ چُھ مےٚ پیٚٹھ یقین، یہ چھُنہٕ مےٚ خوش لگان، تہٕ امہِ سببہٕ چھُس بہٕ توٚہہِ انکار کرن وول۔ \f + \fr 3‏:16 \ft 2 کورنتھ 1.20\f*
\v 17 توٚہؠ چُھو دم دِوان زِ توٚہؠ کٲتیاہ امیر چُھو۔ توٚہہِ چُھو نہٕ احساسےٕ زِ توٚہؠ چُھو بنیٲدی ناخۅش۔ توٚہہِ چھےٚ تمِس شخصہٕ سنٛز ضرورت یُس توٚہہِ پیٚٹھ رحم کرِ۔ توٚہؠ چُھو در اصٕل غریب، أنؠ تہٕ نیٚتھٕ نٔنؠ۔
\v 18 بہٕ چُھسو توٚہہ مشورٕ دِوان زِ مےٚ نِش کٔریٚو پرٛتھ کانٛہہ سُہ چیز حٲصِل یُس توٚہہ ضرورت چُھ، زنتہٕ توٚہؠ مےٚ نِش خٲلص سۅن مۅلؠ ہیٚوان چُھو یُس توٚہہ پٔزؠ پٲٹھؠ دولت منٛد بناوِ۔ بہٕ بناوو توٚہؠ راستباز، زنتہٕ توٚہؠ مےٚ نِش سفید کپُر ہیٚوان چُھو یُتھ توٚہؠ بے شرم پٲٹھؠ ننٛگے روزنہٕ بجایہ پلو لٲگیٚو، مےٚ دِیو پانس مدد کرنُک موقہٕ یُتھ توٚہؠ پزر زٲنِتھ ہکیٚو، زنتہٕ توٚہؠ پننٮ۪ن بٮ۪مار أچھو باپتھ مےٚ نِش لاگنہٕ خٲطرٕ سۅرمہٕ ہیٚوان چُھو تاکہ توٚہؠ ہکیٚو وُچِھتھ۔
\v 19 بہٕ چُھس پرٛتھ کانٛسہِ یس سٟتؠ بہٕ محبت کران چُھس احتیاط سان نظم و ضبطٕ باپتھ ونان۔ پنُن رویہ کٔریٚو خلوصہٕ سان تبدیل۔
\v 20 ظۅن تھٲیو! بہٕ چُھس توٚہہِ منٛزٕ پرٛتھ أکِس مےٚ سٟتؠ پوٚز لول ورتاونُک تٲکید کران، زنتہٕ بہٕ تُہنٛدِ گرکِس دروازس پیٚٹھ کھڑا چُھس تہٕ توٚہہ دروازٕ مُژراونہٕ باپتھ ٹُھک ٹُھک کران چُھس۔ اگر مےٚ کانٛہہ محبتہٕ سان جواب دییہِ تہٕ بہٕ بنہٕ تمسُنٛد اکھ عزیز دوس۔ زنتہٕ بہٕ تمؠ پننِس دروازس پیٚٹھ آلو دِوان وچُھس تہٕ تمؠ مُژرو دروازٕ تہٕ بہٕ ژاس تمسُنٛد گرٕ تہٕ کوٚر یکہٕ وٹہٕ کھٮ۪ن چٮ۪ن۔
\v 21 مےٚ چھےٚ فتح حٲصِل کرمٕژ تہٕ ووٚنؠ چُھس پننِس ببس سٟتؠ حکومت کران۔ یتھے کنؠ دمہٕ بہٕ تمِس یُس فتح منٛد سپُدمُت آسہِ پانس سٟتؠ حکومت کرنُک اجازت۔
\v 22 پرٛتھ کانٛہہ فرد یُس روحٲنی طور سمجھدار آسہِ دییہِ یتھ کتھِ کُن توجہ زِ پاک روح کیاہ چُھ ایمان واجنیٚن جمٲژن ونان۔
\c 4
\p
\v 1 یمو چیزو پتہٕ وُچھ مےٚ یوحناہنؔ اکھ قٲبلِ ذِکر چیز: آسمانس اوس اکھ دروازٕ یلہٕ۔ سُہ یمؠ مےٚ سٟتؠ امہِ برونہٛہ کتھ کٔرمٕژ ٲس، یمسنٛز آواز اکہِ ترے ہنٛدؠ پٲٹھؠ گرٮ۪زان ٲس، کٔر مےٚ سٟتؠ بییہِ کتھ۔ تمؠ ووٚن، "ولہٕ کھس یورؠ، بہٕ ہاوے ژےٚ تِم واقعات یِم آینٛدٕ سپدن۔
\v 2 یکدم گوو پاک روح مےٚ پیٚٹھ نٲزِل یُتھ مےٚ اکِس رویا ہس منٛز چیز وُچِھتھ تہٕ بوزِتھ ہیٚکہٕ۔ مےٚ وُچھ قٲبلِ ذکر اکھ چیز: "آسمانس منٛز اوس اکھ تخت یتھ پیٚٹھ کُس تام بہِتھ اوس۔ \f + \fr 4‏:2 \ft 1 سلاطین 22:19\f*
\v 3 یُس حٲکم تختس پیٚٹھ بہِتھ اوس سُہ اوس ۅزلہِ جوہرٕکؠ پٲٹھؠ پرٮ۪زلان تہٕ انٲرؠ عقیقٕکؠ پٲٹھؠ چمکان۔ تختس انٛدؠ انٛدؠ ٲس سبٕز زمُردی سونٛزلہِ ہنٛدؠ پٲٹھؠ چمکان۔ \f + \fr 4‏:3 \ft عزرا 1:28\f*
\v 4 تختس انٛدؠ پٔکؠ ٲسؠ بییہِ تہِ ژوُہہ تخت یِمن تختن پیٚٹھ ٲسؠ سفید پۅشاک لٲگِتھ ژوُہہ بُزرگ زِٹھؠ بہِتھ۔ تِمن ٲسؠ خٲلص سفید پلو لٲگِتھ تہٕ تِمن کلن پیٚٹھ سۅنہٕ سنٛدؠ تاج۔
\v 5 تختہٕ پیٚٹھٕ آسہٕ چمکدار وُزملہٕ تہٕ گرٮ۪زوٕنہِ مشالہِ نیران۔ تختس برُونٛہہ کنہِ آسہٕ دزٕ ونہِ ستھ مشالہِ، یمہٕ ستھ مشالہِ آسہٕ خدایہ سنٛدین ستن روحن ہنٛز نمایندگی کران۔ \f + \fr 4‏:5 \ft زکر 4:2\f*
\v 6 تختس برُونٛہہ کنہِ اوس بیاکھ چیز تہِ یُس شیشو سمندر ہیٚوٗ باسان اوس۔ یہ اوس بلورٕکؠ پٲٹھؠ صاف کرِسٹل۔ تختس ژورو طرفو اوس اکھ اکھ جاندار وۅدٕنؠ۔ پرٛتھ اکِس جاندارس اوس جِسم ژۅپٲرؠ أچھو سٟتؠ ؤلِتھ۔ \f + \fr 4‏:6 \ft عزرا 10:12\f*
\v 7 گۅڈنیُک جاندار اوس سٕہس سٟتؠ مشاہبت تھاوان۔ دویِم جاندار اوس داندس ہیٚوٗ تریمِس جاندار سُنٛد بُتھ اوس انسان شکلہِ۔ ژورِم جاندار اوس وُڈوُن عُقاب باسان۔ \f + \fr 4‏:7 \ft عزرا 1:10، 10:14\f*
\v 8 ژورو جاندارو منٛزٕ اسہٕ پرٛتھ اکِس جاندارس شےٚ پکھٕ۔ أچھو سٟتؠ ٲسؠ یِم جاندار پوٗرٕ پٲٹھؠ ولِتھ۔ تِم ٲسؠ کُنہِ تھکہٕ ورٲے ہر ساعتہٕ ونان، "مقدس، مقدس، مقدس چُھ خداوند خدا یُس پرٛتھ چیزس تہٕ پرٛتھ اکِس پیٚٹھ حکومت کران چُھ۔ سُے چُھ سُہ اکھ یُس ہمیشہ پیٚٹھٕ موجود چُھ، یُس از تہِ موجود چُھ، تہٕ یُس یمہ پتہٕ تہِ ییہِ تہٕ کرِ پرٛتھ أکؠ سُنٛد یِنہٕ کالس منٛز فٲصلہٕ"\f + \fr 4‏:8 \ft یشعیا 6:2-3\f*
\v 9‏-10 \f + \fr 4‏:9‏-10 \ft 12دانی ایل\f*جاندار ٲسؠ بار بار خدایہ\f + \fr 4‏:9‏-10 \ft خدا\f* سنٛدؠ تعریف، تعظیم تہٕ شُکر ادا کران، یُس تختس پیٚٹھ بہِتھ چُھ تہٕ ہمیشہٕ روزن وول چُھ۔ ییٚلہِ تِم یہ کران ٲسؠ تہٕ 24 بُزرگ تہِ ٲسؠ تختس پیٚٹھ موجود خدایس برُونٛہہ کنہِ نمِتھ سربسجود سپدان۔ تِم ٲسؠ پنٕنؠ تاج تمسنٛدِس تختس برُونٛہہ کنہِ تراوان یُس ہمیشہٕ زندٕ روزن وول چُھ تہٕ ٲسؠ ونان۔
\v 11 "اے سانہٕ خداوند خدایہ، ژٕ چُھکھ اتھ لایکھ زِ تمام مخلوق کرِ چٲنؠ عظمت، عزت تہٕ یہ تسلیم زِ ژٕ کوتاہ طاقتور چُھکھ۔ ژٕ چُھکھ اتھ لایکھ تکیازِ ژےٚ کوٚرتھ پرٛتھ کانٛہہ چیز پٲدٕ۔ آ، پرٛتھ اکھ چیز چُھ تِتھے پٲٹھؠ موجود یتھ پٲٹھؠ سُہ بناونُک اِرادٕ ژےٚ کوٚرُتھ"
\c 5
\p
\v 1 پتہٕ وُچھ مےٚ زِ یُس شخص\f + \fr 5‏:1 \ft خدا\f* تختس پیٚٹھ بہِتھ اوس تمسنٛدس دٔچھنِس اتھس منٛز اوس اکھ طومار۔ تمؠ ٲسؠ طومارس\f + \fr 5‏:1 \ft ؤلِتھ چمبرو ژادرٕ یِم لیکھنہٕ خٲپرٕ استعمال آسہٕ گژھان\f* دۅشوٕنؠ طرفن الفاظ لیٚکھِتھ تھٲوؠ مٕتؠ۔ مگر تٔمؠ اوس پتہٕ تھوومُت سُہ طومار مومہٕ کیٚو ستو ٹُکرو سٟتؠ مُہر ترٲوِتھ بنٛد کرِتھ، یُتھ نہٕ تتھ کانٛہہ پرٛتھ ہیٚکہ یہ تمؠ لیٚوکھمُت اوس۔ \f + \fr 5‏:1 \ft عزرا 2:9-10\f*
\v 2 مےٚ وُچھ اکھ طاقتور فرشتہٕ یُس بڈِ بڈِ پرِژھان اوس: "کُس چُھ سُہ یُس طومارٕ پیٚٹھ مومٕکؠ ٹُکرٕ تُلنس قٲبِل چُھ تہٕ پتہٕ کھولہِ طومار تہٕ پرِ اتھ کیاہ چُھ لیٚکھِتھ؟"
\v 3 پتہٕ تہِ آسہ نہٕ کانٛہہ آسمٲنی مخلوق، زمینہِ پیٚٹھُک کانٛہہ شخص تہٕ گُذریمتیٚو مۅردو منٛزٕ کانٛہہ اکھ یتھ قٲبِل زِ یہ طومار کھولہِ تہٕ پتہٕ پرِ۔
\v 4 ییٚلہ مےٚ وُچھ زِ کُنہِ جایہ چُھنہٕ کانٛہہ یتھ قٲبِل یُس طومار کھولِتھ پٔرِتھ ہیٚکہ ہے تہٕ مےٚ ہیٚوت بڈِ بڈِ ودُن۔ مےٚ ہیٚوت اوٕ کِنؠ ودُن تکیازِ بہٕ اوسُس زانان زِ یہ کینٛژھا خداین لیٚوکھ سُہ چُھ واریاہ اہم، مگر بہٕ اوسُس سونٛچان زِ کانٛسہِ اکِس لگہِ نہٕ زانہٛہ کٲلؠ یہِ پتاہ زِ أمؠ کیاہ چُھ لیٚوکھمُت۔
\v 5 مگر بزرگو منٛزٕ ووٚن مےٚ أکؠ، "ژےٚ چھی نہٕ ووٚنؠ ودنُک ضرورت! یہ چُھ سُہ شخص یمسنٛز اسہِ تلاش ٲس! یہ چُھ سُہ شخص یس نبی یہُوداؔ قبیلُک سٕہہ ونان ٲسؠ تہٕ اکھ سۅ لٔنٛڈ یۅسہٕ داوود سنٛدیو موٗلو پیٚٹھٕ کھٔسِتھ ییہِ۔ سُہ چُھ فتح یاب، یمہِ کِنؠ سُہ طومارٕ پیٚٹھٕ مومٕکؠ ستھ حصہٕ پھٹرٲوِتھ مژراونہٕ تہٕ طومار کھولنہٕ خٲطرٕ پوٗرٕ پٲٹھؠ قٲبل چھُ"\f + \fr 5‏:5 \ft پیدٲیش 49:9، یشعیا\f*
\v 6 پتہٕ وُچھ مےٚ اکھ کٹہٕ برٕ تختس نِش کھڑا۔ ژورو جاندارو تہٕ بُزرگن کوٚر تس انٛدؠ انٛدؠ گیرٕ۔ سُہ اوس زنٛدے مگر تمِس ٲسؠ تِتھؠ نشانہٕ یمو سٟتؠ باسان اوس زِ یہ چُھ کٔمو تام اکہِ پھرِ تشدُد کٔرِتھ مورمُت۔ تمِس ٲسؠ ستھ ہیٚنٛگ۔ تمِس تہِ آسہٕ ستھ أچھ۔ یمہٕ چھِ خدایہ سنٛدؠ ستھ روح یمہٕ خدا سٲرسےٕ دنیاہس سوزان چُھ۔ \f + \fr 5‏:6 \ft زکر 4:10\f*
\v 7 کٹہٕ برٕ کھۅت تختس پیٚٹھ تہٕ یُس شخص تختس پیٚٹھ بہِتھ اوس تٔمؠ کوٚر طومار امِس حوالہٕ۔
\v 8 یِتھُےٕ کٹہٕ برن طومار قبول کوٚر، ژورو جاندارو تہٕ ژُوہو بزرگو کوٚر تمِس برُونٛہہ کنہِ پتھ پٮ۪تھ سجدٕ۔ پرٛتھ کانٛسہِ بزرگس اتھِ اوس اکھ چنٛگہٕ تہٕ کینٛہہ سۅنہٕ سنٛدؠ پیالہٕ یِمن منٛز بخور اوس۔ بخور چُھ تِمن لوٗکن ہنٛدِ دُعاہٕچ علامت یہُنٛد تعلق خدایس سٟتؠ چُھ۔
\v 9 جاندارو تہٕ بزرگو گیٚوو اکھ تیُتھ بٲتھ یُس نہٕ از تام کانٛسہِ گیومُت اوس۔ تِمو ؤنؠ کٹہٕ برس تِم بٲتھ، "ژٕ چُھکھ یہ طومار حٲصِل کرنس تہٕ امیُک یہ موم کھولنس لایکھ، یُتھ ژٕ یہ پٔرِتھ ہیٚککھ زِ اتھ منٛز کیاہ چُھ لیکِھتھ۔ ژٕ چُھکھ امیُک مستحق تکیازِ ییٚلہ ژےٚ پنُن زُو دِتُتھ، تہٕ ژےٚ کٔرؠ تھکھ پنُن خوٗن دِتھ لوٗکھ گُنہو نِشہٕ آزاد یُتھ تِم خدایہ سنٛز عبادت تہٕ فرمانبردٲری کٔرِتھ ہیٚکن۔ ژےٚ کوٚرُتھ یہ تمام قبیلن تہٕ دنیا کٮ۪ن لوٗکن باپتھ۔
\v 10 ژےٚ بنٲوتھکھ تِم بادشاہ تہٕ کاہن تِتھؠ لوٗکھ یِمن پیٚٹھ سون خدا حکومت کران چُھ تہٕ بنیاے تِتھؠ لوٗکھ یمہٕ باقین خدا سنٛدِس عبادتس کُن رٲغب کران چھِ۔ تِم آسن تِمن لوٗکن ہنٛدؠ حٲکم یِم دنیاہس منٛز روزان چھِ۔
\v 11 ییٚلہ بہٕ یِم واقعات وُچھان اوسُس، مےٚ بوز واریہن فرشتن ہُنٛد ونہٕ وُن۔ یِم فرشتہٕ ٲسؠ تختس، زنٛدٕ مخلوقن تہٕ بُزرگن انٛدؠ انٛدؠ گیرٕ کٔرِتھ۔ اتہِ ٲسؠ لچھٕ واد فرشتہٕ، تیٖتؠ فرشتہٕ یِمن نہٕ کانٛہہ گنٛزرٲوِتھ ہیٚکہِ ہے زِ یِم کٲتیاہ ٲسؠ۔ \f + \fr 5‏:11 \ft دانی ایل 7:10\f*
\v 12 فرشتہٕ ٲسؠ بڈِ بڈِ گیٚوان، "کٹہٕ برٕ یمؠ پنُن زُو قربان کوٚر چُھ پرٛتھ کانٛسہ ہنٛدِ باپتھ قٲبلِ احترام، باعثِ عزت، برکت تہٕ حمد چُھ تہٕ یہ زانُن زِ سُہ کوتاہ طاقتور، آسن وول، دٲنشمنٛد تہٕ مضبوط چُھ"
\v 13 پتہٕ بوز مےٚ تمام مخلوقن نِش تہِ یِم آسمانس منٛز، زمینس پیٚٹھ، زمینس تل تہٕ سمندرن منٛز موجود چھِ۔ آ، یِمن تمام جاین موجود مخلوق ٲس گیٚوان، "پرٛتھ کانٛہہ گژھِ ہمیشہٕ تمِس ذاتس تعریف کرٕنؠ تہٕ عزت کرُن تہٕ جلال بخشُن یُس تختس پیٚٹھ بہِتھ چھُ تہٕ کٹہٕ برس تہِ مانُن زِ تِم کٲتیاہ طاقتہٕ وٲلؠ چھِ"
\v 14 ییٚلہِ لچھٕ واد فرشت تہٕ تمام مخلوق یمہٕ کتھٕ گیٚوِتھ باوِ تہٕ ژورو جاندارو ووٚن، "یی سپدِن" تہٕ پتہٕ سپدؠ بزرگ خدایس تہٕ کٹہٕ برس برونہٛہ کنہِ سربسجود تہٕ ٲسؠ تِہنٛز عبادت کران۔
\c 6
\p
\v 1 پتہٕ وُچھ مےٚ یہ برٕ موم کیٚو ستو ٹُکرو منٛزٕ گۅڈنیُک ٹُکرٕ مُژراوان یُس طومارس مُہرٕ سٟتؠ بند کٔرِتھ اوس۔ ییٚلہ تمؠ یہ کوٚر تہٕ مےٚ وُچھ ژورو جاندارو منٛزٕ اکھ زورٕ گگرایہِ ہنٛدؠ پٲٹھؠ ژرِ پوٚپ کران تہٕ بڈِ بڈِ ونان، "ؤلیٚو برُونٛہہ کُن!
\v 2 پتہٕ وُچھ مےٚ حٲران کروُن اکھ چیز، اکھ سفید گُر یمسُنٛد سوار اکھ تیر کمان تہٕ تیر رٔٹِتھ اوس۔ خداین دیُت تس اکھ تاج یُس سُہ تِمن کامیٲبین ہنٛدِس اعزازس منٛز لٲگِتھ تھاوِ یِمہٕ سُہ زینن وول اوس۔ سوار دراو آسمان پیٚٹھٕ، یُس خدا سنٛدین دشمنن سٟتؠ لڑنٕچ تہٕ تِمن شکس دِنٕچ مکمل صلاحیت تھاوان اوس۔
\v 3 پتہٕ کھول کٹہٕ برن مومُک بیاکھ ٹُکرٕ یتھ منٛز مُہر بنٛد طومار اوس۔ ییٚلہِ تٔمؠ یہ کوٚر تہٕ مےٚ بوز دویِم جاندار یہ ونان، "ولیٚو برُونٛہہ کُن!"
\v 4 پتہٕ گو بیاکھ گُر ظٲہِر یُس وۅزُل اوس۔ تمِس گُرِس پیٚٹھ تہِ اوس اکھ سوار بہِتھ۔ خداین دیُت تس زمینس پیٚٹھ جنٛگ کرناونُک طاقت۔ یتھٕ پٲٹھؠ مارن دنیاہٕکؠ لوٗکھ اکھ اکِس۔ امہِ مقصدٕ باپتھ کٔر خداین تیز سُرخؠ گُرؠ سوارس اکھ بٔڈ تلوار عطا۔
\v 5 پتہٕ کھول کٹہٕ برن مومُک ترییِم ٹُکرٕ تہٕ تُجن طمارس مُہر۔ ییٚلہِ تمؠ یہ کوٚر تہٕ مےٚ بوز تریمِس جاندار سنٛز کتھ یمؠ ووٚن، "ؤلیٚو!" پتہٕ وُچھ مےٚ بیاکھ قٲبلِ ذکر چیزاہ: اکھ سیاہ گُر یمسُنٛد سوار اتھس کیٚتھ ترکٕر رٔٹِتھ اوس\f + \fr 6‏:5 \ft زکر 6:2-3، 6.\f*۔
\v 6 پتہٕ بوز مےٚ اکھ آواز یۅسہٕ آواز زنتہٕ ژورن جاندارن درمیان ۅتلان ٲس، ونان ٲسؠ زِ "کٕنکھ کٔرؠ ووکھ تیٖتؠ نایاب زِ اکھ کِلو ہیٚنہٕ باپتھ گژھِ اکِس نفرس دوٚہس مزوٗرؠ کرٕنؠ پیٚنؠ۔ امہِ علاوٕ کٔریٚو جو تیٚوت نایاب یتھ انسان دوٚہس محنت کرِتھ ترےٚ کِلو ہیٚکہِ مٔلؠ ہیٚتھ۔ وۅنؠ گوو یہِ کتھ بنٲیو یقینی زِ زیتون تیل تہٕ شراب روزِ تیوٗت زیادٕ دستیاب زِ تہنٛدؠ باو ہُرن نہٕ\f + \fr 6‏:6 \ft اکھ دینار چھُ اکِس گٲمی مزوٗر سنٛدِس کامہِ دوٚہس برابر\f*۔
\p
\v 7 پتہٕ کھول کٹہٕ برن مومُک ژورِم ٹُکرٕ یتھ منٛز طومار مُہر بنٛد اوس۔ ییٚلہِ تمؠ یہ کوٚر، تہٕ مےٚ بوز ژورمِس جاندار سُنٛد یہ ونُن، "ؤلیٚو!"
\v 8 پتہٕ وُچھ مےٚ بیاکھ قٲبلِ ذِکر چیز: زرٕد رنٛگُک اکھ گُر اوس چونکہِ سُہ اوس بٮ۪مار مگر تس ٲسؠ زٕ سوار۔ گۅڈنِکس سوارس اوس ناو سُہ یُس لوٗکن مرنُک بٲعث بنان چُھ تہٕ بیاکھ یُس تمِس پتہٕ کنہِ گُرس پیٚٹھ بہِتھ اوس یمسُنٛد ناو اوس سۅ جاے یوٚت مودؠ مٕتؠ لوٗکھ گژھان چھِ۔ خداین کوٚر یِمن سوارن دنیا کٮ۪ن سارنےٕ لوٗکن ہُنٛد ژورِم حصہٕ مارنُک طاقت عطا۔ تِم ہیٚکن تِمن جنٛگ، قحط یا وبٲئی بٮ۪مارٮ۪ن ہنٛدِ بہانہٕ یا ہیٚکن جنٛگلی جانور آبٲدی والیٚن علاقن منٛز سوزِتھ تہٕ لوٗکن مٲرِتھ۔
\v 9 پتہٕ کھول کٹہٕ برن مومس ولِتھ پٲنٛژِم طومار تہٕ تُجنس مُہر۔ ییٚلہِ تمؠ تہِ کوٚر، تہٕ مےٚ وُچھ، آسمانس \f + \fr 6‏:9 \ft یہِ چھُ زنتہٕ ہیکلس برونہٛہ کنہِ قربان گاہُک ہم منصب\f*منٛز اکِس قربان گاہس تل تِمن لوٗکن ہنٛدؠ روح یمہٕ باقیٚو یمہِ کِنؠ مٲرؠ مٕتؠ ٲسؠ زِ تِمو اوس قٲبلِ بھروسہٕ گواہن ہنٛدِ حثیتہٕ خدایہ سُنٛد پٲغام وفادٲری سان ونمُت۔
\v 10 یِمو روحو دیُت بڈِ ہٹہِ خدایس ناد، "اے مٲلکہٕ! ژٕ چُھکھ ہمیشہٕ بہتر کران تہٕ صحی فٲصلہٕ نِوان، لہٰذا کٔرؠ تو مہربٲنی کٔرِتھ زمین پیٚٹھٕ کٮ۪ن تِمن لوٗکن ویٚشران تہٕ بیٚیہِ دی توکھ سزا یمو أسؠ قتل کٔرؠ"
\v 11 پتہٕ دیُت خداین تِمو منٛزٕ پرٛتھ أکس جامہٕ دار لباس۔ خداین ووٚن تِمن ہنا صبٕر کرنہٕ باپتھ، تکیازِ بییہِ تہِ ٲسؠ کینٛہہ لوٗکھ یمہٕ مرن وٲلؠ ٲسؠ امہِ بجایہ زِ تِم کرن یسوعسؔ پیٚٹھ ایمان تھاونہٕ نِشہٕ انکار۔ مگر یُتھےٕ تِم سٲری مودؠ، خدا دییہِ تِمو، منٛز سارنے لوٗکن سزا یمو تِم قتٕل کٔرؠ تہٕ تِم لوٗکھ کٔرِکھ قتٕل یہنٛدؠ روح ووٚنؠ جنتس منٛز چھِ۔
\v 12 پتہٕ وُچھ مےٚ کٹہٕ برٕ مومُک شییِم ٹُکرٕ مُژران یمِچ مُہر طومارس ٲس۔ ییٚلہِ تمؠ یہ کوٚر تہٕ زمین لٔج زورٕ زورٕ ہِلنہِ۔ آفتابس لوٚگ گرہُن، زنتہٕ لٲگِن کریہنِس ژھاولؠ سنٛز جٔژ ہنٛدؠ ؤنمٕتؠ ماتمی پلو، زوٗن ٲس پوٗرٕ تہٕ گےَ تیژ سورخ یوٗت خوٗن چھُ\f + \fr 6‏:12 \ft یشعیا 29.6؛ یوایل 2.10؛ حجی 2.6؛ مرقُس 13.8\f*۔
\v 13 پتہٕ آے تارک آسمانہٕ پیٚٹھٕ زمینس لاینہٕ۔ تِم پیی تِتھٕ کنؠ زنتہٕ انجیر کُلِس پتھ کُن رودؠ مٕتؠ انجیر تیز ژھٹہِ سٟتؠ کُلیٚن دٕنن گٔژھِتھ پتھر پیٚوان چھِ\f + \fr 6‏:13 \ft مکاشفہ 8:10، متی 24:29، متی 24:29، مرقُس 13:25\f*۔
\v 14‏ آسمان پھوٚٹ تہٕ آو دۅشویٚو اندو وٹنہٕ، یتھ پٲٹھؠ اگر زن طومارس زٕ حصہٕ گژھن دۅشوٕیو انٛدو چُھ وٹنہٕ یوان، تمام پہاڑ تہٕ جزیرٕ تہِ ڈٔلؠ پننہِ پننہِ جایہِ نِش\f + \fr 6‏:14 \ft مکاشفہ 16:20، یشعیا 34:4\f*۔
\v 15 پتہٕ ژاے زمین پیٚٹھٕکؠ تمام لوٗکھ، حطاکہِ بادشاہ، حٲکمِ اعلیٰ، فوجی افسر، امیر تہٕ با اثر لوٗکھ تہِ گۅپھن تہٕ گارن منٛز بالہٕ پلن انٛدر ژوٗرِ روزنہِ\f + \fr 6‏:15 \ft یشعیا 2:10، 19\f*۔
\v 16 تِمو ووٚن پہاڑن تہٕ کنٮ۪ن، اسہِ پیٚٹھ پیٚتھ تھٲے تو اسہِ ژورِ، یُتھ نہٕ اسہِ آسمانس منٛز تختس پیٚٹھ بہِتھ خدا اسہِ وُچھِتھ ہیٚکہِ۔ تہٕ یِتھ پٲٹھؠ ہیٚکہِ نہٕ اسہِ کٹہٕ برٕ سزا دِتھ\f + \fr 6‏:16 \ft ہوشِیعؔ 10.8، لوق 23:30\f*۔
\v 17 تکیازِ از چُھ سُہ وہناک دوٚہہ یمہِ دوٚہہ خدا تہٕ برٕ تِمن لوٗکن سزا دِن یِمو غلط کوٚر تہٕ أسؠ چھِ زانان زِ اسہِ منٛزٕ چُھنہٕ کانٛہہ تہِ بے گناہ"
\c 7
\p
\v 1 یمو واقہو پتہٕ وُچھ مےٚ ژور فرشتہٕ زمینس پیٚٹھ وۅدٕنؠ۔ اکھ اوس مےٚ شمال انٛدٕ کھڑا، اکھ مشرقہٕ طرفہٕ بیاکھ جنوب کِنؠ تہٕ اکھ اوس مغرب پاسہٕ۔ تِم ٲسؠ یمو طرفو ینہٕ وول واو زمینس، سمندرس یا کُنہِ کُلِس ینہٕ نِشہٕ رُکاوان۔ \f + \fr 7‏:1 \ft یرمیاہ 49:36، دانی ایل 7:2، زکر 6:5\f*
\v 2 پتہٕ وُچھ مےٚ پانس کُن بیاکھ فرشتہٕ مشرق طرفہٕ یوان۔ امِس فرشتس اوس اتھس منٛز اکھ آلہٕ یُس پٔزِس خدایہ سُنٛد نشانہٕ بناوِہے۔ أمؠ فرشتن کوٚر تِمن ژورن فرشتن کُن بڈِ آلو یمن خداین زمینس تہٕ سمندرس کُن پکن وول واو رُکاونُک اجازت دیُتمُت اوس۔
\v 3 أمؠ فرشتن ووٚن یِمن ژۅن فرشتن، "ٹھہریو، گۅڈٕ تھاوو أسؠ تِمن نفرن نشانہٕ یمن سٲنِس خدایس پیٚٹھ پژھ چھےٚ تہٕ تمسنٛز عبادت کران چھِ، تہنٛدِس ڈٮ۪کس تراوو مُہر، تۅتام مہٕ رُکٲیو واو زمینس، سمندرس یا کُنہِ کُلِس ینہٕ نِشہٕ"\f + \fr 7‏:3 \ft عزر 9:4\f*
\v 4 پتہٕ تھوو فرشتن تہٕ تمسنٛدیٚو سٲتھی فرشتو تِمن سارنےٕ لوٗکن نشانہٕ ترٲوِتھ یِمو خدایس ایمان اوٚن تہٕ تمسنٛز فرمانبردٲری کٔر۔ مےٚ بوز کُستام اوس یہ ونان زِ یِمو کٲتیاہ لوٗکھ کٔرؠ نشان زد۔ یمہٕ ٲسؠ اسرائیل کیٚو ساروےٕ قبیلو منٛزٕ اکھ لچھ ژویتٲجی ساس نفر۔
\v 5 فرشتو کٔرؠ یہُوداؔ قبیلٕکؠ باہ ساس نفر مُہر ترٲوِتھ نشان زد۔ تِمو کٔرؠ روبن قبیلٕکؠ باہ ساس نفر تہِ نشان زد۔ جد قبیلہٕ کٮ۪ن تہِ ترووُکھ باہ ساس نفرن نشانہٕ۔
\v 6 فرشتو تُھوو آشرؔ قبیلہٕ کٮ۪ن بہن ساسن نفرن مُہر ترٲوِتھ نشانہٕ۔ تِمو کٔرؠ نفتٲلی قبیلکؠ تہِ باہ ساس نفرن تہٕ منسیؔ قبیلہٕ منٛزٕ تہِ باہ ساس نفر نشان زد۔
\v 7 فرشتو تروو شمعونؔ قبیلہٕ کٮ۪ن بہن ساسن نفرن مُہر ترٲوِتھ نشان تہٕ لاوی قبیلہٕ کٮ۪ن تہِ بہن ساسن نفرن تہٕ اشکار قبیلہٕ منٛزٕ تہِ تھووُکھ بہن ساسن نفرن نشانہٕ۔
\v 8 فرشتن تھوو مُہر ترٲوتھ زبولونؔ قبیلہٕ کٮ۪ن بہن ساسن نفرن نشانہٕ۔ یوسف سنٛدِ قبیلہٕ منٛزٕ تہِ ترووُکھ بہن ساسن نفرن نشانہٕ۔ بنیمینؔ قبیلہٕ منٛزٕ تہِ آو بہن ساسن نفرن مُہر ترٲوِتھ نشانہٕ تھاونہٕ۔
\v 9 یمو واقعاتو پتہٕ وُچھ مےٚ اکھ قٲبلِ ذِکر چیز: لوٗکن ہُنٛد اکھ بوٚڈ بارٕ ہجوم! ہجومس منٛز ٲسؠ تیٖتؠ لوٗکھ یمن نہٕ کانٛہہ شمار کرِتھ ہیٚکہِ ہے۔ تِم ٲسؠ پرٛتھ کُنہِ قومٕکؠ، قبیلہٕ تہٕ لوٗکن ہنٛدیٚو ونٛڈو منٛزٕ آمٕتؠ، تہٕ ٲسؠ پرٛتھ کانٛہہ زبان بولن وٲلؠ۔ تِم ٲسؠ سٲری تختس برُونٛہہ کنہِ ۅدٕنؠ، یتِتھ کٹہٕ برٕ اوس۔ تِمن سارنےٕ ٲسؠ جامہٕ دار سفید چۅغہٕ لٲگِتھ، تہٕ آسکھ خزٕر کُلٮ۪ن ہنٛزٕ لنجہٕ اتھن کٮ۪تھ۔
\v 10 تِم ٲسؠ بڈِ بڈِ کرٮ۪کہٕ دِوان، "سٲنؠ خداین، یُس سارنی چیزن ہُنٛد حکمران چُھ، چھِ أسؠ بچٲومٕتؠ، کٹہٕ برن چھِ اسؠ بچٲو مٕتؠ" \f + \fr 7‏:10 \ft مکاشفہ 19:1، زبور 3:8\f*
\v 11 پتہٕ سپٕدؠ تمام فرشتہٕ تختس، بزرگن تہٕ ژورن جاندارن انٛدؠ پٔکؠ کھڑا۔ سٲری فرشتہٕ ٲسؠ تختس برُونٛہہ کنہِ زمینس چونٛٹ دِتھ خدایہ سنٛز عبادت کران۔
\v 12 ساروےٕ فرشتو ووٚن، "آ، یی بنِن! اے سانہِ خدایہ، أسؠ چھی ہمیشہ ژےٚ تعریف، شُکر و ثنا تہٕ تعظیم کران! أسؠ چھِ ہمیشہٕ باپتھ یہ اعلان کران زِ ژٕ چُھکھ عقلمنٛد، طاقتور تہٕ مضبوط! یی سپدِن"
\v 13 پتہٕ ووٚن مےٚ أکؠ بزرگن، "بہٕ چُھس یہ ثیقہٕ بناوُن یژھان زِ ژٕ گژھکھ زانُن زِ یِم لوٗکھ کمہٕ چھِ یِمن جامہٕ لٲگِتھ چھِ تہٕ یِم کتہِ پیٚٹھٕ چھِ آمٕتؠ"
\v 14 مےٚ دیُت تمِس جواب، "جناب مےٚ چھےٚ تُہنٛز ضرورت زِ توٚہؠ ؤنیٚو مےٚ زِ یِم کمہٕ چھِ" پتہٕ ووٚن تمؠ مےٚ: "یِم چھِ، تِم لوٗکھ یمہٕ بڈِ ظُلمہٕ ستمہٕ وزِ یسوعؔ سنٛدؠ وفادار رودؠ۔ امہِ سٟتؠ چُھ ظٲہِر سپدان زِ یِم ٲسؠ یسوعسؔ پیٚٹھ بھروسہٕ کرِتھ گُنہو نِش پاک سپدؠ مٕتؠ، یمؠ صلیبس پیٚٹھ مرنہٕ وزِ یمو باپتھ پنُن خوٗن دیُت۔ \f + \fr 7‏:14 \ft مکاشفہ 22:14\f*
\v 15 اوے چھِ یِم خدایہ سنٛدِس تختس برُونٛہہ وۅدٕنؠ روزِتھ۔ تِم چھِ کُنہٕ اژھیٚنؠ پٲٹھؠ تمسنٛدِس ہیکلس  اندر خدایہ سنٛز عبادت کران۔ خدا، یُس آسمانس پیٚٹھ تختس بہِتھ حکومت کران چُھ کرِ یہنٛز حفاظت۔ \f + \fr 7‏:15 \ft مکاشفہ 22:3، زبور 134:1-2\f*
\v 16 خدا بناوِ یہ کتھ یقینی زِ تِمن آسہِ کھیٚنہٕ باپتھ ہمیشہِ وٲفِر کھیٚن۔ خدا بناوِ یہ کتھ تہِ یقینی زِ تِمن آسہِ چیٚنہٕ باپتھ تہٕ کٲفی بدس۔ آفتابُک تژر ہیٚکہِ نہٕ تِمن پتہٕ زانٛہہ تہِ زٲلِتھ۔ آفتابُک گرم ہیٚکہِ نہٕ تِمن پتہٕ زانٛہہ تہِ کمزور کرِتھ۔ \f + \fr 7‏:16 \ft یشعیا 49.10\f*
\v 17 یہ چُھ اوٕ موٚکھٕ تکیازِ کٹہٕ برٕ یُس تختس نِش چُھ کرِ یہنٛز رٲچھ راوٹ یتھ پٲٹھؠ پوٚہل پننٮ۪ن تیرن ہنٛز رٲچھ راوٕٹ کران چُھ۔ برٕ بناوِ تِمن ابدی زنٛدگی حٲصِل کرنس قٲبِل، تِتھ کنؠ زنتہٕ تِم ناگو منٛزٕ چیٚوان آسن یتہِ شوٚد تہٕ صاف آب نیران چُھ۔ خداے کرِ تِمن مدد یُتھ تِم ودُن تراون تہٕ خۅشی پراون۔ \f + \fr 7‏:17 \ft زبور 23:1-2، یشعیا 25:8 \f*
\c 8
\p
\v 1 پتہٕ کھول کٹہٕ برن مومُک ستِم ٹُکرٕ یتھ منٛز طومار بنٛد اوس۔ ییٚلہ تمؠ تہِ کوٚر تہٕ کینٛژس کالس آیہ نہٕ آسمانہٕ پیٚٹھٕ کانٛہہ تہِ آواز۔
\v 2 پتہٕ وُچھ مےٚ تِم ستھ فرشتہٕ یِم خدایس ذٲتی خٲدِم ٲسؠ۔ تمؠ دیُت تِمن سارنی اکھ اکھ نرسنگا۔
\v 3 پتہٕ آو بیاکھ اکھ فرشتہٕ تہٕ رود قربان گاہس پیٚٹھ وۅدٕنؠ۔ تمِس اوس بخور زالنہٕ باپتھ اتھس منٛز سۅنہٕ سُنٛد پیالہٕ۔ خداین دیُت تس واریاہ بخور پننٮ۪ن لوٗکن ہنٛدین دُعاہن سٟتؠ خدایہ سنٛدِس تختس برُونٛہہ کنہِ سۅنہٕ سنٛدِس قربان گاہس پیٚٹھ زالنہٕ باپتھ۔ \f + \fr 8‏:3 \ft مکاشفہ 5:8\f*
\v 4 فرشتن لوگ بخور زالُن۔ بخور زالنٕکہِ بانہٕ منٛزٕ یُس فرشتس اتھِ اوس وُتھن وول دُہہ کھۅت لوٗکن ہنٛدین دُعاہن سٟتؠ خدایس نِش۔ \f + \fr 8‏:4 \ft زبور 141:2\f*
\v 5 پتہٕ تُل فرشتن سۅنہٕ سُنٛد بخورُک پیالہٕ تہٕ برِنس قربان گاہ کہِ نارچہِ ژنہِ۔ پتہٕ دِژن تِم ژِنہِ تہٕ دزوُن بخور زمینہِ پیٚٹھ دٔرِتھ۔ ییٚلہ تِم تہِ کوٚر تہٕ وُزملہٕ ہیٚژن چمکٕنہِ تہٕ گگرایہ لجہِ گرٮ۪زنہِ تہٕ زمین لرزییہِ۔
\v 6 پتہٕ گے تِم ستھ فرشتہٕ یِمن پرٛتھ کانٛسہِ اتھِ نرسنگا اوس تتھ پھۅکھ دنہٕ خٲطرٕ تیار،
\v 7 پتہٕ ہیٚوت گۅڈنِکؠ فرشتن نرسنگا وایُن تہٕ گوو ڈوٹھ تہٕ نار ظٲہِر۔ اتھ ڈوٹھس تہٕ نارس منٛزس اوس خوٗن۔ یہ سورےٕ پیٚو زمینس پیٚٹھ۔ امؠ نارن ژھُن خوشک زمینہِ پیٚٹھ پرٛتھ کُنہِ چیزُک تریٚیِم حصہٕ، کُلیٚن ہُنٛد تریٚیِم حصہٕ تہٕ سورےٕ سبٕز گاسہٕ زٲلِتھ۔ \f + \fr 8‏:7 \ft عزر 38:22\f*
\v 8 پتہٕ ووے دویِم فرشتن پنُن نرسنگا، تہٕ کیاہتام یُس اکھ بوٚڈ بارٕ پہاڑ ہیٚو اوس یُس دزان اوس، پیٚوو سمندرس منٛز۔ امہِ سٟتؠ سپُد سمندرُک ترییِم حصہٕ خوٗنےٕ خوٗن، \f + \fr 8‏:8 \ft خروج 7:17، یرمیاہ 51:25\f*
\v 9 سمندرس منٛز موجود جاندارن ہُنٛد ترییِم حصہٕ سپُد ختم تہٕ جہازن ہُنٛد ترییِم حصہٕ ڈُبیاے سمندرس منٛز۔
\v 10 پتہٕ وُوے ترییِم فرشتن نرسنگا یمہِ سٟتؠ اکھ بوٚڈ تارُک آسمانہٕ پیٚٹھٕ وسِتھ آو یُس تِتھ پٲٹھؠ چمکان اوس زن اوسُس نار ہیٚوتمُت۔ تارکٕکؠ کینٛہہ ٹُکرٕ پیہ دریاون ہنٛدِس تریٚیمِس حِصس تہٕ زمینہِ پیٚٹھ آبہٕ ناگن ہنٛدِس تریٚیمِس حِصس پیٚٹھ۔
\v 11 تارکُک ناو اوس ناگدونا۔ ییٚلہ یہ دریاوٕ کِس تہٕ ناگہٕ کِس تریمِس حصس منٛز پیٚو تہٕ تِمن ہُنٛد آب بنیاو زہریلہٕ۔ سُہ زہریلہٕ آب چیٚنہٕ سٟتؠ مودؠ واریاہ لوٗکھ۔ \f + \fr 8‏:11 \ft یرمیاہ 9:15\f*
\v 12 پتہٕ ووے ژورِم فرشتن نرسنگا تہٕ خداین وول آفتابس، زوٗنہِ تہٕ تارکن تیُتھ ٹاس زِ تِمن روو وقتکہِ تریٚمہِ حصہٕ خٲطرٕ پنُن گاشےٕ۔ دوٚہہ کِس تریمِس حصس چمکیاو نہٕ آفتابےٕ تہٕ نہ چمکییہِ رٲژ ہنٛدِس تریمِس حصس زوٗنےٕ تہٕ نہ ٲسؠ تارکےٕ زوتان۔ \f + \fr 8‏:12 \ft یشعیا 13:10، یوایل 2:10\f*
\p
\v 13 پتہٕ، ییٚلہ مےٚ نظر دِژ، مےٚ بوز اکھ عُقاب آسمانس پیٚٹھ واریاہ ہیٚور وُڈان تہٕ تھدِ ہٹہِ کریکہٕ دِوان، "ییٚلہ باقی ترےٚ فرشتہٕ زمینس پیٚٹھ نرسنگاہ واین تہٕ ترےٚ ہٲبت ناکھ چیز سپدن تِمن لوٗکن سٟتؠ واقہ یِم زمینس پیٚٹھ روزان آسن۔ تِم چھِ جلدے نرسنگا واین وٲلؠ"
\c 9
\p
\v 1 پتہٕ ووے پٲنٛژِم فرشتن تمسُنٛد نرسنگا تہٕ مےٚ وُچھ اکھ تارُک یُس آسمانہٕ پیٚٹھٕ زمینس پیٚٹھ پیمُت اوس۔ خداین دِژ تس اکہِ سرنہِ تہٕ انہِ گٔٹؠ چہٕچ کُنٛز۔ \f + \fr 9‏:1 \ft گلہِ روٚستُے دوب گوو سروٚن دوب\f*
\v 2 ییٚلہِ تٔمؠ یہ چاہ کھول تہٕ تورٕ لوٚگ سیٚٹھا مقدارس منٛز دٔہہ کھسنہِ، زنتہٕ سۅ اکھ دزٕ ؤنؠ بٔٹھؠ ٲس۔ یہ دٔہہ رُکاوِہے کانٛسہِ تہِ آفتابُک تہٕ زوٗنہِ ہُنٛد گاش وُچھنہٕ نِشہٕ۔ \f + \fr 9‏:2 \ft نوایل 2:10، 30\f*
\v 3 پتہٕ دراے امہِ دُہہ منٛزٕ ہالو تہٕ لٔگؠ زمینس پیٚٹھ پھٲلنہِ۔ خداین دیُت یِمن ہالون بِچن ہنٛدؠ پٲٹھؠ لوٗکن ٹۅپہٕ نُک طاقت۔
\v 4 خداین ووٚن ہالون زِ تِم کھیٚن نہٕ زمینہِ پیٚٹھٕ سورےٕ گاسہٕ، سٲری کُلؠ تہٕ کُلٮ۪ن پیٚٹھ سٲری پن تُلؠ" یہ زن عام طور ہالو کران چھِ" خداین ووٚن یِمن صرف تِمن لوٗکن ٹۅپہٕ دنہِ یہنٛدین ڈٮ۪کن پیٚٹھ سُہ نشانہٕ آسہِ نہٕ یُس ہاوان چُھ زِ یِمن چُھ خدایس سٟتؠ تعلق۔ \f + \fr 9‏:4 \ft عزر 9:4\f*
\v 5 خداین دیُت نہٕ ہالون تِم لوٗکھ مارنُک اِجازت۔ امہِ بجایہ رودؠ ہالو پانٛژن ریتن لوٗکن تکلیف واتناوان۔ یِمو لوٗکو یۅسہٕ دگ محسوس کٔر سۅ ٲس تِژھےٕ دگ یژھ بِچہٕ ٹۅپہِ سٟتؠ ۅتھان چھےٚ۔
\v 6 اتھ دوران ییٚلہِ ہالو تِمن لوٗکن تکلیف دِوان ٲسؠ یِم خدایس سٟتؠ تعلق تھاونس انکار کران ٲسؠ۔ تِمن لوٗکن اوس تیوٗت تکلیف زِ تِم یژھٕ ہن مرُن۔ مگر خدا بنٲو یہ کتھ یقینی زِ لوٗکھ روزن زنٛدٕ پننٮ۪ن گُنہن ہُنٛد سزا تُلنہٕ باپتھ۔ \f + \fr 9‏:6 \ft ایوب 3:21، یرمیاہ 8:3\f*
\v 7 ہالو ٲسؠ جنٛگہٕ باپتھ تیار گُرین ہنٛدؠ پٲٹھؠ لبنہٕ یوان۔ تِہنٛدین کلن پیٚٹھ ٲسؠ سۅنہٕ سنٛدؠ تاج ہی نظرِ گژھان۔ تِہنٛدؠ بُتھؠ ٲسؠ انسان بُتھؠ باسن۔ \f + \fr 9‏:7 \ft یوایل2:4\f*
\v 8 تِمن اوس زنٮ۪ن ہنٛدؠ پٲٹھؠ زیوٹھ مس۔ تِہنٛدؠ دنٛد ٲسؠ سٕہہ دنٛدن ہنٛدؠ پٲٹھؠ مضبوط۔
\v 9 تِمن ٲسؠ دھاتو بنیامٕتؠ سینہٕ سِپر نٲلؠ ترٲوِتھ۔ ییٚلہ تِم وُڈان ٲسؠ تہٕ تِہنٛدیٚو پرو سٟتؠ اوس سُہ شور ۅتلان زنتہٕ واریاہ گُرؠ جنٛگس پیٚٹھ درامٕتؠ رتھس لمان ٲسؠ۔
\v 10 تِمن ہنٛزٕ لچہٕ آسہٕ بِچن ہنٛزن لچن ہنٛدؠ پٲٹھؠ۔ تِمو سٟتؠ ہیٚکہٕ ہن تِم لوٗکن ٹۅپہٕ دِتھ۔ یِمن پانٛژن ریتن اوس تِمن لوٗکن نقصان واتناونہٕ باپتھ یِمنےٕ لچن منٛز طاقت۔
\v 11 یُس بادشاہ تِمن پیٚٹھ حکومت کران اوس سُہ اوس سرنہِ تہٕ انہِ گٔٹؠ چہُک فرشتہٕ۔ عِبرٲنؠ زبٲنؠ منٛز ٲسؠ تمِس ابدونؔ\f + \fr 9‏:11 \ft ابدون گوو عِبرٲنؠ زبٲنؠ منٛز تبٲہی\f* تہٕ یونٲنؠ زبٲنؠ منٛز اپلیون ونان۔ یِمن دوٚنونی ناون ہُنٛد مطلب چُھ "تباہ کرن وول"
\v 12 پانٛژھ ریٚتھ گٔژھِتھ دراے یِم ہالو۔ یتھ کنؠ ووت گۅڈنیُک خوفناک واقعہٕ انٛد۔ مگر یاد تھٲوؠ زیٚو زِ بییہِ زٕ خوفناک واقعہٕ چھِ وُنہِ باقی۔
\v 13 پتہٕ ووے شییِم فرشتن نرسنگا تہٕ مےٚ بوز سۅنہٕ سنٛدیو قربان گاہو ہنٛدیٚو ژۅنویٚو کوٗنو پیٚٹھٕ اکھ آواز یۅسہٕ خدایہ سنٛزِ بارگاہِ منٛز چھےٚ۔
\v 14 یہ آواز ٲس شیمِس فرشتس ونان یمِس اتھِ نرسنگا اوس، "تِم ژور فرشتہٕ تراوُکھ یلہٕ یِم مےٚ فرات دریاوس پیٚٹھ بنٛد تھٲوؠ"
\v 15 پتہٕ سپٕدؠ تِم ژور فرشتہٕ آزاد۔ تِم ٲسؠ أتھؠ وقتس پراران۔ تِم سپٕدؠ آزاد تاکہ تِم ہیٚکہٕ ہن پننِس فوجس اتھ قٲبِل بنٲوِتھ زِ تِم مارن انسانن ہُنٛد ترییِم حصہٕ۔
\v 16 مےٚ بوز کُستام اوس یہ ونان زِ گُرٮ۪ن پیٚٹھ کٲتیاہ سِپاہ ٲسؠ سوار۔ تِمن ہُنٛد تعداد اوس وُوہہ کرور۔
\v 17 رویا ہس منٛز وُچھ مےٚ زِ گُرؠ تہٕ تِمن پیٚٹھ سوار فوجی کِتھؠ ٲسؠ باسان۔ سِپہو ٲسؠ سینہٕ بنٛد گنٛڈمٕتؠ یمہٕ نارٕکؠ پٲٹھؠ وۅزٕلؠ، نیٖلم ہی نیٖلؠ تہٕ گنٛدک یہ لیٚدٕرؠ ٲسؠ۔ گُرٮ۪ن ہنٛدؠ کلہٕ ٲسؠ سٕہن ہنٛدؠ کلہٕ ہی۔ تِہنٛدیٚو ٲسو منٛزٕ اوس نار، دٔہہ تہٕ دزٕوُن گنٛدک دٔہہ نیران۔
\v 18 تِمو تریٚنوٕیو چیزو نارٕ، دُوہہِ تہٕ گُرین ہنٛدِ ٲسہٕ منٛزٕ نیرن والہِ گنٛدکہٕ سٟتؠ مود ترییِم حصہٕ لوٗکن ہُنٛد۔
\v 19 مگر گُریٚن اوس تِہنٛزن لچن منٛز تہِ طاقت تہٕ تِہنٛدِس ٲسس منٛز تہِ۔ تِہنٛدؠ لچہِ ٲسؠ سرفن ہنٛدؠ پٲٹھؠ تہٕ تِمن ٲسؠ کلہٕ یمہٕ لوٗکن ٹۅپہٕ دِوان ٲسؠ۔
\v 20 مگر امہِ باوجود ٲسؠ تِتھؠ کینٛہہ لوٗکھ یِم نہٕ نارٕ، دُہؠ تہٕ دزوٕنؠ گنٛدک تووونہٕ سٟتؠ مودؠ۔ تِم لوٗکھ ٲسؠ نہٕ گناہ کرنہٕ نِشہٕ پوٚت ہیٚوان۔ تِمو ترٲو نہٕ بد روحن تہٕ بُتن ہنٛز پرستِش کرٕنؠ تہِ، یمہٕ تِمو سۅنہٕ سنٛدؠ، رۅپہٕ سنٛدؠ، سرتلہِ، کنٮ۪ن تہٕ ہچو بنٲوؠ مٕتؠ ٲسؠ۔ لوٗکو ترٲو نہٕ بُت پرستی حالانکہِ تِم آسہٕ بےٚ زُو موٗرژٕ یِم نہٕ لوٗکن مدد کرِتھ ہیٚکہَن۔ \f + \fr 9‏:20 \ft 1 کورنتھ 34:25\f*
\v 21 تِم پھیرؠ نہٕ باقی لوٗکھ قتٕل کرنس، جٲدؠ گری کرنس، بدکٲری تہٕ چیٖز ژوٗرِ نِنس پتھ۔
\c 10
\p
\v 1 پتہٕ وُچھ مےٚ رویا ہس منٛز بیاکھ اکھ طاقتور فرشتہٕ آسمانہٕ پیٚٹھٕ بوٚن کُن وسان۔ سُہ آو اکِس ابرٕ لنٛگس منٛز ہیٚنہٕ۔ تمِس ٲس کلس پیٚٹھ سونٛزل۔ تمسُنٛد بُتھ اوس آفتابٕکؠ پٲٹھؠ چمکان۔ تمسنٛزٕ زنٛگہٕ آسہٕ نارو سِتون ہشہٕ چمکان۔
\v 2 تمسنٛدِس اتھس منٛز اوس اکھ لۅکُٹ طُمار یُس مُژرٲوِتھ اوس۔ تٔمؠ تھوو پنُن دٔچُھن کھۅر سمندرس منٛز تہٕ کھووُر کھۅر زمینس پیٚٹھ۔
\v 3 سُہ اوس بڈِ بڈِ کرٮ۪کہٕ دِوان زنتہٕ سٕہہ گرٮ۪زان اوس۔ ییٚلہ سُہ کرٮ۪کہٕ دِوان اوس، مےٚ بوز ستن وُزملن تہٕ گگراین ہنٛز آواز۔ گگراین منٛز ٲسؠ تِم الفاظ یِم بہٕ سمجھِتھ ہیٚکہٕ ہا۔
\v 4 بہٕ اوسُس تمہٕ کتھٕ درج کران وول یمہٕ گگرایو ونہِ مژٕ آسہٕ۔ مگر پتہٕ آیہ آسمانہٕ پیٚٹھٕ بیاکھ آواز، "یہ کینٛژھا گگرایو ووٚن تہِ تھٲیو پوشیدٕ، تمہٕ مہٕ کٔریٚو درج!"\f + \fr 10‏:4 \ft دانی ایل 8:26، 12:4\f*
\v 5 پتہٕ پلنوو تٔمؠ فرشتن پنُن دچھُن اتھٕ آسمانس کُن یمسنٛز اکھ لتھ مےٚ سمندرس تہٕ دویِم زمینس پیٚٹھ وُچھ یُتھ سُہ اکھ حلف ہیٚکہِ تُلِتھ۔ \f + \fr 10‏:5 \ft دانی ایل 32:40\f*
\p
\v 6 تٔمؠ پرُژھ خدایس یُس ابدی روزن وول چُھ تہٕ یمؠ پرٛتھ کانٛہہ چیز پٲدٕ کوٚر یُس موجود چھُ، یتھ کتھِ تصدیق کرنہٕ باپتھ زِ یہ تٔمؠ ووٚن تہِ چُھ پوٚز۔ فرشتن ووٚن زِ خدا یہ کینٛژھا کرنُک اِرادٕ کرُن یژھان چُھ تہِ کرنس منٛز کرِ نہٕ سُہ ووٚنؠ مذید دیری۔
\v 7 تٔمؠ ووٚن زِ ییٚلہِ ستمِس فرشتس نرسنگا وایہ نُک وقت واتہِ تہٕ خدا واتناوِ پنُن پوشیدٕ منصوبہٕ انٛد۔ یہےَ کتھ چھےٚ خداین پننٮ۪ن بنٛدن نبین ونمٕژ۔ \f + \fr 10‏:7 \ft عاموس 3:7، اِفِسیوں 3:3\f*
\v 8 پتہٕ یُس مےٚ آسمانہٕ پیٚٹھٕ کتھٕ کران بوز، تٔمؠ کوٚر دُبارٕ مےٚ سٟتؠ کلام۔ تٔمؠ ووٚن، گژھ ہُمِس فرشتہٕ سنٛدِ اتھس منٛز کھولِتھ یہ طُمار ان یُس سمندرس تہٕ زمینس پیٚٹھ وۅدٕنؠ چُھ۔
\v 9 بس، بہٕ گوس فرشتس نِش تہٕ تمِس ووٚنُم زِ سُہ دییہِ مےٚ لۅکُٹ طُمار۔ تہٕ تمؠ ووٚن مےٚ، "یہ رٹھ تہٕ کھیٚیہ، ییٚلہِ ژٕ یہ کھیٚکھ تہٕ امیُک مزٕ آسہِ مانٛچھ ہیٚو، مگر ییٚلہِ ژٕ یہ کھیٚکھ ژےٚ کری امہِ سٟتؠ یٔڈ دود"\f + \fr 10‏:9 \ft عزر3:1-3\f*
\v 10 لہٰذا رۅٹ مےٚ فرشتہٕ سنٛدِ اتھٕ منٛزٕ لۅکُٹ طُمار تہٕ کھیوم۔ ییٚلہِ مےٚ یہ کھیٚو تہٕ امیُک مزٕ اوس مانٛچھ ہیٚوٗ مگر کھیٚتھ باسیاو مےٚ زٕ مےٚ کرٕن یٔڈ دگ۔
\v 11 پتہٕ ووٚن مےٚ کٔمؠ تام، ژےٚ چھی واریہن قومن، واریہن لوٗکن ہنٛزن جمٲژن، بیٚون بیٚون زبان بولن والیٚن تہٕ واریہن بادشاہن متعلق خدایہ سُنٛد پٲغام دوبارٕ بوزناوُن۔
\c 11
\p
\v 1 پتہٕ دیُت مےٚ أکؠ فرشتن اکھ نرکون یُس اکِس مینن وٲلِس گزس ہِیو اوس۔ خداین ووٚن مےٚ، "مینِس ہیکلس منٛز گژھ تہٕ سُتہِ تتھ منٛز موجود قربان گاہ مینُن تہٕ عبادت کرن وٲلؠ گنٛزراوُکھ۔
\v 2 مگر ہیکلچہ جایہ ہُنٛد نیٚبرِم صحنہٕ مینہِ زٮ۪ن نہٕ مےٚ دِتُے سُہ غٲر یہُودؠ لوٗکہٕ جمٲژن۔ یمہِ کِس نتیجس منٛز تِم یروشلم شہرس منٛز روزن والیٚن پیٚٹھ 42 ہن ریٚتن تام ظلُم کرن۔
\p
\v 3 بہٕ سوزکھ زٕ گواہ یمہٕ یہ اعلان کرن یُس بہٕ تِمن پیٚٹھ اکھ ساس زٕ ہتھ تہٕ شیٹھن دوہُن تام ظٲہِر کرٕ تِم کرن جنٛدٕ پلو لٲگِتھ ظٲہِر یمہٕ کانٛسہٕ ژھاوِلؠ والن ؤنؠ مٕتؠ آسن زِ تِم چھِ لوٗکن ہنٛدین گُنہن پیٚٹھ غمگین۔ \f + \fr 11‏:3 \ft دویتٲجی ریٚتھ\f*
\v 4 تِمہٕ گواہ چھِ تِم یہنٛز نمایندگی زیتونٕکؠ زٕ کُلؠ تہٕ زٕ ژٲنگؠ تار کران چھِ۔ تِم کُلؠ تہٕ ژٲنگؠ تار چھِ خداوند سنٛزِ حضوری منٛز، یُس زمینس پیٚٹھ حکومت چھُ کران۔ \f + \fr 11‏:4 \ft زکر 4.1-14\f*
\v 5 وۅنؠ اگر کانٛہہ یِمن گواہن نقصان واتناونٕچ کوشش کران چُھ تہٕ تِم چھِ پننیٚو عٲسو منٛزٕ نار چھکن تہٕ تِمن زٲلِتھ ژھنان۔ یتھٕ پٲٹھؠ مارن تِم زٕ گواہ سیٚکہٕ پٲٹھؠ کٲنٛسہِ اکِس تہِ یُس تِمن زکھ واتناوُن یژھِ۔
\p
\v 6 تِمن گواہن آسہِ اختیار زِ تِم تراون نہٕ تمہِ ساعتہٕ آسمانہٕ پیٚٹھٕ بٲرِش ییٚلہ تِم تمہِ کتھ، ہُنٛد اعلان کران آسن یۅسہٕ خدا تِمن پیٚٹھ ظٲہر کران آسہِ۔ تِمن آسہِ جیلن تہٕ کۅلن ہُنٛد آب خوٗنی بناونُک تہِ اختیار حٲصل۔ تِمن آسہِ زمینس پیٚٹھ رنٛگہٕ رنٛگہٕ تووون اننُک اختیار تہِ حٲصل۔ تمہٕ کرن یم چیز تمہِ وقتہٕ ییٚلہ تِم محسوس کرن زِ یہ چُھ تہنٛدِس پٲغامس پیٚٹھ خدا زور دِوان۔
\v 7 مگر ییٚلہِ تِم خدایہ سنٛدِ طرفہٕ پننہِ پٲغامُک اعلان کرُن سپداون، سُہ جانور کھسہِ سرنہِ انہِ گٹہِ کھۅڈٕ منٛزٕ ہیٚور تہٕ کرِ تِمن پیٚٹھ حملہٕ۔ جانور دییہِ تِمن شِکس تہٕ ژھنیٚکھ مٲرِتھ۔
\p
\v 8 وۅنؠ ٲسؠ دونوے گواہ عظیم شہرس منٛز خدایہ سنٛدِ پٲغامُک اعلان کران یتھ لوٗکھ علامتی طور سدومؔ ونان ٲسؠ تکیازِ اتِکؠ لوٗکھ ٲسؠ واریاہ بد۔ لوٗکھ ٲسؠ اتھ شہرس مِصر تہِ ونان تکیازِ اتِکؠ لوٗکھ ٲسؠ خدایہِ سنٛدین لوٗکن سٟتؠ بُرٕ سلوک کران۔ یہ چُھ سُہ شہر تہِ یتہِ یسوعؔ یمسنٛز خدمت گواہ کران ٲسؠ، صلیبس پیٚٹھ مود۔ گواہن ہنٛز بے عزتی کرنہٕ خٲطرٕ دفناون نہٕ شہرٕکؠ لوٗکھ تِہنٛزٕ لاشہٕ۔ تمہٕ تراون تہنٛزٕ لاشہٕ شہرٕ کِس کھلہٕ مٲدانس منٛز۔
\v 9 واریہن لوٗکن ہنٛزٕ جمٲژ، قبیلہٕ، مختلف زبانن ہنٛزٕ جمٲژ تہٕ قومن ہنٛدؠ لوٗکھ وُچھن ساڑن تریٚن دوٚہن تِمن لاشن۔ مگر شہرٕکؠ لوٗکھ دِن نہٕ کانٛسہِ تِمہٕ لاشہٕ مقبرس منٛز  دفناونُک اجازت۔
\p
\v 10 خدایس تعظیم نہ کرن وٲلؠ لوٗکھ ییٚلہ وُچھان چھِ زِ گواہ سپدؠ فوت تِمن سپدِ واریاہ مسرت تہٕ مناون شٲدیانہٕ۔ تہٕ یہ خۅشی مناونہٕ باپتھ نِن تِم اکھ اکِس تحفہٕ۔ تِم آسن سیٚٹھاہ خۅش تکیازِ تِم زٕ نبی گُذریاے یمو تِمن وباہ تُل یمہ سٟتؠ تِمن تکلیف ووت۔
\v 11 مگر ساڑِ ترییہِ دوٚہؠ پتہٕ کرِ خدا تِمن بییہِ زنٛدٕ۔ تِم روزن نہٕ مۅردٕ بٔنِتھ ڈاف ترٲوِتھ تہٕ گژھن اِستادٕ! یِم لوٗکھ تِمن دوبارٕ زنٛدٕ وُچھن تمن گژھِ دہشت۔
\v 12 پتہٕ بوزن دوٚنوے گواہ تھدِ اکھ آسمٲنی آواز یۅسہٕ تِمن ونان آسہِ: " ؤلیٚو کھسیٚو ہیٚور" پتہٕ کھسن تِم اُبرٕ منٛزؠ آسمانس کُن۔ تِہنٛدؠ دشمن وُچھن تِمن ہیٚور کھسان۔
\v 13 تمی ساعتہٕ ییہِ اکھ بوٚڈ بنیُل یمہِ سٟتؠ شہرٕ کٮ۪ن مکانن ہُنٛد دہِم حصہٕ ؤسؠ پیٚیہِ۔ یمہِ سٟتؠ ستھ ساس نفر ہلاک سپدن۔ باقی لوٗکھ سپدن سیٚٹھاہ خوفزدہ تہٕ کرن یہ کتھ تسلیم زِ پٔزؠ خداین دیُت تِمن یِمن گواہن قتل کرنہٕ باپتھ جٲیِز سزا۔
\p
\v 14 سُہ آسہِ دویِم خوفناک واقعہٕ۔ خبردار روزؠ زیٚو زِ امہ پتہٕ جلدی سپدِ ترییِم خوفناک واقعہٕ رونما۔
\v 15 پتہٕ ووے سٔتِم فرشتن نرسنگا تہٕ آسمانہٕ پیٚٹھٕ گےَ آوازٕ بُلنٛد، "سون خداوند خدا تہٕ مسیحؔ یُس تٔمؠ مقرر کوٚرمُت چُھ کرِ ووٚنؠ دنیا کٮ۪ن تمام لوٗکن پیٚٹھ حکومت، تِم روزن ہمیشہٕ تِمن تمام لوٗکن پیٚٹھ حکومت کران۔ \f + \fr 11‏:15 \ft دانی ایل 7:27، زکر 14:9\f*
\v 16 تِم 24 بُزرگ یِم خدایہ سنٛدِس تختس انٛدؠ انٛدؠ تختن پیٚٹھ بہِتھ ٲسؠ سپٕدؠ سربسجود تہٕ کٔرٕکھ تمسنٛز عبادت۔
\v 17 تِمو ووٚن:
\q1 اے خداوند خدایہ، ژٕ چُھکھ پرٛتھ چیزس پیٚٹھ حکومت کرن وول!
\q1 ژےٕ چُھکھ یُس ووٚنؠ موجود چُھ!
\q1 ژےٕ چُھکھ یُس ہمیشہٕ روزن وول چُھ!
\q1 أسؠ چھِ چٲنؠ مشکوٗر زِ ژےٚ دِتُتھ پننہِ طاقتہٕ سٟتؠ،
\q1 پرٛتھ کانٛسہ تس نفرس شکس یمؠ ژےٚ سٟتؠ بغاوت کٔر،
\q1 تہٕ ووٚنؠ چُھکھ ژٕ دنیا کٮ۪ن تمام لوٗکن پیٚٹھ حکومت کران۔
\q1
\v 18 قومن ہنٛدین بے اعتقاد لوٗکن اوس تُہنٛد زبردست شرارتھ۔
\q1 یمہِ کِنؠ توٚہہ تِمن سزا دِتو۔ \f + \fr 11‏:18 \ft زبور 2:1\f*
\q1 ژےٚ نیوٗتھ فٲصلہٕ زِ چانہِ باپتھ چُھ تِمن سارنی لوکن ہنٛدِس حقس منٛز یہ فٲصلہٕ نِنُک صحی وق یمہٕ گُذریمٕتؠ چھِ۔
\q1 ژٕ چُھکھ پننٮ۪ن تِمن بنٛدن انعام دِوان یِم چون پٲغام بوزناوان تہٕ توٚہہ سٟتؠ تعلق تھاوان چھِ۔
\q1 ژٕ چُھکھ تِمن تمام لوٗکن انعام دِوان یِم توٚہہ عزت کران چھِ، یُس تہِ کانٛہہ آسہِ۔
\q1 ژےٚ نیوٗتھ فٲصلہٕ زِ ووٚنؠ ووت وقت زِ ژٕ کرہکھ تِم لوٗکھ حلاک یِم زمینس پیٚٹھ تبٲہی کران رودؠ مٕتؠ چھِ۔
\p
\v 19 پتہٕ کھولؠ خداین آسمانس پیٚٹھ پننہِ ہیکلٕکؠ دروازٕ تہٕ تتھ منٛز وُچھ مےٚ سُہ مقدس صندوق یتھ منٛز خدایہِ سنٛدؠ وعدٕکؠ نشانہٕ ٲسؠ۔ یمہِ منٛزٕ وُزملہٕ آسہٕ چمکان۔ مےٚ بوز گگراین ہُنٛد گرٮ۪زُن۔ زمین الییہِ، تہٕ آسمانہٕ پیٚٹھٕ ؤتھؠ ویٹھؠ ڈوٹھٕ پٔھلؠ۔ \f + \fr 11‏:19 \ft مکاشفہ 15:5\f*
\c 12
\p
\v 1 پتہٕ سپُد آسمانس پیٚٹھ واریاہ اہم چیز ظٲہر۔ یہ ٲس اکھ مستور یۅسہٕ پننیٚو پلوو رنگؠ آفتاب ؤلِتھ ٲس۔ سۅ ٲس زوٗنہِ پیٚٹھ ۅدٕنؠ۔ تمسںنٛدِس کلس اوس تاج دِتھ یُس بہَن تارکن ہُنٛد بنیٚومُت اوس۔
\v 2 سۅ ٲس بچہٕ دنہٕ واجِنؠ۔ سۅ ٲس دگہِ سٟتؠ کریکہٕ دِوان تکیازِ تمِس اوس بچس زایُن دیُن واریاہ مشکِل۔
\v 3 پتہٕ سپُد آسمانس پیٚٹھ بییہِ اکھ اہم چیز نمودار۔ یہ اوس اکھ بوٚڈ وۅزُل اژدھا۔ تمِس ٲسؠ ستھ کلہٕ تہٕ داہ ہینٛگ۔ پرٛتھ کُنہِ کلس پیٚٹھ اوسس شٲہی تاج۔
\v 4 أمؠ اژدھاہن أنؠ لچہِ سٟتؠ آسمانٕکؠ ترےٚ حصہٕ تارک وٹِتھ تہٕ دتِن زمینس پیٚٹھ درِتھ۔ اژدھا سپُد تمِس خاتونہِ برُونٛہہ کنہِ کھڑا یۅسہٕ بچس زایُن دنہٕ واجِنؠ ٲس یُتھ سُہ بچس زیٚوان زیٚوانےٕ کھیٚیہ ہے۔
\p
\v 5 پتہٕ دیُت تمہِ مستوراتہِ اکِس گوٚبرس زایُن۔ سُہ چھُ تمام لوٗکہٕ جمٲژن پیٚٹھ لوریٚو حکومت کرنُک مکمل اختیار ہیٚتھ آمُت۔ خداین نیٚو سُہ بچہٕ حفاظتہٕ باپتھ تُلِتھ تہٕ واتنووُن آسمانس منٛز پننِس تختس پیٚٹھ۔
\v 6 مگر مستور ژٔج اکِس وٲران علاقس کُن۔ خداین ٲس تمسنٛدِ باپتھ اکھ جاے تیار تھٲومٕژ یتہِ لوٗکھ بہن شتن تہٕ شیٹھن دوہُن تمسنٛز رٲچھ راوٕٹ کرن۔
\p
\v 7 پتہٕ ؤژھ آسمانس منٛز لڑٲے۔ مِیکائیلن تہٕ تمسنٛدیٚو ماتحت فرشتو کٔر اژدھاہس سٟتؠ لڑٲے۔ اژدھا تہٕ تمسنٛدیٚو فرشتو کٔر میکائیل تہٕ تمسنٛدین فرشتن سٟتؠ واپس لڑٲے۔
\v 8 مگر اژدھاہن ہور یہ جنٛگ تہٕ خداین دیُت نہٕ پتہٕ اژدھاہس تہٕ تمسنٛدین فرشتن آسمانس پیٚٹھ روزنُک اِجازت۔
\v 9 بلکہِ دیُت خداین بوٚڈ اژدھا آسمانہٕ پیٚٹھٕ بوٚن دٔرِتھ۔ یہ اژدھا چُھ سُے بد روح یُس واریاہ برُونٛہہ اکھ سرف بنِتھ ظٲہر گٔیاو۔ یمِس ابلیس تہٕ شیطان ونان ٲسؠ۔ سُہ چھُ دنیاہس منٛز روزن وٲلِس پرٛتھ کانٛسہِ فردس دونٛکھٕ دِوان۔ خداین دیُت سُہ تہٕ تمسنٛدؠ تمام فرشتہٕ زمینس پیٚٹھ بوٚن دٲرِتھ۔ \f + \fr 12‏:9 \ft یوناہ 12:31\f*
\p
\v 10 پتہٕ بوز مےٚ آسمانہٕ پیٚٹھٕ بڈِ بڈِ کُس تام تھدِ ہٹہِ کریکہٕ، \f + \fr 12‏:10 \ft مکاشفہ 11:15\f*
\q1 ووٚنؠ بچٲوؠ سٲنؠ خداین پننہِ طاقتہٕ سٟتؠ پنٕنؠ لوٗکھ، تہٕ سُہ چُھ سارنی لوٗکن پیٚٹھ حکومت کران!
\q1 تہٕ ووٚنؠ کٔر تسنٛدؠ مسیحنؔ حکومت کرٕنؠ شروع!
\q1 یہ چُھ اوٕ موٚکھٕ زِ خداین ژھُن آسمانہٕ پیٚٹھٕ سانٮ۪ن سٲتھی ایمان والیٚن پیٚٹھ اِلزام لگاون وول بوٚن دٲرِتھ۔
\q1 سُہ اوس بار بار خدایس نِش یِتھ ایمان والیٚن پیٚٹھ غلط کام کرنُک اِلزام لاگان۔
\q1
\v 11 مگر سٲنؠ سٲتھی ایمان وٲلؠ سپٕدؠ تس پیٚٹھ غٲلِب۔ یہ چُھ اوٕ موٚکھٕ زِ کٹہٕ برن دیُت تِہنٛدِ باپتھ قربٲنی دِتھ پنُن خوٗن،
\q1 تہٕ اوٕ موٚکھٕ تہِ زِ تِمو ووٚن باقی لوٗکن تمِس متعلق پوٚز۔
\q1 تِم ٲسؠ نہٕ صرف زندٕ روزُن یژھان۔
\q1 تِم ٲسؠ مرنہٕ خٲطرٕ تہِ تیار اگر تمِس متعلق پوٚز وننہٕ خٲطرٕ ضرورت پییہِ ہے۔
\q1
\v 12 بس، توٚہؠ سٲری آسمانس پیٚٹھ روزن وٲلؠ منٲیو خوشی!
\q1 مگر توٚہہِ سٟتؠ یِم زمینس پیٚٹھ روزان چھِ تہٕ سمندری سفر کران چھِ ین ہولناک واقعات پیش تکیازِ ابلیس چُھ وۅنؠ توٚہہِ درمیان۔
\q1 تمِس چُھ سیٚٹھاہ شرارتھ تکیازِ سُہ چُھ زانان زِ تمِس چُھ کمےٕ وقت خدایہ سنٛز عدالت تہٕ تمسُنٛد سزا رٹنس۔
\p
\v 13 ییٚلہ اژدھاہس معلوم سپُد زِ خداین چھوٚک سُہ زمینس پیٚٹھ تہٕ تٔمؠ کٔر تس زنہِ پیٚٹھ حملہٕ کرنٕچ کوشش یمہِ اکِس گۅبرس زایُن دیُت۔
\v 14 مگر خداین دژٕ امِس زنہِ اکِس بڈِس عُقاب سنٛزٕ ہِشہٕ زٕ پکھٕ یمو سٟتؠ سۅ وٲران علاقس کُن وُڈو کرنس قٲبِل بنییہِ۔ خداین ٲس تتہِ تمسنٛدِ باپتھ اکھ محفوظ جاے تیار کرِتھ تھٲومٕژ۔ تتھ جایہ کٔر خداین ساڑن ترین ورین تمسنٛز رٲچھ راوٕٹ۔ سرف یعنی اژدھا اوس نہٕ تمسنٛزِ تتھ جایہ واتنس قٲبِل۔
\p
\v 15 پتہٕ تروو سرفن پننہِ عٲسہٕ کِنؠ تمِس زنہِ کُن آبُک سہلاب۔ سُہ اوس تس آبہٕ سٟتؠ یرٕ والُن یژھان۔
\v 16 مگر زمینن کوٚر زنہِ مدد۔ زمینس گو اکھ بوٚڈ وُل تہٕ اژدھا سنٛدِ عٲسہٕ منٛزٕ درامُت سہلاب گو امی وُلہِ کِنؠ زمینہِ تل۔
\v 17 پتہٕ کھۅت امِس اژدھا ہس امِس زنہِ پیٚٹھ زیادے شرارتھ یمہِ کِنؠ سُہ تمسنٛدین باقی شُریٚن سٟتؠ لڑنہِ دراو۔ یِم چھِ تِم لوٗکھ یِم خدایہ سنٛدین احکامن پیٚٹھ عمل کران چھِ تہٕ یِم یسوعسؔ متٮعلق پوٚز ونان چھِ۔
\v 18 پتہٕ رود اژدھا سمندر بٹِھس پیٚٹھ ۅدٕنؠ۔
\c 13
\p
\v 1 پتہٕ وُچھ مےٚ اکھ جانور سمندرٕ منٛزٕ ہیٚور کھسان۔ تمِس ٲسؠ داہ ہینٛگ تہٕ ستھ کلہٕ۔ تمِس اوس پرٛتھ ہینٛگس پیٚٹھ شٲہی تاج۔ امسنٛدِس پرٛتھ کُنہِ کلس پیٚٹھ اوس اکھ ناو یمہِ سٟتؠ خدایس توہین سپدان اوس۔ \f + \fr 13‏:1 \ft دانی ایل 7:3، مکاشفہ 12:3\f*
\v 2 یہ جانور اوس خر سٕہہ سنٛزِ چالہِ مگر امسنٛدؠ کھۅر ٲسؠ زنتہٕ ہاپتہٕ سنٛدؠ۔ امسُنٛد ٲس اوس سٕہہ سنٛدِ ٲسٕکؠ پٲٹھؠ۔ اژدھاہن بنوو سُہ جانور سیٚٹھاہ طاقتہٕ وول۔ تٔمؠ دیُت تس لوٗکن پیٚٹھ بادشاہ سنٛدِ حثیتہٕ حکومت کرنُک تہِ تھوٚد حق۔
\p
\v 3 امِس جانور سنٛدیو کلو منٛزٕ اوس اکھ کلہٕ تیٚوتھ باسان زنتہٕ یہ کانٛسہِ ہنٛدؠ دٔسؠ زخمی گژھِتھ مودمُت اوس۔ مگر سُہ زخم اوس بلیامُت۔ یمہِ کنؠ زمینس پیٚٹھ روزن وٲلؠ سٲری یہ جانور وُچھِتھ حٲران سپٕدؠ تہٕ کرٕکھ أمسنٛز اطاعت۔
\v 4 تِمو کٔر اژدھا سنٛز عبادت تکیازِ تٔمؠ چُھ تمِس جانورس تِمن پیٚٹھ حکومت کرنُک اختیار دیتمُت۔ تِم ٲسؠ جانور سنٛز تہِ عبادت کران۔ تِمو ووٚن "یمِس جانورس ہیٚوٗ طاقتور چُھنہٕ کانٛہہ، أمِس خلاف ہیٚکہ نہٕ کانٛہہ تہِ لڑِتھ"
\p
\v 5 اژدھاہن بنوو یہ جانور فخرٕ سان کتھ کرنس تہٕ خدا سنٛز توہین کرنس قٲبِل۔ اژدھاہن بنوو سُہ زمینس پیٚٹھ لوٗکن پیٚٹھ حکومت کرنس قٲبِل۔ مگر خدا دیہِ جانورس صرف 42 ریٚتن حکومت کرنُک موقہٕ۔
\v 6 ییٚلہ تہِ جانورن کتھ کٔر تٔمؠ کٔر خدایہ سنٛز توہین۔ یہ اوس ہاوان زِ خدایہ سنٛز حقیقت ٲس نہٕ دراصل تہِ یہ زن لوٗکھ تمِس متعلق یقین کران ٲسؠ۔ امؠ جانورن کٔر آسمٲنؠ لوٗکن ہنٛز تہِ توہین یِمن منٛز خدا روزان چھُ۔
\p
\v 7 اژدھاہن بنوو یہ جانور خدا سنٛدین لوٗکن خلاف لڑنہٕ تہٕ تِمن پیٚٹھ فتح پراونس قٲبِل۔ اژدھاہن دیُت امِس جانورس تہِ لوکن پیٚٹھ حکومت کرنُک حق چاہے تمسُنٛد تعلُق کُنہِ تہِ قبیلس سٟتؠ آسہِ یا کُنہِ تہِ جمٲژ سٟتؠ وابستہٕ آسہِ یا کانٛہہ تہِ زبان بولن وول آسہِ یا یتیُک تہِ روزان آسہِ۔ \f + \fr 13‏:7 \ft دانی ایل 7:21\f*
\v 8 زمینس پیٚٹھ روزن والیٚن کینٛژن لوٗکن ہنٛدؠ ناو چھنہٕ زندگی ہنٛزِ کتابہِ منٛز لیٚکِھتھ۔ تِم لوٗکھ تہِ کرن جانور سنٛز عبادت۔ زندگی ہنٛز کتاب چھےٚ کٹہٕ\f + \fr 13‏:8 \ft مارنہٕ آمُت چھُ یسوع مسیحؔ\f* برٕ سنٛز۔ کٹہٕ برن دیُت نجات دنہٕ وول بننہٕ موٚکھ دنیا کِس اپتداہسےٕ منٛز پنُن زوو۔
\p
\v 9 پرٛتھ کانٛہہ سُہ شخص یُس سمجھُن یژھان آسہِ بوزِن خدایہ سُنٛد یہ پٲغام غورٕ سان۔
\v 10 اگر کانٛسہِ ہنٛدؠ دشمن تمِس رٹُن یژھان آسن تہٕ تِم رٹن تس۔ اگر کانٛسہِ ہنٛدؠ دشمن تمِس تلوارِ سٟتؠ مارُن یژھن تہٕ تِم مارن تس تلوارِ سٟتؠ۔ لہٰذا پزِ خدا سنٛدین لوٗکن مصیبت برداش کرُن تہٕ تمسُنٛد وفادار روزُن۔ \f + \fr 13‏:10 \ft یرمیاہ 15:2، 43:11\f*
\p
\v 11 پتہٕ وُچھ مےٚ بیاکھ جانور زمینہِ منٛزٕ کھٔسِتھ یوان۔ تمسنٛدِس کلس پیٚٹھ ٲسؠ کٹہٕ سنٛدؠ پٲٹھؠ لۅکٕٹؠ زٕ ہینٛگ۔ مگر تمسنٛز آواز ٲس اژدھا سنٛزِ آوازِ ہِش۔
\v 12 زمین پیٚٹھُک یہ جانور چھُ سمندری جانور سنٛدؠ سٲری احکام پوٗرٕ کران۔ یہ چھُ زمین پیٚٹھٕ کٮ۪ن لوٗکن سمندری جانور سنٛز پرستِش کرنُک تقاضہٕ کران۔ یہ چُھ سُہ جانور یُس یہ دٔپؠ زِ تہِ ممُت چُھ مگر یمسُنٛد زخم ٹھیک چُھ گمُت۔
\p
\v 13 زمینہِ پیٚٹھٕکؠ جانورن تہِ کٔرؠ حٲرت انگیز معجزٕ۔ یۅتام زن آسمانہٕ اندرٕ زمینس پیٚٹھ نار وسنُک سبب بنیٚو یہ زن لوٗکھ وُچھان رودؠ۔ \f + \fr 13‏:13 \ft 1 سلاطین 18:24-29\f*
\v 14 اژدھاہن دیُت زمین ہنٛدِس پیٚٹھمِس جانورس سمندری جانور سنٛدِ بدلہٕ یِم معجزٕ کرنُک طاقت۔ زمین پیٚٹھٕکؠ درندن دیُت معجزٕ کرِتھ زمینہٕ پیٚٹھ روزن والیٚن لوٗکن دونٛکھٕ۔ یہ ونِتھ زِ توٚہؠ بنٲیو اکھ بُت یُس سمندری جانورس ہیٚوٗ آسہِ۔ یوہے اوس سُہ جانور یُس تلوارِ ہنٛدِ زخمہٕ پتہٕ تہِ زنٛدٕ رود یُس تس مرن وول باسان اوس۔
\p
\v 15 اژدھاہن دیُت زمینہِ پیٚٹھٕ کِس جانورس اتھ پۅتلِس زُو دِنُک طاقت۔ پتہٕ گو سُہ بُت یُس سمندرکِس جانورس ہِیو باسان اوس کتھ کرُن لایکھ۔ پتہٕ دیُت زمین پیٚٹھٕکؠ درندن حکم زِ یُس تہِ بُت سنٛز عبادت کرنہٕ نِشہٕ انکار کرِ سُہ ییہِ قتٕل کرنہٕ۔ \f + \fr 13‏:15 \ft دانی ایل 3:5-6\f*
\v 16 زمین پیٚٹھٕکؠ جانورن تہِ کوٚر پرٛتھ کانٛسہِ ہنٛدِس دٔچھنِس اتھس یا ڈٮ۪کس پیٚٹھ نشانہٕ تھاونُک مطالبہ۔ یہ آسہ خاص لوٗکن پیٚٹھ تہِ تہٕ عام لوٗکن پیٚٹھ تہِ لاگو۔ امیُک اطلاق سپدِ تِمن لوٗکن پیٚٹھ تہِ یِم امیر آسن تہٕ تِمن پیٚٹھ تہِ یِم غریب آسن۔ یہ آسہِ آزاد لوٗکن پیٚٹھ تہِ تہٕ غلام لوٗکن پیٚٹھ تہِ لاگو۔ یہ اسہِ سارنی پیٚٹھ عٲیِد!
\v 17 پتہٕ دیُت زمین پیٚٹھٕکؠ جانورن حکم زِ کانٛہہ تہِ ہییہِ یا کٕنہِ نہٕ کانٛہہ تہٕ چیز اگرنہٕ تس یہ نشانہٕ آسہِ۔ یہ نشانہٕ اۅس سمندر پیٚٹھٕ آمتِس جانور سُنٛد ناو یا سُہ نمبر یُس تمسنٛدِس ناوس سٟتؠ منسوٗب اوس۔
\p
\v 18 توٚہہِ پزِ یتھ متعلق دٲنشمندی سان سونٛچن: یس تہِ چیزن متعلق اصٕل پٲٹھؠ سمجھان چُھ سُہ ہیٚکہِ سمندرٕ منٛزٕ امِس جانور سنٛز شناخت نٔنؠ کٔڈِتھ۔ امیُک وجہ چُھ یہ زِ یُس نمبر امسنٛدِس ناوس سٟتؠ منصوب چُھ سُہ چُھ بنیٲدی طور اکِس آدمؔ سنٛدِ ناوٕچ نمایندگی کران۔ یہ نمبر چُھ شےٚ ہتھ تہٕ شٕہٲٹھ۔
\c 14
\p
\v 1 مگر پتہٕ وُچھ مےٚ برٕ یروشلم کِس صیون پہاڑس پیٚٹھ کھڑا۔ تمِس سٟتؠ ٲسؠ اکھ لچھ ژویتٲجی ساس نفر۔ تمؠ اوس تِہنٛدین ڈٮ۪کن پیٚٹھ پننِس ببہٕ سُنٛد ناو لیٚکِھتھ تھومُت۔
\v 2 مےٚ بوز آسمانہٕ پیٚٹھٕچ اکھ آواز تہِ۔ یہ ٲس تیٖژ بڈِ زنتہٕ کُنہِ بڈِ آبشارُک صدا اوس یا ٲس زبردست گرٮ۪زٕ ؤنؠ آواز۔ یتہِ اوس تیُتھ باسان زنتہٕ واریاہ لوٗکھ بربتن وایان ٲسؠ\f + \fr 14‏:2 \ft حزقی 43:2\f*۔
\p
\v 3 یہ آواز ٲس تِمن لوٗکن ہنٛز یمہٕ مےٚ اکھ نوو بٲتھ گیٚوان وُچھؠ۔ تِم ٲسؠ تختس تہٕ ژورن زنٛدٕ مخلوقن تہٕ بُزرگن برُونٛہہ کنہِ کھڑا۔ برٕ ٲسؠ تِم اکھ لچھ ژویتٲجی ساس نفر زمین پیٚٹھٕ کیٚو تمام لوٗکو منٛزٕ بچٲمٕتؠ۔ تِمے یٲتؠ ہیٚکہٕ ہن سُہ بٲتھ ہیٚچِھتھ۔
\v 4 تِم اکھ لچھ ژویتٲجی ساس نفر چھِ روحٲنی طور پاک یِتھ کنؠ زن انہرشہِ اخلٲقی طور پاک چھےٚ۔ تِمو چھنہٕ کانٛسہِ اپزِس خدایہ سنٛز عبادت کرِتھ پنُن پان ناپاک کوٚرمُت۔ یِم چھِ تِم یمہٕ یسوعسؔ سٟتؠ پکان چھِ، یُس اکِس برٕ سنٛدؠ پٲٹھؠ چھُ، یوٚت تہِ سُہ گژھان چھُ۔ تِم چھِ تِمن تمام لوٗکن ہنٛز نمایندگی کران یمہٕ تٔمؠ ونیُک تام زمینہِ ہنٛدیٚو لوٗکو منٛزٕ بچٲمٕتؠ چھِ۔ یمو لوٗکو یسوعسؔ پیٚٹھ ایمان اوٚن تِم کرن واریہن باقی فردن پانس سٟتؠ شٲمِل خدایس تہٕ یسوعؔ پیٚٹھ ایمان اننس منٛز۔
\v 5 تِمو لوٗکو کوٚر نہٕ زانٛہہ تہِ یسوعسؔ انکار۔ تِم ٲسؠ ہمیشہٕ پاک زندگی گُذاران۔
\p
\v 6 پتہٕ وُچھ مےٚ بیاکھ فرشتہٕ آسمانہٕ پیٚٹھؠ وُڈان۔ سُہ اوس آسمانہٕ پیٚٹھٕ خدایہ سنٛز پوشہٕ وٕنؠ خوش خبری انان یُتھ زمین پیٚٹھ روزن والیٚن نِش تمیُک اعلان کرِتھ ہیٚکہ ہے۔ سُہ کرِ پرٛتھ قومس، قبیلس، پرٛتھ کانٛہہ زبان بولن ولٮ۪ن تہٕ پرٛتھ قومہٕ چن جمٲژن منٛز امیُک اعلان۔
\v 7 تمؠ فرشتن ووٚن یہ سیٚٹھاہ بڈِ، "خدایہ سُنٛد تعظیم کٔریٚو تہٕ تمسنٛدؠ تعریف کٔریٚو تکیازِ ووٚنؠ ووت سُہ وق ییٚلہ سُہ پرٛتھ کانٛسہِ سٟتؠ انصاف کرِ، تمسنٛز عبادت کٔریٚو تکیازِ سُے چُھ آسمان، زمین، سمندر تہٕ تازٕ آب پٲدٕ کرن وول\f + \fr 14‏:7 \ft نحمیاؔہ 9:6، مُکاشفہ 4:11\f*۔
\p
\v 8 تہٕ امہِ پتہٕ آو بیاکھ فرشتہٕ۔ تہٕ أمؠ فرشتن ووٚن، "واریاہ بُرٕ شہر بابلؔ بنیاو پورٕ پٲٹھؠ کھنٛڈراتھ، بابلنؔ کٔرؠ پرٛتھ کُنہٕ قومٕکؠ لوٗکھ خدا سنٛز بے وفٲیی کرتھ بُتن ہنٛز پوٗزا کرنس پیٚٹھ مجبور، \f + \fr 14‏:8 \ft یشعیا 21:9، یرمیاہ 51:7 \f*
\p
\v 9 امہِ پتہٕ آو بیاکھ فرشتہٕ۔ أمؠ فرشتن ووٚن بڈِ، "اگر لوٗکھ جانور تہٕ تمسنٛزِ مورژِ ہنٛز عبادت کران چھِ یا کانٛسہِ پننِس اتھس یا ڈیٚکس پیٚٹھ تمسُنٛد نشان تراونُک اِجازت دِوان چھِ،
\v 10 تہٕ خدا دییہِ تِمن ضرور سزا، تمہِ سزا سٟتؠ یِن تِم اورٕ یور لاینہٕ زنتہٕ آسہِ تِمو انیٖکھ شراب چیٚمُت۔ سُہ دییہِ تِمن دزوٕنس گنٛدکس منٛز سزا یتھٕ پٲٹھؠ زن تمسنٛدؠ پاک فرشتہٕ تہٕ برہؔ وُچھان روزن۔ \f + \fr 14‏:10 \ft یشعیا 51:17\f*
\p
\v 11 نارُک دٔہہ یُس تِمن عِذا دِوان چُھ روزِ ہمیشہٕ باپتھ ۅتھان۔ خدا روزِ تِمن ہمیشہٕ اژھیٚنؠ پٲٹھؠ تکلیف دِوان۔ یہ سپدِ تِمن لوٗکن سٟتؠ یمہٕ امِس جانورس تہٕ امسنٛزِ موٗرژِ ہنٛز عبادت کران چھِ یا کانٛسہِ امسُنٛد ناو یمن پیٚٹھ لیٚکھنُک اِجازت دِوان چھِ۔
\v 12 خدایہ سنٛدؠ لوٗکھ چھِ تِم یِم خدایہ سُنٛد حکم مانان چھِ تہٕ یِم یسوعسؔ پیٚٹھ بھروسہٕ کران چھِ۔ تِمن پزن تِمہ کامہِ وفادٲری سان کرنہِ تکیازِ یِم خدایہ سنٛز نافرمٲنی کران چھِ تہٕ یسوعسؔ انکار کران چھِ تِمن پیٚن یِم عذاب تُلٕنؠ۔
\p
\v 13 پتہٕ بوز مےٚ اکھ شخص اوس آسمانہٕ پیٚٹھٕ ونان، "یہ لیٚکھیٚو: وُنکہِ پتہٕ کٲتیاہ خۅش قسمت چھِ تِم لوٗکھ یمہٕ یسوعسؔ پیٚٹھ وفادار ایماندارن ہنٛدؠ رنٛگؠ مران چھِ" خدایہِ سُنٛد پاک روح چُھ ونان، "آ، یہنٛدِ مرنہٕ پتہٕ پیٚن نہٕ یِمن مذید تکلیف برداشت کرٕنؠ۔ بلکہِ آسہِ یہ عیان زِ تِم ٲسؠ صحیح کامہِ کران"
\p
\v 14 پتہٕ وُچھ مےٚ بییہِ اکھ خاص چیز۔ مےٚ وُچھ اکھ سفید ابُر، تہٕ تتھ ابرس پیٚٹھ اوس کُستام بہِتھ یُس انسان ہیٚوٗ باسان اوس۔ تٔمؠ اوس پننِس کلس سۅنہٕ سُنٛد تاج دیتمُت۔ تمسنٛدِس اتھس منٛز اوس اکھ تیز دروت۔ \f + \fr 14‏:14 \ft دانی ایل 10:16\f*
\v 15 امہِ باوجود دراو آسمٲنؠ ہیکلہٕ منٛزٕ اکھ فرشتہٕ نیٚبر۔ أمؠ ووٚن ابرس پیٚٹھ بہِتھ نفرس سیٚٹھاہ بڈِ، "زمینس پیٚٹھ چُھ فصٕل پپیامُت۔ تہٕ یہ چُھ اناج لوننُک وقت، لہٰذا لاگ پننہِ دراتہِ سٟتؠ اناج لونُن"
\v 16 تہٕ یُس نفر اکِس انسانہٕ سنٛدؠ پٲٹھؠ نظرِ گژھان اوس تہٕ اوبرس پیٚٹھ اوس بہِتھ تٔمؠ نیٚو پننہِ دراتہِ سٟتؠ زمینس پیٚٹھ موجود تمام اناج لونِتھ۔
\p
\v 17 پتہٕ دراو بیاکھ شخص آسمانچہِ مقدسہِ منٛزٕ نیٚبر۔ امِس فرشتس تہِ اوس اکھ تیز دروت اتھس کیٚتھ۔
\v 18 بیاکھ فرشتہٕ تہِ دراو قربان گاہ منٛزٕ۔ یوٚہے چُھ سُہ یُس قربان گاہ کہِ نارُک خیال تھاوان چُھ۔ تٔمؠ ووٚن بڈِ ہٹہِ تمِس فرشتس یُس دروت ہیٚتھ اوس، "زمینس پیٚٹھ چھےٚ دچھ پپیمٕژ، لہٰذا کر زمینہِ ہنٛزو دچھِ کُجو پیٚٹھٕ دچھِ گۅرن ژٹنہٕ خٲطرٕ پنُن دروت استعمال۔ پتہٕ کرُکھ یِم دچھِ گۅرن جمع"
\p
\v 19 چناچہ فرشتن کوٚر دچھ ژٹنہٕ باپتھ پنُن دروت استعمال۔ پتہٕ ترٲو تٔمؠ دچھ اکِس بٔڈِس دچھِ حوضس منٛز یُس تمہِ جایہ ہنٛز نشاندہی کران چھُ یتہِ خدا لوٗکن تہنٛزن غلط کامٮ۪ن ہُنٛد سزا دییہِ۔
\v 20 خداین لتہٕ نٲوؠ یروشلم شہرٕ نیٚبر کُن دچھِ حوضس منٛز یِم دچھ۔ ییٚلہِ تٔمؠ یہ کوٚر مےَ کہِ حوضہٕ منٛزٕ لوٚگ گُرٮ۪ن ہنٛزن لاکمن تام خوٗن نیرنہ! یہ اوس تتھ مقدارس منٛز نیران زِ سٟتؠ بنییہِ اکھ کۅل یۅسہٕ ڈۅڈ میٹر سرٔنؠ تہٕ ترٮ۪ن ہتن کِلو میٹرن تام پھٲلِتھ ٲس۔ \f + \fr 14‏:20 \ft 2 میٹر سروٚن\f*
\c 15
\p
\v 1 پتہٕ سپُد آسمانہٕ پیٚٹھٕ بیاکھ اکھ اہم چیز نمودار۔ مےٚ وُچھ ستھ فرشتہٕ۔ خداین پُشرٲو تِمن یہ ذمہٕ دٲری زِ تِم دِن بٲغی نفرن ستو مختلف طریقو سزا۔ یہ چھےٚ ٲخری وِز ییٚلہ لوٗکن خدا یتھٕ پٲٹھؠ سزا دییہِ، تکیازِ یمو سزہو ذریعہ آسہِ تٔمؠ زمین پیٚٹھٕ کیٚن لوٗکن سُہ سورےٕ سزا دیتمُت یمکؠ تِم مستحق آسن۔
\p
\v 2 مےٚ وُچھ شیشُک اکھ بوٚڈ چپٹل حصہٕ تہِ یُس گاشہٕ سٟتؠ چمکان اوس۔ مےٚ وُچھ تِم لوٗکھ تہِ یمو امِس جانور سنٛز عبادت نہ کرنہٕ باوجود کانٛسہِ تہِ امِس جانور سنٛدِ ناوٕچ نمایندگی کرن والہ نمبرٕ نشانہٕ تراونُک اِجازت نہ دِتھ تمِس پیٚٹھ غلبہٕ پروو۔ تِم ٲسؠ شیشہٕ کِس بڈِس ستریارس پیٚٹھ کھڑا، تِم ٲسؠ بربتنؠ ہیٚتھ یِم خداین تِمن دِتمٕتؠ ٲسؠ۔
\p
\v 3 تِم ٲسؠ اکھ بٲتھ گیٚوان یتھ کنؠ زن خدایہ سنٛدؠ بنٛدٕ موسیٰ ہن واریاہ برُونٛہہ گیومُت اوس۔ یہ اوس سُے بٲتھ یُس ووٚنؠ برہؔ گیٚوان چُھ۔ تِمو گیٚوو، \f + \fr 15‏:3 \ft زبور 111:2، 139:14، 145:17\f*
\q1 "اے خداوند خدا، یُس پرٛتھ چیزس پیٚٹھ حکومت کران چُھ،
\q1 یہ کینٛژھا ژٕ کران چُھکھ تہِ چُھ سیٚٹھاہ شاندار!
\q1 ژٕ چُھکھ ہمیشہٕ پوٗرٕ پٲٹھؠ راستبٲزی سان کٲم کران۔
\q1 ژٕ چُھکھ ہمیشہٕ بادشاہ سنٛدؠ پٲٹھؠ حکومت کران!
\q1
\v 4 اے خداوند، ژےٚ کُس نہٕ کھوٚژی تہٕ ژےٚ کُس نہٕ کری عزت تکیازِ ژٕے یوت چُھکھ پاک۔ \f + \fr 15‏:4 \ft زبور 86:9، یرم 10:7، ملاکی 1:11 \f*
\q1 آ، پرٛتھ جمٲژ ہنٛدؠ لوٗکھ یِن تہٕ کرن ژےٚ برُونٛہہ کنہِ ڈٮ۪کہٕ پتھر ترٲوِتھ عبادت۔
\q1 تکیازِ ژےٚ دِتُتھ یہ ہٲوِتھ زِ ژےٚ کوٚرُتھ بہتر طریقہٕ سارنی سٟتؠ انصاف۔
\p
\v 5 پتہٕ وُچھ مےٚ زِ آسمٲنؠ ہیکلٕکؠ دروازٕ ٲسؠ ؤتھؠ، سُہ آسمٲنؠ ہیکل اوس زمینہِ پیٚٹھ موجود تمہِ خٟمٕکؠ پٲٹھؠ یتھ منٛز مقدس صندوق اوس۔
\v 6 تِم ستھ فرشتہٕ یہنٛز کٲم بٲغی لوٗکن ستو طریقو سزا دیُن اوس دراے ہیکل منٛزٕ نیٚبر۔ فرشتہٕ ٲسؠ صفا شیٖن ہی ریشم کپرٕکؠ پلو لٲگِتھ۔ تِمو آسہٕ پننٮ۪ن سیٖنن پیٚٹھ سُنہرؠ کپرٕچہ پچہِ تہِ گنٛڈِتھ تھاوِمژٕ۔
\p
\v 7 یِمو ژورو مخلوقو منٛزٕ دیُت أکؠ ستن فرشتن منٛز پرٛتھ اکِس اکھ سۅنہٕ سُنٛد پیالہٕ۔ پرٛتھ پیالس منٛز اوس یمو لوٗکو باپتھ یمو زن غلط کوٚرمُت اوس مختلف طریقو سزا۔ فرشتہٕ دِن یہ سزا خدایہ سنٛدِ طرفہٕ یُس ہمیشہٕ خٲطرٕ زندٕ روزن وول چھُ۔ \f + \fr 15‏:7 \ft زبور 119:137، 19:9\f*
\v 8 پتہٕ آو ہیکل دُوہہِ سٟتؠ یُس جلالہٕ وٲلِس تہٕ قادرِ مطلق خدا سنٛز موجودگی ظٲہِر کران چُھ برنہٕ۔ تہٕ یہ دٔہہ رود تۅتام اتہِ موجود یۅتام فرشتہٕ طاعونُک انتظام کران ٲسؠ۔ ییٚلہِ ستھ فرشتہٕ زمینہِ ہنٛدیٚن لوٗکن ستو بیوٚن بیوٚن طریقو سزا دِنٕچ کٲم انٛد واتناون، صرف تیٚلے ہیٚکہِ کانہٛہ شخص دُبارٕ ہیکلس انٛدر أژِتھ۔ \f + \fr 15‏:8 \ft یشعیا 6:4\f*
\c 16
\p
\v 1 پتہٕ بوز مےٚ ہیکلس منٛز اوس اکھ شخص بڈِ بڈِ فرشتن سٟتؠ کتھ کتھ کران یمِس اتھِ ستھ پیالہٕ ٲسؠ۔ تٔمؠ ووٚن تِمن، "یپٲرؠ نیریٚو تہٕ یہ کینٛژھا تُہنٛدین ستن پیالن منٛز چُھ تہِ ژھنیٚو زمینہِ پیٚٹھ پتھر، یتھ کنؠ دییہِ خدا لوٗکن تہنٛدیٚن گُنہن ہُنٛد سزا"
\p
\v 2 بس، گۅڈنیُک فرشتہٕ گو تہٕ یہ کینٛژھا تمسنٛدِس پیالس منٛز اوس تہِ دِتُن زمینس پیٚٹھ دٲرِتھ۔ امیُک نتیجہٕ دراو یہ زِ تِمن لوٗکن دراے خطرناکھ پھیٚپھر یمو جانور سنٛدین خدمت گارن پانس پیٚٹھ جانور سُنٛد ناو لیکھنُک اجازت دیتمُت اوس۔ یِمو جانور سنٛزِ موٗرژ پیٚٹھ پوٗزا کٔرمٕژ ٲس۔
\p
\v 3 پتہٕ دیُت بیٚکؠ فرشتن پننِس پیالس منٛز یہ اوسس تہِ سمندرس منٛز دٔرِتھ۔ یمہ سٟتؠ سمندرک آب خوٗنس منٛز تبدیل سپُد۔ سُہ خوٗن اوس موردن ہنٛدِ خوٗنٕکؠ پٲٹھؠ جمیومُت تہٕ بدبودار۔ سمندرس منٛز روزن واجِنؠ پرٛتھ کانٛہہ زوذاتھ مویہِ۔
\p
\v 4 پتہٕ دیُت ترییِم فرشتن یہ پیالس منٛز اوسُس تہِ زمینہِ ہنٛزن کۅلن تہٕ ناگن منٛز دٔرِتھ۔ تمیُک نتیجہِ دراو یہ تِمن ہُنٛد آب سپُد خوٗنس منٛز تبدیل۔
\v 5 پتہٕ بوز مےٚ فرشتہٕ خدایس ونان یُس یِمن آبن ہُنٛد ذمہٕ وار اوس، "اے خدا، ژٕ چُھکھ موجود تہٕ چھُکھ ہمیشہٕ موجود رودمُت، ژٕ چُھکھ سیٚٹھاہ پاک، ژٕ چُھکھ لوٗکن جان پٲٹھؠ انصاف کرن وول۔
\v 6 یِمو لوٗکو ژےٚ خلاف بغاوتھ کٔر تِمو کٔرؠ چٲنؠ پاک لوٗکھ تہٕ انبیا قتٕل یمہِ کِنؠ ژٕ تِمن آبہٕ بدلہٕ خوٗن چیٲوِتھ سزا چُھکھ دِوان۔
\v 7 پتہٕ بوز مےٚ قربان گاہُک جواب، "آ، خداوند خدایہ ژٕ یُس پرٛتھ کُنہِ چیٖزٕچ حکمرٲنی کران چُھ، چُھکھ لوٗکن پوٗرٕ پٲٹھؠ پزرٕ سان سزا دِوان۔ \f + \fr 16‏:7 \ft زبور 119:137، 19:9\f*
\p
\v 8 پتہٕ دیُت ژورِم فرشتن تہِ یہٕ تس پیالس منٛز اوس تہِ آفتابس پیٚٹھ دٔرِتھ۔ نتیجہ دراو یہ زِ امہِ سٟتؠ سپُد آفتاب تیوٗت گرم زِ تٔمؠ زٲلؠ لوٗکھ خطرناکھ پٲٹھؠ۔ \f + \fr 16‏:8 \ft یشعیا 44:27\f*
\v 9 چونکہ آفتابن زٲلؠ لوٗکھ سیٚٹھاہ بُرٕ پٲٹھؠ یمہ کِنؠ تِمو خدایس متعلق بُرٕ کتھٕ ونہِ۔ تکیازِ سُہ اوس تِمن تِمو طریقو سزا دِنُک طاقت تھاوان۔ مگر تِمو کوٚر توتہِ بُرٕ کامیٚو نِشہٕ پتھ پھیرنس اِنکار تہٕ تِمو کوٚر تمسنٛدؠ تعریف کرنہٕ نِشہٕ انکار۔
\p
\v 10 پتہٕ یہ کینٛژھا پانٛژمِس فرشتس پیالس منٛز اوس تٔمؠ پھیُر سُہ جانور سنٛدِس تختس پیٚٹھ۔ نتیجہ دراو یہِ زِ یتہِ پیٚٹھٕ جانور حکومت چلاوان اوس تتہِ گییہِ تٲریکی۔ اتہِ سپٕز ہمیشہٕ باپتھ روتل، یِمن لوٗکن پیٚٹھ جانور حکومت کران اوس تِم لگؠ پننٮ۪ن خوفناک زخمن ہنٛز دگ وارے محسوس کرنہِ۔ چونٛکہِ تِم ٲسؠ امہِ دگہِ سٟتؠ پنٕنؠ زیٚو ژاپان۔
\v 11 تِمو ووٚن آسمانس پیٚٹھ حکومت کرن وٲلِس خدایس تہِ بُرٕ بلہِ تکیازِ تِہنٛدؠ زخم ٲسؠ سیٚٹھاہ تکلیف دہہ۔ مگر تِمو کوٚر غلط کامہِ کرنہٕ نِشہٕ پتھ روزنس انکار۔
\p
\v 12 پتہٕ دیُت شییِم فرشتن تہِ سورےٕ دریاے فُراتس منٛز دٲرِتھ یہ تس پیالس منٛز اوس نتیجہ دراو یہ زِ دریاے فراتُک آب گو خۅشک یُتھ زن مشرقی ملکن ہنٛدؠ حکمران پننِس فوجس سٟتؠ یہ عبور کرِتھ ہیٚکن۔
\v 13 پتہٕ وُچھ مےٚ ترےٚ بد روح یمہِ مِنہ مونٛڈجن ہی ٲسؠ۔ اژدھا سنٛدِ عٲسہٕ منٛزٕ دراو اکھ۔ اکھ دراو جانور سنٛدِ عٲسہٕ منٛزٕ تہ بیاکھ دراو اپزِس نبی سنٛدِ عٲسہٕ منٛزٕ۔
\v 14 ووٚنؠ ٲسؠ تِم روح بدروح یِم معجزٕ کرٕنؠ لایکھ ٲسؠ۔ تِم گےَ پنُن فوج جمع کرنہٕ باپتھ سارے زمینہِ ہنٛدین حکمرانن نِش۔ سُہ فوج کرِ تمہِ اہم دۅہہ جنٛگ ییٚلہِ قدرتہٕ وول خدا پننٮ۪ن دشمنن سزا دییہِ۔
\p
\v 15 مےٚ بوٗز خداوند یسوعؔ یہ ونان زِ توٚہؠ بوزیٚو میانؠ کتھ غورٕ سان: بہٕ چھُس اکِس ژوٗرٕ سنٛدؠ پٲٹھؠ یِنہٕ وول یمِچ نہٕ امیدے ٲس۔ یہ چُھ تِمن لوٗکن باپتھ بہتر یمہٕ بیٚدار روزن تہٕ صحی پٲٹھؠ زندگی گذارن۔ تِم سپدن نہٕ میانہِ واپس ینہٕ پتہٕ شرمنٛدٕ۔ تِم آسن بلکُل تمِس شخصہ سنٛدؠ پٲٹھؠ یُس پنٕنؠ پلو ہیٚتھے لٲگِتھ آسن یُتھنہٕ سُہ باقی لوٗکن برُونٛہہ کنہِ شرمندٕ سپدِ۔
\v 16 بد روحو کٔرؠ حکمران تژھِ اکِس جایہ جمع یتھ عِبرٲنؠ زبٲنؠ منٛز ہرمِجدون ونان چھِ۔
\p
\v 17 پتہٕ دیُت ستِم فرشتن پننہِ پیالہٕ منٛزٕ یہِ کینٛژھا اوس تہِ دٔرِتھ۔ امیُک نتیجہ دراو، کٔمؠ تام ووٚن ہیکل کہ تختہٕ پیٚٹھٕ سیٚٹھاہ بڈِ، "خداین واتتنوو وۅنؠ بٲغی لوٗکن سزا دیُن انٛد"
\v 18 پتہٕ تروو وُزملو گاہ، گگرایہ گرٮ۪زییہِ تہٕ زمین ہِلییہِ زبردس پٲٹھؠ۔ اتھ سٲرسےٕ زمانس منٛز اوس نہٕ یوٗت طاقتور بنیُل زانٛہہ تہِ گمُت ینہٕ لوٗکھ زمینس پیٚٹھ بسان ٲسؠ۔ \f + \fr 16‏:18 \ft متی 24:21\f*
\v 19 امہِ بنلہِ سٟتؠ گو اتھ عظیم شہرس تریٚن حصن منٛز پھاس۔ خداین کٔرؠ باقی قومن ہنٛدؠ شہر تہِ تباہ۔ خداین مٔشروو نہٕ یہ زِ بابلؔ کیٚو لوٗکو چھِ واریاہ گناہ کٔرمٕتؠ۔ اوٕ کِنؠ وُچھنٲوؠ تٔمؠ یم یِتھیٚن سزہن ہُنٛد مزٕ یمِکؠ تِم حقدار ٲسؠ۔
\p
\v 20 امہِ بنلہِ سٟتؠ سپُد پرٛتھ اکھ جزیرٕ غٲب تہٕ بالن گو سمستور۔
\v 21 پتہٕ پیی لوٗکن پیٚٹھ آسمانہٕ بڈؠ بڈؠ ڈوٹھٕ پٔھلؠ، اکھ اکھ پھوٚل اوس 33 کِلو۔ پتہٕ ووٚن لوٗکو خدایس متعلق بُرٕ بلہٕ تکیازِ تمؠ دیُت تِمن تِم بڈؠ بڈؠ تہٕ گۅبؠ ڈوٹھٕ پٔھلؠ ترٲوِتھ خوفناک سزا۔ \f + \fr 16‏:21 \ft تقریباً اوس پنژاہ کلو وزن پرٛتھ اکِس\f*
\c 17
\p
\v 1 یمو ستو فرشتو منٛزٕ یِمن اتھِ پیالہٕ ٲسؠ آو اکھ مےٚ نِش۔ تٔمؠ ووٚن، "ۅلہٕ مےٚ سٟتؠ، بہٕ چُھسے ژےٚ ہاوُن یژھان زِ خدا کیٚوتھ سزا دییہِ تس بدکار فحش زنہِ یۅسہٕ ژٕ اکِس بٔڈس دریاوس نزدیک بہِتھ وُچھتھن۔
\v 2 زمین کیٚو بادشاہو کٔر تِمن بُتن ہنٛز عبادت یِمن ہنٛز سۅ یژھان ٲس تِم گٔژھؠ عبادت کرٕنؠ۔ یِمن لوٗکن پیٚٹھ تِم حکومت کران ٲسؠ تِمو تہِ کٔر تِمن بُتن ہنٛز عبادت۔ باسان اوس زِ یِم چھِ شراب کِس نشس منٛز یُس تمہ تِمن دیُتمُت اوس"
\p
\v 3 پتہٕ دیُت مےٚ پاک روحن الہام یمہِ سٟتؠ مےٚ رویاہس منٛز بوزِتھ تہٕ چیز وُچھِتھ ہیٚکہٕ۔ فرشتن نیوٗس بہٕ دوٗر اکِس وٲران علاقس منٛز۔ تتہِ وُچھ مےٚ اکھ زٔنؠ یۅسہٕ اکِس وۅزلِس جانورس پیٚٹھ سوار ٲس۔ جانورس ٲسؠ سٲرسےٕ پانس پیٚٹھٕ ناو لیٚکِھتھ۔ یِم ٲسؠ تِتھؠ ناو یمو سٟتؠ خدایہ سنٛز توہین سپدان ٲس۔ امِس جانورس ٲسؠ ستھ کلہٕ تہٕ داہ ہینٛگ۔
\v 4 ووٚنؠ ٲس یہ زٔنؠ وانٛگٕنؠ تہٕ وۅزٕلؠ پلو لٲگِتھ۔ تمِس ٲسؠ سۅنہٕ سنٛدؠ زیور قٟمتی کرانٛکھ تہٕ مۅختہٕ لٲگِتھ۔ تمسنٛدِس اتھس منٛز اوس سۅنہٕ سُنٛد پیالہٕ۔ سُہ پیالہٕ اوس کمہِ تام چیٚنہٕ چیزٕ سٟتؠ برِتھ یُس تِمن خوفناک کامٮ۪ن ہُنٛد اظہار کران چُھ ییٚلہ سۅ جنسی بدکٲری ہنٛز عمل کران چھِ۔
\v 5 تہٕ تمسنٛدِس ڈٮ۪کس پیٚٹھ اوس اکھ ناو لیٚکِھتھ۔ اتھ ناوس اوس اکھ پوشیدٕ مطلب۔ سُہ ناو اوس: عظیم بابلؔ، پاژھنٮ۪ن تہٕ دنیاہس منٛز غٲر اخلٲقی چیزن ہنٛز موج۔ \f + \fr 17‏:5 \ft مکاشفہ 19:2\f*
\p
\v 6 مےٚ وُچھ سۅ زٔنؠ ٲس ووٚنؠ خمارٕ ۂژ بنیمٕژ تکیازِ تمہِ اوس خدایہ سنٛدین بندن ہُنٛد خوٗن چیٚمُت۔ تِمو لوٗکو ٲسؠ یسوعسؔ متعلق پزر وننہٕ باپتھ تکلیف تُلمٕتؠ۔ ییٚلہِ مےٚ سۅ وُچھ تمہِ کوٚرس بہٕ سیٚٹھاہ حٲران۔
\p
\v 7 فرشتن پرُژھ مےٚ زِ یہ گٔژھےٕ نہٕ ژےٚ حٲران کرٕنؠ، بہٕ ونے ژےٚ زنہِ تہٕ امِس جانور سُنٛد پوشیدٕ مطلب یمِس پیٚٹھ یہ سوار چھےٚ، امِس جانورس چھِ ستھ کلہٕ تہٕ داہ ہینٛگ۔
\v 8 سُہ جانور یُس ژےٚ وُچھتھن اوس گۅڈٕ زنٛدٕ مگر ووٚنؠ چُھنہٕ سُہ زندٕ۔ البتہٕ چُھ سُہ ووٚنؠ واپس ینہٕ وول تمہِ سرنہِ تہٕ انہِ گٹہِ چاہ منٛزٕ۔ مگر ٲخر کرِ تس خدا تباہ۔ پتہٕ گژھِ یہ جانور دُبارٕ اکہِ پھرِ زندٕ روزنہٕ تہٕ پتہٕ مرنہٕ پتہٕ دوبارٕ ظٲہر۔ امِس وُچھِتھ گژھن زمینس پیٚٹھ روزن وٲلؠ تِم لوٗکھ حٲران یہنٛدؠ ناو نہٕ خداین دنیا تخلیق کرنہٕ برُونٛہہ زندگی ہنٛزِ کتابہِ منٛز لیٚکھمٕتؠ چھِ۔
\p
\v 9 لوٗکن چُھ یہ سمجھنہٕ باپتھ عقلہِ کٲم ہیٚنٕچ ضرورت: تمِس جانور سنٛدؠ ستھ کلہٕ یمِس پیٚٹھ یہِ زٔنؠ سوار چھےٚ تمسنٛدؠ ستھ کلہٕ چھِ ستن پہاڑن ہنٛز نمایندگی کران۔ تِم چھِ شہرٕکؠ تِم ستھ پہاڑ یہنٛز نمایندگی یہ زٔنؠ کران چھےٚ۔ ستھ کلہٕ چھِ ستن حکمرانن ہنٛز تہِ نمایندگی کران۔
\v 10 یمو منٛزٕ چھِ پانٛژھ حکمران ممٕتؠ۔ اکھ چُھ وُنہِ زندے۔ تہٕ ستِم حکمران چُھ وُنہِ ینے۔ ییٚلہ سُہ ییہِ تہٕ سُہ کرِ کمسےٕ کالس حکومت۔
\v 11 سُہ جانور یُس گۅڈٕ زندٕ اوس تہٕ پتہٕ اوس نہٕ زندٕ آسہِ ٲٹھِم حکمران۔ سُہ چُھ بنیٲدی تِمو ستو حکمرانو منٛزٕ اکھ۔ خدا کرِ تس ضرور تباہ۔
\p
\v 12 ووٚنؠ یمہِ داہ ہینٛگ توٚہہ وُچھو تِم چھِ دہن حکمرانن ہنٛز نمایندگی کران یمو نہٕ وُنہِ حکومت کرنؠ شروع کٔر۔ مگر تِم کرن جانورس سٟتؠ رٔلِتھ لوکن پیٚٹھ حکومت، سۅتہِ کمےٕ وقتہٕ باپتھ۔ \f + \fr 17‏:12 \ft دانی ایل 7:24\f*
\v 13 تِم سٲری حکمران آسن کُنی کٲم کرنہٕ باپتھ وعدٕ بند۔ نتیجہ نیرِ یہ زِ تِم دِن جانورس حکومت کرنُک اختیار۔
\v 14 حٲکم تہٕ جانور کرن برس سٟتؠ لڑٲے۔ سُہ دییہِ تِمن شِکس تکیازِ سُے چُھ خداوند یُس باقی تمام خداوندن پیٚٹھ حکومت کران چُھ تہٕ بادشاہ یُس باقی تمام بادشاہن پیٚٹھ حکومت کران چُھ۔ یِم لوٗکھ تس سٟتؠ چھِ تِم چھِ تمہٕ یِم خداین ژٲرتھ پانس کُن بُلٲمٕتؠ چھِ تہٕ یِم وفادٲری سان تمسنٛز خدمت کران روزان چھِ۔
\p
\v 15 پتہٕ ووٚن فرشتن مےٚ، "توٚہہِ یُس شہرس منٛز آب وُچھو یتہِ پاژھٕنؠ بہِتھ ٲس چُھ بیوٚن بیوٚن پوٚت منظرٕ کٮ۪ن لوٗکن ہُنٛد اکھ بوٚڈ تعداد ظٲہر کران۔
\v 16 تہٕ یِم داہ ہینٛگ توٚہہ وچُھو تِم چھِ حکمرانن ہنٛز نمایندگی ظٲہر کران۔ تِم تہٕ جانور کرن پاژھنہِ سٟتؠ نفرت۔ امہ موٚکھٕ کرن تِم شہرس لوٗٹھ تہٕ تتھ منٛز تھاون نہٕ کِہین تہِ۔ پتہٕ کرن تِم شہرس تباہ۔ یتھٕ پٲٹھؠ اکھ جنگلی جانور دویمٮ۪ن جانورن کھیٚوان چُھ۔ تِم زالن شہرس پوٗرٕ پٲٹھؠ۔
\v 17 تِم کرن یہ تکیازِ خداین چُھ تِمن سۅ کٲم ہیٚنُک فٲصلہٕ کوٚرمُت یۅسہٕ سُہ تِمن اتھِ کرناوُن یژھان چُھ۔ نتیجہٕ نیرِ یہ زِ تِم سٲری کرن یکوٹہٕ سپدِتھ اتھ کتھِ پیٚٹھ اتفاق زِ جانورس دِمو حکومت کرنُک اختیار یۅتام نہٕ سُہ تہِ انجام دیہِ یہِ خداین فرموو۔
\p
\v 18 تہٕ یۅسہٕ پاژھٕنؠ توٚہہِ وُچھوون سۅ چھےٚ انتہٲیی بُرٕ شہرٕچ\f + \fr 17‏:18 \ft رومُکؔ شہر\f* نمایندگی کران یمِکؠ رہنما دنیا کٮ۪ن باقی حکمرانن پیٚٹھ حکومت کران چھِ"
\c 18
\p
\v 1 یِمہٕ واقع سپدنہٕ پتہٕ وُچھ مےٚ بییہِ اکھ فرشتہٕ آسمانہٕ پیٚٹھٕ بوٚن وسان۔ خداین ٲس امِس فرشتس سیٚٹھاہ اہم اختیار دیتمُت۔ فرشتہٕ اوس تیوٗت چمکان زِ امہِ سٟتؠ اوس زمینس گاہ پیٚوان۔
\v 2 فرشتن دِژ بڈِ کرٮ۪کھ، "خدا چُھ مکمل پٲٹھؠ بابلؔ کِس بُرٕ شہرس تباہ کرن وول۔ لوٗکھ روزن نہٕ وۅنؠ امہِ شہرٕ کٮ۪ن کھنڈراتن منٛز۔ تتہِ روزن پرٛتھ قسمٕکؠ بد روح۔ پرٛتھ قسمٕکؠ مکرو مردارخور جاناوار تہِ روزن تتہِ\f + \fr 18‏:2 \ft یشعیا 13:21، یرمیاہ 50:39، 51:37\f*"
\v 3 خدا چُھ بابلؔ شہر تباہ کرن وول تکیازِ امؠ بُرٕ شہرن کٔرؠ لوکن ہنٛزٕ جمٲژ بُت پرستی کُن رٲغب۔ بابلنؔ کٔرؠ تِمن جمٲژن ہنٛدؠ حکمران تہِ متٲثر، تہٕ تِمو کٔر پنٕنؠ لوٗکھ بُت پرستی کرنہٕ باپتھ مجبور۔ بابلؔ بنیاو عیش و عشرتٕچ زندگی گذارنٕچ اکھ مثال۔ امہِ سٟتؠ ٲسؠ باقی جاین ہنٛدؠ لوٗکھ تہٕ یتھے پٲٹھؠ روزُن یژھان۔ یِمو لوٗکو عیٲشی باپتھ تِمن لوٗکن سامانہٕ کُن تِمو زیٚون تتھ سامانس واریاہ پونٛسہٕ۔ \f + \fr 18‏:3 \ft یرمیاہ 51:7 \f*
\p
\v 4 پتہٕ بوز مےٚ آسمانہٕ پیٚٹھٕ اوس کُستام کریکہٕ دِوان۔ تمؠ ووٚن، "میانیٚو لوٗکو، بابلؔ کہِ امہِ برٕ شہرٕ منٛزٕ ژٔلیٚو، اگر توٚہؠ اتہِ روزیٚو توٚہؠ کٔریٚو اتکٮ۪ن ہنٛدؠ پٲٹھؠ گناہ تہٕ اگر توٚہؠ گناہ کریٚو یتھ کنؠ تِم کران چھِ، تہٕ بہٕ دِمہٕ توٚہہ تِتھے پٲٹھؠ سزا یتھ پٲٹھؠ بہٕ تِمن سزا دِمہٕ۔ \f + \fr 18‏:4 \ft یشعیا 52:11، یرمیاہ 50:8، 51:45\f*
\v 5 ژٔلیٚو تکیازِ امہِ بُرٕ شہرٕکیٚو لوٗکو کٔرؠ واریاہ بٔڈؠ گناہ  یِم آسمانس تام وٲتؠ تہٕ ووٚنؠ چُھ خدا تِمن پننٮ۪ن اعمالن ہُنٛد سزا دنہٕ وول۔
\p
\v 6 آسمانہٕ پیٚٹھٕ ینہٕ واجنہِ آوازِ ووٚن فرشتن یِم خداین بابلسؔ سزا دنہٕ باپتھ مقرر کٔرؠ، "امہِ شہرٕ کٮ۪ن دیزیٚو تیٚوٗت سزا یوٗتاہ تِمو باقی لوٗکن نقصان واتنوو۔ اصلی گوژھ تِمن تمہِ دۅگنہٕ تکلیف واتُن یوٗتاہ تِمو باقی لوٗکن تکلیف واتنوومُت چُھ۔ \f + \fr 18‏:6 \ft زبور 137:8\f*
\v 7 بابلؔ شہرٕ کیٚو لوٗکو کوٚر پانس پانہٕ عزت۔ تمہٕ رودؠ پننٮ۪ن عٲشن سٟتؠ۔ اتھ حدس تام کوٚر تِمو یہ، تِمن واتنٲیو تکلیف تہٕ کرؠ ووکھ غمگین۔ یی کٔریٚو تکیازِ تِمن ٲس پژھ زِ تِم کرن ہمیشہٕ باقی لوٗکن پیٚٹھ حکومت۔ تِمن اوس یقین زِ تِم تھاون پانس پرٛتھ سُہ اکھ چیز دستیاب یمِچ تِمن ضرورت ٲس۔ تِمن اوس یقین زِ تِمن ییہِ نہٕ زانٛہہ تہِ کانٛہہ مشکِل پیش۔
\v 8 چونکہ بابلٕکؠ لوٗکھ چھِ واریاہ شٲطر امہِ کِنؠ ین اکی وقتہٕ تِمن سارنی سٟتؠ ہٲبت ناک واقعہٕ پیش۔ کینٛہہ مرن تہٕ باقی کرن تِم پیٚٹھ ماتم۔ لوٗکھ آسن بۅچھِ ۂتؠ تکیازِ تِمن آسہٕ نہٕ کھیٚنےٕ۔ شہر دزِ پوٗرٕ پٲٹھؠ۔ خداوند خدا چُھ یتھٕ کنؠ تِمن سزا دِنُک مختار تکیازِ سُہ چُھ قدرت وول"\f + \fr 18‏:8 \ft یرمیاہ 50:31\f*
\p
\v 9 زمینہِ پیٚٹھ روزن وٲلؠ قومن ہنٛدؠ حکمران ٲسؠ بابل کٮ۪ن لوکن سٟتؠ بُتن ہنٛز پوٗزا کران۔ تِم ٲسؠ بابلؔ کٮ۪ن لوٗکن سٟتؠ عیش و عشرتس منٛز مصروف۔ اوٕ کِنؠ ییٚلہِ تِم شہر دزان وُچھن تہٕ تِم کرن اتھ پیٚٹھ سیٚٹھاہ ماتم۔ \f + \fr 18‏:9 \ft یرمیاہ 50:46\f*
\v 10 تِم حکمران روزن بابلسؔ دوٗرِ نظرِ تکیازِ تِم کھۅژُن اگر تِم نزدیک روزن تہٕ خدا دییہِ تِمن تہِ سزا۔ تِم ونن، "عظیم بابل باپتھ کوتاہ ہولناک چُھ یہ مضبوط شہر! خدا کوتاہ جلد چُھ اتہِ روزن والیٚن لوٗکن سزا دِوان"
\p
\v 11 تہٕ زمینٕکؠ سودا گر کرن امہِ شہرٕ باپتھ سیٚٹھاہ ماتم تکیازِ تتیُک روزن وول کانٛہہ تہِ ہییہِ نہٕ دوبارٕ تِم چیز یمہٕ یِمن کنٕنؠ۔ آسن۔
\p
\v 12‏-13 تِم چھِ سۅن، رۅف، قٟمتی کنہِ، تہٕ موتین سٟتؠ بنیمٕتؠ زیور کٕنان سوارِ منٛز۔ تِم چھِ بٲریک لِنن تہٕ ریشمکؠ قٟمتی کپُر کٕنان۔ دروگ کپُر یتھ وانٛگٕنؠ تہٕ ۅزُل رنگ دِنہٕ یوان چھُ۔ تِم ٲسؠ مختلف قسمن ہنٛز خۅشبودار لکٕر تہٕ ۂسؠ دنٛدو سٟتؠ بنیمٕتؠ مختلف چیز، ساروےٕ کھۅتہٕ درۅج لکٕر، سرتل، شستٕر تہٕ سنٛگِ مرمر کٕنان۔ تِم چھِ دالچین، مصالہٕ، بخور، رونٛگ، مُشکہٕ چاٹہِ، شراب، زیتون تیٖل مٲدٕ اوٹ تہٕ اناج کٕنان۔ تِم ٲسؠ گاو، تیٖر، گُرؠ تہٕ رتھ کٕنان۔ تِم چھِ انسانن تہِ بحثیتِ غلام کٕنان۔
\v 14 آ، بابلٕکؠ لوٗکھ یِمن اصلٮیٚن چیزن ہنٛز خوٲہِش تھاوان چھِ تِم سپٕدؠ ختم۔ خداین دیُت تِمن تِہُنٛد واریاہ قٟمتی اثاثہٕ ختم کرِتھ سزا! تِمو راوٕرٲوؠ ہمیشہٕ باپتھ تِم چیز۔
\v 15 واریہو تٲجرو کموو یِم چیز کنِتھ واریاہ پونٛسہٕ۔ تِم تٲجر روزن بابلؔ نِشہٕ واریاہ دوٗر کھڑا تکیازِ تِم کھۅژُن زِ اگر تِم تِمن نزدیک رودؠ تہٕ خدا دییہِ تِمن تہِ سزا۔ تِم کرن سیٚٹھا ماتم۔
\v 16 تہٕ تِم ونن زِ اتھ عظیم شہرس سٟتؠ آے واریاہ دردناک واقعہٕ پیش۔ سُہ شہر اوس اکِس مہرنہِ ہنٛدؠ پٲٹھؠ یس بٲریک کپرٕکؠ پلو تہٕ قٟمتی کپرٕکؠ وانٛگٕنؠ تہٕ وۅزٕلؠ رنٛگٕگؠ پلو لٲگِتھ ٲسؠ تہٕ قٟمتی کنٮ۪ن تہٕ موتین ہنٛدؠ سۅنہٕ سنٛدؠ زیور لٲگِتھ ٲس۔
\v 17 مگر خداین کٔرؠ یِم سٲری قٟمتی چیز آنن فانن منٛز تباہ۔
\p پرٛتھ جہازُک کپتان، پرٛتھ جہازُک مسافِر، تمام ملاح، تہٕ باقی تمام لوٗکھ یِم سمندرس منٛز کٲم کران ٲسؠ آسن شہرٕ نِشہٕ واریاہ دوٗر ۅدٕنؠ۔
\p
\v 18 ییٚلہ تِم نارُک دٔہہ وُچھن یُس تتہِ دزان آسہِ تہٕ تِم تُلن شور، "اتھ عظیم شہرس ہیٚوٗ اوس نہٕ بییہِ کانٛہہ شہرا"\f + \fr 18‏:18 \ft یرمیاہ 51:37\f*
\v 19 تِم برن پننٮ۪ن کلن لژھ ہاون زِ اسہِ پیٚو بوٚڈ غم۔ پتہٕ دِن امہِ بڈِ غمہٕ سٟتؠ نالہٕ، "بابلسؔ سٟتؠ آے سیٚٹھاہ ہولناک واقعہٕ پیش۔ اتھ شہرس منٛز روزن والیٚو ہیٚتؠ سیٚٹھاہ درۅگؠ چیز، یمہِ کِنؠ جہازٕ مٲلکو تمہٕ چیز توٚت واتنٲوِتھ واریاہ پونٛسہٕ کموو۔ خداین کوٚر یہ شہر یوٗتاہ جلد تباہ"
\v 20 پتہٕ ووٚن آسمانہٕ پیٚٹھٕ کٔمؠ تام، "اے آسمان کیٚو روزن والیٚو، بابلسؔ سٟتؠ یہ کینٛژھا سپُد تتھ پیٚٹھ روزیٚو خۅش، توٚہؠ یِم خدایہ سنٛدؠ لوٗکھ چھو، توٚہؠ نبی تہٕ رسول ہیٚتھ منٲیو خۅشی تکیازِ یِمن لوٗکن سٟتؠ انصاف کٔرتھ دیُت خداین یِمن سزا، اوٕ کِنؠ زِ یہنٛدِ ذریعہ ووتُو توٚہہ واریاہ نقصان"
\v 21 پتہٕ تُج أکؠ زبردس فرشتن اکِس بجہ گرٹہٕ کنہِ برابر اکھ کٔنؠ تہٕ دِژن سمندرس منٛز درِتھ۔ پتہٕ ووٚن تمؠ، "خدا کرِ بابلؔ کِس عظیم شہرس اچانک تباہ، سُہ گژھِ انٛد ہیٚتھ نابود، یتھ پٲٹھؠ سۅ کٔنؠ سمندرس منٛز غٲب گییہِ۔ بابلؔ تہِ گژھِ ہمیشہٕ باپتھ ختم!\f + \fr 18‏:21 \ft یرمیاہ 51:63-64، عزرا 26:21\f*
\v 22 اتھ شہرس منٛز وُتھِ نہٕ پتہٕ زانٛہہ کانٛہہ بربت واین وول، گیٚون وول، نَے یا نرسنگا واین وول۔ تتہِ آسہِ نہٕ پتہٕ کانٛہہ کٲرؠ گر چیز بناوان، تتہِ آسن نہٕ پتہٕ دبارٕ زانٛہہ لوٗکھ گرٹن منٛز اناج پِہان تہٕ مٕنان۔ \f + \fr 18‏:22 \ft یشعیا 24:8، عزرا 26:13\f*
\p
\v 23 تتہِ دزِ نہٕ پتہٕ زانٛہہ کانٛہہ ژونگ۔ پتہٕ آسہٕ نہٕ تتہِ کانٛسہِ مہرنہِ ہنٛدِ یا مہرازٕ سنٛدِ ونہٕ ونٕچ آواز کنن گژھان۔ خدا کرِ تتھ شہرس تباہ چونکہ تتِکؠ تٲجر ٲسؠ دنیاہٕکؠ ساروےٕ کھۅتہٕ اہم انسان۔ تِم ٲسؠ سیٚٹھاہ خۅشحال تکیازِ باسان اوس زِ امؠ شہرن چُھ پرٛتھ اکِس لوٗکہٕ جمٲژ پنٕنؠ پٲٹھؠ زندگی گزارنُک جود عطا کوٚرمُت۔ \f + \fr 18‏:23 \ft یرمیاہ 7:34، 16:9\f*
\v 24 یہ شہر چُھ نبین تہٕ خدا سنٛدین باقی لوٗکن قتٕل کرنُک تہِ قصوروار۔ چونکہ در اصل کوٚر أمؠ تشددُک استعمال کرِتھ تشدُدٕچ اکھ مثال قٲیِم، یہ چُھ پرٛتھ تمہِ قتلُک قصوروار یُس تہِ زمینہِ پیٚٹھ لوٗکو کوٚر"\f + \fr 18‏:24 \ft یرمیاہ 51:49\f*
\c 19
\p
\v 1 امہِ پتہٕ بوز مےٚ آسمانہٕ پیٚٹھٕ اکہِ بجہِ جمٲژ ہُنٛد کہتام شور۔ تمہٕ ٲسؠ کرٮ۪کہٕ دِوان،
\q1 ہللویاہ! خداین بچٲوؠ أسؠ!
\q1 سون خدا چُھ جلالہٕ وول تہٕ قٲدر!
\q1
\v 2 خدایس کٔریٚو تعریف تکیازِ سُہ چُھ پوٗرٕ پزرٕ سان انصاف کرن وول!
\q1 تٔمؠ دیُت تتھ بدکار شہرس سزا یُس أکِس پاژھنہِ ہنٛدؠ پٲٹھؠ اوس، چونکہ امہِ شہرٕ کیٚو لوٗکو کٔرؠ باقی شہرن ہنٛدؠ واریاہ لوٗکھ بدکٲری کرنس پیٚٹھ آمادٕ یتھ کنؠ تِم کران ٲسؠ۔
\q1 تمِس کٔریٚو تعریف تکیازِ تٔمؠ دیُت تِمن پننٮ۪ن بندن قتل کرنُک سزا!"\f + \fr 19‏:2 \ft اِستِثنا 32:43\f*
\p
\v 3 ہجومن دژٕ بییہِ کرٮ۪کہٕ تہٕ ونُکھ،
\q1 ہللویاہ!نارُک دٔہہ یُس تتھ شہرس زالان چُھ روزِ ہمیشہٕ ۅتھان"
\q1
\v 4 پتہٕ کوٚر 24 ہو بزرگو تہٕ ژورو جاندارو خدایس برُونٛہہ کنہِ سجدٕ تہٕ تمسنٛز عبادت یُس تختس پیٚٹھ بہِتھ چُھ۔ تِمو ووٚن:
\q1 ہللویاہ! یہ چُھ پزر!"
\q
\v 5 پتہٕ کٔر تختہٕ پیٚٹھٕ کٔمتام کتھ تہٕ ونُن،
\q توٚہؠ سٲری یِم تمِس احترام کران چھُو، کٔرِو خدایہِ سنٛدؠ تعریف، توٚہہِ منٛزٕ پرٛتھ کانہٛہ!\f + \fr 19‏:5 \ft زبور 135:1\f*
\q
\v 6 پتہٕ بوز مےٚ کہتام تیٚوتھ زنتہٕ اکہ بڈِ لُکہٕ ہجومُک شور اوس۔ تِم ٲسؠ بڈِ آلو دِوان زنتہٕ کُنہِ بڈٕ آبشارُک شور نتہٕ آسہٕ گرٮ۪زٕ ونہِ گگرایہ۔ تِم ٲسؠ نالہٕ دِوان، \f + \fr 19‏:6 \ft زبور 99:1، 93:1\f*
\q1 ہللویاہ، سون خداوند خدا، یُس پرٛتھ کُنہِ پیٚٹھ حکومت کران چُھ!
\q1
\v 7 اسہِ پزِ پٔزؠ کِنؠ جشن مناوُن، تہٕ تس عزت کرُن۔
\q1 تکیازِ وۅنؠ ووت وق زِ برہؔ سمکھِ تس زنہِ یس سٟتؠ خاندر کرُن چُھس۔ تمہِ چھِ خاندرٕ باپتھ پلو لٲگؠ مٕتؠ۔
\q1
\v 8 خداین دِتؠ تس لاگنہٕ باپتھ سفید صاف پلو۔ تِم چھِ زٲولہِ لِنن کپرٕکؠ"
\p سُہ پۅشاک چُھ رژٕ کامہِ کرنٕچ تہِ علامت یمہٕ خدا پرستہٕ کران چھِ۔
\p
\v 9 پتہٕ ووٚن فرشتن مےِٚ "یہ لیٚکھ زِ تِم لوٗکھ کٲتیاہ خۅش قسمت چھِ یمہٕ خداین دعوتس أنؠ ییٚلہ برہؔ پننہِ خاندارنہِ سٟتؠ خاندر کران چُھ!" تمؠ ووٚن مےٚ یتہِ، خداین ووٚن یہ، تہٕ یہ چُھ پوٚز!"
\v 10 بہٕ سپدُس یکدم فرشتس برُونٛہہ کنہٕ تمسنٛز عبادت کرنہٕ خٲطرٕ سربہ سجود۔ مگر تمؠ ووٚن مےٚ تورٕ، "میانؠ عبادت مہٕ کر!بہٕ چُھس صرف چون تہٕ سٲتھی خدمتگار تہٕ بیٚیہِ باقین ایماندارن ہُنٛد سٲتھی خدمتگار یِم یسوعسؔ متعلق پوٚز ونان چھِ۔ خداین سوزنس بہٕ یور توٚہہ مدد کرنہِ باپتھ تاکہ توٚہہ میلہ سۅ نبین بصیرت سمجھنس منٛز مدد یۅسہٕ تمؠ توٚہہِ بخشمٕژ چھَو۔ تکیازِ توٚہؠ چُھو یسوعسؔ متعلق پوٚز ونُن یژھان۔ سُہ چُھ وٲحد خدا یمسنٛز توٚہؠ عبادت کٔریٚو"
\p
\v 11 پتہٕ وُچھ مےٚ آسمان یلہٕ گژھان، تہٕ مےٚ وُچھ اکھ حٲرتناک چیز: یسوعؔ \f + \fr 19‏:11 \ft زبور 96:13\f*اوس سفید گُرِس پیٚٹھ سوار۔ تِم لوٗکھ یِم یسوعسؔ مکمل پٲٹھؠ زانان چھِ تِم چھِ تس ہمیشہٕ بھروسہٕ منٛد زانان۔ سُہ چُھ تمام لوٗکن ہُنٛد فٲصلہٕ صحیح طریقس منٛز کران، تہٕ سُہ چُھ تِمن لوٗکن بُتھِ لگان یمہٕ غلط کٲم کران چھِ۔
\v 12 ووٚنؠ آسہٕ تمسنٛزٕ أچھ دزٕونہِ نارٕ مشالہِ ہِشہٕ چمکان۔ تمؠ ٲسؠ پننِس کلس پیٚٹھ واریاہ تاج دِتھ تھٲمٕتؠ۔ تمسنٛدین پلون پیٚٹھ اوس اکھ ناو۔ صِرف چھُ سُے یوت زانان زِ امہ ناوُک مطلب کیاہ چُھ۔
\v 13 یمہٕ پلو تس لٲگِتھ ٲسؠ تِم ٲسؠ خوٗنہٕ چِھکو سٟتؠ برِتھ۔ تمِس چھُ بیاکھ ناو خدایہ سُنٛد کلام۔
\v 14 آسمٲنی فوج اوس تس پتہٕ پتہٕ۔ تِم ٲسؠ سفید گُرٮ۪ن پیٚٹھ سوار، تِم ٲسؠ صاف سفید ریشمی پلو لٲگِتھ۔
\v 15 یسوعؔ سنٛدِ ٲسہٕ کِنؠ ٲس اکھ تیز تلوار نٔنؠ درامٕژ۔ سُہ کرِ تتھ بٲغی جمٲژن شِکس دنہٕ باپتھ استعمال۔ سُہ کرِ پانہٕ تِمن پیٚٹھ تمہِ طاقتہٕ سان لوریٚو سٟتؠ حکومت یتھ نہٕ کانٛہہ مقابلہٕ کرِتھ ہیٚکہِ۔ سُہ کرِ پننٮ۪ن دشمنن تِتھ پٲٹھؠ تباہ یتھٕ پٲٹھؠ دچھ مَے بناونہٕ کِس حوضس منٛز چیرنہٕ یوان چھےٚ۔ سُہ کرِ یہ سورےٕ خدایہ سنٛدِ خٲطرٕ یُس پرٛتھ چیزس پیٚٹھ حکومت کران چُھ تہٕ پننٮ۪ن دشمنن تہنٛدٮ۪ن گُنہن ہنٛدِ سببہٕ بہتر پٲٹھؠ سزا دییہِ۔
\v 16 تمسنٛدِس جامس گو رانہِ پیٚٹھ اکھ لقب نمودار: "یہ چُھ سُہ بادشاہ یُس باقین تمام بادشاہن پیٚٹھ حکومت کران چُھ تہٕ خداوند یُس باقی تمام خداوندن پیٚٹھ حکومت کران چُھ"\f + \fr 19‏:16 \ft 1 تیمُتھیس 6:15\f*
\p
\v 17 تمہِ پتہٕ وُچھ مےٚ اکھ فرشتہٕ اوس افتاب کِس گاشس منٛز کھڑا۔ تٔمؠ کوٚر آسمانس منٛز تھزرس پیٚٹھ وُڈن والیٚن تمام ماز خور جاناوارن بڈِ ہٹہِ آلو، ؤلیٚو تہٕ تمہِ بجہِ خوشی باپتھ گژھیٚو جمع یۅسہٕ خدا توٚہہِ عنایت کران چُھ!\f + \fr 19‏:17 \ft عزرا 39:19-20\f*
\v 18 ولیٚو تہٕ خدایہ سنٛدین دشمنن ہُنٛد ماز کھیٚیو یمہٕ یتھ جنٛگس منٛز مرن، بادشاہن ہُنٛد، فوجی سردارن ہُنٛد، تِمن لوٗکن ہُنٛد یمو طاقتہٕ سان لوٚڈ، گُرٮ۪ن تہٕ گُرؠ سوارن ہُنٛد تہٕ باقی قسمہٕ کٮ۪ن لوٗکن ہُنٛد ماز کھیٚیو"
\p
\v 19 پتہٕ وُچھ مےٚ سُہ جانور تہٕ زمینٕکؠ بادشاہ پنُن فوج ہیٚتھ۔ تِم ٲسؠ سٲری سمیامٕتؠ گُرِس پیٚٹھ سوار تہٕ تمسنٛدِس فوجس سٟتؠ لڑنہٕ باپتھ۔
\v 20 مگر سفید گُرِس پیٚٹھ سوارن روٚٹ جانور تہٕ اپُز نبی۔ یہِ اپُز نبی چھُ سُہ یمؠ جانور سنٛزِ موجودگی منٛز معجزٕ ہٲومٕتؠ ٲسؠ۔ یتھٕ پٲٹھؠ دیُت تٔمؠ تِمن لوٗکن دونٛکھٕ یمو پننٮ۪ن ڈٮ۪کن پیٚٹھ جانور سنٛدؠ نشانہٕ قبول کوٚرمُت اوس تہٕ یمہٕ تمسنٛزِ موٗرژ ہنٛز پوٗزا کران ٲسؠ۔ پتہٕ دِتؠ خداین جانور تہٕ اپُز نبی دزٕ ونِس گنٛدک جھیلس منٛز زنٛدے درِتھ۔
\v 21 تہٕ گُرؠ سوارن ژٔھنؠ تمسنٛدؠ باقی فوجی پننہِ تلوارِ سٟتؠ مٲرِتھ یۅسہٕ تمسنٛدِ ٲسہٕ منٛزٕ درامٕژ ٲس۔ جاناوار آے تہٕ یوٗتاہ ہیوکُکھ تہٕ تیوتاہ ماز کھیوکھ لوٗکن تہٕ گُرٮ۪ن ہُنٛد یمہٕ تمؠ مٲرِتھ ژھنمٕتؠ ٲسؠ\f + \fr 19‏:21 \ft عزرا 39:19-20\f*
\c 20
\p
\v 1 پتہٕ وُچھ مےٚ آسمانہٕ پیٚٹھٕ اکھ فرشتہٕ وسان۔  تمِس اتھِ ٲس سرنہٕ انہِ گٔٹؠ چہٕچ کُنٛز  تہٕ اتھس منٛز اوس اکھ بٔڈ ہانٛکل ہیٚتھ پکان۔ 
\v 2 فرشتن رۅٹ اژدھا۔  سُہ اژدھا چھُ پرانہِ وقتُک سرف ابلیس یعنی شیطان۔  فرشتن گونٛڈ سُہ ہانٛکلہِ سٟتؠ۔  یتھ ہانٛکلہِ سُہ ساس ؤریس گنٛڈِتھ روزِ۔ 
\v 3 فرشتن دیُت سُہ  انہِ گٔٹؠ سرٔنِس چہَس  منٛز دٲرِتھ۔  تٔمؠ تھوو چہس دروازٕ دِتھ تہٕ کوٚرُن سُہ بنٛد،  تٔمؠ کٔر تتھ مُہر یُتھ نہٕ تتھ کانٛہہ کھولہِ۔  تٔمؠ کوٚر یہ اوٕ مۅکھٕ یُتھ نہٕ شیطان ساس ؤرین ہنٛدس ٲخرس تام تِمن واریہن لُکہٕ جمٲژن گمراہ کرِتھ ہیٚکہِ۔  تمہِ وقتہٕ تراوِ خدا شیطانس کینٛژٕ کالہٕ باپتھ یلہٕ۔ 
\p
\v 4 پتہٕ وُچھ مےٚ تختہٕ یِمن پیٚٹھ لوٗکھ بہِتھ ٲسؠ۔  خداین بنٲوؠ تِم لوٗکھ منصف۔  مےٚ وُچھ باقی لوٗکن ہنٛدؠ روح تہِ یمہٕ سر قلم کرِتھ تِہنٛدیٚو دشمنو مٲرمٕتؠ ٲسؠ۔  تہنٛدیٚو دشمنو مٲرؠ تِم اوٕ موٚکھٕ تکیازِ تِمو اوس خدایہ سنٛدِ طرفہٕ یسوعسؔ متعلق پوٚز ونمُت۔  مےٚ وُچھ باقی لوٗکن ہنٛدؠ روح تہِ یِم نہٕ تہنٛدیٚو دشمنو قتٕل کٔرمٕتؠ ٲسؠ مگر یِمو جانور یا تمسنٛزِ مورژِ ہنٛز عبادت کرنس انکار کوٚرمُت اوس۔  تِمو دیُت نہٕ جانور سنٛدین نوکرن اِجازت زِ تِم تراون جانور سُنٛد نشان پننٮ۪ن ڈٮ۪کن یا اتھن پیٚٹھ۔  تِم سٲری گےَ دوبارٕ زنٛدٕ تہٕ تِمو کٔر تتھ ساسس وریس مسیح ہس سٟتؠ حکومت۔ 
\p
\v 5 یِم ٲسؠ تِم لوٗکھ یمہٕ گۅڈنچہِ لٹہِ دُبارٕ زنٛدٕ سپٕدؠ ییٚلہِ خداین مۅردٕ لوٗکھ دوبارٕ زنٛدٕ کٔرؠ۔  باقی یمہٕ لوٗکھ فوت سپٕدؠ مٕتؠ ٲسؠ تِم سپٕدؠ امہِ ساسہٕ ورؠ یہ پتہٕ دوبارٕ زنٛدٕ۔ 
\v 6 خدایس سپدِ تِمو لوٗکو سٟتؠ مسرت یمہٕ گۅڈنچہِ لٹہِ دوبارٕ زنٛدٕ سپٕدؠ۔  آ،  خدا سمجھِ تِمن اکہِ خاص وتہِ کِنؠ پنُن۔  تِم مرن نہٕ دوبارٕ۔  امہِ بجایہ آسن تِم کاہن یِم خدا تہ مسیح سنٛز خدمت کران چھِ۔  تِم کرن اتھ ساسس وریس دوران مسیحسؔ ہس سٟتؠ حکومت۔ 
\p
\v 7 ساس وری انٛد وٲتِتھ کرِ خدا شیطانس سرنہِ انہِ گٔٹؠ چاہ منٛزٕ آزاد۔ 
\v 8 شیطان نیرِ زمین پیٚٹھ کٮ۪ن سارنی بٲغی جمٲژن دونٛکھٕ دنہٕ باپتھ۔  یِم چھِ تِم قوم یِمن حزقیلؔ نبین یاجوج تہٕ ماجوج ووٚن۔  شیطان کرِ تِمن خدا سنٛدین لوٗکن خلاف لڑنہٕ باپتھ جمع۔  یمو منٛزٕ لڑن واریاہ لوٗکھ خدا سنٛدین لوٗکن خلاف یہُنٛد شمار نہٕ کانٛہہ کرِتھ ہیٚکہ،  یتھ پٲٹھؠ نہٕ کانٛہہ سمندر بٹھِس پیٚٹھ بہِتھ سیٚکہِ دانہٕ گنٛزرٲوِتھ ہیٚکہِ۔ 
\v 9 تِم کرن زمینہِ ہنٛزو واریہو جایو پیٚٹھٕ سفر۔  تِم کرن خدایہِ سنٛدین لوٗکن ہنٛدِس فوجس گیرٕ۔  یتہِ تِم جنگٕچ صفہٕ بندی کرِتھ تیٲری کران آسن۔  تہِ آسہِ یروشلمس منٛز،  سُہ شہر یتھ سٟتؠ خدا محبت کران چُھ۔  مگر خدا کرِ آسمانہٕ پیٚٹھٕ نار نٲزِل تہٕ سُہ ژھنہِ تمسنٛدؠ تمام دشمن زٲلِتھ\f + \fr 20‏:9 \ft عزرا 39:6\f*
\v 10 پتہٕ ژھنہِ خدا شیطانس دزوٕنس گنٛدک جھیلس منٛز دٲرِتھ یمؠ تِم لوٗکھ گمراہ کٔرمٕتؠ ٲسؠ۔  یہ چھےٚ سۅ جاے یتہِ خداین جانور تہٕ اپُز نبی دٲرِتھ دِتؠ۔  نتیجہ نیرِ یہ زِ تِم روزن ہیٚتھےٕ ہمیشہٕ باپتھ سختی تُلان۔  \f + \fr 20‏:10 \ft متی 25:46\f*
\p
\v 11 پتہٕ وُچھ مےٚ اکھ بوٚڈ سفید تخت یتھ پیٚٹھ خدا بہِتھ اوس۔  سُہ اوس تیوٗت خوفناک زِ ییٚلہِ سُہ ظٲہِر سپُد زمین تہٕ آسمان سپُد بلکل غٲب۔  \f + \fr 20‏:11 \ft متی 25:31،  47:8\f*
\v 12 پتہٕ وُچھ مےٚ پرٛتھ قسمٕکؠ لوکھ یِم گُذریمٕتؠ ٲسؠ مگر ووٚنؠ سپدؠ دوبارٕ زنٛدٕ تہٕ چھِ خدایہ سنٛدِس تختس برُونٛہہ کنہِ کھڑا۔  خداین مُژراوِ تِم کتابہِ یِمن منٛز سُہ درٕج کران چُھ زِ لوٗکھ کیاہ چھِ کران۔  خداین کھوج بیاکھ کتاب تہِ،  زندگی ہنٛز کتاب۔  خدا چُھ اتھ کتابہِ منٛز تِمن لوٗکن ہنٛدؠ ناو لیٚکھان یِمن پوشہٕ ؤنؠ زندگی چھےٚ۔  خداین کوٚر تِمن لوٗکن سٟتؠ انصاف یِم گُذریمٕتؠ چھِ تہٕ یِم ووٚنؠ دوبارٕ زنٛدٕ سپٕدؠ تہنٛدیٚو کرمو مطٲبق یمہ تٔمؠ کتابن منٛز درٕج کٔرمٕتؠ ٲسؠ۔  \f + \fr 20‏:12 \ft دانی ایل 7:10\f*
\p
\v 13 یِمن لوٗکن ہنٛزٕ لاشہٕ سمندرس منٛز آسہٕ تِم سپٕدؠ دوبارٕ زنٛدٕ تہٕ یہنٛزٕ لاشہٕ زمینہِ پیٚٹھ آسہٕ تِم تہِ سپٕدؠ زنٛدٕ۔  تِم سٲری ٲسؠ خدایہ سنٛدِس تختس برُونٛہہ کنہِ کھڑا،  تہٕ خداین کوٚر تِمو منٛزٕ پرٛتھ اکِس سٟتؠ تہنٛدیٚو اعمالو مطٲبق فٲصلہٕ۔ 
\v 14 پتہٕ رٔٹ خداین سۅ جاے یوٚت روح جسمٲنی طور مرنہٕ پتہٕ گژھان چھِ۔  تہٕ سۅ جاے دِژن دزوٕنس جھیلس منٛز درِتھ۔  دزٕوُن جھیل چُھ سۅ جاے یوٚت لوٗکھ روحٲنی طور مرنہٕ پتہٕ گژھان چھِ۔ 
\v 15 پتہٕ وُچھ خداین زِ تمؠ کہنٛدؠ ناو چھِ اتھ کتابہِ منٛز درج کٔرؠ مٕتؠ یُس تِمن لوٗکن ہُنٛد فہرستہٕ چُھ یِمن ہمیشہٕ پوشہٕ وٕنؠ زندگی چھےٚ۔  اگر کانٛسہ ہُنٛد ناو اتھ کتابہِ منٛز اوس نہٕ خداین ژُھن سُہ دزوٕنس جھیلس منٛز درِتھ۔  \f + \fr 20‏:15 \ft یوحنا 3:36،  1 یوحنا 5:11-12\f*
\c 21
\p
\v 1 پتہٕ وُچھ مےٚ اکھ نُو آسمان تہٕ نٔو زمین۔  گۅڈنیُک آسمان تہٕ گۅڈنِچ زمین گییہِ غٲب،  تہٕ سمندر تہِ ٲسؠ نہٕ وۅنؠ موجود۔  \f + \fr 21‏:1 \ft یشعیا 66:22\f*
\v 2 مےٚ وُچھ یروشلمُک شہر یُس خدایہ سنٛدِ باپتھ خاص چھُ اکِس نوِ شکلہِ منٛز۔  یہ اوس آسمانہٕ پیٚٹھٕ خدایہ سنٛدِ طرفہٕ زمینہِ پیٚٹھ وسان۔  یہ شہر اوس سیٚٹھاہ خوبصورت باسان،  زنتہٕ ٲس مہرِنؠ خاندرکہِ دۅہہ پٲرٲوِتھ۔ 
\p
\v 3 پتہٕ بوز مےٚ اکھ تٔھز آواز یۅسہٕ خدایہ سنٛدِ تختہٕ پیٚٹھٕ ناد دِوان ٲس۔  آواز ٲس ونان،  "یہ بوزیٚو! ووٚنؠ یتہِ لوٗکھ روزان چھِ خدا روزِ تٔتؠ! تِم آسن تمسنٛدی،  تہٕ خدا روزِ پانہٕ تِمن سٟتؠ۔  \f + \fr 21‏:3 \ft لاوی 26:11-12،  عزرا 37:27\f*
\v 4 سُہ دییہِ تِمن تسلی یُتھنہٕ تِم یمہِ یوکُن غمگین گژھن، یمو منٛزٕ مرِنہٕ پتہٕ دُبارٕ کانٛہہ تہِ،  نہ کرِ ماتم،  نہ ہییہِ ودُن تہٕ نہ وۅتلیٚکھ کانٛہہ دگ۔  خداین نی تِم سٲری چیز تُلِتھ،  اوٕ کِنؠ گےَ تِم ہمیشہ باپتھ ختم"\f + \fr 21‏:4 \ft یشعیا 25:8\f*
\p
\v 5 پتہٕ ووٚن خداین تختہٕ پیٚٹھٕ،  "یہ بوز،  بہٕ چُھس ووٚنؠ سورےٕ کینہٛہ نوو بناون وول" تمؠ ووٚن مےٚ یتہ،  "یمہٕ کتھٕ لیٚکھ یمہٕ مےٚ ژےٚ ونےَ۔  ژٕ تھاو پژھ زِ بہٕ دمہٕ یمہٕ ضرور انجام"\f + \fr 21‏:5 \ft یشعیا 42:9\f*
\v 6 تٔمؠ ووٚن مےٚ یتہِ،  "مےٚ کٔرؠ یِم سٲری چیز مکمل،  بےٕ چُھس سُہ یمؠ یِم سٲری چیز شروع کٔرؠ تہٕ یُس سارنےٕ چیزن فناہ کرِ،  بہٕ دمہٕ پرٛتھ کانٛسہِ کانٛچھن وٲلِس مفت ہمیشہٕ پوشہٕ ؤنؠ زندگی زنتہٕ آسکھ بہٕ یِم تمہِ ناگٕچ تریش چاوان یمیُک آب لوٗکن زنٛدٕ تھاوان چھُ۔ 
\p
\v 7 بہٕ دمہٕ یہ تِمن سارنی یمہٕ شیطانس پیٚٹھ فتح پراون تہٕ بہٕ آسہٕ تِہُنٛد خدا تہٕ تِم آسن میانؠ شُرؠ۔ 
\v 8 مگر باقی تمام لوٗکھ تُلن دزوٕنس گنٛدک جھیلس منٛز مصیبت. دویمہِ پھرِ مرنُک مطلب چُھ یی۔  یِم لوٗکھ بُزدل آسن تِمن چُھ یہ پیٚترُن۔  یتھے پٲٹھؠ تِم لوٗکھ یم نہٕ مےٚ پیٚٹھ ایمان انان چھِ،  تِم لوٗکھ یِم قٲبلِ نفرت کار کران چھِ،  یِم لوٗکن قتٕل کران چھِ،  تِم یِم بدکٲری کران چھِ،  یِم سہرٕ کران آسن،  تِم یِم بُتن ہنٛز پوٗزا کران چھِ تہٕ تِم سٲری یِم اپُز ونان آسن"\f + \fr 21‏:8 \ft افسی 5:5،  1 کورنتھ 6:9-10\f*
\p
\v 9 پتہٕ آو مےٚ نِش اکھ فرشتہٕ سُہ اوس تِمو ستو فرشتو منٛزٕ اکھ یِمن اتھِ شرابٕکؠ ستھ پیالہٕ ٲسؠ یمہٕ ٲخری ستن مشکِلاتن ہنٛدؠ بٲعث ٲسؠ۔  تمؠ ووٚن مےٚ، "ۅلہٕ مےٚ سٟتؠ۔  بہٕ ہاوے ژےٚ تمہٕ لوٗکھ یمہٕ ہمیشہٕ باپتھ برہؔ ہس سٟتؠ یِکوٹہٕ روزن!
\p
\v 10 پتہٕ کوٚرس بہٕ خدایہ سنٛدؠ پاک روحن آگاہ یُتھ زن بہٕ رویا ہس منٛز یمہ چیز وچھِتھ تہٕ بوزِتھ ہیٚکہٕ۔  فرشتن نیوٗس بہٕ اکِس تھدِس بالہٕ تینٛتٲلِس پیٚٹھ۔  تتہِ ہوو تٔمؠ مےٚ سُہ شہر یُس خدایہ سنٛدِ باپتھ خاص چُھ،  نُوو یروشلم۔  یہ اوس خدایہ سنٛدِ طرفہٕ آسمانہٕ پیٚٹھٕ وسان۔ 
\v 11 شہر اوس پانہٕ خدایہ سنٛدِ طرفہٕ ینہٕ والہِ شاندار نوٗرٕ سٟتؠ چمکان۔  یہ اوس اکہِ بےٚ مۅل کنہِ یشبٕکؠ پٲٹھؠ چمکان،  تہٕ یہ اوس بلور ہیٚوٗ صاف
\v 12 شہرس اوس انٛدؠ انٛدؠ اکھ تھوٚد دیوار۔  اتھ دیوارس ٲسؠ باہ دروازٕ۔  یِمو بہو دروازو منٛز اوس پرٛتھ کُنہِ دروازس پیٚٹھ اکھ اکھ فرشتہٕ کھڑا اسرائیل کیٚن بہن قبیلن ہنٛدؠ ناو گےَ دروازن پیٚٹھ ظٲہِر۔  پرٛتھ دروازس پیٚٹھ اوس اکہِ قبیلُک ناو درٕج۔ 
\v 13 شہرس مشرقہٕ انٛدٕ ٲسؠ ترےٚ دروازٕ،  ترےٚ ٲسؠ شمالہٕ انٛدٕ،  ترےٚ دروازٕ ٲسؠ جنوب پاسہٕ تہٕ ترےٚ دروازٕ ٲسؠ مغرب انٛدٕ۔ 
\p
\v 14 شہرچہ فصیلہِ ہُنٛد کٕن اوس بہن کنٮ۪ن پیٚٹھ۔  پرٛتھ کُنہِ کنہِ پیٚٹھ اوس تِمو بہو رسولو منٛزٕ أکؠ سُنٛد ناو لیٚکِھتھ یمہٕ برہؔ ہن مقرر کٔرؠ مٕتؠ ٲسؠ۔ 
\p
\v 15 یُس فرشتہٕ مےٚ سٟتؠ کتھ کران اوس تمِس اتھِ اوس میننہٕ باپتھ سۅنہٕ سُنٛد گز۔  تٔمؠ کوٚر سُہ شہر،  تمِکؠ دروازٕ تہٕ دیوار میننہٕ باپتھ استعمال۔  \f + \fr 21‏:15 \ft زکر 2:1\f*
\p
\v 16 شہر اوس مربع چالہِ مطلب یوٗتاہ کھوٚل اوس تیٚوتُے اوس زیوٹھ تہِ۔  فرشتن ووٚن پننہٕ گزٕ سٟتؠ شہر میننہٕ پتہٕ زِ یہ چُھ زٕ ساس تہٕ ژور ہتھ کلو میٹر زیوٹھ تہٕ امیُک کھجر تہٕ تھزر چُھ امکِس زیچھرس برابر۔ 
\v 17 تٔمؠ میٚون دیوار تہٕ ونُن زِ یہ چُھ 66\f + \fr 21‏:17 \ft شیٹھ میٹر\f* میٹر تھوٚد۔  فرشتن کٔر سۅے پیمٲیش استعمال یۅسہٕ لوٗکھ عام پٲٹھؠ استعمال کران چھِ۔ 
\p
\v 18 شہرچہِ فصیلہِ ہنٛزٕ کنہِ آسہٕ سبٕز کنٮ۪ن ہِشہٕ یِمن لوٗکھ یشب ونان ٲسؠ۔  شہرچہِ عمارتس آسہٕ خٲلص سۅنہٕ سنٛزٕ تہٕ تمہٕ آسہٕ صاف شیشٕکؠ پٲٹھؠ ٹکر دِوان۔ 
\v 19 شہرچہِ فصیل ہنٛز بُنیاد ٲس خوبصورت قٟمتی کنٮ۪ن ہنٛز۔  پرٛتھ کانٛہہ بنیاد ٲس أکِس الگ کنہِ ہنٛز۔  گۅڈنِچ کٔنہٕ کٔنؠ ٲس یشب۔  دویِم کٔنہٕ کٔنؠ ٲس نیٖلم۔  ترییِم کٔنہٕ کٔنؠ ٲس شبِ چراغ۔  ژورِم کٔنہٕ کٔنؠ ٲس زمرُد۔  \f + \fr 21‏:19 \ft یشعیا 54:11-12\f*
\v 20 پانٛژِم کٔنہٕ کٔنؠ ٲس عقیق۔  شییِم کٔنہٕ کٔنؠ ٲس لعل۔  ستِم کٔنہٕ کٔنؠ ٲس کریسو لائٹ۔  ٲٹھِم کٔنہٕ کٔنؠ ٲس فیروزہ۔  نٔوِم کٔنہٕ کٔنؠ ٲس پکھراج۔  دٔہِم کٔنہٕ کٔنؠ ٲسی یمنی۔  کٔہِم کٕنہٕ کٔنؠ ٲس سُنبلی۔  تہٕ بٔہِم کنہٕ کٔنؠ ٲس یاقوتٕچ۔ 
\p
\v 21 شہرٕکؠ باہ دروازٕ ٲسؠ بہَن بڈٮ۪ن موتین ین ہنٛدؠ۔  پرٛتھ کانٛہہ دروازٕ اوس اکہِ کُنے موتیُک۔  شہرچہِ سڑکہٕ آسہٕ صاف سۅنٕچہِ تمہٕ آسہٕ صاف شیشٕکؠ پٲٹھؠ پرٮ۪زلان۔ 
\p
\v 22 شہرس منٛز اوس نہٕ کانٛہہ تہِ ہیکل۔  یہ اوس اوٕ موٚکھٕ زِ خداوند خدا اوس پانہٕ،  یُس سارنی پیٚٹھ حکومت کران چُھ،  تہ برہؔ اوس تتہِ موجود۔  لہٰذا ٲس نہٕ تتہِ مقدِسٕچ ضرورت۔ 
\p
\v 23 وۅنؠ چھنہٕ شہرس گاشہِ باپتھ آفتابٕچ یا زوٗنہِ ہنٛز ضرورت تکیازِ خدایہ تہٕ برہؔ سنٛدِ طرفہٕ ینہٕ وول گاش چھُ تیٚوتھ گاشاہ یمِچ اتھ ضرورت چھےٚ۔  \f + \fr 21‏:23 \ft یشعیا 60:19\f*
\v 24 یتھٕ کنؠ شہرس منٛز لوٗکھ روزان چھِ تہِ چُھ دنیاہس منٛز روزن والیٚن تمام لوٗکن باپتھ اکھ مثال۔  زمینٕکؠ حکمران انن خدا تہٕ برہؔ سنٛدِ تعظیمہٕ باپتھ پنٕنؠ خزانہٕ شہرس منٛز۔ 
\v 25 شہرس منٛز آسہِ نہٕ زانٛہہ تہِ روتل۔  لہٰذا کرِ نہٕ کانٛہہ تہِ کُنہٕ تہِ وزِ شہرُک دروازٕ بنٛد یتھ کنؠ زن عام پٲٹھؠ پرٛتھ دوٚہہ انٛد وٲتِتھ سپدان چُھ۔  \f + \fr 21‏:25 \ft یشعیا 60:11،  زکر 14:7\f*
\p
\v 26 دنیہٕکؠ لوٗکھ تہِ واتناون پنٕنؠ دولت شہرس منٛز۔ 
\v 27 مگر کانٛہہ تہِ چیز یُس اخلاقن ناپاک آسہِ گژھِ نہٕ ہرگِز تہِ اتھ شہرس منٛز دٲخٕل۔  کانٛہہ تہِ سُہ فرد یُس تِتھؠ کار کران آسہِ یِم خدایس نِش مکرُو چھِ تہٕ بیٚیہِ سُہ شخص یُس اپُز ونان آسہِ،  گژھِ نہٕ زانہٛہ تہِ اتھ منٛز دٲخل۔  صرف آسن تِمے لوٗکھ یہنٛدؠ ناو خداین اتھ کتابہِ منٛز لیٚکھمٕتؠ چھِ یۅسہٕ برہؔ سنٛز چھےٚ۔  یہ چھےٚ سۅ کتاب یتھ منٛز ہمیشہِ باپتھ زندگی پراون والیٚن لوٗکن ہنٛدؠ ناو درٕج سپدان چھِ۔  \f + \fr 21‏:27 \ft یشعیا 52:1\f*
\c 22
\p
\v 1 پتہٕ ہوو مےٚ فرشتن سُہ دریاو یُس تِمن لوٗکن پوشوٕنہِ زندگی گُزارنُک بٲعث بنان چھُ یِم امِچ تریش چیٚن۔  امیُک آب اوس صاف شیشہٕ ہیٚوٗ۔  امہِ دریاوُک آب اوس تِمو تختو نِشہٕ نیران یتِتھ خدا تہٕ برہؔ بہِتھ ٲسؠ۔ 
\v 2 سُہ اوس شہرٕکہِ کھلہٕ مٲدانہٕ منٛزؠ وسان۔  دریاوٕ کٮ۪ن دونونی بٹھٮ۪ن ٲسؠ میٚوہ کُلؠ یُس یمہٕ کھییہِ ہے سُہ اوس ابدی حیٲتی پراوان۔  یمہ کُلؠ چھِ ورؠ یس منٛز بہہِ لٹہِ پھسٕل دِوان۔  یمہٕ چھِ پرٛتھ ریتہٕ اکھ پھسٕل دِوان۔  لوٗکھ چھِ یِمن کُلٮ۪ن ہُنٛد پن دوا رنٛگؠ استعمال کران۔  \f + \fr 22‏:2 \ft عزرا 47:7\f*
\v 3 تتہِ اوس نہٕ زانٛہہ تہِ کانٛہہ فرد یا چیز یمِس پیٚٹھ خدا لعنت کرِہے۔  خدا تہٕ برہؔ سُنٛد تخت آسہِ شہرس منٛز۔  خدا سنٛدؠ بندٕ کرن تتہِ تمسنٛز عبادت۔  \f + \fr 22‏:3 \ft زکر 14:11\f*
\v 4 تمسنٛدؠ نوکر وُچھن تس برُونٛہہ کنہِ دیدمان تہٕ تمسُنٛد ناو سپدِ تہنٛدٮ۪ن ڈٮ۪کن پیٚٹھ ظٲہِر۔ 
\v 5 پتہٕ ییہِ نہٕ تتہِ زانٛہہ تہٕ دُبارٕ روتل۔  خدایہ سنٛدین بندن پییہِ نہٕ ژانٛگیٚن یا آفتابکہِ گاشُک ضرورت تکیازِ خداوند خدا کرِ تِمن پیٚٹھ پننہِ گاشُک ظہور۔  تِم کرن ہمیشہٕ حکومت۔  \f + \fr 22‏:5 \ft یشعیا 60:19،  دانی ایل 7:27\f*
\v 6 فرشتن ووٚن مےٚ تمہِ پتہٕ،  "یِم چیز یِم ژےٚ خداین ہٲونے چھِ پٔزؠ تہٕ سُہ دِیہِ یِمن پٔزؠ پٲٹھؠ واقع سپدنہٕ۔  خداوند خدا ین یُس نبین تحریک دِوان چُھ سوز پنُن فرشتہٕ زِ سُہ ہاوِ تِمن لوٗکن یِم تمسنٛز خدمت کران چھِ تِم واقعات یِم جلدےٕ سپدن وٲلؠ چھِ۔ 
\v 7 یسوعؔ چھُ پننیٚں سارنےٕ لوٗکن ونان،  "یہ بوزیٚو! بہٕ چُھس جلدےٕ ینہٕ وول،  خدا دییہِ پرٛتھ تس شخصس فراوٲنی سان برکت یُس یمہِ کتابہِ ہنٛدِ نبوتکہِ پٲغامچ پٲروی کرِ"
\v 8 بہٕ چُھس سُے یوحناؔ یمؠ رویا ہس منٛز یمہٕ کتھٕ بوزٕ تہٕ وُچھٕ یِم مےٚ لیکھِتھ تھاوِ۔  ییٚلہِ مےٚ یِم کتھٕ بوزٕ تہٕ وُچھٕ تہٕ بہٕ جُکیوس یکدم امِس فرشتس برُونٛہہ کنہِ یمؠ مےٚ یِم چیز ہٲوؠ یُتھ بہٕ امسنٛز عبادت کرٕہا۔ 
\v 9 مگر تٔمؠ ووٚن مےٚ،  "میانؠ عبادت مہٕ کٔریٚو،  بتہِ چُھس تُہنٛدی پٲٹھؠ خدایہ سُنٛد بندٕ،  بتہِ چُھس تُہنٛدین سٲتھی ایماندارن ہنٛدؠ پٲٹھؠ یِم نبی چھِ تہٕ تِمن لوٗکن ہنٛدؠ پٲٹھؠ یمہٕ یمہِ کتابہِ ہُنٛد پٲغام مانان چھِ،  امہِ بجایہ کٔریٚو خدایہ سنٛز عبادت"
\v 10 تٔمؠ ووٚن مےٚ یتہِ،  "یہ کینٛژھا تہِ خداین یتھ کتابہِ منٛز پیشن گوئی کٔر سۅ مہٕ تھاو پوشیدٕ،  تکیازِ یہ پٲغام پورٕ کرنُک وقت آو نزدیک۔ 
\v 11 چونکہ سُہ وقت چُھ نکھٕ امہِ کِنؠ اگر تِم لوٗکھ یِمہ غلط کامہِ چھِ کران یژھن تٔتھؠ سٟتؠ روزُن،  تِم روزِن تہِ کران۔  یِم لوٗکھ ناپاک چھِ اگر تِم ناپاکےٕ روزُن یژھان چھِ تہٕ تِم روزِنؠ تٔتھؠ سٟتؠ۔  خدا دییہِ جلدےٕ تِمن پاک نہ روزنُک سزا۔  مگر یِم لوٗکھ راستبٲزی سان کٲم کران چھِ،  تِمن پزِ رستبٲزی سان کام جٲری تھاوٕنؠ۔ 
\v 12 یسوعؔ چھُ سارنےٕ لوٗکن ونان: بوزیٚو! بہٕ چُھسو جلد ینہٕ وول! تہٕ بہٕ دمہٕ پرٛتھ کانٛسہِ پننہِ کرِمتہِ حسابہٕ سزا یا جزا۔  \f + \fr 22‏:12 \ft متی 16:27\f*
\v 13 بہٕ چُھس سُہ یمؠ پرٛتھ کُنہِ چیزٕچ شروعات کٔر تہٕ بےٕ چُھس سُہ یُس پرٛتھ کانٛہہ چیز ختم کرن وول چُھ۔  بہٕ چُھس پرٛتھ چیزُک اپتدا تہٕ بےٕ چُھس پرٛتھ چیزُک انتہا۔  \f + \fr 22‏:13 \ft یشعیا 44:6،  48:12\f*
\v 14 خدا چُھ تِمن لوٗکن سیٚٹھاہ خۅش یم غلط طریقٕچ زندگی ترٲوِتھ صحیی طریقہٕ زندگی گُزارنہِ لٔگمٕتؠ چھِ۔  تکیازِ تِم چھِ یہ کران،  تِم لوٗکھ ہیٚکن تمہِ کُلیُک پھل کھیٚتھ یُس لوٗکن ہمیشہٕ زنٛدٕ روزنس قٲبِل بناوان چُھ۔  تِم ہیٚکن دروازو منٛزؠ أژتھ مقدس شہرس کُن گٔژِھتھ۔ 
\v 15 مگر باقی\f + \fr 22‏:15 \ft جنسی بد اخلاق لوٗکھ\f* ہیٚکن نہٕ اتھ شہرس منٛز دٲخل سپدِتھ۔  اتھ منٛز چھِ تِم لوٗکھ شٲمِل یِم بُرٕ کامہِ کران چھِ،  جادوگری تہٕ جنسی گناہ کران چھِ،  دویمیٚن ہُنٛد قتٕل تہٕ بُتن ہنٛز پوٗزا کران چھِ،  یا ہیٚتھےٕ اپُز ونان چھِ۔  \f + \fr 22‏:15 \ft زبور 22.16،  متی 15.26،  27\f*
\v 16 مےٚ،  یسوعنؔ سوز پنُن فرشتہٕ یِمن چیزن ہُنٛد اعلان کرنہٕ باپتھ یُس توٚہہ ایمان واجنیٚن جمٲژن متٲثر کرِ۔  سرٕپٲٹھؠ چُھس بہٕ دونونی بادشاہ داوودؔ سنٛدیو جدٕاجدادو تہٕ تمسنٛدیو زُریٚو منٛزٕ یمسنٛدِ یِنُک وعدٕ نبیو کوٚر۔  بہٕ چُھس سُہ یُس صبحکہِ گاشہٕ تارکٕکؠ پٲٹھؠ چُھ"\f + \fr 22‏:16 \ft یشعیا 11:1\f*
\v 17 پاک روح\f + \fr 22‏:17 \ft یشعیا 55:1\f* تہٕ تِم لوٗکھ یِم خدایہ سنٛدؠ چھِ فرماوان،  "ولیٚو!" یِم یہ بوزان چھِ تِم تہِ ونن،  "ولیٚو!" پرٛتھ کانٛہہ سُہ شخص یُس پوشوٕنؠ زندگی یژھان چُھ،  تمِس پزِ سۅ پراوٕنؠ۔  خدا بخشہِ اکہِ مفت ڈالہِ رنٛگؠ پوشوٕنؠ زندگی تمِس پرٛتھ کٲنٛسہِ شخصس یُس امِچ خٲہِش کرِ۔ 
\v 18 بہٕ،  یوحناؔ چُھسن پرٛتھ کانٛہہ خبردار کران یُس یہ پٲغام بوزان چُھ یمِس متعلق یتھ کتابہِ منٛز مےٚ پیشن گوئی کٔر: اگر کانٛہہ اتھ پٲغامس منٛز اضافہٕ کرِ،  تہٕ خدا دییہِ تس یِمو طریقو سزا یمن متعلق یہ کتاب ونان چھےٚ۔  \f + \fr 22‏:18 \ft اِستِثنا 12:32\f*
\v 19 تہٕ اگر کانٛہہ تِمن کتھن متعلق یِمن ہنٛز مےٚ پیشن گوئی کٔر کانٛہہ کتھ چُھپایہ،  تہٕ خدا کرِ تس شخصس تمہِ کُلیُک پھل کھیٚنہٕ کہ حقہٕ نِشہٕ محروم یُس لوٗکن ہمیشہٕ زندٕ روزنس قٲبِل بناوان چُھ۔  خدا کرِ تس شخصس نٔوِس یروشلمس منٛز اژنٕکہِ حقہٕ نِشہٕ تہِ محروم۔  بہٕ چُھس یمہٕ دوٚنوے چیز یتھ کتابہِ منٛز بیان کران۔  \f + \fr 22‏:19 \ft زبور 69:28،  اِستِثنا 4:2\f*
\v 20 یسوعؔ،  یُس یہ ونان چُھ زِ یمہٕ سارے کتھٕ چھےٚ پزٕ،  ونان چُھ،  "سیٚکہٕ پٲٹھؠ چھُس بہٕ جلدے یِنہٕ وول" بہٕ،  یوحناؔ چُھس ونان،  "یی سپدِن! خداوند یسوع،  ولیٚو!"\f + \fr 22‏:20 \ft 1 کورنتھ 16:22\f*
\v 21 بہٕ چُھس دُعا کران زِ سون خداوند یسوع روزِنؠ توٚہہ سارنی سٟتؠ یم خدایہ سنٛدؠ لوٗکھ چھِ مہربٲنی کران۔  یی سپدِن!
