\id 1PE - DMT Kashmiri
\toc1 1 پطرس
\mt1 1 پطرس
\c 1
\p
\v 1 بہٕ چُھس پطرس، یُس یسوع مسیحؔ ہن پنُن نمایندٕ بنٲوِتھ سوز۔ بہٕ چُھسو توٚہہِ یہِ نامہٕ لٮ۪کھان یِم خداین پننہِ باپتھ ژٲرؠ۔ بہٕ چُھسو لٮ۪کھان توٚہہِ یِم عارضی طور روزان چھِ پنطُسؔ، گلتِیہؔ کپّدُکیہ، آسیہؔ تہٕ بتُھنیہؔ صوبن منٛز۔ آسمانہٕ پٮ۪ٹھٕ پننہِ پزِ گرٕ نِشہ دوٗر۔
\v 2 سٲنؠ بب خداین ژٲرِو توٚہؠ پننہِ برونٛٹھےٕ نِمتہِ فٲصلہٕ مطٲبق۔ تٔمؠ کوٚر یہِ پننہِ روح سٟتؠ، توٚہؠ الگ ژٲرِتھ تاکہِ توٚہؠ کٔرِو تس سنٛز فرمانبردٲری تہِ مزید۔ یُتھ یسوع مسیحؔ سُنٛد مرُن توٚہہِ خدایس سٟتؠ عہد قٲیم تھاون والیٚن سٟتؠ گنٛزرِ۔ بہٕ چُھس منٛگان دُعا زِ خدا کرِ توٚہہِ پٮ۪ٹھ پننِس فضلس ہُرٮ۪ر۔ تہٕ انیٚو توٚہہِ وارے امنس تل۔
\v 3 تعریف کٔرِو خدایہِ سٕنٛدؠ یُس سٲنِس یسوع مسیحؔ خداوند سُنٛد بب چُھ اوٕ کِنؠ زِ سُہ چُھ اسہِ پٮ۪ٹھ واریاہ مہربان رحم کرن وول۔ تٔمؠ بنٲوؠ أسؠ اتھ لایق زِ خداین کرنٲیِو توٚہؠ نوِ زاینُک تجربہٕ۔ خداین کوٚر یہِ اوٕ کِنؠ زِ اسہِ منٛز وۅتلہِ امید یۅسہ نہٕ اسہِ زانہٛہ نا امید کرِ،
\v 4 یعنی أسؠ پراوو سۅ وراثت یۅسہ نہٕ زانہٛہ سورِ۔ لژھِ گژھِ یا ژھۅکہِ یۅسہ خداین سانہٕ باپتھ جنتس منٛز تھاومٕژ چھےٚ۔
\v 5 خدا سنٛز قوت چھےٚ توٚہہِ حفاظتس تُہنٛد یسوعس پٮ۪ٹھ ایمان کِنؠ۔ سُہ چُھ توٚہہِ حفاظتس تاکہِ سُہ کرِ تہنٛدِ نجاتُک اظہار ٲخری زمانس منٛز ییٚلہِ یسوع سارنےٕ انصاف کرنہِ واپس پھیرِ۔
\v 6 توٚہؠ کٔرِو سٮ۪ٹھا خوشی یمہِ باپتھ زِ تٔمہِ ساعتہٕ کیا سپدِ توٚہہِ سٟتؠ، یوٚدوے زن وُنکٮ۪س کینٛژٕ کالہٕ باپتھ واریاہ سِتم توٚہہِ جیرٕ تہِ انن۔
\v 7 یِم سِتم چھِ اوٕ کِنؠ زِ توٚہؠ دِیو ثبوٗت یسوعس پٮ۪ٹھ پننہِ پژھِ ہُنٛد۔ سۅ پژھ چھےٚ خدایس برونٛہہ کنہِ زیادٕ وقعت تھاوان تمہِ سۅنہٕ کھۅتہٕ یتھ کانٛہہ بُرباد ہیٚکہِ کٔرِتھ یوٚدوے زن یہِ نارٕ کٔڈِتھ پرکھاونہٕ تہِ آسہ آمُت۔ اوٕ کِنؠ زِ توٚہہِ چھےٚ یسوعس پٮ۪ٹھ پژھ، خدا دِیہ توٚہہِ تھزر، توٚہہِ پھٔلرایو تہٕ بخشیٚو عزت ییٚلہِ یسوع مسیحؔ واپس پھیرِ تہٕ پننہِ پانُک اظہار کرِ۔
\v 8 توٚہؠ چُھو یسوعس لول بران یوٚدوے زن توٚہہِ سُہ زانہٛہ وُچھمُت چُھنہٕ۔ حالانکہ توٚہؠ چھون نہٕ سہ وُنہِ تہِ وُچھان، توٚہؠ چُھو پژھ کران تس تہٕ تِژھ خوشی مناوان یۅسہ توٚہؠ مُشکلنےٕ بٲوِتھ ہیٚکان چُھو،
\v 9 اوٕ کِنؠ زِ توٚہؠ چُھو ژینان تس پٮ۪ٹھ پننہِ پژھِ ہُنٛد پھل۔ خدا چُھو توٚہہِ پننٮ۪ن گُنہن ہنٛدِ احساس نِشہ نجات دِوان۔
\v 10 واریاہ کالا گو نبیو کوٚر تحقیق بڈٕ محطاطہٕ سان خدایہِ سٕنٛدِ طرفہٕ نجات میلنس متعلق۔ تِمو بوو تہِ یہِ خداین تِمن ووٚن توٚہہِ خدایہِ سٕنٛدِ طرفہٕ نجات میلنس پٮ۪ٹھ۔
\v 11 تِم ٲسؠ کوشش کران زِ تِمن انٛدر بسِتھ مسیحؔ سٕنٛدِ روحُک حوالہٕ کوکُن چُھ تہٕ کتھ زمانس کُن چُھ۔ روحک حوالہٕ ٲسؠ یِم چیز ییٚلہِ تٔمؠ گۅڈے ووٚن زٕ مسیحؔ تُلہِ عِذا تہٕ اوٕ پتہٕ یِن پرٮ۪زلوٕنؠ واقات بارسس۔
\v 12 خداین ووٚن یِمن نبین زِ یہِ چُھنہٕ تُہنٛدِ کُنہِ ذٲتی فٲیدٕ باپتھ زِ سُہ چُھ یِمن چیزن ہُنٛد اظہار کران تِمن۔ بلکہِ چُھ یہِ تہنٛدِ فٲیدٕ باپتھ۔ توٚہہِ یہِ رٕژ شیٚچھ واتناون وٲلؠ چھِ لوٗکھ چھِ امیُک اِظہار کران توٚہہِ تمِس پاک روح سٕنٛدِ برکتہٕ یُس خداین تِمن کُن آسمانہٕ پٮ۪ٹھٕ سوز تہٕ یمؠ تِم اتھ لایق بنٲوؠ۔ فرشتہٕ یژھن تہِ سورےٕ زانُن یہِ یِمو لوٗکو توٚہہِ بوو۔
\v 13 یِمو چیزو کِنؠ کٔرِو تیار پنُن پان عملہِ باپتھ۔ ہُشیار روزیٚو۔ پوٗرٕ اعتمادٕ سان روزیٚو زِ خدا بخشہِ توٚہہِ خٲرٕ سان نجات ییٚلہِ یسوعؔ مسیحؔ واپس ییہِ تہٕ پنُن اِظہار کرِ۔
\v 14 اوٕ کِنؠ زِ توٚہؠ چُھو خدایس مازان یتھٕ پٲٹھؠ زن أکِس شُرِس مٲلؠ سنٛز فرمانبردٲری کرٕنؠ پزِ۔ پانس پٮ۪ٹھ مہٕ دِیو بد خٲہِشن حکم چلاونہٕ یِم توٚہہِ خدایہِ سُنٛد پزر زاننہٕ برونٛہہ حٲوی آسہٕ۔
\v 15 بلکہِ کٔرِو پاک پٲٹھؠ عمل ییٚلہِ تہِ کینٛہہ کٔرِو پننس خدایہِ سٕنٛدؠ پٲٹھؠ یُس پاک چُھ تہٕ توٚہؠ ژٲرؠ نو۔
\v 16 پاک روزیٚو تکیازِ موسیٰؔ ہن لیٚوکھ صحیفن منٛز زِ خداین ووٚن، "پاک روزیٚو تکیازِ بہٕ چُھس پاک۔"
\v 17 خدا چُھ سُہ یُس پرکھاوان چُھ زِ پرٮ۪تھ کانٛہہ نفر کیاہ چُھ کران، تہٕ پرکھاوان چُھ کُنہِ تعصُبہٕ ورٲے۔ اوٕ کِنؠ زِ توٚہؠ چُھو تمِس بب ونان، لہٰذا کٔرِو تِتھٕ پٲٹھؠ عمل یۅسہ یہِ ہاوِ زِ توٚہؠ چُھو تمِس کھوٚژان ییٚلہِ زن توٚہؠ عارضی طور تمِس دوٗر چُھو روزان پننہِ اصل گرٕ نِشہ یُس جنتس منٛز چُھ۔
\v 18 تِتھے پٲٹھؠ کٔرِو عمل۔ تکیازِ توٚہؠ چُھو زانان زِ خدایس پیٚو خرچ کرُن توٚہؠ بچاونہٕ باپتھ احمقٲزی کرنہٕ نِش۔ یہِ زن توٚہؠ پننیٚو اجدادو ہیٚچھنٲومٕتؠ ٲسِو خداین دیُت نہٕ سۅن چٲنٛدؠ یِمنہٕ پوشہٕ وٕنؠ چھِ توٚہہِ بچاونہٕ باپتھ۔
\v 19 بلکہِ خداین بچٲیو توٚہؠ مسیحؔ سنٛز صلیبس پٮ۪ٹھ مۅلٕل قربٲنی دِتھ۔ تسُنٛد مرُن اوس زنٛتہٕ سارِنےٕ صحت منٛد برکتن ہُنٛد موت۔ یِم یہُودؠ کاہنو قربان کٔرؠ۔
\v 20 خداین ژور سُہ یہِ کرنہٕ باپتھ دُنیا بناونہٕ برونٛٹھےٕ۔ وۅنؠ گو خداین کوٚر سُہ ظٲہِر توٚہہِ پٮ۪ٹھ یتھ ٲخری زمانس منٛز۔
\v 21 یہِ مسیحؔ ہن کوٚر تٔمہِ کِنؠ چُھو توٚہؠ وۅنؠ خدایس پٮ۪ٹھ پژھ قٲیِم تھٲوِتھ۔ تٔمؠ کوٚر مسیحؔ مرنہٕ پتہٕ بیٚیہِ زنٛدٕ تہٕ ہوونو زِ سُہ کوتاہ عظیم چُھ۔ امہِ کُے نتیجہٕ چُھ زِ توٚہؠ چُھو خدایس پٮ۪ٹھ پژھ قٲیِم کٔرِتھ۔ تہٕ امید کران زِ سُہ کرِ عظیم کامہِ۔
\v 22 تکیازِ توٚہہِ بنووُو پنُن پان پاک یسوع سنٛزِ پزِ تعلیمہ پٮ۪ٹھ عمل کٔرِتھ تاکہِ توٚہؠ بٔریٚو پزنہٕ پٲٹھؠ باقےٕ ایماندارن لول، بیٚیہِ تھٲیو پانہٕ وٲنؠ لول ایماندٲری سان تہٕ جوشہٕ سان۔
\v 23 یہِ کٔریٚو تکیازِ خداین کرنٲیِو توٚہؠ نوِ زاینُک تجربہٕ۔ توٚہہ کوٚرُو نہٕ یہِ نوو زایُن تجربہٕ کُنہِ فناہ گژھن والہِ چیزٕ سٟتؠ بلکہِ کوٚرُو توٚہہِ یہِ تٔمہِ سٟتؠ یُس فناہ گژھِ: یسوع سٕنٛدِ پٲغامہٕ سٟتؠ یُس خدایہِ سٕنٛدِ طرفہٕ ووتُو تہٕ پزی چُھ پوشہٕ وُن تہٕ روزٕ وُن۔
\v 24 اسہِ چھےٚ خبر زِ یہِ چُھ پوٚز توٕ کِنؠ زِ أمؠ یسعیاہؔ نبین لیٚوکھ،
\q1 "سٲری لوٗکھ چھِ زنٛتہٕ گاسہٕ، تہٕ سورےٕ کینٛہہ لوٗکن متعلق سارِوے کھۅتہٕ عظیم چُھ زنتہٕ پوش گاسس منٛز۔
\q1 یتھٕ پٲٹھؠ گاسہٕ مران چُھ تہٕ  اکھ جنگلؠ پوش چھُ روزان کم وقتس، تِتھے پٲٹھؠ چھِ لوٗکھ مران تہٕ یہِ تِمن متعلق سارِوےٕ کھۅتہٕ عظیم چُھ تہِ چُھ پوشہٕ وُن مگر کینٛژِ کالہٕ باپتھے،
\q1
\v 25 وۅنؠ گو خدایہِ سُنٛد پٲغام چُھ ہمیشہٕ باپتھ۔"
\m یہ پٲغام یُس پوشہٕ وُن چُھ ہمیشہٕ باپتھ چُھ رٕژ شیٚچھ مسیحؔ ہس متعلق یۅسہ اسہِ توٚہہِ بٲوو۔
\c 2
\p
\v 1 چونکہِ یِم چیز چھِ پٔزؠ، اوٕ کِنؠ مہٕ کٔرِو کمین گی تہٕ نَہ مہٕ کٔرِو کٲنٛسہِ سٟتؠ تارن گٔری۔ ظٲہِر دار مہٕ بٔنِو تہٕ نَہ مہٕ تھٲیِو کٲنٛسہِ ہُنٛد ازروُن، نہ مہٕ کٔرِو کٲنٛسہِ ہنٛز غٲبت، تہٕ نَہ مہٕ لٲگِو کٲنٛسہِ ہانٛژ۔
\v 2 یتھٕ پٲٹھؠ نوزٲید چھرا پننہِ ماجہِ ہُنٛد خٲلِص دۅد ژھاران چُھ تِتھے پٲٹھؠ ژھٲرِو توٚہؠ تہِ خدایس متعلق پزرٕچ تعلیم تاکہِ اتھ ہیٚچِھتھ پرٲیو توٚہؠ تہِ روحٲنی پۅختہٕ گی۔ توٚہہِ پزِ یہِ کرُن یوتام توٚہہِ خدا مکمل پٲٹھؠ نجات بخشہِ یمہِ گناہ گار دنیا نِشہ۔
\v 3 توٚہہِ پزِ یہِ کرُن اوٕ کِنؠ زِ توٚہہِ ژیونُو یہِ پانہٕ زِ خداوند کٲژاہ مہربٲنی چُھو توٚہہِ کران۔
\v 4 توٚہؠ آیو خداوند یسوعس کُن۔ سُہ چُھ أکِس پلس ہیٚو یُس اکہِ بڈِ تعمیرک حصہٕ چُھ، وۅنؠ گو سُہ چُھ زنٛدٕ۔ یوٚدوے زن لوٗکو تس انکار کوٚر، خداین ژور سُہ تہٕ چُھس واریاہ قدر کران۔
\v 5 تہٕ توٚہؠ تہِ چُھو پل ہِوؠ یِم زنٛدٕ چھِ۔ یتھٕ پٲٹھؠ لوٗکھ کنیٚو سٟتؠ مکان تعمیر کران چھِ خدا چُھ توٚہہِ اکھ أکِس سٟتؠ رلاوان اکہِ تعمیرٕکؠ پٲٹھؠ یتھ منٛز خدایہِ سُنٛد روح چُھ۔ سُہ چُھو توٚہہِ تہِ تعمیر کران کاہنن ہنٛدؠ پٲٹھؠ یِم خداین الگ ژٲرؠ خدایس خۅش کروٕنہِ پٲکیزٕ عملہٕ کرنہٕ باپتھ، یسوع مسیحؔ سٕنٛدِ برکتہٕ۔
\v 6 یہِ یسعیاہنؔ لیٚوکھ زٕ خداین ووٚن صحیفن منٛز چُھ ہاوان زِ یہِ چُھ پوٚز۔ "دھیان تھٲیو! بہٕ چُھسو یروشلم شہرس منٛز تھاوان اکھ سُہ یُس تعمیرس منٛز اہم کٔنؠ چُھ۔ مےٚ ژور سُہ۔ سُہ چُھ سٮ۪ٹھا مۅلُل۔ تہٕ یُس کانٛہہ تس پٮ۪ٹھ پژھ تھاوِ سُہ سپدِنہٕ یقیناً زانہٛہ بے عزت۔
\v 7 اوے تہِ خدا بخشیٚو توٚہہِ عزت یِم یسوعس پٮ۪ٹھ یقین قٲیِم کرن۔ وۅنؠ گو تم یِم تس اِنکار کرن یقین کرنس چھِ تِمن تعمیر کرن والیٚن ہنٛدؠ پٲٹھؠ یِمن متعلق کمؠ تام زبورن منٛز لیٚوکھ زِ "سۅ کٔنؠ یۅسہ تعمیر کار دٔسِلن دٲرِتھ ژھٕنؠ چھےٚ بنیمٕژ تعمیرچ اہم ترین کٔنؠ۔"
\p
\v 8 یسعیاہنؔ تہِ لیٚوکھ صحیفن منٛز زِ مسیحؔ آسہ زنتہٕ
\q1 "اکھ کٔنؠ یۅسہ لوٗکن کھوٚند دییہِ،
\q1 تہٕ اکھ پل یُس لوٗکن بُتھِ لگہ۔"
\p یتھٕ پٲٹھؠ لوٗکھ چھِ چھۅکل گژھان کنہِ پلہٕ پیٚٹھؠ وسِتھ،
\q1 یِتھٮ۪ن لوٗکن چھےٚ بُتھؠ کھکھٕر لگان خدایہِ سنٛدِس پٲغامس بُتھِ لٔگِتھ؛
\q1 یی سپدِ یہِ خداین اِرادٕ کوٚر۔
\p
\v 9 اُلٹہٕ چُھو توٚہؠ ایماندار تِم لوٗکھ یِم خداین ژٲرمٕتؠ چھِ پننہِ باپتھ۔ توٚہؠ چُھو زنتہٕ کاہنن ہنٛز اکھ جماتھ یِم خدایہِ سنٛز عبادت کران چھِ تہٕ تس سٟتؠ حکمرٲنی کران چھِ۔ توٚہؠ چُھو لوٗکن ہنٛز جماتھ یۅسہ خداین الگ ژٲرمٕژ چھےٚ پننہِ باپتھ۔ توٚہؠ چُھو تِم لوٗکھ یِم ملکِیت چھِ خدایہِ سٕنٛدؠ۔ تاکہِ توٚہؠ کٔرِو اظہار تِمن قٲبل تعریف چیزن ہنٛدؠ یِم خداین کٔرؠ۔ تٔمؠ ٲسِو توٚہؠ پننہِ پرانہِ زُونکہِ وطیرٕ منٛزٕ نٮ۪بر کٔڑؠ مٕتؠ ییٚلہِ توٚہؠ گیٖر ٲسِو گُنہن منٛز تہٕ خدایس متعلق انزان تہٕ تٔمؠ کٔرِو توٚہؠ زٲنؠ یاب پانس متعلق عظیم پزرٕ نِشہ۔
\v 10 یہِ ہوشیع ہنؔ لیٚوکھ توٚہہِ متعلق چُھ پوٚز یِم نہٕ "کُنہِ لُکہٕ جماژ" منٛز ٲسی مگر تِم چھِ وۅنؠ "خدایہِ سنٛزِ جمٲژ منٛزٕ" اکہِ وقتہٕ کوٚر نہٕ خداین توٚہہِ سٟتؠ رحمُک سلوٗک۔ مگر وۅنؠ چُھ سُہ توٚہہِ سٟتؠ رحمُک سلوٗک کران۔
\v 11 ایماندار سٲتھیو یِمن بہٕ لول بران چُھس، توٚہؠ چُھو زنتہٕ پر ملکٕکؠ ہِوؠ۔ یہُنٛد اصل گرٕ چُھ جنتس منٛز۔ اوے چُھسو بہٕ زور دِوان توٚہہِ زِ تِم چیز مہٕ کٔرِو یِم تُہنٛد گناہ گار نفس توٚہہِ کرنس اُکساوان چُھو۔ یِژھٕ خٲہشہِ کرنو توٚہہِ بُرباد۔
\v 12 تِمن لوٗکن منٛز روزیٚو رٕژٕ عملہٕ کران یِمنہٕ خدایس زانان چھِ تاکہِ یِم چیز توٚہؠ وُنکٮ۪س کران چُھو تہٕ یتھ تِم ٲکھِتھ غلط مانان چھِ۔ تِم وچُھن زِ توٚہؠ چُھو ژکہِ رُت کران تہٕ تِم کرن خدایس عزت ییٚلہِ سُہ سارٕنےٕ انصاف کرنہِ ییہِ۔
\v 13 خداوند یسوع مسیحؔ ہس عزت بخشنہٕ باپتھ کٔرِو تِمن سارنےٕ ہنٛز تابعدٲری یِمن طاقت چُھ لوٗکن پٮ۪ٹھ حکمرٲنی کرنُک۔ اتھ منٛز چُھ بادشاہ تہِ تکیازِ تمِس چھےٚ لوٗکن پٮ۪ٹھ ساروےٕ کھۅتہٕ ژٔر حکمرٲنی حٲصل۔
\v 14 اتھ منٛز چھِ تہنٛدؠ گورنر تہِ، تکیازِ بادشاہن سوزؠ تِم سزا دِنہِ تِمن لوٗکن یِم بدکار کران چھِ تہٕ تِمن عزت دِنہِ یِم رٕژٕ کامہِ کران چھِ۔
\v 15 تہنٛز تابعدٲری کٔرِو یِم لوٗکن حکومت کران چھِ۔ تکیازِ یی چُھ خدا یژھان۔ سُہ چُھ یژھان زِ توٚہؠ کٔرِو رٕژٕ کامہِ تاکہِ احمقن سپدِ ٹھوٚر یِمنہٕ خدایس زانان چھِ نادٲنستہٕ پٲٹھؠ یہٕ وننس قٲبل گژھنہٕ نش زِ توٚہہِ چھِ غلط کار کٔرمٕتؠ۔
\v 16 تہنٛز تابعدٲری کٔرِو یِم لوٗکن حکومت کران چھِ تِمن لوٗکن ہنٛدؠ پأٹھؠ یم رضاکارانہٕ یہٕ کرنہٕ خأطرٕ آزاد چھِ، مگر پنٕنؠ حیثیت مہٕ کٔرِو استعمال کرنچ کوشش یتھٕ پٲٹھؠ زن آزاد لوٗکھ غلط کامہِ کٔھٹِتھ تھاونہٕ خاطرٕ کران چھِ۔ امہِ بجایہ، کٔرِو تابعدٲری تِمن لوٗکن ہنٛدؠ پأٹھؠ یِم خدا سنٛز خدمت چھِ کران۔
\v 17 پرٮ۪تھ کٲنٛسہِ کٔرِو عزت۔ پننٮ۪ن تمام ایماندار سٲتھین بٔرِو لول۔ خدایس کٔرِو تعظیم، بادشاہن کٔرِو احترام۔
\v 18 ہے گرٕکُلی غلامو یِم ایمان وٲلؠ چھِ، پننٮ۪ن مٲلکن سٟتؠ تھٲیو مکمل احترامُک وطیرٕ۔ یہِ کٔرِو نہ صرف تِمن مٲلکن سٟتؠ یِم توٚہہِ سٟتؠ رحمُک سلوٗک چھِ کران بلکہِ تِمن سٟتؠ تہِ یِم توٚہہِ سٟتؠ ظلم، زبردستی کران چھِ۔
\v 19 پننٮ۪ن مٲلکن کُن روزیٚو کلہٕ نۅمرِتھ تکیازِ یہِ چُھ تی یتھ خدا چُھ ترجیح چُھ دِوان۔ یوٚدوے کانٛہہ سختی ویٚترایہِ، تہٕ تُلہِ ہنٛگہٕ منٛگہ عِذا سُہ نفر چُھ آگاہ خدایس متعلق تہٕ زانان زِ سُہ کیا چُھ یژھان۔
\v 20 پننٮ۪ن مٲلکن روزیٚو کلہٕ دٲرِتھ، تکیازِ اتھ منٛز چُھنہٕ تہنٛدِ باپتھ کہین عزت یوٚدوے توٚہہِ کانٛہہ اوٕ کِنؠ لایہِ زِ توٚہہِ چُھو گناہ کوٚرمُت۔ بحرہال یہِ چُھ تہِ یتھ خدا مازان چُھ۔ یوٚدوے توٚہہِ برداشت کوٚرُو ییٚلہِ توٚہہِ عِذا ووتُو، توٚہہِ کٔرِو رٕژ کٲم۔
\v 21 خدا چُھ یہِ مازان تکیازِ تٔمؠ دِتو توٚہہِ ناد رُت کران کران عِذا تُلنُک۔ تٔمؠ کوٚرُو توٚہہِ آلو اور کُن تکیازِ مسیحؔ ہن تہِ تُل عِذا تہنٛدِ باپتھ اکھ مثال بننہٕ خٲطرٕ تاکہِ توٚہؠ کٔرِو تی یہِ تٔمؠ کوٚر۔
\q1
\v 22 "تٔمؠ کوٚر نہٕ کانٛہہ گناہ۔
\q1 تہٕ نہ ووٚنُن تیوٚتھ یمہِ سٟتؠ لوٗکن دھوکھہٕ واتہِ۔"
\q1
\v 23 ییٚلہِ لوٗکو تس ملامت کٔر، تٔمؠ کٔر نہٕ تِمن واپس زانہٛہ ملامت۔
\q1 ییٚلہِ تٔمؠ عِذا تُل، تٔمؠ دِژ نہٕ تِمن زانہٛہ تہِ دھمکی یِمو تس عِذا واتنوو۔
\q1 بلکہِ تھٲوٕن پژھ قٲیِم خدایس پٮ۪ٹھ، یُس سارنےٕ پرکھاوان چُھ یہِ ہاونہٕ باپتھ زِ سُہ چُھ معصوم۔
\q1
\v 24 پانہٕ آو مسیحؔ ہس سزا دِنہٕ سانیٚو گنہو کِنؠ تٔمسنٛدِس جسمس ییٚلہِ سُہ مود صلیبس پٮ۪ٹھ یمہِ مقصدٕ باپتھ زِ أسؠ زُوو پاک پٲٹھؠ تکیازِ أسؠ چھِنہٕ وۅنؠ گنہس انٛدر۔
\p خداین بٔلرٲیو توٚہؠ تکیازِ لوٗکو دِتؠ مسیحؔ ہس چھۅکھ۔
\v 25 خداین بٔلرٲیو توٚہؠ تکیازِ توٚہؠ ٲسِو خدایس ژھٮ۪نہٕ گٲمٕتؠ تِمن تیرن ہنٛدؠ پٲٹھؠ یِم رٲومٕتؠ ٲسؠ، مگر وۅنؠ أنِو خداین واپس مسیحؔ ہس نِش۔ یس تُہنٛد پرواہ چُھ تہٕ رٲچھ چُھو۔ یتھٕ پٲٹھؠ اکھ پُہل پننٮ۪ن تیٖرن رچھان چُھ آسان۔
\c 3
\p
\v 1 یِتھے پٲٹھؠ چُھو توٚہؠ زنانہٕ یِم ایمان واجنہِ چھےٚ، پننٮ۪ن خانٛدارن روزیٚو تابعہ۔ یہٕ کٔرِو تاکہِ توٚہؠ کٔرؠ وُون کانٛہہ تہِ خانٛدار قٲیل مسیحؔ سٕنٛدِس پٲغامس کُن یُس نہٕ اتھ پٲغامس پٮ۪ٹھ یقین چُھ کران، توٚہہِ کینٛہہ وننہٕ بغٲر گژھہٕ تیار ایمان وول بننہٕ خٲطرٕ۔
\v 2 تِم کرن مسیحؔ ہس پٮ۪ٹھ یقین تکیازِ تِم چھِ وُچھان زِ توٚہؠ چُھو خلوصہٕ سان برتاو کران تہٕ پیش یِوان احترامہٕ سان تِمن کُن۔
\v 3 پننہِ جِسمُک نیٚبرِم حصہٕ مہٕ بنٲیِو مستُک خوبصورت انداز یا سۅنہٕ سٕنٛدؠ جوٲہر یا کھٔسِتھ پلو لٲگِتھ۔
\v 4 امہِ بجایہ بنٲیِو پنُن دماغ تِتھٕ پٲٹھؠ خوبصورت یُس نہٕ زانٛہہ تہِ سورِ۔ میون مطلب چُھ عٲجِز تہٕ پُرامن رٔویہِ تھٲوِتھ۔ یہِ چُھ سُہ چیز یتھ خدا واریاہ قدر چُھ کران۔
\v 5 یہِ کٔرِو تکیازِ یہِ چھےٚ سۅ وَتھ یمہِ وتہِ واریاہ برونٛہہ رٕژ زندگی گزارن واجنیٚو زنانو بنوو پنُن پان خوبصورت۔ تِمو کوٚر خدایس پٮ۪ٹھ بھروسہٕ تہٕ رودؠ پننٮ۪ن خاندارن تابعہ۔
\v 6 مثلاً، سارہؔ ہن کٔر پننس خانٛدار ابرہامؔ سنٛز اطاعت تہٕ ووٚنُن تمِس پنُن آغہٕ۔ خدا زانہِ توٚہہِ پننہِ کورِ یوٚدوے توٚہؠ رٕژٕ کامہِ کٔرِو تہٕ بیٚیہِ کھوٚژِو نہٕ تِمن وہناک چیزن یِم توٚہہِ سٟتؠ واقع سپدن۔
\v 7 توٚہؠ لوٗکھ یِم ایمان وٲلؠ چُھو، بٔسِو امی سمجدٲری سان پننٮ۪ن آشنٮ۪ن سٟتؠ۔ یِمن سٟتؠ کٔرِو سلوک یتھٕ پٲٹھؠ زن توٚہؠ کٲنٛسہِ لیٚژِس سٟتؠ کٔرِو۔ یِمن کٔریو عزت تِمن ہنٛدؠ پٲٹھؠ یِم توٚہہِ سٟتؠ سٟتؠ خدایہِ سُنٛد انعام پراون یعنی پوشہٕ وٕنؠ زندگی۔ یی کٔرِو تاکہِ کینٛہہ تہِ انہِ نہٕ تہنٛدِس دُعا منٛگنس تھۅس۔
\v 8 یمہِ نامُک ٲخری حصہٕ مۅکلاونہٕ وِزِ چُھس بہٕ توٚہہِ سارنے ونان زِ ہیٚو ذہن تھٲیو پانہٕ وٲنؠ۔ اکھ أکؠ سنٛز بنیو ستتھ تہٕ تسلی۔ اکھ أکِس سٟتؠ روزیٚو ایماندار سٲتھی بٔنِتھ لولہٕ سان۔ اکھ أکِس سٟتؠ کٔرِو رحمُک ورتاو۔ حلیم بٔنِو۔
\v 9 ییٚلہِ لوٗکھ توٚہہِ سٟتؠ کینٛہہ بد ورتاون یا بے عزتی کرنو، توٚہؠ مہٕ کٔرِو یورٕ تہِ یی۔ بلکہِ منٛگیٚو تِمن کیُت خٲر تکیازِ خداین ژٲرِو توٚہؠ اوے مۅکھہٕ تاکہِ سُہ بخشہِ توٚہہِ پنُن فضل۔
\v 10 أسؠ چھِ زانان زِ یہِ چُھ پزر، تکیازِ یتھٕ پٲٹھؠ زن داوودنؔ لیٚوکھ،
\q1 "تِم یِم پزنہٕ پٲٹھؠ رٕژِ زندگی نِش لطف اندوز سپدُن یژھان چھِ،
\q1 تِمن پزِ نہٕ بد ونن یا تارن گٔری کرن۔
\q1
\v 11 تِمن پزِ بدکار کرنس کلہٕ مورُن، بلکہِ تہ کرن یہِ رُت آسہ۔
\q1 تِمن پزِ بیٚین لوٗکن سٟتؠ امنہٕ سان تعلقات قٲیِم کرنہٕ خٲطرٕ محنتہٕ سان کوشش کرٕنؠ۔
\q1
\v 12 تِمن پزن یِم چیز کرٕنؠ تکیازِ خداوند چُھ راستباز لوٗکن دیدمان وُچھان روزان،
\q1 سُہ چُھ نیک کار لوٗکن ہُنٛد منگُن قبول تھاوان،
\q1 مگر بدکارن رد کران۔"
\p
\v 13 ییٚلہِ توٚہؠ نیکی کرنس کُن تنہٕ منہٕ روزیٚو، مُشکلنےٕ کرِ توٚہہِ سٟتؠ کانٛہہ بد۔
\v 14 وۅنؠ گوو یوٚدوے توٚہؠ عِذا تُلِو کینٛہہ رُت کران کران۔ توٚہہِ پٮ۪ٹھ کرِ خدا پنُن فضل۔ "مہٕ کھوٚژِو تہٕ نہ مہٕ سپدِیو پریشان تِمو چیزو سٟتؠ یِمن باقےٕ لوٗکھ کھوٚژان چھِ۔"
\v 15 پننِس ذہنس منٛز بسٲیو یہِ خیال زِ خداوند مسیحؔ چُھ پاک۔ ہر وِزِ روزیٚو تیار تِمن لوٗکن جواب دنہٕ باپتھ یِم پرژھنو زِ توٚہؠ کیا چُھ اعتمٲدی سان کران زِ خدا گژھِ، تہنٛدِ باپتھ کرُن۔
\v 16 وۅنؠ گوو یِمن دِیو جواب بڈٕ نرمی تہٕ انکسٲری سان، کینٛہہ ویکھُت ورتاونہٕ ورٲے تاکہِ خدا کرِ تِمن شرمنٛدٕ یِم تتھ خٲرس رد کران چھِ یہِ توٚہؠ مسیحؔ ہس سٟتؠ یکُت کٔرتھ لوٗکھ ٲسِتھ کران چُھو۔ خدا کرِ تِمن شرمندٕ تکیازِ تِم چھِ توٚہہِ متعلق اپزِ کتھہٕ پھہلاوان۔
\v 17 یِمے چیز کٔرِو تکیازِ یوٚدوے خدا چُھ یژھان زِ توٚہؠ تُلِو عِذا، یہِ چُھ بہتر زِ توٚہؠ تُلِو عِذا تکیازِ توٚہؠ چُھو رُت کران امہِ بجایہ زِ توٚہؠ تُلِو عِذا کُنہٕ بد کارٕ کِنؠ۔
\v 18 یہِ چُھ پزر تکیازِ مسیحؔ ہن تہِ تُل عِذا۔ تٔمؠ تُل اکہِ وِزِ عِذا باقےٕ لوٗکو ہنٛدیٚو گنہو باپتھ۔ سُہ اوس راستباز شخص یُس غٲر راستباز لوٗکن ہنٛدِ فٲیدٕ باپتھ مود۔ یوٚدوے زن سُہ لوٗکو قتل کوٚر، خدایہ سنٛدؠ روحن کوٚر سُہ دُبارٕ زنٛدٕ۔
\v 19 امی روحن بنوو سُہ اتھ لایق زِ سُہ کرِ خدایہِ سنٛدِ فتح مندی ہُنٛد اعلان تِمن بدروحن تہِ یِم خداین بٲنٛدؠ بنٲومٕتؠ چھِ۔
\v 20 یِمو بد روحو کٔر سٮ۪ٹھا برونٛہہ نوح سنٛدِس زمانس منٛز خدایس نافرمانی ییٚلہِ نوح اکھ ناو بناوان اوس۔ خدا رود پرارٕ وُن زِ اما یِم لوٗکھ ما تراون گناہ کرٕنؠ۔ چھرا کینٛژوٕے لوٗکو لوٚب نجات اتھ ناوِ منٛز۔ خاص پٲٹھؠ أنؠ خداین امہِ سہلابہٕ منٛزٕ چھرا ٲٹھے نفر بوٚٹھ کھٲلِتھ۔
\v 21 یہِ آب چُھ سۅ علامت یۅسہ بپتسمہ دِنٕچ نمایندگی کران چُھ یُس وۅنؠ توٚہہِ نجات دِوان چُھو۔ یہِ بپتسمہ چُھنہٕ تہنٛدٮ۪ن جسمن ہنٛز گندگی چھلان۔ بلکہِ چُھ یہِ باوان زِ أسؠ چھِ منٛگان خدایس یہِ یقین زِ تٔمؠ بخشؠ اسہِ پنٕنؠ کٔرؠ مٕتؠ گناہ۔ یہِ بپتسمہ چُھ توٚہہِ نجات دِوان خدایہِ سنٛدِ طرفہٕ یسوع مسیحؔ ہس دبارٕ زندٕ پراونہٕ کِنؠ۔
\v 22 امہِ پتہٕ ییٚلہِ خداین پرٮ۪تھ کانٛہہ خبیث تہٕ طاقتہٕ وول روح تمِس تٲبین کوٚر، کھوٚت مسیحؔ آسمانس پٮ۪ٹھ، ییٚتہِ سُہ خدایس نکھہٕ عزتچہِ ساروےٕ کھۅتہٕ تھزِ جایہِ چُھ۔
\c 4
\p
\v 1 اوٕ کِنؠ زِ مسیحؔ ہن تُل جسمٲنی عذاب، توٚہؠ تہِ سپدِو تیار باقے مسیحؔ ہن ہنٛدؠ پٲٹھؠ عذاب تُلنہٕ باپتھ۔ یہِ سونچان زِ مسیحؔ ہن کِتھہٕ تُل عذاب۔ یی کٔرِو تکیازِ تِم یِم جسمٲنی عذآب تُلن، چُھنہٕ ہرگِز گنہن منٛز سپدن گیٖر۔
\v 2 تاکہِ تِم کرن نہٕ تِتھؠ چیز یِم گناہ گار لوٗکھ یژھان چھِ کرٕنؠ سٲرؠ سےٕ زُوون کالس منٛز۔ تِم چھِ امہِ بجایہ تِم چیز کرنہٕ خٲطرٕ زنٛدٕ روزان، یِم خدا یژھان چُھ زِ تِم گژھن کرٕنؠ۔
\v 3 بہٕ چُھسو یہِ ونان اوٕ کِنؠ زِ توٚہؠ چُھو برونٛٹھےٕ پنن واریاہ زُوون کال تہ کران خرچ کوٚرمُت یہِ خدایس نہ زانن وٲلؠ کران چھِ۔ تہنٛدؠ پٲٹھؠ کَریوٕ توٚہہِ جنسی طور غٲر اخلٲقی تہٕ نفسٲنی عملہٕ۔ شراب چٮ۪تھ گو مس تہٕ غٲر اخلٲقی مجلسن، شرابہٕ محفلن تہٕ پۅتٕلؠ پوٗزایہِ منٛز راوٕ روو وقت یتھ زن خداین ٹھاکھ اوس کوٚرمُت۔
\v 4 یِمن چیزن کُن وُچِھتھ چھِ خدایس نہ زانن وٲلؠ حٲران سپدان زِ توٚہؠ چُھونہٕ شریک سپدان تِمن سٟتؠ وۅنؠ تہنٛدٮ۪ن فضول بے وایہِ غٲر اخلٲقی چیزن منٛز۔ امیُک تر چُھ یہِ زِ تِم چھِ توٚہہِ کۅ کتھ لٲگِتھ تھاوان۔
\v 5 اکہِ دوٚہہ چُھ یِمن لوٗکن خدایس برونٛہہ کنہِ جواب دیُن پرٮ۪تھ چیزُک یہِ تِمو کوٚرمُت آسہ۔ سُے کرِ پرٮ۪تھ کٲنٛسہِ ہنٛزن عملن ہُنٛد انصاف۔
\v 6 اوٕ کِنؠ چُھ لوٗکو یسوعس متعلق رٕژِ شیٚچھِ ہنٛز تعلیم دِژمٕژ تِمن ایمان والیٚن لوٗکن یِم وۅنؠ مودمٕتؠ چھِ۔ تاکہِ یِم ایمان وٲلؠ یِمن لوٗکھ انسٲنی معیارو پرکھاوان ٲسؠ پننِس زُوون کالس منٛز چھِ وۅنؠ پاک روحکہِ برکتہٕ ہمیشہٕ باپتھ خدٲیی معیارو زُووان۔
\v 7 یتھ زمینہِ پٮ۪ٹھ گژھن سٲری چیز جلدے فناہ۔ اوٕ کِنؠ ہیٚیِو صاف صاف عقلہِ کٲم تاکہِ توٚہؠ کٔرِو رٕژ عبادت۔
\v 8 سارِوےٕ کھۅتہٕ اہم اکھ أکِس سٟتؠ تھٲیِو محبت خلوصہٕ سان۔ تکیازِ ییٚلہِ توٚہؠ کٲنٛسہِ محبت کٔرِو توٚہؠ کٔرِو تسٕنٛدؠ تِم سٲری اتٕرؠ معاف یِم تٔمؠ توٚہہِ سٟتؠ کٔرؠ۔
\v 9 پانس کُن یِنہٕ والیٚن مسیحؔ ہن دِیو کھٮ۪ن چٮ۪ن، روزن تہٕ شونٛگن جاے خوش خوش۔
\v 10 پننٮ۪ن ایماندار سٲتھین دِیو تِم تحفہٕ یِم زن خداین توٚہہِ دتِو۔ تِم بیوٚن بیوٚن تحفہٕ تھٲیو وارٕ پٲٹھؠ یِم توٚہہِ خداین دِتؠ مٕتؠ چُھو۔
\v 11 یِم کینٛہہ ونان چھِ تِمن پزِ تِتھے پٲٹھؠ کتھ ونٕنؠ یتھٕ پٲٹھؠ خداین ؤنؠ۔ یِم تِمن خدمت کرن تِمن پزِ تمی طاقتہٕ یہِ خدمت کرٕنؠ یُس تِمن خداین دِیُتمُت چُھ۔ یی کٔرِو خدایہِ سنٛز عظمت ہاونہٕ باپتھ تہِ کٔرِتھ یتھ لایق توٚہؠ یسوع مسیحؔ ہن بنٲیِو۔ بہٕ چُھس عٲجزی کران زِ پرٮ۪تھ کانٛہہ وُچِھن سُہ کوتاہ تابناک تہٕ پُرقوت چُھ ہمیشہٕ ہمیشہٕ باپتھ۔ خدا کٔرِن یہ بٔنِنؠ۔
\v 12 ایماندار سٲتھیو یِمن بہٕ لول بران چُھس، یِمو دھوکھہٕ دٲوؠ چیزو سٟتؠ مہٕ گٔژھِو حٲران۔ یِم توٚہہِ ژٮ۪ترٲیو۔ یِم چیز چُھو توٚہہِ آزمٲیش کران یتھٕ کِنؠ لوٗکھ کُنہِ دھاتس نارس ترٲوِتھ آزماوان چھِ۔ یہِ مہٕ سونٛچِو زِ توٚہہِ سٟتؠ چُھ کہتام نوو سپدان۔
\v 13 امہِ بدلہٕ گٔژھِو کم زیادٕ خۅش زِ توٚہؠ چُھو تِتھُے عذاب تُلان یُس عذاب مسیحؔ ہن تُلمُت چُھ۔ خۅش گٔژھِو پنُن عذاب تُلان تاکہِ توٚہؠ سپدِو خۅش ییٚلہِ مسیحؔ واپس پھیرِ تہٕ پرٮ۪تھ کٲنٛسہِ ہاوِ زِ سُہ کوتاہ جلال وول چُھ۔
\v 14 یوٚدوے باقےٕ لوٗکھ توٚہہِ یُتھ تیُتھ ونن اوٕ کِنؠ زِ توٚہؠ چُھو پژھ کران مسیحؔ ہس۔ خداین کوٚرُو توٚہہِ فضل تکیازِ تُہنٛد عذاب تلُن چُھ ہاوان زِ خدا سنٛز عظمت درشاوان وول روح چُھ توٚہہِ منٛز بسِتھ۔
\v 15 یہِ کتھ بنٲیو یقینی زِ توٚہؠ تُلِو نہٕ عذاب اوٕ کِنؠ زِ توٚہہِ موٕرون کانٛہہ یا نیو کینٛہہ ژوٗرِ یا کۅرو کانٛہہ کۅ کار یا باقین ہنٛدٮ۪ن معاملن منٛز دِتُو بیجا دخل۔
\v 16 مگر امہِ موجُب مہٕ گٔژھِو شرمنٛدٕ زِ توٚہہِ تُلو عذاب مسیحیؔ آسنہٕ کِنؠ۔ بلکہِ کٔرِو خدا سُنٛد شکُر زِ توٚہہِ چُھو ناو "مسیحیؔ"
\v 17 بہٕ چُھسو یہِ ونان اوٕ کِنؠ زِ یہِ چُھ وۅنؠ وق لوٗکھ خدایہِ سٕنٛدؠ دٔسؠ پرکھاونہٕ یِنُک۔ گۅڈٕ پرکھاوِ سُہ تِمن یِم تسٕنٛدؠ چھِ۔ چونکہِ سُہ پرکھاوِ ایمان والیٚن گۅڈٕ۔ سونٛچِو کم ہٲبتناک چیز سپدن تِمن سٟتؠ یِم ٲخرس تسنٛدِ طرفہٕ آمژِ رٕژِ شیٚچھِ انکار کرن۔
\v 18 سلیمانن تہِ لیوکھ صحیفن منٛز،
\q1 "یوٚدوے رٕژِ وتہِ پکن والیٚن راستباز لوٗکن جنتس گژھنہٕ برونٛہہ عذاب پیٚیہِ تلُن،
\q1 کوتاہ زیادٕ ویکھت عذاب آسہ تلُن بیزار تہٕ گناہ گار لوٗکن!"
\p
\v 19 اوے تہِ یوٚدوے تِم لوٗکھ یِم عذاب چھِ تُلان تکیازِ خدا چُھ یژھان تُہنٛد عذاب تلُن۔ تِمن پزِ خدایس کُن پژھ قٲیِم تھاوٕنؠ پننہِ زُو جانہٕ رٕژ عمل برابر جٲری تھٲوِتھ۔ خداین أنؠ تِم وجودس تہٕ سُہ چُھ ہمیشہٕ تہِ کران یمیُک تٔمؠ وعدٕ چُھ کوٚرمُت۔
\c 5
\p
\v 1 وۅنؠ چُھس بہٕ پطرس توٚہہِ منٛز موجود زِٹھٮ۪ن تلقین کران یِم ایمان والیٚن ہنٛدٮ۪ن اجلاسن تہٕ مجلسن رہنمٲیی چھِ کران۔ بہٕ تہِ چُھس اکھ زیُٹھ۔ مےٚ وُچھ دیدمان مسیحؔ عذاب تُلان۔ تہٕ بہٕ کرٕ شرکت تس سنٛز عظیم فطرژ منٛز یتھ خدا ؤلی ظٲہر کرِ۔
\v 2 توٚہہِ زِٹھٮ۪ن پزِ پرواہ کرُن پانس سٟتؠ ایمان والیٚن یتھٕ پٲٹھؠ اکھ پُہل پننہِ تیر کھیٚلیُک خیال تھاوان چُھ یِمن ہُنٛد تھٲیو خیال اوٕ کِنؠ نہٕ زِ توٚہہِ پزِ یہِ کرُن بلکہِ توٚہؠ چُھو پزنہٕ پٲٹھؠ یی یژھان یہِ خدا یژھان چُھ۔ یہِ مہٕ کٔرِو کُنہِ لالچہِ کِنؠ پونٛسہٕ حٲصل کرنہٕ باپتھ بلکہِ کٔرِو یہِ جوشہٕ سان۔
\v 3 یہِ مہٕ کٔرِو حٲکم بٔنِتھ لوٗکن پٮ۪ٹھ یِم خداین تہنٛدِس تحویلس منٛز دِتؠ بلکہِ بٔنِو اکھ رٕژ مثال باقےٕ ایمان والیٚن ہنٛدِ باپتھ یہِ ہٲوِتھ زِ توٚہؠ کِتھہٕ پٲٹھؠ چُھو پنٕنؠ زندگی پکناوان۔
\v 4 یوٚدوے توٚہؠ یِم چیز کٔرِو تیٚلہ ییٚلہِ یسوع، یُس تہنٛدِ باپتھ اکھ پُہل ہیٚو چُھ، ظٲہر سپدِ، سُہ دِیہ توٚہہِ پرٮ۪تھ کٲنٛسہِ زِٹھِس انعام۔ سُہ انعام آسہ جلالہٕ وول تہٕ ہمیشہٕ پوشہٕ وُن۔
\v 5 امہِ آیہِ پزِ توٚہہِ جوانن تہِ پننٮ۪ن تِمن زِٹھٮ۪ن ہنٛز تابعدٲری کرٕنؠ یِم مجلسن رہنمٲیی کران چھِ۔ توٚہہِ سارنےٕ ایمان والیٚن پزِ اکھ أکِس سٟتؠ بڈٕ انکسٲری سان پیش یُن تکیازِ یہِ سلیمانن لیٚوکھ پننٮ۪ن صحیفن منٛز چُھ پوٚز: "خدا چُھ گمنٛڈ کرن والیٚن بُتھؠ ژٔنٛڈ دِوان تہٕ انکسٲری ورتاون والیٚن سٟتؠ رحم کران۔"
\v 6 چونکہِ یہِ چُھ پوٚز۔ خدایس برونٛہہ کنہِ روزیٚو عٲجزی سان یمس لوٗکن بچاونُک تہٕ سزا دِنُک طاقت چُھ۔ تاکہِ سُہ بخشہِ توٚہہِ منٲسب وقتس پٮ۪ٹھ عزت۔
\v 7 خدایس پٮ۪ٹھ تھٲیو پژھ زِ سُہ سمبالہِ تتھ پرٮ۪تھ چیزس یُس توٚہہِ پریشان کروُن چُھ تکیازِ تس چُھ تُہنٛد پرواہ۔
\v 8 سونٛچو صاف صاف تہٕ ہوشہٕ سان تکیازِ شیطان چُھ تُہنٛد دُشمن تہٕ سُہ چُھ انٛدٕ ونٛدٕ پھیران، لوٗکن گمراہ کرنہٕ باپتھ ژھاران روزان۔ سُہ چُھ زٲنؠ تو اکھ سٕہہ ہیٚو یُس گرٮ۪زان روزان چُھ لوٗکھ ژھارنہٕ باپتھ تہٕ تِمن مارنہٕ تہٕ کھٮ۪نہٕ باپتھ۔
\v 9 أمِس شیطانس لگو مقابلس مسیحؔ تہٕ تسٕنٛدِس پٲغامس پٮ۪ٹھ پۅختہٕ پژھ قٲیِم تھٲوِتھ یی کٔرِو تکیازِ توٚہؠ چُھو زانان زِ تہنٛدؠ ایماندار سٲتھی چھِ سٲرؠ سےٕ زگتس منٛز یِتھے پٲٹھؠ دۅکھ تُلان۔
\v 10 مگر ییٚلہِ توٚہؠ کُنہِ قلیل وقتس دۅکھ تُلِو، سُہ خدا یُس توٚہہِ سٟتؠ پرٮ۪تھ رنگہٕ رحم دلی ہُنٛد سلوٗک کران چُھ، کرِ پانہٕ سُہ سورےٕ کینٛہہ بحال یہِ توٚہہِ روومُت چُھو تہٕ بیٚیہِ کریوٕ توٚہہِ پرٮ۪تھ رنگہٕ مکمل پٲٹھؠ مضبوط۔ خدا چُھ سُہ یمؠ توٚہؠ ژٲرِو پنٕنؠ تابنٲکی ژٮ۪تراونہٕ باپتھ جنتس منٛز ہمیشہٕ ہمیشہٕ باپتھ۔ ییٚلہِ توٚہؠ مسیحؔ ہس سٟتؠ جُرِو۔
\v 11 بہٕ چُھس دعا منٛگان زِ سُہ کٔرِن پنٕنہِ قوت سان ہمیشہٕ ہمیشہٕ حکمرٲنی۔ آمین!
\v 12 یہِ نامہٕ لیٚوکھ سلوانس میانہِ باپتھ یمِس مےٚ یہِ پننہِ زیٚوِ ووٚن بہٕ چُھسن سُہ اکھ تابعدار ایمان وول زانان۔ مےٚ لیٚوکھ توٚہہِ یہِ مختصر نامہٕ تاکہِ توٚہہِ میلہِ ہمت تہٕ بیٚیہِ توٚہہِ یہِ ونننہٕ باپتھ زِ یِتہِ مےٚ توٚہہِ لیٚوکھ سُہ چُھ پزرس تہٕ خدایہ سٕنٛدِس عظیم پٲغامس متعلق۔ اتھ پٲغامس پٮ۪ٹھ تھٲیِو لٔگؠ تھےٕ پژھ۔
\v 13 یمہِ شہرٕ پٮ۪ٹھٕ یتھ أسؠ بابل ونان چھِ چُھو توٚہؠ ایمان وٲلؠ۔ یِم خداین تہنٛدؠ پٲٹھؠ ژٲرؠ پننہِ باپتھ چھِ توٚہہِ سلام سوزان۔ مرقُس یُس مےٚ پنُن نیٚچو ہیٚو چُھ تہِ چُھو توٚہہِ سلام سوزان۔
\v 14 اکھ أکِس کٔرِو مایہِ سان اکھ میوٗٹھ یہِ ہاونہٕ باپتھ زِ توٚہہِ چُھو اکھ أکؠ سُنٛد لول۔ بہٕ چُھس منٛگان زِ خدا تھٲوِنؠ توٚہہِ یِم مسیحؔ ہس سٟتؠ جُرِتھ چھِ امنہٕ سان۔
