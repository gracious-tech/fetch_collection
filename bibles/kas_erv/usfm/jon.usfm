\id JON - DMT Kashmiri
\toc1 یوناہ
\mt1 یُوناہ
\c 1
\p
\v 1 اَکھ دوٚہا سپُد زِ یہُوواہنؔ ووٚن امِتیؔ سٕنٛدِس نیٚچوِس یُوناہؔ نبیس۔ یہُوواہنؔ ووٚن أمِس یہ:
\v 2 "بہٕ چُھس پانہٕ وُچھان زِ نینوہؔ شہرٕکؠ لوٗکھ چھِ لگاتار یچھ تہٕ ناکارٕ کامہِ ہیٚتھےٕ کران۔ اوے تہِ گژھ تیار سفرٕ باپتھ۔ نیر نینوہؔ کُن یۅسہ اسیریا مُلکٕچ اکھ بٔڈ رازدٲنؠ چھےٚ تہٕ تِمن لوٗکن منٛز کر اعلان زِ بہٕ چُھس تہنٛزو یچھ کامیٚو باپتھ تِمن سزا دِنہٕ وول۔
\v 3 اوے تہِ دراو یونس مگر یورکُن وننہٕ آس تتھ مُخٲلِف وتہِ کُن۔ اکِس دوٗر دراز شہر ترسِیس کُن۔ یہِ سونٛچِتھ زِ سُہ ہیٚکہِ یہُوواہسؔ ژوٗرِ ژٔلِتھ۔ سُہ ووت یوفاؔ شہرٕ کِس بندرگاہس پٮ۪ٹھ تہٕ وچُھن اتہِ تسریس شہرس کُن نیرن وول ٲبی جہازٕ۔ جہازٕکؠ ناخدا کپتانن منٛجِس کراے تہٕ تٔمؠ دِژٕس۔ اوٕ پتہٕ ووٚتھ سُہ ناوِ أکِس ناخدا تہٕ باقےٕ ناوِ ہٲنٛزن سٟتؠ ترسیس گژھنہٕ باپتھ تاکہِ سُہ ثلہِ یہُوواہسؔ نِش دوٗر۔
\v 4 مگر یہُوواہنؔ تُل تیُتھ واوٕ گٹہٕ کار یمؠ سورےٕ سدُر وول تہٕ تیُتھ طوٗفان ووٚتھ زِ ملریٚو ہٮ۪ژ ناو کانہِ کانہِ کرٕنؠ۔
\v 5 ناوِ ہٲنٛزن ژایہِ نَٹھ تہٕ لوُگُکھ پننٮ۪ن دیوتاہن بڈِ بڈِ زارٕ پارٕ کرُن تاکہِ دیوتا دِیہ تِمن امہِ طوٗفانہٕ نِشہ نجات۔ اکُتھے ژھُن تِمو پننہِ ناوِ ہُنٛد مال سامان تہِ سۅدرس تاکہِ ناو گژھِ ہلکہٕ۔ یہِ کرنہٕ کِنۍ ٲس تِمن امید زِ تہنٛز ناو پھیرِ نہٕ دُبہٕ تہٕ گژھِ سۅدرٕ بُزؠ۔ یِمن سارنےٕ وُچاپہٕ حالاتن منٛز اوس یونس ناوِ ہنٛدِ ہیرمہِ تختہٕ بوٚن یعنی بۅنمِس پورس منٛز مژِ نٮ۪نٛدرِ۔
\v 6 اوٕ پتہٕ ووٚتھ ناوِ ہُنٛد کپتان بونمِس پورس ییٚتہِ یونس شونٛگِتھ اوس۔ تٔمؠ کوٚر یونس ہُشار تہٕ ووٚننس۔ باسان چُھم ژےٚ چھُےٕ کہتام ور ہیٚو بُتھِس واوٕ طوٗفانس منٛز تہٕ چھُکھ ژٕ شونٛگتھےٕ۔ وۅتھ تھوٚد پننس خدایس کر ؤلؠ ؤلؠ زارٕ پارٕ۔ شاید سونچہِ سُہ خدا سون تہٕ اسہِ بچاوِ۔
\v 7 پتہٕ ووٚن أکؠ ہٲنٛزن باقین، "اوے تہِ تراو یِمو چیرِ تہٕ چیرِ تلہٕ دراو یہِ نفر یونس۔
\v 8 اوے تہِ ووٚن أکؠ ناوِ ہٲنٛزن أمِس، "ژےٚ پزی اَسہِ ونُن زِ یہِ وُچاپہٕ حالت کٔمؠ أنؠ اسہِ پٮ۪ٹھ ۅتلٲوِتھ۔ ژٕ کۅس کٲم چُھکھ کران۔ ژٕ آکھ کتہِ پٮ۪ٹھٕ ژٕ کٔمہِ ملکُک چھُکھ، ژٕ کمہِ لُکہٕ جمٲژ ہُنٛد چھُکھ۔
\v 9 یونس ووٚتھ یورٕ، "بہٕ چُھس عِبرٲنؠ۔ بہٕ چُھس یہُوواہؔ سنٛز عبادت کران یُس پوٚز خدا چُھ تہٕ آسمانن پٮ۪ٹھ چُھ روزان۔ تٔمؠ بنوو یہ سۅدُر تہِ تہٕ یہِ زمین تہِ۔
\v 10 ناوٕ ہٲنٛز ٲسؠ زانان زِ یونس چُھ یہُوواہسؔ نِش دوٗر ژلنٕچ کوشش کران تاکہ تمہ کامہ نِشہ بچاوِ پان یۅسہ یہُوواہنؔ تس کرٕنؠ ؤنؠ مٕژ ٲس۔ تکیازِ تٔمؠ اوس تِمن یہِ پانے ووٚنمُت مگر وۅنؠ ییٚلہِ تِمو بوز زِ یہُوواہؔ چُھ سٕدرس سنبٲلِتھ۔ تِمن ژایہِ نٹھ۔ أکؠ ہٲنٛزن ووٚن تس، "ژےٚ چھیٚتھ اکھ وُچاپہٕ حرکت کٔرمٕژ تہٕ أسؠ سٲری چھِ چٲنؠ کِنؠ مرنس وٲتؠ مٕتؠ۔
\v 11 واو رود رژھِ رژھِ نیران تہٕ ملرٕ ہٮ۪ژن بجہِ بجہِ گژھنہِ۔ اوے ووٚن أکؠ ہٲنٛزن یونسس، "اسہِ کیا ہیٚو پزِ ژےٚ سٟتؠ کرُن یُتھ یہِ واوٕ طوٗفان ھامہِ گژھِ تہٕ اسہِ کھۅژناوُن تراوِ۔
\v 12 یونسن ونُکھ۔ "تُلیٚو مےٚ تہِ لٲیؠ ووم سۅدرس منٛز۔ یوٚدوے توٚہؠ یہِ کٔرِو سۅدر بیٚہہِ لۅتہِ تہٕ توٚہہِ ترایو کھوٚژناوُن۔ یہِ کرنہٕ سٟتؠ انٛدِ کٲم ضروٗر تکیازِ یہِ وُچاپہٕ طوٗفان ووٚتھ چھرا میٲنؠ کِنؠ تکیازِ مےٚ کٔر نہٕ سۅ کٲم یۅسہ مےٚ یہُوواہنؔ کرٕنؠ ؤنؠ۔
\v 13 مگر ہٲنٛز ٲسؠ نہٕ یہِ کرُن یژھان۔ امہِ بدلہٕ لوگ تِمو پنُن سورےٕ زور پنٕنؠ ناو بٔٹھِس کُن نِنہٕ باپتھ۔ مگر تِمو ہیوٚک نہٕ یہِ کٔرؠ تھےٕ تکیازِ ملریو ہیوٚت زیادٕ زیادٕ پوچھر تہٕ زور تِمن خلاف۔
\v 14 چھیکرس موٚنگ ساروے ہٲنٛزو یہُوواہسؔ زارٕ پارٕ کران ہے یہُوواہؔ چھرا چھُکھ ژٕ یُس یمن سارنےٕ چیزن پٮ۪ٹھ حٲکم چُھ یِم اسہِ پٮ۪ٹھ وۅتلِتھ آیہِ۔ یمہِ واوٕ طوٗفان سان تہٕ چیریو تلہٕ ننیو۔ اوے تہِ چھِ أسؠ ژےٚ زارٕ پارٕ کران زِ اسہِ متہٕ مار تہٕ یمِس أکِس نفرٕ سٕنٛدِ باپتھ۔ تہٕ اسہِ متہٕ مار تہٕ کٲنٛسہِ تِتھِس نفرس مارنہٕ باپتھ یمؠ نہٕ اسہِ کانٛہہ آزار واتنوو۔
\v 15 پتہٕ تُل تِمو یونس تہٕ لویُکھ سۅدرس۔ ؤلؠ بیوٹھ سۅدُر تہِ لۅتہِ۔
\v 16 ییٚلہِ یہِ سپُد ناوِ ہٲنٛز پییہِ وسِتھ یہِ وُچِھتھ زِ یہُوواہؔ کوتاہ پُر جلال چُھ۔ تِمو کٔر یہُوواہسؔ قربٲنی پیش تہٕ دور وعدٕ کوٚرُکھ أمؠ سنٛز عبادت کرنچ۔
\v 17 أتھؠ دوران نینٛگلوو یہُوواہنؔ أکِس بجہِ گاڈِ اتھ یونس تہٕ یونس رود گاڈٕ ہنٛدِس شکمس منٛز ترٮ۪ن دوٚہُن تہٕ ترٮ۪ن رٲژن۔
\c 2
\p
\v 1 ییٚلہِ سُہ گاڈِ ہنٛدِس شکمس منٛز اوس یونسن کوٚر پننس خدا یہُوواہسؔ زارٕ پارٕ یسٕنٛز سُہ عبادت کران اوس۔
\v 2 تسُنٛد ونُن اوس یہِ زِ ییٚلہِ بہٕ سخ پریشان اوسُس، مےٚ موٚنگ یہُوواہسؔ امہِ نِشہ نجات تہٕ تٔمؠ بخشُم نجات۔ یوٚدوے زن بہٕ گاڈِ ہنٛدِس شکمس منٛز اوسُس تہٕ سونچان اوسُس وۅنؠ چُھم مرُن مگر اتہِ تہِ بوزتھم ژےٚ میون منگُن۔ ییہِ مےٚ زارٕ پارٕ کوٚرےٕ پننہِ مدتہٕ باپتھ۔
\v 3 ژےٚ اوستھس بہٕ سرٔنِس آبس لویہِ مُت۔ سۅدرس سیٚہ منٛزس۔ ییٚتہِ ملریٚو مےٚ نال ووٚل۔ یِمہٕ سارے یچھہِ ملرِ یمہِ ژےٚ مےٚ پیٚٹھؠ کھاجتھ۔
\v 4 مےٚ سونچ ژےٚ تروتھس بہٕ دوٗر ژےٚ چھَے نہٕ مےٚ کُن وُچھنس تہِ ونٛدٕ یِوان۔ توتہِ اوس مےٚ اکھ امید چون ہیکل بیٚیہِ وُچھنچ۔
\v 5 آب اوس مےٚ انٛدٕ ونٛدٕ میٲنؠ زندگی کھٮ۪نس تیار۔ سرنؠ آبن اوسُس کلہٕ ؤلِتھ تل روٚٹمُت۔
\v 6 بہٕ بُڈیوس برابر تۅتام یتہِ پٮ۪ٹھٕ کۅہ تہٕ بال سۅدرٕ ژَکہِ پٮ۪ٹھٕ کھسان چھِ۔ مےٚ باسیو زِ زمین چھےٚ اکھ بٲنٛدؠ وان ییٚتہِ مۅکلُن محال چُھ۔ مگر ژٕ میانہ خدایہ یہُوواہؔ یسٕنٛز عبادت بہٕ کران چُھس بخشُتھ مےٚ مۅکجار۔ مُدرٕ وانس واتنہٕ نِشہ۔
\v 7 ییٚلہِ بہٕ مرنس اوسُس ووتمُت۔ مےٚ آو بس چون خیال یہُوواہؔ۔ ژےٚ پننہِ مدتہٕ باپتھ وننہٕ باپتھ۔ تہٕ پننہِ مقدس مقام پٮ۪ٹھٕ ییٚتہِ ژٕ آسان چھُکھ بوزُتھ ژےٚ میون زارٕ پار۔
\v 8 تِم یِم زن اپزٮ۪ن پۅتلٮ۪ن پوٗزان چھِ، چھی ژےٚ نکار کران۔ تِم یِم تہنٛدؠ ہمیشہٕ وفادار چھِ
\v 9 مگر بہٕ کرنہٕ یہِ زانہٛہ۔ بلکہِ کرے بہٕ ژےٚ پنٕنؠ قربٲنی پیش۔ پننہِ تھدِ ہٹہِ چون ذکر کٔرِتھ بہٕ کرٕ تی یہِ مےٚ پۅختہٕ وعدٕ کوٚرمُت چُھ۔ یہُوواہؔ چھرا چھُکھ بس ژےٕ یُس لوٗکن بچاوان چُھ۔
\v 10 امہِ پتہٕ دیُت یہُوواہنؔ أمِس بجہِ گاڈِ حکم درۅکہٕ دٲرِتھ دِنُک۔ گاڈِ دیُت یونس ہۅچھِہِ زمینہِ پٮ۪ٹھ درۅکھ دِتھ دٲرِتھ۔
\c 3
\p
\v 1 پتہٕ کوٚر یہُوواہنؔ بیٚیہِ اکہِ لٹہِ یونسس سٟتؠ کلام۔ یہُوواہنؔ ووٚنُس یہ:
\v 2 "گژھِ نیرنہٕ باپتھ کھڑا۔ نینوہؔ شہر گژھِ یۅسہ اسیریا مُلکٕچ رازدٲنؠ چھےٚ تہٕ واتناو تتہِ کٮ۪ن لوٗکن یہِ شیٚچھ یوس یہِ ژےٚ ؤنی تِمن واتناونہٕ باپتھ"
\v 3 یمہِ پھرِ دراو یونس نینوہؔ نوؔہ شہرکُن یہِ زن تمِس یہُوواہنؔ ووٚن۔ نینوہؔ اوس اکھ سٮ۪ٹھہےٕ بوٚڈ شہر دُنیہکیٚو شہرو منٛزٕ ساروٕے بوٚڈ شہر۔ یہِ اوس تیوت بوڈ زِ أکِس انسانس لگہ ہن ترےٚ دوٚہہ امہِ منٛزؠ پکنس۔
\v 4 ییٚلہِ یونس اور ووت سُہ پوٚک پوٗرٕ اکھ دوٚہہ شہرٕ منٛزؠ۔ پتہٕ کوٚر تٔمؠ شہرٕکٮ۪ن لوٗکن اعلان، "أزکہِ پٮ۪ٹھٕ ژتجی دوٚہؠ کرِ خدا نینوہؔ شہرس تباہ۔
\v 5 نینوہؔ کیٚو لوٗکو کٔر خدایہِ سنٛزِ تَتھ شیٚچھہِ پٮ۪ٹھ پژھ یۅسہ تٔمؠ یونسس بوزنٲو۔ تِمو کوٚر فٲصلہٕ زِ پرٮ۪تھ کانٛہہ تھاوِ فاقہٕ تہٕ لاگن کھُرؠ دُرؠ پلو پننس جسمس پٮ۪ٹھ یہِ ہاونہٕ باپتھ زِ تِمن چُھ یچھ کامہِ کرنس پٮ۪ٹھ افسوس۔ اوے تہِ کوٚر شہرکیٚو ساروےٕ لوٗکو تِم اہم ٲسیا کنہٕ عام یی۔
\v 6 ییٚلہِ نینوہؔ شہرٕکؠ بادشاہن امہِ شٮیٚچھِ ہُنٛد بوز یمچ تبلیغ یونسؔ کران اوس سُہ ووٚتھ پننہِ تختہٕ پٮ۪ٹھٕ تھوٚد۔ تٔمؠ کٔڈؠ پنٕنؠ شٲہی پلو نالہٕ تہٕ لٲگِن کھُرؠ دار پلو تہٕ بیٚوٹھ تٔرنِس بٔٹھِس پٮ۪ٹھ۔ تٔمؠ کۅر یہِ سورےٕ یہِ ہاونہٕ باپتھ زِ سُتہ چُھ شرمنٛدٕ پننٮ۪ن یچھ کامیٚن پٮ۪ٹھ۔
\v 7 پتہٕ سوزؠ تٔمؠ شیٚچھ ہٮ۪تھ نینوہؔ کٮ۪ن لوٗکن منٛز یہِ تُرے دِنہِ، "بادشاہ تہٕ تسٕنٛدؠ مشیر چھِ یہِ اعلان کران زِ کانٛہہ تہِ شخص یا جانور کھیٚیہِ نہٕ کُنہِ قسُک غذا تہٕ بیٚیہِ چیٚینہٕ کانٛہہ تریش یا شربت۔ کانٛہہ گاو یا تیوٗر تہِ کھیٚیہِ نہٕ۔
\v 8 پرٮ۪تھ کانٛہہ شخص تہٕ جانور روزِ کھُر دُر پلو لٲگِتھ۔ پٮرٮ۪تھ کانٛہہ شخص کرِ خدایس منٛگہٕ منٛگ۔ بیٚیہِ ہیٚیہِ پرٮ۪تھ کانٛہہ تِمو یچھ کامیٚو نِشہ پتھ تہٕ تِمو ظٲلمانہٕ حرکژو نِشہ روزن پتھ یِم تِم باقےٕ لوٗکن سٟتؠ کران رودؠ۔
\v 9 یوٚدوے سٲرے یہےَ عمل کرن اِمکان چُھ خدا ما بدلاوِ پنُن فٲصلہٕ تہٕ روزِ اسہِ پٮ۪ٹھ مہربان۔ سُہ ما ہیٚیہِ پتھ اسہِ پٮ۪ٹھ ناراضگی نِش۔ تہٕ یتھٕ پٲٹھؠ بچو أسؠ مارٕ گژھنہٕ نِش۔
\v 10 توے تہِ کٔر لوٗکو یِمن کتھن پٮ۪ٹھ عمل تہٕ تراوٮ۪کھ تِمہٕ یچھ کامہِ کرنہِ یِم لوٗکھ کران ٲسؠ۔ خداین وُچھ یہِ سورےٕ۔ توے تہِ کوٚرُن تِمن پٮ۪ٹھ رحم تہٕ کوٚرنکھ نہٕ ژکہِ پھیُر تہِ، یہِ زن تٔمؠ کرنُک ووٚنمُت اوس۔ یوٚدوے زن یہِ کرُن ووٚنمُت اوس مگر یہِ کوٚرُن نہٕ۔
\c 4
\p
\v 1 یونس نہِ کِنؠ اوس یہِ انتہٲیی غلط زِ خداین کوٚر نہٕ نینوہؔ شہرس تلُک پٮ۪ٹھ۔ اتھ پٮ۪ٹھ کھوٚت تمِس سخ شرارت۔
\v 2 تٔمؠ مونٛگ یہُوواہسؔ، "ہے یہُوواہؔ یہِ گو سراسر تی یہِ مےٚ گرِ تراونہٕ برونٛہہ ونیاو زِ یی سپدِ۔ مےٚ چھےٚ خبر زِ ژٕ چھُکھ سُہ خدا یُس پرٮ۪تھ کٲنٛسہِ پٮ۪ٹھ رحیم تہٕ مہربان چُھ۔ ژٕ چھُکھ نہٕ ؤلؠ ؤلؠ تِمن لوٗک پٮ۪ٹھ ناراض گژھان یِم وُچاپہٕ کامہِ کران چھِ۔ ژٕ چھُکھ لوٗکن سٮ۪ٹھا لول بران تہٕ چھُکھ پسنٛد کران لوٗکن پٮ۪ٹھ رحم کرُن بجایہ کانٛہہ سزا دیُن۔ میانہِ گرِ ترسیس شہرس کُن ژلنُک وجہہ اوس یہِ زِ بہٕ اوسُس نہٕ یہِ سپدُن یژھان تکیازِ بہٕ اوسُس یژھان زِ ژٕ دِکھ نینوہؔ کٮ۪ن لوٗکن سزا۔
\v 3 تہٕ وۅنؠ مہربٲنی کٔرِتھ مار تہٕ مےٚ۔ بہٕ چُھس زنٛدٕ روزنہٕ بدلہٕ مرُن یژھان۔ یوٚدوے ژٕ نینوہؔ کٮ۪ن لوٗکن سزا دِکھ نہٕ"
\v 4 یہُوواہنؔ ووٚنُس، "یہِ چھا چانہِ باپتھ جان زِ ژےٚ کھٔسی شرارت اتھ پٮ۪ٹھ کہِ مےٚ کوٚر نہٕ نینوہؔ بُرباد؟"
\v 5 یونسن دیُتُس نہٕ کانٛہہ جواب بلکہِ دراو شہرٕ منٛزٕ تہٕ بیوٹھ دوٗر پہن شہرکِس مشرقس کُن۔ اتہِ بنوو أمؠ تاپہٕ نِشہ بچنہٕ باپتھ اکھ چھج۔ سُہ بیوٹھ چھجَس تل انتظارس زِ وُچھِو شہرس کیا بنہِ۔
\v 6 یہُوواہؔ خداین کھول اکھ کُل ؤلؠ ؤلؠ یونسُن کلہٕ تاپہٕ ژنٛجہِ منٛزٕ شیہلِس رٹنہٕ باپتھ۔ یہُوواہنؔ کوٚر یہ تاکہِ یونس بدلاوِ پنُن وطیرٕ۔ یونس سپُد تاپہٕ ژنٛجہِ منٛزٕ امہِ شیہلؠ کُلہِ سٟتؠ سٮ۪ٹھا خوش۔
\v 7 امہِ پتہٕ دوٚیمہِ دوٚہہ کوٚر خداین اتھ کُلِس کوٗرنہٕ باپتھ اکھ کیٚوم تیار تاکہِ یہِ کُل ییہِ ہوٚکھِتھ۔
\v 8 آفتاب کھسنہٕ پتہٕ کمےٕ کٲلؠ تُل مشرقہٕ انٛدٕ خداین سخ واو۔ آفتاب سپُد سخ تیز یونس سٕنٛدِس کلس پٮ۪ٹھ تہٕ یونس ہیٚوتُن وٮ۪سرِتھ پیوٚن۔ سُہ اوس مرُن یژھان تہٕ تٔمؠ ووٚن یہِ روِ بہتر میانہِ باپتھ زنٛدٕ روزنہٕ نِشہ۔
\v 9 خداین ووٚن یونسس، "یہِ چھا چانہِ باپتھ رُت زِ سپدکھ ناراض زِ یتھ کُلس کیا گو:" یونسن ووٚنُس، "آ۔ یہِ چُھ میانہِ باپتھ رُت زِ بہٕ روزٕ ناراض۔ بہٕ چُھس یوٗتاہ ناراض زِ بہٕ گژھٕ وۅنؠ مرُن:"
\v 10 ادٕ ووٚن یہُوواہنؔ یونسس، "ژٕ سپدکھ پانہٕ دۅکھٕ زد زِ یہِ کُل کیازِ ہوٚکھ یوٚدوے زن ژٕ اتھ رٲچھ کرکھ کانٛہہ عمل کٔرِتھ نہٕ نہ کرتھ امکہِ پھبنہٕ باپتھ۔ یہِ کھوٚت أکِس رٲژ منٛزے تہٕ دوٚیمہِ رٲژم ہنٛدِس انٛدس سپدیاو۔
\v 11 یتھے پٲٹھؠ، مگر امہِ کھۅتہٕ ژۅرے پہن، چُھ میانہِ باپتھ صحیح نینوہؔ شہر برباد کرُنس متعلق دۅکھ محسوس کرُن۔ اتہِ چھِ اکھ لچھ وُہ ساس کھۅتہٕ ژٔرؠ لوٗکھ یِمن نہٕ صحی غلطُک تمیز چُھ۔ اتہِ چھِ بیٚیہِ واریاہ جانور۔ یِم مےٚ تخلیق کٔرؠ، تہٕ یہِ چُھ میانہِ باپتھ یِمن ہُنٛد وسہِ آسُن تہِ رُت۔
