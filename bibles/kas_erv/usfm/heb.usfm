\id HEB - DMT Kashmiri
\toc1 عبر
\mt1 عبر
\c 1
\p
\v 1 پتھ کالہِ کوٚر خداین اسرائیلکیٚن جدن سٟتؠ کلامہٕ تِمو لوٗکو ذریعہ یِمو تمؠ سنٛدِ پٲغامُک اعلان کوٚر۔ تمؠ کوٚر یہِ تتھ سارسے وقتس دوران یتھ منٛز تِمو جدو زندگی گُزٲر، تہٕ تمؠ کٔرؠ تہِ کرنہٕ خٲطرٕ واریاہ بیون بیون طریقہٕ استعمال۔
\v 2 اما پوٚز، ییٚلہِ یہِ ٲخری وقت شروع سُپد، خداین کوٚر پننِس گوٚبرؠ سنٛدؠ ذریعہٕ اسہِ سٟتؠ کلام۔ خداین بنوو تمؠ سنٛدِ سٟتؠ دنیاہ یکوٹہٕ، تہٕ خداین کوٚر تمؠ سُنٛد انتخاب ہر کانٛہہ چیز پراونہٕ باپتھ\f + \fr 1‏:2 \ft یوحناؔ 1:3، 1 کورنتھین 8:6۔ \f*۔
\v 3 تس، خداے سٕندس گوٚبرس یسوعسؔ، منٛز چھِ أسؠ وُچھان زِ خداے کوتاہ جلال وول چُھ۔ حقیقتس منٛز چُھ خداے سُنٛد گوبر اصل پٲٹھؠ ہاوان خداے کیتھ ہیو چُھ۔ قدرتہٕ سان کلام کرنہٕ سٟتؠ چُھ سُہ پریتھ کانٛہہ چیز قٲیم تھاوان یُس خداین بنوومُت چُھ۔ پنہٕ نین لوٗکن کرؠ مٕتیٚو غلط چیزو نِش پاک کرنہٕ پتہٕ، کھوٚت سُہ آسمانس پیٚٹھ تہٕ کرنؠ پننِس بب خدایس سٟتؠ بادشٲہی شروع\f + \fr 1‏:3 \ft بایبل مطٲبق چُھ یہِ دوٚچھن طرف یُس احترامُک مقام چُھ۔ \f*۔
\v 4 تمس متعلق یِمن چیز ہُند مانے چُھ زِ سُہ خداے سُنٛد گوبر یسوع، چُھ روحٲنی وجوٗد کھوٚتہٕ واریاہ بوٚڈ۔ امی اندازٕ، خداے یمہِ ناوٕ سٟتؠ تس وونؠ بُلاوان چُھ سُہ چُھ تِہندیو ناوو کھوٚتہٕ افضل۔
\v 5 توٚہؠ ہیکیو ونتھ زِ خداے سُنٛد گوبر چُھ روحٲنی وجود کھوٚتہٕ افضل تکیازِ خداین وونؠ نہٕ یِم کتھٕ کُنہِ تہِ وزِ کٲنٛسہِ تہِ روحٲنی وجوٗدس: " أزؠ کیٚن دوٚہس پیٚٹھ چُھ مےٚ پریتھ کٲنٛسہِ نِش واضیح کوٚرمُت زِ بہٕ چُھس چوٗن بب، تہٕ ژٕ چُھکھ میون گوبر!" تمؠ ونہِ نہٕ یمہٕ کتھٕ کٲنسہِ تہِ روحٲنی وجوٗدس متعلق:" بہٕ آسہٕ تسند بب، تہٕ سُہ آسہِ میون گوبر" بہرحال، تمؠ ونہِ یمہٕ کتھٕ پننِسے گوٚبرس متعلق\f + \fr 1‏:5 \ft 2 سمیویل 7:14، 1 اخبار 17:13، مزامیر 2:7\f*۔
\v 6 تمہِ علاوٕ، ییٚلہِ خداین گوٚڈنُک زامُت پنُن گوبر آسمٲنی دنیاہس منٛز تُل، تمؠ دِیُت حکم: تمام روحٲنی وجوٗدن یِم خدایس خدمت کران چھِ زِ تِمن پزِ تمس احترام تہٕ تعریف کرنؠ\f + \fr 1‏:6 \ft تثنِیہ شرع 32:43، 1 پطرس 3:22\f*"
\v 7 خداے چُھ روحٲنی وجوٗدن متعلق یہِ ونان: "مےٚ چھِ روحٲنی وجوٗد یِم مےٚ خدمت کران چھِ واوٕکؠ تہٕ دزونہِ نارٕکؠ ہیوؠ بنٲومٕتؠ\f + \fr 1‏:7 \ft مزامیر 104:4\f*"
\v 8 دوٚیمہِ طرفہٕ چُھ خداے پننِس گوٚبرس متعلق یہِ ونان:" ژٕ یُس خداے چُھکھ کرکھ پوشہِ ونؠ حکومت پننیٚن لوٗکن پیٚٹھ تہٕ ژٕ کرکھ پننہِ بادشٲہی پیٚٹھ عدلہٕ تہٕ راستبٲزی سان حکومت۔
\v 9 ژےٚ بوٚرُتھ پزرس لول تہٕ خداے سنٛدؠ قانون پھُڑراون والین کرٕتھ ژےٚ نفرت۔ توے، بنووکھ ژٕ مےٚ، چٲنؠ خداین، تمس بیٚیہِ کٲنٛسہِ کھوٚتہٕ زیادٕ طاقتہٕ وول تہٕ خوشحال یُس ژےٚ سٟتؠ چُھ\f + \fr 1‏:9 \ft مزامیر 45۔ 6 7\f*"
\v 10 تہٕ خداے چُھ ییتہِ پننِس گوٚبرس متعلق ونان: ژٕ چُھکھ خداوند، یمؠ قدرت سان پریتھ کانٛہہ چیز پٲدٕ کوٚر یُس موجود چُھ آسمانس پٮ۪ٹھ ییٚلہِ یہِ سورے شروع سُپد\f + \fr 1‏:10 \ft مزامیر 102:25، پیدٲیش 1:1\f*"
\v 11 یِم سٲری چیز گژھن ٲخر کار ختم، مگر ژٕ روزکھ ابدن زندٕ۔ تِم چھِ پلون ہنٛدؠ پٲٹھؠ پرٲنؠ سپدان تہٕ ژھنان،
\v 12 تہٕ ژٕ نِہکھ تِم ؤٹِتھ زن تہِ تِم پرٲنؠ پلو تہِ ٲسؠ۔ یتھٕ پٲٹھؠ زن اکھ نفر پلو چُھ بدلاوان، ژٕ بدلاوکھ تِم چیز یِم ژٕ پٲدٕ کرِتھ۔ اتھ برعکس، چُھکھ ژٕ سُہ اکھ یُس ہیوے روزِ تہٕ ہمیشہِ روزِ زندٕ!"
\v 13 خداین ونہِ نہٕ یژھہٕ کتھٕ کنہِ ساعتہٕ کٲنسہِ تہِ روحٲنی وجوٗدس:" مےٚ سٟتؠ کر بادشٲہی یتھ دوران بہٕ چانؠن سارنے دشمنن شکس دِمہٕ!" اما پوٚز، تمؠ ونہِ یِم کتھٕ پننِس گوٚبرس۔ \f + \fr 1‏:13 \ft مزامیر 103:20 21\f*
\v 14 روحٲنی وجوٗد چھِ قدرت وٲلؠ وجود آسان یِم خدایس خدمت کرن چھِ، تہٕ خداین چھِ تِم تِمن مدد کرنہٕ خٲطرٕ سوزؠ متٕؠ یِمن سُہ جلدے نجات دیہِ۔
\c 2
\p
\v 1 تکیازِ خداین ونہِ یِمہٕ کتھٕ پننِس گوٚبرس، اسہِ چُھ ساروی کھوٚتہٕ زیادٕ تِمن رٕژن شیچھن پیٚٹھ توجہ مرکوز کرنچ ضرورت یِمہٕ اسہِ ہیٚچھِ۔ یتھٕ پٲٹھؠ چھِ نہٕ أسؠ اتھ پیٚٹھ یقین کرنس روٚٹ کران۔
\v 2 یہِ چُھ ضروری تکیازِ، ییٚلہِ روحٲنی وجودو اسرائیلکیٚن لوٗکن شریعت دِیُت، تِمو یہِ وون سُہ اوس اعتبار کرنس لایق۔ تمہِ علاوٕ، خداین دِیُت تس أکس اصل پٲٹھؠ سزا یِم نہٕ اتھ شریعتس کن تھو یا پھُڑراون یہِ۔
\v 3 چونکہ یہِ چُھ پوٚز، خداے دیہِ اسہِ منٛز کٲنسہِ تہِ یقیٖنن سزا یُس اتھ پٲغامس نظر انداز کرِ زِ خداین کتھٕ پٲٹھؠ چُھ اسہِ نجات دِنہٕ خٲطرٕ قدرت سان کٲم کٔرمٕژ۔ یہِ اوس خداوند یسوع یمؠ گوٚڈٕ یہِ پٲغام وون، تہٕ یِمو بوٗز تمس نِش تہٕ تِمو وون اسہِ اعتبار سان سوے پٲغام۔
\v 4 خداین چُھ اسہِ یہِ تہِ تصدیق کوٚرمُت زِ یہِ پٲغام چُھ ایمان والین قدرت سان تہٕ جلال واجِنؠ کٲم کرنہٕ خٲطرٕ بااختیار بنٲوتھ درست کران۔ تمہِ علاوٕ، تمؠ دِیُت ایمان والین پاک روح، تس پریتھ أکس یُس خداین ژوٚر۔
\v 5 وونؠ چھِنہٕ خداین روحٲنی وجود آسمٲنی جہانٕکؠ مٲلکھ تھٲومٕتؠ زِ سُہ اننہِ زمیٖنس پیٚٹھ۔ یہِ چُھ سُہ دنیاہ یتھ متعلق بہٕ چھس کتھ کران۔
\v 6 کمؠ تام کوٚر تصدیق یہِ مےٚ وونمُت چُھ ییٚلہِ تمؠ نوشتن منٛز لیوکھ، "کانٛہہ تہِ انسان چُھ نہٕ تیوتاہ قٲبل یُس چانہِ باپتھ تمن متعلق سونچہِ، خداے! کانٛہہ تہِ انسان چُھنہٕ یوٗتاہ اہم یُس چانہِ باپتھ تُہنٛد خیال تھاوِ!
\v 7 تمہِ پتہٕ تہِ، ژےٚ بنٲوؠ تھکھ آسمانٕکؠ فرشتہٕ سانہ نِشہ رژھ کھنٛڈ زیادٕ اہم، تہٕ ژےٚ کوٚرتھ تِمن واریاہ عزت تہٕ طاقت عطا۔
\v 8 ژےٚ بنٲوِتھ تِم ہر کنہِ چیزکؠ مٲلکھ یِم ژےٚ پٲدٕ کرِتھ" ییٚلہِ تمؠ لیوکھ، "یِم بنٲوؠ ہوکھ پریتھ کنہِ چیزکؠ مٲلکھ، "امیٛک مطلب گوو زِ سُہ چُھنہٕ کانٛہہ تہِ چیز یمیُک نہِ تِم مٲلکھ چھِ۔ وونؠ گوو، یتھ وقتس چُھنہٕ اسہِ باسان زِ انسان چِھ پریتھ کنہِ چیزکؠ مٲلکھ\f + \fr 2‏:8 \ft مزامیر 8:4۔ 6، 1 کورنتھین 15:27\f*۔
\v 9 اما پوٚز، أسؠ چھِ یسوعؔ سُنٛد مشٲہدٕ ضرور کران۔ سُہ چُھ سُہ اکھ یُس کم وقتہٕ خٲطرٕ روحٲنی وجودو کھوٚتہٕ کم طاقتہٕ وول اوس، تہٕ خداین دِیُت تس وونؠ واریاہ عزت تہٕ بخشنس طاقت۔ خداین کوٚر یہِ تکیازِ یسوعؔ ہن چیو موتُک پیالہٕ۔ یتھٕ پٲٹھؠ دِیُت خداین فضلہٕ سان تس سارنے لوٗکن ہندِ خٲطرٕ مرنہٕ یِم تس پیٚٹھ یقین چھِ تھاوان۔
\v 10 امہِ طریقہٕ کٲم کرنؠ ٲسؠ خداے سنٛدِ خٲطرٕ منٲسب، یمؠ پریتھ کانٛہہ چیز پٲدٕ کوٚر تہٕ تِمن سارنے چُھ حکم دِوان یہِ موجود چُھ۔ ییٚلہِ یسوعن پریتھ کٲنٛسہِ جلال بخشن شروع کوٚر یِس تس پیٚٹھ ایمان چُھ، یِم تمؠ سُنٛد پننؠن بیٚنؠن تہٕ باین ہندؠ پٲٹھؠ چھِ، خداین کتھٕ کٔنؠ تُلنوو یسوع تکلیف تِمن نجات دِنہٕ باپتھ۔
\v 11 یسوع، یُس پنہٕ نؠن لوٗکن خداے سنٛدِ خٲطرٕ الگ چُھ کران، تہٕ تِمنے ہیوؠ لوٗکھ یِمن سُہ خداے سنٛدِ خٲطرٕ بیون چُھ کران، سارے چھِ پانہٕ خدایس نِشہٕ یوان۔ لہٰذا یسوع چُھنہٕ تِمن پننٕؠ بیٚنہِ تہٕ باے وننس منٛز ہچکچاہٹ یوان۔
\v 12 یسوع چُھ تِمن پننٕؠ بیٚنہِ تہٕ باے ونان ییٚلہِ سُہ ونان چُھ، "بہٕ کرٕ خداے سنٛدؠ پٲٹھؠ پنہٕ نؠن باین نِش اعلان؛ بہٕ کرٕ چٲنؠ تعریف ییٚلہِ لوٗکھ ژٕ عبادت کرنہٕ باپتھ جمع گژھن"
\v 13 یسوع چُھ برونٛہہ کُن ونان: " بہٕ کرٕ تس پیٚٹھ بھروسہٕ" تہٕ یسوع چُھ برونٛہہ کن ونان، "مےٚ کُن تہٕ خداے سٕندٮ۪ن شُریٚن کُن وُچھ یہنٛز مےٚ تمؠ ذمہٕ دٲری تھوؠ"
\v 14 تکیازِ خداے سنٛدؠ شُرؠ چھِ انسان، یسوع تہِ بنیاو تمنے ہیو اکھ انسان۔ تمؠ کوٚر یہِ اوٕ کِنؠ زِ مرنہٕ سٟتؠ دِتُن شیطانس شکس، یُس یہِ حقیقت چُھ استعمال کران زِ لوٗکھ چھِ تِمن حدس منٛز رٹنہٕ خٲطرٕ مران۔
\v 15 ییٚلہِ تمؠ تہِ کوٚر، سُہ سُپد امہِ طریقہٕ نِش آزاد زِ مرُن چھِ اسہِ زندٕ روزنس دوران کھوٚژناوان۔
\v 16 یسوع بنیاو اکھ انسٲنی وجوٗد، تکیازِ سُہ آو تِمن مدد کرنہِ یِم اسرائیلکیٚن ہندس جدس ابرہامسؔ سٟتؠ تعلق چھِ تھوان، روحٲنی وجودن ہندِ مدد کرنہِ نہٕ، یتھٕ پٲٹھؠ توٚہؠ مولوم چُھ۔
\v 17 توے آو سُہ، یسوعس اوس أسی ہیو آسُن لٲزمی، یِم تمؠ سنٛدؠ بیٚنہِ تہٕ بٲے چھِ۔ یتھ پٲٹھؠ ہیکہِ سُہ حکمران کاہن بنتھ یُس رحم دل تہِ بھروسہٕ منٛد اندازس منٛز خداے سٕنٛز خدمت چُھ کران تاکہ خداے چُھ معٲفی دِوان تتھ یہِ تمؠ سنٛدیو لوٗکو غلط کوٚر۔
\v 18 یسوع ہیکہِ تمہِ قسمک کاہن ٲسِتھ تکیازِ تمؠ کٔرؠ درد ناک تکلیف برداش تہٕ تجربہٕ کوٚرُن زِ کتھٕ کِنؠ چُھ غلط کرُن اصل باسان۔ لہٰذا سُہ ہیکہِ پریتھ کٲنسہِ مدد کرِتھ یِس تہِ تجربہٕ سپدِ زِ کتھٕ کِنؠ چُھ غلط کران اصل باسان۔
\c 3
\p
\v 1 میانیو ایمان باجو، خداین چھُو توٚہؠ پننہِ خٲطرٕ بیون کرؠ مٕتؠ، تہٕ تمؠ چھِ أسؠ آسمانہٕ پیٚٹھٕ یکوٹہٕ بُلٲمٕتؠ۔ ییٚلہِ زن مےٚ توٚہہِ ونمُت چُھ زِ یسوعن کیا چُھ کوٚرمُت، توٚہہِ پزِ تس متعلق سونٛچن۔ خداین سوز رسول اسہِ، تہٕ سُہ چُھ سردار کاہن یمِس پیٚٹھ أسؠ ونو زِ اسہِ چُھ ایمان۔
\v 2 تمؠ کٔر خدایس وفادٲری سان خدمت، یمؠ سُہ اکھ سردار کاہن بنوو۔ سُہ چُھ موسیٰ ہس ہیو، یمؠ خدایس خداے سٕندٮ۪ن لوٗکن ہُند حصہٕ رنگؠ وفادٲری سان خداے سٕنٛز خدمت کٔر۔
\v 3‏-4 چونکہ پریتھ عمارژ چُھ اکھ تعمیٖر کرن وول بناون، تہٕ لوٗکھ چھِ اصل پٲٹھؠ عمارژ تعریف کرنہٕ کھوٚتہٕ زیادٕ تعمیٖر کرن وٲلِس تعریف کران۔ یتھے پٲٹھؠ، خدا چُھ تعمیٖر کرن وول یمؠ پریتھ کانٛہہ چیز بنوو۔ توے پزن لوٗکن یسوعس تعریف کرنؠ یُس خداے چُھ، موسیٰؔ ہس تعریف کرنہٕ کھوٚتہٕ زیادٕ، یُس خداین بنوو۔
\v 5 موسیٰؔ ہن کٔر وفادٲری سان تمس شخصس سنٛدؠ پٲٹھؠ خداے سٕنٛز خدمت یمؠ خداے سٕندٮ۪ن سارنے لوٗکن مدد کرِ۔ تمہِ طریقہٕ کوٚر تمؠ برونٛہےٕ اعلان یہِ وونؠ خداے یسوعس متعلق ونان چُھ\f + \fr 3‏:5 \ft گنتی 12:7\f*۔
\v 6 پوٚز مسیحؔ چُھ خداے سُنٛد گوبر، یُس وفادٲری سان خداے سٕندٮ۪ن لوٗکن پیٚٹھ بادشٲہی چُھ کران۔ یوتتھ تام زِ أسؠ دلیری تہٕ فخرٕ سٟتؠ یہِ توقع کران زِ خداے کیا دِیہِ اسہِ، أسؠ چھِ تمن لوٗکن سٟتؠ تعلق تھاوان۔
\v 7 مُلہٕ چھِ أسؠ خداے سنٛدؠ لوٗکھ، اسہِ پزِ کرُن یہِ پاک روح ونان چُھ:" ازکہِ دوٚہہ، ییٚلہِ توٚہؠ بوزِو بب خداے توٚہہِ سٟتؠ کتھ کران،
\v 8 ضدِ سان مہُ کریو تمؠ سٕنٛز نافرمٲنی۔ ییہِ کوٚر تُہندیو جدو ییٚلہِ تِمو خدایس خلاف صحراون منٛز زندگی گُزارنس بغاوت کٔر تہٕ تس کھولوٗکھ شرارت\f + \fr 3‏:8 \ft خروج 17:7، گنتی 20:2۔ 5، 13\f*۔
\v 9 تِمن جاین روزنس دوران اوٚن تُہندیو جدو خداے اشتعالس منٛز یہ وُچھنہٕ خٲطرٕ زِ سُہ کیا کرِ۔ تِمو کوٚر مےٚ امتحان تہٕ ازمووہس تتہِ۔ تِمو کوٚر تہِ ہرگاہ تِمو تِم سٲری حیران کران وٲلؠ چیز وُچھ یِم تمؠ تِمن ہندِ خٲطرٕ کٔرؠ
\v 10 أکس ژتجہن ورؠ ین ہندس دورس دوران۔ لہٰذا سُہ سُپد تِمن لوٗکن دِلہ ناراض، تہٕ تمؠ وون تِمن متعلق، "تِم چھِ یژھان تہِ کرُن یہِ پریتھ وقتس غلط چُھ۔ تِم چھِ نہٕ سمجھ یوان زِ بہٕ کتھٕ پٲٹھؠ چھُس یژھان تِم کرن برتاو"
\v 11 اوے سُپد سُہ تِمن ناراض، تمؠ کوٚر قسم دِتھ اعلان، "تِم کرن نہٕ زانٛہہ تہِ شرکت زِ بہٕ کتھٕ کِنؠ چُھس آرام کران!"
\v 12 ایمان باجو، توجہ دِیو! یقینی بنٲیو زِ توٚہہِ منٛز سونچہِ نہٕ کانٛہہ تہِ بُرٕ تہٕ بے دین طریقو سٟتؠ یمہِ سٟتؠ توٚہہِ تمس کُنِس حقیقی خدایس بے وفا سپدیو۔
\v 13 بلکہ پزِ توٚہہِ پریتھ دوٚہہ اکھ أکس خدایس وفادار روزنس پیٚٹھ حوصلہٕ افزٲئی کرنؠ، پریتھ دوٚہس دوران یتھ أسؠ" یہِ دوٚہہ" ونان چھِ۔ یتھٕ پٲٹھؠ کرِ نہٕ توٚہہِ منٛز کانٛہہ اکھ گناہ تہٕ پانس دِیہِ دوکھٕ، یُس توٚہہِ خداے سٕنٛز فرمانبردٲری کرنس منٛز ناقٲبل بنایہِ۔
\v 14 توٚہہِ پزِ اکھ أکس حوصلہٕ افزٲئی کرنؠ، تکیازِ أسؠ چھِ مسیحسؔ سٟتؠ کُنہِ چیزچ شراکت۔ تہِ چُھ پوٚز یوٚتام أسؠ تس پیٚٹھ ابتدا پیٚٹھٕ مرنکِس دمس تام یقین جٲری تھاوو۔
\v 15 توٚہہِ پزِ اکھ أکس حوصلہٕ افزٲئی کرنؠ ییٚلہِ زن پاک روح چُھ ونان، "ازکہِ دوٚہہ ییٚلہِ توٚہؠ بوٗزو خداے چُھ توٚہہِ سٟتؠ کلام کران، تس مہٕ کریو ضدِ سان نافرمٲنی۔ تیی کوٚر تُہندیو جدو ییٚلہِ تِمو خدایس خلاف بغاوت کٔر"
\v 16 وونؠ چُھ توٚہہِ مولوم زِ تِم سٲری ٲسؠ خداے سنٛدؠ لوٗکھ، یِم موسیٰؔ ہن ملکہ مِصرٕ منٛزٕ کڈتھ أنؠ، یِمو خداے سُنٛد ونن بوٗز تہٕ تیلہِ تہِ کرٕکھ تمس خلاف بغاوت۔
\v 17 توٚہہِ چُھ مولوم زِ تِم ٲسؠ خداے سنٛدؠ لوٗکھ یِمو غلط کوٚر، یِمن خداے أکس ژتجہن ورؠ ین ہندس وقتس تام ناراض روٗد۔ تِم مودؠ وجارن اندر\f + \fr 3‏:17 \ft گنتی 14:29\f*۔
\v 18 توٚہہِ چُھ مولوم زِ تِم ٲسؠ خداے سنٛدؠ لوٗکھ، یِمو نہٕ تمؠ سٕنٛز فرمانبردٲری کٔر، تُہنٛدِ باپتھ کھیٚو تمؠ قسم زِ تِم سپدن نہٕ زانٛہہ تمؠ سٕندس سکونس منٛز شریک\f + \fr 3‏:18 \ft مزامیر 106:24۔ 26 \f*۔
\v 19 لہٰذا، أسؠ ہیکو ونتھ زِ تِمو ہیوٚک نہٕ تمؠ سٕندس آرامس منٛز دٲخل سپدیتھ تکیازِ تِمو کوٚر نہٕ تس پیٚٹھ یقین۔
\c 4
\p
\v 1 لہٰذا أسؠ ہیکو تہِ ونتھ خداے چُھ ونہِ تہِ وعدٕ کران زِ تمؠ سنٛدؠ لوٗکھ سُپدن تمؠ سٕندس آرامس منٛز شریک۔ تمی سببہٕ، چھِ اسہِ یہِ کتھ یقینی بناونچ ضرورت زِ توٚہہِ منٛز کرِ پریتھ کانٛہہ تہِ کینٛژھا حٲصل یمیٛک خداین چُھ وعدٕ دِیُتمُت۔
\v 2 اسہِ چھِ یہِ یقینی بناونچ ضرورت، تکیازِ اسہِ بوٗز سۅ رٕژ شیچھ یتھٕ پٲٹھؠ تِمو بوٗز۔ اما پوٚز، تِم ٲسؠ نہٕ تِمو لوٗکو منٛزٕ یِمو تتھ پیٚٹھ ایمان اوٚن یہِ تِمو بوٗز، یہِ تِمو بوٚز تمؠ کوٚر نہٕ تِمن مدد۔
\v 3 تمیٛک وجہ چُھ صرف یہِ زِ اسہِ چُھ رٕژِ شیچھِ پیٚٹھ ایمان تہٕ خداے سٕندس آرامس منٛز چھِ دٲخل، مگر تِم یِمن نہٕ ایمان چُھ تِم چھِنہٕ اتھ منٛز شٲمل۔ یتھٕ پٲٹھؠ پاک روح ونان چُھ، "تمہِ پتہٕ، تکیازِ سُہ اوس تِمن ناراض، تمؠ کوٚر قسم کھیٚتھ اعلان، "تِم سپدن نہٕ زانٛہہ تہِ میٲنس آرامس منٛز دٲخل" خداین وون یہِ ہرگاہ تمؠ دنیاہ پٲدٕ کرِتھ کٲم رکٲوؠ تہٕ آرامس بیٚوٹھ۔
\v 4 توٚہہِ چُھ مولوم خداین کوٚر آرام تکیازِ یہِ چُھ پاک روح کُنہِ جایہِ ہفتہٕ کس ستمِس دوٚہس متعلق ونان۔ سُہ چُھ ونان، "پتہٕ اوس ہفتُک سٔتِم دوٚہہ، خداین موکلوو پریتھ کانٛہہ چیز پٲدٕ کرِتھ تہٕ تمؠ کوٚر آرام"
\v 5 مگر دبارٕ تھٲیو یاد زِ خداے کیا چُھ اسرائیلکیٚن جدن متعلق ونان تِمن لفظن منٛز یمہٕ مےٚ برونہٛےٕ ونؠ مٕژ چھے:" تِم سپدن نہٕ زانٛہہ تہِ میٲنس سکونس منٛز شریک!"
\v 6 اسرائیلین ہندیو جدو یِمن پتھ کالہِ رٕژ شیچھ بوٗز تمہِ پتہٕ تہِ کرکھ نہٕ خداے سٕنٛز فرمانبردٲری، تہٕ تِم سُپدؠ نہٕ خداے سٕندس سکونس منٛز شریک۔ اماپوٚز، خداے چُھ ونہِ کینٛژھن لوٗکن تمؠ سٕندس سکونس منٛز شریک سُپدن یژھان۔
\v 7 تمی سببہٕ، پاک روحن چُھ بییٚہِ اکہِ لٹہِ وقت ژوٚرمُت ییٚلہِ أسؠ ہیکو خداے سٕندس سکونس منٛز شریک سپدیتھ۔ سُہ وقت چُھ یتھ أسؠ "یہِ دوٚہہ" ونان چھِ۔ تمؠ کوٚر یہِ ییٚلہِ تمؠ داودسؔ سٟتؠ واریاہہِ کٲلؠ اسرائیلین ہندیو جدو ہنٛزِ نافرمٲنی پتہٕ کتھٕ کرِ۔ تمؠ وون، یتھٕ پٲٹھؠ مےٚ برونٛہہ ونمُت چُھ، "یہِ دوٚہہ، ییٚلہِ خداے سٕنٛز کتھٕ بوٗزو، تس مہٕ کریو ضدِ سان نافرمٲنی\f + \fr 4‏:7 \ft مزامیر 95:7۔ 8\f*"
\v 8 لہٰذا، پاک روح چُھ أکس مختلف دوٚہس کُن اشارٕ کران ییٚلہِ خداے سنٛدؠ لوٗکھ ہیکن خداے سٕندس سکونس منٛز شریک سپدیتھ یوس تمہِ دوٚہہ پتہٕ چُھ یوان ییٚلہِ یشُوعنؔ اسرائیلین ہندؠ جد تتھ ملکس منٛز واتنٲوؠ یمیٛک خداین تِمن وعدٕ دِیتُمُت اوس۔ امیٛک مطلب گوو زِ ییٚلہِ یشوعنؔ تہِ کوٚر، تمؠ کوٚر نہٕ تِمن خداے سٕندس سکونس منٛز شریک سپدنس منٛز مدد\f + \fr 4‏:8 \ft تثنِیہ شرع 31:7، یشوع 22:4\f*"
\v 9 لہٰذا، ٲتھٕ پٲٹھؠ توٚہؠ ہیکیو وچُھتھ، خداے سنٛدؠ لوٗکھ ہیکن ونہِ تہٕ خداے سٕندس سکونس منٛز شرکت کرِتھ، یتھٕ پٲٹھؠ زن لوٗکھ چھِ یہُود سبتکہٕ دوٚہہ آرام کران۔
\v 10 حقیقتس منٛز چھِ تِم لوٗکھ یِم خداے سٕندس سکونس منٛز دٲخل گژھان تِم چھِ پننہِ کامہِ ختم کرِتھ آرام کران۔ تِم چھِ یہ کران یتھٕ پٲٹھؠ زن خداین پریتھ کانٛہہ چیز پٲدٕ کرِتھ آرام کوٚر\f + \fr 4‏:10 \ft مُکاشفہ 14:13، پیدٲیش 2:2\f*۔
\v 11 تِمو ساروے کِنؠ، اسہِ پزِ خداے سٕندس سکونس کُن دھیان تھاون۔ اتھ پٲٹھؠ کرنہٕ اسہِ منٛز کانٛہہ اکھ تہِ خداے سٕنٛز نافرمٲنی یتھٕ پٲٹھؠ زن اسرائیلکیٚو جدو کٔر\f + \fr 4‏:11 \ft عبرٲنین 4:1، 1پطرس 1:10۔ 11\f*۔
\v 12 توٚہہِ چھِ یِمن چیزن کُن توجہ دِنچ ضرورت، تکیازِ خداے چُھ یہِ أکس شخصہٕ سنٛدؠ پٲٹھؠ ونان یُس زندٕ چُھ تہٕ کام کار چُھ کران، بشمولہِ یہِ تمیز کرُن زِ لوٗکھ کیا چھِ سونچان تہٕ منصوبہٕ بناوان۔ یہ چُھ یہِ کران اکہِ تلوارِ ہندؠ پٲٹھؠ یتھ زٕ دوٚنوے طرف واریاہ تیز یوسہٕ لوٗکن ہنٛزٕ أڈجہ تِہندیو نٲرو پیٚٹھؠ ژٹِتھ ہیٚکہِ تہٕ یہِ ہیٚکہِ لوٗکن ہنٛز اندرونی زندگی تقسیم کرِتھ۔ \f + \fr 4‏:12 \ft یرمیاہ 23:29، یسعیاہؔ 55:11\f*
\v 13 خداے چُھ پریتھ کٲنٛسہِ شخصس تہٕ چیزس متعلق پریتھ کینٛہہ زانان۔ کانٛہہ تہِ چیز ہیکہِ نہٕ پوشیدٕ روزِتھ یُس تہِ تمؠ پٲدٕ کوٚر ییٚلہِ سُہ پرکھاون یژھِ۔ سوے چُھ اکھ یمِس متعلق أسؠ چھِ کتھٕ کران۔
\v 14 لہٰذا اکھ قدرت وول حکمرٲنی کرن وول کاہن چُھ سانہِ خٲطرٕ کٲم کران، یُس آسمانو منٛزؠ ووٚتھ۔ سُہ چُھ یسوعؔ، خداے سُنٛد گوبر۔ توے چھِ اسہِ تس پیٚٹھ ایمان جٲری تھاون یتھ أسؠ ونان چھِ زِ اسہِ چُھ ایمان۔
\v 15 وونؠ گوو حکمران کاہن یُس سانہِ خٲطرٕ چُھ کٲم کران ہیکہِ اصل پٲٹھؠ سمجھِتھ زِ أسؠ کٲتیاہ کمزور چھِ۔ در حقیقت، تمؠ کوٚر واریاہہِ لٹہِ تجربہٕ زِ کِتھ کِنؠ چُھ غلط کرُن اصل باسان، یتھٕ کِنؠ زن أسؠ چھِ کران۔ اما پوٚز، تمؠ کوٚر نہٕ زانٛہہ گناہ۔
\v 16 تمہِ پتہٕ، اسہِ پزِ دلیری سان خدایس نزدیک گژھن، یُس فضلہٕ سان بادشٲہی کران چُھ۔ اتھ پٲٹھؠ کرِ سُہ اسہِ رحم تہٕ فضل ییٚلہِ اسہِ تمؠ سنٛدِ مددتٕچ ضرورت آسہِ۔
\c 5
\p
\v 1 خداے ییٚلہِ أکس شخصس اکھ حکمران کاہن مقرر چُھ کران، سُہ چُھ تمس شخصس لوٗکن ہنٛزِ اکہِ جمٲژ منٛز ژاران یُتھ زن سُہ تمہِ جمٲژ خٲطرٕ خدایس خدمت کرِ۔ امہِ پتہٕ چُھ سُہ حکمران کاہن خدایس تہِ پیش کران یہِ لوٗکھ دِین یا گناہ چھلنہٕ باپتھ قربان کرِ۔
\v 2 پریتھ کانٛہہ حکمران کاہن چُھ کمزور۔ تمی وجہ کِنؠ، ہیکہِ سُہ تِمن سٟتؠ صبرٕ سان پیش یتھ یِم خدایس متعلق زیادٕ چھِنہٕ زانان تہٕ تِمن سٟتؠ یِمن ایمان چُھ تہٕ تہِ چھِ کران یہِ غلط چُھ۔
\v 3 مزید، تکیازِ پریتھ کانٛہہ حکمران کاہن چُھ کمزور، خداے چُھ تمس نِش تمؠ سنٛدؠ پننٕؠ گناہ دوٚر کرنہٕ باپتھ اکھ قربٲنی پیش کرنُک تقاضہٕ کران، تتھٕ پٲٹھؠ یتھٕ پٲٹھؠ سُہ پننٕؠ گناہ تہٕ باقی اسرائیلکیٚن لوٗکن ہندؠ گناہ چھلنہٕ باپتھ قربٲنی چُھ پیش کران\f + \fr 5‏:3 \ft احبار 16:6\f*۔
\v 4 وونؠ ہیکن نہٕ لوٗکھ عزت وول حکمران کاہن بننُک فٲصلہٕ پانے کرِتھ۔ بلکہ، خداے چُھ ہر أکس شخصس اکھ حکمران کاہن ژاران، یتھٕ پٲٹھؠ تمؠ ہارونؔ گۅڈنیُک حکمران کاہن ژوٚر۔ \f + \fr 5‏:4 \ft خروج 28:1\f*
\v 5 یتھۓ پٲٹھؠ، مسیحنؔ تہٕ ہیوٚک نہٕ پانے اکھ جلال وول حکمران بننُک فٲصلہٕ کرِتھ۔ بلکہ، بب خداین ژوٚر سُہ اکھ حکمران کاہن بننہٕ خٲطرٕ ییٚلہِ تمؠ تس وون، "یتھ دوٚہس پیٚٹھ، چُھ مےٚ پریتھ أکس اعلان کوٚرمُت زِ بہٕ چُھس چوٗن بب، تہٕ ژٕ چُھکھ میون گوبر!"\f + \fr 5‏:5 \ft مزامیر 2۔ 7\f*
\v 6 یتھۓ پٲٹھؠ، ہیکیو توٚہؠ بییٚس زبورِ منٛز پریتھ، بب خداین وون مسیحسؔ: " ژٕ روزکھ ہر ہمیشہِ خٲطرٕ اکھ کاہن بلکل تِتھے پٲٹھؠ یتھٕ پٲٹھؠ ملک صدقؔ اکھ کاہن اوس"
\v 7 ییٚلہِ یسوع مرنہٕ برونٛہہ اسہِ سٟتؠ زندٕ روٚد تہٕ زندگی گژھِتھ واپس آو، تمؠ موٚنگ زورٕ زورٕ تہٕ دوٚکھٕ سان خدایس دعا۔ تمؠ کوٚر یہِ امہِ سببہٕ زِ خداے ہیکہِ تس بچٲوتھ ییٚلہِ سُہ مود۔ تکیازِ تمؠ کوٚر خدایس احترام، خداین بوٗز تمؠ سُنٛد تہٕ دُبارٕ کرُن سُہ زندٕ۔
\v 8 حالانکہِ سُہ چُھ خداے سُنٛد گوبر، تمؠ ہیٚچھؠ زِ خداے سنٛزِ فرمانبردٲری ہُند مطلب کیا چُھ ییٚلہِ تمس خراب چیز پیش آیہِ۔
\v 9 پتہٕ، ییٚلہِ خداین سُہ تہِ کرنس لایق بناونچ کٲم مکمل کٔر، سُہ گوبر بنیاو سُہ اکھ یُس پریتھ شخصس ابدی نجات دِوان چُھ یِس تہِ کران چُھ یمیٛک سُہ تقاضہٕ کران چھِ۔ \f + \fr 5‏:9 \ft یسعیاہؔ 45:17\f*
\v 10 تمؠ کوٚر تہِ تمہِ پتہٕ ییٚلہِ خداین سُہ حکمران کاہن مقرر کوٚر یتھٕ پٲٹھؠ زن ملک صدقؔ اکھ کاہن اوس۔ \f + \fr 5‏:10 \ft عبرٲنین 2:10، مزامیر 110:4\f*
\v 11 اسہِ چھِ ملک صدقؔ سٕندس بارس منٛز واریاہ کتھٕ کرنہِ۔ اما پوٚز، تکیازِ توٚہؠ چھُو نَہ اصل پٲٹھؠ بوزان تہٕ نَہ سمجھان، یِمن چیزن ہنٛز وضاحت کرنؠ آسہِ تُہندِ خٲطرٕ مشکل۔
\v 12 توٚہہِ چُھ مسیحسؔ پیٚٹھ تیٖتہِ زیٹھِ وقتہٕ پیٚٹھٕ ایمان اوٚنمُت زِ توٚہہِ پزِ باقین خدایس متعلق تعلیم دِنؠ۔ امہِ بجایہ، اگرچہِ، کٲنسہِ چِھ ونہِ تہِ توٚہہِ آسان چیز ہیٚچھناوٕنؠ یہِ خداے ونان چُھ۔ توٚہؠ چھُو شُریٚن ہندؠ پٲٹھؠ یِمن دۅد چیون چُھ نہٕ زِ بڈین ہندؠ پٲٹھؠ یِم غذا کھیٚوان چھِ۔
\v 13 سٲری لوٗکھ یِم واریاہ کم زانان چھِ زِ کیا چُھ صحیح تہٕ کیا چُھ غلط چھِ تِمن لوٗکن ہندؠ پٲٹھؠ یِم صرف دۅد چیٚوان چھِ۔ در حقیقت، چھِ تِم شُریٚن ہیوی۔
\v 14 دوٚیمہِ اندٕ، یِم لوٗکھ خدایس متعلق واریاہ زانان چھِ تِم چھِ بڈین ہیوی یِم غذا کھیٚوان چھِ۔ یِمو لوٗکو چُھ لگاتار اپنومُت زِ کتھٕ کِنؠ چُھ پرزٕناون تہٕ پتہٕ صحیح تہٕ غلطس درمیان فرق کران۔
\c 6
\p
\v 1 تمہِ خٲطرٕ، چھِ اسہِ مزید ہیٚچھنٕچ ضرورت یُتھ زن أسؠ بالغ سپدو۔ اسہِ پزِ نہٕ صرف مسیحؔ ہس متعلق بنیٲدی کتھن کُن ظوٚن دِیُن جٲری تھاون۔ دوٚیمیٚن لفظن منٛز، اسہِ چھِنہٕ دوبارٕ یہِ ہیٚچھنٕچ ضرورت زِ بے کار کٲم کِتھٕ کِنؠ کرنؠ بند یا خدایس پیٚٹھ کِتھٕ کِنؠ کرو بھروسہٕ۔
\v 2 اسہِ پزِ نہٕ لوٗکن بپتسمہ دِنہٕ کؠن مختلف طریقن ہندس بارس منٛز دوبارٕ زانُن، یِمن ہندِ مدتہٕ خٲطرٕ باقین پیٚٹھ اتھٕ تھونہٕ کس بارس منٛز، اتھ بارس منٛز زِ مرن وٲلؠ لوٗکھ کتھٕ پٲٹھؠ روزن دوبارٕ زندٕ، یا اتھ بارس منٛز زِ خداے کتھٕ پٲٹھؠ کرِ ٲخرس پیٚٹھ فٲصلہٕ زِ لوٗکھ چھا قصوروار یا معصوم۔
\v 3 یتھ وقتس منٛز، یوٚتام خداے چُھ یژھان زِ اسہِ کرناوِ تہِ، أسؠ ہیکو پزؠ پٲٹھؠ مزید ہیٚچھِتھ تاکہ أسؠ سپدو بالغ۔
\v 4 مگر مےٚ دِیو توٚہہِ کُنہِ چیزس متعلق وننہٕ یُس نہٕ واقع ہیکہِ سپدِتھ۔ تِمن لوٗکن متعلق سونٛچِو یِمو اکہِ لٹہِ رٕژِ شیچھِ متعلق ہیوٚچھ زِ تِمو کوٚر تجربہٕ زِ خداے کیا چُھ پننؠن لوٗکن آسمانہٕ پیٚٹھٕ بخشان، تہٕ تِمو کوٚر پاک روح حٲصل۔
\v 5 تِمن سُپد تجربہٕ زِ تِم کتھٕ چھِ سؠٹھاہ جان یمہٕ خداے ونان چُھ، تہٕ تِمو چُھ برونہٛےٕ تِمن طاقتور چیزن ہُند تجربہٕ کرُن شروع کوٚرمُت یِم خداے کرِ ییٚلہِ سُہ دنیاہس نوو بنایہِ۔
\v 6 سونٛچِو زِ ہرگاہ یِم لوٗکھ رٕژِ شیچھِ پیٚٹھ ایمان تھاون نہٕ تیلہِ کیا سپدِ۔ تتھ صوٗرتس منٛز، تِم ہیکن نہٕ توبہٕ کرِتھ تہٕ دوبارٕ ایمان تھٲوِتھ۔ امیٛک وجہ چُھ یہِ زِ تِمو یہِ کوٚر سُہ چُھ خود غرضی سان خداے سٕندس گوٚبرس دارس کھالنس تہٕ ذلالت کرنس ہیو۔
\v 7 ییٚتین چھِ اکھ مثال: خداے چُھ کُنہِ جایہِ زمیٖنس برکت کران، اکہِ لٹہِ تتھ پیٚٹھ بٲرش تراوان، فصل چُھ وۅپدان یُس لوٗکھ چھِ استعمال کران۔
\v 8 اما پوٚز، ییٚلہِ أکس کھہَس بے فٲیدٕ کُلؠ چھِ کھسان، سُہ چُھ نہٕ کٲنسہِ تہِ مدد کران، تہٕ خداے کرِ تتھ جلد بد دعا۔ ٲخرس پیٚٹھ، کانٛہہ دِیہِ تتھ نار یتھ سٲری بے فٲیدٕ کُلؠ دَزن\f + \fr 6‏:8 \ft یوحناؔ 15:6\f*۔
\v 9 میانیو ٹاٹھیو ایمان باجو، ہتاکہِ مےٚ چُھو توٚہؠ امہِ طریقہٕ با خبر کٔرؠ مٕتؠ، مےٚ چُھ یقین زِ توٚہہِ چھِوی تمہِ کھوٚتہٕ مضبوط ایمان یہِ میون مطلب چُھ۔ در حقیقت، مےٚ چُھ یقین زِ خداین چھُو توٚہؠ بچٲومٕتؠ۔
\v 10 بے شک، ییٚلہِ زن خداے چُھ ہمیشہِ منصفانہٕ طریقو سٟتؠ کٲم کران، سُہ کرِ نہٕ نظر انداز زِ توٚہہِ کیا عمل چھُو کران تہٕ توٚہہِ کتھٕ پٲٹھؠ چھُو باقین لول بران۔ توٚہہِ چھُو ثٲبتھ کوٚرمُت زِ توٚہؠ چھُو خدایس احترام کرنہٕ باپتھ یِم کامہِ کران، خاص کر ییٚلہِ توٚہہِ خداے سٕندٮ۪ن لوٗکن مدد کوٚرمُت چُھ تہٕ تِمن مدد کرُن جٲری تھٲیِو۔
\v 11 بہٕ چھُس بے تاب اوٕ کِنؠ زِ  یوٚتام توٚہؠ سٲری مرِو، توٚہؠ روزو تن دہی سان بھروسہٕ کران زِ خداے دِیہِ توٚہہِ تہِ یہِ توٚہہِ اعتماد سان توقع چُھ۔
\v 12 امہِ طریقہٕ، بنیو نہٕ توٚہؠ سُست۔ تمہِ بدلہٕ، توٚہؠ کریو تہِ یہِ باقی ایمان والیو کوٚرمُت چُھ: تِمو کوٚر تہِ حٲصل یمیٛک تِمن خداین وعدٕ دِیُت، تکیازِ تِمو کوٚر تس پیٚٹھ بھروسہٕ تہٕ صبرٕ سان کوٚرکھ انتظار۔
\v 13 ییٚلہِ خداین ووٚن زِ سُہ کرِ ابرہامؔ سنٛدِ خٲطرٕ کینٛہہ، تمؠ دِژ یہِ پانے ضمانت۔ تمؠ کوٚر تہِ تکیازِ پریتھ دوٚیم نفر یُس امِچ ضمانت ہیکہِ دِتھ سُہ چُھ خداے سنٛدِ کھوٚتہٕ کم طاقتور\f + \fr 6‏:13 \ft پیدٲیش 22:16۔ 17\f*۔
\v 14 یہِ چُھ سُہ وعدٕ یُس تمؠ ابرہامسؔ دِیُت:" بہٕ دِمے ژےٚ یقیٖنن برکت، تہٕ بہٕ کرے ژےٚ یقیٖنن وایاہ ذرؠ عطا"
\v 15 تکیازِ خداین دِژ تس ضمانت یُس تمؠ تس وعدٕ دِیُت، تکیازِ ابرہامؔ روٗد یہِ امید ہیٚتھ ثٲبت قدم، خداین کوٚر تس وعدٕ مطٲبق اکھ نیٚچو عطا۔
\v 16 وونؠ چُھ لوٗکن نِش کانٛہہ یُس تِمو کھوٚتہٕ زیادٕ قدرت وول چُھ یُس تِمن ضمانت دِوان چُھ۔ در حقیقت، ییٚلہِ کانٛہہ امہِ طریقہٕ مرد یا زنان تتھ مطلق ضمانت دِوان چُھ یمیٛک تمؠ وعدٕ کران چھِ یا چھے، یہِ چُھ یقیٖنن انجامس واتان یتھ پیٚٹھ تہِ لوٗکھ بحث کران چھِ\f + \fr 6‏:16 \ft خروج 22:11\f*۔
\v 17 یتھۓ پٲٹھؠ، خداین یوٚژھ تِمن واضیح طور ہاون یِم تمؠ سُنٛد وعدٕ حٲصل کران ٲسؠ زِ سُہ بدلایہِ نہٕ تہِ یہِ تس کرنُک ارادٕ اوس، سُہ چُھ وعدٕچ ضمانت دِوان یتھٕ پٲٹھؠ انسان کران چھِ۔
\v 18 لہٰذا، خداین دِیُت وعدٕ تہٕ بییٚہِ کھیون قسم، زِ سُہ وننہِ نہٕ اپُز یا یِمو چیزو منٛز بدلایہِ نہٕ کانٛہہ۔ تمؠ کوٚر تہِ سانہٕ باپتھ، یِمو تس پیٚٹھ نجات دِنہٕ باپتھ ایمان تھو۔ امہِ طریقہٕ، چُھ سُہ اسہِ اعتمادٕ سان امید جٲری تھاونس منٛز حوصلہٕ افزٲیی کران زِ سُہ کیاہ چُھ اسہِ دِنہٕ خٲطرٕ تیار\f + \fr 6‏:18 \ft گنتی 23:19، 1سمیویل 15:29\f*۔
\v 19 ییٚلہِ اسہِ اعتمادٕ سان امید چھِ یہِ خداے اسہِ دیہِ، یہِ چُھ یتھٕ کِنؠ زن اکھ لنگر چُھ اسہِ سٟتؠ مضبوطی سان سؠٹھاہ تھپ رٹتھ تھاوان یُتھ زن نہٕ اسہِ خداے پیٚٹھ سٲنس ایمانس گرٲے ییہِ۔ مزید، ییٚلہِ اسہِ اعتمادٕ سان امید چھِ یہِ خداے اسہِ عطا کرِ، یہِ چُھ یتھٕ کِنؠ زن تہِ اسہِ آسمٲنی مقدس ہیکل کس اندرمس حصس اندر گٲمٕتؠ ٲسؠ، تتھ اوزان پردس پتھ کُن، تہِ یہِ برونٛٹھے یہِ حٲصل کوٚرمُت\f + \fr 6‏:19 \ft گنتی 23:19۔ 1تیمُتھیس 2:13 \f*۔
\v 20 سۅ چھے سوے جاے یوٚت یسوعؔ خدایس سانہِ باپتھ خدمت کرنہِ تہِ سانہِ باپتھ وتھ ییٚلہِ تراونہِ گوو۔ سُہ گوو توٚر اکھ حکمران کاہن بننہٕ پتہٕ یُس خدایس ہمیشہِ خدمت کرِ، یتھٕ پٲٹھؠ زن ملک صدقؔ اکھ کاہن اوس۔
\c 7
\p
\v 1 وونؠ ونہٕ بہٕ ملک صدقسؔ متعلق بییٚہِ۔ تمؠ کٔر سالم شہرس پیٚٹھ حکومت، تہٕ تمؠ کٔر اکہِ کاہن سنٛدِ حثیتہٕ عظیٖم ترین خدایس خدمت۔ ییٚلہِ ابرہامؔ پنہٕ نؠن کینٛژن دشمنن شکس دِنہٕ پتہٕ گرٕ گژھان اوس، تس سمکھیوو ملک صدقؔ تہٕ دِژن تمس برکت\f + \fr 7‏:1 \ft سالم چُھ شاید یروشلمہٕ خٲطرٕ اکھ پرون لفظ یمیٛک مطلب چُھ امن۔ \f*۔
\v 2 پتہٕ دِیُت ابرہامنؔ تمس پریتھ کُنہِ چیزِ منٛز دٔہم حصہٕ یِم تمؠ پنہٕ نؠن دشمنن نِش نِیہِ ییٚلہِ تِمن شکس دِژن۔ عبرٲنی زبٲنؠ منٛز چُھ ملک صدق ناوک مطلب انصاف پسند بادشاہ، سالم شہرُک بادشاہ ناوک مطلب چُھ سلامتی ہُند بادشاہ، ییٚلہِ زن "سالم" آواز چھِ عبرٲنؠ لفظ "پُرامن" ہشؠ۔
\v 3 ییٚلہِ موسیٰؔ ہن ملک صدقسؔ متعلق لیٚوکھ، تمؠ وون نہٕ تمسٛندِس مٲلس ماجہِ تہٕ جدن متعلق کینٛہہ، زِ سُہ کر زاو یا سُہ کر مود۔ لہٰذا موسیٰؔ ہن کٔر تمہِ برونہٛہ وضاحت زن تہِ اوس سُہ خدایس سٕندس گوٚبرس برابر تہٕ زن کٔر تمؠ ہمیشہِ أکس کاہن سنٛدؠ پٲٹھؠ خدمت۔
\v 4 توٚہؠ ہیکیو ونتھ زِ ملک صدقؔ کوت اہم اوس یمہِ کِنؠ تمام اسرائیلکیٚن ہندؠ جدن ابرہامنؔ تمس تِمو سؠٹھاہ قٟمتی چیزن ہُند دٔہم حصہٕ پیش کوٚر یِم تمؠ پنہٕ نؠن دشمنن نِش أنؠ ییٚلہِ تِمن شکس دِژن۔
\v 5 موسیٰؔ سٕندس شریعتس منٛز، خداین کٔر تِمن مردن سٟتؠ کتھ یِم لاوی قبیلکؠ حصہٕ چھِ بییٚہِ یِم کاہنن ہنٛز خدمت انجام دِوان چھِ۔ تمؠ دِیُت تِمن حکم زِ باقی اسرائیلکیٚن لوٗکن، یِم تِمن ہندؠ رشتہٕ دار چھِ، کموومُت یا ووپدومت سٟتؠ چُھ تمہِ منٛز کریو دٔہِم حصہٕ حٲصل۔ امہِ حقیقتہٕ باوجود دِیُت خداین یہِ حکم زِ اسرٲییٔلکؠ سٲری لوٗکھ چھِ ابرہامؔ سنٛدؠ اولاد۔ \f + \fr 7‏:5 \ft گنتی 18:21\f*
\v 6 ملک صدقؔ چُھنہٕ وونؠ لاوی قبیلُک حصہٕ۔ تمہِ باوجود تہِ، کوٚر تمؠ تمہِ منٛز دٔہِم حصہٕ حٲصل یہِ ابرہامنؔ اوٚن پنہٕ نؠن دشمنن نِش ییٚلہِ تمؠ تِمن شکس دِژ۔ تمہِ علاوٕ دِژ تمؠ ابرہامسؔ برکت، سُہ نفر یمِس خداین اوس وعدٕ دِیتُمُت زِ سُہ دیہِ تس واریاہ اولاد۔
\v 7 وونؠ چُھ پریتھ کانٛہہ مانان زِ زیادٕ اہم لوٗکھ چھِ کم اہم لوٗکن برکت دِوان۔ توے دِژ تمؠ ابرہامسؔ برکت، ملک صدقؔ چُھ ابرہامؔس کھوٚتہٕ زیادٕ اہم۔
\v 8 موسیٰؔ سٕندس شریتعس منٛز چھِ أسؠ ہیٚچھان زِ کاہن کٔتھٕ پٲٹھؠ چُھ دٔہِم حصہٕ نِوان یہِ باقی اسرٲییٔلکؠ کماوان یا ووپداوان چھِ، مگر یِم سٲری کاہن مرن۔ ملک صدقؔ سنٛزِ دلیلہِ منٛز چھِ أسؠ ہیٚچھان زِ تمؠ تہِ نیو تمہِ منٛز دٔہِم حصہٕ یہِ ابرہامنؔ پنہٕ نؠن دشمنن نِش نیو، مگر سُہ روٚد زندٕ۔
\v 9 در حقیقت، اکہِ طریقہٕ سٟتؠ، لاویو تہٕ تُہنٛدِ قبیلہٕ کیو کاہنو دِیُت ملک صدقسؔ دٔہِم حصہٕ ییٚلہِ ابرہامنؔ تس دٔہِم حصہٕ دِیُت۔ ہرگاہ یہِ پوٚز چُھ زِ تِمے کرن تمیٛک دٔہِم حصہٕ اسرائیلکیٚن نِش حٲصل کرِتھ یہِ تِمن نِش چُھ۔
\v 10 مےٚ یہِ وونمُت چُھ سُہ چُھ مانے تھاوان تکیازِ لاوی ٲسؠ نہٕ وُنہِ زامٕتؠ تہٕ تِم ٲسؠ اکہِ طریقہٕ وُنہِ تہِ پننِس بابہٕ ابرہامسؔ اندرے، ییٚلہِ سُہ تہٕ ملک صدقؔ پانہٕ وٲنؠ سمٕکھؠ۔ \f + \fr 7‏:10 \ft پیدٲیش 14:18۔ 20\f*
\v 11 وونؠ بنوو خداین سُہ شریعت یُس تمؠ اسرائیلکیٚن دِیُت سُہ چُھ لاوی سٕندٮ۪ن زُرین پیٚٹھ دارمدار یُس کاہنن ہندؠ پٲٹھؠ خدمت چُھ کران۔ لہٰذا، مثالہِ پٲٹھؠ زِ لوٗکھ ہیکن بنتھ یُس خداے چُھ یژھان زِ تِم گژھن یمہِ ذریعہٕ یِمو کاہنو خداے سٕنٛز خدمت خٲطرٕ کیا کوٚر۔ تتھ صورتس منٛز، خداین آسہ ہے نہٕ زانٛہہ بیاکھ کاہن مقرر کوٚرمُت یتھ کِنؠ زن ملک صدقؔ اوس اکھ کاہن سنٛدِ بدلہٕ یتھٕ پٲٹھؠ زِ ہارونؔ اوس اکھ کاہن۔ اما پوٚز، خداین کوٚر امہِ قسمُک کاہن مقرر۔
\v 12 توٚہؠ ہیکیو ونتھ زِ خداین بنوو سُہ شریعت یمیٛک دارمدار لاوی ہندین زُرین پیٚٹھ چُھ یِم کاہنن ہندِ حثیتہٕ خدمت کرن تکیازِ سُہ شریعت گژھِ بدلُن ییٚلہِ تہِ زانٛہہ کاہنن ہُند خدمت کرنُک طریقہٕ لوٗکھ بدلاون۔
\v 13 توٚہؠ ہیکیو ونتھ زِ خداین چُھ بدلوومُت زِ لوٗکھ کمہِ طریقہٕ کرن کاہن سنٛدِ حثیتہٕ خدمت، تکیازِ یسوعؔ یمِس خداین وون اکھ کاہن، سُہ چُھنہٕ لاوی سنٛدیو زُریو منٛز مگر سُہ چُھ لاوی ہنٛدِس أکس باے سُنٛد ذر۔ أمِس نفرٕ سنٛدؠ کٲنسہِ تہِ زُرؠ چھِ نہٕ أکس کاہن سنٛدِ حثیتہٕ خدمت کٔرمٕژ۔
\v 14 در حقیقت، أسؠ سٲری چھِ زانان زِ سون خداوند یسوع چُھ لاوینؔ ہندس باے یہُوداؔ سُنٛد زُر، تہٕ موسیٰؔ ہن چُھ نہٕ یہُوداؔ سٕندٮ۪ن زُرین متعلق کاہنو حثیتہٕ خدمت کرنُک لیٚوکھمُت۔ \f + \fr 7‏:14 \ft پیدٲیش 19:10، یسعیاہؔ 11:1\f*
\v 15 امہِ علاوٕ، توٚہؠ ہیکیو امہِ کھوٚتہٕ زیادٕ صفٲییٔ سان ونتھ زِ خداین چُھ لوٗکن کاہنو حثیتہٕ خدمت کرنُک طریقہٕ تبدیل کوٚرمُت، ییٚلہِ زن خداین اکہِ مختلف قسمُک کاہن یسوعؔ مقرر کوٚرمُت چُھ، یُس خدایس سنٛدؠ خدمت چُھ کران یتھٕ پٲٹھؠ ملک صدقنؔ کٔر۔
\v 16 سُہ چُھ أکس کاہن سنٛدِ حثیتہٕ خدمت کران تکیازِ کانٛہہ تہِ چیز ہیٚکہِ نہٕ تس زندٕ روزنہٕ نِشہٕ پتھ رٔٹِتھ، یُس تس اکھ قدرت وول کاہن بناون چُھ۔ امہِ قسمُک کاہن، سُہ چُھنہٕ خدایس پیٚٹھ منحصر زِ موسیٰؔ سٕندس شریعتس منٛز کیا چُھ حکم دِنہٕ آمُت زِ انسٲنی کاہن کِتھ کِنؠ چھِ لاوی سنٛدؠ زُرؠ۔
\v 17 توٚہؠ ہیکیو ونتھ زِ یہِ چُھ تمس متعلق پوٚز، تکیازِ بب خداین وون تمس: " توٚہؠ ہیکیو نہٕ زانٛہہ تہِ اکھ کاہن بنُن رکٲوتھ یتھٕ پٲٹھؠ زن ملک صدقؔ اکھ کاہن اوس"
\v 18 امیٛک مانے چُھ یہِ زِ خداین نیٚو سُہ حکم واپس یُس تمؠ کاہنن متعلق دِیتُمُت اوس۔ تمؠ کوٚر یہِ تکیازِ تمہِ طریقہٕ کامہِ کرنہِ اوس بے اثر سُپدمُت۔
\v 19 سُہ طریقہٕ اوس بے فٲیدٕ تکیازِ لوٗکھ ہیکؠ نہٕ تہِ بنتھ یہِ خداین تِمن کرنہٕ سٟتؠ یوٚژھ یہِ خداین پتمہِ لٹہِ حکم دِیتُمُت اوس۔ وونؠ چُھ أمیٛک یہِ تہِ مانے زِ خداین کوٚر اسہِ اعتماد سان توقع کرنہٕ خٲطرٕ کینٛہہ بہتر فراہم۔ ییٚلہِ اسہِ اعتمادٕ سان یہِ امید چھےٚ، أسؠ چھِ خدایس نزدیک تر گژھان۔
\v 20‏-21 وونؠ دِژ نہٕ خداین ضمانت یہِ تمؠ وون ییٚلہِ تمؠ لاوین ہندؠ کینٛہہ زُرؠ بنٲوؠ کاہن۔ اما پوٚز، تمؠ دِژ ضمانت یہِ تمؠ وون ییٚلہِ تمؠ مسیحؔ اکھ کاہن بنوو۔ تہِ چُھ یہِ خداین تمس وون: " خداوندن چھے ضمانت دِژمٕژ یہِ سُہ ونان چُھ، تہٕ سُہ کرِنہٕ بییٚہِ کینٛہہ: توٚہؠ ہیکیو نہٕ زانٛہہ کاہن بنُن رکٲوتھ!" لہٰذا، یتھٕ پٲٹھؠ زن یسوعؔ أکس بڈس کاہن سنٛدِ حثیتہٕ خدمت کران چُھ تکیازِ خداین دِژ ضمانت یہِ تمؠ وون ییٚلہِ تمؠ سُہ اکھ کاہن بنوو،
\v 22 لہٰذا یہِ چُھ اکھ بہتر عہد تہِ، یمِچ ضمانت یسوعؔ دِوان چُھ۔
\v 23 مزید، لاوین ہُند پریتھ اکھ مود تہٕ توے ہیوک نہٕ أکس کاہن سنٛدِ حثیتہٕ خدمت جٲری تھٲوِتھ۔ تمی وجہِ کِنؠ، لاوین ہندؠ چھِ واریاہ زُرؠ ٲسؠ مٕتؠ یِمو کاہنن ہندِ حثیتہٕ خدمت کٔر۔
\v 24 اما پوٚز، یسوع مرِ نہٕ زانٛہہ۔ امی وجہ کِنؠ، روزِ سُہ ہمیشہٕ أکس کاہن سنٛدِ حثیتہٕ خدمت کران۔
\v 25 تکیازِ سُہ چُھ ہمیشہِ أکس کاہن سنٛدِ حثیتہٕ خدمت کران، سُہ ہیکہِ کٲنسہِ أکس تہِ پوٚرٕ پٲٹھؠ نجات دِتھ یُس پننہِ عملہِ سٟتؠ خدایس نزدیک تر گژھان چُھ۔ سُہ ہیکہِ تہِ کرِتھ تکیازِ سُہ مرِ نہٕ زانٛہہ تہٕ یتھٕ پٲٹھؠ ہیکہِ سُہ خدایس تِمن مدد کرنہٕ باپتھ ونتھ۔ \f + \fr 7‏:25 \ft یوحناؔ 2:1۔ 2، 1تیمُتھیس 2:5\f*
\v 26 یسوع چُھ بلکل تمہِ قسمُک حکمران کاہن یُس اسہِ ضرورت چُھ۔ سُہ چُھ خدایس احترام کران، سُہ چُھنہٕ برٲییٔ متعلق سونچان، تہٕ سُہ چُھنہٕ تہِ کران یہِ تس ناپاک کرِ بلکہ چھُ پاک کامہِ کران۔ سُہ چُھنہٕ تِمو لوٗکو منٛز یُس گناہ کران چُھ، سُہ چُھ وۅنؠ ساروے کھۅتہٕ تھدِس آسمانس پیٚٹھ روزان۔
\v 27 وونؠ چُھ لاوین ہندس پریتھ زُرِس یُس أکس حکمران کاہن سنٛدِ حثیتہٕ خدمت کران چُھ، تمس چھے روزانہٕ خدایس قربٲنی پیش کرنہِ۔ گوٚڈٕ چھِ تس پنٕنؠ گناہ دوٗر کرنہٕ خٲطرٕ اکھ قربٲنی پیش کرنؠ، تہٕ تمہِ پتہٕ چھِ باقی اسرائیلکیٚن ہندؠ گناہ دوٗر کرنہٕ باپتھ اکھ قربٲنی پیش کرنؠ۔ اما پوٚز، یسوعنؔ کٔرؠ پریتھ اکؠ سنٛدؠ گناہ دوٚر ییٚلہِ تمؠ اکہِ لٹہِ پنُن پان أکس قربٲنی ہندس حثیتس منٛز پیش کوٚر، لہٰذا تس چھنہٕ واریاہ قربٲنی پیش کرنچ ضرورت۔ \f + \fr 7‏:27 \ft احبار 16:6، عبرٲنین 10:10، 12، 14\f*
\v 28 ٲخرس پیٚٹھ، خداین دِیُت موسیٰ سنٛدِ ذریعہٕ حکم زِ کینٛژن لوٗکن پزِ کاہنن ہندِ حثیتہٕ خدمت کرنؠ، مگر یِم کاہن چھِ کمزور تہٕ مرن۔ تتھ برعکس، ییٚلہِ خداین یہِ ونتھ ضمانت دِژ، یِس تمؠ موسیٰ ہس حکم کرنہٕ پتہٕ کوٚر، تمؠ بنوو پنُن گوبر ہمیشہ ساروے کھوٚتہٕ زیادٕ اثردار کاہن۔
\c 8
\p
\v 1 یہِ چُھ سُہ خاص خیال یتھ متعلق بہٕ لیٚکھان چُھس: اکھ حکمران کاہن تمس أکس ہیو یمؠ سٕنٛز مےٚ وضاحت کٔر چُھ سانہِ خٲطرٕ خدمت کران۔ سُہ چُھ بب خدایس سٟتؠ آسمٲنی جاین منٛز گوٚمُت، تہٕ تمؠ چِھ حکرٲنی شروع کٔرمٕژ\f + \fr 8‏:1 \ft مزامیر 110:1، عبرٲنین 10:12\f*۔
\v 2 سُہ چُھ ساروے کھوٚتہٕ زیادٕ پاک جایہِ خدمت کران بییٚہِ ساروے کھوٚتہٕ اصلی مقدس خٟمس اندر۔ خداوند خداین نہٕ کہ کٲنسہِ انسانن بنوو یہِ مقدس پناہ گاہ۔
\v 3 وونؠ چُھ خداے لوٗکن حکمران کاہن بناوان یتھ زن تِم ہیکن قربٲنی پیش کرِتھ۔ تکیازِ یہِ چُھ تہِ یہِ حکمران کاہن کران چُھ، یسوعس تہِ ٲس اکھ قربٲنی پیش کرنچؠ ضرورت۔
\v 4 لہٰذا، تکیازِ کاہن یِم لاوین ہندؠ زُرؠ چھِ گۅڈے زمیٖنس پیٚٹھ قربٲنی پیش کران یتھٕ کِنؠ زن خداین حکم دِیُت، یسوعؔ آسہ ہے نہٕ أکس کاہن سنٛدؠ پٲٹھؠ خدمت کران ہرگاہ سُہ وونؠ زمیٖنس پیٚٹھ آسہ ہے۔
\v 5 تِم کاہن چھِ تی کران یہِ خدایس أکس مقدِسس منٛز ضرورت چھِ یوس آسمٲنی مقدسُک نمونہٕ چُھ۔ توٚہؠ ہیکیو ونتھ زِ یہِ چُھ پوٚز، تکیازِ خداین کوٚر امیٛک اظہار موسیٰ ہس پیٚٹھ ییٚلہِ سُہ اسرائیلین ہندِ دسؠ مقدس خٟمہٕ تعمیٖر کرناوان اوس۔ تمہِ وزِ، خداین کٔر تس سٟتؠ کتھ، "یقینی بناوو زِ مقدس خٟمک پریتھ کانٛہہ چیز گژھِ اصلی خٟمس سٟتؠ رلُن یہِ مےٚ ژےٚ پیٚٹھ ظٲہر کوٚر ییٚلہِ ژٕ مےٚ سٟتؠ سینا پہاڑس پیٚٹھ اوسکھ\f + \fr 8‏:5 \ft خروج 25:40\f*"
\v 6 مگر یتتھ چُھ تہِ یہِ یسوعسؔ متعلق پوٚز چُھ: سُہ چُھ لاوین ہندین زُریو کھوٚتہٕ أکس رٕتِس طریقس منٛز خدمت کران۔ یتھۓ پٲٹھؠ، یُس عہد خداین یسوعؔ سنٛدِ ذریعہٕ لوٗکن سٟتؠ کوٚر سُہ عہد چُھ تمہِ عہدٕ کھوٚتہٕ زیادے پہن رُت یُس خداین اسرائیلکیٚن سٟتؠ کوٚر۔ امیٛک وجہ چُھ زِ خداین دِیُت بڈین چیزن ہُند وعدٕ ییٚلہِ تمؠ یہِ نوو عہد نامہٕ بنوو۔
\v 7 وونؠ ہیکیو توٚہؠ ونتھ زِ خداین یُس عہد نامہٕ اسرائیلکیٚن سٟتؠ کوٚر سُہ اوس نہٕ کٲمل، تکیازِ خداین کوٚر بیاکھ عہد نامہٕ کرنُک انتخاب۔
\v 8 توٚہؠ ہیکیو ونتھ زِ گوٚڈنُک عہد نامہٕ اوس نہٕ کٲمل، تکیازِ خداین کوٚر اعلان زِ تِمو اسرایٔیلکیٚو تھو نہٕ سُہ عہد نامہٕ اصل پٲٹھؠ ییٚلہِ تمؠ وون، "یتتھ چُھ تہِ یہِ بہٕ توٚہہِ وننہٕ: دھیان دِیو! جلدے بناوٕ بہٕ اکھ نوو عہد نامہٕ دوٚشونے سلطنتن اسرائیل تہٕ یہُوداؔ کؠن پنہٕ نؠن سارنے لوٗکن سٟتؠ۔
\v 9 سُہ عہد نامہٕ آسہِ نہٕ تتھ عہد نامس ہیو یُس مےٚ تِہنٛدین جدن سٟتؠ کوٚر ییٚلہِ مےٚ تِم محبتہٕ سان ملکِ مِصرٕ منٛز کڈتھ أنؠ۔ یہِ چُھ تہِ یہِ بہٕ ونان چُھس: یہِ آسہِ نہٕ تتھ عہد نامس ہیو، تکیازِ تِم روٗدؠ نہٕ تتھ پیٚٹھ قٲیم، لہٰذا مےٚ دِیُت نہٕ تِمن کُن توجہ\f + \fr 8‏:9 \ft احبار 26:12\f*"
\v 10 خدا چُھ ونان یہِ چُھ عہد نامُک سُہ قسم یُس بہٕ پننٕؠ اسرائیلکیٚن لوٗکن سٟتؠ جلدے کرٕ۔ یہِ چُھ تہِ یہِ بہٕ ونان چُھس: بہٕ تارٕ تِمن فکرِ تہٕ میون شریعت مانُن۔ بہٕ آسہٕ تُہنٛد خداے یمِس تِم عبادت کرن، تہٕ تِم آسن لوٗکھ یِمن ہنٛز بہٕ رٲچھ کرٕ۔
\v 11 کٲنسہِ تہِ پیٚیہِ نہٕ بییٚس اسرائیلیس ہدایت دیُن، "بھروسہٕ کریو بییٚہِ کریو خداوندس عبادت" توے کرن میٲنؠ سٲری لوٗکھ مےٚ بھروسہٕ تہٕ کرنم عبادت، چاہے تِم کوتاہ تہٕ اہم یا غٲر اہم آسن۔
\v 12 تہِ سپدِ تکیازِ بہٕ کرٕ تِمن رحمدلی سان تِمہٕ غلط کامہِ معاف یِم تِمو کرِمژٕ چھےٚ۔ تِمن دِمہٕ نہٕ بہٕ تِمن گناہن ہندِ خٲطرٕ دبارٕ سزا یِمو کرؠ مٕتؠ چھِ"
\v 13 ییٚلہِ خداے لفظ "نو" استعمال کران چُھ، تمؠ سُنٛد مطلب چُھ اسرائیلین سٟتؠ گوٚڈنُک عہد نامہٕ چُھ وونؠ پرون۔ مزید، یہِ پرون چُھ سُہ گژھِ جلدے نابود\f + \fr 8‏:13 \ft یرمیاہ 31:31۔ 34\f*۔
\c 9
\p
\v 1 یتھٕ کِنؠ زن گۅڈنیُک عہد نامہٕ خداین اسرائیلس سٟتؠ کوٚر، تتھ منٛز ٲس لوٗکن اکہِ خاص طریقہٕ زمیٖنس پیٚٹھ أکس پناہ گاہس منٛز خدمت یا عبادت کرنؠ۔
\v 2 سُہ پناہ گاہ یُس اسرائیلیو بنوو سُہ اوس اکھ مقدس خٟمہٕ یتھ زٕ حصہٕ ٲسؠ۔ نیٚبرمِس حصس ٲسؠ پاک جاے ونان۔ تِمو تھوو تتھ منٛز اکھ شمع دان تہٕ اکھ میز یتھ پیٚٹھ تِمو خاص ژوٚٹ تھٲوؠ\f + \fr 9‏:2 \ft خروج 25:23۔ 30، 26:1۔ 30\f*۔
\v 3 خٟمُک اندرم حصہٕ اوس دوٚیمہِ طرفہٕ اندرؠ الوٲنتِس پردس تل۔ تِم ٲسؠ تتھ اندرمس حصس سؠٹھاہ پاک جاے ونان۔
\v 4 تِمو تھوو تتھ دوٚیمس کمرس منٛز مُشکہٕ خٲطرٕ قربان گاہ بییٚہِ مقدس صندوق، تِمو کوٚر تِمن دوٚشونے سۅنہٕ سُنٛد کٕھژ۔ تِمو تھوو مقدس صندوقس اکھ سۅنہٕ سُنٛد بانہٕ یتھ منٛز مُنہٕ اوس، سُہ غذا یُس خداین اسرائیلکیٚن لوٗکن صحراوس منٛز روزنس دوران دِیُت۔ تِمو تھوو بییٚہِ تتھ منٛز ہارونؔ سُنٛد آصہٕ یتھ خداین پنہٕ ؤتھر پٲدٕ کٔرؠ۔ تِمو تھٲوؠ بییٚہِ تھتھ منٛز کنؠن ہندؠ تختہٕ یِمن پیٚٹھ موسیٰؔ ہن خدایس سٟتؠ عہد نامٕکؠ داہ حکم لیکھِتھ ٲسؠ۔ \f + \fr 9‏:4 \ft خروج 16:33، 25:10۔ 16، 30:1۔ 6، گنتی 17:8۔ 10، تثنِیہ شرع 10:3، 5\f*
\v 5 تِمو ترٲوؠ مقدس صندوقکس پیٚٹھٕ کٔنہِ دوٚن شاندار پکھٕ والین روحٲنی وجودن ہندؠ مجسمہٕ۔ یِمن مجسمن ہُند سایہِ پیو مقدس صندوقکس ڈکھنس۔ اما پوٚز، وونؠ چھِنہٕ یِمن چیزن ہنٛز وۅکھنے کرنؠ ضروری۔ \f + \fr 9‏:5 \ft خروج 25:18۔ 22\f*
\v 6 تِمو یِم سٲری چیز لاگنہٕ پتہٕ، کاہن گےَ مقدس خٟمہٕ کس نیٚبرمِس حصس اندر پریتھ دوٚہہ خدایس خدمت کرنہِ۔ \f + \fr 9‏:6 \ft تثنِیہ شرع 27:21\f*
\v 7 دوٚیمہِ طرفہٕ، وقتُک حکمران کاہن چُھ ورؠ یس منٛز اکہِ لٹہِ مقدس خٟمہٕ کس انٛدرمِس حصس منٛز اژان۔ تمس چُھ أکس جانور سُنٛد خوٗن پانس سٟتؠ تُلن، یُس سُہ پننٕؠ گناہ بییٚہِ باقی اسرائیلین ہندؠ غفلتس منٛز کرؠ مٕتؠ گناہ چھلنہٕ باپتھ خدایس چُھ پیش کران۔
\v 8 پاک روح چُھ امہِ ذریعہٕ ظٲہر کران زِ کاہن کیا چھِ مقدس خٟمس منٛز کران زِ خداین کوٚر نہٕ یہِ ظٲہر زِ تتھ وقتس دوران آسمٲنی مقدس جایہِ منٛز کِتھٕ کِنؠ چُھ دٲخل گژھن ییٚلہِ تمس لوٗکن زمینی مقدس خٟمن ہند گوٚڈنُک حصہٕ استعمال کرنچ ضرورت ٲس۔
\v 9 یہِ گوٚڈنُک زمینی مقدس خٟمہٕ چُھ مثالہِ پٲٹھؠ تمہِ وقتٕچ وضاحت کران یِمن منٛز تِم اسرٲییٔلی روزان ٲسؠ۔ تتھ وقتس منٛز، کاہنو کٔر قربٲنی پیش یِم لوکھ تتھ قٲبل بنتھ ہیکؠ نہٕ یِمو نیاز أنؠ یِم چھِ نہٕ صحیس تہٕ غلطس درمیان اصل پٲٹھؠ فرق کران۔
\v 10 بییٚہِ پکؠ تِم تِمن قانونن پیٚٹھ یِم صرف جسمٲنی چیزن سٟتؠ تعلق اوس یِمن قانونن منٛز ٲسؠ اکثر کھیٚنس چینس تہٕ آبہٕ سٟتؠ چھلنس متعلق۔ خداین دِیت یِم قانون تِمن یوٚت تام تمؠ پنہٕ نؠن   لوٗکن سٟتؠ اکھ نوو عہد نامہٕ بنوو۔
\v 11 تتھ برعکس، ییٚلہِ مسیحنؔ أکس حکمران کاہن سنٛدِ رنگؠ خدمت کرنؠ شروع کٔر۔ تمؠ دِیت اسہِ تِم چیز یِم اسہِ نِش چھِ۔ سُہ گُزریوو آسمٲنی پاک خٟمہٕ منٛز یُس زمیٖنہِ ہندِ نِش بہتر کٲم کران چُھ۔ یہِ پاک خٟمہٕ بنوو خداین نہٕ کہ انسانو، تہٕ یہِ چُھنہٕ زمیٖنہٕ ہُند۔
\v 12 پتہٕ، ییٚلہِ سُہ ساروےٕ کھۅتہٕ پاک آسمٲنی سؠٹھاہ پاک جایہِ منٛز صرف اکہِ لٹہِ ژاو، تمؠ کوٚر نہٕ جانورن ہُند خوٗن پیش یُس کانٛہہ قربان کران چُھ، یتھٕ پٲٹھؠ زن تِم کاہن کران چھِ یِم لاوی سنٛدؠ زُرؠ چھِ کران۔ تمہِ بدلہٕ، کوٚر تمؠ پنُن خوٗن پیش تہٕ کٔرین پننٕؠ لوٗکھ ہمیشہ تِہندیو گناہو نِش آزاد۔
\v 13 وۅنؠ چھِ تِم لوٗکھ جانورن ہُند خوٗن پیش کران یُس کٔمؠ تام قربان کوٚر، تہٕ تِم چھِ أکس گٲو ہُند سوٗر چھکراوان، یُس تِمو ناپاک لوٗکن پیٚٹھ زولمُت چُھ۔ ییٚلہِ کاہن یمہٕ کامہِ کران چھُ، تِمن چھِ اصلی أکس نفرٕ سٕنٛز ظٲہری پاکیزگی حٲصل کران۔ \f + \fr 9‏:13 \ft احبار 16:14۔ 16، 16:3، گنتی 19:9، 17۔ 19\f*
\v 14 ییٚلہِ زن تہٕ پوٚز چُھ، یہِ مسیحؔ چُھ پننِہِ خوٗنہٕ سٟتؠ سؠٹھاہ جان پٲٹھؠ لوٗکن پاک کران! تمؠ کوٚر پنُن پان خدایس أکس مکمل قربٲنی ہندِ رنگؠ پیش، ابدن زندٕ روزن وٲلؠ روحن بنوو سُہ تہِ کرنس قٲبل۔ سُہ چُھ توٚہہِ سارنے بٲطنی طوٗر پاک کران، تُہنٛدین دِلن ہُند مَل دوٗر کران تہٕ کرنس لایق بناوان یہِ خدایس اصلی ضرورت چُھ۔
\v 15 تکیازِ مسیحؔ چُھ لوٗکن ہُند بٲطن پاک کران، خداین چُھ تمؠ سنٛدِ ذریعہٕ اکھ نوو عہد نامہٕ بنوومُت۔ تمہِ طریقہٕ چُھ خداے تِمن دِوان یمِس سُہ ژارِ یہِ تمؠ وعدٕ دِیُت زِ تِمن گژھِ ابدن حٲصل۔ تہِ ہیکہِ یسوع سنٛدِ سببہٕ سپدِتھ یُس پنہٕ نؠن لوٗکن نجات دِنہٕ باپتھ مود ییٚلہِ تِمو گوٚڈنکہِ عہد نامٕچ نافرمٲنی کٔر یُس خداین اسرائیلس سٟتؠ کوٚر۔
\v 16 وونؠ ییٚلہِ کانٛہہ اکھ اکھ وصیت کران چُھ یُس اکہِ قسمُک اقرار نامہٕ چُھ، تمس نفرس چُھ سۅ وصیت عمل در عمل سپدن برونٛہہ مٲرنٕچ ضرورت۔
\v 17 در حقیقت، ہر کانٛہہ وصیت چھِ صرف أکس شخصہٕ سنٛدِ مرنہٕ پتے عملاونہٕ یوان۔ تکیازِ اکھ وصیت چھِنہٕ تمس شخصہٕ سنٛزِ زندگی دوران عملاونہٕ یوان۔
\v 18 تِتھے پٲٹھؠ، خدایس ٲس یقیناً خوٗنٕچ ضرورت ییٚلہِ تمؠ اسرائیلکیٚن لوٗکن سٟتؠ عہد نامہٕ کوٚر۔
\v 19 بے شک، ییٚلہِ موسیٰ ہن اسرائیلین ہندِ باپتھ خداے سٕندس شریعتس منٛز پریتھ کُنہِ چیزکؠن حکمن ہُند اعلان کوٚر، پتہٕ تُل تمؠ جانورن ہُند خوٗن أکس بانس منٛز یمؠ کٔمؠ تام قربان کٔرؠ مٕتؠ ٲسؠ۔ پتہٕ آب، وۅزُل کپُر تہٕ نرکٲنؠ کُلِکؠ حصہٕ استعمال کٔرِتھ چھوٚک تمؠ سُہ خوٗن تتھ کتابہِ پیٚٹھ یتھ منٛز تمؠ خداے سنٛدؠ حکم لیکھؠ بییٚہِ سارنے اسرائیلین پیٚٹھ۔ \f + \fr 9‏:19 \ft احبار 14:4، گنتی 19:6\f*
\v 20 ییٚلہِ تمؠ سُہ خوٗن چھوٚک تمؠ کوٚر تمن حکم، "یہِ خوٗن چھُ تمہِ عہد نامٕچ اہمیت ہاوان یُس خداین توٚہہِ سٟتؠ کوٚر تہِ وونؠ سپد عمل در عمل"\f + \fr 9‏:20 \ft خروج 24:8\f*
\v 21 موسیٰ ہن چھوٚک سُہ خوٗن یتھۓ پٲٹھؠ مقدس خٟمس بییٚہِ تِمن سارنے اوزارن پیٚٹھ یِم کاہن خدایس خدمت کرنہٕ خٲطرٕ استعمال کران ٲسؠ۔ \f + \fr 9‏:21 \ft احبار 8:15، 19\f*
\v 22 تمہِ علاوٕ، خداین آسہِ موسیٰ سنٛدِس شریعتس منٛز حکم کوٚرمُت زِ کاہنن پزِ پریتھ وزِ لوٗکن یا چیز پاک کرنہٕ خٲطرٕ خوٗن استعمال کرُن۔ در حقیقت، خداے چُھنہٕ کٲنٛسہِ أکس تہِ توٚتام معاف کران یوٚت تام نہٕ اکھ کاہن أکس جانور سُنٛد خوٗن پیش کرِ یُس کٲنٛسہِ قربان کوٚرمُت آسہِ۔ \f + \fr 9‏:22 \ft احبار 17:11\f*
\v 23 توے ٲسؠ کاہنن ساروے کھوٚتہٕ پاک آسمٲنی جایہِ ہُند زمینی نقل پاک کرنہٕ خٲطرٕ جانورن ہنٛز قربٲنی دِنؠ پیوان۔ یتھۓ پٲٹھؠ، یسوعس پیو پانہٕ آسمٲنی سؠٹھاہ پاک جاے پاک کرنہٕ خٲطرٕ امہِ کھوٚتہٕ بوٚڈ نیاز پیش کرُن۔
\v 24 ییٚلہِ تمؠ سُہ نظرانہٕ پیش کوٚر، مسیحؔ سُپد تتھ تھدس آسمان منٛز دٲخل، ییٚتہِ سُہ وونؠ پانہٕ خدایس نِش اسہِ مدد کرنہٕ باپتھ حٲظر چُھ۔ سُہ سُپد نہٕ أکس ساروے کھوٚتہٕ پاک مقامس منٛز دٲخل یُس انسانو بنوومُت چُھ، یُس اصلی پاک جایہِ ہُند اکھ نمونہٕ چُھ۔
\v 25 امہِ علاوٕ، سُہ گوو صرف اکہِ لٹہِ پنُن پان پیش کرنہٕ خٲطرٕ ساروے کھوٚتہٕ تھدس آسمانس منٛز۔ یہِ چُھنہٕ تہِ یہِ زمینی کاہن حکمران کران چھِ۔ تمؠ چھِ پریتھ ورؠیہِ سؠٹھاہ پاک جایہِ منٛز گژھان تہٕ أکس جانور سُنٛد خوٗن چھی پیش کران یُس کٲنٛسہِ قربان کوٚرمُت آسہِ۔
\v 26 ہرگاہ یسوعس ٲسؠ در اصل پنُن پان اکہِ کھوٚتہٕ زیادٕ لٹہِ نیازٕ رنگؠ پیش کرنچؠ ضرورت، تیلہِ آسہِ ہے تمس تمہِ وقتہٕ پیٚٹھ اکثر مرنچ ضرورت ییٚلہِ خداین ہر کینٛہہ چیز پٲدٕ کوٚر۔ مگر ییٚتتھ چُھ یسوعس متعلق پزر یہِ: پننس یتھ ٲخری وقتس دوران، کوٚر تمو صرف اکہِ پھرِ گناہ طاقتہٕ روس بناونہٕ خٲطرٕ پنُن پان اکہِ قربٲنی رنگؠ پیش۔
\v 27 انسان چُھ صرف اکہِ لٹہِ مرُن تہٕ پتہٕ کرِ خداے فٲصلہٕ زِ تِم قصوروار کنہٕ بے گناہ گار۔ \f + \fr 9‏:27 \ft 2 کورنتھین 5:10، جامع 12:14\f*
\v 28 یتھۓ پٲٹھؠ، مسیحنؔ کوٚر پنُن پان صرف اکہِ لٹہِ لوٗکن ہندؠ گناہ دوٗر کرنہٕ باپتھ اکہِ نیازٕ رنگؠ پیش۔ پتہٕ واتہٕ سُہ زمیٖنہِ پیٚٹھ دبارٕ واپس گناہ دوٗر کرنہٕ خٲطرٕ نہٕ بلکہ پننؠن لوٗکن نجات دِنہٕ خٲطرٕ یِم تمس لگاتار انتظار کران چھِ۔ \f + \fr 9‏:28 \ft 1 پطرس 2:24، طیطسؔ 2:13\f*
\c 10
\p
\v 1 یُس قانون خداین موسیٰ سنٛدِ ذریعہٕ دِیُت سُہ چُھنہٕ پانہٕ تِمن حیرت انگیز چیزن منٛز اکھ یوس خدا پنہٕ نؠن لوٗکن دِیہِ۔ بلکہ یہِ چُھ صرف تِمن حیرت انگیز چیزن کُن اشارٕ کران۔ لہٰذا ہرگاہ خدایس نزدیک گژھن وٲلؠ لوٗکھ چھِ ہمیشہِ ورؠیہِ پتہٕ ورؠیہِ نیاز پیش کران، مگر یہِ کرنہٕ سٟتؠ چِھنہٕ تِم بناونس قٲبل سپدان یتھ خداے تِمن نِش یژھان چُھ۔
\v 2 فرض کرو زِ تِمو نیازو کٔر لوٗکھ اصلی پاک یِم خدایس عبادت چھِ کران۔ تتھ صورتس منٛز، تِم آسن نہٕ زانٛہہ تہِ پنہٕ نؠن گناہن متعلق قصوروار محسوس کران، تہِ تِم کرن نیاز پیش کرنؠ بند۔
\v 3 مگر ییٚتتھ چُھ تِمن نیازن متعلق یہِ پوٚز: تِم چھِ لوٗکن ورؠیہِ پتھ ورؠیہِ پننؠن گناہ یاد پاوان۔
\v 4 تِم نیاز ہیکن صرف یہِ کرِتھ، تکیازِ جانورن ہُند خوٗن یِم کٲنٛسہِ قربان کٔر ہیکہِ نہٕ لوٗکن ہندؠ گناہ دوٗر کرِتھ۔
\v 5 یوہے چُھ وجہ زِ ییٚلہِ مسیحؔ زمیٖنس پیٚٹھ آو، تمؠ کٔر پننس ببس سٟتؠ کتھ، "ژےٚ کٔرتھ نہٕ لوٗکن ہندؠ نیاز پیش کرنؠ پسند۔ تمہِ بدلہٕ، کوٚرتھ ژےٚ اکھ انسٲنی جسم میانہٕ باپتھ تیار\f + \fr 10‏:5 \ft مزامیر 40:6۔ 8\f*۔
\v 6 ژےٚ آییہ نہٕ تمہِ قربٲنی پسند یِم لوٗکھ پنٕنؠ گناہ دوٗر سپدنہٕ باپتھ پیش چھِ کران۔
\v 7 لہٰذا، کوٚر مےٚ یِمن لفظن منٛز کلام: " بہٕ چُھس حٲظر! کمؠ تام لیٚوکھ نوشتن منٛز مےٚ متعلق۔ میانہٕ خداے، بہٕ کرٕ چٲنؠ مرضی پوٚرٕ"
\v 8 یہِ مسیحنؔ خدایس گوٚڈٕ وون تہِ چُھ یہِ: " ژےٚ کرِتھ نہٕ لوٗکن ہندؠ نیاز یا لوٗکن ہندؠ گناہ دوٗر کرنہٕ باپتھ قربٲنی پسند" تِم نیاز تہٕ قربٲنی چھِ اسرٲییٔلکؠ خدایس پیش کران یتھٕ پٲٹھؠ زن موسیٰ سٕندس شریعتس منٛز لٲزم چھِ۔
\v 9 پتہٕ وون مسیحنؔ دوٚیم یہِ: " بہٕ چُھس حٲظر! بہٕ چُھس چٲنؠ مرضی پوٚرٕ یژھان کرنؠ" خداے چُھ تہِ پتھ کُن تراوان یتھ متعلق تمؠ گوٚڈٕ کلام کوٚر یُتھ سُہ تہِ قٲیم تھاوِ یتھ متعلق تمؠ دوٚیمہِ پھرِ کلام کوٚر۔
\v 10 خدایس یہِ پسند آو تہِ چُھ یہِ: یسوع مسیحؔ کوٚر پنُن جسم صرف اکہِ لٹہِ قربٲنی رنگؠ پیش، تہٕ امہِ قربٲنی دسؠ تھٲوؠ خداین اسہِ پننہِ خٲطرٕ مخصوص\f + \fr 10‏:10 \ft عبرٲنین 10:14\f*۔
\v 11 وونؠ چھِ تمام زمینی کاہنن دوٚہہ پتہٕ دوٚہہ کھڑا گژھن ییٚلہِ تِم خداے سٕنٛز عبادت چھِ کران تہٕ کُنہِ اکہِ قسمکؠ واریاہ نیاز چھِ پیش کران۔ یِم نیاز ہیکن نہٕ لوٗکن ہندؠ گناہ دوٗر کرِتھ\f + \fr 10‏:11 \ft خروج 29:38۔ 39\f*۔
\v 12 تتھ برعکس، مسیحنؔ کوٚر صرف اکھ قربٲنی پیش یوٚسہٕ ہمیشہِ گناہ دوٗر کرنس منٛز کارگر آسان چھِ۔ پتہٕ، گوو سُہ بب خدایس نِش، ییٚتہِ سُہ تختس پیٚٹھ بیہوان چُھ تہٕ بادشٲنی چُھ کران۔
\v 13 وُنکینس چُھ سُہ تتی روزان یوتام خداے تمؠ سٕندٮ۪ن سارنے دشمنن شکس دیہِ\f + \fr 10‏:13 \ft مزامیر 110:1\f*۔
\v 14 مسیحؔ چُھ تٔتی روزان، تکیازِ تمؠ کٔر اکےٕ قربٲنی پیش، یمہِ سٟتؠ سُہ ہمیشہِ تِمن لوٗکن تیار کران چُھ یِم خداے پننہِ خٲطرٕ تتھؠ بناونہٕ خٲطرٕ مخصوص کران چُھ یہِ خداے تِمن نِش یژھان چُھ۔
\v 15 خداے سُنٛد روح تہٕ چُھ اسہِ تصدیق کران زِ یہِ چُھ پوٚز۔ یہِ چُھ تمؠ وونمُت تمنے لفظن منٛز یِمن ہنٛز مےٚ گۅڈے حوالہٕ دِیُت:
\v 16 "یہِ چُھ تمہِ قسمُک اقرار نامہٕ یُس بہٕ تِمن سٟتؠ سؠٹھاہ جلد کرٕ۔ ییٚتتھ ونہٕ بہِ خداوند یہِ: تِم بناوکھ بہٕ میون شریعت سمجھنس تہٕ تتھ فرمان بردٲری کرنس قٲبل"
\v 17 پتہٕ وون خداے سنٛدؠ روحن یہٕ دوٚیم کتھ تِمن لفظن منٛز یِمن ہنٛز مےٚ برونہٛےٕ ذکر کٔر: " بہٕ دِمہٕ نہٕ تِمن زانٛہہ دبارٕ تِمن گناہگار تہٕ نافرمٲنی ہندین چیزن ہندِ باپتھ سزا یِم تِمو کرؠ مٕتؠ چھِ\f + \fr 10‏:17 \ft عبرٲنین 8:12، یرمیاہ 31:34\f*"
\v 18 ییٚلہِ خداے لوٗکن گناہگار تہٕ نافرمان چیزن معاف کرِ یِم تِمو کرؠ مٕتؠ چھِ، کانٛہہ اکھ کرِنہٕ دبارٕ گناہ دوٗر کرنہٕ باپتھ قربٲنی پیش۔
\v 19 تمہِ پتہٕ، میانیو ایمان باجو، اسہِ ہیکو پوٚرٕ پٲٹھؠ یقین کرتھ زِ یسوع سنٛدِ خوٗنہٕ کہ وجہ سٟتؠ چھِ اسہِ خٲطرٕ آسمٲنی سؠٹھاہ پاک مقامس منٛز اکھ وتھ۔
\v 20 یسوعن کوٚر اسہِ خٲطرٕ سُہ نوٚو تہٕ موثر طریقہٕ قٲیم، یُس ساروے کھوٚتہٕ پاک مقامس اویزان پردٕ منٛزؠ نیران چُھ۔ یہِ اویزان کپڑٕ چُھ علامتی طور یسوع سنٛز نمایندگی کران یمہِ سٟتؠ سُہ زمیٖنہِ پیٚٹھ روزان اوس۔
\v 21 مزید، مسیحؔ چُھ اکھ حکمران کاہن یُس اسہِ خداے سٕندٮ۪ن لوٗکن ہندِ باپتھ کٲم چُھ کران۔
\v 22 تکیازِ یِم چیز چھِ پزؠ، اسہِ پزِ خدایس نزدیک گژھن، تس مکمل خدمت کرنؠ تہٕ تس پیٚٹھ وونؠ مکمل پٲٹھؠ ایمان تھاون زِ تمؠ چھِ أسؠ بٲطنی تہٕ ظٲہری طور پاک کرؠ مٕتؠ یتھ زن نہٕ اسہِ یمہِ یور تِمن برٕ چیزن متعلق قصوروار محسوس کران یِم اسہِ کرؠ مٕتؠ آسن\f + \fr 10‏:22 \ft افسینؔ 5:26، 1پطرس 3:21، عذرا 36:24\f*۔
\v 23 خداین یمؠ اسہِ یِمن چیزن متعلق وعدٕ کوٚرمُت چُھ، سُہ کرِ یہِ تمؠ اسہٕ وونمُت چُھ۔ لہٰذا، اسہِ چُھ پوٚرٕ پٲٹھؠ ایمانس پیٚٹھ روزنچ ضرورت یُس أسؠ ونان چھِ زِ أسؠ چھِ پژھہِ سان امید تھاوان۔
\v 24 مزید، اسہِ چھِ اکھ أکس متعلق سونٛچن ضرورت، خاص کر اکھ أکس کتھٕ پٲٹھؠ چھِ لول برنس تہٕ رُت کرنس منٛز حوصلہٕ افزٲئی کرنؠ۔
\v 25 أسؠ ہیکو تہِ یکجا سمِتھ خداے سٕنٛز عبادت جٲری تھاونہٕ تہٕ اکھ أکس حوصلہٕ افزٲئی کرنہٕ سٟتؠ کرتھ، حالانکہ کینٛہہ لوٗکھ چھِنہٕ اکثر یہِ کران۔ ییٚلہِ زن اسہِ مولوم چُھ زِ یسوع چُھ جلدے واپس ینہٕ وول، اسہِ پزن تِم چیز سؠٹھاہ بے تٲبی سان کرنؠ۔
\v 26 اسہِ پزن تِم سٲری چیز کرنؠ، تکیازِ ییٚلہِ زن اسہِ زٲنتھ مٲنتھ تہٕ عادتن گناہ کوٚر ییٚلہِ اسہِ اکہِ لٹہِ مسیحسؔ متعلق پوٚز کلام مکمل پٲٹھؠ فِکرِ توٚر، کانٛہہ اکھ ہیکہِ نہٕ کانٛہہ نیاز گناہ دوٗر کرنہٕ باپتھ پیش کرتھ۔
\v 27 ہرگاہ اسہِ روٗدؠ گناہ کران، أسؠ سٲری کرو خوفہٕ سان انتظار زِ خداے ٹھہراوِ اسہِ مجرم تہٕ جلدے دیہِ اسہِ پننؠن دشمنن ہندؠ پٲٹھؠ سخ سزا یُس زنہٕ اسہِ نارٕ لمبکن ہندؠ پٲٹھؠ زالہِ\f + \fr 10‏:27 \ft یسعیاہؔ 26:11\f*۔
\v 28 اسرٲییٔلی مارن کانٛہہ تہٕ شخص یمؠ خداین موسیٰ سنٛدِ ذریعہ دنہٕ آمتِس شریعتس فرمانبردٲری مکمل پٲٹھؠ بند کٔر، یوٚتام زن کم از کم زٕ یا ترے نفر تصدیق کرن زِ تمؠ نفرن اوس تہ کوٚرمُت۔ تِمن ییہِ نہٕ تس نفرس پیٚٹھ ترس\f + \fr 10‏:28 \ft تثنِیہ شرع 17:6، 19:15\f*۔
\v 29 مگر وونؠ وُچھووکھ تِم لوٗکھ یِم خداے سٕندس گوٚبرس شرمند کران چھِ۔ تِم چھِ تسنٛدِس خوٗنس معمولی مانان، اگرچہ خداین کوٚر یہِ خوٗن پنُن عہد کرنہٕ تہٕ تِم پننہِ خٲطرٕ الگ کرنہٕ باپتھ استعمال۔ تِمو کوٚر خداے سٕندس روحس مذاق، یُس فضلہٕ سان کٲم چُھ کران۔ خداے دیہِ بجا طور تِمن لوٗکن سزا تمہِ کھوٚتہٕ زیادٕ یمہِ سٟتؠ تمؠ کٲنسہ تہِ سزا دِیُت یمؠ خداے سُنٛد موسیٰؔ سنٛدِ ذریعہٕ دنہٕ آمتِس شریعتس پیٚٹھ پوٚرٕ پٲٹھؠ عمل کرنؠ بند کٔر\f + \fr 10‏:29 \ft عبرٲنین 12:25\f*۔
\v 30 اسہِ چُھ مولوم زِ یہِ چُھ پوٚز تکیازِ اسہِ چُھ خدایس مدِ مقابل آمٕتؠ، یمؠ وون، "بہٕ چُھس سُہ اکھ یُس لوٗکن سزا دیہِ ییٚلہِ تِم مےٚ خلاف عمل کرن۔ بہٕ کرٕ تہِ تمہِ طریقہٕ یمِکؠ تِم مستحق آسن" تمؠ وون مزید، "بہٕ خداوند کرٕ فٲصلہٕ کیا میٲنؠ لوٗکھ چھا قصوروار یا بے گناہ" \f + \fr 10‏:30 \ft تثنِیہ شرع 32:35۔ 36، مزامیر 135:14\f*
\v 31 تِم یِم صرف أکس حقیقی خداے سنٛدِ سزاہکؠ مستحق چھِ تِمن پزِ خوفزدٕ گژھُن!
\v 32 دویمہِ اندٕ، بہٕ چُھس یژھان زِ توٚہؠ کیا چھُو سونچان اتھ متعلق ییٚلہِ توٚہہِ گۅڈٕنیٚھ رٕژِ شیچھِ متعلق بوزُو۔ تتھ وقتس دوران، تھاوٕ توٚہہِ خدایس پیٚٹھ بھروسہٕ جٲری ییٚلہِ توٚہہِ مضبوطی سان تکلیف برداش کٔروٕ۔
\v 33 کینٛژن معاملن منٛز، لوٗکو کٔروٕ توٚہہِ عوامس منٛز بےعزت تہٕ دَکہٕ زد۔ باقی معاملن منٛز، توٚہہِ کوٚروٕ مدد باقی لوٗکن یِمن یتھی معاملہٕ درپیش ٲسؠ۔
\v 34 مزید خاص پٲٹھؠ، توٚہہِ کٔروٕ جیلس منٛز روزن والین سٟتؠ ہمدردی۔ امہِ علاوٕ گوو توٚہؠ تمہِ پتہٕ خوش ییٚلہِ لوٗکو تُہند مال نیٚو۔ تہِ کوٚروٕ توٚہہِ تکیازِ توٚہہِ پرزٕنوو زِ خدایس چُھ تُہندِ خٲطرٕ کینٛژھا بوٚڈ تہٕ زیادٕ پوشن وول۔
\v 35 تمہِ کِنؠ روزیو پراعتماد زِ خداے کرِ یہِ تمؠ وعدٕ کوٚرمُت چُھ۔ خداے چُھ تِمن عظمت سان انعام دِوان یِم یتھ وتہِ منٛز پُر اعتماد آسان چھِ۔
\v 36 یتھٕ پٲٹھؠ توٚہؠ وُچھِتھ ہیکیو، توٚہہِ چھِ خدایس پیٚٹھے بھروسہٕ کرنچ ضرورت۔ یتھٕ پٲٹھؠ توٚہہِ اکہِ لٹہِ تہِ کوٚرمُت چُھ یہِ خداے یژھان چُھ، توٚہہِ گژھِ تہِ حٲصل یمیٛک تمؠ توٚہہِ وعدٕ دِیتمُت چُھ۔
\v 37 یہِ أکؠ نبین لیٚوکھو تہِ چُھ یہِ: " سُہ شخص چُھ واتن وول سُہ واتہِ سؠٹھاہ جلد۔ سُہ کرِ نہٕ واریاہس کالس انتظار۔
\v 38 مزید، تِم یِم مےٚ راستبٲزی سان خدمت کران چھِ تِم کرن زندگی دوران مےٚ پیٚٹھ بھروسہٕ۔ مگر فرض کرو تِم کرن نہٕ مےٚ پیٚٹھ بھروسہٕ۔ پتہٕ کرن نہٕ مےٚ خۅش۔ \f + \fr 10‏:38 \ft عبرٲنین 2:4، غلتین 3:11\f*
\v 39 اما پوٚز، أسؠ چھِنہٕ تِم یِم خدایس پیٚٹھ بھروسہٕ کرُن بند کرن، یِمن سُہ برباد کرِ۔ بلکہ أسؠ چھِ تِم یِم خدایس پیٚٹھ بھروسہٕ کران چھِ، لہٰذا سُہ چُھ اسہِ بچاون۔
\c 11
\p
\v 1 ییٚلہِ لوٗکھ خدایس پیٚٹھ بھروسہٕ کران چھِ، یہِ چُھ تِمن یقین دِوان زِ تِمن سپدِ تہِ حٲصل یہِ تِمن اعتماد سان امید چھِ۔ ییٚلہِ لوٗکن خدایس پیٚٹھ بھروسہٕ آسان چُھ، یہِ چُھ تِمن اندر تِمن چیزن متعلق یقین پٲدٕ کران یِم نہٕ تِم وُچھان چھِ۔
\v 2 در حقیقت، اسرٲییٔلی لوٗکن ہندیو جدو کوٚر خدایس پیٚٹھ بھروسہٕ، تمؠ دِژ تِمن منظوری۔
\v 3 تکیازِ اسہِ چُھ خدایس پیٚٹھ بھروسہٕ، اسہِ چُھ مولوم زِ ہر کانٛہہ چیز چُھ خداین کلام کرنہٕ دسؠ قٲیِم کوٚرمُت یہِ موجود چُھ۔ لہٰذا، تمی یِم چیز أسؠ وُچھان چھِ تِم چھِنہٕ باقی چیزو پیٚٹھٕ آمٕتؠ یِم أسؠ وُچھِتھ ہیکن چھِ\f + \fr 11‏:3 \ft پیدٲیش 1:1، مزامیر 33:6، 9\f*۔
\v 4 تکیازِ تمؠ کوٚر خدایس پیٚٹھ بھروسہٕ، آدمؔ سنٛدؠ نیٚچِوؠ ہابیلنؔ کٔر پننِس بڈس بٲے قٲین سنٛدِ کھوٚتہٕ خدایس اکھ افضل قربٲنی پیش۔ تکیازِ تس اوس خدایس پیٚٹھ بھروسہٕ، خداین دِژ تس منظوری یمہِ خٲطرٕ تمؠ قربٲنی پیش کٔر تہٕ اعلان کوٚرن زِ تمؠ کوٚر تہِ یہِ سہی اوس۔ اگرچہ ہابلؔ مود، أسؠ ہیکو وننہِ تہِ ہیٚچھُتھ زِ تس کوتاہ اوس خدایس پیٚٹھ بھروسہٕ۔
\v 5 تکیازِ حنوکسؔ اوس خدایس پیٚٹھ بھروسہٕ، خداین نیو سُہ آسمانس پیٚٹھ، لہٰذا سُہ مود نہٕ کینٛہہ۔ یتھٕ پٲٹھؠ موسیٰ ہن لیوکھ، "سُہ ہیوک نہٕ کٲنٛسہِ تہِ لٔبتھ۔ تکیازِ خداین نیو سُہ آسمانس پیٚٹھ" خداین کوٚر حنوکؔ آسمانس کُن ننہٕ برونٛہہ اعلان زِ حنوکؔن کوٚر سُہ خۅش\f + \fr 11‏:5 \ft پیدٲیش 5:21۔ 24\f*۔
\v 6 در حقیقت، لوٗکھ ہیکن خدایس صرف خۅش تھٲوِتھ ییٚلہِ تِمن تس پیٚٹھ بھروسہٕ آسہِ۔ تمی کِنؠ یِم لوٗکھ خدایس نکھٕ گژھان چھِ تِمن چُھ ایمان أننُ ضروری زِ سُہ چُھ حقیقی تہٕ سُہ دیہِ تِمن لوٗکن انعام یِم تس خدمت تہٕ عبادت کرنؠ یژھان چھِ۔
\v 7 خدایس پیٚٹھ ایمان کِنی کوٚر نوحنؔ خدایس احترام ییٚلہِ خداین تس پیٚٹھ ظٲہر کوٚر تہِ یہِ نہٕ تمؠ ونہِ وُچھمُت اوس۔ لہٰذا، نوحنؔ بنٲوؠ ناو پنُن عیال تمہِ سہلاب نِش بچاونہٕ خٲطرٕ یُس خداے سوزہے۔ امہِ طریقہٕ اوس نوحسؔ خدایس پیٚٹھ ایمان، تمؠ کوٚر ثٲبت زِ باقی سٲری ٲسؠ خطا زد۔ مزید، نوحؔ بنوو اکھ شخص یُس خداین راست بٲزی ہُند وٲرث بنوو تکیازِ نوحسؔ اوس تس پیٚٹھ بھروسہٕ\f + \fr 11‏:7 \ft پیدٲیش 6:13۔ 22، 7:1\f*۔
\v 8 خدایس پیٚٹھ ایمان کِنی کوٚر ابرہامنؔ تہِ یہِ خداین ووٚنس ییٚلہِ خدایس تس سٟتؠ کلام کوٚر۔ تمؠ ترٲو پنُن گرٕ تہٕ درٲو أکس جایہِ کُن ییتہِ خداے تمؠ سُنٛد نوو گرٕ جلدے بناوہے۔ ییٚلہِ تمؠ پنُن گرٕ تراو، تس اوس نہٕ معلومےٕ زِ تسُند نوو گرٕ کتہِ آسہِ\f + \fr 11‏:8 \ft پیدٲیش 12:1\f*۔
\v 9 تکیازِ تمؠ کوٚر خدایس پیٚٹھ بھروسہٕ، ابرہامنؔ کوٚر تتھ ملکس منٛز قیام یُس خداین تِمن دِنُک وعدٕ کوٚرمُت اوس، مگر ونہِ اوس نہٕ تُہنٛد ملک۔ تمؠ کٔر پننس نیچوس اضحاقسؔ بییٚہِ پننس نیٚچِوؠ سٕندس نیچوس یعقوبسؔ سٟتؠ عارضی خٟمن منٛز زندگی بسر، اگرچہ خداین تِمن سارنے ترینونی وعدٕ کوٚرمُت اوس زِ سُہ دیہِ تِمن یہِ ملک۔
\v 10 ابرہامنؔ گُزٲرؠ یتھۓ پٲٹھؠ زندگی تکیازِ سُہ اوس تتھ محفوظ تہٕ پائیدار آسمٲنی شہرُک امیدوار یُس خداین پٲدٕ کوٚر۔
\v 11 ایمان سببہٕ، سپد ابرہامؔ پننہِ آشنہِ سارہسؔ نِش اکھ نیٚچو پراونس قٲبل ہرگاہ سۅ کٲفی بُزرگ ٲس زِ سۅ تس ہیٚکہِ نہٕ معمولی پٲٹھؠ اکھ بچہ پرٲوِتھ۔ تہٕ سُپد، تکیازِ تمؠ کوٚر حساب زِ خداے کرِ یقیناً تہِ یہِ تمؠ ووٚن\f + \fr 11‏:11 \ft پیدٲیش 17:19، 18:11، 21:2\f*۔
\v 12 اگرچہ ابرہامؔ سؠٹھاہ بُزرگ اوس، ابرہامسؔ آسہٕ واریاہ اسرٲییٔلی پیڑِ۔ یتھٕ پٲٹھؠ زن خداین وعدٕ کوٚر، اسرٲییٔلی چھِ واریاہ یتھٕ پٲٹھؠ زن آسمانس منٛز واریاہ تارک چھِ تہٕ یتھٕ پٲٹھؠ زن سمندر بٹھس پیٚٹھ واریاہ سؠکہِ دانہٕ چھِ\f + \fr 11‏:12 \ft پیدٲیش 15:5، 2:12\f*۔
\v 13 تِمو ساروے لوٗکو کوٚر توٚت تام خدایس پیٚٹھ بھروسہٕ یوٚت تِم مودؠ۔ ییٚلہِ تِم زندٕ ٲسؠ تِمو کوٚر نہٕ تجربہٕ زِ خداین کیاہ دِنُک اوس تِمن وعدٕ کوٚرمُت، مگر تِم ٲسؠ زانان زِ خداے کرِ جلدے تہِ یمیُک تمؠ وعدٕ دیتمُت اوس۔ تِمو ہوو پریتھ أکس زِ تِم چھِ نہٕ یتھ دنیاہس سٟتؠ تعلق تھوان\f + \fr 11‏:13 \ft پیدٲیش 23:4، 1اخبار 29:15\f*۔
\v 14 بے شک، سٲری لوٗکھ یِم یتھ دنیاہس عارضی ونان چھِ تِم چھِ واضیح پٲٹھؠ ہاوان زِ تِمن چھِ پننس ملکس منٛز زندگی گزارنٕچ خوٲہِش۔
\v 15 مگر فرض کرو تِمو باوفا لوٗکو مون سُہ ملک پنُن وطن یُس تِمو تراومُت اوس۔ تتھ صورتس، منٛز ہیکہِ ہن تِم تتھ ملکس منٛز واپس گٔژھتھ، مگر تِم گےَ نہٕ۔
\v 16 مگر تِمن متعلق چُھ پزر یہِ: تِم ٲسؠ أکس بڈس آسمٲنؠ ملکس مشتاق۔ امہِ وجہ سٟتؠ، چُھ خدایس عزت میلان ییٚلہِ باقی لوکھ چھِ تمؠ سنٛدؠ یِمن لوٗکن ہنٛدِس خداے سنٛدؠ رنگؠ تذکرٕ یِمو تمس پیٚٹھ بھروسہٕ کوٚر۔ توٚہؠ ہیکیو ونتھ زِ یہِ چُھ پوٚز، تکیازِ خداین چُھ تُہنٛدِ روزنہٕ خٲطرٕ اکھ شہر تیار کوٚرمُت\f + \fr 11‏:16 \ft خروج 3:6، 3:15\f*۔
\v 17 کیازِ کہ تمؠ کوٚر خدایس پیٚٹھ بھروسہٕ، ییٚلہِ خداین تمؠ سُنٛد امتحان کوٚر، ابرہامنؔ آسہ ہے پنُن نیٚچو اضحاقؔ قربٲنی رنگؠ پیش کوٚرمُت۔ بے شک، سُہ شخص یمِس خداین واریاہ پیڑِ دِنُک وعدٕ کوٚر، اوس تمؠ سُنٛد تہٕ تمؠ سنٛزِ زنانہِ سارہؔ سُنٛد کُنے بچہ قربٲنی رنگؠ پیش کرنس تیار\f + \fr 11‏:17 \ft پیدٲیش 22:1۔ 10\f*۔
\v 18 در حقیقت، خداین اوس ابرہامسؔ برونٛٹھے ووٚنمُت، "یِم واریاہ زُرؠ ژےٚ دِنُک مےٚ وعدٕ کوٚرمُت چُھے تِم نیرن چٲنس نیچوس اضحاقسؔ نِشہٕ"
\v 19 ابرہامنؔ کٔر امہِ طریقہٕ عمل تکیازِ تمؠ سمجھ زِ خداے ہیکہِ مودؠ مٕتؠن دُبارٕ زندٕ کرِتھ۔ در حقیقت، ہرگاہ اسہِ علامتی رنگؠ ونو، ابرہامسؔ میلیاو اضحاقؔ تمؠ سنٛدِ مرنہٕ پتہٕ واپس۔
\v 20 خدایس پیٚٹھ بھروسہٕ کہِ سببہٕ دِژ اضحاقنؔ پننؠن نیچوین یعقوبسؔ تہٕ عیسوؔس برکت، یہِ اعلان کوٚرُن زِ تِمن دوٚنونے سٟتؠ کیا سُپدِ۔ \f + \fr 11‏:20 \ft پیدٲیش 27:27۔ 40\f*
\v 21 خدایس پیٚٹھ ایمان تھاونہٕ کِنی ییٚلہِ سُہ مرنس نکھٕ ووت، یعقوبنؔ دِیُت پننس نیٚچِوؠ یوسفؔ سٕندٮ۪ن دۅشوٕنؠ نیچوین برکت۔ تمؠ کٔرؠ پننِس عاصس پیٚٹھ لٔمِتھ روزنہٕ وزِ خداے سنٛدؠ تعریف۔ \f + \fr 11‏:21 \ft پیدٲیش 47:31، 48:15۔ 16\f*
\v 22 خدایس پیٚٹھ بھروسہٕ کہِ سببہٕ، ییٚلہِ سُہ مرنس قریب لوگ واتنہِ یوسفنؔ کٔر اسرائیلین سٟتؠ ملکہ مِصر تراونس متعلق کتھ۔ بییٚہِ کوٚر تمؠ تِمن حکم زِ تمؠ تُلن تمؠ سٕنٛز اڈجہِ پانس سٟتؠ ییٚلہِ تِم نیرن۔ \f + \fr 11‏:22 \ft پیدٲیش 50:24۔ 25، خروج 13:19\f*
\v 23 خدایس پیٚٹھ بھروسہٕ کہ سببہٕ تھوو موسیٰؔ سنٛدؠ مٲلؠ ماجہِ موسیٰؔ تھنہٕ پیٚنہٕ پتہٕ تروُہن ہفتن کٔھٹِتھ۔ تمو کٔر ہمتہٕ سان مصرٕکس بادشاہ سٕندس حکمس نافرمٲنی یُس اسرٲییٔلی نیٚچوؠ مارنس متعلق اوس۔ تِمو کوٚر تہِ تکیازِ تِم ہیکن ؤنتھ زِ موسیٰ اوس اکھ اصل شُر۔ \f + \fr 11‏:23 \ft خروج 1:22، 2:2\f*
\v 24 خدایس پیٚٹھ تمؠ سنٛدِ بھروسہٕ کِنی، ییٚلہِ سُہ بالغ سُپد، موسیٰ ہن کوٚر انکار زِ سُہ کتھٕ کِنؠ اوس مصرٕکس بادشاہ فرعونؔ سنٛزو کورین منٛز أکس کورِ ہُند منٛگتہ نیٚچو۔ \f + \fr 11‏:24 \ft خروج 2:11\f*
\v 25 تمؠ کوٚر یہِ تجربہٕ کرنُک فٲصلہٕ زِ لوٗکو کتھٕ کِنؠ کوٚر خداے سٕندٮ۪ن لوٗکن سٟتؠ بدسلوکی بنسبتہِ کینٛژس کالس گناہ کرنس منٛز مزٕ تُلن۔
\v 26 تمؠ کوٚر حسابہٕ زِ مسیحؔ سنٛدِ وجہ سٟتؠ تمؠ سٕنٛز توہین کرن وٲلؠ لوٗکھ چھِ مصرٕکس سرِ زمیٖنس منٛز تمام عٲلیشان تہٕ قٟمتی چیزو کھوٚتہٕ زیادٕ قٟمتی۔ تمؠ سونچ امہِ اندازٕ، تکیازِ تمؠ کوٚر اتھ کتھِ پیٚٹھ توجہ زِ خداے کِتھٕ کِنؠ دِیہِ تس انعام۔ \f + \fr 11‏:26 \ft 1 پطرس 4:14، متی 5:12\f*
\v 27 خدایس پیٚٹھ بھروسہٕ کِنی دراو موسیٰ مصرٕکہ ملکہٕ منٛز نیٚبر۔ تس اوس نہٕ خوف زِ بادشاہ کیا کرِ ییٚلہِ تس شرارت آسہِ۔ تمؠ کٔر تمی طریقہٕ عمل، تکیازِ تس روٗد خدایس پیٚٹھ مکمل بھروسہٕ زن اوس سُہ خدایس وُچھِتھ ہیکان، یُس پوشیدٕ چُھ۔ \f + \fr 11‏:27 \ft خروج 2:15، 10:28۔ 29\f*
\v 28 خدایس پیٚٹھ بھروسہٕ کِنی ہوو موسیٰ ہن اسرائیلین گوٚڈٕ پھرِ فسح عید مناونؠ تہٕ برٕ کٹن ہُند خوٗن پنہٕ نؠن دروازن پیٚٹھ مٔتتِھ تھاون مقرر۔ تِمو کوٚر تہِ یُتھ زن سُہ روحٲنی وجود یمؠ مصرین ہنٛدؠ زِٹھؠ شُرؠ قتل کٔرؠ سُہ کرِنہٕ پنہٕ نؠن بڈین شُریٚن قتل۔ \f + \fr 11‏:28 \ft خروج 12:21۔ 29\f*
\v 29 خدایس پیٚٹھ بھروسہٕ کِنی تٔرؠ اسرائیلی بحرِ قُلزمسؔ اپور زن تہٕ ٲسؠ تِم خشک زمیٖنہِ پیٚٹھ پکان ییٚلہِ خداین تِمن ہندِ باپتھ اکھ وتھ بنٲوؠ۔ پتہٕ ییٚلہِ مِصری تِمن پتہٕ لاریے، تِم پٔھٹؠ آبس ییٚلہِ خداین وتھ بند کٔر۔ \f + \fr 11‏:29 \ft خروج 14:21۔ 31\f*
\v 30 خدایس پیٚٹھ اسرائیلین ہندِ بھروسہٕ کِنی گرٲوؠ تمؠ یرِیحُو شہرس اندؠ اندؠ دیوار ییٚلہِ اسرٲییٔلی شہرس اندؠ اندؠ أکس ہفتس بار بار پیش قدمی کران ٲسؠ۔ \f + \fr 11‏:30 \ft یشوع 6:12۔ 21، مزامیر 106:9۔ 11\f*
\v 31 خدایس پیٚٹھ أکس پاژھِنؠ راحبؔ سنٛدِ بھروسہٕ کِنی تھٲوؠ تمہِ جاسوٗس حفاظتس منٛز یِم یشوعنؔ روانہٕ کرؠ مٕتؠ ٲسؠ۔ تکیازِ تمہِ کوٚر تہِ، اسرائیلیو کٔر نہٕ سۅ قتل ییٚلہِ تِمو یریحو شہرس منٛز پریتھ کانٛہہ خدایس نافرمان روزن وول قتل کوٚر۔
\v 32 بہٕ ہیٚکہٕ نہٕ وونؠ اتھ متعلق زیادٕ کینٛہہ ونتھ۔ مےٚ نِش چُھنہٕ جدعونسؔ، برقسؔ، سمسونسؔ، افتاہسؔ، داودسؔ تہٕ سموئیلسؔ بییٚہِ باقی نبین متعلق توٚہہِ وننہٕ خٲطرٕ وقت۔
\v 33 تکیازِ یتھیو لوٗکو کوٚر خدایس پیٚٹھ بھروسہٕ، کینٛژو دِژ وۅپر ملکن ہندس فوجس شکس۔ باقیو کٔر عدلہٕ سان حکومت۔ باقین سپد تہِ حٲصل یہِ خداین اوسُک وعدٕ کوٚرمُت۔ باقیو رٔٹؠ سٕہہ تِمن کھینہٕ نِش پتھ۔
\v 34 باقیو رُکووو نار تِمن زالنہٕ نِش۔ باقی روٗدؠ زندٕ ییٚلہِ کٲنسہِ أکؠ تِمن پیٚٹھ پُر تشدد حملہٕ کوٚر۔ باقی بنییہِ طاقت ور ییٚلہِ تِم کمزور ٲسؠ۔ باقیو کٔر پنہٕ نؠن دشمنن سٟتؠ طاقتہٕ سان لڑٲے۔ باقیو دِژ ووٚپر ملکن ہندین سپہن مکمل پٲٹھؠ شکس۔
\v 35 کینٛژو زنانو وُچھ زِ خداین کتھٕ پٲٹھؠ کٔرؠ تُہنٛدین گرن ہندؠ بٲژ مرِتھ تہٕ دبارٕ زندٕ۔ اما پوٚز، باقےٕ لوٗکو کوٚر تجربہٕ زِ کتھٕ کِنؠ واتنوو باقیو زٲنتھ مٲنتھ تِمن تکلیف یُتھ تِم خداے سٕنٛز نافرمٲنی کرِن۔ تمہِ پتہٕ تہِ روٗدؠ تِم خداے سٕنٛز فرمانبردٲری کران۔ یتھٕ پٲٹھؠ کرِ خداے تِمن دُبارٕ زندٕ یتھٕ کِنؠ نہٕ تِم زانٛہہ کٲلؠ مرِتھ ہیکان۔
\v 36 مزید، باقے لوٗکو تُلؠ تکلیف ییٚلہِ تِمن مذاق کران ٲسؠ یا تہنٛزن شانن پیٚٹھ رزَو سٟتؠ لایان ٲسؠ۔ کُنہِ وِزِ، کٔرؠ تِم حکمرانو گرفتار تہٕ جیلس منٛز ترٲوکھ۔
\v 37 لوٗکو مٲرؠ تِم وفادار لوٗکھ کنہِ کنہِ کٔرِتھ یا وولوٗکھ تِمن چیر۔ لوٗکو دِژ تِمن خدایس نافرمٲنی کرنچ لالچ۔ لوٗکو کٔرؠ تِم تلوارو سٟتؠ قتل۔ یِم وفادار لوٗکھ پھیرؠ دربدر جانورن ہُند مسلہٕ لٲگتھ۔ تِمن اوس نہٕ کہنؠ، تہٕ لوٗکو ستٲوؠ تِمن تہٕ تِمن سٟتؠ کرکھ بدسلوکی۔
\v 38 اگرچہ لوٗکو یتھٕ پٲٹھؠ تِمن سٟتؠ سلوک کوٚر تِم ٲسؠ نہٕ یژھِ جایہِ خدایس پٹؠھ بھروسہٕ کرن والیٚن سٟتؠ زندٕ روزنس لایق۔ تمہِ باوجود، یِمن وفادار لوٗکن پیوو وجار جاین، پہاڑن پیٚٹھ تہٕ زمیٖنہِ منٛز گوٚپھن منٛز روزُن۔
\v 39 حالانکہ خداین دِژ یمن سارنے لوٗکن منظوری تکیازِ تِمو کوٚر تس پیٚٹھ بھروسہٕ، تمؠ دِیُت نہٕ تِمن ونہِ تہِ تہِ یمیُک وعدٕ تمؠ تِمن سٟتؠ کوٚرمُت اوس۔
\v 40 بلکہ، خداین کٔرؠ وقتہٕ برونٛہہ اسہِ کینٛہہ تمہِ کھوٚتہٕ بوٚڈ دِنہٕ خٲطرٕ تیار یہِ تِمو لوٗکو زندٕ روزنس دوران حٲصل کوٚر۔ یتھٕ پٲٹھؠ، صرف ییٚلہِ أسؠ تہٕ تِم سٲری یکجا آسو أسؠ سٲری بنو یہِ خداے اسہِ بناون یژھان چُھ۔
\c 12
\p
\v 1 تمہِ پتہٕ، تکیازِ خدایس پیٚٹھ بھروسہٕ کران وٲلؠ تِم سٲری لوٗکھ چھِ اسہِ وُچھان، اسہِ چھِ خدایس پیٚٹھ بھروسہٕ کرنس منٛز دریٚرٕ سان روزنچ ضرورت۔ تہِ کرنہٕ خٲطرٕ چھِ اسہِ گناہ کرنؠ تھامہِ رٹنچ ضرورت بییٚہِ کُنہِ تہِ چیزٕ نِش بچُن یُس اسہِ رُکاوٹ بننہِ۔
\v 2 اسہِ چھِ یسوعس پیٚٹھ توجہ مرکوز کرنچ ضرورت، سُہ اکھ یُس اسہِ خدایس پیٚٹھ گوٚڈٕ بھروسہٕ کرنس لایق بناون چُھ تہٕ پتہٕ اسہِ مرنہٕ کس دمس تام تی کرُن۔ سُہ روٗد دوٚکھ ویٚتراونس پیٚٹھ پانہٕ درِتھ ییٚلہِ سُہ صلیبہِ پیٚٹھ مود، تہٕ تس اوس نہٕ پرواہ زِ تمؠ دِیُت زُو شرمندگی سان۔ تمؠ کٔر تِمے اندازٕ عمل تکیازِ تس اوس مولوم زِ خداے بناوِ تس پتہٕ خۅشحال۔ وونؠ، چُھ سُہ بب خدایس سٟتؠ، ییتہِ سُہ تختس پیٚٹھ بہتھ بادشٲہی کران چُھ\f + \fr 12‏:2 \ft 1 پطرس 2:23۔ 24، طیطسؔ 2:13۔ 14\f*۔
\v 3 توٚہہِ چھےٚ یسوعسؔ پیٚٹھ غور کرنٕچ ضرورت، یُس ثٲبت قدم روٗد ییٚلہِ گناہ گارو تس سٟتؠ جھگڑٕ کوٚر، ہرگاہ تمو صرف پانسےٕ زخم دِیتؠ۔ امہِ طریقہٕ ہیکیو توٚہؠ اندرؠ کِنؠ مضبوط تہٕ برداش کرن وٲلؠ بنتھ۔
\v 4 ونیُک تام چھُو نہٕ توٚہؠ بدی ہُند مقابلہٕ کران پنُن زُو چھپہِ دِیتمُت بییٚہِ گناہ نہٕ کرنس منٛز سخ محنت کٔرمٕژ۔
\v 5 مزید، توٚہہِ گوو تہِ یاد تھاونس منٛز ناکام یہِ سلیماننؔ پنہٕ نؠن شُریٚن کرنُک حوصلہٕ دِیت، یہِ توٚہہِ پیٚٹھ تہِ چُھ لاگو سپدان۔ سلیماننؔ لیوکھ یہِ: میانہِ شُرِ، ہوشہِ سان ہیٚچھٕ ییٚلہِ خداوند ژٕ تربیت دِوان چُھے۔ بے شک، برداش کر ییٚلہِ سُہ ژےٚ اصلاح کران چُھے۔
\v 6 ژےٚ پزی یہِ کرُن، تکیازِ خداوند خداے چُھ پریتھ أکس تربیت دِوان یِس سُہ لول بران چُھ۔ بے شک، سُہ چُھ پریتھ أکس شُرِس سختی سان اصلاح کران یِس سُہ پنُن ونان چُھ\f + \fr 12‏:6 \ft امثال 3:11۔ 12\f*۔
\v 7 توٚہہِ چھِ ثٲبت قدم روزنچ ضرورت یُتھ زن خداے ہیکہِ توٚہہِ تربیت دِتھ۔ خداے چُھ یِمو طریقو توٚہہِ سٟتؠ سلوک کران تکیازِ توٚہؠ چھُو تمؠ سنٛدؠ شُرؠ۔ توٚہؠ ہیکیو ونتھ زِ یہِ چُھ پوٚز، تکیازِ مول موج چُھ پنہٕ نؠن شُریٚن ہمیشہِ تربیت دِوان۔
\v 8 فرض کرو خداین دِژ نہٕ توٚہہِ تربیت، ہرگاہ تمؠ بییٚہِ پریتھ کٲنٛسہِ تربیت دِژ۔ تتھ صورتس منٛز، توٚہؠ ٲسیٚو نہٕ پزی پٲٹھؠ خداے سنٛدؠ شُرؠ۔
\v 9 مزید، سانیو انسٲنی مٲلؠ ماجہِ دِژ اسہِ تربیت ییٚلہِ أسؠ شُرؠ ٲسؠ، تہٕ اسہِ کوٚر تِمن عزت۔ لہٰذا، اسہِ پزِ یہِ زیادے پہن قبول کرُن ییٚلہِ سون روحٲنی بب، خداے، اسہِ تربیت دِوان چُھ۔ امہِ طریقہٕ، روزو أسؠ ابدن زندٕ\f + \fr 12‏:9 \ft خداے\f*۔
\v 10 مزید، سانیو انسٲنی مٲلؠو ماجو کٔر اسہِ کینٛہہ وقتہٕ خٲطرٕ تِمن طریقن ہنٛز تربیت یِم تِم صحیح سمجھان ٲسؠ۔ اما پوٚز، سون بب خداے چُھ اسہِ تِمو طریقو تربیت کران یِم سانہِ باپتھ سؠٹھاہ بہتر چھِ۔ امہِ طریقہٕ، چھِ أسؠ تِم بنان یِم تمؠ الگ کرؠ مٕتؠ چھِ، یتھٕ پٲٹھؠ سُہ پنُن پان پاک کران چُھ۔
\v 11 ییٚلہِ تہِ زانٛہہ خداے اسہِ تربیت دِوان چُھ، یہ سپدنس دوران چھِ خوشی بجایہ تکلیف واتناوان۔ اما پوٚز، اکہِ لٹہِ ہیٚچھِو زِ خداے کیازِ چُھ اسہِ تربیت دِوان، أسؠ چھِ پُر امن پٲٹھؠ صحیح کرنس قٲبل بنان۔
\v 12 تِمو ساروے کِنؠ، توٚہہِ چھِ خدایس پیٚٹھ بھروسہٕ کرنہٕ خٲطرٕ ثٲبت قدم روزنچ ضرورت خٲطرٕ پنُن پان تیار کرُن، یتھٕ پٲٹھؠ زن دوٚر تراون وٲلؠ چھِ پنٕنؠ تھکمٕتؠن جسمن دور جٲری تھونہٕ خٲطرٕ تیار کران\f + \fr 12‏:12 \ft یسعیاہؔ 35:3\f*۔
\v 13 توٚہہِ چھِ خدایس پیٚٹھ بھروسہٕ کرنچؠ تہٕ فرمانبردٲری کرنس کُن دھیان دِنچؠ ضرورت، یتھٕ پٲٹھؠ زن اکھ دورن وول دوِ دوران ساروے کھوٚتہٕ سیٚزِ وتہِ پیٚٹھ دورنس کُن توجہ چُھ دِوان۔ تمہِ طریقہٕ، کانٛہہ اکھ تہِ یُس روحٲنی طور کمزور آسہِ کرِ نہٕ خدایس پیٚٹھ بھروسہٕ کرنس روٚٹ مگر تمہِ بدلہٕ کرِ سُہ تمس پیٚٹھ زیادے پہن بھروسہٕ\f + \fr 12‏:13 \ft امثال 4:26\f*۔
\v 14 توٚہہِ پزِ پریتھ أکس سٟتؠ امنہٕ سان زندگی گزارٕنؠ تلاش کرنؠ۔ توٚہہِ پزِ پنُن پان خداے سنٛدِ خٲطرٕ الگ کرُن تہِ تلاش کرُن۔ ہرگاہ توٚہؠ صرف تہِ کریو توٚہؠ وٲتِو ٲخرس خداوندس نِش\f + \fr 12‏:14 \ft 1پطرس 3:11، مزامیر 34:14\f*۔
\v 15 یقینی بنٲیو زِ تُہنٛدین ایمان باجیٚن واتہِ تہِ سورےٕ یہِ خداین توٚہہِ دیُتمُت چُھ۔ کٲنٛسہِ تہِ نِش روزیو ہوشیار یُس ایمان باجیٚن ناراضگی سان برتاو کرُن شروع کرِ بییٚہِ ایمان والیٚن پریشان کرِ۔ امہِ سٟتؠ ہیکن واریاہ باقی ایمان وٲلؠ تہِ یتھۓ پٲٹھؠ برتاو کرنس پیٚٹھ مجبوٗر گژھتھ\f + \fr 12‏:15 \ft 2 یوحناؔ 1:8، تثنِیہ شرع 29:18\f*۔
\v 16 ہُشیار روزیو تِمن لوٗکن نِش یِم ناسہٕ تراسہٕ جنسی عمل کرن چھِ یا پانس چھِنہٕ خداے سنٛدِ خٲطرٕ الگ کران۔ یِم لوٗکھ چھِ عیسوؔ سنٛدؠ پٲٹھؠ، یمؠ پننِس لۅکٹِس بٲیس یعقوبسؔ یہِ اجازت دِیُت زِ سُہ کرِ گوٚڈٕ زامتِس بچہِ سنٛدؠ پٲٹھؠ عمل یُتھ زن تس نِش کینٛہہ کھیٚن پراوِ\f + \fr 12‏:16 \ft پیدٲیش 25:33۔ 34، کولوسین 3:5\f*۔
\v 17 توٚہہِ پزِ نہٕ عیسوؔ ہس ہیوے بنُن، تکیازِ توٚہہِ سپدِ احساس زِ پتہٕ کیا سپد تس۔ تمؠ یژھاو زِ پنُن مۅل دِیہِ تس برکت، مگر تمؠ سنٛدؠ مٲلؠ کوٚر تہ کرنس انکار۔ یتھٕ پٲٹھؠ توٚہؠ ہیٚکِو وُچھِتھ، عیسوہنؔ ہیٚچ نہٕ تتھ منٛز تبدیلی انتھ یہِ تمؠ کوٚرمُت اوس، ہتاکہ ییٚلہِ تمؠ تبدیلی اننچہِ کوششہِ دوران ودُن تہِ ہیوٚت\f + \fr 12‏:17 \ft پیدٲیش 27:30 40\f*۔
\v 18 أسؠ چھِنہٕ تتھ نکھٕ گٔمٕتؠ یتھ اسرائیلی تمہِ ساعتہٕ نکھٕ گےَ ییٚلہِ تِم کوہِ سیناہس پیٚٹھ وٲتؠ۔ تِم گےَ أکس تِتھس پہاڑس نزدیک یُس تِمو پننیٚو اتھو سٟتؠ محسوس کرِتھ ہیوٚک۔ تِمو وُچھ نارٕ لمبکھ، کالہٕ اوٚبر، ژھاے بیٚیہِ اکھ طوفان\f + \fr 12‏:18 \ft خروج 10:21۔ 22، 19:12۔ 22، 20:18۔ 21، تثنِیہ شرع 4:11۔ 12، 5:22۔ 27\f*۔
\v 19 تِمو وُچھ کُستام اکھ ترے وایان تہٕ خداے اوس اکھ پٲغام دِوان۔ ییٚلہِ تِمو خداے کتھ کران بوٗز، تِمو کوٚر تس درخواست زِ سُہ وننہِ نہٕ تِمن امہِ علاوٕ کینٛہہ۔ \f + \fr 12‏:19 \ft خروج 20:18۔ 21، تثنِیہ شرع 5:23۔ 25\f*
\v 20 تِمو کوٚر تہِ، تکیازِ تِمن ٲسؠ کھوٚژن ییٚلہِ خداے تِمن حکم دِوان اوس، "توٚہہِ پزن تِم سٲری لوٗکھ تہٕ جانور مارنؠ یِم یتھ پہاڑس اتھٕ لاگن۔ توٚہہِ پزن تِم کنہِ لٲیتھ مارنؠ"\f + \fr 12‏:20 \ft خروج 19:12۔ 13، تثنِیہ شرع 5:23۔ 25\f*
\v 21 مزید، ییٚلہِ موسیٰ ہن وُچھ ہرکانٛہہ چیز کوتاہ خوف ناک اوس، تکیازِ یہُوواہؔ اوس تِمن پٮ۪ٹھ ناراض سپُدمُت۔  تمؠ وون، "مےٚ چھِ تھتھراے ووٚتھان تکیازِ بہٕ چُھس کھوٚژان!"\f + \fr 12‏:21 \ft تثنِیہ شرع 9:19\f*
\v 22 اتھ برعکس، توٚہؠ چھُو أکس آسمٲنی جایہِ صیون پہاڑس نزدیک گٔمٕتؠ۔ یتھ پہاڑس پیٚٹھ چُھ آسمٲنی شہر یروشلم یُس صرف أکس اصلی خداے سُنٛد چُھ۔ تتھ شہرس منٛز چھِ واریاہ روحٲنی وجود یِم یکوٹے شٲدیانہٕ مناوان چھِ۔
\v 23 بییٚہِ چھِ تتھ شہرس منٛز تِمن ہندؠ ناو یِم خداین آسمانس پیٚٹھ درج کرؠ مٕتؠ چِھ۔ تِم چھِ خداے سنٛدؠ لوٗکھ، تمؠ سنٛدؠ خاص شُرؠ۔ بییٚہِ چُھ تتہِ خداے، سُہ یُس سارنے لوٗکن ہندؠ فٲصلہٕ چُھ کران زِ کُس چُھ قصوروار یا کُس چُھ بے گناہ۔ تتہِ چھِ تِم تہِ یِمو خدایس فرمانبردٲری کٔر۔ تِم مودؠ، مگر خداین چھِ وونؠ تِم بنٲومٕتؠ یِم سُہ یژھان چُھ۔ \f + \fr 12‏:23 \ft مزامیر 50:6، کولوسین 1:12\f*
\v 24 بییٚہِ چُھ تتھ شہرس منٛز یسوع، یمؠ سنٛدؠ ذریعہٕ خداین اکھ نوو عہد نامہٕ بنوومُت چُھ۔ تتہِ چُھ بییٚہِ یسوع سُنٛد خوٗن، یُس اسہِ پاک بناون چُھ۔ تمؠ سُنٛد خوٗن چُھ ہابلؔ سنٛدِ خوٗنہٕ کھوٚتہٕ زیادٕ اثردار۔
\v 25 یقینی بنٲیو زٕ توٚہؠ کریو خداے سٕنٛز فرمانبردٲری، یُس توٚہہِ سٟتؠ کلام کران چُھ۔ غور کریو زِ کتھٕ کِنؠ کوٚر نہٕ کینٛژو اسرائیلیو تتھ فرمانبردٲری یہِ خداین سینا پہاڑٕ پیٚٹھ تِمن پیٚٹھ ظٲہر کوٚر۔ خداین دِیُت تِمن یقیٖنن سزا۔ وونؠ کریو غور زِ خداے کوتاہ دِیہِ اسہِ منٛز کٲنٛسہِ أکس سزا یُس نہٕ تتھ فرمانبردٲری کرِ یہِ تمؠ اسہِ سینا پہاڑٕ پیٚٹھ طٲہِر کوٚر۔
\v 26 ییٚلہِ خداین سینا پہاڑٕ پیٚٹھ کتھ کٔر، امہِ سٟتؠ سپُد زمیٖنس زلزل۔ اما پوٚز، تمہِ وزِ کوٚر تمؠ وعدٕ، "بہٕ کرٕ زلزل زمیٖن بییٚہِ آسمان تہِ"\f + \fr 12‏:26 \ft حجٲیی 2:6، قٲضی 5:4، مزامیر 68:8\f*
\v 27 الفاظ "بییٚہِ اکہِ لٹہِ" مطلب چُھ زِ خداے بدلاوِ سُہ ہر کانٛہہ چیز یُس سُہ ہلاون چُھ۔ سُہ کرِ تہِ یتھٕ پٲٹھؠ تمؠ یِم سٲری چیز پٲدٕ کٔرؠ۔ تمہِ طریقہٕ، پریتھ کانٛہہ چیز یُس نہٕ سُہ ہلاون چُھ سُہ روزِ ہمیشہِ خٲطرٕ۔ \f + \fr 12‏:27 \ft حجٲیی 2:6\f*
\v 28 لہٰذا، أسؠ روزو تتھ بادشٲہی منٛز یتھ نہٕ خداے ہلاوِ۔ توے پزِ اسہِ خداے سٕنٛز شُکر گُزٲری کرنؠ۔ تہِ کرنہٕ سٟتؠ، أسؠ کرو عزتہٕ سان خداے سٕنٛز اکہِ طریقہٕ عبادت یمہِ سٟتؠ سُہ خۅش سُپدِ۔
\v 29 اسہِ پزِ تہِ احترام سان کرُن، تکیازِ یمِس خدایس أسؠ عبادت کران چھِ سُہ چُھ یوٚتاہ طاقتور تہٕ خطرناک یوٚتاہ اکھ سوٗر کران وول نار چُھ۔ \f + \fr 12‏:29 \ft تثنِیہ شرع 4:24، 9:3، یسعیاہؔ 33:14\f*
\c 13
\p
\v 1 پننؠن سٲتھی ایماندارن سٟتؠ تھٲیو لول برُن جٲری۔
\v 2 یقینی بنٲیو زِ توٚہؠ چھُو باقین لوٗکن خۅش آوے کران۔ توٚہہِ پزِ تہِ کرُن تکیازِ کینٛژو لوٗکو یِمو باقین خۅش آوے کٔر اصلی کٔر تِمو روحٲنی وجودن خۅش آوے، اگرچہ تِمن مولوم اوس نہٕ زِ تِم ٲسؠ روحٲنی وجود\f + \fr 13‏:2 \ft 1پطرس 4:9، پیدٲیش 18:1۔ 19:3\f*۔
\v 3 تِمن ہُند مدد کرُن بنٲیو یقینی یِم جیلن منٛز چھِ۔ توٚہہِ پزِ تِمن مدد کرُن یتھٕ پٲٹھؠ توٚہؠ باقین ہُند توٚہہِ مدد کرنہِ یژھان چھُو ہرگاہ توٚہؠ تِمن سٟتؠ جیٖلس منٛز ٲسہِ ہیوو۔ بییٚہِ یتھنہٕ تِمن مدد کرُن مشرٲیو یِمن سٟتؠ باقی بدسلوکی کران چھِ۔ توٚہہِ پزِ تہِ کرُن تکیازِ توٚہؠ تہِ چھُو انسان یِم تکلیف ہیکہِ وٲتِتھ۔
\v 4 توٚہہِ سارنے پزِ واریاہ قدر کرنؠ زِ خداے کتھٕ کِنؠ چُھ لوٗکن یکوٹہٕ رلاوان ییٚلہِ تِم خاندر کران چھِ۔ مزید، خاندر کرن والیٚن لوٗکن پزِ صرف پننؠنے بٲژن سٟتؠ جنسی تعلقات تھاونؠ۔ توٚہہِ پزن یِم کامہِ کرنہِ تکیازِ خداے ٹھہراوِ تمس أکس قصوروار یُس أکس خاندرٕ وٲلِس شخصس سٟتؠ جنسی تعلق بناوِ یا یُس کُنہِ تہِ طریقہٕ ناجٲیز جنسی تعلقات تھاوِ۔
\v 5 توٚہہِ پزِ ہمیشہ پونٛسن ہنٛزِ خوٲہِشہٕ نِش دوٗر روزُن۔ توٚہؠ ہیکیو تہِ خۅش روزنہٕ خٲطرٕ کرِتھ یہِ توٚہہِ نِش چُھ۔ توٚہہِ پزِ یمہِ طریقہٕ سلوک کرُن تکیازِ خداین چھِ یِمن الفاظن منٛز تُہندِ خٲطرِ فرموومُت: " بہٕ تراوَو نہٕ توٚہؠ زانٛہہ۔ ہاں، بہٕ روٗزٕ توٚہہِ سٟتؠ ہمیشہِ\f + \fr 13‏:5 \ft مزامیر 37:25، تثنِیہ شرع 31:8، یشوع 1:5\f*"
\v 6 تکیازِ خداے چُھ تہِ ونان، أسؠ چھِ یِم الفاظ دلیری سان ونان: " خداوند خداے چُھ سُہ کُنے یُس اسہِ مدد گار چُھ۔ توے، بہٕ چُھس نہٕ کٲنسہِ تہِ کھوٚژان۔ کانٛہہ اکھ تہِ ہیکہِ نہٕ مےٚ زکھ واتناونہٕ خٲطرٕ کینٛہہ کٔرتھ\f + \fr 13‏:6 \ft مزامیر 118:6، 27:1\f*"
\v 7 تِمن لوٗکن کُن دیو توجہ یِم تُہنٛزِ جمٲژ ہندؠ پیشوا ٲسؠ۔ میون مطلب چُھ تِم یِمو توٚہہِ وون زِ خداین کیا چُھ کوٚرمُت۔ اصل چیزن ہُند معاینہٕ کریو یِم واقع سپدؠ تِم کمہِ سببہٕ کِنؠ روٗدؠ زندٕ۔ توٚہہِ پزِ نقل کرُن زِ تِمو کتھٕ پٲٹھؠ کوٚر خدایس پیٚٹھ بھروسہٕ۔
\v 8 یسوع مسیحؔ چُھنہٕ زانٛہہ بدلیومُت تہٕ نہٕ بدلہِ زانٛہہ\f + \fr 13‏:8 \ft مزامیر 90:2، مُکاشفہ 1:8، یسعیاہؔ 41:4\f*"
\v 9 توٚہؠ مہٕ دِیو باقین لوٗکن واریاہ قسمٕکؠ چیز ہیٚچھناونہٕ سٟتؠ پان گمراہ کرنہٕ یِم نہٕ رٔژِ شیچھِ سٟتؠ واٹھ کھیٚوان چھِ۔ توٚہہِ پزِ تہِ رد کرُن یہِ تِم ہیٚچھناون چھِ، تکیازِ یہِ صرف خداے اسہِ اصل پٲٹھؠ دِوان چُھ سُہ چُھ اسہِ مضبوط بناوان۔ غذا یُس أسؠ کھیٚوان چھِ ہیٚکہٕ نہٕ تہِ کرِتھ۔ درحقیقت، یِم لوٗکھ یتھٕ پٲٹھؠ عمل کران زِ خٲرٲتی کھیٚن ہیکہِ یہِ کرِتھ، تِمن چُھنہٕ کینٛہہ حٲصل کران۔
\v 10 اسہِ چُھ یسوع سنٛزِ قربٲنی سٟتؠ فٲیدٕ میلان، یوسہٕ تِمو قربٲنیو کھوٚتہٕ عظیٖم چھے یِم کاہنو مقدس خٟمس اندر پیش کرِ۔ درحقیقت، تِم کاہن ہیکن نہٕ یسوع سنٛزِ قربٲنی منٛز شراکت کرنس قٲبل سپدیتھ۔
\v 11 سؠٹھاہ پاک جایہِ منٛز اوس حکمران کاہن جانورن ہندٮ۪ن جسمن ہُند خوٗن پیش کران یِم تمؠ مٲرؠ مٕتؠ ٲسؠ۔ سُہ اوس تہِ گناہ دوٗر کرنہٕ باپتھ کران۔ پتہٕ اوس کانٛہہ تِمن جانورن ہندین باقےٕ چیزن مکمل پٲٹھؠ تمہِ جایہِ نِش دوٗر زالان ییٚتین اسرٲییٔلی روزان ٲسؠ۔
\v 12 لہٰذا مود یسوع تہِ مود یروشلم شہرس منٛز تمہِ جایہِ نِش دوٗر ییٚتہِ لوٗکھ روزان ٲسؠ۔ تمؠ کوٚر یہِ پنُن خوٗن پیش کرنہٕ دسؠ خداے سٕنٛدؠ لوٗکھ پننہِ خٲطرٕ الگ کڈنہٕ باپتھ۔
\v 13 تمہِ پتہٕ، پزِ اسہِ سُہ پریتھ کانٛہہ چیز تراون یُس اسہِ مسیحسؔ نِش الگ ہیکہِ کرِتھ۔ یتھٕ پٲٹھؠ أسؠ تہِ چھِ کران، اسہِ پزِ یہِ قبول کرُن ییٚلہِ لوٗکھ اسہِ بے عزتی کران چھِ یتھٕ پٲٹھؠ تِمس تِمو بے عزتی کٔر\f + \fr 13‏:13 \ft لوقا 6:22\f*"
\v 14 اسہِ پزِ تہِ کرُن تکیازِ، یتھ زمیٖنہِ پیٚٹھ چِھنہٕ أسؠ أکس تتھِس شہرس منٛز روزان یُس ہمیشہِ خٲطرٕ باقے روزِ۔ بلکہ، اسہِ چھِ تتھ شہرس منٛز زندگی گزارنٕچ خوٲہِش یُس خداے اسہِ جلدے عطا کرِ۔
\v 15 یسوع سنٛدِ مددتہٕ سٟتؠ پزِن اسہِ خداے سنٛدؠ تعریف اکثر کرنؠ، زن تہِ آسو أسؠ تس نیاز پیش کران۔ تہِ چھِ أسؠ کران ییٚلہِ أسؠ ونان چھِ زِ اسہِ چُھ یسوعس پیٚٹھ ایمان\f + \fr 13‏:15 \ft مزامیر 50:14، 5:23، ہوشیع 14:2\f*"
\v 16 مزید، اسہِ چھِ یہِ کتھ یقینی بناونچ ضرورت زِ أسؠ کرو باقین پننہِ منٛز تِمن کینٛہہ دِتھ مدد۔ یہِ کرُن چُھ خداے خۅش کرن واجنہِ قربٲنی پیش کرنس ہیو۔
\v 17 تُہنٛزن جمٲژن ہندؠ پیشوا چھِ زانان زِ خداے چُھ تِمن تُہنٛدِ خٲطرٕ ذمہٕ دار ٹھہراوان، تہٕ تِم چھِ ہمیشہِ تُہنٛز رٲچھ کرنس کُن توجہ دِوان۔ تمی وجہ کِنؠ، پزِ توٚہہِ عزتہٕ سان تہِ کران یمیُک تِم تقاضہٕ کران۔ تمی طریقہٕ، ہیکن تِم تُہنٛزِ جمٲژ ہنٛز راہنمٲییٔ مایوسی بجایہ خۅشی سان کرِتھ۔ بے شک، ہرگاہ تِم مایوسی سان رہبری کران روزن، تمہِ سٟتؠ سپدِ نہٕ توٚہہِ ہرگز کانٛہہ مدد\f + \fr 13‏:17 \ft 1تھسلونینؔ 5:12۔ 13، مُکاشفہ 20:28\f*"
\v 18 مہربٲنی کرِتھ منٛگِو خدایس مےٚ تہ میانؠن سٲتھین مدد کرنہٕ باپتھ دعا۔ بہٕ چُھس پرژھان یہِ تکیازِ اسہِ چُھ یقین زِ أسؠ چھِنہٕ قصوروار۔ بے شک، أسؠ چھِ ہمیشہِ یژھان صحیح پٲٹھؠ سلوک کرُن۔
\v 19 بہٕ چُھس توٚہہِ تلقین کران زِ خدایس منٛگِو مےٚ سوزِ جلدی سان توٚہہِ نِش واپس۔
\v 20 خداے چُھ سُہ کُنے یُس پنہٕ نؠن لوٗکن پُر امن بناوان چُھ۔ تمؠ کوٚر سون خداوند یسوع مرنہٕ پتہٕ دُبارٕ زندٕ۔ یسوع چُھ أکس طاقتور پہلؠ سنٛدؠ پٲٹھؠ یُس اسہِ تمؠ سٕندٮ۪ن تیٖرن راہنمٲییٔ کران چُھ۔ خداین کوٚر سُہ دُبارٕ زندٕ تکیازِ یسوعن کوٚر پنُن ذٲتی خوٗن نوو عہد نامہٕ بناونہٕ خٲطرٕ استعمال یُس ہمیشہِ خٲطرٕ باقے روزِ\f + \fr 13‏:20 \ft یوحناؔ 10:11، عملہٕ 2:24، رومین 15:33\f*۔
\v 21 أسؠ چھِ دعا منٛگان زِ خداے دِیہِ توٚہہِ تمسنٛدؠ سٲری رٕتؠ تحفہٕ۔ امہِ طریقہٕ، ہیکیو توٚہؠ، تہِ کرِتھ یہِ سُہ توٚہہِ کرناون یژھان چُھ۔ در حقیقت، سُہ چُھ یسوع مسیحؔ سنٛدِ ذریعہٕ قٲیم کران اسہِ تہِ قٲبل بناونہٕ خٲطرٕ یمہِ سٟتؠ سُہ خۅش سپدِ۔ لہٰذا، أسؠ کرو خدایس ہمیشہِ احترام! آمین!
\v 22 مےٚ سوزُو توٚہہِ اکھ مختصر خط۔ لہٰذا، ہم ایمان سٲتھیٚو، بہٕ چُھس توٚہہِ گذٲرش کران زِ تتھ پیٚٹھ کریو ہوشہِ سان غوٗر یہِ مےٚ توٚہہِ حوصلہٕ افزٲئی خٲطرٕ وونمُت چُھ۔
\v 23 بہٕ چُھس یژھان توٚہؠ باخبر کرِنؠ زِ حٲکمو چُھ سون ایمان بوج تیمُتھیس رہا کوٚرمُت۔ ہرگاہ سُہ جلدی سان یوٗر واتہِ، أسؠ سمکھو توٚہہِ یکوٹے۔
\v 24 تس پریتھ أکس ونیو سلام یُس تُہنٛزِ جمٲژ ہُند پیشوا چُھ۔ بییٚہِ ونیوو خداے سٕندٮ۪ن سارنے لوٗکن سلام۔ ملکِ اٹلی پؠٹھِ ایمان وٲلؠ چھِ توٚہہِ سلام عرض کران۔
\v 25 بہٕ چُھس دعا کران زِ خداے سُنٛد فضل روٗزِن توٚہہِ سارنے سٟتؠ۔
