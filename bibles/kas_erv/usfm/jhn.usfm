\id JHN - DMT Kashmiri
\toc1 یوحنا
\mt1 یوحنا
\c 1
\p
\v 1 پرٮ۪تھ وۅپدٲیشہٕ برونٛہہ اوس کلام تہٕ کلام اوس خدایس سٟتؠ۔ کلامےٕ اوس خدا۔
\v 2 تہٕ کلام اوس خدایس سٟتؠ، کایناتچہِ پیدایشہٕ برونٛہہ تہِ۔
\v 3 پرٮ۪تھ کانٛہہ چیز اوٚن خداین بارسس امی کلامہٕ سٟتؠ۔ یہِ کینٛہہ تہِ ظہوٗرس آو تہِ آو بس امی کلامہٕ سٟتؠ۔
\v 4 کلام چُھ دِوان پوشوٕنؠ زندگی، تہٕ سۅ پوشہِ ونؠ زندگی چھِ خدایہِ سُنٛد رُت تہٕ پوٚز گاش یُس تمؠ انسانس پؠٹھ ظٲہر کوٚر۔
\v 5 خداین کور پنن رُت تہٕ پوٚز گاش کۅکار دنیہس پؠٹھ ظٲہر تہٕ تمؠ بدکار دنیاہن کور نہٕ سُہ قبول۔
\v 6 خداین سوز یوحناؔ ناوُک اکھ شخص یُس بپتسمہ دِنہٕ وٲلؠ سنٛدِ رنگؠ زاننہٕ آو۔
\v 7 سُہ آو لوٗکن منٛز اعلان کرنہِ زِ یسوعؔ چُھ نور۔ سُہ آو امہِ نورچ گوٲہی دِنہِ یہِ گوٲہی زِ سُہ چُھ نور أمؠ کوٚر یہِ واشگاف اعلان زِ أمؠ سنٛز گوٲہی پٮ۪ٹھ کرن لوٗکھ پژھ تہٕ یقین۔
\v 8 یوحنا اوسنہٕ پانہٕ سُہ نور مگر سُہ آو لوٗکن اتھ نورس متعلق وننہٕ باپتھ۔
\v 9 پوٚز گاش اوس یسوعؔ یمؠ خدایہِ سُنٛد پزر تہٕ خٲر پرٮ۪تھ کٲنٛسہِ پٮ۪ٹھ ظٲہِر کوٚر۔ سُہ اوس سُہ گاش یُس دُنیاہس منٛز پرٮ۪زلوُن اوس۔
\v 10 کلام اوس دُنیاہس منٛز تہٕ تمؠ کور کاینات پٲدٕ۔ مگر دُنیہکیٚو لوکو پرٮ۪زنوو نہٕ سُہ۔
\v 11 کلام ووت تٔمؠ سنٛدٮ۪ن پننٮ۪ن لوٗکن یعنی یہُودینؔ تام مگر تِمو کوٚر تمس انکار۔
\v 12 وۅنؠ گو یِمو سُہ قبوٗل کوٚر تہٕ تس پٮ۪ٹھ پژھ کٔر تمن دیُت تٔمؠ خدایہِ سٕنٛدؠ اولاد آسنُک شرف۔
\v 13 یِم خدایہِ سنٛدؠ اولاد گےَ نہٕ پٲدٕ روحٲنی طور عام انسٲنی طریقو یا انسٲنؠ نفسٲنی خٲہشو کِنؠ تہٕ نَہ پننٮ۪و مالیٚو ہنٛدِ اِرادٕ۔ یِم آے خدایہِ سٕنٛدِ یژھنہٕ روحٲنی طور وجودس۔
\v 14 کلام بنیٚوو اکھ حقیقی انسان تہٕ بسیوو عارضی پٲٹھؠ ییٚتی ییٚتہِ أسؠ روزان چھِ جلالہٕ بھرژ قۅدرت ظٲہر سپدان۔ یعنے تمس لاثٲنی گۅبرٕ سنٛز جلالہٕ بھرٕژ قۅدرت یوس ببہٕ سنٛدِ پؠٹھٕ آو۔ سُہ چُھ پورٕ پٲٹھؠ خدایہِ سنزن رحمدلی ہنٛزن عملن تہٕ پزن تعلیمن ہُند مٲلکھ۔
\v 15 یوحنا ہن دِژ امؠ سنٛز گوٲہی۔ بپتسمہ دِنہٕ وٲلؠ یوحناؔہن ووٚن أمِس متعلق لوٗکن کرٮ۪کھ لٲیِتھ، "مےٚ ونُو توٚہہِ گۅڈَے زِ مےٚ پتہٕ چُھ سُہ یِنہٕ وول۔ سُہ یُس میانہِ کھۅتہٕ افضل چُھ تکیازِ سُہ اوس واریاہ کال ہؠتھ مےٚ برونٹھی موجود۔"
\v 16 اسہِ چُھ معلوم زِ کلامہٕ چُھ پوٗرٕ پٲٹھؠ خدایہِ سنزن رحمدلی ہنٛزن عملن تہٕ پزن تعلیمن ہُند مٲلکھ تکیازِ اسہِ چُھ اکہِ پتہ اکہِ تمؠ سنزن رحمدل کامؠن ہُند فٲیدٕ تُلمُت یمیُک سُہ پورٕ مٲلکھ چُھ۔
\v 17 خداین سوز یہِ شریعت یِم قانون اسرائیلی لوٗکن پٮ۪ٹھ موسیٰؔ سٕنٛدؠ دٔسؠ۔ مگر یہُنٛد فضل تہٕ پزر ووت یسوعؔ مسیحؔ سٕنٛدؠ برکتہٕ۔
\v 18 خدا وُچھ نہٕ زہنٛؠ کٲنٛسہِ مگر یسوعؔ چُھ بےمثل تہٕ پانہٕ خدا۔ سُہ چُھ بب خدایس نکھہٕ تہٕ تمؠ چُھ پٲنؠ پانہٕ بب ظٲہر کوٚرمُت۔
\v 19 بپتسمہ دِنہٕ وٲلؠ یوحناؔہن دِژ امچی گوٲہی ییٚلہِ یہُودؠ زِٹھیٚو تمِس نِش یروشلم پٮ۪ٹھٕ کینٛہہ کاہن تہٕ لاوی یہِ پرژھنہِ سوزؠ۔ ژٕ کُس چُھکھ؟
\v 20 امہِ وزِ ونُکھ یوحناؔہن کھوٚر ٹھُکرٲوِتھ "بہٕ چُھس نہٕ مسیحؔ"
\v 21 پتہٕ پرُژھہس "یوٚدوے یی پزر چُھ تیٚلہِ کُس ژٕ؟ ژٕ چُھکھا ایلیا" تورٕ ووٚننکھ، "نَہ، بلکل نہٕ" امہِ پتہٕ پرُژھہس، "ژٕ چُھکھا تیٚلہِ رسول یُس زن خدایہِ سٕنٛدِ وننہٕ کِنؠ یِنہٕ وول چُھ یوحناؔہن ووننکھ "نَہ"
\v 22 لہٰذا پرُژھ یِمو کاہنو تہٕ ٲوؠ یو اکہ پھرِ بیٚیہِ یوحناہسؔ اسہِ ون تیٚلہِ کُس چُھکھ۔ تاکہِ چون جواب واتناوو أسؠ تِمن زِٹھٮ۪ن یِمو أسؠ ژےٚ نِش سوزؠ۔ پانس متعلق کیاہ دعوا چُھکھ ژٕ کران۔
\v 23 یوحناؔہن ووننکھ بہٕ چُھس یِمن بیابانن منٛز تُرَے دِنہٕ وول تاکہِ توٚہؠ کٔریٚو پنُن پان تیار تس خداوند سنٛزِ خوش آوے باپتھ ییٚلہِ سُہ ییہِ۔ بہٕ چُھس سُہ یمِس متعلق یسعیاہؔ نبین پیش گوییٔ کرمٕژ چھِ۔\f + \fr 1‏:23 \ft یسعیاہؔ 40۔3\f*
\v 24 یِم کاہن تہٕ لاوی یِم یروشلمسؔ منٛز بہتھ زِٹھٮ۪و سوزؠ مٕتؠ ٲسؠ تِم ٲسؠ فریسی۔
\v 25 یِمو پرُژھ أمِس مزید، "یوٚدوے ژٕ نَہ چُھکھ مسیحؔ تہٕ نہ ایلیا تہٕ نہٕ رسول تیٚلہِ کیازِ چُھکھ ژٕ لوٗکن بپتسمہ دوان"
\v 26 یوحناؔ وتھُکھ در جواب، "بہٕ چُھس لوٗکن آبہٕ سٟتؠ بپتسمہ دِوان۔ مگر وۅنؠ چُھ توٚہہِ منٛزٕ کُستام یُس نہٕ توٚہؠ زٲنہِ ہون۔
\v 27 سُہ چُھ مےٚ پتہٕ ینہٕ وول پوٚز بہٕ چُھس نہٕ تمِؠ سنٛز کھۅربانہٕ وۅتھراونس لایق تہِ۔
\v 28 یِم واقات سپدؠ دریایہِ یردنس اپارِ مشرقہٕ طرفہٕ بیت عینیاہ گامس منٛز۔ یہِ چھِ سۅ جاے یتہِ یوحناؔ لوٗکن بپتسمہ دِوان اوس۔
\v 29 امہِ واقہٕ سپدنہٕ پتہٕ بیٚیہِ دوٚہہ وُچھ یوحناؔہن یسوعؔ تمس کُن یوان۔ ادٕ ووٚن تمؠ لوٗکن کُن، وُچھِو! خدایہِ سُنٛد برٕ کٹہٕ مونگُر۔ لوٗکن ہنٛدؠ گناہ بخشنہٕ باپتھ کرِ یہِ پنُن پان قربان تٔتھؠ دنیاہس منٛز۔\f + \fr 1‏:29 \ft 1 پطرس 1:19، یسعیاہؔ53:7 \f*
\v 30 امؠ سےٕ متعلق اوسسو بہٕ ونان، "سُہ ییہِ مےٚ پتہٕ تہٕ سُے آسہ میانہِ کھۅتہٕ افضل تہٕ اہم تکیازِ سُہ اوس مےٚ برونٛہہ۔
\v 31 بہٕ اوسُن نہٕ زانان گۅڈٕ زِ سُہ کُس چُھ۔ بہرحال مےٚ تھوو آبہٕ سٟتؠ بپتسمہ دیُن جٲری چھرا اوٕ کِنؠ زِ سُہ سپدِ اسرائیل ین پٮ۪ٹھ ظٲہِر۔
\v 32 یوحناؔہن دِژ سٲرؠ سےٕ تُرَے، "مےٚ وُچھ دیدمان خدایہِ سٕنٛدِ طرفہٕ روح أکِس کوتُر سنٛزِ شکلہِ آسمانہٕ وسان تہٕ یہِ روح بیوٹھ یسوعسؔ پٮ۪ٹھ۔
\v 33 گۅڈٕ گۅڈٕ زون نہٕ مےٚ سُہ۔ مگر خداین سوزُس بہٕ آبہٕ سٟتؠ لوٗکن بپتسمہ دِنہِ تہٕ ووننم، "سُہ شخص یمِس پٮ۪ٹھ میون روح وسہِ تہٕ لبہِ قرار دِیہ لوٗکن پاک روح سٟتؠ بپتسمہ۔
\v 34 مےٚ وُچھ یہِ دیدمان تہٕ بہٕ چُھس توٚہہِ بڈِ ہَٹہِ ونان زِ یہِ شخص یسوعؔ چُھ خدایہِ سُنٛد گۅبُر۔
\v 35 امہِ واقہٕ پتہٕ بیٚیہِ دوٚہہ بپتسمہ دِنہٕ وول یوحنا اوس پننٮ۪ن بیٚین دوٚن شٲگردن سٟتؠ۔
\v 36 ییٚلہِ تٔمؠ یسوعؔ وُچھ انٛدؠ پٔکؠ پکان تٔمؠ ووٚن، "وُچھِو یوٚہے چُھ خدایہِ سُنٛد کٹہٕ مونگُر
\v 37 جان سنٛدیو یِمو دوٚیو شاگردو بوز جان سُنٛد ونُن تہٕ لٔگؠ یسوعسؔ پتہٕ پتہٕ پکنہِ۔
\v 38 ییٚلہِ یسوعنؔ پوٚت پھیرِتھ یِمہٕ پتہٕ پتہٕ پکان وُچھ، تٔمؠ پرژھُکھ، "توٚہؠ کیا ژھاران؟" تِمو ووٚنُس تورٕ، "ربی آرمنی زبٲنؠ منٛز اُستاد توٚہؠ کتہِ قرار کٔرِتھ۔
\v 39 تٔمؠ وونُکھ، "ؤلِو پٔکِو مےٚ سٟتؠ تہِ وُچھِو" لہٰذا آیہِ تِم أمِس پتہٕ پتہٕ تہٕ وُچُھکھ یسوعؔ کتہِ اوس ٹھٔہرِتھ۔ امہِ دوٚہہ رودؠ تِم أمسےٕ سٟتؠ تکیازِ دوٚہہ اوس درس لوٚگمُت وق اوس ژیر گوٚمُت یہِ آسہ ہا ژور بجے شام ہیٚو۔
\v 40 یوحناؔ سنٛز کتھ بوزن والیٚن یِمن دوٚن شٲگردن منٛز اوس اکھ اندریاسؔ یُس یسوعس پتہٕ پتہٕ پکان اوس۔ سُہ اوس شمعون پطرس سُنٛد لۅکُٹ بوے۔
\v 41 اندریاسن اوٚن گۅڈٕ پنُن بوے شمعون ژھٲرِتھ تہٕ ووننس، "اسہِ لوٚب مسیحؔ گو!" مسیحؔ چُھ یونٲنؠ زبٲنؠ منٛز "کرایسٹ۔"
\v 42 اندریاسن اون شمعون یسوعس نِش۔ ییٚلہِ یسوعن پطرس وُچھ تٔمؠ ووٚنُس، "ژٕ چُھکھ شمعون۔ چٲنِس مٲلؠ سُنٛد ناو چُھ یوحناؔ۔ یمہِ یوکُن آسہ چون ناو کیفس تہِ۔ "کیفس" چُھ اکھ آرٲمی لفظ۔"پطرس" چُھ یونٲنؠ تہٕ دوشوٕنؠ ہُنٛد معنہِ چُھ "کنہِ پل۔"
\v 43 امہِ واقہٕ پتہٕ بیٚیہِ دوٚہہ کوٚر یسوعنؔ فٲصلہٕ یہِ جاے تراونُک۔ سُہ گو گلیلی ہنٛدِس علاقس منٛز تہٕ لوٚبُن اتہِ فلپسؔ ناوُک اکھ شخص۔ یسوعنؔ ووٚن أمِس، "پکھ بن میون شٲگرد۔"
\v 44 فلپس اوس بیت صیدا گلیلی ہنٛدِ شہرُک۔ اندریاسؔ تہٕ پطرس تہِ ٲسؠ امے شہرٕکؠ۔
\v 45 پتہٕ دراو فلپس تہٕ اوٚنُن نتن ایل ژھٲرِتھ۔ ییٚلہِ سُہ أمِس نِش ووت تہٕ فلپسن ووٚن أمِس، "اسہِ لوٚب مسیحؔ۔ یمِس متعلق موسیٰؔ ہنؔ پننہِ شریعتہٕ چہِ کتابہِ منٛز لیٚوکھمُت چُھ۔ یۅسہ خداین اسرائیل ین سوز تہٕ یمِس متعلق نبیو ووٚن زِ سُہ چُھ یِنہٕ وول۔\f + \fr 1‏:45 \ft متی 21:11\f* سویٔ مسیحؔ چُھ یسوعؔ۔ امؠ سٕنٛدِس مٲلؠ سُنٛد ناو چُھ یوسف۔ سُہ چُھ ناصرت قصبُک روزن وول۔"
\v 46 نتن ایلن ووٚنُس یورٕ، "ناصرت پٮ۪ٹھ؟ "امہِ جایہِ پٮ۪ٹھٕ کۅسہٕ امید چھےٚ رٕژرچ" فلپس وتھُس یورٕ، "پکھ تہٕ وُچھ پانے!"
\v 47 ییٚلہِ یسوعنؔ نتن ایلؔ پانس کُن پکان وُچھ۔ تٔمؠ وونُس، "وُچھِو یہِ گو اکھ ایماندار اسرائیلی۔ یہِ دِیہ نہٕ زانہٛہ کٲنٛسہِ دھوکھہٕ
\v 48 نتن ایلنؔ پرُژھنس ژٕ کتہِ زانَکھ بہٕ کیُتھ انسان چھس۔ یسوعنؔ ووٚنُُس یورٕ، "مےٚ وُچُھکھ ژٕ فلپس سُنٛد یور اننہٕ برونٛٹھے ییٚلہِ ژٕ انجیر کُلِس تل بہِتھ اوسُکھ۔"
\v 49 امہِ پتہٕ ووٚنُس نتن ایلن کھُلہٕ پٲٹھؠ زیٚو مُژرِتھ، "اُستاد ژٕ گژھکھ ضرور خدایہِ سُنٛد گۅبُر آسُن۔ ژٕ چُھکھ اسرائیل لُک بادشاہ۔ یمؠ سُنٛد انتظار ٲسؠ کران أسؠ۔
\v 50 یسوعنؔ ووٚنُس، "ژٕ چُھکھا مےٚ پٮ۪ٹھ اوٕ کِنؠ پژھ کران زِ مےٚ وۅنےٕ ژےٚ زِ ژٕ اوسُکھ پانہٕ انجیر کُلِس تل بہتھ۔ "ژٕ روزکھ مےٚ امہِ کھۅتہٕ تہِ بجہِ کامہِ کران وُچھان۔
\v 51 امہِ پتہٕ ووٚنُس یسوعنؔ، "بہٕ چُھسے ژےٚ پوٚز ونان پننس جدس یعقوبؔ سنٛدِ خوابکؠ پٲٹھؠ ژٕ وُچھکھ آسمان مُژرنہٕ یِوان، تہٕ ژٕ وُچھکھ خدایہِ سٕنٛدؠ فرشتہٕ مےٚ خدایہِ سٕنٛدِس گۅبرس پٮ۪ٹھ یِوان تہٕ گژھان۔\f + \fr 1‏:51 \ft پیدٲیش 28:12\f*
\c 2
\p
\v 1 زٕ دوٚہہ گٔژھِتھ اوس گلیلی علاقس منٛز قانا ناوکِس قصبس منٛز اکھ خانٛدر۔ یسوعؔ سنٛز موج تہِ ٲس أتی
\v 2 کٔمؠ تام پرُژھ یسوعسؔ تہٕ تسنٛدٮ۪ن شٲگردن تہِ دعوتس۔
\v 3 میزبانو کوٚر مہمانن خاندرس منٛز شراب پیش تہٕ تِمو چیو سُہ سورےٕ شراب۔ یسوعنؔ ووٚن ماجہِ، "یمن مۅکلیو شرابے۔ مہربٲنی کٔرِتھ کر تہٕ یِمن امیٚک کانٛہہ سدِ باب۔\f + \fr 2‏:3 \ft یہُودینؔ ہُند رسم اوس زِ تِم ٲسؠ خاندرٕ کیٚن موقن پؠٹھ پننؠن سارنےٕ پژھؠن دچھِ رس چاوان یُس دچھ پاکہٕ نٲوِتھ کڈنہٕ یوان اوس۔\f*
\v 4 یسوعنؔ ووٚنُس یورٕ، "محترمہٕ اتھ معاملس کیاہ چُھے ژےٚ یا مےٚ کرُن۔ پنٕنؠ کٲم شروع کرنہٕ باپتھ سُہ خاص وقت ووت نہٕ وُنہِ۔
\v 5 یسوعؔ سنٛزِ ماجہِ ووٚن خٲدمن، "تی کٔرِو یہِ کرُن یہِ ونیٚو۔"
\v 6 اتہِ ٲسؠ شےٚ کنیٚو خٲلی مَٹھ۔ یِمن منٛز اوس آب تاکہِ لوٗکھ کرن یہُودؠ مذہبی رسمہٕ حسابہٕ پنٕنؠ صاف صفٲیی۔ پرٮ۪تھ مٹھس منٛز ہیٚکہِ ہے شیٖتہٕ پٮ۪ٹھٕ اَکھ ہَتھ تہٕ وُہہ لیٖٹر تام آب ویٚپِتھ۔
\v 7 یسوعنؔ ووٚن خٲدمن، "یِمن مٹھن بٔریٚو آب۔ "لہٰذا بٔرؠ تِمو دٔنٛدرِ تام یِم مَٹھ آبہٕ سٟتؠ۔
\v 8 امہِ پتہٕ ووٚنُن یِمن مزید، "ؤنؠ کٔڈیٚو کُنہِ مَٹھہٕ منٛز کینٛہہ آب تہٕ نِیو خاندرٕ دعوتس ہنٛدس انتظٲمس نِش" خٲدمو کوٚر یی۔
\v 9 خانٛدرٕکؠ دعوتٕکؠ انتظٲمؠ وُچھ امیٚک مزٕ۔ یہِ اوس شراب بنیٚومُت۔ تس اوس نہٕ کانٛہہ زۅنےٕ یہِ شراب ٲخٕر آو کتہِ۔ گو زِ خٲدم یِمو مٹھہٕ منٛزٕ یہِ آب کوٚڈ ٲسؠ زانان۔ تٔمؠ اوٚن مہرازٕ پانس نِش ناد دیاوِتھ۔
\v 10 تہٕ ووٚنُن مہرازس، "پرٮ۪تھ کانٛہہ میزبان چُھ رُت موٚۓ گۅڈٕ پیش کران تہٕ ادٕ کم درجُک ییٚلہِ پٔژھؠ پور شراب چٮ۪تھ نشس منٛز آمٕتؠ آسن تہٕ دون منٛز فرق کرنک تمیز کٔرِتھ ہیکن۔ مگر ژےٚ اوسُتھ بہتر موٚۓ ونیُک تام تُلتھےٕ تھوومُت۔
\v 11 یہِ ٲس یسوعؔ سنٛزو کرامژو منٛزٕ گۅڈنِچ نشٲنی۔ یہِ کوٚر تٔمؠ قانا قصبس منٛز یُس گلیلی علاقس منٛز چُھ۔ اتہِ ہوو أمؠ زِ سُہ کوتاہ عظیم چُھ۔ امؠ سنٛدٮ۪ن شٲگردن بڈییہِ امؠ سنٛز پژھ مزید۔
\v 12 امہِ پتہٕ گو یسوعؔ پنٕنؠ موج، بٲے تہٕ شٲگرد ہٮ۪تھ کفرنحوم قصبس منٛز تہٕ کینٛہہ دوٚہہ روٚدؠ أتی۔
\v 13 یہودٮ۪ن ہنٛز عیدِ فسح ٲس کلس پٮ۪ٹھ۔ اوے دراو یسوعؔ یروشلم شہرس کُن۔\f + \fr 2‏:13 \ft عیدِ فسح اوس 14نیسان یعنی اولِ اپریل اندؠ پکؠ مناونہٕ یوان۔ یہِ اوس اسرائیل ین ہندِ مِصرچہِ غلامی نِشہ آزاد گژھنہٕ کس یادس منز مناونہٕ یوان۔ وچھیو خروج 27۔12:1، تثنِیہ شرع 16:1۔8\f*
\v 14 اتہِ وُچھ أمؠ ہیکل کِس صحنس منٛز لوٗکھ، کٹھ، گُپن تہٕ کوتر ہیٚوان کٕنان یہنٛز قۅربٲنی کرنہٕ باپتھ۔ بیٚیہِ وُچھ اتہِ أمؠ کینٛہہ زٔنؠ میزن نکھہٕ بہتھ پونٛسن ہُنٛد ہیوٚن دیُن کران ہیکل چہِ آمدنی ہندِ خٲطرٕ۔
\v 15 أمؠ بنوو چرمہِ تلمن ہُنٛد قمچہٕ تہٕ کھٲلِن یِم سٲری کٹھ، گُپن ہٮ۪تھ ہیکل کہِ صحنہٕ منٛز پانے۔ تٔمؠ چھکؠ صرافن ہنٛدؠ پونٛسہٕ پتھرِس تہٕ کوٚرنکھ میزن تلُک پٮ۪ٹھ۔
\v 16 تٔمؠ ووٚن کوتر کٕنن والیٚن "کٔریٚو دفع یِم کوتر ووتر یتہِ۔ میٲنِس مٲلؠ سُنٛد یہِ گرٕ مَہ بنٲؠ وُن بازر۔
\v 17 أمؠ واقہٕ ہن پوو امؠ سنٛدٮ۪ن شٲگردن ژٮ۪تس کستام سنٛز کتھ یۅسہ پتھ کال کٮ۪ن صحیفن منٛز درج چھےٚ "بہٕ چُھس یتھ ہیکلس یوٗتاہ لول بران زِ بہٕ چُھس، میانہِ خدایہِ امہِ باپتھ مرنہٕ خٲطرٕ تیار۔"\f + \fr 2‏:17 \ft زبور 69:9\f*
\v 18 یہُودؠ زِٹھیٚو کٔر امہِ باپتھ یسوعسؔ پرٕژھٕ گٲر تہِ، "ژٕ کُس معجزٕ ہیٚککھ سانہِ خٲطرٕ کٔرتھ یہِ ثٲبت کرنہٕ خٲطرٕ زِ ژےٚ چُھے خدایہِ سنٛدِ طرفہٕ اختیار تِم چیز کرنُک یِم ژٕ کران چُھکھ؟"
\v 19 یسوعنؔ ونُکھ درجواب، "یوٚدوے توٚہؠ یہِ ہیکل والیٚو بہٕ کھالن یہِ چھرا ترٮ۪ن دوٚہُن منٛز بیٚہِ۔
\v 20 یہُودؠ زِٹھیٚو ووٚنُس یورٕ، "یتھ ہیکلس لٔگؠ شیٚہِ تٲجی ؤری بناونس۔ ژٕ چُھکھا ونان ژٕ بناوہن یہِ ترٮ۪ن دوٚہُن منٛزے۔
\v 21 بحرہال یمہِ ہیکلچ یسوعؔ کتھ اوس کران سُہ اوس امسُنٛد پنُن آسُن۔ کانٛہہ خٲرجی مکان یا مندر نہٕ۔
\v 22 یسوعؔ سُنٛد یہِ خاص بیان پیٚو ژٮ۪تس أمؠ سنٛدٮ۪ن شٲگردن ییٚلہِ خداین یسوعؔ پانس نِش مرنہٕ پتہٕ کھول۔ امہِ پتہٕ توٚگ تِمن زانُن پرانیٚن صحیفن ہُنٛد لیٚوکھمُت تہِ تہٕ یسوعؔ سُنٛد ونُن تہِ۔
\v 23 کینٛہہ کال گٔژھِتھ ییٚلہِ یسوعؔ یروشلمس منٛز فسع عید مناونس دوران اوس۔ واریہو لوٗکو کٔر أمِس پؠٹھ پژھ تکیازِ تِمو وُچھ تِم معجزٕ یِم سُہ ہاوان روٗد۔
\v 24 چونکہِ یسوعؔ اوس زانان زِ لوٗکھ چھِ، سٲری ہِوی۔ تٔمؠ کٔر نہٕ یِمن پٮ۪ٹھ پژھ۔
\v 25 یسوعنؔ کٔر نہٕ یِمن پٮ۪ٹھ پژھ یمہِ کِنؠ تہِ زِ تس ٲس نہٕ ضرورت انسان زٲژ متعلق کٲنٛسہِ نِش کینٛہہ بوزنچ۔ سُہ اوس زانان انسان کیاہ چُھ سونچان تہٕ کیاہ چُھ ژھاران۔
\c 3
\p
\v 1 اکھ شخصا اوس نِیکُدِیمُسؔ ناوُک۔ سُہ اوس یہودٮ۪ن ہنٛدِ اکہ شِٹھٕ مذہبی فرقُک، یعنی فریسی جمٲژ ہُنٛد اکھ رکنُ۔ سُہ اوس اعلیٰ یہُودؠ انتظٲمی مشاورتُک تہِ اکھ رکُن۔
\v 2 سُہ آو اکہ رٲژ یسوعسؔ سمکھنہِ۔ تٔمؠ ووٚن یسوعسؔ، "استاد۔ اسہِ چھےٚ پتاہ ژٕ چُھکھ خدایہِ سٕنٛدِ طرفہٕ مقرر آمُت کرنہٕ رہبر۔ أسؠ چھِ یہِ پوٗرٕ زانان زَ یِم تہِ یِتھؠ معجزٕ ہیٚکنہٕ کانٛہہ تہِ ہٲوِتھ خدایہِ سٕنٛدِ مدتہٕ ورٲے۔
\v 3 پتہٕ ووٚن یسوعنؔ نِیکُدِیمُسؔ، "بہٕ چُھسے پزَر ونان۔ کہینؠ تہِ ہیٚکہِ نہٕ توٚت أژتھ یتہِ پانہٕ خدا رٲج کران آسہ یوٚتام  خداین کرنٲیِو توٚہؠ نوِ زاینُک تجربہٕ۔
\v 4 نِیکُدِیمُسؔ ووٚن تمِس، "کانٛہہ تہِ زوٚن کِتھٕ پٲٹھؠ ہیٚکہِ دُبارٕ زندٕ گٔژھِتھ ییٚلہِ سُہ بُجرس ووتمُت آسہ۔ کانٛہہ تہِ ہیٚکہِ نہٕ پننہِ ماجہِ ہِنٛدِس رحمس منٛز أژتھ تہٕ ہیٚکہِ نہٕ دوٚیمہِ لَٹہِ زیٚوِتھ!"
\v 5 یسوعنؔ ووٚنُس، "بہٕ چُھسے پوٚز ونان۔ کانٛہہ تہِ ہیٚکہِ نہٕ خدا سنٛزِ پادشٲہی منٛز دٲخل گٔژھِتھ یوٚتام نہٕ سُہ آبہٕ تہٕ روح سٟتؠ دُبارٕ پٲدٕ گژھِ۔
\v 6 ییٚلہ اکھ انسان کانٛسہِ بیٚیِس زنم دییہِ سُہ زیٚنہٕ وول تہِ چُھ انسانےٕ آسان۔ مگر یِم زن خدایہِ سٕنٛدِ روح سٟتؠ دُبارٕ زنم پراون تمن ہنٛز فطرت چھےٚ بلکل الگ تہٕ بِدون آسان یۅسہٕ فطرت خدا یمن انٛدرے پٲدٕ کران چُھ۔
\v 7 حٲران مٕہ گژھِ تکیازِ مےٚ وۅنےٕ ژےٚ زِ خداین کرنٲیِو توٚہؠ نوِ زاینُک تجربہٕ۔
\v 8 زنتہٕ روح القدس چُھ اکھ واو بس یتہِ یٮ۪ژھِ تہٕ تتہِ ہیٚکہِ پھیرِتھ تھورِتھ۔ اگر ژٕ امہِ واوٕچ آواز بوزِتھ ہیٚککھ مگر امیٚک آگُر یا منٛزل ہیٚککھ نہٕ زٲنِتھ۔ یتھٕ پٲٹھؠ زن ژٕ یہِ زٲنِتھ ہیٚککھ نہٕ تِتھے پٲٹھؠ ہیٚککھ نہِ یتہِ زٲنِتھ زِ خدایہِ سٕنٛدِ روحچہِ عملہِ سٟتؠ کِتھہٕ پٲٹھؠ چُھ کانٛہہ دُبارٕ زایُن لبان۔\f + \fr 3‏:8 \ft جامع 11:5\f*
\v 9 نِیکُدِیمُسؔ پرُژھُس بیٚیہِ، "یہِ کِتھہٕ پٲٹھؠ چُھ ممکن؟"
\v 10 یسوعنؔ ووٚنُس، "ژٕ چُھکھ اسرائیل ین منٛز اکھ مذہبی رہبر کاہن لہٰذا پزی ژےٚ پانہٕ زانُن زِ بہٕ کیاہ چُھسے ونان۔
\v 11 بہٕ چُھسے ژےٚ پوٚز ونان: بہٕ تہٕ میٲنؠ شٲگرد چھِ تِمے کتھہٕ ونان یِمن أسؠ پوٚز زانان چھِ، تہٕ أسؠ چھِ توٚہہِ تِمن چیزن متعلق ونان یِم اسہِ وُچھمٕتؠ چھِ۔ تمہِ پتہٕ تہِ چُھو توٚہؠ لوٗکھ یِمن أسؠ یِمہٕ چیز ونان چھِ تہِ رد کران یہِ أسؠ ونان چھِ۔
\v 12 چونکہِ توٚہؠ لوٗکھ چُھو نہٕ تتھ پژھ کران یہِ بہٕ ونان چُھس ییٚلہِ بہٕ توٚہہِ ونہٕ زِ یہِ یتھ بُترٲژ پٮ۪ٹھ کیاہ چُھ سپدان، توٚہؠ کٔریٚو نہٕ یقیٖنن تتھ پٮ۪ٹھ تہِ پژھ ییٚلہِ بہٕ ونہ توٚہہِ تِمن چیزن متلق یہِ آسمانن پٮ۪ٹھ گژھان چُھ۔\f + \fr 3‏:12 \ft زبور 34:12۔16\f*
\v 13 بہٕ ابنِ آدمؔ چُھس سُہ کُنے زوٚن یُس آسمانن کھوٚت تہٕ بہٕ چُھس سُہ کُنے زوٚن یُس تورٕ آسمانو پٮ۪ٹھٕ بُترٲژ پٮ۪ٹھ ووٚتھ۔
\v 14 وقتا گو ییٚلہِ اسرائیلی دربدر پھیران ٲسؠ بیابانن منٛز۔ موسیٰؔ ہنؔ تُل اکھ سرتلہِ ہُنٛد نمونہٕ أکِس زہردار سرفہٕ سُنٛد۔ أکِس لٲنٛز پٮ۪ٹھ پننس عصاہس پٮ۪ٹھ، پتہٕ ساروےٕ اتھ کن نظر ترٲوؠ تِم بچییہِ سرفو نِشہ۔ یِتھے پٲٹھؠ پزِ لوٗکن بہٕ آدمؔ سُنٛد گۅبُر تہِ تلُن صلیبہِ پٮ۪ٹھ۔\f + \fr 3‏:14 \ft گرینٛد 21:9\f*
\v 15 تِم تُلن مےٚ تاکہِ یُس تہِ ہیٚور کُن وُچھِ تہٕ مےٚ پٮ۪ٹھ یٮ۪ژھِ تہٕ پژھِ تھاوِ آسہ ہمیشہٕ باپتھ مےٚ سٟتؠ زندٕ۔
\v 16 تکیازِ خدا چُھ سٟتؠ یمہِ دُنیہکٮ۪ن لوٗکن تہٕ تیتہہٕ پٲٹھؠ لول کران زِ تٔمؠ دیُت پنُن کُن گۅبُر زِ یُس تہِ أمِس پٮ۪ٹھ پژھ تھاوِ سُہ مَرِ نہٕ زانہٛہ تہٕ پراوِ پوشوٕنؠ زندگی۔
\v 17 یہِ چُھ پوٚز خداین سوزُس نہٕ بہٕ آدمؔ سُنٛد گۅبُر پ  دُنیہکٮ۪ن لوٗکن گناہ گار ٹھہراونہٕ باپتھ بلکہ سوزُس بہٕ خداین یمہِ دُنیہکٮ۪ن لوٗکن نجات بخشنہ۔
\v 18 خدا چُھنہٕ تس کٲنٛسہِ تہِ گناہ گار ٹھہراوان یُس تسٕنٛدِس نیٚچوِس پٮ۪ٹھ ایمان انہِ۔ مگر تِم لوٗکھ چھِ تمہِ برونٛہےٕ گناہ گار گنٛزرؠ مٕتؠ یِم تسٕنٛدِس نیٚچوِس پٮ۪ٹھ ایمان انُن نہٕ۔
\v 19 خدایہِ سُنٛد فرمان چُھ سُہ یس چُھ نور ژاو یتھ بُترٲژ منٛز مگر لوٗکھ چھِ مازان انہِ گٹہِ تہٕ کران تہِ چھِ، گٹہٕ کارےٕ۔
\v 20 یِم لوٗکھ چھِ انہِ گٔٹِس کوٚمہٕ کران تہٕ سُہ شخص یس لٔگؠ تھےٕ ہٮ۪چھ کامہ کرِ چُھ گاشلس دےٕ کران تہٕ پراوان نہٕ نور تہِ زانہٛہ۔ یِم ھِ گاشس نِش ژلان زِ گاش ما تُلہِ تہنٛدِس کارس ووٚرُن۔
\v 21 مگر سُہ شخص یُس لٔگؠ تھےٕ پوٚز کار کرِ پزرس ما زِ چُھ چھیکرس گاس منٛڈلسےٕ واتان۔ نورس پراوان تاکہِ یہِ گاش کرِ روشن تہٕ انہِ سٲرسےٕ دیدمان برونٛہہ کُن تتھ رٕتِس کارس یُس سُہ کران چُھ تاکہِ سٲری زانن زِ خدا چُھ أمِس شخصس پننس نیک کارس منٛز مدد کران۔
\v 22 ییٚلہِ یوٗتاہ کینٛہہ سپُد۔ یسوعؔ تہٕ تسٕنٛدؠ شٲگرد ژاے یہُوداؔ کِس علاقس منٛز۔ اتہِ رود سُہ کیونٛژ کالےٕ پننٮ۪ن شٲگردن سان تہٕ دیتن واریہن لوٗکن بپتسمہ۔
\v 23 بپتسمہ دِنہٕ وول یوحنا تہِ اوس عینون شہرس نکھٕ لوٗکن بپتسمہ دِوان، یُس سامریا کس علاقس منٛز سالم قصبس نکھہٕ چُھ۔ سُہ اوس اتہِ لوٗکن بپتسمہ دوان تکیازِ اتہِ اوس واریاہ آب دستیاب تہٕ لوٗکھ ٲسؠ لٔگؠ تھےٕ یوحناہسؔ نِش بپتسمہ باپتھ واتان۔
\v 24 یوحنا اوس یہِ اوٕ کِنؠ ہیٚکان کٔرِتھ تکیازِ تسنٛدیو دُشمنو اوس نہٕ سُہ وُنہِ قٲد خانس بوٚرمُت۔
\v 25 پتہٕ کوٚر یوحنا سنٛدیو کینٛژھو شاگردو أکس یہُودؠ نفرس سٟتؠ یہُودؠ مذہبی قانونن مُتعلِق بحث شروع۔
\v 26 بحث کرن وٲلؠ آے یوحناہسؔ نِش تہٕ وۅنہٕ ہس۔ اُستاد۔ اکھ زوٚن یُس ژےٚ سٟتؠ اوس ییٚلہِ ژےٚ لوٗکن دریایہِ یردنس اپارِ بپتسمہ دِوان اوسُکھ تہٕ ژےٚ ٲسٕتھ اسہِ تس سنٛز پرٮ۪زنتھ تہِ دِژمٕژ۔ چُھ ؤنؠ پانہٕ تہِ لوٗکن بپتسمہ دِوان تہٕ لوٗکھ چھِ تٔسؠ کُن لاران۔
\v 27 یوحناؔہن ونُکھ یور، "کانٛہہ تہِ پرواہ نہٕ کینٛہہ یوٚتام نہٕ خدا تس دِیہ۔
\v 28 توٚہؠ چُھو پٔزؠ پٲٹھؠ میٲنؠ گواہ زِ بہٕ چُھس نہٕ پانہٕ مسیحؔ مگر بہٕ چُھس خداین مسیحؔ ہس برونٛہہ برونٛہہ سوزمُت۔\f + \fr 3‏:28 \ft یوحنا 1:20، ملاکی 3:1\f*
\v 29 مہرِنؠ چھےٚ مہبادشاہ سنٛز۔ زٲنؠ تو بہٕ چُھس مہبادشاہ سُنٛد یار۔ بہٕ چُھس تس نکھہٕ تہٕ تسُنٛد کُن تہٕ بہٕ چُھس خوش زِ بہٕ چُھس مہبادشاہ سنٛز آواز بوزان۔ چونکہِ مہرِنؠ چھےٚ مہرازس میلن واجِنؠ۔ بہٕ چُھس سٮ۪ٹھا سٮ۪ٹھا خوش۔
\v 30 مہرازٕ یسوعؔ گژھِ زیادٕ کھۅتہٕ زیادٕ با اثر بنُن تہٕ بہٕ مہرازٕ سُنٛد یار گژھہِ کمےٕ اثرٕ وول آسُن۔
\v 31 یسوعؔ چُھ وسان آسمانہٕ تہٕ سُہ چُھ پرٮ۪تھ سٕنٛدِ تہٕ پرٮ۪تھ چیزٕ کھۅتہٕ زیادٕ عظیم۔ تِم یِم میٲنؠ پٲٹھؠ زمیٖنہِ پٮ۪ٹھ وۅپدییہِ ہیٚکن چھرا پننہِ نیٚو محدود زانکٲریو کِنؠ کتھ کٔرِتھ۔ یُس آسمانہٕ پٮ۪ٹھٕ یِوان چُھ سُہ چُھ زمینہِ پٮ۪ٹھ پرٮ۪تھ کٲنٛسہِ تہٕ پرٮ۪تھ کُنہِ چیزٕ کُۅتہٕ تھوٚد تہٕ بوٚڈ۔
\v 32 یسوعؔ چُھ لوٗکن نوٚمن چیزن متعلق ونان یِم تٔمؠ پانہٕ وُچھ تہٕ بوزؠ آسمانن پٮ۪ٹھ۔ مگر چھرا چُھ کم قلیل لوٗکھےٕ امسنٛز کتھ قبول کران۔
\v 33 بہرحال یسوعسؔ پٮ۪ٹھ پژھ تھاون وٲلؠ چھِ یتھ کتھِ تصدیق کران زِ خدا چُھ پٔزؠ یور تہٕ حق۔
\v 34 تکیازِ یہِ یسوعؔ، یُس خداین یور سوز چُھ خدایہِ سُنٛد کلام دُہراوان۔ اسہِ چھےٚ خبر زِ سُہ چُھ خدایہ سُنٛدےٕ کلام ونان یقیناً چُھ خداین تمِس بے حسابہٕ تہٕ بے انتہا پٲٹھؠ پنُن روح بخشمُت، خداین یعنی مٲلؠ چُھ پننِس نیٚچوِس بے انتہا طاقت بخشمُت پرٮ۪تھ چیزس پٮ۪ٹھ۔
\v 35 خدا یعنی مول چُھ گۅبرس سٟتؠ محبت کران تہٕ تٔمؠ چُھس نیٚچوِس پرٮ۪تھ چیزس پٮ۪ٹھ اختیار دیُتمُت۔
\v 36 یُس تہِ خدایہِ سٕنٛدِس گۅبرس پٮ۪ٹھ پژھ تھاوِ لبہِ پوشہٕ وٕنؠ زندگی۔ یُس نہٕ خدایہِ سٕنٛدِ گۅبرس پٮ۪ٹھ پژھ تھاوِ تس میلہِ نہٕ پوشہٕ وُنؠ زندگی۔ خدا روزِ تس ہمیشہٕ ناراض۔
\c 4
\p
\v 1 کینژِ کٲلؠ بوز فریسِیو زِ یسوعسؔ چھِ بیشان ژٔرؠ شٲگرد بپتسمہ دِنہٕ وٲلِس جان یوحنا سنٛدِ کھۅتہٕ تہٕ سُہ چُھ یوحنا سٕنٛدِ کھۅتہٕ زیادٕ لوٗکن بپتسمہ دِوان۔ یسوعسؔ سپدیا و تپِ معلوم زِ فرِیسِیو بوز یہِ سورےٕ۔
\v 2 ژکہِ اوس نہٕ یسوعؔ کٲنٛسہِ بپتسمہ دِوان بلکہ ٲسؠ امسنٛدؠ شٲگرد یہِ کٲم گلیل تہٕ یہُوداہسؔ منز کران۔
\v 3 ییٚلہِ تٔمؠ بوز زِ فرِیسِی چھِ یہِ زانان۔ یسوعنؔ تروو یہُوداؔ علاقہٕ تہِ پھیور واپس اکہ لٹہِ بیٚیہِ گلیل کُن۔
\v 4 مگر گلیل کُن واپس پھیرنہٕ باپتھ اوس أمِس سامریہ کہِ علاقہٕ منٛزؠ نیرن۔
\v 5 لہٰذا وٲتؠ یِم سامریہ کِس علاقس سُوخارؔ شہرٕ منٛزؠ۔ سُوخارؔ اوس تتھ زمیٖنہِ ٹُکرس نکھے یُس یعقوبؔن برونٛہہ کالہِ یوسفسؔ بخُش مُت اوس۔
\v 6 یعقوبؔ سُنٛد کریوٗر تہِ اوس أتی۔ سُوخارؔ واتان واتان اوس یسوعؔ امہِ زیٹھِ سفرٕ کِنؠ واریاہ تھوٚکھمُت۔ اوے بیوٹھ سُہ یعقوبؔ سٕنٛدِس کریٖرِس نکھے موس کڑنہِ۔ یہِ اوس ؤنؠ دوٚپہرچہِ باہ بجے۔
\v 7 اکھ سامریہ زنان آیہِ اتھ کریٖرِس پٮ۪ٹھ اتھ منز رز گٔنِڈِتھ بالٹین ترٲوِتھ آب کڑنہٕ باپتھ۔ یسوعنؔ ووٚن أمِس، "مہربٲنی کٔرِتھ دِ مٮ۪تہِ تریشہِ داما۔
\v 8 تٔمؠ ووٚن أمِس زنانہِ تکیازِ تسنٛد شٲگرد ٲسؠ تس أتی ترٲوِتھ شہر کُن کینٛہہ کھیٚن چٮ۪ن مٔلؠ اننہِ گٲمٕتؠ۔
\v 9 تہٕ امہِ سمرٲتؠ زنانہِ ووٚن یسوعسؔ، "بہٕ چُھس حٲران زِ اکھ یہُودؠ چُھ مےٚ أکِس سامرٲتؠ زنانہِ تریش منٛگان۔" تٔمؠ ووٚن أمِس یہِ تکیازِ یہُودؠ ٲسؠ نہٕ سمراتٮ۪ن سٟتؠ کانٛہہ یُتھ تیُتھ واٹھ تھاوان یا ہیوٚن دیُن کران۔
\v 10 یسوعنؔ ووٚن أمِس زنانہِ یورٕ، "یوٚدوے ژےٚ خبر ٲسؠ خدا کُس الفام چُھے ژےٚ دِنہٕ وول تہٕ ژٕ یہِ زانہکھ یہِ تیش منٛگن وول کوٚس چھےٚ تیٚلہِ منٛگہ ہکھ ژٕ مےٚ اورَے تریش تہٕ بہٕ دِمہٕ ہَے ژےٚ آبہِ حیات۔
\v 11 امہِ زنانہِ ووٚنُس اور، "جناب توٚہہِ چُھنہٕ کانٛہہ آبہٕ باپتھ بانہٕ تہِ۔ یہِ کریور چُھ واریاہ سروٚن۔ توٚہؠ کِتھہٕ پٲٹھؠ کٔڑیٚو یہِ زندگی دِنہٕ وول آب یمہِ کریرِ منٛزٕ۔
\v 12 ژٕ ما چُھکھ سٲنِس ببس یعقوبسؔ کھٔسِتھ تہِ کینٛہہ؟ تٔمؠ کھوٚن یہِ کریور تہٕ بخشُن اسہِ۔ أسؠ سٲری تسٕنٛدؠ زُرے، یِم چاروٲے بیترِ چھِ یمہِ کریریُک آب چٮ۪وان تہٕ ورتاوان۔
\v 13 یسوعنؔ ووٚنُس یور، "یمہِ کریریُک آب چٮ۪نہٕ وول روزِ چٮ۪تھ تہِ تریشہٕ ہوٚتےٕ۔ سُہ ژھارِ بیٚیہِ تہٕ بٚیہِ تریش۔
\v 14 مگر سُہ کانٛہہ نفر یُس سۅ تریش چیٚیہِ یۅسہ بہٕ دِمس ژھارِ نہٕ زانہٛہ تہِ دُبارٕ تریش۔ بلکہ یۅسہ تریش بہٕ چاون روزٮ۪س انٛدرؠ کِنؠ ناگہٕ رادکؠ پٲٹھؠ وزٕوُنؠ تہٕ تھاوٮ۪س ہمیشہٕ ہمیشہٕ باپتھ زنٛد آسمانن منٛز جنتس منٛز۔
\v 15 زنانہِ ووٚن یسوعسؔ، "جناب دیا کٔریو۔ مےٚ دِیو یہِ تریش تاکہِ مےٚ لگہ نہٕ زانہٛہ تہِ دُبارٕ تریش تہٕ نَہ پیٚی، یتھ کریرِس پٮ۪ٹھ دُبارٕ آب کڑنہِ یُن۔
\v 16 یسوعنؔ ووٚن أمِس زنانہِ، "نیر انُن پنُن خاندار مےٚ نِش سٟتؠ۔"
\v 17 زنانہِ ووٚنُس اورٕ، "مےٚ چُھنہٕ خاندارےٕ" یسوعن ووٚن أمِس ژٕ چُھکھ پوٚز ونان زِ ژےٚ چھی نہٕ خاندار،
\v 18 یسوعنؔ ووٚنُس، "ژےٚ ووٚنُتھ صحیح زِ ژےٚ چُھےٕ نہٕ کانٛہہ اکھ خاندار۔ ژےٚ چُھے نہٕ اکھ بلکہ پانٛژھ خاندار۔ تہٕ یس سٟتؠ ژٕ یہِ ازکل روزان چُھکھ وٲتی نہٕ ژےٚ خاندار۔ لہٰذا چُھ وچون یہِ ونُن صحیح زِ ژےٚ چُھےٕ نہٕ کانٛہہ اکھ خاندار۔
\v 19 زنانہِ ووٚنُس اورٕ، "جناب۔ مےٚ چُھ تگان بوزُن زِ توٚہؠ چُھو نبی۔
\v 20 سٲنؠ جد ٲسؠ یتھ بالس پٮ۪ٹھ خدایہِ سنٛز عبادت کران۔ مگر توٚہؠ یہُودؠ چُھو ونان زِ اسہِ پزِ خدایہِ سنٛز عبادت تہنٛدِ یروشلمہٕؔ کرٕنؠ۔\f + \fr 4‏:20 \ft تثنِیہ شرع 11:19\f*
\v 21 یسوعنؔ ووٚن أمِس، "خوتون جی۔ پژھ کرِ۔ ؤلؠ ؤلؠ واتہِ سُہ دوٚہہ ییٚلہِ توٚہؠ نَہ یتھ بالس پٮ۪ٹھ تہٕ نَہ یروشلمہٕؔ مٲلس خدایہِ سنٛز عبادت کٔریٚو۔
\v 22 توٚہؠ لوٗکھ چُھو ییٚتہِ سمریس منٛز تمِس خدایہِ سنٛز عبادت کران یمِس نہٕ توٚہؠ زٲنؠ وٕے۔ أسؠ یہُودؠ چھِ تمِس خدایہِ سنٛز عبادت کران یمِس أسؠ زانو۔ یی چُھ پوٚز۔ تکیازِ گُنہو نِشہ بچاوس وتھ چھےٚ نیران یہُودیت پیٚٹھےَ۔\f + \fr 4‏:22 \ft یسعیاہؔ 2:3\f*
\v 23 بہرحال وق چُھ واتن وول۔ اکھتُے چُھ آمُت ییٚلہِ خدایس پزنہٕ پٲٹھؠ عبادت کرن وٲلؠ مٲلؠ سنٛز عبادت روح تہٕ پزرٕ سان کرن۔ تکیازِ مول چُھ بے شک تمن ژھاران روزان یِم یتھٕ پٲٹھؠ امہِ پزرٕ تس سنٛز عبادت کرن۔
\v 24 خدا چُھ اکھ روحٲنی آسن۔ تہٕ تم یم أمِس عبادت کرن گژھن روحٲنی تہٕ حقیقی طور خدایہِ سنٛز عبادت کرٕنؠ۔
\v 25 زنانہِ ووٚن یسوعسؔ، "بٕ چھس زانان زِ مسیحؔ چُھ یِنہٕ وول۔ سُہ چُھ یونٲنؠ زبٲنؠ منٛز کرایسٹ۔ ییٚلہِ سُہ ییہِ سُہ ونہِ اسہِ پرٮ۪تھ کینٛہ چیز۔ یِتہِ اسہِ زاننچ ضرورت آسہ۔
\v 26 یسوعنؔ ووٚن تمِس، "بےٕ چھس ژےٚ سٟتؠ وُنکٮ۪س کتھ کران وول سُہ مسیحؔ
\v 27 امہِ وزِ وٲتؠ یسوعؔ سنٛدؠ شٲگرد شہرٕ پٮ۪ٹھٕ واپس۔ تِم گے حٲران یسوعسؔ أکِس زنانہِ سٟتؠ کتھ کران وُچِھتھ۔ مگر کٲنٛسہِ تہِ ووٚتھ نہٕ خیال یہِ وننُک زِ أمِس زنہِ سٟتؠ کیاہ یارز چھےَ ژےٚ۔ سُہ کیازِ چُھ أمِس وۅپر تنہا زنہِ سٟتؠ کتھٕ کران۔
\v 28 امہِ زنانہِ تروو امی وزِ پنُن آبہٕ مٹھ أتی تہٕ آیہِ شہر کُن واپس۔ تمہِ ووٚن شہرکٮ۪ن لوٗکن،
\v 29 "ہے ؤلِو سمکِھو تمِس شخصس یمؠ مےٚ پنُن سورےٕ کوٚڑمُت کرووٕمُت ووٚن۔ کیاہ یہِ ہیٚکیا مسیحؔ ٲسِتھ کنہٕ نَہ؟
\v 30 یِم شہرٕکؠ لوٗکھ آے امی وزِ پننیٚو جایو پٮ۪ٹھٕ ؤتھِتھ تہٕ وٲتؠ یسوعسؔ نِش۔
\v 31 سۅ زنان نیرنہٕ پتہٕ کوٚر یسوعسؔ پننیٚو شاگردو یِم شہرٕ پٮ۪ٹھٕ کینٛہہ کھیٚن چٮ۪ن ہٮ۪تھ آمٕتؠ ٲسؠ التجا کینٛہہ کھیٚنہٕ چٮ۪نہٕ باپتھ۔ تِمو ووٚنُس، "استاد مہربٲنی کٔرِتھ کھیٚیِو کینٛہہ سا۔"
\v 32 یسوعنؔ ونُکھ یورٕ، "مےٚ چُھ کھیٚنہٕ باپتھ واریاہ یِنہٕ توٚہؠ زنان چُھو۔
\v 33 یِمو شاگردو لوگ اکھ أکِس ونُن، "سُہ کُس بیاکھ کانٛہہ آسہ یُس أمِس کینٛہہ کھیٚنہٕ باپتھ انِتھ ہیٚکہِ۔ آسیا کانٛہہ؟
\v 34 یسوعنؔ ووٚن یِمن، "مےٚ چھِ پوشن دِوان یہِ کتھ یوٚسہٕ مےٚ تہٕ میٲنِس درمیان چھےٚ۔ یمؠ بہٕ یور سوزُس۔ تاکہِ بہٕ کرٕ ببہٕ سنٛز کٲم پوٗرٕ۔
\v 35 بوزِو۔ وریہ کِس یتھ کالس منٛز چُھو توٚہؠ عام پٲٹھؠ بوزان۔ ہے۔ ؤنؠ رودؠ چھرا رٮ۪تھ ژورے، ییٚلہِ أسؠ پنُن فصل لونو۔ ژٮ۪تھ دِتھ بوزِو بہٕ کیاہ چُھسو ونان۔ یِم لوٗکھُ چھِ زٲنؠ تو تِم کھاہ یِم فصل لوننہٕ باپتھ تیار چھِ۔
\v 36 تِم یِم فصل لونن رٹن امہِ لوننُک ماوضہٕ تہٕ من پھل۔ تہٕ گو لوٗکھ پراون ابدی زندگی۔ امیٚک بیاکھ نتیجہٕ چُھ یہِ زِ یمو امیٚک بیول وو تہٕ یِمو یہِ فصل لوٚن آسن دۅشوے یِکہٕ وٹہٕ خوش۔
\v 37 یہِ بہٕ توٚہہِ ونُن چُھس یژھان تہِ چُھ پوٚز۔ اکھ زوٚن چُھ بیول ووان تہٕ بیاکھ چُھ لوٚنان امیٚک فصل۔\f + \fr 4‏:37 \ft میکاہ 6:15\f*
\v 38 بہٕ چُھس توٚہہِ پننٮ۪ن شٲگردن یہِ فصل وٹنہِ سوزان یُس نہٕ توٚہہِ وو کینٛہہ۔ باقیو چُھ یہِ فصل وونہٕ باپتھ سٮ۪ٹھا حُکھمت تہٕ توٚہؠ چُھو وُنؠ یمن لوننچہِ کامہِ منٛز سادان۔
\v 39 سُوخارؔ کہِ امہِ شہرٕکؠ واریاہ سامرٲتؠ لوٗکن پٮ۪ٹھ أمِس زنانہِ ہنٛدس وننس پٮ۪ٹھ یسوعؔ سنٛز پژھ۔ تٔمؠ ووٚن یِمن لوٗکن، "یسوعنؔ ونہِ مےٚ پننہِ کرمژٕ واریاہ کِتھہٕ۔
\v 40 ییٚلہِ یِم سامرٲتؠ یسوعسؔ نِش وٲتؠ تِمو ووٚن تمِس تمنےٕ سٟتؠ روزنہٕ باپتھ۔ اوے رود یسوعؔ یمن نِش دوٚن دوٚہُن۔
\v 41 أمؠ سُنٛد کلام بوزِتھ بیٹھؠ بیٚیہِ تہِ واریہن سمرٲتؠ لوٗکن امؠ سنٛز پژھ۔
\v 42 یمو شہر باشو ووٚن أمِس زنانہ، "أسؠ چھِ ؤنؠ یسوعسؔ پٮ۪ٹھ پژھ کران۔ اوٕ کِنؠ نہٕ زِ ژےٚ ووٚنُتھ اسہِ أمِس متعلق۔ أسؠ چھِ أمِس پٮ۪ٹھ پژھ کران تکیازِ اسہِ بوز پانہٕ أمؠ سُنٛد کلام تہٕ پٲغام۔ اسہِ چُھ پوٗرٕ پوٗرٕ یقین زِ یوٚہے چُھ پٔزؠ پٲٹھؠ سُہ انسان یُس یتھ دُنیاہس گُنہَو نِشہ بچاوِ۔
\v 43 دوٚن دوٚہُن سمرٲتیٚن سٟتؠ أتی روزِنہٕ پتہٕ دراو یسوعؔ سُوخارؔ پٮ۪ٹھٕ تہٕ ژاو گلیل ہنٛدِس علاقس منٛز۔
\v 44 یسوعؔ اوس گلیل کُن اوٕ کِنؠ گژھُن یژھان زِ تٔمؠ اوس پانے یہِ ووٚنمُت تہٕ  یقیناً پوٚز زِ أکِس نبیس چُھنہٕ پننہِ زیٚنہٕ شہر عزت تہٕ مرتبہٕ میلان۔ تہٕ سُہ اوسنہٕ شہرُت تہِ یژھان۔
\v 45 چونکہِ یی چُھ پوٚز۔ ییٚلہِ سُہ گلیل ہنٛدِس علاقس منٛز ووت واریہو لوٗکو کوٚر تمِس سرسری خوش آوے تکیازِ تِمو ٲسؠ یسوعؔ سٕنٛدؠ سٲری کارنامہٕ وُچھمٕتؠ یِم تٔمؠ یروشلم منٛز حال حالے عید ہنٛدِس موقعس پٮ۪ٹھ انجام دِتؠ مٕتؠ ٲسؠ۔
\v 46 امہِ پتہٕ گو یسوعؔ واپس گلیل ہنٛدس قانا قصبس منٛز۔ یتہِ زن امؠ کرامژ سٟتؠ آبس شراب بنوومُت اوس۔ اتہِ اوس نکھے کفرنحوم شہرس منٛز بادشاہ سُنٛد اکھ حٲکم روزان یمسُنٛد نیٚچو سخ علیل اوس۔
\v 47 ییٚلہِ أمؠ بادشاہ سٕنٛدؠ حٲکمن یسوعسؔ متعلق یہِ بوز زِ سُہ چُھ یہُوداؔ پٮ۪ٹھٕ واپس گلیل آمُت سُہ گو یسوعسؔ نِش قناؔ قصبس منٛز تہٕ ووٚنُن أمِس کفرؔنحُوم ینہٕ باپتھ تہٕ تسُنٛد نیٚچو امہِ بٮ۪مارِ نِشہ بٔلراونہٕ باپتھ۔ نتہٕ مرِہے تسُنٛد نیٚچو جلدےٕ۔
\v 48 یسوعنؔ ووٚن أمِس، "توٚہہِ ہیوؠ لوٗکھ کٔرِو تیٚلہِ مےٚ پٮ۪ٹھ پژھ ییٚلہِ بہٕ تہنٛدِ باپتھ کانٛہہ کرامت کرٕ!"
\v 49 بادشاہ سٕنٛدؠ ملٲزمن ووٚنُس یورٕ، "جناب مےٚ سٟتؠ بنیو کفرؔنحُوم امہِ برونٛہہ زِ میون نیٚچو گژھِ مٔرِتھ۔
\v 50 یسوعنؔ ووٚنُس، "نیر گژھِ گرٕ۔ چون نیٚچو روزِ زِنٛدٕ۔ أمؠ نفرن کٔر یسوعسؔ پٮ۪ٹھ پژھ تہٕ أمؠ لوگ گرٕ کُن پکُن۔
\v 51 ییٚلہِ زن یہِ ملٲزم پنُن گرٕ کفرؔنحُوم کُن پکان اوس تس میلیاے تٔتی پنٕنؠ خٲدم تہٕ وونہٕ ہس، "چون نیٚچو ہیٚوتُن زندگی کُن پھیرُن۔ سُہ روزِ زندٕ۔
\v 52 تٔمؠ پرُوژھ یمن پننٮ۪ن خٲدمن، "سُہ کرِ ہیٚوتُن زندگی کُن پھیرُن" تِمو ووٚنُس اورٕ "اِکھ بجے رٲژ پٮ۪ٹھٕ ہیٚوتُن تس تف وسُن۔
\v 53 مٲلِس توٚگ بوزُن زِ تسُنٛد نیٚچو ہیٚوتُن بلُن برابر تِمے وقتہٕ پٮ۪ٹھٕ ییٚلہِ یسوعنؔ تس ووٚن زِ تسُنٛد نیٚچو روزِ زندٕ۔ اوے تہِ لٲجؠ أمؠ نفرن تہٕ امسنٛدیٚو باقیو گرٕ بٲژَو یسوعس پٮ۪ٹھ پژھ کرٕنؠ۔
\v 54 یہِ اوس دوٚیِم یوٚت بوٚڈ معجزٕ یُس یسوعنؔ کوٚر۔ تٔمؠ کوٚر یہِ معجزٕ تمہِ وزِ ییٚلہِ یسوعؔ یہُوداؔ پٮ۪ٹھٕ گلیل ہنٛدِس علاقس منٛز آو۔
\c 5
\p
\v 1 یِمو واریہو واقہو پتہٕ وٲژ بیاکھ یہُودؠ عید۔ تہٕ یسوعؔ دراو یروشلمؔ کُن یہِ عید مناونہِ۔
\v 2 یروشلمؔ شہرس منٛز چھےٚ اکھ جاے کٹہٕ دروازٕ نٲوؠ یہِ چُھ شہرس منٛز اژنُک اکھ دروازٕ۔ أتھؠ دروازس نکھہٕ چُھ اکھ حوض یتھ یہُودؠ پننہِ عِبرٲنؠ زبٲنؠ منٛز بیت حسدا ونان چھِ۔ اتھ نکھے چھِ پش دِش دِتھ پانٛژھ برانٛد۔
\v 3 اتھ پٮ۪ٹھ ٲسؠ ڈاپھ ترٲوِتھ بسیار لوٗکھ۔ یِم لوٗکھ چھِ رنگہٕ رنٛگہٕ مرضن منٛز ہٮ۪نہٕ آمٕتؠ۔ کینٛہہ چھِ أنؠ تہٕ کینٛہہ زنٛگو کِنؠ معذور۔
\v 4 یِم ٲسؠ اتہِ ڈاپھ ترٲوِتھ تکیازِ خداوندٕ سنٛدِ طرفہٕ اوس گاہ بٮ۪گاہ کانٛہہ فرشتہٕ وسِتھ اتھ آبس کھُلو دِوان۔ آبس یہِ کھُلو لگنہٕ پتہٕ یُس تہِ گۅڈنیُک نفر اتھ حوضس منٛز وسہِ ہے سُہ اوس پننہِ کُنتہِ مرضہٕ نِش شِفا لبان۔
\v 5 أتھؠ بیت حسدا ناوکس حوضس پٮ۪ٹھ اوس اکھ نفر یُس پتمیٚو ارتٲجہو ؤرؠ یو پٮ۪ٹھٕ پنٕنؠ مرض للہٕ وان اوس۔
\v 6 یسوعؔ وُچھ یہِ مریض اتہِ ڈاپھ ترٲوِتھ تہٕ زونُن زِ یہِ چُھ اتہِ واریاہ کالہٕ پٮ۪ٹھٕ پراروُن۔ تٔمؠ پرُوژھ أمِس نفرس، "کیاہ ژٕ چُھکھا بلُن یژھان؟
\v 7 أمؠ مریضن ووٚنُس اورٕ، "جناب مےٚ چُھنہٕ کانٛہہ تہِ یُس مےٚ یتھ آبس منٛز کھلو لگنہٕ پتہٕ دکہٕ دِیہ ہے۔ میانہِ اور واتنہٕ برونٛہےٕ چُھ کانٛہہ نتہٕ کانٛہہ اتھ منٛز وتھمُت آسان تہٕ بلیومُت آسان۔ لہٰذا کتہِ بلہٕ بہٕ۔
\v 8 یسوعؔ ووٚنُس، "ووٚتھ تھوٚد۔ تُل پنٕنؠ یہِ وۅتھرٕنؠ راد تہِ یتھ پٮ۪ٹھ بیہِتھ چُھکھ تہٕ دِ قدم تہٕ لاگ پکُن۔
\v 9 یسوعؔن بلروو یہِ شخص امی دمہٕ تہٕ أمؠ نفرن تُج پنٕنؠ وۅتھرٕنؠ راد تہٕ دراو۔ یہِ سپُد یہودٮ۪ن ہنٛدِ آرامہٕ کہِ دوٚہہ یتھ سبت ونان چھِ۔
\v 10 چونکہِ یہِ اوس یہودٮ۪ن ہنٛدِ آرامُک دوٚہہ، یہُودؠ زِٹھیٚو ووٚن أمِس نفرس یُس یسوعن بٔلروو، "از چُھ آرامُک دوٚہہ۔ ژےٚ چھُے نہٕ أزکہِ دوٚہہ پننہِ وۅتھرنہِ تُلنُک اجازت تکیازِ یہِ گٔیہٕ کٲم۔
\v 11 یسوعؔ سٕنٛدؠ دٔسؠ بلیمٕتؠ نفرن ونُکھ یورٕ، "تٔمؠ نفرن یمؠ بہٕ بلرووُس ووٚن مےٚ یہِ وۅتھرٕنؠ راد تُلنہٕ باپتھ تہٕ پکنہٕ باپتھ۔
\v 12 یِمو یہُودؠ زِٹھیٚو پرُژھُس" کٔمؠ وۅنُے ژےٚ یہِ پنٕنؠ راد تُلنہٕ باپتھ تہٕ پکہٕ باپتھ۔
\v 13 بہرحال یسوعؔ سٕنٛدِ أمِس بلرٲوؠ مٕتِس نفرس ٲس نہٕ خبرےٕ زِ سُہ کٔمؠ بلروو تکیازِ یسوعؔ اوس لۅتہِ پٲٹھؠ کٲنٛسہِ ہنٛزن أچھن منٛز ینہٕ ورٲے درامُت۔
\v 14 کینژِ کٲلؠ وُچھ یسوعنؔ یہِ بلیومُت نفر ہیکلس، عبادت گاہ، منٛز تہٕ ووننس۔ ؤنؠ چُھکھ ژٕ اوٚر۔ یُتھنہٕ یمہِ اپور کانٛہہ اتُر وتُر کرکھ تہٕ کینٛہہ پرانہِ مرضہٕ کھۅتہٕ ووکھٕ مرض گٔژھۍ اگادِ۔
\v 15 یہِ نفر دراو تہٕ ووت یہودٮ۪ن نِش تہٕ ووننکھ، "سُہ نفر یمؠ بہٕ بلرووُس چُھ یسوعؔ۔
\v 16 لہٰذا لوگ یہُودؠ زِٹھیٚو یسوعؔ تنگ کرُن تکیازِ سُہ اوس معجزٕ کٔرِتھ یہُودؠ مزہبی رسمہٕ حسابہٕ آرامکہ دوٚہہ لوٗکن بلراوان۔
\v 17 یسوعؔ ووٚن یمن یہُودؠ لوٗکن، "میون مول خدا تہِ چُھ از کامہِ منٛزےٕ لہٰذا چُھس بہٕ تہِ کٲم کران۔
\v 18 یہِ وننہٕ کِس نتیجس منٛز لٔگؠ یہُودؠ زِٹھؠ أمِس ورٲے پتہٕ مارنہٕ باپتھ۔ یہِ زن یمو برونٛہہ تہِ کوٚرمُت اوس۔ تِم ٲسؠ یژھان أمِس مارُن تکیازِ سُہ اوس نَہ صرف تِمن پتھ لگتھ آرام کٮ۪ن دوہن اِنکار کران بلکہ اوس تسُنٛد مول یہِ ؤنِتھ زِ خدا چُھ خدایس برابر۔
\v 19 یمن الفرامن پٮ۪ٹھ یسوعؔن ووٚن یِمن یہُودؠ زِٹھٮ۪ن، "بہٕ چُھسو پزر ونان۔ بہٕ تسُنٛد نیٚچو ہیٚکنہٕ پننہِ اِرادٕ یا حکمہٕ کہین کٔرِتھ۔ بہٕ ہیٚکہٕ تی کٔرِتھ یہِ بہٕ خدا پنُن مول وچُھن کران۔ یہِ کینژھا مول کرِ۔ بہٕ تسُنٛد نیٚچو تہِ چُھس تی کران۔
\v 20 یہِ چُھ پوٚز تکیازِ مول چُھ مےٚ نیٚچوِس لول بران۔ تہٕ مےٚ چُھ تمہ پرٮ۪تھ کامہِ نِشہ زٲنؠ یاب کران یہِ سُہ کران چُھ۔ مول کرِ مےٚ تِمو معجزٲتی کامٮ۪و نِش تہِ با خبر یِمہٕ تِمو معجزو کھۅتہٕ عظیم آسن یِم بہٕ ازتام کران رودُس۔ تاکہِ توٚہؠ روزیٚو ششدر۔
\v 21 یہِ سپدِ تکیازِ بہٕ تسُنٛد نیٚچو بخشہِ پوشوٕنؠ زندگی تِمن سارنےٕ یِمن بہٕ یژھٕ تِتھے پٲٹھؠ یتھٕ پٲٹھؠ زن مول مودؠ مٕتٮ۪ن دُبارٕ زندگی بخشان چُھ۔
\v 22 یہِ چُھ پوٚز تکیازِ مول چُھنہٕ کٲنسے پرکھاوان۔ یہِ عدالتہٕ لاگنچ کٲم چھےٚ تٔمؠ مےٚ دِژمٕژ۔
\v 23 مٲلؠ کوٚر یہِ تاکہِ سٲری کرن مےٚ عزت۔ تسٕنٛدِس نیٚچوِس یتھٕ پٲٹھؠ لوٗکھ میٲنِس مٲلِس عزت بخشان چھِ۔ سُہ کانٛہہ تہِ یُس نہٕ مےٚ عزت کرِ چُھنہٕ میٲنِس مٲلِس تہِ عزت کران یمؠ بہٕ یور زمیٖنہِ پٮ۪ٹھ سوزُس۔
\v 24 بہٕ چُھسو توٚہہِ لوٗکن پوٚز ونان۔ سُہ پرٮ۪تھ کانٛہہ زوٚن یُس مےٚ مانان چُھ میٲنؠ تعلیم مانان چُھ تہٕ تس خدایس پٮ۪ٹھ پژھ تھاوِ یمؠ بہٕ سوزُس۔ روزِ ہمیشہٕ ہمیشہٕ جنتس تہٕ آسمانن پٮ۪ٹھ پوشہٕ وٕنہِ زندگی سان۔ تہٕ خدا ٹھہراوِ نہٕ تس گناہ گار۔ بلکہ آسہ یُتھ نفر روحٲنی طور مۅردٕ بدلہ روحٲنی طور زندٕ۔
\v 25 بہٕ چُھسو توٚہہِ پوٚز ونان۔ وقت چُھیِنہٕ وول بوزوے تہٕ سُہ وقت چُھ پزی ووتمُت ییٚلہِ مودمٕتؠ لوٗکھ تہِ میٲنؠ آواز بوزن۔ خدا سٕنٛدِ گۅبرٕ سنٛز آواز۔ تہٕ یِم تہِ یہِ میٲنؠ آواز بوزن پراون پوشوٕنؠ زندگی۔
\v 26 یہِ چُھ پوٚز تکیازِ مول ہیٚکہِ لوٗکن زندٕ کٔرِتھ تِتھے پٲٹھؠ یتھٕ پٲٹھؠ تٔمؠ مےٚ پننِس نیٚچوِس لوٗکن زندٕ کرنچ صلٲحیت بخشؠ۔
\v 27 ببن بخُش مےٚ اختیار تمام انسٲنؠ زُریٲژ عدالت لاگنُک تکیازِ بہٕ چُھس آدمؔ سُنٛد اولاد۔
\v 28 حٲرام مٕہ گٔژھِو زِ مٲلؠ کوٚر یہِ۔ اکھ وقت آسہ ییٚلہِ سٲری مودمٕتؠ میٲنؠ آواز بوزن۔
\v 29 ادٕ یِن یِم پنٮ۪و قبرو منٛزٕ نیرؠ۔ خدا تُلہِ تِمن زِنٛدٕ یِمو رٕژرچہِ کامہِ آسن کرِمژٕ۔ تہٕ بخشٮ۪کھ پوشوٕنؠ زندگی۔ مگر خدا تُلہِ تِمن تہِ یِمو شَرچہِ کامہِ آسن کرمژٕتاکہِ تِمن دِیہ سزا ہمیشہٕ پوشوُن سزا۔
\v 30 بہٕ ہیٚکنہٕ پانہٕ کِہین کٔرِتھ۔ بہٕ لاگہٕ عدالت تٔتھؠ پٮ۪ٹھ یہِ بہٕ بوزٕ مٲلِس نِش تہٕ بہٕ لاگہٕ انصاف واجِنؠ عدالت۔ تکیازِ بہٕ چُھس نہٕ پننہِ مرضی کینٛہہ کران۔ یہِ تہِ بہٕ یژھٕ بلکہ چُھس بہٕ تی کران یہِ مےٚ مول یمؠ بہٕ یور سوزُس ونہٕ کرُن۔
\v 31 یوٚدوے بہٕ کُنے زٚن آسہ پٲنؠ پانس پٮ۪ٹھ گواہ موسیٰؔ سٕنٛدِ شریعتہٕ مطٲبق میٲنؠ گوٲہی روزِ پانہٕ معتبر۔
\v 32 گر مےٚ چھنہٕ کٲنٛسہِ دوٚیمہِ سنٛز گوٲہی حاجت۔ بہٕ چُھس یہِ توٚہہِ ونان بپتسمہ دِنہٕ وٲلِس یوحناہسؔ متعلق تاہِ خدا کٔریٚو توٚہہِ بخشش۔ بہر حال اکھ نفر چُھ یُس مےٚ متعلق گوٲہی دِوان چُھ تہٕ بہٕ چُھس زانان زِ مےٚ متعلق تس سنٛز گوٲہی چھےٚ معتبر۔
\v 33 توٚہہِ یہُودؠ زِٹھیٚو سوزِو بپتسمہ دِنہٕ وٲلِس یوحناہسؔ واریاہ نادس تہٕ تٔمؠ وننہٕ نٔو توٚہہِ مےٚ متعلق پزر۔
\v 34 گز زِ مےٚ چھنہٕ کٲنٛسہِ ہنٛز گوٲہی حاجت مگر بہٕ چُھس یہِ بپتسمہ دِنہٕ وٲلِس یوحناہسؔ متٮعلق ونان تاکہِ خدا بخشہِ توٚہہِ نجات۔
\v 35 بپتسمہ دِنہٕ وول یوحناؔ یُس خدایہِ سُنٛد پزر توٚہہِ باوان چُھ چُھ زٲنؠ تو اکھ پرٮ۪زلوُن ژونگ۔ توٚہؠ ٲسِو امہِ کِس گاشس منٛز کینٛہہ برنٛز خوشی سان روزنس تیار۔ یہِ اوس سُہ پزر یمیُک تٔمؠ اعلان کوٚر۔
\v 36 بہر حال بہٕ چُھس توٚہہِ یہِ یوحنا سنٛز گوٲہی کھۅتہٕ تہٕ بوٚڈ تہٕ معتبر گوٲہی پیش کران پانس متعلق تکیازِ یہِ گوٲہی چھےٚ تِمن معجزٲتی کامٮ۪ن ہنٛز یِمہٕ مےٚ خداین انجام دِنُک اجازت بخُش۔ یِمہٕ میانہِ دٔسؠ کرنہٕ یِنہٕ واجنہِ کامہِ چھےٚ ثبوت زِ بہٕ چُھس پانہٕ پنٕنؠ مٲلؠ سوزمُت
\v 37 امہِ مزید چُھ میون مول یمؠ بہٕ یور سوزُس پانہٕ تہِ گوٲہی دِوان مےٚ متعلق۔ پزر چُھ توٚہہِ منٛزٕ چھنہٕ کٲنٛسہِ تہِ تس سنٛز آواز بوزمٕژ یا سُہ دیدمان وُچھمُت زِ سُہ کیُتھ چُھ۔
\v 38 توٚہؠ چُھو نہٕ ببہٕ سنٛز تعلیم تہِ مانان۔ مےٚ چھے پتاہ یہِ چُھ پوٚز تکیازِ توٚہہِ چھنہٕ پژھ مےٚ پٮ۪ٹھ یُس خداین پانہٕ سوز۔
\v 39 توٚہؠ چُھو پانہٕ مقدس کتابہٕ ژٮ۪تھ دِتھ پران تاکہِ توٚہؠ پرٲیو پوشوٕنؠ زندگی۔ یمے مقدس کتابہٕ چُھو توٚہہِ ونان بہٕ کُس چُھس۔
\v 40 تہٕ توتہِ چُھو توٚہؠ میٲنؠ شٲگرد بننس اِنکار کران تاکہِ توٚہؠ لبیٚو پوشہٕ وٕنؠ زندگی۔
\v 41 بہٕ چُھس نہٕ کٲنٛسہِ، لوٗکن، ہنٛدِس عزتس مازان۔
\v 42 بہرحال چُھس یہِ زانان زِ توٚہؠ چُھو نہٕ خدایس لول بران۔
\v 43 بہٕ چُھس خدا سٕنٛدِ حُمہٕ تہٕ اختیارٕ آمُت مگر توتہِ چُھو نہٕ توٚہؠ مےٚ مانان۔ یوٚدوے بدل کانٛہہ پننہِ اختیارٕ تہٕ حکمہٕ آسہ ہے آمُت توٚہہِ آسہ ہیٚو سُہ قبول کوٚرمُت۔
\v 44 توٚہؠ چُھو نہٕ مےٚ شاید پژھ یٮ۪کان کٔرِتھ تکیازِ توٚہؠ چُھو اکھ أکِس عزت کران بجایہ أکِس کُنِس خدا سُنٛد عزت حٲصل کرنہٕ نِش۔
\v 45 یہِ مٕہ زٲنِو زِ بہٕ آسہ کُنے زوٚن پیش مٲلِس نِش توٚہہِ راہ کھالن وول بلکہ سُہ موسیٰؔ یُس تُہنٛز امید، تہنٛز سفٲرش بنہِ آسہ پانہٕ توٚہہِ راہ کھالن وول۔
\v 46 سُہ کھالیٚو توٚہہِ راہ تکیازِ یوٚدوے توٚہہِ موسیٰؔ ہس پٮ۪ٹھ پژھ آسہ ہے یوسہٕ توٚہہِ چُھو نہٕ توٚہہِ آسہ مےٚ پٮ۪ٹھ پژھ تکیازِ موسیٰؔ ہن اوسو توٚہہِ وارٕ ووٚنمُت پننہِ توراتہِ منٛز۔\f + \fr 5‏:46 \ft لوقا 24:27\f*
\v 47 چونکہِ توٚہہِ چُھو نہٕ موسیٰؔ سٕنٛدِ لیٚکھؠ مِتِس پٮ۪ٹھ تہِ پژھ۔ شاید کٔرٕو نہٕ توٚہہِ پژھ میٲنِس وننس پٮ۪ٹھ تہِ۔
\c 6
\p
\v 1 یِمو سارِوٕے واقہو پتہٕ توٚر یسوعؔ گلیلؔ ہنٛدِس سٕدرس اپور۔ یتھ کینٛہہ لوٗکھ تبریاس ناوکہِ سٕدر تہِ زانان چھِ۔
\v 2 اکھ لُکہٕ ارساتھا پوٚک أمِس پتہٕ پتہٕ تکیازِ یِمو اوس سُہ معجزٕ کران وُچھمُت۔ یعنی سٮ۪ٹہہے بٮ۪مار لوٗکن بلراوان۔
\v 3 یسوعؔ کھوٚت أکِس بالہٕ ٹینگس تہٕ بیوٹھ پنٕنؠ شٲگرد ہٮ۪تھ أتی۔
\v 4 أتھؠ وقتس منٛز ٲس یہودٮ۪ن ہنٛز عید فسح کلس پٮ۪ٹھ۔
\v 5 یسوعؔن تُل کلہٕ تھوٚد تہٕ وُچُھن اکھ تہٕ لُکہٕ ہجوم تٔسؠ کُن پکان۔ تٔمؠ پرُوژھ فلپسس۔ یِمن یتٮ۪ن لوٗکن ہنٛدِ باپت کتہِ انو أسؠ مٔلؠ ژوٚٹ؟
\v 6 تٔمؠ پرُوژھ یہِ سوال فلپسس چھرا تس سنٛزِ پژھِ ہُنٛد درٮ۪ر وُچھنہٕ باپتھ۔ نتہٕ ٲس تمِس پتاہ اتھ مسلس کیاہ چُھ تمِس کرُن۔\f + \fr 6‏:6 \ft اکھ دینار اوس أکس گٲمی مُزورٕ سنٛزِ اکہِ دوٚہچہِ مُزورِ برابر۔\f*
\v 7 فلپسن ووٚنُس یورٕ، "یوٚدوے اسہِ أکِس انسان سنٛزِ دوٚن ہتن دوٚہُن ہنٛز کمٲیی تہِ اتھس منٛز آسہ، أسؠ ہیٚکو نہٕ یِمن یتٮ۪ن لوٗکن اکھ ژوچہِ کٔھنٛڈ تہِ دِتھ۔ توٚہہِ پزِ یِمن کینٛہہ کھؠنہٕ خٲطرٕ دیُن۔
\v 8 دوٚیِم شٲگرد شمعونؔ پطرس سٕنٛدؠ بٲے اندریاسنؔ ووٚن یسوعسؔ۔
\v 9 أکِس لڈکس چھِ یتہِ پانٛژھ جَوچہِ ژۅچہِ تہٕ زٕ لۅکچہ گاڈٕ۔ مگر توتہِ چھنہٕ یِمہٕ کٲفی یتٮ۪ن لوٗکن ہنٛدِ باپتھ۔
\v 10 یسوعنؔ ووٚن پننٮ۪ن شٲگردن زِ تِم بیہناون لوٗکن پتھر۔ الہٕ پلہٕ بیٹھؠ اتہِ پانٛژھ ساس لوٗکھ۔ اتہِ اوس واریاہ گاسہٕ لوٗکن ہنٛدِ بیہنہٕ باپتھ
\v 11 یسوعنؔ تُلؠ امہِ پتہٕ جَو آٹِکؠ لواسہٕ تہٕ کوٚرُن خدایہِ سُنٛد شکُر ادا امہِ غذا باپتھ۔ امہِ پتہٕ دِتؠ تٔمؠ تہٕ تسٕنٛدیٚو شاگردو یِم لواسہٕ کھنٛجہِ پرٮ۪تھ کٲنٛسہِ یِم گاسس پٮ۪ٹھ بیہِتھ ٲسؠ کھیٚنہٕ باپتھ۔ تِمن دوٚن گاڈن سٟتؠ تہِ کوٚرُن یی۔ لوٗکو کھییہِ یِم گاڈٕ تہٕ لواسہٕ ییتیاہ کھیٚنؠ ٲسِکھ۔
\v 12 ییٚلہِ سارِوٕے یڈ بٔرِتھ کھیو یسوعنؔ ووٚن پننٮ۪ن شٲگردن زِ پیٚمٕتؠ گاڈٕ تہٕ لواسہٕ کھنٛجہِ سمبرٲیو تاکہِ کانٛہہ رژھ تہِ گژھِ نہٕ ضایع۔
\v 13 امسنٛدیٚو شاگردو کرِ سارے پتھر پیمژٕ کھنٛجہِ تہٕ پتھ کُن رودمُت ٹُکرٕ جمع تہٕ یتھٕ پٲٹھؠ باہ 12 ٹوکرِ برِ نہٕ تِمو کھنجو سٟتؠ یِم لوٗکن ؤسؠ پیمژٕ آسہ یا کھیٚنے روزمژٕ آسہ۔
\v 14 ییٚلہِ لوکو دیدمان یہِ معجزٕ وُچھ یُس یسوعنؔ کوٚرمُت اوس تِمو ووٚن، "پزی چُھ یہِ خدایہِ سُنٛد رسول یُس تٔمؠ پننہِ وعدہ حسابہٕ دُنیاہس منٛز سوز۔
\v 15 ییٚلہِ یسوعنؔ زون زِ یِم لوٗکھ چھِ زبردستی تس پنُن بادشاہ بنون وٲلؠ تٔمؠ ترٲوؠ تِم بیٚیہِ تہٕ کھوٚت بالس تاکہِ سُہ ہیٚکہِ کُن زوٚن روزِتھ۔
\v 16 ییٚلہِ شام ووت، یسوعنؔ سٕنٛدؠ شٲگرد ؤتھؠ بالہٕ پٮ۪ٹھٕ گلیل ہنٛدِس سٕدرس کُن۔
\v 17 تِم ؤتھؠ وانِ تہٕ لوگُکھ ناوِ کفرنحوم شہرس کُن لمُن۔ راتھ ٲس واریاہ گٔٹ تہٕ یسوعنؔ اوسنہٕ وُنہِ یِمن نِش ووتمُت۔
\v 18 چونکہِ واو اوس شوریومُت تہٕ سدر اوس خشمناک طوفانس منٛز۔
\v 19 ییٚلہِ یسوعؔ سنٛدیو شاگردو پنٕنؠ ناو سٕدرس منٛز ساڈ ژور یا ساڈ پانٛژھ کلومیٹر تام پکنٲومٕژ ٲس تِمو وُچھ یسوعؔ آبہٕ پیٚٹھؠ پکان تہٕ تِمن نِش واتن وول۔ یِم شٲگرد کھوژؠ۔
\v 20 یسوعؔ ہن ونُکھ۔ یہِ چُھس بےٕ یسوعؔ۔ کھوٚژُن ترٲیِو۔
\v 21 تِم سپٕدؠ یسوعسؔ ناوِ منٛز انِتھ واریاہ خوش۔ یِتھُےٕ سُہ ناوِ منٛز ژاو تہنٛز ناو پیٚہِ تتھ مقامس وٲتِتھ یوٚت تِمن گژھُن اوس۔
\v 22 تمہِ دوٚہہ پتہٕ ییٚلہِ یسوعؔن اکھ تہٕ لوٗکہٕ ہجوم کھیاونوو۔ امؠ ہجومن یُس سٕدر کِس یپٲرمِس بٔٹھِس پٮ۪ٹھ رود۔ سونچ زِ یتہِ چھے ناو اکے تہٕ یسوعؔ بیوٹھ نہٕ ناوِ منٛز کینٛہہ پننٮ۪ن شٲگردن سٟتؠ۔
\v 23 لوٗکھ آے تِبریاسؔ شہرٕ پٮ۪ٹھٕ بدل ناون منٛز۔ تِمو گنجہِ پننہِ ناوٕ تتھ جایہِ نکھے یتنس لوٗکو یسوعؔ سٕنٛدِس خدایس شکرانہٕ ادا کرنہٕ پتہٕ ژوٚٹ کھیمٕژ ٲس۔
\v 24 لہٰذا ییٚلہِ ہجومن ژیون زِ نَہ چُھ اتہِ یسوعؔ تہٕ نَہ تسٕنٛدؠ شٲگرد۔ تِم ؤتھؠ یِمنےٕ ناون منٛز تہٕ لوگُکھ کفرنحوم شہرس کُن پکن یسوعؔ وُچھنہٕ باپتھ۔
\v 25 تِمو وُچھ یسوعؔ کفرؔ نحُوؔم شہرس منٛز گلیل سٕدرس تتھ جایہِ سیدِ سیٚود اپارِ۔ یتنس تٔمؠ یِم لوٗکھ کھیٲومٕتؠ ٲسؠ تِمو پرُژھ یسوعؔس، "استاد اسہِ چھےٚ خبر توٚہؠ ٲسِو نہٕ شٲگردن سٟتؠ ناوِ منٛز توٚہؠ کر وٲتیٚو یور کفرنُحوم۔
\v 26 یسوعسؔ ونُکھ، "بہٕ چُھسو پوٚز ونان۔ توٚہؠ چُھو نہٕ مےٚ ژھاران زِ توٚہہِ وُچھو دیدمان تمہ معجزٕ یِم یمؠ کٔرؠ۔ بلکہ چُھو توٚہؠ مےٚ ژھاران چھرا اوٕ کِنؠ زِ توٚیؠ کھیٚیِو یڈ بٔرِتھ تِم لواسہٕ یِم مےٚ توٚہہِ دِتؠ۔
\v 27 کھیٚنہٕ باپتھ ژھٲر ترایو یتی۔ یہِ ہوٚژِ ؤلؠ ؤلؠ۔ امہِ بدلہٕ ژھٲرِو تہٕ گٲرِو سُہ کھیٚن یُس توٚہہِ پوشوٕنؠ زندگی دِیو۔ سُہ کھیٚن دِمہٕ ہو بہٕ آدمؔ سُنٛد گۅبُر چھرا ہیٚکہٕ ہو بےٕ یوت سُہ غذا دِتھ۔ تکیازِ میون مول خدا چُھ اتھ منظور کران۔
\v 28 امہِ پتہٕ پرُژھ أمؠ ہجومن یسوعسؔ، "أسؠ کۅس کٲم کرو خدایس خوش کرنہٕ باپتھ۔
\v 29 یسوعسؔ ونُکھ یور، "سۅ کٲم یۅسہ خدا چُھو توٚہہِ کرناوٕنؠ یژھان چھے یہِ پژھ کٔرِو مےٚ پٮ۪ٹھ یُس تٔمؠ سوز۔
\v 30 ہجومن پرُژھُس مزید، "تیٚلہِ کُس معجزٕ کٔرِو توٚہؠ سانہِ باپتھ یُس أسؠ تہِ وُچِھتھ ہیٚکو تہٕ کرو ژےٚ پٮ۪ٹھ پژھ۔
\v 31 سانہِ باپتھ کیاہ کٔرِو توٚہؠ۔ سانیٚو اجدادو کھیو مَنّ ییٚلہِ تِم بیابانن منٛز پھیران ٲسؠ موسیٰؔ ہس سٟتؠ۔ یہِ زن نبی نوشتن منز لٮ۪کھان چھِ۔ خداین دِژ تِمن ژوٚٹ کھیٚنہٕ باپتھ آسمانو پٮ۪ٹھٕ۔\f + \fr 6‏:31 \ft مزامیر 78:24\f*
\v 32 یسوعنؔ ووٚن تِمن، "بہٕ چُھسو پزر ونان۔ یہِ اوس نہٕ موسیٰؔ یمؠ تہنٛدٮ۪ن جدن اجدادن کھیٚنہٕ باپتھ آسمانہٕ پٮ۪ٹھٕ ژوٚٹ دِژ۔ نَہ۔ بلکہ اوس سُہ میون مول یُس ؤنؠ توٚہہِ پزؠ ژوٚٹ آسمانٕچ دوان چھِ۔
\v 33 یہِ چُھ پوٚز تکیازِ خدایہِ سٕنٛدِ طرفہٕ پٔزؠ ژوٚٹ چھے آسمانہٕ وسؠ مژ تہٕ سۅ دِیہ پوشوٕنؠ زندگی دُنیہکٮ۪ن لوٗکن۔
\v 34 لوٗکن توٚگ نہٕ زانہٕ نُے تسٕنٛدِ وننُک مطلب۔ اوے ونُکھ یسوعسؔ، "جناب، مہربٲنی کریتھ دیو اسہِ یہےَ ژوٚٹ ہمیشہِ۔"
\v 35 یسوعنؔ ووٚن ہجومس یورٕ، "یتھٕ پٲٹھؠ ژوٚٹ جمٲنؠ زندگی رچھان چھےٚ۔ بہٕ چُھس سۅ ژوٚٹ یۅسہ پوشوٕنؠ زندگی دِیہ۔ یُس نہٕ کانٛہہ تہِ بیاکھ کھیٚن چٮ۪ن دِتھ ہیٚکہِ یُس تہِ مےٚ پٮ۪ٹھ پژھ تھاوِ سُہ لبہِ ہمیشہٕ باپتھ تسلی سُہ روزِ ہمیشہٕ سیتر۔
\v 36 حالانکہ مےٚ وونو توٚہہِ یمہِ برونٛہہ تہِ زِ یوٚدوے توٚہؠ مےٚ رچھان چُھو توٚہہِ چُھو نہٕ تتہِ مےٚ پٮ۪ٹھ پژھ۔
\v 37 عام لوٗکھ یِم مےٚ پنُن مول دٕبہ واتن مےٚ نِش تہٕ بنن میٲنؠ شٲگرد تہٕ بہٕ کرکھ نہٕ تم ہرگز پانس دوٗر۔
\v 38 بہٕ کرنہٕ ہرگز یہِ۔ بہٕ چُھس نہٕ آسمانہٕ وتھمُت تہٕ کرنہِ یہِ مےٚ پنٕنؠ مرزی آسہ۔ بلکہ وتھُس بہٕ تے کرنہِ یہِ میون مول یمؠ بہٕ یور سوزُس یژھان چھِ مےٚ کرناوان۔
\v 39 یہِ چُھ تہٕ یہِ میون مول یمؠ بہٕ سُہ چُھ یژھان تٔمؠ سٲری رژھراوٕنؠ۔ یِم مےٚ تٔمؠ دِتؠ سُہ چُھ یژھان یِم سٲری زندٕ کرٕنؠ بیٚیہِ تِم ٲخری دوٚہہ ییٚلہِ بہٕ ہر کٲنٛسہِ عدالت لاگہٕ۔
\v 40 یہِ چُھ پزر تکیازِ یہِ چُھ تی یہِ میون مول یژھان چُھ۔ سُہ چُھ یژھان سُہ پرٮ۪تھ کانٛہہ یُس پرٮ۪زناوان چُھ بہٕ نیٚچو کُس چُھ تہٕ مےٚ پٮ۪ٹھ پژھ تھاوان چھِ۔ روزِن ہمیشہٕ باپتھ زندٕ مےٚ سٟتؠ آسمانن پٮ۪ٹھ۔ بہٕ کرکھ یِم زندٕ بیٚیہِ ٲخری دوٚہہ ییٚلہِ بہٕ عدالت لاگہٕ۔
\v 41 یہُودؠ زِٹھیٚو لوگ یسوعسؔ متعلق اورُک یورُک ونُن تکیازِ تٔمؠ اوس ووٚنمُت زِ سُے چُھ پزنہٕ پٲٹھؠ سۅ ژوٚٹ یۅسہ آسمانہٕ پٮ۪ٹھٕ ؤژھ۔
\v 42 تٔمؠ لوگ اکھ أکس ونُن، "یہِ چُھ صرف یسوعؔ یوسفُنؔ نیٚچو! امسنٛدِس مٲلِس ماجہِ متعلق چھےٚ اسہِ پتاہ۔ یہِ چُھنہٕ ممکن زِ سُہ کیاہ آسہ آسمانہٕ وتھمُت۔ یہِ زن سُہ پانے ونان چُھ۔
\v 43 یسوعنؔ ووٚن أمِس، "پانہٕ وٲنؠ کٔرِو یہِ شور وور بنٛد یہِ زن مےٚ وۅنُو توٚہہِ۔
\v 44 چھرا ہیٚکن مےٚ متعلق تِمے کینٛہہ ؤنِتھ یِم میٲنؠ مٲلؠ یمؠ بہٕ یور سوزُس مےٚ نِش سوزؠ۔ میٲنؠ شٲگرد بننہٕ باپتھ۔ تِمے چھِ کینٛہہ وننس لایق تہِ۔ بہٕکرکھ مےٚ نِش یِنہٕ وٲلؠ یِم لوٗکھ ٲخرتس پٮ۪ٹھ بیٚیہِ زِنٛدٕ ییٚلہِ بہٕ سارِنےٕ پنٕنؠ عدالت لاگہٕ۔
\v 45 رسولو چُھ ووٚنمُت زِ خدا ہٮ۪چھناوِ سارِنےٕ پانے۔ سُہ پرٮ۪تھ کانٛہہ یُس میٲنِس مٲلؠ سنٛز کتھ بوزِ تہٕ ہٮ۪چھِ واتہِ مےٚ نِش تہٕ بنہِ میون شٲگرد۔\f + \fr 6‏:45 \ft یسعیاہؔ 54:13\f*
\v 46 میانہِ ورٲے چُھنہٕ بیٚیہِ کٲنٛسہِ میون مول وُچھمُتےٕ۔ بہٕ فقط آس بےٕ خدایہِ سٕنٛدِ پٮ۪ٹھٕ۔ بہٕ چُھس سُہ کُن زوٚن یمؠ سُہ وُچھ۔
\v 47 بہٕ چُھسو پوٚز ونان یُس تہِ مےٚ پٮ۪ٹھ پژھ قٲیِم کرِ سُہ پراوِ پوشوٕنؠ زندگی مےٚ سٟتؠ جنتس منٛز
\v 48 بہٕ چُھسو پوٚز تہٕ حقیقی ژوٚٹ یۅسہ ابدی زندگی بخشہِ۔
\v 49 تہنٛدیٚو جدو اجدادو کھیٚو مَنّ ییٚلہِ تِم پھیران ٲسؠ بیابانن منٛز موسیٰؔ ہس سٟتؠ مگر تِم مودؠ توتہِ۔
\v 50 مگر یمہِ ثۅچہِ ہنٛز کتھ بۅ کران چُھس وژھ آسمانہٕ پٮ۪ٹھٕ تاکہِ کانٛہہ کھیٚیہِ اتھ تہٕ تس انسان سُنٛد روح مرِ نہٕ زانہٛہ۔
\v 51 بہٕ چُھس پزی سۅ ژوٚٹ یۅسہ پوشوٕنؠ زندگی دِیہ تہٕ یۅسہ آسمانہٕ ؤژھ۔ سُہ ہر کانٛہہ نفر یُس اتھ ژۅچہِ کھیٚیہِ پراوِ پوشوٕنؠ زندگی مےٚ سٟتؠ آسمانس پٮ۪ٹھ۔ میون یہِ بدن تہِ چُھ سُے ژوٚٹ۔ بہٕ دِمہٕ یہِ پنُن بدن چھپہِ یتھ دُنیاہن منٛز سارِنےٕ ہنٛز پوشوٕنہِ زندگی باپتھ۔
\v 52 یہُودؠ زِٹھیٚو لوگ ؤنؠ پانہٕ وٲنؠ اکھ أکِس سٟتؠ واد واد۔ تِمو ووٚن یہِ نفر ہیٚکنہٕ ہرگِز پنُن بدن سانہِ کھیٚنہٕ باپتھ دِتھ۔
\v 53 اوے ونُکھ یسوعنؔ بہٕ چُھسو پوٚز ونان توٚہہِ پزِ میون آدمؔ سٕنٛدِ گۅبرٕ سُنٛد یہِ ماز کھیوٚن۔ تہٕ أمؠ سُنٛد یہِ خوٗن چیوٚن یوٚدوے توٚہؠ یہِ کٔرِو نہٕ پوشوٕنؠ زندگی پرٲیو نہٕ ہرگِز۔
\v 54 کانٛہہ تہِ میون میانہِ بدنُک یہِ ماز کھیٚیہِ تہٕ خوٗن چیٚیہِ لبہِ ابدی زندگی مےٚ سٟتؠ جنتس منٛز۔ تہٕ بیٚیہِ کرن بہٕ سُہ دُبارٕ زندٕ ٲخرتس پٮ۪ٹھ ییٚلہِ بہٕ عدالت لاگہٕ
\v 55 تہٕ یی چُھ تکیازِ میون ماز چُھ پوٚز روحٲنی کھیٚن تہٕ میون رتھ پزی روحٲنی شربت۔
\v 56 یِم میون ماز کھیٚن تہٕ رتھ چٮ۪ن رلن مےٚ سٟتؠ تہٕ بہٕ رلہٕ تِمن سٟتؠ۔
\v 57 میون مول چُھ پرٮ۪تھ کٲنٛسہِ زندگی بخشان۔ تکیازِ تٔمؠ بنووُس بہٕ تہِ اتھ لایق۔ یتھے پٲٹھؠ یِم مےٚ پٮ۪ٹھ پلن روزن ہمیشہٕ زندٕ چُھ میانہِ کرنہٕ سٟتؠ۔
\v 58 بےٚ چُھس سۅ ژوٚٹ یۅسہ آسمانہٕ ؤژھ۔ یہِ ژوٚٹ چھنہٕ سۅ ژوٚٹ یۅسہ اسرائیلی جدو اجدادو کھیٚیہِ توتہِ مود ہر کانٛہہ۔ مگر یُس تہِ مےٚ یعنی یہِ ژوٚٹ کھیٚیہِ روزِ ہمیشہٕ زندٕ مےٚ سٟتؠ آسمانن پٮ۪ٹھ
\v 59 یسوعنؔ دِتؠ یِم بیان یہودٮ۪ن برونٛہہ کنہِ تہندِس ہیکلس منٛز کفرنحوم شہرس منٛز ییٚلہِ سُہ اتہِ پنٕنؠ تعلیم دِوان اوس۔
\v 60 ییٚلہِ تِمو یہِ بوز یہِ تٔمؠ ونُکھ واریہو یسوعؔ سنٛدیو شاگردو ووٚن، "یہِ یسوعؔ ونان چُھ تہٕ چُھ سٮ۪ٹھا مشکل ماننہِ ین۔ یقیناً کرِ نہٕ اتھ کانٛہہ منظور۔
\v 61 یوٚدوے تس ووٚن نہٕ کٲنسے یسوعؔ اوس زانان زِ تسٕنٛدؠ شٲگرد تہِ چھِ تسٕنٛدِس وننس پٮ۪ٹھ اورُک یورُک ونان۔ اوے پرُژھنکھ کیاہ میٲنؠ تعلیم چھا توٚہہِ ناگوار باسان۔
\v 62 یوٚدوے میٲنؠ تعلیم توٚہہِ ناگوار چھےٚ تیٚلہِ گژھِ توٚہہِ تہِ ناگوار۔ ییٚلہِ توٚہؠ مےٚ آدمؔ سٕنٛدِس گۅبرس آسمانس کھسان وُچھو یتہِ بہٕ اوسُس؟\f + \fr 6‏:62 \ft مزامیر 47:5\f*
\v 63 بس چُھ خدایہِ سُنٛد روح یس کٲنٛسہِ زپوشوٕنؠ زندگی دِتھ ہیٚکہِ۔ انسٲنؠ فطرت آسن چُھ مادس منٛز بے فٲیدٕ۔ یہِ بہٕ توٚہہِ ونان چُھس سُہ چُھ روح القدس تعلیم۔ تہٕ یی چُھ پوشوٕنؠ زندگی دِوان۔
\v 64 خبر کینٛہہ لوٗکھ چھِنہٕ توٚہہِ منٛز یہِ مانان۔ یہِ مےٚ ووٚن یسوعؔ اوس زانان برابر تمہِ دوٚہہ پٮ۪ٹھٕ ییٚلہِ أمؠ پنٕنؠ تعلیم دِنؠ شروع کرِ۔ زِ کُس کُس کرِ تس پٮ۪ٹھ پژھ تہٕ کُس دِیہ تمِس دغا۔
\v 65 اوٕ پتہٕ ونُکھ یسوعنؔ تکیازِ توٚہہِ منٛزٕ چُھنہٕ کانٛہہ مےٚ پٮ۪ٹھ پژھ تھاوان مےٚ ووٚن توٚہہِ برونٛہےٕ زِ تِمے یِمن خداین مےٚ کُن یِنچ صلٲحیت بخشؠ تہٕ میٲنؠ شٲگرد بننچ تِمنےٕ اسہِ یہِ صلٲحیت۔
\v 66 ییٚلہِ یسوعنؔ یہِ کینٛہہ سا ووٚن امسٕنٛدؠ واریاہ شٲگرد دراے واپس تٔتھؠ کامہِ کُن یُس تِم أمِس سمکھنہ برونٛہےٕ کران ٲسؠ تہٕ ترٲوٕکھ اڈٕ وتی امسنٛز شاگردی کرٕنؠ۔
\v 67 چونکہِ واریاہ ژٔلؠ اوے ووٚن یسوعنؔ پننٮ۪ن بہن شٲگردن کُن۔ یقیناً چُھو نہٕ توٚہؠ یژھان مےٚ ترٲوِتھ نیرُن۔ پزر چھا؟
\v 68 شمعونؔ پطرسن ووٚنُس یورٕ، "خداوند یوٚدوے اسہِ توٚہہِ ترٲوِتھ نیرُن آسہ ہے کانٛہہ تہِ چُھنہٕ ژےٚ ورٲے یمِس کُن أسؠ گژھو۔ چھرا چُھو توٚہؠ تعلیم دِوان یوٚسہٕ اسہِ پوشوٕنہِ زندگی کُن نِیِ آسمانن پٮ۪ٹھ۔
\v 69 اسہِ چھےٚ ژےٚ پٮ۪ٹھ پژھ۔ تہٕ أسؠ چھِ پزنہٕ پٲٹھؠ زانان زٕ توٚہؠ چُھو پاک یُس آسمانہٕ وتھمُت چُھ خدایہِ سٕنٛدِ طرفہٕ۔
\v 70 یسوعنؔ ونُکھ یورٕ، "بہٕ چُھس یقیناً توٚہہِ بہن نفرن ژاران مگر توٚہہِ منٛز چُھ اکھ نفر شیطان سنٛدِس حکمس تل۔
\v 71 ییٚلہِ یسوعنؔ ووٚن سُہ اوس کران کتھ یہُوداؔ سنٛز یُس شمعونؔ اِسکریوتی سُنٛد نیٚچو اوس۔ تکیازِ یوٚہے اوس بہو شاگردو منٛزٕ یُس بُتھِ پہن یسوعؔس دغا دِیہ۔
\c 7
\p
\v 1 یِمو سارِوٕے واقہو پتہٕ رود یسوعؔ گلیل ہنٛدِس علاقس منٛزےٕ پھیران۔ سُہ اوسنہٕ یژھٲنی یہُوداؔ کِس علاقس منٛز پھیرُن تھورُن۔ تکیازِ اتِکؠ یہُودؠ زِٹھؠ ٲسؠ أمِس کُنہِ ہیٖتہٕ مٲرِتھ ژھٕنہٕ نُک ژھل ژھاران۔
\v 2 امہِ وزِ ٲس یِمن یہودٮ۪ن ہُنٛد بوٚڈ مقدس دوٚہہ عیدِ خیام کلس پٮ۪ٹھ۔\f + \fr 7‏:2 \ft احبار 33۔36، 39۔43۔ تثنِیہ شرع 13۔15اتھ عیذ دوران ٲسؠ لوکھ پناہ گاہن منز روزان\f*
\v 3 یسوعسؔ ووٚن پننٮ۪و بایو، "وۅتھ نیر تہٕ گژھِ یہُوداؔ شہرس کُن۔ تاکہِ چٲنؠ سٲری شٲگرد وچُھن پانہٕ تہِ دیدمان پٲٹھؠ چانہِ دٔسؠ سپدن وٲلؠ معجزٕ۔
\v 4 پنٕنؠ معجزٕ ہاو یہداہو منٛز۔ دُنیاہس منٛز مشہور سپدنہٕ وول چُھنہٕ پنٕنؠ کارنامہٕ ژورٕ تھاوان۔ چونکہِ ژےٕ چُھکھ یِم معجزٕ کران۔ ہاو تہٕ باو ژٕ کیاہ چُھکھ پانس زانان تہٕ سمجھان۔"
\v 5 یسوعسؔ ووٚن یہِ پننیٚو بایو اوٕ کِنؠ تکیازِ تِم ٲسؠ نہٕ تسٕنٛدِس مسیحؔ آسنس پژھ کران۔
\v 6 چونکہِ تِمن ٲسنہٕ پژھ۔ یسوعنؔ ووٚن تِمن، "یہِ چُھنہٕ منٲسب موقعہ یروشِلم گژھنُک۔ ؤنؠ گو توٚہؠ ہیٚکو کُنہِ وزِ تہِ گٔژھِتھ۔
\v 7 دُنیہکٮ۪ن لوٗکن چُھنہٕ تُہنٛد کانٛہہ عداوت مگر مےٚ سٟتؠ چُھکھ تکیازِ بہٕ چُھسکھ ونان زِ توٚہؠ چُھو غلطس پٮ۪ٹھ۔
\v 8 توٚہؠ گٔژھۍٚو یروشلم یہِ دوٚہہ مناونہٕ باپتھ۔ بہٕ چُھس نہٕ وُنہِ اور گژھنٛنہٕ باپتھ تیار۔ یہِ چُھنہٕ میانہِ باپتھ منٲسب وق"
\v 9 پننٮ۪ن باین یہِ وننہٕ پتہٕ رود بیٚیہِ تہِ کینٛہہ کالا یسوعؔ أتی گلیل ہنٛدِس علاقس منٛزےٕ۔
\v 10 بہرحال باین ہنٛدِس اتھ بٔڈِس دوٚہس گژھٛنہٕ پتہٕ کینٛژؠ دوٚہؠ گو یسوعؔ پانہٕ تہِ اور ژھوٚپہِ ژھوٚپٲؠ پٲٹھؠ۔
\v 11 یِمن یہُودؠ زِٹھٮ۪ن یہِ، دٔرؠ شینکھ از مسیحؔ ییہِ اور یہِ بوٚڈ دوٚہہ مناونہِ۔ تِم رودؠ کوس تہٕ أمِس اتہِ ژھانٛڈ دِوان۔ تِم ٲسؠ أکِس أکِس نفرس پرٕژھان "سُہ آدمؔ کتہِ چُھ"
\v 12 لوٗکھ ٲسؠ ژھوٚپہِ ژھوٚپٲؠ پٲٹھؠ أکِس یسوعسؔ متعلق پرٕژھان۔ کینٛہہ ٲسؠ ونان، "سُہ چُھ اکھ نیک تہٕ رُت انسات۔ ییٚلہِ زن یتہِ کینٛہہ ٲسؠ یِتہِ ونان، "نَہ! سُہ چُھ لوٗکن پچہِ پھیُر کران۔
\v 13 ؤنؠ گو لوٗکھ ٲسؠ یہُودؠ زِٹھٮ۪ن کھوٚژان۔ اوے ٲسؠ نہٕ تِم کھُلہٕ پٲٹھؠ عام لوٗکن منٛز أمؠ سنٛز کانٛہہ کتھ کران۔
\v 14 ییٚلہِ عید خیامس سٟتؠ مخصوس دوٚہُن ہُند اوٚڈ حصہٕ انٛدیومُت اوس یسوعؔ ژاو ہیکلہٕ کِس منٛزؠ مِس آنٛگنس منٛز تہٕ لٲجن لوٗکن تعلیم دِنؠ۔
\v 15 یہُودؠ زِٹھؠ گے یہِ تبلیغ وُچِھتھ روزِتھ۔ تِمو ووٚن، "یمؠ انسانن چھنہٕ کانٛہہ مذہبی تعلیم تہِ پرٲومٕژ۔ أمؠ چھنہٕ مقدس کتابہٕ تہِ وارٕ زانہِ مژٕ۔
\v 16 یسوعنؔ ونُکھ، "یہِ تعلیم چھنہٕ میٲنؠ بلکہ چھےٚ یہِ خدایہِ سٕنٛدِ طرفہٕ یمؠ بہٕ سوزُس۔
\v 17 یوٚدوے کانٛہہ خدایہ سنٛز مرضی پٮ۪ٹھ پکُن یژھان چُھ سُہ ہیٚکہِ پانے زٲنِتھ زِ میٲنؠ تعلیم چھنہٕ میانہِ کُنہِ اِرادٕ بلکہ چھےٚ یہِ خدایہِ سٕنٛدِ طرفہٕ۔
\v 18 کانٛہہ نفر تہِ یُس پننہِ اِرادٕ کتھ کرِ چُھ پٲنؠ پانس پانے تھزَر دیُن یژھان۔ ؤنؠ گو سُہ نفر یُس تھزَر دیُن یژھان چُھ پننس سوزن وٲلِس چُھ پوٚز ونان تہٕ نہک عمل کران۔
\v 19 یقیناً دِژ توٚہہِ موسیٰؔ ہن خدایہِ سنٛز شریعت۔ مگر توٚہہِ منٛزٕ کُس چُھ اتھ پٮ۪ٹھ عمل کران تہٕ یی چُھ پوٚز۔ توٚہؠ کیازِ چُھو مےٚ مارُن یژھان۔ تہنٛدؠ کِنؠ تتھ شریعتس پٮ۪ٹھ نَہ روزنہٕ کِنؠ یتھ نہٕ توٚہؠ پانہٕ تہِ مازان چُھو۔
\v 20 امہِ ہجومہٕ منٛزٕ ووٚنُس یورٕ کینٛژو، "ژےٚ چُھے ژامُت جِن پرکس۔ ژےٚ چُھےٕ نہٕ کانٛہہ تہِ مارُن یژھان۔"
\v 21 یسوعنؔ ووٚن یورٕ اتھ ہجومس، "چونکہِ مےٚ بٔلروو اکھ نفر معجزٕ سٟتؠ۔ تہنٛدِ مقدس آرام کہِ دوٚہہ۔ توٚہؠ گوو یہےَ روزِتھ ہیٚو۔
\v 22 تکیازِ کینٛہہ صحت بخشن واجنہِ کامہِ ہیٚکو آرامکہ دوٚہہ تہِ کٔرِتھ۔ موسیٰؔ ہن دیُت توٚہہِ خستہٕ کرنُک حکم۔ یہِ شریعت چھےٚ ونان زِ توٚہہِ چُھو شُر زیٚنہٕ پتہٕ سٔتمہِ دوٚہہ لٲزِمن أمِس ختنہٕ کرُن۔ حالانکہ ختنُک حکم گو نہٕ موسیٰؔ سٕنٛدِ پیٚٹھےَ شروع بلکہ سپُد یہِ ریواج تہنٛدٮ۪و اجدادو ابرہامؔ، اضحاقؔ تہٕ یعقوبؔ سٕنٛدِ پٮ۪ٹھٕ شٮروع۔ امہِ شریعتہٕ کِنؠ چُھو توٚہہِ کُنہِ کُنہِ سبت یعنی آرامکہ دوٚہہ تہِ بچو باپتھ ختنہٕ انجام دِنچ کٲم کرٕنؠ پیٚوان۔\f + \fr 7‏:22 \ft پیدٲیش 17:10۔13، احبار 12:3\f*
\v 23 چونکہِ توٚہہِ چُھ موسیٰؔ سُنٛد حکم پولوسؔنہٕ باپتھ کُنہِ وزِ آرامکہ دوٚہہ سبت تہٕ ختنچ کٲم کرٕنؠ پیٚوان۔ توٚہہِ پزِ نہٕ مےٚ پٮ۪ٹھ ناراض سپدُن زِ مےٚ کٔر اِکھ رٕژ کٲم مثلاً کانٛہہ بٔلراونچ کٲم امہِ خاص دوٚہہ۔
\v 24 چھرا پنن، س وُچھنس یا سونچس پیٚٹھےٕ مٕہ لٲگِو مےٚ پٮ۪ٹھ عدالت بلکہ پرکھٲیو خدا سٕنٛدِ قانون تہٕ شریعتہٕ مطٲبق یہِ زن صحیح چُھ۔\f + \fr 7‏:24 \ft یسعیاہؔ 11:3، یوحنا 8:15\f*
\v 25 کینٛژھو لوٗکو یِم یروشلمہٕؔ روزان ٲسؠ ووٚن، "یہِ چُھ سُہ آدمؔ یمِس سٲنؠ زِٹھؠ مارُن یژھان چھِ۔
\v 26 بوزِو یہِ چُھ یمہِ کتھہِ ننہِ وان عامس منٛز ونان۔ مگر سٲنؠ زِٹھؠ چھِنہٕ أمِس خلاف ژٔر تہٕ کران۔ امیٚک مطلب ما گو یہِ زِ یِم سٲنؠ زِٹھؠ چھِ ژَکہِ زانان زِ یہِ چُھ مسیحؔ۔
\v 27 مگر یہِ انسان ہیٚکنہٕ مسیحؔ ٲسِتھ! اسہِ چھےٚ پتاہ یہِ کتہِ آو۔ مگر ییٚلہِ مسیحؔ ییہِ کانٛہہ زانہِ نہٕ سُہ کتہِ آو۔
\v 28 ہیکلس منٛز أکِس تبلی کرنس دوران ووٚن یسوعنؔ بڈِ ہَٹہِ، "آ! توٚہؠ چُھو مےٚ زانان تہٕ توٚہؠ زٲنِو یِتہِ زِ بہٕ آس کتہِ پٮ۪ٹھٕ۔ مگر بہٕ آس نہٕ یور پننہِ حکمہٕ بلکہ یمؠ بہٕ سوزُس چُھ پوٚز خدا تہٕ توٚہؠ زٲنیٚو نہٕ تمِس۔
\v 29 بہٕ زانن سُہ تکیازِ بہٕ آس تسٕنٛدِ پٮ۪ٹھٕ۔ سُے چُھ یمؠ بہٕ یور سوزُس۔
\v 30 چونکہِ یسوعنؔ ونہِ یِم تہٕ یژھے کِتھہٕ۔ یہُودؠ زِٹھؠ ٲسؠ یژھان أمِس بٲنٛدؠ بناوُن۔ مگر کانٛہہ تہِ ہیوٚک نہٕ أمِس تھَپہِ رٔٹِتھ۔ امسنٛدِ مرنُک وق اوسنہٕ وُنہِ ووتمُت۔
\v 31 یہُودؠ زِٹھٮ۪ن برعکس ٲسؠ واریاہ لوٗکھ یِمن یسوعسؔ پٮ۪ٹھ پژھ ٲس۔ تِم رودؠ لگاتار ونان، "ییٚلہِ تہِ زانہٛہ مسیحؔ ییہِ سُہ ہیٚکنہٕ امسنٛدِ کھۅتہٕ زیادٕ بہتر معجزٕ کٔرِتھ
\v 32 کینژھو فریسیو لوٗکو بوزٕ ژوٗرٕ پٲٹھؠ یِم یہنٛزٕ کِتھہٕ یسوعسؔ متعلق۔ امہِ پتہٕ سوز یِمو تہٕ کاہنو ہیکلٕکؠ محٲفظ أمِس بٲنٛدؠ بناونہٕ باپتھ۔
\v 33 چونکہِ تِمو کوٚر یہِ۔ یسوعنؔ ونُکھ، "بہٕ روزٕ توٚہہِ سٟتؠ یتھے کینٛژس کالسےٕ۔ ؤلؠ آسہ بہٕ خدایس سٟتؠ یمؠ بہٕ یور سوزُس۔
\v 34 توٚہؠ ژھٲرِیو مےٚ مگر مےٚ لٔبیٚو نہٕ کینٛہہ۔ توٚہؠ ہکیٚو نہٕ تتھ جایہِ مقامس وٲتؠ تھےٕ یتہِ بہٕ آسہ"
\v 35 یہُودؠ زِٹھؠ رودؠ اکھ أکِس پرٕژھان۔ "یہِ آدمؔ گژھِ کوٚت زِ أسؠ ہیکوون نہٕ لٔبؠ تھےٕ؟ یہِ ما گژھِ پزی تِمن یہودٮ۪ن نِش یِم اسرائیل نٮ۪بر سٲرسےٕ زگتس پھٔہلِتھ چھِ؟ کیاہ یہِ کیاہ پنُن تبلیغ تِمن لوٗکن منٛز تہِ یِم نہٕ یہُودؠ چھِ؟
\v 36 ٲخٕر امسُنٛد مطلب کیاہ چُھ۔ یمہِ پننہِ وننُک زِ ٲسؠ دِمو سٲرؠ سےٕ دُنیہس زٲلؠ مگر تس لبو نہٕ تہٕ أسؠ واتن نہٕ تتھ مقامس تہِ یتہِ سُہ آسہ
\v 37 عید خیام طَے یس واتنکہ انٛدمہِ دوٚہہ ووٚتھ یسوعؔ ہیکلہٕ کِس انٛدرمِس آنٛگنس منٛز وۅدٕنؠ تہٕ لوگُن تھَدِ ہَٹہِ ونُن۔ تٔمؠ ووٚن، "سُہ پرٮ۪تھ کانٛہہ زوٚن یمِس تریش چھےٚ یِین مےٚ نِش تہٕ چییِن تریش یوٚسہٕ بہٕ دِمَس۔\f + \fr 7‏:37 \ft یسعیاہؔ 55:1\f*
\v 38 یی چُھ رسولو مقدس کتابن منٛز لیٚوکھمُت تِمن متعلق یِمن مےٚ پٮ۪ٹھ پژھ آسہ۔ "آب یس پوشوٕنؠ زندگی بخشہِ وُزِ تس انسان سٕٛدِ انٛدرٕ پٮ۪ٹھٕ۔
\v 39 یسوعنؔ ووٚن ادٕ روح القدس متعلق یس خدا یسوعؔس پٮ۪ٹھ پژھ کرن والیٚن بخشُن یژھان اوس أمؠ ووٚن یہِ تکیازِ اوٚت تام اوسنہٕ خداین روح القدس سوزمُت تمِس پٮ۪ٹھ پژھ تھاون والیٚن پٮ۪ٹھ۔ تہٕ مزید اوٕ کِنؠ زِ یسوعؔن اوس وُنہِ سُہ عزت، سۅ فضیلت پرٲومٕژ یس تس پننہِ ظٲہری مرنہٕ پتہٕ دُبارٕ زِنٛدٕ وتھنہِ تہٕ آسمانن پٮ۪ٹھ کھسنہٕ پتہٕ میلن واجِنؠ ٲس۔\f + \fr 7‏:39 \ft یسعیاہؔ 44:3\f*
\v 40 ییٚلہِ امہِ ہجوٗمہٕ منٛزٕ کینٛژو لوٗکو یسوعؔ سُنٛد یہِ دوٚپ بوز۔ تِمو ووٚن یہِ چُھ پزی نبی۔ یمِس متعلق خداین ووٚنمُت چُھ زِ سُہ چُھ یِنہٕ وول۔
\v 41 کینٛژو ووٚن، "یوٚہے چُھ نجات بخشن وول مسیحؔ۔ ؤنؠ گو کینٛژو ووٚن یمن ہُنٛد یہِ غلط خیال اوس زِ مسیحؔ زاو گلیل منٛز۔ مسیحؔ سُنٛد گلیل پٮ۪ٹھٕ یِنُک چُھنہٕ شاید کانٛہہ امکان۔
\v 42 نبیو چُھ مقدس مسودن منٛز لیٚوکھمُت زِ مسیحؔ ہس چُھ پزنہٕ پٲٹھؠ بادشاہ داوود سنٛدیو زُریٚو پٮ۪ٹھٕ یُن۔ تہٕ تِمن چُھ لٲزمن بیت لحم کہِ کُنہِ گامہٕ پیٚٹھےَ یُن۔ یتہِ پٮ۪ٹھ زن داود تہِ آمُت اوس۔\f + \fr 7‏:42 \ft یسعیاہؔ 11:1، ملاکی 5:2\f*
\v 43 اتھ یسوعؔ سٕنٛدِ سوالس پٮ۪ٹھ گو یہِ ہجوم کانہِ کانہِ۔
\v 44 ہجومہٕ منٛزٕ ٲسؠ کینٛہہ أمِس بٲنٛدؠ بناوُن یژھان۔ مگر کٲنٛسہِ تہِ ہیوٚک نہٕ سُہ رٔٹِتھ۔
\v 45 ہیکلٕکؠ پیادٕ آے ژھٔری پوٚت پھیرِتھ حکومت کرن والیٚن کاہنن تہٕ فریسین نِش۔ یِمو پرُژھُکھ۔ "سُہ کیازِ اوٚنوُن توٚہہِ رٔٹِتھ یوت اسہِ نِش۔
\v 46 ہیکلکٮ۪و پیادو ونُکھ یورٕ، "کٲنٛسہِ دوٚیِم تہِ چھنہٕ ازتام تسٕنٛدؠ پٲٹھؠ یتھ کلام کوٚرمُت۔
\v 47 چونکہِ یِمو ہیکل کیٚو رٲچھ درو ووٚن یہِ فریسیو پرُوژھ یِمن یورٕ۔ امیٚک تر چھا یہِ زِ تٔمؠ تٲروٕ توٚہہِ تہِ۔
\v 48 یقیناً چھِنہٕ حکومتی انتظامٕکؠ ارکان تہٕ أسؠ فریسیسی تمِس پٮ۪ٹھ کانٛہہ پژھ ھاوان۔
\v 49 بہرحال یہِ لوٗکن ہُنٛد ہجوم چُھنہٕ خدا سنٛز شریعت زانان توے وٲج یِمن خداین وُنہٕ۔
\v 50 امہِ پتہٕ ونُکھ نِیکُدِیمُسؔ ناوںٕکؠ نفرن یُس رٲژ منٛز یسوعؔ سمکھنہِ آمُت اوس۔ یوٚدوے سُہ فریسیسی اوس یتھ جمٲژ زن عام پٲٹھؠ یسوعؔ سنٛز دےٕ ٲس تہٕ توتہِ اوس آمُت۔
\v 51 تٔمؠ ووٚن یہُودؠ مذہبی زِٹھٮ۪ن کاہنن زِ سٲنؠ یہُودؠ شریعت چھنہٕ مانان کٲنٛسہِ راہ کھالُن۔ تسُنٛد گوٚڈ بوزنہٕ ورٲے زِ آیا تٔمؠ کوٚرمُت کیاہ چُھ۔
\v 52 تِمو ووٚن أمِس اورٕ نس دٕنِتھ، "یقیناً چُھکھ نہٕ ژٕ پانہٕ تہِ گلیل علاقُک۔ کِنہٕ چُھکھ؟ نیر پر یِم مقدس مسودٕ وارٕ۔ ژٕ وُچھکھ پانے زِ گلیل پٮ۪ٹھٕ وۅتھِنہٕ کانٛہہ رسول۔
\v 53 پتہٕ دراے تِم سٲری پن پنُن گرٕ۔
\c 8
\p
\v 1 یسوعؔ گو پتہٕ زیتون بالس کُن۔ تہٕ یہِ راتھ گُزٲرٕن أتھؠ نکھَے
\v 2 دوٚیمہِ دوٚہہ صبح پھۅلوُن آو ہیکل کِس صحنس منٛز واپس۔ واریاہ لوٗکھ آس سمکھنہِ۔
\v 3 شریعت زان وٲلؠ کینٛہہ ۅوستاد تہٕ فریسیسی آیس اکھ زنانا ہٮ۪تھ۔ تِمو ٲس سۅ کۅکار کران رٔٹمژ۔ تِمو کٔر سۅ منٛز جمٲژ کھڑا۔
\v 4 کاہن ٲسؠ یسوعسؔ آزماوُن یژھان تاکہِ تمِس کھالن کانٛہہ راہ۔ تھدِس یہُودؠ انتظٲمی مشاورتس منٛز موسیٰؔ سنٛز شریعت پھُٹراونُک۔ اوے ونُکھ أمِس، "استاد اسہِ رٔٹ یہِ زنان کۅکار کران۔ بدکٲری ہنٛز عملہِ دوران۔
\v 5 موسیٰؔ سنٛزِ شریعُک حکم چُھ زِ یِژھ زنان گژھِ کنہِ کنہِ کٔرِتھ مانرنہٕ یِنؠ۔ بہرحال ژٕ ون اسہِ کیا پزِ کرُن۔\f + \fr 8‏:5 \ft احبار 20:10\f*
\v 6 یسوعؔ نمیو بوٚن کُن تہٕ لوٚگ زمینس پٮ۪ٹھ کہتام أمِس اونگجہِ سٟتؠ لیکھنہِ
\v 7 ییٚلہِ تِم یسوعؔس لگاتار پرٕژھان رودؠ۔ سُہ ووٚتھ تھوٚد تہٕ ووننکھ۔ پکو بس سُہ نفر لاین أمِس زنانہِ گۅڈنِچ کٔنؠ یمؠ نہٕ پانہٕ زانٛہہ تہِ کانٛہہ گناہ کوٚرمُت آسہ۔ تہٕ یوٚہے کرِ باقین تہِ أمِس مارنس منٛز رہبری
\v 8 امہِ پتہٕ نمیوو یسوعؔ بیٚیہِ تہٕ لیٚوکھن کہتام زمینس پٮ۪ٹھ۔
\v 9 ییٚلہِ تَمو یسوع سُنٛد کلام بوٗز تِمو یہُودؠ زِٹھیٚو یِم تس سوال ٲسؠ کران لوگ لوت لوت اکہ اکہ نیرُن۔ بزرگ دراے گۅڈٕ انوارِ تہٕ ادٕ دراے باقیو لۅکٕٹؠ لۅکٕٹؠ۔ اتہِ رود اتھ لوٗکہٕ ہجومس منٛز چھرا پانہٕ یسوعؔ تہٕ یہِ راہ لد زنان۔
\v 10 یسوعؔ ووٚتھ تھوٚد تہٕ پرژھُن أمِس کورِ۔ تِم سٲری مرد کوٚت گۓ یِم ژےٚ راہ ٲسے کھالان۔ ژےٚ پٮ۪ٹھ لگوونا کٲنٛسہِ تہِ سزہُک حکم۔
\v 11 زنانہِ ووٚنُس اورٕ جناب۔ یتہِ چُھنہٕ کہین، "امہِ پتہٕ ووٚنُس یسوعؔن۔ بٕتہ چُھسے نہٕ ژےٚ سزہُک حکم دِوان۔ نیر برونٛہہ کُن کٔرؠ زیٚنہٕ یُتھ ہیٚو گناہ زانہٛہ۔
\v 12 یسوعؔن ووٚن لوٗکن کُن مزید، "بہٕ چُھس دُنیا کیٚن لوٗکن خدایہ سُنٛد رُت تہٕ پوٚز گاش بخشن وول۔ یُس تہِ میون شٲگرد بنہِ سُہ تراوِ نہٕ پنٕنؠ قدم زنٛہے گناہ چہِ سیٲہی منٛز اتھ برعکس میٲنِس خدایہِ سنٛدِ خٲر، رٕژر تہٕ پوٚز نور یس پوشونہِ زندگی آے دِیَس۔
\v 13 یورٕ ؤتھِس فریسیسی "ژےٕ چُھکھ پانس پٮ۪ٹھ پانے کُن گواہ۔ موسیٰؔ سٕنٛدِ شریعتس منٛز چھِ زندٕ گواہ آسٕنؠ لازمی ژےٚ یہِ ونکھ ما ییہِ پوٚز ماننہٕ۔
\v 14 یسوعؔن ونُکھ یورٕ۔ یوٚدوے زن بہٕ پانس پٮٮ۪ٹھ کُنےٕ گواہ تہِ چُھس توتہِ چُھ پوٚز تہِ سورےٕ یہِ بہٕ ونان چُھس تکیازِ بہٕ چُھس زانان زِ بہٕ کتہِ پٮ۪ٹھٕ آس تہٕ مےٚ چھےٚ خبر بہٕ کوٚت چُھس گژھان مےٚ کوٚت چُھ گژُھن۔ مگر توٚہہِ چھنہٕ رژھ تہِ خبر بہٕ کتہِ تہٕ نَہ چُھو خبر بہٕ گژھٕ کوٚت۔
\v 15 توٚہؠ چُھو لوٗکن پرکھاوان انسٲنی مقیارو ؤنؠ گو بہٕ چُھس نہٕ آمُت کٲنٛسہِ عدالت لاگنہِ امہِ طریقہٕ تہنٛدیٚو معیارو۔
\v 16 ییٚلہِ زانہٛہ کٲلؠ بہٕ لوٗکن عدالت لاگہٕ بہٕ پرکھاوکھ تِم مستقل میعارو تکیازِ بہٕ چُھس نہٕ لوٗکن پننہِ ذٲتے میعارٕ پرکھاوان بلکہ لاگو بہٕ تہٕ میون مول یمؠ بہٕ یور سوزُس دۅشوے یِکہٕ وٹہٕ عدالت۔
\v 17 موسیٰؔ ہن چُھ تہنٛزِ شریعت دِنہٕ واجنہِ کتابہِ منٛز لیٚوکھمُت زِ ییٚلہِ کم از کم زٕ گواہ ہِشی گوٲہی دِن تیٚلہِ تیہِ تِم ونن چُھ پوٚز۔\f + \fr 8‏:17 \ft احبار 17:6تہٕ 19:15\f*
\v 18 بہٕ چُھس پنُن پانہٕ گواہ۔ مگر میون مول بہٕ یور سوزُس تہِ چُھ مےٚ گواہ لہٰذا یہِ بہٕ ونان چُھس تہِ چُھ پوٚز۔\f + \fr 8‏:18 \ft احبار 19:15\f*
\v 19 چونکہِ یسوعؔن ووٚن زِ تسُنٛد مول چُھ تسُنٛد گواہ فریسیو پرُوژھ أمِس، "پنُن مول کتہِ چُھے۔ یسوعؔن ونُکھ یورٕ۔ توٚہؠ نہٕ زٲنیٚو مےٚ تہٕ میٲنِس مٲلِس۔ یوٚدوے توٚہؠ مےٚ زٲنؠ ہیو، توٚہؠ زٲنؠ ہو میٲنِس مٲل، س تہِ۔ مگر توٚہؠ چُھو نَہ
\v 20 تٔمؠ ونہِ یِمہٕ کِتھہٕ پانس متعلق ییٚلہِ سُہ ہیکل کِس آنٛگنس منٛز پنٕنؠ تعلیم دِوان اوس۔ تٔمؠ ووٚن یہِ تِمن خزانس نِش ییٚتہِ لوٗکن ہُنٛد پونٛسہٕ ٹونٛک بیترِ جمع یوان اوس کرنہٕ۔ یہِ روٚٹ نہٕ کٲنسے تکیازِ وُنہِ اوسنہٕ امسنٛدِ یمہِ عالمہٕ نیرنُک منٲسب وق ووتمُت۔
\v 21 یسوعؔن ووٚن لوٗکن مزید۔ بہٕ چُھس ییٚتہِ وُنؠ نیران۔ توٚہؠ روزیٚو مےٚ ژھانٛڈان۔ چونکہِ توٚہؠ چُھو مےٚ پننیٚو گُنہو بٔرِتھ نیتِ کِنؠ اِنکار کران، توٚہؠ مرد خدایہِ سٕنٛدِ طرفہٕ بخششہِ ورٲے۔ توٚہؠ ہیٚکو نہٕ تتھ جایہِ وٲتتھےٕ یوٚت بہٕ واتہٕ۔
\v 22 یہُودؠ زِٹھیٚو ووٚن پانہٕ وٲنؠ شاید چُھ یہِ پانے پان مارُن یژھان۔ تہٕ یہِ چُھ امیٚک مطلب ییٚلہِ یہِ ونان چُھ زِ أسؠ ہیٚکو نہٕ توٚت وٲتِتھ یوٚت سُہ گژھان چُھ۔
\v 23 یسوعنؔ ووٚن یِمن توٚہؠ چُھو یمہِ پست زمینہِ پٮ۪ٹھ تہٕ بہٕ چُھس بلند آسمانہٕ پیٚٹھُک۔ توٚہؠ چُھو یمہِ گناہ گار دُنیہکؠ۔ بہٕ چُھس نہٕ امہِ دُنیہُک۔
\v 24 اوے کِنؠ ووٚنمو زِ توٚہؠ مٔرِو پننٮ۪ن گنہن ہنٛز بخشش خدایس نِش لبنہٕ ورٲے۔ یی سپدِ یقیناً یوٚدوے توٚہؠ پژھ کٔرِو نہٕ زِ بہٕ چُھس خدا۔ یہِ زن بہٕ ونان چُھس۔
\v 25 تکیازِ امؠ ووٚن یہِ تِمو پرُوژھ أمِس، "ژٕ چُھکھ کُس۔ یسوعنؔ ونُکھ یورٕ بٕتہ اوسُس یی ونان گۅڈٕ پٮ۪ٹھٕ۔
\v 26 بہٕ ہیٚکہٕ واریاہ کینٛہہ توٚہہِ متعلق ؤنِتھ تہٕ توٚہہِ عدالت لٲگِتھ مگر بہٕ کرٕ نہٕ یُتھ کینٛہہ وُنکٮ۪س۔ بلکہ ونہٕ بہٕ دُنیہکٮ۪ن لوٗکن چھرا تیُتےٕ یہِ مےٚ پانہٕ بوز۔ مےٚ یوت سوزن وٲلِس نِش۔ سُہ چُھ ہمیشہٕ پوٚز ونان۔
\v 27 تِمو سمُجھ نہٕ رژھ تہِ زِ سُہ اوس تِمن آسمانس پٮ۪ٹھ پننس مٲلِس متعلق ونان۔
\v 28 یسوعنؔ ووٚن یِمن، "ییٚلہِ توٚہؠ مےٚ کٲٹھِس تُلِو مارنہٕ باپتھ۔ مےٚ آدمؔ سنٛدِس گۅبرس۔ توٚہؠ زٲنِو پانے زِ بہٕ چُھس خدا تہٕ توٚہؠ زٲنِو یِتہِ زِ بہٕ چُھس نہٕ پننہِ اختیارٕ کِہین کران۔ بلکہ چُھس بہٕ تی کران یہِ بہٕ پنٕنؠ مٲلؠ ہٮ۪چھنووُس۔
\v 29 میون مول یمؠ بہٕ یور سوزُس چُھ ہمیشہٕ مےٚ سٟتؠ۔ تٔمؠ ترووُس نہٕ بہٕ زانہٛہ بے کس تکیازِ بہٕ چُھس ہر ساعتہٕ تی کران مہِ سٟتؠ سُہ فرحت پراوِ۔
\v 30 یمہِ وزِ یسوعؔ یمہٕ کِتھہٕ کران اوس۔ بیٚیہِ تہٕ بیٚیہِ لوٗکو مون زِ سُے چُھ مسیحؔ۔
\v 31 یسوعنؔ ووٚن ادٕ تِمن یہودٮ۪ن یم ؤنؠ تس مسیحؔ مانان ٲسؠ۔ یوٚدوے توٚہؠ میٲنؠ تعلیم مٲنِو تیٚلہِ چُھو توٚہؠ میٲنؠ حقیقی شٲگرد۔
\v 32 امہِ علاوٕ زٲنِو توٚہؠ پانے خدایہِ سنٛز حقیقت تہٕ اتھ مٲنِتھ بخشیٚو یہِ پزر توٚہہِ نجات تمہِ نِشہ یمؠ توٚہؠ غلام چُھو بنٲوِؠ مٕتؠ۔
\v 33 تِمو ووٚنُس اورٕ ٲسؠ ابرہامؔ سٕنٛدؠ زُرؠ۔ أسؠ چھِنہٕ ذہنؠ کٲنٛسہِ ہنٛدؠ غلام رودؠ مٕتؠ۔ ژٕ کو چُھکھ ونان زِ اسہِ چھےٚ آزٲدی پراوٕنؠ۔
\v 34 یسوعنؔ ونُکھ، "بہٕ چُھسو ونان پوٚز۔ سُہ ہر کانٛہہ یُس گناہ کرِ چُھ پننٮ۪ن گناہ گار خٲہشن ہندس حکمس تل۔
\v 35 اکھ غلام چُھنہٕ ہمیشہٕ پننٮ۪ن مٲلکن ہنٛدِ شہرکؠ بٲژ روزان ؤنؠ گو کینٛہہ ہیٚکن یِتھؠ یا آزاد ہیٚکن سپدِتھ۔ مگر اکھ نیٚچو چُھ پننہِ شہرُک ہمیشہٕ اکھ بٲژ۔\f + \fr 8‏:35 \ft غلتین 4:30\f*
\v 36 بس یوٚدوے توٚہہِ اکھ نیٚچو آزاد کرِ گنہن ہُنٛد غلام روزنہٕ نِش۔ توٚہؠ ہیٚکو مکمل پٲٹھؠ گنہو نِش مُچھِ روزِتھ۔
\v 37 بہٕ چُھس زانان زِ توٚہؠ چُھو ابرہامؔ سٕنٛدؠ جسمٲنی زُرؠ۔ بہرحال توٚہؠ چُھو مےٚ مارُن یژھان تکیازِ توٚہؠ چُھو پژھ تھاونس اِنکار کران۔
\v 38 بہٕ چُھسو توٚہہِ تِمن چیزن متعلق ونان یِم مےٚ پنٕنؠ مٲلؠ\f + \fr 8‏:38 \ft بب خدا۔\f* دیدمان ہٲوؠ۔ لہٰذا کٔرِو توٚہؠ تہِ تہٕ یہِ تہنٛدؠ مٲلؠ توٚہہِ ونُو۔\f + \fr 8‏:38 \ft شیطان\f*
\v 39 تِمو ووٚنُس اورٕ ابرہامؔ چُھ سون جد۔ یسوعنؔ ونُکھ، "یوٚدوے توٚہؠ ابرہامؔ سٕنٛدؠ زُرؠ ٲسؠ ہُو۔ توٚہؠ ٲسؠ ہُو تی کران یہِ تٔمؠ کوٚر۔
\v 40 بہٕ چُھسو توٚہہِ پزٕ کِتھہٕ ونان یِم مےٚ خداین ونہِ مگر توٚہؠ چُھو اورٕ مےٚ مارنس پٮ۪ٹھ۔ ابرہامنؔ ما کوٚر یتھٕ کِنؠ۔
\v 41 توٚہؠ چُھو تی کران یہِ تہنٛدؠ اصل مٲلؠ کوٚر۔ تِمو ووٚنُس، "أسؠ چھِنہٕ حرامٕکؠ بچہٕ چٲنؠ پٲٹھؠ اسہِ چُھ بس اکھ مول سُہ گو سون خدا۔
\v 42 یسوعنؔ ونُکھ، "یوٚدوے خدا تُہنٛد مول آسہ ہے یہِ زن سُہ چُھنہٕ۔ توٚہؠ بٔرؠ ہیٚو مےٚ لول تکیازِ بہٕ آس تسٕنٛدی پٮ۪ٹھٕ۔ تہٕ آس یتھ دُنیہس۔ یہِ چُھ پزر بہٕ آس نہٕ پننہِ اختیارٕ بلکہ سوزُس بہٕ پانہٕ خداین۔
\v 43 خبر چُھوا توٚہؠ کیازِ نہٕ پانہٕ سمجھان یہِ بہٕ توٚہہِ ونان چُھس۔ یہِ چُھ تکیازِ توٚہؠ چُھو نہٕ مانان یہِ مےٚ ونُو۔
\v 44 توٚہؠ چُھو پننِس مٲلؠ سٕنٛدؠ، شیطان سٕنٛدؠ تہٕ توٚہؠ چُھو یژھان تی کرُن یہِ سُہ یژھان چُھ۔ سُہ چُھ برابر تنہٕ پٮ۪ٹھٕ لوٗکن ماران ینہٕ لوکو گۅڈٕ گناہ کوٚر۔ تٔمؠ نکور تہِ یہِ حق اوس۔ تکیازِ سُہ چُھنہٕ تِمن پزن کتھن دُہراوان ییٚلہِ تہِ سُہ اپُز ونہِ سُہ چُھ پننہِ فطرت مطٲبق عمل کران۔ تکیازِ سُہ چُھ اپٕزؠ یور۔ بلکہ چُھ سُہ اپزیُک آگُر۔\f + \fr 8‏:44 \ft عملہٕ 13:10\f*
\v 45 توتہِ چُھو نہٕ توٚہؠ مےٚ پٮ۪ٹھ پژھ۔ تکیازِ بہٕ چُھسو پوٚز ونان۔
\v 46 چونکہِ مےٚ چُھنہٕ ذہنؠ گناہ کوٚرمُت۔ توٚہہِ منٛزٕ ہیٚکہِ نہٕ کانٛہہ ثٲبت کٔرِتھ زِ مےٚ چُھ گناہ کوٚرمُت۔ چونکہِ بہٕ چُھسو ونان پوٚز کیاہ چُھ۔ کانٛہہ تہِ رُت وجہہ چُھنہٕ توٚہہِ روزان میانہِ کتھہِ پٮ۪ٹھ پژھ نَہ کرنہٕ باپتھ۔
\v 47 خدا سٕنٛدؠ چھِ خدایس مانان تہٕ مازان یہِ تٔمؠ ووٚن۔ یی چُھ پوٚز۔ توٚہؠ چُھو نہٕ مانان یہِ خدا ونان چُھ تکیازِ توٚہؠ چُھو نہٕ خدا سٕںنٛدؠ۔
\v 48 یسوعسؔ مخٲلف یہودیٚو ووٚن أمِس أسؠ چھِ یقیناً صحیح یہِ وننس پٮ۪ٹھ زِ ژٕ چُھکھ اکھ سامرٲتؠ یمن أسؠ نفرت کران چھِ تہٕ ژےٚ چُھےٕ ژامُت جِن پرٮ۪کس۔
\v 49 یسوعنؔ ونُکھ یورٕ، "بہٕ چُھس نہٕ شیطان سٕنٛدِس اختیارس تل بلکہ چُھس بہٕ پننِس مٲلِس آسمانن پٮ۪ٹھ پننس مٲلس عزت بخشان تہٕ توٚہؠ چُھو مےٚ عزت والان۔
\v 50 بہٕ چُھس نہٕ یژھان لوٗکن پتہٕ لگُن پانس عزت کرناونہٕ باپتھ۔ بلکہ چُھ یہِ بیاکھ یُس یہِ کرناوُن یژھان چُھ تہٕ پرکھاوان چُھ زِ پوٚز کُس چُھ ونان توٚہؠ کِنہٕ بہٕ۔
\v 51 بہِ چُھسو پوٚز ونان یُس تہِ میٲنؠ تعلیم مانہِ سُہ مرِنہٕ ادٕ زانہٛہ۔
\v 52 یسوعسؔ مخٲلف یہودیٚو ووٚنُس یورٕ، "ؤنؠ چھےٚ اسہِ پوٗرٕ یقین تہٕ پژھزِ ژےٚ چُھےٕ کُستام جِن رٔٹٕتھ پکناوان۔ ابرہامؔ تہٕ باقیو رسول مودؠ درایہِ یمہِ عالمہٕ کرتام تہٕ توتہِ چُھکھ ژٕ ونان زِ یُس تہِ چٲنؠ تعلیم مانہِ سُہ مرِ نہٕ یقیناً زہنٛؠ۔
\v 53 ژٕ چُھکھ نہٕ ہرگِز تہِ سٲنِس جدسابرہامس کھۅتہٕ بوٚڈ تہٕ عظیم۔ سُہ مود تہٕ باقے رسول تہِ مودؠ۔ ؤنؠ ون ژٕ کُس چُھکھ؟
\v 54 یسوعنؔ ونُکھ، "یوٚدوے بہٕ لوٗکن پتہٕ لگہ زِ تِم کرن مےٚ عزت، سُہ عزت آسہ کھوٚٹ۔ میون مول چُھ میون عزت کران۔ سُہ چُھ سُے یمِس متعلق توٚہؠ ونان چُھو زِ سُہ چُھ میون خدا۔
\v 55 اگرچہِ توٚہؠ أمِس خدایس زانان چُھو نہٕ۔ بہٕ چُھسن سُہ خدا زانان۔ یوٚدوے بہٕ یہِ ونہٕ زِ بہٕ زانن نہٕ، بہٕ چُھس تیٚلہِ اپٕزؠ یور توٚہہِ پرٮ۪تھ کٲنٛسہِ ہنٛدؠ پٲٹھؠ۔ اتھ برعکس زانن بہٕ سُہ تہٕ بہٕ چُھس ہمیشہٕ تس مانان یہِ سُہ ونان چُھ۔
\v 56 تُہنٛد جد ابرہامؔ اوس سٮؠٹھاہ خوش زِ سُہ چُھ مےٚ یتھ دنیاہس منٛز یوان وُچھان۔ خداین دیُت أمِس مےٚ دنیاہس منٛز یِمن وُچھنُک موقعہ تہٕ اوس بڈٕ خوش۔
\v 57 چونکہِ یسوعنؔ ووٚن یہِ أمِس مخٲلف یہودیٚو ووٚنُس ابرہامؔ گو یمہِ عالمہٕ واریاہ کال برونٛہہ تہٕ ژٕ چُھکھ نہٕ وُنہِ پنٛژہ وۅہُر تہِ۔ ژےٚ وُچھتھن تہٕ وُچھتھن کِتھہٕ پٲٹھؠ۔
\v 58 یسوعنؔ ووٚن یِمن، "بہٕ چُھسو توٚہہِ پوٚز ونان بہٕ اوسُس خدا ابرہامؔ سٕنٛدِ زیٚنہٕ تہِ برونٛہہ
\v 59 چونکہِ سُہ اوس پانس خدا ونان أمِس مخٲلف یہودیٚو تُجہ کنہِ أمِس لاینہٕ باپتھ تاکہِ أمِس کرن از جان مگر یسوعؔ رود ژھٮ۪پہِ ہجومس منٛز تہٕ دراو ہیکلہٕ کہِ صحنہٕ نٮ۪بر۔
\c 9
\p
\v 1 یسوعنؔ وُچھ اکہ وتہِ پکان پکان اکھ زیٚنہٕ دوٚہہ پیٚٹھےَ اوٚن نفرا
\v 2 پننیٚو شاگردو ووٚنُس اُستاد یہِ شخص کٔمؠ سٕنٛدؠ گُنہن کوٚر زیٚنہٕ کالہٕ پٮ۪ٹھٕ اوٚن؟ أمؠ یا امسنٛدؠ مٲلؠ ماجہِ اوسا کانٛہہ گناہ کوٚرمُت۔
\v 3 یسوعنؔ ونُکھ "نَہ کوٚر یہِ کُنہِ پنٕنؠ گناہن تہٕ نَہ مٲلِس ماجہِ ہنٛدؠ گوٚنہن زیٚنہٕ وزِ اون بلکہ اوس یہِ اوٚن زیٚنہٕ گر پیٚٹھےَ اوٚن تاکہِ بہٕ ہاوٕ لوٗکن معجزٕ یِم خدا اسہِ سٟتؠ کرِ۔
\v 4 یٖتِس کالس بہٕ توٚہہِ سٟتؠ چُھس اسہِ پزن معجزٕ کرٕنؠ یِم میون خدا یمؠ بہٕ یور سوزُس یژھان چُھ اسہِ کرناوٕنؠ۔ یِتھٕ پٲٹھؠ راتھ چھےٚ دوٚہس پتہٕ پتہٕ ییٚلہِ لوٗکھ کٲم ہیٚکن نہٕ کٔرِتھ۔ اسہِ تہٕ اسہِ وقتےٕ سوریومُت خدایہِ سنٛز کٲم کرنہٕ باپتھ۔
\v 5 ییٚلہِ زن بہٕ یتھ دُنیہس منٛز وُنہِ موجود چُھس مےٚ چُھ دُنیہس خدایہِ سُنٛد خٲر۔ رٕژر تہٕ پوٚز نور لوٗکن تام واتناوُن۔
\v 6 یہِ ؤنِتھ لٲے أمؠ پتھرِس تھۅکھ تہٕ بناوٕن ربہِ رژھا پننہِ ٲسکہِ لحابہٕ سٟتؠ۔ پتہٕ لٲجِن یہِ رب أمِس ٲنِس أچھن۔
\v 7 امہِ پتہٕ ووٚنُن أمِس أنِس نیر چَھل وُنؠ یہِ رب شِلوخؔ کِس حوضس منٛز آرمنی زبٲنؠ منٛز گو شیلوخؔ یُس سوزنہٕ آمُت چُھ۔ یہِ نفر دراو تہٕ چھلُن امہِ آبہٕ بُتھ تہٕ دراو گرٕ کُن أچھ گاش ہٮ۪تھ۔
\v 8 أمِس نفرٕ سٕنٛدیو ہمسایو تہٕ باقیو یِمو سُہ برونٛہہ وُچھمُت اوس تہٕ ٲسؠ زانان زِ سُہ چُھ اکھ بیچھِ وُن۔ "یہِ ہَے پزی نفر چُھ یُس یتہِ بہتھ بیٚچھان اوس آسان۔
\v 9 کینٛژو ووٚن "آ یہِ ہے چُھ سُے۔ باقیو ووٚن نَہ۔ یہِ چُھ تس ہیٚو۔ مگر أمؠ نفرن ونُکھ پانہٕ، "اوٕ بےٕ چُھس سُہ نفر یُس اوٚن اوس"
\v 10 اوے پرژھُس تِمو، "ژٕ کِتھہٕ پٲٹھؠ چُھکھ وُنؠ وُچِھتھ ہیٚکان۔
\v 11 تٔمؠ ونُکھ، "اکؠ نفرن یمِس لوٗکھ یسوعؔ ونان چھِ بنٲو رب لژھِ تہٕ ٲسکہِ لحابہٕ سٟتؠ تہٕ مٔژھٕن میانٮ۪ن أچھن پتہٕ ووٚننم شیلوم حوضس پٮ۪ٹھ گٔژھِتھ اتھ چھلنہٕ باپتھ۔ بہٕ گوس توٚت تہٕ چٔھجِم یہِ رب۔ امہِ پتہٕ اوسُس بہٕ گاش دار گۅڈنکہِ پھرِ۔"
\v 12 تِمو پرُژھ أمِس مزید، "سُہ نفر کتہِ چُھ وُنؠ۔ "تٔمؠ ونُکھ اورٕ، "مےٚ چھنہٕ خبر سُہ کتہِ چُھ۔"
\v 13 اتہِ موجود کینٛژو نفرو تُل یہِ نفر پانس سٟتؠ تہٕ واتنووُکھ کینژن فریسیسی لوٗکن نِش۔
\v 14 یمہِ دوٚہہ یسوعنؔ رب ٲڈٕر ٲسکہِ آبہٕ سٟتؠ تہٕ أمِس گاش اوٚنُن سُہ اوس یہودٮ۪ن ہنٛدِ آرامُک دوٚہہ۔
\v 15 یِمو فریسیسو کٔر أمِس نفرس بیٚیہِ اکہِ لٹہِ پرٕژھ گٲر۔ وُنکٮ۪س تہِ پرُژھ أمِس یِمو بیٚیہِ زِ تس کِتھہٕ پٲٹھؠ آو أچھن گاش۔ تٔمؠ ونُکھ تٔمؠ نفرن لٲج میانٮ۪ن أچھن رب، مےٚ چٔھج تہٕ وُنؠ چُھس ہیٚکان وُچِھتھ گۅڈنکہِ پھرِ۔
\v 16 کینٛژو فریسیسو ووٚن، "أسؠ چھِ زانان زِ یہ شخص چُھنہٕ خدایہِ سنٛدِ طرفہٕ تکیازِ یہِ چُھنہٕ یہُودؠ آرامکہ دوٚہکؠ قانون مانان۔ "بیٚیہِ کینٛژو ووٚن، "یقیناً ہیٚکہ نہٕ کانٛہہ تہِ گناہ گار تِتھؠ معجزٕ کٔرِتھ یِم سُہ کران چُھ۔ فریسیسی لٔگؠ اکھ أکِس بتھِ یسوعؔ، سٕنٛدِس آسنس متعلق۔
\v 17 یِمو فریسیسو پرُژھ أمِس بیٚیہِ، "أمِس شخصس متعلق کیاہ چُھکھ ژٕ ونان۔ تکیازِ ژٕ چُھکھ پانہٕ ونان زِ أمؠ بنووُکھ ژٕ گاش دار۔ أمؠ نفرن ونُکھ، سُہ گژھِ ضرور رسول آسُن۔
\v 18 چونکہِ أمِس نفرس ٲس پژھ زِ یسوعؔ چُھ رسول۔ یہُودؠ سردارن بیٹھ نہٕ پژھےٕ زِ یہِ نفر کیاہ اوس اوٚن تہٕ پتہٕ بنیو گاش دار۔ یمہِ موجُب یمو أمِس نفرٕ سُنٛد مول موج تہِ ناد دِتھ اوٚن تِمن تہِ پرژھ گٲر کرنہٕ باپتھ۔
\v 19 تِمو پرُژھ امسنٛدِس مٲلِس ماجہِ، "یہِ نفر چھا تُہنٛد نیٚچو؟ توٚہؠ چُھوا ونان زِ یہِ یہِ چُھ زیٚنہٕ گرِ پیٚٹھےَ اوٚن۔ یوٚدوے یی چُھ تیٚلہِ کِتھہٕ پٲٹھؠ چُھ وُنؠ یہِ وُچِھتھ ہیٚکان۔
\v 20 امسنٛدؠ مٲلؠ ماجہِ ونُکھ یورٕ، "أسؠ چھِ وثوقہٕ سان ونان زِ یہِ چُھ سون نیٚچو۔ أسؠ چھِ یِتہِ وثوقہٕ سان ونان زِ یہِ سون نیٚچو اوس زیٚنہٕ پانہٕ پیٚٹھے آماہ۔
\v 21 وُنؠ گو اسہِ چُھنہٕ فِکرے تران زِ یہِ کِتھہٕ پٲٹھؠ گو وُنؠ گاشدار۔ اسہِ چھنہٕ یِتہِ پتاہ زِ یہِ کٔمؠ بنوو وُچھنس لایق۔ أمؠ سےٕ پرٕژھیٚو۔ یہِ چُھ پانہٕ بالیغ یِمن سوالن جواب دِنہٕ خٲطرٕ۔
\v 22 یہُودؠ زِٹھیٚو ٲس برونٛہےٕ یہِ کتھ دٔر رٲومٕژ زِ تِم کرن پرٮ۪تھ کٲنٛسہِ ٹھاکھ یہُودؠ مجلسہِ منٛز اژنس یُس یسوعؔ سنٛدِ مسیحؔ آسنُک کانٛہہ دعوا کرِ۔ امہِ موجُب اوس أمِس نفرٕ سُنٛد مول موج کھۅژان تہٕ اوے ونیٚکھ یمہٕ کِتھٕ
\v 23 اوے تہِ ووٚن یمو یہُودؠ زِٹھیٚن۔ أمسےٕ پرٕژھیٚو۔ یہِ چُھ بالیغ۔
\v 24 اوے اوٚن یِمو یہُودؠ زِٹھیٚو یہِ اوٚن نفر بیٚیہِ اکہِ لٹہِ ناد دِتھ۔ تِمو ووٚن أمِس، "خدایہِ سنٛدِس ناوس دِ جلال پوٚز تہٕ صرف پوٚز ؤنِتھ! اسہِ چھےٚ پانس پوٗرٕ پژھ زِ یہِ انسان یمِس متعلق ژٕ ونان چُھکھ زِ تٔمؠ بنووُکھ ژٕ گاشدار چُھ گناہ گار۔
\v 25 امؠ انسانن یُس یسوعنؔ بلروو وونُکھ یور، "مےٚ چھنہٕ خبر زِ سُہ چھا گناہ گار کِنہٕ نَہ۔ بہٕ زانہٕ اکھ کتھ زِ بہٕ اوسُس اوٚن تہٕ وۅنؠ چُھس گاشدار۔
\v 26 تِمو پرُژھس وۅنؠ، "تِمو کیاہ کوٚرےٕ ژےٚ گاشدار بناونہٕ باپتھ۔ تٔمؠ کِتھہٕ پٲٹھؠ بنووُکھ ژٕ گاشدار۔
\v 27 تٔمؠ ونُکھ، "یِمن سوالن دِیتو مےٚ توٚہہِ برونٛہےٕ جواب مگر توٚہؠ چُھو نہٕ میانٮ۪ن جوابن دھیانےٕ دِوان۔ توٚہؠ کیازِ چُھو مےٚ اکےٕ کتھ بار بار ونناوان۔ کیاہ توٚہؠ ما چُھو تٔمؠ سٕنٛدؠ شٲگرد بنٕنؠ یژھان۔
\v 28 ووٚن لوگ أمِس حقارتہٕ سان ونن، "ژٕ ما چُھکھ تمِس انسان سُنٛد شٲگرد أسؠ چھِ پانہٕ موسیٰؔ سٕنٛدؠ شٲگرد۔
\v 29 اسؠ چھِ پوٗرٕ وثوٗقہٕ سان ونان زِ خدا اوس موسیٰؔ ہس سٟتؠ ہم کلام آسان۔ یمِس انسانس متعلق چھنہٕ اسہِ یِتہِ پتاہ یہِ آو کتہِ پٮ۪ٹھٕ۔"
\v 30 امؠ نفرن دِتُکھ یورٕ جواب، "بہٕ چُھس حٲران زِ توٚہہِ چھنہٕ یِتہِ خبر زِ سُہ آو کتہِ۔ مگر سُہ چُھ سُہ یمؠ مےٚ انٮ۪ر کوس تہٕ انٮ۪ن أچھن گاش اوٚنُن۔
\v 31 اسہِ چُھ یقین زِ خدا چُھنہٕ گناہ گارن ہنٛدِس منٛگنس قبول کران۔ بلکہ چُھ تِمن لوٗکن ہنٛدِس منٛگنس قبول کران یِم  پزنہٕ پٲٹھؠ عبادت گُذار چھِ تہٕ تہِ کران یہِ سُہ یژھِ یِمن کرناوُن۔
\v 32 از تام چُھنہٕ کٲنسے بوزمُت زِ کٲنٛسہِ کیاہ چُھ زیٚنہٕ کالہٕ پیٚٹھُک انٮ۪ر کوسمُت تہٕ أچھن گاش اونمُت۔
\v 33 یوٚدوے انسان خدایہِ سٕنٛدِ پٮ۪ٹھٕ آمُت آسہ ہے تہٕ تٮیٚلہِ کتہِ ہیٚکہِ ہے امہِ لِکھک کانٛہہ تہِ معجزٕ کٔرِتھ۔
\v 34 یِمو یہُودؠ زِٹھیٚو ووٚنُس یورٕ، "ژٕ اوسُکھ زمُت اوٚن پننہِ مٲلِس مٲجہِ ہںٛدیٚو گنہو کِنؠ۔ ژےٚ کتھ چُھےٕ اسہِ ہٮ۪چھناونہٕ باپتھ پنن تال وتھان۔ امہِ پتہٕ کوٚر یِمو أمِس یہُودؠ مجلس ہنٛدِ جایہِ یِنس ٹھاکھ۔
\v 35 یسوعنؔ بوز زِ یہُودؠ زٕٹھیٚو تمِس نفرس یہُودؠ مجلسہِ ہنٛزِ جایہِ یِنس ٹھاک لوگمُت یُس تٔمؠ بلروومُت اوس۔ ییٚلہِ تٔمؠ یہِ نفر ژھٲنٛڈِتھ اوٚن پرژھنس، "ژٕ چُھکھا آدمؔ سٕنٛدِس گۅبرس پٮ۪ٹھ پژھ کرن؟"
\v 36 امؠ نفرن ووٚنُس اورٕ، "جناب سُہ کُس گو" مےٚ ؤنؠ تو تاکہِ بہٕ کرٕ تس پٮ۪ٹھ پژھ۔
\v 37 یسوعنؔ ووٚنُس۔ ژےٚ وُچھتن سُہ برونٛہےٕ۔ بہٕ چُھس سُہ شخص یُس ژےٚ سٟتؠ کتھ کران چُھ۔
\v 38 امؠ انسانن ووٚنُس، "خداوند بہٕ چُھسے پژھ کران زِ ژٕ چُھکھ آدمؔ سُنٛد گۅبُر۔ ادٕ ووٚتھ سُہ کوٚٹھٮ۪ن پٮ۪ٹھ تہٕ کوٚرنس سجدٕ
\v 39 یسوعنؔ ووٚن، "بہٕ چُھس آمُت یتھ دُنیاہس منٛز لوٗکن عدالت لاگنہِ۔ نتیجہٕ نیرِ زِ تم لوٗکھ یِم یہِ ژینان چھِ زِ تِم چھِنہٕ خدا ڈیشِتھ ہیٚکان چُھ۔ پرزٕناون اتھ أکِس أنؠ سٕنٛدؠ پٲٹھؠ یمِس انٮ۪ر ژوٚل تہٕ گاش آو۔ بیاکھ نتیجہٕ نیرِ تِم لوٗکھ یِمن یہِ سونچ چُھ زِ تِم چھِ خدا سنٛز حقیقت ژینتھ ہیٚکان۔ ہیٚکن نہٕ تس پرزٕنٲوتھ تہٕ وُچِھتھ تمِس انسان سٕنٛدؠ پٲٹھؠ یمِس گاش چُھ مگر پیوان چُھس انٮ۪ر۔
\v 40 ییٚلہِ کینٛژو فریسیو یِم نکھے ٲسؠ یسوعؔ یہِ ونہ نا بوز، تِمو پرُژھُس، "ژٕ چُھکھا سونچان زِ اسؠ تہِ چھِنہٕ خدا سنٛز حقیقت امسُنٛد آسُن پرزٕنٲوتھ ہیٚکان۔ انٮ۪ن ہنٛدؠ پٲٹھؠ۔
\v 41 یسوعنؔ ونُکھ، "یوٚدوے توٚہہِ پانے زونو زِ توٚہؠ چُھو روحٲنی طور أنؠ۔ توٚہہِ کھسہِ نہٕ گنہُک راہ مگر چونکہِ توھے چُھو دعوا کران خدا سنٛز حقیقت زاننچ۔ أکِس وچُھن وٲلؠ سٕنٛدؠ پٲٹھؠ توٚہؠ چُھن پننہِ گنہُک سزاوار۔
\c 10
\p
\v 1 بہٕ یسوع چُھسو پزر ونان۔ یُس کانٛہہ تہِ تیٖر وٲرِس منٛز امکہِ برٕ ورٲے بیٚیہِ کُنہِ کِنؠ تہِ اژِ چُھ لٲزمن ژوٗر یا ڈاکو۔ یُس تیر ژوٗرِ نِنہٕ آمُت چُھ
\v 2 تہٕ سُہ انسان یُس تیٖر وٲرِس منٛز برٕ کِنؠ اژِ چھِ تیرؠ رٲچھ۔ یُس یِمن تیرن چھان چُھ
\v 3 سُہ شخص یُس پہلؠ سنٛزِ غٲر حٲضری منٛز واڈٕ کِس برس پٮ۪ٹھ رٲچھ راوٹھ کرن وول چُھ پہلِس بر ووٚتھ تراوان ییٚلہِ سُہ ییہِ۔ تیٖر چھِ رٲچھ در سنٛز آواز پرزٕناوان۔ سُہ چُھ پننٮ۪ن تیرن پننہِ پننہِ ناوٕ بُلاوان تہٕ پانس پتہٕ پتہٕ واڈٕ منٛزٕ کڈان۔
\v 4 یِمن تیرن وارِ منٛزٕ نٮ۪بر کٔڑِتھ چُھ تیٖر رٲچھ یِمن برونٛہہ برونٛہہ پکان۔ پنٕنؠ تیرؠ چُھس سٲری پتہٕ پتہٕ روزان۔ تسٕنٛدؠ تیر چھِ تمِس پتہٕ پتہٕ پکان تکیازِ تِم چھِ امسنٛزِ آواز پرزٕناوان۔
\v 5 امسنٛدؠ تیر نیرن نہٕ ہرگز تہِ کٲنٛسہِ وۅپرس پتہٕ پتہٕ یمِس نہٕ تِم زانان آسن۔ بلکہِ ژلن أمِس نِش دوٗر تکیازِ یِم چھِنہٕ کٲنٛسہِ وۅپر سنٛز آواز پرزٕناونےٕ۔
\v 6 یسوعنؔ ؤنؠ یہِ تمثیل تمن پہلین ہنٛزٕ کامہِ وُچِھتھ فریسین۔ مگر تِمو ہیٚچ نہٕ یہِ تمثیل سمجھتھےٕ۔
\v 7 یسوعنؔ ووٚن یِمن اوے بیٚیہِ، "بہٕ چُھسو پزر ونان۔ بےٕ چُھس امہِ تیر واریُک برٕ یپٲرؠ تیٖر وٲرِس منٛز اژان چھِ۔
\v 8 تِم تمام زِٹھؠ یِم مےٚ برونٛہہ خدایہِ سٕنٛدِ حکمہٕ ورٲے یور آے ٲسؠ ژوٗر تہٕ ڈاکو۔ مگر اصل تیرو بوزنہٕ تہنٛز کتھ۔\f + \fr 10‏:8 \ft یہِ چُھ تِمن زٹھین کُن اشارٕ کران یِمو تِمن لوٗکن استحصال کور یِم خداین تہنز رٲچھ راوٹھ کرنہٕ خٲطرٕ ژٲرِمٕتؠ ٲسؠ۔ یِمن منز چھِ شٲمل اپزؠ مسیحؔ تہٕ تِم فریسی تہٕ صدوقی یِم یسوع سنٛدِ وقتہٕ تتہِ ٲسؠ۔ یرمیاہ 23:1\f*
\v 9 بےٕ چُھس پانہٕ جنتُک دروازٕ۔ خدا بخشہِ تمِس نجات ابدی سزا نِشہ یس تمس نِش ییہِ مےٚ پٮ۪ٹھ پژھ کرتھ۔ سُہ یُس تہِ مےٚ پٮ۪ٹھ پژھ تھاوِ چُھ تمِس تیرس ہیٚو یس حفاظتس منٛز اورٕ یور پکان چُھ تہٕ پنن کھیٚن لبان چُھ۔\f + \fr 10‏:9 \ft زبور 118:20\f*
\v 10 تہنٛدؠ زِٹھؠ چھِ ژوٗر یِم چھرا لوٗٹنہِ، مارنہ تہٕ تیرن بُرباد کرنہِ آمٕتؠ چھِ۔ بہٕ چُھس آمُت تیرن پوشوٕنؠ زندگی دِنہِ یوٚسہٕ مکمل برکت واجِنؠ آسہ۔
\v 11 بہٕ چُھس پانہٕ أکس رٕتِس پہلؠ سنٛدؠ پٲٹھؠ۔ رُت پوہول چُھ پنٕنؠ زندگی چھپہِ دِنہٕ باپتھ تیار آسان پننٮ۪ن تیرن بچاو کرنہٕ باپتھ۔ بہٕ تہِ چُھس پننٮ۪ن شٲگردن ہنٛدِ باپتھ مرنس تیار۔\f + \fr 10‏:11 \ft زبور 23:1، یسعیاہؔ 40:11، حزقیل 37:24\f*
\v 12 فرض کرو اکھ نفر چُھ أکِس تِتھِس نفرس مُزورِ پٮ۪ٹھ رٹان یُس نہٕ پوہول چُھ تہٕ یمس پنٕنؠ تیر تہِ چھِنہٕ۔ ییٚلہِ یُتھ نفر رامہٕ ہوٗنس یوان وُچھِ تیرن پٮ۪ٹھ حملہٕ کرنہِ سُہ چُھ تیرؠ ترٲوتھ پانہٕ ژلان تہٕ رامہٕ ہوٗن چُھ کینٛژن تھپھ ژھٕنان تہٕ باقین چھلہٕ چھانگرِ کران۔
\v 13 یہِ مُزور لاگنہٕ آمُت نفر چُھ دو تراوان تکیازِ سُہ اوس یِمن تیرن رٲچھ کران پننہِ مُزورِ باپتھ۔ تیرن کیاہ بنہِ تس چُھنہٕ امیُک کانٛہہ پرواہ۔
\v 14 بہٕ چُھس پانہٕ اکھ رُت تیر رٲچھ۔ یتھٕ پٲٹھؠ اکھ رُت تیر رٲچھ پننٮ۪ن تیرن زانہِ تہٕ تیر زانن تس بہٕ زانکھ تِم سٲری یِم میٲنؠ چھِ۔ تہٕ تم تہِ زانن مےٚ۔
\v 15 أسؠ زانو اکھ أکِس۔ تِتھے پٲٹھؠ یتھٕ پٲٹھؠ زن میون مول تہٕ بہٕ اکھ أکِس زانو۔ بہٕ چُھس یِمن تیرن ہنٛز بہبودی تہٕ رٲچھ باپتھ مرنس تیار۔ یِم میٲنؠ چھِ۔
\v 16 کینٛہہ بیٚیہِ تہِ تیر چھِ میٲنؠ یِم باقیو تیر وٲریو پٮ۪ٹھٕ آمٕتؠ چھِ یِم گے تِم لوٗکھ یِم یہُودؠ چھِنہٕ۔ مےٚ پزم یِم تہِ پانس نِش انٕنؠ۔ تِم کرن میانہِ کتھہِ پٮ۪ٹھ عمل تہٕ میٲنؠ سٲری تیر بننن یِکہٕ وٹہٕ اکھ کھیوٚل تہٕ بہٕ آسہٕ تہنٛدِ تیرؠ رٲچھ۔
\v 17 میون مول چُھ مےٚ لول بران تکیازِ بہٕ چُھس تیار مرنہٕ باپتھ تاکہِ دُبارٕ گژھٕ زندٕ۔
\v 18 مےٚ چُھنہٕ مرنہٕ باپتھ کانٛہہ جبر کران۔ بلکہِ چُھ مےٚ پنُن مرُن پانہٕ ژورمُت۔ مےٚ چُھ اختیار پننہِ اِرادٕ مرنُک تہٕ مےٚ چُھ اختیار پنُن پان دُبارٕ زِنٛدٕ کرنُک۔ یہےَ کٲم چھےٚ میٲنؠ مٲلؠ مےٚ کرنُک حکم دیُتمُت۔
\v 19 یسوعنؔ یُتھےٕ یہِ ووٚن یہُودؠ زِٹھؠ گے پانہٕ وٲنؠ مخالف ٹوگجن منٛز۔
\v 20 واریہو یہُودؠ زِٹھیٚو ووٚن أمِس چُھ بدروح رٔٹِتھ تہٕ یہِ چُھ مجنون مہ بوزِو امسُنٛد۔
\v 21 بیٚیہِ کینٛژو ووٚن، "یہِ سُہ ونان چُھ ہیٚکہِ نہٕ سُہ شخص ؤنِتھ یُس بدروح سنٛدِس حکمس تل آسہ۔ یقیناً بناوِ نہٕ بدروح کٲنٛسہِ أنِس گاشدار۔
\v 22 امہِ پتہٕ آیہِ یروشلمہٕؔ کِس ہیکلس مخصوص کرنچؠ عید مناونٕچ دعوت دنہٕ۔ اتھ دوران ٲسؠ لوٗکھ خٟمن منز روزان۔
\v 23 یسوعؔ اوس ہیکل کِس اندرمس آنٛگنس منٛز پھیران یتھ سلیمانؔ سُنٛد برانٛد ونان چھِ۔
\v 24 یہُودؠ زِٹھؠ آے یسوعسؔ انٛدؠ انٛدؠ سمِتھ تہٕ پرُوژھہس۔ ژٕ کٲتِس کالس تھاوکھ اسہِ پریشان پننس اتہ پتہ ہس متعلق یوٚدوے ژٕ مسیحؔ چھُکھ۔ ون اسہِ صاف صاف تاکہِ أسؠ زانو۔"
\v 25 یسوعنؔ ونُکھ یورٕ، "مےٚ چُھو ووٚنمُت توٚہہِ۔ مگر توٚہؠ چُھو نہٕ توتہِ مےٚ پٮ۪ٹھ پژھ کران پننس مٲلؠ سٕنٛدِس حکمس تل یِم معجزٕ بہٕ کران چُھس تم وننو توٚہہِ تہِ سورےٕ یہِ بہٕ چُھس۔
\v 26 بہرحال توٚہؠ کٔرِو نہٕ توتہِ پژھ تکیازِ توٚہؠ چُھو نہٕ میٲنؠ برٕ۔ توٚہؠ چُھو تم تیر یِم میانہِ کھیٚلِکؠ چھِنہٕ۔
\v 27 یتھٕ پٲٹھؠ تیرؠ پننس رٲچھ سنٛزِ آوازِ مازان چھِ میٲنؠ لوٗکھ چھِ میٲنِس وننس مازان۔ بہٕ زانکھ تِم تہٕ تِم چھِ میٲنؠ شٲگرد۔
\v 28 بہٕ چُھس تمن پوشوٕنؠ زندگی پراونس لایق بناوان آسمانن منٛز خدایس ستؠ۔ تِمن ہیٚکنہٕ کانٛہہ بُرباد کٔرِتھ۔ تہٕ کانٛہہ تہِ ہیٚکنہٕ زانہٛہ تِمن مےٚ نِش دوٗر نِتھ۔
\v 29 تِم دِتؠ مےٚ پنٕنؠ مٲلؠ۔ سُہ چُھ پرٮ۪تھ کٲنٛسہِ کھۅتہٕ بوٚڈ تہٕ عظیم تہٕ کٲنٛسہِ چُھنہٕ طاقت تِمن تس نِشہ دوٗر نِنس۔
\v 30 میون مول تہٕ بہِ چھِ اکُے خدا
\v 31 یہُودؠ زِٹھیٚو تُجہ بیٚیہِ کنہِ تِمس لاینہٕ باپتھ تہٕ مارنہٕ باپتھ۔
\v 32 یسوعؔن ووٚن یِمن۔ توٚہہِ وُچھووُس بہٕ پننِس مٲلؠ سٕنٛدِ حکمہٕ واریاہ معجزٕ کران۔ تِمو منٛزٕ کمہِ باپتھ چُھو توٚہؠ مےٚ کنہِ لٲیِتھ مارُن یژھان؟
\v 33 یہُودؠ زِٹھیٚو ونُس یورٕ، "أسؠ چھی نہٕ ژےٚ کنہِ مٲرِتھ مارُن یژھان پننہِ کُنہِ رِژِ کامہِ باپتھ بکلہ چِھتھ مارُن یژھان تکیازِ ژٕ چُھکھ خدایس کفر کران یہِ دعوا کرتھ کہ ژٕ چُھکھ خدا، ہرگاہ ژٕ چھرا اکھ انسان چُھکھ۔\f + \fr 10‏:33 \ft احبار 24:16\f*
\v 34 یسوعنؔ ونُکھ یورٕ، "پرٲنس عہدنامس منٛز چُھ اکھ نبی لیٚکھان زِ خداین ووٚن، "مےٚ ونَو زِ توٚہؠ چُھو خدا۔\f + \fr 10‏:34 \ft زبور 82:6\f*
\v 35 چونکہِ خداین ووٚن پننٮ۪ن مخاٲطبن خدا تہٕ کانٛہہ تہِ ہیٚکہِ نہٕ یمن مقدس صحیفن اپُز ؤنِتھ
\v 36 توٚہؠ کیازِ چُھو ونان زِ بہٕ چُھس کفُر ونان تکیازِ مےٚ ووٚن بہٕ چُھس خدا سُنٛد نیٚچو۔ بےٕ چُھس سُہ یُس میٲنؠ مٲلؠ خاص پٲٹھؠ ژور پنپن تہٕ تمؠ سُنٛد یتھ دنیہس منٛز۔
\v 37 یوٚدوے بہٕ تِم معجزٲتی کامہِ کرہا نہٕ یِم میون مول یژھان چُھ مےٚ کرناونہِ مےٚ تیٚلہِ پزِہے نہٕ توٚہہِ مےٚ پٮ۪ٹھ پژھ کرٕنؠ۔
\v 38 چونکہِ بہٕ چُھس یِمہٕ کامہِ کران توٚہہِ پزِ پژھ کرٕنؠ تتھ پٮ۪ٹھ یہِ یِمہٕ کامہِ مےٚ متعلق توٚہہِ ونان چُھو۔ یوٚدوے توٚہہِ مےٚ پٮ۪ٹھ پژھ آسیٚو تٮ۪نہٕ۔ توٚہہ پزِ یہِ کرن یہِ زاننہٕ باپتھ زِ بہٕ تہٕ میون مول چُھ دوٚشوے کُنی۔
\v 39 چونکہِ أمؠ ونہِ یِمہٕ کِتھہٕ یہُودؠ زِٹھیٚو کریاے ژھل یہِ بٲنٛدؠ بناونچ مگر سُہ دراو بچِتھ یِمو نِشہ۔
\v 40 امہِ پتہٕ توٚر یسوعؔ واپس یردن دریاوس۔ سُہ گو تتھ جایہِ یتہِ بپتسمہ دِنہٕ وٲلؠ یوحناہن گۅڈٕ کالہٕ لوٗکن بپتسمہ دیُتمُت اوس۔ اتہِ رود یسوعؔ کینٛہہ کالےٕ۔
\v 41 یسوعسؔ نِش وٲتؠ اور واریاہ لوٗکھ تِمو ووٚن، "بپتسمہ دِنہٕ وٲلؠ یوحناہن کوٚر نہٕ کانٛہہ تہِ معجزٕ۔ مگر یوحناہن یِتہِ کینٛہہ یمِس نفرس متعلق ووٚن چُھ پوٚز۔
\v 42 اتہِ کٔر واریہو لوٗکو أمِس پٮ۪ٹھ پژھ قٲیِم۔
\c 11
\p
\v 1 لازرؔ ناوُک اکھ شخص گو سخت بٮ۪مار۔ سُہ اوس بیت عنیاہ ہُک روزن وول یتہِ أمؠ سنٛزٕ بیٚنہِ مریمؔ تہٕ مارتھاؔ تہِ روزان آسہٕ۔
\v 2 یہِ چھےٚ سۅے مریمؔ یۅسہ برونٛہہ پہن اکہِ دوٚہہ خداوندس عطر چھکہ تہٕ امسنٛدٮ۪ن کھۅرن ہُند عٲرق وۅتھراوِ پننہِ مستہٕ سٟتؠ۔ یہِ اوس تمؠ سُنٛد بوے لازرؔ یُس بؠمار اوس۔
\v 3 اوے سوز یٕمو دوٚیو بیٚنیو یسوعسؔ نِش لازرؔ سنٛزِ بٮ۪مارِ ہنٛز شیٚچھ ہٮ۪تھ اکھ نفر۔ تِمو ووٚنُس، "ہے خداوند۔ چون ٹوٹھ چُھ سخ بٮ۪مار مہربٲنی کٔرِتھ أنِو تشریف۔"
\v 4 ییٚلہِ یسوعنؔ بوز زِ لازرؔ چُھ بٮ۪مار تٔمؠ ووٚن، "یہِ بٮ۪مٲرؠ ہیٚکہِ نہٕ لازرٕ سنٛدِ موتُک بٲعث بنتھ۔ بلکہِ چُھ امہِ دادیُک مطلب یُتےٕ یہِ ہاوُن زِ خدا کوتاہ عظیم چُھ۔ لازرؔ سپدِ علیل بس یہِ باونہٕ باپتھ زِ بہٕ خدایہِ سُںنٛد گۅبُر کوتاہ عظمت وول چُھ"
\v 5 یسوعؔ اوس یِمن تریٚشوٕنؠ لول بران۔ مارتھایہِ تس سنٛز بیٚنہِ مریمس تہٕ لازرسؔ۔
\v 6 یُتھےٕ یسوعنؔ یہِ بوز زِ لازرؔ چُھ بؠمار سُہ رود زٲنِتھ مٲنِتھ بیٚیہِ زٕ دوٚہہ أتی یتہِ سُہ اوس۔
\v 7 یِمو دوٚیو دوٚہو پتہٕ ووٚن یسوعنؔ پننٮ۪ن شٲگردن۔ پٔکِو أسؠ نیرو واپس یہُوداؔ کُن۔
\v 8 شاگردو ووٚنُس واپس، "یہُوداؔ زِٹھؠ چھۍ تتہِ یہُوداؔ شہرس منٛز ژےٚ کنہِ لٲیِتھ سنگسار کٔرِتھ مارُن یژھان۔ ژےٚ پزی نہٕ یقیناً تور واپس بیٚیہِ گژھُن۔
\v 9 یسوعنؔ ونُکھ، "توٚہہِ چھےٚ پتاہ زِ دوٚہُل چُھ باہ گنٹہٕ۔ کانٛہہ تہِ نفر یُس دوٚہلہِ سفر کرِ ہیٚکہِ آرام سان یہِ کٔرِتھ تکیازِ دوٚہلؠ گاش ہاوِ أمِس صاف زِ سُہ کوٚت چُھ گژھان۔
\v 10 وۅنؠ گو ییٚلہِ کانٛہہ رات کیُت سفر کرِ تس لگہ بعضے کھونٛد تہِ یا ییہِ وُکراونہٕ تکیازِ سُہ ہیٚکہِ نہٕ وُچھتھےٕ پنٕنؠ وتھ۔
\v 11 یِمہٕ کینٛہہ کِتھہٕ کٔرِتھ ووننکھ، "سون یار لازر چُھ شونٛگِتھ مگر بہٕ گژھٕ تو تمِس وُزناونہِ۔
\v 12 اوے ووٚنُس اورٕ پننیٚو شاگردو، "خداوند! یوٚدوے سُہ شوٚنگِتھ چُھ تیٚلہِ گژھِ سُہ اوٚر تہِ۔"
\v 13 یسوعسؔ اوس ژکہِ العزرؔ سٕنٛدِ مرنچ کتھ کران۔ مگ بہٕ گژھٕ توٚت تمِس وُزناونہِ۔ مگر شاگردو زون زِ سُہ چُھ بس نٮ۪نٛدرِ ہنٛز کتھ کران۔
\v 14 اور ونُکھ یسوعنؔ کتھ کھولِتھ، "لازر چُھ مودمُت۔
\v 15 تہٕ بہٕ چُھس خوش زِ بہٕ اوسُس نہٕ تتہِ۔ مےٚ دیُت یہِ سپدنہٕ تاکہِ توٚہؠ دٔر رٲیو مےٚ پٮ۪ٹھ پنٕنؠ پژھ۔ یہِ چُھ تُہنٛدِ فٲیدٕ باپتھ۔ یتہِ روزنہٕ بدلہٕ پکو أسؠ تورؠ کُن یتہ سُہ چُھ
\v 16 اوے ووٚن تُوماہن یمِس "دوکر تہِ ونان اسؠ باقین شٲگردن۔ ؤلِو أسؠ تہِ گژھو تورؠ استادس سٟتؠ تاکہِ تٔسؠ سٟتؠ مرو۔"
\v 17 ییٚلہِ یسوعؔ اور ووت بیت عنیاہ کِس گامس منٛز تٔمؠ بوز زِ لوکو اوس برونٛہےٕ العزرؔ سُنٛد مۅردٕ جسم مقبرس منٛز ژوٚن دوٚہُن ہُنٛد واتنوومُت۔
\v 18 یروشلم اوس بیت عنیاہ پٮ۪ٹھ الہٕ پلہٕ ترےٚ کلومیٹر دوٗر
\v 19 واریاہ یہُودؠ آے مارتھایہؔ تہٕ مریمسؔ نِش تمن بٲے سٕنٛدِس یعنی العزر سنٛدِس مرنس پٮ۪ٹھ تعزیت کرنہٕ باپتھ۔
\v 20 ییٚلہِ مارتھایہِؔ بوز کُستام یہِ ونان زِ یسوعؔ چُھ یورؠ پکان سۅ درایہ تس برونٛٹھ نیرنہٕ باپتھ نٮ۪بر۔ مریمؔ درایہِ نہٕ أمِس سٟتؠ بلکہِ روز انٛدرےٕ۔
\v 21 ییٚلہِ مارتھاؔ یسوعسؔ سمکھییہِ تمہِ ووٚنُس، "خداوند! کاش ژٕ آسہٕ ہکھ ؤلؠ ؤلؠ آمُت میون بوے مرِ ہے نہٕ۔
\v 22 بہرحال وۅنؠ گو مےٚ چُھ وُنتہِ ییٚلہِ زن سُہ مود یقین زِ خدا کرِ بلکل تی یہٕ ژٕ تمِس ونکھ۔
\v 23 یسوعنؔ ووٚنُس، "چون بوے گژھِ بیٚیہِ زندٕ۔
\v 24 مارتھایہؔ ووٚنُس یور، "مےٚ چُھ یقین زِ میون بوے گژھِ بیٚیہِ زندٕ ییٚلہِ قیامت کہِ ٲخرے دوٚہہ خدا سارنےٕ مۅردن زندٕ تُلہِ تِمن عدالت لاگنہٕ باپتھ۔\f + \fr 11‏:24 \ft عملہٕ 24:15\f*
\v 25 یسوعؔن ووٚن تس، "بہٕ چُھس سُہ یُس مۅردن زندٕ کران چُھ۔ بےٕ چُھس لوٗکن پوشوٕنؠ زندگی بخشن وول۔ سُہ ہر کانٛہہ یُس مےٚ پٮ۪ٹھ پژھ کرِ بیٚیہِ پوشوٕنؠ زندگی یوٚدوے تسُںنٛد جسم مرِ تہِ۔
\v 26 تم تمام یِم پوشوٕنؠ زندگی پراون تہٕ مےٚ پٮ۪ٹھ پژھ تھاون روزن یقیناً ہر ہمیشہٕ زندٕ۔ یقین چِھیا یہِ چُھ پوٚز؟"
\v 27 مارتھایہِؔ ووٚنُس۔ آ! مےٚ چھےٚ پژھ۔ خداوند۔ مےٚ چُھ یقین زِ توٚہؠ چُھو مسیحؔ خدایہِ سٕنٛدؠ نیٚچوؠ۔ توٚہؠ چُھو خدایہِ سنٛدؠ وعدہ موجُب بیٚیہِ یتھ دنیہس منٛز یٕنہٕ وٲلؠ۔
\v 28 ییٚلہِ تمہِ یہِ ووٚن سۅ پھیر گرٕ کُن تہٕ لوٚتہِ پٲٹھؠ اننٲوٕن تس سنٛز بیٚنہِ مریمؔ۔ تٔمؠ ووٚن مریمسؔ، "استاد آو تہٕ سُہ چھُے ناد دِوان۔
\v 29 ییٚلہِ مریمنؔ بوز پننہِ بٮیٚنہِ ہنٛز کتھ۔ سۅ ؤژھ ؤلؠ تھوٚد تہٕ آیہِ نٮ۪بر نیرتھ یسوعسؔ سمکھنہِ۔
\v 30 اوٚت تام اوسنہٕ یسوعؔ بیت عنیاہ کِس گامس منٛز ژامُت تہٕ اوس تٔتی یتہِ مارتھاؔ تس سمکھییہِ۔
\v 31 یہُودؠ لوٗکھ یِم مریمسؔ پننہِ گرِ تسلی دِوان ٲسؠ تہِ ؤتھؠ مریمسؔ سٟتؠ تھوٚد تہٕ دراے نٮ۪بر أمِس پتہٕ پتے۔ تِمو کوٚر انٛدازٕ زِ سۅ گژھِ مقبرس پٮ۪ٹھ یتہِ تِمو العزرؔ دفن کوٚرمُت اوس تتہِ پننِس بٲے، س ودنہِ۔
\v 32 ییٚلہِ مریم تتھ جایہِ وٲژ یتنس یسوعنؔ مارتھاؔیہ سٟتؠ کتھ کٔر۔ تہٕ وچُھن سۅ۔ تمہِ تروو پنُن پان پتھرِس تمسنٛدٮ۪ن پاین پٮ۪ٹھ۔ تمہِ ووٚن أمِس، "ہے خدا وند۔ کاش توٚہؠ ٲسؠ ہو ہنا سُلہِ آمٕتؠ۔ میون بوے ما مرِ ہے۔"
\v 33 ییٚلہِ یسوعنؔ سۅ ودان رِوان وُچھ تہٕ تس سٟتؠ آمٕتؠ یہُودؠ تہِ۔ سُہ گو سخت برہم۔
\v 34 تٔمؠ پرُژھ توٚہہِ کتہِ دفنٲوووٕن تمؠ سنٛز لاش۔ "تِمو ووٚنُس، "خداوند ؤلِو وُچھِو سُہ کتہِ چُھ۔
\v 35 یسوعنؔ تہِ ہیوفت اوٚش ہارُن۔
\v 36 لہٰذا ووٚن مریمس سٟتؠ آمتیٚو یہودیٚو اکھ أکس، "وُچھِو یہِ کوتاہ اوس لازرسؔ لول بران!"
\v 37 وۅنؠ گو باقیو ووٚن پانہٕ وٲنؠ، "یہِ چُھ ہیٚکان انٮ۪ن گاش دِتھ۔ ممکن چُھ أمِس آسہ نہٕ مرنہٕ نِش بچاونُک طاقت"
\v 38 یسوعؔ آو بیٚیہِ مقبرس نکھہٕ وٲتِتھ بربکہٕ یہِ ٲس اکھ گوٚپھ یتھ اژنہٕ باپتھ پٮ۪ٹھ دولہٕ پل اوس آمُت تھاونہٕ
\v 39 یسوعن دیت حکم، "یہِ پل تُلِو گۅپھِ گلہِ پٮ۪ٹھٕ تھوٚد۔ "مگر لازرؔ سنٛزِ بیٚنہِ مارتھایہِؔ ووٚنُس، "خداوند۔ ونیُک تام آسہ امسنٛدِس جسمس بدبو ؤژھمٕژ تکیازِ سُہ مود ژور دوٚہہ برونٛہہ"
\v 40 یسوعن وون تس، "مےٚ ژےٚ پوٗرٕ پژھِ وۅنےٕ زِ یوٚدوے توٚہؠ مےٚ پٮ۪ٹھ پژھ تھٲیِو توٚہؠ وُچھِو پانے خدا کوتاہ عظیم چُھ۔
\v 41 کینٛژو لوٗکو تُل امہِ مقبرکہ اژنہٕ باپتھ پل تھوٚد۔ یسوعنؔ وُچھ ہیٚور کُن آسمانس کُن تہٕ ووٚنُن، "مولا۔ مالیا! میٲنِس وننس کن تھاونس شُکریہ۔
\v 42 بہٕ چُھس زانان زِ ژٕ چھُکھ ہمیشہٕ میون بوزوُن۔ وۅنؠ گو مےٚ وونےٕ یہِ یمو یتہِ موجود لوٗکن بوزناوننہٕ باپتھ۔ مےٚ وۅنُے یہِ تاکہِ، یِمن لگہ بھروسہٕ بہٕ سوزتھس ژےٚ۔
\v 43 یہِ دُعا منٛگنہٕ پتہٕ دِژ تٔمؠ زورٕ کرٮ۪کھ لازرؔ "مقبرٕ منٛزٕ نیر نٮ۪بر"
\v 44 یہِ مودمُت انسان آو مقبرٕ منٛزٕ نیٚبر نیرتھ! یِمو لوکو یہِ دفناونہِ کرنہٕ خٲطرٕ تیار کوٚڑمُت اوس تِمو ٲسؠ امسٕنٛدؠ کھوٚر تہٕ اتھ دجہٕ رادو سٟتؠ گنٛڈمٕتؠ تہٕ تمسٕنٛدِس بُتھِس تہِ اوسُکھ پلو ولمُت۔ یسوعنؔ ووٚن اتہِ وۅدٕنؠ لوٗکن "یِمہٕ أمِس گنڈنہٕ آمژٕ دجہِ مُژرٲیو أمِس۔ أمِس دِیو نیرنہٕ۔"
\v 45 اوٕ کِنؠ اوٚن تِمو واریہو یہُودیو أمِس پٮ۪ٹھ ایمان یِم اوٚت مریمسؔ تسلی دِنہِ آمٕتؠ ٲسؠ تہٕ یسوعؔ سُنٛد یہِ مرُن معجزٕ وُچھ۔
\v 46 مگر یِمو منٛزٕ کینٛہہ لوٗکھ دورییہ فریسین تہٕ ونُکھ تِمن یہِ سورےٕ یہِ زن یسوعنؔ کوٚر۔
\v 47 حکمران کاہن تہٕ فریسیسی گے سٲری جمع عدالتہٕ کٮ۪ن زِٹھٮ۪ن سان۔ تِم ٲسؠ اکھ أکِس ونان ٲخٕر أمِس انسانس کرو کیاہ۔ سُہ چُھ واریاہ معجزٕ کران۔
\v 48 یوٚدوے أسؠ أمِس یہِ لگاتار کرنہٕ دِمو پرٮ۪تھ کانٛہہ کرِ أمِس پٮ۪ٹھ پژھ تہٕ بناون أمِس پنُن بادشاہ اوٕ کِنؠ ییہِ رومی فوج اسہِ پٮ۪ٹھ وۅگلِتھ تہٕ کرِ ہیکل تہٕ لوٗکن بُرباد۔
\v 49 امہِ یہُودؠ مجلسِ مشاورتُک اکھ رکُن اوس کایفاؔ۔ امہِ وریہِ اوس یہِ زیُٹھ کاہن۔ أمؠ ووٚن یِمن، "توٚہؠ لوٗکھ چُھو نہٕ زانن کہین!"
\v 50 تہٕ نہٕ چُھو ژینان زِ یہِ روزِ زیادٕ بیتر زِ اکھ نفر مرِ تمام باقیو لوٗکو بدلہٕ یمن أمِس نفرٕ سٕنٛدِ باپتھ رومی مارن۔
\v 51 کیفاہن ووٚن نہٕ یہِ اوٕ کِنؠ زِ یہِ اوس تس پنُس سونچ بلکہِ ووٚنُن اوٕ کِنؠ زِ سُہ اوس امہِ وری زیُٹھ کاہن، سُہٕ اوس پیشن گوئی کران زِ یسوعؔ مرِ یہودی لوٗکن ہنٛدِ طرفہٕ۔
\v 52 زِ یسوعؔ مرِ نہٕ صرف یہُودؠ لوٗکو باپتھ بلکہ خدایہِ سنٛدٮ۪ن سارنےٕ شُرٮ۪ن اکھ بناونہٕ باپتھ تہٕ یِم خداین سٲرسےٕ دُنیاہس منٛز چھکرٲومٕتؠ چھِ۔
\v 53 کیفا سنٛزِ پیش گوییٔ پتہٕ یِنہٕ والیٚن دوٚہُن منٛز کوٚر أمؠ یہُودؠ مشاورتن یسوعؔ مارنٕچ ژوٚۓ۔
\v 54 اوٕ کِنؠ پھیور نہٕ پتہٕ یہُودؠ علاقو منٛزؠ زہنٛؠ یسوعؔ کھُلہٕ پٲٹھؠ۔ اتھ برعکس ترووُن یروشلم تہٕ گو اکِس افرائیمؔ ناوکِس قصبس منٛز یُس أکِس بیابانس منٛز چُھ۔ کینٛہہ کالا رود یسوعؔ پنٕنؠ شٲگرد ہٮ۪تھ أتی۔
\v 55 یِمنےٕ دوٚہُن منٛز ٲس یہودٮ۪ن ہنٛز عید فسع تہِ یِنہٕ واجِنؠ۔ امہِ علاقہٕ پٮ۪ٹھٕ تہِ گے واریاہ لوٗکھ یروشلم۔ تمہِ آے واپس پھیرِتھ امہ عیذ برونٛہےٕ رسمی سران صفٲیی کرنہٕ باپتھ۔ یہُودؠ شریعت مطٲبق۔\f + \fr 11‏:55 \ft 2 اخبار 30:17\f*
\v 56 لوٗکھ رودؠ یسوعسؔ ژھاران یروشلم عید فسع مناونہٕ باپتھ ہیکل کِس اندرونی صحنس منٛز کھڑا رودؠ تِم اکھ أکِس پرژھان۔ توٚہؠ کیاہ سونچان۔ تہنٛز کیاہ راے؟ سُہ ییہِ نہٕ ہرگز عید فسع مناونہٕ باپتھ۔
\v 57 کینٛہہ وقت برونٛہہ اوس حکمران کاہنو تہٕ فریسیسو حکم کوٚڈمُت زِ یُس اکھا یسوعسؔ ونہِ کڈِ سُہ گژھِ امسنٛزِ روزن جایہِ ہُنٛد پے پتاہ تمن واتناوُن تاکہِ سُہ ییہِ بٲنٛدؠ بنوانہٕ۔
\c 12
\p
\v 1 یہودٮ۪ن ہنٛز عید فسع مناونہٕ کہِ شےٚ دوٚہہ برونٛہہ ووٚت یسوعؔ بیت عنیاہ کِس گامس منٛز۔ بیتھانی اوس گام یتہِ لازر روزان اوس۔ یہِ اوس سُہ نفر یُس یسوعؔن مرنہٕ پتہٕ دُبارٕ زندٕ اوس کوٚرمُت۔
\v 2 تتہِ بیت عنیاہ ہس منٛز یسوعؔ سنٛدیو کینٛژو یارو دیُت یسوعسؔ کالُک کھیٚن۔ مارتھاہنؔ کوٚر پژھٮ۪ن خٲطرٕ کھیٚنُک انتظام تہٕ لازرن اوس تمن لوٗکن منٛز شٲمل یِمہٕ یسوعسؔ سٟتؠ کھیٚن ٲسؠ کھیٚوان۔
\v 3 پتہٕ نِیہِ مریمن اکھ بٲتل یتھ منٛز تقریباً اوٚڈ لیٹر واریاہ دروٚجؠ عطر ٲس، یۅسہ نارنگؠ کُلٮ۪ن ہندِ تیلچ ٲس، تہٕ ترٲوٕن یسوعؔ سنٛدٮ۪ن کھۅرن تہٕ پتہٕ وۅتھرٲوِن امسنٛدؠ کھوٚر پننہِ مستہٕ سٟتؠ۔ عطرِ ہُنٛد مُشِک پھیور سٲرؠ سےٕ گرس۔
\v 4 تاہم، یہُوداؔ اِسکریوتی کوٚر اعتراض۔ سُہ اوس یسوعؔ سنٛدیو شاگردو منٛز اکھ یُس جلدی یہُودؠ سردارن یسوعؔ گرفتار کرنس منٛز مدد کرِ۔ تٔمؠ ووٚن،
\v 5 "اسہِ پزِ ہے یہِ عطر تیتِس رقمس کٕنٕنؠ یُس اکھ نفر یہِ ترٮ۪ن ہتن دوٚہُن مزوٗرؠ کٔرِتھ زینِتھ ہیٚکہِ۔ پتہٕ ہیٚکہٕ ہو أسؠ سُہ رقم غریب لوٗکن دِتھ!"\f + \fr 12‏:5 \ft اکھ دینار چُھ کھلہِ پٲٹھؠ أکس مُزورٕ سنٛزِ دوٚہہ مُزورِ برابر\f*
\v 6 یہُوواہنؔ ووٚن نہٕ امہِ موجُب زِ تس چھےٚ غریبن ہنٛز فکِر بلکہِ تٔمؠ اوس یہِ امہِ موجُب ووٚنمُت تکیازِ سُہ اکھ ژور۔ تٔمؠ ٲس سۅ تھیلؠ سمبٲلتھ تھٲومٕژ یتھ منٛز تہنٛدؠ پونٛسہٕ ٲسؠ۔ مگر سُہ اوس یِم پونٛسہٕ ژورِ نِوان۔ یِم لوٗکھُ أمِس دِوان ٲسؠ بیگس منٛز تراونہٕ خٲطرٕ
\v 7 تہٕ یسوعؔن ووٚن، "ترٲؠ وُن یہِ یلہٕ! تٔمؠ بچٲو عطر تاکہِ سۅ گژھِ میانہِ مرنہٕ وِزِ استعمال۔
\v 8 تٔمؠ چھےٚ صحیح کٲم کٔرمٕژ تکیازِ غریب لوٗکھ روزن ہمیشہٕ توٚہہِ درمیان یِمن توٚہؠ مدد ہیٚکو کٔرِتھ مگر بہٕ روزنہٕ زیادٕ کالس توٚہہِ سٟتؠ۔\f + \fr 12‏:8 \ft مرقُس 14:7\f*
\v 9 یہودٮ۪ن ہنٛدؠ اکؠ بٔڈؠ ہجومن بوز زِ یسوعؔ چُھ بیت عنیاہ ہس منٛز، تہٕ تِم گے تور۔ تِم گے نہٕ اور صرف امہِ موجُب زِ یسوعؔ چُھ تتہِ بلکہِ اوٕ موجُب تہِ زِ تِم ٲسؠ لازر وچُھن یژھان۔ یہِ اوس سُہ نفر یُس یسوعنؔ مرنہٕ پتہٕ دُبارٕ زندٕ اوس کوٚرمُت۔
\v 10 اتھ برعکس اوس حکمران کاہنو لازرس سٟتؠ سٟتؠ یسوعؔ تہِ مارنُک اِرادٕ بنوومُت۔
\v 11 حکمران کاہن ٲسؠ لعزرسؔ مارُن یژھان تکیازِ واریاہ یہُودؠ ٲسؠ نہٕ وۅنؠ تہنٛزن کتھن پٮ۪ٹھ بھروسہٕ کران یمہِ یِم یٮ۪چھناوان ٲسؠ بلکہِ ٲسؠ امہِ بجایہ یسوعسؔ پٮ۪ٹھ بھروسہٕ کران۔
\v 12 دویمہِ دوٚہہ گو معلوم یسوعؔ چُھ توٚت گژھان یوت لوٗکن ہُنٛد اکھ بوڈ ہجوم عید فسح مناونہِ یروشلم آمُت اوس۔
\v 13 چونکہِ تِمو ژٔچہِ کھٔزر کُلٮ۪ن ہنٛزٕ لنجہِ تہٕ شہرس منٛز یِتھےٕ کوٚرُکھ تمِس سڑکن پٮ۪ٹھ نیرتھ استقبال۔ تِم ٲسؠ چِکہٕ دِوان، "براہِ کرم، اسہِ بچٲیو! یِم پننہِ اختیار سان آے خدا تھاوِن تمِس خوش۔ سُے چُھ اسرائیل لُک بادشاہ!"\f + \fr 12‏:13 \ft اصلی لفظ چُھ "ہوشعناہ" یمیک معنی چُھ "مہربٲنی کرتھ بچاو اسہِ" تہٕ یہِ چُھ مدد منٛگنہٕ خٲطرٕ دعا۔ زبور 118:25۔26\f*
\v 14 ییٚلہِ یسوعؔ یروشلم نزدیک ووت تہٕ تمِس سمکھیاو اکھ خر بچہٕ تتھ پٮ۪ٹھ سوار گو شہرس منٛز دٲخل۔ ا۔ یہِ کٔرِتھ کٔر تٔمؠ سۅ کتھ پوٗرٕ یُس کینٛزن نبین ہنٛدِس مقدس کلامس منٛز لیکھِتھ ٲس:
\q
\v 15 ''اے یروشلم کیو روزن والیو، مٕہ کھوٚژِو۔
\q وُچھِو! تُہنٛد بادشاہ چُھ پکان۔
\q سُہ چُھ خر بچس پٮ۪ٹھ سوار!
\p
\v 16 ییٚلہِ یِم واقہ سپٕدؠ تہٕ تمسنٛدیو شاگردو سمُجھ نہٕ یہِ زِ یہِ چھےٚ تمن نبین ہنٛزن لیچھمژن کتھن ہنٛز تکمیل۔ تاہم، ییٚلہِ خداین یسوعؔس جلال بخش تمِس دُبارٕ زندٕ کٔرِتھ، تمن پیٚو یاد زِ رسولو کیاہ اوس تمِس متعلق لیٚوکھمُت تہٕ لوٗکو کیاہ اوس تمِس سٟتؠ کوٚرمُت۔
\v 17 لوکھ، یِم یسوعسؔ پتہٕ پتہٕ پکان ٲسؠ رودؠ باقین یہِ ونان زِ تِمو چُھ پانہٕ دیدمان وُچھمُت یسوعؔ لازرس مقبر منٛزٕ ناد لٲیِتھ زندٕ نٮ۪بر کڈان۔
\v 18 لوٗکن ہنٛز اکھ بیاکھ ٹوگجؠ وٲژ شہرکِس نٮ۪برمِس پھاٹکس پٮ۪ٹھ یسوعؔس خوش آوے کرنۂِ تِمو کوٚر یہِ تکیازِ تِمو اوس بوزمُت زِ تٔمؠ کیاہ معجزٕ اوس کوٚرمُت العزرسؔ بیٚیہِ زندٕ کٔرِتھ۔
\v 19 فریسیسو ووٚن اکھ أکِس، "وُچھِو! أسؠ گے ناکام أمِس ٹھوٚر کرنس منٛز۔ لوٗکھ چھِ یسلہٕ امسنٛدؠ شٲگرد بنان۔
\v 20 کینٛہہ لوٗکھ یِم نہٕ یہُودؠ ٲسؠ مگر باقین لوٗکن سٟتؠ وٲتؠ یروشلم عید فسع کٮ۪ن دوٚہُن خدا سنٛز عبادت کرنہٕ باپتھ۔
\v 21 تِم آے فلپسس نِش۔ یُس گلیل ہنٛدِ علاقس منٛز بیت صیدا جایہِ ہنٛد اوس۔ تِمو پرُژھ أمِس، "جناب۔ توٚہؠ کرِنٲووا اسہِ یسوع سُنٛد تعارف؟"
\v 22 فلپسن ووٚن یہِ اندریاسؔ تہٕ دوٚشوے گے یسوعؔس نِش۔
\v 23 یسوعؔن ووٚن فلپ تہٕ اندریاسس، "یوٚہے چُھ سُہ وقت ییٚلہِ خدا پاوِ میٲنؠ یعنی آدمؔ سٕنٛدِس یمِس گۅبرٕ سٕنٛز عظمت جلال
\v 24 بہٕ چُھسو پوٚز ونان میٲنؠ زندگی زٲنؠ تو اکھ بیٲلؠ پھوٚل ییتِس کالس نہٕ مثلن کنکہٕ بیول زمیٖنس وونہٕ ییہِ تہٕ مرِ یہِ روزِ چھرا اکھ بیٲلؠ پھوٚل۔ وۅنؠ یوٚدوے یہِ مرِ زمیٖنہِ تل یہِ لبہِ وۅتھہٕ واشر تہٕ نیرٮ۪س کٕنکھ۔
\v 25 سُہ یُس میون شٲگرد روزنہٕ کھۅتہٕ زیادٕ پانس زندٕ روزُن یژھِ سُہ مرِ وۅنؠ گو سُہ یُس میون شٲگرد روزُن زیادٕ بہتر زانہِ زندٕ روزنہٕ کھۅتہٕ یتھ گناہ گار دنیہس منٛز لبہِ پوشوٕنؠ زندگی۔
\v 26 یُس تہِ میٲنے خدمت کرٕنؠ یژھان چُھ تس پزِ میون شٲگرد بنُن۔ میٲنؠ خدمت کرن وٲلؠ روزن مےٚ سٟتؠ آسمانس پٮ۪ٹھ۔ میون مول بخشہِ تس عزت یُس مےٚ خدمت کرِ۔
\v 27 وُنکٮ۪ن چھےٚ مےٚ یہےَ گبراہٹ ہِش۔ مےٚ پزِ نہٕ یہِ یقیناً ونُن زِ خدایہِ مےٚ بچاو تمہِ تجربہٕ نِش ییٚلہِ بہٕ تکلیفس منٛز آسہٕ تہٕ مرٕنَہ۔ بیٕ کرٕ نہٕ یہِ۔ تکیازِ یہِ چُھ میانہِ ونیُک تام زُونُک مقصد۔
\v 28 مالیا۔ ہاو مےٚ ژٕ کوتاہ عظیم تہٕ عظمت وول چھُکھ۔ امہِ پتہٕ آے آسمانہٕ پٮ۪ٹھٕ خدا سنٛز آواز، "مےٚ چُھ گۅڈے پنُن جلال ہوومُت۔ خٲر بہٕ ہاوٕ بیٚیہِ۔
\v 29 اتہِ موجود لُکہٕ ہجومن تہِ بوز یہِ خدا سنٛز آواز۔ کینٛژو ووٚن یہِ ٲس چھرا گگراے۔ کینٛژو ووٚن زِ اکؠ فرشتن کوٚر یسوعسؔ سٟتؠ کلام۔
\v 30 یسوعؔن ووٚن یِمن لوٗکن۔ آواز یوٚسہٕ توٚہہِ بوزو ٲس خدا سنٛز تٔمؠ کوٚر نہٕ کلام میانہِ باپتھ بلکہِ تہنٛدِ فٲیدٕ باپتھ۔
\v 31 وقت ووت ییٚلہِ خدا لوٗکن عدالت لاگہِ۔ یی چُھ وقت ییٚلہِ سُہ شیطانس دفع کرِ یُس دُنیاہس پٮ۪ٹھ راج کران چُھ۔
\v 32 یوٚتام میون تعلق چُھ۔ ییٚلہِ لوٗکھ مےٚ صلیبہِ پٮ۪ٹھ کھالن، بہٕ انکھ سٲری لوٗکھ پانس نِش۔
\v 33 تٔمؠ ووٚن لوٗکن یہِ باونہٕ باپتھ زِ سُہ کِتھہٕ پٲٹھؠ مرِ۔
\v 34 اوٕ پتہٕ ووٚنُس لوٗکہٕ ہجومن اورٕ۔ اسہِ چُھ مقدس کتابو پٮ۪ٹھٕ زونمُت زِ مسیحؔ روزِ ہمیشہ خٲطرٕ زندٕ۔ تیٚلہِ کیازِ چھُکھ ژٕ ونان زِ آدمؔ سُنٛد گۅبُر ییہِ تُلنہٕ صلیبس پٮ۪ٹھ مرنہٕ باپتھ۔ یہِ کُس آدمؔ سُنٛد گۅبُر چُھ یس متعلق ژٕ یِمہٕ کِتھہٕ کران چھُکھ۔\f + \fr 12‏:34 \ft دانیال 7:14\f*
\v 35 یسوعنؔ وُننَکھ، "بےٕ چُھس سُہ نور یُس خدا سٕنٛدِ پزرُک تہٕ خٲرُک اظہار کران چُھ۔ بہٕ روزٕ توٚہہِ نِش کینٛہہ کالےٕ۔ میٲنؠ مثال پانہٕ رٲیو زندٕ روزنہٕ باپتھ میانس یتہِ روزنس دوران تاکہِ بہٕ رٹن یہِ انہِ گوٚٹ تل تل تہٕ دِمس نہٕ توٚہہِ پٮ۪ٹھ حٲوی گژھنہٕ۔ یِم لوٗکھ گناہ گار زندگی گُذاران چھِ تِم چھِ زٲنؠ تو انہِ گٔٹِس منٛز دربدر۔ یہِ زاننہٕ وراے زِ گژھُن کوٚت چھُکھ۔
\v 36 مےٚ پٮ۪ٹھ کٔرِو پژھ نور یُس خدا سنٛزِ حقیقتُک تہٕ پزرُک ظہور چُھ۔ ییٚلہِ بہٕ وُنہِ تہِ توٚہہِ منٛزے چُھس۔ خدا سٕنٛدؠ مخلوٮ۪ بننہٕ باپتھ کٔرِو یہِ یعنی خدا سُنٛد پزر تہٕ خٲر پرزٕناون وٲلؠ بٔنیو۔ یہِ ؤنِتھ رود یسوعؔ لوٗکو منٛزٕ نیرتھ کٔھٹِتھ۔
\v 37 یوٚدوے زن یسوعؔن لوٗکن دیدمان واریاہ معجزٕ کٔرؠ توتہِ کرر نہٕ یِمو منٛزٕ واریہو لوٗکو أمِس پٮ۪ٹھ پژھ۔
\v 38 تہنٛزِ أمؠ بے پژھی کوٚر پوٚز ثٲبت یسعیاہؔ نبی سنٛز واریاہ برونٛہہ وننہٕ آمٕژ کتھ خداوند کٲنٛسہِ کرِ نہٕ پژھ سٲنِس کلامس۔ باسان چُھ خدا وند سُنٛد طاقت وُچھ نہٕ ظہورس منٛز یِتھؠ تہِ کٲنسے۔\f + \fr 12‏:38 \ft یسعیاہؔ 53:1\f*
\v 39 أمؠ کٔر نہٕ یسوعؔس پٮ۪ٹھ تہِ کٲنٛسہِ پژھ۔ یسعیاہنؔ اوس لیٚوکھمُت۔ 
\v 40 خداوندن تھٲوؠ نہٕ تِم وُچِھتھ تہٕ وُچھنس لایق تہٕ بناوِنؠ احمق۔ تٔمؠ بنٲوؠ تِم یِم تاکہِ تِمن ییہِ نہٕ أچھ مُژرِتھ تہِ بوزنہٕ۔ اگرچہِ تِم وُچھان چھِ، تہنٛزٕ أچھ روزن وژھے مگر گاشہٕ روٚستےٕ۔ تہٕ نَہ ہیٚکن کینٛہہ سمجِتھ تہٕ نَہ ہیٚکن گوٚنہو نِشہ ژٔلِتھ۔ ضدایس کُن پھیرِتھ۔ تہٕ بہٕ کرکھ نہٕ ہرگز معاف۔\f + \fr 12‏:40 \ft یسعیاہؔ 6:10، متی 13:3۔15، مرقُس 4:12، لوقا 8:10\f*
\v 41 یسعیاہؔ ہن چھِ واریاہ برونٛہہ کالہِ لیٚوکھمُت تکیازِ تٔمؠ وُچھ یسوعؔ تہٕ کوٚرُن أمِس متعلق کلام۔
\v 42 یوٚدوے زن یہِ پوٚز اوس مگر واریہو یہُودؠ حکمران انتظٲمؠ مشیرو کٔر أمِس پٮ۪ٹھ پژھ۔ مگر پننہِ امہِ پژھِ ہُنٛد اظہار کوٚرُکھ نہٕ کٲنسے پٮ۪ٹھ۔ تکیازِ تمن اوس خوف زِ تیٚلہِ کرن فریسیسی یمن ٹھاکھ یہُودؠ مجلس ہنٛزِ جایہِ اژنس۔
\v 43 تِمو کوٚر یہِ امہِ خوفہٕ زِ لوٗکھ کرن تِمن عزت امہِ بجایہ زِ خدا دِیہ تِمن عزت۔
\v 44 یسوعنؔ ووٚن أکِس لوٗکہٕ ہجومس زورٕ زورٕ۔ مےٚ پٮ۪ٹھ پژھ کرن وٲلؠ چھِنہٕ صرف مےٚ پٮ۪ٹھ پژھ کران بلکہِ میٲنِس مٲلِس تہِ یمؠ بہٕ یور سوزُس۔
\v 45 یِم مےٚ وُچھان چھِ، تِم چھِ میٲنِس مٲلس تہِ وُچھان یمؠ بہٕ یور سوزُس۔
\v 46 بہٕ آس یتھ دُنیہس منٛز نور بنِتھ یُس خدا سُنٛد پزر تہٕ خٲر ظہورس منٛز انان چھِ تاکہِ مےٚ پٮ۪ٹھ پژھ تھاون وٲلؠ روزن نہٕ یمہِ اپور انہِ گٔٹِس تہٕ بدی منٛز۔
\v 47 بہٕ چُھسن نہٕ کانٛہہ تہِ راہ لد مانان یوٚدوے زن سُہ میٲنؠ تعلیم بوزِتھ تہِ مانہِ نہٕ تکیازِ بہٕ آس نہٕ یتھ دُنیہس منٛز لوٗکن راہ لد آسنُک اعلان کرنہِ بلکہِ آس بہٕ یتھ دُنیہس منٛز لوٗکن نجات بخشنہِ۔ گوٚنہو باپتھ سزا دٕننہِ
\v 48 سُہ کانٛہہ تہِ یُس مےٚ نامنظور کرِ تہٕ میٲنؠ تعلیم ماننہ ییہِ مےٚ پٮ۪ٹھ پژھ کرِنہٕ سُہ سپدِ میانہِ تعلیمہ حسابے سزاوار تہِ۔ ٲخری دوٚہہ ییٚلہِ خدا لوٗکن عدالت لاگہِ سُہ پرکھاوِ میانہِ تعلیمہ حسابے لوٗکن۔
\v 49 یہِ سپدِ تکیازِ بہٕ چُھس نہٕ پننہِ اِرادٕ تعلیم دِوان بلکہِ ووٚن میٲنؠ مٲلؠ یمؠ بہٕ یور سوزُس زِ مےٚ کیاہ چُھ ونُن۔
\v 50 مےٚ چُھ یقین زِ میٲنؠ مٲلؠ یہِ مےٚ ووٚن لوٗکن پزِ تتھ پٮ۪ٹھ پژھ کرٕنؠ ہمیشہٕ زندٕ روزنہٕ باپتھ۔ لہٰذا چُھس بہٕ تی ونان یہِ میٲنؠ مٲلؠ ووٚن مےٚ۔
\c 13
\p
\v 1 عید فسح شروع گژھنہٕ برونٛہہ اکھ دوٚہہ زون یسوعنؔ زِ دُنیا ترٲوِتھ مٲلِس نِش واپس گژھنُک وق ووت۔ سُہ اوس پننٮ۪ن شٲگردن یِم یتھ دُنیہس منٛز تس سٟتؠ سٟتؠ رودؠ سخ لول بران۔ سُہ اوس تمن دل کیو پُروو لول بران۔
\v 2 ییٚلہِ یسوعؔ تہٕ تسٕنٛدؠ شٲگرد شامُک بتہٕ کھیٚوان ٲسؠ، شیطانن اوٚن شمعون اِسکریوتی سٕنٛدِس نیٚچوؠ یہُوداؔ سٕنٛدِس دِلس منٛز یہِ کتھ تراومژ زِ تس پزِ یہُودؠ سردارن یسوعؔ بٲنٛدؠ بنونس منٛز پنُن مدد دیُن۔
\v 3 یسوعؔ اوس زانان زِ تس چُھ پننؠ ببن پرٮ۪تھ چیزس پٮ۪ٹھ پورٕ قدرت تہٕ اختیار بخُشمُت تہٕ یِتہِ زانان زِ سُہ چُھ خدایہِ سٕنٛدِ پیٚٹھےَ آمُت تہٕ ولؠ واتہِ واپس تسؠ نِش۔
\v 4 چونکہِ سُہ اوس یہِ سورےٕ زانان یسوعؔ ووٚتھ شامُک بتہٕ کھینہٕ والہِ میزٕ پٮ۪ٹھٕ تھوٚد۔ نٮ۪برِم پلو کٔڈِن تہٕ وجِن پننِس کمرس تولیا۔
\v 5 أکِس بجہِ باٹہِ منٛز بوٚرُن آب تہٕ لٲگِن پننٮ۪ن شٲگردن ہنٛدؠ کھوٚر چھلٕنؠ تہٕ پننس، س کمرس ؤلِتھ تولیا سٟتؠ یم پاد خشک کرٕنؠ۔
\v 6 ییٚلہِ سُہ شمعون پطرس نِش تسٕنٛدؠ کھوٚر چُلنہِ ووت پطرسن وونُس، "خدا وند توٚہہِ پزن نہٕ میٲنؠ کھوٚر چھلٕنؠ۔
\v 7 یسوعنؔ ووٚنُس یورٕ، "وُنکٮ۪ن چھیٚکھ نہٕ ژٕ زانان زِ بہٕ کیاہ چُھس کران مگر پتہٕ پہن زانکھ۔
\v 8 پطرسن ووٚنُس، "ژٕ چھلکھ نہٕ میٲنؠ کھوٚر زہنٛؠ تہٕ زہنٛؠ۔ یسوعنؔ وونُس یوٚدوے بہٕ چھلتھ نہٕ ژٕ پراوکھ نہٕ ادٕ زہنٛؠ مےٚ سٟتؠ سٟتؠ خدایہِ سُنٛد فضل۔
\v 9 شمعون پطرسن وونُس اورٕ، "خداوند۔ میٲنؠ یِم کھورےٕ یٲتؠ مٕہ چھلیٚو۔ میٲنؠ اتھہٕ تہٕ میون کلہٕ تہِ چھلیٚو"
\v 10 یسوعؔن ووٚنُس، "سُہ یُس کٲنٛسہِ پانہٕ چھوٚلمُت آسہ، تس چُھنہٕ حاجت بییِس کھورو ورٲے بیٚیہِ کینٛہہ چھلنُک۔ تمسُنٛد باقےٕ جسم چُھ پاک۔ توٚہؠ میٲنؠ شٲگرد چُھو پاک مگر نَہ مکمل نَہ سٲری۔
\v 11 یسوعنؔ ووٚن یہِ روحٲنی طور پاک آسنس متعلق تکیازِ سُہ اوس زانان زِ کُس چُھ یہودٮ۪ن سُہ بٲنٛدؠ بناونس منٛز اتھہٕ روٚٹ کرن وول۔ اوے ووٚن تٔمؠ، "توٚپؠ سٲری چُھو نہٕ پاک"
\v 12 ییٚلہِ تٔمؠ کھوٚر چٔھلِتھ مۅکلٲوؠ تٔمؠ لٲگؠ پنٕنؠ پیٚٹھؠ پلو واپس۔ پتہٕ بیوٹھ سُہ بیٚیہِ میزس پٮ۪ٹھ تہٕ ووننکھ توٚہہِ پزِ زانُن زِ مےٚ کیاہ کوٚر وۅنؠ تہنٛدِ باپتھ۔
\v 13 توٚہؠ چُھو پزنہٕ پٲٹھؠ مےٚ پنُن استاد تہِ خداوند مانُن۔ پزی چُھس بہٕ یی۔
\v 14 چونکہِ مےٚ، تہنٛدؠ استادن تہٕ خداوندن کرٕو توٚہہِ بڈٕ انکسٲری سان خدمت تہنٛدؠ پاد چٔھلِتھ لہٰذا پزِ توٚہہِ تہِ انکسٲری سان اکھ اکؠ سنٛز خدمت کرٕنؠ پانہٕ وٲنؠ کھوٚر چٔھلِتھ۔
\v 15 تُہنٛدؠ کھوٚر چٔھلِتھ کٔر مےٚ اکھ مثال قٲیِم یُتھ توٚہؠ پانہٕ وٲنؠ اکھ اکؠ سنٛز خدمت کٔرِو یتھ پٲٹھؠ زن مےٚ تہنٛز خدمت کٔر۔
\v 16 بہٕ چُھسو پوٚز ونان۔ یتھ پٲٹھؠ زن اکھ نوکر یا غلام پننس مٲلکہٕ سنٛدِ کھۅتہٕ ژوٚر اہم چُھنہٕ تہٕ نَہ چُھ خبر انُن وول رسول تس سوزن وٲلؠ سنٛدِ کھۅتہٕ اہم۔
\v 17 چونکہِ توٚہہِ زونو یہِ وۅنؠ زِ توٚہہِ پزِ اکھ اکؠ سنٛز خدمت کرٕنؠ خدا کَریو توٚہہِ پنُن فضل۔
\v 18 بہٕ چُھس نہٕ ونان زِ توٚہہِ سارنےٕ کریو خدا فضل۔ بہٕ چُھسکھ پننہِ شاگردی باپتھ پنٕنؠ ژٲرمٕتؠ لوٗکھ وارٕ زانان وۅنؠ گو یہِ سپدن وول چُھ تہِ گژھِ سپدُن تاکہِ مقدس صحیفن منٛز لٮ۪کھنہٕ آمٕژ نبین ہنٛز کتھ نیرِ پٔز۔ یمؠ نفرن مےٚ سٟتؠ کال کھیو أکِس یارٕ سٕنٛدؠ پٲٹھؠ سُے آو دُشمن ہٮ۪تھ وتہٕ ہاوک۔\f + \fr 13‏:18 \ft زبور 41:9\f*
\v 19 یمہِ اپور وَنو بہٕ یہِ سپدن وول چُھ، تہِ سپدِنہٕ برونٛہےٕ تاکہِ ییٚلہِ یِتھے پٲٹھؠ سورےٕ سپدِ توٚہؠ ہیٚکو پژھ کٔرِتھ زِ بےٕ چُھس خدا۔\f + \fr 13‏:19 \ft یوحنا 14:29\f*
\v 20 یہِ چُھ سورےٕ پزر ونان۔ سُہ ہر کانٛہہ یُس میٲنِس سوزمتِس پٮ۪ٹھ پژھ تھاوِ چُھ مےٚ مانان تہٕ یُس مےٚ مانان چُھ سُہ چُھ میٲنِس مٲلِس تہِ مانان یمؠ بہٕ سوزُس۔
\v 21 ییٚلہِ یسوعنؔ یہِ ووٚن سُہ گو بے چین۔ بڈٕ سنٛجیدگی سان کوٚر تِمو اعلان۔ بہٕ چُھسو ونان پوٚز۔ توٚہہِ منٛزے اکھ کرِ دغل یارژ میانٮ۪ن دُشمنن سٟتؠ رٔلِتھ۔
\v 22 تسٕنٛدؠ شٲگرد رودؠ اکھ أکِس کُن ژرژان تہٕ تعجب کران زِ یہِ کُس نفر چُھ تِمو منز یس متعلق یسوعؔ ونان چُھ۔
\v 23 جان ناوُک اکھ شٲگرد یس یسوعؔ لول کران اوس اتؠ أمِس نکھہٕ میزس پٮ۪ٹھ بہتھ۔
\v 24 شمعون پطرسن ہوو أمِس کُن زِ سُہ پرژھِن یسوعؔس اما سُہ کس شٲگردس متعلق چُھ یہِ کتھ کران۔ اوے کھوٚت جان ہیٚور پہن یسوعؔس پرژھنہِ
\v 25 اوے نمیو سُہ رژھا پتھ کُن تہٕ ہرژھُن یسوعؔس لوٚتہِ پٲٹھؠ۔ خداوند۔ توٚہہِ کُس کرِ دغا۔
\v 26 یسوعؔن ووٚنُس، "سُہ سخص یمِس بہٕ یہِ ژۅچہِ کھنٛڈ دِمہٕ اتھ کٹورِ منٛز غۅتہٕ کٔرِتھ:" امہِ پتہٕ کوٚر تٔمؠ آبہٕ کٹورِ منٛز ژۅچہِ کھنٛجہِ غوتہٕ تہٕ پلنٲون یہُوداہسؔ شمعون اِسکریوتی سٕنٛدِس نیٚچوِس۔
\v 27 یُتھےٕ یہوداین یہِ ژۅچہِ کھنٛڈ رٔٹ یسوعؔس نِش، شیطانن اوٚن سُہ پننِس اتھس منٛز۔ یسوعؔن ووٚنُس، "کرِ ؤلؠ ؤلؠ یہِ ژؠےٚ سونچمُت چُھتھ"
\v 28 میزس پٮ۪ٹھ بہتھ کٲنسہِ تہِ نفرس توٚگ نہٕ زہنٛؠ زِ یسوعؔن کیازِ ووٚن یہِ یہُوداہسؔ۔
\v 29 یِمو منٛزٕ زون کینٛژو زِ یسوعؔ چُھ ژکہِ یہُوداہسؔ نیرنہٕ باپتھ ونان تاکہِ سُہ انہِ مٔلؠ عید فسع باپتھ ضرورے چیز یا نیرِ غریبن پونٛسہٕ دِنہٕ باپتھ۔ تِمو سونچ یہِ اوٕ کِنؠ تکیازِ یہُوداؔ اوس تتھ تھیلہِ رٔٹِتھ یتھ منٛز پونٛسہٕ ٲسؠ آسان۔
\v 30 وۅنؠ ییٚلہِ یہوداہنؔ یسوعؔس نِش ژوٚٹ رٔٹ سُہ دراو ؤلؠ ؤلؠ نٮ۪بر اتہِ ٲس نٮ۪برٕ راتھ
\v 31 یہُوداؔ نیرنہٕ پتہٕ ووٚن یسوعؔن۔ وۅنؠ ہوو خداین پانہٕ لوٗکن زِ بہٕ آدمؔ سُنٛد گۅبُر کوتاہ عظیم چُھس۔ مےٚ ہوو پانہٕ لوٗکن خدا کوت عظیم چُھ۔
\v 32 خدا ہاوِ پانہٕ لوٗکن زِ بہٕ آدمؔ سُنٛد گۅبُر کوتاہ عظیم چُھس تہٕ سُہ ہاوِ یہِ وۅنؠ۔
\v 33 توٚہؠ، یمن بہٕ محبت کران چُھس زنتہٕ میٲنؠ شُرؠ چُھو۔ بہٕ روزٕ توٚہہِ سٟتؠ بس بیٚیہِ رژھِ کھنجہِ پتہٕ ژھٲرِو توٚہؠ مےٚ مگر بہٕ آسہٕ تی یہِ مےٚ یہُودؠ سردارن ووٚن تہٕ توٚہہِ چُھو سُہ ونان "توٚہؠ ہیٚکو نہٕ تتھ مقامس وٲتِتھ یوٚت بہٕ واتن وول چُھس۔
\v 34 وۅنؠ دِمو بہٕ توٚہہِ اکھ نوو حکم تاکہِ توٚہؠ کٔرِو اکھ أکِس محبت۔ توٚہہِ پزِ اکھ أکِس محبت کرُن تِتھے پٲٹھؠ یتھٕ پٲٹھؠ مےٚ توٚہہِ کورُو۔
\v 35 یوٚدوے توٚہؠ اکھ أکِس محبت کٔرِو توٚہہِ ژرژان سٲری ونن پزی چھِ یِم میٲنؠ شٲگرد۔
\v 36 شمعون پطرسن ووٚنُس، "خداوند ژےٚ کور چھِے واتُن۔ یسوعؔن ووٚنُس، "ژٕ ہیٚککھ نہٕ وۅنؠ مےٚ سٟتؠ تور یِتھؠ یوٚت مےٚ گژھُن چُھ۔ وۅنؠ گو پتہٕ پہن ہیٚککھ گٔژھِتھ۔
\v 37 پطرسن ووٚنُس، "خداوند بہٕ کیازِ ہیٚکہٕ نہٕ وُنکٮ۪س ژےٚ سٟتؠ یتھ۔ بہٕ چُھس چانہِ باپتھ مرُن یژھان۔
\v 38 یسوعؔن ووٚنُس، "ژٕ چھُکھ نہٕ میانہِ باپتھ مرنہٕ باپتھ تیار کینٛہہ۔ یقیناً ونکھ ژٕ کۅکر بانگہِ برونٛہہ صبحٲے زِ ژٕ زانکھ نہٕ مےٚ"
\c 14
\p
\v 1 یِنہٕ دل رایوٕ زِ خدایس پٮ۪ٹھ تھٲیِو پژھ۔ مےٚ پٮ۪ٹھ تہِ تھٲیِو پژھ قٲیِم۔
\v 2 یتہِ میون بب روزان چُھ تتہِ چھےٚ لوٗکن ہنٛدِ باپتھ تہِ واریاہ جایہِ۔ یوٚدوے یہِ پوٚز آسہ ہےنہٕ مےٚ آسہ ہو تیٚلہِ ووٚنمُت تکیازِ بہٕ گژھِ ہا توٚت تہٕ تہنٛدِ باپتھ تہِ کرہا جاے تیار۔
\v 3 ییٚلہِ بہٕ تور گژھٕ تہنٛدِ باپتھ جاے تیار کرنہِ بہٕ یِمہٕ واپس توٚہہِ پانس سٟتؠ تور نِنہِ۔ تاکہِ توٚہہِ تہِ روزیٚو مےٚ سٟتؠ یتہِ بہٕ آسہٕ۔
\v 4 توٚہہِ چُھو خبر زِ توٚت کِتھہٕ پٲٹھؠ چُھ واتُن یوٚت بہٕ گژھان چُھس۔
\v 5 تُوماہنؔ ووٚنُس، "خداوند اسہِ چھنہٕ رژھ تہِ خبر توٚہہِ کوٚت چُھو گژھُن۔ شاید چھنہٕ اسہِ تور گژھنچ وتھ تہِ معلوم۔
\v 6 یسوعؔن ووٚنُس، "بےٕ چُھس لوٗکن باپتھ تورچ وتھ۔ بےٕ چُھس یُس ظہورس منٛز انہِ خدایہِ سُنٛد پزر۔ تہٕ یُس لوٗکن پوشوٕنؠ زندگی بخشہِ۔ خدایس تام واتنٕچ چھےٚ اکےٕ وتھ سۅ گییہِ مےٚ پٮ۪ٹھ پژھ کرٕنؠ۔
\v 7 چونکہِ توٚہؠ زٲنِو بہٕ کُس گوس۔ اوے زٲنِو توٚہؠ میٲنِس مٲلِس تہِ۔ یمہِ برونٛہہ زٲنِو توٚہؠ تمِس زنتہٕ توٚہہِ سُہ دیدمان وُچھمُت چُھو۔
\v 8 فلپسن ووٚن یسوعؔس، "خداوند اسہِ تہِ ہاوتن مول تاکہِ اسہِ ییہِ ہے تسلی۔
\v 9 یسوعؔن ووٚن أمِس، "مےٚ ووت یوٚت کال توٚہہِ سٟتؠ۔ یقیناً زٲنِو توٚہؠ مےٚ، فلپس۔ توما! یِمو بہٕ وُچھس چھِ برابر تِم یِمو میون مول وُچھ۔ اوے تہِ چُھنہٕ کانٛہہ وجہہ چانہِ وننُک زِ أسؠ تہِ وُچھوون مول۔
\v 10 توٚہہِ پزِ پژھ تھاوٕنؠ زِ بہٕ تہٕ میون مول چُھ پانہٕ وٲنؠ کُنی۔ بلکل میلِتھ۔ یہِ مےٚ توٚہہِ وونو تہِ ووٚن نہٕ مےٚ پننہِ اِرادٕ بلکہِ چُھ یہِ میون مول یُس میلِتھ چُھ مےٚ منٛز چُھ میٲنؠ کِنؠ پنٕنؠ معجزات ہاوان۔
\v 11 پژھ کٔرِو مےٚ پٮ۪ٹھ ییٚلہِ بہٕ یہِ ونان چُھسو زِ مےٚ تہٕ میٲنس چُھ پانہٕ وٲنؠ یکُت وۅنؠ گو یوٚدوے توٚہؠ میانہِ کتھہِ پٮ۪ٹھ پژھ چُھو نہٕ کرٕنؠ کم س کم کٔرِو مےٚ پٮ۪ٹھ پژھ تِمو معجزو موجُب یِم مےٚ توٚہہِ دیدمان کٔرؠ۔
\v 12 بہٕ چُھسو پزر ونان، یُس تہِ مےٚ پٮ۪ٹھ پژھ کرِ سُہ ہیٚکہِ تِم معجزٕ پانہٕ تہِ کٔرِتھ یِم بہٕ کران چُھس۔ سُہ ہیٚکہ، اکھتُے میانہِ کھۅتہٕ تہِ عظیم کامہِ کٔرِتھ۔ چونکہِ بہٕ چُھس پننس مٲلِس کُن گژھان۔
\v 13 بہٕ کرٕ کینٛہہ تہِ یہِ توٚہؠ میٲنؠ نمایندٕ آسنہٕ کِنؠ مےٚ منٛگیٚو۔ بہٕ کرٕ تہِ تاکہِ بہٕ تمؠ سُنٛد گۅبُر ہاوٕ زِ میون بب کوتاہ عظیم چُھ۔
\v 14 بہٕ کرٕ سُہ پرٮ۪تھ کانٛہہ چیز یُس توٚہؠ مےٚ منٛگِو میانیو نمایندو رٔنٛگؠ۔
\v 15 یوٚدوے توٚہؠ مےٚ پزی لول بران چُھو، توٚہؠ مٲنِو تہِ سورےٕ یمن ہُنٛد مےٚ توٚہہِ حکم دیُتمُت چُھو۔
\v 16 تیٚلہِ کرٕ بہٕ مٲلِس التجا تہٕ سُہ مانہِ میون درخواست توٚہہِ بیاکھ مددگار سوزتھ یُس توٚہہِ سٟتؠ ہمیشہٕ روزِ۔
\v 17 سُہ چُھ پاک روح یُس خدایس متعلق پزر ونان چُھ۔ دُنیہکؠ بے پژھ لوٗکھ کرن نہٕ تس قبول تکیازِ تِم چھِنہٕ تس دیدمان وُچِھتھ یا زٲنِتھ ہیٚکان۔ توٚہؠ میٲنؠ شٲگرد زٲنِو أمِس روحس سُہ چُھ توٚہہِ سٟتؠ روزان تہٕ برونٛہہ پہن روزِ توٚہہِ منٛز۔
\v 18 بہٕ تراوو نہٕ توٚہؠ کٲنٛسہِ پرواے کرن وٲلِس حوالہٕ کرنہٕ ورٲے۔ بہٕ یِمہٕ ؤلؠ واپس توٚہہِ نِش۔
\v 19 کینٛژس کالس وچُھن نہٕ مےٚ دُنیہکؠ بے پژھ لوٗکھ مگر توٚہؠ وُچھِو پانہٕ مےٚ دیدمان بیٚیہِ تکیازِ ؤلؠ ؤلؠ پراوٕ بہٕ زندگی دُبارٕ۔ توٚہؠ تہِ لٔبِو دُبارٕ زندگی۔
\v 20 ییٚلہِ توٚہؠ مےٚ دُبارٕ وُچھِو، توٚہہِ تگہِ زانُن زِ بہٕ چُھس پننس مٲلِس سٟتؠ میلِتھ تہٕ توٚہہِ تہِ مٮ۪تہِ چُھ پانہٕ وٲنؠ یکُت۔
\v 21 یُس کانٛہہ تہِ زانان تہٕ مانان چُھ یہِ بہٕ حکم کرٕ سُہ چُھ پزنہٕ پٲٹھؠ مےٚ محبت کران تہٕ میون مول چُھ تس محبت کران یُس مےٚ کرِ۔ بٕتہ کرِ یِتھِس نفرس محبت تہٕ بہٕ گژھٕ أمِس پٮ۪ٹھ ظٲہِر تہِ۔
\v 22 یہُوداؔ نہٕ کہ یہُوداؔ اِسکریوتی نَہ بلکہ اکھ بدل شٲگرد امی ناوُک چُھ أمِس ونان، "خداوندن کٔمؠ چیزن کرنٲیو توٚہؠ اسہِ پٮ۪ٹھ پنُن اصل اظہار تہٕ دُنیہکٮ۪ن لوٗکن پٮ۪ٹھ نہٕ۔
\v 23 یسوعؔ ہن ووٚنُس، "یُس تہِ مےٚ لول برِ سُہ چُھ میٲنؠ حکم مانان۔ میون مول تہِ چُھ تس لول بران۔ بہٕ تہٕ میون مول بیٚیہِ تس شخصس نِش تہِ روزو تس منٛز۔
\v 24 یُس تہِ مےٚ محبت کرِ نہٕ پالہِ نہٕ میٲنؠ حکم تہِ۔ یہِ توٚہہِ وۅنؠ بوزو بہٕ ونان یہِ ووٚن نہٕ مےٚ پننہِ اِرادٕ بلکہ یہِ زن مےٚ وننہٕ آو
\v 25 مےٚ ؤنؠ یِم چیز توٚہہِ ییٚلہِ بہٕ ونہِ توٚہہِ منٛزےٕ روزِتھ چُھس۔
\v 26 مگر میون مول سوزیو توٚہہِ پاک روح میانہِ جایہِ یُس توٚہہِ مدد کریو۔ سُے چُھ توٚہہِ سورےٕ خدا سنٛز حقیقت یۅسہ توٚہہِ زانٕنؠ ضرورے چھےٚ سُہ پاوِ توٚہہِ تِم سٲری چیز یاد یِم مےٚ توٚہہِ ؤنِو۔
\v 27 پننہِ نیرنہٕ وِزِ دِمہٕ بہٕ توٚہہِ اکھ سکونُک احساس۔ یہِ چُھ سون سکونُک احساس یُس بہٕ توٚہہِ دِوان چُھس۔ بہٕ چُھسو دِوان یہِ سکونُک احساس اکہِ بدل طریقہٕ دُنیہکیٚو لوٗکو نِشہ۔ یِنہٕ دل رایو یا کھوٚژِو۔
\v 28 توٚہؠ روزیٚو میون بوزان زِ بہٕ چُھس دوٗر گژھٕ وُن تہٕ بہٕ یِمہٕ پتہٕ توٚہہِ نِش واپس۔ یوٚدوے توٚہہِ یہِ پزی میون لول اوسمُت آسہ توٚہؠ یِیو وۅلسنس زِ بہٕ چُھس پننس مٲلِس کُن گژھان۔ تکیازِ سُہ چُھ میانہِ کھۅتہٕ تہِ اعلیٰ۔
\v 29 مےٚ ونیٚو توٚہہِ یِمہٕ کِتھہٕ امہِ برونٛہہ زِ یِم سپدن تاکہِ توٚہؠ تھٲیِو قٲیِم پنٕنؠ پژھ مےٚ پٮ۪ٹھ۔
\v 30 بہٕ روزٕ نہٕ ہمیشہٕ توٚہہِ سٟتؠ یِتھے پٲٹھؠ کتھ کروُن تکیازِ یتھ دنیہس راج کران وول ابلیس چُھ پکان۔ مگر تمس چُھنہٕ مےٚ پٮ۪ٹھ کانٛہہ اختیار۔
\v 31 مگر یہِ سپدِ تاکہِ دُنیہکؠ لوٗکھ زانن زِ بہٕ چُھس پننس مٲلِس محبت کران تہٕ بہٕ کرٕ بلکل تی یہِ مےٚ پنُن مول کرنہٕ باپتھ ونہِ۔ ؤتھِو۔ ترٲیو جاے۔
\c 15
\p
\v 1 بہٕ چُھس پزی اکھ دچھہِ کُجؠ یتھ دچھ وۅپدان چھِ۔ میون بب بوزؠ تو اکھ باغوان یُس اتھ رٲچھ راوٹھ کران چُھ۔
\v 2 میون بب چُھ تِمن لنجن ژٹان روزان یِمہٕ بظٲہِر میٲنؠ انٛگ انٛگ چھِ مگر پھل چھُکھ نہٕ نیران۔ پھل دِنہٕ واجنیٚن لنجن چُھ سُہ تراش خراش ہیوان روزان تاکہِ یِمن نیرِ ژوٚر پھل۔
\v 3 توٚہؠ چُھو یِمن لنجن ہیٚوؠ یِمہٕ تراچ خراش ہٮ۪تھ صاف کرنہٕ آمژٕ چھےٚ تمہِ تعلیمہ سٟتؠ یوٚسہٕ مےٚ برونٛہےٕ توٚہہِ دِژٕو۔
\v 4 مےٚ سٟتؠ روزیٚو یکُت کٔرِتھ۔ بٕتہ روزٕ توٚہہِ سٟتؠ یکُت کٔرِتھ۔ یتھٕ پٲٹھؠ اکھ لٔنٛڈ پھل دِیہ نہٕ یوٚتام نہٕ یہِ جورِتھ آسہ پننہِ رٲٹھ سٟتؠ تِتھے پٲٹھؠ نیرن نہٕ توٚہہِ نِش تہِ روحٲنی پھل یوٚتام ننہٕ توٚہؠ مےٚ سٟتؠ جورِتھ ٲسِو۔
\v 5 بہٕ چُھس اکھ راٹھ دچھہِ کُل توٚہؠ چُھو زنتہٕ امچہِ لنجہِ۔ یوٚدوے توٚہؠ مےٚ سٟتؠ یکتِس منٛز روزیٚو تہٕ بہٕ روزٕ توٚہہِ سٟتؠ توٚہہِ نیرِ واریاہ پھل۔ یی چُھ پوٚز تکیازِ میانہِ اتھہٕ رۅٹہِ ورٲے ہیٚکو نہٕ توٚہؠ کہین کٔرِرتھ۔
\v 6 سُہ کانٛہہ تہِ زوٚن یُس نہٕ مےٚ سٟتؠ یکتِس منٛز آسہ زٲنؠ تو سۅ اکھ لٔنٛڈ یتھ باغبان ژٔٹِتھ نِوان چُھ تہٕ ژھوٚٹس سٟتؠ تراوان چُھ۔ ییٚلہِ یِژھٕ لنجہِ ہوٚکھان چھےٚ، باغبان سٕنٛدؠ کارکُن چھِ یِمن نارٕ بُزؠ کٔرِتھ زالان۔
\v 7 یوٚدوے توٚہؠ مےٚ سٟتؠ رٔلِتھ روزیٚو تہٕ میانہِ تعلیمہ پٮ۪ٹھ عمل کٔرِو، توٚہؠ ہیٚکو خدایس کینٛہہ تہِ منٛگِتھ۔ یہِ توٚہؠ یٮ۪ژھِو تہٕ سُہ کرِ تہنز منٛگ قبول۔
\v 8 توٚہؠ ہٲیو لوٗکن زِ میون مول کوتاہ عظیم چُھ۔ ژرِ کھۅتہٕ ژوٚر پھل وۅپدٲیِتھ تہٕ میٲنؠ شٲگرد روزِتھ۔
\v 9 مےٚ کورُو توٚہہِ تِتھے پٲٹھؠ لول محبت یتھٕ پٲٹھؠ زن میون مول مےٚ سٟتؠ کران چُھ۔ وۅنؠ گُزٲریٛو پنٕنؠ زندگی تمہِ منٲسب آیہِ یۅسہ تمن لوٗکن شوٗبہِ یِمن بہٕ لول بران چُھس۔
\v 10 یوٚدوے توٚہؠ تتھ حکمس مٲنو یُس مےٚ توٚہہِ دیُت توٚہؠ روزیٚو سۅ عمل کران یۅسہ تمن لوٗکن منٲسب چھےٚ یمن بہٕ لول بران چُھس۔ یتھٕ پٲٹھؠ مےٚ پننِس مٲلؠ سُنٛد حکم مون تہٕ پنٕنؠ عمل اکہِ تِژھِ آیہِ کٔرٕم یۅسہ تمن منٲسب چھےٚ یِمن خدا لول بران چُھ۔
\v 11 مےٚ ونیٚو توٚہہِ یِمہٕ کِتھہٕ اوٕ کِنؠ زِ توٚہؠ تہِ روزیٚو خوش یتھٕ پٲٹھؠ بہٕ چُھس تاکہِ، توٚہؠ روزیٚو واریاہ خوش۔
\v 12 بہٕ چُھسو توٚہہِ یہِ کرنُک حکم دِوان۔ اکھ أکِس سٟتؠ کٔرِو محبت یتھٕ پٲٹھؠ بہٕ چُھسو کران۔
\v 13 کٲنٛسہِ تہِ آسہ نہٕ تیوتاہ محبت یوٗتاہ کٲنٛسہِ پننِس دوستہٕ سٕنٛدِ باپتھ مرن وٲلِس آسہ۔
\v 14 توٚہؠ چُھو یقیناً میٲنؠ یار یوٚدوے توٚہؠ تہِ کران روزِ یہِ مےٚ حکم دٕتو۔
\v 15 بہٕ ونو نہٕ توٚہہِ یمہِ اپور پنٕنؠ خٲدم تکیازِ خٲدم چھِنہٕ سمجھان زِ تمسُنٛد آغہٕ کیا چُھ کران۔ وونؠ چُھسو بہٕ توٚہہِ ونان دوستو، تکیازِ مےٚ تورٕ مو توٚہہِ فکرِ تہِ سورےٕ یہِ میٲنؠ مٲلؠ مےٚ ووٚن۔
\v 16 توٚہہِ ژورُو نہٕ پانہٕ میون شٲگرد بنُن بلکہِ ژٲریٚو مےٚ پنٕنؠ شٲگرد بننہٕ باپت تہٕ دِژمَو پنٕنؠ پنٕنؠ مخصوص کٲم تاکہِ توٚہؠ نیرِو پھیرِو دور تام روحٲنی پھل وۅپداونہٕ باپتھ۔ یہِ روحٲنی پھل گژھِ پوشُن ہر ہمیشہٕ۔ مےٚ ژٲریٚو توٚہؠ تاکہِ میون مول بخشہِ توٚہہِ پرٮ۪تھ کانٛہہ چیز یمچ توٚہہِ تس منٛگ ککٔرِو میٲنؠ نمایندٕ آسنہٕ رنگؠ۔
\v 17 بہٕ چُھسو یِمن کتھن ہُنٛد حکم کران تاکہِ توٚہؠ کٔرِو اکھ أکِس محبت
\v 18 چونکہِ تِم لوٗکھ یِم خدایس مخٲلف چھِ کرن توٚہہِ ناپسند۔ توٚہہِ پزِ زانُن زِ تِم کرن گۅڈٕ مےٚ ناپسند۔
\v 19 یوٚدوے توٚہؠ تمن لوٗکن ہُنٛد حصہٕ بٔنیٚو یِم یتھ دُنیہس منٛز خدایس مخٲلف۔ یِم بےپژھ لوٗکھ کرن توٚہہِ پسند۔ یِتھؠ پٲٹھؠ تِم پننٮ۪ن باقین محبت کران چھِ۔ مگر بہٕ چُھسو توٚہہِ ژاران یمو منٛز نٮ۪بر نیرنہٕ باپتھ خدایس مخٲلف لوٗکھ چھِ توٚہہِ ناپسند کران تکیازِ توٚہؠ چُھو نہٕ تِمو منٛزٕ۔
\v 20 ژٮ۪تس تھٲیِو مےٚ وونو توٚہہِ زِ نوکر چُھنہٕ ہرگز مٲلکہٕ سٕنٛدِ کھۅتہٕ اہم۔ چونکہِ تِمو دِتؠ مےٚ تکلیف تِم دِن یقیناً توٚہہِ تہِ تکلیف۔ یوٚدوے تِمو منٛزٕ کٲنٛسہِ میون مون، تِم مانن یقیناً تہنٛز تعلیم تہِ۔
\v 21 یِم بےٚ پژھ خدا مخٲلف لوٗکھ کرن توٚہہِ سٟتؠ تہِ ویکھت ویوہار تکیازِ توٚہؠ چُھو میٲنؠ نمایندٕ تہٕ اوٕ کِنؠ تہِ زِ تِم چھِنہٕ زانان میٲنِس مٲلِس یمؠ بہٕ یور سوزُس۔
\v 22 یوٚدوے بہٕ یور آمُت آسہٕ ہا نہٕ تہٕ تعلیم آسہ ہم نہٕ دِژمٕژ خدایہِ سنٛزِ حقیقتٕچ تِم آسہ ہن نہٕ راہ لد۔ مےٚ تہٕ میٲنؠ تعلیم نَہ ماننہٕ باپتھ چونکہِ بہٕ آس تہٕ دِژمکھ تعلیم تمن چھنہٕ پننٮ۪و گنہو باپتھ کانٛہہ بہانہٕ۔
\v 23 یُس تہِ مےٚ ناپسند کرِ سُہ چُھ کران میٲنِس مٲلِس تہِ ناپسند۔
\v 24 یوٚدوے مےٚ تمن دیدمان معجزٕ کٔرؠ مٕتؠ آسہ ہن نہٕ تِم آسہ ہن نہٕ پننٮ۪و گنہو باپتھ راہ لد۔ وۅنؠ یہِ چُھ تِمو وُچھ میانہ معجزٕ تہٕ توتہِ رودؠ مےٚ مخٲلف تِم چھِ میٲنِس مٲلِس تہِ مخٲلف۔
\v 25 بحرحال یہِ سپُد اوٕ کِنؠ زِ نبین ہُند مقدس کتابن منٛز لیٚوکھمُت تحریر نیرِ پوٚز۔ تِمو کٔر کُنہِ وجہہ ورٲے مےٚ سٟتؠ نفرت مےٚ سٟتؠ تہنٛز عداوت ٲس بے وجہہ۔\f + \fr 15‏:25 \ft زبور 35:19، 69:4، 109:3\f*
\v 26 ییٚلہِ بہٕ پننس مٲلؠ سٕنٛدِ مقامہ پٮ۪ٹھٕ سوزن توٚہہِ مدد کرن وول سُے ونہِ لوٗکن بہٕ کُس چُھس۔ سُہ چُھ پاک روح۔ یُس میٲنِس مٲلؠ سٕنٛدِ پٮ۪ٹھٕ یِوان چُھ تہٕ یُس خدایہِ سُنٛد پزر خدایہِ سنٛز حقیقت اعلان کرِ۔
\v 27 توٚہہِ تہِ پزِ مےٚ متعلق لوٗکن ونُن تکیازِ توٚہہِ رودِیٚو مےٚ سٟتؠ میانہِ کامہِ شروع کرنکہِ گۅڈٕ دوٚہہ پیٚٹھےَ۔
\c 16
\p
\v 1 مےٚ ونیٚوٕ توٚہہِ تِمہٕ کِتھہٕ یِم برونٛہہ کُن سپدن واجنہِ چھےٚ تاکہِ توٚہؠ تھٲیِو پنٕنؠ پژھ قٲیِم ییٚلہِ یِم سپدن
\v 2 یہُودؠ یِم مےٚ مخٲلف چھِ کرن توٚہہِ ٹھاکھ پننٮ۪ن یہُودؠ مجلس چٮ۪ن جاین اژنس۔ حالات گژھن امہِ کھۅتہٕ تہِ بدتر۔ وقت واتہِ ییٚلہِ توٚہہِ تِم سٲری لوٗکھ یِم توٚہہِ مارنو یہِ سونٛچن زِ تِم چھِ امہِ کامہِ سٟتؠ پننس خدایہ سنٛز خدمت کران۔
\v 3 تِم کرن یِم اتٕرؠ اوٕ کِنؠ زِ زانان چھِنہٕ بہٕ کُس چُھس ژکہِ تہٕ میون مول کُس چُھ۔
\v 4 مےٚ ونُو توٚہہِ یِمن کتھن ہُنٛد تاکہِ ییٚلہِ یِم سپدن توٚہہِ پیٚیہِ ژٮ۪تس زِ مےٚ اوسو توٚہہِ یِمن کتھن متعلق برونٛہےٕ ؤنِتھ تھوومُت۔ مےٚ ونُو نہٕ توٚہہِ یِمن واقہن متعلق پننہِ کامہِ ہنٛدِس گۅڈتِس پیٚٹھےَ اوٕ کِنؠ زِ بہٕ اوسُس توٚہہِ سٟتؠ۔
\v 5 وۅنؠ چُھس پننس مٲلِس کُن یمؠ بہٕ یور سوزُس واپس گژھن وول۔ توتہِ تہِ چُھو نَہ توٚہؠ مےٚ پرٕژھان زِ ٲخٕر بہٕ گژھان کوٚت چُھس۔
\v 6 توٚہہِ ہیٚوتُو انٛدرؠ تکیازِ مےٚ ونیٚو توٚہہِ یِمہٕ کِتھہٕ۔
\v 7 ؤلِو بہٕ ونو توٚہہِ اکھ نٔو خبر: تہنٛدِ باپتھ چُھ میون یتہِ نیرُن واریاہ رُت میانہِ یتہِ روزنہٕ کھۅتہ۔ یہِ چُھ پوٚز یوٚدوے بہٕ نیرنہٕ واپس تیٚلہِ ییہِ نہٕ سُہ یُس توٚہہِ اتھہٕ روٚٹ کرِ۔ وۅنؠ گو یوٚدوے بہٕ نیرٕ بہٕ سوزن سُہ توٚہہِ نِش۔
\v 8 ییٚلہِ سُہ توٚہہِ مدد کرِن وول ییہِ، سُہ ٹھہراوِ گُنہن ہنٛدِس دنیہس منٛز ہینہٕ یِنہٕ والیٚن پننیٚو گنہو باپتھ قصوروار۔ سُہ ٹھہراوِ تِمن قصوروار راست باز نَہ روزنہٕ باپتھ۔ سُہ بناوِ تِمن قصوروار تاکہِ خدا لاگہِ تِمن عدالت۔
\v 9 سُہ ٹھہراوِ قصوروار لوٗکن پننیٚو گنہو باپتھ تکیازِ، تِمو کوٚر گناہ بہٕ نَہ ماننُک۔
\v 10 سُہ ٹھہراوِ لوٗکن قصوروار سٮ۪زِ وتہِ پٮ۪ٹھ پرہیز گار نَہ روزنہٕ باپتھ۔ تکیازِ بہٕ چُھس پننس مٲلِس کُن واپس نیران تہٕ توٚہؠ وُچھِو نہٕ راستبٲزی ہنٛدِ اکہِ نمونہٕ کِنؠ مےٚ یمہِ اپور۔
\v 11 سُہ ٹھہراوِ لوٗکن قصوروار تاکہِ خدا لاگٮ۪کھ عدالت تکیازِ تٔمؠ چھِ یتھ دنیہس پٮ۪ٹھ پنُن رازُت قٲیم کرن وول شیطان مجرم گنزروومُت۔
\v 12 بہٕ چُھس یژھان توٚہہِ بسیار کِتھہٕ وننہِ۔ وۅنؠ گو یوٚدوے بہٕ ونو توٚہؠ ہیٚکو نہٕ تِمہٕ قبول کرِتھ۔
\v 13 ییٚلہِ پاک روح یُس خدایہِ سٕنٛدِ حقیقتُک تُرے دِکھ یور بیٚیہِ سُہ بناوِ توٚہہِ یہِ پزر۔ یہِ حقیقت زاننس لایق یۅسہ توٚہہِ ضروری چھےٚ زانٕنؠ۔ سُہ ہیٚکہِ یہِ کٔرِتھ تکیازِ سُہ وننہِ پننہِ اختیارٕ بلکہِ ونہِ سُہ تی یہِ تٔمؠ خدایس نِش بوز تہٕ سُہ ونہِ توٚہہِ وقتہٕ برونٛہےٕ یہِ سپدن وول آسہ۔
\v 14 پاک روح ہاوِ توٚہہِ زِ بہٕ کوتاہ عظیم چُھس میانہِ بوزمژٕ کِتھہٕ دُہرٲوِتھ۔
\v 15 یتہِ کینٛہہ میٲنِس مٲلِس چُھ، چُھ میون۔ اوے ووٚن مےٚ زِ پاک روح ونہِ توٚہہِ تہِ یہِ تٔمؠ مےٚ نِش بوز۔
\v 16 کینٛہہ کالہٕ پتہٕ وُچھیٚو نہٕ توٚہؠ مےٚ تہٕ امہِ پتہٕ کینٛہہ کال گٔژھِتھ وُچھِو توٚہؠ مےٚ بیٚیہِ۔
\v 17 امسنٛدیٚو کینٛژو شاگردو پرُژھ اکھ أکِس۔ یسوعؔ سُنٛد مطلب کیاہ اوس ییٚلہِ تٔمؠ ووٚن زِ کینٛژِ کٲلؠ پتہٕ وُچھِو نہٕ توٚہؠ مےٚ تہٕ کیونہٛہ کالا گٔژھِتھ وُچھِ ووم بیٚیہِ تہٕ تمسُنٛد مطلب کیاہ چُھ ییٚلہِ سُہ ونان چُھ تکیازِ بہٕ چُھس گژھان مٲلِس نِش۔
\v 18 تِم رودؠ یِتھے پٲٹھؠ پرٕژھان۔ یہِ کینٛہہ کالا کیاہ گو، اسہِ چُھنہٕ فِکرے تران سُہ کیاہ ونان۔
\v 19 یسوعنؔ زون زِ تمسنٛدؠ شٲگرد چھِ تس واریاہ سوال پرٕژھنؠ یژھان۔ اوے ووننکھ، "توٚہؠ چُھو پانہٕ وٲنؠ پرژھان زِ میون مطلب کیاہ چُھ ییٚلہِ مےٚ ووٚن کینٛژ کالہٕ پتہٕ وُچھو نہٕ مےٚ توٚہؠ تہٕ امہِ پتہٕ کیونٛژ کال ادا سپدِتھ وُچھِو توٚہؠ مےٚ بیٚیہِ۔
\v 20 بہٕ چُھسو پوٚز ونان۔ توٚہؠ ؤدِو تہٕ کٔریو ماتم مگر خدا مخٲلف لوٗکھ تُلن ژِنگرِ تہٕ مناون خوشی۔ توٚہؠ ٲسِو دۅکھٕ لد مگر تہنٛدؠ دۅکھ بدلہِ سۅکھس منٛز۔
\v 21 کانٛہہ تہِ زنان چھےٚ ژینان دگ تہٕ دود ییٚلہِ سۅ پننس شُرِس زنم دِوان چھےٚ۔ کانٛہہ تہِ گۅبہِ کھۅر زنان چھےٚ آزاد ژینان ییٚلہِ سۅ خلاص چھےٚ گژھان۔ تکیازِ یہِ چُھ آسان بچہ سٕنٛدِ زیونُک موقعہ۔ وۅنؠ گو تس چُھ بچہ زیٚنہٕ پتہٕ یہِ سورےٕ تکلیف مشان تکیازِ سۅ چھےٚ خوش سپدان زِ تمہِ اوٚن اکھ انسان بچہ دُنیہس منٛز۔\f + \fr 16‏:21 \ft یسعیاہؔ 26:17، میکاہ 4:9\f*
\v 22 یِتھے پٲٹھؠ یوٚدوے توٚہؠ وُنکٮ۪س دۅکھل چُھو۔ بہٕ یِمہٕ توٚہہِ بیٚیہِ سمکھنہِ تہٕ توٚہؠ یِیو مےٚ وُچِھتھ وۅلسنس تہٕ کانٛہہ تہِ بنہِ نہٕ تہنٛزِ اتھ خۅشی منٛز ٹھوٚر۔
\v 23 ییٚلہِ توٚہؠ مےٚ دُبارٕ وچھو توٚہؠ پرژھیٚو نہٕ مےٚ کہین تہِ۔ بہٕ چُھسو پزر ونان۔ میون بب بخشو توٚہہِ پرٮ۪تھ کانٛہہ چیز یہِ توٚہؠ تس منٛگِو میٲنؠ نمایندٕ آسنہٕ رٔنگؠ۔
\v 24 ونیُک تام مونٛگو نہٕ توٚہہِ کہین میٲنِس مٲلِس میٲنؠ نمایندٕ آسنہٕ رٔنگؠ۔ منٛگِو کینٛہہ تہِ میٲنِس مٲلِس تہٕ توٚہہِ میلہِ یہِ کینٛہہ منٛگِو خدا بخشہِ توٚہہِ تاکہِ توٚہؠ روزیٚو حدٕ کھۅتہٕ خوش تہٕ سوٚکھل۔
\v 25 مےٚ ونہِ توٚہہِ یِمہٕ کِتھہٕ ورگہٕ زبان ورتٲوِتھ۔ مگر ؤلؠ واتہِ سُہ وق ییٚلہِ بہٕ امہِ قسمچ زبان توٚہہِ سٟتؠ کتھ کرنہٕ باپتھ ورتاو نہٕ بلکہِ ونہٕ بہٕ توٚہہِ پننس مٲلِس متعلق تتھ زبٲنؠ منٛز یۅسہ توٚہہِ آسٲنی سان سمجھ یِیو۔
\v 26 ییٚلہِ توٚہؠ مےٚ دُبارٕ وُچھِو، توٚہؠ منٛگِو کانٛہہ تہِ چیز خدایس میانیو نمایندو رٔنٛگؠ تہٕ بہٕ پرژھنہٕ تہنٛدِ باپتھ پننس مٲلِس۔
\v 27 تکیازِ میون مول چُھو توٚہہِ لول بران تکیازِ توٚہؠ چُھو مےٚ محبت کران تہٕ پژھ تھاوان زِ بہٕ آس خدایہِ سٕنٛدِ طرفہٕ یور۔
\v 28 بہٕ آس پننس مٲلؠ سٕنٛدِ پٮ۪ٹھٕ تہٕ ژاس یتھ دنیہس منٛز۔ بہٕ چُھسو بیٚیہِ ونان بہٕ تراوٕ یہِ دُنیا تہٕ گژھٕ واپس پننس مٲلِس نِش۔
\v 29 امسنٛدیٚو شاگردو ووٚنُس اورٕ۔ وۅنؠ چُھکھ ژٕ ٲخٕر سۅ زبان ورتاوان یۅسہ اسہِ سمجھ یِوان چھےٚ تہٕ کانٛہہ ورگہٕ باوتھٔ چُھکھ نہٕ کران۔
\v 30 وۅنؠ چھِ أسؠ زانان زِ ژٕ زانکھ سورےٕ۔ کٲنٛسہِ تہِ چھنہٕ ضرورت سوال کرنچ۔ تکیازِ ژٕ زانکھ گۅڈے کُس کیاہ پرژھِ۔ اوے چھےٚ اسہِ پژھ زِ ژٕ آکھ خدا سٕنٛدِ پٮ۪ٹھٕ۔
\v 31 یسوعنؔ ونُکھ، "تہٕ ٲخٕر چُھو توٚہؠ مےٚ پژھ کران:"
\v 32 بوزِو۔ ؤلؠ واتہِ سُہ وق تہٕ سُہ وق آسہ جلدےٕ ییٚلہِ یِم باقےٕ توٚہہِ دربدر کرن۔ توٚہؠ پرٮ۪تھ کانٛہہ گٔژھِو پنُن گرٕ۔ تہٕ مےٚ ترٲیو کُن زوٚن۔ وۅنؠ گو بہٕ آسنہٕ پانس کُن زوٚن تکیازِ میون بب چُھ ہر وِزِ مےٚ سٟتؠ۔
\v 33 مےٚ چُھو توٚہہِ یِمے سارے کِتھہٕ ونہِ مژٕ یمہٕ سپدن تاکہِ توٚہؠ روزیٚو سکونہٕ سان تکیازِ توٚہؠ چُھو رٔلِتھ مےٚ سٟتؠ۔ یتھ دنیہس منٛز یِیو توٚہہِ تکلیف دنہٕ مگر ولہٕ ویر بنیو! مےٚ چھِ تِمن لوٗکن شکست دِیُتمُت یِم یتھ دنیہس منٛز خدا سٟتؠ بُتھؠ لٲگۓ کریٚن۔
\c 17
\p
\v 1 پننٮ۪ن شٲگردن یِنہٕ وٲلِس کالس منٛز سپدن واجنیٚن کتھن متعلق ؤنِتھ وُچھ یسوعنؔ ہیٚور آسمانس کُن تہٕ ووٚنُن، "میانہِ ببہٕ۔ وق ووت میانہِ باپتھ تکلیف تلنُک تہٕ مرنُک۔ ہٲو پرٮ۪تھ کٲنٛسہِ بہٕ چون گۅبُر کوتاہ عظیم چُھس تاکہِ بہٕ ہاوٕ پرٛتھ کٲنسہِ ژٕ کوتاہ بوڈ چُھکھ۔
\v 2 مہربٲنی کرِتھ کریٚو یہ، تکیازِ ژےٚ دِ تُتھ مےٚ اختیار تمام لوٗکن پٮ۪ٹھ تاکہِ بہٕ بناوٕ تِمن لوٗکن ہنٛز زندگی پوشوٕنؠ تہٕ بہتر یِم ژےٚ مےٚ کُن ژٲرِتھ سوزؠ تھکھ۔
\v 3 پوشوٕنؠ زندگی ہُنٛد مطلب گو: ژٕ زانُن سُہ یُس کُنے پوٚز خدا چُھ، تہٕ بہٕ زانُن یسوعؔ مسیحؔ یُس ژےٚ یور سوزتھن دنیاہس منٛز۔
\v 4 مےٚ ہوو سارِنےٕ زِ ژٕ کوتاہ عظیم چھُکھ ییتِس کالس بہٕ یتھ زگتس پٮ۪ٹھ روزان آس۔ مےٚ کوٚڑ یہِ پنٕنؠ کٲم انٛد واتنٲوِتھ۔
\v 5 مالیا! ہاو۔ بہٕ کوتاہ عظیم چُھس چانہِ موجودگی منٛز تِتھے پٲٹھؠ یتھٕ پٲٹھؠ بہٕ عظیم اوسُس یہِ دُنیا سانہِ دٔسؠ تخلیق سپدنہٕ برونٛہہ ژےٚ سٟتؠ سٟتؠ۔
\v 6 مےٚ ہوو تِمن لوٗکن یِم ژےٚ دنیہکیو لوٗکو منٛز مےٚ دِتؠ تھکھ زِ ژٕ کوتاہ عظمت وول چھُکھ۔ یِم ٲسؠ چٲنؠ بنٛدٕ مگر دِتؠ تھکھ مےٚ۔ تِمو کور چانہِ تعلیمہ ہنٛز تابعدٲری۔
\v 7 وُنکٮ۪س چھِ تمام زانان زِ ژٕ یہِ کینٛژھا مےٚ دِتُتھ آو چانہِ پیٚٹھےَ۔
\v 8 تِم چھِ زانان تکیازِ مےٚ واتہٕ نٲوؠ تِمن سۅ تعلیم یۅسہ ژےٚ مےٚ دِژٕتھ۔ تِمو کٔر سۅ تعلیم پانہٕ قبول تہٕ تِمن چُھ پوٗرٕ بہتھ زِ بہٕ آس چانہِ پٮ۪ٹھٕ تہٕ تِمن چھِ پژھ زِ ژےٚ سوزتھس بہٕ۔
\v 9 بہٕ چُھس یہنٛدِ باپتھ دعا منٛگان۔ تمن لوٗکن ہنٛدِ باپتھ نہٕ یِم ژےٚ مخٲلف چھی۔ بلکہِ چُھس بہٕ دُعا منٛگان تہنٛدِ باپتھ یِم ژےٚ مےٚ بخشتھ گو زن یِم چھِ چٲنؠ۔
\v 10 یِم میٲنؠ سٲری شٲگرد چھِ ژکہِ چٲنؠ تہٕ سٲری چٲنؠ شٲگرد چھِ میٲنؠ۔ یِم چھِ سارنےٕ ہاوان زِ بہٕ کوتاہ عظیم چُھس۔
\v 11 بہٕ روزنہٕ یتھ گناہ گار دنیہس منٛز یمہِ اپور۔ وۅنؠ گو میٲنؠ شٲگرد روزن یتھؠ بہٕ یمے ؤلؠ ؤلؠ ژےٚ کُن واپس۔ میانہِ مالہِ تِم لوٗکھ یِم ژےٚ ژٲرتھ الگ کٔڑِتھ تم تھاوکھ پننہِ تمی قوژ سٟتؠ یۅسہ ژےٚ مےٚ بخشتھ۔ محفوظ۔ تاکہِ تِم روزن یکتِس منٛز تِتھے پٲٹھؠ یتھ پٲٹھؠ زن أسؠ چھِ۔
\v 12 یِمن سٟتؠ میٲنس روزن کالس منٛز تھٲوؠ مےٚ تِم محفوظ تٔمؠ طاقتہٕ سٟتؠ یُس ژےٚ مےٚ بخشُتھ۔ مےٚ کٔر یِمن رٲچھ چھرا گژھِ ہمیشہ باپتھ اکُے ہلاک۔ یہِ چُھ سوے یُس ژےٚ ہمیشہ خٲطرٕ ہلاک گژھنہٕ باپتھ ژورتھن تاکہِ مقدس صحیفہ نیرن پزی۔\f + \fr 17‏:12 \ft متی 7:13، عملہٕ 8:20، رومین 9:22، فلپین 1:28، 3:19، 1 تھموتھین 6:9، عبرٲیین 10:39، 2 پطرس 2:1، 3:7، مُکاشفہ 17:8، 11\f*
\v 13 یمہِ وقتہٕ چُھس بہٕ تیار ژےٚ کُن نیرنس۔ مےٚ ونہِ یِم کِتھہٕ یتھ گناہ گار دُنیہس منٛز روزنس دوران تاکہِ بہٕ دِمہٕ تِمن شٲگردن مکمل خوشی سۅکھ
\v 14 مےٚ ؤنؠ یِمن چٲنؠ تعلیم۔ اوے چُھ چٲنؠ مخالفت کرن والیٚن لوٗکن تہنٛز عداوت تکیازِ میٲنؠ پٲٹھؠ چھنہٕ یِم تہِ تمن لوٗکن سٟتؠ۔
\v 15 بہٕ چُھسے نہٕ منٛگان زِ یِم میٲنؠ شٲگرد کڑکھ یمہِ گناہ گار دُنیا منزٕ۔ بلکہ چُھسے منٛگان زِ یم تھاوکھ شیطان سٕنٛدِ تکلیفہٕ نِشہ محفوظ۔
\v 16 میٲنؠ پٲٹھؠ چھِنہٕ یِم دنیہس منٛز ژےٚ مخالف لوٗکن سٟتؠ۔
\v 17 میٲنؠ شٲگرد تھٲوکھ بدون پننہِ عبادت باپتھ۔ تمن نیکی تہٕ پزرس زاننس تہٕ زندٕ روزنس لایق تھٲوِتھ۔ چٲنؠ تعلیم چھےٚ اصل حقیقت تہٕ پزر۔
\v 18 بہٕ چُھسکھ یِم دُنیہکٮ۪ن لوٗکن کُن سوزان یتھٕ پٲٹھؠ ژےٚ بہٕ یور سوزتھس۔
\v 19 مےٚ تھوو پنُن پان تہنٛدِ باپتھ قربٲنی رنگؠ مخصوص یُتھ تِم تہِ تھاون پنُن پان چانہِ خدمت باپتھ الگ کڑیتھ، تہِ زٲنتھ تہٕ تیتھٕ پٲٹھؠ بسِتھ یہِ پوٚز چُھ۔"
\v 20 وۅنؠ چُھس بہٕ نَہ صرف یِمن لوٗکن ہنٛدِ باپتھ یتہِ دعا منٛگان بلکہِ تمن لوٗکن ہنٛدِ باپتھ تہِ یِم مےٚ پٮ۪ٹھ میانٮ۪ن شٲگردن ہنٛدِس وننس پٮ۪ٹھ پژھ کرن۔
\v 21 بہٕ چُھ دُعا منٛگان زِ یِم سٲری گژھن پانہٕ وٲنؠ یکتس اتحاد سان روزنؠ یتھٕ پٲٹھؠ بہٕ تہِ ژٕ میانہِ مالہِ یِکہٕ وٹہٕ چھِ۔ بہٕ چُھس دُعا منٛگان زِ یِم گژھن اسہِ سٟتؠ تہِ یِکوٹہٕ روزٕنؠ تاکہِ دُنیہکؠ لوٗکھ زانن زِ بہٕ سوز تس ژےٚ یور۔
\v 22 تاکہِ یِم روزن پانہٕ وٲنؠ یکتس منٛز یتھ پٲٹھؠ اسؠ ز چھِ۔ مےٚ بخش عزت یمن مےٚ پٮ۪ٹھ پژھ چھےٚ یتھٕ پٲٹھؠ ژےٚ مےٚ عزت بخشُتھ۔
\v 23 امیُک مطلب گو بہٕ چُھس یمن سٟتؠ جورِتھ تہٕ ژٕ مےٚ سٟتؠ۔ مےٚ کوٚر یہِ تاکہِ یِم روزن مکمل طور اکھ أکِس سٟتؠ جورِتھ تاکہِ دنیہکؠ لوٗکھ زانن زِ بہٕ سوزتھس ژےٚ یور تہٕ ژٕ چھُکھ تمن لوٗکن محبت کران یِم مےٚ پٮ۪ٹھ پژھ قٲیِم تھٲوِتھ چھِ۔ یتھٕ پٲٹھؠ ژٕ مےٚ سٟتؠ محبت کران چھُکھ۔
\v 24 "میانہِ ببہٕ، بہٕ چُھس یژھان تِم لوٗکھ یِم ژےٚ مےٚ دِتؠ تھکھ آسن مےٚ سٟتؠ جنتس منٛز تاکہِ تِم ہیٚکن وُچِھتھ زِ بہٕ کوتاہ جلال وول چُھس۔ ژےٚ بنوتھس بہٕ عظیم تکیازِ ژےٚ کوٚڑُتھ مےٚ سٟتؠ تمہِ وقتہٕ پٮ۪ٹھ محبت ییٚلہِ اسہِ کاینات تخلیق کوٚر۔\f + \fr 17‏:24 \ft یوحنا 14:3\f*
\v 25 میون مول یُس ہمیشہٕ صحیح کران چُھ تِم لوٗکھ یِم ژےٚ مخٲلف چھی یتھ دنیہس منٛز چھِنہٕ زانان ژٕ کُس چھُکھ مگر بہٕ چُھس زانان ژٕ کُس چھُکھ۔ تِم لوٗکھ یِم مےٚ پٮ۪ٹھ پژھ کران چھِ تِم چھِ زانان زِ ژےٚ سوزتھس بہٕ یور۔
\v 26 مےٚ رنٛزرٲبؠ یِم ژٕ کُس چھُکھ۔ بہٕ روزٕ یہِ کران تاکہِ یِم کرن باقین سٟتؠ محبت یتھٕ پٲٹھؠ ژٕ مےٚ سٟتؠ چھُکھ کران تاکہِ ژٕ روزکھ تِمن سٟتؠ جورِتھ۔
\c 18
\p
\v 1 یسوعؔ دراو عبادت کٔرِتھ پنٕنؠ شٲگرد ہٮ۪تھ تہٕ توٚر قدرون دریاوس اپور۔ وادی ہنٛدِس اپٲرؠ مِس اندس ژاے تِم أکِس کُلؠ گہلِس منٛز یُس زیتون کُلٮ۪ن ہُنٛد اوس۔
\v 2 یہُوداؔ اوس سُہ اکھ نفر یُس وۅنؠ یسوعؔ سنٛدٮ۪ن مخٲلفن أمِس بٲنٛدؠ بناونس منٛز اتھہٕ روٚٹ کرن وول اوس۔ سُہ اوس یسوعؔ سنٛزِ اتھ بیہنہٕ جایہِ زانان تکیازِ یسوعؔ اوس اکثر پنٕنؠ شٲگرد ہٮ۪تھ اور یوان گژھان۔
\v 3 یہُوداہنؔ انؠ اور پانس سٟتؠ رومی سِپہن ہنٛز اکھ ٹوگٕج تہٕ کینٛہہ ہیکلٕکؠ رٲچھ در۔ یِم أمِس سٟتؠ مذہبی کاہنو تہٕ فریسیسو سوزؠ۔ تِم ٲسؠ لالٹیٖن، مشالہِ، ژٲنگؠ تہٕ ہتھیار ہٮ۪تھ۔
\v 4 چونکہِ یسوعؔ اوس زانان زِ تمِس سٟتؠ کیاہ تہِ کیُتھ ہیٚو چُھ سپدن وول۔ سُہ آو یِمن برونٛٹھ کُن تہٕ پرژھُن یِمن سِپہن تہٕ ہیکلکٮ۪ن رٲچھ درن، "توٚہؠ کس چُھو ژھاران؟"
\v 5 تِمو ووٚنُس اور، "یسوعؔ ناصرت یس۔ یسوعؔن ونُکھ، "بہےٕ چُھس سُہ شخص:" یہُوداؔ اوس یِمن سٟتؠ أتی وۅدٕنؠ۔ سُے اوس یسوعؔ سنٛدٮ۪ن مخٲلفن أمِس بٲنٛدؠ بناونس منٛز اتھہٕ روٚٹ کران۔
\v 6 یُتھےٕ یسوعؔن تِمن ووٚن "بہٕ چُھس سُے شخص:" تِم کھٔتؠ پتھ تہٕ آے پانے زن پتھرِس پٮ۪ٹھ وۅکراونہٕ۔
\v 7 یسوعؔن پرُوژھ بیٚیہِ "توٚہؠ کس چُھو ژھاران" تِمو ووٚنُس اورٕ، "یسوعؔ ناصریس"
\v 8 یسوعؔن ونُکھ، "مےٚ ونُو بہٕ چُھس سُہ شخص۔ چونکہِ بےٕ چُھس سُہ شخص یمِس توٚہؠ ژھانٛدان چُھو۔ یِمن باقین نفرن دِیو نیرنہٕ۔
\v 9 یہِ کتھ باتھ سپٕز اوٕ کِنؠ تاکہِ پننس مٲلِس دِنہٕ آمٕتؠ یسوعؔ سنٛدؠ یِم لفظ نیرن پٔزؠ۔ مےٚ راوُر نہٕ اکھ نفر تہِ یِم مےٚ ژےٚ دِتِتھ۔"\f + \fr 18‏:9 \ft یوحنا 17:12\f*
\v 10 شمعون پطرس ٲسؠ اکھ لوکٹؠ کرتل۔ تٔمؠ کڈ یہِ میانہِ منٛزٕ تہٕ واجِنؠ تھدِس کاہن سنٛدِس خٲدمس تہٕ روٚٹنس دٔچُھن کن۔ أمِس خٲدمہٕ سُنٛد ناو اوس ملخُسؔ۔
\v 11 یسوعؔن ووٚن اوے پطرسس۔ پننؠ کرتل رٹُن میانس منٛز۔ مےٚ پزِ پنُن تکلیف پانہٕ تلُن یتھٕ پٲٹھؠ میٲنؠ ببن یوٚژھمُت چُھ۔
\v 12 رومی سپہن ہنٛز امہِ ٹوگجہ تہٕ تہنٛدؠ سردارن تہٕ کینٛژو ہیکلہٕ کیو یہُودؠ رٲچھ درو نفرو یسوعؔ اوس روٚٹمُت تہٕ گٔنٛڈؠ ہس اتھہٕ۔
\v 13 تہٕ پکنووُکھ گۅڈٕ اننیاس ناوکِس أکِس شخصس نِش یُس امہِ ؤرؠ یہِ کِس سردار کاہن کایفا سُنٛد ہیٚہُر باب اوس۔
\v 14 أمؠ کایفاہن اوس یہُودؠ سردارن مشورٕ دیُتمُت زِ اکھ انسان مارُن روزِ بہتر امہِ کھۅتہٕ زِ باقےٕ بسیار لوٗکھ یِن مارنہٕ
\v 15 شمعون پطرس رود یسوعؔس پتہٕ پتے۔ تہٕ یِتھے پٲٹھؠ رودؠ بیاکھ اکھ شٲگرد تہِ۔ حناس اوس یمِس بیٚیِس شٲگردس زانان۔ اوے آو کاہن سردار سنٛدِس انٛدرمس آنٛگنس منٛز تراونہٕ ییٚلہِ زن سپہو تہٕ رٲچھ درو یسوعؔ اور ژون۔
\v 16 وۅنؠ گو پطرسس پیٚو برٕ نٮ۪برے روزُن۔ اوے تہِ پیو کاہن سٕنٛدِس زٲنؠ کار شٲگردس نٮ۪بر نیرتھ أکِس خٲدم کورِ یۅسہ بر رٔٹِتھ ٲس پطرس سٕنٛدِ باپتھ ونُن تہٕ اوٕ کِنؠ آو پطرس تہِ انٛدر تراونہٕ انٛدرمِس آنٛگنس منٛز
\v 17 نوکرانہِ  کورِ یۅسہ بر رٔٹِتھ ٲس ووٚن پطرسس، "ژٕ چھُکھ پٔزی أمِس شخصہٕ سُنٛد شٲگرد یُس بٲنٛدؠ آو بناونہٕ۔ "تٔمؠ کوٚر اتھ اِنکار یہِ ونان، "نَہ۔ بہٕ چُھس نہٕ:"
\v 18 تٟر ٲس تہٕ اوے زول سردار کاہن سنٛدیو خٲدمو تہٕ ہیکل کیٚو رٲچھ درو نار تہٕ رودؠ اتھ نکھہٕ وۅدنؠ وُشنیر باپتھ۔ پطرس تہِ اوس أتی وۅدنؠ پانس وُشنیر کران۔
\v 19 سردار کاہنن لٲج یسوعؔس پننٮ۪ن شٲگردن تہٕ تعلیمہ متعلق پرژھ گٲر کرٕنؠ۔
\v 20 یسوعؔن ووٚنُس یور، "مےٚ چھےٚ کھُلہٕ پٲٹھؠ عوامس منٛز تِمن لوٗکن سٟتؠ کتھ کٔرمٕژ یِم میون بوزہن۔ مےٚ چھِ یہُودؠ مجلسہِ ہنٛزن جاین ہنٛزن جاین تہٕ ہیکلس منز لوٗکن تعلیم دِژمٕژ۔ مےٚ چھےٚ تعلیم دِژمٕژ تتھ پرٮ۪تھ جایہِ یتہِ یہُودؠ جمع سپدان۔ مےٚ چھنہٕ کانٛہہ کتھ تہِ ژوٗرِ ژھٮ۪پہِ ونمٕژ۔
\v 21 توٚہہِ پزِ نہٕ مےٚ پرژھُن۔ پرژھِو تِمن لوٗکن یِمو میٲنؠ تعلیم بوز۔ تِم چھِ پزنہٕ پٲٹھؠ زانان، مےٚ ووٚن کیاہ تِمن."
\v 22 ییٚلہِ یسوعؔن یہِ ووٚن۔ اکؠ ہیکلٕکؠ رٲچھ درن ترٲو أمِس تھاپٕر۔ تہٕ وونس" ژےٚ پزی نہٕ سردار کاہنس امہِ آیہِ واپس جواب دیُن۔\f + \fr 18‏:22 \ft لوقا 22:63، میکاہ 5:1\f*
\v 23 یسوعؔن ووٚنُس یورٕ، "یوٚدوے میون ووٚنمُت غلط اوس، ون تیٚلہِ کیاہ اوس غلط وۅنؠ گو یوٚدوے یہِ مےٚ ووٚن، تہِ اوس پوٚز۔ ژےٚ پزی نہٕ مےٚ تھاپٕر لایِنؠ۔
\v 24 اوٕ پتہٕ سوز اننیاسنؔ یسوعؔ کاہن اعلاہس کایفاہس نِش۔ ییٚلہِ زن امسنٛدؠ اتھہٕ گنٛڈتھےٕ ٲسؠ۔
\v 25 أتھؠ دوران ییٚلہِ شمعون پطرس أتی آنٛگنس منٛز وۅدنؠ وُشنیر کران اوس، کٔمؠ تام پرژھُس ژٕتہِ چھُکھ پزی بٲنٛدؠ بناونہٕ آمتِس شخصہٕ سُنٛد شٲگرد۔ پطرسن کوٚرُس یورٕ نکار تہٕ ووٚننس، "نَہ۔ بہٕ چُھس نہٕ:"
\v 26 سردار کاہن سُنٛد اکھ خٲدم اوس تمِس خٲدمہٕ سُنٛد ٲشناو یمِس پطرسن کن اوس ژوٚٹمُت۔ تٔمؠ ووٚن پطرسس، "مےٚ ہے ژٕ یقیناً زیتون کُلٮ۪ن ہنٛدِس گٔہلِس منٛز أمِس بٲنٛدؠ بناونہٕ آمتِس شخصس سٟتؠ پانہٕ وُچھُکھ۔
\v 27 پطرسن کوٚرُس دویمہِ لٹہِ تہِ اِنکار زِ سُہ کیاہ اوس یسوعؔس سٟتؠ۔ اکؠ کۅکرن دِژ امی وِزِ اچانک بانگ۔
\v 28 یہُودؠ سردارو اوٚن کایفا سٕنٛدِ گرٕ پٮ۪ٹھٕ یسوعؔ واتنووُکھ قلعس منٛز رومی گورنر پلاطوسؔس نِش۔ یہِ اوس سُلہِ صبحُک وق۔ یہُودؠ سردار ژاے نَہ پلاطوسؔ سٕنٛدِس قلعس منٛز تکیازِ پلاطوسؔ اوس نہٕ یہُودؠ۔ تہٕ یِم یہُودؠ ٲسؠ زانان زِ یوٚدوے تِم قلعس منٛز اژن تِم سپدن رسمی طور ناپاک تہٕ پتہٕ ہیٚکن نہٕ عید فسح ہچ دعوت کھیٚتھ
\v 29 اوے آو پیلاطسؔ تِمن نِش نٮ۪بر کتھ کرنہِ۔ تٔمؠ پرژھُکھ، "توٚہؠ کُس راہ چُھو یمِس نفرس کھالان؟"
\v 30 یہُودؠ سردارو ووٚنُس، "یوٚدوے یہِ نفر راہ لد آسہ ہے نہٕ أسؠ کتہِ انہون تیٚلہِ توٚہہِ نِش"
\v 31 پیلاطسنؔ ونُکھ، "توٚہؠ نی وُن یہِ پانس سٟتؠ تہٕ پننہِ قانونہٕ حسابہٕ لٲگؠ وُس عدالت۔ "یہُودؠ سردارو ووٚنُس، "أسؠ چھِ یژھان أمِس پھیہ دیُن مگر تُہنٛد رومی قانون چُھ اتھ ٹھاکھ کران۔
\v 32 یہِ سپدِ اوٕ کِنؠ زِ یسوعؔ سنٛز پننس مرنس تہٕ مارنہٕ یِنس پٮ۪ٹھ کرنہٕ آمژٕ کتھٕ نیر، پٔز۔
\v 33 امہِ پتہٕ ژاو پیلاطس واپس پننس قلعس منٛز۔ تٔمؠ دیُت سپہن حکم زِ یسوعؔ أنؠ وُن تس نِش۔ تہٕ پرژھُن تمِس، "ژٕ چُھکھا یہودٮ۪ن ہُنٛد بادشاہ۔"
\v 34 یسوعؔن ووٚنُس، "ژےٚ پرُژھتھا مےٚ یہِ سوال اوٕ کِنؠ زِ ژےٚ سونچُتھ انٛدرؠ کِنؠ یی۔ کٮ۪نہٕ یہِ وۅنےٕ ژےٚ باقیو مےٚ متعلق۔"
\v 35 پیلاطسنؔ ووٚنُس، "بہٕ چُھس نہٕ یہُودؠ۔ ژٕ اونُکھ مےٚ نِش پننٮ۪و وطنٕکیٚو لوٗکو تہٕ حکمران کاہنو۔ ژےٚ کُس اتُر چُھتھ کوٚرمُت۔"
\v 36 یسوعؔن ووٚنُس یورٕ، "یتھ سلطنتس پٮ۪ٹھ بہٕ رازُت کران چُھس سُہ چُھنہٕ یہِ گناہ گار دُنیا۔ یوٚدوے تہِ آسہ ہے۔ میٲنؠ خٲدم وۅتھہن یورٕ جنگس تہٕ یمن یہُودؠ سردارن دِہن نہٕ مےٚ بٲنٛدؠ بناونہٕ۔ مگر یہِ زن وۅنؠ صورت چھےٚ یتھ سلطنتس پٮ۪ٹھ میون رازُت چھنہٕ یمہِ گناہ گار دنیہچ۔
\v 37 اوٕ پتہٕ پرژھُس پیلاطسن، "گو ژٕ چھُکھ بادشاہ؟" یسوعؔن ووٚنُس، "ژٕ چھُکھ پانے یہِ ونان۔ اوے آس بہٕ یتھ دنیہس منٛز زنمس۔ بہٕ آس یور لوٗکن یہِ وننہِ زِ خدا سنٛز حقیقت کیاہ چھےٚ۔ سُہ ہر کانٛہہ یُس خدایہِ سنٛز حقیقت زاننہِ چُھ مانان تہٕ منظور کران یہِ بہٕ ونان چُھس۔
\v 38 پیلاطسن ووٚنُس، "کانٛہہ تہِ چُھنہٕ زانان اصل حقیقت زِ پزر کیاہ چُھ!" ییٚلہِ پیلاطسن یہِ ووٚن سُہ دراو نٮ۪بر تہٕ کرٕن یہُودؠ سردارن سٟتؠ کتھ۔ تٔمؠ ووٚن تِمن، "مےٚ لٔب نہٕ کانٛہہ شہادت زِ أمؠ شخصن کیاہ چُھ کانٛہہ قانون پھُٹرومُت۔
\p
\v 39 وونؠ گو، توٚہہِ یہودٮ۪ن چُھو اکھ رسم: پرٮ۪تھ وریہ چُھو توٚہؠ مےٚ عیدِ فسع مناونس پٮ۪ٹھ پرژھان تہٕ بہٕ چُھس اکھ بٲنٛدؠ توٚہہِ ییٚلہ تراوان۔ وۅنؠ ؤنؠ تو توٚہؠ چُھوا یژھان زِ بہٕ تراون یہِ تُہنٛد بادشاہ ییٚلہ؟"
\v 40 یہُودؠ سردارو تُج ہول ہانگے۔ نَہ۔ نَہ۔ یہِ شخص مٕہ ترٲوۅن ییٚلہ مگر براباؔ ترٲووُن۔ براباسؔ اوس اکھ بٲغی۔
\c 19
\p
\v 1 امی وقتہٕ دیُت پیلاطسن سپہن حکُن زِ کٔڈؠ وُن یسوعؔ تہٕ وٲلؠ وُس قمچہٕ۔
\v 2 سِپہو أنؠ کینٛہہ کنٛڈؠ دۅپھ تہٕ وونُکھ اتھ تاج ہیٚو کلہٕ ووٚلُت۔ تہٕ لوگُکھ یسوعؔ سٕنٛدِس کلس تہٕ ووٚلُہس بنفشہٕ رنگؠ خرقہٕ أمِس رٮ۪ژھِ تُلنہٕ باپتھ۔
\v 3 تہٕ أمِس نکھہٕ یِتھؠ یِتھؠ یہِ ؤنِتھ ٹیپ ژٹان رٮ۪ژھِ تُلان یہُودؠ رازس سلام۔ تہٕ رودُس بُتھِس تھاپٕر تہِ والان۔
\v 4 پیلاطس آو دبارٕ نعبر کُن تہٕ ووٚنُن یہُودؠ سردارن، "بوزِو۔ بہٕ انُن وۅنؠ یہِ شخص توٚہہِ برونٛہہ کُن تاکہِ توٚہؠ زٲنِو زِ أمِس خلاف لٔب نہٕ مےٚ قانون پھُٹراونچ کانٛہہ شہادت۔
\v 5 یسوعؔ دراو نٮ۪بر۔ تمِس اوس کلس کٔنٛڈؠ دار تاج تہٕ بنفشہٕ رنگؠ خرقہٕ لٲگِتھ۔ پیلطیسن ووٚن یہُودؠ سردارن، "وُچھِو یہِ گو سُہ شخص"
\v 6 یُتھےٕ حکمران کاہنو تہٕ ہیکل کیٚو رٲچھ درو یسوعؔ وُچھ تِمو دِژٕ کریکہٕ، "یہِ کھٲلؠ ووٚن صلیبس، یہِ کھٲلؠ وُن صلیبس۔ "پیلاطسن ونُکھ، "توٚہؠ نی وون یہِ پانس سٟتؠ تہٕ دی وُن پھییہ۔ یوٚتام میون کرُن اوس، مےٚ لوٚب نہٕ کانٛہہ ثبوت زِ أمؠ چُھ کانٛہہ رومی قانونن پھٹرومُت۔
\v 7 یہُودؠ سردارو ووٚنُس یورٕ، "اسہِ نِش چُھ قانون یُس أمِس مارنُک اجازت دِوان چُھ تکیازِ یہِ چُھ پانس خدا سُنٛد نیٚچو آسنُک دعوا کران۔\f + \fr 19‏:7 \ft احبار 24:16\f*
\v 8 ییٚلہِ پیلاطسن یہِ بوز، سہ کھوٚژ وارے۔ زِ تس کیاہ بنہِ ہے یوٚدوے سُہ أمِس مارنُک سزا دِیہ ہے۔
\v 9 سُہ ژاو بیٚیہِ پننس قلعس منٛز تہٕ دِتھُن سپہن یسوعؔ أمِس نِش واتناونُک حکم۔ امہِ پتہٕ پرژھُن یسوعؔس، "ژٕ کتہِ پٮ۪ٹھٕ چھُکھ آمُت" یسوعؔن ووٚنُس نہٕ یورٕ کہین۔
\v 10 اوے پرُژھُس پیلاطسن بیہِ یہِ، "ژےٚ چھُے مےٚ جواب دیُن ژےٚ چھَے یقیناً یہِ خبر زِ مےٚ چُھ طاقت ژٕ یلہٕ تراونُک تہِ تہٕ ژےٚ پھہہِ دِنُک تہِ۔"
\v 11 یسوعؔ وتھُس یورٕ، "ژےٚ یُس تہِ طاقت مےٚ پٮ۪ٹھ چھُےٕسُہ چھُے ژےٚ خدایہِ سنٛدِ طرفہٕ۔ لہٰذا چُھ مےٚ ژےٚ نِش یور انُن وٲلِس ژوٚر گناہ چانہ اتھہٕ سپدن والہِ گناہ نِش۔
\v 12 امہِ پتہٕ رود پیلاطس برابر کوشش کران یسوعؔ سٕنٛدِ یلہٕ گژھنہٕ باپتھ۔ مگر یہُودؠ سردار رودؠ چِکہٕ دِوان، "یوٚدوے ژٕ یہِ انسان یلہٕ تراوہن، تیٚلہِ چھُکھ نہٕ ژٕ قیصر سُنٛد وفادار۔ بادشاہ آسنُک دعوا دار چُھ قیصر سُنٛد مخٲلف۔\f + \fr 19‏:12 \ft قیصر مطلب چُھ رومُکؔ سلطان\f*
\v 13 اوے ییٚلہِ پیلاطسن یہِ بوز تٔمؠ دیُت حکم پننٮ۪ن سِپہن یسوعؔ انٛدرٕ پٮ۪ٹھٕ نٮ۪بر کڈنُک۔ اوٕ پتہٕ بیوٹھ پیلاطس فٲصلہٕ دِنہٕ باپتھ پتھر پننہِ مخصوس جایہِ یتہِ پٮ۪ٹھ سُہ پنٕنؠ فٲصلہٕ بوزٕناوان اوس۔ اتھ ٲسؠ لوٗکھ ونان "کنہِ ژکل" یعنی یہُودؠ عِبرٲنؠ زبٲنؠ منٛز گبتا
\v 14 یہِ اوس عید فسع برونٛٹھ اکھ دوٚہہ دوپہرٕ برونٹھ ییٚلہِ یہُودؠ یم خاص دوٚہہ مناونٕچ تیٲری کران ٲسؠ۔ یہِ اوس تقریباً دُپہر پیلاطسن ووٚن سردارن، "وُچھِو۔ یہِ گو تُہنٛد بادشاہ!"
\v 15 تِمو دِژٕ اورٕ چِکہٕ، "مٲرؠ وُن، مٲرؠ وُن، مٲرؠ وُن۔ "دِیہ ہن پھییہ۔ پیلاطسن تُلؠ یِم رٮ۪ژھِ، "دِما بہٕ تہنٛدِس رازس پھٲسؠ دِنُک حکم پننٮ۪ن سِپہن۔ "حکمران یہُودیو ووٚنُس اورٕ، "بس چُھ قیصر سون بادشاہ۔"
\v 16 چونکہِ تِمو ووٚن یہِ پیلاطسن دیُت حکم سپہن یسوعؔس صلیبہِ پؠٹھ کھالنُکھ۔ یسوعؔ نیٚو سِپہو پانس سٟتؠ رٔٹِتھ تاکہِ أمِس کھالن صلیبس
\v 17 یسوعؔ دراو پنُن دار نکھس پانے تُلِتھ تتھ جایہِ کُن یتھ لوٗکھ ٲسؠ ونان گُلگتا۔ یعنی کلہٕ کھوپرِ ہنٛز جاے۔ پننہِ عِبرٲنؠ زبٲنؠ منٛز۔
\v 18 سِپہو دِژ أمِس أتھؠ جایہِ صلیب۔ تِمو کھٲلؠ بیٚیہِ زٕ نفر تمس سٟتؠ بیون بیون صلیبن پؠٹھ۔ یِم دونوے ٲسؠ یسوعس دٔچِھنؠ تہٕ کھوورؠ کِنؠ، تہٕ یسوع اوس منز باگ۔
\v 19 پیلاطسن دیُت کس تام یہِ حکم تہِ زِ سُہ لٮ۪کھہِ اکھ تحریر کتبہ تہٕ لاگہِ اتھ یسوعؔ سنٛز صلیبہِ۔ أمؠ شخصن لیٚوکھ اتھ یسوعؔ ناصری۔ یہودٮ۪ن ہُنٛد بادشاہ۔
\v 20 بسیار یہُودیو پوٚر یہِ تحریر تکیازِ یہِ جاے یتہِ سپہو یسوعؔ دارس کھول ٲس یروشلم شہرس نکھے۔ بیٚیہِ ٲس یہِ امے بے ناوٕ شخصن یہِ تحریر تِمن ترٮ۪ن زبانن منٛز لیچھمٕژ یِمہٕ یہُودؠ، رومی تہٕ یونٲنؠ بولان ٲسؠ۔
\v 21 حکمران یہُودؠ کاہن آے بیٚیہِ واپس پیلاطسس نِش تہٕ ووٚن ہس، "ژےٚ اوسُے نہٕ لیٚکھُن تتھ پٮ۪ٹھ یہندٮ۪ن ہُنٛد بادشاہ بلکہِ اوسُے لیٚکھُن یمؠ نفرن ووٚن زِ بہٕ چُھس یہودٮ۪ن ہُنٛد بادشاہ۔
\v 22 پیلاطسن ونُکھ، "یہِ مےٚ پننٮ۪ن سِپہن لیٚکھنُک حکم دیُت، تِمو لیٚوکھ۔ وۅنؠ بدلاوٕ نہٕ بہٕ تہِ۔
\v 23 وۅنؠ ییٚلہِ سپہو یسوعؔ صلیبس کھول، تِمو نی تمسنٛدؠ پلو تہٕ کرٮ۪کھ اتھ ژور تِلمہٕ۔ اکھ اکھ تِلِم پرٮ۪تھ سِپہس بٲگراونہٕ باپتھ۔ وۅنؠ گو تِمو بچوو امسُنٛد پٮ۪ٹھ پلو تھووُکھ الگ۔ وووُرؠ اوس یہِ پیٚٹھؠ پلو أکسےٕ کپر ٹُکرس منٛز بنومُت کُنہِ ٹیبہِ ورٲے۔
\v 24 اوے ووٚن سِپہو پانہٕ وٲنؠ، "یتھ پلوس کرو نہٕ ٹُکرٕ۔ بلکہِ تراوو چیرِ ادٕ یس یہٕ ییہِ تہٕ تس یہِ پلو گو تٔسؠ یمسٕنٛدِ ناوٕ نیرِ۔ "یہِ سپُد اوٕ کِنؠ زِ تاکہِ صحیفن ہُنٛد یہِ لیکھ نیرِ پوٚز۔ تِمو بٲگرٲوؠ میٲنؠ پلو پانہٕ وٲنؠ تہٕ تراوٮ۪کھ چیرِ اکہِ پلوٕ باپتھ۔\f + \fr 19‏:24 \ft زبور 22:18\f*
\v 25 یسوعؔ سنٛز موج، ماجہِ ہنٛز بیٚنہِ مری، کلوپاس سنٛز آشِنؠ تہٕ مریم مگدلِینی آسہٕ تتھ صلیبس صلیبہِ نکھے وۅدنؠ یتھ پٮ۪ٹھ یسوعؔ ترۅدِ اوس۔
\v 26 ییٚلہِ یسوعؔن پنٕنؠ موج تہٕ یوحنا شٲگرد یمِس سُہ لول بران اوس أتی وُچھ تٔمؠ ووٚن ماجہِ، "محترم خوتون۔ یہِ گو سُہ شخص یُس چون خیال تھاوِ أکِس نیٚچوؠ سٕنٛدؠ پٲٹھؠ۔
\v 27 تہٕ ووٚنُن یوحناؔ شٲگردس۔ یہِ چھےٚ سۅ یمسنٛد خیال تھاوکھ پننہِ ماجہِ ہنٛدؠ پٲٹھؠ۔ امہ گرِ پٮ۪ٹھٕ نِیہِ جانن سۅ مریم پنُن گرٕ پانس سٟتؠ روزنہِ۔
\v 28 کینٛژیو ژِہیٚو پتہٕ ووٚن یسوعؔ، "یمہِ کِنؠ زِ سُہ اوس زانان زِ تٔمؠ انزروو تہِ سورےٕ یمہِ باپتھ خداین سُہ یور سوزمُت اوس تہٕ بیاکھ اکھ پیشن گوییی پٔز بناونہٕ موجُب! "مےٚ لٔجؠ تریش"
\v 29 کمؠ تام اوس نکھے اکھ جگ تھومُت تیتھ منٛز وسِتھ شراب بٔرِتھ اوس تہٕ یسوعؔ اوس تریشہٕ ہوٚت۔ اوے اوٚن اکؠ سپہو اکہِ نرکانہ کُلِچ لٔنٛڈ تہٕ تھووُن اتھ پٮ۪ٹھ سپنج تہٕ بُڈنووُن أتھؠ سستہٕ شرابس منٛز تہٕ پِلنووُن یسوعؔس ٲسس کُن۔\f + \fr 19‏:29 \ft زبور 69:21\f*
\v 30 یسوعؔن ژوٚہہ یہِ سستہٕ شراب تہٕ ووٚنُن، "مےٚ کوٚر سورےٕ مکمل۔ سورےٕ یمہِ باپتھ بہٕ یور آس تہٕ نۅمرووُم کلہٕ بوٚن کُن تہٕ سوزُن پنُن جان واپس۔
\v 31 یہُودؠ سردارو ووٚن امہِ پتہٕ پیلاطسس پنیٚن سپہن حکم دٕنہٕ باپتھ صلیبو پٮ۪ٹھٕ ترۅدِ ترینوٕنؠ نفرن ہنٛزٕ زنٛگہٕ پھُٹراونُک\f + \fr 19‏:31 \ft شُکروار\f*۔ تاکہِ یِم نفر مرن ؤلؠ ؤلؠ تہٕ یہنٛزٕ لاشہٕ تُلنہٕ خٲطرٕ وُژھ کرنہٕ باپتھ تاکہِ یِم روزن نہٕ صلیبن پؠٹھ یہُودینؔ ہنٛدِس آرام کس دوٚہس تام۔ تِمو ووٚن یہِ أمِس اوٕ کِنؠ یہِ اوس سُہ دوٚہہ ییٚلہِ یہُودؠ ٲسؠ آوٕرؠ عید فسع مناونچہِ تیٲری منٛز۔ تہٕ اوے اوس یہِ آرامُک دوٚہہ۔ یِمن دوٚہُن دوران موٚردٕ صلیبن پٮ۪ٹھ تھاوُن ٲس یہُودؠ شریعتچ خلاف ورزی۔ چونکہِ دویِم دوٚہہ تہِ اوس آرامُک دوٚہہ، یہِ دوٚہہ تہِ اوس اہم۔\f + \fr 19‏:31 \ft سردار کاہن۔ مرقُس 15:42، تثنِیہ شرع 21:22، 23\f*
\v 32 اوے آے سِپاہ تہٕ پھُٹراوٮ۪کھ گۅڈنکِس اویزان نفرس زنٛگہٕ یُس یسوعؔس سٟتؠ دارس کھالنہٕ آمُت یتہِ پھُٹراوٮ۪کھ دوٚیمِس یسوعؔس لرِ نفرس تہِ۔
\v 33 وۅنؠ گو یُتھےٕ تِم یسوعؔس نِش وٲتؠ تِمو وُچھ سُہ بے جان۔ اوے تہِ پھُٹراوٮ۪کھ نہٕ امسنٛزٕ زنٛگہٕ۔
\v 34 امہِ بدلہٕ وول اکؠ سپہن یسوعؔس ۂلِس نیزٕ تہٕ اورٕ دراو چھۅکہٕ پٮ۪ٹھٕ رتھ تہٕ آب۔
\v 35 بہٕ، جان چُھس امہِ واقہٕ ہُک پانہٕ شٲہد تہٕ چُھس اتھ تصدیق کران تہٕ یتھ بہٕ تصدیق کران چُھس چُھ پوٚز۔ مےٚ چُھ پوٗرٕ یقین زِ یہِ بہٕ ونان چُھس تی چُھ پوٚز۔ بہٕ چُھس ونان یہ تاکہِ توٚہؠ تہِ کرِیٚو یسوعؔس پٮ۪ٹھ پژھ۔
\v 36 یِمہٕ کتھٕ سپزٕ یسوعؔ سٕنٛدِس بدنس سٟتؠ اوٕ کِنؠ تاکہِ صحیفن ہُند یہِ تحریر نیرِ پوٚز "کانٛہہ پھُٹراونہٕ تمؠ سنٛزٕ زنٛگہٕ۔"\f + \fr 19‏:36 \ft خروج 12:46، گرینٛد 9:12، زبور 34:20\f*
\v 37 یِم صحیفہٕ چھِ بیاکھ پیشن گویی تہِ کران۔ تِم وچُھن أمِس شخصس کُن یِمو چھۅکھ لوے۔\f + \fr 19‏:37 \ft ذکریاہ 12:10\f*
\v 38 ییٚلہِ یِم کِتھہٕ سپدییہِ ارِمتیہ شہرکؠ اکؠ یوسف ناوکؠ شخصن ووٚن پیلاطسس تمِس یسوعؔ سُنٛد جسم تلنُک اجازت دِنہٕ باپت۔ تٔمؠ کوٚر یہِ تکیازِ سُہ اوس یسوعؔ سُنٛد اکہ شٲگرد۔ وۅنؠ گو تٔمؠ ؤنؠ نہٕ یہِ کتھ کٲنسے تکیازِ سُہ اوس کھوٚژان باقےٕ یہُودؠ سردارن۔ پیلاطسن دیُت یوسفسؔ اجازت یسوعؔ سُنٛد جسم تُلنہٕ باپتھ۔ اوے گو یوسف تہٕ اوٚنُن بامل پنُن غرض۔
\v 39 نِیکُدِیمُسؔ یُس اکہِ وِزِ رٲژ منٛز یسوعؔس نِش آمُت اوس کتھ کرنہِ تہِ آو 33 کلو مر تہٕ عود پانہٕ وٲنؠ ملنٲوتھ ہٮ۪تھ یسوعؔ سٕنٛدِس جسمس ملنہٕ باپتھ۔
\v 40 تِمو تُل یسوعؔ سُنٛد جسم تہٕ ووٚلہس سوٗتؠ کپُر تہٕ موٚلہس کافور تہٕ عود ننگہٕ بدنس۔ تِمو کوٚر یتہِ یہُودؠ دفناون رسمو حسابہٕ۔
\v 41 اتھؠ صلیب دِنچہِ جایہِ نکھہٕ اوس اکھ باغ۔ اتھؠ باغس منٛز ٲسؠ تازٕ کھننہٕ آمٕژ قبر۔ وُنہٕ اوسنہٕ اتھ منٛز کانٛہہ تہِ دفن کرنہٕ آمُت۔
\v 42 اوے ترٲوؠ تِمو یسوع أتھؠ مقبرس منٛز تکیازِ یہِ جاے ٲس نکھے۔ تہٕ اوٕ کِنؠ تہِ یہِ اوس یہُودینؔ عید فسع مناونچہِ تیٲری ہُنٛد دوٚہہ۔ اوے تہِ اوس یِمن یہِ دفناونُک رسم سریہِ لوسنہٕ برونٛہےٕ انٛد واتناون۔
\c 20
\p
\v 1 ہفتکہِ گۅڈنکہِ دوٚہہ آتھوارِ وٲژ گاش پھۅلنے مریم مگدلِینی مقبرس پٮ۪ٹھ یتہِ یسوعؔ تھاونہٕ آمُت اوس تٔمؠ وُچھ زِ کمؠ تام ٲس مقبرچہ اژنچہِ جایہِ ہنٛز کٔنؠ ڈٲجمٕژ۔
\v 2 سۅ دورییہِ ؤژھ تتھ جایہِ کُن یتہِ شمعون پطرس تہٕ بیاکھ شٲگرد جان یمِس یسوعؔ لول کران اوس ووٚن تِمن۔ گلوتام چھےٚ خداوند یسوعؔ سُنٛد جسم مقبر منٛزٕ کٔڈِتھ نِمُت تہٕ اسہِ چھنہٕ خبرےٕ تھووُکھ کَتہِ!
\v 3 ییٚلہِ تِمو یہِ بوز پطرس تہٕ یوحنا شٲگرد دراے پننہِ امہِ روزن جایہِ پٮ۪ٹھٕ مقبرس کُن۔
\v 4 تِم ٲسؠ دوٚنوے دوران مگر یوحنا شٲگرد اوس ہنا پطرس سٕنٛدِ کھۅتہٕ وُژھ دٕوان تہٕ ووت مقبرس پٮ۪ٹھ برونٛہےٕ۔
\v 5 ییٚلہِ اتہِ جان بوٚن نمیوو تہٕ مقبرس اندر وچُھن سوٗتؠ کپرچہِ تلمہٕ یِم یسوعؔ سُنٛد جسم ولنہٕ باپتھ ورتاونہٕ آمژٕ آسہٕ أتی پتھرِس پٮ۪ٹھ یتنس یسوعؔ سُنٛد شریر تھاونہٕ آمُت اوس۔ مگر سُہ ژاو نہٕ مقبرس اندر۔
\v 6 شمعون پطرس اوس جانس پتہٕ پتے دوران۔ سُہ تہِ ووت اوٚت تہٕ ژاو مقبرس منٛز۔ تٔمؠ تہِ وُچھ سوتی کپرچہِ تِلمہٕ اتؠ یتنس یسوعؔ سُنٛد شریر تھاونہٕ آمُت۔
\v 7 پطرسن وُچھ سُہ کلہٕ وولت تہٕ یس تس کٔمؠ تام کلس گنڈمُت اوس۔ یہِ کلہٕ وولت اوس نَہ سوتی کپر تِلمن سٟتؠ بلکہ کٔمؠ تام اوس یہِ تہہ کٔرِتھ الگ تھوومُت۔
\v 8 امہِ پتہٕ ژاو یوحنا، تہٕ سُہ شٲگرد یُس پطرسس برونٛہےٕ مقبرس پٮ۪ٹھ ووتمُت اوس اندر مقبرس منٛز۔ تٔمؠ وُچھ یمہٕ سٲری چیز تہٕ زونُن زِ یسوعؔ چُھ مردو منزٕ دُبارٕ زندٕ گومُت۔
\v 9 امہِ وِزِ گونہٕ یِمن زۅنےٕ نبین ہنٛزِ تتھ کتھِ کُن یۅسہ تِمو یسوعؔس متعلق پننٮ۪ن مقدس کتابن منٛز لیٚکھِتھ تھٲومٕژ چھے یعنی یسوعؔس چُھ مرن تہٕ پتہٕ دُبارٕ زندٕ سپدن۔\f + \fr 20‏:9 \ft زبور 16:10\f*
\v 10 شٲگرد آے اوٕ پتہٕ واپس پننہِ روزن جایہِ کُن یروشلم شہرس منٛز
\v 11 مریم مگدلِینی ٲس اوٚش ہاران سۅ نمییہِ بوٚن تہٕ وچُھن مقبرس منٛز۔
\v 12 تٔمؠ وُچھ زِ فرشتہٕ سفید پوشاکس منٛز تِم ٲسؠ تٔتھؠ جایہِ کھڑا یتہِ نس یسوعؔ سُنٛد کلہٕ اوس بیاکھ فرشتہٕ اوس ۅدٕنؠ یتنس یسوعؔ سنٛدؠ کھوٚر ٲسؠ۔
\v 13 تِمو پرُژھ أمِس، "خاتون، ژٕ کیازِ ودان؟" تمہِ ونُکھ یورٕ، "بہٕ چھس ودان اوٕ کِنؠ زِ خبر کمو چُھ میون خداوند یمہِ مقبرٕ منٛزٕ کوڈمُت تہٕ خبر چھم نہٕ تھووکھ کتھ جایہِ۔
\v 14 ییٚلہِ امہِ یہِ ووٚن۔ سۅ پھیر پتھ کُن تہٕ وچُھن کُستام وۅدنؠ یہِ اوس یسوعؔ مگر أمؠ پرزٕنوو نہٕ سُہ۔
\v 15 أمؠ پرژھُس، "خاتون ژٕ کیازِ یوٗت اوٚش ہاران؟" ژٕ ژھاران کس۔ تمہِ زون زِ یہِ پرژھن وول چُھ باغوان۔ اوے ووننس یورٕ، "جناب، یوٚدوے توٚہؠ یسوعؔ سُنٛد جسم ڈولمُت چُھو مےٚ ؤنؠ تو تھووُوٕ کتہِ۔ بہٕ رٹن سُہ واپس تہٕ کرن دُبارٕ اوسودٕ۔"
\v 16 "مریم" یسوعؔن دیُت أمِس ناد ناو ہٮ۪تھ۔ تٔمؠ وُچھ أمِس کُن بیٚیہِ تہٕ ووننس "ربی" عِبرٲنؠ زبٲنؠ منٛز استاد۔
\v 17 یسوعؔن ووٚن أمِس، "مٕہ یہِ مےٚ النہٕ ولنہٕ۔ وُنہِ چُھ مےٚ پننس ببس نِش آسمانس پٮ۪ٹھ گژھنے۔ نیر ون میانٮ۪ن شٲگردن تہٕ باین زِ بہٕ چُھس پننِس خدایس پننِس ببس نِش تیار گژھنس۔ یُس تُہنٛد تہٕ خدا چُھ تہٕ بب تہِ۔
\v 18 مریم مگدلِینی دراے تہٕ ووٚنُن یسوعؔ سنٛدٮ۪ن شٲگردن۔ مےٚ وُچھ خداوند دیدمان تہٕ ووننکھ یہِ تس یسوعؔن ووٚنمُت اوس۔
\v 19 امے آتھوارِ دوٚہہ شامن شاگردو ٲسؠ پننہِ روزن جاین ہنٛدؠ بر بنٛد کرمٕتؠ تکیازِ تِم ٲسؠ یہُودؠ سردارن کھوٚژان۔ یسوعؔ گو یِمن منٛزس ظٲہِر تہٕ ووننکھ میون خدا بخشیٚو سلامتی۔
\v 20 یہِ ؤنِتھ ہٲونکھ اتھن تہٕ لرِ کانہِ ہنٛدؠ چھۅکھ۔ شٲگرد گے یسوعؔس وُچِھتھ خوش۔
\v 21 امہِ پتہٕ ووننکھ یسوعؔن دویمہِ پھرِ میون خدا بخشیو سلامتی۔ بہٕ چُھسو توٚہؠ دنیہس کُن سوزان یتھٕ پٲٹھؠ بہٕ پنٕنؠ مٲلؠ سوزُس۔
\v 22 یہِ ؤنِتھ یسوعؔ لوے تمن پھوٚکھ رٹو یہِ روح القدس سمبٲلو یہِ پاک روح
\v 23 یوٚدوے توٚہؠ کٲنٛسہِ ہنٛدؠ گناہ بخشو۔ خدا بخشہ تمِس انسانس تسنٛدؠ گناہ۔ یوٚدوے زن توٚہؠ بخشو نہٕ کٲنٛسہِ گناہ۔ خدا تہِ بخشہِ نہٕ تس گناہ۔
\v 24 تُوما، بہَو شاگردو منٛزٕ اکھ یمِس "دُکڑ" تہِ ونان ٲسؠ اوس نہٕ باقین شٲگردن سٟتؠ تمہِ ساعتہٕ ییٚلہ یسوع تِمن درمیان اوس۔
\v 25 اوے ووٚن باقیو شاگردو أمِس زِ "اسہِ وُچھ یسوعؔ دیدمان" وۅنؠ گو تٔمؠ ونُکھ اورٕ، "بہٕ کرٕ تیٚلہِ پژھ زِ توٚہؠ وُچھوون یسوعؔ ییٚلہِ بہٕ امسنٛدِس اتھن ہنٛدٮ۪ن تمن گدٮ۪ن منٛز اونٛگجہِ تراوِ یمہٕ تس کلبو سٟتؠ کرنہٕ آیہِ تہٕ تمؠ سنٛز لرِکانہِ ہنٛدِس نیزٕ سٟتؠ کرنہٕ آمتِس چھۅکس منٛز اتھہٕ ترٲوِتھ ہیٚکہِ۔
\v 26 ٲٹھ دوٚہہ پتہٕ ٲسؠ یسوعؔ سنٛدؠ شٲگرد گرس منٛز تہٕ تُوما تہِ اوس یمنےٕ سٟتؠ۔ یوٚدوے زن تِمو از تہِ برن تٲرؠ ٲسؠ تھٲوؠ مٕتؠ یسوعؔ آو تہٕ گو یِمن منزباگ کھڑا۔ أمؠ ووٚن یِمن، "خدا دی نو سلامتی:"
\v 27 امہِ پتہٕ ووٚنُن تُوماہس، "تراو پنٕنؠ اونگج یمن گدٮ۪ن منٛز تہٕ وُچھ یِم میانہِ اتھٕکؠ گدؠ۔ تہٕ تھاو پنُن اتھہٕ میٲنہِ لرِ کانہِ پٮ۪ٹھ تہٕ تراو شک کرُن زِ بہٕ گوس بیٚیہِ زندٕ تہٕ کرِ پژھ زِ یہِ چُھ پوٚز۔"
\v 28 تُوماہن ووٚنُس، "توٚہؠ چُھو میون خداوند تہٕ میون خدا!"
\v 29 یسوعؔن ووٚنُس، "وۅنؠ کٔرتھ ژےٚ پژھ بہٕ بیٚیہِ زندٕ سپدِتھ تکیازِ ژےٚ وُچھتھس بہٕ وۅنؠ دیدمان۔ خدا کٔرِن تِمن پٮ۪ٹھ فضل یِمو نہٕ بہٕ وُچھس مگر پژھ کٔرٕکھ زِ بہٕ گوس دُبارٕ زندٕ
\v 30 یسوعؔن کٔرؠ پننٮ۪ن شٲگردن ہنٛزِ اتہِ موجودگی منٛزےٕ بیٚیہِ تہِ کینٛہہ معجزٕ مگر مےٚ لیٚکھؠ نہٕ تِم پننہِ کتابہِ منٛز۔
\v 31 وۅنؠ گو مےٚ لیوکھ یِمن ہُنٛد تاکہِ توٚہؠ کٔریو پژھ زِ یسوعؔ چُھ مسیحؔ چُھ نجات دِنہٕ وول خدایہِ سُنٛد نیٚچو۔ مےٚ لیٚوکھ یمن متعلق تاکہِ توٚہؠ کٔریٚو پژھ زِ یسوعؔ چُھ مسیحؔ۔ توٚہہِ میلہِ زندگی تمسنٛدِ سٟتؠ۔
\c 21
\p
\v 1 یِمو واقہو پتہٕ گو یسوعؔ پننٮ۪ن شٲگردن پٮ۪ٹھ بیٚیہِ اکہِ دوٚہہ ظٲہر تبریاس ناوکِس سۅدرس پٮ۪ٹھ یتھ گلیلی ہُنٛد سُدر تہِ ونان چھِ۔ یہِ سپدیاو یمہِ آیہِ۔
\v 2 شمعون پطرس، تُوما یمِس دوکُر تہِ ونان چھِ، نتن ایلؔ یُس گلیلی علاقہٕ کہِ قصبہٕ قانا پٮ۪ٹھ آمُت اوس، زبیدیؔ سنٛدؠ نیٚچوؠ یعقوبؔ تہٕ یوحناؔ تہٕ بیٚہِ زٕ یسوعؔ سنٛدؠ شٲگرد ٲسؠ یِکہٕ وٹہٕ۔
\v 3 شمعون پطرسن ووٚن باقین شٲگردن، "بہٕ گژھو کینٛہہ گاڈٕ رٹنہِ۔ "تِمو ووٚنُس، "أسؠ تہِ یِمو ژےٚ سٟتؠ" تِم دراے سٲری تہٕ کھٔتؠ أکِس ناوِ رودؠ گاڈٕ رٹنچہِ کوششہِ منٛز۔ مگر امہِ رٲژ ہٮ۪چ نہٕ یِمو کانٛہہ گاڈ رٔٹِتھ۔
\v 4 دویمہِ دوٚہہ گاش پھۅلوُن اوس یسوعؔ سۅدرٕ بٔٹھِس پٮ۪ٹھ وۅدٕنؠ مگر شٲگرد یِم گاڈٕ رٹنہِ درامٕتؠ ٲسؠ رودؠ امہِ نِش بے خبر۔
\v 5 یسوعؔن دیُت یِمن ناد، "میانیو یارو۔ توٚہہِ چُھو نہٕ کانٛہہ گاڈ تہِ رٔٹمٕژ۔ چُھوا" تِمو ووٚنُس، "اسہِ چُھنہ۔"
\v 6 تٔمؠ ونُکھ "پنُن زال ترٲیِو ناوٕ دٔچھنہِ انٛدٕ تہٕ توٚہؠ ہیٚکِو گاڈٕ رٔٹِتھ۔ "یِمو کوٚر یی تہٕ رچٮ۪کھ بسیار گاڈٕ مگر تِم ہیٚکؠ نہٕ زالس واپس لٔمِتھ
\v 7 بہٕ، سُہ شٲگرد یمِس یسوعؔن لول بوٚر، وۅتُھس پطرسن، "یہِ چھُے خداوند یسوعؔ۔ اوے ییٚلہِ شمعون پطرسن یہِ بوز تٔمؠ لوگ پنُن کوٹ یُس تٔمؠ کامہِ باپتھ کوٚڈمُت اوس تہٕ لٲیِن آبس وۅٹھ بٹھس کُن ژھانٹہِ ترنہٕ باپت۔
\v 8 باقےٕ گاڈٕ رٹنہِ درامٕتؠ شٲگرد آے ناوِ منٛز بٔٹھِس کُن گاڈو تروپتھ زالس ناوِ پتہٕ پتہٕ لمان۔ تِم ٲسؠ نہٕ جھیلہٕ کہ بٹھہِ دوٗر زیادٕ، صرف نمتھ میٹر دوٗر۔
\v 9 ییٚلہِ تِم بٔٹھِس پٮ۪ٹھ وٲتؠ، تِمو وُچھ نار دزان یُس یسوعؔن زولمُت اوس یتھ پٮ۪ٹھ یسوعؔ گاڈٕ بُزان اوس اتَتھ اوس اکھتُے اکھ ژوچہِ ٹُکرٕ تہِ موجود۔
\v 10 یسوعؔم ونُکھ، "گژھیٚو انِو کینٛہہ گاڈٕ یمہٕ توٚہہِ ؤنؠ رچیٚو۔
\v 11 اوے دراو شمعون پطرس واپس ناوِ ہنحدِس دمس کُن تہٕ اوٚنُن زال لٔمِتھ بٔٹھِس کُن۔ یہِ اوس 153 بجو گاڈو سٟتؠ بٔرِتھ۔ ییژٕ گاڈٕ ٲسِتھ تہِ آو نہٕ زال پھُٹِتھ۔
\v 12 یسوعؔن ونُکھ، "ولیٚو پٔکیٚو یورکُن تہٕ کٔرِو ناشتہٕ!" شاگردو منٛزٕ کوٚر نہِ اکؠ تہِ جُرت۔ شاگردو منٛزٕ ووٚتھ نہٕ أکِس تہِ تار زِ پرژھ ہس، "توٚہؠ کم چُھو۔ "تِم ٲسؠ زانان زِ سُہ چُھ یسوعؔ خداوند۔
\v 13 یسوعؔ آو تہٕ تجِن ژوٚٹ تہٕ پلنٲوکھ گاڈن سٟتؠ تہٕ کوٚرُن یی۔
\v 14 خدایہِ سٕنٛدِ طرفہٕ زندٕ کرنہٕ پتہٕ اوس تریٚمہِ پھرِ یسوعؔ پننٮ۪ن شٲگردن منٛز ظٲہر گوٚمُت
\v 15 ییٚلہِ تِمو اڈٕ کوج کھیٚتھ مۅکلوو یسوعؔن پرُژھ شمعون پطرسس، "شمعون، ژٕ چُھکھا مےٚ یِمو ساروٕے کھۅتہٕ زیادٕ لول بران:" پطرسن ووٚنُس، "آ! خداوند ژےٚ چھے خبر بہٕ چُھسے ژےٚ لول بران:" یسوعؔن ووٚنُس، "یِمن ہُنٛد خیال تھٲوزِ یِم مےٚ پٮ۪ٹھ پژھ تھاون چھِ:"\f + \fr 21‏:15 \ft "میانین پٲروکارن ہند تھاو خیال زن تہِ چھِ تَم تیرؠ۔"\f*
\v 16 یسوعؔن ووٚنُس مزید، "جان سنٛدِ شمعونہٕ ژٕ چُھکھا مےٚ لول کران؟" أمؠ ووٚنُس اورٕ، "خداوند! آ۔ توٚہہِ چُھو پانس خبر زِ بہٕ چُھسے ژےٚ لول کران" یسوعؔن ووٚنُس، "یِمن ہُنٛد خیال تھٲوزِ یِمن مےٚ پٮ۪ٹھ پژھ چھےٚ:"
\v 17 یسوعؔن پرُژھ تریٚمہِ پھرِ، "یوحناؔ سنٛدِ شمعونہٕ، ژٕ چُھکھا مےٚ لول کران۔ پطرس سپُد دۅکھٕ زد زِ یسوعؔن پرُژھ أمِس بار بار ترییہٕ پھرِ زِ سُہ چھا تمِس لول کران۔ پطرسن ونُس خداوند ژےٚ چھے سٲری خبر۔ ژےٚ چھے خبر زِ بہٕ چُھسے ژےٚ لول کران۔ یسوعؔن ووٚنُس، "تہنٛدؠ خیال تھٲوؠ زِ یِم مےٚ پٮ۪ٹھ پژھ تھاوان چھِ۔
\v 18 بہٕ چُھسے ونان پوٚز۔ ییٚلہِ ژٕ جوان اوسُکھ ژٕ اوسُکھ پنٕنؠ پلو پانے لاگان تہٕ یوٚت یژھکھ توٚت نیرہکھ۔ وۅنؠ گو ییٚلہِ ژٕ بوٚڈ گژھکھ ژٕ رٹکھ پننہِ شریرٕ نِشہ پنٕنؠ اتھہٕ پتھ تہٕ بدل کانٛہہ لٲگی ژےٚ پلو تہٕ نی پانس سٟتؠ یوٚت ژٕ گژھُن یژھان آسکھ تہٕ۔
\v 19 یسوعؔن ووٚن ہاونہٕ باپتھ زِ پطرس کِتھہٕ پٲٹھؠ مرِ تہٕ خدایہِ سنٛز عظمت ہاونہٕ باپتھ۔ اوٕ پتہ ووٚنُن پطرسس، "ؤلِو بٔنِو میٲنؠ شٲگرد"
\v 20 ییٚلہِ پطرس پتھ کُن پھیور، تٔمؠ وُچھ جان شٲگرد یمِس یسوعؔ لول کران اوس۔ پتہٕ پتہٕ پکان جان اوس نفر یُس کال کھیٚنہٕ وِزِ یسوعؔ ہس کُن نمیو۔ یسوعؔ سٕنٛدِ مرنہٕ برونٛہہ تہِ اوسنس پرُژھمُت، "خداوند ژےٚ کُس کری دغا۔
\v 21 اوے ییٚلہِ پطرسن جان وُچھ تٔمؠ پرُژھ یسوعؔس، "خداوند۔ یمِس کیاہ چُھ سپدن وول:"
\v 22 یسوعؔن ووٚنُس، "یوٚدوے بہٕ پننس واپس ینس تام امسُنٛد زندٕ روزُن یژھ، تتھ سٟتؠ چھی نہٕ ژےٚ کینٛہہ یوتام چون تعلق چُھ ژٕ روز ہتھٔے میون شٲگرد۔ یتھٕ پٲٹھؠ زن ژٕ میون شٲگرد روزکھ"
\v 23 چونکہ یسوعؔن ووٚن یہِ، شٲگردن منٛز گییہِ افوا زِ یوحنا چُھنہٕ زانہٛہ تہِ مرن وول زِ تِم روٗد یہِ ایماندارن منز دُھراوان۔ وۅنؠ گو یسوعؔن ووٚن نہٕ پطرسس زِ یوحنا مرِ نہٕ زانہٛہ بلکہِ ووٚننس یوٚدوے بہٕ یژھٕ امسُنٛد زندٕ روزُن یوٚتام بہٕ واپس یِمہٕ۔
\v 24 بہٕ، یوحنا، یسوعؔ سُنٛد شٲگرد چُھس یِمن کتھن تصدیق کران تہٕ مےٚ ہٮ۪چھہٕ یِمہٕ کتھٕ یتھ پننہِ کتابہِ منٛز۔ أسؠ چھِ زانان زِ یہِ مےٚ لیٚوکھ سُہ چُھ پوٚز۔
\v 25 یسوعؔن کٔرؠ بیٚیہِ تہِ کٟتؠ معجزٕ یِم یوٚدوے بہٕ اکہِ اکہِ لیکھہٕ بہٕ چُھس مانان زِ تیٚلہِ آسنہٕ سورےٕ دُنیا تہِ کٲفی سۅ کتاب لیٚکھنہٕ باپتھ۔
