\id DEU - DMT Kashmiri id
\toc1 اِستِثنا
\mt1 اِستِثنا
\c 1
\p
\v 1 اتھ کتابہِ منٛز چھےٚ تِمہ کتھہٕ لیکھنہٕ آمژٕ یمہٕ موسیٰؔ ہن تمام اسرائیل ین ونہِ ییٚلہ تِمو مشرقی یردنسؔ منٛز یردنؔ\f + \fr 1‏:1 \ft یردن دریاوٕ نٮ۪بٕرؠ، حوریب پہاڑ پٮ۪ٹھٕ 260 کلومیٹر دوٗر۔\f* کٮ۪ن ریگستٲنی مٲدانن منٛز سُوفؔ ناوچہِ جایہ نِش، یتھ اکہِ طرفہٕ فاران چُھ پنٕنؠ خٟمہٕ لٲگِتھ، درؠ یاے یردن کِس بٹھِس تہٕ درؠ یاوٕ کہِ دوٚیمہِ طرفہٕ طوفُل، لابن، حصیراتؔ تہٕ دیذہبٕکؠ شہر ہیٚتھ۔
\v 2 کوہہِ سیناؔ پٮ۪ٹھٕ قادِس برنِیع تانؠ ٲسؠ لوٗکھ عام طور کہَن دوٚہُن یہ صفر طے کران تہٕ تِم ٲسؠ یہِ صفر ادومؔ ناوٕ کہِ پہٲڑی علاقہٕ کِنؠ کڈان۔\f + \fr 1‏:2 \ft یہِ چُھ تقریبن ڈاے ہتھ پٮ۪ٹھٕ زٕ ہتھ ستَتھ کلومیٹر۔\f*\f + \fr 1‏:2 \ft قادس برنیاؔ اوس صحراوس منٛز اکھ نخلستان۔\f*
\p
\v 3 مِصرٕ منٛزٕ بنی اسرائیل نیرنہٕ پتہٕ ژتجی ؤہرؠ ووٚن موسیٰؔ ہن اسرائیلی لوٗکن تہِ سورےٕ یہِ یہُوواہنؔ تمِس حکم دیتمُت اوس۔
\v 4 یہ سپُد تمہِ وزِ ییٚلہِ تِمو عمور قومہٕ کِس بادشاہ سیحونؔ یُس حسبون تہٕ عوجؔ شہرس منٛز روزان اوس تہٕ بسنؔ علاقہٕ کِس بادشاہ عوجسؔ یُس عستارات تہٕ ادرعیؔ شہرن منٛز روزان اوس شکست دیُت۔
\p
\v 5 موسیٰؔ ہن ونہِ یمہٕ کتھٕ تِمن تمہِ وزِ ییٚلہ لوٗکھ یردن دریاوٕ کِس مشرِقس منٛز موآبؔ جایہ ٲسؠ۔ تِمو سمجھٲوؠ خدایہ سنٛدؠ ہِدایات۔ تِمو ووٚن تِمن یتھٕ کنؠ:
\p
\v 6 سٲنؠ خدا یہُوواہؔ ہن ووٚن اسہِ ییٚلہ أسؠ کوہہِ سیناؔہس\f + \fr 1‏:6 \ft "حوریب" چُھ کوہہِ سینا ہُک بیاکھ ناو۔\f* پٮ۪ٹھ ٲسؠ، "توٚہؠ رودِیو یتھ بالہٕ دامنَس تل واریہس کالس۔
\v 7 لہٰذا تھٲیو وۅنؠ سفر جٲری۔ ہُتھ پہٲڑی ملکس کُن یتہِ اموریؔ روزان چھِ تہٕ اندؠ پٔکؠ کٮ۪ن علاقن منٛز، یردن بٹھِ کٮ۪ن مٲدانن، پہٲڑی ملکن، مغربی پاتھلِس، جنوبی یہُودیہ کٮ۪ن بیابانن منٛز، رومؔ کٮ۪ن سمندری سٲحِلن منٛز، کنعان کِس سٲرسےٕ ملکس منٛز۔ لبنان کٮ۪ن پہاڑن تام تہٕ شمال مشرق کِس عظیم فرات دریاوس تام۔
\v 8 بہٕ دِمو سۅ زمین توٚہہِ۔ مےٚ، یہُوواہنؔ، اوس تُہنٛدٮ۪ن جدن ابراہامسؔ تہٕ اضحاقسؔ تہٕ یعقوبسؔ وعدہ کوٚرمُت زِ بہٕ دمہٕ تِمن تِہنٛدین اولادن یہ زمین۔ امہِ کِنؠ گٔژھیٚو تہٕ کٔریٚو اتھ پٮ۪ٹھ قبضہٕ۔"
\p
\v 9 موسیٰؔ ہن ووٚن لوٗکن یتہِ، "ییٚلہ أسؠ وُنہِ سیناؔ بالہٕ سےٕ پٮ۪ٹھ ٲسؠ، مےٚ ووٚن تُہنٛدین جد اجدادن، "میانہِ خٲطرٕ چھےٚ یہ اکھ بٔڈ کٲم توٚہہ سارنےٕ پٮ۪ٹھ حکومت کرٕنؠ۔ بہٕ ہیٚکہ نہٕ یہ خۅد پانہٕ کٔرِتھ۔
\v 10 سٲنؠ خدا یہُوواہنؔ بنٲوؠ أسؠ بنی اسرائیلی آسمان کٮ۪ن تارکن ہنٛدؠ پٲٹھؠ شُمارٕ روٚس۔\f + \fr 1‏:10 \ft عبر۔ 11:12\f*
\v 11 تہٕ مےٚ چھےٚ امید زِ یہُوواہؔ خدا یمسنٛز عبادت سٲنؠ جدٕاجداد کران ٲسؠ کرِ اسہِ تمہِ وزِ ساسہٕ گنہٕ زیادٕ تہٕ کرِ اسہِ برکت یتھٕ کنِؠ تٔمؠ وعدہ کوٚرمُت چُھ۔
\p
\v 12 مگر بہٕ ہیٚکہٕ نہٕ پزنہٕ پٲٹھؠ تُہنٛزن سارنےٕ شکایِژن تہٕ تنازن ہُنٛد ازالہٕ کٔرِتھ۔
\v 13 اوٕ کِنؠ ژٲرؠ ووکھ پننیٚو قبیلو منٛزٕ کینٛہہ تِتھؠ نفر یِم سونچ سمجھ وٲلؠ، عقلمنٛد تہٕ عزتہٕ وٲلؠ آسن۔ پتہٕ کرکھ بہٕ تِم تُہنٛدؠ قٲید مقرر۔"
\p
\v 14 تُہنٛدیٚو جدٕ اجداد ووٚن جواب، "یہ کینٛژھا توٚہہ تجویز کوٚرو، تہِ آسہ سانہِ باپتھ بہتر۔"
\p
\v 15 اوٕ کِنؠ تُلؠ مےٚ تِم عقلمنٛد تہٕ معزز نفر یمہٕ تہنٛدیٚو جدٕاجدادو تُہنٛدیٚو قبیلو منٛزٕ ژٲرؠ مٕتؠ ٲسؠ تہٕ کٔرم تُہنٛدؠ قٲید مقرر۔ کانٛہہ کوٚرم ساسس نفرن پٮ۪ٹھ حکومت کرنس مقرر، کانٛہہ ہتَس نفرس، کانٛہہ پنٛژہن نفرن تہٕ کانٛہہ کوٚرم دہَن نفرن پٮ۪ٹھ حکومت کرنس مقرر۔ مےٚ کٔرؠ تُہنٛدیٚو تمام قبیلو منٛزٕ دوٚیم افسر تہِ مقرر۔
\v 16 مےٚ دِتؠ تُہنٛدین قٲیدن ہِدایات زِ پننٮ۪ن لوٗکن منٛز موجود نیاے بوزیٚو۔ تِمن نیاین ہند کریو فٲصلہٕ، تِمن نیاین تہِ یمہ تُہنٛدٮ۪ن قریبی رشتہٕ دارن تہٕ پننٮ۪ن لوٗکن دویمٮ۪ن ملکہٕ کٮ۪ن لوٗکن سٟتؠ آسن یمہٕ توٚہہِ سٟتؠ روزان چھِ۔\f + \fr 1‏:16 \ft یونا۔ 7:51\f*
\p
\v 17 توٚہہ، پزِنہٕ کٲنٛسہِ ہُنٛد پاس رچُھن۔ توٚہہ پزِ غریب لوٗکن تہٕ امیر لوٗکن سٟتؠ یکسان سلوٗک کرُن۔ توٚہہِ پزِ نہٕ یمہِ کتھِ ہنٛز فِکر کرٕنؠ زِ کُس کیاہ سونچہِ، تکیازِ توٚہؠ انٛزرٲیو ماملات تِتھے پٲٹھؠ یتھٕ پٲٹھؠ خدا توٚہہِ نِش یژھان چُھ۔ اگر کانٛہہ نیاے پیچیدٕ آسہ تہٕ تُہنٛدِ دٔسؠ ہیٚکہِ نہٕ سُہ انٛزراونہٕ یِتھ تہٕ سُہ أنیٚو مےٚ نِش بہٕ انٛزراوٕ سُہ پانے۔"\f + \fr 1‏:17 \ft یعقوب۔ 2:9\f*
\v 18 تمہِ وقتہٕ ونہِ مےٚ توٚہہ بیٚیہِ تہِ واریاہ کتھٕ"\f + \fr 1‏:18 \ft گرنٛد۔ 13:1-33\f*
\p
\v 19 "پتہٕ، یتھٕ پٲٹھؠ زن سٲنؠ خدا یہُوواہنؔ اسہِ حکم دیتمُت اوس، دراے أسؠ کوہہِ سیناؔ پٮ۪ٹھٕ تمہِ بڈِ ریگستانہٕ منٛزؠ یُس سٮ۪ٹھاہ خطرناک چُھ، تمہِ پہٲڑی علاقچہِ وتہِ پٮ۪ٹھ یتہِ عمورٕکؠ لوٗکھ روزان چھِ۔ پتہٕ وٲتؠ أسؠ قادِس برنِیع۔
\p
\v 20 مےٚ ووٚن تُہنٛدین جدٕاجدادن، "وۅنؠ وٲتؠ أسؠ پہٲڑی علاقن منٛز یتہِ عمور لوٗکن ہنٛز جماتھ روزان چھےٚ۔ یہ چُھ تمہِ علاقُک حصہٕ یُس سون خدا یہُوواہؔ، یمسنٛز عبادت سٲنؠ جدٕاجداد کران چھِ، اسہِ دِوان چُھ۔
\v 21 یاد تھٲیو زِ سون خدا یہُوواہؔ چُھ یہ ملک اسہِ دِوان۔ ہرگِز مہٕ کھوٚژیٚو۔
\p
\v 22 مگر تُہنٛدؠ جدٕاجداد آے مےٚ نِش تہٕ ونُکھ، "گژھنہٕ برُونٛہہ پزن اسہِ توٚت کینٛہہ نفر سوزٕنؠ تاکہِ واپس یِتھ ونن تِم۔ توٚت گژھنہٕ باپتھ کۅسہٕ وتھ روزِ بہتر تہٕ تتہِ کٔمہِ قسمٕکؠ شہر چھِ۔"
\p
\v 23 مےٚ سونچ زِ یہ کرُن روزِ بہتر، اوٕ کِنؠ ژٲرؠ مےٚ پرٮ۪تھ کُنہِ قبیلہٕ منٛزٕ اکھ اکھ نفر
\v 24 تِم باہ نفر گےَ پہٲڑی علاقہٕ منٛزؠ اِسکالؔ وادی تانؠ تہٕ نیوکھ تمہِ سارے علاقُک جٲئزٕ۔
\p
\v 25 تِمو أنؠ اسہِ نِش تِمو میٚوو منٛزٕ کینٛہہ یمہٕ تتہِ وُچھِکھ۔ تِمو ؤنؠ یہ شیٚچھ زِ یۅسہ زمین سون خدا اسہِ دنہٕ وول چُھ، سۅ چھےٚ واریاہ بہتر۔
\p
\v 26 مگر تُہنٛدیٚو جدٕاجدادو کوٚر تور گژُھن تہٕ سُہ ملک فتح کرنہٕ نشہٕ انکار۔ تِمو کٔر تتھ خلاف بغاوت یُس سٲنؠ خدا یہُوواہنؔ تِمن کرنُک حکم دِژاو، تہٕ تمہٕ گےَ نہٕ تتھ ملکس منٛز۔
\v 27 تُہنٛدؠ جدٕاجداد رودؠ پننٮ۪ن خٟمن منٛز تہٕ کٔرکھ شکایتھ۔ تِمو ووٚن، "یہُوواہؔ چُھ اسہِ سٟتؠ نفرت کران۔ توے أنؠ تٔمؠ أسؠ مِصرٕ پٮ۪ٹھٕ یور تاکہ عمورچہٕ لُکہ جمٲژ کرن اسہِ تباہ۔
\v 28 أسؠ چھنہٕ تور گژُھن یژھان۔ یمہٕ نفر اسہِ تور سوزؠ تِمو کٔر اسہِ سٮ۪ٹھاہ حوصلہٕ شکنی۔ تِمو ووٚن اسہِ زِ تتِکؠ لوٗکھ چھِ سانہ کھوٚتہٕ زیادٕ زیٹھؠ تہٕ مضبوط تہٕ تہنٛدین شہرن ہنٛدؠ دیوار چھِ سٮ۪ٹھاہ تھدؠ۔ تِمو ووٚن یتہِ زِ تِمو وُچھ تتہِ دیو تہِ یِم عناقؔ سنٛدؠ اولاد چھِ۔\f + \fr 1‏:28 \ft اناکیم تہٕ باقی ٲسؠ وطنٕکؠ اصلی باشنٛدٕ، یم پننہٕ وطیرٕ خاطرٕ مشہور ٲسؠ۔ \f*
\p
\v 29 پتہٕ ووٚن مےٚ تہنٛدٮ۪ن جدٕاجدادن، "یمن لوٗکن مہٕ کھوژیٚو ہرگِز!
\v 30 سون خدا یہُوواہؔ آسہ توٚہہ برُونٛہہ برُونٛہہ تہٕ سُہ لڈِ تُہنٛدِ باپتھ، یتھ کِنؠ سُہ توٚہہِ مِصرس منٛز تہنٛدِ باپتھ کران وُچھ ووٗن
\v 31 تہٕ بیابانن منٛز تُہنٛدِ خٲطرٕ کران وُچھوون۔ توٚہہِ وُچھو زِ کِتھٕ پٲٹھؠ واتنٲوؠ نو تٔمؠ توٚہؠ یور حفاظتہٕ سان، زنتہٕ کانٛہہ نفر پننِس اولادس پکناوان اوس۔\f + \fr 1‏:31 \ft اعمال۔ 13:18\f*
\p
\v 32‏-33 مےٚ پُوو تِمن ژیٚتس زِ ییٚلہ تمہٕ صحراوس منٛز صفر کران ٲسؠ تہٕ سُہ اوس ہمیشہٕ تِمن برُونٛہہ برُونٛہہ نیران۔ تٔمؠ کٔر تِمن روتلہِ نارٕ مشٲلؠ تہٕ دوٚہلہِ ابرٕ لنٛگہ سٟتؠ رہنمٲئی۔ تٔمؠ ہٲو تِمن پنٕنؠ خٟمہ لاگنٕچ جاے تہِ۔ مگر یہ کینٛژھا مےٚ ووٚن تمہِ باوجود کوٚر نہٕ چانیٚو جدٕاجدادو سٲنِس خداوند یہُوواہسؔ پٮ۪ٹھ بھروسہٕ۔
\p
\v 34 یہُوواہنؔ بوز تہِ یہ تِمو ووٚن تہٕ سُہ سپُد غضبناک۔ تٔمؠ کوٚر پوٗرٕ پٲٹھؠ حلفن اعلان،
\v 35‏-36 یفُنہؔ سُنٛد نیٚچو کالِبؔ اژِ اتھ ملکس منٛز۔ تٔمؠ کٔر میٲنؠ پوٗرٕ عبادت۔ اوٕ کِنؠ دمہٕ بہٕ تمِس تہٕ تٔمسنٛدین اولادن کینٛہہ زمیٖن یۅسہ تٔمؠ ژھٲنٛڈمٕژ چھےٚ۔ توٚہہِ ساروےٕ لوٗکو منٛزٕ چُھ صرف سُے یُس یتھ ملکس منٛز أژتھ ہیٚکہِ۔ یمو بُرٕ لوٗکو منٛزٕ ہیٚکہِ نہٕ زانٛہہ کانٛہہ سۅ اصل زمیٖن وُچِھتھ یۅسہ مےٚ چانٮ۪ن جدٕاجدادن دِنُک وعدہ کوٚرمُت اوس۔
\p
\v 37 مگر چانٮ۪ن جدٕاجدادن ہنٛزو کامیٚو سببہٕ سپُد یہُوواہؔ تہِ مےٚ پٮ۪ٹھ ناراض۔ تِمؠ ووٚن مےٚ، "ژٕتہِ ہیٚککھ نہٕ تتھ زمیٖنس منٛز دٲخل سپدِتھ۔
\v 38 نُونؔ سُنٛد نیٚچو یشُوع یُس تُہنٛد مددگار چُھ سپدِ اتھ منٛز دٲخٕل۔ تمِس کٔرؠ زیٚو حوصلہٕ افزائی، تکیازِ سُے چُھ سُہ یُس توٚہہِ اسرائیلی لوٗکن اتھ ملکس پٮ۪ٹھ قبضہ کرنس قٲبل بناوِ۔"
\p
\v 39 پتہٕ ووٚن یہُوواہنؔ اسہِ سارنے، "تِمو فرموو زِ تُہنٛدؠ بچہٕ گژھن تُہنٛدین دشمنن ہنٛدِس قبضس منٛز۔ تکیازِ تِم چھِ واریاہ لۅکٕٹؠ، تِم زاننےٕ نہٕ زِ اصل کیاہ گو تہٕ فراح کیاہ گو۔ مگر تِمے چھِ تِم یمن بہٕ سُہ ملک دمہٕ تہٕ تِم تتھ منٛز دٲخل سپدِتھ کرن تتھ پٮ۪ٹھ قبضہٕ۔
\v 40 مگر یۅتام تُہنٛد تعلق چُھ توٚہؠ پھیریٚو پوٚت تہٕ گٔژھیٚو بحرِ قُلزمؔ سٲحلہٕ کِنؠ ریگستانن منٛز واپس۔
\p
\v 41 پتہٕ دیُت تُہنٛدیو جدٕاجدادو جواب، "اسہِ کٔرؠ گناہ۔ اسہِ کٔر یہُوواہؔ سنٛز نافرمٲنی۔ تہٕ وۅنؠ گژھو أسؠ تہٕ کرو تمہِ ملکہٕ کٮ۪ن روزن والٮ۪ن پٮ۪ٹھ حملہٕ، یتھٕ کِنؠ زن سٲنؠ خدا یہُوواہنؔ اسہِ کرنُک حکم دیُت" تہٕ تِمو منٛزٕ گنٛڈؠ پرٮ۪تھ أکؠ پنٕنؠ ہتھیار، تہٕ سونٛچکھ زِ پہٲڑی علاقن پٮ۪ٹھ حملہٕ کرُن چُھ آسان۔
\p
\v 42 مگر یہُوواہنؔ ووٚن مےٚ، "زِ یِمن ون زِ تور گٔژھتھ مہٕ کٔریٚو تِمن لوٗکن پٮ۪ٹھ حملہٕ تکیازِ بہٕ یمہٕ نہٕ توٚہہِ سٟتؠ تہٕ اگر ژٕ گژھکھ تہٕ ژٕ تھٲوؠ زِ یقین چٲنؠ دشمن دِنے ژےٚ شِکس۔
\p
\v 43 اوے اوس مےٚ چانٮ۪ن جدٕاجدادن ونمُت مگر تِم ٲسؠ نہٕ میانؠ کتھ بوزُن یژھان۔ تِمو کٔر بیٚیہِ تتھ خلاف بغاوت یمیُک حکم تِمن یہُوواہنؔ تِمن کوٚرمُت اوس۔ تہنٛدیٚو سِپہو کوٚر فخرٕ سان تتھ پہٲڑی ملکس کُن پیش قدمی۔
\v 44 پتہٕ درایہ عمور لوٗکن ہنٛزٕ جمٲژ یِم اتھ علاقس منٛز روزان ٲسؠ پن پننیٚو شہرو منٛزٕ تہٕ کوٚرکھ تِمن سِپہن پٮ۪ٹھ حملہٕ۔ تِمو کوٚر چانٮ۪ن جدٕاجدادن ہنٛدین سِپہن پیچھا یتھ کنؠ زن مانٛچھ تُلرین فوج کٲنٛسہِ شخصس پیچھا کران چُھ، تہٕ تِمو کٔر ادومؔ پٮ۪ٹھٕ جنوب کُن پننٮ۪ن نفرن لار۔ تہٕ واتنٲوِکھ شکس دِتھ شعیر پٮ۪ٹھٕ حُرمہؔ۔\f + \fr 1‏:44 \ft سیر چُھ ادوم، یتھ علاقس پٮ۪ٹھ عیسوؔ سنٛدٮ۪ن نسلن ہُنٛد قبضہٕ چُھ۔\f*
\p
\v 45 اوٕ کِنؠ گےَ چٲنؠ جدٕاجداد قادِس برنیاؔ واپس تہٕ کوٚرکھ یہُوواہسؔ منٛگؠ منٛگؠ تِمن مدد کرنُک التجا مگر تٔمؠ بوزنہٕ تِہُنٛد اکھ رژھ تہِ۔ تٔمؠ دیُت نہٕ تِمن کُن کانٛہہ توجہ۔
\v 46 اوٕ کِنؠ ٹھہریاے أسؠ تتہِ قادِسؔ برنیہ ہس منٛز واریہس کالس۔
\c 2
\p
\v 1 پتہٕ رودؠ أسؠ انٛدؠ انٛدؠ بیابانو منٛزؠ بحرِ قُلزمچہ وتہِ پکان یتھٕ کِنؠ اسہِ یہُوواہنؔ کرُن ووٚنمُت اوس تہٕ أسؠ رودؠ واریہن ؤرین شعیر بالن پٮ۪ٹھ ادومسؔ منٛزے پھیران۔
\p
\v 2 پتہٕ ووٚن یہُوواہنؔ مےٚ،
\v 3 "ژےٚ ووتےٕ یتھ کوہستٲنؠ علاقس منٛز واریاہ کال نژان۔ وۅنؠ نیر تہٕ کر شمالس کُن سفر شروع۔
\p
\v 4 تہٕ لوٗکن ون زِ سُہ چُھ یتھؠ ملکس نکھٕ سفر کرن وول یُس عیسو سنٛدین اولادن ہُنٛد چُھ سُہ چُھ اضحاقؔ سنٛدیو اولادو منٛزٕ۔ تِم چھِ ادومؔ کٮ۪ن شعیر پہٲڑی ملکن منٛز روزان۔ تِم کھۅژنے ژےٚ،
\v 5 مگر تِمن سٟتؠ ہیٚزینہٕ لڑٲے، تکیازِ بہٕ دِمے نہٕ ژےٚ تہنٛزِ زمینہ ہُنٛد اکھ حصہٕ تہِ۔ مےٚ چھےٚ سۅ شعیر زمین عیسوؔ سنٛدین اولادن دِنؠ۔\f + \fr 2‏:5 \ft اعمال۔ 7:5\f*
\p
\v 6 ییٚلہِ توٚہؠ تہنٛدِس ملکس نکھٕ سفر کٔریٚو تہٕ تِمن نِش ہیٚزیٚو کھیٚن چیٚن مٔلؠ۔"
\p
\v 7 یہ مشرٲوؠ زیٚنہٕ زِ سٲنؠ خدا یہُوواہنؔ دِژ اسہِ پرٮ۪تھ کُنہ تتھ کامہِ منٛز برکت یۅسہ توٚہہِ کٔرو۔ سُہ چُھ زانان زِ توٚہہِ پٮ۪ٹھ کیاہ چُھ گُدریومُت ییٚلہ توٚہؠ تتھ بٔڈِس صحراوس منٛز پھیران ٲسیٚو۔ مگر سُہ رود یمن ژتجہَن ورین توٚہہِ سٟتؠ یمہِ کِس نتیجس منٛز توٚہہِ تہِ سورےٕ میلیٚو یمِچ توٚہہِ ضرورت ٲس۔
\p
\v 8 یِتھ کِنؠ تھوو اسہِ صفر جٲری۔ اسہِ کوٚر پہٲڑی ملکو منٛزؠ سفر کرُن ترک یتہِ عیسوؔ سنٛدؠ اولاد روزان ٲسؠ، یِم سٲنؠ ٲشناو ٲسؠ۔ أسؠ دراے تمہِ وتہِ یۅسہ وادی یردن کیٚو مٲدانو منٛزؠ گُذرتھ واپس عصیُونؔ جابر تہٕ ایلاتؔ منٛزؠ نیرتھ موآبؔ کٮ۪ن صحرٲے وتن پٮ۪ٹھ واتان چھےٚ۔
\p
\v 9 یہُوواہنؔ ووٚن مےٚ، "موآبٕکؠ لوٗکھ مہٕ کرُکھ تنٛگ تہٕ تِمن سٟتؠ مہٕ کٔریٚو لڑٲے تکیازِ بہٕ دمہٕ نہٕ توٚہہِ تِہُنٛد کانٛہہ تہِ ملک۔ یہ مٔشرٲوؠ زیٚنہٕ زِ سُہ چُھ ابرہامؔ سُنٛد باپتھٕر لوط سنٛدیو اولادو منٛزٕ تہٕ مےٚ دیُت تِمن عار شہر۔"
\p
\v 10 دیون ہنٛز اکھ بٔڈ جماعت یِمن گۅڈٕ ایمِیمؔ ونان ٲسؠ، ٲسؠ تتہِ روزان۔ تِم ٲسؠ عناقؔ سنٛدؠ اولاد جناتن ہنٛدؠ پٲٹھؠ زیٹھؠ۔
\v 11 تِمن تہٕ عناقؔ سنٛدین اولادن تہِ ٲسؠ رِفا دیوٚ ونان مگر موآبٕکؠ لوٗکھ ٲسِکھ ایمِیمؔ ونان۔
\p
\v 12 حورؔ قبیلٕکؠ لوٗکھ ٲسؠ گۅڈٕ ادومؔ علاقس منٛز روزان مگر عیسو سنٛدؠ اولادو لٔگؠ تِمن پتہٕ۔ تِمو دیُت تِمن شکس تہٕ مٲرِکھ تہٕ گے تِہنٛدِس ملکس منٛز آباد۔ یتھٕ پٲٹھؠ پتہٕ اسرائیل یو پنٕنؠ دشمن تمہِ ملکہٕ منٛزٕ کٔڈؠ یُس تِمن یہُوواہنؔ دیُتمُت اوس۔
\p
\v 13 موسیٰؔ ہن ووٚن اسرائیلی لوٗکن یتہِ، ییٚلہ أسؠ زرد وادی اپور ترو یتھ کِنؠ زن یہُوواہنؔ اسہِ ووٚن۔
\v 14 ییٚلہ أسؠ گۅڈنچہِ لٹہِ قادِس برنِیع منٛزٕ دراے تتہِ پٮ۪ٹھٕ گےَ زرد وادی عبور کرنس منٛز اَرترٛہہ وری۔ یِمن ورؠ ین دوران، گُذریاے تمہِ پُییہِ ہنٛدؠ تمام اسرائیلی لڑن وٲلؠ، یتھ کنؠ زن یہُوواہنؔ ونمُت اوس یہ سپدِ۔
\v 15 تِم مودؠ اوٕ سببہٕ تکیازِ یہُوواہؔ رود تِمن مخٲلف یۅتام زن تٔمؠ تِمن نِش نجات حٲصل کوٚر نہٕ۔
\p
\v 16 یۅتام تمہٕ سٲری نفر یمہٕ جنگس منٛز لڑنس قٲبل گٔمٕتؠ ٲسؠ مودؠ،
\v 17 یہُوواہنؔ ووٚن مےٚ،
\v 18 از پییہِ توٚہہِ سارنےٕ موآبؔ کہِ علاقہٕ منٛزؠ نیرُن یُس عارؔ شہرس نزدیک چُھ۔
\v 19 ییٚلہ توٚہؠ تمہِ ملکہٕ کِس سرحدس نزدیک وٲتیٚو یتہِ عمونٕکؠ لوٗکھ روزان چھِ تہٕ تمہٕ کٔرؠ زیوکھ نہٕ پریشان تہٕ نہٕ کٔرؠ زیٚو تِمن سٟتؠ لڑٲے۔ تِم تہِ چھِ لوط سنٛدؠ اولاد، اوٕ کِنؠ دمہٕ نہٕ توٚہہِ تمہِ ملکہٕ منٛزٕ کہینٛؠ یُس مےٚ تِمن دیُتمُت چُھ۔"
\p
\v 20 اتھ علاقس چھِ رِفاؔ دیون ہنٛز سرِ زمین تہِ ونان، گۅڈٕ تتہِ روزان وٲلؠ عمونیؔ لوٗکھ ٲسؠ تِمن زمزم جمٲژ ناوٕ زانان،
\v 21 سُہ ٲس اکھ بٔڈ تہٕ طاقتور جماتھ یمہٕ عناقؔ نسلہٕ کٮ۪ن لوٗکن برابر تٔھدؠ ٲسؠ، مگر یہُوواہنؔ کٔرؠ تِم بُرباد، تہٕ عمونؔ جمٲژ ژٔلرٲوؠ تِم تہٕ تِمن نِش نِیکھ تہنٛز زمیٖن تہٕ لٔگؠ تٔتی بسنہِ۔
\v 22 یہُوواہنؔ کوٚر عیسو سنٛدٮ۪ن اولادن سٟتؠ تہِ تی یِم ادومؔ کٮ۪ن پہٲڑی علاقن منٛز روزان ٲسؠ۔ تِمو کوٚر حورؔ لوٗکن نِش نجاتھ حٲصل، امیُک نتیجہٕ دراو یہ زِ ادومؔ کیٚو لوٗکو نیٚیہ تِمن نِش تِہنٛز زمین تہٕ لٔگؠ تٔتی بسنہِ۔ تِم چھِ وُنہِ تہِ تٔتی روزان۔
\v 23 یِم لوٗکھ کریٹؔ جزیرٕ پٮ۪ٹھٕ آے تہٕ عوی جمٲژ نِش کوٚرکھ نجات حٲصل یِم گۅڈٕ غزہ شہرٕ کِس جنوٗبس منٛز بحیرہ رومسؔ نکھٕ روزان ٲسؠ۔ تَمو نیٚیہ تِمن نِش پنٕنؠ زمین تہٕ لٔگؠ تٔتی بسنہِ۔
\p
\v 24 ییٚلہ أسؠ موآبؔ کہِ علاقہٕ منٛزؠ دراے تہٕ یہُوواہنؔ ووٚن اسہِ، "وۅنؠ کٔریٚو ارنونؔ دریاو پار۔ بہٕ دمہٕ عمور لوٗکن ہنٛدِس بادشاہ سیحونؔ سنٛدِس فوجس شِکس دِنس منٛز توٚہہِ مدد یُس حسبون شہرس منٛز روزان چُھ۔ پس کٔریٚو تِہنٛدِس فوجس پٮ۪ٹھ حملہٕ تہٕ لٲگیٚو تِمن نِش تِہنٛز زمیٖن لوٗٹہٕ نِنؠ۔
\v 25 از کرن بہٕ پرٮ۪تھ جایہ پرٮ۪تھ کانٛہہ تُہنٛدِ سٟتؠ خوفزدٕ۔ پرٮ۪تھ کانٛہہ یُس توٚہہ متعلق بوزان آسہ کھۅژِ تہٕ اژیٚس لرزٕ۔
\p
\v 26 پتہٕ سوزؠ مےٚ پنٕنؠ قٲصد ریگستانہٕ پٮ۪ٹھٕ یتہِ أسؠ ٲسؠ حسبون کِس بادشاہ سیحونسؔ نِش۔ مےٚ ووٚن تِمن زِ بادشاہس نِیو میٚون یہ پُرامن پٲغام:
\v 27 "مہربٲنی کٔرٕتھ دِیو اسہِ پننہِ ملکہٕ منٛزؠ سفر کرنُک اجازت أسؠ چھِ وعدہ کران زِ أسؠ روزو وتہِ پیٚٹھےٕ۔ أسؠ گژھو نہٕ دٔچُھن کھووُر۔
\p
\v 28 أسؠ دِمو پرٮ۪تھ کُنہ کھیٚن چیٚنُک ماوضہٕ یمیُک توٚہؠ اسہِ ہیٚنُک اجازت دِیو۔ أسؠ چھِ صرف تُہنٛدِ ملکہٕ منٛزؠ پکُن یژھان۔
\v 29 یۅتام أسؠ یردن درؠ یاوٕ اپور تتھ ملکس منٛز واتو یُس خداوند یہُوواہنؔ اسہِ دِنہٕ وول چُھ۔ سانہِ باپتھ کٔریٚو تی یتھ پٲٹھؠ زن عیسو سنٛدیو اولادو کوٚر یمہٕ اودمؔ علاقس منٛز روزان چھِ تہٕ موآبؔ کیٚو لوٗکو سانہِ باپتھ کوٚر ییٚلہ تِمو اسہِ پننیٚو علاقو منٛزؠ پکنُک اجازت دیُت۔
\v 30 مگر بادشاہ سیحونؔن دیُت نہٕ اسہِ پننہِ ملکہٕ منٛزؠ پکنُک اجازت۔ یہ اوٕ موٚکھٕ تکیازِ سٲنؠ خدا یہُوواہنؔ ٲس تمِس دِل آزٲری کٔرمٕژ۔ نتیجہٕ دراو یہ زِ یہُوواہنؔ بنٲوؠ أسؠ تِہنٛدِس فوجس شکَس دِنس تہٕ تِہنٛدِس زمینس پٮ۪ٹھ قبضہٕ کرنس قٲبل یتھ پٮ۪ٹھ أسؠ وُنہِ تہِ روازان چُھ۔
\v 31 یہُوواہنؔ ووٚن مےٚ، "بوز! بہٕ چُھس توٚہہ سیحونؔ سنٛدِس فوجس شِکس دِنُک تہٕ لوٗکن ہُنٛد زمین لوٗٹہٕ نِنُک اجازت دِنہٕ وول۔ گٔژھیٚو کٔریٚو تتھ پٮ۪ٹھ قبضہٕ کرُن شروع!"
\p
\v 32 پتہٕ دراو سیحونؔ بادشاہ پنُن سورےٕ فوج ہیٚتھ شہرٕ نیٚبر یہضؔ شہرس کُن اسہِ سٟتؠ لڑنہِ۔
\v 33 مگر خداین بنٲوؠ أسؠ تس شِکس دِنس قٲبل تہٕ اسہِ ژُھن سیحونؔ، تمسنٛدؠ اولاد تہٕ تمسنٛدؠ تمام سِپاہ مٲرِتھ۔
\v 34 اسہِ کوٚر تِہنٛدین شہرن پٮ۪ٹھ قبضہٕ تہٕ تِم سٲری کٔرؠ تباہ۔ اسہِ ژھٕنؠ تمام مرٕد، زنہِ، تہٕ بچہٕ مٲرِتھ۔ اسہِ تھوو نہٕ تِمو منٛزٕ کانٛہہ تہِ زنٛدٕ۔
\v 35 اسہِ یمن شہرن پٮ۪ٹھ قبضہٕ کوٚر تتِکؠ قٟمتی چیز تہٕ چو چاروٲے تہِ نی اسہِ۔
\v 36 سٲنؠ خداوند یہُوواہنؔ بنٲوؠ أسؠ اتھ قٲبل زِ اسہِ کوٚر تِہنٛدین تمام شہرن جنوب کِنؠ عروعیرؔ پٮ۪ٹھٕ وادی ارنونؔ کٮ۪ن بٹھٮ۪ن تام، شمال کِنؠ جلعادؔ کٮ۪ن علاقن تام۔ یمن شہرن انٛدؠ پٔکؠ ٲسؠ دیوار تہِ، مگر أسؠ گےَ توتہِ تِمن پٮ۪ٹھ قبضہٕ کرنس منٛز کامیاب۔
\v 37 مگر أسؠ گےَ نہٕ تِمن علاقن نزدیک یتہِ عمونٕکؠ لُکہ روزان چھِ یا یبوق درؠ یاو کیٚن بٹھیٚن یا پہٲڑی ملکہٕ کٮ۪ن قصبن یا کُنہِ دویمہِ جایہ یور خداوند خداین اسہِ گژُھن ووٚن نہٕ۔
\c 3
\p
\v 1 پتہٕ پھیرؠ أسؠ شمالی انٛدس کُن تہٕ گےَ بسنؔ علاقس منٛز۔ تمہِ علاقُک بادشاہ عوجؔ تہٕ تمسنٛدؠ تمام سِپاہ گےَ جنوب طرفہٕ ادرعیؔ شہرس منٛز اسہِ سٟتؠ لڑنہٕ باپتھ کھڑا۔
\v 2 یہُوواہنؔ ووٚن مےٚ یِمن مہٕ کھوٚژ بہٕ بناون چون فوج عوج تہٕ تٔمسنٛدِس سٲرسےٕ فوجس شِکس دِنس تہٕ تِہنٛدس سٲرسےٕ ملکس پٮ۪ٹھ قبضہٕ کرنس قٲبل۔ أمِس سٟتؠ کر تی یہ ژےٚ عمور قومہٕ کِس بادشاہ سیحونس سٟتؠ کۅرتھ یُس حسبونس پٮ۪ٹھ حکومت کران اوس۔"
\p
\v 3 یتھٕ پٲٹھؠ بنٲوؠ أسؠ یہُوواہنؔ بسن کِس عوجؔ بادشاہس تہٕ تٔمسنٛدِس تمام فوجس شِکس دِنس قٲبل۔ اسہِ مٲرؠ تِم سٲری۔ اسہِ دیُت نہٕ تِمن منٛز کٲنٛسہِ تہِ زنٛدٕ روزنہٕ۔
\v 4 ارجوبؔ کِس تتھ علاقس منٛز ٲسؠ شیٹھ شہر یِم بسنؔ کِس بادشاہ عوجؔ سنٛدِس زیرِ سلطنتس منٛز یوان ٲسؠ۔ مگر اسہِ رٔٹؠ تِم سٲری۔
\p
\v 5 یِمن سارنی شہرن ٲسؠ ژۅپٲرؠ دروازٕ تہٕ وۅبؠ دار تٔھدؠ دیوار۔ اسہِ کوٚر واریہن تِمن گامن پٮ۪ٹھ تہِ قبضہٕ یِمن انٛدؠ پٔکؠ دیوار ٲسؠ نہٕ۔
\v 6 اسہِ کوٚر پرٮ۪تھ اکھ چیز مکمل پٲٹھؠ تباہ، یتھ پٲٹھؠ اسہِ تتھ علاقس منٛز کوٚر یتہِ سیحون بادشاہ حکومت کران اوس۔ اسہِ ژھٕنؠ تمام مرد، زنہِ تہٕ شُرؠ مٲرِتھ۔
\v 7 مگر اسہِ کٔرؠ تِمو شہرو منٛزٕ تمام چوٕ چاروٲے تہٕ باقی قٟمتی چیز پانس باپتھ جمع۔
\p
\v 8 تمہِ وقتہٕ نیٚیہ اسہِ عمور قومہٕ کٮ۪ن تِمن دوٚن بادشاہن یردن دریاو کِس مشرِقس منٛز تہٕ جنوب طرفہٕ ارنونؔ دریاوٕ کیٚن بٹھٮ۪ن تام تہٕ شمال طرفہٕ حرمون بالس تام سٲرےٕ زمین قبضس منٛز۔
\v 9 اتھ پہاڑس ٲسؠ صیدا شہرٕکؠ لوٗکھ سِریُونؔ ونان تہٕ عمورٕکؠ لوٗکھ ٲسِس سنیِرؔ ونان
\v 10 اسہِ کوٚر سطح مرتفع کٮ۪ن تمام قصبن پٮ۪ٹھ قبضہٕ تہٕ جلعاد کٮ۪ن تمام علاقن پٮ۪ٹھ، تہٕ بسن کِس مشرِقس منٛز ادرعیؔ تہٕ سلقہؔ کٮ۪ن شہرن تام یمہٕ عوج سنٛدِس سلطنتس منٛز یوان ٲسؠ۔
\p
\v 11 عوجؔ اوس بسنُک ٲخری بادشاہ یُس رِفا دیون ہنٛدِ نسلہٕ منٛزٕ اوس۔ تمِس اوس شِسترو پلنٛگ۔ یُس زن ژور میٹر زیوٹھ تہٕ زٕ میٹر کھۅل اوس۔ یہ اوس عمونؔ علاقہٕ کِس ربہؔ شہرس منٛز۔
\p
\v 12 تمہِ وقتہٕ یتھ زمیٖنس پٮ۪ٹھ اسہِ قبضہٕ کوٚر تمہِ منٛزٕ دیُت مےٚ روبنؔ تہٕ جد قبیلہٕ کٮ۪ن ارنونؔ دریاوس نکھٕ عروعیرؔ شہرٕ کِس شمالس منٛز تہٕ جلعاد کٮ۪ن پہٲڑی علاقن نِش شہرن نزدیک کینٛہہ زمیٖن۔
\v 13 جلعادُک دویم حصہٕ تہٕ سورےٕ بسن یُس ارجوبؔ علاقس منٛز اوس یتھ پٮ۪ٹھ عوج بادشاہ حکومت کران اوس دِژ مےٚ منسیؔ کٮ۪ن اڈٮ۪ن قبیلن۔ بسن کِس پوٗرٕ علاقس اوس رِفا دیون ہنٛز سرِ زمین وننہٕ یوان۔
\p
\v 14 منسیؔ قبیلٕکؠ یائیرؔ نٲوؠ أکؠ شخصن کوٚر سورےٕ بسنؔ فتح۔ یۅتام شمال انٛدٕ جسُورؔ تہٕ معکاتؔ علاقٕکؠ سرحد چھِ۔ تٔمؠ دیُت تتہِ کٮ۪ن گامن پنُن ناو، تہٕ تِم چھِ وُنہِ یائِیرؔ سنٛدِ ناوٕ زاننہٕ یوان۔\f + \fr 3‏:14 \ft یائیرؔ سُنٛد گام۔\f*
\p
\v 15 جلعاد علاقُک شمٲلی حصہٕ دیُت مےٚ مکِیر سنٛدین قبیلن یمہ منسیؔ سنٛدِ قبیلٕکؠ اولاد چھِ۔
\p
\v 16 مےٚ دِیُت روبن تہٕ جد کٮ۪ن قبیلن جلعادُک جنوبی حصہٕ یُس جنوب کِنؠ ارنونؔ دریاوس تام پھٲلِتھ اوس۔ دریاوُک مرکزی حد اوس جنوبس تام۔ تہٕ شمٲلی حد چُھس دریاے یبوق یُس عمونؔ علاقہٕ کہ سرحدُک حصہٕ چُھ۔
\p
\v 17 یہ سرحد چُھ یردن وادی ہنٛدِ مشرقی بٹھِکہ مٲدانہٕ پٮ۪ٹھٕ، شمالہٕ کِنؠ کِنرتؔ\f + \fr 3‏:17 \ft بحیرہ گلیلُک بیاکھ ناو۔ \f* پٮ۪ٹھٕ (یتھ بحیرہ گُلیلؔ ونان چھِ) جنوبہٕ کِنؠ بحیرہ عربہ\f + \fr 3‏:17 \ft بحیرہ مردار۔\f* ہس (یتھ بحیرہ مردار تہِ ونان چھِ) تام پھٲلِتھ چُھ۔ تہٕ مشرقہٕ کِنؠ پِسگہ کوٚہہ کِس پاتھلِس تام۔
\p
\v 18 تمہِ وقتہٕ ووٚنو مےٚ توٚہہ تریٚن قبیلن، سون خدا یہُوواہؔ چُھ توٚہہِ یہ ملک یردن کِس مشرِقس منٛز دِوان تاکہِ توٚہؠ کٔریٚو اتھ پٮ۪ٹھ قبضہٕ۔ لہٰذا پزِ وۅنؠ تُہنٛدین سِپہَن زِ تِم یِن پنٕنؠ ہتھیار ہیٚتھ یردن دریاوٕ اپور دویمٮ۪ن اسرائیلی قبیلہٕ کٮ۪ن نفرن برُونٛہہ تاکہِ تِم ہیٚکن یہ ملک فتح کرنس منٛز تِمن مدد کٔرِتھ یُس خدا تِمن دِنہٕ وول چُھ۔
\p
\v 19 مگر تُہنٛزٕ خاندارنہِ، بچہٕ تہٕ چو چاروٲے روزن تِمن شہرن منٛز یمہٕ مےٚ توٚہہِ دِتؠ۔
\v 20 تُہنٛدین نفرن پزِ پننٮ۪ن اسرائیلی سٲتھین مدد کرُن، یۅتام نہٕ یہُوواہؔ تِمن تتہِ امنہٕ سان بسنَس قٲبل بناوِ، یۅتام نہٕ تِم تتھ سٲرسےٕ زمیٖنس پٮ۪ٹھ قبضہٕ کرن یۅسہ سون خداوند یہُوواہؔ تِمن یردن دریاوٕ کِس مغربی بٹھِس پٮ۪ٹھ دِوان چُھ یتھ کنؠ تٔمؠ یتہِ یردن دریاوٕ کہِ مشرقہٕ طرفہٕ تُہنٛدِ باپتھ کوٚر۔ تمہِ پتہٕ ہکیٚو توٚہؠ سٲری تتھ ملکس منٛز واپس گٔژھِتھ یُس مےٚ توٚہہِ دیُت۔"
\p
\v 21 تہٕ مےٚ ووٚن یشُوع ہس، "ژےٚ وُچِھتھ تہِ سورےٕ یہ سانؠ خدا یہُوواہنؔ تِمن دوٚن بادشاہن سیحونسؔ تہٕ عوجسؔ سٟتؠ کوٚر۔ سُہ کرِ تِمن لوٗکن سٟتؠ تی یِم وۅنؠ یتھ ملکس منٛز چھِ یور توٚہؠ ژُوو۔
\v 22 یِمن لوٗکن مہٕ کھۅژیٚو تکیازِ یہُوواہؔ چُھ سون سُہ خدا یُس توٚہہِ سارنےٕ ہنٛدِ باپتھ لڑِ۔"
\p
\v 23 تٔمہِ ساعتہٕ کوٚر مےٚ دِلہ سٟتؠ دُعا تہٕ ووٚنُم،
\v 24 یہُوواہؔ سانہِ خداوندٕ، ژےٚ کۅرتھ صرف مےٚ ہاونہٕ باپتھ یہ شروع زِ توٚہؠ چُھو سٮ۪ٹھاہ عظیم تہٕ مےٚ تِم طاقتہٕ وٲلؠ چیز ہاونہٕ باپتھ یمہٕ توٚہؠ کٔرِتھ ہکیٚو۔ بے شک چُھنہٕ زمیٖنس تہٕ آسمانس منٛز کانٛہہ خدا یُس یہ طاقتور کٲم کرِ یۅسہ توٚہہِ کٔرو۔
\v 25 تہٕ وۅنؠ کٔرؠ تو مہربٲنی مےٚ دی تو یردن دریاو عبور کٔرِتھ مشرق انٛدٕ اصل زمین تہٕ لبنانٕکؠ خوبصورت پہٲڑی ملک وُچھنٕکؠ اجازت۔
\p
\v 26 مگر تُہنٛدیٚو جدٕ اجدادن ہنٛزو کامیٚو سٟتؠ سپُد یہُوواہؔ ناراض یمہِ کنؠ تِمو مےٚ کُن توجہ دیُت نہٕ۔ امہِ بجایہ ووٚن تِمو، "یہ کتھ چھےٚ تُہنٛدِ طرفہٕ کٲفی! اتھ متعلق کٔرزیٚنہٕ مےٚ سٟتؠ دوبارٕ کتھ!
\v 27 ژٕ کھس پِسگہؔ پہارٕ تینٛتٲلِس پٮ۪ٹھ تہٕ دِ مغرب، مشرق، شمال تہٕ جنوب کُن نظراہ۔ ژےٚ پٔزی یہ سٮ۪ٹھاہ توجہ سان وچُھن، تکیازِ ژٕ ہیککھ نہٕ تتہِ پٮ۪ٹھٕ زمیٖن وُچھنہٕ باپتھ یردن دریاو پار کٔرِتھ۔
\p
\v 28 مگر یشُوعؔ ہس ون زِ سُہ کیاہ کرِ۔ تمِس دِ ہمتھ مضبوط بننٕچ، تکیازِ سُے چُھ سُہ یُس لوٗکن دریاوٕ اپور تارِ تاکہِ تِم کرن تتھ زمیٖنس پٮ۪ٹھ قبضہٕ یُس ژےٚ بالہٕ تینٛتالہٕ پٮ۪ٹھٕ وچُھتھ۔
\p
\v 29 اوٕ کِنؠ ٹھہریاے أسؠ بیت فعورؔ شہرس نکھٕ یردن دریاوچہِ وادی منٛز۔
\c 4
\p
\v 1 "وونؠ کٔریٚو توٚہؠ اسرائیلی لوکھ، تِمن تمام اصولن تہٕ ضٲبطن پٮ۪ٹھ عمل یمہٕ بہٕ توٚہؠ ہیٚچھِ ناوو۔ اگر توٚہؠ تہِ کٔریٚو، توٚہؠ روزیٚو زنٛدٕ تہٕ توٚہؠ کٔریٚو تتھ ملکس منٛز دٲخل سپدِتھ قبضہٕ یُس خداوند یہُوواہنؔ یمسنٛدؠ تُہنٛدؠ جدٕاجدادن پٲروکار ٲسؠ توٚہہِ دِوان چُھ۔
\v 2 یہ کینٛژھا بہٕ توٚہہِ حکم کران چُھس تتھ مہٕ ہُررٲیو کینٛہہ تہٕ یہ کینٛژھا بہٕ توٚہہِ ونان چُھس تتھ مہٕ چھوٚنرٲیو کینٛہہ۔ سٲنِس خدا یہُوواہؔ سنٛدؠ سٲری احکام مٲنیٚو یمہٕ بہٕ توٚہہِ دِوان چُھس۔\f + \fr 4‏:2 \ft مُکاشفہ۔ 22:18\f*
\p
\v 3 توٚہہِ وچُھو زِ یہُوواہنؔ کیاہ کوٚر بعلؔ فغُورسؔ منٛز۔ تٔمؠ کٔرؠ تِم سٲری لوٗکھ تباہ یمہٕ تتہِ بعلؔ دیوتا سنٛز عبادت کران ٲسؠ،\f + \fr 4‏:3 \ft گریند۔ 25.1-9\f*
\v 4 مگر توٚہؠ سٲری یمہٕ پزِدلہٕ سٲنِس خدا یہُوواہؔ سنٛز عبادت کران ٲسؠ چُھو از تہِ زنٛدٕ۔
\p
\v 5 یاد تھٲیو زِ مےٚ ہیٚچھنٲیو توٚہؠ تمام اصول تہٕ ضٲبطٕ یتھٕ کنؠ سٲنؠ خدا یہُوواہنؔ مےٚ کرُن ونمُت چُھ۔ سُہ چُھ یژھان زِ ییٚلہِ توٚہؠ یتھ ملکس منٛز روزیٚو یتھ منٛز توٚہؠ دٲخل سپدِتھ قبضہٕ کرن وٲلؠ چُھو، توٚہؠ کٔریٚو تمؠ سنٛز عبادت۔
\v 6 وفادٲری سان کٔریٚو تمؠ سنٛز فرمانبردٲری، اگر توٚہؠ تہِ کٔریٚو، توٚہؠ ہٲیو باقی قومن زِ توٚہؠ چُھو سٮ۪ٹھاہ عقلمند۔ ییٚلہ تِم یِمن سارنےٕ قانونن متعلق بوزن تہٕ تِم ونن، "امہِ عظیم اسرائیلی قومٕکؠ لوٗکھ چھِ یقینن سٮ۪ٹھاہ عقلمنٛد"
\p
\v 7 یوٚدوے بیٚیہِ تہٕ کانٛہہ قوم عظیم آسہ مگر توتہِ آسہ نہٕ تِمن منٛز تیٚوتھ کانٛہہ خدا یُس تِمن تیوت قریب آسہ یوٗتاہ یہُوواہؔ سون خدا اسہِ چُھ!\f + \fr 4‏:7 \ft رومؔ۔ 3:2\f*
\v 8 بیٚیہِ چُھنہٕ دویم کانٛہہ تہِ قوم چاہے سُہ کوتاہ تہِ بوٚڈ قوم ٲسؠ تن، یِمن نِش تِتھؠ قانون آسن یمہٕ بہٕ توٚہہِ از ونان چُھسو۔
\p
\v 9 مگر توٚہؠ روزیٚو سٮ۪ٹھاہ ہُشار! یہ کینٛژھا توٚہہِ خدا کران وُچھوون تِمہ مٔشرٲیو۔ یۅتام توٚہؠ زنٛدٕ چُھو یمہٕ کتھٕ تھٲوؠ زیٚو یاد۔ یمہٕ ؤنؠ زیٚو پننٮ۪ن شُرٮ۪ن تہٕ زُریٚن۔\f + \fr 4‏:9 \ft خروج 19 تہٕ 20 سبق۔\f*
\v 10 تِمن ؤنؠ زیٚو تتھ دوٚہس متعلق ییٚلہِ تُہنٛدؠ جدٕاجداد کوہہِ سیناؔ ہس پٮ۪ٹھ سٲنِس خدا یہُوواہسؔ برُونٛہہ کنہِ کھڑا ٲسؠ۔ ییٚلہ تٔمؠ مےٚ ووٚن، لوٗکھ کرُکھ جمع تاکہِ تِم بوزن بہٕ کیاہ چُھس ونان۔ بہٕ چُھس یژھان زِ یۅتام تِمہ زنٛدٕ چھِ تِم ہیٚچھن مےٚ عزت تہٕ احترام کرُن، بہٕ چُھس یژھان زِ تِم ہیٚچھناون پننٮ۪ن بچن تہِ یہ کرُن۔"
\p
\v 11 پننٮ۪ن بچن ؤنیٚو زِ تُہنٛدؠ جدٕاجداد آے بالہٕ دامنس نکھٕ، ییٚلہِ سینا پہاڑس آسمانس تام نارٕ بُڈک وۅتھان ٲسؠ تہٕ پہاڑ آے کریہنہِ ابرٕ تہٕ کریہنہِ دوٚہہ سٟتؠ ولنہٕ۔\f + \fr 4‏:11 \ft خروج 19:18، عبر 12:18 تہٕ 12:19 \f*
\v 12 پتہٕ کٔر یہُوواہنؔ نارٕ منٛزؠ تُہنٛدین جدٕاجدادن سٟتؠ کتھ۔ تُہنٛدیٚو جدٕاجدادو وُچھ سُہ کتھ کران، مگر تِمو وُچھ نہٕ سُہ۔ تِمو بوز صرف تمؠ سنٛز کتھ۔
\p
\v 13 تہٕ تِمو کوٚر تِمن سٟتؠ پننہِ وعدُک اعلان زِ سُہ چُھ یژھان تِم تہِ کرن عبادت۔ تِمو ؤنؠ تِمن داہ احکام۔ تِمو لیکھؠ تِم کنٮ۪ن ہنٛزن دوٚن تختی ین پٮ۪ٹھ۔
\v 14 یہُوواہنؔ دیُت مےٚ حکم زِ بہٕ ہیٚچھِ ناوو توٚہؠ تمام قواعد تہٕ ضوابط تاکہِ یتھ ملکس منٛز توٚہؠ دٲخل سپدن تہٕ قبضہٕ کرن وٲلؠ چُھو تتہِ کٔریٚو توٚہؠ تِہنٛز عبادت۔
\p
\v 15 یمہِ دوٚہہ یہُوواہنؔ کوہہِ سیناؔ ہس پٮ۪ٹھ تُہنٛدین جدٕاجدادن سٟتؠ کتھ کٔر تِمو وُچھ نہٕ سُہ۔ لہٰذا روزیٚو ہُشار!\f + \fr 4‏:15 \ft کوہہِ حوریب چُھ کوہہِ سینا ہُک بیاکھ ناو۔ \f*
\v 16 پننہِ خٲطرٕ کانٛہہ مورتی گٔرِتھ مہٕ کٔریٚو گناہ! تیٚوتھ کانٛہہ چیز مہٕ بنٲیو یتھ کٲنٛسہِ انسانس سٟتؠ مُشابِہت سپدِ چاہے زنؠ ٲسؠ تن یا مرٕد،
\v 17 یا یُس کٲنٛسہِ جانورس یا جاناوارس سٟتؠ مُشابِہت تھاوِ،
\v 18 یا کٲنٛسہِ کھکھرٮ۪ل جانورس یا گاڈِ سٟتؠ مُشابِہت تھاوِ۔
\p
\v 19 تہٕ حسہٕ رُوزؠ زیٚو یُتھنہٕ آسمانس کُن وچُھو تہٕ کینٛژھا توٚہؠ تتہِ وچھان چُھو ینہٕ تمچہِ پرستِش کرنٕچہِ ازمٲیشہ منٛز پیٚیو یعنی افتاب، زوٗن یا تارک۔ سٲنؠ خدا یہُوواہنؔ تھاوؠ تِمہٕ پرٮ۪تھ جایہ لوٗکن ہنٛدِ مدٕتہٕ باپتھ، مگر توٚہؠ مہٕ کٔریٚو تِہنٛز عبادت۔
\v 20 یہُوواہنؔ أنؠ تُہنٛدؠ جدٕاجداد مِصرٕ منٛزٕ کٔڈِتھ یمہٕ تتہِ دزٕونہِ نارِ گجہِ ہنٛدؠ پٲٹھؠ دُکھ ویٚتران ٲسؠ تاکہ تِم بنہٕ ہن تمسنٛدؠ لوٗکھ، یتھ کنؠ از توٚہؠ چُھو۔\f + \fr 4‏:20 \ft مِصر، ییٚتہِ توٚہہِ وۅزجہِ گرم بچھِ منٛز آسنہٕ کِنؠ واریاہ زیادٕ تکلیف تُلِو۔\f*
\p
\v 21 مگر یہُوواہؔ گو مےٚ ناراض تُہنٛدیٚو جد اجدادن ہنٛدِ ورتاوٕ کِنؠ تہٕ تٔمؠ کوٚر وعدہ زِ بہٕ گژھٕ نہٕ اتھ ملکس منٛز زانٛہہ یُس سُہ توٚہہِ دِوان چُھ۔\f + \fr 4‏:21 \ft گریند۔ 20:12، اِستِثنا۔ 32:48 پٮ۪ٹھٕ 52 تام \f*
\v 22 تِمو کھیٚو قسم زِ بہٕ مرٕ یتھؠ ملکس منٛز تہٕ یردن دریاوٕ ترنہٕ زانٛہہ تہِ اپور۔ مگر توٚہؠ تٔریٚو اتھ اپور، تہٕ توٚہؠ کٔریٚو اتھ زمیٖنس پٮ۪ٹھ قبضہٕ۔
\p
\v 23 یقین تھاوؠ زیٚو تہٕ عہد مٔشرٲوؠ زیٚو نہٕ یُس یہُوواہؔ سون خداوند توٚہہِ سٟتؠ کران چُھ تہٕ یِمو چیزو نشہٕ تِمو منع فرموو تِمن چیزن ہنٛزٕ شکلہٕ بنٲوِتھ مہ کٔرؠ ووکھ نقشہٕ نگار۔
\v 24 توٚہہِ پزیٚو نہٕ یہ کرُن تکیازِ یہُوواہؔ تُہنٛد خدا چُھ یژھان زِ پرٮ۪تھ کانٛہہ کرِ تمؠ سنٛز عبادت۔ سُہ کرِ پرٮ۪تھ کٲنٛسہِ تمِس شخصس تباہ یُس پۅتلن آسہ عبادت کران۔\f + \fr 4‏:24 \ft عبر۔ 12:29\f*
\p
\v 25 ییٚلہ توٚہؠ واریہس وقتس کنعان شہرس منٛز روزِتھ چُھو تہٕ توٚہہِ چھِ اولاد تہِ تہٕ زُرؠ تہِ تہٕ کُنہِ تہِ چیزُک عکس بنٲوِتھ تہٕ تتھ مورتی گٔرِتھ مہٕ کٔریٚو گناہ۔ تکیازِ یہُوواہؔ چُھ فرماوان زِ یہ چُھ غلط، اگر توٚہؠ یہ کران چُھو تہٕ توٚہؠ چھون سُہ ناراض کران تہٕ پانس باپتھ سزا ہیٚوان۔
\v 26 از چُھس بہٕ پرٮ۪تھ أکِس یُس آسمانس پٮ۪ٹھ چُھ تہٕ پرٮ۪تھ أکِس یُس زمیٖنس پٮ۪ٹھ چُھ التجا کران زِ وُچُھو توٚہؠ کیاہ چُھو کران۔ اگر توٚہؠ میانؠ نافرمٲنی کران چُھو تہٕ سُہ وق آسہ نہٕ دوٗر ییٚلہ نہٕ توٚہؠ یتھ ملکس منٛز مٔریٚو یوٚت توٚہؠ یردن دریاو پار کٔرِتھ وٲتیٚو۔ توٚہؠ روزیٚو نہٕ تتہِ زیادس کالس۔ تہٕ یہُوواہؔ کرِ توٚہہِ منٛزٕ واریہن لوٗکن مکمل پٲٹھؠ نابود۔
\p
\v 27 تہٕ توٚہہِ منٛزٕ باقی لوٗکن کرِ یہُوواہؔ مجبوٗر زِ توٚہؠ گٔژھیٚو تہٕ بٔسیٚو باقی قومہٕ کٮ۪ن لوٗکن سٟتؠ۔ توٚہہِ منٛزٕ بچن کٔژتام نفرےٕ۔
\v 28 ییٚلہ، توٚہؠ تِمن ملکن منٛز ٲسیٚو تہٕ توٚہؠ کٔریٚو تِمن دیوتاہن ہنٛز پوٗزا یمہٕ لکٕرِ تہٕ کنٮ۪ن ہنٛدؠ بنیمٕتؠ آسن، انسانن ہنٛدؠ بنٲومٕتؠ دیوتا، تِم دیوتا یِم نہ وُچِھتھ ہیٚکن تہٕ نہ بوزِتھ ہیٚکن، یِم نہ کینٛہہ کھیٚتھ ہیٚکن تہٕ نہ کُنہِ مُشِک ہیٚتھ ہیٚکن۔
\p
\v 29 مگر ییٚلہ توٚہؠ تتہِ ٲسیٚو تہٕ توٚہؠ کٔرؠ زیٚو یہُوواہؔ پنُن خدا زاننٕچ کوشش تہٕ اگر دِلہ سان توٚہؠ سُہ ژھانٛڈنٕچ کوشش کٔریٚو تہٕ سُہ دِیو توٚہہِ جواب۔
\p
\v 30 آینٛدٕ ییٚلہِ توٚہہِ سٟتؠ بدسلوکی کرنہٕ ییہِ تہٕ تِم سارے بُراییہِ توٚہہِ سٟتؠ ورتاونہٕ ین تہٕ توٚہؠ کٔرؠ زیٚو پتہٕ تہِ صرِف یہُوواہؔ سنٛز عبادت تہٕ تمؠ سنٛز عبادت۔
\v 31 یہُوواہؔ چُھ خدا یُس رحم کرن وول چُھ۔ اگر توٚہؠ تمؠ سنٛز فرمانبرداری جٲری تھایو تہٕ سُہ تراوِ نہٕ توٚہہ، پتھر نہ کرِ توٚہہِ تباہ، تہٕ نہ گژھیس سُہ وعدہ مٔشِتھ یُس تٔمؠ تُہنٛدین جدٕاجدادن سٟتؠ کوٚرمُت چُھ۔
\p
\v 32 "وۅنؠ سونٛچو پتھ کالس متعلق، تُہنٛدِ زیٚنہٕ برونٛہہ مِس وقتس متعلق، تتھ وقتس متعلق ییٚلہِ خداین گۅڈنِچہِ لٹہِ یتھ زمیٖنس پٮ۪ٹھ لوٗکھ پٲدٕ کٔرؠ۔ توٚہؠ ہکیٚو پرٮ۪تھ جایہ، آسمانس تہٕ زمیٖنس منٛز تلاش کٔرِتھ۔ کیاہ کُنہ ساعتہٕ ہیٚوکا تیٚوتھ کینٛہہ سپدِتھ یُس تیوٗت بوٚڈ آسہ یوٗتاہ زن یہُوواہنؔ اسہِ اسرائیل ین باپتھ کوٚر؟
\v 33 کیاہ کنہِ ساعتہٕ ہیٚچا کانٛہہ جماتھ زنٛدٕ روزِتھ ییٚلہِ تِمو کانٛہہ خدا نارٕ منٛزؠ تِمن سٟتؠ کتھ کران وُچھ یتھ کنؠ زن اسہِ کوٚر؟\f + \fr 4‏:33 \ft یہٕ چُھ کوہہِ سیناہُک حوالہٕ دِوان (وُچھِو آیت 12)\f*
\p
\v 34 پٔزؠ پٲٹھؠ کٔرنہٕ خداین زانٛہہ تہِ کُنہِ قومہٕ منٛزٕ لوٗکن ہنٛز اکھ بٔڈ جماتھ دویمہ جایہِ ننٕچ کوشش، یتھٕ پٲٹھؠ زن تٕمؠ أسؠ مِصرٕ منٛزٕ کڈنہٕ وزِ کوٚر۔ اسہِ وُچھ زِ سٲنؠ خدا یہُوواہنؔ کوٚر پنُن عظیم طاقت استعمال کٔرِتھ اسہِ واشگاف زِ سُہ کُس چُھ، طاعون سوزِتھ، تہٕ واریاہ باقی کامہِ کٔرِتھ یمو سٟتؠ لُکہ خوفزدٕ سپٕدؠ، تہٕ ییٚلہِ مِصرٕکؠ فوجن اسہِ پٮ۪ٹھ حملہٕ کرنٕچ کوشِش کٔر تہٕ تِمو کتھٕ کنؠ بچٲوؠ أسؠ۔
\p
\v 35 یہُوواہنؔ ونہِ توٚہہ یمہٕ سارے کتھٕ اوٕ کِنؠ زِ توٚہؠ زٲنیٚو زِ سُے چُھ پوٚز خدا، تہٕ تمِس بغٲر چُھنہٕ بیٚیہِ کانٛہہ خدا۔
\v 36 تِمو دیُت تُہنٛدین جدٕاجدادن آسمانہٕ پٮ۪ٹھٕ پنٕنؠ کتھ بوزنُک اجازت تاکہِ سُہ کرِ تِہنٛز تربیت۔ یتھ زمینس پٮ۪ٹھ دیُت تٔمؠ تِمن کوہہِ سیناہس پٮ۪ٹھ پنُن عظمتہٕ وول نار وُچھنُک اجازت، تہٕ تِمو کٔر نارٕ منٛزؠ تِمن سٟتؠ کتھ۔
\p
\v 37 چونکہ سُہ اوس سانٮ۪ن جدٕاجدادن سٟتؠ محبت کران، تٔمؠ ژٲریٚو توٚہؠ اسرائیلی یمہٕ تِہنٛدِوےٕ اولادو منٛزٕ چھِ تہٕ پننہِ بڈِ طاقتہٕ سٟتؠ أنِن تُہنٛدؠ جدٕاجداد مِصرٕ منٛزٕ نٮ۪بر کٔڈِتھ۔
\v 38 ییٚلہ تِم سفر کران ٲسؠ تہٕ تِمو کٔڈؠ تتہِ تمہِ قومٕکؠ لوٗکھ یمہٕ تِہنٛدِ کھۅتہٕ بٔڈؠ تہٕ طاقتور ٲسؠ تاکہِ تِم کرٕہن تہنٛزِ سرِزمینہِ پٮ۪ٹھ قبضہٕ یُتھ سۅ تُہنٛز بنہِ ہے، یہ وۅنؠ سپدان چُھ۔
\p
\v 39 تہٕ وۅنؠ پزِ توٚہہِ اتھ حقیقتس سنُن زِ یہُوواہؔ چُھ خدا تہٕ سُہ چُھ آسمانس تہٕ زمینس پٮ۪ٹھ حکومت کران تہٕ تمِس بغٲر چُھنہٕ بیٚیہِ کانٛہہ خدا۔\f + \fr 4‏:39 \ft 1 کورنتھ۔ 8:4\f*
\v 40 تِمن سارنی اصولن تہٕ ضٲبطن پٮ۪ٹھ کٔریٚو عمل یمہٕ بہٕ توٚہہِ از دِوان چُھسو تاکہِ توٚہہِ تُہنٛدین اولادن باپتھ روزِ بہتر تہٕ توٚہؠ روزیٚو یتھ ملکس منٛز واریہس کالس زنٛدٕ یُس سون خدا یہُوواہؔ توٚہہ دِوان چُھ، تکیازِ یہ چُھ ہمیشہٕ باپتھ تُہنٛد۔"
\p
\v 41 پتہٕ کوٚر موسیٰؔ ہن تریٚن شہرن ہُنٛد انتخاب یمہٕ یردن دریاوس مشرقہٕ انٛدٕ ٲسؠ۔
\v 42 اگر کٲنٛسہِ وشفن کانٛہہ دویِم شخص مور یُس نہٕ گۅڈٕ تمسُنٛد دشمن اوس، تہٕ سُہ ہیٚکہِ تِمو شہرو منٛزٕ کُنہِ تہِ شہرس منٛز ژٔلِتھ۔ سُہ ہیٚکہِ تِمو شہرو منٛزٕ کُنہِ أکِس جایہ محفوظ روزِتھ تکیازِ تتِکؠ لوٗکھ کرن تس حفاظت۔
\v 43 روبن سنٛدِ قبیلہٕ باپتھ کوٚر موسیٰؔ ہن بیابانن منٛز بصرؔ شہرُک انتخاب۔ جد سنٛدِ قبیلہٕ باپتھ کوٚرُن جلعاد علاقہٕ کِس راموتؔ شہرُک انتخاب۔ منسیؔ قبیلہٕ باپتھ کوٚر موسیٰؔ ہن بسنؔ علاقس منٛز جولانؔ شہرُک انتخاب:
\p
\v 44 موسیٰؔ ہن دِتؠ بنی اسرائیل ین خدایہ سنٛدؠ احکام۔
\v 45 تِمن ٲسؠ تِم سٲری پۅختہٕ احکام، ہِدایات تہٕ قانون شٲمل یمہٕ موسیٰؔ ہن اسرائیل کٮ۪ن لوٗکن مِصرٕ منٛزٕ نیرنہٕ پتہٕ ؤنؠ،
\v 46 ییٚلہ تِم یردن دریاوس مشرقہٕ انٛدٕچہِ وادی منٛز ٲسؠ۔ تِم ٲسؠ بیت فعورؔ شہرٕ کِس اپٲرؠ مِس ملکس منٛز یتہِ گۅڈٕ عمور قومہٕ کِس بادشاہ سیحون سنٛز حکومت ٲس، یُس حسبونس منٛز روزان اوس۔ موسیٰؔ ہن تہٕ باقی اسرائیلی لوٗکن ہنٛدؠ فوجن دیُت تِمن شِکس ییٚلہِ تِم مِصرٕ منٛزٕ دراے۔
\p
\v 47 تِمو کوٚر سیحونؔ سنٛزِ زمیٖنہٕ تہٕ تتھ ملکس پٮ۪ٹھ قبضہٕ یتھ پٮ۪ٹھ بسنؔ علاقک بادشاہ عوج حکومت کران اوس۔ یِم ٲسؠ تِم زٕ بادشاہ یمو یردن دریاو کِس مشرِقس منٛز واقع عمور لوٗکن ہنٛزِ جمٲژ پٮ۪ٹھ حکومت کٔر۔
\v 48 تِہنٛز زمیٖن ٲس جنوب کِنؠ عروعیرؔ شہرٕ پٮ۪ٹھٕ ارنونؔ دریاوس تام شمال کِنؠ کوہہِ سیرونس تام پھٲلِتھ یتھ اکثر لوٗکھ کوہہِ حرمون ونان ٲسؠ۔
\v 49 اتھ منٛز اوس دریاے یردنچہ وادی ہُنٛد مشرقی مٲدانُک سورےٕ علاقہٕ شٲمل، یُس عربہؔ سمندری علاقس تام یتھ بحیرہ مراد تہِ ونان ٲسؠ تہٕ مشرقہٕ کِنؠ پِسگہؔ کوہہ کِس پاتھلِس تام پھٲلِتھ اوس۔\f + \fr 4‏:49 \ft بحیرہ عربہؔ ہس چھِ بحیرہ مراد تہِ ونان۔ \f*
\c 5
\p
\v 1 موسیٰؔ ہن أنؠ اسرائیل لٕکؠ تمام لوٗکھ بلٲوِتھ تہٕ وُننَکھ،
\p اے اسرائیلی لوٗکو، بوزیٚو تِم سٲری قٲیِدٕ قانون یمہٕ بہٕ از توٚہہِ ونہٕ۔ یمہٕ ہیٚچھو تہٕ یِمن پٮ۪ٹھ عمل کرٕنؠ بنٲیو یقینی۔
\v 2 ییٚلہ أسؠ کوہہِ سیناؔ ہس پٮ۪ٹھ ٲسؠ تہٕ سٲنؠ خدا یہُوواہنؔ کوٚر اسہِ سٟتؠ عہد۔\f + \fr 5‏:2 \ft کوہہِ سیناؔ۔\f*
\v 3 مگر یہ عہد اوس نہٕ صرف سانٮ۪ن جدٕاجدادن باپتھ۔ تِمو ووٚن یہ سانہِ باپتھ تہِ، یمہٕ وُنکٮ۪ن زنٛدٕ چھِ۔
\p
\v 4 یہُوواہنؔ کرِ نارٕ منٛزؠ تتھ پہاڑس پٮ۪ٹھ اسہِ سٟتؠ روبرو کتھٕ۔\f + \fr 5‏:4 \ft وُچھِو 4:12، 14؛ اعمال 7:38\f*
\v 5 تمہِ دوٚہہ رودُس بہٕ تُہنٛدین جدٕاجدادن تہٕ یہُوواہسؔ منٛزباگ کھڑا تِمن یہ وننہٕ خٲطرٕ زِ تٔمؠ کیاہ ووٚن، تکیازِ تِم ٲسؠ نارس کھۅژان تہٕ پہاڑس کھسُن ٲسؠ نہٕ یژھان۔ یہُوواہنؔ فرموو یتھ کنؠ زِ،
\p
\v 6 بہٕ چُھس یہُوواہؔ تُہنٛد خدا یمسنٛز توٚہؠ عبادت کران چُھو۔ بہٕ چُھس سُے یمؠ توٚہؠ مِصر ملکہٕ منٛزٕ کٔڈِتھ أننو۔ بہٕ چُھس سُہ یمؠ توٚہؠ تتہِ غلامی نِش آزاد کٔرِتھ أننو۔
\v 7 توٚہؠ کٔریٚو صرف میانؠ عبادت۔ توٚہہِ پزِنہٕ کٲنٛسہِ دویمِس خدایہ سنٛز عبادت کرٕنؠ۔
\li
\v 8 توٚہہِ پزِ نہٕ کُنہِ تمہِ چیزٕچ گٔرِتھ مورت بناوٕنؠ یُس آسمانس، زمیٖنس یا زمین کِس آبس منٛز موجود کٲنٛسہِ ذوزٲژ ہنٛز نمایندگی کران آسہ۔
\q
\v 9 توٚہؠ کٔرؠ زیٚو نہٕ کٲنٛسہِ بُتَس برُونٛہہ کنہِ سجدٕ تہٕ تمؠ سنٛز عبادت تکیازِ بہٕ چُھس یہُوواہؔ خدا تہٕ بہٕ کرنہٕ تُہنٛد یہ برداش۔ بہٕ دمہٕ پرٮ۪تھ کٲنٛسہِ تس شخصس سزا یُس یہ کرِ، تہٕ تِہنٛدین اولادن تہٕ زُرین ہنٛدین زُرین تہِ۔
\v 10 مگر بہٕ کرٕ تہنٛدین ساسہٕ واد پیرین تام متوٲتِر محبت یمہٕ مےٚ سٟتؠ محبت کران چھِ تہٕ میانؠ حکم مانان چھِ۔
\q
\v 11 میٚون ناو مہٕ ہیٚیِو لاپرواہی سان یا غلط مقصدو باپتھ تکیازِ بہٕ چُھس یہُوواہؔ خدا، یمسنٛز توٚہؠ عبادت کٔریٚو تہٕ بہٕ دمہٕ تِمن ضرور سزا یِم تہِ کرن۔\f + \fr 5‏:11 \ft متی۔ 5:33\f*
\q
\v 12 ینہٕ یہ مٔشرٲیو زِ پرٮ۪تھ ہفتُک سٔتِم دوٚہہ چُھ تُہنٛدِ باپتھ میانہِ تعظیمہٕ خٲطرٕ خاص، یتھٕ کنؠ بہٕ تُہنٛد یہُوواہؔ، توٚہہ حکم دِوان چُھس۔\f + \fr 5‏:12 \ft مرقُس۔ 2:27\f*
\li
\v 13 پرٮ۪تھ ہفتٕکؠ شےٚ دوٚہہ چھِ توٚہہ پنٕنؠ کٲم کرنہٕ باپتھ،\f + \fr 5‏:13 \ft لوق۔ 13:14\f*
\v 14 مگر سٔتِم دوٚہہ چُھ توٚہہِ آرامُک، یہ دوٚہہ چُھ میانہِ باپتھ مخصوص، یہُوواہؔ، تہنٛدِس خدا سنٛدِ۔ امہِ دوٚہہ پزِنہٕ توٚہہ کانٛہہ کٲم کرٕنؠ۔ توٚہہِ تُہنٛدین لٔڑکن، کورین، مرد غلامن تہٕ مستورات غلامن۔ توٚہہ پزن نہٕ امہِ دوٚہہ پنٕنؠ جانور تہِ کامہِ باپتھ مجبوٗر کرٕنؠ، تہٕ توٚہہ پزِ نہٕ غٲر ملکی نفرن تہِ کانٛہہ کٲم ونٕنؠ، یمہٕ تُہنٛدِس ملکس منٛز روزان چھِ۔ توٚہؠ دیزیٚو پننٮ۪ن غلامن امہِ دوٚہہ آرام کرنہٕ یتھٕ پٲٹھؠ توٚہؠ پانہٕ کران چُھو۔\f + \fr 5‏:14 \ft متی۔ 12:2، لوق۔ 23:56\f*
\p
\v 15 ینہٕ یہ مٔشرٲیو زِ توٚہؠ ٲسیو مِصرس منٛز غلام تہٕ مےٚ تُہنٛدؠ خدا یہُوواہنؔ أنیٚو توٚہؠ تتہِ پننہِ بڈِ طاقتہٕ سٟتؠ کٔڈِتھ۔ یوٚہے وجہ چُھ زِ بہٕ چُھسو توٚہہِ حکم دِوان زِ توٚہہ سارنےٕ پزِ پرٮ۪تھ ہفتہٕ سٔتمہِ دوٚہہ آرام کرُن۔
\q
\v 16 پننٮ۪ن مالٮ۪ن تہٕ پننٮ۪ن ماجن کٔریٚو عزت یتھ کنؠ بہٕ تُہنٛد خدا یہُوواہؔ، توٚہہ حکم دِوان چُھس تاکہ توٚہؠ روزیٚو اکہِ قومہٕ کہ حثیتہٕ یتھ ملکس منٛز واریہس وقتس زنٛدٕ یۅسہ بہٕ یہُوواہؔ تُہنٛد خدا توٚہہ، دِوان چُھس۔ تاکہِ تتہِ روزن تُہنٛدِ باپتھ تمام چیز ٹھیک۔\f + \fr 5‏:16 \ft متی 15:4، مرقُس 7:10، 10:19، اِفِسیوں۔ 6:2 پٮ۪ٹھٕ 3 تام\f*
\q
\v 17 کانٛہہ مہٕ کٔرؠ وون قتل۔\f + \fr 5‏:17 \ft متی۔ 5:21، یعقوب 2:11\f*
\li
\v 18 زناہ کٔرؠ زیٚو نہٕ۔ \f + \fr 5‏:18 \ft متی 5:27، یعقوب 2:11، رومؔ 7:7، 13:9\f*
\li
\v 19 ژوٗر مہٕ کریو۔
\li
\v 20 ییٚلہ توٚہؠ عدالتس منٛز گوٲہی دِیو، کٲنٛسہِ خلاف مہٕ کریو اپُز گوٲہی پیش۔\f + \fr 5‏:20 \ft لوق 18:20\f*
\q
\v 21 کٲنٛسہِ بیٚیہِ سنٛز خاندارِنؠ، کٲنٛسہِ بیٚکؠ سُنٛد گرٕ، کٲنٛسہِ بیٚکؠ سُنٛد زمیٖن، بیٚی سُنٛد غلام یا لونٛڈی، بیٚی سنٛدؠ چاروٲے، بیٚی سنٛدؠ خر یا بیٚیہِ کُنہِ چیزٕچ لالٕچ مہٕ کٔریٚو۔
\p
\v 22 یِم چھِ تِمہ احکام یمہٕ یہُوواہنؔ تُہنٛدٮ۪ن جدٕاجدادن ؤنمٕتؠ چھِ۔ ییٚلہِ تِم سینا بالہٕ دامنَس تل جمع سپٕدؠ تہٕ تِمو ووٚنُس نارٕ منٛزؠ بڈِ ییٚلہِ بال ابرٕ سٟتؠ ؤلِتھ ٲسؠ۔ تٔمؠ ؤنؠ صرف تِمے داہ احکام تہٕ بس۔ تٔمؠ لیٚکھؠ تِم کنہِ وٮ۪ن دوٚن تختی ین پٮ۪ٹھ تہٕ دتِن مےٚ۔\f + \fr 5‏:22 \ft خروج 20:1-17\f*
\p
\v 23 ییٚلہ تُہنٛدیو جدٕاجدادو یہُوواہؔ سنٛز آواز بوز ییٚلہ سُہ انہِ گٔٹس منٛز تِمن سٟتؠ کتھٕ اوس کران ییٚلہ زن پہاڑس پٮ۪ٹھ نارٕ الاو دزان اوس، تہنٛدِ قبیلٕکؠ قٲید تہٕ بُزرگ آے مےٚ نِش،\f + \fr 5‏:23 \ft عبر 12:19\f*
\v 24 تہٕ تِمو منٛزٕ ووٚن أکؠ، "سٲنؠ کتھ بوزیٚو! سٲنؠ خدا یہُوواہنؔ ہوو اسہِ زِ سُہ چُھ سٮ۪ٹھاہ عظیم تہٕ جلالہٕ وول ییٚلہ سُہ اسہِ نارٕ منٛزؠ بولان وُچھ۔ از کوٚر اسہِ محسوس زِ اسہِ انسانن ہنٛدِ باپتھ چُھ زنٛدٕ روزُن ممکن یوٚدوے زن خداین اسہِ سٟتؠ کتھ کٔر۔\f + \fr 5‏:24 \ft خروج 19:19\f*
\v 25 مگر أسؠ چُھ کھۅژان زِ أسؠ مرو۔ اسہِ چُھ وہمہٕ زِ یہِ بوٚڈ بارٕ نار زالہِ اسہِ سارنے، اگر أسؠ یہُوواہؔ سنٛز آواز بیٚیہِ بوزو۔\f + \fr 5‏:25 \ft عبر 12:19\f*
\v 26 زمیٖنس پٮ۪ٹھ چھِ أسؠ واحد جماتھ یۅسہ قدرتہٕ وٲلِس خدایہ سنٛز کتھ نارٕ منٛزؠ بوزنہٕ پتہٕ تہِ زنٛدٕ چھےٚ!\f + \fr 5‏:26 \ft اِستِثنا 4:33\f*
\v 27 اے موسیٰؔ، ژٕ کھس پہاڑس پٮ۪ٹھ تہٕ بوز یہ کینٛژھا سون خدا یہُوواہؔ ونہِ۔ پتہٕ ؤنزیٚو واپس یِتھ تہِ سورےٕ اسہِ تہٕ أسؠ بوزو تہٕ کرو تتھ پٮ۪ٹھ عمل۔
\v 28 یہُوواہنؔ بوز چانٮ۪ن قایِدینن ہُنٛد یہ ونُن تہٕ ییٚلہ بہٕ پہاڑس پٮ۪ٹھ واپس گوس تہٕ یہُوواہنؔ ووٚن مےٚ زِ مےٚ بوز چانٮ۪ن سردارن ہنٛز کتھ تہٕ یہ کینٛژھا تِمو ووٚن تہِ چُھ ٹھیک۔
\v 29 بہٕ چُھس پٔزؠ پٲٹھؠ یژھان زِ تِم سونٛچِن ہمیشہٕ یتھے پٲٹھؠ تہٕ میٚون احترام کٔرِتھ کٔرِنؠ میانٮ۪ن احکامن پٮ۪ٹھ عمل تاکہِ تِمن تہٕ تِہنٛدین اولادن ہنٛدِ خٲطرٕ روزِ ہمیشہ باپتھ بہتر۔
\v 30 لہٰذا وس بوٚن تہٕ ون تِمن زِ تِم گژھن پننٮ۪ن خٟمن منٛز واپس۔
\v 31 مگر پتہٕ ییہِ زِ ژٕ یور واپس تہٕ گٔژھزِ مےٚ برُونٛہہ کنہِ کھڑا، تہٕ بہٕ دِمے ژےٚ تِم تمام احکام تہٕ اصول یِم بہٕ یژھان چُھس زِ تِم مانن۔ پتہٕ ہیٚکہٕ ہکھ ژٕ تِم لوٗکھ ہیٚچھناوِتھ تاکہِ یۅتام تِم یتھ ملکس منٛز روزن یُس بہٕ تِمن دِوان چُھس مانن تمہٕ سارے کتھٕ۔\f + \fr 5‏:31 \ft گلتی 3:19\f*
\v 32 یتھ کنؠ گوس بہٕ لوٗکن نِش بیٚیہِ واپس تہٕ ووٚنمکھ، "یقین تھٲیو زِ توٚہؠ کٔریٚو تہِ سورےٕ یہ سون خدا یہُوواہؔ اسہِ کرنُک حکم دِوان چُھ۔ تمسنٛدِ کُنہِ قانونٕچ نافرمٲنی مہٕ کٔریٚو\f + \fr 5‏:32 \ft امسنٛدِ کُنہِ تہِ قانونٕچ نافرمٲنی مہٕ کٔرِو۔\f*
\v 33 پنٕنؠ زنٛدگی گزاریٚو تِتھے پٲٹھؠ یتھٕ پٲٹھؠ سٲنؠ خدا یہُوواہنؔ اسہِ حکم کوٚر۔ تاکہ توٚہؠ گزاریٚو زیٹھ وانٛس، تہٕ ییٚلہ توٚہؠ یتھ ملکس منٛز روزیٚو یمِکؠ توٚہؠ بسکیٖن بنیو تہٕ تُہنٛدِ خٲطرٕ سپدِ بہتر۔"
\c 6
\p
\v 1 یِم چھِ تِم احکام، قوٲعِد تہٕ ضوٲبط یِم سٲنؠ خدا یہُوواہنؔ مےٚ توٚہؠ ہیٚچھِ ناونٕکؠ حکم کوٚر۔ سُہ چُھ یژھان زِ توٚہؠ کٔریٚو یتھ ملکس منٛز تمؠ سنٛز عبادت یتھ منٛز توٚہؠ ینہٕ وٲلؠ تہٕ قبضہٕ کرن وٲلؠ چُھو۔
\v 2 سُہ چُھ یژھان زِ توٚہؠ کٔریٚو تس تعظیم تہٕ بیٚیہِ کٔریٚو توٚہؠ تہٕ تُہنٛدؠ اولاد ہمیشہٕ تِمن اصولن تہٕ ضٲبطن پٮ۪ٹھ عمل یمہٕ بہٕ توٚہہِ ونان چُھسو، تاکہِ توٚہؠ روزیٚو واریہس کالس زنٛدٕ۔
\p
\v 3 لہٰذا، اے اسرائیل کیٚو لوٗکو، بوزیٚو تہنٛز کتھ غورٕ سان تہٕ کٔریٚو تمؠ سنٛز عبادت۔ اگر توٚہؠ یہ کٔریٚو توٚہہ سٟتؠ سپدن ماملات ٹھیک، تہٕ توٚہؠ بٔنیٚو اکھ بوٚڈ قوم ییٚلہ توٚہؠ یتھ ذرخیز زمینہٕ پٮ۪ٹھ بسنہِ لگیٚو۔ یہ سپدنُک وعدہ یہُوواہنؔ یمسنٛز عبادت سٲنؠ جدٕاجداد کران ٲسؠ کوٚرمُت چُھ۔\f + \fr 6‏:3 \ft امیر تہٕ واریاہ ذرخیز ملک۔\f*
\p
\v 4 اسرائیل کیٚو لوٗکو، بوزیٚو! صرف چُھ یہُوواہؔ سون خدا۔
\v 5 توٚہہِ چُھ تس وژھِ وٲنجہِ محبت کرُن، یتھ کٔنؠ تہِ توٚہہِ محسوس سپدِ تہٕ پرٮ۪تھ رنٛگہٕ یتھ کنؠ تہِ توٚہؠ کٔرِتھ ہکیٚو۔
\p
\v 6 یِم احکام مٔشرٲوؠ زیٚو نہٕ زانٛہہ یمہٕ بہٕ توٚہہِ از ونان چُھسو۔
\v 7 یِم ہیٚچھٕ ناوؠ زیوکھ پنٕنؠ بچہٕ بار بار۔ یِمن متعلق کٔرزیٚو پرٮ۪تھ وزِ کتھ۔ ییٚلہ تہِ، توٚہؠ پننِس گھرس منٛز ٲسیٚو، ییٚلہ توٚہؠ نیٚبرؠ چکر کران ٲسیٚو، یِمن متعلق روزیٚو کتھ کران چاہے توٚہؠ لَر ترٲوِتھ ٲسِو یا پکان ٲسیٚو۔\f + \fr 6‏:7 \ft اِفِسیوں 6:4\f*
\p
\v 8 یِم لیٚکھیٚو لۅکٹٮ۪ن لۅکٹٮ۪ن طُمارن پٮ۪ٹھ تہٕ پتہٕ تھٲیو تِمہ نرٮ۪ن گنٛڈِتھ، تِمہٕ تھٲیو تِمن پٹٮ۪ن پٮ۪ٹھ لیٚکھِتھ یمہٕ توٚہؠ ڈٮ۪کس گنٛڈان چُھو تاکہِ توٚہہِ روزن یمہٕ یاد۔
\v 9 یمہٕ تھٲیو پننٮ۪ن گھرٕ کٮ۪ن چۅکاٹھن تہٕ شہرٕ کٮ۪ن دروازن پٮ۪ٹھ لیٚکھِتھ۔
\p
\v 10 سٲنؠ خدا یہُوواہنؔ چُھ تُہنٛدین جدٕاجدادن ابراہامؔ، اضحاقؔ تہٕ یعقوبسؔ سٟتؠ پۅختہٕ وعدہ کوٚرمُت زِ سُہ دییہِ توٚہہِ تِژھ اکھ زمین یتھ منٛز گۅڈے بٔڈؠ تہٕ خوشحال شہر آسن یمہِ نہٕ توٚہہِ بنٲومٕتؠ آسن۔
\v 11 تِمو ووٚن زِ تِمن شہرن ہنٛدؠ گھرٕ آسن تِتھیٚو جان چیزو سٟتؠ گۅڈے بٔرِتھ یمہٕ کٲنٛسہِ بدلن تتہِ تھٲے مٕتؠ آسن۔ توٚہہِ آسن نہٕ تِمہٕ تتہِ تھٲے مٕتؠ۔ کریرؠ آسن یمہٕ خبر کٔمو کھٔنمٕتؠ آسن۔ دچھِ باغ تہٕ زیتون کُلؠ آسن یمہٕ بدل کٲنٛسہِ لٲگمٕتؠ آسن۔ بس! ییٚلہ یہُوواہؔ توٚہہِ تتھ ملکس منٛز واتناوِ تہٕ توٚہہِ آسہ پرٮ۪تھ اکھ سُہ چیز میسر یُس توٚہؠ کھیٚون یژھیٚو۔
\v 12 پژھ تھٲے زیٚو تہٕ یہُوواہؔ مٔشرٲی زیٚون نہٕ، یمؠ توٚہؠ مِصرٕ منٛزٕ غلامی نِشہ کٔڈؠ نو تہٕ یِم سٲری چیز دِتؠ نو۔
\p
\v 13 توٚہہ پزیٚو سٲنِس خدا یہُوواہسؔ تعظیم کرُن تہٕ صرِف تمؠ سنٛزےٕ عبادت کرٕنؠ۔ ییٚلہ توٚہؠ پوٚز وننُک یا کانٛہہ کٲم کرنُک پوٚز قسم کھیٚوان ٲسیٚو سُہ گژھِ تمسنٛدے ناوُک کھیٚون۔
\v 14 توٚہہِ پزِ نہٕ کٲنٛسہِ دویمِس دیوتا سنٛز پوٗزا کرٕنؠ یِمن دیوتاہن ہنٛز پوٗزا یتھ ملکس منٛز روزن وٲلؠ لوٗکھ کران چھِ۔\f + \fr 6‏:14 \ft لوٗکن ہنٛد دیوتا یم توٚہہِ انٛدؠ پٔکؠ چھِ آسان، تم چھِ کنعٲنین ہنٛدِ طرفہٕ پوٗزا کرنہٕ آمتیٚن دیوتاہن ہُنٛد حوالہٕ دِوان۔\f*
\v 15 سون خدا یہُوواہؔ یُس توٚہہِ منٛز روزان چُھ کرِنہٕ تِمن لوٗکن قبوٗل یمہٕ بدل کٲنٛسہِ ہنٛز عبادت کران آسن۔ لہٰذا اگر توٚہؠ کٲنٛسہِ دویمِس معبودن سنٛز عبادت کٔریٚو تہٕ یہُوواہؔ سپدِ توٚہہِ پٮ۪ٹھ سٮ۪ٹھاہ ناراض تہٕ سُہ کرِ توٚہہِ پوٗرٕ پٲٹھؠ تباہ۔
\p
\v 16 یہ ازماونہٕ باپتھ گژھن نہٕ گناہ کرٕنؠ زِ یہُوواہؔ دیا اسہِ سزا کنہٕ نہ، یتھٕ کِنؠ زن تُہنٛدیٚو جدٕاجدادو مسہؔ ہس منٛز کوٚر۔\f + \fr 6‏:16 \ft خروج 17:1 پٮ۪ٹھٕ 7 تام \f*
\v 17 اتھ کتھہِ پٮ۪ٹھ تھٲیو یقین زِ توٚہؠ روزیٚو ہمیشہٕ تِمن تمام قٲیِدن، سنٛجیدٕ ہِدایِتن تہٕ احکامن ہنٛز تعمیل کران یمہٕ تٔمؠ توٚہہِ دِتؠ۔
\p
\v 18 تی کٔریٚو یہِ یہُوواہؔ افضل تہٕ بہتر ونان چُھ۔ اگر توٚہؠ تہِ کران چُھو تہٕ توٚہہِ سٟتؠ سپدن بہتر ماملات۔ توٚہؠ گٔژھیٚو تتھ اصل زمینس منٛز دٲخٕل تہٕ تتھ پٮ۪ٹھ کٔریٚو قبضہٕ یُس یہُوواہنؔ سانٮ۪ن جدٕاجدادن دِنُک وعدہ کوٚرمُت چُھ۔
\v 19 یتھٕ کِنؠ زن تٔمؠ وعدہ کوٚرمُت چُھ زِ سُہ کڈِ تُہنٛدین دشمنن یمہِ ملکہٕ منٛزٕ دفاہ۔
\p
\v 20 آینٛدٕ پرِژھن تُہنٛدؠ بچہٕ توٚہہ، "سٲنؠ خدا یہُوواہنؔ کیازِ کوٚر اسہِ یِمن تمام اصولن تہٕ احکامن ہُنٛد تعمیل کرنُک حکم؟
\v 21 پتہٕ ؤنیٚو توٚہؠ تِمن، "سٲنؠ جدٕاجداد ٲسؠ مِصرس منٛز بادشاہ، مگر یہُوواہنؔ أنؠ تِم پننہِ قدرتہٕ والہِ، طاقتہٕ سٟتؠ مِصرٕ منٛزٕ کٔڈِتھ
\v 22 تِمو وُچھ سُہ مِصرٕ کٮ۪ن لوٗکن، بادشاہ تہٕ عہدٕدارن سٟتؠ رنٛگہٕ رنٛگہٕ معجزٕ تہٕ خوفناک کامہِ کران۔\f + \fr 6‏:22 \ft مِصری بادشاہ\f* \f + \fr 6‏:22 \ft خروج 7:14، 10:29\f*
\v 23 تِمو تراوٕنٲوؠ سٲنؠ جدٕاجداد مِصر تہٕ أنِکھ یہ ملک رٹنہٕ باپتھ تِم یور، یتھ کنؠ زن تِمو سانٮ۪ن جدٕاجدادن سٟتؠ یہ کرنُک وعدہ کوٚرمُت اوس۔
\p
\v 24 تہٕ تِمو دیُت اسہِ تِمن تمام قانونن ہُنٛد تعمیل کرنُک تہٕ پانس تعظیم کرنُک حکم تاکہِ اسہِ سٟتؠ روزن ماملات ٹھیک تہٕ سُہ دییہِ سٲنِس قومس حفاظت کٔرِتھ ترقی ہُنٛد موقہٕ، یتھ کنے سُہ وۅنؠ کران چُھ۔
\v 25 سون خدا یہُوواہؔ روزِ اسہِ رٲضؠ اگر أسؠ تِمن سارنی کتھن پٮ۪ٹھ عمل کرو یمیُک تٔمؠ اسہِ حکم کوٚرمُت چُھ۔
\c 7
\p
\v 1 سون خدا یہُوواہؔ نیٚیہ، توٚہہ تتھ ملکس منٛز یتھ پٮ۪ٹھ توٚہؠ جلدےٕ دٲخل سپدِتھ قبضہٕ کٔریٚو۔ ییٚلہِ توٚہؠ برُونٛہہ پکیٚو تہٕ سُہ کڈِ تمہِ ملکہٕ منٛزٕ ستن لُکہٕ جمٲژن یمہٕ تُہنٛدِ کھۅتہٕ زیادٕ طاقتور تہٕ تعدادٕ کِنؠ تہِ زیادٕ چھِ۔ یمہٕ جمٲژ آسن، حِتی، جِرجاس، عمور، کنعان، فِرزی، حوی تہٕ یبوسی لوٗکن ہنٛزٕ۔\f + \fr 7‏:1 \ft اعمال 13:19\f*
\p
\v 2 ییٚلہ سون خدا یہُوواہؔ توٚہہِ تِمن شِکس دِنس لایکھ بناوِ تہٕ توٚہؠ مٲرؠ زیوکھ تِم سٲری۔ توٚہہ پزِ نہٕ تِمن سٟتؠ کانٛہہ تہٕ مہادٕ کرُن، تہٕ نہٕ پزِ تِمن سٟتؠ رحمس کٲم ہیٚنؠ۔
\v 3 توٚہؠ کٔرؠ زیٚو نہٕ تِمو منٛزٕ کٲنٛسہِ تہِ سٟتؠ خاندر۔ توٚہؠ دی زیٚو نہٕ پننٮ۪ن کورٮ۪ن تِہنٛدین گۅبرن سٟتؠ خاندر کرنُک اجازت، تہٕ نہ دی زیٚو پننٮ۪ن گۅبرن تہنٛزِ کٲنٛسہِ کورِ سٟتؠ خاندر کرنُک اجازت۔
\p
\v 4 اگر توٚہہِ تہِ کوٚرو، تِم لوٗکھ رٹن تُہنٛدین اولادن یہُوواہؔ تہٕ باقی رسولس ین ہنٛز عبادت کرنہٕ نشہٕ پتھ۔ اگر تہِ سپُد، تہٕ یہُوواہؔ سپدِ توٚہہ پٮ۪ٹھ سٮ۪ٹھاہ ناراض تہٕ سُہ کریٚو توٚہہ جلدی تباہ۔
\v 5 توٚہہ چُھ تِمن لوٗکن سٟتؠ یتھٕ پٲٹھؠ کرُن: تہنٛزٕ قربان گاہ لہُرٕ ونہِ، تمہٕ کنٮ۪ن ہنٛدؠ ستون پُھٹراونؠ یمہٕ تہنٛدٮ۪ن دیوتاہن ہنٛدِ خٲطرٕ آسن، تمہٕ تھمب ژٔٹؠ زیوکھ یمہٕ تِمہ عیشرہ دیوی ہنٛزٕ پوٗزایہ باپتھ استعمال کران چھِ تہٕ تِہنٛدؠ بنٲومٕتؠ بُت ژھنؠ زیوکھ زٲلِتھ۔\f + \fr 7‏:5 \ft عشیرہ، جنسی لولچؠ دیوی تہٕ بعلؔ دیوتا سنٛز شریک یا تمؠ سنٛز مونث ہم منصب۔ یہِ ٲس عستارات ناوٕ سٟتؠ تہِ زاننہٕ یِوان۔\f*
\p
\v 6 توٚہہِ پزِ یہ لٲزمی کرُن تکیازِ توٚہہِ لوٗکن ہنٛز اکھ جماتھ چھےٚ یۅسہ صرف سٲنِس خدا یہُوواہؔ سنٛز چھےٚ۔ تٔمؠ ژٲرؠ نو توٚہؠ دنیاچو تمام لُکہٕ جمٲژو منٛزٕ پنٕنؠ خاص لوٗکھ بننہٕ باپتھ۔
\p
\v 7 یہ اوس نہٕ اوٕ موٚکھٕ زِ توٚہؠ چُھو باقی جمٲژو کھۅتہٕ تعدادس منٛز زیادٕ یمہٕ توٚہؠ یہُوواہنؔ ژٲرؠ مٕتؠ چُھو۔ توٚہؠ چُھو زمینس پٮ۪ٹھ ساروےٕ کھۅتہٕ لۅکٹیٚو جمٲژو منٛزٕ اکھ۔
\v 8 بلکہِ چُھ یہ اوٕ موٚکھٕ زِ یہُوواہنؔ کوٚر توٚہہ سٟتؠ محبت تہٕ اوٕ موٚکھٕ تہِ زِ سُہ اوس یی کرُن یژھان یمیُک تٔمؠ تُہنٛدین جدٕاجدادن سٟتؠ وعدہ اوس کوٚرمُت۔ یہےَ وجہ چُھ زِ تمؠ دیُتنو توٚہہ مِصرچہِ غلامی تہٕ مِصرٕ کِس بادشاہ فرعونس نِش نجات۔
\p
\v 9 مگر یہ مٔشرٲؠ زیٚو نہٕ زِ یہُوواہؔ چُھ سون خدا۔ سُہ چُھ اسہِ پٮ۪ٹھ مہربان۔ سُہ چُھ تِمن لوٗکن ہنٛزن ساسہٕ واد پیٖرین باپتھ پاسدٲری ہُنٛد عہد کران یمہٕ تس سٟتؠ محبت کران چھِ تہٕ تمسنٛدین احکامن پٮ۪ٹھ عمل چھِ کران۔
\v 10 وۅنؠ یمہٕ تس سٟتؠ نفرت کران چھِ، سُہ چُھ تِمن تمیُک جزا دِوان۔ سُہ دییہِ تِمن سزا تہٕ کریٚکھ جلد تباہ۔
\p
\v 11 لہٰذا پزِ توٚہہ تِمن تمام احکامن، قٲیِدن تہٕ فرموداتن پٮ۪ٹھ عمل کرٕنؠ یمہٕ بہٕ توٚہہ از دِوان چُھسو۔
\p
\v 12 اگر توٚہؠ یمن احکامن کُن دھیان دِیو تہٕ ہمیشہٕ یمن پٮ۪ٹھ عمل کریٚو تہٕ سون خدا یہُوواہؔ کرِ تی یہ تٔمؠ تُہنٛدِ باپتھ یُژھمُت چُھ تہٕ سُہ کرٕ کُھلہ دِلہٕ توٚہہِ سٟتؠ محبت یمیُک تٔمؠ تُہنٛدین جدٕاجدان سٟتؠ وعدہ کوٚرمُت چُھ۔
\v 13 سُہ ورتاوِ توٚہہ سٟتؠ لول تہٕ کریٚو برکت۔ سُہ دییہِ توٚہہِ واریاہ اولاد پٲدٕ کرنٕچ صلاحیت۔ سُہ کرِ تُہنٛدِس زرعاتس برکت، تمیُک نتیجہ نیرِ یہ زِ توٚہہ نشہٕ آسہ مےَ بناونہٕ باپتھ واریاہ پھسٕل تہٕ دچھ تہٕ زیتون تیٖل تہِ آسہ واریاہ زیادٕ۔ توٚہہ نِش آسن واریاہ گٲو تہٕ تیٖر۔ سُہ کرِ تُہنٛدِ باپتھ یہ سورےٕ یتھ ملکس منٛز یمیُک تٔمؠ تُہنٛدین جدٕاجدان دِنُک وعدہ کوٚرمُت چُھ۔
\p
\v 14 سُہ کرِ توٚہہِ تمہِ نِشہ تہٕ زیادٕ برکت ییژاہ سُہ کانٛسہ دویمہِ جمٲژ برکت کرِ۔ توٚہہ سارنی آسن اولاد۔ تُہنٛدؠ چو چاروٲے تہِ آسن بچہٕ پٲدٕ کرنس قٲبل۔
\v 15 تہٕ یہُوواہؔ بچاوِ توٚہہ تمام بیماریٚو نشہٕ۔ سُہ کرِ نہٕ توٚہہِ تِمو مہلِک بیمارین منٛز مُبتلا یمن متعلق سٲنؠ جدٕاجداد مِصرس منٛز وٲقف چھِ، بلکہ کرِ سُہ تِمو سٟتؠ تُہنٛدؠ تمام دشمن بیمار۔
\p
\v 16 توٚہہ پزٕنو تِمن تمام لوٗکن ہنٛزٕ جمٲژ تباہ کرنہِ یِمن پٮ۪ٹھ سون خدا یہُوواہؔ توٚہہِ فتح دِنس قٲبل بناوِ۔ تِمو منٛزٕ کٔرؠ زیٚو نہٕ کٲنٛسہِ پٮ۪ٹھ رحم۔ تہٕ تِہنٛدین معبودن ہنٛز عبادت کٔرؠ زیٚو نہٕ، تکیازِ اگر توٚہؠ تہِ کٔریٚو تہٕ یہ چُھ تِتھس ژھلس منٛز پھسنَس برابر یمہِ منٛزٕ نہٕ توٚہؠ زانٛہہ تہِ بٔچِتھ ہکیٚو۔
\p
\v 17 پانس سٟتؠ سونچہِ زیٚو نہٕ یہ زِ "یمہ لوٗکھ چھِ سانہِ کھۅتہٕ ژٔرؠ۔ تہٕ أسؠ ہیٚکہٕ ووکھ نہٕ تمہٕ زانٛہہ تہِ کٔڈِتھ۔"
\v 18 یِمن مہٕ کھۅژیٚو۔ امہِ بجایہ سونچہِ زیٚو زِ سٲنؠ خدا یہُوواہنؔ کیاہ کوٚر مِصرٕ کِس بادشاہ تہٕ تِمن سارنی لوٗکن سٟتؠ یِمن پٮ۪ٹھ تٔمؠ حکومت کٔر۔
\v 19 تمہٕ ہٲبتناک آفژٕ مہٕ مٔشرٲیو یمہٕ تُہنٛدیٚو جدٕاجدادو مِصرٕ کیٚن لوٗکن پٮ۪ٹھ یوان وُچھٕ تہٕ تمہٕ رنٛگہٕ رنٛگہٕ معجزات یمہٕ خداین تُہنٛدؠ جدٕاجداد مِصرٕ منٛزٕ کڈنہٕ باپتھ کٔرؠ۔ سون خدا یہُوواہؔ کرِ یِمن لُکہٕ جمٲژن سٟتؠ تی یتھ توٚہؠ وۅنؠ کھۅژان چُھو۔
\p
\v 20 امہِ علاوٕ یتہِ زِ سُہ کھۅژٕ ناوِ تِمن تہٕ سُہ کرِ تِمن ہلاک یمہٕ زنٛدٕ روزن تہٕ توٚہہ نِش ژوٗرِ روزنہٕ باپتھ ژلن۔\f + \fr 7‏:20 \ft گبھراہٹ۔\f* \f + \fr 7‏:20 \ft خروج 23:28؛ یشوع 24:12\f*
\v 21 تِمن لوٗکہٕ جمٲژن مہٕ کھۅژیٚو تکیازِ سون خدا یہُوواہؔ چُھ توٚہہ سٟتؠ۔ سُہ چُھ بوٚڈ خدا۔ سُہ چُھ سُے یس لوٗکھ کھۅژان چھِ۔
\p
\v 22 سُہ ژھٕنہِ وار وارٕ تِمن لُکہٕ جمٲژن کٔڑِتھ۔ توٚہؠ کٔرؠ زیٚو نہٕ تمہٕ سٲری اکے ساعتہٕ کڈنٕچ کوشِش تکیازِ اگر توٚہؠ تہِ کٔریٚو تہٕ تیٚلہ گژھِ جنگلی جانورن ہنٛدِس تعدادس منٛز تیزی سان اضافہٕ تہٕ توٚہؠ ہکیٚو نہٕ تِمو نشہٕ پان بچٲوِتھ۔\f + \fr 7‏:22 \ft خروج 23:29، 23:30\f*
\p
\v 23 امہِ بجایہ، بناوِ یہُوواہؔ توٚہہِ پننٮ۪ن دشمنن اکہِ وقتہٕ أکِس جمٲژ شِکس دِنس قٲبل۔ سُہ کرِ تِمن خوفس منٛز مبتلا یۅتام تِمہ تباہ سپدن۔
\v 24 سُہ بنایو توٚہہ تِمن بادشاہن شِکس دِنس قٲبل۔ ییٚلہ توٚہؠ تِم مٲرؠ ووکھ، تِہنٛدؠ ناو گژھن مٔشتھےٕ۔ کانٛہہ تہِ جماتھ ہیٚکہ نہٕ توٚہہِ رکٲوِتھ۔ توٚہؠ کٔرؠ ووکھ تمہٕ سٲری تباہ۔
\p
\v 25 توٚہہ پزن تمہٕ نقشہٕ زالٕنؠ یمہٕ تِہنٛدین دیوتاہن ہنٛدؠ آسن۔ تِمن بُتن پٮ۪ٹھ یُس سۅن تہٕ چانٛدؠ لٲگِتھ آسہ سُہ نِنٕچ خٲہِش کٔرزیٚو نہٕ تکیازِ اگر توٚہؠ سُہ پانس باپتھ نِیو سُہ بنہِ توٚہؠ رٹنہٕ باپتھ اکھ پھنٛد۔ یہُوواہؔ چُھ تِمن بُتن ہنٛدِس پرٮ۪تھ کُنہ حصس سٟتؠ نفرت کران۔
\v 26 توٚہؠ أنؠ زیوکھ نہٕ تِمو مٔکریو بُتو منٛزٕ کانٛہہ تہِ پنُن گھرٕ تکیازِ اگر توٚہؠ تہِ کٔریٚو تہٕ خدا کرِ توٚہہِ پٮ۪ٹھ تِتھے پٲٹھؠ لعنت یتھٕ پٲٹھؠ سہ تِمن پٮ۪ٹھ لعنت سوزان چُھ۔ توٚہہ پزِ تِمن بُتن سٟتؠ نفرت تہٕ تِم حقیر زانٕنؠ، تکیازِ یِم چھِ تِم چیز یِمن یہُوواہنؔ لعنت کٔر تہٕ تِم تباہ کرنُک وعدہ کوٚر۔"
\c 8
\p
\v 1 "توٚہؠ کٔرؠ زیٚو وفادٲری سان تِمن سارنی احکامن ہنٛز تعمیل یمہ مےٚ از توٚہہ دِتؠ۔ اگر توٚہؠ تہِ کٔریٚو، توٚہؠ روزیٚو واریہس وقتس زنٛدٕ، تُہنٛزِ آبٲدی منٛز گژھِ ہُرٮ۪ر، تہٕ تُہنٛدؠ لوٗکھ کرن تتھ زمیٖنس پٮ۪ٹھ قبضہٕ یۅسہ یہُوواہنؔ تُہنٛدین جدٕاجدادن توٚہہ دِنُک وعدہ کوٚرمُت چُھ۔
\v 2 تہٕ توٚہؠ مٔشرٲؠ زیٚو نہٕ زِ سٲنؠ خدا یہُوواہنؔ کِتھٕ کنؠ پکہٕ نٲوؠ أسؠ پتمیٚن ژتجہن ورین یمو بیابانو منٛزؠ۔ تٔمؠ تراونو توٚہؠ واریہن مشکِلاتن منٛز تاکہِ توٚہؠ یِیو ازماونہٕ، سُہ اوس توٚہہِ احساس دیُن یژھان زِ توٚہہ چُھنہٕ پانس پٮ۪ٹھ بلکہ تس پٮ۪ٹھ بھروسہٕ کرنُک ضرورت، سُہ اوس زانُن یژھان زِ توٚہؠ کیاہ چُھو کرُن یژھان، توٚہؠ کٔروا تمسنٛدین احکامن پٮ۪ٹھ عمل کِنہٕ نہ۔
\p
\v 3 اوٕ مۅکھٕ ترٲوؠ نو تٔمؠ توٚہؠ مشکِلاتن منٛز۔ تٔمؠ تھٲوؠ نو توٚہؠ بۅچھِ ۂتؠ۔ پتہٕ سوزؠ نو تٔمؠ توٚہہ مَنّ آسمٲنی کھیٚن، سُہ کھیٚن یُس نہٕ توٚہہ یا تُہنٛدیٚو جدٕاجدادو زانٛہہ تہِ کھیٚمُت اوس۔ تٔمؠ کوٚر یہ توٚہؠ ہیٚچھِ ناونہ باپتھ زِ لوٗکن چُھ جسمس باپتھ کھیٚن ضرورت، مگر تِمن چُھ روحس تہِ کھیٚن دِنُک ضرورت، یُس یہُوواہؔ سنٛزِ پرٮ۪تھ کتھِ کُن توجہ دنہٕ سٟتؠ حٲصِل سپدان چُھ۔\f + \fr 8‏:3 \ft خروج 16، گریند 11:8، 11:7\f*\f + \fr 8‏:3 \ft متی 4:4، لوق 4:4، 1 کورنتھ 10:3 \f*
\p
\v 4 یِمن ژتجہن ورؠ ین ژھیٚنؠ نہٕ سٲنؠ پلو تہٕ صحراوو منٛزؠ پکنہٕ سٟتؠ آے نہٕ سٲنؠ کھۅر پھٔلِتھ۔
\v 5 ینہٕ یہ مٔشرایو زِ سون خدا یہُوواہؔ چُھ اسہِ ہِدایت کران تہٕ سزا دِوان یتھٕ کِنؠ زن مول موج اولادن اصلاح کران چھِ۔\f + \fr 8‏:5 \ft عبر 12:7\f*
\p
\v 6 لہٰذا کٔریٚو سٲنِس خدا یہُوواہؔ سنٛدین حکمن ہنٛز تعمیل تہٕ پننہِ زندگییہِ پکنٲیو تِتھے پٲٹھؠ یتھ پٲٹھؠ سُہ یژھان چُھ تہٕ تس کٔریٚو تعظیم۔
\p
\v 7 سُہ چُھ توٚہہ أکِس اصلِس زمیٖنس پٮ۪ٹھ نِنہٕ وول، یتھ منٛز پہاڑو پٮ۪ٹھٕ وسونہِ کۅلہٕ تہٕ مٲدانن منٛز ناگ وُزان آسن۔
\v 8 یہ چھےٚ اکھ تِژھ زمیٖن یتھ منٛز کٕنکھ تہٕ جو وۅپدان آسہ، سۅ زمین یتہِ انجیر تہٕ دٲن کُلؠ آسن تہٕ تِژھ زمیٖنا یتہِ زیتون تیٖل تہٕ مانٛچھ آسہ۔
\p
\v 9 یہ چھےٚ سۅ سرِ زمیٖن یتہِ تُہنٛدِ باپتھ وفور کھیٚن آسہ، یتہِ نہٕ توٚہہ کُنہِ چیزٕچ کٔمی باسہِ، تِژھ زمیٖن یمہ چن کنیٚن منٛز خام شستٕر آسہ تہٕ توٚہؠ ہکیٚو تمکیٚو پہاڑو منٛزٕ ترام کٔڈِتھ۔
\v 10 توٚہؠ روزیٚو پرٮ۪تھ دوٚہہ تۅتام کھیٚوان یۅتام نہٕ توٚہہِ یڈ آسہ یوان تہٕ توٚہؠ ٲسؠ زیٚو سٲنِس خدا یہُوواہؔ سُنٛد امہِ ذرخیز زمینہِ باپتھ شکریہ کران یۅسہ تٔمؠ توٚہہِ دِژ۔
\p
\v 11 مگر ییٚلہ یہ سپدِ حیٚس تھٲو زیٚو ینہٕ سٲنس خدا یہُوواہؔ سنٛدین احکامن، اصولن تہٕ ضوٲبطن ہنٛز نافرمانی کٔرتھ یہ مٔشرایو یہ بہٕ از توٚہہ دِوان چُھس۔
\v 12 توٚہہ آسہ پرٮ۪تھ دوٚہہ یڈ بٔرِتھ یوان تہٕ توٚہؠ بنٲیو اصل گھرٕ یتہِ توٚہؠ روزان ٲسیٚو۔ مگر توٚہؠ مشرایو یہُوواہؔ سنٛدؠ احکام۔
\p
\v 13 یقینن ییٚلہ تُہنٛدین چارواین تہٕ تیٖرن ہنٛز تعداد واریاہ بڈِ تہٕ ییٚلہ توٚہہ واریاہ چٲنٛدؠ تہٕ سۅن جمع گژھِ تہٕ تُہنٛدین باقی تمام چیزن ہنٛدِس تعدادس منٛز ہُریر سپدِ۔
\v 14 یقین تھٲوؠ زیٚو ینہٕ غرور سپدیٚو تہٕ سون خدا یہُوواہؔ مٔشراے وون یمؠ تُہنٛدؠ جدٕاجداد مِصرچہِ غلامی نشہٕ آزاد کٔرِتھ تتہِ کٔڈِتھ أنؠ۔
\p
\v 15 ینہٕ یہ مٔشرایو زِ ییٚلہ تِم تمہِ بڈِ تہٕ ہولناک صحراوٕ منٛزؠ سفر کران ٲسؠ تہٕ تٔمؠ کٔر تِمن تتہِ رہنمٲئی یتہِ زہریلہٕ سرف تہٕ بِچ ٲسؠ۔ تہٕ یتہِ مٔشرٲوؠ زیٚو نہٕ زِ یتہِ زمیٖن واریاہ خۅشٕک ٲس تہٕ آبےٕ اوس نہٕ، تٔمؠ کۅڈ تِہنٛدِ باپتھ سخت کنہِ منٛزٕ آب۔\f + \fr 8‏:15 \ft گریند 20:2 پٮ۪ٹھٕ 13 تام\f*
\p
\v 16 یتہِ مٔشراوؠ زیٚو نہٕ زِ تتھ سہراوس منٛز سوزؠ تٔمؠ تُہنٛدین جدٕاجدادن کھیٚنہٕ باپتھ تِمن "مَنّ، سُہ کھیٚن یُس نہٕ تِمو زانٛہہ تہِ کھیٚمُت اوس۔ سُہ اوس تِمن یہ پژھ دٔرراون یژھان تہٕ یہ احساس دیُن یژھان زِ تِمن چھنہٕ پانس پٮ۪ٹھ بلکہِ تس پٮ۪ٹھ بھروسہٕ کرنٕچ ضرورت۔ تہٕ سُہ اوس تِمن یہ زاننہٕ باپتھ آزماوُن یژھان زِ تِمن کیاہ کرنُک اِرادٕ چُھ، تاکہ یتُھےٕ یم مشکلات ختم سپدن، تہٕ سُہ کرِ تِمن باپتھ واریاہ بہتر چیز۔
\v 17 پژھ کٔرؠ زیٚو تہٕ یہٕ یہ گمانہٕ بٔرؠ زیٚو نہٕ زِ "مےٚ کیاہ کٔرؠ یِم سٲری چیز پننہِ طاقتہٕ تہٕ قٲبلِیتہٕ سٟتؠ حٲصل۔"
\p
\v 18 یہ مٔشرٲوؠ زیٚو نہٕ زِ یہُوواہؔ چُھ سون خدا یمؠ توٚہؠ دولت منٛد بننَس لایکھ بنٲوؠ نو۔ سُہ چُھ یہ اوٕ مۅکھٕ کران زِ سُہ چُھ سۅ وفادٲری نباوان یمیُک تٔمؠ سانٮ۪ن جدٕاجدادن سٟتؠ پوٗرٕ کرنُک وعدہ کوٚرمُت چُھ۔
\p
\v 19 بہٕ چُھسو توٚہؠ خبردار کران زِ اگر توٚہؠ سون خدا یہُوواہؔ مٔشراوِتھ باقی معبودن کُن رٲغب گٔژھیٚو تہٕ تِہنٛز عبادت کٔرِتھ تِمن سجدٕ کرنہِ بِہیٚو تہٕ سُہ کرِ توٚہہ ضروٗر تباہ۔
\v 20 اگر توٚہؠ سانِس خدا یہُوواہؔ سنٛز فرمانبرداری کٔریٚو نہٕ تہٕ سُہ کرِ توٚہہ ضرور تِتھے کِنؠ تباہ یتھٕ کنؠ سُہ تِمن لُکہ جمٲژن تباہ کرِ یِمن خلاف توٚہؠ جنٛگ کٔریٚو۔
\c 9
\p
\v 1 موسیٰؔ ین ووٚن اسرائیل ین مزید، "اے اسرائیلی لوٗکو، میٲنؠ کتھ بوزیٚو! توٚہؠ تٔریٚو عنقریب یردن دریاوس اپور۔ یتھ سرِ زمیٖنس منٛز توٚہؠ دٲخل گٔژھیٚو، تتہِ چھِ بٔڈؠ بٔڈؠ شہر یِمن انٛدؠ انٛدؠ سٮ۪ٹھاہ تھدؠ دیوار یمہٕ آسمانس تام پھٲلِتھ باسان چھِ۔ اتھ سرِزمینہِ پٮ۪ٹھ چھِ لوٗکن ہنٛز تِمہٕ زٕ جمٲژ تُہنٛدِ کھۅتہٕ واریاہ زیادٕ تہٕ طاقتور چھِ۔
\v 2 تِم لوٗکھ چھِ سٮ۪ٹھاہ تٔھدؠ تہٕ مظبوط۔ تِمو منٛزٕ چھِ کینٛہہ دیٚو یمہٕ عناقؔ سنٛدؠ زُرؠ چھِ۔ توٚہؠ چُھو تِمن متعلق زانان تہٕ توٚہہ آسن لوٗکھ یہ ونان وُچھمٕتؠ زِ عناقؔ سنٛدین اولادن ہیٚکہِ نہٕ کانٛہہ شِکست دِتھ۔
\p
\v 3 بہِ چُھس یژھان زِ توٚہؠ زٲنیٚو زِ سون خدا یہُوواہؔ آسہ توٚہہِ برُونٛہہ برُونٛہہ۔ سُہ آسہ دزٕونہِ نارٕکؠ پٲٹھؠ۔ ییٚلہ توٚہؠ برُونٛہہ پٔکیٚو، سُہ دییہِ تِمن شِکس تہٕ کریکھ بُرباد۔ نتیجہ نیرِ یہ زِ توٚہؠ بٔنیٚو جلدےٕ تِمو منٛزٕ تتہِ کینٛہہ کڈنس تہٕ باقی مارنس منٛز کامیاب، یہِ چُھ تہِ یمیُک یہُوواہنؔ وعدہ کوٚرمُت چُھ زِ توٚہؠ کٔریٚو یہِ۔\f + \fr 9‏:3 \ft عبر 12:29\f*
\p
\v 4 ییٚلہ سون خدا یہُوواہؔ تِمن تُہنٛدِ باپتھ تتہِ کٔڈِ تہٕ پانس ؤنزیٚو نہٕ یہ زِ أسؠ چھِ راستباز تہٕ توے بنٲوؠ أسؠ یہُوواہنؔ یتھ ملکس پٮ۪ٹھ قبضہٕ کرنس قٲبل۔ پزر چُھ یہ زِ امہِ ملکٕکؠ لوٗکھ چھِ بُرٕ یمہِ کِنؠ یہُوواہؔ تِمن تٔمہِ سٲتؠ نٮ۪بر کٔڑِتھ ژھٕنہِ ییٚلہِ تتہِ توٚہؠ پیش قدمی کٔرِو۔\f + \fr 9‏:4 \ft رومؔ 10:6\f*
\p
\v 5 بہٕ چُھسو بیٚیہِ تہِ ونان زِ یہ سپُد نہٕ اوٕ موٚکھٕ زِ توٚہؠ چُھو راستباز یا توٚہؠ چُھو نیک کامہِ کران اتھ ملکس منٛز دٲخل سپدتھ قبضہ کرنہٕ خٲطرٕ۔ یہ چُھ اوٕ موٚکھٕ زِ تمہِ ملکٕکؠ لوٗکھ چھِ سٮ۪ٹھاہ خراب تہٕ ییٚلہِ توٚہؠ تور أژیو تہٕ سون خدا یہُوواہؔ کڈِ تِمن بیٚیہِ اوٕ موٚکھٕ تہِ زِ سُہ چُھ سۅ کٲم پوٗرٕ کرنُک وعدہ بنٛد یمیُک تٔمؠ تُہنٛدین جدٕ اجدادن سٟتؠ ابراہامسؔ، اضحاقسؔ تہٕ یعقوبس ستؠ وعدہ کوٚرمُت چُھ زِ سُہ کرٕ یتھٕ کنؠ۔
\p
\v 6 بہٕ چُھس یژھان زِ توٚہؠ زٲنیٚو زِ یہ چُھنہٕ اوٕ موٚکھٕ زِ توٚہؠ چُھو پٔزؠ یٲرؠ تہٕ توے چُھ سون خدا یہُوواہؔ توٚہہ یہ رٕژ زمین دِوان۔ بہٕ چُھس یہ اوٕ موٚکھٕ ونان تکیازِ توٚہؠ چُھو نہٕ پٔزؠ یٲرؠ۔ توٚہؠ چُھو سٮ۪ٹھاہ ضدی لوٗکھ۔"
\p
\v 7 زانٛہہ تہِ گژھِ نہٕ مٔشراوُن زِ تُہنٛدیو جدٕاجدادو کیاہ کوٚر ریگستانس منٛز یمہ کِنؠ سون خدا یہُوواہؔ ناراض سپُد۔ یمہِ دوٚہہ أسؠ مِصرٕ منٛزٕ دراے تتھ دوٚہس تام یۅتام أسؠ یوٚت وٲتؠ، توٚہہ تہِ کٔرو لگاتار تس خلاف بغاوت۔\f + \fr 9‏:7 \ft اِستِثنا 1:33 تہٕ 1:34\f*
\v 8 یۅتام زن تُہینٛدیو جدٕاجدادو کوہہِ سیناؔ ہس\f + \fr 9‏:8 \ft حوریب\f* پٮ۪ٹھ یہُوواہسؔ شرارتھ کھول۔ چونکہ سُہ اوس سٮ۪ٹھاہ شرارتس منٛز یمہِ کنؠ سُہ تِمن سارنی نِشہ تھف تُلناونہٕ باپتھ تیار۔
\p
\v 9 ییٚلہ بہٕ تمِس نِش پہاڑس پٮ۪ٹھ کنیٚو تختی اننہٕ باپتھ کھۅتُس یمن پٮ۪ٹھ تٔمؠ داہ احکام لیٚکھمٕتؠ ٲسؠ، بہٕ رودُس تتہِ ژتجہَن دوٚہُن تہٕ ژتجَہن رٲژن تہٕ تتھ دوران کھیٚو چیٚو نہٕ مےٚ کِہین۔
\v 10 یہُوواہنؔ دژٕ مےٚ کنیٚو تمہٕ زٕ لوحہ یِمن پٮ۪ٹھ تٔمؠ پننیٚو اونٛگجو سٟتؠ احکام لیٚکھمٕتؠ ٲسؠ۔ یِم ٲسؠ تِم الفاظ یمہٕ تٔمؠ تُہنٛدین جدٕ اجدادن پہاڑس پٮ۪ٹھ نارٕ منٛزؠ ؤنمٕتؠ ٲسؠ۔ ییٚلہ تِم پہاڑ کِس دامنس تل سمیامٕتؠ ٲسؠ۔\f + \fr 9‏:10 \ft اعمال 7:38، 2 کورنتھ 3:3\f*
\p
\v 11 یِمن ژتجہن دوٚہُن تہٕ رٲژن ہنٛدِس ٲخرس پٮ۪ٹھ دژٕ مےٚ یہُوواہنؔ تمہٕ زٕ کنہِ یمن پٮ۪ٹھ تٔمؠ یمہٕ احکام لیکھمٕتؠ ٲسؠ۔
\v 12 مگر پتہٕ ووٚن مےٚ تٔمؠ، "جلدےٕ وس پہاڑٕ پٮ۪ٹھٕ بوٚن، تکیازِ یمن لوٗکن ہنٛز ژٕ رہنمٲئی کران چُھکھ، یم لوٗکھ ژےٚ مِصرٕ منزٕ کٔڈؠ تھکھ، تِمو چُھ بوٚڈ گناہ کوٚرمُت۔ تِمو کٔر سٮ۪ٹھاہ جلد سۅ کام یۅسہ مےٚ تِمن نہ کرنُک حکم کوٚرمُت اوس۔ تِمو بنوو پننہِ باپتھ پوٗزایہ خٲطرٕ ؤژھؠ سنٛز مورت۔
\p
\v 13 پتہٕ ووٚن یہُوواہنؔ مےٚ زِ بہٕ رودُس یِمن لوٗکن وچھان تہٕ مےٚ وُچھ زِ یِم چھِ سٮ۪ٹھاہ ضِدی۔
\v 14 تہٕ مےٚ کٔرزیٚو نہٕ رُکاونٕچ کوشش۔ بہٕ چُھسکھ یِم تباہ کرن وٲلؠ، امیُک نتیجہ نیرِ یہ زِ کانٛسہ تہِ روزِ نہٕ یِمن ہُنٛد ناو یاد۔ پتہٕ بناوو بہٕ توٚہؠ اکہ تِتھِ قومٕکؠ اسلاف بناونس قٲبل یِم تُہنٛدِ کھۅتہٕ واریاہ زیادٕ تہٕ طاقتور آسہ۔
\p
\v 15 ٲخر وتُھس بہٕ پہاڑٕ پٮ۪ٹھٕ بوٚن تہٕ کنٮ۪ن ہنٛدؠ تمہٕ زٕ لوحہ تُلم اتھس کٮ۪تھ یمن پٮ۪ٹھ داہ احکام لیٚکِھتھ ٲسؠ۔ سٲرسےٕ پہاڑس پٮ۪ٹھ اوس نار دزان۔
\v 16 مےٚ وُچھ تہٕ یہ وُچِھتھ گوس بہٕ حٲران زِ تُہنٛدیٚو جدٕاجدادو کوٚر یہُوواہسؔ خلاف بوٚڈ گناہ۔ تِمو کرِ جلدےٕ تمہٕ کامہ شروع یمہٕ سٲنؠ خدا یہُوواہنؔ تِمن نہ کرنُک حکم کوٚرمُت اوس۔ تِمو کوٚر ہارونسؔ درخواس زِ سُہ بناوِ تہنٛدِ عبادتہٕ باپتھ ؤژھؠ سنٛز اکھ دھاتو موٗرت۔
\p
\v 17 ییٚلہ تِم وُچھان رودؠ تہٕ مےٚ تُجہ تِمہ دوٚنوے کنیٚو لوحہ تہٕ دِژم پتھر دٔرتھ تہٕ تِمن گےَ ٹُکرٕ۔
\p
\v 18 پتہٕ دیُت مےٚ خدایہ سنٛزِ بارگاہِ منٛز سٔجدٕ یتھ کٔنؠ مےٚ گۅڈٕ کریاو تہٕ مےٚ کھیٚو چیٚو نہٕ ژتجہن دوٚہُن تہٕ ژتجہن رٲژن کِہین۔ مےٚ کوٚر یہ اوٕ مۅکھٕ تکیازِ تُہنٛدیٚو جدٕاجدادو اوس یہُوواہسؔ خلاف گناہ کٔرتھ تمِس واریاہ شرارتھ کھولمُت۔
\p
\v 19 مےٚ اوس خوف تکیازِ یہُوواہؔ اوس تِمن پٮ۪ٹھ ناراض سپُدمُت یمہ کِنؠ نہٕ سُہ تِمن چھڑِ ہے۔ مگر مےٚ مونٛگ بیٚیہِ دُعا زِ سُہ مہٕ کٔرِنؠ یہ، تہٕ تٔمؠ بوز بیٚیہِ تہِ میٚون تہٕ کوٚرن میٚون دُعا قبوٗل۔\f + \fr 9‏:19 \ft عبر 12:21\f*
\v 20 یہُوواہؔ سپُد ہارونؔ سنٛدِس سۅنہٕ سُنٛد وُژھ بناونس پٮ۪ٹھ تہِ ناراض تہٕ اوس تمِس مارنس پٮ۪ٹھ آمادٕ۔ مگر تمی ساعتہٕ موٚنگ مےٚ ہارونؔ سنٛدِ باپتھ تہِ دُعا تہٕ یہُوواہنؔ کوٚر میٚون دُعا قبول۔
\p
\v 21 تُہنٛدیٚو جدٕاجدادو کوٚر ہارونس ؤژھؠ سنٛز دھاتو موٗرت بناونُک درخواست کٔرِتھ بوٚڈ گناہ۔ چنانچہ مےٚ تُج سۅ موٗرت تہٕ ترٲوٕم نارس منٛز پگلٲوِتھ کٔرمس لۅکٕٹؠ لۅکٕٹؠ ٹُکرٕ۔ پتہٕ ژھنِم تِم لۅکٕٹؠ لۅکٕٹؠ ٹُکرٕ تتھ کۅلہِ منٛز دٲرِتھ یۅسہ پہاڑٕ دامنہٕ کِنؠ پکان ٲس۔
\p
\v 22 تُہنٛدیٚو جدٕاجدادو کھول یہُوواہسؔ تتھ پٮ۪ٹھ تہِ سٮ۪ٹھاہ شرارتھ یہ تِمو تِمن جاین کوٚر یِمن تِمو تبعیرہؔ، مسہؔ تہٕ قبرُوت ہتاوہؔ تےتھوو۔\f + \fr 9‏:22 \ft گریند 11:1 پٮ۪ٹھٕ 3 تام، خروج 17:1 پٮ۪ٹھٕ 7 تام، گریند 11:31 پٮ۪ٹھٕ 34 تام۔ \f*
\p
\v 23 تہٕ ییٚلہ أسؠ قادِس برنِیع ہس منٛز ٲسؠ، یہُوواہنؔ ووٚن تُہنٛدین جدٕاجدادن، "گٔژھیٚو تہٕ تتھ ملکس کٔریٚو قبضہٕ یُس بہٕ توٚہہِ دنہٕ وول چُھس" مگر تَمو کٔر تس خلاف بغاوت۔ تِمو کوٚر نہٕ تس پٮ۪ٹھ بھروسہٕ، تہٕ تِمو کٔرنہٕ تمسنٛدِس وننس پٮ۪ٹھ عمل۔\f + \fr 9‏:23 \ft وُچھِو گریند 13 تہٕ 14 سبق \f*
\v 24 تُہنٛدیٚو جدٕاجدادو کٔر گۅڈٕ پیٚٹھےَ یہُوواہسؔ خلاف بغاوت یمہٕ بہٕ مِصرس منٛز زانان اوسسکھ، تہٕ توٚہؠ دروو بلکُل پننٮ۪ن جدٕاجدادن پٮ۪ٹھ۔\f + \fr 9‏:24 \ft تنہٕ پٮ۪ٹھٕ ینہٕ پٮ۪ٹھٕ ژےٚ خدا زٲنی۔\f*
\p
\v 25 لہٰذا، یتھٕ کِنؠ مےٚ ووٚن زِ بہٕ رودُس ژتجہَن دوٚہُن تہٕ ژتجہَن رٲژن یہُوواہسؔ برُونٛہہ کنہِ سٔجدس منٛز تکیازِ یہُوواہنؔ اوس فرمومُت زِ سُہ کرِ تُہنٛدین جدٕاجدان ہلاک۔
\v 26 تہٕ مےٚ موٚنگ یہُوواہسؔ دُعا زِ اے خداوند یہُوواہؔ، یِم لوٗکھ چھِ چٲنؠ۔ یِم مہٕ کرُکھ تباہ۔ یِم چھِ تِم لوٗکھ یِم ژےٚ بچٲوتھکھ تہٕ پننہِ قدرتہٕ سٟتؠ أنؠ تھکھ مِصرٕ منٛزٕ کٔڈِتھ۔
\p
\v 27 یُس وعدہ ژےٚ ابراہامسؔ، اضحاقسؔ، تہٕ یعقوبس سٟتؠ کوٚرمُت چُھے سُہ مہٕ مٔشراو۔ ژٕمہٕ وُچھ اۅکُن زِ یمہٕ لوٗکھ کٲتیاہ ضِدی تہٕ خۅدسر چھِ، تہٕ تِمن گنہن کُن یمہٕ یمو کٔرؠ۔
\v 28 اگر توٚہؠ تہِ کٔریٚو نہٕ تہٕ یِم کٔرؠ ووکھ ہلاک ییٚلہ یہ مِصرٕکؠ لوٗکھ بوزن تِم ونن اتھ نیسبت زِ توٚہؠ ٲسیٚو نہٕ تِم اتھ ملکس منٛز اننَس قٲبل یمیُک وعدہ توٚہہِ تِمن سٟتؠ کوٚرمُت اوس۔ تِم ونن زِ توٚہہِ أنووکھ تِم صرف یتھ سحراوس منٛز مارنہٕ باپتھ تکیازِ توٚہؠ ٲسیٚو تِمن نفرت کران۔
\p
\v 29 یہ مٔشراوؠ زیٚو نہٕ زِ تِم چھِ تُہنٛدؠ لوٗکھ۔ توٚہہِ کٔرؠ ووکھ تِم پانس سٟتؠ تعلق قٲیم کرنہٕ خٲطرٕ منتخب۔ ژےٚ أنؠ تھکھ تِمہ پننہِ قدرتہٕ والہ طاقتہٕ سٟتؠ مِصرٕ منٛزٕ کٔڈِتھ۔"
\c 10
\p
\v 1 موسیٰؔ ہن ووٚن ہٮ۪تھےٕ اسرائیل ین زِ "ییٚلہِ ژتجی دوٚہہ تہٕ ژتجی رٲژ انٛد واژٕ، تمہ ساعتہٕ ووٚن مےٚ یہُوواہنؔ، کنیٚو زٕ لوحہ ژٹھ بیٚیہِ پرٲنؠ پٲٹھؠ۔ تہٕ تِمو باپتھ بناو اکھ صندوق۔ پتہٕ ان تمہٕ لوحہ مےٚ نِش یتھؠ پہاڑس پٮ۪ٹھ۔\f + \fr 10‏:1 \ft اِستِثنا 9:25\f*
\v 2 بہٕ لیٚکھٕ تِمن لوحن پٮ۪ٹھ تِمے الفاظ یِم مےٚ گۅڈٕ لوحن پٮ۪ٹھ لیٚکھمٕتؠ ٲسؠ، یمہٕ ژےٚ پُھٹرٲوِتھ۔ پتہٕ ہکیٚو توٚہؠ تِمہ تتھ صندوقس منٛز تھٲوِتھ۔"
\p
\v 3 یتھٕ کنؠ بنوو مےٚ اکھ صندوق۔ مےٚ کٔر سُہ بناونہٕ باپتھ کِکر کُلِچ لکٕر استعمال۔ پتہٕ ژچہِ مےٚ تِژھے کنیٚو زٕ تختیہٕ تہٕ کھۅتُس تمہٕ ہیٚتھ پہاڑس پٮ۪ٹھ۔
\v 4 تتہِ لیکھؠ یہُوواہنؔ تِمن کنِوین لوحن پٮ۪ٹھ تِمے داہ احکام یِم تٔمؠ گۅڈنِچن لوحن پٮ۪ٹھ لیکھمٕتؠ ٲسؠ۔ یِم چھِ تِم احکام یمہ تٔمؠ تُہنٛدین جدٕاجدادن پہاڑس پٮ۪ٹھ نارٕ منٛزؠ ؤنمٕتؠ ٲسؠ ییٚلہ تِم پہاڑٕ دامنس تل جمع گمٕتؠ ٲسؠ۔ پتہٕ کرِ یہُوواہنؔ تمہٕ لوحہ مےٚ حوالہٕ۔
\v 5 لوحہ رٔٹتھ دراس بہٕ واپس تہٕ وتُھس پہاڑٕ پٮ۪ٹھٕ بوٚن۔ پتہٕ، یتھ کنؠ تٔمؠ حکم کوٚرمُت اوس، تھاوِ مےٚ تمہٕ صندوقس منٛز یُس مےٚ بنوومُت اوس۔ تہٕ تمہ چھےٚ وُنہِ تہِ تتہِ موجود۔"
\p
\v 6 پتہٕ گےَ اسرائیلی لوکھ یعقانؔ لوٗکو ہنٛدیٚو کریریٚو پٮ۪ٹھٕ موسیرہؔ کُن روانہٕ، تتہِ سپُد ہارونؔ سُنٛد وفات تہٕ سُہ دفن کرنہٕ پتہٕ بنیاو تمسُنٛد نیٚچو الِیعزرؔ تمؠ سنٛزِ جایہِ سردار کاہن۔\f + \fr 10‏:6 \ft گریند 20:22 پٮ۪ٹھٕ 28 تام \f*
\v 7 تتہِ پٮ۪ٹھٕ گےَ اسرائیلی جُدجُودہ تہٕ جُدجُودہ پٮ۪ٹھ یُوطباؔتہ۔ تتھ ملکس منٛز آسہٕ واریاہ آبہٕ کۅلہٕ۔
\p
\v 8 تمہِ وقتہٕ ژٲرؠ یہُوواہنؔ لاوی قبیلٕکؠ سُہ صندوق تُلنہٕ باپتھ یتھ منٛز تمہٕ لوحہ آسہٕ یِمن پٮ۪ٹھ داہ احکام لیٚکھِتھ ٲسؠ تہٕ سپدؠ یہُوواہؔ سنٛزِ موجودگی منٛز مقدس خٟمس منٛز کھڑا، قربٲنیہ پیش کرنہٕ تہٕ دُعا منٛگنہٕ باپتھ تاکہ یہُوواہؔ کرِ لوٗکن برکت۔ تِم ٲسؠ امہِ وزِ تہِ یہےَ کٲم کران۔\f + \fr 10‏:8 \ft خروج 32:25 پٮ۪ٹھٕ 39\f*
\v 9 یوٚہے وجہ چُھ زِ لاوی قبیلہٕ کٮ۪ن میج نہٕ دویمٮ۪ن قبیلن ہنٛدؠ پٲٹھؠ زمیٖن۔ تِمن اوس یہُوواہؔ سنٛدؠ کاہن بننُک اعزاز حٲصل، یہ تٔمؠ ونمُت اوس زِ تِمن پزِ کرُن۔
\p
\v 10 موسیٰؔ ہن تھٲو کتھ جٲری: " بہٕ رودُس پہاڑس پٮ۪ٹھ ژتجہن دوٚہُن تہٕ ژتجہن رٲژن، یتھٕ کِنؠ بہٕ گۅڈٕ رودمُت اوسُس۔ مےٚ مونٛگ یہُوواہسؔ دُعا تہٕ تٔمؠ کوٚر دُبارٕ میٚون دُعا قبول تہٕ ونُن زِ بہٕ کرکھ نہٕ وۅنؠ چٲنؠ جدٕاجداد ہلاک۔
\v 11 پتہٕ ووٚن یہُوواہنؔ مےٚ، "ژٕ تھاو پنُن سفر جٲری تہٕ لوٗکن برُونٛہہ کُن گٔژھتھ کٔریٚو تتھ ملکس پٮ۪ٹھ قبضہ یمیُک وعدہ مےٚ تُہنٛدین جدٕاجدان سٟتؠ کوٚرمُت اوس زِ بہٕ دمہٕ سُہ توٚہہِ۔
\p
\v 12 اے اسرائیلی لوٗکو بہٕ ونہٕ توٚہہ زِ سون خدا یہُوواہؔ کیاہ چُھ اسہِ کرُن ونان۔ سُہ چُھ یژھان زِ توٚہؠ کٔریٚو تس تعظیم، پنٕنؠ زندگی گزاریٚو تِتھے پٲٹھؠ یتھٕ پٲٹھؠ ونیٚو، تمِس سٟتؠ تھٲیو محبت، تہٕ تمؠ سنٛز کریٚو خدمت یتھ پٲٹھؠ تہِ توٚہؠ یژھیٚو تہٕ محسوس کٔریٚو،\f + \fr 10‏:12 \ft لوق 10:27\f*
\v 13 تہٕ تمسنٛدین سارنی احکامن پٮ۪ٹھ کٔریٚو عمل یمہ بہٕ توٚہہ ونہٕ، یمو سٟتؠ توٚہہِ مدد واتہ۔
\p
\v 14 یہ مٔشراوؠ زیٚو نہٕ زِ سون خدا یہُوواہؔ چُھ آسمانُک تہٕ تتھ منٛز موجود پرٮ۪تھ چیزُک مٲلک۔ سُہ چُھ زمینُک تہٕ تتھ منٛز موجود پرٮ۪تھ چیزُک تہِ مٲلک۔
\v 15 یوٚدوے سُہ یمن سارنی چیزن ہُنٛد مٲلک چُھ، مگر یہُوواہنؔ کوٚر تُہنٛدین جدٕاجدادن سٟتؠ تہِ محبت؛ تٔمؠ ژٲرؠ دنیا کیٚو تمام لُکہ جمٲژو منٛزٕ أسؠ تِہنٛدؠ اولاد، أسؠ چھِ وُنہ تہِ تمسنٛدی لوٗکھ۔\f + \fr 10‏:15 \ft 1 پُطرس 2:9\f*
\p
\v 16 لہٰذا پزِ توٚہہِ پنُن اُندرون بدلاوُن تہٕ ضِدی بننس روٚٹ کرُن۔\f + \fr 10‏:16 \ft پنٕنؠ دِل بدلٲیو\f*
\v 17 سون خدا یہُوواہؔ چُھ ساروےٕ معبودو کھۅتہٕ تھوٚد تہٕ تمام حٲکمو کھۅتہٕ بوٚڈ۔ سُہ چُھ سٮ۪ٹھاہ طاقتہٕ وول، باقیو کھۅتہٕ، نہ چُھ کھوٚژ قبول کرن وول۔\f + \fr 10‏:17 \ft زبور 136:2 پٮ۪ٹھٕ 3 تام \f*
\p
\v 18 سُہ چُھ یہِ کتھِ پٮ۪ٹھ یقینی بناوان زِ یتیمن تہٕ مونڈن سٟتؠ گژھِ رُت سلوک کرنہٕ یُن۔ سُہ چُھ غٲر ملکی ین سٟتؠ تہِ محبت کران یمہٕ اسہِ اسرائیل ین سٟتؠ روازان چھِ، سُہ چُھ تِمن کھیٚن تہٕ پۅشاک سوزان۔
\v 19 لہٰذا پزِ توٚہہ تہٕ تِمن غٲر ملکی ین سٟتؠ محبت کرُن تکیازِ ییٚلہ توٚہؠ مِصرس منٛز روزان ٲسیٚو توٚہؠ تہِ ٲسیٚو غٲر ملکی۔\f + \fr 10‏:19 \ft احبار 19:34، خروج 22.21، 23:9\f*
\p
\v 20 سٲنس خدا یہُوواہسؔ کٔریٚو تعظیم تہٕ بیٚیہِ کٔریٚو تمؠ سنٛزےٕ یٲژ عبادت۔ تمسنٛدؠ وفادار بنیٚو، تہٕ ؤنیٚو زِ سُہ دِین اسہِ سزا اگر نہٕ سُہ وعدہ اسہِ پوٗرٕ کوٚر یُس اسہِ کوٚرمُت چُھ۔
\v 21 سُے چُھ یمسنٛدؠ توٚہؠ تعریف کٔریٚو۔ سُہ چُھ سون خدا، اسہِ وُچھ تمہٕ عظیم تہٕ خوفناک کامہِ یمہٕ تٔمؠ سانہِ باپتھ کرِ۔
\p
\v 22 ییٚلہ سٲنؠ جدٕاجداد یعقوب تہٕ تمسُنٛد خاندان مِصر گےَ تہٕ تِم ٲسؠ صرف ستتھ۔ مگر وۅنؠ بنٲوؠ أسؠ یہُوواہنؔ آسمان کٮ۪ن تارکن ہنٛدؠ پٲٹھؠ بے شمار۔"\f + \fr 10‏:22 \ft پیدائش 46:26 پٮ۪ٹھٕ 27، خروج 1:5، اعمال 7:14، عبر 11:12\f*
\c 11
\p
\v 1 موسیٰؔ ہن ووٚن ہٮ۪تھےٕ اسرائیل ین "چونکہ یہ کینٛژھا تُہنٛدؠ خدا یہُوواہنؔ تُہنٛدِ باپتھ کوٚر، توٚہہ پزِ تِمن سارنی اصولن، فرمانن تہٕ حکمن ہُنٛد محبت تھاوُن تہٕ تِمن ہنٛز تعمیل کرٕنؠ۔
\p
\v 2 یِم ٲسیٚو توٚہؠ تہٕ تُہنٛدؠ جدٕاجداد نکہِ تُہنٛدؠ اولاد، یِمن تٔمؠ سزا دیُت تکیازِ توٚہہ کٔرو تِہنٛز نافرمٲنی، سبق دِنہ تہٕ ہیٚچھِ ناونہ باپتھ پیٚو توٚہہ واریاہ مشکلات تُلٕنؠ۔ لہٰذا کرو از شُروعات، یتھ پٮ۪ٹھ سونٛچو زِ تمسُنٛد سزا، تمسنٛز عظمت تہٕ تمسُنٛد قدرتہٕ وول طاقت یُس سُہ توٚہہ سٟتؠ ورتاوان چُھ، کیاہ چُھ کرِتھ ہیٚکان۔
\v 3 تِم بے شمار بیٚون بیٚون معجزات کٔریٚو یاد یِم تمؠ مِصرس منٛز ہٲوؠ، تِم معجزٕ ظٲہر کران چُھ زِ سُہ کوتاہ طاقتور تہٕ عظمتہٕ وول چُھ۔ سونٛچو زِ تٔمؠ کیاہ کوٚر مِصرٕ کِس بادشاہ تہٕ تتھ سٲرسےٕ ملکس سٟتؠ یتھ پٮ۪ٹھ سُہ حکومت کران اوس۔
\p
\v 4 کیاہ تُہنٛدیٚو بچو وُچھنا مِصرُک فوج یا تہنٛدؠ گُرؠ تہٕ رتھ یہُوواہؔ سنٛدِ قدرتہٕ سٟتؠ تباہ سپدان۔ تُہنٛدیو بچو وُچھنا یہ زِ کِتھٕ پٲٹھؠ اوٚن یہُوواہنؔ بحرِ قُلزمسؔ سٲلاب تہٕ مِصرُک فوج کوٚرن تِتھٕ منٛز غرق ییٚلہ تِم تُہنٛدین جدماجدادن پتہٕ لاران ٲسؠ۔ تُہنٛدیو بچو سمٕجھ نا یہ زِ یہُوواہؔ رود ازتام مِصرٕ کِس فوجس کمزور بناوان۔
\v 5 تُہنٛدؠ بچہٕ چِھنا یہ زانان زِ یہُوواہنؔ کِتھٕ پٲٹھؠ کٔر تُہنٛدین جدٕاجدادن یتھ جایہ واتنہٕ برُونٛہہ بیابانن منٛز رٲچھ۔ \f + \fr 11‏:5 \ft اعمال 7:5\f*
\p
\v 6 سونٛچو زِ تٔمؠ کیاہ سلوٗک کوٚر روبن قبیلہٕ کِس اِلیاب سنٛدین دوٚن نیٚچوٮ۪ن داتنؔ تہٕ ابیرامسؔ سٟتؠ۔ ییٚلہ تُہنٛدؠ جدٕاجداد سٲری وچھان ٲسؠ تہٕ زمیٖن گییہ چاک تہٕ تِم گےَ پنٕنؠ گھرٕ وٲلؠ، خٟمہ، نوکر تہٕ چو چاروٲے ہیٚتھ تتھ منٛز تہٕ سپٕدؠ غٲب۔\f + \fr 11‏:6 \ft گریند۔ سبق 16\f*
\v 7 توٚہہ تہٕ تُہنٛدیٚو جدٕاجدادو وُچھ یِم سٲری معجزٕ یِم یہُوواہنؔ ہٲوؠ۔
\p
\v 8 لہٰذا کٔریٚو تِمن تمام احکامن ہنٛز پٲروی یِم بہٕ توٚہہِ دِوان چُھس تاکہ توٚہؠ دِیو ہمتہٕ سان دریاوس تار تہٕ کٔریٚو تتھ ملکس پٮ۪ٹھ قبضہٕ یتھ منٛز توٚہؠ اژن وٲلؠ چُھو،
\v 9 تہٕ یتھ کنؠ روزیٚو توٚہؠ تتھ ملکس منٛز واریہس وقتس زنٛدٕ، یہ چھےٚ سۅ زمین یمیُک یہُوواہنؔ تُہنٛدین جدٕ اجدادن وعدہ کوٚرمُت چُھ زِ سُہ دییہِ یہ تُہنٛدین اولادن۔ اکھ تِژھ زمین یۅسہ سیٹھاہ ذرخیز چھےٚ۔\f + \fr 11‏:9 \ft رٕژ تہٕ ذرخیز زمین\f*
\p
\v 10 یتھ ملکس منٛز گٔژھِتھ توٚہؠ قبضہٕ کرن وٲلؠ چُھو سُہ چھنہٕ مِصر ملکٕکؠ پٲٹھؠ یتہٕ تُہنٛدؠ جدٕاجداد روزان ٲسؠ۔ مِصرس منٛز اوس بیول وَونہٕ پتہٕ تِم کُلؠ ینہٕ خٲطرٕ تمہِ باپتھ ضروری، تتھ سخت محنت کٔرِتھ آب واتناوُن۔
\v 11 مگر یتھ سرِ زمینہ منٛز توٚہؠ اژن وٲلؠ چُھو سۅ چھےٚ تِژھ سرِزمین یتہِ واریاہ پہاڑ تہٕ مٲدان چھِ، یتہِ واریاہ بٲرش پیٚوان چھےٚ۔
\v 12 یہُوواہؔ چُھ تمہِ ملکٕچ رٲچھ راوٕٹ کران۔ سُہ چُھ پرٮ۪تھ ؤرؠ یکہِ ابتدا پٮ۪ٹھٕ پرٮ۪تھ ؤرؠ یِکِس انٛدس تام تمہِ ملکٕچ نگرٲنی کران۔
\p
\v 13 از چُھسو بہٕ توٚہہ حکم کران زِ سٲنِس خدا یہُوواہسؔ سٟتؠ کٔریٚو محبت تہٕ پننہِ دِلہ کٔریٚو تمؠ سنٛز خدمت۔ اگر توٚہؠ تہِ کٔریٚو،\f + \fr 11‏:13 \ft یم چھِ خدایہِ سنٛدؠ حکم۔ یِمہٕ موسیٰؔ لوٗکن تام واتناوان چُھ۔\f*
\v 14 تہٕ سُہ تراوِ پرٮ۪تھ وریہ تُہنٛدس زمینس وقتس پٮ۪ٹھ رحمتِ باران۔ نتیجہٕ نیرِ یہ زِ توٚہہ بنہِ اناج تہٕ دچھ شراب بناونہٕ خٲطرٕ تہٕ زیتون تیٖل بناونہٕ باپتھ زیتون۔\f + \fr 11‏:14 \ft یعقوب 5:7\f*
\v 15 تہٕ سُہ ۅپداوِ تُہنٛدیٚو چاروایو باپتھ زمینس منٛز گاسہٕ۔ توٚہہِ میلہ سُہ سورےٕ کھیٚن یُس توٚہؠ یژھان چُھو۔
\p
\v 16 مگر بہٕ چُھسو توٚہؠ خبردار کران زِ سٲنِس خدا یہُوواہؔ سنٛز عبادت ترٲوؠ زیٚو نہٕ۔ دوٚیمٮ۪ن معبودن ہنٛز عبادت کٔرؠ زیٚو نہٕ،
\v 17 وۅنؠ اگر توٚہؠ تہِ کٔریٚو تہٕ یہُوواہؔ گژھِ توٚہہِ سٮ۪ٹھا ناراض۔ سُہ دییہِ نہٕ روٗدس پیٚنہٕ۔ نتیجہ نیرِ یہ زِ پھسٕل ۅپدینہٕ، تہٕ توٚہؠ مٔریٚو جلدےٕ اتھ اصلِس زمینس منٛز بۅچھِ دادِ یۅسہ یہُوواہؔ توٚہہِ دنہٕ وول چُھ۔
\p
\v 18 لہٰذا یہ کینٛژھا توٚہہِ یہُوواہنؔ حکم کوٚر تتھ پٮ۪ٹھ سونٛچو۔ تِم لفظ لیکھیٚو لۅکٹٮ۪ن لۅکٹٮ۪ن مارکن پٮ۪ٹھ تہٕ تِم تھٲیو پننٮ۪ن نرٮ۪ن پٮ۪ٹھ گنٛڈِتھ، تہٕ تِم لیکھیٚو تِمن دجہِ پچن پٮ۪ٹھ یمہ توٚہؠ پننٮ۪ن ڈٮ۪کن پٮ۪ٹھ گنڈان چُھو تاکہِ تمہ سٟتؠ روزن توٚہہِ تِم یاد۔
\p
\v 19 پنٕنؠ بچہٕ ہیٚچھِ نٲووکھ تہِ بار بار۔ یمن متعلق کٔریٚو پرٮ۪تھ وزِ کتھ: ییٚلہ توٚہؠ گھرس منٛز ٲسیٚو، ییٚلہ توٚہؠ گھرٕ نیٚبر پکان ٲسیٚو، شونٛگِتھ ٲسیٚو یا کٲم کران ٲسیٚو یِمن متعلق روزؠ زیٚو کتھ کران۔
\p
\v 20 یمہٕ تھٲوؠ زیوکھ پننٮ۪ن دروازٕ چۅکاٹھن پٮ۪ٹھ تہٕ شہرٕ کٮ۪ن دیوارن پٮ۪ٹھ لیکھِتھ۔
\v 21 یی کٔرؠ زیٚو تاکہِ توٚہؠ تہٕ تُہنٛدؠ اولاد روزن اتھ ملکس منٛز واریہس وقتس زنٛدٕ یمیُک وعدہ یہُوواہنؔ سانٮ۪ن جدٕاجدادن دِنُک کوٚرمُت چُھ۔ سۅ زمین بنہِ تُہنٛز تہٕ تُہنٛدین اولادن ہنٛز یۅتام زن زمینس پٮ۪ٹھ آسمان چُھ۔
\p
\v 22 یہ کینٛژھا کرنُک حکم بہٕ توٚہہ دِوان چُھس اتھ پٮ۪ٹھ روزیٚو ایماندٲری سان عمل کران مطلب یہُوواہسؔ سٟتؠ کٔریٚو محبت تہٕ پنٕنؠ زندگی پکنٲیو تِتھٕ پٲٹھؠ یتھٕ پٲٹھؠ سُہ یژھان چُھ تہٕ تمِس سٟتؠ روزیٚو وفادار۔
\v 23 اگر توٚہؠ تہِ کٔریٚو تہٕ یہُوواہؔ کڈِ تمہِ ملکہٕ منٛزٕ لوٗکن ہنٛزن جمٲژن یُتھ توٚہؠ برُونٛہہ پٔکیٚو، لوٗکن ہنٛزٕ تمہٕ جمٲژ آسن تعدادٕ کِنؠ واریاہ تہٕ سٮ۪ٹھاہ طاقتور۔
\p
\v 24 تمہِ دھرتی ہنٛز سٲرےٕ زمین یتھ پٮ۪ٹھ توٚہؠ پکان ٲسیٚو آسہ تُہنٛز۔ تُہنٛد علاقہٕ آسہ جنوبی صحراوٕ پٮ۪ٹھٕ شمالس کُن لبنان کٮ۪ن پہاڑن تام تہٕ مشرقہٕ کِنؠ فرات دریاوٕ پٮ۪ٹھٕ مغرب کِس بحیرہ رومسؔ تام پھٲلِتھ۔
\v 25 سون خدا یہُوواہؔ کرِ تمہِ ملکہٕ کٮ۪ن تمام لوٗکن تُہنٛدِ سٟتؠ سٮ۪ٹھاہ خوفزدٕ، یمیُک تٔمؠ وعدہ کوٚرمُت چُھ، یمہِ کِنؠ توٚہہ کانٛہہ تہِ جماتھ رکٲوِتھ ہیٚکہِ نہٕ۔
\p
\v 26 وارٕ بوزیٚو: از چُھسو بہٕ توٚہہ ونان زِ یا تہٕ کرِ یہُوواہؔ توٚہہ برکت عطا نتہٕ کریٚو لعنت نٲزِل۔
\v 27 اگر توٚہؠ سانِس خدا یہُوواہؔ سنٛدین حکمن پٮ۪ٹھ عمل کٔریٚو یمہٕ بہٕ از توٚہہِ دِوان چُھسو تیٚلہِ کریٚو سُہ برکت عطا۔
\v 28 وۅنؠ اگر توٚہہ تِہنٛز کتھ مٲنیٚو نہٕ تہٕ تمؠ سنٛز عبادت کرنہٕ بجایہ دویمٮ۪ن معبودن ہنٛز عبادت کرنہِ لگیٚو یہنٛدؠ نہٕ توٚہؠ زانٛہہ تہِ وفادار ٲسیو، تہٕ سُہ کرِ تیٚلہِ توٚہہ پٮ۪ٹھ لعنت نٲزِل۔
\v 29 تہٕ ییٚلہ یہُوواہؔ توٚہہِ تتھ ملکس منٛزٕ واتناوِ یتھ منٛز توٚہؠ دٲخل سپدِتھ قبضہٕ کرن وٲلؠ چُھو تہٕ توٚہہ منٛزٕ کرن کینٛہہ گرزِیمؔ بالہٕ تینتٲلِس پٮ۪ٹھ کھسِتھ اعلان زِ یہُوواہؔ کیاہ کۅسہٕ برکت دییہِ توٚہہ تہٕ باقین پزِ عیبال کوٚہہ تالہِ پٮ۪ٹھ کھسُن اعلان کرُن زِ یہُوواہؔ کرِ توٚہہِ پٮ۪ٹھ لعنت۔
\v 30 تِم دوٚنوے پہاڑ چھِ یردن دریاوس مغرب پاسہٕ، یردن بٹھِ کِس مٲدانس مغربس منٛز تتھ ملکس منٛز یتہِ کنعانٕکؠ لوٗکھ روزان چھِ۔ تِم چھِ جِلجالس نکھٕ مقدس کُلین نِش روزان۔
\p
\v 31 "توٚہؠ کٔریٚو جلدےٕ یردن دریاوس تار دِتھ تتھ ملکس قبضہٕ یُس سون خدا یہُوواہؔ توٚہہِ دِوان چُھ۔ ییٚلہ توٚہؠ تتھ ملکس منٛز أژتھ تتہِ روزُن شروع کٔریٚو،
\v 32 یاد تھٲوؠ زیٚو تِمن تمام اصولن تہٕ احکامن ہنٛز کٔرؠ زیٚو تعمیل یمہ بہٕ از توٚہہِ دِوان چُھس۔
\c 12
\p
\v 1 موسیٰؔ رود ہیٚتھےٕ اسرائیل ین یہِ ونان زِ "وۅنؠ ونہٕ بہٕ توٚہہ تِم اصول تہٕ احکام یمن ہنٛز توٚہہ تتھ ملکس منٛز روزِتھ وفادٲری سان پٲروی کرٕنؠ پزِ، یمہ یہُوواہؔ سون خدا یمسنٛز عبادت سٲنؠ جدٕاجداد کران ٲسؠ، توٚہہ قبضہٕ کرنہٕ باپتھ دِوان چُھو۔ یۅتام توٚہؠ زنٛدٕ چُھو تۅتام پزن توٚہہ یمہ قانون اپناوٕنؠ۔
\v 2 ییٚلہ توٚہؠ لوٗکن ہنٛزٕ تِم جمٲژ تتہِ کٔڈؠ ووکھ یہنٛز زمین توٚہؠ رٹیٚو تہٕ توٚہہ پزن تِم سارے جایہ تباہ کرنہِ یتہِ تِم پننٮ۪ن دیوتاہن ہنٛز پرستِش کران ٲسؠ، پہاڑٕ تینٛتالن پٮ۪ٹھ، بالن منٛز تہٕ بڈین بڈین کُلین نِش۔
\p
\v 3 توٚہؠ لُوہرنٲے زیوکھ تہنٛزٕ قربان گاہ تہٕ تِمن ہنٛدؠ سِتون ژٔھنؠ زیوکھ پُھٹرٲوِتھ۔ تِہنٛز دیوی اشیرہ ہنٛز مورتی ژٔھنؠ زیون زٲلِتھ تہٕ تہنٛزٕ بناوِمژٕ موٗرژٕ ژٔھنؠ زیوکھ پُھٹرٲوِتھ تاکہِ تِمن جاین کرِنہٕ کانٛہہ تہِ تِہنٛز پوٗزا۔
\p
\v 4 یہُوواہؔ سنٛز عبادت مہٕ کٔریٚو تِتھ پٲٹھؠ یتھٕ پٲٹھؠ کنعانٕکؠ لوٗکھ پننٮ۪ن معبودن ہنٛز کران چھِ۔
\p
\v 5 امہِ بجایہ پزِ توٚہہِ تتھ جایہ گژُھن یۅسہ یہُوواہؔ منتخب کرِ۔ یہ آسہ تتھ علاقس منٛز یتہِ تُہنٛدِ قبیلہٕ منٛزٕ کانٛہہ روازان آسہ۔ یہ آسہ سۅ جاے یوٚت توٚہہ یہُوواہؔ سنٛزِ حضوری منٛز اژُن آسہ تہٕ تتہِ تمؠ سنٛز عبادت کرنؠ پزِ۔
\v 6 یہ آسہ سۅ جاے یوٚت توٚہہ پننہ قربٲنیہ ننہِ آسن یمہٕ کاہن قربان گاہس پٮ۪ٹھ پورٕ پٲٹھؠ بُزن تہٕ تُہنٛزٕ باقی قربٲنیہ یمہٕ توٚہؠ پانہٕ مےٚ پیش کران چُھو، تُہنٛزن باقی قربٲنین ہُنٛد دٔہم حصہ یُس توٚہؠ مےٚ دٕنُک وعدہ کران چُھو، یعنی گۅڈٕ نِکؠ ژَھو، تُہنٛزن گٲون تہٕ تیٖرن ہنٛدؠ، یا بیٚیہِ کُنہِ قسمٕچ قربٲنی۔
\p
\v 7 تتہِ، سٲنِس خدا یہُوواہسؔ برُونٛہہ کنہِ کھیٚیو توٚہؠ تِم اصل چیز یِم پٲدٕ کرنہٕ باپتھ توٚہہِ محنت کٔرو، تہٕ توٚہؠ سپدیٚو خوش، تکیازِ تٔمؠ کٔرنو توٚہہ واریاہ برکت عطا۔
\p
\v 8 ییٚلہ توٚہؠ اتھ ملکس منٛز ٲسیٚو تہٕ توٚہہ پزِن نہٕ تِم کینٛہہ چیز کرٕنؠ یمہٕ أسؠ کران آمٕتؠ چھِ۔ ونیُک تام ٲسیو توٚہؠ تتھٕ پٲٹھؠ یہُوواہؔ سنٛز عبادت کران یتھٕ پٲٹھؠ توٚہؠ یژھان ٲسیو،
\v 9 تکیازِ توٚہؠ وٲتیٚو نہٕ وُنہِ تتھ ملکس منٛز یتھ پٮ۪ٹھ سُہ توٚہہ مکمل پٲٹھؠ قبضہٕ کرنُک اجازت دییہِ، یتہِ توٚہؠ سکونہٕ سان روزِتھ ہکیٚو۔
\p
\v 10 مگر ییٚلہ توٚہؠ یردن دریاوٕ اپور تٔریٚو تہٕ ملکس منٛز روزنہِ لگیٚو یُس سون خدا یہُوواہنؔ توٚہہ دِوان چُھو۔ سُہ تھایو توٚہہ تہٕ تُہنٛدیٚو تمام دشمنو نشہٕ محفوظ یمہ توٚہہ ولنہٕ ین، توٚہؠ روزیٚو امنہٕ سان۔
\p
\v 11 یہُوواہؔ ژارِ اکھ جایا یتہِ سُہ یژھان آسہ زِ توٚہؠ گٔژھیٚو تس سنٛز عبادت کرٕنؠ۔ یہ آسہ سۅ جاے یوٚت توٚہہ تِم تمام قربٲنیہ اننہِ آسنو یمہٕ اننُک بہٕ توٚہہ حکم کران چُھس: تمہ قربٲنیہ یمہ کاہن قربان گاہس پٮ۪ٹھ پوٗرٕ پٲٹھؠ بُزن، تُہنٛزٕ باقی قربٲنیہ، باقی قربٲنیہ یمہ توٚہؠ پانہٕ پیش کرنُک فٲصلہٕ کران چُھو، تُہنٛزن باقی قربٲنین ہُنٛد دٔہم حصہ، خاص نذرانہٕ یِم توٚہؠ یہُوواہسؔ پیش کرنٕکؠ پۅختہٕ وعدہ کٔریٚو۔
\p
\v 12 تتہِ یہُوواہسؔ برُونٛہہ کنہِ پنٕنؠ بچہٕ، خٲدِم تہٕ لاوین ہنٛدؠ اولاد ہیٚتھ یِم تُہنٛدِس شہرس منٛز روزان چھِ منٲیو خوشی۔ یہ مٔشرٲوؠ زیٚو نہ زِ لاوی سنٛدین اولادن آسہ نہٕ تُہنٛدؠ پٲٹھؠ پنٕنؠ زمین۔
\p
\v 13 یمہِ کتھِ ہُنٛد تھٲوؠ زیٚو خیال زِ یتِتھ تہِ توٚہؠ یژھِو تہٕ تتِتھ کٔرؠ زیوکھ نہٕ بُزنہٕ آمٕتؠ قربٲنی ہنٛدؠ جانور پیش۔
\v 14 توٚہؠ کٔرؠ زیوکھ تِم صرف تٔتھؠ جایہ پیش یۅسہ یہُوواہؔ تمہِ باپتھ مقرر کرِ، تتھ علاقس منٛز یۅسہ تُہنٛدِ قبیلہٕ منٛزٕ کٲنٛسہِ أکؠ سنٛز آسہ۔ صرف آسہ یہےَ جاے یتہِ سُہ یژھِ زِ توٚہؠ گٔژھیٚو قۅرنانیہ پیش کرنہِ یِمن کاہن قربان گاہس پٮ۪ٹھ پورٕ پٲٹھؠ زالن تہٕ باقی چیز تہِ کرن یمن ہُنٛد بہٕ توٚہہ حکم دِوان چُھس ییٚلہ توٚہؠ تمؠ سنٛز عبات کٔریٚو۔
\p
\v 15 تاہم دییہ توٚہہ خدا پنٕنؠ جانور مارنٕکؠ تہٕ تِہُنٛد ماز کھیٚنُک اجازت تتھ جایہ یتہ توٚہؠ روزان ٲسیٚو۔ ییژِ لٹہِ توٚہؠ یژھِو توٚہؠ ہکیٚو تِمن جانورن ہُنٛد ماز کھیٚتھ یمہ سون خدا یہُوواہؔ توٚہہ برکت دِتھ عطا کرِ۔ یمہ لوٗکھ تمہ وزِ پاک یا ناپاک آسن تمہٕ سٲری ہیٚکن سُہ ماز کھیٚتھ۔ یتھ پٲٹھؠ توٚہؠ روٗسؠ کچہِ یا ہانٛگلہ سُنٛد ماز کھیٚوان چُھو۔
\v 16 مگر توٚہہ پزِ نہٕ کٲنٛسہِ جانور سُنٛد خوٗن کھیٚون۔ ماز رننہٕ برُونٛہہ گژھِ گۅڈٕ پوٗرٕ پٲٹھؠ خوٗنس زمیٖنس پٮ۪ٹھ پیٚنہٕ دیُن۔\f + \fr 12‏:16 \ft پیدٲیش 9.3 تہٕ 4، احبار 17:10 پٮ۪ٹھٕ 14، اِستِثنا 12:23\f*
\p
\v 17 یتہِ توٚہؠ روزان ٲسیٚو تتہِ پزن نہٕ توٚہہ تِم چیز کھیٚنؠ یمہ توٚہؠ یہُوواہسؔ پیش کران چُھو۔ توٚہؠ کھیٚؠ زیٚو نہٕ پننہِ اناجُک، مےَ یُک، زیتون تیٖلُک یا پننٮ۪ن وژھیٚن ہُنٛد دٔہم حصہٕ۔ گٲون یا تیٖرن ژھاولٮ۪ن ہُنٛد سُہ نذرانہٕ یُس توٚہؠ پانہٕ یہُوواہسؔ پیش کرنُک فٲصلہ کران چُھو، یا بیٚیہِ کانٛہہ قربٲنی۔
\p
\v 18 امہِ بجایہ کھیٚیو توٚہؠ، تُہنٛدؠ بچہٕ، تُہنٛدؠ غلام، تُہنٛزٕ زنہٕ تہٕ لاوین ہنٛدؠ اولاد یِم تُہنٛدین شہرن منٛز روزان چھِ یم چیز یہُوواہسؔ برُونٛہہ کنہِ تتھ جایہ یۅسہ سُہ مقرر کرِ۔ تہٕ توٚہہ پزِ پرٮ۪تھ تتھ کامہِ پٮ۪ٹھ خوش روزُن یۅسہ توٚہؠ انجام دِیو۔
\v 19 یۅتام توٚہؠ پننِس ملکس منٛز روزان چُھو تۅتام تھاوؠ زیٚو لاوین ہنٛدین اولادن ہُنٛد خیال۔
\p
\v 20 ییٚلہ سون خدا یہُوواہؔ توٚہہِ پرانہِ کھۅتہٕ زیادٕ زمین فراہم کرِ تہٕ تٔمؠ چُھ امیُک وعدہ کوٚرمُت، تہٕ ییٚلہ سُہ ونہِ، "بہٕ چُھس ماز کھیٚون پسنٛد کران" تہٕ توٚہہِ چُھ اجازت ییٚلہ یژھِو تیٚلہ کھیٚیو ماز۔
\p
\v 21 اگر سون خدا یہُوواہؔ تُہنٛد عبادتہٕ باپتھ سۅ جاے ژارِ یۅسہ تُہنٛزِ بسن جایہ نِش واریاہ دوٗر آسہ تہٕ توٚہہ چُھ اجازت زِ توٚہؠ مٲرؠ ووکھ کینٛہہ چاروٲے یا تیٖر یمہ یہُوواہنؔ توٚہہ دِتمٕتؠ چھِ تہٕ ہکیٚو تتھ شہرس منٛز سُہ ماز کھیٚتھ یتہِ توٚہؠ روزان ٲسیٚو، تِتھے کنؠ یتھٕ کنؠ مےٚ توٚہہ کرُن ووٚن۔\f + \fr 12‏:21 \ft احبار 14:24\f*
\v 22 یمہٕ تٔمہِ وقتہٕ پاک یا ناپاک آسن ہیٚکن سُہ ماز کھیٚتھ یتھ پٲٹھؠ توٚہؠ ہانٛگلہ یا روٗسؠ کچہِ ہُنٛد ماز کھیٚوان چُھو۔
\p
\v 23 مگر حیٚس کٔرؠ زیٚو ینہٕ کٲنٛسہِ جانور سُنٛد خوٗن کھیٚیو، تکیازِ یوہے خوٗن چُھ جاندارن ہُنٛد زوو قٲیم تھاوان۔ توٚہہ پزِ نہٕ مازس سٟتؠ زوو تہِ کھیٚون۔
\v 24 خوٗن مہٕ کھیٚیو۔ سُہ دِیو زمینس پٮ۪ٹھ پتھر پیٚنہٕ۔
\v 25 اگر توٚہؠ یہ حکم پٲلیٚو تہٕ تہِ کٔریٚو یہ یہُوواہؔ ونان چُھ تُہنٛدِ خٲطرٕ چُھ بہتر، توٚہہِ تہٕ تُہنٛدین اولادن باپتھ روزِ یہ اصل۔
\p
\v 26 مگر سُہ نذرانہٕ یُس یہُوواہنؔ توٚہہ ووٚن زِ سُہ تھٲیو تمسنٛدِ باپتھ الگ تہٕ باقی نذرانہٕ تہِ یمہٕ پیش کرنُک توٚہہ فٲصلہٕ کوٚرو نیٖزیٚو توٚہؠ تتھ جایہ یۅسہ سُہ مقرر کرِ۔
\v 27 تتہِ بُزِ کاہن تِمہ قربٲنیہ یہُوواہؔ سنٛدِس قربان گاہس پٮ۪ٹھ۔ سُہ مارِ تِمن جانورن، خوٗن کڈیٚکھ نیٚبر، تہِ تمہِ منٛزٕ تراوِ سُہ اوٚڈ قربان گاہس انٛدؠ پٔکؠ۔ تہٕ توٚہؠ ہکیٚو تمہ مازٕ منٛزٕ کینٛہہ کھیٚتھ۔
\p
\v 28 یِمن کتھن پٮ۪ٹھ کٔرؠ زیٚو توٚہؠ وفادٲری سان عمل یمیُک مےٚ توٚہہ حکم کوٚر۔ اگر توٚہؠ یتھ کنؠ کٔریٚو تہٕ تُہنٛد تہٕ تُہنٛدین اولادن ہنٛدِ باپتھ روزِ یہ ہمیشہٕ خٲطرٕ بہتر، تکیازِ توٚہؠ کٔریٚو تی یہ سون خدا یہُوواہؔ ونان چُھ زِ یہ چُھ تُہنٛدِ باپتھ بہتر تہٕ یہ تس خوش چُھ۔
\p
\v 29 ییٚلہ توٚہؠ تتھ ملکس منٛز أژیو یتھ توٚہؠ قبضہٕ کٔریٚو تہٕ برُونٛہہ پٔکیٚو تہٕ سون خدا یہُوواہؔ کرِ تتہِ روزن والٮ۪ن لوٗکن تباہ۔
\v 30 یہ کرنہٕ پتہٕ، بناوِ سُہ یہ کتھ یقینی زِ توٚہؠ کٔریٚو نہٕ تِمن دیوتاہن ہنٛز عبادت یِمن ہنٛز تمہٕ پرستِش کران رودؠ، اگر توٚہؠ تہِ کٔریٚو تہٕ یہ بنہِ تُہنٛدِ باپتھ تیٚوتھ زال یتھ منٛز توٚہؠ ہیٚنہٕ یِیو۔ تِمن معبودن متعلق مہ پرِژھیٚو کٲنٛسہِ، مےٚ ؤنیٚو زِ تِم کتھٕ پٲٹھؠ ٲسؠ پننٮ۪ن معبودن ہنٛز پوٗزا کران تاکہِ أسؠ تہِ کرو تِتھے پٲٹھؠ یہُوواہؔ سنٛز عبادت۔"
\p
\v 31 تِتھٕ کِنؠ مہٕ کٔریٚو پننِس خدا یہُوواہؔ سنٛز عبادت کرنٕچ کوشش یتھٕ کِنؠ تِم پننٮ۪ن معبودن ہنٛز پرستِش کران چھِ، تکیازِ، تِم چھِ تِہنٛز پرستِش کرنہٕ وزِ مکروہ کامہِ کران یِمن سٟتؠ یہُوواہؔ نفرت کران چُھ۔ ساروےٕ کھۅتہٕ بُرٕ کام یۅسہ تِم کران چھِ چھےٚ یہ زِ تِم چھِ پننٮ۪ن بچن قربان کٔرِتھ پننٮ۪ن قربان گاہن پٮ۪ٹھ زالان۔\f + \fr 12‏:31 \ft اِستِثنا 7:25 تہٕ 26\f*
\p
\v 32 پرٮ۪تھ سۅ اکھ کام کٔریٚو یۅسہ مےٚ توٚہہِ کرٕنؠ ؤنؠ۔ یمن احکامن نہ ہُررٲوؠ زیٚو کینٛہہ تہٕ نہ کٔرؠ زیوس کینٛہہ کم۔\f + \fr 12‏:32 \ft مُکاشفہ 22:18\f*
\c 13
\p
\v 1 ممکن چُھ زِ توٚہہ منٛزٕ آسن تِتھ لوٗکھ تہِ یمہ ونان آسن زِ أسؠ چھِ نبی۔ تِم ہیٚکن ؤنِتھ زِ تِم چھِ خابن ہنٛدؠ تعبیر کرنس تہٕ مختلف قسمٕکؠ معجزات کرنس قٲبل۔\f + \fr 13‏:1 \ft متی 24:24، مرقُس 13:22\f*
\v 2 تِم ہیٚکن یژھٕ کتھٕ کٔرِتھ تاکہِ توٚہہ کرن پننٮ۪ن معبودن ہنٛز عبادت کرنس پٮ۪ٹھ آمادٕ یِمن متعلق نہٕ توٚہؠ گۅڈٕ کِہین زانان ٲسیٚو۔ مگر یتھ حدس تام تہِ زِ اگر تِم پیشن گوئی کرن، سۅ سپدِ،
\v 3 تہنٛزن کتھن کُن دیزیٚو نہٕ توجہ۔ سون خدا یہُوواہؔ ازمایو توٚہہ یہ زاننہٕ باپتھ زِ کیاہ توٚہؠ چُھوا تس سٟتؠ تمام بٲطنی وجودٕ سٟتؠ محبت کران۔\f + \fr 13‏:3 \ft اِستِثنا 13:3، 1 کورنتھ 11:19\f*
\v 4 توٚہہِ پزِ پنٕنؠ زندگی تِتھے پٲٹھؠ گذارٕنؠ یتھٕ پٲٹھؠ سون خدا یہُوواہؔ توٚہہِ نِش یژھان چُھ، تہٕ توٚہہِ پزِ تمسُنٛد تعظیم کرُن، یہ سُہ توٚہہ کرُن ونان چُھ تہِ کٔریٚو تہٕ تس پٮ۪ٹھ تھٲیو بھروسہٕ۔
\p
\v 5 مگر توٚہہ پزِ سُہ کانٛژھا ہلاک کرُن یُس اپُز دعوا کرِ زِ بہٕ چُھس نبی یا یُس اپُز دعوا کرِ بہٕ ہیٚکہٕ خابن تعبیر ونِتھ یا توٚہہِ ونیٚو زِ سانِس خدا یہُوواہسؔ سٟتؠ کریٚو بغاوت یمؠ تُہنٛدؠ جدٕاجداد مِصرٕ منٛزٕ غلامی نِشہ بچٲوؠ۔ یتھؠ لوٗکھ چھِ صرف یہ یژھان زِ توٚہؠ ترایو تِتھ کنؠ زندگی گذارٕنؠ یتھٕ کنؠ یہُوواہنؔ توٚہہِ کرنُک حکم دیتمُت چُھ۔ تِمن دِیو پھٲسؠ تاکہ توٚہہ منٛزٕ ییہِ یہ بُرایی دور کرنہٕ۔
\p
\v 6 یمہِ سٟتؠ پییہِ نہٕ کانٛہہ فرق اگر زن تُہنٛد بوے تُہنٛز بیٚنہِ تُہنٛز خاندارنؠ یا تُہنٛد کانٛہہ قریبی دوس توٚہہ ژوٗرِ پٲٹھؠ تلقین کٔرِتھ ونہ زِ أسؠ کرو دویمیٚن دیوتاہن ہنٛز عبادت یِمن متعلق نہ توٚہہ معلوم آسہ تہٕ نہ تُہنٛدین جدٕاجدادن۔\f + \fr 13‏:6 \ft اِستِثنا 17:2، پیدٲیش 16:5\f*
\v 7 یمو منٛزٕ ہیٚکن توٚہہ کینٛہہ تِمن دیوتاہن ہنٛز پرستِش کرنٕچ ترغٲب دِتھ یِمن ہنٛز عبادت توٚہہ انٛدؠ پٔکؠ روزن وٲلؠ کینٛہہ لوٗکھ کران چھِ، یا یِم دورِکؠ بسکین یِمن دیوتاہن ہنٛز عبادت کران چھِ۔
\p
\v 8 یہ تِم ونان چھِ تمہٕ کٔریٚو۔ تِہنٛز کتھ تہِ مہٕ بوزیٚو۔ تِمن پٮ۪ٹھ مہٕ کٔریٚو رحم تہٕ یہ کینٛژھا تِمو کوٚر تِمہ تھٲیو کٔھٹِتھ۔
\v 9 تِمن دِیو پھاسؠ! توٚہؠ ٲسیٚو گۅڈنِکؠ نفر یُس گۅڈٕ تمن مارنہٕ باپتھ سنٛگسار کرِ۔ پتہٕ چلاون باقی لوٗکھ تہِ تِمن پٮ۪ٹھ کنہِ۔\f + \fr 13‏:9 \ft احبار 24:14\f*
\p
\v 10 تِتھؠ لوٗکھ مٲرؠ ووکھ کنہِ لایتھ تکیازِ تِم چھِ توٚہہ سٲنس خدا یہُوواہؔ سنٛز عبادت کرنہٕ نِشہ رُکاون یژھان یمؠ تُہنٛدؠ جدٕاجداد مِصرٕ منٛزٕ غلامی نِشہ بچٲوؠ۔
\v 11 ییٚلہ تِمن موتُک سزا دنہٕ ییہِ تہٕ سٲری اسرائیلی لوٗکھ یہ بوزن زِ کیاہ سپُد تمہٕ کھۅژُن تہٕ تِمو منٛزٕ کرنہٕ کانٛہہ دوبارٕ یژھ بُرٕ حرکت۔
\p
\v 12 ییٚلہ توٚہؠ تمہ ملکٕچہ کُنہِ بستی منٛز روزان ٲسیٚو یۅسہ سون خدا یہُوواہؔ توٚہہِ دِوان چُھ تہٕ ہکیٚو بوزِتھ
\v 13 زِ توٚہہ منٛزٕ چھِ کینٛہہ ناکارٕ لوٗکھ پننہِ شہرٕ کٮ۪ن لوٗکن یہ ؤنِتھ دونٛکھٕ دِوان زِ "ؤلیٚو أسؠ کرو باقی معبودن ہنٛز عبادت"
\v 14 أمِچ اصلی حقیقت زٲنیٚو پوٗرٕ پٲٹھؠ۔ فرض کرو اگر توٚہہِ پےَ لوٚگ یہ چُھ پوٚز زِ یژھ رسوٲیی چھےٚ سپٕز۔
\p
\v 15 پتہٕ کٔرؠ زیوکھ تمہِ شہرٕکؠ سٲری لوٗکھ قتل۔ تہٕ تِہنٛدؠ تمام چو چاروٲے تہِ مٲرؠ زیوکھ۔ شہر کٔرؠ زیٚون مکمل پٲٹھؠ تباہ۔\f + \fr 13‏:15 \ft اِستِثنا 2:33 پٮ۪ٹھٕ 36 تام، 7:26\f*
\v 16 یہ کینٛژھا تتہِ کیٚن روزن والیٚن ہُنٛد آسہ سُہ سوٚمبرٲوِتھ کٔرؠ زیٚو شہرٕ کِس ژُوتِس پٮ۪ٹھ جمع۔ پتہٕ زٲلؠ زیٚون سُہ شہر تہٕ تتھ منٛز موجود تمام چیز، زنتہٕ یہ یہُوواہؔ سنٛدِ باپتھ قربٲنی آسہ یۅسہ پوٗرٕ پٲٹھؠ قربان گاہس پٮ۪ٹھ زالنہٕ آیہ۔ کھنٛڈراتھ گژھن ہمیشہٕ باپتھ تٔتھؠ شہرس منٛز روزٕنؠ۔ یہ شہر گژھِ نہٕ دوبارٕ تعمیر کرنہٕ یُن۔
\p
\v 17 توٚہؠ نیزیٚوکھ نہٕ یِم چیز\f + \fr 13‏:17 \ft تِم چیز یہنٛزِ تبٲہی ہنٛز مزمت چھےٚ یوان کرنہٕ۔\f* پننہِ باپتھ یمہٕ یہُوواہنؔ فناہ کرٕنؠ ؤنؠ، چونکہِ اگر توٚہؠ میانِس وننس پٮ۪ٹھ عمل کٔریٚو تہٕ یہُوواہؔ سپدینہٕ توٚہہِ پٮ۪ٹھ ناراض، سُہ کرِ توٚہہ پٮ۪ٹھ رحم۔ تہٕ سُہ کرِ توٚہہ واریاہ اولاد عطا، یمیُک تٔمؠ سانٮ۪ن جدٕاجدادن سٟتؠ وعدہ کوٚرمُت چُھ یُس سُہ پوٗرٕ کرِ۔
\v 18 سون خدا یہُوواہؔ کرِ یہ سورےٕ اگر توٚہؠ تہِ کٔریٚو یہ سُہ توٚہہ کرُن ونان چُھ، اگر توٚہؠ تِمن سارنےٕ احکامن پٮ۪ٹھ عمل کٔریٚو یمہٕ بہٕ توٚہہ از ونان چُھس تہٕ یہ یہُوواہؔ ونان چُھ تہِ کرُن روزِ تُہنٛدِ باپتھ جان۔
\c 14
\p
\v 1 موسیٰؔ ہن ووٚن اسرائیل ین زِ "أسؠ چھِ تِم لوٗکھ یِم سٲنِس خدا یہُوواہؔ سنٛدؠ چھِ۔ لہٰذا ییٚلہ لوٗکھ مرن توٚہؠ کٔرؠ زیٚو نہٕ پنٕنؠ پان چھۅکہٕ دٲوؠ کٔرِتھ یا کلس مس کٲسِتھ یہ ظٲہر زِ توٚہؠ چُھو غمگین یتھٕ پٲٹھؠ زن باقی لوٗکھ کران چھِ۔\f + \fr 14‏:1 \ft رومؔ 9:4\f*
\v 2 أسؠ چھِ صرف یہُوواہؔ سنٛدؠ۔ یہُوواہنؔ ژٲرؠ أسؠ زمینہِ پٮ۪ٹھٕ باقی تمام جمٲژو منٛزٕ پنٕنؠ خاص لوٗکھ۔\f + \fr 14‏:2 \ft طِطُس 2:14، 1 پُطرس 2:9\f*
\p
\v 3 موسیٰؔ ہن ووٚن مزید، "تیٚوتھ کانٛہہ چیز کھیٚؠ زیٚو نہٕ یتھ سٟتؠ یہُوواہسؔ نفرت چھےٚ۔\f + \fr 14‏:3 \ft وُچھِو 7:25، 26\f*
\v 4 یِمن جانورن ہُنٛد ماز کھیٚنُک توٚہہ اجازت چُھ تِمن منٛز چھِ گُپن، تیر، ژھاوٕلؠ،
\v 5 پرٮ۪تھ قسمٕچہ روٗسؠ کچہِ، غزال، جنٛگلؠ ژھاوجہٕ تہٕ پہٲڑی تیٖر۔
\p
\v 6 یِم چھِ تِم جانور یمن ہنٛدؠ پڈر پھاسوِتھ چھِ تہٕ یِم درامُن کران چھِ۔
\v 7 مگر بیٚیہِ تہِ چھِ کینٛہہ جانور یمہٕ درامُن کران چھِ یمہٕ نہٕ توٚہہ کھیٚنؠ پزن۔ تِم چھِ اونٹ، خرگوش، تہٕ ترونٛژ۔ یِم تہِ چھِ درامُن کران مگر یِمن ہنٛدؠ پڈر چھِنہٕ پھاسوِتھ آسان۔ اوٕ کِنؠ چھنہٕ یِم تُہنٛدِ کھیٚنہٕ باپتھ قٲبلِ قبوٗل۔
\p
\v 8 سور کھیٚؠ زیٚون نہٕ۔ تمہِ چھنہٕ تُہنٛدِ کھیٚنہٕ باپتھ قٲبلِ قبوٗل۔ تِہنٛدؠ پڈر چھِ پھاسوِتھ، مگر تمہٕ چھنہٕ درامُن کران۔ یِمن جانورن ہُنٛد ماز مہٕ کھیٚیو۔ تہنٛزن لاشن لٲگزیٚو نہٕ اتھٕ تہِ۔
\p
\v 9 توٚہہ چُھ تِژھٕ گاڈٕ کھیٚنُک اجازت یِمن پکھٕ تہٕ پَھر آسہ۔
\v 10 مگر آبس منٛز روزن وول بیٚیہِ کانٛہہ چیز یِمن نہٕ پَھر تہٕ پکھٕ آسن کھیٚؠ زیٚو نہٕ توٚہؠ تکیازِ تمہٕ آسن تُہنٛدِ باپتھ ناقٲبلِ قبول۔
\p
\v 11 توٚہہ چُھ تس پرٮ۪تھ کانٛسہ جاناوار سُنٛد ماز کھیٚنُک اجازت یُس یہُوواہسؔ منظور چُھ۔
\v 12 مگر شاہین، گرٮ۪د، سمندری عُقاب،
\v 13 باز تہٕ پرٮ۪تھ کُنہ قسمہٕ کٮ۪ن عُقابن ہنٛدؠ قسٕم ہکیٚو نہٕ توٚہؠ کھیٚتھ۔
\p
\v 14 توٚہہ چُھنہ کاو تہٕ جنٛگلی کاون ہُنٛد کانٛہہ تہِ قسم کھیٚنُک اجازت،
\v 15 شُترمُرغ، راتہٕ موٚغُل کریل، برٛگ، سمندری بطخ، کُنہ تہِ قسمُک باز،
\v 16 لۅکُٹ یا بوٚڈ راتہٕ موٚغل، سفید راتہٕ مونٛگُل،
\v 17 پیلیکن، گرٮ۪د یُس مُمٕتؠ جانور، کوٚلہٕ ٹوٗنچ کھیٚوان چُھ۔
\p
\v 18 توٚہہ چُھنہٕ پرٮ۪تھ قسمُک سارس، کُنہِ تہِ قسمُک کولہٕ بطخ ستُت تہٕ راتہٕ کریل کھیٚنُک اجازت۔
\v 19 پکھٕ دار کیٚمؠ کریل تہٕ تُلرِ یمہ یہُوواہسؔ قبول چُھنہٕ تمہٕ مہٕ کھیٚیہ ووکھ۔
\v 20 مگر پکھٕ دار کینٛہہ کیٚمؠ چھِ کھیٚنس قٲبل۔
\p
\v 21 کانٛہہ تیٚوتھ جانور مہٕ کھیٚیو یُس پانے مودمُت آسہ۔ توٚہؠ ہکیٚو پانس سٟتؠ روزن والٮ۪ن غٲر ملکی ین یمہ چیز کھیٚنُک اجازت دِتھ یا توٚہؠ ہکیٚو یِم باقی غٲر ملکی ین کٔنِتھ تہِ۔ مگر توٚہؠ چُھو سٲنِس خدا یہُوواہؔ سنٛدؠ۔ یِم لوٗکھ تسنٛدؠ چھِ تِمن چُھنہٕ تِمن ژھاولؠ بچن ہُنٛد ماز کھیٚنُک اجازت یِمن نہٕ خوٗن درامُت آسہ۔
\p توٚہہ پزِنہٕ کانٛہہ کٹھ یا ژھاوُل تمسنٛدِس ماجہ ہنٛدِس دۅدس منٛز رنُن۔
\p
\v 22 "پرٮ۪تھ وریہ پزِ توٚہہ اکہِ پھرِ پننہ زمینکہ تمام ۅپدن والہِ پھسلُک دہِم حصہٕ الگ تھاوُن۔
\v 23 سُہ نِیو تتھ جایہ یۅسہ سون خدا یہُوواہؔ توٚہہ کِژ پننہِ عبادتہ خٲطرٕ ژارِ۔ تتہِ پزِ توٚہہ پننہِ اناجُک، شرابُک، زیتون تیٖلُک تہٕ چارواین تہٕ تیٖرن ہنٛدؠ گۅڈنِکؠ نر ژھوَن ہُنٛد ماز کھیٚون۔ یہ کٔرؠ زیٚو تاکہِ ہیٚچھو یہُوواہسؔ ہمیشہٕ عزت کرُن یمؠ یمہٕ چیز دِتھ توٚہہ برکت کٔر۔
\p
\v 24 اگر سۅ جاے یۅسہ یہُوواہنؔ توٚہہِ کِژ پننہِ عبادٔژ باپتھ ژٲرمٕژ آسہ تُہنٛدِ گھرٕ نِشہ واریاہ دوٗر آسہ تہٕ توٚہؠ ہکیٚو نہٕ پننہِ پھسلُک دٔہِم حصہٕ توٚت نِتھ، یتھ یہُوواہنؔ توٚہہ برکت دِژ تیفلہ کٔرؠ زیٚو یتھ کٔنؠ:
\v 25 پننہِ پھسلُک دہِم حصہ کٕنٛزیٚو، سُہ رقم تھٲوؠ زیٚو احتیاطہٕ سان دجہِ گنٛڈِتھ تہٕ نی زیٚو پانس سٟتؠ تتھ عبادت گاہس منٛز یُس یہُوواہنؔ مقرر کوٚرمُت آسہ۔
\p
\v 26 تتہِ یہ تتھ رقمس خوش کریٚو تہِ ہیٚزیٚو۔ بڈٕ ماز، کٹھ، شراب یا ژۅکرٲمٕتؠ مشروبات۔ تہٕ تتہِ کھیٚیو چیٚیو توٚہؠ تہٕ تُہنٛدؠ گھرٕ وٲلؠ یہُوواہؔ سنٛزن نظرن تل یمہ چیز تہٕ روزیٚو خوش۔
\v 27 مگر پننٮ۪ن شہرن منٛز روزن والٮ۪ن لاوی ہنٛدین اولادن مدد کرنس منٛز مہٕ کٔریٚو کانٛہہ تہِ کوتاہی تکیازِ تِم آسن نہٕ کُنہ زمیٖنٕکؠ مٲلکھ۔
\p
\v 28 پرٮ۪تھ ترےٚ وری انٛد وٲتِتھ کٔرؠ زیٚو پننہِ تمام پھسلُک یُس تمہ وریہ درامُت آسہ دٔہِم حصہ پن پننٮ۪ن شہرن منٛز جمع۔
\v 29 سُہ اناج آسہ لاوی ہنٛدین اولادن باپتھ تکیازِ تِمن آسہ نہٕ پنٕنؠ زمیٖن، تہٕ بیٚیہِ غٲر مُلکی ین باپتھ یمہٕ توٚہہ سٟتؠ روزان آسن، بیٚیہِ یتیمن تہٕ مونڈن باپتھ یمہ تُہنٛدین شہرن منٛز روزان آسن۔ تِمن آسہ اجازت تتھ جایہ یِنُک یتہِ یہ اناج جمع آسہ تہٕ تہِ نیٚون یہ تِمن ضرورت آسہ۔ یہِ کٔریٚو یُتھ سون خدا یہُوواہؔ توٚہہِ پرٮ۪تھ تتھ کامہِ برکت کرِ یۅسہ توٚہؠ کٔریٚو۔
\c 15
\p
\v 1 پرٮ۪تھ ستہِ وہرؠ چھِ توٚہہ تمام قرضہٕ ضروری معاف کرٕنؠ۔\f + \fr 15‏:1 \ft خروج 23:10- تہٕ11، احبار 25:2 پٮ۪ٹھٕ 7 تام \f*
\v 2 سُہ کٔریٚو توٚہؠ یتھٕ کنؠ: توٚہہ منٛزٕ کرِ پرٮ۪تھ کانٛہہ یمؠ کٲنٛسہِ اسرائیلی سٲتھیس قرض دیُتمُت آسہ سُہ کرِ تمِس قرضہٕ معاف۔ توٚہہ پزِنہٕ تمِس زور کرُن زِ سُہ کرِنؠ قرضہٕ ادا۔ توٚہہ پزِ یی کرُن، تکیازِ یہُوواہنؔ کوٚر اعلان زِ پرٮ۪تھ ستہِ وہرؠ پتہٕ گژھِ قرضہٕ معاف کرنہٕ یُن۔
\v 3 اتھ ورؠ یس دوران ہکیٚو توٚہؠ پانس سٟتؠ روزن والٮ۪ن غٲر مُلکی ین مطالبہ کرِتھ زِ تِم کرن قرضُک رقم ادا مگر توٚہہ پزِنہٕ کٲنٛسہ تہِ اسرائیل یس نِش یہ مطالبہ کرُن۔
\p
\v 4‏-5 سون خدا یہُوواہؔ کرِ توٚہہ اتھ ملکس منٛز برکت یُس سُہ توٚہہ دِوان چُھ۔ اگر توٚہؠ سٲنِس خدا یہُوواہؔ سنٛز فرمانبرداری کٔریٚو تہٕ تِم تمام احکام پٲلیٚو یمہ بہٕ توٚہہ از دِوان چُھس تہٕ توٚہہ منٛزٕ روزِنہٕ کانٛہہ تہِ غریب۔
\v 6 سون خدا یہُوواہؔ کرِ توٚہہ برکت یمیُک تمؠ وعدہ کوٚرمُت چُھ تہٕ توٚہؠ ہکیٚو باقی جمٲژن ہنٛدی نفرن قرضہٕ دِتھ مگر توٚہہ پییہِ نہٕ کانٛسہ نِش تہِ قرض تُلنٕچ ضرورت۔ توٚہؠ ہکیٚو واریہن لُکہٕ جمٲژن ہنٛدؠ مٲلی ماملات کاپہِ رٔٹِتھ، مگر تِم ہیٚکن نہٕ تُہنٛدؠ مٲلی ماملات قوبو کٔرِتھ۔\f + \fr 15‏:6 \ft اِستِثنا 28:12، 28:13، 28:44 \f*
\p
\v 7 تِمن شہرن منٛز یم سون خدا یہُوواہؔ توٚہہِ دِوان چُھ، اگر کانٛہہ اسرائیلی غریب آسہ، تمِس کٔرؠ زیٚو مدد خۅد غرض بنؠ زیٚو نہٕ۔
\v 8 امہِ بجایہ بنؠ زیٚو فیاض تہٕ تِمن دیزیٚو سُہ رقم وۅزُم یُس تِمن ضرورت آسہ۔
\p
\v 9 حیٚس تھٲوؠ زیٚو ینہٕ یہ خیال پننِس دِلس منٛز ۅتلیٚوِ زِ "سُہ وری یتھ منٛز قرض معاف کرُن آسہ، امہِ کِنؠ دمہٕ نہٕ بہٕ وۅنؠ کٲنٛسہِ قرضہٕ، تکیازِ ییٚلہ یہ وری ییہِ تہٕ تمِس پییہِ نہٕ یہ واپس دِنُک ضرورتھےٕ۔ "یہ سونٛچُن تہِ چُھ غلط۔ اگر توٚہؠ کٲنٛسہِ ضرورت منٛد اسرائیلی سٲتھیَس سٟتؠ غٲر دوستانہٕ سلوک کران چُھو تہٕ تمِس کینٛہہ دِوان چُھو نہٕ تہٕ سُہ کرٕ توٚہہ خلاف یہُوواہسؔ برُونٛہہ کنہِ فریاد تہٕ یہُوواہؔ ونہِ زِ توٚہہ کوٚرو یمِس شخصس مدد نہ کٔرِتھ بوٚڈ گناہ۔
\v 10 غریبن دِیو آزٲدی سان تہٕ کُھلہٕ دِلہٕ۔ اگر توٚہؠ تہِ کٔریٚو تہٕ یہُوواہؔ کرِ توٚہہِ پرٮ۪تھ کُنہِ کامہِ منٛز برکت۔
\p
\v 11 تُہنٛدِس ملکس منٛز روزن ہمیشہٕ کینٛہہ لوٗکھ غریب، اوٕ کِنؠ چُھسو بہٕ توٚہہ حکم کران زِ غریب لوٗکن پننٮ۪ن اسرائیلی سٲتھین کٔریٚو وژھِ وٲنجہِ مدد۔\f + \fr 15‏:11 \ft متی 26:11، مرقُس 14:7، یوحنا 12:8\f*
\p
\v 12 اگر تُہنٛد کانٛہہ سٲتھی اسرائیلی مرد یا زٔنؠ توٚہہ منٛزٕ کٲنٛسہِ ہُنٛد غلام بننہٕ باپتھ پنُن پان کٕنہِ تہٕ توٚہؠ کٔرؠ زیٚون سُہ شیٚن ورؠ ین کام کرنہٕ پتہٕ رِہا۔ ییٚلہ ستِم وری ییہِ تہٕ توٚہہِ پزن تِم آزاد کرٕنؠ۔\f + \fr 15‏:12 \ft خروج 21:1 پٮ۪ٹھٕ 11 تام \f*
\v 13 ییٚلہ توٚہؠ تِم آزاد کٔرؠ ووکھ تہٕ توٚہہِ پزن نہٕ تِم ژھریٚو اتھو تراوٕنؠ۔
\v 14 بلکہِ پزن تِمو چیزو منٛزٕ یِمن ہنٛز برکت یہُوواہنؔ توٚہہِ عطا کٔر تِمن وژھِ وانجہ دِنؠ یعنی تیٖر غلہٕ تہٕ شراب۔
\p
\v 15 یہ مٔشرٲے زیٚو نہٕ زِ تُہنٛدؠ جدٕاجداد ٲسؠ مِصرس منٛز غلام تہٕ سٲنؠ خدا یہُوواہنؔ کٔرؠ تِم آزاد۔ یوٚہے وجہ چُھ زِ وۅنؠ چُھسو بہٕ توٚہہ یہ کرنُک حکم کران۔
\p
\v 16 اگر تُہنٛدیٚو غلامو منٛزٕ کانٛہہ ونہِ، "بہٕ چُھسو نہٕ توٚہؠ تراونؠ یژھان" شاید اسہِ سُہ توٚہہ تہٕ تُہنٛدِس خاندانس سٟتؠ محبت کران تکیازِ توٚہہ چُھو تِمن سٟتؠ رُت سلوٗک کوٚرمُت۔
\v 17 اگر سُہ یہ ونہِ تہٕ نیٖزیٚون پننِس گھرٕ کِس دروازس نِش تہٕ ییٚلہ سُہ دروازس برُونٛہہ کنہِ کھڑا آسہ تہٕ تمسُنٛد اکھ کن ژھنؠ زیٚو ژوٚمبتھ۔ امہِ سٟتؠ آسہ ننان زِ سُہ روزِ سٲرسےٕ وانٛسہِ تُہنٛد غلام۔ کٲنٛسہِ تہِ لونٛڈی سٟتؠ کٔرؠ زیٚو تی یۅسہ نہٕ توٚہہ تراونؠ یژھان آسہ۔\f + \fr 15‏:17 \ft خروج 21:5 پٮ۪ٹھٕ 6 تام\f*
\p
\v 18 ییٚلہ توٚہہِ پنٕنؠ غلام آزاد کرنٕچ ضرورت آسہ تہٕ شِکوٕ گژھن نہٕ کرٕنؠ۔ یاد تھٲے زیٚو زِ تِمو چھےٚ شیٚن ورؠ ین تُہنٛز خدمت کٔرمٕژ، تہٕ توٚہہ کوٚرو تِمن صرف نیصف ادا یوٗتاہ توٚہؠ تِمن نوکرن دِوان چُھو یِم توٚہہِ مُزورِ پٮ۪ٹھ انان چُھو۔ اگر توٚہؠ تِم آزاد کٔرووکھ تہٕ سون خدا یہُوواہؔ کریٚو توٚہہِ پرٮ۪تھ کامہِ منٛز برکت۔
\p
\v 19 موسیٰؔ ہن ووٚن اسرائیل ین مزید، "سٲنِس خدا یہُوواہؔ سنٛدِس تعظیمس منٛز تھٲیو پننٮ۪ن گٲون تہٕ تیٖرن ہنٛدؠ گۅڈنِکؠ نر ژھو الگ کٔڈِتھ۔ تِم مہٕ کٔرؠ ووکھ پنٕنؠ کانٛہہ کٲم کرنس پٮ۪ٹھ مجبور، تہٕ تِم ژھو جانور مہٕ نی ووکھ۔\f + \fr 15‏:19 \ft احبار 26:27 پٮ۪ٹھٕ 27 تام، گریند 18:15 پٮ۪ٹھٕ 18 تام \f*
\v 20 توٚہؠ تہٕ تُہنٛدؠ گھرٕ وٲلؠ مٲرؠ زیوکھ تِم، تہٕ تِہُنٛد ماز کھیٚی زیٚو یہُوواہسؔ برُونٛہہ کنہِ تتھ جایہ یۅسہ تٔمؠ تُہنٛدِ باپتھ تمؠ سنٛز عبادت کرنہٕ باپتھ ژٲر۔
\v 21 وۅنؠ اگر تِمن جانورن منٛز کانٛہہ نۅقُس آسہ، لنٛگؠ آسن، أنؠ آسن یا بیٚیہِ کانٛہہ بوٚڈ عاب آسیٚکھ تہٕ توٚہہِ پزن نہٕ تِم سٲنِس خدا یہُوواہؔ سنٛدِ ناوٕ قربان کرٕنؠ۔
\p
\v 22 توٚہؠ ہیٚکؠ ووکھ تِم پننٮ۪ن شہرن منٛز مٲرِتھ تہٕ تِہُنٛد ماز کھیٚتھ۔ یمو لوٗکو تمہٕ کامہِ کرِمژٕ آسن یِمو سٟتؠ تِم خدایس برُونٛہہ کنہِ ناپسنٛد چھِ تہٕ تِم یِمو نہٕ تِژھٕ کامہِ کرِمژٕ آسن تِہنٛدِ باپتھ چُھ سُہ ماز کھیٚون جٲیز۔ یتھٕ پٲٹھؠ روٗسؠ کچہِ یا ہانٛکلہٕ سُنٛد ماز کھیٚون جٲیز چُھ۔
\v 23 مگر توٚہہ چُھنہٕ خوٗنہٕ منٛزٕ کینٛہہ تہِ کھیٚون۔ ییٚلہِ توٚہؠ یِم جانور مٲرؠ ووکھ تہٕ توٚہہ پزِ سورےٕ خوٗن زمینس پٮ۪ٹھ تراوُن۔\f + \fr 15‏:23 \ft پیدٲیش 9:3پٮ۪ٹھٕ 4، احبار 17:10 پٮ۪ٹھٕ 14، اِستِثنا 12:23 \f*
\c 16
\p
\v 1 موسیٰؔ ہن ووٚن اسرائیل ین مزید، "پرٮ۪تھ وریہ بہارٕ کِس شُروس منٛز ابیب\f + \fr 16‏:1 \ft ابیب اوس عِبرٲنؠ کلینڈرُک گۅڈنیُک رٮ۪تھ\f* ریٚتس منٛز منٲے زیٚو سٲنِس خدا یہُوواہؔ سنٛدِس تعظیمس منٛز فسحُک وۅرُس۔ یہ ٲس تمہِ ریٚتٕچ اکھ راتھ ییٚلہ یہُوواہنؔ تُہنٛدؠ جدٕاجداد مِصرٕ منٛز مۅکلٲوِتھ أنؠ۔
\v 2 یہ وۅرُس مناونہٕ باپتھ گٔژھِیٚو تتھ جایہ یۅسہ یہُوواہنؔ تُہنٛدِ باپتھ پنٕنؠ عبادت کرنہٕ خٲطرٕ ژٲرمٕژ چھےٚ تہٕ تتہِ کٔرؠ زیٚو پننیٚو چاروایو یا تیٖرو منٛزٕ اکھ لۅکُٹ جانور فسح چہِ قربٲنی باپتھ پیش۔
\p
\v 3 ییٚلہ توٚہؠ فسح ہُک کھیٚن کھیٚیو تہٕ یۅسہ ژۅٹ توٚہؠ کھیٚوان ٲسیٚو سۅ گژھِ خمیرِ روستےٕ آسٕنؠ۔ توٚہہ پزِ ستن دوٚہُن سۅ ژۅٹ کھیٚنؠ یتھ مصیبتٕچ ژۅٹ ونو۔ یہ کرِ توٚہہ تمہِ سفرٕچ یاد تازِ ییٚلہ توٚہؠ زنٛدٕ ٲسیٚو تہٕ تُہنٛدؠ جدٕاجداد مِصر ترٲوِتھ گےَ، یتہِ تِم غلامی ہنٛدِ سببہٕ مصیبتس منٛز ٲسؠ، تِمہ دراے تتہِ جلدی منٛز۔ تِمن اوس نہٕ ٲٹس خمیر تراونُک تہٕ نہٕ تتھ پھۅلنس پرارنُک وقتےٕ۔\f + \fr 16‏:3 \ft خروج 23:14 پٮ۪ٹھٕ 15 تام، 34:18\f*
\v 4 تتھ وۅرسس دوران یُس ستن دوٚہُن جٲری روزِ، گژھِ نہٕ توٚہہ پننِس ملکس منٛز کُنہِ تہِ گھرس انٛدر خمیر آسٕنؠ۔ بیٚیہِ یتہِ زِ فسح کہِ گۅڈنِکہ دوٚہہ شامس یُس ضانور توٚہؠ قربان کٔرؠ وون تمسُنٛد ماز گژھِ أتھؠ راتس منٛز کھیٚنہٕ یُن۔ تمہِ منٛز گژھِ نہٕ کینٛہہ تہِ پگاہ پٮ۪ٹھ روزُن۔
\p
\v 5‏-6 سٲنِس خدا یہُوواہؔ سنٛدِ تعظیمہٕ باپتھ چھےٚ توٚہہ فسح ہٕچ قربٲنی صرف تٔتھؠ جایہ کرٕنؠ یۅسہ سُہ تُہنٛدِ عبادتہٕ خٲطرٕ ژاران چُھ۔ سۅ قربٲنی گژھِ نہٕ تمہِ ملکہٕ کِس بیٚیہِ کُنہِ شہرس منٛز کرنہٕ ینؠ یُس یہُوواہؔ توٚہہ دِوان چُھ۔ سۅ قربٲنی گژھِ آفتاب لوسنہٕ وزِ کرنہٕ ینؠ، تمی وقتہٕ یمہِ وزِ تُہنٛدؠ جدٕاجداد مِصرٕ منٛزٕ نیرنہ لٔگؠ۔\f + \fr 16‏:5‏-6 \ft خروج 12:31\f*
\v 7 ماز کھیٚی زیٚو تتھ عبادت گاہس منٛز سِوِتھ یُس سٲنؠ خدا یہُوواہنؔ ژورمُت چُھ۔ دویمہِ دوٚہہ صبحاے ہکیٚو توٚہؠ پننٮ۪ن متبرک خٟمن منٛز واپس گٔژھِتھ
\v 8 پرٮ۪تھ دوٚہہ شیٚن دوٚہُن یۅسہ ژۅٹ توٚہؠ کھیٚیو تتھ گژھِ نہٕ خمیر آسٕنؠ۔ ستمہِ دوٚہہ گٔژھیٚو توٚہؠ سٲری سٲنِس خدا یہُوواہؔ سنٛز عبادت کرنہٕ باپتھ جمع۔ یہ آسہ آرامُک دوٚہہ، امہِ دوٚہہ چھنہٕ توٚہہ کانٛہہ تہِ کٲم کرٕنؠ۔\f + \fr 16‏:8 \ft خروج کِس 12:6 منٛز چھِ اتھ "اکھ مقدس اسمبلی" ونان۔ لوق 2:41\f*
\p
\v 9 موسیٰؔ ہن ووٚن اسرائیل ین مزید، "پرٮ۪تھ وریہ، یمہِ دوٚہہ پٮ۪ٹھٕ توٚہؠ دراتہِ سٟتؠ فصل لونُن شروع کٔریٚو، ستھ ہفتہٕ گنٛزرٲے زیٚو۔
\v 10 تمہِ پتہٕ منٲزیٚو سٲنِس خدا یہُوواہؔ سنٛدِس تعظیمس منٛز عیدِ پنتِیکُست۔ یِتھ کٔنؠ کٔرؠ زیٚو زِ تٔمس نِش أنؠ زیٚو اناج نذرانہٕ۔ یہُوواہنؔ کٔرنو توٚہہ اتھ ورؠ یس دوران تُہنٛدِس کھہَس منٛز ۅپدن وٲلِس زراعتس برکت۔ اگر توٚہہ واریاہ فصٕل بنیو تیٚلہ کٔریٚو بوٚڈ نذرانہٕ۔ اگر توٚہہ کمےٕ فصٕل بنیو تیٚلہ أنیٚو کینٛہہ لۅکُٹ نذرانہٕ۔
\p
\v 11 تمام خانٛدرٕ والٮ۪ن بٲژن دوٚن پزِ یہُوواہسؔ برُونٛہہ کنہِ خوش روزُن، تہنٛدؠ بچہ، تِہنٛدؠ نوکرن، لاوین ہنٛدؠ اولاد یم تتھ شہرس منٛز روزان آسن، غٲر ملکی، یتیم تہٕ مونٛڈٕ یمہ توٚہہ سٟتؠ بسان آسن، تہِ گژھن خوش آسنہِ۔ تمہٕ نذرانہٕ تہِ أنزیٚو تتھ عبادت گاہس منٛز یُس یہُوواہؔ مقرر کرِ۔
\v 12 ییٚلہ توٚہؠ یِمن احکامن ہنٛز پٲروی کٔرِتھ یمہٕ بٔڈؠ دوٚہہ مناوان ٲسیٚو تیٚلہِ ٲسزیٚو یاد تھاوان زِ تُہنٛدؠ جدٕاجداد ٲسؠ مِصرس منٛز غلام۔
\v 13 پرٮ۪تھ وریہ ییٚلہ توٚہؠ پنُن تمام فصل چُھمبان ٲسیٚو تہٕ دچھِ رس ٲسیٚو کڈان تہٕ توٚہہ پزِ ستن دوٚہُن خٟمن ہنٛز عید مناونؠ۔\f + \fr 16‏:13 \ft احبار 23:42، نحمیاؔہ 8:14، 17\f*
\v 14 تمام خاندرٕ وٲلؠ بٲژ تِہنٛدؠ بچہٕ، نوکر، لاوین ہنٛدؠ اولاد تہٕ پردیسی یمہ تتھ شہرس منٛز روزان آسن، یتیم تہٕ مونٛڈٕ یمہٕ توٚہہ سٟتؠ بسان آسن گژھن یہُوواہسؔ برُونٛہہ کنہٕ خوش آسٕنؠ۔
\v 15 سٲنِس خدا یہُوواہسؔ کٔریٚو تعظیم تہٕ یہ ۅرُس منٲیو ستن دوٚہُن تتھ جایہ یۅسہ تٔمؠ تُہنٛدِ باپتھ پننہٕ عبادتہٕ خٲطرٕ ژٲرمٕژ چھےٚ۔ توٚہہ سارنی پزِ خوشی مناونؠ، تکیازِ یہُوواہؔ چُھ تُہنٛدِس فصلس تہٕ تُہنٛزن تمام کامٮ۪ن برکت کران یمہٕ توٚہہ کریٚو۔
\v 16 لہٰذا پزِ توٚہہ تمام اسرائیلی مردن تتھ جایہ جمع سپدُن یۅسہ سون خدا یہُوواہؔ مقرر کرِ، ترےٚ بٔڈؠ دوٚہہ مناونہٕ باپتھ: خمیرِ روس ژۅچہِ ہُنٛد وۅرُس، عیدِ پنتِیکُست، تہٕ عیدِ خیام یعنی خٟمن ہُنٛد وۅرُس۔ کانٛہہ تہٕ ییہِ نہٕ نذرانہٕ بغٲر یہُوواہسؔ برُونٛہہ کُن۔ توٚہہِ منٛزٕ پزِ پرٮ۪تھ أکِس یمن ۅرسہٕ کٮ۪ن موقن پٮ۪ٹھ یہُوواہؔ سنٛدِ باپتھ نذرانہٕ انُن۔\f + \fr 16‏:16 \ft خروج 23:17، 34:23\f*
\p
\v 17 قربٲنیہ گژھن تِمن برکٔژن مطٲبق آسنہِ یمہٕ تتھ ورؠ یس دوران یہُوواہنؔ توٚہہ عطا کرِ۔
\v 18 پنٕنؠ منصف تہٕ دویم عہدٕدار کٔرووکھ مقرر پننیٚو تمام قبیلو منٛزٕ سارنی شہرن منٛز یمہٕ سون خدا یہُوواہؔ توٚہہِ دِوان چُھ۔ تِم گژھن لوٗکن منٛز صحی پٲٹھؠ انصاف کرٕنؠ۔
\v 19 تِم گژھن نہٕ فٲصلن منٛز بےٚ انصٲفی ورتاوٕنؠ۔ تِمن پزِ نہٕ کانٛہہ شخص بیٚیہِ سنٛدِ نشہٕ ٹوٹھ تھاوُن۔ قٲصؠ ین پزِ نہٕ رُشوت رٹُن۔ تکیازِ اگر قٲصد رُشوت رٹان چُھ چاہے سُہ عٲقل تہٕ ایماندار کُنہٕ آسہ تمہِ سنٛدِ باپتھ چھےٚ انصافس کٲم ہیٚنؠ واریاہ مشکِل۔ سُہ کرِ تی یہ تمِس رشوت دنہٕ وول یژھان آسہ زِ سُہ کٔرِنؠ یہ تہٕ اعلان کٔرتھ ؤنِن بے گُنہس گژھِ سزا میلُن۔
\v 20 توٚہہ پزِ پوٗرٕ پٲٹھؠ غٲر جٲنِبدار تہٕ انصاف پسنٛد بنُن تاکہِ توٚہؠ روزیٚو تتھ ملکس پٮ۪ٹھ قبضہٕ کرنہٕ باپتھ واریہس وقتس زنٛدٕ یُس سون خدا یہُوواہؔ توٚہہِ دِوان چُھ۔
\v 21 ییٚلہ توٚہؠ سٲنِس خدا یہُوواہؔ سنٛز عبادت کرنہٕ باپت قرباہ گاہ بناوان چُھو تہٕ تتھ برُونٛہہ کنہٕ مہٕ کٔریٚو لکٕرِ ہُنٛد کانٛہہ تھمب کھڑا یُس یسیرہؔ دیوی ہنٛز نمایندگی کران آسہ۔
\v 22 تہٕ کٲنٛسہ بُت سنٛزِ پوٗزایہ باپتھ کٔرؠ زیٚو نہٕ کنہِ ہُنٛد کانٛہہ سِتون کھڑا تکیازِ یہُوواہؔ چُھ تِمن نفرت کران۔
\c 17
\p
\v 1 موسیٰؔ ہن ووٚن اسرائیل ین مزید، "سٲنِس خدا یہُوواہؔ سنٛدِ باپتھ مہٕ کٔرؠ وون کانٛہہ تیٚوتھ گُپن، تیوٗر یا ژھاوُل قربان یمِس کانٛہہ نۅقُس آسہ تکیازِ یہُوواہؔ چُھ یتھؠ تحفہٕ ناپسنٛد کران۔
\p
\v 2 ییٚلہِ توٚہؠ تمہِ زمیٖنہِ ہنٛدِس کُنہِ تہِ شہرس منٛز روزان ٲسیٚو یۅسہ سون خدا یہُوواہؔ توٚہہِ دِوان چُھ، فرض کرو کانٛہہ مرد یا زٔنؠ کرِ تمہ عہدٕچ نافرمٲنی کٔرِتھ گناہ یُس یہُوواہنؔ توٚہہِ سٟتؠ کوٚرمُت چُھ۔
\v 3 فرض کرو تٔمؠ شخصن کوٚر بیٚین دیوتاہن، افتابس، زوٗنہِ یا سِتارن عبادت تہٕ سجدٕ۔
\v 4 اگر توٚہہ کانٛہہ ونہِ زِ کانٛہہ شخص چُھ یہ کران تہٕ توٚہؠ کٔرؠ زیٚو اصل پٲٹھؠ تس پرژھٕ گٲر زِ آیا یہ بُرٕ کٲم چھا اسرائیلس منٛز سپٕزمٕژ۔
\p
\v 5 اگر یہ سپُدمُت چُھ تہٕ توٚہہ پزِ سُہ شہرٕ منٛزٕ نیٚبر کڈُن یمؠ مردن یا زنہِ یہ کوٚرمُت آسہ۔ پتہٕ پزِ توٚہہ سُہ شخص سنگسار کٔرِتھ مارُن۔\f + \fr 17‏:5 \ft شہر کس دروازس برونٛہہ کنہِ کھُلہٕ چوک ٲس سۅ جاۓ یتہِ کاروبٲری تہٕ قانونی معاملات طے ٲسؠ یِوان کرنہٕ۔ \f*
\v 6 مگر توٚہہ چُھ صرف یتھ صوٗرتس منٛز یِتھؠ نفرن قتل کرنُک اجازت اگر زن کم از کم زٕ نفر گواہی دِن زِ تِمو وُچھ تِم یتھ کنؠ کران۔ اگر زن صرف اکھ گواہ آسہ تیٚلہ ہیٚکو نہٕ تِمن پھٲسؠ دِتھ۔\f + \fr 17‏:6 \ft یوحنا 8:17، تِیمُتھِیُس 5:19، عبر 10:28\f*
\v 7 گواہ گژھن مجرمن کنہِ لاینؠ۔ ادٕ لاینکھ باقی لوٗکھ کنہِ یۅتام تمہٕ مرن۔ یتھٕ پٲٹھؠ کٔریٚو توٚہؠ پانس منٛز امہِ بُرٕ عملہِ ہُنٛد خٲتمہٕ۔
\p
\v 8 بعضے چُھ منصفن باپتھ یہ فٲصلہٕ کرُن سٮ۪ٹھاہ مشکِل بنان زِ اصل حقیقت کیاہ چھےٚ۔ بنان چُھ زِ سُہ آسہ یہ فٲصلہٕ کرنٕچ کوشش کران زِ ییٚلہ کٲنٛسہِ شخصن کانٛہہ مورمُت یا زخمی کوٚرمُت آسہ، تہٕ تٔمؠ شخصن چھا یہ زٲنِتھ مٲنِتھ مورمُت کِنہٕ وشفن۔ یا سُہ آسہ یہ فٲصلہٕ کرنٕچ کوشش کران زِ آیا کانٛہہ شخص ما چُھ ہنٛگہٕ منٛگے کانٛسہِ عدالت وانن لاگان۔ اگر تہنٛدِس شہرس منٛز یہ زانُن واریاہ دشوار آسہ زِ اصل حقیقت کیاہ چھےٚ تہٕ اگر منصف فٲصلہٕ کٔرِتھ ہیٚوک نہٕ تہٕ توٚہہِ پزِ تتھ جایہ گژھُن یۅسہ سٲنؠ خدا یہُوواہنؔ تُہنٛدِ باپتھ تمؠ سنٛز عبادت کرنہٕ خٲطرٕ ژٲرمٕژ چھےٚ۔\f + \fr 17‏:8 \ft خروج 21:12 پٮ۪ٹھٕ 14\f*
\v 9 تتہِ پزِ توٚہہ لاوی ہنٛدین اولادن یِم کاہن چھِ تہٕ قٲضی یس برُونٛہہ کنہِ مقدِمہ پیش کرُن یُس تمہِ وقتہٕ خدمت انجام دِوان آسہ، سُہ دییہِ فٲصلہٕ زِ کیاہ پزِ کرُن۔
\p
\v 10 ییٚلہ سُہ پنُن فٲصلہٕ دییہِ تہٕ توٚہہ پزِ تی کرُن یہ سُہ کرُن ونہِ۔
\v 11 یُس تٔمؠ فٲصلہٕ دیُت سُہ کٔریٚو قبول، تہٕ یہ سُہ ونہِ تتھ پٮ۪ٹھ کٔریٚو عمل۔ تہِ گژھِ نہٕ کُنہ تہِ صوٗرتس منٛز بدلاونہٕ یُن یہ لاوی کاہن تہٕ مُصنف فٲصلہٕ نِن۔
\p
\v 12 سُہ گژھِ قتل یُن کرنہٕ یُس کانٛہہ تہِ قٲضؠ یا کاہن سنٛز نافرمٲنی کرِ، یُس یہُوواہؔ حٲظر ناظر رٹِتھ فٲصلہٕ دِوان چُھ زِ کیاہ چُھ کرُن۔ یہ کرنہٕ سٟتؠ روزیٚو توٚہؠ تمہِ خراب عملہِ نِشہ دور یۅسہ توٚہہِ منٛز آسہ۔
\v 13 سُہ شخصس قتل کرنہٕ پتہٕ بوزن تمام لوٗکھ یہ خبر تہٕ تِمن گژھِ خوف تہٕ پتہٕ کرِنہٕ کانٛہہ تہِ دوبارٕ یژھ حرکت۔
\p
\v 14 بہٕ چُھس زانان زِ تتھ ملکس پٮ۪ٹھ یُس سون خدا یہُوواہؔ توٚہہِ دِوان چُھ قبضہٕ کرنہٕ تہٕ تتہِ روزنہٕ پتہٕ ؤنیٚو توٚہؠ زِ اسہِ گژھِ اکھ بادشاہ آسُن یُس اسہِ پٮ۪ٹھ حکومت کرِ، تِمن بادشاہن ہنٛدؠ پٲٹھؠ یمہٕ اسہِ انٛدؠ پٔکؠ ملکن منٛز چھِ۔
\v 15 سون خدا یہُوواہؔ دییہِ توٚہہ بادشاہ بناونُک اجازت، مگر پژھ کٔرؠ زیٚو توٚہؠ کٔرؠ وون سُہ اکھ شخص مقرر یُس تٔمؠ ژورمُت آسہ۔ سُہ شخص گژھِ اسرائیلی سٲتھیو منٛزٕ آسُن۔ توٚہؠ کٔرؠ زیٚون نہٕ کانٛہہ غٲر ملکی پنُن بادشاہ مقرر۔
\p
\v 16 بادشاہ بننہٕ پتہٕ پزن نہٕ تس پننہِ باپتھ زیادٕ تعدادس منٛز گُرؠ ہیٚنؠ۔ تمِس پزن نہٕ پننہِ خٲطرٕ گُرؠ مٔلؠ ہیٚنہٕ باپتھ لوٗکھ مِصر سوزٕنؠ، تکیازِ یہُوواہنؔ چُھنے ژےٚ ونمُت، زِ زانٛہہ تہِ گٔژھؠ زیٚنہٕ کُنہِ چیزٕ باپتھ مِصر واپس!\f + \fr 17‏:16 \ft بادشاہس پَزِ نہٕ پننٮ۪ن گُرٮ۪ن ہنٛدِ بدلہٕ غلام پٲٹھؠ مِصر سوزِتھ پننہِ خٲطرٕ گُرٮ۪ن ہُنٛد بوٚڑ تعداد حٲصِل کرُن۔\f*
\v 17 تہٕ تمِس گژھن نہٕ واریاہ خاندارنہِ آسنہِ تکیازِ اگر تٔمؠ تہِ کوٚر تہٕ تمہٕ رکاون تمِس یہُوواہؔ سنٛز عبادت کرنہٕ نشہٕ۔ تہٕ تمِس چُھنہٕ زیادٕ سۅن تہٕ رۅف حٲصِل کرن۔
\p
\v 18 ییٚلہِ سُہ تُہنٛد بادشاہ بنہِ تہٕ تمِس پزِ یمہٕ قانون نقل کرنہٕ باپتھ کانٛہہ نفر مقرر کرُن۔ تمِس پزن تمہٕ تِمو طُمارو پٮ۪ٹھٕ نقل کرٕنؠ یمہٕ لاوی نسلہٕ کٮ۪ن کاہنن اتھِ چھِ۔\f + \fr 17‏:18 \ft مطلب چُھ زِ، "زانہٛہ تہِ مہٕ گٔژھِو ناکام خدایہِ سُنٛد حکم بجا اننس منٛز" \f*
\v 19 سُہ تھاوِ تمہٕ نٔوؠ طُمار پانس اتھِ تہٕ پننہِ زندگی دوران آسہ تِم پرٮ۪تھ دوٚہہ پران تاکہِ سُہ ہیٚچھِ یہُوواہسؔ بہتر پٲٹھؠ احترام کرُن تہٕ تِمن تمام اصولن تہٕ ضٲبطن وفادٲری سان مانُن یمہٕ تِمن قانونن منٛز لیٚکھِتھ چھِ۔
\p
\v 20 اگر بادشاہ تہِ کران آسہ تہٕ تمِس گژھِ نہٕ یہ گمانہٕ زِ سُہ چُھ پننٮ۪ن اسرائیلی سٲتھین ہنٛدِ کھۅتہٕ زیادٕ اہم تہٕ سُہ کرِ پوٗرٕ پٲٹھؠ یہُوواہؔ سنٛدین حکمن ہنٛز تعمیل۔ نتیجہٕ نیرِ یہ زِ سُہ تہٕ تمسنٛدؠ اولاد روزن اسرائیلس منٛز واریہس وقتس بادشاہ سنٛدِ حثیتہٕ حکومت کران۔"
\c 18
\p
\v 1 موسیٰؔ ہن ووٚن اسرائیل ین مزید، "کاہن، یِم سٲری لاوی قبیلٕکؠ چھِ کرن نہٕ اسرائیلس منٛز کانٛہہ تہِ زمین حٲصل۔ امہ بجایہ کرن تِم کینٛہہ کھیٚن تمہِ قربٲنی منٛزٕ حٲصل یۅسہ باقی لوٗکھ قربان گاہس پٮ۪ٹھ زالنہٕ باپتھ پیش کران چھِ تہٕ کینٛہہ باقی قربٲنیہ یمہٕ یہُوواہسؔ نذر کرنہٕ یِن۔
\v 2 اسرائیلی سٲتھین ییہِ نہٕ کانٛہہ تہِ زمین دِنہٕ یتھ کِنؠ باقی قبیلن دِنہٕ ییہِ۔ تِم یہ کینٛژھا حٲصل کرن سُہ آسہ یہُوواہؔ سنٛدؠ پُزٲرؠ آسنُک اعزاز، یہ تٔمؠ ووٚنمُت چُھ زَ تِمن گژھِ آسُن۔\f + \fr 18‏:2 \ft اِستِثنا 10:9\f*
\p
\v 3 ییٚلہ لوٗکھ قربٲنی باپتھ دانٛد یا کٹھ انان چھِ تِمن پزِ تِمن جانورن ہُنٛد کنٛگو، کلہٕ ماز تہٕ ڈمبِنؠ کاہنن دِنؠ۔
\v 4 یُس فصل لونیٚو تمیُک گۅڈنیُک حصہ تہٕ مےَ یُس توٚہؠ بناوان چُھو تمیُک گۅڈنیُک حصہ، زیتون تیٖلُک گۅڈنیُک حصہ تہٕ ییرُک گۅڈنیُک حصہ یُس توٚہؠ پننٮ۪ن تیٖرن نیٚتِتھ تیار کران چُھو دیزیٚو ضرور کاہنن۔
\v 5 توٚہہِ پزِ ضروری یہ کرُن تکیازِ سون خدا یہُوواہؔ چُھ تُہنٛدیٚو تمام قبیلو منٛزٕ لاوی قبیلس ژاران تاکہ تمہِ قبیلٕکؠ لوٗکھ آسن تِم یمہٕ ہمیشہ تمؠ سنٛز خدمت کرن وٲلؠ کاہن آسن۔
\p
\v 6 اگر لاوی قبیلُک کانٛہہ نفر یُس اسرائیل چہ کُنہ، بستی منٛز روزان آسہ یژھِ تتھ عبادت گاہس منٛز یُن تہٕ تتہِ روزُن یُس یہُوواہنؔ مقرر کوٚرمُت آسہ،
\v 7 تمِس چُھ تتہِ بحثیتِ کاہن یہُوواہؔ سنٛز خدمت کرنُک اجازت، بلکُل تِتھے پٲٹھؠ یتھٕ پٲٹھؠ لاوی قبیلٕکؠ باقی نفر تتہِ خدمت کران آسن۔
\v 8 تس ییہِ سُے کھیٚن دِنہٕ یُس باقی کاہنن میلان چُھ۔ تمِس چُھ اجازت، سُہ رقم پانس رٹنُک یُس تمسنٛدؠ رشتہٕ دار کینٛہہ مال کٔنِتھ حاصِل کرن تہٕ أمِس سوزن۔
\p
\v 9 ییٚلہ توٚہؠ تتھ ملکس منٛز أژیو یُس سون خدا یہُوواہؔ توٚہہِ دِوان چُھ تہٕ توٚہہ پزِنہ تِمن بُرٕ کامٮ۪ن ہُنٛد نقل کرُن یمہٕ تتہِ روزن وٲلؠ لوٗکن ہنٛزٕ جمٲژ کران چھےٚ۔
\v 10 توٚہہ پزِنہٕ پننیٚو اولادو منٛزٕ کانٛہہ تہِ قربان گاہس پٮ۪ٹھ زٲلِتھ قربان کرُن۔ آینٛدٕ کیاہ چُھ سپدن وول یہ زاننہٕ خٲطرٕ چُھنہٕ توٚہہ علمِ نجوم زانن والٮ۪ن کُن رجوع کرنٕچ کوشش کرٕنؠ۔ یہ زاننہٕ باپتھ جادین ہُنٛد استعمال کرُن تہٕ یہ زاننہٕ خٲطرٕ سِتارٕ یاشگون وُچھ زِ آینٛدٕ کیاہ سپدِ۔ جٲدو گری گژھِ نہٕ ہیٚچھِنؠ۔ لوٗکن گژھن نہٕ جٲدؠ کرٕنؠ۔
\v 11 موٚردٕ لوٗکن ہنٛدین روحن سٟتؠ گژھِ، نہٕ کتھ کرنٕچ کوشش کرٕنؠ۔ جادو گژھِ نہٕ کرُن۔
\p
\v 12 یہُوواہؔ چُھ تِمن لوٗکن سٟتؠ نفرت کران یُس تہِ کانٛہہ تِمو منٛزٕ بُرٕ کام کران چُھ۔ تہٕ ییٚلہ توٚہؠ تتھ ملکس منٛز برُونٛہہ پٔکیٚو تہٕ تمہٕ لُکہٕ جمٲژ کٔڈؠ زیوکھ نیٚبر تکیازِ تِم چھِ یمہٕ بُرٕ کامہِ کران۔
\v 13 مگر توٚہہ پزِ ہمیشہٕ یہُوواہسؔ سٟتؠ وفادٲری ورتاوٕنؠ۔ تہٕ تِمو بُرٕ کامیٚو نشہٕ ہمیشہٕ پرہیز کرُن۔\f + \fr 18‏:13 \ft متی 5:48\f*
\p
\v 14 یمہ لُکہ جمٲژ توٚہؠ امہِ زمینہِ پٮ۪ٹھٕ کڈن وٲلؠ چُھو یتھ توٚہؠ قبضہٕ کٔریٚو۔ تِم چھِ کاہنن تہٕ فال وچُھن والٮ۪ن سٟتؠ مشورٕ کران۔ مگر یۅتام تُہنٛد تعلق چُھ، سون خدا یہُوواہؔ دییہِ نہٕ توٚہہ تہِ کرنُک اجازت۔
\v 15 کُنہِ دوٚہہ سوزِ سُہ توٚہہِ منٛزٕ مےٚ ہیٚو کانٛہہ رسول۔ سُہ ونہِ توٚہہ زِ مستقبلس منٛز کیاہ چُھ سپدن وول، تہٕ توٚہہ پزِ تمؠ سنٛز عبادت کرٕنؠ۔\f + \fr 18‏:15 \ft متی 17:5، مرقُس 9:7، لوق 9:35، اعمال 3:22، 7:37\f*
\v 16 یمہِ دوٚہہ تُہنٛدؠ جدٕاجدادسیناؔ بالہٕ\f + \fr 18‏:16 \ft کوہِ سینا\f* دامنس تل جمع ٲسؠ، تِمو کٔر مےٚ عرضی زِ أسؠ چھنہٕ یژھان زِ یہُوواہؔ گوٚژھ اسہِ سٟتؠ دوبارٕ کتھ کرُن تہٕ أسؠ چھنہٕ سُہ بوٚڈ نار وچُھن یژھان یُس دزان اوس۔ تُہنٛدیٚو جدٕاجدادو ووٚن یہ تکیازِ تِم ٲسؠ کھۅژان اگرے یہُوواہنؔ دُبارٕ تِمن سٟتؠ کتھ کٔر تہٕ تِم مرن۔\f + \fr 18‏:16 \ft اِستِثنا 5:23 پٮ۪ٹھٕ 31 تام\f*
\p
\v 17 پتہٕ ووٚن مےٚ یہُوواہنؔ، "یہُنٛد ونُن چُھ پوٚز۔"
\v 18 تہٕ بہٕ سوزٕ یمو منٛزٕ توٚہہ ہیٚوٗ کانٛہہ نبی۔ بہٕ ونہٕ تس ونُن کیاہ چُھ، تہٕ پتہٕ ونہِ سُہ لوٗکن تہِ سورےٕ یہ بہٕ تس ونُن ونہٕ۔\f + \fr 18‏:18 \ft اعمال 3:2، 7:37\f*
\v 19 سُہ کرِ میانِس حقس منٛز کتھ۔ تہٕ بہٕ دمہٕ تس سزا یُس اکھا نہٕ تمؠ سنٛزن کتھن کن تھاوِ۔\f + \fr 18‏:19 \ft اعمال 3:23\f*
\p
\v 20 مگر اگر کانٛہہ شخص یہ ونہِ زِ بہٕ چُھس نبی تہٕ کانٛہہ تِژھ کتھ وننُک جُرت کرِ یۅسہ اپُز آسہ زِ یہ چھےٚ میانہِ طرفہٕ آمٕژ مگر مےٚ اسہِ نہٕ تس تہِ ونُن ونمُت یا تیٚوتھ کانٛہہ پٲغام ونہ یتھ سُہ ونہِ یہ چُھ باقی معبودو تس پٮ۪ٹھ نٲزِل کوٚرمُت۔ یہ کرنس پٮ۪ٹھ گژھِ تس سزاے موت دِنہٕ یُن۔"
\p
\v 21 مگر شاید ؤنیٚو توٚہؠ پٲنؠ پانس، "أسؠ کِتھٕ کِنؠ ہیٚکو ؤنِتھ اگر کانٛہہ پٲغام ہیٚتھ ییہِ زِ سُہ چُھنہٕ یہُوواہؔ سنٛدِ طرفہٕ آمُت؟
\p
\v 22 امیُک جواب آسہ یہِ زِ ییٚلہِ کانٛہہ پٲغام ہیٚتھ ییہِ زِ آینٛدٕ کیاہ چُھ سپدن وول، یہ چُھ سُہ پٲغام یُس مےٚ یہُوواہؔ سنٛدِ طرفہٕ نٲزِل سپُد، یہ تٔمؠ ووٚن اگر تہٕ سپُد نہٕ زانُن گژھِ زِ یہ پٲغام اوس نہٕ یہُوواہؔ سنٛدِ طرفہٕ آمُت۔ تمؠ شخصن چُھ غلط دعوا کوٚرمُت زِ یہ اوس تمِس پٮ۪ٹھ یہُوواہؔ سنٛدِ طرفہٕ نٲزِل سپُدمُت۔ لہٰذا چھنہٕ توٚہہ کُنہِ تہِ چیزس کھۅژنٕچ ضرورت یہ سُہ ونان آسہ۔
\c 19
\p
\v 1 ییٚلہ سٲنؠ خدا یہُوواہنؔ تِمن لوٗکن ہنٛزٕ جمٲژ تمہِ سرِزمینہِ پٮ۪ٹھٕ تباہ کرِ تہٕ ییٚلہِ توٚہہ تِم تِمو شہرو منٛزٕ کٔڈؠ ووکھ تہٕ توٚہہ کوٚرو تِہنٛدین گھرن منٛز روزُن شُروع،
\p
\v 2 توٚہہ پزیٚو ترین حصن منٛز سۅ زمین تقسیم کرٕنؠ یۅسہ سُہ توٚہہِ دِوان چُھ۔ پتہٕ ژٲرؠ وون پرٮ۪تھ حصس منٛز اکھ شہر۔
\v 3 توٚہہ پزن اصلہِ سڑکہٕ بناونہِ تاکہ لوٗکھ ہیٚکن یِمن شہرن تام آسٲنی سان وٲتِتھ۔ یُس نفر کٲنٛسہِ دویمِس فردس ماران آسہ سُہ ہیٚکہ پان بچاونہٕ باپتھ یمو شہرو منٛزٕ کُنہِ اکِس شہرس کُن ژٔلِتھ۔\f + \fr 19‏:3 \ft تور گژھنکہِ فٲصلٕچ کر پیمٲیش\f*
\v 4 یہ اصول چُھ تس شخصس متعلق یمؠ کانٛہہ دویم شخص مورمُت آسہ۔ اگر کانٛہہ وشفن کانٛسہ شخصہٕ سنٛدِ سٟتؠ مودمُت آسہ یُس نہٕ تس دشمن آسہ ہے، تہٕ سُہ ہیٚکہٕ یمو منٛزٕ کُنہ اکِس شہرس منٛز گٔژھتھ پان بچٲوِتھ۔
\v 5 مثلن اگر زٕ نفر جنٛگل زیٚون ژٹنہِ گژھن تہٕ أکؠ سنٛدِ اتھٕ منٛزٕ آیہ زیٚون ژٹان ژٹان تبر اتھٕ منٛزٕ نیرتھ تہٕ لٔج دویمِس نفرس تہٕ سُہ نفر مود، تہٕ یُس نفر تبر چلاوان اوس تہٕ تس نفرس چُھ اجازت زِ سُہ ہیٚکہ یِمن شہرن کُن ژٔلِتھ تہٕ پان بچٲوِتھ۔ تکیازِ تمہِ شہرٕکؠ لوٗکھ کرن تس حفاظت۔
\p
\v 6 تکیازِ تمؠ مور وشفن کانٛہہ حالانکہ سُہ شخص اوس نہٕ تس دشمن تہِ اوِ کِنؠ ہیٚکہِ سُہ تِمو شہرو منٛزٕ کُنہِ اکِس کُن ژلنٕچ کوشش کٔرِتھ۔ اگر اکُے شہر آسہ تہٕ سُہ ٲسؠ تن تمہِ شہرٕ نشہٕ دوٗر تہِ۔ پتہٕ اگر بدلہٕ ہیٚنہٕ وول مٲرؠ مٕتؠ سُنٛد کانٛہہ رشتہٕ دار واریاہ شرارتس منٛز آسہ تہٕ سُہ ژھنہِ تتھ شہرس منٛز واتنہٕ برُونٛٹھےٕ کٲنٛسہِ دوٚیمِس نفرس رٔٹِتھ۔
\v 7 اوٕ کِنؠ چُھسو بہٕ توٚہہِ حکم دِوان زِ امہِ موٚکھٕ ژٲریٚو توٚہؠ ترےٚ شہر۔
\p
\v 8‏-9 اگر توٚہؠ تہِ سورےٕ کٔریٚو یمیُک بہٕ توٚہہ از حکم کران چُھسو تہٕ اگر توٚہؠ سٲنِس خدا یہُوواہسؔ سُنٛد محبت تھاوان چُھو تہٕ پنٕنؠ زندگی تمؠ سنٛزِ مرضی مطٲبق پکنٲیو تہٕ سون خدا یہُوواہؔ کرِ توٚہہ امہِ کھۅتہٕ تہِ زیادٕ زمین عطا یۅسہ توٚہہِ چھیٚو۔ ییٚلہ توٚہہِ گۅڈنچہِ لٹہِ اتھ پٮ۪ٹھ قبضہٕ کوٚرو یہ تٔمؠ کرنُک وعدہ کوٚرمُت اوس۔ سُہ دییہ توٚہہ سۅ سٲرےٕ زمیٖن یمیُک تٔمؠ تُہنٛدین جدٕاجدان وعدہ کوٚرمُت اوس زِ سۅ میلہِ توٚہہِ۔ ییٚلہ سُہ توٚہہ سۅ زمین دییہِ تہٕ توٚہہِ پزن بیٚیہِ ترےٚ شہر ژارٕنؠ یوٚت لوٗکھ ژٔلِتھ ہیٚکن۔
\v 10 یہ کٔرؠ زیٚو اوٕ مۅکھٕ زِ یِم لوٗکھ بے قصور آسن تِم مرن نہٕ، تہٕ توٚہؠ بٔنِو نہٕ مجرم تِمن سزا دِنُک اِجازت دِنہٕ خٲطرٕ، تتھ ملکس منٛز یُس یہُوواہؔ توٚہہِ دِوان چُھ۔
\p
\v 11 مگر فرض کرو زِ کانٛہہ آسہ پننِس دشمنس سٟتؠ نفرت کران تہٕ ژھوٚپہٕ کٔرِتھ بہیہ تس نفرس وتہِ منٛز زاگہِ۔ پتہٕ ییٚلہ سُہ تپٲرؠ نیرِ تہٕ یہ کریس اچانک حملہٕ کرِتھ قتل۔ اگر یہ حملہٕ آور تِمن شہرن کُن بچنہٕ خٲطرٕ ژلہِ،
\v 12 تمہِ شہرٕ کٮ۪ن بُزرگن پزِ نہٕ تمِس حملہٕ آور سنٛز حفاظت کرٕنؠ یتہِ قتل سپُدمُت آسہ۔ تِمن پزِ کانٛہہ تتھ شہرس منٛز سوزُن یوٚت سُہ نفر ژوٚلمُت آسہ، تہٕ سُہ قٕساس ہیٚنہٕ خٲطرٕ واپس انُن، یُتھ زن سُہ نفر مٲرِتھ ہیٚکہِ۔
\v 13 توٚہہ گژھِ نہٕ تِمن نفرن پٮ۪ٹھ رحم یُن یمہٕ کٲنٛسہِ قتل کرن۔ امہِ بجایہ پزنو توٚہہِ تِم قتل کرٕنؠ، یُتھ زنہٕ اسرائیل چہ سرِزمینہِ پٮ۪ٹھ لوٗکھ بےگناہ قتل سپدن، تہٕ امہِ سٟتؠ روزن تُہنٛدِ باپتھ ماملات واریاہ ٹھیک۔\f + \fr 19‏:13 \ft گریند 35:33 تہٕ 34\f*
\p
\v 14 ییٚلہ توٚہؠ تتھ ملکس منٛز روزان ٲسیٚو یُس سون خدا یہُوواہؔ توٚہہ دِوان چُھ تہٕ تتہِ ڈٲلؠ زیٚو نہٕ پننٮ۪ن ہمساین ہنٛدین جادادٕ کیٚن حدودن ہنٛدؠ نشانہٕ۔ یمہٕ تتہِ واریاہ برُونٛہہ مقرر کرنہٕ چھِ آمٕتؠ۔\f + \fr 19‏:14 \ft اِستِثنا 27:17، ایوب 24:2، امثال 22:28، 23:10، ہوش 5:10 \f*
\p
\v 15 اگر کٲنٛسہِ فردس پٮ۪ٹھ کُنہِ جُرمُک الزام لاگنہٕ آسہ آمُت، تہٕ اکھ شخص یُس ونان آسہ زِ مےٚ وُچھ سُہ یہ کران، سُہ قصور وار زاننہٕ باپتھ چُھنہٕ یہ کٲفی۔ تتہِ گژھن کم از کم زٕ نفر ضرور آسٕنؠ یمہٕ یہ گواہی دِن زِ اسہِ وُچھ سُہ یہ کران۔ اگر صرف اکھ گواہ آسہ، منصفن پزِنہٕ یقین کرُن زِ یہ کینٛژھا یہ ونان چُھ یہ چُھ پوٚز۔\f + \fr 19‏:15 \ft متی 18:16\f*
\p
\v 16 یا فرض کرو کانٛہہ آسہٕ کٲنٛسہِ پٮ۪ٹھ اپُز تحمت لٲگِتھ تس پٮ۪ٹھ ظلم کرنٕچ کوشش کران۔
\v 17 تیٚلہ پزِ دوٚنونی تتھ جایہ گژھُن یتہِ لوٗکھ عبادت کران چھِ تہٕ تِمن کاہنن تہٕ منصفن سٟتؠ کتھ باتھ کرٕنؠ یمہٕ تمہِ ساعتہٕ خدمت کران آسن۔
\v 18 منصفن پزِ غورٕ سان مقدِمس تحقیقات کرُن۔ اگر ججن یہ ننیاو زِ أکؠ لوگ بیٚیِس پٮ۪ٹھ غلط الزام،
\v 19 تمِس شخصس گژھِ سُے سزا دنہٕ یُن یُس سزا بیٚیِس دنہٕ ییہِ ہے اگر زن جج فٲصلہٕ دِہن زِ سُہ چُھ قصوروار۔ یِتھیٚن لوٗکن سزا دنہٕ سٟتؠ ہکیٚو توٚہؠ پننِس سماجس منٛز امہِ بُرایی ہُنٛد خٲطمہٕ کٔرِتھ۔
\p
\v 20 تہٕ ییٚلہِ تس شخصس سزا دِنہٕ ییہِ تہٕ سٲری لوٗکھ بوزن زِ کیاہ سپُد تہٕ تِمن اژِ خوف تہٕ پتہٕ کرِنہٕ کانٛہہ تہِ ہمت یتھٕ پٲٹھؠ کرنٕچ۔
\v 21 توٚہہِ پزِ نہٕ تِمن لوٗکن پٮ۪ٹھ ترس کھیٚون یِمن امہِ قسمُک سزا دنہٕ یوان چُھ۔ قٲیِدٕ گژھِ یہ آسُن زِ یمؠ کانٛہہ قتل کوٚر سُہ گژھِ قتل کرنہٕ یُن۔ اگر کٲنٛسہِ أچھ کڈنہٕ آسہ آمٕژ تس أچھ کڈن وٲلِس گژھِ أچھ بدلہٕ أچھ کڈنہٕ یِنؠ، اگر کٲنٛسہِ دنٛد پُھٹراونہٕ آو تس دنٛد پُھٹراون وٲلِس گژھِ دنٛدس بدلہٕ دنٛد پُھٹراونہٕ یُن۔ یمؠ شخصن کٲنٛسہِ اتھٕ ژۅٹمُت آسہ تس تہِ گژھِ تِتھے پٲٹھؠ اتھٕ ژٹنہٕ یُن۔ یمؠ شخصن کٲنٛسہِ کھۅر ژۅٹمُت آسہ تمِس تہِ گژھِ اکھ کھۅر ژٹنہٕ یُن۔\f + \fr 19‏:21 \ft متی 5:38\f*
\c 20
\p
\v 1 موسیٰؔ رود ہٮ۪تھےٕ اسرائیل ین ونان زِ "ییٚلہ تُہنٛدؠ سِپاہ تُہنٛدین دشمنن سٟتؠ جنٛگ کرنہِ نیرن تہٕ توٚہؠ وُچھو تِمن واریاہ گُرؠ، رتھ تہٕ تِہُنٛد فوج پننہِ فوجہ نشہٕ واریاہ بوٚڈ مگر توٚہؠ کھوٚژؠ زیٚو نہٕ تکیازِ سون خدا یہُوواہؔ یمؠ تُہنٛدؠ جدٕاجداد مِصرٕ منٛزٕ حفاظتہٕ سان کٔڈؠ آسہ توٚہہِ سٟتؠ۔
\p
\v 2 ییٚلہ توٚہؠ جنگ شروع کرنہٕ باپتھ تیار ٲسیٚو تہٕ سردار کاہن گژھِ فوجس برُونٛہہ کنہِ کھڑا آسُن۔\f + \fr 20‏:2 \ft قٲضؠ 20:18 پٮ۪ٹھٕ 24، 1 سموئیلؔ 14:36 پٮ۪ٹھٕ 42، 2 کورنتھ 20:13 پٮ۪ٹھٕ 22\f*
\v 3 سُہ گژھِ تِمن ونُن، اے اسرائیل کیٚو، میٲنؠ کتھ بوزیٚو! از چُھو توٚہؠ پننٮ۪ن دشمنن سٟتؠ جنگس نیران۔ کھوژیٚو مہٕ،
\v 4 تکیازِ سون خدا یہُوواہؔ گژھِ توٚہہ سٟتؠ۔ سُہ لڑِ تُہنٛدِ باپتھ تُہنٛدین دشمنن سٟتؠ۔ تہٕ توٚہہ بنایو تِمن شِکس دِنس قٲبل۔"
\p
\v 5 پتہٕ ونن فوجی افسر ضروری پننِس فوجس، "اگر توٚہہ منٛزٕ کٲنٛسہِ نُوو گھرٕ بنومُت چُھ تہٕ سُہ چُھس نہٕ خدایہ سنٛدِ باپتھ وقف کوٚرمُت، سُہ گٔژھِن گھرٕ تہٕ کٔرِنؠ تتھ وقف۔ اگر سُہ تہِ کرِنہٕ، تہٕ پتہٕ جنگس منٛز گُذریو، بدل کانٛہہ ییہِ تہٕ کریٚس قبضہٕ تہٕ بسہِ تتھ منٛز۔
\p
\v 6 اگر توٚہہ منٛزٕ کٲنٛسہِ دچھِ باغ لوگمُت چُھ تہٕ وُنہِ چھیٚس نہٕ تتھ دچھ وٲجمٕژ، تہٕ سُہ گٔژھِن گھرٕ۔ اگر سُہ یتی رود تہٕ جنگس منٛز مود تہٕ بدل کانٛہہ والہ سۅ دچھ تہٕ تتھ شراب بنٲوِتھ تُلہ مزٕ۔\f + \fr 20‏:6 \ft احبار 19:23پٮ۪ٹھٕ 25\f*
\v 7 اگر توٚہہ منٛز کٲنٛسہِ زنہِ سٟتؠ رشتہٕ گنٛڈتھ چُھ تہٕ وُنہ چُھس نہٕ خاندر کوٚرمُت، سُہ گژھِن گھرٕ۔ اگر سُہ یتؠ رود تہٕ جنگس منٛز مود تہٕ بدل کانٛہہ ییہِ تہٕ کرِ تمِس سٟتؠ خاندر۔"\f + \fr 20‏:7 \ft اِستِثنا 22:23 پٮ۪ٹھٕ 24\f*
\p
\v 8 پتہٕ پزِ افسرس یتہِ ونُن، "اگر توٚہہ منٛزٕ کانٛہہ کھۅژان چُھ یا کھۅژٕ بُڈٕ چُھ، سُتہ گٔژھِن گھرٕ، یُتھ نہٕ یہ سپدِ زِ تمسنٛدین سٲتھی سِپہن تہِ پُھٹہِ ہمت تہٕ حوصلہٕ۔"
\v 9 ییٚلہ افسر سِپہن یہ ؤنِتھ مۅکلاون، تِمن پزن ضروری تِمن باپتھ کمانڈر مقرر کرٕنؠ۔
\p
\v 10 ییٚلہ توٚہؠ کُنہِ دوٗر شہرس منٛز حملہٕ کرنہٕ باپتھ گٔژھِیٚو تہٕ گۅڈٕ ؤنؠ زیٚو تتہِ کٮ۪ن لوٗکن زِ اگر تِم ہتھیار تراون تہٕ توٚہؠ کٔرؠ زیٚو نہٕ تیٚلہ تِمن پٮ۪ٹھ حملہٕ۔
\v 11 اگر تِم شہرچہٕ پھاٹکہٕ یلہٕ تراون تہٕ ہتھیار تراون تہٕ تِم سٲری بنن تُہنٛدؠ غلام تہٕ کرن تُہنٛدِ باپتھ کٲم۔
\p
\v 12 وۅنؠ اگر تِم امنہٕ سان ہتھیار تراونہٕ نشہٕ انکار کرن تہٕ توٚہہِ خلاف لڑنُک فٲصلہٕ کرن تہٕ تُہنٛدِس فوجس پزِ شہرس گیرٕ کرُن تہٕ دیوار دٔرِتھ دِنؠ۔
\v 13 پتہٕ ییٚلہ سون خدا یہُوواہؔ توٚہہ شہرس پٮ۪ٹھ قبضہٕ کرنس قٲبل بناوِ تہٕ توٚہہ پزن شہرٕکؠ تمام مرٕد قتل کرٕنؠ۔
\p
\v 14 مگر توٚہہ چُھ اجازت زِ تمہ زنہِ، بچہٕ، چاروٲے تہٕ سُہ پرٮ۪تھ کانٛہہ چیز یُس توٚہؠ شہرٕ منٛز انُن یژھیٚو۔ توٚہہ چُھ تِمو ساروےٕ چیزو سٟتؠ لطف اندوز سپدنُک اجازت یمہٕ تُہنٛدین دشمنن ہنٛدؠ ٲسؠ، تِم چیز یمہٕ سٲنؠ خدا یہُوواہنؔ توٚہہِ دِتؠ۔
\v 15 یہ چُھ توٚہہ پرٮ۪تھ کُنہِ شہرس منٛز کرُن یمہٕ امہِ ملکہٕ نشہٕ دوٗر آسن یتہِ توٚہؠ آباد سپدیٚو۔
\p
\v 16 مگر تِمن شہرن منٛز یمہٕ اتھ ملکس منٛز چھِ یمہٕ سون خدا یہُوواہؔ توٚہہِ دِوان چُھ چھِ توٚہہِ تمام لوٗکھ تہٕ سٲری جانور قتل کرٕنؠ۔
\v 17 توٚہہ چُھ پوٗرٕ پٲٹھؠ حِتی، عمور، کنعان، فِرزی، حوی تہٕ یبوسی قومو نشہٕ مکمل پٲٹھؠ نجات پراوُن یہ زن سٲنس خدا یہُوواہؔ سُنٛد توٚہہ حکم چُھ۔
\v 18 اگر توٚہؠ یہ کٔریٚو نہٕ تہٕ تِم ہیٚچھناون توٚہہ یہُوواہسؔ خلاف گناہ کرٕنؠ تہٕ تمہٕ بُرٕ کامہِ کرنہِ یمہ پننٮ۪ن معبودن ہنٛز عبادت کرنہٕ وزِ کران چھِ۔
\p
\v 19 اگر توٚہؠ واریہس کالس قبضہٕ کرنہٕ موٚکھٕ کُنہ شہرس گیرٕ کٔرِتھ روزیٚو تہٕ تتھ دوران ژٔٹؠ زیٚو نہٕ شہرس نیٚبرؠ تبرِ سٟتؠ میٚوٕ دار کُلؠ۔ توٚہہ چُھ کُلیٚو پٮ۪ٹھٕ میٚوٕ کھنُک اجازت، مگر کُلٮ۪ن ددارٕ واتناونُک نہٕ کینٛہہ، تکیازِ تِم چھنہٕ تُہنٛدؠ دشمن۔
\v 20 توٚہہ چُھ اجازت زِ توٚہؠ ژٔٹیٚو ہیرٕ تہٕ میٖنار بناونہٕ باپتھ باقی کُلؠ یُتھ توٚہؠ دیوارو پیٚٹھؠ پٔکِتھ شہرس پٮ۪ٹھ قبضہٕ کٔرتھ ہکیٚو۔"
\c 21
\p
\v 1 موسیٰؔ ہن ووٚن اسرائیل ین مزید، "فرض کرو کانٛہہ آسیٚکھ کُنہ کھہَس منٛز تتھ ملکس انٛدر قتل کوٚرمُت یُس سون خدا یہُوواہؔ توٚہہِ دِوان چُھ تہٕ توٚہہ آسیٚو نہٕ پتاہ زِ یہ شخص کٔمؠ چُھ مورمُت۔
\v 2 اگر یہ سپدِ تہٕ تُہنٛدین زِٹھیٚن تہٕ قاضؠ یٚن پزِ تتھ جایہِ گژھُن یتھ جایہ یہ لاش لبنہٕ آمٕژ ٲس تہٕ تتہِ پٮ۪ٹھ مینن پرٮ۪تھ کُنہِ نزدیکی شہرُک دوٗریر۔
\p
\v 3 پتہٕ چُھ نزدیکی شہرٕ کیٚن بُزرگن أکِس ہوکھرِ ہُنٛد انتخاب کرُن یۅسہ نہٕ زانٛہہ کُنہٕ کامہِ لاگنہٕ آمٕژ آسہ
\v 4 تمہٕ نِن تس تِژھِ کۅلہِ نزدیک تتھ جایہ ییٚتہِ نہٕ زمین وٲیمٕژ یا تتھ کینٛہہ وومُت آسیٚکھ۔ تتِتھ پُھٹراون تس گردن۔
\p
\v 5 کاہنن تہِ پزِ توٚت گژُھن تکیازِ سٲنؠ خدا یہُوواہنؔ چھِ تِم لاوی قبیلہٕ منٛزٕ ژٲرمٕتؠ تاکہِ تِم کرن تس سنٛز خدمت تہٕ روزن تسنٛدؠ نمایندٕ بنِتھ لوٗکن دُعا کرن۔ تہٕ بیٚیہِ ژٲرِنؠ تِم امہِ موٚکھٕ تہِ زِ تِم انٛزراون تمہٕ تنازٕ تہِ یِمن منٛز کانٛہہ زخمی گوٚمُت آسہ۔
\p
\v 6 نزدیک شہرٕ کٮ۪ن بُزرگن پزن تمِس ہوکھرِ پٮ۪ٹھ اتھٕ پٔٹھراوٕنؠ یمسنٛز گردن تتہِ تتھ وادی منٛز پُھٹرٲوِتھ آسہ،
\v 7 تہٕ تِم ونن، "اسہِ کوٚر نہٕ یہ شخص قتل، تہٕ نہ وُچھ کٔمؠ کوٚر۔
\p
\v 8 پتہٕ منٛگن زِٹھؠ دعا، اے یہُوواہؔ، اسہِ کر معاف، پننٮ۪ن اسرائیلی لوٗکن یمہٕ ژےٚ مِصرٕ منٛزٕ بچٲوتھکھ۔ اسہِ مہٕ زان مجرم۔ امہِ بجایہ کر اسہِ معاف"
\v 9 یہ کٔرتھ چُھو توٚہؠ سۅ کام کران یمہِ سٟتؠ یہُوواہؔ توٚہہ ٹھیک زانہِ، تہٕ توٚہہِ ٹھہراوِ نہٕ تمِس شخصہٕ سنٛدِ قتلٕکؠ قصوروار۔
\p
\v 10 موسیٰؔ ہن ووٚن اسرائیل ین، "ییٚلہ توٚہؠ یمہ سِپاہ آسن پننٮ۪ن دشمنن سٟتؠ جنگ کرنہِ گٔژھان چُھو تہٕ سون خدا یہُوواہؔ چُھ توٚہہ تِمن شِکس دِنس قٲبل بناوان تہٕ تِم چھِ تُہنٛدؠ قٲدؠ بنان،
\v 11 توٚہہ منٛزٕ اگر کٲنٛسہِ تِمن منٛز کانٛہہ خوبصورت زٔنؠ نظرِ گژھِ یۅسہ تس پسنٛد ییہِ تہٕ سُہ یژھِ تس سٟتؠ خاندر کرُن۔
\v 12 سُہ أنِن تس پنُن گھرٕ، تہٕ تتہِ کٲسِن سۅ پننِس کلس سورےٕ مس تہٕ اونٛگجن تُلِنؠ نم تاکہِ یہِ سپدِ ظٲہر زِ تٔمس چُھنہٕ ؤنؠ پننِس تتھ قبیلس سٟتؠ کانٛہہ تہِ تعلق بلکہِ بنییہِ وۅنؠ سۅ اسرائیلی۔
\p
\v 13 تس پزن تِم سٲری پلو کٔڈِتھ ژھنٕنؠ یمہٕ تس رٹنہٕ وزِ نٲلؠ ٲسؠ تہٕ لاگہِ وۅنؠ اسرائیلی پۅشاک۔ تس چُھ ضروری تس مردٕ سنٛدِس گھرس منز روزُن تہٕ أکِس ریٚتس مٲلِس ماجہِ نِش ژھنہٕ گژھنُک دۅکھ رٹُن۔ تمہِ پتہٕ چُھ تس تمِس سٟتؠ خانٛدر کرنُک اجازت۔
\v 14 پتہٕ اگر نہٕ سُہ تس سٟتؠ خوش رود تہٕ تس ییہِ اجازت دنہٕ زِ سُہ ہیٚکہِ تس ترٲوِتھ۔ تکیازِ سۅ ٲس شرمنٛدٕ کرنہٕ آمتِس تہٕ تمِس سٟتؠ شونٛگنہٕ خٲطرٕ مجبور، لہٰذا ییہِ نہٕ تس یہ اجازت دنہٕ زِ سُہ کرِ تس سٟتؠ غلام سُنٛد ہیٚوٗ ویوٕہار تہٕ تس کٕنہِ بیٚیہِ کٲنٛسہِ۔
\p
\v 15 فرض کرو زِ کٲنٛسہِ شخصس آسن زٕ خاندارنہِ تہٕ تمو منٛزٕ آسہ سُہ أکِس پسنٛد کران تہٕ بیٚیِس ناپسنٛد۔ مثال مانو زِ دوٚنوٕنی زاے لڑکہٕ تہٕ زیُٹھ ہیٚو لڑکہٕ آسہ تسُنٛد یۅسہ نہٕ تمِس پسنٛد چھےٚ۔
\v 16 یمہِ دوٚہہ سُہ شخص فٲصلہٕ کرِ زِ میانہِ مرنہٕ پتہٕ میانہِ جادادٕ منٛزٕ کُس حصہٕ کٔمِس ترِ، سُہ ہیٚکہِ نہٕ یہ کٔرِتھ زِ تمِس نیٚچوِس دییہ بوٚڈ حصہٕ یُس تس خاندارنہِ ہُنٛد چُھ یۅسہ ٹٲٹھ چھیٚس بلکہِ واتہِ یہ تٔسؠ یُس گۅڈٕ زامُت چُھ۔
\v 17 تمِس پزن پننہِ جادادٕکؠ زٕ حصہٕ زِٹھِس نیٚچوِس دِنؠ، تمِس خاندارنہِ ہنٛدِس نیٚچوِس یس نہٕ سُہ پسنٛد کران چُھ۔ سُہ چُھ تمسُنٛد زیُٹھ نیٚچو تہٕ تمِس پزِ تس ساروےٕ کھۅتہٕ زیادٕ حصہٕ دیُن۔
\p
\v 18 فرض کرو زِ اکھ لڑکہٕ چُھ یُس سٮ۪ٹھاہ شرارتی چُھ تہٕ پننِس مٲلِس ماجہ خلاف ہمیشہٕ بغاوت کران آسہ تہٕ یُس نہٕ تِہنٛدِس وننَس کن تھاوان چُھ۔ تہٕ مثال کرو زِ تِم آسن تس لایان مگر سُہ آسہ نہٕ توتہِ تہندِس وننس کُن توجہ دِوان۔
\v 19 اگر یہ سپدِ تہٕ تمسُنٛد مول موج گژھِ تمِس شہرٕ کِس دروازس پٮ۪ٹھ نیٚون یتہِ تِم روزان چھِ تہٕ پتہٕ شہرٕ کٮ۪ن بُزرگن برونٛٹھ کنہِ کھڑا کرُن۔\f + \fr 21‏:19 \ft امہِ سٟتؠ چُھ مُراد قصبس منٛز کھلہٕ جایہِ، قصبہٕ کس دیوارکِس دروازس نزدیک، یتٮ۪ن قانونی تہٕ تجارتی معاملات طے ٲسؠ آمٕتؠ کرنہٕ۔\f*
\v 20 پتہٕ پزِ تِہنٛدِس مٲلس ماجہ تمہِ شہرٕ کٮ۪ن بزرگن ونُن، "سون یہ لڑکہٕ چُھ شرارتی تہٕ یہ چُھ ہمیشہٕ اسہِ خلاف بغاوت کران۔ سُہ چُھنہٕ سٲنؠ کتھےٕ مانان۔ سُہ چُھ واریاہ کھیٚوان تہٕ شراب تہِ چیٚوان۔"
\v 21 پتہٕ پزِ تمہ شہرٕکٮ۪ن بزرگن سُہ سنگسار کٔرِتھ قتل کرُن۔ یہ کرنہٕ سٟتؠ لٔبیٚو توٚہؠ امہِ بُرٕ عملہِ سٟتؠ پننِس سماجس منٛز نجات۔ تہٕ اسرائیلس منٛز بوزن اتھ متعلق سٲری لوٗکھ یہ تٔمؠ کوٚرمُت آسہ تہٕ تہِ کرنس کھۅژُن تِم۔
\p
\v 22 اگر کٲنٛسہِ کُنہِ تِتھِ جُرمہٕ کِنؠ پھٲسؠ ییہِ دِنہٕ یمہِ کِنؠ سُہ مرنُک مستحق آسہ تہٕ توٚہؠ تھٲیو تمؠ سنٛز لاش کُنہِ تھمبس الانٛژ،
\v 23 تہٕ توٚہہ چھنہٕ سۅ لاش\f + \fr 21‏:23 \ft أکِس تھمبس پٮ۪ٹھ الانٛژ لاش چھِ زٔمیٖنَس پٮ۪ٹھ خدا سنٛز لعنت انان۔\f* تتِتھ پوٗرٕ راتس تھاونُک اجازت دیُن۔ یمہ دوٚہہ سُہ مرِ تمی دوٚہہ گژھِ تمؠ سنٛز لاش دفناونہٕ یِنؠ تکیازِ اگر توٚہہ سۅ لاش کُنہ تھمبس پٮ۪ٹھ تھٲوون تہٕ خدا کرِ تتھ زمینس لعنت۔ توٚہہ پزِ تمی دوٚہہ سۅ لاش دفناوٕنؠ تاکہِ توٚہؠ کٔرؠ وون نہٕ سۅ زمین ناپاک یۅسہ سون خدا یہُوواہؔ توٚہہ تتھ ملکس منٛز دِوان چُھ۔\f + \fr 21‏:23 \ft اسرائیلی خدایہ سنٛز عبادتس لائق مہٕ بٔنِو\f*\f + \fr 21‏:23 \ft متی 27:57 پٮ۪ٹھٕ 58، اعمال 5:30\f*
\c 22
\p
\v 1 موسیٰؔ ہن ووٚن اسرائیل ین مزید، "اگر توٚہؠ کٲنٛسہِ اسرائیلی سٲتھی سُنٛد دانٛد یا تیوٗر وُچھوون یُس رووٕمُت آسہ تہٕ تہِ کٔرؠ زیٚو نہٕ زنتہٕ توٚہہِ وُچھوےٕ نہٕ۔ سُہ نی زیون پننِس مٲلکس نِش واپس۔
\v 2 وۅنؠ اگر تمسُنٛد مٲلکھ توٚہہِ نزدیک آسہ نہٕ باسان یا توٚہؠ ٲسیٚو نہٕ زانان زِ سُہ کُس چُھ تیٚلہِ نی زیون سُہ جانور پنُن گھرٕ۔ سُہ ہیٚکہ تۅتام توٚہہِ نِش روزِتھ یۅتام نہٕ تسُنٛد مٲلکھ تس ژھانٛڈنہِ واتہِ۔ پتہٕ پزِ توٚہہ تس سُہ جانور دیُن۔
\v 3 توٚہہ پزِ تمہِ وزِ تہِ تی کرُن اگر توٚہؠ کانٛہہ خر، کپر ٹُکرٕ یا بیٚیہِ کانٛہہ چیز وُچِھو یُس کٲنٛسہِ رووٕمُت آسہ۔ یہ توٚہہ کرُن پزِ تتھ گژھِ نہٕ نکار کرُن۔ کُنہِ ماملس منٛز گژھِ نہٕ نہ زاننُک بہانہٕ کرُن۔
\p
\v 4 تہٕ اگر توٚہؠ کٲنٛسہِ اسرائیلی سُنٛد خر یا گاو سڑکہِ پٮ۪ٹھ پٮ۪مٕژ وُچھوون تہٕ تہِ کٔرؠ زیٚو نہٕ زنتہٕ توٚہہ وُچھوےٕ نہٕ۔ سُہ ضانور تھوٚد تُلنس منٛز کٔرؠ زیٚو مٲلکس مدد تاکہِ سُہ گژھِ بیٚیہِ پننٮ۪ن زنٛگن پٮ۪ٹھ کھڑا۔
\p
\v 5 زنٮ۪ن پزِنہٕ مردن ہُنٛد لباس لاگُن تہٕ مردن پزِنہٕ زنٮ۪ن ہُنٛد لِباس لاگُن۔ سون خدا یہُوواہؔ چُھ یِژھ کٲم کرن والٮ۪ن نفرت کران۔
\p
\v 6 اگر توٚہؠ کُنہ کُلِس یا بیٚیہِ کُنہِ جایہ کٲنٛسہِ جاناوار سُنٛد اول وُچِھو تہٕ مادٕ جاناوار ٹھوٗلن پٮ۪ٹھ یا بچن سٟتؠ بِہتھ وُچھوون تہٕ سُہ مہٕ رٔٹوون نہ مٲرؠ زیٚون۔
\v 7 توٚہہ چُھ جاناوارن ہنٛدؠ بچہٕ نِنُک اجازت، مگر توٚہہ چُھ تِہنٛزِ ماجہِ ژلنُک اجازت دیُن۔ یہ کٔرزیٚو اوموٚکھٕ تکیازِ یِم چیز روزن تُہنٛدِ باپتھ بہتر تہٕ توٚہؠ روزیٚو واریہس وقتس زنٛدٕ۔
\p
\v 8 اگر توٚہؠ نوو گھرٕ بناوان چُھو تہٕ توٚہہ پزِ پشس پٮ۪ٹھٕ انٛدؠ انٛدؠ جنگلہٕ گنٛڈن۔ یتھٕ پٲٹھؠ بٔنیٚو نہٕ توٚہؠ ذمہٕ دار اگر کانٛہہ شخص تمہ پٮ۪ٹھٕ ؤسؠ پٮ۪تھ مرِ۔
\p
\v 9 تتھ علاقس منٛز مہٕ لٲگیٚو کانٛہہ تہِ فصٕل یتہِ دچھِ کُلؠ لٲگِتھ آسن اگر توٚہؠ تہِ کٔریٚو تہٕ کاہن نِن یہُوواہؔ سنٛدِس مقدِسس منٛز سُہ سورےٕ فصٕل تہٕ دچھ دوٚنوے پننِس قبضس منٛز۔\f + \fr 22‏:9 \ft توٚہہِ پزِ عبادت گہَس پٮ۪ٹھ تہِ سورےٕ انُن یہِ توٚہہِ دچھہِ باغہٕ منٛزٕ حٲصِل سپدِ۔ \f*
\p
\v 10 پنُن زمین واینہٕ وزِ مہٕ کٔریٚو خرس تہٕ دانٛدس یکہٕ وٹہٕ پٲیل۔
\p
\v 11 تِم پلو مہٕ لٲگیٚو یمہٕ ییر تہٕ ریشم یکوٹہٕ رلاٲوِتھ بناونہٕ آسن آمٕتؠ۔
\p
\v 12 پانہٕ وٲنؠ رلاوِتھ بنٲیو جٲلؠ تہٕ سۅ لٲگیٚو پننہِ چۅگہٕ کٮ۪ن ژوٚن کوٗنن۔
\p
\v 13 مثال مانو زِ اکھ نفر چُھ اکِس جوان زنہِ سٟتؠ خاندر کٔرتھ تمِس نِش شونٛگان تہٕ پتہٕ چُھ فٲصلہٕ کران زِ بہٕ بساون نہٕ وۅنؠ یہِ،
\v 14 فرض کرو سُہ دییہِ تمِس غلط الزام تہٕ کرِ دعوا زِ یہ ٲس نہٕ انۂرِش ییٚلہِ مےٚ أمِس سٟتؠ خاندر کوٚر۔
\p
\v 15 اگر یہِ سپدِ تہٕ نوجوان کورِ ہنٛدِس مٲلِس ماجہ پزِ سۅ کپر ژادر انٕنؠ یۅسہ تٔمؠ شخصن تہٕ تِہنٛزِ کورِ تمہِ ساعتہٕ بسترس ترٲوِتھ اوس یمہِ وزِ تِمن کُٹھ دِتُکھ یتھ پٮ۪ٹھ وُنہ خوٗنہٕ داغ آسن تہٕ ہاون شہرٕ کِس دروازس پٮ۪ٹھ شہرٕ کٮ۪ن بُزرگن۔
\p
\v 16 پتہٕ پزِ نوجوان کورِ ہنٛدِس مٲلِس بُزرگن ونُن، "مےٚ دِژ یہ پنٕنؠ یہ کور یمِس شخصس پنٕنؠ خاندارِنؠ بناونہٕ باپتھ نیتھٕرؠ۔ مگر وۅنؠ چُھ سُہ ونان مےٚ چھنہٕ یہ ضرورت۔
\p
\v 17 بلکہِ چُھس غلط الزام دِوان زِ یمہ، وزِ مےٚ أمِس سٟتؠ خاندر کوٚر یہ ٲس نہٕ انہرِش۔ مگر وُچھو! یہ چُھ ثٲبت کران زِ میٲنؠ کور ٲس انۂرِش! وُچِھو یتھ کپر ژادرِ خوٗنہٕ داغ یۅسہ یمن تمہِ رٲژ تل ٲس! تہٕ ہاوِ سۅ شیٹ تِمن بُزرگن۔
\p
\v 18 پتہٕ نِن تِم بُزرگ تمِس شخصس تہٕ دِنس کوڈٕ۔
\v 19 تِم کرن تس مطالبہ زِ دییہِ چاندِ ہنٛدؠ ہتھ ٹکہٕ جرمانہٕ رنٛگؠ تہٕ تِم دِن نوجوان کورِ ہنٛدِس مٲلس۔ تکیازِ تٔمؠ کٔر اسرائیلٕچ اکھ نوجوان کور خجٕل۔ امہِ علاوٕ، روزِ سۅ زٔنؠ تسؠ سٟتؠ۔ سۅ چھےٚ تس سنٛز خاندارِنؠ۔ تمِس چُھنہٕ تس آینٛدٕ طلاق دِنُک اجازت۔\f + \fr 22‏:19 \ft أکِس گٲمی مُزورٕ سنٛزِ ہتن دوٚہُن ہنٛدِس اُجرتس برابر۔ \f*
\p
\v 20 وۅنؠ اگر أمِس شخصہٕ سنٛز کتھ پٔز ٲس تہٕ تمِس اوس نہٕ اتھ کتھِ کانٛہہ ثبوت زِ سۅ ٲس تمہِ وزِ انۂرِش یمہِ وزِ تس خاندر کوٚرُکھ،
\v 21 سُہ نیٚیہ تمِس نوجوان کورِ تہٕ تراویس مٲلؠ سنٛدِس دروازس پٮ۪ٹھ۔ پتہٕ پزِ تمہِ شہرٕ کٮ۪ن لوٗکن سۅ سنگسار کٔرِتھ قتل کرٕنؠ۔ تِمن پزِ ضرور یہ کرُن تکیازِ تٔمؠ کٔر اسرائیلس منٛز سۅ اکھ کام یۅسہ انتہائی شرمناک چھےٚ، ییٚلہ سۅ پننِس مٲلؠ سنٛدِس گھرس منٛز روزان ٲس سۅ ٲس کس تام نفرس نِش شونٛگان۔ تمِس یتھٕ کِنؠ مارنہٕ سٟتؠ ہکیٚو توٚہؠ یہ بُرایی پننِس سماجس منٛز ختم کٔرِتھ۔\f + \fr 22‏:21 \ft 1 کورنتھ 5:13\f*
\p
\v 22 اگر کانٛہہ شخص کٲنٛسہِ دویمِس نفرٕ سنٛزِ خاندارنہِ نِش شونٛگِتھ رٹنہٕ آو تہٕ دوٚنوے گژھن قتل کرنہٕ یِنؠ۔ یہ کرنہٕ سٟتؠ ہکیٚو توٚہؠ اسرائیلس منٛز امہِ بُرٕ عملہِ نِشہ نجاتھ پرٲوِتھ۔\f + \fr 22‏:22 \ft یوحنا 8:5\f*
\v 23 مثال کرو زِ کُنہِ شہرس منٛز وُچھ کٲنٛسہِ نفرن کانٛہہ نوجوان کور یس کٲنٛسہِ نفرس سٟتؠ گنٛڈِتھ اوس تہٕ سُہ نفر وچُھکھ تس نِش شونٛگِتھ۔
\v 24 توٚہہ پزن تِم دوٚنوے شہرٕ کِس تتھ دروازس پٮ۪ٹھ نِنؠ یتِتھ شہرٕکؠ قٲید اہم معاملاتن ہُنٛد فٲصلہٕ کران چھِ۔ تتہِ پزن توٚہہ تِم دوٚنوے سنگسار کٔرِتھ قتل کرٕنؠ۔ توٚہہ پزِ سۅ نوجوان زنؠ اوٕ موٚکھٕ قتل کرٕنؠ تکیازِ شہرس منٛز ٲسِتھ تہِ تُل نہٕ تمہِ مدتہٕ خٲطرٕ شور۔ تہٕ یہ مرد چُھ اوٕ موٚکھٕ قتل کرُن تکیازِ سُہ شونٛگ تس زنہِ نِش یس سٟتؠ تمِس کھانٛدر کرنُک وعدہ کرنہٕ اوس آمُت۔ یہ کرنہٕ سٟتؠ کٔریٚو توٚہؠ پننِس سماجس منٛز امہِ بُرایی ہُنٛد خٲتمہٕ۔
\p
\v 25 مگر فرض کرو زِ کُنہ گامہٕ کِس ننِرس منٛز سمکھِ اکھ نفر اکِس نوجوان کورِ یمِس کھاندرٕچ کتھ آسہ رٹنہٕ آمٕژ تہٕ سُہ کرِ تس پانس نِش شونٛگنہٕ باپتھ مجبور۔ اگر یہ سپُد تہٕ تیٚلہ گژھِ صرف سُہ نفر قتل یُن کرنہٕ۔
\v 26 تہٕ جوان زنہٕ گژھِ نہٕ سزا یُن دِنہٕ تکیازِ تمہِ کٔر نہٕ کانٛہہ تِژھ کٲم یمہ باپتھ تس موتُک سزا رٹنٕچ مستحق بنہِ۔ یہ معاملہٕ چُھ یتھٕ پٲٹھؠ زِ ییٚلہ کانٛہہ نفر گامس منٛز کٲنٛسہِ دویمِس نفرس پٮ۪ٹھ حملہٕ کرِتھ تس قتل کران چُھ،
\v 27 چونٛکہ یمؠ نفرن سۅ پانس سٟتؠ شونٛگنہٕ باپتھ مجبور کٔر تمؠ وُچھ سۅ تمہِ وزِ ییٚلہ سۅ گامس منٛز ننِرس کُن ٲس تہٕ اگر تمہِ مدتہٕ باپتھ شور تُل۔ تتہِ اوس نہٕ کہنٛؠ یُس تس بچاوِہے۔
\v 28 اگر کانٛہہ مرد کٲنٛسہِ نوجوان زنہِ یمِس نہٕ وُنہِ گنٛڈنہٕ آسہ آمُت پانس نِش شونٛگنہٕ باپتھ مجبور کرِ تہٕ کانٛہہ تِمس تہِ کران وُچھِ،
\v 29 تمِس نفرس پزن چانٛدٕ ہنٛدؠ پنٛژاہ سِکہٕ تمسنٛدِس مٲلِس کُن ادا کرٕنؠ، تہٕ پتہٕ چُھس تمِس سٟتؠ کھانٛدر کرُن۔ تکیازِ تٔمؠ کٔر سۅ پانس سٟتؠ شونٛگنہٕ باپتھ مجبور کٔرِتھ رسوا۔ تمِس چُھنہٕ پتہٕ زندگی منٛز کُنہ تہِ وزِ تمِس طلاق دِنُک اجازت۔\f + \fr 22‏:29 \ft چانٛدِ ہنٛدؠ پنژاہ ٹُکرٕ ٲسؠ أکِس گٲمی مُزورٕ سنٛزِ پنٛژہن دوٚہُن ہنٛزِ اُجرتس برابر۔\f*
\v 30 کٲنٛسہِ نفرس پزِ نہٕ پننِس مٲلؠ سنٛزِ کٲنٛسہِ کھاندارنہِ نِش شونٛگِتھ پننِس مٲلؠ سنٛدِس امانتس خیانت کرٕنؠ۔\f + \fr 22‏:30 \ft تمؠ سنٛز وۅرٕ موج، غٲلباً امسنٛدِ مٲلؠ سنٛزو واریہو خاندارِنیٚو منٛز اکھ۔\f* \f + \fr 22‏:30 \ft 1 کورنتھ 5:1\f*
\c 23
\p
\v 1 موسیٰؔ ہن ووٚن ہٮ۪تھےٕ اسرائیل ین، "کانٛہہ تہِ فرد یس مردان گی ہنٛدؠ اعضا ختم آسن گمٕتؠ ہیٚکہِ نہٕ یہُوواہؔ سنٛدین نفرن منٛز شٲمل سپدِتھ۔\f + \fr 23‏:1 \ft پیدٲیش 19:30 پٮ۪ٹھٕ 38 \f*
\p
\v 2 کانٛہہ تہِ ناجایز فرد یا ناجایز فردٕ سُنٛد اولاد، یُس دہِم پُوؠ تہِ آسہ، گژھِ نہٕ یہُوواہؔ سنٛدین نفرن منٛز شٲمل سپدُن۔
\p
\v 3 عمونؔ تہٕ موآبؔ قبیلہٕ منٛزٕ ییہِ نہٕ کانٛہہ تہِ دہَن پُین تام یہُوواہؔ سنٛدین لوٗکن منٛز شٲمل کرنہٕ۔\f + \fr 23‏:3 \ft دٔہمہِ نسلہِ تام تہِ چُھ شاید یِنہٕ والہِ تمام وقتُک مطلب۔\f*
\v 4 امیُک اکھ وجہ چُھ یہ زِ تِہنٛدیٚو زِٹھیٚو کوٚر تُہنٛدین جدٕاجدادن مِصرٕ پٮ۪ٹھٕ کنعان گژھنہٕ وزِ کھیٚن چیٚن دنہٕ نشہٕ انکار۔ بیاکھ وجہ چُھ یہ زِ تِمو اوٚن مسوپتامیہؔ کہ شہر فتور\f + \fr 23‏:4 \ft مسوپتامیہؔ کِس علاقس منٛز چُھ فتوؔر شہر۔\f* پٮ۪ٹھٕ بعورؔ سُنٛد نیٚچو بلعام ناد دِتھ تاکہِ سُہ کرِ توٚہہ اسرائیل ین پٮ۪ٹھ لعنت۔\f + \fr 23‏:4 \ft نحمیاؔہ 13:1 تہٕ 2، گریند 22:4، 24:25\f*
\p
\v 5 مگر سٲنؠ خدا یہُوواہنؔ دیُت نہٕ بلعامسؔ کُن توجہ بلکہِ بنووُن بلعام سُنٛد منٛگن تُہنٛدین جدٕاجدادن باپتھ برکٔژ ہُنٛد بٲعث، تکیازِ یہُوواہؔ اوس تِمن سٟتؠ محبت کران۔\f + \fr 23‏:5 \ft گریند 23:7 تہٕ 24:9\f*
\v 6 یۅتام اسرائیل اکھ قوم چُھ، توٚہہ چُھنہٕ تۅتام کِہین کرُن یۅتام نہٕ تِمن دوٚن جمٲژن ہنٛدِ باپتھ حالت ٹھیک سپدن یُتھ تِم ترقی کرن۔
\p
\v 7 مگر ادومؔ قبیلہٕ منٛزٕ زٲنؠ زیون نہٕ کانٛہہ تہِ حقیر تکیازِ تِم چھِ تُہنٛدِس جَد اضحاقؔ سنٛدیو اولادو منٛزٕ یتھٕ کِنؠ توٚہؠ چُھو۔ تہٕ مِصرٕکؠ لوٗکھ تہِ زٲنؠ زیوکھ نہٕ حقیر تکیازِ ییٚلہ تِم گۅڈٕ مِصرس منٛز روزان ٲسؠ تِم ٲسؠ تُہنٛدین جدٕاجدادن سٟتؠ رُت سلوٗک کران۔\f + \fr 23‏:7 \ft ادومؠؔ ٲسؠ عیسو پٮ۪ٹھٕ آمٕتؠ، یتھ ادوم تہِ ونان چھِ۔\f*
\v 8 اودومؔ تہٕ مِصرٕ کیٚن لوٗکن ہنٛدؠ زُرؠ یِم وۅنؠ توٚہہِ سٟتؠ روزان چھِ ہیٚکن یہُوواہؔ سنٛدین لوٗکن منٛز شٲمل سپدِتھ۔
\p
\v 9 ییٚلہ تُہنٛدؠ سِپاہ جنٛگس دوران خٕمس منٛز روزان آسن تہٕ تِمن پزِ تِمو کامیٚو نشہٕ پتھ روزُن یمہٕ تِمن خدایس نشہٕ ناقٲبلِ قبول بناون۔
\v 10 اگر کانٛہہ نفر خدایس برُونٛہہ کنہِ نا قٲبلِ قبول سپُد یمہِ کِنؠ زِ راتھ کیُت سپُد سُہ احتلامہٕ کِنؠ ناپاک تہٕ تمِس پزِ صُبحٲے خٟمہ گاہ منٛزٕ نیٚبر نیرُن تہٕ تمہ دوٚہہ تٔتی بِہُن۔\f + \fr 23‏:10 \ft احبار 15:16 پٮ۪ٹھٕ 17\f*
\v 11 مگر تمہِ دوٚہہ شامس کرِ سُہ سران تہٕ آفتاب لوسنہٕ وزِ گژھِ تس خٟمہٕ گاہس منٛز واپس اژنہٕ دیُن۔
\p
\v 12 تُہنٛدین سِپہن گژھِ کیمپس نیٚبرٕ کنہِ بیت الخُلا آسُن یُس تمہٕ ضرورتہٕ وزِ استعمال کرن۔
\v 13 ییٚلہ توٚہؠ پننٮ۪ن دشمنن سٟتؠ جنٛگس نیریٚو تہٕ پننٮ۪ن ہتھیارن سٟتؠ تُلزیٚو اکھ لور تہِ سٟتؠ یُتھ زن نیٚبر نیرنہٕ وزِ توٚہؠ اکھ دۅب کٔھنِتھ ہکیٚو تہٕ پتہٕ سُہ حاجتِ بشری مۅکلٲوِتھ بیٚیہِ پُروان ٲسیٚو۔
\v 14 توٚہؠ گٔژھیٚو خٟمہٕ گاہ سٲنِس خدا یہُوواہسؔ قٲبلِ قبوٗل بناوٕنؠ تکیازِ سُہ چُھ تُہنٛز حفاظت کرنہٕ باپتھ توٚہہِ سٟتؠ تہٕ توٚہہ دشمنن شِکس دِنس قٲبل بناوان۔ کانٛہہ ذلالت واجِنؠ کٲم مہٕ کٔریٚو یمہِ کنؠ یہُوواہؔ توٚہہ پنٕنؠ لوٗکھ بناونہٕ نشہٕ پتھ رٹہِ۔
\p
\v 15 اگر تِم غلام پننٮ۪ن آغن نِش ژٔلِتھ ین تہٕ توٚہہ کرن عرضی زِ اسہِ بچٲیو تہٕ تِم سوزؠ زیوکھ نہٕ پننٮ۪ن آغن نِش واپس۔
\v 16 تِمن دیزیٚو پانس سٟتؠ روزنہٕ، یتھ شہرس منٛز تِم یژھن، تِمن سٟتؠ کٔرؠ زیٚو نہٕ بدسلوٗکی۔
\p
\v 17 کٲنٛسہِ تہِ اسرائیلی مردس یا زنہِ دیزیٚو نہٕ مندرس منٛز گٲنؠ بننہٕ۔\f + \fr 23‏:17 \ft ہوش 4:14، عاموس 2:7\f*
\v 18 بیٚیہِ دیزیٚو نہٕ تِمن لوٗکن ہُنٛد کانٛہہ تہِ پونٛسہٕ یمہٕ فحش کامٮ۪ن پٮ۪ٹھ کماون آسن سٲنِس خدا یہُوواہؔ سنٛدِس گھرس منٛز اننُک اجازت یوٚدوے تِمو یہ رقم دِنُک مکمل وعدہ کوٚرمُت آسہ۔ یہُوواہسؔ چھےٚ طوائفن سٟتؠ نفرت۔
\p
\v 19 ییٚلہِ توٚہؠ کانٛسہ اسرائیلی سٲتھیس پونٛسہٕ کھیٚن یا بیٚیہِ کانٛہہ چیز وۅزُم دِیو تہٕ تمِس مہٕ ہیٚیِو سوٗد۔
\v 20 ییٚلہِ توٚہؠ پننِس ملکس منٛز روزن والٮ۪ن غٲر ملکی ین قرض دِوان ٲسِو تیٚلہِ چُھ توٚہہ سوٗد ہیٚنُک اجازت مگر تمہِ ساعتہٕ نہٕ ییٚلہِ توٚہؠ اسرائیل کیٚن قرض دِیو۔ یہ کٔرؠ زیٚو یُتھ زن سون خدا یہُوواہؔ توٚہہ پرٮ۪تھ تتھ کامہِ منٛز برکت کریٚو یۅسہ توٚہؠ تتھ ملکس منٛز کران ٲسیٚو یتھ منٛز أژتھ توٚہؠ قبضہٕ کرن وٲلؠ چُھو۔
\p
\v 21 ییٚلہ توٚہؠ پننِس خدا یہُوواہسؔ کینٛہہ دِنُک یا تمِس باپتھ کینٛہہ کرنُک عہد کٔریٚو تہٕ پوٗرٕ کرنس منٛز مہٕ کٔریٚو دیٖری۔ یہُوواہسؔ چھِ توٚہہ سٟتؠ توقع زِ توٚہؠ یُس وعدہ کٔریٚو سُہ نبٲیو تہِ، اگر توٚہؠ تہِ کٔریٚو نہٕ تہٕ توٚہؠ سپدیٚو گُنہن ہنٛدؠ سزاوار۔\f + \fr 23‏:21 \ft متی 5:33\f*
\v 22 وۅنؠ اگر توٚہؠ کُنہِ کامہِ ہُنٛد پۅختہٕ وعدہ کٔریٚو نہٕ تیٚلہِ چُھنہٕ یہ گناہ۔
\v 23 اگر توٚہؠ پننہِ مرضی کینٛہہ کرنُک وعدہ کران چُھو تہٕ سُہ پزِ توٚہہ نباوُن۔
\p
\v 24 ییٚلہِ توٚہؠ کٲنٛسہِ ہنٛدِ دچھِ باغہٕ منٛزؠ پکان ٲسیٚو تہٕ توٚہہِ چُھ ییژاہ یژھِو تہٕ تیژ دچھ وٲلِتھ کھیٚنُک اجازت مگر توٚہہ چُھنہٕ سۅ کُنہِ بانس بٔرِتھ نِنُک اجازت۔
\v 25 ییٚلہ توٚہؠ فصلہٕ دار کھہہ منٛزؠ وتہِ پکان ٲسیٚو تہٕ توٚہہِ چُھ اجازت زِ توٚہؠ ہکیٚو کینٛہہ پھسٕل ژٔٹِتھ کھیٚتھ مگر توٚہہِ پزِنہٕ دراتہِ سٟتؠ کانٛہہ دانہٕ پانس سٟتؠ لُنِتھ نیٚون۔\f + \fr 23‏:25 \ft متی 12:1\f*
\c 24
\p
\v 1 موسیٰؔ ہن ووٚن اسرائیل ین مزید، "مثال مانو زِ أکؠ نفرن کوٚر أکِس زنہِ سٟتؠ خاندر تہٕ پتہٕ کوٚرن فٲصلہٕ زِ بہٕ تراون سۅ تکیازِ تس چُھ کہتام ناگوار سپدان، تہٕ سُہ چُھ تس پننہِ گھرٕ منٛزٕ کٔڈِتھ ژٕھنان۔ مثال مانو زِ سُہ چُھ اکھ کاغذ لیٚکھان یتھ منٛز سُہ ونان چُھ زِ بہٕ چُھس أمِس طلاق دِوان، تہٕ سُہ کاغذ دِتھ چُھ تس پننہِ گھرٕ منٛزٕ روانہٕ کران۔\f + \fr 24‏:1 \ft متی 5:31\f*
\v 2 پتہٕ مانو زِ سۅ درایہ تتہِ۔ تمِس چُھ دویم خاندر کرنُک اجازت۔
\p
\v 3 مثال مانو زِ سُہ نفر تہِ چُھ پتہٕ یہ فٲصلہٕ نِوان زِ بہٕ چُھسن نہٕ یہ پسنٛد کران تہٕ پتہٕ چُھ سُتہ اکھ کاغذ لیٚکھان یتھ منٛز سُہ ونان چُھ زِ سُہ چُھ أمِس طلاق دِوان تہٕ چُھس پننہِ گھرٕ منٛزٕ کڈان۔ یا مثال مانو زِ دویِم خاندار چُھ مران
\v 4 اگر یِمو منٛزٕ کینٛہہ تہِ سپدِ تہٕ تمسُنٛد گۅڈنیُک خاندار کرِنہٕ دوبارٕ تمِس سٟتؠ بیٚیہِ خاندر۔ سُہ گژھِ زانُن زِ سۅ سپٕز یہُوواہسؔ نزدیک ناقٲبلِ قبوٗل۔ یہُوواہسؔ سپدِ یہ ناگوار اگر سُہ دوبارٕ تس سٟتؠ خاندر کرِ۔ توٚہہ پزن نہٕ تتھ ملکس منٛز یُس سون خدا یہُوواہؔ توٚہہ دِوان چُھ یہ کٔرِتھ گناہ کرٕنؠ۔
\p
\v 5 ییٚلہ کٲنٛسہِ نفرس تازے خاندر آسہ سپُدمُت تہٕ تمِس چھنہٕ فوجس منٛز سِپاہ بننٕچ یا حکومتس منٛز کانٛہہ کٲم کرنٕچ ضرورت۔ تمِس پزِ خاندر کٔرِتھ أکِس ورؠ یس یژھو کامیٚو نِشہ مُچھِ روزُن۔ سُہ روزِ پننِس گھرس منٛز تہٕ تھاوِ پننہِ خاندارنہِ تتھ ورؠ یس دوران خوش۔
\p
\v 6 اگر کانٛہہ کٲنٛسہِ قرض دِوان چُھ تہٕ تمِس چُھ اجازت زِ منٛگہِ تمِس نفرس ضمانت رنٛگؠ کینٛہہ یُتھ سُہ تس سُہ رقم واپس دییہِ یُس سُہ وۅزُم نِوان چُھ۔ مگر تمِس چھنہٕ تس سۅ گرٮ۪ٹہٕ کٔنؠ نِنؠ یۅسہ تمسنٛدس گھرس منٛز ژۅچہ باپتھ اوٹ پیسنہٕ خٲطرٕ چھےٚ یمہِ سٟتؠ تِم زنٛدٕ روزن۔
\p
\v 7 اگر کانٛہہ پننِس اسرائیلی سٲتھیَس پنُن غلام بناونہٕ باپتھ یا کٲنٛسہِ دویمِس بحثیتِ غلام کٔننہٕ باپتھ اغوا کرِ تہٕ توٚہہ پزِ سُہ شخص قتل کرُن یُس تہِ کرِ۔ امہِ سٟتؠ کٔریٚو توٚہؠ پننِس سماجس منٛز یہ بُرایی دوٗر۔\f + \fr 24‏:7 \ft 1 کورنتھ 5:13\f*
\p
\v 8 اگر توٚہؠ مینٛدؠ بٮ۪مارِ منٛز مُبتلا ٲسِو تہٕ یہ کتھ بنٲے زیٚو یقینی زِ یۅسہ کٲم توٚہہِ لاوی قبیلٕکؠ کاہن ونن سۅ کٔرؠ زیٚو تہٕ تِمن احکامن پٮ۪ٹھ کٔرؠ زیٚو احتیاطہٕ سان عمل یِم مےٚ تِمن دِتؠ مٕتؠ چھِ۔\f + \fr 24‏:8 \ft احبار 13:47 پٮ۪ٹھٕ59\f*
\v 9 یہ مٔشراے زیٚو نہٕ زِ سٲنؠ خدا یہُوواہنؔ کیاہ کوٚر تمہِ وزِ مریمسؔ سٟتؠ ییٚلہ تس میونٛد لاریو تہٕ تُہنٛدؠ جدٕاجداد ٲسؠ مِصرٕ منٛزٕ نیران۔\f + \fr 24‏:9 \ft گریند 12:10پٮ۪ٹھٕ15\f*
\p
\v 10 ییٚلہِ توٚہؠ سٲتھی اسرائیل ین کینٛہہ وۅزُم دِیو تہٕ تمسُنٛد گھرٕ أژؠ زیٚو نہٕ سُہ چۅگہٕ نِنہِ یتھ تٔمؠ ونمُت آسہ تۅتام گِرو تھاوٕنؠ یۅتام سُہ قرض نکھٕ والہٕ۔
\v 11 تمسنٛدس گھرس نیٚبرٕ کنہِ روزؠ زیٚو وۅدٕنؠ تہٕ یس نفرس توٚہہِ قرض دیُتمُت آسہ سُے انہِ توٚہہِ نِش چۅگہٕ۔
\p
\v 12 وۅنؠ اگر سُہ غریب آسہ تیٚلہِ رٔٹؠ زیٚو نہٕ راتس سۅ ژادر پانس نِش۔\f + \fr 24‏:12 \ft کوٹ مَہ تھٲوِو راتس پانس سٟتؠ\f*
\v 13 ییٚلہ دوٚہہ لوسہِ تہٕ سۅ ژادر نیزیٚو تس واپس یُتھ سُہ راتس تتھ وُورٕنؠ تراوِ۔ اگر توٚہؠ تہِ کٔریٚو تہٕ سُہ منٛگہِ خدایس دُعا تُہنٛدِ برکٔژ باپتھ تہٕ سون خدا یہُوواہؔ سپدِ توٚہہ رٲضؠ۔
\p
\v 14 تِمن نوکرن سٟتؠ کٔرؠ زیٚو نہٕ بد سلوٗکی یمہِ توٚہؠ مُزورِ پٮ۪ٹھ رٔٹؠ ووکھ یِم غریب تہٕ محتاج آسن چاہے تِم اسرائیلی سٲتھی ٲسؠ تن یا تُہنٛدِس شہرس منٛز روزن وٲلؠ غٲر ملکی۔
\v 15 توٚہہ پزِ پرٮ۪تھ دوٚہہ آفتاب لوسنہٕ برُونٛہہ تِمن پنٕنؠ مُزورؠ ادا کرٕنؠ۔ تِم چھِ غریب تہٕ تِمن چھےٚ پنٕنؠ مُزورؠ نِنٕچ ضرورت۔ اگر توٚہؠ تِمن جلدےٕ سۅ ادا کٔریٚو نہٕ تہٕ تِم کرن توٚہہ خلاف یہُوواہسؔ فریاد تہٕ سُہ دییہِ توٚہہ یمن گُنہن ہُنٛد سزا۔\f + \fr 24‏:15 \ft متی 20:8\f*
\p
\v 16 مٲلِس ماجہِ پزِ نہٕ تِہنٛدین بچن ہنٛدین جُرمن پٮ۪ٹھ قتل کرنہٕ یِنہٕ تہٕ بچن گژھِ نہٕ تِہنٛدین والدینن ہنٛدِس خطہَس پٮ۪ٹھ پھٲسؠ دنہٕ یِنؠ۔ لوٗکن گژھِ صرف تِمن خطہَن پٮ۪ٹھ پھٲسؠ دنہٕ یِنؠ یمہٕ یمہٕ تِمن پانس سرِزد گمٕتؠ آسن۔
\p
\v 17 توٚہؠ کٔرؠ زیٚو غٲر ملکی ین یمہ توٚہہِ سٟتؠ روزان آسن تہٕ یتیمن باپتھ تمہٕ کامہِ یمہ شریعت ونان آسہ زِ تِمن باپتھ گژھن کرنہِ ینہِ۔ اگر توٚہؠ کانٛسہ مونٛڈِ کینٛہہ وۅزُم دِیو تہٕ تمِس رٔٹؠ زیٚو نہٕ پلو گِرو یُتھ سۅ قرض واپس انہِ۔
\v 18 یہ مٔشرٲے زیٚو نہٕ زِ ییٚلہ توٚہؠ مِصرس منٛز غلام ٲسِو تہٕ توٚہہ پٮ۪ٹھ ٲسؠ بٔڈؠ مصیبت تہٕ سٲنؠ خدا یہُوواہنؔ بچٲوؠ نو تتہِ۔ اوٕ کِنؠ چُھسو بہٕ حکم دِوان زِ تِمن کٔریٚو مدد یمہٕ مصیبتس منٛز آسن۔
\p
\v 19 ییٚلہِ توٚہؠ پنُن فصٕل لُنیٚو، اگر توٚہہ یاد رود نہٕ زِ اسہِ گییہِ کھہَس منٛز اکھ گیٚڈ مٔشتھےٕ تہٕ سۅ اننہٕ باپتھ گٔژھؠ زیٚو نہٕ واپس۔ سۅ ترٲوؠ زیٚو پردیسؠ ین، یتیمن تہٕ مونڈن باپتھ تٔتی۔ اگر توٚہؠ تہِ کٔریٚو تہٕ یہُوواہؔ کریٚو توٚہہِ پرٮ۪تھ کامہِ منٛز برکت۔
\v 20 تہٕ ییٚلہ توٚہؠ پنُن سورےٕ زیتون اکہ لٹہِ کُلیٚو پٮ۪ٹھٕ والیٚو تہٕ پتہٕ گٔژھؠ زیٚو نہٕ تہِ اننہٕ خٲطرٕ بیٚیہِ واپس یُس کینٛہہ کُلین پٮ۪ٹھ رودمُت آسہ۔
\p
\v 21 یتھے پٲٹھؠ ییٚلہ توٚہؠ پننٮ۪ن دچھِ باغن دچھ والیٚو تہٕ پتہٕ گٔژھؠ زیٚو نہٕ بیٚیہِ کُلٮ۪ن ژھٲنٛڈ دنہِ واپس۔ سۅ ترٲیو پردیسؠ ین، یتیمن تہٕ مونڈن باپتھ۔\f + \fr 24‏:21 \ft احبار 19:10\f*
\v 22 یہ مٔشرٲے زیٚو نہٕ زِ ییٚلہ توٚہؠ مِصرس منٛز غلام ٲسیٚو تہٕ یہُوواہؔ سپُد توٚہہِ پٮ۪ٹھ مہربان۔ اوے چُھسو بہٕ توٚہہ حکم دِوان زِ ضرورت منٛدن کٔریٚو ہمدردی۔"
\c 25
\p
\v 1 موسیٰؔ ہن ووٚن اسرائیل ین مزید، "اگر دوٚن اسرائیل ین پانہٕ وٲنؠ تنازٕ آسہ تہٕ تِم گژھن عدالتس تہٕ منصف دییہِ غٲلبن فٲصلہٕ زِ اکھ چُھ بے قصور تہٕ بیاکھ چُھ مجرم۔
\v 2 اگر قٲضؠ ونہِ زِ قصور وارس گژھِ سزا میلُن تہٕ گژھِ حکم دیُن زِ سُہ شونٛگنؠ پتھرِس پٮ۪ٹھ بُتھ تل کُن کٔرِتھ تہٕ گژھنس کوڈٕ دنہٕ یِنؠ۔ تمِس کٲتیاہ کوڈٕ گژھن دِنہٕ یِنؠ تمیُک حساب چُھ یتھ پٮ۪ٹھ زِ تٔمؠ کٔمہِ قسمُک جرُم آسہ کوٚرمُت۔
\p
\v 3 اتھ چُھ اجازت زِ تمِس گژھن ژتجی کوڈٕ دنہٕ یِنؠ مگر تمہِ زیادٕ نہٕ۔ اگر تمِس ژتجَہو کھۅتہٕ زیادٕ دنہٕ آے تہٕ سُہ گو عوامس منٛز ذلیل کرُن۔
\p
\v 4 اگر تُہنٛد دانٛد موٗرنہ باپتھ اناجہٕ پیٚٹھؠ پکان آسہ اگر سُہ امہِ منٛزٕ کینٛہہ کھیٚیہ تہِ سُہ گژھِ نہٕ رُکاون۔\f + \fr 25‏:4 \ft 1 کورنتھ 9:9 \f*
\p
\v 5 اگر زٕ بارٕنؠ أکسےٕ ملکِیتس پٮ۪ٹھ روزان آسن تہٕ تِمو منٛزٕ آسہ اکھ بےٚ اولاد تہٕ سُے مرِ، تمؠ سنٛزِ زنانہِ پزِ نہٕ تس نفرس سٟتؠ خانٛدر کرُن یُس نہٕ تمہِ گرُک بٲژ آسہ۔ گزریمتِس نفرٕ سُنٛد بوے ہیٚکہ تس سٟتؠ خاندر کٔرِتھ تہٕ تس نِش شونٛگِتھ۔ یہ کرُن چُھ تسُنٛد فرض۔\f + \fr 25‏:5 \ft متی 22:24\f*
\v 6 اگر پتہٕ تمِس نیٚچو زاو تہٕ سُہ نیٚچو ییہِ تسُنٛد ماننہٕ یُس گزریومُت چُھ، یُتھ تمِس موٚردٕ سُنٛد ناو زنٛدٕ روزِ۔
\p
\v 7 وۅنؠ اگر نہٕ موٚردٕ نفرٕ سُنٛد بوے تس سٟتؠ خاندر کرُن یژھِ نہٕ سۅ گژھِ شہرٕ کِس دروازس پٮ۪ٹھ وۅدٕنؠ روزِتھ شہرٕ کیٚن زِٹھیٚن ونٕنؠ، "میانِس خاندار سُنٛد بوے چُھ مےٚ سٟتؠ خاندر کرنس انکار کران یمہِ سٟتؠ بہ أکِس لڑکس زایُن دمہٕ ہا یُس اسرائیلس منٛز موٚردٕ نفرٕ سُنٛد ناو مِٹنہٕ نشہٕ بچاوِہے۔
\v 8 پتہٕ پزِ بُزرگن سُہ نفر ناد دِتھ انُن تہٕ تمِس سٟتؠ کتھ کرٕنؠ۔ شاید کرِ سُہ بیٚیہِ تس مونٛڈِ سٟتؠ خاندر کرنس انکار۔
\p
\v 9 اتھ صورتس منٛز گژھِ سۅ بُزرگن تِھییہ تس برُونٛہہ کُن گژھٕنؠ تہٕ تمسُنٛد اکھ کھۅربانہٕ کھۅر کڈنؠ یمہ سٟتؠ یہ ظٲہر سپدِ زِ تس ترِنہٕ امسنٛدِ جادادٕ منٛزٕ کِہین، تمِس لایہ بُتھِس تھوٚکھ تہٕ ونیٚس، "یہ چُھ تس نفرس سٟتؠ سپدان یُس پننِس موٚردٕ بٲے سنٛدِ خٲطرٕ نیٚچو پٲدٕ کرنس انکار کران چُھ یُتھ زن نہٕ سانہِ خاندانُک ناو مٹہِ۔"
\v 10 امہِ پتہٕ ییہِ أمِس نفرٕ سُنٛد خاندان یتھ کٔنؠ زاننہٕ زِ یہ گو تمِس نفرٕ سُنٛد خاندان یمِس کھوٚرٕ بانہٕ کڈنہٕ آو۔
\p
\v 11 ییٚلہِ زٕ نفر پانہٕ وٲنؠ ژُوان آسن تہٕ أکِس نفرٕ سنٛز زنانہٕ وۅتھِ خاندارس مددتس تہٕ دییہِ بیٚیس نفرٕ سنٛدِس شرم گاہس تھف۔
\v 12 تمِس پٮ۪ٹھ گژھِنہٕ رحم کرُن، تمِس گژھِ اتھے ژٹُن۔
\p
\v 13‏-14 ییٚلہِ توٚہؠ چیز ہیٚوان یا کٕنان ٲسیٚو تہٕ دویہ قسمٕکؠ پرمان تھٲوِتھ گژھِ نہٕ لوٗکن دونٛکھٕ دِنٕچ کوشش کرٕنؠ، اکھ آسہ سُہ یُس توٚہؠ کٕننہٕ وزِ استعمال کران ٲسیٚو تہٕ بیاکھ گو سُہ یُس توٚہؠ ہیٚنہٕ وزِ استعمال کران ٲسیٚو۔ یا دویہِ قسمٕکؠ مینٛژٕ بانہٕ اکھ سُہ یُس توٚہؠ کینٛہہ ہیٚنہٕ وزِ استعمال کران ٲسیٚو تہٕ بیاکھ آسہ سُہ یُس توٚہؠ کٕننہٕ وزِ استعمال کران ٲسیٚو۔
\v 15 ہمیشہ گژھن تولنہٕ تہٕ میننہٕ وزِ صحی مینٛژٕ بانہٕ استعمال کرٕنؠ یُتھ سون خدا یہُوواہؔ توٚہہ تتھ ملکس منٛز واریہس وقتس روزنہٕ دییہِ یُس سُہ توٚہہ دِوان چُھ۔
\v 16 یہُوواہؔ چُھ تِمن سارنےٕ لوٗکن سٟتؠ نفرت کران یمہٕ بے ایمٲنی کران چھِ، تہٕ دییہِ تِمن سزا۔
\v 17 یہ تھٲوؠ زیٚو ہمیشہٕ یاد زِ عمالیق کیٚو لوٗکو کیاہ کوٚر تُہنٛدین جدٕاجدادن سٟتؠ ییٚلہ تِم مِصرٕ منٛزٕ نیران ٲسؠ۔
\v 18 تِمو کوٚر تمہِ وزِ تُہنٛدین جدٕاجدان پٮ۪ٹھ سفرس دوران حملہٕ ییٚلہ تِم سٮ۪ٹھاہ تٔھکمٕتؠ تہٕ ژھیٚنمٕتؠ ٲسؠ۔ تِمن لوٗکن اوس نہٕ بلکُل خدایہ سُنٛد خوف یمہِ کِنؠ تِمو تُہنٛدین جدٕاجدادن پٔتؠ کِنؠ حملہٕ کوٚر تہٕ تِم سٲری لوٗکھ کٔرِکھ قتل یمہٕ نہٕ باقین ہنٛدؠ پٲٹھؠ تیز ژٔلِتھ ٲسؠ ہیٚکان۔
\v 19 لہٰذا ییٚلہ سٲنؠ خدا یہُوواہنؔ توٚہہ سُہ ملک بخُش یمیُک تٔمؠ توٚہہ سٟتؠ وعدہ کوٚرمُت اوس تہٕ ییٚلہ تٔمؠ توٚہہ پانس انٛدؠ پٔکؠ تمام دشمنن سٟتؠ لڑنُک حوصلہٕ بخُش تہ عمالیقچہِ تمام جمٲژ مارِووکھ۔ تہٕ تمیُک نتیجہٕ دراو یہ زِ کٲنٛسہِ تہِ تھٲوؠ نہٕ پتہٕ تِم یاد۔ لہٰذا مہٕ مٔشرایٚو یہِ کرُن!
\c 26
\p
\v 1 موسیٰؔ ہن ووٚن اسرائیل ین مزید، "ییٚلہ توٚہؠ تتھ زمیٖنس قبضہ کٔریٚو یۅسہ سون خدا یہُوواہؔ توٚہہ دِوان چُھ تہٕ یتہِ توٚہؠ بسنہِ لگیٚو،
\v 2 تتہِ چُھ توٚہہ پرٮ۪تھ أکِس پننہِ گۅڈنِکہ پھسلُک کینٛہہ حصہٕ ہیٚتھ أکِس ٹوکرِ منٛز بٔرتھ تتھ جایہِ نیٚون یۅسہ یہُوواہنؔ توٚہہ تتہِ عبادت خٲطرٕ تھٲومٕژ آسہ۔
\p
\v 3 تمہِ ساعتہٕ گٔژھؠ زیٚو توٚہؠ سردار کاہنس نِش یُس تمہِ وقتہٕ تتہِ خدمت کران آسہ تہٕ تس ؤنے زیٚو، "از پننہِ پھسلُک یہ گۅڈنیُک حصہٕ توٚہہِ دِتھ چُھس بہٕ پننِس خدا یہُوواہسؔ ونان زِ مےٚ تُل یہ تمہِ زمیٖنہِ منٛزٕ یۅسہ ژےٚ سانٮ۪ن جدٕاجدان اسہِ دنُک وعدہ اوسُتھ کوٚرمُت۔"
\v 4 پتہٕ پزِ کاہنس پھل دار سۅ ٹوکٕر تُلٕنؠ تہٕ قربان گاہس پٮ۪ٹھ تھاوٕنؠ یتہِ سٲنِس خدا یہُوواہؔ سنٛدِ باپتھ قربٲنیہِ تراونہٕ چھےٚ یوان۔
\p
\v 5 پتہٕ چُھ توٚہہِ یہُوواہسؔ برُونٛہہ کنہِ یہ ونُن: " میٚون جد یعقوب اوس ارامؔؠ اکہِ طاقتور قومُک فرد۔ سُہ ووت پنُن خاندان ہیٚتھ مِصر۔ ییٚلہ سُہ توٚر گو تہٕ سۅ ٲس اکھ لۅکٕٹ جماتھ، مگر تمہٕ رودؠ تٔتؠ تہٕ تِہنٛدؠ اولاد بنیاے اکھ بوٚڈ تہٕ طاقتور قوم۔\f + \fr 26‏:5 \ft میون جد اوس اکھ تباہ کرن وول ارامؔؠ۔ یتہٕ اوس جد یعقوب۔ \f*
\p
\v 6 پتہٕ کٔر مِصرٕ کیٚو لوٗکو تِمن سٟتؠ سٮ۪ٹھاہ سختی تہٕ تِم کٔرکھ پنٕنؠ غلام بننَس تہٕ سخت محنت کرنس پٮ۪ٹھ مجبوٗر۔\f + \fr 26‏:6 \ft خروج 1:8 پٮ۪ٹھٕ 14\f*
\v 7 پتہٕ کوٚر سانیٚو جدٕاجدادو توٚہہِ یعنی پننِس خدا یہُوواہسؔ آلو تہٕ توٚہہ بوزو تِہُنٛد۔ توٚہہِ وُچھو زِ تِم ٲسؠ تکلیفس منٛز، تہٕ تِم ٲسؠ سخت محنت کرنہٕ باپتھ مجبوٗر کرنہٕ یوان، تہٕ تِمن پٮ۪ٹھ اوس ظلُم سپدان۔
\p
\v 8 پتہٕ أنووکھ توٚہہ تِم پننہِ قدرتہٕ، بیٚون بیٚون معجزٕ ہٲوِتھ تہٕ باقی خوفناک کامہِ کٔرِتھ مِصرٕ منٛزٕ کڈِتھ۔
\v 9 تہٕ أسؠ یتھ سرِزمین پٮ۪ٹھ أنِتھ دِژو اسہِ یہ زمیٖن یۅسہ سیٹھاہ ذرخیز چھےٚ۔\f + \fr 26‏:9 \ft سیٹھاہ ذرخیز زمین\f*
\p
\v 10 لہٰذا، اے یہُوواہؔ، مےٚ اوٚنمو تمہِ زمینُک گۅڈنیُک پھسٕل توٚہہ نِش یُس مےٚ میٚول۔ پتہٕ پزِ توٚہہ سۅ ٹوکٕر یہُوواہسؔ برُونٛہہ کنہِ تھٲوِتھ تمؠ سنٛز عبادت کرٕنؠ۔
\v 11 تہٕ توٚہہ پزِ یکہٕ وٹہٕ یہ کھیٚن کھیٚنُک جشِن مناوُن تاکہِ سٲنِس خدا یہُوواہؔ سُنٛد شکُر گژھِ تِمن تمام رٕتٮ۪ن چیزن ہُنٛد ادا یمہٕ تمؠ توٚہہِ تہٕ تُہنٛدِس خاندانس عنایت کٔرؠ۔ تہٕ توٚہؠ کٔرؠ زیوکھ لاوین ہنٛدؠ اولاد تہٕ توٚہہِ سٟتؠ روزن وٲلؠ پردیسی تہِ کھیٚن چیٚنچہٕ اتھ خوشی منٛز شٲمل۔
\p
\v 12 پرٮ۪تھ ترییہِ وہرؠ ییہِ زِ ژٕ لاوی ہنٛدین اولادن، توٚہہ سٟتؠ روزن والٮ۪ن پردیسؠ ین، یتیمن تہٕ مونٛڈن نِش پننہِ فصلُک دہِم حصہٕ ہیٚتھ تاکہ پرٮ۪تھ کُنہِ شہرس منٛز آسہ تِمن وٲفِر خۅردنی۔
\v 13 پتہٕ پزِ توٚہہ یہُوواہسؔ ونُن، "مےٚ اوٚنمو توٚہہ نِش پننہِ گھرِ یمہ وریکہِ فصلُک دہِم حصہٕ یُس مےٚ تُہنٛدِ باپتھ الگ تھوومُت اوس۔ بہٕ چُھس یہ لاوی ہنٛدین اولادن، پردیسؠ ین، یتیمن تہٕ مونٛڈن دِوان یتھ پٲٹھؠ اسہِ تُہنٛد حکم چُھ۔ مےٚ کٔر نہٕ دہمِس حصس متعلق تُہنٛدِ حکمٕچ کُنہِ رنٛگہٕ نافرمٲنی۔ تہٕ نہ گوم امہِ حوالہٕ کانٛہہ حکم مٔشِتھ۔
\p
\v 14 بہٕ چُھس یمہِ کتھِ ہُنٛد اعلان کران زِ مےٚ کھیٚو نہٕ دہمہِ حصہ کہِ کھیٚنہٕ منٛزٕ کہینٛؠ تہِ ییٚلہ بہٕ کٲنٛسہِ ہنٛدِس تعزیتس پٮ۪ٹھ اوسُس۔ تہٕ مےٚ کۅڈ نہٕ تمہِ منٛزٕ کانٛہہ تہِ چیز پننہِ گھرٕ نیٚبر ییٚلہ بہٕ تتھ حالٕژ منٛز اوسس یۅسہ نہٕ توٚہہ قٲبلِ قبول چھےٚ۔ مےٚ کوٚر نہٕ تمہ منٛزٕ کینٛہہ تہِ موٚیتن ہنٛدِ روحٲنی سکوٗنہٕ باپتھ استعمال۔ اے یہُوواہؔ مےٚ کٔر تُہنٛز عبادت تہٕ تہِ سورے کوٚرم یہ تُہنٛد حکم اسہِ دہمِس حصس متعلق اوس۔\f + \fr 26‏:14 \ft گریند 19:11، 19:14\f*
\p
\v 15 مہربٲنی کرِتھ تراو تہٕ آسمان کہِ پننہِ مقدس مقامہ پٮ۪ٹھٕ بوٚن کُن نظر تہٕ پننٮ۪ن اسرائیلی لوٗکن دِتہٕ برکت۔ یتھ انتہٲئی ذرخیز زمیٖنہ تہِ کر تہٕ برکت یۅسہ ژےٚ اسہِ دژٕتھ، یمیُک ژےٚ سانٮ۪ن جدٕاجدادن وعدہ اوسُتھ کوٚرمُت زِ بہٕ کرٕ یہ۔"\f + \fr 26‏:15 \ft ذرخیز زمین\f*
\p
\v 16 سون خدا یہُوواہؔ چُھ از توٚہہ تِمن تمام اصولن تہٕ احکامن تعمیل کرنُک حکم دِوان۔ لہٰذا کٔرؠ زیٚو وفادٲری سان سۅدلہٕ تِہنٛز عبادت۔
\v 17 از کوٚرو توٚہہ اعلان زِ سُہ چُھ تُہنٛد خدا، تہٕ توٚہؠ پکنٲیو پنٕنؠ زندگی تِتھے پٲٹھؠ یتھ کنؠ سُہ توٚہہ نِش یژھان چُھ، تہٕ توٚہؠ کریٚو تمسنٛدین تمام احکامن، اصولن تہٕ فرمانن ہنٛز تعمیل تہٕ یتہِ زِ توٚہؠ کٔریٚو تہِ سورےٕ یہ سُہ توٚہہ کرُن ونہِ۔
\p
\v 18 تہٕ از کوٚر یہُوواہنؔ واضیح زِ توٚہؠ چُھو تسنٛدؠ لوٗکھ، تہٕ یمیُک تمؠ وعدہ کوٚرمُت اوس زِ توٚہؠ سپدیٚو، تہٕ اوٕ موٚکھٕ چُھ سُہ توٚہہ تمام حکمن ہنٛز تعمیل کرنُک حکم دِوان۔
\v 19 اگر توٚہؠ تہِ کریٚو تہٕ سُہ بناوِ توٚہہ بدل کُنہِ قومہٕ نشہٕ بٔڈؠ یُس تٔمؠ قٲیم کوٚرمُت چُھ تہٕ سُہ بناوِ توٚہہ اتھ قٲبل زِ تمِس تعریف کٔرِتھ کٔریٚو تس تعظیم۔ توٚہؠ چُھو یہُوواہؔ سنٛدِ باپتھ خاص لوٗکھ، یتھٕ کِنؠ تٔمؠ توٚہؠ الگ تہٕ پاک بناونُک وعدہ کوٚرمُت اوس۔
\c 27
\p
\v 1 باقی اسرائیلی قٲیدن ہمراہ ووٚن موسیٰؔ ہن لوٗکن یہ زِ تِمن تمام احکامن پٮ۪ٹھ کٔرؠ زیٚو عمل یمہ مےٚ توٚہہ از دِتمٕتؠ چُھو۔
\v 2 عنقریب گٔژھیٚو توٚہؠ یردن دریاوس تار لٔبِتھ تتھ ملکس منٛز دٲخل یمیُک تُہنٛدؠ خدا یہُوواہنؔ توٚہہ دنُک وعدہ کوٚرمُت چُھ۔ تتہِ کٔرؠ زیوکھ کینٛہہ بجہِ کنہِ کھڑا تہٕ مٔتھؠ زیوکھ چونہٕ۔
\v 3 تِمن کنٮ۪ن پٮ۪ٹھ لیٚکھؠ زیٚو تِم تمام قانون تہٕ تعلیمات، ییٚلہ توٚہؠ تتھ سیٹھہےٕ ذرخیز زمینہٕ پٮ۪ٹھ دٲخٕل سپدیٚو یُس یہُوواہنؔ، تٔمؠ خدا یمسنٛز سٲنؠ جدٕاجداد عبادت کران ٲسؠ توٚہہ دِنُک وعدہ کوٚرمُت اوس۔
\p
\v 4 ییٚلہ توٚہؠ یردن دریاوس اپور تٔرِتھ تہٕ عیبالؔ بالس پٮ۪ٹھ کینٛہہ بجہِ کنہِ تھٲیو، یتھٕ کِنؠ مےٚ توٚہہ ووٚن تہٕ تِمن کٔرؠ زیٚو چونہٕ گچھ۔\f + \fr 27‏:4 \ft عیبالؔ بال چُھ اسرائیل کِس کوہستٲنؠ ملکس منٛز۔ ارتٲجی کلومیٹر شمال یروشلمس کُن سکم شہرس نزدیک۔\f*
\v 5 تہٕ تتہِ بنٲے زیٚو کنٮ۪ن ہنٛز اکھ قربان گاہ یُتھ زن یہُوواہسؔ قربٲنیہ پیش کٔریٚو، مگر شسترو اوزارو سٟتؠ کٔرؠ زیٚو نہٕ تِمن کنٮ۪ن پٮ۪ٹھ کانٛہہ تہِ کٲم۔
\p
\v 6 یمہٕ قربان گاہ توٚہؠ سٲنِس خدا یہُوواہسؔ باپتھ قربٲنیہ زالنہٕ خٲطرٕ بناوان چُھو تِم گژھن پُھٹراونہٕ ورٲے کنیٚو سٟتؠ بناونہٕ ینہِ۔
\v 7 تہٕ تتہِ گژھیٚو توٚہؠ یہُوواہسؔ سٟتؠ لول ورتاونہٕ خٲطرٕ قربٲنیہ پیش کرنہِ تہٕ توٚہؠ کھیٚؠ زیٚو تِمو قربٲنیو منٛزٕ پنُن حصہٕ تہٕ یہُوواہسؔ برُونٛہہ کنہِ روزؠ زیٚو خوش۔\f + \fr 27‏:7 \ft خروج 20:34 تہٕ احبار 3:1 پٮ۪ٹھٕ 17\f*
\v 8 تہٕ ییٚلہِ توٚہؠ تِمن کنٮ۪ن پٮ۪ٹھ یِم قانون لیٚکھیٚو تہٕ یِم لیکھؠ زیوکھ صاف صاف۔"
\p
\v 9 پتہٕ ووٚن موسیٰؔ ہن تہٕ کاہنو سارنی اسرائیلی لوٗکن، "اے اسرائیلی لوٗکو، ژۅپہٕ کٔریٚو تہٕ بوزیٚو یہ کینٛژھا بہٕ ونان چُھسو۔ از بنیٚو توٚہؠ تِم لوٗکھ یِم سٲنِس خدا یہُوواہؔ سنٛدؠ چھِ۔
\v 10 لہٰذا پزِ توٚہہ تی کرُن یہ سُہ توٚہہ ونان چُھ تہٕ تِمن سارنی اصولن تہٕ قٲیِدن پٮ۪ٹھ چھیٚو عمل کرٕنؠ یمہٕ بہٕ از توٚہہ ونان چُھسو۔
\p
\v 11 امی دوٚہہ ووٚن موسیٰؔ ہن اسرائیلی لوٗکن،
\v 12 یردن دریاوس تار لبنہٕ پتہٕ پزِ شمعون، لاوی، یہُوداؔ، اشکار، یوسف تہٕ بنیمِینؔ قبیلہٕ کٮ۪ن گرزِیمؔ پہاڑس پٮ۪ٹھ کھڑا سپدُن تہٕ یہُوواہسؔ درخواس کرُن زِ سُہ کرِنؠ لوٗکن برکت۔
\v 13 تہٕ روبن، جد، آشرؔ، زبولون، دان تہٕ نفتالیؔ کیٚن قبیلن پزِ عیبال پہاڑس پٮ۪ٹھ کھٔسِتھ تمہٕ کتھٕ بوزنہِ یمہٕ یہُوواہؔ لوٗکن پٮ۪ٹھ لعنت کرنہٕ وزِ کرِ۔
\p
\v 14 لاوی ہنٛدین اولادن پزن یمہٕ کتھٕ بڈِ بڈِ وننہِ:
\q1
\v 15 "یہُوواہؔ وٲلِن پرٮ۪تھ تس شخصس لعنت یُس لکٕرِ ہنٛز یا کنیٚو مورت گران آسہ یا کُنہِ دھاتس بناوان آسہ۔ تہٕ پتہٕ آسہ ژورِ ژورِ سۅ کھڑا کران تہٕ تتھ عبادت کران۔
\q2 یہُوواہؔ چُھ یمہٕ چیز قٲبلِ نفرت زانان۔
\q2 تہٕ سارنی لوٗکن پزِ یورٕ آمین کرُن۔\f + \fr 27‏:15 \ft تمام بہن اسرائیلی قبیلن ہنٛدؠ لوٗکھ، نہ صِرِف عیبالؔ بالس پٮ۪ٹھ شےٚ قبیلہٕ۔ \f*
\q2
\v 16 یُس پننِس مٲلِس یا ماجہِ بے عزتی کران آسہ، یہُوواہؔ کرِ تس لعنت،
\q2 تہٕ سارنی لوٗکن پزِ یورٕ آمین کرُن۔
\q1
\v 17 یُس کٲنٛسہِ ہنٛدِس ملکِیتس زاگہِ تہٕ نشانہٕ ڈالہِ یہُوواہؔ کرِ تِتھیٚن لوٗکن لعنت۔
\q2 تہٕ سارنی لوٗکن پزِ یورٕ آمین کرُن۔
\q1
\v 18 یُس کٲنٛسہِ أنِس غلط وتھ ہاوِ، تہٕ یہُوواہؔ کرِ تس لعنت۔
\q2 تہٕ سارنی لوٗکن پزِ یورٕ آمین کرُن۔\f + \fr 27‏:18 \ft احبار 19:14\f*
\q1
\v 19 یُس پردیسؠ ین، یتیمن تہٕ مونڈن تِمو چیزو نشہٕ محروم کرِ یمہٕ چیز شریعتن تِمن واتان آسن تہٕ یہُوواہؔ کرِ تِمن لعنت۔
\q2 تہٕ سارنی لوٗکن پزِ یورٕ آمین کرُن۔
\q1
\v 20 یہُوواہؔ کرِ تمِس پٮ۪ٹھ تہِ لعنت یُس نہٕ پننِس مٲلِس احترام کرِ تہٕ تس سنٛزِ کانٛسہِ تہِ زنانہِ سٟتؠ کرِ ہم بستری۔\f + \fr 27‏:20 \ft تمؠ سنٛز وۅرٕ موج، غٲلباً امسنٛدِ مٲلؠ سنٛزو واریہو خاندارِنیٚو منٛز اکھ۔\f*
\q2 تہٕ سارنی لوٗکن پزِ یورٕ آمین کرُن۔
\q1
\v 21 یُس تہِ کانٛہہ چارواین سٟتؠ جنسی تعلق ورتاوِ، یہُوواہؔ کرِ تس لعنت،
\q2 تہٕ سارنی لوٗکن پزِ یورٕ ضروری ونُن "آمین"\f + \fr 27‏:21 \ft احبار 18:23، 20:15\f*
\q1
\v 22 اگر کانٛہہ پننہِ بیٚنہِ یا وۅرٕ بیٚنہِ سٟتؠ ہم بستری کرِ تہٕ یہُوواہؔ منٛگہِ تس باپتھ لعنت،
\q2 تہٕ سارنی لوٗکن پزِ یورٕ ضروری ونُن "آمین"\f + \fr 27‏:22 \ft احبار 18:9، 20:17\f*
\q1
\v 23 یُس پننہِ ہشہِ ماجہِ سٟتؠ ہم بستری کرِ تہٕ یہُوواہؔ منٛگہِ تس خٲطرٕ لعنت،
\q2 تہٕ سارنی لوٗکن پزِ یورٕ ضروری ونُن "آمین"\f + \fr 27‏:23 \ft احبار 18:8، 20:14\f*
\q1
\v 24 یُس کٲنٛسہِ ژورِ ژورِ قتل کرٕ تمِس باپتھ تہِ منٛگہ یہُوواہؔ لعنت،
\q2 تہٕ سارنی لوٗکن پزِ یورٕ ضروری ونُن "آمین"
\q1
\v 25 یہُوواہؔ منٛگہِ تس باپتھ لعنت یُس کٲنٛسہِ نِش پونٛسہٕ رٹِتھ ناحقہ کانٛہہ قتل کرِ،
\q2 تہٕ سارنی لوٗکن پزِ یورٕ ضروری ونُن "آمین"\f + \fr 27‏:25 \ft خروج 23:6 پٮ۪ٹھٕ 8\f*
\q1
\v 26 یہُوواہؔ سوزِ پرٮ۪تھ تس شخصس لعنت یُس تِمن قانونن ہنٛز نافرمٲنی کٔرِتھ واضیح کرِ زِ یِم قانون چھِنہٕ ٹھیک،\f + \fr 27‏:26 \ft گلتی 3:10\f*
\q2 تہٕ سارنی لوٗکن پزِ یورٕ ضروری ونُن "آمین"
\c 28
\p
\v 1 موسیٰؔ ہن ووٚن اسرائیلی لوٗکن، "اگر توٚہؠ تی کٔریٚو یہ سون خدا یہُوواہؔ توٚہہ کرُن ونان چُھ تہٕ ایمانداری سان کٔریٚو پرٮ۪تھ تتھ چیزس پٮ۪ٹھ عمل یمیُک بہٕ توٚہہ از حکم دِوان چُھس، تہٕ سُہ بناوِ توٚہہ دُنیہس منٛز موجود تمام قومو کھۅتہٕ بٔڈؠ۔
\v 2 اگر توٚہؠ یہُوواہؔ سنٛز عبادت کٔریٚو تہٕ یمہٕ سارے برکٔژ میلن توٚہہ:
\pi
\v 3 سُہ کرِ توٚہہ سارنےٕ کامٮ۪ن منٛز برکت ییٚلہ توٚہؠ شہرن منٛز ٲسیٚو تہٕ سُہ کرِ توٚہہ سارنےٕ کامٮ۪ن منٛز برکت ییٚلہ توٚہؠ کھہَن منٛز کٲم کران ٲسیٚو۔
\pi
\v 4 سُہ کرِ توٚہہِ برکت، واریاہ اولاد دِتھ گتُل فصٕل عنایت کٔرِتھ تہٕ گُتجہٕ گٲوٕ تہٕ تیٖر سوزِتھ۔
\pi
\v 5 سُہ کرِ توٚہہ برکت، ژۅٹ بناونہٕ باپتھ وٲفِر اناج سوزِتھ۔
\pi
\v 6 سُہ کرِ توٚہہ پرٮ۪تھ کُنہِ جایہِ برکت، ییٚلہ توٚہؠ پننیٚو گھرو نیٚبر نیریٚو تہٕ پتہٕ پنُن گھرٕ واپس یِیو۔\f + \fr 28‏:6 \ft پوٗرٕ زندگی منٛز\f*
\pi
\v 7 یہُوواہؔ بناوِ توٚہہ پننٮ۪ن دشمنن ہنٛدِس فوجس شِکس دِنس قٲبل۔
\pi تِم کرن توٚہہ اکہِ انٛدٕ حملہٕ، مگر توٚہہ نِش ژلن تِم ستو انٛدو دوٗر۔
\pi
\v 8 یہُوواہؔ کرِ تُہنٛزٕ کُچھِ اناجہٕ سٟتؠ بٔرتھ توٚہہ برکت تہٕ بیٚیہِ کرِ سُہ توٚہہ تِمن تمام کامٮ۪ن برکت یمہٕ توٚہؠ کٔریٚو۔ سُہ کرِ توٚہہ تتھ کنعان ملکس منٛز برکت یُس سُہ توٚہہ دِوان چُھ۔
\p
\v 9 اگر توٚہؠ تِمن تمام احکامن پٮ۪ٹھ عمل کٔریٚو یمہ سٲنؠ خدا یہُوواہنؔ توٚہہِ دِتؠ تہٕ اگر توٚہؠ تمسنٛدین احکامن پٮ۪ٹھ عمل کٔرِتھ پنٕنؠ زنٛدگی گزاریٚو تہٕ سُہ بناوِ توٚہہ پنُن پاک قوم یمیُک تٔمؠ وعدہ کوٚرمُت چُھ۔
\p
\v 10 پتہٕ زانن زمینہٕ پیٚٹھچہ تمام جمٲژ زِ توٚہؠ چُھو یہُوواہؔ سنٛدؠ تہٕ تِم کھۅژُن توٚہہِ۔
\p
\v 11 تہٕ یہُوواہؔ دییہِ توٚہہ واریاہ ترقی۔ سُہ دییہِ توٚہہ یتھ زمینس پٮ۪ٹھ واریاہ اولاد، واریاہ چاروٲے تہٕ وفور فصٕل یمیُک تٔمؠ تُہنٛدین جدٕاجدادن وعدہ کوٚرمُت چُھ زِ سُہ دییہِ توٚہہ۔
\p
\v 12 یمہِ ساعتہٕ رودٕچ ضرورت آسہ تہٕ یہُوواہؔ تراوِ تمہ وزِ آسمانہٕ پٮ۪ٹھٕ یتہِ سُہ جمع تھاوان چُھ، تہٕ سُہ کرِ توٚہہ تمام کامٮ۪ن منٛز برکت یُتھ زن توٚہؠ باقے قومن قرض دِنس اہل بنیٚو۔ مگر توٚہہ پییہِ نہٕ تِمن نِش پونٛسہٕ وۅزُم اننٕچ ضرورت۔
\p
\v 13 اگر توٚہؠ ایماندٲری سان سٲنِس خدا یہُوواہؔ سنٛدین تمام حکمن پٮ۪ٹھ عمل کریٚو یمہ بہٕ توٚہہ از ونان چُھس تہٕ یہُوواہؔ بناوِ تُہنٛدس قومس باقی قومو نِشہ برتر نکہِ تہنٛدِ نِشہ کمتر۔ توٚہؠ روزیٚو ہمیشہ خوشحال تہٕ توٚہؠ گٔژھیٚو نہٕ زانٛہہ تہِ محتاج۔\f + \fr 28‏:13 \ft ژےٚ پزی نہٕ زانٛہہ تہِ تہنٛز کُنہِ تہِ طریقہٕ نافرمٲنی کرٕنؠ \f*
\p
\v 14 یہُوواہؔ کرِ یہ سورےٕ تُہنٛدِ باپتھ اگر توٚہؠ یمہ کتھٕ ترٲیو نہٕ یمن ہُنٛد حکم بہٕ توٚہہ از کران چُھس، تہٕ اگر نہٕ توٚہؠ باقی معبودن ہنٛز عبادت کٔریٚو۔
\p
\v 15 وۅنؠ اگر نہٕ توٚہؠ تہِ کریٚو یہ سون خدا یہُوواہؔ توٚہہ کرُن ونان چُھ۔ تہٕ اگر نہٕ توٚہؠ تِمن سارنےٕ اصولن تہٕ قانونن پٮ۪ٹھ عمل کٔریٚو یمہ بہٕ توٚہہ از دِوان چُھس تہٕ سُہ کرِ توٚہہ پٮ۪ٹھ یمہٕ لعنتہٕ نٲزِل۔ تہٕ سُہ کرِ یمہ توٚہہ خلاف پننہِ پورٕ طاقتہٕ سٟتؠ نٲزِل۔
\pi
\v 16 سُہ کرِ توٚہہ پٮ۪ٹھ لعنت نٲزِل ییٚلہ توٚہؠ شہرن منٛز ٲسِو۔
\pi تہٕ سُہ کرِ توٚہہ پٮ۪ٹھ لعنت نٲزِل ییٚلہ توٚہؠ کھہَن منٛز کٲم ٲسِو کران۔
\pi
\v 17 سُہ کرِ توٚہہ پٮ۪ٹھ ژۅٹ بناونہٕ باپتھ منٲسب اناج نہ سوزِتھ لعنت نٲزِل۔
\pi
\v 18 سُہ کرِ توٚہہِ پٮ۪ٹھ واریاہ کم اولاد سوزِتھ لعنت نٲزِل، توٚہہ ناقص پھسٕل تہٕ واریاہ کم گٲو تہٕ تیٖر سوزِتھ۔
\pi
\v 19 سُہ کرِ پرٮ۪تھ جایہ توٚہہ لعنت۔ ییٚلہ توٚہؠ پننیٚو گرو منٛزٕ نیریٚو تہٕ ییٚلہ توٚہؠ پنُن گھرٕ واپس أژیو۔\f + \fr 28‏:19 \ft پوٗرٕ زندگی منٛز\f*
\p
\v 20 اگر توٚہؠ بُرٕ کامہ کریٚو تہٕ یہُوواہؔ مٔشرٲے ووٚن تہٕ سُہ کرِ توٚہہ پٮ۪ٹھ لعنت نٲزِل، توٚہہ کرِ پریشان تہٕ یہ کینٛژھا توٚہؠ کٔریٚو تہٕ تتہِ گژھیٚو توٚہؠ مایوس،
\pi یۅتام تُہنٛدؠ دشمن توٚہہِ جلدےٕ مکمل پٲٹھؠ تباہ کرن۔
\pi
\v 21 یہُوواہؔ کرِ توٚہہ وبٲئی بیمارِ نٲزِل یُتھ زن توٚہہ منٛزٕ کانٛہہ تہِ تتھ ملکس منٛز زنٛدٕ روزِ یتھ منٛز توٚہؠ دٲخل سپدِتھ قبضہٕ کرن وٲلؠ چُھو۔
\pi
\v 22 یہُوواہؔ کرِ توٚہہِ تِمن بیمارین منٛز مبتلا یمہٕ تہُنٛدِس جسمس وۅزلاون، تپہٕ تہٕ خٲرشہِ سٟتؠ۔
\pi سٮ۪ٹھاہ گرم آسہ، تہٕ نہ پییہِ روددےٕ۔
\pi تتہِ آسہ واوٕ طوٗفان، یُس تُہنٛدین پھسلن تباہ کرِ۔
\pi یمہٕ سٲری چیز مارن توٚہہ مرنہٕ کِس دمس تام۔\f + \fr 28‏:22 \ft تلوار \f*
\pi
\v 23 آسمان پٮ۪ٹھٕ پییہِ نہٕ رودےٕ نتیجہ نیرِ یہ زِ زمین بنہِ شستٕر ہِش سخت۔
\pi
\v 24 رود تراونہٕ بجایہ، سوزِ یہُوواہؔ واوٕ طوٗفان یُس تُہنٛدِس زمینس تۅتام سیٚکھ تہٕ گرٕد تُلہ یۅتام نہٕ تُہنٛز زمین بُرباد سپدِ۔
\pi
\v 25 یہُوواہؔ بناوِ تُہنٛدین دشمنن توٚہہ شِکس دِنس قٲبل۔ تُہنٛدؠ سِپاہ کرن تِمن اکہِ انٛدٕ حملہٕ مگر ستو انٛدو ژلن تِمن نِش دوٗر۔
\pi تہٕ ییٚلہ باقی قومن ہنٛدؠ لوٗکھ وچُھن زِ توٚہہ سٟتؠ کیاہ چُھ سپدان تہٕ تِم ونن زِ یہ کوتاہ ہٲبت ناک چُھ۔
\pi
\v 26 توٚہؠ مٔریٚو تہٕ جاناوار تہٕ جنگلی جانور ین تہٕ کھیٚن تُہنٛزٕ لاشہٕ، تہٕ کانٛہہ آسہ نہٕ یُس تِمن ژٔلراوِ۔
\pi
\v 27 یہُوواہؔ کھالہِ تُہنٛدِس جسمس بستہٕ یتھ کنؠ تٔمؠ واریاہ وری برُونٛہہ مِصرٕ کیٚن لوٗکن بستہٕ کھاجہِ۔
\pi سُہ کھالہ توٚہہ پھیٚپھر، نٔنؠ زخم تہٕ مُسلس کریٚو خٲرِش پٲدٕ، مگر تیٚوتھ آسہ نہٕ کانٛہہ تہِ چیز یمہِ سٟتؠ یمن بیمارین علاج سپدِ۔
\pi
\v 28 یہُوواہؔ بناوِ توٚہہ منٛزٕ کینٛژن باورٕ۔ کینٛژن بناوِ توٚہہ منٛزٕ أنؠ، تہٕ کینٛژن بناوِ سُہ توٚہہ منٛزٕ ذہنی طور پراکنٛدٕ۔
\pi
\v 29 تکیازِ توٚہؠ ہکیٚو نہٕ یہ وُچِھتھ زِ توٚہؠ کوٚت چُھو گژھان، توٚہؠ ٲسیٚو منٛدنیس پننیٚو اتھو سٟتؠ تِتھ کٔنؠ ژھانٛڈ دِوان یتھٕ کنؠ لوٗکھ انہِ گٔٹِس منٛز دِوان چھِ۔
\pi توٚہؠ پرٲیو نہٕ کُنہ تہِ کامہ منٛز کامیابی۔
\pi توٚہؠ روزیٚو ہمیشہٕ مظلوم تہٕ ٲسیٚو لوٗٹنہٕ یوان، تہٕ کانٛہہ آسہ نہٕ تُہنٛد مدد گار۔
\pi
\v 30 توٚہؠ ٲسیٚو کٲنٛسہِ کورِ سٟتؠ خاندرٕ باپتھ نشٲنؠ کران تہٕ بیاکھ اسہِ یوان تہٕ تس سٟتؠ جبرن شونٛگان۔
\pi توٚہؠ ٲسیٚو گھرٕ بناوان مگر تتھ منٛز ٲسیٚو نہٕ زانٛہہ بسان۔
\pi توٚہؠ ٲسیٚو دچھِ کُلؠ ۅپداوان مگر دچھ ٲسیٚو نہٕ کھیٚوان۔ سۅ آسہ بدل کانٛہہ کھیٚوان۔
\pi
\v 31 تُہنٛدؠ دشمن آسن تُہنٛدین چارواین ماران تہٕ توٚہؠ ٲسیٚو تِمن وُچھان مگر توٚہہ آسہ نہٕ تِہُنٛد ماز کھیٚنہٕ خٲطرٕ میلان۔
\pi تِم نِن تُہنٛدین خرن توٚہہ نِش ہکہٕ وِتھ تہٕ توٚہؠ تِمن یہ کران وچھان مگر توٚہؠ ہکیٚو نہٕ تِم واپس أنِتھ۔
\pi تِم نِن تُہنٛدؠ تیٖر تہِ؛ مگر توٚہہ کرِنہٕ تمہٕ بچاونس منٛز کانٛہہ تہِ مدد۔
\pi
\v 32 توٚہؠ ٲسیو وچھان ییٚلہ تُہنٛدؠ کورِ گۅبر غٲر ملکی ین ہنٛدؠ غلام بنن۔ توٚہؠ ٲسیٚو پرٮ۪تھ دوٚہہ پننٮ۪ن بچن واپس یِنس وتہٕ وُچھان، مگر تُہنٛد یہ وچُھن آسہ بے کار۔
\v 33 غٲر ملکی لوٗکھ نِن سُہ سورےٕ فصل یُس ۅپداونہٕ باپتھ توٚہہ سخت محنت کٔرمٕژ آسیٚو۔ تہٕ تِم کرن توٚہہ سٟتؠ ہمیشہٕ سخت تہٕ ظٲلمانہٕ سلوٗک۔
\pi
\v 34 نتیجہ نیرِ یہ زِ تمام ہٲبتھ ناک چیز یمہٕ توٚہؠ وچھان ٲسیٚو کرن توٚہہ پاغل۔
\pi
\v 35 یہُوواہؔ وۅتلاوِ تُہنٛزن زنٛگن انیٖکھ دگہِ دار پھیٚپھر یمہ نہٕ بٔلِتھ ہیٚکن تہٕ تُہنٛدیٚو تلپتیٚو پٮ۪ٹھ تلہِ تام آسن پھیٚپھرےٕ پھیٚپھر۔
\pi
\v 36 یہُوواہؔ نیٚیہ تُہنٛدِس بادشاہس تہٕ باقی لوٗکن کُنہِ دویمِس ملکس منٛز یتہِ نہٕ توٚہؠ تہٕ تُہنٛدؠ جدٕاجداد زانٛہہ تہِ رودؠ مٕتؠ آسن تہٕ تتہِ کٔریٚو توٚہؠ کنٮ۪ن تہٕ لکٕرِ ہنٛزن بناوِمژن مُرژن ہنٛز خدمت تہٕ عبادت۔
\pi
\v 37 ییٚلہ انٛدؠ پٔکؠ ملکن ہنٛدؠ لوٗکھ وچُھن زِ توٚہہ سٟتؠ کیاہ سپُد تہٕ تِم سپدن حٲران۔
\pi تِم دِن توٚہہ طعنہٕ تہٕ پرٮ۪تھ جایہِ یوٚت یہُوواہؔ توٚہہ لار کرِ تُلن توٚہہ فوتہِ۔
\pi
\v 38 توٚہؠ ؤویو پننٮ۪ن کھہَن واریاہ بیٚول مگر پھسٕل لُنیٚو سٮ۪ٹھاہ کم تکیازِ ہالو آسن تُہنٛد پھسٕل کھیٚوان۔
\pi
\v 39 توٚہؠ ٲسیٚو دچھِ کُلؠ وۅپداوان تہٕ تِمن رٲچھ راوٕٹ کران مگر مےَ بناونہٕ باپتھ ٲسیٚو نہٕ دچھ وٲلِتھ ہیٚکان تکیازِ کیٚمؠ آسن دچھِ گۅرن کھیٚوان۔
\pi
\v 40 زیتون کُلؠ ۅپدن تُہنٛدِس زمینس جایہِ جایہِ مگر توٚہہ آسہ نہٕ پانس ملنہٕ باپتھ زیتون تیٖل میلان تکیازِ زیتون آسہ پپنہٕ برُونٛٹھےٕ زمینس پٮ۪ٹھ ؤسؠ پیوان۔
\pi
\v 41 توٚہہ آسن کورِ تہٕ گۅبر مگر تمہٕ روزن نہٕ توٚہہِ سٟتؠ تکیازِ تمہٕ ین رٹتھ نِنہٕ۔
\pi
\v 42 ہالو آسن تُہنٛدین تمام کُلیٚن ہُنٛد پن تہٕ فصل کھیٚوان۔
\pi
\v 43 تُہنٛدس ملکس منٛز بسن وٲلؠ غٲر ملکی آسن زیادٕ زیادٕ طاقتور سپدان تہٕ توٚہؠ ٲسیٚو پتھ پتھ گژھان۔
\pi
\v 44 تِمن نِش آسن توٚہہ قرض دنہٕ باپتھ پونٛسہٕ، مگر توٚہہ نِش آسن نہٕ تِمن قرض دنہٕ باپتھ پونٛسے۔
\pi تِم آسن توٚہہ نشہٕ برتر تہٕ توٚہؠ ٲسیو تِمو نشہٕ کمتر۔
\p
\v 45 یمہ سارے آفژٕ روزن توٚہہ پٮ۪تھ یوان تہٕ تۅتام روزن یوان یۅتام نہٕ توٚہؠ تباہ سپدیٚو۔ اگر توٚہؠ تہِ کریٚو نہٕ یہ تُہنٛدؠ خدا یہُوواہنؔ توٚہہ کرُن ووٚن تہٕ تِم تمام اصول تہٕ ضٲبطہٕ مٲنیٚو نہٕ یمہٕ تٔمؠ توٚہہ ؤنمٕتؠ چھِ۔
\p
\v 46 یمہٕ آفژٕ کرن توٚہہ تہٕ تُہنٛدین اولادن ہمیشہٕ باپتھ خبردار زِ یم جمٲژ یہُوواہؔ سنٛز نافرمٲنی کران چھےٚ تِمن سٟتؠ کیاہ چُھ سپدان۔
\p
\v 47 چونکہ یہُوواہنؔ کٔر توٚہہ انیٖکھ برکت اوٕ کِنؠ پزِ توٚہہ خوشی سان تس سنٛز خدمت کرٕنؠ مگر توٚہہ کوٚرو نہٕ تہِ۔
\p
\v 48 لہٰذا چھےٚ توٚہہ تِمن دشمنن باپتھ کٲم کرٕنؠ یمہٕ یہُوواہنؔ توٚہہ پٮ۪ٹھ حملہٕ کرنہٕ باپتھ سوزِ۔ توٚہؠ روزیٚو بۅچھِ ۂتؠ تہٕ تریشہٕ ۂتؠ۔ توٚہہ آسن نہٕ نٲلؠ کِتؠ پلو تہِ۔ تہٕ توٚہہ آسہ پرٮ۪تھ کُنہِ چیزٕچ کمی یمِچ توٚہہ ضرورت چھےٚ۔ یہُوواہؔ بناوِ توٚہہ غلام تہٕ تۅتام روزیٚو توٚہؠ محنت کران یۅتام نہٕ سُہ توٚہہ ہلاک کرِ۔\f + \fr 28‏:48 \ft دشمن\f*\f + \fr 28‏:48 \ft توٚہہِ کٔرِو سخٕت ظُلم\f*
\p
\v 49 یہُوواہؔ انہِ سٮ۪ٹھاہ دورِ پٮ۪ٹھٕ توٚہہ خلاف اکھ لشکر یمہ تِژھ زبان بولان آسن یۅسہ نہٕ توٚہؠ سمجھِتھ ہکیٚو۔ تِم کرن تیزی سان توٚہہ پٮ۪ٹھ حملہٕ۔
\v 50 تِم آسن خوفناک۔ تِمن ییہِ نہٕ کٲنٛسہِ پٮ۪ٹھ رحم، لۅکٹٮ۪ن بچن تہٕ بُزرگن لوٗکن پٮ۪ٹھ تیٚنہٕ۔
\v 51 تِم مارن تُہنٛدین چارواین تہٕ کھیٚن، تُہنٛد اناج تہِ کھیٚن تہٕ توٚہؠ روزیٚو پانہٕ بۅچھِ ۂتؠ۔ تمہٕ تھاون نہٕ توٚہہ کیُت کانٛہہ اناج، مےَ، زیتون تیٖل، گٲو یا تیٖر پتھ کُن۔ تہٕ توٚہؠ مٔریٚو بۅچھِ دادِ۔
\p
\v 52 تُہنٛدؠ دشمن انن تُہنٛدین شہرن تمہِ ملکہٕ کِس گیرس منٛز یُس تُہنٛد خدا یہُوواہؔ توٚہہ دنہٕ وول چُھ، تِم والن تُہنٛدین شہرن انٛدؠ انٛدؠ بنٲومٕتؠ مضبوط دیوار، تِم دیوار یِمن پٮ۪ٹھ توٚہہ بھروسہٕ چُھ زِ یِم کرن تُہنٛز حفاظت۔
\p
\v 53 ییٚلہ تُہنٛدؠ دشمن تُہنٛدین شہرن گیرٕ کٔرِتھ آسن تہٕ توٚہؠ ٲسیٚو تیٖتؠ بۅچھِ ۂتؠ یُتھ توٚہؠ پننٮ۪ن کورٮ۪ن تہٕ گۅبرن ہُنٛد ماز کھیٚیو یمہ تُہنٛدؠ خدا یہُوواہنؔ توٚہہ دِتمٕتؠ چھِ۔
\v 54‏-55 ییٚلہ تُہنٛدؠ دشمن تُہنٛدین شہرن گیرٕ کرن تہٕ توٚہہ منٛزٕ یُس سٮ۪ٹھاہ زیادٕ شریف تہٕ حساس نفر آسہ سُتہ کرِ شدید بۅچھِ سٟتؠ کھیٚنٕچ ضرورت محسوس۔ یمہِ کِس نتیجس منٛز سُتہ پننِس بچس مارِ تہٕ تمسُنٛد ماز کھییہِ۔ کھیٚنہٕ خٲطرٕ میلہِ نہٕ بیٚیہِ کِہین۔ تِم دِن نہٕ پننِس بٲیس یا خاندارنہِ یمہ تِمن سٮ۪ٹھاہ ٹٲٹھؠ آسن یا تہنٛدین بچن یمہٕ تۅتام زنٛدٕ آسن اکھ رژھ تہِ تمہِ منٛزٕ کھیٚنہٕ۔
\v 56‏-57 حالانکہ توٚہہ منٛز چھےٚ واریاہ شریف تہٕ ہمدرد زنہِ، یمہ واریاہ مالدار چھےٚ یمہ کِنؠ تمن زانٛہہ تہِ پننہِ گھرٕ نیٚبر نیرنہٕ باپتھ مجبور چھےٚ کرنہٕ آمژِ، تمہٕ تہِ کرن یی۔ ییٚلہ تُہنٛدؠ دشمن تُہنٛدین شہرن گیرٕ کرن تہٕ تِم زنہِ آسن سٮ۪ٹھاہ بۅچھِ ہژٕ، یمہِ کِنؠ تِمہٕ بچس زایُن دِتھ تس ژھۅپہ کرِتھ مارن تہٕ کھیٚن سُہ ماز۔ تہٕ تمہٕ دِن نہٕ تمہِ منٛزٕ پننٮ۪ن خاندارن تہِ کینٛہہ یمن تِم سٮ۪ٹھاہ محبت کران چھِ یا پننِس بیٚیہِ کٲنٛسہِ اولادس۔
\p
\v 58 اگر توٚہؠ وفادٲری سان یمن قانونن ہنٛز پٲروی کٔریٚو نہٕ یِم بہٕ لیٚکھان چُھس، اگر توٚہؠ سٲنس جلٲلی خدا یہُوواہسؔ حدٕ روٚس عزت کٔریٚو نہٕ،
\v 59 تہٕ سُہ دییہ توٚہہِ سزا توٚہہ تہٕ تُہنٛدین اولادن پٮ۪ٹھ مصیبت تہٕ آفژٕ سوزِتھ یمہٕ وری وادن روزن۔
\p
\v 60 سُہ انہِ توٚہہ پٮ۪ٹھ تمہٕ مصیبت یمہٕ تٔمؠ مِصرٕ کٮ۪ن لوٗکن پٮ۪ٹھ أنمٕتؠ چھِ تہٕ توٚہہ میلہِ نہٕ زانٛہہ تہِ شِفا۔
\v 61 سُہ تراوِ توٚہہ پٮ۪ٹھ بیٚیہِ تہِ واریاہ بیمارِ تہٕ دٲدؠ، یِمن متعلق مےٚ یمن قوٲعِدن منٛز ذِکر کٔر نہٕ یۅتام زِ توٚہؠ مٔریٚو تہِ۔
\v 62 توٚہؠ سپدیو آسمان کٮ۪ن تارٕکن ہنٛدؠ پٲٹھؠ بے شمار مگر توٚہہ منٛز روزن کمےٕ کینٛہہ زنٛدٕ اگر توٚہؠ پننِس خدا یہُوواہؔ سنٛز فرمانبردٲری کریٚو نہٕ۔
\p
\v 63 یہُوواہؔ اوس تُہنٛدِ باپتھ رژٕ کامہِ کرِتھ تہٕ تُہنٛزِ آبٲدی منٛز واریاہ ہُریر کرِتھ سٮ۪ٹھاہ خوش، مگر وۅنؠ تراوِ سُہ توٚہہ برباد کرِتھ تہٕ توٚہہ نِش نجات لبِتھے خوشی۔ توٚہہ منٛزٕ یمہ لوٗکھ یمو وُبہو سٟتؠ مرن نہٕ تمہٕ ین یمہِ ملکہٕ منٛزٕ نیٚبر کڈنہٕ یتھ پٮ۪ٹھ توٚہؠ قبضہٕ کرنہٕ باپتھ جلد دٲخل سپدیٚو۔
\p
\v 64 یہُوواہؔ چھکراوِ توٚہہ واریہن لُکہٕ جمٲژن منٛز تمام زمینس پٮ۪ٹھ تہٕ یِمن جاین کٔریٚو توٚہؠ باقی دیوتاہن ہنٛز عبادت یمہ لکٕرِ تہٕ کنٮ۪ن ہنٛدؠ بنیمٕتؠ آسن، تِمن دیوتاہن ہنٛز یمہ نہٕ توٚہہِ تہٕ تُہنٛدیٚو جدٕاجدادو زانٛہہ تہِ زٲنمٕتؠ آسن۔
\p
\v 65 یمن علاقن منٛز میلہ نہٕ توٚہہ سکون۔ توٚہہ آسہ نا امیدی تہٕ پس ہمتی نال ؤلِتھ۔
\v 66 توٚہہ روزِ ہمیشہٕ خوف زِ تُہنٛدؠ دشمن ما مارن توٚہہ۔ توٚہؠ روزیٚو سٲرسےٕ راتس تہٕ سٲرسےٕ دوٚہس خوفس انٛدر۔
\p
\v 67 تکیازِ توٚہؠ چُھو سٮ۪ٹھاہ خوفزدٕ تہٕ توٚہؠ ٲسیٚو یمو ہٲبتناک چیزو سٟتؠ سٮ۪ٹھاہ پریشان یمہٕ توٚہہ وچُھو، پرٮ۪تھ دوٚہہ صبحٲے ؤنیٚو توٚہؠ "کاش شام واتہِ ہے" تہٕ شامس ؤنیٚو توٚہؠ "کاش صبُح پھۅلہِ ہے"
\v 68 یہُوواہؔ سوزِ توٚہہِ منٛزٕ واریہن ٲبی جہازس منٛز مِصر واپس، حالانکہ تٔمؠ چُھ وعدہ کوٚرمُت زِ توٚہؠ یِیو نہٕ دُبارٕ واپس گژھنہٕ باپتھ مجبور کرنہٕ۔ توٚت مِصر وٲتِتھ کٔریٚو توٚہؠ کوشش پننٮ۪ن دشمنن نِش کھیٚن حاصل کرنہٕ باپتھ تِہنٛدؠ غلام بننٕچ مگر توٚہہ ہیٚیہ نہٕ کانٛہہ تہِ مٔلؠ۔"
\c 29
\p
\v 1 یِم ٲسؠ یہُوواہؔ سنٛدِ عہدٕکؠ احکام یمن ہنٛز تعمیل بنی اسرائیل ین لٲزمی کرٕنؠ ٲس۔ ییٚلہ تِم یردن دریاوس مشرقہٕ انٛدٕ موآبؔ علاقس منٛز ٲسؠ تہٕ موسیٰؔ ہن کوٚر تِمن حکم زِ تِم رٹن یِم ضٲبطٕ۔ یمہ ضٲبطٕ بنیاے تمہٕ عہدٕکؠ حصہٕ یمہٕ یہُوواہنؔ تِمن سٟتؠ سیناؔ بالس\f + \fr 29‏:1 \ft حوریب بال چُھ سینا بالس بیاکھ ناو\f* پٮ۪ٹھ کٔرمٕتؠ ٲسؠ۔
\p
\v 2 موسیٰؔ ہن أنؠ سٲری اسرائیلی لوٗکھ سومبرٲوِتھ تہٕ ووٚننکھ، "توٚہہ وچُھو پانہٕ زِ یہُوواہنؔ کیاہ کوٚر مِصرٕ کِس بادشاہ تمسنٛدین عہدٕدارن تہٕ تمسنٛدٕس ملکس سٟتؠ۔
\v 3 توٚہہ وُچھو تِمہ سارے آفژٕ یمہٕ یہُوواہنؔ تِمن پٮ۪ٹھ سوزٕ تہٕ تِم تمام معجزات یمہ تٔمؠ ہٲوؠ۔
\v 4 مگر از تام بنٲوؠ نو نہٕ یہُوواہنؔ توٚہؠ اتھ قٲبل زِ یہ کینٛژھا توٚہہ وُچھو یا بوزو تمیُک مطلب ترِہو فکرِ۔\f + \fr 29‏:4 \ft رومؔ 11:8\f*
\p
\v 5 ییٚلہ توٚہؠ بیابانو منٛزؠ سفر کران ٲسیٚو تہٕ یہُوواہنؔ کٔر توٚہہ ژتجہَن ورؠ ین رہنمٲئی۔ تتھ وقتس دوران پرانیاے نہٕ تُہنٛدؠ پلو تہٕ کھۅربانہٕ۔
\v 6 توٚہہ نِش اوسنہٕ کھیٚنہٕ خٲطرٕ ژۅٹ، مےَ یا چیٚنہٕ باپتھ بیٚیہِ کانٛہہ بنوومُت مشروب، مگر یہُوواہنؔ تھوو تُہنٛد خیال تاکہ توٚہؠ زٲنیٚو زِ سُے چُھ تُہنٛد خدا۔
\p
\v 7 تہٕ ییٚلہِ أسؠ یتھ جایہ وٲتؠ تہٕ حسبون شہرس پٮ۪ٹھ حکومت کرن وول بادشاہ سیحون تہٕ بسن علاقس پٮ۪ٹھ حکومت کرن وول بادشاہ عوجؔ دراے پنُن فوج ہیٚتھ اسہِ پٮ۪ٹھ حملہٕ کرنہِ، مگر اسہِ دیُت تِمن شِکس۔
\v 8 اسہِ نیٚیہ تِہنٛز زمین تہٕ باگرٲو روبن، جد تہٕ منسیؔ سنٛدین نیصف قبیلن منٛز۔
\p
\v 9 لہٰذا کٔریٚو امہ سارے عہدٕچ عبادت وفادٲری سان یُتھ زن توٚہؠ تتھ منٛز کامیٲبی پرٲیو یہ کینٛژھا توٚہؠ کٔریٚو۔
\p
\v 10 از چھِ أسؠ سٲری پننِس خدا یہُوواہسؔ برُونٛہہ کنہِ کھڑا، بہٕ، تُہنٛدین سارنی قبیلن ہنٛدؠ سردار، تُہنٛدؠ بزرگ، تُہنٛدؠ افسر، توٚہؠ تمام اسرائیل لٕکؠ مرٕد،
\v 11 تُہنٛزٕ زنہِ، تُہنٛدؠ شُرؠ تہٕ غٲر ملکی یمہ اسہِ سٟتؠ روزان چھِ، انن سانہِ باپتھ لکٕر ژٔٹِتھ تہٕ بیٚیہِ انن سانہِ خٲطرٕ آب۔
\p
\v 12 توٚہؠ سٲری چُھو از یتؠ یہُوواہسؔ سٟتؠ یہ عہد قبول کرنہٕ باپتھ تہٕ پنُن پان امچہِ پابنٛدی پٮ۪ٹھ رضامنٛد ہاونہٕ باپتھ۔
\v 13 سُہ چُھ توٚہہ سٟتؠ یہ مہادہ اوٕ مۅکھ کران یُتھ یہ یقین سپدِ زِ توٚہؠ چُھو تمسنٛدؠ لوٗکھ، تہٕ سُہ چُھ تُہنٛد خدا۔ یوٚہے چُھ تہِ یہ تٔمؠ تُہنٛدِ باپتھ کرنُک وعدہ کوٚرمُت چُھ، تہٕ یُس وعدہ تٔمؠ تہُنٛدین جدٕاجدادن ابرہامسؔ، اضحاقسؔ تہٕ یعقوبس سٟتؠ کوٚرمُت چُھ، یتھ سُہ پوٗرٕ کرِ۔
\p
\v 14 یہ عہد چُھنہٕ صرف توٚہہِ سٟتؠ۔
\v 15 خدا چُھ یہ مہادٕ اسہِ سٟتؠ یمہٕ از یتہِ چھِ تہٕ سانٮ۪ن اولادن سٟتؠ تہٕ یمہٕ نہٕ وُنہِ زامٕتؠ چھِ۔
\p
\v 16 توٚہہ آسن تمہ کتھٕ یاد یمہ سانیٚو جدٕاجدادو مِصرس منٛز برداش کرِ تہٕ مِصرٕ منٛزٕ نیرنہٕ پتہٕ گےَ تِم تتھ ملکس کُن روانہٕ یُس باقی قومن ہُنٛد اوس۔
\p
\v 17 تتھ ملکس منٛز وُچھ تِمو تمہٕ ووکھٕ پۅتٕلؠ یمہٕ لکٕرِ تہٕ کنٮ۪ن ہنٛدؠ بنٲوِتھ ٲسؠ تہٕ چانٛدِ تہٕ سۅنہٕ سٟتؠ ٲسؠ جٔرِتھ۔
\v 18 لہٰذا روزیٚو حیٚسہٕ زِ از یتہِ موجود کانٛہہ تہ مرد یا زٔنؠ تا کانٛہہ تہِ کُمبہٕ یا قبیلہٕ گژھِ نہٕ سٲنِس خدا یہُوواہؔ سنٛز روگردٲنی کٔرِتھ تِمن لوٗکن ہنٛدین دیوتاہو منٛزٕ کٲنٛسہِ ہنٛز عبادت کرٕنؠ۔ اگر توٚہؠ تہِ کریٚو تمہِ سٟتؠ أنیٚو توٚہؠ پانس زوال۔\f + \fr 29‏:18 \ft رومؔ 8:23\f*
\p
\v 19 پژھ تھٲوؠ زیٚو از چُھنہٕ یتِنس کانٛہہ تہِ شخص یُس نہٕ امہِ عہدٕچ کتھ بوزِتھ پانس یہ ونان آسہ، "مےٚ سٟتؠ سپدِ پرٮ۪تھ کینٛہہ رُتےٕ، چاہے بہٕ ضدٕ سٟتؠ کینٛہہ تہِ کرُن یژھٕ، اگر توٚہؠ تہِ کٔریٚو تہٕ نتیجہ نیرِ یہ زِ یہُوواہؔ کرِ ٲخٕرکار توٚہہ سارنی تباہ، دوٚنونی رٕتٮ۪ن تہِ تہٕ بُرٕ لوٗکن تہِ۔
\p
\v 20 یہُوواہؔ کرِنہٕ یُتھ ضِد تھاون وٲلِس کٲنٛسہِ اکِس معاف۔ امہ بجایہ آسہ سُہ تس شخصس واریاہ ناراض تہٕ تِم تمام لعنتہٕ یمن متعلق مےٚ توٚہہ ووٚن کرِ سُہ تس شخصس پٮ۪ٹھ تۅتام نٲزل، یۅتام نہٕ یہُوواہؔ تس شخصس تہٕ تمسنٛدِس خاندانس ہمیشہٕ باپتھ تباہ کرِ۔\f + \fr 29‏:20 \ft مُکاشفہ 22:18\f*
\v 21 اسرائیل کیٚو تمام قبیلو منٛزٕ کرِ یہُوواہؔ تس شخصس تِمو تمام آفژو باپتھ مقرر یمہٕ مےٚ عہد نامس منٛز درٕج کرِ۔ تِم سارے بُراییہِ آسن تس شخصس سٟتؠ یمِس یہُوواہؔ تِمن قانونن ہنٛز نافرمٲنی کرنس پٮ۪ٹھ لعنت کرِ یمہ مےٚ اتھ دستاویزس پٮ۪ٹھ لیٚچھِ۔
\p
\v 22 ینہٕ والیٚن ورؠ ین دوران وچُھن تُہنٛدؠ اولاد تہٕ باقی ملکن ہنٛدؠ لوٗکھ یِمن آفژن تہٕ بیمارین یمہ یہُوواہنؔ توٚہہ پٮ۪ٹھ نٲزِل کرِ۔
\v 23 تمہٕ وچُھن زِ تُہنٛز سٲرے زمین آسہ شورٕ تہٕ نوٗنہٕ سٟتؠ دٔزِتھ پیمٕژ۔ کِہین تہِ آسہ نہٕ لاگنہٕ آمُت۔ حطاکہِ گاسہٕ تہِ آسہ نہٕ۔ تُہنٛز زمین آسہ سدومؔ، عمورہؔ، ادمہؔ تہٕ زبوئیم شہرٕچہِ زمینہِ ہِش، یمہ یہُوواہنؔ تباہ کٔرؠ ییٚلہ سُہ تِمن لوٗکن پٮ۪ٹھ ناراض سپُد۔\f + \fr 29‏:23 \ft پیدٲیش 19:24 تہٕ 25\f*
\v 24 تہٕ باقی قومن ہنٛدؠ لوٗکھ پرِژھن، زِ یہُوواہنؔ کیازِ کوٚر اتھ ملکس سٟتؠ یہ؟ سُہ کیازِ اوس یتہِ کٮ۪ن روزن والٮ۪ن یوٗت ناراض؟
\p
\v 25 پتہٕ ونن یورٕ باقی لوٗکھ، یہ سپُد اوٕموٚکھٕ تکیازِ تِمو کوٚر سُہ عہد ماننہٕ نشہٕ انکار یُس تِمو یہُوواہؔ خدایس سٟتؠ کوٚرمُت اوس، یمسنٛز عبادت تِہنٛدؠ جدٕاجداد کران ٲسؠ ییٚلہ تٔمؠ تمہٕ مِصرٕ منٛزٕ کٔڈِتھ أنؠ۔
\p
\v 26 تمہِ بجایہ کٔر تِمو باقی معبودن ہنٛز عبادت یِمن ہنٛز عبادت تِمو امہِ برونٛہہ زانٛہہ تہِ کرمٕژ ٲس نہٕ، تِمن دیوتاہن ہنٛز یِمن ہنٛز عبادت کرٕنؠ یہُوواہنؔ تِمن ونمُت اوسنہٕ۔
\v 27 اوٕ کِنؠ سپُد یہُوواہؔ تمہِ ملکہٕ کٮ۪ن لوٗکن پٮ۪ٹھ سٮ۪ٹھاہ ناراض تہٕ تمؠ کرِ تِمن پٮ۪ٹھ تمہ تمام آفژٕ نٲزِل یمن متعلق تِہنٛدؠ قٲیِدن تمہ خبردار کٔرؠ مٕتؠ ٲسؠ۔
\v 28 یہُوواہؔ سپُد تِمن پٮ۪ٹھ سٮ۪ٹھاہ غضبناک تہٕ تِمہ ملکہٕ منٛزٕ کڈِتھ ژھنِتھ چھکِن تِم بییِس ملکس منٛز، تہٕ ونیُک تام چھِ تِم تٔتؠ۔\f + \fr 29‏:28 \ft امیُک پس منظر اوس شاید بابلی قٲدُک دور۔\f*
\p
\v 29 کینٛہہ کتھٕ چھےٚ تمہٕ یمہٕ سٲنؠ خدا یہُوواہنؔ پوشیدٕ تھاوِ، مگر تٔمؠ کٔرؠ اسہِ پٮ۪ٹھ پنٕنؠ قانون نٲزِل، تہٕ سُہ چُھ اسہِ تہٕ سانٮ۪ن اولادن نِش ہمیشہٕ باپتھ تِمن ہنٛز تعمیل کرنُک توقع کران۔
\c 30
\p
\v 1 موسیٰؔ ہن ووٚن اسرائیل ین مزید، "وۅنؠ ووٚن مےٚ توٚہہ تِمن طریقِ کارن متعلق یمو سٟتؠ سون خدا یہُوواہؔ توٚہہ برکت کرِ اگر توٚہؠ تمؠ سنٛز فرمانبردٲری کٔریٚو تہٕ سۅ وتھ تہِ یمہِ سٟتؠ سُہ توٚہہ لعنت نٲزِل کرِ اگر توٚہؠ تس سنٛز نافرمٲنی کٔریٚو۔ اگر توٚہؠ تمسنٛدین قانونن پٮ۪ٹھ عمل نہ کرنُک فٲصلہٕ نِیو، تہٕ اکہ دوٚہہ ٲسیٚو توٚہؠ تِمن ملکن منٛز یتہِ سُہ توٚہہ منتشِر کرِ، تہٕ توٚہہ پییہِ یاد زِ مےٚ کیاہ ونیومو توٚہہِ۔
\v 2 پتہٕ اگر توٚہؠ تہٕ تُہنٛدؠ بچہٕ سٲنِس خدا یہُوواہؔ سنٛز عبادت کرنہِ لگن تہٕ تِمن سارنی چیزن پٮ۪ٹھ وفادٲری سان عمل کرن یِمن ہُنٛد مےٚ توٚہہ از حکم دیُت،
\v 3 سُہ کرِ تیٚلہِ توٚہہِ پٮ۪ٹھ رحم۔ سُہ انہِ توٚہہ تیٚلہ تِمو قومو منٛزٕ واپس یِمن منٛز توٚہؠ تٔمؠ پراکنٛدٕ کٔرؠ نو، تہٕ سُہ بناوِ توٚہہ بیٚیہِ خوشحال۔
\p
\v 4 اگر توٚہؠ زمیٖنس پٮ۪ٹھ دور دراز جاین منٛز چھکرِتھ ٲسیو توتہِ انیٚو سون خدا یہُوواہؔ توٚہہ سومبراوِتھ تہٕ پتہٕ انیٚو پننِس ملکس منٛز واپس۔\f + \fr 30‏:4 \ft متی 24:31\f*
\v 5 سُہ بناوِ توٚہہ بیٚیہِ تتھ ملکس پٮ۪ٹھ قبضہٕ کرنس قٲبل یتہٕ تُہنٛدؠ جدٕاجداد روزان ٲسؠ۔ تہٕ سُہ بناوِ توٚہہ مذید خوشحال تہٕ تُہنٛدِس تعدادس منٛز کرِ واریاہ ہُریر۔
\p
\v 6 سون خدا یہُوواہؔ بدلاوِ تُہنٛد اُندرون تمیُک نتیجہٕ نیرِ یہ زِ توٚہؠ کٔریٚو تمِس سٟتؠ دِل و جانہٕ محبت۔ تہٕ پتہٕ روزیٚو مُتوٲتِر تٔتھؠ ملکس منٛز۔\f + \fr 30‏:6 \ft رومؔ 2:29\f*
\v 7 سون خدا یہُوواہؔ کرِ تِم تمام آفژٕ تُہنٛدین دشمنن تہٕ توٚہہ پٮ۪ٹھ ظلم کرن والٮ۪ن پٮ۪ٹھ نٲزِل یِمن متعلق مےٚ توٚہہِ ووٚن۔
\v 8 یہ توٚہہ برُونٛہہ کوٚرو تی کٔرؠ زیٚو یہ یہُوواہؔ توٚہہ کرناون یژھان چُھ، تہٕ توٚہؠ کٔرؠ زیٚو تِمن تمام احکامن ہنٛز تعمیل یمہٕ مےٚ توٚہہ از دِتؠ۔
\p
\v 9 سون خدا یہُوواہؔ کرِ توٚہہ تمام کامیٚن منٛز برکت یمہٕ توٚہؠ کٔریٚو۔ توٚہہ آسن واریاہ اولاد تہٕ واریاہ چو چاروٲے تہٕ توٚہؠ وۅپدٲیو واریاہ فصٕل۔ تَس سپدِ بیٚیہِ اکہِ پھرِ خوشی توٚہؠ خوشحال بنٲوِتھ۔ بلکُل تِتھے پٲٹھؠ یتھٕ پٲٹھؠ تٔمؠ تُہنٛدؠ جدٕاجداد خوشحال بنٲوِتھ خوشی پرٲو۔
\v 10 مگر سُہ کرِ یہ تیٚلہ ییٚلہ توٚہؠ تہِ کریٚو یہ تٔمؠ توٚہہِ کرُن ووٚن، تہٕ صرف تیٚلہ ییٚلہ توٚہؠ تِمن تمام اصولن تہٕ قواعدن پٮ۪ٹھ عمل کٔریٚو یمہٕ مےٚ اتھ کتابہِ منٛز لیٚکھؠ، تہٕ صرف اتھ صورتس منٛز ییٚلہ توٚہؠ پرٮ۪تھ رنٛگہٕ تہٕ دِلہٕ جانہٕ یہُوواہسؔ کُن رجوع کٔریٚو۔
\p
\v 11 یمہٕ احکام بہٕ توٚہہ از دِوان چُھس تِمن ہنٛز تعمیل کرٕنؠ چھنہٕ تُہنٛدِ باپتھ زیادٕ مشکل تہٕ تِم زانٕنؠ تہِ چھنہٕ مشکِل۔\f + \fr 30‏:11 \ft 1 جان 5:3\f*
\v 12 تِم چھنہٕ آسمانس منٛز ژوٗرِ۔ توٚہہ چھنہٕ یہ وننٕچ ضرورت زِ سانہِ باپتھ کُس کھسہِ آسمانس پٮ۪ٹھ تہٕ تتہِ والہِ سانہِ باپتھ تِمہ تہٕ أسؠ ہیٚچھو؟
\p
\v 13 تہٕ تمہٕ چھنہٕ سمندرس اپارِ۔ تہٕ توٚہہ پییہِ نہٕ یہ وننُک ضرورت زِ کُس ترِ سمندرس اپور تہٕ تتہِ انہ سانہِ خٲطرٕ یِم، یُتھ زن أسؠ تمہ ہیٚچھو؟
\v 14 نہ، تمسنٛدؠ احکام چھِ توٚہہ سٟتؠ، توٚہؠ چُھو تِم زانان، تہٕ توٚہؠ ہکیٚو تِم بار بار دُہرٲوِتھ۔ تہٕ توٚہؠ ہکیٚو آسٲنی سان تِم اپنٲوِتھ۔\f + \fr 30‏:14 \ft رومؔ 10:6\f*
\p
\v 15 ؤلیٚو بوزیٚو! از چُھسو بہٕ توٚہہ اجازت دِوان زِ توٚہؠ کٔریٚو پانے اصلیٚن تہٕ بُرٕ کامیٚن درمیان فرق، کۅسہٕ کٲم تھاوِ توٚہہ واریہس وقتس زنٛدٕ تہٕ کۅسہٕ واتناوِ توٚہہ جوٲنی منٛزےٕ مزاربل۔
\v 16 بہٕ چُھسو بیٚیہِ ونان زِ اگر توٚہؠ سٲنِس خدا یہُوواہؔ سنٛدؠ احکام مٲنیٚو یمہٕ بہٕ از توٚہہ دِوان چُھس، اگر توٚہؠ تمِس سٟتؠ محبت تھٲیو تہٕ پنٕنؠ زندگی تِتھے پٲٹھؠ پکنٲیو یتھ کنؠ سُہ یژھان چُھ، اگر توٚہؠ تمسنٛدؠ تمام اصول تہٕ قانون مٲنیٚو۔ توٚہؠ روزیٚو خوشحال تہٕ توٚہہ گژھیٚو کٲفی ہُریر، سون خدا یہُوواہؔ کرِ توٚہہ تتھ ملکس منٛز برکت یتھ منٛز توٚہؠ اژن وٲلؠ تہٕ یتھ توٚہؠ قبضہٕ کرن وٲلؠ چُھو۔
\p
\v 17 مگر وۅنؠ اگر توٚہؠ یہُوواہؔ سنٛز عبادت کرٕنؠ ترٲیو، تہٕ یہ کینٛژھا سُہ ونان چُھ تہِ ماننہٕ نِشہ کٔریٚو انکار، تہٕ باقین اجازت دِیو زِ توٚہؠ کرِو باقین معبودن ہنٛز عبادت،
\v 18 تہٕ بہٕ چُھسو از توٚہؠ خبردار کران زِ توٚہؠ مٔریٚو جلدےٕ۔ تُہنٛدؠ لوٗکھ روزن نہٕ زیادٕ کالس یتھ ملکس منٛز زنٛدٕ یتھ منٛز توٚہؠ دٲخل سپدِتھ تہٕ یردن دریاوس تار دِتھ قبضہٕ کرن وٲلؠ چُھو۔
\p
\v 19 بہٕ چُھس آسمان تہٕ زمینس پٮ۪ٹھٕ روزن والٮ۪ن پرٮ۪تھ أکِس عرضی کران زِ سُہ روزِ مےٚ گواہ، زِ از چُھسو بہٕ توٚہہ یہ فٲصلہٕ نِنُک اجازت دِوان زِ توٚہؠ چُھوا زیادٕ وقتس زندٕ روزُن یژھان کِنہٕ جلدےٕ مرٕنؠ یژھان، یا توٚہؠ چُھوا یہُوواہؔ سنٛز برکت یژھان کِنہٕ توٚہؠ چُھو تمؠ سنٛز لعنت نٲزل گژھٕنؠ یژھان۔ پانے کٔریٚو زندگی ہُنٛد فٲصلہٕ۔
\v 20 سٲنِس خدا یہُوواہسؔ سٟتؠ محبت تھاوُن تہٕ تمؠ سنٛزِ فرمانبردٲری کرنُک کٔریٚو فٲصلہٕ۔ اگر توٚہؠ یہ کریٚو تہٕ توٚہؠ تہٕ تُہنٛدؠ اولاد روزن یتھ ملکس منٛز واریہس وقتس زنٛدٕ یمیُک یہُوواہنؔ تُہنٛدین جدٕاجدادن ابرہامسؔ، اضحاقسؔ تہٕ یعقوبسؔ سٟتؠ وعدہ کوٚرمُت چُھ زِ سُہ دییہِ تِمن۔
\c 31
\p
\v 1 ییٚلہِ موسیٰؔ ہن اسرائیل ین تہِ سورےٕ ؤنِتھ مۅکلوو،
\v 2 بہٕ چُھس اکھ ہتھ تہٕ وُہہ وۅہُر۔ بہٕ ہیٚکہٕ نہٕ وۅنؠ تِمن سارنی جاین گٔژھِتھ یوٚت توٚہہ ضروری گژُھن چُھ، لہٰذا ہیٚکہٕ نہٕ وۅنؠ تُہنٛد رہنما بنِتھ۔ بیٚیہِ یتہِ زِ یہُوواہنؔ ووٚن مےٚ یتہ زِ بہٕ گژھٕ نہٕ یردن دریاوس اپور ترُن۔
\v 3 مگر سون خدا یہُوواہؔ نیرِ توٚہہِ برُونٛہہ۔ سُہ بناوِ توٚہہ تتہِ روزن والٮ۪ن قومن تباہ کرنس قٲبل، تاکہِ توٚہؠ کٔرِو تہنٛدِس زمینس قبضہٕ۔ یشوعؔ کرِ توٚہہ رہنمٲئی، یہ یہُوواہنؔ مےٚ گۅڈے ووٚن۔
\p
\v 4 یہُوواہؔ کرِ تِمن قومن سٟتؠ تی یہ تمؠ عمور قومہٕ کٮ۪ن دوٚن بادشاہن سیحونسؔ تہٕ عوجسؔ سٟتؠ کوٚر ییٚلہ تٔمؠ تِہُنٛد فوج تہٕ قوم تباہ کوٚر۔
\v 5 یہُوواہؔ بناوِ توٚہہ تِمن لوٗکن ہنٛزٕ جمٲژ فتح کرنس قٲبل، مگر توٚہہ پزن تِم سٲری لوٗکھ قتل کرٕنؠ، یمیُک مےٚ توٚہہ حکم کوٚرمُت چُھ۔
\v 6 بہودُر تہٕ پُر اعتماد روزیٚو۔ تِمن لوٗکن مہٕ کھۅژیٚو۔ یہ مشرٲزیٚو نہٕ یہُوواہؔ چُھ سون خدا یُس توٚہہِ سٟتؠ گژھِ۔ سُہ کریٚو توٚہہ ہمیشہٕ مدد تہٕ توٚہہ ترایو نہٕ زانٛہہ۔"
\p
\v 7 پتہٕ اوٚن موسیٰؔ ہن یشوعؔ پانس نِش ناد دِتھ تہٕ ووٚننَس، "حوصلہٕ تہٕ اعتماد تھاو، ژےٕ چُھکھ یُس یِمن لوٗکن تتھ ملکس منٛز نیٚیہ یُس دِنُک یہُوواہنؔ سانٮ۪ن جدٕاجدادن سٟتؠ وعدہ کوٚرمُت چُھ۔ تہٕ ژٕ بناوہکھ تِم تتھ قبضہٕ کرنس قٲبل۔\f + \fr 31‏:7 \ft عبر 4:8\f*
\v 8 یہ چُھ یہُوواہؔ یُس توٚہہ برُونٛہہ نیرِ۔ سُہ روزِ توٚہہِ سٟتؠ۔ سُہ کرِ توٚہہ ہمیشہٕ مدد۔ سُہ تراوِ نہٕ توٚہہ زانٛہہ۔ لہٰذا مہٕ کھۅژیٚو، یا مہٕ بانٛبریٚو۔"
\p
\v 9 موسیٰؔ ہن لیکھؠ تِم تمام قانون تہٕ طُمار دتِنؠ کاہنن یمہٕ مقدس صندوق ہیٚتھ ٲسؠ۔ تمؠ دِتؠ یِم طُمار تمام اسرائیلی بزرگن تہِ۔
\v 10 پتہٕ دیُت موسیٰؔ ہن یِمن کاہنن تہٕ زِٹھٮ۪ن حکم، "پرٮ۪تھ ستہِ وہرؠ ٲخرس پٮ۪ٹھ، ییٚلہ تمام قرضہٕ معاف سپدِ، پٔرؠ زیٚو یمہٕ تمہِ وقتہٕ ییٚلہ لوٗکھ خٟمہٕ عید مناوان آسن۔
\p
\v 11 یہ پٔرؠ زیٚو سارنی اسرائیلی لوٗکن نِش ییٚلہ تِم تتھ جایہِ جمع آسن یۅسہ یہُوواہنؔ پننہِ عبادتہٕ باپتھ ژٲرمٕژ آسہ۔
\v 12 پرٮ۪تھ کانٛہہ کٔرؠ زیٚون جمع مرٕد، زنہِ بچہٕ، تمہٕ غٲر ملکی تام تہِ یمہٕ تُہنٛدین شہرن منٛز روزان آسن، تاکہِ تِم بوزن تِم قانون تہٕ ہیٚچھن زِ سٲنِس خدا یہُوواہسؔ زبردس احترام کرُن، تہٕ وفادٲری سان پرٮ۪تھ کتھ پٮ۪ٹھ عمل کرٕنؠ۔ یہ یمن قانونن منٛز لیٚکھِتھ چُھ۔
\v 13 اگر تِم یہ کرن تہٕ تُہنٛدؠ اولاد یمو نہٕ یِم قانون زانٛہہ تہ بوزؠ مٕتؠ آسن تہٕ بوزن، تہٕ یتہِ ہیٚچھن زِ سٲنِس خدا یہُوواہسؔ چُھ اکھ عظیم احترام، تِمن تمام ورین دوران یِمن تِم اتھ ملکس منٛز روزن یتھ پٮ۪ٹھ توٚہؠ یردن دریاوس تار دِتھ قبضہٕ کرن وٲلؠ چُھو۔"
\p
\v 14 پتہٕ ووٚن یہُوواہنؔ موسیٰؔ ہس، "غورٕ سان بوز۔ ژٕ مرکھ جلدےٕ۔ یشوعؔ انُن ناد دِتھ، تہٕ ژٕ گژھِ تس سٟتؠ مقدس خٟمس منٛز، تاکہ بہٕ کرن سُہ نُو سربراہ مقرر۔ لہٰذا گےَ یشوع تہٕ موسیٰؔ مقدس خٟمس منٛز۔
\p
\v 15 تتہِ گو یہُوواہؔ تِمن ابرٕ لنٛگین منٛز ظٲہِر تہٕ سُہ ابُر اوس خٟمہٕ کٮ۪ن دروازن تام۔
\v 16 یہُوواہنؔ ووٚن موسیٰؔ ہس، "ژٕ مرکھ جلدےٕ۔ پتہٕ کرن یِم لوٗکھ مےٚ بے وفٲیی۔ تِم ژھنن یِمن عہدن پٮ۪ٹھ عمل کرٕنؠ ترٲوتھےٕ یِم مےٚ یِمن سٟتؠ کرمٕتؠ چھِ۔ تِم کرن تِمن غٲر ملکی دیوتاہن ہنٛز عبادت کرٕنؠ شروع یہنٛز پوٗزا یمہ ملکٕکؠ لوٗکھ کران چھِ یوٚت تِم دٲخل سپدن۔
\p
\v 17 ییٚلہ یہ سپدِ تہٕ بہٕ گژھٕ تِمن سٮ۪ٹھاہ ناراض۔ بہٕ ژھنکھ تِم ترٲوتھےٕ تہٕ تِمن مذید مدد کرنہٕ نشہٕ روزٕ پتھ۔ تِمن ین واریاہ بُراییہِ ولنہٕ، تہٕ تِم سپدن تباہ۔ پتہٕ ونن تِم پانہٕ وٲنؠ، "اسہِ سٟتؠ چُھ یہ اوٕ کِنؠ تہِ سپدان تکیازِ سون خدا چُھنہٕ وۅنؠ اسہِ سٟتؠ۔
\v 18 تہٕ تِمو تمام بُرٕ کامیٚو سببہٕ یمہٕ تِمو کرِ، تہٕ خاص کر امہِ موٚکھٕ زِ تِمو کٔر باقی خداین ہنٛز عبادت کرٕنؠ شروع۔ بہٕ روزٕ تِمن مدد کرنہٕ نشہٕ پتھ۔
\p
\v 19 اے موسیٰؔ، بہٕ بوزناوتھ ژٕ اکھ بٲتھ۔ یہ لیٚکھ ژٕ اکِس طُمارس پٮ۪ٹھ تہٕ ہیٚچھنٲوؠ ووکھ اسرائیل لٕکؠ لوٗکھ تہٕ کٔرؠ ووکھ زبٲنی یاد۔ یہ روزِ تِہنٛدین الزامن اکھ گوٲہی ہِش۔
\v 20 بہٕ چُھس تِم أکِس انتہٲیی ذرخیز زمینس کُن ننہٕ وول، اکھ تِژھ زمین یمیُک مےٚ تِہنٛدین جدٕاجدادن سٟتؠ تمن دِنُک وعدہ کوٚرمُت چُھ۔ تتہِ میلہ تِمن کھیٚنہٕ باپتھ واریاہ کینٛہہ، یمیُک نتیجہٕ یہ نیرِ زِ تِمن روزِ ہمیشہٕ سیری تہٕ تِم گژھن مۅٹؠ۔ مگر پتہٕ کرن تِم باقی معبودن کُن رجوع تہٕ لاگن تِہنٛز عبادت کرٕنؠ تہٕ مےٚ حقیر زٲنِتھ پُھٹراون سُہ عہد یُس مےٚ تِمن سٟتؠ کوٚرمُت چُھ۔\f + \fr 31‏:20 \ft ذرخیز زمین\f*
\p
\v 21 تہٕ تِمن ین واریاہ بٔڈؠ مصیبت پیش۔ تہٕ تمہِ پتہٕ کرن تِہنٛدؠ اولاد یہ بٲتھ یاد، تہٕ یہ آسہ تمِس گواہ سنٛدؠ پٲٹھؠ یُس ونان چُھ، "وۅنؠ چُھو توٚہؠ زانان زِ یہُوواہنؔ کیازِ دیُت تُہنٛدین جدٕاجدادن سزا، بہٕ نِمکھ جلدےٕ تِم تتھ ملکس منٛز واپس یُس دِنُک وعدہ مےٚ تِمن کوٚرمُت چُھ؛ مگر وُنہ تہِ چُھس بہٕ یہ کرنہ برُونٛہہ یہ زانان زِ تِم کیاہ چھِ سونچان زِ تتہِ روزِتھ کیاہ کرن تِم۔"
\v 22 چنانچہِ یمہِ دوٚہہ یہُوواہنؔ موسیٰؔ ہس سُہ بٲتھ دیُت، موسیٰؔ ہن ہیٚچھنٲوؠ اسرائیل لٕکؠ لوٗکھ۔
\p
\v 23 پتہٕ کوٚر یہُوواہنؔ یشوع سردار مقرر تہٕ دیُتنس حکم، "بہودُر بن تہٕ اعتماد تھاو، تکیازِ ژٕ نِہکھ اسرائیلی لوٗکھ تتھ ملکس منٛز یمیُک مےٚ وعدہ کوٚرمُت چُھ زِ بہٕ دِمہٕ تِمن۔ تہٕ بہٕ روزٕ توٚہہِ سٟتؠ۔"
\p
\v 24 موسیٰؔ ہن مۅکلٲوؠ تمام قانون طُمارن پٮ۪ٹھ لیٚکھِتھ۔
\v 25 پتہٕ ووٚن موسیٰؔ ہن لاوی ہنٛدین اولادن یِمن اتھِ مقدس صندوق اوس یتھ منٛز داہ احکام ٲسؠ،
\v 26 "یہ طُمار نِیو یتھ پٮ۪ٹھ یِم داہ قانون لیٚکھِتھ چھِ تہٕ یہ تھٲیو ہُتھ صندوقس نِش یتھ منٛز سٲنِس خدا یہُوواہؔ سنٛدؠ عہدنامہٕ چھِ یِم تٔمؠ توٚہہِ سٟتؠ گنٛڈمٕتؠ چھِ۔ تاکہ تِم روزن یتھ کتھِ گواہ زِ یہُوواہؔ کیاہ کرِ تِمن لوٗکن سٟتؠ یِم تمؠ سنٛز نافرمٲنی کرن۔\f + \fr 31‏:26 \ft یشوع 5:45\f*
\p
\v 27 بہٕ چُھس یہ اوٕ موٚکھٕ ونان تکیازِ بہٕ چُھس زانان زِ یِم لوٗکھ چھِ واریاہ ضِدی۔ یۅتام بہٕ یِمن سٟتؠ رودُس یِمو کٔر یہُوواہسؔ سٟتؠ بغاوت، تہٕ میانہِ مرنہٕ پتہٕ کرن یِم بیٚیہِ تہِ روگردٲنی۔
\v 28 لہٰذا کٔرووکھ قبیلن ہنٛدؠ تمام زِٹھؠ تہٕ پنٕنؠ افسر جمع تاکہِ بہٕ تارٕ تِمن امہِ بٲتٕکؠ لفظ فِکر تہٕ یِم آسمانس تہٕ زمینہِ پٮ۪ٹھ چھِ تِمن سارنی کرٕ بہٕ درخواس زِ تِم دِن یمن لوٗکن خلاف گوٲہی۔
\v 29 بہٕ چُھس یہ اوٕ موٚکھٕ ونان تکیازِ بہٕ چُھس زانان زِ یِم لوٗکھ کرن میانہِ مرنہٕ پتہٕ واریاہ بدکٲری۔ تِم تراون تہِ سورےٕ کرُن یمیُک مےٚ تِمن حکم کوٚر۔ تہٕ آینٛدٕ کرن تِم یمو تمام بُرٕ کامیٚو سٟتؠ یہُوواہسؔ سٮ۪ٹھاہ ناراض۔ پتہٕ کرناوِ سُہ تِمن مختلف آفژن ہُنٛد مقابلہٕ۔
\p
\v 30 تمہِ وزِ ییٚلہ سٲری اسرائیلی لوٗکھ بوزان ٲسؠ تہٕ موسیٰؔ ہن گیُو تہنٛدِ باپتھ یہ سورےٕ بٲتھ۔
\c 32
\q
\v 1 اے آسمان کیٚو روزن والیٚو، میٚون بوزیٚو،\f + \fr 32‏:1 \ft یہِ بٲتھ چُھ اکہِ الزامٕکؠ پٲٹھؠ یُس خدا پننٮ۪ن لوٗکن خلاف عدالتَس منٛز چُھ انان۔\f*
\q اے زمیٖنس پٮ۪ٹھ بسن والیٚو، میٚون بوزیٚو،
\q
\v 2 یژھان چُھس میٚون بٲتھ بٔنِن تُہنٛد مددگار پیٚنہٕ والہِ روٗدٕکؠ پٲٹھؠ،
\q یا صبحک زمیٖنس پٮ۪ٹھ پیٚنہٕ والہِ شبنمٕکؠ پٲٹھؠ،
\q یا لاوین کُلیٚن پٮ۪ٹھ صبہٕچ رُدٕ لوٕ پیٚنٕکؠ پٲٹھؠ،
\q تہٕ سبزارس پٮ۪ٹھ پیٚنہٕ والہِ تیز بارانٕکؠ پٲٹھؠ،
\q
\v 3 بہٕ کرٕ یہُوواہؔ سنٛدؠ تعریف۔
\q تہٕ توٚہؠ سٲری کٔریٚو تمسنٛدؠ تعریف سون خدا کوتاہ عظیم چُھ۔
\q
\v 4 سُہ چُھ زنتہٕ اکھ کٔنؠ یتہ پٮ۪ٹھ أسؠ سٲری محفوض چھِ۔\f + \fr 32‏:4 \ft رومؔ 9:14\f*
\q یہ سُہ کران چُھ تہِ چُھ سیٚود تہٕ پوٗرٕ انصافہٕ بۅرُت۔
\q سُہ چُھ ہمیشہ تہِ کران یہ کرُن ونان چُھ،
\q سُہ چُھنہٕ تہِ زانٛہہ کران یہ غلط بنان چُھ۔
\q
\v 5 مگر توٚہؠ اسرائیلی چُھو تس بے وفٲیی کران۔\f + \fr 32‏:5 \ft متی 17:17\f*
\q تُہنٛدیٚو گُنہو کِنؠ چُھو نہٕ توٚہؠ تسنٛدؠ اولاد بنٕنؠ لایکھ،
\q توٚہؠ چُھو سٮ۪ٹھاہ دونٛکھٕ باز تہٕ بدکار۔
\q1
\v 6 اے احمقو تہٕ نادان لوٗکو،
\q یوٚہے چھا وطیرٕ یہُوواہسؔ تِمن سارنےٕ چیزن ہُنٚد بدلہٕ دِنُک یمہ تٔمؠ تُہنٛدِ باپتھ کٔرؠ؟
\q سُہ چُھ تُہنٛد مول؛ یمؠ توٚہہ وجود دیُتنو؛
\q سُے چُھ یمؠ توٚہؠ اکھ قوم بنٲوؠ نو۔
\q
\v 7 ہنا سونٛچو پتھ کُن کیاہ سپُد۔
\q غور کریٚو تُہنٛدین جدٕاجدادن سٟتؠ کیاہ سپُد؟
\q پننٮ۪ن مالیٚن پرِژھیٚو، تمہٕ وننو۔
\q بُزرگن پرِژھیٚو، تِم وننو۔
\q
\v 8 ییٚلہ خداین یُس ساروےٕ کھۅتہٕ تھوٚد تہٕ بوٚڈ چُھ واریاہ برُونٛہہ لوٗکھ جمٲژن منٛز تقسیم کٔرؠ،
\q تٔمؠ کٔر پرٮ۪تھ قومس پنٕنؠ زمین عطا۔
\q تٔمؠ کوٚر یہ طے زِ کۅسہٕ جماتھ کتہِ روزِ،
\q تہٕ پرٮ۪تھ جماتھ تھٲون پننِس خدایس سٟتؠ گنٛڈِتھ۔\f + \fr 32‏:8 \ft اعمال 17:26\f*
\q
\v 9 مگر یہُوواہنؔ کوٚر فٲصلہٕ، أسؠ آسو تمسنٛدی لوٗکھ؛
\q تٔمؠ ژٲرؠ أسؠ یعقوب سنٛدؠ زُرؠ، پننٮ۪ن منٛز۔
\q
\v 10 تٔمؠ وُچھ سٲنؠ جدٕاجداد تمہِ وزِ ییٚلہ تِم بیابانن منٛز ٲسؠ،
\q تہٕ تتھ ملکس منٛز پھیران ٲسؠ یُس وٲران اوس۔
\q تٔمؠ کٔر تِمن حفاظت تہٕ تِہنٛز رٲچھ راوٕٹ،
\q تِتھٕ پٲٹھؠ یتھٕ کنؠ کانٛہہ پننٮ۪ن أچھن رٲچھ کران چُھ۔
\q
\v 11 یہُوواہنؔ کٔر پننٮ۪ن لوٗکن ہنٛز حفاظت یتھٕ پٲٹھؠ اکھ عُقاب پننٮ۪ن بچن وُڈو کرُن ہیٚچھٕ ناوان چھےٚ،
\q تِمن ژنٛجہ لایان چھےٚ،
\q پننہِ پکھٕ پھٲلاوِتھ تِمن ؤسؠ پیٚنہٕ نشہٕ بچاوان چھےٚ۔
\q
\v 12 صرف اوس یہُوواہؔ یمؠ تِمن رہنمٲئی کٔر۔
\q کٲنٛسہِ پردیسی خداین کوٚر نہٕ تِمن مدد۔
\q
\v 13 ییٚلہ تِم تتھ ملکس منٛز داخٕل سپدؠ یمیُک یہُوواہنؔ تِمن وعدہ اوس کوٚرمُت۔
\q یہُوواہنؔ بنٲوؠ تِم پہٲڑی ملکن پٮ۪ٹھ حکومت کرنس قٲبل۔
\q تِمو کھیٚو کھہَن منٛز ۅپدن وول اناج،
\q تِمو لوٚب کنیٚو منٛزٕ مانٛچھ،
\q تہٕ تتھ کنہِ دار زمینس وۅپدیاے زیتون کُلؠ تہِ۔
\q
\v 14 گٲوو تہٕ ژھاوجو دیُت تِمن بسیار زامُت دۅد؛
\q تِمو رٔچھؠ بہتر پٲٹھؠ تیٖر تہٕ ژھاولؠ،
\q تِمن نِش اوس واریاہ بہتر کٕنکھ،
\q تہٕ تِمو بنوو پننہِ دچھِ میوٗٹھ شراب،
\q
\v 15 اسرائیلی لوٗکھ بنیو گُذارٕ تہٕ خۅشحٲلی،
\q مگر پتہٕ کٔر تِمو خدایس سٟتؠ بغاوت؛
\q تِمو تُروو سُہ پتھ کُن، یمؠ تمہ پٲدٕ کٔرؠ،
\q سُہ یمؠ تمہٕ پننہِ طاقتہٕ سٟتؠ بچٲوؠ،
\q
\v 16 تٔمؠ ژھٕنؠ تمہٕ ترٲوتھےٕ تکیازِ تِمو لٲج دوٚیمین معبودن ہنٛز عبادت کرٕنؠ۔
\q تِہنٛدین مکرُو دیوتاہن ہنٛز عبادت کرنہٕ سٟتؠ کھوٚت تس شرارتھ۔
\q
\v 17 تِمو کرِ تِمن دیوتاہن قربٲنیہ پیش یمہٕ پزی شیطٲنی ٲسؠ،
\q تِمن دیوتاہن یمہٕ نہٕ تہنٛدیٚو جدٕاجدادو زانٛہہ تہِ زٲنمٕتؠ ٲسؠ۔
\q تِمن دیوتاہن یِمن نہٕ تُہنٛدؠ جدٕاجداد زانٛہہ احترام کران ٲسؠ۔\f + \fr 32‏:17 \ft 1 کورنتھ 10:20\f*
\q
\v 18 تِمو مٔشروو پوٚز خدا، یُس تِمن رٲچھ کران چُھ،
\q یمؠ خداین تِم پٲدٕ کٔرؠ تہٕ زنٛدٕ تھٲوؠ۔\f + \fr 32‏:18 \ft عبر 1:2\f*
\q
\v 19 ییٚلہ یہُوواہنؔ وُچھ زِ تِمو ژُھن ہس بہٕ ترٲوِتھ، تمِس کھوٚت سخت شرارتھ،
\q تہٕ تٔمؠ کٔرؠ اسرائیلی لوٗکھ رَد یمہٕ تس کورِ تہٕ گۅبر ہی ٲسؠ۔
\q
\v 20 تٔمؠ ووٚن، "یمہٕ چھِ بڈٕ روگردان، تہٕ بے وفا لوٗکھ؛
\q لہٰذا کرنہٕ بہٕ وۅنؠ یِمن کانٛہہ مدد،
\q تہٕ پتہٕ وُچھٕ بہٕ، نظر تھاوٕ زِ یمن سٟتؠ کیاہ سپد،\f + \fr 32‏:20 \ft متی 17:17\f*
\q
\v 21 تکیازِ یمہٕ چھِ وۅنؠ بُت پرستی کران، یمہٕ نہٕ پٔزؠ خدا چھِ،
\q یمو بنووٕہس بہٕ اکھ باغٲرت خاندار ہیٚوٗ تکیازِ بہٕ اوسُس یژھان زِ یِم گٔژھؠ صرف میٲنؠ عبادت کرٕنؠ۔
\q تہٕ وۅنؠ چُھس بہٕ تِمن ژَکھ کھالنہٕ باپتھ،
\q وۅنؠ سوزن بہٕ اکہ شِکس لد تہٕ بے وقوف قومُک فوج تِمن پٮ۪ٹھ حملہٕ کرنہٕ باپتھ۔\f + \fr 32‏:21 \ft رومؔ 11:11\f*
\q
\v 22 مےٚ چُھ سٮ۪ٹھاہ شرارتھ، بہٕ کرکھ تِم تباہ، تمہِ نارٕکؠ پٲٹھؠ یُس دزان دزان تل پتال وسہِ۔
\q سُہ نار کرِ زمیٖنس تہٕ تتھ پٮ۪ٹھ ۅپدن وٲلؠ تمام چیز تباہ۔
\q تہٕ سُہ زالہِ تِم چیز تہِ یمہ پہاڑن تل آسن۔
\q
\v 23 بہٕ تراوٕ تِمن پٮ۪ٹھ واریاہ آفژٕ۔
\q تِمن باسہِ زِ زنتہٕ چُھس بہٕ پنٕنؠ سٲری تیٖر تِمن پٮ۪ٹھ چلاوان۔
\q
\v 24 تمہٕ مرن بۅچھِ دادِ، سخت تپہٕ سٟتؠ تہٕ مہلِک بیماریٚو سببہٕ۔
\q بہٕ سوزٕ تِمن پٮ۪ٹھ حملہٕ کرنہٕ باپتھ جنگلی جانور،
\q تہٕ زہریلہٕ سرف سوزکھ بہٕ تِمن کھیٚنہ خٲطرٕ۔
\q
\v 25 تِہنٛدیٚو گھرو نیٚبرٕ کنہٕ مارن تِمن دشمن تلوارو سٟتؠ،
\q تہٕ تِہنٛدین گھرن منٛز کرن تِمن دشمن خوفزدٕ۔
\q تِہنٛدؠ دشمن کرن تِہنٛدین جوان مردن تہٕ جوان زنیٚن قتل،
\q تہٕ تِم کرن بچن تہٕ مس سفید بُزرگن تہِ قتل۔
\q
\v 26 بہٕ چُھسکھ تِم دوٗر دراز ملکن منٛز ورفتار کرُن یژھان،
\q یُتھ نہٕ زانٛہہ تِمن کانٛہہ یاد کرِ۔
\q
\v 27 مگر، اگر مےٚ تہِ کوٚر تہٕ تِہنٛدؠ دشمن کرن نہکہٕ تتھ پٮ۪ٹھ فخر،
\q زِ تِمو لوٚب مینِس قومس نِش نجاتھ؛
\q تِم ونن، "أسؠ چھِ یِمو تِمن شِکس دیُت؛
\q یہ چُھنہٕ یہُوواہؔ یمؠ یہ سورےٕ کوٚر۔"
\q
\v 28 توٚہؠ بنی اسرائیلی چُھو اکھ قوم یِمن نہٕ عقل چھےٚ۔
\q توٚہہ منٛزٕ چُھنہٕ کانٛہہ اکھ عقلمند۔
\q
\v 29 اگر توٚہؠ عقلمند ٲسہِ ہیٚو توٚہؠ سونچہِ ہیٚو زِ توٚہہ کیازِ ییہِ سزا دنہٕ؛
\q توٚہہِ آسہ اندازٕ گمُت زِ توٚہہِ سٟتؠ کیاہ چُھ سپدن وول۔\f + \fr 32‏:29 \ft لوق 19:42\f*
\q
\v 30 توٚہہ اسہِ یہ فکرِ توٚرمُت زِ تُہنٛدین ساسن سِپہن کیازِ دییہِ دشمن سُنٛد اکھ فوجی شِکس،
\q تہٕ تُہنٛدؠ زٕ دشمن کیازِ کرن دہن ساسن اسرائیلی سِپہن لار۔
\q توٚہہ آسہ یہ ژیونمُت ز یہ سپدِ تیٚلے ییٚلہ خدا یُس ہمیشہٕ توٚہہ رچھان چُھ، کرِ توٚہہ تُہنٛدین دشمنن حوالہٕ، تکیازِ یہُوواہنؔ ترٲے نو توٚہؠ۔
\q
\v 31 تُہنٛدؠ دشمن چھِ زانان زِ تِہنٛدؠ دیوتا چھنہٕ سٲنِس خدا یہُوواہؔ سنٛدؠ پٲٹھؠ طاقتور،
\q لہٰذا ہیٚکن نہٕ تمہنٛدؠ دیوتا اسہِ اسرائیل ین شکس دِتھ۔
\q
\v 32 تُہنٛدؠ دشمن چھِ تِمن دچھِ کُلین ہیٚوؠ یمہ سدومؔ تہٕ عمورہ شہرٕ کیٚن کھنٛڈراتن منٛز لاگنہٕ چھِ آمٕتؠ۔
\q تِمن دچھِ کُلیٚن ہنٛدؠ دچھ گۅرن چھِ ژۅکؠ تہٕ بیٚیہِ زہریلہٕ۔
\q
\v 33 تمہِ دچھِ ہُنٛد شراب چُھ سرفہٕ سنٛدِ زہرُک ہیٚوٗ۔
\q
\v 34 یہُوواہؔ چُھ ونان، "بہٕ چُھس زانان زِ مےٚ کیاہ منصوبہ چُھ اسرائیل ین تہٕ تِہنٛدین دشمنن ورتاونہٕ باپتھ بنوومُت،
\q تہٕ مےٚ چھِ تِم منصوبہ بنٛد کٔرمٕتؠ یتھ کنؠ زن کانٛہہ پنُن قٟمتی سرمایہ بنٛد چُھ تھاوان۔
\q
\v 35 بہٕ چُھس سُہ اکھ یُس بدلہٕ چُھ ہیٚوان تہٕ تہِ والہٕ تِمن دشمنن نکھٕ یہ تِمو میانٮ۪ن لوٗکن سٟتؠ کوٚر،
\q منٲسب وقتس پٮ۪ٹہ دِمو تِمن سزا۔
\q تِمن پیٚن جلدےٕ مصیبت وُچھِنؠ۔
\q تہٕ بہٕ دمہٕ تِمن جلدےٕ سزا۔"\f + \fr 32‏:35 \ft لوق 21:22، رومؔ 12:19\f*
\q
\v 36 مگر یہُوواہؔ ونہِ توٚہہ زِ توٚہؠ یمہ پزی تمسنٛدؠ لوٗکھ چھِ آسن بے قصور،
\q تہٕ سُہ کرِ چانٮ۪ن خدمت گُذارن پٮ۪ٹھ رحم۔
\q ییٚلہ سُہ وچھِ زِ توٚہؠ چُھو بےٚ بس،
\q تہٕ یتہِ زِ توٚہہ منٛز چھِ واریاہ کم لوٗکھ، غلام یا آزاد یمہٕ ونیُک تام زنٛدٕ چھِ۔
\q
\v 37 پتہٕ پرژھِ یہُوواہؔ توٚہہ زِ تمہ دیوتا کتہِ چھِ یمن متعلق توٚہؠ سونچان ٲسیٚو زِ تِم کرن اسہِ حفاظت؟
\q
\v 38 توٚہہ دِتیٚو تِمن دیوتاہن تِمن جانورن ہنٛدؠ بہترین حصہ یمہ توٚہہ قربان کٔریٚو
\q تہٕ چیٚنہٕ باپتھ کوٚر ووکھ بہترین مےَ پیش۔
\q لہٰذا وتھؠ تن تِم تہٕ کٔرؠ تن توٚہہ مدد۔
\q تِمہ گژھن تِتھؠ آسٕنؠ یمہ توٚہہ حفاظت کرٕہن!
\q
\v 39 مگر وۅنؠ زٲنیٚو توٚہؠ زِ خدا چُھس صِرف بہٕ۔
\q بیٚیہِ چُھنہ کانٛہہ معبودا یُس پٔزؠ کِنؠ خدا چُھ۔
\q بہٕ چُھس سُہ یُس لوٗکن مٲرِتھ ہیٚکہ تہٕ تِمن زنٛدٕ کرِتھ ہیٚکہ۔
\q بہٕ ہیٚککھ لوٗکھ زخمی کرِتھ تہٕ پتہٕ تِم ٹھیک تہِ کرِتھ،
\q سُہ چُھنہٕ کانٛہہ یُس مےٚ یمو کامیٚو نِشہ رکٲوِتھ ہیٚکہ۔
\q
\v 40 بہٕ چُھس پنٕنؠ اتھٕ آسمانس کُن تُلِتھ مکمل اعلان کران،
\q زِ مےٚ زن چُھ یقین زِ بہٕ روزٕ ہمیشہٕ زندٕ، بہٕ کرٕ عمل۔
\q
\v 41 ییٚلہ بہ پنٕنؠ تلوار تیز کرٕ تہٕ لوٗکن سزا دنہٕ باپتھ تکیازِ سپدٕ،
\q بہٕ ہیٚمہٕ پننٮ۪ن دشمنن بدلہٕ،
\q تہٕ مےٚ سٟتؠ نفرت کرن والین بدلہٕ۔
\q
\v 42 بہٕ مارکھ پنٕنؠ سٲری دشمن تلوارِ سٟتؠ۔
\q یہ باسہِ تیٚوتھ زنتہٕ مےٚ اتھِ تیٖر چھِ یمہٕ تِہنٛدِ خوٗنہٕ سٟتؠ بٔرتھ چھِ۔
\q بہٕ کرکھ تِم سٲری لوٗکھ قتل یمہ بہٕ رٹکھ تہٕ بہٕ کرٕ تِہنٛدؠ سر قلم۔
\q
\v 43 اے تمام قومہٕ کیٚو لوٗکو، توٚہہ پزن یہُوواہؔ سنٛدین لوٗکن ہنٛدؠ تعریف کرٕنؠ،
\q تکیازِ یہُوواہؔ چُھ لوٗکھ مارن والٮ۪ن بدلہٕ ہیٚوان یمہ تمؠ سنٛز خدمت کران چھِ،
\q تہٕ سُہ چُھ پننٮ۪ن لوٗکن ہنٛز زمیٖن صاف کران یۅسہ تہنٛدیٚو گُنہو سٟتؠ ناپاک سپٕزمٕژ چھےٚ۔"
\q
\v 44 یشوعؔ تہٕ موسیٰؔ ہن گیٚوو سُہ بٲتھ ییٚلہ اسرائیلی لوٗکھ بوزان ٲسؠ۔
\v 45 پتہٕ کوٚر موسیٰؔ ہن تہنٛدِ باپتھ یہ بٲتھ بوزٕناون بنٛد۔
\q
\v 46 موسیٰؔ ہن ووٚن، "یِم ساری احکام مشرٲوؠ زیٚو نہٕ زانٛہہ یمہ بہٕ توٚہہ از دِوان چُھس۔ پنٕنؠ بچہ ہیٚچھنٲوؠ زیوکھ یمہٕ قٲعدٕ۔ تاکہ تِم کرن وفادٲری سان یِمن پٮ۪ٹھ عمل۔
\v 47 یِم ہِدایات چُھو سٮ۪ٹھاہ اہم۔ اگر توٚہؠ یِمن پٮ۪ٹھ عمل کٔریٚو تہٕ توٚہؠ روزیٚو تتھ ملکس منٛز واریہس کالس زندٕ یتھ پٮ۪ٹھ توٚہؠ قبضہ کرنہ خٲطرٕ یردن دریاوس اپور ترن وٲلؠ چُھو۔
\p
\v 48 امی دوٚہہ ووٚن یہُوواہنؔ موسیٰؔ ہس،
\v 49 "ژٕ گژھِ عباریم بالٲئی علاقس کُن، یریحو اپارِ موآبؔ علاقہٕ منٛز۔ نبوؔ بالس پٮ۪ٹھ کھس تہٕ کنعان وُچھنہٕ خٲطرٕ دِ مغربس کُن نظر، یہ چھےٚ سۅ سرِزمین یۅسہ بہٕ اسرائیل ین دِنہٕ وول چُھس۔
\v 50 توٚہؠ کٔریٚو تٔتھؠ بالس پٮ۪ٹھ وفات یتھ کنؠ تُہنٛدؠ بٔڈؠ بٲے ہاروننؔ ہورؔ پہاڑس پٮ۪ٹھ انتقال کوٚر۔
\v 51 ژٕ مرکھ اوموٚکھٕ زِ توٚہہ دوٚنویٚو کٔرو بنی اسرائیل ین برُونٛہہ کنہِ میانؠ نافرمٲنی ییٚلہ توٚہؠ سٲری صِین بیابانن منٛز قادِسؔ نکھٕ مریبہؔ ناگن پٮ۪ٹھ ٲسیٚو۔ توٚہہ کوٚرو نہٕ بنی اسرائیل ین برُونٛہہ کنہِ مےٚ سُہ عزت تہٕ تعظیم یمیُک بہ مستحق چُھس تکیازِ بہٕ چُھس خدا۔\f + \fr 32‏:51 \ft گریند 27:12 پٮ۪ٹھٕ 14\f*
\v 52 ییٚلہ توٚہؠ تتھ پہاڑس پٮ۪ٹھ ٲسیٚو یوٚت مےٚ توٚہہ گژھُن ونیٚو تہٕ توٚہؠ وُچھو پانس نزدیک سۅ زمین یۅسہ بہٕ اسرائیل ین دِنؠ یژھان چُھس مگر توٚہؠ ہیٚکیو نہٕ تور گٔژھِتھ۔"
\c 33
\p
\v 1 خدایہِ سُنٛد نبی موسیٰؔ مرنہٕ برُونٛہہ، کٔر تٔمؠ خدایس اسرائیلی لوٗکن برکت دِنٕچ عرضی۔
\v 2 تٔمؠ یہ ووٚن تہِ چُھ یتھٕ کنؠ:
\q "یہُوواہؔ آو تہٕ کوٚرُن سینا کوٚہس پٮ۪ٹھ اسہِ سٟتؠ کلام۔
\q سُہ آو تِتھ کنؠ زنتہٕ ادومؔ کِس علاقس\f + \fr 33‏:2 \ft ادومُکؔ کوہستٲنؠ علاقہٕ\f* منٛز آفتاب کھوٚت
\q تہٕ تمکہ گاشٕکؠ پٲٹھؠ پرٮ۪زلیٚو اسہِ پٮ۪ٹھ ییٚلہ أسؠ کوہہِ سینا ترٲوِتھ کوہہِ فارانس نکھٕ صحراہس منٛز ٲسؠ۔
\q سُہ آو دہن ساسن فرشتن سٟتؠ،
\q تہٕ تمِس دٔچِھنؠ کِنؠ اوس وہُہ وُن نارٕ الاو۔
\q
\v 3 یہُوواہؔ چُھ پننٮ۪ن رٕتٮ۪ن لوٗکن سٟتؠ پوٚز محبت کران،
\q تہٕ تِمن سارنی رٲچھ کران یِم تمسنٛدؠ چھِ۔
\q اوٕکنؠ چھِ تمِس برُونٛہہ کنہِ تِم سربہ سجود سپدان،
\q تہٕ تمسنٛدؠ ہِدایت بوزان۔
\q
\v 4 موسیٰؔ ہن دِتؠ تِمن قانون اپناونہ باپتھ،
\q تِم قانون یمہٕ یعقوب سنٛدین اولادن باپتھ ہمیشہ روزن۔
\q
\v 5 تہٕ یہُوواہؔ بنیاو پننہِ اسرائیلی قومُک بادشاہ،\f + \fr 33‏:5 \ft اسرائیلی لوٗکھ\f*
\q ییٚلہ سٲری قبیلہٕ تہٕ تِہنٛدؠ سردار جمع سپدؠ۔
\q
\v 6 بہٕ چُھس روبنؔ قبیلہٕ باپتھ یہ ونان:
\q بہٕ چُھس یژھان زِ تِہُنٛد قبیلہٕ گوٚژھ نہٕ زانٛہہ تہِ نابود گژھُن،
\q مگر تِم گٔژھؠ نہٕ زیادٕ تہِ آسٕنؠ۔
\q
\v 7 بہٕ چُھس یہُوداؔ قبیلس متعلق یہ ونان:
\q یہُوواہؔ، تِہُنٛد بوزؠ زِ ییٚلہِ تِم مدٕتہٕ خٲطرٕ آلو دِنے۔
\q ییٚلہ تِم دوٚیمیٚو قبیلو نشہٕ ژھیٚنہٕ گژھن تِم رلٲے زیوکھ بیٚیہِ باقی قبیلن سٟتؠ۔
\q تہنٛدِ باپتھ لٔڑزیٚو، تہٕ دشمنن سٟتؠ جنگہٕ وزِ کٔرزیٚو تِمن مدد۔
\q
\v 8 بہٕ چُھس لاوی قبیلہٕ کٮ۪ن لوٗکن باپتھ یہ ونان:\f + \fr 33‏:8 \ft تھومیم تہٕ یوریم ٲسؠ زٕ چیز (شاید کنہِ) یم کاہن خدا سنٛزِ مرضی ہنٛد تعین کرنہٕ باپتھ استعمال کران ٲسؠ (وُچھِو خروج 28:30، احبار 8:8، 1 سموئیلؔ 14:41، 14:42) \f*
\q اے یہُوواہؔ، یمہٕ ژےٚ سٟتؠ وقف چھِ تِمن دِ مقدس کٔنؠ یۅسہ تِم یہ زاننہٕ باپتھ استعمال کرن زِ توٚہؠ کیاہ چُھو کرُن یژھان؛\f + \fr 33‏:8 \ft خروج 17:17، اِستِثنا 6:16، 9:22\f*
\q توٚہہ ازمٲے ووکھ تِم صحراوس منٛز اکِس ناگس نِش، تتھ ناگس نِش یتھ تِمو مسہؔ ناو تُھوو تہٕ مریبہؔ تہِ وُنہس،
\q یہ وُچھنہٕ باپتھ زِ تِم کرناہ توٚہہِ وفادٲری۔
\q
\v 9 لاوی قبیلن کوٚر تی یہ توٚہہ تِمن کرُن وُنو،
\q تہٕ تمہِ عہدٕچ کٔرکھ تعمیل یُس توٚہہِ بنی اسرائیلس سٟتؠ کوٚرمُت اوسو۔
\q تِم قانون ٲسؠ تہنٛدِ خٲطرٕ زیادٕ اہم،
\q تِہنٛدیٚو بایو، بیٚنیو، نیٚچیو تہٕ والدینو کھۅتہٕ۔
\q
\v 10 لاوی قبیلٕکؠ ہیٚچھناون اسرائیلی لوٗکن تُہنٛدؠ قٲیِدٕ تہٕ قانون،
\q تہٕ تِمے لوٗکھ زالن بخور تہِ تہٕ قربان گاہس پٮ۪ٹھ زالن تِم قربٲنیہ تہِ یمہٕ لوٗکھ انان چھِ۔
\q
\v 11 اے یہُوواہؔ تِہنٛزن کامٮ۪ن کر برکت،
\q تہٕ یہ کینٛژھا تِم کرن تہِ کر قبوٗل۔
\q تِہنٛدؠ تمام دشمن چیرُکھ
\q تِہنٛدؠ دشمن مہٕ بنٲے ووکھ اتھ قٲبل زِ تِم لڑن تِمن سٟتؠ بیٚیہِ۔
\q
\v 12 بہٕ چُھس بنیمِینؔ قبیلس متعلق یہ ونان:
\q یہ چُھ سُہ قبیلہٕ یتھ سٟتؠ یہُوواہؔ محبت کران چُھ۔
\q سُہ چُھ تِمن رٲچھ کرِتھ۔
\q سُہ چُھ ہمیشہٕ تِمن حفاظت کران،
\q تہٕ سُہ چُھ تِہنٛدین پہاڑن منٛز روزان۔
\q
\v 13 بہٕ چُھس یوسف سنٛدین قبیلن متعلق یہ ونان:
\q بہٕ چُھس یژھان یہُوواہؔ کرِن تہنٛدِس زمینس برکت،
\q تتھ پٮ۪ٹھ آسمٲنی رود تراوِتھ،
\q تہٕ زمینہٕ کیٚو سنرو منٛزٕ آب فراہم کرِتھ۔
\q
\v 14 بہٕ چُھس یژھان زِ یہُوواہؔ کرِن تِمن برکت اصل میٚوہ دِتھ آفتابہٕ سٟتؠ پٔپرٲوِتھ،
\q تہٕ اصلیٚن ریتن منٛز بہتر فصٕل دِتھ۔
\q
\v 15 بہٕ چُھس یژھان زِ یہُوواہؔ دِین تِمن سُہ بہترین میٚوہ یُس تِہنٛدین پرانیٚن پہاڑن ہنٛدیٚو کُلیٚو پٮ۪ٹھٕ ۅپدِ۔
\q
\v 16 بہٕ چُھس یژھان زِ یہُوواہؔ کرِن تِہنٛدِس زمینس برکت تہٕ سُہ زمین یِین رٕتیٚو فصلو سٟتؠ برنہٕ۔
\q بہٕ چُھس یژھان زِ یہُوواہؔ کٔرِن یوسف سنٛدین قبیلن یمو ساروےٕ طریقو برکت،
\q تیازِ ییٚلہ سُہ مِصرس منٛز اوس سُہ اوس پننٮ۪ن بڈین باین ہُنٛد رہنما۔
\q
\v 17 یوسف سنٛدؠ اولاد ٲسِن سانٛڈن ہنٛدؠ پٲٹھؠ مضبوط؛
\q تِم کٔرِن پننٮ۪ن دشمنن پننیٚو ہتھیارو سٟتؠ تتھ کنؠ زخمی یتھ کنؠ جنٛگلؠ سانٛڈ باقی جانورن پننیٚو ہیٚنٛگو\f + \fr 33‏:17 \ft ہیٚنٛگن ہُنٛد عِبرٲنؠ مطلب چُھ طاقت\f* سٟتؠ کران چھِ۔
\q تِم دِن باقی لُکہٕ جمٲژن دکہٕ،
\q تِمن سارنی ژھنن، زمینہِ ہنٛدین دوٗر دراز مقامن کُن۔
\q سُہ گو، یوسف سنٛدین دوٚنونؠ نیٚچوٮ۪ن ہنٛدؠ اولاد کرن، افرائیمؔ سنٛدین دہَن ساسن قبیلن تہٕ منسیؔ قبیلہٕ کٮ۪ن ساسہٕ واد لوٗکن یتھے کنؠ۔
\q
\v 18 بہٕ چُھس زبولونؔ تہٕ اِشکار سنٛدین قبیلن متعلق یہ ونان:
\q بہٕ چُھس یژھان زِ زبُولونٕکؠ لوٗکھ روزن سمندرس تار دِنہ پتہٕ سفرس دوران خوشحال
\q تہٕ اشکارٕکؠؔ لوٗکھ روزن تۅتام ترقی کران یۅتام تِم گھرِ روزن تہٕ کرن پننٮ۪ن چارواین تہٕ فصلٕچ رٲچھ راوٕٹ۔
\q
\v 19 تِم انن اسرائیل کیٚن دوٚیمین قبیلن ہنٛدین لوٗکن تتھ پہاڑس پٮ۪تھ ناد دِتھ یتہِ تِم یہُوواہؔ سنٛز عبادت کران چھِ،
\q تہٕ تِم کرن تس پزٕ قربٲنیہ پیش۔
\q تہٕ کرن تمہِ تجارتہٕ سٟتؠ سٮ۪ٹھاہ ترقی یُس تِم سمندر بٹھِس پٮ۪ٹھ کران چھِ،
\q سیٚکھ تہٕ سیٚکہِ منٛزٕ مختلف چیز کٔڈِتھ کران چھِ۔
\p
\v 20 بہٕ چُھس جد قبیلس متعلق یہ ونان:
\q یہُوواہسؔ کُن کٔریٚو حمد یمؠ تُہنٛدؠ علاقہ بڑٲوؠ۔
\q تِہنٛدِ قبیلٕکؠ لوٗکھ کرن پننٮ۪ن دشمنن پٮ۪ٹھ تِتھؠ شدید حملہ یِتھؠ سٕہہ پنٛجہ تلِتھ،
\q کانسہِ جانور سُنٛد پھیٚوک یا کلہٕ ہیر بُچھنہٕ باپتھ انتظار کران چُھ۔
\q
\v 21 تِمو ژور پننہِ باپتھ زمینُک اکھ بہترین حصہ،
\q زمینُک اکھ بوٚڈ حصہٕ، تیٚوتھ حصہ رٹُکھ یُس کٲنٛسہِ سردارس دیُن پزِہے،
\q ییٚلہ اسرائیل قبیلٕکؠ قٲیِد جمع سپٕدؠ،
\q تہٕ تِمو نیٚو فٲصلہٕ زِ جد قبیلہٕ کیٚن گژھِ زمینُک بوٚڈ حصہٕ دِنہٕ یُن۔
\q جد قبیلہٕ کیٚو کٔر یہُوواہؔ سنٛدین حکمن تہٕ تِمن چیزن ہنٛز تعمیل یمہٕ تمؠ فٲصلہ نمٕتؠ ٲسؠ زِ تِم گژھن کرٕنؠ۔
\q
\v 22 بہٕ چُھس دان قبیلس متعلق یہ ونان:
\q دان قبیلٕکؠ لوٗکھ چھِ اکِس جوان سٕہہ سنٛدؠ پٲٹھؠ،
\q تِم چھِ پننِٮ۪ن دشمنن پٮ۪ٹھ حملہٕ کرنہٕ باپتھ بسن علاقس منٛز پننیٚو گۅپھو منٛزٕ جٔپھؠ دِنس تیار۔
\q
\v 23 بہٕ چُھس نفتالیؔ قبیلہٕ کٮ۪ن متعلق یہ ونان:
\q نفتالیؔ قبیلہٕ کٮ۪ن لوٗکن کٔر یہُوواہنؔ برکت، یُس تِمن پٮ۪ٹھ مہربان سپُد؛
\q تِہنٛز زمیٖن چھےٚ گُلیلؔ جھیلہٕ پٮ۪ٹھٕ دوٗر دوٗر تام جنوٗبس تام پھٲلِتھ۔
\q
\v 24 بہٕ چُھس آشرؔ قبیلس متعلق یہ ونان:
\q یہُوواہؔ کرِن آشیرؔ قبیلہٕ کٮ۪ن اولادن دویمٮ۪ن قبیلن ہنٛدیٚو اولادو نشہٕ زیادٕ برکت۔\f + \fr 33‏:24 \ft تہنٛدؠ زیتون کُلؠ دِیِن واریاہ زیادٕ میٚوٕ۔\f*
\q یہُوواہؔ کرِ تِمن پٮ۪ٹھ ساروےٕ کھۅتہ بوٚڈ احسان۔
\q بہٕ چُھس یژھان زِ تِہنٛدؠ کھاہ یِین زیتون کُلیٚو سٟتؠ برنہٕ یمہ زیتون تیٖل دنہٕ باپتھ واریاہ زیتون دِتھ ہیٚکن۔
\q
\v 25 تِہنٛدؠ شہر آسن تھدیٚو دیوارو سٟتؠ محفوظ یِمن ہنٛدؠ دروازٕ سرتلہِ تہٕ شستٕر سُرین ہنٛدؠ آسن۔
\q بہٕ چُھس پرٮ۪تھ وزِ یژھان زِ تِم روزِن زنٛدٕ تہٕ کانٛہہ مہٕ واتنٲوؠ نکھ زکھ۔
\q
\v 26 اے اسرائیلی لوٗکو، تُہنٛدس خدایس ہیٚو چُھنہٕ بیٚیہِ کانٛہہ خدا،\f + \fr 33‏:26 \ft اسرائیلی لوٗکھ\f*
\q یُس آسمانس پٮ۪ٹھ تُہنٛدِ مددتہٕ باپتھ جاہ و جلاہٕ سان گتھ چُھ کران۔
\q
\v 27 خدا، یُس لا فٲنی چُھ، سُہ چُھ توٚہہ پناہ دِوان۔
\q مطلب، سُہ چُھ توٚہہ مدد دِنہٕ باپتھ پننہِ لازوال نرِ آلوان۔
\q سُہ کرِ تُہنٛدین دشمنن لار ییٚلہ توٚہؠ برُونٛہہ پٔکیٚو؛
\q سُہ چُہ توٚہہ ونان زِ یِم سٲری کٔرؠ ووکھ فناہ۔
\q
\v 28 تہٕ توٚہؠ اسرائیلی لوٗکھ روزیٚو محفوظ؛
\q توٚہہ یعقوب سنٛدین اولادن کرِ نہٕ بیٚیہِ کانٛہہ پریشان۔
\q یتھ ملکس منٛز توٚہؠ روزیٚو تتہ آسہ وٲفِر اناج تہٕ مےَ،
\q تہٕ آسہ آسمانہٕ پٮ۪ٹھٕ خوب بٲرِش پیٚوان۔
\q
\v 29 اے اسرائیلی لوٗکو، توٚہؠ کٲتیاہ خوش نصیب چُھو۔
\q پٔزؠ پٲٹھؠ چُھنہٕ تُہنٛدِس قومس ہیٚوٗ بیٚیہِ کانٛہہ قوم،
\q یُس یہُوواہنؔ مِصرچہِ غلامی نِشہ بچوو۔
\q سُہ چُھ تُہنٛزِ حفاظتہٕ باپتھ ڈھال بنِتھ،
\q تہٕ تُہنٛزِ رٲچھ خٲطرٕ تلوار ہیٚوٗ کھڑا یُتھ تُہنٛدین دشمنن شِکس دییہِ۔
\q تُہنٛدؠ دشمن ین توٚہہ نِش تہٕ کرن توٚہہِ درخواس زِ اسہِ پٮ۪ٹھ کٔریٚو رحم،
\q مگر توٚہؠ کٔرؠ ووکھ تِم پٔتؠ کِنی پامال۔"\f + \fr 33‏:29 \ft تہندیٚو کمرو کِنؠ\f*
\c 34
\p
\v 1 امہِ پتہٕ کھوٚت موسیٰؔ موآبؔ علاقہ کیٚو مٲدانو منٛزؠ نبوؔ پہاڑس پٮ۪ٹھ، پِسگہ تینٛتٲلِس پٮ۪ٹھ یُس یریحو کِنؠ یردن دریاوس اپارِ چُھ۔ تتہِ ہٲو یہُوواہنؔ تمِس سۅ سٲرےٕ زمین یتھ پٮ۪ٹھ اسرائیلی قبضہٕ کرن۔ تٔمؠ ہوو تمِس جلعادُک علاقہ یۅتام شمالہ کِنؠ دان شہر چُھ۔
\v 2 سُہ سورےٕ زمین یتھ نفتٲلی قبیلہٕ قبضہٕ کرِ، سُہ سورےٕ زمین یتھ پٮ۪ٹھ افرائیمؔ تہٕ منسیؔ قبیلہٕ کیٚو قبضہٕ کوٚرمُت اوس۔ سُہ سورےٕ زمین یتھ پٮ۪ٹھ یہُوداؔ قبیلہٕ رومؔ سمندرٕ کِنؠ مُربسؔ تام قبضہٕ کرِ۔
\v 3 یہُوداؔ کِس جنوبی حصس منٛز صحرائی علاقہ۔ تہٕ یردن وادی یۅسہ شمالس کِنؠ یریحو پٮ۪ٹھ جنوبی ضُعرؔ شہرس تام پھٲلِتھ چھےٚ۔
\p
\v 4 پتہٕ ووٚن یہُوواہنؔ تمِس زِ وۅنؠ وچُھتھ ژےٚ یہ ملک یمیُک وعدہ مےٚ ابرہامسؔ، اضحاقسؔ تہٕ یعقوبس سٟتؠ کوٚرمُت چُھ زِ بہٕ دمہٕ یہ چانہِ پُشتہٕ کٮ۪ن۔ مےٚ دیُت مےَ ژےٚ اجازت وُچھ ژٕ یہ دورے مگر ژٕ گژھکھ نہٕ تور۔"
\p
\v 5 تہٕ موسیٰؔ یُس ہمیشہ وفادٲری سان یہُوواہؔ سنٛز خدمت کران اوس گُذریاو تٔتؠ موآبؔ ملکسےٕ منٛز یہ زن یہُوواہنؔ ونمُت اوس یہ سپدِ۔
\v 6 یہُوواہنؔ کٔر موسیٰؔ سنٛز لاش موآبؔ وادی منٛز بیت فعورؔ شہرس اپارِ دفن، مگر از تام چھنہٕ کانٛہہ اکھ زانان سُہ کتھ جایہ چُھ دفن۔
\v 7 موسیٰؔ سنٛز عمر ٲس اکھ اتھ تہٕ وُہہ وری یمہِ ساعتہٕ سُہ گذریو، مگر تمہ وزِ تہ اوس صحت منٛد، تمہِ وِزِ، تہِ اوس سُہ اصل وُچِھتھ ہیٚکان۔
\v 8 اسرائیل کیٚو لوٗکو کوٚر ترہَن دوٚہُن موآبؔ کٮ۪ن مٲدانن منٛز موسیٰ سنٛدِ باپتھ ماتم۔
\p
\v 9 خداین بنوو یشوع واریاہ عقلمند، تکیازِ موسیٰؔ ہن تُھوو یشوعؔ ہس پٮ۪ٹھ اتھٕ تاکہِ تمِس کرِ پنُن نوو سردار مقرر۔ اسرائیل کیٚو لوٗکو مٲنؠ یشورؔ سنٛز کتھ، تہٕ تِمو کٔر تِمن تمام احکامن ہنٛز تعمیل یمہٕ یہُوواہنؔ موسیٰؔ ہس اسرائیلی لوٗکن وننہٕ خٲطرٕ دِتمٕتؠ ٲسؠ۔
\p
\v 10 یۅتام موسیٰؔ زندٕ رودؠ، اسرائیلس منٛز اوس نہٕ تیٚوتھ کانٛہہ نبی آمُت، تکیازِ یہُوواہؔ اوس تس سٟتؠ روبرو کتھٕ کران۔
\v 11 کٲنٛسہ بیٚؠ رسولن کٔرؠ نہٕ تِتھؠ بٔڈؠ معجزٕ یمہٕ تس یہُوواہنؔ مِصرٕ کِس بادشاہ فرعونس، تمسنٛدین تمام افسرن تہٕ مِصرٕ کٮ۪ن لوٗکن خلاف ہٲوؠ۔
\v 12 کانٛہہ بیاکھ رسول اوس نہٕ یمہ عظیم تہٕ خوفناک کامہِ انجام دِنس لایکھ یمہ موسیٰؔ ہن انجام دژٕ یہ زن تمام اسرائیلی وُچھان ٲسؠ۔
