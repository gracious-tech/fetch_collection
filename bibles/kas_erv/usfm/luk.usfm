\id LUK - DMT Kashmiri c
\toc1 لُوق
\mt1 لوق
\c 1
\p
\v 1 "واریاہ لوٗکھ چھِ برونٛہہ پیٚٹھےَ تِمن چیزن متعلق لیٚکھان رودؠ مٕتؠ یِم اسہِ درمیان سَپدؠ۔
\v 2 تِم چھِ رودؠ مٕتؠ تی درج کران یتھ لوٗکو گوٲہی دِژمٕژ ٲس یمو لوٗکو پانہٕ تِم واقات سپدان وُچھمٕتؠ ٲسؠ۔ تِم لوٗکھ چھِ ٲسؠ مٕتؠ گوڈٕ پٮ۪ٹھ تتہِ موجود ییٚتہِ تِم واقات پیش آے تہٕ تنہٕ پؠٹھٕ چھِ رودؠ مٕتؠ أکِس بیٚیس نِش سۅ دلیل بیان کران۔
\v 3 مےٚ کٔر پانہٕ تِمن چیزن متعلق پرژھٕ غٲر یِم گۅڈٕ پیٚٹھےَ پیش آمٕتؠ ٲسؠ۔ توے نیٚو مےٚ فأصلہٕ زِ مےٚ پزِ اکھ صحیح تہٕ سلسلہِ وار دلیل عزتہٕ وٲلِس تھیُفِلسؔ خٲطرٕ لیکھنؠ۔
\v 4 تھیو پلسسؔ اوس برونٹھے انجیلہِ ہنٛزن کتھن ہُنٛد علم مگر تمس اوس نہٕ تِمن واقاتن ہنٛدس پزر آسنس پؠٹھ پوٚرٕ پٲٹھؠ یقین۔ میٲنؠ تجویز چھِ زِ ژےٚ زانکھ تِمن چیزن ہنٛز اصلی حقیقت۔ بہٕ چُھس یژھان ژٕ گژھکھ تہِ زانُن یہِ لوٗکو توٚہہِ یسوعؔ ہس متعلق ونمُت چُھ زِ تہِ چھا پوٚز۔
\v 5 ییٚلہِ ہیرودیسؔ یہُودیہ ہُک بادشاہ اوس، تمہِ وقتہٕ اوس تتہِ ذکریاہ ناوُک اکھ یہُودؠ کاہن تہٕ، ابیاہنؔ کاہن آسنُک سلسلہٕ۔ سُہ اوس ابیاہؔ سُنٛد زُر، تٔمؠ لٲج ہیکل کیٚن باقین کاہنن سٟتؠ خدمت کرٕنؠ یِم ابیاہؔ سنٛدؠ زُرؠ ٲسؠ۔ تٔمؠ سنٛزِ زنانہِ اوس ناو الیشِبعؔ۔ سۅ ٲس ہارونؔ سنٛدِ خاندانہٕ منٛزٕ تہٕ اوے ٲس سۅ تہِ کاہن فرقہٕ منٛزے۔
\v 6 تِم دۅشوے بٲژ ذکریاہؔ تہٕ الیشِبعؔ ٲسؠ خدایس نزدیک راست باز تکیازِ تِم ٲسؠ ہمیشہ خدایہِ سنٛدین حکمن ہنٛز فرمانبردٲری کران۔
\v 7 مگر تِمن اوس نہٕ کانٛہہ شُر، تکیازِ الیشِبعؔ ٲس نہٕ اولادن زایُن دِنس قٲبل۔ تہٕ تِم دوٚشوے بأژ ٲسؠ واریاہ بڈٕ زِ تِمن ہیٚکہ ہے نہِ وُنؠ شُر زیٚتھ۔
\v 8 اکہ وقتہٕ آیہِ ابیاہؔ فرِیقس یروشلمسؔ منٛز خدمت کرنچؠ وٲرؠ، یہِ کٲم اوس ذکریاہؔ پانے بحثیتِ کاہن خدایہِ سٕنٛدِس خدمتس منٛز ادا کران۔
\v 9 \f + \fr 1‏:9 \ft خروج 30:7\f* کاہنو ژور ذکریاہؔ خداوند سٕنٛدِس گرس منٛز مشکہٕ تجہِ زالنہٕ خٲطرٕ۔\f + \fr 1‏:9 \ft سُہ، یسوع، باہ شٲگرد\f* تِمو ژوٚر سُہ پننیٚو ریوایژو مطٲبق، چیٖرِ ترٛاونہٕ سٟتؠ، یہِ زٲنِتھ زِ خداین کمؠ سنٛدؠ دسؠ یٔژھ یہِ خاص کٲم کرناوُنؠ۔
\v 10 ییٚلہِ مُشِک زالنہٕ وزِ، واریاہ لوٗکھ ٲسؠ ہیکل کس صحنس منٛز دُعا کران۔ یہِ صحن اوس مندرس نٮ۪بر۔
\v 11 تمی وزِ، آو خداوندٕ سُنٛد فرشتہٕ ذکریاہسؔ نِش۔ سُہ رود قربان گاہس دٔچھنہِ انٛدٕ کھڑا یتِتھ سُہ مُشِک زالان اوس۔
\v 12 ییٚلہِ ذکریاہنؔ فرشتہٕ وُچھ سُہ کھوٚژ  تہٕ تمِس گوٚو ہٲبتھ۔
\v 13 پوٚز فرشتن ووٚن تمِس، "ہے ذکریاہ مےٚ مہٕ کھۅژ ژٕ چُھکھ دُعا اوسمُت کران تہٕ خداین کوٚر چون دُعا قبول۔ چانہِ آشنہِ الیشِبعؔ زیوِ چون نیٚچو۔ ژٕ تھاوزِ تس یوحناؔ ناو۔
\v 14 ییٚلہِ سُہ زایُن لبہِ، ژٕ گژھکھ سیٹھاہ خوش، تہٕ باقی واریاہ لوٗکھ تہِ گژھن خوش۔
\v 15 \f + \fr 1‏:15 \ft یوحناؔ سُنٛد شراب نِشہ پرہیز چُھ ہاون زِ سُہ چُھ ناصرتی، مثالہِ پٲٹھؠ سُہ نفر یمؠ پننُ پان اوس خدایس حوالہٕ کوٚرمُت زِ \f*\f + \fr 1‏:15\ft افسیونؔ 5:18، قضات 13:4 \f* ژٕ تہٕ تِم گژھن خوش تکیازِ خدایس نِشہ آسہِ سُہ سارِوے کھۅتہٕ اثر وول۔ تمِس پزِنہِ زانٛہہ شراب چیٚون تہٕ نہ کانٛہہ نشہٕ کرُن۔ پاک روح کرِ ماجہِ ہندِ شکمہٕ منٛزے تس اثر تراوُن شروع۔
\v 16 چون نیٚچو مانہِ راوِ واریہن اسرائیل ین گُنہو نِشہ دوٗر روزنہٕ باپتھ تہٕ تِمن کرِ پننِس خداوندٕ سنٛز فرمانبردٲری باپتھ بیٚیہِ تیار۔
\v 17 \f + \fr 1‏:17 \ft ملاکی 4:5 \f* چون نیٚچو نیرِ خداوندس برونٛہہ برونٛہہ تہٕ تمسنٛدس روحَس آسہ ایلیاہؔ نبی سُنٛد ہیوٗ طاقت۔ سُہ پھرِ مالؠن ماجَن ہُنٛد دل دُبارٕ اولادن کنُ۔ سُہ پھرِ واریاہ نافرمان لوٗکن ہنٛدؠ دل خدا سنٛزِ فرمانبرداری کنُ تہٕ تِم گُذارَن گاٹہٕ جارچ تہٕ نیکی ہنٛز زندگی۔ سُہ کرِ یہِ اوے زِ خداوند سنٛدؠ لوٗکھ آسن تمہِ سٕنٛدِ خٲطرٕ تیار ییٚلہِ سُہ ییہِ۔
\v 18 ذکریاہنؔ ووٚن فرشتس، "مےٚ کِتھٕ پٲٹھؠ ییہِ بھروسہٕ زِ یِم چیٖز ژےٚ ؤنِتھ تم کیاہ سپدن پٔزؠ پٲٹھؠ؟ بہٕ چُھس سیٹھاہ بُڈٕ تہٕ میٲنؠ زنانہ تہِ چھےٚواریاہ وٲنسہِ، لہٰذا چُھ میانہِ خٲطرٕ اتھ پؠٹھ یقین کرُن مشکل زِ یہِ کیا سپدِ۔"
\v 19 \f + \fr 1‏:19 \ft دانؠ ایل 8:16، 9:21\f* اتھ پٮ۪ٹھ وونس فرشتن یورٕ "بہٕ چُھس جبرائیل! بہٕ چُھس خدایس نِشہ اِستادٕ آسان! خداین سوزُس بہٕ یہِ رٕژ شیٚچھ ہیٚتھ ژےٚ نِش زِ ژےٚ سٟتؠ کیاہ سپدِ۔
\v 20 وُنؠ بوز! یہِ مےٚ ژےٚ سٟتؠ کلامہٕ کوٚر تہِ سپدِ یقیٖنن تمہِ وقتہٕ یمیُک فاصلہٕ خداین کوٚرمُت چُھ۔ پوٚز ژےٚ کوٚڑُتھ نہِ میٛانین کتھن پؠٹھ بھروسہٕ، خدا کری ژےٚ زبان بنٛدی، ژٕ ہیککھ نہٕ تتھ دوٚہس تام کہینٛؠ ؤنِتھ یۅتام نہٕ چون نیٚچو زایُن لبہِ"
\v 21 ہیکلس منٛز ذکریاہ تہٕ فرشتہٕ سنٛزِ کتھٕ دوران ٲسؠ لوٗکھ ذکریاہسؔ نیٚبرٕ کنہِ صحنس منٛز ذکریاہس نیٚبر نیرنس پراران۔ تِمن گوٚو تعجب زِ سُہ کیازِ بیوٗٹھ ییتِس کالس ہیکلس منٛز۔
\v 22 پتہٕ درٛاو سُہ ہیکلہٕ منٛزٕ نیٚبر، پوٚز تٔمؠ ہیٚچ نہٕ تِمن سٟتؠ کتھ کٔرتھ۔ تکیازِ سُہ اوس نہٕ کتھےٕ کٔرتھ ہیکان۔ أمؠ ہوو تِمن اتھٕ کہ اِشارٕسٟتؠ تہِ یہِ انٛدرٕ سپدمُت اوس۔ امہِ سٟتؠ توٚر لوٗکن فِکرِ زِ خداین اوس تمِس اکھ رویا ہیکلس اندر سوزمُت۔
\v 23 ییٚلہِ ذکریاہ سنٛدؠ خدمتٕکؠ دوٚہہ ہیکلس منٛز پوٗرٕ سپدؠ، سُہ درٛاو یروشلمہٕؔ منٛزٕ تہٕ گوٚو گرٕ پنُن واپس۔
\v 24 امہِ پتہٕ کینٛہہ وقت گژھتھ، تس سنٛز زنانہ الیشِبعؔ روز گۅبہِ کھۅر، تہٕ پانٛژن ریتن روز سۅ لوٗکن نِشہ یہِ ؤنِتھ دور، زِ
\v 25 \f + \fr 1‏:25 \ft پٲدٲیشؠ 30:23\f* "خداوندن بنٲوس بہٕ گۅبہِ کھۅر روزٕنَس قٲبل۔ تمہِ سُنٛد شُکر، وُنؠ چُھنہٕ مےٚ لوٗکن منٛز ہٲنٹھؠ آسنٕچ رسوٲیی تُلٕنؠ۔"
\v 26 ییٚلہِ الیشِبعؔ ہس گۅبہِ کھۅر روزنُک شیم رؠتھ ژاو، خداین سوز فرشتہٕ جبرائیل گلیل علاقہٕ کس ناصرت ناوٕ کِس أکِس شہرس منٛز۔
\v 27 خداین سوز سُہ أکِس انہرؠ شہ کورِ سٟتؠ کتھ کرنہِ یمہِ سُنٛد ناو مریم اوس۔ تسَنٛدؠ مٲلؠ ماجہ اوس وعدہ کوٚرمُت زِ تٔمؠ سُنٛد خاندر ییہِ أکِس مردس سٟتؠ کرنہِ یمہِ سُنٛد ناو یوسف اوس، سُہ اوس بادشاہ داوود سنٛدِ خاندانہِ منٛزٕ۔
\v 28 فرشتہ ووت تٔتھؠ جایہ یتؠن مریمؔ ٲس تہٕ ووٚننس، "اے برکتھ واجِنؠ! ژٕ چِھیٚکھ خداوندس سیٹھاہ خاص"
\v 29 پوٚز ییٚلہِ تٔمؠ فرشتن یہِ ووٚن، سۅ گییہِ دُلہٕ مُلِس منٛز۔ سۅ لجٔ سونٛچنہِ زِ امہِ سلامہِ ہُنٛد مطلب کیاہ ہیٚکہ ٲسِتھ۔
\v 30 پتہٕ ووٚن تٔمؠ فرشتن تمِس، "خدا چُھ یژھان ژےٚ برکتھ واجِنؠ بناوُن، اے مریمؔ، مٕہ کھۅژ!
\v 31 \f + \fr 1‏:31 \ft یسعیاہؔ 7:14\f* وُنؠ بوز، ژےٚ روٗزکھ بیٚیہِ زووٕ، تہٕ ژےٚ زیٚوی اکھ نیٚچو۔ تمِس تھاوکھ ژٕ یسوعؔ ناو۔
\v 32 \f + \fr 1‏:32 \ft زبُور 132:11، یسعیاہؔ 9:6۔ 7\f* سُہ بنہِ عظیٖم، تہٕ سُہ آسہ خدایہ سُنٛد عزتہٕ وول گۅبُر۔ خداوندٕ سُنٛد خدا بناوِ تمِس پننؠن لوٗکن ہُنٛد بادشاہ، یتھٕ پٲٹھؠ تمسُنٛد جَد داوود اوس۔
\v 33 \f + \fr 1‏:33 \ft افسیون1:8، دانؠ یال 2:44\f* سُہ روزِ اسرائیل کیٚن لوٗکن ہُنٛد ہمیشہ بادشاہ۔ سُہ کرِ تِمن پؠٹھ ہمیشہٕ بادشٲہی"
\v 34 پتہٕ ووٚن مریمؔن فرشتس، "مگر بہٕ چھیٚس انہرِش۔ یہِ کِتھٕ پٲٹھؠ سپدِ"
\v 35 فرشتن دِیُت جواب، "پاک روح سپدِ ژےٚ پؠٹھ نٲزل۔ خدایہ سنٛز قدرت آسہ ژےٚ پؠٹھ سایکؠ پٲٹھؠ نٲزل سپدان۔ لہٰذا یُس ژےٚ بچہ زییی سُہ آسہ پاک۔ سُہ ییہِ خدایہ سُنٛد نیٚچو گنٛزراونہٕ۔
\v 36 بیٚیہِ بوز یتہِ۔ چٲنؠ رشتہٕ دار الیشِبعؔ تہِ چھےٚگۅبہِ کھۅرٕ، تمِس تہِ زیوِ اکھ نیٚچو۔ تکیازِ سۅ چھےٚ وٲنٛسہِ آمٕژ، لوٗکھ ٲسؠ زانان زِ سۅ ہیٚکہ نہٕ بچن زایُن دِتھ۔ مگر سۅ چھےٚ وُنؠ گۅبہِ کھۅر تقریبن شیٚمِس ریتس منٛز۔
\v 37 \f + \fr 1‏:37 \ft متّی 19:26، یرمیاہ 32:27\f* توٚہؠ چُھو وُچھان، خدا ہیٚکہ کینٛہہ تہِ کٔرِتھ"
\v 38 پتہٕ ووٚن مریمؔن، بلکل ٹھیک۔ بہٕ چھیٚس خدایہ سنٛز نوکرٲنؠ۔ خدا ہیٚکہ تِم چیز میانہِ باپتھ بنٲوِتھ یِمن ہنٛز ژےٚ وضاحت کٔرتھ۔ "پتہٕ درٛاو فرشتہ تمِس نِشہ۔
\v 39 تمہِ پتہٕ کمےٕ کٲلؠ، ؤژھ مریمؔ تہٕ گییہ جل جل تتھ شہرس منٛز یتہِ ذکرؔیاہ روزان اوس، سُہ شہر اوس یہُودیہ کیٚن کوہستانن منٛز۔
\v 40 ذکرؔیاہ سُنٛد گرٕ أژتھ کٔر الیشِبعؔ یہِ سلام، یۅسہ ذکریاہؔ سنٛز زنانہ ٲس۔
\v 41 یتُھے الیشِبعؔ ہن مریمٕنؠ سلام بوز، بچن تُج الیشِبعؔ سنٛدِس شکمس منٛز وۅٹھ۔ ؤلؠ ؤلؠ کوٚر پاک روحن الیشِبعؔ ہس منٛز کتھ کرنُک جوش پٲدٕ۔
\v 42 تمہِ دِژ مریمسؔ زورٕ کرٛیکھ، "خداین چھےَ ژےٚ باقیو زنانو کھۅتہٕ زیادٕ برکتھ کرمژٕ، تہٕ تٔمؠ چُھے ژےٚ بچہ عطا کوٚڑمُت یَس ژٕ زایُن دِکھ!
\v 43 بہٕ چھیٚس نہٕ اتھ لایق، زِ ژٕ میانِس خداوند سنٛز موج، آیہِ مےٚ نِش!
\v 44 مےٚ چھےٚ سٲرےٕ پتاہ تکیازِ یتُھے مےٚ چٲنؠ سلام بوز، یُس بچہ میانِس شکمس منٛز چُھ تٔمؠ لوگ اورٕ یور کرُن تکیازِ سُہ اوس تیوٗت جوشش منٛز آمُت!
\v 45 ژےٚ چھیٚکؠ بختہٕ بٔڈ تکیازِ ژےٚ کوٚڑُتھ تتھ پؠٹھ یقین یہِ خداوندن وُنےٕ، تہِ نیرِ پوٚز۔"
\v 46 پتہٕ کٔرؠ مریمنؔ یہِ ونان خدایہِ سنٛدؠ تعریف زِ" او، بہٕ کِتھٕ پٲٹھؠ کرٕ خداوندٕ سنٛدؠ تعریف
\v 47 \f + \fr 1‏:47 \ft 1 سموئیلؔ 2:1\f*تہٕ بہٕ چھیٚس خدایس سیٹھاہ خوش، یُس مےٚ بچاوان چُھ!
\v 48 \f + \fr 1‏:48 \ft 1سموئیلؔ 1:11، لوقا 1:42، ملاکی 3:12\f* بہٕ چھیٚس خوش تکیازِ سُہ گوٚو مےٚ پؠٹھ مہربان، ییٚلہِ نہٕ بہٕ تتھ لایق ٲس سےٕ۔ یہِ کرِیو انٛدازٕ۔ أزؠ کہِ پؠٹھٕ، ونن پرٛیتھ زمانکٕؠ لوٗکھ زِ خداین چُھ مےٚ عنایت کوٚڑمُت!
\v 49 تِم ووٚنُن یہِ تکیازِ خدا، یُس قُدرت تھاون وول تہٕ اکھ پاک ذاتھ چھےٚ، کرِ میانہِ باپتھ بجہِ بجہِ کامہِ۔
\v 50 \f + \fr 1‏:50 \ft زبُور 103:17\f* سُہ چُھ پرٛیتھ زمانس منٛز تِمن لوٗکن پؠٹھ رحم دِل رودمُت یِمو تس احترام چھِ کران۔
\v 51 \f + \fr 1‏:51 \ft 2 سموئیلؔ 22:28، زبُور 89:10\f* تٔمؠ چُھ لوٗکن ہوومُت زِ سُہ چُھ سیٹھاہ طاقتور۔ تٔمؠ چُھ تِمن شِکس دِتمُت یِمن پانس منٛز گُمنڈ اوس۔
\v 52 \f + \fr 1‏:52 \ft 1 سموئیلؔ 2:7، زبُور 113:7۔ 8، ایوب 5:11\f* تٔمؠ چھےٚ حکمرانن حٲکمی نِمٕژ، پوٚز تٔمؠ چُھ پسماندٕ لوٗکن یزتھ بخشمُت۔
\v 53 \f + \fr 1‏:53 \ft 1 سموئیلؔ 2:5، زبُور 107:9\f* تٔمؠ چھِ بۅچھِ ۂتؠ لوٗکھ رُت غذا کھیٲومٕتؠ یۅتام تِم سیر گے۔ پوٚز تٔمؠ چھِ امیر لوٗکھ اتھٕ چٔھنؠ کٔرمٕتؠ۔
\v 54‏-55 تمؠ چُھ اسرائیلس مدد کوٚرمُت، تِمن لوٗکن یمو تس خدمت کٔر۔ واریاہ برونٛہہ کوٚر تٔمؠ سانیٚن جدن وعدہ زِ سُہ آسہ تِمن پؠٹھ رحم دِل۔ تٔمؠ چُھ سُہ وعدہ پُورٕ کوٚرمُت تہٕ سُہ آو ابرہامسؔ رحم دِلی سان پیش تہٕ تِہنزِ ذریٲژ پؠٹھ تہِ۔"
\v 56 مریمؔ روز الیشِبعؔ سٟتؠ تقریبن ترٛین ریٚتن۔ تہٕ تمہِ پتہٕ گییہِ سۅ گرٕ۔
\v 57 ییٚلہِ الیشِبعؔ ہس بچہ زیٚنُک وق ووت، تمِس زاو اکھ نیٚچو۔
\v 58 ییٚلہِ تسنٕدیو ہمسایو تہٕ رشتہٕ دارو اتھ متعلق بوز زِ خداوندن کمہِ قسمُک نیٚچو اوس تمِس رحم دِلی سان عطا کوٚرمُت، تِم گےَ الیشِبعؔ پٮ۪ٹھ سیٹھاہ خوش۔
\v 59 ٲٹھِ دوٚہؠ پتہ \f + \fr 1‏:59 \ft پٲدٲیشؠ 17:12، احبار 12:3\f*گےَ لوٗکھ تمِس بچس ختنُک رسم انجام دِنہٕ باپتھ جمع تہٕ یہِ ہاونہ باپتھ زِ سُہ اوس خدایہِ سُنٛد۔ یہِ اوس بچس ناو تھاونُک وق تہِ، لوٗکھ ٲسؠ یژھان تمِس ذکریا ناو تھاوُن تکیازِ سُہ اوس تسٕنٛدِس مٲلس ناو۔
\v 60 پوٚز تٔمؠ سنٛزِ ماجہِ ووٚن، "نہٕ۔ امسُنٛد ناو مٕہ تھٲیِو ذکریاؔ۔ أمؠ سُنٛد ناو تھٲیِو یوحناؔ!
\v 61 تتھ پؠٹھ ووٚن تمِس تِمو، "مگر یوحناؔ چُھنہٕ چانیو رشتہٕ دارو منٛزٕ کانٛسہِ أکِس تہِ ناو!"
\v 62 پتہٕ کوٚر تِمو تسٕنٛدس مٲلس پننیٚو اتھو سٟتؠ اشارٕ زِ سُہ کیاہ چُھ تس ناو تھاوُن یژھان۔
\v 63 تٔمؠ ہوو اشارٕ زِ تمِس دِیو لیکھنہٕ خٲطرٕ اکھ مشق۔ ییٚلہِ تِمو تمِس اکھ مشق دِژ، تٔمؠ لیٚوکھ تتھ پؠٹھ، "تسُند ناو یوحناؔ، "یِم لوٗکھ تتہِ ٲسؠ تِم سأری گییہِ حٲران!
\v 64 تمہِ وزِ ہیٚچ ذکریاہنؔ دُبارٕ کتھ کٔرتھ، تہٕ سُہ لوٚگ خدایس تعریف کرنہِ۔
\v 65 ییٚلہِ نکھٕ روزَن والیو لوٗکو یمَن چیزن متعلق بوز، تِمن منٛز گوٚو خدایہِ سُنٛد بڈٕ احترام پٲدٕ۔ تِمو ووٚن باقیو واریہن لوٗکن اتھ واقہٕ ہَس متعلق، تہٕ یہِ خبر پھہٲلییہِ یہُودیہ کیٚن تمام پہڑی علاقہٕ کین لوٗکن منٛز۔
\v 66 ہر کانٛسہِ یمؠ تہِ یِمن چیزن متعلق بوز، روٗد یِمن متعلق سونٛچان۔ تِمو سونٛچ زِ، "یقیناً آسہ یہِ شُر بوٗڈ گژھتھ سؠٹھاہ خاص!" تِمو سونٛچ یہِ اوٕ مۅکھٕ تکیازِ تِمو وُچھ تہِ خداوند اوس تہنٛزِ زندگی منٛز طاقتور انٛدازس منٛز موجود۔
\v 67 امہِ پتہٕ شُرؠ سُنٛد مول، ذکریاہؔ، کرِہے دُبارٕ کتھ، خدایہِ سنٛدؠ پاک روحن اوٚن ذکریاہؔ جوشش منٛز تہٕ تٔمؠ ونہِ خدایہِ سنٛدِ طرفہٕ یِمہٕ کتھٕ:
\v 68 \f + \fr 1‏:68 \ft زبُور111:9، 41:13\f* "تعریف تمِس خداوندس، یَس خدایس، اسرائیل لٕکؠ لوٗکھ عبادت کران چھِ، تکیازِ سُہ چُھ پننٮ۪ن لوٗکن آزاد کرنہِ آمُت۔
\v 69 \f + \fr 1‏:69 \ft زبُور 132:17، یرمیاہ 30:9\f* تٔمؠ چُھ کُستام سوزمُت یُس اسہِ؛ طاقتہٕ سان بچاوِ، کُستام یُس داوودنہِ ذٲژ منٛزٕ آسہ، یمِس سُہ بادشاہ ژارِ۔
\v 70 واریاہ برونٛہہ اوس خداین پننؠن نبین وننُک معرفت عطا کوٚڑمُت زِ سُہ کرِ تِم چیٖز۔
\v 71 \f + \fr 1‏:71 \ft زبُور 106:10\f* خدا چُھ یہِ واتناون وول اسہِ دُشمنو نِشہ بچاونہٕ باپتھ سوزان، تہٕ سُہ بچاوِ اسہِ پرٛتھ کانٛسہِ ۂنٛدِ ظُلمہٕ نِشہ یُس اسہِ نفرت کران چُھ۔
\v 72 خداین چُھ یہِ کوٚڑمُت تکیازِ سُہ چُھ سانیٚن جَدن ہُنٛد وفادار تہٕ اوے چُھ سُہ پاک وادٕ نباوان یُس تٔمؠ تِمن سٟتؠ کوٚڑمُت چُھ۔
\v 73 \f + \fr 1‏:73 \ft پٲدٲیشؠ 17:7، زبُور 105:8۔ 9\f* یہِ چُھ سُہ وعدٕ یُس تٔمؠ ابرہامؔس قسم کھیٚتھ اسہِ متعلق کوٚڑمُت چُھ زِ سُہ کیاہ کرِ سانہِ خٲطرٕ۔
\v 74 تٔمؠ چُھ وادٕ کوٚرمُت زِ سُہ بچاوِ اسہِ دُشمنَن ہنٛدِ ظلمہٕ نِشہ، تاکہِ أسؠ کرو تمؠ سنٛز خدمت کانٛسہِ کھۅژنہٕ وراے۔
\v 75 تاکہِ تس سنٛزِ بارگاہِ منٛز گُذارو أسؠ سیٚزرٕکؠ تہٕ پزرٕکؠ دوٚہہ یۅتام ٲسؠ زندٕ روزیٚو۔"
\v 76 \f + \fr 1‏:76 \ft ملاکی 3:1، یسعیاہؔ 40:3\f* پتہٕ ووٚن ذکریاہنؔ پننِس بچس، "میانہِ گۅبریا، یوتتام زن چون تعلق چُھ، ژٕ آسکھ تمِس سارِوے کھۅتہٕ بٔڈِس خدایہِ سُنٛد اکھ نبی۔ ژٕ کرَکھ پنٕنؠ کٲم خداوند ینہٕ برونٛہہ شروع تاکہِ ژٕ کرہکھ لوٗکھ تسَنٛدِ باپتھ تیار۔
\v 77 ژٕ وُنکھ خدایہِ سنٛدین لوٗکن زِ سُہ چُھ یژھان تِمن تِہنٛدؠ گناہ معاف کٔرِتھ نجات دیُن۔
\v 78 خدا چُھ اسہِ یژھان بچاوُن تکیازِ سُہ چُھ رحم کرن وول تہٕ رحم دل۔ تمہِ سببہٕ چُھ سُہ اسہِ مدد کرنہٕ خٲطرٕ آسمانہٕ پؠٹھٕ پنُن یہِ نجات دِنہٕ وول سوزان۔
\v 79 \f + \fr 1‏:79 \ft یسعیاہؔ 58:8، 60:1۔ 2، 9:2\f*یہِ نجات دِنہٕ وول ہاوِ تِمن پزرچ وتھ یمن نہٕ پتاہ چُھ، حتاکہ تِمن تہِ یمن نہٕ امِچ کینٛہہ خبر چھےٚ۔ سُہ ہاوِ اسہِ زندگی گُذارنچ سۅ وتھ یۅسہ خدایس خوش گژھِ۔"
\v 80 وقت گذرنس سٟتؠ سٟتؠ گو ذکریاہؔ تہٕ الیشِبعؔ سُنٛد بچہ بوٚڈ تہٕ روحانی طور سپُد مظبوط۔ پتہٕ گوٚو سُہ أکِس وٲران علاقس کُن۔ سُہ رود تمہِ وزِ تہِ تٔتی ییٚلہِ تٔمؠ نٔنؠ پٲٹھؠ خدایہِ سنٛدین اسرائیلی لوٗکن تبلیغ کرُن شروٗع کوٚر۔
\c 2
\p
\v 1 بیٚیہِ تٔتھؠ وقتس دوران، قیصر اوگوستُسنؔ یُس سٲرسےٕ رومسؔ پٮ۪ٹھ حکومت کران اوس، کوٚر اکھ فرمان جٲری زِ تہنٛدس سلطنتس منٛز روزَن وول ہرکانٛہہ نفر گژھہِ پنُن پان درج کرناوُن۔ تسُنٛد ناو گژھہِ سرکٲرؠ فہرستس منٛز درٕج یُس تتہِ روزان اوس۔
\v 2 یہِ اوس گوٚڈنچہِ لٹہِ زِ أکؠ رومی حکمرانن کٔر پننِس سلطنتس منٛز مردم شمٲری۔ تِمو کوٚر یہِ تمہِ وزِ ییٚلہِ کورنیسؔ شامہٕ کِس صوبس حٲکم اوس۔
\v 3 اوے پیٚو ہرکانٛسہِ پننِس پننِس آبٲئی شہرس منٛز پنُن ناو درج کرناونہٕ باپتھ گژھن۔
\v 4‏-5 یوسفنؔ تہِ کوٚر پننِس آبٲئی شہرس کُن سفر، أمِس سٟتؠ ٲس مریمؔ، یۅسہ تمِس نیتھٕرؠ ٲس تہٕ ٲس گۅبِہ خۅر۔ تکیازِ یوسفؔ اوس داوود سنٛزِ زٲژ منٛزٕ، تِم درایہِ گلیل علاقکہِ ناصرت شہرِ پٮ۪ٹھٕ تہٕ یہُودیہ علاقہٕ کس بیت لحم شہرس کنُ کوٚرکھ سفر، یتھ داوود سُنٛد شہر تہِ ونان چھِ۔ یوسفؔ تہٕ مریمؔ گییہِ توٚت پنُن ناو عوٲمی فہرتس منٛز درج کرناونہٕ خٲطرٕ۔
\v 6‏-7 ییٚلہِ تِم بیت الحم وٲتؠ، تتہِ ٲس نہٕ بہنہٕ خٲطرٕ جایی یتہِ اکثر زیارت کرن والیٚن ہُنٛد یُن گژھن اوس۔ لہٰذا پیٚو تِمن راتس چارواین ہنٛدس أکِس گانَس منٛز روزُن یتہِ تِم شونٛگؠ۔ ییٚلہ تم تتہِ ٲسؠ مریم سنٛدِ خلٲصی ہُنٛد وق ووت تہٕ تمِس زاو پنُن گۅڈنیُک نیٚچو۔ تٔمؠ روٚٹ سُہ پلون ہٕنٛدیٚن بڑیٚن پٹیٚن منٛز تہٕ تھووُکھ سُہ تتھ گُدامس منٛز یتہِ چارواین باپتھ کھیٚن اوس۔
\v 8 تٔتھؠ راتس منٛز ٲسؠ کینٛہہ پٔہلؠ بیت الحمس نکھٕ کُھلہٕ مٲدانس منٛز ڈیرٕ دِتھ۔ تِم ٲسؠ پننِس جَبس رٲچھ کران۔
\v 9 اچانک وُچھ تِمو خداوند سُنٛد اکھ فرشتہٕ پانس برونٛہہ کنہِ کھڑا۔ خداوند سنٛدِ طرفہٕ پیٚو تِمن ژۅپٲرؠ خداوندٕ سٕنٛدِ جلالُک گاش۔ تِم کھوٚژؠ سخ۔
\v 10 مگر فرشتن ووٚن تِمن، "کھوژیٚو مٕہ! احتیاتہٕ سان بوزیٚو، تکیازِ بہٕ چُھس توٚہہِ اکھ رٕژ شیٚچھ وننہِ آمُت! یہِ شیٚچھ چھےٚسارنےٕ لوٗکن ۂنٛدِ باپتھ، تہٕ پرٛیتھ کانٛہہ سپدِ شادمان!
\v 11 تِمن گژھِ بٔڈ خوشی، تکیازِ از زاو داوود سنٛدِس شہر بیت الحمس منٛز اکھ شخص یُس توٚہہِ گُنہَو نِشہ نجات دییہِ! سُہ چُھ مسیحؔ، خداوند!
\v 12 تہٕ تُہنٛدِ خٲطرٕ چُھ یہِ اکھ نشانہٕ۔ ہرگاہ توٚہؠ بیت الحم گٔژھیو، توٚہؠ لٔبوون سُہ تتہِ أکِس زچہِ ہُرِس ؤلِتھ تہٕ سُہ آسہ چارواین ہنٛزِ نِگیہ منٛز۔"
\v 13 اچانک گییہِ فرشتن ہنٛز اکھ جماتھ باقین فرشتن سٟتؠ آسمانس پؠٹھ اظہار۔ تِم سٲری ٲسؠ خدایہِ سنٛدؠ تعریف کران یہِ ونان،
\v 14 "آسمانہِ بالا ہَس منٛز کرن سٲری فرشتہٕ خدایہِ سنٛدؠ تعریف! تہٕ زمینہِ پیٚٹھٕکؠ سٲری لوٗکھ یِم خدایس خوش کران چھِ روزَن امنہٕ سان خدایس سٟتؠ، تہٕ اکھ أکِس سٟتؠ تہِ!"
\v 15 ییٚلہِ فرشتہٕ تِمن نِش دراے تہٕ کٔتھؠ آسمانس کُن واپس، پہلیٚو وُن اکھ أکِس، "اسہِ پزِ وُنؠ بیت لحم گژُھن تہٕ یہِ حٲران کرن وول واقہٕ وچُھن یُس سپدیو، یتھ متعلق خداوندن اسہِ ووٚن!"
\v 16 أتی گےَ تِم جَل جَل، تہٕ ییٚلہِ تِمو سۅ جاے لٔب یتہِ مریمؔ تہٕ یوسفؔ ٹھہریمٕتؠ ٲسؠ، تِمو وُچھ سُہ بچہٕ یُس چارواین ہنٛزِ نِگیہ منٛز اوس۔
\v 17 تمِس وُچھنہٕ پتہٕ، ووٚن تِمو پرٛتھ أکِس تہِ یہِ خداوندن تِمن أمِس بچَس متعلق ووٚنمت اوس۔
\v 18 تِم سٲری لوٗکھ یِم بوزان ٲسؠ تِمو سونچ زِ یہِ پہلیٚو تِمن ووٚن اوس حٲران کرٕوُن۔
\v 19 پوٚز مریمؔن تھاوِ تِم سارے کتھٕ احتیاتہٕ سان یاد تہٕ تِمن متعلق روز لگاتار سونچان۔
\v 20 پٔہلؠ گے واپس، نیٖرین کُن یتہِ تِمن پنٕنؠ جَب ٲسؠ۔ تِم روٗدؠ خدایہِ سٕنٛدِس بُجرس متعلق کتھٕ کران تہٕ تمِس ٲسؠ تِمن چیٖزن متعلق تعریف کران یہِ تِمو بوز تہٕ وچُھکھ۔ ہرکانٛہہ چیٖز اوس برابر تی یہِ فرشتو تِمن ونمُت اوس زِ یتھ کِنؠ آسہ۔
\v 21 \f + \fr 2‏:21 \ft پٲدٲیشؠ 17:12، احبار 12:3\f*زیٚنہٕ پتہٕ ٲٹھِ دوٚہؠ، کرنو تِمو تس ختنہٕ تہٕ تمِس آو یسوعؔ ناو تھاونہٕ۔ یہِ اوس سُہ ناو یُس فرشتن مریمؔس تٔمؠ سُنٛد حمل لگنہٕ برونٛہہ ونمُت اوس۔
\v 22 \f + \fr 2‏:22 \ft احبار 12:6\f*مریمؔن تہٕ یوسفؔن کوٚر تِمن دوٚہُن انتظار یِم موسیٰؔ سٕنٛدِ شریعتہٕ مطٲبق اکھ بچہ زیٚنہٕ پتہٕ آب شیرنہٕ باپتھ ضروری ٲسؠ۔ پتہٕ اوٚن تِمو سُہ یروشلم یتہِ زن سُہ خداوندس ہیکلس منٛز پیش ییہِ ہےکرنہٕ۔
\v 23 \f + \fr 2‏:23 \ft خروج 13:2، 12\f* تِمو کوٚر یہِ خداوند سٕنٛدِ شریعتہٕ مطٲبق، یُس ونان چُھ، "توٚہہِ پزِ ہرکانٛہہ لٔڑکہٕ یُس گۅڈٕ زیوِ خداوندس آیہ تن تھاوُن۔"
\v 24 \f + \fr 2‏:24 \ft احبار 12:8\f*تِمو دِژ تتہِ سۅ قربٲنی یۅسہ خداوندن والدینن نو زادٕ شُر زیٚنس متعلق ونمٕژ ٲس، "قُمرؠ جوٗرؠ یا زٕ کوتُر بچہ۔"
\v 25 تمہِ وقتہٕ اوس یروشلمسؔ منٛز اکھ شخص یمِس شمعونؔ ناو اوس۔ سُہ اوس تیِ کران یہِ خدایس خوش کران اوس تہٕ خدایہِ سنٛدِس شریعتس پؠٹھ اوس پکان۔ سُہ اوس بیتٲبی سان خدایس مسیحؔ سوزنہٕ خٲطرٕ انتظار کران یُس اسرائیل کین لوٗکن حوصلہٕ افزایی کرِہے۔ پاک روح اوس تمِس رہبری کران۔
\v 26 پاک روحن اوس تمِس برونٛہہ بووٕمُت زِ یۅتام نہٕ سُہ خداوندٕ سُنٛد مسیحؔ وُچھ تۅتام مَرِ نہٕ سُہ۔
\v 27 اوے واتنوو پاک روحن شمعونؔ ہیکل کس آنٛگنس منٛز۔ سُہ اوس تٔتؠ ییٚلہِ یوسفنؔ تہٕ مریمنؔ یسوعؔ انٛدر ژون یُتھ زن تِم تسٕنٛدِ باپتھ سۅ تقریب انجام دِہَن یمیُک خداین شریعتس منٛز حکم کوٚرمُت اوس۔
\v 28 ییٚلہِ شمعوؔنن یسوعؔ وُچھ، تٔمؠ روٚٹ سُہ کۅچھِ منٛز تہٕ کوٚرن خدایہِ سُنٛد شُکر ادا، تہٕ پتہٕ ونُن،
\v 29 "خداوندٕ، ژےٚ کوٚڑُتھ مےٚ سٟتؠ کوٚرمُت وعدہ پورٕ، بہٕ چُھس چون سیٹھاہ مشکوٗر مےٚ دِ وُنؠ مَرنہٕ۔
\v 30 تکیازِ مےٚ وُچھ سُہ یُس ژےٚ لوٗکن نجات دِنہٕ باپتھ سوٗزمُت چُھتھن،
\v 31 سُہ اکھ یُس لوٗکن ہنٛدِ وُچھنہٕ خٲطرٕ تیار کوٚرمُت چُھتھن۔
\v 32 \f + \fr 2‏:32 \ft یسعیاہؔ 42:6، 49:6\f* سُہ آسہ اکھ گاش ہیو یُس باقین قومن چون پزر ہاوِ۔ سُہ ہاوِ چانین اسرائیل کیٚن لوٗکن ۂنٛدِ خٲطرٕ چٲنؠ کٟتیاہ شاندار منصوبہ۔"
\v 33 یسوعؔ سنٛدؠ مول تہٕ موج گییہِ حٲران تتھ پؠٹھ یہِ شمعوننؔ تمِس متعلق ووٚن۔
\v 34 \f + \fr 2‏:34 \ft یسعیاہؔ 8:14۔ 15\f* تہٕ شمعوننؔ کوٚر تِمن دُعا، تہٕ ونُن یسوعؔ سنٛزِ ماجہِ، مریمؔس، "اصل پٲٹھؠ تھاو یاد یہِ مےٚ ووٚن: خداین چُھ اِرادٕ کوٚرمُت زِ، یمِس بچہٕ سٕنٛدِ سببہٕ کرَن اسرائیل لٕکؠ واریاہ لوٗکھ خدایس اِنکار تہٕ واریاہ لوٗکھ انُن خدایس ایمان۔ سۅ آسہ اکھ نشٲنی خدایہِ سنٛدِ طرفہٕ زِ واریاہ لوٗکھ کرن برخلٲفی۔
\v 35 یۅتام چون تعلق چُھ، لوٗکھ کرن تمِس پؠٹھ تشدُد تیوتاہؔ ژٕ گژھکھ غمگیٖن تہٕ گژھی محسوس زنتہٕ آسہ تلوار چٲنس روحس گوٚد کران۔ مگر یہٕ چُھ ضروری زِ سُہٕ ہیٚکہ واریہن لوٗکن ہندین دِلن منز دِلٕکؠ خُفیہ گناہ ظٲہر کٔرِتھ۔"
\v 36 بیٚیہِ ٲس تتہِ اکھ نبیہؔ ہیکل کس آنٛگنس منٛز یمِس حنَاہ ناو اوس۔ یۅسہ واریاہ بُڈٕ ٲس۔ سۅ ٲس فنوایلؔ سنٛز کور، یۅسہ آشرؔ قبیلہٕ منٛزٕ ٲس۔ لوکچارسےٕ منٛز اوسُکھ تمِس خاندر کوٚرمُت، سۅ ٲس روٗزمٕژ پنِنس رٲنِس سٟتؠ سَتن ورؠ یَن، پتہٕ اوس تٔمؠ سُنٛد خاندار گُزریامُت۔
\v 37 تمہِ پتہٕ، روز سۅ مونٛڈ ژوِشیتن ورؠ یَن پیٚٹھی زندٕ۔ سۅ ٲس ہمیشہِ ہیکلس منٛزےٕ آسان، سۅ ٲس روزدر روٗزتھ ہر وزِ راتس دوٚہس خدایہ سنٛز عبادت کران۔
\v 38 \f + \fr 2‏:38 \ft یسعیاہؔ 52:9\f* تمی ساعتہٕ وٲژ حنَاہؔ، یوسفؔ، مریمؔ تہٕ تِہُنٛد بچہٕ۔ حناہؔ ہن لوگ خدایہِ سُنٛد شُکرانہٕ ادا کرُن، تمِس اولادٕ سنٛدِ خٲطرٕ۔ تمہِ پتہ روز سۅ باقین واریہن لوٗکن سٟتؠ کتھ کران یِم خدایہ سنٛدِ طرفہٕ مسیحؔ ینَس پراران ٲسؠ یُس اسرائیل کین لوٗکن نجات دِیہ ہے۔
\v 39 ییٚلہِ یوسفنؔ تہٕ مریمنؔ خداوندٕ سٕنٛدِ شریعتہٕ مطٲبق سُہ ہر کانٛہہ چیز انجام دِیت یہِ والدینن گوڈٕ نیُک اولاد زیٚنس پؠٹھ کرُن اوس۔ پتہٕ درٛایہِ تِم گلیل علاقہٕ منٛزٕ پنُن شہر ناصرت کنُ واپس۔
\v 40 سُہ بچہٕ ہیٚوتُن بوٚڈ بوٚڈ گژھُن، سُہ بنیاو طاقتور تہٕ سیٹھاہ گاٹل۔ خدا اوس تس سنٛزِ زندگی منٛز موجود۔
\v 41 یسوعؔ سنٛدؠ والدین مول تہٕ موج ٲسؠ پرٛیتھ ؤرؠ یہِ فَسح عید مناونہٕ خٲطرٕ یروشلم گژھان۔
\v 42 ییٚلہِ یسوعؔ باہ وُہر ووت، تِم سٲری گےَ یکجا بٔڈس دوٚہس یعنی فسح عیز ہنٛدس موقس پؠٹھ یروشلم۔
\v 43 ییٚلہِ بوٚڈ دوٚہہ مناونٕچ تقریب انٛد وٲژ، یسوعؔ سٕنٛدؠ مول تہٕ موج ٲسؠ گرٕ واپس وٲتؠ مٕتؠ، مگر تِہُنٛد نیٚچو، یسوعؔ رود پتھ یروشلمس منٛز۔ تسٕنٛدِس مٲلِس ماجہِ روزنہٕ خبرےٕ زِ سُہ چُھ وُنہِ تٔتی۔
\v 44 \f + \fr 2‏:44 \ft تقریبن 15۔ 20 میٖل20۔ 30 میٖل\f*تِمو سونچ زِ سُہ آسہ باقی نفرن سٟتؠ پکان۔ پوٚز اکہ دوٚہُک سفر طے کرنہٕ پتہٕ لوگ تِمو سُہ پننؠن رشتہٕ دارن تہٕ دوستن نِشہ ژھانٛڈُن۔
\v 45 ییٚلہِ نہٕ تِمو سُہ لوٚب، تِم گےَ تمِس ژھانٛڈنہِ واپس یروشلم۔
\v 46 ترٛیہِ دوٚہؠ یروشلمہٕؔ واپس نیرتھ، لوٚب تِمو یسوعؔ ہیکلس منٛز۔ سُہ اوس یہُودؠ مذہبی ووستادن منٛز بہتھ۔ سُہ اوس تِمن سوال کران تہٕ تہنٛز تعلیم بوزان۔
\v 47 سٲری بوزَن وٲلؠ لوٗکھ ٲسؠ تہنٛدس کلامَس پؠٹھ تعجب کران زِ سُہ کوتاہ سمٕجدار اوس تہٕ کٲتیاہ معقول جواب اوس تِمن سوالن دِوان یم وۅستاد تس پرٛژھان ٲسؠ۔
\v 48 ییٚلہِ سُہ پنٕنؠ مٲلؠ ماجہِ وُچھ تِم گےَ حٲران۔ تس سنٛزِ ماجہِ ووٚن تمِس، "میٚانہِ گۅبرا، ژےٚ پزی نہٕ یہِ اسہِ سٟتؠ کرُن۔ میٚون بوز! چون مول تہٕ بہٕ گٔیَس سیٹھاہ پریشان أسؠ چِھتھ ژٕ ژھپہِ ژھپہِ ژھاران!"
\v 49 تٔمؠ ووٚن تِمن، "بہٕ چُھس حٲران زِ توٚہہِ کیاہ ضرورتھ ٲس بہٕ ژھارنچ۔ مےٚ سونچ توٚہہِ آسہ پتاہ زِ مےٚ پیٚو ضرورت پنہٕ نِس مٲلؠ سنٛدِس گرس منٛز تمِس متعلق زاننہٕ خٲطرٕ روزُن۔"
\v 50 پوٚز تِمن توٚر نہٕ تمیُک مطلب فِکرِ یہِ تٔمؠ تِمن ووٚن۔
\v 51 پتہٕ گوٚو سُہ تِمنےٕ سٟتؠ ناصرت شہرس کُن واپس، سُہ رود تِمن ہمیشہِ فرمانبردار۔ تس سنٛز موج روز تِمن سارِنے چیزن متعلق سنٛجیدگی سان سونٛچان یِم سپدؠ مٕتؠ ٲسؠ۔
\v 52 وری واد گےَ گُزران، یسوعؔ\f + \fr 2‏:52 \ft 1 سمون 2:26، امثال 3:4\f* ہس رود گاٹہٕ جارس ہُریر سپدان، تہٕ بالیغ رود گژھان۔ خدایس تہٕ لوٗکن منٛز رود مقبولؠ یتس منٛز زیادٕ کھۅتہٕ زیادٕ ترقی پراوان۔
\c 3
\p
\v 1 یہِ دوٚیُم تٲریخی واقہٕ چُھ سپُدمُت تمہِ وزِ ییٚلہِ قیصر تبریُسؔ رومی سلطنتس پؠٹھ تقریبن پندہَن ورؠ ین حکومت کران چُھ اوسمُت۔ تمہِ وقتہٕ اوس، پنطیس پیلاطسؔ یہُودیہ صوبُک گورنر، ہیرودیس انٹیپس اوس گلیل علاقس حٲکم، تمہِ سُنٛد برادر فلپسؔ اوس اتوریہؔ تہٕ ترخونیِتس پؠٹھ حکومت کران تہٕ لسانیاسؔ اوس ابلینے علاقک حکمران۔
\v 2 اننیاسنؔ تہٕ کایفاؔ ٲسؠ یروشلمہٕؔ کس عبادت خانس منٛز امیر کاہن۔ تتھ وقتس دوران گوٚو خدایہِ سُنٛد کلام ذکریاہؔ سٕنٛدِس نیٚچوِس یوحناؔ ہس پؠٹھ ییٚلہِ سُہ زندٕ اوس دوٗر أکِس وُجارٕ علاقس منٛز نٲزل۔
\v 3 یوحناؔ ہَن کوٚر دریایہِ یردنس انٛدؠ پٔکؠ سارنےٕ علاقن ہُنٛد سفر۔ سُہ رود تِمن لوٗکن ونان یِم تس نِشہ بوزنہٕ خٲطرٕ وٲتؠ، "اگر توٚہؠ یژھان چُھو خدا گژھِ تُہنٛدؠ گناہ معاف کرُن، توٚہہِ پز نہٕ تیٚلہِ زندگی غلط طریقہٕ گُزارنؠ۔ پتہٕ دِمہٕ ہوو بہٕ توٚہہِ بپتسمہ۔
\v 4 ییٚلہِ یوحناؔ ہن امہِ انٛدازٕ تبلیغ کوٚر، تِم کتھٕ درٛایہِ پزٕ یمہٕ یسعیاہؔ نبی ین قول نامس منٛز واریاہ برونٹھ لیچھٕ۔ "کُس تام آسہ وُجٲرن منٛز لوٗکن ناد دِوان۔ پنُن پان کرِیو خداوندٕ سنٛدِ استقبالہٕ خٲطرٕ تیار! پنُن پان کرِیو تیار ییٚلہِ سُہ ییہِ!"
\v 5 ییٚلہِ اکھ خاص شخص اکہ خاص وتہِ ینہٕ وول چُھ، لوٗکھ کرِن سٲرےٕ وادی تہٕ تمام ڈھلوان جایہِ ہموار۔ تِم کرن تمہٕ وتہٕ سیٚود یمہٕ ہجہِ آسن، تہٕ تِم کرَن سٲری ٹٔھرؠ دور۔ تمہِ انٛدازٕ یُتھ خدایس یقین سپدِ زِ لوٗکھ گےَ مسیحؔ سٕنٛدِ خٲطرٕ تیار
\v 6 پتہٕ\f + \fr 3‏:6 \ft یسعیاہؔ 40:3۔ 5\f* وُچھِ پرٛیتھ کانٛہہ بشر خدایہِ سنٛز نجاتچ وتھ۔"
\v 7 لوٗکھ ٲسؠ بجن ٹوگجَن منٛز تسَ نِشہ بپتسمہ نِتھ نیران تتھ وٲرانس کُن نیران یتہِ یوحناؔ اوس۔ لہٰذا وُن تٔمؠ تِمن، "توٚہؠ لوٗکھ چُھو گبہِ بُتھِ رامہٕ ہوٗنؠ تہٕ زہریلہٕ سرفن ہنٛدؠ پٲٹھؠ خطرناک! توٚہؠ چُھو سونٛچان زِ اگر بہٕ توٚہہِ بپتسمہ دِمہٕ ہو، خدا بچاوِ توٚہہِ ییٚلہِ سُہ گناہ گارن سزا دِییہ، پوٚز مےٚ وُن نہٕ تہِ!
\v 8 توٚہہِ چھےٚ تِمہ کامہِ کرنٕچ ضرورت یِمہٕ ہاون زِ توٚہؠ کٔریو پتھ کُن گناہ گار طریقن پؠٹھ پکن والیٚن ہنٛز زندگی رَد! تہٕ پننِس پانس مٕہ دِیو یہِ ونِتھ تسلا زِ یقیٖنن دِیہ نہٕ اسہِ خدا سزا، تکیازِ أسؠ چھِ ابرہامؔ سنٛدیو وٲرثو منٛزٕ! خدایس چُھنہٕ تمیُک کانٛہہ پرواہ۔ بہٕ چُھس توٚہہِ یقین دِوان زِ خدا ہیٚکہ یِمن کنیٚن تہِ ابرہامؔ سنٛدین زُریٚن منٛز تبدیٖل کٔرِتھ!
\v 9 توٚہہِ چُھو تِمن میٚوٕ کُلیٚن ہُنٛدؠ پٲٹھؠ یِمن نہٕ رُت میٚوٕ نیران چُھ۔ خدا چُھ أکِس انسانہ سنٛدؠ پٲٹھؠ تِمن کُلیٚن گۅڈس مَکٕژ وایان، ٹُکراوِتھ چُھ تِمن زالان۔ اگر توٚہؠ گناہ کرٕنؠ جٲری تھایو خدا چُھ توٚہہِ تِتھے پٲٹھؠ سزا دِنس تیار۔"
\v 10 پتہٕ پرُوژھ تس ہُجومہٕ منٛزٕ کینٛژو لوٗکو، "خدا کمہِ قسمچہِ کامہِ چُھ یژھان اسہِ نِشہ؟"
\v 11 تٔمؠ دِیُت تِمن جواب، "اگر توٚہہِ منٛز کانٛسہِ زٕ کُرتٕنہِ آسن، توٚہہِ پزِ اکھ تمِس أکِس دِنؠ یمِس نہٕ اکھ کُرتٕنؠ تہِ آسہ۔ اگر توٚہہِ منٛز کانٛسہِ نِش غذآ موجود آسہ، توٚہہِ پزِ تمِس غذا واتناوُن یَس نہٕ غذا آسہ۔"
\v 12 گُذر ہیٚنہٕ وٲلؠ کینٛہہ نفر تہِ آے یوحناؔ ہس نِشہ بپتسمہ ننہِ باپتھ۔ تِمو پرُوژھ تس، "ووستاد، خدا کیاہ چُھ یژھان اسہِ نِش؟"
\v 13 تٔمؠ وُن تِمن، "رومی حکومتن یہِ توٚہہِ لوٗکن نِشہ جمع کرُن ووٚنمُت چُھ تمہِ کھۅتہٕ زیادٕ مٕہ ہِیو!"
\v 14 تتہِ ٲسؠ کینٛہہ نفر یِم سِپاہ ٲسؠ۔ تِمو تہِ پرُوژھ تسَ، "تہٕ اسہِ متعلق کیاہ چُھ؟ خدا کیاہ چُھ ونان اسہِ کرُن؟" تٔمؠ ووٚن تِمن، "کٲنسہِ پؠٹھ مہَ کٔریو ظلم تہٕ نہَ ہیو ناحقہ کٲنٛسہِ رۅپیہ۔ پننِس تنخاہس پؠٹھ کٔریو گُذارٕ۔"
\v 15 لوٗکھ ٲسؠ واریاہ وقتہٕ پؠٹھٕ مسیحؔ سٕنٛدِ ینُک انتظار کران۔ مگر وُنؠ ٲسؠ تِمن یوحناؔ سنٛز امید۔ تِمو سونچ زِ شاید چُھ یہےَ مسیحؔ۔
\v 16 مگر یوحناؔہن وُن تِمن، "بہٕ چُھس نہٕ مسیحؔ۔ مسیحؔ چُھ ینہٕ وول، تہٕ سُہ چُھ میانہِ کھۅتہٕ سیٹھاہ بوٚڈ۔ سُہ چُھ تیٚوتاہ طاقتور زِ بہٕ شوٗبہٕ نہٕ تس غلام تہِ یُس تس سنٛزِ کھۅربانہٕ مُژراوِ! بہٕ چُھس توٚہہِ آبہٕ سٟتؠ بپتسمہ دِوان۔ پوٚز ییٚلہِ مسیحؔ ییہِ، سُہ دییہِ توٚہہِ پاک روح سٟتؠ بپتسمہ، یُس توٚہہِ انصاف دییہِ تہٕ پاک کرِ۔
\v 17 سُہ چُھ یہِ کرنہٕ باپتھ تیار، یتھٕ پٲٹھؠ اکھ کۅمیٛل پنُن شُپ تہٕ واوٕ پٔٹ استعمال کرنہٕ باپتھ تیار آسان چُھ۔ سُہ چُھ فصلہٕ کیٚو رٕتیٚو دانو منٛز کِسٕر الگ کران تہٕ پتہٕ کُچھِ منٛز تراوان۔ مگر کِسٕر چُھ زالان۔ یتھےَ پٲٹھؠ کرِ مسیحؔ خدایس خوش کرَن والیٚن لوٗکن جمع، تہٕ تِمن لوٗکن دییہِ سزا یِم خدایس ناخوش کران آسن۔
\v 18 یوحناؔ ہن دِیُت یتھےَ پٲٹھؠ واریہو طریقو لوٗکن پؠٹھ زور۔ گُنہَو نِشہ باز یُن تہٕ پنن پان خدایس پُشراوُن۔ خدایہِ سنٛز رٕژ شیٚچھ تِمن ونان۔
\v 19 یوحناؔ ہَن کٔر بادشاہ ہیرودیسس تہِ واریہن تِمن بُرٕ کامیٚن پؠٹھ ملامت یمہٕ تٔمؠ کرِمَژٕ آسہ۔ پوٚز یوحناؔ ہَن کٔر ہیرودیسس تیلہِ تہِ ملامت ییٚلہِ تٔمؠ پننِس بٲے سنٛز آشنہِ ہیرودیسؔ سٟتؠ خاندر کوٚر ییٚلہِ زن ونہِ تمسُنٛد بوے پانہٕ زنٛدے اوس،
\v 20 ہیرودیسنؔ کرِ بیٚیہِ تہِ خراب کامہِ۔ تٔمؠ اوس یوحناؔ پنیٚن سِپہَن ہنٛدؠ دٔسؠ جیل بوٚرمُت۔
\v 21 مگر ہیرودیسؔ نہِ تہِ کرنہٕ برونٛہہ اوس یوحناؔ وُنہِ تہِ واریہن لوٗکن بپتسمہ دِوان، یوحناؔ ہَن دِیُت یسوعؔ ہس تہِ بپتسمہ۔ تمہِ پتہٕ، ییٚلہِ یسوعؔ دُعا اوس کران، آسمان آو مُژرنہٕ۔
\v 22 پتہٕ ووٚتھ پاک روح، کوترٕ سنٛزِ شکلہِ منٛز بوٚن تہٕ بیوٗٹھ یسوعؔ ہَس پؠٹھ۔ پتہٕ وُن خداین آسمانہٕ منٛزٕ یسوعؔ ہس۔ تٔمؠ ووٚن، "ژےٚ چُھکھ میٚون گۅبُر، یُس مےٚ سیٹھاہ ٹوٹھ چُھ۔ بہٕ چُھسے ژےٚ بالکل خوش!"
\v 23 تمی وزِ لاج یسوعؔن خدایہِ سنٛز کٲم شروع کرٕنؠ۔ تٔمؠ سنٛز وانٛس ٲسؠ تقریبن ترٛہہ ؤری۔ یسوعؔ سُنٛد خانٛدان چُھ یہِ: لوٗکھ ٲسؠ یسوعؔ ہس یوسفؔن نیٚچو مانان۔ یوسفؔ اوس عیلیؔ سُنٛد نیٚچو۔
\v 24 عیلیؔ اوس متاتؔ سُنٛد نیٚچو۔ متاتؔ ابنِ لاوی۔ لاوی ابنِ ملکیؔ۔ ملکی ابنِ یناؔ۔ ینا ابنِ یوسفؔ۔
\v 25 یوسف ابنِ متتیاہؔ۔ متتیاہ ابنِ عاموس۔ عاموس ابنِ ناحومؔ۔ ناحومؔ ابنِ اسلیاہؔ۔ اسلیاہ ابنِ نوگہؔ
\v 26 نوگہ ابنِ ماعتؔ۔ ماعت ابنِ متتیاہؔ ابنِ شمعیؔ۔ شعمی ابنِ یوسیخؔ۔ یوسیخ ابنِ یوداہؔ۔
\v 27 \f + \fr 3‏:27 \ft عزرا 3:2، نحمیاؔہ 12:2\f*یوداہؔ ابنِ یوحناؔ۔ یوحنا ابنِ ریساؔ۔ ریسا ابنِ زربابلؔ۔ زربابلؔ ابنِ سیالتیؔ۔ سیالتی ایلؔ ابنِ نیریؔ۔
\v 28 نیری ابنِ ملکیؔ۔ ملکی ابنِ ادیؔ۔ ادیؔ ابنِ قوسامؔ۔ قوسامؔ ابنِ المودامؔ۔ المودامؔ ابنِ عیرؔ۔
\v 29 عیر ابنِ یسوعؔ۔ یسوعؔ ابنِ الِیعزرؔ۔ العزر ابنِ یوریمؔ۔ یوریم ابنِ متاتؔ۔ متات ابنِ لاوی۔
\v 30 لاوی ابنِ شمعونؔ ابنِ یہُودؔ ابنِ یوسفؔ ابنِ یونانؔ ابنِ الیاقیمؔ۔
\v 31 \f + \fr 3‏:31 \ft 2 سموئیلؔ5:14\f*الیاقیمؔ ابنِ ملیاؔ ابنِ مناؔ ابنِ متتاؔ۔ متتاؔ ابنِ ناتنؔ ابنِ داوود۔
\v 32 \f + \fr 3‏:32 \ft راعوت 4:20۔ 22\f*داوود ابنِ یسیؔ ابنِ عوبیدؔ ابنِ بوعزؔ ابنِ سلمونؔ ابنِ نحسونؔ۔
\v 33 نحسونؔ ابنِ عِمیندآبؔ ابنِ ارنیؔ ابنِ حصرونؔ ابنِ فارصؔ ابنِ یہُوداؔ۔
\v 34 \f + \fr 3‏:34 \ft پیدٲیشؠ 21:3، 1توٲریخ 1:28۔ 34\f* یہودہؔ ابنِ یعقوبؔ ابنِ اضحاقؔ ابنِ ابرہامؔ ابنِ تارحؔ ابنِ نحورؔ۔
\v 35 نامورؔ ابنِ سروجؔ ابنِ رعوؔ ابنِ فالجؔ ابنِ عابرؔ ابنِ شالحؔ۔
\v 36 شالحؔ ابنِ قینانؔ ابنِ ارفکسدؔ ابنِ سمؔ ابنِ نوحؔ ابنِ لمکؔ۔
\v 37 لمکؔ ابنِ متوشالحؔ ابنِ حنوکؔ ابنِ یاردؔ ابنِ مہللؔ ابنِ قینانؔ۔
\v 38 \f + \fr 3‏:38 \ft پیدٲیشؠ 4:25، 5:32، 1 توٲریخ 1:1۔ 4\f* قینانؔ ابنِ انوشؔ ابنِ شیتؔ ابنِ آدمؔ یُس خدایہِ سنٛدِ طرفہٕ آو۔
\c 4
\p
\v 1 یوحناؔ سٕنٛدِ دسؠ بپتسمہ دِنہٕ پتہٕ، کھوٚت یسوعؔ دریایہِ یردنہٕ منٛز واپس۔ پاک روح اوس تس پورٕ پٲٹھؠ طاقت عطا کران۔ پتہٕ واتنوو پاک روحن سُہ وٲرانس منٛز۔
\v 2 ییٚلہِ یسوعؔ تتہِ اوس، شیطان رود تس آزماوان۔ یسوعؔن کھیٚو نہٕ تتھ وقتس دوران کانٛہہ تہِ چیز۔ لہٰذا ییٚلہِ تِم دوٚہہ انٛد وٲتؠ، تمِس لٔج بۅچھِ۔
\v 3 پتہ وُن شیطانن یسوعؔ ہس، "ہرگاہ ژٕ پٔزؠ پٲٹھؠ خدایہِ سُنٛد گۅبُر چُھکھ، یَتھ کنہِ کرِ حکم اتھ بنہِ اکھ ژوٚٹ چانہِ کھیٚنہٕ باپتھ!"
\v 4 \f + \fr 4‏:4 \ft تثنِیہ شرع 8:3\f* یسوعؔن دِتُس جواب، "نہٕ، بہٕ کرنہٕ تہِ، تکیازِ نوشتن منٛز چُھ لیٚکھتھ، لوٗکن چُھ غذاہس سٟتؠ سٟتؠ زندٕ روزنہٕ باپتھ خدایہِ سٕنٛدِ کلامچ تہِ ضرورت۔"
\v 5 پتہٕ نیٚو شیطانن یسوعؔ أکِس تھٔدِس بالس پٮ۪ٹھ  تہٕ أچھ ٹِٹوارِ منٛز ہاوِنس تمام دُنیاہچہِ سلطنتہٕ۔
\v 6 پتہٕ وُن ابلیسن یسوعؔ ہس، "بہٕ بنٲوِتھ ژٕ یِمن سارنےٕ سلطنتن ہُنٛد حکمران تہٕ ژےٚ میلی تِہنٛز تمام دولتھ۔ یہِ ہیٚکہٕ بہٕ کٔرِتھ تکیازِ خداین چُھ مےٚ تِم اختیارس منٛز تھاونُک اِجازتھ دِتمُت، بہٕ ہیٚکہٕ تہِ تمِس دِتھ یمِس یژھِ۔
\v 7 صرف چھی ژےٚ مےٚ سٔجدٕ کرُن تہٕ میانؠ عبادتھ کٔرنؠ۔ پتہٕ دِمے بہٕ ژےٚ تتھ سٲرسےٕ پؠٹھ حکومت کرنہٕ!"
\v 8 \f + \fr 4‏:8 \ft تثنِیہ شرع 6:13۔ 14\f*مگر یسوعؔن ونُس جوابس منٛز، "نہٕ، بہٕ کرِ نہٕ چٲنؠ عبادت، تکیازِ نوشتن منٛز چُھ لیٚکھتھ، "توٚہؠ کٔرِو صرف پننِس خداوند خدایہ سنٛز عبادتھ۔ سُے چُھ واحد عبادتس لایکھ!"
\v 9 پتہٕ نیٚو ابلیسن یسوعؔ یروشلم۔ تٔمؠ تھوٚو سُہ ہیکل کِس سارِوے کھۅتہٕ تھزِ جایہ پؠٹھ تہٕ ووٚننس، "اگر ژٕ پٔزؠ پٲٹھؠ خدایہِ سُنٛد گۅبُر چُھکھ، یتہِ پؠٹھ ترٛاو تیٚلہِ بوٚن کُن ووٚٹھ۔
\v 10 ژٕ گٔژھکھ نہٕ زَخمی، تکیازِ نوشتن منٛز چُھ لیٚکھتھ، "خدایہِ دییہِ پننٮ۪ن فرشتن چانہِ بچاونُک حکم۔"
\v 11 \f + \fr 4‏:11 \ft زبُور 91:11۔ 12\f* تہٕ نوشتن منٛز چُھ یتہِ درٕج، فرشتہٕ رٹنے ژےٚ پننٮ۪ن اتھن منٛز ییٚلہِ ژٕ بوٚن آسکھ پیوان، توے لگی نہٕ ژےٚ زَخم تہِ۔"
\v 12 \f + \fr 4‏:12 \ft تثنِیہ شرع 6:16\f*یسوعؔن دِیُت تس جواب، "نَہ، بہٕ کرٕ نہٕ تہِ، تکیازِ نوشتن منٛز چُھ یتہِ لیٚکھتھ زِ، "پنُن خداوندٕ خدا مٕہ ازمٲوؠ ووٚن۔"
\v 13 پتہٕ، ابلیس ییٚلہِ رنگہٕ رنگہٕ یسوعؔ ہَس ازمٲیشہ کٔرتھ سپدیو، ابلیسن تُروو یسوعؔ تہٕ کوٚرُن دوٚیمہِ لٹہِ تس انتظار۔ ییٚلہِ سُہ یسوعؔ ہَس دُبارٕ آزماونچ کوٗشش کرِ ہے۔
\v 14 یسوعؔ درٛاو تمہِ پتہٕ امہِ وُجارٕ علاقہٕ منٛزٕ تہٕ آو گلیل کِس علاقس کُن۔ پاک روح اوس تس طاقت بخشان۔ تمہِ علاقہٕ کیٚن لوٗکن لٔج یسوعؔ ہس متعلق پتاہ تہٕ تِمو وُن باقین تہِ أمِس متعلق۔
\v 15 تٔمؠ دِژ تِمن تہنٛدؠن یہُودؠ عبادت گاہن منٛز تعلیم۔ تٔمیُک نتِجہ درٛاو یہِ زِ تمام لوٗکھ یمو ہنٕنؠ تعلیم حٲصِل کٔر کٔرؠ تسَ تعریف۔
\v 16 پتہٕ گوٚو یسوعؔ ناصرت شہرس منٛز یتہِ سُہ بوٚڈ گوٚمُت اوس۔ پننہِ دستوٗرٕ مطٲبق گو سُہ سبتکہٕ دوٚہہ یہُودؠ عبادت خانس منٛز۔ عٲنہِ موقعس پؠٹھ ووٚتھ سُہ پرنہٕ خٲطرٕ تھوٚد تہٕ پٔرِنؠ بڈِ بڈِ صحیفہٕ۔
\v 17 یسوعؔ اوس کتابہِ ہنٛدؠ تِم کینٛہہ الفاظ یژھان پرٕنؠ یِم یسعیاہؔ نبیین واریاہ برونٛٹھ ونمٕتؠ ٲسؠ۔ اوے موٚنگ تٔمؠ سُہ طوٗمار یتھ پؠٹھ یِم الفاظ ٲسؠ، تہٕ ہیکلٕکؠ اکؠ خدمت گُزارن دِتُس سُہ۔ یسوعؔن مُژرو یہِ طوٗمار تہٕ لبُن تہِ یہِ سُہ برُن یژھان اوس۔ تٔمؠ پٔرؠ یِم الفاظ:
\v 18 \f + \fr 4‏:18 \ft یسعیاہؔ 58:6، 61:1۔ 2\f* خداوندٕ سُنٛد روح چُھ مےٚ با اختیار بناوان، تکیازِ تٔمؠ چُھس بہٕ خصوصن مسکینن تام خدایہِ سنٛز رٕژ شیٚچھ واتہٕ ناونہٕ باپتھ مقرر کوٚرمُت۔ تٔمؠ چُھس بہٕ تِم لوٗکھ باخبر کرنہٕ باپتھ سوٗزمُت یِم قٲدس منٛز چھِ زِ تِم سَپدن آزاد، تہٕ انُن ونُن زِ تِمن ییہِ دُبارٕ گاش۔
\q1 تٔمؠ چُھس بہٕ تِم لوٗکھ آزاد کرنہِ باپتھ سوٗزمتُ یِم باقیو لوٗکو لتہٕ مۅنٛجہ کٔرمٕتؠ چھِ
\v 19 تہٕ اعلان کرُن زِ وُنؠ چُھ سُہ وقت ییٚلہِ خداوند لوٗکن سٟتؠ رٕتؠ پٲٹھؠ پیش ییہِ۔"
\v 20 پتہٕ وٹُن سُہ کاغذ رول تہٕ دِتُن تمِس خدمت گارس واپس، پتہٕ بیوٹھ پتھر لوٗکن تعلیم دِنہِ۔ یہُودؠ عبادت گاہس منٛز اوس ہَر کانٛہہ تمِس دِل دِتھ وُچھان۔
\v 21 تٔمؠ لٲج تِمن یہِ ونان تعلیم دِنؠ زِ، "از چُھ مےٚ یہِ صحیفہٕ پوٗرٕ کوٚرمُت یُس مےٚ تُہنٛدِ بوزنہٕ باپتھ پوٚر۔"
\v 22 \f + \fr 4‏:22 \ft لوقا 2:42، زبُور 45:2\f*تتہِ کوٚر ہر اکؠ سُہ پسنٛد تہٕ سپد تہنٛزن عجیب کتھن پؠٹھ حٲران۔ واریہو وُن اکھ أکِس، "أمؠ سُنٛد یتھٕ پٲٹھؠ ونُن چُھ حٲران کران! یہِ چُھ یوسفُنؔ نیٚچو!"
\v 23 تٔمؠ وُن تِمن، "توٚہہ منٛزٕ دِین مےٚ کانٛہہ یقینہٕ سان سۅ مثال زِ، "طبیٖبہٕ ژٕ کرِ پننِس پانس طبابتھ! امیٚک مطلب گوٚو زِ لوٗکن ہُنٛد ونُن چُھ، ژےٚ ہٲوِتھ کفرنحوم شہرس منٛز معجزٕ۔ ہرگاہ ژٕ باوُن یژھان چُھکھ زِ ژٕ چُھکھ اکھ نبی، تیلہِ ہاو تِمے معجزٕ پننِس شہرس منٛز تہِ!"
\v 24 پتہٕ وُن تٔمؠ، "یہِ چُھ یقیناً پوٚز زِ پرٮ۪تھ کانٛہہ رسول چُھ پننِہِ آبٲئی قصبہٕ کیٚو لوٗکو مسترد کوٚرمُت۔
\v 25 \f + \fr 4‏:25 \ft توٲریخ 1۔ 17:1، 18:1\f* یتھ متعلق سونٛچو: اسرائیلس منٛز آسہ واریاہ مونٛڈٕ ییٚلہِ ایلیاہؔ نبی زندٕ اوس۔ تمہِ وقتہٕ پیٚو نہٕ ترٛین ؤرین تہٕ شیٚن ریٚتن رود۔ تمہِ سٟتؠ ووٚتھ سٲرسےٕ ملکس منٛز زبردست دراگ۔
\v 26 تمہِ پتہٕ سوز نہٕ خداین کانٛسہِ مونٛڈِ اسرائیلس منٛز ایلیاہؔ مدد کرنہٕ خٲطرٕ۔ تمہِ بجایہ سوز سُہ خداین صَیدا شہرس نکھٕ صارپت قصبس منٛز أکِس غٲر اسرائیلی مونٛڈِ مدد کرنہٕ باپتھ۔
\v 27 \f + \fr 4‏:27 \ft توٲریخ 2۔ 5:1۔ 14\f* اسرائیلس منٛز ٲسؠ تمہِ وقتہٕ واریاہ مینٛدؠ لد ییٚلہِ الیشعؔ نبی زندٕ اوس۔ پوٚز الیشعؔ ہن بٔلرٲو نہٕ تِمو منٛز کانٛہہ۔ تمہِ بجایہ، تٔمؠ بٔلروو شام ملکُک اکھ غٲر اسرائیلی شخص نعمانؔ سوریانی۔"
\v 28 یہُودؠ عبادت خانس منٛز ییٚلہِ تمام لوٗکو تمہِ سنٛزٕ تمہٕ کتھٕ بوزٕ، تِمن کھۅت سیٹھاہ شرارتھ۔
\v 29 أتی ؤتھؠ تِم تھوٚد، یسوعؔ رۅٹُکھ، تہٕ کۅڈکھ شہرٕ منٛزٕ کھکھرِ نیٚبر۔ تِمو نیٚو سُہ پننہِ شہرٕ نیٚبر تہٕ کھولُکھ بالہٕ تھونٛگِس پؠٹھ یُتھ زن تمِس تمہِ تھونٛگہِ پؠٹھٕ تِم دٲرِتھ دِتھ مارٕہَن۔
\v 30 مگر یسوعؔ درٛاو سیٚود پٲٹھؠ تمہِ جمگٹھٕ منٛزٕ تہٕ ژوٚل۔
\v 31 تتہِ پؠٹھ وُتھ یسوعؔ گلیل علاقہٕ کس أکِس شہرس کفرنحومس کنُ۔ پرٛتھ سبتکہِ دوٚہہ اوس سُہ یہُودؠ عبادت خانس منٛز لوٗکن تعلیم دِوان۔
\v 32 لوٗکھ گییہِ تٔمؠ سنٛز تعلیم بوزِتھ حٲران، تکیازِ سُہ اوس أکِس صاحبہِ اختیار سنٛدؠ پٲٹھؠ کِتھہٕ کران۔
\v 33 وُنؠ اوس تتھ یہُودؠ عبادت خانس منٛز اکھ نفر یمِس بد روح پرؠکس اوس۔ تٔمؠ دِژ زورٕ کرٛیکھ۔
\v 34 "اے! یسوعؔ ناصری! ژےٚ کیاہ چھی اسہِ سٟتؠ؟ ژٕ چُھکھا اسہِ مارنہِ آمُت؟ مےٚ چھےٚ پتاہ ژٕ کُس چُھکھ! ژٕ چُھکھ اکھ مقدس یُس خدایہِ سٕنٛدِ پٮ۪ٹھٕ آمُت چُھ!"
\v 35 مگر یسوعؔن وُن تمِس بدروحس سَختی سان، "ژھۅپہٕ کرِ تہٕ أمِس منٛز نیر نیٚبر!" تٔمؠ بدروحن دیُت تمِس نفرس لوٗکن منز زمینہِ پؠٹھ دب۔ مگر تمِس منٛزٕ درٛاو کانٛہہ زَرؠر واتناونہٕ ورٲے نیٚبر۔
\v 36 یہُودؠ عبادت خانس منٛز سَپدؠ سٲری لوٗکھ حٲران۔ واریہو وُن اکھ أکِس، "اسہِ چُھنہٕ یتھٕ پٲٹھؠ زانٛہہ وُچھمُت! یہنٛزن کتھن منٛز چُھ تیوٗت زور زِ یہِ چُھ بد روحن تہِ حکم کران تہٕ تِم تہِ چھِ نیٚبر نیران۔"
\v 37 انٛدؠ پٔکؠ سٲرسےٕ علاقس منٛز روٗدؠ لوٗکھ یسوعؔ ہس متعلق کِتھہٕ کران، تتھ متعلق یہِ تٔمؠ کوٚرمُت اوس۔
\v 38 یسوعؔ ووٚتھ پتہٕ یہُودؠ عبادت خانہٕ منٛز تہٕ گوٚو شمعونؔ سٕنٛدِس گرس منٛز۔ تتہِ ٲس تٔمؠ سنٛز ہَش۔ سۅ ٲس بیمار سیٹھاہ تپھ اوسُس۔ لوٗکو کوٚر یسوعسؔ زارٕ پارٕ سۅ بٔلراونہٕ خٲطرٕ۔
\v 39 لہٰذا گو یسوعؔ تہٕ رود تمِس نکھٕ اِستادٕ۔ تٔمؠ کوٚر تپس حکم سۅ یلہِ ترٛاونُک، تی سَپد تہِ!  امہِ پتہٕ جلدےٕ ؤژھ سۅ تھوٚد تہٕ انُن تہنٛدِ خٲطرٕ غذا بنٲوِتھ۔
\v 40 یہُودؠ سبت دوٚہُک آفتاب لوسَن وزِ أنؠ واریہو لوٗکو پنٕنؠ انٛگ ٲشناو تہٕ دوس یمَن رنٛگہٕ رنٛگہٕ بیمارِ آسہ یسوعؔ ہَس نِشہ، سُہ اوس پرٛتھ أکِس پنُن اتھٕ ڈالان تہٕ بٔلراوان۔
\v 41 یتھُے یسوعؔ پنُن اتھٕ بیمارن ڈالاناوس واریہو بیمارو منٛزٕ ٲسؠ بد روح نیٚبر نیران۔ تہٕ بد روح نیٚبر نیرتھےٕ ٲسؠ تم یسوعؔ ہَس کُن وُچِھتھ کرٮ۪کہٕ دِوان۔ "ژٕ چُھکھ خدایہِ سُنٛد گۅبُر!" مگر تٔمؠ کوٚر تِمن بد روحن حکم لوٗکن گژھِ نہٕ ونُن تمِس متعلق، تکیازِ تِمن لگہ نہٕ پتاہ زِ سُہ اوس مسیحؔ۔
\v 42 صبحس سُلے گو یسوعؔ أکِس وجارٕ جایہِ۔ لُکہٕ جمٲژ درایہ تمِس ژھانڈانہِ۔ ییٚلہِ تِم تمِس نِشہ واژٕ، تِمو کٔر کوشِش سُہ رکاونچ زِ ژمہٕ گژھِ اسہِ نِشہ دوٗر۔
\v 43 مگر یسوعؔن وُن تِمن، "مےٚ چُھ ضرور باقیو شہرن منٛز واتُن تہٕ لوٗکن خدایہِ سٕنٛدِ عظمتٕچ شیٚچھ باوُنؠ، تکیازِ بہٕ چُھس خداین یی کرنہِ یور سوزمُت۔"
\v 44 لہٰذا رود سُہ یہُودیہ صوبہٕ کیٚن سارنےٕ یہُودؠ عبادت خانن منٛز تبلیغ کران۔
\c 5
\p
\v 1 اکہ دوٚہہ ییٚلہِ لوٗکن ہُنٛد بوٚڈ ہجوم یسوعؔ ہس انٛدؠ انٛدؠ تمِس نِشہ خدایہِ سُنٛد کلام بوزان ٲسؠ، سُہ اوس استادٕ گنیسرتؔ سرس نزدیک۔\f + \fr 5‏:1 \ft گنیسرتؔ جِیٖل چُھ گلیل جِیٖلس بیاکھ ناو۔ احبار 14:2\f*
\v 2 تٔمؠ وُچھ سَرٕ کِس انٛدس پؠٹھ گاڑٕ رٹنچہِ زٕ ناوٕ۔ تِم ناوٕ آسہ گاڈٕ ہٲنزو تراوِمژٕ تہٕ پانہٕ ٲسؠ پنٕنؠ زال چھلان۔
\v 3 یسوعؔ ووٚتھ تِمو دوٚیو ناوو منٛزٕ أکِس ناوِ منٛز یۅسہ شمعوننٕؠ ٲس۔ یسوعؔن وُن تمِس ناو پکناو بٹھِ نِشہ ہناہ دوٗر۔ پتہٕ بیٚوٹھ یسوعؔ ناوِ منٛز تہٕ روٗد لُکہٕ ہجومَس تٔتی پؠٹھہٕ تعلیم دِوان۔
\v 4 تعلیم سپدٲوِتھ، ووٚن تٔمؠ شمعونسؔ، "سَنرس کُن نہِ ناو تہٕ پنُن زال ترٛاو گاڈٕ رٹنہٕ باپتھ آبس۔"
\v 5 شمعوننؔ دیُت جواب، "وۅستادٕ، اسہِ کٔر سٲرسےٕ راتس سخ محنتھ مگر تمہِ پتہٕ تہِ رٔٹ نہٕ کانٛہہ گاڈ۔ وۅنؠ تراوٕ بہٕ تُہنٛدِس وننَس پؠٹھ دُبارٕ زال۔"
\v 6 لہٰذا ترٲوؠ شمعوننؔ تہٕ تسنٛدیو اہلہِ کارو دُبارٕ پنٕنؠ زال تہٕ تِمو روٚٹ گاڈن ہُنٛد اکھ بوٚڈ ڈیر زنتہٕ تہنٛدؠ زال پھَٹنہِ لٔگؠ۔
\v 7 تِمو کوٚر پننٮ۪ن گاڈٕ ہانٛز سٲتھین اشارٕ تِمن مدد کرنُک۔ تِم تہِ آے تہٕ دۅشونی ناون منٛز بریکھ تیژٕ گاڈٕ زِ ناوٕ لجہِ ڈُبنہِ۔
\v 8 یہِ وُچِھتھ کوٚر شمعون پطرسؔن یسوعؔ ہس سٕجدٕ تہٕ وُنکھ، "مہربٲنی کٔرِتھ ترٛاو مےٚ یلہٕ، تکیازِ بہٕ چُھس اکھ گناہ گار انسان، خداوندٕ۔"
\v 9 تٔمؠ ووٚن یہِ اوٕ موٚکھٕ تکیازِ سُہ گوٚو حٲران زِ تِمو کٲتِس بٔڈِس تعدادس منٛز آسہٕ گاڈٕ رچمژٕ۔ تِم نفر تہِ گےَ حٲران یِم تمِس سٟتؠ ٲسؠ۔
\v 10 زبیدیؔ سنٛدؠ شُرؠ یعقوبؔ تہٕ یوحناؔ، یم شمعونؔس شریک ٲسؠ تہِ سپد یتھےَ پٲٹھؠ حٲران۔ مگر یسوعؔن وُن تِمن، "کھۅژیٚو مٕہ! ونیُک تام رچیٚو توٚہہ گاڈٕ، تہٕ وُنؠ رٔٹہوٗوکھ لوٗکھ میأنؠ شٲگرد بننہٕ باپتھ۔"
\v 11 امہِ پتہٕ انہِ تِمو نفرو بٔٹھس کُن ناوٕ، تِمو ترٛوو پنُن گاڈن ہُنٛد کاروبار تہٕ سورےٕ کینٛہہ أتی تہٕ درٛاے یسوعؔ ہس سٟتؠ۔
\v 12 یسوعؔ گو نزدیکےٕ أکِس شہرس منٛز۔ تتہِ اوس اکھ نفرا یمِس ژَمہ ہنٛز بٮ۪مارِ سٲرسےٕ جسمَس ٲس۔ ییٚلہِ تٔمؠ یسوعؔ وُچھ، تٔمؠ ترٛوو زمینہِ پؠٹھ تمِس برونٹھہٕ کنہِ سٔجدٕ۔ تٔمؠ کوٚر تس زارٕ پارٕ، "خداوندٕ، مہربٲنی کٔرِتھ بلراو مےٚ! مےٚ چھےٚ پتاہ ژٕ ہیٚککھ مےٚ بٔلراوتھ ہرگاہ ژٕ یژَھکھ!"
\v 13 پتہٕ کوٚڈ یسوعؔن پنُن اتھٕ تہٕ لوگُن تمِس نفرس۔ تٔمؠ وُن، "بہٕ چُھس یژھان ژٕ گژھُن تہٕ وُنؠ بٔلراوتھ بہٕ ژٕ!" سُہ نفر گوٚو یکدم ٹھیک۔ تمِس رود نہٕ وُنؠ میونٛد!
\v 14 پتہٕ ووٚن یسوعؔ ہَن تمِس، "یہِ ؤنؠ زیٚنہٕ کٲنٛسہِ زِ مےٚ کوٚرکھ ژٕ ٹھیک۔ گوٚڈٕ گژھِ تہِ پنُن پان ہاو أکِس کاہنس زِ سُہ ہیٚکہِ تُہنٛد معاینہٕ کٔرِتھ تہٕ ہیٚکہِ زٲنِتھ زِ توٚہہِ چُھنہٕ وۅنؠ میونٛد۔ سُہ نیاز کرِ پیش یُس رسمی طور ٹھیک سپدن پتہٕ کرُن چُھ آسان، یمیُک موسیٰؔ ہن حکم کوٚڑمُت چُھ۔"
\v 15 پوٚز تمہِ بجایہ بوز واریہو لوٗکو یسوعؔ ہس متعلق زِ تٔمؠ کِتھہٕ پٲٹھؠ کوٚر سُہ نفر ٹھیک۔ امہ سٟتؠ آیہِ لوٗکن ہنٛدؠ بٔڈؠ بٔڈؠ ہجوم یسوعؔ سنٛز تعلیم بوٗزنہِ تہٕ تہنٛزن بیمارؠن سپُد شفا۔
\v 16 پوٚز سُہ اوس اکثر لوٗکن نِش دوٗر ہیٚوان تہٕ وجارٕ علاقن کنُ ژلان پتہ تتہِ دُعایہ خٲر کران۔
\v 17 اکہ دوٚہہ ییٚلہِ یسوعؔ تعلیم دِوان اوس، کینٛہہ فریسی نفر تہٕ یہُودؠ شریعتکؠ مأہر وۅستاد ٲسؠ نکھٕ بہتھ۔ تِمو منٛزٕ ٲسؠ کینٛہہ گلیل علاقہٕ کیٚن گامن ہنٛدؠ تہٕ کینٛہہ یروشلمٕکؠؔ تہٕ کینٛہہ یہُودیہ صوبہٕ کیٚو باقیو شہرو پٮ۪ٹھٕ آمٕتؠ۔ تمی ساعتہٕ اوس خداوند یسوعؔ ہس لوٗکن شفا بخشنُک طاقت عطا کران۔
\v 18 یمہِ ساعتہٕ یسوعؔ تتہِ اوس، کینٛہہ نفر آے اکھ فالجہِ لد نفر ہیٚتھ۔ تِم ٲسؠ تمِس نفرس ڈانٛجہِ پؠٹھ پکناوان تہٕ تِم ٲسؠ تمِس تتھ مکانس منٛز نِنٕچ کوشِش کران یُتھ زن یسوعؔ ہس برونٛہہ کنہِ تھاو ہنَس۔
\v 19 مگر تتھ مکانس منٛز اوس لوٗکن ہُنٛد اکھ بوٗڈ ہجوم، تِمو ہیٚوک نہٕ انٛدر ژٲنتھ۔ لہٰذا کٔھتؠ تِم نیٚبرؠ کِنؠ مکانہٕ کِس پشش پؠٹھ۔ تِمو کوٚر پشہٕ کِنؠ وۅگہٕ تہٕ پتہٕ وولُکھ سُہ نفر ڈٲنج ہیٚتھ تمی وۅگہٕ کِنؠ بوٚن۔ لوٗکن ہنٛدِ ہجومہٕ منٛزؠ تھوٚوکھ یسوعؔ ہس برونٛہہ کنہِ۔
\v 20 یسوعؔ ہَس ییٚلہِ پژھ بیٹھ زِ سُہ ہیٚکہِ تمِس ٹھیک کٔرِتھ، تٔمؠ وُن تمِس، "دوستا، بہٕ چُھس چٲنؠ گناہ معاف کران!"
\v 21 شریعتمکؠ ووستاد تہٕ فریسی لٔگؠ پانس سٟتؠ سونٛچنہِ، "یہِ شخص چُھ تہِ وننہٕ سٟتؠ خدایس وِقار والان! خدایس ورٲے کُس ہیٚکہِ گناہ معاف کٔرِتھ!"
\v 22 یسوعؔ ہس توٚر فِکرِ یہِ تِم سونچان ٲسؠ۔ توے ووٚن تٔمؠ تِمن، "توٚہہِ شوبن نہٕ پننٮ۪ن دلن انٛدر تتھ پؠٹھ سوال کرٕنؠ یہِ مےٚ ووٚن!
\v 23 یتیٚن چُھ تہِ کینٛژھا یتھ متعلق بہٕ یژھان چُھس زِ توٚہؠ سونٛچو غورٕ سان۔ تہِ چھا سہل ونُن، "بہٕ چُھس چٲنؠ گناہ معاف کران یا ووٚتھ تھوٚد تہٕ پکھ؟ توٚہؠ ما سونٛچو زِ یہِ ونُن چُھ سہل مےٚ کٔرؠ چٲنؠ گناہ معاف تکیازِ اتھ چھیٚنہٕ کُنہِ ٹھوس ثبوتٕچ ضروٗرتھ۔
\v 24 پوٚز بہٕ چُھس یژھان توٚہؠ زانیٚو زِ خداین چُھ مےٚ، آدمؔ سٕنٛدِس اولادس، زمینہِ پؠٹھ لوٗکن ہنٛدؠ گناہ معاف کرنُک اختیار دِیتمُت۔ تہٕ ہاونہٕ خٲطرٕ ونہٕ بہٕ یمِس شخصس ووٚتھ تھوٚد۔ "پتہٕ ووٚن تٔمؠ تمِس فالجہِ لد نفرس، "بہٕ چُھسے ژےٚ ونان، ووٚتھ تھوٚد، تُل پنٕنؠ ڈٲنج تہٕ گژھِ گرٕ!"
\v 25 فورن گوٚو تمِس نفرس شفا سُہ ووٚتھ تِمن سارنےٕ برونٹھہٕ کنہِ تھوٚد، سۅ ڈٲنج تجِن یتھ پؠٹھ سُہ پیمُت اوس تہٕ دراو خدایہِ سنٛدؠ تعریف کران گرٕ کُن۔
\v 26 تمام لوٗکھ گےَ تتہِ حٲران! تِمو کٔرؠ خدایہِ سنٛدؠ تعریف، یہِ تِمو یسوعؔ کران وُچھ تتھ پٮ۪ٹھ سپدکھ مکمل تعجب۔ تِم رودؠ ونان، "اسہِ وُچھ از حٲران کرَن وٲلؠ چیٖز!"
\v 27 پتہٕ درٛاو یسوعؔ تمہِ جایہِ پؠٹھہٕ تہٕ تٔمؠ وُچھ لاوی ناوک اکھ نفر یُس رومی سرکارٕ خٲطرٕ مٲلیہ جمع کران اوس۔ سُہ اوس أکِس چوکہ منٛز بہتھ یتہِ لوٗکھ تمِس سرکارک وٲجب محصول ادا کران ٲسؠ۔ یسوعؔن ووٚن تمِس، "مےٚ سٟتؠ یہِ تہٕ بن میٚون شٲگرد!"
\v 28 أمؠ لاوی ین ترٲو پنٕنؠ کٲم تہٕ دراو یسوعؔ ہس سٟتؠ۔
\v 29 پتہٕ کوٚر لاوی ین یسوعؔ ہَس تہٕ تمِسنٛدین شٲگردن ہنٛدِ خٲطرٕ پننہِ گرِ اکہ بڈِ سالک انتظام۔ تتہِ ٲسؠ مٲلیہ جمع کرن والیٚن ہنٛز اکھ بٔڈ جماتھ تِمن سٟتؠ سال کھیٚوان۔
\v 30 پتہٕ کٔر کینٛژو فریسی فرقس سٟتؠ وابستہٕ نفرو تہٕ کؠنٛژو یہُودؠ شریعت ہچھناون والیٚو کینٛژو نفرو یسوعؔ سنٛدین شٲگردن شِکایَت زِ "توٚہہ پزِ ہے نہٕ مٲلیہ جمع کرن والیٚن تہٕ باقین گناہ گارن سٟتؠ کھیوٚن چیٚون۔"
\v 31 پتہٕ ووٚن یسوعؔن تِمن، "یِم لوٗکھ ٹھیک آسن تِمن چُھنہٕ أکِس ڈاکٹر سنٛز ضروٗرت پیٚوان۔ بیمار لوٗکن چھےٚ أکِس ڈاکٹر سنٛز ضروٗرت آسان۔
\v 32 بیٚیہِ یتہِ زِ بہٕ چُھس نہٕ آسمانہٕ پؠٹھٕ تِمنےٕ یوت دعوت دِنہٕ خٲطرٕ آمُت یِم پانس نیک سمجھان آسن تہٕ تِمے یِن مےٚ نِش۔ بلکہ چُھس بہٕ تِمن تہِ دعوت دِنہٕ خٲطرٕ آمُت یِم پنہٕ نِس پانس گناہ گار مانان چھِ تہٕ پنُن گناہ گار ؤتیرٕ بدلاوتھ مےٚ نِش یوان چھِ۔"
\v 33 تِمو یہُودؠ سردارو دِیُت یسوعؔ ہس جواب، "یوحناؔ بپتسمہ دنہٕ وٲلؠ سنٛدؠ شٲگرد چھِ اکثر روزدار روزان تہٕ دُعا کران۔ فریسین ہنٛدؠ شٲگرد تہِ چھِ تی کران۔ مگر تُہنٛدؠ شٲگرد چھِ روزان کھیٚوان تہٕ چیٚوان! تِم کیازِ چُھنہٕ باقین ہنٛدؠ پٲٹھؠ روزٕ تھاوان؟"
\v 34 یسوعؔن دیُت جواب، "کانٛہہ چُھنہٕ مہرازس سٟتؠ آمتیٚن سالرَن ونان روزدار روزن ییٚلہِ زن خانٛدرچ تقریب آسہ چلان!
\v 35 پوٚز کنہِ دوٚہہٕ آسہ نہٕ مہبادشاہ پننٮ۪ن یارن سٟتؠ، تمہِ وقتہٕ روزن تِم روزدار۔"
\v 36 پتہٕ دِژِ یسوعؔن باقی مثالہٕ یمو سٟتؠ تٔمؠ پننہِ کتھِ ہنٛز وضاحت کٔر۔ تٔمؠ ووٚن، "لوٗکھ چھِنہٕ زانٛہہ پرٲنِس پلوس نَوِ پلوٕچ دٔج لاگان یُتھ زن سُہ ٹھیک سپدِ۔ اگر تِمو تہِ کوٚر، تِم کرن نووِس پلوس ژَٹنہٕ سٟتؠ تباہ، تہٕ نووِ پلوچ دٔجؠ چھنہٕ پرٲنِس پلوس سٟتؠ شوٗبان۔
\v 37 تہٕ کانٛہہ اکھ چُھنہٕ تازے چیرمُت شرابہٕ پرانیٚن مشکن منٛز ذخیرٕ کرنہٕ خٲطرٕ بران۔ ہرگاہ کانٛسہِ اکؠ تہِ کوٚر، تِم مشکہٕ پھٹن تکیازِ تمہِ پھٲلن نہٕ ییٚلہِ نوو خمیرِ دار شرابہٕ پھٲلہِ۔ سۅ مَشٕک تہِ سپدِ بےٚکار، تہٕ سُہ شراب تہِ۔ سُہ شراب ژلہِ نیرتھ۔
\v 38 اتھ برعکٕس پزِ نوو شراب نِین مشکن برُن۔
\v 39 یِمو پرُون شراب چیٚمُت آسہ تِم چھِنہٕ نٔوو چیٚنچ کوشِش کرٕنؠ یژھان، تکیازِ تِم چھِ سونچان، "پُرونےٕ شراب چُھ زیادٕ جان!"
\c 6
\p
\v 1 یسوعؔ\f + \fr 6‏:1 \ft تثنِیہ شرع 23:25\f* تہٕ تٔمؠ سنٛدؠ شٲگرد ٲسؠ اکہ مخسوٗس سبتٕکہِ دوٚہہ کھہَو منٛزؠ پکان، تمؠ سٕنٛدیو شاگردو ژٔٹؠ فصلٕکؠ کینٛہہ ہیٚلؠ۔ تِمو موٗرؠ تِم پننٮ۪ن اتھن منٛز دانہٕ کرِکھ الگ توٚہہ الگ۔ پتہٕ کھیٚے تِمو تِم دانہٕ۔
\v 2 کینٛہہ فریسی ٲسؠ یہِ وُچھان۔ تِمو ووٚن تِمن، "توٚہہِ پزِ ہے نہٕ یہِ کرُن! سون شریعت چُھ سبتکہِ دوٚہہٕ اسہِ کٲم کرنس منع کران!"
\v 3 یسوعؔ ہَن دیُت فریسین جواب، "نوشتن پؠٹھ کریو غور یِم داوودسؔ متعلق ونان چھِ زِ ییٚلہِ سُہ تہٕ تسنٛدؠ نفر بۅچھِ ۂتؠ ٲسؠ تٔمؠ کیاہ کوٚر۔
\v 4 \f + \fr 6‏:4 \ft احبار 24:5۔ 9، سموئیلؔ 1۔ 21:6\f*یتھ پٲٹھؠ توٚہؠ زانان چُھو، داوودؔ ژاو خدایہِ سنٛدِس گرس منٛز تہٕ مونٛگُن کینٛہہ غذا۔ کاہنو دِژٕ تمِس خدایہِ سنٛدِ ناو نیاز آمژٕ ژۅچہِ۔ داوودنؔ کھییہِ کینٛہہ تہٕ کینٛہہ دِژن تِمن نفرن یِم تمِس سٟتؠ ٲسؠ، اگرچہ شریعتہٕ مطابق تِم ہیٚکہ ہن نہٕ تہِ کٔرِتھ۔ تمہٕ ژوچہِ ہیٚکہ ہن صرف کاہنےٕ یوت کھیٚتھ۔"
\v 5 یسوعؔن ووٚن تِمن بیٚیہِ "مےٚ، آدمؔ سُنٛد گۅبُر چُھ امیٚک فٲصلہٕ کرنُک اختیار تھاوان زِ لوٗکن کیاہ شوبہِ سبتکہِ دوٚہہ کرُن!"
\v 6 بیٚیس سبتٕکس دوٚہس پؠٹھ گوٚو یسوعؔ یہُودؠ عبادت خانس منٛز تہٕ دِژن لوٗکن تعلیم۔ تتہِ اوس اکھ نفر یمِس دٔچُھن اتھٕ بےٚکار اوس۔
\v 7 تتہِ ٲسؠ یہُودؠ شریعتک کینٛہہ ووستاد تہٕ کینٛہہ فریسی۔ تِم ٲسؠ یسوعؔ ہس غورِسان وُچھان۔ تِم ٲسؠ یژھان وچُھن زِ سُہ ہیٚکیا تمِس نفرس ٹھیک کٔرِتھ۔ ہرگاہ تٔمؠ تہِ کوٚر، پتہ دِن تس سبتٕکس دوٚہس متعلق تہنٛدِ شریعت کِس قانونچ خلاف ورزی کرنُک الزام۔
\v 8 پوٚز یسوعؔن زون زِ تِم کیاہ ٲسؠ سونچان۔ اوے ووٚن تٔمؠ تمِس نفرس یمِس اتھٕ ہوکھمُت اوس، "ولہٕ پرٛیتھ أکِس برونٹھ کنہِ گژھِ اِستادٕ!" لہٰذا ووٚتھ سُہ نفر تھوٚد تہٕ سپُد کھڑا۔
\v 9 پتہٕ وُن یسوعؔن تِمن، "بہٕ چُھس یژھان توٚہہِ اکھ سوال پرژوھن، کیاہ سُہ شریعت یُس خداین موسیٰؔ ہس عطا کوٚر چھا حکم دوان سبت کہِ دوٚہہ زِ لوٗکن پزِ تہِ کرُن یہِ اصل یا خراب، زندگی بچاونہٕ یا تباہ کرنہٕ باپتھ؟"
\v 10 تمِس دیُت نہٕ کانٛسی جواب۔ تٔمؠ دِژ ژۅپٲرؠ تِمن سارنےٕ کُن نظر تہٕ پتہٕ ونُن تمِس نفرس، "پنُن ہوکھمُت اتھٕ کڈ نیٚبر!" تٔمؠ نفرن کوٚر تہِ، تہٕ تمسُنٛد اتھٕ گو دُبارٕ مکمل ٹھیک!
\v 11 اوٕ پتہٕ دراے فریسی ہیکلہٕ منٛزٕ نٮ۪بر، مگر تِمن مذہبی سردارن کٔھژ سخ ژَخ، تہٕ تِمو لوگ اکھ أکِس سٟتؠ بحث کرُن زِ تِم کِتھہٕ پٲٹھؠ ہیٚکن یسوعسؔ نِشہ بٔچتھ۔
\v 12 تتھؠ وقتس دوران گو یسوعؔ بالس پؠٹھ دُعا منٛگنہ۔ سُہ رود تتہِ سٲرسےٕ راتس خدایس دُعا منٛگان۔
\v 13 \f + \fr 6‏:13 \ft یِم سوٗزمِتؠ ٲسنؠ۔ \f* دویمہِ دوٚہہ أنؠ تٔمؠ پنٕنؠ سٲری شٲگرد ناد دِتھ پانس نِش۔ تِمو منٛزٕ ژٲرؠ تٔمؠ باہ شخصس تہٕ تِمن دِتُن رسول آسنُک لقب۔
\v 14 تِمن ہنٛدؠ ناو چھِ یِم: یسوعؔن تھوٚو شمعونسؔ نوو ناو پطرس، پطرس سُنٛد بوے اندریاسؔ، یعقوبؔ تہٕ تسند بوے، یوحنا، فلپسؔ تہٕ برتلمایی؛
\v 15 متیؔ یمہٕ سُنٛد دوٚیم ناو اوس لیوی؛ تُوماؔ؛ حلفیؔ سُنٛد نیٚچو یعقوبؔ؛ شمعونؔ یمِس زیلوتیسؔ یانے غیور لقب دِنہٕ آو؛
\v 16 یہُوداؔ، بیس أکِس یعقوبؔ ناوکس نفرٕ سُنٛد نیٚچو اوس؛ تمِس آو یہُوداؔ اِسکریوتی ناو دِنہٕ، یمؠ زن پتہٕ یسوعؔ ہس دغاہ دیُت۔
\v 17 یسوعؔ ووٚتھ پنٕنؠ شٲگرد ہٮ۪تھ بالہٕ پؠٹھٕ بوٚن تہٕ سپُد أکِس ہموار جایہِ پؠٹھ اِستادٕ۔ تتہِ اوس تہنٛدین شٲگردن ہُنٛد اکھ بوٚڈ ہجوم۔ بیٚیہِ ٲس تتہِ لوٗکن ہنٛز اکھ بٔڈ جماتھ یِم یروشلمہٕؔ پؠٹھہٕ تہٕ یہُودیہ علاقہٕ کیٚو دویمیٚو جایو پؠٹھہٕ، سٲحلی علاقن نکھٕ صور تہٕ صیدا کیٚو شہرو پؠٹھہٕ آمٕتؠ ٲسؠ۔
\v 18 تِم ٲسؠ یسوعؔ سنٛز تعلیم بوزنہٕ خٲطرٕ تہٕ پننٮ۪ن بیمارن ٹھیک کرنہٕ باپتھ آمٕتؠ۔ تٔمؠ کٔرؠ تِم تہِ ٹھیک یِمن بد روحو تکلیف دِتمٕتؠ ٲسؠ۔
\v 19 ہجومس منٛز کٔر پرٛتھ کانٛسہِ تمِس اتھٕ لاگنٕچ کوشش، تکیازِ سُہ اوس ہر أکِس پننہِ طاقتہٕ سٟتؠ ٹھیک کران۔
\v 20 اوٕ پتہٕ لٲجؠ تٔمؠ پننٮ۪ن شٲگردن کنُ نظر دِنؠ تہٕ تٔمؠ ووٚن، "یہِ چُھ تُہنٛد خٲطرٕ جان زِ توٚہؠ چُھو غریب، تکیازِ توٚہہِ پؠٹھ چھےٚ خدایہِ سنٛز بادشٲہی۔
\v 21 \f + \fr 6‏:21 \ft متی 5:4۔ 5، زبُور 126:5۔ 6\f* یہِ چُھ سیٹھاہ رُت تُہنٛدِ خٲطرٕ زِ توٚہؠ چُھو بۅچھِ ۂتؠ، تکیازِ خدا کرِ توٚہہِ پرٛیتھ کانٛہہ تہنٛدِ ضرورتُک چیٖز عطا۔ یہِ چُھ تہنٛدِ خٲطرٕ رُت زِ توٚہہِ چُھ وُنؠ دۅکھ واتان، تکیازِ خدا چھُ خوش تہٕ اسناوِ توٚہہِ کُنہِ دوٚہہ خوشی سٟتؠ۔
\v 22 یہِ چُھ سیٹھاہ رُت ییٚلہِ لوٗکھ توٚہہِ نفرت کرن، ییٚلہِ تِم توٚہہِ رَد کرن تہٕ بےٚ یزتھ کرن تہٕ وننو زِ توٚہؠ چُھو مےٚ انسان سنٛدِس گۅبرس پتہٕ پتہٕ پکان۔
\v 23 ییٚلہِ یہِ سپدِ، خوشی گٔژھِو! وۅٹہٕ تُلؠ زیٚو تکیازِ توٚہؠ چُھو خوش! ذہنس منٛز تھٲوؠ زیٚو زِ خدا چُھ توٚہہِ آسمانس پؠٹھ اکھ بوٗڈ انعامہٕ دِنہٕ وول! یمہٕ مشرٲیو زِ یِم لوٗکھ توٚہہِ سٟتؠ امہِ طریقہٕ سلوک کران چھِ واریاہ برونٛٹھ اوس تِہنٛدیو جدو تہِ خدایہِ سنٛدین نبی ین سٟتؠ یی کوٚرمُت۔
\v 24 پوٚز حٲف ٲسٕین تِمن پؠٹھ یِم دولت منٛد چھِ۔ توٚہہِ چھےٚ امیری ہنٛزٕ تمام آسٲیشہٕ برونٛٹھے حٲصل سپٕزمٕژ۔
\v 25 یہِ کوتاہ افسوس چُھ زِ توٚہؠ ہیٚکیو وُنکیٚس غذا سٟتؠ پنٕنؠ یڈ بٔرِتھ۔ پتہٕ ٲسیٚو توٚہؠ بۅچھِ ۂتؠ۔ افسوس چُھ تِمن یِم وُنہِ کیٚن اسان چھِ۔ پتہٕ ٲسیٚو توٚہؠ مایوس۔
\v 26 یہِ کوتاہ افسوس چُھ تہنٛدِ خٲطرٕ ییٚلہِ پرٛیتھ اکھ توٚہہِ متعلق رُت ونہِ۔ امی طریقہٕ ٲسؠ تہنٛدؠ جد رُت وننٕکؠ عٲدی تِمن لوٗکن متعلق یِم اپٕزؠ پٲٹھؠ خدایہِ سنٛدؠ رسول آسنُک دعوا کران ٲسؠ۔
\v 27 پوٚز بہٕ چُھس توٚہہِ بوزن والیٚن ونان: پننؠن دُشمنن سٟتؠ ورتایو لول، پننٮ۪ن دوستن سٟتی یوت نہٕ! تِمن سٟتؠ تہِ کرِیو رُت یِم توٚہہِ نفرت کرن!
\v 28 خدایس منٛگیٚو برکتھ تِمن ۂنٛدِ خٲطرٕ یِم توٚہہِ سٟتؠ بد سلوکی کرن! تِمن ہنٛدِ خٲطرٕ منٛگیٚو دُعا یِم توٚہہِ سٟتؠ خطرناک پٲٹھؠ پیش یِن!
\v 29 اگر توٚہہِ کانٛہہ اکھ بےٚ عِزتی کرِ، أکِس بُتھؠ لبہِ چپاتھ لایہِ توٚہؠ دٲرووس بُتھِچ بیاکھ لب۔ اگر کانٛہہ اکھ تُہنٛدؠ جامہٕ یژھِ نِنؠ، تمِس دِیو تُہنٛز کُرتٕنؠ تہِ ننِہٕ۔
\v 30 ہرگاہ توٚہہِ کانہٛہ کینٛہہ تہِ منگہِ تس دِیو تہِ۔ اگر کانٛہہ تُہنٛد مال نیہ، تمِس مہ منٛگیٚو تِمہٕ واپس۔
\v 31 یتھ انٛدازس منٛز توٚہؠ یژھان چُھو زِ لوٗکھ گژھن توٚہہ سٟتؠ پیش یِنؠ، تٔتھؠ انٛدازس منٛز یِیو توٚہؠ تِمن سٟتؠ پیش،
\v 32 اگر توٚہؠ تِمن سٟتؠ لول بٔریو یِم توٚہہِ لول بران چھِ، یمہٕ تھٲیِو توقع زِ خدا دِیہ تہِ کرنہٕ باپتھ توٚہہِ انعام۔ ییٚلہِ زن گناہ گار تہِ چھِ لول برن والیٚن سٟتؠ لول بران۔
\v 33 توٚہؠ مٕہ تھٲیِو خدایس نِشہ توقَع زِ سُہ دِیہ اسہِ انعام تکیازِ توٚہؠ چُھو تِمن لوٗکن سٟتؠ رُت سلوک کران یِم توٚہہِ سٟتؠ رُت سلوک کران چھِ۔ حتاکہِ گناہ گار تہِ چھِ یی کران۔
\v 34 ہرگاہ ژٕ صرف تِمن دِکھ یِمن نِش ژےٚ واپس ترنٕچ امید ٲسی، یہِ توقع مٕہ تھٲیِو زِ خدا دِیی ژےٚ تتھ انعام۔ ییٚلہِ زن گناہ گار تہِ چھِ تِمن قرض دِوان یِمن نِش تِم پورٕ وصول کٔرِتھ ہیٚکن۔
\v 35 \f + \fr 6‏:35 \ft احبار 25:35۔ 36، متی 5:44۔ 45\f*تمہِ بجایہ، بٔریو پننؠن دُشمنن لول! تہنٛدِ خٲطرٕ کٔریو رٕژٕ کامہِ! تِمن دِیو قرض، تہٕ امید مٕہ تھٲیِو زِ تم دِن کہینٛہ واپس! پتہٕ دییہِ توٚہہِ خدا اکھ بوٗڈ انعام۔ توٚہؠ سپدیو خدایہِ سٕنٛدؠ شُرؠ، ییٚلہِ زن خدا نا شُکری کرن والین تہٕ بدکار لوٗکن پؠٹھ تہِ مہربان آسان چُھ۔
\v 36 لہٰذا پزِ توٚہہِ لوٗکن سٟتؠ رحم دِلی سان پیش یُن، یتھٕ پٲٹھؠ زن خدا، تُہنٛد بب، لوٗکن سٟتؠ حلیمی سان پیش یوان چُھ۔
\v 37 مہٕ کٔریو باقین لوٗکن ہُنٛد سخت فٲصلہٕ۔ پتہٕ کرِنہٕ خدا تہِ سختی سان تُہنٛز عٲب جویی۔ دوٚیمین لوٗکن ہنٛدٮ۪ن جُرمن ہنٛز مٕہ کٔریو مزمت۔ پتہٕ کرِ نہٕ خدا تہِ تُہنٛز مزمت۔ یِمؠ توٚہہِ سٟتؠ غلط کوٚرمُت آسہ تمِس کٔریو معاف۔ پتہٕ دِیہ خدا تہِ توٚہہِ معافی۔
\v 38 دوٚیمین کٔڑیو حاجَتھ۔ تُہنٛدؠ حاجَتھ کڑِ خدا۔ یہِ آسہ تیوت زنہٕ آسہ سُہ توٚہہ تیتیاہ دانہٕ دِوان یوٚت توٚہہِ نِشہ ممکن اکھ پیمانہٕ آسہ۔ سُہ دِیہ تِمن دانن ژؠل۔ سُہ دِیہ تتھ لُوٗلنَ۔ سُہ روزِ تتھ پیمانس تۅتام بران یۅتام تتھ پیٚٹھؠ کھسہِ۔ لہٰذا ییٚلہِ توٚہؠ باقین دِیو، یہِ گژھِ تیوٚتھ آسُن زنتہِ چُھو توٚہؠ اکھ بوٚڈ وٹہٕ لاگان، تکیازِ خدا تہِ لاگہِ تمی انٛدازک وٹہٕ توٚہہِ دِنہٕ خٲطرٕ۔"
\v 39 تٔمؠ دِژ بیٚیہِ پننؠن شٲگردن یہِ مثال: "اکھ اوٚن گژھِ نہٕ بییِس أنِس وتھ ہاوُن۔ ہرگاہ سُہ تہِ کرِ، دۅشوے گژھن وتہِ دۅبس!
\v 40 اکھ شٲگرد چُھنہٕ پنِنس مٲلکہٕ سنٛدِ کھۅتہٕ تھوٚد  آسان۔ مگر ییٚلہِ ووستاد تٔمؠ سنٛز تعلیم سپداوان چُھ، سُہ چُھ پننِس ووستادس ہیوٗ سپدان۔
\v 41 توٚہہِ منٛزٕ پزِ نہٕ کٲنٛسہِ تہِ دوٚیمس شخصہٕ سنٛدین عٲبن کُن وچُھن۔ توٚہہِ پزِ پننؠن عٲبن کنُ غورٕ سان نظر تراوُنؠ۔ دوٚیمین صورتن منٛز، زنتہِ ٲسیو پننِس بٲئے سنٛزِ أچھ منٛز اکھ داغ وُچھان ییٚلہِ نہٕ توٚہؠ پننہِ أچھ منٛزک اکھ بوٚڈ کِٹُر تہِ وُچِھتھ چُھو ہیٚکان۔
\v 42 ژےٚ پزِ نہٕ پنہٕ نِس دوستس یہِ ونُن زِ بہٕ کرٕ چٲنٮ۪ن عٲبن ہُنٛد حل، ییٚلہِ نہٕ ژےٚ وُنہِ پننٮ۪ن عٲبن کُن توجہ دیُتمُتےٕ چُھتھ۔ ہرگاہ ژٕ تہِ کرکھ، ژٕ چُھکھ اکھ ریاکار! ژٕ کرِ گۅڈٕ پنٕنؠ عٲب پانس نِشہ دوٗر۔ یہِ آسہ تیٚوتھ ہیوٗ زنتہٕ ژٕ آسکھ پننہِ أچھ منٛزٕ اکھ بوٚڈ کِٹر دور کران۔ نتجہِ نیرِ یہِ زِ ژےٚ منٛزٕ گژھِ روحانی طاقت پٲدٕ تمہِ پتہٕ ہیٚککھ ژٕ دوٚیمیٚن ہنٛدؠ عٲب دوٗر کٔرِتھ۔
\v 43 پرٛتھ کانٛہہ چُھ زانان زِ أکِس رٕتِس کُلِس نیرن نہٕ خراب میٚوٕ تہٕ أکِس خراب کُلِس نیرن نہٕ رٕتؠ میٚوٕ۔
\v 44 ژٕ ہیٚکہٕ ہَن اکھ شخص تہنٛزِ عملہِ سٟتؠ پرزٕنٲوتھ۔ پتہٕ زانکھ تمِس سٟتؠ کیاہ توقع پزن تھاوُنؠ۔ یُس شخص غلط کامہِ کران آسہ تمِس سٟتؠ مٕہ تھاو رٕژرچ امید۔ سُہ گو زنتہٕ انجیر کنٛڈؠ دُپھو پؠٹھہٕ تلاش کرٕنؠ یا کریٚڈ تھرِ نِش دچھ ژھارٕنؠ۔
\v 45 رٕتؠ انسان چھِ رٕتؠ چیز کران تکیازِ تِم چھِ رُت سونچان۔ خراب لوٗکھ چھِ خراب کامہِ کران تکیازِ تِم چھِ خراب سونچان۔ لوٗکھ یَتھ متعلق سونچان چھِ تمی قسمچہِ کتھٕ تہٕ کامہِ چھِ تِم کران۔"
\v 46 \f + \fr 6‏:46 \ft ملاکی 1:6\f*یسوعؔن ووٚن تِمن لوٗکن، "توٚہؠ کیازِ چُھو مےٚ خداوند ونان ییٚلہِ نہٕ توٚہؠ میٲنِس وننَس پؠٹھ عمل چُھو کران؟
\v 47 بہٕ ونو توٚہہِ تِمن لوٗکن متعلق یِم میانؠ تعلیم بوزنہٕ یوان چھِ تہٕ پتہٕ تتھ پؠٹھ عمل چھِ کران۔
\v 48 تِم لوٗکھ چھِ تمِس أکِس شخصس ہیوؠ یُس پنُن گرٕ تعمیر کرنہٕ باپتھ زمین سنؠ کھنان چُھ۔ تٔمؠ شخصن اوس مضبوط کٕنس پؠٹھ گرٕ تعمیر کوٚرمُت۔ پتہٕ آو اکھ سہلاب۔ آبٕچ اکھ لہَر ٲس تتھ گرس ٹآس لایان۔ مگر تمہِ ہیوٗک نہٕ سُہ تباہ کٔرِتھ، تکیازِ تمؠ شخصن اوس سُہ گرٕ أکس مضبوط کٕنس پؠٹھ تعمیٖر کوٚرمُت۔
\v 49 پوٚز کینٛہہ لوٗکھ یِم میٲنؠ تعلیم بوزِتھ پتہٕ تتھ پؠٹھ عمل چھنہٕ کران۔ تِہنٛز مثال چھےٚ تمِس شخصس ہشؠ یمؠ پنُن گرٕ زمیٖنہِ پؠٹھ کٕنہٕ ورٲے تعمیٖر کوٚر۔ ییٚلہِ تتھ سہلاب چُھ یوان سُہ چُھ یکدم ؤسؠ پیٚوان۔ آبن کوٚر سُہ گرٕ پوٚرٕ پٲٹھؠ بُرباد۔"
\c 7
\p
\v 1 ییٚلہِ یسوعؔن بوزَن والین لوٗکن تِمہٕ سارے کتھٕ ؤنِتھ مۅکلاوِ۔ سُہ دراو پتہٕ کفرنحوم شہرس کنُ۔
\v 2 تتھ شہرس منٛز اوس رومی فوجُک اکھ صوبیدار یمِس اکھ غلام اوس یُس تس ٹوٹھ اوس۔ سُہ غلام اوس تیٚوت بیمار زِ سُہ اوس مرَنس تیار۔
\v 3 ییٚلہِ تٔمؠ صوبیدارن یسوعؔ ہس متعلق بوز، تٔمؠ سوزؠ یہُودینؔ ہنٛدؠ کینٛہہ زِٹھؠ یسوعؔ ہس نِشہ تاکہِ تمِس ونن تِم تمِسنٛدس غلامس شفا بخشنہٕ باپتھ تشریف انُن۔
\v 4 ییٚلہِ تِم یسوعؔ ہس نِش وٲتؠ، تِمو کوٚر تمِس زارٕ پارٕ تمِس صوبیدار سٕنٛدِس غلامس مدد کرنہٕ خٲطرٕ۔ تِمو ووٚن تس، "سُہ چُھ اتھ لایکھ زِ ژٕ کرکھ یہِ تٔمؠ سٕنٛدِ خٲطرٕ،
\v 5 تکیازِ سُہ چُھ سٲنس قومس لول بران تہٕ تٔمؠ بنوو سانہِ باپتھ ہیکل۔"
\v 6 توے دراو یسوعؔ تِمن سٟتؠ تمِس حٲکمہٕ سُنٛد گرٕ۔ ییٚلہِ یسوعؔ تتھ جایہِ نزدیک ووت تہٕ صوبیدارن سوز تس پننیٚو دوستو ذرؠ یہِ یہِ شیٚچھ، "خداوندٕ، ژمہٕ کرِ یور ینُک تکلیف، تکیازِ بہٕ چُھس نہٕ اتھ لایق زِ ژٕ اژکھ میٚون گرٕ پشس تل۔
\v 7 اوے کوٚر مےٚ محسوس زِ بہٕ چُھسا ژےٚ نِشہ ذٲتی طور ینس لایق۔ مےٚ اوس زونمُت زِ ژےٚ ہیٚکہ ہن میون ٹوٗٹھ خٲدم صرف اکہِ حکمہٕ سٟتؠ ٹھیک کٔریتھ۔
\v 8 بہٕ چُھس زانان زِ ژٕ ہیٚککھ یہِ کٔرِتھ تکیازِ بہٕ چُھس اکھ سُہ نفر یُس زن بیٚین ہنٛدس اختیارس تحت چُھ۔ تہٕ میٲنِس اختیارس تحت چھِ سِپاہ تہٕ تِم چھِ مانان۔ ییٚلہِ بہٕ کٲنٛسہِ ونان چُھس "گژھِ" سُہ چُھ گژھان۔ ییٚلہِ بہٕ بییٚس ونان چُھس "یہِ" سُہ چُھ یوان۔ ییٚلہِ بہٕ پننِس غلامس ونان چُھس، "یہِ کرِ" سُہ چُھ کران۔"
\v 9 یہِ تٔمؠ افسرن ونمُت اوس تہِ ییٚلہِ یسوعن یہِ بوز، تس گو تمِس پٮ۪ٹھ تعجُب۔ یُس لُکہٕ ارساتھ تمِس سٟتؠ اوس تِمن کُن پھیرِتھ ووٚننُ، "بہٕ چُھس توٚہہِ ونان، "مےٚ چُھنہٕ کانٛہہ اسرائیلی نفر سمُکھمُت یمِس مےٚ پؠٹھ یوٚت ایمان چُھ یوٗتاہ زنہٕ یمِس غٲر یہودِس منٛز چُھ!"
\v 10 صوبیدار سٕنٛدؠ دوس یِم تٔمؠ اور سوزمٕتؠ ٲسؠ، ییٚلہِ تِہنٛد گرٕ ژاے، تِمو وُچھ سُہ غلام ٹھیک حالژ منٛز۔
\p
\v 11 یسوعؔن کوٚر تمہِ پتہٕ جلدےٕ نائین شہرس کنُ سفر شروع۔ تسٕنٛدؠ شٲگرد تہٕ لوٗکن ہُنٛد اکھ بوٚڈ ہجوم اوس تس سٟتؠ۔
\v 12 یسوعؔ ییٚلہِ تمہِ شہرچہِ پھاٹکہِ نزدیک ووت، تٔمؠ وُچھ لوٗکن ہُنٛد اکھ بوٚڈ ہجوم شہرٕ منٛزٕ نیٚبر نیران۔ تکیازِ اکؠ شخصن اوس تمی ساعتہٕ وفات کوٚرمُت، تہٕ تِم ٲسؠ تمِس دفن کرنہٕ باپتھ پکناوان۔ تمہِ سنٛز موج ٲسؠ تتھ ہجومس منٛز۔ سۅ ٲس اکھ مۅنٛڈ، تہٕ سُہ اوس تسَنٛد کُنےٕ نیٚچو۔ تہٕ سُے اوس تٔمؠ سنٛز کفالت تُلان ییٚلہِ سُہ زندٕ اوس۔
\v 13 یسوعؔن ییٚلہِ سۅ وُچھ، تمِس آو تس پٮ۪ٹھ رحم تہٕ وُننَس، "مہَ ود!"
\v 14 پتہٕ ووت سُہ تِمن نکھٕ تہٕ لوگنُ تتھ سیٚمبہِ اتھٕ۔ سیٚمب پکناون وٲلؠ گےَ زنتہٕ روزتھ۔ تٔمؠ وُن، "جواناہ، بہٕ چُھسے ژےٚ ونان، ووٚتھ تھوٚد!"
\v 15 سُہ موٚردٕ شخص ووٚتھ تہٕ بیٚوٹھ تہٕ لوٚگ کتھٕ کرنہِ! تہٕ یسوعؔن نیٚو سُہ پننہِ ماجہِ نِش واپس۔
\v 16 تتہِ گوٚو پرٛتھ أکِس ہٲبتھ۔ تِمو کٔرؠ خدایہِ سنٛدؠ تعریف تہٕ اکھ أکِس ونُکھ، "اسہِ منٛز سپُد اکھ عظیم نبی پٲدٕ!" تہٕ خداین کوٚر پننٮ۪ن لوٗکن پؠٹھ احسان"
\v 17 پتہٕ پھٲلییہِ یسوعؔ سنٛز یہِ خبر یہُودیہ کس سٲرسےٕ علاقس تہٕ انٛدؠ پٔکؠ جاین منٛز تہِ۔
\p
\v 18‏-19 یوحناؔ سٕنٛدیو شاگردو ونہِ تمِس یمہٕ سارے کتھٕ۔ لہٰذا أنؠ یوحناؔ ہن پنٕنؠ زٕ شٲگرد ناد دِتھ تہٕ تِمن ونُن زِ خداوندس نِشہ گٔژھو تہٕ تس پرِژھو، "کیا ژٕ چُھکھا سُہ یمِس متعلق خداین ینُک وعدہ اوس کوٚرمُت، کِنہٕ اسہِ پزِ بیٚیہِ کٲنسہِ ۂنٛز امید تھاوُنؠ؟"
\v 20 ییٚلہِ تِم زٕ نفر یسوعؔ ہس نِش آے، تِمو ووٚن تمِس، "یوحناؔ بپتسمہ دِنہٕ وٲلؠ سوزؠ أسؠ ژےٚ پرِژھنہٕ باپتھ، کیا ژٕ چُھکھا سُہ یمہٕ سٕنٛدِ ینُک خداین وعدہ کوٚرمُت چُھ؟ کِنہٕ اسہِ پزِ بیٚیہِ کٲنسہِ ہُنٛد انتظار کرُن؟"
\v 21 تمہِ وقتہٕ اوس یسوعؔ واریہن بیمارین تہٕ خطرناکھ دادین منٛز ہینہٕ آمتیٚن لوٗکن شفا بخشان، تہٕ سُہ اوس تِمن منٛزٕ بدروح نیٚبر کڈان۔ تٔمؠ اوٚن واریہن انیٚن دُبارٕ گاش۔
\v 22 \f + \fr 7‏:22 \ft یسعیاہؔ 35:5۔ 6، 61:1\f* أتی دِیُت تٔمؠ تِمن دوٚن نفرن جواب، "گٔژھیٚو تہٕ دِیو یوحناہسؔ خبر یہِ توٚہہِ وُچُھو تہٕ بوزو۔ یِم لوٗکھ أنؠ ٲسؠ تِم چھِ وُچھان۔ یِم لوٗکھ لٔنگؠ ٲسؠ تِم چھِ پکان۔ یِمن لوٗکن مُسلٕچہِ بیمارِ ٲس تِمن چھنہٕ وُنؠ ٹھیک۔ یِم لوٗکھ زٔرؠ ٲسؠ تِم چھِ ہیکان بوزِتھ۔ یِم لوٗکھ مودمٕتؠ ٲسؠ تِم سپدؠ زندٕ۔ بہٕ چُھس غریب لوٗکن رٕژِ شیٚچھِ ہُنٛد اعلان کران۔"
\v 23 تمِس ؤنِو یتہِ، "خدا کرِ تمِس رُت یُس تہِ وُچھِ یہِ بہٕ کران چُھس تہٕ تہِ بوز یہِ بہٕ ونان چُھس بیٚیہِ روزیس مےٚ پؠٹھ ایمان۔"
\p
\v 24 ییٚلہِ یوحناؔ سنٛدؠ سوزمٕتؠ نفر واپس درامٕتؠ ٲسؠ، یسوعؔن لٲجہِ لوٗکن ہنٛدس ہجومس یوحناہسؔ متعلق کتھ وننہِ۔ تٔمؠ ووٚن، "وُجارس منٛز کیازِ گٔیوو توٚہؠ وُچھِنہِ؟ کیاہ واوٕ سٟتؠ الہٕ ڈلہٕ سپدن وٲلِس أکِس کُلہِ کِس زٲولِس ڈکھس؟
\v 25 مگر توٚہؠ کیاہ کرنہِ درایوٕ نیٚبر وُچھِنہِ اکھ مہنیٚو یُس زٲوِلؠ پلو لاگِتھ چُھ؟ بوزیٚو، تِم یِم شاندار پوشاک چھِ لاگان بیٚیہِ تِم یِمن بادشاہن ہنٛدین محلن منٛز پرٛتھ کانٛہہ رُت چیٖز آیہ تن چُھ آسان۔
\v 26 پتہٕ کیاہ وُچھنہِ گٔییوٕ توٚہؠ تور؟ اکھ نبی؟ آ، سُہ چُھ یوحناؔ! مگر بہٕ چُھسو توٚہہِ ونان زِ یوحناؔ چُھ أکِس عام نبی سٕنٛدِ کھۅتہٕ زیادٕ اہم۔
\v 27 یہِ چُھ سُہ یمِس متعلق نبی ین واریاہ برونٛٹھ لیوکھ: وُچھِو، بہٕ سوزن ژےٚ برونٛٹھ پنُن اکھ رسول۔ سُہ کرِ چانہِ ینہِ باپتھ لوٗکن تیار۔
\v 28 بہٕ چُھسو توٚہہِ ونان زِ تِم سٲری لوٗکھ یِم دُنیاہس منٛز روزان ٲسؠ، تِمو منٛزٕ چُھنہٕ کانٛہہ تہِ یوحناؔ سٕنٛدِ کھۅتہٕ تھوٚد۔ مگر یمہٕ لوٗکھ خدایہ سنٛزِ بارگاہِ منٛز ساروٕے کھۅتہٕ کم پایہ زندٕگی گُزاران چھِ، چھِ یوحناؔ سٕنٛدِ کھۅتہٕ تھدؠ۔"
\p
\v 29 ییٚلہِ تِمو لوٗکو یمن یوحناؔ ہن بپتسمہ دِتمُت اوس بیٚیہِ گُذر ہنہٕ والیٚن سان تہِ بوز یہِ یسوعؔن ووٚن تہٕ تِمو مون زِ خداین ٲس یوحناؔ سوزنچ رٕژ کٲم کٔرمٕژ۔
\v 30 پوٚز یِمو فریسیو تہٕ شریعتہٕ کیٚو عٲلمو یوحناؔ ہس نِشہ بپتسمہ نِمُت اوس نہٕ تِمو کوٚر پننہِ باپتھ خدایی یرادٕ رَد۔
\p
\v 31 پتہٕ ووٚن یسوعؔ ہن یتہِ، "بہٕ ونَو توٚہہ یمہ دورِ کیٚن لوٗکن کٔمن سٟتؠ دِمہ بہٕ تشبہہ۔
\v 32 توٚہؠ چُھو شُرین ہنٛدؠ پٲٹھؠ أکِس کھلہٕ مٲدانس منٛز گندان۔ تِم چھِ اکھ أکِس بُلاوان، "اسہِ وُوے نیہِ پؠٹھ تُہنٛدِ باپتھ خوشی ہُنٛد ساز، مگر توٚہہِ نوٚژو نہٕ! پتہٕ گیٚو اسہِ ماتمی بٲتھ، مگر توٚہہِ وُدو نہٕ!
\v 33 یتھےَ پٲٹھؠ، ییٚلہِ توٚہہِ نِشہ یوحناؔ آو تہٕ تٔمؠ کھیٚو نہٕ عام پٲٹھؠ یا شراب چیون نہٕ، توٚہہِ کوٚروٕ سُہ رد تہٕ وُنو، "أمِس چُھ اکھ بدروح پرؠکس ژامُت!"
\v 34 پوٚز ییٚلہِ آدمؔ سُنٛد گوبر توٚہہِ نِشہ آو تہٕ تٔمؠ کھیٚو عام غذا تہٕ باقین ہنٛدؠ پٲٹھؠ چیون شراب، پتہٕ کوٚرو توٚہہِ سُہ رَد تہٕ وُنو، "وُچھو! یہِ انسان چُھ یڈل بیٚیہِ شرٲبؠ، بیٚیہِ چُھ سُہ گذر ہنہٕ والین تہٕ گناہگارن ہُنٛد یار!"
\v 35 پوٚز گاٹلؠ چھِ مانان زِ یہِ یوحناؔہن تہٕ مےٚ کوٚر چُھ گاٹہٕ جار۔"
\p
\v 36 اکہ دوٚہہ دِژ اکؠ خاص شمعونؔ ناوکؠ فریسین یسوعؔ ہس تمِس سٟتؠ کھیٚنچ دعوت۔ لہٰذا یسوعؔ گوٚو تمِس شخصہٕ سُنٛد گرٕ تہٕ بیوٗٹھ أکِس میزس پٮ۪ٹھ کھیٚنہِ۔
\v 37 تتھ شہرس منٛز ٲس اکھ بدکار زٔنؠ۔ ییٚلہِ تمہِ بوز زِ یسوعؔ چُھ تمِس فریسی سٕنٛدِ گرِ کھٮ۪نہٕ باپتھ، سۅ گییہِ توٚت سنگِ مرمرچہِ عطر دانہِ ہٮ۪تھ یمَن منٛز عطر ٲس۔
\v 38 یسوعؔ اوس کھیٚنس کُن، سۅ زٔنؠ گییہِ تمِس پٔتؠ کِنؠ تہنٛدین کھۅرن نِشہ اِستادٕ۔ سۅ ٲس ودان، تہٕ تسَنٛد اوٚش اوس یسوعؔ سنٛدین کھۅرن پؠٹھ پیوان۔ سۅ روز لگاتار تسنٛدین کھۅرن پننہِ مستہٕ سٟتؠ وتھروان۔ سۅ روز تِمن میٹھؠ کران تہٕ تِمن ٲس عطر سٟتؠ مٲلش کران۔
\v 39 ییٚلہِ تٔمؠ فریسین یِمؠ یسوعؔ ہس دعوت ٲس دِژمٕژ، وُچھ زِ سۅ زٔنؠ کیا ٲس کران، تٔمؠ سونچ، "ہرگاہ یہِ شخص پٔزؠ پٲٹھؠ اکھ نبی آسہ ہے، أمِس گژھِ پتاہ آسٕنؠ یہِ کۅسہٕ زٔنؠ چھےٚ یۅسہ أمِس اتھٕ لاگان چھےٚ۔ أمِس گژھٕ پتاہ آسٕنؠ یہِ کِژھ زٔنؠ چھِ، یانے سۅ چھےٚ اکھ گناہ گار۔"
\v 40 امہِ کس جوابس منٛز ووٚن یسوعؔن تمِس، "شمعونؔ، مےٚ چُھ ژےٚ کینٛہہ ونُن، "تٔمؠ دِیُت جواب، "وۅستادٕ، تہِ کیاہ چُھ؟"
\v 41 \f + \fr 7‏:41 \ft اکھ دینار چُھ أکس گامکس مُزوٗرس أکس دوٚہس مُزورِ برابر۔ \f* یسوعؔن ؤنؠ تمِس یہِ دلیل: "دوٚیو نفرو ٲسؠ أکِس نفرس پونٛسہٕ دِتؠ مٕتؠ یمِس کارٕبار پونٛسہٕ دِنہٕ وول اوس۔ یِمو منٛزٕ اوس اکھ تمِس 500 چانٛدِ ہنٛدؠ سکہٕ داران۔ تہٕ بییٚس نِش ٲسؠ چانٛدِ ہنٛدؠ 50 سِکہٕ۔
\v 42 تِمن دوٚن منٛز روز نہٕ أکِس تہِ قرض ادا کرنچ ہمَتھ، لہٰذا تٔمؠ وُن شخصن تِمن بڈٕ حلیمی سان زِ تِمن دوٚشونی چُھنہٕ واپس دیوٚن کینٛہہ تہِ۔ ادٕ تِمو دوٚیو منٛزٕ کُس برِ تمِس زیادٕ لول؟"
\v 43 شمعوننؔ دِیُت جواب، "میٲنؠ کِنؠ یمِس تٔمؠ سُنٛد زیادٕ رقم قرض اوس سُہ نفر برِ تمِس زیادٕ لول۔ "یسوعؔن ووٚن تمِس، "ژےٚ زونُتھ ٹھیک۔"
\v 44 پتہٕ پھیٚور سُہ تمِس زنانہِ کُن تہٕ ونُن شمعونسؔ، "سونچ أمِس زنانہِ متعلق یہِ امہِ زنانہِ کوٚرمُت چُھ! ییٚلہِ بہٕ چٲنس گرس منٛز ژاس، ژےٚ کٔرتھ نہٕ مےٚ تِتھٕ پٲٹھؠ خوش آوے یتھٕ پٲٹھؠ لوٗکھ اکثر پننؠن مہمانن یتھ مُلکس منٛز کران چھِ۔ ژےٚ دِتُتھ نہٕ مےٚ کھۅر چھلنہٕ باپتھ آب۔ مگر امہِ زنانہِ چٔھلؠ میٲنؠ کھۅر پننہِ اوٚش وانہِ سٟتؠ تہٕ پننہِ مستہٕ سٟتؠ وتھرِنؠ تِم!
\v 45 ژےٚ کوٚڑُتھ نہٕ مےٚ استقبال اکہ مۅنہِ سٟتؠ۔ پوٚز یمہِ ساعتہٕ پؠٹھٕ بہٕ انٛدر ژاس، سۅ روز میانین کھۅرن مۅنہِ کران!
\v 46 ژےٚ کٔرتھ نہٕ میٲنس کلس زیتون تیٖلہٕ سٟتؠ مٲلش، مگر تمہِ کٔر میٲنین کھۅرن مشکہٕ دار عطرِ سٟتؠ مسح۔
\v 47 ادٕ چُھسے بہٕ ژےٚ ونان زِ خداین چھِ أمؠ سٕنٛدؠ واریاہ گناہ معاف کٔرمٕتؠ، توے چھےٚ یہِ مےٚ یوٚت لول بران۔ پوٚز اکھ سُہ نفر یُس یہِ سونچان چُھ زِ خدایس چھِ تمِس کمےٕ گناہ معاف کٔرنؠ سُہ برِ مےٚ کمےٕ لول۔"
\v 48 پتہٕ ووٚن یسوعؔن تمِس زنہِ، "مےٚ کٔرؠ چٲنؠ گناہ معاف۔"
\v 49 پتہٕ یِم أمِس سٟتؠ کھیٚوان ٲسؠ تِمو ووٚن پانہٕ وٲنؠ، "یہِ کُس شخص چُھ یُس ونان چُھ زِ سُہ ہیٚکہِ امسنٛدؠ گناہ معاف کٔرتھ؟"
\v 50 پوٚز یسوعؔن ووٚن تمِس زنہِ، "تکیازِ ژےٚ چھی مےٚ پؠٹھ ایمان، خداین بچٲوکھ ژٕ۔ گژھِ خدا تھٲونےَ سلامت!"
\c 8
\p
\v 1 تمہِ پتہٕ کوٚر یسوعؔن تہٕ تمِسنٛدیو بہو شاگردو انٛدؠ انٛدؠ واریہن شہرن تہٕ گامن ہُنٛد سفر۔ یوٚت تہِ تِم گےَ، یسوعؔ رود لوٗکن رٕژ شیٚچھ بوزٕناوان تِمَن اصل خبر ؤنِتھ زِ خدا ہیٚکہ ہے تِہنٛزِ زِنٛدگی پٮ۪ٹھ حکومت کٔرِتھ۔
\v 2 تِمن سٟتؠ آسہ کینٛہہ مستوراتہٕ تہِ سفر کران یِمن تٔمؠ بدروح نیٚبر کٔڈمٕتؠ تہٕ بیماریو نِشہ شفا بخشمُت اوس۔ تِمن منٛز ٲس مگدلِینی گامچ مریمؔ تہِ شٲمل۔ یسوعؔن ٲسؠ تمِس نِشہ ستتھ بدروح دور کٔرؠ مٕتؠ۔
\v 3 تِمو زنیٚو منٛزٕ ٲس بیٛاکھ زٔنؠ یوانہؔ۔ سۅ ٲس خوزہؔ سنٛز آشِنؠ، یُس بادشاہ ہیرودیسؔنہِ دیوان خانُک اکھ مینیجر اوس۔ سوسناہؔ تہٕ بیٚیہِ واریاہ مستوراتہٕ آسہ تِمن منٛز شٲمل۔ تِمہٕ آسہ پننہِ ذٲتی پوٗنٛسو، کھٮ۪نہٕ تہٕ پلوَو سٟتؠ یسوعؔ ہس تہٕ تسنٛدین شٲگردن مدد کران۔
\v 4 لُکہٕ ہجوُم آو أمِس انٛدؠ انٛدؠ   سٔمِتھ اکہِ دوٚہہ۔ لوٗکھ ٲسؠ واریہو شہرو پؠٹھٕ یسوعؔ ہس وُچِھنہِ یوان۔ تٔمؠ وُن تِمن ورگہٕ پٲٹھؠ۔
\v 5 اکھ کۅمیٛل دراو کینٛہہ بیول ہیٚتھ۔ سُہ گوٚو بیٚول زمینس ووان، کینٛہہ بیلؠ پٔھلؠ پیٚی وتہِ پؠٹھ۔ لوٗکو کٔرٕس لتہٕ مونٛڈ، تہٕ باقی کھیو جاناوارو۔
\v 6 کینٛہہ بیٚول پٮیٚو  پتھر ٹاسرِ میٚژِ پؠٹھ۔ یتُھےٕ سُہ بیوٛل کھوٚت، تِتھُے ہوکھ تکیازِ تِہنٛدین موٗلن ووت نہٕ کٔنیوو منٛزٕ سگےٕ۔
\v 7 کینٛہہ بیوٛل پیٚو تتھ جایہِ یتہِ کٔنڈؠ دُپھن پنُن بیوٛل ہَریومُت اوس۔ نٔوی کٔنڈؠ زنٛڈ گےَ یِمن فصلہٕ کُلیٚن سٟتؠ سٟتؠ بٔڈؠ۔ طاقتور کنٛڈؠ زنٛڈو رٔٹؠ یِم فصلہٕ کُلؠ تل، لہٰذا بڑییہِ نہٕ فصلہٕ کُلؠ اصل پٲٹھؠ۔
\v 8 مگر فصلُک کینٛہہ بیوٛل پیٚو زرخیز زمیٖنہِ منٛز۔ سُہ کھوٚت تہٕ دراس فصٕل یُس تمہِ بیٛالیُک ہتہٕ گنہٕ اوس۔ یہِ ؤنِتھ لوے تٔمؠ لوٗکن ہنٛدس ہجومس ناد، "توٚہہِ پزِ تتھ متعلق ہوشیاری سان غور کرُن یہِ مےٚ توٚہہِ وُنؠ ووٚن!"
\v 9 شٲگرد آے پتہٕ پہن یسوعسؔ نِش تہٕ پرُژھہَس، "امہِ دلیلہ ہُنٛد مطلب کیاہ چُھ؟"
\v 10 \f + \fr 8‏:10 \ft متی 4:11، یسعیاہؔ 6:9۔ 10\f*پتہٕ ووٚن تٔمؠ، "خداین چُھو توٚہہِ خدایی بادشٲہی ہُنٛد پوشیدٕ راز زاننہِ باپتھ امتیٲزی حَق بخشمُت۔ مگر بہٕ چُھس ہَر أکِس سٟتؠ مثالن منٛز کتھٕ کران، اگرچہ تِم وُچھان چھِ، سمٕج چُھکھ نہٕ یوان، زِ  تِم اگر بوزان چھِ مگر فِکرِ چُھکھ نہٕ ترٛان۔
\v 11 امہِ دلیلہٕ ہُنٛد چُھ وُنؠ یہِ مطلب: بیول چُھ تمِچ نمایندگی کران یہِ خدایہ چُھ لوٗکن یژھان سمجھاون۔
\v 12 یُس بیوٛل وتہِ پؠٹھ پیو سُہ چُھ تِم لوٗکھ ہاوان یِم خدایہِ سُنٛد کلام صرف مجان چھِ۔ یہِ چُھ شیطانہٕ سٕنٛدِ باپتھ آسان سپدان زِ سُہ چُھ یوان تہٕ تہنٛدیو دِماغو منٛزٕ چُھ سُہ کلام کٔڈتھ نِوان۔ امیٚک نتِیجہِ چُھ یہِ نیران زِ تِمن چُھنہٕ اتھ پؠٹھ ایمان روزان، تہٕ خدا چُھنہٕ تِمن بچاوان۔
\v 13 یُس بیوٛل کُنہِ زمینس پؠٹھ پیٚو سُہ چُھ ہاوان زِ تِم لوٗکھ یِم خوشی سان خدایہِ سُنٛد کلام رٹان چھِ، تم چُھنہٕ پٔزؠ پٲٹھؠ پننؠن دلن پٮ۪ٹھ یقین کران۔ تِم چھِ صرف تتھ پؠٹھ کٔمےٕ وقتس ایمان تھاوان۔ یتھُے تِمن ظلم تہٕ سِتم در پیش یوان چھِ، تِم چھِنہٕ پتہٕ خدایس پؠٹھ یقین کران۔
\v 14 یُس بیوٛل کنٛڈؠ دُپھن منٛز پیٚو، سُہ چُھ ہاوان زِ تِم لوٗکھ یِم خدایہِ سُنٛد کلام بوزان چھِ۔ ییٚلہِ تِم زندگی منٛز برونٛہہ پکان چھِ، تِم چھِ زندگی ہنٛزن پریشانیٚن، دولتس تہٕ عٲشہٕ عشرتس منٛز گرفتار سپدان۔ تمہِ کِنؠ چھِنہٕ تِم روحٲنی طور بالیغ سپدان۔
\v 15 مگر یُس بیوٛل زرخیز زمیٖنس منٛز پیٚو، سُہ چُھ ہاوان زِ تِم لوٗکھ یِم خدایہِ سُنٛد کلام بوزان چھِ تہٕ پتہ چھِ پٔزؠ پٲٹھؠ تتھ مانان۔ تِم چھِ پۅختہٕ وعدہ کران تہٕ پتہٕ سُہ وعدہ برقرار تھاوان، تم چھِ صبرٕ سٕتؠ روحٲنی طور بالغ گژھان۔
\v 16 یتھ متعلق کریو غور زِ ییٚلہِ لوٗکھ اکھ ژونگ زالان چھِ، تِم چھِنہٕ تتھ کُنہِ أکِس ٹوکرِ تل ژوٗرِ تھاوان۔ تِم چھِنہٕ تتھ أکِس پلنٛگس تل تھاوان۔ بلکہ چھِ تمہِ بجایہ تِم تتھ أکِس زوٗرِ پؠٹھ تھاوان۔ یُتھ زن کمرس منٛز پرٛیتھ کانٛہہ اژن وول گاش وُچِھتھ ہیٚکہ۔
\v 17 یہٕ تمثیل چھےٚ یتھٕ پٲٹھؠ زِ پریتھ پوشیدٕ چیزٕ خاطرٕ ییہِ پرٮ۪تھ کانٛہہ وچھنہٕ خاطرٕ ظٲہر کرنہٕ۔ تہٕ کُنہِ دوٚہہ وُچھِ پرٛیتھ کانٛہہ سُہ چیز یُس ونہِ کیٚن پردس تل چُھ۔
\v 18 لہٰذا یہِ بہٕ توٚہہِ ونان چُھس تہِ چُھو توٚہؠ پوٗرٕ یقینہٕ سان بوزان، تکیازِ ہرگاہ کٲنٛسہِ ایمان چُھ زِ خدایہِ سٕنٛدِ پزرُک، خدا دِییہ تمِس زیادٕ پہن سمجھنُک طاقت۔ ہرگاہ کٲنسہِ آسہ نہٕ ایمانےٕ زِ خدا چُھ پزر، خدا دِییہ نہٕ تمِس اکھ ذرٕ تہِ سمجھنُک طاقت یہِ سُہ سونچہِ زِ تٔمؠ چُھ سمجھمُت۔"
\v 19 اکہ دوٚہہ آیہِ یسوعؔ سنٛز موج تہٕ تسنٛدؠ بٲے تمِس سمکھنہ، پوٚز تِم ہیٚکؠ نہٕ تمِس نزدیک وٲتِتھ تکیازِ لوٗکن ہُنٛد اکھ بوٚڈ ہجوم اوس تتھ مکانس انٛدؠ انٛدؠ گیرٕ کٔرِتھ یتھ منٛز سُہ اوس۔
\v 20 پتہٕ ووٚن لوٗکو تمِس، "چٲنؠ موج تہٕ چٲنؠ بٲے چھِ نیٚبرٕ کنہِ ژےٚ سمکھنہٕ باپتھ کھڑا۔"
\v 21 مگر تٔمؠ دِیُت تِمن جواب، "تِم یِم خدایہ سُنٛد کلام بوزان چھِ تہٕ تتھ پؠٹھ عمل کران چھِ، تِمے چھِ مےٚ ٹٲٹھؠ زنتہٕ میٲنؠ موج تہِ بٲے۔"
\v 22 یسوعؔ ووٚتھ  ناوِ دوٚیمہِ دوٚہہ تہٕ کھوٚت  پننٮ۪ن شٲگردن سٟتؠ۔ تٔمؠ ووٚن تِمن، "بہٕ چُھس یژھان یمہِ جھیلہٕ کِس دوٚیمس بٔٹھس کُن ترُن۔ "لہٰذا لوگ تِمو جھیلس اپور ترُن۔
\v 23 مگر ییٚلہِ ناو یتھ منٛز تِم سوار ٲسؠ، یسوعؔ شونٛگ۔ جھیلس آو زبردست واوٕ طوٗفان۔ ناو آیہِ آبہٕ سٟتؠ بٔرِتھ، تہٕ تِم اے خطرس منٛز۔
\v 24 أتی آے یسوعؔ سنٛدؠ شٲگرد تمِس وُزٕناونہِ۔ تِمو ووٚن تمِس، "ووستاد! ووستاد! ٲسؠ سٲری ہیٚتنؠ مارٕ سپدٕنؠ!" سُہ ووٚتھ نینٛدرِ تہٕ تٔمؠ کوٚر واوس تہٕ خوفناکھ لہرن گرینٛز۔ واون کوٚر پھیرُن بنٛد، لہرٕ تہِ روزٕ ناوِ سٟتؠ مان چھاونہٕ نِشہ پتھ، پرٛیتھ کانٛہہ چیز سُپد خاموش۔
\v 25  تٔمؠ ووٚن پتہٕ تِمن، "توٚہہِ کٔرو تِژھ کٲم زنتہِ توٚہہِ ایمانےٕ اوس نہٕ!" شٲگردن گییہ خبر تہٕ سَپدکھ تعجب تکیازِ تہِ اوس تمی وزِ سپدمُت۔ تِم لٔگؠ پانہٕ وٲنؠ پرژھنہِ، "یسوعؔ کُس ہیٚکہِ ٲسِتھ؟ تکیازِ سُہ چُھ واو تہٕ آبُک حکم تہِ دِوان، تہٕ تِم چھِ تٔمؠ سنٛز عبادت کران۔"
\v 26 یسوعؔ تہٕ تسَنٛدؠ شٲگرد رودؠ ناوِ منٛز پکان تہٕ وٲتؠ تتھ علاقس منٛز ییٚتہِ جراسینی لوٗکھ روٗزان ٲسؠ۔ یہِ اوس تتھ سمندرس گلیل علاقہٕ سیدِ سیٚود دویمہِ طرفہٕ۔
\v 27 ییٚلہ یسوعؔ ناوِ منٛزٕ بٔٹھس پؠٹھ کھوٚت، تمِس سمُکھ تتھ علاقس منٛز تمہِ شہرُک اکھ خاص شخص۔ أمِس شخصس منٛز ٲسؠ واریاہ بدروح۔ یہِ شخص اوس واریاہ کالہٕ پؠٹھٕ نہٕ پلو لاگان تہٕ نہٕ اوس گرِ دران۔ تمہِ بجایہ اوس سُہ وسِتھ گٲمژن قبرن منٛز روزان۔
\v 28 ییٚلہِ تٔمؠ شخصن یسوعؔ وُچھ، تٔمؠ دژٕ کرؠکہٕ تہٕ تمِس برونٛٹھٕ کنہِ تھُوون بُتھ بوٚن کُن۔ تٔمؠ ووٚن بُلنٛد آوازِ منٛز، "ہے یسوعؔ، تھدِس خدایہِ سنٛدِ گۅبرٕ، ژےٚ کیاہ چُھے مےٚ سٟتؠ؟ بہٕ چُھسے ژےٚ زارٕ پارٕ کران، مےٚ متہٕ کرِ تہٕ عذاب!"
\v 29 تٔمؠ شخصن ووٚن یہِ اوٕ موٚکھٕ تکیازِ یسوعؔ ہن اوس گۅڈے بد روحس أمِس نفرس نِشہ نیٚبر نیرنُک حکم۔ پتمہِ لٹہِ، اوس سُہ لوٗکو ہانٛکلو تہٕ ہتھکریو سٟتؠ بنٛد کوٚرمُت پتہٕ ٲسِس پورٕ رٲچھ رودمٕتؠ۔ تمہِ پتہٕ تہِ اوس بدروح تمِس اچانک پننہِ طاقتہٕ سٟتؠ زبردستی کٔڈتھ نِوان۔ پتہٕ اوس سُہ شخص یلہِ گژھان، سُہ بدروح اوس تمِس وجارٕ جاین واتناوان۔
\v 30 پتہٕ پرُوژھ تمِس یسوعؔن، "ژےٚ کیاہ چُھے ناو "بدروحن دِیُت جواب، "میون ناو چُھ لشکر۔ "تٔمؠ ووٚن تکیازِ تمِس شخصس منٛز ٲسؠ واریاہ بدروح ژامٕتؠ۔
\v 31 تِم بدروح رودؠ یسوعؔ ہس زارٕپارٕ کران تِمن متہٕ دِتہٕ تتھ سرٔنِس چہَس منٛز گژھنُک حکم ییٚتہِ خدا بد روحن سزا چُھ دِوان۔
\v 32 تتہِ اوس نزدیکےٕ بالس پؠٹھ سورن ہُنٛد اکھ بوٚڈ کھیٚول گاسہٕ کھیٚوان۔ تِمو بدروحَو کوٚر یسوعؔ ہس زارٕ پارٕ زِ تِمن دِ تِمن سورن منٛز دٲخل گژھنُک اجازت، پتہٕ دِیُت یسوعؔن تِمن اجازت۔
\v 33 ادٕ ترٛوو تِمو بدروحَو سُہ شخص یلہِ تہٕ گےَ سورن منٛز دٲخٕل، پتہٕ وۅتھ تِمن سورن ہُنٛد کھیٚول ژھرٹہٕ ژھرٹہٕ کران وسونِس بٔٹھس بوٚن تہٕ پھٔٹؠ جیلس منٛز۔
\v 34 ییٚلہِ سورٕ رٲچھ نفر تہِ وُچھان ٲسؠ، تِم  ژٔلؠ! تِمو دِژ انٛدؠ پٔکؠ کیٚن سارنےٕ لوٗکن تمِچ خبر۔
\v 35 پتہٕ گےَ لوٗکھ تہِ وُچھنہِ یہِ سپدمُت اوس۔ ییٚلہِ تِم توٚت وٲتؠ ییٚتہِ یسوعؔ اوس، تِمو وُچھ سُہ شخص یمِس بدروح نیٚبر درامٕتؠ ٲسؠ، یسوعؔ سنٛدین پادن تل بہتھ۔ تِمو وُچھ سُہ پلو لٲگتھ تہٕ بیٚیہِ اوس سُہ ہوشس منٛز۔ تِمن گوٚو احساس زِ یسوعؔ کوتاہ طاقتور چُھ تہٕ تِمن گٔییہِ خوف۔
\v 36 یمو لوٗکو سُہ واقہٕ وُچھمُت اوس تِمو ووٚن پتہٕ ینہٕ والیٚن لوٗکن زِ یسوعؔن کِتھہٕ پٲٹھؠ بچوو سُہ شخص یُس بدروحو رُٹمُت اوس۔
\v 37 پتہٕ ووٚن أنٛدؠ پٔکؠ کیٚن مُلک جراسینن ہنٛدیٚو تمام لوکو تمِس تِمو نِشہ نیرنہٕ خٲطرٕ، تکیازِ تِم ٲسؠ واریاہ خوفہٕ سٕتؠ قبضہٕ کرنہٕ آمٕتؠ۔ لہٰذا ووت سُہ ناوِ منٛز تہٕ آو واپس۔
\v 38 تِم نیرن وزِ کوٚر تٔمؠ نفرن یسوعؔ ہَس یہِ ونان زارٕ پارٕ یمِس بدروح نیٚبر درامٕتؠ ٲسؠ زِ، "مہربٲنی کٔرِتھ نِیو مےٚ پانس سٟتؠ!" پوٚز امہِ بجایہ، کوٚریسوعؔن تمِس یہِ ونان روخصت۔
\v 39 "نَہ، گژھِ پنُن گرٕ تہٕ پرٛیتھ أکِس ون زِ خداین کوتاہ چُھ چانہِ باپتھ کوٚرمُت!" ادٕ درٛاو سُہ تہٕ تمام شہرٕ کیٚن لوٗکن ونُن زِ یسوعؔن کوتاہ کوٚر تہنٛدِ خٲطرٕ۔
\v 40 ییٚلہِ یسوعؔ تہٕ تسَنٛدؠ شٲگرد سُہ جھیل پار کٔرِتھ واپس کفرنحوم وٲتؠ، لوٗکن ہنٛدؠ اکؠ ہجومَن کٔر تِہنٛز خوش آوے۔ تِم سٲری ٲسؠ تٔمؠ سُنٛد انتظار کران۔
\v 41 ہیکل کیٚو سردارو منٛزٕ آو تمی وزِ یائِیرؔ ناوک اکھ نفر یسوعؔ ہس نکھٕ، سُہ جُکیٚو تمِس برونٛہہ کنہِ۔ تٔمؠ کوٚر یسوعؔ ہس زارٕپارٕ زِ سون گرٕ یہِ۔
\v 42 تٔمؠ کوٚر یہِ اوٕ موٚکھٕ تکیازِ تمِس ٲس باہ ؤرِش کُنی کور یۅسہ مرنَس تیار ٲس۔ سُہ اوس یژھان زِ یسوعؔ بخشہِ تمِس شفا۔ وُنؠ ییٚلہِ یسوعؔ تمِس سٟتؠ درٛاو، واریاہ لوٗکھ گےَ تمِس انٛدؠ انٛدؠ جمع۔
\v 43 تتھ ہجومس منٛز ٲس اکھ زٔنؠ یمِس بہَو ؤرؠ یو پؠٹھٕ اکھ بٮ۪مٲرؠ ٲس یمہِ سٟتؠ تس خوٗن جٲری اوس روزان۔ تمہِ اوس پنُن سورےٕ پونٛسہٕ پان بٔلراونہٕ باپتھ حکیمن پؠٹھ خرچ کوٚرمُت، مگر سۅ ٲس نہٕ کٲنسہِ ہنٛدؠ دٔسؠ بلیمٕژ۔
\v 44 سۅ ٲس یسوعؔ ہس پٔتؠ کِنؠ تہٕ لوگُن تمسٕنٛدس جامَس دامنس اتھٕ۔ تمِس گوٚو خوٗن یُن یکدم بنٛد۔
\v 45 یسوعؔن ووٚن، "مےٚ کٔمؠ لوٗگ اتھٕ "یسوعؔ ہس انٛدؠ انٛدؠ یِم ٲسؠ تِمو کوٚر تمِس اتھٕ لاگنہٕ نِشہ اِنکار۔ پطرسؔن ووٚن، "ووستاد، اتہِ چھِ واریاہ لوٗکھ ژےٚ انٛدؠ انٛدؠ جمع تہٕ اتہِ چُھ ژیٚل تہِ گژھان۔ ادٕ تِمو منٛزٕ آسہ کانٛسہِ توٚہہ سٟتؠ اتھٕ تہِ لوٚگمُت!"
\v 46 پوٚز یسوعؔن ووٚن، "مےٚ چھےٚ پتاہ زِ کٔمؠ تام لوگ زٲنتھ مٲنتھ مےٚ اتھٕ، تکیازِ سُہ نفر بٔلراونُک طاقت درٛاو مےٚ منٛزٕ۔"
\v 47 پتہٕ گوٚو تمِس زنہِ احساس زِ سۅ ہیٚکہِ نہٕ ژوٗرِ روٗزتھ۔ سۅ کانٛپنییہِ تہٕ آیہ یسوعؔ ہس نِش تہٕ کوٚرُن ادبہٕ سان تمِس برونٛہہ کٔنہِ سٕجدٕ۔ سارنےٕ لوٗکن برونٛہہ کٔنہِ ونُن زِ تمہِ کٔمہِ باپتھ لوگ یسوعؔ ہس اتھٕ تہٕ تمی وزِ کتھٕ پٲٹھؠ سپدُس ؤلؠ ؤلؠ شفأ۔
\v 48 یسوعؔن ووٚن تس، "میٲنؠ کورؠ چٲنؠ ایمانن بچٲوکھ ژٕ۔ ووٚتھ نیر وُنؠ، خدا تھٲونےَ سلامت۔"
\v 49 یسوعؔ اوس وُنہِ تمِس زنہِ سٟتؠ کتھےٕ کران زِ یائِیرؔ سنٛدِ گرِ پؠٹھٕ آو اکھ نفر تہٕ ووٚنُن یائِیرؔس، "چٲنؠ کور مویہِ۔ لہٰذا مٕہ کرِ ووستادٕ سُنٛد وقت ضایہِ۔"
\v 50 یسوعؔن بوز یہِ، تٔمؠ ووٚن یائِیرؔس، "مہَ بر غم، صرف تھاو مےٚ پؠٹھ یقین، سۅ گژھِ دُبارٕ زندٕ۔"
\v 51 ییٚلہِ سُہ گرٕ آنٛگنس منٛز ووت، یسوعؔن دِیُت نہٕ پطرسسؔ، یوحناہسؔ، یعقوبسؔ تہٕ کورِ ہنٛدس مٲلس ماجہِ ورٲے کٲنسہِ تہِ انٛدر اژنہٕ۔
\v 52 سٲری لوٗکھ ٲسؠ اتہِ زورٕ زورٕ ودان زِ یہِ کور چھےٚ مومٕژ۔ مگر یسوعؔن وُن تِمن، "مہ ؤدِو! سۅ چھیٚنہٕ مومٕژ! سۅ چھےٚ نینٛدرِ!"
\v 53 تہٕ تِمو ساروٕے لوٗکو تُروو تمِس اسُن تکیازِ تِمن ٲس پتاہ زِ سۅ کور چھےٚ مومٕژ۔
\v 54 پوٚز یسوعؔن کٔر تس اتھس تھپھ تہٕ آلو دِتھ وُننَس، "کوٗری ووٚتھ تھوٚد!"
\v 55 تس آیہِ ؤلؠ ؤلؠ زندگی واپس، سۅ ؤژھ تھوٚد۔ یسوعؔن ووٚن تِمن زِ أمِس دِیو کینٛہہ کھیٚنہٕ خٲطرٕ۔
\v 56 تسُند مول موج سپدؠ وُچِھتھ حٲران، مگر یسوعؔن ووٚن تِمن زِ یہِ کینٛژھا سُپد تہِ وُنؠ زیٚو نہٕ وُنہِ کٲنسہِ۔
\c 9
\p
\v 1 پتہٕ أنؠ یسوعؔن پنٕنؠ باہ شٲگرد ناد دِتھ تہٕ بخُشنکھ لوٗکن منٛز بدروح نیٚبر کڈنُک تہٕ تہنٛزن بیمارین شفا کرنُک طاقت۔
\v 2 تٔمؠ سوٗزؠ تِم خدایس متعلق یمہِ رٕژِ شیٚچھِ ہُنٛد تبلیغ کرنہِ زِ خدٲیی بادشٲہی کیاہ چھےٚ۔ تٔمؠ ووٚن تِمن بیمار لوٗکن شفا بخشنہٕ باپتھ۔
\v 3 تٔمؠ ووٚن تِمن نیرنہٕ برونٛٹھ، "سفرٕ باپتھ مہ تُلیو پانس سٟتؠ کینٛہہ۔ نَہ نیزیٚو لوٗر یا ٹھیلہٕ، نَہ غذا یا پونٛسہٕ۔ اکھ علاوٕ کُرتٕنؠ تہِ گژھِنہٕ سٟتؠ تُلٕنؠ۔
\v 4 یُتھےٕکُنہِ گرس منٛز أژیو، تٔتی گژھِ روزن تۅتام یۅتام تمہِ علاقہٕ منٛزٕ نیرُن آسیٚو۔
\v 5 ہرگاہ کُنہِ شہرس منٛز لوٗکھ توٚہہِ خوش آوے کرنو نہٕ، توٚہہِ پزِ نہٕ تتہِ رُکن۔ تمہِ شہرٕ منٛزٕ نیرؠ زیٚو، نیرتھ دٕنؠ زیٚو تتِچ گرد تہِ پننیٚو کھۅرو پؠٹھٕ۔ سۅ روزِ تِہنٛدِ خٲطرٕ اکھ خبردٲری زِ تِمو مون نہٕ تُہنٛد۔"
\v 6 پتہٕ درٛاے تِم یسوعؔ ہس نِشہ تہٕ کوٚرکھ گامہٕ پتہٕ گامہٕ سفر۔ یوٚت تہِ تِم گےَ، تِم روٗدؠ لوٗکن خدایہ سنٛز رٕژ شیٚچھ باوان، بیٚیہِ بخشُک بیمار لوٗکن شفا۔
\v 7 گلیل ضلعکؠ حٲکم ہیرودیسؔن بوز تہِ سورےٕ یہِ سپدان اوس، تہٕ سُہ گوٚو غۅتن۔ کینٛہہ لوٗکھ ٲسؠ ونان زِ یوحناؔ بپتسمہ دِنہٕ وول اوس بیٚیہِ زندٕ گوٚمُت۔
\v 8 باقی لوٗکھ ٲسؠ ونان زِ نبی ایلیاہؔ اوس دُبارٕ ظٲہر سپدمُت۔ کینٛژن لوٗکن ہُنٛد اوس وُنہِ تہ یہِ ونُن زِ پتمیٚو نبیو منٛزٕ چُھ اکھ نبی دُبارٕ زندٕ سپدمُت۔
\v 9 مگر ہیرودیسنؔ ووٚن، "یہِ ہیٚکہ نہٕ یوحناؔ ٲسِتھ، تکیازِ مےٚ چُھ تمِس کلہٕ ژٹنوومُت۔ لہٰذا یہِ انسان کُس چُھ؟ بہٕ چُھس أمِس متعلق حٲران کرَن وٲلؠ قصہٕ بوزان!" سُہ لُگ پتہٕ یسوعؔ ہس وُچھنہٕ خٲطرٕ وتھ تلاش کرنہِ۔
\v 10 ییٚلہِ تِم رسول پننہِ سفرٕ پؠٹھٕ واپس آیہِ، تِمو ووٚن یسوعؔ ہس تہِ سورےٕ یہِ تِمو کوٚرمُت اوس۔ پتہ نیہ تٔمؠ تِم پانس سٟتؠ بیت صیدا شہرس کنُ۔
\v 11 مگر ییٚلہِ لوٗکن ہنٛزن مختلف جمٲژن معلوم سپد زِ یسوعؔ کوٚت اوس گوٚمُت، تِم ٲسؠ تمِس تۅتےٕ وٲتِتھ پیٚوان۔ سُہ اوس تِمن خوش آوے کران تہٕ تِمن سٟتؠ اوس خدٲیی بادشٲہی متعلق کتھٕ کران۔ بیٚیہِ اوس سُہ بیمارن شفأ بخشان۔
\v 12 وُنؠ اوس دوٚہہ انٛد واتن ہیٚوتمُت، أتی آیہِ تِم باہ شٲگرد تس نِش تہٕ ووٚن ہس، "مہربٲنی کٔرِتھ سوزُن یِمن لوٗکن ہنٛز بٔڑ جماتھ انٛدؠ پٔکؠ گامن منٛز یتہِ زن تِم کھیٚن حٲصٕل کرن بیٚیہِ ٹھہرنہٕ باپتھ کرن کانٛہہ جاے تلاش، تکیازِ ٲسؠ چھِ ییٚتہِ وٲرانس منٛز۔"
\v 13 مگر تٔمؠ ووٚن تِمن، "توٚہہِ پزِ یِمن کینٛہہ کھؠنہٕ خٲطرٕ دیُن!" تِمو دِیُت جواب، "اسہِ نِش چھےٚ صرف پانٛژھ لۅکچہ ژۅٚچہِ بیٚیہِ زٕ لۅکچہ گاڈٕ یِمو ورٲے چُھنہٕ بیٚیہِ کینٛہہ۔ اگر نہٕ أسؠ بیٚیہِ کُنہِ جایہِ گٔژھِو تہٕ تِمن سارنٕے خٲطرٕ کھٮ۪ن ہٮ۪مو مٔلؠ!"
\v 14 تِمو ووٚن یہِ اوٕ موٚکھٕ تکیازِ تتہِ ٲسؠ لگ بھگ پانٛژھ ساس مَرد۔ پتہٕ ووٚن یسوعؔن شٲگردن، "لوٗکھ بہنٲووکھ زمیٖنہِ پؠٹھ ٹوگجن منٛز۔ پرٛیتھ کُنہِ ٹوگجہِ منٛز روزن پنژاہ پنژاہ نفر۔"
\v 15 تہٕ شاگردو کوٚر تہِ، تہٕ بہنٲوِکھ لوٗکھ پتھر۔
\v 16 پتہٕ تُجہ یسوعؔن تِم پانٛژھ ژۅچہِ بیٚیہِ زٕ گاڈٕ۔ تٔمؠ وُچھ آسمانس کنُ تہٕ کوٚرن تِمن ۂنٛدِ خٲطرٕ خدایہِ سنٛدؠ تعریف۔ پتہٕ کرٔنؠ تِمن ژۅچن تہٕ گاڈن ٹُکرٕ تہٕ گوٚو سُہ شٲگردن دِوان تِم گییہِ لوٗکن منٛز تقسیم کران۔
\v 17 تِمو ساروٕے کھیٚو یڈ بٔرِتھ۔ پتہٕ کٔرؠ شاگردو ہُریامٕتؠ ژۅچہٕ ٹُکرٕ جمع، تِمو برِ تِمو سٟتؠ باہ ٹوکرِ!
\v 18 اکہ دوٚہہ ییٚلہِ یسوعؔ اوس شٲگردن نکھےَ، کُنے زوٚن دُعا کران، تٔمؠ پرُوژھ تِمن، "لوٗکن ہنٛزٕ کٲژاہ جمٲژ چھےٚ ونان زِ بہٕ کُس چُھس؟"
\v 19 تِمو دِیُت جواب، "کینٛہہ لوٗکھ چھِ ونان زِ ژےٕ چُھکھ، یوحناؔ بپتسمہ دِنہٕ وول، ییٚلہِ زن باقی چھِ ونان زِ ژٕ چُھکھ ایلیاہؔ نبی، تہٕ کینٛہہ چھِ ونان زِ ژٕ چُھکھ پرانیٚو نبی یو منٛزٕ اکھ نبی یُس دُبارٕ زندٕ گژھتھ واپس آمُت چُھ۔"
\v 20 تٔمؠ ووٚن تِمن، "توٚہؠ کیاہ چُھو ونان؟ توٚہؠ کیاہ چُھو ونان زِ بہٕ کُس چُھس؟ پطرسؔن ووٚن، "ژٕ چُھکھ مسیحؔ، یُس خدایہِ سنٛدِ طرفہٕ آمُت چُھ۔"
\v 21 اوٕ پتہٕ کٔرؠ تِم یسوعؔن پورٕ پٲٹھؠ خبردار زِ وُنہِ ؤنؠ زیٚو نہٕ کٲنسے۔
\v 22 پتہٕ ووٚن تٔمؠ، "بہٕ، آدمؔ سُنٛد گۅبُر، ضرور وؠترایہ واریاہ دوٚکھ: بزرگ، کاہن سردار بیٚیہِ یہُودؠ شریعتٕکؠ ووستاد کرن مےٚ اِنکار، پتہٕ کرن مےٚ قتل۔ تمہِ پتہٕ تریٚمہِ دوٚہؠ، سپدٕ بہٕ دُبارٕ زندٕ۔"
\v 23 پتہٕ ووٚن تٔمؠ تِمن سارِنے، "ہرگاہ توٚہہِ منٛز کانٛہہ اکھ میون شٲگرد چُھ یژھان بنُن، توٚہہِ چُھنہٕ صرف تہِ کرُن ضروری یہِ توٚہؠ کرُن یژھان چُھو۔ مگر توٚہؠ گٔژھِو ہمیشہٕ پنُن پان مےٚ برُونٛہہ کنہِ پیش کرنہٕ خٲطرٕ رٲزی آسٕنؠ، تہٕ مرنہٕ کِس حدس تام تہِ تکلیفہٕ تُلنہٕ تہٕ مےٚ پتہٕ یِنؠ۔ یِتھ گژھہِ میون شٲگرد آسُن۔
\v 24 توٚہہِ چُھ تہِ ضروری کرُن، تکیازِ تِم یِم پنُن زُوو بچاونچ کوٗشش کرن تِمن راوِ ابدی زندگی، مگر تِم یِم پنٕنؠ زندگی قربان کرن تاکہِ تِم بنَن میٲنؠ شٲگرد تِم بچاوُن پنٕنؠ ابدی زندگی۔
\v 25 بہرحال، یہِ کوتاہ فایدٕ منٛد چُھ تہنٛدِ باپتھ، ہرگاہ توٚہہِ یتھ دنیاہس منٛز پرٛیتھ کانٛہہ چیز حٲصٕل گژھِ مگر پتہٕ راوِ توٚہہِ سورےٕ کینٛہہ، یا تُہنٛد پنُن پان تبا کرُن؟
\v 26 فرض کرَو کانٛہہ اکھ چُھ یہِ وننس کھوژان زِ تمِس چُھ مےٚ پؠٹھ ایمان بیٚیہِ چُھ میانہِ تعلیمہ پؠٹھ عمل کران۔ پتہٕ ونہٕ بہٕ، آدمؔ سُنٛد اولاد، زِ سُہ شخص چُھنہٕ میٚون۔ یہِ سَپدِ تیٚلہِ ییٚلہِ بہٕ پنٕنؠ شان بیٚیہِ مٲلؠ خدایہِ سنٛز شان بیٚیہِ پاک فرشتن ہنٛز شان ہیٚتھ واپس یمہٕ۔
\v 27 مگر توٚہہِ گژھِ یتھ کتھِ پؠٹھ یقین آسُن زِ: توٚہہِ منٛز یم یتِنَس کینٛہہ اِستادٕ چھِ مَرن نہٕ تۅتام یۅتام نہٕ تِم خدٲیی بادشٲہی وُچَھن!"
\v 28 یمہٕ کتھٕ وننہٕ پتہٕ قریبن ٲٹھِ دوٚہؠ، تُلؠ یسوعؔن، پطرسؔ، یوحناؔ تہٕ یعقوبؔ پانس سٟتؠ تہٕ گےَ بالس پؠٹھ دُعا کرنہِ۔
\v 29 دُعا کرنس دوران، بدلیٚیہِ تمؠ سنٛز شکل، بیٚیہِ لٔگؠ تمسنٛدؠ پلو زرقہٕ برق کرنہِ۔
\v 30 اکی وقتہٕ ٲسؠ سیٹھاہ پرانہِ زمانٕکؠ زٕ رسول یسوعؔ ہس سٟتؠ کتھٕ کران۔ تِم ٲسؠ موسیٰؔ تہٕ ایلیاہؔ۔
\v 31 یِم شخص سپدؠ جلالہٕ سان ظٲہر۔ تِمو کرِ یسوعؔ ہس سٟتؠ تٔمؠ سٕنٛدِس مَرنس متعلق کتھ۔ سُہ یُس سُہ یروشلمس منٛز پورٕ کرن وول اوس۔
\v 32 پطرسؔ تہٕ تمِس سٟتؠ باقیو شٲگرد ٲسؠ مژِ نینٛدرِ۔ ییٚلہِ تِم اصل پٲٹھؠ نینٛدرِ ؤتھؠ، تِمو وُچھ یسوعؔ نپہٕ نپہٕ کران۔ بیٚیہِ وُچھ تِمو موسیٰؔ تہٕ ایلیاہؔ تمِس سٟتؠ اِستادٕ۔
\v 33 ییٚلہِ موسیٰؔ تہٕ ایلیاہؔ یسوعؔ ہس نشہٕ نیرنہ لٔگؠ، پطرسنؔ ووٚن تمِس، "ووستاد، سون ییٚتہِ آسن چُھ رُت! ٲسؠ بناوو ترٛیہ پناہ گاہ، اکھ چانہِ باپتھ، اکھ موسیٰؔ سنٛدِ باپتھ، تہٕ اکھ ایلیاہؔ سنٛدِ باپتھ!" مگر سُہ اوسنہٕ زانان زِ سُہ کیاہ چُھ ونان۔
\v 34 سُہ اوس یی ونان زِ، اکھ اوٚبرٕ لنٛگ کھوٚت تہٕ تِمن آو ولنہٕ۔ شٲگرد کھوژؠ ییٚلہِ اوٚبُر تِمن ولنہٕ آو۔
\v 35 \f + \fr 9‏:35 \ft یسعیاہؔ 42:1، پطرس 2۔ 1:17۔ 18\f* اوٚبرٕ منٛزٕ آیہ خدایہِ سنٛز آواز یہِ ونان، "یہِ چُھ میٚون گۅبُر، یُس مےٚ ژورمُت چُھ؛ أمؠ سُنٛد بوزیٚو!"
\v 36 ییٚلہِ سۅ کتھٕ کرنچ آواز بنٛد گییہِ، تِمو ترٛیو شاگردو وُچھ تتہِ اوس یسوعؔ کُنے زوٚن۔ تِمو تھوٚو تہِ سورےٕ پانس نِش۔ تِمو ووٚن نہٕ واریہس وقتس کٲنسہِ زِ تِمو کیاہ اوس وُچھمُت۔
\v 37 دوٚیمہِ دوٚہہ ییٚلہِ تِم تمہِ بالہٕ پؠٹھ وسان ٲسؠ، یسوعؔ تہٕ  لوٗکن ہُنٛد اکھ بوٚڈ ہجوم سمکھیاو پانہٕ وٲنؠ۔
\v 38 لوٗکن ہنٛدِ ہجومہٕ منٛزٕ دِژ اچانک اکؠ نفرن کریٚکھ، "ووستاد، بہٕ چُھس ژےٚ عرض کران، میانس نیٚچوِس کرِ تہٕ کینٛہہ مدد! سُہ چُھ مےٚ کُنےٕ اولاد۔
\v 39 یہِ وُچھ کیاہ چُھ سپدان۔ اکھ بدروح چُھ تمِس پریٚکس ژامُت تہٕ سُہ چُھ کرؠکہٕ دِوان۔ سُہ چُھ أمِس خطرناکھ پٲٹھؠ مُرنہِ دِوان تہٕ پتہٕ چُھس ٲسہٕ کِنؠ پھوٚس کھسان۔ یہِ بدروح چُھ میٲنس شُرس مشکِلن یلہِ تراوان، ییٚلہِ تراوان چُھس تیٚلہِ چُھس سخٕت زخم دِوان۔
\v 40 مےٚ کوٚر چانیٚن شٲگردن زارٕ پارٕ زِ تِم کڈن تمِس بدروحس أمِس منٛزٕ نیٚبر، پوٚز تِمو ہیٚوک نہٕ تہِ کٔرِتھ!"
\v 41 یسوعؔن ووٚن تس جوابس منٛز، "لوٗکن ہنٛز یہِ نسٕل چھیٚنہٕ یقین کران، تہٕ تِہُنٛد سونچ چُھ گندٕ! بہٕ کۅتتام روزٕ توٚہہِ سٟتؠ یۅتام توٚہؠ یقین کٔریو؟" پتہٕ ووٚن تٔمؠ شُرؠ سٕنٛدِس مٲلس، "انُن پنُن نیٚچو مےٚ نِش!"
\v 42 ییٚلہِ تِم سُہ لڑکہٕ تمِس نِش انان ٲسؠ، بد روحن دِیُت تمِس لڑکس زمینہِ پؠٹھ دب بیٚیہِ دِژنس سختی سان وُٹھِنؠ۔ پوٚز یسوعؔن کوٚر بدروح ہَس کھٛریٚنگ تہٕ سُہ لڑکہٕ بٔلرووُن۔ پتہٕ کوٚرن پننِس مٲلس حوالہٕ۔
\v 43 اتہِ موجود سٲری لوٗکھ گےَ حٲران خدایہِ سنٛز یہِ بٔڈ عظمت وُچِھتھ۔ ییٚلہِ وُنہِ یسوعؔ سنٛدین تمام معجزن پؠٹھ تِم تعجبےٕ کران ٲسؠ، تٔمؠ ووٚن پننٮ۪ن شٲگردن،
\v 44 "تہِ بوزیٚو ہوشہٕ سان یہِ بہٕ توٚہہِ ونہٕ، تکیازِ کُس تام کرِ جلد، آدمؔ سٕنٛدِس اولادس، میٲنیٚن دشمنن حوالہٕ۔"
\v 45 پوٚز شٲگردن تٔرنہٕ یہِ کتھ فکرِ۔ خداین رکٲوؠ تِم تہِ سمجھنہٕ نشہٕ امہِ سببہٕ زِ تِمن گوٚژھ نہٕ وُنہِ أمؠ سنٛزِ کتھِ ہُنٛد مطلب فِکرِ ترُن، بیٚیہِ کھوژؠ تِم أمِس امیٚک مطلب پرٛژھنس زِ تٔمؠ کیاہ ووٚن۔
\v 46 کینٛہہ وقت گژھتھ لوگ شاگردو پانہٕ وٲنؠ اتھ کتھِ پؠٹھ بحث کرُن زِ تِمو منٛزٕ کُس اکھ آسہ زیادٕ اہمیت رنگؠ تھوٚد۔
\v 47 مگر یسوعؔن زون زِ تِم کیاہ ٲسؠ سونچان، اوے اوٚن تٔمؠ اکھ لۅکُٹ شُر تہٕ کوٚرن پانس نِشہ اِستادٕ۔
\v 48 تٔمؠ ووٚن تِمن، "ہرگاہ کانٛہہ اکھ أکِس لۅکٹِس شُرِس میانہِ سببہٕ خوش آوے کرِ، زن تہِ چُھ سُہ مےٚ خوش آوے کران۔ بیٚیہِ ہرگاہ کانٛہہ مےٚ خوش آوے کرِ، زنتہِ چُھ سُہ خدایس خوش آوے کران، یمؠ خداین بہٕ سوزُس۔ یاد گژھِ تھاوُن زِ یُس توٚہہِ ساروٕے منٛزٕ کمتر باسان چُھ سُے چُھ خدایس نِشہ ساروٕے کھۅتہٕ تھوٚد۔"
\v 49 یوحناؔ ہن ووٚن یسوعؔ ہس جوابس منٛز، "ووستاد، اسہِ وُچھ اکھ شخص چٲنس ناوس پؠٹھ بدروح لوٗکو منٛزٕ نیٚبر کڈان۔ مگر اسہِ کوٚر تمِس تہِ کرنس پؠٹھ ٹھاکھ، تکیازِ سُہ اوس نہٕ اسہِ سٟتؠ نزدیک یتھ تُہنٛز پٲروی کران۔
\v 50 تہٕ یسوعؔن ووٚن یوحناؔ ہس، "تس مہ کٔریٚو تہِ کرنس ٹھاکھ! ہرگاہ کانٛہہ اکھ سۅ کٲم کران آسہ یمہِ سٟتؠ نہٕ توٚہہِ کانٛہہ نقصان واتہِ، بلکہ آسہ تمہِ سٟتؠ توٚہہ فٲیدٕ میلان!"
\v 51 ییٚلہِ سُہ وقت قریب واتن وول اوس ییٚلہِ خدا تمِس آسمانس پؠٹھ واپس کھالہِ ہے، یسوعؔن کوٚر یروشلمسؔ کُن گژھنکُ پۅختہٕ یرادٕ۔
\v 52 تٔمؠ سوٗزؠ پانس برونٛہہ کینٛہہ قٲصد۔ تِم روٗدؠ پکان تہٕ وٲتؠ سامریا علاقہ کِس أکِس گامس منٛز یتہِ تِمو تسٕنٛدِ ٹھہرنہٕ باپتھ انتظار کرنچ کوٗشش کٔر۔
\v 53 مگر سامری لوٗکو دیُت نہٕ یسوعؔ ہس پننِس گامس منٛز ٹھہرنُک اجازت، تکیازِ تٔمؠ ٲس یروشلم کُن وتھ رٔٹمٕژ۔
\v 54 \f + \fr 9‏:54 \ft بادشاہت 2۔ 1۔ 10\f* تٔمؠ سنٛدین دوٚن شٲگردن، یعقوبسؔ بیٚیہِ یوحناہسؔ کٔھژ شرارت ییٚلہِ تِمو وُچھ زِ سامری لوٗکھ ٲسؠ نہٕ تِمن خوش آوے کران۔ لہٰذا ووٚن تِمو یسوعؔ ہس، "خداوند، توٚہؠ چُھوا یژھان زِ أسؠ دِمو حکم آسمانہٕ وسہِ نار تہٕ یِمن لوٗکن کرِ بُرباد؟"
\v 55 مگر یسوعؔ پھیٚور تِمن کُن تہٕ سَختی سان وُننَکھ، "نَہ، تُہنٛد یہِ ونُن چُھ غلط۔
\v 56 لہٰذا پٔکؠ تِم بیٚیس گامس کُن۔
\v 57 چونٛکہ یسوعؔ تہٕ تمسنٛدؠ شٲگرد ٲسؠ وتہِ پکان، کٔمؠ تام ووٚن تِمس، "یوٚت توٚہہِ گژھُن چُھ بہٕ یِمو توٚہہ سٟتؠ!"
\v 58 یسوعؔن دِتس جواب، "پوژھٕ لاوین چھےٚ زندٕ روزنہٕ باپتھ زمینہِ منٛز گۅپھ آسان، تہٕ جاناوارن چھِ ٲلؠ آسان، پوٚز مےٚ، آدمؔ سٕنٛدِس گۅبرس چُھنہٕ کانٛہہ گرٕ یتہِ سُہ شونٛگِتھ ہیٚکہٕ!"
\v 59 یسوعؔن ووٚن بیٚیہِ أکِس شخصس، "مےٚ سٟتؠ یہِ!" مگر تٔمؠ شخصن ووٚن أمِس، "خداوند، مےٚ دِ گۅڈٕ گرٕ گژھنہٕ تاکہِ پنُن مول وُڑراون۔"
\v 60 مگر یسوعنؔ ووٚن أمِس، "موٚردن دِ پنٕنؠ مودمٕتؠ پانے دفناونہٕ۔ بہٕ چُھس یژھان ژٕ گژھکھ تہٕ لوٗکن وُنکھ پرٛیتھ جایہِ زِ تِم ہیٚکن خدٲیی بادشٲہی ہنٛز خوش خبری پننہِ زندگی ہنٛز وتھ بنٲوتھ۔"
\v 61 \f + \fr 9‏:61 \ft بادشاہت 1۔ 19:20\f*بیٚیہِ کٔمؠ تام ووٚن، "خداوند، بہٕ یمہٕ ژےٚ سٟتؠ تہٕ بنہٕ چون شٲگرد، مگر گۅڈٕ دِ مےٚ گرٕ گژھنہٕ تاکہِ بہٕ ہیٚمہٕ پننٮ۪ن گرِکیٚن رخصت۔"
\v 62 یسوعؔن ووٚن تمِس، "کانٛہہ اکھا یُس أکِس زمیندار سنٛدؠ پٲٹھؠ پنٕنؠ زمین وایان وایان پتھ کُن وُچھان آسہ سُہ چُھنہٕ خدٲیی بادشٲہی لایکھ۔"
\c 10
\p
\v 1 تمہِ پتہٕ، کٔرؠ یسوعؔن باقی دُسَتتھ 72 شٲگرد مقرر یِم لوٗکن تٔمؠ سنٛز کتھ بوزنہٕ خٲطرٕ تیار کرہَن۔ تٔمؠ سوٗزؠ تِم زٟ زٟ پرٛیتھ شہرس تہٕ گامس کُن پانس برونٛہہ برونٛہہ یوٚت یوٚت سُہ پانہٕ گژھن وول اوس۔
\v 2 تٔمؠ ووٚن تِمن، "واریاہ لوٗکھ چھِ مےٚ پؠٹھ ایمان اننَس تیار، پوٚز توٚہہِ منٛز چھِ تِم سیٹھاہ کم یِم بہٕ تِمن مدد کرنہٕ خٲطرٕ نیٚبر سوزکھ۔ لہٰذا منٛگیٚو خدایس دُعا، یُس تِمن سارنےٕ لوٗکن ایمان انُن یژھان چُھ، تمِس کٔریو زارٕپارٕ زِ سُہ سوزِ زیادٕ زیادٕ شٲگرد یِم تِمن مدد کرن۔
\v 3 وُنؠ گژھیٚو، مگر یہِ تھٲیِو یاد زِ بہٕ چُھسو توٚہؠ نیٚبر پٲغام ہیٚتھ تِمن لوٗکن نِش سوزان یِم تُہنٛدؠ دشمن آسن۔
\v 4 \f + \fr 10‏:4 \ft متی 10:9، بادشاہت 2۔ 4:29\f* پانس سٟتؠ مہ نِیو پونٛسہٕ۔ ٹھیلن منٛز مہ بٔریو زیادٕ سامانہٕ۔ ایزادٕ کھۅربانہٕ نہٕ نِیو۔ وتہِ منٛز ٹھہرزؠو نہٕ، نَہ کٔرؠ زیٚو کٲنٛسہِ سٟتؠ کتھ۔
\v 5 ییٚلہِ زانٛہہ کُنہِ گرس منٛز أژیو، گوٚڈٕ منٛگؠ زیٚو تتھ گرس منٛز روزن والین لوٗکن ہنٛدِ باپتھ خدایس سلامتی!
\v 6 ہرگاہ تٔمہِ گرٕکؠ بٲژ خدایہِ سنٛز سلامتی یژھان آسن، تیلہِ باسہِ تِمن سۅ تہِ سلامتی یۅسہ توٚہؠ تِمن پیش کٔریو۔ پوٚز ہرگاہ تِم خدایہِ سنٛز سلامتی آسن نہٕ یژھان، تیلہِ باسہِ توٚہہِ سۅ سلامتی پانس۔
\v 7 تتھ گرس منٛز روزؠ زیٚو تۅتام یۅتام تمہِ گامہٕ منٛزٕ نیریو۔ اکہ گرٕ منٛزٕ نیرتھ دویمِس گرس منٛز گژھؠ زیٚو نہٕ۔ کھیٚیو تہٕ چیٚیو یہِ کینٛژھا تِم دِنو، تکیازِ اکھ مُزور چُھ صرف مُزورِ ہُنٛد حقدار آسان۔
\v 8 ہرگاہ توٚہؠ کُنہِ شہرس منٛز أژیو تہٕ لوٗکھ کرنو خوش آوے، یُس غذا تِم دِنو تہِ کھیٚؠ زیٚو۔
\v 9 تمہِ شہرٕ کیٚن بیمار لوٗکن دِی زیٚو شفا۔ پرٛیتھ أکِس ؤنِو، "خدٲیی بادشٲہی چھےٚ توٚہہِ نکھٕ آمٕژ۔
\v 10 پوٚز ہرگاہ توٚہؠ کُنہِ شہرس منٛز أژیو تہٕ لوٗکھ کرنو نہٕ خوش آوے، تتہِ کیٚن کوچن منٛز گژھتھ وُنؠ زیٚو،
\v 11 "اکھ خبردٲری، تِمن خلاف، زِ أسؠ چھِ تُہنٛدِ شہرٕ منٛزٕ نیران نیران سۅ گرد تہِ دٕنان یوسہِ سانیٚن کھۅرن لٲرِتھ ٲس۔ پوٚز توٚہہِ گژھِ ضرور احساس آسُن زِ توٚہؠ وُچھو جلد ییٚلہِ خدایہ سنٛز بادشٲہی پرٛیتھ جایہِ آسہ!
\v 12 \f + \fr 10‏:12 \ft پیدٲیشؠ 19:24۔ 25\f* بہٕ چُھس یژھان توٚہؠ زٲنیٚو زِ تمہِ وزِ ییٚلہِ خدا پرٛیتھ أکِس حساب ہییٚہِ، خدا دییہِ تمہِ شہرٕ کیٚن لوٗکن تمہِ کھۅتہٕ زیادٕ سخت سزا یُس تِمن بدکار لوٗکن دِتُن یِم سدومؔ شہرس منٛز واریاہ برونٛہہ روزان ٲسؠ!
\v 13 یہِ کوتاہ خوفناک آسہ توٚہہِ لوٗکن ۂنٛدِ خٲطرٕ یِم خرازین تہٕ صیدا شہرن منٛز بسان چھِ۔ بہٕ چُھس یہِ امہِ سببہٕ ونان زِ مےٚ ہاوؠ تمہِ وزِ بٔڈؠ معجزٕ ییٚلہِ بہٕ تُہنٛدین شہرن منٛز اوسس۔ ہرگاہ تِتھؠ معجزٕ صور تہٕ صیدا کیٚن پرانیٚن شہرن منٛز ہاونہٕ آمٕتؠ آسہ ہن، تتہِ کیو تِمو بدکار لوٗکو تہِ آسہ ہِے پننیٚو گُنہَو نِشہ توبہٕ کوٚرمُت۔ تِمو آسہ ہے پتھرِس پٮ۪ٹھ سوٗر مٔلِتھ تہٕ ٹاٹھ ؤلِتھ امیٚک اظہار کوٚرمُت۔
\v 14 \f + \fr 10‏:14 \ft یوییل 3:4۔ 8، ذکریا 9:2۔ 4\f* لہٰذا ییٚلہِ خدا پرٛیتھ أکِس حساب ہیٚیہِ، سُہ دِیہ توٚہہِ تِمو بدکار لوٗکو کھۅتہٕ تہِ زیادٕ سزا یِم صور تہٕ صیدا ہس منٛز بسان ٲسؠ۔
\v 15 \f + \fr 10‏:15 \ft یسعیاہؔ 14:13، 15\f* "مےٚ چُھ توٚہہ لوٗکن تہٕ کینٛہہ ونُن یم کفرنحوم قصبس منٛز روزان چھِ، توٚہؠ ٲسیٚو سونچان زِ خدا کرِ توٚہہ بوٚڈ اٮ۪نام عطا۔ نہ، خدا چُھنہ ہرگِز تہِ توٚہہ کانٛہہ اجر دنہٕ وول۔"
\v 16 بیٚیہِ ووٚن یسوعؔن شٲگردن، "یُس اکھا تُہنٛد کلام بوزِ سُہ چُھ عملن میٚون بوزان۔ تہٕ یُس اکھا تُہنٛدس کلامس اِنکار کرِ سُہ چُھ عملن مےٚ اِنکار کران۔ تہٕ یُس مےٚ اِنکار کران چُھ سُہ چُھ عملن خدایس اِنکار کران۔"
\v 17 یِم دُسَتتھ 72 نفر یسوعؔن مقرر کٔرؠ تِم گےَ تہٕ کوٚرکھ تیٖ یہِ تٔمؠ تِمن کرُن ونمُت اوس۔ ییٚلہِ تِم واپس آے، تِم ٲسؠ سیٹھاہ خوش۔ تِمو وُن، "خداوند، ہتاکہِ چانہِ اختیارٕ سٟتؠ مون بدروحو تہِ سون، اسہِ کوٚر تِمن حکم زِ لوٗکو منٛزٕ نیریو نیٚبر!"
\v 18 \f + \fr 10‏:18 \ft کشفِ یوحنا۔ 12:7۔ 9، یسعیاہؔ 14:12\f* یسوعؔن ووٚن تِمن، "یِمہِ وزِ توٚہؠ تہِ کران ٲسِو، مےٚ وُچھ شیطان آسمانہٕ پٮ۪ٹھٕ اچانک ؤلؠ ؤلؠ وُزملہِ ہنٛدؠ پٲٹھؠ بوٚن وسان!
\v 19 \f + \fr 10‏:19 \ft زبُور 91:13\f*بوزیٚو! مےٚ چُھ توٚہہِ بدروحن تہٕ سرفن شِکس دِنہٕ خٲطرٕ طاقت عطا کوٚرمُت۔ تمہِ علاوٕ چُھ مےٚ توٚہہِ سٲنس دُشمن شیطانس تہِ شِکس دِنہٕ خٲطرٕ طاقت دِتمُت۔ توٚہہِ واتہِ نہٕ ہرگز کُنہِ سٟتؠ زرؠر۔
\v 20 تُہنٛدِ خٲطرٕ چَھےنہٕ صرف یژےٕ خوشی زِ بدروح روزن توٚہہِ تٲبِیع۔ بلکہ پزِ توٚہہِ اوٕ موٚکھٕ زیادٕ خوش روزن زِ خداین چھِ تُہنٛدؠ ناو آسمانن پؠٹھ لیکھمٕتؠ، تکیازِ تمیُک مطلب چُھ یہِ زِ توٚہؠ رودیٚو ہمیشہِ خدایس سٟتؠ۔"
\v 21 پاک روحن بخٕش یسوعؔ ہس تمہ وزِ سیٹھاہ خوشی۔ ییٚلہ تٔمؠ وُن، "میانہِ ببہٕ خدایہِ، ژٕ چُھکھ پرٛیتھ کُنہِ چیزُک خداوند یہِ زمینَس پؠٹھ بیٚیہِ آسمانس منٛز چُھ۔ بہٕ چُھسے ژےٚ تعریف کران زِ ژےٚ رکٲوِتھ تِم لوٗکھ یِم کتھ سمجھنس منٛز پانس چالاک مانان چھِ۔ تمہِ بجایہ کریتھ ژےٚ تِمہٕ پزٕ کتھٕ تِمن لوٗکن نِش اظہار یِم لۅکٹٮ۪ن شُرین ہنٛدؠ پٲٹھؠ ماننہٕ خٲطرٕ تیار آسان چھِ۔ اوے، میانہِ ببہٕ، تہِ کوٚڑُتھ ژےٚ امہِ سببہٕ تکیازِ یہِ آوے ژےٚ پسنٛد۔
\v 22 خداین، میٲنؠ ببن چُھ مےٚ سورےٕ کینٛہہ دِتمُت۔ صرف زانہِ ببےٕ یوت پٔزؠ پٲٹھؠ پننِس گۅبرس۔ تہٕ بییٔ یوت، تٔمؠ سُنٛد گۅبُر، زانن پننُ بب اصل پٲٹھؠ۔ پوٚز بہٕ چُھس کینٛہہ لوٗکھ ژاران یِمن بہٕ سُہ ہاون زِ سُہ کُس چُھ۔"
\v 23 پتہٕ ووٚن یسوعؔن، بلکل پننؠن شٲگردن، "خداین بنٲیو توٚہؠ اتھ لایق زِ توٚہہِ چھُنو اکھ بوٚڈ انعام عطا کوٚرمُت یمہِ سٟتؠ توٚہؠ تِم چیز وُچھان چُھو یِم بہٕ کران چُھس!
\v 24 بہٕ چُھس یژھان توٚہؠ زٲنیٚو زِ واریہو نبی یو تہٕ بادشاہو یژھاے یِم چیز وُچِھنؠ یِم توٚہہ بہٕ کران وُچھووس۔ مگر تِمو وُچھ نہٕ، تکیازِ تِم ٲسؠ واریاہ کال برونٛہہ زندٕ۔ تِمو آسہ ہے یمہٕ کتھٕ بوزنُک آرِزو کوٚرمُت یمہٕ توٚہؠ مےٚ نِش بوزان چُھو۔ پوٚز تِمو بوزنہٕ تہِ، تکیازِ تِم ٲسؠ واریاہ پتھ کالٕکؠ۔"
\v 25 تتہِ اوس اکھ یہُودؠ شریعت ہیٚچھناون وول شخص۔ تٔمؠ یوٚژھ یسوعؔ ہس آزماونہٕ خٲطرٕ اکھ مشکل سوال پرِژُھن۔ اوے وُتھ سُہ تھوٚد تہٕ پرُوژھنس، "ووستاد، مےٚ کیاہ چُھ کرُن تاکہِ بہٕ روزٕ ہمیشہ خدایس سٟتؠ؟"
\v 26 تمِس ووٚن یسوعؔن، "ژےٚ چُھتھ موسیٰؔ سُنٛد شریعت پوٚرمُت یُس تمِس خداین عطا کوٚرمُت اوس۔ سُہ شریعت کیاہ چُھ ونان؟"
\v 27 \f + \fr 10‏:27 \ft متی 22:37۔ 40، تثنِیہ شرع۔ 6:5، 10:12، یوحنا 22:5\f* تٔمؠ شخصن دِیت جواب یہِ چُھ شریعتس منٛز لیکھتؠ، "دل و جان بٔریو تہنٛدس خداوند خدایس لول، تہنٛدِ روحہٕ سٟتؠ، تہنٛدِ سٲری طاقتہٕ سٟتؠ بیٚیہِ تہنٛز عقلہٕ سٟتؠ۔ بیٚیہِ بٔریو پننِس ہمسایس توٚت لول یوٚت پنِنِس پانس بران چُھو۔"
\v 28 \f + \fr 10‏:28 \ft احبار 18:5\f*یسوعؔن ووٚنس، "ژےٚ دِتُتھ بلکل سہی جواب۔ ہرگاہ ژےٚ تہِ سورےٕ کرکھ، ژٕ روزکھ ہمیشہِ خدایس سٟتؠ۔"
\v 29 مگر سُہ شخص اوس یژھان زِ خدا گوٚژھ تمِس خوش گژھن۔ اوے ووٚن تٔمؠ یسوعؔس، "کٔم لوٗکھ چھِ میٲنؠ ہمسایہِ یمن مےٚ پزِ لول برُن؟"
\v 30 یسوعؔن دیُت جواب، "اکہ دوٚہو، اوس اکھ یہُودؠ شخص یروشلمہٕؔ پؠٹھٕ یرِیحُو کنُ سفر کران۔ کینٛژو ڈاکوہو کوٚر تمِس حملہٕ۔ تِمو نیہ تمِس شخصس سٲری پلو بیٚیہِ تہِ سورےٕ یہِ تمِس نِشہ اوس۔ تِمو کوٚر سُہ اڈٕمور۔ پتہ تروٛوُکھ تٔتی۔
\v 31 اتفاقن اوس اکھ یہُودؠ کاہن تپٲرؠ وتہِ پکان۔ ییٚلہِ تٔمؠ سُہ شخص وُچھ، مدد کرنہٕ بجایہ دراو سُہ وتہِ بیٚیہِ انٛدٕ۔
\v 32 یتھٕ پٲٹھؠ، اکھ خدایہِ سنٛدِس گرس منٛز کٲم کرن وول لاوی تہِ ووت تتھ جایہِ تہٕ وچُھن سُہ شخص۔ مگر سُہ تہِ دراو وتہِ بیٚیہِ انٛدٕ۔
\v 33 پتہٕ آو تمہِ وتہِ سامری علاقک اکھ نفر ییٚتہِ سُہ شخص پیمُت اوس۔ ییٚلہِ تٔمؠ سُہ شخص وُچھ، تمِس آو تسَ پؠٹھ رحم۔
\v 34 سُہ گوٚو تسَ نِش تہٕ تٔمؠ سنٛدین زخمن مُلُن زیتون تیٖل بیٚیہِ شراب یُتھ زن سُہ ٹھیک سپدِ۔ تٔمؠ گنجہِ تٔمؠ سنٛدین زخمن پؠٹھ دجہِ ریلہٕ۔ پتہٕ تھوٚون پننِس خرس پؠٹھ تہٕ واتناون أکِس سرایہِ منٛز تتہِ کرنس خدمت۔
\v 35 \f + \fr 10‏:35 \ft یہِ رقم چھِ گامکس مُزوٗرس دوٚن دوٚہُن ہنٛزِ مُزوٗرِ برابر۔ \f*صبحس دِتؠ تٔمؠ زٕ چاندِ ہنٛدؠ سکہٕ سرایہِ ہنٛدس مٲلکس تہٕ ووٚننس، "أمِس شخصس تھٲوؠ زِ نظر گُذر۔ ہرگاہ ژےٚ یمہِ رقمہٕ کھوٗتہِ زیادٕ أمؠ سٕنٛدِس علاجس پؠٹھ خرچ سپدی، بہٕ دِمے ژےٚ ییٚلہِ بہٕ واپس یمہٕ۔"
\v 36 پتہٕ پرُوژھ یسوعؔن تمِس "ترٛیو نفرو وُچھ سُہ شخص یمِس ڈاکوہوو حملہٕ کوٚرمُت اوس۔ ژٕ کسُ نفر وُنکھ اوس تمِس شخصہ سنٛدؠ پوٚز ہمسایہِ؟"
\v 37 شریعتکؠ ووستادن دِیت جواب، "سُہ اکھ یمِس تمِس پؠٹھ رحم آو۔ "یسوعؔن ووٚن تمِس، "تہِ چُھ ٹھیک۔ لہٰذا ژےٚ پزِ یتھے پٲٹھؠ تمِس أکِس نِش گژھن یمِس چٲنہِ مددتُک ضرورت آسہ۔"
\v 38 چونکہِ یسوعؔن تہٕ تٔمؠ سنٛدیو شاگردو تھوٚو سفر جٲری، تِم ژایہِ أکِس خاص گامس منٛز۔ تتہِ دِژ مارتھاؔ ناوچہِ اکہ زنانہِ تِمن پنُن گرٕ ینٕچ دعوت۔
\v 39 تس سنٛز بیٚنہِ، یمِس مریمؔ ناو اوس، بیٖٹھ یسوعؔ سنٛدین کھوٗرن نکھٕ تہٕ بوزن تہِ یہِ سُہ تعلیم دِوان اوس۔
\v 40 مگر مارتھایٔیؔ ٲس تِہنٛدِ خٲطرٕ کھؠن تیار کرنس متعلق فِکر۔ سۅ گییہِ یسوعؔ ہس نِش تہٕ ووٚننس، "خداوند، میانہِ بیٚنہِ ترٲوِ مےٚ سورےٕ کینٛہہ پانے تیار کرُن۔ ژےٚ چھۓ پتاہ زِ یہِ چُھ نہٕ جان۔ مہربٲنی کٔریتھ ووٚن تسَ زِ سۅ کرِ مےٚ مدد!"
\v 41 مگر یسوعؔن دِیت تسَ جواب، "مارتھاؔ، مارتھاؔ، ژےٚ چھۓ واریہن چیزن متعلق فِکر۔
\v 42 مگر اکھ کتھ چھےٚ پزِؠ پٲٹھؠ ضروری زِ تہِ بوز یہِ بہٕ تعلیم دِوان چُھس۔ چونکہِ مریمنؔ ژٲر رٕژ کٲم، بہٕ ونہٕ تس زِ سۅ کرِ کانٛہہ بیٚاکھ کٲم۔"
\c 11
\p
\v 1 یسوعؔ اوس اکہ دوٚہہ أکِس خاص جایہِ دُعا کران۔ ییٚلہِ سُہ دُعا کٔریتھ سپدیوو، تمِس ووٚن شاگردو منٛزٕ اکؠ شٲگردن، "خداوند اسہِ ہیٚچھِ ناو دُعا کتھٕ پٲٹھؠ کٔرن۔ یتھٕ کِنؠ بپتسمہ دِنہِ وٲلؠ یوحناؔہن پنٕنؠ شٲگرد ہیچھنٲوؠ۔"
\v 2 تٔمؠ ووٚن تِمن، "ییٚلہِ أسؠ دُعا کرو، اوے منٛگِو یتھٕ پٲٹھؠ: ببہٕ، تمام لوٗکن نِشہ روٗزن چانہِ ناوک بجر۔ پرٛیتھ جایہِ ین تمام لوٗکن پؠٹھ ؤلؠ ؤلؠ چٲنؠ بادشٲہی۔
\v 3 مہربٲنی کٔرِتھ اسہِ دِ پرٮ۪تھ دوٚہہ باپتھ غذا یہِ اسہِ لگہِ۔
\v 4 مہربٲنی کٔریتھ کرِ تہٕ اسہِ تِم گناہ معاف یِم اسہِ کٔرمٕتؠ چھِ۔ أسؠ کرو تِمن لوٗکن معاف یمو اسہِ سٟتؠ غلط کوٚرمُت چُھ۔ اسہِ بچاو تہٕ گناہ کرنہٕ نِشہ ییٚلہِ اسہِ تِم بہکاون چھِ۔"
\v 5 پتہٕ ووٚن تٔمؠ تِمن، "مَثلنَ توٚہہِ منٛزٕ زنہٕ گژھِ اکھ نفر کٲنٛسہِ دوستہٕ سنٛدِس گرس منٛز نیصف رٲژ۔ توٚہؠ گژھو نیٚبرؠ کِنؠ کھڑا تہٕ دِہوٗس آلو، "میانہِ دوٗستا، مہربٲنی کٔریتھ دِسا مےٚ ترٛےٚ ژوٚچہِ ووٚزم!
\v 6 میٚون بیٚاکھ دوس چُھ سفرٕ پؠٹھٕ مےٚ نِش آمُت۔ مگر مےٚ نِش چُھنہٕ کہنؠ غذا یُس بہٕ تسَ دِمہٕ!
\v 7 مثلن سُہ چُھ گرس انٛدرےٕ جواب دِوان، "مےٚ مہَ کرِ تنگ! مےٚ چُھ دروازٕ کوٚرمُت بنٛد، بیٚیہِ چھِ میانہِ گرکہ سٲری بٲژ شونٛگِتھ۔ یہِ گژھِ میانہِ خٲطرٕ سیٹھاہ مشکل زِ بہٕ وتھٕ تھوٗد تہٕ ژےٚ دِمے کینٛہہ!
\v 8 بہٕ چُھسو توٚہہِ ووٚنُن، ہرگاہ سُہ یمہِ سببہٕ آسہ نہٕ تھوٗد وُتھن یژھن زِ سُہ چُھ تسُنٛد دوس بہٕ کیازِ دِمہٕ تس غذا۔ پوٚز ہرگاہ سُہ تمِس پتہٕ لگہ، سُہ نفر وتھِ انٛدرٕ یقیٖنن تھۅد تہٕ دِیہ تس پرٛیتھ کانٛہہ چیز یُس تمِس ضرورت چُھ۔
\v 9 لہٰذا بہٕ چُھسو توٚہہِ ونان: خدایس روزیٚو تِم چیز منٛگان یِم توٚہہِ ضرورت چھِ، سُہ دِیہ توٚہہ تِم چیز۔ تِم چیز روزیٚو خدایس منٛگان، تہٕ توٚہہِ میلہِ تہٕ گژھن حٲصٕل۔ خدایس منٛگو پننہِ خٲطرٕ چیز دستِیاب تھاوُنؠ، سُہ کرِ تِم تُہنٛد باپتھ فراہم۔
\v 10 توٚہہِ پزِ یہِ کرُن تکیازِ یُس تہِ کانہٛہ اکھا خدایس منٛگان چُھ روٗزان تمِس چُھ تہِ حٲصٕل سپدان۔ خدایس یُس یِم چیز منٛگان روٗزان چُھ تمِس چھِ تِم چیز سُہ دِوان۔ ہرگاہ کانٛہہ اکھ خدایس پننہِ باپتھ چیز ممکن بناونؠ منٛگان چُھ، خدایہِ دِیہ تمِس تِم۔
\v 11 مثلن تہندیو مٲلو منٛزٕ آسہ اکھ موٗل یمہِ سُنٛد نیٚچو پننِس مٲلس کھٮ۪نہٕ خٲطرٕ  گاڈ منگہِ۔ سُہ دِیو نہٕ تسَ ہرگز تمہِ بجایہ اکھ زہریلہٕ سرف!
\v 12 مثلن تٔمؠ موٚنگ تسَ اکھ ٹھوٗل۔ سُہ دِیہ نہٕ تس تمہِ بجایہ اکھ بِچ!
\v 13 اگرچہ توٚہؠ بدکار لوٗکھ ٲسِتھ تہِ پننؠن شُرؠن رٕتؠ چیز دِنؠ زانن چُھو۔ لہٰذا یہِ چُھ تمہِ کھۅتہٕ زیادٕ یقین زِ آسمانس پؠٹھٕ دِیہ بب تِمن پاک روح یِم تمِس منٛگن۔"
\v 14 یسوعؔ اوس اکہ دوٚہہ أکِس بدروحس أکِس نفرٕ منٛزٕ نیٚبر کڈان یِم سُہ نفر کول کوٚرمُت اوس۔ یسوعؔن ییٚلہِ سُہ بدروح نیٚبر کوٗڈ، پتہٕ لاجہِ تٔمؠ نفرن کتھٕ کرنہِ۔ امہِ سٟتؠ گوٚو تتہِ لوٗکن ہُنٛد ہجوم حٲران۔
\v 15 پوٚز تِمو منٛزٕ ووٚن کینٛژو، "یہِ چُھ بعَلزبُولؔ، بدروحن ہُنٛد سردار، یُس یمِس شخصس بدروح نیٚبر کڈنس منٛز مدد چُھ کران"
\v 16 تتہِ لٔگؠ کینٛہہ باقےٕ لوٗکھ تِہنٛدس اختیارس پؠٹھ سوال کرنہِ۔ تِمن کوٚر مطالبہ زِ سُہ ہاوِ اکھ معجزٕ یُس ثٲبت کرِ زِ سُہ اوس خداین سوٗزمُت۔
\v 17 پوٚز تٔمؠ زوٗن زِ تِم کیاہ ٲسؠ سونچان۔ لہٰذا تٔمؠ ووٚن تِمن، "ہرگاہ کُنہِ قومہٕ کؠن لوٗکن منٛز پھاس پیٚیہِ، سۅ قوم گژھِ تباہ۔ ہرگاہ أکِس گرس منٛز روٗزن والیٚن درمیان پھاس پییٚہِ، سُہ گرٕ گژھِ تباہ۔
\v 18 یِتھۓ پٲٹھؠ،  اگر شیطان پانسےٕ خلاف لڑنہِ لوٚگ تہٕ تسنٛدین بدروحن درمیان پھاس پییٚہِ، تس سنٛز حکمرٲنی گژھِ یقیٖنن تِمن پؠٹھ ختم! بہٕ چُھس یہِ ونان تکیازِ توٚہؠ چُھو ونان زِ بہٕ چُھس بدروح بدروحن ہُنٛدس بادشاہ سنٛدِ طاقتہٕ سٟتؠ نیٚبر کڈان!
\v 19 اگر یہِ پوٚز چُھ زِ بعَلزبُولؔ چُھ مےٚ بدروح نیٚبر کڈنس منٛز مدد کران، یہِ تہِ گژھِ تِلہٕ ضرور پوٚز آسُن زِ سُہ چُھ تہنٛدین شٲگردن تہِ بدروح نیٚبر کڈنس منٛز مدد کران۔ مگر توٚہؠ چُھو نہٕ تہِ مانان پوٚز لہٰذا تُہنٛدؠ پنٕنؠ شٲگرد چھِ ثٲبت کران زِ توٚہؠ چُھو غلط۔
\v 20 بہٕ چُھس اصلی خدایہِ سٕنٛدِ طاقتہٕ سٟتؠ بدروح نیٚبر کڈان۔ امیٚک مطلب چُھ یہِ زِ خدایہِ سٕنٛز  بادشٲہی چھےٚ توٚہہِ پؠٹھ آمٕژ۔"
\v 21 یسوعؔ گوٚو ونان، "ییٚلہِ اکھ بہودرُ شخص واریاہ ہتِھیار ہٮ۪تھ پننِس صحنس رٲچھ چُھ کران، تِیٚلہِ ہیٚکہ نہٕ اکھ انٛدرٕ چیز ژورِ نیتھ۔
\v 22 پوٚز ییٚلہِ بیٚیہِ کانٛہہ اکھا تسٕنٛدِ کھوٗتہٕ زیادٕ بہودرُ تمِس پؠٹھ حملہٕ کران چُھ تہٕ تس پؠٹھ غٲلب سپدتھ، تمِس تِم ہتھیار تھپہِ نِوان یِمن پؠٹھ تس بھروسہٕ آسان چُھ۔ پتہٕ ہیٚکہ سُہ تمِس شخصہٕ سٕنٛدِ گرٕ منٛزٕ پرٛیتھ کانٛہہ سُہ چیز ژورِ نیتھ یُس تمِس پسنٛد ییہِ۔
\v 23 کانٛہہ اکھ یُس نہٕ مےٚ حوصلہٕ افزائی کران چُھ سُہ چُھ میٲنؠ مخٲلفت کران۔ کانٛہہ اکھ یُس نہٕ لوٗکھ مےٚ نِش انان چُھ سُہ چُھ تِمن مےٚ نِش دوٗر کران۔"
\v 24 پتہٕ ووٚن یسوعؔن، "ییٚلہِ اکھ بدروح کٲنسہِ أکِس نفرس منٛزٕ نیران چُھ پتہٕ چُھ سُہ وجارٕ علاقن منٛز آوارٕ گژھتھ بیٚیہِ کٲنسہِ نفرس تلاش کران یمِس منٛز سُہ روزِ۔ ہرگاہ تمِس پیوٚ نہٕ تتہِ بُتھِ کانٛہہ نفر، سُہ وننہِ، بہٕ گژھٕ تمِس نفرس نِش واپس یمِس منٛز بہٕ روٗزان اوسُس!
\v 25 لہٰذا سُہ چُھ واپس گژھن تہٕ وچھان چُھ زِ سُہ نفر چُھ أکِس گرس ہیوٚ یُس کٔمؠ تام اصل پٲٹھؠ شیرٛتھ سمبٲلتھ تھوٚومُت چُھ، مگر تتھ منٛز چُھنہٕ کانٛہہ اکھ تہِ روٗزان۔
\v 26 اوٕ پتہٕ چھُ یہِ بدروح ژھانٛڈ دِتھ مذید ستن بدروحن انان یِم تسٕنٛدِ کھوٗتہٕ زیادٕ بدتر آسان چھِ۔ تِم سٲری چھِ تمِس نفرس منٛز دٲخٕل سپدن تہٕ تمِس منٛز روٗزتھ زندگی بسر کرٕنؠ شروع کران۔ تمِس نفرٕ سنٛز حٲلت ٲس برٛونٹھے خراب، وُنؠ گییہِ تمہِ کھوٗتہٕ زیادٕ خراب۔"
\v 27 ییٚلہِ یسوعؔن تہِ ووٚن، لوٗکن ہُنٛدس ہجومس منٛز ٲس اکھ زنان تہِ بوزان، تمہِ دِژ زورٕ کرٛکھ، "خدایہِ چُھ تمِس زنانہِ خوش یمِس ژؠ زٲمُت چُھکھ بیٚیہِ یمہِ ژٕ روٚچھمُت چُھکھ"
\v 28 پتہٕ ووٚن تٔمؠ، "خدایہِ چُھ تِمن زیادٕ پہن خوش یِم تسنٛد کلام بوزان چھِ بیٚیہِ اتھ پؠٹھ عمل کران چھِ"
\v 29 یسوعؔ ہس انٛدؠ انٛدؠ لوٗکن ہُنٛدس ہجومس سٟتؠ شٲمل سپدنہٕ خٲطرٕ ٲسؠ زیادٕ کھۅتہٕ زیادٕ لوٗکھ یوان۔ تٔمؠ ووٚن، "یمہِ زمانٕکؠ لوٗکھ چھِ خراب۔ تِم چھِ یژھان زِ بہٕ ہاوٕ تِمن اکھ معجزٕ یمہِ سٟتؠ ثٲبت سپدِ زِ بہٕ چُھس خداین سوٗزمُت۔ پوٚز یونؔاہ سٕنٛدِ معجزٕ ورٲے ییہِ نہٕ تِمن بیٚیہِ کانٛہہ معجزٕ ہاونہٕ۔
\v 30 خداین کوٚر واریاہ برونٛٹھ اکھ معجزٕ یونؔاہ سٕنٛدِ باپتھ ییٚلہِ یونس اوس أکِس بجہِ گاڈِ ہنٛدِس شکمس منٛز۔  یُس نینوہؔ کؠن لوٗکن ہاؤن اوس زِ سُہ اوس تٔمؠ سوٗزمُت۔ یتھے پٲٹھؠ، کرِ وُنؠ خدایہِ اکھ معجزٕ میانہِ، آدمؔ سٕنٛدِ اولادٕ خٲطرٕ، ازِکؠن لوٗکن ہاؤن زِ بہٕ چُھس تٔمؠ سوٗزمُت۔
\v 31 \f + \fr 11‏:31 \ft بادشاہت 1۔ 10:1۔ 10، توٲریخ 2۔ 9:1\f* ملکٲنہِ صباہنؔ کوٚر واریاہ کال برونٛٹھ سلیمانؔ سنٛزٕ دانٲییٔ ہنٛزٕ کتھٕ بوزنہٕ خٲطرٕ اکھ سؠٹھاہ زیوٹھ سفر۔ وۅنؠ چُھ سلیماؔنہِ کھۅتہٕ بوڈ اکھ شخص توٚہہِ نِشہ موجود۔ پوٚز توٚہہِ چُھو نہٕ تہِ اصل پٲٹھؠ بوزان یہِ بہٕ ونان چُھسو۔ لہٰذا، یمہِ وِزِ خدا توٚہہِ لوٗکن حساب لاگہِ، سۅ سپدِ کھڑا تہٕ کرِ تِمن لوٗکن ملامت یِم ونہِ کؠن زندٕ چھِ۔
\v 32 ییٚلہِ یوحناہؔن قدیٖم نینوہؔ شہرکؠن لوٗکن تبلیغ کوٚر تِم پھیرِ گناہ کرنہٕ نِشہ پتھ۔ وُنؠ چُھس بہٕ یونؔاہ سٕنٛدِ کھوٗتہٕ تھوٗد، توٚہہِ تبلیغ کرنہِ آمُت۔ پوٚز توٚہؠ چُھو نہٕ گناہ کرنس پتھ روٗزان۔ قیامتٕکہ دوٚہہ ییٚلہِ خدایہِ فٲصلہٕ کرِ، نینواہسؔ منٛز تِم روٗزن وٲلؠ لوٗکھ وتھن تھوٗد تہٕ أزؠ کیٚن زمانس منٛز روٗزن والیٚن لوٗکن کرن ملامت۔
\v 33 یِم لوٗکھ اکھ ژونگ زٲلن چھِ تِم چھِنہٕ تتھ ژوٗرِ تھاوان یا تتھ أکِس ٹوکرِ تل تھاوان۔ تِم چھِ تتھ تمہِ بجایہ، أکِس زوٗرِ پؠٹھ تھاوان یتُھ زن کمرس منٛز اژن والیٚن بوٗزنہٕ ییہِ۔
\v 34 چانہِ بدنُک ژونگ چھِ چٲنؠ أچھ۔ ہرگاہ چٲنؠ أچھ چھِ اصل پٲٹھؠ کٲم کران، تیلہِ آسہ چٲنس بدنس اصل پٲٹھؠ گاش۔ ہرگاہ چٲنؠ أچھ آسہ نہٕ اصل پٲٹھؠ کٲم کران، تیلہِ روزٕ چون سورےٕ بدن گاشہٕ ورٲے۔
\v 35 تٔمہِ کِنؠ روزیٚو محتاط زِ یُس گاش توٚہہِ منٛز چُھ سُہ چُھنہٕ انہِ گوٚٹ بَنان بلکہِ دِیو توٚہہ انٛدر کنُ ہرگاہ۔ حالانکہ یہِ چھِنہٕ ژکہِ اصل پٲٹھؠ کٲمے کران تہٕ انٛدر کنُ چُھنہٕ گاشی واتان۔
\v 36 ادٕ ہرگاہ چٲنس بدنکِس انٛگس انٛگس چُھ گاش واتان، لہٰذا تمیٚک کانٛہہ تہِ انٛگ چُھنہٕ انہِ گٹس منٛز، پتہٕ آسہ چٲنس بدنس منٛز گاشی گاش۔ پریٚزلوُن گاش چمکٲیہِ چٲنس سٲرسےٕ انٛدرمِس بدنس، یتھٕ پٲٹھؠ زن اکھ پریٚزلوُن ژونگ نیٚبرٕ سٲرسےٕ گاشراوان چُھ۔"
\v 37 یمہٕ کتھٕ وننہٕ پتہٕ دِژ اکؠ فریسین یسوعؔ ہس اکھ سال کھؠنہٕ خٲطرٕ دعوت۔ لہٰذا یسوعؔ گوٚو تمِس فریسی سُنٛد گرٕ تہٕ بیوٗٹھ میزس پؠٹھ کھؠنہِ۔
\v 38 سُہ فریسی سُپد حٲران ییٚلہِ تٔمؠ وُچھ زِ یسوعؔن چٔھلؠ نہٕ یہُودؠ شریعت مطٲبق کھؠنہٕ برونٛٹھ پننؠن اتھٕ۔
\v 39 یسوعؔن ووٚن تمِس، "توٚہؠ فریسی چُھو کھؠنہٕ برونٛہہ پیالہٕ تہٕ تھالہِ نیٚبرؠ کِنؠ چھلان، پوٚز تِہنٛد انٛدرون چُھ سیٹھاہ لالچی تہٕ بدکار۔
\v 40 توٚہؠ چُھو بےوقوف لوٗکھ! توٚہؠ چُھو یقیٖنن زانان زِ خداین بنوو نہٕ نیٚبری یوٚت، بلکہ تٔمؠ بنوو انٛدرؠ تہِ!
\v 41 رسمی طور تھالہِ صاف کرنس متعلق فِکر کرنہٕ بجایہ، بنو رحم دل تہٕ دِیو ضرورت منٛد لوٗکن تہِ یہِ تھالؠن منٛز آسن چُھ۔ ادٕ آسہ تُہنٛد دوٗشوے ظٲہر تہِ بٲطن خدایس منظور۔
\v 42 \f + \fr 11‏:42 \ft متی 23:23، مِیکاایلؔ 6:8، احبار 27:30\f*پوٚز یہِ کوتاہ خطرناک آسہ توٚہہِ فریسین ہنٛدِ خٲطرٕ! توٚہؠ چُھو ہوشیاری سان پننہِ تمام جاییٔدادک اکھ دٔہِم حصہٕ خدایس دِوان، یتھ منٛزٕ ہتاکہ سۅ سبزی تہِ چھِ شٲمل آسان یوسہٕ توٚہؠ پننؠن وارین منٛز وۅپداوان چُھو۔ مگر تمہِ پتہٕ چُھونہٕ توٚہؠ باقین سٟتؠ خدایہِ سُنٛد لول باگراوان یا رٕژر ورتاوان۔ خدایس تہِ دِنہٕ پتہٕ پزِ توٚہہ پانس سام ہنؠ زِ أسؠ کرو نہٕ تہِ۔
\v 43 یہِ کوتاہ خطرناک آسہ تہنٛدِ خٲطرٕ فریسیو، تکیازِ توٚہؠ چُھو ہیکلن منٛز سیٹھاہ اہم جاین پؠٹھ بِہُن پسنٛد کران، بیٚیہِ چُھو یہِ پسنٛد کران زِ لوٗکھ کرن توٚہہِ بازرن منٛز خاص عزتہٕ سان سلام۔
\v 44 یہِ کوتاہ خطرناک آسہ تہنٛدِ خٲطرٕ فریسیو، تکیازِ توٚہؠ چُھو تِمن گمنام قبرن ہیوؠ یِمن پؠٹھِ لوٗکھ یہِ زانہٕ ورٲے پکان چھِ زِ یہِ چُھ رسمی طور ناپاک۔"
\v 45 یہُودؠ شریعت ہیٚچھِ ناوان والیٚو منٛزٕ کٔر اکؠ نفرن یسوعؔ ہس شٔکایت، "ووستاد، ییٚلہِ ژےٚ یِمہٕ کتھٕ یتھٕ پٲٹھؠ ونان چُھکھ، ژٕ چُھکھ اسہِ تہِ ؤکر والان"
\v 46 پوٚز یسوعؔن ووٚن واپس، "یہِ کوتاہ خطرناک آسہ تہنٛدِ خٲطرٕ یِم شریعتکہ ووستاد چھِ! بہٕ چُھس یہِ ونان تکیازِ توٚہؠ چُھو لوٗکن واریاہن تِتھٮ۪ن حکمن پیٚٹھ عمل کرٕنؠ ونان، تمہِ پتہٕ چُھو نہٕ توٚہؠ تِمن مدد کرنہٕ خٲطرٕ کانٛہہ معمولی کٲم تہِ کران۔
\v 47 یہِ کوتاہ خطرناک آسہ تہنٛدِ خٲطرٕ، تکیازِ توٚہؠ چُھو نبی ین ہنٛزن قبرن پٮ۪ٹھ عمارٔژٕ تعمیٖر کران، پوٚز تہنٛدؠ جد ٲسؠ تِم، یِمو تِم قتٕل کٔرؠ!
\v 48 لہٰذا ییٚلہِ توٚہؠ یمہٕ عمارٔژٕ تعمیٖر چُھو کران، توٚہؠ چُھو بیان کران بیٚیہِ تتھ تصدیق کران زِ تُہنٛدیو جدو ٲسؠ تِم نبی قتٕل کٔرؠ مٕتؠ۔
\v 49 اوے چُھ خداین بیٚیہِ ووٚنمُت، یس سیٹھاہ دانا چُھ، "بہٕ سوزٕ پننؠن لوٗکن رہبری کرنہٕ خٲطرٕ نبی تہٕ رسول۔ مگر تِم واتناون تِمن سیٹھاہ تکلیف۔ ہتاکہ تِم کرن تِمو منٛزٕ کینٛژن قتل تہِ۔
\v 50 امیٚک نتِیجہ نیرِ، یہِ زِ یمہِ زمانکؠن لوٗکن ییہِ تِمن سارنےٕ نبی ین ہُنٛدس قتل کرنس پؠٹھ سزا دِنہٕ یِمو لوٗکو دُنیا پٲدٕ سپدنہٕ پؠٹھٕ تِم قتل کٔرمٕتؠ چھِ۔
\v 51 تِمن ییٚتہِ پرٛتھ کُنہِ قتلس پؠٹھ سزا دِنہٕ یِم زنہٕ آدمؔ سُنٛد نیٚچو ہابیلؔ یُس تٔمؠ سٕنٛدؠ بٲے قاینؔ قتل کوٚر، نبی زکریا سٕنٛدِ قتلہٕ پؠٹھٕ، یُس بادشاہ سٕنٛدیو اہلِکارو ہیکلس منٛز قربان گاہس تہٕ پاک جایہِ سیمنٛزس قتل کوٚر۔
\v 52 ہیے یہُودؠ شریعتکؠو ووستادو، یہِ کوتاہ خطرناک آسہ تہنٛدِ خٲطرٕ۔ توٚہؠ چُھو خدایہِ زان نس منٛز لوٗکن پتھ رٹان! توٚہؠ چُھو نہٕ پانہٕ خدایہِ زانان، تہٕ توٚہؠ چُھو تِمن لوٗکن باپتھ مشکلات پٲدٕ کران یِم اصل پٲٹھؠ خدایہِ زانن یژھان چھِ۔
\v 53 یمہِ کتھٕ ونِتھ درٛاو پتہٕ یسوعؔ تمِس فریسی سٕنٛدِ گرٕ منٛزٕ۔ پتہٕ لٔگؠ تِم یہُودؠ شریعتکہ ووستاد تہٕ فریسی تمِس مُخلفانہٕ انٛدازس منٛز پیس ینہِ۔ تِمو تُلؠ سَختی سان واریہن چیزن متعلق تمِس سوال۔
\v 54 تِم روٗدؠ تٔمؠ سنٛزٕ کتھٕ بوزان زِ سُہ ونہِ کینٛہہ غلط یوٗتھ زن تِم ہیٚکہ ہن تمِس اپٕزؠ تعلیم دِنچؠ تُہمت لٲگتھ۔
\c 12
\p
\v 1 امی ساعتہٕ، گییہِ ساسہٕ بدؠ لوٗکھ یسوعؔ ہس انٛدؠ انٛدؠ جمع۔ تتہِ ٲسؠ واریاہ لوٗکھ یِم اکھ أکِس کھوٗر منٛڈان ٲسؠ۔ گوٚڈٕ لوٚگ سُہ پننؠن شٲگردن وننہِ، "ہوشیار روزِو زِ توٚہؠ مٕہ بٔنیٚو فریسین ہُنٛدؠ پٲٹھؠ، یِم عوامس منٛز مذہبی چھِ لاگان مگر ژوٗرِ پٲٹھؠ چھِ غلط کامہِ کران۔
\v 2 یہِ چُھ لوٗکن ہُنٛدِ خٲطرٕ بےفٲیدٕ زِ تِم کرن پنٕنؠ گناہ پردس تل تھاونچ کوٗشش۔ کنہِ دوٚہہ کرِ خدا پرٛیتھ أکِس تتھ متعلق زانیاب یہِ لوٗکھ کٔھٹِتھ تھاونچ کوٗشش چھِ کران۔
\v 3 کنہِ دوٚہہ بوزن لوٗکھ تہِ سورےٕ عوامس منٛز یہِ ژےٚ بادشاہ پٲٹھؠ ووٚنمُت ٲسِتھ۔ کنہِ دوٚہہ بوزٕناوِ کانٛہہ اکھا کریکہٕ دِتھ پرٛیتھ أکِس تہِ یہِ ژےٚ ٲسِتھ کمرس منٛز فِسرارے کٔرمٕژ۔
\v 4 میانیٚو دوستو، ہُشیٲری سان بوٗزو! تِمن لوٗکن مہٕ کھوٚژِو۔ تِم ہیکن توٚہہِ قتل کٔریتھ، مگر تمہِ پتہٕ ہیکن نہٕ تِم توٚہہِ زیادٕ کینٛہہ تہِ کٔریتھ!
\v 5 بہٕ ونہٕ توٚہہِ کسَ شوٗبہِ پٔزؠ پٲٹھؠ کھوٗژن۔ توٚہہِ پزِ خدایس کھوٗژن۔ تمِس چُھنہٕ صرف لوٗکھ مارٕ کرنُک اختیارےٕ یوت، بلکہ تمِس چُھ بیٚیہِ تِم جہنمس ترٛاونکُ اختیار تہِ! آ، یہِ چُھ خدا یمِس توٚہہِ پٔزؠ پٲٹھؠ کھوژُن پزِ۔
\v 6 ژٔرؠن متعلق سونٛچو۔ تِمن چُھ تیوٗتتاہ کم قیمت آسان زِ توٚہؠ ہیکیو تِم پانٛژھ صرف دوٗن ٹکن مٔلؠ ہٮ۪تھ۔ تمہِ پتہٕ تہِ چُھنہٕ خدا تِمو منٛزٕ کٲنسہِ أکِس تہِ مشراوان!
\v 7 ہتاکہ خدایس چُھ یہِ تہِ معلوم زِ تُہنٛدس کلس منٛز کٔژ مس وال چھِ۔ مہَ کھوٗژو، تکیازِ خدایس نِش چُھو توٚہہِ واریہو ژریٚو کھۅتہٕ زیادٕ قدر۔
\v 8 بیٚیہِ چُھس بہٕ توٚہہِ ونان زِ اگر لوٗکھ ونن باقین زِ تِم چھِ میٲنؠ شٲگرد، تِیلہِ ونہٕ بہٕ آدمؔ سُنٛد اولاد، خدایہِ سنٛدین فرشتن زِ تِم لوٗکھ چھِ میٲنؠ شٲگرد۔
\v 9 ہرگاہ تِم ونن باقین زِ تِم چھِنہٕ میٲنؠ شٲگرد، پتہٕ ونہٕ بہٕ خدایہِ سنٛدین فرشتن زِ تِم چھِنہٕ میٲنؠ شٲگرد۔
\v 10 بہٕ ونہٕ توٚہہِ یِتہِ زِ ہرگاہ لوٗکھ مےٚ آدمؔ سٕنٛدِس اولادس متعلق بدرَد ونن، خدایہِ کرِ تِمن تہِ تمہِ خٲطرٕ معاف۔ مگر ہرگاہ لوٗکھ پاک روحس متعلق بدرَد ووٚنُن، خدایہِ کرِ نہٕ تِمن تہِ معاف۔
\v 11 ادٕ ییٚلہِ لوٗکھ توٚہہِ ہیکلس منٛز مذہبی سردارن برونٛہہ کنہِ سوال پرٛژھنہٕ خٲطرٕ نِنوٗو بیٚیہِ تِمن لوٗکن نِشہ یِم ملکس منٛز حٲکم آسن، فِکر گژھِ نہٕ کرٕنؠ زِ توٚہؠ کتھٕ پٲٹھؠ دِیو تِمن جواب یا توٚہہِ کیاہ پزِ ونُن،
\v 12 تکیازِ پاک روح ونہِ توٚہہِ تمہِ ساعتہٕ زِ توٚہہِ کیاہ پزِ ونُن۔"
\v 13 پتہٕ ووٚن لوٗکن ہُنٛدس ہجومس منٛز اکؠ نفرن یسوعؔ ہس، "ووستادٕ، میٲنس بٲیس وُن سُہ دِیہ مےٚ مٲلؠ وراثتہٕ منٛزٕ حصہٕ!"
\v 14 \f + \fr 12‏:14 \ft خروج 2:14\f* پوٚز یسوعؔن ووٚن تمِس، "انسانہ، بہٕ چُھس نہٕ کٲنسہِ اکؠ اکھ جج بنوومُت زِ بہٕ دِمہٕ لوٗکن ہُنٛدس جاییٔدادس متعلق فٲصلہٕ!"
\v 15 پتہٕ ووٚن تٔمؠ لوٗکن ہُنٛدس سٲرسےٕ ہجومس، "ہوش تھٲوِو لالچہِ نِشہ روزیٚو دوٗر! کٲنسہِ نفرٕ سنٛز زندگی چھِنہٕ قبضہٕ کِہِ کثرت سٟتؠ بنیمٕژ۔"
\v 16 یسوعؔن ؤنؠ پتہٕ تتھ ہجومس یہِ دلیل" أکِس خاص امیر نفرٕ سنٛزِ زمیٖنہِ وۅپدؠو واریاہ فصٕل۔
\v 17 تٔمؠ سونچ پانس سٟتؠ، "مےٚ چھِنہٕ پتاہ بہٕ کیاہ کرٕ، تکیازِ مےٚ چھِنہٕ زیادٕ جاۓ ییٚتہِ زن بہٕ پنُن سورےٕ فصٕل ذخیرٕ کرٕ!
\v 18 پتہٕ سونچ تٔمؠ پانس سٟتؠ، مےٚ چھِ پتاہ بہٕ کیاہ کرٕ! بہٕ والکھ پننہِ کُچھِ تہٕ بناوکھ تِم بجہِ! پتہٕ ہیٚکہٕ بہٕ پنُن سورےٕ فصل بیٚیہِ باقیو چیز تِمن بجن نٔوؠن کُچھن منٛز ذخیرٕ کٔریتھ۔
\v 19 پتہٕ وُنہٕ بہٕ پننِس پانس، "وُنؠ کوٚر مےٚ سیٹھاہ مٲل جمع یُس مےٚ واریہن ورؠ ین پوشہِ۔ لہٰذا مےٚ چھِنہٕ فِکر کرنچؠ ضرورت۔ بہٕ کھؠمہٕ تہٕ چیمہٕ بیٚیہِ کرٕ عٲش!"
\v 20 پوٚز خداین ووٚن تمِس، "ہیۓ نادان انسانہ! از رٲژ منٛز یِیی ژےٚ زُو کڈنہٕ! پتہٕ یِم سٲری چیز ژےٚ پننہِ خٲطرٕ جمع چُھتھ کرِمٕتؠ تِمن ہُنٛد مٲلکھ بنہِ بیٚیہِ کانٛہہ، نہٕ کہ ژٕ!"
\v 21 یسوعؔن کٔرؠ یہِ دلیل یہِ وُنہٕ سٟتؠ ختم، "ییہِ سپدِ تِمن یِم چیز صرف پننہِ خٲطرٕ جمع چھِ کران تہٕ تِمن چیزن چھِنہٕ قدر کران یِمن خدایہِ سیٹھاہ قدر تھاوان وٲلؠ مانان چُھ۔
\v 22 پتہٕ ووٚن یسوعؔن پننؠن شٲگردن، "امی دلیلہِ سٟتؠ پزِ توٚہہِ کینٛہہ ہیٚچُھن۔ مہَ بٔریو تتھ متعلق غم زِ توٚہہِ گژھِ زندٕ روزنہٕ خٲطرٕ کٲفی غذا کھؠنہِ خٲطرٕ آسن یا پنُن پان گرم تھونہٕ خٲطرٕ کٲفی پلو لاگنہٕ باپتھ آسٕنؠ۔
\v 23 بہرحال، تہنٛز زندگی چھِ تمہِ غذا کھوٗتہٕ زیادٕ اہم یُس توٚہؠ کھیوان چُھو، بیٚیہِ تُہنٛد بدن چُھ تمہِ پوشاکہٕ کھوٗتہٕ زیادٕ اہم یُس توٚہؠ لاگان چُھو۔
\v 24 \f + \fr 12‏:24 \ft زبُور 147:9\f* جاناوارن متعلق سونٛچِو۔ تِمن چھِنہٕ بیوٛل ووُان، تِم چھِنہٕ فصٕل لونان۔ تِمن چھِنہٕ کُٹھؠ یا عمارٔژٕ آسان یِمن منٛز تِم فصٕل ذخیرٕ کرن، پوٚز خدایہِ چُھ تِمن غذا سوٗزان۔ بیٚیہِ چُھو توٚہؠ یقیٖنن جاناوارو کھوٗتہٕ سیٹھاہ زیادٕ اہمیت تھاوان۔
\v 25 \f + \fr 12‏:25 \ft یا: پننہِ زندگی ہنٛد اکھ گنٹہٕ بڑٲووتو؟\f*توٚہہِ منٛزٕ ہیٚکہ نہٕ کانٛہہ اکھ تہِ فِکر کرنہٕ سٟتؠ پننہِ زندگی ہُنٛد اکھ منٹ تہِ بڑٲوتھ!
\v 26 ادٕ ییٚلہِ نہٕ توٚہؠ تہِ معمولی کٲم ہیکیو کرتھ، توٚہہِ پزِ نہٕ یقیٖنن بیٚیہِ کُنہِ چیزس متعلق فِکر کرٕنؠ۔
\v 27 پوشن متعلق سونٛچو زِ تِم کٔمہِ انٛدازٕ چھِ بڈان۔ تِم چھِنہٕ پونٛسہٕ کماوُنہٕ خٲطرٕ کٲم کران، بیٚیہِ چھِنہٕ تِم پنُن پوشاک پانہٕ بناوان۔ پوٚز بہٕ ونہٕ توٚہہِ زِ بادشاہ سلیمانؔ یُس واریاہ کال برونٛٹھ اوس شاندار پوشاک لاگان، مگر تٔمؠ لوٗگہ نہٕ زانٛہہ شوبہٕ وُن تتھ پوشاک یوٗتھ أکِس پوشش آسن چُھ۔
\v 28 خدایہِ چُھ کُلین خوب صورت بناون، اگرچہ تِم صرف کم وقتس زندٕ چھِ روزان۔ لوٗکھ چھِ تِمن ژٹان پتہٕ چھِ تِمن دانس منٛز لایان۔ پوٚز توٚہؠ چُھو خدایس نِش سیٹھاہ قٟمتی سُہ کرِ توٚہہِ تمہِ کھۅتہٕ زیادٕ رٲچھ یوٗتاہ سُہ کُلین ہنٛز رٲچھ کران چُھ۔ توٚہہِ پزِ خدایس پؠٹھ تمہِ کھوٗتہٕ زیادٕ بھروسہٕ کرُن یوٚت توٚہؠ وُنکٮ۪ن کران چُھو۔
\v 29 یوٚت تام زن تہنٛز کتھ چھِ، پریشان مہٕ روزِو توٚہؠ زِ ٲسؠ کیا کھؠمو تہٕ چؠمو، تہٕ یِمن چیزن متعلق مہَ روزیٚو پریشان۔
\v 30 یمہِ ساتہٕ تِم یِم خدایس چھِنہٕ زانان، چھِ یِمن چیزن متعلق پریشان روٗزان، توٚہہِ ہیکیو بھروسہٕ وٲلؠ تہِ ٲسِتھ زِ تُہنٛدس آسمان کسِ ببس چُھ معلوم زِ توٚہہِ چھِ تِمن ہنٛز ضرورت۔
\v 31 تٔمؠ بدلہٕ، دِیو توٚہؠ تتھ کنُ توجہ زِ توٚہؠ کیاہ ہیکیو خدایہِ سنٛزِ بادشٲہی خٲطرٕ کٔریتھ۔ ییٚلہِ توٚہؠ کٔرِو، پتہٕ ہیکیو توٚہؠ خدایس پؠٹھ بھروسہٕ کٔریتھ زِ سُہ سوزِ توٚہؠ تہِ سورےٕ یہِ توٚہؠ ضرورت چھِ۔
\v 32 میانیو دوستو، توٚہہِ پزِ نہٕ کھوٗژن۔ تُہنٛد بب چُھ آسمانس پؠٹھ یژھان زِ توٚہؠ بنو تٔمؠ سنٛزِ بادشٲہی ہُنٛد اکھ حصہٕ یُتھ تٔمیک سٲری فٲیدٕ سپدن توٚہہِ حٲصل۔
\v 33 لہٰذا پنٕنؠ چیز ژٕھنِو کٕنتھ پونٛسہٕ دِیو تِمن لوٗکن یِمن غذا یا پوشاک یا اکھ روٗزن جاے ضرورت چھِ۔ پننہِ باپتھ بنٲیو تِتھؠ بٔٹوٕ یِم نہٕ پرانن۔ میٚون مطلب چُھ آسمان کسِ خزانس منٛز کٔرِو جمع یُس لازوال چُھ۔ تتہِ ہیٚکہ نہٕ کانٛہہ ژوٗر فَریتھ بیٚیہِ ہیٚکہ نہٕ تُہنٛدس پوشاکس کیٚوم تباہ کٔریتھ۔
\v 34 بہرحال، یہِ کینٛژھا توٚہؠ رٔژھرِتھ تھٲیِو، توٚہؠ سونٛچو امے مطٲبق تہٕ گُزٲرِو اتھ پٮ۪ٹھ پنُن وق۔
\v 35 ہمیشہِ روزیٚو خدایہِ سنٛز کٲم کرنہٕ خٲطرٕ تِمن لوٗکن ہُنٛدؠ پٲٹھؠ کمر گنٛڈتھ، یِمو پنٕنؠ کامہِ پلو نٲلؠ آسن تراوٕمتؠ بیٚیہِ آسن رٔٲتہِ راتس ژٲنگؠ تھاوان دز وٕنؠ۔
\v 36 تِمن خدمت گارن ہنٛدؠ پٲٹھؠ روزیٚو میانہِ واپس ینہِ خٲطرٕ تیار یِم زن پننِس مٲلکہ سُنٛد انتظار کران چھِ یُس اکہ خاندرکہ سالہٕ پؠٹھٕ واپس ینہٕ وول چُھ۔ تِمن چُھ انتظار آسان تسٕنٛدِ خٲطرٕ دروازٕ مٔژاونس یتھےُ سُہ واتہِ تہٕ کرِ تیٚوتھُےٕ دروازس ٹھُک ٹھُک۔
\v 37 یہِ آسہ سیٹھاہ رُت تِمن خدمت گارن ہُنٛدِ خٲطرٕ ہرگاہ تِم پنُن مٲلک واپس ینہٕ وزِ بیدار آسن چھِ۔ مےٚ دِیو یہِ توٚہہِ ووٚننہٕ: سُہ دِیہ تِمن انعامہٕ پانہٕ تِہنٛد خدمت گار بنتھ، تِمن ونہِ بہیو تہٕ کھؠن پیش کرتھ روٗزک خدمتس۔
\v 38 ہرگاہ سُہ شامس ژیٖرؠ یا نیصف رٲژ گرٕ ییہِ، ہرگاہ سُہ چُھ وچھان زِ تسنٛدؠ خدمت گار چھِ بیدار بیٚیہِ تیار تسٕنٛدِ خٲطرٕ، سُہ سپدِ تِمن پؠٹھ سیٹھاہ خوش۔
\v 39 بہٕ چُھس یژھان توٚہؠ کٔرِو یتھ پؠٹھ غور: ہرگاہ اکہ گرکس مٲلکس اوس معلوم زِ اکھ ژوٗر اوس ینہٕ وول، تمہِ وزِ روزِ سُہ بیدار تہٕ ژوٗرس دِتن نہٕ پننِس گرس فرنہٕ۔
\v 40 اوے روزیٚو توٚہؠ تیار، تکیازِ، بہٕ آدمؔ سُنٛد اولاد، یِمہٕ دُبارٕ تمہِ وزِ ییٚلہِ نہٕ توٚہہِ میٲنؠ پے لگہ۔"
\v 41 پطرسؔن پرُوژھ، "خداوندٕ، کیاہ یہِ چُھکھا ژٕ ورگہٕ پٲٹھؠ صرف اسی، چٲننن شٲگردن، یوٚت دِوان؟ یا یہِ مثال چھِ ہجومہٕ خٲطرٕ تہِ؟"
\v 42 یسوعؔن دِتسُ جواب، "بہٕ چُھس یہِ پرٛتھ أکِس سٕنٛدِ خٲطرٕ ونان یُس أکِس وفادار تہٕ گاٹل خدمتگار سٕنٛدِ پٲٹھؠ چُھ یُس پننِس مٲلکہٕ سنٛدِس گرس منٛز أکِس منتظم سٕنٛدِ پٲٹھؠ چُھ۔ تسنٛد مٲلکھ چُھ تمِس باقین خدمتگارن ہُنٛد ذمٕدار بناون، زِ تِمن گژھِ کنہِ حالس منٛز سٔہی وقتس پؠٹھ پنُن غذا واتُن۔
\v 43 ہرگاہ تٔمؠ سُنٛد مٲلکھ گرٕ آو تہٕ وچُھن زِ سُہ چُھ سۅ کٲم کران، سُہ دِیہ تمِس خدمت گارس انعام۔
\v 44 بہٕ وُنہٕ ھو توٚہہِ یہِ: سُہ مٲلکھ بنایو تمِس خدمت گارس پننہِ سٲری جایٔیدادک مختار یتھ سُہ مٲلک چُھ۔
\v 45 پوٚز ہرگاہ سُہ خدمتگار یمِس اختیار آو دِنہٕ پننِس دِلس منٛز ونہِ، میٲنس مٲلک چُھ واریہس وقتس دوٗر گژھن وول۔ پتہٕ لاگہِ سُہ باقین خدمت گارن لاینُؠ۔ بیٚیہِ لاگہِ سُہ پانہٕ سیٹھاہ کھؠن تہٕ چؠون تہٕ روزِ مسَ۔
\v 46 ہرگاہ سُہ چُھ تہِ کران، تسنٛد مٲلکھ آو واپس تمہِ وزِ ییٚلہِ نہٕ تمِس خدمت گارس روز نہٕ پے۔ پتہٕ دِیہ تٔمؠ سُنٛد مٲلکھ تمِس سخ سزا بیٚیہِ تھاونس تِمن سٟتؠ یِم تمِس وفادٲری سان خدمت چھِنہٕ کرن۔
\v 47 یمؠ خدمت گارن پننِس مٲلکہٕ سنٛزِ مرضی زٲنتھ تہِ کٔرنہٕ تیاری تہِ کرنس تمِس ییہِ سَختی سان سزا دِنہٕ۔
\v 48 پوٚز یمِس خدمتگارس یہِ معلوم اوس نہٕ زِ تسند مٲلکھ کیا چُھ یژھان تمِس کرُن، پتہٕ کوٚر تٔمؠ کینٛہہ غلط، تمِس ییہِ معمولی سزا دِنہٕ۔ تِمن خدمت گارن نِش چھِ تمِس مٲلکس واریاہ توقع یِمن تٔمؠ واریاہ بخشمُت چُھ۔ بیٚیہِ تمِس مٲلکس آسن تِمن خدمت گارن نِش تمہِ کھوٗتہٕ زیادٕ توقع یِمن تٔمؠ واریاہ ذمہٕ دٲریہِ آسن عاید کرِمٕژ۔
\v 49 بہٕ چُھس لوٗکن منٛز روحٲنی جوش برنہٕ باپتھ آمُت۔ بہٕ چُھس یژھان زِ تِم آسہ ہن برونٛٹھےٕ تمن پٮ۪ٹھ کٲم کران!
\v 50 بہٕ گژھٕ ضرور جلدےٕ خطرناک تکلیفہٕ منٛز گُزرُن۔ بہٕ روٗزٕ توٚت تام دل ملوٗل یۅتام نہٕ بہٕ پننیٚو تکلیفو منٛزٕ نیرٕ۔
\v 51 توٚہؠ پزِ زانن زِ بہٕ آس نہٕ امہِ سببہٕ زِ لوٗکھ روٗزن پانہٕ وانؠ صلاح سان یکجا۔ نا، تمہِ بدلہٕ چُھ توٚہہِ ضرور سمجھن، لوٗکھ سپدن الگ الگ صفن منٛز کھڑا، أڈؠ مےٚ خلاف تہٕ أڈؠ میٲنس حقس منٛز۔
\v 52 تیار روزیٚو، تکیازِ یہِ چُھ تہِ یہِ سپدن وول چُھ۔ پانٛژن بٲژن ہُنٛدس گرس منٛز، کینٛہہ انُن مےٚ پؠٹھ ایمان تہٕ کہنٛہہ انُن نہٕ۔ گرٕ منٛزٕ سپدن ترٛےٚ بٲژ باقین بٲژن خلاف کھڑا۔
\v 53 \f + \fr 12‏:53 \ft مِیکاایلؔ 7:6\f* گرِکین بٲژن منٛز گژھِ ٹَکراو پٲدٕ۔ اکھ مول گژھِ نیٚچوِس خلاف، یا کینٛہہ نیٚچوؠ گژھن پننٮ۪ن مالٮ۪ن خلاف۔ اکھ موج گژھِ پننہِ کورِ خلاف، یا اکھ کور گژھِ پننہِ مٲجہِ خلاف۔ اکہ ہش گژھِ نوشہِ خلاف، یا اکھ نوش گژھِ پننہِ ہشہِ خلاف۔"
\v 54 تٔمؠ ووٚن بیٚیہِ لوٗکن ہنٛدین ہجومن، "ییٚلہِ توٚہؠ مغربہ کِنؠ اکھ سیاہ اوٚبُر کھسان وُچھو، توٚہؠ چُھو ؤلؠ ؤلؠ ونان روٗد چُھ پنہٕ وول! تہٕ تی چُھ سپدان۔
\v 55 ییٚلہِ جنوبہٕ کِنؠ واو چُھ وتھان، توٚہؠ چُھو ونان، گریشمہٕ ژٔنڈ آسہ دوٚہس! توٚہؠ چُھو سہی ونان۔
\v 56 توٚہؠ ریاکار! اوٚبُر تہٕ واو وچھتھ چُھو توٚہؠ مانان زِ موسمس منٛز کیاہ چُھ سپدن وول۔ توٚہؠ پزِ معلوم سپدن زِ خدایہِ کیاہ چُھ ازؠ کِس زمانس منٛز کران!
\v 57 توٚہؠ پزِ پرٛیتھ أکِس پانے فٲصلہٕ کرن زِ پوٚز کیاہ چُھ!
\v 58 اکھ چیز پزِ توٚہہِ یتن کرن۔ توٚہہِ پزِ پننِس داوادارس سٟتؠ معاملہٕ انٛزراونچ کوٗشش کرٕنؠ ییٚلہ توٚہؠ وُنہِ عدالتس کُن وتی پکان چُھکھ۔ ہرگاہ سُہ توٚہؠ ججس برونٛہہ کُن پیش کرنس مجبور کران چُھ، سُہ جج دِیہ فٲصلہٕ زِ توٚہؠ چُھو قصوروار تہٕ توٚہؠ گژھو عدالتکس افسرس خلاف۔ پتہٕ سُہ افسر برِ توٚہؠ جیلس منٛز۔
\v 59 بہٕ چُھسے ژےٚ ونان زِ ہرگاہ ژٕ جیلس منٛز برَنہٕ آکھ، ژٕ نیرکھ نہٕ زانٛہہ توٚت تام تتہِ نیٚبر یوٚت تام نہٕ ژٕ سۅ رژھ رژھ ادا کرکھ یہِ سُہ جج حکم دِیہ۔"
\c 13
\p
\v 1 تمہِ وقتہٕ، ووٚن یسوعسؔ ہجومس منٛز موجود کینٛژو نفرو تتھ متعلق یہِ حال حالے کینٛژن گلیلہٕ کین روزن والیٚن سپدمُت اوس۔ رومکؠؔ گورنر، پیلاطسؔ اوس سِپہن حکم کوٚرمُت زِ گلیلٕکؠ لوٗکھ گژھن تمہِ وزِ قتل کرنہٕ یِنؠ ییٚلہِ تِم یروشلم کِس ہیکلس منٛز آسن قربٲنی پیش کران۔
\v 2 یسوعؔن دیُت تِمن جواب، "کیاہ توٚہؠ چُھوا سونچان زِ یہِ سپد گلیل کیٚن تِمن لوٗکن سٟتؠ یِم گلیل کیٚو باقیو لوکو کھۅتہٕ زیادٕ گناہ گار ٲسؠ؟
\v 3 بہٕ چُھسو توٚہہِ یقین دِوان زِ سُہ اوس نہٕ تمیٚک وجہ! تمہِ بدلہٕ دِیہ خدایہِ توٚہہِ سارِنےٕ یتھے پٲٹھؠ سزا ہرگاہ توٚہؠ پانہٕ گناہ کرنہٕ نِشہ توبہٕ کٔرِو۔
\v 4 یا تِمن ارداہ 18 نفرن مطلق کیاہ چُھ یِم شیلوخس منٛز بُرُجِ پؠٹھٕ پؠنہٕ سٟتؠ مارٕ سپدؠ؟ توٚہؠ چُھوا سونچان زِ یہِ سپد تِمن تکیازِ تِم ٲسؠ باقیو یروشلمس منٛز روٗزن والیٚن ہُنٛدِ کھۅتہٕ زیادٕ گناہ گار؟
\v 5 بہٕ چُھس توٚہہِ یقین دِوان، زِ سُہ اوس نہٕ وجہ! پوٚز چُھ تمہِ بدلہٕ یہِ، توٚہہِ چُھ احساسُک ضرورت زِ خدایہِ دِیہ توٚہہِ سارنےٕ یتھے پٲٹھؠ سزا ہرگاہ توٚہؠ گناہ کرنہٕ نِشہ لوٗب روزیٚو نہٕ!"
\v 6 \f + \fr 13‏:6 \ft متی 21:18، مرقُس 11:12۔ 14\f* پتہٕ ؤنؠ یسوعؔن تِمن یہِ دلیل" اکؠ نفرن دِیتُ پننِس باغس منٛز اکھ انجیر کلُ۔ پرٛیتھ ورؠیہِ آو سُہ تتھ انجیر تلُنہِ، مگر تتھ اوس نہٕ کانٛہہ آسان۔
\v 7 پتہٕ ووٚن تٔمؠ باغوانس، یتھ کُلس کنُ وُچھ! بہٕ روٗدُس اتھ ترٛیو ورؠیو پؠٹھٕ پرٛیتھ ورؠیہِ میٚوٕ ژھانڈان، مگر اتھ درٛاو نہٕ کانٛہہ انجیر۔ یہِ ژٕھنن ژٹتھ۔ یہٕ چُھ صرف میٚژِ منٛز غذائی اجزا کُنہٕ چیزٕ خٲطرٕ استعمال کران۔
\v 8 پوٚز تٔمؠ باغوانن دِیتُ جواب، "جناب، ترٛاون دویمِس ورؠ یس پؠٹھ۔ بہٕ کرٕ اتھ گُڈٲے بیٚیہِ تراوس پاہ۔
\v 9 ہرگاہ اتھ دوٗیمہِ ورؠیہِ انجیر درایہِ، أسؠ تھاوٕہن! پوٚز یہِ دِیہ نہٕ کانٛہہ میٚوٕ تیلہِ ہیٚکہ ہن ژٕ یہِ ژٔٹتھ۔"
\v 10 أکِس یہُودؠ سبت دوٚہس پؠٹھ اوس یسوعؔ ہیکلس منٛز لوٗکن تعلیم دِوان۔
\v 11 تتہِ ٲس اکھ زنان یمِس اردہو ورؠیو پؠٹھٕ بدروحن معذور کٔرمٕژ ٲس۔ تسَ اوس کوٚب دراومُت۔ سۅ ٲس نہٕ ہیکان سؠود کھڑا روٗزتھ۔
\v 12 ییٚلہِ یسوعؔن سۅ وُچھِ، تٔمؠ أنؠ سۅ پانس نِش ناد دِتھ۔ تٔمؠ ووٚن تسَ، "خاتونی، ژےٚ سُپدۓ امہِ بٮ۪مارِ نِشہ شفا!"
\v 13 تٔمؠ تٔھوؠ تسَ پؠٹھ پنُن اتھٕ۔ سۅ ؤژھ ؤلؠ ؤلؠ تھوٗد گییہِ اِستادٕ تہٕ لٔجؠ خدایہِ سنٛدؠ تعریف کرنہِ!
\v 14 \f + \fr 13‏:14 \ft خروج 20:9۔ 10، تثنِیہ شرع 5:13۔ 14\f* مگر ہیکلکس سردارس کٔھژ شرارت تکیازِ یسوعؔن اوس تسَ یہُودؠ سبتکہٕ دوٚہہ شفا بخشمُت۔ لہٰذا تٔمؠ ووٚن لوٗکن، "پرٛیتھ ہفتس منٛز چُھ اسہِ پنُن شریعت شین دوٚہُن کٲم کرنُک اجازت دِوان۔ ہرگاہ توٚہہِ شفا آسہ ضرورت، تِمن دوٚہُن منٛز واتیو ہیکلس منٛز کٲنسہِ أکِس نِشہ شفا حٲصٕل کرنہٕ باپتھ۔ سبتکہٕ دوٚہہ مہَ واتیو!"
\v 15 پتہٕ ووٚن یسوعؔن تمِس، "ژٕ تہٕ چٲنؠ مذہبی سردار چُھو ریاکار! توٚہہِ منٛز چُھ پرٛتھ اکھ سبتکہِ دوٚہہ کانٛہہ کٲم کران! مثلن، توٚہؠ چُھو پنُن دانٛد یا خر ٹِکلہِ منٛز ییٚلہِ تراوان پتہٕ نِوان تتھ جایہِ ییٚتہِ سُہ ترٛیش ہیٚکہ چیٚتھ۔
\v 16 یہِ زنان چھِ اکھ یہُودؠ، ابرہامؔ سنٛز کور! \f + \fr 13‏:16 \ft ابراہامؔ سنٛز کور چھِ ابراہامؔ سٕنٛدِ زریت منٛز، مثالہِ پٲٹھؠ خدایہِ سٕنٛدیو لوٗکو منٛزٕ اکھ بٲژ۔ \f*پوٚز شیطانن ٲس یہِ اردہن ؤرین معذور کٔریتھ تھٲومٕژ، زن تہِ گنڈتھ آسٕنؠ تھٲومٕژ! ژٕ مانکھ یقیٖنن زِ یہِ چُھ ٹھیک زِ مےٚ کٔر سۅ امہِ ناکارٕ بٮ۪مارِ نِشہ آزاد، ہرگاہ بہٕ یہِ سبتکہِ دوٚہہ تہِ کرٕ!"
\v 17 یمہٕ کتھٕ وننہٕ پتہٕ تٔمؠ سنٛدؠ مُخٲلف ٲسؠ پانے شرمنٛدٕ سپدان۔ مگر باقی لوٗکھ ٲسؠ تٔمؠ سنٛزن شاندار کامؠنؠ پؠٹھ خوش سپدان یِم زن تٔمؠ سنٛدؠ دٔسؠ سپدان آسہ۔
\v 18 پتہٕ ووٚن تٔمؠ، "بہٕ چُھس یژھان وضاحت کرٕنؠ زِ خدایی بادشٲہی کٔتھٕ پٲٹھؠ چھِ آسان۔ بہٕ دِمہٕ توٚہہِ اکھ نقشہٕ یُس زن توٚہہِ سمجھنس منٛز مدد کرِ۔
\v 19 یہِ چُھ  تِلہٕ گۅگل بیول ہیٚو آسان یُس زن اکؠ نفرن پننِس کھہَس منٛز دروٗنٛٹھ۔ سُہ کھوٚت یوٚت تام سُہ بوٗڈ گوٚو، بنیو اکھ کُل۔ یہِ گوٚو تیوٚت بوٗڈ زِ جاناوارو ییرؠ پنٕنؠ ٲلؠ امہِ چؠن لنجن پؠٹھ۔"
\v 20 پتہٕ ووٚن تٔمؠ دُبارٕ، "بہٕ وننہٕ توٚہہِ بیٚیہِ اکہ طریقہٕ زِ خدٲیی بادشٲہی کٔتھٕ پٲٹھؠ چھِ آسان۔
\v 21 یہِ چھِ خٔمیٖرِ ہنٛزِ اکہ رٔژھِ ہُنٛدؠ پٲٹھؠ آسان یۅسہ اکھ زنان پنژٕ کلو ٲٹسِ سٟتؠ رَلاؤتھ سُہ سورےٕ خٔمیٖرے بنیو۔"
\v 22 یسوعؔن تھوو یروشلمسؔ کنُ سفر جٲری۔ سُہ ٹھہروو تِمن تمام شہرن تہٕ گامن منٛز یِم وُتہِ منٛز یوان ٲسؠ تہٕ دِژن لوٗکن تعلیم۔
\v 23 کٔمؠ تام پرُوژھ تسِ، "خداوندٕ، کیاہ خدا دِیا کینٛژن لوٗکن نجات؟" یسوعؔن دِتس جواب تاکہِ تتہِ ہؠکہِ ہر کانٛہہ بوزِتھ،
\v 24 "توٚہہِ چھےٚ تنگ دروازٕ کِنی اژنہٕ خٲطرٕ سخت محنت کرنٕچؠ ضروٗرت، تکیازِ یہِ چُھ سیٹھاہ مشٕکل۔ بہٕ وُنہٕ توٚہہِ زِ واریاہ لوٗکھ کرن اژنٕچ کوٗشش، مگر تِم ہؠکن نہٕ دٲخل گژھتھ۔
\v 25 ییٚلہِ گرٕک مٲلکھ ووٚتھ تہٕ کوٚرن دروازٕ بنٛد، ژٕ روٗزک نیٚبر پتہٕ کرکھ دروازس ٹُھک ٹھُک۔ ژٕ کرکھ مٲلکس زارٕپارٕ تہٕ وُننہِ ہس، خداوند، سانہِ خٲطرٕ مٔژاو دروازٕ! پوٚز سُہ دِیہ جواب، "ناہ، بہٕ مُژراونہ، تکیازِ بہٕ زانٛتھ نہٕ ژٕ، بیٚیہِ چُھنہٕ مےٚ معلوم زِ ژےٚ کٔتکُ چُھکھ!
\v 26 پتہٕ ووٚننکھ ژٕ، ژےٚ ٲسی تہِ ضرور مٔشد گوٚومُت، اسہِ کھیو کھؠن ژےٚ سٟتؠ، تہٕ ژےٚ پرنٲیِتھ أسؠ سانؠن شہرکؠن کوچن منٛز!
\v 27 \f + \fr 13‏:27 \ft زبُور 6:8\f*پوٚز سُہ وُنؠ ژےٚ، بہٕ چُھسے ژےٚ دُبارٕ ونن، مےٚ چھِنہٕ خبر ژٕ کٔتکُ چُھکھ۔ توٚہؠ سٲری چُھو بدکار لوٗکھ! ییٚتہِ گژھِ دفاہ!"
\v 28 پتہٕ روٗد یسوعؔ ونان، "ژٕ وُچھہَن دورے ابرہامؔ، اضحاقؔ بیٚیہِ یعقوبؔ، سٲری نبی یِم سیٹھاہ برونٛٹھ زندٕ ٲسؠ، خدٲیی بادشٲہی منٛز روٗزان۔ پوٚز ژٕ آسکھ نیٚبرٕ کٔنہِ ودان بیٚیہِ افسوس کران!
\v 29 \f + \fr 13‏:29 \ft یسعیاہؔ 66:18، کشف 7:9، زبُور 107:3، ملاکی 1:11\f* پوٚز تتہِ آسن دنیاہکہِ پرٛیتھ کُنہِ جایہِ ہُنٛدؠ لوٗکھ، یِمن منٛز غیٖر یہُودؠ لوٗکھ تہِ شٲمل آسن۔ تِم سٲری آسن یکجا خدٲیی بادشٲہی منٛز جشن مناوان۔
\v 30 یتھ متعلق سونٛچو: کینٛہہ لوٗکھ یِم از کم ترین باسن چھِ پتہٕ آسن سیٹھاہ اہم، تہٕ باقیو کینٛہہ یِم از اہم باسان چھِ پتہٕ آسن کم تر۔"
\v 31 تمی دوٚہہ آیہِ کینٛہہ فریسی تہٕ ووٚننکھ یسوعؔ ہس، "ییٚتہِ نیر، تکیازِ حٲکم ہیرودیسؔ چُھےٚ یژھان ژےٚ قتل کرُن!"
\v 32 تٔمؠ دیتُ تِمن جواب، "گژھو تہٕ ؤنو تمِس مکار نفرس، یُس سونچان چُھ زِ مےٚ ہیٚکہ زَرر واتنووُتھ پوٚز سُہ ہیٚکہ نہٕ تہِ کٔریتھ، تسَ واتنٲیو یہِ میٲنؠ شیٚچھؠ: بوٗزو! وُنہِ کؠن چُھس بہٕ بدروح نیٚبر کڈان بیٚیہِ معجزٕ ہاوان، بہٕ روٗزٕ یہِ کران کٔمےٕ وقتس۔ تمہِ پتہٕ، واتہِ میٲنؠ کٲم انٛد۔
\v 33 پوٚز مےٚ چُھ بیٚیہِ ینہِ والیٚن دوٚہُن دوٗران پنُن سفر یروشلمسؔ کنُ جٲری تھاون ضروری یہُودؠ سردارو چھِ تنہِ پؠٹھٕ ہمیشہِ یہِ کران آمٕتؠ یہِ چُھنہٕ موزوٗن زِ اکھ رسول ییہِ یروشلمہٕؔ وراۓ بیٚیہِ کُنہِ جایہِ قتل کرنہٕ۔
\v 34 ہے، یروشلمسؔ منٛز بسن والیو لوٗکو! توٚہہِ کروٕ تِم نبی قتل یِم واریاہ برونٛہہ زندٕ ٲسؠ۔ پتہٕ کروٕ توٚہہِ تِم قتل یِم خداین تُہنٛدِ خٲطرٕ سوٗزمٕتؠ ٲسؠ۔ توٚہہِ کروٕ تِم سنگ سار۔ مےٚ یژھوو کٲتیاہ لٹہِ زِ بہٕ کرہو توٚہؠ یکجا سپدتھ حفاظت، یتھٕ پٲٹھؠ اکھ کۅکرٕ پننؠن پوٗتؠن پکھن تل یکجا حفاظت چھِ کران۔ پوٚز توٚہہِ یژُھو نہٕ تہِ یہِ بہٕ کرہا۔
\v 35 وۅنؠ وچھِو! خدایہ بچاوِ نہٕ وۅنؠ توٚہہِ یروشلم کیٚن لوٗکن۔ بہٕ ووٚن ہو توٚہہِ بیٚیہِ یتہِ: بہٕ اژٕ تُہنٛدس شہرس منٛز صرف اکہ لٹہِ۔ توٚہؠ وچھو نہٕ مےٚ تمہِ پتہٕ توٚت تام یوٚت تام بہٕ واپس یمہٕ، پتہٕ ووٚنوِ توٚہؠ مےٚ متعلق، مبارک چُھ أمِس انسانس یُس خدایہِ سٕنٛدِ حکمہٕ سٟتؠ یوان چُھ!"
\c 14
\p
\v 1 أکِس سبتٕکس دوٚہس پٮ۪ٹھ، یسوعؔ گوٚو أکِس فریسی سردار سنٛدِس گرس منٛز ژوٹ کھٕنہِ۔ أمؠ سردارن ٲس باقین فریسین تہِ اتھ منٛز دعوت دِژٕمژ۔ تِم سٲری ٲسؠ یسوعؔ ہس ہشیاری سان وچھان زِ أمِس نیرن نوقص تہٕ دِنس الزام۔
\v 2 یسوعؔ ہس برونٛہہ کنہِ دٔچھنہِ طرفہٕ اوس اکھ نفر یمِس اکہ بٮ۪مارِ سٟتؠ نَرِ تہٕ زنٛگہٕ سیٹھاہ زیادٕ ہُنیومٕژٕ آسہ۔
\v 3 یسوعؔن پرُوژھ تتہِ موجود یہُودؠ شریعت کین عٲلمن بیٚیہِ فریسین، "سبتکٕہِ دوٚہہ لوٗکن شفا دیُن چھا شرع مطابق جٲیز کنہِ نہٕ؟"
\v 4 تِمو دِیت نہٕ جواب۔ أتی تھوٚو یسوعؔن پنُن اتھٕ تمِس نفرس پؠٹھ تہٕ سپدس شفا۔ پتہٕ کوٚرن تسَ رخصت۔
\v 5 تٔمؠ ووٚن تتہِ باقین، "ہرگاہ توٚہہِ اوس اکھ نیٚچو یا اکھ دانٛد سُہ گوو أکِس سٔنِس کھۅڈس منٛز سبات کہِ دوٚہہ، توٚہہِ کھالِہنُ سُہ فورن۔"
\v 6 تِمو ہیوٗک تمِس نہٕ اتھ تہِ جواب دِتھ۔
\v 7 یسوعؔ ہس توٚر فِکرِ زِ یِمن لوٗکن سالس پؠٹھ دعوت دِنہٕ آمٕژ ٲس تِم ٲسؠ تھَزرس بِہنُ پسنٛد کران۔ لہٰذا تٔمؠ دِژ تِمن یہِ نصیحت۔
\v 8 "ییٚلہِ توٚہہِ منٛزٕ کٲنٛسہِ أکِس کانٛہہ خانٛدرس پؠٹھ سالس ینٕچ دعوت دِیہ، یتھنہٕ تتھ جایہِ بِہیو یتؠن لٲزم دار لوٗکھ بہن۔ ممکن چُھ تٔمؠ آسہ تمِس نفرس سالس پؠٹھ دعوت دِژمٕژ یُس تُہنٛدِ کھوٗتہٕ زیادٕ یزتھ دار آسہ۔
\v 9 سُہ یزمان ییٚلہِ پتہٕ وچھِ زِ توٚہہِ دوشوےٕ کتہِ چُھو بہتھ، سُہ ونی ژےٚ، "یمِس نفرس تراو تہٕ یتؠن جاے! شرمنٛدٕ گژھتھ پییی ژےٚ بوٗن وسنُ۔
\v 10 \f + \fr 14‏:10 \ft امثال 25:6۔ 7\f*اتھ برعکس، ییٚلہِ کانٛہہ اکھ ژےٚ سالس پؠٹھ دعوت دِیہ، گژھ تہٕ بہہ سارنےٕ بوٚنہٕ کنہِ۔ پتہٕ ییٚلہِ میزبان ییہِ سُہ ؤنی، "دوستا یتھ رٕژِ جایہِ بہہ!" پتہٕ سپدِ سارنےٕ سالرن منٛز ژےٚ یزتھ۔
\v 11 خدایہِ والہ تس بوٚن یُس پانس تھوٚد زانہِ، تہِ یُس پانس لۅکُٹ زانہِ تس دِکھ تھزر۔"
\v 12 یسوعؔن ووٚن تمِس فریسیسؔ بیٚیہِ، یمؠ تمِس سال کوٚرمُت اوس، "ییٚلہ ژےٚ دوپہرکس یا شامہٕ کِس کالس پؠٹھ سالٕچ دعوت دِکھ، دوستن، رشتہٕ دارن یا ہمسایہ امیرن یوت نہٕ، یِم ژےٚ سال کٔرِتھ نکھٕ ووٚتھ کرنےٕ۔
\v 13 امہِ بدلہٕ، دِیہ زِ غریٖب، معذور، لنگؠن یا آما لوٗکن دعوت ییٚلہِ ژےٚ سال کرکھ۔
\v 14 ہرگاہ ژٕ تہِ کرکھ، خدایہِ دِیہ ژےٚ انعامہٕ، تکیازِ تِمن نِش چُھنہٕ کہنؠ زِ نکھٕ والنےٕ۔ ژےٚ گژھی یقین آسن زِ خدایہِ دِیہ ژےٚ واپس تمہِ وزِ ییٚلہ سُہ نیک لوٗکن دُبارٕ زندگی عطا کرِ۔
\v 15 سالرو منٛزٕ اکؠ سالر بوز تٔمؠ سنٛز کتھ۔ تٔمؠ ووٚن یسوعؔ ہس، "بختہٕ بوٚڈ چُھ سُہ یمِس خدٲیی بادشٲہی منٛز أژتھ جشن مناونُک موقعہ ییہِ!"
\v 16 یسوعؔن ووٚن تمِس، "اکہ وقتہٕ نیٚو اکؠ شخصن اکھ بوٗڈ سال تیار کرنُک فٲصلہٕ۔ تٔمؠ دِژ واریہن لوٗکن دعوت۔
\v 17 سالہٕ وزِ سوز تٔمؠ پنُن غلام تِمن نِش یہِ ووٚننہٕ باپتھ، ولہٕ وُنؠ سورےٕ کینٛہہ چُھ تیار!
\v 18 پوٚز ییٚلہِ تٔمؠ خدمت گارن تہِ کوٚر، تِمو ساروےٕ لوٗکو یِمن تٔمؠ دعوت دِژمٕژ ٲس، لوٗگ ووٚننہِ زِ تِم کیازِ ہیکن نہٕ یتھ۔ خدمت گار یمِس گوٗڈنتھ گوٚو تٔمؠ ووٚن، "مےٚ چُھ وُنؠ اکھ کھاہ مٔلؠ ہیٚوتمُت، مےٚ چُھ ضرور تتھ نظر دِنہِ گژھن۔ مہربٲنی کٔریتھ پننِس مٲلکس ووٚن زِ مےٚ دِیہ نہٕ ینہٕ خٲطرٕ معٲفی!"
\v 19 دوٚیم شخصن ووٚن، "مےٚ چھِ وُنؠ پانٛژھ جورِ دانٛد مٔلؠ ہیتؠ مٕتؠ، تہٕ مےٚ چُھ تِم مُرِ کڈنؠ گژھن۔ مہربٲنی کریتھ پننِس مٲلکس ووٚن مےٚ دِیہ نہٕ یِنس پؠٹھ معٲفی!
\v 20 بیٚیہِ اکؠ نفرن ووٚن، "مےٚ چُھ وُنؠ خاندر کوٚرمُت، لہٰذا بہٕ ہیٚکہٕ نہٕ یِتھؠ۔"
\v 21 لہٰذا آو سُہ خدمت گار پننِس مٲلکس نِش واپس تہٕ ووٚننس تہِ یہِ پرٛیتھ اکؠ تمِس ووٚنمُت اوس۔ گرٕکس خاندارس کٔھژ سخ ژکھ پتہٕ ونن پننِس خدمت گارس، "ؤلؠ ؤلؠ گژھِ شہرِ چؠن گلؠ ین تہٕ کوچؠن منٛز تہٕ أنِکھ غریٖب، معذور، آما تہٕ لٔنگؠ لوٗکھ میٲنس گرس منٛز!"
\v 22 پتہٕ گوٚو سُہ خدمت گار نیٚبر تہٕ کوٚرن تی پتہٕ واپس یتھ ووٚننس، "جناب، مےٚ کوٚر تہِ یہِ ژےٚ ووٚنتھ مگر ییٚتہِ چھِ وُنہِ تہِ واریہن لوٗکن ہنٛدِ خٲطرٕ جاے۔
\v 23 لہٰذا ونُس پنٕنؠ مٲلکن، "شہرٕ نیٚبر گژھِ۔ لوٗکھ ژھانڈکھ بجن وتن پؠٹھ، تنگ وتن پؠٹھ۔ تِم لوٗکھ انُکھ مجبور کٔرِتھ میٲنس گرس منٛز۔ بہٕ چُھس یژھان یہِ گژھِ لوکو سٟتؠ بٔرِتھ یُن!
\v 24 تمہِ علاوٕ ونےَ بہٕ ژےٚ اکھ کتھ زِ تِمن نفرن یِمن مےٚ گۅڈٕ دعوت دِژ تِم گژھن نہٕ میانہِ سالک مَزٕ تُلٕنؠ تکیازِ تِمو کوٚر سالس یِنس اِنکار۔"
\v 25 یسوعؔ ہس سٟتؠ اوس لوٗکن ہُنٛد اکھ بوٚڈ ہجوم سفر کران۔ سُہ پھیٚور لوٗکن کُن تہٕ تِمن ونُن،
\v 26 \f + \fr 14‏:26 \ft متی 10:37، یوحناؔ 12:25، تثنِیہ شرع 33:9\f* "ہرگاہ کانٛہہ مےٚ نِش ییہِ یُس پننِس مٲلس، ماجہِ، آشنہِ، شُرین، باین، بیٚنین میانہِ کھۅتہٕ زیادٕ لول آسہ بران، سُہ ہیٚکہٕ نہٕ میون شٲگرد ٲسِتھ۔ سُہ گژھِ ضرور پننہِ زندگی ہنٛدِ کھۅتہٕ زیادٕ مےٚ لول برُن!
\v 27 یُس اکھ نہٕ پننِس صلیبس پانہٕ تُلِتھ ہیٚکہ بیٚیہِ کرِ نہٕ میٲنؠ تٲبیادٲری، سُہ ہیٚکہِ نہٕ میٚون شٲگرد ٲسِتھ۔
\v 28 بہرحال، ہرگاہ توٚہہ منٛزٕ کٲنٛسہِ اکؠ یوٚژھ اکھ بُرُج تعمیٖر کرُن، توٚہؠ بِہیو تہٕ کریو فٲصلہٕ زِ اتھ کٲژا لاگتھ لگہ۔ تمہِ سٟتؠ لگہ توٚہہ پتاہ زِ توٚہہ نِش چھا تیوتاہ پونٛسہٕ یمہٕ سٟتؠ یہِ انٛد واتہِ، کِنہٕ نہٕ۔
\v 29 نتہٕ، ہرگاہ توٚہہ کٕن دِتوٕ پتہٕ اوسو نہٕ سُہ بُرج انٛد واتناونُک طاقت، یُس کانٛہہ تہِ پتہٕ وُچھِ سُہ ژٹہِ توٚہہ ٹٲنہٕ۔
\v 30 تِم ونن، "أمؠ شخصن لاجاو اکھ بُرج تعمیٖر کرُن، پوٚز سُہ اوس نہٕ ژکہِ اتھ ختم کرنس قٲبل!
\v 31 یا مثلن أکِس بادشاہس اوس دہن ساسن سِپہن پؠٹھ مشتمل پنُن فوج۔ بیاکھ بادشاہ اوس وُہہ ساس سِپاہ ہیٚتھ تمِس پؠٹھ حملہٕ کرنہِ پکان۔ پنُن فوج جنگس منٛز سوزنہٕ برونٛہہ کرِ سُہ گۅڈنیُک بادشاہ یقیناً پننٮ۪ن مشیرن سٟتؠ مشورٕ زِ سُہ ہیٚکیا بییٚس بادشاہ سنٛدِس فوجس شِکس دِتھ کِنہٕ نَہ۔
\v 32 مثلن تٔمؠ نیٚو فٲصلہ زِ تٔمؠ سُنٛد فوج ہیٚکہ نہٕ بییٚس فوجس شکس دِتھ۔ پتہٕ سوزِ سُہ بیٚیس بادشاہس نِش پنٕنؠ شیٚچھِ وٲلؠ، ییٚلہِ تمِس پنُن فوج وُنہِ سیٹھاہ دوٗر آسہ۔ سُہ ونہِ تِمن شیٚچھِ والیٚن تمِس پرِژھو، "ژےٚ سٟتؠ صلح کرنہٕ خٲطرٕ کیاہ چُھ مےٚ ضروری کرُن؟"
\v 33 لہٰذا، یتھے پٲٹھؠ، ہرگاہ توٚہہ منٛزٕ کانٛہہ اکھ یُس گۅڈٕ فٲصلہٕ ہیٚکہ نہٕ کٔرِتھ زِ سُہ چُھ یژھان تہِ سورےٕ کینٛہہ تراوُن یہِ تمِس آسہ، سُہ ہیٚکہ نہٕ میٚون شٲگرد ٲسِتھ۔"
\v 34 یسوعؔن ووٚن بیٚیہِ، "توٚہؠ چُھو نوٗنکؠ پٲٹھؠ یُس سیٹھاہ فٲیدٕمنٛد چُھ۔ پوٚز ہرگاہ نوٗنس راوِ پنُن نوٗنہٕ مَزٕ، کانٛہہ اکھ ہیٚکہ نہٕ اتھ زانٛہہ تہِ دُبارٕ مزٕدار نوٗن بنٲوِتھ۔
\v 35 ییٚلہِ نہٕ نوٗنس وُنؠ نوٗنہٕ مزٕ روزِ، سُہ نَہ چُھ وُنؠ زمیٖنہِ خٲطرٕ رُت تہٕ نَہ پاہ بننہٕ خٲطرٕ۔ لوٗکھ چھِ اتھ نیٚبر دٲرتھ دِوان۔ توٚہہ پزِ ہوشیٲری سان اتھ پؠٹھ سونٛچن یمہٕ مےٚ وُنؠ کتھٕ ونہِ تہٕ توٚہہ بوزو!"
\c 15
\p
\v 1 وُنؠ، ٲسؠ واریاہ گُذروان بیٚیہِ باقیو لوٗکھ یسوعؔ ہس نِش تعلیم بوٗزنہٕ خٲطرٕ یوان، یِمن مذہبی سردار گناہگار مانان ٲسؠ۔
\v 2 ییٚلہِ فریسیو تہٕ یہُودؠ شریعتکیو عٲلمو یہِ وُچھ، تِمو لوٗگ شور کرُن۔ تِمو ووٚن، "یہِ شخص چُھ گناہگارن خوش آوے کران بیٚیہِ چُھ تِمن سٟتؠ کھیوان چؠوان۔ "تِمو سونچؠ زِ یسوعؔ اوس تہِ کرنہٕ سٟتؠ پنُن پان گندٕ کران۔
\v 3 لہٰذا ووٚن یسوعؔن تِمن یہِ ورگہٕ پٲٹھؠ:
\v 4 \f + \fr 15‏:4 \ft عذرا 34:11۔ 12، 16\f* توٚہؠ منٛزٕ ٲسؠ أکِس نفرس ہَتھ تیٖرؠ تہٕ تِمو منٛزٕ راؤ اکھ۔ ژےٚ تراوِتھ نمنمَتھ 99 تیٖرؠ وجارس منٛز تہٕ دراکھ سُہ رووٕمُت تیوٗر ژھارنہِ توٚت تام یوٚت تام نہٕ سُہ لُوٗبتھ۔
\v 5 ییٚلہِ ژےٚ سُہ لُوٗبتھ، ژےٚ تُلتھ خوشی سان سُہ نکھس پؠٹھ تہٕ دراکھ گرٕ کُن۔
\v 6 گرٕ وٲتِتھ کرکھ پننؠن دوستن تہٕ ہمساین آلو تہٕ تِمن ووٚننکھ، "مےٚ سٟتؠ منٲوِو شٲدؠ یانہٕ، تکیازِ مےٚ لوٗب سُہ تیوٗر یُس مےٚ رووٕمُت اوس!"
\v 7 یتھے پٲٹھؠ پزِ توٚہؠ تہِ زاننُ زِ آسمانس پؠٹھ تہِ چھِ شٲدؠ یوان مناونہٕ ییٚلہِ اکھ گناہگار چُھ پننؠن گناہو نِشہ توبہٕ کران۔ سۅ شٲدؠ چھِ تِمن لوٗکن ہنٛدِ کھۅتہٕ زیادٕ آسان یِم برٛونٹھے خدایس نِشہ نیک آسن چھِ تہٕ تِمن چُھ نہٕ آسن توبہٕ کرنچؠ ضرورت۔
\v 8 یا مثالے زِ أکِس زنانہِ ٲسؠ چاندِ ہنٛدؠ دہ قٕمتی سِکہٕ مگر تِمو منٛزٕ راوُس اکھ۔ یقیٖنن سۅ زالہِ اکھ ژونگ تہٕ فرَشش دِیہ ڈُوُن توٚت تام ژھارِ دیٛانہٕ سان یوٚت تام نہٕ سۅ لبس۔
\v 9 ییٚلہِ تمہِ سُہ لوٗب، سۅ لایہِ پننؠن وؠسن تہٕ ہمساین ناد پتہٕ ونی تِمن، "مےٚ سٟتؠ منٲوِو شٲدؠ یانہٕ، تکیازِ مےٚ لوٗب سُہ رووٕمُت سِکہٕ!"
\v 10 بہٕ چُھس توٚہہ تیٖ ونان زِ یتھے پٲٹھؠ چھِ خدایہِ سنٛدین فرشتن منٛز شٲدؠ یانہٕ آسان ییٚلہِ اکھ گناہگار پننیٚو گناہو نِشہ توبہٕ چُھ کران۔"
\v 11 پتہٕ روٗد یسوعؔ ونان، "أکِس شخصس ٲسؠ زِ نیٚچوؠ۔
\v 12 لۅکٕٹؠ نیٚچو ووٚن اکہ دوٚہہ پننِس مٲلس، مولا، مےٚ دِ وُنؠ پنٕنؠ جایدادٕ منٛز پنُن حصہ یُس مےٚ چٲنہِ مرنہٕ پتہٕ واتہِ۔ لہٰذا تٔمؠ مٲلؠ کوٚر تقسیم پنُن جایٔیداد پننؠن دوٚشونی نیٚچوٮ۪ن منٛز۔
\v 13 \f + \fr 15‏:13 \ft امثال 29:3\f*کینٛہہ دوٚہہ پتہٕ، تٔمؠ لۅکٕٹؠ نیٚچوؠ کوٚر سُہ حصہ آمُت سورےٕ جایٔیداد جمع تہٕ دراو سفرس أکِس دوٗر دراز ملکس کنُ۔ تتھ ملکس منٛز کوٚر تٔمؠ پنُن سورےٕ پونٛسہٕ پننہِ بیقلٲزی تہٕ بدکٲری سٟتؠ زایہِ۔
\v 14 ییٚلہِ تٔمؠ پنُن سورےٕ پونٛسہٕ اوس خرچ کوٚرمُت، تتھ سٲرسےٕ ملکس منٛز ووٚتھ اکھ شدید دراگ۔ جلد سپد سُہ محتاج۔
\v 15 لہٰذا گوٚو سُہ تمہِ ملکہٕ کس أکِس روزن وٲلِس نفرس نِش تہٕ تس ووٚنُن مےٚ رٹھ تہٕ طَلبس۔ تٔمؠ نفرن سوز سُہ پننؠن کھہَن منٛز سور رچھنہِ۔
\v 16 تمِس لجؠ تیٖژ بۅچھِ زِ سُہ کھییٚہ ہےٕ ہِمہٕ پھل یُس سور کھیوان ٲسؠ، پوٚز سُہ تہِ دِتسُ نہٕ کٲنسے۔
\v 17 ٲخٕرس پؠٹھ لوٗگ تٔمؠ پننہِ بیقلٲزی متعلق ہوشہِ سان سونٛچن، تہٕ پانس کنُ ووٚنُن: میٲنس مٲلس نِشہ چھِ سٲری مُزور یڈ بٔرِتھ غذا کھیوان، پوٚز بہٕ چُھس ییٚتہِ بۅچھِ سٟتؠ مَران!
\v 18 \f + \fr 15‏:18 \ft زبُور 51:4\f* لہٰذا بہٕ نیرٕ ییٚتہِ تہٕ گژھٕ پننِس مٲلس نِشہ واپس۔ بہٕ ونہٕ تسَ، "ببہٕ، مےٚ چھِ خدایس تہٕ ژےٚ برونٛہہ کنہِ گناہ کرِمٕتؠ۔
\v 19 بہٕ چُھس نہٕ اتھ لایق زِ ژےٚ مانکھ مےٚ وُنہِ تہِ پنُن نیٚچو۔ مہربٲنی کٔریتھ مےٚ دِتہٕ پننؠن مُزورن منٛز أکِس مُزور سٕنٛدؠ پٲٹھؠ پانس نِشہ کٲم کرنہٕ۔"
\v 20 سُہ ووٚتھ تہٕ لوٗگن پننِس مٲلس سٕنٛدِس گرس کنُ واپس سفر کرُن۔ پوٚز ییٚلہِ سُہ وُنہِ مٲلؠ سٕنٛدِس گرس سیٹھاہ دوٗرِ اوس، تمسنٛدؠ مٲلؠ وُچھ سُہ تہٕ تسَ آو تٔمؠ سُنٛد بڈٕ عار۔ سُہ لاریوو پننِس نیٚچوِس کنُ تہٕ روٚٹُن نالہٕ مَتہِ بیٚیہِ کوٚرنس میوٗٹھ۔
\v 21 نیٚچوؠ ووٚن تسَ، "ببہٕ، مےٚ چھِ خدایس بیٚیہِ ژےٚ برونٛہہ کنہِ گناہ کرِمٕتؠ۔ لہٰذا بہٕ چُھس نہٕ اتھ لایق زِ ژٕ مانکھ مےٚ بیٚیہِ تہِ پنُن نیٚچو۔
\v 22 پوٚز تمسنٛدؠ مٲلؠ ووٚن پننؠن خدمت گارن، "ؤلؠ ؤلؠ گٔژھوِ تہٕ میٚون ساروےٕ کھۅتہٕ رُت جامہٕ أنیٚو تہٕ لٲگوِ میٲنس نیٚچوِس۔ بیٚیہِ لٲگیوٗس اوٚنگجہِ میٲنؠ وٲج تہٕ کھۅرن میٚون کھۅربانہٕ۔
\v 23 بیٚیہِ أنؠ وون سُہ وُژھ یُس اسہِ اکہ خاص موقعہ خٲطرٕ فِلہٕ کوٚرمُت چُھ تہٕ کرِیوٗس خشَ، یُس أسؠ کھؠمو ہنُ تہٕ شٲدؠ یانہٕ کرَو!
\v 24 اسہِ چھِ شٲدؠ یانہٕ کرنچؠ ضرورت تکیازِ میٚون یہِ نیٚچو اوس أکِس مودؠ مٕتس نفرس ہیو، وُنؠ سُپد دُبارٕ زندٕ! یہِ اوس رووٕمُت وُنؠ لوٗب أسؠ بیٚیہِ! ادٕ لٔگؠ تِم سٲری شٲدؠ یانہٕ کرنہِ۔
\v 25 ییٚلہِ یہِ سورےٕ سپدان اوس، تمِس مٲلؠ سُنٛد زِٹھ نیٚچو اوس کھہَن منٛز کٲم کران۔ پنٕنؠ کٲم انٛد واتناونہٕ پتہٕ دراو گرٕ کنُ۔ یتھے سُہ لوٗگ گرٕ نکھٕ واتنہِ، تٔمؠ بوز لوٗکن ہُنٛد گیٛوُن تہٕ نَژنُ۔
\v 26 تٔمؠ اوٚن اکھ خدمت گار ناد دِتھ تہٕ ووٚنس یہِ کیاہ اوس سپدان۔
\v 27 خدمت گار ووٚن تسَ، "چون بوے چُھ آمُت۔ چٲنؠ مٲلؠ ووٚن اسہِ سُہ وُژھ مارنہٕ خٲطرٕ یُس اسہِ روٚچھمُت اوس تکیازِ چون بوے آو صحت و سلامت واپس۔
\v 28 پوٚز زِٹھِس نیٚچوِس کٔھژ ژکھ تہٕ تٔمؠ یوٚژھ نہٕ شٲدؠ یانس منٛز شٲمل گژھن۔ لہٰذا تسُنٛد مول دراو نیٚبر کنُ تہٕ کوٚرنس انٛدر اژنہٕ خٲطرٕ زارٕ پارٕ۔
\v 29 پوٚز تٔمؠ دِیُت پننِس مٲلس جواب، "بوز! یِمو ساروےٕ ورؠ یو پؠٹھٕ چُھس بہٕ أکِس غلامہٕ سنٛدؠ پٲٹھؠ چٲنؠ ٹہلؠ کران رودمُت۔ بہٕ رودس ہمیشہ پرٛتھ کنہِ معاملس منٛز چون تٲبیع دار یہ ژےٚ ووٚنتھ تہِ کوٚڑ مےٚ۔ پوٚز ژےٚ دِتُتھ نہٕ مےٚ زانٛہہ اکھ ژھاوٕلؠ موٚنگُر تہِ یُتھ زَن بہٕ پننؠن دوستن ہنٛدِ خٲطرٕ اکہ سالُک انتظام کرِتھ ہیٚکہٕ ہا۔
\v 30 پوٚز وُنؠ ییٚلہِ یہِ چون نیٚچو چون سورےٕ پونٛسہٕ بدکار زنانن پؠٹھ بُرباد کٔرِتھ گرٕ واپس آو، ژےٚ ونُتھ پننؠن خدمت گارن اکھ شٲدؠ یانہٕ کرنہٕ باپتھ مٲرؠ وون سُہ روٚچھمُت وُژھ!
\v 31 پوٚز تسَنٛدؠ مٲلؠ ووٚن تمِس، "میانہِ گۅبرٕ، ژٕ چُھکھ ہمیشہ مےٚ سٟتؠ، یہِ کینٛژھا میٚون چُھ سُہ چُھ چون۔
\v 32 پوٚز شٲدؠ یانہٕ مناون تہٕ خوش سپدنُ چُھ سانہِ خٲطرٕ ضروری، تکیازِ چون بوے اوس زن تہِ مودمُت وُنؠ سپد دُبارٕ زندٕ! سُہ اوس زن تہِ رووٕمُت تہٕ وُنؠ لوٗب اسہِ یہِ دُبارٕ!"
\c 16
\p
\v 1 یسوعؔن ووٚن بیٚیہِ پننؠن شٲگردن، "اکہ وقتہٕ اوس اکھ امیر شخص یمِس گرٕ پکناونہٕ خٲطرٕ اکھ مختار نفر اوس۔ اکہ دوٚہہ دِژ کمؠ تام تمِس امیر شخصس خبر زِ سُہ مختار نفر اوس تِژھ اکھ کٲم کران یِمہِ ستؠ امیر شخصس اوس واریاہ پونٛسہٕ زایہِ گژھان۔
\v 2 لہٰذا تٔمؠ اوٚن سُہ مختار نفر پانس نِش ناد دِتھ تہٕ ووٚننس، "مےٚ یہِ بوز زٕ یہِ ژٕ کران چُھکھ تہِ چُھ خطرناک! مےٚ دِ اکھ ٲخٕری حساب تِمن کامٮ۪ن ہُنٛد یِمہٕ ژٕ پکناوان اوسُکھ، تکیازِ ژٕ ہیککھ نہٕ برونٛہہ کنُ میانہِ گروک مختار روٗزتھ!
\v 3 پتہٕ ووٚن تٔمؠ مختارن پانس کنُ، "میٚون مٲلکھ چُھ مےٚ نِش میٲنؠ مختٲری نِوان، لہٰذا مےٚ چُھ سونٛچن زِ بہٕ کیاہ کرٕ۔ بہٕ چُھس نہٕ توٚت طاقتور زِ بہٕ کھَنِنہٕ دۅب بیٚیہِ چھِ مےٚ پونٛسہٕ خٲطرٕ بیٚچھنس منٛز شرم یوان۔
\v 4 مےٚ چھِ پتاہ زِ بہٕ کیاہ کرٕ یوٚت زن لوٗکھ پننؠن گرن منٛز کامہ باپتھ اژنہٕ دِنم ییٚلہِ سُہ مےٚ کامہ نِشہ بے دٲخل کرِ!
\v 5 ادٕ ووٚن تٔمؠ پننِس مٲلکہٕ سنٛدین قرضدارن مےٚ نِش وٲتیٚو اکہ اکہ۔ تٔمؠ پرُوژھ گوٚڈنِکس أکِس، "ژےٚ کوتاہ دارکھ میٲنس مٲلؠ کس؟"
\v 6 تٔمؠ ووٚن، زیتون تیٖل ترٛے ساس لیٹر۔ تٔمؠ مختارن ووٚن تمِس، "کڈ پنُن حسابہٕ پرچہ، بہتھ بدلاو یہِ ؤلؠ ؤلؠ اکھ ساس پانٛژھ ہتھ لیٹرن منٛز!"
\v 7 تٔمؠ ووٚن دویمِس نفرس، "ژےٚ کوتاہ دارکھ؟ تٔمؠ دِیت جوابِ، "اکھ ساس ٹوٗکٕرِ کٕنکھٕ، تٔمؠ مختارن ووٚن تمِس، "ان پنُن حساب پرچہ اتھ بدلاو ٲٹھ شتھ ٹوٗکٕرِ!"
\v 8 ییٚلہِ تٔمؠ سٕنٛدؠ مٲلؠ کن بوز زِ تسنٛد مختار کیاہ اوس کران، تٔمؠ کٔرؠ بد دیانت مختار سٕنٛدؠ تعریف اوٕ باپتھ زِ سُہ دراو سیٹھاہ چالٲک۔ پزرَ چُھ یہِ زِ یمہِ دنیاہؠکہ لوٗکھ چھِ تِمن لوٗکن ہُنٛدِ کھوٗتہٕ زیادٕ چالٲک آسن یِمن لوٗکن خدایس سٟتؠ معاملات آسن چھِ۔
\v 9 بہٕ چُھس توٚہہِ ونُن، یتھ دنیاہس منٛز یۅسہ دولت توٚہہِ نِشہ چھِ سۅ کریو پانس کیتھؠ دوس بناونہٕ خٲطرٕ خرچ۔ پتہٕ ییٚلہِ سۅ دولت توٚہہِ نِشہ نیرِ، تِم دوس کرن توٚہہِ پننؠن گرن منٛز خوش آوے، یوسہٕ ہمیشہ خٲطرٕ موجود روزِ۔
\v 10 یِم لوٗکھ ایماندٲری سان کم دولتس پؠٹھ چھِ گُذارٕ کران تِم آسن زیادٕ دولت ٲسِتھ تہِ بیٚیہِ ایماندار۔ تِم لوٗکھ یِم کم دولتس پؠٹھ بد دیانتی سٟتؠ چھِ گُذارٕ کران تِم آسن زیادٕ دولت ٲسِتھ تہِ بیٚیہِ بددیانت۔
\v 11 ادٕ یسَ دولت خداین توٚہہِ یتھ دنیاہس منٛز عطا کرِ مٕژ چُھو سۅ چُھو نہٕ توٚہہِ ہرگاہ دیانتدٲری سان خرچ یا استعمال کٔر مٕژ چھِ، تیلہٕ کرِ نہٕ سُہ توٚہہِ جنتس منٛز حقیقی دولت حوالہٕ۔
\v 12 ہرگاہ توٚہہِ ۅپر لوٗکن ہُنٛد جاداد آسہ نہٕ دیانتدٲری سان سَمبولمُت، توٚہہِ پزِ نہٕ امید تھوُنؠ زِ کانٛہہ اکھ دِیہ توٚہہِ پنُن جایداد۔
\v 13 کانٛہہ خدمتگار ہیٚکہ نہٕ دوٗن الگ الگ مٲلکن ہنٛز خدمت اکی ساعتہٕ کٔریتھ۔ ہرگاہ تٔمؠ تہِ کرنچؠ کوٗشش کٔر، سُہ کرِ تِمن منٛز أکِس نفرت تہٕ بییٚس برِ لول، یا آسہ أکِس سُنٛد وفادار تہٕ بیٚیہِ سُنٛد ٲسس عداوت۔ توٚہؠ ہیکیو نہٕ پننہِ زندگی منٛز خدایہِ سٕنٛدؠ وفادار ٲسِتھ ہرگاہ توٚہؠ پننہِ زندگی منٛز مال تہٕ دولت چُھو حٲصٕل کران۔"
\v 14 ییٚلہِ تِمو فریسیو یِم تتہِ موجود ٲسؠ، یسوعؔ سنٛز تعلیم بوزان ٲسؠ، تِمو کوٚر تمِس مذاق تکیازِ تِم ٲسؠ دولت حٲصٕل کرنس لول بران۔
\v 15 پوٚز یسوعؔن ووٚن تِمن، "توٚہؠ چُھو یہِ کوٗشش کران زِ لوٗکھ سونٛچن زِ توٚہؠ چُھو پزِؠ یٲرؠ، پوٚز خدایہِ چُھ زانان زِ اصلی کیاہ چُھو توٚہؠ۔ ذہنس منٛز تھوٚو زِ خدایہِ چُھ تِم چیز مکرو مانان یِمن لوٗکھ سیٹھاہ تعریف کران چھِ۔
\v 16 خداین یُس شریعت موسیٰؔ ہس عطا کوٚر تہٕ تِم چیز یِم رسول یو لیکھؠ رودؠ چلان توٚت تام یوٚت تام یوحناؔ بپتسمہ دِنہٕ وول آو۔ تننہٕ پؠٹھٕ رودس بہٕ خدٲیی بادشٲہی متعلق رٕژِ شیٚچھِ ہُنٛد تبلیغ کران۔ واریاہ لوٗکھ چھِ میٚون پٲغام قبول کران تہٕ سیٹھاہ بیتٲبی سان چھِ خدٲیی بادشٲہی ہُنٛد حصہٕ بننٕچ کوٗشش کران۔
\v 17 "تہٕ یہِ چُھ زمین تہٕ آسمان  خٲطرٕہ سہل قانون کہِ اکہِ ٹٹل کہِ ناکام گژھنہٕ کھۅتہٕ۔"
\v 18 کانٛہہ مرد یُس پننہِ زنانہِ ترٛاوِ تہٕ بییٚس زنانہِ سٟتؠ کرِ خاندر سُہ چُھ زِنٚا کران، بیٚیہِ کانٛہہ مرد یُس تمِس زنانہِ سٟتؠ خانٛدر کرِ یمِس پنٕنؠ خانٛدارن کھُلا آسہ دِیتمُت سۅ تہِ چھِ زِنٚا کران۔"
\v 19 یسوعؔن ووٚن بیٚیہِ، "اکہ وقتہٕ اوس اکھ امیر نفر یُس قٕمتی ووٚزٕلؠ تہٕ زٲولؠ پلو لاگان اوس۔ سُہ اوس پرٛیتھ دوٚہہ عٲش ژٹان۔
\v 20 لوٗکو تھوٚو پرٛیتھ دوٚہہٕ اکھ لعزر ناوک غریٖب نفر تمِس امیر نفرٕ سنٛدِس گرِکس دروازس پؠٹھ۔ لعزرسؔ سُنٛد بدن اوس نُوسُرؠ سٟتؠ بٔرِتھ۔
\v 21 سُہ اوس تیٚوت بۅچھِ ہوٚت تہٕ سُہ اوس یژھان تمہِ غذا ۂکؠ ٹکرٕ کھیٚنؠ یِم زن تمِس امیر نفرٕ سنٛدِ میزٕ پؠٹھٕ ؤسؠ ٲسؠ پیٚوان۔ ییٚلہِ سُہ تتہِ ڈٲف تراوِتھ اوس ہوٗنؠ آے تہٕ لیٚوِکھ تسنٛدؠ زخم۔
\v 22 ٲخرکار مود سُہ غریب نفر۔ پتہٕ تُل سُہ فرشتو تہٕ ترٛووٚکھ پننِس جدس ابرہامسؔ نِشہ۔ سُہ امیر نفر تہِ مود، تہٕ لوٗکو کوٚر سُہ دفن۔
\v 23 عالمہِ ارواحس منٛز اوس تمِس امیر نفرس سخ عذاب۔ تٔمؠ دِژ ہیٚور کنُ نظر تہٕ تتہِ وچُھن ابرہامؔ سیٹھاہ دوٗرِ تہٕ لعزرسؔ اوس ابرہامسؔ نکھٕ بہتھ۔
\v 24 ادٕ دِژ تٔمؠ امیر نفرن کرٮ۪کھ، "ببہٕ ابرہامؔ، مےٚ چُھ یتھ نارس منٛز سیٹھاہ عذاب واتان! لہٰذا کر تہٕ مےٚ پؠٹھ رحم بیٚیہ سوزتن لعزرسؔ مےٚ نِش یتھ زن سُہ پنٕنؠ اونٛگج آبس منٛز کٕژوِتھ ہیٚکہ تہٕ میانہِ زیوِ پؠٹھ ٹھنٛڈ کرنہٕ باپتھ تھاوِہے!
\v 25 پوٚز ابرہامنؔ دِتُس جواب، "پۅترٕ، یاد کر ییٚلہ ژٕ زمیٖنہِ پؠٹھ زندٕ اوسُکھ ژےٚ تُلتھ واریہن چیزن ہُنٛد مزٕ۔ پوٚز لعزرسؔن اوس مصیبت تُلان۔ وُنؠ چُھ سُہ یتہِ خۅش، تہٕ ژٕ چُھکھ تکلیفس منٛز۔
\v 26 تمہِ علاوٕ چُھ خداین ژےٚ تہٕ اسہِ درمیان اکھ سون نار تھوومُت۔ لہٰذا یِم یژھن یتہِ پؠٹھ ژےٚ نِش گژھن تِم ہیٚکن نہٕ تہِ کرتھ۔ تمہِ علاوٕ، کانٛہہ اکھ تہِ ہیٚکہ نہٕ یتہِ پؠٹھ اور گژھتھ نہٕ ہیٚکہ اورٕ یوٗر ترِٛتھ۔
\v 27 پتہٕ ووٚن تٔمؠ امیر نفرن، "ببہٕ ابرہامؔ، ہرگاہ یہِ تہِ چُھ، بہٕ چُھس ژؠے ونن زِ لعزرؔ سوٗزنُ میٲنس خاندٲنی گرٕ منٛز۔
\v 28 تتہِ چھِ میٲنؠ پانٛژھ بٲے روٗزان۔ تمِس ووٚن زِ سُہ کرِ تِمن خبردار یتھ نہٕ تِم یتھ جایہِ کنُ سفر کرنَ یتہِ چُھ اسہِ سخ عذاب!
\v 29 پوٚز ابرہامنؔ دِیت جواب، "نا، بہٕ ہیٚکہٕ نہٕ تہِ کریتھ تکیازِ چٲننؠ باین نِش چُھ تہِ یہِ موسیٰؔ ہن تہٕ نبی یو واریاہ برونٛہہ لیٚوکھ۔ تِمن پزِ تتھ تٲبِیدٲری کرٕنؠ یہِ تِمو لیٚوکھ!
\v 30 مگر تٔمؠ امیر نفرن دِیت جواب، "ببہٕ ابرہامؔ، ناہ، سُہ آسہ نہٕ کٲفی! پوٚز ہرگاہ موٚردو منٛزِ کانٛہہ تِمن نِش واپس گژھِ تِم کرن توبہٕ۔
\v 31 ابرہامنؔ ووٚن تمِس، "ییٚلہِ نہٕ تِم تتھ کرن تٲبِیدٲری یہِ موسیٰؔ ہن تہٕ رسول یو لیٚوکھ۔ تیلہٕ کرِ نہٕ یہٕ تِمن مدد اگر مۅردو منٛزٕ کانٛہہ وۅتھہِ تہٕ تمن نِش گژھِتھ تِمن خبردار کرِ۔ تِم کرن نہٕ تمہِ پتہٕ تہِ یقین زِ تِمن پزِ پننیٚو گناہو نِشہ توبہٕ کرن۔"
\c 17
\p
\v 1 یسوعؔن ووٚن پننؠن شٲگردن، "تِم چیز سپدن یقیٖنن واقع یِمو سٟتؠ لوٗکھ چھِ گناہ کرنہٕ خٲطرٕ آزماونہٕ نہٕ یوان۔ پوٚز یہِ کوتاہ خطرناک آسہ تمِس نفرٕ سنٛدِ باپتھ یُس تِمن چیزن واقع سپدنہٕ دِیہ!
\v 2 یہِ روزہے تمِس شخصہٕ سٕنٛدِ خٲطرٕ بہتھر ہرگاہ تمِس کانٛہہ اکھا اکھ گرؠٹہٕ ژٔکر گردٔنہِ نٲلؠ ژھنہِ تہٕ سمندرس منٛز ییہِ لایس تمہِ کھۅتہٕ ہرگاہ سُہ تمِس نفرس گناہ کرناوِہے یمِس ایمان کمزور اوس۔
\v 3 عمل کرنس منٛز روزیٚو ہُشیار۔ ہرگاہ دوٚیم پژھ کرن وول گناہ کرِ، توٚہہِ پزِ تمِس ملامت کرٕنؠ۔ ہرگاہ تٔمؠ ونہِ زِ تمِس چُھ گناہ کرنس پؠٹھ افسوس تہٕ ونِوٕ زِ مےٚ دِ معافی، تیلہِ پزِ توٚہہِ تمِس معافی دنؠ۔
\v 4 ہتاکہ اگر سُہ أکِس دوٚہس منٛز ستہِ لٹہ تہِ ژےٚ خلاف گناہ کرِ، ہرگاہ سُہ پرٛتھ دوٚہہ ژےٚ نِش یتھ ونہِ، مےٚ چُھ تتھ پؠٹھ افسوس یہِ مےٚ کوٚر، ژٕ تھوٚو تمِس معافی دِنؠ لٲزِمن جٲری۔"
\v 5 پتہٕ ووٚن تِمو رسولو یسوعؔ ہس، "سون ایمان کر زیادٕ پۅختہٕ!"
\v 6 یسوعؔن دِیت جواب، "ہرگاہ توٚہہِ یتھ معمولی تِلہٕ گۅگل دانس برابر تہِ ایمان آسہ ہیے، توٚہؠ ؤنؠ ہیو یتھ تُلہٕ کلُس، کڈ سورےٕ پنُن پان موٗل ہٮ۪تھ زمیٖنہِ منٛزٕ نیٚبر، پتہٕ درانٛٹھنُ پنُن پان سمندرس منٛز، سُہ مانہِ ہیے تُہنٛد!"
\v 7 بیٚیہِ ووٚن یسوعؔن، "فرض کرو زِ توٚہہِ منٛز اوس أکِس اکھ خدمت گار یُس تُہنٛدین کھہَن منٛز دانٛد وایان اوس یا تُہنٛدین تیرن اوس رچھان۔ پتہٕ ووت سُہ کھہہ پؠٹھٕ یتھ تُہنٛدس گرس منٛز، توٚہؠ ووٚنو نہٕ تمِس، ؤلؠ ؤلؠ یِتہٕ تہٕ بیٚہہ کھیٚنہِ!
\v 8 تمہِ بجایہ توٚہؠ ونیو تمِس، "میانہِ خٲطرٕ کرِ کھیٚن تیار! پتہٕ لاگ خدمت گٲری ہُنٛد لباس تہٕ کرِ مےٚ خدمت یوٗتھ بہٕ کھیٚتھ چیٚتھ ہیٚکہٕ! تمہِ پتہٕ ہیککیو توٚہؠ کھیٚتھ تہٕ چیٚتھ۔
\v 9 توٚہؠ کٔرِو نہٕ تمِس خدمت گٲرٕ سُنٛد شُکر تتھ کامہ پؠٹھ ادا یۅسہ توٚہہِ تمِس کرنہٕ خٲطرٕ ووٚنمُت اوسو!
\v 10 یتھے پٲٹھؠ، ییٚلہِ تِمہ سار کامہِ توٚہؠ تِتھے پٲٹھؠ کریو یتھٕ پٲٹھؠ توٚہہ خداین وونمُت چُھ، توٚہہِ پزِ ونُن، ٲسؠ چھِ صرف خدایہِ سٕنٛدؠ خدمت گار۔ أسؠ چھنہٕ کنہِ شکر گذٲری ہنٛدؠ حقدار۔ اسہِ کرِ تِمے کامہ یِمن متعلق اسہِ وننہٕ آمُت اوس۔"
\v 11 ییٚلہِ زن یسوعؔ تہٕ تسنٛدؠ شٲگرد ٲسؠ یروشلمسؔ کنُ وتہِ پکان، تِم درٛایہِ سامریہ تہٕ گلیل کیو درمیان علاقو منٛزؠ۔
\v 12 \f + \fr 17‏:12 \ft احبار 13:46\f*ییٚلہِ یسوعؔ أکِس گامس منٛز ژاو، تمِس کنُ آیہِ دہ مینٛدؠ لد، مگر تِم روٗدؠ تمِس نِشہ کمےٕ فٲصلہٕ پؠٹھ دوٗر اِستادٕ۔
\v 13 تِمو دِژ کرٛکھ، "یسوعؔ، ووستادٕ، مہربٲنی کٔریتھ کرتہٕ اسہِ پؠٹھ رحم!"
\v 14 \f + \fr 17‏:14 \ft احبار 14:2۔ 3\f*یسوعؔن ییٚلہِ تِم وُچھ، تٔمؠ ووٚن تِمن، گٔژِھو تہٕ پانس کرناو کاہننس اتھِ ملاحظ۔ "أتی درٛایہِ تِم تہٕ وتہِ منٛزےٕ سُپد تِمن میونٛد غٲب۔
\v 15 پتہٕ تِمو منٛزٕ ییٚلہِ اکؠ وُچھ زِ تمِس اوس نہٕ وُنؠ میونٛد، سُہ پھیوٗر خدایہِ سنٛدؠ تعریف زورٕ زورٕ کران پوٗت۔
\v 16 سُہ ووت یسوعؔ ہس نِش تہٕ کوٚرن یسوعؔ سنٛدین پادن تل زمیٖنس پؠٹھ بُتھِ کِنؠ سَجدٕ، بیٚیہِ کوٚرنس شُکریا ادا۔ یہِ اوس اکھ سامری شخص۔
\v 17 یسوعؔن ووٚن پتہٕ، "مےٚ کوٚر دہن میونٛد لدن شفا! مےٚ اوس انٛدازٕ زِ تِم نو تہِ واتن واپس!
\v 18 یہِ اوس ۅپر ملکُک صرف اکھ شخص یُس خدایہِ سنٛز شکُر گذٲری کرنہٕ باپتھ واپس آو۔ باقٕیو منٛز آو نہٕ کانٛہہ اکھ تہِ واپس!"
\v 19 پتہٕ ووٚن تٔمؠ تمِس شخصس، "ووٚتھ تھوٚد تہٕ گژھِ پننہِ وتہِ۔ خداین چُھے ژٕ شفا کوٚرمُت تکیازِ ژےٚ کوٚڑُتھ مےٚ پؠٹھ بھروسہٕ۔"
\v 20 اکہ دوٚہہ پرُوژھ کینٛژو فریسیو یسوعؔ ہس، "خدایی بادشٲہی کرِ گژھِ پرٛیتھ أکِس پؠٹھ شروع؟" تٔمؠ دِیت جواب، "تتھ منٛز آسن نہٕ اِشارٕ یُتھ زن لوٗکھ پرزٕناون اگر تِم تِمن ہُنٛد انتظار کرن۔
\v 21 لوٗکھ آسن نہٕ تتھ لایق زِ تِم ونن، وُچھو! خدایہِ بادشٲہی چھِ یتن! یا خدایہِ بادشٲہی چھِ ہوٗتنؠ! تُہنٛدس سونچس برعکس، خدایہِ بادشٲہی چھِ برٛونٹھے توٚہؠ منٛز شروع گٕمژ۔"
\v 22 یسوعؔن ووٚن پننؠن شٲگردن، "اکھ وقت ییہِ ییٚلہِ توٚہہِ گژھؠو تمناہ مےٚ اولادِ آدمس، طاقتہٕ سان بادشٲہی کران وچُھن۔ پوٚز توٚہؠ وُچھو نہٕ تہِ۔ \f + \fr 17‏:22 \ft آدمؔ سنٛدِس اولاد سٕنٛدؠ واپس ینکہٕ دوٚہہ۔ \f*
\v 23 لوٗکھ ونن توٚہہِ، وُچھوِ، مسیحؔ چُھ ہوپٲرؠ، یا تِم ونن، وُچھوِ سُہ چُھ یپٲرؠ، تِمن گژھِ نہٕ پتہٕ پتہٕ پکنُ۔
\v 24 یتھٕ کٔنؠ وزٔمل زٕژٕ آسمانس اکہ انٛدٕ پؠٹھٕ بییٚس انٛدس تام گٲشراوان چھِ یتھ ہر کانٛہہ وُچِھتھ ہیٚکہ۔ تِتھے پٲٹھؠ آسہ اولادِ آدمؔ ییٚلہِ سُہ دُبارٕ ییہِ، مےٚ وُچھِ ہر کانٛہہ۔
\v 25 پوٚز تہِ سپدن برونٛٹھ چُھ ضروری زِ مےٚ چھِ مختلف طریقو تکلیف وؠتراوٕنؠ، تہٕ لوٗکھ کرن مےٚ رد۔
\v 26 \f + \fr 17‏:26 \ft عِبرٲنؠن 4:7، متی 24:37، پیدٲیش 6:5۔ 12\f*پوٚز ییٚلہِ بہٕ اولادِ آدمؔ دُبارٕ یِمہٕ لوٗکھ آسن کامہ تیھےٕ پٲٹھؠ کران یتھٕ کٔنؠ نوحؔ سنٛدِس زمانس منٛز لوٗکھ کران ٲسؠ۔
\v 27 تمہِ وقتہٕ ٲسؠ لوٗکھ کھیوان چؠوان، خاندر کران، تتھ دوٚہس تام ییٚلہِ نوحؔ تہٕ تسنٛد خاندان ووٚتھ أکِس بجہِ ناوِ منٛز۔ پوٚز پتہٕ آو سٔہلاب تہٕ تِم سٲری گےَ مارٕ یِم نہٕ ناوِ منٛز ٲسؠ۔
\v 28 یِتھۓ پٲٹھؠ، لوٗط سنٛدِس زمانس منٛز ییٚلہِ صدوم شہرس منٛز لوٗکھ ٲسؠ حسبِ معمول کھیوان تہٕ چؠوان۔ تِم ٲسؠ چیز ہؠوان تہٕ کٕنان۔ تِم ٲسؠ حسبِ معمول فصل وۅپداوان بیٚیہِ مکانہٕ تعمیٖر کران۔
\v 29 \f + \fr 17‏:29 \ft پیدٲیش 19:24، یوحناؔ 1:7، پطرس 2۔ 2:26، \f*پوٚز یمہِ دوٚہہ لوٗط سدومہٕ منٛز دراو نار تہٕ گندُھک ووٚتھ آسمانہٕ پؠٹھٕ تہٕ تِم سٲری سٕپدؠ مارٕ یِمو تتھ شہرس منٛز ٹھٔہراو کوٚرمُت اوس۔
\v 30 یِتھۓ پٲٹھؠ، ییٚلہِ بہٕ اولادِ آدمؔ زمیٖنہِ پؠٹھ واپس واتہٕ لوٗکھ آسن نہٕ تیار۔
\v 31 تمہِ دوٚہہ، یِم پننیٚو گرٕ نیٚبر آسن تِہنٛدؠ سٲری چیز آسن گرن منٛزٕ، تِمن نِشہ آسہ نہٕ توٚت وقتہٕ یوٚت تِم ہیکن تِم چیز گرن منٛز انٛدر أژتھ تہٕ بیبر کٔڈتھ۔ یِتھۓ پٲٹھؠ، یِم کھہَن منٛز کٲم کران تِمن پزِ نہٕ گرٕ یُن کانٛہہ چیز حٲصٕل کرنہٕ باپتھ۔ تِم ژَلن ضروری ؤلؠ ؤلؠ۔
\v 32 \f + \fr 17‏:32 \ft پیدٲیش 19:17، 26\f*یاد کریو لوٗط سنٛزِ آشنہِ کیا سُپد!
\v 33 کانٛہہ تہِ اکھ یُس تہِ پننہِ طریقہٕ زندگی بسر کرِ سُہ سُپدِ مارٕ۔ پوٚز یُس اکھ پننہِ زندگی بسر کرنُک پرُون طریقہٕ میانہِ خٲطرٕ بدلاوِ سُہ کرِ ابدی زندگی بسر۔
\v 34 \f + \fr 17‏:34 \ft فرشتن ہنٛدؠ دسؠ آو ننہٕ یِم امہِ خٲطر ژٲرنہٕ آیہِ۔ مرقُس 13:27\f*بہٕ چُھس توٚہہِ یہِ ونان: یمہِ راژ ییٚلہِ بہٕ واپس واتہٕ، زٕ نفر آسن اکسےٕ پلنٛگس پؠٹھ شۅنٛگتھ۔ اکھ ییہِ تُلنہٕ تہٕ بیاکھ تراونہٕ۔
\v 35 زٕ زنہِ آسن یِکہٕ وٹہٕ پھل پِشان۔ خدایہِ تُلہِ تِمو منٛز أکِس تہٕ بییٚس ترٛاوِ پتھ کنُ۔"
\v 36 "کھہَس منٛز آسن زٕ نفر؛ اکھ ییہِ تُلنہٕ بیٛاکھ ییہِ ترٛاونہٕ۔"
\v 37 \f + \fr 17‏:37 \ft ایوب 39:30\f* شاگردو ووٚن یسوعسؔ، "خداوندٕ، یہِ کتہِ سپدِ؟" تٔمؠ دِیتُ تِمن جواب، "ییٚتہِ کُنہِ مودمُت آسہ تتہِ گژھن گرؠد جمع سۅ کھؠنہٕ خٲطرٕ، یمہٕ نشانہٕ چھِ ہاون زِ ٲخری وقت چُھ نزدیک۔"
\c 18
\p
\v 1 یسوعؔن وُنؠ پننؠن شٲگردن ہیچھناؤنہٕ باپتھ بیٛاکھ دلیل زِ تِمن پزِ لگاتار دوٚیٛخٲر کران روزُن تہٕ ہمت گژھِ نہٕ ہارٕنؠ ہرگاہ تِہنٛد دُعا بوزنہٕ خداین ؤلؠ ؤلؠ۔
\v 2 تٔمؠ ووٚن، "أکِس خاص شہرس منٛز اوس اکھ منصف یمِس نہٕ خدایہِ سُنٛد احترام اوس تہٕ نہٕ اوس لوٗکن متعلق خیال تھاون۔
\v 3 تتھ شہرس منٛز ٲس اکھ موٚنٛڈ یوٚسہٕ تمِس منصفس نِش یوان ٲس یہِ ونان روٗزان، "مہربٲنی کرتہِ مےٚ دِیو انصاف تمِس نفرس نِش یُس عدالتس منٛز میون مُخٲلف چُھ۔"
\v 4 واریہس وقتس کوٚر تٔمؠ منصفن تمِس مدد کرنہٕ نِشہ اِنکار۔ مگر پتہٕ ووٚن تٔمؠ پننِس پانس، بہٕ چُھس نہٕ خدایس احترام کران تہٕ نہٕ لوٗکن ہُنٛد پرواہ کران۔
\v 5 مگر یہِ مۅنٛڈ روز مےٚ ستاوان! لہٰذا بہٕ وُچھِ أمؠ سُنٛد مقدِمہ تہٕ أمِس کٔرِو انصاف۔ مےٚ چھِ پتاہ زِ اگر نےَ بہٕ یہِ کرٕ، سۅ روزِ مےٚ نِش یوان تہٕ بہٕ یمہٕ تنٛگ!"
\v 6 پتہٕ ووٚن یسوعؔن، "ہشیٲری سان سونٛچو تتھ متعلق یہِ تٔمؠ بے انصاف منصفن ووٚن۔
\v 7 یقیٖنن خدایہِ، یُس پزِیوٗر چُھ، کرِ پننؠن ژٲرمٕتین ہُنٛد انصاف یِم تمِس وفادٲری سان درس دوٚہس دعا کران چھِ! تہٕ سُہ چُھ ہمیشہ تِمن سٟتؠ صبرٕ سان روزان۔
\v 8 بہٕ چُھس توٚہہِ ونان، خدایہِ کرِ ؤلؠ ؤلؠ پننؠن ژٲرمٕتین ہُنٛدِ خٲطرٕ انصاف! توتہِ ییٚلہِ بہٕ، اولادِ آدمؔ، زمیٖنہِ پؠٹھ واپس یِمہٕ، تتہِ آسن تمہِ پتہٕ تہِ واریاہ لوٗکھ یِمن نہٕ مےٚ پؠٹھ ایمان ٲسی۔"
\v 9 پتہٕ ووٚن تٔمؠ بیٚیہِ ورگہٕ پٲٹھؠ تِمن کینٛژن لوٗکن یِم سونچان ٲسؠ زِ تِم ٲسؠ پانس راست باز سمجھان تہٕ باقین لوٗکن ٲسؠ کمترَ سمجھان۔
\v 10 تٔمؠ ووٚن، "زٕ نفر گےَ یروشلمہٕؔ کِس ہیکلس منٛز دُعا کرنہٕ خٲطرٕ۔ اکھ نفر اوس فریسی۔ بیٛاکھ اوس رومی سرکارٕ خٲطرٕ لوٗکن نِشہ گُذر جمع کرن وول نفر۔
\v 11 فریسی سپد اِستادٕ تہٕ لوٚگ پانس متعلق یمہِ انٛدازٕ دُعا کرنہِ، "اے خدایہِ، بہٕ چُھس چون شُکرُ کران زِ بہٕ چُھس نہٕ باقین لوٗکن ہنٕٛدؠ پٲٹھؠ۔ کینٛہہ چھِ بیین پونٛسہٕ ژورِ نِوان۔ کینٛہہ چھِ بدسلوکی کران۔ کینٛہہ چھِ زنا کران۔ یِمو منٛزٕ چُھس نہٕ بہٕ کانٛہہ تہِ کٲم کران۔ تہٕ بہٕ چُھس نہٕ یقیٖنن یمِس گناہگار گُذر جمع کرن وٲلؠ سٕنٛدؠ پٲٹھؠ یُس لوٗکن ٹھگاؤن چُھ!
\v 12 بہٕ چُھس ہفتس منٛز دوٚن دوٚہُن روزدار روزان، تہٕ بہٕ چُھس پننِہِ تمام آمدنی ہُنٛدس پرٛتھ ہتہٕ منٛزٕ دہِم حصہٕ ہیکلس دِوان!
\v 13 پوٚز سُہ محصول جمع کرن وول اوس ہیکلہٕ کس صحنس منٛز لوٗکو نِشہ دوٗر اِستادٕ۔ سُہ اوس نہٕ ہتاکہ ہیٚور آسمانس کنُ تہِ وُچھان۔ امہِ بدلہٕ، اوس سُہ پننِس وچھس ژنجہِ دِوان تہٕ ونان، "ہیے خدایہِ، مہربٲنی کٔریتھ دِ مےٚ معٲفی، تکیازِ\f + \fr 18‏:13 \ft زبُور 51:1\f* بہٕ چُھس اکھ خطرناک گناہگار!"
\v 14 پتہٕ ووٚن یسوعؔن، "بہٕ وُنہٕ توٚہہِ زِ یتھے تِم گرٕ کنُ درایہِ، خداین اوس محصول جمع کرن وٲلسےٕ معاف کوٚرمُت، پوٚز خداین اوس نہٕ تمِس فریسیس معاف کوٚرمُت۔ امیٚک وجہ چُھ یہِ زِ خدایہِ نرمایہ تسَ یُس پانس بجر دِیہ تہٕ خدایہِ دِیہ تمِس بجر یُس پانس منٛز نرمی پٲدٕ کرِ۔"
\v 15 اکہ دوٚہہ ٲسؠ لوٗکھ یسوعسؔ نِشہ پنٕنؠ بچہٕ تہِ انان یُتھ زن سُہ تِمن پنُن اتھٕ ڈالؠکھ بیٚیہِ کرکھ دویہِ خٲر۔ ییٚلہِ شاگردو یہِ وُچھ، تِمو ووٚن تِمن یہِ مہَ کٔرِو۔
\v 16 پوٚز یسوعؔن أنؠ تِم شُرؠ پانس نِشہ۔ تٔمؠ ووٚن، "لوٗکٕٹن شُرین دِیو مےٚ نِشہ ینہٕ! تِم مہَ رکٲؠ ووکھ، تکیازِ خدایہِ سنٛز بادشٲہی چھےٚ تِمن لوٗکن ہنٛز یم یمن مومِن بچن ہندؠ پٲٹھؠ چھِ یمو یہٕ حٲصل کوٚرمُت چُھ۔"
\v 17 بے شکھ، بہٕ چُھس توٚہہِ ونان زِ یُس نہٕ خدایہِ سنٛز بادشٲہی أکِس مومِن شُرؠ سٕنٛدؠ پٲٹھؠ حٲصِل کرِ سُہ گژھِ نہٕ پانہٕ اتھ منٛز دٲخل۔"
\v 18 اکہ وقتہٕ پرُوژھ یسوعؔ ہس اکہ یہُودؠ سردارن، "رٔتہِ ووستادٕ، "مےٚ کیاہ چُھ تہِ ضروری کرُن یُتھ زنہٕ مےٚ ابدی زندگی حٲصٕل سپدِ؟"
\v 19 یسوعؔ ہن ووٚن تسَ، "ژٕ کیازِ چُھکھ مےٚ رُت ونان؟ خدایہِ چُھ صرف کُنے یُس پٔزؠ پٲٹھؠ رُت چُھ!
\v 20 چٲنس سوالہٕ کسِ جوابس منٛز چُھکھ ژٕ یقیٖنن تِم حکم زنان یِم خداین موسیٰؔ ہس سانہِ فرمانبردٲری کرنہٕ باپتھ دِیتؠ: زنا مٕہ کٔرِو۔ قتل مٕہ کرِہنُ کانٛہہ۔ ژوٗر مہٕ کریو۔ اپُز گوٲہی مٕہ دیو۔ پننِؠس مٲلس مٲجہِ کٔرِو یزتھ۔"
\v 21 تٔمؠ شخصن ووٚن، "مےٚ چھِ لکٕچٲرٕ پؠٹھۓ تِمن حکمن پؠٹھ عمل کران روٗدمُت۔"
\v 22 ییٚلہِ یسوعؔن تہِ بوز یہِ تمؠ ووٚن، تمؠ دِیُت جواب" ژےٚ چھے وُنہِ تہِ اکھ کٲم کرنچؠ ضرورت۔ یہِ ژےٚ نِشہ چُھ تہِ سورےٕ ژھنؠ کٔنتھ۔ پتہ دِ سُہ پونٛسہٕ تِمن لوٗکن یِم مشکِلن زندگی گُذارن چھِ۔ تٔمیٚک نتیجہٕ نیرِ زِ آسمانس پؠٹھ آسکھ روحٲنی لحاظٕ امیر۔ پتہٕ یی تہٕ بن میٚون شٲگرد!"
\v 23 ییٚلہ تٔمؠ شخصن تہِ بوز سُہ سپد سخ مایوس، تکیازِ سُہ اوس بوٗڈ دولتمند۔
\v 24 ییٚلہِ یسوعؔن تمِس شخصہٕ کنُ وُچھ تہٕ ونن، "یہِ چُھ دولت مندن ہنٛدِ خٲطرٕ سیٹھاہ مشٕکل زِ تِم سپدن خدٲیی بادشٲہی منٛز دٲخٕل۔
\v 25 حقیتس منٛز، یہِ چُھ أکِس اونٛٹہٕ سٕنٛدِ خٲطرٕ سَہل زِ سُہ اژِ اکہ سٕژنہِ پییہِ کِنؠ تمہِ نِشہ چُھ یہِ سیٹھاہ مشٕکل زِ دولت منٛد لوٗکھ سپدن خدٲیی بادشٲہی انٛدر دٲخٕل۔"
\v 26 یمو یسوعؔ سُنٛد سُہ کتھ بوز تِمو ووٚن، "پتہٕ چُھ باسان زِ خدایہِ مانہِ نہٕ زِ کٲنٛسہِ پزِ ابدی زندگی آسٕنؠ!"
\v 27 پوٚز یسوعؔن ووٚن، "یہِ لوٗکن نِشہ ناممکن چُھ تہِ چُھ خدایس نِشہ ممکن۔"
\v 28 پطرسؔن ووٚن پتہٕ، "اسہِ متعلق کیاہ آسہ؟ اسہِ ترٲوؠ پنٕنؠ سورےٕ کینٛہہ یہِ اسہِ اوس یُتھ زنہٕ چٲنؠ شٲگرد بنییہِ۔"
\v 29 یسوعؔن ووٚن تِمن، "بہٕ ہیٚکہٕ توٚہہِ یقین دِتھ زِ یِمو پنٕنؠ گرٕ، پننہِ عاشنہِ، پنٕنؠ بٲے، پنُن مول موج، یاہ پنٕنؠ اولاد ترٲوؠ خدٲیی بادشٲہی انٛدر دٲخٕل سپدنہٕ خٲطرٕ
\v 30 تِمن سپدٕ یتھ زندگی منٛزٕ تمیٛک واریاہ گنہٕ حٲصٕل یہِ تِمو پتھ کُن آسہ ترٛٲومُت، تہٕ ینہٕ واجنہِ عمرِ منٛز گژھِ تِمن ابدی زندگی حٲصٕل۔"
\v 31 یسوعؔن نیہ تِم باہ شٲگرد پانس سٟتؠ أکِس جایہِ۔ تٔمؠ ووٚن تِمن، "ہوشہِ سان بوزیٚو! ٲسؠ چھِ یروشلمسؔ کنُ وتہِ پکان۔ ییٚلہِ أسؠ تتہِ آسو، تہِ سورےٕ سپدِ پوٗرٕ یہِ نبی یو سیٹھاہ برونٛٹھ مےٚ، آدمؔ سنٛدِس اولادس متعلق لیٚوکھمُت چُھ۔
\v 32 یہِ سپدِ ییٚلہِ میٲنؠ دشمن مےٚ تِمن حٲکمن حوالہٕ کرُن یِم نہٕ یہُودؠ چھِ۔ تِم کرُن مےٚ ٹھٹھٕ، مےٚ سٟتؠ کرن شرمناک سلوک بیٚیہِ لاین مےٚ تھوٚکہٕ۔
\v 33 تِم دِین مےٚ کوڈٕ تہٕ کرن مےٚ قتل۔ پوٚز پتریٚمہِ دوٚہہ سپدٕ بہٕ دُبارٕ زندٕ۔"
\v 34 پوٚز شاگردو سمجھ نہٕ تمہِ منٛزٕ اکھ کتھ تہِ یہِ تٔمؠ ووٚن۔ خداین رکٲوؠ تِم پنٕنؠ اہمیت پرزٕناونہٕ نِشہ، اوے توٚر نہٕ تِمن کتھن ہُنٛد مطلب فکرِ یمہِ یسوعؔ تِمن ونان اوس۔
\v 35 یِتھۓ یسوعؔ تہٕ تسنٛدؠ شٲگرد یرِیحُو شہرس نکھٕ ووت، اکھ اوٚن اوس وتہِ انٛدس کنُ بہتھ۔ سُہ اوس پونٛسہٕ خٲطرٕ بیٚچھان۔
\v 36 ییٚلہِ تٔمؠ بوز زِ اکھ لوٗکن ہُنٛد ہجوم تپٲرؠ پکان، سُہ روٗد پانس انٛدؠ انٛدؠ پِرٛژھان، "یہِ کیاہ چُھ سپدان؟"
\v 37 تِمو ووٚن تسَ، "لوٗکن ہُنٛد اکھ ہجوم چُھ تکیازِ ناصرت شہرک یسوعؔ چُھ گلی منٛزؠ پکان۔"
\v 38 تٔمؠ دِژ کرٛکھ، "یسوعؔ ژٕ چُھکھ بادشاہ داوود سنٛزِ ذرؠ یٲژ منٛزٕ، مےٚ پؠٹھ کرِ رحم!"
\v 39 یِم ہجومس برونٛٹھ برونٛٹھ پکان ٲسؠ تِمو کٔر تمِس بےیزتی تہٕ ونہس ژھۅپہٕ کرِتھ روز۔ مگر تٔمؠ دِژٕ تمہِ کھۅتہٕ پہن زورٕ کریکہٕ "ژٕ چُھکھ بادشاہ داوود سنٛزِ ذرؠ یٲژ منٛزٕ، مےٚ پؠٹھ کر رحم!"
\v 40 یسوعؔن کوٚڑ ٹھہراو تہٕ لوٗکن کوٚرن حکم زِ سُہ شخص انؠ ووٚن مےٚ نِش۔ ییٚلہِ سُہ اوٚن شخص یسوعؔ ہس نزدیک آو، یسوعؔن پرُوژھ تس،
\v 41 ژٕ کیاہ چُھکھ یژھان بہٕ کرٕ چانہِ باپتھ؟" تٔمؠ دِتسُ جوابِ" خداوندٕ، بہٕ چُھس یژھان زِ مےٚ گژھِ أچھن گاش یُن!"
\v 42 یسوعؔن ووٚن تمِس، "وُنؠ انَے بہٕ ژٕ گاش واپس! تکیازِ ژٕ اوٚنتھ مےٚ پؠٹھ ایمان، مےٚ بخش ژٕ شفا!"
\v 43 ؤلؠ ؤلؠ آو تسَ گاش۔ سُہ دراو یسوعسؔ سٟتؠ خدایس تعریف کران۔ ییٚلہِ تتہِ تِمو ساروےٕ لوٗکو یہِ وُچھ، تِمو تہِ کٔرؠ خدایہِ سٕنٛدؠ تعریف۔
\c 19
\p
\v 1 یسوعؔ اوس یرِیحُو أژتھ شہرٕ منٛز گژھان۔
\v 2 تتہِ اوس زکایٔی ناوک اکھ نفر۔ سُہ اوس محصول جمع کرن والیٚن زیُٹھ تہٕ سُہ اوس سیٹھاہ امیر۔
\v 3 سُہ اوس یسوعؔ ہس وچُھن یژھان، مگر تٔمؠ ہیٚوٗک نہٕ سُہ لُکہٕ ارساتہٕ کِنؠ وُچِھتھ۔ سُہ اوس اکھ ژھوٚٹ نفر بیٚیہِ ٲسؠ یسوعؔ ہس انٛدؠ انٛدؠ واریاہ لوٗکھ۔
\v 4 لہٰذا تٔمؠ تُج وتہِ برونٛہہ کنُ دور۔ سُہ کھوٚت أکِس گُولر کُلس پؠٹھ یُتھ زن سُہ یسوعؔ ہس ہیٚکہ ہیے وُچِھتھ ییٚلہِ سُہ وتہِ نیرِ ہیے۔
\v 5 ییٚلہِ یسوعؔ تتھ جایہِ ووت، تٔمؠ وُچھ ہیٚور کنُ تہٕ تمِس ووٚننُ، "زکایٔی ؤلؠ ؤلؠ وس بوٗن، مےٚ چُھ از راتس چانہِ گرِ روٗزن!"
\v 6 لہٰذا سُہ ووٚتھ ؤلؠ ؤلؠ بوٗن۔ تٔمؠ کٔر یسوعؔ ہس پننِؠس گرس منٛز خوشی سان خوش آوے۔
\v 7 پوٚز یِمو لوٗکو یسوعؔ توٚت گژھان وُچھ تِمو تُل شور، یہِ ونان، "سُہ گوٚو مہمان بنتھ اصلی گناہگارٕ سنٛدِس گرس منٛز!"
\v 8 \f + \fr 19‏:8 \ft خروج 22:1\f*پتہٕ سُپد زکایٔی کھڑا ییٚلہ تِم کھیٚوان ٲسؠ تہٕ یسوعؔ ہس ووٚننُ، "خداوندٕ، بہٕ چُھس یژھان زِ بہٕ چُھس پننہِ مالہ منٛز نٮ۪صف غریب لوٗکن دِنہٕ وول۔ یۅتام زنہٕ تِمن لوٗکن ہُنٛد تعلق چُھ یِمن میانہِ ذریعہ دونٛکھٕ لوٚگمُت چُھ، بہٕ دِمہٕ تِمن تمہِ رقمکُ ژوٚگنہٕ یہِ مےٚ تِمن نِشہ نِمُت آسہِ۔"
\v 9 یسوعؔ ہن ووٚن تمِس، "از بچوو خداین یہِ گرٕ، تکیازِ یمؠ نفرن ہوو زِ یہِ چُھ ابرہامؔ سُنٛد اصلی نیٚچو۔
\v 10 یہِ تھاو یاد: بہٕ  آدمؔ سُنٛد گۅبُر آس ژھانٛڈنہِ تہٕ بچاونہِ ژےٚ ہیٚوؠ لوٗکھ یِم خدایس نافرمٲنی کران ٲمتؠ چھِ۔"
\v 11 لوٗکھ ٲسؠ تہِ سورےٕ بوزان یہِ یسوعؔن ووٚن۔ سُہ اوس یروشلم نکھٕ لوٗگمُت واتٕنہِ، تہٕ سُہ اوس زانان زِ لوٗکن اوس اکھ غلط خیال۔ تِمو اوس سونچمُت زِ یتھے سُہ یروشلم واتہِ سُہ کرِ خدایہِ سنٛدین لوٗکن پؠٹھ بادشاہ سٕنٛدِ رنگؠ حکمرٲنی شروع۔ سُہ خیال درست کرنہٕ خٲطرٕ نیٚو یسوعؔن فٲصلہٕ زِ سُہ وُنہِ تِمن بیٛاکھ اکھ دلیل۔
\v 12 تٔمؠ ووٚن، "اکھ شہزادٕ اوس أکِس دوٗر دراز ملکس کنُ گژھِنچؠ تیٲری کران یُتھ زن اکھ تھوٚد بادشاہ تمِس یہِ حق دِہے زِ سُہ کرِ تتھ پؠٹھ حکمرٲنی تتہِ پؠٹھٕ یتہِ سُہ روٗزان اوس۔ تہِ حٲصل کٔریتھ، واتہِ ہے سُہ پننؠن لوٗکن پؠٹھ حکومت کرنہٕ خٲطرٕ واپس۔
\v 13 نیرنہٕ برونٛہہ، أنؠ تٔمؠ پنٕنؠ دہ خدمت گار ناد دِتھ۔ تٔمؠ دِیتؠ تِمو منٛزٕ پرٛتھ أکِس برابر پونٛسہٕ ہنٛز رقم۔ تٔمؠ ووٚن تِمن، "اتھ کٔرؠ زؠو تجارت یوٚت تام بہٕ واپس یِمہٕ!" پتہٕ دراو سُہ۔
\v 14 پوٚز تمِس ٲسؠ پننہِ وطنٕکہ واریاہ لوٗکھ نفرت کران۔ لہٰذا سوز تِمو شیٚچھِ نِنہٕ وٲلؠ تمِس پتے تمِس بٔڈِس بادشاہس یہِ وُنہٕ خٲطرٕ زِ ٲسؠ چھِنہٕ یژھان یہِ شخص کرِ اسہِ پؠٹھٕ بادشٲہی!
\v 15 پوٚز سُہ آو کُنہِ تہِ پٲٹھؠ بادشاہ بناونہٕ۔ پتہٕ آو سُہ نٔوس بادشاہ سٕنٛدؠ رنگؠ واپس۔ پتہٕ سوٗزن تِمن خدمت گارن ناد یِمن تٔمؠ پونٛسہٕ اوس دِتؠ متؠ۔ سُہ اوس یژھان زاننُ زِ تِمو کوتاہ نفع زیون تتھ پوٗنٛسس یُس تٔمؠ تِمن دِتُمُت اوس۔
\v 16 گوٗڈنک خدمت گار ووت تسَ نِشہ تہٕ ووٚننُ، "جناب، چٲنہِ پونٛسہٕ سٟتؠ زیوٗن مےٚ تمیٛک دہ گنہٕ یہِ مےٚ اوس!"
\v 17 مٲلکن ووٚنُس، "ژٕ چُھکھ اکھس سٮ۪ٹھا  رُت نوکر!  ژٕ کوٚرمُت چُھتھ بڈٕ اصل! تکیازِ ژٕ چُھتھ پوٗنٛسن ہُنٛد أکِس لوکٹس رقمس دیانت دٲری سان خیال تھوومُت، بہٕ چُھسے ژےٚ دہن شہرن پؠٹھ حکومت کرنُک اختیار دِوان۔"
\v 18 پتہٕ ووت دوٚیم خدمت گار تہٕ ووٚننُ، "جناب، یُس پونٛسہٕ ژےٚ مےٚ دِیتُمُت اوسُتھ وُنؠ چُھ سُہ تمیٛک پانٛژھ گنہٕ!
\v 19 تٔمؠ ووٚن تمِس خدمت گارس تہِ، "اصل کوٚڑُتھ! بہٕ تھوُتھ ژٕ پانٛژن شہرن پؠٹھہٕ۔"
\v 20 پتہٕ آو بیٛاکھ خدمت گار۔ تٔمؠ ووٚن، "جناب، یہِ چُھ چون پونٛسہٕ۔ مےٚ تھووٚ یہِ أکِس دٔجہ گُنڈتھ تہٕ ژورِ تھَوُیم حفاظٕتس منٛز۔
\v 21 مےٚ اوس وسواس زِ ژٕ نِکھ تہِ سورےٕ یہِ بہٕ کماوٕ۔ مےٚ چھِ خبر زِ ژٕ چُھکھ اکھ سَخت شخص یُس بیؠن ہنٛدؠ تِم چیز نِوان چُھ یِم نہٕ اصلی چٲنؠ چھِیی۔ ژٕ چُھکھ تمِس أکِس گریسؠ سٕنٛدؠ پٲٹھؠ یُس سُہ فصٕل لونان چُھ یُس بدل کانٛسہِ گریسؠ درٛینٹُھمت چُھ۔"
\v 22 تٔمؠ ووٚن تمِس خدمت گارس، "بدبخت خدمت گارٕ! بہٕ کرٕ تِمن چٲنین کتھن ملامت یمہٕ ژےٚ وُنؠ ووٚنتھ۔ ژٕ ووٚنتھ زِ بہٕ چُھس اکھ سَخت شخص۔ ژےٚ ونِتھ بہٕ چُھس تہِ نِوان یمیُک نہٕ بہٕ مٲلکھۓ چُھس۔ ژےٚ ووٚنتھ زِ بہٕ چُھس تمِس گریستِس ہیو یُس تہِ چُھ لونان یہِ بدل کٲنٛسہِ گریسؠ درٛینٹٔھمت چُھ۔
\v 23 توتہِ پزِہی ژےٚ سُہ میٚون پونٛسہٕ سوٗدرس نِشہ تھوُن! ییٚلہِ بہٕ واپس یِمہٕ ہا پتہٕ کرہا بہٕ تسَ نِشہ پنُن پونٛسہٕ سوٗد ہٮ۪تھ حٲصٕل یہِ تتھ کھوٗتمُت آسہ ہے!
\v 24 تٔمؠ بادشاہن ووٚن پتہٕ تِمن خدمت گارن یِم تسَ نکھۓ اِستادٕ ٲسؠ، "نیو یِم پونٛسہٕ أمِس نِشہ تہٕ دِیو تمِس خدمت گارس یمؠ تمہِ کھۅتہٕ دہ گنہٕ بنوو!
\v 25 تِمو کوٚر احتِجاج، "مگر جناب، تمِس نِشہ چُھ برٛونٹھے واریاہ پونٛسہٕ!
\v 26 مگر بادشاہن ووٚن، "یہِ چُھسو توٚہہِ بہٕ ونان: لوٗکھ یِم اصل پٲٹھؠ تہِ استعمال کرن یہِ تِمو رُٹ، بہِ دِمہٕ تِمن تمہِ کھوٗتہٕ تہِ زیادٕ۔ مگر تِم لوٗکھ یِم نہٕ تہِ اصل پٲٹھؠ استعمال کرن یہِ تِمو رُٹ، بہٕ نمہٕ تِمن سٔہن تہِ یہِ تِمن نِشہ برٛونٹھے چُھ۔
\v 27 وُنؠ، یوٚت تام زنہٕ میانین تِمن دشمنن ہُنٛد سوال چُھ یِم میٲنؠ بادشٲہی یژھان چُھنہٕ، تِم أنووکھ مےٚ نِشہ تہٕ کریوٗکھ تِم قتل ییٚلہِ بہٕ وُچھان روٗزٕ!"
\v 28 یِمہٕ کتھٕ وننہٕ پتہٕ کوٚر یسوعؔن یروشلمسؔ تام وتہِ پؠٹھ زیوٹھ سفر۔
\v 29 ییٚلہِ تِم زیتون بالس نکھٕ بیت فگےؔ تہٕ بیت عنیاہ گامن نزدیک ووت، تٔمؠ سوزؠ پنٕنؠ زٕ شٲگرد برونٛٹھ۔
\v 30 تٔمؠ ووٚن تِمن، "توٚہؠ برونٛٹھٕ کنہِ یُس گام چُھ تتھ منٛز گژھو۔ یتھیۓ توٚہؠ توٚت أژیو، توٚہؠ وُچھو تتہِ اکھ خٔرؠ بچہ گٔنڈتھ یمِس پؠٹھ زانٛہہ تہِ کٲنٛسہِ اکؠ تہِ سوٲرؠ کٔرمٕژ چھِ۔ سُہ مُژرٲوُن تہٕ أنؠ ووٚن مےٚ نِشہ۔
\v 31 ہرگاہ توٚہہِ کانٛہہ پرِٛژھِ، "توٚہؠ کیازِ چُھو سُہ خٔر مُژراوان؟ تمِس وُنِیو، "یہِ چُھ یسوعؔ ہس ضرورت۔"
\v 32 أتی گییہِ تِم زٕ شٲگرد تتھ گامس منٛز تہٕ لُوبکھ سُہ خٔر، تِتھے پٲٹھؠ یتٕھ پٲٹھؠ تِمن یسوعؔن تِمن ووٚنمُت اوس۔
\v 33 ییٚلہِ تِم سُہ مُژراوان ٲسؠ، تٔمؠ سٕنٛدؠ مٲلکو ووٚن تِمن، "توٚہؠ کیازِ چُھون سون خٔر مُژراوان؟"
\v 34 تِمو دِیتُ جواب، "یہِ چُھ یسوعؔ ہس ضرورت۔ "تہٕ مٲلکو دِیتُ تِمن سُہ استعمال کرنُک اجازت۔
\v 35 پتہٕ اوٚن تِمو سُہ خٔر یسوعسؔ نِشہ۔ پنٕنؠ جامہٕ ترٛاوِکھ تمِس خٔرس شانن پؠٹھٕ تہٕ یسوعسؔ کوٚرکھ تمِس پؠٹھ کھٲلنس منٛز مدد۔
\v 36 \f + \fr 19‏:36 \ft باشاہ 2۔ 9:13\f* پتہٕ ییٚلہِ سُہ گژھان اوس، باقیو وتھرٲیہِ پنٕنؠ پلو وتہِ پؠٹھ برونٛٹھ برونٛٹھ تمِس احترام کرنہٕ خٲطرٕ۔
\v 37 \f + \fr 19‏:37 \ft ذکریاہ 9:9\f*ییٚلہِ یسوعؔ تتھ وتہِ ہنٛزِ وُترایہِ نِشہ ووت یس زیتون پہاڑٕ پؠٹھٕ بوٗن کُن وسان چھِ، تسنٛدؠ شاگردو ہُنٛدؠ ہجومن لاگہ زورٕ سان خدایہِ سٕنٛدؠ تعریف کرٕنؠ، خوشی منٛز دِژکھ کریکہٕ تِمن سارنےٕ بٔڈن معجزن متعلق یِم تِمو سُہ کران وُچھمُت اوس۔
\v 38 تِم ٲسؠ یتھٕ پٲٹھؠ ونان، "بختہٕ بوٗڈ چُھ سون بادشاہ یُس خدایہِ سُنٛد اختیار سٟتؠ یوان چُھ! آسمانس پؠٹھ روٗزن سلامتی خدایس تہٕ تہنٛدین اسہِ لوٗکن درمیان، تہٕ پرٛیتھ اکھ روٗزن خدایہِ سٕنٛدؠ تعریف کران!"
\v 39 کینٛژو فریسیو ووٚن تمِس یِم تتھ ہجومس منٛز ٲسؠ، "ووستاد، پننؠن شٲگردن ووٚن زِ یمہٕ کِتھہٕ مہَ ونیٚو!"
\v 40 تٔمؠ دِیتُ جواب، "بہٕ چُھسو توٚہہِ یہِ ونن: ہرگاہ یِم لوٗکھ ژھوپہٕ کٔریتھ روٗزن، کنہِ دِین پانے میٲنؠ تعریف کرنہٕ خٲطرٕ کریکہٕ!"
\v 41 ییٚلہِ یسوعؔ یروشلمسؔ نکھٕ ووت تہٕ وُچُھن سُہ شہر، تٔمؠ دِژ تتہِ کؠن لوٗکن باپتھ کریکھ۔
\v 42 \f + \fr 19‏:42 \ft تثنِیہ شرع 32:29، یسعیاہؔ 6:9۔ 10\f* تٔمؠ ووٚن، "کاش یِمی دوٚہہ آسہ ہے توٚہہِ لوٗکو زانومُت زِ خدایہِ سنٛز سلامتی کیژھ چھِ آسن۔ پوٚز وُنؠ چُھو نہٕ توٚہؠ یہِ زانس قٲبل۔
\v 43 بہٕ چُھس یژھان توٚہؠ زانؠو یہِ: توٚہؠ چُھو مشکِل وقتہٕ منٛزِ گُذرن وٲلؠ۔ تُہنٛدؠ دشمن یِنؠ تہٕ تُہنٛدس شہرس انٛدؠ انٛدؠ لاگن اکھ ٹھوٗر۔ تِم کرن شہرک گیراو پتہٕ کرن ژوپٲرؠ اتھ پؠٹھ حملہٕ۔
\v 44 تِم ژٹن دؠوارن تہٕ تِمن کرن تباہ بیٚیہِ باقیو شہرس۔ تِم مٲرِنیو توٚہؠ سارنےٕ۔ تِم نہناؤن پرٛتھ کانٛہہ چیز مکمل طور۔ یہِ سورےٕ سپدِ تکیازِ توٚہہِ پرزٕنوو نہٕ سُہ وقت ییٚلہِ خدا توٚہہِ بچاونہِ آو!"
\v 45 \f + \fr 19‏:45 \ft یہِ واقہٕ سپد ہیکلکس نیٚبرِمس عدالتس منٛز یتھ غیٖر یہُودینؔ ہنٛز عدالت ونان ٲسؠ۔ \f*یسوعؔ سپد یروشلمسؔ منٛز دٲخٕل تہٕ گوٚو ہیکل کس صحنس منٛز۔ سُہ لوٗگ تِم لوٗکھ نیٚبر کڈن یِم تتہِ چیز کٕنان ٲسؠ۔
\v 46 \f + \fr 19‏:46 \ft یسعیاہؔ 56:7، یرمیاہ 17:11\f*تٔمؠ ووٚن تِمن، "نوشتن منٛز چُھ لیکھتھ" خدایہِ سُنٛد ہیکل گژھِ آسن سۅ جایہ یتہِ لوٗکھ عبادت کرن۔ پوٚز توٚہؠ چُھو یہِ لوٗٹرن ہنٛزٕ چھپَن جاۓ بنٲومٕژ!"
\v 47 تتھ ہفتس دوران اوس یسوعؔ پرٛتھ دوٚہہ ہیکلس منٛز لوٗکن تعلیم دِوان۔ میٖر کاہن، مذہبی شریعتک ووستاد، تہٕ باقیو یہُودؠ سردار ٲسؠ اکھ وتھ ژھارنچہِ کوٗششہٕ منٛز زِ سُہ ییہِ مٲرٕ کرنہٕ۔
\v 48 پوٚز تِمن آیہِ نہٕ کانٛہہ وتھ تہِ کرنس، تکیازِ تٔمؠ سنٛزٕ کتھٕ بوٗزنہٕ خٲطرٕ ٲسؠ واریاہ لوٗکھ بے تاب آسان۔
\c 20
\p
\v 1 تتھ ہفتس دوران اکہ دوٚہہ، یسوعؔ اوس ہیکلس منٛز لوٗکن تعلیم دِوان تہٕ تِمن اوس خدایہِ سنٛز رٕژ خبر بوزٕناوان۔ ییٚلہِ سُہ تہِ کران اوس، میٖرِ کاہن، یہُودؠ شریعتک ووستاد تہٕ باقیو کینٛہہ زِٹھؠ آیہِ تسَ نِشہ۔
\v 2 تِمو ووٚن تسَ، "اسہِ ووٚن، ژےٚ کسُ اختیارٕ چھی یمہِ کامہِ کرنس؟ تہِ ژےٚ کٔم دِتُےٕ یہِ اختیار؟"
\v 3 تٔمؠ دِیتُ جواب، "بہٕ پرٕژھو توٚہہِ اکھ سوال۔ مےٚ ونیٚو
\v 4 یوحناہسؔ متعلق یُس لوٗکن بپتسمہ دِوان اوس: کیاہ خداین اوسا تمِس بپتسمہ دِنُک حکم کوٚرمُت یاہ انسانو اوسا تمِس حکم کوٚرمُت؟"
\v 5 اتھ پؠٹھ کوٚر تِمو پانہٕ وانے بحث۔ تِمو ووٚن، "ہرگاہ ٲسؠ جواب دِمو، تمِس دِیت خداین حکم، پتہٕ وُنہِ سُہ، ادٕ توٚہہِ کیازِ کوٚرو نہٕ تسَ پؠٹھ یقین؟
\v 6 ٲسؠ ہرگاہ ووٚنو، "یِم ٲسؠ صرف انسانےٕ یمو تسَ بپتسمہ دِنُک ووٚن، مگر لوٗکھ کرن اسہِ مٲرین لوٗکھ سنٛگ سار کٔریتھ، تکیازِ تِمن منٛز چُھ اکثرن یقین زِ یوحناؔ اوس اکھ نبی یُس خداین سوٗزمُت اوس۔"
\v 7 لہٰذا تِمو دِیت جواب زِ تِمن چھِنہٕ پتاہ زِ یوحناہسؔ کٔم اوس بپتسمہ دِنُک ونمُت۔
\v 8 پتہ ووٚن یسوعؔن تِمن، "یتھٕ پٲٹھؠ نہٕ توٚہہ مےٚ وُنو، بتہِ ونہٕ ہو نہٕ توٚہہ زِ بہٕ کٔمؠ سوزس یمہٕ کامہِ کرنہٕ باپتھ۔"
\v 9 پتہٕ لُگ یسوعؔ یہِ تمثیٖل وننہِ: "اکؠ نفرن لوگ اکھ دچھِ باغ۔ تٔمؠ دِیت سُہ دچھِ باغ کینٛژن نفرن لاگنُ یِم زن تتھ رٲچھ کرہن۔ پتہٕ گوٚو سُہ بییس مُلکس منٛز یتہِ سُہ واریہس وقتس بیوٗٹھ۔\f + \fr 20‏:9 \ft مرقُس 12‏:1۔ 12، متی 21‏:33۔ 46 \f*
\v 10 ییٚلہِ دچھ والہٕ نُک وقت ووت، تٔمؠ مٲلکن سوز تِمن نفرن نِشہ یِم تتھ دچھِ باغس رٲچھ کران ٲسؠ، اکھ خدمت گار۔ تٔمؠ یوٚژھ تِمن منگُن تِمن دچھِ ہُنٛد پنُن حصہٕ یِم تتھ دچھِ باغس درامٕتؠ ٲسؠ۔ پوٚز ییٚلہِ سُہ خدمت گار تِمن نِشہ ووت، تِمو کوٚر تمِس خدمت گٲرس مٲر تہٕ کوٚرکھ ژھریَو اتھو روانہٕ۔
\v 11 تمہِ پتہٕ سوز تٔمؠ مٲلکن بیٛاکھ خدمت گار، مگر تِمو کوٚر تمِس خدمت گارس تہِ مٲر بیٚیہِ کوٚرکھ بے یزتھ۔ تِمو کوٚر سُہ تہِ دچھو بغٲر یہٕ روانہٕ۔
\v 12 تمہِ پتہ تہِ، سوز تٔمؠ مٲلکن بیٛاکھ خدمت گار۔ تِمو گریستو کوٚر سُہ خدمت گار سیٹھاہ زخمی تہٕ تِمو کوٚر سُہ دچھِ باغہٕ منٛزٕ نیٚبر نیرنس پؠٹھ مجبور۔
\v 13 لہٰذا ووٚن تٔمؠ دچھِ باغہٕ مٲلکن پانس کنُ، "وُنؠ کیاہ پزِ مےٚ کرن؟ بہٕ سوٗزن پنُن نیٚچو، یُس مےٚ سیٹھاہ ٹوٹھ چُھ۔ شایدکرن تِم تمِس احترام۔"
\v 14 لہٰذا سوز تٔمؠ پنُن نیٚچو، پوٚز ییٚلہِ تِمو دچھِ باغ کیٚو باغوانو سُہ یوان وُچھ، تِمو ووٚن اکھ أکِس، سُہ نفر چُھ یہِ یمِس کُنہِ وقتہٕ یہِ دچھِ باغ وراثتس منٛز تٔرِ! ؤلِو أسؠ مٲرٕہن سُہ! پتہٕ بنہِ یہِ دچھِ باغ سون!
\v 15 لہٰذا کۅڈ کوٚڈ سُہ تِمو دچھِ باغہٕ منٛزٕ کھکھرِ نیٚبر، پتہٕ کوٚرکھ سُہ قتل۔ بہٕ ونہٕ ہو توٚہہ زِ سُہ دچھِ باغُک مٲلکھ کیاہ کرِ وۅنؠ تِمن سٟتؠ!
\v 16 سُہ ییہِ تہٕ تِمن نفرن کرِ قتل یِم تتھ باغس رٲچھ ٲسؠ کران۔ پتہٕ کرِ سُہ تتھ رٲچھ کرنہٕ باپتھ بدل نفرن ہُنٛد انتظار۔ "ییٚلہِ تِمو بوزن والیٚو لوٗکو یسوعؔ ہس نِشہ یہِ بوٚز، تِمو ووٚن، "خدایہِ مٕہ کٔرِن یژھ ہِش حالت زانٛہہ!"
\v 17 \f + \fr 20‏:17 \ft زبُور 118:22۔ 23\f*پوٚز یسوعنؔ دِژ تِمن کنُ سیٚود نظر تہٕ ووٚننُ، "توٚہؠ ہیکیو تہِ ووٚنتھ، پوٚز توٚہؠ سونٛچو یِمن الفاظن ہنٛدس مطلبس کنُ یِم نوشتن منٛز لیکھتھ چھِ۔ یۅسہ کٔنؠ مکانہٕ تعمیٖر کرن وٲلؠ ترٲوتھ ژٕھنؠ سۅۓ بنییہِ تٔتھؠ مکانس منٛز اکھ واریاہ زیادٕ اہم کٔنؠ۔
\v 18 یہِ\f + \fr 20‏:18 \ft دانیال 2:34۔ 35\f* کٔنؠ کرِ تَس ٹُکرٕ یُس اتھ پٮ۪ٹھ پیٚیہِ تہٕ کرِ تس سوٗر یِس یہِ پٮ۪ٹھ پیٚیہِ۔"
\v 19 تِمن میٖرِ کاہنن تہٕ یہُودؠ شریعتہٕ کین ووستادن گوٚو احساس زِ سُہ اوس تِمن الزام دِوان ییٚلہِ تٔمؠ تِمن سُہ بدکار لوٗکن متعلق تمثیٖل ووٚن۔ لہٰذا تِمو کٔر سۅ اکھ وتھ ؤلؠ ؤلؠ تلاش کرنچؠ کوٗشش یُتھ زن تِم تمِس گرفتار کرہن۔ مگر تِمو کوٚر نہٕ سُہ گرفتار، تکیازِ تِم ٲسؠ کھۅژان لوٗکھ کیاہ کرن ہرگاہ تِمو تہِ کوٚر۔
\v 20 لہٰذا تِم روٗدؠ تمِس ہُشیٲری سان نظرِ۔ تِمو سوٗزؠ بیٚیہِ یسوعؔ ہس نِشہ پٔزؠ یٲرؠ لٲگتھ جاسوٗس کتھ کرنہٕ باپتھ مگر تِم ٲسؠ اصلی یژھان یسوعؔ کرِ کانٛہہ غلط کتھ۔ تِم ٲسؠ یژھان تمِس رومی حکومتس خلاف بغاوتس حوصلہٕ افزٲئی کرنُک الزام دِین یُتھ زن تمِس تمہِ صوبہٕ کس گورنرس حوالہٕ کرہن۔
\v 21 تِمو منٛزٕ ووٚن اکی تمِس، "ووستادٕ، أسؠ چھِ زانان زِ چون کلام تہٕ تعلیم چھےٚ پٔز۔ ژٕ چُھکھ توتہِ کران ہرگاہ بزرگ لوٗکھ چھِنہٕ تہِ پسند کران۔ ژٕ چُھکھ تہِ ایماندٲری سان ہیٚچھناوان یہِ خدایہِ اسہِ کرُن یژھان چُھ۔
\v 22 لہٰذا توٚہؠ ونیٚو اسہِ زِ توٚہؠ کیاہ چُھو یتھ معاملس متعلق ونان۔ اسہِ چھا رومی سرکارس محصول دیُن جٲیز کِنہٕ نہٕ؟"
\v 23 پوٚز تمِس توٚر فِکرِ زِ تِم ٲسؠ تمِس تکلیفس منٛز پھساوِنچؠ کوٗشش کران تِمن یہُودینؔ سٟتؠ یِم محصول برنس خلاف ٲسؠ، یاہ رومی سرکارس سٟتؠ۔ لہٰذا تٔمؠ ووٚن تِمن،
\v 24 "مےٚ ہاو اکھ رومی سکہٕ۔ پتہٕ وُنیو مےٚ تتھ پؠٹھ کٔمؠ سنٛز شکل تہٕ ناو چھِ۔ "لہٰذا ہاوٕ تمِس اکھ رومی سکہٕ تہٕ ونُکھ، "اتھ چھِ شٕکل بیٚیہِ قیصرؔ سُنٛد ناو۔"
\v 25 تٔمؠ ووٚن تِمن، "اتھ معاملس، یہِ سرکارُک چُھ تہِ دِیو سرکارس، تہٕ یہِ خدایہِ سُنٛد چُھ تہِ دِیو تمِس۔"
\v 26 تِمو جاسوٗسو ہیوٗک نہٕ تمِس نِشہ کینٛہہ تہِ غلط لٔبتھ یہِ یسوعؔن ووٚن ییٚلہِ لوٗکھ تمِس انٛدؠ انٛدؠ اِستادٕ ٲسؠ۔ تِم جاسوٗس گییہِ تسٕنٛدِ جوابہٕ سٟتؠ سیٹھاہ حٲران زِ تِمو گییہِ ژھوٚپہٕ۔
\v 27 تمہِ پتہٕ ووت یسوعؔ ہس نِشہ کینٛہہ صدوقی۔ تِہنٛزِ یہُودؠ جماعت ہُنٛد ووٚننُ اوس زِ مٔرؠ مٔیتو منٛزٕ سپدِ نہٕ کانٛہہ اکھ تہِ زندٕ۔ تِہنٛد اِرادٕ اوس یہِ تہِ زِ تِم پرٛژہن یسوعؔ ہس اکھ داوہ کرن وول سوال۔
\v 28 \f + \fr 20‏:28 \ft پیدٲیش 38:8، تژنہِ شرع 25:5\f*تِمو منٛزٕ ووٚن اکی تمِس، "ووستادٕ، أسؠ یہُودؠ چھِ موسیٰؔ ہن ہیٚچھٕ نٲومٕتؠ کیاہ چُھ کرُن ہرگاہ اکھ مہنیٚو زنان ٲسِتھ مَرِ شُرؠ مُرِ ورٲے۔ تسنٛدس بٲیس پزِ تمِس مۅنٛڈِ سٟتؠ خاندر کرُن یُتھ زن تمِس زنانہِ تسنٛد اکھ اولاد ہیٚکہ زیٚتھ۔ لوٗکھ مانن پتہٕ تمِس شُرس تمِس مودمتِس مہنیوؠ سنٛز زُرؠ یاتھ۔
\v 29 خٲر، أکِس گرس منٛز ٲسؠ ستتھ بٲے۔ زِٹھؠ اکہ کوٚر أکِس زنانہِ سٟتؠ خاندر، مگر سُہ مود شُرِ ورٲے پتھ کنُ روزِ اکھ مۅنٛڈ زنان۔
\v 30 یمہِ شریعتہٕ مطٲبق کوٚر دوٚیم بٲے تمِس مۅنٛڈِ سٟتؠ خاندر، مگر تمِس سٟتؠ تہِ سُپد امی قسمُک واقہٕ۔
\v 31 پتہٕ کوٚر ترٛیِم بٲے تمِس زنانہِ سٟتؠ خاندر، مگر تمِس سٟتؠ تہِ سُپد دُبارٕ امی قسمُک واقہٕ۔ ٲخٕرس پؠٹھ کوٚر تِمو ساروےٕ بایو تسَ زنانہِ سٟتؠ اکہ اکہ خاندر مگر تِم سٲری مودؠ شُرِ ورٲے۔
\v 32 تمہِ پتہٕ موٗۓ سۅ زنان تہِ۔
\v 33 تمہِ کِنؠ، ہرگاہ یہِ چُھ پوٚز زِ اکھ وقت آسہ ییٚلہِ زن تِم لوٗکھ سُپدن دُبارٕ زندٕ یِم مودمٕتؠ آسن، ژٕ کیاہ چُھکھ سونچان زِ سۅ زنان کس سنٛز عاشنؠ آسہ پتہٕ؟ یہِ تھوٗ ذہنس منٛز زِ تمہِ زنانہِ اوس سارنےٕ سَتن بٲرنؠن سٟتؠ خاندر کوٚرمُت!
\v 34 یسوعؔن دِیتُ تِمن جواب، "یتھ دنیاہس منٛز چھِ مہنیوؠ زنانن سٟتؠ خاندر کران، مول موج چُھ کوٗرین مہنیوین خاندرس پؠٹھ دِوان۔
\v 35 پوٚز یِمن لوٗکن خدایہِ آسمانس پؠٹھ زندٕ کرنس لایق مانہِ ییٚلہ تِمن سُہ مرنہٕ پتہٕ زندگی منٛز واپس انہِ تِم کرن نہٕ خاندر۔
\v 36 تِم چھِنہٕ خاندر کران تکیازِ تِم ہیکن نہٕ وُنؠ مَرِتھ۔ اوٕ کِنؠ آسن تِم فرشتن ہُنٛدؠ پٲٹھؠ یِمن ابدی زندگی چھِ۔ تِم چھِ خدایہِ سٕنٛدؠ شُرؠ، چونکہِ تِم چھِ خداین مَرنہٕ پتہٕ دُبارٕ زندٕ کٔرمٕتؠ۔
\v 37 \f + \fr 20‏:37 \ft خروج 3:2، 6\f* وُنؠ دِیتُ مےٚ خاندرس متعلق تُہنٛدس سوالس جواب، بہٕ ہاوٕ نوشتو منٛزٕ زِ خدایہِ چُھ لوٗکن مرَ نہٕ پتہٕ تِمن دُبارٕ زندٕ کرنَ۔ ییٚلہِ زنہٕ موسیٰؔ ہن تہِ اتھ متعلق لیوکھ۔ تتھ جایہِ یتؠن سُہ خدایس سمکھنٕچ ذِکر کٔنڈؠ دۅپھ دزان کرن چُھ، سُہ چُھ درج کران زِ خدوندن کٔتھٕ پٲٹھؠ ووٚن پانس، ابرہامؔ سُنٛد خدا تہٕ اضحاقؔ سُنٛد خدا بیٚیہِ یعقوبؔ سُنٛد خدا۔ خداین آسہ ہے نہٕ تہِ ووٚنمُت ہرگاہ تٔمؠ تِم شخص دُبارٕ زندٕ آسہ ہن نہٕ کرِمتؠ تہٕ سُہ آسہ ہے نہٕ وُنہِ تِہنٛد خدایہِ۔
\v 38 بہرحال، سُہ چُھنہٕ تِمن لوٗکن ہُنٛد خدا یِم مودمٕتؠ چھِ۔ سُہ چُھ زندٕ لوٗکن ہُنٛد خدا، تکیازِ خدایس نِشہ چُھ پرٛیتھ اکھ زندٕ روٗزان اگر تِم مودمٕتؠ تہِ آسن۔"
\v 39 تتہِ موجود کینٛژو یہُودؠ شریعتکیو ووستادو دِیتُ جواب، "ووستادٕ، ژےٚ دِتھ اصل پٲٹھؠ جواب۔"
\v 40 یہِ ووٚن کٲتبو تکیازِ یِم لوٗکھ یسوعؔ ہس پھساونچؠ کوٗشش ٲسؠ کٔرمٕژ تِمو کٔرؠ تمِس مشٕکل سوال پرٛژھنؠ بنٛد۔ تٔمؠ ٲسؠ اصل پٲٹھؠ تِمن جواب دِیتِمُت زِ تِم ٲسؠ کھۅژان تسَ بیٚیہِ کانٛہہ سوال پرٛژھنس۔
\v 41 لہٰذا یسوعؔن پرُوژھ تِمن واپس پنُن اکھ مشکٕل سوال۔ تٔمؠ ووٚن، "لوٗکھ کیازِ چھِ ونان زِ مسیحؔ چُھ صرف بادشاہ داوود سُنٛد اکھ اولاد؟
\v 42 مٲنیٚو زِ داوودنؔ لیوکھ پانہٕ مزامیرچہ کتابہٕ منٛز مسیحؔ ہس متعلق، خداین ووٚن میٲنس خداوندس، "بیٚہہ مےٚ لرِ دٔچِھنؠ کِنؠ تھدِس احترامہٕ کس حٲلتس منٛز۔
\v 43 \f + \fr 20‏:43 \ft زبُور 110:1\f*یتؠن بیٚہہ توٚت تام یۅتام بہٕ چانیٚن دشمنن پوٗرٕ پٲٹھؠ شِکس دِمہٕ۔"
\v 44 مزامیرن منٛز چُھ بادشاہ داوود مسیحؔ ہس "میٚون خداوند" ونان۔ تہِ چُھ تھدِ احترامُک اکھ رۅتبہٕ۔ لہٰذا مسیحؔ کٔتھٕ پٲٹھؠ ہیٚکہ ٲسِتھ داوودؔ سُنٛد اولاد؟ یہِ چُھ اولادےٕ یمِس پننِس جدس شوٚبہِ سیٹھاہ احترام کرُن۔"
\v 45 پتہٕ ییٚلہِ تِم سٲری لوٗکھ ٲسؠ بوزان، یسوعؔن ووٚن پننؠن شٲگردن،
\v 46 "بھروسہٕ دِیو زِ توٚہؠ کریو نہٕ تِمن شخصن ہُنٛدؠ پٲٹھؠ عمل یِم سٲنؠ یہُودؠ شریعت ہیٚچھناون چھِ۔ تِم چھِ زیٹھؠ جامہٕ لاگنؠ پسند کران تہٕ اورٕ یور پھیران لوٗکن یہِ ہاون زِ تِم چھِ واریاہ اہم۔ تِم چھِ بیٚیہِ یہِ تہِ پسند کران زِ لوٗکھ کرن تِمن بازرن منٛز بڈٕ احترامہٕ سان سلام۔ تِم چھِ ہیکل لن منٛز سیٹھاہ اہم جاین پؠٹھ بِہنُ پسند کران۔ شامہٕ کس سالس منٛز چھِ تِم تِمن جاین بِہان یمہٕ جایہِ تھَوٗد احترام والیٚن لوٗکن ہُنٛدِ خٲطرٕ آسان چِھے۔
\v 47 تِم چھِ بیٚیہِ مۅنٛڈن ہُنٛد سورےٕ جایداد ژوٗرِ نِوان۔ مگر تِم چھِ لوٗکن ہاون زِ تِم چھِ راست بٲز، تِم چھِ عوامس منٛز زیادٕ کالس عبادت کران۔ خدایہِ دییہِ تِمن سختی سان تمیٛکُ سزا یہِ تِمو کوٚرمُت چُھ۔"
\c 21
\p
\v 1 یسوعؔ یتؠن بہتھ اوس، تٔمؠ دِژ تیتہِ پٮ۪ٹھٕ ہیٚور کنُ نظر تہٕ تٔمؠ وُچھ امیر لوٗکھ ٲسؠ پنٕنؠ نیاز ہیکل کس آنٛگنس منٛز نزرانہٕ پیٹؠن منٛز تراوان۔
\v 2 تٔمؠ وُچھ بیٚیہِ اکھ غریب مۅنٛڈ ترٛاوِ زٕ لوکٹؠ سِکہٕ أکِس پیٹہِ منٛز۔
\v 3 تہٕ تٔمؠ ووٚن پننؠن شٲگردن، "پوٚز چُھ یہِ زِ یمہِ غریٖب مۅنٛڈِ ترٛوو یِمو ساروےٕ امیرن ہُنٛدِ کھۅتہٕ زیادٕ نیاز، نزرانہٕ پیٹہِ منٛز۔
\v 4 بہٕ ونہٕ ہو توٚہہِ تہِ کیازِ چُھ پوٚز۔ یِمن ساروےٕ امیر لوٗکو دِیتؠ سیٹھاہ پونٛسہٕ، پوٚز یِم ٲسؠ تِمن علاوٕ پونٛسہٕ یِم تِمن اصلی ضرورت ٲسؠ نہٕ۔ پوٚز یمہٕ مۅنٛڈِ، یِس سیٹھاہ غریٖب چھِ، دِیت تہِ سورےٕ یہِ تسَ نِشہ اوس، اگرچہ تمِس زندگی بسر کرنہٕ خٲطرٕ پٔزؠ پٲٹھؠ ضرورت اوس۔"
\v 5 یسوعؔ سنٛدؠ کینٛہہ شٲگرد ٲسؠ ہیکل لس متعلق کتھٕ کران زِ یہِ کٔتھٕ پٲٹھؠ اوس خوب صورت کٔنیو سٟتؠ سَجاونہٕ بیٚیہِ پٲراونہٕ تِمہِ سٟتؠ آمُت یہِ لوٗکو اتھ دِیتمُت اوس۔ پوٚز یسوعؔن ووٚن تِمن،
\v 6 "بہٕ ونہٕ ہو توٚہہِ زِ وُنؠ کیاہ چُھ یِمن چیزن سپدن وول یِمن توٚہؠ تعریف کران چُھو۔ کُنہِ دوٚہہ کرن تُہنٛدؠ دشمن یِمن مکمل تباہ۔"
\v 7 تِمو ووٚن تسَ پتہٕ، "ووستادٕ، یہِ کرِ سپدِ؟ تہٕ ییٚلہِ یِم چیز سپدن امِکؠ کیاہ آثار آسن؟"
\v 8 \f + \fr 21‏:8 \ft یوحناؔ 4:1، مرقُس 13:21۔ 23\f*یسوعؔن دِیتُ جواب، "کانٛہہ گژھِ نہٕ توٚہہِ بہکاون۔ واریاہ لوٗکھ یِن تہٕ پرٛیتھ کانٛہہ کرِ میٚون دعوا۔ پرٛیتھ اکھ وُنہِ پانس متعلق، "بہٕ چُھس مسیحؔ!" تِم ونن یہِ تہِ، سُہ وقت لوٗگ واتنہِ ییٚلہِ خدٲیی بادشٲہی ییہِ!" تتھ پؠٹھ کرِزیو نہٕ یقین یہِ تِم ونان آسن!
\v 9 توٚہؠ بوزیٚو بیٚیہِ جنٛگن متعلق تہٕ لوٗکھ کرن اکھ أکِس سٟتؠ لڑایہ۔ یتھؠ ہیوؠ واقات سپدن ضرور توٚت تام یوٚت تام دُنیا انٛد واتہِ۔ لہٰذا ییٚلہِ توٚہؠ تِمن واقاتن متعلق بوٗزو، کھوٚژن گژھِ نہٕ۔
\v 10 \f + \fr 21‏:10 \ft توٲریخ 2۔ 15:5۔ 6، یسعیاہؔ 19:2\f*لوٗکن ہنٛزٕ واریاہ جمٲژٕ لڑن اکھ أکِس سٟتؠ، تہٕ اکھ بادشٲہی کرِ بییٚس بادشٲہی پؠٹھ حملہٕ۔
\v 11 واریاہ جایِن یِن پتہٕ بٔڈؠ بٔڈؠ بِنیٚلؠ۔ بیٚیہِ وتھن درٛاگ تہٕ خطرناک بیمارِ۔ واریاہ چیز سپدن یِمو سٟتؠ لوٗکھ زبردس کھوٚژن۔ لوٗکھ وچُھن آسمانس پؠٹھ عجیب چیز سپدان یِم ہاون زِ کینٛہہ سیٹھاہ اہم چُھ سپدن وول۔
\v 12 پوٚز یِم سٲری چیز سپدنہٕ برونٛٹھ، تُہنٛدؠ دشمن رَٹن توٚہہِ تہٕ توٚہہِ سٟتؠ کرن بد سلوکی۔ تِم أنِن توٚہہِ ہیکل لس نِشہ، تِہنٛدؠ جج لاگن تُہنٛدؠ مُکدِمہٕ بوزٕنؠ تہٕ توٚہہِ برنو قٲد خانن منٛز۔ تُہنٛدین دشمنن آسہ بادشٲہی تہٕ حکومتکہ تھدؠ حٲکم کرن توٚہہِ پؠٹھ مُکدِمہٕ تکیازِ توٚہہِ چُھو مےٚ پؠٹھ ایمان۔
\v 13 تمی وقتہٕ ؤنِو توٚہؠ تِمن مےٚ متعلق پوٚز۔
\v 14 لہٰذا دِل تھٲوِو دٔرؠ وقت ینہٕ برٛونٹھے مٕہ ہییٚو غم زِ توٚہؠ کیاہ ونیٚو پنُن پان بچاونہٕ خٲطرٕ،
\v 15 تکیازِ بہٕ دِمہٕ توٚہہِ سُہ کلام یمہِ سٟتؠ توٚہؠ زانو زِ کیاہ چُھ ووٚننُ۔ نتِجہ نیرِ زِ تُہنٛد کانٛہہ دشمن تہِ ہیٚکہ نہٕ توٚہہِ ووٚنتھ زِ توٚہؠ چُھو غلط۔
\v 16 ہتاکہ تُہنٛد مول تہٕ موج بیٚیہِ بٲے تہٕ بیٚنہِ بیٚیہِ باقیو رشتہٕ دار تہٕ دوس دینو توٚہہِ دغاہ، تہٕ تِم کرن توٚہہِ منٛزٕ کینٛژن قتل۔
\v 17 اکثر لوٗکھ کرن توٚہہِ نفرت تکیازِ توٚہہِ چُھ مےٚ پؠٹھ ایمان۔
\v 18 \f + \fr 21‏:18 \ft متی 10:30، لوقا 12:17\f*پوٚز تُہنٛز سٲرۓ شخصیت روزِ روحٲنی طور محفوظ۔
\v 19 خدایس پؠٹھ بھروسہٕ کرنس پؠٹھ ہرگاہ توٚہہِ مشکلاتو منٛزؠ پییہ گُذرُن، مَرنہٕ پتہٕ روزِ تُہنٛد روح خدایس نِشہ زندٕ۔
\v 20 ییٚلہِ توٚہؠ یروشلم شہرس وُچِھو فوج گیراؤ کران، پتہٕ گژھِ تُہنٛد زاننُ زِ تِم کرن تتھ شہرس دٔستی تباہ۔
\v 21 تمہِ وزِ توٚہہِ منٛز یِم یہُودیہ صوبہٕ منٛز باقین جاین آسن تِم ژٔلنؠ ضرور بالن کنُ۔ توٚہہِ منٛز یِم یتھ شہرس منٛز آسن تِمن چُھ ضرور شہرٕ منٛزٕ نیرُن۔ توٚہہِ منٛز یِم نَکھٕ گامن منٛز آسن تِم مٕہ گژھن تتھ شہرس انٛدر۔
\v 22 \f + \fr 21‏:22 \ft تثنِیہ شرع 32:35، یرمیاہ 46:10\f* توٚہہِ پزِ ژٔلنُ تکیازِ خدا دییہِ تمہِ وزِ یروشلم شہرس سزا۔ ییٚلہِ سُہ تہِ کرِ، یہِ خداین چُھ اتھ متعلق نوشتن منٛز ووٚنمُت زِ یہِ نیرِ پوٚز۔
\v 23 ییٚلہِ یہِ سپدِ تہٕ یہِ کوتاہ خطرناک آسہ تِمن گۅبہِ کھوٚرٕ زنانن ہنٛدِ خٲطرٕ بیٚیہِ تِمن زنانن ہنٛدِ خٲطرٕ یمہٕ پننؠن بچن دۅد آسن دِوان۔ زمیٖنہِ پؠٹھ آسہ بوٗڈ عذاب۔ خدا آسہ تِمن لوٗکن ہنٛز شرارت تہٕ سُہ دییہِ تِمن سختی سان سزا۔
\v 24 \f + \fr 21‏:24 \ft عذرا 9:7، زبُور 79:2، یسعیاہؔ 63:18، یرمیاہ 21:17، دانیال 9:26\f*تِمو منٛزٕ مَریِن واریاہ تکیازِ سِپاہ مٲرن تِمن پننیٚو ہتھیارو سٟتؠ۔ تِہنٛدؠ دشمن نِین باقین قٟدؠن ہنٛدؠ رنگؠ تہٕ تِمن سوزن دُنیا کؠن واریہن جایِن کنُ۔ یروشلم شہرس روزِ غٲر یہُودینؔ ہُنٛد اختیار تیِتس کٲلس ییتِس کٲلس خدا تِمن اجازت دییہِ۔"
\v 25 \f + \fr 21‏:25 \ft زبُور 46:2۔ 3، 65:7، یسعیاہؔ 13:10، 24:19، عذرا 32:7، یوایل 2:30 \f*تمہِ وزِ سپدن افتابس، زوٗنہِ بیٚیہِ تارکن منٛز عجیب حالات۔ زمیٖنہِ پؠٹھ گژھِ قومن منٛز سخ گبھراہٹ پٲدٕ۔ تِم کھوژن توٚت زن تہِ آسن تِم أکِس تتھ گرٛزن وٲلِس سمندرس منٛز یتھ واریاہ بجہِ لہرٕ وتھان آسن۔
\v 26 \f + \fr 21‏:26 \ft احبار 26:36، حجاییٔ 2:6، 21\f*لوٗکن آسہ توٚت خوف زِ تِم سپدن کم ہمت تکیازِ تِم روٗزن اتھ انتظار منٛز زِ دنیاہس منٛز کیاہ سپدِ یمہِ پتہٕ۔ تارکھ ڈٔلنَ آسمانس پؠٹھ پننیٚو اصل جایو نِشہ۔
\v 27 \f + \fr 21‏:27 \ft مُکاشفہ 1:7، دانیال 7:13\f*پتہٕ وچُھن سٲری لوٗکھ مےٚ، اولادِ آدمس، اوٚبرس منٛز طاقتہٕ تہٕ جلالہٕ سان یِوان۔
\v 28 لہٰذا ییٚلہِ تِم خطرناک چیز لٔگن ظٲہر سپدنؠ، کلہٕ تُلوِ تھوٚد، تکیازِ خدایہِ بچاوِ توٚہہِ جلد۔"
\v 29 پتہٕ دِژ یسوعؔن تِمن اکھ مثال۔ تٔمؠ ووٚن، "انجیر کُلین تہٕ بیٚیہِ سارنےٕ کُلین متعلق کٔریو غور۔
\v 30 ییٚلہِ بامنس پنہٕ ؤتھٕر چھِ نیران، توٚہؠ زانیو زِ یہِ چُھ گرمی ہُنٛد موسم شروع سپدان۔
\v 31 یِتھے پٲٹھؠ، ییٚلہِ توٚہؠ یِم چیز وُچھِو یِمن ہنٛز وُنؠ مےٚ سپدنچ وضاحت کٔرؠ، توٚہؠ زٲنِو زِ خدٲیی بادشٲہی چھِ نکھٕ۔
\v 32 بہٕ چُھس توٚہہِ پوٚز ونان۔ تٔمہِ نسلہِ ہنٛدؠ لوٗکھ یِم گوٗڈٕنتھ تِمہٕ نشانہٕ وچُھن یِمن ہنٛز مےٚ وضاحت کٔرؠ، تِم روٗزن کُنہِ تہِ حٲلتس منٛز سٲری چیز سپدنس تام زندٕ۔
\v 33 توٚہؠ سونٛچو زِ آسمان تہٕ زمیٖن چھِ ابدی۔ تِم چھِنہٕ ابدی، پوٚز یہِ مےٚ توٚہہِ ووٚن، چھے ابدی۔
\v 34 ہُشیار روزیٚو پنُن پان تھاوو اختیارس منٛز۔ ہرگاہ توٚہؠ شرابہٕ چیو، پتہٕ روزِ نہٕ تُہنٛد دماغ ہُشار۔ بیٚیہِ ہرگاہ توٚہؠ روزانہٕ معاملاتن ہنٛزِ فِکرِ منٛز روزیٚو، توٚہؠ گٔژھو پاگل۔ پتہٕ دِیو نہٕ توٚہؠ تِمن نشانن متعلق توجہ یِم مےٚ توٚہہِ وُنہِ، تہٕ توٚہؠ روزیٚو بے خبر ییٚلہِ بہٕ واپس واتہٕ۔
\v 35 \f + \fr 21‏:35 \ft مُکاشفہ 3:3، لوقا 12:40\f*بہٕ یِمہٕ اچانک یہِ زنہٕ آسہ اکھ ژَھل ہیو یتھ منٛز اکھ جانور بنٛد چُھ۔ لہٰذا توٚہہِ چھِ میانس یِنس پؠٹھ نظرِ روزنٕچ ضرورت، تکیازِ امیٚک اثر پییٚہِ دنیاہِکس پرٛیتھ أکِس نفرس پؠٹھ۔
\v 36 لہٰذا توٚہہِ چُھ لٲزِمن میٲنہٕ ینہٕ خٲطرٕ ہمیشہ تیار روٗزن۔ دُعا کرِیو زِ توٚہہِ روزِ مےٚ پؠٹھ ایمان ییٚلہِ زنہٕ توٚہہِ تِمو مشکٕل حالاتو منٛزؠ گُذرُن چُھ یِمن متعلق بہٕ کتھ کران روٗدس۔ تمہِ طریقہٕ بہٕ، مسیحؔ، کرٕ اعلان زِ توٚہؠ چُھو معصوم ییٚلہِ بہٕ دنیاہس حساب ہنہٕ خٲطرٕ واتہٕ۔"
\v 37 یسوعؔ اوس پرٛیتھ دوٚہہ ہیکل لس منٛز لوٗکن ہیٚچھِ ناوان۔ پوٚز سُہ اوس روزانہ شامس شہرٕ نیٚبر گژھان تہٕ سٲرۓ رٲتھ اوس زیتون پہاڑس پؠٹھ گُذاران۔
\v 38 تہٕ صبحس سُلے ٲسؠ لوٗکن ہنٛدؠ بٔڈؠ بٔڈؠ ہجوم ہیکل لس منٛز واتان تہٕ تٔمؠ سنٛزٕ کتھٕ ٲسؠ بوزان۔
\c 22
\p
\v 1 یہِ اوس وۅنؠ تقریبن عیٖدِ فطیر مناونُک وقت نزدیک آمُت، یتھ عیٖدِ فسع تہِ وننہٕ اوس یوان۔
\v 2 کاہن سردار تہٕ یہُودؠ شریعتک ووستاد ٲسؠ تژھ وتھ ژھاران یمہِ سٟتؠ تِم لوٗکن منٛز کٲنٛہہ فساد سپدنہٕ ورٲے یسوعؔ ہس قتل کٔرن تکیازِ واریاہ لوٗکھ ٲسؠ سونچان زِ سُہ اوس اکھ عظیٖم شخص۔
\v 3 پتہٕ شیطان ژاو یہُوداہسؔ پرؠکس یمہِ سُنٛد بیٛاکھ ناو اوس اِسکریوتی۔ سُہ اوس تسنٛدیو بہَو شاگردو منٛزٕ اکھ۔
\v 4 سُہ دراو تہٕ کٔرن کاہن سردارن بیٚیہِ ہیکل کین افسرن سٟتؠ کتھ زِ سُہ کٔتہٕ پٲٹھؠ کرِ تِمن یسوعؔ ہس بنٛد کرنس منٛز مدد۔
\v 5 تِم گییہِ سیٹھاہ خوش ییٚلہِ تٔمؠ تہِ کرنچؠ پیش کش کٔر۔ تِمو ووٚن تمِس أسؠ دِمو پونٛسہٕ ہرگاہ سُہ یہِ کرِ۔
\v 6 لہٰذا یہوداہنؔ کوٚر اقرار، تہٕ تٔمؠ لٲج سۅ اکھ وتھ ژھارنؠ یُتھ تِم یسوعؔ ہس تتہِ بنٛد کٔرن یتہِ نہٕ کانٛہہ وُچھہے۔
\v 7 \f + \fr 22‏:7 \ft خروج 12:3، 6، 8، 18\f*پتہٕ ووت عیٖدِ فطیرکُ دوٚہہ۔ یہِ اوس سُہ دوٚہہ ییٚلہِ یہُودؠ لوٗکھ ٲسؠ چھرا ذبح کران یُس فسح مناونس پؠٹھ کھیوان ٲسؠ۔
\v 8 لہٰذا یسوعؔن سوٗزی پطرسؔ تہٕ یوحناؔ نیٚبر یِم ہدایت دِتھ: "گژھو تہٕ کٔرِو فسع عیٖد مناونہٕ خٲطرٕ اکھ کھؠن تیار تاکہِ أسؠ سٲری ہیکو یکجا کھیٚتھ۔"
\v 9 تِمو دِیت تمِس جواب: ژٕ کٔتہِ چُھکھ یژھان اسہِ کھؠن تیار کٔرُن؟"
\v 10 تٔمؠ دِیت جواب، "ہُشہِ سان بوٗزو۔ ییٚلہِ توٚہؠ شہرس منٛز گژھو، اکھ شخص سمکھِ توٚہہِ یمِس اکھ بوٗڈ نوٗٹ پکناوان آسہ۔ تمِس پتہٕ پتہٕ پکیو تتھ گرس تام یتھ منٛز سُہ دٲخل سپدِ۔
\v 11 گرٕکس مٲلکس ونیٚو، "سون ووستاد چُھ ونان اسہِ ہاو سُہ کمرٕ یتہِ سُہ ہیٚکہ عیٖدِ فسع کسِ موقعس پؠٹھ کھؠن پننؠن شٲگردن ہتھ کھؠیہِ۔"
\v 12 سُہ ہاوِ توٚہہِ اکھ بوٗڈ کمرٕ یُس گرکِس ہیرِمِس پوٚہرس پؠٹھ۔ یہِ آسہ مہمانن ہنٛدِ خٲطرٕ سجٲوتھ تیار آمُت کرنہٕ۔ تٔتی کریو سانہِ خٲطرٕ کھؠن تیار۔
\v 13 لہٰذا تِم زٕ شٲگرد گییہِ شہرس منٛز۔ تِمو لوٗب تتہِ تیٖ یتھٕے پٲٹھؠ تِمن یسوعؔن ونمُت اوس۔ لہٰذا تتہِ کوٚر تِمو فسع مناونہٕ خٲطرٕ کھؠن تیار۔
\v 14 ییٚلہِ وُنؠ کھؠن کھؠنُک وقت ووت، یسوعؔ آو تہٕ بیوٗٹھ تِمن رسولن سٟتؠ۔
\v 15 تٔمؠ ووٚن تِمن، "مےٚ چُھو سیٹھاہ آرِزو کوٚرمُت زِ بہٕ کھؠمہٕ مَرنہٕ برونٛہہ یہِ فسع شامُک خاص کھؠن توٚہہِ سٟتؠ۔
\v 16 بہٕ چُھس توٚہہِ ونن، دوٚیِمہِ لٹہِ کھؠمہٕ بہٕ ییٚلہِ خدا امیٚک پوشیدٕ مطلب کڈِ زٕ ییٚلہِ خدٲیی بادشٲہی پرٛیتھ جایہِ آسہ۔"
\v 17 پتہٕ تُل تٔمؠ شرابہٕ پیالہٕ تہٕ کوٚرن أمؠ خٲطرٕ خدایہِ سُنٛد شُکُر ادا۔ تٔمؠ ووٚن پننؠن رسولن، "یہِ رٔٹیو تہٕ بٲگرِو پانہٕ وٲنؠ۔
\v 18 بہٕ چُھس یژھان توٚہؠ کریو یہِ تکیازِ، بہٕ چُھس توٚہہِ ونان زِ بہٕ چؠمہٕ شراب دُبارٕ زانٛہہ یوٚت تام نہٕ خدٲیی بادشٲہی ژوپٲرؠ ییہِ۔"
\v 19 پتہٕ تُج تٔمؠ کینٛہہ ژوٚٹ تہٕ کوٚرن تمہِ خٲطرٕ خدایہِ سُنٛد شُکُر ادا۔ تٔمؠ پھٔٹرٲیہِ تِم تہٕ ٹُکرِ دِتِن تِمن کھؠنہٕ باپتھ۔ یِتھے تٔمؠ یہِ کوٚر، تٔمؠ ووٚن، "یہِ ژوٚٹ چھِ میٚون بدن، یِس بہٕ تُہنٛدِ خٲطرٕ قربان کرن وول چُھس۔ میانہِ یاداوٲری خٲطرٕ روزیٚو پتہٕ یی کران۔"
\v 20 \f + \fr 22‏:20 \ft خروج 24:18، توٲریخ 1۔ 11:25، متی 26:28، ذکریاہ 9:11\f*یِتھے پٲٹھؠ، کھؠنہٕ چؠنہٕ پتہٕ تُل تٔمؠ اکھ شرابہٕ پیالہٕ تہٕ ونُن، "یہِ چُھ اکھ نووٗ عہد نامہٕ پنُن خوٗن پیش کٔریتھ بناوان یُس میانیو زخمو منٛزٕ نیران آسہ ییٚلہِ بہٕ زُو دِمہٕ۔
\v 21 \f + \fr 22‏:21 \ft زبُور 41:9\f*پوٚز بہٕ چُھس یژھان توٚہؠ سٲری زانو زِ سُہ نفر یُس مےٚ میانؠن دشمنن اتھِ رٹناوِ چُھ مےٚ سٟتؠ ییٚتی مےٚ سٟتؠ کھیوان۔
\v 22 بہٕ چُھس یہِ ونان تکیازِ بہٕ، اولادِ آدمؔ، دِمہٕ پنُن زُو بےشک تِتھے پٲٹھؠ یِتھٕ پٲٹھؠ خداین منصوبہ بنوومُت چُھ۔ پوٚز یہِ کوتاہ خطرناک آسہ تمِس نفرٕ سنٛدِ خٲطرٕ یُس مےٚ میانؠن دشمنن حوالہٕ کرِ!"
\v 23 پتہٕ لٔگؠ تِم رسول اکھ أکِس پرژھنہِ زِ اسہِ منٛز کُس اکھ سُپد اصلی تیار یسوعؔ ہس سٟتؠ دغاہ کرنس۔
\v 24 تمہِ پتہٕ، لٔگؠ تِم رسول پانہٕ وٲنؠ بحث کرنہِ زِ تِمو منٛزٕ کُس اکھ اسہِ بڈٕ اہم شخص۔
\v 25 یسوعؔن دِیت تِمن جواب، "غیٖر یہُودؠ قومن ہنٛدؠ بادشاہ چھِ لوٗکن ہاؤن پسند کران زِ تِم چھِ طاقتور۔ تمہِ پتہٕ تہِ چھِ تِم پانس ناو دِوان، لوٗکن مدد کرن وٲلؠ۔
\v 26 پوٚز توٚہہِ پزِ نہٕ تِمن بادشاہن ہنٛدؠ پٲٹھؠ بنُن! تمہِ بجایہ، یِم توٚہہِ منٛزٕ سیٹھاہ محترم لوٗکھ چھِ تِمن شوبہٕ تمہِ انٛدازٕ پیش یِن زن تہِ آسن تِم سیٹھاہ ادنا لوٗکو منٛزٕ۔ یُس اکھ تہِ سرداری کرِ تمِس چُھ أکِس خدمت گٲرٕ سٕنٛدؠ پٲٹھؠ ضروری کٲم کرٕنؠ۔
\v 27 توٚہؠ چُھو زنان زِ اکھ اہم شخص چُھ سُہ یُس میزس پؠٹھ کھیوان چُھ، نہٕ کہ خدمت گٲر یُس غذا پیش کران چُھ۔ پوٚز بہٕ، تُہنٛد سردار رودس تُہنٛدِ خٲطرٕ اکھ مثال قٲیم کران ییٚلہِ بہٕ توٚہہِ منٛز چُھس توٚہہِ چُھسو خدمت کران۔
\v 28 توٚہہِ چُھو تِم لوٗکھ یِم تمام مشکِلن منٛز مےٚ سٟتؠ روٗدؠ یِم مےٚ تُلؠ۔
\v 29 لہٰذا وُنؠ چُھسو بہٕ توٚہؠ اہم عہدن پؠٹھ مقرر کران یِمن پؠٹھ توٚہہِ پنٕنؠ فٲصلہٕ کریو، تِتھے پٲٹھؠ یِتھٕ پٲٹھؠ میٲنؠ مٲلؠ بہٕ أکِس بادشاہ سنٛدِ حثیتہٕ فٲصلہٕ دِنہٕ خٲطرٕ مقرر کوٚرمُت چُھس۔
\v 30 توٚہؠ بِہیو، کھیٚو تہٕ چیو مےٚ سٟتؠ ییٚلہِ بہٕ بادشاہ بنہٕ۔ توٚہؠ بِہیو تختن پؠٹھ بیٚیہِ کٔرِو اسرائیل کؠن بہن زٲژن ہنٛدین لوٗکن ہنٛدؠ فٲصلہٕ۔
\v 31 شمعونؔ، شمعونؔ، کنَ دِ! شیطانن چُھ خدایس ووٚنمُت زِ مےٚ ترٛاو یلہِ یمن سارِنے ازمٲیش کرنہٕ باپتھ، یِتھٕ پٲٹھؠ کانٛہہ أکِس چھانہِ منٛزٕ فصل دانہٕ کران چُھ، خداین چُھس تمِس تہِ کرنُک اجازت دِتمُت۔
\v 32 پوٚز مےٚ چُھ چٲنہِ خٲطرٕ دوٚیخٲر کوٚرمُت، شمعون، مےٚ چُھ خدایس ونمُت زِ چون ایمان روزِ مےٚ پؠٹھ ہمیشہ برقرار۔ لہٰذا ییٚلہِ ژٕ فٲصلہٕ کرکھ زِ ژےٚ چُھے پزِؠ پٲٹھؠ مےٚ پؠٹھ ایمان، باقین رسولن کرِ حوصلہٕ افزٲئی زِ تِم تہِ تھاون یِتھۓ پٲٹھؠ مےٚ پؠٹھ ایمان۔
\v 33 پطرسنؔ دِتُس جواب، "خداوندٕ، بہٕ چُھس ژےٚ سٟتؠ جیل گژھنس تیار۔ بہٕ چُھس ژےٚ سٟتؠ مَرنس تہِ رَضامنٛد!"
\v 34 یسوعؔن دِیت جواب، "پطرسؔ، بہٕ چُھس یژھان ژٕ زانکھ زِ یتھ رٔاژ منٛز کۅکر بانٛگہِ برونٹھ ونُکھ ژےٚ ترٛیہِ لٹہِ یہِ ژٕ زانکھ نہٕ مےٚ!"
\v 35 پتہٕ ووٚن یسوعؔن رسولن، "ییٚلہِ گامن کُن مےٚ توٚہؠ روانہٕ کرِوٕ تہٕ توٚہؠ گیوٕ پونٛسہٕ ٹھیلو، غذا، یاہ کھۅربانہٕ ورٲے، کیاہ تتہِ ٲسا کنہِ چیزچ کٔمی یمِچ توٚہہِ ضرورت ٲس؟" تِمو دیت جواب، "نہٕ، کُنہِ چی نہٕ!"
\v 36 پتہٕ ووٚن یسوعؔن، "پوٚز، وُنؠ ہرگاہ توٚہہِ منٛزٕ کٲنسہِ کانٛہہ پونٛسہٕ ٹھیلہٕ آسہ، تمِس پزِ سُہ پانس سٟتؠ تُلُن۔ بیٚیہِ یمِس غذا آسہ تمِس پزِ سُہ پانس سٟتؠ تُلُن۔ تہٕ یمِس أکِس تلوار آسہ نہٕ تمِس پزِ پنُن کوٹ کٕنُن تہِ سۅ مٔلؠ ہینؠ!"
\v 37 \f + \fr 22‏:37 \ft غلتین 3:13، کورنتھین 2۔ 5:21، یسعیاہؔ 53:12\f*بہٕ چُھس توٚہہِ یہِ ونان تکیازِ یہِ اکی نبی ین مےٚ متعلق نوشتن منٛز لیٚوکھ تہِ گژھِ ضرور سپدن" لوٗکھ کرِن تمِس سٟتؠ مجرمہٕ سٕنٛدؠ پٲٹھؠ سلوکھ۔ "یہِ کینٛژھا نوشتو مےٚ متعلق ووٚن تہِ چُھ سپدن وول۔
\v 38 شاگردو دِیتُ جواب، "خداوندٕ، وُچھ! اسہِ چھِ زٕ تلوارٕ!" تٔمؠ دِیتُ جواب، "اسہِ چھِنہٕ دویو علاوٕ ضرورت۔"
\v 39 یسوعؔ دراو شہرِ منٛزٕ تہٕ گوٚو عادٕکِنؠ زیتون بالس کنُ۔ تٔمؠ سٕنٛدؠ شٲگرد گییہِ تمِس سٟتؠ۔
\v 40 ییٚلہِ یسوعؔ پنٕنؠ شٲگرد ہٮ۪تھ تتھ جایہِ ووت ییٚتہِ سُہ اکثر رٲتھ گُذارن اوس، تٔمؠ ووٚن تِمن، "دُعا کٔرِو زِ خدایہِ گژھِ مدد کرُن تاکہِ توٚہہِ ییہِ نہٕ ازمٲیش تراونہٕ۔"
\v 41 پتہٕ دراو سُہ تِمن نِشہ ترٛہ میٹر دوٗر، کوٚرن سٕجدٕ بیٚیہِ کوٚرن دویخٲر۔
\v 42 تٔمؠ ووٚن، "ببہٕ، ہرگاہ ژےٚ رضامند آسکھ، مہربٲنی کٔریتھ مےٚ مٕہ دِ اجازت تِمو خطرناک تکلیفو منٛزٕ گُذرن وزِ گُژھنہٕ بہٕ پتھ ہیوٗن یِم سپدن وٲلؠ چھِ۔ پوٚز تہِ مٕہ کرِ یہِ بہٕ یژھان چُھس۔ تی کرِ یہِ ژٕ یژھان چُھکھ۔"
\v 43 پتہٕ آو آسمانہٕ پؠٹھٕ اکھ فرشہٕ تمِس نِشہ تہٕ کرنس حوصلہٕ افزٲئی۔
\v 44 تمِس ٲس زبردس پریشانی۔ لہٰذا تٔمؠ کوٚر سخ دُعا۔ تٔمؠ سُنٛد عٲرکھ اوس سٮ۪ٹھاہ خوٗنٕکؠ پٲٹھؠ پتھر زمیٖنہِ پؠٹھ پٮ۪وان۔
\v 45 ییٚلہِ یسوعؔ دُعا کٔرتھ تھوٗد ووٚتھ، پتہٕ آو سُہ پننؠن شٲگردن نِشہ واپس۔ تمِس سپد معلوم زِ تِم سٲری ٲسؠ شونٛگِتھ۔ تِم سٲری ٲسؠ مایوس یمہِ سٟتؠ تِمن منٛز تھکاوٹ پٲدٕ گمٕژ ٲس۔
\v 46 تٔمؠ تُلؠ تِم نینٛدرِ تہٕ تِمن ووٚننُ، "یہِ چُھنہٕ تہنٛدِ خٲطرٕ شونٛگِتھ روزنُک وقت! تھوٗد وتھِو! دُعا کٔرِو زِ خدا کرِ توٚہہِ مدد تاکہِ توٚہؠ پییٚوِ ازمٲیشہ منٛز۔"
\v 47 وُنہِ اوس یسوعؔ یی ونان، لوٗکن ہُنٛد اکھ ہجوم ووت تس نِشہ۔ بہَو شاگردو منٛزٕ اکھ شٲگرد، یہُوداؔ اوس تِمن رہبری کران۔ یہُوداؔ آو برونٛٹھ کنُ یسوعؔ ہس نِشہ تٔمسٕنٛدِس بُتھِس مۅنؠ کرنہٕ باپتھ۔
\v 48 مگر یسوعؔن ووٚن تمِس، "یہُوداؔ، ژےٚ کٔتھٕ پٲٹھؠ کوٚڑُتھ جورتھ مےٚ، اولادِ آدمس، میانؠن دشمنن حوالہٕ کرنہٕ کرنس پؠٹھ میوٗٹھ کرنس!"
\v 49 شٲگردن ییٚلہِ معلوم سُپد زِ کیاہ اوس سپدان، تِمو ووٚن، "خداوندٕ، أسؠ کروٕ پننؠن ہتھیار استعمال یُتھ نہٕ تِم ژےٚ گرفتار کرِن؟"
\v 50 تِمو منٛزٕ کڈ اکؠ تلوار تہٕ لٲین تھدِس کاہن سنٛدِس خدمت گارس، مگر تمِس ژھیٚون صرف دٔچُھن کَن۔
\v 51 مگر یسوعؔن ووٚن، "امہِ علاوٕ مہٕ کریٚو! پتہٕ لوگُن تمِس خدمت گارس تتھ زخمس اتھٕ سُہ گو ٹھیک۔
\v 52‏-53 پتہٕ ووٚن یسوعؔن تِمن ہیکل کین کاہن سردارن بیٚیہِ یہُودؠ بُزرگن، یِم تمِس گرفتار کرنہِ آمٕتؠ ٲسؠ، "یہِ چُھ حیرت انٛگیز زِ توٚہؠ چُھو تلوارٕ تہٕ ڈنڈٕ ہٮ۪تھ یوٚتتھ مےٚ رٹنہِ آمٕتؠ زنہٕ تہِ بہٕ اکھ ڈاکوٗ اوسُس۔ بہٕ واریہن دوٚہُن توٚہہِ سٟتؠ ہکل لس منٛز اوسُس، مگر توٚہہِ کٔروٕ نہٕ کُنہِ صورتس منٛز مےٚ رٹنچؠ کوٗشش! پوٚز یہِ چُھ سُہ وقت ییٚلہِ توٚہؠ یہِ کران چُھو یہِ توٚہؠ یژھان چُھو۔ بیٚیہِ چُھ یہِ سُہ وقت ییٚلہِ شیطان چُھ تِم بُرٕ کامہ کرنہِ یمہٕ سُہ یژھان چُھ۔
\p
\v 54 یہُودؠ سردارو تہٕ سِپاہو نیٚو یسوعؔ رٔٹتھ۔ تِمو نیٚو سُہ زِٹھس کاہن سُنٛد گرٕ۔ پطرسؔ اوس تمِس دوٗرے پہن روزِتھ پتہٕ پتہٕ لاران۔
\v 55 کینٛژو نفرو زول آنٛگنس منٛزٕ بھاگ نار تہٕ بیٖٹھؠ یکجاہ۔ پطرسؔ آو تہٕ بیوٗٹھ تِمن منٛز۔
\v 56 اکہ نوکرانہِ وُچھ پطرسؔ بہتھ یِتھے نارٕ گاشس تسَ پؠٹھ پیوٗ۔ تمہِ وُچھ سُہ غورٕ سان تہٕ ونُن، "یہِ شخص تہِ اوس تمِس سٟتؠ یُس اکھ توٚہہِ گرفتار کوٚر وون!"
\v 57 پوٚز تٔمؠ کوٚر اتھ اِنکار یہِ ونان، "جوان زٔنؠ، بہٕ زانن نہٕ سُہ!"
\v 58 کمےٕ کٲلؠ پتہٕ بدل کٔمؠ تام وُچھ پطرسؔ تہٕ ونُن، "ژٕ چُھکھ تِمو منٛزٕ اکھ یُس تمِس سٟتؠ اوس یُس تِمو گرفتار کوٚر!" پوٚز پطرسنؔ ووٚن، "ناہ، لالہ، بہٕ چُھس نہٕ تِمو منٛزٕ!"
\v 59 تقریٖبن اوٚڈ گٲنٹہٕ پتہٕ کٔمؠ تام ووٚن زورٕ سان، "یمہِ انٛدازٕ یہِ شخص کتھٕ کران چُھ أمِس چُھ گلیل علاقس سٟتؠ تعلق۔ لہٰذا یہِ چُھ ضرور تمِس نفرس سٟتؠ آمُت یُس نفر گرفتار کوٚر!"
\v 60 پوٚز پطرسنؔ ووٚن، "جناب، یہِ چُھنہٕ پوٚز!" ؤلؠ ؤلؠ دِژ اکؠ کۅکرن بانٛگ، ییٚلہِ پطرسؔ وُنہِ کتھے اوس کران۔
\v 61 یسوعؔ پھیوٗر کنُ تہٕ دِژن پطرسسؔ کنُ نظر۔ پتہٕ پؠو پطرسسؔ یاد یہِ یسوعؔن تمِس ووٚنمُت اوس۔ "یتھ رٲژ منٛز کۅکرٕ سنٛزِ بانٛگہِ برونٛٹھ ٲسِتھ ژٕ ترٛییہِ لٹہِ اِنکار کوٚرمُت زِ ژٕ زانکھ مےٚ۔"
\v 62 پتہٕ درٛاو سُہ تمہِ آنٛگنہٕ منٛزٕ نیٚبر تہٕ ژھٹؠن بٲکھ۔
\v 63 یِمو نفرو سُہ رٹتھ اوٚنمُت اوس تِم ٲسؠ تسَ مذاق کران بیٚیہِ لایان۔
\v 64 تِمو گنڈؠ تمِس أچھن پٔٹ یُتھ زن نہٕ سُہ وچھتھ ہیٚکہ ہے تہٕ تِم روٗدؠ تس وارِ وارِ چوٗب دِوان۔ تِمو ووٚن تسَ، "اسہِ ہاو زِ ژٕ چُھکھ اکھ رسول! وُن اسہِ ژٕ کٔمؠ لویٖی!"
\v 65 تِمو ونہِ واریاہ ظٲلمانہٕ کتھہٕ تمِس متعلق تہٕ دِیت ہس طعنہٕ۔
\v 66 دویمہِ دوٚہہ صبحس گاش پھوٚلون، یہُودینؔ ہنٛدؠ واریاہ سردار گییہِ یکجاہ جمع۔ اتھ جمٲژ منٛز ٲسؠ کاہن سردار بیٚیہِ یہُودؠ شریعت ہیٚچھناون وٲلؠ شخص۔ تِمو اننوو یسوعؔ سِپاہن ہنٛدؠ دسؠ یہُودؠ عدالٔژ منٛز۔
\v 67 تتہِ ووٚن تِمو تمِس، "ہرگاہ ژٕ مسیحؔ چُھکھ، اسہِ وُن!" پوٚز تٔمؠ دِیت جواب، "ہرگاہ بہٕ ونہٕ بہٕ چُھس مسیحؔ، توٚہؠ کٔرِو نہٕ مےٚ پؠٹھ پژھ۔
\v 68 پوٚز ہرگاہ بہٕ توٚہہِ پرٛژھوو زِ توٚہؠ چُھوا مےٚ مسیحؔ سمجھان، توٚہؠ دِیو نہٕ مےٚ جواب۔
\v 69 \f + \fr 22‏:69 \ft مرقُس 14:62، زبُور 110:1\f*پوٚز یمہِ یوٗر روزٕ بہٕ مسیحؔ، یُس خدایس دٔچِھنؠ کِنؠ بہتھ آسہ بادشٲہی کران!"
\v 70 پتہٕ ووٚن تِمو ساروےٕ، "ہرگاہ تہِ چُھ، کیاہ ژٕ چُھکھا ونان زِ بہٕ چُھس خدایہِ سُنٛد گۅبُر "تٔمؠ دِیت جواب، "اوے، یہِ توٚہؠ ونان چُھو تہِ چُھ پوٚز۔"
\v 71 پتہٕ ووٚن تِمو اکھ أکِس، "اسہِ چُھ پانہٕ أمِس نِشہ بوزمُت زِ سُہ چُھ خدایس برابر! لہٰذا اسہِ چھِنہٕ وُنؠ یقیٖنن زیادن لوٗکن ہنٛز گوٲہی أمِس خلاف کفرکُ الزام دِنہٕ خٲطرٕ ضرورت!"
\c 23
\p
\v 1 پتہٕ ؤتھؠ تِم دویمہِ دوٚہہ سٲری تہٕ نیوکھ یسوعؔ رومی گورنر پِیلاطسسؔ نِشہ۔
\v 2 تِمو دِیتُ تمِس پیٖلاطسسؔ برونٛٹھٕ کنہِ الزام۔ تِمو ووٚن، "اسہِ چُھ وُچھمُت زِ یہِ شخص چُھ سٲنؠن لوٗکن وُتہِ ڈالان یمہِ سٟتؠ اسہِ مشکل گژھان۔ سُہ روٗد تِمن ونان زِ توٚہؠ مہَ دِیو سُہ محصول یُس رومکؠؔ بادشاہ قیصرنؔ عاید کوٚرمُت چُھ۔ بیٚیہِ چُھ سُہ ونان زِ سُہ چُھ مسیحؔ، اکھ بادشاہ!"
\v 3 پتہٕ پرُژھ پِیلاطسنؔ تمِس، "کیا ژٕ چُھکھا یہُودینؔ ہُنٛد بادشاہ؟" یسوعنؔ دِیتُ جواب، "اوے، یہِ چُھ تیٖ یہِ ژےٚ مےٚ پرُژھتھ۔"
\v 4 پِیلاطسنؔ ووٚن پتہٕ تِمن کاہن سردارن بیٚیہِ لوٗکن ہنٛدس ہجومس، "أمؠ شخصس چُھنہٕ کانٛہہ جرم کوٚرمُت۔"
\v 5 مگر یہُودؠ مجلس ہنٛز جماعت روز یسوعؔ ہس الزام دِوان۔ تِمو ووٚن، "یہِ چُھ لوٗکن منٛز فساد پٲدٕ کرناونچؠ کوٗشش کرن! یہِ چُھ تمام یہُودیہ علاقس منٛز پننؠن خیالات ہنٛز تعلیم دِوان۔ أمؠ کوٚر یہِ گلیل علاقس منٛزٕ شروع، تہٕ وُنؠ چُھ یہِ یتہِ کران!"
\v 6 ییٚلہِ پِیلاطسنؔ تُہنٛد بوز یہِ، تٔمؠ ووٚن تِمن، "کیاہ یہِ شخص چھا گلیل علاقہٕ پؠٹھٕ آمُت؟"
\v 7 ییٚلہِ پیٖلاطسؔس معلوم سُپد زِ یسوعؔ اوس گلیل لکُ ییٚتہِ ہیرودسؔ حٲکمران اوس، تٔمؠ سوز یسوعؔ تمِس نِشہ۔ تمہِ ساعتہٕ اوس ہیرودیس یہِ یروشلمسؔ منٛزٕ۔
\v 8 ییٚلہ ہیرودیسنؔ یسوعؔ وُچھ سُہ سُپد سیٹھاہ خوش، سُہ اوس تمِس واریاہ کٲلہٕ پؠٹھٕ وچُھن یژھان۔ تکیازِ ہیرودیسنؔ اوس تمِس متعلق واریاہ چیز بوزؠ مٕتؠ، تہٕ سُہ اوس یژھان تٔمؠ سُنٛد اکھ معجزٕ وچُھن۔
\v 9 لہٰذا پرُژھ تٔمؠ یسوعؔ ہس واریاہ سوال، مگر یسوعؔن دِیتُ تِمو منٛزٕ أکس تہِ جواب۔
\v 10 کاہن سردار تہٕ یہُودؠ شریعتک مٲہر گییہِ یسوعؔ ہس نزدیک کھڑا تہٕ تمِس روٗدؠ سیٹھاہ مضبوطی سان واریاہ جرم کرنکہ الزام دِوان۔
\v 11 پتہٕ کٔر ہیرودیسنؔ تہٕ تسنٛدیو سِپاہو بےیزتی بیٚیہِ کوٚرہس مذاق۔ تِمو لٲگؠ تمِس قٟمتی پلو زن تہِ اوس سُہ ٲکِھتھ پٲٹھؠ بادشاہ۔ پتہٕ سوز ہیرودیسنؔ سُہ پیلاطسؔ واپس۔
\v 12 تتھ وقتس تام ٲس تِمن دوٚن شخصن پانہٕ وانؠ دشمنی، مگر تمہِ دوٚہہ سُپد ہیرودیسؔ تہٕ پیلاطسؔ یارانہٕ۔
\v 13 پِیلاطسنؔ کٔر جمع کاہن سردار، یہُودؠ سردار تہٕ سُہ ہجوم یُس تتہِ وُنہِ موجود اوس۔
\v 14 تٔمؠ ووٚن تِمن، "یہِ شخص اوٚن ووٚن توٚہہِ مےٚ نِشہ یہِ ونان زِ یہِ چُھ لوٗکن بغاوت کرناؤنس منٛز رہنمٲییٔ کران۔ پوٚز بہٕ چُھس یژھان توٚہؠ زانو زِ توٚہہِ برونٛہہ کنہِ کٔر مےٚ أمِس پرٛژھِ غٲر، بہٕ وُنہٕ مختصرن زِ أمؠ چُھنہٕ کانٛہہ سۅ کٲم کرمٕژ یمیُک أمِس قصور چُھ یہِ زن توٚہہِ ونُن چُھو زِ أمؠ کوٚر۔
\v 15 ہیرودیسنؔ سوز سُہ سزا دِنہٕ ورٲے بیٚیہِ واپس۔ امیٚک مطلب چُھ یہِ زِ سُہ تہٕ ووت تتھ نٔتِیٖجس پؠٹھ زِ تسَ اوس نہٕ کانٛہہ تہِ قصور۔ لہٰذا یہِ چُھ صاف زِ أمؠ شخصن چُھنہٕ تیژھ کانٛہہ کٲم کٔرمٕژ یمہِ سٟتؠ سُہ مٲرنکُ حقدار بنہِ۔
\v 16 لہٰذا بہٕ وُنہٕ پننؠن سِپاہن أمِس دِیو کوڈٕ پتہٕ تراؤن یلہِ۔"
\v 17 پیلاطسنؔ ووٚن یہِ تکیازِ تمِس اوس پرٛیتھ فسح عید مناونس پؠٹھ اکھ قٟیدی ییٚلہ تراؤن۔
\v 18 مگر سٲری ہجومن تُج یکہٕ وٹہٕ کرٛکھ، "یہِ شخص مٲرہن! تمہِ بدلہٕ تراوِہن براباسؔ یلہِ!"
\v 19 براباؔ اوس اکھ سُہ شخص یمؠ یروشلم شہرس منٛز کینٛہہ لوٗکھ ٲسؠ رومی حکومتس خلاف بغاوت کرناؤمتٕؠ۔ سُہ اوس بیٚیہِ اکھ قٲتِل۔ یمو جرمو سبہٕ اوس سُہ جیلس منٛز۔
\v 20 پوٚز پیلاطسؔ اوس یژھان یسوعؔ یلہِ تراؤن، لہٰذا کٔر تٔمؠ دُبارٕ ہجومس سٟتؠ کتھ کرٕنؠ۔
\v 21 مگر تِم روٗدؠ کرؠکہٕ ناد کران، "أمِس دِیو پھٲسؠ! أمِس دِیو پھٲسؠ!"
\v 22 پیلاطسنؔ ووٚن تتھ ہجومس ترٛییمہِ پھرِ۔ "نہٕ! أمؠ چُھنہٕ کانٛہہ بوٗڈ جرم کوٚرمُت! أمؠ چھِنہٕ کانٛہہ تیژھ کٲم کٔرمٕژ یمہِ سبہٕ أمِس مَرنُ چُھ۔ لہٰذا میٲنؠ سِپاہ دِؠن أمِس کوڈٕ تہٕ پتہٕ تراونس یلہِ۔"
\v 23 پوٚز ہجومس منٛز روٗدؠ تِم لوٗکھ کرؠکہٕ دِوان پیلاطسؔ تاکید کران زِ یسوعؔ کھٲلؠ وون صٔلیٖبس۔ تِم روٗدؠ زورٕ زورٕ کرؠکہٕ دِوان، ٲخرس پؠٹھ مانہِ راؤ تِمو پیلاطسنؔ۔
\v 24 لہٰذا پِیلاطسنؔ کوٚر اعلان زِ سُہ کرِ تیٖ یہِ تِمن تمناہ اوس۔
\v 25 \f + \fr 23‏:25 \ft متی 27:32۔ 44، مرقُس 15:21۔ 23، یوحناؔ \f*پتہٕ کوٚر پیلاطسنؔ سُہ نفر آزاد یمِس متعلق ہجوم تمِس ونان اوس زِ سُہ تراون یلہِ۔ سُہ نفر اوس امہِ سبہٕ جیلس منٛز زِ تٔمؠ ٲس حکومتس خلاف بغاوت کٔرمٕژ بیٚیہِ لوٗکھ قتل کٔرِمٕتؠ! پیلاطسنؔ دِیتُ سِپاہن حکم زِ یسوعؔ نیہِن تہٕ کٔرِو یہِ ہجومس تمناہ چُھ۔
\v 26 ییٚلہِ سِپاہ یسوعؔ ہس نِوان ٲسؠ وتہِ منٛز وُچھ تِمو شمعونؔ ناوک اکھ نفر یُس کرینی شہرک اوس۔ سُہ اوس مامہٕ پٮ۪ٹھٕ یروشلم کنُ یوان۔ تِمو روٚٹ سُہ۔ تِمو نیٚو یسوعؔ ہس صلیب یُس تمِس بارِ کھالُمُت اوسُکھ تہٕ لُدھک شمعونسؔ بارِ۔ تِمو ووٚن تمِس یہِ تُل تہٕ پکھ یسوعؔ ہس پتہٕ پتہٕ۔
\v 27 وُنؠ اوس اکھ بوٗڈ بارِ ہجوم یسوعؔ ہس پتہٕ پکان۔ ہجومس منٛز ٲسہٕ واریاہ زنان یمہٕ پنُن افسوس ہاونہٕ باپتھ آسہ سینہٕ کوبی کران بیٚیہِ آسہ تمِس پؠٹھ غمہٕ سان ماتم کران۔
\v 28 پوٚز تِہنٛز ہمدردی ماننہٕ بجایہ، یسوعؔ پھیٚوٗر تِمن زنانن کُن تہٕ ووٚنُن، "توٚہؠ یروشلمٕچہِ زنانہٕ مٕہ ودیٚو میانہِ باپتھ! امہِ بجایہ ودیٚو توٚہؠ پانس تہٕ پننؠن شُرؠن پؠٹھ تکیازِ خطرناک چیز چھِ پیش ینہٕ وٲلؠ!
\v 29 تمہِ خٲطرٕ چُھس بہٕ یژھان توٚہؠ زانو زِ سُہ اکھ وقت واتہِ جلد ییٚلہِ لوٗکھ ونن، "بختہٕ بجہِ چُھے تِم ہانٛٹھ یِمن نہٕ شُرؠ زایہِ یاہ دِتُکھ شُرؠن دۅد!"
\v 30 شہرن منٛز ونن پتہٕ لوٗکھ، "کاش پہاڑ ین اسہِ پؠٹھ وکراونہٕ تہٕ بال بچاون اسہِ تباہ سپدنہٕ نِشہ!"
\v 31 ونہِ کؠن چُھ یہِ لوٗکن ہنٛدِ خٲطرٕ مشکل زِ تِم ستاون باقین، یتھٕ پٲٹھؠ زنہٕ تازٕ لکٕرِ چُھ نار دیُن مُشکل۔ مگر پتہٕ کرن لوٗکھ باقین باپتھ آسٲنی سان خطرناک کامہِ، یتھٕ پٲٹھؠ زنہٕ ہوٗچھِ لکٕرِ نٲر دِین سہل چُھ۔"
\v 32 زٕ مجرم شخص تہِ ٲسؠ یسوعؔ ہس سٟتؠ تتھ جایہِ کنُ پکان یتہِ تِمن رومی قتل کرِہن۔
\v 33 ییٚلہِ تِم تتھ جایہِ وٲتؠ یتھ کلہٕ کھاسٕر ونان ٲسؠ تتہِ گنڈ تِمو سِپاہو یسوعؔ أکِس صلیبس سٟتؠ۔ تِمو کوٚر تِمن دوٚن مجرمن تہِ یتھے پٲٹھؠ۔ تِمو تھوٚو اکھ یسوعؔ ہس دٔچِھنؠ تہِ بیٛاکھ کھوٗرؠ۔
\v 34 \f + \fr 23‏:34 \ft پطرس 1۔ 3:9، مُکاشفہ 7:60، یسعیاہؔ 53:12، زبُور 22:18\f*پوٚز یسوعؔن ووٚن، "ببہٕ، مہربٲنی کریتھ دِ یِمن لوٗکن معافی۔ یِمن چھنہٕ فِکرِ تران زِ یِم کیاہ چھِ کران۔ "تِمو سِپاہو تراوِ پتہٕ تمسنٛدؠ پلو بٲگرونہٕ خٲطرٕ چیٖرِ زِ کٔمس کسُ پلو ییہِ۔
\v 35 \f + \fr 23‏:35 \ft زبُور 22:7\f*واریاہ لوٗکھ ٲسؠ نزدیک اِستادٕ وچھان۔ تِم ٲسؠ، یسوعؔ ہس مذاق کران۔ یہُودؠ سردار تہِ ٲسؠ تیٖ کران۔ تِمو ووٚن، "یمؠ چھِ باقیو لوٗکھ بچٲوؠ مٕتؠ! یوٚدوے یہِ خدایہِ سُنٛد ٹوٹھ مسیحؔ آسہ أمِس پزِ پنُن پان بچٲون!"
\v 36 \f + \fr 23‏:36 \ft زبُور 69:21\f*سپہو تہِ کٔر أمِس سٟتؠ مسخریلؠ۔ تِم گییہِ تمِس نکھٕ تہٕ کوٚرہس ژوٚک شراب پیش۔
\v 37 تِمو ووٚن تمِس، "ہرگاہ ژٕ یہُودینؔ ہُنٛد بادشاہ چُھکھ، بچاو پنُن پان!"
\v 38 تِمو سپہو لٲجؠ تہنٛدس کٔلس پیٚٹھؠ کِنؠ صلیبس اکھ پٔٹ یتھ پؠٹھ یہِ اوس بیان کٔریتھ، "یہِ چُھ یہُودینؔ ہُنٛد بادشاہ۔"
\v 39 تِمو مجرمو منٛزٕ اکؠ مجرمن یُس یسوعؔ ہس لٔرِ صلیبس اویزان اوس، تٔمؠ تہِ کٔر تمِس بےیزتی۔ تٔمؠ ووٚن، "ہرگاہ ژےٚ پزِ پٲٹھؠ مسیحؔ چُھکھ، ژٕ بچاو پان تہٕ بیٚیہِ بچاو اسہِ تہِ!"
\v 40 پوٚز دوٚیِمؠ مجرمن ووٚن تمِس نس کرِتھ، "ژےٚ پزِ پانس سزا دِنس پؠٹھ خدایس کھۅژُن! ژٕ چُھکھ بیٚیہِ أکِس صلیبس پؠٹھ مَران تہٕ خدا کرِ جلد چون فٲصلہٕ۔
\v 41 اسہِ دوٚن پؠٹھ چُھ مرُن وٲجب۔ تِم چھِ اسہِ پننؠو بدکامیٚو سببہٕ سزا دِوان۔ پوٚز یمِس شخصس ژےٚ بے عزتی چُھکھ کران تمؠ چھنہٕ کانٛہہ غلط کٲم کرمٕژ!"
\v 42 پتہٕ ووٚن تٔمؠ یسوعؔ ہس، "یسوعؔ مہربٲنی کرِتھ سونچ مےٚ متعلق بیٚیہِ ییٚلہِ ژٕ پنٕنؠ بادشٲہی شروع کرکھ مےٚ سٟتؠ کٔرؠ زِ اصل سلوک!"
\v 43 یسوعؔن دِتس جواب، "بہٕ چُھسے ژےٚ از ونان زِ ژٕ آسکھ مےٚ سٟتؠ جنتس منٛز!"
\v 44 امہِ ساعتہٕ اوس تقریبن دوٚپہرک وقت۔ مگر تتھ سٲرسےٕ علاقس منٛز سپٕز انہِ گٹہٕ یۅسہ زن ترٛیمِس پہرس تام روز۔
\v 45 \f + \fr 23‏:45 \ft عاموس 8:9، عِبرٲنؠن 10:19\f*افتابس گوٚو انہِ گوٚٹ۔ ہیکلُک پردٕ آو پٔھٹِتھ تہٕ گیس زٕ حصہٕ۔
\v 46 ییٚلہِ تہٕ سپد، یسوعؔن دِژ زورٕ سان کرؠکھ، "ببہٕ، "بہٕ چُھسے پنُن روح ژےٚ حوالہٕ کران!" تہِ ونِتھ دِیُت تٔمؠ زُو۔
\v 47 یہِ واقہٕ وُچِھتھ ووٚن تٔمؠ صوبہ دارن یُس سِپاہن ہنٛز سربرٲئ کران اوس، "یمؠ شخصن چھِنہٕ بے شک کانٛہہ غلط کٲم کرمٕژ!" تٔمؠ کوٚر یِمہٕ چیز ؤمِتھ خدایہِ سُنٛد احترام۔
\v 48 یُس لوٗکن ہُنٛد ہجوم تتہِ تِمن شخصن ہنٛدِ مَرنُک نظارٕ وُچھِنہٕ باپتھ جمع اوس ییٚلہِ تِمو وُچھ اصلی کیاہ سپد، تِم گییہِ غمہٕ سٟتؠ وَچھ ژٹان پننؠن گھرن کُن واپس۔
\v 49 \f + \fr 23‏:49 \ft زبُور 38:11، 88:8\f* ییٚلہِ لوٗکن ہُنٛد ہجوم درٛاو، یسوعؔ سٕنٛدؠ زٲنؠ کار یِمن منٛز واریاہ زنانہٕ  شٲمل آسہ، یِمہِ گلیل پؠٹھٕ تسَ پتہٕ پتہٕ آمٕژ آسہ روٗدؠ دوٗر اِستادٕ یہِ واقہٕ وُچھان۔
\v 50 تتہِ اوس یوسف ناوک یروشلمک اکھ شخص۔ سُہ اوس اکھ رُت تہٕ راست باز شخص یُس یہُودؠ مجلسہِ ہُنٛد اکھ ممبر اوس۔
\v 51 مگر تٔمؠ اوس نہٕ مجلسہِ ہنٛدین باقیو ممبرن سٟتؠ یسوعؔ قتل کرِ نکس منصوبہ بناونہٕ کِس فٲصلس سٟتؠ اتفاق کوٚرمُت۔ سُہ اوس یہُودیا ہس منٛز ارِمتیہ شہرک روٗزن وول۔ سُہ اوس امید سان تتھ وقتس انتظار کران ییٚلہِ خدٲیی بادشٲہی شروع سپدِ۔
\v 52 یوسفؔ گوٚو پِیلاطسسؔ نِشہ تہٕ ووٚننس زِ تمِس دِ یسوعؔ سنٛز لاش دفن کرنہٕ باپتھ اجازت۔ پِیلاطسنؔ دِیت تس اجازت۔
\v 53 لہٰذا یوسفنؔ وٲج صلیبہٕ پؠٹھٕ یسوعؔ سنٛز لاش بۅن۔ تٔمؠ ؤج تتھ زٲوِج اکھ کپر ژادر۔ پتہٕ تٔھوُن أکِس قبرِ منٛز یۅسہ أکِس شیلہِ منٛز کھننہٕ آمٕژ ٲس۔ تتھ منٛز ٲس نہٕ زانٛہہ کٲنسہِ کانٛہہ مۅردٕ دفن کوٚرمُت۔
\v 54 \f + \fr 23‏:54 \ft جمعہ دوٚہہ دوپہرس\f*یہِ سپدیو تمہِ دوٚہہ ییٚلہِ یہُودؠ لوٗکھ ٲسؠ سبت دوٚہہ خٲطرٕ تیار ٲسؠ۔ شام اوس سپدن وول، سبت سپدِ شروع۔
\v 55 تمہِ زنانہٕ یِم گلیل علاقہ پؠٹھٕ یسوعؔ ہس سٟتؠ آمٕژ آسہ تِم گییہِ یوسفسؔ تہٕ تِمس سٟتؠ باقین نفرن پتہٕ پتہٕ۔ تِمو وُچھِ سۅ قبر بیٚیہِ وُچھ تِمو زِ یسوعؔ سنٛز لاش کتھٕ کِنؠ آیہِ تتھ اندر تھاونہٕ۔
\v 56 تِم زنہِ گییہِ تتھ جایہِ واپس ییٚتہِ تِم ٹھہرِتھ آسہ امہِ غرضہِ تِم کٔرن سُہ مثٲلہِ، مرہم تہٕ عطر تیار یُس تِم یسوعؔ سنٛزِ لاشہِ پؠٹھٕ تراوہن۔ بہرحال، تِم رُوکیہِ کٲم کرنہٕ نِشہ ییٚلہِ سبت سپد شروع، یتھٕ پٲٹھؠ یہُودؠ شریعت مطٲبق ضروری اوس۔ \f + \fr 23‏:56 \ft خروج 20:10، تثنِیہ شرع 5:14\f*
\c 24
\p
\v 1 ہفتٕکہِ دوٚہہ صبحس سیٹھاہ سُلے گییہِ تِم زنانہٕ قبرِ پؠٹھ۔ تِمو تُلؠ تِم مشکہٕ دار چیز پانس سٟتؠ یِم تِمو یسوعؔ سنٛزِ میتس پؠٹھ ترٛاونہٕ باپتھ تیار کٔرمٕتؠ ٲسؠ۔
\v 2 ییٚلہِ تِم وٲتؠ، تِمن وُچھ زِ کٔمؠ تام ٲس قبرِ پؠٹھٕ کٔنؠ ہیٚور کُن پھرِ مٕژ۔
\v 3 تِم ژٲیہِ مقبرس اندر، مگر تتہِ ٲس نہٕ یسوعؔ سنٛز میت!
\v 4 تِمن توٚر نہٕ فِکرِ زِ تِم کیاہ سونٛچن۔ پتہٕ سَپدٕؠ اچانک زٕ شخص تِمن نِش اِستادٕ یِمن پریٚزلوُن پوشاکھ لٲگتھ اوس!
\v 5 \f + \fr 24‏:5 \ft مُکاشفہ 1:18، مرقُس 5:16 \f*تِم کھوژؠ امہِ سٟتؠ۔ تِمو کوٚر زمیٖنس کُن سجدٕ۔ تِمو دویو شخصو ووٚن تِمن، "توٚہہِ شۅبہِ نہٕ سُہ اکھ تلاش کرُن یُس تتھ جایہِ زندٕ چُھ ییٚتہِ تِم مودمتین لوٗکن دفن کرن چھِ!
\v 6 سُہ چُھ نہٕ ییٚتہِ۔ ناہ، سُہ چُھ دُبارِ زندٕ گومُت! یاد پٲوِو زِ ییٚلہِ سُہ وُنہِ گلیل منٛز توٚہؠ سٟتؠ اوس تٔمؠ کیاہ اوسو توٚہہِ ووٚنمُت۔
\v 7 "تِم کرن مےٚ آدمؔ سٕنٛدِس اولادس، گناہگارن نفرن حوالہٕ۔ تِم نفر گنڈیِن مےٚ أکِس صلیبس سٟتؠ تہٕ کرن مےٚ قتل۔ مگر تریٚیمہِ دوٚہہ سَپدٕ بہٕ دُبارٕ زندٕ۔"
\v 8 تِمن زنانن پیو تہِ یاد یہِ یسوعؔن تِمن ووٚنمُت اوس۔
\v 9 لہٰذا تِم درایہِ مقبرٕ پؠٹھٕ تہٕ گییہِ تِمن کاہن رسولن بیٚیہِ یسوعؔنؠن باقین شٲگردن نِشہ تہٕ ونُکھ تِمن یہِ سَپدمُت اوس۔
\v 10 یِمو زنانو تِم کتھٕ رسولن وُنہِ تِم زنانہٕ آسہ مریم مگدلِینی، حنہ تہٕ یعقوبنؔؠ موج مریم بیٚیہِ باقیو زنانہٕ یِم تِمن سٟتؠ آسہ۔
\v 11 مگر رسولو سونچؠ یمہٕ کتھٕ چھِ بے مانے لہٰذا تِمو کوٚر نہٕ تِمن زنانن ہنٛزن کتھن پؠٹھ یقین۔
\v 12 پطرسنؔ نیٚو توتہِ فٲصلہٕ زِ سُہ وُچھِ تمہِ دلیل ہُنٛد پزر۔ سُہ دوریو تتھ مقبرس نِشہ نوٚمرِتھ دِژن اندر کُن نظر۔ تٔمؠ وُچھ سۅ زٲوِج کپر ژادر یُس یسوعؔ ولنہٕ ٲس آمٕژ مگر یسوعؔ اوس نہٕ کُنے۔ لہٰذا سُہ دراو مقبرٕ پؠٹھِ تتھ پؠٹھ حٲران گژھتھ یہِ سپدمُت اوس۔
\v 13 تمی دوٚہہ ٲسؠ یسوعؔ سنٛدؠ زٕ شٲگرد اماوس ناوٕکس گامس کُن پکان یُس یروشلمہٕؔ پؠٹھٕ تقریبن دہ کلومیٹر دوٗر اوس۔
\v 14 تِم ٲسؠ پانہٕ وٲنؠ تِمن چیزن متعلق کتھٕ کران یِم یسوعؔ ہس پیش آیہِ۔
\v 15 تِم ٲسؠ یِمے کتھٕ کران، یسوعؔ ووت یِمن نِشہ تہٕ لوگُن تِمن سٟتؠ پکُن۔
\v 16 پوٚز خداین دِیت نہٕ تِمن محسوس کرنہٕ زِ یہِ اوس یسوعؔ۔
\v 17 یسوعؔن ووٚن تِمن، "توٚہؠ زٕ کمہٕ کتھٕ چُھو پکان پکان کران؟ تِم ٹھہرییہِ، تِہنٛدین بتھِ پؠٹھ ٲس سیٹھاہ مایوسی۔
\v 18 تِمو منٛزٕ کلییاس ناوک اکؠ شخصس ووٚن در جواب، "ژٕ آسکھ صرف اکھ نفر یُس یروشلم کُن پکان چُھ یمِس نہٕ پتاہ چھِ تِمن واقاتن متعلق یِم حالہٕ کیٚن دوٚہُن منٛز پیش آیہِ!"
\v 19 تٔمؠ ووٚن تِمن، "کٔم واقات؟" تِمو ووٚن، "تِم واقات یِم ناصرت کِس شخصس، یسوعؔ ہس پیش آیہِ یُس اکھ نبی اوس۔ خداین اوس تمِس معجزٕ ہاونُک زبردس طاقت عطا کوٚرمُت بیٚیہِ اوس حٲران کرناواجنؠ تعلیم دِوان۔ اکثر لوٗکن ہُنٛد سونچ اوس زِ سُہ اوس قدرت تھاوان وول۔
\v 20 مگر سانیو کاہن سردارو تہٕ زِٹھیو کوٚر سُہ رومی حٲکمن حوالہٕ۔ تِمو دِیت تمِس موتُک سزا، تہٕ تِمو گنڈ سُہ أکِس صلیبس تہٕ کوٚرکھ قتل۔
\v 21 اسہِ ٲسؠ امید زِ یہےَ دِیہ اسرائیل کیٚن لوٗکن پننؠن دشمنو نِشہ نجات! پوٚز وُنؠ چُھنہٕ یہِ ممکن باسان۔ تنہٕ گییہِ ترٛے دوٚہہ ییٚلہِ رومیو سُہ قتل کوٚر۔
\v 22 امہِ باوجود، کینٛژو زنانو کٔر سٲنؠ جماعت حٲران۔ از صبحس گییہِ تِم زنانہٕ تتھ مقبرس پؠٹھ ییٚتہِ یسوعؔ دفن کوٚرمُت اوسُکھ۔
\v 23 مگر یسوعؔ سنٛز میت ٲس نہٕ تتہِ! تِم آیہِ واپس تہٕ وونُکھ اسہِ زِ تِمو ٲسؠ کینٛہہ فرشتہٕ وُچھمٕتؠ یمو ووٚن زِ سُہ اوس زندٕ!
\v 24 اسہِ منٛز گییہِ کینٛہہ تتھ مقبرس پؠٹھ۔ تِمو وُچھ زِ ہر کانٛہہ چیز اوس تیٖ یہِ تِمو زنانو ووٚنمُت اوس۔ پوٚز تِمو وُچھ نہٕ یسوعؔ۔"
\v 25 پتہٕ ووٚن یسوعؔن تِمن، "توٚہؠ زٕ چُھو کم عقل! تُہنٛد ایمان چُھ دِلہٕ کمزور ییٚلہِ زن ساروےٕ رسولو چُھ مسیحؔ ہس متعلق لیٚوکھمُت!
\v 26 توٚہہِ پزِ یقیٖنن زانن زِ مسیحؔ ہس ٲسؠ تِم سٲری تکلیف تُلن ضروری پتہٕ خدایہِ سٕنٛدِ طرفہٕ بوٚڈ اعزاز حٲصل کرُن!"
\v 27 \f + \fr 24‏:27 \ft یوحناؔ 1:45، لوقا 24:44، تثنِیہ شرع 18:15\f* پتہٕ کٔر یسوعؔن تِمن سارنےٕ کتھن ہنٛز وضاحت یمہٕ زن نوشتن منٛز تمِس متعلق آسہ۔ تٔمؠ کوٚر موسیٰؔ سٕنٛدِ لیکھمٕتہِ پؠٹھٕ شروع، پتہٕ کٔر تٔمؠ تِمن سارنےٕ نبین ہنٛز وضاحت یِمو لیٚوکھمُت اوس۔
\v 28 ییٚلہِ تِم تتھ گامس نکھٕ وٲتؠ یوٚت تِم زٕ شخص گژھان ٲسؠ، یہِ باسیوو زِ یسوعؔ روٗد وتہِ برونٛہہ کُن پکان۔
\v 29 پوٚز تِمو کوٚر تمِس زارٕ پارٕ یہِ مٕہ کٔر۔ تِمو ووٚننس، "از راتس روز اسہِ سٟتؠ، تکیازِ وُنؠ گوٚو ژیر تہٕ شام اوس ہیوان سپدُن۔ "لہٰذا سُہ ژاو تتھ گرس تِمن سٟتؠ روزنہٕ باپتھ۔
\v 30 ییٚلہِ تِم کھؠنہٕ خٲطرٕ بیٹھؠ، یسوعؔن تُجہ کینٛہہ ژوٚٹ تہٕ کوٚرن خدایہِ سُنٛد شُکرانہٕ ادا۔ پتہٕ پُھٹراین تِم تہٕ لوٗگ تِمن دون شخصن کینٛہہ دِنہِ۔
\v 31 پتہٕ دِژ خداین تِمن تمِس پرزناونچؠ صلٲحیت۔ پوٚز سُہ سپد ؤلؠ ؤلؠ غٲب!
\v 32 تِمو ووٚن اکھ أکِس، "ییٚلہِ أسؠ وتہِ پکان ٲسؠ تہٕ سُہ اوس اسہِ نوشتہٕ سمجاوان، اسہِ سپز انٛدرؠ حٲرانی! یہِ لوگ حس زِ مسیحؔ ہس ٲسؠ تکلیف تُلنؠ تہٕ پتہٕ سپدس تھوٗد احترام حٲصٕل۔
\v 33 لہٰذا ؤتھؠ تہٕ گۓ تِم یروشلم واپس۔ تتہِ لٔبکھ تِم کاہ رسول تہٕ بیٚیہِ کینٛہہ نفر یِکوٹہٕ۔
\v 34 تِمو رسولو ووٚن تِمن دون شخصن، "یہِ چُھ پوٚز زِ یسوعؔ چُھ دُبارٕ زندٕ سپدمُت۔ سُہ سپد شمعونسؔ نِشہ ظٲہر!
\v 35 پتہٕ ووٚن تِمو دویو شخصو باقین یہِ وتہِ منٛز یہِ سپد ییٚلہِ تِم پکان ٲسؠ۔ تِمو ووٚن تِمن بیٚیہِ زِ تِمو پرزٕنوو یسوعؔن یِتھۓ تٔمؠ ژوٚٹ تِمن ژٹتھ دِژ۔
\v 36 تِم ٲسؠ تِمن یی ونان زِ یسوعؔ سَپد تِمن نِشہ ظٲہر۔ تٔمؠ ووٚن تِمن، "خدایہِ دِنوو سلامتی!"
\v 37 مگر تِمن گییہِ غوطن۔ تِمن سپدؠ حٲران بیٚیہِ کھوژؠ تکیازِ تِمو سونچ زِ تِم ٲسؠ زنہٕ اکھ روح وچھان!
\v 38 تٔمؠ ووٚن تِمن، "توٚہہِ پزِ نہٕ کھوژُن! تہٕ توٚہہِ پزِ نہٕ شک کرُن زِ بہٕ چُھس زندٕ۔
\v 39 میٲنؠ اتھٕ تہٕ کھۅر وُچھِو! تٔمہِ سٟتؠ ہیکیو توٚہؠ یقین کٔرِتھ زِ یہِ چُھس پزؠ پٲٹھؠ بےٕ۔ روحن چُھنہٕ جسم آسان یتھٕ پٲٹھؠ مےٚ چھِ تہٕ توٚہؠ ہیکیو یہِ ثٲبتھ کرنہٕ خٲطرٕ مےٚ اتھٕ لٲگتھ زِ یہِ چھِ میٚون اصلی جسم۔"
\v 40 یہِ ؤنِتھ ہاوؠ تٔمؠ تِمن پنٕنؠ اتھٕ تہٕ کھۅر۔
\v 41 تِم گییہِ تیوٗت خوش زِ تِمن اوس نہٕ وُنہِ تہِ بھروسہٕ یوان زِ سُہ اوسا پزِ پٲٹھؠ زندٕ۔ لہٰذا تٔمؠ ووٚن تِمن، "کیاہ توٚہہِ نِشہ چھا کھینہٕ باپتھ کینٛہہ یُس بہٕ کھیٚتھ ہیٚکہٕ؟"
\v 42 أتؠ أنؠ تِمو بُزمژِ گاڈِ ہنٛز اکھ گٔنؠ تہٕ دِژکھ تسَ۔
\v 43 تٔمؠ تُج تہٕ کھیٚین تِمن برونٛہہ کنہِ۔
\v 44 تٔمؠ ووٚن تِمن پتہٕ، "بہٕ وُنہٕ توٚہہِ تِمے کتھٕ یِم مےٚ توٚہہِ وزِ وزِ ونہِ مٕژ آسہٕ مو ییٚلہِ بہٕ توٚہہِ سٟتؠ برونٛٹھ اوسس۔ خدایس اوس تہِ سورے انجام انُن یہِ تٔمؠ تمام نوشتن منٛز مےٚ مسیحؔ ہس متعلق ونمُت اوس۔"
\v 45 پتہٕ مُژر تٔمؠ تُہنٛد دماغ یُتھ زن تِمن نوشتہٕ فِکرِ ترن۔ تٔمؠ ووٚن تِمن،
\v 46 \f + \fr 24‏:46 \ft یسعیاہؔ 53:5، لوقا 24:7\f* "یہِ چُھ تیٖ یُس توٚہؠ نوشتن منٛز پٔریتھ ہیکیو زِ مسیحؔ ہس چھِ دۅکھ وؠترٕنؠ تہٕ قتل سپدن، مگر تمہِ پتہٕ تریمہِ دوٚہہ گژھِ سُہ دُبارٕ زندٕ۔
\v 47 نوشتن منٛز چُھ یہِ تہِ لیکھتھ زِ مسیحؔ ہس پؠٹھ ایمان تھاوان وٲلؠ نیرن تٔمؠ سنٛدِ بدلہٕ تہٕ ونُن زِ خدایہِ دییہِ تِمن معٲفی یِم گناہو نِشہ لوٗب روٗزن۔ بہٕ چُھس یژھان زِ توٚہؠ کٔرِو یہِ یروشلمہٕؔ پؠٹھٕ شروع پتہٕ گژھو دنیاہکس پرٛتھ کُنہِ قومس نِشہ۔
\v 48 توٚہہِ چُھ لوٗکن تہِ ضرور ووٚننُ زِ مےٚ پؠٹھ سپد تہِ سورےٕ یہِ نوشتن منٛز اوس وننہٕ آمُت زِ مسیحؔ ہس پؠٹھ سپدِ یہِ۔
\v 49 بہٕ چُھس توٚہہِ پاک روح سوزن وول، یِتھٕ پٲٹھؠ میٲنؠ ببن مےٚ وعدہ دِیت۔ مگر روزیٚو یتھ شہرس منٛز توٚت تام یوٚت تام نہٕ خدایہِ توٚہہِ پاک روح سُنٛد طاقت دِیہ۔"
\v 50 یسوعؔن نیٖ تِم شہرِ نیٚبر بیت عنیاہ گامس نزدیک۔ تتہِ پنٕنؠ اتھٕ تُلتھ دِژن تِمن برکتھ۔
\v 51 \f + \fr 24‏:51 \ft عملہٕ 1:19، زبُور 47:5\f* أتی دراو تِمن نِشہ تہٕ کھوٚت سُہ  آسمانس کُن۔
\v 52 تمِس عبادت کرنہٕ پتہٕ آیہِ تِم شادمٲنی سان یروشلم واپس۔
\v 53 پرٛیتھ دوٚہہ گییہِ تِم ہیکلس منٛز تہٕ تتہِ ٲسؠ پنُن وقت خدایہِ سنٛز عبادت کرنس منٛز گُذاران۔
