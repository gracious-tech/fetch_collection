\id ROM ROM - DMT
\toc1 رومؔ
\mt1 رومؔ
\c 1
\p
\v 1 بہٕ، پولُسؔ چُھس یہ خط لیٚکھان بہٕ چُھس یسوع مسیحؔ سنٛز خدمت کران۔ تٔمؠ بلووُس بہٕ پنٕنؠ ترجمٲنی کرنہٕ باپتھ تہٕ خاص پٲٹھؠ ژورنس بہٕ خدایہ سنٛز خۅش خبری ہنٛز پارَے دِنہٕ باپتھ۔
\v 2 امہِ برونہٛہ کوٚر خداین امہِ خۅش خبری ہُنٛد وعدٕ پننٮ۪ن تِمن ترجمان نبین ہنٛدِ ذریعہٕ یِمو امِچ پیشن گویی کٔر تہٕ مقدس نٔوشتن اندر یہِ لیٚکھِتھ تھوو
\v 3 یہ خۅش خبر چھےٚ خدایہ سنٛدِس گوبرس متعلق۔ تٔمؠ پروو بادشاہ داوود سنٛدِس زُرؠ سنٛدؠ رنگؠ اکھ فطری زایُن۔
\p
\v 4 پاک روحس سٟتؠ رٔلِتھ لوٚر خداین طاقتہٕ سان امیُک عملی مظٲہرٕ زِ یسوعؔ چھُ تمسُنٛد گوبر ییٚلہِ تٔمؠ سُہ تمہِ ساعتہٕ دُبارٕ زندٕ کوٚر ییٚلہِ سُہ مودمُت اوس خدایہِ سُنٛد گوبر چھُ یسوعؔ مسیحؔ، یُس سون خداوند چھُ۔
\v 5 یسوعنؔ کوٚر اسہِ پیٚٹھ فضل یِم تمسنٛدؠ ترجمان چھِ تہٕ دِتُن اسہِ پننہِ طرفہٕ پنٕنؠ ترجمٲنی کرنُک اختیار یُتھ زن سٲری قوم یسوعؔ مسیحسؔ پیٚٹھ بھروسہٕ کٔرِتھ خدایہِ سنٛز فرمانبردٲری کرن۔
\v 6 یسوعؔ مسیحؔ چھُو توٚہؠ تہِ ناد دِتھ أنؠ مٕتؠ یِم قومن منٛزباگ روزان چھِ۔
\v 7 بہٕ چھُس یہِ خط توٚہہِ سارنےٕ ایماندارن لیٚکھان یِم رومؔ کِس شہرس منٛز روزان چھِ۔ خدا چھُو توٚہہِ لول بران تہٕ توٚہؠ چھِنو ناد دِتھ أنؠ مٕتؠ یُتھ توٚہؠ تمسنٛدؠ لوٗکھ بٔنِو۔ سون بب خدا تہٕ خداوند یسوعؔ مسیحؔ روزِن ہٮ۪تھےٕ توٚہہِ پیٚٹھ مہربان تہٕ بنٲوؠ نو پُر امن۔
\v 8 ؤنؠ یۅسہٕ گۅڈنِچ کتھ بہٕ توٚہہِ ونٕنؠ یژھان چھُس، سۅ چھےٚ یہِ زِ بہٕ چھُس توٚہہِ سارنےٕ ہنٛدِ خٲطرٕ یِم مسیحؔ سنٛدؠ ایماندار چھِ، یسوعؔ مسیحؔ سنٛدِ ذریعہٕ میٲنِس خدایس پیٚٹھ ہٮ۪تھےٕ شکُر کران۔ بہٕ چھُس تمِس شکُر کران تیازِ سٲرؠ سےٕ معلوم دنیاہس منٛز چھِ لوٗکھ اعلان کران زِ توٚہؠ کِتھہٕ پٲٹھؠ چھُو یسوعسؔ پیٚٹھ بھروسہٕ کران۔
\v 9 بہٕ ہیٚکہٕ پزرٕ سان یہِ ؤنِتھ تکیازِ خدا چھُ میانہِ خٲطرٕ گوٲہی دِوان زِ بہٕ چھُس وقتہٕ وقتہٕ تہنٛدِ خٲطرٕ دعا منٛگان۔ بہٕ چھُس تمسنٛدِس گوٚبرس، یسوعسؔ متعلق خۅش خبری ہنٛز پارَے دِنہٕ ذریعہ سۅ دِلہٕ تمسنٛز خدمت کران۔
\v 10 ییٚلہِ بہٕ دعا منٛگان چھُس گاہ بٮ۪گاہ گذٲرش کران زِ ٲخرس گژھٕ بہٕ توٚہہِ سٟتؠ ملاقات کرنس منٛذ کامیاب تکیازِ خدا چھُ مےٚ نِش یی یژھان۔
\v 11 بہٕ چھُس امہِ خٲطرٕ دعا منٛگان تکیازِ بہٕ چھُس سۅ دِلہٕ خوٲہِش تھاوان توٚہہِ ذٲتی طور سمکھُن یُتھ بہٕ پاک روح نِش پروومُت کُنہِ قسمُک فضلہٕ بوٚرُت تحفہٕ توٚہہِ سٟتؠ بٲگرِتھ ہیٚکہِ یُتھ زن توٚہہِ روحٲنی طور مضبوط گژھنس منٛز مدد سپدو۔
\v 12 دویمٮ۪ن لفظن منٛز چھُس بہٕ یژھان فضلہٕ بٔرٕژ کانہٛہ ڈٲلؠ توٚہہِ سٟتؠ بٲگرٕنؠ یُتھ زن أسؠ باہم اکھ اکِس حوصلہٕ افزٲیی ہیٚکو کٔرِتھ۔ توٚہؠ تہٕ بہٕ دۅنوے ہیٚکو یہِ بٲگراونہٕ دٔسؠ اکھ اکِس مدد کٔرِتھ زِ أسؠ کتھہٕ پٲٹھؠ چھِ اکھ اکِس سٟتؠ رٔلِتھ خدایس پیٚٹھ پژھ تھاوان۔
\v 13 میانیٚو ایماندار سٲتھیٚو، بہٕ چھُس پٔزؠ پٲٹھؠ یژھان زِ توٚہؠ گٔژھِو زانٕنؠ زِ مےٚ کوٚر واریاہہِ پھرِ توٚہہِ سمکھنُک اِرادٕ۔ ووٚنؠ گوو خداین روٚٹُس بہٕ موجود وقتس تام توٚہہِ سمکھنہٕ نِشہٕ پتھ۔ مےٚ اوس توٚہہِ نِش یِنُک منصوبہ یُتھ بہٕ توٚہہِ منٛز تہِ کینٛژن لوٗکن مسیحسؔ پیٚٹھ ایمان اننس کُن وتھ ہاوِ یتھٕ پٲٹھؠ مےٚ یہِ کٲم باقین قومن منٛز تہِ کٔرمٕژ چھےٚ۔
\v 14 بہٕ چھُس تمام غٲر یہُودؠ لوٗکن خۅش خبری ہنٛز پارَے دِنُک پابند، ادٕ تِم ادبہٕ رنگؠ یونٲنؠ ٲسؠ تن یا تعلیم یافتہٕ ٲسؠ تن یا متہٕ ٲسؠ تن۔
\v 15 تہٕ ییٚلہِ ہرگاہ یہِ مینؠ مرضی آسہِ ہے، بہٕ کرہا خۅشی سان توٚہہِ منٛز خۅش خبری ہُنٛد اعلان یِم شہرِ رومسؔ منٛز روزان چھِ۔
\v 16 بہٕ کرہا خۅشی سان یہِ کٲم تکیازِ خۅش خبری ہُنٛد اعلان کرنہٕ سٟتؠ چھےٚ مےٚ سٮ۪ٹھا عزت افزٲیی سپدان تکیازِ یہِ چھُ سُہ طاقتہٕ وول طریقہٕ یُس خدا کٲنٛسہِ أکِس تہِ نجات بخشنہٕ خٲطرٕ استعمال کران چھُ یُس اتھ پیٚٹھ ایمان انان چھُ۔ یہِ چھےٚ حقیقت تِمن دۅنوٕنؠ یہودٮ۪ن ہنٛدِ خٲطرٕ، یِمو یہِ خۅش خبر گۅڈٕ بوز تہٕ ادٕ باقےٕ پرٛتھ کٲنٛسہِ ہنٛدِ باپتھ\f + \fr 1‏:16 \ft 2 تموتھی 1:8\f*۔
\v 17 یہِ چھُ پوٚز تکیازِ ییٚلہِ تہِ زانہٛہ کٲلؠ لوٗکھ خۅش خبری ہُنٛد اعلان کران چھِ، تِم چھِ یہِ ظٲہر کران زِ خدا کِتھہٕ پٲٹھؠ چھُ لوٗکن راستباز بناوان، یُس مکمل پٲٹھؠ مسیحسؔ پیٚٹھ بھروسہٕ کرنہٕ دٔسؠ سپدان چھُ۔ یہِ چھُ تی یہِ حبقوقؔ نبی سُنٛد مطلب اوس ییٚلہِ تٔمؠ صحیفن منٛز لیکھِتھ تھوو۔ "پوٚز سُہ شخص یمِس خدا راستباز بناوان چھُ، روزِ خدایس پیٚٹھ پژھ تھاونہٕ ذریعہٕ ہمیشہٕ خٲطرٕ زنٛدٕ"\f + \fr 1‏:17 \ft حبق 2.4؛ گلتی 3.11؛ عبر10.38\f*
\v 18 یہِ چھُ پوٚز تکیازِ یتہِ خدا آسمانس پٮ۪ٹھ روزان چھُ تتہِ پیٚٹھٕ چھُ سُہ ظٲہر کران زِ سُہ کِتھہٕ پٲٹھؠ چھُ تمِس پرٛتھ کٲنٛسہِ شخصس پیٚٹھ نارو نار یُس خدا دُشمن تہٕ نارٲستی ہنٛزٕ کامہِ کرِ تہٕ کرِ تہنٛزِ عدالت۔ اکہِ نارٲستی ہنٛز زندگی گُذٲرِتھ چھِ یِم لوٗکھ تِم چیز دبٲوِتھ تھاوان یِم خدا ونان چھُ زِ تِم چھِ پٔزؠ۔
\v 19 خدا کرِ تِمن عدالت تکیازِ یہِ کینٛژا کانہٛہ شخص خدایس متعلق زٲنِتھ ہیٚکہِ سُہ چھُ یِمن لوٗکن پیٚٹھ نوٚن تکیازِ خداین چھُ یہِ تہنٛدِ خٲطرٕ ٹاکارٕ بنوومُت
\v 20 یہِ چھُ پوٚز تکیازِ لوٗکھ ہیٚکن واضیح پٲٹھؠ خدایس متعلق تِمن چیزن ہُنٛد تجربہٕ کٔرِتھ یِم نہٕ تِم پننٮیٚو أچھو سٟتؠ وُچھِتھ ہیٚکن۔ یِم چیز چھِ یِم زِ خدا کوتاہ طاقتہٕ وول چھُ تہٕ بیٚیہِ یہِ پزر زِ سُہ چھُ خدا۔ تمہِ وقتہٕ پیٚٹھٕ ییٚلہِ خداین کاینات پٲدٕ کوٚر، ہیٚکن لوٗکھ یِمن چیزن ہُنٛد مشٲہدٕ کٔرِتھ۔ یِمو چیزو وُچھ تِم چیز سمجھمٕتؠ یِم خداین بنٲوؠ مٕتؠ چھِ۔ امہِ وجہہ سببہٕ ہیٚکن نہٕ لوٗکھ یہِ کتھ تسلیم کرنہٕ نِشہٕ لوٚب روزنُک بہانہٕ کٔرٕتھ زِ خدا چھُ موجود۔
\v 21 لوٗکھ ہیٚکن نہٕ پنٕنؠ پان لوٚب رٔٹِتھ تکیازِ تِم چھِنہٕ خدایہِ سنٛدِ رنگؠ تس تعظیم کران ہرگاہ تِم یہِ زانان تہِ چھِ زِ سُہ چھُ وجود تھاوان۔ تِم چھِ تمسُنٛد شکُر کرنس تہِ انکار کران۔ اتھ مقابلہٕ چھِ تِم مۅلہٕ روس چیزن متعلق سونچان، تہٕ تِم چھِنہٕ روحٲنی چیز سمجھنس لایق۔
\v 22 ہرگاہ تِم یہِ دعوا کران چھِ زِ تِم چھِ گاٹٕلؠ، تِم چھِ عملی طور نادان۔\f + \fr 1‏:22 \ft یرمیاہ 10:14\f*
\v 23 تِم چھِ تمِس خدایس جلال دِنہٕ نِشہٕ پوٚت ہیٚوان یُس لافٲنی چھُ تہٕ امہِ بجایہ چھِ تِم تِمن پۅتلٮ۪ن جلال دِوان یِم فٲنی انسانن، جاناوارن، چارواین تہٕ تِمن جانورن سٟتؠ مشاہبت تھاوان یِم زمینہِ پیٚٹھ یٔڈ کھکھرِ پکان چھِ۔\f + \fr 1‏:23 \ft اِستِثنا 4:15-19؛ زبور 106:20\f*
\v 24 نتیجہٕ رنگؠ چھُ خدا یِمن لوٗکن تمہِ شہوژ بٔرژٕ کامہِ کرنہٕ دِوان یِمہٕ کرنچؠ تِمن خوٲہِش آسان چھےٚ، یُتھ تِم روحٲنی طور ناپاک سپدن تہٕ اکھ اکِس سٟتؠ جنسی طور اخلاق سوز کامہِ کرنہٕ دٔسؠ کرن پننٮ۪ن جسمن ہنٛز بے حُرمتی۔
\v 25 یِم لوٗکھ چھِ تتھ پیٚٹھ ایمان اننہٕ نِشہٕ پوٚت ہیٚوان یہِ خدایس متعلق پوٚز چھُ تہٕ امہِ بجایہ چھِ تتھ پیٚٹھ یقین کران یہِ پۅتلٮ۪ن متعلق اپُز چھُ۔ تِم چھِ تعظیمہٕ سان تِمن چیزن ہنٛذ عبادت کران یِم خداین پٲدٕ چھِ کٔرؠ مٕتؠ۔ بجایہ تمِس خدایس عبادت کرنہٕ نِشہٕ یمؠ یِم چیز پٲدٕ کٔرؠ۔ سُے چھُ سُہ یمِس لوٗکن پزِ ہر ہمیشہٕ تھزر تہٕ بجر دیُن۔ یی سپدِن۔\f + \fr 1‏:25 \ft یرمیاہ 13:25؛ 16:19\f*
\v 26 تکیازِ یِم لوٗکھ چھِ تہِ کران، خدا چھُ تِمن ذلالتچہِ تِم کامہِ کرنہٕ دِوان یِم کرنٕچ تِمن زبردس خوٲہِش چھےٚ آسان۔ مثالہِ پٲٹھؠ تہنٛزٕ زنانہٕ چھےٚ مرد سٟتؠ فطری جنسی عمل کرنہٕ نِشہٕ پوٚت ہیٚوان تہٕ امہِ بجایہ چھےٚ زنانن سٟتؠ غٲر فطری جنسی عمل کران۔
\v 27 یِتھے پٲٹھؠ چھِ مرد تہِ زنانن سٟتؠ فطری جنسی تعلق بناونہٕ نِشہٕ پوٚت ہیٚوان تہٕ چھِ شدتہٕ سان بیٚین مردن کُن شہوت تھاوان۔ یِم مرد چھِ اکھ اکِس سٟتؠ بے شرمی ہنٛدؠ جنسی کار کران۔ تِم چھِ پننٮ۪ن نےٕ جسمن انٛدر خدایہ سُنٛد تِمن سزا دِنُک تجربہٕ کران۔ خدایس پزِ تِمن سزا دیُن تکیازِ تِم چھِ خدایہِ سنٛزن مقرر کرنہٕ آمژن فطری جنسی عملن بے راہ روی کران۔\f + \fr 1‏:27 \ft احبا 18:22، 20:13\f*
\v 28 ییٚلہِ یِتھیٚو لوٗکو یہِ سونچ زِ خدا تسلیم کرُن چھُ بے مۅل، خداین دیُت تہنٛدٮ۪ن دماغن بے مۅل بننہٕ۔ نتیجہٕ دراو یہِ زِ تِم چھِ ناسہٕ تراسہٕ کران۔
\v 29 یِمن لوٗکن چھِ تمام قسمٕکؠ نارٲستی، بدکٲری، لالچ تہٕ بدی ہنٛدؠ خیال مکمل پٲٹھؠ کاپہِ رٔٹِتھ۔ تِم چھِ حسدی بننہٕ خٲطرٕ، بیٚیہِ کٲنٛسہِ ہنٛز زندگی تھپہِ نِنہٕ خٲطرٕ مکمل پٲٹھؠ آمادٕ۔ تِم چھِ بیٚین نٛدؠ راز نٔنؠ کڈان۔
\v 30 تِم چھِ بیٚین لوٗکن متعلق غلط کلام کران۔ تِم چھِ خدایس سٟتؠ نفرت کران۔ تِم چھِ تشدُد دار کامہِ کران۔ تِم چھِ پانس متعلق واریاہ تھوٚد سونچان۔ تِم چھِ پانس متعلق تھٮ۪کہٕ تھٮ۪کہٕ کران۔ تِم چھِ نوٮ۪ن قسمن ہنٛزٕ بُرٕ کامہٕ کرنس متعلق سونچان۔ تِم چھِنہٕ پننٮ۪ن مالیٚن ماجیٚن ہنٛز فرمانبردٲری کران۔
\v 31 یِم لوٗکھ چھِ اخلٲقی طور نادان۔ تِم چھِنہٕ تہِ کران، یہِ کرنُک تِم وعدٕ دِوان چھِ۔ تِم چھِنہٕ بیٚین لوٗکن ہُنٛد پرواے بران۔ تِم چھِ باقین خٲطرٕ بےٚ رحم۔
\v 32 یِم لوٗکھ چھِ پوٗرٕ پٲٹھؠ سمجھان زِ خدا چھُ راستبٲزی سان اعلان کران زِ تِم لوٗکھ یِم ہٮ۪تھےٕ یِژھٕ ناسہٕ تراسہٕ کامہِ چھِ کران، چھِ تِم روحٲنی طور مرنٕکؠ حقدار۔ تمہِ پتہٕ تہِ چھِ تِم نہ صرف ہٮ۪تھےٕ یِم ناسہٕ تراسہٕ کامہِ کران، بلکہِ چھِ تِم خوشی سان تِمن لوٗکن ہنٛز واہ وٲہی کران یِم یِژھٕ کامہِ کران چھِ۔
\c 2
\p
\v 1 اوے تہِ توٚہہِ منٛزٕ سُہ کانہٛہ تہِ یُس دویمیٚن ہنٛدِس کرنس کراونس پیٚٹھ کانہٛہ فٲصلہٕ دِیہِ، ہیٚکہِ نہٕ پانس ہرگِز مُچھِ تھٲوِتھ ییٚلہِ خدا تس کہوٹ لاگہِ۔ تکیازِ یمہِ وِزِ ژٕ باقین ہنٛز عٲب جویی کران چھُکھ، ژٕ چھُکھ ژکہِ پنٕنؠ عٲب جویی کران۔ یہِ چھُ اوٕ کِنؠ زِ یمہِ وِزِ ژٕ یہِ باقین ہنٛدِس کرنس کراونس کۅدٕ کڈان چھُکھ، ژٕ چھُکھ پانہٕ تی کران یہِ تِم کران چھِ۔
\v 2 یقیناً چھِ أسؠ مانان زِ خدا چھُ تِمن لوٗکن صحیح پٲٹھؠ عدالت کران یِم ہٮ۪تھےٕ یِژھٕ وٮ۪کھژٕ کامہِ کران چھِ۔
\v 3 یِم باقین ہنٛزن وٮ۪کھژن کامیٚن پیٚٹھ فٲصلہٕ دِوان چھِ ییٚلہِ زن پانہٕ تہِ یی کران روزان چھُو، ہیٚکِو نہٕ یتھ گمانس تل روزِتھ زِ توٚہؠ کیا بٔچِو ییٚلہِ خدا پنُن فٲصلہٕ بوزناوِ۔
\v 4 توٚہؠ، یِم منساوان چھُو زِ خدا کوتاہ مہربان، صٲبر تہٕ وٮ۪تراون وول چھُ، زٲنِو یہِ کتھ زِ خدا سنٛز کانہٛہ مہربان عمل چھےٚ ژکہِ توٚہہِ پننس کرنس پیٚٹھ پشیمان کرنہٕ باپتھ۔
\v 5 اتھ برعکس یودوے توٚہؠ ہٹ دھرم روزِو پشیمان سپدنس انکار کٔرِو، تیٚلہِ دِیو توٚہہ خدا یمہِ کھۅتہٕ ژوٚر سزا۔ یہ سپد ییٚلہِ خدا گناہگارن سزا دِیہِ تہٕ یہِ کتھ ہاوِ زِ سُہ کوتاہ عدلہٕ سان چھُ انصاف کران۔
\v 6 خدا دِیہِ عدلہٕ سان پرٛتھ کٲنٛسہِ پننہِ کرنہٕ کراونہٕ کِنؠ سزا یا انعامہٕ۔
\v 7 ابدی زندگی چھےٚ خدایہِ سُنٛد فضل تمن ہنٛدِ باپتھ یِم خدایہِ سنٛز وتہٕ گاران روزن تاکہِ تِمن پھلراوِ سُہ تھدِ مرتبہٕ عزت تہٕ پوشوٕنؠ زندگی دِتھ۔ یتھؠ لوٗکھ چھِ نیکی ہنٛزِ وتہِ پیٚٹھ درِتھ روزِتھ پراوان۔
\v 8 اتھ برعکس دِیہِ خدا تمن سارنےٕ لوٗکن سزا یِم نکار کرن خدایہِ سنٛدِس تتھ کلامس یتھ سُہ پوٚز تہٕ صحیح ونان چھُ تکیازِ یِتھؠ لوٗکھ چھِ خود غرضی کِنۍ خود پسند۔
\v 9 خدا کر بناوِ تِمن سارنےٕ لوٗکن بے تسلا تہٕ دۅکھل یِم کھۅچہِ وتہِ پیٚٹھ روزن۔ یہِ سپدِ خاص پٲٹھؠ تمن یہُودین سٟتؠ یِم بد کار کران روزن تہٕ یِتھؠ بد کار والیٚن باقین لوٗکن سٟتؠ تہِ۔
\v 10 اتھ برعکس بخشہِ خدا روشن مرتبہٕ، عزت تہٕ تسلی تِمن سارنےٕ یِم رٕتؠ تہٕ نیک کار کرن۔ یہِ سپدِ خاص پٲٹھؠ تِمن یہُودین سٟتؠ تہٕ باقےٕ لوٗکن سٟتؠ تہِ یِم نیک کار کرن۔
\v 11 یہِ چھُ پوٚز تکیازِ خدا چھُ بے تعصب\f + \fr 2‏:11 \ft اِستِثنا 10:17، 2 توٲریخ19:7\f*۔
\v 12 أسؠ چھِ خدایس متعلق یہِ زانان زِ سُہ دِیہِ تِمن ابدی سزا تِمن سارنےٕ لوٗکن یِم گناہ کران روزن۔ یہودیٚن خدایہِ سنٛدؠ دِنہٕ آمٕتؠ قانون زاننہٕ ورٲے ہرگاہ زن تِمن یِمن قانونن ہنٛز خبر تہِ آسہِ نہٕ۔ أتھؠ وقتس دوران پرکھاوِ خدا تِمن تہِ یِم قانون زٲنِتھ تہِ گناہ کرن۔
\v 13 خدا لاگہِ عدالت تِمن سارنےٕ یِم گناہ کرن۔ تکیازِ خدا چھُنہٕ تِمن راستباز بناون وول یِم قانون صرف کنو بوزن۔ خدا بناوِ تِمن راستباز یِم قانون عملاون۔
\v 14 خدا لاگہِ عدالت پرٛتھ کٲنٛسہِ یُس گناہ کرِ۔ تکیازِ ییٚلہِ تہِ کانہٛہ قوم یہودیٚن دِنہٕ آمٕتؠ قانون زانہِ نہٕ، مگر فطرتن پالہِ یِم قانون، چھُ یہِ کتھ ثٲبت کران زِ سُہ قوم چھُ پننہِ عقلہِ منٛز یِم قانون زانان۔ یودوے یہِ خبر چھُکھ نہٕ زِ یِم قانون چھِ خدایہِ سنٛدؠ۔
\v 15 قدرتی طور یِم قانون پٲلِتھ یِم خداین موسیٰ ؔ سنٛدِ ذریعہٕ سوزؠ۔ چھِ یِم لوٗکھ یتھ کتھِ درشاوان زِ خداین چھُ پرٛتھ کانہٛہ پنٕنؠ قانون پالنہٕ باپتھ آگاہ کوٚرمُت۔ تِیُنٛد امہِ آیہِ سونٛچُن چھُ یہِ کتھ ہاوان زِ یی چھُ پوٚز یہِ یِم شخص سونچان چھِ یا تہٕ بناوِ تہٕ تِمن مجرم نتہٕ کریٚکھ بچاو پننہِ عملہِ منٛز۔
\v 16 یہِ سپدِ ییٚلہِ خدا تہنٛدٮ۪ن گُپِتھ سونٛچن چھیکرس عدالت لاگہِ۔ خدایہِ سنٛز رٕژ شیٚچھ یمِچ بہٕ تُرے دِوان چھُس، چھےٚ اسہِ یہ تعلیم دِوان زِ خدا لاگہِ اسہِ عدالت یسوع مسیحؔ سنٛدِ ذریعہٕ۔
\v 17 وۅنؠ چھُس بہٕ توٚہہِ مخٲطب یِم پانس یہُودؠ گنٛزران چھِ۔ توٚیؠ چھُ دٔرِتھ قانونن پیٚٹھ یِم خداین دتِو۔ خدایہِ سنٛدِ عدالژ نِشہٕ بچنہٕ باپتھ۔ توٚہؠ چھُو تھیٚکان زِ توٚہؠ زٲنِو خدایس۔
\v 18 توٚہؠ چھُو زانان زِ خدا کیا چھُ یژھان۔ امہِ مزید ینہٕ کینٛژو لوٗکو توٚہہِ تعلیم دِژ خدایہِ سنٛدین قانونن متعلق، توٚہؠ چھُو مانان یہِ کینٛژھا اعلیٰ چھُ۔
\v 19 توٚہہِ چھُو پانس بیٚہنوومُت زِ توٚہؠ یہُودؠ چھُو باقےٕ غٲر یہودیٚن یِم نہٕ خدایس متعلق زانان چھِ تعلیم دِنس قٲبل، توٚہہِ چھو یہِ کتھ سٮیٚکہٕ بہتھ زِ چھرا ہیٚکِو توٚہؠ نافہم بے زان لوٗکن خدایس متعلق کینہٛہ سمجھٲوِتھ۔
\v 20 توٚہہِ چھَو پانس یہِ کتھ بیٚہنٲومٕژ زِ توٚہہِ پزن باقےٕ یِم بے عقل چھِ ہیٚچھناوٕنؠ۔ توٚہہِ چھَو یہِ کتھ تہِ پانس بیٚہنٲومٕژ زِ توٚہہِ پزِ باقین یِم دۅدٕ ہیڈرن یعنی شُریٚن ہنٛدؠ پٲٹھؠ یِم بے خبر چھِ تعلیم دِنؠ۔ توٚہؠ چھُو امہِ آیہِ سونچان اوٕ کِنؠ زِ توٚہؠ چھُو تِم قانون زانان یِم زن خداین یہودیٚن دِتؠ یِمن منٛز تہِ سورےٕ چھُ یہِ أسؠ زٲنِتھ ہیٚکو تہٕ یہِ پوٚز چھُ۔
\v 21 اوے تہٕ یودوے زن توٚہہِ یہودیٚو پانس بیٚہنوومُت چھُ زِ یِم چیز چھِ پٔزؠ، پزِ توٚہہِ پانس تہِ یِم چیز کرنہٕ باپتھ تعلیم دِنؠ یۅسہٕ توٚہؠ باقین کرنہٕ باپتھ ونان چھُو، تکیازِ توٚہؠ چھُو نہٕ تِم چیز کران۔ توٚہؠ چھُو باقین ونان روزان زِ تِمن پزِ نہٕ ژوٗر کرٕنؠ، مگر توٚہؠ چھُو پانہٕ ژوٗر کران۔\f + \fr 2‏:21 \ft متی 23:3\f*
\v 22 توٚہؠ چھُو اکِس بیٚیِس لٔگتھےٕ ونان روزان زِ جنسی تعلقات مٕہ کرِو قٲیِم تِمن سٟتؠ یِمن سٟتؠ نہٕ توٚہہِ نیتھٕر چھُ۔ مگر پانہٕ چھُو کران۔ توٚہؠ چھُو وننہٕ بوزنہٕ کِنؠ بُت پرستی خلاف۔ توٚہؠ چھُو تِمن مندرن چھلہٕ ودر کران ییٚتہِ پۅتٕلؠ آسن۔
\v 23 توٚہؠ چھُو تھیٚکان زِ توٚہہِ کوتاہ سمجھ چھُ قانونُک یِم خداین دتِو۔ مگر توٚہؠ چھُو یِمن نَہ مٲنِتھ خدایہِ سنٛز بے عزتی کران۔
\v 24 یِم چیز چھِ پٔزؠ تکیازِ یہِ چھُ تی یہِ یسعیاہؔ نبی سنٛدِ وننُک مطلب چھُ۔ تمؠ لیٚوکھ صحیفن منٛز، "کینہٛہ قوم چھِ خدایس توہین کران تکیازِ کمہِ کمین گی سان چھُو توٚہؠ یہُودؠ عمل کران۔\f + \fr 2‏:24 \ft یَشعیاہ 52، حزقی 36:20 \f*
\v 25 توٚہہِ گناہ کرن والیٚن یہودیٚن لگہِ عدالت تکیازِ ختنہٕ کرن چھُ توٚہہِ فٲید دوان ہرگاہ توٚہؠ خدایہِ سُنٛد دِنہٕ وول قانون پٲلِو۔ وۅنؠ گوو یودوے توٚہؠ یِم قانون پٲلِو نہٕ، تُہنٛد ختنہٕ کرناوُن واتناونہٕ توٚہہِ کانہٛہ فٲیدٕ۔\f + \fr 2‏:25 \ft یرمیاہ 4:4\f*
\v 26 اوے یودوے ختنہٕ ورٲے لوٗکھ خدایہِ سنٛدِ منشہٕ مطٲبق یہودیٚن دِنہٕ آمٕتؠ قانون راستبٲزی سان پالن، خدا گنٛزرِ یِمن بے ختنہٕ لوٗکن ختنہٕ والیٚن سٟتؠ۔
\v 27 تہٕ تِم لوٗکھ یِم بظٲہر بے ختنہٕ چھِ مگر خدایہِ سنٛدؠ قانون چھِ پورِ پور پالان پرکھاونو توٚہہِ یہودیٚن۔ گوو زِ توٚہؠ چھُو زانان خدایہِ سنٛدِ طرفہٕ یہودیٚن دِنہٕ آمٕتؠ لیٚکھِتھ قانون تہٕ بیٚیہِ چھُو ختنہٕ تہِ۔ مگر توتہِ چھُو نہٕ یِم قانون پالان۔
\v 28 یہِ چھُ پوٚز تکیازِ پوٚز یہُودؠ گو نہٕ سُہ یُس یہُودؠ رسمن پالہِ یِمن باقےٕ لوٗکھ تہِ وُچھِتھ ہیٚکن۔ یِتھے پٲٹھؠ ہیٚکن نہٕ لوٗکھ اصل غٲر رسمی ختنہٕ وُچھِتھ کٲنٛسہِ نفر سنٛدِس جسمس منٛز۔
\v 29 تکیازِ پوٚز یہُودؠ گو سُے یُس ظٲہرٕ بدلہٕ بٲطنی عملہِ پیٚٹھ روزِ۔ پوٚز ختنہٕ گوو یُس چٲنِس منس شیرِ تہٕ یہِ چھُ پاک روح انجام دِوان۔ چھرا لیٚکھِتھ ظٲہری قانون پالنہٕ سٟتؠ سپدِ نہٕ یہِ۔ خدا چھُ اکِس پٔزِس یہودِس تعریف کران۔ مٹھِ مٹھِ دِوان تہٕ باقےٕ لوٗکھ چھِنہٕ۔
\c 3
\p
\v 1 توٚہؠ یہُودؠ ما ونِو، "یودوے یہِ ژےٚ ووٚنُتھ پوٚز آسہِ، تیٚلہِ چھُنہٕ یہُودؠ آسُن کانہٛہ فضیلت۔ یقیناً چھُنہٕ ختنہٕ کرناوُن تہِ کانہٛہ فٲیدٕ بخش کار"
\v 2 تیٚلہِ ونو بہٕ، "یہُودؠ آسُن چھُ پزنہٕ پٲٹھؠ اکھ فضیلت واریاہو لِکھو" یہِ چھُ یقیناً پوٚز۔ تکیازِ ساروےٕ برونہٛہ کٔرؠ خداین پژھ یہودیٚن تہٕ رژھرِتھ تھاونہٕ باپتھ یہِ تمؠ ووٚن صحیفن منٛز\f + \fr 3‏:2 \ft رومؔ 9:4\f*۔
\v 3 اوے تہِ ہیٚکِو توٚہؠ یہِ ؤنِتھ زِ یِمو منٛز أسؠ کینہٛہ یہُودؠ خدایس یقیناً بے وفا۔ یِتھؠ لوٗکھ کٲتیاہ بے وفا چھِ، ہیٚکہِ نہٕ خدا سنٛدِس وفادار آسنس پھیش دِتھ۔
\v 4 توے ونہٕ بہٕ، "بالکل نَہ" اتھ اُلٹہٕ چھُ خدا ہر وِزِ پٔزؠ یور ییٚلہِ زن باقے سٲری ہیٚکن نہٕ ٲسِتھ۔ یہ چھُ تی یہِ داوود سُنٛد مطلب اوس ییٚلہِ تمؠ صحیفن منٛز لیٚوکھ، "میانہِ کُنہِ گنہُک تر چھُ یہِ زِ لوٗکھ مانن زِ ژٕ خدا چھُکھ صحیح ییٚلہِ زن ژٕ کینہٛہ ونکھ تہٕ فتح منٛد ییٚلہِ ژےٚ لوٗکھ پرکھاونچ کوشش کرن\f + \fr 3‏:4 \ft زبور 51:4، 116:11\f*۔
\v 5 وۅنؠ گوو ژٕ ما ونکھ، "مثالہِ پٲٹھؠ مٲنؠ تو یہِ چھُ پوٚز تہِ اسہِ یہُودین ہنٛدِ وتہِ ڈلِتھ آسُن چھُ درشاوان خدایہِ سُنٛد صحیح وتہِ پیٚٹھ آسُن۔ امیُک مطلب گو نہٕ زِ خدا کیا چھُ وتہِ ڈٔلِتھ۔ یودوے سُہ اسہِ سزا دِیہِ۔ ییٚلہِ بہٕ امہِ آیہِ کتھ کران چھُس، بہٕ چھُس عام انسٲنی سونچُک اظہار کران۔
\v 6 تیٚلہِ ونہٕ بہٕ، "بالکل نَہ" یودوے خدا ناراستباز آسہِ ہے ییٚلہِ سُہ اسہِ سزا دِیہِ، ممکن چھُ تیٚلہِ ہیٚکہِ نہٕ سُہ دنیاہس منٛز کٲنسے عدالت لٲگِتھ"
\v 7 وۅنؠ گو تیٚلہِ ہیٚکِو توٚہؠ ؤنِتھ، "مثالے مٲنؠ تو یہِ چھُ پوٚز۔ میون اپُز ونُن چھُ خدایس مزید عظمت بخشان تہٕ تسُنٛد پٔزؠ یور آسُن درشاوان۔ یودوے یی چھُ، تیٚلہِ گژھِ نہٕ یقیناً خدا مےٚ عدالت لاگُن یودوے بہٕ کانہٛہ گناہ کران آسہٕ۔
\v 8 تہٕ یودوے یہِ پوٚز چھُ تیٚلہِ پزِ توٚہہِ اسہِ ونُن زِ کرِو بدکٲری ہنٛز عمل تاکہِ رُت پرٮ۪زلہِ۔ یہِ چھُ بالکل تی یہِ کینہٛہ لوٗکھ اپُز مےٚ متعلق ونان چھِ تہٕ دعوا چھِ کران یہِ بہٕ ونان چھُس۔ خدایہ سنٛدِ خٲطرٕ چھِ تِمن لوٗکن مزمت کرٕنؠ صحی یِم امہِ آیہِ کلام کران تہٕ عمل کران چھِ۔
\v 9 توٚہؠ یہُودؠ ما ونِو تیٚلہِ، "یودوے توٚہہِ یہِ ونو پوٚز آسہِ، تیٚلہِ چھِنہٕ أسؠ باقےٕ غٲر یہُودیٚو نِشہٕ اعلیٰ" تہٕ بہٕ ونو بے شک چھِنہٕ أسؠ اعلیٰ۔ بہٕ چھُس یہِ ونان تکیازِ برونہٛہ ووٚن مےٚ زِ یہُودؠ کیو غٲر یہُودؠ ہیٚکن نہٕ گناہ کرٕنؠ ترٲوِتھ۔
\v 10 یہِ چھُ تی یہٕ نبیو ووٚن ییٚلہِ تمو لیٚوکھ صحیفن منٛز، "کانہٛہ تہِ چھُنہٕ راستباز، بلکہ کانہٛہ اکھ تہِ نہٕ"
\p
\v 11 \f + \fr 3: \ft واعظ 7:20 \f* "کہٕنؠ چھُنہٕ دانٲیی سان سونچان، کانہٛہ تہِ چھُنہٕ کوشش کران خدا زاننٕچ۔
\v 12 پرٛتھ کٲنسہِ چھُ خدایہ سنٛزِ فرمانبردٲری کرنس انکار کوٚرمُت، کلہُم چھِ تِم تہِ کرنہٕ خٲطرٕ ناقٲبل یہِ خدا یژھان چھُ۔ کانہٛہ تہِ چھُنہٕ رحم دل۔ بالکل نہ کانہٛہ"\f + \fr 3‏:12 \ft زبور 14:3، 53:1\f*
\q1
\v 13 "یہِ لوٗکھ ونان چھِ تہِ چھُ غٲر اخلٲقی زنتہٕ قبرن منٛز ہوٚژمژن لاشن ہنٛز بوے ہِش۔ تِم چھِ لگتھےٕ لوٗکن تارن گری کران پننہِ زیٚوِ سٟتؠ، پننہِ وننہٕ سٟتؠ چھِ تِم لوٗکن بُچھان کران۔ اکِس زہر بٔرتِس سرفہٕ سنٛدؠ پٲٹھؠ"\f + \fr 3‏:13 \ft زبور 5:9، 140:3\f*
\v 14 "تِم چھِ لگتھےٕ لوٗکن بد دعا کران تہٕ تِمن متعلق یُتھ تیُتھ ونان روزان"\f + \fr 3‏:14 \ft زبور 10:7\f*
\v 15 "تِم چھِ ہُش مُش لوٗکن قتل کرنہٕ دوران۔
\v 16 تِم یوٚت تہِ گژھن، تتہِ چھِ سٲرؠ سےٕ جانن تہٕ مالس ڈُبہٕ ڈاس پھِران تہٕ لوٗکن سختی انان۔
\v 17 تِمن چھُنہٕ لوٗکن سٟتؠ امنہٕ سان روزُنے سمجھ یوان\f + \fr 3‏:17 \ft یَشعیاہ 59.7-8، امثال 1.16\f*
\v 18 تِمن چھُنہٕ خدایہِ سُنٛد کانہٛہ تہِ خوف"\f + \fr 3‏:18 \ft زبور 36.1\f*
\p
\v 19 یقیناً چھِ أسؠ یہُودؠ سورےٕ زانان یہِ خدا ونان چھُ پننٮ۪ن قانونن منٛز۔ یِم یہُودین پیٚٹھ لاگو چھِ سپدان۔ یِمن خداین یِم قانون دِتؠ۔ اوٕ کِنؠ زِ کانہٛہ تہِ گژھِ نہٕ پانس خدایہِ سنٛدِ عدالتہٕ نِشہٕ مُچھِ زانُن۔ یہِ چھُ اوٕ کِنؠ زِ خدا دِیہِ سارنےٕ غلط کارن دنیاہس منٛز سزا۔
\v 20 یہِ چھُ پوٚز زِ خدا گنٛزرنہٕ کٲنٛسہِ پانس سٟتؠ راستباز اوٕ کِنؠ زِ سُہ چھُ بس یہُودین دِنہٕ آمٕتؠ قانون زبٲنؠ زبٲنؠ مانان۔ یہِ چھُ اوٕ کِنؠ تہِ زِ یِمے قانون چھِ لوٗکن خبردار کران زِ تِم کٲتیاہ گناہ گار چھِ۔\f + \fr 3‏:20 \ft زبور 143:2\f*
\v 21 وۅنؠ چھُ خداین ہوومُت زِ سُہ کِتھٕ پٲٹھؠ چھُ لوٗکن راستباز بناوان۔ راستباز بنُن چھُنہٕ تِمن قانونن پیٚٹھ دٔرِتھ یِم خداین یہُودین دِتؠ۔ توتہِ تھوو پننٮ۪ن صحیفن منٛز لیٚکھِتھ موسیٰؔ تہٕ باقےٕ نبیو یتھ تصدیق کران زِ خدا کِتھٕ پٲٹھؠ چھُ لوٗکن راستباز بناوان۔
\v 22 خدا چھُ لوٗکن راستباز بناوان تِمن یسوعؔ مسیحس پیٚٹھ پژھ دٔررٲوِتھ۔ خدا بناوٕ پرٛتھ قسمہٕ کیٚن لوٗکن راستباز یودوے تِم یسوع مسیحسؔ پیٚٹھ پژھ تھاون۔ تکیازِ خدا چھُنہٕ بیوٚن بیوٚن قسمہٕ کیٚن لوٗکن منٛز کانہٛہ بٮ۪نیٚر ورتاوان۔
\v 23 تکیازِ پرٛتھ قسمٕکؠ لوٗکھ چھِ گناہ کران تہٕ خدایہِ سنٛدِ جلالہٕ نِشہٕ محروم روزان۔
\v 24 خدا چھُ یِمن گناہ گار لوٗکن اہِ دالہِ ہنٛدؠ رنٛگؠ راستباز بناوان تکیازِ سُہ چھُ مہربان۔ لوٗکھ چھِ عنایت پراوان ییٚلہِ سُہ لوٗکن یسوع مسیحسؔ سٟتؠ یکُت کرِ، یمؠ یم لوٗکھ بچٲوؠ گناہگار سپدِتھ سزا نشہٕ۔
\v 25 خداین کوٚر پیش یسوعؔ اکِس شخصہٕ سنٛدؠ رنٛگؠ یُس پرٛتھ کٲنٛسہِ ہنٛدٮ۪ن گناہن ہنٛدِ خٲطرٕ کفارٕ ادا کران چھُ۔ خداین کوٚر یہِ تاکہِ سُہ ہاوِ زِ سُہ کِتھٕ پٲٹھؠ چھُ لوٗکن راستباز بناوان۔ یہِ سپُد اوٕ کِنؠ زِ خدا چھُ تِمن سارنےٕ گنہن منساوان یِم لوکو برونہٛہ کالہِ کرمٕتؠ آسن۔
\v 26 خداین کوٚر یہِ اوٕ کِنؠ زِ سُہ چھُ روادار۔ خداین کوٚر یہِ اوٕ کِنؠ تہِ زِ سُہ ہاوِ زِ سُہ کِتھٕ پٲٹھؠ چھُ ازکِس وقتس منٛز لوٗکن راستباز بناوان۔ یہِ چھُ یِتہِ درشاوان زِ خدا چھُ راستباز تہٕ سُہ چھُ لوٗکن راستباز بناوان یودوے تِم یسوعسؔ پیٚٹھ پژھ تھاون۔
\v 27 توٚہؠ یہُودؠ ہیٚکِو ؤنِتھ یودوے یہِ ژےٚ ووٚنُتھ پوٚز چھُ تیٚلہِ ہیٚکہِ نہٕ کانہٛہ تہِ پنُن تھیٚکِتھ۔ تیٚلہِ ونو بہٕ، "بےٚ شک ہیٚکہِ نہٕ کانہٛہ تہِ تھیٚکِتھ" تیٚلہِ ما ؤنِو توٚہؠ، "پزی ہیٚکو أسؠ راستباز بٔنِتھ تِمن قانونن پیٚٹھ عمل کٔرِتھ یِم خداین یہُودین دِتؠ۔ یقیناً یِم چیز کرنہٕ سٟتؠ بنو أسؠ راستباز" تیٚلہِ ونو بہٕ، "بالکل نہٕ" اتھ برعکس ہیٚکن لوٗکھ راستباز بٔنِتھ یسوعؔ مسیحس پیٚٹھ پژھ تھاونہٕ سٟتؠ۔
\v 28 بے شک چھِ أسؠ یہُودؠ مسیحیؔ یتھ کتھِ مازان زِ لوٗکھ بنن راستباز یسوع مسیحسؔ پیٚٹھ پژھ تھٲوِتھ۔ راستباز بنُن چھُنہٕ تِمن قانونن پیٚٹھ عمل کرنس پیٚٹھ یِم خداین حکم کٔرؠ تہٕ یہُودین دِتؠ"
\v 29 یا ما ہیٚکِو توٚہؠ ؤنِتھ، "یقیناً چھُنہٕ خدا چھرا یہُودین ہندُے یوت خدا سُہ چھُ پزی سارنےٕ قومن ہنٛد خدا تہِ۔ اوے ونو بہٕ، "بالکل، سُہ خدا چھُ چھُ سارنےٕ قومن ہُنٛد تہِ۔
\v 30 یہِ چھُ پوٚز تکیازِ خدا چھُ اکُے سارنے قومن ہنٛدِ باپتھ۔ سُہ بناوِ راستباز دۅشوٕنؠ یہُودین تہِ یِم یسوعسؔ پیٚٹھ پژھ تھاون تہٕ غٲر یہُودین تہِ یِم یسوعس پیٚٹھ پژھ تھاون۔
\v 31 توٚہؠ یہُودؠ ما ہیٚکِو ؤنِتھ، "تیٚلہ چھِنہٕ أسؠ یقیناً یسوعس پیٚٹھ بھروسہٕ کٔرِتھ تِم قانون صحیح مانان یِم خداین اسہِ دِتؠ" اوٕ کِنؠ ونہٕ بہٕ، "بالکل نہ۔ اتھ برعکس چھِ أسؠ تصدیق کران زِ یہِ تہِ خداین قانونن منٛز ووٚن چھُ صحیح"
\c 4
\p
\v 1 توٚہؠ یہُودؠ ہیٚکِو ؤنِتھ، "یودوے یہِ توٚہہِ ونُو پوٚز چھُ، تیٚلہِ زون جسمٲنی لحاظٕ سٲنؠ جد ابرہامن اتھ متعلق۔
\v 2 یہِ گژھِ آسُن پوٚز تکیازِ یودوے ابرہام راستباز بنیاو تہِ کرنہٕ سٟتؠ یمیُک حکم شریعتس منٛز خداین دیُتمُت چھُ، تیٚلہِ ہیٚکہِ سُہ اتھ متعلق تھیٚکِتھ۔ اتھ برعکس ہیٚکہٕ بہٕ ؤنِتھ ابرہام ہیٚکہِ نہٕ شاید امہِ باپتھ فخر کرِتھ خدایس برونہٛہ کنہِ۔
\v 3 بہٕ چھُس یہِ ونان تکیازِ موسیٰؔ چھُ یقیناً اسہِ یہِ ونان پننس صحیفس منٛز، "ابرہامنؔ اوٚن خدایس پیٚٹھ ایمان تہٕ خداین زون ابرہامؔ راستباز تکیازِ تمؠ اوٚن تس پیٚٹھ \f + \fr 4‏:3 \ft پیدائش 15:6\f*ایمان"
\v 4 پزی! ییٚلہِ کانہٛہ انسان کانہٛہ کٲم کرِ، سُہ چھُنہٕ امہِ باپتھ زینمٕژ مزوٗرؠ کانہٛہ رُت انعام یا تحفہٕ زانان۔ بلکہِ اتھ برعکس چھُ یُتھ کانہٛہ نفر پنٕنؠ زینمٕژ اُجرت زانان زِ یہِ دارِ ہے تس یہِ کٲم کرناون وول مٲلک۔
\v 5 اتھ مقابلہٕ ییٚلہِ اکھ انسان یہُودین خدایہِ سنٛدِ طرفہٕ دِنہٕ آمٕتؠ حکم مانہِ نہٕ بلکہِ چھُ خدایس پیٚٹھ بھروسہٕ کران یُس ناراستباز لوٗکن راستباز بناوان چھُ، خدا چھُ تس راستباز مازان تکیازِ امؠ اوٚن ایمان خدایس پیٚٹھ۔
\v 6 یہِ چھُ بالکل تی یہِ داودن پننس صحیفس منٛز لیٚوکھ زِ نیک بخت لوٗکھ کِتھؠ چھِ آسان ییٚلہِ خدا تِمن راستباز مازان چھُ۔ تِم ہرگاہ نہٕ تِم چیز کران چھِ یہِ خداین حکم دیُت۔ داودن لیٚوکھ،
\q1
\v 7 "لوٗکھ چھِ سیٚٹھا خوش آسان ییٚلہِ خدا تہنٛدؠ اتٕرؠ معاف کران چھُ۔ لوٗکھ چھِ سیٚٹھا خوش آسان ییٚلہِ نہٕ خدا تہنٛزن گناہگار عملن کُنہِ گرینٛز منٛزےٕ انان چھُنہٕ۔
\v 8 کانہٛہ نفر تہٕ یمِس خداوند زانہٛہ تہِ گناہگار گنٛزرنہٕ چھِ واریاہ واریاہ خوش آسان"\f + \fr 4‏:8 \ft زبور 32:1-2\f*
\p
\v 9 لہٰذا یِم خوش انسان چھِنہٕ صرف ختنہٕ وٲلؠ یہُودؠ بلکہِ بے ختنہٕ غٲر یہُودؠ لوٗکھ تہِ۔ یہِ چھُ بالکل پوٚز تکیازِ أسؠ یہُودؠ چھِ حوالہٕ دِوان صحیفُک یتھ منٛز لیٚکھِتھ چھُ، "خدا چھُ ابرہامس راستباز گنٛزران تکیازِ تمؠ اوٚن تس پیٚٹھ ایمان۔
\v 10 اوے تہِ چھُو توٚہؠ یقیناً زانان ییٚلہِ ابرہامن خدایس پیٚٹھ ایمان اوٚن تہٕ اوے زون خداین سُہ راستباز۔ ژٕ چھُکھ یقیناً زانان زِ آیا یہِ سپدیاوا امہِ برونہٛہ زِ تس آو ختنہٕ کرنہٕ یا امہِ پتہٕ۔ بے شک سپدنہٕ یہِ ییٚلہِ زن ابرہامسؔ ختنس دوران بلکہِ یہِ سپدِ ییٚلہِ سُہ وُنہِ ختنہٕ سپدن ورٲے اوس یعنی ییٚلہِ خداین سُہ راستباز زون۔
\v 11 ابرہامسؔ آو ختنہٕ کرنہٕ تسنٛدِس بدنس پیٚٹھ اکہِ نشانہٕ رنٛگؠ یہِ ثٲبت کرنہٕ خٲطرٕ زِ خداین بنوو سُہ راستباز تکیازِ ابرہامنؔ کوٚر تمِس پٮ۪ٹھ بھروسہٕ ییٚلہِ تمِس وُنہِ ختنہٕ کرنَے اوس تاکہِ سُہ بنہِ روحٲنی پیشرو تِمن تمام غٲر یہُودؠ فردن ہنٛد یِم خدایس پیٚٹھ ایمان انن تاکہِ خدا گنٛزراوِ تِمن راستباز اوٕ کِنؠ زِ تِمن چھُ تس پیٚٹھ ایمان۔\f + \fr 4‏:11 \ft پیدائش 17:11\f*
\v 12 یہِ سپُد اوٕ کِنؠ تہِ زِ ابرہامؔ بنہِ روحٲنی پیشرو تِمن سارنےٕ لوٗکن ہُنٛد یِمن ختنہٕ چھُ آمُت کرنہٕ، یعنی ختنہٕ وٲلؠ یہُودؠ، یِمن ہُنٛد ختنہٕ نہ صرف بدنی چھُ بلکہِ چھِ خدایس پیٚٹھ ایمان تھاون وٲلؠ تہِ یِتھٕ پ ٹھؠ زن سون پیشرو ابرہام اوس ختنہٕ سپدنہٕ برونہٛہ۔
\v 13 یہِ چھُ پوٚز تکیازِ ییٚلہِ خداین وعدٕ دیُت ابرہامس تہٕ تسنٛدین یِنہٕ والیٚن زُریٚن زِ یہِ سورےٕ دنیا بنہِ تہنٛز ملکیت۔ خداین دیُت نہٕ یہِ وعدٕ اوٕ کِنؠ زِ ابرہامنؔ مٲنؠ تِم قانون یِم زن یہُودین خداین دِتؠ بلکہِ اوٕ کِنؠ زِ ابرہامؔ بنوو خداین راستباز تکیازِ ابرہامن اوٚن تس پیٚٹھ ایمان۔
\v 14 یہِ چھُ پوٚز یودوے لوٗکھ وٲرث بنن تتھ ابرہامسؔ دِنہٕ آمتِس خدایہِ سنٛدِس وعدس تِمن قانونن مٲنِتھ یِم خداین یہُودین عنایت کٔرؠ۔ تیٚلہِ بنہِ خدایس پیٚٹھ ایمان انُن غٲر ضروری۔ تہٕ یہِ خداین وعدٕ کوٚر سُتہِ بنہِ بے کار۔\f + \fr 4‏:14 \ft زبور 28:4، رومؔ 12:19\f*
\v 15 یہِ چھُ اوٕ کِنؠ تکیازِ خداین یِم قانون یہُودین عنایت کٔرؠ تہنٛز منشا اوس سزا دیُن یِمن نہ مانن والیٚن۔ یتہِ یتہِ خدایہِ سنٛدؠ قانون آسن نہٕ تتہِ تتہِ ہیٚکہِ نہٕ کانہٛہ تِمن انکار تہِ کٔرِتھ۔
\v 16 اوے کِنؠ یہِ خداین وعدٕ کوٚر سپدِ پوٚز تس پیٚٹھ ایمان اننہٕ سٟتؠ تاکہِ تسُنٛد مہربان آسُن پرٮ۪زلہِ۔ خدا اوس یوٗت مہربان تاکہِ سُہ بناوِ یہِ کتھ یقینی تاکہِ سُہ بناوِ پنُن وعدٕ حتمی تِمن سارنےٕ لوٗکن ہنٛدِ باپتھ یِم ابرہام سنٛدؠ روحٲنی زُرؠ بنن۔ یِم ابرہامؔ سنٛدؠ روحٲنی رُزؠ چھِنہٕ چھرا تِم یہُودؠ یِم خدایہِ سنٛدِ طرفہٕ عنایت سپدنہٕ وٲلؠ قانون مانن بلکہِ تِم تہِ یِم ابرہامؔ سنٛدؠ پٲٹھؠ خدایس پیٚٹھ ایمان تھاوُن۔ ابرہامؔ چھُ اسہِ سارنےٕ ہُنٛد روحٲنی جد یِمن خدایس پٮ۪ٹھ ایمان چھُ۔
\v 17 یہ چھُ عٲن تہٕ غٲن تی یہِ خداین پننٮ۪ن صحیفن منٛز ابرہامسؔ متعلق لیٚوکھ: "مےٚ ژورُکھ ژٕ اکھ روحٲنی جد واریاہن لوٗکہٕ جمٲژن باپتھ" ابرہامن تھوو ایمان خدایس پیٚٹھ۔ خدا چھُ سۅ ذات یُس مودؠ مٕتیٚن لوٗکن بیٚیہِ زندگی بخشان چھُ۔ یُس نہٕ نابود چیزن وجودس منٛز ینُک حکم دِوان چھِ تہٕ اوٕ پتہٕ چھِ یِم وجودس یوان۔\f + \fr 4‏:17 \ft پیدائش 17:15\f*
\v 18 ابرہامنؔ تھوو خدایس پیٚٹھ ایمان خدایہِ سنٛز امید روزِتھ ییٚلہِ زن اندٕ وندٕ چھرا نا امیدی ٲس۔ اوٕ کِنؠ بنیاو سُہ واریاہن لوٗکہٕ جمٲژن ہنٛد روحٲنی۔ یہِ سپدِ عٲن تہٕ غٲن خدایہِ سنٛدِ تس سٟتؠ صحیفن منٛز وعدٕ مطٲبق۔ تِم، یِم لوٗکھ چانہِ مرِ نیرن تِم آسن تیتؠ شمارٕ روستُے ییتیاہ آسمانٕکؠ تارکھ چھِ"
\v 19 ابرہامن سونچ زِ اما سُہ چھُ وۅنؠ واریاہ وٲنٛسٹھ شُرؠ پٲدٕ کرنہٕ باپتھ۔ تسُنٛد جسم اوس امہِ وِزِ الہٕ پلہٕ ہتھ وۅہر۔ تمؠ سونچ پتہٕ زِ تسنٛز آشِنؠ سارٕ چھےٚ یی نہٕ گۅبہِ کھور روزنس لایق تکیازِ امہِ برونہٛہ تہِ روزِ نہٕ سُہ زانہٛہ گۅبہِ کھور۔ وۅنؠ گوو ابرہامن تھوو پنُن ایمان خدایس پیٚٹھ دوٚر۔\f + \fr 4‏:19 \ft عبر 11:11\f*
\v 20 بے شک ابرہامن کوٚر نہٕ خدایہِ سنٛدِس وعدس پیٚٹھ پژھ راورٲوِتھ شک۔ اتھ برعکس بنوو خداین ابرہام ژوٚر قوت وول پننس خدایس پیٚٹھ ایمان تھاونس منٛز۔ ییٚلہِ زن پانہٕ ابرہامؔ خدایہِ سنٛز عظمت چمکاواں رود۔
\v 21 خداین دیُت ابرہامس پوٗرِ پوٗر یقین زِ سُہ خدا چھُ بالکل قٲدر تہِ کرنہٕ باپتھ یہِ تمؠ وعدٕ دیُت۔
\v 22 تہٕ اوے کِنؠ زون خداین ابرہام راستباز تکیازِ تمؠ تھوو تس پیٚٹھ پنُن ایمان"\f + \fr 4‏:22 \ft پیدائش 15:6\f*
\v 23 وۅنؠ گوو ییٚلہِ موسیٰ ہن صحیفن منٛز لیٚوکھ، "خداین تھوو نظرِ تل زِ ابرہامن کتھٕ پٲٹھؠ کوٚر تس پیٚٹھ بھروسہٕ۔ یِم لفظ چھِ نہ صرف ابرہام ابرہامؔ سنٛدِس حوالس منٛز آمٕتؠ۔
\v 24 بلکہِ چھِ یِم اسہِ متعلق تہٕ یِمو یسوعسؔ پیٚٹھ ایمان اوٚن، خدا چھُ تس پیٚٹھ سون ایمان نظرِ تل تھاون وول۔ أسؠ چھِ تِم لوٗکھ یِمن تس پیٚٹھ ایمان چھُ۔ سُے چھُ یمؠ سون خداوند یسوعؔ مرنہٕ پتہٕ دُبارٕ زندٕ کوٚر۔
\v 25 خداین دیُت لوٗکن یسوعؔ مارنہٕ۔ تکیازِ اسہِ کٔرؠ گناہ خدایس خلاف۔ خداین اوٚن بیٚیہِ یسوعؔ زندگی منٛز تاکہِ أسؠ تہِ بنو راستباز۔\f + \fr 4‏:25 \ft یَشعیاہ 53:4-5، 12\f*
\c 5
\p
\v 1 امکِس نتیجس منٛز پزِ اسہِ خدایس سٟتؠ امنہٕ سان زُوُن تمہِ کرنکہِ برکتہٕ یہِ خداوند یسوع مسیحنؔ اسہِ سٟتؠ کوٚر تکیازِ أسؠ بنیاے راستباز یسوعسؔ پیٚٹھ ایمان اننہٕ کِنؠ۔
\v 2 سون خداوند یسوعؔ مسیحؔ چھُ لگتھےٕ اسہِ خدایہِ سُنٛد مہربان آسُن ژٮ۪تراوان یسوعسؔ پیٚٹھ سانہِ ایمان اننہٕ سٟتؠ۔ أسؠ ہیٚکو خود اعتمٲدی سان فخر کٔرِتھ زِ أسؠ چھِ خدایہِ سنٛز پرٮ۪زلوٕنہِ عظمژ منٛز شرکت کران۔
\v 3 چھرا چھنہٕ کتھ یِژے یتھ پیٚٹھ أسؠ فخر ہیٚکو کٔرِتھ۔ بلکہِ ہیٚکو أسؠ تِمن دۅکھٕ دٲوؠ چیزن پیٚٹھ تہِ فخر کٔرِتھ یِم اسہِ ژٮ۪ترٲوؠ۔ أسؠ ہیٚکو یہِ کٔرِتھ تکیازِ أسؠ چھِ زانان زِ دۅکھٕ دٲوؠ چیز یِم اسہِ ژٮ۪ترٲوؠ چھِ اسہِ مشکلات برداشت کرنُک ژوٚر حوصلہٕ دِوان۔
\v 4 تہٕ برداشت کرنس لایق بنُن چُھ اسہِ خدایس نِش قبولیت بخشان تہٕ ییٚلہِ خدا اسہِ قبول کرِ، أسؠ چھِ زیادٕ حوصلہٕ لبان۔
\v 5 ییٚلہِ أسؠ خود اعتمٲدی پراوو، أسؠ سپدو نہٕ زانہٛہ تہِ نا امید۔ یہِ چھُ اوٕ کِنؠ زِ پاک روحن بنٲوؠ أسؠ زیادٕ سنرِ سان سمجھنس لایق۔ اسہِ کوتاہ چھُ خدا لول بران۔ خداین دیُت اسہِ پاک روح بخشمُت۔
\v 6 پزر گوو یہِ زِ ییٚلہِ أسؠ وُنہِ مجبور ٲسؠ، یسوعؔ مسیحنؔ دیُت پنُن زُو اسہِ گناہگار لوٗکن ہنٛدِ باپتھ چھپہِ۔ خداین دیُت یہِ سپدنہٕ صحی موقعس پٮ۪ٹھ۔
\v 7 بے شک کرِ کانہٛہ تہِ نفر کٲنٛسہِ تہِ نیک فردٕ سنٛدِ باپتھ مرُن خالے قبول ہرگاہ زن کانہٛہ نفر کٲنٛسہِ نیک فردٕ سنٛدِ باپتھ مرنس غور تہِ کرِ۔
\v 8 وۅنؠ گوو خدا چھُ پننہِ لولُک اظہار اسہِ نیک لوٗکن ہنٛدِ باپتھ کران یمہِ واقعہٕ کِنؠ: ییٚلہِ زن أسؠ وُنہٕ گناہگارےٕ ٲسؠ، یسوعؔ مسیحنؔ دیُت پنُن زُو چھپہِ سانہِ باپتھ۔
\v 9 امکِس نتیجس منٛز مسیحؔ سنٛدِ قربٲنی دٔسؠ زُو دِنہٕ کِنؠ بنیاے أسؠ راستباز۔ یہِ چھُ وارے یقینی زِ سُہ بچاوِ اسہِ ییٚلہِ خدا چھیکرس گناہگارن سزا دِیہِ۔
\v 10 بے شک دیُت خدایہِ سنٛدؠ گۅبرؠ یسوعنؔ پنُن زُو اسہِ خدایس سٟتؠ ملناونہٕ باپتھ چھپہِ ییٚلہِ أسؠ وُنہِ تسنٛدؠ دُشمنےٕ ٲسؠ۔ اوے تہِ ییٚلہِ زن یسوعنؔ أسؠ برونٛٹھےٕ خدایس سٟتؠ ملنٲوؠ۔ یہِ چھُ وۅنؠ زیادے یقینی زِ سُہ بچاوِ اسہِ ییٚلہِ خدا گناہگارن سزا دِیہِ تکیازِ سُہ چھُ دُبارٕ زنٛدٕ گومُت۔
\v 11 وونؠ گوو یُتےٕ یوت کوٚر نہٕ خداین سانہِ باپتھ بلکہِ چھِ أسؠ فخر کران خدایس پیٚٹھ تمہِ ذریعہٕ تہِ یہِ خداوند یسوعؔ مسیحنؔ سانہِ باپتھ کوٚر۔ یسوعنؔ ملنٲوؠ أسؠ برونٛٹھے خدایس سٟتؠ۔
\v 12 بس تہٕ اوے ییٚلہِ اکِس فردٕ سنٛدِ گناہ کرنہٕ سٟتؠ دنیاہس منٛز گناہ وجودس منٛز یُن ہیٚتُن، زُو ذٲژو ہیوٚت مرُن تکیازِ اکؠ فردن کوٚر گناہ۔ یِتھے پٲٹھؠ ہیوٚت پرٛتھ کٲنٛسہِ مرُن تکیازِ پرٛتھ کٲنٛسہِ کٔرؠ گناہ۔
\p
\v 13 بے شک کٔرؠ لوٗکو سٲرسےٕ دنیاہس منٛز گناہ۔ خدایہِ سنٛدِ طرفہٕ یہُودین قانون میلنہٕ برونٛٹھ۔ وۅنؠ گوو لوٗکن ہُنٛد یہِ کرُن مون نہٕ خداین شریعتہٕ حسابہٕ گناہ۔ تکیازِ تِم قانون ٲسؠ نہٕ وُنہٕ بارسس آمٕتؠ یہِ زاننہٕ باپتھ زِ گناہ کیا گوو۔
\v 14 وۅنؠ گوو گۅڈنکِس انسان آدمؔ سنٛدِ پیٚٹھٕ رودؠ لوٗکھ مران برابر موسیٰ سنٛدِس وقتس تام تِم لوٗکھ تہِ مودؠ یِمو خدایہِ سنٛدِ طرفہٕ آدمس دِنہٕ آمتیٚن قانونن ہنٛز خلاف ورزی کرؠ نہٕ۔ آدمؔ چھُ تس نفرس ہِیو یُس پتہٕ پہن ییہِ۔
\v 15 مگر یہِ خداین اسہِ تحفہٕ دیُت پننہِ مہربٲنی سٟتؠ چھُنہٕ تہِ یہِ آدمن رد کوٚر یعنی خدٲیی حکم۔ پزر گوو زِ واریاہ لوٗکھ مودؠ تکیازِ اکؠ فردن آدمن کوٚر نہ بوزُن خدٲیی حکمس۔ مگر خدا کوتاہ مہربان چھُ۔ تہٕ یہِ خداین دیُت پننہِ مہربٲنی سٟتؠ اسہِ لوٗکن یسوعؔ سنٛدؠ دٔسؠ تہِ چھُ واریاہ ژوٚر تہٕ عظیم۔
\v 16 توتہِ، یہِ خداین تحفہٕ  دیُت چھُنہٕ تہِ یہِ سپُد تکیازِ اکؠ فردن آدمن کوٚر گناہ۔ یہِ چھُ پوٚز تکیازِ خدا لاگہِ پرٛتھ کٲنٛسہِ عدالت۔ آدمؔ سنٛدؠ دٔسؠ سپدیمتہِ گناہ پتہٕ۔ یمہِ کِنؠ خداین پرٛتھ کانہٛہ قصوروار قرار دیُت۔ اتھ برعکس بنٲوؠ خداین لوٗکھ راستباز امہِ باوجود زِ تِمو کٔرؠ خدٲیی احکام رد۔
\v 17 بے شک، چونکہِ پرٛتھ کانہٛہ مود تکیازِ اکؠ فردن آدمن\f + \fr 5‏:17 \ft آدمؔ \f* کوٚر خدٲیی حکم رد۔ یہِ چھُ زیادٕ یقینی زِ تِم لوٗکھ یِم مانان چھِ زِ خدا کوتاہ مہربان چھُ۔ تہٕ تِم لوٗکھ روزن زنٛدٕ یِمن خدا راستباز بناوِ پنُن پان ضبطس منٛز رٔٹِتھ۔ یہِ سپدٕ توٕ کِنؠ یہِ زن یسوعؔ مسیحنؔ کوٚر۔
\v 18 لہٰذا یِتھٕ پٲٹھؠ خداین اکِس فرد آدمؔ سنٛدِ دٔسؠ خدٲیی حکم نہ ماننہٕ کِنؠ سٲری لوٗکھ قصوروار گنٛزرٲوؠ، تِتھے پٲٹھؠ بناوِ خدا سارنےٕ لوٗکن راستباز یمہِ کِنؠ یِم سٲری پوشوٕنؠ زندگی پراون۔ تمہِ راستباز عملہِ کِنؠ یۅسہٕ یسوعنؔ کٔر۔
\v 19 بے شک امہِ لِکھٕ چھِ لوٗکھ گناہگار بنان اکِس فرد آدمؔ\f + \fr 5‏:19 \ft آدمؔ\f* سنٛدِ دٔسؠ خدایہِ سنٛزِ نافرمٲنی سٟتؠ۔ امہِ لِکھٕ بنن واریاہ لوٗکھ راستباز۔ تکیازِ اکؠ فردن یسوعنؔ کٔر خدایہِ سنٛز فرمانبردٲری۔
\v 20 توتہِ کٔرؠ خداین مذید قانون جٲری تکیازِ ژرؠ ژرؠ لوٗکھ کرن یِمن احکامن رد، وۅنؠ گوو ییٚلہِ ییٚلہِ لوٗکھ ژرؠ ژرؠ گناہ کرٕنؠ لاگن، تیٚلہِ تیٚلہِ چھُ خدا پننہِ نرمی تہٕ مہربٲنی ہُنٛد زیادٕ زیادٕ اظہار کران۔
\v 21 یہِ سپُد تاکہِ خدا بنہِ لوٗکن پیٚٹھ زیادٕ فضلہٕ وول یِمن راستباز بنٲوِتھ۔ یِتھٕ پٲٹھؠ زن گناہگار بننہٕ کِنؠ لوٗکھ مودؠ تہٕ ضبطس منٛز آے۔ تِتھے پ ٹھؠ ییٚلہِ، خدا لوٗکن راستباز بناوِ تِم پراون پوشوٕنؠ زندگی۔ تکیازِ سٲنؠ خداوند یسوعؔ مسیحنؔ کوٚر یی۔
\c 6
\p
\v 1 کانہٛہ ما ونہِ، یودوے یہِ ژےٚ ووٚنُتھ پوٚز چھُ، تیٚلہِ پزِ اسہِ ایمان والیٚن گناہ کران روزُن ژوٚر ژوٚر تاکہِ خدا ہاوِ اسہِ زیادٕ زیادٕ زِ سُہ کوتاہ مہربان چھُ"
\v 2 تیٚلہِ ونہٕ بہٕ، "بالکل نہٕ" اسہِ، یِم وۅنؠ ہرگز گنہن ہنٛزِ تھپہِ منٛز چھِنہٕ پزن نہٕ جٲری تھاوٕنؠ گناہ کرٕنؠ۔
\v 3 توٚہہِ چھےٚ پوٗرٕ پتاہ زِ خدا چھُ ملناوان یسوعؔ مسیحسؔ سٟتؠ یمِس کٲنٛسہِ کانہٛہ بپتسمہ دِیہِ۔ یہِ گوو زنتہٕ یہِ بپتسمہ پراون وول تہِ مسیحسؔ سٟتؠ مود۔
\v 4 اوے تہِ گوو بپتسمہ پراوُن زنتہٕ أسؠ تہِ مودؠ مسیحسؔ سٟتؠ۔ زنتہٕ خداین أسؠ مسیحس سٟتؠ مقبرس منٛز دفن کٔرؠ۔ یہِ چھُ امے آیہِ یِتھٕ پٲٹھؠ زن خدا یعنی بب سنٛز پرٮ۪زلوٕنؠ قدرژ مسیحؔ مرنہٕ پتہٕ دُبارٕ زنٛدٕ کوٚر، تِتھے پٲٹھؠ ہیٚکو أسؠ تہِ اکہِ نوِ زندگی ہُنٛد آغاز کٔرِتھ۔
\v 5 بے شک چونکہِ مسیحؔ سنٛدِس مرنس سٟتؠ ہشر کِنؠ چھِ أسؠ تس سٟتؠ رٔلِتھ۔ خدا کرِ اسہِ زنٛدٕ امی ہشرچہِ شراکژ کِنؠ۔
\v 6 اسؠ چھِ زانان زِ خداین دیُت اسہِ نجات پتمہِ گناہگار زندگی نشہٕ یُتھےٕ لوٗکو یسوعسؔ پھییہ دیُت۔ تمؠ کوٚر یہِ تاکہِ گناہ رٹہِ نہٕ اسہِ دُبارٕ تلفس تل۔ تاکہِ اسہِ پیٚیہِ نہٕ گناہگار زندگی گُذارٕنؠ۔
\v 7 یہِ چھُ اوٕ کِنؠ ییٚلہِ گناہگار زندگی گُذارن وٲلؠ لوٗکھ یسوعؔ سنٛدِس مرنس سٟتؠ ہشراونہٕ یِن۔ خدا چھُ یِمن نجات دِوان گناہگار زندگی گُذارنہٕ نِشہٕ\f + \fr 6‏:7 \ft اعمال 13:38\f*۔
\v 8 چونکہِ زنتہٕ اسؠ تہِ مسیحسؔ سٟتؠ مودؠ۔ اسہِ چھےٚ پژھ زِ أسؠ روزو تسؠ سٟتؠ زنٛدٕ تہِ ہمیشہٕ باپتھ۔
\v 9 أسؠ چھِ زانان زِ مسیحؔ مرِ نہٕ دُبارٕ زانہٛہ تکیازِ خداین دِژ تس مرنہٕ پتہٕ دُبارٕ زندگی۔ وۅنؠ ہیٚکہِ نہٕ کانہٛہ مسیحسؔ دُبارٕ مٲرِتھ۔
\v 10 یہِ گوو تکیازِ ییٚلہِ یسوعؔ مود، تس اوس صرف تمی اکہِ لٹہِ مرُن تاکہِ لوٗکن تلفس تل رٔٹِتھ گناہ گژھِ دوٗر۔ وۅنؠ ییٚلہِ زن سُہ دُبارٕ زندگی منٛز آو، سُہ چھُ زندٕ خدایہِ سُنٛد نوٗر پرٮ۪زلاونہٕ باپتھ۔
\v 11 امہِ آیہِ پزِ نہٕ توٚہہِ تہِ پانس کُنہِ گنہچہِ تھپہِ منٛز زانُن۔ یقیناً زٲنِو پانس صرف خدایس جلال دنہٕ باپتھ زنٛدٕ۔ تکیازِ خداین کوٚر توٚہہِ یکُت یسوعؔ مسیحسؔ سٟتؠ۔
\v 12 چونکہِ یی چھُ پوٚز۔ یِنہٕ یِمن گناہگار خٲہِشن پانس تل رٹنہٕ دِیو۔ یہِ کریٚو گناہگار چیزن کُن قٲیل۔ یِم توٚہؠ کرٕنؠ یژھِو۔
\v 13 پننہِ بدنٕکؠ تان مہٕ ورتٲوِو غلط کامہِ یا گناہ کرنہٕ باپتھ۔ بلکہِ روزِو زنٛدٕ یِتھٕ پٲٹھؠ خدا توٚہہِ کرُن ونان چھُ۔ یِتھٕ پٲٹھؠ تِم لوٗکھ چھِ یِمن خداین مرنہٕ پتہٕ دُبارٕ زندگی بخش۔ پننہِ بدنٕکؠ تان کٔرِو تتھٕ پٲٹھؠ استعمال یُتھ زن توٚہؠ راستبٲزی ہنٛزٕ کامہِ کٔرِتھ خدایس جلال بخشِو۔
\v 14 بے شک، مہٕ دِیو کانہٛہ گناہ کرنچہِ خٲہِشہٕ پانس پیٚٹھ غٲلبن سپدن تکیازِ توٚہؠ چھُو نہٕ تِمن قانونن تحت یِم خداین یہودیٚن عنایت کٔرؠ بلکہِ کوتاہ مہربان خدا چھُ پانس ماتحت رٔٹِتھ۔
\v 15 کانہٛہ اکھ ما ونہِ، "یودوے یہِ توٚہہِ ونُو پوٚز چھُ، تیٚلہِ پزن اسہِ ایمان والیٚن گناہ کرٕنؠ تکیازِ خداین یِم قانون یہُودین دِتؠ، چھِنہٕ اسہِ پیٚٹھ حٲکم۔ بلکہِ چھُ کوتاہ مہربان خدا اسہِ پیٚٹھ حکمران" تیٚلہِ ونہٕ بہٕ، "ہرگِز ہرگِز نہٕ"
\v 16 توٚہؠ چھُو یقیناً زانان زِ یودوے توٚہؠ پانس کٲنٛسہِ فردس یا چیزس ماتحت تھٲیو، تیٚلہِ چھُو توٚہؠ غلام امِس فردٕ سنٛدؠ یا امہِ چیزٕکؠ بنان۔ یہِ چھُ بالکل پوٚز۔ ادٕ توٚہؠ کٔرؠ وا پان حوالہٕ گناہگار زندگی یۅسہٕ توٚہہِ مارِ ہمیشہٕ باپتھ کِنہٕ خدایس یُس توٚہہِ راستباز بنایو۔
\v 17 یودوے زن توٚہہِ حٲلےٕ ٲس بدکار زندگی گُذارنٕچ مگر وۅنؠ چھُو وفادٲری سان تتھ تعلیمہِ کُن سرخم یتھ کُن خداین توٚہؠ لٲگِو۔ شکُر خدایہِ سُنٛد
\v 18 بے شک، ینہٕ خداین توٚہہِ نجات دیُت بدکار زندگی نِشہٕ، توٚہؠ چھُو وۅنؠ خدایہِ سنٛز خدمت راستبٲزی سان کران۔
\v 19 بہٕ پولُسؔ چھُس انسٲنؠ بول چالہِ زبٲنؠ منٛز توٚہہِ سٟتؠ کلام کران۔ تکیازِ توٚہؠ چھُو وُنہِ روحٲنی طور ناپاک۔ بے شک، یِتھٕ پٲٹھؠ توٚہہِ پتھ کالہِ پنٕنؠ بدن تانؠ مکریارس باپتھ کامہِ أنِو تہٕ لٔگتھےٕ رودیو خدایہِ سنٛدؠ قانون پھُٹراوان۔ یِتھے پٲٹھؠ ورتٲوِو وۅنؠ پنٕنؠ بدن تانؠ راستباز زندگی باپتھ۔ یہِ بناوِ توٚہہِ خدٲیی زندگی گُذارن والیٚن لوٗکن ہِیو۔
\v 20 یہِ گوو چونکہِ ییٚلہِ توٚہؠ پنٕنؠ زندگی بدکٲری منٛز گُذاران ٲسِو، توٚہؠ ٲسِو نہٕ راستباز زندگی گُذاران۔
\v 21 اوے تہِ ٲسِو نہٕ توٚہؠ پتھ کالہِ کانہٛہ فٲیدٕ تُلان یِمو بدکار چیزن ہنٛدؠ یِم توٚہؠ کران ٲسِو۔ یِم از توٚہہِ وۅنؠ شرمندٕ کران چھِ۔ تکیازِ تِم چیز مارن توٚہہِ چھیکرس ہمیشہٕ باپتھ۔
\v 22 مگر وۅنؠ ییٚلہِ توٚہہِ یسوعسؔ پیٚٹھ ایمان چھُ، خداین دِتُو توٚہہِ نجات بدکار زندگی نِشہٕ۔ تہٕ توٚہؠ بنٲوؠ نو غلامن ہنٛدؠ پٲٹھؠ پنٕنؠ خدمت کرنس لایق۔ لہٰذا چھُو توٚہؠ خدایہِ سنٛدِ طرفہٕ پراوان اکار بکار یِنہٕ وٲلؠ چیز۔ یِم توٚہہِ خدایہِ سنٛدین لوٗکن ہنٛز ہِش زندگی گُذارنس منٛز اتھٕ روٚٹ کران چھِ۔ بے شک، یِتھٕ پٲٹھؠ زندگی گُذارٕنؠ پراوِ تہنٛدِ باپتھ پوشوٕنؠ زندگی۔
\v 23 بہٕ چھُسو یہِ ونان تکیازِ امہِ آیہِ گناہگار زندگی مارِ توٚہہِ ہمیشہٕ ہمیشہٕ باپتھ۔ مگر خدا چھُ پُر فضل طریقہٕ تِمن لوٗکن تحفہٕ رنگؠ پوشوٕنؠ زندگی زُوناوان یِس سٲنِس خداوند یسوع مسیحس سٟتؠ یکُت کٔرِتھ چھِ۔
\c 7
\p
\v 1 میانیٚو سٲتھی یہُودؠ ایماندارو، توٚہؠ چھُو پوٗرٕ آگاہ زِ قانون یِم خداین یہُودین بخشؠ پزن سارنےٕ یہُودین پننہِ سارے زندگی منٛز مانٕنؠ۔ مےٚ چھےٚ خبر زِ توٚہہِ چھےٚ امہِ حقیقتٕچ خبر تکیازِ بہٕ چھُ مخٲطب تِمن لوٗکن یِم یِمو قانونو نِشہٕ باخبر چھِ یِم خداین یہُودین بخشؠ۔
\v 2 مثالے، یِمو قانونو کِنؠ یِم خداین یہُودین دِتؠ۔ اکِس خاندر واجنہِ زنانہِ پزِ سٲرسےٕ عمرِ اکسےٕ خاندارس سٟتؠ لسُن بسُن یوٚتام سُہ زندٕ چھُ۔ وۅنؠ گوو یودوے یہِ خاندار مرِ، خدایہِ سُنٛد قانون چھُنہٕ مانان زِ یہِ مرن وٲلؠ سنٛز آشِنؠ گژھِ توتہِ امسےٕ سٟتؠ گنٛڈِتھ روزٕنؠ۔
\v 3 اوے تہِ، یودوے یہِ زنان بیٚیہِ کٲنٛسہِ سٟتؠ خاندر کرِ ییٚلہِ زن امسُنٛد خاندار وُنہِ زنٛدے آسہِ۔ خدٲیی قانونن مطٲبق چھےٚ یِژھ زنان بدکار۔ وۅنؠ گوو یودوے خاندار مریس، تس خاندرٕ واجنہِ زنانہِ چھنہٕ مجبوری یہِ قانون ماننٕچ۔ اوے تہِ آسہِ نہٕ سۅ بدکار یودوے سۅ بیٚیِس کٲنٛسہِ سٟتؠ خاندر کرِ۔
\v 4 اوے تہِ، میانیٚو یہُودؠ ایماندار سٲتھیٚو، مسیحؔ سنٛدِ صلیبس کھسنہٕ سٟتؠ مۅکلییہِ تِمن قانونن ہنٛز عمل دٲری یِم خداین یہُودین دِتؠ۔ خداین کوٚر یہِ تاکہِ توٚہہِ سپدِ یکُت مسیحس سٟتؠ زنتہٕ توٚہؠ نوِس خاندارس سٟتؠ نیتھٕر کٔرِو۔ یوٚہے چھُ سُہ نفر یُس خداین مرنہٕ پتہٕ زنٛدٕ کوٚر۔ خداین کوٚر یہِ تاکہِ أسؠ کرو تِمے چیز یِم خدایس خوش کرن\f + \fr 7‏:4 \ft أسؠ ہیٚکو خدایہِ سنٛدِس خدمتس منٛز سودمند بٔنِتھ\f*۔
\v 5 بے شک ییٚلہِ گناہگار زندگی اسہِ پیٚٹھ سوار ٲس، یِمو قانونو اُکساوِ سانہِ خٲہشہِ مزید گناہ کرنہٕ باپتھ۔ سانہٕ گناہگار زندگی رٔٹؠ سٲنؠ بدنی تان پننہِ تھپہِ منٛز۔ نتیجہٕ اوس، أسؠ مرہَو چھیکرس ہمیشہٕ باپتھ۔
\v 6 وۅنؠ گوو ییٚلہِ أسؠ از یسوعسؔ پیٚٹھ ایمان تھاوان چھِ، خدا چھُ رد کران یہِ قانون اسہِ کرُن ونان چھُ۔ قانون یم خداین یہُودین دِتؠ چھِنہٕ وۅنؠ اسہِ قٲیدن ہنٛدؠ پٲٹھؠ تل رٔٹِتھ۔ امکِس نتیجس منٛز چھِ أسؠ وۅنؠ خدایہِ سنٛز خدمت کران اکہِ نوِ آیہِ یۅسہٕ اسہِ واتان چھےٚ پاک روح ذریعہٕ۔ أسؠ چھِنہٕ وۅنؠ پرانہِ آیہِ خدایہِ سنٛز عبادت کران۔ یہِ زن تِم لیٚکھِتھ قانون منٛگ کران چھِ یِم خداین یہُودین دِتؠ۔
\v 7 کانہٛہ اکھ ما ونہِ، "یودوے یہ توٚہہِ ونُو پوٚز چھُ، تیٚلہِ چھِ یِم قانون یِم خداین یہُودین دِتؠ "بد" تیٚلہِ ونہٕ بہٕ، "ہرگز نہ" اتھ برعکس یِمو قانونو ورٲے یِم خداین یہُودین دِتؠ ہیٚکہٕ ہا نہٕ بہٕ آگاہ سپدِتھےٕ زِ گنہُک معنہِ کیا چھُ۔ مثالے، یودوے خدا یِمن قانونن منٛز ونہِ ہے نہٕ، "توٚہہِ پزِ نہٕ لالچی بنُن" مےٚ لگہِ ہےٕ پتہے زِ لالچی آسُن کیا گوو\f + \fr 7‏:7 \ft رومؔ 3:20\f*۔
\v 8 چونکہِ بہٕ چھُس گناہگار۔ مےٚ یوٚژھ واریاہو لِکھو لالچی بنُن تکیازِ بہٕ اوسُس زانان زِ خدایہِ سُنٛد حکم چھُ لالچی نہ بنُن۔ یہِ گوو زنتہٕ ہرگاہ یِم قانون یِم خداین یہُودٮ۪ن دِتؠ موجود آسہن، گناہ گٲری ہنٛز زندگی گُذارنس سپدِہا رُت۔
\v 9 اکھ وقتا اوس ییٚلہِ بہٕ یہِ زندگی گُذاران اوسُس۔ قانونن یِم خداین یہُودین دِتؠ ہنٛزِ کُنہِ آگٲہی ورٲے۔ وۅنؠ ییٚلہِ بہٕ یِمو احکامو نِشہٕ آگاہ سپدُس، بہٕ اوسُس یژھان زیادٕ زیادٕ گناہ کرٕنؠ۔
\v 10 بہٕ سپدُس روحٲنی طور مۅردٕ خدایہِ سنٛدین احکامن نِش اوس توقع زِ أسؠ روزو ہمیشہٕ زنٛدٕ۔ مگر خدایہِ سنٛدؠ احکام بنن ہمیشہٕ باپتھ میانہِ مرنُک بہانہٕ\f + \fr 7‏:10 \ft احبار 18:5\f*۔
\v 11 یہِ گوو اوٕ کِنؠ، بہٕ اوسُس یژھان ژٔرؠ ژٔرؠ گناہ کرٕنؠ، تکیازِ بہٕ اوسُس زانان یہِ خداین حکم کوٚر۔ ییٚلہِ مےٚ گناہ کوٚر مےٚ تٲر پانسےٕ۔ ادٕ خداین یہِ حکم اوس کوٚرمُت، تہِ نَہ ماننن مورُس بہٕ روحٲنی طور\f + \fr 7‏:11 \ft رومؔ 7:8\f*۔
\v 12 اوے تہِ قانون یِم خداین یہُودین دِتؠ چھِ بس خدایسےٕ شوٗبان تہٕ یہِ خداین حکم کرؠ تِم تہِ تسؠ شوٗبان رٕتؠ تہٕ جان پٲٹھؠ۔
\v 13 اوے تہِ، مورُس نہٕ بہٕ روحٲنی طور خدایہِ سنٛدیو قانونو یِم رٕتؠ چھِ۔ بالکل نہ۔ بلکہِ مورُس بہٕ گناہگار زندگی۔ یہِ سپُد اوٕ کِنؠ زِ خدایہِ سنٛدؠ رٕتؠ قانون ہاون زِ گناہگار زندگی کٲژاہ بدکار چھےٚ۔ یہِ سپُد اوٕ کِنؠ تاکہِ خدایہِ سنٛدؠ حکم دِن ہٲوِتھ زِ گناہگار زندگی چھےٚ ژکہِ بدکار۔
\v 14 یہِ چھُ پوٚز تکیازِ أسؠ سٲری انسان چھِ آگاہ زِ خدایہِ سنٛدؠ قانون یِم خداین یہُودین دِتؠ چھِ خدایہِ سنٛدِ روح پیٚٹھٕ۔ وۅنؠ گوو یوٚتام بہٕ چھُس، بہٕ چھُس روحٲنی طور لیٚوژ۔ تہِ زن گوو مےٚ پزِ غلام بٔنِتھ گناہگار زندگی پالٕنؠ۔
\v 15 یہِ چھُ پوٚز زِ بہٕ چھُس نہٕ ہیٚکان ژٮ۪ترِتھ مےٚ کیا پزِ کرُن۔ بے شک چھُس بہٕ کران روزان تہِ یِنہٕ بہٕ کرُن چھُس یژھان۔ وونؠ گوو بہ چھُس کران یہِ کرنٕچ مےٚ دٕے چھےٚ تہٕ کران چھُس۔
\v 16 وۅنؠ ییٚلہِ بہٕ، تہِ کران چھُس یتھ سٟتؠ مےٚ دٕے چھےٚ، یہِ چھُ ثبوت زِ بہٕ چھُس خدایہِ سنٛدین قانونن مانان یِم خداین یہُودین دِتؠ۔ امہِ مذید چھُس بہٕ تصدیق کران زِ یِم چھِ رٕتؠ قانون۔
\v 17 امیُک معنہِ چھُ زِ وۅنؠ چھُس بہٕ یمہِ اپور پانہٕ ذمہٕ دار تہِ کرنُک یِم گناہگار چیز چھِ، بلکہِ چھےٚ یِم گناہگار چیز کرنٕچ میٲنؠ خٲہِش یِم چیز کرناوان۔
\v 18 یقیناً چھُس بہٕ آگاہ زِ بہٕ چھُس نہٕ رُت، بالکل تہِ نہٕ۔ دویمیٚن لفظن منٛز میون یہِ گناہگار نفس چھُنہٕ بالکل رُت۔ یہِ چھُ پوٚز اوٕ کِنؠ زِ ییٚلہِ زن بہٕ پزی یژھان چھُس تہِ کرُن یہِ رُت چھُ۔ بہٕ چھُس نہٕ ہیٚکان تہِ کٔرِتھ\f + \fr 7‏:18 \ft پیدٲیِش 6:5\f*۔
\v 19 یقیناً چھُس نہٕ بہٕ رُت کران یہِ بہٕ یژھان چھُس کرُن۔ بلکہِ چھُس بہٕ لگتھےٕ بدکار کران یِم نہٕ بہٕ کرٕنؠ یژھان چھُس۔
\v 20 ییٚلہِ زن بہٕ تہِ کران چھُس یِنہٕ بہٕ کرُن یژھان چھُس۔ بہٕ چھُس نہٕ سُہ یُس یِم بدکار کرناوان چھُ۔ بلکہِ چھےٚ مےٚ پزنہٕ پٲٹھؠ گناہ کرنٕچ خٲہِش یۅسہٕ مےٚ یہِ کرناوان چھےٚ۔
\v 21 امیُک نتیجہٕ چھُ، بہٕ چھُس ژٮ۪تران زِ کانہٛہ اصول چھُ: بہٕ چھُس بدکار چیز کران روزان ییٚلہِ زن بہٕ پزی رٕتؠ کار کرنہٕ کِنؠ یژھان چھُس۔
\v 22 یہِ چھُ پوٚز تکیازِ قانون یِم خداین یہُودین دِتؠ چھِ میون ذہن وۅلسنس انان۔
\v 23 توتہِ چھُس بہٕ اکھ بیاکھ اصول تہِ وُچھان یس حکومت کران چھُ تِمن کارن پیٚٹھ یِم بہٕ پننیٚو بدنی تانو سٟتؠ کران چھُس۔ اتھ اصولس چھےٚ بُتھؠ لاگے سیٚود۔ تتھ اصولس سٟتؠ یتھ میون دماغ مانان چھُ۔ یتہِ چھُ تل رٔٹِتھ زنتہٕ بہٕ اکھ بٲنٛدؠ چھُس۔ تمہِ اصولہٕ سٟتؠ یمہِ کِنؠ بہٕ بد کار زندگی گُذاران تراے تھاوان چھُس۔ بدکار زندگی چھےٚ حکومت کران یہِ بہٕ بدنی تانو سٟتؠ کران چھُس۔
\v 24 بہٕ چھُس پزی تباہ زد شخص۔ مےٚ چھُ باسان زنتہٕ کہینؠ چھُنہٕ۔ یُس مےٚ شاید یمہِ بدنہٕ نِشہٕ بچٲوِتھ ہیٚکہِ یُس مےٚ ماران چھُ۔
\v 25 بہٕ چھُس شکُر کران خدایہِ سُنٛد یمؠ بہٕ بچووُس پننِس خداوند یسوع مسیح سنٛدِ ذریعہٕ۔ اوے کِنؠ چھُس بہٕ دماغہٕ سٟتؠ تِمن قانونن مانان یِم خداین یہُودین دِتؠ۔ توتہِ چھُس بہٕ امی ساعتہٕ پننہِ یمہِ بدکار پانہٕ سٟتؠ سُہ اصول مانان یُس مےٚ گناہگار زندگی کُن مٲیل چھُ کران۔
\c 8
\p
\v 1 وۅنؠ، اوے تہِ چھُنہٕ خدا کٲنسے بٔلؠ قصوروار گنٛزران یِمن تمؠ یسوعؔ مسیحس سٟتؠ یکُت کوٚر۔
\v 2 یہِ چھُ پوٚز تکیازِ زندگی بخش پاک روحس سٟتؠ وابستہٕ اصول چھُنہٕ توٚہہِ وۅنؠ ہرگِز تتھ اصول کِس تحویلس منٛز تراوان یِم زن توٚہہِ گنہن کُن نِن تہٕ ہمیشہٕ باپتھ مارن۔ امؠ کوٚر یہِ توٚہہِ یسوعؔ مسیحسؔ سٟتؠ یکُت کٔرِتھ۔
\p
\v 3 بے شک اوٚن خداین تہِ با عمل، یِنہٕ تمؠ تِم قانون باعمل انِتھ کٔرِتھ ہیوٚک یِم تمؠ یہُودین دِتؠ تکیازِ یِمو قانونو ہیٚکؠ نہٕ لوٗکھ گناہگار زندگی لسنہٕ نِشہٕ پتھ رٔٹِتھ۔ پننِس گۅبرؠ سنٛدِ بدنٕچ قربٲنی دِتھ کٔرؠ خداین لوٗکھ آزاد۔ گنہن ہنٛز حٲکمیت نِشہٕ۔ تمؠ کوٚر یہِ پنُن گوبر یسوعؔ زمینہِ پیٚٹھ سوزِتھ انسٲنؠ صورژ منٛز یۅسہٕ گناہگار لوٗکن ہشی ٲس۔ خداین سوز پنُن گوبر تاکہِ سُہ کرِ دورِ تتھ یہِ انسانس گنہس کُن قٲیل کرِ۔
\v 4 خداین کٔرؠ یِم چیز تاکہِ أسؠ ایمان وٲلؠ کرو راستبٲزی ہنٛزٕ عملہٕ۔ یہِ زن تِمن قانونن ہُنٛد غرض اوس یِم تمؠ یہُودین دِتؠ۔ أسؠ ہیٚکو تِمن لوٗکن ہنٛدؠ پٲٹھؠ زُوِتھ یِمن گناہگار زندگی تھپہِ رٔٹِتھ چھنہٕ۔ بلکہِ روزو لسان تِمن ہنٛدؠ پٲٹھؠ یِمن پاک روح تھپہِ رٔٹِتھ چھُ۔
\v 5 یہِ چھُ پوٚز تکیازِ گناہگار زندگی ہنٛزِ تھپہِ منٛز لوٗکھ چھِ سونچان تِمن چیزن متلق یِم گناہگار زندگی سٟتؠ ٲشنٲوِتھ چھِ۔ وۅنؠ گوو پاک روح چہِ تھپہِ منٛز روزن وٲلؠ لوٗکھ چھِ سونچان تِمن چیزن متعلق یِم ٲشنٲوِتھ چھِ پاک روح سٟتؠ۔
\p
\v 6 بے شک گناہگار زندگی گزارنچ کل بنہِ اکِس شخصس ہمیشہٕ خٲطرٕ مرنُک سبب۔ وۅنؠ گوو پاک روحس پیٚٹھ أچھ تھٲوِتھ روزِ اکھ نفر ہمیشہٕ باپتھ زُوان تہٕ امنہٕ سان۔
\v 7 یہِ چھُ پوٚز تکیازِ تِم لوٗکھ چھِ خدایہِ سنٛدؠ دشمن یِم گناہگار زندگی کنے روزتھ چھِ۔ یہِ چھُ اوٕ کِنؠ زِ یِم لوٗکھ چھِنہٕ پٲنؠ پانے تِمن قانونن پالان یِم خداین یہُودین دِتؠ۔ یِم چھِنہٕ یہِ کرنس قٲبل۔
\v 8 یِمن گناہگار زندگی تھپہِ رٔٹِتھ چھِ تِم لوٗکھ چھِنہٕ خدایس خوش کرنس قٲبل۔
\p
\v 9 یِمن برعکس چھُو نہٕ توٚہؠ ایمان وٲلؠ تِتھؠ لوٗکھ یِمن گناہگار زندگی تھپہِ رٔٹِتھ چھِ بلکہِ چھُو توٚہؠ تِم یِمن پاک روح تھپہِ منٛز رٔٹِتھ چھُ تکیازِ خدایہ سُنٛد روح چھُ پزی توٚہہِ منٛز بسِتھ۔ مگر یودوے کٲنٛسہِ نفرس منٛز یسوعؔ مسیحؔ سُنٛد روح آسنہِ۔ یہِ انسان چھُنہٕ مسیحس سٟتؠ وابستہٕ۔
\v 10 وۅنؠ ییٚلہِ زن مسیحؔ توٚہہِ ایمان والین منٛز بسِتھ چھُ، پاک روح چھُ توٚہہِ پوشوٕنؠ زندگی بخشان تکیازِ تمؠ بنٲیو توٚہؠ راستباز۔ یہِ چھُ پوٚز۔ ادٕ یودوے تُہنٛدؠ بدن مرن تہ تکیازِ توٚہہِ کٔرِو گناہ۔
\p
\v 11 پاک روح چھُ پزی توٚہہِ منٛز بسِتھ۔ سُہ آو خدایہِ سنٛدِ پیٚٹھٕ یمؠ یسوعؔ مرنہٕ پتہٕ دُبارٕ زندٕ کوٚر۔ چونکہِ یہِ چھُ پوٚز خدا یمؠ یسوعؔ مسیحؔ مرنہٕ پتہٕ دُبارٕ زندٕ کوٚر کرِ تہنٛدین بدنن تہِ زندٕ پننہِ روح سٟتؠ۔ یہِ روح چھُ توٚہے منٛزٕ بسِتھ۔
\p
\v 12 اوے تہِ، میانیٚو ایماندار سٲتھیٚو۔ اسؠ چھِ پابند مگر أسؠ چھِنہٕ پابند گناہگار زندگی لسنہٕ باپتھ۔ یمیُک مطلب گوو تِمن لوٗکن ہنٛدؠ پٲٹھؠ زُوون یمؠ گناہگار زندگی ہنٛزِ تھپہِ منٛز چھِ۔
\v 13 بے شک یودوے توٚہؠ تِمن ہنٛدؠ پٲٹھؠ لٔسِو بٔسِو یِمن گناہگار زندگی تھپہِ رٔٹِتھ چھِ توٚہؠ مرِو ہمیشہٕ باپتھ۔ وۅنؠ گوو یودوے پاک روح توٚہہِ پتھ رٹہِ تہٕ کرنہٕ نِش یہِ گناہ تہنٛدین بدنن منٛز توٚہہِ کرناوان چھُ، توٚہؠ لبِو پوشوٕنؠ زندگی۔
\p
\v 14 یہِ چھُ اوٕ کِنؠ تکیازِ یِمن لوٗکن خدایہِ سُنٛد روح وتھ ہاوِ، تِم چھِ خدایہِ سنٛدؠ روحٲنی شُرؠ۔
\v 15 یقیناً دیُت نہٕ خداین توٚہہِ ایمان والین غلامی پسند ذہن یُس توٚہہِ پھریٹس منٛز تھاوان چھُ یہِ زن گۅڈٕ تہِ توٚہہِ اوسو۔ بلکہِ دیُتنو توٚہہ خداین پاک روح توٚہہِ روحٲنی طور پننٮ۪ن شُرٮ۪ن ہنٛدؠ رنگؠ منگتہٕ رٔٹِتھ۔ یوہے پاک روح چھُ توٚہہِ کریکہٕ دِنس قٲبل بناوان، ابا، میون بب"
\p
\v 16 پاک روح چھُ سانہِ عقلہِ سٟتؠ رٔٹِتھ ذٲتی طور گوٲہی دِوان زِ أسؠ چھِ خدایہِ سنٛدؠ روحٲنی شُرؠ
\v 17 چونکہِ أسؠ چھِ خدایہِ سنٛدؠ روحٲنی شُرؠ۔ أسؠ چھِ تِم یِم وٲرث چھِ خدایہِ سنٛزن برکژن ہنٛدؠ۔ اسؠ چھِ پراوان خود خدایہ سُنٛد فضل یتھ منٛز یسوعؔ سُنٛد فضل تہ شٲمل چُھ۔ یہِ چھُ پوٚز یودوے أسؠ مسیحسؔ سٟتؠ سٟتؠ دۅکھ وٮ۪تراوان روزو تاکہِ خدا بخشہِ مسیحس سٟتؠ سٟتؠ اسہِ تہِ جلال۔
\p
\v 18 یقیناً چھُس بہٕ مانان زِ أسؠ مسیحسؔ پیٚٹھ ایمان تھاون وٲلؠ یِم دۅکھ تہٕ عذاب از تُلان چھِ تِم چھِنہٕ تِمن عظیم چیزن مقابلہٕ کہنؠ وُقعت تھاوان یِم خدا سانہِ باپتھ ظہورس انہِ برونہٛہ کُن۔
\v 19 یقیناً چھِ خدایہِ سنٛدؠ سٲری مخلوق تتھ وقتس پراران زِ خدا کر کرِ اظہار زِ تسنٛدؠ روحٲنی شُرؠ کم چھِ۔
\p
\v 20 پتہٕ گوو خداین بنٲوؠ پنٕنؠ سٲرے خلقت پنٕنؠ تابعہ۔ یہِ خداین خلق کوٚر تہِ اوسنہٕ یژھان زِ یہِ گوٚژھ سپدُن۔ بلکہ خداین کرؠ پانس تٲبین یہِ تہِ تمؠ خلق کوٚر تکیازِ سُہ اوس یژھان یی سپدُن۔ تمؠ کوٚر یہ تاکہِ تسنٛز خلقت روزِ برونہٛہ امید ہٮ۪تھ خود اعتمٲدی سان۔
\v 21 زِ خدا بناوِ پننہِ خلقژ ہوٚژنہٕ نِشہٕ محفوظ۔ تہٕ تمیُک شاندار پرٮ۪زلوُن تجربہٕ ژٮ۪تراوِ یُس تمسنٛدین روحٲنی بچن حٲصل چُھ کران۔
\v 22 در اصٕل چھِ أسؠ زانان زِ موجودٕ زمانس منٛز تہِ چھِ خدایہ سنٛدؠ بنٲومٕتؠ چیز کراہتؠ تہٕ دُکھ دنہٕ وٲلؠ، یتھ کنے اکھ موج بچس زایُن دنہٕ برونہٛہ گۅڈٕ تکلیف تُلان چھےٚ۔
\v 23 یہ چُھنہٕ صرف یہ زِ خداین کٔر سۅ کراہت پٲدٕ! بلکہ چُہ یہ زِ أسؠ چھِ پانہٕ یِمن خدایہ سنٛدِ طرفہٕ پاک روح گۅڈٕ ووت تکلیف محسوس کران۔ أسؠ چھِ تہِ محسوس کران، ییٚلہ زن أسؠ بےٚ صبری سان انتظار کران چھِ زِ خدا گوٚژھ اسہِ روحٲنی طور قبول کرُن، یہ سپدِ تیٚلہ ییٚلہِ خدا اسہِ جسمٲنی طور آزاد کرِ۔
\v 24 یہ چُھ اوٕ موٚکھٕ زِ ییٚلہ أسؠ یقینہٕ سان یہ امید تھاوان چھِ زِ خداین بچٲوؠ أسؠ۔ اگر زن گۅڈے اسہِ نِش سُہ چیز موجود آسہِ یمیُک أسؠ اعتمادٕ سان توقع کران آسو، تہٕ اسہِ نِش آسہِ نہٕ اعتمادٕ سان توقع کرنہٕ باپتھ کِہین۔ یہ چُھ، تکیازِ پٔزؠ پٲٹھؠ چُھنہٕ کانٛہہ کُنہ تِتھِ چیزُک توقع کران یہ تمِس نش گۅڈے آسہِ۔
\v 25 تمہِ پتہٕ تہِ اگر أسؠ اعتمادٕ سان تمہِ چیزُک توقع کران روزو یُس نہٕ وُنہِ اسہِ نِش آسہِ تہٕ أسؠ روزو امیدٕ سان تمیُک انتظار کران۔
\p
\v 26 یتھے پٲٹھؠ چُھ پاک روح تہِ اسہِ مدد کران تکیازِ أسؠ چھِ کمزور۔ یہ چُھ، تکیازِ أسؠ چھنہٕ زانان زِ اسہِ کیاہ دُعا پزِ کرُن۔ تاہم چُھ پاک روح ذٲتی طور اسہِ وننہٕ بغٲر سانہِ طرفہٕ التجا کران۔
\v 27 وۅنؠ چُھ صرف خدا یُس تحقیق کران چُھ زِ أسؠ کیاہ چھِ سونٛچان تہٕ محسوس کران۔ سُہ چُھ زانان زِ پاک روح کیاہ یژھان۔ تکیازِ روح چُھ خدایہ سنٛدٮ۪ن لوٗکن ہنٛدِ خٲہِشہٕ مطٲبق عرضی کران یہ خدا یژھان چُھ۔
\p
\v 28 اسہِ چھےٚ پژھ زِ خدا چُھ پرٛتھ کانہٛہ  سُہ رُت چیز بناوان یمہِ سٟتؠ تِمن سٟتؠ محبت کران والیٚن فٲیدٕ واتان چُھ۔ تِم چھِ، تِم لوٗکھ یمہٕ خداین ژھانٛڈؠ تکیازِ تمؠ اوس گۅڈے تہِ کرنُک منصوبہٕ بنومُت۔
\v 29 تکیازِ یمہٕ خداین گۅڈے ژٲرؠ مٕتؠ چھِ، تمؠ اوس تِم پننِس گوٚبرِس یسوعؔ ہس ہی بناونُک گۅڈے فٲصلہٕ نِمُت۔ خداین کٔر یہ کٲم اوٕ موٚکھٕ تاکہ تمسنٛدِس گوٚبرس یسوع ہس سپدِ واریاہن بیٚنٮ۪ن تہٕ باین منٛز گۅڈنیُک درجہٕ حٲصِل۔
\v 30 پٔزؠ پٲٹھؠ یمہٕ لوٗکھ خداین پنٕنؠ لوٗکھ بناونہٕ باپتھ گۅڈے ژٲرؠ تِم أنؠ تمؠ ژھانٛڈِتھ پنٕنؠ لوٗکھ بناونہٕ باپتھ۔ تہٕ یِم لوٗکھ خداین ژھانٛڈِتھ أنؠ تِم تہِ بنٲوِن راستباز۔ تہٕ یِم لوٗکھ خداین راستباز بنٲوؠ سُہ بخشہِ تِمن تہِ پنُن جلال۔
\v 31 چونکہ یمہ کتھٕ چھےٚ پزٕ اوٕ کِنؠ پزِ اسہِ تِمن متعلق یہ ونُن؛ چونکہ خدا چُھ اسہِ مدد کران لہٰذا چھُنہٕ کٲنٛسہِ اکِس تیوٗت طاقت زِ سُہ کرِ اسہِ مخالفت\f + \fr 8‏:31 \ft زبور 118:6\f*۔
\v 32 خدا پوٚژ نہٕ پننِس گوٚبرس یسوعسؔ تہِ۔ امہِ بجایہ کوٚڑ سُہ خداین اسہِ سارنےٕ ہنٛدِ باپتھ موتس حوالہٕ۔ تہٕ خدا کرِ یقیناً اسہِ تہ یسوعسؔ سان پرٮ۪تھ نعمتس امیدوار!\f + \fr 8‏:32 \ft پیدٲیِش 22.16\f*
\p
\v 33 پٔزؠ پٲٹھؠ ہیٚکہ نہٕ کانٛہہ تِمن پٮ۪ٹھ الزام لٲگِتھ یمہٕ خداین پنٕنؠ رَیت بننہٕ خٲطرٕ ژٲرمٕتؠ چھِ۔ اوٕ کِنؠ زِ خدایی چُھ سُہ یُس لوٗکن راستباز بناوان چُھ۔
\v 34 بے شک ہیٚکہ نہٕ خدایہ سنٛدٮ۪ن لوٗکن کانٛہہ تہِ کہوٹ لٲگِتھ۔ یہ چُھ اوٕ کِنؠ زِ یسُوع مسیح ہےٕ چُھ سُہ اکھ یُس مود۔ مذید یتہِ زِ سُے چُھ یُس خداین دوبارٕ زندٕ کوٚڑ۔ سُہ چُھ خدایس سٟتؠ اعلیٰ ترین عظمتہٕ واجنہِ جایہ پٮ۪ٹھ، مذید یتہِ زِ سُہ چُھ سانہِ باپتھ عرضی کران۔
\p
\v 35 بے شک ہیٚکہِ نہٕ کانٛہہ تہِ یسوعسؔ اسہِ سٟتؠ محبت کرنہٕ نشہٕ رُکٲوِتھ! اگر لوٗکھ اسہِ تکلیف دِوان چھِ یا تنٛگ کران چھِ، یا اگر أسؠ بۅچھِ ۂتؠ نیٚتھٕ نٔنؠ یا خطرس منٛز آسان چھِ، یا اگر اسہِ لوٗکھ تلوارو سٟتؠ ماران چھِ، تہٕ پٔزؠ پٲٹھؠ ہیٚکہ نہٕ یمو چیزو منٛزٕ کُنہِ تہِ سٟتؠ کانٛہہ تہِ یسوعسؔ اسہِ سٟتؠ محبت کرنہٕ نشہٕ پتھ رٔٹِتھ۔
\v 36 یہ چُھ تی یہ خداین ووٚن پننٮ۪ن صحیفن منٛز، "اے خدا، تِم چھِ اسہِ ہمیشہٕ تُہنٛدِ سببہٕ ماران تہٕ تِم چھِ اسہِ تیٖرن ہنٛدؠ پٲٹھؠ پننہِ باپتھ زبح کران۔\f + \fr 8‏:36 \ft زبور 44:22\f*
\p
\v 37 مگر یمؠ اسہِ سٟتؠ محبت کوٚڑ سُہ چُھ اسہِ تِمن تمام چیزن پٮ۪ٹھ قابو پراونس قٲبِل بناوان یمہ اسہِ سٟتؠ سپدِتھ ہیٚکن۔
\p
\v 38 در حقیقت کوٚڑُس بہٕ خداین قٲیل زِ تِمو چیزو منٛزٕ چُھنہٕ کانٛہہ تہِ چاہے مۅردٕ چُھ یا سانہِ زندگٲنی دوران سپُدمُت چُھ، فرشتو یا شیطانو منٛزٕ یِم حکومت کران چھِ، یا تِم چیز یِم اسہ سٟتؠ سپدن چھِ یا یِم چیز اسہِ سٟتؠ سپدن یا طاقتور بد روح،
\p
\v 39 یا یُس اسہِ پیٚٹھؠ کِنؠ چُھ، یا یہ اسہ بوٚنہٕ کنہِ چُھ، یا بیٚیہِ کانٛہہ چیز یُس خداین پٲدٕ کوٚڑ، یُس اسہِ خدا سنٛدِ محبتہٕ نشہٕ دور کرِتھ ہیٚکہ۔ خدا چھُ اسہِ لول بران تکیازِ أسؠ چھِ پننِس خداوند یسوعؔ مسیحس سٟتؠ یکُت کٔرِتھ!
\c 9
\p
\v 1 بہٕ چُھس تی ونان یہ پوٚز چُھ اکِس شخصہٕ سنٛدِ حثیتہٕ یُس خداین مسیحس سمکھو۔ بہٕ چُھس نہٕ سۅ کتھ ونان یۅسہٕ اپُز آسہِ۔ پاک روح چُھ یمہ کتھہِ ہُنٛد تصدیق کران زِ میٚون ضمیر کمہِ کتھِ ہنٛز گوٲہی چُھ مےٚ دِوان ییٚلہ بہٕ ونان چُھس۔
\v 2 زِ میون دل چھُ مُتوٲتِر سیٹھاہ دۅکھٕ زد!\f + \fr 9‏:2 \ft خروج 32:32\f*
\p
\v 3 بہٕ چُھس یہ کران تکیازِ بہٕ چُھس یہ پوٚز یقین تھاوان زِ خدا والہ مےٚ لعنت تہٕ مےٚ کرِ مسیحس نِش پوٗرٕ پٲٹھؠ دوٚر تاکہ میٲنؠ سٲتھی رشتہٕ دار ین بچاونہٕ۔ تِمن ہُنٛد جسمٲنی تعلق چُھ مےٚ سٟتؠ۔
\v 4 یِم میانؠ رشتہٕ دار چھِ اسرائیلی۔ یِم چھِ تم یِم روحٲنی طور خداین منگتہٕ رٔٹؠ۔ خداین دیُت تِمن یہ آزماونُک اِجازت زِ سُہ کوتاہ جلالہٕ وول چُھ۔ خداین کوٚر تِمن سٟتؠ عہد۔ خداین دِتؠ تِمن پنٕنؠ قانون۔ خداین ہٲو تِمن پنٕنؠ عبادت کرنٕچ وتھ۔ خداین کٔرؠ تِمن سٟتؠ وعدٕ تہِ۔\f + \fr 9‏:4 \ft زبور 147:19\f*
\v 5 سٲنؠ یہُودؠ جدٕاجداد "ابراہامؔ، اسحاق تہٕ یعقوب" ٲسؠ بنی اسرائیلی۔ مسیح تہِ چُھ تِمو منٛزٕ اکھ، یتھٕ کنؠ زن تِمن سٟتؠ کانٛہہ جسمٲنی رشتہٕ تھاوان چُھ۔ مسیح چُھ پرٛتھ چیزس پٮ۪ٹھ حکومت کران۔ سُہ چُھ ابدی محمود خدا۔ یی ٲسِنؠ!
\p
\v 6 امہِ باوجود گوو نہٕ خدا تہِ کرنس منٛز ناکام یمیُک تمؠ اسرائیلین وعدٕ دیُت۔ یہ چُھ پزر، تکیازِ تِم سٲری لوٗکھ یمنہٕ جسمٲنی طور اسرائیل پٮ۪ٹھٕ آمٕتؠ چھِ، چھِ پٔزؠ اسرائیلی۔
\v 7 یتہِ چُھنہٕ پوٚز زِ تِم سٲری لوٗکھ یمہٕ جسمٲنی طور ابراہامؔ سنٛدؠ اولاد چھِ کیا چھِ ابراہامؔ سنٛدؠ حقیقی اولاد۔ یتھٕ کنؠ زن خدای صحیفن منٛز ابراہامس ووٚن، "بہٕ پرزٕناوکھ چٲنؠ حقیقی اولاد اضحاق سنٛدِ وساطتہٕ۔ یہِ دِنُک مےٚ وعدٕ کوٚرمُت چُھے۔"\f + \fr 9‏:7 \ft پیدٲیِش 21:12، عبر 11:18\f*
\p
\v 8 دویمٮ۪ن لفظن منٛز ونو تِم لوٗکھ یِمن جسمٲنی طور ابرہامسؔ سٟتؠ تعلق چُھ تِم چھنہٕ خدایہ سنٛدؠ روحٲنی اولاد۔ بلکہ چھِ خدایہ سنٛدِس وعدٕ کِس نتیجس منٛز تِم یِم خدایہ سنٛدؠ روحٲنی فرزنٛد بنیاے چھِ ابراہامؔ سنٛدؠ حقیقی روحٲنی فرزنٛد رنٛگؠ گنٛزرنہٕ یوان۔
\v 9 در اصٕل چُھ یہ تی یمیُک خداین وعدٕ اوس کوٚڑمُت، ییٚلہ تمؠ صحیفن منٛز ووٚن زِ بہٕ یمہٕ پننِس وقتس پٮ۪ٹھ، نتیجہٕ نیرِ یہ زِ سارہؔ ہس زیوِ نیٚچو۔\f + \fr 9‏:9 \ft پیدٲیِش 18:10-14؛ 21:2\f*
\p
\v 10 یہ چُھنہٕ صرف خدایہ سُنٛد کوٚڑمُت اکھ وعدٕ۔ بلکہ اوس خدایہ سُنٛد وعدٕ یتہِ زِ ربقہ سپٕز تس نفرٕ اضحاق سنٛدِ سٟتؠ حٲملہٕ سُہ چھُ اسہِ اسرائیلین ہنٛد جد۔\f + \fr 9‏:10 \ft پیدٲیِش 25:21\f*
\v 11 بنیٲدی ژور خداین تمسنٛدیٚو دویو اولادو منٛزٕ صرف اکھ اولاد ییٚلہ زن تٔمؠ وُنہِ تِمن زایُن اوس نہٕ دیتمُت تہٕ تِمو اوس نہٕ وُنہِ کینٛہہ صحی یا غلط کوٚڑمُت۔ خداین کوٚڑ یہ اوٕ موٚکھٕ زِ یُس تٔمؠ گۅڈٕ لوٗکھ ژارنہٕ کِس سلسِلس منٛز منصوبہٕ بنومُت اوس سُہ بنہِ ہے۔
\v 12 تمؠ سنٛزو کامٮ۪ن ہنٛدِ سببہٕ ژور نہٕ خداین تمسنٛدیٚو اولادو منٛزٕ صرِف اکھ۔ بلکہ اوس یہ اوٕ موٚکھ زِ خدا چُھ پننٮ۪ن ژٲرِمتٮ۪ن لوٗکن ناد دِتھ انان۔ یوٚہے وجہ چُھ زِ خداین ووٚن ربقہسؔ صحیفن منٛز، "چون بوٚڈ نیٚچو بنہِ چٲنِس لۅکٹِس نیٚچوس غلام"\f + \fr 9‏:12 \ft پیدٲیِش 25:23 \f*
\v 13 یہ چُھ تہِ یہ خداین صحیفن منٛز ووٚن، "بہٕ چُھس لۅکٹِس نیٚچوس یعقوبس سٟتؠ محبت کران، مگر بہٕ چُھسن بوٚڈ نیٚچو عیسو پوٗرٕ پٲٹھؠ رد کران۔"\f + \fr 9‏:13 \ft ملاکی 1:2-3\f*
\p
\v 14 کانٛہہ اکھ ونہِ، "اگر ژےٚ پوٚز ونُتھ تیٚلہ گژھِ خدا یقیناً ناراستباز آسُن" پتہٕ ونہٕ بہٕ، پٔزؠ پٲٹھؠ نہٕ!"
\v 15 أسؠ چھِ زانان زِ خدا چُھ پٔزؠ پٲٹھؠ راستباز تکیازِ خداین ووٚن موسیٰ ہس صحیفن انٛدر، "بہٕ آسہٕ تس کٲنٛسہِ پٮ۪ٹھ رحیم یمِس پٮ۪ٹھ بہٕ رحم کرُن یژھٕ۔\f + \fr 9‏:15 \ft خروج 33:19\f*
\v 16 مگر خدایہ سنٛز رحمت حٲصِل کرنُک انحصار چُھنہٕ یتھ کتھِ پٮ۪ٹھ زِ کُس کوتاہ یژھِ۔ خدایہ سنٛز رحمت کس چھےٚ میلان چُھنہٕ یتھ کتھِ پٮ۪ٹھ تہِ دٔرِتھ زِ کُس کٲژاہ کوشش کرِ۔ بلکہِ چھےٚ اتھ کتھِ پٮ۪ٹھ درِتھ زِ خدا کیاہ یژھِ۔ سُے چُھ، یُس رحم کرن وول چُھ۔
\p
\v 17 بنیٲدی ووٚن خداین صحیفن منٛز فرعونس یی، مےٚ دیُتمےَ ژےٚ مِصرس منٛز بادشاہ بننُک اجازت اوٕ موٚکھٕ تاکہ بہٕ ہیٚکتھ ژٕ یہ زٲنرٲوِتھ زِ بہٕ کوتاہ طاقتور چُھس، مےٚ دیُتمے ژےٚ بادشاہ بننُک تہِ موقہٕ تاکہِ مےٚ میلہِ پورٕ دنیاہس منٛز شہرت۔\f + \fr 9‏:17 \ft خروج 9:16\f*
\v 18 بس، خدا چُھ مہربان یُس ہمیشہٕ رحم کرُن یژھان چُھ۔ مگر یس پٮ۪ٹھ سُہ یژھان چُھ تس چُھ غضب کران۔
\p
\v 19 یہ کینٛژھا مےٚ ووٚن تمہِ کِس ردِعملس منٛز ہیٚکہ مےٚ توٚہہ منٛزٕ کانٛہہ تہِ ونِتھ، یہ ژےٚ ونُتھ اگر تہِ پوٚز چُھ، تیٚلہ پزِ نہٕ یقیناً خدایس لوٗکن پٮ۪ٹھ اِلزام لاگُن یہ کینٛژھا تِم کران چھِ! خدایس پزِ نہٕ تہِ کرُن۔ تکیازِ یہ سُہ یژھان چُھ تہِ کرنہٕ نشہِ ہیٚکہ نہٕ تس کانٛہہ تہِ رُکٲوِتھ۔"
\v 20 پتہٕ ونہٕ یورٕ بہٕ، "توٚہؠ میانیٚو لوٗکو! یُس بحث توٚہؠ خدایس سٟتؠ کران چُھو پزنہٕ پٲٹھؠ چُھو نہٕ توٚہؠ تتھ قٲبِل، یتھٕ پٲٹھؠ خداین بنوو یقیناً پزِنہٕ توٚہہ تس خدایس ونُن یمؠ سُہ بنومُت چُھ، ژےٚ پزٕ ہے نہٕ بہٕ یُتھ بناوُن۔"
\v 21 خدا ہیٚکہِ پٔزؠ پٲٹھؠ تہِ کٔرِتھ یہ سُہ پننٮ۪ن بنٲوؠ مٕتٮ۪ن چیزن سٟتؠ کرُن یژھِ۔ تِتھے پٲٹھؠ، یتھٕ پٲٹھؠ کانٛہہ شخص کُنہ بانس منٛز کینٛہہ تھاوِ پتہٕ یہ خۅش گژھیس تہِ ہکیٚس کٔرِتھ۔ تٔتھؠ موادس ہیٚکہ سُہ کرال کُنہٕ خاص استعمالہٕ باپتھ تہٕ عام استعمالہٕ باپتھ دونوے بانہٕ بنٲوِتھ۔\f + \fr 9‏:21 \ft یَشعیاہ 64:8\f*
\p
\v 22 وۅنؠ پزِنہٕ توٚہہ پٔزؠ پٲٹھؠ خدایس سٟتؠ بحث کرُن، تکیازِ تٔمؠ کٔرؠ تِم لوٗکھ سیٹھاہ صبرٕ سان برداش یِمن سُہ سزا دنہٕ وول اوس تہٕ ہمیشہٕ باپتھ بُرباد کرنہٕ باپتھ تیار اوس۔ تٔمؠ کٔرؠ تِم برداش تکیازِ سُہ اوس یہ ہاوُن یژھان زِ تمِس کوتاہ شرارتھ چُھ تہٕ یہ ہاوُن یژھان زِ سُہ کوتاہ طاقتہٕ وول چُھ۔\f + \fr 9‏:22 \ft امثال 16:4\f*
\v 23 خدا چُھ تِمن لوٗکن تہِ برداش کران یِمن سُہ سزا دییہِ یُتھ یہ ہاوِ زِ کوتاہ جلالہٕ وول چُھ تِمن لوٗکن باپتھ یِمن پٮ۪ٹھ سُہ رحم کرِ۔ خداین کوٚڑ گۅڈے تِمن لوٗکن پوشہٕ وُن جلال دِنُک انتظام۔
\v 24 أسؠ تہِ چھِ، تِمو لوٗکو منٛزٕ یِمن پٮ۪ٹھ خدا مہربان چُھ تہٕ یِم خداین ناد دِتھ أنؠ۔ خدا چُھ لوٗکن ژھانٛڈان یہُودیٚو منٛزٕ تہٕ غٲر یہُودؠ لوٗکو منٛزٕ تہِ۔\f + \fr 9‏:24 \ft رومؔ 3:29، اِفِسیوں 3:6\f*
\p
\v 25 یتھے پٲٹھؠ ووٚن خداین ہوشیعسؔ ہس تہِ، "بہٕ دمہٕ تِمن لوٗکن پنُن ناو یِم نہٕ میانیٚو لوٗکو منٛزٕ ٲسؠ، بہٕ دمہٕ تس شخصس تہِ پنُن عزیز آسنُک ناو یس سٟتؠ نہٕ بہٕ محبت کران اوسُس۔\f + \fr 9‏:25 \ft ہوش 2:23\f*
\v 26 خداین ووٚن ہوشیعسؔ ہس یتہِ، "پتہٕ سپدِ یہ تٔتھؠ جایہ یتہِ مےٚ تِمن گۅڈے ونمُت اوس زِ "توٚہؠ چُھو نہٕ میانؠ لوٗکھ، بہٕ دمہٕ تِمن ناو، خدایہ سنٛدؠ شُرؠ یُس زنٛدٕ چھُ۔" \f + \fr 9‏:26 \ft ہوش 1:10\f*
\p
\v 27 در اصٕل چُھ صحیفن منٛز دویمہِ جایہ یسعیاہؔ بنی اسرائیلس متعلق آلو دِوان، "اگرچہِ سمندر بٹِھس پٮ۪ٹھ سیٚکہ دانن ہنٛدؠ پٲٹھؠ بنی اسرائیلی ٲسؠ، مگر خدا روزِ تِمن منٛز صرف کینٛژنےٕ لوٗکن سزا دِنہٕ نِشہٕ پتھ۔\f + \fr 9‏:27 \ft عزرا 6:8\f*
\v 28 یہ چُھ اوٕ موٚکھٕ زِ خداوند یُس وعدٕ کرِ سُہ انہِ تتھ پوٗرٕ پٲٹھؠ زمینہِ پٮ۪ٹھ عملہِ منٛز۔"\f + \fr 9‏:28 \ft یَشعیاہ 10:22-23\f*
\p
\v 29 یتہِ چُھ تِتھُے ہیٚو یتھٕ کنؠ برُونٛہہ یسعیاہنؔ صحیفن منٛز لیٚوکھ، "اگر سبوتٕکؠ خداوند یُس فرشتن ہنٛدِس فوجس پٮ۪ٹھ حکومت کران چُھ، سانٮ۪ن اولادن رٲچھ کرِ ہے نہٕ، تہٕ سُہ کرِہے اسہِ انٛد ہیٚتھ فناہ یتھ کنؠ تٔمؠ سدومؔ تہٕ عمورہ شہر تباہ کٔرؠ۔"\f + \fr 9‏:29 \ft یَشعیاہ 1:9\f*\f + \fr 9‏:29 \ft پیدائش 18.20؛ 19.24-25\f*
\p
\v 30 چونکہ یمہٕ کتھٕ چھےٚ پزٕ، اوٕ کِنؠ پزِ اسہِ ضروری ونُن زِ ہرگاہ قوم چھنہٕ راستباز بننٕچ کوشش کران، اما پوٚز تِم بنیاے خدایس پٮ۪ٹھ پژھ کٔرِتھ راستباز۔
\v 31 اتھ برعکس کوٚڑ اسرائیل کیٚو لوکو راستباز بننہٕ باپتھ تِم قانون پالنٕچ کوشش یِم خداین تِمن دِتؠ۔ مگر تِم قانون مٲنِتھ ہیٚکؠ نہٕ تِم راستباز بنِتھ۔
\p
\v 32 امیُک وجہ اوس یہ زِ تِمو کوٚر نہٕ خدایس پٮ۪ٹھ بھروسہٕ کٔرِتھ راستباز بننٕچ کوشش۔ امہِ بجایہ کٔر تِمو تمسنٛدِ باپتھ کٲم کرِتھ راستباز بننٕچ کوشش۔ امہِ کِنؠ کٔرؠ تِم مسیحنؔ ناراض ییٚلہِ سُہ آو۔ گویا مسیح چُھ اکھ پل یتھ سٟتؠ تِمن ٹھونٛکرٕ لوٚگ۔
\v 33 خدایس اوس مطلب ییٚلہ تٔمؠ یسعیاہؔ کلامِ مقدس لیکھنوو، "دھیان تھاو بہٕ چُھسن یروشلمس منٛز اکھ تیٚوتھ شخص تھاوان یُس اکہِ کنہِ ہنٛدؠ پٲٹھؠ یتھ سٟتؠ لوٗکن ٹکر سپدان چُھ تہٕ اکھ سۅ کٔنؠ یۅسہٕ لوٗکن تکلیف واتناوان چھےٚ، مگر خدا کرِنہٕ کانٛسہِ تِتھِس شخصس رسوا یُس تمِس پٮ۪ٹھ پژھ تھاوان چُھ۔"\f + \fr 9‏:33 \ft یَشعیاہ 28:16\f*
\c 10
\p
\v 1 میانیٚو ایماندار سٲتھیو! میانؠ دلی خٲہِش چھےٚ زِ خدا بچاوِ بنی اسرئیلین۔ بتہٕ چُھس تہنٛدِ نجاتہٕ باپتھ دُعاگو!
\v 2 تکیازِ بہٕ چُھس ذٲتی طور یہ تصدیق کران زِ تِم چھِ خدایس نیسبت باغٲرت۔ تاہم چھنہٕ تِم پوٗرٕ پٲٹھؠ خدا زاننہٕ باپتھ غٲرتی۔
\v 3 تکیازِ تِم چھنہٕ زانان زِ خدا کِتھٕ پٲٹھؠ چُھ لوٗکن راستباز بناوان تہٕ تِم چھِ پنٕنؠ پٲٹھؠ راستباز بننٕچ کوشش کران۔ یوٚہے وجہ چُھ زِ تِم چھِ تتھ طریقس تٲبع روزنس نکار کران یمہِ طریقہٕ خدا لوٗکن راستباز بناوان چُھ۔
\p
\v 4 تِم چھِ غلط پٲٹھؠ پنُن پان راستباز بناونٕچ کوشش کران، تکیازِ یسُوعؔ مسیح ہن کٔرؠ تِم قانون ختم یِم خداین یہُودین دِتمٕتؠ ٲسؠ۔ مسیحؔ ہن کوٚڑ یہ اوٕ موٚکھٕ تاکہ خدا بناوِ پرٛتھ اکِس شخصس راستباز یس یسوعسؔ پٮ۪ٹھ پژھ آسہِ۔
\p
\v 5 بنیٲدی چُھ یہ تی یہ موسیٰؔ ہن صحیفن منٛز لیٚوکھ زِ خداین ووٚن یہُودٮ۪ن دنہٕ آمتٮ۪ن قانونن پٮ۪ٹھ عمل کٔرِتھ راستباز سپدنس متعلق: "یُس شخص خدایہ سنٛدٮ۪ن سارنےٕ قانونن پٮ۪ٹھ پوٗرٕ پٲٹھؠ عمل کران چُھ سُہ روزِ تہِ کرنہٕ سٟتؠ ہمیشہٕ زنٛدٕ۔"\f + \fr 10‏:5 \ft احبار 18:5\f*
\p
\v 6 تاہم چُھ یہ تی یہ صحیفن منٛز وننہٕ آمُت چُھ زِ لوٗکھ چھِ خدایس پٮ۪ٹھ ایمان اننہٕ سٟتؠ راستباز بنان، پٲنؠ پانس مہٕ ؤنیو، پٔزؠ پٲٹھؠ ہیٚکہ نہٕ کانٛہہ آسمانس پٮ۪ٹھ کٔھسِتھ! "امیُک مطلب گو مسیح زمینس پٮ۪ٹھ والنٕچ کوشش کرٕنؠ۔"
\v 7 موسیٰ ہن ووٚن یمہٕ ؤنیٚو زِ کانٛہہ تہِ ہیٚکہ نہٕ بوٚن وسِتھ سیٚٹھاہ سرٔنِس چہَس منٛز! "امیُک مطلب گو زِ مسیح سنٛدِ مرنہٕ پتہٕ چھےٚ دوبارٕ زندٕ گژھنٕچ کوشش کرٕنؠ۔"
\p
\v 8 تاہم ووٚن موسیٰ ہن صحیفن منٛز یتہِ زِ لوٗکن ہُنٛد خدایس پٮ۪ٹھ بھروسہٕ کٔرِتھ راستباز بننس متعلق، "توٚہؠ ہکیٚو آسٲنی سان زٲنِتھ زِ خداین کیاہ ووٚن، توٚہؠ ہکیٚو امیُک اعلان کرِتھ تہٕ ذٲتی طور زٲنِتھ۔" یہ چُھ تتھ کتھِ کُن اِشارٕ یۅسہٕ خداین تمِس پٮ۪ٹھ بھروسہٕ کرنَس متعلق ؤنؠ۔ یہ چُھ تی یمیُک أسؠ مسیح ہس مانن وٲلؠ اعلان کران روزان چھِ۔\f + \fr 10‏:8 \ft اِستِثنا 30:11-14\f*
\v 9 یمیُک أسؠ اعلان کران روزان چھِ، سُہ چُھ یہ زِ خدا بچاوِ توٚہہِ منٛزٕ پرٛتھ اکِس یُس زبٲنؠ سٟتؠ تسلیم کران چُھ زِ یسوعؔ چُھ پرٛتھ چیزُک خداوند تہٕ ذٲتی طور چُھ پژھ تھاوان زِ خداین کوٚڑ یسُوع مرنہٕ پتہٕ دوبارٕ زندٕ۔
\v 10 یہ چُھ پوٚز، تکیازِ خدا چُھ پرٛتھ تس شخصس راستباز بناوان یُس پانہٕ یسوعسؔ پٮ۪ٹھ پژھ تھاوان چُھ تہٕ سُہ چُھ پرٛتھ تس شخصس بچاوان یُس زبٲنؠ سٟتؠ اقرار کران چُھ زِ یسوع ہےٕ چُھ خداوند۔
\p
\v 11 در اصٕل چُھ صحیفن منٛز یی وننہٕ آمُت، "یُس تس شخصس پٮ۪ٹھ پژھ تھاوان چُھ، خدا کرنہٕ تس ذلیل۔"\f + \fr 10‏:11 \ft یَشعیاہ 28:16، یرمیاہ 17:7\f*
\v 12 بنیٲدی چُھنہٕ خداوند یسُوعؔ یہُودٮ۪ن تہٕ غٲر یہُودٮ۪ن منٛز فرق کران۔ یہ چُھ اوٕ موٚکھٕ زِ یسُوع چُھ سُے خداوند یُس پرٛتھ کٲنٛسہِ پٮ۪ٹھ حکومت کران چُھ۔ سُہ چُھ وژھ، وانجہ تمام لوٗکن برکت سوزان یمہٕ تس بچاوٕ باپتھ فریاد کران چھِ۔
\v 13 بے شک چُھ یوئل صحیفن منٛز لیٚکھان زِ خدا بچاوِ تِمن تمام لوٗکن یمہٕ خداوندس منٛگان چھِ، اسہِ بچاو تہٕ"\f + \fr 10‏:13 \ft یُوایلؔ 2:32، اعمال 2:21\f*
\p
\v 14 مگر لوٗکھ منٛگن نہٕ پٔزؠ پٲٹھؠ خداوند یسوعسؔ پننہِ بچاوٕ باپتھ اگرنہٕ تِم تس پٮ۪ٹھ پژھ آسن تھاوان۔ تہٕ لوٗکھ کرن نہٕ پٔزؠ کِنؠ یسوعسؔ پٮ۪ٹھ پژھ اگر نہٕ تِمو تس متعلق بوزمُت آسہِ۔ لوٗکھ بوزن نہٕ پٔزؠ پٲٹھؠ یسوعسؔ متعلق اگر نہٕ کانٛہہ تِمن برُونٛہہ کنہِ اعلان کرِ زِ سُہ کُس چُھ۔
\v 15 تہٕ پٔزؠ کِنؠ کرن نہٕ لوٗکھ اعلان باقی لوٗکن زِ یسوعؔ کُس چھُ، یوٚتام نہٕ کانہٛہ تِمن نٮ۪بر کُن روانہٕ کرِ۔ یسعیاہؔ سُنٛد اوس یی مطلب ییٚلہ، تٔمؠ صحیفن منٛز لیٚوکھ، "یہ چھےٚ اکھ خوبصورت کتھ ییٚلہ لوٗکھ گژھن تہٕ دویمٮ۪ن لوٗکن ونن خوشخبری رٕتٮ۪ن چیزن متعلق"\f + \fr 10‏:15 \ft یَشعیاہ 52.7، ناحُومؔ 1:15\f*
\p
\v 16 تاہم کٔرنہٕ ساروےٕ یہُودیٚو یسوعسؔ متعلق رٕژ شیٚچھ قبول۔ در اصٕل اوس یسعیاہؔ سُنٛد یوٚہے مطلب ییٚلہ تٔمؠ صحیفن منٛز وون، "خداوند، یہ أسؠ ونان چھِ تتھ پٮ۪ٹھ چُھنہٕ کانٛہہ پژھ کران"\f + \fr 10‏:16 \ft یَشعیاہ 53.1\f*
\v 17 صرف ہیٚکہ اکھ شخص یسوعسؔ متعلق بوزتھےٕ تمِس پٮ۪ٹھ پژھ کرِتھ۔ تہٕ صرِف ہیٚکہ اکھ شخص یسوعسؔ متعلق سُہ پٲغام بوزِتھ یُس مسیحس متعلق چُھ۔
\p
\v 18 تاہم چُھس بہٕ یہ ونان زِ یہودیو بوز پٔزی یہ پٲغام۔ یہ چھےٚ اکھ حقیقت۔ یتھ پٲٹھؠ زن داوودنؔ صحیفن منٛز لیٚوکھ، آسمٲنی مخلوق زنتہٕ چھےٚ گواہ تہٕ سٲرسےٕ دنیاہس منٛز ہیٚکہ پرٛتھ کانٛہہ بوزِتھ زِ تِم کیاہ چھِ ونان"\f + \fr 10‏:18 \ft زبور 19:4\f*
\p
\v 19 یتہِ چُھ یہ بہٕ ونان چُھس، "پٔزؠ پٲٹھؠ سمجھ اسرائیل کیٚو لوٗکو پٲغام" خداین ووٚن ساروےٕ برُونٛہہ موسیٰ سنٛدِ ذریعہ صحیفن منٛز، "بہٕ وۅتلاوٕ ذٲتی طور اکھ سُہ قوم استعمال کرِتھ توٚہہ حسد تہٕ شرارتھ یتھ نہ آسہِ مےٚ سٟتؠ تعلقےٕ تہٕ نہ آسہِ مےٚ زانٲنی"\f + \fr 10‏:19 \ft اِستِثنا 32:21\f*
\p
\v 20 مذید یتہِ زِ خداین کوٚڑ بڈٕ ہمتہٕ سان یسعیاہؔ سنٛدِ ذریعہ صحیفن منٛز اعلان، "مےٚ کوٚڑ پنُن پان تِمن غٲر یہُودؠ لوٗکن منٛز ظٲہِر یمنہٕ مےٚ زاننس منٛز کانٛہہ دلچسپی تھاوان ٲسؠ تہٕ نہ ٲسؠ مےٚ متعلق پرژھٲنی"
\p
\v 21 تاہم ووٚن خداین اسرائیل کٮ۪ن لوٗکن صحیفن منٛز، "بہٕ چُھسو توٚہہ ہمیشہٕ دعوت دِوان زِ مےٚ زٲنیٚو، مگر توٚہؠ چھو ہمیشہٕ میانؠ نافرمٲنی تہٕ مخالفت کران"\f + \fr 10‏:21 \ft یَشعیاہ 65:1-2\f*
\c 11
\p
\v 1 چونکہ یمہٕ کتھٕ چھےٚ پزٕ یمہِ موٚکھٕ بہٕ یہ ونان چُھس زِ خداین کٔرؠ نہٕ پٔزؠ کِنؠ پنٕنؠ یعنی بنی اسرائیلٕکؠ لوٗکھ رد۔ ہرگِز نہٕ! بہٕ چُھس زانان یہ چُھ پوٚز، تکیازِ، بتہِ چُھس بنی اسرائیل\f + \fr 11‏:1 \ft اسرائیلٕکؠ لوٗکھ \f* منٛز اکھ۔ بہٕ چُھس ابرہام سنٛدِ نسلہٕ منٛزٕ۔ خاص کر یہ زِ بہٕ چُھس تمہِ قبیلہٕ منٛزٕ آمُت یُس بنیمینؔ اوس۔
\v 2 خداین ترٲوؠ نہٕ پنٕنؠ لوٗکھ۔ یِم چھِ تِم لوٗکھ یِم تٔمؠ گۅڈے ژٲرمٕتؠ چھِ۔ توٚہہِ آسہِ لٲزمن یہ معلوم زِ نبی ایلیاہنؔ کیاہ ووٚن صحیفن منٛز ییٚلہ تمؠ بنی اسرائیلین خلاف خدایس عرضی کٔر!\f + \fr 11‏:2 \ft زبور 94:14\f*
\v 3 ایلیاہنؔ ووٚن، "خداوند! بنی اسرائیلیو کٔرؠ مےٚ سِوا چٲنؠ تمام نبی قتٕل، چٲنؠ تمام قربان گاہ ژھنِکھ وُپرٲوِتھ۔ بہٕ چُھس ٲخری نبی یُس ونیُک تام زندٕ چُھ، وۅنؠ چھِ تِم میٚتہِ مارنٕچ کوشش کران۔\f + \fr 11‏:3 \ft 1 سلاطین 19:10، 14\f*
\p
\v 4 لہٰذا دیُت خداین ایلیاہسؔ یتھٕ پٲٹھؠ جواب، "مےٚ تھٲوؠ پننہِ مقصدٕ باپتھ ستھ ساس نفر زندٕ، یمو لوٗکو کٔر نہٕ اپزِس خدا بعلؔ سنٛز عبادت"\f + \fr 11‏:4 \ft 1 سلاطین 19:18\f*
\v 5 یتھے پٲٹھؠ ٲسؠ امہِ وقتہٕ کینٛہہ وفادار بنی اسرائیلی تہِ موجود۔ یہ اوس اوٕ موٚکھٕ زِ خداین ٲسؠ تِم پننہِ فضلہٕ پتھ کُن ژٲرمٕتؠ۔
\p
\v 6 چونکہ خدا چُھ پننٮ۪ن لوٗکن یمہِ موٚکھٕ ژاران زِ سُہ کوتاہ فضلہٕ وول چھُ، خدا چُھنہٕ پننٮ۪ن لوٗکن تہنٛزِ کامہِ ہنٛدِس بُنیادس پٮ۪ٹھ ژاران۔ اگر خدا لوٗکن تہنٛدٮ۪ن اعمالن ہنٛدِس بُنیادس پٮ۪ٹھ ژارِ، تیٚلہ کوتاہ فضلہٕ وول چُھ سُہ، یقیناً آسہِ ہے نہٕ سُہ مہربان۔
\p
\v 7 تہٕ اسہِ پزِ یہ نتیجہ زانُن: اگرچہ اسرائیلی لوکھ پنُن پان راستباز بناونٕچ کوشش کران روزن مگر تِم ہیٚکن نہٕ تہِ کرِتھ۔ امہِ بجایہ یمہ خداین تِمو منٛزٕ فضلہٕ دٔسؠ ژٲرمٕتؠ چھِ تِمے بنیاے راستباز۔ مگر خداین بنٲوؠ تِم لوٗکھ سرکش یِمنہٕ تٔمؠ فضلہٕ دٔسؠ ژٲرؠ۔
\v 8 یہ چُھ بلکُل تی یہ خدایہ سُنٛد مطلب اوس ییٚلہِ تمؠ صحیفن منٛز لیٚوکھ، "خداین کٔرؠ بنی اسرائیلٕکؠ لوٗکھ صحی پٲٹھؠ نہ سونچنس پٮ۪ٹھ مجبور، یوٚت تام نہٕ موجود وق ووت، توٚتام کٔرؠ خداین تِم مکمل پٲٹھؠ یہ سمجھنس منٛز ناکام زِ راستباز کِتھٕ پٲٹھؠ چھُ بنُن"\f + \fr 11‏:8 \ft اِستِثنا 29:4، یَشعیاہ 6:9-10، 29:10، عزرا 12:2\f*
\p
\v 9 داوودنؔ تہِ ووٚن صحیفن منٛز، "اے خدا، تہنٛز عٲشہٕ عشرتٕچ زندگی بناو تہٕ تہنٛدِ باپتھ پوٗرٕ پٲٹھؠ ۅبال یتھٕ پٲٹھؠ کانٛہہ شکٲرؠ جانورس زالس یا ٹُھپِس منٛز پھساوان چُھ! تہنٛز عٲشہٕ عشرتٕچ زندگی کرُن گناہ گٲری پٮ۪ٹھ آمادٕ تہٕ تِمن دِ پننٮ۪ن گُنہن ہُنٛد سزا۔\f + \fr 11‏:9 \ft زبور 69:22-23، زبور 35:8 \f*
\q1
\v 10 تہٕ تِم بناوُکھ ہمیشہٕ باپتھ سمجھنہٕ رنگؠ ناقٲبل، غلامن ہنٛدؠ پٲٹھؠ تُلناوُکھ ہمیشہٕ خٲطرٕ دۅکھ!\f + \fr 11‏:10 \ft زبور 69.22-23، زبور 35.8\f*
\p
\v 11 چونکہِ یمہٕ کتھٕ چھےٚ پزٕ اوے چُھس بہٕ یہ ونان، "یہُودین کھۅت نہٕ یقیناً یہ بوزِتھ شرارتھ زِ خدا کرِ تِمن بلکل رد۔ ہرگِز نہٕ بلکہ چُھ خدا غٲر یہُودؠ لوٗکن بچاوان تکیازِ یہُودؠ لوٗکو کٔر تِہنٛز نافرمٲنی۔ یہ سپُد اوٕ موٚکھٕ زِ خدا سنٛدِ خٲطرٕ کرن یہُودؠ لوٗکھ غٲر یہُودؠ لوکن ہُنٛد حسد یِم تس زانان چھِ۔\f + \fr 11‏:11 \ft اِستِثنا 32:21\f*
\v 12 اصلی کوٚر خداین یہ اوٕ کِنؠ زِ یہُودؠ لوٗکو کتھٕ کِنؠ کٔر تمسنٛز نافرمٲنی تہٕ سپدؠ پنپن پان راستباز بناونس منٛز ناکام تہٕ پورٕ دنیاہس منٛز میلہِ تمام قومہٕ کٮ۪ن لوکن انیٖکھ برکت، لہٰذا ییٚلہ وفادار یہُودؠ لوکن ہنٛز پوٗرٕ جماتھ راستباز سپدِ، تہٕ امہ تہِ گژھِ زیادے برکت۔
\p
\v 13 مگر وۅنؠ چُھس بہٕ توٚہہ سٟتؠ کتھ کران غٲر یہُودؠ لوٗکھ یِم یسوعسؔ پٮ۪ٹھ بھروسہٕ کران چھِ۔ بے شک بنونس بہٕ خداین غٲر یہُودؠ لوکن ہنٛدِ باپتھ پنُن نمایندٕ۔ اوٕ کِنؠ چُھس بہٕ ونان زِ یہ کینٛژھا بہٕ غٲر یہُودؠ لوٗکن ہنٛزِ خدمتہٕ باپتھ کران چُھس تہِ کوتاہ جان چُھ۔
\v 14 اگر ممکن آسہ تہٕ بہٕ چُھس یژھان زِ یِمن سٟتؠ بہٕ جسمٲنی تعلق تھاوان چُھس تِمن یہُودٮ۪ن غٲر یہُودؠ لوٗکن سٟتؠ یِم خدایس زانان چھِ حسد کرُن تاکہ خدا بچاوِ تِمن منٛز کینٛژن۔
\p
\v 15 بے شک چُھ خدا یہُودٮ۪ن رد کرنہٕ کِس نتیجس منٛز دنیا کٮ۪ن لوٗکن سٟتؠ ملناوان۔ لہٰذا ییٚلہ خدا یہُودؠ لوٗکن قبول کران چُھ، تمہ کِس نتیجس منٛز کرِ خدا تِمن لوٗکن زندٕ یِم مۅردٕ آسن۔
\v 16 بنیٲدی طور چھِ یہُودؠ لوٗکن ہنٛدؠ جدٕاجداد خدایہ سنٛدؠ، یتھٕ پٲٹھؠ مانٛڈِ متہِ آٹیُک اکھ حصہٕ خدایہ سُنٛد چُھ، تتِھےکِنؠ چھِ سٲری یہُودؠ خدایہ سنٛدؠ، بلکُل تِتھے پٲٹھؠ زِ سورےٕ مونٛڈمُت اوٹ چُھ خدایہ سُنٛد۔ لہٰذا ٲسؠ یہُودین لوکن ہنٛدؠ جدٕاجداد خدایہ سنٛدؠ، یتھ پٲٹھؠ زیتون کُلین ہنٛدؠ موٗل خدایہ سنٛدؠ چھِ، سٲری یہُودؠ لوٗکھ خدایہِ سنٛدؠ چھِ، تِتھے کنؠ چھِ زیتون کُلِکؠ شاخ تہِ خدایہ سنٛدی۔
\p
\v 17 پٔزؠ پٲٹھؠ ژھٕنؠ خداین کینٛہہ یہُودؠ پننہِ قومہٕ منٛزٕ کڈِتھ، یتھٕ پٲٹھؠ اکھ کۅمیُل زیتون کُلِس کینٛہہ شاخ ژٹان چُھ۔ مگر خداین بنٲیو توٚہؠ یسوعسؔ پٮ۪ٹھ پژھ تھاون وٲلؠ غٲر یہُودؠ لوٗکھ پننٮ۪ن لوٗکن ہنٛدؠ حصہٕ دار، یتھٕ پٲٹھؠ اکھ کۅمیُل جنگلی زیتون کُلٮ۪ن کاشت کرنہٕ آمتٮ۪ن زیتون کُلٮ۪ن ہُنٛد پیونٛد کران چُھ۔ توٚہؠ تہِ سپدیٚو خدایہ سنٛدٮ۪ن بندن سٟتؠ رلِتھ فٲیدٕ تُلنس منٛز شریک۔ یتھٕ پٲٹھؠ پیونٛد کرنہٕ آمٕتؠ شاخ زیتون کُلہِ کیٚو موٗلو نشہِ غذا حٲصل کرنس منٛز شریک سپدان چھِ۔
\v 18 امہِ کِنؠ پزِنہٕ توٚہہ یِم یسوعسؔ پٮ۪ٹھ پژھ تھاوان چھِ تِمن یہُودٮ۪ن پٮ۪ٹھ فخر کرُن یِم خداین کٔڈِتھ ژھٕنؠ، یوٚدوے تمہِ ژٹنہٕ آمژن لنجن ہنٛدؠ پٲٹھؠ آسن۔ ییٚلہِ توٚہؠ فخر کٔریٚو، تہٕ توٚہہ پزِ یہ زانُن زِ توٚہؠ چھوکھ نہٕ یہُودؠ لوٗکھ قٲیِم تھٲوِتھ بلکہ چھِ تِم توٚہہ قٲیِم تھاوان، یتھٕ کنؠ موٗل شاخن غذا واتناوان چھِ!
\p
\v 19 وۅنؠ ہکیٚو توٚہؠ ونِتھ، "خداین ژھٕنؠ کینٛہہ یہُودؠ لوٗکھ پننہِ قومہٕ منٛزٕ کٔڈِتھ، یتھٕ پٲٹھؠ اکھ کۅمیُل کُلٮ۪ن شاخ ترٲشی کران چُھ۔ خداین کوٚر یہِ تاکہِ سُہ ہیٚکہِ مےٚ پننٮ۪ن لوٗکن سٟتؠ جورِتھ یِتھٕ پ ٹھؠ اکھ کمیُل اکِس کُلِس منٛز اکھ شاخ پیوند کران چھُ۔
\v 20 بہٕ دمہٕ یہ ونِتھ جواب زِ تُہنٛد ونُن چُھ صحی۔ خداین ژھٕنؠ یہُودیٚو منٛزٕ کینٛہہ نفر پننہِ جمٲژ منٛزٕ کٔڈِتھ، یتھٕ پٲٹھؠ اکھ کۅمیُل پننٮ۪ن کُلٮ۪ن بےٚ پھل لنجہٕ ژٔٹِتھ نِوان چُھ تکیازِ تِم ٲسؠ بے وفا۔ تاہم چھِ غٲر یہُودؠ لوکھ یمہٕ یسوعسؔ پٮ۪ٹھ پژھ تھاوان چھِ، تس پٮ۪ٹھ بھروسہٕ کٔرِتھ خدایہ سنٛدین لوٗکن ہنٛدِ حصہٕ بنان چھِ۔ تکبُری خیال مہٕ أنیٚو ذہنس منٛز زِ أسؠ چھِ بے ایمان یہُودؠ لوکو کھۅتہٕ بہتر! بلکہِ کھوژیٚو خدایس۔
\v 21 توٚہہ پزیٚو خدایس کھۅژُن تکیازِ تٔمؠ کوٚڑ نہٕ بےوفا یہُودؠ لوٗکن پٮ۪ٹھ رحم یِم قدرتی شاخن ہنٛدؠ پٲٹھؠ ٲسؠ۔ لہٰذا کرِنہٕ سُہ توٚہہ غٲر یہُودؠ لوٗکن پٮ۪ٹھ رحم اگر توٚہؠ یسُوعؔ ہس پٮ۪ٹھ پژھ کرٕنؠ ترٲیو۔
\p
\v 22 چونکہ یہ چُھ پوٚز، اوٕ کِنؠ سونٛچِو زِ خدا کوتاہ مہربان تہٕ سخت ہیٚکہ ٲسِتھ۔ خدا چُھ تِمن لوٗکن سٟتؠ سختی سان پیش یوان یمہٕ تِمس پٮ۪ٹھ پژھ کرٕنؠ تراوان چھِ۔ تاہم کرِ خدا توٚہہ غٲر یہُودؠ لوٗکن پٮ۪ٹھ مہربٲنی یمہٕ یسوعسؔ پٮ۪ٹھ پژھ تھاوان چھِ۔ اگر توٚہؠ یہ مانان روزیو زِ سُہ کوتاہ مہربان چُھ۔ وۅنؠ اگر توٚہؠ تہِ کٔریٚو نہٕ تہٕ خدا تہِ کریٚو توٚہہِ رد۔ یتھٕ پٲٹھؠ اکھ کۅمیُل کُلِس بے پھل لٔنٛڈ ژٹان چُھ۔
\p
\v 23 تاہم اگر تِم بے وفا یہُودؠ یسوعسؔ پٮ۪ٹھ ایمان تھاوان چھِ، تہٕ خدا دییہِ تِمن پننٮ۪ن لوٗکن منٛز دُبارٕ شٲمِل گژھنُک اجازت۔ یتھٕ پٲٹھؠ اکھ کۅمیُل کُلِس لنجہِ پیوند کران چُھ۔ یہ چُھ اوٕ موٚکھٕ زِ خدایس چُھ تیوت طاقت زِ سُہ ہیٚکہ یہُودٮ۪ن پننٮ۪ن لوٗکن منٛز شٲمِل کٔرِتھ۔
\v 24 بنیٲدی کٔڈؠ نو توٚہؠ خداین غٲر یہُودؠ قومہٕ منٛزٕ یمہٕ یسوعسؔ پٮ۪ٹھ پژھ تھاوان ٲسؠ تہٕ وۅنؠ کٔرؠ نو توٚہؠ پننِس قومس منٛز شٲمِل۔ یتھٕ پٲٹھؠ اکھ کۅمیُل کاشت کرنہٕ آمٕتؠ زیتون کُلٮ۪ن ہنٛدؠ شاخ جنٛگلی کُلٮ۪ن پیونٛد کٲری ذریعہ لاگان چُھ، یودوے زن یہِ قدرتی چھُنہٕ۔ چونکہ یہِ چھُ پوٚز، توے کرِ خدا یقیناً خدا اسرائیل کیٚن لوٗکن پننٮ۪ن لوٗکن منٛز شٲمِل۔ یتھٕ پٲٹھؠ اکھ کۅمیُل کاشت کرنہٕ آمٕتؠ زیتون کُلٮ۪ن ہنٛدؠ شاخ پننٮ۪ن کُلٮ۪ن پیونٛد پیوند چھُ کران۔
\p
\v 25 بہٕ چُھس یہ ونان، تکیازِ بہٕ چُھسو توٚہؠ پٔزؠ کِنؠ یژھان، میانیٚو غٲر یہُودؠ ایماندارو، زٲنیٚو زِ خداین کیاہ تھوو گۅڈ ژوٗرِ، تاکہ توٚہہ کٔریٚو نہٕ کِبر۔ خداین تھٲو گۅڈٕ لوٗکن نشہٕ یہ حقیقت ژوٗرِ زِ بنی اسرائیل منٛزٕ کرن کینٛہہ لوٗکھ تۅتام تس مخالفت یۅتام خدایہ سنٛدؠ منتخب کٔرمٕتؠ تمام غٲر یہُودؠ لوٗکھ تمسنٛدِس قومس منٛز شٲمِل سپدن نہٕ۔
\v 26 پتہٕ بچاوِ خدا یتھے پٲٹھؠ اسرائیل کٮ۪ن تمام لوٗکن۔ یسعیاہسؔ اوس یوٚہے مطلب ییٚلہ تٔمؠ صحیفن منٛز لیٚوکھ، "خدا سوزِ یروشلمہ پٮ۪ٹھٕ کانٛسہِ پنٕنؠ لوٗکھ بچاونہٕ باپتھ، سُہ شخص رُکاوِ یعقوب سنٛدٮ۪ن اولادن بے دین سپدنہٕ نشہٕ"\f + \fr 11‏:26 \ft یَشعیاہ 59:20\f*
\p
\v 27 خدا چُھ ونان، "یہ چُھ سُہ مہادٕ یُس بہ یعقوب سنٛدین اولادن سٟتؠ کرٕ، ییٚلہ بہٕ تِمن گناہ معاف کرٕ یمہٕ تِمو کٔرمٕتؠ چھِ۔\f + \fr 11‏:27 \ft یَشعیاہ 43:25-26، 27:9\f*
\v 28 رٕژ شیٚچھ رد کرن والیٚن یہُودٮ۪ن متعلق، یمہٕ تُہنٛدِ فٲیدٕ باپتھ خدایہ سنٛدؠ دشمن چھِ۔ تاہم خدایہ سنٛدِ یہُودؠ لوٗکھ ژارنہٕ کِس سلسِلس منٛز چُھ خدا تِمن تہٕ تہنٛدٮ۪ن جدٕاجدادن سٟتؠ وعدٕ کرِمتہِ موجُب لول کران۔
\v 29 یہ چُھ پزر تکیازِ خدا چُھنہٕ تِم چیز واپس نِوان یِم سُہ فضلہٕ دسؠ عنایت کران چُھ۔ سُہ چُھنہٕ تِمن لوٗکن تہِ تراوان یِمن سُہ پنٕنؠ لوکھ زٲنِتھ سمبراوان چُھ۔
\p
\v 30 پٔزؠ پٲٹھؠ چُھ یہ بلکُل تِتھُے ہیٚوٗ یتھٕ کنؠ توٚہؠ غٲر یہُودؠ لوٗکھ یمہٕ یسُوعؔ ہس پٮ۪ٹھ پژھ تھاوان چھِ خدایہ سنٛز نافرمٲنی کران ٲسؠ، مگر ووٚن سپُد خدا توٚہہ پٮ۪ٹھ مہربان تکیازِ یہُودیٚو کٔر تمسنٛز نافرمٲنی۔
\v 31 یتھے کنؠ چھِ وۅنؠ یہُودؠ تہِ خدایہ سنٛز نافرمٲنی کران تکیازِ خدا چُھ توٚہہ غٲر یہُودؠ لوکن پٮ۪ٹھ مہربان۔ یہ سپُد اوٕ موٚکھٕ زِ خدا تہِ کرِ وۅنؠ تِمن پٮ۪ٹھ رحم۔
\v 32 اصلی دِژ خداین پرٛتھ اکِس تمسنٛز نافرمٲنی کرنُک اِجازت تاکہ سُہ کرِ تِمن پٮ۪ٹھ رحم۔
\p
\v 33 خدا چُھ سیٚٹھاہ غنی، حکیم تہٕ علمہٕ وول! کانٛہہ تہِ ہیٚکہ نہٕ پوٗرٕ پٲٹھؠ سمجھِتھ زِ سُہ کیاہ چُھ کران!
\v 34 پٔزؠ پٲٹھؠ یتھٕ کنؠ زن یسعیاہنؔ لیٚوکھ، "کانٛہہ تہِ ہیٚکہ نہٕ یہ سمجِھتھ زِ خداوند کیاہ چُھ سونٛچان یا کیاہ چُھ تمِس ونان"\f + \fr 11‏:34 \ft یَشعیاہ 40:13\f*
\p
\v 35 امہِ علاوٕ یتہِ زِ کانٛہہ تہِ ہیٚکہِ نہٕ خدایس کینٛہہ تہِ دِتھ یمہِ سٟتؠ خدا تمسُنٛد قرضدار سپدِ"\f + \fr 11‏:35 \ft ایوب 41:11\f*
\p
\v 36 یِم کامہِ ہیٚکہِ نہٕ کانہٛہ تہِ کٔرِتھ، تکیازِ پرٛتھ کانٛہہ چیز آو خدایہِ سنٛدِ پٮ۪ٹھٕ، خدایہِ سنٛدؠ ذریعہٕ چھِ موجود تہٕ خدایہِ سنٛدِ خٲطرٕ چُھ موجود۔ بہٕ چُھس خدایس منٛگان زِ پرٛتھ کانٛہہ کٔرِن ہمیشہٕ باپتھ تمسنٛدؠ تعریف۔ یی سپدِن پوٚز!
\c 12
\p
\v 1 تہٕ پتہٕ یہ کینٛژھا مےٚ تتھ پٮ۪ٹھ سونٛچِتھ توٚہہ ووٚن، بہٕ چُھس توٚہہ پنٕنؠ سٲتھی ایماندار زٲنِتھ نصیحت کران یتھ بُنیادس پٮ۪ٹھ زِ خدا کوتاہ مہربان چُھ۔ پنُن پان کٔریٚو خدایہ سنٛدِ باپتھ قربان، زٲنیٚو زنتہٕ چھِ أسؠ زندٕ جانور یمہٕ کانٛہہ خدایس پیش کران چُھ۔ پاک روزِتھ کٔرؠ وون خدا رٲزؠ۔ یہ کرُن چُھ تُہنٛدِ خدٲیی خدمٕژ ہُنٛد معقول طریقہٕ
\v 2 پنُن پان مہٕ بنٲیو موجودٕ دورٕ کٮ۪ن گناہ گار لوٗکن ہنٛدؠ پٲٹھؠ۔ بلکہ دِیو خدایس پنُن طرزِ عمل تہٕ سونٛچنُک انداز بدلاونہٕ یُتھ توٚہؠ پرکھٲیو، تتھ ثٲبت کرِتھ ہکیٚو زِ خدا کیاہ چُھ یژھان۔ خدا چُھ یژھان زِ توٚہؠ کریٚو تہِ یہ رُت، خۅشوُن تہٕ بےٚعٲب آسہِ۔
\p
\v 3 اصلی چُھ یمہِ کتھِ ہنٛزِ بنیٲز پٮ۪ٹھ زِ خداین دیُت مےٚ یمہِ کتھِ ہنٛز نمایندٕ گی کرنُک اختیار زِ بہٕ چُھس توٚہہِ منٛزٕ پرٛتھ اکِس ونان، پنُن پنُن پان مہٕ سمجھِو بہتر۔ بلکہِ سونٛچو پانس متعلق وارٕ، خداین یمہِ اعتبارٕ توٚہہ منٛزٕ پرٛتھ اکِس تس پٮ۪ٹھ بھروسہٕ کرنٕچ قدر عطا کٔر۔
\p
\v 4 توٚہہ پزِ پانس متعلق بہتر پٲٹھؠ سونٛچُن، تکیازِ یتھ کنؠ اکِس انسٲنی جسمس واریاہ حصہٕ آسان چھِ یمہٕ سٲری الگ الگ مقصدو باپتھ کٲم کران چھِ،
\v 5 تہٕ یتھے پٲٹھؠ چھِ أسؠ واریاہ مسیح ہس پٮ۪ٹھ پژھ تھاون وٲلؠ مسیح سنٛدِ باپتھ اکہِ جمٲژ ہنٛدِ حثیتہٕ متحد۔ اسہِ منٛزٕ چُھ پرٛتھ کانٛہہ اکھ اکِس سٟتؠ تِتھے کنؠ متحد یتھٕ کنؠ انسٲنی جسمٕکؠ تان اکھ اکِس سٟتؠ متحد چھِ۔
\p
\v 6 پتہٕ تہِ کرِ اسہِ مسیح ہس مانن والیٚو مختلف روحٲنی صلٲحیژٕ تحفہٕ رنگؠ حٲصل یمہٕ اسہِ خداین عطا کرِ۔ اگر خداین توٚہہ نبوتُک توفیق عطا کوٚر، تیٚلہِ کٔرِو خدایس پٮ۪ٹھ بھروسہٕ کرنکہِ تمہِ مقدارٕ مطٲبق نبوت یُس خداین توٚہہِ بخشو۔
\v 7 اگر خداین توٚہہ خدمت کرنُک توفیق دیُت تہٕ توٚہہِ پزیٚو باقین ہنٛز خدمت کرٕنؠ۔ اگر توٚہؠ خداین باقین تعلیم دِنس قٲبِل بنٲیو تہٕ توٚہہِ پزیٚو تِمن تعلیم دِنؠ۔
\v 8 اگر خداین توٚہہ دویمٮ۪ن حوصلہٕ افزٲیی کرنُک توفیق دیُت تہٕ توٚہہِ پزیٚو تِمن ہنٛز حوصلہٕ افزٲیی کرٕنؠ۔ اگر خداین توٚہؠ اتھ قٲبِل بنٲیو زِ یہ کینٛژھا توٚہہِ نِش چُھ تہِ ہکیٚو توٚہؠ دویمٮ۪ن تہِ دِتھ، تہٕ توٚہہِ پزیٚو تہِ وژھِ وٲنجہِ دیُن۔ اگر خداین توٚہؠ دویمٮ۪ن ہنٛز رہنمٲیی کرنُک طاقت دیُت تہٕ توٚہہ پزیٚو پوٗرٕ تن دہی سان دویمٮ۪ن ہنٛز رہنمٲیی کرٕنؠ۔ اگر خداین توٚہہِ رحم کرنُک توفیق دیُت تہٕ توٚہہ پزیٚو خۅشدلی سان رحم کرُن۔
\p
\v 9 اکھ اکِس سٟتؠ کٔریٚو پوٚز محبت۔ بدی نشہِ روزیٚو دور۔ یہ اصل چُھ تہٕ رٔٹیٚو پوٗرٕ شدتہٕ سان۔\f + \fr 12‏:9 \ft عاموس 5:15\f*
\v 10 محبت کرن والیٚن ایماندارن ہنٛدِس سلسِلس منٛز یِیو اکھ اکِس سٟتؠ محبتہٕ سان پیش۔ دویمٮ۪ن سٲتھی ایمان والیٚن عزت کرنہٕ باپتھ کٔریٚو پانہٕ پہل۔
\p
\v 11 کٲہِل مہٕ بنیٚو بلکہ بنِو محنتی۔ دِلس منٛز کٔریٚو روحٲنی جوش پٲدٕ۔ خدایہ سنٛز کٔریٚو خدمت۔
\v 12 خۅش روزیٚو تکیازِ توٚہہ چُھو خداوندس پٮ۪ٹھ بھروسہٕ۔ ییٚلہِ توٚہہ تکلیف واتہِ، صبر کٔرزیٚو۔ دُعا رُوزِو ہٮ۪تھےٕ منٛگان۔
\v 13 یہ توٚہہ چُھ بٲگرٲیو خدایہ سنٛدٮ۪ن لوٗکن یہ تِمن ضرورت آسہِ۔ باقین پننٮ۪ن گرن منٛز خۅش آوے کرنٕکؠ کٔریٚو موقہٕ تلاش۔
\p
\v 14 خدایس منٛگیٚو، تِمن لوٗکن کر برکت یمہ توٚہہ سٟتؠ بدسلوکی کران چھِ۔ خدایس منٛگیٚو زِ تمن پٮ۪ٹھ لعنت سوزنہٕ بجایہ دِیو تِمن برکت۔
\v 15 تِمن لوٗکن سٟتؠ منٲیو خوشی یِم خوشی مناوان آسن، تِمن سٟتؠ ودِو یِم ودان رِوان آسن۔\f + \fr 12‏:15 \ft زبور 35:13\f*
\v 16 اکھ أکؠ سُنٛد تھٲیو تیوت خیال تہٕ سونچ یوٗتاہ پنُن تھاوان چُھو۔ پانس پٮ۪ٹھ مہٕ کریٚو کِبُر سوار۔ عٲجِز لوٗکن ہنٛدِس صحبتس منٛز روزیٚو۔ تکبُر مہٕ کٔریٚو۔\f + \fr 12‏:16 \ft امثال 3:7، زبور 5:21\f*
\p
\v 17 یمؠ توٚہہ سٟتؠ بُرٲیی کٔر تمِس سٟتؠ مہٕ ورتٲیو بُرٕ۔ تِمہٕ کامہِ کرنس پٮ۪ٹھ کٔرِو غور یِمن پرٛتھ اکھ بہتر زانان چُھ۔
\v 18 پرٛتھ کانٛسہِ سٟتؠ روزیٚو امنہٕ سان یۅتام تُہندِ باپتھ یہ ممکن سپدِ۔
\p
\v 19 ٹاٹھیٚو ایماندارو، یِمن سٟتؠ بہٕ محبت کران چُھس، اگر توٚہہ سٟتؠ کانٛہہ بُرٕ ورتاوِ تمِس مہٕ ہیٚو بدلہٕ۔ تمِس دییہِ خدا پانے سزا۔ بہٕ چُھسو توٚہہ یہ ونان تکیازِ موسیٰ چُھ یہ پننٮ۪ن صحیفن منٛز لیٚکھان، "خداوند چُھ ونان، "بہٕ ہیمہٕ تمِس بدلہِ یُس توٚہہ سٟتؠ بُرٕ ورتاوِ تہٕ بہٕ دمہٕ تِمن تہنٛدِ کرِمتہِ حسابہٕ سزا"\f + \fr 12‏:19 \ft اِستِثنا 32.35\f*
\v 20 بلکہِ چُھن اسہِ بدلہٕ ہیٚنُک اِجازت دنہٕ بجایہ صحیفن منٛز ہِدایت دیتمُت زِ پنٕنؠ دشمن کھیاوُکھ چیاوُکھ اگر تِمن کھین چینٕچ ضرورت پییہِ۔ یہ کٔریٚو تکیازِ ییٚلہِ توٚہؠ یہ کٔریٚو تہٕ تُہنٛدؠ دشمن سپدن شرمنٛدٕ زنتہٕ تھٲیو توٚہؠ تہنٛدٮ۪ن کلن پٮ۪ٹھ دزوٕنؠ تینگل۔\f + \fr 12‏:20 \ft امثال 25:21-22\f*
\v 21 دویمٮ۪ن لفظن منٛز ونو بُرٲیی سٟتؠ بُرٲیی ہُند جواب دِتھ ہیٚکو نہٕ بُرٲیی پٮ۪ٹھ قوبو لبِتھ بلکہِ ہیٚکہ وون نیکی ہُند جواب دِتھ بُرٲیی ہارنٲوِتھ۔
\c 13
\p
\v 1 توٚہہ منٛزٕ چُھ پرٛتھ اکِس پنُن پان تِمن لوٗکن تٲبع کرُن یِمن خداین توٚہہ پٮ۪ٹھ حکومت کرنُک اختیار دیُت۔ اوٕ موٚکھٕ زِ کانٛہہ تہِ ہیٚکہِ نہٕ تۅتام حکومت کرِتھ یۅتام نہٕ خدا تس سُہ اختیار دییہِ۔ خداین کرِ وُنہِ کٮ۪ن موجود حکومژ قٲیِم۔\f + \fr 13‏:1 \ft طِطُس 3:1\f*
\v 2 وۅنؠ یِم لوٗکھ یِمن ہنٛز مزمت کران چھِ یِمن خداین حکومت کرنُک اختیار دیُت۔ تِم چھِ خدایہ سنٛدٮ۪ن حکمن ہنٛز مخالفت کران۔ خدا دییہ تِمن لوٗکن سزا یمہٕ مخالفت کران چھِ۔ یِمن تمؠ حکومت کرنُک اختیار دیُت۔
\v 3 اصلی یِم لوٗکھ حکومت کران چھِ تِم چھنہٕ اصٕل کٲم کرن والیٚن کھۅژناوان بلکہِ چھِ تِم تِمن لوٗکن کھۅژناوُن یژھان یمہٕ بُرٕ کامہِ کران چھِ۔ اگر توٚہؠ تِمن کھۅژُن چُھونہٕ یژھان یِمن خداین حکومت کرنُک اختیار دیتمُت چُھ، تیٚلہِ کریٚو تہِ یہ بہتر چُھ یُتھ حکومت کرن وٲلؠ تُہنٛدؠ تعریف کرن۔
\v 4 یہ چُھ اوٕ کِنؠ زِ لوٗکھ یِمن خداین حکومت کرنُک اختیار دیتمُت چُھ، چھِ تُہنٛدِ فٲیدٕ باپتھ خدایہ سنٛز خدمت کران۔ وۅنؠ اگر توٚہؠ بُرٕ کامہِ کران چُھو تیٚلہِ پزِ توٚہہ کھۅژُن۔ تکیازِ خداین چُھ تِمن لوٗکن اختیار دیتمُت یمہٕ بہتر وجوہاتو کِنؠ سزا دِنُک حکم دِوان چھِ۔ بنیٲدی چھِ تِم لوٗکھ یِم حکومت کران چھِ تمہِ عوض خدایہ سنٛز رٕتؠ پٲٹھؠ خدمت کران بُرٕ کام کرن والیٚن سزا دِتھ۔
\v 5 امہِ کِس نتیجس منٛز پزِ توٚہہ پنُن پان تِمن لوٗکن سُپرد کرُن یِمن پٮ۪ٹھ خدا حکمرٲنی کرنُک اختیار تھاوان چُھ۔ توٚہہ پزِ یہ کرُن، نہ صرِف اوٕ موٚکھٕ زِ تِم ہیٚکن توٚہہ سزا دِتھ بلکہِ اوٕ موٚکھٕ تہِ زِ توٚہؠ چُھو زانان زِ تہنٛز نافرمٲنی گییہِ خدایہ سنٛز نافرمٲنی!
\v 6 اصلی چُھو توٚہہ یِمن چیزن ہنٛدِ سببہٕ مٲلیہ تہِ دیُن۔ توٚہؠ دِیو محصول تہِ، تکیازِ تِم لوٗکھ یِمن خدا حکمرٲنی کرنُک اختیار دِوان چُھ چھِ خدایہ سنٛز خدمت کران۔ تِم چھِ پنُن پان خدمتہٕ باپتھ وقف کران۔
\v 7 پرٛتھ اکِس دِیو تہِ یہ توٚہہِ واجب دیُن آسہِ۔ محصول روزیٚو بران یہ توٚہہِ مٲلیہِ واتان آسہِ۔ فیس ٲسیٚو ادا کران یہ توٚہہ فیس واتان آسہِ۔ تِمن لوٗکن کھۅژیٚو یِمن توٚہہ کھۅژُن پزِ۔ تِمن لوٗکن کٔریٚو عزت یِمن عزت کرُن واتہِ۔
\v 8 کانٛسہِ ہنٛدؠ مقروض مہٕ بٔنیٚو۔ بلکہِ روزیٚو باقی لوٗکن سٟتؠ محبت ورتاوان یِم مسیحس پٮ۪ٹھ پژھ تھاون وٲلؠ چھِ زنتہٕ توٚہؠ تِہنٛدؠ مقروض چُھو۔ یہ کٔرؠ زیٚو تکیازِ یُس شخص کانٛسہِ دویمِس سٟتؠ محبت کران چُھ سُہ چُھ تہِ پوٗرٕ کران یمیُک تقاضہٕ خدا تِمن قانونن منٛز کران چھُ یِم تمؠ یہُودین عنایت کٔرؠ۔
\v 9 یہ چُھ پوٚز تکیازِ خداین چُھ پننٮ۪ن قانونن منٛز یِمن کتھن ہُنٛد حکم دیتمُت۔ ییٚلہِ تٔمؠ ووٚن، "یمِس سٟتؠ نہٕ توٚہہ نیتھٕر آسہِ سپُدمُت، تمِس سٟتؠ مہٕ تھٲیو جنسی تعلق، قتٕل مہٕ کٔریٚو، ژوٗر  مہٕ کٔریو لوٗکن۔ دویمٮ۪ن ہنٛدٮ۪ن چیزن مہٕ زٲگیٚو، توٚہؠ ہکیٚو بدل کُنہِ چیزُک تہِ ونِتھ یتھ متعلق خداین تِمن قانونن منٛز وونمُت چُھ یِم تٔمؠ یہُودین دِتمٕتؠ چھِ۔ یِمن دویمٮ۪ن چیزن سٟتؠ دیُت خداین یہ حکم تہِ زِ "دویمٮ۪ن سٟتؠ تہِ کٔریٚو تِتھے پٲٹھؠ محبت یتھ پٲٹھؠ توٚہؠ پانس سٟتؠ کران چُھو"\f + \fr 13‏:9 \ft خروج 20:13-16، احبار 19:18، اِستِثنا. 5:17-19، 21\f*
\p
\v 10 ییٚلہ توٚہؠ باقین سٟتؠ محبت کران چُھو تیٚلہ چُھو نہٕ توٚہؠ تِمن سٟتؠ بُرٕ ورتاوان۔ یوٚہے وجہ چُھ زِ دویمٮ۪ن سٟتؠ محبت کرنہٕ سٟتؠ چھِ تِم چیز پوٗرٕ سپدان یِم خداین یہُودٮ۪ن ہنٛدٮ۪ن قانونن منٛز طلب کٔرمٕتؠ چھِ۔
\v 11 یہ کام کٔریٚو تکیازِ توٚہؠ چُھو زانان زِ یہ کُس وقت چُھ۔ یہ چُھ تُہنٛدِ باپتھ روحٲنی طور ہُشار روزنُک وق۔ تکیازِ سُہ وق یمہِ ساعتہٕ یسُوع اسہِ بچاونہٕ باپتھ واپس ییہِ چُھ تمہِ کھۅتہٕ تہِ نزدیک یمہِ ساعتہ اسہِ تس پٮ۪ٹھ بھروسہٕ کرُن ہیٚوتمُت اوس۔
\v 12 تِتھے پٲٹھؠ یتھٕ پٲٹھؠ راتھ شروع سپدنہٕ برُونٛہہ دوٚہہ چُھ اند واتان، یمہِ گناہ گار دُنیہُک وق چُھ لگ بھگ ختم سپُدمُت، تہٕ یسُوع ییہِ عنقریب واپس۔ اسہِ پزِ تہِ کرُن تراوُن یہ لوٗکھ انہِ گٔٹؠ عالمس منٛز کران چھِ۔ امہِ بجایہ پزِ اسہِ بُرٲیی ہنٛز مخالفت نیکی سٟتؠ کرٕنؠ، یتھ پٲٹھؠ زن اکھ سپاہ دوٚہس پنٕنؠ ذر بکتر دشمنس سٟتؠ لڑنہٕ باپتھ لٲگِتھ تھاوان چُھ۔
\p
\v 13 اسہِ پزِ بہتر ورتاو کرُن، ییٚلہ زن یہ دُہل چھےٚ تہٕ لوٗکھ ہیٚکن وُچِھتھ زِ أسؠ کیاہ چھِ کران۔ اسہِ پزِ نہٕ نشس منٛز جشن مناوُن تہٕ نہ پزِ نشس منٛز روزُن۔ اسہِ پزن نہٕ لاکمہِ روس غٲر اخلٲقی جنسی ہرکٔژ کرنہِ۔ اسہِ پزن نہٕ باقین سٟتؠ لڑایہ کرنہِ تہٕ تِہُنٛد حسد تھاوُن۔
\v 14 یمہٕ کامہِ کرنہٕ بجایہ پزن اسہِ خداوند یسُوع مسیح سنٛدؠ کامہِ کرنہِ۔ پننہِ پانہٕ باپتھ مہٕ بٔریٚو تمہِ چیزٕچ فِکر یہ تُہنٛزٕ بد خٲہشہِ کرُن یژھان چھےٚ۔
\c 14
\p
\v 1 کانٛسہِ تہِ سٲتھیس کٔرؠ زیٚو خۅش آوے مسیح ہس پٮ۪تھ ایمان اننس یُس نہٕ پوٗرٕ زانان آسہِ زِ ایمان کتھٕ کنؠ چُھ انُن۔ تِمن گژھِ نہٕ اتھ پٮ۪ٹھ بحث لاگنہٕ باپتھ استقبال کرُن۔
\v 2 کینٛہہ لوٗکھ چھِ یِمن پژھ چھےٚ زِ تِم ہیٚکن کُنہ تہِ قسمُک کھیٚن کھیٚتھ۔ مگر مسیحس پٮ۪ٹھ ایمان تھاون وٲلؠ کینٛہہ نا پۅختہٕ چھِ یہ سونچان زِ تِم ہیٚکن چارٕ سبزی کھیٚتھ۔
\p
\v 3 مسیح ہس پٮ۪ٹھ پژھ تھاون وول یُس پرٛتھ قسمُک کھٮ۪ن کھیٚوان چُھ گژھِ نہٕ پننِس سٲتھی ایماندارس حقارت کرُن یُس نہٕ پرٛتھ قسمُک کھٮ۪ن کھیٚوان آسہِ۔ مسیح ہس پٮ۪ٹھ ایمان تھاون وول یُس نہٕ پرٛتھ قسمُک کھٮ۪ن کھیٚوان آسہ تمِس تہِ چُھنہٕ پننِس سٲتھی ایماندارس پٮ۪ٹھ پنُن فٲصلہٕ صٲدر کرُن یُس پرٛتھ قسمُک کھیٚن کھیٚوان آسہِ۔ یہ چُھ اوٕ کِنؠ زِ خدا چُھ یِمن دۅشونی خۅش آوے کران۔
\v 4 توٚہہ چُھنہٕ پننِس سٲتھی ایماندارس پٮ۪ٹھ فٲصلہٕ صٲدر کرُن یُس دویمِس مٲلکہ سنٛدِس غلام سنٛدؠ پٲٹھؠ آسہِ۔ سُہ آسہِ یا تہٕ پننِس مٲلکس رٲضؠ کران یا نہٕ، یتھٕ پٲٹھؠ مٲلک فٲصلہٕ نِوان آسہِ۔ توتہِ کرِ خدا تس خۅش اوے۔ تکیازِ خداوند ہیٚکہِ یہ کرِتھ۔
\p
\v 5 کینٛہہ لوٗکھ چھِ مخصوص دوہُن خاص زانان ییٚلہ زن باقی تمام دوہُن ہیٚوی چھِ زانان۔ پرٛتھ فردس گژھِ پوٗرٕ پٲٹھؠ یقین آسُن زِ یہ کینٛژھا تِم کران چھِ تہِ چھِ تِم خدایہ سنٛدِس تعظیمس منٛز کران۔\f + \fr 14‏:5 \ft گلتی 4:10، کُل 2:16\f*
\v 6 یُس شخص کانٛہہ مخصوص دوٚہہ خاص سمجھان چُھ سُہ چُھ خداوند سنٛدِ تعظیمہٕ باپتھ تہِ کران۔ یُس شخص پرٛتھ قسمُک کھٮ۪ن کھیٚوان چُھ سُہ چُھ خدایہ سنٛدِس تعظیمس منٛز تہِ کران یہ چُھ اوٕ موٚکھٕ زِ سُہ شخص چُھ خدایہ سُنٛد شکُر ادا کران۔ یُس شخص کانٛہہ چیز کھیٚنہٕ نشہٕ انکار کران چُھ سُہ چُھ خدایہ سنٛدِ تعظیمہٕ باپتھ تہِ کران۔ سُہ شخص تہِ چُھ خدایہ سُنٛد شُکر ادا کران۔
\p
\v 7 یہ چُھ پزر تکیازِ اسہِ مسیحسؔ پٮ۪ٹھ ایماندارو منٛزٕ چُھنہٕ کانٛہہ تہِ صرف پنُن پان خۅش تھاونہٕ باپتھ زُوان تہٕ اسہِ منٛز چُھنہٕ کانٛہہ تہِ پننہِ پانہٕ چہِ خۅشی باپتھ مران۔
\v 8 پزر چُھ یہ زِ یۅتام أسؠ مسیح سنٛدؠ ایمان وٲلؠ زنٛدٕ چھِ، أسؠ چھِ زُوان خداوند سنٛزِ خۅشی باپتھ۔ ییٚلہ أسؠ مران چھِ تہٕ أسؠ چھِ خداوند سنٛزِ رضا خٲطرٕ مران۔ لہٰذا أسؠ زُوو یا مرو أسؠ چھِ خدایہ سنٛدؠ۔
\v 9 بنیٲدی چُھ یوٚہے وجہ زِ مسیح مود تہٕ پتہٕ گو دوبارٕ زنٛدٕ۔ تاکہ سُہ بنہ زنٛدن ہُنٛد تہٕ مۅردن ہُنٛد خداوند۔
\p
\v 10 یۅتام زن تُہنٛد تعلُق چُھ، توٚہہِ منٛزٕ یِم پننٮ۪ن سٲتھی ایماندارن فٲصلہٕ دِوان چھِ، تِمن پزِ نہٕ تہِ کرُن۔ توٚہہ پزن نہٕ پننٮ۪ن سٲتھی ایماندارن حقارت کرٕنؠ! تِم کامہِ مہٕ کٔریٚو، تکیازِ اکھ دوٚہہ واتہِ ییٚلہ خدا اسہ سارنےٕ ہُنٛد فٲصلہٕ کرِ یِمو مسیح ہس پٮ۪ٹھ ایمان اوٚنمُت چُھ۔
\v 11 بنیٲدی چُھ یہ یسعیاہنؔ صحیفن منٛز لیٚوکھمُت، "خداوند چُھ فرماوان زِ یتھٕ کنؠ زن بہٕ زندٕ چُھس، یہ کتھ چھےٚ یقینی زِ پرٛتھ کانٛہہ کرِ میانؠ عبادت تہٕ پرٛتھ کانٛہہ کرِ مےٚ بحثیتِ خدا تسلیم"\f + \fr 14‏:11 \ft یَشعیاہ 45:23، 49:18 \f*
\p
\v 12 لہٰذا چُھ پرٛتھ اکِس یس تہِ مسیح ہس پٮ۪ٹھ ایمان چُھ یقیناً خدایس برُونٛہہ کنہِ جواب دیُن یہ کینٛژھا أسؠ کران چُھ، یۅتام أسؠ زنٛدٕ چھِ۔
\v 13 اوٕ کِنؠ چُھ اسہِ باقی ایماندارن ہُنٛد انٛزرُن تراوُن۔ امہِ بجایہ چُھ اسہِ تِژھ کانٛہہ کٲم نہ کرنُک اِرادٕ کرُن یۅسہٕ سانٮ۪ن ایماندار سٲتھین گناہ کرنس پٮ۪ٹھ آمادٕ کرِ۔
\p
\v 14 مےٚ چُھ خداوند یسُوع سنٛدِ طرفہٕ پوٗرٕ یقین دنہٕ آمُت زِ کانٛہہ تہِ کھیٚن چُھنہٕ فطرتن مسیح سنٛدٮ۪ن ایمان والیٚن باپتھ کھیٚون گناہ۔ اگر کانٛہہ کُنہِ چیزس پانس پٮ۪ٹھ حرام کرِ تہٕ تمسنٛدِ باپتھ چُھ سُہ کھیٚن کھیٚون حرام۔
\v 15 پنٕنؠ سٲتھی ایماندار مہٕ کٔرووکھ گناہ کرنس پٮ۪ٹھ آمادٕ، تکیازِ اگر توٚہؠ پننٮ۪ن سٲتھی ایماندارن تِم چیز کھیٲوِتھ غمگین کٔرووکھ یمہ کھیٚنؠ تِم گناہ سمجھان چھِ، تیٚلہ چُھو نہٕ توٚہؠ محبتہٕ سان کٲم کران۔ کانٛہہ سٲتھی ایماندار مہٕ بنٲے وون یمہِ کتھِ ہُنٛد بٲعث زِ یہ توٚہؠ کھیٚون یژھان ٲسیٚو تہٕ تمہِ موجُب ترٲیو خدایہ سُنٛد بھروسہٕ تہٕ سپدیٚو ہمیشہٕ باپت بُرباد! مسیح مود سُہ شخص بچاونہٕ باپتھ!
\p
\v 16 لہٰذا مہٕ کٔریٚو تِژھ کانٛہہ کٲم یمہِ سٟتؠ کانٛہہ تِمن اصلیٚن چیزن بد ونہِ یمہٕ توٚہہ خداین دِتؠ نو۔
\v 17 تمہٕ کٔریٚو تکیازِ کھیٚون چیٚون چُھنہٕ خدایہ سنٛز بادشٲہی ظٲہر کران۔ بلکہ چھےٚ راستبٲزی، امن تہٕ خۅشحٲلی پاک روح کہ ذریعہ خدایہ سنٛز بادشٲہی ظٲہر کران۔
\p
\v 18 یقیناً یُس تہ کانٛہہ ایماندار یمو کامیٚو سٟتؠ مسیح سنٛز خدمت چُھ کران چُھ خدایس پسنٛد، تہٕ باقی لوٗکھ تہِ کرن تمِس شخصس پسنٛد۔
\v 19 لہٰذا پزِ اسہِ بےٚ صبری سان پننٮ۪ن سٲتھی ایماندارن سٟتؠ امنہٕ سان روزنٕچ کوشش کرِنؠ تہٕ اکھ اکِس مدد کرنٕچ کوشش کرٕنؠ تاکہ سُہ سپدِ روحٲنی طور بالغ۔
\p
\v 20 خداین یہ کینٛژھا کوٚڑ تتھ مہٕ واتنٲیو زخ تکیازِ توٚہؠ چُھو کینٛہہ خاص غذا کھیٚون یژھان۔ خدا چُھ اسہِ پرٛتھ کُنہِ قسمُک کھیٚن کھیٚنُک اِجازت دِوان۔ وۅنؠ گوو کانٛسہِ باپتھ چُھ کانٛہہ کھیٚن کھیٚون گناہ، اگر تہِ کرنہٕ سٟتؠ تُہنٛد کانٛہہ سٲتھی ایماندار گناہ کرنس پٮ۪ٹھ آمادٕ ییہِ کرنہٕ۔
\v 21 بہتر چُھ کانٛہہ ماز نہ کھیٚون، نہ شراب چیٚون یا کانٛہہ تِژھ کٲم نہ کرٕنؠ یۅسہٕ تُہنٛدٮ۪ن سٲتھی ایماندارن\f + \fr 14‏:21 \ft بیٚنہِ یا بٲے\f* گناہ کرنس پٮ۪ٹھ آمادٕ کرِ۔ یا یۅسہٕ تمِس شخصس ٹھیس واتناو یا تمِس شخصس روحٲنی طور کمزور وزنہٕ دِیہ۔
\p
\v 22 تہِ کرو یتھ پٮ۪ٹھ توٚہہ پژھ چھےٚ یہ خدا توٚہہ کرُن ونان چُھ، چُھ توٚہہ تہٕ خدایس درمیان۔ سُہ شخص یُس نہٕ تتھ متعلق خطا زد محسوس کران چُھ یتھ سُہ صحی مانان چُھ سُہ چُھ بختہٕ وول۔
\v 23 اتھ برعکس چُھ خدا تِتھس کانٛسہ شخصہٕ سُنٛد فٲصلہٕ کران یُس کینٛہہ کھیٚون گناہ یا درنٛگی چُھ سمجھان تہٕ تہِ چُھ کھیٚوان۔ یہ چُھ اوٕ موٚکھٕ زِ تمؠ شخصن کٔر نہٕ تمہِ مطٲبق عمل یہ سُہ شخص صحی مانان چُھ۔ یُس شخص کانٛہہ تِژھ کٲم کران چُھ یۅسہٕ تمِس شخصہٕ سنٛدِ ماننہٕ مطٲبق صحیح آسہِ نہٕ، سُہ چُھ گناہ کران۔
\c 15
\p
\v 1 بے شک پزِ اسہ، یِم مسیحسؔ پیٚٹھ روحٲنی طور پۅختہٕ ایمان تھاوان چھِ، پننٮ۪ن تِمن ایماندار سٲتھین حمایت کرٕنؠ یِمن روحٲنی طور مسیحس پیٚٹھ ایمان نا پۅختہٕ چھُ۔ اسہِ پزِ نہٕ صرف تہِ کرُن یہ اسہِ پانس خۅش چُھ گژھان۔
\v 2 اسہِ سارنی یمہ مسیحس پٮ۪ٹھ پژھ چھِ تھاوان پزِ تِتھے پٲٹھؠ رُت کرُن یہِ سانٮ۪ن باقی ایمان والیٚن سٲتھین پسنٛد چُھ۔ تاکہِ تہِ سپدِ یہ تِہنٛدِ باپتھ جان روزِ تہٕ تِمن روحٲنی طور بالغ سپدنس منٛز مدد میلہِ۔
\v 3 مثال کرو، یسُوع مسیح ہن تہِ کوٚر نہٕ پننہِ خۅشی باپتھ کینٛہہ بلکہ رود سُہ دویمٮ۪ن ہنٛزِ خۅشی باپتھ زندٕ۔ داوود سُنٛد تہِ اوس یوٚہے مطلب ییٚلہ تٔمؠ پننٮ۪ن صحیفن منٛز لیٚوکھ زِ مسیح ہن ووٚن خدایس، "ییٚلہ لوٗکھ ژےٚ توہین کران چھِ تِم چھِ میٚتہِ توہین کران۔\f + \fr 15‏:3 \ft زبور 69:9\f*
\v 4 اصلی لیٚوکھ گۅڈٕ نبیو اسہِ ہیٚچھناونہٕ باپتھ تہِ سورےٕ۔ تِمو لیٚکھؠ صحیفہٕ تہِ، تاکہ اسہِ میلہ تِمو کتھو سٟتؠ یقین یمہٕ صحیفن منٛز وننہٕ چھےٚ آمژٕ یمہٕ اسہِ برداشت کرنس منٛز مدد دِوان چھےٚ تہٕ اسہٕ حوصلہٕ بخشان چھےٚ۔
\v 5 بہٕ چُھس دُعا کران زِ سون صٲبِر تہٕ حوصلہٕ دنہٕ وول خدا دِین توٚہہ اکھ اکِس سٟتؠ مِلژار سان روزنُک توفیق، یتھ کنؠ زن یسُوع مسیح رودمُت چُھ۔
\v 6 بہٕ چُھس دُعا کران زِ توٚہؠ روزیٚو اکھ اکِس سٟتؠ رلِتھ میلِتھ تاکہ ییٚلہ توٚہؠ خدایہ سنٛدؠ تعریف کٔریٚو توٚہؠ ٲسیٚو یکُت کٔرِتھ۔ سُہ چُھ سٲنس خداوند یسُوع مسیح سُنٛد بب۔
\v 7 پننٮ۪ن سٲتھی ایمان والیٚن کٔریٚو تِتھے پٲٹھؠ خۅش آوے یتھ پٲٹھؠ یسُوع مسیح ہن خدایہ سنٛدؠ تعریف کرنہٕ باپتھ توٚہہ استقبال کوٚر۔
\v 8 پزر چُھ یی زِ بہٕ پولُسؔ چُھسو توٚہہ ونان زِ یسُوع مسیح چُھ ختنہٕ کٔرمتٮ۪ن یہُودٮ۪ن ہنٛز خدمت اوٕ مۅکھٕ کران زِ خدا کوتاہ قٲبلِ اعتماد چُھ۔ تمؠ کوٚر یہ اوموٚکھٕ تاکہ سُہ چیز ییہِ محفوظ تھاونہٕ یمیُک وعدٕ خداین یہُودٮ۪ن ہنٛدٮ۪ن جدٕاجدادن، ابراہامس، اضحاقسؔ تہٕ یعقوبس سٟتؠ کوٚرمُت اوس۔\f + \fr 15‏:8 \ft متی 15:24\f*
\v 9 یسُوعؔ ہن تہِ کوٚر تی یُتھ زن قوم خدایہ سنٛدؠ حمد کرن۔ تکیازِ سُہ چُھ سیٚٹھاہ رحم دل۔ داودسؔ اوس یہ مطلب ییٚلہ تمؠ صحیفن منٛز لیٚوکھمُت اوس، "ییٚلہ بہٕ قومن درمیان آسہٕ تہٕ بہٕ کرٕ اعلان زِ ژٕ کُس چُھکھ، تہٕ گیٚوان گیٚوان پرٕ چٲنؠ ثناہ"\f + \fr 15‏:9 \ft 2 شموایلؔ 22:50، زبور18:49\f*
\v 10 پتہٕ ووٚن موسیٰؔ ہن کلامِ مقدسس منٛز، "توٚہؠ تمام قوم، منٲیو خدایہ سنٛدٮ۪ن لوٗکن سٟتؠ رلِتھ جشن"\f + \fr 15‏:10 \ft اِستِثنا 32:43\f*
\v 11 تہٕ یتہِ لیوکھ کٔمتام صحیفس منٛز زِ، "اے تمام قوم کیٚو لوکو، خداوند سنٛدؠ تعریف کٔریٚو! تمام لوٗکھ کٔرؠ زیٚو تمسنٛدؠ حمد۔\f + \fr 15‏:11 \ft زبور 117:1\f*
\p
\v 12 نبی یسعیاہنؔ ووٚن صحیفن منٛز یتہِ زِ یُس داوود نِس مٲلِس یسیؔ سنٛدِ پُشتہٕ منٛزٕ چُھ سُہ ییہِ تہٕ لاگہ قومن پٮ۪ٹھ حکومت، تمسنٛدِ سببہٕ سپدِ قومن اکھ اعتماد حٲصِل"\f + \fr 15‏:12 \ft یَشعیاہ 11:11\f*
\v 13 بہٕ چُھس دُعا کران زِ سُہ خدا یُس لوٗکن اعتماد بخشان چُھ سپدِن توٚہہ تمِس پٮ۪ٹھ بھروسہٕ کرنہٕ سٟتؠ سیٚٹھاہ خۅشی تہٕ دینو سکوٗنُک احساس! بہٕ چُھس دُعا کران زِ خدا کٔرِن یہ، یُتھ زن روح القدس سنٛدِ ذریعہ توٚہہ اتھ قٲبِل بناوِتھ توٚہہ واریاہ اعتماد حٲصل سپدِ۔
\v 14 میانیٚو ٹاٹھیو ایمان والیٚو، خداین کوٚرس بہٕ پانہٕ تہِ قٲیل زِ توٚہہ منٛزٕ چُھ پرٛتھ اکھ واریاہ جان۔ واریہن چیزن ہُنٛد بہتر علم تھاون وول تہٕ دویمٮ۪ن ہیٚچھناونس قٲبِل تہِ۔
\v 15 یتھ خطس منٛز لیٚوکھ مےٚ توٚہہ کینٛژن کتھن متعلق بےٚ پھُروکؠ پٲٹھؠ یمہ یسوعسؔ پٮ۪ٹھ پژھ تھاوان چھِ تاکہ توٚہہ روزیٚو تِمن متعلق یاد۔ مےٚ کوٚر یہ، تکیازِ خداین دیُت مےٚ یہ کرنُک اختیار۔
\v 16 خداین کوٚر یہ، اوٕ موٚکھٕ زِ بہٕ کرٕ یسُوعؔ مسیح سنٛز خدمت غٲر یہُودؠ لوٗکن منٛز خدایہ سنٛدِ طرفہٕ یہ خۅش خبر بوزنٲوِتھ، زنتہٕ بہٕ اکھ کاہن چُھس۔ بہٕ چُھس یہ امہِ کِنؠ کران، غٲر یہُودؠ لوٗکو باپتھ یمہ یسُوعؔ ہس پٮ۪ٹھ بھروسہٕ کران چھِ، کرن تیٚوتھ کینٛہہ چیز یُس خدایس پیش آسہِ کرنہٕ آمُت تہٕ یہ روح القدس تمِس باپتھ الگ تھاوان چُھ۔
\v 17 لہٰذا چُھس بہٕ اکِس تِتھس شخصہٕ سنٛدؠ پٲٹھؠ یسُوع مسیح ہس سٟتؠ رٔلِتھ، یس یتھ کتھ پٮ۪ٹھ فخر کرنس بہترین وجہ چھِ یہ خدا میانہِ ذریعہ کران چُھ۔
\v 18 در اصٕل ونہٕ بہٕ یہ کتھ فخرٕ سان زِ مسیح ہن کیا کیا کرنوو میانہِ ذریعہ یمہ سٟتؠ قومن فرمانبرداری کرنس منٛز خدایہ سنٛزِ خۅشخبری پٮ۪ٹھ بھروسہٕ چُھ۔ مٮسیحؔ ہن کوٚر تہِ یہ مےٚ ووٚن تہٕ کوٚر۔
\v 19 مسیحنؔ کوٚڑ یتہِ زوردار تہٕ حٲرت انگیز معجزو ذریعہ، زنتہٕ خدایہ سنٛدؠ روحن بہٕ طاقتور بنووُس۔ نتیجہ دراو یہ زِ مےٚ کوٚڑ یروشلمہٕ پٮ۪ٹھ الرَکُم تام مسیح سنٛزِ خوشخبری ہُنٛد اعلان مکمل۔
\v 20 تہٕ یتھے کنؠ اوسُس بہٕ یہ خۅش خبری تِمن جاین تام واتناوُن یژھان یتہِ نہٕ لوٗکو زانٛہہ تہِ مسیح ہس متعلق بوزمُت اوس۔ بہٕ اوسُس نہٕ یژھان کانٛسہِ ہنٛزِ کامہِ منٛز مداخلت کرٕنؠ۔ بلکہِ اوسُس بہٕ سُے تعمیر کھالُن یژھان یتھ کانٛسہ کٕن دیتمُت آسہِ ہے۔
\v 21 بلکہ چھُس بہٕ تِم لوٗکھ خۅشخبری بوزناوان یمو نہٕ زانٛہہ بوزمٕژ ٲس۔ یہ چُھ تی یہ یسعیاہنؔ صحیفن منٛز لیٚوکھمُت اوس، "تِمن لوٗکن یِمن نہٕ تمِس متعلق کٲنٛسہِ ووٚنمُت چھُ کرن مشٲہدٕ زِ کُس چھُ سُہ۔ یِمو لوٗکو نہٕ تمِس متعلق بوزمُت چھُ تِمن ترِ فکرِ زِ سُہ کُس چھُ۔\f + \fr 15‏:21 \ft یَشعیاہ 52:15\f*
\v 22 تٔمؠ رُکووُس بہٕ رومسؔ منٛز بار بار توٚہہ سارنےٕ سمکھنہٕ نِشہ۔\f + \fr 15‏:22 \ft رومؔ 1:13\f*
\v 23 مگر تمہِ وزِ ٲس نہٕ مےٚ تِمن علاقن منٛز گژھنہٕ باپتھ خۅشخبری وننہ خٲطرٕ کانٛہہ تہِ جاے۔ بتہِ اوسُس کینٛژو وریو پٮ۪ٹھٕ توٚہہ سمکھنُک انتہٲیی خٲہِش منٛد۔
\v 24 لہٰذا ییٚلہ تہِ بہٕ صوبہ اسفانیہؔ گژھان چُھس تہٕ بہٕ رومہٕ منٛزؠ پکن وزِ توٚہہ سمکھنٕچ امید تھاوان۔ بہٕ چُھس یہ امید تہِ تھاوان زِ توٚہؠ سٟتؠ کینٛژس کالس لُطف اندوز سپدِتھ کٔریٚو مےٚ توٚہؠ اسفین گژھنہٕ کِس سفرس منٛز مدد۔
\v 25 مگر فِلحال گژھٕ بہٕ یروشلم یُتھ بہٕ تتہِ خدایہ سنٛدٮ۪ن لوٗکن خدمت کرٕ۔
\v 26 بہٕ چُھس یہ کران تکیازِ مکدُنیہ تہٕ اخیہ کٮ۪ن صوبن ہنٛدؠ ایماندار چھِ یروشلمس منٛز روزن والیٚن خدایہ سنٛدٮ۪ن غریب لوٗکن پونٛسہٕ دِتھ مدد کرنس منٛز خۅش۔
\v 27 بنیٲدی ٲسؠ تِم ایماندار سیٹھاہ خۅشحال تہٕ تِمن پزِ ہے یروشلم کٮ۪ن غریب ایماندارن مدد کرُن۔ یہ چُھ اوٕ کِنؠ زِ غٲر یہُودؠ ایمان وٲلؠ چھِ یہُودؠ پژھ، والیٚن نِش روحٲنی فٲض حٲصل کران۔ لہٰذا پزِ غٲر یہُودؠ ایمان والیٚن زِ تِم کرن یہُودؠ ایمان والیٚن ہنٛز خدمت یۅسہٕ تِمن جسمٲنی طور درکار چھےٚ۔
\v 28 اوٕ کِنؠ ییٚلہ بہٕ یہ کٲم انٛد واتنٲوِتھ یروشلم کٮ۪ن غریب ایماندارن یہ رقم بہتر پٲٹھؠ واتناوٕ تہٕ بہٕ نیرٕ اسفین گژھن وزِ تُہنٛدے شہرٕ کِنؠ۔
\v 29 مےٚ چھےٚ پژھ زِ ییٚلہ بہٕ توٚہہ سٟتؠ ملاقات کرٕ تہٕ مسیحؔ کرِ اسہِ بٔڈ برکت!
\p
\v 30 میانیٚو سٲتھی ایماندارو، بہٕ چُھس توٚہہ گذٲرش کران پننِس خداوند یسُوع مسیح سنٛدِ وساطتہٕ زِ پاک روحن کتھٕ کنؠ بنٲوؠ أسؠ اکھ اکِس سٟتؠ محبت کرنس لایکھ۔ أتھؠ بنیٲز پٮ۪ٹھ چُھس بہٕ توٚہہ درخواست کران زِ مےٚ سٟتؠ کٔریٚو میانِس حقس منٛز خدایس نِش دُعا!
\v 31 دُعا کٔرزیٚو زِ خدا گوٚژھ مےٚ یہُودیہ صوبہٕ کٮ۪ن یہُودین نِش نجاتھ دیُن یِم نہٕ یسُوعؔ ہس مانان چھِ۔ یہ دُعا تہِ کٔرؠ زیٚو زِ یروشلمس منٛز گژھن خدایہ سنٛدؠ لوٗکھ سُہ رقم قبول کرٕنؠ یُس بہٕ تِمن تتہِ غریب ایماندارن باپتھ دمہٕ۔
\v 32 یہ دُعا تہِ کٔرؠ زیٚو زِ بہٕ یمہٕ خۅشی سان توٚہہ برُونٛہہ کُن یتھٕ پٲٹھؠ زن خدا یژھان چُھ تہٕ أسؠ کرو اکھ اکِس تازٕگی عطا۔
\v 33 ٲخرس پٮ۪ٹہ چُھس بہٕ دُعا منٛگان زِ سُہ خدا یُس اسہِ سکون عطا کران چُھ آسہِ توٚہہ سارنی سٟتؠ۔ تی سپدِن پزرٕ سان!
\c 16
\p
\v 1 بہٕ "پولُسؔ" چُھس توٚہہ پننہِ سٲتھی فیبےؔ ناوچہ بیٚنہِ تہٕ ایمان واجنہِ ہنٛز سفٲرش کران۔ سۅ چھےٚ تمہِ ایمان واجنہِ جمٲژ ہنٛز تہِ خدمت کران یمہٕ کنخریہؔ شہرس منٛز سمٕکھؠ۔\f + \fr 16‏:1 \ft اعمال 18:18\f*
\v 2 بہٕ چُھس توٚہہ فوبیؔ ہنٛز تہِ سفٲرش کران یُتھ توٚہؠ سۅ خداوند یسُوعؔ سنٛدٮ۪ن ایمان والیٚن منٛز اکھ سٲتھی ایمان واجِنؠ قبول کٔرؠ وون۔ سۅ کٔرؠ وون تتھٕ پٲٹھؠ قبول یتھ پٲٹھؠ خدایہ سنٛدٮ۪ن لوٗکن خٲطرٕ منٲسب روزِ۔ بتہِ چُھس تُہنٛدِ باپتھ تمِس سفٲرش کران تاکہ تمِس گژھ پرٛتھ رنٛگہٕ مدد یمہِ تہٕ چیزٕچ تمِس توٚہہ نِش ضرورت آسہِ۔ یہ کٔرؠ زیٚو تکیازِ تمہِ کوٚر پانہٕ مےٚ سان واریہن لوٗکن مدد۔
\p
\v 3 پرسکہِ تہٕ تمسنٛدِس خاندار اکولہؔ ہس ؤنؠ زیٚو میانؠ سلام۔ تِمو کٔر مےٚ سٟتؠ یسوع مسیح ہس متعلق لوٗکن وننس دوران واریاہ کٲم۔
\v 4 تِمو ترُوو میٚون زُو بچاونہٕ باپتھ پنُن پان رومیٚو دٔسؠ قتٕل سپدن کِس خطرس منٛز۔ بہٕ تہٕ ایمان واجنہِ تمام قومی جمٲژ چھےٚ تِمن شکُر گذار۔
\v 5 امہِ علاوٕ ؤنؠ زیٚو تتھ پژھ، واجنہِ جمٲژ تہِ سلام یۅسہٕ پرسِکلا تہٕ اکولؔہ سنٛدِس گھرس منٛز سمکھِ۔ میانِس ٹٲٹھِس اپینتسسؔ ؤنؠ زیٚو سلام، سُہ چُھ آسیہ صوبُک لۅکُٹ تہٕ گۅڈنیُک شخص یمؠ یسُوعؔ مسیح ہس پیٚٹھ ایمان اوٚن۔
\p
\v 6 مریمسؔ ؤنؠ زیٚو سلام۔ تمہِ کٔر تُہنٛدِ باپتھ واریاہ محنت۔
\v 7 اندرُنِکسؔ تہٕ یونِیاسس ؤنؠ زیٚو سلام۔ تِم چھِ میانؠ یہُودؠ سٲتھی، تہٕ أسؠ ٲسؠ یکہٕ وٹہٕ قٲدس منٛز۔ یمہٕ یسوعنؔ پنٕنؠ نمایندگی کرنہٕ باپتھ سوزمٕتؠ ٲسؠ۔ سُہ چُھ تِمن اصٕل پٲٹھؠ زانان۔ خداین رلٲوؠ تِم مسیح ہس سٟتؠ امہِ برُونٛہہ زِ ییٚلہ تمؠ مےٚ سٟتؠ یہ کوٚر۔
\v 8 امپلیاطُسؔ کٔرؠ زیٚو سلام۔ بہٕ چُھس تس محبت کران خداوند یسُوع مسیح سُنٛد اکھ ٹوٹھ ایمان وول آسنہٕ موٚکھٕ۔
\p
\v 9 اُربانس ونؠ زیٚو سلام۔ سُہ چُھ یسُوع مسیح ہس متعلق لوٗکن وننس دوران اسہِ سٟتؠ کٲم کران۔ استخسس تہِ کرؠ زیٚو سلام، یس بہٕ سیٚٹھاہ لول بران چُھس۔
\v 10 اپلیسؔ کرؠ زیٚو سلام یُس یسُوع مسیح ہن قبول کوٚرمُت چُھ۔ تِمن ایمان والیٚن کٔرؠ زیٚو سلام یمہٕ ارستُبولسؔ سنٛدِس گھرس منٛز روزان چھِ۔
\v 11 میانِس یہُودؠ سأتھی ہیرودیٚونسؔ ونؠ زیٚو سلام۔ تِمن لوٗکن ونؠ زیٚو سلام یمہٕ خداین خداوند یسوعسؔ سٟتؠ رلٲوؠ یمہ نرکِسسؔ سنٛدٮ۪ن گھرٕ بٲژن سٟتؠ روزان چھِ۔
\p
\v 12 تروفینہؔ تہٕ تروفوسسؔ کرؠ زیٚو سلام۔ یمہ زنہِ خداوند یسوعس متعلق لوٗکن وننہٕ خٲطرٕ لول بران چھےٚ۔ پرسِسسؔ ونؠ زیٚو سلام، یمِس بہٕ محبت کران چُھس۔ تمؠ کٔر خداوند یسوعسؔ متعلق لوٗکن وننس دوران کٲفی محنت۔
\v 13 روفسس ونؠ زیٚو سلام۔ سُہ چُھ خداوند یسُوعؔ ہن ژورٕمُت، تمسنٛزِ ماجہِ تہِ ونؠ زیٚو سلام۔ سۅتہِ ٲس زنتہٕ مےٚ پنٕنؠ موج۔
\v 14 اسنکرِتس، فِلگونس، ہرماسسؔ، پترُباسس، ہرمیسسؔ، تہٕ تِمن باین یِم تِمن سٟتؠ چھِ ونؠ زیٚو سلام۔
\p
\v 15 فِللُگس، یولیہؔ ہس، نیریُوسس تمسنٛزِ بیٚنہِ تہٕ اُلمپاسسؔ ونؠ زیٚو سلام، بییہِ ونؠ زیٚو تِمن سارنی لوٗکن سلام یمہ تِمن سٟتؠ وتھان بہان چھِ۔
\v 16 اکھ أکِس کٔرِو محبتہٕ سان سلام۔ پژھ، واجنہِ تمام جمٲژ یمہ مسیح ہس سٟتؠ تعلق تھاوان چھِ، چھِ توٚہہ اتھ علاقس منٛز سلام کران!
\p
\v 17 میانیٚو سٲتھی پژھ، والیٚو! بہٕ چُھسو توٚہہ تلقین کران زِ تِمو لوٗکو نشہِ روزؠ زیٚو حیٚسہٕ یمہٕ پانہٕ وٲنؠ ژُوان چھِ تہٕ اکھ اکِس گُنہن کُن نِوان چھِ، یہ اسہِ توٚہؠ ہیٚچھنٲیو تتھ خلاف چھِ۔ تِمو نشہٕ روزؠ زیٚو دوٗر!
\v 18 حقیقتن چھنہٕ یتھؠ لوٗکھ سٲنِس خداوند یسُوع مسیح سنٛز خدمت کران، بلکہ چھِ تِم پنٕنؠ بۅچھٕ ہمراوان۔ تمہ، مُدرِ زبٲنؠ تہٕ چاپلوٗسی سان کتھ کران چھِ تِمن لوٗکن دونٛکھٕ دِوان یِمن نہٕ فِکرے تران چُھ زِ اپُز کیاہ چُھ۔
\p
\v 19 بہٕ چُھس توٚہہ یمہ کتھٕ ونان، تکیازِ واریہو لوٗکو چُھ بوزمُت زِ توٚہؠ کِتھٕ کنؠ چُھ خدایہ سنٛز عبادت کران۔ نتیجہ چُھ یہ زٕ بہٕ چُھس تُہنٛدِ سٟتؠ واریاہ خۅش! مگر بہٕ چُھس یتہِ زانان زِ توٚہؠ چُھ اصلیٚن کتھن متعلق دٲنشمنٛدی کٲم ہیٚوان تہٕ بُرٕ کامیٚو نشہِ روزؠ زیٚو بے قصور۔
\v 20 یُس خدا اسہِ سکون بخشان چُھ سُہ کرِ جلدےٕ اسہِ شیطانس پیٚٹھ غٲلب، گویا توٚہؠ ٲسؠ وون سُہ پننٮ۪ن کھۅرن تل متھان۔ بہٕ چُھسو دُعا کران زِ خداوند یسُوع مسیح روزِنؠ توٚہہ پیٚٹھ مہربان!\f + \fr 16‏:20 \ft پیدائش 3:15\f*
\p
\v 21 تیمُتھیس یُس مےٚ سٟتؠ کٲم کران چُھ، لوٗکن یسُوعؔ ہس متعلق ونان چُھ، چُھو توٚہہ سلام سوزان۔ میٚون سٲتھی یہُودؠ لوکیُسؔ، یاسونؔ تہٕ سوسِپطرس چُھو توٚہہ سلام سوزان۔
\v 22 بہٕ چُھس ترتیُسؔ یہ نامہٕ لیٚکھن وول، یہ زن پولُسنؔ مےٚ ووٚن۔ چُھسو توٚہہ سلام ونان بحثیتِ اکھ ٹوٹھ ایمان وول خداوند یسُوعؔ سُنٛد۔
\p
\v 23 گیسؔ چُھو توٚہہ سلان ونان۔ سُہ چُھ میانؠ تہٕ سارنےٕ پژھ، والیٚن ہنٛز میزبٲنی کران یمہ یتہِ سمکھان چھِ۔ اراستُسؔ چُھ یمہ شہرُک خزانچی سُہ تہٕ سون سٲتھی ایمان وول کوارتُسؔ چُھو توٚہہ سلام سوزان۔
\v 24 بہٕ چُھس دُعا کران زِ سون خداوند یسُوع مسیح روزِن توٚہہ پیٚٹھ مہربان۔ یی سپدِن!
\p
\v 25 بہٕ چُھس دُعا کران زِ پرٛتھ کانٛہہ پٔرِن خدایہ سنٛز تسبیح۔ سُے چُھ یُس توٚہہ اتھ خۅشخبری ہنٛدِس بنیادس پیٚٹھ طاقت عطا کرِتھ ہیٚکہ یُس بہٕ یسُوع مسیح ہس متعلق ونان چُھس۔ یُس بہٕ اعلان کران چُھس سُہ تمہِ پُر اسرار منصوبُک حصہٕ یُس خداین ظٲہر کوٚرمُت چُھ مگر امہِ برُونٛہہ اوس واریہس وقتس لوٗکو نشہِ ژوٗرِ تھاونہٕ آمُت۔
\v 26 تاہم کوٚر خداین ووٚنؠ سُہ پُر اسرار منصوبہٕ ظٲہر تِمو کوٚر پننٮ۪ن نبین ہنٛدِ ذریعہ یِمن کتھن ہُنٛد اظہار یِمو اتھ متعلق پننٮ۪ن صحیفن منٛز لیٚوکھمُت چُھ۔ تِمو کوٚر یہ تمہِ مطٲبق یہ زن تاابد پوشہٕ ونؠ خدایہ سُنٛد حکم اوس تاکہ تمام قوم کرن یسُوعؔ مسیح ہس پیٚٹھ بھروسہٕ کرِتھ خدایہ سنٛز فرمانبردٲری۔
\p
\v 27 صرف چُھ خدا عظمت وول۔ بہٕ چُھس دُعا کران زِ پرٛتھ کانٛہہ پٔرِن یسُوع مسیح سنٛدِ ذریعہ ہمیشہٕ باپتھ تمسنٛز تسبح! یی سپدِن!
