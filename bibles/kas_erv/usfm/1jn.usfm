\id 1JN - DMT Kashmiri
\toc1 1 یوحناؔ
\mt1 1 یوحناؔ
\c 1
\p
\v 1 بہٕ، یوحنا چُھس لیٚکھان توٚہہِ یسوعسؔ متعلق خدایہِ سُنٛد کلام۔\f + \fr 1‏:1 \ft مسیحؔ\f* سُہ اکھ یُس زندگی چُھ بخشان۔ سُے اوس موجود امہِ برونٛہہ زِ بیٚیہِ کینٛہہ آسہ ہے۔ اسہِ رسولو بوز تمسُنٛد ییٚلہِ سُہ لوٗکن تعلیم دِوان اوس۔ اسہِ وُچھ سُہ دیدمان۔ اسہِ وُچھ سُہ تہٕ اتھہٕ تہِ لوگُس۔ اوے تہِ ہیٚکو أسؠ گوٲہی دِتھ زِ سُہ اوس پٔزی انسٲنی وجود۔
\v 2 اوٕ کِنؠ زِ سُہ ووٚتھ یتھ زگتِس پٮ۪ٹھ تہٕ اسہِ وُچھ دیدمان أسؠ چھِ توٚہہِ واضیح پٲٹھؠ تس سنٛز خبر دِوان۔ یُس ہمیشہٕ موجود اوس۔ یُس پننِس ببس نِش آسمانن منٛز اوس، تہٕ آو اسہِ نِش یور۔
\v 3 أسؠ چھِ یژھان توٚہؠ تہِ بٔنیو سانہِ زندگی منٛز شریک۔ اوے چھِ أسؠ توٚہہِ خبر دِوان یہِ اسہِ یسوعؔ وُچھ کران تہٕ یہِ اسہِ یسوعؔ ونان بوز۔ یوٚدوے توٚہؠ تس پٮ۪ٹھ یقین دٔررٲیو، توٚہؠ تہِ گُزٲرِو سٲنؠ پٲٹھؠ پنٕنؠ زندگی سٲنس ببس خدایس سٟتؠ تہٕ تسٕنٛدِس گۅبرس یسوعسؔ مسیحؔ ہس سٟتؠ۔
\v 4 بہٕ چُھس توٚہہِ لیٚکھان یِمن چیزن متٮعلق اوٕ کِنؠ زِ توٚہؠ زٲنِو یِم چیز پٔزؠ، تہٕ توٕ کِنؠ روزو أسؠ سٲری یِکوٹہٕ خوش۔
\v 5 یۅسہ شیٚچھ اسہِ یسوعس نِشہ بوز تہٕ توٚہہِ چُھو تٔمِچ یہِ خبر دِوان: خدا چُھ ہمیشہٕ تی کران یہِ صحیح چُھ، تہٕ سُہ چُھنہٕ زانہٛہ تہِ کُنہِ وِزِ تہِ غلط کران۔ سُہ چُھ زنتہٕ پوٚز گاش یتھ منٛز انہِ گٹہِ ہنٛز شینکھ تہِ چھنہٕ۔
\v 6 یوٚدوے أسؠ یہِ ونو زِ أسؠ چھِ خدایس سٟتؠ زندگی بٲگران، مگر چھِ بدی ہنٛز زندگی گُزاران، تیٚلہِ چھِ أسؠ اپُز ونان۔ أسؠ چھِنہٕ زُوان پزرٕ سان۔ زٲنؠ تو أسؠ چھِ تیٚلہِ انہِ گٹہِ زُوان۔
\v 7 وۅنؠ گو یوٚدوے أسؠ شوژرٕ سان زندگی گزارو، یتھٕ پٲٹھؠ خدا پرٮ۪تھ کُنہِ طریقہٕ شوژ چُھ، تیٚلہِ ہیٚکو أسؠ پانہٕ وٲنؠ زندگی شراکتس منٛز گُزٲرِتھ۔ یہِ گییہِ زندگی خدایہِ سٕنٛدِس نوٗرس منٛز گزارٕنؠ۔ تیٚلہِ کرِ خدا سٲنؠ سٲری گناہ معاف تہٕ کرِ اسہِ قبول تکیازِ تسُنٛد گۅبُر یسوعؔ کھوٚت صلیبس سانہِ باپتھ۔\f + \fr 1‏:7 \ft یسعیاہؔ\f*
\v 8 یوٚدوے أسؠ ونو زِ أسؠ چھِنہٕ گناہ کرٲنی، تیٚلہِ چھِ أسؠ پانس احمق بناوان۔ أسؠ چھِ پزرس یقین کرنس نکار کران، یُس خدا اسہِ متعلق ونان چُھ۔
\v 9 مگر خدا چُھ ہمیشہٕ تی کران یہِ سُہ کرنُک ونہِ۔ تہٕ یہِ سُہ کرِ تہِ چُھ ہمیشہٕ صحیح۔ اوے ییٚلہِ أسؠ تس برونٛہہ کنہِ مانو زِ اسہِ کٔرؠ گناہ تہٕ گنہس کرو رد، سُہ کرِ اسہِ معاف سانیٚو گنہو باپتھ تہٕ سُہ دِیہ اسہِ نجاتھ تمہِ سارے 'احساسہ نِش' یُس اسہِ غلط کوٚر۔\f + \fr 1‏:9 \ft مزامیر 32:5، امثال 28:13\f*
\v 10 اوٕ کِنؠ زِ خدا چُھ ونان زِ گناہ چھِ سٲری کران، یوٚدوے أسؠ یہِ ونو زِ اسہِ کٔرؠ نہٕ گناہ، أسؠ چھِ ونان زِ خدا چُھ اپُز ونان۔ أسؠ چھِ خدایہِ سٕنٛدِس اسہِ متعلق وننس انکار کران۔
\c 2
\p
\v 1 توٚہؠ چُھو مےٚ تیٖتؠ ٹٲٹھؠ زنتہٕ توٚہؠ میٲنؠ پنٕنؠ شُرؠ چُھو۔ اوے چُھسو بہٕ توٚہہِ یہِ لیٚکھان تاکہِ توٚہؠ روزیٚو مُچھِ گُنہو نِشہ۔ وۅنؠ یوٚدوے توٚہہِ منٛزٕ کانٛہہ تہِ گناہ کرِ، ژٮ۪تس تھٲیو یسوعؔ مسیحؔ، راست باز کرِ ببس التجا تہٕ ونٮ۪س معاف کرنہٕ باپتھ۔
\v 2 یسوعؔ چُھ سُہ یمؠ سانہ باپتھ زُو چھپہِ دیُت تاکہِ خدا کرِ سٲنؠ گناہ معاف۔ یہ چھنہٕ چھرا سانیٚو گنہو باپتھے یوت پوٚز بلکہِ سارنے انسانن ہنٛدِ باپتھ یِمو کُنہِ جایہِ تہِ کانٛہہ گناہ کوٚر۔
\v 3 ییٚلہِ أسؠ تتھ پٮ۪ٹھ عمل کرو یہِ اسہِ خدا حکم چُھ دِوان، أسؠ ہیٚکو یقینہٕ سان روزِتھ زِ أسؠ چھِ پزی خدایس سٮ۪ٹھا نکھہٕ رشتس منٛز۔
\v 4 یوٚدوے کانٛہہ ونہِ، "بہٕ چُھس روزان خدایہِ سنٛدِس سٮ۪ٹھا نکھہٕ رشتس منٛز، مگر سُہ نفر آسہ نہٕ مانان خدایہِ سنٛدؠ حکم، تیٚلہِ چُھ سُہ اپزؠ یور۔ سُہ چُھنہٕ پنٕنؠ زندگی خدایہِ سنٛدِ پزِ پٲغامہٕ مطٲبق گُذاران۔
\v 5 وۅنؠ گو یوٚدوے کانٛہہ خدایہِ سنٛدؠ حکم مانان آسہ۔ یُتھ انسان چُھ خدایس ہر رنگہٕ لول بران۔ بس امی طریقہٕ ہیٚکو أسؠ پژھ تھٲوِتھ زِ أسؠ چھِ خدایس نکھہٕ رشتس منٛز زُوان۔
\v 6 یوٚدوے کانٛہہ ونہِ زِ سُہ چُھ خدایس نکھہٕ رشتس منٛز، تیٚلہِ پزِ تس یسوعؔ سٕنٛدؠ پٲٹھؠ زندگی گُذارٕنؠ ییٚلہِ سُہ یتھ زمینہِ پٮ۪ٹھ اوس۔
\v 7 میانیو ٹاٹھیٚو یارو، بہٕ چُھسو نہٕ توٚہہِ لیٚکھان کینٛہہ نوو کرنہٕ باپتھ، بلکہِ چُھسو لیٚکھان کینژھا کرنہٕ باپتھ یہِ توٚہؠ برونٛٹھےٕ زٲنِو زِ توٚہہِ چُھ کرُن تکیازِ توٚہؠ کٔرِو گۅڈٕ پژھ یسوعسؔ پٮ۪ٹھ۔ یہِ چُھ اکھ باگ تٔمہِ پٲغامُک یُس یسوعنؔ اسہِ دیُت تہٕ یُس اسہِ توٚہؠ برونٛٹھےٕ بوزنٲوؠ مٕتؠ چُھو۔
\v 8 وۅنؠ گو یوٚدوے أسؠ اتھ پٮ۪ٹھ بدل آیہِ تہِ سونٛچو، بہٕ چُھس تیٚلہِ توٚہہِ کینٛہہ نوو کرُن ونان۔ یہِ چُھ نوو توٕ کِنؠ زِ یمہِ آیہِ مسیحؔ زُووان رود اوس نوو۔ تہٕ توٚہؠ یتھٕ پٲٹھؠ اتھ پتہٕ پتہٕ زُوان چُھو چُھ نوو۔ یہِ چُھ اوٕ کِنؠ زِ توٚہہِ تروُو کۅکار کرُن تہٕ توٚہؠ چُھو ژوٚر ژوٚر رُت کران۔ بوز تو زنتہٕ توٚہؠ انہِ گٹہِ منٛز دروو تہٕ ہیٚتُو خدایہِ سٕنٛدِس نٔنِس گاشس منٛز زُوُن۔
\v 9 کانٛہہ ہیٚکہِ یِتہِ ؤنِتھ زِ سُہ چُھ رٕتؠ پٲٹھؠ زُوان۔ یتھٕ پٲٹھؠ خدا تس زُوُن یژھان چُھ۔ یہِ آسہ زنتہٕ خدا سٕنٛدِس گاشس منٛزے زُوون۔ وۅنؠ گو یوٚدوے کانٛہہ پننِس ایماندار سٲتھیس سٟتؠ دےٕ تھاوِ، تیٚلہِ چُھ سُہ وُنہِ کۅ کارن منٛزے زُوان، تہِ کران یِنہٕ خدا یژھان چُھ۔ أکِس انہِ گٹہِ منٛز زُوَن وٲلؠ سٕنٛدؠ پٲٹھؠ۔
\v 10 وۅنؠ گو یوٚدوے کانٛہہ اکھ پننٮ۪ن ایماندار سٲتھین لول بران آسہ، تیٚلہِ چُھ سُہ پزی رٕژ زندگی گُذاران۔ تس أکؠ سٕنٛدؠ پٲٹھؠ یُس خدایہِ سٕنٛدِ گاشس منٛز زُوان آسہ۔ تس آسہ نہٕ کانٛہہ وجہہ کۅ کار کرنُک۔ یُس وجہہ تس پننِس سٲتھی ایماندارس دےٕ کرنہٕ وِزِ آسہ ہے۔ یُتھ انسان چُھ زٲنؠ تو دوٚہلؠ گاشس منٛز یٔمِس کانٛہہ چیز لتہٕ مۅنٛجہ گژھِنہٕ یا نظرِ ڈلہِ نہٕ۔
\v 11 مگر یوٚدوے کانٛہہ پننِس سٲتھی ایماندارس سٟتؠ دےٕ تھاوِ سُہ چُھ مکمل وتہِ ڈٔلِتھ۔ سُہ چُھنہٕ زٲنتھےٕ ہیٚکان زِ زُوون کِتھہٕ پٲٹھؠ چُھ۔ تکیازِ یِم کۅکار سُہ کران چُھ تِم چھِ تس خدایہِ سنٛز وتھ زاننس منٛز ٹھوٚر بنان۔ زٲنتو سُہ چُھ زنتہٕ انہِ گٹہِ پکان، تہٕ وُچِھتھ چُھنہٕ ہیٚکان سُہ کوٚت چُھ پکان۔
\v 12 بہٕ چُھسو توٚہہِ لیٚکھان یِمن بہٕ لول چُھس بران زنتہٕ توٚہؠ میٲنؠ پنٕنؠ شُرؠ چُھو، اوٕ کِنؠ زِ خداین بخشؠ تہنٛدؠ گناہ توٕ کِنؠ زِ یہِ یسوعنؔ تہنٛدِ باپتھ کوٚر۔\f + \fr 2‏:12 \ft مزامیر 25:11\f*
\v 13 بہٕ چُھسو توٚہہِ لیٚکھان یِم باقیو نٮ۪سبتہٕ واریاہ کالہٕ پٮ۪ٹھٕ وۅنؠ ایماندار چھِ۔ بہٕ چُھسو توٚہہِ لیٚکھان اوٕ کِنؠ زِ توٚہہِ چُھ یسوعسؔ سٟتؠ نزدیکی رشتہٕ، یُس ہمیشہٕ زندِ چُھ۔ بہٕ چُھسو توٚہہِ نوٮ۪ن مگر محکم ایماندارن لیٚکھان تکیازِ شیطانن یُس اکھ بد وجود چُھ کٔرؠ ژھل بل توٚہؠ کۅ کارن کُن لاگنس، مگر توٚہہِ کوٚروٕ کامیٲبی سان تمسُنٛد مقابلہٕ۔\f + \fr 2‏:13 \ft مسیحؔ\f*\f + \fr 2‏:13 \ft شیطان\f*
\v 14 مےٚ لیٚوکھ توٚہہِ یِمن بہٕ لول چُھس بران زنتہٕ توٚہؠ میٲنؠ پنٕنؠ لۅکٕٹؠ مۅکٕٹؠ شُرؠ چُھو تکیازِ توٚہہِ چُھ نکھہٕ رشتہٕ خدایس یعنی ببس سٟتؠ۔ مےٚ لیٚوکھ توٚہہِ یِم باقیو نٮ۪سبتہٕ واریاہ پرٲنؠ ایماندار چھِ تکیازِ توٚہہِ چُھ نکھہٕ رشتہٕ یسوعسؔ سٟتؠ۔ سُہ اکھ فرد یُس ہمیشہٕ زنٛدٕ چُھ۔ مےٚ لیٚوکھ توٚہہِ نوٮ۪ن مگر محکم ایماندارن تکیازِ توٚہؠ چُھو روحٲنی طور مضبوط۔ مےٚ لیٚوکھ توٚہہِ اوٕ کِنؠ تہِ تکیازِ توٚہؠ رودِو خدایہِ سنٛدٮ۪ن حکمن ہنٛز تعمیل کران، تہٕ اوٕ کِنؠ زِ توٚہہِ اوٚنُو کامیٲبی سان ٹھوٹھ شیطانس بد زُووس۔ ییٚلہِ تٔمؠ ژھل بل کریاے توٚہؠ کۅ کارس لاگنس۔
\v 15 مہٕ کٔرِو خٲہِش تِمن لوٗکن ہیٚو بننٕچ یِمنہٕ خدایس عزت چھِ کران۔ تِمن چیزن ہنٛز خٲہِش مہٕ کٔرِو یِم تِم پراوٕنؠ چھِ یژھان۔ یوٚدوے کانٛہہ یژھِ تِمن لوٗکن ہیٚو بنُن، سُہ چُھ ہٲوِتھ دِوان زِ سُہ چُھنہٕ لول بران خدایس یعنی ببس۔
\v 16 بہٕ چُھسو ونان یُتھ انسان چُھنہٕ لول بران خدایس یعنی ببس اوٕ کِنؠ زِ تِم بے خدا لوٗکھ یتھٕ پٲٹھؠ زُوان چھِ چھنہٕ سۅ وتھ یمچ تعلیم اسہِ سون خدا یعنی بب دِوان چُھ۔ تِم چھِ یژھان پننہِ جسمٲنی خٲہشہِ پوٗرٕ کرنہِ۔ تِم چھِ یژھان پننہِ باپتھ تِم چیز حٲصِل کرٕنؠ یِم تِم أچھو وُچھان چھِ۔ تِم چھِ تھیٚکان تِمن چیزن پٮ۪ٹھ یِم تِمن حٲصِل چھِ تِم چھِ پننہِ مٲلی حثیژ پٮ۪ٹھ ژرنگان آسان۔ یِم سٲری چیز چھِ خۅد غرض تہٕ بے دین طریقو سونٛچنہ سٟتؠ یِوان۔\f + \fr 2‏:16 \ft رومین 13:14، امثال 27:20\f*
\v 17 یِم لوٗکھ خدایس عزت چھِنہٕ کران، گژھن نابود پننیٚو تمام خٲہشو ہنٛدیٚو چیزو سان۔ مگر یِم لوٗکھ خدایہِ سنٛدِس یژھنس کرنس پٮ۪ٹھ روزن، تِم لوٗکھ روزن ہمیشہٕ زنٛدٕ۔
\v 18 توٚہؠ یِم مےٚ تیٖتؠ ٹٲٹھؠ چُھو زنتہٕ توٚہؠ میٲنؠ پنٕنؠ شُرؠ ٲسِو۔ بہٕ چُھسو توٚہہِ ونُن یژھان زِ یوٚہے چُھ سُہ وق ییٚلہِ یسوع زمینہِ پٮ۪ٹھ وسہِ۔ توٚہہِ چُھو برونٛٹھےٕ بوزمُت زِ اکھ شخص ییہِ یُس مسیحؔ ہس سختی سان بُتھِ لگہ۔ پزر گو، واریہن لوٗکن چُھ یہِ پسنٛد، یِم پزس مسیحؔ ہس خلاف برونٛٹھےٕ زمینہِ پٮ۪ٹھ موجود چھِ، اوے کِنؠ زون اسہِ زِ یوٚہے چُھ وق تسنٛدِ یِنُک۔
\v 19 یِمو لوٗکو کوٚر انکار سانہِ مجلسہِ منٛز روزنس، وۅنؠ گو تِم ٲسؠ تٮ۪نہٕ زانہٛہ پزنہٕ پٲٹھؠ اسہِ سٟتؠ۔ یوٚدوے تِم اسہِ سٟتؠ آسہ ہن تیٚلہِ ما تراوٕہن اسہِ۔ مگر ییٚلہِ تِمو أسؠ ترٲوؠ اسہِ توٚگ زانُن زِ یِمو منٛزٕ اوسُے نہٕ کانٛہہ اسہِ سٟتؠ زانہٛہ جورِتھ۔
\v 20 وۅنؠ گو تُہنٛدِ باپتھ چُھ مسیحؔ ہن پنُن پاک روح دیُتمُت۔ اوٕ کِنؠ زٲنِو توٚہؠ زِ پوٚز کیا چُھ۔
\v 21 بہٕ چُھس نہٕ توٚہہِ یہِ نامہٕ لیٚکھان اوٕ کِنؠ زِ توٚہؠ کیا زٲنِو پزٕ کتھہٕ یِمہٕ خداین اسہِ باوِ بلکہِ اوٕ کِنؠ زِ توٚہؠ زٲنِو یِمن کتھن۔ توٚہؠ زٲنِو وارٕ پٲٹھؠ ماننہٕ تہٕ رد کرنہٕ باپتھ سُہ پرٮ۪تھ کانٛہہ اپُز یُس نہٕ تِمو پزیٚو چیزو منٛزٕ چُھ یِم خداین اسہِ ؤنؠ۔
\v 22 سارِوےٕ کھۅتہٕ بٔڈؠ اپٕزؠ یٲرؠ چھِ تِم یِم انکار کران چھِ زِ یسوعؔ چُھ مسیحؔ۔ یہِ ونن وٲلؠ چھِ سٲری مسیحؔ ہس خلاف۔ یِم چھِ انکار کران یقین کرنس خدایس یعنی ببس تہٕ یسوعسؔ تسنٛدِس گۅبرس۔
\v 23 یسوعسؔ خدایہِ سُنٛد گۅبُر ماننس انکار کرن وٲلؠ لوٗکھ چھِنہٕ کنہ لِکھٕ تہِ جورتھ خدایس یعنی ببس سٟتؠ۔ مگر یسوعسؔ خدایہِ سُنٛد گۅبُر مانن وٲلؠ چھِ جورتھ خدایس یعنی ببس سٟتؠ۔
\v 24 وۅنؠ پزِ توٚہہِ تِمن لوٗکن برعکس کرُن یِم لوٗکھ یسوعسؔ انکار کران چھِ، توٚہہِ پزِ برابر یقین تھاوُن پزرٕ سان تہٕ زُوان روزُن یسوعؔ مسیحؔ ہس متعلق سُہ یقین تھٲوِتھ یُس توٚہہِ گۅڈٕ بوزُو۔ یوٚدوے توٚہؠ برابر یقین تھٲیو تہٕ زُوان روزیٚو یسوعؔ مسیحؔ ہس متعلق پزرس پٮ۪ٹھ یُس توٚہہِ گۅڈٕ بوزُو، تیٚلہِ روزیٚو توٚہؠ برابر شریک خدا تہٕ خدایہِ یعنی بب سٕنٛدِس گۅبُر یسوع سنٛزِ زندگی منٛز۔
\v 25 تہٕ یہِ خداین اسہِ وعدٕ دیُتمُت چُھ زِ سُہ بناوِ اسہِ پوشوٕنؠ زندگی پراونس لایق!
\v 26 بہٕ چُھسو یہِ نامہٕ توٚہہِ لیٚکھان خبردار کرنہٕ باپتھ تِمن لوٗکن متعلق یِم توٚہہِ یسوعس متعلق دھوکھہٕ دِن۔
\v 27 توٚہہِ پزِ کرُن یہِ تِمن لوٗکن سٟتؠ یِم توٚہہِ تارنچ کوژھل کرن۔ خدایہِ سُنٛد روح یُس توٚہہِ یسوعس نِش پُروو چُھ برابر توٚہہِ منٛز زنٛدٕ۔ اوے چھنہٕ توٚہہِ کٲنٛسہِ ہنٛز تہِ ضرورت پنُن وۅستاد بناونچ۔ خدایہِ سُنٛد روح چُھ توٚہہِ ہدایت دِوان پرٮ۪تھ چیزس متعلق یُس توٚہہِ زاننچ ضرورت چھےٚ۔ سُہ چُھ ہمیشہٕ ہٮ۪چھناوان پزر تہٕ زانہٛہ تہِ چُھنہٕ ونان اپُز۔ اوے تہِ روزیٚو زُووان تس سنٛزِ تعلیمہ مطٲبق تہٕ روزیٚو یسوع سنٛزِ شراکژ منٛز زُووان۔\f + \fr 2‏:27 \ft یوحنا 14:16\f*
\v 28 میانیٚو ٹاٹھیٚو بہٕ چُھسو زور دِوان پنٕنؠ زندگی یسوع سنٛزِ زندگی سٟتؠ ہِشراونس پٮ۪ٹھ یتھٕ پٲٹھؠ ییٚلہِ سُہ دُبارٕ ییہِ اسہِ آسہ اعتماد زِ سُہ کرِ اسہِ قبول۔ یوٚدوے أسؠ تہِ کرو، أسؠ آسو نہٕ تس برونٛہہ کنہِ وۅدنؠ شرمنٛدٕ ییٚلہِ سُہ دُبارٕ ییہِ۔
\v 29 چونکہِ توٚہؠ چُھو زانان زِ خدا چُھ ہمیشہٕ تہِ کران یہِ رُت چُھ، توٚہؠ چُھو یِتہِ زانان زِ تِم سٲری یِم برابر رُت کران روزان چھِ۔ تِمے چھِ خدا سٕنٛدؠ روحٲنی شُرؠ۔
\c 3
\p
\v 1 ژٮ۪تھ ہِش دِیو خدا سون بب کوتاہ چُھ اسہِ لول بران! سُہ چُھ ونان زِ أسؠ چھِ تسٕنٛدؠ شُرؠ۔ روحٲنی لحاظٕ چُھ یہِ بالکل پوٚز۔ اوے چھِنہٕ بے ایمان لوٗکھ اسہِ سمجھتھےٕ ہیٚکان تکیازِ تِمو چُھنہٕ زونمُتےٕ خدا کُس چُھ۔ تہٕ أسؠ چھِ تٔسؠ ہِیوؠ یتھٕ پٲٹھؠ شُرؠ مٲلِس ہیِوؠ آسان چھِ۔
\v 2 ٹاٹھیٚو یارو، وُنکٮ۪س چھِ أسؠ خدایہِ سٕنٛدؠ روحٲنی شُرؠ۔ تٔمؠ ہوونہٕ اسہِ وُنہِ زِ برونٛہہ کُن کِتھؠ آسو أسؠ۔ وۅنؠ گو، أسؠ چھِ زانان زِ ییٚلہِ یسوعؔ دُبارٕ واپس ییہِ أسؠ بنو تٔسؠ ہیٚوؠ۔ تکیازِ أسؠ وُچھوون سُہ یُتھ سُہ پزنہٕ پٲٹھؠ چُھ۔
\v 3 لہٰذا تِم سٲری یِم تسُنٛد پوٚز آسن وچُھن یژھان چھِ تِم سٲری یِم اعتماد سان امید کران چھِ تسُنٛد پوٚز آسُن وچھنُ کرن پنُن پان پاک گنہَو نِش تکیازِ یسوع چُھ پانہٕ پاک گنہَو نِشہ۔
\v 4 مگر سُہ پرٮ۪تھ کانٛہہ یُس لٔگؠ تھےٕ گناہ کران چُھ، چُھ خدایہِ سنٛدٮ۪ن قانونن نکار کران۔ تکیازِ گناہ گو مطلب کِنؠ یی زِ خدایہِ سنٛدٮ۪ن قانونن انکار کرُن۔
\v 5 توٚہؠ چُھو زانان زِ یسوعؔ آو اسہِ گنہَو نِشہ مُچھِ کرنہٕ باپتھ۔ توٚہؠ چُھو یِتہِ زانان زِ تٔمؠ کوٚر نہٕ زانہٛہ کٲلؠ تہِ پانہٕ گناہ۔\f + \fr 3‏:5 \ft یوحناؔ 1:29\f*
\v 6 یِم پنٕنؠ زندگی یسوع سٕنٛدِس شراکتس منٛز گُذاران چھِ تِم چھِنہٕ گنہن منٛز پانس گیٖر کران۔ وۅنؠ گو تِمو لوٗکو یِم گناہ کران روزان چھِ، چُھنہٕ ہرگز یسوع زونمُت۔ تِمن چھنہٕ رژھ تہِ امسنٛز آگٲہی۔
\v 7 اوے چُھسو بہٕ توٚہہِ یِم میٲنؠ ٹٲٹھؠ چُھو زور دِتھ ونان زِ کٲنٛسہِ ہنٛدِس دھونٛکھس منٛز مہٕ یِیو یِم توٚہہِ ونان چھِ زِ گناہ کرُن چُھ رُت۔ یوٚدوے توٚہؠ رُت کران روزیٚو، یہِ کرِ خدایس خۅش، یتھٕ پٲٹھؠ یسوعؔ ہمیشہٕ تی کران چُھ یہِ خدایس خۅش کرِ۔
\v 8 مگر یُس لٔگؠ تھےٕ گناہ کران روزِ۔ سُہ چُھ شیطان سٕنٛدؠ پٲٹھؠ عمل کران تکیازِ شیطان چُھ لٔگؠ تھےٕ گناہ کران، ینہٕ پٮ۪ٹھٕ دنیا بنیو۔ یوٚہے چُھ وجہ زِ خدایہِ سُنٛد گۅبُر آو انسان بٔنِتھ۔ سُہ گو تس اوس شیطان سُنٛد وۅہرومُت زال وٹُن یمؠ لوٗکھ گنہن منٛز گیٖر تھٲوؠ۔
\v 9 لوٗکھ چھِنہٕ ہرگز گنہن منٛز گیٖر روزان یوٚدوے تِم خدایہ سٕنٛدؠ روحٲنی شُرؠ بنن۔ تکیازِ خداین چھِ تِم پانس ہیٚوؠ بنٲوؠ مٕتؠ۔ تِم ہیٚکن نہٕ گنہن منٛز گیٖر روزتھےٕ، تکیازِ تِم چھِ خدایہِ سٕنٛدؠ روحٲنی شُرؠ۔\f + \fr 3‏:9 \ft خدایہِ سنٛز اصلی فطرت\f*
\v 10 یِم لوٗکھ جورِتھ چھِ خدایس سٟتؠ تِم چھِ بیوٚن تہٕ بدون شیطانس سٟتؠ جورتھ لوٗکو نِش۔ یِم لوٗکھ رُت کرن نہٕ چھِنہٕ ژکہِ خدایس سٟتؠ جورِتھ۔ یِم پننٮ۪ن سٲتھی ایماندارن لول برن نہٕ تِم تہِ چھِنہٕ خدایس سٟتؠ جورِتھ۔
\v 11 توٚہہِ پزِ یہِ زانُن تکیازِ یۅسہ شیٚچھ توٚہہِ بوزو ییٚلہِ توٚہہِ گۅڈنٮ۪تھ یسوعس پٮ۪ٹھ ایمان اوٚنُو سۅ ٲس یہِ زِ اسہِ پزِ اکھ أکِس لول برُن۔
\v 12 اسہِ پزِ نہٕ باقین سٟتؠ دےٕ تھاوٕنؠ یتھٕ پٲٹھؠ آدمؔ سٕنٛدؠ نیٚچوؠ قٲینؔ دےٕ تھٲو۔ سُہ اوس جورِتھ شیطانس سٟتؠ یُس بد زُو چُھ۔ قٲینن مور پنُن کونٛس بوے ہابیلؔ۔ ؤلِو بہٕ ونو تٔمؠ کیاز کوٚر یہِ۔ تکیازِ قٲینن کوٚر کۅکار تہٕ اوس دےٕ کران پننِس کانٛسِس بٲیِس تکیازِ سُہ کونٛس بوے اوس رُت ویوہار وول۔\f + \fr 3‏:12 \ft مزامیر 38:20\f*
\v 13 اوے تہِ میانیٚو سٲتھی ایماندارو، توٚہہِ پزِ نہٕ حٲران گژھُن ییٚلہِ توٚہہِ سٟتؠ بے ایمان دےٕ تھاون۔
\v 14 أسؠ چھِ پننٮ۪ن ایماندار سٲتھین لول بران تہٕ یہِ چُھ اسہِ یقین دِوان زِ خداین چھِ اسؠ روحٲنی طور زنٛدٕ تھٲوؠ مٕتؠ۔ وۅنؠ گو یوٚدوے کانٛہہ باقےٕ ایمان والیٚن لول برِ نہٕ، تیٚلہِ چُھ یُتھ انسان وُنہِ روحٲنی طور مۅردٕ۔
\v 15 کانٛہہ اکھ تہِ یُس دےٕ تھاوِ ایماندار سٲتھین سٟتؠ چُھ تس قتل کرنس برابر بُرٕ کار کران۔ تہٕ توٚہؠ چُھو زانان زِ یُس کٲنٛسہِ بیٚیِس قتل کرِ چُھنہٕ تٔمہِ نوِ انمانہٕ زُووان یتھ لایق أسؠ خداین بنٲوؠ۔
\v 16 یسوعنؔ ہوو اسہِ زِ اکھ أکِس سٟتؠ کِتھہٕ پٲٹھؠ چُھ پوٚز لول برُن ییٚلہِ سُہ رضامندی سان سانہِ باپتھ مود۔ اسہِ تہِ پزِ پننٮ۪ن ایماندار سٲتھین ہنٛدِ باپتھ کینٛہہ تہِ کرنہٕ باپتھ تیار روزُن، تہنٛدِ باپتھ زُو دِنہٕ باپتھ تہِ۔
\v 17 اسہِ منٛز چھِ واریہن دنیاہس منٛز زُو زٮ۪تہٕ باپتھ ضروری چیز میسر۔ مگر فرض کرو اسہِ چھےٚ خبر لگان زِ سٲنِس أکِس ایماندار سٲتھیس چھِنہٕ ضرورتٕکؠ چیز میسر۔ یتہِ کرو فرض أسؠ چھِ تمؠ سنٛز ضرورت پوٗرٕ کرنس انکار کران۔ تیٚلہِ چھِنہٕ أسؠ تٔمہِ آیہِ تس لول بران یمہِ آیہِ اسہِ خداین لوٗکن لول برنٕچ تعلیم دِژ۔\f + \fr 3‏:17 \ft تثنِیہ شرع 15:7۔8\f*
\v 18 توٚہؠ یِم مےٚ ٹٲٹھؠ چُھو زنتہٕ میٲنؠ پنٕنؠ شُرؠ چُھو پزِ نہٕ چھرا زبٲنؠ زبٲنی اکھ أکِس لول برُن۔ اسہِ پزِ اکھ أکِس پزنہٕ پٲٹھؠ لول برُن یعنی اکھ أکِس مدد کٔرِتھ۔
\p
\v 19‏-20 یہِ کٔرِتھ ہیٚکو أسؠ زٲنِتھ زِ أسؠ چھِ خدایس سٟتؠ، یُس آگُر چُھ پرٮ۪تھ چیزُک یہِ پوٚز چُھ۔ ییٚلہِ أسؠ خدایہِ سٕنٛدِس حضورس منٛز چھِ، اسہِ باسہِ پننیٚو گنہو کِنؠ زِ أسؠ چھِنہٕ خدایس سٟتؠ۔ ییٚلہِ یُتھ ہیٚو سپدِ، اسہِ پزِ پانس یقین دیُن زِ أسؠ چھِ پزی تس سٟتؠ۔ اوٕ کِنؠ زِ خدا چُھ سانیٚو احساسو کھۅتہٕ زیادٕ معتبر تہٕ سُہ چُھ اسہِ متعلق سورےٕ زانان یتھ منٛز سون تس پٮ۪ٹھ بھروسہٕ تہِ چُھ۔
\v 21 ٹاٹھیٚو یارو، ییٚلہِ اسہِ یہِ احساس گنہِ زِ خدا چُھنہٕ اسہِ پننٮ۪و گنہو سببہٕ سزا دِوان، تیٚلہِ پزِ اسہِ اعتماد سان خدایس دعا منگُن۔
\v 22 أسؠ چھِ زانان زِ ییٚلہِ أسؠ خدایہِ سنٛز عبادت اعتمادٕ سان کران چھِ تہٕ چُھس کینٛہہ منٛگان، سُہ چُھ اسہِ تہِ دِوان۔ أسؠ چھِ اعتمادٕ سان تس یتھٕ پٲٹھؠ عبادت کران تکیازِ تمؠ سنٛز عبادت کرن والیٚن لوٗکن ہنٛدؠ پٲٹھؠ چھِ أسؠ تی کران یہِ سُہ اسہِ حکم کران چُھ تہٕ أسؠ چھِ کران تہِ یہِ تس خوش کرِ۔
\v 23 بہٕ ونَو توٚہہِ خدا کیا چُھ اسہِ کرنُک حکم دِوان۔ اسہِ پزِ تٔمسنٛدِس گۅبرس یسوع مسیحؔ ہس پٮ۪ٹھ پژھ کرٕنؠ۔ اسہِ پزِ اکھ أکِس لول تہِ برُن یتھٕ پٲٹھؠ یسوع اسہِ حکم کران چُھ۔
\v 24 یِم لوٗکھ تی کرن یہِ خدا حکم دِیہ۔ تِم چھِ زُوان خدایہِ سٕنٛدِس شراکتس منٛز۔ تہٕ خدا چُھ پنٕنؠ زندگی یِمن سٟتؠ گُذاران۔ بہٕ ونَو توٚہہِ خدا کِتھہٕ پٲٹھؠ چُھ پنٕنؠ زندگی اسہِ سٟتؠ گذاران۔ اسہِ پزِ یقین تھاوُن تکیازِ اسہِ منٛز چُھ خدایہِ سُنٛد روح یُس تٔمؠ اسہِ دیُت۔
\c 4
\p
\v 1 ٹاٹھیٚو یارو۔ واریہن لوٗکن نِش چھےٚ اپٕز شیٚچھ تہٕ تِم چھِ أتھؠ لوٗکن منٛز پھیرِتھ ہٮ۪چھناوان۔ اوے مہٕ کٔرِو سارنےٕ وۅستادن پٮ۪ٹھ بھروسہٕ۔ بلکہِ دِیو ژٮ۪تھ وارٕ زِ پرٮ۪تھ کانٛہہ وۅستاد کیا چُھو توٚہہِ ونان تہٕ پانے کٔرِو فٲصلہٕ زِ یہِ شیٚچھ چھا خدایہِ سنٛدِ روح طرفہٕ کِنہٕ کُنہٕ بدلہٕ روح طرفہٕ۔
\v 2 ؤلِو بہٕ ونو توٚہہِ کِتھہٕ پٲٹھؠ پرکھٲیِو زِ کانٛہہ چھا توٚہہِ خدایہِ سنٛدِ روح طرفہٕ آمُت پزر ہٮ۪چھناوان کنہٕ نہ۔ یِم لوٗکھ تصدیق کرن یسوع مسیحؔ سٕنٛدِس خدایہِ سنٛدِ طرفہٕ پننِس تہٕ سٲنی پٲٹھؠ انسٲنؠ انہار پراونس چھِ خدایہِ سنٛدِ طرفہٕ یِنہٕ واجِنؠ شیٚچھ باوان۔
\v 3 مگر یِمنہٕ تصدیق کرن زِ یسوع بنیو پزنہٕ پٲٹھؠ انسان چھِنہٕ خدایہِ سنٛدِ طرفہٕ آمٕژ شچھ باوان۔ یِم وۅستاد چھِ مسیحؔ ہس خلاف۔ توٚہہِ چُھو بوزمُت زِ یِتھؠ لوٗکھ روزن توٚہہِ نِش یِوان۔ تِم چھِ وُنکٮ۪س تہِ توٚہہِ منٛز۔
\v 4 ییتِس کالس تُہنٛد سوال چُھ، توٚہؠ چُھو مےٚ تیتی ٹٲٹھؠ زنتہٕ توٚہؠ میٲنؠ پنٕنؠ شُرؠ چُھو۔ توٚہؠ چُھو خدایہِ سنٛدؠ تہِ توٚہہِ کوٚرو رد یہِ تِم لوٗکھ توٚہہِ ہٮ۪چھناوان چُھو۔ توٚہہِ کوٚرُو یہِ تکیازِ خدا یُس توٚہہِ پننہِ یژھایہِ پٮ۪ٹھ پکناوان چُھ، چُھ زیادٕ پُرقوت کٲنٛسہِ شٮیطان سٕنٛدِ کھۅتہٕ، یُس تِمن سارنےٕ ہٕس دِوان چُھ یِم خدایس عزت چھِ نہٕ کران۔
\v 5 تِم لوٗکھ یِم سۅ تعلیم دِوان چھِ یۅسہ اپُز چھےٚ، تِم چھِ سونچان تٔمہِ آیہِ زُوون یتھ منٛز خدایہِ سُنٛد احترام تہٕ عزت چُھنہٕ۔ اوے تہِ تِم یِتہِ ونان چھِ تتھ منٛز چُھنہٕ خدایہِ سُنٛد احترام آسان۔ تہٕ سُہ چُھ اوٕ کِنؠ زِ باقےٕ لوٗکھ یِم نہٕ خدایہِ سُنٛد احترام چھِ کران، چھِ تہنٛدِس وننس پژھ کران۔
\v 6 پتھ گۓ أسؠ، أسؠ چھِ سوزؠ مٕتؠ خداین۔ خدایہِ سنٛدِس رشتس منٛز زُوون وول ہر کانٛہہ نفر چُھ اسہِ یقین کران تہٕ سٲنؠ تعلیم مانان۔ یُس تہِ کانٛہہ خدایہِ سنٛدِس رشتس منٛز زُووِ نہٕ، تھاوِ نہٕ سانہِ تعلیمہ پٮ۪ٹھ یقین تہٕ نہ مانہِ۔ دوٚن منٛز یوٚہے بیٚنٮ۪ر چُھ خدایہِ سنٛدِ پاک روح سنٛدِ طرفہٕ واتن وٲلِس پٲغامس تہٕ شیطان سٕنٛدِ طرفہٕ یِنہٕ وٲلِس پٲغامس منٛز نا ہِشر درشاوان۔
\v 7 ٹاٹھیٚو یارو۔ اسہِ پزِ اکھ أکِس لول برُن۔ یی چُھ خدا سانہِ باپتھ یژھان، اوٕ کِنؠ زِ سُہ چُھ اسہِ لول بران۔ أسؠ چھِ ہیٚکان باقین لول بٔرِتھ۔ یِم لول برن پننٮ۪ن ایمٲندار سٲتھین تِم چھِ بنان خدا سٕنٛدؠ روحٲنی شُرؠ تہٕ چھِ تٔمسےٕ سٟتؠ رشتس منٛز زُووان۔
\v 8 خدا سُنٛد مِزاج چُھ لوٗکن لول برُن۔ اوے تہِ یُس نہٕ باقین لول برِ چُھنہٕ خدا سٕنٛدِس شراکتس منٛز زُوان۔
\v 9 بہٕ ونَو توٚہہِ زِ خدا کِتھہٕ پٲٹھؠ چُھ درشاوان پنُن لول سانہِ باپتھ۔ تٔمؠ سوز پنُن کُن گۅبُر یتھ زمینہِ پٮ۪ٹھ تاکہِ تسُنٛد گۅبُر بناوِ اسہِ پوشوٕنؠ زندگی پراونس لایق۔ توٕ کِنؠ زِ یہِ تٔمؠ سانہِ باپتھ کوٚر۔
\v 10 بہٕ ونَو توٚہہِ کٲنٛسہِ لول برُن کیا گوو۔ خدایس لول برنچہِ سانہِ کوششہِ چھنہٕ کٲنٛسہِ لول برنُک معنی مفہوم واضیح کران۔ نہ۔ خداین درشوو یہِ پانہٕ اسہِ تیوتاہ لول بٔرِتھ زِ تٔمؠ سوز پنُن گۅبُر سانہِ باپتھ قربٲنی دِنہٕ باپتھ۔ ییٚلہِ یسوعنؔ یہِ کوٚر، خداین ہیٚکؠ تِمن لوٗکن ہنٛدؠ گناہ معاف کٔرِتھ سزا دِنہٕ بجایہ، یِمو یسوعس پٮ۪ٹھ بھروسہٕ کوٚر۔
\v 11 ٹاٹھیٚو یارو۔ اوٕ کِنؠ زِ خدا چُھ اسہِ یتھٕ پٲٹھؠ لول بران۔ یقیناً پزِ اسہِ اکھ أکِس لول برُن۔
\v 12 کٲنٛسہِ تہِ چُھنہٕ زانہٛہ خدا وُچھمُت۔ وۅنؠ گو ییٚلہِ أسؠ اکھ أکِس لول برو، أسؠ ہیٚکو وُچِھتھ زِ خدا چُھ اسہِ منٛز زُووان تہٕ سُے چُھ اسہِ باقین لول برنس لایق بناوان۔ یتھٕ پٲٹھؠ زن سُہ سانہِ باپتھ یژھان چُھ۔
\v 13 یِتھے پٲٹھؠ ییہِ اسہِ یقین زِ أسؠ چھِ خدایس سٟتؠ پنٕنؠ زندگی شراکتس منٛز گُذاران تہٕ خدا چُھ اسہِ سٟتؠ زندگی گُذاران: تٔمؠ چُھ اسہِ پنُن روح بخُشمُت۔
\v 14 اسہِ رسولو چُھ خدایہِ سُنٛد گۅبُر یسوع وُچھمُت زمینہِ پٮ۪ٹھ تہٕ أسؠ چھِ سنٛجیدگی سان ونان باقین زِ ببن سوز سُہ دنیاہ کٮ۪ن لوٗکن پننیٚو گنہو باپتھ ہمیشہٕ سزا تُلنہٕ بجایہ نجات دِنہِ۔
\v 15 اوے چُھ خدا یسوعس متعلق پوٚز ونن والیٚن سٟتؠ لٔگؠ تھےٕ پنٕنؠ زندگی گُذاران۔ تِم چھِ ونان، "سُہ چُھ خدایہ سُنٛد گۅبُر" تہٕ اوے چھِ پنٕنؠ زندگی خدایس سٟتؠ زُوان۔
\v 16 اسہِ ژٮ۪تروو زِ خدا کِتھہٕ پٲٹھؠ چُھ اسہِ لول بران تہٕ اسہِ چُھ یقین زِ سُہ چُھ اسہِ لول بران۔ توٕ کِنؠ زِ خدا سُنٛد مِزاج چُھ لوٗکن لول بران۔ یِم باقین لول روزن بران تِم چھِ پنٕنؠ زندگی خدایس سٟتؠ زُوان، تہٕ خدا چُھ پنٕنؠ زندگی تمن سٟتؠ زُووان۔
\v 17 ییٚلہِ أسؠ زندگی خدایس سٟتؠ زُووان روزو۔ تیٚلہِ کوٚر خداین اسہِ لول برنُک مقصد حٲصل۔ امکِس نتیجس منٛز ییٚلہِ خدایہِ سُنٛد اسہِ عدالت لاگنک وقت واتہِ۔ أسؠ آسو پُر اعتماد زِ سُہ دِیہ نہٕ اسہِ سزا۔ توٕ کِنؠ زِ أسؠ چھِ زُووان باقین سٟتؠ تہٕ لول تہِ ورتاوان۔ یتھٕ پٲٹھؠ زن یسوع چُھ کران۔\f + \fr 4‏:17 \ft یوحناؔ 5۔22، 27، 1، یوحناؔ 2۔ 28۔ 29\f*
\v 18 أسؠ کھۅژو نہٕ خدایس یوٚدوے أسؠ تس پزی لول برو، تکیازِ یِم تس وژھِ وٲنجہِ لول برن، روزن نہٕ تسنٛدِس پھرٮ۪ٹس تل۔ أسؠ روزو پھرٹہٕ ۂتؠ تیلے ییٚلہِ أسؠ سونٛچو زِ سُہ دِیہ اسہِ سزا۔ اوے تہ یِم خدا سنٛدِس پھرٮ۪ٹس تل روزن چھِنہٕ زانان زِ سُہ کوتاہ چُھ اسہِ لول بران تہٕ تِم تہِ چھِنہٕ تس وژھِ وٲنجہِ لول بران۔
\v 19 أسؠ چھِ خدایس تہٕ باقین لول بران۔ تکیازِ خداین بوٚر اسہِ گۅڈٕ لول۔
\v 20 لوٗکھ چھِ ونان اپُز ییٚلہِ تِم ونن زِ تِم چھِ خدایس لول بران مگر سٟتؠ چھِ سٲتھی ایماندارن ہنٛز دےٕ تھاوان۔ وۅنؠ گوو أسؠ ہیٚکہ ووکھ پنٕنؠ سٲتھی ایماندار وُچِھتھ۔ مگر اسہِ چُھنہٕ خدا وُچھمُت۔ اوے تہِ یِمنہٕ پننٮ۪ن سٲتھی ایماندارن لول وینٛدن تِم ہیٚکن نہٕ یقیناً خدایس لول ویندِتھ، اوٕ کِنؠ زِ نہ وُچھنہٕ یِنہٕ وٲلِس مقابلہٕ چُھ سانہِ باپتھ وُچھنہٕ یِنہٕ وٲلِس لول برن سہَل۔
\v 21 یہِ تھٲیِو ژٮ۪تس زِ یی چُھ اسہِ خدایہِ سُنٛد حکم: یوٚدوے أسؠ تس لول وینٛدو، اسہِ پزِ پننٮ۪ن سٲتھی ایماندارن تہِ لول ویندُن۔\f + \fr 4‏:21 \ft مرقُس 12۔29۔31\f*
\c 5
\p
\v 1 تِم سٲری یِم یقین چھِ کران زِ یسوع چھِ مسیحؔ، تِم چھِ روحٲنی طور خدا سٕنٛدؠ شُرؠ۔ وۅنؠ، یُس تہِ کٲنٛسہِ لول برِ یُس مول چُھ تہٕ برِ بالکل پنٛنِس شُرِس تہِ لول۔ لہٰذا یوٚدوے أسؠ یسوعس پٮ۪ٹھ یقین چھِ تھاوان، تیٚلہِ چھِ أسؠ خدایس لول بران، تہٕ امہِ موجُب پزِ اسہِ پننؠن ایماندار سٲتھین تہِ لول برُن۔
\v 2 أسؠ ہیٚکو یقینی بنٲوِتھ زِ أسؠ چھِ پٔزؠ پأٹھؠ باقین لول بران یم یہٕ یقین چھِ کران زِ یسوع چُھ مسیحؔ ییٚلہِ أسؠ خدایس لول چھِ بران تہٕ چھِ تی کران یہٕ سُہ اسہِ کرنُک حکم چُھ دِوان۔
\v 3 بہٕ چُھسو ونان یہِ توٕ کِنؠ زِ خدایس لول برُن گوو تہِ کرُن یہِ اسہِ سُہ حکم کرِ۔ تہٕ تہِ کرُن چُھنہٕ کینٛہہ مشکل یہِ سُہ اسہِ حکم کرِ۔\f + \fr 5‏:3 \ft متی 11:30\f*
\v 4 یہِ چُھ وجہہ زِ تہِ کرُن کیازِ چُھنہٕ مشکل یہِ خدا اسہِ حکم کرِ۔ أسؠ سٲری یِم خدایہِ سٕنٛدؠ روحٲنی شُرؠ چھِ، بنیاے تتھ رد کرنس لایق یہِ اسہِ بے ایمان لوٗکھ کرُن ونان چھِ۔ أسؠ کیازِ چھِ زیادٕ بل ویر تٔمہِ پرٮ۪تھ چیزٕ کھۅتہٕ یُس خدایس خلاف چُھ۔ اتھ تہِ چُھ اکھ وجہہ۔ یہِ چُھ اوٕ کِنؠ زِ اسہِ چُھ یسوعس پٮ۪ٹھ یقین۔
\v 5 بہٕ ونو خدایس مخالِف پرٮ۪تھ کُنہ چیزٕ کھۅتہٕ کُس چُھ بل ویر۔ یہِ چُھ سُہ پرٮ۪تھ کانٛہہ یمس ایمان چُھ زِ یسوع چُھ خدایہِ سُنٛد گۅبُر۔
\v 6 یسوع مسیحؔ چُھ سُہ اکھ یُس زمینہِ پٮ۪ٹھٕ ووٚتھ خدایہِ سٕنٛدِ طرفہٕ تہٕ تروون بپتسمہ ہُک آب تہٕ رتھ صلیبس پٮ۪ٹھ مرنُک۔ خداین ورشوو زِ تٔمؠ سوز پٔزی یسوع نہ صرف ییٚلہِ یوحناہن یسوعس بپتسمہ دیُت آبہٕ سٟتؠ تہ بلکہِ ییٚلہِ یسوع سُنٛد رتھ تسنٛدِ بدنہٕ پٮ۪ٹھٕ ٹھینٛچہِ ووٚتھ ییٚلہِ سُہ مود تہٕ خدایہِ سُنٛد روح چُھ اعلان کران پزرٕ سان زِ یسوع مسیحؔ ہن کٔرؠ یِم چیز پزے۔
\v 7 اوے چھےٚ ترےٚ وتہٕ یمہِ کِنؠ أسؠ زانو زِ یسوع چُھ مسیحؔ یُس خدایہِ سنٛدِ طرفہٕ آو۔
\v 8 تِم ترےٚ وتہٕ چھےٚ: یہِ خدایہِ سُنٛد روح کیا ونہِ اسہِ کیا ہیٚو سپُد ییٚلہِ یوحناہن یسوعس بپتسمہ دیُت آبہٕ سٟتؠ۔ تہٕ کیا ہیٚو سپُد ییٚلہِ یسوع سُنٛد رتھ ٹھینٛچہِ ووٚتھ تسٕنٛدِ بدنہٕ پٮ۪ٹھٕ ییٚلہِ سُہ صلیبس پٮ۪ٹھ مود۔ یِم ترےٚ چیز چھِ اسہِ اکےٕ کتھ ونان زِ یسوع آو خدایہِ سنٛدِ طرفہ۔
\v 9 أسؠ چھِ بھروسہٕ کران لوٗکن ہنٛزِ کتھہِ پٮ۪ٹھ ییٚلہِ اسہِ کُنہِ چیزُک فٲصلہٕ آسہ کرُن۔ مگر أسؠ ہیٚکو ژوٚر بھروسہٕ کٔرِتھ یہِ خدا اسہِ ونہِ۔ اوے دِیو مےٚ وننہٕ یہِ خداین اسہِ ووٚن پننِس گۅبرس متعلق زِ تسُنٛد گۅبُر کُس چُھ۔
\v 10 گۅڈٕ دِیو مےٚ وننہٕ خدایہِ سٕنٛدِس گۅبرس پٮ۪ٹھ بھروسہٕ کرن وٲلؠ چھِ برونٛٹھےٕ زانان زِ خدا یہِ تس متعلق ونان چُھ، تہِ چُھ پوٚز۔ وۅنؠ گوو خدایس پٮ۪ٹھ یقین نہ تھاون وٲلؠ چھِ تمِس اپٕزؠ یور زانان، تکیازِ تِمو کوٚر نکار تتھ یقین کرنس یہِ خداین پننس گۅبرس متعلق درشوو۔
\v 11 وۅنؠ گۅ خداین ووٚن اسہِ یہِ پننِس گۅبرس متعلق، "مےٚ دِژٕو توٚہہِ پوشوٕنؠ زندگی تہٕ میون گۅبُر چُھ سُہ یمؠ یہِ زندگی ممکن بنٲو۔"
\v 12 تِم یِم خدایہِ سٕنٛدِس گۅبرس یسوعس سٟتؠ زندگی گُزاران چھِ، تِموےٕ ہیٚژ خدایس سٟتؠ پوشوٕنؠ زندگی گُذارٕنؠ۔ تِم یِم خدایہِ سنٛدِس گۅبرس سٟتؠ زندگی گُذاران چھِنہٕ، تِمو کٔر نہٕ پوشوٕنؠ زندگی شروع۔
\v 13 اوِ کِنؠ زِ بہٕ چُھس یژھان زِ توٚہؠ زٲنِو زِ توٚہؠ روزیٚو ہمیشہٕ زنٛدٕ، توے لیٚوکھم یہِ نامہٕ توٚہہِ۔ یہِ چُھ تُہنٛدِ باپتھ یِمن ایمان چُھ زِ یسوع چُھ خدایہِ سُنٛد گۅبُر۔
\v 14 بہٕ چُھس یِتہِ یژھان زِ توٚہؠ زٲنِو زِ أسؠ ہیٚکو بڈٕ اعتمادٕ سان روزِتھ زِ خدا چُھ یژھان تہِ کرُن یہِ أسؠ مونٛگو یمہِ وِزِ أسؠ دعا چھِ کران۔
\v 15 توٕ کِنؠ زِ أسؠ چھِ زانان زِ خدا چُھ یژھان اسہِ دیُن یہ کینٛژھا تہِ أسؠ تس مونٛگو۔ یوٚدوے یہِ تہِ چُھ یہِ سُہ یژھان چُھ، تیٚلہِ چھِ أسؠ زانان زِ خدا چُھ اسہِ تہِ برونٛٹھےٕ دِوان یہِ تس أسؠ منٛگان چھِ۔
\v 16 مثالہِ پٲٹھؠ، فرض کرو زِ کانٛژھا چُھ کٲنٛسہِ سٲتھی ایماندارس تیُتھ گناہ کران وُچھان یمہِ سٟتؠ نہٕ سُہ پننس خدایس نِش ہمیشہٕ باپتھ ژھٮ۪نہٕ تہِ گژھِ۔ تیٚلہِ پزِ تمِس پرژھُن خدایس زِ یہِ گناہ کرن وول انُن واپس وتہِ پٮ۪ٹھ۔ یوٚدوے سُہ یہِ کرِ تیٚلہِ پھرِ خدا تمِس نفرس بیٚیہِ واپس روحٲنی زندگی منٛز۔ وۅنؠ گوو بہٕ چُھس یہِ ونان چھرا تِمن لوٗکن متعلق یِم پانس کُن تیُتھ گناہ کرن یمہِ سٟتؠ نہٕ تِم ہمیشہٕ باپتھ خدایس نِشہ ژھٮ۪نہٕ گژھن۔ یتہِ چُھ گناہ یُس لوٗکن ہمیشہٕ خٲطرٕ خدایس سٟتؠ ژھٮ۪نہٕ گژھنک سبب چُھ بنان۔ بہٕ چُھسو نہٕ ونان زِ توٚہؠ کٔرِو تِتھؠ گناہ کرن والیٚن ہنٛدِ باپتھ تہِ دعا۔
\v 17 پرٮ۪تھ کانٛہہ غلط کٲم یۅسہ لوٗکھ کرن چُھ گناہ خدایس خلاف۔ وۅنؠ گوو کینٛہہ گناہ چھِ تِتھؠ تہِ یِمنہٕ أکِس نفرس خدایس نِشہ ژھٮ۪نہٕ کرن۔
\v 18 أسؠ چھِ زانان زِ پرٮ۪تھ کانٛہہ یُس تہِ خدایہِ سُنٛد روحٲنی گۅبُر یا کور بنہِ، کرن نہٕ لٔگؠ تھےٕ گناہ بلکہ کرِ یتھِس نفرس خدایہِ سُنٛد گۅبُر حفاظت۔ تاکہِ سُہ بد روح شیطان واتناونہٕ أمِس کانٛہہ دُکھ۔\f + \fr 5‏:18 \ft شیطان\f*
\v 19 أسؠ چھِ زانان زِ أسؠ چھِ خدایہِ سنٛدؠ۔ أسؠ چھِ یِتہِ زانان زِ سُہ بد روح شیطان چُھ تمام بے ایمان لوٗکن پننِس حکمس تل رٔٹِتھ۔
\v 20 أسؠ چھِ یِتہِ زانان زِ خدایہِ سُنٛد گۅبُر آو اسہِ منٛز تہٕ بنووُن سانہِ باپتھ یہِ سمجھُن ممکن زِ پزر کیا چُھ۔ تٔمؠ کوٚر یہِ تاکہِ أسؠ زانون پزنہٕ پٲٹھؠ پوٚز خدا۔ تہٕ أسؠ چھِ أمسےٕ پٔزِس خدایس سٟتؠ پنٕنؠ زندگی زُووان۔ یعنی تٔمؠ سٕنٛدِس گۅبرس یسوع مسیحؔ ہس سٟتؠ۔ یسوع چُھ پزی خدا تہٕ سُہ چُھ یہِ اسہِ پوشوٕنؠ زندگی دِوان۔
\v 21 بہٕ چُھسو یہِ توٚہہِ ونان یِم مےٚ تیتؠ ٹٲٹھؠ چُھو زنتہٕ توٚہؠ میٲنؠ پنٕنؠ شُرؠ چُھو: "خبردار روزیٚو یُتھنہٕ زانہٛہ کٲنٛسہِ اپزِس خدایس پان حوالہٕ کٔرِو۔"
