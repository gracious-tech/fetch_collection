\id GEN - DMT Kashmiri
\toc1 پیدٲیش
\mt1 پیدٲیش
\c 1
\p
\v 1 گۅڈٕ کٔرؠ خداین آسمان تہٕ زمین پٲدٕ۔
\v 2 ییٚلہِ تٔمؠ زمین پٲدٕ کٔر، یہ ٲس وٲران تہٕ سنسان۔ سرٔنِس آبس پٮ۪ٹھ اوس انہ گوٚٹ نال ؤلِتھ۔ خدایہ سُنٛد روح\f + \fr 1‏:2 \ft خدایہِ سُنٛد طاقت \f* اوس آبہٕ پیٚٹھؠ نژان۔
\v 3 خداین ووٚن، "بہٕ چُھس حکم دِوان گاش پھوٚلِن، "تہٕ گاشہٕ پھوٚل۔
\v 4 خدا گو گاش وُچِھتھ خوش۔ پتہٕ پریٚزلوو تٔمؠ خاص جاین مختلف وقتو یہِ گاش، یوٚدوے باقی جاین وُنہِ تہِ انہِ گوٚٹ اوس۔
\v 5 تٔمؠ تھوو گاشس دُہُل ناو تہٕ انہِ گٔٹس روتل۔ یہِ اوس شام تہٕ صبح، گو گۅڈنیُک دوٚہہ۔ \f + \fr 1‏:5 \ft یہ چُھ عِبرٲنؠ زبٲنؠ منٛز دوٚہُک تصوُر \f*
\v 6 پتہٕ ووٚن خداین، "بہٕ چُھس ونان آبس درمیان اکھ بوٚڈ خٲلی گُنٛبد ہیٚو پٲدٕ کرُن یمہِ سٟتؠ آبس زِ حصہٕ سپدن۔"
\v 7 تہٕ تی سپُد۔ خداین کٔر آبس درمیان اکھ خٲلی جاے اکہِ بڈِ گنٛبدچہِ شکلہِ منٛز پٲدٕ، تٔمؠ کوٚر آب دوٚن حصن منٛز تقسیم کٔرتھ بنمہِ آبہٕ نشہٕ ہیٚور کھٲلِتھ الگ۔
\v 8 خداین تھوو اتھ گنٛبد شکلہِ ہنٛدِس اتھ حصس "آسمان" ناو۔ یہِ اوس بیاکھ شام تہٕ صبح، یعنی دویم دوٚہہ۔
\v 9 تمہِ پتہٕ ووٚن خداین، "آسمانس تل موجود آب سپدِ أکِس جایہ جمع تاکہِ خُشک زمین نیرِ نٔنؠ تہٕ تمہِ پٮ۪ٹھٕ ییہِ ہیٚور کھٔسِتھ۔" تہٕ تی سپُد۔ \f + \fr 1‏:9 \ft 2پطرس 3:5\f*
\v 10 خداین کوٚر اتھ دھرتی "زمین" ناو، تہٕ یُس آب جمع سپُد تتھ ونُن "سمندر" خدا سپُد زمین تہٕ سمندر وُچِھتھ خوش۔
\v 11 پتہٕ ووٚن خداین، "مےٚ ووٚن زمینس رنٛگہ رنٛگہ کُلؠ کٔٹؠ وپداونہٕ باپتھ یم پھرؠ پھرؠ ۅپدان آسن، تِتھ کُلؠ یِمن بیٚول آسہ، میٚوٕ دِن تہٕ تِمنےٕ منٛز تِہُنٛد بیٚول تہِ موجود آسہ" تہٕ تی سپُد۔ \f + \fr 1‏:11 \ft 1کورنتھیون 15:3\f*
\v 12 پتہٕ آے زمینَس کُلؠ۔ پرٮ۪تھ قسمہٕ کِس کُلس اوس پنُن بیول سٟتؠ۔ پرٮ۪تھ اکؠ کُلؠ دیُت میٚوٕ یَتھ پنُن بیٚول تہِ سٟتؠ اوس۔ خدا گو یم کُلؠ وُچِھتھ خوش۔
\v 13 یہِ اوس شام تہٕ صُبح تریمہِ دوٚہُک۔
\v 14 پتہٕ ووٚن خداین، مےٚ دیُت حکم مختلف گاش آسمانس منٛز ظٲہر سپدَنٕکؠ۔ یمو سٟتؠ دوٚہس تہٕ رٲژ منٛز فرق لبنہٕ ییہِ۔ یہنٛزن ظٲہری شکلن منٛز تبدیلی یِتھ مختلف ۅرسَن تہٕ دویمیٚن چیزن ہنٛدِ وقتٕچ نشاندہی سپدِ یۅسہ لوٗکھ مختلف موقن تہٕ ورؠ ین منٛز کران چھِ۔"
\v 15 بہٕ چُھس یتہِ یژھان زِ آسمانٕکؠ یم گاش گٔژھؠ زمینہ پٮ۪ٹھ تہِ پرٮ۪زلٕنؠ" تہٕ یی سَپُد تہِ۔
\v 16 خداین بنٲوؠ زٕ بٔڈؠ وسیلہٕ امہِ گاشٕکؠ۔ ساروٕے کھۅتہٕ بوٚڈ اکھ آفتاب، یُس دوٚہس پٮ۪ٹھ راج کرِ تہٕ بیاکھ لۅکٕٹ اکھ، زوٗن، یۅسہ رٲژ پٮ۪ٹھ راج کرِ۔ بیٚیہِ کٔرنؠ پٲدٕ تارک۔
\v 17 خداین جٔرؠ تم آسمانس یُتھ زن زمینس کُن پرٮ۪زلن،
\v 18 دوٚہس تہٕ رٲژ پٮ۪ٹھ کرن راج، رٲژ ہُنٛد انہِ گۅٹ کڈن دوٚہہ کہِ پرٛیزلنہٕ سٟتؠ بیٚون۔ خدا گو یم گاش وُچِھتھ خوش۔
\v 19 یہِ اوس شام تہٕ صبُح ژورمہِ دوٚہُک۔
\v 20 پتہٕ ووٚن خداین، "پرٮ۪تھ کُنہِ زوو زٲژ منٛز آبس روزنہٕ باپتھ یمہ مےٚ پٲدٕ کرِ تہٕ آکاشس منٛز جاناوارن پھٲلنہٕ باپتھ یمہٕ زمینہِ پٮ۪ٹھ نژان چھِ۔"
\v 21 تہٕ خداین کٔر سمندرس منٛز روزن واجِنؠ مخلوٗق پٲدٕ، تہٕ تِم سٲری جاندار أنِن وجوٗدس یم سمندرس منٛز روزان چھِ، واریہس تعدادس منٛز۔ تٔمؠ أنؠ پرٛتھ کُنہِ قسمٕکؠ پکھل جاناوار بارسس۔ یہِ سٲرےٕ مخلوٗق چھےٚ پنٕنؠ ذریاتھ پانے وپداوان۔ خداین وُچھ یم سٲری چیز یمہٕ تٔمؠ وجوٗدس أنؠ تہٕ وُچِھتھ سپُد خوش۔
\v 22 خداین دِژ یِمن برکتھ تہٕ وننکھ، "پنٕنؠ ذریاتھ وپدٲیو تہٕ ہُررٲیو واریاہ زیادٕ۔ بہٕ چُھس یژھان آبس منٛز موجود تمام ذریاتھ ٲسِن آبہٕ کیٚن تمام حِصن منٛز، تہٕ جاناوار تہِ ٲسِن بے شُمار۔"
\v 23 یہِ اوس صبح شام پٲنٛژمہِ دوٚہُک۔
\v 24 پتہٕ ووٚن خداین، "بہٕ چُھس زمینَس حکم دِوان زِ سۅ کرِ قسمہٕ قسمہٕ جانور پٲدٕ یمہٕ پانہٕ پنٕنؠ نسٕل زمینہِ پٮ۪ٹھ بڈاون۔ مختلف قسمٕکؠ گریلو چاروٲے، زمینہِ پٮ۪ٹھ یٔڈ کھکھرِ پکن وٲلؠ جانور تہٕ قسمہٕ قسمہٕ بٔڈؠ جنٛگلی جانور۔" تہٕ یی سپُد۔
\v 25 خداین بنٲوؠ پرٛتھ قسمٕکؠ جنٛگلی جانور، گریلو چاروٲے تہٕ زمینہِ پٮ۪ٹھ پکن وٲلؠ مختلف قسمن ہنٛدؠ جاندار۔ یم پانہٕ پانسےٕ ہی مذید جانور پٲدٕ کرن۔ خدا اوس تمن خوش۔
\p
\v 26 پتہٕ ووٚن خداین، "ؤلِو وُنؠ بناون بہٕ پانسےٕ ہِش انسٲنی مخلوٗق۔ بہٕ چُھس یژھان زِ تم روزَن تمام سمندرچن گاڈن، آسمان کیٚن جاناوارن، تمام گریلو چارواین تہٕ زمینس پٮ۪ٹھ پکن والیٚن دوٚیمیٚن سارنی زوو ذٲژن پٮ۪ٹھ مختار۔
\v 27 تہٕ خداین کٔرؠ انسان پٲدٕ، یم واریہو رنٛگو تمسےٕ ہی ٲسؠ۔ تٔمؠ بنٲوؠ تم پانسےٕ ہی، تٔمؠ بنٲوؠ تم مرٕد تہٕ زنہِ ہنٛدس صوٗرتس منٛز۔ \f + \fr 1‏:27 \ft متّی: 19:4، مرقُ 10:6، اعما 17:29، 1کورنتھ: 11:7، کُل 3:10، 1، 1تھسلن 2:13 \f*
\v 28 پتہٕ دِژ خداین تِمن ٲہی تہٕ وُننَکھ، "واریہن شُریٚن دِیو زایُن، یم سٲرسےٕ زمینَس پھہلَن تہٕ کرن تتھ پٮ۪ٹھ راج۔ بہٕ چُھس یژھان یہِ زِ توٚہؠ کٔریو سمندرچن گاڈن، آسمان کیٚن جاناوارن تہٕ زمینہِ پٮ۪ٹھ موجود تمام زُو ذٲژن پٮ۪ٹھ راج۔"
\v 29 پتہٕ ووٚن خداین، وُچھو! مےٚ دِتِمو توٚہہِ تِم تمام کُلؠ یم سٲرسےٕ زمینَس پنُن بیوٗل پھٲلاوان چھِ، تہٕ سٲری میٚوٕ دِنہٕ وٲلؠ کُلؠ۔ یم سٲری چیز تُہنٛدِ کھینہٕ باپتھ چھِ۔
\v 30 مےٚ ۅپدٲوؠ تمام سبٕز کُلؠ سارنی جنٛگلؠ جانورن، جاناوارن تہٕ زمینہٕ پٮ۪ٹھ روزن واجنیٚن تمام زُو ذٲژن یعنی پرٮ۪تھ اکؠ سٕنٛدِ کھیٚنہٕ خٲطرٕ یمِس منٛز زندگی بخشن وول شہہ چُھ۔ تہٕ یی سَپُد تہِ۔
\v 31 خدا اوس پرٮ۪تھ کنہِ چیزس خوش یُس تٔمؠ پٲدٕ کوٚر۔ پٔزؠ پٲٹھؠ اوس یہِ سورےٕ سیٹھاہ اصل۔ یہِ شام تہٕ صبُح اوس شیٚمہِ دوٚہُک۔
\c 2
\p
\v 1 یتھ کِنؠ کٔرؠ خداین آسمان تہٕ زمین تہٕ اتھ منٛز موجود زُو زٲژ پٲدٕ۔ \f + \fr 2‏:1 \ft یِمن ہنٛدؠ سٲرے سِپاہ\f*
\v 2 یہِ اوس سٔتم دوٚہہ، ییٚلہ خداین سٲرےٕ تخلیقی کٲم مکمل کٔر، لہٰذا کٔر نہٕ تٔمؠ امہِ دوٚہہ مزید بیٚیہِ کانٛہہ کٲم۔ \f + \fr 2‏:2 \ft عبرو: 4:4\f*
\v 3 خداین کوٚر اعلان زِ پرٮ۪تھ سٔتم دوٚہہ آسہ میٚون۔ یہِ دوٚہہ کوٚر تٔمؠ باقی دوٚہو نشہٕ مقدس۔ تکیازِ امہِ دوٚہہ کوٚر تٔمؠ تمام تخلیقی کامہِ مکمل کرنہٕ پتہٕ آرام۔
\v 4 یتھٕ کنؠ أنؠ خداین آسمان تہٕ زمین وجوٗدس۔
\p خداین یسُنٛد ناو یہُوواہؔ چُھ بنٲوؠ آسمان تہٕ زمین۔
\v 5 گۅڈٕ اوس نہٕ تتہِ کانٛہہ کُل کۅٹ وُپدان۔ تکیازِ یہُوواہؔ خداین اوس نہٕ وُنہِ زمینہِ پٮ۪ٹھ روٗد ترووٕمُت۔ بیٚیہِ اوس نہٕ فصل وَونہٕ تہٕ زمین واینہٕ خٲطرٕ کانٛہہ اکھ موجود۔
\v 6 اتھ بجایہ اوس زمینہِ پٮ۪ٹھٕ بہہ وتھان تہٕ سورےٕ پتُھر اوس آبےٕ آب۔
\v 7 پتہٕ تُج یہُوواہؔ خداین میٚژ تہٕ بنووُن آدمؔ\f + \fr 2‏:7 \ft آدمؔ چُھ عِبرٲنؠ زبٲنؠ ہُنٛد لفظ، آدماہ گو پتُر، مگر آدمؔ چُھ اِسم معرفہ تہ۔ \f*۔ تٔمؠ بوٚر آدمس نستہِ کِنؠ پنُن شَہہ، یمہِ سٟتؠ چیزن زُو اژان چُھ۔ نتیجہٕ دراو یہِ زِ یہِ آدمؔ بنیو اکھ مکمل زِنٛدٕ انسان۔ \f + \fr 2‏:7 \ft 1 کورنتھی: 15:45 \f*
\v 8 یہُوواہؔ خداین بنوو عدنؔ ناوچہِ جایہِ اکھ باغ، یُس کنعان کِس مشرِقس منٛز اوس۔ تٔتی تھوو تٔمؠ یہِ آدمؔ یُس تٔمؠ بنوو۔
\v 9 یہُوواہؔ خداین ۅپدٲوؠ زمینہِ پٮ۪ٹھ تمام قسمٕکؠ کُلؠ یم وُچھنَس منٛز شوبہٕ ؤنؠ تہٕ کھیٚنہٕ خٲطرٕ اصل میٚوٕ دِوان ٲسؠ۔ تٔمؠ لوگ اتھ باغس منٛزباگ اکھ کُل، یتھ کھیٚنہٕ وٲلِس باپتھ حیٲتی بخشن وول میٚوٕ اوس۔ تٔمؠ لوگ تتِتھ بیاکھ کُل یمہِ سٟتؠ کھیٚنہٕ وٲلِس پےَ لگہ زِ کم عملہٕ چھےٚ صحی تہٕ کم چھےٚ غلط۔ \f + \fr 2‏:9 \ft مُکاشفہ: 2:7، 22:14\f*
\v 10 اکھ دٔریاو اوس عدنؔہٕ منٛزؠ پکان یُس باغس سٲراب کران اوس، عدنؔ منٛزٕ نیرتھ چُھ یہِ دریاو ژُون دٔریاون منٛز تقسیم گژھان\f + \fr 2‏:10\ft مُکاشفہ 22:2 \f*۔
\v 11 گوڈنِکہِ دریاوُک ناو چُھ فیسوؔن۔ یہِ دریاو چُھ حویلؔہ ہُنٛد سُہ سورےٕ زمین آوٕران یَتھ منٛز سۅن آسان چُھ۔
\v 12 سُہ سۅن چُھ سیٹھاہ شوٚد۔ اتہِ چُھ اکہ قسمُک مدُر مایہِ نیران یتھ بیڈیلیم ونان چھِ تہٕ قٟمتی کنہِ تہِ یمن سنٛگِ سلیمٲنی ونان چھِ۔
\v 13 دوٚیمہِ دریاوُک ناو چُھ جیحونؔ۔ یہِ دریاو چُھ سارے کُوشؔ \f + \fr 2‏:13 \ft کوٚش ملک چُھ اِتھوپیاؔ ناوٕ تہِ زاننہٕ یوان تہٕ امیُک واریاہ علاقہ چُھ موجودٕ سوڈان ناوٕ تہِ\f* علاقہٕ منٛزؠ پکان۔
\v 14 تریمہِ دریاوُک ناو چُھ دِجلؔہ۔ یہِ چُھ اسُورؔ شہرٕکہِ مشرق طرفہٕ پکان۔ ژورمہِ دریاوُک ناو چُھ فراتؔ۔
\v 15 یہُوواہؔ خداین تھوو آدمؔ عدنؔ ناوٕ کِس باغس منٛز، نگرٲنی تہٕ باغبٲنی کرنہٕ باپتھ۔
\v 16‏-17 تہٕ یہُوواہنؔ ووٚن آدمس، ژٕ ہیٚککھ میانہِ اجازتہٕ یمہِ باغہٕ منٛزٕ کانٛہہ تہِ میٚوٕ کھیٚتھ۔ مگر میٚون اجازت چھی نہٕ ژےٚ یمہِ کُلیٚک میٚوٕ کھیٚنس۔ یمہِ سٟتؠ ژٕ زٲنِتھ ہیٚککھ زِ کۅسہٕ کٲم نیٚیہ نیکی کُن تہٕ کۅسہٕ چھےٚ بٔدی کُن نِوان۔ اگر ژٕ امہِ کُلیُک میٚوٕ کھیٚوتھ تہٕ یمہِ دوٚہہ کھیٚکھ تمی دوٚہہ ہیٚککھ ژٕ مٔرِتھ تہِ۔
\v 18 یہُوواہؔ خداین ووٚن، "یہِ چُھنہٕ أمِس آدمؔ سٕنٛدِ خٲطرٕ جان زِ یہِ روزِ کُنےٕ زۅن۔ بہٕ بناون أمسےٕ ہیٚوٗ امسُنٛد اکھ سٲتھی۔"\f + \fr 2‏:18 \ft 1 کورنتھی 11:9\f*
\v 19 یہُوواہؔ خداین أنؠ میٚژ تہٕ بنٲوِن پرٮ۪تھ کُنہِ قسمٕکؠ جانور تہٕ جاناوار تہٕ پتہٕ أنِن آدمس نِش تاکہِ سُہ دییہِ یمن الگ الگ ناو۔ تہٕ آدمن دیُت پرٮ۪تھ کُنہِ زُو ذٲژ پنُن ناو یم یہُوواہنؔ بنٲومٕتؠ ٲسؠ۔
\v 20 پتہٕ تھٲوؠ آدمن تمام قسمہٕ کیٚن چارواین، جاناوارن تہٕ جنٛگلی جانورن ناو۔ مگر یمو منٛزٕ اوس نہٕ کانٛہہ اکھ یُس آدمؔ سُنٛد منٲسب سٲتھی بٔنِتھ ہیٚکہ ہے۔
\v 21 چونکہِ یہُوواہؔ خداین سوو آدمؔ مَژِ نینٛدرِ۔ ییٚلہِ سُہ شونٛگِتھ اوس، تہٕ یہُوواہؔ ہن کٔڈ آدمؔ سنٛزِ لرٕ کانہِ منٛزٕ اکھ۔ تہٕ پتہٕ کوٚرُن جلدی سُہ وُل بنٛد کٔرتھ تس مرہم
\v 22 پتہٕ بنٲو یہُوواہنؔ تتھ لرٕ کانہِ اکھ زٔنؠ یۅسہ تٔمؠ آدمؔ سٕنٛدِ جسمہٕ منٛزٕ کٔڈمٕژ ٲس۔ تہٕ أنِن مردس برونٛہہ کُن۔ \f + \fr 2‏:22 \ft 1 تیم 2:13\f*
\v 23 تہٕ آدمن ووٚن، "یقینن چُھ یہِ میٚی ہیٚو کُستام! امسنٛزٕ أڈجہ چھےٚ میانوےٕ أڈجو منٛزٕ تہٕ امسُنٛد ماز چُھ میانے جسمٕکہ مازٕ منٛزٕ۔ لہٰذا مانَن بہٕ یہِ اکھ زٔنؠ، تکیازِ سۅ چھےٚ میانے یعنی مردٕ سٕنٛدِ جسمُک اکھ حصہٕ۔
\v 24 گۅڈنِچ زٔنؠ آیہ مردٕ سٕنٛدِ جسمہٕ منٛزٕ کڈنہٕ، لہٰذا ییٚلہِ مرد تہٕ زٔنؠ پانہٕ وٲنؠ خاندر کرن تمن پزِ پنُن مول موج تراوُن۔ یُتھ تِم پانہٕ وٲنؠ نزدیک روزن، تہٕ دوٚنوے اکُے بنَن۔
\v 25 یوٚدوے مرٕد تہٕ زٔنؠ ننٛگے ٲسؠ مگر تمن گییہ نہٕ ننٛگہٕ ٲسِتھ کانٛہہ منٛدٕچھ۔ \f + \fr 2‏:25 \ft متّی 19:5، مارک 10:7- 8، عفسی 5:31 \f*
\c 3
\p
\v 1 سرف اوس وُنؠ تِمو ساروٕے جنٛگلی جانورو نِشہ زیادٕ چالاک یم یہُوواہؔ خداین بنٲوؠ۔ سرفن ووٚن تمِس، "کیا توٚہہِ کوٚرا خداین پزی منع باغہٕ منٛزٕ کُنہِ کلیُک پھل کھیٚنہٕ نِشہ؟" \f + \fr 3‏:1 \ft مُکاشفہ: 12:9، 20:2\f*
\v 2 زنہِ ووننَس یورٕ، خداین یہِ ووٚن تہِ چُھ یتھ کٔنؠ زِ تمہٕ کلیُک میٚوٕ کھییٚہِ زیٚنہٕ تہٕ نَہ لٲگؠ زیٚس اتھٕ یُس یتھ باغس منٛزباغ چُھ۔ اگر ژٕ تہِ کرکھ ژٕ سپدکھ ہلاک۔
\v 3 حالانکہ ژٕ ہیٚککھ باقی کُلیٚو منٛزٕ کنہِ تہِ کلیُک میٚوٕ کھیٚتھ۔"
\v 4 سرفن ووٚن أمِس زنہِ کُن، "نَہ نَہ ژٕ ہیٚککھ نہٕ ہرگِز مٔرِتھ۔ یہِ ووٚن خداین۔
\v 5 صرِف اوٕ موٚکھٕ تکیازِ یتُھےٕ ژٕ یہِ میٚوٕ کھیٚکھ ژےٚ ترنے باقی سارے کتھٕ فِکرِ۔ غرض ژےٚ گژھی نظرٕ یلہِ\f + \fr 3‏:5 \ft نظر یلہٕ گژھنُک مطلب چُھ، زانکٲری سپدِنؠ اصل تہٕ فراخٕچ وٲقفیت سپدٕنؠ۔ \f*، ژےٚ تٔری یہِ فکرِ زِ جان کیاہ چُھ تہٕ ناکارٕ کیاہ گو، یتھ کٔنؠ خدا زانان چُھ۔"
\v 6 زنہِ زون زِ امہِ کُلہِ پیٚٹھُک میٚوٕ کھیوٚن چُھ بہتر۔ یہِ چُھ سیٹھاہ شوٗبدار۔ تٔمؠ کٔر امِچ خٲہِش اوٕ موٚکھٕ تہِ زِ امہِ سٟتؠ گژھِ تمِس شۅد بۅد تہِ حٲصل۔ لہٰذا وٲلؠ تٔمؠ کینٛہہ میٚوٕ تہٕ کھین تہٕ أڈؠ دِتِن پننِس بٲژس تہٕ تٔمؠ تہِ کھیٚی۔
\v 7 یکدم آیہ تِمن أچھ مُژرنہٕ\f + \fr 3‏:7 \ft مطلب زانکٲری تہٕ وٲقفیت سپزکھ\f* تہٕ اتہِ وچُھکھ پنُن پان ننٛگے تہٕ گے شرمنٛدٕ۔ تِمو وٲلؠ انجیر کُلکؠ کینٛہہ پنہٕ ؤتھر تِم رلٲوِکھ تہٕ چُھپٲوکھ یموےٕ سٟتؠ پنٕنؠ تن۔
\v 8 امہِ دوٚہہ دُپہرٕ پتہٕ ییٚلہِ ترُن ہوا فیٚوٗر یمو بوز یہُوواہؔ خدایہ سنٛز آواز ییٚلہِ سُہ باغہٕ منٛزؠ پکان اوس۔ یم دوٚنوے مرٕد تہٕ زنانہٕ رودؠ باغس منٛز أکِس زنٛڈس ژھایہِ ژوٗرِ یُتھ نہٕ تمن یہُوواہؔ خداوند وُچھِ۔
\v 9 مگر یہُوواہؔ خداین کوٚر مردن آلو تہٕ وُننکھ "توٚہؠ کیازِ چُھو مےٚ نِش ژوٗرِ روزنٕچ کوشش کران؟"
\v 10 آدمن دتُنس جواب، "مےٚ بوز باغہٕ منٛزٕ تُہنٛدِ پکنٕچ آواز، مگر بہٕ اوسُس ننٛگے اوے کھۅژُس تہٕ رودُس توٚہہِ ژوٗرِ۔
\v 11 خداین ونُس، "ژےٚ کِتھٕ کٔنؠ زونُتھ زِ ژٕ چُھکھ ننٛگے؟ یہِ آسہ اوٕ موٚکھٕ سپُدمت زِ ژےٚ آسیٚتھ تمہِ کلیُک میٚوٕ کھیٚمُت یتھ متعلق مےٚ توٚہہ ونیٚومو زِ امیٚک میٚوٕ کھیٚؠ زیٚو نہٕ، کیا توٚہہ چُھوا تی کوٚرمُت؟"
\v 12 آدمن ووُنس، "توٚہہِ تھٲوٕ وُون یہِ زٔنؠ مےٚ سٟتؠ روزنہٕ خٲطرٕ۔ یہےَ چھےٚ سۅ یمہِ مےٚ امہِ کلیُک میٚوٕ کھیٚنہٕ باپتھ دیُت تہٕ مےٚ کھیٚو۔
\v 13 پتہ ووٚن یہُوواہؔ خداین تمِس زنہِ" ژےٚ کیازِ کوٚرتھ یہِ؟ زنہِ وونُس در جواب "مےٚ کھیٚو یہِ اوٕ موٚکھٕ تکیازِ بہٕ أننَس سرپھن پِھریبس منٛز۔"
\v 14 پتہٕ ووٚن یہُوواہؔ خداین سُرفس کُن "چونٛکہِ ژےٚ دِتُتھ یِمن فریب، اوٕ کِنؠ چُھسے بہٕ ژےٚ ساروٕے گریلو چاروایو تہٕ جنٛگلی جانورو منٛزٕ لعنت نٲزل کران۔ یمیُک نتیجہٕ یہِ آسہ زِ ژٕ تہٕ باقی تمام سرپھ آسن زمینہِ پٮ۪ٹھ یٔڈ کھکھرِ پکان، تہٕ یہِ کینٛژھا توٚہؠ کھیٚوان ٲسِو تتھ آسہ میٚژ بنان یۅسہ توٚہؠ وٲنٛسہِ ژٕہان روزیٚو۔
\v 15 "بہٕ بناوکھ ژٕ تہٕ چٲنؠ زٔنؠ اکھ اکؠ سنٛدؠ دشمن، تہٕ چٲنؠ اولاد تہٕ تسنٛدؠ اولاد اکھ اکؠ سنٛدؠ دشمن۔ ژٕ ژٹکھ تمِس کھورِ تہٕ سۅ دگہِ چون کلہٕ۔"
\v 16 پتہٕ ووٚن یہُوواہنؔ تمِس زنہِ، "ییٚلہِ ژٕ بچن زایُن دِکھ ژےٚ ۅتلاوے بہٕ کٲفی دگ۔ ژٕ یژھکھ پننِس خاندارس سٟتؠ روزُن مگر سُہ چلاوِ ژےٚ پٮ۪ٹھ حٲکمی۔"
\v 17 امہِ پتہٕ ووٚن تٔمؠ آدمس، "ژےٚ بوزُتھ پننہِ خانٛدارنہِ ہُنٛد تہٕ کھیٚوتھ تمہِ کلیُک میٚوٕ یتھ متعلق مےٚ ونیامے یہِ کھیٚؠ زیٚنہٕ۔ امہِ مۅکھٕ بناوٕ بہٕ زمینہِ منٛزٕ پھسٕل وپداوُن چانہِ یہ کرنٕکہ بٲعثہٕ مشکِل۔ یۅتام ژٕ زندٕ چُھکھ تۅتام پیی ژےٚ زمینہِ منٛزٕ کھیٚنہٕ خٲطرٕ چیز حٲصل کرنہٕ باپتھ سخت محنت کرٕنؠ۔
\v 18 کنٛڈؠ زنٛڈ، وُسنؠ کُلؠ تہٕ گاسہٕ آسہ تیوٗت زیٚوان یُس نہٕ چٲنِس ؤوؠ مٕتِس پھسلس کھسنہٕ دِوان آسہ۔ تہٕ ژےٚ ٲسی کھیٚنہٕ باپتھ تی کھیوٚن پیٚوان یہِ چٲنیٚن کھہَن منٛز ۅپدان آسہ۔
\v 19 سٲرسےٕ وٲنٛسہِ پیی ژےٚ پانس عٲرکھ والُن، پننہِ کھیٚنہٕ باپتھ خوراک حٲصل کرنہٕ موٚکھٕ محنت کٔرِتھ۔ پتہٕ مرکھ ژٕ تہٕ چٲنؠ لاش ییہِ زمینس منٛز دفن کرنہٕ۔ مےٚ بنووُکھ ژٕ میٚژِ ہُنٛد تہٕ چون جسم تہِ بنہِ پتہٕ میٚژےٕ۔
\v 20 یہِ اوس آدمؔ یمؠ پننہِ زنانہِ حواؔ ناو تھوو، یمیُک مطلب زندگی چُھ، تکیازِ سۅ بنییہِ پتہٕ تمام انسانؠ زُریٲژ ہنٛز موج۔
\v 21 پتہٕ مٲرؠ یہُوواہؔ خداین کینٛہہ جانور تہٕ بنووُن تہنٛدس مُسلس آدمؔ تہٕ حوا سٕنٛدِ باپتھ لِباس۔
\v 22 امہِ پتہٕ ووٚن یہُوواہؔ خداین، "وُچھو یم زٕ بنیاے اسی ہی، یم چھِ زانان زِ گناہ کیا چُھ تہٕ ثواب کیا گو۔ وُنؠ گژھِ نہٕ یتہِ سپدُن زِ یم نِن تتھ کُلس کُن اتھٕ تہٕ کھیٚن تمیُک میٚوٕ یُس یمن حیٲتی بخشہٕ تہٕ روزن ہمیشہٕ زندٕ!
\v 23 لہٰذا ژٔھنؠ یہُوواہؔ خداین باغِ عدنؔ منٛزٕ آدمؔ تہٕ حواؔ کٔڈتھےٕ تہٕ ترٲوِن سۅ زمین کماونہٕ باپتھ یمچہِ میٚژِ بنٲومٕتؠ ٲسِن
\v 24 ییٚلہِ یہُوواہؔ خداین یم باغہِ عدنہٕ منٛزٕ کٔڈتھ ژٔھنؠ تٔمؠ تھوو باغس مشرقہٕ طرفہٕ کروبیؔ ناوک اکھ فرشتہٕ تہٕ اورٕ یور نَژوٕنؠ نارو اکھ تلوار تتھ وتہِ بُتھِ رٲچھ یپٲرؠ حیٲتی بخشن وول سُہ کُل موجود اوس، یُتھ نہٕ کانٛہہ تمہِ کلیُک میٚوٕ کھیٚیہ یُس ہمیشہٕ حیٲتی بخشن وول چُھ۔
\c 4
\p
\v 1 آدمؔ تہٕ حوا سَپدؠ ہم بستر، حواؔ سپٕز بیٚیہِ زُووٕ تہٕ دِتُن أکِس اولادس زایُن یَس قائِن ناو کوٚرُکھ مطلب "پیدٲیش" تکیازِ! تمہِ ووٚن، یہُوواہؔ سٕنٛدِ یژھنہٕ زاو مےٚ اکھ نیٚچو۔"
\v 2 کینٛہہ کال گٔژھِتھ زاو تمِس بیاکھ اولاد، یس ہابیلؔ ناو کوٚرُکھ۔ بٔڈؠ گٔژھتھ لٲگؠ ہابیلنؔ تیٖر تہٕ ژھاوٕلؠ رچِھنؠ تہٕ قائِن لوٚگ زمیندٲری کرنہِ۔
\v 3 اکہ دوٚہہ سَپُد یتھ کِنؠ زِ قائِنَن نیٚو پننہِ وپدایہ مَتہِ فصلہٕ منٛزٕ کینٛہہ حصہٕ یہُوواہسؔ تحفہٕ رنٛگؠ۔
\v 4 تہٕ ہابیلؔن نیٚو پننہِ تیر کھیٚلہِ منٛزٕ نوزادٕ چِھرن ہُنٛد چربہٕ دار بہترین ماز۔ یہُوواہؔ گو ہابیلؔس تہٕ تمسںنٛدس تحفس پٮ۪ٹھ بڈٕ خوش
\v 5 مگر قائِن تہٕ تمؠ سنٛدِس تحفس گو نہٕ سُہ خوش۔ قابیلسؔ کھوٚت سخ شرارتھ، تہٕ تمسُنٛد رٔویہ رود نہٕ جان۔
\v 6 یہُوواہؔ ہن ووٚن قائِنس "ژےٚ پٔزی نہٕ شرارتھ کرُن! ژےٚ شوبی نہٕ یُتھ ؤطیرٕ اختیار کرُن!
\v 7 اگر ژٕ تہِ کرکھ یہِ جان گژھِ، بہٕ کرتھ ژٕ قبول۔ وُنؠ اگر ژٕ رُت ورتاوکھ نہٕ تہٕ یۅسہ بُرٲیی ژٕ کرٕنؠ یژھکھ سۅ گٲلی ژےٚ، تِتھ کٔنؠ زنتہٕ اکھ سہہ دروازس نیٚبرٕ کنہِ توٚہہ حملہٕ کرنس پراران چُھ۔ چانین گُنہن ہنٛز خٲہش چھےٚ ژےٚ پٮ۪ٹھ غلبہٕ کرُن یژھان۔ مگر ژےٚ پیی اتھ پٮ۪ٹھ ضروری قوبو پراوُن۔"
\p
\v 8 مگر اکہ دوٚہہ ووٚن قائِنن پننِس لوٚکٹِس بٲیس ہابیلسؔ، "ولہٕ مےٚ سٟتؠ یہِ کھہَس پٮ۪ٹھ۔"\f + \fr 4‏:8 \ft مگر واریہن مسودن منٛز چُھنہٕ یہ درٕج۔ \f* تہٕ تم دراے یکہٕ وٹہٕ۔ یِتھےٕ تم کھہَس منٛز وٲتؠ قابلن کوٚر اچانک پننِس بٲیس پٮ۪ٹھ حملہٕ تہٕ ژھنُن مٲرتھ۔
\p
\v 9 یوٚدوے خداوند یہُوواہؔ ہس یہِ پتاہ اوس زِ قائِنن کیا چُھ کوٚرمُت، تٔمؠ پرُوژھ توتہِ تس زِ، "ژےٚ ما چھی پے چون لۅکُٹ بوے ہابیلؔ کتہِ چُھ؟" قائِنن وونُس، "نَہ، مےٚ چھنہٕ خبر۔ میانؠ کٲم چھیٚنہٕ پننِس لۅکٹِس بٲیس رٲچھ روزُن!"
\v 10 یہُوواہنؔ ونُس، "یہِ کینٛژھا ژےٚ کۅرتھ تہِ چُھ بڈٕ خوفناک! چٲنِس بٲے سُنٛد خوٗن یُس پتھرِس لاریو، چُھ مےٚ ژےٚ سزا دِنہٕ باپتھ ناد لایان۔ \f + \fr 4‏:10 \ft عبری: 12:24\f*
\v 11 ژےٚ مورتھَن پنُن لۅکُٹ بوے تہٕ وُنؠ ییٚلہِ زمینس چٲنس بٲے سُنٛد خوٗن شروٚپ تہٕ وۅنؠ کٔری نہٕ ژےٚ یہِ زمین برداش تہٕ نہ گژھِ اتھ پٮ۪ٹھ چٲنؠ فصٕل ۅپداونٕچ کوشش کامیاب۔
\v 12 ییٚلہِ ژٕ فصٕل ۅپداونہٕ باپتھ زمین شیرکھ تہٕ زمین دِیی ژےٚ واریاہ کم فصٕل۔ ژٕ روزکھ زمینس انٛدؠ پٔکؠ لگاتار پھیران مگر ژےٚ یی نہٕ کُنہِ أکِس جایہِ تہِ مستقل قرار۔"
\v 13 قائِنن ووٚن یہُوواہسؔ در جواب، "ژٕ چُھکھ مےٚ تیٚوت زیادٕ سزا دِوان یوٚت نہٕ مےٚ بِتُر چُھ۔
\v 14 ژٕ چُھکھ مےٚ تمہِ زمینہِ نِشہ محروم کرُن یژھان یۅسہ بہٕ کماوان چُھس، تہٕ بہٕ روزٕ نہٕ وُنؠ تُہنٛدس تحویلس منٛز۔ اکھتُے یتہِ زِ بہٕ پھیرٕ وُنؠ لگاتار ہٹرِ پتہٕ ہٹرِ تہٕ کُنہِ جایہ کرٕنہٕ مستقل قرار۔ تہٕ کانٛہہ تہِ فرد یُس مےٚ وُچھِ ہیٚکہِ مےٚ مٲرِتھ۔"
\v 15 مگر یہُوواہنؔ ووٚن تمِس، "نَہ، تہِ ہیٚکہ نہٕ بنِتھ۔ بہٕ تھاوے ژےٚ نشانہٕ ترٲوِتھ تاکہِ یُس ژےٚ وُچھی سُہ روزِ حیٚسہٕ اگر سُہ ژےٚ قتل کٔری بہٕ دِمہٕ تس خطرناک سزا۔ یُس سزا بہٕ ژےٚ دِوان چُھسے تمہِ نِشہ ستہٕ گنہٕ سزا دِمہٕ بہٕ تس۔ پتہٕ تروو یہُوواہنؔ قائِنس نشانہٕ۔
\v 16 اوٕ کِنؠ تروو قائِنن یہُوواہؔ أتی تہٕ دراو نودؔ\f + \fr 4‏:16 \ft نودؔ آوارٕ گردی ہنٛز سرِ زمین۔ \f* ناوٕ کِس علاقس کُن روزنہٕ خٲطرٕ، یمیُک مطلب "آوارٕگی" چُھ تہٕ یہِ اوس عدن کِس مشرِقس منٛز۔
\v 17 کینٛہہ کال گٔژھِتھ شونٛگ قائِن پننہِ آشنہِ نِش، سۅ روز بیٚیہِ زُووٕ تہٕ دِتُن أکِس لڑکس زایُن، یمِس حنوکؔ ناو آو کرنہ۔ امہِ پتہٕ کوٚر قائِنن اکھ شہر بساوُن شُروع، تہٕ امہِ شہرُک ناو تہِ تھووُن پننِس نیٚچوِس سٕنٛدِس ناوس پٮ۪ٹھ حنوکؔ
\v 18 حنوکؔ سپُد بالیٚغ تہٕ کوٚرُن خاندر۔ یتھ کٔنؠ بنیاو سُہ أکِس لڑکہٕ سُنٛد مول یَس عیرادؔ ناو تھووُن۔ عیرادؔ بنیاو بوٚڈ گٔژھِتھ محویااؔیل سُنٛد مول۔ محویا ایل سٕنٛدِ پُشتہٕ آو متوساایلؔ تہٕ متوساایلؔ سٕنٛدِ پُشتہٕ دراو لمکؔ
\v 19 لمکنؔ کرِ زٕ زنہِ نیتٔرؠ، اکؠ سُنٛد ناو اوس عدہؔ تہٕ بیٚکؠ سُنٛد ناو اوسُس ضِلہ۔
\v 20 عدہؔ سٕنٛدِ مرِ زاو جبلؔ ناوُک فرزنٛد۔ پتہٕ بنیاو جبلؔ سُہ گۅڈنیُک شخص یمؠ خٟمَن منٛز بسُن ہیٚوت۔ تکیازِ سُہ اوس چو چاروٲے رچھان یمہِ کِنؠ تس اکہ جایہ پٮ۪ٹھٕ بیٚیس جایہِ گژُھن پیٚوان اوس۔
\v 21 تمِسنٛدس لۅکٹِس بٲیس اوس یوبُلؔ ناو۔ سُہ اوس گۅڈنیُک فرٕد یمؠ بٲتھ ؤنؠ تہٕ نےَ بنٲو۔ \f + \fr 4‏:21 \ft کونٛس بوے\f*
\v 22 لمکؔ سنٛزِ دویمہِ زنانہِ ضِلہ ہَن دیُت أکِس لٔڑکس زایُن یمسُنٛد ناو تٔمؠ توبِلقائن تُھوو، یمؠ پتہٕ بوٚڈ گٔژھِتھ شستٕر تہٕ سَرتلہِ ہنٛدؠ چیز بناوٕنؠ لٲگؠ۔ نعمہؔ ٲس توبِلقائن سنٛز لۅکٕٹ بیٚنہِ
\v 23 اکہ دوٚہہ ووٚن لمکنؔ پننٮ۪ن دوٚن گرٕ واجنیٚن، اے عدہؔ تہٕ ضِلہ میانیو گرٕ واجنیٚو میانؠ کتھ بوزیٚو غورٕ سان۔ اکؠ جوانن لوے مےٚ تہٕ کوٚرنس زخمی، مےٚ ژُھن سُہ مٲرِتھ۔
\v 24 یہُوواہنؔ چُھ گۅڈے ونمُت زِ یُس تہِ قائِنسؔ مارِ تمِس ییہِ بدلہٕ ہیٚنہٕ، تمِس ییہِ ستتھ گنہٕ زیادٕ سزا دِنہٕ۔ لہٰذا اگر مےٚ کانٛہہ مارنٕچ کوشش کرِ تمِس ییہِ ستتھ گنہٕ علاوٕ سزا دِنہٕ۔
\v 25 آدمؔ رود لگاتار پننہِ خاندارنہِ نِش شونٛگان، تہٕ سۅ روز دُبارٕ بیٚیہِ زووٕ تہٕ دِتُن بیٚیِس اولادس زایُن یس تمہ سیت ناو کوٚر۔ تمہِ ووٚن، "مےٚ کوٚر یمِس سیٹھؔ ناو تکیازِ خداین سوز مےٚ ہابیلؔ سٕنٛدِ بدل یُس قائِننؔ قتل کوٚر بیاکھ اولاد۔
\v 26 پتہٕ ییٚلہِ سیتؔ بوٚڈ گو تمِس تہِ زاو اکھ اولاد، یمِس تٔمؠ انوشؔ ناو تھوو۔ تمہِ وقتہٕ پٮ۪ٹھ چھِ لوٗکھ یہُوواہؔ سنٛز عبادت کران۔
\c 5
\p
\v 1 یہِ چُھ تمن فردن ہُنٛد فہرست یم آدمؔ سٕنٛدِ پشت منٛزٕ آے۔ ییٚلہِ خداین آدمؔ وجودس اوٚن تٔمؠ بنوو سُہ واریہو رنٛگو پانسےٕ ہیٚو\f + \fr 5‏:1 \ft متی 1:1، 1 کورنتھین 11:7\f*
\v 2 تٔمؠ دِژ اکھ مرٕد تہٕ اکھ زٔنؠ تخلیق کٔرتھ تِمن برکتھ۔ یمہٕ دوٚہہ تم تخلیق کرنہٕ آے تمی دوٚہہ ووننکھ آدمؔ۔ \f + \fr 5‏:2 \ft متی: 19:4، مرقوس 10:6\f*
\v 3 ییٚلہ آدمؔ سنٛز وانٛس 130 وری وٲژ ادٕ زاو تمِس اکھ لڑکہٕ یُس عٲن تہٕ غٲن تٔسؠ ہیٚو اوس۔ تہٕ أمِس اولادس تھووُن سیتؔ ناو۔
\v 4 سیت سٕنٛدِ زیٚنہٕ پتہٕ رود آدمؔ ٲٹھن شتن ؤرین بیٚیہِ زندٕ، تہٕ یمن ٲٹھن شتن ؤرین منٛز زاے تس بیٚیہِ تہِ شُرؠ، کورِ تہٕ لڑکہٕ۔
\v 5 کُلس پٮ۪ٹھ رود آدمؔ 930 ؤرین زنٛدٕ تہٕ پتہٕ گُذریو۔
\v 6 سیت بنیاو 105 وُوہر وٲتِتھ مول ییٚلہ تس انوش زاو۔
\v 7 انوش سٕنٛدِ زیٚنہٕ پتہٕ رود سیت 807 ؤرین زندٕ تہٕ یمن ورین دوران بنیاو سُہ مذید لڑکن تہٕ کورین ہُنٛد مول۔
\v 8 سیت رود کُلس 912 ؤرین زندٕ تہٕ امہِ پتہٕ گُذریٚو۔
\v 9 ییٚلہ انوش نمتھ وُوہر سپُد تمِس نِش سپُد کنان تولُد۔
\v 10 کنان سٕنٛدِ تولُد سپدنہٕ پتہٕ رود انوش مذید ٲٹھن شتن تہٕ پنٛدہَن ورین زندٕ تہٕ اتھ دوران زاے تمِس بیٚیہِ تہِ اولاد۔
\v 11 انوش سپُد کُل نوشتھ تہٕ پانٛژھ وری وانٛس پرٲوِتھ وفات۔
\v 12 ییٚلہ کنان ستتھ وُوہر ووت سُہ بنیاو محلل ایلؔ\f + \fr 5‏:12 \ft محلیل ایل: مطلب خدایہ سنٛدؠ تعریف\f* سُنٛد مول۔
\v 13 محلل ایلؔ سٕنٛدِ زیٚنہٕ پتہٕ رود کنان 840 ہن ورین زندٕ تہٕ زاس بیٚیہِ تہٕ کینٛہہ کورِ گۅبُر۔
\v 14 یتھ کِنؠ گذریو کنان 910 وری وٲنٛسہِ پتہٕ۔
\v 15 ییٚلہ محلل ایلؔ پنٛژہٲٹھ وُوہر ووت سُہ بنیاو یارد سُنٛد مول۔
\v 16 یارد سٕنٛدِ زینہٕ پتہٕ اوس محلل ایلؔ مزید 830 ؤرین زندٕ تہٕ اتھ دوران زاس بیٚیہِ تہِ شُرؠ۔
\v 17 محلل ایلؔ رود کل 895 ورین زندٕ تہٕ امہ پتہٕ گذریو۔
\v 18 ییٚلہ یارد 162 وۅہر ووت تہٕ سُہ بنیاو حنوک سُنٛد مول۔
\v 19 حنوک سٕنٛدِ زینہٕ پتہٕ اوس یارد ٲٹھن شتن ورین زندٕ تہٕ زاس بیٚیہِ تہِ کورِ گۅبُر۔
\v 20 یاردؔ گذریو الہٕ پلہٕ 962 ؤری وانٛس پرٲوِتھ۔
\v 21 ییٚلہِ حنوک پنٛژہٲٹھ وُوہر گو تہٕ سُہ بنیاو متوسلح سُنٛد مول۔
\v 22 متوسلح سٕنٛدِ زینہٕ پتہٕ رود حنوک خدایہ سٕنٛدِس نزدیکی قُربتس منٛز ترین ہتن ورین زندٕ تہٕ بنیاو بیٚیہِ تہِ واریہن کورین گۅبرن ہُنٛد مول۔
\v 23 حنوکن پرٲو 365 وری وانٛس۔
\v 24 حنوک اوس خدایہ سٕنٛدِس نزدیکی قُربتس منٛز تہٕ گو اکہ دوٚہہ اچانک غٲب تکیازِ خداین بُلوو سُہ پانس نِشہ۔ \f + \fr 5‏:24 \ft عِبرٲنؠ: 11:5 \f*
\v 25 ییٚلہ متوسلح 187 وُوہر ووت سُہ بنیاو لمک سُنٛد مول۔
\v 26 لمک سٕنٛدِ زیٚنہٕ پتہٕ رود متوسلح 782 ورین زندٕ تہٕ بنیاو بیٚیہِ تہِ کورین گۅبرن ہُنٛد مول۔
\v 27 یتھ کِنؠ رود متوسلح کلہُم پٲٹھؠ 969 ورین زندٕ تہٕ گُذریو۔
\v 28 لمک بنیو 182 وُوہر وٲتِتھ أکِس لڑکہٕ سُنٛد مول
\v 29 أمِس لڑکس تھووُکھ ناو نوحؔ۔ تکیازِ یتھ کِنؠ تٔمؠ ووٚن ز، "سُہ بچاوِ اسہِ تِمو ساروٕے مشکلاتو نشہٕ یمہٕ اسہِ پھسٕل وپداونس دوران تُلنؠ پیٚوان چھِ، ینہٕ یہُوواہنؔ امہِ باپتھ لعنت کٲنٛچھ۔"
\v 30 لمکؔ رود نوحؔ سٕنٛدِ زیٚنہٕ پتہٕ 595 ورین زندٕ تہٕ اتھ دوران زاے تمِس بیٚیہِ تہِ کورِ گۅبُر۔
\v 31 لمکؔ گُذریوو 777 وری وانٛس چھٲوِتھ۔
\v 32 ییٚلہِ نوح پانٛژھ ہتھ ورشہِ وٲنٛسہِ پٮ۪ٹھ ووت تمہِ وزِ زاو تمِس تمؠ سنٛزِ خاندارنہ نِش اکھ لٔڑکہٕ۔ لہٰذا کۅرُن تٔمس سمؔ ناو، پتہٕ زاس دویم نیٚچو، لہٰذا کۅرُن تس حامؔ ناو، پتہٕ زاس تریٚیم لٔڑکہٕ، تہٕ تس کۅرُن تس یافت ناو۔
\c 6
\p
\v 1 ییٚلہ سٲرسےٕ دھرتی پٮ۪ٹھ لوٗکن ہنٛز تعداد بڈنہِ لٔج تہٕ واریہو کوریو زایُن لوٚب۔
\v 2 تہٕ یہُنٛد حسُن وُچِھتھ تمبلییہِ آسمانٕچ مخلوق تہٕ ژاریکھ پانس نیتٕرؠ کرنہٕ باپتھ۔
\v 3 پتہٕ ووٚن یہُوواہنؔ، "میٚون شاہ پوشہٕ نہٕ لوٗکن ہمیشہٕ یمہِ سٟتؠ تِم زندٕ روزِتھ ہیکن۔ تم چھِ کمزور مازٕکؠ بنیمٕتؠ یمہٕ نہٕ اکھ ہتھ تہٕ وُہہ وری کھۅتہ زیادٕ وانٛس پراون۔ \f + \fr 6‏:3 \ft میون روح یُس زندگی بخشان چُھ۔ پیدٲئش 2:7: \f*
\v 4 ییٚلہ یمن انسٲنؠ زنیٚن سٟتؠ آسمٲنی مخلوق ہم بستر سپدؠ، تمن زاے شُرؠ۔ یم ٲسؠ تِم جنیات یم تمہِ وقتہٕ تہِ زمینس پٮ۪ٹھ روزان ٲسؠ تہٕ تمہِ پتہٕ تہِ۔ یم جنیات ٲسؠ گۅڈٕ پیٚٹھےَ معروف تہٕ بہادُر جنگجو۔
\v 5 یہُوواہنؔ وُچھ زِ زمینہِ پٮ۪ٹھ آے لوٗکھ بُرائین منٛز ہیٚنہٕ۔ تہٕ یہِ کینٛژھا تم سونچان چھِ تہِ چھنہٕ بُرائیو بغٲر بیٚیہِ کِہین۔ \f + \fr 6‏:5 \ft زبور 53:2\f*
\v 6 یہُوواہسؔ گو یتھ کتھِ پٮ۪ٹھ افسوس زِ تٔمؠ کٔر زمینس پٮ۪ٹھ مخلوق پٲدٕ یمؠ سُہ غمگین کوٚر۔
\v 7 پتہٕ ووٚن یہُوواہنؔ، بہٕ کرکھ تم لوٗکھ انٛد ہیٚتھ نابود یم مےٚ پٲدٕ کٔرؠ۔ بہٕ کرکھ تم بٔڈؠ جانور تہٕ زمینہِ پٮ۪ٹھ روزن واجنہِ زوو ذٲژ تہٕ جاناوار تہِ نابود۔ یمو منٛزٕ روزِنہٕ کینٛہہ تہِ موجود۔ تکیازِ مےٚ چُھ افسوس زِ یم کٔرؠ مےٚ تخلیق۔
\p
\v 8 مگر یہُوواہؔ اوس نوحؔ ہس بڈٕ خوش۔
\v 9 یہِ سپُد اوٕ موٚکھٕ، تکیازِ نوح اوس سُہ شخص یمؠ سُنٛد سلوک ہمیشہٕ رُت اوس۔ اتھ زمانس منٛز اوس نہٕ کنہِ تہِ کتھِ پٮ۪ٹھ تمِس کانٛہہ تنقیدُک شکار بناوان۔ نوح اوس ہمیشہٕ خدایہ سٕنٛدِس قُربتس منٛز روزان۔
\v 10 نوح اوس ترٛین شُرین ہُنٛد مول: سم، حام تہٕ یافت۔
\v 11 خداین وُچھ زِ زمینہٕ پٮ۪ٹھ ٲسؠ باقی سٲری سیٹھاہ بدکار، تہٕ اتھ پٮ۪ٹھ چھِ پرٛتھ جایہِ لوٗکھ اکھ أکِس ظلم تہٕ تشدُد کران۔
\v 12 خدا اوس پرٛتھ کٲنٛسہِ وُچھان تہٕ زانان زِ لوٗکھ کٲتیاہ بُرٕ چھِ تکیازِ زمینہِ پٮ۪ٹھ اوس تمام لوٗکو ظلُم ورتاوُن لوگمُت۔
\v 13 پتہٕ ووٚن خداین نوح ہؔس، "مےٚ نیٚو تمام لوٗکھ ہلاک کرنُک فٲصلہٕ، تکیازِ سٲری لوٗکھ چھِ زمینہ پٮ۪ٹھ اکھ أکِس تشدد کران۔ بہٕ چُھس یمو نِشہ نجاتھ یژھان تہٕ زمینہِ پٮ۪ٹھ موجود باقیو چیزو نِشہ تہِ۔
\v 14 پننہِ باپتھ بناو صنوبر لکٕرِ ہنٛز اکھ بٔڈ ناو۔ اندرٕ بناوس کُٹھؠ، آبہٕ نشہٕ بچنہٕ باپتھ لاگُس اندرٕ نیٚبرٕ تارکول۔
\v 15 ژےٚ پزی یہِ یتھ پٲٹھؠ بناونؠ زِ امیٚک زیچھر گژھِ 138 میٹر، کھجر 23 میٹر تہٕ تھزر 14 میٹر آسن۔
\v 16 اتھ چُھ پتہٕ پش کرُن پشس تہٕ لبن درمیان گژھِ اوٚڈ گزا وژھر روزُن یپٲرؠ گاش تہٕ ہوا ترِ۔ اتھ گژھن ترےٚ طبقہٕ بنٕنؠ تہٕ اکہ انٛدٕ گژھیس دروازٕ روزُن۔ \f + \fr 6‏:16 \ft پش\f*
\v 17 غورٕ سان بوزیٚو! بہٕ چُھس اکھ سُہ سہلاب انَن وول یُس آسمانس تلہٕ کنِچ سٲرےٕ ذریاتھ تباہ تہٕ بُربادکرِ۔ یمہِ سٟتؠ زمینس پٮ۪ٹھ موجود تمام چیز مرن۔
\v 18 مگر بہٕ چُھس ژےٚ سٟتؠ اکھ وعدہ کران۔ ژٕ تہٕ چٲنؠ خاندارِنؠ، چٲنؠ اولاد تہٕ تِہنٛزٕ خاندارنہِ گژھن اتھ ناوِ سوار۔ \f + \fr 6‏:18 \ft نۅشہٕ\f*
\v 19 ژےٚ پزنے پرٛتھ زُوو ذٲژ ہنٛزٕ زٟ زٕ جورِ پانس سٟتؠ اتھ ناوِ منٛز تُلنہِ تاکہِ تِم تہِ روزن محفوظ۔
\v 20 پرٛتھ کُنہِ قسمٕکؠ زٕ جاندار ین توٚہہ نِش تاکہِ توٚہؠ تھٲووکھ تمہ زندٕ۔ اتھ منٛز آسہ پرٛتھ جاناوار سُنٛد اکھ جورٕ تہٕ پرٛتھ بڈس جانور سُنٛد اکھ جورٕ تہٕ زمینس پٮ۪ٹھ پکن والیٚن کیٚمیٚن کریلن ہُنٛد اکھ اکھ جورٕ۔
\v 21 ژےٚ پزی پرٛتھ کانٛہہ کھینہٕ چینُک چیز سٟتؠ تلُن یمِچ ژےٚ تہٕ اتھ سٲرسےٕ مخلوقاتس ضرورت پیٚیہِ تہٕ یہِ پیٚیی ژےٚ اتھ ناوِ منٛز محفوظ تھاوُن۔
\v 22 تہٕ نوحؔ ہن کوٚر تہِ سورے یہِ تس خداین ووٚن۔"
\c 7
\p
\v 1 پتہٕ ووٚن یہُوواہنؔ نوحؔ ہس زِ، "مےٚ وُچھ زِ یم تہِ لوٗکھ زندٕ چھِ تمن منٛز چُھکھ صرف ژےٕ اکھ یُس نیکی ورتاوان چُھ۔ اوے چُھس بہٕ یژھان زِ ژٕ تہٕ چٲنؠ تمام گرٕ بٲژ کھسن ناوِ منٛز۔
\v 2 پانس سٟتؠ تُلزیکھ پرٮ۪تھ قسمہٕ کیٚن جانورن ہنٛزٕ ستتھ جورِ یم مےٚ ونہِ مو۔ تاکہِ بہٕ کرٕ تہنٛز قربٲنی قبول۔ ستتھ مرٕد تہٕ ستتھ زنہِ تُلزیوکھ۔ بیٚیہِ تُلزیو پرٮ۪تھ زوو ذٲژ منٛزٕ اکھ نر تہٕ اکھ مادٕ یم مےٚ ونمُت چُھمو تِم آسن نہٕ قربٲنی خٲطرٕ۔
\v 3 بیٚیہِ تُلزیوکھ جاناوارو منٛزٕ تہِ ستتھ جورِ تاکہِ تہنٛز ذریاتھ روزِ زندٕ۔
\v 4 یی کٔرؠ زیٚو تکیازِ ستہِ دوٚہؠ پتہٕ کرٕ بہٕ زمینس پٮ۪ٹھ رود تراوُن شروع، یُس برابر ژتجہَن دوٚہُن تہٕ ژتجہَن رٲژن برابر جٲری روزِ۔ یتھ کِنؠ کرن بہٕ زمینس پٮ۪ٹھ پرٮ۪تھ کانٛہہ سُہ چیژ تباہ یُس مےٚ بنومُت چُھ۔"
\p
\v 5 نوحؔ ہَن أنؠ سۅ پرٮ۪تھ کانٛہہ کتھ بجا یۅسہ یہُوواہنؔ تمِس ونمٕژ ٲس۔
\v 6 نوحؔ اوس تمہِ وزِ شےٚ ہَتھ وُوہر ییٚلہِ زمینَس سہلاب کھۅت۔
\v 7 رود لاگنہٕ برونٛٹھےٕ کٔھتؠ سہلابہٕ نشہٕ بچنہٕ باپتھ نوحؔ تمؠ سنٛز خاندارنؠ تمسنٛدؠ نیٚچوؠ تہٕ تہنٛزٕ خاندارنہِ ناوِ منٛز۔ \f + \fr 7‏:7 \ft نۅشہٕ\f*
\v 8 جانورن ہنٛزٕ تمہٕ جورِ یمہٕ خداین قربٲنی باپتھ ونمژٕ آسہ تہٕ تمہٕ یمہٕ نہٕ قربٲنیٚو باپتھ آسہ، تہٕ جاناوارن ہنٛزٕ جورِ، تہٕ زمینہِ پیٚٹھؠ پکَن واجنہِ زوو ذٲژ۔
\v 9 موٚہنی تہٕ زنہِ وٲتؠ نوحؔ ہس نِش تہٕ پتہٕ کٔھتؠ ناوِ منٛز، یتھ کِنؠ زن نوحسؔ خداین ونمُت اوس زِ تم کرن۔
\v 10 ییٚلہ ستتھ دوٚہہ پتھ کن گے رود لاگُن گو شروع تہٕ سہلاب ہیٚوتُن کھسُن۔
\v 11 ییٚلہِ نوحؔ شےٚ ہتھ ؤہرؠ سپدؠ، دوٚیمہٕ ریتہٕ کہِ سدٲہمہِ لوٚگ زمینہِ تلُک آب بُبرایہٕ ہیٚور کھسنہِ تہٕ روٗد لوٚگ یُتھ شرانہِ وسنہِ زنتہٕ آسمان کہ سمندرکؠ سوٚتھی یلہِ گے۔
\v 12 برابر ژتجَہن دوٚہُن اوس راتس دوٚہس روٗد شرانہِ وسان۔
\v 13 یمہِ دوٚہہ روٗد لوگُن نوح کھوٚت پنٕنؠ خاندارنؠ، پننؠ تریٚنوے نیٚچوؠ سمؔ، حامؔ، یافتؔ تہٕ تہنٛزٕ خاندارنہِ ہیٚتھ ناوِ منٛز۔
\v 14 سُہ تہٕ پرٮ۪تھ قسمٕکؠ جنگلی جانور، گریلو چاروٲے، زمینہ پٮ۪ٹھ پکن واجنہِ زوو ذٲژ، پرٮ۪تھ کُنہِ قسمٕکؠ وُڈوُنؠ جاناوار کٔھتؠ اتھ ناوِ منٛز۔
\v 15 شاہ ہیٚنہٕ واجنہِ تمام زوو ذٲژن ہنٛزٕ جورِ آیہ نوحؔ ہس نِشہ تہٕ کھژٕ ناوِ۔
\v 16 پرٮ۪تھ کُنہِ زوو ذٲژ منٛزٕ اکھ نر تہٕ اکھ مادٕ یم نوح ہَس نِشہ واژٕ یہِ زن خداین کرُن ونمُت اوس۔ ییٚلہِ یمہٕ سٲری ناوِ منٛز کٔھتؠ خداوند یہُوواہنؔ کوٚر دروازٕ بنٛد۔
\v 17 ژتجہَن دوٚہُن رود آب گنان، سہلاب گو بڑان تہٕ ناو روز وار وارٕ تھدان۔
\v 18 سہلابہٕ وُنؠ گو تیزی سان ہیٚور ہیٚور کھسان تہٕ ناو لٔج آبس پٮ۪ٹھ نژنہِ
\v 19 سٲرسےٕ زمینس پٮ۪ٹھ لوٚگ آب تیزی سان تھدنہِ یۅتام پہاڑ تہٕ آسمان تلٕکؠ تمام چیژ آبس تل ڈُبیاے۔
\v 20 تھدِ کھۅتہٕ تٔھدؠ پہاڑ تہِ ٲسؠ شےٚ شےٚ گز آبس تل۔ \f + \fr 7‏:20 \ft لگ بگ 23 فُٹہٕ\f*
\v 21 نتیجہٕ دراو یہِ زِ زمینس پٮ۪ٹھ موجود تمام زوو ذٲژ گییہِ آبس تل تہٕ مویہِ یتھ منٛز جاناوار، چو چاروٲے، جنٛگلی جانور، زمینہِ پٮ۪ٹھ روزن والیٚن باقی کیٚمؠ کریلن سٟتؠ سٟتؠ تمام انسانؠ ذریاتھ شٲمل ٲس۔
\v 22 زمینس پٮ۪ٹھ موجود شاہ ہیٚنہٕ واجِنؠ ہر کانٛہہ زوو ذاتھ سپٕز ختم۔
\v 23 یتھ کِنؠ سپدؠ دھرتی پیٚٹھٕکؠ تمام جاندار یعنی انسان، بٔڈؠ جانور، کیمؠ کریل تہٕ وُڈوُنؠ جاناوار ختم تہٕ صرف رود نوح تہٕ تِم یم تمِس سٟتؠ ناوٕ منٛز ٲسؠ۔
\v 24 یہِ سہلاب رود برابر أکِس ہتس تہٕ پنٛژہَن دوٚہُن زمینس پٮ۪ٹھ گردش کٔرتھ۔
\c 8
\p
\v 1 مگر خداین مشروو نہٕ نوحؔ، یا تم سٲری جنگلی جانور، تمام قسمن ہنٛدؠ گریلو چو چاروٲے، یم تمِس سٟتؠ ناوِ منٛز ٲسؠ۔ اکہ دوٚہہ تروو خداین تیٚوتھ ہوا یمہِ سٟتؠ آب کم سپُد
\v 2 خداین کوٚر زمینہٕ تلُک آب وُزن تہِ بنٛد تہٕ آسمان پٮ۪ٹھٕ وسن واجنہِ سہلاب جرِ تہٕ روٗد پیٚون تہِ رکووُن۔
\v 3 وار وارٕ لوٚگ زمینس پٮ۪ٹھ آب کم گژھنہِ۔ سہلابہٕ پتہٕ گو قریبن ڈۅڈِ ہتہِ دوٚہؠ سہلابہٕ وُونؠ واریہس حدس تام کم۔
\v 4 سٔتمہِ ریٚتہٕ کہ سدٲہمہِ تٲریخہ ٹھہرییہِ ناو اراراطؔ علاقہٕ کیٚو پہاڑو منٛزٕ أکِس جایہ۔
\v 5 آب رود کم کم گژھان یۅتام امہِ وریہ دہمہِ ریتچہِ سانٛکرٲژ پٮ۪ٹھ باقی پہاڑن ہنٛدؠ تینٛتٲلؠ تہِ نٔنؠ دراے۔
\v 6 ژتجہی دوٚہؠ ترٲو نوحؔ ہَن ناوِ ہنٛز سۅ دٲر ؤژھ یۅسہ تٔمؠ بنٲومٕژ ٲس تہٕ اکھ کاو ترُووُن تپٲرؠ یلہِ۔
\v 7 کاو رود تۅتام ناوِ اورٕ یور وُڈان یۅتام نہٕ پتُھر پورٕ خوشک گو۔
\v 8 پتہٕ سوز نوحؔ ہَن اکھ کوتُر یہِ وُچھنہٕ خٲطرٕ زٕ آب گوا زمینہِ پٮ۪ٹھٕ کم کِنہٕ نہ۔
\v 9 مگر کوترس بنییہِ نہٕ بہنَس کُنہِ جاے تکیازِ آب اوس ونہِ سارنی جاین موجود، لہٰذا آو کوتُر ناوِ منٛز بہتھ نوحؔ ہس نِشہ واپس۔ نوحؔ ہن پلنوو اتھٕ تہٕ ژونُن دارِ کِنؠ کوتُر واپس۔
\v 10 نوح ہَن کوٚر بیٚیہِ ستن دوٚہُن انتطار۔ تہٕ پتہٕ سوزُن کوتُر ناوِ منٛزٕ بیٚیہِ نیٚبر۔
\v 11 یمہِ لٹہِ آو کوتُر شامس بیٚیہِ نوح ہس نشہٕ واپس۔ مگر حٲرٲنی ہنٛز کتھ چھےٚ یہِ زِ کوترن اوٚن زیتون کُلیُک اکھ پنہٕ ؤتھر ژونٛژِ منٛز یمہِ سٟتؠ نوحؔ ہس پے لوٚگ زِ آب چُھ کم گمُت۔
\v 12 نوحؔ ہن کوٚر مذید ستن دوٚہُن صبٕر تہٕ پتہٕ سوزُن دُبارٕ کوتُر بیٚیہِ نیٚبر مگر یمہِ لٹہِ آو نہٕ تس نِش کوتُر واپس۔
\v 13 نوح اوس وُنؠ 601 وُوہر۔ یمہِ ؤریکہِ گوڈنِکہِ ریتکہِ گوڈنِکہِ دوٚہہ اوس آب زمینہِ پٮ۪ٹھٕ بلکُل ختم گوٚمُت۔ تٔمؠ تُل ناوِ پٮ۪ٹھٕ پردٕ تھوٚد تہٕ اتہِ گو وچُھتھ حٲران زِ پتُھر چُھ خوشک گوٚمُت۔
\v 14 دویمہِ ریتہٕ کِس ستووہمِس دوٚہس تام ٲس زمین بلکل خوشک گٔمژ۔
\v 15 پتہٕ ووٚن خداین نوحؔ ہَس،
\v 16 تراوُن ناو یلہٕ تہٕ نیر پننؠ خاندارنؠ، لڑکہٕ تہٕ تہنٛزٕ گرٕواجنہِ ہیٚتھ نیٚبر۔
\v 17 تمام جاناوار، گریلو چو چاروٲے تہٕ زمینہٕ پیٚٹھچہ تمام زُو ذٲژ کڑُکھ پانس سٟتؠ تاکہِ تم پھیرن سٲرسےٕ زمینس تہٕ گنَن۔
\v 18 یتھ کٔنؠ دراو نوحؔ تس سنٛز خاندارنؠ تمؠ سنٛدؠ گۅبر تہٕ تہنٛزٕ خاندارنہِ ہیٚتھ ناوِ منٛزٕ نیٚبر۔
\v 19 پتہٕ درایہِ سارے زوو ذٲژ یتھ منٛز وُڈوٕنؠ جاناوار، زمینہِ پیٚٹھٕکؠ جانور تہِ شٲمل ٲسؠ۔ تہٕ پن پننہِ جمٲژ ترٲو یتھٕ کٔنؠ ناو یلہٕ۔
\v 20 پتہٕ بنٲو نوح ہَن یہُوواہؔ سٕنٛدِ باپتھ اکھ قربان گاہ۔ تِمو نی کینٛہہ جاناوار تہٕ جانور یمہٕ قربٲنی خٲطرٕ لگہٕ ہار ٲسؠ، مٲرِتھ قربان گاہس پٮ۪ٹھ یمہ تِمو پورٕ پٲٹھؠ زٲلِتھ ژھنؠ۔
\v 21 یہُوواہؔ گو یمن قربٲنیٚن ہُنٛد مُشق یِتھےٕ سیٹھاہ خوش۔ پتہٕ ووٚن تٔمؠ پانسےٕ سٟتؠ زِ "بہٕ کرٕنہ وُنؠ تِمو گُنہو کِنؠ یم لوٗکھ کران چھِ زمینہِ پیٚٹھُک پرٛتھ کانٛہہ چیز زانٛہہ تہِ فناہ۔ ییٚلہِ زن جوٲنی منٛز لوٗکن ہنٛزٕ سونٛچن ترایہ بلکُل غلط آسان چھےٚ۔ بہٕ کرکھ نہٕ دُبارٕ سٲری جاندار فناہ، یتھ کِنؠ مےٚ از کوٚر۔
\v 22 یۅتام دھرتی موجود چھےٚ بیٚول وونُک سیزن تہٕ فصل لوننُک موسم، سردی ہُنٛد وق تہٕ گریشمہٕ کال، تٟر، تاپھ، دوٚہہ تہٕ راتھ روزن جٲری۔"
\c 9
\p
\v 1 خداین کٔر نوح ہِس تہٕ تمسنٛدین نیٚچوٮ۪ن برکتھ عطا۔ تٔمؠ ووٚن تِمن، "بہٕ چُھس توٚہہِ نِش واریاہ اولاد یژھان یم سٲرسےٕ زمینس پٮ۪ٹھ بسن۔
\v 2 زمینس پٮ۪ٹھ موجود تمام بٔڈؠ جاناوار، جاناور زمینہٕ پیٚٹھچہ زُو ذٲژ تہٕ گاڈٕ کھۅژُن توٚہہ۔ بہٕ تھاوکھ تمہٕ تُہنٛدس قوبوس منٛز۔
\v 3 گۅڈٕ دیُت مےٚ توٚہہِ سبزی کھیٚنُک اجازت۔ وُنؠ ہکیٚو توٚہؠ سُہ پرٛتھ اکھ چیز کھیٚتھ یُس زُوو دار تہٕ ہرکٔژل آسہ۔ \f + \fr 9‏:3 \ft پیدٲیش: 1:29-30\f*
\v 4 مگر توٚہؠ ہکیٚو نہٕ سُہ ماز کھیٚتھ یتھ منٛز وُنہِ خوٗن موجودے آسہ۔ تکیازِ خوٗنہٕ سٟتؠ چُھ سُہ زندٕ۔ \f + \fr 9‏:4 \ft تصنیہہ: 12:23\f*
\v 5 بہٕ دمہٕ تس پرٛتھ أکِس سزا یُس کانٛسہِ زُوو ذٲژ مارِ۔ تم چھِ یہُوواہسؔ نِشہ جواب دیہہ۔ چاہے سُہ انسان آسہ یا کانٛہہ جانور۔ بہٕ چُھس یہ مطالبہ کران زِ قٲتلس گژھِ پننہِ جُرمُک خمیازٕ تُلن پیٚون تہٕ تمِس گژھِ زُو ڈنٛڈ دیُن پیٚون۔ یوٚدوے کانٛہہ جانور کٲنٛسہ انسانس مارِ سُہ جانور تہِ گژھِ مارنہٕ یُن۔ تکیازِ تٔمؠ مٲر اکھ زُوو ذاتھ۔
\v 6 مےٚ چھِ لوٗکھ پانسےٕ ہی بنٲومٕتؠ لہٰذا چُھس بہٕ یژھان اگر کانٛہہ انسان بییِس کٲنسہِ انسانس قتل کرِ سُہ انسان تہِ گژھِ قتل کرنہٕ یُن۔ یُس کٲنٛسہِ ہُنٛد خوٗنی بنہِ زانُن گژھِ سُہ چُھ پننُے خوٗن کران۔
\v 7 یۅتام زن تُہنٛد تعلق چُھ، بہٕ چُھس یژھان زِ توٚہؠ گٔژھیٚو واریاہ بچہٕ پٲدٕ کرٕنؠ تاکہٕ تم تہٕ تِہنٛدؠ شُرؠ بسن سٲرسےٕ زمینس پٮ۪ٹھ۔
\v 8 خداین ووٚن نوحؔ ہَس تہٕ تٔمسٕنٛدیٚن شُرین،
\v 9 "غورٕ سان بوزیٚو۔ وُنؠ چُھس بہٕ توٚہہ تہٕ تہنٛدین وٲرثن سٟتؠ اکھ وعدہ کران۔
\v 10 تہٕ توٚہہِ سٟتؠ موجود پرٛتھ جاندارس سٟتؠ، یتھ منٛز جاناوار، گریلو چو چاروٲے تہٕ جنٛگلی جانور تہِ شٲمل چھِ، زمینس پٮ۪ٹھ موجود تِمن زُوذٲژن سٟتؠ تہِ یم توٚہہ سٟتؠ ناوِ منٛزٕ ؤتھؠ۔
\v 11 یہِ چُھ سُہ وعدہ یُس بہٕ توٚہہ سٟتؠ کران چُھس: بہٕ کرکھ نہٕ وُنؠ سہلابہٕ سٟتؠ زانٛہہ تہِ تمام زُوذٲژ فناہ۔ تہٕ نَہ کرکھ زمینہِ پیٚٹھٕکؠ باقی چیز تباہ۔"
\v 12 پتہٕ ووٚن خداین تمِس، "یہِ چھےٚ امہِ کتھِ ہنٛز نشٲنی زِ بہٕ کرٕ پنُن یہِ کوٚرمُت وعدہ پوٗرٕ یُس بہٕ ژےٚ تہٕ باقی تمام جاندارن سٟتؠ کران چُھس۔ یہِ چُھ سُہ وعدہ یُس بہٕ ہمیشہٕ خٲطرٕ کران چُھس۔
\v 13 وقتہٕ وقتہٕ وُچِھو توٚہؠ آسمانس پٮ۪ٹھ رام رام بدرنؠ بوُنؠ یہِ آسہ توٚہہ تہٕ زمین کِس پرٮ۪تھ چیزس سٟتؠ میانہِ وعدٕچ نشٲنی۔
\v 14 ییٚلہِ بہٕ اوٚبرٕ منٛزٕ روٗد تراوٕ تہٕ آسمانس پٮ۪ٹھ گژھِ رام رام بدرنؠ بوُنؠ ظٲہِر،
\v 15 امہِ سٟتؠ پییٚہِ مےٚ سُہ عَہد ژیٚتس یُس مےٚ توٚہہِ تہٕ باقی تمام زُو ذٲژن سٟتؠ کوٚرمُت چُھ۔ میٚون وعدہ چُھ زِ وُنؠ پِھرٕ نہٕ زانٛہہ تہِ تیٚوتھ سہلاب یُس جاندارن فناہ کرِ۔
\v 16 ییٚلہ تہِ آسمانس پٮ۪ٹھ رام رام بدرنؠ بوُنؠ بہٕ وُچھِ تہٕ بہٕ آسہٕ تتھ وعدس متعلق سونچان یُس مےٚ زمینَس پٮ۪ٹھ روزن واجنہِ پرٛتھ زُو ذٲژ سٟتؠ کوٚر۔ سُہ وعدہ یُس بہٕ ہمیشہٕ خٲطرٕ پُورٕ کرٕ۔"
\v 17 خداین ووٚن پتہٕ نوحؔ ہَس، زِ "رام رام بدرنؠ بوُنؠ چھےٚ تمہِ عہُدٕچ نشٲنی یُس مےٚ زمینہِ ہنٛزن تمام زُو ذٲژن سٟتؠ کوٚر۔
\v 18 نوحؔ سنٛدؠ یم نیٚچوؠ ناوِ منٛزٕ دراے تِم ٲسؠ، سم، حام تہٕ یافت۔ حام بنیاو پتہٕ کنعان سُنٛد مول۔
\v 19 دھرتی پٮ۪ٹھ ییتیاہ تہِ لوٗکھ چھِ تم چھِ نوح سنٛدین تِمن تریٚن نیٚچوٮ۪ن ہنٛدِ پُشتٕکؠ۔
\v 20 نوحؔ ہَن کٔر زمیندٲری شروع۔ تٔمؠ لٲگؠ دچھِ کُلؠ۔
\v 21 دچھ وپداونہٕ پتہٕ لوگ تٔمؠ شراب بناوُن۔ اکہ دوٚہہ ییٚلہِ تٔمؠ واریاہ زیادٕ شراب چیو، سُہ گو بے ہوش تہٕ رود پننِس خٟمس منٛز ننٛگے۔
\v 22 کنعانٕنؠ مٲلؠ حامَن وُچھ پنُن مول خٟمَس منٛز ننٛگے پتھر پیمُت۔ سُہ دراو جلدےٕ نیٚبر تہٕ ونُن پننٮ۪ن دونوٕنؠ باین یہِ حال۔
\v 23 پتہٕ أنؠ سمینؔ تہٕ یافتنؔ اکھ کپر ژادر، تہٕ سۅ پانس پٔتؠ کِنؠ رٔٹتھ گے خٟمس منٛز تہٕ ترٲوٕکھ پننِس نیٚتھٕ نٔنِس مٲلِس تتھٕ کٔنؠ پٮ۪ٹھ یُتھ نہٕ تہنٛز نظر پننِس مٲلؠ سٕنٛدِس ننٛگہٕ جسمَس پٮ۪ٹھ پییہِ۔
\v 24 ییٚلہِ نوحؔ ہُشار سپُد تہٕ بیٚیہِ حیسَن منٛز آو تمِس پیٚو یاد زِ تمسنٛدؠ لۅکٕٹؠ نیٚچیو ہامنؔ کُس بُرٕ ورتاو کوٚر تمِس سٟتؠ۔
\v 25 تٔمؠ ووٚن، "بہٕ چُھس ہام سٕنٛدِس نیٚچوِس کنعان تہٕ تمسنٛدین شُرین لعنت سوزان۔ تم آسن پننِس پِتٕر سنٛدین نوکرن ہی۔
\q
\v 26 بہٕ چُھس یہُوواہؔ ہَس تعظیم کران یمسنٛز سمؔ عبادت کران چُھ۔ کنعان سنٛدؠ اولاد بٔنِنؠ سمؔ سنٛدین اولادن خٲدِم۔
\v 27 مگر خدا کٔرنؠ تافت سُنٛد علاقہٕ کُشادٕ۔ سُہ کٔرنؠ یافت سنٛدین شُرین تہٕ سم سنٛدین شُرین پانہٕ وٲنؠ ملژار پٲدٕ۔ کنعان سنٛدؠ اولاد بٔنِن تہنٛدؠ غلام۔"
\p
\v 28 نوح رود سہلابہٕ پتہٕ ساڈ ترٛیہ ہَتھ وری پیٚٹھی زندٕ۔
\v 29 نوح گُزریو ساڈ نو شتھ ؤرشہِ وٲنٛسہِ منٛز۔
\c 10
\p
\v 1 نوحؔ سنٛدیو زُریٚو یم تمسنٛدین اولادن سم، حام تہٕ یافت سنٛدؠ نیٚچوؠ ٲسؠ بنیاے سہلابہٕ پتہٕ واریہن شُریٚن ہنٛدؠ مٲلؠ۔
\v 2 یافت سنٛدؠ اولاد ٲسؠ: جُمرؔ، ماجوجؔ، مادیؔ، یاوانؔ، توبلؔ، مسکؔ تہٕ تیراسؔ۔
\v 3 جُمرؔ سنٛدؠ اولاد ٲسؠ: اشکنازؔ، ریفتؔ، تہٕ تجرمہؔ۔
\v 4 تہٕ یاوانؔ سںنٛدیو اولادو منٛزٕ ٲسؠ: اِلیسہؔ، ترسیسؔ، کِتّی، تہٕ دودانی۔
\v 5 جاونؔ سنٛدؠ شُرؠ تہٕ تِہُنٛد خاندان اوس سمندر بٹھیٚن تہٕ جزیرن منٛز روزان۔ تِہنٛدؠ اولاد بنیاے لوٗکن ہنٛدؠ مختلف قبیلہٕ۔ پرٛتھ قبیلس اوس پنُن الگ علاقہٕ تہٕ پنٕنؠ الگ زبان۔
\v 6 حامؔ سنٛدیو اولادو منٛزٕ ٲسؠ کُوشؔ، مِصر، فوطؔ تہٕ کنعان۔
\v 7 کُوشؔ سنٛدیو اولادو منٛزٕ ٲسؠ سبا حویلؔہ، سبط، رعماہ تہٕ سبتِکہ۔ رعماہ سنٛدؠ شُرؠ ٲسؠ سباؔ تہٕ ددانؔ۔
\v 8 کُوشؔ سنٛدیو اولادو منٛزٕ اوس اکھ نمرُود۔ نمرُود اوس زمینہِ پٮ۪ٹھ سُہ گۅڈنیُک فرد یُس بوٚڈ جنگجو بنیاو۔
\v 9 یہُوواہنؔ وُچھ زِ سُہ بنیاو اکھ بوٚڈ جنٛگجو۔ اوے ٲسؠ لوٗکھ کٲنٛسہِ بٔڈس شکٲرس متعلق ونان، "یہُوواہؔ چُھ وُچھان زِ ژٕ چُھکھ نمرُودٕنؠ پٲٹھؠ بوٚڈ شکٲرؠ۔"
\v 10 نمرُود بنیاو پتہٕ بادشاہ یمؠ بابلؔ شہرس پٮ۪ٹھ حکومتھ کٔر۔ ساروٕے گۅڈٕ یمن شہرن پٮ۪ٹھ تٔمؠ حکومتھ کٔر تمن منٛز ٲسؠ بابلؔ، اریکؔ، اکادؔ تہٕ کلنہؔ۔
\v 11 اتہِ پٮ۪ٹھٕ دراو سُہ باقی لوٗکن سٟتؠ اسُورؔ۔ تہٕ تتہِ بنٲوؠ تٔمؠ نینوہؔ، رحوبوتؔ عیر، کلح،
\v 12 تہٕ ریسن ناوٕکؠ شہر۔ ریسن اوس نینوہؔ تہٕ کلحؔ ہس منٛزباگ اکھ بوٚڈ شہر۔
\v 13 تہٕ مِصرٕ پٮ۪ٹھٕ حام سنٛدؠ شُرؠ ٲسؠ لود، عنامؔ، لہاب، تہٕ نفتوحؔ،
\v 14 فتروس، کسلوحی، تہٕ کیفتو۔ فلستینی لوٗکھ ٲسؠ کسلوحی سٕنٛدِ قبیلہٕ منٛزٕ۔
\v 15 حامؔ سُنٛد کونٛس ہیٚو نیٚچو کنعان بنیاو صیدا سُنٛد مول۔ یُس تمسُنٛد زیُٹھ اولاد اوس تہٕ حِت اوسُس لۅکُٹ ہیٚو نیٚچو۔
\v 16 کنعان سنٛدیو وٲرثو منٛزٕ بنیاے یبوس، امورؔ، جِرجاسؔ،
\v 17 حوی، عارقؔ، سِنؔ،
\v 18 اروید، زمِر تہٕ حمات، لُکہٕ قبیلہٕ۔ پتہٕ بسیاے کنعان سنٛدؠ اولاد أکِس بٔڈِس علاقس منٛز۔
\v 19 کنعانؠ ۂنٛدؠ زمینی حدود ٲسؠ شہرِ صیدا کِہ شمالہٕ پٮ۪ٹھٕ جرار کِہ جنوبہٕ کِنؠ غزہ ہس تام پھٟلِتھ۔ تہٕ پتہٕ مشرِقس منٛز سدومؔ، عمورہ، آدمؔ تہٕ زبوئیم چیو سریو کِنؠ لاشہ کِس شہرس تام۔
\v 20 یم ٲسؠ حام سنٛدؠ اولاد۔ یمن مختلف جمٲژ بنیٚیہ، یمن پن پنٕنؠ قبیلہٕ، پنٕنؠ زبان تہٕ پنٕنؠ زمین ٲس۔
\v 21 یافت سٕنٛدِس بٔڈس بٲیس سمیس تہِ ٲسؠ نیٚچیو یم عِبر سنٛدین سارنی وٲرثن ہنٛدؠ جدٕ اجداد بنیاے۔
\v 22 سمؔ سنٛدؠ نیٚچوؠ ٲسؠ عیلامؔ، اشورؔ، ارفکسدؔ، لُد تہٕ ارامؔ۔
\v 23 ارامؔ سنٛدؠ اولاد ٲسؠ عُض، حول، جتر تہٕ مسؔ۔
\v 24 ارفکسد بنیاو سلح سُنٛد مول تہٕ سِلح بنیاو عِبر سُنٛد مول۔
\v 25 عِبر بنیاو دوٚن شُرین ہُنٛد مول، تِمو منٛزٕ اوس اکھ فِلجؔ یمیُک مطلب تقسیم گژھن گو۔ تکیازِ یۅتام سُہ زندٕ رود زمینس پٮ۪ٹھ ٲسؠ لوٗکھ منتشِر گژھتھ بیٚون بیٚون۔ پیلک سُنٛد لۅکُٹ بوے اوس یُقطان۔
\v 26 یُقطانس نِشہ گے الموداد، شیلف، حصار ماوت، اِراخ۔
\v 27 ہدورام، اوزال، دِقلہ،
\v 28 عوبل، ابی مائیل، سباؔ۔
\v 29 اوفیر، حویلؔہ، تہٕ یوباب پٲدٕ۔ یم سٲری ٲسؠ یُقطان سںنٛدؠ اولاد۔
\v 30 یمن علاقَن منٛز یم قبیلہٕ بسنہِ لٔگؠ تم ٲسؠ میشا پٮ۪ٹھٕ مشرق کِس پہٲڑی علاقہٕ سفار تام پھٲلِتھ۔
\v 31 تِم ٲسؠ سمؔ قبیلچہِ زٲژ منٛزٕ۔ یم لوٗکن ہنٛدؠ الگ ونٛڈٕ بنیاے یمن پنٕنؠ قبیلہٕ پنٕنؠ زبان تہٕ پنٕنؠ زمین ٲس۔
\v 32 یم سٲری قبیلہٕ ٲسؠ نوحؔ سنٛدیو اولادو منٛزٕ۔ پرٛتھ قبیلس اوس پنُن شجرہ نسب تہٕ پرٛتھ اکھ بنیاو اکھ الگ ونٛڈٕ۔ لوٗکن ہنٛدؠ یم سٲری ونٛڈٕ بنیاے سہلابہٕ پتے تہٕ لٔگؠ پرٛتھ طرفہٕ زمینس پٮ۪ٹھ بسنہِ۔
\c 11
\p
\v 1 امہِ وقتہٕ ٲسؠ دنیاہس منٛز تمام لوٗکھ اکےٕ زبان بولان۔
\v 2 مشرقہٕ طرفہٕ وٲتؠ لوٗکھ اورٕ یور پھیرتھ تھورِتھ بابلؔ کِس أکِس مٲدانس منٛز تہٕ لٔگؠ تٔتی روزنہِ۔
\v 3 پتہٕ ووٚن تِمو اکھ أکِس، "ؤلِو أسؠ تراوو سیرِ تہٕ تِم پییہِ ووکھ تاکہِ تم گژھن تعمیرٕ باپتھ درِ" یتھ کٔنؠ کوٚر تِمو کنیو بجایہ سیرین ہُنٛد استعمال۔ تم لاگنہٕ خٲطرٕ لوگ تِمو چونہٕ بجایہ تارکول کامہِ۔
\v 4 تِمو ووٚن، "ؤلِو أسؠ کرو پننہِ خٲطرٕ اکھ شہر آباد! اسہِ پزِ اکھ تھوٚد میٖنار تہِ تعمیر کرُن یُس آسمانس تام پِلو کرِ۔ یمہِ سٟتؠ لوٗکن پے لگہ زِ أسؠ کم چھِ۔ اگر أسؠ تہِ کرو نہٕ أسؠ یمو سٲرسے دھرتی چھکرنہٕ!
\v 5 اکہ دوٚہہ ووٚتھ یہُوواہؔ یہِ شہر تہٕ میٖنار وُچھنہِ یُس لوٗکھ تعمیر کران ٲسؠ۔
\v 6 یہُوواہنؔ سونچ، "یم لوٗکھ چھِ اکھ کُنی جماتھ یم اکےٕ بوٗلؠ بولان چھِ۔ اگر یمو یہِ قدم تُلمُت چُھ کانٛہہ مسلہٕ چُھنہٕ تکیازِ یُس فٲصلہٕ یم نِن سُہ آسہ نہٕ یہنٛدِ خٲطرٕ ناممکِن!
\v 7 لہٰذا یِیو، أسؠ گژھو یمن نِشہ تہٕ ہیٚچھنٲوؠ ووکھ یم بیٚون بیٚون زبانہٕ تاکہِ یمن ترِنہٕ اکھ اکؠ سنٛز کتھ فکرِ۔
\v 8 یہ کرنہٕ سٟتؠ کٔرؠ تِم یہُوواہنؔ زمینہِ پٮ۪ٹھ منتشِر تہٕ لوکو کوٚر یہِ شہر بساوُن بنٛد۔
\v 9 امہِ شہرُک ناو اوس بابلؔ، تکیازِ اتہِ دِژ نہٕ یہُوواہنؔ سٲرسےٕ زمینہِ پٮ۪ٹھ بسن والین اکےٕ زبان ورتاونہٕ۔ یہُوواہنؔ چھکراوؠ تم امہِ جایہ پٮ۪ٹھٕ سٲرسےٕ زمینس۔
\v 10 یم ٲسؠ سمؔ سٕنٛدِ قبیلہٕ منٛزکؠ۔ سہلابہٕ پتہٕ دویہ ؤہرؠ ییٚلہِ شیم ہتہٕ وُوہر سپُد، سُہ بنیاو ارفکسد سُنٛد مول۔
\v 11 ارفکسد سٕنٛدِ زیٚنہٕ پتہٕ رود سم مزید پانٛژن ہتن ؤرین زندٕ تہٕ دِتُن بیٚیہِ تہِ کورین گۅبرَن زایُن۔
\v 12 ییٚلہ ارفکسدؔ پنٛژترہہ وُوہر ووت تہٕ تمِس زاو سِلحؔ ناوک لڑکہٕ۔
\v 13 سِلحؔ سٕنٛدِ زینہٕ پتہٕ رود ارفکسد مذید ژورن ہَتن تہٕ تریٚن دوٚہُن زندٕ تہٕ زاس بیٚیہِ تہِ کورِ گۅبُر۔
\v 14 ترٛہہ وُوہر وٲتِتھ زاو سِلح ہَس عِبر ناوُک فرزنٛد۔
\v 15 عِبر سٕنٛدِ زیٚنہٕ پتہٕ رود سِلح ژورن ہتن تہٕ تریٚن دوٚہُن زندٕ تہٕ اتھ دوران زاس بیٚیہِ تہِ کورِ گۅبُر۔
\v 16 ییٚلہِ عِبر ژُویہ ترٛہہ وُوہر ووت، تمسنٛدِ مرِ آو فِلجؔ۔
\v 17 فِلجؔ سٕنٛدِ زیٚنہٕ پتہٕ رود عِبر مذید ژورن ہتن تہٕ تریٚن دوٚہُن زندٕ تہٕ بنیاو بیٚیہِ تہِ مذید کوریٚن تہٕ لڑکن ہُنٛد مول۔
\v 18 تمہِ وزِ اوس فِلجؔ ترٛہہ وُوہر ییٚلہِ تس رعو ناوُک فرزندٕ زاو۔
\v 19 رعو سٕنٛدِ زیٚنہٕ پتہٕ اوس فِلجؔ دوٚن ہَتن تہٕ نون ریتن زندٕ تہٕ دوران زاس بیٚیہِ تہِ شُرؠ۔
\v 20 رعو اوس دویہِ ترٛہہ وُوہر ییٚلہِ سُہ سروجؔ سُنٛد مول بنیاو۔
\v 21 سروجؔ سُنٛد مول بننہٕ پتہٕ رود رعو مذید دوٚن ہتن تہٕ ستن ورؠ ین زندٕ تہٕ زاس بیٚیہِ تہِ کورِ گۅبر۔
\v 22 ترٛہہ وُوہر وٲتِتھ زاو سروجسؔ نحورؔ ناوُک لڑکہٕ۔
\v 23 نحورؔ زیٚنہٕ پتہٕ رود سروجؔ دوٚن ہَتن ؤرین زندٕ تہٕ اتھ دوران زاس بیٚیہِ تہِ کینٛہہ کورِ گۅبُر۔
\v 24 ییٚلہِ نحورؔ کُنترہہ وُوہر ووت تٔمؠ دیُت تارحؔ ناوٕ کِس فرزنٛدس زایُن۔
\v 25 تارح سٕنٛدِ زیٚنہٕ پتہٕ رود نحورؔ مذید أکِس ہتس تہٕ کُنترٕہَن ورین زندٕ اتھ دوران دِتُن بیٚیہِ تہِ کورین گۅبرن زایُن۔
\v 26 تارحؔ اوس تمہِ وزِ سَتتھ وُوہر ییٚلہِ تمِس ابرامؔ، نحورؔ تہٕ حارانؔ زاے۔
\v 27 تارح سٕنٛدِ نسب نامُک اوحال چُھ یہِ زِ تارح سنٛدؠ اولاد ٲسؠ ابرامؔ، نحورؔ تہٕ حارانؔ۔ حارانؔ سٕنٛدِس نیٚچوِس اوس لوطؔ ناو۔
\v 28 حارانس اوس تمہِ وزِ پنُن مول تارح سٟتؠ ییٚلہِ حاران کلدیونؔ ملکہٕ کِس اُورؔ شہرس منٛز مود۔ یہِ چھےٚ سۅ سرِزمین یتہِ سُہ زامُت اوس۔
\v 29 تہٕ ابرامنؔ تہٕ نحورنؔ کوٚر نیتھٕر۔ ابرامؔ سنٛزِ خاندارنہِ اوس ساریؔ ناو تہٕ نحورؔ سنٛزِ خاندارنہِ ملکہ۔ ملکہ تہٕ تمؠ سنٛز بیٚنہِ اسکہؔ آسہ حارانؔ سنٛزٕ کورِ۔
\v 30 ساریؔ ٲس ہانٛٹھ یمِس نہٕ کانٛہہ اولاد اوس۔
\v 31 تارح ہَن کوٚر فٲصلہٕ اُورؔ شہرٕ منٛزٕ نیرُن تہٕ کنعان ملکس منٛز بسُن۔ لہٰذا تُلؠ تٔمؠ پنُن نیٚچو ابرہامؔ تہٕ پنُن زُر حارانؔ سُنٛد نیٚچو لوط تہٕ ابرامؔ سنٛز زنانہٕ ساریؔ پانس سٟتؠ۔ مگر تمہِ تروو کنعان بجایہ حاران شہرسےٕ منٛز ڈیرٕ تہٕ بسییہِ تٔتؠ۔
\v 32 تارحؔ ہَن کوٚر زٕ ہتھ تہٕ پانٛژھ ؤرشہِ وٲنٛسہِ پٮ۪ٹھ حارانَسؔ منٛز انتقال۔
\c 12
\p
\v 1 پتہٕ وُن یہُوواہنؔ ابرامسؔ، "یتہِ ژٕ وُنہِ کیٚن روزان چُھکھ امہِ ملکہٕ منٛزٕ نیر ژٕ پنُن مٲلؠ قبیلہٕ تہٕ تمہِ سُنٛد خاندان أتی ترٲوِتھ تہٕ گژھ تتھ ملکس منٛز یُس بہٕ ژےٚ ہاوے۔
\v 2 چٲنیٚن شُرین ہُنٛد بناوٕ بہٕ اکھ بوٚڈ قوم۔ بہٕ کرے ژےٚ تیژ برکتھ تہٕ دِمے پوٗرٕ شوٚہرتھ۔ یہِ بہٕ چانہِ باپتھ کران چُھس تہِ بنہِ باقین ہنٛدِ باپتھ برکتھُک بٲعث۔
\v 3 یم ژےٚ سٟتؠ رٕژر کرن بہٕ ورتاوٕ تِمن سٟتؠ رُت۔ تہٕ یُس ژےٚ سٟتؠ بُرٲیی ورتاوِ تمِس والہٕ بہٕ لعنت۔ چانہٕ وساطتہٕ کرٕ بہٕ زمینہٕ پٮ۪ٹھ روزن والیٚن سارنی قبیلن برکتھ۔
\v 4 لہٰذا تروو ابرامنؔ حارانؔ، یہِ زن یہُوواہؔ ہن أمِس کرُن ووٚن۔ ابرہامؔ سنٛز عمر ٲس پنٛژستتھ ؤری ییٚلہ سُہ پنُن تہٕ لوطؔ سُنٛد خاندان أتی ترٲوِتھ دراو۔
\v 5 ابرامنؔ تُج پنٕنؠ خاندارنؠ ساریؔ تہٕ پنُن بابتھٕر لوط سٟتؠ۔ تٔمؠ تُل پنُن سورےٕ مال تہٕ غلام پانس سٟتؠ یُس تِمو حارانس منٛز جمع کوٚرمُت اوس۔ اتہِ نیرتھ دراو سُہ کنعان چہِ سرِزمینہِ کُن۔
\v 6 کنعان وٲتِتھ ووت ابرامؔ سِکم علاقس منٛز یتہِ تٔمؠ مورا ناوٕ کِس أکِس بٔڈس کُلِس تل ڈیرٕ تروو۔ یمہِ وزِ یہِ سَپُد تمہِ وزِ ٲسؠ تتہِ کنعانٕکؠ لوٗکھ بسان۔
\v 7 پتہٕ سپُد یہُوواہؔ اتہِ ظٲہر تہٕ ونُن ابرامسؔ، "بہٕ دمہٕ یہِ ملک چانہِ قبیلچہِ زُریٲژ۔ پتہٕ بنٲو ابرامنؔ اکھ قربان گاہ تاکہِ یہُوواہسؔ ییہِ قربٲنی پیش کرنہٕ۔ یہِ زن تمِس پٮ۪ٹھ ظٲہر سپُدمُت اوس۔
\v 8 سِکم پٮ۪ٹھٕ کوٚر ابرامنؔ تہٕ تمسنٛدؠ خاندانن بیت ایلؔ کِس مشرِکس کُن پہاڑن ہُنٛد سفر۔ یتِتھ تِمو پنُن ڈھیرٕ دیُت بیت ایلؔ اوس تتھ مغرب انٛدٕ تہٕ مشرقہٕ انٛدٕ اوسس عیؔ۔ اتہِ تہِ بنٲو یمو اکھ قربان گاہ یتہِ تِمو قربٲنیہِ کرِ تہٕ یہُوواہؔ سنٛز عبادت کٔر۔
\v 9 پتہٕ دراو ابرامؔ اتہِ تہِ کوٚرکھ نیگیو صحراوس کُن سفر شروع۔
\v 10 اتھ ملکس منٛز اوس قحط چلان لہٰذا پٔکؠ ابرامؔ برونٛہہ تاکہِ مِصر ملکس منٛز دِہن کینٛہہ کال پڑاو۔ تکیازِ یتھ ملکس منٛز تم ٲسؠ تتہِ ٲس خۅراکٕچ واریاہ کمی۔
\v 11 ییٚلہِ تم ملکہ مِصرس نزدیک واتنہِ لٔگؠ تہٕ ابرامنؔ ووٚن پننہِ خاندارنہِ ساریؔ، بوز! بہٕ چُھس زانان زِ ژٕ چھیٚکھ اکھ خوبصورت خوتون۔
\v 12 ییٚلہِ مِصرٕکؠ لوٗکھ ژےٚ وُچھنے، تِم ونن، یہِ زٔنؠ چھا أمِس خاندارِنؠ تہٕ تم مارن مےٚ، مگر ژےٚ مارنے نہٕ۔
\v 13 لہٰذا چُھسے بہٕ ژےٚ ونان زِ ژٕ ؤنؠ تمن بہٕ چھیٚس أمِس بیٚنہِ، تاکہِ بہٕ بچہٕ تہٕ میانؠ زنٛدگی روزِ چانہِ سببہٕ محفوظ۔"
\v 14 تہٕ پتہٕ سپُد یتھ کٔنؠ زِ یتھےٕ تِم مِصر وٲتؠ تہٕ مِصرِیو وُچھ ابرامؔ سنٛز خاندارنؠ یۅسہ پٔزؠ کِنؠ سیٹھہےٕ خوبصورت ٲس۔
\v 15 ییٚلہِ فرعون سنٛدیو عہدٕدارو سۅ وُچھ تِمو ووٚن بادشاہس تمؠ سنٛزِ خوبصورتی مُتعلق۔ بادشاہن اننٲو سۅ پانس نِشہ۔
\v 16 بادشاہ سپُد ساریؔ ہنٛدِ سببہٕ ابرامسؔ پٮ۪ٹھ سیٹھاہ مہربان۔ تٔمؠ دِتؠ تمِس تیر، ژھاوٕلؠ، گاو، خر، نوکر چاکر تہٕ اونٹ۔
\v 17 مگر بادشاہن نیٚیہ ابرامٕنؔؠ خاندارنؠ ساریؔ، لہٰذا کٔرؠ یہُوواہؔ ہن بادشاہ تہٕ تمسنٛدؠ باقی گرٕ بٲژ ووکھٕ دادیٚن منٛز مُبتلا۔
\v 18 پتہٕ اوٚن بادشاہن ابرامؔ بُلاوِتھ تہٕ وُننَس، "ژےٚ کۅرتھ مےٚ سٟتؠ سیٹھاہ بُرٕ ورتاو۔ ژےٚ کیازِ ونُتھ نہٕ مےٚ زِ یہِ چھےٚ میانؠ خاندارِنؠ۔
\v 19 ژےٚ کیازِ ونُتھ، یہِ چھےٚ مےٚ بیٚنہِ تہٕ مےٚ بنٲو سۅ پنٕنؠ خاندارِنؠ۔ ژےٚ پٔزہی نہٕ یہِ کرُن! وُتھ نِن پنٕنؠ خاندارنؠ تہٕ نیر یتہِ۔
\v 20 بادشاہن دیُت پننٮ۪ن عہدٕدارن حکم زِ ابرہامؔ تمؠ سنٛز خاندارِنؠ تہٕ باقی سورےٕ مالہٕ جاداد ہیٚتھ کٔڈوون سُہ مِصرٕ منٛزٕ نیٚبر۔
\c 13
\p
\v 1 مِصرٕ منٛزٕ نیرتھ دراے ابرامؔ تہٕ ساریؔ یہُوداؔ کیٚن بیابانَن کُن واپس۔ تِمو تُل پنُن سورےٕ مال، تہٕ لوط تہِ دراو تِمن سٟتؠ۔
\v 2 ابرامؔ اوس آسن وول۔ تمِس ٲسؠ واریاہ چو چاروٲے، سۅن تہٕ رۅف۔
\v 3 تِمو تھوو اکہٕ جایہ پٮ۪ٹھٕ بیٚیس جایہ تام سفر جٲری۔ جنوبی یہُودیہ پٮ۪ٹھٕ بیت ایلؔ تہٕ بیت ایلؔ پٮ۪ٹھ عیؔ یس منٛزباغ دِتؠ تِمو گۅدٕ پنٕنؠ خٲمہٕ۔
\v 4 یہِ ٲس سۅ جاے یتہِ ابرامنؔ قربان گاہ بنٲومٕژ ٲس؛ یتہِ تٔمؠ بیٚیہِ یہُوواہؔ سنٛز عبادت کرٕنؠ لٲج۔
\v 5 لوط، یُس ابرامسؔ سٟتؠ سفر کران اوس، تمِس تہِ ٲسؠ تیر، ژھاوٕلؠ کھیٚلؠ تہٕ خٟمہٕ۔
\v 6 یمن دوٚنونی تیتؠ بٔڈؠ جَب یم نہٕ اکسےٕ جایہِ ویٚپِتھ ہیٚکہٕ ہَن۔ اتہِ ٲس نہٕ تیژ جاے یتہِ چارواین منٲسب کھیٚن چیٚن میلِتھ ہیٚکہِ ہے۔
\v 7 بیٚیہِ سپُد یتہِ زِ ابرامؔ سنٛدیو جَب رچھن والیٚو موہنیو تہٕ لوطؔ سنٛدیو موہنیو لٲج پانہٕ وٲنؠ ہَر کرٕنؠ۔ کنعانؔ تہٕ فِرزی سنٛدؠ اولاد تہِ ٲسؠ أتھؠ علاقس منٛز روزان۔
\v 8 پتہٕ ووٚن ابرامنؔ لوطسؔ، "چونکہِ أسؠ چھِ پانہٕ وٲنؠ قریبی ٲشناو، یہِ چُھنہٕ سانہِ خٲطرٕ جان زِ أسؠ ہیٚمو لڑٲے یا چٲنؠ مُوہنی یم چانیٚن چاروین رٲچھ چھِ، کیاہ ہیٚن تِمن موہنیٚن سٟتؠ جنٛگ یم میانؠ چاروٲے رچھان چھِ۔
\v 9 یتہِ چھےٚ اسہِ دوٚنون خٲطرٕ کافی جاے۔ لہٰذا پزِ اسہِ الگ الگ روزُن۔ ژےٚ یُس انٛد خوش چھی سُہ رٹھ تہٕ۔ اگر ژٕ ہُہ علاقہٕ رٹکھ بہٕ روزٕ تیٚلہِ یتی، اگر ژٕ یوہے انٛد رٹکھ تیٚلہِ گژھِ بہٕ ہُتھ انٛدس۔
\v 10 لوطنؔ کٔر ضُعرؔ علاقس کُن نظر تہٕ وچُھن یردن درؠ یاوس نکھٕ مٲدانَس نِشہ کٲفی آب۔ یہِ چُھ برونٛہہ سپُدمُت زِ یہُوواہؔ ہن چھِ سدومؔ تہٕ عمورہؔ تباہ کٔرمٕتؠ یم اتھ مٲدانس نِش ٲسؠ۔ تمہِ دوٚہہ اوس یہِ زنتہٕ یہُوواہؔ سُنٛد باغ، یتھ کٔنؠ زَن مِصرس منٛز نیٖل درؠ یاوس نِشہ زمین چھےٚ۔
\v 11 لہٰذا ژٲر لوطن دٔرؠ یایہِ یردن کِس مٲدانس نِشہ پننہِ باپتھ جاے۔ تٔمؠ تروو پنُن پِتٕر ابرامؔ أتی تہٕ دراو مشرقس کُن
\v 12 ابرامؔ بیوٹھ کنعانَس منٛز تہٕ لوطؔ گو درؠ یایہِ یردن کیٚن مٲدانَن منٛز شہری علاقن نزدیک، تٔمؠ دِتؠ سدومؔ جایہ نِش پنٕنؠ خٟمہٕ۔
\v 13 وُنؠ لٲگؠ تِمو بُرٕ لوکو یم سدومَس منٛز روزان ٲسؠ یہُوواہسؔ خلاف بُرٲییہِ کٔرتھ گناہ کرٕنؠ۔
\v 14 ابرامؔ تہٕ لوط سٕنٛدِ الگ نیرنہٕ پتہٕ ووٚن یہُوواہنؔ ابرامسؔ، "یتھ علاقس منٛز ژٕ چُھکھ یہِ وچُھن وارٕ، ژۅپٲرؠ دِس نظر۔
\v 15 بہٕ دِمے ژےٚ تہٕ چانین شُریٚن یہ سٲرےٕ زمین یۅسہ ژٕ وُچھان چُھکھ۔ بہٕ کرٕ یہِ ہمیشہٕ خٲطرٕ تُہنٛدِ ناوٕ۔
\v 16 بہٕ بڑاون تُہنٛز ذریاتھ لژھِ ہنٛدؠ پٲٹھؠ۔ اگر کانٛہہ شخص لژھِ ہنٛدؠ زرٕ گنٛزراونٕچ کوشش کرِ زانُن گژھِ زِ تٔمؠ کٔر تُہنٛز ذریاتھ گنٛزراونٕچ کوشش
\v 17 پرٮ۪تھ کُنہِ انٛدٕ پھیر اتھ زمینس تکیازِ بہٕ چُھسے یہِ سٲرےٕ ژےٚ دِنہٕ وول۔
\v 18 پتہٕ مُژرٲوؠ ابرامنؔ پنٕنؠ خٟمہٕ تہٕ دراو حبرون کُن تہٕ بسیاو ممرےؔ کیٚن بڈیٚن کُلیٚن نشہٕ۔ تتہِ بنٲو تٔمؠ کنین ہنٛز اکھ قربان گاہ یُتھ سُہ یہُوواہؔ سٕنٛدِ ناوٕ قربٲنیہِ پیش کرِ۔
\c 14
\p
\v 1 تتہِ ٲسؠ ژور متحد بادشاہ۔ یمن منٛز بابلُک بادشاہ امرافیلؔ، الاسرُکؔ بادشاہ اریوکؔ، عیلامُک بادشاہ کدرلاعمر تہٕ جوئیمُک بادشاہ تدعال اوس۔
\v 2 تِمو کٔر پانٛژن بادشاہن پٮ۪ٹھ حملہٕ کرنٕچ سٲزِش: سدومؔ کِس بادشاہ برَعؔ، عمورہ کِس بادشاہ بِرشعؔ، آدمؔ کِس بادشاہ سنیابؔ، زبوئیم کِس بادشاہ شمیبرؔ تہٕ بالعؔ یعنی ضُعرؔ بادشاہس سٟتؠ۔
\v 3 تم پانٛژوے بادشاہ تہٕ تِہُنٛد فوج گو یمن ژوٚن بادشاہن تہٕ تہنٛدِس فوجس سٟتؠ جنٛگ کرنہٕ باپتھ سدیم وادی منٛز جمع یتھ بحیرے مردار وادی تہِ وننہٕ چُھ یوان۔
\v 4 کدرلاعمر بادشاہن کٔر تِمن پٮ۪ٹھ بہن ورؠ ین حکومَتھ۔ مگر تُروٲہمہِ ورؠ یہِ کٔر تِمو چیڈور لاومر بادشاہس خلاف بغاوت تہٕ تمِس کُن مذید چنٛدٕ دِنَس کوٚرکھ اِنکار۔
\v 5 بیٚکہ وریہ لٔگؠ کدرلاعمرؔ بادشاہ تہٕ دویم بادشاہ یم تس سٟتؠ ٲسؠ پنُن فوج جمع کٔرتھ پانٛژن بادشاہن ہنٛدس علاقس کُن ینہِ۔ تِمو دِیُت عستاراتؔ کرنائمَس منٛز رفایم لوٗکن، ہامَسؔ منٛز زُوزیؔ لوٗکن، تہٕ سوِی قریتؔ یمَسؔ منٛز ایمی لوٗکن شِکس۔
\v 6 تِمو کٔر حوریؔ لوٗکن پننِس پہٲڑی علاقہٕ شعیرَسؔ منٛز صحراہَس نکھٕ ال پارانَس تانؠ لار۔
\v 7 تورٕ واپس پھیرتھ گے تِم عین مصفاتؔ، یتھ وۅنؠ قادِس ونان چھِ۔ تِمو کوٚر عمالیقیؔ تہٕ اموریؔ لوٗکن ہنٛدس سٲرسےٕ زمینس پٮ۪ٹھ قبصہٕ یم حصیصون تمرؔ جایہ روزان ٲسؠ۔
\v 8 پتہٕ دراے سدومؔ، عمورہؔ آدمؔ، زبوئیم تہٕ بالعؔ بادشاہ تہٕ لٔگؠ سدیم وادی منٛز ژوٚنوٕنی بادشاہن ہنٛدس فوجس سٟتؠ لڑنہِ۔
\v 9 تِمو لوٚڈ عیلام کِس بادشاہ کدرلاعمر، جوئیم کِس بادشاہ تدعال، سنعار کِس بادشاہ امرافیلؔ تہٕ الاسرؔ کِس بادشاہ اریوکس سٟتؠ۔ ژورن بادشاہن ہُنٛد فوج اوس پانٛژن بادشاہن ہنٛدس فوجَس سٟتؠ لڑان۔
\v 10 سدیمؔ وادی ہنٛزِ تارکول سڑک ٲس دۅبو سٟتؠ بٔرِتھ۔ ییٚلہِ سدومؔ تہٕ عمورہ کیٚن بادشاہن ہنٛدؠ فوجی ژلنہِ لٔگؠ واریاہ نفر گے یمن دۅبن منٛز۔ باقی یم بچاے تم ژٔلؠ پہاڑن کُن۔
\v 11 ییٚلہِ تِم ژٔلؠ تہِ تہنٛدیو دُشمنو وُٹ سدومؔ تہٕ عمورہؔ سُنٛد سورےٕ مالہٕ جائیداد تہٕ کھیٚن چیٚنٕکؠ چیز تہِ۔
\v 12 تِمو نیٚو ابرامؔ سُنٛد باپتھٕر لوط تہٕ تمسُنٛد مال تہِ تکیازِ سُہ اوس تمہِ وزِ سدومَس منٛز روزان۔
\v 13‏-14 ابرامؔ اوس تمہِ وزِ تِمن بڈین کُلین نِش بسان یمہٕ ممرےؔ سنٛدؠ ٲسؠ، ممرےؔ ٲسؠ امورؔ سٕنٛدِس قبیلس سٟتؠ تعلق تھاوان۔ ابرامنؔ کوٚر ممرےؔ تہٕ تمسنٛدین دوٚن باین اسکالؔ تہٕ عانیرؔس سٟتؠ اکھ مہادٕ زِ اگر جنگ سپُد تہٕ تِم کرن اکھ أکِس مدد۔ جنگہٕ پٮ۪ٹھٕ ژٔلِتھ آمٕتؠ اکؠ نفرن وُن عِبرٲنؠ ابرامسؔ زِ کیاہ سپُد، تہٕ دشمنو نیٚو تمسُنٛد باپتھر لوٗط اغوا کٔرتھ۔ ابرامنؔ أنؠ 318 نفر یم تسنٛدؠ خدمتگار ٲسؠ ناد دتھ، تم نفر یم ابرامسؔ لۅکہ چارکؠ سٲتھی ٲسؠ تہٕ زانان ٲسؠ زِ جنٛگس منٛز کِتھ کٔنؠ چُھ لڑُن۔ تِم سٲری سپٕدؠ جمع تہٕ کھٲلِکھ دان شہرس تام پنٕنؠ دشمن پتھ۔
\v 15 راتس دوران کٔرؠ ابرامنؔ پنٕنؠ نفر بیٚون بیٚون جمٲژن منٛز تقسیم تہٕ تِمو دیُت پننٮ۪ن دشمنن واریہو انٛدو حملہٕ کٔرتھ شِکس۔ تِمو کٔر تِمن دمشق شہرٕ کہ شمٲلی انٛدٕ خوبہ ہَس تام لار۔
\v 16 ابرامؔ سنٛدیو نفرو اوٚن سُہ سورےٕ سامانہٕ واپس یُس نِمُت اوسہَکھ۔ تِمو بچوو لوطؔ تہٕ تمسُنٛد سورےٕ مال و اسباب تہٕ تمہٕ مستوراتہٕ تہٕ باقی لوٗکھ تہِ یم تہنٛدیو دشمنو نمٕتؠ ٲسؠ۔
\v 17 ییٚلہِ ابرامؔ تہٕ تمسنٛدؠ نفر کدرلاعمر بادشاہ سٕنٛدِس فوجس شکس دِتھ واپس گرٕ آے تہٕ سدومُک بادشاہ آو شمالہٕ کِنؠ سوِی وادی منٛز تمِس سمکھنہِ، یَتھ لوٗکھ بادشاہ وادی تہِ ونان ٲسؠ۔
\v 18 سالِم شہرُک بادشاہ ملک صدقؔ یُس پانہٕ تہِ اکھ بزرگ تہٕ معتبر کاہن اوس أنؠ ابرامسؔ کِژ ژۅٹ تہٕ بیٚیہِ مےَ۔
\v 19 پتہٕ کوٚر تٔمؠ ابرامسؔ دُعا تہٕ وننَس، "مےٚ موٚنگ تُہنٛدِ خٲطرٕ برتر تہٕ اعلیٰ خدایس، یمؠ آسمان تہٕ زمین پٲدٕکٔرؠ زِ ژےٚ دی نےَ برکتھ۔
\v 20 بہٕ چُھس خدایس کُن شُکر کران یمؠ توٚہہِ پننؠن دشمنن پٮ۪ٹھ شِکس دِنٕچ تہٕ فتح لبنٕچ قوت دِژ۔" پتہٕ دیُت ابرامنؔ ملک صدقسؔ تِمن سارنی چیزن ہُنٛد دٔہم حصہٕ یم تٔمؠ حٲصِل ٲسؠ کٔرمٕتؠ۔
\v 21 سدومٕکؠ بادشاہن ووٚن ابرامسؔ، "ژٕ ہیککھ تِم سٲری چیز پانس نِشہ تھٲوِتھ یم توٚہہِ حٲصل کٔریٚو مےٚ دِیو صرف تم نفر پانس سٟتؠ ننہٕ یمہٕ توٚہہِ میانہِ شہرٕکؠ رٔٹِتھ أنووکھ۔
\v 22 مگر ابرامنؔ ووٚن سدومؔ کِس بادشاہس، "مےٚ چُھ خداوند یہُوواہؔ ہس سٟتؠ وعدہ کوٚرمُت یمؠ آسمان تہٕ زمین پٲدٕ کٔرؠ۔
\v 23 زِ بہٕ نمہٕ نہٕ کُنہٕ چیزٕ منٛزٕ پنٛداو یا کھۅبانُک فیتہٕ تہِ یُس چون آسہ۔ امیٚک نتیجہِ نیرٕ یہِ زِ ژٕ ہیٚککھ نہٕ زانٛہہ تہِ ؤنِتھ مےٚ بنوو ابرامؔ امیر۔
\v 24 بہٕ کرٕ صرف اکھ چیز قبول، سُہ گو کھیٚن یُس میانؠ نفر کھیٚوان چھِ۔ مگر عانیرؔ، اسکالؔ، تہٕ ممرےؔ رودؠ مےٚ سٟتؠ سٟتؠ تہٕ لوٚڈُکھ تہِ۔ امہِ موٚکھٕ دِیو تِمن امہِ مالہٕ منٛزٕ حصہٕ یُس اسہِ تورٕ واپس اوٚن۔
\c 15
\p
\v 1 کینٛہہ کٲلؠ پتہٕ، وُچھ ابرامنؔ خاب یتھ منٛز تمِس سٟتؠ یہُوواہنؔ کتھ کٔر تہٕ وُننَس، "ژمہٕ کھۅژ کُنہِ چیزس۔ بہٕ کرٕ چٲنؠ حفاظت تہٕ بیٚیہِ دِمے بوٚڈ انعام۔"
\v 2 ابرامنؔ دِتُس جواب، "خداوند یہُوواہؔ، ژٕ کتہٕ ہیککھ مےٚ تہِ دِتھ یہِ بہٕ پزی یژھان چُھس، تکیازِ مےٚ چُھنہٕ کانٛہہ اولاد، تہٕ یُس میانہِ سارے وراثتُک وٲرث بنہِ سُہ چُھ دِمشقُک میٚون خٲدم الِیعزرؔ۔"
\v 3 ابرامنؔ ووٚن یتہِ، ژےٚ کۅرتھ نہٕ مےٚ کانٛہہ اولاد عطا، یمہِ کِنؠ میانہِ گرُک اکھ خٲدم میانؠ سٲرےٕ وراثت رٹہِ۔"
\v 4 خداوند یہُوواہنؔ دِتُس جواب، "نَہ! تہِ سپدیٚنہٕ سُہ ہیٚکنہٕ تمیُک وٲرث بٔنتھ۔ بلکہ آسہ تمیُک وٲرث سُہ یمسنٛد پانہٕ ژٕ مول آسکھ، یُس چٲنِس پرٛتھ چیزس وٲرث آسہ۔
\v 5 پتہٕ کۅڈ یہُوواہنؔ ابرامؔ پننہِ خٟمہ منٛزٕ نیٚبر تہٕ وُننَس، "وُچھ آسمانس کُن! کیاہ ژٕ ہیٚکہٕ کھا یم تارک گنٛزرٲوِتھ؟ نہ، ژٕ ہیٚککھ نہٕ یمن گرینٛد کٔرِتھ۔ تکیازِ یم چھِ واریاہ۔ یتھے کِنؠ آسن چٲنؠ اولاد تہِ تارکن ہنٛدؠ پٲٹھؠ بے شمار۔
\v 6 ابرامسؔ ٲس اتھ کتھِ پٮ۪ٹھ پژھ زِ یہِ یہُوواہنؔ وُن تہِ بنہِ۔ یہِ یمہِ کِنؠ زِ یہُوواہنؔ زون سُہ بہتر۔
\v 7 یہُوواہنؔ وُن تمِس یتہِ زِ بہٕ چُھس یہُوواہؔ۔ بہٕ چُھس سُے یمؠ ژٕ کلدیہؔ ملکہ کہِ اُورؔ منٛزٕ کٔڈتھ انُکھ تہٕ یور واتنووُکھ۔ تاکہِ یمہِ زمینہِ ہُنٛد بناوتھ وٲرث۔"
\v 8 مگر ابرامنؔ ونُس در جواب، "خداوند یہُوواہؔ، بہٕ کتھٕ کِنؠ کرٕ یقین زِ یہِ زمین آسہ میانؠ؟"
\v 9 خداین وُن تمِس، نیر اکھ انُن ترُووہہ ؤرِش ہکھٕر، بیٚیہِ انُن ترُووہہ ؤرِش ژھاوج تہٕ اکھ کُکِل تہٕ بیٚیہِ کوتُر واتناوکھ مےٚ نِش۔
\v 10 تہٕ ابرامنؔ أنؠ یم سٲری تہٕ مٲرِن۔ پرٮ۪تھ کٲنٛسہٕ جانور سُنٛد نیصف نِکرووُن، تہٕ تھووُن سٟتؠ سٟتؠ شیرِتھ۔ مگر کُکلہِ تہٕ کوترَس کٔرِن نَہ زٕ حصہٕ۔
\v 11 تم جاناوار یم مُمٕتؠ جانور کھیٚوان چھِ ؤتھؠ لاشن کھیٚنہٕ خٲطرٕ مگر ابرامنؔ ژٔلرٲوؠ تِم۔
\v 12 ییٚلہِ دوٚہہ لوسُن ہیٚوتُن ابرامسؔ پیٚیہِ مٔژ نینٛدر تہٕ اچانک سپُد انہِ گۅٹ تہٕ تس انٛدؠ پٔکؠ سٲری چیز گے ہٲبتناک۔
\v 13 تہٕ خداوند یہُوواہنؔ وُن ابرامسؔ، بہٕ چُھس توٚہؠ زٲنؠ راوُن یژھان زٕ تُہنٛدؠ اولاد گژھن تتھ ملکس منٛز پردیسی بنِتھ روزنہِ یُس نہٕ تِمن پنُن آسہ، یتہ تِم تتہِ کیٚن بسکین دارن ہنٛز غلامی کرن۔ تہٕ تم زمیندار کرَن تمن پٮ۪ٹھ ژورن ساسن ورؠ ین ظلُم۔
\v 14 مگر پتہٕ دمہٕ بہٕ تمہِ ملکہٕ کیٚن لوٗکن سزا، یتہِ تم غلام آسن۔ ادٕ نیرن چٲنؠ اولاد تمہ ملکہٕ منٛزٕ سیٹھاہ مالہٕ جاداد ہیٛتھ۔
\v 15 پتھ رودیٚو توٚہؠ، توٚہؠ گُزریٚو سیٹھاہ آسٲیشہٕ سان۔ ییٚلہ توٚہؠ واریاہ بزرگ ٲسِو تہٕ یِیو دفناونہٕ۔
\v 16 تہٕ تُہنٛدؠ اولاد یِن ژورن ہتَن ورؠ ین ہنٛزِ غلامی پتہٕ یور واپس، تم کرَن یتھ زمینس پٮ۪ٹھ امورؔ لوٗکن شِکس دِتھ قبضہٕ۔ تۅتام ہیٚکہ نہٕ یہِ سپدِتھ۔ تکیازِ امورؔ لوٗکن چُھنہٕ وُنہ تیتؠ گناہ غٲلِب گٔمتؠ زِ بہٕ دمہٕ تِمن یُتھ سزا۔
\v 17 ییٚلہ دوٚہہ لوس تہٕ تٲریکی سپٕز سوکھٕ موٚکھٕ گو یہِ امید آسنہٕ بغٲرے دزوُن ژونٛگ تہٕ اکھ کتریٚو بانہٕ یتھ منٛز ژِنہ وُہان آسہ ظٲہِر تہٕ وٲتؠ جانورن ہنٛدس نیصف حصس نشہٕ۔
\v 18 امی دوٚہہ کوٚر خداوند یہُوواہنؔ ابرامسؔ سٟتؠ وعدہ۔ یہُوواہنؔ وُن تمِس، بہٕ دمہٕ چانیٚن اولادن سۅ سٲری زمین یۅسہ درؠ یاون درمیان مِصرٕکہ مشرقی سرحدٕ پٮ۪ٹھٕ درؠ یایہ فراتؔ کِس شمالی علاقس تام چھےٚ۔
\v 19 یہِ چھےٚ سۅ زمین یتہ قینیَن، قنزیؔ ین، قدمُونؠ،
\v 20 حِتی، فِرزی، رفایم،
\v 21 اموریؔ، کنعان، جِرجاسؠ تہٕ یبوسٕکؠ لوٗکھ روزان چھِ۔
\c 16
\p
\v 1 اتھ وقتس تام دیُت نہٕ ابرامؔ سنٛزِ خاندارنہِ ساریؔ ابرامؔ سٕنٛدِ باپتھ کٲنسہِ تہِ اولادس زایُن۔ مگر تمِس نشہٕ ٲس اکھ مِصری لونٛڈی، یمِس حاجرہ ناو اوس۔
\v 2 تہٕ ساریؔ وُن ابرامسؔ، "میانؠ کتھ بوز! یہُوواہنؔ دیُت نہٕ مےٚ حٲملہٕ روزنُک اجازت۔ لہٰذا شونٛگ ژٕ میانہِ لونٛڈی حاجرہ ہَس نِش تاکہِ تمِس زیوِ کانٛہہ اولاد یُس أسؠ پنُن گنٛزراوون، ابرامنؔ کوٚر سارایہؔ ہنٛزٕ اتھ کتھِ سٟتؠ اتفاق۔
\v 3 یہِ سپُد ابرامؔ تہٕ سارایہ ہنٛدِ کنعانس منٛز روزنہٕ پتہٕ دہہ ؤہرؠ۔ یتھ کِنؠ بنٲو ابرامنؔ ساریؔ ہنٛز مِصرٕچ لونٛڈی پنٕنؠ دویم خاندارِنؠ
\v 4 سُہ سپُد حاجرہ ہَس سٟتؠ ہم بستر تہٕ سۅ روز بیٚیہِ زُووٕ۔ یتھے یہِ پے لوٚگ زِ سۅ چھےٚ بیٚیہِ حسابہٕ۔ تمہِ لٲج پنٕنؠ مٲلکٲنؠ سارہؔ کم پایہ زانٕنؠ۔
\v 5 پتہٕ وُن ساریؔ ابرامسؔ، "یہِ چھےٚ چٲنؠ غلطی! مےٚ کرے ژےٚ پنٕنؠ خٲدم حوالہٕ تاکہِ ژٕ شونٛگکھ تس نِشہ۔ وۅنؠ سپٕز سۅ آوارٕ تہٕ اوے لٔج سۅ مےٚ کم پایہ زاننہِ۔ تکیازِ مےٚ چُھنہٕ کانٛہہ اولادےٕ۔ خداوند یہُوواہؔ زٲنی ژےٚ قصور وار مےٚ سٟتؠ یہِ ورتاونہٕ باپتھ۔
\v 6 ابرامنؔ وُن ساریؔ، "میانؠ کتھ بوز! سۅ چھےٚ ژےٚ داے، یُس سلوک ژٕ منٲسب بٲسی سُہ ہیککھ ژٕ تمِس سٟتؠ کٔرتھ۔" پتہٕ لٲج سارایہ تمِس سٟتؠ بدسلوکی کرٕنؠ تہٕ حاجرہؔ ژٔج۔
\v 7 ییٚلہ سۅ بیابانن منٛز وٲژ أکِس ناگہٕ پُکھرِ نِش آو تس خداوند سُنٛد فرشتہٕ برونٛہہ کُن۔ یہِ چُھ سُہ ناگ یُس شور ناوچہِ وتہِ منٛز اوس۔
\v 8 تٔمؠ وُن تس، "اے حاجرہ، مٲلکٲنؠ سارہؔ ہنٛزِ دٲے، ژٕ کتہِ آیکھ تہٕ کوٚت گژھکھ؟ تمہِ ونُس جواب، "بہٕ آیس پننہِ ملکانہِ سارایہ نِش ژٔلِتھ۔"
\v 9 یہُوواہؔ سنٛدؠ فرشتن ونُس، "ژٕ گژھِ پننہِ مٲلکانہِ نشہٕ واپس تہٕ روز تمسنٛز فرمانبردٲری کران۔"
\v 10 تہٕ خداوند سنٛدؠ فرشتن وُن تمِس یتہِ زِ بہٕ دِمے ژےٚ تیتؠ اولاد یمن نہٕ کانٛہہ گرینٛدےٕ کٔرتھ ہیٚکہِ۔
\v 11 فرشتن وُن تمِس، بوز! ژٕ چھیٚکھ بیٚیہِ زُووٕ۔ ژےٚ زیٚوی اکھ لڑکہٕ یمِس ژےٚ اسماعیل ناو پیی تھاوُن، یمیُک مطلب یہِ چُھ زِ خدا چُھ بوزن وول۔ تکیازِ یہُوواہنؔ بوز چون ودُن تہٕ ژیونُن چون غم۔
\v 12 مگر چون نیٚچو روزِ جنگلی خرٕ سٕنٛدؠ پٲٹھؠ آزاد۔ سُہ کرِ پرٮ۪تھ کٲنٛسہِ سٟتؠ بغاوتھ تہٕ تمِس روزن سٲری مخالفت کران۔ سُہ ہیٚیہِ پننؠن رشتہٕ دارن نشہٕ تہِ دور۔
\v 13 حاجرہنؔ وُن پانسےٕ کُن، "بہٕ روزٕ زندٕ، حلانکہِ یہُوواہنؔ وُچھس بۅ" اوے دیُت تٔمؠ یہُوواہسؔ آلو، "خدا، سُے یُس مےٚ وُچھان چُھ۔"
\v 14 توے تہِ چھِ اتھ ناگس لوٗکھ "بیر لحی روئی" ونان۔ یمیُک مطلب یہِ گۅ زِ" زندٕ کرُور یُس مےٚ وُچھان چُھ!" یہِ چُھ قادِس تہٕ بیردس درمیان وُنہِ تہِ موجود۔
\v 15 یتھ کٔنؠ دیُت حاجرہَن پتہٕ ابرامؔ سٕنٛدِ خٲطرٕ نیٚچوِس زایُن تہٕ تمِس تھووُن اسماعیل ناو۔
\v 16 تمہِ وزِ اوس ابرامؔ شیٚیہ شیتھ وہُر ییٚلہِ حاجرہَن تمسنٛدس نیٚچوِس اسماعیلسؔ زایُن دیُت۔
\c 17
\p
\v 1 ییٚلہِ ابرامؔ نمنمَتھ وہُر ووت تہٕ یہُوواہؔ سپُد تمِس نِش بیٚیہِ نمودار تہٕ وُننَس، "بہٕ چُھس قدرت وول خدا۔ بہٕ چُھس یژھان زِ ژٕ گُزارکھ پنٕنؠ زندگی تِتھے پٲٹھؠ یتھ کِنؠ بہٕ یژھان چُھس۔ بہٕ چُھس یژھان ژٕ گۅژھکھ نہٕ کانٛہہ غلط کرُن۔
\v 2 بہٕ چُھس توٚہہِ سٟتؠ پنُن کوٚرمُت وعدہ نباوُن یژھان۔ بہٕ کرے ژےٚ واریاہ اولاد عطا۔
\v 3 ابرامنؔ تروو کلہٕ پتھرِس تہٕ دتُن سجدٕ۔ پتہٕ وُن خداین تمِس،
\v 4 "یہِ بوز! یہِ چُھ سُہ وعدہ یُس بہٕ توٚہہِ سٟتؠ کران چُھس: ژٕ بنکھ واریہن لوٗکن ہنٛدین ونٛڈن ہُنٛد مول۔
\v 5 وۅنؠ روزِ نہٕ چون ناو ابرامؔ بلکہ روزِ چون ناو ابرہامؔ، تکیازِ بہٕ بنٲوتھ ژٕ واریاہن لوٗکہٕ جمٲژن ہُنٛد مول۔
\v 6 بہٕ کرٕ توٚہہِ نِش واریاہ زُرؠ پٲدٕ تہٕ بہٕ کرکھ تِمو منٛزٕ مختلف قوم تہٕ بادشاہ۔
\v 7 بہٕ چُھس یہِ وعدہ پانس تہٕ ژےٚ درمیان تہٕ ژےٚ پتہٕ چانیٚن زُریٚن ہنٛزن نسلن سٟتؠ ہمیشہٕ خٲطرٕ کران۔ امہِ وعدہ حسابہٕ کرکھ ژٕ خدا زٲنِتھ میانؠ عبادت تہٕ پٲروی، تہٕ چٲنؠ اولاد تہِ۔
\v 8 بہٕ دمہٕ چانیٚن اولادن کنعان یعنی کنعانُک سورےٕ ملک یتہِ ژٕ وۅنؠ روزان چُھکھ۔ یہِ آسہ تہنٛدِ باپتھ اژھنؠ ملکِیت، تہٕ بہٕ آسہ تِہُنٛد خدا۔"
\v 9 پتہٕ ووٚن خداین ابرہامسؔ، "وُنؠ چھی ژےٚ امہِ عہدُک پنُن حصہٕ ادا کرتھ اتھ پٮ۪ٹھ عمل کرٕنؠ تہٕ چانین شُرین تہٕ شُرین ہنٛدین شُرین تہِ۔
\v 10 یہِ وعدہ چُھ تقاضہٕ کران یُس بہٕ ژےٚ تہٕ چانین تمام زُرین سٟتؠ کران چُھس زِ توٚہہِ منٛزٕ گژھِ پرٮ۪تھ کانٛہہ مرٕد ختنہٕ کرُن۔
\v 11 ختنہٕ کرُن بنہِ یمہِ کتھِ ہنٛز علامت زِ توٚہہِ چُھو یہِ عہد قبوٗل کوٚرمُت یُس بہٕ توٚہہِ سٟتؠ کران چُھس۔
\v 12 توٚہہِ منٛزٕ گژھِ پرٮ۪تھ لڑکہٕ سُنٛد ختنہٕ تمہِ وزِ سپدُن ییٚلہِ سُہ ٲٹھن دوٚہُن ہُنٛد واتہِ، ینہٕ والین تمام شُرین ہُنٛد، یتھ منٛز تُہنٛدؠ گریٚکؠ بچہ، موٚلؠ ہیٚنہٕ آمٕتؠ غلامن ہنٛدؠ بچہ تہٕ غٲر ملکی یَن ہنٛدؠ شُرؠ تہِ یم توٚہہِ سٟتؠ روزان آسن مگر تُہنٛدس گرس سٟتؠ آسیٚکھ نہٕ کانٛہہ تعلُق۔
\v 13 امہِ سٟتؠ پییہِ نہٕ کانٛہہ فرق زِ تہنٛدؠ مٲلؠ آسہٕ نا تُہنٛدِ گرٕکؠ فرد یا زرخریدٕ غلام۔ یمن سارنےٕ گژھِ ختنہٕ سپدُن۔ تُہنٛدس جسمس پٮ۪ٹھ گژھِ یہِ نشانہٕ آسُن زِ توٚہہِ چُھ یہِ لازوال عہد قبول کوٚرمُت۔ یُس بہٕ کران چُھس۔
\v 14 توٚہہِ پزِ پننہِ برادری منٛز سُہ فرد کٔڈتھ ژھنُن یمؠ نہٕ ختنہٕ کوٚرمُت آسہ، تکیازِ سُہ شخص چُھ میانہِ عہدٕچ نافرمٲنی کران۔
\v 15 خداین وُن ابرہامسؔ یتہِ، "یۅتام چانہِ آشنہِ ساریؔ ہُنٛد تعلق چُھ، ژٕ ونکھ نہٕ وُنؠ تس ساریؔ۔ بہٕ بدلاوٕ تمِس تہِ ناو۔ تمِس روزِ وُنؠ سارہؔ ناو۔
\v 16 بہٕ کرٕ تس برکتھ عطا تہٕ سۅ دییہِ یقینن چٲنِس أکِس لٔڑکس زایُن۔ تہٕ بہٕ دمہٕ تس تِژھ برکتھ زِ سۅ ییہِ واریہن قومن ہنٛز جدٕ اجداد گنٛزرنہٕ۔ بادشاہ تہٕ عوٲمی قبیلہٕ آسن تمسنٛدِ سلسلہٕ منٛزٕ۔"
\v 17 ابرہامنؔ تروو خدایس برونٛہہ کنہِ پنُن کلہٕ زمینَس پٮ۪ٹھ۔ مگر پتہٕ ترُوو تٔمؠ اسُن تہٕ لوٚگ پانسےٕ سٟتؠ وننہِ۔ "کیاہ ہتہٕ وُہر انسان ہیٚکیا أکِس لڑکہٕ سُنٛد مول بنِتھ؟ حالانکہ سارہؔ تہِ چھےٚ نمتھ ؤرِش سۅ کتھٕ کِنؠ ہیٚکہِ بچَس زایُن دِتھ؟
\v 18 پتہٕ وُن ابرہامنؔ خدایس، "شاید کرِ اسماعیل تُہنٛز برکتھ حٲصل تہٕ سُے بنہِ میانہِ وراثتُک وٲرث۔"
\v 19 پتہٕ دتُس خداین جواب، نَہ! چٲنؠ آشِنؠ سارہؔ دییہِ تہنٛدس لڑکس زایُن۔ توٚہؠ تھٲیِو تس اسحاق ناو۔ بہٕ کرٕ تس سٟتؠ پنُن عہد قٲیم، یُس تمِس تہٕ تمسنٛدین اولادن سٟتؠ پوشہٕ وُن عہَد روزِ۔
\v 20 یۅتام اسماعیلؔ سُنٛد تعلق چُھ، مےٚ چُھ تٔمسٕنٛدس حقَس منٛز تہِ چون دُعا قبول کوٚرمُت۔ بہٕ کرٕ تمِس برکتھ تاکہٕ تمِس تہِ آسن واریاہ اولاد۔ تمسنٛدیو اولادو منٛزٕ نیرن بہَن قبیلن ہنٛدؠ سردار۔ بہٕ بناون تمؠ سنٛز ذریاتھ اکھ عظیم قوم۔ بوزمُت
\v 21 مگر یہِ چُھ اسحاق یس سٟتؠ بہٕ پنُن عہد قٲیم کرٕ۔ اسحاق، نیٚچو یَس سارہؔ نوِ ورؠ یہِ یمی وقتہٕ زایُن دییہِ،
\v 22 ییٚلہ خداین ابرہامس سٟتؠ کتھ مۅکلٲو کٔرِتھ تہٕ خدا گو تمؠ سنٛزو نظرو نِشہ دوٗر۔
\v 23 امی دوٚہہ نی ابرہامنؔ پنُن نیٚچو اسماعیل تہٕ تمسنٛدؠ گریٚکؠ تمام مرد تہٕ تمن غلامن ہنٛدؠ نیٚچوؠ یم تٔمؠ مٔلؠ ہیتمٕتؠ ٲسؠ تہٕ اوننَکھ ختنہٕ کٔرِتھ۔ تٔمؠ ژٔٹ تمن مسلہٕ رژھا، یتھ کِنؠ تمِس خداین کرُن ونمُت اوس۔
\v 24 ییٚلہِ ابرہامؔ سُنٛد ختنہٕ سپُد تمہِ وزِ ٲسؠ تم نمنمَتھ ؤہرؠ۔
\v 25 تہٕ اسماعیل اوس تُرواہ وُوہر ییٚلہِ تمِس ابرہامنؔ ختنہٕ کوٚر۔
\v 26 امی دوٚہہ سپُد ابرہامؔ تہٕ تمسنٛدس نیٚچوؠ اسماعیل سُنٛد ختنہٕ۔
\v 27 تمسنٛدین تمام گرِکیٚن مردن، یمہٕ تتہِ زامٕتؠ ٲسؠ تہٕ تِمن تہِ یم ابرہامنؔ پردیسی مٔلؠ ٲسؠ ہیٚتمٕتؠ۔ یمن سارنی سپُد ختنہٕ۔
\c 18
\p
\v 1 تمہِ ورؠ یہِ ییٚلہِ اکہ دوٚہہ گرمی ٲس۔ ابرہامسؔ گو خداوند یہُوواہؔ ممرےؔ کِس أکِس بٔڈس کُلس نِش نظرِ۔ ابرہامؔ اوس پننِس خٟمہٕ کِس دروازس پٮ۪ٹھ بہتھ۔
\v 2 ابرہامنؔ یتُھےٕ نظر دِژ، پانس برونٛہہ کنہِ ترٛے نفر کھڑا وُچِھتھ گو تس تٲجُب۔ تمن وُچتھ دوریاو سُہ تِمن سمکھنہٕ خٲطرٕ۔ تٔمؠ تروو تعظیمن پنُن کلہٕ سجدس منٛز۔
\v 3 تٔمؠ وُن تِمو منٛزٕ أکِس، اے خداوند اگر ژٕ مےٚ ناراض چُھکھ ژٕ ٹٔھہر تہٕ أکِس رژھِ یتِنس۔
\v 4 میانین خٲدمن دتہٕ اجازت تمہٕ انہَن آب تہٕ چھلہٕ ہن چٲنؠ کھۅر پتہٕ ترٲے تو یتھ کُلِس تل آرام۔
\v 5 "تکیازِ توٚہؠ چُھو یور مےٚ نِش آمٕتؠ لہٰذا دی تو مےٚ اجازت بہٕ انَہا توٚہہِ کھیٚنہٕ خٲطرٕ کینٛہہ تاکہِ توٚہہ ییہِ نیرنہٕ برونٛہہ ہمتھ۔ تٔمؠ ونُس تورٕ "ٹھیک چُھ، یہِ ژٕ یژھان چُھکھ کرِ تہِ۔"
\v 6 پتہٕ گو ابرہامؔ تیز تیز خٟمس منٛز تہٕ ونُن سارہؔ ہَس، "جلدی ان پننہِ اصل آٹہِ منٛزٕ ٲٹیٚس وُوہہ سیر تہٕ بناو ژۅچہِ!"
\v 7 پانہٕ دوریاو کھیٚلِس نِش تتہِ انُن اکھ وُژھ ژٲرتھ یس سُنٛد ماز لوو تہٕ مزٕدار آسہ، سُہ دتُن پننِس أکِس خٲدمس تٔمؠ مور سُہ جلدی تہٕ نیٚون بُزتھ۔
\v 8 ییٚلہِ ماز تیار گو تہٕ ابرہامنؔ أنؠ لٔسؠ، زامُت دۅد تہٕ سُہ ماز یُس خٲدمن تیار کوٚر تہٕ تھووکھ تس برونٛہہ کنہِ۔ سُہ رود تس برونٛہہ تتھ کُلس نِش کھڑا ییٚلہ سُہ یہِ کھیٚن کھیٚوان اوس۔
\v 9 کھیٚن مۅکلٲوتھ پرُوژھ تٔمؠ أمِس، "چٲنؠ خاندارنؠ سارہؔ کتہِ چھےٚ؟ ابرہامنؔ دِتُس جوابِ "سۅ چھےٚ خٟمس منٛز۔"
\v 10 پتہٕ وُن امہِ جمٲژ ہنٛدؠ زٹھؠ، "بہٕ یمہٕ نوِ وری یہِ بہارس منٛز بیٚیہِ توٚہہِ نِش، بوزیٚو! تُہنٛزِ خاندارنہِ سارہؔ ہَس اولاد عطا سپُدمُت۔" سپُد یتھ کٔنؠ زِ سارہؔ ٲس خٟمہٕ کِس دروازس پٮ۪ٹھ یہِ بوزان، یُس أمِس نفرس پٔتؠ کِنؠ اوس یُس یہِ کتھ ونان اوس۔
\v 11 وُنؠ چھِ ابرہامؔ تہٕ سارہؔ سیٹھاہ بڈٕ گٲمٕتؠ تہٕ سارہؔ ہَس چھےٚ بچہٕ دِنچ وانٛس مۅکلیمٕژ۔
\v 12 سارہؔ ہَس آو پانس پٮ۪ٹھ یہِ بوزِتھ اسُن سونٛچن زِ میون جسم چُھ سوریومُت تہٕ میون خاندار تہِ چُھ بُڈیومُت۔ تہٕ بہٕ کتھ کٔنؠ ہیٚکہٕ بچہ زیٚنٕچ خوشی حٲصل کٔرِتھ؟
\v 13 یہُوواہنؔ ووٚن ابرہامسؔ، "سارہؔ ہَن کیازِ تروو اسُن؟ سۅ کیازِ چھےٚ یہِ سونچان زِ بہٕ چھیٚس بُڈیمٕژ تہٕ مےٚ کتھٕ کٔنؠ ہیٚکہ بچہٕ زیٚتھ؟
\v 14 یہِ چھا میانہِ خٲطرہ کانٛہہ مشکِل کٲم؟ بہٕ یمہٕ نوِ ؤرؠ یہِ بہار کِس موسمس منٛز تمہِ وقتہٕ یُس مےٚ مقرر کوٚر، تہٕ سارہؔ ہَس آسہ اکھ شیر خوار بچہ کھۅنہِ منٛز۔
\v 15 سارہؔ کھوژ یہِ بوزِتھ تہٕ تمہِ وُن ٲکھتی زِ مےٚ اوٚس نہٕ۔ مگر یہُوواہنؔ ونُس "اتھ مٕہ کرِ اِنکار! ژےٚ ترووُتھ اسُن۔"
\v 16 ییٚلہ تم ترےٚ نفر تتہِ نیرنہٕ خٲطرہ ؤتھؠ تِمو کوٚر سدومؔ شہر کُن رۅخ۔ ابرہامؔ وُتھ تمن "رخصتی" دنہٕ باپتھ سٟتؠ۔
\v 17 یہُوواہؔ ہَن وُن پانسےٕ کُن، "میانہ باپتھ چُھنہٕ یہِ ٹھیک زِ بہٕ تھاون ابرہامؔ تمہِ نشہٕ بےخبر یہِ بہٕ کرُن یژھان چُھس۔
\v 18 ابرہامٕنؔؠ اولاد آسن اکہ عظیم تہٕ طاقتور قومٕکؠ فرد۔ تہٕ یہِ کینٛژھا بہٕ تسٕنٛدِ خٲطرہ کران چُھس تمہ کہِ وساطتہٕ کرَن تمام جمٲژن ہنٛدؠ لوٗکھ برکتھ حٲصل۔
\v 19 مےٚ ژور سُہ اوٕ موٚکھٕ تاکہِ سُہ کرٕ پننٮ۪ن شُرین تہٕ تہنٛدین گرٕ والین ہدایت یُتھ تم میانؠ عبادت کٔرتھ تم کامہٕ کرن یم صحی تہٕ منصفانہٕ آسن۔ یُتھ تِم خداوند ابرہامس سٟتؠ تی کرَن یہِ مےٚ تمِس سٟتؠ کرنہٕ خٲطرہ ونمُت چُھ۔
\v 20 پتہٕ وُن یہُوواہنؔ ابرہامسؔ، "مےٚ بوزٕ تِم ہٲبت ناکھ کتھٕ یمہٕ لوٗکھ سدومؔ تہٕ عمورہؔ کیٚن لوٗکن متلِق ونان چھِ۔ تم چھِ بٔڈؠ گناہ گار۔
\v 21 لہٰذا وسہٕ بہٕ تِمن نشہٕ تہٕ وُچھٕ زِ یم یَچھ کتھٕ مےٚ بوزٕ تم چھا صحی کِنہٕ نَہ۔
\v 22 پتہٕ دراے بیٚیہِ زٕ نفر تہٕ لٔگؠ سدومؔ کُن پکنہِ مگر ابرہامؔ رود یہُوواہؔ ہَس برونٛہہ کنہِ کھڑا۔
\v 23 ابرہامؔ آو تمِس نزدیک تہٕ وُننَس، "کیاہ توٚہؠ کٔرووکھا پزی تم لوٗکھ تہٕ بُرباد یمو نہٕ بدکارن سٟتؠ روزِتھ کانٛہہ غلط کوٚر؟
\v 24 اگر شہرس منٛز پنژاہ نفر آسن یمو نہٕ کانٛہہ غلط کوٚرمُت آسہ تہٕ توٚہؠ کیاہ کٔریو؟ کیاہ توٚہؠ کٔرووکھا پزی تِم تباہ تہٕ تِمن پنژہن بےٚقصورن خٲطرٕ کٔڈیو نہٕ بچنٕچ کانٛہہ تہِ وتھ۔ یمو نہٕ کانٛہہ غلطی کٔرمژ آسہ؟
\v 25 یقینَن کرَکھ نہٕ ژٕ تِژھ کٲم یمہِ سٟتؠ بُرٕ لوٗکن سٟتؠ نیک لوٗکھ تہِ مارٕ گژھن۔ نیکن تہٕ بدکار لوٗکن سٟتؠ کٔریو کنُے رٔویہ۔ توٚہؠ ہیٚکیو نہٕ تہِ کٔرِتھ۔ تکیازِ توٚہؠ، یم زمینہِ پٮ۪ٹھ اکھ منصف چھِ کٔریو پزی تی یہِ صدوم کیٚن لوٗکن ہنٛدِ باپتھ منٲسب چُھ۔
\v 26 خداوند یہُوواہنؔ دتُس جواب، "اگر مےٚ سدومؔ شہرس منٛز پنژاہ نفر سمکھن یمو نہٕ کانٛہہ غلطی کرمٕژ آسہ تہٕ بہٕ تراون تہنٛدِ باپتھ سورے علاقہٕ یلہٕ۔"
\v 27 ابرہامنؔ دیُت جواب، "میانہ خداوندٕ! مےٚ پزنہٕ یتھٕ کِنؠ توٚہہ سٟتؠ تھدِ کلام کرُن تکیازِ بہٕ چُھس سوٗرٕ تہٕ لژھِ کھۅتہٕ کمتر۔
\v 28 مگر توٚہؠ کیاہ کٔریو اگر صرف پنٛژتٲجی نفر تم آسن یمو نہٕ کانٛہہ غلطی کرمٕژ آسہ؟ کیاہ توٚہؠ کٔرووکھا شہرس منٛز روزن وٲلؠ سٲری تباہ تکیازِ تتہِ آسن صرف پنٛژتٲجی لوٗکھ اصل تہٕ باقی پنٛژاہ نہٕ؟ یہُوواہنؔ دیُت جواب، "بہٕ کرن نہٕ یہِ تباہ اگر مےٚ پے لگہ زِ اتہِ چھِ پنٛژتٲجی لوٗکھ جان۔
\v 29 ابرہامؔ رود تمِس سٟتؠ یتھے کِنؠ کتھٕ کران تہٕ پرُوژھنس، "اگر توٚہہ معلوم سپدِ زِ تتہِ چھِ صرف ژتجی نفر اصل تہٕ توٚہؠ کیاہ کٔریو؟ یہُوواہنؔ دِتُس جواب، "بہٕ کرکھ نہٕ تم سٲری ژتجہِو باپتھ مارٕ۔"
\v 30 ابرہامنؔ ونُس، "مہربٲنی کرزیٚو ینہٕ شرارتھ کھسیٚو، مےٚ دیتو بیٚیہِ وننہٕ۔ اگر صرف ترٛہہ نفر اصل آسن تیٚلہِ کیاہ کریوٚ توٚہؠ؟ تِمو دیُت یتھ کٔنؠ جواب زِ بہٕ کرٕنہٕ ہرگِز تہِ اگر مےٚ باسہ اتہِ چھِ ترٛہہ نفر۔
\v 31 ابرہامنؔ ووٚن، "میانہِ خداوندٕ! مےٚ پزِ نہٕ توٚہہ سٟتؠ یتھ کٔنؠ کلام کرُن مگر زانپن چُھس یژھان اگر توٚہہِ پے لگہ تتہِ چھِ صرف وُہے نفر یم نیک چھِ، تہٕ توٚہؠ کیاہ کٔریٚو؟" تِمو وُن در جواب، "تِمو وُہو نفرو موٚکھٕ کرَن نہٕ بہٕ سورےٕ شہر تباہ۔
\v 32 ٲخرس پٮ۪ٹھ وُن ابرہامنؔ، "اے میانہِ خداوندٕ، مےٚ گٔژھؠ زیٚو نہٕ ناراض، مےٚ دِیو صرف اکھ کتھ وننہٕ۔ اگر توٚہہِ معلوم سپدِ زِ تتہِ چھِ صرف داہ نفر نیک تہٕ تیٚلہ کیاہ کٔریو توٚہؠ؟ خداوند یہُوواہنؔ دِتُس جواب، "تِمو دہو خٲطرٕ تہِ کرن نہٕ بہٕ سورے شہر تباہ۔"
\v 33 ابرہامنؔ کٔر نہٕ مذید کانٛہہ کتھ۔ یتُھے یہُوواہنؔ ابرہامسؔ سٟتؠ کتھ سپدٲو سُہ دراو، تہٕ ابرہامؔ ژاو گرٕ کُن۔
\c 19
\p
\v 1 تمہِ دوٚہہ شامس وٲتؠ تم دوٚنوے فرشتہٕ سدومؔ۔ لوطؔ اوس شہرٕ کِس دروازس پٮ۪ٹھ بہِتھ۔ ییٚلہِ تٔمؠ تِم وُچھ، سُہ وُتھ تِمن سلام کرنہٕ خٲطرٕ تھوٚد تہٕ دِتُن تِمن برونٛہہ کنہِ سجدٕ۔
\v 2 تٔمؠ وُن تِمن کُن، "حضرت از راتس کٔرؠ تو میانہِ گرِ قیام۔ پنٕنؠ کھۅر وۅر چھلیٚو تہٕ صبحس کٔریو بیٚیہِ سفر شروع۔ "مگر تِمو وُنہَس، "نَہ، أسؠ شونٛگو شہرٕکِس چوکسےٕ منٛز۔
\v 3 مگر لوطنؔ کٔرؠ تم سیٹھاہ عٲجِز زِ تم شونٛگُن تہنٛدسےٕگرس منٛز۔ لہٰذا گے تِم تمِسےٕ سٟتؠ تِہنٛد گرٕ۔ تہٕ تٔمؠ کوٚر تہنٛدِ باپتھ کھیٚن چیٚنہٕ تیار۔ تٔمؠ بناوِ خمبیرِ بغٲر تہنٛدِ باپتھ ژۅچہِ تہٕ تِمو کھیٚیہِ۔
\v 4 کھیٚن چیٚنہٕ مۅکلٲوتھ ییٚلہِ تِم شونٛگنہِ لٔگؠ، سدومؔ شہرٕ کیٚو لۅکٹیٚو بڈیو لوٗکو کوٚر اتھ گرس گیرٕ۔
\v 5 تِمو لوگ لوطَسؔ بڈِ بڈِ ونُن، "تِم لوٗکھ کتہِ چھِ یم از شامس چون گرٕ ژاے؟ تِم کڑُکھ نیٚبر، یُتھ أسؠ تِمن سٟتؠ شونٛگِتھ ہیٚکو!"
\v 6 لوطؔ دراو گرِ نیٚبر تہٕ کٔرنؠ سٲری دروازٕ بنٛد یُتھ نہٕ تِم انٛدر أژتھ ہیٚکن۔
\v 7 تٔمؠ وُن تمَن، "میانیو دوستو، یِژھ بدحرکت مٕہ کٔریو!
\v 8 میانؠ کتھ بوزیٚو۔ مےٚ چھےٚ زٕ انہرشہِ کورِ، بہٕ انکھ تمہٕ توٚہہِ نِش، توٚہؠ کٔریوٚ تِمن سٟتؠ تہِ یہِ توٚہہِ خوش کرِ مگر یمن نفرن سٟتؠ مٕہ کٔریو کینٛہہ، تکیازِ یم چھِ میانہِ گرِ میانؠ پٔژھؠ، لہٰذا چھےٚ مےٚ یہنٛز حفاظت کرٕنؠ لٲزمی۔
\v 9 مگر تِمو دیُت تورٕ جواب، "سانہِ وتہِ منٛزٕ نیر دفاہ۔ ژٕ چُھکھ ۅپر ملکُک، ژےٚ چھی نہٕ کانٛہہ حق اسہِ فکرِ تارنُک زِ صحی کیاہ چُھ! أسؠ کرو توٚہہِ سٟتؠ تہِ یہنٛدِ کھۅتہٕ بدتر سلوٗک۔ "تِمو دیُت لوطسؔ دکہٕ تہٕ ہیٚژکھ دروازٕ پُھٹراونٕچ کوشش کرٕنؠ۔
\v 10 مگر تِمو دویو فرشتو کھول وار وارٕ دروازٕ تہٕ اتھٕ پلنٲوِتھ ژونُکھ لوطؔ دروازٕ انٛدر۔ تہٕ کوٚرُکھ جلدی دروازٕ بنٛد۔
\v 11 پتہٕ نیٚو تِمو تِمن سارنے نفرن یم دروازٕ نیٚبر ٲسؠ، لۅکٕٹؠ کیو بٔڈؠ أچھ گاشےٕ یُتھ نہٕ تِمن دروازٕ اتھِ ییہِ۔
\v 12 پتہٕ وُن تِمو دویو فرشتو لوطَس، "یتہِ کُس چُھ بیٚیہِ توٚہہِ سٟتؠ؟ اگر یتھ شہرس منٛز تُہنٛدؠ شُرؠ، زامتُرؠ، کورِ یا بیٚیہِ کینٛہہ رشتہٕ دار چھِ تِم کڑُکھ یمہِ شہرٕ منٛزٕ،
\v 13 تکیازِ أسؠ چِھن یہِ جاے تباہ کرَن وٲلؠ۔ یہُوواہنؔ چھےٚ واریاہ ہٲبتناکھ کتھٕ بوزمژٕ یمہٕ کینٛژو نفرو یتھ شہرس متعلق تمِس ونہِ مژٕ چھےٚ، تہٕ تِمو سوزؠ أسؠ یہِ شہر تباہ کرنہٕ باپتھ۔"
\v 14 پتہٕ گو لوطؔ تِمن نفرن نِش یمَن تمؠ سنٛزن کورین سٟتؠ گنٛڈتھ اوس تہٕ وُننَکھ، "جلدی کٔریو! یمہِ شہرٕ منٛزٕ نیریو، تکیازِ یہُوواہؔ چُھ یہِ شہر تباہ کرن وول۔ "مگر تمِسنٛدیو بنَن والیو زامتُریو زون زِ یہِ چُھ مزاق کران۔
\v 15 ییٚلہِ دویمہِ دوٚہُک صبُح سپدُن ہیٚوتُن، یمو دوٚیو فرشتو کوٚر لوطسؔ بانٛد بانٛد تہٕ وُنہَس، "جلدےٕ وۅتھ! پنٕنؠ خاندارِنؠ تہٕ پننہِ کورِ یمہٕ ژےٚ سٟتؠ چھےٚ تلُکھ تہٕ نیر یتہِ! اگر نہٕ ژٕ تہِ کرکھ ژٕتہِ گژھکھ أتھؠ سٟتؠ ییٚلہِ أسؠ یہِ شہر تباہ کروون۔"
\v 16 ییٚلہ لوطنؔ دیٖری کرٕنؠ لٲج، فرشتو کٔر تمِس اتھس تھف، تمؠ سنٛزٕ خاندارنہٕ تہٕ کورین تہِ کٔرکھ تھف تہٕ نیٖکھ حفاظتہٕ سان شہرٕ نیٚبر کٔڈتھ۔ فرشتو کوٚر یہِ اوٕ مۅکھٕ تکیازِ یہُوواہؔ اوس تِمن پٮ۪ٹھ رَحم کران۔
\v 17 ییٚلہِ تِم شہرٕ نیٚبر دراےتہٕ اکؠ فرشتن وُننَکھ، اگر توٚہؠ زندٕ روزُن چُھو یژھان تیٚلہ ژٔلیٚو جلدےٕ۔ پوٚت نظر مہ دِیو! تہٕ وادی منٛز مٕہ رُکیو کُنہِ جایہ! پہاڑن کُن کٔھسیو! اگر نہٕ توٚہؠ یہِ کٔریو توٚہؠ گٔژھیو ہلاک!
\v 18 مگر لوطنؔ ووٚن یمو منٛزٕ أکِس، "نَہ جناب، مےٚ سٟتؠ مٕہ کٔریو یہِ!
\v 19 مہربٲنی کٔرتھ بوزیٚو۔ مےٚ پٮ۪ٹھ مہربان سپدِتھ کوٚرو توٚہہِ مےٚ سٟتؠ احسان تہٕ بچوُو میون زُو۔ مگر بہٕ ہیٚکہٕ نہٕ پہاڑن کُن گٔژھتھ۔ اگر مےٚ تہِ کرنٕچ کوشش کٔر تہٕ بہٕ مرٕ أتھؠ مصیبتس دوران۔
\v 20 میانؠ کتھ مٲنیو۔ نزدیکےٕ چُھ اکھ گام۔ مےٚ دِیو وُنؠ تورؠ کُن گژھنہٕ۔ یہِ چُھ اکھ لۅکُٹ شہر، اگر نہٕ توٚہؠ سُہ تباہ کٔرؠ ووٚن، تیٚلہِ گژھو أسؠ تورؠ تاکہِ سٲنؠ زُو بچَن۔"
\v 21 فرشتو منٛزٕ وُن اکؠ لوطس، "بہٕ دِمے ژےٚ اتھ اجازت یہِ ژےٚ ونُتھ۔ تہٕ بہٕ کرن نہٕ سُہ شہر تباہ یمِچ ژٕ کتھ چُھکھ کران۔
\v 22 مگر جلدےٕ کرِ! ژل تورؠ، تکیازِ یۅتام نہٕ ژٕ واتکھ تۅتام ہیٚکنہٕ بہٕ کہین تباہ کٔرِتھ۔ لوکو تھوو پتہٕ تتھ شہرس ضُعرؔ ناو، یمیُک مطلب" غٲر ضروری" چُھ۔ تکیازِ لوطنؔ وُن یہِ چُھ اکھ لۅکُٹ گام۔
\v 23 یتُھے آفتاب کھوٚت، لوط تہٕ تمسُنٛد خاندان ووت اتھ قصبس منٛز ضُعرؔ وننہٕ آو۔
\v 24 پتہٕ واجہ یہُوواہنؔ آسمانہٕ پٮ۪ٹھٕ بٲرشہٕ ہنٛدؠ پٲٹھؠ وُزملہٕ تہٕ نارٕ ترٹہٕ سدومؔ تہٕ عمورہ شہرن پٮ۪ٹھ۔
\v 25 یتھ پٲٹھؠ کٔرؠ تٔمؠ تِم شہر تہٕ تِمن شہرن منٛز روزن وٲلؠ تمام لوٗکھ تباہ۔ تِمو کٔرؠ کُلین کٹین سان تمام چیز اتہِ بپرباد۔
\v 26 مگر لوط سنٛز خاندارنؠ رُکییہ تہٕ دِژن پوٚت نظر یہِ وُچھنہٕ خٲطرہ زِ پٔتؠ کِنؠ کیاہ چُھ سپدان تہٕ سۅ مویہِ تٔتھؠ سٟتؠ تہٕ تمہِ سُنٛد جسم بنیاو اکھ نُنہٕ موہُل۔
\v 27 ابرہامؔ وُتھ صبحس صبحٲے تہٕ گو تتھ جایہِ یتِتھ سُہ یہُوواہسؔ برونٛہہ کنہِ کھڑا اوس۔
\v 28 تٔمؠ کٔر سدومؔ تہٕ عمورہؔ ہس کُن نظراہ تہٕ یہِ وُچِھتھ سپُد حٲران زِ سٲرسےٕ وادی اوس دٔہہ وتھان زنتہٕ اکھ بٔڈ بٔٹھ دزان ٲس۔
\v 29 بس، ییٚلہِ خداین وادی ہنٛدؠ تِم شہر تباہ کٔرؠ مگر ابرہامسؔ مدد کرُن گوس نہٕ مٔشتھ تہٕ لوط بچووُن تمن شہرن منٛز ینہٕ واجنہِ تبٲہی نِشہ یتہِ لوطؔ روزان اوس۔
\v 30 لوطؔ اوس ضُعرؔ علاقس منٛز روزنَس کھۅژان۔ لہٰذا دراو سُہ تتہِ تہٕ کھوٚت پننہِ کورِ زٕ ہیٚتھ پہاڑس کُن۔ اتہِ رود سُہ أکِس غارس منٛز۔
\v 31 اکہ دوٚہہ وُن بجہِ کورِ لۅکچہ بیٚنہِ، "سون مول چُھ وں بُڈیومُت" تہٕ یتھ علاقس منٛز چُھنہ وُنؠ کانٛہہ نفرا یُس اسہِ سٟتؠ ہم بستری کرِ۔ یتھ کٔنؠ سارے دُنیہٕکؠ لوٗکھ کران چھِ۔
\v 32 أسؠ دِمو پننِس مٲلس شراب تہٕ کروون مدہوش، پتہٕ شونٛگو أسؠ تس نِش ینہٕ تس پیی لگہ۔ یتھ کِنؠ سپدو أسؠ حٲملہٕ تہٕ بنو بچہٕ واجنہِ، یمہٕ سٲنس مٲلؠ سنٛدؠ اولاد آسن۔
\v 33 یتھ کِنؠ کوٚر تِمو تمہِ رٲژ پنُن مول مدہوش۔ تہٕ بٔڈ بیٚنہٕ ژایہ انٛدر تہٕ شونٛج پننِس مٲلِس نِشہ۔ سُہ اوس تیوٗت نشس منٛز زِ تس لوٚگ نہٕ پیی زِ سۅ کرِ شونٛج تمِس نشہٕ تہٕ کرِ ؤژھ۔
\v 34 دویمہِ دوٚہہ وُن بجہِ بیٚنہٕ پننہِ لۅکچہ بیٚنہِ۔ میانؠ کتھ بوز! راتھ راتس شونٛجس بہٕ پننِس مٲلس نِش۔ ۅلہٕ از کروون بیٚیہِ نشس منٛز غرق! یمہِ لٹہِ گژھکھ ژٕ تس نِشہ شونٛگنہِ۔ اگر سُہ ژےٚ نشہٕ شونٛگ ژٕ روزکھ حٲملہٕ تہٕ یتھ کِنؠ ہیٚکی ژیٚتہِ بچہٕ بنِتھ۔"
\v 35 یتھ کِنؠ کوٚر تِمو تمہِ راژ تہِ پنُن مول مےَ کٕس نشس منٛز مَست، لۅکٕٹ کور گییہِ تہٕ شونٛج تس نِشہ۔ مگر یمہِ لٹہ تہٕ اوس سُہ تیوٗت نشس منٛز زِ تس لوٚگ نہٕ پیی سۅ کرِ شونٛج تس نِشہ تہٕ کرِ ؤژھ۔
\v 36 یتھ کِنؠ بناوِ لوطنؔ پننہِ دۅشوے کورِ گۅبہِ کھوٚرٕ۔
\v 37 بجہِ کورِ دیُت پتہٕ أکِس لٔڑکس زایُن، یمسُنٛد ناو تمہِ موآبؔ تھوو۔ سُہ موآبؔ یُس پتہٕ موآبیٚنؔ ہُنٛد جَد بنیاو۔
\v 38 لۅکچہ تہِ زاو اکھ کڑکہٕ یمِس بنِ عمّیؔ ناو کوٚرُکھ۔ سُے بنیاو پتہٕ تِمن لوٗکن ہُنٛد جَد یمن پتہٕ عمونؔ وننہٕ اوس یوان۔
\c 20
\p
\v 1 ابرہام دراو ممرےؔ منٛزٕ نیرتھ دراو ابرہام تہِ گو جنوب مغرب کِس نیگیو صحراوس کُن۔ تتہِ رود سُہ قادِس تہٕ شورسؔ منٛزس۔ سُہ رود جرار شہرس منٛز أکِس پردیسی سٕنٛدِ حثیتہٕ
\v 2 ییٚلہ ابرہام تتہ اوس تٔمؠ وُن لوٗکن زِ سارہؔ چھےٚ تس بیٚنہِ نَہ کہِ گرٕواجنؠ۔ اوٕ کِنؠ سوزؠ جرارٕکؠ بادشاہ ابیملِکنؔ پنٕنؠ کینٛہہ نفر سارہؔ تس نِشہ اننہٕ باپتھ یُتھ سُہ تس پنٕنؠ شریکِ حیات بناوِہے۔
\v 3 مگر خداین وُن أتھؠ راتس منٛز ابیملِکسؔ خابس منٛز زِ، "میانؠ کتھ بوز! ژٕ چُھکھ مرن وول تکیازِ یۅسہ خوتونہٕ ژےٚ أنؠ تھن سۅ چھےٚ بیِس نفرٕ سنٛز خاندارِنؠ۔
\v 4 مگر ابیملِکؔ اوس نہٕ تس نِشہ شونٛگمُت توے تہٕ ونُن "اے خداوند، ییٚلہ بہٕ تہٕ میانہ قومٕکؠ لوٗکھ بے قصور چھِ، کیاہ توٚہؠ مٲروا اسہِ؟
\v 5 ابراہمنؔ ووٚن اسہِ، سۅ چھےٚ مےٚ بیٚنہِ، تہٕ تمہِ تہِ وُن، یہِ چُھ مےٚ بوے، مےٚ اوس نہٕ کانٛہہ غلط کرنُک ارادٕ کوٚرمُت۔ تہٕ نَہ کٔر مےٚ کانٛہہ غلط کٲم۔"
\v 6 خداین وُن تس، "آ، مےٚ بہٕ چُھس زانان زِ ژٕ اوسُکھ نہٕ کانٛہہ غلط کرُن یژھان۔ اوے بچووُکھ ژٕ مےٚ زِ ژٕ گوٚژھکھ نہٕ میانہ حسابہٕ کانٛہہ گناہ کرُن۔ مےٚ دیُت مےَ نہٕ ژےٚ تس اتھٕ لاگنُک اجازت۔
\v 7 لہٰذا کرُن تمِس نفرس پنٕنؠ خاندارِنؠ واپس تکیازِ سُہ چُھ نبی۔ سُہ کرِ تُہنٛدِ باپتھ دُعا تاکہِ توٚہؠ روزیٚو زندٕ۔ اگر نہٕ توٚہؠ تس سۅ واپس سوزؠ ہون تیٚلہِ مٔریٚو توٚہؠ ضرور تہٕ چٲنؠ باقی گرٕ بٲژ تہِ مرن۔
\v 8 دویمہ دوٚہہ صبحٲے أنؠ ابیملِکنؔ پنٕنؠ تمام عہدٕدار ناد دِتھ تہٕ وُننکھ تہِ سورےٕ یہِ سپُد۔ ییٚلہ تِمو یہِ بوز تِمن ژاو ہٲبتھ زِ خدا دییہ تِمن سزا۔
\v 9 پتہٕ اوٚن ابیملِکنؔ ابرہام ناد دِتھ تہٕ وُننَس، "ژےٚ پٔزہی نہٕ اسہِ سٟتؠ یہِ کرُن۔ اسہِ کوٚرا توٚہہِ سٟتؠ کینٛہہ غلط؟ کیاہ اسہِ یوٚژھا توٚہہِ نِش زِ بہٕ تہٕ میٚون قوم گژھِ گناہ گار سپدُن؟ ژےٚ ورتووُتھ مےٚ سٟتؠ تہِ ینہٕ ژےٚ کرُن پٔزہی!
\v 10 ابی ملکن ووٚن ابرہامس ژےٚ کیازِ کۅرتھ یہِ؟
\v 11 ابرہامنؔ دِتُس جواب، "مےٚ وُن زِ سۅ چھےٚ مےٚ بیٚنہِ تکیازِ مےٚ زانیاو زِ یتیٚکؠ لوٗکھ چھنہٕ پزنہٕ پٲٹھؠ خدایس تعظیم کران۔ تم چھِ یقینن سُہ غلط کران یہِ یژھن۔ اوٕ کِنؠ ہیٚکن تِم میانؠ خاندارنؠ ننہٕ خٲطرٕ مےٚ مٲرِتھ۔"
\v 12 حالانٛکہ سارہؔ ہیٚکہِ پزنہٕ پٲٹھؠ میانؠ بیٚنہِ زاننہٕ یِتھ، تکیازِ سۅ چھےٚ میانِس مٲلِس بیٚیِس زنانہِ ہنٛز کور یس سٟتؠ مےٚ خاندر کوٚرمُت چُھ۔
\v 13 پتہٕ ییٚلہ خداین مےٚ پننِس مٲلؠ سٕنٛدِ گرٕ نِشہ بیٚون روزنہٕ خٲطرٕ وُن، تہٕ مےٚ وُن أمِس یہِ طریقہ، یُس ورتٲوِتھ ژٕ مےٚ سٟتؠ پنٕنؠ وفادٲری ظہار کٔرتھ ہیککھ: أسؠ یوٚت تہِ گژھو، تتہِ ؤنزِ ژٕ "یہِ چُھ مےٚ بوے۔"
\v 14 ابیملِکنؔ أنؠ کینٛہہ ؤژھؠ تہٕ تیٖر، تہٕ دتِن ابرہامسؔ۔ تٔمؠ دتؠ تس کینٛہہ مُہنی تہٕ زنہِ تہِ۔ پتہٕ دژٕن ابرہامس پنٕنؠ گرٕواجِنؠ سارہؔ تہِ واپس۔
\v 15 تہٕ ابیملِکنؔ وُن تمِس وُچھ! میٚون زمین چھی ژےٚ برونٛہہ کنہِ۔ یتِتھ خوش گٔژھی تتِتھ روز!
\v 16 تہٕ سارہؔ ہس ونُن، "وُچھ! بہٕ چُھس چٲنِس بٲیس چاندِ ہنٛدؠ اکھ ساس پٲنٛسہٕ دِوان۔ یہِ یمہٕ کتھِ باپتھ تاکہِ دُبارٕ تُلنہٕ کانٛہہ یہِ ماملہٕ تہٕ نَہ ونہِ ژےٚ کٔرتھ کانٛہہ غلطی۔
\v 17 پتہٕ موٚنگ ابرہامنؔ خدایس دُعا تہٕ خداین بخُش ابیملِکنہِ خاندارنہِ تہٕ تمؠ سنٛزن لونٛڈین شفا تاکہِ تِمن زیٚون شُرؠ۔
\v 18 یہِ سپُد اوموٚکھٕ تکیازِ خداوند یہُوواہنؔ آسہ ابیملِکؔ سنٛزن گرٕچن سارنی زنانن شُرؠ زیٚون ناممکِن بنومُت۔ تکیازِ ابیملِکنؔ ٲس ابرہامؔ سنٛز خاندارِنؠ سارہؔ نِمٕژ۔
\c 21
\p
\v 1 یہُوواہؔ رود سارہؔ ہس پٮ۪ٹھ سیٹھاہ مہربان، یہِ کینٛژھا تٔمؠ ونمُت اوس بہٕ کرٕ۔ تٔمؠ کوٚر سارہؔ نہِ خٲطرٕ تہِ یہِ کرنُک تٔمؠ وعدہ کوٚرمُت اوس،
\v 2 سۅ روز حٲملہٕ تہٕ دِتُن ابرہامؔ سٕنٛدِس نیٚچوِس زایُن ییٚلہ سُہ سیٹھاہ بڈٕ اوس، یمہِ وزِ خداین وعدہ اوس یہِ سپدنُک وعدہ اوس کوٚرمُت
\v 3 ابرہامنؔ کوٚر أمِس نیٚچوِس "اسحاق" ناو یُس سارہؔ ہس زاو۔
\v 4 ابرہامنؔ کوٚر پننِس أمِس نیٚچوِس اضحاقسؔ تہِ ٲٹھِ دوٚہؠ ختنہٕ۔ یہِ کرنُک حکم تمِس خداین کوٚرمُت اوس۔
\v 5 ابرہامؔ اوس تمہِ وزِ ہتہٕ وہُر یمہِ وزِ تمِس نیٚچو اسحاق زاو۔
\v 6 سارہؔ ہن وُن، "یوٚدوے بہٕ گۅڈٕ اولاد دادِ غمگین ٲسٕس، مگر خداین بنٲوس بہٕ یہِ خوشی عطا کٔرتھ اسٕنؠ لایکھ، تہٕ یُس تہِ یہِ بوزِ زِ خداین کیاہ کوٚر میانہِ باپتھ سُتہ اسہِ مےٚ سٟتؠ۔"
\v 7 تمہِ وُن یتہِ، "ابرہامس اوس نہٕ کانٛسہِ یہِ ونمُت زِ بہٕ کیاہ دمہٕ کنہِ وزِ بچس دۅد، مگر مےٚ دیُت نیٚچوِس زایُن یمہِ وزِ ابرہامؔ سیٹھاہ بڈٕ اوس۔"
\v 8 بچہ سپُد بالیغ۔ سُہ دوٚہہ ووت ییٚلہِ اسحاقن ماجہِ دۅد چیٚون تروو۔ تمہِ دوٚہٕچ یہِ شٲدؠ مناونہٕ خٲطرٕ کوٚر ابرہامنؔ اکھ بوٚڈ سال تیار۔
\v 9 اکہِ دوٚہہ وُچھ سارہؔ ہن، حاجرہؔ مِصری سُنٛد نیٚچو اسماعیلؔ اضحاقسؔ ٹٲنہٕ ژٹان یُس تس ابرہامس نِش زامُت اوس۔
\v 10 تہٕ تمہِ وُن ابرہامسؔ، "یہِ لونٛڈی تہٕ امسُنٛد نیٚچو کڈتون مِصرٕ منٛزٕ۔ بہٕ چھیٚس نہٕ یژھان زِ امسُنٛد نیٚچو کیاہ نیٚیہ تہِ یہِ میانِس اضحاقسؔ وراثتس منٛز میلہِ۔
\v 11 ابرہامؔ گو یہِ بوزِتھ سیٹھاہ پریشان، تکیازِ تس ٲس پننِس نیٚچوِس اسماعیلؔ سنٛز فکِر تہِ۔
\v 12 مگر خداین وُن ابرہامسؔ، پننِس نیٚچوِس اسماعیلسؔ تہٕ لونٛڈی حاجرہؔ سٕنٛدِ باپتھ مہ گژھِ پریشان۔ یہِ کینٛژھا تہِ سارہؔ ژےٚ کرُن ونان چھےَ تہِ بوز تہٕ کرِ، تکیازِ اضحاقؔ چُھ سُہ اکھ یُس تمہِ نسلُک جد بنہِ یہِ دِنُک مےٚ وعدٕ کوٚرمُت چُھے۔
\v 13 مگر چانہِ لونٛڈی حاجرہؔ ہُنٛد نیٚچو تہِ بناون بہٕ اکہِ عظیم قبیلُک مول تکیازِ سُتہ چُھ چونےٕ اولاد۔
\v 14 یتھ کِنؠ وُتھ ابرہامؔ بیٚیہِ دوٚہہ صبحٲے۔ کینٛہہ کھیٚن کوٚرن تیار، أکِس مشکہِ منٛز برُن آب، یہِ ٹھیلہٕ تُلن تہٕ برُن حاجرہؔ ہس نکھس، اسماعیل کوٚرنس حوالہٕ، تہٕ کٔرنؠ بیرسبعؔ کیٚن بیابانن کُن روانہٕ۔
\v 15 ییٚلہ حاجرہؔ ہن تہٕ تمسنٛدؠ نیٚچی مشکہِ منٛزٕچ سٲرےٕ تریش چیٚتھ موٚکلٲو تہٕ تمہِ تھوو نیٚچو أکِس زنٛڈس تل۔
\v 16 تہٕ پانہٕ بیٹھ تیژ دور یوٗتاہ دور زن اکھ تیر لاینہٕ ییہِ۔ تمہِ سونچ، "بہٕ ہیٚکہ نہٕ پننِس نیٚچو سُنٛد مرُن برداش کٔرِتھ!" تہٕ لٕج أتی بہِتھ زورٕ زورٕ ودنہِ۔
\v 17 خداین بوز جلدےٕ اسماعیلؔ سُنٛد آلو، تہٕ تٔمؠ سوز پننیٚو فرشتو منٛزٕ آسمانہٕ پٮ۪ٹھٕ اکھ فرشتہٕ حاجرہؔ ہس شیٚچھ ہیٚتھ۔ تٔمؠ وُن، ہاجرہ، ژےٚ کیاہ رووےٕ؟ کھوٚژ مہِ، خداین بوز چٲنِس نیٚچو سُنٛد ودُن۔
\v 18 گژھِ سُہ کڑکہٕ تلُن تھوٚد تہٕ تمِس دِ پننہِ بہادری ہنٛز ہمَتھ۔ تکیازِ مےٚ چھِ تمسنٛدؠ اولاد عظیم قبیلہٕ بناوُن۔
\v 19 پتہٕ ہونس خداین اکھ آبہٕ کریٚور۔ سۅ گییہِ کریرِس نکھٕ آبہٕ بانہٕ برُن تہٕ چووُن پنُن نیٚچو۔
\v 20 خداین کٔر أمِس بچَس رٲچھ یۅتام سُہ بیابانن منٛز بوٚڈ گو تہٕ بنیاو اکھ جان تیر انداز۔
\v 21 سُہ اوس فاران کیٚن بیابانن منٛز روزان۔ حاجرہؔ ہن أنؠ تمِس باپتھ مِصرٕ پٮ۪ٹھٕ اکھ خاندارِنؠ۔
\v 22 تمہِ وقتہٕ وُن بادشاہ ابیملِکؔ تہٕ تمسنٛدؠ فوجٕکؠ سِپاہ سالار فیکلنؔ ابرہامس، "یہِ کتھ چھےٚ عیان زِ یہِ کینٛژھا توٚہؠ کران چُھو خدا چُھ توٚہہ مدد کران۔
\v 23 لہٰذا کٔریٚو وۅنؠ مےٚ سٟتؠ خدا حٲضر نٲضر رٔٹِتھ پۅختہٕ وعدہ زِ توٚہؠ دیو نہٕ مےٚ، میانیٚن شُریٚن تہٕ زُریٚن دونٛکھٕ۔ مےٚ سٟتؠ تہٕ یتہَ کیٚن تمام لوٗکن سٟتؠ یتہِ توٚہؠ روزان چُھو یِیو توٚہؠ وفادٲری سان پیش۔ مےٚ سٟتؠ کٔریٚو توٚہؠ وفادٲری یتھ کِنؠ مےٚ توٚہہ سٟتؠ کٔر۔
\v 24 ادٕ ابرہامنؔ کھیٚو یہِ کرنُک قسم۔
\v 25 ابرہامنؔ کٔر ابیملِکسؔ پننہِ اکہ آبہٕ کریرِچ شکایت یتھ پٮ۪ٹھ ابیملِکؔ سنٛدیو نوکرو قبضہٕ اوس کوٚرمُت
\v 26 مگر ابیملِکنؔ وُن، "مےٚ چھنہٕ خبر یہِ کمؠ چُھ کوٚرمُت، ژےٚ ونُتھ نہٕ مےٚ یہِ، نَہ چُھ مےٚ اتھ متلِق ونیُک تام بوزمُت۔
\v 27 پتہٕ أنؠ ابرہامنؔ کینٛہ تیٖر، ژھاولؠ، گاو تہٕ دتِن ابیملِکسؔ، یتھ کِنؠ کوٚر تِمو پانہٕ وٲنؠ اکھ أکِس سٟتؠ صلح۔
\v 28 ابرہامؔ گو پننِس جبَس منٛز تہٕ ژٲرنؠ تمہِ منٛزٕ ستتھ چِھر۔
\v 29 ابیملِکنؔ پرُوژھ ابرہامسؔ، "ژےٚ کیازِ کٔڑتھکھ پننہِ کھیٚلہِ منٛزٕ ستتھ چِھر نیٚبر؟
\v 30 ابرہامنؔ ونُس یورٕ، "بہٕ چُھس یژھان زِ توٚہؠ کٔرووکھ میانہٕ طرفہٕ یمہٕ ستتھ چِھر قبوٗل۔ یتھ کِنؠ دییہِ میون یہِ تحفہٕ توٚہہ سارنی ژینہٕ ون زِ یہِ کریٚور چُھ میٚون تکیازِ یہِ چُھ مےٚ کھوٚنمُت۔
\v 31 یتھ کِنؠ کرِ ابیملِکنؔ یمہٕ لوِ قبول۔ پتہٕ کوٚر ابرہامنؔ اتھ جایہ بیرسبعؔ ناو یعنی "حلفہٕ وول کریٚور" تکیازِ اتھ جایہ کوٚر ابیملِکنؔ تہٕ ابرہامنؔ اکھ أکِس سٟتؠ امنہٕ سان روزنُک وعدہ۔
\v 32 بیرسبعؔ ہس منٛز یہِ معاہدٕ کرنہٕ پتہٕ دراے ابیملِکؔ تہٕ تمسُنٛد سِپاہ سالار فیکل تتہِ تہٕ گے واپس فلستینین ہنٛدِس ملکس منٛز۔
\v 33 ابرہامنؔ روٗن بیرسبعؔ ہس منٛز جھاو ناوُک کُل تہٕ کرٕن تتہِ ابدی خدا یہُوواہؔ سنٛز عبادت۔
\v 34 ابرہامؔ رود فلستینی لوٗکن ہنٛدس اتھ ملکس منٛز غٲر ملکی حثیتہٕ واریہس وقتس۔
\c 22
\p
\v 1 واریاہہِ وہرؠ پتہٕ، ہیٚوت خداین ابرہامؔ یہِ زاننہٕ خٲطرٕ آزماوُن زِ اما ابرہامؔ کریا تس سنٛز فرمانبردٲری۔ تٔمؠ کوٚر ابرہامس آلو، تہٕ ابرہامنؔ دتُس جواب، "بہٕ چُھس حٲضر۔"
\v 2 خداین ونُس، "چون نیٚچو اضحاقؔ یمِس توٚہؠ سیٹھاہ لول بران چُھو، چُھ کُنےٕ لڑکہٕ یُس عطا کرنُک مےٚ توٚہہِ وعدہ کوٚر۔ سُہ تلُن پانس سٟتؠ تہٕ گٔژھیٚو یکہ وٹہٕ موریاہؔ چہِ سرِزمینہِ کُن تہٕ کٔھسیٚو تتھ پہاڑس پٮ۪ٹھ یُس بہٕ توٚہہِ ہاوو تہٕ کرُن یہِ بُزمژِ قربٲنی رنٛگؠ پیش۔
\v 3 یتھ کِنؠ وُتھ ابرہامؔ دویمہِ دوٚہہ صبحٲے، پننِس خرس کوٚرن زیٖن تہٕ پنٕنؠ زٕ نوکر تہٕ اسحاق تلُن سٟتؠ۔ تٔمؠ ژۅٹ قربٲنی بُزنہٕ باپتھ کینٛہہ زیُن تہِ۔ پتہٕ لوٚگ تتھ جایہِ کُن سفر کرنہِ یتھ متعلق خداین تمِس ونمُت اوس۔
\v 4 تریمہِ دوٚہہ ییٚلہِ تِم سفر کران ٲسؠ، ابرہامسؔ پییہِ دوٗرے تتھ جایہِ کُن نظر یتھ جایہ خدا یژھان اوس زِ سُہ گژھِ واتُن۔
\v 5 ابرہامنؔ وُن پننٮ۪ن نوکرن، "توٚہؠ دوٚنوے روزیو یمِس خرس نِش تہٕ أسؠ لڑکہٕ تہٕ بہٕ گژھو ہُتتھ۔ أسؠ کرو تتہِ خدایہ سنٛز عبادت تہٕ پتہٕ یمو توٚہہِ نِشہ بیٚیہِ واپس۔
\v 6 پتہٕ تُل ابرہامنؔ زیٚون یُتھ بُزمژِ قربٲنی تیار کرنہٕ باپتھ نار زالہِ ہے تہٕ برُن پننِس نیٚچوِس اضحاقسؔ پکناونہٕ باپتھ نکَھس۔ ابرہامنؔ تُل نار زالنہٕ باپتھ کہتام اتھس منٛز۔ تٔمؠ تُج شراکھ تہِ سٟتؠ تہٕ لٔگؠ دوٚنوے اکھ أکِس سٟتؠ سٟتؠ پکنہِ۔
\v 7 پتہٕ وُتھ اسحاق پننِس مٲلس کُن، "میانہِ ببا۔ ابرہامنؔ ونُس، "کیاسہ میانہِ گۅبرا، بہٕ چُھس یتی!" اسحاقنؔ ونُس، "وچُھو، اسہِ چُھ نار زالنہٕ باپتھ زیُن تہٕ ژیٚنہِ سٟتؠ مگر بُزنہٕ باپتھ قربٲنی ہُنٛد کٹھ کتہِ چُھ؟
\v 8 ابرہامنؔ ووٚنُس در جواب، "میانہِ گۅبرا، خدا سوزِ بُزنہٕ ینہِ واجنہِ قربٲنی باپتھ پانے کٹہٕ برٕ۔ "یتھ کِنؠ رودؠ تم اکھ دوٚنوے اکھ أکِس سٟتؠ پکان۔
\v 9 تِم وٲتؠ تتھ جایہ یتھ متعلق خداین تمِس ونمُت اوس۔ تتہِ بنٲو ابرہامنؔ کنیٚن ہنٛز اکھ قربان گاہ۔ تہٕ تتھ پٮ۪ٹھ تھووُن زیُن شیرِتھ۔ پتہٕ گونٛڈن پنُن نیٚچو اسحاق تہٕ تھووُن اتھ زنِس پٮ۪ٹھ۔
\v 10 امہِ پتہٕ کٔڈ ابرہامنؔ شراکھ تہٕ ہیٚوتُن پنُن نیٚچو قربان کرُن۔
\v 11 مگر یہُوواہؔ سنٛدؠ فرشتن دتُس آسمانہٕ پٮ۪ٹھٕ آلو تہٕ وُننس، "ابرہامؔ۔ ابرہامؔ!" ابرہامنؔ دتُس جواب، "بہٕ چُھس یکیاہ!"
\v 12 فرشتن ووٚن، "لٔڑکس مٕہ واتناو تکلیف، مےٚ زون وُنؠ زِ ژٕ چُھکھ خدایس احترام تہٕ تمؠ سنٛز عبادت کران۔ مےٚ توٚر یہِ فکرِ تکیازِ ژےٚ کۅرتھ نہٕ پنُن کنےٕ اولاد قربان کرنہٕ نِشہ اِنکار۔"
\v 13 ابرہامنؔ دِژ ہیٚور کُن تہٕ اتہِ وچُھن نزدیکےٕ اکھ ہونٛڈ۔ یمسنٛدؠ ہینٛگ زنٛڈس منٛز ٲسؠ، ابرہامؔ روٚٹ یہِ تہٕ کوٚرن زبح تہٕ نیٚون پننِس نیٚچوِس سٕنٛدِ بدلہٕ قربان گاہس پٮ۪ٹھ بُزمژٕ قربٲنی پیش کرنہٕ موٚکھٕ۔
\v 14 ابرہامنؔ تھوو اتھ جایہ "یہُوواہؔ سوزِ" ناو، تہٕ وُنؠ چھِ اتِکؠ لوٗکھ ونان "یہُوواہؔ سٕنٛدِس پہاڑس پٮ۪ٹھ سوزِ سُہ۔"
\v 15 یہُوواہؔ سنٛدؠ فرشتن دیُت دویمہِ لٹہ ابرہامس آسمانہٕ پٮ۪ٹھٕ آلو۔
\v 16 تٔمؠ وُن، "بہٕ یہُوواہؔ، چُھسے ژےٚ ونان زِ ژےٚ کۅرتھ تہِ یہِ مےٚ ژےٚ وۅنمے، تہٕ ژےٚ تھوتھن نہٕ پنُن کُن اولاد بچٲوِتھ۔ اوے چُھس بہٕ پنُن پان گواہ تھٲوِتھ قسم کھیٚتھ ونان،
\v 17 اکہ دوٚہہ آسہ چٲنؠ زُرؠ یاتھ آسمانہٕ کیٚن تارکن تہٕ سمندر بٹھِ کیٚن سیٚکہِ دانن ہنٛدؠ پٲٹھؠ۔ چٲنؠ شُرؠ دِن پننٮ۪ن دشمنن شکس تہٕ کرن تہنٛدین شہرن پٮ۪ٹھ قبضہٕ۔
\v 18 ژےٚ کٔرتھ میانؠ عبادت، اوٕ کِنؠ کرن زمینہِ پیٚٹھٕکؠ تمام قوم چانہِ زُرؠ یٲژ ہنٛدِ ذرؠ یہِ برکت حٲصِل۔
\v 19 ادٕ دراے ابرہامؔ تہٕ اسحاق واپس تتھ جایہ کُن یتہِ تہنٛدؠ نوکر پراران ٲسؠ تہٕ گےَ یکہٕ وٹہٕ بیرسبعؔ کُن واپس، یتہِ ابرہامؔ تہٕ تمسُنٛد لوٗکھ ٹھہریاے۔
\v 20 یمو کتھو پتہٕ وُن کمؠ تام ابرہامسؔ، "چانِس بٲے نحورؔ سنٛزِ خاندارنہِ ملکہ تہِ دیُت بچس زایُن۔"
\v 21 وُنؠ اوس ساروٕے کھۅتہٕ زیُٹھ بچہٕ عُوض، دویم اوس بُوز۔ تٔمس پتہٕ اوس ارامؔ سُنٛد مول قموایلؔ۔
\v 22 قموایلؔ سٕنٛدِ پتہٕ اوس کسدؔ پتہٕ حزوؔ، پتہٕ فلداسؔ پتہٕ اِدلافؔ تہٕ پتہٕ بیتوایلؔ
\v 23 بیتوایلسؔ نشہٕ زایہ رِبقہؔ۔ یم ٲٹھوے ٲسؠ ابرہامؔ سٕنٛدِس بٲیس نحورسؔ ملکہ نِشہ زامٕتؠ۔
\v 24 نحورسؔ تہِ ٲس اکھ لونٛڈی یمِس رومہؔ ناو اوس۔ تمِس تہِ ٲسؠ ژور شُرؠ زامٕتؠ: طِبح، جاحم، تخصؔ تہٕ معکہؔ۔
\c 23
\p
\v 1 ییٚلہِ سارہؔ اکھ ہتھ تہٕ ستووُہہ ؤرِش وٲژ
\v 2 سارہؔ گزرییہِ قریتؔ اربعؔ شہرس منٛز۔ یتھ ؤنؠ حبرون ونان چھِ، یہِ چُھ کنعانس منٛز۔ پتہٕ گو ابرہامؔ تمؠ سنٛزِ ماتم دٲری باپتھ تورؠ۔
\v 3 ابرہامنؔ تھٲو پننہِ خاندارنہ ہنٛز میَت تٔتی تہٕ پانہٕ گو حِتؔ سنٛدین اولادن سٟتؠ کتھ کرنہِ۔ تٔمؠ وُن،
\v 4 "بہٕ چُھس توٚہہ منٛز روزن وول اکھ وۅپر شخص، اوے چھیٚنہٕ مےٚ یتہِ پنٕنؠ کانٛہہ زمین۔ مےٚ دیتو یتہِ کینٛہہ زمین مٔلؠ یُتھ بہٕ پننہِ خاندارنہ ہنٛز میَت دفنٲوتھ ہیٛکن۔
\v 5 حِتن ووٚن ابرہامس تورٕ،
\v 6 "جناب، توٚہؠ چُھو اسہِ منٛز اکھ طاقتور انسان۔ سانیٚو شوبدار قبرو منٛزٕ کٔرؠ تون کانٛہہ اکھ پسنٛد تہٕ کٔرؠ تون پنٕنؠ خاندارنہ ہنٛز میَت دفن۔ اسہِ منٛزٕ کرنہٕ کانٛہہ تہِ توٚہہ تُہنٛزِ خاندارنہِ ہنٛز قبرِ باپتھ زمین کٔننہٕ نِشہ اِنکار۔"
\v 7 پتہٕ وُتھ ابرہامؔ تھوٚد تہٕ کوٚرن زمین مٲلکن یعنی حِتؔ سنٛدین اولادن برونٛہہ کنہِ سجدٕ
\v 8 تٔمؠ وُن تِمنِ "اگر توٚہؠ رضا منٛدی ظٲہر کران چُھو زِ بہٕ گژھن پننہِ خاندارنہِ ہنٛز میَت یتی دفناوُن، تیٚلہ بوزیٚو میون تہٕ صُحرؔ سٕنٛدِس نیٚچوِس عِفرونس ؤنِو،
\v 9 سُہ کنہِ مکفیلہؔ جایہِ ہنٛز گوٚپھ مےٚ۔ یۅسہ تتھ کھیتہِ ٲخرس پٮ۪ٹھ چھےٚ۔ تمِس ونیٚو زِ سُہ نیٚیہ مےٚ نِش تتھ پوٗرٕ ماوضہٕ تہٕ توٚہہ سارنی برونٛہہ کنہِ کرو سودا۔ یتھ کِنؠ بنہٕ مےٚ قتدفینٕچ جاے یعنی قبرِستان۔"
\v 10 تہٕ عِفرونؔ اوس شہرچہِ برنہِ نِش یتہِ حِتی سنٛدؠ واریاہ لوٗکھ تس انٛدؠ انٛدؠ ٲسؠ۔ تٔمؠ بوز تہِ سورےٕ یہِ ابرہامنؔ تِمن وُن۔
\v 11 عِفروننؔ وُن، "نَہ جناب، میانؠ کتھ بوزیٚو۔ بہٕ دمہٕ توٚہہِ یہِ زمین تہٕ اتھ منٛز موجود قبر ماوضہٕ بغٲر، یم لوٗکھ تھاوکھ گواہ۔ پنٕنؠ خاندارنؠ کرُن تٔتی دفَن۔"
\v 12 ابرہامنؔ کوٚر بیٚیہِ تمن لوٗکن برونٛہہ کنہِ سجدٕ یم اتھ جایہ روزان ٲسؠ۔
\v 13 تہٕ عِفرونَس ونُن، یہِ زن باقی سٲری بوزان ٲسؠ، نَہ میانؠ کتھ بوز۔ اگر ژٕ یژھکھ بہٕ دِمے ژےٚ امہِ زٔمنہٕ پچہِ ہُنٛد ماوضہٕ۔ ژٕ ون اتھ کیاہ چُھ قٟمت، بہٕ دِمے ژےٚ سُہ۔ اگر ژٕ سُہ قبوٗل کرکھ سۅ زمین بنہِ میانؠ تہٕ بہٕ ہیٛکن پنٕنہِ خاندارنہ ہنٛز میَت تتہِ دفنٲوتھ۔
\v 14 عِفروننؔ وُن ابرہامس در جواب،
\v 15 جناب میانؠ کتھ بوزیٚو۔ زمینُک قٟمت چُھ ژور ہتھ چانٛدِ ہنٛدؠ سکہٕ۔ مگر یہِ مۅل چُھنہٕ ژیٚتہ مےٚ نِش کانٛہہ اہمیت تھاوان، دِیو مےٚ پونٛسہٕ تہٕ دفنٲے ہون تٔتی پننہِ خاندارنہٕ ہنٛز میَت۔
\v 16 ابرہامنؔ کوٚر عِفرونُنؔ قٟمت قبول تہٕ کوٚرن چانٛدِ ہنٛدین ژورن ہتن پونٛسن وزن یہِ عِفراننؔ ووٚن۔ یتھ سٲری بنی حِت وُچھان ٲسؠ۔ تٔمؠ کوٚر چانٛدِ ہُنٛد سُہ معیاری وزن استعمال یُس لوٗکھ چیز کٔننہٕ باپتھ کران ٲسؠ۔
\v 17 یتھ کِنؠ بنییہِ ممرےؔ یس نکھٕ مکفیلہؔ انٛدٕچ عِفرونٕنؠ زمین، زمینس منٛز موجود قبر تہٕ یم تتھ منٛز کُلؠ ٲسؠ یمیُک حد مقرر سپُد ابرہامٕنؔؠ ملکِیت۔
\v 18 یتھ کِنؠ ہیٚوت ابرہامنؔ یہِ جاداد مٔلؠ یہِ زن حِتؔ سنٛدؠ سٲری شُرؠ شہرچہِ برٕنؠ پٮ۪ٹھ بِہتھ بوزان ٲسؠ۔
\v 19 امہِ پتہٕ کٔر ابرہامنؔ سارہؔ سنٛز میَت کنعان چہِ سرِ زمینہِ منٛز ممرےؔ یس نکھٕ مکفیلہؔ انٛدٕچہِ زمینہِ انٛدر قبرِ منٛز دفن۔ یتھ وُنؠ حبرون ونان چھِ۔
\v 20 چناچہِ سۅ زمین تہٕ تتھ منٛز موجود غار دیُت سرکٲرؠ طور حِت سنٛدیو اولادو ابرہامسؔ تاکہِ سُہ گژھِ قبرِستانہٕ باپتھ استعمال۔
\c 24
\p
\v 1 ابرہامؔ اوس وُنؠ واریاہ بُڈیوٚمت۔ یہُوواہنؔ کٔر ابرہامسؔ رنٛگہ رنٛگہ برکت۔
\v 2 اکہِ دوٚہہ وُن ابرہامنؔ پننِس گرٕ کِس زٹِھس نوکرس یُس ابرہامؔ سٕنٛدِ سارے گرُک رٲچھ در اوس، "پنُن اتھٕ میانیٚن رانن منٛز تھٲوِتھ کرِ ژٕ مےٚ سٟتؠ وعدہ یہِ بہٕ ونے تہِ کرکھ ژٕ۔"
\v 3 یہِ زٲنِتھ تہِ زِ یہُوواہؔ، خدا یمؠ آسمان تہٕ زمین پٲدٕ کٔرؠ چُھ بوزان۔ وعدہ کرِ زٕ ژٕ انہَن نہٕ میانِس نیٚچوِس اضحاقسؔ باپتھ کنعانٕچ یتہِ بہٕ وُنؠ روزان چُھس کانٛہہ تہِ کور نیتٕرؠ۔
\v 4 بلکہِ گژھکھ ژٕ میٚون ملک میانیٚن رشتہٕ دارن نِش۔ میانِس نیٚچوِس اضحاقسؔ باپتھ انہَن تِموےٕ منٛزٕ خاندارنؠ۔
\v 5 نوکرن پرُژھ تمٕس، "اگر مےٚ چانیٚو رشتہٕ دارو منٛزٕ کانٛہہ زٔنؠ میج تہٕ پتہٕ مونُن نہٕ یتھ ملکس منٛز یُن تیٚلہ کیاہ کرٕ بہٕ؟ کیاہ بہٕ ہیٚکنا چون نیٚچو واپس تتھ ملکس منٛز نِتھ یتہِ پٮ۪ٹھٕ توٚہؠ او۔ تاکہِ نیتٕھر کٔرتھ بہیہِ سُہ تٔتؠ؟
\v 6 ابرہامنؔ دتُس جواب، "نَہ۔ میون نیٚچو نی زیٚن نہٕ ہرگز تہِ تور!
\v 7 یہُوواہؔ خدا یمؠ آسمان بنٲوؠ، اوٚننس بہٕ یور۔ تِمے اوٚنُس بہٕ پننِس مٲلؠ سٕنٛدِ گرِ پٮ۪ٹھٕ تہٕ تمہِ ملکہٕ پٮ۪ٹھٕ یور یتہِ میٲنؠ رشتہٕ دار روزان ٲسؠ۔ تٔمؠ کٔر مےٚ سٟتؠ کتھ تہٕ کوٚرُن مےٚ سٟتؠ پۅختہٕ وعدہ۔ تٔمؠ ووٚن، "بہٕ دِمہٕ کنعانچ یہِ زمین چٲنین اولادن۔ "سُہ سوزِ اکھ فرشتہٕ یُس توٚہہِ برونٛہےٕ تور گژھِ تہٕ بنایو توٚہہِ اتھ قٲبل زِ میٲنِس نیٚچوِس باپتھ أنؠ ووٚن خاندارٕنؠ تہٕ پتہٕ انؠ ووٚن یور روزنہٕ باپتھ۔
\v 8 مگر اگرسۅ بنَن واجِنؠ خاندارِنؠ توٚہہِ سٟتؠ یور واپس ییہِ نہٕ، تیٚلہِ چُھو توٚہؠ آزاد پنُن وعدہ نظرانداز کرنہٕ خٲطرٕ۔ صرف پزیٚو نہٕ توٚہہِ اکھ چیز کرُن سُہ گو یہِ زِ میون نیٚچو تور روزنہٕ خٲطرٕ نیُن۔
\v 9 تہٕ نوکرن تھوو پنُن اتھہٕ ابرہامؔ سنٛزن رانن منٛزباگ تہٕ اتھ معاملس متعلق کوٚرُن پۅختہٕ وعدہ۔
\v 10 پتہٕ نی نوکرن پننِس مٲلکہٕ سنٛدؠ داہ اونٛٹ تہٕ تمن پٮ۪ٹھ برُکھ پرٛتھ کُنہِ قسمُک سامان یُس امسنٛدؠ مٲلکن أمِس سٟتؠ نِنہٕ خٲطرٕ دیتمُت اوس۔ امہِ پتہٕ دراو سُہ ارم نحوریمؔ گژھنہٕ خٲطرٕ۔ یُس شمٲلی مسوپتامیہؔ ہَس منٛز چُھ۔ سُہ ووت نحورؔ شہرس منٛز۔
\v 11 نوکر ییٚلہِ نحورؔ ووت، یہِ اوس دُپہرُک وق، زنانہٕ آسہٕ امہِ وقتہٕ آب اننہٕ خٲطرٕ کریرٮ۪ن پٮ۪ٹھ گژھان۔ تٔمؠ بہنٲوؠ اونٹ کریرِس نزدیک یُس شہرٕ نیٚبر اوس۔
\v 12 نوکرن کوٚر دعا، "خداوند یمؠ سنٛز میون آقا ابرہامؔ عبادت چُھ کران، از دِ مےٚ کامیاب گژھنُک توفیق! میٲنِس آقا ابرہامسؔ پٮ۪ٹھ تھاو یقین!
\v 13 میٲنؠ کتھ بوزیٚو۔ بہٕ چُھس آبہٕ کریرِس نِش اِستادٕ تہٕ شہرٕ کیٚن ہنٛزٕ کورِ چھےٚ آب نِنہٕ خٲطرٕ یِوان۔
\v 14 بہٕ چُھس توٚہہِ یہِ پرِژھان زِ بہٕ ونہٕ ہا کٲنٛسہِ کورِ "مہربٲنی کرتھ تھاو تہٕ نوٚٹ پتھر تاکہِ بہٕ چیٚمہٕ ہا تریش۔ "اگر تمہِ وُن، چیٚہ ژٕ تریشہٕ دام، تہٕ بہٕ انے چانیٚن اونٹن باپتھ تہِ تریش، بہٕ زانہٕ زِ یہےَ چھےٚ سۅ زٔنؠ یۅسہ ژےٚ پننِس بنٛدٕ اضحاقسؔ خٲطرٕ گرٕواجِنؠ ژٲرمٕژ چھےٚ تھن۔ تہٕ امی سٟتؠ زانہٕ بہٕ زِ ژٕ چُھکھ میانس آقاہس پٮ۪ٹھ مہربان۔
\v 15 یہِ اوس وُنہِ یہِ دُعا منٛگانی زِ رِبقہؔ ناوٕچ اکھ جوان زٔنؠ وٲژ نکَھس پٮ۪ٹھ بانہٕ ہیٚتھ اتُت۔ سۅ ٲس بیتوایلؔ سنٛز کور۔ یُس نیٚچو اوس ابرہامؔ سٕنٛدِس بٲیِس نحورؔ سنٛزِ خاندارنہِ ملکہ ہُنٛد۔
\v 16 سۅ ٲس انہرِش تہٕ سیٹھاہ حسیٖن۔ تمِس نِش اوس نہٕ زانٛہہ کانٛہہ مرد شونٛگمُت۔ سۅ گییہِ کریرؠ بٔٹِھس نشہٕ، پنُن آبہٕ نوٚٹ برُن تہٕ کٔھژ واپس۔
\v 17 ابرہامؔ سُنٛد نوکر گو ؤلؠ ؤلؠ تمِس نِشہ تہٕ لوٚگُس وننہِ، "مہربٲنی کٔرتھ دتہٕ مےٚ پننہِ نٹہِ منٛزٕ تریشہٕ داماہ۔"
\v 18 تٔمؠ دِتُس جواب، "جناب! چیٚیو دام کھنٛڈ۔ تٔمؠ وول آبہٕ نوٚٹ پننٮیٚو پھیٚکیو پٮ۪ٹھٕ تہٕ اتھن منٛز رٔٹِتھ چیانووُن سُہ تریش۔
\v 19 ییٚلہِ تمہِ سُہ تریش چیاونوو تہٕ وُننَس، "بہٕ انہٕ چانٮیٚن اونٛٹن باپتھ تہِ تریش یوٚتام نہٕ تہنٛز تریش ہمہِ۔"
\v 20 تمہِ کوٚر جلدےٕ پنُن آبہٕ نوٚٹ جانورن ہنٛدس حوضس منٛز ترٲوِتھ خٲلی۔ پتہٕ دورییہِ سۅ کریرِس کُن تہٕ روز سارنےٕ اونٹن خٲطرٕ تریش انان۔
\v 21 نوکر رود کینٛہہ وننہٕ بغٲر صرف تس وُچھان۔ سُہ اوس یہِ زانُن یژھان زِ آیا یہُوواہنؔ بنووا میون سفر کامیاب کِنہٕ نَہ۔
\v 22 ٲخر ییٚلہ اونٛٹو تریش چیٚتھ مۅکلٲو نوکرن تُج نستہِ ہُنٛد اکھ سۅنہٕ سُنٛد دٲیرٕ یمیٚک وزن شےٚ گرام اوس تہٕ تمؠ سنٛزو نریٚو باپتھ سۅنہٕ سنٛدؠ زٕ کٔرؠ ہر کُنہِ کٔرس اوس اکھ ہتھ تہٕ داہ گرام وزن، تہٕ دتِن رِبقہؔ ہس تہٕ وُننَس لاگ یمہٕ۔
\v 23 پتہٕ وُننَس تٔمؠ، "مےٚ ونتہٕ ژٕ کہنٛز کور چھیٚکھ؟ یتہِ ونتم زِ کیاہ چٲنِس مٲلؠ سٕنٛدِس گرس منٛز چھا مےٚ تہٕ میانیٚن نفرن شونٛگنؠ سونٛب گنٛجٲیش؟"
\v 24 تمہِ دِتُس جواب، "میانِس مٲلس چُھ ناو بیتوایلؔ۔ سُہ چُھ نحورؔ تہٕ تمؠ سنٛزٕ خاندارنہِ ملکہ ہُنٛد نیٚچو۔
\v 25 آ، اسہِ چُھ کمرٕ یتہِ توٚہؠ سٲری از راتس روزِتھ ہکیٚو۔ تہٕ بیٚیہِ چُھ اسہِ اونٛٹ رچھنہٕ باپتھ بوس تہِ تہٕ کھیٚن تہِ واریاہ۔
\v 26 نوکرن دیُت یہُوواہسؔ کُن سجدٕ۔
\v 27 تٔمؠ وُن، "بہٕ چُھس یہُوواہسؔ سُنٛد شکر کران، تمِس خدایہ سُنٛد یمسنٛز عبادت میٚون آقا ابرہامؔ کران چُھ۔ سُہ رود مےٚ بار بار ہاوان زِ سُہ چُھ میانِس آغہٕ سٕنٛدِ باپتھ وفادار تہٕ بھروسہٕ منٛد۔ یہُوواہنؔ واتنووُس بہٕ یتھ سفرس دوران سیٚودے پننِس آغہٕ سنٛدین رشتہٕ دارن ہُنٛد گرٕ!
\v 28 امہِ کورِ نیٚیہ کُنی دور پننہِ ماجہِ ہنٛدین گرِکیٚن نِش تہٕ ونُن تہِ سورےٕ یہِ سپُدمُت اوس۔
\v 29 رِبقہؔ ہس اوس اکھ بوے یمِس لابنؔ ناو اوس۔ لابنؔ گو جلدےٕ نوکرس نِشہ یُس کریرِس نِش بہِتھ اوس۔
\v 30 تٔمؠ وُچھ پننہِ بیٚنہِ نریٚن منٛز کٔرؠ تہٕ نستہِ دٲیرٕ تہٕ بیٚیہِ بوزُن رِبقہؔ ہُن تہِ سورےٕ یہِ تٔمؠ نفرن تمِس ونمُت اوس۔ تٔمؠ وُچھ نیٚبر نیرتھ سُہ نفر کریرِس نکھٕ اونٛٹن نِش ودٕنؠ۔
\v 31 تٔمؠ وُن تس نفرس، "ژےٚ چھیٚنےَ یہُوواہؔ ہن برکت عطا کٔرمٕژ۔ ولہٕ! ژٕ کیازِ چُھکھ یتِتھ ۅدٕنؠ روزِتھ؟ مےٚ تھوو چانہِ باپتھ کمرٕ تہٕ چانیٚن اونٛٹن ہنٛدِ باپتھ جاے تیار کٔرِتھ۔"
\v 32 تہٕ یہِ نوکر گو یہُنٛد گرٕ تہٕ لابن سنٛدیو نوکرو وول اونٛٹن بور۔ تم گے اونٛٹن ہنٛدِ باپتھ گاسہٕ تہٕ کھیٚن تہٕ أمِس تہٕ امسنٛدین موہنِوین کھوٚر چھلنہٕ باپتھ آب اننہِ۔
\v 33 تِمو تھوو تمِس کھیٚنہٕ خٲطرٕ کھیٚن برونٛہہ کنہِ مگر تٔمؠ ونُکھ، یۅتام نہٕ بہٕ توٚہہِ سٟتؠ کتھ کرٕ تۅتام کھیٚمہٕ نہٕ بہٕ کِہین۔ "پتہٕ ونُس لابننؔ، "ون اسہِ!"
\v 34 نوکرن ونُس بہٕ چُھس ابرہامؔ سُنٛد نوکر۔
\v 35 یہُوواہؔ ہن چھےٚ میانِس آغس واریاہ برکت کٔرمٕژ۔ سُہ چُھ سٮ۪ٹھاہ امیر۔ یہُوواہنؔ چھِ تمِس واریاہ تیٖر سوزمٕتؠ، واریاہ سۅن تہٕ چٲنٛدؠ، موٚہنی تہٕ دایہ، اونٛٹ تہٕ خر دتمٕتؠ۔
\v 36 میانِس آغہٕ سنٛزِ خاندارنہِ سارہؔ نِش چُھ تمِس اکھ نیٚچو زامُت ییٚلہ سۅ سیٹھاہ بزرگ ٲس، تہٕ میانؠ آغن دیُت تمِس تہِ سورےٕ یہِ تسُند چُھ۔
\v 37 میانؠ آغن کرنووُس بہٕ وعدہ تہٕ ونُن، میانِس نیٚچوِس أنزیٚن نہٕ کنعان کیٚن لوٗکن ہنٛز کانٛہہ کور نیتٕرؠ یتھ ملکس منٛز أسؠ بسان چھِ۔
\v 38 امہِ بجایہ گژھِ ژٕ میانِس مٲلؠ وطنَس منٛز پننٮ۪ن قبیلہٕ کیٚن نِش واپس تہٕ تِموےٕ منٛزٕ انُن مینِس نیٚچوِس باپتھ اکھ خاندارنؠ۔"
\v 39 پتہٕ پرُژھ مےٚ پننِس مٲلکس، اگر تِمو مےٚ کانٛہہ زٔنؠ دِژ تہٕ سۅ ییہِ نہٕ مےٚ سٟتؠ یور واپس۔ بہٕ کیاہ کرٕ؟
\v 40 تِمو دیُت مےٚ جواب، "یہُوواہؔ یمسنٛز بہٕ ہمیشہٕ فرمانٛبردٲری کران چُھس، سوزِ پنُن فرشتہٕ ژےٚ سٟتؠ یُس ژےٚ اتھ سفرس منٛز رہبری کٔری۔ سُہ بنٲوی ژےٚ اتھ قٲبل زِ ہیککھ میانہِ قبیلہٕ منٛزٕ میانِس مٲلؠ سٕنٛدِ خاندانہٕ انٛدرٕ میانِس نیٚچوِس باپتھ نیتھٕر أنِتھ۔
\v 41 یوٚدوے میانہِ قبیلٕکؠ تمِس ژےٚ سٟتؠ یور واپس ینُک اجازت دِن نہٕ تہٕ ژٕ سپدکھ ملعون سپدنہٕ نِشہ رِہا۔ تکیازِ ژےٚ مٲنِتھ نہٕ میانؠ کتھ۔"
\v 42 از ییٚلہ بہٕ کریرِس پٮ۪ٹھ ووتُس، مےٚ موٚنگ دُعا، "اے یہُوواہؔ! خدا یمسنٛز عبادت میٚون آغہٕ ابرہامؔ کران چُھ، اگر ژٕ میٚون یہِ سفر کامیاب کرُن یژھان چُھکھ، مہربٲنی کٔرِتھ کرِ تہٕ یہِ۔
\v 43 بہٕ چُھس أکِس کریرِس نِش کھڑا یتہِ زنہِ آب نِوان چھےٚ۔ بہٕ چُھسے ژےٚ پرِژھان زِ اگر بہٕ کانٛسہِ زنہِ ونہٕ، "مہربٲنی کٔرِتھ دتہٕ مےٚ پننہِ نٹہِ منٛزٕ تریشہٕ داما چیٚنہٕ باپتھ۔"
\v 44 تہٕ اگر سۅ مےٚ ونہ، "چیٚیو عٲش کٔرِتھ، تہٕ بہٕ تھاوو تہنٛدیو اونٛٹو باپتھ تہِ کینٛہہ آب، "تہٕ یہےَ آسہ سۅ زٔنؠ یۅسہ ژےٚ میانِس آغہٕ سٕنٛدِس نیٚچوِس باپتھ ژٲرمٕژ چھیٚتھَ!
\v 45 امہِ برونٛہہ زِ بہٕ موٚکلاوٕہا دُعا کٔرِتھ، رِبقہؔ وٲژ پنُن نوٚٹ نکھس پٮ۪ٹھ ہیٚتھ مےٚ نزدیک۔ سۅ گییہِ کریرِس نِش تہٕ چیٚیَن تریش۔ مےٚ وُن تس، "مہربٲنی کٔرِتھ چیاو تہٕ مےٚ تریش!
\v 46 تٔمؠ تروو جلدےٕ پنُن آبہٕ نوٚٹ پتھر تہٕ ونُن، "چیٚیو! بہٕ انو تہنٛدین اونٛٹن باپتھ تہِ آب بٔرِتھ۔ "لہٰذا چیٚیہِ میٚتہِ تریش، تہٕ تمہِ أنؠ میانیٚو اونٛٹو باپتھ تہِ تریش۔
\v 47 پتہٕ پرُوژھ مےٚ تس ژٕ کہنٛز کور چھیٚکھ۔ تمہِ وُن بہٕ چھیٚس بیتوایلؔ سنٛز کور، نحورؔ سُنٛد نیٚچو تہٕ یمسنٛز خانہ دارِنؠ ملکہ چھےٚ۔ مےٚ لوگ تمؠ سنٛزِ نستہِ دٲیرٕ تہٕ نریٚن لٲگمَس کٔرؠ۔
\v 48 پتہٕ نمیوس تہٕ کوٚرم یہُوواہؔ ہس سجدٕ۔ مےٚ کوٚر یہُوواہؔ سُنٛد شکریہ ادا یمؠ سنٛز عبادت میٚون آغہٕ ابرہامؔ کران چُھ تہٕ یمؠ مےٚ سیٚز وتھ ہٲو یُتھ بہٕ پننِس آغہٕ سٕنٛدِس بٲے سنٛز کور پننِس آغہٕ سٕنٛدِس نیٚچوِس سنٛز خاندارنؠ بنٲوِتھ ہیٚکن۔
\v 49 وۅنؠ اگر ژٕ میانِس آغس سٟتؠ تمہِ سٕنٛدِ خاندانکہِ اکہِ حصہٕ رنٛگؠ وفادٲری کٲم ہیٚکھ تیٚلہ ون مےٚ زِ ژٕ کرکھ تی یہِ بہٕ ونہٕ۔ اگر ژٕ تہِ کرکھ نہٕ تتہِ ون مےٚ۔ تاکہِ مےٚ لگہ پےَ کرُن کیاہ چُھ۔
\v 50 لابنؔ تہٕ بیتوایلؔ ؤتھؠ در جواب، "یہِ چُھ یقینن یہُوواہؔ سٕنٛدِ طرفہٕ آمُت۔ لہٰذا ہیٚکو نہٕ أسؠ دوٚنوے یہِ ؤنِتھ زِ یہِ چھا صحی کِنہ غلط کٲم۔
\v 51 رِبقہ چھےٚ یکیاہ توٚہہِ برونٛہہ کنہِ۔ رٔٹوون تہٕ نیرؠ تو، تہٕ یہُوواہؔ سٕنٛدِ یژھنہٕ مطٲبق بنٲوتون پننِس آغہٕ سٕنٛدِس نیٚچوِس سنٛز گرٕ واجِنؠ۔
\v 52 ییٚلہ ابرہامؔ سنٛدؠ نوکرن یمہٕ کتھٕ بوزٕ تٔمؠ دیُت زمینس پٮ۪ٹھ سجدٕ۔
\v 53 پتہٕ کٔڈؠ نوکرن چانٛدِ تہٕ سۅنہٕ سنٛدؠ زیور تہٕ پلو، دِتِن رِبقہ ہس کُن۔ امہِ پتہٕ دِتِن کینٛہہ تحفہٕ تمسنٛدس بٲیس لابنسؔ تہٕ تمؠ سنٛزِ ماجہِ۔
\v 54 پتہٕ کھیٚو تِمو کھیٚن چیٚنہٕ۔ تم نفر یم ابرہامؔ سٕنٛدِس نوکرس سٟتؠ ٲسؠ امہِ دوٚہہ راتس تہٕ، أتؠ۔ بیٚکہِ دوٚہہ صبحٲے، ووٚن نوکرن، "وۅنؠ دیو مےٚ پننِس مٲلکس نِش واپس گژھنُک اجازت۔
\v 55 مگر تمسنٛدؠ بٲے تہٕ تمؠ سنٛزِ ماجہ ونُس یورٕ، کورِ دیو کمس کم دہن دوٚہُن یتہِ روزنہٕ، تمہٕ پتہٕ نیتون سۅ توٚہؠ تہٕ گٔژھؠ تو عٲش کٔرتھ۔
\v 56 مگر تٔمؠ وُن تِمن، "یہُوواہنؔ دِژ مےٚ یتھ سفرس کامیٲبی۔ لہٰذا مٕہ کٔریٚو مےٚ ژیر، مےٚ دی وون وُنؠ یہِ پننِس آقا سنٛدِس ملکس منٛز جلدےٕ واتناونہٕ۔
\v 57 تِمو وُنہس، "ؤلِو أسؠ انوون کورےٕ بلٲوِتھ تہٕ وُچھو سۅ کیاہ چھےٚ یژھان کرُن۔
\v 58 پتہٕ أنؠ تِمو رِبقہؔ ناد دِتھ تہٕ پرُژھہس، "کیاہ ژٕ گژھِ کھا وُنؠ یمسےٕ نفرس سٟتؠ؟ تمہِ وُن تورٕ، آ، بہٕ گژھٕ۔
\v 59 لہٰذا دِژ تِمو تس سۅ لونٛڈی رِبقہؔ سٟتؠ یۅسہ ہمیشہٕ تمِس رچھان تہٕ پلزان ٲس تہٕ کٔرکھ ابرہامؔ سٕنٛدِس نوکرس تہٕ تمِس سٟتؠ آمتیٚن نفرن سٟتؠ روانہٕ۔
\v 60 پتہٕ کوٚر تِمو خدایس کُن رجوع تہٕ مونٛگکھ رِبقہؔ ہنٛدِ حقہٕ برکٔژ ہُنٛد دعا تہٕ ونُکھ تمِس۔ "سانؠ بیٚنؠ، أسؠ چھی ژےٚ دعا کران زِ یہُوواہؔ سوزؠ نےَ لچھ اولاد تہٕ تِمو ذرؠ یہِ لٔگن تِمن سارنی لوٗکن شِکس یم تِمن نفرت کران چھِ۔"
\v 61 پتہٕ گییہِ رِبقہؔ تہٕ تمؠ سنٛزٕ دایہ تیار۔ تِم سپزٕ اونٛٹن پٮ۪ٹھ سوار تہٕ درایہ ابرہامؔ سنٛدین نوکرن سٟتؠ۔ تِم دراے وُنؠ رِبقہ ہیٚتھ۔
\v 62 وُنؠ اوس اسحاق جنوبی یہُودیہ کیٚن بیابانن منٛز روزان۔ سُہ اوس بیر لحی روئی پٮ۪ٹھٕ آمُت۔
\v 63 اکہِ دوٚہہ شامس اوس اسحاق سونچان سونچان نیٚبر کُن چکرس درامُت۔ تٔمؠ دِژ ہیٚور کُن نظر اتہِ سپزٕس حٲرت ییٚلہِ کینٛہہ اونٛٹ یوان وُچَھن۔
\v 64 رِبقہؔ ہہِ تہِ پییہِ نظر تہٕ اتہِ وچُھن اضحاقؔ۔ سۅ وژھ اونٛٹہٕ پٮ۪ٹھٕ بوٚن
\v 65 تہٕ پرژھن نوکرس، ہُہ نفر کُس چُھ یُس اسہِ کُن یوان چُھ؟" نوکرن دتُس جواب، "یہِ چُھ میٚون آغہٕ اضحاقؔ۔ "تمہِ وول نقاب بوٚن تہٕ تھووُن پنُن بُتھ ژورِ تاکہِ تمِس برونٛہہ کنہِ کرِ حیا ہُک مظاہرٕ۔
\v 66 نوکرن وُن اضحاقسؔ تہِ سورےٕ یہِ سپُدمُت اوس۔
\v 67 پتہٕ نیٚیہ اسحاقنؔ رِبقہ تتھ خٟمس منٛز یُس تمؠ سنٛزِ ماجہِ سارہؔہِ ہُنٛد اوس۔ وُنؠ بنییہِ سۅ تمؠ سنٛز خاندارنؠ۔ سُہ اوس تمِس لول بران۔ یتھ پٲٹھؠ گو اضحاقسؔ پننہِ ماجہِ ہُنٛد مرُن مٔشِتھ۔
\c 25
\p
\v 1 سارہؔ ہُنٛد، مرنہٕ پتہٕ کینٛژِ کٲلؠ کوٚر ابرہامنؔ بیٚیِس أکِس زنہِ سٟتؠ خانٛدر یمِس قطورہؔ ناو اوس۔
\v 2 یمِس پتہٕ شےٚ نیٚچوؠ زاے: زمرانؔ، یقسان، مِدان، مِدیان، اسباق تہٕ سوخؔ
\v 3 یقسان بنیاو دوٚن نیٚچوٮ۪ن سباؔ تہٕ دِدانؔ سُنٛد مول، ددانؔ سنٛدیو اولادو منٛزٕ ٲسؠ اسوریؔ، لطوسیؔ تہٕ لومیؔ۔
\v 4 مِدیان سنٛدیو اولادو منٛزٕ ٲسؠ عیفاہؔ، عفرؔ، حنوکؔ، ابیداعؔ تہٕ الدوعاؔ۔ یم سٲری ٲسؠ قطورہؔ سٕنٛدِ قبیلٕکؠ۔
\v 5 ابرہامنؔ کوٚر اعلان زِ میانہ مرنہٕ پتہٕ گژھِ میانؠ سٲرےٕ وراثت اضحاقسؔ ترٕنؠ۔
\v 6 مگر ییٚلہ ابرہامؔ زندٕ اوس تٔمؠ دٕتؠ پننٮ۪ن لونڈین ہنٛدین شُرین تحفہٕ تہٕ تمہٕ کٔڈِن پننٮ۪ن شُریٚن اضحاقسؔ نِش دوٗر تھاونہٕ موٚکھٕ مشرق کِس أکِس ملکَس منٛز روزنہٕ باپتھ۔
\v 7 ابرہامؔ رود أکِس ہتَس تہٕ پنٛژستتھن ورؠ ین زندٕ۔
\v 8 ابرہام گُزریو سیٹھاہ جان وانٛسہِ منٛز۔ تہٕ ووت پننٮ۪ن گُزریامتیٚن مٲلِس تہٕ بُڈؠ ببَس نِش۔
\v 9 تمسنٛدیو اولادو اضحاقؔ تہٕ اسماعیلنؔ دفنٲو تمؠ سنٛز میت ممرےؔ یس نکھٕ مکفیلہؔ زمینچہ تتھ قبرِ منٛز یۅسہ ابرہامنؔ حِتی سٕنٛدِس زُرِس عِفرون بنِ صُحرؔس ہیٚژمٕژ ٲس۔
\v 10 یہِ چھےٚ سۅ جاے یتِتھ اسحاقنؔ تہٕ اسماعیلنؔ اہنٛز لاش دفن کٔر یتھ جایہ ابرہامنؔ پنٕنؠ گرٕواجنؠ سارہؔ ہنٛز میت دفن کٔرمٕژ ٲس۔
\v 11 ابرہامؔ سٕنٛدِ مرنہٕ پتہٕ کٔر خداین تمسٕنٛدِس نیٚچوِس اضحاقسؔ کٲفی برکت۔ اضحاقؔ اوس بیر لحی روئی نزدیکےٕ روزان۔
\v 12 یم ٲسؠ تم لوٗکھ یم ابرہامؔ سٕنٛدِس فرزنٛد اسماعیلؔ سٕنٛدِ پُشتہٕ منٛزٕ چھِ یمن سارہؔ ہنٛزِ دایہ حاجرہؔ ہن مِصرس منٛز زایُن دیتمُت اوس۔
\v 13 تِمن ہنٛدؠ ناو چھِ زیٚنہٕ ترتیبہٕ حسابہٕ یتھ کِنؠ: اسماعیلؔ سٕنٛدِس بٔڈس نیٚچوِس اوس نبایوتؔ ناو۔ تمِس پتہٕ اوس کیدار، ادبئیلؔ، مِبسامؔ
\v 14 مِشماعؔ، دُومہؔ، مِساؔ
\v 15 حددؔ، تیما، یطورؔ، نفیس تہٕ قِدمہؔ۔
\v 16 اسماعیلؔ سنٛدؠ یم باہ اولاد بنیاے تِمن قبیلن ہنٛدؠ سردار یمن ہنٛدِ ناوٕ یم زاننہٕ آے تہٕ یمن سارنےٕ ٲسؠ پن پننٕنؠ علاقہٕ تہٕ پنٕنؠ پنٕنؠ بستی۔
\v 17 اسماعیلنؔ پرٲو 137 وری وانٛس۔ پتہٕ گُزریو تہٕ گو پننٮ۪ن جدٕ اجدادن منٛز شٲمل یمہٕ گۅڈے گزریمٕتؠ ٲسؠ۔
\v 18 تہنٛدؠ اولاد سپدؠ مِصرٕ کیٚن سرحدن نکھٕ شُور تہٕ حویلؔہ کیٚن درمیانی علاقن منٛز آباد یپٲرؠ کانٛہہ تہِ فرٕد اسُورؔ کُن سفر کران چُھ۔ مگر تم ٲسؠ نَہ ہمیشہ امنہٕ سان روزِتھ ہیکان۔
\v 19 ابرہامؔ سٕنٛدِس نیٚچوِس اضحاقسؔ متعلق تہِ سپُد یی۔ ابرہامؔ بنیاو اسحاق سُنٛد مول۔
\v 20 ییٚلہِ اضحاقؔ ژتجی وۅٚہر ووت تہٕ تٔمؠ کوٚر بیتوایلؔ سنٛزِ کورِ رِبقہؔ ہس سٟتؠ خانٛدر۔ فدن ارامٕکؠؔ روزن وٲلؠ بیتوایلؔ اوس ارامؔ سنٛدیو اولادو منٛزٕ۔ رِبقہ ٲس لابنؔ سنٛز بیٚنہِ یس ارام کیٚن لوٗکن سٟتؠ تعلُق اوس۔
\v 21 یمن سٟتؠ خاندر کٔرتھ زاو نہٕ رِبقہؔ ہس واریہس کالس اولادےٕ۔ مگر اسحاقنؔ مونٛگ پننہِ آشنہِ ہنٛدِ حقہٕ یہُوواہسؔ دعا تہٕ یہُوواہؔ ہَن کوٚر تمسُنٛد دعا قبول۔ تمؠ سنٛز خاندارنؠ روز بیٚیہِ زُووٕ۔
\v 22 تٔمس ٲسؠ زٕ بچہٕ ہیٚنہٕ آمٕتؠ یم اکھ أکِس سٟتؠ ژُوان ٲسؠ۔ تہٕ تمہِ وُن، "مےٚ سٟتؠ کیازِ چُھ یہِ سپدان؟" اوے پرُوژھ تمہِ اتھ متعلق یہُوواہسؔ
\v 23 یہُوواہنؔ وُن تس، "ژےٚ چھےَ دوٚچ تہٕ تِمو سٟتؠ ین زٕ قوم وجودس۔ تِم زٕ قوم گژھن اکھ أکِس نِشہ الگ۔ تِم آسن اکھ أکِس کھۅتہٕ زوراور تہٕ زِٹھؠ کرن کانٛسیٚن ہنٛز خدمت۔
\v 24 ییٚلہِ رِبقہؔ خلاص سپٕز تہٕ یہِ دراو پوٚز! دوٚکہِ لڑکہٕ زے۔
\v 25 یُس گۅڈٕ زاو سُہ اوس وزُل تہٕ تمسنٛدس جسمس ٲس گٔنؠ جتھ۔ امہ کِنؠ تھووُکھ تس عیسوؔ ناو
\v 26 پتہٕ زاو تمسُنٛد بوے یُس عیسوؔ ہس کھورِ تھپھ کٔرِتھ اوس۔ امہ کِنؠ تھوو تِمو تس یعقوبؔ ناو۔ تمہِ وزِ اوس اسحاق شیٹھٕ وہُر ییٚلہِ تس دوٚکہِ بچہٕ زاے۔
\v 27 ییٚلہِ یم بچہ بٔڈؠ گے، عیسوؔ بنیاو جنٛگلؠ جانورن ہُنٛد اکھ جان شکٲرؠ۔ تٔمؠ گُزور واریاہ وقت کھہَن منٛز۔ ییٚلہِ زن یعقوبؔ اکھ خاموش شخص گرسےٕ انٛدؠ پٔکؠ روزان اوس۔
\v 28 اضحاقسؔ اوس عیسوؔ زیادٕ ٹوٹھ تکیازِ تٔمؠ وُچھ تِمن جانورن ہنٛدِ مازُک مزٕ یم عیسوؔ ماران اوس۔ ییٚلہِ زن رِبقہؔ ہس یعقوبؔ زیادٕ ٹوٹھ اوس۔
\v 29 اکہ دوٚہہ ییٚلہ یعقوبؔ سیُن رنان اوس ییٚلہ عیسوؔ کھہہ پٮ۪ٹھٕ بۅچھِ ہوٚت گرٕ آو۔
\v 30 تٔمؠ وُن یعقوبسؔ، "وُنہ کیٚن دتہٕ مےٚ ہُمہ ۅزلہِ سِنہِ منٛزٕ کینٛہہ کھیٚنہٕ خٲطرٕ تکیازِ مےٚ چھےٚ بۅچھِ لٔجمٕژ۔ اوے اوس عیسوؔ ہس بیاکھ ناو عدومؔ
\v 31 یعقوبنؔ ونُس، "بہٕ دِمے، اگر ژٕ مےٚ پنُن زیُٹھ آسنُک حق دِکھ بہٕ بناوتھ ژٕ مٲلؠ سٕنٛدِس زیادس دولتَس حقدار۔"
\v 32 عیسوؔ ہن ونُس، "اچھا، بہٕ چُھس بۅچھِ سٟتؠ مران۔ اگر بہٕ وُنؠ مودُس تہٕ میانؠ حقوق کتھ ین مےٚ بکار۔"
\v 33 یعقوبنؔ ونُس، "میٚون قسم ہاو زِ ژٕ چُھکھ مےٚ پننِس زِٹھس بٲے سُنٛد حق دِوان۔ "حلانکہِ عیسوؔ ہن کوٚر تی۔ تٔمؠ دِتؠ پننہِ زِچھرٕکؠ حقوق یعقوبسؔ۔
\v 34 پتہٕ دژٕ یعقوبنؔ عیسوؔ ہس کینٛہہ ژۅچہِ دال تہٕ سیُن۔ عیسوؔ ہن کھیٚو چیٚو پتہٕ وُتھ تہٕ دراو۔ یہِ کٔرتھ کوٚر یسوؔ ہن ثٲبت زِ سُہ چُھنہٕ زِٹھؠ سنٛدِ حثیتہٕ پننیٚن حقوقن سٟتؠ دلچسپی تھاوان۔
\c 26
\p
\v 1 کینٛژِ کٲلؠ وُتھ ملکس منٛز سخت دراگ۔ یہِ دراگ اوس تمہِ دراگہٕ نشہٕ مختلف یُس ابرہامؔ سٕنٛدِ وقتہٕ آمُت اوس۔ لہٰذا گو اضحاقؔ فلستینی لوٗکن ہنٛدِس بادشاہ ابیملِکسؔ سٟتؠ کتھ کرنہِ جنوب مشرق کِس جرار شہرس منٛز۔
\v 2 مگر خداوند یہُوواہؔ گو ظٲہر تہٕ وُننَس، "مِصر مٕہ گژھِ! تتھ ملکس منٛز روز یُس بہٕ ونےَ!
\v 3 تتھ ملکس منٛز روزِتھ دِمے بہٕ مدد تہٕ بیٚیہِ کرے برکت۔ تکیازِ بہٕ دِمے ژےٚ تہٕ چانیٚن اولادن یہِ سٲرےٕ زمین تہٕ یُس وعدہ مےٚ چٲنِس مٲلس ابرہامس سٟتؠ کوٚرمُت چُھ سُتہ کرٕ پورٕ۔
\v 4 بہٕ پھٲلاون چٲنؠ ذریاتھ آسمان کیٚن تارکن ہنٛدؠ پٲٹھؠ۔ بہٕ دمہٕ چانیٚن اولادن یہِ سٲرےٕ زمین تہٕ چٲنؠ اولاد بناوکھ تمام لوٗکن باپتھ برکتٕکؠ بٲعث۔
\v 5 بہٕ کرٕ یہِ ضرور تکیازِ ابرہامنؔ کٔر میانؠ عبادت۔ تٔمؠ کٔر تِمن سارنےٕ کتھں ہنٛز تعمیل یمہٕ مےٚ تس کرنہٕ خٲطرٕ ونہِ، تہٕ سورےٕ یہِ کرنُک مےٚ حکم تس کوٚر، تہِ سورےٕ یمیُک مےٚ اعلان کوٚر تہٕ تِم سٲری قانون یم مےٚ تس دِتؠ۔
\v 6 اوے رود اضحاقؔ پنٕنؠ گرٕ واجِنؠ تہٕ شُرؠ ہیٚتھ جرار شہرس منٛز۔
\p
\v 7 ییٚلہِ جرار کیٚو مردو پرُژھ زِ یہِ زٔنؠ کۅسہٕ چھےٚ تہٕ اسحاقنؔ وُن، "یہِ چھےٚ مےٚ بیٚنہِ۔ "تٔمؠ وُن یہِ اوٕ موٚکھٕ تکیازِ سُہ اوس یہِ وننہٕ کھوٚژان زِ "سۅ چھےٚ مےٚ خاندارِنؠ۔ تٔمؠ سونچ "رِبقہ چھےٚ سیٹھاہ خوبصورت، یمہِ کِنؠ تمِس تم یژھن۔ تمِ ہیٚکن تمِس حٲصل کرنہٕ خٲطرٕ مےٚ مٲرِتھ تہِ۔"
\v 8 ییٚلہِ وُنؠ اضحاقسؔ تتہِ واریاہ کال گو تہٕ اکہ دوٚہہ دِژ فلستینیؔ بادشاہ ابیملِکنؔ پننہِ محل خانچہِ دارِ کِنؠ بوٚن کُن نظر تہٕ گو یہِ وُچِھتھ حٲران زِ اسحاق اوس پننہِ آشنہِ رِبقہؔ ہس سٟتؠ لول بٲگران۔
\v 9 پتہٕ اننوو ابیملِکنؔ اسحاق ناد دِتھ تہٕ وننَس، "وُنؠ توٚر مےٚ فکرِ زِ یہِ چھےٚ ژےٚ پزی خاندارِنؠ۔ ژےٚ کیازِ ونُتھ "یہِ چھےٚ مےٚ بیٚنہِ" اسحاقنؔ ونُس یورٕ، مےٚ وُن یہِ اوٕ موٚکھٕ تکیازِ مےٚ سونچ یہِ حٲصل کرنہٕ خٲطرٕ ہیٚکہِ مےٚ یتہِ کانٛہہ مٲرِتھ۔"
\v 10 ابیملِکنؔ ونُس، "ژےٚ پٔزہی نہٕ اسہِ سٟتؠ یہِ کرُن۔ بنان چُھ زِ سانیٚو نفرو منٛزٕ آسہ ہے کانٛہہ تُہنٛزِ خاندارنہِ نِش شونٛگمُت، تہٕ ژٕ بناوہکھ اسہِ بڈِ گُنہٕکؠ سزاوار۔"
\v 11 پتہٕ دیُت ابیملِکنؔ پننٮ۪ن تمام لوٗکن حکم زِ "یمِس نفرس تہٕ یمسنٛزِ خاندارنہِ واتنٲوؠ زیٚو نہٕ کانٛہہ نقصان۔ یُس تہِ یُتھ کینٛہہ کرِ تمِس ییہِ، سزایہِ موت دِنہٕ!
\v 12 امہِ ورؠ یہِ ووُ اسحاقنؔ اتھ زمینس بیٚول تہٕ لوننَس کافی پھسٕل، تکیازِ یہُوواہؔ ہن کٔر تس برکت۔
\v 13 اسحاق رود زیادٕ کھۅتہٕ زیادٕ مال ۅپداوان یۅتام سُہ واریاہ دولت منٛد سپُد۔
\v 14 تمِس نِش ٲسؠ تیر، ژھاوِلؠ تہٕ چارواین ہنٛدؠ بٔڈؠ بٔڈؠ کھیٚلؠ تہٕ واریاہ غلام۔ یمہِ کِنؠ فلستین تمسُنٛد حسد وُتھ۔
\v 15 تہٕ تِمو پُرنٲوؠ تِم سٲری کریرؠ یم ابرہامنؔ تہٕ تمسنٛدیو نوکرو کٔھنمٕتؠ ٲسؠ۔
\v 16 ابیملِکنؔ وُن پتہٕ اضحاقسؔ، "توٚہؠ گوو وُنؠ سانہِ کھۅتہٕ زیادٕ، امہِ کِنؠ چُھس بہٕ یژھان زِ توٚہؠ نیریٚو سانہٕ علاقہٕ منٛزٕ۔"
\v 17 پتہٕ دراو اسحاق تہٕ تمسُنٛد خاندان تتہِ۔ جرار وادی منٛز وٲتِتھ دتِکھ تتہِ پنٕنؠ خٟمہ تہٕ لٔگؠ تٔتؠ بسنہِ۔
\v 18 اتھ علاقس منٛز ٲسؠ واریاہ کریرؠ یم اسحاق سٕنٛدِس مٲلؠ ابرہامؔ سٕنٛدِ وقتہٕ کھننہٕ آمٕتؠ ٲسؠ مگر فلستینیو ٲسؠ تِم ابرہامؔ سٕنٛدِ مرنہٕ پتے میٚژِ سٟتؠ پُرنٲومٕتؠ۔ مگر اسحاق تہٕ تمسنٛدیو نوکرو کھننٲوؠ یم کریرؠ دبارٕ تہٕ اسحاقنؔ تھٲوؠ یمن کریریٚن تِمے ناو یم تمسںنٛدؠ مٲلؠ تِمن کٔرمٕتؠ ٲسؠ۔
\v 19 اضحاقؔ سنٛدیو نوکرو کوٚر وادی منٛز تازٕ آبُک اکھ کریور دٔرؠ یاف۔
\v 20 مگر جرارؔ وادی منٛز چاروٲے رچھن والیٚو لوٗکو لوگ اضحاقؔ سنٛدؠ چاروٲے رچھن والیٚن نفرن سٟتؠ تکرار کرُن۔ وننہِ لٔگؠ زِ یمہِ کریریُک آب چُھ سون۔ امہِ کِنؠ تھوو اسحاقنؔ اتھ کریرِس عِسقؔ ناو۔ یمیُک مطلب "تنازٕ "چُھ۔ تکیازِ اتھ پٮ۪تھ اوس تنازٕ وُتھمُت زِ امیٚک مٲلکھ کُس چُھ۔
\v 21 پتہٕ پوٚز اسحاق سنٛدیو نوکرو بیاکھ کریٚور مگر تتھ پٮ۪ٹھ تہِ ؤژھ لڑٲے زِ یہِ کوٚہُنٛد چُھ۔ تہٕ اتھ تھوو اسحاقنؔ سِتنہؔ ناو، یمیٚک مطلب "مخالفت" چُھ
\v 22 تِم دراے اتِتھ تہٕ برونٛہہ پہَن پٔکِتھ کھُنُکھ بدل کریٚور۔ مگر وُنؠ کٔرنہٕ اتھ پٮ۪ٹھ کانٛسہِ لڑٲے زِ امیٚک مٲلکھ کُس چُھ۔ تہٕ تٔمؠ تھوو اتھ "رحوبوتؔ" ناو یمیٚک مطلب "خٲلی جاے" چُھ۔ ونان چُھ زِ "یہُوواہؔ ہن دِژ اسہِ روزنہٕ خٲطرٕ یہِ خٲلی جاے، سۅ جاے یتھ نہٕ باقےٕ لوٗکھ یژھان چھِ۔ تہٕ أسؠ روزو یتہِ واریاہ خوشحال۔"
\v 23 اتہِ پٮ۪ٹھٕ گو اسحاق بیرسبعؔ
\v 24 گۅڈنچہِ رٲژ ییٚلہِ سُہ تتہِ اوس، یہُوواہؔ سپُد تس نِش ظٲہر تہٕ وُننَس، "بہٕ چُھس سُہ خدا یمسنٛز عبادت چٲنؠ مٲلؠ ابرہامنؔ کٔر۔ کُنہِ چیزس مٕہ کھوٚژ۔ بہٕ کرے ژےٚ مدد، بہٕ دِمے ژےٚ برکت تہٕ یُس وعدہ مےٚ پننِس بنٛدس ابرہامس سٟتؠ کوٚرمُت چُھ زِ بہٕ بڑاوَن چٲنؠ ذریاتھ واریاہ۔"
\v 25 لہٰذا بنٲو اسحاقنؔ تتہِ اکھ قربان گاہ تہٕ خدایہ سنٛز عبادت کرنہٕ خٲطرٕ کریٚن قربٲنیہ پیش۔ تٔمؠ لٲگؠ تتہِ پنٕنؠ خٟمہٕ تہٕ تمسنٛدیو نوکرو لوگ کریٚور کھنُن۔
\v 26 ییٚلہِ تِم کریٚور کھنان ٲسؠ تہٕ بادشاہ ابیملِکؔ آو جرارؔ پٮ۪ٹھٕ اضحاقسؔ نِشہ پنُن مشیر احوزتؔ تہٕ سِپاہ سالار فیکلؔ ہیٚتھ۔
\v 27 اسحاقنؔ وُن تِمن، "توٚہہِ کوٚرو گۅڈٕ مےٚ سٟتؠ دشمنانہٕ رٔویہ تہٕ ژھنووس بہٕ کڈِتھ۔ تہٕ وُنؠ کیازِ او مےٚ نِش؟
\v 28 تِمو منٛزٕ وُن اکؠ، "اسہِ وُچھ زِ یہُوواہؔ چھی ژےٚ مدد کران۔ اوے وُن اسہِ اکھ أکِس زِ اسہِ تہٕ اضحاقسؔ درمیان گژھِ اکھ مہادٕ سپدُن۔ لہٰذا پزِ اسہِ توٚہہِ سٟتؠ صلحُک مہادٕ کرُن،
\v 29 زِ توٚہؠ واتنٲیو نہٕ اسہِ کانٛہہ نقصان، یتھ کِنؠ نہٕ اسہِ توٚہہِ سٟتؠ کانٛہہ زیادتی کٔر، اسہِ کوٚر توٚہہ سٟتؠ ہمیشہ رُت سلوک، تہٕ اسہِ کٔریٚو توٚہؠ امنہٕ سان رخصت۔ وۅنؠ چُھ یہُوواہؔ توٚہہِ برکت عطا کران۔"
\v 30 پتہٕ کٔر اسحاقنؔ ابی ملک تہٕ تہنٛدِٮ۪ن دوستن خٲطرٕ ضیافت تیار تہٕ تِمو کھیٚو چیو۔
\v 31 دویمہِ دوٚہہ صبحٲے کوٚر ساروٕے قسم زِ یم وعدہ اسہِ کٔرؠ تِم نباوو۔ پتہٕ سوزؠ اسحاقنؔ تِم اطمنانہٕ سان پنُن گرٕ۔
\v 32 امی دوٚہہ آے اسحاقٕنؠ نوکر تمِس نشہٕ تہٕ وُنہَس تتھ کریرِس متعلق یُس تِمو کھنِتھ مۅکلوو۔ تِمو وُن، "اسہِ آو کریرِس آب!
\v 33 اسحاقنؔ کوٚر اتھ کریرِس سبعؔ ناو یُس عِبرٲنؠ لفظ باسان چُھ، امیُک مطلب گو "عہد" موجودٕ دورس تام اوس امہِ شہرُک ناو "بیرسبعؔ" مطلب "امن مہادٕ کریٚور۔"
\v 34 ییٚلہِ عیسوؔ ژتجی وہُر ووت تہٕ تٔمؠ کوٚر بیری سنٛزِ کورِ یہودِت تہٕ ایلونؔ سنٛزٕ کورِ بشامتؔہِ سٟتؠ کھانٛدر۔ تم دونوے کورِ آسہٕ حِتی سنٛزٕ اولاد، نکہِ اسحاق سٕنٛدِ قبیلچہ۔
\v 35 عیسوؔ سنٛزو یمو دویو زنانو بنٲو اضحاقؔ تہٕ رِبقہؔ ہنٛز زنٛدگی وبال۔
\c 27
\p
\v 1 ییٚلہِ اسحاق بُڈیو، سُہ سپُد یہِ دٔپزِ تہِ اوٚن۔ اکہِ دوٚہہ اوٚن تٔمؠ پنُن زیُٹھ نیٚچو عیسوؔ ناد دِتھ تہٕ وُننَس، "میانہ گۅبرا؟" تٔمؠ ونُس، بہٕ چُھس یکیاہ۔"
\v 2 اسحاقنؔ ونُس، "میانؠ کتھ بوز۔ بہٕ چُھس وُنؠ سیٹھاہ بُڈیٚمُت، مےٚ چھنہٕ پتاہ زِ مےٚ کرِ آسہ مرُن۔
\v 3 لہٰذا تُل پنٕنؠ تیرکمان، سیٹھاہ تیرکش بٔرِتھ جنٛگل کُن تہٕ ان میانہٕ باپتھ جنٛگلی جانور شکار کٔرِتھ۔"
\v 4 اکھا مارُن تہٕ کرِ تمہِ قسمُک مزٕدار ماز تیار یُس مےٚ پسنٛد چُھ۔ پتہٕ ان سُہ مےٚ نِش تاکہِ سُہ کھیٚتھ کرے بہٕ مرنہٕ برونٛہہ ژےٚ دعایہ خٲر۔
\v 5 رِبقہ ٲس بوزان ییٚلہ اسحاق یہِ پننِس نیٚچوِس عیسوؔ ہس ونان اوس۔ تہٕ یتُھے عیسوؔ شکارس نیرنہٕ باپتھ خٟمہ منٛزٕ نیٚبر دراو،
\v 6 رِبقہؔ ہن ووٚن پننِس نیٚچوِس یعقوبس، "میانؠ کتھ بوز۔ مےٚ وُچھ چون مول چٲنِس بٲیس عیسوؔ ہس سٟتؠ کتھ کران، ونان اوسُس،
\v 7 گژھِ کانٛہہ جنٛگلؠ جانور انُن یور مٲرِتھ تہٕ مزٕدار طریقہٕ کرِ ماز تیار یُتھ بہٕ سُہ کھیٚتھ ہیٚکہٕ۔ مرنہٕ برونٛہہ منٛگے بہٕ رُت دعا یوٚدوے یہُوواہؔ بوزان آسہ۔"
\v 8 وُچھ سا میانہِ گۅبرا، یہِ بہٕ ژےٚ ونان چھیٚسےَ تی کر۔
\v 9 گژھِ کھیٚلہِ منٛز ان لۅکٕٹؠ ژھاوجہِ بچہ زٕ تہٕ مٲرِتھ انُکھ مےٚ نِش تہٕ بہٕ بناوے چٲنس مٲلس باپتھ مزٕدار کھیٚن، یتھ سُہ پسنٛد کرِ۔
\v 10 پتہٕ ہیککھ ژٕ سُہ پننِس مٲلس نِتھ یُتھ سُہ کھییہِ تاکہِ مرنہٕ برونٛہہ کری سُہ ژےٚ دعا۔
\v 11 مگر یعقوبنؔ وُن پننہِ ماجہ رِبقہؔ ہس، "میانِس بٲیس عیسوؔ سنٛزِ تنہِ چُھ مس تہٕ میانؠ تن چھنہٕ تِژھ۔ میانؠ تن چھےٚ صاف!
\v 12 اگر میٚون مول مےٚ اتھٕ سٟتؠ سارِ تیٚلہ کیاہ بنہِ؟ سُہ زانہِ پانے زِ بہٕ چُھس تس دونٛکھٕ دِوان، تہٕ مےٚ میلہِ رحمتہٕ بجایہ زحمت!
\v 13 تمؠ سنٛزِ ماجہِ وُن تمِس، "اگر تہِ سپُد تیٚلہ چھےٚ میانہِ گۅبرا مےٚ پٮ۪ٹھ لعنت۔ ژٕ کرِ تی یہِ بہٕ ژےٚ ونان چھیٚسےَ۔ گژھِ ژٕ ان میانہ خٲطرٕ ژھاوٕلؠ!"
\v 14 یتھ کِنؠ گو یعقوبؔ تہٕ اننؠ پننہِ ماجہ نِش ژھاولؠ زٕ مٲرِتھ۔ پتہٕ کوٚر تمؠ سنٛزِ ماجہِ مزٕدار سیٚون تیار، یتھ کِنؠ تمسنٛدس مٲلِس پسنںد چُھ۔
\v 15 پتہٕ أنؠ رِبقہؔ ہن پننِس بٔڈس نیٚچوِس عیسو سنٛدؠ اصل پلو یم تس خٟمَس منٛز ٲسؠ تہٕ لٲگِن پننِس لۅکٹِس نیٚچوِس یعقوبسؔ۔
\v 16 تٔمؠ تھٲو ژھاوجہِ بچن ہنٛز بستہٕ تمسنٛدین اتھن تہٕ گردٕنہٕ لٲگتھ۔
\v 17 پتہٕ دژٕ تٔمؠ کینٛہہ ژۅچہ تہٕ سُہ مزٕدار کھیٚن یُس تٔمؠ تیار اوس کوٚرمُت یعقوبسؔ اتھِ۔
\v 18 یعقوبنؔ روٚٹ تہٕ نیوٗن پننِس مٲلِس نِش تہٕ وُننَس، "میانہٕ ببا" اسحاقنؔ ونُس، "ونسا گۅبریا، کُس ہیٚو میٚون نیٚچو چُھکھ؟"
\v 19 یعقوبنؔ وُن پننِس مٲلِس، "بہٕ چُھسے چون زیُٹھ ہیٚوٗ نیٚچو عیسوؔ۔ مےٚ کوٚر تی یہِ ژےٚ مےٚ کرنہٕ خٲطرٕ ونُتھ۔ وۅتھ تہٕ کھیٚہ یہِ ماز تہٕ کرِ تہٕ مےٚ رُت دعا۔
\v 20 مگر اسحاقنؔ پرُوژھ پننِس نیٚچوِس، "میانہِ گۅبرا، یہِ کِتھٕ کِنؠ چُھ ممکن زِ ژٕ انہَن یوٖت جلد اکھ جانور لٔبتھ تہٕ مٲرِتھ؟" یعقوبنؔ ونُس در جواب، "تکیازِ یہُوواہؔ یمسنٛز ژٕ عبادت کران چُھکھ، دِژ مےٚ اتھ منٛز کامیٲبی۔"
\v 21 اسحاقنؔ وُن یعقوبسؔ، "میانہٕ گۅبرا، مےٚ نزدیک یہِ، تاکہِ بہٕ لاگے ژےٚ اتھٕ یُتھ مےٚ ننہِ زِ ژٕ چُھکھا پزی میٚون نیٚچو عیسوؔ۔
\v 22 چونکہِ یعقوبؔ گو پننِس مٲلِس اضحاقسؔ نکھٕ۔ اسحاقنؔ سور تمِس تہٕ ونُن، "آواز چھےٚ یعقوبٕنؠ، مگر اتھن چھِ مس وال بٔڈس بٲیس عیسوؔ سنٛدؠ پٲٹھؠ۔"
\v 23 اسحاقنؔ پرزٕنووےٕ نہٕ سُہ تکیازِ تس اوس نہٕ گاشےٕ تہٕ یعقوبٕنؠؔ اتھٕ ٲسؠ عیسو سنٛدؠ پٲٹھؠ جٔژ دار۔ اوٕ کِنؠ گو اسحاق تس دعا کرنہٕ خٲطرٕ تیار۔
\v 24 مگر گۅڈٕ پرِژُھس اسحاقنؔ، کیاہ ژٕ چُھکھا پزی میٚون نیٚچو عیسو؟" یعقوبن دتُس جواب، "آ، بےٕ چُھس۔"
\v 25 اسحاقنؔ ونُس، گۅبریا، یُس ماز ژےٚ رنُتھ تمہِ منٛزٕ ان رژھ کھنٛڈ مےٚ نِش، آ، یُتھ بہٕ سُہ کھیٚمہٕ تہٕ پتہٕ کرے بہٕ ژےٚ دُعا۔ تہٕ یعقوبنؔ اوٚن أمِس کھیٚنہٕ خٲطرِ کہتام تہٕ تٔمؠ کھیٚو۔ یعقوبنؔ اوس تمِس باپتھ شراب تہِ اوٚنمُت تہٕ تٔمؠ چیو سُتہ۔
\v 26 پتہٕ وُن تمسںنٛدؠ مٲلؠ اسحاقنؔ تمِس۔ "میانہِ گۅبرا، ولہٕ یورؠ تہٕ کرِ تہٕ مےٚ میٚوٹھاہ۔"
\v 27 تہٕ یعقوبؔ گو تمِس نِش تہٕ تمسنٛدؠ مٲلؠ کوٚر تمِس بُتھِس میوٗٹھ۔ اسحاقنؔ ہیٚوت تمسنٛدین پلون مُشِک یم تس لٲگِتھ ٲسؠ۔ تٔمؠ ژینؠ عیسوؔ سنٛدین پلون ہنٛز مُشِک۔ تہٕ ونُن، "پزی چھےٚ یہِ میانِس نیٚچوِس سنٛز خوشبو تمہِ کھہٕچ ہِش خوشبو یتھ یہُوواہؔ ہن برکت دِژ۔
\v 28 بہٕ چُھسے دعا کران زِ خدا ترٲونے آسمانہٕ پٮ۪ٹھٕ رحمتِ باراں یمہٕ سٟتؠ چٲنؠ کھہہ سٲراب کرِ تہٕ چٲنِس زمینس نیرن واریاہ فصٕل بسیار پَھل تہٕ مےَ یہِ باپتھ دچھ۔
\v 29 بہٕ چُھس منٛگان زِ واریہن جمٲژن ہنٛدؠ لوٗکھ کرِن چٲنؠ خدمت تہٕ ژےٚ کٔرنےَ سجدٕ۔ بہٕ چُھس ونان زِ کرِ پننٮ۪ن باین پٮ۪ٹھ حکمرٲنی، تہٕ چانہِ ماجہِ ہنٛدؠ اولاد تہِ کٔرنے ژےٚ سجدٕ۔ بہٕ چُھس دعا کران زِ خدا وٲلِن تِمن لعنت یم ژےٚ لعنت سوزان چھی، تہٕ تمن کٔرِن برکت یم چٲنؠ برکت کانٛچھان چھِ۔
\v 30 ییٚلہِ اسحاقنؔ یعقوبسؔ یہِ دعا کوٚر تہٕ یعقوبؔ اوس وُنہِ امہِ کمرٕ منٛزٕ نیرٲنی یتہِ تمسُنٛد مول اوس، تہٕ یورٕ پیٚو شکارٕ پتہٕ تمسُنٛد بوٚڈ بوے وٲتِتھ۔
\v 31 عیسوؔ ہن اوس میوٗٹھ مازاہ تیار کوٚرمُت تہٕ اوٚنُن پننِس مٲلِس برونٛہہ کُن۔ تٔمؠ وُن پننِس مٲلِس، "میانہِ ببا، وُتھ سا وار وارٕ روز سا بہِتھ تہٕ کھیٚہ یمہِ مازٕ منٛز رژھ کھنٛڈ یُس مےٚ رٔنِتھ اوٚنےٕ، تہٕ کرِ تہٕ مےٚ دعا۔"
\v 32 تمسنٛدؠ مٲلؠ اسحاقنؔ پرُوژھ تمِس، ژٕ کُس چُھکھ؟ تٔمؠ ونُس تورٕ، "بہٕ چُھس عیسوؔ، تُہنٛد زیُٹھ نیٚچو!
\v 33 اضحاقؔ لوٚگ سیٹھاہ کانٛپنہِ۔ تٔمؠ وُن تیٚلہ کُس اوس یہِ یمؠ مےٚ برونٛہہ کُن اوٚن یُس یمؠ شکار کٔرِتھ اوٚنمُت اوس تہٕ مےٚ کھیٚو سُہ سورےٕ؟ ژٕ ینہٕ برونٛہہ اوس سُہ یتی۔ مےٚ کوٚر تس دُعا تہٕ بہٕ ہیٚکہ نہٕ یہِ نعمت واپس نِتھ۔
\v 34 ییٚلہ عیسوؔ ہن مٲلؠ سنٛزٕ یمہٕ کتھٕ بوزٕ سُہ لوٚگ بڈِ بڈِ ودنہِ۔ سُہ گو سیٹھاہ مایوس۔ تٔمؠ وُن پننِس مٲلِس، "میانہ ببا، میٚتہِ کرِ تہٕ دعا!"
\v 35 مگر مٲلؠ ونُس یورٕ، "چون بوے آو تہٕ دِتُن مےٚ دونٛکھٕ، تہٕ نِین چٲنؠ برکت۔
\v 36 عیسوؔ ہن ونُس، "یہِ گو ٹھیک زِ تمِس چُھ یعقوبؔ ناو، تکیازِ تٔمؠ تٲر مےٚ دویہ لٹہِ بٲزؠ۔ گوڈنچہِ لٹہ نیٚونم زیُٹھ بوے آسنُک حق، تہٕ از نِین میانؠ برکت! پتہٕ پرِژُھن: کیاہ توٚہہِ نِش روز نا میانہِ خٲطرٕ کانٛہہ نعمتھا؟
\v 37 اسحاقنؔ دیُت جواب تہٕ ونُن عیسوؔ ہس، "مےٚ کوٚڈ یہِ زیٚوِ زِ چون لۅکُٹ بوے کرِ ژےٚ پٮ۪ٹھ حکومت، مےٚ کوٚر یہِ اعلان زِ امسنٛدؠ تمام رشتہٕ دار کرن امسنٛز خدمت۔ تہٕ مےٚ وُن زِ خدا دِیہ أمِس وٲفِر اناج تہٕ مےَ خٲطرٕ دچھ۔ ونسا گۅبریا تُہنٛدِ خٲطرٕ کیاہ ہیٚکہ بہٕ کٔرِتھ؟"
\v 38 عیسوؔ ہن وُن پننِس مٲلِس، "میانہِ ببا، کیاہ ژےٚ نِش چھا یوہے اکھ دُعا، میانہِ ببا میٚتہِ کرِ تہٕ دُعا! پتہٕ لوٚگ عیسوؔ زورٕ زورٕ ودنہِ
\v 39 تمسنٛدؠ مٲلؠ اسحاقنؔ وُن تمِس، "سۅ جاے یتہِ ژٕ بسان آسکھ آسہ زرخیز میٚژِ تہٕ تمہِ شبنمہٕ نشہٕ محروم یُس خدا آسمانہٕ پٮ۪ٹھ کھہَن آب دنہٕ باپتھ سوزان چُھ۔
\v 40 ژٕ لوٗٹہٕ ہکھ تہٕ مارٕ ہکھ لوٗکھ یُتھ ژٕ زنٛدگی گزارنٕچ ضرورت پوٗرٕ کرکھ۔
\q تہٕ ژٕ آسکھ تیٚوتھ زنتہٕ ژٕ پننِس بٲے سُنٛد نوکر آسکھ۔
\q مگر ییٚلہ ژٕ تس خلاف بغاوتھ کرنُک فٲصلہٕ نِکھ تہٕ ژٕ کرکھ پنُن پان تمسنٛدِ تلفہٕ تلہٕ آزاد۔"
\v 41 تمہِ دعا کہ برکتہٕ یُس یعقوبسؔ پنٕنؠ مٲلؠ کوٚر، عیسوؔ لوٚگ پننِس بٲیس نفرت کرنہِ۔ عیسوؔ ہن وُن پانسےٕ کُن، "ییٚلہِ میٚون مول مرِ، تہٕ تمؠ سنٛز ماتم دٲری موٚکلٲوتھےٕ ژھنَن بہٕ یعوبؔ مٲرِتھ۔"
\v 42 مگر رِبقہؔ ہس لوٚگ پےَ زِ عیسوؔ کیاہ چُھ سونچان۔ اوٕ کِنؠ اوٚن تمہِ پنُن لۅکُٹ نیٚچوِس یعقوبؔ بُلاوِتھ تہٕ وُننَس، "میانؠ کتھ بوز! چون بوٚڈ بوے عیسوؔ، چُھ ژٕ مارنٕچ سٲزِش بناوان تہٕ پانس یہِ زٲنِتھ تسلی دِوان زِ سُہ ہیٚیہِ تمہ دونٛکھُک بدلہٕ یُس ژےٚ تسنٛدس مٲلس دِتُتھ۔
\v 43 تہٕ وُنؠ بوز میانہِ گۅبرٕ غورٕ سان یہِ بہٕ ونےَ۔ جلدےٕ ژل تہٕ ژلِتھ بیٚہہ حارانَسؔ منٛز میانِس بٲیِس لابنَسؔ نشہٕ۔
\v 44 تس نِش روزکھ تۅتام یۅتام زٹِھس بٲیس شرارتھ ؤسی۔
\v 45 ییٚلہ تس مٔشتھ گژھِ زِ ژےٚ کیاہ کیاہ ورتووُتھ تس سٟتؠ تہٕ بہٕ سوزے شیٚچھ ولہٕ یہِ اورٕ واپس۔ اگر ژےٚ عیسوؔ ژےٚ مٲری تہٕ باقےٕ مارن تس۔ تہٕ پتہٕ مرن میانؠ دوشوے اولاد اکے ساعتہٕ۔
\v 46 پتہٕ وُن رِبقہؔ ہن اضحاقسؔ، یمو غٲر ملکی زنیٚو یمن سٟتؠ عیسوؔ ہن خاندر کوٚرمُت چُھ۔ یم حِت سنٛزٕ کورِ چھےٚ، چھےٚ میانؠ زندگی وبال بنٲومٕژ۔ اگر یعقوبؔ تہِ امی علاقہٕ منٛزٕ کانٛسہِ حِتی کورِ سٟتؠ خاندر کرِ میانؠ زندگی گژھِ بیکار!"
\c 28
\p
\v 1 پتہٕ اوٚن اسحاقنؔ یعقوبؔ بلٲوِتھ تہٕ کوٚرنَس دُعا۔ تٔمؠ وُن تمِس: "کنعان قومچہ کانٛسہ زنہِ سٟتؠ کٔرؠ زینہٕ ژٕ خاندر۔
\v 2 بلکہ گژھِ ژٕ جلدےٕ فدن ارامؔ پنُن ماتامال بیتوایلؔ سُنٛد گرٕ۔ پننہِ ماجہ ہنٛدِس بٲیس لابنؔ سنٛزو کوریٚو منٛزٕ ون کانٛسہِ أکِس زِ سۅ کرِ ژےٚ سٟتؠ خاندر۔
\v 3 بہٕ کرے دعا زِ قدرت وول خدا کٔرؠ نےَ ژےٚ برکت تہٕ بیٚیہِ بنٲونے واریاہ اولاد پٲدٕ کرنس قٲبل یُتھ تم مختلف لوٗکن ہنٛدؠ ونٛڈٕ بناون۔
\v 4 بہٕ کرے یہِ دعا تہِ زِ چےٚ تہٕ چانیٚن اولادن کٔرن برکت تہٕ ژےٚ بنٲوؠ نےَ تتھ ملکس پٮ۪ٹھ قٲبض یتھ منٛز ژٕ وُونؠ أکِس پردیسی سٕنٛدِ حثیتہٕ روزان چُھکھ، سُہ ملک یُس خداین ابرہامؔ تہٕ تمسنٛدین اولادن دِنُک وعدہ چُھ کوٚرمُت۔"
\v 5 پتہٕ سوز اسحاقنؔ یعقوبؔ فدن ارامؔ رِبقہ سٕنٛدِس بٲیس لابنؔ بنِ بیتوایلؔس نِش روزنہٕ باپتھ یُس ارامی قبیلس سٟتؠ تعلق اوس تھاوان۔ یہِ ٲس سۅ رِبقہؔ یمہِ پتہٕ یعقوبسؔ تہٕ عیسوؔ ہس زایُن دِژاو۔
\v 6 عیسوؔ ون زون یہِ زِ تمسنٛدؠ مٲلؠ اسحاقنؔ کوٚر یعقوبس دُعا تہٕ پتہٕ سوزُن فدن ارامؔ۔ تمِس لوٚگ یتہِ پےَ زِ ییٚلہ تمسنٛدؠ مٲلؠ یعقوبسؔ دعا کوٚر تہٕ تٔمؠ وُن تمِس، "کنعان قومچہ کانٛسہِ کورِ سٟتؠ کٔرؠ زینہٕ خاندر۔"
\v 7 تہٕ یعقوبنؔ کٔر پننِس مٲلِس ماجہِ ہنٛز فرمانبردٲری تہٕ گو فدن ارامؔ
\v 8 عیسوؔ ون زون یتہ زِ تمسنٛدس مٲلس اضحاقسؔ چھنہٕ کنعان قومچہ کورِ خوش کران۔
\v 9 امہ کِنؠ گو عیسوؔ پننِس رشتہٕ دار اسماعیلسؔ سمکھنہِ تہٕ اسماعیل سنٛزِ کورِ مہلِتؔ سٟتؠ کوٚرن خاندر۔ مہلِتؔ ٲس نبایوتؔ سنٛز بیٚنہِ تہٕ ابرہامسؔ نیٚچوؠ سنٛز کور۔
\v 10 اتھؠ دوران دراو یعقوبؔ بیرسبعؔ منٛزٕ تہٕ گو حارانؔ کُن روانہٕ۔
\v 11 ییٚلہ سُہ أکِس خاص جایہ ووت تہٕ تتہ رُکیاو تکیازِ دوٚہہ لوس۔ تمؠتُج تتہ موجود کنیٚو منٛزٕ اکھ کٔنؠ تہٕ تھٲون کلس تلشانٛدٕ گونٛدِ بدل۔ پتہٕ تراون تٔتی ڈاپھ تہٕ شونٛگ۔
\v 12 شونٛگنس دوران وُچھ تٔمؠ اکھ خواب یتھ منٛز تٔمؠ اکھ ہیر وُچھ۔ ہیر ٲس بُنہٕ زمینَس پٮ۪ٹھ تہٕ پٮ۪ٹھٕ آسمانس سٟتؠ۔ یعقوبن وُچھ یتہِ زِ خدایہ سنٛدؠ فرشتہ ٲسؠ ہیرِ کھسان تہٕ وسان۔
\v 13 پتہٕ وُچھ تٔمؠ یہُوواہؔ ہیرِ پٮ۪ٹھٕ کنہِ کھڑا، تہٕ ونان اوس، زِ بہٕ چُھس یہُوواہؔ سُہ خدا یمؠ سنٛز عبادت چٲنؠ بُڈِ بب ابرہامنؔ تہٕ اسحاقؔن کٔر۔ بہٕ دِمے ژےٚ تہٕ چانیٚن اولادن سۅ زمین یتھ پٮ۪ٹھ ژٕ شونٛگِتھ چُھکھ۔
\v 14 چٲنؠ ذریاتھ آسہ زمینس پٮ۪ٹھ لژھِ ہنٛدؠ پٲٹھؠ بےشمار تہٕ تِہنٛد علاقہٕ آسہ سیٹھاہ وسعی۔ یم پھٲلن پرٛتھ طرفہٕ، مشرق تہٕ مغرب، شمال تہٕ جنوٗبس منٛز۔ بہٕ کرٕ چانہِ تہٕ چانیٚن زُرین ہنٛدِ وساطتہٕ زمینہ پٮ۪ٹھٕ کیٚن تمام قبیلن تہٕ لُکہٕ جمٲژن برکتھ۔
\v 15 بہٕ کرے ژےٚ مدد، یوٚت تہٕ ژٕ گژھکھ تتہِ کرے بہٕ حفاظت تہٕ بیٚیہِ انَتھ یتھ ملکس منٛز واپس۔ بہٕ تراوِتھ نہٕ ژٕ بہٕ کرٕ چانہِ باپتھ تہِ سورےٕ یمیُک مےٚ وعدہ کوٚرمُت چُھ۔
\v 16 راتھ کیُت ییٚلہ یعقوبؔ ہُشار گو تہٕ تٔمؠ سونچ، "یقینن چُھ یتھ جایہ یہُوواہؔ مگر ونیُک تام ٲس نہٕ مےٚ امِچ خبر۔"
\v 17 سُہ کھوژ تہٕ لوٚگ وننہِ، "یہِ جاے چھےٚ خوفناک۔ پزی چھےٚ یہِ سۅ جاے یتہِ خدا روزان چُھ، تہٕ یہِ چُھ جنتُک دروازٕ!"
\v 18 دویمہِ دوٚہہ صبحٲے وُتھ یعقوبؔ تہٕ تجِن سۅ کٔنؠ یۅسہ شانٛد ٲسٕس تھٲومٕژ تہٕ تھٲون تتھ جایہ نشانہٕ باپتھ یتِتھ تس خدا ظٲہر سپُد۔ تٔمؠ تروو تتھ کنہِ پٮ۪ٹھ زیتون تیٖل تاکہِ سۅ ییہِ خدایہ سٕنٛدِ باپتھ الگ زاننہٕ۔
\v 19 تٔمؠ تھوو تتھ جایہ بیت ایلؔ ناو یعنی "خدایہ سُنٛد گرٕ" گۅڈٕ اوس اتھ جایہ لُوزؔ ناو۔
\v 20 یعقوبنؔ اوس خدایس سٟتؠ وعدہ کۅرمُت زِ اگر ژٕ مےٚ مدد تہٕ یتھ سفرس دوران میانؠ حفاظت کرکھ، مےٚ تھاوکھ کھیٚنہٕ خٲطرٕ بسیار کھیٚن تہٕ لاگنہٕ باپتھ پلو،
\v 21 تیٚلہِ ہیٚکہٕ بہٕ حفاظتہٕ سان پننِس مٲلؠ سُنٛد گرٕ واپس گٔژھتھ۔ پتہٕ آسکھ ژٕ، یہُوواہؔ، سُہ خدا یمسنٛز بہٕ عبادت کرٕ۔
\v 22 یہِ کٔنؠ یۅسہ مےٚ کھڑا کٔر آسہ تمہ جایہ ہنٛز نشٲنی یتِتھ ژٕ مےٚ ظٲہِر سپدُکھ۔ تہٕ یہِ کینٛژھا ژٕ مےٚ دِکھ تمیُک دٔہم حصہٕ آسے بہٕ ژےٚ واپس دِوان۔
\c 29
\p
\v 1 یعقوبؔ رود وتہ پکان یۅتام سُہ کنعان ملکہٕ کِس مشرقی علاقس منٛز ووت۔
\v 2 تتہ وُچھ تٔمؠ أکِس کھہَس منٛز اکھ کریٚور تہٕ اتھ کریرس نِش تیرن ہنٛدؠ ترٛےٚ جب بہِتھ۔ یہِ اوس سُہ کریٚور یتِتھ اکثر پہلؠ تیرن ریش ٲسؠ چیاوان۔ کریرِ کِس گٔلِس پٮ۪ٹھ ٲس اکھ بٔڈ کٔنؠ۔
\v 3 ییٚلہ سٲری کھیٚلؠ تتہِ جمع گژھان ٲسؠ تہٕ پہلؠ ٲسؠ یکہٕ وٹہٕ سمِتھ کریرِ گلہِ پٮ۪ٹھٕ یہِ کٔنؠ تھوٚد تلان تہٕ تیرو باپتھ تریش کھالان۔ ییٚلہ یہِ کٲم تِم موکلاوان ٲسؠ تہٕ یہِ کٔنؠ ٲسؠ تم بیٚیہِ کریرِس پٮ۪ٹھ تھاوان۔
\v 4 امہِ دوٚہہ پرُوژھ یعقوبنؔ پہلیٚن یم تتہِ بہِتھ ٲسؠ زِ توٚہؠ کتِکؠ چُھو؟ تِمو دِتُس جواب، "أسؠ چھِ حارانؔ شہرٕکؠ روزن وٲلؠ۔
\v 5 پتہٕ پرُژھنکھ تٔمؠ، "کیاہ توٚہؠ زٲنؠ وونا نحورؔ سُنٛد نیٚچو لابنؔ؟" تِمو ونُس، "آ، أسؠ زانوون سُہ۔"
\v 6 یعقوبن پرُژھ تِمن، "کیاہ سُہ لابن چھا ٹھیکھۓ؟ تِمو دِتُس جواب، آ، سُہ چُھ ٹھیک۔ وُچھ، یور چھےٚ تمؠ سنٛز کور راخِلؔ تیرن سٟتؠ آمٕژ۔
\v 7 یعقوبنؔ وُن، "وُنہ ہے دوٚہہ لوسنے چُھ۔ یہِ کتہِ چُھ وق ییٚلہ تیر راتس خٲطرٕ رٹِتھ تھاووکھ۔ توٚہؠ کیازِ چُھو نہٕ تیرن تریش دِوان تہٕ گاسہٕ مٲدانن کُن بیٚیہِ رچھنہِ کڈان؟
\v 8 تِمو دتُس تورٕ جواب، "نَہ، أسؠ ہیٚکو نہٕ تہِ کٔرتھ یۅتام نہٕ سٲری کھیٚلؠ یتِتھ جمع گژھن۔ تہٕ کریرِ پٮ۪ٹھٕ ییہِ کٔنؠ تُلنہٕ۔ امہِ پتہٕ دِمو أسؠ تیرن تریش۔"
\v 9 یمہٕ ٲسؠ وُنہِ کتھےٕ کران تہٕ راخِلؔ آیہ پننِس مٲلؠ سنٛدؠ تیر ہیٚتھ۔ سۅ ٲس پننِس مٲلؠ سنٛدؠ تیر سرچاون واجِنؠ۔
\v 10 ییٚلہ یعقوبنؔ پننِس مام لابنؔ سنٛز کور راخِلؔ تہٕ لابن سنٛدؠ تیر وُچھ سُہ وُتھ تھوٚد تہٕ تجِن کریرِس ٹھان تھاونہٕ آمٕژ کِنؠ پانے تھوٚد، تہٕ أنِنؠ پننِس مامہٕ سنٛدین تیرن باپتھ تریش۔
\v 11 پتہٕ کٔرؠ یعقوبنؔ راخِلہِؔ بُتھِس میٹھؠ تہٕ لوٚگ زورٕ زورٕ ریٚونہِ تکیازِ سُہ اوس سیٹھاہ خوش۔
\v 12 یعقوبنؔ وُن راخِلہؔ زِ بہٕ چُھسے ژےٚ مٲلؠ سنٛدیو رشتہٕ دارو منٛزٕ اکھ، یُس چانہِ ماسہِ رِبقہؔ ہُن نیٚچو چُھ۔ تمہِ تُج کُنے دو تہٕ ونُن پننِس مٲلِس۔
\v 13 یتُھےٕ لابنَنؔ بوز زِ تمؠ سنٛزِ بیٚنہِ ہُنٛد نیٚچو یعقوبؔ چُھ ہُتِتھ سُہ دوریٚو جلدےٕ تمِس نِش۔ تٔمؠ روٚٹ سُہ نالہٕ متہِ تہٕ کٔرؠ نس ماہ تہٕ میٹھؠ۔ پتہٕ اوٚن تٔمؠ سُہ پنُن گرٕ، تہٕ یعقوبنؔ وُن تس تہِ سورےٕ یہِ تس سٟتؠ گُزریامُت اوس۔
\v 14 لابنَنؔ وُن پتہٕ تمِس، "پٔزؠ پٲٹھؠ، چُھکھ ژٕ میانہِ خاندانہٕ منٛزٕ۔ یعقوبؔ رود أکِس ریٚتس تمِس نِشہ تہٕ اوس لابنَس الزان پلزان۔
\v 15 پتہٕ وُن لابنَن یعقوبسؔ، "ژمہٕ آس مےٚ صرِف امہ موٚکھٕ میانؠ کٲم کران زِ ژٕ کیاہ چُھکھ میٚون رشتہٕ دار۔ مےٚ ون زِ ژےٚ کوتاہ رقم دِمے بہٕ؟"
\v 16 لابنَس آسہٕ زٕ کورِ۔ بجہِ ہشہِ کورِ اوس لیاہؔ ناو تہٕ لۅکچہ ہشہِ راخِلؔ۔
\v 17 لیاہؔ ٲس ہنا چُپہٕ پہَن تہٕ راخِلؔ ٲس خوشوٕنؠ تہٕ خوبصورت۔
\v 18 یعقوبسؔ اوس راخِلہِؔ سٟتؠ عشق گوٚمُت، تہٕ تٔمؠ وُن، "بہٕ کرے ژےٚ ستَن ورؠ ین خدمت۔ تہٕ یہِ خدمت آسہ تتھ عِوض اگر ژٕ مےٚ پننہِ لۅکچہ کورِ راخِلؔ سٟتؠ خاندر کرنُک اجازت دِکھ۔
\v 19 لابنَن دتُس جواب، "میانہِ خٲطرٕ چُھ یہِ بہتر زِ کانٛسہ وُپرس سٟتؠ خاندر کرنہٕ بجایہ کرٕ بہٕ تس ژےٚ سٟتؠ خاندر۔ مگر تیٚلہ پٔزی ژےٚ یتؠ اسی سٟتؠ روزُن۔
\v 20 یتھ کِنؠ رود یعقوبؔ ستن ورؠ ین لابن سنٛدِ گرِ کٲم کران، سُہ اوس راخِلہؔ سٟتؠ تیوٚت محبت کران زِ تس باسیاے یم ستتھ ؤری زنتہٕ کٔژتام دوٚہے۔
\v 21 ستتھ وری گٔژھتھ وُن یعقوبنؔ لابنَسؔ، "ووُنؠ کرٕ بہٕ راخِلؔ سٟتؠ خاندر تکیازِ یُس وقت مےٚ چٲنؠ خدمت کرنہٕ باپتھ مقرر کوٚرمُت اوس سُہ سپُد ختم، تہٕ وُنؠ چُھس بہٕ یژھان تس سٟتؠ خاندر کرُن۔"
\v 22 اوٕ کِنؠ سونٛبرٲوؠ لابنَنؔ تِم سٲری لوٗکھ یم تتھ علاقس منٛز روزان ٲسؠ تہٕ دیُتنکھ سال۔
\v 23 مگر امہ دوٚہہ شامس أنِکھ یعقوبسؔ نِش راخِلؔ سنٛزِ بجایہ لابنؔ سنٛز بٔڈ ہِش کور لیاہؔ۔ امہِ ساعتہٕ اوس انہِ گوٚٹ یمہِ کِنؠ نہٕ تٔمؠ وُچھتھےٕ ہیٚوک زِ یہِ چھےٚ لیاہؔ نَہ زِ راخِلؔ، سُہ وُتھ تہٕ شونٛگ تس نِش۔
\v 24 لابنَنؔ ٲس گۅڈے پنٕنؠ لونٛڈی زلفہؔ پننہِ کورِ لیاہؔ دِژمٕژ تمؠ سنٛز لونڈی بننہٕ باپتھ۔
\v 25 امہِ دوٚہہ صُبحٲے گو یعقوبؔ یہِ وُچِھتھ حٲران زِ یہِ چھےٚ لیاہؔ یۅسہ مےٚ سٟتؠ شونٛگِتھ ٲس۔ سُہ وُتھ تہٕ گو لابنَسؔ نِش تہٕ ونُن تس شرارتہٕ سان، "یہِ کینٛژھا ژےٚ مےٚ سٟتؠ کۅرتھ یہِ گو نہٕ جان۔ بہٕ رودُس ژےٚ نِش راخِلؔ حٲصل کرنہٕ باپتھ کامہِ۔ مےٚ کٔر نا کٲم؟ تہٕ ژےٚ کیازِ دِتُتھ مےٚ دونٛکھٕ؟"
\v 26 لابنَنؔ ونُس اورٕ، "یتھ ملکس منٛز چُھنہٕ یہِ ریٚواج زِ أسؠ تھاوون زِٹھ کور أتی تہٕ کانٛسہِ کورِ کرو خاندر۔
\v 27 ییٚلہ أسؠ یتھ ہفتَس منٛز یمہِ خاندرٕچ ۅسہٕ درۅسہٕ موکلاوو تمہِ پتہٕ دِمووے ژےٚ لۅکچہ کورِ سٟتؠ تہِ خاندر کرنہٕ۔ مگر امہِ خٲطرٕ چھی ژےٚ مذید ستن ورؠ ین مےٚ نِش کامہِ روزُن تہٕ راخِلؔ حٲصل کرٕنؠ۔
\v 28 تہٕ یعقوبنؔ کوٚر یی۔ اکہِ ہفتُک یہِ جشِن موکلٲوِتھ دِژ لابنَنؔ پنٕنؠ کانٛس کور راخِلؔ تمِس نیتٕرؠ۔
\v 29 لابنَن دِژ پنٕنؠ لونٛڈی بِلہاؔ راخِلؔ سنٛز خٲدمہ بننہٕ باپتھ۔
\v 30 یتھ کِنؠ کٔر یعقوبنؔ راخِلؔ تہِ نیتٕرؠ تہٕ سُہ اوس لیاہؔ سنٛدِ کھۅتہٕ زیادٕ محبت راخِلہِؔ سٟتؠ کران۔ تٔمؠ کٔر مذید ستَن ورؠ ین لابنَس نِش کٲم۔
\v 31 ییٚلہِ یہُوواہؔ ہَن یہِ وُچھ زِ یعقوبؔ چُھنہ لیاہؔ سٟتؠ زیادٕ محبت ورتاوان تہٕ تٔمؠ بنٲو سۅ گۅبہِ کھورٕ بناونَس قٲبل۔ تہٕ راخِلؔ ہیٚچ نہٕ گۅبہِ کھورٕ روزِتھ۔
\v 32 لیاہؔ دیُت أکِس لٔڑکس زایُن یمِس رُوبِنؔ ناو تھووُکھ۔ تمہِ وُن، "یہُوواہنؔ وُچھ زِ بہٕ چھیٚس غمگین تہٕ تٔمؠ دیُت مےٚ نیٚچو۔ وۅنؠ کرِ ضرور میٚون خاندار مےٚ سٟتؠ محبت تکیازِ مےٚ دیُت تسنٛدِس اولادس زایُن۔"
\v 33 پتہٕ روز سۅ دُبارٕ بیٚیہِ تہِ بیٚیہِ زُووٕ تہٕ زاس بیاکھ لڑکہٕ۔ تمہِ وُن، "یہُوواہنؔ چُھ بوزمُت زِ میٚون خاندار چُھنہٕ مےٚ سٟتؠ لول ورتاوان، اوے دِتُن مےٚ یہِ بیاکھ گۅبُر۔ "اوٕ کِنؠ تھوو تمہِ تمِس شمعون ناو، مطلب "کانٛہہ چُھ بوزن وول۔"
\v 34 پتہٕ روز سۅ بیٚیہِ حٲملہٕ تہٕ زاس بیاکھ لڑکہٕ۔ تہٕ ونُن، آ، وُنؠ کیا سہ ییہِ مےٚ پنُن خاندار نزدیک۔ "امہِ کِنؠ کوٚرُن أمِس نیٚچوِس لاوی ناو۔ مطلب "نزدیک تھاون۔"
\v 35 امہِ پتہٕ روز سۅ بیٚیہِ تہِ گۅبہِ کھورٕ تہٕ زاس بیاکھ نیٚچو۔ پتہٕ وُن تمہِ، "یمہٕ وزِ کرٕ بہٕ یہُوواہؔ سُنٛد شکرانہٕ۔ "تمہِ تھوو تمِس یہُوداؔ ناو۔ تمہِ پتہٕ دیُت نہٕ تمہِ مذید کٲنٛسہِ شُرِس زایُن۔
\c 30
\p
\v 1 راخِلہِؔ سپُد یہِ احساس زِ سۅ چھنہٕ گۅبہِ کھورٕ روزِتھ ہیٚکان۔ اوٕ کِنؠ ہیٚتُن تس پننہِ بجہِ بیٚنہٕ لیاہؔ بُنٛد حسد وتُھن، تکیازِ لیاہؔ دیُت ژورن شُرین زایُن۔ تمہِ وُن یعقوبسؔ، "مےٚ تھاو گۅبہِ کھورٕ تاکہِ مےٚ زیٚون شُرؠ۔ اگر نہٕ ژےٚ تہِ کٔرتھ ہیٚکُتھ تیٚلہِ مرے بہٕ!
\v 2 یعقوبسؔ کھوٚت راخِلہِ پٮ۪ٹھ شرارتھ تہٕ لگُس وننہِ، "بہٕ چُھس نہٕ خدا۔ سُہ چُھ سُے یمؠ نَہ ژےٚ گۅبہِ کھورٕ روزنہٕ دِتُےٕ!"
\v 3 پتہٕ ونُس تمہ، "وُچھ سہ، میانؠ داے بِلہاؔ چھےٚ یتہِ تمِس نِشہ شونٛگ تاکہِ سۅ دییہِ میانہٕ بدلہٕ بچن زایُن۔ یُتھ قانونی طور تِم میانؠ بچہٕ بنَن۔
\v 4 تہٕ پنٕنؠ لونٛڈی بِلہاؔ تس حوالہٕ کٔرتھ بنٲون سۅ تَس بیاکھ زنانہٕ تہٕ یعقوبؔ شونٛگ تس نِشہ۔
\v 5 سۅ روز گۅبہِ کھورٕ تہٕ یِتھؠ کِنؠ زاو یعقوبس نیٚچو۔
\v 6 راخِلہِؔ وُن، "خداین کوٚر مےٚ سٟتؠ انصاف۔ ییٚلہِ مےٚ تس فرؠ یاد کوٚر تہٕ تٔمؠ بوز میٚون فریاد، تٔمؠ سُنٛد انصاف اوس مےٚ نیٚچو دیٚون۔ تمہِ تھوو تمِس دانؔ ناو۔ عِبرٲنؠ زبٲنؠ منٛز گو دان "سُہ چُھ مےٚ انصاف دِوان۔"
\v 7 پتہٕ روز راخِلہِؔ ہنٛز لونڈی بِلہاؔ دُبارٕ بیٚیہِ زُووٕ تہٕ دتُن یعقوبؔ سنٛدِس بیٚکِس نیٚچوِس زایُن۔
\v 8 تمہِ وزِ ؤژھ راخِلؔ، "مےٚ کٔر سیٹھاہ جد و جہَد تہٕ پننہِ بجہِ بیٚنہِ ہنٛدؠ پٲٹھؠ چھِ میتہِ بچہٕ، تہٕ یقینن چُھ مےٚ یہِ نیٚچو۔ "لہٰذا تھوو تمہِ تس نفتالیؔ ناو، یمیُک مطلب عِبرٲنؠ زبٲنؠ منٛز "جد و جہَد" چُھ۔
\v 9 ییٚلہ لیاہؔ ژیٚون زِ تس چُھنہ وں کانٛہہ اولاد تہٕ تمہِ تُج پنٕنؠ لونٛڈی زلفہؔ تہٕ نِین یعقوبسؔ نِش تہٕ بنٲون سۅ تمؠ سنٛز بیاکھ زنانہٕ بناونہٕ باپتھ۔
\v 10 لیاہؔ سنٛز زلفہؔ روز جلدےٕ گۅبہِ کھورٕ تہٕ دتُن یعقوبؔ سٕنٛدِس نیٚچوِس زایُن۔
\v 11 لیاہؔ ہہِ وُن، "بہٕ چھیٚس پٔزؠ پٲٹھؠ خوش قسمت!" تہٕ تمہِ تھوو تس جدؔ ناو، مطلب "خوش قسمت۔"
\v 12 پتہٕ دیُت لیاہؔ ہنٛزٕ لونڈی زلفہؔ ہن یعقوبؔ سنٛدِس بیٚیِس أکِس نیٚچوِس زایُن۔
\v 13 لیاہؔ ہہِ وُن، "وُونؠ چھیٚس بہٕ زیادے خوش، تہٕ لوٗکھ تہِ زانن مےٚ خوش۔ توے تھوو تٔمؠ تَس آشرؔ ناو، یعنی "خوش۔"
\v 14 یمہِ وقتہٕ تِم کنٕکھ لونان ٲسؠ تہٕ رُوبِنؔ دراو کھہَس کُن نظرِ تہٕ اتہِ وُچھ تٔمؠ "مردُم گیاہ" کُلؠ۔ تٔمؠ أنؠ یمو منٛزٕ کینٛہہ پننہِ ماجہِ لیاہؔ نِش۔ مگر راخِلؔ ٲس یمن وُچھان تہِ تمہِ وُن لیاہؔ ہہ، "مہربٲنی کٔرِتھ دِتہٕ یمو کُلیٚو منٛزٕ کینٛہہ کُلؠ میٚتہِ یمہٕ چٲنؠ نیٚچیو ژےٚ نِش أنؠ۔
\v 15 مگر لیاہؔ ؤژھٕس یورٕ، "نَہ! یہِ گو ناکارٕ، ژےٚ نیٚوتھن میٚون خاونٛد ورگہٕ لٲوِتھ! تہٕ وُونؠ نِکھا میانِس نیٚچو سنٛدؠ یم کُلؠ تہِ؟" راخِلہِؔ ونُس، "ٹھیک چُھ، "اگر ژٕ مےٚ نیٚچو سنٛدؠ یم کینٛہہ کُلؠ دِکھ تیٚلہِ شونٛگہِ از راتس یعقوبؔ ژیی نِش۔ "اوٕ کِنؠ مٲنؠ لیاہؔ راخِلٕنؠ یہِ کتھ۔
\v 16 ییٚلہ یعقوبؔ امہِ دوٚہہ شامس کٕنکہٕ کھہہ پٮ۪ٹھٕ واپس آو تہٕ لیاہؔ درایس بُتھِ تہٕ وُننَس، "ژےٚ چھی از راتس مےٚ نِش شونٛگُن، تکیازِ مےٚ دِتؠ راخِلہِؔ مردُم گیاہ کُلؠ اوٕ موٚکھ تاکہِ سۅ دییہ اسہِ یہِ کرنُک اجازت۔ یتھ کِنؠ شونٛگ یعقوبؔ امہِ رٲژ أمسےٕ نِش۔
\v 17 خداین کوٚر لیاہؔ ہُنٛد دُعا قبول، سۅ روز بیٚیہِ زُووٕ تہٕ زاس یعقوبُن پانٛژِم نیٚچو۔
\v 18 لیاہؔ ہہِ وُن، "خداین دیُت مےٚ انعام تکیازِ مےٚ بنٲو پنٕنؠ لونڈی پننِس خاندارٕ سنٛز دویم زنانہٕ۔ "امہِ کِنؠ تھوو تمہِ تمسُنٛد ناو اشکارؔ۔ اشکارک معنی گو عِبرٲنؠ زبٲنؠ منٛز انعام۔
\v 19 امہِ پتہٕ روز لیاہؔ ببیہِ گۅبہ کھوٚر تہٕ زاو یعقوبُنؔ شییِم نیٚچو۔
\v 20 امہِ وزِ وُن لیاہنؔ، "خداین دیُت مےٚ اکھ قٟمتی تحفہٕ۔ ووُنؠ کرِ میٚون خاندار مےٚ عزت، تکیازِ مےٚ دیُت تمسنٛدِ خٲطرٕ شیٚن نیٚچوٮ۪ن زایُن۔ اوٕ کِنؠ تھوو تٔمؠ أمِس نیٚچوِس زبُلُون ناو۔
\v 21 امہِ پتہٕ دیُت تمہِ أکِس کورِ زایُن یمِس دینہؔ ناو کوٚرُکھ۔
\v 22 پتہٕ سوونٛچ خداین زِ راخِلؔ کیاہ چھےٚ یژھان۔ تٔمؠ بوز تمسُنٛد دُعا تہٕ بنٲون بیٚیہِ زُووٕ روزنَس قٲبل۔
\v 23 سۅ روز گۅبہِ کھورٕ تہٕ زاس اکھ لڑکہٕ۔ تمہِ وُن، "خداین کٔرس نہٕ بہٕ اولاد نَہ آسنہٕ کِنؠ مذید شرمنٛدٕ۔
\v 24 تمہِ تھوو تمِس یوسفؔ ناو، عِبرٲنؠ زبٲنؠ منٛز چُھ امیٚک مطلب "یہُوواہؔ ہن دیُت مےٚ نیٚچو۔"
\v 25 ییٚلہ راخِلؔہِ یوسفؔ زاو تہٕ یعقوبؔ وُتھ تہٕ ونُن لابنَس، "ووُنؠ دِیو مےٚ اجازت زِ بہٕ تراوٕ تُہنٛز کٲم کرٕنؠ تہٕ نیرِ پنُن وطن کُن واپس۔
\v 26 توٚہؠ چُھو زانان زِ مےٚ کیاہ کوٚر تُہنٛدِ باپتھ۔ لہٰذا دِیو مےٚ پننہِ گرٕ واجنہِ تہٕ شُرؠ نِنُک اجازت یہنٛدِ باپتھ مےٚ تُہنٛز کٲم کٔر تاکہِ تِم حٲصل کٔرتھ نیرٕ واپس۔"
\v 27 مگر لابنؔ وُتھ تس در جواب زِ اگر ژٕ مےٚ رٲضؠ چُھکھ تیٚلہِ روز تہٕ یتؠ تکیازِ مےٚ وُچھ اکہِ جادوئی عملہِ ہنٛدِ ذریعہ زِ ژےٚ یہِ کینٛژھا میانہِ خٲطرٕ کۅرتھ تمہ کہ وساطتہٕ کٔر مےٚ یہُوواہؔ ہن کٲفی برکت۔
\v 28 مےٚ ونتہٕ میانؠ کٲم کرٕنؠ جٲری تھٲوِتھ کیاہ چُھکھ ژٕ مےٚ نِش طلب کرُن یژھان، تہٕ بہٕ دِمے ژےٚ تتہِ۔"
\v 29 یعقوبنؔ ونُس، "توٚہؠ چُھو زانان زِ کتھٕ کِنؠ کٔر تُہنٛدِ باپتھ کٲم تہٕ توٚہہِ وُچھو زِ تُہنٛدؠ چاروٲے کٲتیاہ ہُریاے ییٚلہ مےٚ تہنٛز رٲچھ راوٕٹ کٔر۔
\v 30 میانہِ یور ینہٕ برونٛہہ ٲسؠ توٚہہِ کٔژتامےٕ چاروٲے۔ مگر وُنؠ چھِ توٚہہِ نِش چارواین ہنٛدؠ بٔڈؠ کھیٚلؠ تہٕ یپٲرؠ تہٕ یم مےٚ نی تپٲرؠ کرنکھ یہُوواہنؔ برکتھ۔ مگر وُونؠ چھےٚ مےٚ پننہِ خاندانچن ضروٗرژن ہنٛز فِکر کرٕنؠ۔
\v 31 لابنؔ وتُھس در جواب، "ژٕ کیاہ چُھکھ یژھان، بہٕ گوٚژھسے ژےٚ دیُن؟ یعقوبنؔ ونُس، "بہٕ چُھس نہٕ یژھان زِ ژٕ گوژھکھ مےٚ کینٛہہ دیُن۔ مگر اگر ژٕ میانہِ باپتھ اکھ کٲم کرَکھ تہٕ بہٕ روزٕ چون جب رچھان تہٕ تتھ رٲچھ راوٕٹ کران۔
\v 32 مےٚ دِیو اجازت از گژھٕ بہٕ تہٕ چٲنِس سٲرؠ سےٕ کھیٚلِس دمہٕ نظر تہٕ تمہِ منٛزٕ کڑکھ ساری ڈبہٕ ہارؠ، ٹیٚکؠ دار تہٕ کریٚہنؠ چھرٕ تہٕ ژھاوجہِ نیٚبر۔ بہٕ چُھسکھ تمہٕ پننہِ خٲطرٕ تھاوٕنؠ یژھان۔ سُے گییہِ میانؠ اُجرت۔
\v 33 امہِ سٟتؠ ترِ توٚہہ آینٛدٕ فکرِ زِ یہِ کینٛژھا توٚہہِ مےٚ دِتو، بہٕ چُھسا تتھ نیسبت ایماندار کِنہ نَہ۔ اگر نہٕ میانیٚو ژھاوجیو منٛز کانٛہہ ہور اوس یا ٹیٚوک اوسس نہٕ یا کانٛہہ چھرٕ کرِہُن اوس نہٕ توٚہؠ ہکیٚو زٲنِتھ زِ سُہ چُھ مےٚ توٚہہِ ژورِ نِمُت۔
\v 34 لابننؔ کوٚر اتھ سٟتؠ اتفاق تہٕ ونُن، "آ، یی کرو یتھٕ پٲٹھؠ ژےٚ ونُتھ۔"
\v 35 مگر امی دوٚہہ کٔڈؠ لابنَنؔ سٲری مونٛگر یمن کریہِن تہٕ سفید داغ، یا ڈبہٕ ہٲرؠ ٲسؠ تہٕ تمام ژھاوجہِ یم ڈبہٕ ہارِ آسہٕ، تہٕ تم ژھاولؠ یم گیٚشامؠ ٲسؠ، تہٕ تم سٲری چھرٕ یم کریٚہنؠ ٲسؠ تیر کھیٚلہِ منٛزٕ الگ، تہٕ کرِن پننٮ۪ن نیٚچوٮ۪ن حوالہٕ۔
\v 36 پتہٕ نی لابنؔ تہٕ تمسنٛدیو نیٚچیو تمہٕ جانور تتہِ پٮ۪ٹھٕ تریٚن دوٚہُن ہنٛزِ وتہِ دور یتِتھ یعقوبؔ اوس۔ تہٕ یعقوبؔ رود لابنؔ سنٛدِس باقی جبَس رٲچھ راوٕٹ کران
\v 37 پتہٕ أنؠ یعقوبنؔ بونہِ، بادام تہٕ پھرٛیسَن ہنٛدؠ شاخ ژٔٹِتھ۔ امہِ پتہٕ تُل تٔمؠ تِمن لنجن دٮ۪ل۔ لنجن دٮ۪ل تُلِتھ دراو تِمن سفید رنٛگ نوٚن۔
\v 38 پتہٕ تراوِ تٔمؠ تمہٕ سفید لورٕ تتھ آبہٕ ہوضس منٛز یتھ منٛز چارواین تریشہٕ خٲطرٕ آب اوس تراونہٕ یوان، یُتھ زن تیرَن تریش چیٚنہٕ وزِ تِمن پٮ۪ٹھ نظر پییہِ ہے۔
\v 39 جانورو تہِ کٔر یمن شاخن برونٛہہ کنہِ صحبت، تہٕ پتہٕ دِتؠ تِمو جانورو تِم ژھو یم داغدار تہٕ ڈبہٕ ہٲرؠ ٲسؠ یا تِم جانور یمن سفید تہٕ کریہنہِ رٕکھٕ آسہٕ۔
\v 40 امہِ پتہٕ اوس واریہن ورؠ ین یعقوبؔ لابنؔ سنٛدِ جبہٕ منٛزٕ ہیٚتھےٕ گبیٚن، باقی چِھرن تہٕ ژھاولیٚن نِش الگ کڈان۔ ییٚلہِ تِم صحبت کران ٲسؠ سُہ اوس تِمن کریہنیٚن تہٕ سفید داغہٕ والیٚن جانورن کُن تہٕ کریہنہِ رنٛگہٕ کیٚن جانورن کُن پِھران۔ تہٕ یتھٕ کِنؠ دِتؠ تِمو اکی قسمٕکؠ نشانہٕ وٲلؠ ژھو۔ پتہٕ اوس سُہ تِم جانور لابنؔ سنٛدِ کھیٚلہِ منٛزٕ الگ کٔڈتھ پانس کِتؠ تھاوان۔
\v 41 امہِ علاوٕ ییٚلہِ تہِ کانٛہہ زُو دار گٔب ژھو دِنہٕ خاطرٕ تیار سپدان ٲس یعقوبؔ اوس تمِس برُنٛہہ کنہِ تِمو زٕجمَژو لوریٚو منٛزٕ کینٛہہ لورِ تھاوان تاکہِ یمن لوریٚن برونٛہہ کنہِ لگن تِمہٕ۔
\v 42 وُنؠ ییٚلہِ کمزور جانور چھگہِ ٲسؠ یوان تیٚلہِ ٲسؠ نہٕ تِمن برونٛہہ کنہِ یم لورِ تھاوان۔ تہٕ تِم ٲسؠ لیٚژؠ چِھر تراوان۔ یم لابن سنٛدِس جبَس منٛز روزان ٲسؠ، تہٕ زُوو دار ٲسؠ یعقوبؔ سنٛدِ جبٕکؠ حصہٕ بنان۔
\v 43 نتیجہٕ دراو یہِ زِ یعقوبؔ سپُد امیر۔ سُہ بنیاو اکہٕ بڈِ جبُک مٲلک، تمِس ٲسؠ واریاہ زنہِ تہٕ مہنیٚوؠ غلام، اونٹ تہٕ خر تہِ ٲسِس۔
\c 31
\p
\v 1 اکہِ دوٚہہ وُن کمتام یعقوبسؔ زِ لابن سنٛدؠ لڑکہٕ ٲسؠ شکایت کران تہٕ ونان ٲسؠ، "یعقوبن کھیٚو سٲنِس مٲلِس سورےٕ تہٕ سپُد سیٹھاہ امیر۔"
\v 2 یعقوبؔ اوس ژرژان زِ لابنؔ چُھنہٕ تس سٟتؠ دوستانہ سلوٗک ورتاوان یِتھؠ کِنؠ زن تٔمؠ پتھ کُن ورتوو۔
\v 3 پتہٕ وُن یہُوواہنؔ یعقوبسؔ، "پننِس ملکَس تہٕ پننٮ۪ن رشتہٕ دارن نِشہ گژھِ واپس تہٕ بہٕ کرے تتہِ ژےٚ مدد۔"
\v 4 یہِ بوزِتھ سوز یعقوبنؔ راخِلؔ تہٕ لیاہؔ شیٚچھ زِ تِم واتن گاسہٕ مٲدانن نِش یتِتھ تمسنٛدؠ چاروٲے، ژھاوٕلؠ تہٕ تیر کھیٚلؠ چھِ،
\v 5 ییٚلہِ تمہٕ واژٕ، تٔمؠ وُن تِمن، "مےٚ چُھ تران فکرِ زِ تُہنٛد مول چُھنہٕ وُنؠ مےٚ سٟتؠ پرُون ہیٚو سلوک کران۔ مگر خداین یمسنٛز عبادت میٚون کران اوس کوٚر مےٚ مدد۔
\v 6 توٚہؠ دوٚنوے چُھو زانان زِ مےٚ کٲژاہ سخت خدمت کٔر تُہنٛدِس مٲلِس۔
\v 7 تٔمؠ کٔر واریاہہِ پھرِ میانؠ مُزورؠ کھیٚتھ مےٚ سٟتؠ دانٛدلی مگر خداین دیُت نہٕ تس زانٛہہ تہِ مےٚ نقصان واتناونُک موقہٕ۔
\v 8 ییٚلہِ لابننؔ وُن، "ٹیچہ ہٲرؠ جانور یم تہِ چھِ تم دِمے بہٕ ژےٚ مُزورِ رنٛگؠ، پتہٕ دِتؠ ساروٕے جانورو ٹیچہِ ہٲرؠ ژھو۔ پتہٕ ییٚلہِ نیت بدلییَس تہٕ ونُن، "یمن کریٚہنہِ تہٕ سفید رکھٕ آسن تِمے گۓ ژےٚ مُزور، پتہٕ ترٲوؠ ساروٕے جانورو رکھٕ دارےٕ ژھو۔
\v 9 یتھ پٲٹھؠ تُلؠ خداین تم چاروٲے یم چٲنِس مٲلؠ سنٛدؠ ٲسؠ تہٕ دتِن مےٚ۔
\v 10 اکہِ دوٚہہ ییٚلہ جانور صحبت کران ٲسؠ تہٕ مےٚ وُچھ خاب۔ خابس منٛز وُچھ مےٚ زِ بہٕ اوسُس ہیٚور کُن وچھان تہٕ بہٕ گوس یہِ وچِھتھ حٲران زِ ژھاوجن یم مونٛگر لاگنہٕ یوان ٲسؠ تِمن آسہٕ کریہنہِ تہٕ سفید رکھٕ، تہٕ کینٛژن ٲسؠ ٹیٚکؠ۔
\v 11 خابس منٛز آو مےٚ خدایہ سنٛدِ طرفہٕ اکھ فرشتہٕ یمؠ مےٚ وُن، "یعقوبؔ!" مےٚ دتُس جواب، "بہٕ چُھس حٲضر۔"
\v 12 تٔمؠ وُن مےٚ تورٕ، "ہیٚور کُن وُچھ تہٕ اتہِ وُچھکھ سارنےٕ مونٛگرن یم ژھاوجن سٟتؠ چھِ کریٚہنہِ تہٕ سفید رکھٕ تہٕ نتہٕ چِھکھ ٹیٚکؠ۔ یہِ چُھ اوٕ موٚکھٕ سپدان تکیازِ مےٚ وُچھ تہِ سورےٕ یہِ کینٛژھا لابنؔ ژےٚ سٟتؠ ورتاوان اوس۔
\v 13 بہٕ چُھس سُہ خدا یُس ژےٚ بیت ایلَسؔ منٛز وُچھتھن، یتہِ ژےٚ اکھ کِنؠ کھڑا کرٕتھ تہٕ تتھ پٮ۪ٹھ زیتون تیٖل ترٲوِتھ مےٚ سٟتؠ اکھ پۅختہٕ وعدہ کۅرتھ۔ لہٰذا نیر جلد یمہِ سرِزمینہِ منٛزٕ تہٕ وات تتھ سرِزمینہِ پٮ۪ٹھ یتہِ ژےٚ زایُن لوٚبُتھ۔"
\p
\v 14 راخِلؔ تہٕ لیاہؔ وژھٕ یورٕ تمِسِ "سون مول دییہِ نہٕ مرنہٕ کِس دمس تام اسہِ کینٛہہ۔
\v 15 سُہ چُھ اسہِ سٟتؠ تیٚوتھ سلوٗک کران زنتہٕ أسؠ وۅپر ملکچہِ چھےٚ۔ تِمن سارنی ورؠ ین ہنٛز کٲم یۅسہ ژےٚ تمسنٛدِ خٲطرٕ کٔرتھ چھےٚ تمیُک ماوضہٕ یُس ژےٚ تس سانہِ خٲطرٕ دِتُتھ، مگر أسؠ چھنہٕ تمہِ منٛزٕ کُنے مٲلکھ یُس مال ژےٚ تمسنٛدِ خٲطرٕ ۅپدووُتھ، تٔمؠ کوٚر تہِ سورےٕ ہڈپ!
\v 16 یقینن چھےٚ سۅ دولت سٲنؠ تہٕ سانیٚن شُرین ہنٛز یۅسہ خداین تس نِشہ نیٚیہ۔ لہٰذا یہِ کینٛژھا ژےٚ خداین کرُن وُنےٕ تہِ کرِ!"
\v 17 پتہٕ تھٲوؠ یعقوبنؔ پنٕنؠ شُرؠ تہٕ گرٕواجنہِ اونٛٹن پٮ۪ٹھ بہنٲوِتھ۔
\v 18 پنٕنؠ چو چاروٲے کٔڈن برونٛہہ برونٛہہ ییٚلہ تِمو نیرن ہیٚوت۔ تٔمؠ تُل پنُن سورےٕ مال و اسباب سٟتؠ یُس تٔمؠ فدن ارامسؔ منٛز روزِتھ تہِ کموٕمُت اوس۔ یتھ پٲٹھ کوٚر تٔمؠ پننِس مٲلِس اضحاقسؔ نِش واپس گژھنُک سفر شروع، یُس ملکِ کنعانس منٛز روزان اوس۔
\p
\v 19 لابنؔ گو وُنؠ پنٕنؠ تیر نیٚتنہِ۔ تمؠ سنٛزِ غٲر حٲضری منٛز گییہِ راخِلؔ تہٕ أنِنؠ لکٕرِ ہنٛدؠ تِم بُت ژورِ کٔڈتھ یم تمسنٛدس مٲلِس خٟمَس منٛز ٲسؠ۔
\v 20 امہِ لاوٕ سپُد یتہِ زِ یعقوبنؔ تھٲوؠ نَہ ؤنِتھ لابنؔ ارامیؔ یتھ دونٛکھس منٛز زِ سُہ چُھ تتہِ نیرنُک سنٛز کران۔
\v 21 یتھ کِنؠ ژٔلؠ یعقوبؔ تہٕ تمسُنٛد خاندان پنُن سورےٕ اسباب ہیٚتھ۔ دریاے فُراتس تار دِتھ کوٚر تِمو جِلعادؔ کِس پہٲڑی ملکَس کُن سفر شروع۔
\v 22 تہنٛدِ نیرنہٕ پتہٕ ترییہِ دوٚہؠ وُن کمتام لابنَسؔ زِ یعقوبؔ تہٕ تمسُنٛد خاندان ژوٚل۔
\v 23 یہِ بوزِتھ دراو سُہ کینٛہہ رشتہٕ دار ہیٚتھ یعقوبسؔ ژھانٛڈنہِ۔ ستن دوٚہُن پٔکِتھ رٔٹؠ تِمو تِم جِلعادؔ کِس پہٲڑی علاقس منٛز۔
\v 24 لابنَس آو أتھؠ راتس انٛدر خدا خابس منٛز۔ تٔمؠ وُن تمِس، "ییٚلہِ ژٕ یعقوبؔ رٹہَن حیٚس کٔرزِ اگر تس کینٛہہ ونکھ۔
\v 25 دویمہِ دوٚہہ ییٚلہِ لابنؔ یعقوبس سمُکھ تہٕ یعقوبنؔ تہٕ تمسنٛدیو گرِکیٚو ٲسؠ جِلعادؔ بالَس پٮ۪ٹھ پنٕنؠ خٟمہ دِتؠ مٕتؠ۔ حالانکہ لابن تہٕ تمسنٛدیو رشتہٕ دارو تہِ دِتؠ پنٕنؠ خٟمہ أتھؠ جایہ۔
\v 26 پتہٕ گو لابنؔ یعقوبس نِش تہٕ وننَس، "ژےٚ کیازِ کۅرتھ یہِ؟ ژےٚ دِتُتھ مےٚ دونٛکھٕ، میانہِ کورِ ژولُکھ زنتہٕ جنٛگہٕ منٛزٕ قٲد کٔرِتھ۔
\v 27 ژٕ کیازِ ژولُکھ مےٚ دونٛکھٕ دِتھ؟ ژےٚ کیازِ ونُتھ نہٕ مےٚ یہِ زِ مےٚ چُھ نیرُن، یُتھ زن بہٕ جان پٲٹھؠ رخصت دمہٕ ہے۔ امہِ برونٛہہ زِ لوٗکھ گیٚوٕہن طبلہٕ تہٕ بربت وٲیتھ، أسؠ مناوٕہو خوشی تہٕ بیٚیہِ گیوٕ ہو!
\v 28 ژےٚ دِتُتھ نہٕ مےٚ پننٮ۪ن زُرین نیرنہٕ برونٛہہ بوسہٕ کرنُک تہِ موقہٕ۔ ژےٚ یہِ کۅرتھ یہِ گییہِ بیوقوفی!
\v 29 مےٚ تہٕ میانیٚن رشتہٕ دارن چُھ طاقت ژےٚ نقصان واتناونُک۔ مگر راتھ راتس وُن مےٚ تٔمؠ خداین یمسنٛز عبادت چون مول کران چُھ زِ سیٹھاہ یعقوبس سٟتؠ کتھ کرنہٕ وزِ۔
\v 30 وُنؠ چُھس بہٕ زانان زِ ژٕ دراکھ تکیازِ ژٕ چُھکھ یژھان واپس پنُن گرٕ گژُھن۔ مگر ژےٚ کیازِ نیتھکھ میانؠ بُت ژوٗرِ؟"
\v 31 یعقوبنؔ وُن لابنِسؔ یورٕ، مےٚ وُنےٕ نہٕ ژےٚ زِ بہٕ چُھس یتہِ نیرُن یژھان، تکیازِ مےٚ اوس خوف زِ ژٕ گوٚژھکھ نہٕ پننٮ۪ن کوریٚن زبردستی مےٚ نِش دور کرُن۔
\v 32 وُونؠ اگر ژےٚ یتہِ کانٛہہ شخص اتھِ لگی یمِس اتھِ چٲنؠ بُت آسن، أسؠ کروون سُہ قتل۔ ییٚلہِ زن سٲنؠ رشتہٕ دار وُچھان چھِ تِم کرن پانے تلاش زِ کانٛہہ چیز ما چُھ یتہِ سُہ یُس تُہنٛد چُھ۔ اگر کانٛہہ چیز آسہ سُہ ہکیٚو توٚہؠ نِتھ!" ییٚلہِ یعقوبنؔ یہ ونان اوس تس ٲس نہٕ یہ پےَ زِ راخِلؔہِ چھِ پننِس مٲلؠ سنٛدؠ بُت ژوٗرِ انمٕتؠ۔
\v 33 لابنؔ ژاو یعقوبؔ سنٛدِس خٟمس منٛز، أتھؠ سٟتؠ لیاہؔ سنٛدِس خٟمس تہٕ تمہِ پتہٕ دوٚن لونڈین ہنٛدِس خٟمس منٛز بُت ژھانٛڈنہٕ مگر تمِ لبِن نہٕ۔ تہنٛدیو خٟمو منٛزٕ نیرتھ ژاو سُہ پتہٕ راخِلؔ سنٛدِس خٟمس منٛز۔
\v 34 مگر راخِلؔہِ ٲسؠ گۅڈے تِم بُت اونٹن ہنٛدِس زیٖنس منٛز تھٲومٕتؠ تہٕ پانہٕ ٲس زیٖنس پٮ۪ٹھ بہِتھ۔ لابننؔ دِژ راخِلؔ سٕنٛدِس خٟمس پوٗرٕ پٲٹھؠ ژھٲنڈ مگر بُت آس نہٕ کُنہِ اتھِ۔
\v 35 راخِلؔ ؤژھ پننِس مٲلِس کُن، میانہِ بابہٕ مےٚ گٔژھزینہٕ ناراض، آقا بہٕ ؤژھس نہٕ چٲنِس احترامس منٛز اوٕ موٚکھٕ تھوٚد تکیازِ مےٚ چُھ وُنہِ کیٚن زنہِ حساب چلان۔ "لہٰذا لٔبؠ نہٕ تٔمؠ مذید ژھٲنڈ دِتھ تہِ پنٕنؠ بُت۔
\v 36 پتہٕ کھوٚت یعقوبسؔ سخ شرارتھ۔ تٔمؠ وُن لابنَس، "مےٚ کُس خطا چُھ کوٚرمُت؟ ژٕ کٔمو گنہَو باپتھ چُھکھ مےٚ پتہٕ لاران؟
\v 37 ووُنؠ کٔرتھ ژےٚ میانِس سٲرسےٕ مالس تلٲشی تہٕ ژےٚ میولےٕ نہٕ کانٛہہ چیز یُس چون اوس۔ اگر ژےٚ کینٛہہ میولےٕ سُہ ہاو تہٕ یتِتھ پننؠن تہٕ میانیٚن رشتہٕ دارن برونٛہہ کنہِ، تاکہِ تم کرن فٲصلہٕ زِ کُس چُھ صححی، ژٕ ہا کِنہٕ بۅ!
\v 38 بہٕ اوسُس ژےٚ نِش وُہَن ورؠ ین۔ یمن وُہن ورؠ ین منٛز گییہ نہٕ چٲنؠ کانٛہہ گٔب یا ژھاوج اتھٕ۔ مےٚ مور نہٕ چانہِ کھیٚلہِ منٛزٕ کانٛہہ تیوٗر نَہ کھیٚوم۔
\v 39 ییٚلہِ چانیٚو چاروایو منٛزٕ کٲنسہِ جنگلی جانورن حملہٕ کوٚر یا مورُن مےٚ اوٚن نہٕ سُہ توٚہہِ نِش بلکہِ ترووُم تمِس ممتِس بدل پننیٚو منٛزٕ زندٕ نگ۔ ییٚلہِ تہِ چون کانٛہہ چاروُوے دوٚہلہِ یا روتلہِ راوان اوس تہٕ ژٕ اوسہٕ ہن سُہ مےٚ نِش طلب کران تہٕ بہٕ اوسُس تتھ پنُن ڈنٛڈ بران۔
\v 40 بہٕ اوسُس دوٚہس گرمی تہٕ راتس سردی سٟتؠ دزان۔ اکثر اوسُس نہٕ شونٛگِتھ تہِ ہیٚکان!
\v 41 وُہن ورؠ ین رودُس چٲنِس گرس منٛز۔ چانیٚن کورین سٟتؠ خاندر کرنہٕ موٚکھٕ کٔر مےٚ ژودہَن ورؠ ین چٲنؠ کٲم۔ تہٕ رودُس مذید شیٚن ورؠ ین چٲنؠ تیر ژھاولؠ ہیٚوان کٕنان۔ اتھ دوران کٔرتھ ژےٚ میانِس تنخاہَس دہہِ پھرِ تبدیلی کٔرِتھ کٔمی۔
\v 42 اگر خدا، یمسنٛز عبادت میٚون بُڈِ بب ابرہامؔ کران اوس تہٕ یمِس برُنہہ کنہِ میٚون مول اسحاق لرزان اوس، مےٚ سٟتؠ آسہ ہے نہٕ تہٕ مےٚ مدد کرِہے نہٕ، تہٕ ژٕ کڈہکھ مےٚ ژھوٚرےٕ تہٕ چھۅنےٕ اتھٕ ہاوان۔ مگر خداین وُچھ زِ بہٕ کٲتِس تکلیفس منٛز چُھس تہٕ بہٕ کٲژاہ محنت چُھس کران، اوے وُننے راتھ ژےٚ تمؠ خابس منٛز زِ ژےٚ یہ مےٚ سٟتؠ ورتووُتھ تہِ چُھ غلط۔
\v 43 لابنؔ ووٚتھ یعقوبسؔ درجواب، یم دوٚنوے زنہِ چھےٚ میانہِ کورِ تہٕ یہنٛدؠ بچہ چھِ زُرؠ تہٕ چاروٲے چھِ میانؠ چاروٲے۔ یہ کینٛژھا ژٕ یتہِ وُچھان چُھکھ تہِ چُھ میٚون!
\v 44 مگر بہٕ ہیٚکہ نہٕ یم رٔژھراونَس منٛز کِہین تہِ کٔرِتھ، اوٕ کِنؠ پییہِ ژےٚ تہٕ مےٚ یکہ وٹہٕ اکھ مہادٕ کرُن، یُس اسہِ درمیان شٲہد بنِتھ روزِ۔
\v 45 یعقوبنؔ اوٚن اکھ بوٚڈ پل تہٕ تھووُن سُہ کھڑا کٔرِتھ۔
\v 46 پتہٕ ووٚن یعقوبنؔ پننٮ۪ن رشتہٕ دارن کینٛہہ کَنہِ اننہٕ خٲطرٕ، تِمو انہِ کینٛہہ کَنہِ تھاویکھ ڈیرَس تہٕ پتہٕ کھیٚوکھ اتھ ڈیرس نزدیکےٕ کینٛہہ کھیٚن۔
\v 47 لابننؔ تُھوو اتھ ڈیرس ارامیؔ ناو یجرشاہدوتھاؔ تہٕ یعقوبنؔ تھووُس عِبرٲنؠ ناو جِلعاد۔
\v 48 لابننؔ وُن یعقوبسؔ، "یُس یہ کنیٚن ہُنٛد ڈیر از اسہِ یتہِ جمع کوٚر دییہِ اسہِ مدد یہ مہادٕ یادتھاونَس منٛز۔ "اوے وُن اتھ یعقوبنؔ جِلعادؔ۔
\v 49 تِمو تھوو اتھ جایہ تہِ مِصفاہؔ ناو، عِبرٲنؠ زبٲنؠ منٛز یمیُک مطلب "رٲچھ" چُھ۔ تکیازِ لابنَن وُن، "أسؠ کرو یہُوواہسؔ عرضی زِ سُہ تھاوِ اسہِ نظر یۅتام أسؠ اکھ أکِس نِش رخصت سپدو، تاکہِ أسؠ کرو نہٕ اکھ أکِس نقصان واتناونٕچ کوشش۔
\v 50 اگر ژٕ میانیٚن کوریٚن سٟتؠ بدسلوٗکی کرَکھ یا بدل زنہِ پننہِ خاندارنہِ بناوہکھ، اگر نہٕ مےٚ کانٛہہ یہ ونہِ تہِ، مگر یہ مٔشرٲوؠ زیٚنہٕ زِ خدا چُھ وُچھان ژتہٕ بہٕ کیاہ چھِ کران۔"
\v 51 لابنؔ وُتھ یعقوبسؔ کُن، "ژٕ چُھکھ یہ بٔڈ کٔنؠ تہٕ کنیٚن ہُنٛد یہ ڈیر وُچھان یُس اسہِ منٛزس کھڑا چُھ کوٚرمُت۔
\v 52 کنیٚن ہُنٛد ڈیر تہٕ یہ بٔڈکٔنؠ دونوے روزن اسہِ یاد پاوان زِ ژےٚ نقصان واتناونہٕ خٲطرٕ ترنہٕ بہٕ یمو کنیٚو اپور تہٕ مےٚ نقصان واتناونہٕ خٲطرٕ ترکھ نہٕ ژٕ یمو کنیٚو یپور۔
\v 53 سُہ خدا یمسنٛز عبادت ابرہامؔ کران اوس تہٕ سُہ خدا یمؠ سنٛز عبادت نحورؔ کران اوس تہٕ تِمن معبودن یہنٛز عبادت جدٕ اجداد تیراہؔ کران ٲسؠ دِین اسہِ منٛزٕ تس أکِس سخت سزا یُس کٲنسہِ نقصان واتناوِ۔ "یعقوبنؔ کوٚر سُہ خدا حٲضر نٲضر رٔٹِتھ پوٚختہٕ وعدہ یمسنٛدؠ فرمودات عملاونٕکؠ تمسنٛدس مٲلِس اضحاقسؔ ہٲبتھ اوس یہ تِمو پننِس امن مہادس منٛز وُن۔
\v 54 یعقوبنؔ کٔر تتہِ پہٲڑی علاقس منٛز خدایس قربٲنی پیش تہٕ پننٮ۪ن رشتہٕ دارن کرٕن پانس سٟتؠ کھنٕچ دعوت۔ کھیٚن کھیٚتھ شونٛگؠ تِم اتھ راتس أتؠ۔
\v 55 بیٚکہ، دوٚہہ صبحٲے کٔرؠ لابنن پننٮ۪ن زُرین تہٕ کوریٚن میٹھؠ تہٕ خدایس مونٛگُن دعا، سُہ کٔرِنؠ تِمن برکت۔ پتہٕ دراے لابن تہٕ تمسنٛدؠ نفر اتہِ تہٕ گے گرٕ واپس۔
\c 32
\p
\v 1 ییٚلہ یعقوبؔ تہٕ تمسنٛدؠ گرٕ وٲلؠ سفرس منٛز ٲسؠ، خدایہ سنٛدِ طرفہٕ آے کینٛہہ فرشتہٕ تِمن سمکھنہِ۔
\v 2 ییٚلہِ یعقوبن تِم وُچھ تہٕ ونُن، یہ چُھ خدایہ سُنٛد فوج۔ "امہِ موٚکھٕ تھوو تمؠ اتھ جایہِ محنایمؔ ناو۔
\v 3 یعقوبن وُن کینٛژن شیٚچھِ والٮ۪ن زِ تِم گژھن مےٚ نِش نیرتھ میانِس زٹِھس برادر عیسوؔ ہس نِش۔ یُس عدومؔ چہِ سرِ زمینہ شعیرؔس منٛز روزان چُھ۔
\v 4 تمؠ وُن تِمن، "بہٕ چُھس یژھان زِ عیسوؔ ہس ؤنِو توٚہؠ: بہٕ یعقوب چُھس چون خٲدِم تہٕ ژٕ چُھکھ میٚون مٲلک۔ بہٕ اوسس پننِس پِتٕر لابنَسؔ سٟتؠ تہٕ ونیُک تام اوسُس تٔتؠ روزِتھ۔
\v 5 وُنؠ چھِ مےٚ نِش واریاہ چاروٲے، خر، تیر، ژھاوٕلؠ تہٕ زنہِ تہٕ مرد نوکر۔ وُنؠ چُھسے بہٕ ژےٚ یہ پٲغام سوزان، جناب! امید چھیٚم زِ ییٚلہ بہٕ اور واتہٕ تہٕ ژٕ ورتاوَکھ مےٚ سٟتؠ دوستی۔"
\v 6 قٲصد گے تہٕ واتناوٕکھ یہ شیٚچھ عیسوؔ ہس نِش۔ ییٚلہ تِم یعقوبسؔ نِش واپس آےتہٕ تِمو وُنہَس، "أسؠ ٲسؠ چٲنِس بٔڈس بٲیس عیسوؔ ہس نِشہ گٲمٕتؠ، سُہ چُھ توٚہہِ نِش یورؠ پکان تہٕ تٔمس سٟتؠ چھِ ژور ہتھ نفر۔
\v 7 یعقوبؔس ژاو ہٲبتھ تہٕ بیٚیہِ سپُد سیٹھاہ پریشان۔ تٔمؠ کٔرؠ پنٕنؠ نفر دوٚن جمٲژن منٛز تقسیم۔ تمؠ کٔرؠ تیرن، ژھاولیٚن، چارواین تہٕ اونٹن تہِ زٕ حصہٕ۔
\v 8 تٔمؠ سونچ، "اگر عیسوؔ تہٕ تمسنٛدؠ نفر یرو یتھ اسہِ پٮ۪ٹھ حملہٕ کرن تہٕ شاید ما ہیٚکہٕ دوٚیو جمٲژو منٛزٕ اکھ جماتھ بچِتھ۔
\v 9 پتہٕ موٚنگ یعقوبنؔ دعا، "اے خداوند یہُوواہؔ، یمسنٛز عبادت میانؠ بُڈِ بب ابرہامنؔ تہٕ میانؠ مٲلؠ اسحاقنؔ کٔر، توٚہہِ چُھو مےٚ ونمُت زِ پنُن ملک تہٕ پننٮ۪ن رشتہٕ دارن منٛز گژھِ واپس تہٕ بہ کرٕ ژےٚ سٟتؠ پرٮ۪تھ رنٛگہٕ رُت۔
\v 10 بہٕ چُھس نہٕ یتھ لایق زِ کرکھ پنُن وعدہ، مےٚ سٟتؠ، پننِس خٲدمس سٟتؠ وفادٲری تہٕ قٲبلِ اعتماد ؤتیرٕ پورٕ۔ ییٚلہ مےٚ حرانؔ گژھن وزِ درؠ یاے یردنس تار دیُت مےٚ ٲس تمہِ وزِ صرف یہ لور سٟتؠ، مگر وُنؠ چُھس بہٕ تیوٗت مالدار زِ مےٚ چھِ زِ مےٚ چھِ زٕ بڈؠ خاندان تہٕ مالٕکؠ زٕ بڈؠ انٛبار۔
\v 11 اوے چُھسے وۅنؠ بہٕ منٛگان زِ ژٕ بچاو وُنؠ مےٚ پننِس بٲیس عیسوؔ سنٛدِ اتھٕ تلہٕ تکیازِ مےٚ چُھ ہٲبتھ زِ سُہ تہٕ تمسنٛدؠ نفر ین تہٕ کرن مےٚ پٮ۪ٹھ حملہٕ، تِم مارن شُریٚن تہٕ شُریٚن ہنٛزن ماجن۔
\v 12 مگر یہ مٔشرٲوؠ زیٚنہٕ زِ ژےٚ ونُتھ مےٚ "بہٕ بناوتھ ژٕ ضرور خوشحال تہٕ چٲنؠ ذریاتھ پھٲلاون سمندر بٹھِ کیٚن سیٚکہِ دانن ہنٛدؠ پٲٹھؠ بے شمارٕ۔
\v 13 امہِ رٲژ شونٛگ یعقوبؔ أتھؠ جایہ۔ بیٚکہِ دوٚہہ صبحٲے ژٲرؠ أمؠ کینٛہہ جانور پننِس بٲیس عیسوؔ ہس تحفہٕ رنگؠ دنہٕ خٲطرٕ
\v 14 أمؠ کجہِ زٕ ہتھ ژھاوجہ تہٕ وُوہہ ژھاولؠ، زٕ ہتھ گبہِ تہٕ وُوہہ کٹھ،
\v 15 ترٛہہ اونٹنہِ تہٕ تہِنٛدؠ بچہٕ، ژتجی گاوٕ تہٕ داہ دانٛد، وُوہہ خٔرنہِ تہٕ داہ خر ژٲرتھ۔
\v 16 أمؠ بنٲوؠ یمن لۅکٕٹؠ لۅکٕٹؠ کھیٚلؠ تہٕ پرٮ۪تھ کھیٚول کۅرُن پننِس اکِس اکِس نوکرس حوالہٕ۔ تمؠ وُن پننٮ۪ن نوکرن، "نیریٚو مےٚ برونٛہہ برونٛہہ اکہِ اکہِ، تہٕ پرٮ۪تھ کھیٚلِس منٛزٕ تھٲیو جاے۔"
\v 17 تمؠ وُن پننِس نوکرس یُس گوٚڈنکِس کھیٚلِس سٟتؠ اوس، "ییٚلہِ ژےٚ میٚون بوے عیسوؔ سمکھی تہٕ سُہ پرِژھی ژےٚ، ژٕ کُہنٛد چُھکھ تہٕ گژُھن کوٚت چھی تہٕ یم تیر ژےٚ برونٛہہ برونٛہہ چھی یم کوٚت چھی نیٚنؠ؟"
\v 18 تمِس ؤنؠ زِ "یم چھِ چٲنِس خٲدم یعقوبؔ سنٛدؠ۔ یم جناب سوزؠ نو تٔمؠ توٚہہِ تحفہٕ رنٛگؠ۔ تہٕ سُتہ چُھ اسہِ پتہٕ پتہٕ پکان۔"
\p
\v 19 تٔمؠ وُن دویمِس تہٕ تریمِس کھیٚلِس رٲچھ کرن والیٚن نوکرن تہِ یی تہٕ باقی رٲچھ درن تہِ تھووُن یی ؤنِتھ۔ أمؠ وُن تِمن، "ییٚلہِ توٚہؠ عیسوؔ ہس سمکھیٚو تہٕ بہٕ چُھس یژھان زِ توٚہؠ ؤنیٚو تس سُے کتھ یۅسہ مےٚ گوٚڈنکِس نوکرس ؤنؠ۔
\v 20 تہٕ یہ ؤنؠ زیوس ضروٗری زِ چون خٲدم یعقوبؔ تہِ چُھ اسہِ پتہٕ پکان۔ "یعقوبنؔ وُن یہ اوٕ موٚکھٕ ونُن تکیازِ سُہ اوس سونچان، "یم تحفہٕ بہٕ تمِس سوزان چُھس شاید بنَن یم مےٚ سٟتؠ تمسںنٛدِ بہتر ورتاوٕکؠ بٲعِث۔ پتہٕ ییٚلہِ بہٕ سُہ وُچَھن شاید کرِ سُہ مےٚ سٟتؠ رُت سلوٗک۔"
\v 21 یتھ کنؠ دراے اتہِ تِم نفر یِمن اتھِ تحفہٕ ٲسؠ مگر یعقوبؔ رود پانہٕ امہِ رٲژ خٟمہٕ سےٕ منٛز۔
\v 22 رٲژ منٛزےٕ وُتھ اکہِ وزِ یعقوبؔ تھوٚد تہٕ پننہٕ خاندارنہِ زٕ، لونٛڈی زٕ تہٕ نیٚچوؠ کاہ سوزِن دریاے یبوقؔ کِس بٔٹِھس پٮ۪ٹھ۔
\v 23 ییٚلہِ تمؠ پنٕنؠ سٲری بٲژ دریاے یبوقؔ اپور سوزؠ تہٕ تمؠ سوزؠ پنٕنہِ ملکیتٕکؠ سٲری چیز تِمنےٕ سٟتؠ۔
\v 24 یتھ کنؠ رود یعقوبؔ تتہِ کُنےٕ زُن۔ مگر اکھ نفر آو تہٕ تمؠ لٲج صبحس گاش ینَس تام تمِس سٟتؠ دَب۔
\v 25 ییٚلہ تمِس نفرس فکرِ توٚر زِ یعقوبسؔ مقابلہٕ ہیٚکہٕ نہٕ بہٕ زینِتھ، تمؠ تروو تمِس زیرِس ٹاس تہٕ تمِس آیہ زیرِس نِش لنٛگٕچ أڈِج نیرتھ۔
\v 26 پتہٕ وُن تمؠ نفرن، "مےٚ دِیو نیرنہٕ تکیازِ دوٚہلؠ گاش چُہ ینہٕ وول۔ "یعقوبن ونُس در جواب، "نہ، اگر نہٕ ژٕ مےٚ دعا کرکھ، بہٕ دِمے نہٕ ژےٚ نیرنہٕ۔"
\v 27 تمؠ نفرن وُن تمِس، "چون ناو کیاہ چُھ؟" تمؠ ونُس "یعقوب"
\v 28 تمؠ نفرن ونُس، "وُنؠ روزی نہٕ ژےٚ یعقوبؔ ناو۔ چون ناو آسہ اسرائیل، تمیُک مطلب گو "سُہ چُھ خدایس سٟتؠ جد و جہد کران" تکیازِ ژےٚ کٔرتھ خدایس تہٕ لوٗکن سٟتؠ جد و جہد تہٕ ژےٚ زیونُتھ۔
\v 29 یعقوبنؔ ونُس، "وُنؠ ونتہٕ مےٚ پنُن ناو!" تمؠ نفرن ونُس "ژٕ کیازِ چُھکھ مےٚ پرِژھان زِ ناو کیاہ چھی؟ مگر تمؠ کوٚر تتہِ تمِس دعا۔
\v 30 اوٕ کِنؠ تھوو یعقوبنؔ تتھ جایہ "فنی ایل" یعنی "خدایہ سُنٛد بُتھ" ناو، مطلب اوس مےٚ وُچھ سیدِ سیٚود خدایس کُن مگر یہ کرنہٕ سٟتؠ مودُس نہٕ بہٕ۔
\v 31 ییٚلہِ یعقوبؔ فنُوایل جایہ نشہٕ دراو آفتاب اوس کھسُن ہیٚوان مگر زیرِس لگنہٕ کِنؠ اوس سُہ لنٛگان۔
\v 32 تمسنٛدِ زیریُک جوڈ اوس زخمی سپدمُت۔ تتھ وقتس منٛز ٲسؠ نہٕ بنی اسرائیل لٕکؠ لوکھ یعقوبسؔ زیرِ کِس جوڈس لگنہٕ کِنؠ جانورن ہنٛدِ زیریُک ماز کھیٚوان۔
\c 33
\p
\v 1 پتہٕ ووت یعقوبؔ پننٮ۪ن گرِکیٚن نِش۔ امہ دوٚہہ پتہٕ وُچھ یعقوبنؔ عیسوؔ یوان تہٕ تمِس سٟتؠ ٲسؠ ژور ہَتھ نفر۔ امہِ کِنؠ گو یعقوبؔ پریشان، تمؠ تھٲوؠ بچہٕ الگ کرِتھ۔ تِمے تھٲوؠ لیاہؔ ہنٛدے شُرؠ لیاہؔ سٟتؠ، راخِلؔ ہنٛدؠ شُرؠ راخِلؔ سٟتؠ تہٕ لونٛڈؠ ین ہنٛدؠ بچہٕ کٔرِنؠ لونٛڈین حوالہٕ۔
\v 2 تمؠ تھاوِ لونٛڈی زٕ بچہٕ ہیٚتھ برونٛہہ کنہِ۔ تمہِ پتہٕ تھٲون لیاہؔ تہٕ تمسنٛدؠ شُرؠ۔ راخِلؔ تہٕ یوسفؔ تھٲوِن پتھ کُن۔
\v 3 تہٕ پانہٕ دراو یمن سارنی برونٛہہ تہٕ ووت پننِس زٹِھس بٲیس نزدیک تہٕ دِتُن ستہِ لٹہ زمینَس پٮ۪ٹھ سجدٕ۔
\v 4 مگر عیسوؔ دوریو یعقوبسؔ نِش۔ تمؠ روٚٹ سُہ نالہٕ متہِ، بُتھِس دِتؠ نس بوسہٕ۔ تہٕ تِم دوٚنوے لگؠ ریٚونہِ۔
\v 5 عیسوؔ ہن دِژ نظر تہٕ اتہِ وچُھن زنہِ تہٕ شُرؠ۔ تمؠ پرُژھ یمہٕ کمہٕ چھِ توٚہہِ سٟتؠ؟ یعقوبن دتُس جواب، "یم چھےٚ تمہٕ زنانہٕ تہٕ شُرؠ یم مےٚ خداین عطا کٔرؠ۔"
\v 6 پتہٕ آیہ لونٛڈی تہٕ تِہنٛدؠ بچہٕ عیسوؔ ہس برُونٛہہ کُن تہٕ نمییہِ۔
\v 7 پتہٕ آیہ لیاہؔ تہٕ تمسنٛدؠ بچہٕ تہٕ کوٚرکھ سجدٕ۔ پوٚتس آے یوسفؔ تہٕ راخِلؔ نزدیک تہٕ جُکیاے۔
\v 8 عیسوؔ ہن پرُژھ، "یم ییتیاہ چاروٲے بہ وُچھان چُھس اتھ کیاہ چُھ مطلب؟ یعقوبنؔ ونُس یورٕ، "جناب، یم چُھسے بہٕ ژےٚ دِوان، تاکہ ژٕ سونٛچکھ مےٚ نیسبت رُت۔"
\v 9 مگر عیسوؔ ہن ونُس، "میانہِ لۅکٹہِ بایہ، مےٚ چھِ واریاہ چاروٲے۔ یم چاروٲے ژےٚ چھی تھاوُکھ پانس!
\v 10 یعقوبنؔ ونُس، "نہ، اگر ژےٚ بہٕ بہتر چُھسے باسان تیٚلہ کر میٚون یہ تحفہٕ قبوٗل۔ ژےٚ کٔرتھ مےٚ سیٹھاہ لولہٕ سان سلام، چانہِ اسوٕنہِ ہونٛجہ پیش ینہٕ باسیٚو مےٚ زِ ژےٚ کۅرتھ مےٚ معاف۔ زنتہٕ وُچھ مےٚ خدایہ سُنٛدےٕ بُتھ!
\v 11 مہربٲنی کرِتھ کر تہٕ یم تحفہٕ قبوٗل یم مےٚ چانہِ خٲطرٕ أنمٕتؠ چھِ تکیازِ خداین چھےٚ مےٚ بٔڈ عنایت کٔرمٕژ تہٕ مےٚ نِش چھِ وُنہ واریاہ چو چاروٲے۔ "یعقوب رود تمِس یم جانور قبوٗل کرنُک تٲکید کران، تہٕ ٲخرس کٔرؠ عیسوؔ ہن یم قبوٗل۔
\v 12 پتہٕ ونُس عیسوؔ ہن، "وۅلہ أسؠ کڈو یکہٕ وٹہٕ سفر، بہٕ ہاوے ژےٚ وتھ۔
\v 13 یعقوبنؔ ونُس، "جناب، ژٕ چُھکھ زانان مےٚ چُھ یمن تیرن تہٕ گاون ہُنٛد خیال تھاون یمن چھِ بچہٕ دود چیٚوان تہٕ یم بچہ چھِ کمزور تہِ۔ اگر بہٕ یم اکسےٕ دوٚہس زیٹِھس سفرس لاگکھ یم مرن سٲری۔
\v 14 ژٕ نیر مےٚ برونٛہہ برونٛہہ۔ بہٕ پکہٕ ناوکھ یم چاروٲے وار وارٕ۔ بہٕ پکہٕ تیٚوتُے تیز یُتھ یم بچہٕ تہٕ چاروٲے پٔکِتھ ہیٚکن۔ بہٕ کرٕ ژےٚ سٟتؠ شعیرؔس منٛز ملاقات۔
\v 15 عیسوؔ ہن ونُس تیٚلہِ دِ مےٚ اجازت، بہٕ تراوکھ پنٕنؠ کینٛہہ نفر یتؠ یم مےٚ سٟتؠ آمٕتؠ چھِ تاکہ تِم کرن تُہنٛز حفاظت۔ مگر یعقوبنؔ دِتُس جواب، کمہِ خٲطرٕ؟ بہٕ چُھس صرف یہ یژھان زِ ژٕ گوٚژُھکھ مےٚ نیسبت جان سونٛچُن۔
\v 16 یتھ کنؠ سپُد امی دوٚہہ عیسوؔ شعیر علاقس کُن روانہٕ۔
\v 17 مگر یعقوب تہٕ تمسُنٛد خاندان گو شعیرؔ بجایہ سُکاتؔ ناوچہِ جایہ کُن۔ تتہِ بنوو تمؠ پانس تہٕ پننہِ عیالہٕ باپتھ اکھ گرٕ، تہٕ چاروایو باپتھ تہِ روزن جاے۔ اوے تھوو تمؠ اتھ جایہ سکاتؔ ناو مطلب "روزن جاے"
\v 18 یتھ پٲٹھؠ کوٚر یعقوبؔ تہٕ تمسنٛدؠ خاندانن فدن ارامؔ جایہ پٮ۪ٹھٕ کنعانؔ چہِ سرِزمینہِ کُن پُر امن سفر۔ تتہِ لٲگؠ تِمو سِکم شہرس نزدیک اکِس کھہَس منٛز پنٕنؠ خٟمہ،
\v 19 تمہِ علاقہٕ کیٚن لوٗکن ہُنٛدیو زِٹھیٚو منٛزٕ اوس حمورؔ ناوُک۔ حمورسؔ ٲسؠ واریاہ نیٚچوؠ۔ یعقوبنؔ دِتؠ سِکم سنٛدؠ مٲلؠ حمورؔ سنٛدین نیٚچوٮ۪ن چاندِ ہنٛدؠ اکھ ہتھ سکہٕ تمہِ زمینہِ ہنٛدِ ماوضہ رنٛگؠ یتھ پٮ۪ٹھ تِمو خٟمہ لٲگؠ۔
\v 20 تمؠ بنٲو تتہِ کنیٚن ہنٛز اکھ قربان گاہ تہٕ تمیُک ناو تھووُن "ایل اِلہ اسرائیل" مطلب "خدا، اسرائیل لُک خدا۔"
\c 34
\p
\v 1 اکہِ دوٚہہ درایہ یعقوبنؔؠ تہٕ لیاہؔ ہنٛز کور دینہؔ امہِ علاقچن کینٛژن زنیٚن سمکھنہِ
\v 2 سِکمؔ اوس حمورؔ سنٛدیو نیٚچیو منٛزٕ اکھ تہٕ سُہ اوس حوی زٲژ ہُنٛد۔ ییٚلہ تمؠ سۅ وُچھ تمؠ رٔٹ سۅ تہٕ کوٚرُن تس سٟتؠ جبری ناجایز۔
\v 3 سُہ گو یعقوب سنٛزِ کورِ دینہؔ ہس کٲفی عاشق تہٕ گوس تمسُنٛد محبت۔ سُہ لوٚگ تس لول بَرنہ، تہٕ لٲجِن تس سٟتؠ سیٹھاہ نرمی سان کتھ کرنؠ۔
\v 4 سِکم وُتھ پتہٕ پننِس مٲلِس حمورسؔ کُن، "مہربٲنی کرِتھ انتن یہ کور میانہِ باپتھ۔ بہٕ چُھسن یژھان سۅ پنٕنؠ خاندارنؠ بناونؠ!"
\v 5 ییٚلہ یعقوبن یہ بوز زِ سِکمنؔ چھےٚ تمؠ سنٛز کور دینہؔ رٹمٕژ تہٕ تس سٟتؠ چُھس ناجایز کوٚرمُت، تمسنٛدؠ شُرؠ ٲسؠ وُنہ پننٮ۪ن چارواین سٟتؠ کھہسےٕ پٮ۪ٹھ، لہٰذا وُن نہٕ تمؠ اتھ متلق تۅتام کِہین یۅتام نہٕ تِم گرٕ واپس آے۔
\v 6 اتھ دوران گو سِکم سُنٛد مول حمورؔ یعقوبس سٟتؠ کتھ کرنہِ درامُت۔
\v 7 یعقوبنؔؠ لڑکہٕ آے یوٗت کال کھہہ پٮ۪ٹھٕ تہٕ ژاے اندر، ییٚلہ تِمو بوز زِ کیاہ چُھ سپُدمت، تِم گے حٲران تہٕ کھوٚتُکھ سخ شرارتھ۔ تکیازِ سِکمنؔ اوس یعقوبؔ سنٛزِ کورِ سٟتؠ زبردستی کرِتھ اسرائیل سیٹھاہ رسوا کوٚرمُت۔ سۅ ٲس تمِس بیٚنہِ۔ یہ اوس سیٹھاہ ہٲبت ناک اتُر یُس نہٕ زانٛہہ سپدُن گوٚژھ۔
\v 8 مگر حمورنؔ وُن تِمن، "میٚون نیٚچو سِکمؔ چُھ پزؠ پٲٹھؠ أمِس لڑکی پسنٛد کران یۅسہ تُہنٛز کور تہٕ چٲنؠ بیٚنہِ چھےٚ، مہربٲنی کرِتھ دی تو أمِس سِکمَس سٟتؠ خاندر کرنُک اجازت۔
\v 9 ٲسؠ کرو اکھ مہادٕ زِ توٚہؠ دیو پننہِ کورِ سانیٚن لڑکن نیتٕرؠ تہٕ أسؠ دمو پننہِ کورِ تُہنٛدین لڑکن نیتٕرؠ۔
\v 10 توٚہؠ ہکیٚو اسہِ سٟتؠ روزِتھ تہٕ سٲنِس ملکَس منٛز یتِتھ یژھیٚو تتِتھ بٔسیو۔ توٚہؠ ہکیٚو یتہِ چیز ہیٚتھ تہٕ کنِتھ۔ اگر توٚہہ ضرورتٕچ زمین میلہِ توٚہؠ ہکیٚو سۅ مٔلؠ ہیٚتھ۔"
\v 11 سِکمؔ وُتھ پتہٕ دینہؔ ہنٛدس مٲلِس تہٕ بیٚیہِ بٲیس، اگر توٚہہ بہٕ ٹھیک باسان چُھس تیٚلہِ کٔرؠ تو تہِ یہ بہٕ ونان چُھس تہٕ یہ توٚہؠ منٛگیٚو تہِ دِمہٕ بہٕ توٚہہ۔
\v 12 مےٚ ؤنیٚو توٚہؠ کُس تحفہٕ چُھو یژھان تہٕ مہرنہِ ہُنٛد قٟمت کیاہ چُھو ونان بہٕ چُھس تہِ دنہٕ خٲطرٕ تیار یہ توٚہؠ ؤنیٚو۔ بہٕ چُھس صرف یہ یژھان زِ توٚہؠ دی وون مےٚ یہ کور نیتٕرؠ۔
\v 13 مگر سِکمنؔ اوس تہنٛزِ بیٚنہِ دینہؔ سٟتؠ شرمناک کٲم کرمٕژ یمہِ کِنؠ یعقوبؔ سنٛدیو شُریٚو سِکمؔ تہٕ تمسنٛدِس مٲلِس حمورسؔ جواب کوٚر۔
\v 14 تِمو وُن تِمن، "نہ، أسؠ ہیٛکو نہٕ یہ کرِتھ۔ أسؠ دِموون نہٕ پنٕنؠ بیٚنہِ تِتھس نفرس نیتٕرؠ یمِس نہٕ خُتنہٕ کرنہٕ آمُت آسہ، یہ چھےٚ سانہِ باپتھ شرمہِ ہنٛز کتھ۔
\v 15 أسؠ کرو یہ سورےٕ اتھ صوٗرتس منٛز ییٚلہ توٚہؠ اکھ کٲم کریٚو: یم تہِ توٚہہ منٛز مرد چھِ تِمن سارنےٕ مردن پییہِ سٲنؠ پٲٹھؠ ختنہٕ کرُن۔
\v 16 تیٚلہِ ہیٛکو أسؠ پننہٕ کورِ تُہنٛدین جوانن نیتٕرؠ دِتھ تہٕ پننٮ۪ن جوانن تُہنٛزٕ کورِ خاندارنہِ بنٲوِتھ۔ أسؠ بسو توٚہہِ سٟتؠ تہٕ بنو اکھ الگ ونڈٕ۔
\v 17 وُونؠ اگر توٚہؠ ختنہٕ کرنس پٮ۪ٹھ آمادٕ چُھو نہٕ تیٚلہ تُلوون أسؠ پنٕنؠ بیٚنہٕ تہٕ نیرو۔
\v 18 تِہنٛد ونُن باسیٚو حمورؔ تہٕ تمسنٛدس نیٚچوِس سِکمس ٹھیک۔
\v 19 سِکمؔ اوس یعقوبٕنؔؠ کور پزنہٕ پٲٹھؠ پنٕنؠ آشِنؠ بناوُن یژھان؛ یپٲرؠ اوس سُہ پننِس مٲلؠ سنٛدِ خاندانہٕ منٛزٕ ساروےٕ کھۅتہٕ قٲبلِ احترام شخص، امہِ کِنؠ کٔر تمؠ یکدم تِہنٛز تجویز قبول۔
\v 20 سِکمؔ گو حمورسؔ سٟتؠ شہرٕ کِس دروازس نکھٕ جلسہٕ گاہَس نِش شہرٕ کیٚن زِٹھیٚن سٟتؠ کتھ باتھ کرنہٕ موٚکھٕ۔ تمو وُن،
\v 21 "یم لوٗکھ چھِ سٲنؠ دوس بٔنتھ۔ اسہِ پزِ یمن یتہِ پھیرنہٕ تھورنہٕ تہٕ روزنہٕ دیُن۔ یہ زمین چھےٚ بے شک تیٖژ بٔڈ یتھ منٛز أسؠ تہٕ یمہٕ ویٚپِتھ ہیٚکو۔ سٲنؠ نوجوان ہیٚکن یہنٛزن کوریٚن سٟتؠ خاندر کرِتھ تہٕ یہنٛدؠ جوان ہیٚکن سانیٚن کورین سٟتؠ خاندر کرِتھ۔
\v 22 مگر یم لوٗکھ چھِ اسہِ سٟتؠ روزنس تیار تہٕ اسہِ سٟتؠ اکہِ ونڈٕ رنٛگؠ یتھ شرطتس پٮ۪ٹھ بسنہٕ باپتھ آمادٕ زِ سٲنؠ تمام مرد گژھن ختنہٕ کرٕنؠ یتھ کنؠ تِمن کرِتھ چُھ۔
\v 23 ہنا سونٛچِو! اگر أسؠ یہ کرو، تِہنٛزٕ گٲو، تِہنٛد مال تہٕ تہنٛدؠ تمام چاروٲے بنَن سٲنؠ۔ اوٕ کِنؠ پزِ اسہِ تہِ کرنٕچ رضامنٛدی ہاونؠ یہ تم ونان چھِ تہٕ پتہٕ روزن تِم اسہِ سٟتؠ۔
\v 24 تِمو ساروےٕ لوٗکو مٲنؠ حمورؔ تہٕ سِکمؔ سنٛز یہ تجویز یم اتھ شہری دروازس نِش ٲسؠ۔ شہرٕ کیٚو تمام لوٗکو کوٚر ختنہٕ۔
\v 25 امہِ پتہٕ ترییہِ دوٚہؠ ییٚلہِ وُنہ شہرٕکؠ سٲری لوٗکھ ختنہٕ کِس تکلیفسےٕ منٛز ٲسؠ دراے یعقوب سنٛدؠ زٕ نیٚچیو شمعونؔ تہٕ لاوی دینہؔ سنٛدؠ بٲے زٕ تلوارٕ ہیٚتھ تہٕ ژاے شہرس منٛز کٲنسہِ ہنٛدِ رکاوٹہٕ بغٲر نی تِمو سٲری مرد مٲرتھ۔
\v 26 تمو کوٚر حمور تہٕ تمسُنٛد نیٚچو سِکم تہِ قتل۔ پتہٕ أنؠ تِمو پنٕنؠ بیٚنہِ دینہؔ سِکم سنٛدِ گرٕ منٛزٕ نیٚبر کٔڈتھ تہٕ دراے امہِ شہرٕ منٛزٕ۔
\v 27 پتہٕ ژاے یعقوبٕنؠ باقی نیٚچیو اتھ شہرس منٛز یتہٕ تِم تمام لاشہٕ آسہٕ۔ تمو کوٚر پننہٕ بیٚنہِ سٟتؠ سپدیمتِس تتھ شرمناک واقہٕ ہس خلاف شہرس لوٗٹھ۔
\v 28 تمو أنؠ لوٗکن ہنٛدؠ تیر، ژھاولؠ، تہنٛزٕ گاو، خر تہٕ سُہ پرٮ۪تھ اکھ چیز یُس تِمو یوٚژھ شہرٕ منٛزٕ کٔڈتھ تہٕ نیٖکھ گامن کُن۔
\v 29 تِمو نی پرٮ۪تھ اکہ قٟمتی چیزٕ علاوٕ بچہٕ تہٕ زنہِ تہِ۔ گرن منٛز یہ کینٛژھا اوس تہِ نیوکھ ؤٹِتھ۔
\p
\v 30 پتہٕ وُن یعقوبنؔ شمعونَسؔ تہٕ لاوی یس، "توٚہہِ تُرووس بہٕ بٔڈس مصیبتس منٛز۔ ووُنؠ کرن مےٚ سٟتؠ کنعانٕکؠ لوٗکھ، فرزوؔیچہِ لُکہٕ جمٲز تہٕ یتھ ملکس منٛز زوزن وٲلؠ تمام لوٗکھ نفرت۔ مےٚ سٟتؠ چُھنہٕ زیادٕ لوٗکھ یم سانہِ خٲطرٕ لڑن، اگر تِم ساری سمِتھ اسہِ نِش ین تہٕ حملہٕ کرن تِم کرن اسہِ تہٕ سانین تمام گرٕ والیٚن تباہ۔
\v 31 مگر تِمو دتُس جواب، "کیاہ اسہِ پزِہے یا تیٚلہِ سِکمسؔ پننہِ بیٚنہِ سٟتؠ طوائفہِ ہُنٛد ہیٚو سلوٗک کرنُک اجازت دیٚون؟"
\c 35
\p
\v 1 کینٛہہ کٲلؠ پتہٕ وُن خداین یعقوبسؔ، "بیت ایلؔ شہرش منٛز گژھیٚو تہٕ تٔتؠ بٔسیٚو۔ میانہِ خٲطرٕ بنٲیو اکھ قربان گاہ، خدا، یُس ژےٚ تمہِ ساعتہٕ برُونٛہہ کُن ٲے ییٚلہِ ژٕ پننِس بڈِس بٲیس عیسوؔ ہس نِش ژلان اوسُکھ۔"
\v 2 یعقوبنؔ ووٚن پننٮ۪ن گرٕ والیٚن تہٕ پنس سٟتؠ تمام روزن والیٚن لوٗکن، یم بُت کٔرؠ ووکھ دفاہ یم توٚہہِ میسوپوٹیمیا ملکہٕ پٮ۪ٹھٕ أنمتؠ چُھو۔ امہِ پتہٕ کٔریٚو سران تہٕ بیٚیہِ لٲگیٚو نٔوؠ پلو۔
\v 3 امہِ پتہٕ سپدو أسؠ تیار بیت ایلؔ گژھنہٕ خٲطرٕ۔ تتہِ بناوٕ بہٕ خدایہ سنٛدِ عبادتہٕ خٲطرٕ اکھ قربان گاہ۔ تٔسؠ خدایہ سنٛز یمؠ مےٚ تمہ ساعتہ مدد کوٚر یمہِ ساعتہٕ بہٕ سیٹھاہ پریشان تہٕ خوفزدٕ اوسُس تہٕ یوٚت تہِ بہٕ گوس تتہِ رودم سٟتؠ۔
\v 4 تمو کٔرؠ یعقوبسؔ تِم سٲری بُت حوالہٕ یم تِمو أنمٕتؠ ٲسؠ تہٕ بیٚیہِ دِتؠ ہس پنٕنؠ سٲری کنہٕ دوٗر۔ یعقوبن کٔرؠ تِم بلوط کِس اکِس بڈِس کُلِس تلہٕ کنہِ سِکم شہرس نزدیکےٕ زمینس منٛز دفن۔
\v 5 ییٚلہِ تمو تتہِ نیرنٕچ تیٲری کٔر خداین ترُوو تِمن سارنےٕ لوٗکن یعقوبؔ سنٛدِ خاندانُک ہٲبتھ یمہٕ تِمن انٛدؠ پٔکؠ شہرن منٛز روزان ٲسؠ تاکہِ تِم سیٚدن نہٕ تمن پتہٕ۔
\v 6 یعقوبؔ تہٕ تِم سٲری یم تمِس سٟتؠ ٲسؠ گے کنعانچہِ لُوزؔ جایہ یتھ وُنؠ بیت ایل ونان چھِ۔
\v 7 تتہِ بنٲو تمؠ اکھ قربان گاہ۔ تمؠ تھوو تتھ جایہ ایل بیت ایلؔ ناو، یمیُک مطلب "بیت ایلُک خدا" چُھ۔ تکیازِ یہ ٲس سُے جاے یتہِ خداین یعقوبسؔ پنُن جلوٕ ہایو ییٚلہِ تس پننِس بڈِس بٲیس عیسوؔ سُنٛد ہٲبتھ ژایو۔
\v 8 دبورہؔ یۅسہ اسحاقنہِؔ آشنہِ رِبقہؔہِ رچھان ٲس ییٚلہ سۅ لۅکٕٹ ٲس تہٕ وُنؠ چھےٚ سۅ سیٹھاہ بُڈٕ۔ یہےَ گُذرییہِ تہٕ کرٕکھ بیت ایلؔ کِس جنوبس منٛز بلوط کِس أکِس کُلس تل دفن۔ تہٕ اتھ جایہ تھوو تِمو الوُن بکوتؔ ناو۔ مطلب "ودٕوُن بلوط۔"
\v 9 ییٚلہِ یعقوبؔ تہٕ تمسُنٛد عیال فدن ارامؔ پٮ۪ٹھٕ واپس آو ییٚلہِ تِم وُنہِ بیت ایل سےٕ منٛز ٲسؠ، خداین دیُت یعققوبس بیٚیہِ جلوٕ تہٕ کٔرنس برکت عطا۔
\v 10 خداین وُن تمِس بیٚیہِ، "چون ناو روزنہٕ وُنؠ یعقوبؔ بلکہِ اسرائیل" لہٰذا ونُکھ وُنؠ یعقوبسؔ "اسرائیل۔"
\v 11 پتہٕ وُن خداین تمِس" بہٕ چُھس قدرت وول خدا۔ واریاہ بچہٕ کر پٲدٕ۔ چانہِ زُریٲژ ہنٛدؠ بنَن واریاہ قوم تہٕ تِمو منٛزٕ آسن کینٛہہ بادشاہ تہِ۔
\v 12 سُہ ملک یُس مےٚ ابرہامسؔ تہٕ اضحاقسؔ دِنُک وعدہ اوس کوٚرمُت سُہ دِمے بہٕ ژےٚ۔ بیٚیہِ دمہٕ سُہ چانیٚن اولادن تہِ۔"
\v 13 ییٚلہِ خداین یعقوبسؔ سٟتؠ اتہِ کتھ کرِتھ مۅکلٲو، تہٕ تمؠ ترُوو سُہ۔
\v 14 یعقوبنؔ تھٲو تتھ جایہ اکھ بٔڈ کٔنؠ کھڑا کرِتھ یتِتھ خداین تس سٟتؠ کتھ کٔر۔ تمؠ ترٲو تتھ پٮ۪ٹھ شربت تہٕ زیتون تیٖل یُتھ سُہ تتھ خدایہ سنٛدِ ناوٕ وقف کرِہے۔
\v 15 یعقوبَن تھوو تتھ جایہِ بیت ایلؔ ناو یمیُک مطلب "خدایہ سُنٛد گرٕ" چُھ۔ تکیازِ خداین کٔر اتھ جایہ تمِس سٟتؠ کتھ۔
\v 16 یعقوبؔ تہٕ تمسُنٛد خاندان گو بیت ایل کہِ جنوب طرفہٕ افراتؔ شہرس کُن روانہٕ۔ ییٚلہ تِم افراتؔ شہرس نزدیک وٲتؠ تہٕ راخِلؔہِ کوٚرُن سخت دردِ زیٚہہ۔
\v 17 ییٚلہِ تمِس انیٖکھ دگ ۅتلییہِ تہٕ تمِس وُن دایہِ، "کھۅژ مہ، تکیازِ ژےٚ دِتُتھ بیٚکِس نیٚچوِس زایُن۔
\v 18 مگر سۅ ٲس مران تہٕ پننٮ۪ن ٲخری شہَن منٛز وُن تمہِ، "أمِس تھٲوؠ زیٚو بِنونیؔ ناو" یمیُک مطلب "میانہِ غمُک نیٚچو" مگر تمسنٛدؠ مٲلؠ تھوو تمِس بنیمِینؔ ناو تمیُک مطلب گو "میانہ دٔچھنہِ اتھک نیٚچو۔"
\v 19 راخِلؔ کٔرکھ مرنہٕ پتہٕ افراتؔ جایہ دفن وتہِ سٟتی دفن یتھ وُنؠ بیت لحمؔ ونان چھِ۔
\v 20 یعقوبنؔ تھٲو تمؠ سنٛزِ قبرِ پٮ۪ٹھ اکھ بٔڈ کٔنؠ کھڑا کرِتھ یمہِ سٟتؠ ننان اوس زِ راخِلؔ ہنٛز قبر کتِتھ چھےٚ۔
\v 21 یعقوبؔ، یمسُنٛد نوُو ناو اسرائیل اوس رود پننِس خاندانس سٟتؠ سفر جٲری تھٲوِتھ، تہٕ تٔمؠ دِتؠ عدرؔ جایہ نظر تھاونہٕ کیٚن میٖنارن جنوب پاسہٕ پنٕنؠ خٟمہٕ۔
\v 22 ییٚلہِ تِم اسرائیل کِس اتھ علاقس منٛز روزنہِ لٔگؠ تہٕ یعقوبؔ سُنٛد نیٚچو رُوبِنؔ شونٛگ پننِس مٲلؠ سنٛزِ اکِس لونڈی بِلہاؔ ہس نِش۔ کٔمؠ تام وُن یعقوبسؔ اتھ مُتلق تہٕ تمِس کھوٚت سخت شرارتھ۔
\p یعقوبسؔ ٲسؠ وُنؠ باہ لٔڑکہٕ۔
\v 23 لیاہؔ سنٛدیو لٔڑکو منٛزٕ اوس یعقوبسؔ رُوبِنؔ زیُٹھ ہیٚو نیٚچو۔ پتہٕ شمعونؔ، لاوی، یہُوداؔ، اشکارؔ تہٕ زبُلُون۔
\v 24 راخِلؔ سنٛدیو اولادو منٛزٕ ٲسِس یوسفؔ تہٕ بنیمِینؔ۔
\v 25 راخِلؔ سنٛزِ لونڈی بِلہاؔ سنٛدؠ دانؔ نفتالیؔ۔
\v 26 لیاہؔ سنٛزِ لونڈی زلفہؔ سنٛدؠ نیٚچوؠ ٲسؠ جدؔ تہٕ آشرؔ۔ بنیمِینسؔ بغٲر ٲسؠ یم سٲری اولاد یعقوبسؔ تمہِ وزِ زامٕتؠ ییٚلہِ سُہ فدن ارامؔ روزان اوس۔
\v 27 یعقوبؔ گو پننِس مٲلِس اضحاقسؔ نِش ممرےؔ واپس، یتھ قریتؔ اربعؔ ونان ٲسؠ تہٕ وۅنؠ چِھس حبرون ناوٕ تہِ زانان تتہِ اوس اسحاق سُنٛد مول ابرہامؔ تہِ روزان۔
\v 28 اسحاقؔن گُذٲرؠ اکھ ہتھ تہٕ شیتھ ؤری وانٛسہِ ہنٛدؠ۔
\v 29 ییٚلہِ اسحاقن وفات کوٚر تمہ وزِ اوس سُہ سیٹھاہ بُزرگ تہٕ ووت پننِس مٲلِس تہٕ بُڈؠ ببَس نِش یمو گۅڈے وفات کوٚرمُت اوس۔ تمسنٛدیٚو اولادو عیسوؔ تہٕ یعقوبنؔ کوٚر سُہ دفن۔
\c 36
\p
\v 1 یہ چُھ تِمن لوٗکن ہُنٛد نسب نامہٕ یم عیسوؔ سنٛدِ پُشتٕکؠ چھِ، یہُنٛد بیاکھ ناو عدومؔ اوس۔ تہٕ تِمن نیسبت کیاہ سپُد۔
\v 2 عیسوؔ ہن کوٚر کنعانچَن تریٚن زنیٚن سٟتؠ خاندر: اکھ ٲس حِتی ایلونؔ سنٛز کور عدہؔ۔ عناہہِؔ ہنٛز کور تہٕ حوی صبعونؔ سنٛز زُر اُہلیبامہؔ،
\v 3 تہٕ اسماعیلؔ سنٛز کور تہٕ نبایوتؔ سنٛز بیٚنہِ بشامہؔ
\v 4 عیسوؔ سنٛزِ آشنہِ عدہؔ ہَس زاو الیفزؔ۔ بشامہؔ ہِس زاو رعوایلؔ۔
\v 5 اُہلیبامہؔ ہَس زاے یعوسؔ، یعلامؔ تہٕ قورحؔ۔ یم سٲری اولاد زاے عیسوؔ ہَس تمہِ وزِ ییٚلہِ سُہ کنعان ملکس منٛز روزان اوس۔
\v 6‏-7 یعقوبسؔ تہٕ عیسوؔ ہس نشہٕ اوس واریاہ مال۔ امہِ کِنؠ ٲس تِمن چاروایو خٲطرٕ مزید جایہ ہنٛز ضرورت۔ یتہِ تِم روزان ٲسؠ تتہِ اوس نہٕ تِمن چاروایو خٲطرٕ تیوٗت جاگات۔ امہِ کِنؠ تُلؠ عیسوؔ ہن یمِس بیاکھ ناو عدومؔ اوس پانس سٟتؠ پننہِ گرٕواجنہِ، شُرؠ تہٕ باقی گرٕباژ، پنٕنؠ تیر، ژھاولؠ تہٕ باقی چو چاروٲے تہٕ تِم سٲری چیز یِم تمؠ کنعان ملکہٕ منٛز حٲصل کٔرمٕتؠ ٲسؠ تہٕ دراو تِتھس علاقس کُن یُس یعقوبسؔ نِش واریاہ دوٗر اوس۔
\v 8 تِم گے شعیرؔ کِس بالٲئی علاقس کُن روزنہِ۔
\v 9 یمہٕ چھِ عیسوؔ سنٛدِ پُشتٕکؠ لوٗکھ یِم عدومؔ قبیلٕکؠ جد و اجداد ٲسؠ یِم شعیر کیٚن بالٲئی علاقن منٛز روزنہِ گے۔
\v 10 عیسوؔ سنٛزِ آشنہِ عدہؔ ہَس زاو الیفزؔ تہٕ بشامہؔ ہَس زاو رعوایلؔ۔
\v 11 الیفزؔ سُنٛد نیٚچو اوس تیمانؔ، اومرؔ، صفوؔ، جعتامؔ تہٕ قنزؔ۔
\v 12 عییسوؔ سنٛدِس نیٚچوِس الیفزسؔ تہِ ٲس اکھ لونڈی۔ تمِس اوس تمنعؔ ناو۔ تمِس نِش زاو تس عمالیقؔ۔ یتھ کنؠ ٲسؠ عیسوؔ سنٛزِ آشنہِ عدہؔ ہس یِم شےٚ زُرؠ۔
\v 13 رعوایلؔ سنٛدؠ نیٚچی ٲسؠ یِم: نحتؔ، زارح، سمہؔ تہٕ مِزہؔ۔ یم ٲسؠ عیسوؔ سنٛزِ آشنہِ بشامہؔ ہنٛدؠ زُرؠ۔
\v 14 عیسوؔ سنٛزِ آشنہِ اُہلیبامہؔ یۅسہ عناہہِؔ ہنٛز کور تہٕ صبعونؔ ہنٛز زُر ٲس زاے ترےٚ لڑکہٕ۔ یعوسؔ یعلامؔ تہٕ قورحؔ۔
\v 15 یم ٲسؠ عیسوؔ سنٛدیو اولادو منٛزٕ سردار۔ تمسنٛدس زیٹِھس نیٚچو الیفزؔ سنٛدیو اولادو منٛزٕ ٲسؠ سردار تیمانؔ، اومرؔ، صفوؔ، قنزؔ،
\v 16 قورحؔ، جعتامؔ تہٕ عمالیقؔ ونڈٕ۔ یم ٲسؠ تِم سردار یم الیفزؔ سنٛدیو تمو اولادو منٛزٕ ٲسؠ عدومؔ روزان ٲسؠ۔ یم ٲسؠ عدہؔ ہنٛدؠ زُرؠ۔
\v 17 عیسوؔ سنٛدِس نیٚچو رعوایلؔ سنٛدِس شُرؠ ٲسؠ نحتؔ، زارح، سمہؔ، تہٕ مِزہؔ قبیلن ہنٛدؠ جد و اجداد۔ سُہ اوس عیسوؔ سنٛزِ آشنہِ بشامہؔ سُنٛد اولاد۔ یِم عدومؔ ملکس منٛز روزان ٲسؠ۔
\v 18 عیسوؔ سنٛزِ آشنہِ اُہلیبامہؔ سنٛدؠ اولاد یہنٛز موج عناہؔ ٲس ٲسؠ: یعوسؔ، یعلامؔ تہٕ قورحؔ قبیلٕکؠ جد و اجداد۔
\p
\v 19 یہ اوس عیسو سنٛدین اولادن تہٕ تِمن لوٗکن ہُنٛد فہرست یِم تِہنٛدؠ اولاد ٲسؠ۔
\p
\v 20 یہ فہرست چُھ شعیرؔ سنٛدین اولادن ہُنٛد، یمن حوریؔ قبیلہٕ کیٚن لوٗکن سٟتؠ تعلق اوس۔ عدومؔ علاقس منٛز گوٚڈنکیٚن بسکیٖن دار لوٗکن ہنٛز جماتھ۔ یِم ٲسؠ لوطانؔ، سوبلؔ، صبعونؔ، عناہؔ،
\v 21 دِیسونؔ، ایصرؔ تہٕ دیسانؔ۔ یِم ستتھ نفر بنیاے ستَن قبیلن ہنٛدؠ جد و اجداد۔ پرٮ۪تھ کنہِ قبیلس رود سُہ ناو یُس تہنٛدِس جدَس اوس۔
\v 22 حوریؔ تہٕ ہیمامؔ ٲسؠ لوطانؔ سنٛدؠ نیٚچوؠ۔ لوطانؔ سنٛزِ بیٚنہِ اوس تمنعؔ ناو۔
\v 23 علوانؔ مانحتؔ، عیبال، سفو، تہٕ اونامؔ ٲسؠ سوبلؔ سنٛدؠ نیٚچوؠ۔
\v 24 آیہؔ تہٕ عناہؔ ٲسؠ صبعونؔ سنٛدؠ نیٚچوؠ۔ یہ چُھ سُے عناہؔ یمِس صحراوس منٛز پننِس مٲلؠ صبعونؔ سنٛدؠ خر رچھنَس دوران تتہِ آبٕکؠ ناگ اتھِ آیاے۔
\v 25 عناہؔ ہس ٲسؠ زٕ بچہٕ، اکھ لڑکہٕ دِیسونؔ تہٕ بیٚیہِ کور اُہلیبامہؔ۔
\v 26 دِیسونؔ سنٛدؠ لڑکہٕ ٲسؠ حمدانؔ، اشبانؔ، یترانؔ، تہٕ کِرانؔ۔
\v 27 بِلہانؔ، زعوانؔ، تہٕ عقان ٲسؠ ایصرؔ سنٛدؠ اولاد۔
\v 28 عُوص تہٕ ارانؔ ٲسؠ دیسانؔ سنٛدؠ۔
\v 29 یِم لوٗکھ حوریؔ سنٛدیو اولادو منٛزٕ ٲسؠ تِم ٲسؠ شعیرؔ ملکس منٛز بسان۔ تِہنٛدین ونڈن ہنٛدؠ ناو ٲسؠ یِم: لوطانؔ، سوبلؔ، صبعونؔ، عناہؔ،
\v 30 دِیسونؔ، ایصرؔ تہٕ دیسانؔ۔
\p
\v 31 یِم چھِ تِمن بادشاہن ہنٛدؠ ناو یمو عدومؔ ملکَس پٮ۪ٹھ حکومت کٔر، ییٚلہ نہٕ وُنہ کٲنٛسہِ بادشاہن اسرائیلس پٮ۪ٹھ حکومت کٔرمٕژ ٲس۔
\v 32 بعورؔ سُنٛد نیٚچو بالعؔ بنیاو عدومؔ ہُک گۅڈنیُک بادشاہ۔ یتھ شہرس منٛز سُہ روزان اوس تتھ اوس دِنہابہؔ ناو۔
\v 33 ییٚلہِ بالعؔ گُزریٚو تہٕ زارحؔ سُنٛد نیٚچو یوبابؔ بنیاو بادشاہ۔ یہُنٛد تعلُق بصراہؔ شہرس سٟتؠ اوس۔
\v 34 ییٚلہِ یوبابؔ گُزریاو تہٕ حُشیمؔ بنیاو بادشاہ۔ یُس تمہِ علاقُک روزن وول اوس یتہِ تیمانؠ لوٗکھ روزان ٲسؠ۔
\v 35 ییٚلہ حُشیم گُزریو تہٕ بدِد سُنٛد نیٚچو ہددؔ بنیاو بادشاہ۔ حُشیم سنٛدؠ فوجن کوٚر موآبؔ علاقس منٛز مِدیانیَن ہنٛدِس فوجس سٟتؠ مقابلہٕ تہٕ دِتُکھ تِمن شِکس۔ یتھ شہرس منٛز حُشیمؔ روزان اوس سُہ اوس عوِیتؔ۔
\v 36 ییٚلہِ ہددؔ گُزریو تہٕ مُسرقہٕ ہُک روزن وول شملہؔ بنیاو بادشاہ
\v 37 ییٚلہِ شملہؔ گُزریو تہٕ ساوُل بنیاو بادشاہ۔ سُہ اوس دریاے فراتس پٮ۪ٹھ آباد رحوبوتؔ جایہ روزان۔
\v 38 ییٚلہِ ساوُل گُزریو تہٕ عکبورؔ سُنٛد نیٚچو بعلحنانؔ بنیاو بادشاہ۔
\v 39 ییٚلہِ عکبورؔ سُنٛد نیٚچو بعلحنانؔ گُزریاو تہٕ حدرؔ بنیاو بادشاہ۔ یتھ شہرس منٛز سُہ روزان اوس تتھ ٲسؠ پاو ونان۔ تمؠ سنٛزِ گرٕواجنہِ اوس مہتابیلؔ ناو۔ سۅ ٲس میضاہابؔ سنٛزِ کورِ مِطردؔ سنٛز کور۔
\p
\v 40‏-43 یتِتھ چھِ تِمن سارنی قبیلن ہنٛدؠ ناو یمہٕ عیسوؔ سنٛدیو اولادو منٛزٕ ٲسؠ: تِمنعؔ، علوہؔ، یتیتؔ، اُہلیبامہؔ، اَیلہؔ، فِینونؔ، قنزؔ، تیمانؔ، مِبصارؔ، مجدایلؔ تہٕ عرامؔ۔ یِم سٲری ٲسؠ عدوم چہِ سرِزمینہِ منٛز روزان۔ یتھ زمینہِ پٮ۪ٹھ یُس قبیلہٕ روزان اوس تتھ زمین ٲس تِمے قبیلہٕ کہ ناوٕ زاننہٕ یوان۔
\c 37
\p
\v 1 یعقوبؔ لوٚگ کنعانچہِؔ سرِ زمینہِ پیٚٹھےٕ بسنہِ، یتہِ تمسُنٛد مول گۅڈٕ بسان اوس۔
\v 2 یعقوبؔنِس خاندانس سٟتؠ سپُد یتھ کنؠ۔ ییٚلہِ تمسُنٛد نیٚچو یوسفؔ سداہ وہُر ووت تہٕ سُہ دراو پننٮ۪ن کینٛژن زِٹھیٚن باین سٟتؠ تیٖر تہٕ ژھاولؠ رچھنہِ۔ تِم ٲسؠ تمسنٛدِس مٲلؠ سنٛزن لونڈین، بِلہاؔ تہٕ زلفہؔ ہنٛدؠ نیٚچو۔ یوسفنؔ وُن پننِس مٲلِس تِمن بُرٕ کامیٚن متلق یمہٕ تمسنٛدؠ بٲے کران ٲسؠ۔
\p
\v 3 یعقوبؔ اوس پننیٚو شُریٚو منٛزٕ یوسفَس سٟتؠ زیادٕ محبت ورتاوان تکیازِ یوسفؔ اوس تمہ وزِ زامُت ییٚلہ یعقوبؔ بُجرس منٛز اوس۔ یعقوبنؔ بناوٕنو یوسفسؔ خٲطرٕ نٔرؠ دار اکھ خوبصورت پۅشاک۔
\v 4 ییٚلہِ یوسفؔ سنٛدیو بڈیٚو بایو زون زِ سون مول چُھ اسہِ ساروےٕ منٛزٕ أمِس زیادٕ پیار کران تہٕ تِم لٔگؠ تمِس سٟتؠ نفرت کرنہِ۔ تِم ٲسؠ نہٕ تس سٟتؠ سیٚود کتھ کران۔
\v 5 اکہِ رٲژ وُچھ یوسفنؔ خاب۔ تہٕ تمؠ وُن پنُن سُہ خاب پننٮ۪ن باین، یمہِ کِنؠ تِم تمِس سٟتؠ زیادے نفرت کرنہِ لٔگؠ۔ یہ کینٛژھا سپُد تہِ چُھ یِتھ پٲٹھؠ:
\v 6 تمؠ وُن تِمن، "میٚون خاب بوزیٚو!
\v 7 خابس منٛز ٲسؠ أسؠ کٕنکہٕ گیٚجہِ گنٛڈان۔ میانؠ گیٚڈ گییہِ اچانک کھڑا، تُہنٛزٕ گیٚجہِ گییہِ میانہِ گیٚجہِ انٛدؠ انٛدؠ جمع تہٕ کۅرُکھ تتھ برُنٛہہ کنہِ سٔجدٕ۔
\v 8 تمسنٛدیو بایو وُن تمِس، "ژٕ ما چُھکھ زانان زِ کُنہِ دوٚہہ کرکھ ژٕ اسہِ پٮ۪ٹھ حکومت؟ ژٕ چُھکھا سون بادشاہ بنُن یژھان؟" تمہٕ لگؠ تمِس سٟتؠ پرانہِ کھۅتہٕ زیادٕ نفرت کرنہٕ تکیازِ تمؠ وُن تِمن پننِس خابس متعلق۔
\v 9 پتہٕ وُچھ تٔمؠ بیاکھ خاب تہٕ سُہ خاب تہِ بوو تٔمؠ پننٮ۪ن زِٹھیٚن باین۔ تمؠ وُن: یہ بوزیٚو، "مےٚ وُچھ بیٚیہِ اکھ خاب۔ اتھ خابس منٛز وُچھ مےٚ آفتاب، زون تہٕ بیٚیہِ کاہ تارک پانس سجدٕ کران۔
\v 10 تمؠ وُن پننِس مٲلِس تہِ اتھ متعلق۔ تمسنٛدؠ مٲلؠ سٕدرٕ سُہ تہٕ وُننَس ژٕ کیاہ چُھکھ اتھ خابس تعبیر کڑان؟ ژےٚ چُھیا باسان زِ امہِ خابُک مطلب چُھ زِ چٲنؠ موج، بہٕ تہٕ چٲنؠ بٔڈؠ بٲے جُکن زمینہِ پٮ۪ٹھ اکہِ دوٚہہ ژےٚ برونٛہہ کنہِ؟
\v 11 یوسفؔ سنٛدیو بڈیٚو بایو کوٚر تس سٟتؠ ناراضگی ہُنٛد اظہار۔ مگر تمسُنٛد مول اوس سونچان زِ اتھ خابس کیاہ ہیٚکہِ تعبیر ٲسِتھ۔
\v 12 اکہِ دوٚہہ گو یوسف سُنٛد بوٚڈ بوے پننِس مٲلؠ سںنٛدین تیٖرن تہٕ ژھاولیٚن نظر گُذر دنہٕ خٲطرٕ یم سِکمسؔ نکھٕ کھہَس منٛز ٲسؠ۔
\v 13 کینٛژِ کٲلؠ پتہٕ وُن یعقوبنؔ یوسفَسؔ، "چٲنؠ بٲے چھِ سِکمَسؔ نِش تیٖر تہٕ ژھاولؠ رچھنہِ۔ بہٕ چُھس یژھان ژٕ گژھکھ تور تِمن سمکھنہٕ خٲطرٕ۔ "یوسفنؔ ونُس، "آ بہٕ گژھٕ۔"
\v 14 یعقوبنؔ ونُس، "گژھِ تہٕ وُچھ زِ تم چھا ٹھیکھےٕ تہٕ جب چھا ٹھیک پٲٹھی رچھان۔ تورٕ یِتھ وَن مےٚ پوٗرٕ تفصیل۔ "یتھ کنؠ سوز یعقوبنؔ یوسفؔ تمہِ وادی پٮ۪ٹھٕ یتہِ تِم روزان ٲسؠ، یہ وادی ٲس حبرون جایہ، پننٮ۪ن باین ژھانڈنہِ۔ پتہٕ ووت یوسفؔ سِکم شہرس نزدیک۔
\v 15 ییٚلہِ سُہ پننٮ۪ن باین ژھانٛڈان ژھانٛڈان کھہَن پھیران اوس تہٕ اکؠ نفرن وُچھ سُہ تہٕ تٔمؠ پرُژھس، ژٕ کُس چھہَن ژھانٛڈان؟
\v 16 یوسفنؔ ونُس یورٕ، "بہٕ چُھسکھ پنٕنؠ بٔڈؠ بٲے ژھانٛڈان۔ توٚہؠ ہیٚکوا مےٚ ؤنِتھ زِ تِم کتِتھ آسن پننٮ۪ن تیٖرن تہٕ ژھاولیٚن رچھان؟
\v 17 تٔمؠ نفرن دِتُس جواب، "تمہٕ چِھیی نہٕ وُنؠ یتہِ۔ بہٕ اوسُس بوزان تِمو منٛزٕ اوس اکھ ونان، "ؤلیٚو أسؠ گژھو تیر تہٕ ژھاولؠ ہیٚتھ دوتینؔ شہر کُن۔ "لہٰذا دراو یوسفؔ اتہِ تہٕ گو شمالس کُن، تہٕ وُچِھن پنٕنؠ زٹھؠ بٲے دوتینؔ شہرس نکھٕ۔
\v 18 مگر تِمن گو سُہ دوٗرے نظرِ یِتھےٕ تِمو سُہ وُچھ تمو کٔر سُہ قتل کرنٕچ سٲزِش۔
\v 19 تِم لٔگؠ اکھ اکِس وننہِ زِ یہ چُھ خاب وچُھن وول۔
\v 20 "ؤلیٚو، أسؠ ماروون یہ تہٕ لاش ژھنہٕ وون دۅبس۔ پتہٕ ونو لوٗکن زِ سُہ روٚٹ أکؠ جنٛگلی جانورن، مورُن تہٕ کھیوٗن۔ تہٕ پتہٕ لگہ اسہِ پانے پےَ زِ امسنٛدؠ خاب کتھٕ کنؠ گژھن پوٗرٕ!"
\v 21 رُوبِنؔ بوز زِ یِم کیاہ چھِ یہ ونان، اوٕ کِنؠ کٔر تٔمؠ تِم سمجھاونٕچ کوشش زِ یوسفؔ کروون نہٕ قتل۔ تمؠ وُن تِمن، "نہ، اسہِ پزِ نہٕ یہ قتل کرُن۔
\v 22 زُوو کڑووس نہٕ! أسؠ تراوون یہ صحراوس منٛز یتھ چہَس، مگر اسہِ پزِ نہٕ أمِس کانٛہہ نقصان واتناوُن۔ "رُوبِننؔ وُن یہ تٲوِن تِم أتی، غرض اوسس یوسفؔ بچاوُن تہٕ پتہٕ سُہ پننِس مٲلِس نش واتناوُن۔
\v 23 یُتھےٕ یوسفؔ تتھ جایہ ووت یتِتھ تمسنٛدؠ بٔڈؠ بٲے بہِتھ ٲسؠ، تِمو روٚٹ سُہ تہٕ ژھنؠ ہَس گۅڈ زیٹھؠ نرؠ دار پلو ژٔٹِتھ۔
\v 24 پتہٕ روٚٹُکھ تہٕ ژھنُکھ چہَس۔ یہ چاہ اوس ہوٚکھمُت، اتھ اوس نہٕ آبےٕ
\v 25 ییٚلہِ تِم کھیٚن کھیٚنہِ بیٹھؠ تِمن پییہِ نظر، دوٗرِ اوس اکھ قٲفلہٕ پکان یُس اسماعیلؔ سنٛدین اولادن ہُنٛد جِلعادؔ علاقہٕ پٮ۪ٹھٕ یوان اوس۔ تہنٛدین اونٹن پٮ۪ٹھ آسہٕ مسالہٕ بوٚہرِ تہٕ مُشکہٕ دار رال بٔرِتھ۔ تِم ٲسؠ مِصر علاقس کُن تِم چیز کننہٕ باپتھ گژھان۔
\v 26 یہُوداؔ ہن وُن پننٮ۪ن زِٹھیٚن تہٕ کانٛسیٚن باین، "اگر أسؠ پنُن لۅکُٹ بوے ماروون تہٕ امسنٛز لاش دباوون، اسہِ کیاہ فٲیدٕ نیرِ؟
\v 27 لہٰذا کرو أسؠ کٲم أمِس نقصان واتناونہٕ بجایہ ژھنوون یہ یِمن نفرن کنِتھ یِم اسماعیلؔ سنٛدیو اولادو منٛزٕ چھِ۔ یمہٕ مٔشرٲیو زِ سُہ چُھ سون لۅکُٹ بوے!" لہٰذا سَپدؠ تِم اتھ کتھِ پٮ۪ٹھ سٲرے رٲضؠ۔
\v 28 ییٚلہ مدیانٕکؠ تِم تٲجِر نکھٕ وٲتؠ تہٕ یوسفؔ سنٛدیو بایو کھول سُہ چہہٕ منٛزٕ واپس۔ پتہٕ کُن تِمو سُہ مِدیان کیٚن نفرن چاندِ ہنٛدیٚن وُہَن سِکن۔ تِمو تٲجرو نیٚو یوسفؔ پانس سٟتؠ مِصر۔
\v 29 ییٚلہِ رُوبِنؔ واپس پھیرتھ چہَس نِشہ آو تہٕ اتہِ وچُھن نہٕ پنُن لۅکُٹ بوے یوسفؔ کُنی۔ تمِس پیٚو تیٚوت غم زِ تمؠ ژٔٹؠ پانس پلو۔
\v 30 سُہ گو پننٮ۪ن لۅکٹٮ۪ن باین نِشہ واپس تہٕ وُننکھ، "لڑکہٕ چُھیی نہٕ چہَس منٛز! بہٕ کیاہ زن کرٕ وُنؠ؟"
\v 31 تِمن ٲس نہٕ ہمتھےٕ مٲلِس یہ وننٕچ زِ تِمو کیاہ کیاہ کوٚر۔ لہٰذا نیٚو تِمو اتھ متعلِق اکھ دلیل بناونُک فٲصلہٕ۔ تِمو لوٚب یوسفؔ سُنٛد سُہ کۅرتہٕ یتھ زیٹھؠ نٔرؠ ٲسؠ۔ پتہٕ کوٚر تِمو اکھ ژھاوج زبح تہٕ تمسنٛدِس خوٗنس منٛز بُڈوکھ سۅ کُرتٕنؠ۔
\v 32 تمو نیٚو سُہ کۅرتہٕ پننِس مٲلِس نِش تہٕ وُنہَس، "یہ وُچھ، اسہِ لوٚب یہ۔ یہ چُھنا چٲنِس نیٚچوؠ سُنٛد کۅرتہٕ؟"
\v 33 تٔمؠ پرزٕنوو سُہ تہٕ ونُن، "آ، یہ چُھ میانِس نیٚچوؠ سُنٛد۔ کانٛسہِ وحشی جانورن آسہ سُہ حملہٕ کرِتھ مورمُت! مےٚ چُھ یقین زِ تمؠ جانورن آسن یوسفسؔ ٹُکرٕ کٔرمٕتؠ!"
\p
\v 34 یعقوبؔس پیٚو آسمان پٮ۪ٹھ، تمؠ ژٔٹؠ پانس پلو۔ تمؠ وول پانس ٹاٹھ تہٕ ہیٚوتُن ماتم۔
\v 35 تمسنٛدؠ سٲری شُرؠ آے تمِس دِلاسہٕ دنہِ۔ مگر تمؠ دیُت نہٕ تِمن کُن توجُہ۔ تمؠ وُن، "نہ، بہٕ کرٕ تۅتام ماتم یۅتام بہٕ مرٕ تہٕ پننِس نیٚچوِس نِش واتہٕ۔ "مگر یوسفؔ سُنٛد مول رود تتھ پٮ۪ٹھ ہیٚتھےٕ ودان یہ تسنٛدس نیٚچوِس سٟتؠ پیش آو۔
\p
\v 36 اتھ دوران واتنوو مِدیان کیٚو نفرو یوسفؔ مِصر۔ تتہِ نیوکھ فوطیفارسؔ نِشہ یُس بادشاہ سنٛدیو افسرو منٛزٕ اکھ اوس۔ سُہ اوس تِمن سِپہَن ہُنٛد سردار یِم بادشاہ سنٛدؠ محٲفِظ ٲسؠ۔
\c 38
\p
\v 1 تٔتھؠ وقتس منٛز دراو یہُوداؔ پنٕنؠ زٹھؠ تہٕ کانٛسؠ بٲے ترٲوِتھ پہٲڑی علاقہٕ منٛزٕ بوٚن وسِتھ تہٕ گو اکِس نفرس نِش یُس عدلامَس منٛز روزان اوس۔ تمِس اوس حِیرہؔ ناو
\v 2 تتہِ گو یہُوداہسؔ اکِس زنہِ سٟتؠ ملاقات یہ ٲس کنعان کِس اکِس شخصہٕ سنٛز کور یمِس سُوعؔ ناو اوس۔ تمؠ کوٚر تمِس سٟتؠ خاندر تہٕ شونٛگ تس نِشہ۔
\v 3 سۅ روز بیٚیہِ زُووٕ تہٕ پتہٕ زاس اکھ لڑکہٕ۔ تمسنٛدؠ مٲلؠ تھوو تمِس عیرؔ ناو۔
\v 4 پتہٕ روز سۅ بیٚیہِ گۅبہ کھوٚر تہٕ دِتُن بیٚیہِ اکِس لڑکس زایُن۔ یمِس تمؠ اونانؔ ناو تھوو۔
\v 5 واریاہ وری گٔژھِتھ ییٚلہ یہُوداؔ تہٕ تمسُنٛد خاندان کزیبؔ روزنہٕ خٲطرٕ گے تہٕ یہُوداؔ سنٛزِ خاندارنہِ زاو بیاکھ لڑکہٕ تہِ تہٕ تمِس تھووُکھ سیلہؔ ناو۔
\v 6 ییٚلہِ یہُوداؔ سُنٛد زیُٹھ نیٚچو عیرؔ بوٚڈ سپُد تہٕ یہوداہؔن أنؠ تمِس خٲطرٕ اکھ گرٕواجِنؠ یمِس تمرؔ ناو اوس۔
\v 7 مگر عیرنؔ کٔر تِژھ اکھ کٲما یۅسہ خداوند یہُوواہسؔ سیٹھاہ ناگوار گییہِ یمہِ کِنؠ یہُوواہنؔ تس زُوےٕ کٔڑتھ نیٚو۔
\v 8 پتہٕ وُن یہُوداہَن اونانَسؔ، "چون زیُٹھ بوے مود لاولد۔ تمؠ سنٛزِ مونٛڈِ زنانہِ سٟتؠ خاندر کرِتھ کر ژٕ تمِس سٟتؠ ہم بستری۔ سٲنؠ رسم ریواج چھِ ونان زِ اسہِ پزِ یی کرُن۔
\v 9 مگر اونان اوس زانان زِ اگر بہٕ یہ کرٕ تہٕ یمہٕ تہِ شُرؠ اسہِ زیٚن تِم ین نہٕ میانؠ زاننہٕ۔ لہٰذا ییٚلہ تہٕ سُہ پننِس بٲے سنٛزِ بیوہ سٟتؠ صحبت کران اوس سُہ اوس شہوت نیٚبر تراوان یُتھنہٕ سۅ بیٚیہِ زُووٕ روزِ تہٕ میانِس بٔڈس بٲے سنٛدِ ناوٕ شُرؠ زیٚنس۔
\v 10 تمؠ سُنٛد یہ کرُن آو نہٕ خداوند یہُوواہسؔ خوش لہٰذا نیٚو تمِس تہِ یہُوواہنؔ زوو کٔڈتھ۔
\v 11 پتہٕ وُن یہُوداؔ ہن پننہِ نۅشہِ تمرسؔ، "گژھِ پننِس مٲلِس نِش واپس مگر بیٚیہِ کانٛسہِ سٟتؠ کٔرزیٚنہٕ خاندر۔ ییٚلہِ میٚون لۅکُٹ نیٚچو سیلہؔ بوٚڈ گژھِ تہٕ سُہ ہیٚکہ ژےٚ سٟتؠ خاندر کرِتھ۔ مگر یہُوداؔ اوس نہٕ انٛدرؠ یژھان زِ سیلؔہ گٔژھ تس سٟتؠ خاندر کرنؠ، تکیازِ تمِس اوس خوف زِ پتہٕ گوٚژھ نہٕ سیلؔہ تہِ مرِتھ گژھُن، یتھ کنؠ تمسنٛدؠ بٔڈؠ بٲے مودؠ۔ مگر تمرؔ مٲنؠ یہُوداؔ سنٛز کتھ تہٕ سۅ گییہِ پننِس مٲلؠ سنٛدِ گرِ روزنہٕ باپتھ واپس۔
\v 12 کینٛژِ وہرؠ پتہٕ گذرییہِ یہُوداؔ سنٛز گرٕواجنؠ یۅسہ سُوعؔ سنٛز کور ٲس۔ ییٚلہِ تمسنٛدِ تعزیتُک وقت انٛد ووت تہٕ یہوداہَنؔ کوٚر تِمنتچہِؔ تتھ جایہِ گژھنُک فٲصلہٕ یتہِ تمسنٛدؠ نفر تمسنٛدیٚن تیٖرن نیتان ٲسؠ۔ عدلامُک تمسُنٛد دوس حِیرہؔ گو تمِس سٟتؠ۔
\v 13 تمرسؔ وُن کمؠ تام، "چون ہیرٕبب دراو تِمن نفرن مدد کرنہِ یم تِمنت جایہ تمسنٛدؠ تیٖر نیٚتان چھِ۔"
\v 14 تمہِ زون زِ سیلہؔ آسہ وُنؠ بالیغ سپدمُت، مگر یہُوداہنؔ دِژ نہٕ تس سۅ تمؠ سنٛز خاندارنؠ بننہٕ خٲطرٕ۔ اوٕ کِنؠ ژھنؠ تمہِ پنٕنؠ مونٛڈٕ پلو کڈِتھ تہٕ درایہ بُرقہٕ لٲگتھ یُتھ نہٕ کانٛہہ پرزٕنٲوتھ ہیٚکیٚس۔ پتہٕ روز سۅ عینیمؔ دروازس پٮ۪ٹھ یُس تِمنت گژھن واجنہِ وتہِ منٛز اوس۔
\v 15 ییٚلہِ یہُوداؔ دراو تہٕ اتہِ پییَس أمِس پٮ۪ٹھ نظر، تمؠ سونچ زِ یہ آسہ کانٛہہ گٲنؠ توے چُھس کلہٕ ؤلِتھ تھومُت۔ یتھ کنؠ اکثر اتِتھ بہان چھےٚ۔
\v 16 یہُوواہسؔ اوس نہٕ معلوم زِ یہ چھےٚ تس سنٛز نۅش۔ تہٕ تمؠ وُن تس، "مےٚ دِ پانس نِشہ شونٛگنہٕ۔ تمہِ دتُس جواب، "ژٕ کیاہ دِکھ مےٚ تتھ بدلہٕ؟
\v 17 تمؠ ونُس، "بہٕ دِمے ژےٚ پننہِ ژھاولؠ کھیٚلہِ منٛزٕ اصل ژھاولؠ بچہ۔ "تمہِ پرِژھُس، "یۅتام بہٕ چانؠ ژھاوج رٹن تۅتام تھاوکھٕ ژٕ مےٚ نِش کینٛہہ گِرو؟"
\v 18 تہٕ دِتُس جواب، "ژٕ کیاہ چھیٚکھ یژھان بہٕ گوٚژھسے ژےٚ دیُن؟ تمہِ ونُس تورٕ، "ژٕ دِ مےٚ سۅ وٲج یتھ پٮ۪ٹھ چون ناو کھنِتھ چُھ یۅسہ ژےٚ پنَس گنٛڈِتھ نٲلؠ چھےَ، بیٚیہِ دِم یہ لور یۅسہ ژےٚ اتھس کیٚتھ چھےَ۔ "تمؠ تُلؠ تہٕ دِتنَس۔ پتہٕ شونٛگ سُہ تمِس نِش تہٕ سۅ روز گۅبہ کھۅر۔
\v 19 اتہِ نیرتھ وول تمہِ نقاب بوٚن تہٕ لٲگِن بیٚیہِ پنٕنؠ مونٛڈٕ پلو۔
\v 20 یہوداہَنؔ دِژ عدلامؔ کِس دوستس اتھِ ژھاوجہِ بچہ تاکہِ سُہ نیٚیہ تس زنہِ تہٕ انہِ تمِس نِش چیز واپس یہ تٔمؠ لفظ کوٚر۔ مگر تمسنٛدِس دوستس آیہ نہٕ سۅ زٔنؠ اتھی۔
\v 21 تمؠ دوستن پرُوژھ تتہِ روزن والیٚن نفرن، "سۅ گٲنؠ کوٚت گییہِ یۅسہ عینیمؔ سڑکہِ دنٛدِس پٮ۪ٹھ بہِتھ ٲس۔ "تِمو ونُس تورٕ، "یتہِ چھنہٕ زانٛہہ کانٛہہ طوٲیف ٲسمٕژ!
\v 22 پتہٕ گو سُہ واپس یہُوداہسؔ نِشہ تہٕ وُننَس، "سۅ گٲنؠ لٔج نہٕ مےٚ اتھی۔ اکھتُے وُن تتہِ کیٚو روزن والیٚو زِ یتہِ چھنہٕ زانٛہہ کانٛہہ طوٲیف ٲسمٕژ۔
\v 23 یہوداہَن ونُس، "تھٲوِن سۅ تِم چیز پانسےٕ یِم مےٚ تس دِتؠ۔ اگر أسؠ سۅ ژھانڈوون لوٗکھ ژٹن اسہِ ٹٲنہٕ۔ مےٚ سوز پنٕنؠ کِنؠ تَس یہ ژھاولؠ بچہ مگر سۅ لجےٕ نہٕ ژےٚ اتھی یُتھ ژٕ تس یہ دِہکھ۔
\v 24 لگ بگ ترییہِ ریٚتؠ وُن کٔمؠ تام یہوداہَسؔ، "چٲنؠ نۅش چھےٚ گٲنؠ، تہٕ سۅ چھےٚ بیٚیہِ زُووٕ" یہوداہَنؔ وُن، "سۅ کٔڑوون شہرٕ منٛزٕ کھکھرِ تہٕ زٲلِتھ مٲرؠ وون۔
\v 25 مگر یتُھےٕ تس تِم شہرٕ نیٚبر کڑان ٲسی تہٕ تمؠ دِژ کستام اتھ وٲج تہٕ لورتہٕ وُننَس یہ نہِ یہوداہَسؔ تہٕ تمس ون، "یُس نفر یمن چیزن ہُنٛد مٲلک چُھ سُے چُھ سُہ یمؠ بہٕ بیٚیہِ زُووٕ تھٲوس۔ "تمہِ وُن یتہِ تس وننہٕ باپتھ، "یہ وٲج چُھن، تہٕ أمِچ یہ ڈوٗر تہِ، تہٕ یہ ڈکھونٕچ لور تہِ وچُھن یہ کہنٛز چھےٚ؟"
\v 26 ییٚلہِ امؠ نفرن یہ کوٚر تہٕ یہوداہَنؔ پرزٕنٲو وٲج تہِ تہٕ لوٗر تہِ۔ تمؠ وُن، سۅ چھےٚ پزرس پٮ۪ٹھ تہٕ بہٕ چُھس غلط تکیازِ مےٚ وُن نہٕ پننِس نیٚچوِس سیلہؔ ہس تمِس سٟتؠ خاندر کرنہٕ باپتھ، یہ زن مےٚ کرنُک تس سٟتؠ وعدہ اوس کوٚمُت۔ "تہٕ پتہٕ گو نہٕ یہُوداؔ زانٛہہ تس نزدیک۔
\v 27 ییٚلہ تس خلٲصی ہُنٛد موقہٕ ووت، سۅ سپٕز حٲران ییٚلہ تمہِ زون زِ تس سنٛزِ یڈ منٛز چھِ زٕ بچہ۔
\v 28 ییٚلہ تِم زیٚوان ٲسؠ تہٕ تِمو منٛزٕ کوٚڈ أکؠ پنُن اتھٕ نیٚبر تہٕ دایہ گونٛڈ تمِسنٛدس ۂژِس ۅزُل پن تہٕ ونُن، "یہ زاو گۅڈٕ۔"
\v 29 مگر تمؠ نیٚو پنُن اتھٕ بیٚیہِ اندر واپس تہٕ اورٕ دراو بیاکھ بچہٕ یہ اوس لڑکہٕ۔ تہٕ تمہِ وُن، "گو نا ژےٚ کٔڈتھ پانے پنٕنؠ وَتھ۔ "اوِ کِنؠ تھوو تمہِ تس فارصؔ ناو۔ یمیُک معنی عِبرٲنؠ زبانہِ منٛز "وَتھ کڈٕنؠ" چُھ۔
\v 30 تہٕ پتہٕ زاو بیاکھ لڑکہٕ یمِس تمہِ ۅزُل پن گنٛجاو تہٕ تمِس آو زارحؔ ناو تھاونہٕ۔ یتھ عبرانؠ زبانہِ منٛز معنی چُھ "صبحٕچ سُرخی"
\c 39
\p
\v 1 اتھ دوارن واتنوو اسماعیلؔ سنٛدیو اولادو یوسفؔ مِصر۔ تتہِ ہیٚوت فوطیفارنؔ یوسف تِمن نِشہ موٚلؠ۔ فوطیفارؔ اوس مِصرٕ کِس بادشاہ سنٛدیو اہلکارو منٛزٕ اکھ تہٕ سُہ اوس بادشاہ سنٛدِ محلہٕ خانہ کیٚن رٲچھ درن ہُنٛد زیُٹھ۔
\v 2 یہُوواہؔ ہن کوٚر یوسفسؔ مدد یمہِ کِنؠ سُہ پنٕنؠ کٲم بہتر پٲٹھؠ انجام دنَس قٲبل سپُد۔ سُہ رود پننِس مِصری مٲلکس نِش کٲم کران
\v 3 تمسنٛدؠ مٲلکن ژیون زِ خداوند یہُوواہؔ چُھ یوسفسؔ مدٕتس تہٕ تمِس چُھ پرٮ۪تھ کُنہ کامہِ منٛز کامیٲبی عطا کران۔
\v 4 یوسفنؔ مٲلک سپُد تس پٮ۪ٹھ، یمہِ کِنؠ تمؠ سُہ پنُن ذٲتی خٲدم مقرر کوٚر۔ پتہٕ بنوو تمؠ سُہ پننہِ گرُک تہٕ پرٮ۪تھ کُنہِ چیزُک رٲچھ در تہٕ کوٚرنس سورےٕ کینٛہہ حوالہٕ۔
\v 5 ییٚتہِ پٮ۪ٹھ فوطیفارنؔ یوسفؔس پننہٕ گرٕکہ پرٮ۪تھ کُنہ چیزٕچ تہٕ ملکیتٕچ رٲچھ راوٕٹ مٹہِ تھٲو، تتہِ پٮ۪ٹھٕ کٔر یہُوواہنؔ یوسفنہِؔ برکتہٕ فوطیفارؔ سنٛدِس گرس منٛز روزان وٲلِس پرٮ۪تھ اکِس نفرس برکت عطا۔ یہ بنیاو فوطیفار سُنٛد فصل ٹھیک پٲٹھؠ ۅپدنُک تہِ بٲعث۔
\v 6 فوطیفارنؔ پُشرٲو یوسفسؔ پرٮ۪تھ کُنہِ چیزٕچ ذمہٕ دٲری یہ تمسنٛدِس ملکِیتس منٛز اوس۔ فوطیفارسؔ اوس صرِف پننہِ کھیٚن چیٚنُک مشورے یوت ونُن پیوان۔ تمِس ٲس نہٕ پننہِ ملکِیتکہِ کُنہِ چیزٕچ فِکر۔
\p وۅنؠ اوس یوسفؔ سیٹھاہ خوبصورت تہٕ حسین۔
\v 7 یمہِ کِنؠ کینٛہہ کال گٔژھتھ تمسنٛدِس مٲلکہٕ سنٛز گرٕ واجِنؠ یوسفسؔ محبت کرنہِ لٔج۔ تہٕ اکہِ دوٚہہ وُن تمہِ تمِس، "مےٚ نِش شونٛگ!"
\v 8 مگر انکار کٔرِتھ وُن تٔمؠ تمِس، "بوز! میانِس مٲلکس چھیٚنہٕ یمہِ گرٕکہِ کُنتہِ چیزٕچ فِکر۔ تٔمؠ چھےٚ مےٚ پرٮ۪تھ کُنہ چیزٕچ رٲچھ راوٕٹ مٹہ تھٲومٕژ یُس تمسنٛدس ملکِیتس منٛز یوان چُھ۔
\v 9 یتھ گرس منٛز چھنہٕ کٲنسہِ تہِ کُنہ چیزس پٮ۪ٹھ میانؠ یٲتؠ اختِیارت۔ صرف نہٕ اکھ چیز یتھ پٮ۪ٹھ نہٕ تِمو مےٚ اختیار دیُتمُت چُھ سۅ چھیٚکھ ژٕ، تکیازِ ژٕ چھیٚکھ تس خاندارِنؠ! تہٕ بہٕ کِتھ کنؠ ہیٚکہٕ یژھ بُرٕ کٲم کرِتھ یۅسہ ژٕ مےٚ ونان چھیٚکھ؟ اگر بہٕ یہ کرٕ تہٕ بہٕ خدایس برُونٛہہ کنہِ گناہ گار ثٲبت!"
\v 10 سۅ ٲس پرٮ۪تھ دوٚہہ یوسفسؔ ونان زِ ۅلہٕ مےٚ نِش شونٛگ۔ مگر سُہ اوس نہٕ مانان سُہ اوس نہٕ تس نزدیک تہِ گژھان۔
\v 11 اکہٕ دوٚہہ اوس یوسفؔ پننِس گرس منٛز کٲم کران تہٕ گرس منٛز اوس نہٕ باقیو نوکرو منٛزٕ کانٛہہ موجود۔
\v 12 فوطیفارؔ سنٛزِ خاندارنہِ ژٔھنؠ یوسفسؔ پلون تھف تہٕ وُننس ۅلہٕ مےٚ نِش شونٛگ۔ یوسف ژوٚل مگر ہُمِس ٲس پلون تھف تہٕ پلو رود تَس اتھس کیٚتھےٕ!
\v 13 ییٚلہ تٔمہِ وُچھ زِ ژلنہٕ وزِ چھےٚ تمؠ سنٛز قمیض میانسےٕ اتھس کیٚتھ روزمٕژ۔
\v 14 تمؠ أنؠ گرِکؠ نوکر بلٲوِتھ۔ تٔمؠ وُن تِمن، "وچُھو! یہ عِبرٲنؠ نفر یُس میانؠ خاندارن یور اوٚنمُت چُھ، چُھ مےٚ سٟتؠ زیادتی کران! سُہ آو یور یتہِ بہٕ ٲسٕس تہٕ اوس زبردستی مےٚ پانس نِشہ ساونٕچ کوشش کران، مگر مےٚ تُل شور۔
\v 15 یتھےٕ تمؠ میٚون شور بوز، تمؠ ترٲو پنٕنؠ قمیض أتی تہٕ ژوٚل نیٚبر۔
\v 16 یۅتام نہٕ تمسُنٛد خاندار تہٕ یوسفُنؔ آغہٕ گرٕ ووت تۅتام تھٲوؠ تٔمؠ پلو پانسےٕ نِش۔
\v 17 پتہٕ ؤنؠ تٔمؠ تس یہ دلیل: "سُہ عِبرٲنؠ غلام یُس ژےٚ گرِ تھومُت چُھتھن آو تورؠ یتہِ بہٕ ٲسٕس تہٕ کٔرن زبردستی مےٚ نِش شونٛگنٕچ کوشِش۔
\v 18 ییٚلہِ مےٚ شورٕ شر تُل تہٕ تمؠ ترٲوؠ پنٕنؠ پلو أتی تہٕ ژوٚل نیٚبر!"
\v 19 ییٚلہ یوسفنؔؠ مٲلکن یہ دلیل بوز یۅسہ تمؠ سنٛزِ زنانہِ تس ؤنؠ زِ چٲنؠ غلامن کوٚر مےٚ سٟتؠ یِتھٕ کنؠ تہٕ تس کھۅت سخٕت شرارتھ۔
\v 20 یوسفنؔؠ مٲلکن نیٚو یوسفؔ تہٕ بُرن قٲد خانس یتہِ بادشاہ سنٛدؠ باقی قٲدؠ ٲسؠ تہٕ رود یوسفؔ تٔتؠ۔
\v 21 مگر خداوند یہُوواہؔ اوس یوسفسؔ رٲضؠ تہٕ تمسنٛدین جدٕ اجدادن سٟتؠ وعدہ مطٲبق کوٚرُن تس مدد۔ یوسؔفنہِ ورتاوٕ سٟتؠ گو داروغہِ زندان تس پٮ۪ٹھ سیٹھاہ خوش۔
\v 22 امہِ کِنؠ پُشرٲو قٲد خانٕکؠ داروغن یوسفَسؔ تِمن سارنی قٲدین ہنٛز ذمہٕ دٲری یمہٕ قٲدخانس منٛز ٲسؠ تہٕ قٲدخانس منٛز سپدن واجنیٚن کامیٚن ہنٛز تہِ۔
\v 23 داروغہَس روز نہٕ پتہٕ تِمن کامیٚن ہنٛز کانٛہہ فِکر یمہٕ یوسفَس مٹہِ آسہٕ تکیازِ یہُوواہؔ اوس یوسفَس تمہٕ سارے کامہِ بہتر پٲٹھؠ انجام دنس منٛز مدد کران۔
\c 40
\p
\v 1 کینٛہہ کال گٔژھِتھ کرٕ مِصرٕ کِس بادشاہ سنٛدیو دویٚو حٲکمو تژھٕ کامہِ یمو کِنؠ سُہ ناراض سپُد۔ اکھ اوس تمسُنٛد زیُٹھ ہیٚوٗ مےَ فروش تہٕ بیاکھ اوس تمسُنٛد ژوٚٹ بناون وول۔
\v 2 بادشاہ گو تِمن دوٚنونؠ افسرن نارٲضؠ۔
\v 3 اوٕ کِنؠ کٔرؠ تٔمؠ تِمہٕ محل خانہٕ کیٚن رٲچھ درن ہنٛدِس سردار سنٛدِس گرَس منٛز قٲد۔ یہ ٲس سۅ جاے یتہِ یوسفؔ تہِ تھاونہٕ آمُت اوس۔
\v 4 تِم دۅشوے نفر ٲسؠ واریہس کالس قٲدخانس منٛز۔ اتھ دوران تھٲو محل خانہٕ کیٚن رٲچھ درن ہنٛدؠ سردارن یوسفَسؔ ذمہٕ دٲری تِہنٛدِ خٲطرٕ ضروٗرتٕکؠ چیز اننٕچ۔
\v 5 اکہِ رٲژ وُچھ مِصرٕکؠ بادشاہ سنٛدؠ مےَ چیاون وٲلؠ تہٕ ژۅٹ بناون وٲلؠ اکھ اکھ خاب۔ پرٛتھ کُنہِ خابس اوس الگ الگ مطلب۔
\v 6 بیٚکہِ دوٚہہ صبحٲے ییٚلہ یوسفؔ تِمن نِش آو تہٕ وچُھن زِ تِم دۅشوے ٲسؠ مایوس۔
\v 7 تٔمؠ پرُژھ تِمن، "توٚہؠ کیازِ چُھو از ییتؠ مایوس باسان؟
\v 8 تِمو منٛزٕ ونُس أکؠ، "راتھ راتس وُچھ اسہِ دوٚنویو خاب، مگر ۅ چُھنہٕ کانٛہہ یُس اسہِ یمن خابن ہُنٛد تعبیر ونہِ ہے۔ یوسفَنؔ وُن تِمن، "خابن ہُنٛد تعبیر چُھ صرف خدا زانان۔ توٚہؠ ؤنیٚو مےٚ توٚہہ کیاہ خاب وُچھو، خدا ونہِ مےٚ تمیُک تعبیر۔"
\v 9 بادشاہس مےَ چاوَن وٲلؠ وُن یوسفَس پنُن خاب۔ تمؠ وُن، "مےٚ وُچھ پننِس خابس منٛز دچھِ رانٛٹھ۔
\v 10 دچھِ رٲنٛتھ ٲسؠ ترےٚ شاخ۔ یمن شاخن آو بہار، پتہٕ درایکھ پُھلے، تہٕ پتہٕ دراے تِمن دچھِ گۅرن۔
\v 11 مےٚ اتھِ اوس بادشاہ سُنٛد پیالہ، لہٰذا تُلؠ مےٚ پٔپؠ دچھِ گۅرن تہٕ کوٚڈمکھ رس۔ پتہٕ دیُت مےٚ بادشاہس چیٚنہٕ خٲطرٕ یہ جوس پیالہٕ۔"
\v 12 خداین وُن یکدم یوسفَس امہِ خابُک تعبیر۔ اوٕ کِنؠ وُن یوسفنؔ تمِس، "چانہِ خابُک تعبیر چُھ یہ زِ دچھِ کُجہ ہنٛدؠ ترےٚ شاخ چھِ ترےٚ دوٚہہ ظٲہر کران۔
\v 13 تریٚن دوٚہُن منٛز کٔری ژےٚ بادشاہ قٲدٕ منٛزٕ رِہا۔ سُہ تھٲوی ژےٚ بیٚیہِ تتھ کامہِ پٮ۪ٹھ یۅسہ ژٕ کران اوسُکھ۔ ژٕ گژھکھ بادشاہس نِش شرابٕکؠ پیالہٕ ہیٚتھ یتھ کنؠ ژٕ برُونٛہہ گژھان اوسُکھ ییٚلہ ژٕ تمسُنٛد ساقی اوسُکھ۔
\v 14 ییٚلہ ژٕ قٲد خانہٕ منٛزٕ رہا گژھکھ چٲنؠ سٲری ماملات گژھن ٹھیک، مگر مہربٲنی کٔرؠ زِ مےٚ مٔشرٲے زیٚنہٕ۔
\v 15 بہٕ اوٚنہَس لوٗکو سٲزِش کرِتھ تمہٕ ملکہٕ منٛزٕ کٔڈتھ یتہِ میانؠ عِبرٲنؠ سٲتھی روزان چھِ۔ مےٚ چھنہٕ تتہِ کانٛہہ غلط کٲم کٔرمٕژ تہٕ مِصرس منٛز روزِتھ تہِ چھنہٕ مےٚ کانٛہہ تِژھ کٲم کٔرمٕژ یمہِ کنؠ بہٕ قٲدس منٛز بنٛد تھاونُک مستحق اوسُس۔ لہٰذا کٔرؠ زِ مےٚ پٮ۪ٹھ مہربٲنی بادشاہس ونؠ زِ مےٚ متعلق تاکہِ سُہ کرِ مےٚ یمہِ قٲدٕ منٛزٕ رہا۔
\v 16 ییٚلہِ زِٹھؠ کانٛدرن بوز زِ بادشاہس مےَ چیاون وٲلِس سردار سنٛدِس خابس دراو رُت تعبیر تہٕ تمؠ تہِ وُن یوسفَسؔ، "میٚتہِ وُچھ اکھ خاب تہٕ خابس منٛز پننِس کلس پٮ۪ٹھ ترےٚ ژۅچہِ ٹوکرِ وُچِھتھ گوس بہٕ حٲران۔
\v 17 پٮ۪ٹھٕ کنچہِ ٹوکرِ منٛز ٲسؠ بادشاہس باپتھ پکٲیتھ واریاہ چیز۔ مگر میانہٕ کلہٕ پٮیٚٹھچہِ دویمہِ ٹوکرِ منٛزکؠ جاناوار ٲسؠ تِمن کھیٚوان
\v 18 خداین وُن یوسفَس بیٚیہِ زِ یامہِ خابُک تعبیر کیاہ چُھ تہٕ تمؠ وُن، "تریٚن ٹوکریٚن ہُنٛد اشارٕ تہِ چُھ تریٚن دوٚہُن کُن۔
\v 19 یعنی تریٚن منٛز دییہِ بادشاہ حکم چون سر قلم کرنُک۔ پتہٕ ییہِ چٲنؠ لاش کُلِس الانٛژ تراونہٕ تہٕ گریٚدیِن تہٕ کھیٚن چون ماز دِگو سٟتؠ۔
\p
\v 20 امہِ پتہٕ ترییہِ دوٚہؠ ٲس اوس بادشاہ سُنٛد زا دوٚہہ۔ امہِ دوٚہہ دِژ بادشاہن پننیٚن تمام عہدٕدارن پنُن زا دوٚہہ مناونٕچ دعوت۔ اتھ جشنَس دوران ییٚلہِ تتہِ سٲری جمع سپدؠ بادشاہن اننٲوؠ جیلہٕ منٛزٕ پنٕنؠ مےَ چیاوَن وول سردار تہٕ ژوٚٹ بناون وول سردار۔
\v 21 تمؠ وُن زِ یمِس مےَ چیاون وٲلِس سردارس ییہِ پنٕنؠ پرٲنؠ کٲم بیٚیہِ تفویز کرنہٕ۔ یتھ کنؠ لوگ تمؠ بیٚیہِ پیالن منٛز بادشاہس برُونٛہہ کُن مےَ نیٚون۔
\v 22 مگر تمؠ دیُت حکم زِ ژوٚٹ بناون وول کانٛدر گژھِ پھَہہِ دِتھ مارنہٕ یُن، یتھ کنؠ زن یوسفنؔ خابن تعبیر وننہٕ وزِ ونمُت اوس زِ کیاہ سپدِ۔
\v 23 مگر مےَ چیاون وٲلؠ سونٛچی نہٕ یوسفَسؔ متعلق۔ اکھتُے گو تس تتہِ مشتھےٕ یہ کرنُک تس یوسفَن ونمُت اوس۔
\c 41
\p
\v 1 برابر دویہ ؤہرؠ وُچھ مِصرٕکؠ بادشاہن اکھ خاب۔ خابس منٛز اوس سُہ نیٖل درؠ یاوٕ کِس بٔٹھِس پٮ۪ٹھ کھڑا۔
\v 2 اچانک گییہِ ستتھ پَھربہہ گاوٕ ظٲہر۔ تمہٕ لجہِ درؠ یاوٕ بٔٹھؠ بٔٹھؠ گاسہٕ کھیٚنہِ۔
\v 3 أتھؠ دوران کھژٕ نیٖل درؠ یاوٕ منٛزٕ بیٚیہِ ستتھ گٲو یمہٕ سیٹھاہ بدصورت تہٕ لاگر آسہٕ تہٕ لجہِ ہُمن گٲون پتہٕ پتہٕ پکنہِ۔ تمہٕ آسہ نیٖل درؠ یاوٕ بٔٹھس پٮ۪ٹھ پَھربہہ گٲون سٟتؠ ۅدنہِ۔
\v 4 پتہٕ لاجہِ یمو بیمار تہٕ لاگر گٲوو ہُمہٕ ستتھ پَھربہہ گاوٕ کھیٚنہِ۔ تہٕ أتھؠ سٟتؠ گو بادشاہ ہُشار۔
\v 5 پتہٕ پییہِ بادشاہس بیٚیہِ نینٛدر تہٕ وچُھن بیاکھ خاب۔ امہِ وزِ وُچھ تٔمؠ اکسےٕ کُلِس پٮ۪ٹھ ستتھ بجہ تہٕ پٔھلؠ دار وچہِ یمہٕ پۅختہٕ آسہٕ گمژٕ۔
\v 6 امہِ پتہٕ وُچھ بادشاہن أتھؠ کُلِس پٮ۪ٹھ بیٚیہِ ستتھ وچہِ یمہٕ سیٹھاہ نِچہٕ تہٕ مشرقہ کہِ ہوا سٟتؠ ہوٚچھمَژٕ آسہٕ۔
\v 7 پتہٕ نیٚیہ یمو سَتو ہوٚچھمَژو وَچو ہُمہ ستتھ پوٚختہٕ وچہٕ کھیٚتھ تہٕ أتھؠ سٟتؠ گو بادشاہ ہُشار۔ تس گو احساس زِ تمؠ وُچھ خاب۔
\v 8 مگر صبحٲے ؤتِھتھ پیٚو سُہ خابکہٕ تعبیرٕ باپتھ فکرِ منٛز۔ اوٕ موٚکھٕ أنؠ تمؠ مِصرس منٛز روزن وٲلؠ تمام جٲدؠ گر تہٕ گاٹٕلؠ انسان سونٛبراوِتھ۔ تمؠ وُن تِمن زِ مےٚ کیاہ وُچھ خابس منٛز۔ مگر تِمو منٛزٕ ہیٚوک نہٕ کانٛسہ أکؠ تہِ تمِس یمن دوٚن خابن ہُنٛد تعبیر ؤنِتھ
\v 9 پتہٕ وُن مےَ چیاون وٲلؠ سردارن بادشاہس، "مےٚ پیٚو وُنؠ تہِ یاد یہ مےٚ توٚہہِ ونُن پزِہے۔ توٚہہِ ونُن مٔشرٲوِتھ کٔر مےٚ بٔڈ غلطی۔
\v 10 اکہِ دوٚہہ ٲسیٚو توٚہؠ اسہِ دوٚن نفرن ناراض۔ یمہِ کِنؠ توٚہہ بہٕ تہٕ ژوٚٹ بناون والیٚن ہُنٛد سردار محل خانہٕ کِس محافظن ہنٛدس سردار سنٛدِ گرِ قٲدؠ تھٲیو۔
\v 11 ییٚلہِ أسؠ تتہِ ٲسؠ تہٕ اکہِ رٲژ وُچھ اسہِ دونوٕیو خاب تہٕ خابن ٲسؠ بیٚون بیٚون تعبیر۔
\v 12 تتہِ اوس اسہِ سٟتؠ اکھ عِبرٲنؠ نوجوان۔ سُہ اوس تمہِ محلہٕ کِس کپتانَس نوکر۔ اسہِ وُن تمسےٕ زِ اسہِ کیاہ خاب وُچھ، تہٕ تمؠ وُن اسہِ تِمن ہُنٛد تعبیر۔ اسہِ دوٚنونؠ وُن تمؠ پن پننہِ خابُک تعبیر۔
\v 13 تمہِ پتہٕ یہ سپُد تہِ اوس بلکُل تی یہ تمؠ اسہِ ونمُت اوس: تہِ گو توٚہہِ وُنو مےٚ پننہِ پرانہِ نوکری پٮ۪ٹھ قٲیم روزُن تہٕ دویم نفر آو پھٲسؠ دِتھ مارنہٕ۔"
\v 14 بادشاہن یتُھے یہ بوز تمؠ وُن پننٮ۪ن نوکرن زِ یوسفؔ أنوون مےٚ نِش تہٕ تِم گے تہٕ انُکھ یوسفؔ جلدےٕ قٲد خانہ منٛزٕ کٔڈِتھ۔ یوسفَن کوٚر شیوا پیوا تہٕ جان پلو لٲگِتھ گو بادشاہس برُونٛہہ کنہِ کھڑا۔
\v 15 بادشاہن وُن یوسفسؔ، "مےٚ وُچھ زٕ خاب تہٕ یمن ہُنٛد تعبیر چُھنہٕ مےٚ کانٛہہ ؤنِتھ ہیٚکان۔ مگر مےٚ وُن کمؠ تانؠ زِ اگر کٲنٛسہِ خاب وُچھمُت آسہ تہٕ ژےٚ چُھے سُہ ونان تمؠ کیاہ وُچھ خابس منٛز تہٕ ژٕ چُھکھ تس تمہِ خابُک تعبیر ؤنِتھ ہیٚکان۔
\v 16 مگر یوسفَنؔ وُن بادشاہس یورٕ، "نہ، بہٕ ہیٚکہ نہٕ تہِ کرِتھ۔ خابن ہُنٛد تعبیر چُھ صرف خدا زٲنِتھ ہیٚکان، مگر سُہ ہیٚکہِ مےٚ چانیٚن خابن تعبیر وننَس قٲبل بنٲوِتھ، تہٕ تِمن ہُنٛد تعبیر آسہ رُتےٕ۔"
\v 17 بادشاہن وُن یوسفَسؔ، "مےٚ وُچھ پننِس گۅڈنکِس خابس منٛز، بہٕ اوسُس نیٖل دٔرؠ یاو بٔٹھِس پٮ۪ٹھ کھڑا۔
\v 18 نیٖل درؠ یاوٕ منٛزٕ کھژٕ اچانک ستتھ مۅچہِ پھربہہ گاوٕ تہٕ لجہِ درؠ یاوٕ بٔٹھِس گاسہٕ کھیٚنہِ۔
\v 19 سٟتی کھژٕ یمن پتے درؠ یاوٕ منٛزٕ بیٚیہِ ستتھ گاوٕ یمہٕ بد صوٗرت تہٕ ہوٚچھمژٕ آسہٕ۔ مےٚ چھنہٕ سٲرسےٕ مِصرس منٛز تژھٕ بد صۅرت گاوٕ زانٛہہ تہِ وُچھمژٕ!
\v 20 تِمو ہوٚچھمژو تہٕ بد صوٗرت گٲوو کھییہِ ہُمہٕ ستتھ پَھربہہ تہٕ موٚچہِ گٲو یمہٕ گۅڈٕ آیہ۔
\v 21 مگر پتہٕ آسہ نہٕ کٲنٛسہِ باسیٚومُت زِ یمو ہوٚچھمژو گٲوو کیاہ کھییہِ تِمہ تکیازِ تمہٕ آسہٕ تِژھے لیٚژٕ تہٕ بدصورت۔ پتہٕ گوس بہٕ ہُشار۔
\v 22 پتہٕ وُچھ مےٚ بیاکھ خواب تہِ۔ مےٚ وُچھِ مکایہ ہنٛزٕ ستتھ وچہِ۔ تِم آسہٕ پۅختہٕ تہٕ پھلیٚو سٟتؠ بٔرتھ۔ تمہٕ سارے آسہٕ أکسےٕ ٹٲنٛڈس آمژٕ۔
\v 23 پتہٕ گوس بہٕ یہ وُچِھتھ حٲران زِ اتھ ٹٲنٛڈِس آیہ بیٚیہِ ستتھ وَچہِ تمہٕ آسہٕ نِچہٕ تہٕ ہردٕ واون ہوٚچھرایہ مژٕ۔
\v 24 یمو ہوٚچھمژو وچو کھییہِ ہُمہٕ اصلہِ بجہٕ تہٕ پوٚختہٕ وچہِ۔ مےٚ وُن یہ خواب واریہن تنجیم دانن مگر تمو منٛزٕ ہیٚوک نہٕ مےٚ کانٛسہ ؤنِتھ امیُک تعبیر کیاہ چُھ۔
\v 25 پتہٕ وُن یوسفنؔ بادشاہس، "یمن دوٚنونؠ خابن ہُنٛد تعبیر چُھ کُنےٕ۔ خدا چُھ چانیٚن خابن منٛز ژےٚ ژینہٕ ون دیُن یژھان زِ سُہ کیاہ چُھ چےٚ سٟتؠ کرُن یژھان۔
\v 26 ستتھ پھربہہ گٲوٕ چھےٚ سَتن ورؠ ین نشٲنی۔ اناجچہِ ستتھ پوٚختہٕ وچہِ تہِ چھےٚ سَتن ورؠ ین ہنٛز نشٲنی ظٲہر کران۔ دوٚنونؠ خابن ہُنٛد تعبیر چُھ اکےُ۔
\v 27 تہٕ یم ستتھ لاغر، بدصورت گٲوٕ تِمن پتہٕ پتہٕ آیہِ تہٕ ہردٕ واون ہوچھرایہ مژٕ اناجچہِ ستتھ وچہِ چھےٚ ستن ورؠ ین ہنٛدِ دراگٕچ باوتھ کران۔
\v 28 یہ مےٚ توٚہہِ وُنمو یی سپدِ۔ تکیازِ خداین دیُت توٚہہِ امیُک اشارٕ زِ سُہ کیاہ چُھ کرن وول۔
\v 29 ستتھ وری آسن تِم ییٚلہِ مِصرس منٛز کھیٚن خۅردنی وفور آسہ۔
\v 30 پتہٕ ین دراگٕکؠ ستتھ وری۔ لوٗکن گژھِ مٔشتھےٕ زِ زانٛہہ کٲلؠ ما اوس یتہِ سۅکال تہِ۔ تکیازِ یُس دراگ پتہٕ وُتھہِ سُہ کرِ مِصر ملکس بُرباد۔
\v 31 پتہٕ روزِ نہٕ لوٗکن یادےٕ زِ پتھ کالہِ کوتاہ اناج اوس، تیوٗت آسہ سخت ترین دراگ۔
\v 32 خدایس چُھ توٚہہ دوٚن خابن منٛز یہ ہاونُک مقصد یہ زِ تمؠ چُھ یہ مکمل پٲٹھؠ یہ اِرادٕ کوٚرمُت زِ یہ سپدِ تہٕ سُہ دییہِ یہ سیٹھاہ جلد انجام۔
\p
\v 33 وُنؠ چُھسو بہٕ توٚہہِ مشورٕ دِوان زِ توٚہؠ ژھانٛڈؠ تون کانٛہہ عقل منٛد انسان یُس اصل فٲصلہٕ نِتھ ہیٚکہِ۔ میٚون مشورٕ چُھ زِ توٚہؠ کٔرؠ وون سُہ مِصرٕکؠ ملکی معاملات طےَ کرنہٕ باپتھ مقرر۔
\v 34 توٚہہِ پزِ ملکہٕ باپتھ اکھ نگران تہِ مقرر کرُن تاکہِ سُہ کرِ ستن ورؠ ین دوران تمہِ سارے مِصرٕکہ ملکُک اناجُک پانٛژِم حصہٕ جمع کرنُک بندوبس یُس یتہِ زیادٕ ۅپدان چُھ۔
\v 35 سُہ کرِ ینہٕ والیٚن ستن ورؠ ین دوران کھیٚن چیٚنُک یہ مقدار جمع، ییٚلہِ زن وُپھور اناج آسہ۔ پرٮ۪تھ کانٛہہ شہری گژھِ جمع سپدیمتہِ ذخیرٕچ رٲچھ راوٕٹ تہٕ حفاظت کرُن۔
\v 36 یہ اناج گژھِ جمع روزُن تاکہِ تِمن ستن ورؠ ین ییہِ استعمال کرنہٕ ییٚلہ یتہِ مِصرس منٛز دراگ وُتھِ، یُتھ نہٕ یتِکؠ لوٗکھ بۅچھِ سٟتؠ مرن۔
\v 37 بادشاہن تہٕ تمسنٛدیو وزیرو سونچ زِ یہ چُھ اکھ اصل منصوبہ۔
\v 38 بادشاہن وُن تِمن، "کیاہ اسہِ ہیٚکیا یوسفَسؔ کھۅتہٕ بیٚیہِ کانٛہہ نفر میلِتھ، یس خداین روحٲنی طاقت عطا کوٚرمُت چُھ؟
\v 39 بادشاہ وُتھ پتہٕ یوسفَسؔ کُن، "چونکہِ خداین چُھ یہ سورےٕ ژےٚ پٮ۪ٹھ ظٲہر کوٚرمُت، مےٚ چُھ باسان زِ ژےٚ کھۅتہٕ عقلمند چُھنہٕ کانٛہہ یُس یمن چیزن متعلق حکمتہٕ سان فٲصلہٕ ہیٚکہِ نِتھ۔
\v 40 لہٰذا بناوتھ بہٕ ژٕ پننہِ محلہٕ خانکہِ پرٛتھ کُنہِ چیزُک نِگران۔ یتہِ پزِ مِصرٕ کیٚن تمام لوٗکن چانہِ حکمٕچ تعمیل کرٕنؠ۔ مےٚ روزِ صرف اوِ موٚکھٕ چانہِ کھۅتہٕ زیادٕ اختیار تکیازِ بہٕ چُھس بادشاہ۔
\v 41 پتہٕ وُن بادشاہن یوسفَس، "وُنؠ چُھستھ بہٕ ژٕ سارے مِصر ملکُک نگران بناوان۔
\v 42 بادشاہن کٔڈ پننہِ اوٚنگجہِ منٛزٕ سۅ وٲج یتھ پٮ۪ٹھ تمؠ سنٛز مُہر ٲس تہٕ لٲجن سۅ یوسفنہِؔ اوٚنگجہِ۔ تمؠ لٲگؠ تس بٲریک کِتٲنؠ پلو تہٕ تمِس ترٲون سۅنہٕ سنٛز اکھ چین نٲلؠ۔
\v 43 تہٕ پتہٕ کرنووُن یوسفنہِؔ سوارِ باپتھ اکھ رتھ تیار یمہِ سٟتؠ ننان اوس زِ یوسفؔ چُھ مِصر ملکُک دویِم اہم انسان۔ ییٚلہِ یوسفؔ رتھس پٮ۪ٹھ سوار سپُد تہٕ نفرو وُن تِمن لوٗکن یمہٕ تس برُونٛہہ کنہِ وتہِ پٮ۪ٹھ ٲسؠ "نٔمیٚو بوٚن!" تکیازِ یوسف دراو سٲرؠ سےٕ مِصرس منٛز امہِ کامہِ ہنٛز نگرٲنی کرنہٕ باپتھ۔
\v 44 بادشاہن وُن یوسفَسؔ، "بہٕ چُھس بادشاہ، مگر سٲرسےٕ مِصر ملکَس منٛز ہیٚکہِ نہٕ تۅتام کانٛہہ تہِ کینٛہہ کٔرِتھ یۅتام نہٕ تُہنٛد اجازت آسہ۔"
\v 45 بادشاہن کوٚر یوسفَس نوُو ناو صِفنات فعنیحؔ تہٕ تٔمؠ دِژ تس فوطفیرعؔ سنٛز کور آسِناتھؔ نیتٔرؠ یۅسہ اونؔ شہرٕکہِ اکہِ مندرچ کاہن ٲس۔ یتھٕ پٲٹھؠ سپُد یوسفؔ سٲرؠ سےٕ مِصر ملکس منٛز معروف۔
\p
\v 46 یوسفؔ اوس امہِ وزِ ترہہ 30 وہُر ییٚلہِ تمؠ مِصرٕ کِس بادشاہ سنٛدِ خٲطرٕ کٲم شروع کرٕنؠ ہیٚژ۔ پنٕنؠ کٲم کرنہٕ خٲطرٕ دراو سُہ بادشاہ سنٛدِ محلہٕ منٛزٕ تہٕ کرُن سٲرسےٕ ملکَس چکر۔
\v 47 ینہٕ والیٚن ستن ورؠ ین دوران دراو زمینَس واریاہ زیادٕ فصل یمہِ کنؠ اتہِ واریاہ خوراک اوس۔
\v 48 ییٚلہِ یوسفؔ أمِچ نگرٲنی کران اوس تہٕ تمسنٛدیو مدد گارو کوٚر یمن وری ین منٛز تمام مِصرٕکہ اناجُک پانٛژِم حصہٕ سومبرٲوِتھ شہرن منٛز جمع۔ پرٛتھ کنہِ شہرس منٛز کرنوو تمؠ پننٮ۪ن مدد گارن اتھِ سُہ اناج جمع یُس تمہِ شہرٕ کیٚن انٛدؠ پٔکؠ کھہَن منٛز ۅپدان اوس۔
\v 49 یوسفَن کرنوو تِمن اتھِ واریاہ گلہٕ جمع۔ یہ اوس سمندر بٹھیٚن پٮ۪ٹھ موجود سیٚکہِ ہنٛدؠ پٲٹھؠ وفور۔ یوت اوس گلہٕ زِ کینٛہہ کال گٔژھتھ تروو تِمو امیُک حسابےٕ تھاوُن زِ کوت غلہٕ آو جمع کرنہٕ، تکیازِ یہ غلہٕ اوس تہنٛزِ پیمٲیشہٕ کھۅتہٕ زیادٕ۔
\v 50 دراگٕکؠ ستتھ وری شروع گژھنہٕ برُونٛہہ دیُت یوسفنہِؔ خاندارنہِ کاہن آسِناتھؔ دون بچن زایُن۔
\v 51 یوسفنؔ تھوو زٹھِس بچس منسیؔ ناو، یتھ زن عِبرٲنؠ زبٲنؠ منٛز "مٔشِتھ گژھن" مطلب چُھ۔ تِمو وُن زِ خداین مٔشراوِ مےٚ سارے پریشانیہ تہٕ بیٚیہِ مٔشرونم مٲلؠ سُنٛد قبیلہٕ تہِ۔ \f + \fr 41‏:51 \ft مشتھ گژھنُک وجہہ\f*
\v 52 تمؠ تھوو پننِس دوٚیمِس نیٚچوِس افرائیمؔ ناو یمیُک مطلب "بچہ پٲدٕ کرنؠ" چُھ۔ تکیازِ تمؠ وُن زِ خداین دِتؠ مےٚ یتھ ملکَس منٛز اولاد یتہِ مےٚ مصیبت تُلؠ۔"
\v 53 ٲخر وٲتؠ مِصرس تِم ستتھ وری انٛد یمن منٛز وفور خۅراک اوس۔
\v 54 پتہٕ گے قحطکؠ ستتھ وری شُروع یتھ کٔنؠ زن گۅڈے یوسفؔ سنٛز پیشن گویی ٲس۔ انٛدؠ پٔکؠ کیٚن باقی تمام کھہَن منٛز تہِ گو نہ بوٚن شروع۔ اگر نہٕ فصٕل ۅپدیاو تہِ مگر مِصرس منٛز اوس پرٮ۪تھ جایہ غلہٕ موجود، تکیازِ تِمو اوس شہرن منٛز اناج جمع تھوومُت۔
\v 55 ییٚلہِ مِصرٕ کیٚو ساروےٕ لوٗکو پنُن راشن کھیٚتھ مۅکلوو تہٕ پتہٕ رودؠ توتہِ بۅچھِ ۂتی تہٕ تمو لٲج بادشاہس عرضے کرٕنؠ۔ پتہٕ وُن بادشاہن مِصرٕ کیٚن تمام لوٗکن، "یوسفسؔ نِشہ گٔژھیٚو تہٕ یہ سُہ ونیٚو تہٕ کٔریٚو۔"
\v 56 ییٚلہِ سٲرسےٕ ملکس منٛز دراگ وُتھ تہٕ یوسفنؔ دیُت پننٮ۪ن مدد گارن گودام یلہٕ تراونُک حکم تہٕ پتہٕ دیُت تِمو گُدامن منٛز موجود اناج مِصرٕ کیٚن لوٗکن تکیازِ وُنؠ اوس سٲرسےٕ مِصرس منٛز سخت دراگ وُتھمُت۔
\v 57 اندؠ پٔکؠ کیٚو واریہو مُلکو پٮ۪ٹھٕ آے واریاہ لوٗکھ یوسفسؔ نِشہ اناج ہیٚنہٕ خٲطرٕ مِصر تکیازِ پرٛتھ انٛدٕ اوس ملکَس منٛز سخت دراگ۔
\c 42
\p
\v 1 یتُھےٕکٔمؠ تام یعقوبسؔ وُن زِ مِصرس منٛز چُھ اناج یُس لوٗکھ مٔلؠ ہیٚکن ہیٚتھ، تہٕ تمؠ وُن پننٮ۪ن نیٚچوٮ۪ن، "توٚہؠ کیاہ چُھو یتِتھ بہِتھ اکھ اکِس وُچھان؟ اسہِ گژھِ اناج آسُن!"
\v 2 تمؠ وُن تِمن، "مےٚ وُن کٔمؠ تام زِ مِصرس منٛز چُھ اناج کنُن۔ توٚہؠ گژھیٚو تہٕ ہیٚیوٗ پانس کیُت کینٛہہ، تاکہِ زندٕ روزنٕچ باتھ بنہِ!
\v 3 یتھٕ کنؠ دراے یوسفنؔؠ داہ زِٹھؠ بٲے اناج ہیٚنہٕ باپتھ مِصر کُن۔
\v 4 مگر یعقوبنؔ سوز نہٕ یوسفنؔ لۅکُٹ بوے بنیمِینؔ اور گژھنہٕ خٲطرٕ ۅپرن سٟتؠ تکیازِ سُہ اوس کھۅژان زِ أمِس سٟتؠ تہِ گوٚژھ نہٕ تی سپدُن یہ زن یوسفسؔ سٟتؠ سپُد۔
\v 5 کنعانؔ پٮ۪ٹھٕ دراے یعقوبنؔؠ اولاد مِصر غلہٕ ہیٚنہِ تہٕ باقےٕ لوٗکھ تہِ گےَ تکیازِ کنعانس منٛز اوس قحط وتھمُت۔
\v 6 امہِ وزِ اوس یوسفؔ مِصرُک گورنر یُس تِمن لوٗکن اناج کٕنان اوس یمہٕ مِصرٕ تہٕ باقی ملکو پٮ۪ٹھٕ اناج ہیٚنہِ یوان ٲسؠ۔ وُنؠ ییٚلہِ یوسفنؔؠ بٲے اور وٲتؠ تِمو دیُت تس برُونٛہہ کنہِ زمینہِ پٮ۪ٹھ سجدٕ۔
\v 7 یوسفنؔ پرزٕنٲوؠ وُچھان وُچھانےٕ پنٕنؠ بٲے۔ مگر تمؠ لوگ ڈیٚول زنتہٕ زانکھےٕ نہٕ۔ تمؠ وُن تِمن روبہٕ سانِ "توٚہؠ کتہِ پٮ۪ٹھٕ او؟ تمو منٛزٕ دتُس أکؠ جواب، "أسؠ آے کنعانچہِ سرِزمینہِ پٮ۪ٹھٕ کینٛہہ غلہٕ ہیٚنہٕ باپتھ۔"
\p
\v 8 یوٚدوے یوسفنؔ پنٕنؠ بٲے پرزٕنٲوؠ مگر تِمو پرزٕنوو نہٕ سُہ۔
\v 9 پتہٕ پیٚو یوسفسؔ یاد زِ کینٛہہ وری برُونٛہہ کیاہ خاب وُچھاو تمؠ تِمن متعلق۔ مگر تمؠ نیٚو پانس سٟتؠ فٲصلہٕ زِ بہٕ وننہٕ وُنہِ یمن زِ بہٕ چُھس تُہنٛد لۅکُٹ بوے۔ تمؠ وُن تِمن، "توٚہؠ چُھو جاسوٗس! توٚہؠ او یہ وُچھنہٕ خٲطرٕ زِ اگر أسؠ یمن حملہٕ کرو کیاہ أسؠ ہیٚکوا پنُن دِفاہ کٔرِتھ؟"
\v 10 تِمو منٛزٕ دیُت اکؠ جواب، "نہ جناب! أسؠ چھِ آمٕتؠ اناج ہیٚنہِ۔
\v 11 أسؠ سٲری چھِ اکسےٕ مٲلؠ سنٛدؠ اولاد۔ أسؠ چھِ ایماندار لوٗکھ، جاسوٗس چھنہٕ۔"
\v 12 تمؠ وُن تِمن، "مےٚ چُھنہٕ توٚہہ پٮ۪ٹھ بھروسہٕ! توٚہؠ چُھو صرف یہِ وچھنہٕ خٲطرٕ یور آمٕتؠ زِ اگر اسہِ پٮ۪ٹھ حملہٕ ییہِ کرنہٕ أسؠ ہیٚکوا پنُن دفاع کٔرِتھ!"
\v 13 مگر تِمو منٛزٕ دیُت أکؠ جواب، "نہ، یہِ چُھنہٕ پوٚز! اصلی چھِ أسؠ بَہہ بٲے بارٕنؠ، أکسےٕ نفرٕ سٕنٛدؠ نیٚچوؠ۔ سارِوٕے کھۅتہٕ لۅکُٹ بوے چُھ سٲنِس مٲلِس نِشہ۔ اکھ بوے چُھنہٕ وۅنؠ تِمو منٛزٕ زنٛدٕ۔"
\v 14 یوسفنؔ ونُکھ یورٕ، "توٚہؠ چُھو اپُز ونان! مےٚ چُھ باسان پوٚز چُھ تی یہ مےٚ توٚہہ وُن۔ توٚہؠ چُھو جاسوٗس!
\v 15 مگر وۅنؠ چُھ اکھ طریقہ یُتھ بہٕ زانہٕ زِ توٚہؠ چُھو پزَر ونان۔ مےٚ چُھ باسان یوتاں بادشاہ آسنُک پزر یقینی چُھ تۅتام چُھو توٚہؠ جاسوٗس۔ لہٰذا ہکیٚو نہٕ توٚہؠ تۅتام یتہِ نیرتھ یۅتام نہٕ تُہنٛد لۅکُٹ بوے یور واتہِ!
\v 16 پننہٕ جمٲژ منٛزٕ سوزؠ وون اکھ یُس تُہنٛدِس لۅکٹِس بٲیس یور واتناوِ۔ تہٕ باقی تھاوکھ بہٕ قٲد خانس منٛز بنٛد یۅتام أسؠ یہ نٔنراوو زِ توٚہؠ یہ کینٛژھا ونان چُھ تہِ چھا پوٚز کِنہٕ اپُز۔ اگر نادس گژھن وٲلؠ تُہنٛد لۅکُٹ بوے یور اوٚن نہٕ، بادشاہ سنٛدِ خٲطرٕ سپدِ ضرور یہ کتھ عیان زِ توٚہؠ چُھو اپُز ونان تہٕ توٚہؠ چُھو جاسوٗس۔
\v 17 پتہٕ بٔرؠ یوسفنؔ تمہٕ تریٚن دوہن ہنٛدِ خٲطرٕ قٲد۔
\v 18 ترییہِ دوٚہؠ پتہٕ گو یوسفؔ قٲد خانس منٛز تہٕ ونُن تِمن، "بہٕ چُھس اکھ انسان یتھ پٮ۪ٹھ یقین تھاوان زِ اگر نہٕ مےٚ تہِ کوٚر یمیُک مےٚ وعدہ کۅرمُت چُھ، خدا دییہِ مےٚ تمیُک سزا۔ لہٰذا یہ بہٕ توٚہہِ ونان چُھس تہِ کٔریو، تہٕ بہٕ بچاوٕ تُہنٛدؠ زُو۔
\v 19 اگر توٚہؠ ایماندار نفر چُھو تہٕ توٚہؠ تھٲوون پنُن اکھ بوے یتؠ قٲدس منٛز تہٕ باقی گٔژھیٚو واپس گرٕ والیٚن نِش یمہٕ دراگہٕ سببہٕ بۅچھِ ۂتؠ چھِ تہٕ نِیو تِمن کھیٚنہٕ خٲطرٕ اناج۔
\v 20 وۅنؠ اگر توٚہؠ دبارٕ یور یِیو توٚہہ گژھِ پنُن کۅکٹ بوے مےٚ نِش سٟتؠ آسُن یمہِ سٟتؠ توٚہؠ ثٲبت کٔریو زِ یہ کینٛژھا توٚہہِ ونُو تہِ چُھ پزر تہٕ نتیجہ نیرٕ یہ زِ توٚہؠ بٔچو قتل سپدنہٕ نِشہ۔ یتھ کنؠ گے تِم یہ کرنہٕ خٲطرٕ آمادٕ۔
\v 21 تِمو وُن اکھ أکِس، "پٔزؠ کِنؠ چُھ یہ اسہِ تمیُک سزا تلُن پیٚوان یہ اسہِ پننِس لۅکٹِس بٲیس سٟتؠ ورتوومُت چُھ۔ اسہِ وُچھ سُہ کوتاہ پریشان سپُد ییٚلہ سُہ اسہِ آہوزٲری کران اوس زِ مےٚ متہٕ کٔرؠ تو کینٛہہ۔ مگر اسہِ دیُت نہٕ تٔمس کُن کانٛہہ توجو تہٕ توے چُھ اسہِ یہ مصیبت تلُن پیٚوان۔"
\v 22 رُوبِنؔ وُتھ تِمن کُن، "مےٚ ونیومو نا توٚہہِ أمِس متہٕ کٔرؠ تو کینٛہہ، مگر توٚہہِ مونو نہٕ میٚون۔ وُنؠ چُھ اسہِ سُہ مارنُک قصاسہٕ پیٚوان دیُن!"
\v 23 ییٚلہِ تم یوسفسؔ سٟتؠ کتھ ٲسؠ کران تِم ٲسؠ ترجمہٕ کار سنٛدِ وساطتہٕ کتھ کران۔ مگر ۅ ییٚلہِ پانہٕ وٲنؠ کتھ ٲسؠ کران تیٚلہِ ٲسؠ پننہِ بولہِ منٛز کتھ کران۔ تِمن اوس نہٕ یہ معلوم زِ یوسفسؔ چھےٚ سٲنؠ کتھ فِکرِ تران تہٕ سُہ چُھ سمجھان یہ کینٛژھا أسؠ ونان چھِ۔
\v 24 تِہنٛزو کتھو سٟتؠ توٚر یوسفسؔ فکرِ زِ تمو کوٚر امہِ کتھِ ہُنٛد اعتراف زِ کینٛہہ وری برُونٛہہ یہ کینٛژھا تِمو مےٚ سٟتؠ ورتوومُت چُھ تہِ اوس غلط۔ سُہ اوس زٲنِتھ زِ ہیٚکہٕ نہٕ اوش رکٲوِتھ مگر یپٲرؠ اوس نہٕ یژھان زِ یم گٔژھؠ تس اوش ہاران وچھنؠ، لہٰذا ژوٚل سُہ تِمہ أتی ترٲوتھ کمرٕ منٛزٕ نیٚبر تہٕ لوٚگ وَدنہ۔ مگر پتہٕ آو دُبارٕ تِمن سٟتؠ کتھ کرنہٕ خٲطرٕ بیٚیہِ واپس۔ پتہٕ اون تٔمؠ اتہِ شمعونؔ کٔڈتھ تہٕ تِمن برونٛہہ کنہِ ونُن نوکرن یہ گنٛڈؠ وون۔ امہِ پتہٕ ترووُن قٲد خانس منٛز تہٕ باقین ونُن توٚہؠ ہکیٚو نیرتھ۔
\v 25 یوسفن وُن پننٮ۪ن نوکرن زِ یمن نفرن تھٲیو بوٚہرین منٛز راشن تہٕ سٟتی وُننکھ یتہِ زِ پرٛتھ کٲنٛسہِ یُس اناجُک رقم بوٚر سُہ تھٲیو پن پننہِ بوٚہرِ منٛز پٮ۪ٹھٕ کنہِ تہٕ بیٚیہِ وُننکھ یمن دِیو غذا تہِ سٟتؠ یُس یم وتہِ منٛز کھیٚن۔ تہٕ یوسفؔ سنٛدیو بایو روٚٹ تمسنٛدین نوکرن نِش غذا۔
\v 26 تٔمسنٛدیو بڈیو بایو برِ راشن بوٚہرِ پننٮ۪ن خرَن تہٕ دراے۔
\v 27 امہِ رٲژ یتہِ تِم شونٛگنہٕ خٲطرٕ ٹھہریاے، تِمو منٛزٕ وُتھ اکھ تہٕ مُژرٲون پننِس خرس پھل دنہٕ باپتھ اکھ بوٚہرؠ۔ بوٚہرِ منٛز پٮ۪ٹھٕ کنہِ پونٛسہٕ وُچِھتھ گو حٲران۔
\v 28 تٔمؠ وُن پننٮ۪ن باین، "مےٚ چھِ کٔمؠ تام پنٕنؠ پونٛسہٕ واپس دِتؠ مٕتؠ یکیاہ چھِ یتھ میانہِ بوٚہرِ منٛز۔ تمہِ کھوژؠ تہٕ لگؠ اکھ أکِس کُن وننہ، "یہ کیاہ دلیل کٔر خداین اسہِ سٟتؠ؟"
\v 29 ییٚلہ تِم پننِس مٲلِس یعقوبسؔ نِش کنعانؔ وٲتؠ تہٕ تِمو وُن تس تہِ سورےٕ یہ تِمن سٟتؠ سپُد۔ تِمو منٛزٕ وُن أکؠ، دلیل
\v 30 "سُہ نفر اوس اسہِ سٟتؠ روبہٕ سان کتھ کران یُس تتھ سٲرسےٕ ملکس پٮ۪ٹھ حکومت کران چُھ۔ تٔمؠ کۅر اسہِ سٟتؠ سُہ سلوٗک زنتہٕ أسؠ تمسنٛدس ملکس منٛز جاسوٗسی کران ٲسؠ۔
\v 31 مگر اسہِ وُن تمِس، أسؠ چھنہٕ جاسوٗس أسؠ چھِ ایماندار لوٗکھ۔
\v 32 اصلی ٲسؠ أسؠ أکسےٕ مٲلؠ سنٛدؠ باہ بارنؠ۔ اکھ گُذریو تہٕ ساروےٕ کھۅتہٕ لۅکُٹ بوے چُھ کنعانس منٛز پننِس مٲلِس نِش۔
\v 33 یُس شخص تمہِ ملکُک حٲکم چُھ تٔمؠ کٔر نہٕ اسہِ پٮ۪ٹھ پژھےٕ، یمہِ کِنؠ تٔمؠ اسہِ وُن، "بہٕ کرٕ تیٚلہِ پژھ زِ توٚہؠ چُھو ایماندار: پنُن اکھ بوے تھٲوون مےٚ نِش یتؠ۔ تہٕ باقی بارٕنؠ نِیو پننہِ خاندان کیٚن لوٗکن باپتھ اناج یمہٕ بۅچھِ سٟتؠ مران چھِ۔
\v 34 مگر ییٚلہِ توٚہؠ واپس یِیو تہٕ پنُن ساروےٕ کھۅتہٕ لۅکُٹ بوے أنزیون سٟتؠ یُتھ بہٕ زٲنِتھ ہیٚکہٕ زِ توٚہؠ چُھو نہٕ جاسوٗس بلکہِ پٔزؠ یٲرؠ۔ پتہٕ تراون بہٕ تُہنٛد بوے یلہٕ۔ تہٕ پتہٕ یہ کینٛژھا توٚہؠ یژِھیٚو تہِ ہکیٚو توٚہؠ یمہِ ملکہٕ منٛزٕ مٔلؠ ہیٚتھ۔
\v 35 ییٚلہِ تِمو پننہِ بوٚہرِ مُژراوِ تہٕ تِم سَپدؠ حٲران زِ پرٛتھ کُنہِ بوٚہرِ منٛز ٲسؠ پنٕنؠ پونٛسہٕ۔ ییٚلہِ تِمو تہٕ تِہنٛدؠ مٲلؠ پونٛسن ہنٛدؠ سٲری ٹھیلہٕ وُچھ تہٕ تمہٕ بانٛبریاے۔
\v 36 تِہنٛدؠ مٲلؠ یعقوبنؔ ووٚن تِمن، "توٚہہِ کٔرؠ ووکھ مےٚ نِش میانؠ زٕ اولاد چھٹہٕ۔ یوسفؔ گُذریاو، تہٕ شمعونؔ تہِ گو! تہٕ وۅنؠ چُھوا توٚہؠ بنیمِینؔ تہِ مےٚ نِش چھٹہٕ کرُن یژھان! یہ چُھس بہٕ یمِس یمن سارنی چیزن ہُنٛد مصیبت تلُن چُھ پیٚوان!"
\p
\v 37 رُوبِنؔ وُتھ پننِس مٲلِس، بہٕ انن بنیمِینؔ توٚہہِ نِش واپس۔ مےٚ کرُن سُہ ژٕ حوالہٕ۔ اگر بہٕ بنیمِینؔ توٚہہِ نِش واپس انن نہٕ تہٕ ژٕ مٲرؠ زیٚکھ میانؠ دۅشوے نیٚچوؠ۔"
\v 38 مگر یعقوبنؔ وُن، "نہ، بہٕ دمہٕ نہٕ پننِس نیٚچوِس توٚہہِ سٟتؠ گژھنہٕ۔ امسُنٛد بوٚڈ بوے گُذریو، تہٕ سُہ چُھ وۅنؠ میانہِ خاندارنہِ راخِلؔہ ہُنٛد کُنےٕ اولاد پتھ کُن! اگر توٚہہ سفرس دوران کانٛہہ آفت پیش آیہ، تہٕ توٚہؠ ژھنیٚو مےٚ ریش سفید مُہنوِس مصیبتہٕ سٟتؠ مٲرتھےٕ۔"
\c 43
\p
\v 1 کنعانسؔ منٛز رود دراگ بڈان
\v 2 وۅنؠ ییٚلہ یعقوبن تہٕ تمسنٛدؠ خانوادن سُہ سورےٕ راشن کھیٚتھ مۅکلوو یُس تِمو مِصرٕ پٮ۪ٹھٕ انیاو تہٕ یعقوبن وُن تِمن زِ مِصر گٔژھیٚو تتہِ پننہِ خٲطرٕ راشن موٚلؠ۔
\v 3 مگر یہُوداہنؔ وُن تمِس، "یمؠ شخصن اسہِ تتہِ اناج دیُت تٔمؠ چُھ اسہِ سخت روب بہنومُت زِ تۅتام یی زیٚو نہٕ دُبارٕ مےٚ نِش یۅتام نہٕ پنُن لۅکُٹ بوے سٟتؠ آسیٚو۔"
\v 4 توٚہؠ دی وون اسہِ پنُن لۅکُٹ بوے سٟتؠ، أسؠ گژھو مِصر تہٕ ہیٚمو تُہنٛدِ خٲطرٕ اناج۔
\v 5 وۅنؠ اگر نہٕ سُہ توٚہؠ سوزؠ وون تیٚلہِ گژھو نہٕ أسؠ تہِ تکیازِ تٔمؠ نفرن چُھ اسہِ ونمُت زِ اگر نہٕ توٚہؠ پنُن لۅکُٹ بوے سٟتؠ أنوون مےٚ نِش یی زیٚو نہٕ۔
\v 6 یعقوبنؔ پرُژھنکھ، "توٚہہِ کیازِ ترووُس بہٕ تس یہ ؤنِتھ تکلیفس منٛز زِ اسہِ چُھ بیاکھ لۅکُٹ بوے تہِ؟"
\v 7 تِمو منٛزٕ ونُس أکؠ، "تٔمؠ نفرن پرُژھ اسہِ پانس تہٕ پننِس خاندانس متلق۔ تٔمؠ وُن کیاہ تُہنٛد مول چھا زنٛدے؟ توٚہہِ ما چُھ بیٚیہِ کانٛہہ بوے؟" اسہِ پیٚو تمسنٛدین سوالن جواب دیُن۔ اسہِ کتہِ اوس یہ پےَ زِ سُہ ونہِ ییٚلہِ توٚہؠ دبارٕ یور یِیو پنُن لۅکُٹ بوے انؠ زون سٟتؠ۔"
\v 8 پتہٕ وُن یہوداہنؔ پننِس مٲلِس یعقوبس، یہ نیٚچو سوزُن ژٕ مےٚ سٟتؠ۔ أسؠ گژھو جلدےٕ، یُتھ زن توٚہؠ تہٕ سانؠ بچہٕ غذا حٲصل کرن یُتھنہٕ بۅچھِ دادِ مرَن۔
\v 9 بہٕ چُھسے ژےٚ ضمانت دِوان زِ سُہ ییہِ واپس۔ ژٕ ہیٚککھ مےٚ تمیُک مطالبہ کٔرتھ یمیُک بہٕ ژےٚ وعدہ چُھسے کران۔ اگر بہٕ سُہ ژےٚ نِش وارٕ کارٕ واپس انن نہٕ ژٕ ہیٚککھ مےٚ ہمیشہٕ خٲطرٕ قصوروار ٹھہرٲوِتھ
\v 10 اگر اسہِ یوت وقت ضایہ آسہ ہے نہٕ کۅرمُت، أسؠ آسہٕ ہو تنہٕ تورٕ دویمہِ پھرِ تہِ واپس آمٕتؠ۔
\v 11 پتہٕ وُن تِہنٛدؠ مٲلؠ یعقوبن تِمن، "اگر بیٚیہِ کانٛہہ وَتھ چھنہٕ تیٚلہِ کٔریو یہ زِ یمہِ ملکہٕ منٛزٕ ۅپدن وٲلؠ کینٛہہ اصل چیز بٔریو بوٚہرین تہٕ نِیو تمہِ ملکہٕ کِس تمِس شخصس تحفہٕ رنٛگؠ۔ اکھ نِیو کینٛہہ بالم، مانٛچھ، مسالہٕ، مُر، پستہٕ تہٕ بادام
\v 12 بیٚیہِ نِیو تمہِ دوگنہٕ پونٛسہٕ سٟتؠ ییتیاہ پتمہِ لٹہِ نِیو۔ تکیازِ توٚہہِ پیٚیو سۅ چٲنٛدؠ واپس کرٕنؠ یۅسہ کٔمتام تُہنٛزن بوٚہرین منٛز شاید غلطی سببہٕ تھٲومٕژ ٲس۔
\v 13 پنُن لۅکُٹ بوے ہیٚتھ گٔژھیٚو تس نفرس نِش واپس۔
\v 14 بہٕ کرو دُعا زِ قدرت وول خدا بنٲوِن تس نفرس توٚہہ پٮ۪ٹھ رحیم یُتھ سُہ تُہنٛد بوے بنیمِینؔ توٚہہِ سٟتؠ یور واپس سوزِ۔ مگر یۅتام میٚون تعلق چُھ، اگر میانؠ اولاد مےٚ نِش دور گے بہٕ سپدٕ بے اولاد۔
\v 15 لہٰذا نی یمو نفرو تمہٕ تحفہٕ یمہٕ یعققوبنؔ وُننَکھ تہٕ اناجُک دوگنہٕ قٟمت تہِ۔ تِمو نیٚو بنیمِینؔ تہِ سٟتؠ۔ تِم وٲتؠ جلدےٕ مِصر تہٕ گے یوسفسؔ نِشہ حٲضر۔
\v 16 ییٚلہِ یوسفنؔ بنیمِینؔ تِمن سٟتؠ وُچھ تہٕ تٔمؠ وُن پننِس گرٕ کِس أمِس نگرانس، "یم نفر واتناوُکھ میٚون گرٕ۔ جانورا اکھ مارُن تہٕ کر کھیٚن تیار، تکیازِ بہٕ چُھس یژھان زِ یم کھیٚن کوج مےٚ سٟتؠ۔ تٔمؠ وُن پننِس نوکرس یتہِ زِ یمہٕ کٔمہِ ترتیبہ بہناوٕ ہکھ۔
\v 17 تٔمؠ نفرن کوٚر تی یہ یوسفنؔ ونُس۔ تہٕ واتناوِن یوسفُن گرٕ۔
\v 18 مگر تِم کھوژؠ یُتھےٕ سُہ تمن یوسفنؔ گرٕ پکناونہِ لوٚگ۔ تِم ٲسؠ سونچان، "سُہ کیازِ چُھ اسہِ یور پکناوان، تکیازِ گۅڈنکہِ پھرِ ییٚلہِ أسؠ یور آیاے تہٕ سانیٚن بوٚہرین منٛز آیییہِ چٲنٛدؠ تھاونہٕ یۅسہ اسہِ واپس أنؠ۔ یتُھےٕ أسؠ کھیٚون لاگو یہ ونہِ پننٮ۪ن نوکرن اسہِ پٮ۪ٹھ حملہٕ کرُن تہٕ کرِ اسہِ بنٛد، پتہٕ بناوِ اسہِ غلام تہٕ نیٚیہ سانیٚن خرن تہِ۔
\v 19 تِم دراے تس نفرس سٟتؠ یُس یوسفؔ سنٛدِ گرٕ سامانُک رٲچھ در اوس۔ ییٚلہِ تِم گرٕ کِس دروازس پٮ۪ٹھ وٲتؠ،
\v 20 تِمو منٛزٕ وُن أکؠ تمِس، "جناب میانؠ کتھ بوزؠ تو۔ أسؠ آے پتمہِ لٹہ یور تہٕ ہیٚوت کینٛہہ اناج موٚلؠ۔
\v 21 مگر گرٕ گژھنہٕ وزِ یتھ جایہِ اسہِ راتس پڑاو دیُت تتہِ کھوجہِ اسہِ پننہِ بوٚہرِ۔ أسؠ گے یہ وُچِھتھ حٲران زِ سانہِ پرٛتھ کُنہِ بوٚہرِ منٛز ٲس برابر تیژ چٲنٛدؠ ییژاہ اسہِ اناجہِ باپتھ دِژمٕژ ٲس۔ لہٰذا أنؠ سۅ چٲنٛدؠ اسہِ پانس سٟتؠ۔
\v 22 اسہِ أنؠ مذید اناج مٔلؠ ہیٚنہٕ خٲطرٕ بیٚیہِ تہِ چٲنٛدؠ پانس سٟتؠ۔ اسہِ چھنہٕ خبرےٕ زِ سانیٚن بوٚہرین منٛز کمؠ ٲس یہ چٲنٛدؠ تھٲومٕژ۔
\v 23 تٔمؠ نفرن وننَکھ تورٕ، "کٔریو آرام! مہ ہیوٗ یہ فِکر! مےٚ میج سۅ چٲنٛدؠ یۅسہ توٚہہِ أنیٚو۔ تُہنٛدؠ خداین، یمِس خدایہ سنٛز عبادت تُہنٛد مول کران چُھ، آسہ تُہنٛزن بوٚہرین منٛز سۅ ترٲومٕژ۔ "پتہٕ اوٚن تٔمؠ شمعونؔ قٲد خانہٕ منٛزٕ کٔڈتھ تِمن نِش۔
\v 24 وۅنؠ تھٲوؠ تٔمؠ تِمہٕ یوسفؔ سنٛدِ گرِ۔ تٔمؠ دیُت تِمن کھۅر چھلنہٕ باپتھ آب تہٕ خرن باپتھ کھیٚن۔
\v 25 تٔمؠ وُن تِمن زِ توٚہہِ چُھ دُپہرک کھیٚن کھیٚنہِ یوسفسؔ نِشہ گژُھن۔ لہٰذا تھٲوؠ تِمو پنٕنؠ تحفہٕ تیار یوسفَسؔ دنہٕ باپَتھ۔
\v 26 یتھُےٕ یوسفؔ گرٕ ووت تہٕ تِمو کٔرؠ تس تمہٕ تحفہٕ پیش یمہٕ تمو گرِ أنمٕتؠ ٲسؠ۔ پتہٕ کٔرِکھ تس برُونٛہہ کنہِ سٔجدٕ۔
\v 27 تٔمؠ پرُوژھ تِمن زِ کیا توٚہؠ چُھوا ٹھیک، پتہٕ پرُوژھنکھ، تُہنٛدِس بُڈٕ مٲلؠ سُنٛد صحت کیٚوتھ چُھ یمِس متعلق توٚہہِ وَنیو؟ کیا تمہٕ چھا وُنہِ زنٛدے؟"
\v 28 تِمو منٛزٕ وُن أکؠ، "آ، تُہنٛد خٲدِم، سون مول چُھ وُنہِ زنٛدے، تہٕ سُہ چُھ خٲرٕ سان۔ "پتہٕ دِتُکھ تمِس برُونٛہہ کنہِ بیٚیہِ سٔجدٕ۔
\v 29 پتہٕ وُچھ تٔمؠ پنُن کونٛس بوے بنیمِینؔ یُس تمِس پننہِ ماجہِ ہُنٛد دویم لڑکہٕ اوس۔ تٔمؠ پرُوژھ تِمن، "کیا یہ چھا توٚہہِ ساروےٕ کھۅتہٕ لۅکُٹ بوے؟ یمِس متعلق توٚہؠ مےٚ ونان ٲسیٚو؟ ییٚلہِ تِمو تورٕ آنٛکار کۅرُس تہٕ تٔمؠ وُن بنیمِینسؔ، "نوجوانا، بہٕ چُھسے دُعا کران زِ خدا روزِن ژےٚ پٮ۪ٹھ مہربان۔"
\v 30 یوسفؔ دراو جلدےٕ کمرٕ منٛزٕ نیٚبر۔ تمِس باسیاو زِ تس ییہِ ۅ ودُن تکیازِ لۅکُٹ بوے وُچِھتھ ہیٚوتُن سُہ جذبٲتؠ گژُھن۔ سُہ ژاو پننِس ذٲتی کمرس منٛز تہٕ ژھٹٕن تٔتی باکھ۔
\v 31 پتہٕ وُتھرووُن اوٚش تہٕ دراو پنٕنؠ جذبات کاپہِ رٔٹِتھ نیٚبر تہٕ ونُن نوکرن، "کٔریو کھیٚن پیش!"
\v 32 وُنؠ ٲسؠ مِصرٕکؠ لوٗکھ یہ سونچان زِ عِبرٲنین سٟتؠ یہُنٛد کھیٚن کھیٚون چُھ توہین، لہٰذا اوٚن نوکرو پانے یوسفَسؔ برُونٛہہ کُن کھیٚن، تہٕ مِصرٕ کیٚن باقی نفرن تہِ کٔرکھ خدمت یمہٕ تمِس کُنؠ سےٕ زٔنِس نِشہ کھیٚن کھیٚوان ٲسؠ۔ یوسفنؔ کٔر پننٮ۪ن زِٹھیٚن باین تہٕ کٲنٛسِس بٲیس پانے خدمت۔
\v 33 تمسنٛدؠ بٲے گے یہ وُچِھتھ حٲران زِ تِم ٲسؠ پن پننہِ جایہ پٮ۪ٹھ وٲنٛسہِ حسابہٕ ترتیبہٕ سان بہناونہٕ آمٕتؠ۔
\v 34 ییٚلہِ تِمن یوسفنہِ دستارخانہٕ پٮ۪ٹھٕ کھیٚن ننہٕ آو تہٕ بنیمِینؔ سنٛزٕ جایہ اوس باقیو کھۅتہٕ پانٛژھ گنہٕ زیادٕ کھیٚن۔ یتھٕ کٔنؠ کھیٚو تِمو یوسفَسؔ سٟتؠ کاجُک کھیٚن تہٕ بیٚیہِ چیکھ مشروبات تہِ، تِم گے سیٹھاہ خوش۔
\c 44
\p
\v 1 ییٚلہِ تمسنٛدؠ بٲے گرٕ واپس گژھنہٕ خٲطرٕ تیار سپدؠ تہٕ یوسفنؔ وُن تس نفرس یُس تٔمسنٛدِ گرٕ سامانُک نگران اوس زِ "یمن نفرن بر بوٚہرین منٛز تیوٗت اناج یوٗتاہ تِم پننٮ۪ن خرن پٮ۪ٹھ نِتھ ہیٚکن۔ تہٕ پرٛتھ کٲنٛسہِ نفرٕ سنٛزِ بوٚہرِ منٛز تھاوکھ پٮ۪ٹھٕ کنہِ سۅ چٲندؠ یۅسہ تِمو اناج موٚلؠ ہیٚنہٕ باپتھ دِژ مٕژ چھےٚ۔
\v 2 پتہٕ تھاوکھ میٚون چاندِ ہُنٛد پیالہٕ ساروےٕ کھۅتہٕ لۅکٹِس بٲے سنٛزِ بوٚہرِ منٛز پٮ۪ٹھٕ کنہِ تتھ چاندِ سٟتؠ یۅسہ تٔمؠ اناجہٕ خٲطرٕ دِژمٕژ چھےٚ۔ یتھٕ کنؠ کوٚر نوکرن تہِ یہ تس یوسفنؔ کرُن وُن۔
\v 3 بیٚیہِ دوٚہہ صبحٲے فجر وقتہٕ آو یمن نفرن خر ہیٚتھ گرٕ کُن رخصت کرنہٕ۔
\v 4 وُنہِ ٲسؠ نہٕ تِم شہرٕ نِشہ زیادٕ دوٗریامٕتؠ زِ یوسفنؔ وُن پننہِ گرٕ کیٚن چیزن ہنٛدِس نگرانس، "جلدےٕ دور تِمن نفرن پتہٕ۔ ییٚلہ ژٕ تِمن نِش واتکھ تہٕ تِمن ون اسہِ اگر توٚہہ سٟتؠ بہتر ورتاو کۅر! تہٕ توٚہہ کیازِ کُرو تمہِ بدلہٕ اسہِ سٟتؠ بُرٕ؟
\v 5 توٚہہِ چُھو سُہ پیالہٕ ژوٗرِ نِمُت یتھ منٛز میٚون آغہٕ چیٚوان چُھ۔ یہ چُھ سُہ پیالہٕ یمہٕ سٟتؠ سُہ تمہٕ چیز وچھتھ ہیٚکان چُھ یمن متعلق نہٕ کانٛہہ زانان آسہ! توٚہہ یہ کۅرو تہِ چُھ سیٹھاہ غلط!"
\v 6 ییٚلہ نوکرن تِمہٕ رٔٹؠ تہٕ تٔمؠ وُن تِمن تی یہ یوسفنؔ تمِس تِمن وننہٕ خٲطرٕ ونمُت اوس۔
\v 7 مگر تِمو منٛزٕ وُن أکؠ تمِس در جواب، "جناب، توٚہؠ کیازِ چُھو یژھٕ کتھٕ کران؟ أسؠ چھِ تُہنٛدؠ خٲدم تہٕ أسؠ ہیٚکو نہٕ یژھ حرکت کٔرتھےٕ۔
\v 8 حطاکہِ اسہِ أنؠ کنعانہٕ پٮ۪ٹھٕ سۅ چٲندؠ واپس یۅسہ سانیٚو بوٚہریو منٛزٕ تتہِ درایہ۔ لہٰذا چھےٚ یہ کتھ یقینی زِ چٲنِس آغہٕ سنٛدِ گرِ کتہِ نِمو أسؠ سۅن یا چٲندؠ ژوٗرِ۔
\v 9 اگر توٚہہِ باسان چُھ زِ اسہِ منٛزٕ چُھ سُہ پیالہٕ کانٛسہِ نِش تہٕ ژٕ ہیککھ تس پھٲسؠ دِتھ۔ تہٕ أسؠ باقی روزو توٚہہ غلام۔
\v 10 تٔمؠ نفرن وُننَکھ، "بہٕ کرٕ تی یہ توٚہؠ ؤنیٚو۔ مگر یس نِش پیالہٕ نیرِ تمِس دمہٕ نہٕ بہٕ کانٛہہ سزا، بلکہ بناون بہٕ سُہ پنُن غلام، تہٕ توٚہؠ باقی ہکیٚو واپس گرٕ گژھِتھ۔"
\p
\v 11 پرٛتھ کانٛسہِ نفرن واجہ خرو پٮ۪ٹھٕ جلدےٕ جلدےٕ بوٚہرِ بوٚن تہٕ موٚژروٕہکھ گنٛڈ۔
\v 12 پتہٕ لوگ نوکرن پرٛتھ کُنہِ بوٚہرِ منٛزٕ پیالہٕ ژھانٛڈُن۔ تٔمؠ کٔر ساروےٕ کھۅتہٕ بٔڈس بٲے سنٛدِ پٮ۪ٹھٕ تلٲشی کرٕنؠ شروع تہٕ ساروےٕ کھۅتہٕ لۅکٹِس بٲے سنٛزِ بوٚہرِ پٮ۪ٹھ واتناون انٛد۔ تٔمؠ لوٚب بنیمِینؔ سنٛزِ بوٚہرِ منٛزٕ سُہ پیالہٕ تہٕ ہووُن تِمن۔
\v 13 باے بانٛبریاے، تِمو ژٔٹؠ پنٕنؠ پلو۔ تِمو برِ بیٚیہِ بوٚہرِ خرن تہٕ پھیرؠ شہر کُن واپس۔
\p
\v 14 ییٚلہ یہُوداؔ تہٕ تمسنٛدؠ زِٹھؠ تہٕ کانٛژھؠ بٲے یوسفؔ سُنٛد گرٕ ژاے تہٕ یوسفؔ اوس نہٕ وُنہِ تتہِ۔ نوکر گو تہٕ ونُن یوسفسؔ زِ کیاہ سپُد۔ یوسف آو تہٕ یم بارٕنؠ پیٚی تس پادن۔
\v 15 یوسفنؔ وُن تِمن، "توٚہہِ کیازِ کۅرو یہ؟ توٚہہِ چُھنا پےَ زِ بہ مےٚ ہیٚوٗ نفر ہیٚکہِ سُہ چیز تہِ لٔبِتھ یُس نہٕ کانٛہہ زانان آسہ۔
\v 16 یہوداہنؔ دِتُس جواب، "جناب، أسؠ کیاہ ہیٚکو ؤنِتھ؟ أسؠ کِتھہٕ کنؠ کرو یہ ثٲبت زِ أسؠ چھِ بے قصور؟ خداین دیُت اسہِ تِمن گُنہَن ہُنٛد سزا یمہٕ اسہِ کینٛہہ وری برُونٛہہ کٔرمٕتؠ چھِ۔ لہٰذا بنیاے وۅنؠ أسؠ چٲنؠ غلام۔ أسؠ سٲری تہٕ سُتہ یمہِ سنٛزِ بوٚہرِ منٛزٕ پیالہٕ دراو۔"
\v 17 مگر یوسفنؔ وُننَکھ تورٕ واپس، "نہ بہٕ کرنہٕ تہِ۔ صرف بنہِ سُہ نفر میٚون غلام یمہِ سنٛزِ بوٚہرِ منٛزٕ پیالہٕ دراو۔ باقی ہکیٚو توٚہؠ سٲری آرامہٕ سان پننِس مٲلِس نِش گٔژھتھ۔
\v 18 پتہٕ آو یہُوداؔ یوسفسؔ برُونٛہہ کُن تہٕ وُننَس، جناب، مےٚ دِیو کینٛہہ عرض کرنُک موقہٕ۔ توٚہؠ چُھو پانہٕ بحثیتِ بادشاہ، یمہِ کِنؠ توٚہؠ حکم ہکیٚو کٔڈٹھ مےٚ پھٲسؠ دیاونُک۔ مگر توٚہؠ گٔژھؠ زیٚو نہٕ مےٚ کتھ وننَس پٮ۪ٹھ ناراض۔
\v 19 توٚہہِ پرٕژھو اسہِ، "کیاہ تُہنٛد مول چھا وُنہ زندے؟ کیاہ توٚہہِ چُھوا بیٚیہِ کانٛہہ بوے؟"
\v 20 اسہِ وُن "سون مول چُھ زندے، سُہ چُھ بُڈٕ شخص۔ تمِس چُھ اکھ جوان لٔڑکہٕ یُس سٲنِس مٲلِس بُڈِتھ زامُت چُھ۔ تمِس بٲیس زیُٹھ اوسس بیاکھ لڑکہٕ یُس گذریومُت چُھ۔ تہٕ وۅنؠ چُھ پننہِ ماجہِ یوٚہے کُنےٕ اولاد یُس ونیُک تام زندٕ چُھ تہٕ امسنٛدِس مٲلِس چُھ أمِس منٛز زوو۔"
\v 21 پتہٕ ونُو توٚہہِ ییٚلہ دُبارٕ یور یِیو تہٕ پنُن لۅکُٹ بوے أنؠ زیون سٟتؠ یُتھ بہٕ سُہ وچُھن۔
\v 22 اسہِ ووٚن توٚہہِ "نہ، أسؠ ہیٚکو نہٕ تہٕ کٔرِتھ تکیازِ سُہ لڑکہٕ ہیٚکہ نہٕ پننِس مٲلِس ترٲوِتھ" اگر سُہ پننِس مٲلِس نِشہ دوٗرِ تمسُنٛد مول مرِ تمسنٛدِ دوٗرِرٕ۔"
\v 23 مگر توٚہہِ فرموو اسہِ، "اگر نہٕ توٚہؠ پنُن لۅکُٹ بوے پانس سٟتؠ أنؠ وون تیٚلہِ ہیٚکو نہٕ بہٕ توٚہہِ ملاقات دِتھ۔"
\v 24 ییٚلہ أسؠ پننِس مٲلس نِش واپس وٲتؠ تہٕ اسہِ وُن تمِس زِ توٚہہِ کیاہ وُنو۔
\v 25 اکہِ ریٚتؠ پتہٕ وُن اسہِ مٲلؠ مِصر گٔژھِو تہٕ ہِیو کینٛہہ اناج!
\v 26 مگر اسہِ ونُس أسؠ ہیٛکو نہٕ پانہٕ گٔژھتھ، أسؠ ہیٛکو تیٚلے تور گٔژھتھ ییٚلہِ سون لۅکُٹ بوے اسہِ سٟتؠ آسہ۔ اگر سون لۅکُٹ بوے اسہِ سٟتؠ آسہ نہٕ تیٚلہِ ہیٚکنہٕ اسہِ اناج کٔنن وول نفر سمکِھتھےٕ۔"
\v 27 تتھ در جواب وُن سٲنؠ مٲلؠ، "توٚہؠ چُھو زانان زِ میانہِ خاندارنہِ راخِلؔہ دیُت میانیٚن دوٚن لٔڑکن زایُن۔
\v 28 تِمو منٛزٕ سپُد اکھ لاپتہ، تہٕ مےٚ وُنمس، تس آسہٕ پٔزؠ کِنؠ کانٛسہِ جنٛگلی جانورن نیٚوک نیٚوک کۅرمُت۔ "تہٕ پتہٕ وُچھ نہٕ مےٚ سُہ أچھوےٕ۔
\v 29 اگر توٚہؠ وۅنؠ یہ بیاکھ تہِ مےٚ نِش جُدا کٔرؠ وون تہٕ أمِس کانٛہہ نقصان واتنٲیو زٲنؠ زیٚو بہٕ بُڈٕ تہٕ ریش سفید انسان مٲرؠ وون توٚہؠ امہِ غمہٕ سٟتؠ۔
\v 30 مہربٲنی کٔرِتھ بوزؠ تو، میٚون مول روزِ تیٚلہ زندٕ ییٚلہِ تمسُنٛد لۅکُٹ نیٚچو زنٛدٕ آسہ۔
\v 31 ییٚلہِ أسؠ تمِس نشہٕ واتو تہٕ سُہ وُچھِ زِ لٔڑکہٕ چُھیی نہٕ اسہِ سٟتؠ تہٕ سُہ مرِ تمی وزِ۔ أسؠ مارٕ وون پنُن ریش سفید مول امہِ غمہٕ سٟتؠ۔
\v 32 مےٚ دِژ تس ضمانت زِ یہ لٔڑکہٕ ییہِ وارٕ کارٕ واپس۔ مےٚ وُن تمِس، "توٚہؠ ہکیٚو مےٚ جواب ہیٚتھ یُس وعدہ بہٕ کران چُھس۔ اگر مےٚ یہ توٚہہِ نِش واپس اوٚن نہٕ تہٕ تمہِ سنٛدِ واپس نہ یِنُک قصور وار زٲنؠ زٕ چٕ مےٚ۔"
\v 33 لہٰذا بنٲیو مہربٲنی کٔرِتھ میانِس لۅکٹِس بٲے سنٛدِ بدلہٕ مےٚ پنُن غلام۔ تہٕ یہ لٔڑکہٕ سوزؠ تون پننٮ۪ن بڈین باین سٟتؠ گرٕ واپس۔
\v 34 اگر یہ لڑکہٕ مےٚ سٟتؠ آسہ نہٕ تہٕ بہٕ ہیٚکہٕ نہٕ پننِس مٲلس نِش واپس گٔژھِتھ۔ بہٕ چُھسن نہٕ پنُن مول امہِ دۅکھٕ غمگین وچُھن یژھان۔"
\c 45
\p
\v 1 یوسفؔ اوس نہٕ وۅنؠ پننٮ۪ن جذباتن پٮ۪ٹھ قوبو پرٲوِتھ ہیٚکان۔ سُہ اوس نہٕ پننٮ۪ن خٲدمن برُونٛہہ کنہِ ودُن یژھان، لہٰذا وُن تٔمؠ تِمن روبہٕ سان "توٚہؠ سٲری نیریٚو یتہِ نیٚبر!" تمہٕ پتہٕ دراے تِم نیٚبر تہٕ تتہِ اوس نہٕ یوسفسؔ نِش مِصرُک کانٛہہ ییٚلہ تٔمؠ پننٮ۪ن باین وُن زِ بہٕ کُس چُھس۔
\v 2 سُہ لوٚگ تتھٕ کنؠ نالہٕ دنہِ زِ نیٚبرِمیٚو نفرو مِصرِیو تہِ بوز تہٕ محل خانہ کیٚو باقی لوٗکو تہِ۔
\v 3 یوسفن وُن پننٮ۪ن باین، "بہٕ چُھس یوسفؔ! کیاہ سون مول چھا وُنہِ زندے؟" مگر تٔمسنٛدیو بایو ہیٚوک نہٕ کہین ؤنتھ تکیازِ تم گے دم پُھٹؠ زِ یہ کیاہ چُھ یہ ونان۔
\v 4 پتہٕ وُن یوسفنؔ پننٮ۪ن باین، "ؤلیو مےٚ برونٛہہ کُن" ییٚلہ تِم تٔمس نزدیک آے تہٕ وُننکھ، بہٕ چُھس تُہنٛد بوے یوسفؔ! سُے یوسف یُس توٚہہِ تٲجرن کٕنہٕ وون تہٕ تِمو واتنووُس بہٕ یور مِصر!
\v 5 مگر وۅنؠ مہٕ گژھیٚو توٚہؠ پریشان تہٕ پانس مہٕ گژھیٚو بیزار زِ توٚہہ ژُھنووس بہٕ غلام بنٲوِتھ کٔنِتھ۔ یہ چُھ خدایہ سُنٛد کرُن یمؠ بہٕ توٚہہِ برُونٛہہ یور واتنووُس تاکہ توٚہہِ بچایو دراگہٕ سٟتؠ مرنہٕ نشہٕ۔
\v 6 یتھ ملکس منٛز چُھ پتمیٚو دوٚیو ورؠ یو پٮ۪ٹھٕ دراگ چلان تہٕ یہ روزِ بیٚیہِ تہِ پانٛژن وری ین جٲری۔ اتھ وقتس دوران نہ وایہ کانٛہہ زمینےٕ تہٕ نہ آسہ لوننہٕ خٲطرٕ فصلےٕ۔
\v 7 خداین سوزُس بہٕ توٚہہِ برُونٛٹھےٕ یور تاکہِ توٚہؠ روزیٚو نہٕ بۅچھِ ۂتؠ تہٕ یہ کتھ بنہِ یقینی زِ تُہنٛز زُرؠ یاتھ بچہ۔
\v 8 لہٰذا ووتُس نہٕ بٕ تُہنٛدِ سٟتؠ یور، یہ چُھ خدایہ سُنٛد یژُھن یمؠ بہٕ یور واتنووُس! تٔمؠ بنووُس بہٕ بادشاہس زنتہٕ مول۔ بہٕ چُھس تمہِ سنٛدِ محلہٕ کہ پرٛتھ چیزُک نگران تہٕ مِصرس منٛز سارنی ہُنٛد گورنر!
\v 9 وۅنؠ گٔژھیٚو جلدےٕ میانِس مٲلس نِش تہٕ ؤنؠ ووس، چون نیٚچو یوسفؔ چُھ یہ ونان: "خداین بنووُس بہٕ سارے مِصرُک بادشاہ۔ جلدےٕ وات مےٚ نِش!
\v 10 توٚہؠ ہکیٚو جشنؔ علاقس منٛز روزِتھ۔ توٚہؠ، تُہنٛدؠ شُرؠ تہٕ زُرؠ، تُہنٛدؠ تیر، ژھاوٕلؠ، چاروٲے تہٕ پرٛتھ سُہ چیز یُس تُہنٛز ملکِیت آسہ، روزَن مےٚ نزدیک۔
\v 11 تکیازِ دراگٕکؠ پانٛژھ وری چھِ وُنہِ تہٕ بہٕ بناوٕ یہ یقینی زِ توٚہہ نِش چُھ کھیٚن۔ اگر نہٕ توٚہؠ یور یِیو تہٕ توٚہؠ، تُہنٛد عیال تہٕ تُہنٛدؠ سٲری نوکر مرن بۅچھِ بۅچھِ کران۔
\v 12 اگر ژٕ، تہٕ بنیمِینؔ تہِ مےٚ غورٕ سان وُچھو تہٕ توٚہہِ سارنی گژھِ یقین زِ بےٕ چُھس یوسفؔ یُس توٚہہِ سٟتؠ کتھ چُھ کران۔
\v 13 گٔژھیٚو ؤنیٚو میانِس مٲلِس زِ مِصرس منٛز کیٚوتھ عزت چُھ مےٚ۔ یہ کینٛژھا توٚہہِ وُچھو تتھ متعلق ؤنیٚو تمِس۔ تہٕ میٚون مول واتنٲوؠ وون جلدےٕ یور!"
\v 14 پتہٕ روٚٹ تٔمؠ پنُن لۅکُٹ بوے بنیمِینؔ نالہٕ متہِ تہٕ لوٚگ ریٚونہِ۔ بنیمِیننؔ تہِ لوگ سُہ نالہٕ متہِ رٹِتھ ودُن۔
\v 15 پتہٕ کٔرؠ تٔمؠ پننٮ۪ن بڈین باین رِوان رِوان ماہ تہٕ میٹھؠ، تمہِ پتہٕ لٲج تٔمسنٛدیو بایو تمِس سٟتؠ کتھ کرٕنؠ۔
\v 16 کُس تام گو محل خانس منٛز تہٕ ؤنِن تتہِ یہ خبر زِ یوسفسؔ چھِ بٲے آمٕتؠ۔ بادشاہ تہٕ تمسنٛدؠ تمام عہدٕدار گےَ خوش۔
\v 17 بادشاہن وُن یوسفسؔ، "پننٮ۪ن باین وَن زِ پننٮ۪ن خرن پٮ۪ٹھ بٔریٚو اناج تہٕ گٔژھیٚو کنعان مُلکس کُن روانہٕ۔
\v 18 پتہٕ أنوون پنُن مول تہٕ پنٕنؠ گرٕ وٲلؠ تہِ یورؠ۔ بہٕ دِمو توٚہہِ مِصرس منٛز بہتر جاے تہٕ کھیٚنہٕ خٲطرٕ میلیٚو توٚہہِ یتہِ بہترین غذا۔"
\v 19 پننٮ۪ن باین ؤنیٚو یتہِ زِ "پننہِ گرٕواجنہِ تہٕ شُرؠ یور اننہٕ باپتھ نِیو مِصرٕ پٮ۪ٹھٕ کینٛہہ گاڈِ تہٕ أنووکھ، بیٚیہِ أنوون پنُن مول تہِ سٟتؠ تہٕ وٲتیٚو جلدےٕ واپس۔"
\v 20 پنُن مال یور واتناونٕچ بٔرؠ زیٚو نہٕ کانٛہہ فِکٕر تکیازِ مِصرس منٛز آسن ساروےٕ کھۅتہٕ اصل چیز تُہنٛدِ باپتھ۔ لہٰذا پییہِ نہٕ توٚہہِ کنعان پٮ۪ٹھٕ کانٛہہ تہِ چیز یور اننٕچ ضرورت۔"
\v 21 یعقوبؔ سنٛدیو نیٚچیو کۅر تی یہ بادشاہ سُنٛد فرمان اوس۔ بادشاہ سنٛدِ فرمانہ مطٲبق دِژٕ یوسفنؔ تِمن گاڈِ تہٕ کھیٚن یہ تِمن وتہِ لگہ ہے۔
\v 22 تٔمؠ دِتؠ تِمن سارنی نٔوؠ پلو، مگر بنیمِینسؔ دِتؠ تٔمؠ چاندِ ہنٛدؠ ترےٚ ہتھ سِکہٕ تہٕ بیٚیہِ نویٚن پلون ہنٛدؠ پانٛژھ جورٕ!
\v 23 پننِس مٲلِس سوزؠ تٔمؠ مِصرٕ پٮ۪ٹھٕ ینہٕ والہِ بہترین سامانہٕ سٟتؠ بٔرِتھ داہ خر تہٕ داہ خٔرنہِ یمن پٮ۪ٹھ تس مِصرٕکہ سفرٕ باپتھ اناج، ژۅٹ تہٕ باقی کھیٚنہٕ سامانہٕ بٔرِتھ اوس۔
\v 24 یتھ کٔنؠ کٔرؠ تٔمؠ پنٕنؠ بٲے پننہِ وتہِ روانہٕ تہٕ وُننَکھ ینہٕ وتہِ لڑٲے لٲگیٚو۔
\v 25 لہٰذا دراے تمسنٛدؠ بٲے مِصرٕ منٛزٕ تہٕ وٲتؠ پننِس مٲلِس یعقوبسؔ نِش کنعانس منٛز۔
\v 26 تِمو منٛزٕ وُن أکؠ تمِس، "یوسفؔ چُھ وُنہِ زندے۔ اکھتُے چُھ سُہ سارے مِصرُک گورنر!" یعقوب گو یہ بوزِتھ حٲران۔ تمِس بیٹھ نہٕ پژھےٕ یہ کیاہ آسہ پوٚز۔
\v 27 مگر تِمو وُن تس تہِ سورےٕ یہ یوسفنؔ تِمن ونمُت اوس تہٕ یعقوبن وُچھٕ تمہٕ گاڈِ تہِ یم یوسفنؔ سُہ، تمسُنٛد خاندان تہٕ باقےٕ مال مِصر اننہٕ باپتھ سوزٕمژٕ آسہٕ۔ یتھ کٔنؠ ژوٚل یعقوبسؔ سورےٕ غم۔
\v 28 تٔمؠ وُن، "یہ توٚہہ ونُو تہِ چُھ میانہِ یقینہٕ باپتھ کٲفی۔ میٚون نیٚچو یوسفؔ چُھ ونیُک تام زندٕ، بہٕ گژھٕ تہٕ مرنہٕ برُونٛہہ وچُھن سُہ!
\c 46
\p
\v 1 لہٰذا دراو یعقوبؔ پنُن خاندان تہٕ تمام مالہٕ اسباب ہیٚتھ۔ ییٚلہ سُہ بیرسبعؔ جایہ ووت تہٕ تٔمؠ کرِ تتہِ خدایہ سنٛدِ ناوٕ قربٲنیہِ پیش یمِچ ریوایت تمسنٛدؠ مٲلؠ اسحاقن قٲیم کٔرمٕژ ٲس۔
\v 2 امہِ رٲژ آو یعقوبس خدا خابس منٛز تہٕ وُننَس، "یعقوبؔ! یعقوبؔ!" تٔمؠ ونُس یورٕ، "بہٕ چُھس حٲضر!"
\v 3 خداین ونُس، بہٕ چُھس خدا یمؠ سنٛز عبادت چون مول کران اوس۔ مِصر گژھنَس مہٕ کھۅژ تکیازِ بہٕ دِمے ژےٚ واریاہ اولاد تہٕ تِم بنَن تتہِ اکھ عظیم قوم۔
\v 4 بہٕ آسہٕ مِصرس منٛز ژےٚ سٟتؠ تہٕ پتہٕ انن بہٕ چٲنؠ ذریاتھ پانس سٟتؠ کنعان واپس۔ تہٕ یوسف آسہ تمہِ وزِ توٚہے نِش ییٚلہ توٚہہِ مرُن آسہ۔"
\v 5 لہٰذا دراو یعقوبؔ بیرسبعؔ پٮ۪ٹھٕ تہٕ تٔمسنٛدیو نیٚچیو بوٚر پنُن مول، بننہِ گرٕواجنہِ تہٕ بجہٕ تِمن گاڈین منٛز یمہٕ بادشاہن تِمن سفرٕ خٲطرٕ سٟتؠ دژٕمژٕ آسہٕ۔
\v 6 یتھ کنؠ گو یعقوبؔ تہٕ تمسُنٛد سورےٕ خاندان مِصر۔ تِمو نی چو چاروٲے تہٕ باقےٕ سورےٕ جاداد پانس سٟتؠ یُس تِمو کنعانس منٛز کمووٕمُت اوس۔
\v 7 یعقوب گو پنٕنؠ سٲری لڑکہٕ، کورِ تہٕ زُرؠ ہیٚتھ مِصر۔
\v 8 یم یعقوبس سٟتؠ مِصر ٲسؠ تہنٛز تفصیل چھےٚ یتھٕ کنؠ:
\li یعقوبؔ سُنٛد ساروےٕ کھۅتہٕ بوٚڈ نیٚچو رُوبِنؔ۔
\li
\v 9 رُوبِنؔ سُنٛد نیٚچو حنوکؔ، فلُوؔ، حصرونؔ تہٕ کرمیؔ۔
\li
\v 10 شمعونؔ تہٕ تمسنٛدؠ نیٚچوؠ یموایلؔ، یمین، اُہدؔ، یکینؔ، صُحر تہٕ ساولؔ یُس کنعان قبیلچہ اکِس خوتونہِ ہُنٛد نیٚچو اوس۔
\li
\v 11 لاوی تہ تمسنٛدؠ نیٚچوؠ جیرسونؔ، قہاتؔ تہٕ مراریؔ۔
\li
\v 12 یہُوداؔ تہٕ تمسنٛدؠ نیٚچوؠ، سیلہؔ، فارصؔ تہ زارحؔ تہٕ تمؠ سنٛدؠ باقی نیٚچوؠ، عیرؔ تہ اونانؔ ٲسی گزیامتؠ کنعانؔ ملکس منٛز
\li فارص سنٛدؠ زٕ نیٚچوؠ حصرونؔ تہٕ حمُول۔
\li
\v 13 اشکارؔ تہٕ تمسنٛدؠ نیٚچوؠ تولعؔ، فووہؔ، یوبؔ، تہٕ سمرون۔
\li
\v 14 زبُلُون تہٕ تمسنٛدؠ نیٚچوؠ سردؔ، ایلونؔ تہٕ یَحلی ایلؔ۔
\v 15 یم سٲری ٲسؠ یعقوبؔ تہٕ لیاہؔ سنٛدؠ نیٚچوؠ یم فدن ارامؔ جایہ تہنٛزِ کورِ دینہؔ ہس علاوٕ زامٕتؠ ٲسؠ۔ کُلہم پٲٹھؠ ٲسؠ یم تیٚترہ کورِ تہٕ گۅبر۔
\li
\v 16 جدؔ تہٕ تمسنٛدؠ نیٚچوؠ، صفِیان، حجیؔ، سونیؔ، اصبانؔ، عیریؔ، ارودیؔ تہٕ اریلیؔ۔
\li
\v 17 آشرؔ تہٕ تمسنٛدؠ نیٚچوؠ، یمنہؔ، اسواہؔ، اِسویؔ، برِیعاہؔ تہٕ تِہنٛز بیٚنہِ سِرہؔ؛
\li برِیعاہؔ سنٛدؠ نیٚچوؠ: حِبر تہٕ ملکی ایلؔ۔
\li
\v 18 یم گےَ یعقوبنؔؠ تہٕ زلفہؔ سنٛدؠ شُرؠ تہٕ زُرؠ تس زلفہؔ لونڈی ہنٛدؠ یۅسہ لابننؔ پننہِ کورِ لیاہَسؔ دِژٲیہ یہُنٛد تعداد شُراہ اوس۔
\li
\v 19 یعقوب سنٛدؠ نیٚچوؠ یوسفؔ تہٕ بنیمِینؔ یم راخِلؔ ہنٛدِ مرِ آمٕتؠ ٲسؠ۔
\li
\v 20 افرائیمؔ تہٕ منسیؔ ٲسؠ یوسفٕنؠ زٕ لٔڑکہٕ تِمگےَ نہٕ مِصر واپس تکیازِ تِم ٲسؠ مِصرسےٕ منٛز زامٕتؠ۔ تِم ٲسؠ تتہِ اونؔ سنٛزِ کورِ آسِناتھؔ ہنٛدِ مرِ آمٕتؠ۔ یُس عون شہرٕ کِس ہیکلس منٛز کاہن اوس۔
\li
\v 21 بنیمِینؔ تہٕ تمسنٛدؠ نیٚچوؠ: بالعؔ، بکرؔ، اشبیلؔ، جیراؔ، نعمانؔ، اخی، روسؔ، مُفیمؔ، حفیمؔ تہٕ ارد؛
\li
\v 22 یم ٲسؠ راخِلؔ تہٕ یعقوبنؔؠ شُرؠ تہٕ زُرؠ۔ یہُنٛد کُل تعداد ژۅداہ اوس۔
\v 23 دانؔ تہٕ تمسُنٛد نیٚچو حشیمؔ۔
\v 24 نفتالیؔ تہٕ تمسنٛدؠ نیٚچوؠ یحصی ایلؔ، جونیؔ، یِصرؔ تہٕ سلیمؔ۔
\v 25 یم سٲری ٲسؠ یعقوبنؔؠ بِلہاؔ سٕنٛدؠ شُرؠ تہٕ زُرؠ تمِس لونڈی ہنٛدؠ یۅسہ لابنَن پننہِ کورِ راخِلِ سٟتؠ دِژٲیہ۔ یِم ٲسؠ کُل ستتھ نفر۔
\p
\v 26 کُلہم پٲٹھؠ ٲسؠ یِم شُہٲٹھ اولاد یِم یعقوبس سٟتؠ مِصر گےَ۔ اتھ منٛز آسہٕ نہٕ تمؠ سنٛزٕ نۅشہٕ شٲمل۔
\v 27 یعقوبؔ تہٕ یوسفؔ بیٚیہِ یوسفنؔؠ زٕ لٔڑکہٕ یم مِصرس منٛز زامٕتؠ ٲسؠ تمہٕ ہیٚتھ سمیاو مِصرس منٛز یعقوبُن سورےٕ عیال ستَتھ نفر۔
\v 28 یعقوبنؔ سوز یہُوداؔ باقین برُونٛٹھےٕ یوسفس نِش تاکہ سُہ ونہِ تس زِ جوشن واتنٕچ بہتر سبیل۔ پتہ آو یہُوداؔ پننٮ۪ن خاندان کیٚن لوٗکن نِش واپس تہٕ پتہٕ دراے تِم جشنؔ علاقس کُن۔ ییٚلہِ تِم تور وٲتؠ،
\v 29 یوسفنؔ کۅر پنُن رتھ ٹاگہٕ تیار تہٕ گو جشنؔ پننِس مٲلِس سمکھنہِ۔ ییٚلہِ یوسف تور ووت تٔمؠ رۅٹ پنُن مول نالہٕ متہِ تہٕ رود واریہس کالس ودان۔
\v 30 یعقوبنؔ وُن یوسفسؔ، "مےٚ وُچھمکھ ژٕ تہٕ وۅنؠ آم یقین زِ ژٕ چُھکھ زنٛدے۔ وۅنؠ مرٕ بہٕ شیٚہُل۔"
\v 31 امہِ پتہٕ وُن یوسفنؔ پننِس مٲلِس تہٕ پننٮ۪ن باین، "بہٕ گژھِ بادشاہس نِشہ تہٕ ونَس، میانؠ بٲے تہٕ میٚون مول بیٚیہِ خاندانٕکؠ باقی روزن وٲلؠ، یم کنعانس منٛز روزان ٲسؠ آے سٲری مےٚ نِش۔
\v 32 تِم سٲری چھِ چو چاروٲے رچھن وٲلؠ۔ تِم چھِ پنٕنؠ چاروٲے رچھان، تِمو چھِ پنٕنؠ تیر، ژھاوٕلؠ، گُپن وغٲرٕ سٟتؠ انٕنؠ۔ یۅسہ ملکِیت تِمن ٲس۔"
\v 33 ییٚلہ بادشاہ توٚہہِ ناد سوزِ تہٕ پرژھِ زِ توٚہؠ کیاہ کٲم چُھو کران؟
\v 34 توٚہؠ ونؠ زیوس زِ ییٚلہ أسؠ جوان ٲسؠ تہٕ أسؠ ٲسؠ چو چاروٲے رچھان یہ سٲنؠ جدٕ اجداد کران ٲسؠ، اگر توٚہؠ تس یہ ؤنیٚو سُہ دِیو توٚہہ جشنؔ علاقس منٛز روزنہٕ۔ یوسفنؔ وُن تِمن یہ چُھو اوٕ موٚکھٕ ونُن تکیازِ مِصرٕکؠ لوٗکھ چھِ چاروٲے رچھن والیٚن حقیر زانان۔
\c 47
\p
\v 1‏-2 یوسفنؔ تُلؠ بادشاہس سٟتؠ کتھ کرنہٕ باپتھ پانس سٟتؠ پنٕنؠ پانٛژھ بٲے۔ تٔمؠ دیُت گۅڈٕ بادشاہس تِہُنٛد تعارف، پتہٕ وُن تٔمؠ، "میٚون مول تہٕ میانؠ بٲے چھِ کنعان ملکہٕ پٮ۪ٹھٕ آمٕتؠ۔ تِمو چھِ پنٕنؠ سٲری تیٖر، ژھاوٕلؠ، چاروٲے تہٕ پرٛتھ کانٛہہ سُہ چیز اوٚنمُت یُس تِمن نِش اوس، تہٕ وۅنؠ چھِ تِم جشنؔ علاقس منٛز روزِتھ۔
\v 3 بادشاہن پرُژھ یمن باین، "توٚہؠ کیاہ کٲم چُھو کران؟" تِمو دتُس جواب، "أسؠ تہِ چھِ چاروٲیی رچھان، یتھ کٔنؠ سٲنؠ جدٕ اجداد رچھان ٲسؠ۔"
\v 4 تِمو ووٚن تس یتہِ، زِ أسؠ آے یتھ ملکس منٛز کینٛژٕ کالہٕ باپتھ روزنہِ، تکیازِ کنعانس منٛز چُھ سخت قحط چلان تہٕ سانیٚن چارواین چُھنہٕ تتہِ رچھنہٕ باپتھ کِہین۔ لہٰذا دی تو اسہِ جشنؔ علاقس منٛز روزنہٕ۔
\p
\v 5 بادشاہ وُتھ یوسفسؔ کُن، "گو چون مول تہٕ چٲنؠ بٲے چھِ ژیٚنِش آمٕتؠ۔
\v 6 تِم ہیٚکن مِصرس منٛز کُنتہِ جایہ روزِتھ یتِتھ تِم یژھن۔ پننٮ۪ن مٲلِس تہٕ باین دِ اصل پہَن زمینہٕ ٹُکرٕ۔ تِم ہیٚکن جشنؔس منٛز روزِتھ۔ تہٕ اگر ژےٚ یمن منٛز باسان چُھے زِ تمِس چھےٚ چاروٲے رچھنٕچ خاص مہارت تہٕ سُہ ہیٚکہ ہَن ژٕ میانیٚن چارواین ہُنٛد رٲچھ در بنٲوِتھ۔
\v 7 پتہٕ اوٚن یوسفنؔ پنُن مول محل خانس منٛز تہٕ کرنووُن بادشاہس سٟتؠ ملاقات۔ یعقوبنؔ منٛج خدایس بادشاہ سنٛدِ باپتھ برکتھ۔
\v 8 پتہٕ پرُوژھ بادشاہن یعقوبسؔ، "تُہنٛز وانٛس کٲژاہ آسہ؟"
\v 9 یعقوبنؔ ونُس، بہٕ چُھس اکِس ہتَس ترٕہَن کُن پکان۔ بہٕ رودُس نہٕ پننِس مٲلِس تہٕ بٔڈِبب سنٛدؠ پٲٹھؠ زندٕ، میانؠ زندگی ٲس پریشانیٚو سٟتؠ ؤلِتھ۔"
\v 10 پتہٕ کۅر بیٚیہِ یعقوبن خدایس کُن رجوع تہٕ منٛجِن بادشاہس باپتھ برکتھ تہٕ امہِ پتہٕ دراو۔
\v 11 یتھ پٲٹھؠ تھٲوؠ یوسفؔن پنٕنؠ بٲے تہٕ پنُن مول مِصرس منٛز ٹھہرٲوِتھ۔ یمیُک زن بادشاہن حکم دِیتمُت اوس، تٔمؠ دیُت تِمن ملکہٕ کِس بہترین حصس خوشن علاقس منٛز جاداد، یتھ وۅنؠ رعمسیسؔ ونان چھِ۔
\v 12 یوسفنؔ کرنو پننِس مٲلؠ سنٛدِس سٲرسےٕ خاندانس باپتھ کھیٚن تہِ فراہم۔ تٔمؠ یُس رقم تِمن دیُت سُہ اوس بٲژو حسابہ کَس کٲتیاہ شُرؠ ٲسؠ۔
\v 13 سٲرسےٕ ملکَس منٛز اوس نہٕ کُنہ قسمُک خۅراک ۅپدان تکیازِ قحط اوس صحی چلان۔ مِصرٕکؠ تہٕ کنعانٕکؠ لوٗکھ ٲسؠ سیٹھاہ کمزور سپدمٕتؠ تکیازِ تِمن اوس نہٕ منٲسب کھیٚن میلان۔
\v 14 یوسفنؔ رٔٹؠ تِم سٲری دیار یم مِصرٕ کیٚو تہٕ کنعان کیٚو لوٗکو تس تتھ غلاتس بدلہٕ دتؠ یُس تٔمؠ تِمن کُنمُت اوس تہٕ سُہ آو تِم دیار بادشاہ سنٛدِس محلس منٛز ہیٚتھ۔
\v 15 ییٚلہ مِصر تہٕ کنعان کیٚو لوٗکو پنٕنؠ سٲری دیار اناجس پٮ۪ٹھ خرٕچ کٔرؠ تہٕ تِم ٲسؠ ۅ یوسفسؔ نِش یوان تہٕ ونان ٲسِس، "مہربٲنی کٔرتھ دتہٕ اسہِ کھیٚنہٕ خٲطرٕ کینٛہہ! اسہِ کٔرؠ پنٕنؠ سٲری پونٛسہٕ اناج ہیٚنَس پٮ۪ٹھ خرٕچ، تہٕ وۅنؠ چُھنہٕ اسہِ نِش کانٛہہ تہِ پونٛسہٕ پتھ کُن!"
\v 16 یوسفنؔ جواب اوس، "چونکہ توٚہہ چھِ سٲری پونٛسہٕ مۅکلیمٕتؠ، لہٰذا أنؠ تو پنٕنؠ چاروٲے مےٚ نِش، اگر توٚہؠ تہِ کٔریٚو بہٕ دِمو توٚہہِ چاروایو بدلہٕ اناج۔
\v 17 لہٰذا أنؠ تِمو پنٕنؠ چاروٲے یوسفس نِش۔ تٔمؠ دیُت تِمن تہنٛدیٚن گُرین، تیٖرن، ژھاولیٚن، گٲون تہٕ تہنٛدیٚن خرن بدلہٕ اناج۔
\v 18 ییٚلہ سُہ وری مۅکلیاو تہٕ دویمہ وریہ آے تِم تمِس نِش تہٕ وُنہَس، "أسؠ ہیٚکو نہٕ یہ کتھ توٚہہ نِش ژوٗرِ تھٲوِتھ زِ اسہِ نِشہ چُھنہٕ کانٛہہ پونٛسہٕ تہٕ سٲنؠ چاروٲے تہِ چھِ وۅنؠ تُہنٛدی۔ اسہِ نِش چُھ ۅ توٚہہِ دنہٕ باپتھ صرف پنٕنؠ جسٕم تہٕ زمین۔ اسہِ چُھنہٕ بیٚیہِ پتھ کُن کِہین۔
\v 19 اگر توٚہؠ اسہِ کھیٚنہٕ باپتھ کینٛہہ دِیو نہٕ تہٕ أسؠ مرو۔ اگر توٚہؠ اسہِ بیٚول دِیو نہٕ سون زمین تہِ گژھِ بیٚکار۔ أسؠ تہٕ سون زمین ہیٚیو اناجس بدلہٕ موٚلؠ۔ أسؠ بنو بادشاہ سنٛدؠ غلام تہٕ سُہ بنہِ زمینُک مٲلک۔ اسہِ ہیٚیو مٔلؠ تاکہِ أسؠ ۅپداوو کُلؠ تہٕ اناج۔ یُتھ نہٕ أسؠ مرو، تہٕ سٲنؠ زمین گژھِ نہٕ بنٛجر۔"
\v 20 لہٰذا ہیٚوت یوسفنؔ بادشاہ سنٛدِ باپتھ مِصرُک سورےٕ زمین۔ مِصرٕکؠ پرٛتھ کانٛسہِ نفرن کُن أمِس پنُن زمین تکیازِ دراگ اوس ملکس منٛز یُتھ زِ یمن اوس نہٕ خوراک مٔلؠ ہیٚنہٕ باپتھ امہِ بغٲر بیٚیہِ کانٛہہ چارٕ۔ لہٰذا بنییہِ سٲرےٕ زمین بادشاہ سنٛز۔
\v 21 نتیجہ دراو یہ زِ یوسفنؔ بنٲوؠ مِصر اکہ سرحدٕ پٮ۪ٹھٕ بیٛیِس سرحدس تام سٲری لوٗکھ بادشاہ سںنٛدؠ غلام۔
\v 22 مگر تٔمؠ ہیٚژ نہٕ کاہنن ہنٛز زمین تکیازِ تِم ٲسؠ ہمیشہٕ بادشاہ سنٛز راشن نِوان۔ یوٚہے وجہ چُھ زِ تِمو خرچٲو نہٕ پنٕنؠ زمین۔
\v 23 یوسفنؔ وُن لوٗکن، "میانؠ کتھ بوزیٚو! از ہیٚتمو مےٚ توٚہؠ تہٕ تُہنٛز زمین بادشاہ سنٛدِ باپتھ موٚلؠ۔ وۅنؠ چُھ یتِتھ یہ بیٚول تاکہ یہ ؤیو توٚہؠ زمینَس۔
\v 24 مگر ییٚلہ توٚہؠ فصٕل لونیٚو تہٕ اسہِ پزِ فصلُک پٲنژم حصہٕ بادشاہس دیُن۔ باقی فصٕل چُھو توٚہہِ کھہَن وونہٕ باپتھ بیوٗل، پانس، پننٮ۪ن بچن تہٕ پرٛتھ کانٛسہِ گرٕ وٲلِس کھیٚنہٕ خٲطرٕ۔
\v 25 تِمو ونُس تورٕ، "توٚہہِ بچٲیو سٲنؠ زُو۔ أسؠ چھِ یژھان توٚہؠ گٔژھیٚو اسہِ خوش روزٕنؠ۔ تہٕ أسؠ چھِ بادشاہ سنٛدؠ غلام۔"
\v 26 یوسفنؔ بنٲوؠ مِصرچہِ تمام زمینہِ متعلق قٲیدٕ قانون۔ اکھ یہِ زِ یُس فصٕل لوننہٕ ییہِ تمیُک پانٛژِم حصہٕ آسہ بادشاہ سُنٛد۔ یُس قانون وُنتہِ رٲیج چُھ۔ صرف آسہ نہٕ کاہنن ہنٛزِ زمینہِ پٮ۪ٹھ بادشاہ سُنٛد حق۔
\p
\v 27 یعقوب تہٕ تمسُنٛد خاندان بسیاو مِصرٕ کِس جشنؔ علاقس منٛز۔ تِمو کۅر تتہِ جاداد حٲصِل۔ تِمن زاے تتہِ واریاہ اولاد۔ یمہِ سٟتؠ تتہِ تِہنٛز واریاہ آبٲدی بڑییہِ۔
\v 28 یعقوبؔ رود مِصرس منٛز سدہَن ورؠ ین۔ کُلہم پٲٹھؠ رود سُہ أکِس ہتس تہٕ ستتٲجہَن ؤرین زندٕ۔
\v 29 ییٚلہ تمِس مرنُک وقت نزدیک ووت تٔمؠ اوٚن پنُن نیٚچو یوسفؔ ناد دِتھ تہٕ وُننَس، "اگر ژٕ میانؠ رضا منٛدی کانٛچھان چُھکھ تیٚلہِ تھاو پنٕنؠ اتھٕ میانیٚن رانن پٮ۪ٹھ تہٕ کر مےٚ سٟتؠ وعدہ زِ ژٕ کرکھ مےٚ سٟتؠ وفادٲری۔ بحثیتِ مول ورتاوکھ ژٕ مےٚ سٟتؠ تہِ یہ بہٕ ژیٚنِش توقع کران چُھس۔ ییٚلہ بہٕ مرٕ تہٕ مےٚ کٔرزیٚنہٕ یتہِ مِصرس منٛز دفن۔
\v 30 یمہِ ساعتہٕ بہٕ مرٕ تہٕ پننِس مٲلس تہٕ بٔڈؠ ببَس نِشہ واتہٕ یمہٕ مےٚ برُونٛہہ درامٕتؠ چھِ تہٕ میانؠ لاش کٔڑزِ مِصرٕ منٛزٕ تہٕ واتنٲوؠ زِ کنعان تہٕ کٔرؠ زیٚن تٔتی دفن یتہِ تِم مدفون چھِ۔ یوسفنؔ ونُس درجواب، "بہٕ کرٕ تی یہ توٚہؠ ونان چُھو۔"
\p
\v 31 یعقوبنؔ ونُس، "مےٚ تھی کھیٚہ قسم زِ ژٕ کرکھ یہ۔ "اوٕ کِنؠ کھیٚو یوسفنؔ قسم زِ بہٕ کرٕ یہ۔ پتہٕ دیُت یعقوبنؔ پننِس بسترس شانٛدٕ کنہِ خدایہ سنٛز عبادت کران کران سجدٕ۔
\c 48
\p
\v 1 امہ پتہٕ کینٛہہ کٲلؠ ووٚن یوسفسؔ کٔمؠ تام، "چون مول چُھ بیمار۔ ییٚلہ یوسفنؔ یہ بوز تہٕ سُہ دراو پنٕنؠ دۅشوے نیٚچوؠ منسیؔ تہٕ افرائیمؔ ہیٚتھ مٲلِس سمکھنہِ۔
\v 2 ییٚلہ یعقوبسؔ کٔمؠ تام ووٚن، "وچُھو، تُہنٛد نیٚچو یوسفؔ آو توٚہہِ سمکھنہِ۔ یعقوبؔن، یمِس اسرائیل تہِ ونان چھِ کٔر بسترٕ پٮ۪ٹھٕ تھوٚد وتھنٕچ کوشِش تہٕ بیٚوٗٹھ بسترس پٮ۪ٹھ۔ تمہِ سنٛدِ خٲطرٕ اوس یہ کرُن کٲفی مشکِل۔
\v 3 یعقوبن ووٚن یوسفسؔ زِ ییٚلہ بہ کنعان ملکس منٛز لُوزؔ جایہ اوسُس تہٕ قدرت وٲلؠ خداین دیُت مےٚ جلوٕ۔ تٔمؠ دِژ مےٚ برکت،
\v 4 تہٕ ونُن مےٚ، بہٕ بناوتھ ژٕ واریہن بچن ہُنٛد مول بناونَس قٲبل۔ تُہنٛز زُرؠ یاتھ آسہ واریاہ، تہٕ تِم بنَن لوٗکن ہنٛدؠ واریاہ قبیلہٕ۔ تہٕ یہ زمین دمہٕ بہٕ ہمیشہ خٲطرٕ چانیٚن اولادن۔"
\v 5 تہٕ وۅنؠ چُھس بہٕ سونچان زِ چٲنؠ دوٚنوے نیٚچوؠ یم بہٕ یور ینہٕ برونٛہےٕ مِصرس منٛز زامٕتؠ چھِ، چھِ میانؠ۔ افرائیمؔ تہٕ منسیؔ تہِ چھِ میانی اولاد، تِم تہِ چھِ رُوبِنؔ، شمعونؔ تہٕ میانیٚن باقی نیٚچوٮ۪ن ہنٛدؠ پٲٹھؠ میانہِ جادادٕکؠ وٲرث۔
\v 6 اگر ژٕ وُنکہِ پتہٕ کانٛسہِ بچہٕ سُنٛد مول بنکھ تِم یِن نہٕ میانؠ بچہٕ بلکہ میانؠ زُرؠ گنٛزراونہٕ۔ تِمن میلہِ تمی حسابہٕ پنُن حصہٕ یُس تتھ علاقس منٛز آسیٚکھ یُس تہنٛدین باقی باین ترِ۔
\v 7 واریاہ وری برُونٛہہ ییٚلہ بہٕ فدان ارامؔ پٮ۪ٹھٕ واپس یوان اوسُس تہٕ چٲنؠ موج راخِلؔ مویہِ غمہٕ سٟتؠ دورانہِ سفر افراتس منٛزےٕ ییٚلہ زن کنعانؔ افراتؔ شہر پٮ۪ٹھٕ کمےٕ دوٗر اوس۔ لہٰذا کٔر مےٚ تمؠ سنٛز میت تٔتی افراتؔ شہرچہِ سڑکہِ سٟتی دفن۔ "یتھ وۅنؠ بیت لحمؔ ونان چھِ
\v 8 ییٚلہ یعقوبؔس یوسفؔ سنٛدین نیٚچوٮ۪ن پٮ۪ٹھ نظر پییہِ تہٕ تٔمؠ پرُوژھ، "یمہٕ لٔڑکہٕ کمہٕ چھِ؟"
\v 9 یوسفنؔ دیُت پننِس مٲلِس جواب، "یم چھِ تِمے لٔڑکہٕ یِم خداین مےٚ یتہِ مِصرس منٛز دِتؠ مٕتؠ چھِ۔ "یعقوبنؔ ووٚن، "یم أنووکھ مےٚ نزدیک تاکہ بہٕ کرکھ دُعا۔"
\v 10 یعقوبس اوس بُجرٕ کِنؠ گاش کمےٕ پہَن۔ سُہ اوس نہٕ اصل پٲٹھؠ وُچِھتھ ہیٚکان۔ تہٕ یوسفنؔ أنؠ پنٕنؠ نیٚچوؠ پننِس مٲلِس برُونٛہہ کُن، یعقوبن رٔٹؠ تِم نالہٕ متہِ تہٕ کٔرنکھ میٹھؠ۔
\v 11 یعقوبنؔ ووٚن یوسفسؔ، "مےٚ اوس نہٕ چون بُتھ دبارٕ وُچھنٕچ کانٛہہ امید، مگر ہے وُچھ! خداین رلووُس بہٕ ژےٚ سٟتؠ، تہٕ بیٚیہِ دیُتنم چٲنؠ بچہٕ وُچھنُک تہِ موقہٕ۔
\p
\v 12 یوسفنؔ تُلؠ مٲلؠ سنٛدیو کۅٹھیٚو پٮ۪ٹھٕ بچہٕ تھوٚد۔ تہٕ پانہٕ دِتُن پتھرِس پٮ۪ٹھ سٔجدٕ۔
\v 13 پتہٕ تُلؠ یوسفنؔ دوٚنوے لڑکہٕ افرائیمؔ رۅٹُن پانس دٔچھنہِ انٛدٕ یعقوبَس کھورِ اتھٕ انٛدٕ تہٕ منسیؔ تُھووُن مٲلِس دٔچھنہِ طرفہٕ تہٕ أنِن مٲلِس نزدیک۔
\v 14 مگر یعقوبنؔ کۅر نہٕ تہٕ یہ یوسفؔ تمِس کرناوُن یژھان اوس۔ تمہِ بجایہ تُل تٔمؠ پنُن دٔچُھن اتھٕ تہٕ تھووُن افرائیمسؔ کلس پٮ۪ٹہ، حالانکہ سُہ اوس کوٗنٛس ہیٚو لٔڑکہٕ۔ تٔمؠ زیٹھراوِ پننہِ نرِ تہٕ پنُن کھووُر اتھٕ تھووُن منسیؔ سنٛدِس کلس پٮ۪ٹھ ییٚلہ زن سُہ زیُٹھ ہیٚو اولاد اوس۔
\v 15 پتہٕ کۅر تٔمؠ یوسفسؔ تہٕ تٔمسنٛدین اولادن دُعا تہٕ ونُن، "میانؠ بُڈؠ بب ابرہامنؔ تہٕ میانؠ مٲلؠ اسحاقنؔ گُذار پنٕنؠ زندگی خدا سنٛدین احکامن پٮ۪ٹھ تہٕ ونیُک تام رود مےٚ خدا وتھ ہاوان تہٕ رٲچھ کران یتھٕ کِنؠ اکھ پوٚہل پننٮ۪ن تیٖرن کران چُھ۔
\v 16 یُس فرشتہٕ تٔمؠ سوز سُہ چُھ پرٛتھ کُنہِ مصیبتہٕ نشہٕ مےٚ رچھن وول۔
\p میٚون دُعا چُھ زِ خدا تھٲوِن یمن بچن خوش۔
\p دُعا چُھس کران زِ لوٗکھ تھٲون ژیٚتس میانس مٲلِس بُڈِ بب اضحاقسؔ تہٕ ابرہامسؔ زِ تِمن سٟتؠ کیاہ چُھ خدا ورتاوان۔
\p منٛگان چُھس زِ یمن سوزِن واریاہ اولاد یم سٲرے زمینٕکؠ بسکین بنہن۔
\v 17 ییٚلہ یوسفنؔ وُچھ زِ تمسنٛدؠ مٲلؠ تھوو پنُن دٔچُھن اتھٕ افرائیمؔ سنٛدِ بجایہ مُسنیؔ سنٛدِس کلس پٮ۪ٹھ سُہ سپُد پریشان۔ تٔمؠ تُل پننِس مٲلؠ سُنٛد دٔچُھن اتھٕ افرائیمؔ سنٛدِ کلہٕ پٮ۪ٹھٕ تھوٚد تہٕ تھووُن منسیؔ سنٛدِس کلس پٮ۪ٹھ۔
\v 18 یوسفنؔ ووٚن پننِس مٲلس، "میانہ ببا، یہ گو نہٕ جان یس پٮ۪ٹھ ژےٚ پنُن کھووُر اتھٕ تھووُتھ یہ چُھ میٚون زیُٹھ لڑکہٕ۔ أمِس پٮ۪ٹھ تھاو پنُن دٔچُھن اتھٕ۔"
\v 19 مگر تمسنٛدؠ مٲلؠ کۅر انکار تہٕ ونُن، اے میانہٕ گۅبرٕ مےٚ چُھ پتہ۔ بہٕ چُھس زانان زِ بہٕ کیاہ چُھس کران۔ منسیؔ سنٛدؠ اولاد تہِ بنن بٔڈؠ قبیلہٕ تہٕ تِم آسن سیٹھاہ اہم۔ مگر امسنٛدِس لۅکٹِس بٲے سنٛز ذریاتھ آسہ امسنٛدِ توقع کھۅتہٕ واریاہ زیادٕ۔ امسنٛزِ زُریٲژ ہنٛدؠ آسن واریاہ قبیلہٕ۔
\v 20 امہِ کۅر تٔمؠ تِمن دوٚنوٕنی دُعا تہٕ ونُن، "اسرائیل لٕکؠ لوٗکھ ییٚلہ تہِ لوٗکن دُعا کرن تہٕ تِم ہیٚن تُہنٛد ناو۔ تِم ونن، "أسؠ چھِ دُعا کران زِ خدا کٔرِن توٚہہِ مدد یتھٕ پٲٹھؠ تٔمؠ افرائیمسؔ تہٕ منسیؔ یس مدد کۅر۔
\p
\v 21 یعقوبنؔ ووٚن یوسفسؔ، "مےٚ چُھ مرُن۔ مگر بہٕ چُھس زانان زِ خدا چھی ژےٚ سٟتؠ۔ اکہِ دوٚہہ واتنٲوی سُہ ژےٚ پنٕنؠ اولادن ہیٚتھ پننٮ۪ن اسلافن ہنٛزِ سرِ زمینہِ پٮ۪ٹھ۔
\v 22 یہ چُھکھ ژٕ یس پننٮ۪ن باین پٮ۪ٹھ برتری چھےٚ، زِ ژےٚ چُھسے بہٕ سِکم علاقٕچ زرخیز پہاڑی دِوان۔ مےٚ چُھ تتھ پہاڑی پٮ۪ٹھ پننہِ تلوارِ، کمانہِ تہٕ تیٖرو سٟتؠ امورؔ لوٗکن سٟتؠ لوٚڈمُت تہٕ قبصہٕ کۅرمُت۔
\c 49
\p
\v 1 یعقوبنؔ أنؠ پنٕنؠ سٲری اولاد ناد دِتھ تہٕ وُننَکھ،
\v 2 مےٚ نزدیک روزیٚو جمع تاکہ بہٕ ونو توٚہہِ زِ آینٛدٕ کیاہ سپدِ۔ میانیٚو گۅبرو یِیو تہٕ بوزیٚو میانؠ کتھ۔ بہٕ چُھس تُہنٛد مول یعقوبؔ۔
\p
\v 3 رُوبِنؔ ژٕ چُھکھ میٚون بوٚڈ نیٚچو۔ ژٕ چُھکھ تمہِ ساتہٕ زامُت یمہِ ساعتہٕ بہٕ طاقتور تہٕ جوان اوسُس۔ ییٚلہ بہٕ بالیغ سپدُس توٚہؠ ٲسیٚو مےٚ گۅڈنِکؠ اولاد۔ ژٕ چُھکھ میانیٚو تمام اولادو منٛزٕ قٲبلِ فخر تہٕ طاقتور۔
\v 4 مگر ژٕ چُھکھ سمندرچن لہرن ہنٛدؠ پٲٹھؠ چھکرنہٕ آمُت۔ تہٕ وۅنؠ ہیککھ نہٕ ژٕ میٚون ساروےٕ کھۅتہٕ اہم نیٚچو ٲسِتھ۔ تکیازِ ژٕ ژاکھ میانِس بسترس منٛز تہٕ شونٛگکھ میانہِ لونٛڈی نِش۔ یمہِ سٟتؠ تُہنٛدس مٲلِس انتہٲیی شرمنٛدگی تُلنؠ پییہِ۔
\v 5 شمعونؔ تہٕ لاوی یم دوٚنوے بارنؠ رودؠ مجرمن ہنٛدؠ پٲٹھؠ کٲم کران۔ توٚہؠ چُھو پننہِ تلوارٕ پُر تشدُد کاروٲیو باپتھ استعمال کران۔
\v 6 بہٕ چُھس نہٕ یژھان توٚہہِ سٟتؠ روزنُے ییٚلہ توٚہؠ غلط منصوبہ بناوان چُھو۔ بہٕ چُھس اکھ معتبر تُہنٛدین مشورن منٛز گژھنہٕ شٲمل۔ تکیازِ توٚہہ مٲرؠ ووکھ لوٗکھ ییٚلہ توٚہؠ سیٹھاہ شرارتس منٛز ٲسیٚو۔ تہٕ پننہِ تفریح خٲطرٕ مٲرؠ ووکھ دانٛد تہِ۔
\v 7 خداین ووٚن بہٕ والہٕ تِمن لعنت تکیازِ تم ٲسؠ شرارتس منٛز، ییٚلہ تِم شرارتس منٛز ٲسؠ، تِم ٲسی سیٹھاہ ظلم کران۔ بہٕ کرن تہنٛز ذریاتھ اسرائیل چہ سرِ زمیٖنہ پٮ۪ٹھ پراکنٛدٕ۔
\v 8 یہُوداؔ! چٲنؠ لۅکٕٹؠ تہٕ بٔڈؠ بٲے بنن چٲنؠ مدح، تِم کرن توٚہہِ سٔجدٕ، تکیازِ ژٕ دِکھ پننٮ۪ن دشمنن اصل پٲٹھؠ شِکس۔
\v 9 یہُوداؔ چُھ تمِس جوان سٕہس ہیٚو یُس پننی مٲرمٕتؠ جانور کھیٚتھ سیر گژھِتھ واپس چُھ آمُت۔ سُہ چُھ تٔمس سٕہس ہیٚو یُس کھیٚتھ واش کٔڈتھ ڈاپھ چُھ تراوان۔ کانٛہہ اکھ کرِنہٕ تٔمس خلل کرنٕچ ہمتھ۔
\v 10 اتہِ آسہ ہمیشہ یہُوداؔ سنٛدیو اولادو منٛزٕ کانٛہہ حکمران۔ پرٛتھ کانٛسہِ ہنٛدس اتھس منٛز آسہٕ یہ باور کرنہٕ خاطرٕ اکھ عاصہٕ زِ بہٕ چُھس بادشاہ سنٛدؠ پٲٹھؠ اختیار تھاوان۔ سُہ کرِ یہ تۅتام یۅتام نہٕ تس لوٗکھ خراجِ تحسین پیش کرن تہٕ یہ باس دِن زِ أسؠ کرو تس سنٛز عبادت۔
\p
\v 11 تمسنٛدین زٲژ ہنٛدین دچھِ کُلین ۅپدِ زیادٕ زیادٕ دچھ۔ یمیُک نتیجہ یہ نیرِ زِ سُہ کرِنہٕ کانٛسہِ تہِ پنٕنؠ جوان خر دچھِ کُجن سٟتؠ گنٛڈنس اعتراض۔ یُتھ تِم دچھِ پن کھیٚتھ ہیٚکن۔ شراب آسہ وفور، یمہِ کِنؠ تِم پنٕنؠ پلو شرابس منٛز چھلن۔ تِم چھلن پننہِ ژادرٕ تہِ شرابس منٛز یُس خوٗنٕکؠ پٲٹھؠ ۅزُل آسہ۔
\v 12 بسیار شراب چیٚتھ گژھن تہنٛزٕ أچھ ۅزجہِ، مگر تہنٛدؠ دند آسن واریاہ گٲو دۅد چیٚنہٕ سٟتؠ کٲفی سفید۔
\p
\v 13 زبُلُون، چٲنؠ اولاد بسن سمندر بٹھیٚن پٮ۪ٹھ یتہِ جہازو باپتھ محفوظ بندرگاہ آسن۔ تِہُنٛد جٲگیر آسہ شمالہٕ کِنؠ صیدا شہر تام پھٲلِتھ۔
\p
\v 14 اشکارؔ، چٲنؠ اولاد آسن طاقتور خرن ہنٛدؠ پٲٹھؠ یم تیٖرن ہنٛدین دوٚن کھیٚلیٚن منٛزباگ آسن۔ تیٖتؠ تٔھکمٕتؠ یِم نہٕ تھوٚد ؤتِھتھ ہیٚکن!
\v 15 تِمن باسہِ پنٕنؠ آرام گاہ واریاہ اصل تہٕ یہ زمین کریٚکھ واریاہ خوش۔ مگر گوٚب بور تُلنہٕ باپتھ دارن تِم پنٕنؠ شانہٕ تہٕ گژھن دوٚیمیٚن ہنٛزٕ کامہِ کرنہٕ باپتھ مجبوٗر۔
\v 16 دانؔ، اگر زن چون قبیلہٕ نیٚوک تہِ آسہ مگر چٲنؠ قٲید کرن پننٮ۪ن لوٗکن پٮ۪ٹھ حکومتھ یتھٕ پٲٹھؠ زن اسرائیل کیٚن دویمیٚن قبیلن ہنٛدؠ قٲید پننٮ۪ن لوٗکن پٮ۪ٹھ حکومت کرن۔
\v 17 چٲنؠ اولاد آسن سڑکہٕ دنٛدین پٮ۪ٹھ سرپھن ہنٛدؠ پٲٹھؠ تہٕ وتن منٛز زہریلہٕ سرفن ہنٛدؠ پٲٹھؠ۔ تِم آسن پکن والیٚن گُرین گۅڈن لاینہٕ یوان، یم برٛہمیٚن پنٛجن پٮ۪ٹھ ۅتھان آسن تہٕ سوار آسن پٔتؠ کِنی پیٚوان۔"
\v 18 پتہٕ موٚنگ یعقوبن دُعا، "اے خداوند یہُوواہؔ، بہٕ چُھسے ژیی پراران تاکہ ژٕ بچاوکھ مےٚ پننیٚو دشمنو نشہٕ۔"
\v 19 پتہٕ وُن یعقوبنؔ پننٮ۪ن نیٚچوٮ۪ن مذید یتہِ زِ مستقبلس منٛز کیاہ سپدِ۔ تٔمؠ ووٚن "جدؔ، چٲنِس قبیلس پٮ۪ٹھ کرِ ژوٗرن ہنٛز اکھ جماتھ حملہٕ، مگر تُہنٛد قبیلہٕ لبہِ تِمن پٮ۪ٹھ واپس حملہٕ کٔرتھ فتح۔
\v 20 آشرؔ، چٲنؠ اولاد آسن مزٕدار تہٕ میوٗٹھ کھیٚن کھیٚوان۔ تِم آسن اناج ۅپداوان یُس بادشاہن کھیٚنہٕ باپتھ کٲفی لٔزیز آسہ۔
\v 21 نفتالیؔ، چٲنؠ شُرؠ آسن ہِرنن ہنٛدؠ پٲٹھؠ کُھلہٕ نژناہ کران، ہانٛگل یمن خوبصوٗرت روٗسؠ کچن آسن۔
\p
\v 22 ہے یوسفؔ ژےٚ آسنے واریاہ اولاد۔ تہنٛدؠ شُرؠ آسن ناگہٕ آبس نزدیک دچھِ رانٛٹھن الوانٛتؠ دچھِ گۅرنن برابر۔ یمیٚکؠ شاخ دیوارو پیٚٹھؠ پھٲلِتھ آسن۔
\v 23 تہنٛدؠ دشمن کرن تِمن پٮ۪ٹھ شدید حملہٕ تہٕ تِمن دورن تیٖر تہٕ نیزٕ ہیٚتھ پتہٕ۔
\v 24 مگر تِم روزن پننہِ کمانہٕ ہیٚتھ ڈٔٹِتھ تہٕ تہنٛزٕ نرِ آسن مضبوط، میانِس قدرتہٕ وٲلِس خدا تہٕ یہُوواہؔ سنٛدِ یژھنہٕ یُس میٚون رہنما تہٕ مےٚ سوزن وول چُھ، یتھ کنؠ اکھ پوہُل پننٮ۪ن تیٖرن رچھان تہٕ پالان چُھ۔ اسرائیل لٕکؠ لوٗکھ ونن یہُوواہسؔ اسہِ کر رٲچھ، یتھ کنؠ زن لوٗکھ تھزن کنیٚن ہنٛدین تھزرن پٮ۪ٹھ پناہ نِوان چھِ۔
\v 25 خدا، یمسنٛز بہٕ عبادت کران چُھس کرِ چانیٚن شُریٚن مدد۔ قدرت وول خدا تراوِ تِمن رحمتِ باران تہٕ زمینہٕ تلہٕ آب فراہم کرِتھ کریٛکھ برکت۔ سُہ دییہِ تِمن واریاہ اولاد تہٕ کرِ تِہنٛز پرورِش۔
\v 26 یۅسہ برکت بہٕ خدایس نِش تُہنٛدِ باپتھ یژھان چُھس سۅ چھےٚ بٔڈ۔ سۅ نعمت چھےٚ تِمو نعمژو نِشہ واریاہ زیادٕ یمہٕ اژھیٚنؠ پہاڑو پٮ۪ٹھٕ یوان چھےٚ، تَمو برکٔژو نشہٕ یمہٕ لازوال پہاڑو پٮ۪ٹھٕ یوان چھےٚ۔ یوسفؔ بہٕ چُھسے دُعا کران زِ یمہ برکٔژ میلنے ژےٚ۔ تکیازِ ژٕ چُھکھ پننٮ۪ن باین ہُنٛد سردار۔
\v 27 ہے بنیمِینؔ، چٲنؠ اولاد آسن شیطان شالن ہی۔ صُبحاے آسن تِم پننٮ۪ن دشمنن تِتھٕ پٲٹھؠ ماران یتھٕ کنؠ شال پنٕنؠ شکار کھیٚوان چھِ تہٕ شامس آسن پنُن سُہ مال جنگجوون منٛز بٲگران یُس تِم پننٮ۪ن دشمنن لوٗٹِتھ آسن انان۔"
\v 28 تِم باہ اولاد آسن اسرائیل کیٚن بہَن قبیلن ہنٛدؠ جدٕ اجداد۔ تِہنٛدؠ مٲلؠ ووٚن تِمن یی ییٚلہ تٔمؠ تٕن دُعا کۅر، تہٕ پرٛتھ کانٛسہِ ؤنِن سۅ کتھ یۅسہ تِمن پٮ۪ٹھ صٲدِر یوان ٲس۔
\v 29 پتہٕ ووٚن یعقوبن پننٮ۪ن شُریٚن، "مےٚ چُھ وۅنؠ مرُن تہٕ پننِس مٲلس تہٕ بُڈِ ببس نش واتُن یمہٕ گۅڈے گُذریمٕتؠ چھِ۔ میانؠ میت کٔرؠ زیٚو تٔتی دفن یتِتھ میانؠ جدٕ اجداد دفن چھِ، تٔتھؠ گۅپھِ منٛز یُس تتھ کھہَس منٛز چھےٚ یُس اسہِ حِتی قبیلہٕ کِس عِفرونسؔ نِش مٔلؠ ہیٚوتمُت چُھ۔
\v 30 مکفیلہؔ ناوُک مٲدان چُھ کنعان مُلکس منٛز ممرےؔ یَس مشرقہٕ طرفہٕ۔ ابرہامنؔ ہیٚژاو سُہ عِفرون حِتی یس نِش موٚلؠ تاکہ سُہ ییہِ قبرِستانہٕ باپتھ مخصوص تھاونہٕ۔
\v 31 تٔتی آو ابرہام تہٕ تمؠ سنٛز آشِنؠ سارہؔ دفن کرنہٕ۔ تٔتی آو میٚون مول اسحاق تہٕ تمؠ سنٛز گرٕ واجِنؠ رِبقہؔ تہِ دفن کرنہٕ۔ تہٕ تٔتھؠ جایہ کٔر مےٚ پنٕنؠ خاندارنؠ لیاہؔ تہِ دفن۔
\v 32 سۅ زمین تہٕ تتھ جایہِ موجود سۅ گۅپھ چھےٚ اسہِ حِت قبیلہٕ کیٚن موٚلؠ ہیٚژمٕژ۔ اوٕ کِنؠ چُھس بہٕ یژھان زِ ژٕ کرکھ مےٚ تٔتی دفن۔
\v 33 ییٚلہ یعقوبنؔ پننٮ۪ن نیٚچوٮ۪ن یم ہدایت دِتھ مۅکلٲوؠ تہٕ سُہ وُتھ بیٚیہِ پننِس بسترس منٛز۔ پتہٕ مۅکلیوس شہہ تہٕ مود۔
\c 50
\p
\v 1 یوسفؔ آو پننِس مٲلؠ سنٛدِس بُتھِس پٮ۪ٹھ لاینہٕ تہٕ لوٚگ بڈِ بڈِ ودنہِ تہٕ تس میٹھؠ کرنہِ۔
\v 2 یوسفن دیُت پننٮ۪ن خٲدمن حکم یمو میت دفناونہٕ خٲطرٕ تیار کٔر زِ تِم ملَن تمسنٛدس مٲلؠ سنٛزِ تتھ میتہِ خوشبو،
\v 3 یعقوبؔ سنٛزِ لاشہِ ٲسؠ برابر ژتجہَن دوٚہُن خوشبو ملان، تکیازِ یہ اوس سُہ زمانہٕ ییٚلہ کُنہِ جسمس خوشبو ملنس یوٗتاہ وقت لگان اوس۔ یعقوبؔ سنٛدِس مرنس پٮ۪ٹھ کوٚر مِصرٕ کیٚو لوٗکو ستتھن دوٚہُن ماتم۔
\v 4 ییٚلہ ماتمٕکؠ دوٚہہ ختم سپدؠ تہٕ یوسفنؔ ووٚن بادشاہ سںنٛدین افسرن، "اگر توٚہؠ مےٚ راضؠ چُھو مہربٲنی کٔرِتھ واتنٲیو تیٚلہ بادشاہس نِش میٚون یہ پٲغام۔
\v 5 ییٚلہ میٚون مول مرنس تیار اوس تہٕ تمؠ کرنووُد بہٕ وعدہ زِ بہٕ واتناوٕ تمؠ سنٛز میت کنعانچہِ سرِ زمیٖنہٕ پٮ۪ٹھ تتھ قبرِ منٛز دفن کرنہٕ خٲطرٕ یۅسہ تٔمؠ پانہٕ بنٲومٕژ چھےٚ۔ لہٰذا دِی تو مےٚ مہربٲنی کٔرِتھ کنعان گژھنُک تہٕ پننِس مٲلؠ سنٛز میت تتہِ دفن کرنُک اجازت۔ پتہٕ یمہٕ بہٕ واپس۔"
\v 6 ییٚلہ بادشاہس پٲغام ووت، تٔمؠ ووٚن، "یوسفسؔ ؤنیٚو، وۅتھ کرُن پننِس مٲلؠ سنٛز میت دفن، یتھٕ پٲٹھؠ ژےٚ کرنُک وعدہ کۅرمُت چُھتھ۔"
\v 7 یتھ کٔنؠ گو یوسفؔ پننِس مٲلؠ سنٛز میت دفناونہٕ خٲطرٕ کنعان۔ بادشاہ سنٛدؠ تمام عہدٕدار، مشیر تہٕ مِصرٕکؠ کینٛہہ بزرگ لوٗکھ گےَ تمِس سٟتؠ۔
\v 8 تمسنٛدِ خاندانٕکؠ لۅکٕٹؠ شُرؠ، تیٖر، ژھاوٕلؠ تہٕ تِہنٛدؠ چاروٲے روٗدؠ جشنؔ علاقسےٕ منٛز۔ مگر یوسف سُنٛد باقی سورےٕ خاندان تمسنٛدؠ بٲے تہٕ تمسنٛدس مٲلؠ سُنٛد خاندان گو تمِس سٟتؠ۔
\v 9 رتھ تہٕ گُرؠ سوار تہِ گےَ تِمن سٟتؠ۔ یہ اوس اکھ بوٚڈ قٲفلہٕ۔
\v 10 تِم گےَ یردن دریاوٕ مشرقہٕ کِنؠ تہٕ وٲتؠ اتدؔ جایہ۔ تتہِ ٲس اکھ جایاہ یتہِ لوٗکھ اناج ژھٹان تہٕ کٔنہٕ کن بوٚس کڈان ٲسؠ۔ تتہِ کۅر تِمو یعقوبس واریہس وقتس بڈِ بڈِ ماتم۔ یوسفنؔ مناوٕ نایہ ستن دوٚہُن پننِس مٲلؠ سنٛزٕ ماتمی تقریبہٕ۔
\v 11 ییٚلہِ کنعانس منٛز روزن والیٚو لوٗکو سُہ یتھٕ کِنؠ ماتم کران وُچھ تہٕ تِمو ووٚن زِ مِصرٕ کیٚن لوٗکن باپتھ چھےٚ یہ غمٕچ جاے۔ اوٕ کِنؠ تھوو تِمو اتھ جایہ ابیل مِصرئیمؔ ناو، یمیُک مطلب عِبرٲنؠ زبانہِ منٛز مِصرِین ہُنٛد ماتم چُھ
\v 12 پتہٕ کۅر یعقوب نیٚو نیٚچیو تی یہ تِہنٛدؠ مٲلؠ تِمن ونمُت اوس۔
\v 13 دریاے یردُنس اپور تٔرِتھ واتنٲو تِمو یعقوبنؔؠ میت کنعان۔ تِمو کٔر سۅ ممرےؔ شہرٕ کِس مشرِقس منٛز مکفیلہؔ جایہ ہنٛزِ قبرِ منٛز دفن۔ یہ چھےٚ سۅے جاے یۅسہ ابرہامنؔ حِتی قبیلہٕ کِس عِفرونَس قبرِستان خٲطرٕ موٚلؠ ہیٚژٲیہ۔
\v 14 پنُن مول مدفون کرنہٕ پتہٕ دراو یوسفؔ پنٕنؠ بٲے تہٕ باقی یمہٕ تس سٟتؠ تدفین باپتھ کنعان آمٕتؠ ٲسؠ مِصر واپس۔
\p
\v 15 یعقوب مرنہٕ سپٕدؠ یوسفؔ سنٛدؠ بٲے پریشان۔ تِمن باسیاو زِ وۅنؠ کیاہ سپدِ۔ تِمو ووٚن، "تیٚلہ کیاہ بنہِ اگر یوسفؔ اسہِ سٟتؠ نفرت کرِ تہٕ اسہِ بدلہٕ ہیٚیہِ، تِمن سارنی بُرٲین ہُنٛد یمہٕ اسہِ تس سٟتؠ کینٛہہ وری برُونٛہہ ورتاوِ؟"
\v 16 اوِ کِنؠ سوز تِمو یوسفسؔ نِش کُستام یہ وننہٕ خٲطرٕ زِ، "اسہِ ووٚن مٲلؠ مرنہٕ برُونٛہہ یہ:
\v 17 یوسفسؔ ؤنیٚو، پننٮ۪ن بڈین باین دِ تِمو بُرٲیو باپتھ معٲفی یمہٕ تِمو ژےٚ سٟتؠ ورتاوِ۔ یمو چھِ چٲنؠ بٔڈؠ گناہ ہیٚتمٕتؠ۔ تکیازِ تِمو یہ ژےٚ سٟتؠ ورتومُت چُھ تہِ چُھ واریاہ غلط۔ لہٰذا چھِ وۅنؠ أسؠ، یمہٕ چٲنِس مٲلؠ سنٛدِس خدایہ سنٛدؠ بنٛدٕ چھِ، توٚہہِ ونان زِ اسہِ یہ کینٛژھا تۅٚہہِ سٟتؠ ورتومُت چُھ، تمہِ خٲطرٕ دتہٕ اسہِ معافی۔ تِہُنٛد یہ پٲغام بوزِتھ لوٚگ یوسفؔ رِیٚونہِ۔
\v 18 پتہٕ آو تمسںنٛد بۅڈ بوے پانے تہٕ ترووُن یوسفسؔ برُونٛہہ کنہِ پنُن پان پتھرِس پٮ۪ٹھ تہٕ تِمو منٛزٕ ووٚن أکؠ۔ مہربٲنی کٔرِتھ بوز! أسؠ بنو چٲنؠ خٲدم۔"
\v 19 مگر یوسفنؔ ووٚن تِمن جواب، "کھوٚژیٚو مہٕ! لوٗکن سزا دنہٕ وول چُھ خدا۔ بہٕ چُھسا خدا؟
\v 20 یۅتام تُہنٛد تعلق چُھ، آ، توٚہؠ ٲسیٚو مےٚ سٟتؠ واریاہ بُرٕ کرُن یژھان۔ مگر خداین اوس تٔتھؠ منٛز میانہِ خٲطرٕ رٕژر تھوومُت! سُہ اوس واریہن لوٗکن بۅچھِ سٟتؠ مرنہٕ نِشہ بچاوُن یژھان، تہٕ تی سپُد تہِ! از چھِ تمہٕ زنٛدٕ!
\v 21 اوے چُھسو بہٕ دبارٕ ونان زِ کھوٚژیٚو مہٕ! بہٕ بناوٕ یہ کتھ یقینی زِ توٚہہِ تہٕ تُہنٛدین بچن میلہِ کھیٚنہ خٲطرٕ کٲفی کینٛہہ۔ "یتھ کنؠ میٚول تمن تسلی ییٚلہ تٔمؠ تمن سٟتؠ کتھ کٔر۔
\v 22 یوسفؔ اوس مِصرس منٛز تۅتام مٲلؠ سنٛدِس عیالس سٟتؠ یۅتام سُہ 110 ؤرشہِ وانٛسہِ ووت۔
\v 23 سُہ رود افرائیمؔ سنٛدین شُریٚن تہٕ زُرین وُچھنہٕ باپتھ واریہس کالس زِندٕ۔ یوسفؔ سنٛدؠ زرؠ مکِیر سنٛدؠ اولاد، یُس منسیؔ سُنٛد نیٚچو اوس، زاے یوسفؔ سنٛدِ مرنہٕ برُونٛہہ، تہٕ تِم ٲسؠ تمسنٛدوےٕ اولادو رنٛگؠ زاننہٕ یوان۔
\v 24 اکہِ دوٚہہ ووٚن یوسفنؔ پننٮ۪ن زِٹھیٚن باین، "مےٚ چُھ وۅنؠ مرُن۔ مگر خدا کرِ توٚہہِ ضرور مدد۔ کُنہِ دوٚہہ کڑِ سُہ تُہنٛدین اولادن یمہِ سرِ زمیٖنہِ منٛزٕ تہٕ واتناویٚکھ کنعان، تتھ سرِ زمیٖنہِ پٮ۪ٹھ یۅسہ تٔمؠ ابرہامؔ، اسحاق تہٕ یعقوبسؔ دنُک وعدہ کۅرمُت چُھ۔"
\v 25 پتہٕ وُن یوسفنؔ، "ییٚلہ خدا توٚہہِ یہ کرنُک توفیق دییہِ تہٕ توٚہؠ نی زیٚو میانؠ میت یتہِ پٮ۪ٹھ کنعان۔ تٔمؠ ہیٚوت پننٮ۪ن بڈین باین یہ کرنُک پۅختہٕ وعدہ۔ \f + \fr 50‏:25 \ft عِبرٲنؠ 11:22\f*
\v 26 چناچہ یوسفنؔ کوٚر اکھ ہتھ تہٕ داہ ؤرشہِ وانٛسہِ منٛز مِصرس منٛز انتقال۔ تمؠ سنٛز میت آیہ خوشبو مٔلِتھ أکِس تابودس منٛز برنہٕ۔
