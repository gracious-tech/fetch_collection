\id ACT - DMT Kashmiri
\toc1 اعمال
\mt1 اعمال
\c 1
\p
\v 1 ٹاٹھِ تھیُفِلسہٕؔ،
\p پننہِ گۅڈنچہِ کتابہِ منٛز یۅسہ مےٚ چانہِ باپتھ لیٚچھ، لیٚوکھ مےٚ تِمن واریہن چیزن متعلق یمہٕ یسوعنؔ کٔرؠ تہٕ ہیٚچھنٲوؠ\f + \fr 1‏:1 \ft انجیٖلِ لوقا\f*
\v 2 تتھ دوٚہس تام ییٚلہِ سُہ خداین آسمانس پیٚٹھ نیٚو۔ آسمانس پیٚٹھ واتنہٕ برُونٛہہ پاک روح  سنٛدِ طاقتہٕ سٟتؠ کوٚر تمؠ  رسولن باپتھ تِمن  کتھن ہُنٛد انتخاب تہٕ ونہِ نکھ یمہ سُہ یژھان اوس تِمن زٲنؠ راوُن۔
\v 3 مصیبت تُلنہٕ تہٕ صلیبس پیٚٹھ مرنہٕ پتہٕ گو سُہ دوبارٕ زنٛدٕ۔ یتھ کنؠ سُہ آینٛدٕ ژتجہَن دوٚہُن اکثر ظٲہر سپدان اوس، رسولو وُچھ سُہ کٔژِ پھرِ۔ تٔمؠ دیُت تِمن مختلف طریقو باس زِ سُہ چُھ دوبارٕ زنٛدے۔ تٔمؠ کٔر تِمن یہ باوتھ زِ خدا کِتھٕ کنؠ چُھ پننہِ بادشٲہی منٛز لوٗکن ہنٛزِ زنٛدگی پیٚٹھ حکومتھ کران۔
\v 4 اکہِ دوٚہہ ییٚلہ سُہ تِمن سٟتؠ اوس تہٕ تٔمؠ ووٚن تِمن، "یروشلمہ منٛزٕ مہٕ نیریٚو۔ نیرنہٕ بجایہ کٔریٚو یتی انتظار یۅتام میٚون بب توٚہہِ پنُن روح عطا کرِ یتھٕ کنؠ تٔمؠ توٚہہِ وعدٕ کوٚرمُت چُھ۔ توٚہہِ بوزو اتھ متعلق مےٚ نِش ییٚلہ بہٕ ونان اوسسو۔ \f + \fr 1‏:4 \ft لوقا 49: 24\f*
\v 5 یوحناہنؔ دیُت لوکن آبس منٛز بپتسمہ مگر کینٛژِ دوٚہؠ پتہٕ دییہِ توٚہہِ خدا پاک روح سٟتی بپتسمہ۔ \f + \fr 1‏:5 \ft متّی 3:11\f*
\p
\v 6 اکہِ دوٚہہ ییٚلہ رسول یسوعسؔ یکہٕ وٹہٕ سمٕکھؠ تہٕ تِمو پرُوژھ تس، "اے خداوند، کیاہ توٚہؠ بٔنوا بادشاہ داوود سنٛدؠ پٲٹھؠ اسہِ اسرائیلی لوٗکن ہنٛدؠ بادشاہ۔ یُس واریاہ برُونٛہہ حکومتھ کران اوس؟
\v 7 تٔمؠ دیُت تِمن جواب، "توٚہہِ چھنہٕ سُہ وق تہٕ تِم دوٚہہ زاننٕچ ضرورت زِ یہ کر سپدِ۔ میانی ببَن چُھ یہ فٲصلہٕ کوٚرمُت زِ سُہ کر بناوِ مےٚ بادشاہ"
\v 8 مگر ییٚلہ پاک روح  توٚہہِ نِش ییہِ توٚہؠ بنیٚو مضبوط۔ پتہٕ ؤنیٚو توٚہؠ یروشلمس، یہُودیہ، سامریہ تہٕ پوٗرٕ دنیاہس منٛز لوٗکن مےٚ متعلق۔
\p
\v 9 یہ وننہٕ پتہٕ کھۅت سُہ آسمان اوبرن ووٚلُس نال تہٕ پتہٕ آو نہٕ اتھی۔ \f + \fr 1‏:9 \ft زبور 47:5\f*
\p
\v 10 باقی رسول ٲسؠ آسمانس کُن مُدے گنٛڈتھ ییٚلہ ہیٚور کُن کھسان اوس تہٕ اچانک گےَ سفید پلون منٛز ملبوس تِمن برُونٛہہ کنہِ زٕ نفر ظٲہِر۔ تِم ٲسؠ فرشتہٕ۔
\v 11 تِمو منٛزٕ ووٚن أکؠ، "اے گلیل کیٚو نفرو، توٚہہ چھنہٕ یتِتھ واریہس کالس اِستادٕ روزِتھ آسمان کُن وُچھنٕچ ضرورت۔ کُنہ دوٚہہ ییہِ یوٚہے یسوعؔ یُس خداین توٚہہِ منٛزٕ آسمان کھول، زمینس پیٚٹھ واپس۔ یہ ییہِ تِتھے کنؠ واپس یتھِ کنؠ توٚہہ وُونؠ یہ آسمانس پیٚٹھ کھسان وُچھوون"\f + \fr 1‏:11 \ft 1تھسلونینؔ 4:16\f*
\p
\v 12 ییٚلہِ دوٚنوے فرشتہٕ واپس گےَ، رسول آے زیتون پہاڑٕ پیٚٹھٕ یروشلم واپس یُس اتہِ پیٚٹھٕ کمےٕ دوٗر اوس۔ \f + \fr 1‏:12 \ft اکھ کلو میٹر\f*
\v 13 شہرس منٛز واتنہٕ پتہٕ کٔھتؠ تِم سیٚودے تمہِ مکانہٕ کِس ہیٚرمِس کمرس منٛز یتہِ تِم ٹھہرِتھ ٲسؠ۔ یِم لوٗکھ تتہِ ٲسؠ تِمن منٛز ٲسؠ پطرسؔ، یوحنا، یعقوبؔ، اندریاسؔ، فلپس، تُوماؔ، برتلمایی، متیؔ، حلفیؔ سُنٛد یعقوبؔ، شمعون زیلوتیسؔ، تہٕ یعقوبؔ ناوٕ کِس بیٚیِس فردٕ سُنٛد نیٚچو یہُوداؔ شٲمل۔
\v 14 یم سٲری رسول لٔگؠ یکہٕ وٹہٕ دُعا کرنہِ۔ تِمن سٟتؠ آسہٕ دُعا کرنس منٛز آسہ تمہ زنانہٕ تہِ یمہٕ یسوعسؔ سٟتؠ آسہٕ، بیٚیہِ یسوع سنٛز موج مریمؔ تہٕ تمسنٛدؠ لۅکٕٹؠ بٲے۔
\p
\v 15 یمن دوٚہُن سپُد پطرس پننٮ۪ن سٲتھی ایماندارن منٛزٕ کھڑا۔ تتھ جایہ ٲس یسوعؔ سنٛدین تقریباً اکِس ہتن وُہن پٲرو کارن ہنٛز اکھ جماتھ۔ تٔمؠ ووٚن،
\v 16 "میانیٚو ایماندار سٲتھیو، یِم چھِ تِم الفاظ یمہ بادشاہ داوودنؔ واریاہ برُونٛہہ صحیفن منٛز لیٚکھمٕتؠ چھِ گژھن تمسنٛدِ وننہٕ مطٲبق سپدٕنؠ۔ پاک روح اوس یہ زانان زِ یہُوداؔ ہاوِ یسوعؔ سنٛدٮ۪ن دشمنن زِ سُہ کتہِ چھُ ژھارُن تہٕ کرُن گرفتار، میول داودسؔ حوصلہٕ یِم لفظ لیٚکھنہٕ خٲطرٕ۔ \f + \fr 1‏:16 \ft زبور، 9: 41\f*
\p
\v 17 یودوے یسوعؔ ہن اسہِ باقیٚو منٛزٕ یہُوداؔ رسول سنٛدِ حثیتہٕ خدمتہٕ باپتھ مشخص، مگر یہُوداؔ اوس سُہ شخص یمؠ یسوع سنٛدین رٹن والیٚن لوٗکن وتھ ہٲو۔
\p
\v 18 یہُودی سردارو دِتؠ یہُوداہسؔ پونٛسہٕ ییٚلہ تٔمؠ تِمن یسوعسؔ دغاہ بٲزی سان دونٛکھٕ دِنُک وعدٕ کوٚر۔ پتہٕ دیُت یہُوداہنؔ تِمن سُہ رقم واپس۔ ییٚلہ یہُوداہنؔ پنُن پان پھاسہِ الوونت تروو تہٕ تمؠ سنٛز لاش آیہ زمینس پیٚٹھ پتھر لاینہٕ۔ تمِس پٔھٹ یڈ تہٕ انٛدرم آے سٲرسےٕ چھکراونہٕ۔ تہٕ یہُودؠ سردارو ہیٚوت تِمن پونٛسن زمین۔
\v 19 یروشلمس منٛز روزن والیٚو تمام لوٗکو بوز اتھ متعلق، امہِ کِنؠ کوٚر تِمو پننہِ ارامیؔ زبٲنؠ منٛز اتھ زمیٖنس ہقل دماؔ ناو تمیُک مطلب گو "خوٗنہٕ مٲدان" تکیازِ یہ ٲس سۅ جاے یتِتھ کانٛسہِ ہُنٛد موت سپُدمُت اوس۔
\p
\v 20 پطرسنؔ ووٚن یتہِ، "مےٚ وُچھ زِ یہُوداؔہس سپُد تہِ یہ زبور کتابہِ منٛز لیٚکِھتھ چُھ: "امسُنٛد گرٕ سپدِن ختم، تِمو منٛزٕ مہٕ روزِنؠ کانٛہہ تہِ پتھ کُن۔ تہٕ یتہِ چُھ باسان زِ یمہٕ باقی الفاظ یمہٕ داوودنؔ لیکھمٕتؠ چھِ تہِ چھِ یہُوداہسؔ کُن اشارٕ کران: 'کانٛسہِ بییِس کٔریٚو بحثیتِ سردار أمسنٛز کٲم تفویض'\f + \fr 1‏:20 \ft زبور109:8، 69:25 \f*۔
\p
\v 21 "لہٰذا چُھ سانہِ خٲطرٕ ضروری زِ أسؠ کروون یہُوداؔ سنٛزِ جایہ کانٛہہ بدل نفر مقرر۔ سُہ گژھِ سُہ نفر آسُن یُس ہمیشہِ اسہِ سٟتؠ رودمُت آسہ ینہٕ خداوند یسوع اسہِ سٟتؠ اوس۔
\v 22 یعنی ینہٕ پیٚٹھٕ بپتسمہ دِنہٕ وٲلؠ یوحناہن یسوعسؔ بپتسمہ دیُت، تتہِ پیٚٹھٕ یۅتام یسوع اسہِ تراوِتھ آسمان کھۅت۔ یہُوواہؔ سنٛز جاے رٹن وول نفر گژھِ اسہِ یسوعسؔ متعلق لوٗکن یہ وننَس منٛز ساتھ ہیٚکُن دِتھ زِ سُہ کِتھٕ کنؠ سپُد مرنہٕ پتہٕ بیٚیہِ زنٛدٕ۔
\v 23 یتھٕ کنؠ کٔرؠ رسولو تہٕ باقی مانن والیٚو دوٚن نفرن ہنٛدؠ ناو تجویز۔ اکھ شخص اوس یوسفؔ برسباؔ، یمِس یوستُسؔ تہِ ونان ٲسؠ۔ دویِم شخص اوس متیاہؔ۔
\p
\v 24‏-25 پتہٕ مونٛگ تِمو دُعا: " اے خداوند یسوعؔ، یہُوداؔ رود نہٕ ووٚنؠ رسول۔ تمِس گےَ گناہ سرِزد تہٕ ژوٚل تمہِ جایہ نِش یتِتھ سُہ شوبہِ ہے۔ توٚہؠ چُھو زانان زِ کس سنٛدِس دِلس منٛز کیاہ چُھ، لہٰذا ہٲوؠ تو اسہِ مہربٲنی کٔرِتھ زِ توٚہہ کُس ژورٕ وون یمو دوٚیو نفرو منٛزٕ یہُوداؔ سنٛزِ جایہِ۔
\v 26 پتہٕ تراوِ تِمو دویٚو منٛزٕ اکھ ژارنہٕ باپتھ چیٖرِ تہٕ متیاہؔ سنٛدِ ناوٕ درایہ چیٖرؠ تہٕ سُہ بنیاو باقی کہَن رسولن سٟتؠ رسول۔
\c 2
\p
\v 1 یمہ دوٚہہ یہُودؠ پنتِیکُست تہوار مناوان ٲسؠ، سٲری ایماندار ٲسؠ یروشلمس منٛز أکسےٕ جایہ منٛز جمع
\v 2 اچانک بوٗز تِمو اکھ آواز یۅسہ آسمانہ پیٚٹھٕ واوٕ طوٗفان ہِش آیہ۔ اتھ گرس منٛز موجود پرٛتھ أکؠ بوز یہ شور۔
\v 3 پتہٕ وُچھ تِمو یہ زن نارٕ لمبک ہی باسان ٲسؠ۔ یمو نارٕ لمبکو منٛزٕ آسہٕ پروٕ نیران تہٕ پرٛتھ اکِس مانن وٲلِس پیٚٹھ پیٚوان یمہٕ نارٕ لمبک دراے اکھ اکِس نِش بیٚون تہٕ بیٹھؠ پرٛتھ اکِس ایماندارس پیٚٹھ۔
\v 4 پتہٕ آے سٲری ایماندار پاک روح سٟتؠ برنہٕ تہٕ تِم لٔگؠ مختلف زبانہٕ بولنہِ یتھ قٲبل پرٛتھ اکھ روحن بنوو۔
\v 5 امہ وزِ ٲسؠ واریاہ یہُودؠ یروشلمس منٛز پنتِکُست تہوار مناوانہٕ باپتھ اتہ رُکِتھ۔ یِم یہُودؠ لوٗکھ ٲسؠ پزِ دِلہ خدایہ سنٛز عبادت کران۔ یِم آسمانس تل بیٚون بیٚون ملکو پیٚٹھٕ آمٕتؠ ٲسؠ۔
\v 6 ییٚلہِ تِمو واوٕ طوٗفان ہِش یہ تیز آواز بوز تہٕ تِہُنٛد اکھ ہجوم گو تتھ جایہ جمع یتِتھ ایماندار بہِتھ ٲسؠ۔ ہجوم سپُد حٲران تکیازِ تِمو منٛزٕ اوس پرٛتھ اکھ بوزان زِ اکھ ایمان وول چُھ تِمن سٟتؠ تہنٛزے زبٲنؠ منٛز کتھ کران۔
\v 7 تِم سپدؠ سیٚٹھاہ حٲران تہٕ لٔگؠ اکھ اکِس وننہِ، "یِم سٲری یمہٕ کتھٕ چھِ کران چھِ گلیل پیٚٹھٕ آمٕتؠ، تہٕ یمہٕ کِتھٕ ہیٚکن سانہِ زبانہٕ زٲنِتھ؟
\p
\v 8 مگر أسؠ سٲری چھِ یہُنٛد پننہِ زبانؠ منٛز بوزان یۅسہ اسہِ زینہٕ گرِ پیٚٹھٕ ہیٚچھمٕژ چھےٚ۔
\v 9 اسہِ منٛزٕ چھِ کینٛہہ پارتھی، مادی، عیلامی، مسوپتامیہؔ، یہُودیہ، کپّدُکیہ، پنطُسؔ تہٕ آسیہؔ علاقن ہنٛدؠ۔
\v 10 اتہِ چھِ کینٛہہ لوٗکھ فرُوگیہؔ، پمفیلیہؔ، مِصر تہٕ لیبیا کٮ۪ن تِمن علاقن ہنٛدؠ یمہ کرینیؔ شہرس نکھٕ چھِ۔ اسہِ منٛزٕ چھِ بیٚیہِ تہٕ کینٛہہ یمہٕ یور یروشلم رومہٕ پیٚٹھٕ آمٕتؠ چھِ۔
\v 11 یمن منٛز مقٲمی یہُودینؔ سٟتؠ سٟتؠ غٲر یہودی تہِ شٲمل چھِ یمہٕ تِمے عقیدٕکؠ چھِ یمہِ عقیدٕکؠ أسؠ یہُودی چھِ۔ کینٛہہ چھِ اسہِ منٛز تِم یمہٕ کریٹؔ جزیرٕ تہٕ عرب علاقٕکؠ چھِ۔ تہٕ یہ کِتھٕ چُھ سپدان زِ یم لوٗکھ چھِ سانہِ زبانہٕ منٛز تِمن عظیم کامیٚن متعلق بولان یمہ خداین کرِمژٕ چھےٚ؟
\p
\v 12 لوٗکھ ٲسؠ حٲران تہٕ یہ ٲسؠ نہٕ زانان زِ سپدان کیاہ چُھ۔ تِمو پرُوژھ اکھ اکِس، "اتھ کیاہ چُھ معنی؟"
\v 13 مگر یمو منٛزٕ ٲسؠ کینٛہہ تتھ پیٚٹھ مذاق کران یہ تِم وُچھان ٲسؠ۔ تِمو ووٚن، "یِم لوٗکھ چھِ تمہٕ کتھٕ کران باسان چُھ زِ یمو چُھ مٔتؠ آب چیٚمُت"
\p
\v 14 مگر پطرس ووٚتھ تِمن کہَن نبین سٟتؠ تھوٚد تہٕ لوٚگ لُکہ ہجومس سٟتؠ بڈِ کتھ کرنہِ۔ تٔمؠ ووٚن، "ہے یہُودیہ کیٚو لوٗکو تہٕ باقی یروشلمس منٛز روزن والیو، میانؠ کتھ بوزیٚو، بہٕ ونو توٚہہ زِ سپدان کیاہ چُھ۔
\v 15 توٚہہ منٛزٕ چھِ کینٛہہ سمجھان زِ أسؠ چھِ نشس منٛز مگر أسؠ چھنہٕ نشس منٛز۔ صبحچہٕ نو بجییہِ، دوٚہلہِ چُھنہٕ امہِ وقتہٕ یتہِ کانٛہہ تہِ نِشہٕ کران!
\p
\v 16 مگر امہِ بجایہ یہ کینٛژھا اسہِ سٟتؠ سپدان چُھ سُہ چُھ معجزٕ، یتھ متعلق یُوایلؔ نبین واریاہ برُونٛہہ لیٚوکھمُت چُھ۔ سُہ چُھ لیٚکھان:
\p
\v 17 "ٲخری دوٚہُن منٛز چھُ خدا فرماوان، "بہٕ دمہٕ پنُن پاک روحک سارنی لوٗکن، تہٕ تُہنٛدؠ کورِ تہٕ گۅبر بوزٕناون لوٗکن میٚون پٲغام، تہٕ بہٕ دِمہٕ جوانن رویا بصارت، تہٕ بزرگ نفر وُچھناوکھ خواب۔
\p
\v 18 تِمن دوٚہُن دمہٕ بہٕ پنُن پاک روح پننٮ۪ن خٲدمن یُتھ تِم میانؠ پٲغام لوٗکن تام واتناون۔
\v 19 بہٕ کرٕ آسمانس پیٚٹھ حٲرت کروٕنؠ چیز پیش تہٕ زمیٖنس پیٚٹھ ہاوٕ تِتھؠ معجزٕ زِ اہم تہٕ حٲرت کروٕنؠ چیز گژھن ظٲہِر۔ یتہِ آسہ زمینہِ پیٚٹھ پرٛتھ انٛدٕ خوٗن، نار تہٕ دُہُہ۔
\v 20 آسمانس پیٚٹھ ییہِ لوٗکن آفتاب گۅٹ تہٕ زوٗن خوٗنی بوزنہٕ۔ یمہٕ چیز سپدن امہِ برُونٛہہ زِ بہٕ، خداوند خدا، یمہٕ سارنی سٟتؠ انصاف کرنہٕ باپتھ۔
\v 21 تمہِ برُونٛہہ، لبَن تِم سٲری لوٗکھ نجاتھ یمہٕ مےٚ خداوندس پننٮ۪ن گناہن ہُنٛد سزا معاف کرنہٕ باپتھ ونن"\f + \fr 2‏:21 \ft یو ایل 32-2:28 \f*
\p
\v 22 پطرسنؔ تھٲو پنٕنؠ کتھ جٲری، "میانیٚو اسرائیلی سٲتھیو، میانؠ کتھ بوزیٚو! ییٚلہ ناصرتُک یسوعؔ توٚہہِ سٟتؠ روزان اوس تہٕ خداین دیُت توٚہہِ ہٲوِتھ زِ تٔمؠ سوز سُہ توٚہہِ منٛز واریاہ حٲران کروٕنؠ معجزٕ کرنس قٲبل بنٲوِتھ، یمہٕ سٟتؠ ننان چُھ زِ سُہ چُھ خداین سوزمُت۔ توٚہؠ چُھو پانہٕ زانان زِ یہ چُھ پزر۔
\v 23 حالانکہ توٚہؠ چُھو زانان زِ توٚہہِ کوٚروون سُہ نفر یسوعؔ پننٮ۪ن دشمنن حوالہٕ، مگر خداین اوس گۅڈے تمسنٛدِ باپتھ منصوبہ بنٲوِتھ تھوومُت، تہٕ سُہ اوس تمِس متعلق سورےٕ کینٛہہ زانان۔ پتہٕ کوٚرو توٚہہ تِمن لوٗکن زور یمہٕ نہٕ خدایہِ سنٛز شریعت مانان ٲسؠ زِ یسوعؔ مٲرؠ وون۔ تہٕ تِمو کوٚر سُہ صلیبس پیٚٹھ کھٲلِتھ تی۔
\v 24 سُہ گُزریو مگر خداین کوٚر سُہ بیٚیہِ زنٛدٕ تکیازِ تمسُنٛد مرُن اوس نہٕ ممکن۔ خداین کوٚر یسوع دبارٕ زنٛدٕ۔
\p
\v 25 واریاہ کال برُونٛہہ اوس بادشاہ داوودنؔ تہِ لیٚوکھمُت یہ کینٛژھا مسیحؔ ہن ووٚن،
\p 'بہٕ اوسُس زانان زِ توٚہؠ، خداوند خدا 'بوزیٚو ہمیشہٕ میٚون۔ توٚہؠ چُھو مےٚ سٟتؠ، لہٰذا کھۅژنہٕ بہٕ تِمن لوٗکن یم مےٚ نقصان واتناونٕچ کوشش کران چھِ۔
\v 26 اوٕ کِنؠ چُھس بہٕ خۅشی سان چٲنؠ تعریف کران، اے میانہ خدایہ۔ تہٕ مےٚ چُھ پوٗرٕ یقین زِ کرکھ میٚون جِسم مۅردو منٛزٕ دبارٕ زنٛدٕ۔
\v 27 توٚہؠ تھٲیو نہٕ مےٚ تتھ جایہ یتہِ مۅردٕ چھِ۔ توٚہؠ دِیو نہٕ میانِس جسمس تہِ ضایہ سپدنہٕ۔ تکیازِ بہٕ چُھس چون پاک خٲدِم تہٕ بہٕ چُھس ہمیشہ چٲنؠ فرمانبرداری کران۔
\v 28 ژےٚ، ہووُتھ مےٚ زِ ژےٚ کِتھ کٔنؠ کوٚرتھس بہٕ دوبارٕ زنٛدٕ۔ توٚہؠ تھٲیو مےٚ سیٚٹھاہ خۅش تکیازِ توٚہؠ چُھو مےٚ ہمیشہ سٟتؠ"\f + \fr 2‏:28 \ft زبور11-16:8\f*
\p
\v 29 پطرسن تھٲیو کتھ جٲری، "میانیٚو یہُودؠ سٲتھیٚو، مےٚ چُھ یقین زِ سٲنِس جدٕ بُڈؠ بب بادشاہ داوود سُنٛد انتقال چُھ سپُدمُت تہٕ لوٗکو کوٚر سُہ مقبرس منٛز دفن۔ تہٕ تمؠ سنٛز لاش چھےٚ از تہِ تتھ جایہ موجود یتہِ سُہ تِمو دفن چُھ کوٚرمُت۔
\v 30 بادشاہ داوود اوس اکھ نبی تہٕ سُہ اوس زانان زِ خداین چُھ تس وعدٕ کوٚرمُت زِ تمسنٛدیو زُریٚو منٛزٕ بنہِ اکھ بادشاہ۔ \f + \fr 2‏:30 \ft زبور 132:11 \f*
\v 31 واریاہ برُونٛہہ اوس داوودسؔ معلوم زِ خدا کیاہ کرِ۔ تٔمؠ ووٚن زِ خدا کرِ یسوع مسیحسؔ مرنہٕ پتہٕ دوبارٕ زنٛدٕ۔ خدا دییہِ نہٕ تس قبرِ منٛز روزنہٕ، تہٕ تمسُنٛد جِسم کرِنہٕ سُہ میٚژِ بُزؠ۔ \f + \fr 2‏:31 \ft زبور 16:10\f*
\p
\v 32 یسوع سنٛدِ مرنہٕ پتہٕ کوٚر خداین سُہ دُبارٕ زنٛدٕ۔ أسؠ سٲری تمسنٛدؠ پٲروکار، چھِ یہ زانان تکیازِ اسہِ چُھ سُہ وُچھمُت۔
\v 33 خداین کٔر یسوع ہَس تٔھز عنایت تہٕ بنووُن سُہ تمہِ جایہ حٲکم یتہِ سُہ آسمانس منٛز پانہٕ چُھ۔ یسوعسؔ گو پننِس بب خدایس نِش پاک روح حٲصِل، یتھ کنؠ زن خداین وعدٕ کوٚرمُت اوس۔ تہٕ یسوعنؔ کوٚر اسہِ وژھِ وٲنجہِ پاک روح عطا، تہٕ خداین کوٚر اتھ تحفس یمو چیزو سٟتؠ تصدیق یہ توٚہؠ وُچھان تہٕ بوزان چُھو۔
\v 34 أسؠ چھِ زانان زِ داوود اوس نہٕ پانس متعلق ونان تکیازِ داوود گو نہٕ یسوع سنٛدؠ پٲٹھؠ آسمان کھٔسِتھ۔ امہِ علاوٕ، ووٚن داوودنؔ پانہٕ مسیحسؔ متعلق یہ:
\q 'خداوند خداین ووٚن میانِس خداوند مسیحؔ ہس، "یتہِ کر راج یتہِ بہٕ چُھس، \f + \fr 2‏:34 \ft زبور 110:1\f*
\v 35 یۅتام بہٕ چانیٚن دشمنن پوٗرٕ پٲٹھؠ شِکس دِمہ"
\p
\v 36 پطرسنؔ واتنٲو یہ ؤنِتھ کتھ انٛدِ "لہٰذا چُھس بہٕ یژھان زِ توٚہؠ تہٕ باقی تمام اسرائیلی گژھن زانٕنؠ زِ خداین بنوو یسوع خداوند تہٕ مسیحؔ دوٚنوے، سُے یسوعؔ یُس توٚہہ صلیبس پیٚٹھ کھٲلِتھ کِلیٚو سٟتؠ بنٛد کٔرِتھ موٕرون۔
\v 37 "ییٚلہ لوکو پطرس تہٕ دویمیٚن نبین ہنٛز کتھ بوز تہٕ تِمو زون زِ تِمو چُھ غلط کوٚرمُت۔ لوٗکو ووٚن تس زِ أسؠ کیاہ کرو؟
\p
\v 38 پطرسن دیُت تِمن جواب، "توٚہہ منٛزٕ پزِ پرٛتھ أکِس پننیٚو گُنہو نِشہٕ باز یُن۔ چونکہ ووٚنؠ چُھ توٚہہ یقین سپُدمُت زِ یسوع مسیحنؔ کیاہ کوٚر تُہنٛدِ خٲطرٕ، أسؠ دِمو توٚہہ بپتسمہ، یہ ظٲہر کرنہٕ باپتھ زِ خداین کٔرؠ تُہنٛدؠ گناہ معاف، تہٕ سُہ کرٕ توٚہہ پنُن روح عطا۔
\v 39 خداین کوٚر توٚہہ، تُہنٛدین بچن تہٕ باقی تمام لوٗکن خٲطرٕ یہ کرنُک وعدٕ یم یسوعسؔ پیٚٹھ یقین چھِ تھاوان، حطاکہِ تِمن لوٗکن باپتھ تہِ یمہٕ یتہٕ پیٚٹھٕ واریاہ دور روزان چھِ۔ سون خدا، خداوند کرِ پرٛتھ کانٛسہِ تس شخصس پنُن روحٲنی طاقت عطا یمِس سُہ پنُن بننہٕ خٲطرٕ ژھانٛڈِ!"\f + \fr 2‏:39 \ft یوایل 2:32\f*
\v 40 پطرسن ووٚن واریاہ کینٛہہ تہٕ کٔرن تِمن سٟتؠ زوردار آوازِ منٛز کتھ۔ تٔمؠ ووٚن تِمن، "خدایس منٛگیٚو دُعا تاکہِ سُہ بچاوِ توٚہہ، یُتھ نہٕ سُہ توٚہہ سزا دییہِ ییٚلہِ سُہ تِمن بُرٕ لوٗکن سزا دییہِ یمو یسوع ہَس انکار کوٚر!"
\p
\v 41 ووٚنؠ یمو لوٗکو پطرس سنٛدِس پٲغامس پیٚٹھ پژھ کٔر تِمن میلہ بپتسمہ۔ تِمو منٛزٕ ٲسؠ تقریبن ترےٚ ہتھ یم امہِ دوٚہہ پٲرو کارن ہنٛدٮ۪ن صفن منٛز شٲمل گےَ۔
\v 42 تِمو کٔر نبین ہنٛزِ تعلیمہِ پیٚٹھ عمل۔ تِم سمٕکھؠ واریاہہِ پھرِ یِکہٕ وٹہٕ باقی ایماندارن، تِم ٲسؠ کھیٚوان چیٚوان تہٕ پرٛتھ دوٚہہ یکہٕ وٹہٕ عبادت کران۔
\v 43 یروشلمسؔ منٛز روزن وٲلؠ سٲری لوٗکھ ٲسؠ خدایس سیٚٹھاہ عزت تہٕ احترام کران تکیازِ رسول ٲسؠ رنٛگہ رنٛگہ معجزٕ کران۔
\v 44 تِم سٲری یمو یسوعس ایمان اوٚنمُت اوس ٲسؠ اکسےٕ کتھِ پیٚٹھ یقین تھاوان تہٕ پرٛتھ دوٚہہ اکھ أکِس سمکھان۔ تِم ٲسؠ پرٛتھ کانٛہہ چیز یُس یمِس نِش آسہ ہے پانہٕ وٲنؠ باگراوان۔
\v 45 تِمو منٛزٕ اوس وقتہٕ وقتہٕ کانٛہہ کانٛہہ فرد پنٕنؠ زمین یا پنُن بیٚیہِ کانٛہہ وراثتی چیز کٕنان، تہٕ پتہٕ تِمو پونٛسو منٛزٕ کینٛہہ پونٛسہٕ باقین تہِ دِوان تہنٛدِ ضرورتہٕ مطٲبق۔
\v 46 تِم ٲسؠ پرٛتھ دوٚہہ ہیکل کِس صحنس منٛز جمع سپدان، تہٕ پتہٕ ٲسؠ یکہٕ وٹہٕ پننٮ۪ن گرن منٛز کھیٚن کھیٚوان۔ تِم ٲسؠ خۅش آسان ییٚلہ تِم یکہٕ وٹہٕ کھیٚوان ٲسؠ، تہٕ یہ کینٛژھا تِمن نِش آسان اوس تہِ ٲسؠ تِم اکھ اکِس بٲگران۔
\v 47 ییٚلہِ تِمو تہِ کوٚر تِم ٲسؠ خدایہ سنٛدؠ حمُد پران تہٕ یروشلمٕکؠؔ باقی تمام لوٗکھ ٲسؠ تِمن عزت کران۔ یۅتام زن یِم چیز سپدان ٲسؠ خداوند یسوع اوس تۅتام تِمن لوٗکن ہنٛدِس تعدادس منٛز ہُریٚر کران یِم پننؠن گُنہن ہنٛدِ سزا نِشہٕ بچاون ٲسؠ۔
\c 3
\p
\v 1 اکہ دوٚہہ ٲسؠ پطرسؔ تہٕ یوحناؔ عبادت گاہ کہ صحنہٕ منٛزؠ پکان۔ دُپہرچہِ ترےٚ آسہٕ بجیمژٕ، یمہِ وزِ لوٗکھ تتہِ عبادت کران ٲسؠ۔
\v 2 اتہِ اوس اکھ نفر یُس زیٚنہٕ گرِ پیٚٹھےَ پٔکِتھ اوس نہٕ ہیٚکان۔ سُہ اوس عبادت گاہَس انٛدر اژنہٕ کِس تتھ دروازس نِش بہِتھ یتھ خوبصورت دروازٕ ونان ٲسؠ۔ تس ٲسؠ لوٗکھ پرٛتھ دوٚہہ تتھ دروازس نِش نِوان یُتھ زن سُہ عبادت گاہس منٛز اژن والیٚن کینٛہہ پونٛسہٕ منٛگِتھ ہیٚکہِ ہے۔
\p
\v 3 ییٚلہِ پطرسؔ تہٕ یوحناؔ عبادت گاہس منٛز اژنہِ لٔگؠ تہٕ تٔمؠ لٲگؠ تِمن پونٛسہٕ منٛگٕنؠ۔
\p
\v 4 یِتھُےٕ پطرس تہٕ یوحنا تمِس سیٚدِ سیٚود وُچھنہِ لٔگؠ تہٕ پطرسؔ لُگ تمِس وننہِ، "اسہِ کُن وُچھ"
\v 5 سُہ لوٚگ تِمن کُن یتھ امید پیٚٹھ وُچھنہِ زِ یِم دِنم پوٗنٛسہٕ۔
\v 6 پتہٕ ووٚنُس پطرسنؔ، "مےٚ چھی نہٕ سۅن یا پونٛسہٕ ووٚنؠ اگر بہٕ چانہِ خٲطرٕ کینٛہہ کٔرِتھ ہیٚکہٕ بہٕ کرٕ تہِ ضروٗر۔ ناصرتکِس یسوع مسیحؔ سنٛدِ ناوٕ میولےٕ ژےٚ شِفا۔ وۅتھ پکھ!"
\p
\v 7 پتہٕ کٔر پطرسن أمِس نفرس تھوٚد وتھنس منٛز مدد کرنہٕ باپتھ دٔچھنِس اتھس تھپھ۔ أتھؠ دوران پھیٚور أمِس کھۅرن تہٕ کۅٹھیٚن زُوو۔
\v 8 سُہ ووٚتھ یکدم تھوٚد تہٕ لوٚگ پکنہِ۔ پتہٕ ژاو سُہ پطرسؔ تہٕ یوحناؔ ہس سٟتؠ عبادت گاہ کِس صحنس منٛز، پکان پکان، وۅٹہٕ تُلان تہٕ خدایس کُن شُکر کران۔
\p
\v 9 عبادت گاہس منٛز موجود تمام لوٗکو وُچھ سُہ پکان تہٕ خدایس کُن شکُر پران۔
\v 10 تِمو پرزٕ نوو سُہ ز یہ چُھ سُے نفر یُس عبادت گاہ کہ صحنہٕ کِس خوبصوٗرت دروازس پیٚٹھ لوٗکن اتھٕ داران اوس۔ مگر اتہِ موجود تمام لوٗکھ سپٕدؠ سیٚٹھاہ حٲران زِ أمِس سٟتؠ کیاہ سپُد۔
\p
\v 11 یہ نفر اوس پطرسؔس تہٕ یوحنا ہس لٲرِتھ گومُت، تہٕ سٲری لوٗکھ ٲسؠ تیتؠ حٲران زِ تِم ٲسؠ نہٕ کِہین سونچِتھ ہیٚکان۔ لہٰذا گےَ تِم دوران دوران عبادت گاہ کِس صحنس منٛز موجود سلیمانؔ ناوٕ کِس برانٛدس نزدیک تس نِش۔
\p
\v 12 ییٚلہ پطرسن لوٗکھ سمان وُچھ تہٕ تٔمؠ ووٚن تِمن، "میانیٚو اسرائیلی سٲتھیو! توٚہہِ پزِ نہٕ اتھ کتھِ پیٚٹھ حٲران سپدُن زِ أمِس نفرس سٟتؠ کیاہ سپُد۔ توٚہؠ چُھو اسہِ کُن تِتھ کٔنؠ وُچھان زنتہٕ اسی چُھ أمِس نفرس پکنُک طاقت عطا کوٚرمُت؟
\v 13 لہٰذا ونو بہٕ توٚہہِ زِ اصلی کیاہ سپُد۔ سانؠ جدٕ اجداد یمن منٛز ابرہامؔ، اضحاقؔ، تہٕ یعقوبؔ ٲسؠ خدایہ سنٛز عبادت کران۔ تہٕ ووٚنؠ دیُت خداین یسوعسؔ سیٚٹھاہ اۅبروے، یمؠ وفادٲری سان تمؠ سنٛز خدمت کٔر۔ تُہنٛدیٚو زٹھیٚو نیٚو یسوعؔ گورنر پیلاطسسؔ نِش تاکہِ تمسنٛدؠ سِپاہ کرٕہن تس قتٕل۔ توٚہی چُھو تِم یمو پیلاطسؔ سنٛزِ موجودگی منٛز یسوعسؔ انکار کوٚر، یمہِ وزِ پیلاطسنؔ یسوعؔ یلہٕ تراونُک فٲصلہٕ کوٚر
\v 14 یودوے زن یسوع اسرائیل ین پنُن مسیح تہٕ وتہٕ ہاوُک اوس، مگر توٚہہِ کوٚروون سُہ رد تہٕ توٚہہِ ونُو تس تمہِ بجایہ اکھ قٲتِل یلہٕ تراونہٕ باپتھ!
\p
\v 15 خداین زون زِ توٚہہِ مورٕوون یسوعؔ، یُس لوٗکن ابدی زندگی دِوان چُھ۔ مگر خداین کوٚر سُہ دوبارٕ زنٛدٕ۔ اسہِ وُچھ یسوعؔ دوبارٕ زنٛدٕ گژھنہٕ پتہٕ کٲتہِ پھرِ۔
\v 16 یہ چُھ اوٕ موکھٕ تکیازِ اسہِ کوٚر اتھ پیٚٹھ بھروسہٕ زِ یسوع کیاہ کرِ، تٔمؠ کوٚر سُہ نفر یُس توٚہؠ زٲنؠ وون تہٕ وُچھان چھون دوبارٕ پننٮ۪ن زنٛگن پیٚٹھ کھڑا۔ آ، یہ سپُد اوٕ موکھٕ تکیازِ اسہِ کوٚر یسوعسؔ پیٚٹھ بھروسہٕ تہٕ تٔمؠ کوٚر سُہ نفر توٚہہِ سارنی ہاونہٕ باپتھ مکمل پٲٹھؠ ٹھیک۔
\p
\v 17 میانیٚو ہم وطنو، ووٚنؠ چُھس بہٕ زانان زِ توٚہہِ تہٕ تُہنٛدیٚو سردارو ژُھن یسوع مٲرِتھ تکیازِ توٚہہ ٲسو نہٕ پےِ زٕ سُہ چُھ مسیح۔
\v 18 ووٚنؠ کٔر خداین سۅ کتھ مکمل یۅسہ تٔمؠ واریاہ برُونٛہہ نبین پیٚٹھ ظٲہر کٔرمٕژ ٲس۔ زِ لوٗکھ واتناون یسوعؔس موتہٕ کِس انجامس۔ خداین ووٚن سارنی نبین زِ مسیحؔ چُھ خدایہ سنٛدِ طرفہٕ سوزنہٕ آمُت، یُس مصیبت تُلنہٕ پتہٕ مرِ۔
\p
\v 19 لہٰذا پھیریٚو گناہ گار زنٛدگِیو نِشہٕ باز تہٕ خدایس منٛگیٚو زِ سُہ کرِ توٚہہِ تِمہ کامہِ کرنس منٛز مدد یمہٕ تس پسنٛد چھےٚ تاکہ سُہ کرِ تُہنٛدؠ گناہ مکمل پٲٹھؠ توٚہہِ معاف تہٕ بیٚیہِ دِیو مذید تقوِیت۔
\v 20 اگر توٚہؠ تہِ کٔریٚو، تیٚلہ ییہِ سُہ وقت ضرور ییٚلہِ توٚہؠ زٲنیٚو زِ خداوند خدا چُھ توٚہہِ مدد کران۔ تہٕ کُنہِ دوٚہہ سوزِ سُہ مسیحسؔ ضرور دوبارٕ زمینس پیٚٹھ۔ یُس تٔمؠ توٚہہ دیُتمُت چُھ۔ سُہ شخص چُھ یسوع۔ \f + \fr 3‏:20 \ft امیُک مطلب چُھ نوِرُک سُہ زمانہٕ یتھ دوران خدا انسٲنؠ روحس پوچھر دِوان چُھ۔ \f*
\p
\v 21 یسوع روزِ پٔزؠ پٲٹھؠ تۅتام آسمانس پیٚٹھ یۅتام خدا تہِ سورےٕ نوِ بناوِ یہ کینٛژھا تٔمؠ بنوومُت چُھ۔ خداین چُھ واریاہ برُونٛہہ یہ کرنُک وعدٕ کوٚرمُت، تہٕ تٔمؠ چھِ لوٗکن یہ وننہٕ خٲطرٕ پاک نبی ژٲرمٕتؠ۔
\v 22 مثلن، نبی موسیٰؔ ہَن چُھ مسیحؔ ہس متعلق یہ ونمُت: " تُہنٛد خدا، خداوند سوزِ توٚہے منٛزٕ مےٚ ہیٚوٗ اکھ نبی۔ توٚہہِ پزِ تہِ سورےٕ بوزُن یہ سُہ توٚہہِ ونہِ۔
\v 23 یِم نہٕ تمِس نبی سنٛز عبادت کرَن تہٕ کتھ مانن تِم روزن نہٕ خدا سنٛدین بنٛدن منٛزٕ تہٕ خدا کرِ تِمن نابود"
\p
\v 24 پطرسنؔ ووٚن بیٚیہِ، "ساروےٕ رسولو ووٚن اتھ متعلق زِ یمن دوٚہُن کیاہ سپدِ۔ تِمن نبین منٛز ٲسؠ سموئیلؔ تہٕ بیٚیہِ تہِ کینٛہہ شٲمل یمو پتہٕ ووٚن یمن واقٕہَن متعلق یمہٕ واقہٕ سپدنہٕ برونٛہےٕ۔
\v 25 یہِ نبیو واریاہ کال برونہٛہ ووٚن چھُ توٚہہِ پیٚٹھ عٲید سپدان۔ ییٚلہ خداین سانٮ۪ن جدٕ اجدادن برکت دِنُک مکمل وعدٕ کوٚر تہٕ تٔمؠ کوٚر توٚہہِ تہِ پٔزؠ پٲٹھؠ برکت دِنُک وعدٕ۔ تٔمؠ ووٚن ابرہامسؔ مسیحؔ ہس متعلق زِ، "بہٕ کرٕ زمینس پیٚٹھ تمام لوٗکن چانیٚن اولادن ہنٛدِ ذرؠ یہ برکت عطا"\f + \fr 3‏:25 \ft پیدٲیش12:3، 18:18، 22:18، 26:4 \f*
\v 26 ٲخرس ووٚتھ پطرسؔ، "لہٰذا ییٚلہ خدا پننِس خٲدم یسوعسؔ زمینس پیٚٹھ بحثیتِ مسیحؔ سوزِ سُہ سوزِ گۅڈٕ تمِس بنی اسرائیل ین نِش برکت دِنہٕ باپتھ، تاکہ تِم رکاون توٚہہِ بُرٕ کامیٚو نِشہٕ۔
\c 4
\p
\v 1 أتھؠ دوران ٲسؠ ہیکل کِس صحنس منٛز کینٛہہ کاہن موجود۔   اتہِ ٲسؠ عبادت گاہٕکؠ ذمہ دار عہدٕدار تہٕ صدوقی جمٲژ ہنٛدؠ کینٛہہ لوٗکھ تہِ۔   یِم سٲری لوٗکھ آے پطرس تہٕ یوحناہسؔ نِش ییٚلہ تِم دوٚنوے باقی لوٗکن سٟتؠ کتھٕ ٲسؠ کران۔  
\v 2 یِمن لوٗکن اوس سیٚٹھاہ شرارتھ تکیازِ یِم دونوے رسول ٲسؠ لوٗکن یسوعسؔ متعلق تعلیم دِوان۔   تِم کیاہ ٲسؠ تِمن ونان زِ خداین کوٚر مرنہٕ پتہٕ یسوع دوبارٕ زنٛدٕ۔  
\v 3 تہٕ تِمو لوٗکو أنؠ پطرس تہٕ یوحناؔ گِرفتار کٔرِتھ تہٕ بٔرِکھ جیل۔   یہُودؠ کونسلس پیٚو پطرسس تہٕ یوحنا ہس پرژھٕ گٲرِ باپتھ دوٚیمِس دوٚہس تام پرارُن تکیازِ امہِ ساعتہٕ اوس شامُک وق۔  
\v 4 حالانکہ واریہو لوٗکو یمو پطرس سنٛز کتھ بوزمٕژ ٲس اوس یسوعسؔ پیٚٹھ ایمان اوٚنمُت۔   یسوعسؔ پیٚٹھ ایمان انن والیٚن مردن ہُنٛد تعداد اوس تقریبن پانٛژن ساسن تام ووتمُت۔  
\p
\v 5 دویمہِ دوٚہہ أنؠ سردار کاہنن باقی کاہن سردار،  یہُودؠ شریعتٕکؠ معلِم تہٕ یہُودؠ کونٛسلٕکؠ باقی رُکن بُلٲوِتھ تہٕ گےَ یروشلمس منٛز أکِس جایہ جمع۔  
\v 6 اننیاس یُس پرُون سردار کاہن اوس اوس تتہِ موجود۔   بیٚیہِ ٲسؠ تتہِ نٔوؠ سردار کاہن کایفا،  یوحنا،  سکندر تہٕ باقی نفر تہِ یم سردار کاہنس سٟتؠ رشتہٕ ٲسؠ تھاوان۔  
\v 7 تِمو دیُت رٲچھ درن حکم زِ تِم انن پطرس تہٕ یوحناہسؔ کمرس منٛز،  پتہٕ پرُوژھ تِمو پطرسس تہٕ یوحناہسؔ،  "توٚہہِ کٔمؠ چُھ یہ اختیار دیُتمُت زِ توٚہؠ کٔریٚو تس شِفا یُس نہٕ پٔکتھےٕ ہیٚکان چُھ؟
\p
\v 8 زنتہٕ پاک روحن پطرسس ہمتھ دِژ،  پطرسن ووٚن تمِس،  "توٚہؠ اسہِ پیٚٹھ حکومت کرن والیٚو اسرائیل یو،  تہٕ توٚہؠ تمام بزرگ بوزیٚو میانؠ کتھ!
\v 9 از چُھو توٚہؠ اسہِ تتھ نیک کامہِ متعلق سوال کران یۅسہ اسہِ تِتھِس أکِس نفرس سٟتؠ کٔر یُس نہٕ پٔکِتھ ہیٚکان اوس تہٕ توٚہؠ چُھوا اسہِ پرِژھان زِ سُہ کِتھٕ کنؠ گو ٹھیک؟ اوٕ کِنؠ چُھسو بہٕ توٚہہِ تہٕ باقی تمام اسرائیل ین یہ ونان:
\v 10 ووٚنؠ چھِ أسؠ یژھان زِ توٚہؠ تہٕ سٲنؠ باقی سٲری اسرائیلی سٲتھی زانن یہ: یہ سپُد اوٕ موٚکھٕ تکیازِ ناصرتٕکؠ یسوع مسیحنؔ دیُت أمِس شفا تہٕ یہ نفر گو توٚہہِ برُونٛہہ کنہِ تھوٚد وتُھن لایکھ۔   خدا چُھ زانان زِ یہ ٲسیٚو توٚہی یمو یسوع صلیبس پیٚٹھ کِلیٚو سٟتؠ بنٛد تھوو،  مگر خداین کوٚر سُہ موٚردو منٛزٕ دوبارٕ زنٛدٕ۔  
\p
\v 11 مسیحؔ ناصری چُھ سُہ یمِس متعلق صحیفہ ونان چھِ:
\q 'یۅسہ کٔنؠ تعمیر کارو ترٲوِتھ ژھنؠ سۅ بنییہِ عمارژ ہنٛز ساروےٕ کھۅتہٕ اہم کٔنؠ، \f + \fr 4‏:11 \ft زبور 118:22،  دانیال35- 2:34 \f*
\v 12 صرف ہیٚکہِ اسہِ یسوعؔ بچٲوِتھ' تکیازِ خداین دیُت نہٕ اسہِ دنیاہس منٛز بیٚیہِ کانٛہہ نفر یُس اسہِ سانیٚو گُنہو نِشہٕ نجاتھ ہیٚکہِ دِتھ!
\p
\v 13 یہُودؠ سردارن توٚر فِکرِ زِ پطرس تہٕ یوحنا چھنہٕ اسہِ کھۅژان۔   تِمن باسیاو یتہِ زِ یِم دوٚنوے چھِ عام نفر یمو نہٕ کُنہِ مدرسس منٛز پوٚرمُت چُھ۔   مگر یِم زِٹھؠ سپٕدؠ حٲران۔   تِم ٲسؠ زانان زِ یِم چھِ یسوع سنٛدِس صحبتس منٛز رودؠ مٕتؠ۔  
\v 14 تِمو وُچھ سُہ نفر تہِ پطرس تہٕ یوحناہسؔ سٟتؠ کھڑا یُس ٹھیک اوس سپُدمُت،  امہِ کِنؠ ووٚن نہٕ تِمو تِمن خلاف کِہین۔  
\p
\v 15 یہُودؠ سردارو ووٚن رٲچھ درن زِ تِم نِن پطرس،  یوحنا تہٕ تس صحت یاب نفرس یمہِ کمرٕ منٛزٕ نیٚبر یتہِ تِم کتھ باتھ کران ٲسؠ۔   تہنٛدِ یہ کرنہٕ پتہٕ کوٚر قٲیدو پطرسس تہٕ یوحناہسؔ متعلق اکھ أکِس سٟتؠ مشورٕ۔  
\v 16 تِمو ووٚن اکھ اکِس،  "أسؠ ہیٚکو نہٕ یمن نفرن سزا دنہٕ باپتھ کِہین کٔرِتھ۔   پرٛتھ کانٛہہ شخص یُس یروشلمس منٛز روزان چُھ،  چُھ زانان زِ یمو کوٚر اکھ حٲران کرن وول معجزٕ،  لہٰذا ہیٚکو نہٕ أسؠ لوٗکن ؤنِتھ زِ یتھ کنؠ سپُد نہٕ!
\v 17 حالانکہ اسہِ پزِنہٕ باقی لوٗکن یہ بوزنُک موقہٕ دیُن زِ تِم کیاہ تعلیم چھِ یسوعسؔ متعلق دِوان۔   لہٰذا پزِ اسہِ یمن نفرن ونُن زِ أسؠ دِمو توٚہہِ سزا اگر توٚہؠ لوٗکن تس شخصس متعلق ؤنیٚو یمِس متعلق توٚہؠ ونان چُھو زِ تٔمؠ دیُت اسہِ یمِس نفرس شِفا دِنُک طاقت
\p
\v 18 چناچہِ یہُودؠ زِٹھیٚو ووٚن رٲچھ درن زِ یم دوٚنوے رسول أنووکھ بیٚیہِ یتھؠ کمرس منٛز واپس۔   ییٚلہ رٲچھ درو یہ کوٚر،  تِمو ووٚن تِمن دوٚنونی زِ ووٚنؠ ونن نہٕ تِم کانٛسہِ یسوعسؔ متعلق کانٛہہ کتھ تہٕ نہ تمؠ سنٛز تعلیم۔  
\p
\v 19 مگر پطرسؔ تہٕ یوحنا ؤتھؠ در جواب،  کیاہ خدا ہیٚکیا یہ تصور کٔرتھ زِ أسؠ مانو تُہنٛز کتھ تہٕ تمؠ سنٛز کتھ مانو نہٕ؟ أسؠ تراوو یہ فٲصلہٕ توٚہے پیٚٹھ زِ توٚہؠ کیاہ ؤنیٚو،  کیاہ گژھِ جان۔  
\v 20 مگر یۅتام سون زانُن چُھ أسؠ مانو نہٕ تُہنٛز کتھ۔   أسؠ تراوو نہٕ لوٗکن تِمن چیزن متعلق ونُن یہ اسہِ یسوع کران وُچھ تہٕ یہ اسہِ تٔمؠ ہیٚچھنہٕ خٲطرٕ ووٚن۔  
\p
\v 21 پتہٕ ووٚن یہُودؠ سردارو پطرسس تہٕ یوحناہسؔ بیٚیہِ سٲنؠ نافرمٲنی مہٕ کٔریٚو،  مگر تِمو ہیٚوک نہٕ یہ فٲصلہٕ نِتھ زِ یمن دِمو سزا تکیازِ یروشلمٕکؠؔ سٲری لوٗکھ ٲسؠ خدایہ سنٛدؠ تعریف کران زِ أمِس نفرس سٟتؠ کیاہ سپُد یُس نہٕ پٔکِتھ اوس ہیٚکان۔  
\v 22 یمس نفرس پیٚٹھ شفاتُک یہ معجزٕ ہاونہٕ آو تمسنٛز وانٛس ٲس ژتجی ؤری پیٚٹھی۔  
\p
\v 23 ییٚلہ پطرس تہٕ یوحنا امہ مجلسہِ منٛزٕ دراے،  تِم گے بیین ایماندارن نِش تہٕ ونُکھ تِمن تہِ سورےٕ سردار کاہنن تہِ یہُودؠ بزرگو تِمن ووٚن۔  
\v 24 ییٚلہ مانن والیٚو یہ بوز،  تِمو مون تہٕ مونٛگکھ یکہٕ وٹہٕ خدایس دُعا،  "اے سانہِ خدا ونٛدٕ! ژےٚ کٔرِتھ آسمان،  زمین،  سمندر تہٕ یمن منٛز موجود تمام چیز پٲدٕ۔  
\v 25 پاک روحن  کٔرؠ سٲنؠ جدٕ اجداد خٲدم،  بادشاہ داوود یُس تُہنٛز عبادت کران اوس کوٚر یِم الفاظ لیٚکھنس پیٚٹھ آمادٕ:
\q دنیاوی لوٗکن ہنٛزٕ جمٲژ کیازِ سپزٕ ناراض
\q تہٕ اسرائیلی لوٗکو کیازِ بنٲوؠ خدایس خلاف بیکار منصوبہ؟
\q
\v 26 دنیاوی بادشاہ گے خدایہ سنٛدین حٲکمن سٟتؠ لڑنہٕ خٲطرٕ تیار، 
\q تہٕ حٲکم لٔگؠ تِمن سٟتؠ رٔلِتھ خداوند خدایہ سنٛز مخالفت کرنہِ یُس تٔمؠ بحثیتِ مسیح ژورمُت اوس۔  \f + \fr 4‏:26 \ft زبور 2-2:1\f*
\p
\v 27 یہ چُھ پوٚز! ہیرودیسؔ تہٕ پنطیس پیلاطس دوٚنوے رلیاے غٲر یہُودی تہٕ اسرائیلی لوٗکن سٟتؠ اتھ شہرس منٛز یسوعؔ ہَس خلاف،  یُس ژےٚ،  خداین بحثیتِ مسیح خدمتہٕ خٲطرٕ ژورمُت اوستھن۔  
\v 28 توٚہہِ دِتو تِمن یہ کرنُک اجازت تکیازِ توٚہہِ اوسو واریاہ برُونٛہہ فٲصلہٕ کوٚرمُت یہ سپدِ۔  \f + \fr 4‏:28 \ft یسعیاہؔ 61:1 \f*
\p
\v 29 لہٰذا بوز تہٕ وۅنؠ اے خداوندٕ یِم کیاہ چھِ ونان زِ تِم کِتھ کنؠ دِن اسہِ سزا۔   اسہِ کر مدد،  یِم تُہنٛز خدمت یسوعسؔ متعلق تمام لوکن زان دِتھ کران چھِ!
\v 30 پننِس پاک خٲدم یسوع  سنٛدِس ناوس پیٚٹھ کٔریٚو شفاتٕکؠ عظیم معجزٕ،  نشانیہٕ تہٕ عجوبہٕ ہاونہٕ باپتھ پننہِ طاقتُک مظاہرٕ"
\p
\v 31 ییٚلہِ ایمان وٲلؠ دُعا نِشہٕ فارغ سپدؠ تہٕ سۅ جاے الییہِ یتِتھ تِم بہِتھ ٲسؠ۔   روح القدسن کوٚر تِمن سُہ طاقت عطا زِ تِمو کوٚر سیٚٹھاہ دلیری سان تِمن کتھن ہُنٛد اعلان یمہٕ خداین تِمن وننہِ باپتھ ونمُت اوس۔   یہ چُھ تہِ یہِ تِمو کوٚر۔  
\p
\v 32 یمو لوٗکو یسوعسؔ پیٚٹھ ایمان اوٚنمُت اوس ٲسؠ یتھ کتھِ پیٚٹھ پۅختہٕ یقین تھاوان زِ تِم کیاہ چھِ سونچان تہٕ کیاہ چھِ یژھان۔   تِمو منٛزٕ ووٚن نہٕ کانٛسہِ تہِ یہ زِ سُہ چُھ کُنےٕ زۅن کُنہِ چیزُک مٲلکھ۔   تمہِ بجایہ بٲگرؠ تِمو اکھ أکِس سٟتؠ تِم سٲری چیز یمہٕ تِمن نِش ٲسؠ۔  
\v 33 رسول ٲسؠ باقین زور دِتھ ونان زِ خداین کوٚر خداوند یسوع مرنہٕ پتہٕ بیٚیہِ زنٛدٕ۔   تہٕ خدا چُھ تمام مانن والین بے لوٗث فضل کران۔  
\p
\v 34 کینٛہہ ایمانہٕ وٲلؠ یمن نِش زمین تہٕ مکانہٕ ٲسؠ،  ٲسؠ کُنہِ وزِ پنُن کینٛہہ جاداد خرچاوان۔   پتہٕ ٲسؠ سُہ رقم انان یمہِ باپتھ کٕنان ٲسؠ۔  
\v 35 تہٕ سُہ رقم ٲسؠ رسولن پیش کران۔   پتہٕ ٲسؠ رسول کانٛسہِ تہِ ضرورت منٛد ایمانہٕ وٲلِس پونٛسہٕ دِوان۔   لہٰذا ٲس نہٕ کانٛسہِ تہِ ایمانہٕ وٲلِس کُنہِ چیزٕچ کٔمی۔  
\v 36 ووٚنؠ اوس تتہِ اکھ نفر یمِس یوسف ناو اوس،  سُہ اوس لاوی قبیلُک کپرَس کہِ جزیرٕ پیٚٹھٕ آمُت۔   رسولن ووٚن تس برنباس۔   یہُودؠ زبٲنؠ منٛز چُھ امہِ ناوُک مطلب سُہ شخص یُس ہمیشہٕ دوٚیمٮ۪ن ہنٛز حوصلہٕ افزائی کران چُھ۔  
\v 37 تٔمؠ کُن اکھ زمینہٕ ٹُکرٕ تہٕ پونٛسہٕ أنِن رسولن نِش تاکہ تِم باگراون باقی ایمان والیٚن منٛز۔
\c 5
\p
\v 1 ووٚنؠ اوس ایمان والیٚو منٛزٕ اکھ یمسُنٛد ناو حننیاہؔ اوس تہٕ تمؠ سنٛزٕ خاندارنہِ اوس صفیراؔ ناو۔   تٔمؠ تہِ خرچٲو کینٛہہ زمین۔  
\v 2 تٔمؠ تھوو پانس نِش زمین کہ امہِ رقمہٕ منٛزٕ کینٛہہ پونٛسہٕ پانس کِتؠ یہ زن تمؠ سنٛزٕ خاندارنہٕ پےَ اوس زِ تٔمؠ کیاہ کوٚر۔   پتہٕ آو سُہ باقی رقم ہیٚتھ تہٕ کوٚرُن رسولن حوالہٕ۔  
\p
\v 3 پتہٕ ووٚنُس پطرسن،  "حننیاہؔ،  ژےٚ دِتُتھ شیطانس پانس پیٚٹھ غٲلب سپدنہٕ تکیازِ ژےٚ کٔرتھ روح القدسس دونٛکھٕ دِنٕچ کوشش۔   ژےٚ پٔزؠ ہی نہٕ بُرٕ کام کرٕنؠ۔   زمین کٕنِتھ حٲصل کرنہٕ آمتہِ رقمہٕ منٛزٕ تھووُتھ ژےٚ کینٛہہ رقم پانس نِشہٕ۔   ژےٚ دِتُتھ نہٕ تہِ سورےٕ اسہِ۔  
\v 4 امہ برُونٛہہ زِ ژےٚ کنُتھ یہ زمین،  اوسکھ ژٕ پٔزؠ کِنؠ امیُک مٲلکھ۔   تہٕ ووٚنؠ یہ کٕننہٕ پتہٕ تہِ اوس یہ رقم چونےٕ۔   لہٰذا اوسےٕ نہٕ ژےٚ زانٛہہ تہِ یژھِ کمزوری متعلق سونٛچُن۔   ژےٚ کٔرتھ نہٕ صرف اسہِ دونٛکھٕ دِنٕچ کوشش! نہ،  ژےٚ کٔرتھ سیٚدِ سیٚود خدایس دونٛکھٕ دِنٕچ کوشش!
\v 5 ییٚلہ حننیاہنؔ یمہٕ کتھٕ بوزٕ،  سُہ پیٚو یکدم پتھر تہٕ مود۔   تہٕ یمو لوٗکو حننیاہؔ سنٛدِ مرنٕچ خبر بوز تِمن ژاو ہٲبتھ۔  
\v 6 کینٛہہ جوان آے برُونٛہہ کُن تہٕ نِیکھ یہ لاش ژادرِ ؤلِتھ نیٚبر تہٕ کٔرکھ دفن۔  
\p
\v 7 لگ بگ ترےٚ گنٹہٕ گٔژِھتھ آیہ تمؠ سنٛز خاندارِنؠ،  مگر تمِس اوس نہٕ پتہےٕ زِ سپُد کیاہ۔  
\v 8 پتہٕ ہوو پطرسنؔ تمِس سُہ رقم یُس حننیاہنؔ اونمُت اوس تہٕ پرُژھنس،  "مےٚ ونتہٕ،  کیاہ یہ چھا سُہ رقم یُس زمینس بدل توٚہہِ دوٚیو بٲژو روٹ؟" تمہِ ووٚن،  "آ،  یہ چُھ تی یہ اسہِ میول"
\p
\v 9 پطرسن ووٚن تس،  "توٚہہ دوٚنویو کٔرو سیٚٹھاہ بُرٕ کٲم۔   توٚہہ دونوٕیو کوٚرو خداوند سنٛدِس روحَس دونٛکھٕ دِنس پیٚٹھ اتفاق! بوز! ژٕ ہیٚککھ ہُمن نفرن ہنٛدین قدمن ہنٛز آواز بوزِتھ یمو چون خاندار دفن کوٚر۔   تِم چھِ بلکل یتھ دروازس نیٚبرٕ کنہِ،  تہٕ تِم نِنے ژیتہِ وُنؠ نیٚبر۔  
\v 10 أتھؠ سٟتؠ پییہِ صفیراؔ تہِ پطرس سنٛدین کھۅرن برُونٛہہ کنہِ تہٕ مویہ۔   پتہٕ ژاے تِم نوجوان اندر تہٕ یتُھے اتہِ وُچھکھ سۅتہِ ممٕژ تہٕ تِمو کٔڈ تمؠ سنٛز لاش نیٚبر تہٕ کٔرکھ پننِس خاندارس نِش دفن۔  
\p
\v 11 یروشلمٕکؠؔ سٲری ایمان وٲلؠ سپٕدؠ امہِ سٟتؠ سیٚٹھاہ خوفزدٕ یہ خداین حننیاہسؔ تہٕ صفیراہسؔ سٟتؠ کوٚر۔   تہٕ باقی سٲری یمو یہ کتھ بوز تِمن تہٕ گو ہٲبتھ۔  
\p
\v 12 خدا اوس نبین واریاہ حٲرت انگیز معجزٕ کرناوان یُتھ زن تِم لوٗکن منٛز تمہِ پزرٕچ منٲدی کرٕہن۔   تمام ایمان وٲلؠ ٲسؠ عبادت گاہ کِس صحنس منٛز تتھ جایہ ہیٚتھےٕ مجلسہٕ کران یتھ سلیمان سُنٛد بیٹھک ونان ٲسؠ۔  
\v 13 باقی تمام لوٗکھ یمہ نہٕ یسوعسؔ پیٚٹھ پژھ کران ٲسؠ،  ٲسؠ ایمان والین سٟتؠ روزنس کھۅژان۔   تاہم ٲسؠ تِم ایمان والیٚن سیٚٹھاہ عزت کران۔  
\p
\v 14 تہٕ واریہو مردو تہٕ زنیٚو اوٚن خدا وند یسوعسؔ پیٚٹھ ایمان تہٕ گے ایمان والیٚن ہنٛزِ جمٲژ منٛز شٲمل۔  
\v 15 نتیجہ دراو یہ زِ لوٗکھ ٲسؠ بٮ۪مارن سڑکو پیٚٹھٕ تُلِتھ چارپاین تہٕ پتجن پیٚٹھ تراوان یُتھ زن پطرس اپٲرؠ نیرنہٕ وزِ کانٛسہِ پیٚٹھ کمس کم تمسُنٛد سایہ پییہِ تہٕ شِفا یاب سپدِ۔  
\v 16 یروشلمس نکھٕ شہرو پیٚٹھٕ تہِ وس لوٗکن ہُنٛد اکھ بوٚڈ ہجوم یِمن نبین نِش واتان۔   تِم ٲسؠ بٮ۪مارن تہٕ تِمن لوٗکن انان یمن بد روح پرَکس ٲسؠ ژامٕتؠ،  تہٕ خداین کوٚر تِمن سارنےٕ شفا۔  
\p
\v 17 پتہٕ لٔگؠ سردار کاہن تہٕ باقی یِم تس سٟتؠ ٲسؠ یعنی تِم سٲری صدوقی فِرقس سٟتؠ تعلق تھاوان وٲلؠ،  نبین سٟتؠ حسد ورتاونہِ۔  
\v 18 چناچہِ تِمو دیُت عبادت گاہ کٮ۪ن رٲچھ درن حکم زِ تِم کرن نبین گِرفتار کٔرِتھ جیلن منٛز بنٛد۔  
\p
\v 19 مگر روتلہِ آو خداوند خدایہ سنٛدِ طرفہٕ اکھ فرشتہٕ تہٕ کٔڈن قٲدخانٕکؠ دروازٕ یلہٕ ترٲوِتھ رسول نیٚبر۔   پتہٕ ووٚن فرشتو نبین، 
\v 20 "عبادت گاہ کِس صحنس منٛز نیریٚو،  تتہِ روزیٚو ۅدٕنؠ،  تہٕ بوزٕ نٲووکھ لوٗکھ ابدی زندگی ہُنٛد پٲغام"
\v 21 یہ بوزتھ گے رسول صبحکہِ وقتہٕ عبادت گاہس منٛز دٲخل تہٕ لٔگؠ دوبارٕ عیسیٰؔ ہس متعلق لوٗکن تعلیم دنہِ۔   أتھؠ دوران أنؠ سردار کاہنن تہٕ تٔمسنٛدیٚو سٲتھیو باقی یہُودؠ مجلسہِ مشاورتٕکؠ ارکان ناد دِتھ۔   سٲری اسرائیلی سردار گے جمع۔   یکہٕ وٹہٕ سمنہٕ پتہٕ،  سوزؠ یمو رٲچھ در رسول جیلہٕ منٛزٕ اننہٕ باپتھ۔  
\p
\v 22 مگر ییٚلہ یم رٲچھ در قٲدخانس منٛز ژاے تہٕ اتہِ وُچھکھ نہٕ رسول کِہین۔   چناچہ تِم آے زِٹھین نِش واپس تہٕ ؤنؠ ہکھ یہ خبر، 
\v 23 اسہِ وُچھ زِ جیلٕکؠ دروازٕ ٲسؠ سیٚٹھاہ محفوظ پٲٹھؠ بنٛد تہٕ دروازن پیٚٹھ ٲسؠ پہرٕدار کھڑا۔   مگر ییٚلہ اسہِ دروازٕ یلہٕ ترٲوؠ تِم نیٚبر کڑنہٕ خٲطرٕ اندر ژاےتہٕ تِمو منٛزٕ اوس نہٕ کہنؠ جیلس انٛدر۔  
\v 24 ییٚلہ عبادت گاہ کیٚو پہرٕ دارن ہنٛدیٚو سردارو تہٕ سردارو کاہنو یہ بوز تِم سپدؠ سیٚٹھاہ پریشان تہٕ لٔگؠ سونچنہِ زِ سٲری واقات کوٚت واتناون اسہِ۔  
\p
\v 25 تام آو کُستام تہٕ ؤنِن تِمن یہ خبر،  "بوزیٚو یہ! وُنؠ وُنؠ یِم نفر توٚہہِ جیل بٔرؠ ووکھ تِم چھِ عبادت گاہ کِس صحنس منٛز کھڑا لوٗکن تعلیم دِوان!"
\p
\v 26 چناچہ عبادت گاہ کٮ۪ن افسرن ہُنٛد سردار گو حٲکمن سٟتؠ عبادت گاہ کِس صحنس منٛز تہٕ أنِن رسول میٹنٛگہِ ہنٛدِس کمرس منٛز بیٚیہِ واپس۔   مگر تِمو کٔر نہٕ تِمن سٟتؠ کانٛہہ بدتمیزی تکیازِ تِمن اوس ہٲبتھ زِ لوٗکھ لاین تِمن کنہِ تہٕ مارنکھ۔  
\p
\v 27 ییٚلہ سردار تہٕ تمسنٛدؠ حٲکم میٹنگہِ ہنحدِس کمرس منٛز رسول ہیٚتھ وٲتؠ تہٕ تِمو دیُت تِمن حکم زِ تِم روزن میٹنگہ ہنٛدین ممبرن برُونٛہہ کنہِ کھڑا تہٕ سردار کاہنن کٔرؠ تِمن سوال۔  
\v 28 تٔمؠ ووٚن تِمن،  "اسہِ دِژوو توٚہہِ حکم زِ لوٗکن مہٕ دِیو تمِس نفر یسوعسؔ متعلق تعلیم پوٗرٕ یروشلمس منٛز۔   مگر توٚہہِ مونو نہٕ سون،  امہ علاوٕ چُھو توٚہؠ یہ وننٕچ کوشش کران زِ أسی چھِ تمِس نفرٕ سنٛدِ موتٕکؠ قصوروار!
\p
\v 29 مگر پطرسن دیُت پننہِ تہٕ باقےٕ نبین ہنٛدِ طرفہٕ تِمن یتھٕ کنؠ جواب،  "اسہِ چھےٚ سۅ کتھ مانٕنؠ یمیُک حکم اسہِ خدا دِوان چُھ نکہِ تہِ یہ اسہِ توٚہؠ ونان چُھو۔  
\v 30 توٚہؠ چُھو تمہ یمو یسوع صلیبس پیٚٹھ کِلؠ ٹھٲسِتھ قتٕل کوٚر! مگر خداین،  یمِس سٲنؠ جدٕاجداد عبادت کران ٲسؠ،  کوٚر سُہ مرنہٕ پتہٕ دوبارٕ زنٛدٕ۔  
\v 31 خداین دیُت یسوعسؔ تیوٗت عزت یوٗتاہ نہٕ تٔمؠ بیٚیہِ کانٛسہِ دیتمُت اوس۔   تٔمؠ بنوو سُہ اسہِ بچاون وول تہٕ سون حٲکم۔   تٔمؠ کوٚر اسہِ اسرائیل ین گُنہو نِشہٕ پتھ روزنُک توفیق عطا۔   تاکہ سُہ کرِ سٲنؠ گناہ معاف۔  
\v 32 أسؠ رودؠ لوٗکن تِمن چیزن متعلق ونان یمہٕ أسؠ زانان چھِ یسوعسؔ سٟتؠ سپدؠ۔   روح القدس،  یُس خداین اسہِ عطا کوٚر،  یُتھ أسؠ تس سنٛز عبادت کرو،  تٔمؠ تہِ کوٚر اتھ پزرس تصدیق"
\p
\v 33 ییٚلہ میٹنگہِ منٛز موجود ممبرو یہ بوز تِم گے نبین پیٚٹھ سیٚٹھاہ ناراض تہٕ تِم ٲسؠ تِمن مارُن یژھان۔  
\p
\v 34 مگر میٹنٛگہِ منٛز اوس فریسی جمٲژ ہُند اکھ رُکن یمِس گملی ایل ناو اوس۔   تٔمؠ دِژ لوٗکن یہُودؠ قانونٕچ زان لہٰذا ٲسِس تمام یہُودؠ احترام کران۔   سُہ وُتھ محفلہِ منٛزٕ تھوٚد تھٕ ونُن رٲچھ درن زِ رسول کٔڈؠ ووکھ رژھِ کھنٛجہِ کمرٕ منٛزٕ نٮ۪بر۔  
\p
\v 35 ییٚلہ پہرٕدر رسول ہیٚتھ نٮ۪بر دراے تہٕ تٔمؠ ووٚن کونسل کٮ۪ن باقی ممبرن،  "اسرائیلی بایو،  توٚہؠ سونٛچو ہنا غورٕ سان زِ توٚہؠ کیاہ چُھو یژھان یمن نفرن سٟتؠ کرُن۔  
\v 36 کینٛہہ وری برُونٛہہ کٔر تھیُوداس ناوٕکؠ أکؠ شخصن حکومتس سٟتؠ بغاوت۔   تٔمؠ ووٚن لوکن زِ بہٕ چُھس اکھ اہم شخص،  تہٕ تمِس سٟتؠ رلیاے قریبن ژور ہتھ نفر۔   مگر سُہ آو مارنہٕ،  تہٕ تِم سٲری گے اورٕ یور یِم تس سٟتؠ ٲسؠ۔   اوٕ کِنؠ رودؠ نہٕ تِم تتھ قٲبل یُس منصوبہ تِمو بنومُت اوس۔  
\v 37 تمہِ پتہ ییٚلہ تم لوٗکن نِش محصول ننہٕ باپتھ مردم شمٲری کران ٲسؠ تہٕ گلیلؔ علاقٕکؠ یہُوداؔ ناوٕکؠ اکؠ شخصن کٔر بغاوت تہٕ کینٛہہ لوٗکھ گے تس ساتھ دِنس پیٚٹھ آمادٕ۔   مگر سُتہ آو مارنہٕ تہٕ تِم سٲری لوٗکھ یمہ تس سٟتؠ ٲسؠ گے مختلف علاقن کُن۔  
\p
\v 38 لہٰذا چُھسو ووٚنؠ بہٕ توٚہہِ ونان زِ یمن نفرن مہٕ واتنٲیو نۅقصان۔   یم ترٲوؠ ووکھ یلہٕ! بہٕ چُھسو اوٕ موکھٕ یہ ونان زِ ووٚنؠ اگر یمہ چیز سپدان چھِ تِم چھِ صرف تِم یمہ انسانن ہنٛدؠ منصوبہ چھِ تہٕ کانٛہہ تہِ ہیٚکہ تِمن رُکاوِتھ۔   تہٕ تِم سپدن ناکام۔  
\v 39 تہٕ ووٚنؠ اگر خداین تِمن یِمن کامٮ۪ن ہُنٛد حکم دیُت تہٕ توٚہؠ ہیٚکہ ووکھ نہٕ تمہٕ رکٲوِتھ تکیازِ توٚہہِ لگیٚو پتاہ زِ أسؠ چھِ خدایس خلاف کٲم کران!" دربارکیٚو کینٛژو ممبرو کوٚر گملی ایل سنٛزِ کتھِ سٟتؠ اتفاق۔  
\p
\v 40 تِمو ووٚن عبادت گاہ کٮ۪ن پہرٕدرن زِ رسول أنووکھ تہٕ تِمن دِیو مار۔   چناچہ پہرٕدارو نی تِم دربار کِس کمرس منٛز تہٕ دیُتہکھ مار۔   پتہٕ دیُتہکھ دربار کیٚو رُکنو حکم زِ یُتھنہٕ لوٗکن یسوعسؔ متعلق مذید کینٛہہ ؤنیٚو،  تہٕ پتہٕ ترٲوِکھ رسول یلہٕ۔  
\p
\v 41 یتھٕ کنؠ دراے رسول دربارٕ منٛزٕ نٮ۪بر۔   تِم ٲسؠ خۅشی مناوان زِ تِم چھِ یسوعؔ سنٛدؠ پٲرو کار،  خداین بخُش تِمن رۅتبہٕ لوٗکن منٛز رسوا سپدِتھ۔  
\v 42 امہِ پتہٕ ٲسؠ پرٛتھ دوٚہہ رسول عبادت گاہ کِس علاقس منٛز تہٕ لوٗکن ہنٛدٮ۪ن گرن منٛز گٔژھِتھ تِمن تعلیم دِوان تہٕ تِمن ونان زِ یسوع ہےٕ چُھ مسیح۔
\c 6
\p
\v 1 اتھ دوران اون بیٚیہِ تہِ واریہو لوٗکو ایمان تہٕ بنیاے شٲگرد۔   غٲر مقٲمی یہُودؠ لوٗکو لٲج مقٲمی طور زامتیٚن اسرائیل ین متعلق شکایت شروع کرٕنؠ تکیازِ تِمن منٛز موجود مونٛڈن اوس نہٕ دوٚہہ دُش منٲسب کھیٚن چیٚنُک حصہٕ میلان۔  
\p
\v 2 یُتھےٕ بہَو رسولو بوز زِ تِم کیاہ چھِ ونان تہٕ تِمو بُلٲوؠ باقی تمام ایمان وٲلؠ یروشلمس منٛز جمع سپدنہٕ باپتھ۔   پتہٕ ووٚن رسولو تِمن،  أسؠ چھنہٕ یہ جان کران زِ لوٗکن منٛز کھیٚن بٲگراونہٕ وزِ چھنہٕ أسؠ خدایہِ سُنٛد پٲغام،  تعلیم تہٕ تبلیغ نظرِ تل تھاوان۔  
\v 3 اے ٹاٹھیٚو ایمان والیٚو،  پننیٚو منٛزٕ کٔڈؠ ووکھ ژٲرِتھ ستتھ نفر یمن متعلق توٚہؠ زانان ٲسیٚو زِ یِمن چُھ پاک روحن ہِدایت بخشمُت تہٕ پتہٕ دِمو أسؠ تِمن ہِدایت یہ کٲم کرنہٕ باپتھ۔  
\v 4 یۅتام سون تعلق چُھ أسؠ کرو پنُن وقت دُعا کرنس منٛز تہٕ یسوعسؔ متعلق تبلیغ کرنس تہٕ تعلیم دنَس منٛز صرف۔  
\p
\v 5 یہ کینٛژھا رسولو تجویز کوٚر تہِ آو باقی تمام ایمان والیٚن پسنٛد۔   لہٰذا ژور تِمو ستفنؔ،  خدایس پیٚٹھ مکمل یقین تھاون وول سُہ اکھ شخص یس پیٚٹھ روح القدس پورٕ پٲٹھؠ کاپہِ رٔٹِتھ چُھ۔   تِمو ژٲرؠ بیٚیہِ فلپس،  پرخُرس،  نِیکانور،  تِیمونؔ،  پرمناسؔ تہٕ نیکلاوسؔ یمہ انطاکیہ شہرٕکؠ ٲسؠ۔   نیکلاوسنؔ اوس یسوعسؔ پیٚٹھ ایمان اننہٕ برُونٛہہ یہُودؠ مذہب قبول کوٚرمُت۔  
\v 6 ایمان والیٚو أنؠ یم ستتھ نفر نبین نِش۔   پتہٕ کوٚر نبیو یِمن نفرن باپتھ دُعا تہٕ تِمو منٛزٕ پرٛتھ کانٛسہِ ہنٛدِس کلس پیٚٹھ اتھٕ تھٲوِتھ کٔرِکھ تِم امہِ کامہِ باپتھ آمادٕ۔  
\p
\v 7 یتھٕ کنؠ رودؠ ایمان وٲلؠ واریہن شٲگرد لوٗکن خدایہ سُنٛد پٲغام بوزٕ ناوان۔   یروشلمس منٛز ٲس پژھ انن والیٚن ہنٛز تعداد واریاہ ہُران۔   اتھ منٛز ٲسؠ واریاہ یہُودؠ کاہن تہِ یمہٕ اتھ پٲغامس پیٚٹھ عمل کران ٲسؠ زِ یسوعسؔ پیٚٹھ کِتھ پٲٹھؠ پزِ بھروسہٕ کرُن۔  
\p
\v 8 خداین کوٚر ستفنسؔ لوٗکن منٛز واریاہ حٲرتناک معجزٕ کرنُک طاقت عطا یمہ سٟتؠ پتاہ اوس لگان زِ یسوعسؔ متعلق پٲغام چھِ پٔزؠ۔  
\v 9 مگر کینٛژو لوٗکو کٔر ستفنسؔ مخالفت۔   تِم ٲسؠ اکہ جمٲژ ہنٛدؠ یہُودؠ یمہ پرٛتھ دوٚہہ اکِس عبادت گاہس منٛز جمع ٲسؠ سپدان یتھ فریڈمین سنٛز سیناگوگ ونان ٲسؠ،  تہٕ بیٚیہِ ٲسؠ کرینی تہٕ سکندریہ کٮ۪ن شہرن ہنٛدؠ تہٕ کلکیہ تہٕ آسیہؔ صوبٕکؠ لوٗکھ تہِ۔   تِمو ساروےٕ لوگ ستفنسؔ سٟتؠ بحث کرُن۔  
\p
\v 10 مگر تِمو ہیٚوک نہٕ ثٲبتھےٕ کرِتھ زِ تمؠ سنٛز کتھ چھےٚ غلط،  تکیازِ خدایہ سنٛدؠ پاک روحن کوٚر تس سمجدٲری سان کتھ کرنُک سلیقہٕ عطا
\v 11 امہِ کِنؠ کٔرؠ تِمو ژھۅپہ کٔرِتھ کینٛہہ نفر ستفنسؔ اپٕزؠ الزام دِنس پیٚٹھ آمادٕ۔   یمو لوٗکو ووٚن،  "اسہِ وُچھ سُہ موسیٰؔ ہس تہٕ خدایس متعلق بُرٕ بلہٕ ونان"
\p
\v 12 یتھٕ کنؠ کھول تِمو بیین یہُودؠ لوٗکن ستفنسؔ خلاف شرارتھ یمن منٛز کینٛہہ بزرگ تہٕ یہُودؠ شریعتٕکؠ اُستاد تہِ شٲمل ٲسؠ۔   پتہٕ نیٚو تِمو ساروےٕ ستفنؔ رٔٹِتھ تہٕ واتنووُکھ یہُودؠ دربارس منٛز۔  
\v 13 تِمو أنؠ کینٛہہ نفر تہِ پانس سٟتؠ تہٕ تِمن دتِکھ پونٛسہٕ تاکہ تِم دِن اپُز گواہی۔   تِمو ووٚن،  "یہ نفر اوس مقدس عبادت گاہس تہٕ موسیٰؔ ہس خدایہ سنٛدِ طرفہٕ میلؠ مٕتٮ۪ن قانونن متعلق بُرٕ بلہٕ ونان۔  
\v 14 سون مطلب چُھ زِ اسہِ بوز یہ اوس ونان ناصرت شہرُک یہ یسوع کرِ یتھ عبادت گاہس تباہ تہ اسہِ ونہِ اسہِ تِمن رسم و ریواجن خلاف کرنہٕ باپتھ یم موسیٰؔ ہن سانٮ۪ن جدٕ اجدادن ؤنؠ۔  
\v 15 دربٲرؠ کمرس منٛز موجود سٲری لوٗکھ ٲسؠ ستفنسؔ کُن تھلہِ تھلہِ وُچھان تہٕ ژیونُکھ زِ تمسُنٛد بُتھ اوس فرشتہٕ سُنٛد ہیٚو۔
\c 7
\p
\v 1 پتہٕ پرُوژھ سردار کاہنن ستفنسؔ،  "کیاہ تمہٕ کتھٕ چھا پزٕ یہ یمہٕ لوٗکھ توٚہہِ متعلق ونان چھِ؟"
\v 2 ستفننؔ دِتُس جواب،  "ٹاٹھیو یہُودؠ یو تہٕ معزز قٲعِدو،  مہربٲنی کرِتھ بوزیٚو میانؠ کتھ۔   سُہ جلالہٕ وول خدا یمسنٛز أسؠ عبادت کران چھِ،  یمؠ سانِس جد ابرہامسؔ تمہِ وقتہٕ جلوٕ دیُت ییٚلہ سُہ حاران شہرس منٛز ینہٕ برُونٛٹھ مسوپتامیہؔ کِس علاقس منٛز روزان اوس۔  
\v 3 خداین ووٚن تس زِ یہ ملک تراو یتہِ ژٕ تہٕ چٲنؠ رشتہٕ دار روزان چھِ تہٕ گژھِ تتھ ملکس منٛز یور کُن بہٕ گژھن ونے، 
\p
\v 4 تہٕ ابرہامنؔ ترٲو سۅ سرِ زمین،  یتھ کسدیہ تہِ ونان ٲسؠ پتہٕ ووت حارانؔ تہٕ بسیاو تٔتؠ۔   مول مرنہٕ پتہٕ ووٚن تس خداین زِ تراو یہ سرِزمین یتھ منٛز ووٚنؠ ژٕ تہٕ بہٕ وُنہِ روزان چھِ۔  
\v 5 امہِ وقتہٕ دِژ نہٕ خداین ابرہامس کانٛہہ تہِ زمین،  حطاکہ تمہِ زمینہِ ہُنٛد اکھ ٹُکرٕ تیٚنہٕ۔   مگر خداین کوٚرُس وعدٕ زِ پتہٕ دمہٕ بہٕ یہ زمین ژےٚ تہٕ چانٮ۪ن اولادن،  تہٕ یہ روزِ ہمیشہِ تِہنٛز ملکِیت۔   حطاکہ امہِ وزِ اوس نہٕ ابرہامس کانٛہہ تہِ اولاد یمسنٛز یہ وراثت بنہِ ہے۔  
\v 6 پتہٕ ووٚن خداین ابرہامس،  "چٲنؠ اولاد واتن پردیشن منٛز۔   تتہِ روزن تِم ژورن ہتن ورؠ ین،  تتھ دوران کرن تتِکؠ سردار چانٮ۪ن اولادن سٟتؠ بدسلوٗکی تہٕ غلام بنٲوِتھ کرن تِمن کٲم کرنہٕ باپتھ مجبوٗر۔  
\v 7 مگر بہٕ دمہٕ تِمن لوٗکن سزا یِم تِمن غلام بنٲوِتھ کٲم کرناون۔  ، خداین ووٚن،  "امہِ پتہٕ تراون چٲنؠ اولاد سُہ ملک تہٕ واتن یتھ ملکس منٛز تہٕ کرن میانؠ عبادت"
\p
\v 8 امہِ پتہٕ دیُت خداین حکم زِ ابرہام سنٛدِس گرِ کِس پرٛتھ مردس تہٕ تِہنٛدین تمام اولادن گژھِ ختنہٕ کٔرِتھ یہ ہاونہٕ یُن زٕ یِم چھِ خدایہ سنٛدؠ۔   پتہٕ زاو ابرہامس نیٚچو اضحاقؔ،  تہٕ ییٚلہ اسحاق ٲٹھن دوٚہُن ہُنٛد ووت،  ابرہامنؔ کوٚر تس ختنہٕ۔   پتہٕ زاو اضحاقسؔ نیٚچو یعقوبؔ۔   یعقوبؔ بنیاو بہَن شُریٚن ہُنٛد مول یمن أسؠ یہُودؠ پننی بُزرگ تہٕ جدٕ اجداد مانان چھِ۔  
\p
\v 9 توٚہؠ چُھو زانان زِ یعقوبؔ سنٛدؠ زیٚٹھؠ نیٚچوؠ لٔگؠ حسد کرنہِ تکیازِ تِہُنٛد مول اوس تِہنٛدس لۅکٹِس بٲیس یوسفسؔ زیادٕ رچھان۔   چناچہ تِمو کُن سُہ مِصرٕ کٮ۪ن سودا گرن یِمو سُہ مِصر واتنوو،  یتہِ سُہ غلام بنیاو۔   مگر خداین کوٚر یوسفس مدد۔  
\v 10 ییٚلہ تہِ لوٗکو تس تکلیف واتنوو خداین کٔر تس حفاظت۔   تٔمؠ کوٚر یوسفس گاٹہٕ جار عطا،  تہٕ تٔمؠ کوٚر مِصرُک بادشاہ فرعونؔ یوسفس متعلق بہتر سونچنس پیٚٹھ مجبور۔   لہٰذا کوٚر سُہ فرعوننؔ مِصرس پیٚٹھ حکومت کرنہٕ تہٕ فرعون سنٛدِ مالہٕ جادادٕچ رٲچھ راوٕٹ کرنہٕ باپتھ مقرر۔  
\p
\v 11 ییٚلہ یوسف یہ کٲم کران اوس تہٕ اکھ وقت آو زِ مِصرس تہٕ کنعانس منٛز ووٚتھ دراگ۔   لوٗکھ آے تکلیفس منٛز ہیٚنہٕ۔   امہ وقتہٕ اوس نہٕ کنعانس منٛز یعقوبس تہٕ شُریٚن تہِ کھیٚن خوردنی برابر۔  
\v 12 ییٚلہ یعقوبن لوٗکن نِش بوز زِ مِصرس منٛز چُھ خۅراک میلان یُس لوٗکھ مٔلؠ ہیٚکن ہیٚتھ۔   تہٕ تٔمؠ سوزؠ یوسفٕنؠ بٔڈؠ بٲے تور اناج موٚلؠ ہیٚنہٕ باپتھ۔   تِم گےَ تہٕ ہیٚوتُکھ یوسفس نِش اناج موٚلؠ۔   مگر تِمو پرزٕنو نہٕ سُہ۔   پتہٕ آے تِم گرٕ واپس۔  
\v 13 ییٚلہ یوسفن بٲے دویمہ لٹہِ مِصر گےَ تہٕ ہیٚوتُکھ یوسفس بیٚیہِ اناج موٚلؠ۔   مگر یمہ لٹہِ وُننکھ تٔمؠ بہٕکُس چُھس۔   تہٕ فرعونس تہِ لوٚگ پےَ زِ یوسف چُھ عبرٲنؠ قومُک تہٕ یِم نفر کنعان پیٚٹھٕ آمٕتؠ ٲسؠ تِم چھِ أمِس بٲے۔  
\p
\v 14 پتہٕ ییٚلہ یوسفن پنٕنؠ بٲے گرٕ واپس سوزؠ تہٕ تِمو ووٚن پننِس مٲلِس یعقوبس زِ یوسف چُھ یژھان توٚہؠ تہٕ تمسُنٛد سورےٕ خاندان گژھِ مِصر یُن۔   تمہِ ساعتہٕ اوس یعقوبن خاندان پنٛژستتھن بٲژن ہُنٛد۔  
\v 15 یُتھےٕ یعقوبن یہ بوز سُہ تہٕ تٔمؠ سُنٛد سورےٕ خاندان ووت مِصر بسنہِ۔   پتہٕ گُذریو یعقوب تٔتی،  تہٕ سٲنؠ باقی جدٕ اجداد تہٕ تہنٛدؠ شُرؠ تہِ۔  
\v 16 تہنٛزٕ لاشہٕ انہِ اسہِ پننِس ملکس منٛز واپس تہٕ کرِ تتھ قبرِ منٛز دفن یۅسہ ابرہامنؔ سِکم شہرس منٛز ہمورؔ سنٛدِس نیٚچوِس موٚلؠ ٲس ہیٚژمٕژ۔  
\p
\v 17 سانٮ۪ن جدٕ اجدادن ہنٛز تعداد ٲس واریاہ بڈیمٕژ ییٚلہ خدایس مِصرٕ منٛزٕ تِم کڈنُک وقت قریب باسیاو یتھٕ کنؠ زن تٔمؠ ابرہامس وعدٕ اوس کوٚرمُت زِ بہٕ کرٕ یہ۔  
\v 18 مِصرس منٛز اوس بیاکھ اکھ بادشاہ حکومت کرنہٕ لوٚگمُت۔   سُہ اوس نہٕ زانان زِ یوسفن چُھ مےٚ برُونٛہہ واریاہ کال مِصرٕ کٮ۪ن لوٗکن سیٚٹھاہ مدد کوٚرمُت۔  
\v 19 تٔمؠ بادشاہن ہیٚتؠ سختی سان سٲنؠ جدٕ اجداد اتہِ کڈنٕچ کوشِش کرٕنؠ۔   تٔمؠ کوٚر تِمن پیٚٹھ واریاہ ظلم تہٕ واتنٲوؠ نکھ کٲفی تکلیف۔   اتھ حدس تام زِ تٔمؠ دیُت تِمن پنٕنؠ نوزادٕ بچہٕ پننیٚو گرو منٛزٕ نیٚبر کڈنُک حکم یتھ تِم مرہن۔  
\p
\v 20 أتھؠ وقتس منٛز لوٚب موسیٰؔ ہن تہِ زایُن،  خداین وُچھ سُہ اکھ سیٹھہےٕ خوبصورت بچہٕ۔   تہٕ تمؠ سنٛدؠ مٲلؠ موج روٚچھ سُہ پننِس گرس منٛز تریٚن ریتن ژوٗرِ ژوٗرِ۔  
\v 21 پتہٕ پیٚو تِمن سُہ گرٕ نیٚبر ژھنُن،  مگر فرعونؔ نہِ کورِ تُل سُہ تہٕ روٚچُھن پننِس اولاد سنٛزِ گرنٛز۔  
\p
\v 22 موسیٰؔ ہس آے تِم سٲری علِم ہیٚچھِ ناونہ یمہٕ مِصرٕکؠ لوٗکھ زانان ٲسؠ،  ییٚلہ سُہ بالیغ سپُد سُہ اوس کتھن تہٕ کامہِ منٛز سرس۔  
\p
\v 23 اکہ دوٚہہ ییٚلہ موسیٰؔ ژتجی وُوہر ووت تٔمؠ کوٚر فٲصلہٕ زِ بہٕ گژھٕ تہٕ سمکھٕ پننٮ۪ن بنی اسرائیل کٮ۪ن رشتہٕ دارن۔  
\v 24 تٔمؠ وُچھ اکھ مِصری أکِس اسرائیلی نفرس سٟتؠ بدسلوکی کران،  سُہ گو اسرائیلی نفرس مدد کرنہِ تہٕ مِصری نفر قتٕل کرِتھ ہیٚوتُن تس اسرائیلی نفرٕ سُنٛد بدلہٕ۔  
\v 25 موسیٰؔ ہن سونٛچ زِ تمسنٛدؠ سٲتھی بنی اسرائیلی زانن زِ خداین سوز یہ اسہِ غلامی نِشہٕ آزاد کرنہٕ باپتھ،  مگر تِمو سمُجھ نہٕ تہِ۔  
\p
\v 26 بیٚکہِ دوٚہہ وُچھ موسیٰؔ ہن اسرائیلی زٕ نفر پانہٕ وٲنؠ ژُوان۔   تٔمؠ کٔرؠ لڑایہ نِش تِم یہ ؤنِتھ رُکاونٕچ کوشش،  ہے جوانو! توٚہؠ دوٚنوے سٲتھی چُھو اسرائیلی! توٚہہ پزیٚو اکھ اکِس سٟتؠ سلامتی سان روزُن تہٕ  تکلیف دیُن بنٛد کرُن!"
\v 27 مگر یُس نفر بیٚکِس نفرس غلط یعنی زخمی کران اوس تٔمؠ دیُت موسیٰؔ ہس دکہٕ تہٕ وُننس،  "ژٕ چُھکھ نہٕ کانٛسہِ سون حٲکم یا قٲضؠ مقرر کوٚرمُت!
\v 28 ژٕ چُھکھ زہریا میٚتہِ مارُن یژھان یتھٕ کنؠ ژےٚ راتھ سُہ مِصری مورتھن!
\p
\v 29 ییٚلہ موسیٰؔ ہن یہ بوز سُہ ژوٚل مِصرٕ منٛزٕ تہٕ ووت مِدیان چہِ زمینہِ منٛز۔   تتہِ رود سُہ کینٛژن ورؠ ین۔   تٔمؠ کوٚر خاندر،  تہٕ تمِس زاے أمِس زنانہٕ نِش زٕ لٔڑکہٕ۔  
\p
\v 30 ژتجؠ ؤہرؠ پتہٕ گو اکہِ وزِ خداوند خدا موسیٰؔ ہس برُونٛہہ کنہِ فرشتہٕ بٔنِتھ حٲضر۔   سُہ سپُد أکِس زنٛڈس تل نارٕ ریہہ چہِ صورٕژ منٛز نمودار یۅسہ سیناؔ بالس نکھٕ صحراوس منٛز دزان ٲس۔  
\p
\v 31 موسیٰؔ گو سۅ وُچِھتھ حٲران تکیازِ زنٛڈ اوس نہٕ دزٲنی۔   ییٚلہِ سُہ وُچھنہٕ باپتھ ہنا نزدیک گو تہٕ تٔمؠ بوز خداوند خدا تس کُن ونان، 
\v 32 "بہٕ چُھس خدا یمسنٛز عبادت چٲنؠ جدٕ اجداد کران ٲسؠ۔   بہٕ چُھس سُہ خدا یمسنٛز ابرہام،  اضحاق،  تہٕ یعقوب عبادت کران چھِ" موسیٰؔ کھۅژ تیوٗت زِ تمِس ژایہ تھرٕ تھرٕ۔   سُہ اوس ووٚنؠ زنٛڈس کُن وُچھنہٕ تہِ کھۅژان۔  
\p
\v 33 پتہٕ ووٚن خداوند خداین تمِس زِ پنٕنؠ کھۅربانہٕ کڑ میانِس احترامس منٛز نٮ۪بر۔   تکیازِ بہٕ چُھس یتہِ، زمینس پٮ۪ٹھ یتھ جایہ ژٕ کھڑا چُھکھ یہ چھےٚ میانؠ خاص جاے۔  
\v 34 مےٚ وُچھ زِ مِصرٕکؠ لوٗکھ کِتھٕ پٲٹھؠ چھِ میانٮ۪ن لوٗکن ہیٚتھےٕ تکلیف دِوان۔   مےٚ بوز پننٮ۪ن لوٗکن ہنٛز امہِ سٟتؠ وۅتلن واجِنؠ آہو و زٲری۔   امہِ کِنؠ وتھُس بہٕ تِمہ مِصرٕ منٛزٕ بچاونہٕ باپتھ بۅن۔   ووٚن گژھِ ژٕ تیار تکیازِ بہٕ چُھستھ ژٕ واپس مِصر سوزن وول۔  
\p
\v 35 یہ اوس صرف اکھ موسیٰؔ یمؠ سانٮ۪ن اسرائیلی لوٗکن مدد کرنٕچ کوشش کٔر،  مگر تِمو کوٚر سُہ یہ ؤنِتھ رد زِ 'ژٕ چُھکھ نہٕ کانٛسہِ حٲکم یا جج مقرر کوٚرمُت!' موسیٰؔ چُھ سُہ یُس خداین پانہٕ تِمن پیٚٹھ حکومت کرنہِ تہٕ تِم غلامی نِشہٕ آزاد کرنہٕ خٲطرٕ سوز۔   سُہ چُھ سُے یمِس زنٛڈٕ منٛزکؠ فرشتن یہ کرنُک حکم دِژاو۔  
\v 36 موسیٰؔ ہےٕ چُھ سُہ یمؠ سٲنؠ جدٕاجداد مِصرچہِ زمینہِ  منٛزٕ کٔڑؠ۔   تٔمؠ کٔرؠ مِصرس منٛز رنٛگہٕ رنٛگہٕ معجزٕ تاکہِ یہ سپدِ عیان زِ خدا اوس تس سٟتؠ،  بحرِ قُلزمسؔ منٛز تہٕ تِمن ژتجہَن ورؠ ین دوران ییٚلہ اسرائیلی لوٗکھ بیابنن منٛز روزان ٲسؠ۔  
\v 37 یہ چُھ سُے موسیٰؔ یمؠ اسرائیلی لوٗکن ووٚن،  "خدا سوزِ تُہنٛدِ قومہٕ منٛزٕ بییِس اکِس شخصس تُہنٛدِ باپتھ میٚی ہیٚو اکھ نبی بنٲوِتھ۔  
\p
\v 38 یوٚہے چُھ سُہ موسیٰؔ یُس بنی اسرائیل یو منٛزٕ اوس یمہٕ بیابنن منٛز یکہٕ وٹہٕ ٲسؠ۔   سُہ اوس تس فرشتس سٟتؠ یمؠ سینا بالس پیٚٹھ تمِس سٟتؠ کتھٕ کرِ۔   یوٚہے چُھ سُہ موسیٰؔ یمِس کوہہِ سیناؔ ہس پیٚٹھ خداین فرشتہٕ سوز زِ تس ون سٲنؠ قانون،  تہٕ سُے اوس سُہ یمؠ سانٮ۪ن جدٕ اجدادن ووٚن زِ فرشتن کیاہ ووٚن۔   سُے اوس سُہ یمؠ یمؠ خدایہ سنٛدِ طرفہٕ تمہٕ کتھٕ حٲصل کرِ یمہٕ اسہِ ونان چھےٚ زِ ابدی زندگی کِتھ کٔنؠ چھےٚ گذارٕنؠ،  تہٕ تہِ واتنووُن اسہِ تام۔  
\p
\v 39 مگر سٲنؠ جدٕ اجداد ٲسؠ نہٕ موسیٰؔ سنٛز کتھ مانٕنؠ یژھان۔   حالانکہ تِمو کوٚر سُہ پنُن زیُٹھ ماننہٕ نِشہٕ تہِ انکار تہٕ ٲسؠ مِصر واپس گژھُن یژھان۔  
\v 40 پتہٕ ووٚن تِمو تسنٛدِس بٔڈس بٲیس ہارونسؔ،  "سانہِ باپتھ بناون بُت یُس سون وتہٕ ہاوُک دیوتا بنہِ۔   یۅتام سٲنس سٲتھی موسیٰؔ سُنٛد تعلق چُھ یمؠ أسؠ مِصرٕ منٛزٕ کٔڈتھ أنؠ اسہِ چُھنہٕ فِکرے تران زِ تمس سٟتؠ کیاہ سپُد!"
\p
\v 41 چناچہِ تِمو بنوو ؤژھؠ سنٛزِ شکلہ اکھ بُت۔   پتہٕ کرِ تِمو تس بُت سنٛدِس تعظیمس منٛز قربٲنیہ پیش،  تہٕ تِمو نوٚژ تہٕ گیٚو تمہِ باپتھ یُس چیز تِمو پانے بنوو۔  
\v 42 لہٰذا تروو خداین تِمن ہِدایت کرُن۔   تٔمؠ ترٲوؠ تمہٕ یلہٕ یُتھ زن تِم آسمانس اندر آفتابس،  زوٗنہِ تہٕ تارکن ہنٛز عبادت کرن۔   یہِ چُھ تِمن کتھن ہُنٛد تصدیق یمہٕ رسولو منٛزٕ أکؠ لیچھمژٕ چھےٚ:
\q خداین ووٚن،  "اے اسرائیلی لوٗکو،  ییٚلہ توٚہہِ بار بار جانور مٲرتھ تہٕ تِمن ژتجہَن ورؠ ین قربان رنٛگؠ پیش کران رودیٚو تمن دوٚہُن توٚہؠ بیابانن منٛز ٲسیو،  توٚہؠ ٲسیٚو نہٕ یقیناً سۅ دِلہ تِم مےٚ نذر کران!
\v 43 بلکہِ ٲسیٚو توٚہؠ تِمن خٟمن منٛز موجود مورتی ین ہنٛز پوٗزا کران یمہٕ توٚہؠ پانس سٟتؠ اکہ جایہ پیٚٹھٕ بیِس جایہ نِوان ٲسیٚو،  یمن منٛز رِفان ناوکِس سِتار دیوتا سنٛز تصویر تہِ ٲس۔   یِم ٲسؠ تِم بُت یمہٕ توٚہہِ پانہٕ بنٲومٕتؠ ٲسیٚو،  تہٕ توٚہہِ ٲسیٚو میانہٕ بجایہ تِہنٛز عبادت کران۔   امہِ کِنؠ کرو بہٕ توٚہؠ پننیٚو گرو نِشہٕ دوٗر تہٕ بابل ملکہٕ کیٚو علاقو نِشہٕ تہِ دوٗر"
\p
\v 44 ییٚلہ سٲنؠ جدٕاجداد بیابانن منٛز ٲسؠ،  تِمو کٔر مقدس خٟمس منٛز خدایہ سنٛز عبادت یمہ سٟتؠ یہ ننان اوس زِ سُہ چُھ تتہِ تِمن سٟتؠ۔   تِمو اوس خٟمہ تِتھُے بنومُت یُتھ خداین موسیٰؔ ہس بناونُک حکم کوٚرمُت اوس۔   یہ اوس بالکل تِتھُے یُتھ موسیٰؔ ہن پہاڑس پیٚٹھ کھسنہٕ وزِ وُچھمُت اوس۔  
\v 45 پتہٕ نیٚو سانیٚو باقی جدٕاجدادو یہ خٟمہ پانس سٟتؠ ییٚلہ یشُوعن تِم یتھ ملکس منٛز أنؠ۔   یہ اوس سُہ وق ییٚلہ تِمو یہ زمین پانس خٲطرٕ تھٲو،  ییٚلہ خداین تِم لوٗکھ یمہِ یتہِ گۅڈٕ روزان ٲسؠ یہ تراونس پیٚٹھ مجبور کٔرؠ۔   تہٕ اسرائیلی لوٗکھ گےَ اتھ ملکس پیٚٹھ قبضہ کرنس لایکھ۔   خٟمہ رودؠ أتھؠ ملکس منٛز تہٕ تِمہ ٲسؠ بادشاہ داوود سنٛدِس دورِ حکومتس تام تہِ أتؠ۔  
\v 46 داوودنؔ کوٚر خدا خۅش تہٕ تٔمؠ کٔر خدایس عرضی زِ سُہ دییہ تمِس اکھ گرٕ بناونہٕ یتہِ سُہ تہٕ سٲنؠ سٲری اسرائیلی لوٗکھ یعقوب سنٛدِس خدایہ سنٛز عبادت کٔرِتھ ہیٚکن۔  
\p
\v 47 مگر امہِ بجایہ ووٚن خداین داوود سنٛدِس نیٚچوِس سلیمانسؔ زِ سُہ بناوِ اکھ گرٕ یتہِ لوٗکھ تمؠ سنٛز عبادت کرن۔  
\p
\v 48 مگر أسؠ چھِ زانان زِ خدا چُھ ساروےٕ چیزو کھۅتہٕ بوٚڈ تہٕ سُہ چُھنہٕ تِمن گرن منٛز روزان یمہٕ لوٗکو آسن بنٲومٕتؠ۔   یہ چُھ تِتھُے یتھٕ پٲٹھؠ یسعیاہؔ نبین لیٚوکھمُت چُھ:
\q
\v 49‏-50 خداین فرموو،  "آسمان چُھ میٚون تخت تہٕ زمین چھےٚ میانٮ۪ن کھۅرن ہنٛز چوکؠ۔   میٚی چُھ آسمانن تہٕ زمینہِ ہُنٛد پرٛتھ کانٛہہ چیز بنومُت۔   تہٕ توٚہؠ انسان ہکیٚو نہٕ میانہِ روزنہٕ باپتھ تِژھ اصل جاے بنٲوِتھ!"
\p
\v 51 توٚہؠ لوٗکھ چُھو تمِس باپتھ سیٚٹھاہ ضدی!بلکُل پننٮ۪ن جدٕاجدادن ہنٛدؠ پٲٹھؠ! توٚہؠ چُھو ہمیشہٕ روح القدس سنٛز مخالفت کران،  یتھٕ کنؠ تِمو کٔر!
\v 52 تُہنٛدیٚو جدٕاجدادو واتنوو پرٛتھ کانٛسہِ نبیس تکلیف۔   یتھ حدس تام تہِ زِ تِمو مٲرؠ تِم لوٗکھ تہِ یمو واریاہ برُونٛہہ اعلان اوس کوٚرمُت زِ مسیح ییہِ،  یُس ہمیشہ تی کران اوس یہ خدایس پسنٛد اوس۔   تہٕ مسیح آو! سُہ چُھ سُے یُس حال حالےٕ توٚہہِ تمسنٛدین دشمنن حوالہٕ کوٚروون تہٕ ووٚنووکھ زِ سُہ کٔرؠ وون قتٕل!
\v 53 توٚہی لوٗکھ چُھو تِم یمو خدایہ سنٛدؠ احکام حٲصِل کٔرؠ۔   یِم ٲسؠ تِم قانون یِم خداین فرشتو ذرؠ یہ سانیٚن جدٕاجدادن باپتھ بنٲومٕتؠ ٲسؠ۔   مگر توٚہہِ کٔرو نہٕ تہنٛز عبادت"
\p
\v 54 ییٚلہ یہُودی کونسل کیٚو ممبرو تہٕ تتہِ موجود باقی لوٗکو ستفنؔ سنٛزٕ یمہٕ سارے کتھٕ بوزٕ تہٕ تِمن کھۅت سیٚٹھاہ شرارتھ،  تِم ٲسؠ دنٛد ژاپان تکیازِ تِم ٲسؠ تس پیٚٹھ سیٚٹھاہ ناراض!
\p
\v 55 مگر روح القدسن تھوو ستفن پوٗرٕ پٲٹھؠ قوبوس منٛز۔   تٔمؠ وُچھ آسمانس کُن تہٕ خدایہ سنٛدِ طرفہٕ گوس اکھ پرٮ۪زلوُن گاش نظرِ تہٕ وچُھن یسوع خدایس دٔچھنہِ انٛدٕ کھڑا۔  
\v 56 تٔمؠ ووٚن! وُچھو،  بہٕ چُھسن کُھلہٕ آسمان وُچھان تہٕ بہٕ چُھسن آدمؔ سُنٛد گۅبُر انسٲنی شکلہِ منٛز کھڑا وُچھان یتہِ خدا حکومت چلاوان چُھ۔  
\p
\v 57 یہُودی کونسل کیٚو ممبرو تہٕ باقی لوٗکو ییٚلہ یہ بوز تِمو تُل بڈِ شور۔   تِمو دتؠ کنن اتھٕ سٟتؠ تھۅپؠ یُتھ نہٕ تِم تمسُنٛد بوزٕ ہن،  تہٕ دوریاے سٲری جلدےٕ تٔسؠ کُن۔  
\v 58 تِمو نیٚو سُہ کھکھرِ یروشلم شہرٕ نیٚبر تہٕ لاجہس کنہِ لایِنہِ۔   یِم لوٗکھ تمِس الزام دِوان ٲسؠ تِمو کٔڈؠ پنٕنؠ پلو یُتھ زن ٹھیک پٲٹھؠ کنہِ لٲیِتھ ہیٚکہٕ ہن تہٕ تِمو تھٲوؠ پنٕنؠ پلو ساوُلؔ ناوٕ کِس اکِس نوجوانس نِش پتھر یُتھ سُہ تِمن رٲچھ کرِ۔  
\p
\v 59 ییٚلہ تمہ ستفنسؔ کنہِ لایان ٲسؠ،  ستفننؔ مونٛگ دُعا،  "اے خدا وند یسوعؔ،  میٚون روح کرُن قبول"
\p
\v 60 پتہٕ پیٚو ستفنؔ پتھر تہٕ کوٚٹھؠ کھوکھشہِ دِتُن آلو،  "خداوند،  یِمن دی زینہٕ امہِ گنہُک سزا" یہ ؤنِتھ گُذریاو سُہ۔
\c 8
\p
\v 1‏-2 پتہٕ کٔر کینٛژو نفرو یمہٕ خدا ترس ٲسؠ ستفنؔ سنٛز لاش اکِس قبرِ منٛز دفن، تہٕ کوٚرکھ تمسنٛدِس مرنس پیٚٹھ واریاہ تہٕ تھدِ ہٹہِ ماتم۔
\p امی دوٚہہ کوٚر لوٗکو یروشلمس منٛز روزن والیٚن ایمان والیٚن لوٗکن پیٚٹھ سخت ظلم کرُن شروع۔ چناچہ زیادٕ تر ایمان وٲلؠ لوٗکھ ژٔلؠ یہُودیہ تہٕ سامریہ کٮ۪ن مختلف صوبن کُن۔ رسول رودؠ یروشلمسےٕ منٛز۔
\v 3 ییٚلہ تِم ستفنسؔ ماران ٲسؠ تہٕ ساوُل اوس تائید کران زِ ستفنؔ گژھِ مارنہٕ یُن۔ تکیازِ ساوُل تہ اوس ایمان واجنہِ جمٲژ تباہ کرنٕچ کوشش کران۔ سُہ گو اکہِ اکہِ گرن منٛز، سُہ اوس یسوعسؔ پیٚٹھ ایمان انن والیٚن زنٮ۪ن مردن کھکھرِ کڈان، تہٕ پتہٕ تِمن قٲدؠ بناوان۔
\p
\v 4 تمہٕ ایمان وٲلؠ یمہ یروشلمہٕؔ منٛزٕ نیرتھ مختلف جاین گے یتہِ تِم یسوعسؔ متعلق تبلیغ کران رودؠ۔
\v 5 یِمن ایمان والین منٛز اوس اکھ فلپس ناوُک اکھ شخص۔ یُس یروشلمہٕؔ پیٚٹھ سامریہ ضلعہٕ کِس اکِس شہرس منٛز گو۔ تتہِ اوس سُہ لوٗکن ونان زِ یسوع چُھ مسیحؔ۔
\p
\v 6 تتہِ بوزٕ واریہو لوکو فلپ سنٛزٕ یمہٕ کتھٕ تہٕ وُچھِکھ تمہٕ معجزٕ تہِ یمہٕ سُہ کران اوس۔ یمہِ کنؠ ساروےٕ تمؠ سنٛزن کتھن کُن پوٗرٕ توجہ دیُت۔
\v 7 مثالہِ پٲٹھؠ، فلپسن دیُت واریہن لوٗکن منٛز موجود بد روحَن نیرنُک حکم تہٕ تِم دراے چِکہٕ دِوان نٮ۪بر۔ بیٚیہِ ٲسؠ واریاہ لوٗکھ فالجہِ لد تہٕ واریاہ ٲسؠ لنٛگؠ یمہ شفا یاب سپٕدؠ۔
\v 8 تہٕ امہِ شہرٕکؠ واریاہ لوٗکھ گے سیٚٹھاہ خۅش۔
\p
\v 9 تتھ شہرس منٛز اوس اکھ نفر روزان یمِس شمعون ناو اوس۔ سُہ اوس واریاہ کالہٕ پیٚٹھٕ جادوگری کران تہٕ تمؠ ٲسؠ سامریہ ضلعس منٛز پننہِ جادوگری سٟتؠ لوٗکھ حٲران کٔرمٕتؠ۔ تٔمؠ کوٚر دعوا زِ سُہ "شمعونؔ چُھ عظمتہٕ وول!"
\v 10 تتہِ موجود تمام لوٗکو یمہٕ عام تہٕ اہم ٲسؠ ساروےٕ بوز تمؠ سنٛز کتھ۔ تِم ٲسؠ ونان زِ یہ شخص چُھ خدایہ سُنٛد عظیم طاقت۔
\v 11 تِم رودؠ تمؠ سنٛز کتھ دیانہٕ سان بوزان، تکیازِ تٔمؠ ٲسؠ واریہس کالس تِم جادو ہٲوؠ ہٲوؠ حٲران کٔرمٕتؠ۔
\p
\v 12 مگر پتہٕ کٔر تِمو فلپس سنٛزِ خۅشخبری ہنٛزِ شیٚچھِ پیٚٹھ پژھ زِ خدا ییہِ پانہٕ بادشاہ سنٛدِ حثیتہٕ تہٕ یسوع مسیحؔ ہس متعلق۔ یسوعسؔ پیٚٹھ ایمان انن والیٚو مردو تہٕ زنیٚو پُروو بپتسمہ۔
\v 13 شمعوننؔ کوٚر پانہٕ فلپس سنٛزِ شیٚچھِ پیٚٹھ یقین تہٕ روٚٹُن بپتسمہ۔ سُہ لوٚگ ہیٚتھےٕ فلِپس سٟتؠ سٟتؠ پکنہِ، تہٕ سُہ رود مُتوٲتِر تِمو عظیم معجزاتو سٟتؠ حٲرانی پراوان یمہٕ تٔمؠ فلِپس کران وُچھ، تِم چیز یمو سٟتؠ ظٲہر سپدان اوس زِ فلِپس چُھ پزر ونان۔
\p
\v 14 ییٚلہ یروشلمس منٛز رسولو یو بوز زِ سامریہ کِس سٲرسےٕ ضلعس منٛز کوٚر واریہو لوٗکو خدایہ سنٛدِس پٲغامس پیٚٹھ یقین تہٕ تِمو سوز پطرس تہٕ یوحنا تور۔
\v 15 ییٚلہ پطرس تہٕ یوحنا سامریہ وٲتؠ تہٕ تِمو کوٚر تِمن نویٚن ایمان والیٚن پاک روح پراونہٕ باپتھ دُعا۔
\v 16 تکیازِ یہ اوس عیان زِ ونیُک تام اوس نہٕ تِمن پاک روح حاصل سپُدمُت۔ تِمن اوس چھرا خداوند یسوع سنٛدِ ناوٕ بپتسمہ دِنہٕ یوان۔
\v 17 پتہٕ تھٲوؠ پطرسن تہٕ یوحنا ہن تِمن اتھٕ پیٚٹھ تہٕ تِمو پُروو پاک روح۔
\p
\v 18 شمعوننؔ وُچھ زِ رسولن ہنٛدِ اتھٕ پیٚٹھ تھاونہٕ سٟتؠ چُھ لوٗکن پاک روح حٲصِل سپدان۔ چناچہ تٔمؠ کٔر رسولن پونٛسہٕ دنٕچ پیشکش،
\v 19 تہٕ ونُن، "یہ کینٛژھا توٚہؠ کران چُھو میتہِ بنٲوؠ تو تہِ کرنس لایکھ تاکہِ پرٛتھ کانٛسہِ یس پیٚٹھ بہٕ اتھٕ تھاوٕ گژھِ پاک روح حٲصل"
\p
\v 20 مگر پطرسن ووٚن تس، "ژٕ تہٕ چٲنؠ پونٛسہٕ گٔژھِن فناہ، تکیازِ ژےٚ کٔرتھ پونٛسو سٟتؠ خدایہِ سنٛز عنایت حٲصل کرنٕچ کوشش!
\v 21 یہ کینٛژھا ٲسؠ کران چھِ سۅ کٲم ہیٚککھ نہٕ ژٕ اسہِ سٟتؠ کٔرِتھ تکیازِ چون دِل چُھنہٕ خدایس سٟتؠ سیٚود رٔلِتھ!
\v 22 لہٰذا تراو ژٕ یہ بُرٕ سونٛچ تہٕ منٛگ خداونٛدس سُہ کٔری ژےٚ معاف یہ کینٛژھا بُرٲئی چٲنِس دِلس منٛز چھےَ اگر سُہ یژھِ۔
\v 23 پننہِ بُرٕ وتہِ پیٚٹھٕ یہ واپس، تکیازِ اسہِ چُھ فکرِ تران زِ ژٕ چُھکھ سانہِ حسدٕ دزان تہٕ بُرٲئی ورتاونٕچ چھےَ کل گنان!
\p
\v 24 شمعوننؔ ووٚنُس یورٕ، "خداوندس منٛگؠ تو زِ سُہ کرِنہٕ مےٚ سٟتؠ تہِ یہ توٚہؠ ونان چُھو"
\v 25 ییٚلہ تتہِ پطرسن تہٕ یوحناہنؔ لوٗکن ووٚن زِ تِم کیاہ چھِ خداوند یسوعسؔ متعلق زانان تہٕ خداوند سُنٛد پٲغام بوزٕنٲوِتھ آے تِم دوٚنوے یروشلم واپس۔ وتہِ بوزنٲوؠ تِمو سامریہ ضلعکؠ لوٗکھ یسوعسؔ متعلق جان جان کتھٕ۔
\p
\v 26 اکہ دوٚہہ کوٚر أکؠ فرشتن یُس خداوندن سوزمُت اوس، فلپس حکم، "ژٕ گژھ تیار تہٕ نیر یمہ سڑکہِ جنوب کُن یۅسہ یروشلم کِنؠ غزہؔ شہر تام واتان چھےٚ" سۅ سڑک ٲس صحراوو منٛزؠ۔
\v 27 فلپس گو تیار تہٕ دراو امی سڑکہ۔ وتہِ منٛز گو أمِس حبشی سرِ زمین ہنٛدس اکِس نفرس سٟتؠ ملاقات۔ یہ شخص اوس اکھ اہم عہدٕدار یس حبشی ین ہنٛزِ ملکانہ ہنٛدین تمام خزانن ہنٛز ذمہ دٲری مٹہِ ٲس۔ تِم ٲسؠ پننہِ زبانؠ منٛز ملکانہِ کیندِس ونان۔ یہ نفر اوس گمُت خدایہ سنٛز عبادت کرنہٕ باپتھ یروشلم،
\v 28 تہٕ ووٚنؠ اوس پننِس رتھس پیٚٹھ گرٕ کُن پکان۔ ییٚلہ سُہ رتھس پیٚٹھ سوار اوس تہٕ سُہ اوس بڈِ بڈِ یسعیاہؔ نبی سنٛدِ صحیفہٕ منٛز بڈِ بڈِ پران۔
\p
\v 29 خدایہ سنٛدؠ روحن ووٚن فلپس، اتھ رتھس نزدیک گژھِ تہٕ اتھ سٟتؠ سٟتؠ روز پکان!"
\v 30 یتھ کنؠ گو فلپس رتھس نزدیک تہٕ أمِس نفرٕ سُنٛد یسعیاہؔ نبی سُنٛد صحیفہ برُن چُھ بوزان۔ تٔمؠ پرُوژھ أمِس نفرس، "کیاہ توٚہہ چھا پےَ زِ توٚہؠ کیاہ چُھو پران؟
\v 31 تٔمؠ ووٚن فلپس در جواب، "نہ!میانہِ خٲطرٕ چُھ یہ مشکِل سمجھُن اگر نہٕ مےٚ کانٛہہ زانن وول یہ سمجھایہ! ادٕ ووٚن أمؠ نفرن فلِپس، "مہربٲنی کٔرِتھ کھس تہٕ بیٚہہ مےٚ نِش"
\p
\v 32 صحیفُک سُہ حصہٕ یُس افسر پران اوس اوس یتھٕ کنؠ: " سُہ اوس کٹہٕ سنٛدؠ پٲٹھؠ پُر سکون یمِس لوٗکھ تتھ جایہ نوان ٲسؠ یتہِ تِم تس مارٕ ہن، یا تمِس خاموش برٕ سنٛدؠ پٲٹھؠ کھڑا یُس نیٚتنہٕ یوان آسہ ہے۔
\q
\v 33 تمِس ییہِ ذلالت کرنہٕ۔ تمِس میلہ نہٕ انصاف انصافہٕ نِشہٕ ییہِ سُہ دوٗر تھاونہٕ۔ تمسنٛدین زُریٚن متعلق ہیٚکہ نہٕ کانٛہہ کینٛہہ ؤنِتھ۔ تکیازِ تمِس آسہ نہٕ کانٛہہ اولادےٕ۔ تِمہ نِن یتھ زمینہِ پیٚٹھ تمؠ سنٛز زندگِیی مِٹٲوِتھ۔
\p
\v 34 افسرن پرُوژھ فلپسس یمن لفظن ہُنٛد معنی یمہ سُہ پران اوس، "مےٚ ؤنتو، یہ نبی کس متعلق چُھ لیٚکھان؟ سُہ چھا پانس متعلق لیٚکھان کنہٕ بدل کانٛسہِ متعلق؟
\v 35 فلپسن دتُس جواب، تٔمؠ کٔر امہ صحیفہ کہ حوالہٕ کتھ شروع، تہٕ بوزنووُن یسوعسؔ متعلق کینٛہہ رٕتؠ پٲغام۔
\p
\v 36 ییٚلہ وتہِ منٛز کتھ کتھ کران تِم تژھِ جایہ وٲتؠ یتِتھ آبہٕ رژھا ٲس۔ اتہِ ووٚن افسرن فلپسس، "وُچھو ہُتیٚتھ چھےٚ آبہٕ رژھ کھنٛڈ۔ بہٕ چُھس یژھان زِ توٚہؠ دِیو مےٚ بپتسمہ، تکیازِ بہٕ چُھس نہٕ تیٚوتھ کانٛہہ چیز زانان یُس مےٚ بپتسمہ رٹنہٕ نِشہٕ پتھ رٹہِ"
\v 37 فلپسن ووٚنُس، "اگر ژٕ پزِ دِلہ پژھ تھاون وول چُھکھ تہٕ ژٕ ہیٚککھ بپتسمہ رٔٹِتھ" حبشی ین دِتُس جواب، "مےٚ چُھ یقین زِ یسوع مسیحؔ چُھ خدایہ سُنٛد گۅبُر"
\v 38 چناچہ افسرن ووٚن رتھ چلاون وٲلِس رتھ رُکاو۔ پتہٕ ؤتھؠ فلپس تہٕ افسر بوٚن تہٕ گے آبس نِش تہٕ فلپسن دیُت تس بپتسمہ۔
\p
\v 39 ییٚلہ تِم آبہٕ منٛزٕ بوٚٹھ کٔھتؠ تہٕ فلپس نیٚو اچانک خداوند سنٛدؠ روحن اتہِ تلِتھ۔ أمؠ افسر وُچھ نہٕ پتہٕ زانٛہہ تہِ فلِپس۔ اگر زن افسرن امہِ پتہٕ فلِپس وُچھ نہٕ مگر افسر رود اتھ وتہِ پنُن سفر خوشی سان جٲری تھٲوِتھ۔
\p
\v 40 پتہٕ توٚر فلپسس فکرِ زِ روحن اوس سُہ معجزٲتی طور اشدُود شہرس منٛز واتنوومُت۔ ییٚلہ سُہ تتھ علاقس منٛز پھیران تھوران اوس، سُہ رود عزوتس تہٕ قیصریہ کٮ۪ن شہرن درمیان تمام علاقن منٛز یسوع سنٛدین پٲغامن ہُنٛد اعلان کران۔ تہٕ یم اعلان رود سُہ تۅتام کران یۅتام سُہ ٲخرس قیصریہ ووت۔
\c 9
\p
\v 1 اتھ دوران رود ساوُلؔ شرارتس منٛز تمن لوٗکن مارنٕچ دھمکی دِوان یمہٕ خداوند سنٛدؠ شٲگرد  ٲسؠ۔   سُہ گو یروشلمس منٛز سردار کاہنس نِشہٕ، 
\v 2 تہٕ کوٚرنس درخواست زِ سُہ لیٚکھِن دمشقس منٛز یہُودؠ عبادت گاہ کٮ۪ن رہنماہن ساوُل سُنٛد تعارف دِتھ تِمن نامہٕ۔   نامن منٛز آو تِمن وننہٕ زِ ساوُلس دِین اختیار یُتھ سُہ کانٛسہِ تہِ زنہِ یا مردس رٔٹِتھ انہِ یمو سۅ وتھ اختیار کٔرمٕژ آسہ یۅسہ تِمن یسوعنؔ ہٲو،  تہٕ تِمن واتناوِ قٲدؠ بنٲوِتھ یروشلم تاکہ یہُودؠ رہنما دِن تِمن انصاف بوزِتھ سزا۔  
\p
\v 3 ییٚلہ ساوُل تہٕ تمسنٛدؠ سٲتھی سفرس دوران دمشق نزدیک وٲتؠ اچانک چمکیاو ساوُلس اندؠ پٔکؠ آسمانہٕ پیٚٹھُک اکھ چمکہٕ وُن گاش۔  
\v 4 سُہ او یکدم پتھر لاینہٕ۔   پتہٕ بوز تٔمؠ کمسنٛز تانؠ آواز یۅسہ تمِس ونان ٲس،  "ساوُل،  ساوُل،  ژٕ کیازِ چُھکھ مےٚ تکلیف دِنٕچ کوشش کران؟
\p
\v 5 ساوُلنؔ پرُژھ تمِس،  "خداوند،  توٚہؠ کم چُھو؟ تٔمؠ دِتُس جواب،  "بہٕ چُھس یسوع،  یمِس ژٕ تکلیف دِوان چُھکھ۔  
\v 6 ووٚنؠ گژھِ کھڑا تہٕ وات شہرس منٛز! تتہِ ؤنی ژےٚ کانٛہہ زِ بہٕ کیاہ چُھس ژےٚ اتتھِ کرناون یژھان"
\v 7 تِم نفر یمہ ساوُلس سٟتؠ سفرس منٛز ٲسؠ سپدؠ تِتھؠ حٲران زِ تِمو ہیٚوک نہٕ کینٛہہ ونِتھ۔   تِم گے تٔتی رٔہِتھ۔   تِمو بوزٕ خداوند سنٛزٕ کتھٕ،  مگر وُچِھتھ ہیٚککھ نہٕ کہین۔  
\p
\v 8 ساوُل وۅتھ پتھرِ تھوٚد مگر ییٚلہ تٔمؠ أچھ مُژراوِ تٔمؠ ہیٚوک نہٕ کِہین وُچِھتھ۔   تہٕ تمؠ سنٛدیو سٲتھیٚو واتنوو سُہ تھف کٔرِتھ دمشق۔  
\v 9 تریٚن دوٚہُن ہیٚوک نہٕ ساوُلنؔ کہین تہِ وُچِھتھ تہٕ نہ ہیٚکُن کینٛہہ کھیٚتھ چیٚتھ۔  
\p
\v 10 دمشقس منٛز اوس یسوع سُنٛد اکھ ژاٹھ یمِس حننیاہؔ ناو اوس۔   خداوندن دیُت تس جلوٕ تہٕ وُننَس،  "حننیاہؔ!" تٔمؠ ووٚنُس "خداوند،  بہٕ چُھس بوزان"
\v 11 خداوند یسوعنؔ ووٚن تس زِ یمہ سیٚزِ وتہِ گژھِ ہُتھ گرس منٛز یُس یہُوداؔ سُنٛد چُھ۔   تتہِ پرِژھ کانٛسہ زِ کیاہ ژٕ ہیٚککھا ترسسؔ کِس ساوُل ناوٕ کِس نفرس سٟتؠ کتھ کٔرِتھ،  تکیازِ سُہ چُھ وُنکٮ۪ن مےٚ دُعا منٛگان۔  
\v 12 ساوُلنؔ وُچھ اکھ پرتوا یتھ منٛز تٔمؠ حننیاہؔ ناوک اکھ نفرا تٔمؠ تتھ گرس منٛز اژان وُچھ یتہِ سُہ ٹھہرِتھ اوس تہٕ تھٲوِن پنٕنؠ اتھٕ تس پیٚٹھ تاکہِ سُہ ہیٚکہ ہے دوبارٕ وُچِھتھ۔  
\p
\v 13 حننیاہنؔ دِتُس جواب،  "اے خداوند،  واریہو لوٗکو ووٚن مےٚ أمِس شخصس متعلق۔   أمؠ چُھ یروشلمس منٛز تمن لوٗکن سٟتؠ واریاہ بُرٕ کامہِ کرمژٕ یمو توٚہہِ پیٚٹھ ایمان اوٚنمُت چُھ۔  
\v 14 زِٹھیٚو کاہنو چُھ أمِس یور دمشق ینُک حکم کوٚرمُت تاکہ تِمن نفرن کرِ گرفتار یمو توٚہہ پیٚٹھ ایمان اوٚنمُت چُھ۔  
\v 15 مگر خداوند یسوعنؔ ووٚن حننیاہسؔ،  "ساوُلسؔ نِش گژھِ! یہ بہٕ ونے تہِ کر تکیازِ مےٚ چُھ سُہ پننہِ خدمتہٕ خٲطرٕ ژورمُت تاکہ سُہ کرِ غٲر یہُودینؔ،  تہنٛدین بادشاہن تہٕ اسرائیل ین سٟتؠ مےٚ متعلق کتھ۔  
\v 16 بہٕ ونہٕ تس پانہ زِ لوٗکن مےٚ متعلق وننہٕ خٲطرٕ پیٚنے ژےٚ اکثر جاین مصیبت تُلٕنؠ"
\p
\v 17 لہٰذا دراو حننیاہؔ تہٕ ساوُل سُنٛد گرٕ لٔبتھ ژاو سُہ اندر۔   پتہٕ یتُھےٕ سُہ ساوُلس سمُکھ،  تٔمؠ تھٲوؠ پنٕنؠ اتھٕ تس پیٚٹھ،  تہٕ وُننَس،  "ساوُل بایا،  خداوند یسوعنؔ دیُت مےٚ پانے توٚہہِ نِش ینُک حکم۔   سُہ چُھ سُے یُس ونہِ کٮ۪ن توٚہہ تمہِ ساعتہٕ ظٲہر سپُد ییٚلہ توٚہؠ دمشقس منٛز وتہِ پکان ٲسِو۔   تمؠ سوزُس بہٕ توٚہہ نِش تاکہِ توٚہؠ ہکیٚو دوبارٕ وُچِھتھ تہٕ توٚہہِ روزیٚو مکمل پٲٹھؠ روح القدس سنٛدِس قوبوس منٛز۔  
\v 18 یکدم آو ساوُل سنٛزو أچھو منٛزٕ گاڈٕ زال ہیٚو کہتام چیز وسِتھ تہٕ سُہ گو دُبارٕ وُچھنس اہل۔   پتہٕ وۅتھ سُہ تھوٚد تہٕ آس بپتسمہ دنہِ۔  
\v 19 ییٚلہ ساوُلنؔ کینٛہہ کھیٚو چیٚو تہٕ تمِس آیہ دوبارٕ ہمتھ۔   ساوُل رود واریہن دوٚہُن دمشقس منٛز باقی ایمان والیٚن ژاٹن سٟتؠ۔  
\p
\v 20 سُہ لوٚگ جلدےٕ یہُودؠ عبادت خانن منٛز یسوع سنٛز منٲدی کرنہِ۔   تٔمؠ ووٚن تِمن زِ یسوع چُھو خدایہ سُنٛد گۅبُر۔  
\v 21 یِمو تہِ لوٗکو سُہ یسوع سنٛز منٲدی کران وُچھ تِمن سپٕز حٲرت۔   تِمو منٛزٕ ٲسؠ کینٛہہ ونان،  "أسؠ چھِ مشکِلنےٕ یقین کٔرِتھ ہیٚکان زِ یہ چھا سُے شخص یُس یروشلمس منٛز ایمان والیٚن مقابلہٕ لوٚگ تہٕ یُس تِمہ قٲدؠ بنٲوِتھ یروشلمس منٛز سردار کاہنن نِشہٕ اننہٕ خٲطرٕ تیار سپُد!"
\v 22 مگر خداین بنوو ساوُل یتھ قٲبل زِ سُہ ہیٚکہِ واریہن لوٗکن امہِ کھۅتہٕ تہِ زیادٕ اعتمادٕ سان تبلیغ کٔرِتھ۔   سُہ چُھ صحیفو سٟتؠ ثٲبت کران زِ یسوع چُھ مسیح۔   اوٕ کِنؠ ہیٚکن نہٕ دمشقٕکؠ یہُودؠ رہنما یہ سوچتھےٕ زِ أمسنٛز کتھ کرٕہو غلط ثٲبت۔  
\p
\v 23 کینٛہہ کال گٔژھتھ کٔر تتہِ کیٚو یہُودؠ سردارو یہ قتٕل کرنٕچ سٲزِش۔  
\v 24 سُہ اوس دوٚہس راتس یہُودؠ شہرٕکیٚو تمام دروازو کِنؠ نیرتھ لوٗکن منٛز ژھٲنٛڈ دِوان تاکہ ساوُل گژھِ نظرِ تہٕ سُہ کر وون قتٕل۔   حالانکہ کٔمؠ تام ووٚن ساوُلسؔ زِ تِم کیاہ کرنُک اِرادٕ چُھ۔  
\v 25 مگر یم ژاٹھ تٔمؠ یسوعسؔ پیٚٹھ ایمان اننٲومٕتؠ ٲسؠ تِمو منٛزٕ نیٚو سُہ کینٛژو روتلہِ کنٮ۪ن ہنٛدِس تتھ تھدِس دیوارس نِش یُس شہرس گیرٕ کٔرِتھ اوس۔   تِمو تُل سُہ رزو سٟتؠ گنٛڈِتھ اکِس ٹوکرِ منٛز تہٕ ترووُکھ دیوارکہِ اکہ کھنہٕ منٛزؠ بوٚن۔   یتھٕ کٔنؠ ژۅل سُہ دمشق شہرٕ منٛزٕ۔  
\p
\v 26 ییٚلہ ساوُل یروشلم ووت تہٕ تٔمؠ کٔر باقی ژاٹن سمکھنٕچ کوشش۔   تاہم ٲسؠ سٲری تس کھۅژان،  تکیازِ تِمن اوس نہٕ بیہوان زِ سُہ چُھ اکھ ایماندار بنیٚومُت۔  
\v 27 مگر برنباسنؔ نیٚو سُہ رسولن نِشہٕ۔   تٔمؠ ووٚن نبین یتھٕ پٲٹھؠ زِ ییٚلہ ساوُل دمشق چیٚو وتو صفر کران اوس،  تٔمؠ وُچھ تتہِ خداوند یسوع،  تہٕ تتہِ کِتھٕ کنؠ کٔر خداوند یسوعنؔ أمِس سٟتؠ کتھ۔   تٔمۍ ووٚن تِمن یتہِ زِ ساوُلنؔ کِتھٕ پٲٹھؠ کٔر جُرتہٕ سان دمشقس منٛز لوکن سٟتؠ یسوعسؔ متعلق کتھ۔  
\p
\v 28 چناچہ ساوُل اوس سٲرسےٕ یروشلمس منٛز نبین تہٕ باقی ایمان والیٚن سمکھان تہٕ لوٗکن بڈٕ ہمتہٕ سان خداوند یسوعسؔ متعلق ونان۔  
\p
\v 29 ساوُل اوس یونٲنؠ بولن والیٚن یہُودٮ۪ن سٟتؠ تہِ یسوعسؔ متعلق کتھ کران تہٕ تِمن سٟتؠ بحث تہِ کران۔   مگر تِم ٲسؠ لگاتار سُہ مارنٕچہِ وتہِ ہنٛدِس تلاشس منٛز۔  
\v 30 ییٚلہ باقی ایمان والیٚو بوز زِ یہُودؠ چھِ أمِس قتٕل کرنُک اِرادٕ کران تہٕ تِمو منٛزٕ نیٚو ساوُل کینٛژو قیصریہ کِس شہرس منٛز۔   تتہِ بیہنوو سُہ تِمو اکِس جہازس پیٚٹھ یُس تمسنٛدِس آبٲئی شہر ترسسؔ کُن گژھان اوس۔  
\p
\v 31 چناچہ یہُودیہ،  گلیلؔ تہٕ سامریہ ہنٛدین تمام علاقن ہنٛدؠ ایمان واجنہِ جمٲژ آسہ امنہٕ سان روزان تکیازِ ووٚنؠ اوس نہٕ تِمن پیٚٹھ کانٛہہ تہِ ظلم کران۔   پاک روحُک طاقت اوس تِمن حوصلہٕ تہٕ طاقت دِوان۔   تِم ٲسؠ خداوند یسوع سنٛز عبادت جٲری تھٲوِتھ،  تہٕ پاک روح اوس واریہن دویمٮ۪ن لوٗکن ایمان وٲلؠ بننس کُن رٲغب کران۔  
\p
\v 32 ییٚلہ پطرس تِمن علاقن منٛز سفر کران اوس تہٕ اکہِ پھرِ گو سُہ سٲحلی مٲدانن منٛز تِمن پژھ،  والیٚن سمکھنہِ یمہ لُدہ شہرس منٛز روزان ٲسؠ۔  
\p
\v 33 تتہِ سمُکھ سُہ اینیاسؔ ناوٕ کِس اکِس نفرس۔   اینیاسؔ اوس نہٕ ٲٹھو وریو پیٚٹھٕ بسترٕ منٛزٕ نیٚبرےٕ درامُت تکیازِ تس ٲس فالٕج گٔمٕژ تہٕ اوس چارپایہِ پیٚٹھ۔  
\v 34 پطرسن ووٚن تس،  "اینیاسؔ،  یسوع مسیح چھی ژےٚ شِفا عطا کران۔   وۅتھ وٹھ پنُن بستر!" اینییاسؔ وۅتھ جلدےٕ تھوٚد۔  
\v 35 واریہو لوٗکو یمہٕ لُدہ تہٕ شارُون کٮ۪ن مٲدانن منٛز روزان ٲسؠ اوٚن خداوند یسوعسؔ پیٚٹھ ایمان ییٚلہ تِمو خداوند سنٛدِ شفا پتہٕ اینیاسؔ وُچھ۔  
\p
\v 36 یافاؔ شہرس منٛز ٲس اکھ ایمان واجِنؠ روزان یمسُنٛد ناو تبیتاؔ اوس۔   یونٲنؠ زبٲنؠ منٛز اوس تمیُک مطلب ڈوراکاس اوس۔   سُہ ٲس ہمیشہ غریبن ہنٛدِ باپتھ رُت کانٛچھان تہٕ تِمن ضرورتٕکؠ چیز فراہم کران۔  
\v 37 یمہِ ساعتہٕ پطرس لُدہس منٛز اوس سۅ سپٕز بٮ۪مار تہٕ گُزرییہ۔   تتِچو کینٛژو مستوراتو دیُت تس یہُودؠ رسمو مطٲبق غسُل۔   تہٕ پتہٕ تھٲوکھ تمؠ سنٛز لاش کفنہٕ ؤلِتھ تمسنٛدِس گرٕکِس پیٚٹھمِس کمرس منٛز۔  
\p
\v 38 لُدہ اوس یافا شہرس نکھے،  اوٕ کِنؠ ییٚلہ شاگردو بوز زِ پطرس چُھ وُنہٕ لُدہ شہرسےٕ منٛز تہٕ تِمو کٔڈؠ زٕ نفر پطرسس نِش گژھنہٕ خٲطرٕ۔   ییٚلہ تمہ پطرس سنٛزِ جایہ وٲتؠ تہٕ تِمو کٔر تس عرضی،  "مہربٲنی کرِتھ یہ اسہِ سٟتؠ جلدی یافا!
\v 39 پطرس گو دستی تیار تہٕ دراو تِمنےٕ سٟتؠ۔   ییٚلہ تِم واپس یافا پنُن گرٕ وٲتؠ تِمو کھول سُہ سیوٚدُے ہیٚرمِس کمرس منٛز یتہِ دورکاسؔ سنٛز لاش پتھر ٲس۔   تتہِ موجود سارے مونٛڈٕ آس تس انٛدؠ انٛدؠ کھڑا ودان۔   تِمہ ٲسؠ تس تِمہ پلو تہٕ ملبوسات ہاوان یمہ ڈوراکاہہِ لوٗکن کِتؠ بنٲومٕتؠ ٲسؠ ییٚلہ سۅ زنٛدٕ ٲس۔  
\p
\v 40 مگر پطرسن کٔڈؠ تمہٕ سٲری کمرٕ منٛزٕ نیٚبر۔   پتہٕ وُتھ کۅٹھٮ۪ن پیٚٹھ تہٕ کوٚرُن دُعا۔   پتہٕ پھیور تمؠ سنٛزِ لاشہِ کُن،  تٔمؠ ووٚن،  "تبیتاؔ،  وۅتھ تھوٚد!" تمہِ مُژراوِ یکدم أچھ،  تہٕ پطرس وُچِھتھ ہیٚوتُن تھوٚد وتُھن۔  
\v 41 تٔمؠ کٔر تمِس اتھس تھف تہٕ کوٚرنس تھوٚد وتھنس منٛز مدد۔   پتہٕ أنِن ایمان وٲلؠ تہٕ خاص کر تِمہ موٚنٛڈٕ انٛدر ناد دِتھ تہٕ ہٲونکھ زِ سۅ چھےٚ بیٚیہِ زنٛدٕ۔  
\v 42 یکدم گییہِ یافا کٮ۪ن سارنےٕ لوٗکن منٛز امہِ معجزٕچ ٹُبے تہٕ امہِ سببہٕ اوٚن واریہو لوٗکو خداوند یسوعسؔ پیٚٹھ ایمان۔  
\v 43 پطرس رود واریہن دوٚہُن یافاہس منٛز شمعون ناوٕ کِس نفرس نِش یُس گُپن دالس چمبرٕ بناوان اوس۔
\c 10
\p
\v 1 کُرنیلیُسؔ ناوُک اکھ شخص اوس قیصریہؔ شہرس منٛز روزان۔   سُہ اوس اکھ حٲکم یُس اٹلی ہنٛدین رومی سِپہن ہنٛزِ اکِس ہتہٕ نفرنہِ بجہ جمٲژ قیادت کران اوس۔  
\v 2 سُہ اوس ہمیشہ تہِ کرنٕچ کوشش کران یمہِ سٟتؠ خدا رٲضؠ سپدِ۔   سُہ تہٕ تمسُنٛد سٲری گرٕ بٲژ ٲسؠ غٲر یہُودؠ یمہٕ رسمن خدایہ سنٛز عبادت کران ٲسؠ۔   سُہ اوس کُنہِ کُنہِ وزِ غریب یہُودؠ لوٗکن پونٛسہٕ رنٛگؠ مدد کران،  سُہ اوس ہمیشہٕ خدایس دُعا منٛگان۔  
\p
\v 3 اکہِ دوٚہہ دِگرس لگ بگ ترییہِ بجہِ آو کُرنیلیُسسؔ اکھ رویا۔   تٔمؠ وُچھ ننہِ وانہٕ اکھ فرشتہٕ یُس خداین سوزمُت اوس۔   تٔمؠ وُچھ فرشتہٕ پننِس کمرس منٛز اژان تہٕ تمِس ونان،  "کُرنیلیُسؔ!"
\v 4 کُرنیلیُسن وُچھ فرشتس کُن تہٕ کھوژ۔   پتہٕ پرُژھ تٔمؠ کھوژؠ کھوژؠ،  "جناب،  توٚہؠ کیاہ چُھو یژھان؟" خدایہ سنٛدِ طرفہٕ سوزنہٕ آمٕتؠ فرشتن دِتُس جواب،  ژےٚ گوےٕ خدا رٲضؠ تکیازِ ژٕ رودُکھ ہمیشہٕ تس دُعا منٛگان تہٕ ژٕ چُھکھ اکثر غریبن غُرباتن پونٛسہٕ دِتھ مدد کران۔   تِم چیز چھِ خدایس برُونٛہہ کنہِ یادگار قربٲنیہِ۔  
\v 5 لہٰذا دِیو کینٛژن نفرن حکم زِ تَم گژھن یافاؔ تہٕ تِمن ؤنیٚو زِ شمعون ناوٕ کِس اکِس شخصس انن واپس یمِس بیاکھ ناو پطرس چُھ۔  
\v 6 سُہ چُھ اکِس نفرس نِش ٹھہرِتھ یمِس شمعون ناو چُھ سُہ چُھ چمبرٕ بناوان۔   تمسُنٛد گرٕ چُھ سمندرس نکھٕ"
\p
\v 7 ییٚلہ سُہ فرشتہٕ دراو یُس کُرنیلیُسؔ سٟتؠ کتھٕ اوس کران تہٕ تٔمؠ أنؠ پننہِ گریٚکؠ زٕ ملٲزم تہٕ اکھ سِپاہ ناد دِتھ یمہٕ تمسنٛدؠ خٲدم ٲسؠ تہٕ اکھ اوس خدایہ سنٛز عبادت تہِ کران۔  
\v 8 تٔمؠ سمجھٲوؠ تِم تہِ سورےٕ یہ فرشتن تمِس ووٚن۔   پتہٕ ووٚن تٔمؠ تِمن زِ یافا شہر گٔژھِتھ ؤنیٚو پطرسس قیصریہ ینہٕ خٲطرٕ۔  
\p
\v 9 دویمہِ دوٚہہ دوپہرس بٲگؠ ٲسؠ تِم تریٚنوے نفر وتہِ پکان یافاؔ ہس نزدیک وٲتمٕتؠ۔   ییٚلہ تِم یافا شہرس نزدیک ٲسؠ تہٕ پطرس کھۅت گرٕ کِس پشس پیٚٹھ دُعا کرنہٕ خٲطرٕ۔  
\v 10 سُہ اوس بۅچھِ ہوٚت،  کینٛہہ کھیٚون یژھان۔   ییٚلہ لوٗکھ کھیٚن تیار کران ٲسؠ تہٕ پطرسس گٔییہِ نظر یلہٕ۔  
\v 11 تٔمؠ وُچھ آسمان یلہٕ گژھان تہٕ اکھ کھلہٕ ژادر ہِش زمینس پیٚٹھ پیٚوان تہٕ یتھ ژۅنوے کوٗن ہیٚور کُن ٲسؠ۔  
\v 12 اتھ ژادرِ منٛز ٲسؠ پرٛتھ کُنہ قسمٕکؠ جاندار۔   اتھ منٛز ٲسؠ تمہٕ جانور تہٕ جاناوار تہِ شٲمل یمہٕ موسوی قانونو کِنؠ یہُودؠ لوٗکن کھیٚنؠ منع ٲسؠ۔   کینٛژن آسہٕ ژور زنٛگہٕ،  کینٛہہ ٲسؠ کھکھرٮ۪ل تہٕ کینٛہہ جنگلی جاناوار۔  
\p
\v 13 پتہٕ بوز تٔمؠ خدا تس ونان زِ پطرس وۅتھ تھوٚد تہٕ یمو منٛزٕ مارُن کانٛہہ تہٕ کھیٚن۔  
\v 14 مگر پطرسن ووٚنُس جواب،  "خداوند،  توٚہؠ چُھو پزؠ کِنؠ یژھان زِ بہٕ گوٚژھُس نہٕ یہ کرُن،  تکیازِ مےٚ چُھنہٕ ونیُک تام زانٛہہ تہِ سُہ چیز کھیٚمُت یُس سانہِ یہُودؠ شریعتہٕ مطابق تُہنٛدِ خٲطرٕ چھلہٕ نَے آسہ یا سُہ چیز یُس نہٕ اسہِ کھیٚون پزِ"
\v 15 پتہٕ بوز پطرسن بیٚیہِ خدا تس کُن ونان۔   تٔمؠ ووٚن:" بہٕ چُھس خدا،  لہٰذا اگر مےٚ کانٛہہ چیز کھیٚنہٕ باپتھ قٲبلِ قبوٗل یعنی پاک بنوو تہٕ ژمہٕ ون زِ یہ چُھ کھیٚنہٕ باپتھ ناپاک"
\v 16 یہ سپُد ترییہِ پھرِ۔   امہِ پتہٕ کٔھژ یکدم جاناوارن تہٕ جانورن ہنٛز یہ ژادر آسمان کُن بیٚیہِ واپس۔  
\p
\v 17 وُنہِ اوس پطرس یہ سمجھنٕچ کوششےٕ کران زِ امہِ خوابُک مطلب کیاہ چُھ،  تِم نفر وٲتؠ یمہٕ کُرنیلیُسن سوٗزمٕتؠ ٲسؠ۔   تِم ٲسؠ لوٗکن پرِژھان زِ شمعون سُنٛد گرٕ کپٲرؠ چُھ گژُھن۔   چناچہ تِمو لوٚب تمسُنٛد گرٕ تہٕ رودؠ دروازس پیٚٹھ ودٕنؠ۔  
\v 18 تِمو دیُت آلو تہٕ پرژھُکھ زِ یتہِ چھا شمعون ناوک کانٛہہ نفر روزان یمسُنٛد بیاکھ ناو پطرس چُھ؟
\p
\v 19 پطرس اوس وُنہِ تمہ خابُک تعبیر سمجھنچی کوشش کران زِ خدایہ سنٛدؠ روحَن ووٚن تس،  بوزیٚو! ترےٚ نفر چھِ یتہِ یمہ توٚہہ سمکھُن چھِ یژھان۔  
\v 20 لہٰذا وۅتھ تہٕ وس بوٚن تہٕ گژھِ تِمن سٟتؠ۔   یہ سونٛچ زیٚنہٕ زِ مےٚ پزِنہٕ تِمن سٟتؠ گژُھن،  تکیازِ تِم چھِ مےٚ یور سوزمٕتؠ"
\v 21 یتھ کنؠ وۅتھ پطرس تہٕ گو تِمن نفرن نِش تہٕ کٔرن تِمن سلام! بہٕ چُھس سُہ نفر یُس توٚہؠ ژھانٛڈان چھون،  توٚہؠ کیازِ او؟"
\p
\v 22 تِمو ونہَس در جواب،  "رومی فوجی افسر کُرنیلیُسن سوزؠ أسؠ یور۔   سُہ چھِ سیٚٹھاہ جان شخص یُس خدایہ سنٛز عبادت کران چُھ،  تہٕ سٲری یہُودؠ لوٗکھ یمہ تس زانان چھِ،  چھِ ونان زِ سُہ چُھ اکھ نیک انسان۔   أکؠ فرشتن ووٚن تس،  "کینٛژن نفرن وَن یمہٕ یافا گژھن تہٕ تتہِ شمعون پطرسس وچُھن تہٕ تس انن یور تاکہِ توٚہؠ بوزیٚو زِ سُہ کیاہ چُھ ونُن یژھان۔  
\v 23 پطرسن ژٲنؠ تِم گرٕ تہٕ وُننکھ توٚہہِ پزِ راتس یتؠ روزُن۔   دویمہِ دوٚہہ دراو پطرس تیار گٔژھتھ یِمن نفرن سٟتؠ۔   یافا ہٕکؠ واریاہ ایمان وٲلؠ تہِ گے تمِس سٟتؠ۔  
\p
\v 24 بیٚکہ دوٚہہ وٲتؠ تِم قیصریہ شہرس منٛز۔   کُرنیلیُس اوس تِمن پراران۔   تٔمؠ ٲس پننٮ۪ن رشتہٕ دارن تہٕ نزدیکی دوستن تہِ اور ینٕچ دعوت دِژمٕژ تہٕ تِم تہِ ٲسؠ امسنٛدِس گرس منٛز موجود۔  
\p
\v 25 ییٚلہ پطرس گرس منٛز دٲخٕل سپُد،  کُرنیلیُسؔ سمُکھ تمِس تہٕ کوٚرنس برُونٛہہ کنہٕ عبادت کہ غرضہٕ جکِتھ سجدٕ۔  
\v 26 مگر پطرسن کٔر کُرنیلیُسؔ اتھس تھف تہٕ تلُن پننیٚو کھۅرو پیٚٹھٕ تھوٚد۔   تہٕ ووٚننس،  تھوٚد وُتھ! جُکِتھ گژھِ نہٕ میانؠ عبادت کرٕنؠ! بٕتہ چُھس توٚہے ہیٚو اکھ انسان!"
\p
\v 27 ییٚلہ سُہ کُرنیلیُسؔ سٟتؠ کتھٕ اوس کران تہٕ پطرس تہٕ باقی ژاے اندر تہٕ اتہِ وُچِھکھ واریاہ لوٗکھ سمیامٕتؠ۔  
\v 28 پتہٕ وُتھ پطرس تِمن کُن "توٚہؠ سٲری چُھو زانان زِ اسہِ منٛزٕ چُھنہٕ کانٛہہ تہِ یہُودؠ یہ سمجھان زِ أسؠ چھِ پننٮ۪ن یہُودؠ قانونن ہنٛز نافرمٲنی کران۔   اگر أسؠ تِمن لوٗکن سٟتؠ یمہ غٲر یہُودؠ مالٮ۪ن ہنٛدؠ اولاد آسن یا تِمن ہنٛدین گرن منٛز تہِ گژھو۔   تاہم چُھ مےٚ خداین خابس منٛز ہوومُت زِ مےٚ پزِ نہٕ کانٛسہ تہِ تیوت نجِس تہٕ ناپاک ونُن زِ خدا کرِنہٕ تس قبوٗلےٕ۔  
\v 29 ووٚنؠ ییٚلہ توٚہہ کینٛہہ نفر مےٚ وننہٕ خٲطرٕ سوزؠ ووٗکھ زِ یور یِیو تہٕ بہٕ آس یکدم کنہِ اعتراضہٕ بغٲر۔   ۅ ؤنتو مہربٲنی کٔرِتھ زِ توٚہہِ کیازِ اوٚنووس بہٕ یور ناد دِتھ؟
\p
\v 30 کُرنیلیُسن ونُکھ یورٕ،  "تقریبن ترےٚ دوٚہہ برُونٛہہ یمے وقتہٕ،  اوسس بہٕ گرِ خدایہ سنٛز عبادت کران،  یتھ کنؠ بہٕ ہمیشہٕ دوپہرس ترییہِ بجہِ کران چُھس۔   اچانک سپُد مےٚ برُونٛہہ کنہِ اکھ نفرا کھڑا یمسنٛدؠ پلو پرٮ۪زلان ٲسؠ
\v 31 تہٕ ونُن،  "کُرنیلیُسؔ،  خداین کوٚر چون دُعا قبول۔   تٔمؠ وُچھ یتہِ زِ توٚہہ چُھو اکثر غریبن پونٛسہٕ دِتھ مدد کوٚرمُت،  تہٕ سُہ چُھ تمہِ سٟتؠ خۅش۔  
\p
\v 32 تہٕ ووٚنؠ سوز یافا شہرٕ خٲطرٕ قٲصد تاکہ تمہ ونن شمعونسؔ یس بیاکھ ناو پطرس چُھ یور ینہٕ خٲطرٕ۔   سُہ چُھ سمندرس نکھٕ أکِس گرس منٛز ٹھہرِتھ۔   یُس شمعون ناوٕ کِس بییِس اکِس نفرٕ سُنٛد چُھ یُس چمبرٕ بناونٕچ کٲم کران چُھ"
\v 33 لہٰذا سوزؠ مےٚ جلدےٕ کینٛہہ نفر یمو توٚہہِ یور ینہٕ باپتھ ووٚن تہٕ بہٕ چُھس پزِ دِلہ تُہنٛد شکریہ کران۔   ووٚنؠ گے أسؠ سٲری یتہِ جمع،  یہ زٲنِتھ زِ خدا چُھ اسہِ سٟتؠ،  تاکہ تمہٕ سارے کتھٕ بوزو یمہٕ خداوند خداین توٚہہِ وننُک حکم دیُتمُت چُھ۔   مہربٲنی کٔرِتھ ؤنؠ تو اسہِ"
\p
\v 34 تہٕ پطرسؔ لوٚگ تِمن سٟتؠ کتھٕ کرنہِ۔   تٔمؠ ووٚن،  "ووٚنؠ آو مےٚ سمجھ،  یہ چُھ پزر زِ خدا چُھنہٕ صرف لوٗکن ہنٛزن کینٛژن جمٲژن پسنٛد کران۔  
\v 35 بلکہ چُھ سُہ پرٛتھ لوٗکہٕ جمٲژ منٛزٕ ہر کانٛسہِ تس شخص قبول کران یُس تمؠ سنٛز عبادت تہٕ تس احترام کران چُھ۔  
\p
\v 36 توٚہؠ چُھو سُہ پٲغام زانان یُس خداین اسہِ بنی اسرائیل ین سوزمُت چُھ۔   تٔمؠ چھِ أسؠ خۅش خبر بوزٕنٲوؠ مٕتؠ زِ سُہ کرِ یسوع مسیحؔ سنٛزو کامیٚو سببہٕ لوٗکن پانس سٟتؠ صلح۔   یہ یسوع چُھنہٕ صرف اسہِ بنی اسرائیل ین ہُنٛد خداوند۔   سُہ چُھ سُہ خداوند یُس سارنےٕ لوٗکن پیٚٹھ حکومت کران چُھ۔  
\v 37 توٚہؠ چُھو زانان زِ تٔمؠ کیاہ کوٚر سٲرسےٕ یہُودیہ ہس منٛز گلیلؔ پیٚٹھٕ شروعات کٔرِتھ۔   تٔمؠ کٔر یہ کام تمہِ وقتہٕ شروع ییٚلہ یوحنا لوٗکن یہ ونان اوس زِ تِم یِین پننیٚو گُنہو نِشہٕ باز تمہِ برُونٛہہ زِ سُہ دییہ تِمن بپتسمہ۔  
\v 38 توٚہؠ چُھو زانان زِ خداین کوٚر یسوعسؔ پنُن پاک روح عطا یُس ناصری شہرُک روزن وول اوس تہٕ تمِس دتُن معجزات کرنُک طاقت۔   توٚہؠ چُھو یتہِ زانان زِ یسوع کِتھٕ پٲٹھؠ ووت مختلف جاین،  ہمیشہٕ رود رژٕ کامہِ کران تہٕ لوٗکن شِفا بخشان۔   سُہ اوس تِمن لوٗکن اتھٕ شہلاوان یمن شیطان تکلیف واتناوان اوس۔   یسوع اوس یمہٕ کامہِ کرنس اہل تکیازِ تس اوس ہمیشہٕ خدا مدد کران۔  
\p
\v 39 "اسہِ ساروےٕ وُچھ زِ یسوعنؔ کیاہ کیاہ کوٚر یروشلمس تہٕ اسرائیل کٮ۪ن تِمن علاقن منٛز یمن منٛز سُہ روزان اوس۔   تمسنٛدیٚو دشمنو ژُھن سُہ لکٕرِ ہنٛدِس صلیبس پیٚٹھ کِلیٚو سٟتؠ بند کٔرِتھ مٲرِتھ۔  
\v 40 پتہٕ کوٚر سُہ خداین تمسنٛدِ مرنہٕ پتہٕ ترییہِ دوٚہؠ دوبارٕ زندٕ کٔرتھ تہٕ تٔمؠ بنٲو یہ کتھ یقینی زِ تمسنٛدِ زندٕ گژھنہٕ پتہٕ گژھن واریاہ لوٗکھ تمِس زندٕ وُچھِنؠ۔   لوٗکن ٲس پژھ زِ یہ چُھ سُے یُس گُزریوو،  تہٕ ووٚنؠ وُچھ تِمو پننیٚو أچھو تہٕ گوکھ مکمل یقین،  زِ سُہ سپُد دوبارٕ زندٕ۔  
\v 41 تمہِ ساعتہٕ دیُت نہٕ خداین سُہ سارنےٕ وُچھنہٕ صرف تِمن یمہٕ تٔمؠ ژٲرؠ تمِس سٟتؠ وق گذرنہٕ باپتھ تہٕ تمِس سٟتؠ تِمن گۅڈنِکیٚن دوہُن کھیٚن کھیٚنہٕ باپتھ ییٚلہ سُہ خداین دوبارٕ زندٕ کوٚر۔  
\p
\v 42 خداین کوٚر اسہِ یہ حکم زِ أسؠ باوو لوٗکن تہٕ تٔمؠ ووٚن اسہِ،  تِمن ؤنیٚو زِ تٔمؠ کوٚر یسوعؔ اکہِ دوٚہہ باپتھ توٚہہ سارنےٕ ہُنٛد جج مقرر،  سُہ دوٚہہ چُھ ینہٕ وول۔   سُہ کرِ تِمن سارنےٕ لوٗکن سٟتؠ انصاف یمہ ونیُک تام زنٛدٕ چھِ تہٕ تِمن سارنےٕ لوٗکن سٟتؠ یمہٕ پتھ کُن گذریمٕتؠ چھِ۔  
\v 43 تِمو تمام نبیو یمو امسنٛدِس بارس منٛز واریاہ برُونٛہہ لیٚوکھمُت چُھ ووٚن أمِس متعلق لوٗکن۔   تِمو چُھ لیٚوکھمُت زِ اگر کانٛہہ أمِس پیٚٹھ ایمان انہِ،  تہٕ خدا ہیٚکہِ تمسنٛدؠ گناہ معاف کٔرِتھ یمہٕ تٔمؠ کٔرمٕتؠ آسن،  تکیازِ أمؠ شخصن،  یسوعنؔ چُھ تہنٛدِ خٲطرٕ تہِ کوٚرمُت۔  
\p
\v 44 وُنہِ اوس پطرس یمہٕ کتھٕ ونٲنی زِ اچانک گو تِمن سارنی لوٗکن پیٚٹھ روح نٲزِل یمہٕ دویمیٚن ملکن ہنٛدؠ لوٗکھ پٲغام بوزان ٲسؠ۔  
\v 45 یہُودؠ ایمان وٲلؠ یمہ پطرسس سٟتؠ یافا پیٚٹھٕ آمٕتؠ ٲسؠ سپٕدؠ حٲران زِ خداین بٔرؠ مختلف قومن ہنٛدین لوٗکن ہنٛدؠ دِل تہِ پاک روح سٟتؠ۔  
\p
\v 46 یہُودؠ ایمان وٲلؠ ٲسؠ زانان زِ خداین کیازِ کوٚر یہ تکیازِ تِم ٲسؠ یمن لوٗکن ہنٛزٕ تِژھٕ زبانہٕ بوزان یمہٕ نہٕ تِمو ہیٚچھمژٕ آسہٕ تہٕ ونان ٲسؠ زِ خدا کوتاہ عظیم چُھ۔   پتہٕ ووٚن پطرسن
\v 47 تتہِ موجود باقی یہُودؠ ایمان والیٚن،  "خداین کوٚر یِمن روح القدس عطا یتھ کنؠ تٔمؠ اسہِ یہُودینؔ کوٚر،  لہٰذا کٔریٚو توٚہؠ اتھ سٟتؠ اتفاق زِ أسؠ دِمو یِمن لوٗکن بپتسمہ"
\v 48 پتہٕ ووٚن پطرسن یِمن غٲر یہُودؠ لوٗکن زِ توٚہہِ ییہِ یسوع مسیح ہس پیٚٹھ ایمان اننہِ کِنؠ بپتسمہ دِنہٕ۔   چناچہ تِمو دیُت تِمن سارنےٕ بپتسمہ۔   بپتسمہ رٹنہٕ پتہٕ کٔر تِمو پطرسس عرضی زِ سُہ روزِ کینٛژن دوٚہُن تِمنےٕ سٟتؠ۔   لہٰذا کوٚر پطرسن تہٕ باقی یہُودؠ ایمان والیٚو تی۔
\c 11
\p
\v 1 رسولو تہٕ دوٚیمیٚو پژھ،  والیٚو یمہٕ یہُودیہ صوبہٕ کٮ۪ن مختلف شہرن منٛز روزان ٲسؠ بوز لوٗکن نِش زِ کینٛژو غٲر یہُودؠ لوٗکو تہِ کٔر پژھ یسوعسؔ متعلق خدایہ سنٛدِس پٲغامس پیٚٹھ۔  
\v 2 مگر یروشلمس منٛز ٲسؠ کینٛہہ یہُودؠ ایمان وٲلؠ یمہٕ یژھان ٲسؠ زِ یسوع سنٛدین تمام پٲرو کارن گژھِ ختنہٕ کرنہٕ یُن۔   ییٚلہ پطرس قیصریہ پیٚٹھٕ یروشلم واپس آو تہٕ تِم سمٕکھؠ تمِس تہٕ کٔڈٕکھ تس کٕٹھ۔  
\v 3 تِمو ووٚن تس،  "یُتےٕ یوت چُھنہٕ غلط زِ توٚہؠ گو ختنہٕ روٚستیٚن غٲر یہُودینؔ ہُنٛد گرٕ بلکہ کھیٚو توٚہہِ تِمن سٟتؠ کھیٚن تہِ!
\p
\v 4 تہٕ پطرسن کٔر وضاحت کرٕنؠ شروع زِ کیاہ اوس واقہٕ سپُدمُت۔  
\v 5 تِمو ووٚن،  "بہٕ اوسس یافا شہرس منٛز کُنے زۅن دُعا منٛگان تہٕ أتھؠ منٛز وُچھ مےٚ اکھ جلوٕ۔   مےٚ وُچھ اکھ بٔڈ ژادر ہِش آسمانہٕ پیٚٹھٕ ژورن کونن گنٛڈِتھ وسان،  تہٕ سۅ ؤژھ پتھر یتِتھ بہٕ اوسُس۔  
\v 6 ییٚلہ مےٚ تتھ کُن وارٕ نظر دِژ تتھ منٛز وُچھ مےٚ کینٛہہ پالتو جانور،  جنٛگلی جانور،  کھکھرٮ۪ل جانور تہٕ آسمانس منٛز جنٛگلی جاناوار۔  
\p
\v 7 پتہٕ بوز مےٚ خدا حکم کران ونان،  "پطرس،  وُتھ مارکھ تہٕ کھیٚکھ!"
\v 8 مگر مےٚ ونُس یورٕ،  خداوند،  توٚہؠ چُھو پٔزؠ پٲٹھؠ یژھان زِ بہٕ گژھٕ یہ کرُن،  تکیازِ مےٚ چُھنہٕ زانٛہہ تہِ تیٚوتھ کینٛہہ کھیٚمُت یُس سانیٚو قانونو مطٲبق ناپاک چُھ۔  
\v 9 خداین دیُت آسمانہٕ پیٚٹھٕ مےٚ بیٚیہِ آلو،  "بہٕ چُھس خدا،  اگر مےٚ کانٛہہ چیز کھیٚون جٲئز تھوو،  سُہ گژھِ نہٕ ناپاک زانُن"
\v 10 یہ سپُد یتھے کنؠ بیٚیہِ دویہِ پھرِ،  تہٕ پتہٕ آیہ یہ ژادر تمام جانور تہٕ جاناوار ہیٚتھ بیٚیہِ آسمانس کُن واپس کھالنہٕ۔  
\p
\v 11 امی ساعتہٕ آے ترےٚ نفر یمہٕ قیصریہؔ پیٚٹھ سوزمٕتؠ ٲسِکھ ژاے اتھ گرس منٛز یتہِ بہٕ ٹھہرِتھ اوسُس۔  
\v 12 خدایہ سنٛدؠ روحن ووٚن مےٚ زِ مےٚ پزِ نہٕ یمن سٟتؠ نیرنس کانٛہہ تہِ درنٛگی کرٕنؠ،  یودوے تمہٕ یہُودؠ چھنہٕ۔   شےٚ ایمان وٲلؠ یہُودؠ تہِ آے مےٚ سٟتؠ قیصریہ تہٕ پتہٕ ژاے أسؠ أمِس غٲر یہُودؠ نفرٕ سُنٛد گرٕ۔  
\v 13 تٔمؠ ووٚن اسہِ زِ تٔمؠ وُچھ پننِس گرس منٛز اکھ فرشتہٕ ودٕنؠ۔   فرشتن ووٚن تس،  "کینٛژن نفرن وَن زِ تِم گژھن یافا تہٕ انن تتہِ شمعونسؔ یس بیاکھ ناو پطرس چُھ۔  
\v 14 سُہ ونہِ توٚہہِ زِ توٚہؠ تہٕ تُہنٛدِ گرِکؠ باقےٕ بٲژ کِتھٕ کِنؠ پراون نجاتھ"
\p
\v 15 ییٚلہِ بہٕ تِمن ونان اوسُس،  اچانک گو تِمن پیٚٹھ پاک روح نٲزِل یتھٕ کِنؠ اسہِ پیٚٹھ سُہ پینٹِکاسٹ تہوارُک دوٚہہ نٲزل سپدییاو۔  
\v 16 تہٕ مےٚ پیٚو یاد خداوندن کیاہ ونیاو: یوحناہنؔ دِتُے ژےٚ آبہٕ سٟتؠ بپتسمہ،  مگر خدا دِیی ژےٚ پاک روح سٟتؠ بپتسمہ"
\p
\v 17 خداین دیُت غٲر یہُودٮ۪ن تہِ تِتھُے روحٲنی طاقت یتھٕ پٲٹھؠ اسہِ دِتُن ییٚلہ اسہِ خداوند یسوع مسیحؔ ہس پیٚٹھ ایمان اوٚن۔   لہٰذا ہیٚوک نہٕ مےٚ خدایس یہ ؤنِتھ زِ تِمن روح القدس دِتھ کوٚرو توٚہہِ غلط!"
\p
\v 18 ییٚلہ تِمو یہُودؠ ایمان والیٚو پطرس سنٛز یہ کتھ بوز تہٕ تِمو ترٲوؠ تس کٕٹھ کڈٕنؠ۔   امہِ بجایہ ووٚن تِمو خدایہ سنٛدؠ تعریف کران،  "تیٚلہ چھےٚ یہ کتھ عیان زِ خداین کٔرؠ غٲر یہُودؠ تہِ قبول تاکہ تِمن میلہِ ابدی زندگی،  اگر تمہ پننیٚو گُنہو نِشہٕ پوٚت ہیٚن۔  
\p
\v 19 ستفنؔ سنٛدِ مرنہٕ پتہٕ،  گےَ واریاہ ایمان وٲلؠ یروشلم ترٲوِتھ دوٚیمٮ۪ن جاین تکیازِ تِمن ٲسؠ یروشلمس منٛز تکلیف تُلٕنؠ پیٚوان۔   تِمو منٛزٕ گےَ کینٛہہ فینیکے،  کینٛہہ گےَ کُپرس کٮ۪ن جزیرن کُن تہٕ کینٛہہ وٲتؠ شامہٕ کِس شہر انطاکیہؔ ہس منٛز۔   تِمن جاین ٲسؠ تِم متوٲتِر لوٗکن یسوعسؔ متعلق پٲغام بوزٕ ناوان،  مگر تِمو ووٚن صرف باقی یہُودؠ لوٗکن۔  
\v 20 کینٛہہ ایمان وٲلؠ ٲسؠ کپرَس جزیرٕکؠ تہٕ شمٲلی افریقہ کہِ سائرین شہرٕکؠ نفر۔   تِم گےَ انطاکیہ تہٕ تتہِ ٲسؠ غٲر یہُودینؔ خداوند یسوعسؔ متعلق ونان۔  
\v 21 خداوند خدا اوس یِمن ایمان والیٚن پُراثر تبلیغ کرنٕچ صلٲحیت عطا کران۔   یمہِ کِس نتیجس منٛز،  واریہو غٲر یہُودؠ لوٗکو تہنٛدین فرموداتن پیٚٹھ پژھ کٔر تہٕ خداوندس پیٚٹھ کوٚرکھ بھروسہٕ۔  
\p
\v 22 یروشلمس منٛز بوز لوٗکن نِشہٕ ایمان واجنہِ جمٲژ زِ انطاکیہ ہس منٛز چھِ واریاہ لوٗکھ یسوعسؔ پیٚٹھ ایمان انان۔   لہٰذا سوز ایمان والیٚو ہنٛدیٚو رہنماہو برنباسؔ انطاکیہؔ۔  
\v 23 ییٚلہ سُہ تور ووت تہٕ تمِس سپُد معلوم زِ خدا چُھ ایمان والیٚن پیٚٹھ مہربان سپُدمُت۔   لہٰذا اوس سُہ سیٚٹھاہ خۅش گٔژھتھ ایمان والیٚن ہنٛز حوصلہٕ افزائی کران زِ تِم روزنؠ خداوند یسوعسؔ پیٚٹھ پوٗرٕ پٲٹھؠ پژھ بڑاوان۔  
\v 24 برنباس اوس اکھ رُت انسان یمِس مکمل روحٲنی فٲض حٲصل اوس،  تمِس ٲس خدایس پیٚٹھ پوٗرٕ پژھ۔   برنباسنؔ یہ کینٛژھا کوٚر تمہِ سببہٕ اوٚن واریہو لوٗکو خداوند یسوعسؔ پیٚٹھ ایمان۔  
\p
\v 25 برنباسؔ گو پتہٕ ساوُل ژھانڈنہٕ باپتھ کلِیکا کِس ترسسؔ شہرس منٛز۔  
\v 26 ییٚلہ سُہ تٔمؠ لوٚب،  برنباسنؔ اوٚن سُہ انطاکیہ واپس یُتھ سُہ تمِس ایمان والیٚن تعلیم دِنس منٛز مدد کرِ۔   لہٰذا رودؠ پوٗرٕ اکِس ورؠ یس برنباسؔ تہٕ ساوُلؔ کلِیسایی جمٲژ باقٲیدٕ سمکھان تہٕ واریہن لوٗکن یسوعسؔ متعلق تعلیم دِوان۔   انطاکیہ ہس منٛز اوس یہ زِ شٲگردن اوس گۅڈٕ مسیحیؔ وننہٕ یوان۔  
\p
\v 27 ییٚلہ برنباسؔ تہٕ ساوُلؔ انطاکیہ ہس منٛز ٲسؠ،  کینٛہہ ایمان وٲلؠ یمہٕ نبی ٲسؠ وٲتؠ یروشلمہٕؔ پیٚٹھٕ توٚت۔  
\v 28 تِمن منٛز اوس اگبُسؔ ناوُک اکھ یُس کینٛہہ وننہٕ خٲطرٕ کھڑا سپُد۔   خدایہِ سنٛدؠ روحن اوس تس یہ پیشن گوئی کرنُک طاقت بخشمُت زِ واریہن ملکن منٛز وۅتھِ عنقریب دراگ۔   (یہ دراگ وۅتھ تمہِ وزِ ییٚلہ کلودیُسؔ رومُکؔ بادشاہ اوس۔  
\p
\v 29 ییٚلہ تتہِ کیٚو ایمان والیٚو ژاٹو اگبُسؔ سنٛز کتھ پوٚز تہٕ تِمو کوٚر فٲصلہ زِ تِم سوزن یہُودیہ ہس منٛز روزن والیٚن ایمان والیٚن مٲلی امداد۔   تِمو منٛزٕ کوٚر پرٛتھ أکؠ فٲصلہٕ زِ سُہ دییہِ تیوٗت پونٛسہٕ یوٗت سُہ دِتھ ہیٚکہِ۔  
\v 30 تِمو سوز یہ رقم برنباسؔ تہٕ ساوُلس اتھِ یروشلمس منٛز روزن والیٚن ایمان والیٚن ہنٛدین قٲیِدن نِش۔
\c 12
\p
\v 1 یہ اوس سُہ وقت ییٚلہ بادشاہ ہیرودیس اگرپاہؔن یروشلمس منٛز ایمان وٲلؠ جمٲژ ہنٛدؠ کینٛہہ زِٹھؠ گِرفتار کرنہٕ باپتھ پنٕنؠ سِپاہ سوزؠ۔   فوجیو بٔرؠ تِم جیل۔   یہ کوٚر بادشاہن تکیازِ سُہ اوس ایمان والیٚن تکلیف دیُن یژھان۔  
\v 2 تٔمؠ کوٚر أکِس سِپہس حکم زِ سُہ انہِ یوحناؔ رسول سنٛدِس بٔڈس بٲیس یعقوبؔ رسول سُنٛد کلہٕ ژٔٹِتھ۔   تہٕ سِپہن کوٚر تہِ۔  
\p
\v 3 ییٚلہ ہیرودیسس پےَ لوٚگ زِ تٔمؠ کٔرؠ یہُودٮ۪ن ہنٛدؠ قٲید خۅش تہٕ تٔمؠ دیُت سِپہن حکم زِ پطرس تہِ أنوون گرفتار کٔرتھ۔   یہ سپُد تتھ بٔڈِس دوٚہس دوران ییٚلہ یہُودؠ خمیرِ روٚس ژۅٹ ٲسؠ کھیٚوان۔  
\v 4 پطرس گرفتار کٔرتھ بوٚر سُہ تِمو قٲد۔   تِمو تھٲو سِپہن ہنٛزن ژۅن جمٲژن پطرسس رٲچھ روزنٕچ ذمہ دٲری۔   پرٛتھ کُنہ جمٲژ منٛزٕ ٲسؠ ژور ژور سِپاہ۔   ہیرودیسؔ اوس پطرسس جیلہٕ منٛزٕ نٮ۪بر کڈُن یژھان تہٕ فسح بڈِ دوٚہہ انٛد وٲتِتھ تمِس یہُودؠ لوٗکن برُونٛہہ کنہِ انصاف دیاوُن یژھان۔   امہِ پتہٕ بنوو تٔمؠ پطرسؔس قتٕل کرنُک منصوبہ۔  
\p
\v 5 یتھٕ کنؠ رود پطرس واریہن دوٚہُن قٲد۔   مگر یروشلمس منٛز ٲسؠ تمؠ سنٛزِ جمٲژ ہنٛدؠ ایمان وٲلؠ دِل پھُٹِتھ خدایس دُعا منٛگان زِ سُہ کٔرِن پطرسس مدد۔  
\v 6 یمہِ رٲژ ہیرودیسؔن پطرس جیلہٕ منٛزٕ نٮ۪بر کٔڈِتھ تس سرِعام پھٲسؠ دِنُک منصوبہ بنوو،  پطرس اوس قٲدخانس منٛز دوٚن سِپہن منٛزباگ شونٛگِتھ تہٕ زٕ زنجیرٕ آسس گنٛڈِتھ۔   تہٕ بیٚیہِ زٕ سِپاہ ٲسؠ جیلہٕ کِس دروازس پیٚٹھ پہرٕ دِتھ۔  
\p
\v 7 اچانک گو خداوند خدا سُنٛد اکھ فرشتہٕ پطرسس برُونٛہہ کنہِ کھڑا تہٕ تمؠ سنٛزِ پہرِ منٛز گو اکھ چمکدار گاش ظٲہِر۔   فرشتن دِژ پطرسس ۂلِس ژنٛڈ تہٕ کوٚرُن ہُشار تہٕ وُننَس،  "وۅتھ جلد تھوٚد!" ییٚلہ پطرسن تھوٚد وۅتھُن ہیٚوت تہٕ تمؠ سنٛزو ہژیٚو منٛزٕ آیہ ہانٛکلہٕ وسِتھ۔   حلانکہِ سِپہن لوٚگ نہٕ امہِ کتھِ ہُنٛد پےَ زِ سپدان کیاہ چُھ۔  
\v 8 پتہٕ ووٚن فرشتن تس،  "وۅتھ گنٛڈ پنُن ہوٚل تہٕ لاگ نالان۔   تہٕ پطرسن کوٚر تی۔   پتہٕ ووٚن فرشتن تس،  "پنٕنؠ ژادر وَل پانس انٛدؠ انٛدؠ تہٕ پکھ مےٚ پتہٕ پتہٕ!"
\p
\v 9 یتھ کنؠ دراو پطرس پنٕنؠ ژادر ؤلِتھ تہٕ کھۅربانہٕ لٲگِتھ قٲد خانہٕ منٛزٕ فرشتس پتہٕ پتہٕ نیٚبر،  مگر تمِس ٲس نہٕ پژھےٕ بہان زِ یہ سورےٕ چھا پٔزؠ پٲٹھؠ سپدان۔   تمِس اوس باسان زِ بہٕ چُھس خاب وُچھان۔  
\v 10 پطرس تہٕ فرشتہٕ دراے تِمو سِپہو برُونٛہہ کِنؠ یمہٕ دروازن دوٚن پیٚٹھ پہرٕ دِوان ٲسؠ مگر سپہَن آے نہٕ تِمہ اتھِ۔   پتہٕ وٲتؠ تِم شستٕرو دروازس نِش یپٲرؠ شہرس منٛز اژان ٲسؠ۔   برَن گییہِ پانے یلہٕ،  پطرس تہٕ فرشتہٕ دراے قٲد خانہٕ منٛزٕ نیٚبر۔   ییٚلہ تِم اکہِ کوچہٕ کِنؠ دوٗر پہن وٲتؠ تہٕ سُہ فرشتہٕ گو اچانک غٲب۔  
\p
\v 11 ٲخٕرکار زون پطرسن زِ یہ کینٛژھا تس سٟتؠ سپُد تہِ اوس نہٕ خاب بلکہِ اکھ حقیقت۔   لہٰذا سونٛچ تٔمؠ،  ووٚنؠ سپُد مےٚ پٔزؠ کِنؠ معلوم زِ خداوند خداین سوز میانہِ مددتہٕ باپتھ اکھ فرشتہٕ۔   تٔمؠ چووُس بہٕ تمہِ نِشہٕ یہ کینٛژھا ہیرودیس مےٚ سٟتؠ ورتاونُک منصوبہ بناوان اوس تہٕ تِمو ساروےٕ چیزو نِشہٕ تہِ یمیُک توقع یہُودی زِٹھؠ کران ٲسؠ۔  
\p
\v 12 ییٚلہ پطرسس معلوم سپُد زِ خداین بچووُس بہٕ تہٕ سُہ گو مریمؔ سُنٛد گرٕ۔   سۅ ٲس یوحناؔ سنٛز موج یمسُنٛد بیاکھ ناو مرقُسؔ اوس۔   واریاہ ایمان وٲلؠ ٲسؠ تتہِ جمع گٲمٕتؠ،  تہٕ تِم ٲسؠ دُعا منٛگان زِ خدا کٔرِنؠ کُنہِ پٲٹھؠ پطرسس مدد۔  
\p
\v 13 ییٚلہ پطرسن نیٚبرمِس دروازس ٹُھک ٹُھک کوٚر تہٕ رُدی ناوٕچ اکھ نوکرٲنؠ آیہ یہ وُچھنہِ زِ دروازس نیٚبرٕ کنہِ کُس چُھ۔  
\v 14 ییٚلہِ پطرسن تس جواب دیُت تہٕ تٔمہ پرزٕنٲو آواز،  مگر سۅ گییہِ تیژ خۅش تہٕ وُتاول زِ تمہِ مُژروو نہٕ دروازے۔   تمہِ بجایہ دورییہِ سۅ گرٕ کُن واپس۔   تٔمؠ کوٚر باقی ایمان والیٚن نِش اعلان زِ پطرس چُھ دروازس نیٚبرٕ کنہِ۔  
\v 15 مگر تِمو منٛزٕ ووٚن تس أکؠ،  "ژٕ چھیٚکھ دیوانہٕ گٔمٕژ! مگر سۅ روز ونان زِ یہ چُھ پوٚز۔   تِم رودؠ ونان،  "نہ،  پطرس ہیٚکہ نہٕ ٲسِتھےٕ۔   یہ چُھ شاید تمسُنٛد فرشتہٕ"
\p
\v 16 مگر پطرس رود دروازس ٹُھک ٹُھک کران۔   ٲخر کار ییٚلہ کٔمؠ تام دروازٕ یلہٕ ترُوو تہٕ تِمو وُچھ یہ اوس پطرس،  تِم سپٕدؠ حٲران!
\v 17 پطرسن ہوو تِمن اتھٕ سٟتؠ ژۅپہٕ کرنہٕ باپتھ اتھٕ سٟتؠ اشارٕ۔   پتہٕ ووٚن تٔمؠ تِمن اصل پٲٹھؠ زِ خداوند خداین کِتھٕ کنؠ کوٚڈُس بہٕ قٲد خانہٕ منٛزٕ۔   تٔمؠ ووٚن یتہِ،  "یعقوبؔ،  سانہِ جمٲژ ہنٛدِین زِٹھٮ۪ن تہٕ سانٮ۪ن باقی ایمان والیٚن سٲتھین ون زِ کیاہ سپُد" پتہٕ دراو پطرس تہٕ گو بدل کتھ تام جایہ۔  
\p
\v 18 بیکہِ دوٚہہ صبحٲے سپٕدؠ تِم سِپاہ سیٚٹھاہ پریشان یمہٕ پطرس سنٛز پہرٕدٲری کران ٲسؠ تکیازِ تِمن اوس نہٕ فِکرے تران زِ تمِس کیاہ سپُد۔  
\v 19 تانؠ بوز ہیرودیسن تہِ اتھ متعلق۔   تہٕ تٔمؠ دیُت سِپہن حکم پطرس ژھانڈنُک،  مگر تِمو ہیٚوک نہٕ سُہ لٔبِتھ۔   پتہٕ کوٚر تٔمؠ تِمن سِپہن سوال یمہٕ پطرسس رٲچھ ٲسؠ تہٕ دِتُن حکم تمہٕ قتٕل کرنہٕ باپتھ نِنؠ۔   امہ پتہٕ گو ہیردیسؔ یہُودیہ صوبہٕ پیٚٹھٕ قیصریہ شہر کُن یتہِ سُہ کینٛژس کالس رود۔  
\p
\v 20 بادشاہ ہیرودیسس کھوٚت صورؔ تہٕ صیدا کیٚن شہرن منٛز روزن والیٚن لوٗکن پیٚٹھ واریاہ خشٕم۔   اکہِ دوٚہہ سپٕدؠ کینٛہہ نفر یمہٕ تمؠ سنٛز نمایندٕ کران ٲسؠ ہیرودیسس سمکھنہٕ باپتھ قیصریہ شہرس منٛز جمع اکِس کمرس منٛز۔   تِمو کوٚر بلستسؔ،  یُس ہیرودیس سُنٛد اہم منصب دار اوس ہیرودیسس یہ ننہٕ خٲطرٕ آمادٕ زِ تمسنٛدِ شہرٕکؠ لوٗکھ چھِ تمِس سٟتؠ صلح کرُن یژھان۔   تِم چھِ تِمن لوٗکن سٟتؠ تجارت کرنَس لایکھ سپدٕنؠ یژھان یمن پیٚٹھ ہیرودیس حکومت کران چُھ۔   تکیازِ تِمن ٲس تِمو علاقو نِشہٕ خۅراک ہیٚنٕچ ضرورت۔  
\v 21 یمہِ دوٚہہ ہیرودیسن تِمن سمکھنُک اِرادٕ کوٚر تمہِ دوٚہہ لٲگؠ تٔمؠ قٟمتی پلو یمو سٟتؠ باسان اوس زِ سُہ چُھ بادشاہ۔   پتہٕ بیوٗٹھ سُہ پننِس تختس پیٚٹھ تہٕ کوٚرُن تتہِ جمع سپدیمتین تمام لوٗکن رسمی طور خطاب۔  
\p
\v 22 یمہٕ لوٗکھ تمؠ سنٛزٕ کتھٕ بوزان ٲسؠ تمہٕ ٲسؠ بار بار شور تُلان،  "یہ نفر یُس یہ بولان چھُ،  چُھ خدا نکہِ اکھ انسان!"
\v 23 لوٗکھ لٔگؠ خدایہ سنٛدؠ تعریف کرنہٕ بجایہ تمسنٛدؠ تعریف کرنہٕ۔   لہٰذا پوو خداوند خدا سنٛدؠ اکؠ فرشتن یکدم ہیرودیس شدید بٮ۪مار۔   واریہو کیٚمیٚو کھیی تمسنٛدؠ انٛدرم۔   تہٕ پتہٕ مود جلدےٕ سیٚٹھاہ دردناک عزابہٕ سٟتؠ۔  
\p
\v 24 ایمان وٲلؠ ٲسؠ لگاتار واریہن جاین خدایہ سُنٛد پٲغام بوزٕناوان۔   تہٕ یسوع سنٛدین مانن والیٚن ہنٛدِس تعدادس منٛز اوس ہیٚتھےٕ ہُریر سپدان۔  
\p
\v 25 ییٚلہ برنباسؔ تہٕ ساوُل یہُودیہ صوبس منٛز یہُودؠ ایمان والیٚن مددتہٕ باپتھ پونٛسہٕ واتناوان ٲسؠ تہٕ تمہٕ دراے یروشلم منٛزٕ تہٕ وٲتؠ واپس ملکِ شام کِس صوبہ انطاکیہؔ ہس منٛز۔   تِمو نیٚو یوحناؔ،  یمسُنٛد بیاکھ ناو مرقُسؔ اوس پانس سٟتؠ۔
\c 13
\p
\v 1 شامہ کس صوبس انطاکیہ ہس منٛز ٲسؠ ایمان والیٚن ہنٛزِ جمٲژ منٛز نبی تہٕ تِم شخص یمہٕ لوٗکن یسوعسؔ متعلق تعلیم ٲسؠ دِوان۔   تِمن منٛز ٲسؠ: برنباس،  شمعون یمِس نِجرؔ تہِ ونان ٲسؠ،  لوکیس،  یُس سائرینُک اوس،  مناہینؔ،  یُس بادشاہ ہیرودیس انتِپاسسؔ سٲتھی رودمُت اوس،  تہٕ بیٚیہِ ساوُل۔  
\v 2 ییٚلہِ تِم روزدار ٲسؠ روزان تہٕ خداوند سنٛز عبادت کران ٲسؠ،  پاک روح ووٚتھ تِمن کُن،  "برنباس تہٕ ساوُل ژٲرؠ وُن میانہِ خدمتہٕ باپتھ تِم گٔژھن تہٕ کرن سۅ کٲم یمہِ باپتھ مےٚ تِم ژٲرمٕتؠ چھِ!"
\v 3 چناچہ تمہ رودؠ روزٕ تھاوان تہٕ دعا کران۔   پتہٕ کوٚر تِمو برنباسسؔ تہٕ ساوُلس اتھٕ پٮ۪تھ تھٲوِتھ دُعا زِ خدا کٔرن تِمن مدد۔   پتہٕ کٔرؠ تِمو تِم تمہِ کامہِ خٲطرٕ روانہٕ یمیُک روح القدسن حکم کوٚرمُت اوس۔  
\p
\v 4 روح القدسن دِتؠ برنباسسؔ تہٕ ساوُلس ہِدایت زِ گژھُن کوٚت چُھ۔   چناچہ تِم گےَ انطاکیہؔ پیٚٹھٕ سمندری سفر کٔرِتھ سلُوکیہؔ شہر۔   تتہِ پیٚٹھٕ گےَ تِم جہازس منٛز کُپرس کہِ جزیرٕ کِس سلمِیسؔ شہر منٛز۔  
\v 5 ییٚلہ تِم سلمِیسؔ شہرس منٛز ٲسؠ تتہِ گےَ تِم یہُودینؔ ہنٛدین عبادت گاہن منٛز۔   تتہِ کوٚر تِمو یسوعسؔ متعلق خدایہ سنٛدِ پٲغامُک اعلان۔   یوحنا مرکسؔ گو تِمن مدد کرنہٕ باپتھ سٟتؠ۔  
\p
\v 6 تِم ترینوے گے سورےٕ جزیرٕ پار کٔرِتھ پافُس شہر۔   تتہِ گو تِمن اکِس جٲدؠ گرس سٟتؠ ملاقات یمِس بریسوعؔ ناو اوس۔   سُہ اوس سُہ یہُودؠ یمؠ نبی آسنُک اپُز دعوا کوٚرمُت اوس۔  
\v 7 سُہ اوس امہِ جزیرٕ کِس گورنر سرگیُس پولُسؔ سٟتؠ یُس اکھ ذہین انسان اوس۔   گورنرن سوز کُستام برنباسسؔ تہٕ ساوُلس پانس نِشہٕ اننہٕ باپتھ نادس تکیازِ سُہ اوس خدا سُنٛد کلام بوزن یژھان۔  
\v 8 مگر جادوگرن یمہ سنٛدِ ناوک ترجمہٕ یونٲنؠ زبٲنؠ منٛز الیماسؔ اوس کٔر تِمہ رُکاونٕچ کوشش۔   تٔمؠ کٔر بار بار گورنر کٲیل کرنٕچ کوشش زِ سُہ مہٕ أنِن یسوعسؔ پیٚٹھ ایمان۔  
\p
\v 9 ساوُل اوس ووٚنؠ پانس پولُسؔ ونان۔   پاک روحن کوٚر پولُسؔ جادو گرس کُن غورٕ سان وُچھنہٕ باپتھ مجبور۔   پولُسنؔ وونُس، 
\v 10 "ژٕ چُھکھ شیطانہٕ سُنٛد پٲروکار،  تہٕ ژٕ چُھکھ پرٛتھ اصل کامہِ ٹھوٚر اننٕچ کوشش کران! ژٕ چُھکھ ہمیشہ لوٗکن اپُز ونان تہٕ تِمن سٟتؠ باقی بُرٲییہِ ورتاوان۔   ژےٚ پٔزی یہ ونُن تراوُن زِ خداوند خدایس متعلق پزر چُھ اپُز!
\p
\v 11 ووٚنؠ چُھ خداوند خدا ژےٚ سزا دنہٕ وول! ژٕ گژھکھ اوٚن تہٕ کینٛژس کالس ہیٚککھ نہٕ افتابےٕ وُچِھتھ۔   "أتھؠ سٟتؠ گو سُہ اوٚن،  زنتہٕ سُہ اکِس سیاہ وُنلہِ منٛز اوس۔   تہٕ سُہ لوٚگ اورٕ یور أنؠ ژھارِ وُچھنہِ زِ تس گوٚژھ کانٛہہ اتھس تھف کرُن تہٕ وتہٕ ہاوُک بنُن۔  
\v 12 ییٚلہِ گورنرن وُچھ زِ الیماسسؔ سٟتؠ کیاہ سپُد تہٕ تٔمؠ اوٚن یسوعسؔ پیٚٹھ ایمان۔   پولُسؔ تہٕ برنباسؔ یہ کینٛژھا خداوند یسوعسؔ متعلق ہیٚچھٕ ناوان ٲسؠ تمہِ سٟتؠ سپٕز تس حٲرٲنی۔  
\p
\v 13 امہ پتہٕ گےَ پولُسؔ تہٕ تمؠ سنٛدؠ سٟتؠ بوج جہازس منٛز پافُس پیٚٹھٕ پمفیلیہؔ کِس شہر پرگہٕ منٛز تہٕ یوحنا مرکسؔ گو تِم أتی ترٲوِتھ یروشلمؔ پنُن گھرٕ واپس۔  
\v 14 پتہٕ گےَ پولُسؔ تہٕ برنباسؔ پرگہٕ پیٚٹھٕ وۅکھٕلؠ گلتیہ صوبہٕ کِس پسدیہ شہر انطاکیہؔ۔   سبت کہِ دوٚہہ گےَ تہٕ بیٹھؠ عبادت گاہس منٛز۔  
\v 15 یہ کینٛژھا موسیٰؔ ہن شریعت چن کتابن منٛز لیٚوکھمُت چُھ تہِ اوس کُستام بڈِ بڈِ پران۔   امہِ پتہٕ پوٚر کٔمؠ تام تہِ یہ نبیو لیٚوکھمُت چُھ۔   پتہٕ سوز جلسہٕ گاہ کیٚو زِٹھیٚو پولُسسؔ تہٕ برنباسسؔ شیٚچھ: "یہُودؠ بایو،  اگر توٚہہِ منٛزٕ کانٛہہ یتہِ کٮ۪ن لوٗکن حوصلہٕ افزٲئی مۅکھٕ تِمن سٟتؠ کتھ چھِ یژھان کرٕنؠ مہربٲنی کٔرِتھ یِیو تہٕ کٔریٚو اسہِ سٟتؠ کتھ۔  
\p
\v 16 پولُسؔ ووٚتھ تھوٚد تہٕ کوٚرُن اتھٕ سٟتؠ اشارٕ تاکہِ لوٗکھ بوزن تمؠ سنٛز کتھ۔   پتہٕ ووٚن تٔمؠ،  "ٹاٹھیو اسرائیل یو تہٕ غٲر یہُودؠ لوٗکو یمہٕ خدایہ سنٛز عبادت تہِ کران چُھو،  مہربٲنی کٔرِتھ بوزیٚو میانؠ کتھ!
\v 17 خدا یمسنٛز أسؠ اسرائیلی عبادت کران چھِ،  چھِ سٲنؠ جدٕ اجداد پننہِ باپتھ ژٲرمٕتؠ تہٕ تہنٛزِ آبٲدی منٛز کٲفی اضافہٕ کوٚرمُت یۅتام تِمہ مِصرچہِ زمینہِ پیٚٹھ پردیسی ٲسِتھ زندگی گُزاران ٲسؠ۔   پتہٕ کٔر خداین تِم غلامی منٛزٕ کڈنہٕ باپتھ زبردس کٲم۔  
\v 18 یودوے تِمو وزِ وزِ تمؠ سنٛز نافرمٲنی کٔر مگر توتہِ کوٚر تٔمؠ تِہُنٛد وطیرٕ قریبن ژتجَہن ؤرین برداش یۅتام تِم بیابانن منٛز ٲسؠ۔  
\p
\v 19 تٔمؠ بنٲوؠ اسرائیلی لوٗکھ تِم ستتھ جمٲژ فتح کرنس قٲبل یمہٕ تمہِ وزِ کنعان لٮ۪ن علاقن منٛز روزان ٲسؠ،  تہٕ تٔمؠ کٔر تِہنٛز زمین ہمیشہٕ باپتھ اسرائیل ین ہنٛدِس قبضس منٛز
\v 20 یِم سٲری چیز سپدؠ تِہنٛدؠ جدٕ اجداد مِصرٕ منٛزٕ نیرنہٕ پتہٕ لگ بگ ساڑِ ژورِ ہتہِ ؤہرؠ۔  
\p "تمہِ پتہٕ،  ژٲرؠ خداین اسرائیل ین پیٚٹھ بحثیتِ قٲضؠ تہٕ بحثیتِ رہنما حکومت کرنہٕ باپتھ لوٗکھ۔   تِم سردار رودؠ اسہِ پیٚٹھ حکومت کران،  تہٕ سموئیلؔ رسول اوس تِمن پیٚٹھ حکومت کرن وول ٲخری قٲضؠ۔  
\v 21 تمہِ وزِ ییٚلہ سموئیلؔ تِہُنٛد رہنما اوس کوٚر لوٗکو مطالبہ زِ تِمن پیٚٹھ حکومت کرنہٕ باپتھ گژھِ اکھ بادشاہ مقرر کرنہٕ یُن۔   لہٰذا کوٚر خداین بنیمینؔ قبیلہٕ کِس قیس سُنٛد نیٚچو ساوُل تِہُنٛد بادشاہ بننہٕ خٲطرٕ منتخب۔   تٔمؠ کٔر ژتجَہن ورین تِمن پیٚٹھ حکومت۔  
\v 22 ییٚلہ خداین ساوُل بادشٲہی نِشہٕ رد کوٚر تہٕ تٔمؠ ژور داوود تِہُنٛد بادشاہ بننہٕ باپتھ۔   خداین وُون تِمن متعلق،  "مےٚ وُچھ زِ یسیؔ سُنٛد نیٚچو داوود چُھ برابر تمی قسمُک انسان یُس تہِ یژھان چُھ یہ بہٕ یژھان چُھس۔   سُہ کرِ سۅ پرٛتھ کانٛہہ کٲم یۅسہ بہٕ تمِس اتھِ کرناوٕنؠ یژھان چُھس"
\p
\v 23 "داوود سنٛدیو اولادو منٛزٕ اوٚن خداین اکھ،  یسوع اسہِ اسرائیلی لوٗکن نِش تاکہِ سُہ بچاوِ اسہِ،  یتھ پٲٹھؠ تٔمؠ داودسؔ تہٕ سانٮ۪ن باقی جدٕ اجدادن سٟتؠ تہِ کرنُک وعدٕ کوٚرمُت اوس۔  
\v 24 یسوع سنٛدِ پنٕنؠ کٲم شروع کرنہٕ برُونٛہہ،  پوٚر بپتسمہ دنہٕ وٲلؠ یوحنا ہن سانٮ۪ن تمام اسرائیلی لوٗکن یمہ تس نِش آمٕتؠ ٲسؠ وعظ۔   تٔمؠ ووٚن تِمن زِ تمہٕ پھیرِن پننہِ بُرٕ وطیرٕ نِشہٕ واپس تہٕ خدایس منٛگِن تِمو نِشہٕ اُفو۔   پتہٕ دییہِ سُہ تِمن بپتسمہ۔  
\v 25 ییٚلہ یوحنا سۅ کام انٛد واتناون وول اوس یۅسہ خداین تس کرنہٕ باپتھ دِژمٕژ ٲس تہٕ سُہ اوس ونان،  "کیاہ توٚہہِ چھا باسان زِ بےٕ چُھس سُہ مسیحؔ یُس خداین سوزنُک وعدٕ کوٚرمُت اوس؟ نہ بہٕ چُھس نہٕ۔   مگر بوزیٚو!مسیح ییہِ جلدےٕ۔   سُہ چُھ میانہِ نِشہٕ تیوٗت بوٚڈ زِ بہٕ شوبہٕ نہٕ تس کھۅربانہٕ تُلنس تہِ"
\p
\v 26 "ٹاٹھیٚو بایو،  تہٕ توٚہؠ سٲری یمہٕ ابرہامؔ سنٛدؠ اولاد چھِ،  تہٕ توٚہہِ منٛز تِم غٲر یہُودؠ لوکھ یِم خدایہ سنٛز تہِ عبادت کران چھِ،  مہربٲنی کٔرِتھ بوزیٚو! یہ چُھ اسہِ سارنےٕ ہنٛدِ باپتھ زِ خداین سوز اسہِ یہ پٲغام زِ سُہ کِتھٕ کنؠ چُھ لوٗکن بچاوان۔  
\v 27 یروشلم کیٚو روزن والیٚو تہٕ تہنٛدیٚو حکمرانو پرزٕنوو نہٕ یسوعؔ۔   تِمو سمجھ نہٕ پننٮ۪ن نبین ہنٛدؠ پٲغامات یودوے زن تِم پرٛتھ سبت دوٚہہ تِہُنٛد بڈِ بڈِ برُن بوزان ٲسؠ۔   یہ کینٛژھا نبیو واریاہ برُونٛہہ ووٚن تہِ گو پوٚز ثٲبت ییٚلہ تِمو یسوعسؔ سزایہ موت دیُت۔  
\p
\v 28 واریہو لوٗکو دیُت یسوعسؔ بُرٕ کامہ کرنُک اِلزام،  یودوے زن تِمو ثٲبت ہیٚوک نہٕ کٔرِتھ زِ تِمو کیاہ کٔر کانٛہہ تِژھ کٲم یمہِ سٟتؠ سُہ موتُک حقدار اوس،  تِمو ووٚن گورنر پیلاطسؔ زِ سُہ دِیِن یسوعسؔ سزاے موت۔  
\v 29 تِمو کوٚر یسوعسؔ سٟتؠ تہِ سورےٕ یہ واریاہ برُونٛہہ نبی یو لیٚوکھمُت اوس زِ لوٗکھ کیاہ کرن تمِس سٟتؠ۔   تَمو تھوو یسوع کِلؠ دِتھ صلیبس پیٚٹھ مٲرِتھ۔   پتہٕ وولوٗکھ تمسُنٛد جسٕم صلیب پیٚٹھٕ بوٚن تہٕ دفنووُکھ۔  
\p
\v 30 مگر خداین کوٚر سُہ موٚردو منٛزٕ زنٛدٕ۔  
\v 31 واریہن دوٚہُن رود سُہ پننیٚن تِمن پٲروکارن نِش ظٲہِر سپدان یِم تمِس سٟتؠ گلیلؔ پیٚٹھٕ یروشلم تام آمٕتؠ ٲسؠ۔   یمو لوٗکو سُہ وُچھ تِم چھِ ووٚنؠ باقی لوٗکن تس متعلق ونان۔  
\p
\v 32 ووٚنؠ چھِ أسؠ توٚہہِ یہ رُت پٲغام بوزٕناوان۔   أسؠ چھِ توٚہہِ یہ ونُن یژھان زِ خداین یُس سانٮ۪ن یہُودؠ جدٕاجدادن سٟتؠ وعدٕ کوٚرمُت اوس سُہ کوٚر تٔمؠ پوٗرٕ!
\v 33 ووٚنؠ کوٚر تٔمؠ سانہِ خٲطرٕ یمہٕ تِہنٛدؠ اولاد چھِ تہٕ تُہنٛدِ خٲطرٕ تہِ یمہٕ غٲر یہُودؠ چھِ یسوع دوبارٕ زنٛدٕ کٔرِتھ یہ۔   یہ چُھ بلکُل تِتھُے یہ داوودنؔ دویمِہ زبورِ منٛز لیٚوکھ،  ییٚلہ خدا پنُن گۅبُر سوزنس متعلق ونان اوس:
\q ژٕ چُھکھ میٚون گۅبُر؛
\q از بنیاس بہٕ چون بب۔  
\p
\v 34 خداین کوٚر مسیحؔ موٚردو منٛزٕ زنٛدٕ تہٕ پتہٕ دییہِ نہٕ تس زانٛہہ تہِ مرنہٕ۔   خداین ووٚن سانٮ۪ن یہُودؠ جدٕاجدادن،  "بہٕ کرو توٚہہِ ضرور مدد یتھ کنؠ مےٚ داودسؔ سٟتؠ وعدٕ کوٚرمُت چُھ زِ بہٕ کرٕ"
\p
\v 35 یُس داوودُن بیاکھ زبور چُھ،  سُہ چُھ مسیحؔ ہس متعلق یہ ونان: " ژٕ دِکھ نہٕ پننِس پاک شخصہٕ سنٛدِس جسمس سڑنُک اِجازت"
\v 36 ییٚلہ داوود زنٛدٕ اوس،  تٔمؠ کوٚر تی یہ خدا تس نِش یژھان اوس۔   ییٚلہ سُہ مود تہٕ تمؠ سنٛز لاش آیہ دفن کرنہٕ یتھ پیٚٹھ تمسنٛدین جدٕ اجدادن ہنٛدؠ جسم ٲسؠ دفن کرنہٕ آمٕتؠ تہٕ تمسُنٛد جسٕم سپدیٚو بوسیدٕ۔   تہٕ سُہ ہیٚکہ ہے نہٕ اتھ زبورِ منٛز پانس متعلق کتھ کٔرِتھ۔  
\v 37 مگر یسوع اوس سُہ اکھ یُس خداین موٚردو منٛزٕ زنٛدٕ تُل تہٕ تمسُنٛد جسم سڑیو نہٕ۔  
\v 38 لہٰذا،  میانیٚو ٹاٹھیٚو اسرائیل یو تہٕ باقی دوستو،  تُہنٛدِ خٲطرٕ چُھ یہ زانُن ضروری زِ یسوع سنٛدِس کٔرمٕتِس پیٚٹھ ہیٚکہِ خدا تُہنٛدؠ گناہ معاف کٔرِتھ۔   سُہ کرِ توٚہہِ تِمو چیزو باپتھ تہِ معاف یم چیز نہٕ توٚہہِ موسیٰؔ سنٛدِ قانونہٕ حسابہٕ معاف ہیٚکن سپدِتھ۔  
\v 39 تِم سٲری لوٗکھ یِم یسوعسؔ پیٚٹھ پژھ تھاوان چھِ ین نہٕ ووٚنؠ تِمو کامیٚو باپتھ قصوروار زاننہٕ یمو ستؠ تِمو خدا ناراض کوٚر۔  
\v 40 مگر ہیٚسہٕ روزؠ زیٚو ینہٕ خدا توٚہہِ سٟتؠ سُہ انصاف کرِ یہ زن نبی یو فرمومُت چُھ زِ خدا کرِ۔  
\v 41 نبی یو چُھ لیٚوکھمُت زِ خداین فرموو، 
\q "توٚہؠ یِم مےٚ ٹٲنہٕ ژٹان چھِ،  ییٚلہِ یہ وُچھو زِ بہٕ کیاہ چُھس کران یقیناً سپدِ توٚہہ حٲرانی تکیازِ ییٚلہ توٚہؠ زندٕ ٲسیٚو تہٕ بہٕ کرٕ توٚہہِ خوفناک عذاب۔   توٚہؠ کٔریٚو نہٕ یقینےٕ زِ بہٕ کیاہ ہیٚکہٕ تہِ کٔرِتھ حالانکہ کٔمؠ تام چُھ توٚہہِ ونمُت!"
\p
\v 42 ییٚلہ پولُسؔ پنٕنؠ کتھ مۅکلٲوتھ دراو تہٕ تتہِ موجود واریہو لوٗکو ووٚن تس نوِ سبت کہِ دوٚہہ یمہ چیز بیٚیہِ وننہٕ باپتھ واپس یُن۔  
\v 43 ییٚلہ جلسہٕ انٛد ووت تہٕ تِمو منٛزم لٔگؠ واریاہ پولُسؔ تہٕ برنباس سنٛز پٲروی کرنہِ۔   یمہ لوٗکھ ٲسؠ یہُودؠ تہِ تہٕ غٲر یہُودؠ تہِ یمہٕ خدایہ سنٛز عبادت کران ٲسؠ۔   پولُسؔ تہٕ برنباس رودؠ تِمن سٟتؠ کتھٕ کران۔   تِم رودؠ تِمن بھروسہٕ کرنُک تٲکید کران یُتھ خدا مہربان سپدِتھ یسوع سنٛدِ برکتہٕ لوٗکن ہنٛدؠ گناہ معاف کرِ۔  
\p
\v 44 دویمہِ سبت کہ دوٚہہ آے انطاکیہ ۂکؠ اکثر لوٗکھ یہُودینؔ ہنٛدِس جلسہٕ گاہس منٛز پولُسؔ تہٕ برنباس سنٛزٕ کتھٕ خداوند یسوعسؔ متعلق بوزنہٕ خٲطرٕ۔  
\v 45 مگر یہُودینؔ ہنٛدین قٲیِدن گو سیٚٹھاہ رٔشِک ییٚلہ تِمو لوٗکن ہُنٛد اکھ بوٚڈ ہجوم وُچھ یمہٕ پولُسؔ تہٕ برنباس سنٛزٕ کتھٕ بوزنہِ یوان ٲسؠ۔   یتھ کنؠ لٲج تِمو یِمن کتھن ہنٛز مخالفت کرنؠ یمہٕ پولُسؔ ونان اوس تہٕ لٔگؠ تس توہین کرنہِ۔  
\p
\v 46 پتہٕ ووٚن پولُسنؔ تہٕ برنباسنؔ سیٚٹھاہ ہمتہٕ سان تِمن یہُودؠ پیشواہن،  "اسہِ اوس یسوعسؔ متعلق خدایہ سُنٛد پٲغام گۅڈٕ توٚہؠ یہُودؠ بوزناوٕنؠ۔   امہِ برُونٛہہ زِ أسؠ کرو غٲر یہُودینؔ برُونٛہہ کنہِ تمسُنٛد اعلان،  تکیازِ خداین اوس اسہِ یہ کرنُک حکم کوٚرمُت۔   مگر توٚہؠ چُھو خدایہ سُنٛد پٲغام رد کران۔   یہ کٔرِتھ چُھو توٚہؠ ظٲہر کران زِ توٚہؠ چُھو نہٕ ابدی زندگی لایق۔   اوٕ کِنؠ چُھو أسؠ توٚہؠ تراوان،  تہٕ ووٚنؠ گژھو أسؠ غٲر یہُودینؔ نِش تاکہ تِم بوزناووکھ أسؠ خدایہ سُنٛد پٲغام۔  
\v 47 یہ چھِ یہ اوٕموٚکھٕ تہِ کران تکیازِ خداوند خداین چُھ اسہِ یہ کرنُک حکم دیتمُت۔   تٔمؠ چُھ صحیفن منٛز فرمومُت، 
\q "مےٚ ژٲرمو توٚہؠ پانس متعلق تمہٕ کتھٕ غٲر یہُودینؔ یاد پاونہٕ باپتھ یمہٕ تہنٛدِ خٲطرٕ اکھ نوٗر آسہ۔   مےٚ ژٲرمو توٚہؠ دنیاہس منٛز پرٛتھ جایہ لوٗکن یہ پٲغام وننہٕ باپتھ زِ بہٕ چُھسکھ تِم بچاوٕنؠ یژھان"
\p
\v 48 ییٚلہ غٲر یہُودؠ لوٗکو یمہٕ کتھٕ بوزٕ تِمہ سپدؠ خۅش،  تہٕ تِمو کوٚر خدایس تعریف یسوعسؔ متعلق امہِ پٲغامہٕ باپتھ۔   سٲری غٲر یہُودؠ لوٗکو یمہٕ خداین ابدی زندگی باپتھ ژٲرؠ کوٚر خداوند یسوع سنٛدِس پٲغامس پیٚٹھ یقین۔  
\v 49 تمہِ وقتہٕ ٲسؠ واریاہ ایمان وٲلؠ تتھ علاقس منٛز پھیران تھوران،  تہٕ یوٚت تہِ تِم گژھان ٲسؠ تتہِ ٲسؠ خداوند یسوع سُنٛد پٲغام پھٲلاوان۔  
\p
\v 50 مگر کینٛژو یہُودؠ رہنماوو کٔر کینٛژن اہم زنٮ۪ن سٟتؠ کتھ یمہٕ تِمن سٟتؠ عبادت کران آسہٕ۔   تِمو کٔر شہرٕکٮ۪ن سٮیٹھہےٕ اہم نفرن سٟتؠ تہِ کتھ۔   یہُودؠ سردارو کٔرؠ غٲر یہُودؠ شہرٕکؠ سردار پولُسؔ تہٕ برنباسؔ رُکاونٕچ کوشش کرنس پیٚٹھ آمادٕ۔   چناچہ یِمو غٲر یہُودؠ لوٗکو کٔرؠ پولُسؔ تہٕ برنباسسؔ خلاف واریاہ شہری تیار تہٕ کٔڈِکھ پننیٚو علاقو منٛزٕ۔  
\v 51 ییٚلہ دوٚنوے رسول تتہِ نیران ٲسؠ،  تِمو دٕنؠ پننٮ۪ن کھۅرن ہنٛز میٚژ تِمن قٲیِدن یہ ہاونہٕ خٲطرٕ زِ خداین کٔرؠ تم رد تہٕ تِمن دییہِ سُہ سزا۔   پتہٕ دراے تِم انطاکیہؔ پیٚٹھٕ تہٕ گےَ اِکُنیُمؔ شہر کُن۔  
\v 52 اتھ دوران رود پاک روح   ایمان والیٚن ژاٹن خوشی تہٕ طاقتہٕ سٟتؠ سرشار کران۔
\c 14
\p
\v 1 پولُسؔ تہٕ برنباس گےَ اِکُنیُمسؔ منٛز ہمیشٕکؠ پٲٹھؠ یہُودینؔ ہنٛدِس جلسہٕ گاہس منٛز تہٕ کریکھ خداوند یسوعسؔ متعلق بجہِ بجہِ کتھٕ۔   نتیجہ دراو یہ،  زِ واریہو یہُودیٚو تہٕ غٲر یہُودیٚو تہِ اوٚن یسوعسؔ پیٚٹھ ایمان۔  
\v 2 مگر کینٛژو یہُودؠ لوٗکو کوٚر سُہ پٲغام ماننہٕ نِشہٕ انکار۔   تِمو ووٚن غٲر یہُودینؔ زِ اتھ پیٚٹھ مہٕ کٔریٚو یقین۔   تِمو چِڈٲوؠ کینٛہہ غٲر یہُودؠ تتہِ کٮ۪ن ایمان والیٚن پیٚٹھ۔  
\p
\v 3 مگر پولُسنؔ تہٕ برنباسنؔ کرِ تتہِ واریہس وقتس خداوند سنٛدِ خٲطرٕ ہمتہٕ سان کتھٕ،  خداوند یسوعنؔ بنٲوؠ تِم واریاہ معجزٕ کرنس قٲبل۔   یتھٕ پٲٹھؠ بُوو تٔمؠ لوٗکن امہِ پٲغامُک پزر زِ اگر نہٕ أسؠ اتھ لایق چھِ تہِ،  مگر خداوند چُھ اسہِ بچاوان۔  
\p
\v 4 یِم لوٗکھ اکُنیمسؔ منٛز روزان ٲسؠ تِمن آسہ زٕ مختلف رایہِ۔   کینٛژو کوٚر یہُودینؔ سٟتؠ اتفاق۔   تہٕ کینٛہہ ٲسؠ رسولن سٟتؠ اتفاق کران۔  
\v 5 پتہٕ لٲج غٲر یہُودؠ لوٗکو تہٕ تِمو یہُودیو یمو پولُسؔ تہٕ برنباس سنٛز مخالفت کٔر پانہٕ وٲنؠ کتھ کرٕنؠ زِ تِم کِتھٕ کنؠ کرن پولُسؔ تہٕ برنباسسؔ سٟتؠ بُرٕ سلوک۔   امہِ شہرٕ کیٚو کینٛژو اہم نفرو کٔر تِمن مدد کرنٕچ رضامنٛدی ظٲہر۔   دوٚنویو کوٚر رٔلِتھ فٲصلہٕ زِ تِم کرن پولُسسؔ تہٕ برنباسسؔ کنہِ لٲیِتھ قتٕل۔  
\v 6 مگر پولُسنؔ تہٕ برنباسنؔ بوٗز تِہنٛدِس اتھ منصوبس متعلق،  لہٰذا گےَ تِم جلدےٕ لُکااُنیہ ضلعس منٛز۔   تمہٕ گےَ تمہ ضلع کِس لُسترہؔ،  دربی تہٕ انٛدؠ پٔکؠ کٮ۪ن علاقن منٛز۔  
\v 7 ییٚلہ تِم تتھ علاقس منٛز ٲسؠ تہٕ تِم رودؠ خداوند یسوعسؔ متعلق لوٗکن پٲغام بوزٕناوان۔  
\p
\v 8 لُسترہؔ ہس منٛز اوس اکھ شخصا تتہِ بہِتھ یُس زنٛگو کِنؠ معذور اوس۔   ییٚلہ تس ماجہِ زایُن دیتمُت اوس تمی وزِ آسہٕ تس ہجہِ کجہِ زنٛگہٕ یمہِ کِنؠ نہٕ سُہ اورٕ یور پٔکتھےٕ اوس ہیٚکان۔  
\v 9 سُہ اوس بوزان ییٚلہِ پولُسؔ خداوند یسوعسؔ متعلق ونان اوس،  پولُسسؔ پییہِ سیدِ سیٚود تمِس پیٚٹھ نظر تہٕ وچُھن تٔمسنٛدِس بُتھِس کُن یُس باوان اوس تہٕ پژھ ٲسس  زِ خداوند یسوع ہیٚکہٕ تمِس ٹھیک کٔرِتھ۔  
\v 10 تہٕ پولُسنؔ کٔر تمِس بڈِ کریٚکھ زِ تھوٚد وۅتھ۔   یہ بوزِتھ لوٚگ سُہ نفر وۅٹہٕ تُلنہِ تہٕ جلدےٕ اورٕ یور پھیرنہِ۔  
\v 11 ییٚلہِ لُکہٕ ارساتن یہ وُچھ زِ پولُسنؔ کیاہ کوٚر تہٕ تِمو سمُجھ زِ پولُسؔ تہٕ برنباس چھِ تِمےدیوتا یِمن ہنٛز تمہٕ عبادت کران ٲسؠ۔   لہٰذا تُل تِمو پننہِ لُکااُنیہ زبٲنؠ منٛز شورٕ شر "وُچھو! دیوتاہو چُھ پنُن پان لوٗکن ہِوُےٕ بنومُت تہٕ سانہِ مدتہٕ باپتھ چھِ آسمانہٕ پیٚٹھٕ وتھؠ مٕتؠ!"
\v 12 تِم لٔگؠ وننہِ زِ شاید چُھ برنباس ساروےٕ کھۅتہٕ بوٚڈ دیوتا یمسُنٛد ناو زِیوسؔ اوس۔   تہٕ تِم لٔگؠ وننہِ زِ پولُسؔ اوس ہرمیسؔ،  باقی دیوتاہن ہُنٚد پیغمبر۔   یہ زون تِمو اوٕ مۅکھٕ تکیازِ پولُسؔ اوس اکھ یُس کلام کران اوس۔  
\v 13 لوٗکھ ٲسؠ زِیوسؔ سنٛز پوٗزا شہرٕ کٮ۪ن دروازن نیٚبرٕ کنہِ اکِس مندرس منٛز کران۔   تتہِ یُس کاہن اوس سُہ ووت پولُسؔ تہٕ برنباس سنٛزٕ کتھٕ بوزِتھ شہرٕ کہِ پھاٹکہِ نِش یتہِ واریاہ لُکہ جمع ٲسؠ۔   تٔمؠ أنؠ زٕ دانٛد یِمن گردٕنہِ پوشہٕ ژادرٕ نٲلؠ آسہٕ۔   کاہن تہٕ لُکہٕ ہجوٗم اوس پولُسؔ تہٕ برنباسؔ سنٛزِ عبادٕژ ہنٛزِ تقریبہِ منٛز دانٛد جورؠ مارٕنؠ یژھان۔  
\v 14 مگر ییٚلہ رسولو،  برنباس تہٕ پولُسنؔ یہ بوز تہٕ سپدؠ سیٚٹھاہ پریشان تہٕ ژٔٹِکھ پانس پلو۔   تِم گےَ لوٗکن منٛز دوان دوان تہٕ دِژکھ کریٚکہٕ، 
\v 15 اے لوٗکو،  توٚہہ پزنو نہٕ یمہ دانٛد سانہٕ عبادتہٕ خٲطرٕ مارٕنؠ۔   أسؠ چھنہٕ دیوتا! أسؠ تہِ چھِ تُہنٛدےٕ ہیٚو طبیعت تھاون وٲلؠ انسان! أسؠ آے توٚہہ اکھ اصل خبر بوزناونہٕ باپتھ! أسؠ آے توٚہہ تس خدایس متعلق وننہٕ باپتھ یُس قدرت تھاون وول چُھ۔   سُہ چُھ یژھان زِ توٚہؠ ترایو باقی دیوتاہن ہنٛز پوٗزا کرٕنؠ،  تکیازِ تمہٕ ہیٚکن نہٕ توٚہہ مدد کٔرِتھ۔   تٔمؠ پٔزؠ خداین کٔرؠ آسمان،  زمین،  سمندر تہٕ تِمن منٛز موجود تمام چیز پٲدٕ۔  
\v 16 پتھ کالہِ ٲسیو توٚہؠ سٲری غٲر یہُودؠ تِمن معبودن ہنٛز پٲروی کران یِمن ہنٛز توٚہؠ پرستِش کرٕنؠ یژھان ٲسیٚو۔   خداین دِژو توٚہہ تِہنٛز عبادت کرنہٕ تکیازِ توٚہؠ ٲسؠ وون نہٕ سُہ زانان۔  
\p
\v 17 مگر تٔمؠ ہوو اسہِ زِ سُہ چُھ اسہِ سٟتؠ حلیمی سان پیش یوان۔   سُے چُھ آسمانہٕ پٮ۪ٹھٕ رود تراوان تہٕ فصٕل ۅپداوان۔   سُے چُھ یُس توٚہہِ واریاہ خۅراک دِوان چُھ تہٕ تُہنٛدؠ دِل خۅشی سٟتؠ رنٛزوان چُھ"
\v 18 لوٗکو بوز پولُسؔ سنٛز کتھ مگر تمہِ پتہٕ تہِ ٲسؠ سونٛچان زِ تِمہ دانٛد کرووکھ پولُسؔ تہٕ برنباس سنٛدِس عبادتس منٛز قربان۔   مگر ٲخر کوٚر لوٗکو تہِ نہ کرنُک فٲصلہٕ۔  
\p
\v 19 مگر کینٛہہ یہُودؠ آے انطاکیہ تہٕ اِکُنیُمؔ پیٚٹھٕ تہٕ کوٚرکھ لُسترہؔ کین واریہن لوٗکن باور زِ یُس پٲغام پولُسنؔ تِمن دیُت سُہ چھنہٕ پوٚز۔   یمو لوٗکو یہُودینؔ ہنٛزن کتھن پیٚٹھ پژھ کٔر تِم سپٕدؠ پولُسسؔ ناراض۔   تِمو لایہ ناوِ یہُودینؔ اتھِ تس کنہِ یۅتام سُہ پتھر پٮ۪تھ بے ہوش سپُد۔   سارنی باسیاو زِ سُہ مود،  اوٕ کِنؠ نیٚو سُہ تِمو شہرٕ نیٚبر کھکھرِ تہٕ ژھنُکھ تٔتی ترٲوِتھ۔  
\v 20 مگر لُسترہؔ ہٕکؠ کینٛہہ ایمان وٲلؠ آے تہٕ گےَ پولُسسؔ انٛدؠ انٛدؠ جمع یتِتھ سُہ پتھرِس پیٚٹھ اوس۔   پولُسسؔ آو ہوش! سُہ وۅتھ تھوٚد تہٕ گو ایمان والیٚن سٟتؠ شہر واپس۔  
\p دویمہِ دوٚہہ دراے پولُسؔ تہٕ برنباس لُسترہؔ شہرٕ منٛزٕ تہٕ گےَ دربی شہر کُن۔  
\v 21 تِم رودؠ تتہِ واریہن دوٚہُن تہٕ ٲسؠ لوٗکن یسوعسؔ متعلق رژٕ کتھٕ بوزٕناوان۔   واریاہ لوٗکھ بنیاے ایمان وٲلؠ۔   امہِ پتہٕ لٔگؠ پولُسؔ تہٕ برنباس واپس نیرنہ۔   تِم گےَ بیٚیہِ لُسترہؔ۔   پتہٕ گےَ تتہِ پیٚٹھٕ اِکُنیُمؔ تہٕ پسدیہ صوبہٕ کِس انطاکیہ شہرس منٛز۔  
\v 22 پرٛتھ جایہ کوٚر تِمو ایمان والیٚن تٲکید خداوند یسوعسؔ پیٚٹھ بھروسہٕ کرنُک۔   تِمو ووٚن ایمان والیٚن،  "اسہِ پیٚن واریاہ مشکلات برداش کرٕنؠ یۅتام نہٕ خدا ہمیشہٕ باپتھ اسہِ پیٚٹھ حکومت کرِ"
\p
\v 23 پولُسؔ تہٕ برنباسنؔ ژٲرؠ پرٛتھ کُنہِ جمٲژ باپتھ قٲید۔   امہِ برُونٛہہ زِ پولُسؔ تہٕ برنباس نیرٕہن یمو جایو،  تِمو کٔرؠ ایمان وٲلؠ جمع تہٕ گُزورُکھ کینٛہہ وق روزن تہٕ عبادتس تہٕ روزدری منٛز۔   پتہٕ کٔرؠ پولُسنؔ تہٕ برنباسنؔ یِم قٲید تہٕ ایمان وٲلؠ خداوند یسوعسؔ حوالہٕ یس پیٚٹھ تِمو ایمان اوٚنمُت اوس تاکہِ سُہ کرِ تِمن رٲچھ۔  
\p
\v 24 پولُسؔ تہٕ برنباس دراے پسدیہ ضلع منٛزؠ جنوب کِنؠ تہٕ گےَ پمفیلیہؔ ضلعس منٛز۔  
\v 25 تِمہ وٲتؠ تمہ ضلع کِس پرگہٕ شہرس منٛز تہٕ بوزٕ نٲوِکھ تتِکؠ لوٗکھ خداوند یسوعسؔ متعلق خدا سُنٛد پٲغام۔   پتہٕ گےَ تمہ اتلّیہ قصبس منٛز سمندری ساحِلس کُن۔  
\v 26 تتہِ پیٚٹھٕ گےَ تِم جہازس منٛز سوار سپدِتھ انطاکیہ صوبس کُن واپس روانہٕ۔   یہ ٲس سۅ جاے یتہِ پولُسؔ تہٕ برنباس باقی جاین سکھراونہٕ وزِ منٲدی کٔرِتھ ژارنہٕ آے،  تہٕ یتہِ ایمان والیٚو خدایس ونیاو زِ سُہ کٔرِنؠ پولُسؔ تہٕ برنباس سںنٛزِ اتھ کامہِ منٛز تِمن مدد یۅسہ ۅں تِمو انٛد واتنٲو۔  
\v 27 ییٚلہ تِم انطاکیہ شہر وٲتؠ تہٕ تِمو کٔرؠ ایمان وٲلؠ جمع۔   پتہٕ ووٚن پولُسنؔ تہٕ برنباسنؔ تِمن تہِ سورےٕ یتھ کنؠ زن خداین تِمن مدد کوٚر۔   خاص طور،  ووٚن تِمو تِمن یہ زِ خداین کِتھٕ پٲٹھؠ بنٲوؠ غٲر یہُودؠ لوٗکھ یسوعسؔ پیٚٹھ ایمان اننس قٲبل۔  
\v 28 پتہٕ رودؠ پولُسؔ تہٕ برنباس دوٚیمٮ۪ن ایمان والیٚن سٟتؠ واریہس وقتس انطاکیہ ہس منٛز۔
\c 15
\p
\v 1 پتہٕ گےَ کینٛہہ ایمان وٲلؠ یہُودؠ یہُودیہ صوبہ پیٚٹھٕ انطاکیہؔ۔   تِمو کٔر تتہِ غٲر یہُودؠ ایمان والیٚن یہ ؤنِتھ تعلیم دِنؠ شروع،  "توٚہہِ گژھِ ختنہٕ کٔرِتھ آسن تاکہِ یہ ننہِ زِ توٚہؠ چُھو خدایس سٟتؠ تعلق تھاوان،  یتھٕ کنؠ موسیٰؔ ہن تِمن قانونن منٛز حکم دیُتمُت اوس یمہ تس خدایہ سنٛدِ طرفہٕ میلمٕتؠ ٲسؠ۔   اگر توٚہؠ تہِ کریٚو نہٕ تہٕ توٚہہ میلہِ نہٕ نجات"
\v 2 پولُسؔ تہٕ برنباسنؔ کوٚر تِمن یہُودینؔ سٟتؠ سخت اختلاف تہٕ لٔگؠ تِمن سٟتؠ بحث کرنہِ۔   چناچہ انطاکیہ کیٚو ایمان والیٚو کٔرؠ پولُسؔ،  برنباسؔ تہٕ کینٛہہ دویِم ایمان وٲلؠ یروشلم گژھنہٕ خٲطرٕ مقرر تاکہِ تِم کرن رسولن تہٕ دوٚیمٮ۪ن قٲیِدن سٟتؠ اتھ ماملس متعلق کتھ۔  
\p
\v 3 پولُسؔ،  برنباس تہٕ باقی کینٛہہ،  ایمان والیٚن ہنٛدؠ دٔسؠ انطاکیہ سوزنہٕ پتہٕ گے تِمہ فینیکے تہٕ سامریہ کٮ۪ن صوبن منٛز۔   وتہِ ٹھہریاے تمہٕ واریہن جاین تہٕ دژٕکھ ایمان والیٚن خبر زِ واریہو غٲر یہُودیٚو اوٚن ایمان۔   یمہِ کِنؠ یِمن جاین موجود تمام ایمان والیٚن سیٚٹھاہ خوشی سپٕز۔  
\v 4 ییٚلہ پولُسؔ،  برنباس تہٕ باقی لوٗکھ یروشلم وٲتؠ تہٕ تتہِ کیٚو نبیو،  بزرگو تہٕ باقی جمٲژو ہنٛدیٚو ایمان والیٚو کوٚر تِمن استقبال۔   پتہٕ کٔرؠ پولُسنؔ تہٕ برنباسنؔ تِم چیز بیان یمہٕ غٲر یہُودینؔ منٛز کرنہٕ باپتھ تِم خداین تیار کٔرؠ۔  
\v 5 مگر کینٛہہ یہُودؠ ایمان وٲلؠ یِم فریسی فِرقس سٟتؠ تعلق تھاوان ٲسؠ گےَ باقی ایمان والیٚن منٛز کھڑا تہٕ ونُکھ تِمن،  "یمو غٲر یہُودیٚو یسوعسؔ پیٚٹھ ایمان اوٚن تِمن گژھِ ختنہٕ کرنہٕ یُن۔   تِم گژھن تِمن قوٲیِدن پیٚٹھ ضروری عمل کرٕنؠ یِم خداین موسیٰؔ ہس دِتمٕتؠ ٲسؠ۔  
\p
\v 6 پتہٕ سمیاے رسول تہٕ بزرگ اتھ ماملس پیٚٹھ کتھ کرنہٕ باپتھ۔  
\p
\v 7 واریہس کالس بحث کرنہٕ پتہٕ وۅتھ پطرس تھوٚد تہٕ کرٕن تِمن سٟتؠ کتھ۔   تٔمؠ ووٚن،  "اے ایمان والیٚو،  توٚہؠ سٲری چُھو زانان زِ واریاہ کال برُونٛہہ ژورنس بہٕ خداین توٚہہِ منٛزٕ تہٕ باقی نبیو منٛزٕ،  تاکہِ بہٕ ونہٕ غٲر یہُودینؔ تہِ خدایہ سنٛدِس محبتس متعلق،  یُتھ تِم تس پیٚٹھ ایمان انن۔  
\v 8 خدا چُھ پرٛتھ کانٛسہ سنٛدِ دِلُک حال زانان۔   تٔمؠ ہوو مےٚ تہٕ باقین زِ تٔمؠ بنٲوؠ غٲر یہُودؠ پاک روح عطا کٔرِتھ پنٕنؠ اُمت۔   یتھ پٲٹھؠ تٔمؠ سانہِ باپتھ تہِ کوٚر۔  
\v 9 خداین کٔرنہٕ تِمن تہٕ اسہِ منٛز کانٛہہ تفاوتھ تکیازِ تٔمؠ کٔرؠ تِہُنٛد اندرون صرف خداوند یسوعسؔ پیٚٹھ ایمان اننہٕ کِنؠ پاک۔   بلکُل کوٚر تٔمؠ تِتھے پٲٹھؠ اسہِ تہِ معاف۔  
\p
\v 10 توٚہؠ کیازِ چھوکھ غٲر یہُودؠ مجبور کرٕنؠ یژھان زِ تِم تہِ گژھن یہُودؠ رسوماتن تہٕ قانوٗنن ہنٛز پابنٛدی کرٕنؠ؟ یہ کرُن گو تِمن شٲگردن پیٚٹھ بوٚڈ بور تراونس برابر۔   یہ چُھ یمن تمن قانوٗنن ہنٛز پابنٛدی کرنس پیٚٹھ مجبوٗر کران یمہٕ سانیٚو جدٕ اجدادو تہِ پھُٹرٲوؠ مٕتؠ چھِ تہٕ یمنہٕ اسہِ یہُودیٚو تہِ زانٛہہ قٲیِم ہیٚکؠ تھٲوِتھ! تہٕ ووٚنؠ،  یتھ کنؠ خدا ناراض کرُن کٔریٚو بنٛد!
\v 11 أسؠ چھِ زانان زِ خدا چُھ اسہِ یہُودینؔ سانیٚو گُنہَو نِشہٕ بچاوان تکیازِ خداوند یسوعنؔ کیاہ کوٚر سانہِ خٲطرٕ۔   خدا چُھ اسہِ یہُودینؔ بلکُل تِتھے پٲٹھؠ بچاوان یتھ پٲٹھؠ سُہ تِمن غٲر یہُودینؔ بچاوان چُھ یِم خداوند یسوعسؔ پیٚٹھ پژھ تھاوان چھِ۔  
\p
\v 12 پطرس سنٛدِ وننہٕ پتہٕ کٔر تتہِ موجود ساروےٕ لوٗکو ژۅپہٕ۔   پتہٕ بوز تِمو پولُسؔ تہٕ برنباس سنٛز کتھ۔   تِمو دوٚیو کٔر تِمن عظیم معجزن ہنٛز کتھ یمہٕ غٲر یہُودؠ لوٗکن برُونٛہہ کنہِ انجام دِنس قٲبل تِم خداین بنٲوؠ۔   یم معجزات ظٲہر کران ٲسؠ زِ خداین کٔرؠ غٲر یہُودؠ تہِ قبوٗل۔  
\p
\v 13 ییٚلہ پولُسنؔ تہٕ برنباسنؔ پنٕنؠ کتھ انٛد واتنٲو تہٕ یروشلمس منٛز ایمان واجنہِ جمٲژ ہنٛدؠ قٲیِد یعقوبن کٔر تِمن سٟتؠ کتھ کرٕنؠ شروع۔   تٔمؠ ووٚن،  "ٹاٹھیٚو ایمان والیٚو،  میانؠ کتھ بوزیٚو۔  
\v 14 شمعون پطرسن ووٚن توٚہہِ زِ خداین کِتھ کٔنؠ کٔر گۅڈٕ غٲر یہُودینؔ برکت عطا۔   خداین ژٲرؠ گۅڈٕ تِمو منٛزٕ تِم لوٗکھ یِم تمسنٛدی بنیاے۔  
\p
\v 15 تِم لفظ یمہٕ خداین واریاہ برُونٛہہ ونمٕتؠ چھِ،  تِم الفاظ یمہٕ أکؠ نبین لیکھمٕتؠ چھِ تتھ سٟتؠ کٔریٚو اتفاق:
\q
\v 16 پتہٕ یمہٕ بہٕ واپس تہٕ کرن دوبارٕ داوود سنٛز بادشٲہی بحال تہٕ ژارن داوود سنٛدیو زُریٚو منٛزٕ اکھ بادشاہ۔   یہ آسہ تمِس شخصہٕ سنٛدؠ پٲٹھؠ یُس اکھ گھرٕ گِراونہٕ پتہٕ دوبارٕ تعمیر کران چُھ۔  
\v 17 بہٕ کرٕ یہ اوٕموٚکھٕ زِ باقی تمام لوٗکھ کرن مےٚ خداوند قدوسس زاننٕچ کوشش۔   اتھ منٛز آسن تم غٲر اسرائیلی تہِ شٲمِل یِم مےٚ پنٕنؠ تعلق دار زٲنمٕتؠ چھِ۔   توٚہؠ ہکیٚو پژھ کٔرِتھ زِ یہ سپدِ تکیازِ مےٚ خداوند خداین چھےٚ یمہٕ کتھٕ ونمژٕ۔  
\v 18 مےٚ چھِ یم چیز کٔرؠ مٕتؠ تہٕ مےٚ چھِ واریاہ برونٛہہ یِمن متعلق پنٕنؠ لوٗکھ آگاہ کٔرمٕتؠ۔  
\p
\v 19 یعقوبن تھٲو پنٕنؠ کتھ جٲری،  تٔمؠ ووٚن،  "لہٰذا چُھ مےٚ باسان زِ اسہِ پزِ غٲر یہُودؠ پریشان کرٕنؠ تراوٕنؠ یم پنٕنؠ گناہ ترک کرِتھ خدایس کُن رجوع کران چھِ۔   مطلب اسہِ پزِ یہ مطالبہ کرُن تراوُن زِ تِمن پزن سٲنؠ سٲری قانون تہٕ رسومات پالٕنؠ۔  
\v 20 امہ بجایہ پزِ اسہِ تِمن اکھ نامہٕ لیٚکھن یتھ منٛز ترین چیزن ہُنٛد تقاضہٕ کرو: تِم کھیٚن نہٕ ماز یِم لوٗکھ بُتن نظر کران چھِ،  تِم شونٛگن نہٕ کانٛسہِ تِتھس نفرس نِش یمِس سٟتؠ نہٕ تِہُنٛد خاندر سپُدمُت آسہ،  تِم کھیٚن نہٕ جانورن ہُنٛد ماز۔   یمہ ہوٚٹ چیرِتھ مارنہٕ آمٕتؠ آسن،  تہٕ تِمن پزِ نہٕ جانورن ہُنٛد خوٗن چیٚون۔  
\v 21 واریہن شہرن منٛز ٲسؠ واریہس وقتس لوٗکھ تِمن قانونن ہنٛز پارے دِوان یمہٕ موسیٰؔ ہن لیکھمٕتؠ ٲسؠ۔   تِتھؠ قانون یمہٕ تِمو چیزو نِشہٕ منع کران ٲسؠ تہٕ پرٛتھ سبت کہ دوٚہہ چھِ یم قانون یہُودین ہنٛدین سمن بلن پیٚٹھ پرنہٕ یوان۔   لہٰذا اگر غٲر یہُودؠ تِمن قانونن متعلق بیٚیہِ کینٛہہ زانُن یژھن تہٕ تمہٕ تہِ ہیٛکن سانین جلسہٕ گاہن منٛز یِتھ"
\p
\v 22 رسولو،  باقی بزرگو تہٕ یروشلمہٕؔ کیٚو تمام ایمان والیٚو کٔر یعقوب سنٛز کتھ قبول۔   پتہٕ کوٚر تِمو فٲصلہٕ زِ تِم ژارن پننیٚو منٛزٕ کینٛہہ نفر تہٕ تِمن سوزن پولُسؔ تہٕ برنباسسؔ سٟتؠ انطاکیہ تاکہ تتِکین ایمان والیٚن لگہ پےَ زِ یروشلم کیٚو رہنماہو کیاہ فٲصلہٕ نیٚو۔   چناچہ تِمو ژور یہُودا،  یمِس برسباؔ تہِ ونان چھِ تہٕ بیٚیہِ سیلاسؔ۔   یمہٕ دوٚنوے ٲسؠ یروشلمس منٛز ایمان والیٚن ہنٛدؠ رہنما۔  
\v 23 پتہٕ لیٚوکھ تِمو یہ نامہٕ تہٕ ونُکھ یہُوداؔ تہٕ سیلاسسؔ زِ تِم نِن یہ انطاکیہ کٮ۪ن ایمان والیٚن: "أسؠ رسول تہٕ بُزرگ یمہٕ توٚہہِ ہی ایمان وٲلؠ چھِ،  چھِ توٚہہِ سلام سوزان یتھٕ پٲٹھؠ أسؠ توٚہہِ غٲر یہُودؠ ایمان والیٚن ہنٛدِ ناوٕ لیٚکھان چھِ یمہٕ انطاکیہ،  صوریہؔ تہٕ کلکیہ کٮ۪ن باقی جاین روزان چھِ۔  
\p
\v 24 لوٗکو ووٚن اسہِ زِ اسہِ منٛزٕ گےَ کینٛہہ نفر توٚہہِ نِش حالانکہ تمہٕ ٲسؠ نہٕ اسہِ توٚہہِ نِش سوزمٕتؠ۔   اسہِ بوز زِ تِمو کٔریٚو توٚہؠ تمہٕ کتھٕ ؤنِتھ پریشان یمو سٟتؠ تُہنٛد سونٛچ منتشِر گو۔  
\v 25 ییٚلہ أسؠ یتہِ جمع گےَ تہٕ اسہِ نیٚو فٲصلہٕ زِ کینٛہہ نفر ژار ووکھ یمہ أسؠ برنباس تہٕ پولُسسؔ سٟتؠ یمہٕ اسہِ سیٚٹھاہ ٹٲٹھؠ چھِ توٚہہِ نِش گژھنہٕ باپتھ ونو۔  
\v 26 یمو دوٚنویو ترٲو پنٕنؠ زندگی خطرس منٛز تکیازِ تِم چھِ سٲنس خداوند یسوع مسیحؔ سنٛدؠ خدمتگار۔  
\p
\v 27 اسہِ سوزؠ یہُوداؔ تہٕ سیلاس تہِ توٚہہِ نِش۔   تِم ونن توٚہہِ تِم کتھٕ یمہٕ أسؠ لیٚکھان چھِ۔  
\v 28 اسہِ چھےٚ پژھ زِ پاک روحن ہوو اسہِ زِ اسہِ چھنہٕ سارنےٕ یہُودؠ قانونن ہنٛز پٲروی کرنٕچ ضرورت۔   سُہ بنہِ غٲر ضروری تہٕ سخت۔   امہِ بجایہ چھےٚ اسہِ صرف یمن ہِدایتن پیٚٹھ عمل کرٕنؠ:
\q1
\v 29 توٚہہِ پزِنہٕ سُہ کھیٚن کھیٚون یُس لوٗکو بُتو باپتھ نظر کوٚرمُت آسہ۔  
\q1 توٚہہِ چُھنہٕ جانورن ہُنٛد خوٗن چیٚون تہٕ نہ چُھو تِمن جانورن ہُنٛد ماز کھیٚون یمہٕ لوٗکو ۂٹؠ چیر دِتھ مٲرؠ مٕتؠ آسن۔  
\q1 امہِ علاوٕ،  چُھنہٕ توٚہہِ تِتھِس نفرس سٟتؠ شونٛگُن یمِس سٟتؠ نہٕ توٚہہِ خانٛدر آسہ سپُدمُت۔  
\p اگر توٚہؠ یمہٕ چیز کرٕنؠ ترک کٔریٚو تہٕ توٚہؠ کٔریٚو تہِ یہ صحیح چُھ۔   الوِداع"
\p
\v 30 تِمو یمہٕ ژور نفر ژٲرؠ تِمہ دراے یروشلمہٕؔ منٛزٕ تہٕ وٲتؠ انطاکیہ۔   ییٚلہ تتِکؠ تمام ایمان وٲلؠ جمع گےَ تہٕ تِمو دیُت سُہ خط تِمن۔  
\v 31 ییٚلہِ تتہِ کیٚو ایمان والیٚو خط پوٚر تہٕ سپٕدؠ خۅش تکیازِ تمہ پٲغامہٕ سٟتؠ سپٕز تِمن حوصلہٕ افزائی۔  
\v 32 نبی آسنہٕ موٚکھٕ کرِ یہُوداہنؔ تہٕ سیلاسنؔ واریاہ کتھٕ تہٕ کٔرکھ تتہِ کٮ۪ن ایمان والیٚن حوصلہٕ افزائی بیٚیہِ بڑٲوٕکھ خداوند یسوعسؔ پیٚٹھ تِمن زیادٕ پژھ۔  
\p
\v 33 ییٚلہ یہُوداؔ تہٕ سیلاس تتہِ کینٛژس کالس ٹھہریاے تہٕ یروشلم واپس گژھنہٕ باپتھ تیار سپٕدؠ تہٕ انطاکیہ کیٚو ایمان والیٚو کوٚر تِمن وژھِ وانجہ خٲر خٲہی تہٕ پتہٕ دراے تمہٕ۔  
\v 34 مگر سیلاسن سونٛچ زِ تمسنٛدِ خٲطرٕ چُھ تتہِ روزن بہتر۔  
\v 35 تاہم ٹھہریاے پولُسؔ تہٕ برنباس انطاکیہؔ ہسےٕ منٛز۔   ییٚلہ تمہٕ تتہِ ٲسؠ،  تِم ٲسؠ واریہن نفرن سٟتؠ لوٗکن تعلیم دِوان تہٕ تِمن خداوند یسوعسؔ متعلق پٲغام بوزٕناوان۔  
\p
\v 36 کینٛہہ کال گٔژھِتھ ووٚن پولُسنؔ برنباسسؔ،  "وۅلہٕ أسؠ نیرو واپس تہٕ پرٛتھ تتھ شہرس منٛز گژھو یتہِ اسہِ گۅڈے خداوند یسوعسؔ متعلق پٲغام بوزنٲومٕتؠ چھِ تہٕ سمکھو تتہِ ایمان والیٚن۔   یتھ کنؠ ترِ اسہِ فکرِ زِ تمہٕ کمہِ انمانٕچ پژھ چھِ خداوند یسوعسؔ پیٚٹھ جٲری تھٲوِتھ"
\v 37 برنباسنؔ کوٚر پولُسسؔ سٟتؠ اتفاق تہٕ وُننس زِ بہٕ چُھسن یوحنا یمسُنٛد دویم ناو مرقُسؔ چُھ دوبارٕ پانس سٟتؠ نیٚون یژھان۔  
\v 38 تاہم ووٚنُس پولُسنؔ در جواب،  "میون خیال چُھ زِ مرقُس پانس سٟتؠ نیٚون چُھنہٕ جان تکیازِ مرقُسنؔ ٲسؠ تمہٕ ترٲومٕتؠ ییٚلہ تمہٕ گۅڈٕ پمفیلیہؔ علاقس منٛز ٲسؠ تہٕ تِمن ہیٚوک نہٕ کام جٲری تھٲوِتھ۔  
\p
\v 39 پولُسنؔ تہٕ برنباسنؔ کوٚر اتھ ماملس پیٚٹھ پانہٕ وٲنؠ سخت اختلاف تہٕ دراے اکھ أکِس نِش الگ۔   برنباسنؔ تُل مرقُس پانس سٟتؠ۔   تِم کٔھتؠ اکِس جہازس تہٕ وٲتؠ کُپرس کِس جزیرس پیٚٹھ۔  
\v 40 پولُسنؔ ژور پانس سٟتؠ کٲم کرنہٕ باپتھ سیلاس یُس انطاکیہ واپس آمُت اوس۔   تتہِ کیٚو ایمان والیٚو کوٚر خداوند خدایس کُن دُعا تہٕ مونٛگہس مہربٲنی کٔرِتھ کر پولُسسؔ تہٕ سیلاسسؔ مدد۔   پتہٕ دراے تمہٕ دونوے انطاکیہ منٛزٕ۔  
\v 41 پولُسؔ رود سیلاسسؔ سٟتؠ صوریہؔ تہٕ کلکیہ کٮ۪ن صوبن ہُنٛد صفر کران۔   یمن جاین اوس سُہ ایمان والیٚن ہنٛزن جمٲژن ہُنٛد مدد کران زِ تِم تھاون خداوند یسوعسؔ پیٚٹھ پۅختہٕ بھروسہٕ۔
\c 16
\p
\v 1 پولُسؔ تہٕ سیلاس گےَ دربی تہٕ لُسترہؔ شہرن منٛز تہٕ کوٚرکھ تتہِ ایمان والیٚن سٟتؠ ملاقات۔   تہٕ نیوکھ یتھ جٲئزٕ۔   تیمُتھیس ناوک اکھ ایمان وول اوس لُسترہؔ شہرس منٛز روزان۔   تمؠ سنٛز موج ٲس اکھ یہُودؠ ایمان واجِنؠ،  مگر مول اوسُس یونٲنؠ۔  
\v 2 لُسترہنؔ تہٕ اِکُنیُمؔ کیٚو ایمان والیٚو کرِ تیمُتھیس متعلق جان کتھٕ، 
\v 3 تہٕ پولُسؔ اوس یژھان تیمُتھیس باقی جاین گژھنہٕ وزِ سٟتؠ تلُن امہِ باپتھ کوٚر تٔمؠ تیمُتھیس ختنہٕ۔   تٔمؠ کوٚر یہ اوٕ موٚکھٕ تاکہِ تِمن جاین ہنٛدؠ روزن وٲلؠ یہُودؠ کرن تتہِ یہُودؠ تیمُتھیس قبول،  تکیازِ تِم ٲسؠ زانان زِ تمسنٛدؠ غٲر یہُودؠ مٲلؠ اوس نہٕ تس ختنہٕ کوٚرمُت۔  
\p
\v 4 یتھ کنؠ گو تیمُتھیس پولُسؔ تہٕ سیلاسسؔ سٟتؠ تہٕ تِم گےَ واریہن دویمیٚن شہرن منٛز۔   پرٛتھ شہرس منٛز ؤنؠ تِمو ایمان والیٚن تِم اصول یمہٕ یروشلمس منٛز رسولو تہٕ بزرگو وضع کٔرمٕتؠ ٲسؠ۔  
\p
\v 5 تِمو کوٚر تمہِ شہرٕ کٮ۪ن ایمان والیٚن مدد زِ تِم کٔرِنؠ خداوند یسوعسؔ پیٚٹھ مکمل پٲٹھؠ پژھ،  تہٕ پرٛتھ دوٚہہ بنیاے واریاہ لوٗکھ ایماندار۔  
\p
\v 6 پولُسؔ تہٕ تمسنٛدؠ سٲتھی رکٲوؠ پاک روحن آسیہؔ ہس منٛز کلام کرنہٕ نِشہٕ تہٕ تِم دراے فرُوگیہؔ تہٕ گلتیہ کٮ۪ن علاقن کُن۔  
\v 7 تِم وٲتؠ موسیہ صوبہٕ کٮ۪ن سرحدن نِش تہٕ تِم ٲسؠ بتُھنیہؔ کٮ۪ن صوبن کُن گژُھن یژھان مگر یسوع سنٛدؠ روحن رکٲوؠ تِم بیٚیہِ تور گژھنہٕ نِشہٕ۔  
\v 8 چناچہ تِم دراے موسیہ صوبہٕ کِنؠ سمندر بٔٹھؠ بٔٹھؠ ترواسؔ شہرس منٛز۔  
\p
\v 9 تمہِ رٲژ ہوو خداین پولُسسؔ خابس منٛز مکدُنیہ ہُک اکھ نفر۔   یُس پولُسسؔ ناد اوس لایان "مکدُنیہ یتھ کر اسہِ مدد"
\v 10 سُہ خاب وُچِھتھ دراے أسؠ مکدُنیہ کُن۔   تکیازِ اسہِ اوس یقین زِ خداین بُلٲوؠ أسؠ تتہِ کٮ۪ن لوٗکن خۅش خبر بوزناونہٕ باپتھ۔  
\p
\v 11 أسؠ گےَ ناوِ منٛز سوار سپدِتھ ترواسؔ پیٚٹھٕ سمتُرا کُن تہٕ دویمہِ دوٚہہ گےَ نیاپُلس شہرس منٛز۔  
\v 12 نیاپُلس شہرٕ منٛزٕ نیرتھ گےَ پتہٕ أسؠ فلپی۔   یہ اوس مکدُنیہُک سیٚٹھاہ اہم شہر یتہِ واریاہ رومی شہری روزان ٲسؠ۔   أسؠ رودؠ فلپی منٛز واریہس کالس۔  
\p
\v 13 سبت کہِ دوٚہہ دراے أسؠ شہرچہِ پھاٹکہِ نٮ۪بر دریاوس کُن۔   اسہِ بوز کُستام یہ ونان زِ یہُودؠ چھِ عبادت باپتھ ہُتیٚتھ جمع سپدان۔   ییٚلہ أسؠ توٚت وٲتؠ تہٕ اسہِ وُچھٕ کینٛہہ زنہِ یمہٕ دُعا باپتھ جمع آسہٕ سپٕزمژٕ،  أسؠ بیٹھؠ پتھر تہٕ لگؠ یسوعسؔ متعلق تِمن وننہِ۔  
\p
\v 14 تِمن منٛز ٲس لُدیاہ ناوٕچ اکھ زٔنؠ تہِ یۅسہ پولُسؔ سنٛزٕ کتھٕ بوزان ٲس۔   سۅ ٲس تھواتیرہؔ شہرٕچ۔   قرمِزؠ کپُر کٕنان تہٕ خدایہِ سنٛز عبادت کران۔   خداوند خداین پھیٚور تمسُنٛد توجو تِمن کتھن کُن یمہٕ پولُسن ونہِ،  تہٕ تمہِ کوٚر تِمن پیٚٹھ یقین اوس
\v 15 ییٚلہ پولُسنؔ تہٕ سیلاسن لُدیہؔ تہٕ تمسنٛدس گرس منٛز روزن والیٚن باقی لوٗکن بپتسمہ دیُت تہٕ تٔمؠ ووٚن تِمن،  "اگر توٚہہِ یقین چُھ زِ بہٕ چُھس خداوند خدایہِ سُنٛد وفادار رودمُت تیٚلہ یی تو میٚون گھرٕ تہٕ روزؠ تو تٔتؠ۔   تمسنٛدِ وننہٕ پتہٕ رودؠ أسؠ تہنٛدے گھرِ۔  
\p
\v 16 ببیہِ اکہِ دوٚہہ ییٚلہ أسؠ تتھ جایہ وٲتؠ یتہٕ لوٗکھ عبادت کرنہٕ باپتھ جمع ٲسؠ،  گو اسہِ أکِس نوجوان خوتونہِ سٟتؠ ملاقات یۅسہ اکھ غلام ٲس۔   اکھ بد روح اوس تمِس لوٗکن ہُنٛد مستقبل بیان کرنُک طاقت دِوان۔   تمسنٛدؠ مٲلک ٲسؠ لوٗکن نِش پونٛسہٕ رٹان تہٕ تتھ ماوض تِمن ونناوان زِ توٚہہِ سٟتؠ کیاہ گُزرِ۔  
\v 17 یہ نوجوان خوتون لٔج پولُسؔ تہٕ اسہِ باقین لوٗکن پتہٕ پتہٕ پٔکِتھ کریکہٕ دِنہِ،  "یِم لوٗکھ چھِ خدایہ سنٛز عبادت کران یُس ساروےٕ کھۅتہٕ بوٚڈ خدا چُھ۔   یِم چھِ توٚہہ ونان زِ خدا کِتھٕ کنؠ بچاوِ توٚہہِ"
\v 18 سۅ روز واریہن دوٚہُن یی کران،  ٲخرس کھوٚت پولُسسؔ شرارتھ،  یمہِ کِنؠ سُہ أمِس نوجوان خوتونہِ کُن متوجہ سپُد تہٕ کٔرن تس بد روحس سٟتؠ کتھ یُس تمِس منٛز اوس۔   تٔمؠ ووٚن،  "یسوع مسیحؔ سُنٛد سوال چھی،  أمِس منٛزٕ نیر نیٚبر!" یکدم ژھنؠ سۅ بد روحن یلہٕ۔  
\p
\v 19 تہٕ پتہٕ لوٚگ تمسنٛدین مٲلکن پےَ زِ ووٚنؠ ہیٚکہِ نہٕ سۅ سانہِ باپتھ پونٛسہٕ کمٲوِتھ تکیازِ ووٚنؠ ہیٚکہِ نہٕ سۅ پیشن گویی کرتھ زِ کس سٟتؠ کیاہ سپدِ۔   امہِ کِنؠ گےَ تِم ناراض تمو رۅٹ پولُسؔ تہٕ سیلاس تہٕ نیٖکھ أکِس عوٲمی چوکس منٛز یتہِ شہرٕکؠ حٲکم ٲسؠ۔  
\v 20 نوجوان خوتونہِ ہنٛدؠ مٲلکو أنؠ تِم شہرٕ کٮ۪ن حکمرانن نِش تہٕ ونُکھ تِمن،  "یِم چھِ یہُودؠ لوٗکھ یِم چھِ سانہِ شہرٕ کٮ۪ن لوٗکن پریشان کران۔  
\v 21 یِم چھِ تِمن ہیٚچھٕ ناوان زِ اسہِ پزِ تِمن اصولن پیٚٹھ عمل کرٕنؠ یِمن سون شریعت اسہِ رومین ماننُک اجازت چُھنہٕ دِوان۔  
\p
\v 22 ہجومس منٛز ؤتھؠ تِمن سٟتؠ واریاہ یِم پولُسسؔ تہٕ سیلاسسؔ الزام لاگان ٲسؠ تہٕ ہیٚتِکھ تِمن چوب دِنؠ۔   پتہٕ ؤتھؠ رومی حکمران سِپہن کُن زِ تِم ژٹن پولُسؔ تہٕ سیلاسسؔ پلو تہٕ دِنکھ لکٕریو ڈنڈو سٟتؠ مار۔  
\v 23 چناچہِ سِپہو لوُے پولُسسؔ تہٕ سلاسسؔ ڈنڈو سٟتؠ کۅپٲٹھؠ تہِ بیٚپٲٹھؠ۔   تمہِ پتہٕ تُلِکھ تہٕ بٔرِکھ قٲد۔   تَمو ووٚن جیلرس زِ یِم گژھن نہٕ کُنہِ تہِ حالس منٛز جیلہٕ منٛزٕ نیرٕنؠ۔  
\v 24 ییٚلہ افسرن جیلرس یہ ووٚن،  اوٕ کِنؠ تھٲوؠ جیلرن پولُسؔ تہٕ سیلاس تتھ کمرس منز یُس جیل خانس منٛز ساروےٕ کھۅتہٕ انٛدر کُن اوس،  تتہِ بہنٲوؠ تٔمؠ تِم پتھرِس پیٚٹھ تہٕ تھاوِنکھ زنٛگہٕ وہرِتھ۔   تہٕ پتہٕ أنِنؠ زٕ تھمبہٕ ٹُکرٕ تِمن کٔرنؠ بڈؠ گٔدؠ تہٕ تھٲوِن تِہنٛدؠ گۅڈ تِمن منٛز بنٛد یُتھ نہٕ پولُسؔ تہٕ سیلاس پننٮ۪ن زنٛگن حرکت کٔرِتھ ہیٚکن۔  
\p
\v 25 قریبن نیصف رٲژ ٲسؠ پولُسؔ تہٕ سیلاسؔ گیوان گیوان خدایس کُن دعا پران۔   باقی قٲدؠ ٲسؠ تِہُنٛد یہ کلام بوزان۔  
\v 26 اچانک گو اکھ خطرناک بنیٚل یمؠ سٲری جیلٕکؠ کٕن الرٲوؠ۔   بنلہِ سٟتؠ گے سٲری دروازٕ یلہٕ تہٕ قٲدین پییٚہِ تمام گنجمژٕ زنجیرٕ وسِتھ۔  
\v 27 جیلر وۅتھ تھوٚد تہٕ اتہِ وُچِھن قٲد خانن ہنٛدؠ سٲری دروازٕ بنلہِ سٟتؠ یلہٕ گٲمتؠ تمِس باسیاو زِ قٲدی چھِ ژلمٕتؠ اوٕ مۅکھٕ کٔڈ تٔمؠ تلوار پنُن پان مارنہٕ باپتھ،  تکیازِ تمِس اوس معلوم زِ اگر قٲدیو آزٲدی پرٲو تہٕ شہرٕکؠ حٲکم کرن تس قتل۔  
\v 28 پولُسنؔ وُچھ جیلر تہٕ دِتُن تس ناد،  "پنُن پان مہِ مار! أسؠ سٲری قٲدؠ چھِ یتؠ!
\p
\v 29 جیلرن دیُت کستام مشٲلؠ زالنہٕ باپتھ ناد تاکہِ سُہ وُچھِ ہے زِ قٲدخانس منٛز کُس کُس چُھ موجود،  سُہ لرزیو تہٕ ژاو کھوژؠ کھوژؠ انٛدر تہٕ پیٚو پولُسسؔ تہٕ سیلاسسؔ پادن۔  
\v 30 پتہٕ کٔڈؠ تمؠ پولُسؔ تہٕ سیلاس جیلہٕ منٛزٕ نیٚبر تہٕ پرُژھنکھ،  "میانیٚو آقاوو،  نجات لبنہٕ خٲطرٕ کیاہ چُھ مےٚ کرُن؟"
\v 31 تِمو دِتُس جواب،  "خداوند یسوعس پیٚٹھ تھاو بھروسہٕ ژٕ تہٕ چون گھرٕ لبہِ نجات۔  
\p
\v 32 پتہٕ کرِ پولُسنؔ تہٕ سیلاسنؔ تمِس تمسنٛدین گرِ کیٚن سٟتؠ خداوند یسوعسؔ متعلق کتھٕ
\v 33 پتہٕ چھٔلؠ نیصف رٲژ جیلرن تہنٛدؠ زخم۔   امہِ پتہٕ دیُت پولُسنؔ تہٕ سیلاسن تمِس تہٕ تمسنٛدین تمام گھرِ بٲژن بپتسمہ۔  
\v 34 پتہٕ نی جیلرن پولُسؔ تہٕ سیلاس پنُن گھرٕ تہٕ تتہِ کھیاوٕنؠ چیاونؠ۔   سُہ تہٕ تمسنٛدؠ گھرٕکؠ سٲری بٲژ ٲسؠ سیٚٹھاہ خۅش تکیازِ تِم ٲسؠ خدایس پیٚٹھ پژھ تھاوان۔  
\p
\v 35 بیکہِ دوٚہہ صبحٲے ووٚن شہرٕ کیٚو حٲکمو کینٛژن سِپہن زِ تِم گٔژھِن قٲد خانہٕ تہٕ تتہِ ؤنِن جیلرس،  "تِم دوٚنوے قٲدؠ تراوُکھ یلہٕ۔  
\v 36 ییٚلہ جیلرن یہ بوز تہٕ سُہ گو تہٕ ونُن پولُسسؔ،  "شہرٕ کیٚو حٲکمو ووٚن مےٚ توٚہؠ رہا کرنہٕ باپتھ۔   لہٰذا گٔژھیٚو توٚہؠ دوٚنوے ووٚنؠ سکوٗنہٕ سان قٲد ترٲوِتھ!
\v 37 مگر پولُسنؔ ووٚن جیلرس،  "شہرٕ کیٚو حکمرانو ووٚن لوٗکن زِ أسؠ رومی شہری آسنہٕ باوجود گژھو لُکہٕ ہجومس برُونٛہہ کنہِ چوبو سٟتؠ دگٕنؠ تہٕ پتہٕ قٲد برٕنؠ۔   تہٕ ووٚنؠ چھا کٲنٛسہِ کینٛہہ وننہٕ بغٲر اسہِ رخصت کرُن یژھان! أسؠ کرو نہٕ یہ قبول! تِم شہرٕکؠ حٲکم ین پانےَ تہٕ کرن اسہِ جیلہٕ منٛزٕ رہا۔  
\v 38 چناچہ سِپاہ گےَ تہٕ ونُکھ شہرٕ کٮ۪ن حٲکمن تہِ یہ پولُسنؔ ووٚن۔   ییٚلہ شہرٕ کیٚو حٲکمو بوز زِ پولُسؔ تہٕ سیلاس چھِ رومی شہری تہٕ تِم کھوژؠ تکیازِ تِمو ٲس غلط کٲم کرمٕژ۔  
\v 39 چناچہ شہرٕکؠ حٲکم آے پولُسسؔ تہٕ سیلاسسؔ نِش تہٕ ونُکھ تِمن زِ اسہِ یہ کینٛژھا توٚہہِ سٟتؠ کوٚر أسؠ چھِ تتھ پیٚٹھ شرمنٛدٕ۔   شہرٕ کیٚو حٲکمو کٔڈؠ تِم قٲدٕ خانہٕ منٛزٕ نٮ۪بر تہٕ ووٚنہکھ شہرٕ نٮ۪بر نیرنہٕ باپتھ۔  
\p
\v 40 پولُسؔ تہٕ سیلاس سنٛدِ قٲد خانہٕ منٛزٕ نیرنہٕ پتہٕ گےَ تِم لُدیاہؔ سُنٛد گھرٕ۔   تتہِ سمٕکھؠ تِم تس تہٕ باقی ایمان والیٚن۔   تِمو کٔر ایمان والیٚن حوصلہٕ افزائی زِ تِم چھِ خداوند یسوعسؔ پیٚٹھ ہیٚتھےٕ یقین تھاوان،  پتہٕ دراے دوٚنوے رسول فلپس شہرٕ منٛزٕ۔
\c 17
\p
\v 1 پتہٕ وٲتؠ تِم امفِپلِسؔ تہٕ اپلونیہؔ شہرو منٛزؠ تھِسلُنِیکے شہر۔   تتہِ اوس یہُودینؔ ہُنٛد اکھ عبادت خانہٕ۔  
\v 2 سبت کہ دوٚہہ گو پولُسؔ حسبِ معمول اتھ عبادت خانس منٛز۔   تریٚن ہفتن رود یہ سبت کہ دوٚہہ متوٲتِر گژھان۔   تٔمؠ کٔر لوٗکن سٟتؠ اتھ متعلق کتھ زِ کتھٕ کنؠ چُھ صحیفن منٛز لیکھنہٕ آمُت زِ یسوع آسہ مسیحؔ۔  
\v 3 پولُسن کوٚر صحیفو سٟتؠ ظٲہر زِ نبیو چُھ لیٚوکھمُت زِ مسیحسؔ چُھ مٔرِتھ دوبارٕ زندٕ سپدُن۔   تٔمؠ ووٚن،  "بہٕ چھُسو توٚہہِ یسوعسؔ متعلق ونان۔   یہِ نفر چھُ مسیحؔ"
\v 4 تتہِ کیٚو بیشتر یہودیٚو کٔر پولُسؔ سنٛدِس وننَس پیٚٹھ پژھ تہٕ لوگُکھ پولُسسؔ سیلاسسؔ سمکھُن۔   ورایاہ غٲر یہُودؠ لوٗکھ تہٕ خدایہ سنٛز عبادت کرن واجنہِ خاص مستوراتہٕ تہِ آسہٕ یمہٕ یسوعسؔ متعلق پٲغامن پیٚٹھ یقین تھاوان آسہٕ تہٕ گییہِ پولُسسؔ تہٕ سیلاسسؔ سمکھنہِ تہِ۔  
\p
\v 5 مگر یہُودینؔ ہنٛدؠ کینٛہہ زِٹھؠ گےَ ناراض تکیازِ واریہو لوٗکو کوٚر پولُسؔ سنٛزِ تعلیمہ پیٚٹھ یقین۔   چناچہ تِم گےَ ژۅوتِس پیٚٹھ تہٕ کٔرٕکھ کینٛہہ شرارتی پانس سٟتؠ نِنس پیٚٹھ آمادٕ۔   یتھ پٲٹھؠ کوٚر یہُودؠ زِٹھیٚو اکھ ہجوم تیار تہٕ تلکھ بڈِ شور۔   تِم یہُودؠ تہٕ باقی دویم لوٗکھ دوریاے یاسونؔ ناوٕ کِس شخصہٕ سُنٛد گرٕ یتہِ پولُسؔ تہٕ سیلاس ٹھہرِتھ ٲسؠ۔   تِم ٲسؠ تِمن نٮ۪بر کڈٕنؠ یژھان یتہِ لُکہ ہجوم اوس۔  
\v 6 تِمو وُچھ زِ پولُسؔ تہٕ سیلاس ٲسؠ نہٕ گھرس موجودے مگر تِمو اوٚن یاسونؔ ژھانٛڈ دِتھ رٔٹِتھ۔   تِمو نیٚو سُہ تہٕ بیٚیہِ کینٛہہ ایمان وٲلؠ کھکھرِ تہٕ واتنٲوِکھ شہرٕ کٮ۪ن حٲکمن نِش۔   تِمو ووٚن،  "دنیاہس منٛز پرٛتھ جایہ فصاد تُلن وٲلؠ یِم لوٗکھ وٲتؠ یُت تہِ، 
\v 7 تہٕ یمؠ سٲتھی یاسوننؔ دیُت یمن پننِس گرس منٛز پناہ۔   تِم چھِ شہنشاہس خلاف کٲم کران۔   تِم چھِ ونان زِ بیٚیہِ اکھ شخص،  یمسُنٛد ناو یسوع چُھ،  چُھ حقیقی بادشاہ!"
\p
\v 8 ییٚلہ لوٗکن ہُنٛد ہجوم جمع سپُد تہٕ شہرٕ کیٚو حٲکمو یہ بوز تِمن کھۅت شرارت تہٕ آے غٲرتس لاینہٕ۔  
\v 9 شہرٕ کیٚو حٲکمو کوٚر یاسونسؔ تہٕ باقی ایمان والیٚن نِش جُرمانہٕ وصول تہٕ وُنہکھ،  اگرنہٕ أسؠ پولُسؔ تہٕ سیلاسن مذید پریشان کٔرؠ تہٕ أسؠ دِمو توٚہہِ یہ جرمانُک رقم واپس۔   تہٕ پتہٕ ترووُکھ یاسونؔ تہٕ باقی ایمان وٲلؠ یلہٕ۔  
\p
\v 10 چناچہ امی رٲژ نی ایماندارو پولُسؔ تہٕ سیلاس تھِسلُنِیکے منٛزٕ کڈتھ بیریاؔ شہر کُن۔   ییٚلہ پولُسؔ تہٕ سیلاس توٚت وٲتؠ تہٕ تِم گےَ یہُودینؔ ہنٛدس جلسہٕ گاہس منٛز۔  
\v 11 تھِسلُنِیکے ہکؠ اکثر یہُودؠ ٲسؠ نہٕ خدایہ سُنٛد پٲغام بوزنہٕ خٲطرٕ تیار ییٚلہ زن بیریاہسؔ منٛز روزن وٲلؠ یہُودؠ بوزنہٕ خٲطرٕ تیار ٲسؠ،  لہٰذا بوز تِمو کن دٲرتھ یسوع سُنٛد پٲغام۔   تِم ٲسؠ پرٛتھ دوٚہہ پننہِ باپتھ یہ زاننہٕ خٲطرٕ صحیفہٕ پران زِ یہ کینٛژھا پولُسؔ یسوعسؔ متعلق ونان چُھ تہِ چھا پوٚز۔  
\v 12 پولُسؔ سنٛزِ تعلیمہ ہنٛدِ سببہٕ اوٚن واریہو یہُودیٚو یسوعسؔ پیٚٹھ ایمان تہٕ کینٛژو اہم غٲر یہُودؠ زنیٚو تہٕ واریہو غٲر یہُودؠ مردو تہِ اوٚن تمِس پیٚٹھ ایمان۔  
\p
\v 13 مگر تھِسلُنِیکے کیٚو یہُودیٚو بوز زِ پولُسؔ چُھ بیریہؔ ہس منٛز یسوعسؔ متعلق خدایہ سُنٛد پٲغام بوزٕناوان۔   اوٕ کِنؠ گےَ تِم بیریاؔ تہٕ تتہِ ونیٚکھ لوٗکن تِژھٕ کتھٕ یمو سٟتؠ تِم پولُسسؔ پیٚٹھ سیٚٹھاہ ناراض سپدؠ۔  
\v 14 بیریہؔ کیٚو کینٛژو با ایمان نفرو نیٚو پولُسؔ دویمِس شہرس منٛز گژھنہٕ باپتھ سمندر بٔٹھِس پیٚٹھ۔   مگر سیلاسؔ تہٕ تیمُتھیس رودؠ بیریہؔ ہس منٛز۔  
\v 15 ییٚلہ پولُسؔ تہٕ باقی نفر سمندر بٹھِس پیٚٹھ وٲتؠ تہٕ تِم گےَ ناوِ تار دِتھ اتھینس شہر۔   پتہٕ ووٚن پولُسنؔ تِمن نفرن یِم تس سٟتؠ آے،  "سیلاسسؔ تہٕ تیمُتھیس ؤنیٚو زِ یوٗتاہ جلد ممکن سپدِ تیوٗت وٲتیٚو مےٚ نِش یور ایتھنیؔ شہر۔   پتہٕ گےَ تِم نفر ایتھنیؔ ترٲوِتھ واپس بیریہؔ۔  
\p
\v 16 ایتھنیؔ منٛز اوس پولُسؔ سیلاسؔ تہٕ تیمُتھیس سنٛدِس ینس پراران۔   تتھ دوران رود سُہ شہرس پھیران۔   سُہ سپُد پریشان تکیازِ تتھ شہرس منٛز ٲسؠ واریاہ بُت۔  
\v 17 چناچہ سُہ گو یہُودین ہنٛدِس عبادت گاہس منٛز تہٕ کرٕن یہُودین سٟتؠ یسوعسؔ متعلق کتھ تہٕ تِمن یونٲنؠ نفرن سٟتؠ یِمو تہِ قبول کوٚر یتھ پیٚٹھ یہُودین ایمان چھُ۔   سُہ اوس پرٛتھ دوٚہہ لُکہٕ پیٚنجن پیٚٹھ تہِ گژھان تہٕ تتہِ موجود لوٗکن سٟتؠ کتھ کران۔  
\p
\v 18 پولُسنؔ کوٚر کینٛژن وۅستادن سٟتؠ ملاقات یمہٕ لوٗکن ہنٛزِ ایمان پیٚٹھ کتھ کرٕنؠ پسنٛد ٲسؠ کران۔   لوٗکھ ٲسؠ یِمو منٛزٕ کینٛژن اپکورین ونان،  تہٕ باقین ٲسؠ اسٹوکس ونان۔   تِمو ووٚن پولُسسؔ زِ تِمن کیاہ ایمان چُھ،  تہٕ تِمو پرُوژھ تس توٚہؠ کیاہ کتھ پیٚٹھ چُھو یقین تھاوان۔   پتہٕ ووٚن تِمو منٛزٕ کینٛژو اکھ اکِس،  "سُہ چُھ کینٛژن عجیب خداین متعلق کہتام ونان" تِمو ووٚن زِ پولُسؔ اوس تِمن ونان زِ یسوعؔ مود تہٕ پتہٕ گو بیٚیہِ زنٛدٕ۔  
\p
\v 19 لہٰذا نیٚو سُہ تِمو تتھ جایہ یتِتھ شہرٕکؠ سردار سمٕکھؠ۔   ییٚلہ تِم تتھ جایہ وٲتؠ تہٕ تِمو ووٚن پولُسسؔ،  "مہربٲنی کرِتھ ونتہٕ اسہِ زِ یہ نُوو پٲغام کیاہ چُھ یُس ژٕ لوٗکن ونان چُھکھ؟
\v 20 ژٕ چُھکھ کینٛہہ تمہٕ کتھٕ ہیٚچھناوان یمہ نہٕ اسہِ سمٕجھ یوان چھےٚ،  اوٕ کِنؠ چھِ أسؠ زانُن یژھان زِ تِمن کیاہ مطلب چُھ۔  
\v 21 ایتھنیؔ کیٚو لوٗکو تہٕ باقی علاقہ کیٚو لوٗکو تہِ یِم تتہِ روزان ٲسؠ ٲسؠ تتھ متعلق کتھ بوزُن پسنٛد کران یہ تہنٛدِ باپتھ نُوو اوس۔  
\p
\v 22 پتہٕ گو پولُسؔ سردارن لوٗکن برُونٛہہ کنہِ کھڑا تہٕ ونُن،  "ایتھنیؔ کیٚو لوٗکو،  بہٕ چُھس وُچھان زِ توٚہؠ چُھو سیٚٹھاہ دیندار۔  
\v 23 بہٕ چُھس یہ اوٕ کِنؠ ونان زِ ییٚلہ بہٕ پکان اوسُس تہٕ مےٚ وُچھ یِم چیز یمن ہنٛز توٚہؠ عبادت کران چُھو،  حالانکہ مےٚ وُچھ اکھ قربان گاہ تہِ یتھ پیٚٹھ یِم الفاظ ٲسؠ یمہٕ کٔمؠ تام کٔھنمٕتؠ چھِ: "یہ چھےٚ تمِس خدایس تعظیم کران یُس نہٕ أسؠ زانوون" تہٕ ووٚنؠ چُھس بہٕ توٚہہ تس خدایس متعلق ونان یمسنٛز توٚہؠ عبادت کران چُھو مگر توٚہہ چھنہٕ پتاہ۔  
\p
\v 24 یہ چُھ سُے خدا یمؠ یہ دنیا تہٕ اتھ منٛز موجود پرٛتھ اکھ چیز بنوو۔   سُہ چُھ آسمانس تہٕ زمینہِ پیٚٹھ موجود تمام ذوزٲژن پیٚٹھ حکومت کران،  تہٕ سُہ چُھنہٕ ہیکلن منٛز روزان یمہ لوٗکو بنٲوؠ مٕتؠ چھِ۔  
\v 25 تمِس چھنہٕ لوٗکن ہنٛدِ ذریعہ پننہِ باپتھ کینٛہہ بناونٕچ ضرورت تکیازِ سُے چُھ لوٗکن زندٕ تھاوان تہٕ شاہ دِوان،  تہٕ سُہ چُھ تِمن تہِ سورےٕ دِوان یہ تِمن ضرورت چُھ۔  
\p
\v 26 گۅڈٕ کٔر خداین اکھ جورؠ پٲدٕ،  تہٕ تِمنےٕ نِش کرِ خداین تمام لوٗکہ جمٲژ پٲدٕ یمہ وُنکٮ۪ن زمینہِ پیٚٹھ پرٛتھ جایہ روزان چھےٚ۔   تٔمؠ تھاو پرٛتھ کانٛہہ جماتھ پننہ وقتہٕ باپتھ پننِس مقامس پیٚٹھ۔  
\v 27 سُہ اوس یژھان زِ لوٗکھ سمجھن یہ زِ تِمن چھےٚ تمؠ سنٛز ضرورت۔   شاید ژھانڈٕ ہن پتہٕ تِمہ تمِس تہٕ لبہنَس۔   خدا چُھ یژھان زِ أسؠ ژھانڈٕ وون سُہ،  حالانکہ سُہ چُھ اسہِ سارنی سیٚٹھاہ نزدیک۔  
\v 28 یہ چُھ خدایہ سنٛدے یژھنہٕ زِ أسؠ چھِ حیات،  زُوان تہٕ پکان،  یتھ کنؠ زن توٚہہ منٛزٕ کٔمؠ تام ووٚن،  "تکیازِ أسؠ چھِ،  تسنٛدؠ اولاد"
\p
\v 29 أسؠ چھِ خدایہ سنٛدؠ اولاد،  یہ گمانہٕ کٔرؠ زیٚو نہٕ زِ خدا چُھ سۅن،  چانٛدؠ یا کُنہِ کنہِ ہُنٛد آکار یُس کانٛسہ انسانن بنومُت اسہِ۔  
\v 30 ییٚلہ نہٕ لوٗکھ زانٲنی ٲسؠ زِ خدا کیاہ چُھ تِمن نِش یژھان،  تمؠ دیُت نہٕ تِمن تہنٛدین کرمن ہُنٛد سزا۔   مگر ووٚنؠ چُھ خدا پرٛتھ جایہ تمام لوٗکن بُرٕ کامیٚو نِشہٕ باز ینُک حکم دِوان۔  
\v 31 سُہ چُھ اسہِ ونان زِ اکہِ خاص دوٚہہ یُس تٔمؠ ژورمُت چُھ ہییہِ سُہ اسہِ سارنی حساب تمِس انسان سنٛدِ ذریعہ یُس تٔمؠ مقرر کوٚرمُت چُھ،  یہ کتھ یقینی بنٲوِتھ سمجِھو زِ أسؠ کروون سُہ شخص مۅردو منٛزٕ زنٛدٕ"
\p
\v 32 ییٚلہ یمو نفرو پولُسؔ یہ ونان بوز زِ اکھ نفر سپُد مرنہٕ پتہٕ بیٚیہِ زندٕ تہٕ تِمو منٛزٕ لگؠ کینٛہہ تس پیٚٹھ اسنہِ۔   مگر باقیو ووٚن تس واپس ینہٕ خٲطرٕ تہٕ اتھ متعلق بیٚیہِ کُنہ دوٚہہ وننہٕ باپتھ۔  
\v 33 یہ وننہٕ پتہٕ دراو تتہِ پولُسؔ واپس۔  
\v 34 مگر کینٛہہ نفر دراے پولُسسؔ سٟتؠ تہٕ کرٕکھ یسوعؔ سنٛدِس پٲغامس پیٚٹھ پژھ۔   یسوعسؔ پیٚٹھ ایمان انن والیٚن منٛز اوس دیونُسیسؔ ناوُک اکھ شخص تہِ یُس مجلسہِ مشاورتُک رکُن تہِ اوس۔   امہِ علاوٕ ٲس دمرِسؔ ناوٕچ اکھ خوتون تہٕ تمِس سٟتؠ ٲسؠ بیٚیہِ تہِ کینٛہہ نفر یمو ایمان اوٚن۔
\c 18
\p
\v 1 امہِ پتہٕ دراو پولُسؔ ایتھنیؔ شہرٕ منٛزم تہٕ گو کورنتھسؔ شہرس منٛز۔  
\v 2 تتہِ گو تمسُنٛد ملاقات اکِس یہُودِس سٟتؠ یمِس اکولؔہ ناو اوس،  یہ اوس پُنطسنؔ علاقُک۔   اکولؔہ تہٕ تمؠ سنٛز خاندارنؠ پرسکہِ ٲسؠ کینٛہہ کال برُونٛہہ اٹلیؔ کہ شہرٕ رومہؔ پیٚٹھٕ آمٕتؠ۔   تِمو اوس رومؔ ترومُت تکیازِ رومی شہزادٕ کلودیُسنؔ اوس حکم کۅڈمُت زِ تمام یہُودؠ گژھن رومہؔ منٛزٕ نیرٕنؠ۔   پولُسؔ گو پرسکلؔہ تہٕ اکولؔہ ہس سمکھٕنہ۔  
\v 3 اکولؔہ تہٕ پرسکلؔہ ٲسؠ پونٛسہٕ زیننہٕ باپتھ خٟمہ بناوان۔   پولُسؔ تہِ لٲگؠ خٟمہ بناونؠ،  تمہِ کِنؠ رود سُہ تِمنےٕ سٟتؠ،  تہٕ تِمو کٔر یکوٹہٕ کٲم۔  
\p
\v 4 پرٛتھ سبت کہ دوٚہہ اوس پولُسؔ یہُودینؔ ہنٛدس عبادت گاہس منٛز گژھان یتہِ سُہ یہُودینؔ تہٕ غٲر یہُودینؔ دوٚنونؠ سٟتؠ کتھ اوس کران۔   تمؠ سمجھٲوؠ تِم یسوعسؔ متعلق۔  
\p
\v 5 ییٚلہ سیلاسؔ تہٕ تیمُتھیسؔ مکدُنیہ علاقہٕ پیٚٹھٕ آے تہٕ پولُسؔ اوس روحٲنی جوشہٕ سٟتؠ بٔرِتھ یہُودینؔ متٲثر کران زِ یسوعؔ ہےٕ چُھ مسیحؔ۔  
\v 6 مگر یہُودؠ گےَ پولُسسؔ خلاف تہٕ لگؠ تمِس متعلق بُرٕ بلہٕ وننہِ۔   چناچہ تمؠ دٕنؠ پنٕنؠ پلو، کٔرِن صاف تہٕ ووٚنُن تِمن،  "اگر خدا توٚہہ سزا دییہِ تہٕ یہ چھےٚ تُہنٛز ذمہ دٲری،  میانؠ نہٕ! وۅنؠ کرٕ بہٕ صرف تِمن لوٗکن سٟتؠ کتھ یمہ نہٕ یہُودؠ چھِ!
\p
\v 7 یتھٕ کنؠ دراو پولُسؔ یہُودؠ جلسہٕ گاہ منٛزٕ تہٕ ژاو اکِس گرس منٛز یُس نزدیکےٕ اوس،  تہٕ لوگُن تتہِ وعظ برُن۔   امہِ گھرُک مالک طِطُس یوستُسؔ اوس اکھ غٲر یہُودؠ شخص یُس خدایہ سنٛز عبادت کران اوس۔  
\v 8 امہِ پتہٕ اوٚن یہُودینؔ ہنٛدِ جلسہٕ گاہٕکؠ حٲکم یمِس کرسپسؔ ناو اوس تہٕ تمسنٛدیٚو ساروےٕ گھرِ کیٚو اوٚن خداوندس پیٚٹھ ایمان۔   کورنتھسؔ منٛز بوز باقی واریہو لوٗکو کرسپسؔ تہٕ تمسنٛدِس خاندانس متعلق،  تِمو تہِ اوٚن یسوعسؔ پیٚٹھ ایمان تہٕ آکھ بپتسمہ دنہٕ۔  
\p
\v 9 اکہ رٲژ وُچھ پولُسنؔ اکھ خواب یتھ منٛز خداوند یسوعنؔ تمِس ووٚن،  "یِمن لوٗکن مہ کھۅژ یمہ ژےٚ خلاف چھی،  ژٕ روز مےٚ متعلق کتھٕ کران، 
\v 10 تکیازِ بہٕ کرے ژےٚ ضرور مدد تہٕ ژےٚ کٔری نہٕ یتہِ بیٚیہِ کانٛہہ پریشان۔   ژٕ روز مےٚ متعلق یِمن ونان،  تکیازِ یتھ شہرس منٛز چھِ واریاہ لوٗکھ یمہ مےٚ سٟتؠ چھِ۔  
\v 11 چناچہ پولُسؔ رود ڈۅڈس ورؠ یس کرنِتھسؔ منٛز لوٗکن یسوعسؔ متعلق خدایہ سُنٛد پٲغام فکرِ تاران۔  
\p
\v 12 ییٚلہ گلیوؔ اخیہ صوبُک رومی گورنر بنیاو تہٕ یہُودؠ رہنما سپٕدؠ جمع تہٕ کوٚرکھ پولُسؔ بنٛد۔   تِمو نیٚو سُہ گورنرس برُونٛہہ کُن تہٕ دِیُتہس الزام، 
\v 13 تہٕ ونُکھ،  "یہ نفر چُھ لوٗکن تمہ طریقہٕ خدایہ سنٛز عبادت کرٕنؠ ہیٚچھٕ ناوان یہ سانین یہُودؠ قانونن خلاف چُھ"
\p
\v 14 یُتھےٕ پولُسنؔ کتھ کرٕنؠ ہیٚژ تہٕ گلیوؔ ہن ووٚن یہُودینؔ،  "اگر یمؠ نفرن سٲنؠ رومی قانون پُھٹرٲوؠ،  بہٕ چُھس بوزُن یژھان زِ توٚہؠ یہُودؠ کیاہ چُھو مےٚ ونُن یژھان۔  
\v 15 یودوے توٚہؠ لفظ،  ناو تہٕ پننٮ۪ن یہُودؠ قانونن متعلق کتھ کران چُھو،  تہٕ توٚہہِ پزِہو پانے أمِس سٟتؠ یمن متعلق کتھ کرٕنؠ۔   بہٕ کرنہٕ یِمن چیزن ہنٛدؠ فٲصلہٕ!"
\p
\v 16 یہ کتھ مۅکلاوِتھ ووٚن گلیوؔ ہن کیںژن سپہَن زِ یہُودؠ سردار کٔڈؠ ووکھ عدالتہٕ  منٛزٕ نیٚبر۔  
\v 17 پتہٕ رۅٹ لوٗکو یہُودینؔ ہُنٛد زیُٹھ سوستھِنیسؔ۔   تِمو دیُت تس تٔتی عدالتس منٛزےٕ مار۔   مگر گلیوؔ ہن کٔرنہٕ اتھ متعلق کانٛہہ کتھ۔  
\p
\v 18 پولُسؔ رود ایمان والیٚن سٟتؠ کرنِتھسؔ منٛز بیٚیہِ تہ واریہن دوٚہُن۔   پتہٕ سپُد سُہ پرسکہِ تہٕ اکولؔہ ہس سٟتؠ جہازس منٛز سوار تہٕ گو صوریہؔ صوبس کُن روانہٕ۔   تٔمؠ ٲس منت منٛجمٕژ یمہِ کِنؠ تٔمؠ کنخریہؔ ہس منٛز مَس کاسنوو۔  
\v 19 تِم وٲتؠ افسس شہرس منٛز،  پرسکلؔہ تہٕ اکولؔہ رودؠ تٔتؠ۔  
\p پولُسؔ ژاو پانہٕ یہُودؠ عبادت خانس منٛز تہٕ ونُن یہُودینؔ یسوعسؔ متعلق۔  
\p
\v 20 تِمو ووٚن تس مذید ٹھہرنہٕ باپتھ،  مگر سُہ سپُد نہٕ روزنس پیٚٹھ آمادٕ۔  
\v 21 مگر نیران نیران ووٚن تٔمؠ تِمن زِ اگر خداین یوٚژھ تہٕ بہٕ یمہٕ بیٚیہِ واپس۔   پتہٕ سپُد سُہ جہازس منٛز سوار تہٕ دراو افسس منٛزٕ۔  
\p
\v 22 ییٚلہ جہازٕ قیصریہ شہرس منٛز ووت تہٕ پولُسؔ ووٚتھ بوٚن۔   سُہ گو یروشلم تہٕ کرٕن تتہِ کٮ۪ن ایمان والیٚن سلام۔   پتہٕ گو سُہ شام علاقہ کِس انطاکیہؔ شہرس منٛز۔  
\p
\v 23 پولُسنؔ گذُور تتہِ پژھ،  والیٚن سٟتؠ کینٛہہ وق۔   پتہٕ دراو سُہ انطاکیہ منٛزٕ تہٕ گو گلتیہ تہٕ فرُوگیہؔ علاقہٕ کیٚن بیٚون بیٚون شہرن منٛز۔   تِمو کوٚر ایمان والیٚن بانٛد بانٛد زِ تِم بڑٲوِن یسوعسؔ متعلق خدایہ سنٛدِس پٲغامس پیٚٹھ زیادٕ کھۅتہٕ زیادٕ پژھ۔  
\p
\v 24 ییٚلہ پولُسؔ گلتیہؔ تہٕ فرُوگیہؔ کِنؠ پکان اوس تہٕ اپولُس ناوُک اکھ یہُودؠ نفر ووت افسس منٛز۔   سُہ اوس سکندریہ شہرُک یُس صحیفن متعلق بہترین کتھٕ ونان اوس۔  
\v 25 باقی ایمان والیٚو ہیٚچھنوو اپولُس زِ خداوند یسوع کِتھ پٲٹھؠ چُھ یژھان لوٗکھ گژھن زندگی گزارٕنؠ،  تہٕ تٔمؠ ہیٚچھنٲوؠ جوشہٕ خروشہٕ سان تِم چیز لوٗکھ۔   حالانکہ سُہ اوس نہٕ یسوعسؔ متعلق سورےٕ کینٛہہ ہیٚچھٕ ناوان،  تکیازِ سُہ اوس صرف بپتسمہ دنہٕ وٲلِس یوحناؔ سنٛدِس بپتسمہ ہس متعلق زانان۔  
\v 26 اپولُسؔ گو یہُودینؔ ہنٛدِس جلسہٕ گاہس منٛز تہٕ تتہِ ونن لوٗکن تِمہ کتھٕ یمہ تٔمؠ ہیٚچھمژٕ آسہٕ۔   ییٚلہ پرسکہِ تہٕ اکولؔہ ہن بوزٕ زِ سُہ کیاہ چُھ ہیٚچھٕ ناوان،  تہٕ تِمو دِژ تس پنُن گھرٕ ینٕچ دعوت یتہِ سُہ خداین یسوعسؔ متعلق بیٚیہِ تہِ ہیٚچھنوو۔  
\p
\v 27 ییٚلہ اپولُسنؔ فٲصلہ نیٚو زِ سُہ چُھ اخیہ علاقس منٛز گژھُن یژھان تہٕ افسسؔ کیٚو ایمان والیٚو ووٚن تس زِ یہ کرُن روزِ تُہنٛدِ خٲطرٕ بہتر۔   لہٰذا لیٚوکھ تِمو اخیہ ہس منٛز ایمان والیٚو نامہٕ زِ تِم کرن اپولُسسؔ استقبال۔   توٚت واتنہٕ پتہٕ،  کوٚر تٔمؠ تِمن لوٗکن مدد یمہ خداین یسوعسؔ پیٚٹھ ایمان اننس قٲبل بنٲوؠ۔  
\v 28 اپولُس اوس یہُودی سردارن سٟتؠ بڈِ بڈِ کتھٕ کران تہٕ واریاہ باقی لوٗکھ تہِ ٲسؠ بوزان۔   کتابِ مقدس پٔرِتھ اوس سُہ تِمن یہ باور کران زِ یسوعؔ ہےٕ اوس مسیحؔ۔
\c 19
\p
\v 1 ییٚلہ اپولُس کورنتھسؔ منٛز اوس،  پولُسؔ دراو فرُوگیہؔ تہٕ گلتیہؔ ترٲوِتھ آسیہؔ کِنؠ افسسؔ کُن واپس۔   تمِس گو کینٛژن نفرن سٟتؠ ملاقات یمو تس ووٚن زِ اسہِ چُھ ایمان اوٚنمُت۔  
\v 2 تٔمؠ پرُوژھ تِمن،  "ییٚلہ توٚہہ خدایہ سنٛدِس پٲغامس پیٚٹھ ایمان اوٚنُو توٚہہ میولا پاک روح؟ تِمو ووٚنُس تورٕ "نہ اسہِ میول نہٕ۔   اسہِ بوز نہٕ یتہِ زِ پاک روح چُھ نٲزل سپدان۔  
\p
\v 3 تہٕ پولُسنؔ پرژھُکھ،  "ییٚلہ توٚہہ بپتسمہ روٚٹُو تہٕ توٚہہ کیاہ اوس پےَ؟" تِمو ووٚنُس جواب،  "اسہِ کوٚر بپتسمہ دنہٕ وٲلِس یوحناؔ سنٛزِ تعلیمہِ پیٚٹھ یقین"
\v 4 پولُسنؔ ووٚن،  "یوحناؔ سُنٛد بپتسمہ چُھ یمہ کتھِ ہنٛز نشٲنی زِ لوٗکھ ٲسؠ خدایس کُن رجوع کران تہٕ پننیٚو بُرٕ خیالو تہٕ کامیٚو نِشہٕ دور ہیٚوان۔   تٔمؠ ووٚن تِمن یتہِ زِ توٚہؠ أنیٚو بیٚیہِ کانٛسہِ پیٚٹھ ایمان،  یُس تمِس پتہٕ ینہٕ وول چُھ،  تہٕ سُہ شخص چُھ یسوع۔  
\p
\v 5 ییٚلہ تِمو لوٗکو یہ بوز تہٕ تِمو نیٚو خداوند یسوعؔ سنٛدِ ناو بپتسمہ۔  
\v 6 امہِ پتہٕ تھوو پولُسنؔ اکہ اکہ تِمن سارنی کلس پیٚٹھ اتھٕ تہٕ تِمو منٛزٕ سپُد پرٛتھ اکِس پیٚٹھ پاک روح سُنٛد طاقت نٲزِل۔   پاک روحن کوٚر یمن تِمو،  من زبانن منٛز بولنُک طاقت عطا یمہ نہٕ تِمو ہیٚچھمژٕ آسہ،  تہٕ تِمو لٲگؠ تِم پٲغامات تہِ بوزٕ ناونؠ یمہ پاک روحن تِمن ونمٕتؠ ٲسؠ۔  
\v 7 تقریباً ٲسؠ باہ نفر یِمن پولُسنؔ بپتسمہ دیُت تہٕ یِمن پیٚٹھ پاک روح نٲزِل سپُد۔  
\p
\v 8 امہ پتہٕ تریٚن ریتن تام رود پولُسؔ پرٛتھ سبت کہ دوٚہہ افسسؔ منٛز یہُودین ہنٛدِس جلسہٕ گاہس منٛز گژھان تہٕ لوٗکن یسوعسؔ متعلق ہیٚچھٕ ناوان تہٕ تِمن آمادٕ کران زِ خدا کتھٕ کٔنؠ کرِ پنُن پان بادشاہ سنٛدؠ رنٛگؠ ظٲہِر۔  
\v 9 مگر کینٛژو یہُودیٚو کوٚر نہٕ امسنٛدِس پٲغامس پیٚٹھ یقین تہٕ تِم ٲسؠ نہٕ تمسُنٛد مذید کینٛہہ بوزُن یژھان۔   تِمو کرِ پولُسؔ سنٛزِ تعلیمہ متعلق واریاہ بُرٕ کتھٕ۔   مگر پولُسنؔ ترٲوؠ تِم أتی تہٕ گو ایمان والین ہنٛز جماتھ ہیٚتھ تُرنسؔ کِس جلسہٕ گاہس منٛز تِمن سمکھنہِ۔  
\v 10 تتہِ دِژ دوٚن ورؠ ین پولُسنؔ لوٗکن تعلیم۔   یتھٕ پٲٹھؠ بوز آسیہ کیٚن علاقن منٛز روزن والیٚو یہُودیٚو تہٕ غٲر یہُودیٚو خداوند یسوعسؔ متعلق پٲغام۔  
\p
\v 11 خداین دیُت پولُسسؔ معجزٕ کرنُک طاقت تہِ۔  
\v 12 اگر بٮ۪مار لوٗکھ پولُسسؔ نِش یتھ ہیٚکہ ہَن نہٕ تہٕ سُہ پلو یتھ پولُسنؔ اتھٕ لوگمُت آسہ ہےتہٕ سُہ بٮ۪مارس پیٚٹھ تراوٕہن۔   نتیجہ نیرِہے یہ زِ بٮ۪مار انسان سپدِہے ٹھیک،  تہٕ بدروح تراوٕہن تِمن یلہٕ۔  
\p
\v 13 تتہِ ٲسؠ کینٛہہ یہُودؠ تہِ یمہٕ شہرٕ پتہٕ شہرٕ پھیران ٲسؠ تہٕ تِمو دیُت تِمن جاین بدروحن حکم زِ تِم روزن لوٗکو نِش دوٗر۔   یمو یہُودیٚو منٛزٕ دیُت کینٛژو بد روحن یہ ونِتھ نیرنُک حکم زِ "بہٕ چُھسو توٚہہ خداوند یسوع سنٛدِ طاقتہٕ نیرنُک حکم دِوان،  یمِس متعلق پولُسؔ تعلیم دِوان چُھ"
\v 14 تتہِ ٲسؠ ستھ نفر یمہ یہ کران ٲسؠ۔   تِم ٲسؠ سکواؔ ناوٕ کِس اکِس یہُودؠ سنٛدؠ اولاد،  یُس پننِس پانس سردار کاہن ونان اوس۔  
\p
\v 15 مگر اکہ دوٚہہ ییٚلہ تِم یہ کران ٲسؠ تہٕ تمِس نفرس نِش دراو نہٕ بدروح۔   امہِ بجایہ ووٚن بدروحن تِمن،  "بہٕ چُھسن یسوعؔ زانان،  بہٕ چُھسن پولُسؔ تہِ زانان،  مگر توٚہہ دیُت نہٕ کانٛسہ مےٚ سٟتؠ کینٛہہ کرنُک اختیار"
\v 16 یہ وننہٕ پتہٕ گو اچانک سُہ نفر سکواؔ سنٛدین نیٚچوٮ۪ن اگادِ یس منٛز بدروح اوس۔   تٔمؠ دِتؠ تِم سٲری پتھر دٲرِتھ تہٕ دتِن سارنی چوٹ۔   تٔمؠ ژٔٹؠ تِمن پلو تہٕ کٔرِن زخمی۔   تِمن ژاو ہٲبتھ تہٕ ژٔلؠ اتہِ نیٚبر۔  
\v 17 یہ بوز افسس منٛز روزن والیٚو ساروےٕ یہُودیٚو تہٕ غٲر یہُودیٚو زِ کیاہ سپُد۔   تِم کھوژؠ تکیازِ تِمو وُچھ زِ بد روح وول نفر اوس سیٚٹھاہ طاقتور۔   تہٕ سٟتی کوٚر تِمو خداوند یسوع سنٛدِس ناوس تعظیم تہِ۔  
\p
\v 18 تمہِ وزِ ییٚلہ باقی ایمان وٲلؠ بوزان ٲسؠ ووٚن واریہو ایمان والیٚو تِمن بُرٕ کامٮ۪ن متعلق یمہٕ تِم کران ٲسؠ۔  
\v 19 یمہ لوٗکھ جٲدؠ گر ٲسؠ تِمو منٛزٕ نی کینٛژو پنٕنؠ طُمار یِمن منٛز جٲدؠ کرنٕکؠ طریقہٕ وننہٕ ٲسؠ آمٕتؠ تہٕ زٲلِکھ تتھ جایہ یتِتھ پرٛتھ کانٛہہ تِمن وُچِھتھ ہیٚکہِ ہے۔   ییٚلہ لوٗکو یِمن طُمارن ہُنٛدِ قٟمتُک اندازٕ کوٚر،  تہٕ یہ ووت پنٛژہَن ساسن چانٛد،  ہنٛدین سِکن برابر۔  
\p
\v 20 امہِ طاقتہٕ سان  بوز واریہو لوٗکو خداوند یسوعؔ سُنٛد پٲغام تہٕ اونُکھ تتھ پیٚٹھ ایمان۔  
\p
\v 21 افسس منٛز پنٕنؠ کٲم انٛد واتنٲوِتھ کوٚر پولُسؔ پاک روحن یروشلم گژھنُک فٲصلہٕ کرنس پیٚٹھ آمادٕ،  مگر تٔمؠ بنوو گۅڈٕ مکدُنیہؔ تہٕ اخیہ کیٚن علاقن منٛز روزن والیٚن ایمان والیٚن سمکھنُک منصوبہ۔   پولُسنؔ ووٚن،  "یروشلم گژھنہٕ پتہٕ گژھٕ بہٕ رومؔ تہِ"
\v 22 تٔمؠ سوزؠ پنٕنؠ زٕ مددگار تیمُتھیس تہٕ اراستُسؔ مکدُنیہؔ۔   مگر پولُسؔ رود آسیہؔ صوبہٕ کِس افسسؔ شہرس منٛز۔  
\p
\v 23 امہِ پتَے ہیٚتؠ افسس منٛز لوٗکو یسوع تہٕ تمؠ سنٛزِ تعلیمہ ہنٛدِ سببہٕ بٔڈؠ ہنگامہٕ شُروع کرٕنؠ۔  
\v 24 تتہِ اوس اکھ نفر یمِس دیمیترِیُسؔ ناو اوس۔   تمؠ بناوِ اَرتمِسؔ دیوی ہنٛزٕ چانٛدِ ہنٛز مورژٕ یمِس ڈیانا تہِ ونان ٲسؠ۔   دیمیترِیُسنؔ زیننٲوؠ تِم نفر واریاہ پونٛسہٕ یمو یمہٕ مورژٕ بناوِ تہٕ پتہٕ کٕنیٚکھ۔  
\p
\v 25 دیمیترِیُسنؔ کٔرؠ تِم سٲری کٲرؠ گر جمع یمہ مورژٕ بناوان ٲسؠ۔   تٔمؠ ووٚن تِمن،  "مورژٕ گریٚو،  توٚہؠ چُھو زانان زِ أسؠ چھِ پنٕنؠ کٲم کرِتھ واریاہ پونٛسہٕ زینان۔  
\p
\v 26 توٚہؠ چُھو زانان زِ پولُسنؔ ہیٚچھنٲوؠ افسسؔ منٛز واریاہ لوٗکھ زِ تِم مہٕ ہیٚن تِمہٕ مورژٕ موٚلؠ یمہ أسؠ بناوان چھِ۔   ووٚنؠ چھنہٕ سانہِ صوبٕکؠ تہِ واریاہ دویِم لوٗکھ سٲنؠ بنٲومٕتؠ چیز مٔلؠ ہیٚنؠ یژھان۔   پولُسؔ چُھ لوٗکن ونان زِ یِمن دیوتاہن ہنٛز أسؠ عبادت کران چھِ تِم چھنہٕ دیوتا تہٕ اسہِ پزِنہٕ تِہنٛز عبادت کرٕنؠ۔  
\v 27 اگر لوٗکھ تمؠ سنٛزٕ کتھٕ مانن تہٕ سون کارٕبار سپدِ ختم۔   لوٗکھ سونٛچن نہٕ یہ زِ اَرتمِسؔ یمِس ڈیانا تہِ ونان چھِ سنٛز عبادت کرنہٕ باپتھ کیاہ پزِ مندرس منٛز بیٚیہِ اژُن۔   لوٗکھ سونٛچن نہٕ ووٚنؠ یہ زِ اَرتمِسؔ چُھ عظیم۔   امہِ باوجود زِ آسیہؔ ۂکؠ تمام صوبہٕ اگر ونو تہٕ پوٗرٕ دنیا چُھ أمسنٛز عبادت کران۔  
\p
\v 28 تتہِ موجود تمام لوٗکن کھۅت پولُسسؔ پیٚٹھ شرارتھ ییٚلہ تِمو دمیتریس سنٛز کتھ بوز۔   تِمو تُل شور،  "اِفسین ہنٛز دیوی اَرتمِسؔ چھےٚ عظیم!"
\v 29 شہرٕکؠ واریاہ لوٗکھ گےَ پولُسسؔ ناراض تہٕ لگؠ نالہٕ دِنہ۔   کینٛژو لوٗکو رۅٹ گیُسؔ تہٕ ارسترسخُسؔ مکدُنیہ،  زٕ نفر ٲسؠ مکدُنیہ ہٕکؠ یمہ پولُسسؔ سٟتؠ سفر کران ٲسؠ۔   پتہٕ آو لوٗکن ہُنٛد بوٚڈ ہجوم دوران دوران تِمن نفرن نِش تہٕ نیٖکھ کھکھرِ شہرکِس تماشہٕ گاہس  نِش۔  
\p
\v 30 پولُسؔ اوس لوٗکن سٟتؠ کتھ کرنہ باپتھ تماشہٕ گاہس نِش گژھُن یژھان مگر باقی ایمان والیٚو دیُت نہٕ تس تور کُن گژھنہٕ۔  
\v 31 شہرٕ کیٚو کینٛژو حٲکمو یمہٕ پولُسؔ سنٛدؠ دوس ٲسؠ بوز زِ سپدان کیاہ چُھ۔   تِمو سوز پولُسسؔ یہ وننہٕ باپتھ کُستام نفر زِ تماشہٕ گاہس نِش گٔژھؠ زینہٕ۔  
\p
\v 32 تماشہٕ گاہس نِش اوس لوٗکن ہُنٛد شور جٲری۔   اکھ اوس اکھ کتھ ونان تہٕ کینٛہہ ٲسؠ بیاکھےٕ کتھ کران۔   مگر یمو منٛزٕ اوس نہٕ اکثرن معلومےٕ زِ کتھ پیٚٹھ چھِ جمع گمٕتؠ!
\p
\v 33 تتہِ اوس سکندرؔ ناوُک اکھ یہُودؠ۔   کینٛژو یہُودیٚو دیُت تس ہجومس برُونٛہہ کُن دکہٕ تاکہ سُہ کر،  ہے لوٗکن سٟتؠ کتھ۔   سکنٛدرن تُلؠ پنٕنؠ اتھٕ تھوٚد تہٕ کرٕن کوشش لوٗکن ہُنٛد شور بنٛد کرناونٕچ۔   سُہ اوس تِمن ونُن یژھان زِ یہُودیٚو تُل نہٕ یہ فساد۔  
\v 34 مگر واریاہ غٲر یہُودؠ ٲسؠ زانان زِ سکندر چُھ اکھ یہُودؠ تہٕ یتہِ ٲسؠ زانان زِ یہُودؠ چھنہٕ اَرتمِسؔ دیوی ہنٛز عبادت کران۔   لہٰذا رودؠ غٲر یہُودؠ دوٚن گٲنٛٹن شورٕشر جٲری تھٲوِتھ،  "اِفسین ہنٛز دیوی اَرتمِسؔ چھےٚ عظیم!"
\p
\v 35 پتہٕ کرنوو شہرٕ کیٚو حٲکمو منٛزٕ أکؠ یہ ہجوم شور کرُن بنٛد۔   تٔمؠ ووٚن تِمن،  "میانیٚو وطن دارو،  دنیاہس منٛز چُھ پرٛتھ اکھ زانان زِ سانہ دیوی اَرتمِسؔ ہنٛز مقدس تصویر چھےٚ آسمانہٕ پیٚٹھٕ وژھمٕژ۔  
\v 36 یِم سٲری چھِ زانان تہٕ کانٛہہ تہِ ہیٚکہ نہٕ ونِتھ زِ یِم کتھٕ چھنہٕ صحی۔   لہٰذا پزِ توٚہہ خاموشی کرٕنؠ کانٛہہ تہِ بےوقوفی مہٕ کٔریٚو۔  
\v 37 توٚہہِ پزٕ ہنو نہٕ یِم زٕ نفر یتُتھ انٕنؠ تکیازِ یمو چُھنہٕ کانٛہہ خطا کوٚرمُت۔   یم گےَ نہٕ سانٮ۪ن عبادت گاہن منٛز تہٕ تتہِ نیٖکھ چیز ژورِ،  تہٕ یمو ووٚن نہٕ سانہٕ دیوی بُرٕ بلہٕ۔  
\v 38 لہٰذا اگر دیمیترِیُسؔ تہٕ تمسُنٛد کانٛہہ سٲتھی کانٛسہِ پیٚٹھ کانٛہہ بُرٕ کٲم کرنُک الزام لاگُن یژھان چھِ تہٕ تِم کرن سُہ صحی طریقہٕ۔   تِژھٕ عدالتہٕ چھےٚ یوٚت تِم گٔژھِتھ ہیٚکن،  تہٕ تِتھؠ منصف تہِ چھِ یمہٕ حکومتن ژٲرمٕتؠ چھِ۔   توٚہؠ ہیٚکو تتہِ کانٛسہِ پیٚٹھ الزام دٲیر کرِتھ۔  
\p
\v 39 ووٚنؠ گو اگر توٚہؠ بیٚیہِ کُنہِ چیزس متعلق ونُن یژھان چُھو تہٕ توٚہہ پزیٚو پننٮ۪ن حکمرانن ونُن زِ تِمن پزِ امہ چیزُک خیال تھاون۔   ییٚلہ تِم حکمران یکہ وٹہٕ سمن۔  
\v 40 یہ سمُن چُھنہٕ جان! امہِ مصیبتُک تھایو ٹھیک پٲٹھؠ خیال تکیازِ أسؠ چھنہٕ حکومتس خلاف گژھُن یژھان۔   اگر حاکِم مےٚ پرِژھن زِ توٚہہ ساروےٕ کتھ پیٚٹھ چُھو شور تُلمُت،  بہٕ ہیٚکہٕ نہٕ تِمن صحی جواب دِتھ۔  
\v 41 شہرٕکؠ حٲکمن ووٚن اتھ ہجومس یی۔   پتہٕ ووٚن تٔمؠ سارنی گھرٕ گژھنہٕ باپتھ،  تہٕ تِم ساری گےَ پننٮ۪ن گھرن کُن روانہٕ۔
\c 20
\p
\v 1 ییٚلہ لوٗکو افسس منٛز بوال کرٕنؠ بنٛد کٔرؠ تہٕ پولُسنؔ أنؠ پنٕنؠ ایمان وٲلؠ سومبرٲوِتھ۔   تٔمؠ کٔر تِمن نصیحت زِ تِم تھاون خداوند یسوعسؔ پیٚٹھ پوٗرٕ پژھ۔   تہٕ امہِ پتے کوٚر تمؠ تِمن الوِداع،  تہٕ لوٚگ مکدُنیہ علاقس کُن گژھنہٕ باپتھ نیرنہ۔  
\v 2 توٚت واتنہٕ پتہٕ کوٚرُن تِمن تٲکید زِ تِم تھاون خداوند یسوعسؔ پیٚٹھ بھروسہٕ تہٕ دِن ایمان والیٚن حوصلہٕ۔   تہٕ پتہٕ گو یونانؔ روانہٕ۔  
\v 3 یونانس منٛز رود سُہ تریٚن ریٚتن۔   پتہٕ کوٚر تٔمؠ سمندری جہازس منٛز واپس صوریہ گژھنُک اِرادٕ،  مگر تٔمؠ بوز زِ تتہِ چھِ کینٛہہ یہُودؠ تمِس سفرس دوران قتٕل کرنُک منصوبہ بناوان۔   لہٰذا کوٚر تٔمؠ پتھٕرؠ وتہِ گژھنُک فٲصلہٕ،  تہٕ سُہ دراو دوبارٕ مکدُنیہ کنی۔  
\p
\v 4 یِم نفر تمِس سٟتؠ یروشلم گژھن وٲلؠ ٲسؠ،  تِمن منٛز اوس بیریہؔ شہر کِس پیرہسؔ سُنٛد نیٚچو سوپترُسؔ۔   تھِسلُنِیکے شہرٕکؠ ارسترسخُسؔ تہٕ سِکندُسؔ۔   دربےؔ شہرُک گیُسؔ تہٕ گلتیہؔ علاقہٕ پیٚٹھٕ تیمُتھیس۔   تہٕ تُخِکسؔ تہٕ تُرفمس یمہ آسیہؔ صوبٕکؠ ٲسؠ۔  
\v 5 تمہٕ ستتھ نفر یمہٕ پولُسؔ تہٕ مےٚ لوقاہس برونہٛہ برونہٛہ سمندری جہازس منٛز مکدُنیہ کِنؠ گےَ وٲتؠ اسہِ برُونٛہہ ترواسؔ شہر تہٕ تتہِ پراریاے اسہِ دوٚن۔  
\v 6 مگر بہٕ تہٕ پولُسؔ وٲتؠ زمینی سفر کٔرِتھ فلپی شہر۔   یہُودینؔ ہنٛدِ ژۅچہ تہوارٕ پتہٕ یۅسہ خمیرِ بغٲرے بنان چھےٚ،  سپدؠ أسؠ اکِس جہازس پیٚٹھ سوار یُس ترواسؔ شہر گژھان اوس۔   پانٛژھ،  دوٚہؠ پتہٕ وٲتؠ أسؠ تروآسؔ تہٕ سمکھیاے باقی نفرن یمہ اسہِ برُونٛہہ سفرس درامٕتؠ ٲسؠ۔   پتہٕ بیٹھؠ أسؠ سٲری ستن دوٚہُن تروآسسؔ منٛز۔  
\p
\v 7 ہفتٕکہِ گۅڈنِکہ دوٚہہ ٲسؠ أسؠ یِکوٹہٕ سمکھان تہٕ بیٚین ایماندارن سٟتؠ کھیٚن بٲگرِتھ یِکوٹہٕ کھیٚوان۔   پولُسؔ اوس نیصف رٲژ تام ایمان والیٚن سٟتؠ کتھٕ کران۔   تس اوس بیٚکہ دوٚہہ تروآسؔ تراونُک اِرادٕ،  اوٕ کِنؠ تھٲو تٔمؠ کتھ جٲری۔  
\v 8 پیٚٹھٕ کنہِ کِس کمرس منٛز یتہِ أسؠ جمع گمٕتؠ ٲسؠ ٲسؠ واریاہ تلہٕ ژٲنگؠ دزان۔  
\p
\v 9 تتہِ اوس کمرس منٛز یوتخُسؔ ناوُک اکھ نوجوان۔   سُہ اوس گھرِ یلہٕ دارِ پیٚٹھ بہِتھ۔   ییٚلہ پولُسؔ واریہس وقتس کتھ کران رود،  یوتخُسؔ کٔھژ وار وارٕ نینٛدر۔   ٲخر تہٕ پییہِ تس گوٚب نینٛدر۔   سُہ آو دارِ پیٚٹھٕ وسِتھ تہٕ پیٚو بوٚن۔   کینٛہہ ایمانہٕ وٲلؠ ؤتھؠ جلدےٕ بوٚن تہٕ تُلکھ سُہ تھوٚد۔   مگر سُہ اوس گُذریومُت۔  
\v 10 پولُسؔ تہِ وُتھ بوٚن۔   سُہ شونٛگ أمِس نوجوانس پیٚٹھ پان دراز ترٲوِتھ تہٕ وجنَس پننہِ نرِ۔   پتہٕ ووٚن تٔمؠ تِمن لوٗکن یمہٕ تس انٛدؠ پٔکؠ جمع ٲسؠ،  "فِکر مہٕ بٔریٚو۔   یہ گوو بیٚیہِ زندٕ!"
\p
\v 11 پولُسؔ کھوٚت بیٚیہِ ہیٚور کھیٚن بنووُن تہٕ کھیوٗن۔   امہِ پتہٕ کوٚر تمؠ ایمان والیٚن سٟتؠ بیٚیہِ گفتگو یۅتام زن آفتاب کھۅت۔   پتہٕ دراو سُہ۔  
\v 12 باقیو لوٗکو نیٚو نوجوان لڑکہٕ گھرٕ تہٕ تِمن میول سیٚٹھا حوصلہٕ تکیازِ سُہ گو مرِتھ زنٛدٕ۔  
\p
\v 13 پتہٕ کٔھتؠ أسؠ جہازس۔   مگر پولُسؔ کھۅت نہٕ اسہِ سٟتؠ تروآسسؔ منٛز جہازس تکیازِ سُہ اوس خوشک وتہِ اَسوسؔ قصبس منٛز جلدےٕ واتُن یژھان۔   اسہِ منٛزٕ کٔھتؠ باقی لوٗکھ جہازس تہٕ گے۔   اَسوسؔ کُن روانہٕ۔  
\v 14 پولُسسؔ سمکھیاے أسؠ اَسوسسؔ منٛز۔   سُہ کھۅت اسہِ سٟتؠ جہازس تہٕ أسؠ سپدؠ میتلینؔ شہرس کُن روانہٕ۔  
\p
\v 15 یمہِ دوٚہہ أسؠ میتلینؔ وٲتؠ،  أسؠ گےَ تتہِ پیٚٹھٕ جہازس منٛز سوار سپدِتھ خِیُس جزیرس نکھٕ اکِس جایہ۔   امہِ پتہٕ دویمہِ دوٚہہ گےَ أسؠ ساموسؔ کِس جزیرس پیٚٹھ۔   بیٚیہِ دوٚہہ گےَ أسؠ ساموسؔ پیٚٹھٕ نیرتھ میلیتسؔ شہرس کُن روانہٕ۔  
\v 16 میلیتسؔ شہر اوس افسس شہرس بلکل جنوب پاسہٕ۔   پولُسؔ اوس نہٕ افسسؔ منٛز ٹھہرُن یژھان تکیازِ سُہ اوس نہٕ آسیہؔ ہس منٛز وقت گُذارن یژھان۔   اگر ممکن آسہ ہے سُہ اوس پِنتیکست تہوار کِس موقس پیٚٹھ یروشلم واتُن یژھان،  تہٕ تمہِ تہوارُک وقت اوس نزدیک۔  
\p
\v 17 ییٚلہ جہازٕ میلیتسؔ ووت تہٕ پولُسنؔ سوز افسس منٛز اکھ قٲصد تتہِ کیٚن ایمان والیٚن ہنٛدین بُزرگن یہ وننہٕ باپتھ زِ تِم کرن تمِس سٟتؠ کتھ۔  
\p
\v 18 ییٚلہ بُزرگ تس نِش آے تہٕ پولُسنؔ ووٚن تِمن،  "گۅڈنکہِ دوٚہہ پیٚٹھٕ ییٚلہ بہٕ آسیہؔ صوبس منٛز ووتُس تہٕ تتھ دوٚہس تام ییٚلہ بہٕ تتہِ دراس،  توٚہؠ چُھو زانان زِ مےٚ کیٚوتھ سلوک کوٚر یتہِ روزِتھ توٚہہِ سٟتؠ۔  
\v 19 توٚہؠ چُھو زانان زِ بہٕ کِتھٕ کنؠ رودُس خداوند یسوع سنٛز سیٚٹھاہ عٲجزی سان خدمت کران تہٕ کُنہ ساعتہٕ کتھٕ کنؠ اوسُس بہٕ رِوان۔   توٚہؠ چُھو یتہ،  زانان زِ مےٚ کِتھؠ مصیبت تُلؠ تکیازِ یہُودؠ یمو نہٕ ایمان اوٚنمُت اوس ٲسؠ مےٚ اکثر نۅقصان واتناونٕچ کوشش کران۔  
\v 20 توٚہؠ چُھو یتہ زانان زِ ییٚلہ مےٚ توٚہؠ خدایہ سُنٛد پٲغام بوزنٲیو مےٚ تروو نہٕ زانٛہہ تہِ سُہ کانٛہہ چیز یُس توٚہہ مدد کرِہو۔   توٚہؠ چُھو زانان زِ مےٚ ہیٚچھنٲوؠ مو توٚہؠ خدایہ سُنٛد پٲغام تمہِ ساعتہٕ ییٚلہ واریاہ لوٗکھ جمع ٲسؠ،  تہٕ بہٕ گوس تُہنٛد گھرٕ تہٕ تتہِ تہِ ہیٚچھنٲوؠ مو۔  
\v 21 مےٚ دِژ دوٚنونؠ یہُودینؔ تہِ تہٕ غٲر یہُودینؔ تہِ ژینہٕ ون تہٕ تِمن سارنی ووٚنُم زِ تِم کٔرِن خدایس کُن رجوع تہٕ پننیٚو گُنہو نِش روزِن پتھ تہٕ سٲنِس خداوند یسوعسؔ پیٚٹھ تھٲوِن پژھ۔  
\p
\v 22 "تہٕ ووٚنؠ چُھ مےٚ یروشلم گژُھن،  تکیازِ پاک روحن کوٚر صاف پٲٹھؠ مےٚ اظہار زِ مےٚ پزِ تور گژُھن،  تہٕ مےٚ پزِ تمؠ سنٛز اطاعت کرٕنؠ۔   مےٚ چھنہٕ پےَ زِ تتہِ کیاہ سپدِ مےٚ سٟتؠ۔  
\v 23 مگر بہٕ چُھس یہ زانان زِ پرٛتھ شہرس یُس مےٚ دورِ کوٚر،  پاک روحن ووٚن مےٚ زِ یروشلمس منٛز کرن مےٚ لوٗکھ قٲد تہٕ مےٚ واتناون تکلیف۔  
\v 24 مگر مےٚ چُھنہٕ کانٛہہ پرواے اگر مےٚ لوٗکھ مارن تہِ مگر گۅڈٕ کرٕ بہٕ سۅ کٲم مکمل یۅسہ مےٚ خداوند یسوعنؔ مٹہِ چھےٚ تھٲومٕژ۔   تٔمؠ اوٚنُس بہٕ لوٗکن بہتر پٲغام دِنہٕ باپتھ،  یُس خدا اسہِ تہِ کٔرتھ تہِ زندگی بخشان چھُ تہٕ بچاوان چُھ یمِکؠ نہٕ أسؠ مستحق چھِ۔  
\v 25 مےٚ بوزٕنٲوؠ مو توٚہؠ یہ پٲغام زِ خدا کِتھٕ پٲٹھؠ کرِ پننہِ بادشٲہی ہُنٛد اظہار۔   مگر ووٚن چُھس بہٕ زانان زِ یہ چھےٚ ٲخری وِز ییٚلہ توٚہؠ میانؠ سٲتھی ایمانہٕ وٲلؠ مےٚ وُچھِو۔  
\v 26 لہٰذا چُھس بہٕ یژھان زِ توٚہؠ سٲری زٲنیٚو زِ اگر کانٛہہ یمؠ بہٕ وعظ پران وُچھس تہٕ سُہ یسوعسؔ پیٚٹھ ایمان اننہٕ بغٲر مرِ تہٕ یہ چُھنہٕ میٚون قصور، 
\v 27 تکیازِ مےٚ وُنمو توٚہہ تہِ سورےٕ یہ خداین سانہِ باپتھ یوٚژھمُت چُھ۔  
\p
\v 28 توٚہہ زِٹھٮ۪ن پزِ خدایہ سنٛدِس پٲغامس پیٚٹھ ہیٚتھے یقین تھاوُن تہٕ تمؠ سنٛز فرمانبردٲری کرٕنؠ۔   توٚہہ پزیٚو باقی تمام ایمان والیٚن تہِ مدد کرُن یہنٛز رٲچھ راوٕٹ کرنہٕ باپتھ توٚہہ پاک روحن دیُتمُت چُھ۔   پنٕنؠ تہٕ خداوند سنٛزن ایمان واجنیٚن جمٲژن ہنٛز نگرٲنی کرٕنؠ یتھٕ کنؠ پوٚہل پننٮ۪ن تیٖرن ہنٛدِس کھیٚلِس نگرٲنی کران چُھ۔   خداین چھِ تِم تتھ خوٗنس مٔلؠ ہیٚتؠ مٕتؠ یُس تمسنٛدِس گوبرٕ سنٛدِس جسمس صلیبس پیٚٹھ وسان اوس۔  
\v 29 بہٕ چُھس اصٕل پٲٹھؠ زانان زِ میانہِ نیرنہٕ پتہٕ ین اپُز تعلیم دنہٕ وٲلؠ لوٗکھ توٚہہ نِش تہٕ واتناون ایمان والیٚن واریاہ نۅقصان۔   یمہٕ تیٖرن مارن والیٚن خونخوار رامہٕ ہوٗنٮ۪ن ہنٛدؠ پٲٹھؠ آسن۔  
\v 30 حالانکہ تُہنٛدین قٲیِدن ہنٛزن جمٲژن منٛز تہِ آسن تِتھؠ کینٛہہ یمہ باقی ایمان والیٚن غلط کتھٕ ہیٚچھناوِتھ اپُز ونن۔   تِم ہیٚچھناون تِتھؠ پٲغام یُتھ زن لوٗکھ تِمن پیٚٹھ یقین کرن تہٕ تِہنٛدؠ پٲروکار بنن۔  
\p
\v 31 لہٰذا روزیٚو خبردار زِ توٚہہ منٛزٕ گژھِ نہٕ کانٛہہ تہِ سٲنِس خداوند یسوع سنٛدِس پزِس پٲغامس پیٚٹھ پژھ تھاونہٕ نِشہٕ باز یُن! یاد تھایو تریٚن ورین ہنٛزٕ تِم دوٚہہ تہٕ رٲژ یِمن منٛز مےٚ توٚہؠ سُہ پٲغام ہیٚچھنٲیو تہٕ اوش ہاران ہاران خبردار کٔریٚو زِ خداوند سنٛدؠ وفادار بٔنؠ زیٚو۔  
\v 32 "ووٚنؠ ییٚلہ بہٕ توٚہؠ تراوان چُھسو تہٕ بہٕ چُھس خدایس تُہنٛدِ حفاظتہٕ باپتھ تہٕ توٚہہ اتھ پٲغامس پیٚٹھ یقین دنہٕ باپتھ ونان زِ سُہ چُھ سانہِ باپتھ تہِ کٔرتھ اسہِ بچاوان یمِکؠ نہٕ أسؠ مستحق چھِ۔   اگر توٚہؠ تِمن پٲغامن پیٚٹھ پژھ کران روزیٚو یمہ مےٚ توٚہہِ ونمٕتؠ چھِ،  توٚہؠ بنیٚو مضبوط،  تہٕ خدا دییہِ توٚہہ ہمیشہٕ باپتھ تِم اصٕل چیز یمہٕ تٔمؠ پننٮ۪ن تمام لوٗکن دنُک وعدٕ کوٚرمُت چُھ۔  
\p
\v 33 یۅتام زن میٚون تعلق چُھ،  مےٚ منٛگؠ نہٕ زانٛہہ تہِ کانٛسہِ سۅن، پونٛسہٕ یا اصٕل پلو۔  
\v 34 توٚہؠ چُھو پانہٕ زانان زِ مےٚ زینؠ پننیٚو اتھو کٲم کٔرِتھ تمہ پونٛسہٕ یمن ہنٛز مےٚ تہٕ میانیٚن دوستن ضرورت ٲس۔  
\v 35 مےٚ یہ کینٛژھا تہِ کوٚر تتھ منٛز ہوو مےٚ توٚہہ زِ اسہِ پزِ تِژےٕ محنت کرٕنؠ یُتھ أسؠ ضرورت منٛدن کینٛہہ دِتھ ہیٚکو۔   اسہِ پزِ یاد تھاوُن زِ سٲنؠ خداوند یسوعؔ ہن چُھ ونمُت،  "اکھ شخص چُھ دویمیٚن کینٛہہ دِتھ زیادٕ خۅش سپدان تِمہ کھۅتہٕ ییٚلہ سُہ تورٕ رٹان چُھ"
\v 36 ییٚلہ پولُسنؔ پنٕنؠ کتھ کرِتھ مۅکلاو تہٕ سارنی بزرگن سٟتؠ مونٛگُن دُزانو بِہتھ دُعا۔  
\v 37 تِمو ساروےٕ ووٚد واریاہ تہٕ پولُسؔ نالہٕ متہِ رٔٹِتھ کٔرؠ ہس میٹھؠ۔  
\v 38 تِم ٲسؠ سیٚٹھاہ غمگین تکیازِ تٔمؠ اوس ونمُت زِ تِم وچُھن نہٕ دُبارٕ تمِس زانٛہہ۔   پتہٕ گےَ تِم تس سٲری جہازس نِش سٟتؠ۔
\c 21
\p
\v 1 افسس کٮ۪ن بُزرگن الوِداع کرنہٕ پتہٕ،  کٔھتؠ أسؠ جہازس تہٕ ٲبی سفر کران کران وٲتؠ کوسؔ جزیرس پیٚٹھ،  یتہِ جہازٕ راتس ٹھہریو۔   بیٚکہ دوٚہہ گٔے أسؠ جہازس منٛز کوسؔ پیٚٹھٕ ردُس جزیرس کُن یتہِ جہازٕ بیٚیہِ ٹھہریو۔   امہ پتہٕ گےَ أسؠ بیٚکہ دوٚہہ پترہؔ شہر یتہِ جہازٕ رُکیاو۔  
\v 2 پترہؔ ہس منٛز تروو اسہِ سُہ جہازٕ تہٕ تتہِ ووٚن اسہِ کٔمؠ تام زِ اکھ جہازٕ چُھ یُس فینیکے علاقس کُن گژھِ۔   تہٕ أسؠ کٔھتؠ تٔتھؠ جہازس تہٕ سُہ دراو۔  
\p
\v 3 اسہِ کوٚر سمندرٕ پیٚٹھی سفر یۅتام زِ أسؠ وُچھہو کُپرس جزیرٕ۔   أسؠ دراے جزیرس جنوبہ کِنؠ جہازٕ سفر کران یۅتام أسؠ صوریہ صوبہٕ کِس فونیشیاؔ شہرٕ کِس علاقس منٛز وٲتؠ۔   تتہِ اوس جہازس واریہن دوٚہُن ٹھہرُن تکیازِ تمہِ کٮ۪ن کارکُنن اوس سامانہٕ والُن۔  
\p
\v 4 کٔمؠ تام ووٚن اسہِ زِ صورؔ صوبٕکؠ ایمانہٕ وٲلؠ کتہِ چھِ روزان لہٰذا گےَ أسؠ تہٕ رودؠ ستن دوٚہُن تِمن سٟتؠ۔   تکیازِ خدایہِ سنٛدؠ روحن اوس تِمن اِشارٕ دیتمُت زِ یروشلمسؔ منٛز واتناون پولُسسؔ لوٗکھ تکلیف،  تِمو ووٚن پولُسسؔ زِ تمِس پزِنہٕ تور گژُھن۔  
\p
\v 5 مگر یِتھےٕ جہازس بیٚیہِ نیرنُک وقت ووت تہٕ أسؠ سپدؠ یروشلم نیرنہٕ باپتھ تیار۔   ییٚلہ أسؠ صورؔ پیٚٹھٕ دراے تہٕ سٲری مرٕد تہنٛزٕ خاندارنہِ تہٕ بچہٕ دراے اسہِ سٟتؠ سمندر بٹھِس تام۔   اسہِ ساروےٕ مونٛگ تتہِ سیٚکہ پیٚٹھ کوٚٹھؠ تراوِتھ دُعا۔  
\v 6 اسہِ سارنی الوِداع کٔرِتھ سپٕدؠ پولُسؔ تہٕ أسؠ تمسنٛدؠ سٲتھی جہازس منٛز سوار تہٕ باقی ایمان وٲلؠ گےَ واپس پن پنُن گھرٕ۔  
\p
\v 7 صورؔ منٛزٕ نیرنہٕ پتہٕ گےَ أسؠ تتھ جہازس منٛز پتُلمِیسؔ شہر تام۔   تتہِ ٲسؠ ایمان وٲلؠ تہٕ اسہِ کٔر تِمن سلام تہٕ تتھ راتس رودؠ تِمنےٕ سٟتؠ۔  
\v 8 دوٚیمہ دوٚہہ گےَ أسؠ پتُلمِیسؔ ترٲوِتھ قیصریہؔ شہرس کُن روانہٕ یتہِ أسؠ فلپسؔ سنٛدِ گھرِ رودؠ یمؠ پنپن وقت باقین یہ وننَس منٛز گذُور زِ یسوعؔ سنٛدؠ پٲرو کار کِتھٕ کٔنؠ ہیٚکو بنِتھ۔   سُہ اوس تِمو ستو نفرو منٛزٕ اکھ یمہٕ یروشلمؔ کیٚو ایمان والیٚو مونٛڈٕ زنانن پٲروی کرنہٕ باپتھ ژٲرمٕتؠ ٲسؠ۔  
\v 9 تمِس آسہٕ ژور کورِ یمہٕ وُنہِ انۂرشے آسہٕ۔   تِمو منٛزٕ ٲس پرٛتھ اکھ بےٚ پھرُکؠ پٲٹھؠ سُہ پٲغام بوزٕناوان یُس پاک روحَن تِمن ونمُت اوس۔  
\p
\v 10 ییٚلہ أسؠ فلپس سنٛدِ گھرِ واریہن دوٚہُن رودؠ تہٕ اکھ نبی یَس اگبُسؔ ناو اوس وۅتھ یہُودیہ ضلع پیٚٹھٕ تہٕ ووت قیصریہؔ۔   سُہ اوس اکثر تِم پٲغام بوزٕناوان یمہ پاک روحن تمِس ونمٕتؠ ٲسؠ۔  
\v 11 یتہِ أسؠ ٲسؠ توٚت یتھ مژروو تٔمؠ پولُسسؔ کمربنٛد،  پتہٕ گنٛڈؠ تٔمؠ تمہ سٟتؠ پنٕنؠ کھۅر تہٕ اتھٕ تہٕ ونُن،  "پاک روح چُھ ونان،  "یروشلمسؔ منٛز گنٛڈن یہُودؠ سردار یمہِ دالو کمربنٛد کِس مٲلک سنٛدؠ اتھٕ کھۅر یمہِ آیہ،  تہٕ دِنس اکِس قٲدؠ سنٛدِ حثیتہٕ غٲر یہُودؠ لوٗکن ہنٛدین اتھن منٛز"
\p
\v 12 ییٚلہ اسہ منٛزٕ باقی لوٗکو یہ بوز تہٕ اسہِ تہٕ تتہِ موجود باقی ایمان والیٚو ووٚن پولُسسؔ،  "مہربٲنی کٔرِتھ مہٕ گٔژھیٚو یروشلمؔ"
\v 13 مگر پولُسنؔ دِتُکھ جواب،  "مہربٲنی کٔرتھ مہٕ لٲگیٚو ودُن نَہ مہٕ کٔریٚو مےٚ گژھنہٕ نِشہٕ رُکاونٕچ کوشش۔   بہٕ چُھس قٲد گژھنہٕ باپتھ تہٕ یروشلمسؔ منٛز مرنہٕ باپتھ دِلہ سان تیار تکیازِ بہٕ چُھس خداوند یسوع سنٛز خدمت کران۔  
\v 14 ییٚلہ اسہِ باسیاو زِ سُہ گژھِ یروشلم تہٕ اسہِ کٔر نہٕ سُہ رُکاونہٕ باپتھ مذید آمادٕ۔   اسہِ ووٚن،  "خداوند سُنٛد یژُھن سپدِن پوٗرٕ!"
\p
\v 15 قیصریہؔ ہس منٛز کوٚر اسہِ یمو دوٚہو پتہٕ پنُن مال تیار تہٕ گےَ زمینی یروشلمؔ گژھنہٕ باپتھ روانہٕ۔  
\v 16 قیصریہؔ ہٕکؠ کینٛہہ ایمان وٲلؠ تہِ گےَ اسہِ سٟتؠ۔   تِمو نی أسؠ اکِس نفرٕ سُنٛد گھرٕ روزنہٕ خٲطرٕ یمِس مناسونؔ ناو اوس۔   سُہ اوس کپرَس جزیرُک،  یمؠ یسوعسؔ پیٚٹھ تمہ وزِ ایمان اوٚنمُت اوس ییٚلہ لوٗکو گۅڈنچہِ لٹہ تمِس متعلق پٲغام بوزُن شروع اوس کوٚرمُت۔  
\p
\v 17 ییٚلہ أسؠ یروشلمؔ وٲتؠ تہٕ ایمان والیٚن ہنٛزِ اکہ جمٲژ کوٚر اسہِ خۅشی سان استقبال۔  
\v 18 بیٚکہ دوٚہہ گےَ پولُسؔ تہٕ اسہِ منٛزٕ باقی لوٗکھ یعقوبؔس سٟتؠ کتھ کرنہِ یُس تتہِ کلیسیُک رہنما اوس۔   یروشلمٕکہِ چرچٕکؠ باقی سٲری رہنما تہٕ زِٹھؠ تہِ ٲسؠ تٔتؠ۔  
\v 19 پولُسنؔ کٔر تِمن سلام تہٕ پتہٕ ونِنکھ تمہٕ سارے کتھٕ یمہ خداین سُہ غٲر یہُودؠ لوٗکن برُونٛہہ کنہِ کرنس لایکھ بنومُت اوس۔  
\p
\v 20 یہ بوزِتھ کوٚر یعقوبنؔ تہٕ باقی بزرگو خدایہ سُنٛد شکریہ۔   پتہٕ ووٚن تِمو منٛزٕ أکؠ پولُسسؔ،  "بایا،  توٚہؠ چُھو زانان زِ یتہِ چھِ اسہ منٛز ساسہٕ واد یہُودؠ یِمو خداوند یسوعسؔ پیٚٹھ ایمان چُھ اوٚنمُت۔   امہِ علاوٕ چُھو توٚہؠ زانان زِ أسؠ سٲری چھِ سیٚٹھاہ احتیاط سان تِمن قانونن ہنٛز تعمیل کران یمہ موسیٰؔ ہن اسہِ دِتمٕتؠ چھِ۔  
\v 21 مگر سانیٚن سٲتھی یہُودؠ ایمان والیٚن آو وننہٕ زِ ییٚلہ توٚہؠ غٲر یہُودینؔ منٛز آسان چُھو تہٕ توٚہؠ چُھو تتہِ روزن والیٚن یہُودؠ ایمان والیٚن ونان زِ تِم تراون موسیٰؔ سنٛدین قانونن پیٚٹھ عمل کرِنؠ۔   لوٗکھ چھِ ونان زِ توٚہہ وُنو تِمن یہُودؠ ایمان والیٚن زِ پننٮ۪ن شُریٚن مہٕ کٔریٚو خُتنہٕ تہٕ سانؠ باقی رسٕم تہٕ مہٕ پٲلیٚو۔   اسہِ چھنہٕ پژھ بِہان زِ تِم کیاہ چھِ توٚہہِ متعلق یہ پوٚز ونان۔  
\p
\v 22 اگر سٲنؠ سٲتھی ایمان وٲلؠ بوزن یہ زِ توٚہؠ چُھو آمٕتؠ تہٕ تِم آسن توٚہہ ناراض۔   لہٰذا چُھ توٚہہِ کینٛہہ تیٚوتھ کرنٕچ ضرورت تاکہ تہِ ہیٚکو تِمن ہٲوِتھ زِ یہ کینٛژھا تِمو توٚہہ متعلق بوزمُت چُھ تہِ چُھنہٕ پزر۔  
\v 23 تہٕ مہربٲنی کرِتھ کٔریٚو تی یہ أسؠ توٚہہ ونان چھِ۔   اسہِ منٛز چھِ ژور نفر تِتھؠ یِمو خدایس سٟتؠ منت گنٛڈمٕژ چھےٚ۔  
\v 24 تِمن نفرن سٟتؠ گٔژھیٚو ہیکل تہٕ تتہِ نبٲیو رسٕم یۅسہ توٚہہ تہٕ تِہنٛدِ باپتھ ضروری چھےٚ تاکہ تِم ہیٚکن ہیکلس منٛز عبادت کٔرِتھ۔   پتہٕ ییٚلہ تہنٛدِ باپتھ قربٲنی کرنُک موقہٕ واتہِ تہٕ تمیُک قٟمت دِن۔   تمہ پتہٕ کاسن امیُک اظہار کرنہٕ باپتھ مَس زِ تِمو کوٚر تی یہ تِمو ووٚن زِ أسؠ کرو۔   ییٚلہ لوٗکھ توٚہہ تِمن نفرن سٟتؠ ہیکل کِس صحنس منٛز وچُھن تہٕ تِم زانن زِ یہ کینٛژھا تِمن توٚہہ متعلق وننہٕ آمُت چُھ تہِ چُھنہٕ پزر۔   امہِ بجایہ گژھِ تِمن سارنی یہ معلوم زِ توٚہؠ چُھو سٲنؠ سٲری یہُودؠ قانون مانان۔  
\p
\v 25 یۅتام زن غٲر یہُودؠ ایمان والیٚن ہُنٛد تعلق چُھ،  اسہِ یروشلم کیٚو بزرگو کٔر اتھ متعلق کتھ زِ سٲنؠ کمہٕ قانون پزن تِمن مانٕنؠ،  تہٕ اسہِ ووٚن تِمن اکِس خطس منٛز لیٚکھِتھ زِ اسہِ کیاہ فٲصلہٕ نیٚو۔   اسہِ اوس لیٚوکھمُت زِ تِم کھیٚن نہٕ سُہ ماز یُس لوٗکو کانٛسہِ بُت سنٛزِ قربٲنی باپتھ پیش کوٚرمُت آسہ۔   تِم کھیٚن نہٕ جانورن ہُنٛد خوٗن،  تہٕ تِمن جانورن ہُنٛد ماز کھیٚن نہٕ یمہٕ لوٗکو جھٹھٕکؠ آسن کٔرؠ مٕتؠ۔   اسہِ ووٚن تِمن یتہِ زِ تِم شونٛگن نہٕ کانٛسہ تِتھس شخصس نِش یمِس سٟتؠ نہٕ تِہُنٛد خاندر گمُت آسہ۔  
\v 26 تہٕ پولُسنؔ کوٚر تِہنٛدِس وننس پیٚٹھ رضامنٛدی ہُنٛد اظہار تہٕ دویمہِ دوٚہہ تُلؠ تٔمؠ یمہ ژور نفر سٟتؠ تہٕ کوٚرُن پنُن پان پاک۔   امہ پتہٕ گو پولُسؔ ہیکل کِس دربارس منٛز تہٕ ووٚنُن کاہنس زِ تِم کمہِ دوٚہہ مۅکلاوِ پنُن پان پاک کرِتھ تہٕ تِم کر کرن تِمو منٛزٕ پرٛتھ أکؠ سنٛدِ باپتھ جانور قربٲنی رنٛگؠ پیش کرِ۔  
\p
\v 27 ییٚلہ پنُن پان پاک کرنہٕ پتہٕ قریبن ستھ دوٚہہ انٛد وٲتؠ تہٕ پولُسؔ ووت ہیکل کِس آنٛگنس منٛز واپس۔   آسیہؔ کیٚو کینٛژو یہُودیٚو وُچھ سُہ تتہِ تہٕ تِم سپدؠ تس ناراض۔   تِمو أنؠ بیٚیہِ تہِ واریاہ یہُودؠ ناد دِتھ یمہٕ ہیکل کِس آنٛگنس منٛز ٲسؠ تاکہِ پولُسؔ رٹنس منٛز کرٕہن مدد۔  
\v 28 تمہ ٲسؠ کرٮ۪کہٕ دِتھ ونان،  "بایو،  ؤلیٚو یمِس نفرس سزا دِنس منٛز کٔریٚو اسہِ مدد! یہ چُھ سُہ اکھ یُس یوٚت تہِ گژھان چُھ تتہِ چُھ لوٗکن تعلیم دِوان زِ یہُودی لوٗکھ زٲنؠ ووکھ حقیر۔   یہ چُھ لوٗکن ہیٚچھٕ ناوان زِ تِم مہٕ کٔرنؠ ووٚنؠ موسیٰؔ سنٛدین قانونن ہنٛز تعمیل تہٕ نُمہٕ کرِنؠ یمہ مقدس ہیکلُک احترام۔   اکھتُے أنِن غٲر یہُودؠ سانِس مقدس ہیکل کِس صحنس منٛز یمہِ کِنؠ یہ جاے ناپاک سپٕز۔  
\v 29 تِمو ووٚن یہ اوموٚکھٕ تکیازِ تِمو وُچھ پولُسؔ یروشلمس منٛز تُرفمسسؔ سٟتؠ یُس اِفسُک اکھ غٲر یہُودؠ اوس اورٕیور پھیران تِہنٛدؠ قانون ٲسؠ نہٕ غٲر یہُودینؔ ہیکلس منٛز اژنُک اِجازت دِوان،  تہٕ تِہُنٛد خیال اوس زِ پولُسنؔ اوٚن تمہ دوٚہہ ترُفِمسؔ ہیکل کِس صحنس منٛز۔  
\p
\v 30 شہرٕ کیٚو ساروےٕ لوٗکو بوز زِ ہیکل کِس صحنس منٛز چُھ مصیبت تہٕ وٲتؠ دوان دوان تور۔   تِمو اوٚن پولُسؔ ہیکلہٕ منٛزٕ کھکھرِ نیٚبر کڈِتھ۔   ہیکل صحنٕکؠ دروازٕ آے بنٛد کرنہٕ،  تاکہ لوٗکھ کرن نہٕ ہیکلس منٛز بوال۔  
\p
\v 31 ییٚلہ تِم پولُسسؔ مارنٕچ کوشش کران ٲسؠ تہٕ کُس تام شخص ژول ہیکلس نزدیک قلعہٕ کہ طرفہ تہٕ ونُن رومی کمانڈرس زِ یروشلمس منٛز چھِ واریاہ لوٗکھ ہیکلس اندر بوال کران۔  
\p
\v 32 کمانڈر آو جلدےٕ کینٛہہ افسر تہٕ سِپہن ہنٛز اکھ بٔڑ جماتھ ہیٚتھ ہیکل کُن یتہِ بھیڑ ٲس۔   یتُھےٕ لُکہ ہجومن یمہ پولُسسؔ لایان تہٕ شور کران ٲسؠ کمانڈر تہِ سِپاہ وُچھ تِمو کوٚر تس مار دیٚون بنٛد۔  
\p
\v 33 کمانڈر ووت تتھ جایہ یتِتھ پولُسؔ اوس تہٕ تمؠ رۅٹ سُہ۔   تمؠ دیُت سِپہن حکم ز،  تِم گنٛڈن پولُسسؔ نریٚن زنجیر۔   پتہٕ پرِژُھن ہجومس منٛز موجود لوٗکن،  "یہ نفر کُس چُھ تہٕ أمؠ کیاہ چُھ کوٚرمُت؟
\p
\v 34 تتہِ موجود واریہن لُکہ ہجومس منٛز ٲسؠ کینٛہہ نفر اکھ نعرٕ دِوان تہٕ بیاکھ۔ تکیازِ  تِم ٲسؠ تیوٗت شور کران،  کمانڈر اوس نہٕ سمجِھتھےٕ ہیٚکان زِ تِم کیاہ چھِ ونان۔   چناچہ تٔمؠ دیُت حکم زِ پولُسؔ نی وون قلعسؔ منٛز تاکہ سُہ کرِ تتہِ تمِس پرژھٕ گٲر۔  
\v 35 سِپہو نیٚو پولُسؔ قلعہٕ چن ہیرن تام مگر واریاہ لوٗکھ ٲسؠ پولُسسؔ پتہٕ دورِتھ مارنٕچ کوشش کران۔   چناچہ کمانڈرن ووٚن سِپہَن زِ پولُسؔ کھٲلؠ وون قلعہٕ چن ہیرن۔  
\v 36 پٔتؠ کِنؠ ٲس لوٗکن ہنحز بھیڑ شور تُلان زِ یہ مٲرؠ وون! یہ مٲرؠ وون!"
\p
\v 37 ییٚلہ پولُسؔ قلعس منٛز اژن وول اوس تہٕ تمؠ ووٚن کمانڈرس یونٲنؠ زبٲنؠ منٛز،  کیاہ بہٕ ہیٚکا توٚہہ سٟتؠ کتھ کٔرِتھ؟ کمانڈرن ووٚنُس مےٚ چھےٚ حٲرانی زِ ہیٚککھ یونٲنؠ بولِتھ!
\v 38 بہٕ اوسُس سونچان زِ ژٕ چُھکھ مِصرُک سُہ نفر یُس کینٛہہ کال برُونٛہہ حکومتس خلاف بغاوت کرٕنؠ یژھان اوس تہٕ یُس پانس سٟتؠ ژور ساس خوٗن خوار نفر ہیٚتھ صحراہس منٛز گو تاکہ أسؠ ہیٚکوون نہٕ سُہ رٹِتھ۔  
\p
\v 39 پولُسنؔ دِتُس جواب،  "نہ،  بہٕ چُھس نہٕ سُہ! بہٕ چُھس اکھ یہُودؠ۔   بہٕ چُھس ترسسؔ شہرس منٛز زامُت یُس کلکیہ صوبُک اکھ مشہور شہر چُھ۔   میٚون درخواست چُھ زِ توٚہؠ دِیو مےٚ لوٗکن سٟتؠ کتھ کرنہٕ۔  
\v 40 پتہٕ دیُت کمانڈرن پولُسسؔ کتھ کرنُک اجازت۔   چناچہ پولُسؔ گو ہیرِ پیٚٹھ کھڑا تہٕ اتھٕ سٟتؠ کوٚرُن لوٗکن ژھۅپہ کرنُک اشارٕ۔   تہٕ ییٚلہ لُکہ ہجومن خاموشی کٔر تہٕ پولُسنؔ کٔر تِمن سٟتؠ پننہِ عبرٲنؠ زبٲنؠ منٛز کتھ۔
\c 22
\p
\v 1 پولُسنؔ ووٚن،  "یہُودؠ بزرگو تہٕ میانیٚو یہُودؠ سٲتھیو،  میانؠ کتھ بوزیٚو یودوے بہٕ تِمن لوٗکن سٟتؠ کتھ کران چُھس یمہ مےٚ الزام دِوان چھِ"
\v 2 ییٚلہ لُکہ ہجومن پولُسؔ تِمن سٟتؠ پننہِ عبرٲنؠ زبٲنؠ منٛز کتھ کران بوز تِم گَے خاموش تہٕ لٔگؠ بوزنہِ۔   پتہٕ ووٚن پولُسنؔ تِمن، 
\p
\v 3 "توٚہہ سارنی ہنٛدؠ پٲٹھؠ چُھس بٕتہ یہُودؠ۔   بہٕ چُھس کلکیہ صوبہ کِس ترسسؔ شہرس منٛز زامُت،  مگر بہٕ چُھس یتؠ یروشلمس منٛزےٕ پرتھیٚومُت۔   ییٚلہ بہٕ لۅکُٹ اوسُس تہٕ مےٚ چھِ تِم قانون ہیٚچھمٕتؠ یمہٕ موسیٰؔ ہن سانٮ۪ن جدٕاجدادن دِتؠ مٕتؠ ٲسؠ۔   گملی ایلؔ اوس میٚون اُستاد۔   مےٚ کٔر تِمن قانونن پیٚٹھ عمل تکیازِ بہٕ اوسُس خدایہ سنٛز فرمانبرداری کرٕنؠ یژھان،  تہٕ مےٚ چُھ یقین زِ توٚہؠ سٲری ٲسیٚو تِمن قانونن ہنٛز پٲروی کران۔  
\v 4 اوے کِنؠ کٔر مےٚ تِم لوٗکھ گرفتار کرنٕچ کوشش یمہ یسوعسؔ متعلق خدایہ سنٛدِس پٲغامس پیٚٹھ یقین تھاوان ٲسؠ۔   مےٚ ژھٲنڈؠ تمہ مارنٕکؠ طریقہٕ۔   ییٚلہ تہِ مےٚ اتھ پٲغامس پیٚٹھ یقین تھاون وٲلؠ مرد تہٕ زنہِ وُچھِ،  مےٚ بٔرؠ تِم قٲد خانن منٛز۔  
\v 5 سردار کاہن اوس یہ زانان تہٕ یتھے پٲٹھؠ باقی نفر تہِ یِم سٲنِس یہُودؠ کونسلس سٟتؠ تعلق تھاوان چھِ۔   تِمو دِتؠ مےٚ کینٛہہ خط دمشق شہرس منٛز پننٮ۪ن یہُودؠ سٲتھیٚن نِش نِنہٕ باپتھ۔   یِمو نامو سٟتؠ میٚول مےٚ تور گژھنُک تہٕ یسوعسؔ پیٚٹھ ایمان انن والیٚن لوٗکن گِرفتار کرنُک طاقت۔   پتہٕ اوسسکھ بہٕ تمہ قٲدؠ بناوِتھ یروشلم انٕنؠ یژھان یُتھ تِمن یتی سزا ییہِ دِنہٕ۔  
\p
\v 6 لہٰذا گوس بہٕ دمشق۔   دوپہرس سٟتی ییٚلہ بہٕ دمشق نزدیک ووتُس تہٕ اچانک لوٚگ آسمانہٕ پیٚٹھ اکھ چمکہٕ وُن گاش مےٚ ژوٚشوٕیو انٛدو چمکٕنہِ۔  
\v 7 یہ چمکہٕ وُن گاش اوس یوٗت تیز زِ بہٕ آس پتھر لایہ نہٕ۔   پتہٕ بوز مےٚ آسمان پیٚٹھٕچ اکھ کہنٛز تام غٲبی آواز یۅسہ مےٚ ونان ٲس،  "ساوُل! ساوُل!ژٕ کیازِ چُھکھ مےٚ تکلیف دنہٕ واجنہِ کامہ کران؟"
\v 8 مےٚ دِتُس جواب،  "توٚہؠ کمہٕ چُھو،  خداوند؟ تٔمؠ دیُت جواب،  "بہٕ چُھس ناصرتُک یسوعؔ یمِس ژٕ تکلیف دِوان چُھکھ"
\p
\v 9 یمہ مےٚ سٟتؠ سفرس ٲسؠ تِمو تہِ وُچھ یہ چمکدار گاش،  مگر تِمن توٚر نہٕ فِکرے زِ یہ آواز کیاہ چھےٚ ونان۔  
\v 10 پتہٕ پرُوژھ مےٚ،  "خداوند،  توٚہؠ کیاہ چُھو مےٚ نِش یژھان؟" خداوندن ووٚن مےٚ،  وۅتھ تھوٚد تہٕ نیر دمشق۔   تتہِ ؤنی ژےٚ اکھ نفر تہِ سورےٕ یہ مےٚ ژٕ کرناونُک منصوبہ بنومُت چُھ"
\v 11 امہِ پتہٕ اوسُس نہٕ بہٕ کِہین وُچِھتھ ہیٚکان تکیازِ أمؠ تیز گاشن بنووُس بہٕ اوٚن۔   چناچہ یِم نفر مےٚ سٟتؠ ٲسؠ تِمو کٔر مےٚ نرِ تھف تہٕ نیوہس دمشق۔  
\p
\v 12 اکھ نفر یمِس حننیاہؔ ناو اوس او مےٚ سمکھنہِ۔   سُہ اوس تیٚوتھ نفرا یمؠ خدایس عزت کوٚر تہٕ یہُودؠ قانونن ہنٛز پابندی کٔر۔   دمشقس منٛز روزن والیٚو تمام یہُودیو کٔرؠ تمسنٛدؠ تعریف۔  
\v 13 سُہ آو تہٕ رود مےٚ نِش وۅدٕنؠ تہٕ ونُن،  "میانہٕ ساوُلؔ دوستا،  وُچھ سا بیٚیہِ" مےٚ وُچھ جلدےٕ تہٕ مےٚ وُچھ سُہ پانس برُونٛہہ کنہِ کھڑا۔  
\p
\v 14 پتہٕ ووٚن تٔمؠ،  "یمِس خدایہ سنٛز أسؠ عبادت کران چھِ تہٕ یمسنٛز عبادت سٲنؠ جدٕاجداد کران ٲسؠ،  تٔمؠ ژورنکھ ژٕ تہٕ ژےٚ ہٲوی سُہ زِ سُہ کیاہ چھُے ژےٚ کرناوُن یژھان۔   تٔمؠ ہونے ژےٚ سُہ راستباز شخص،  یسوع مسیحؔ،  تہٕ ژےٚ بوزُتھ پانہٕ ییٚلہ سُہ ژےٚ سٟتؠ کتھٕ اوس کران۔  
\v 15 سُہ چُھ یژھان زِ ژٕ ونکھ پرٛتھ جایہ لوٗکن یہ ژےٚ وچُھتھ تہٕ بوزتھ۔  
\v 16 بس ووٚنؠ مہٕ کر ژیر! وۅتھ تھوٚد،  بہٕ دِمے ژےٚ بپتسمہ،  تہٕ خداوند یسوعسؔ کر دُعا تہٕ خدایس منٛگ پننیٚن گنہن ہنٛز معافی!"
\p
\v 17 تمہ پتہٕ آس بہٕ یروشلم واپس۔   اکہ دوٚہہ گوس بہٕ ہیکل کِس صحنس منٛز تہٕ ییٚلہ بہٕ تتہِ عبادت کران اوسُس تہٕ مےٚ وُچھ اکھ خواب۔  
\v 18 خداوندن ووٚن مےٚ،  "یتہِ مہٕ روز۔   ووٚنؠ تراو یروشلم،  تکیازِ یتِکؠ لوٗکھ کرن نہٕ تتھ پیٚٹھ پژھ یہ ژٕ یِمن مےٚ متعلق ونان چُھکھ!"
\p
\v 19 مگر مےٚ ووٚن تس،  "خداوند،  تِم چھِ زانان زِ بہٕ گوس پننٮ۪ن واریہن عبادت خانن منٛز تُہنٛدؠ ایمان وٲلؠ وُچھنہِ۔   بہٕ اوسسکھ تم قٲدس منٛز بران یمہ بہٕ وُچھان اوسسکھ زِ یمہ چھِ تُہنٛدؠ ایمان وٲلؠ تہٕ بہٕ اوسس تِمن مار تہِ دِوان۔  
\v 20 تِمن چُھ یاد زِ ییٚلہ ستفنس امہ موٚکھٕ مارنہٕ آو زِ سُہ اوس توٚہہ متعلق لوٗکن ونان تہٕ بہٕ اوسُس تتہِ کھڑا روزِتھ وُچھان تہٕ تتھ تٲید کران یہِ تِم کران ٲسؠ۔   مےٚ کٔر نیٚبرٕ کنہِ پلون رٲچھ یمہ قتل کرن والیٚو اکِتھ کُن ترٲمٕتؠ ٲسؠ۔  
\v 21 مگر خداوندن ووٚن مےٚ،  "نہ،  یتہِ مہ روز! یروشلم تراو،  تکیازِ بہٕ چُھستھ ژٕ یتہِ پیٚٹھٕ واریاہ دوٗر دویمیٚن لُکہٕ جمٲژن مطلب غٲر یہُودین نِش سوزن وول"
\p
\v 22 لوٗکو بوز زِ پولُسؔ کیاہ چُھ ونان یۅتام نہٕ تٔمؠ خداوند سنٛدِس دویمیٚن لُکہٕ جمٲژن منٛز سوزنس متعلق کتھ کٔر۔   تِمو تُل پتہٕ شور،  "یہ مٲرؠ وون!،  یہ مٲرؠ وون! یہ چُھنہٕ ووٚنؠ زنٛدٕ روزُن لایکھ!"
\v 23 ییٚلہ تِم کرٮ۪کہٕ دِوان ٲسؠ تہٕ تِمو کٔڈؠ پنٕنؠ پلو نیٚبر تہٕ چھچِکھ گرٕد ہوہس منٛز یمہ سٟتؠ ننان اوس زِ تِمن کوتاہ شرارتھ چُھ۔  
\v 24 تہٕ سردارن دیُت حکم زِ پولُسؔ گژھِ قٲد خانس منٛز ننہٕ یُن۔   تِمو ووٚن سِپہَن زِ تِم دِین پولُسسؔ کوڑٕ تاکہ سُہ ونہِ زِ تٔمؠ کیاہ کوٚر تیٚوتھ یمہ سٟتؠ یہُودؠ ناراض سپٕدؠ۔  
\p
\v 25 تہٕ پتہٕ رچہِ تِمو تمؠ سنٛزٕ نرِ تہٕ گنجہَس تاکہ تمسنٛدِس کمرس ہیٚکہ ہن کوڈٕ دِتھ۔   مگر پولُسؔ ووٚن پانس نِش موجود سِپہس،  "اگر ژٕ مےٚ اکِس رومی شہرِیس کوڈٕ والکھ ژٕ کرکھ اکھ غٲر قانونی کٲم یمِس پیٚٹھ نہٕ کانٛہہ مقدِمہ دٲیر گو تہٕ نہٕ آس بہٕ مجرم قرار دنہٕ"
\v 26 ییٚلہ افسرن یہ بوز تہٕ سُہ گو کمانڈرس نِش تہٕ تس دژٕن یہ خبر۔   تمؠ ووٚن کمانڈرس،  "یہ نفر چُھ رومُکؔ شہری! پٔزؠ کِنؠ ہکیٚو نہٕ توٚہؠ اسہِ أمِس کوڈٕ دِنُک حکم کرتھ!"
\p
\v 27 یہ بوزِتھ گو کمانڈر حٲران۔   سُہ گو پانے جیلس منٛز تہٕ ونُن پولُسسؔ،  "مےٚ ونتہٕ ژٕ چُھکھا پزی رومُکؔ شہری؟" پولُسنؔ دِتُس جواب،  "آ،  بہٕ چُھس رومی"
\v 28 پتہٕ ووٚن کمانڈرن بٕتہ چُھس رومُکؔ شہری۔   مےٚ کٔرؠ رومی شہری بننہٕ خٲطرٕ واریاہ پونٛسہٕ خرٕچ۔   پولُسنؔ ووٚن،  "مگر مےٚ چُھ بحثیتِ رومی شہری یی زایُن نِمُت"
\v 29 سِپاہ ٲسؠ پولُسسؔ کوڈٕ دنہٕ باپتھ تہٕ تس پننِس کٔرمٕتِس سوال کرنس تیار۔   مگر پولُسؔ سنٛز کتھ بوزِتھ ترُوو سُہ تِمو یلہٕ۔   کمانڈر تہِ کھوژ،  تکیازِ سُہ اوس زانان زِ پولُسؔ چُھ رومُکؔ باشنٛدٕ تہٕ ییٚلہ تمؠ سِپہن پولُسؔ سنٛدؠ اتھٕ گنڈنٕکؠ حکم دیُت تٔمؠ پھُٹروو تہِ کٔرِتھ قانون۔  
\p
\v 30 کمانڈر اوس وُنتہِ یہ زانُن یژھان زِ یہُودؠ کیازِ چھِ پولُسسؔ الزام لاگان۔   چناچہ دویمہ دوٚہہ ووٚن تٔمؠ سِپہَن زِ پولُسسؔ کٔڈیٚو زنجیرِ نیٚبر۔   تمؠ أنؠ سردار کاہن تہٕ کونسلٕکؠ باقے ممبر تہِ ملاقاتہٕ باپتھ بلٲوِتھ۔   پتہٕ نیٚو تٔمؠ پولُسؔ تہِ تورؠ یتہِ کونسلُک دربار اوس تہٕ تس آو وننہٕ زِ سُہ سپدِ تِمن برُونٛہہ کنہِ کھڑا۔
\c 23
\p
\v 1 پولُسؔ رود یہُودؠ کونسل کٮ۪ن ارکانن وُچھان تہٕ ونُن: "میانیٚو یہُودؠ سٲتھیو،  مےٚ گُذار پنٕنؠ سٲرے زندگی خدایہ سنٛدِس تعظیمس منٛز،  تہٕ مےٚ چھنہٕ کانٛہہ تِژھ کٲم کرمٕژ یۅسہ مےٚ باسان چُھ غلط ٲس بلکہِ کٔرِم رٕتؠ چیز۔  
\v 2 ییٚلہ سردار کاہن حننیاہنؔ پولُسؔ سنٛز کتھ بوز تہٕ تمؠ ووٚن تِمن نفرن یمہ پولُسسؔ نِش وۅدٕنؠ ٲسؠ زِ أمِس والیٚو تھپیرٕ۔  
\v 3 پتہٕ ووٚن پولُسنؔ حننیاہؔ ہس،  "ہے منافقہٕ،  خدا دِیی ژےٚ امیُک سزا۔   ژٕ بیٚہہ ہُتِتھ تہٕ کر میٚون فٲصلہٕ،  تِمن قانونن ہُنٛد استعمال کرِتھ یمہ خداین موسیٰؔ ہس ؤنمٕتؠ چھِ۔   مگر ژٕ چُھکھ پانہٕ تِمن قانونن ہنٛز نافرمٲنی کران،  تکیازِ ژےٚ دِتُتھ یہ وُچھنہٕ بغٲر یِمن مےٚ لاینُک حکم زِ مےٚ چھا کانٛہہ غلط کٲم کرمٕژ"
\p
\v 4 یمہ نفر پولُسسؔ نِش کھڑا ٲسؠ تِمو ووٚن تس،  "ژےٚ پزِہی نہٕ خدایہ سنٛدِس خٲدِم سٲنِس سردار کاہنس بُرٕ کتھ ونٕنؠ۔  
\v 5 پولُسنؔ دِتُکھ جواب،  "میانیٚو سٲتھی یہُودیو،  مےٚ چُھ افسوس زِ مےٚ ووٚن یہ۔   مےٚ ٲس نہٕ یہ پےَ زِ یمؠ نفرن توٚہہ ووٚن زِ یمِس لٲیو سُے چُھ سردار کاہن۔   اگر مےٚ یہ معلوم آسہ ہے تہٕ بہٕ ونہٕ ہا نہٕ پننِس سردار کاہنس متعلق بُرٕ تکیازِ بہٕ چُھس زانان زِ سٲنِس یہُودؠ شریعتس منٛز کیاہ چُھ لیٚکھِتھ،  "پننیٚو حکمرانو منٛزٕ مہ ونیٚو کانٛسہِ بُرٕ"
\p
\v 6 پولُسؔ اوس زانان زِ کونٛسلٕکؠ کینٛہہ رُکن چھِ صدوقی تہٕ کینٛہہ فریسی۔   چناچہ تٔمؠ دیُت کونسل حالس منٛز آلو،  "میانیٚو یہُودؠ سٲتھیو،  بہٕ چُھس اکھ فریسی،  تہٕ میٚون سورےٕ خاندان اوس فریسی۔   مےٚ پیٚٹھ آو یتہِ مقدِمہ لاگنہٕ تہٕ مےٚ چُھ یقین زِ اکہ دوٚہہ کرِ خدا تِمن لوٗکن بیٚیہِ زندٕ یمہ گُزریمٕتؠ چھِ۔  
\v 7 ییٚلہ تمؠ یہ ووٚن تہٕ فریسی تہٕ صدوقی لگؠ پانہٕ وٲنؠ بحث کرنہِ زِ یمہ لوٗکھ مودؠ تِم گژھنا دوبارٕ زنٛدٕ کنہ نہ،  تہٕ پرٛتھ کانٛہہ لُگ اکھ أکِس سٟتؠ بحث کرنہِ۔  
\v 8 صدوقی ین ہُنٛد خیال چُھ زِ لوٗکھ گژھن نہٕ مرنہٕ پتہٕ دوبارٕ زندٕ۔   تِم چھِ یتہِ زانان زِ نہ چھِ فرشتہٕ تہ نہ چُہ بیٚیہِ،  کُنہ قسمُک کانٛہہ روح۔   مگر فریسی ٲسؠ یمن سارنی کتھن پیٚٹھ پژھ کران۔  
\p
\v 9 تِم ٲسؠ بحث کران کران اکھ اکِس سٟتؠ شور کران۔   شریعتٕکؠ کینٛہہ زانن وٲلؠ یمہ فریسی ٲسؠ ؤتھؠ تھوٚد۔   تِمو منٛزٕ ووٚن أکؠ،  "اسہِ چُھ باسان زِ أمؠ شخصن کوٚر نہٕ غلط کینٛہہ۔   بنان چُھ زِ کانٛسہ فرشتن یا بیٚیہِ کانٛسہ روحن ما آسہ أمِس سٟتؠ کتھ کرمٕژ تہٕ یہ کینٛژھا یہ ونان چُھ تہِ آسہ پوٚز۔  
\v 10 پتہٕ لٔگؠ فریسی تہٕ صدیقی پانہٕ وٲنؠ لڑٲے کرنہِ۔   چناچہ کمانڈر کھوژ زِ یِم کرن پولُسسؔ نیٚوک نیٚوک۔   تمؠ ووٚن سِپہن زِ تِم وسن جیلہٕ منٛزٕ بوٚن تہٕ پولُسسؔ نِن کونسل کیٚو ارکانو نِشہٕ دوٗر تہٕ تھاونس بارکن منٛز۔  
\p
\v 11 امہِ رٲژ وُچھ پولُسنؔ خداوند یسوعؔ یوان تہٕ پانس نِش وۅدٕنؠ روزِتھ۔   خداوندن ووٚن تس،  "ہمتھ تھاو! ژےٚ ونُتھ یتہِ یروشلمس منٛز لوٗکن مےٚ متعلق،  تہٕ ژےٚ پٔزی رومہٕ کٮ۪ن لوٗکن تہِ مےٚ متعلق ونُن۔  
\p
\v 12 بیٚکہ دوٚہہ صُبحاے سمیاے کینٛہہ یہُودؠ یمہ پولُسسؔ نفرت کران ٲسؠ تہٕ لٔگؠ سُہ مارنٕکؠ طریقہٕ وننہِ۔   تِمو ووٚن پانہٕ وٲنؠ زِ یۅتام نہٕ سُہ مرِ تۅتام کھیٚمو نہٕ أسؠ کِہین تہٕ نہ چیٚمو کینٛہہ۔   تِمو کٔر خدایس عرضی زِ اسہِ وٲلؠ زِ لعنت اگر نہٕ اسہِ پننِس وعدس پیٚٹھ عمل کٔر۔  
\v 13 اتہِ ٲسؠ ژتجی پیٚٹھی نفر یمہ پولُسسؔ مارُن یژھان ٲسؠ۔  
\p
\v 14 تِم گےَ سردار کاہنن تہٕ یہُودؠ بُزرگن نِش تہٕ وُنہکھ،  "اسہِ کوٚر خدایس سٟتؠ یہ وعدٕ زِ یۅتام نہٕ أسؠ پولُسؔ مارٕ وون تۅتام کھیٚمو چیٚمو نہٕ أسؠ کِہین۔  
\v 15 اوٕ کِنؠ چھِ أسؠ توٚہہ گزٲرش کران زِ توٚہؠ گٔژھیٚو سردارس نِش تہٕ ونووس پوٗرٕ یہُودؠ کونسل کہ طرفہٕ پولُسؔ اسہِ نِش اننہٕ باپتھ۔   کمانڈرس ؤنیٚو زِ ژٕ چُھکھ پولُسؔ سٟتؠ بیٚیہِ کانٛہہ کتھ کرٕنؠ یژھان۔   أسؠ روزو پولُسؔ مارنہٕ باپتھ انتظار کران ییٚلہِ سُہ یپٲرؠ نیرِ۔  
\p
\v 16 مگر پولُسؔ سنٛزِ بیٚنہِ ہنٛدؠ نیٚچوؠ بوز زِ یِمن کیاہ ارادٕ چُھ،  چناچہ سُہ گو قلعس منٛز تہٕ ونُن پولُسسؔ۔  
\v 17 ییٚلہ پولُسنؔ یہ بوز تمؠ اوٚن اکھ افسر ناد دِتھ تہٕ ووٚننس،  "مہربٲنی کرِتھ نِتن یہ نوجوان کمانڈرس نِش،  تکیازِ أمِس چُھ تس کہتام ونُن"
\p
\v 18 چناچہ افسرن نیٚو یہ نوجوان کمانڈرس نِش۔   افسرن ووٚن کمانڈرس،  "پولُسؔ قٲدؠ کوٚر مےٚ آلو تہٕ ووٚنُن مہربٲنی کرِتھ نِن یہ نوجوان کمانڈرس نِش،  تکیازِ أمِس چُھ کہتام ونُن"
\v 19 کمانڈرن کٔر نوجوان لڑکس اتھس تھف تہٕ نیوٗن الگ کُن تہٕ پرُوژھنس،  "ژٕ کیاہ چُھکھ مےٚ ونُن یژھان؟"
\p
\v 20 تٔمؠ ووٚن،  "کینٛہہ یہُودؠ چھِ یمہ پولُسسؔ پگاہ پننہِ مجلسہ منٛز انٕنؠ یژھان چھِ۔   تِم ونن زِ أسؠ چھِ أمِس کینٛہہ سوال پرٕژھنؠ یژھان۔   مگر تہِ چُھنہٕ پزر۔  
\v 21 یہ کینٛژھا تِم توٚہہِ کرُن ونن تہِ کٔرزیٚو نہٕ تکیازِ تتہِ آسن ژتجی کھۅتہٕ زیادٕ یہُودؠ نفر زاگہِ بہِتھ پولُسسؔ قتٕل کرنُک انتظار کران ییٚلہ سُہ کونسلچہِ وتہِ کِنؠ نیرِ۔   حطاکہ تِمو چُھ خدایس سٟتؠ عہد کوٚرمُت زِ یۅتام نہٕ تِم پولُسسؔ قتٕل کرن تۅتام نہ کھیٚن تِم کینٛہہ تہٕ نہ چیٚن۔   تِم چھِ یہ کرنہٕ خٲطر تیار تہٕ وُنہ کٮ۪ن چھِ تِم انتظار کران زِ توٚہؠ گٔژھیٚو تتھ کتھِ پیٚٹھ رٲضؠ یہ تِم توٚہہِ کرُن ونان چھِ"
\v 22 کمانڈرن ووٚن نوجوانس،  "ژٕ ؤنؠ زیٚنہٕ کانٛسہِ زِ ژےٚ ونُتھ مےٚ اتھ منصوبس متعلق" پتہٕ کوٚر تٔمؠ نوجوان روانہٕ۔  
\p
\v 23 پتہٕ أنؠ کمانڈرن پنٕنؠ زٕ افسر ناد دِتھ تہٕ ونُن تِمن،  "دون ہتن سِپہن ہنٛز اکھ جماتھ کٔرؠ وون سفرٕ خٲطرٕ تیار۔   گُریٚن پیٚٹھ ستتھ سِپاہ تہ دویِمیٚن دون ہتن سِپہن سٟتؠ یمہ نیزٕ ہیٚتھ آسن۔   توٚہہِ سارنی پزِ از راتھ کیُت نوِ بجہ قیصریہ شہر کُن گژھنہٕ باپتھ تیار روزُن۔  
\v 24 تہٕ پولُسؔ سنٛزِ سوارِ باپتھ نیزیٚوکھ گُرؠ سٟتؠ،  تہٕ سُہ نیزیون حفاظتہٕ سان فیلِکسؔ سنٛدِس محلس منٛز۔  
\p
\v 25 پتہٕ لیٚوکھ کمانڈرن گورنر سںنٛدِ ناوٕ خط۔   تمؠ یہ لیٚوکھ تہِ چُھ یتھ کنؠ:
\v 26 "بہٕ چُھس کلودیُسؔ لوسیاسؔ توٚہہ لیٚکھان۔   فیلِکسؔ چُھ سون گورنر یمِس أسؠ کٲفی عزت کران چھِ،  تہٕ بہٕ چُھسو توٚہہ سلام پیش کران۔  
\v 27 مےٚ سوز یہ نفر پولُسؔ توٚہہ نِش تکیازِ کینٛژو یہُودیٚو اوس یہ روٚٹمُت تہٕ اوسُکھ مارُن ہیٚوتمُت۔   مگر مےٚ بوز کمِس تام نِش زِ یہ چُھ رومی شہری،  بہٕ تہٕ میانؠ سِپاہ گےَ تہٕ بچوو سُہ۔  
\p
\v 28 بہٕ اوسُس زانُن یژھان زِ تِم یہُودؠ کیاہ ٲسؠ ونان زِ تٔمؠ چُھ غلط کوٚرمُت،  امہِ موٚکھٕ نِیاو مےٚ سُہ یہُودؠ مجلسہِ منٛز۔  
\v 29 مےٚ بوز ییٚلہِ تِم نفر تمِس سوال کران ٲسؠ تہٕ تٔمؠ دیُت جواب۔   یِمن چیزن ہُنٛد تِمو تس اِلزام دیُت تِمن ہُنٛد تعلُق اوس تِہنٛدین یہُودؠ قانونن سٟتؠ۔   مگر پولُسنؔ کٔر نہٕ سانٮ۪ن رومی قانونن ہنٛز کانٛہہ نافرمٲنی۔   لہٰذا پزِ نہٕ سانٮ۪ن حٲکمن تس پھٲسؠ دِنؠ، ہانٛکلو سٟتؠ بند کرُن یا پزیٚکھ جیل برُن۔  
\v 30 کٔمؠ تام ووٚن مےٚ زِ کینٛہہ یہُودؠ چھِ أمِس نفرس مارنُک اِرادٕ کرِتھ،  امہِ کِنؠ سوز مےٚ یہ توٚہہ نِش تاکہ توٚہؠ کریٚو أمِس سٟتؠ انصاف۔   مےٚ دیُت تِمن یہُودینؔ تہِ حکم یِمو تمِس اِلزام دِتؠ زِ تِم گژھن توٚہہ نِش قیصریہ تہ ونن توٚہہ زِ أمِس کیاہ خطا چُھ۔   الوداع۔  
\v 31 لہٰذا کوٚر سِپہو تی یہ کمانڈرن تِمن ووٚن۔   تِمو رۅٹ پولُسؔ تہٕ واتہٕ نووُکھ راتھ کیُت پانس سٟتؠ انتیپترسؔ۔  
\v 32 بیٚہِ دوٚہہ آے سِپاہ وۅکھٕلؠ یروشلم واپس تہٕ یِم سِپاہ گُرین پیٚٹھ ٲسؠ تِم گےَ پولُسسؔ سٟتؠ۔  
\v 33 ییٚلہ تِم قیصریہ شہرس منٛز وٲتؠ تہٕ سُہ خط دِتُکھ گورنرس تہٕ پولُسؔ تھووُکھ تس برُونٛہہ کنہِ۔  
\v 34 گورنرن ووٚن خط پرنہٕ پتہٕ پولُسسؔ،  "ژٕ کمہِ صوبُک چُھکھ؟" پولُسنؔ دتُس جواب،  "بہٕ چُھس کلکیہ صوبُک"
\v 35 پتہٕ ووٚن گورنرن،  "ییٚلہ تِم لوٗکھ ین یِمو ژےٚ اِلزام دِتمتؠ چھی تہٕ بہٕ بوزٕ گۅڈٕ توٚہہِ سارنی ہُنٛد تہٕ پتھ کرٕ تُہنٛدِ مسلُک فٲصلہٕ" پتہٕ دیُت تمؠ حکم زِ پولُسسؔ تھایو تتھ محلس منٛز پہرٕ یُس عظیم بادشاہ ہیرودیسنؔ بنوومُت چُھ۔
\c 24
\p
\v 1 پانٛژِ دوٚہؠ پتہٕ ؤتھؠ سردار کاہن حننیاہؔ یروشلمہٕؔ پیٚٹھٕ باقی کینٛہہ یہُودؠ بُزرگ تہٕ اکھ تقریر کرن وول ہیٚتھ یمِس تِرطلُسؔ ناو اوس۔   تتہِ ووٚن تِمو گورنرس زِ پولُسنؔ کیا کیا کوٚر یُس تِہنٛدِ حسابہٕ غلط اوس۔  
\v 2 گورنرن دیُت پولُسؔ اندر اننُک حکم،  یتُھےٕ پولُسؔ ووت تہٕ تِرطلُسؔ لوٚگ تمِس اِلزام دِنہ۔   تٔمؠ ووٚن گورنرس،  "محترم گورنر فیلِکسؔ،  ییتہِ ہن ورؠ ین توٚہہ اسہِ پیٚٹھ حکومت کٔرو،  اسہِ گُزار اصٕل زندگی امنہٕ سان۔   دٲنشمنٛدی تہٕ منصوبہ بنٛدی کٔرِتھ کریٚو توٚہہ یمہِ صوبٕکؠ واریاہ چیز بہتر۔  
\v 3 لہٰذا اے گورنر فیلِکسؔ،  چھِ أسؠ تُہنٛد شُکرانہٕ ادا کران یہ توٚہہ اسہِ سارنی باپتھ کوٚرو۔   یتہِ تہِ توٚہہ کانٛہہ کٲم کٔرو۔  
\p
\v 4 مگر،  امہِ موٚکھٕ زِ أسؠ نِمو نہٕ تُہنٛد زیادٕ وقت،  بہٕ چُھس توٚہہ عرضی کران زِ مہربٲنی کرِتھ بوزیٚو میانؠ کتھ۔  
\v 5 اسہِ وُچھ زِ یہ نفر یتھ جایہِ تہِ گژھان چُھ تتہِ چُھ یہُودینؔ پریشانی تُلان۔   سُہ چُہ تمہ سارے جمٲژ ہنٛز قیادت کران یتھ لوٗکھ ناصری سنٛز پیروکار ونان چھِ۔  
\v 6 یوٚت تام تہِ زِ أمؠ کٔر یروشلم کِس ہیکلس منٛز تِژھ کٲم کرنٕچ کوشش یۅسہ تتھ ناپاک کرِہے،  امہِ کِنؠ کوٚر یہ اسہِ گرفتار۔   أسؠ چھِ پننہ شریعتہٕ مطابق امسُنٛد فٲصلہ کرُن یژھان۔  
\p
\v 7 مگر رومی قلعُک کمانڈر آو پنٕنؠ سِپاہ ہیٚتھ تہٕ نیوکھ یہ اسہِ نِش وُلوِتھ۔  
\v 8 تہٕ سوزِن أسؠ توٚہہِ نِش۔   اگر توٚہؠ پانہٕ أمِس سوال کٔریٚو تہٕ توٚہہ تریو پانے فِکرِ زِ یمہ سارے کتھٕ یِمن متعلق أسؠ أمِس الزام لاگان چھِ چھےٚ پزٕ۔  
\v 9 پتہٕ ووٚن تتہِ کیٚو یہُودؠ رہنماہو گورنرس زِ یہ کینٛژھا ترِطاس ونان چُھ تہِ چُھ پوٚز۔  
\p
\v 10 پتہٕ کوٚر گورنرن پولُسسؔ کُن اشارٕ زِ ژٕ ون پنٕنؠ کتھ۔   تہٕ پولُسنؔ دیُت جواب،  "گورنر فیلِکسؔ،  بہٕ چُھس زانان زِ توٚہہ چھِ واریہس وقتس یہُودؠ صوبٕکؠ فٲصلہٕ کٔرؠ مٕتؠ۔   اوٕ کِنؠ چُھس بہٕ خۅشی سان پنُن دِفاع کران۔   مےٚ چُھ یقین زِ توٚہؠ بوزیٚو میانؠ کتھ تہٕ مےٚ سٟتؠ کٔریٚو انصاف۔  
\v 11 توٚہؠ چُھو زانان زِ مےٚ گےَ نہٕ خدا سنٛز عبادت کرنہٕ باپتھ یروشلم گٔمتِس باہ دوٚہہ زیادٕ۔  
\v 12 کانٛہہ ہیٚکہ نہٕ ونِتھ زِ یمو کیاہ آسہٕ بہ ہیکل کٮ۪ن دربارن منٛز کانٛسہِ سٟتؠ بحث کران وُچھمُت تکیازِ مےٚ کوٚر نہٕ تہِ۔   کانٛہہ ہیٚکہ نہٕ یہ ونِتھ زِ یمو کیاہ آسہٕ بہٕ کُنہ یہُودؠ عبادت گاہس منٛز لوٗکن اتھِ بوال کران یا یروشلمس منٛز کُنہ تہِ جایہ مصیبتس منٛز کانٛسہ مبتلا کران وُچھمُت۔   تکیازِ مےٚ کوٚر نہٕ تہِ۔  
\v 13 لہٰذا ہیٚکن نہٕ یِم توٚہہ نِش تمہ کتھٕ ثٲبت کرِتھ یِمن متعلق یِم وُنہ کٮ۪ن مےٚ پیٚٹھ الزام لاگان چھِ۔  
\p
\v 14 مگر بہٕ چُھس توٚہہ برُونٛہہ کنہِ تسلیم کران زِ یہ چُھ پوٚز زِ بہٕ چُھس تتھ طریقس پیٚٹھ خدایہ سنٛز عبادت کران یتہ طریقس پیٚٹھ میانؠ جدٕاجداد عبادت کران ٲسؠ۔   یہ چُھ پوٚز زِ بہٕ چُھس تتھ طریقس پیٚٹھ عمل کران یُس یسوعؔ ہن أسؠ ہیٚچھنٲوؠ مٕتؠ چھِ۔   بہٕ چُھس پرٛتھ تتھ چیزس پیٚٹھ یقین تھاوان یمہ موسیٰؔ ہن تِمن ضٲبطن منٛز لیکھمٕتؠ چھِ یمہٕ خداین تس دِتمٕتؠ چھِ تہٕ سُہ پرٛتھ اکھ چیٖز یُس باقی نبیو پننٮ۪ن کتابن منٛز لیٚوکھمُت چُھ۔  
\v 15 مےٚ چھےٚ پژھ،  یتھ کنؠ زن یِم نفر تہِ پژھ تھاوان چھِ،  زِ اکہ دوٚہہ کرِ خدا تس پرٛتھ اکِس زنٛدٕ یُس گُذریومُت آسہ،  دوٚنوے سُتہ یُس رُت آسہ تہٕ سُتہ یُس بدکار آسہ۔  
\v 16 تکیازِ مےٚ چھےٚ پژھ زِ سُہ دوٚہہ ییہِ،  بہٕ چُھس ہمیشہ تہِ کرنٕچ کوشش کران یہ خدایس پسنٛد چُھ تہٕ یتھ باقی لوٗکھ صحیی زانان چھِ۔  
\p
\v 17 واریہن ورین دویمیٚن جاین روزنہٕ پتہٕ آس بہٕ یروشلم واپس تاکہ پننٮ۪ن یہُودؠ سٲتھیٚن باپتھ انہٕ کینٛہہ پونٛسہٕ یمہ غریب چھِ۔  
\v 18 آسیہؔ کیٚو کینٛژو یہُودیٚو وچُھس بہٕ ہیکل کِس صحنس منٛز یہ رسٕم ادا کرنہٕ پتہٕ یۅسہ کانٛسہ خدایس عبادت کرنُک اِجازت دوان چُھ۔   مےٚ سٟتؠ ٲس نہٕ کانٛہہ تہِ جماتھ،  تہٕ نہ اوسسکھ بہٕ لوٗکھ ہنگامہٕ کرناوان۔  
\v 19 مگر تِمے چھِ آسیہ صوبٕکؠ تِم یہُودؠ یمو لوٗکن منٛز فساد تُل۔   تِم گٔژھؠ تیٚلہ یتی توٚہہ برُونٛہہ کنہ آسٕنؠ مےٚ الزام دِنہٕ خٲطرٕ اگر تِم زانان چھِ زِ مےٚ چُھ کینٛہہ غلط کوٚرمُت۔  
\p
\v 20 ووٚنؠ یودوے تِم یہ چھنہٕ کرُن یژھان تہٕ یِم یہُودؠ نفر یمہٕ یتہِ چھِ ؤنِن توٚہہِ زِ تِم کیاہ چھِ سمجھان زِ مےٚ کیاہ غلط کوٚر ییٚلہ مےٚ تہنٛزِ مجلسہِ منٛز پننہِ پانُک بچاو کوٚر۔  
\p
\v 21 تِم ہیٚکن ونِتھ زِ مےٚ کوٚر کہتام غلط ییٚلہ بہٕ نالان اوسُس،  "از چُھو توٚہؠ مےٚ پیٚٹھ انصاف کران تکیازِ مےٚ چھےٚ پژھ زِ خدا کرِ تِمن تمام لوٗکن دوبارٕ زنٛدٕ یمہ گُذریمٕتؠ چھِ"
\p
\v 22 فیلِکسؔ اوس گۅڈے تتھ متعلق واریاہ کینٛہہ زانان یتھ لوٗکھ "وتھ" ٲسؠ ونان۔   لہٰذا رُکٲو تٔمؠ کاروٲیی۔   تٔمؠ ووٚن تِمن،  "ییٚلہ پتہٕ کمانڈر لوسیاسؔ یور واتہِ تہٕ پتہٕ دمہٕ بہٕ یمہِ مقدِمُک فٲصلہٕ"
\v 23 پتہٕ ووٚن تٔمؠ پولُسؔ سنٛز پہرٕدٲری کرن وٲلِس افسرس پولُسؔ نِن واپس قٲد خانس منٛز تہٕ یہ کتھ بناو یقینی زِ پولُسؔ چُھ پرٛتھ وزِ پہرٕدٲری منٛز۔   مگر تٔمؠ ووٚن تمِس یتہِ زِ پولُسؔ چُھنہٕ زنجیرن گنڈِتھ تھاوُن،  تہٕ اگر امسنٛدؠ دوس أمِس ملاقاتس یِن تہٕ افسر گژھِ تِمن ملاقات دیُن زِ تمہٕ کرن پولُسسؔ پرٛتھ رنگہٕ مدد یہ تِم یژھان چھِ۔  
\p
\v 24 کینٛژِ دوٚہؠ پتہٕ آو فیلِکسؔ پنٕنؠ خاندارِنؠ دروسِلؔہ ہس سٟتؠ واپس یۅسہ اکھ یہُودیہ ٲس تہٕ پولُسؔ انُکھ تس سٟتؠ کتھ کرنہٕ باپتھ۔   فیلِکسنؔ ؔ بوز سۅ کتھ یۅسہ پولُسنؔ تمِس یسوع مسیحؔ ہس پیٚٹھ بھروسہٕ کرنس متعلق ؤنؠ۔  
\v 25 پولُسنؔ کٔر أمِس سٟتؠ تمِس متعلق کتھ یۅسہ خدا یژھان چُھ زِ لوٗکھ گژھن تمِس خۅش کرنہٕ باپتھ کرٕنؠ۔   تٔمؠ کٔر یمہِ کتھ،  ہنحز تہِ وضاحت زِ لوٗکھ کِتھٕ کنؠ گژھن قوبو یِنؠ کرنہٕ زِ تِم کِتھٕ کنؠ کرن کٲم تہٕ اکھ وقت واتہِ ییٚلہ خدا تمام لوٗکن سٟتؠ انصاف کرِ۔   فیلِکسؔ کھۅژ یہ بوزِتھ،  اوٕ موٚکھ ووٚن تٔمؠ پولُسسؔ،  "ووٚنؠ چُھس بہٕ بس یُتےٕ بوزُن یژھان۔   ییٚلہ مےٚ بیٚیہِ وقت میلہ بہٕ ونے ژےٚ وۅلہٕ مےٚ نِش یہ دوبارٕ۔  
\p
\v 26 فیلِکسسؔ ٲس امید زِ پولُسؔ دییہِ تس کینٛہہ پونٛسہٕ،  لہٰذا اوس سُہ بار بار پولُسسؔ پانس نِشہٕ بُلاوان۔   پولُسنؔ کٔر کٔژِ پھرِ فیلِکسس سٟتؠ کتھ،  مگر تٔمؠ دِیُت نہٕ فیلِکسؔ کانٛہہ تہِ پونٛسہٕ،  تہٕ فیلِکسنؔ ووٚن نہٕ پننٮ۪ن سِپہَن پولُسؔ قٲدٕ منٛزٕ یلہٕ تراونہٕ باپتھ۔  
\p
\v 27 ییٚلہ زٕ وری پتھ کُن گےَ تہٕ پُرکِیس فیستسؔ سپُد فیلِکسؔ سنٛز جایہ گورنر مقرر۔   فیلِکسنؔ تھوو پولُسؔ قٲدسےٕ منٛز تکیازِ سُہ اوس یہُودؠ زِٹھیٚن خۅش تھاون یژھان۔
\c 25
\p
\v 1 فیستسؔ لوٚگ گورنر سنٛدِ حثیتہٕ صوبس پیٚٹھ حکومت کرنہِ۔   ترییہِ دوٚہؠ پتہٕ دراو سُہ قیصریہ شہرٕ منٛزٕ تہٕ ووت یروشلم۔  
\v 2 تتہِ آے سردار کاہن تہٕ باقی یہُودؠ رہنما تہٕ گےَ فیستسؔ برُونٛہہ کنہِ کھڑا تہٕ ووٚنہس زِ پولُسنؔ کرِ واریاہ غلط کامہ۔  
\v 3 تِمو ووٚن بانٛبرِ منٛزےٕ فیستسؔ،  زِ سُہ انہ پولُسسؔ مقدِمہ باپتھ یروشلم۔   مگر تمہٕ ٲسؠ پٔزؠ پٲٹھؠ تمِس پیٚٹھ وتہِ منٛزےٕ حملہٕ کرنُک تہٕ سُہ مارنُک منصوبہ بناوان.
\p
\v 4 فیستسنؔ دیُتنکھ خواب،  "پولُسؔ چُھ قیصریہ ہس منٛز پہرٕدٲری اندر،  تمِس دِیو تٔتؠ روزنہٕ۔   بہٕ گژھٕ پانہٕ جلدےٕ قیصریہ"
\v 5 تہٕ تمؠ ووٚن،  "تہٕ توٚہہ پزِ مےٚ سٟتؠ تور یُن،  یُس توٚہہ منٛزٕ تتھ لایکھ آسہ۔   اگر توٚہہ پولُسسؔ پیٚٹھ الزام لاگنہٕ خٲطرٕ کینٛہہ چُھ تہٕ توٚہؠ ہکیٚو تتہِ سُہ لٲگِتھ۔  
\p
\v 6 فیستسؔ رود یروشلمس منٛز ہیکل کیٚن قٲیِدن سٟتؠ مزید ٲٹھن یا دہن دوٚہُن۔   پتہٕ گو سُہ قیصریہ شہر واپس۔   بیٚکہ دوٚہہ دیُت فیستسنؔ حکم زِ پولُسؔ أنوون مےٚ نِش،  یتہِ سُہ منصف سنٛدِس تختس پیٚٹھ بیوٹھ۔  
\v 7 ییٚلہ پولُسؔ منصفس برُونٛہہ کُن اننہٕ آو تہٕ یہُودؠ رہنما یمہ یروشلم پیٚٹھٕ آمٕتؠ ٲسؠ گےَ واریاہ سنگین اِلزام لاگنہِ باپتھ تس انٛدؠ انٛدؠ جمع مگر تِمو منٛزٕ ہیٚوک نہٕ تِمو اکھ تہِ ثٲبت کرِتھ۔  
\v 8 پتہٕ ووٚن پولُسنؔ پننہِ طرفہٕ۔   تمؠ ووٚن،  "مےٚ کٔر نہٕ یہُودینؔ ہنٛدس قانونس خلاف کانٛہہ تہِ کٲم،  نہ ہیکلس خلاف تہٕ نہ بادشاہس خلاف"
\p
\v 9 مگر فیستسؔ اوس یہُودؠ رہنماہن خۅش تھاوُن یژھان،  اوٕ کِنؠ پرُوژھ تٔمؠ پولُسسؔ،  "کیاہ ژٕ چُھکھا یروشلم گژُھن یژھان تاکہِ بہٕ کرٕ تِمن چیزن متعلق تتہِ چون فٲصلہٕ؟"
\v 10 پولُسنؔ دِتُس جواب،  "نہ،  بہٕ چُھس ووٚنؠ ژےٚ برُونٛہہ کنہِ کھڑا،  یُس بادشاہ سنٛز نمایندگی کران چُھ۔   یہ چھےٚ سۅ جاے یتہِ میٚون فٲصلہٕ سپدُن گژھِ۔   مےٚ کٔر نہٕ یہُودؠ لوٗکن سٟتؠ کانٛہہ غلط کٲم یہ توٚہؠ اصٕل پٲٹھؠ زانان چُھو۔  
\p
\v 11 اگر مےٚ کانٛہہ تِژھ کٲم کرمٕژ آسہ یتھ موت شوبہِ تہٕ بہٕ کرٕہا نہٕ مرنس انکار۔   مگر تِژھ کتھےٕ چھیٚنہٕ زِ تِم ہیٚکن مےٚ کانٛہہ اِلزام لٲگِتھ یُتھ زِ امہِ نویتکہِ سزہُک مستحق بنہٕ۔   تِمن اطمنان دنہٕ باپتھ ہیٚکہِ نہٕ مےٚ کانٛہہ مزمت کرِتھ۔   بہٕ چُھس یژھان زٕ قیصر گژھِ پانہٕ میٚون فٲصلہٕ کرُن۔  
\v 12 ییٚلہ فیستسنؔ پننٮ۪ن مشیرن سٟتؠ کتھ باتھ کٔر تہٕ تٔمؠ ووٚن،  "ژےٚ کوٚرُتھ قیصرسؔ درخواست،  لہٰذا گژھکھ ژٕ قیصرسؔ نِش"
\p
\v 13 واریہو دوٚہو پتہٕ ووت بادشاہ ہیرودیس اگرِپاؔ پنٕنؠ بیٚنہِ برنیس ہیٚتھ قیصریہ۔   تِم ٲسؠ فیستسؔ عزت افزٲیی پیش کرنہِ آمٕتؠ۔  
\v 14 بادشاہ اگرِپاؔ تہٕ برنیس رودؠ واریہن دوٚہُن قیصریہؔ ہَس منٛز۔   کینٛہہ کال گٔژھِتھ ووٚن فیستسنؔ پولُسسؔ متعلق اگرِپاہَسؔ۔   تٔمؠ ووٚن،  "یتہِ چُھ اکھ نفر یُس فیلِکسنؔ قٲد اوس کوٚرمُت۔  
\v 15 ییٚلہ بہم یروشلم گوس تہٕ سردار کاہن تہٕ یہُودؠ رہنما آے مےٚ نِش تہٕ کوٚرُکھ درخواست زِ أمِس دِیو سزاے موت۔  
\v 16 مگر مےٚ ووٚن تِمن زِ ییٚلہ کانٛسہِ پیٚٹھ سنگین جُرمن ہُنٛد اِلزام لاگنہٕ آمُت آسہ تہٕ رومین ہُنٛد چُھنہٕ یہ دستور زِ تِم دِن جلدےٕ کانٛسہِ شخصس سزا۔   امہِ بجایہ چھِ أسؠ مُلزِمس اِجازت دِوان زِ سُہ ییہِ الزام لاگن والیٚن برُونٛہہ کُن اننہٕ تہٕ یہ کینٛژھا تِم تس خلاف ونان آسن سُہ کرِ تمیُک کرِ دِفاع۔  
\p
\v 17 چناچہِ ییٚلہ تِم یہُودؠ یور قیصریہ وٲتؠ تہٕ مےٚ کوٚر نہٕ تختس منٛز کانٛہہ تہِ تٲخیر۔   تہنٛدِ ینہٕ پتہٕ بیٚیہِ دوٚہہ بیوٹھُس بہٕ منصف سنٛدِس منصبس پیٚٹھ تہٕ سِپہن دِتُم حکم زِ تِم انن قٲدؠ یس حٲضر۔  
\v 18 مگر ییٚلہ یہُودؠ بزرگو مےٚ ووٚن زِ قٲدی نفرن کیاہ غلط چُھ کوٚرمُت تہٕ مےٚ باسییہِ نہٕ تِہنز کتھ سنٛجیدٕ۔  
\v 19 امہِ بجایہ کوٚر تِمو تس سٟتؠ پننِس مذہبس متعلق بحث تہٕ یسوع ناوٕ کِس اکِس گزریمتِس شخصس متعلق یس متعلق پولُسنؔ ووٚن زِ سُہ چُھ زنٛدٕ۔  
\v 20 مےٚ آسہٕ نہٕ یمہٕ کتھٕ سمجھی یوان زِ پزر کِتھٕ کنؠ زانہٕ۔   اوٕ کِنؠ پرُوژھ مےٚ پولُسسؔ،  "کیا ژٕ چُھکھا یروشلم گژُھن یژھان،  تاکہ بہٕ کرٕ تتہِ یمن چیزن متعلق چون فٲصلہٕ؟
\p
\v 21 مگر پولُسنؔ چُھ پننہِ مقدمکہِ فٲصلُک درخواست پانہٕ قیصریہ نِش ترومُت،  اوٕ کِنؠ کوٚر مےٚ تس حکم زِ یۅتام نہٕ بہٕ سُہ قیصریہ ہس نِش سوزن تۅتام تھٲوون سُہ حفاظتس منٛز۔  
\v 22 پتہٕ ووٚن اگرِپاہنؔ فیستسؔ،  بہٕ چُھس پانہٕ بوزُن یژھان زِ یہ نفر کیاہ چُھ ونُن یژھان۔   فیستسنؔ دیُت جواب،  "بہٕ کرٕ پگہےٕ توٚہہِ تہِ بوزناونُک انتظام"
\p
\v 23 بیٚکہِ دوٚہہ سپٕدؠ اگرِپاؔ تہٕ برنیسؔ عدالت کِس حالس منٛز دٲخٕل تہٕ باقی سٲری لوٗکھ ٲسؠ تِہنٛدس تعظیمس منٛز کھڑا۔   قیصریہ سنٛدؠ کینٛہہ رومی کمانڈر تہٕ کینٛہہ اہم نفر آے تس سٟتؠ۔   پتہٕ دیُت فیستسنؔ محافظن حکم زِ پولُسؔ کٔرؠ وون حٲضر۔  
\v 24 پولُسؔ اندر دٲخل سپدنہٕ پتہٕ ووٚن فیستسنؔ،  "بادشاہ اگرِپا تہٕ باقی سٲری لوٗکھ یمہ یتہِ چھِ،  توٚہؠ چھون یہ نفر وُچھان! یروشلم تہٕ یتہِ کیٚو واریہو یہُودؠ رہنماہو ووٚن مےٚ زِ یمِس نفرس مہٕ دِیو مذید زندٕ روزنہٕ۔  
\p
\v 25 مگر مےٚ میٚول نہٕ تیٚوتھ کینٛہہ یہ أمؠ سزایہ موتس لایق کوٚرمُت اوس۔   امہِ باوجود کوٚر أمؠ قیصریہس پننہِ مقدِمُک فٲصلہٕ کرنُک درخواست،  لہٰذا کوٚر مےٚ یہ رومؔ سوزنُک فٲصلہٕ۔  
\v 26 مگر مےٚ چُھنہٕ فکرِ تران زِ بہٕ کیاہ لیٚکھٕ أمِس متعلق بادشاہس۔   اوٕ کِنؠ اوٚن مےٚ یہ یور تاکہ توٚہہ سارنی خاص طور توٚہہِ،  بادشاہ اگرِپاؔ! مےٚ کوٚر یہ اوٕ موٚکھٕ زِ توٚہؠ کٔریو أمِس سوال۔   پتہٕ ترِ مےٚ فکرِ زِ بادشاہس کیاہ چُھ لیٚکھُن۔  
\v 27 میٚون خیال چُھ زِ کانٛہہ قٲدی رومہٕ کِس بادشاہس نِش یہ وننہٕ بغٲرےٕ سوزُن چُھنہٕ منٲسب زِ لوٗکو ووٚن أمؠ چھےٚ یمہ غلط کامہ کرِمژٕ"
\c 26
\p
\v 1 پتہٕ ووٚن اگرِپاہنؔ پولُسسؔ،  "ووٚنؠ چھی ژےٚ أسؠ پننہِ طرفہٕ بولنُک اجازت دِوان" پتہٕ پھٔہلوو پولُسنؔ پنُن اتھٕ نیٚبر یہ باس دنہٕ باپتھ زِ سُہ چُھ کتھ کرن وول۔   تمؠ ووٚن، 
\v 2 "بادشاہ اگرِپا،  بہٕ چُھس از پنُن پان خۅش قسمت زانان زِ بہٕ ہیٚکہٕ توٚہہ ویژھنٲوِتھ زِ یہُودی رہنما کیازِ چھِ غلط ییٚلہ تِم ونان چھِ زِ مےٚ چھےٚ بُرٕ کامہِ کرِمژٕ۔  
\v 3 بہٕ چُھس زیادٕ خۅش قسمت اوٕ کِنؠ تکیازِ توٚہؠ چُھو اسہِ یہُودینؔ ہنٛدؠ رسمہٕ ریواجن تہٕ تِمن سوالن متعلق سورےٕ کینہٛہ زانان یِمن متعلق أسؠ بحث کران چھِ۔   اوٕ کِنؠ چُھسو بہٕ توٚہہِ ونان زِ میانؠ کتھ بوزیٚو صبرٕ سان۔  
\p
\v 4 میانؠ تمام یہُودؠ سٲتھی چھِ زانان زِ مےٚ کِتھٕ کنؠ گُذٲر تمہِ وقتہٕ پیٚٹھٕ پنٕنؠ زندگی ییٚلہِ بہٕ شُرے اوسُس۔   تِم چھِ زانان زِ بہٕ کِتھٕ پٲٹھؠ رودُس تتھ شہرس منٛز یتہٕ بہٕ زاس تہٕ تمہ،  پتہٕ یروشلمس منٛز تہِ۔  
\v 5 تمہ چھِ مےٚ گۅڈٕ پیٚٹھےَ زانان تہٕ اگر تِم یژھن تہٕ تِم ہیٚکن توٚہہِ ونِتھ زِ ییٚلہ بہٕ سیٚٹھاہ لۅکُٹ اوسُس مےٚ پٲلؠ پننہِ مذہبٕکؠ مشکِل ترین رسم تہٕ قٲیِدٕ واریاہ احتیاط سان۔   بہٕ اوسُس باقین فریسین ہنٛدؠ پٲٹھؠ روزان۔  
\p
\v 6 از چُھ مےٚ خلاف مقدِمہ چلان حالانکہ مےٚ چُھ یقین زِ خدا کرِ تی یمیُک تٔمؠ سانین جدٕاجدادن سٟتؠ وعدٕ کوٚرمُت چُھ۔  
\v 7 سٲنؠ باہ یہُودؠ قبیلہٕ  تہِ چھِ یقینہٕ سان انتظار کران زِ خدا کرِ سانہِ باپتھ تی یمیُک تٔمؠ وعدٕ کوٚرمُت چُھ،  تکیازِ تِم چھِ دوٚہہ رات تمِس عبادت تہٕ تعظیم کران۔   عزت ماب بادشاہ،  بہٕ چُھس پوٗرٕ یقینہٕ سان امید کران زِ خدا کرِ تی یمیُک تمؠ وعدٕ کوٚرمُت چُھ،  تہٕ تِمن تہِ چُھ یقین! مگر یہ چُھ تہٕ یمیُک بہٕ خدایس نِش توقع کران چُھس زِ تِم ونن زِ مےٚ کوٚر غلط۔  
\v 8 توٚہہ منٛزٕ کیازِ سونٛچہ کانٛہہ زِ خدا ہیٚکہ نہٕ موٚردن زندٕ کرِتھ۔  
\p
\v 9 گۅڈٕ اوس سُتہ اکھ وقتا ییٚلہ میٚتہِ یقین اوس زِ بہٕ کرٕ ناصریؔ شہرٕ کیٚن لوٗکن یسوعسؔ پیٚٹھ ایمان اننَس رُکاونٕچ ہر ممکن کوشش۔  
\v 10 ییٚلہ یروشلمس منٛز روزان اوسُس تہٕ مےٚ کوٚر تی۔   مےٚ کٔرؠ واریاہ ایمان وٲلؠ قٲدس منٛز بنٛد،  یتھ کِنؠ مےٚ تتہِ کیٚو کاہنو تہِ کرنُک اختیار دیُتمُت اوس۔   تہٕ ییٚلہ تِہنٛدیٚو لوٗکو ایمان وٲلؠ قتٕل کٔرؠ،  تہٕ مےٚ دِژ تمہِ کِس حقس منٛز راے۔  
\v 11 مےٚ دیُت تِمن یہُودینؔ پرٛتھ عبادت گاہس منٛز سزا یتہِ بہٕ تمہ وُچھان اوسسکھ۔   بہٕ اوسسَکھ تِم مجبوٗر کران پنُن پوٗرٕ شرارت ہٲوِتھ زِ تِم کٔرِنؠ خدایہ سنٛز توہین،  بیٚیہِ ؤنِن تمسنٛدِ ناوٕ ردبد۔   حطاکہ بہٕ اوسسکھ تِم باقی شہرن منٛز تہِ ژھانڈان تاکہ پننہِ طاقتہٕ سٟتؠ تمہ رُکاونٕچ کرٕ بہٕ پرٛتھ ممکن کوشش۔  
\p
\v 12 "سردار کاہنو دیُت مےٚ دمشقس منٛز ایمان وٲلؠ گرفتار کرنُک پوٗرٕ اختیار،  تہٕ بہٕ گوس تورؠ۔   مگر ییٚلہ بہٕ پننہِ وتہِ پیٚٹھ اوسُس، 
\v 13 دوپہرس بٲگؠ،  اے بادشاہ،  مےٚ وُچھ وتہِ منٛز آسمانس پیٚٹھ اکھ تابہٕ وُن نوٗر۔   یہ اوس آفتابہٕ کھۅتہٕ تہِ پریٚزلوُن! یہ اوس مےٚ ژۅپٲرؠ چمکان،  تہٕ تِمن انٛدؠ پٔکؠ تہِ یٕ مےٚ سٟتؠ سفر ٲسؠ کران۔  
\v 14 أسؠ آے سٲری پتھر لاینہٕ۔   پتہٕ گییہ مےٚ کنن کہنٛز تام آواز یُس عبرٲنؠ زبٲنؠ منٛز ونان اوس۔   تٔمؠ ووٚن،  "اے ساوُل،  ساوُل،  ژٕ پزی نہٕ مےٚ خلاف لڈُن؟ چانہِ خٲطرٕ چُھ یہ مشکِل زِ ژٕ تھاوکھ ضمیرٕچ آواز دبٲوِتھ۔  
\p
\v 15 پتہٕ ووٚن مےٚ،  "خداوند،  توٚہؠ کم چُھو؟" تہٕ خداوندن ووٚن،  "بہٕ چُھس یسوعؔ! بہٕ چُھس سُے یمِس خلاف ژٕ لڑان چُھکھ۔  
\v 16 مگر وۅتھ پننٮ۪ن زنٛگن پیٚٹھ روز وۅدٕنؠ۔   بہٕ گوس ژےٚ برُونٛہہ کنہ ظٲہِر،  اوٕ موٚکھٕ حٲضر زِ ژٕ بناوتھ بہٕ اکھ خٲدم تہٕ بیٚیہِ گواہ تتھ یہ ژےٚ وُچِھتھ تہٕ یہ ژٕ مےٚ متعلق وُنہ کٮ۪ن زانان چُھکھ تہٕ یہ بہٕ ژےٚ پتہٕ ہاوے۔  
\v 17 بہٕ بچاوتھ ژٕ تِمن لوٗکن تہٕ غٲر یہُودینؔ نِش یِمن نِش بہٕ ژٕ سوزتھ
\v 18 تاکہ تِہنٛزٕ أچھ ین مُژرنہٕ،  تِم انکھ انہِ گٹہِ منٛزٕ کٔڑتھ گاشس کُن تہٕ شیطان سنٛدِ طاقتہٕ نِشہٕ خدایہ سنٛزِ وتہِ کُن۔   یتھ کنؠ کرِ خدا تِہنٛدؠ گناہ معاف تہٕ تِمن دییہِ تمہ چیز یمہ میانٮ۪ن لوٗکن ہمیشہ باپتھ میسر آسن۔   تِمہ لوٗکھ یمہ ایمانداری سان مےٚ سٟتؠ تعلُق تھاوان چھِ۔  
\p
\v 19 اے بادشاہ اگرِپا،  مےٚ کوٚر تی یہ خداین مےٚ آسمانس منٛز کرُن ووٚن۔  
\v 20 گۅڈٕ کٔر مےٚ دمشق کیٚن یہُودینؔ سٟتؠ پتہٕ یروشلمس منٛز روزن والیٚن تہٕ تمہِ پتہٕ یہُودیہ کیٚن تمام گامن منٛز تہٕ تتہِ کیٚن غٲر یہُودؠ لوٗکن سٟتؠ تہِ کٹھ۔   مےٚ ووٚن تِمن زِ تِم تراون گناہ کرٕنؠ تہٕ خدایس منٛگن مدد۔   مےٚ ووٚن تِمن یتہِ زِ تِم کرن سۅ کٲم یمہِ سٟتؠ ننہِ زِ تِمو چھِ،  گناہ کرٕنؠ ترٲومٕتؠ۔  
\p
\v 21 یہ چُھ اوٕ موٚکھٕ تکیازِ مےٚ بوزٕ نٲوؠ یہ پٲغام ییٚلہ بہٕ ہیکل کِس صحنس منٛز اوسُس تہٕ کینٛژو یہُودیٚو رۅٹُس بہٕ ہیٚوتہَس بہٕ مارُن۔  
\p
\v 22 مگر خدا چُھ مےٚ مدد کران توے تہِ رودُس بہٕ از تام یِمن کتھن ہُنٛد اعلان کران۔   مےٚ تھوو عامن تہٕ خاص لوٗکن دوٚنونؠ یہ ونُن جٲری یہ نبیو تہٕ موسیٰؔ ہن ونمُت چُھ۔  
\v 23 تِمو ووٚن زِ مسیحؔ تُلہ دۅکھ تہٕ مرِ سُہ آسہ گۅڈنیُک یُس مٔرِتھ زنٛدٕ سپدِ۔   تِمو ووٚن یتہِ زِ سُہ کرِ پننٮ۪ن لوٗکن تہٕ غٲر یہُودؠ لوٗکن دوٚنونؠ برُونٛہہ کنہِ اعلان زِ خدا چُھ پٔزؠ پٲٹھؠ تِمن بچاونٕچ قدرت تھاوان۔  
\p
\v 24 امہِ برُونٛہہ زِ پولُسؔ ونہ،  ہے بیٚیہِ تہِ کینٛہہ،  فیستسنؔ ووٚن کریکھ دِتھ بڈِ: " پولُسؔ،  ژٕ چُھکھ پاگل گمُت۔   ژےٚ چھی واریاہ پوٚرمُت یمؠ ژٕ پاگل بنومُت چُھکھ۔  
\v 25 مگر پولُسنؔ دِتُس جواب،  "مہربان فیستسؔ،  بہٕ چُھس نہٕ پاگل۔   بلکہِ یہ بہٕ ونان چُھس تہِ چُھ پزر تہٕ بلکُل سمجدٲری!
\v 26 تکیازِ بادشاہ اگرپا چُھ یمہٕ کتھٕ زانان یِمن متعلق بہٕ کتھ کران چُھس تہٕ بہٕ ہیٚکہ یِمن سٟتؠ اتھ متعلق کُھلہٕ ڈولہٕ کتھ کٔرِتھ۔   مےٚ چُھ یقین زِ امہِ منٛزٕ روزِ نہٕ کانٛہہ تہِ چیز اہنٛدِ توجہ نیٚبر۔   تکیازِ یمو منٛزٕ چُھنہٕ کانٛہہ تہِ چیز ژورِ ژورِ سپُدمُت۔  
\p
\v 27 بادشاہ اگرِپا،  کیاہ توٚہہ چُھوا یقین کران یہ نبیو لیٚوکھمُت چُھ؟ بہٕ چُھس زانان زِ توٚہؠ چُھو یِمن کتھن پیٚٹھ یقین تھاوان"
\v 28 پتہٕ دیُت اگرِپاہنؔ پولُسسؔ جواب،  "بس کمسےٕ کالس منٛز کوٚرووس بہٕ توٚہہ مسیحیؔ بننَس پیٚٹھ آمادٕ"
\v 29 پولُسنؔ دِتُس جواب،  "اتھ منٛز کم وقت لٔگؠ تن یا زیادٕ،  امہِ سٟتؠ پییہِ نہٕ کانٛہہ تہِ فرق۔   بہٕ چُھس خدایس کُن دُعا کران زِ توٚہؠ تہٕ تِم تمام لوٗکھ یِم از میانؠ کتھ بوزان چھِ،  بنن یمو زنجیرو بغٲر میٚی ہی!
\p
\v 30 پتہٕ وُتھ بادشاہ تھوٚد،  گورنر،  برنیسؔ تہٕ باقی تہِ ؤتھؠ تھوٚد، 
\v 31 تہٕ دراے کمرٕ منٛزٕ نیٚبر۔   نیرنہٕ پتہٕ ووٚن تِمو اکھ اکِس،  "أمؠ نفرن چھنہٕ تِژھ کانٛہہ کٲم کرمٕژ یۅسہ موتس لایق چھےٚ یا یِمن زنجیرن لایکھ"
\v 32 اگرِپاہنؔ ووٚن فیستسؔ اگر نہٕ أمؠ شخصن قیصریہس اپیل کرمٕژ آسہ ہے تہٕ یہ ییہِ ہے رِہا کرنہٕ۔
\c 27
\p
\v 1 ییٚلہ گورنرن فٲصلہٕ کوٚر زِ أسؠ پکناوو اٹلی کُن جہازٕ تہٕ تٔمؠ کوٚر پولُسؔ تہٕ باقی کینٛہہ قٲدؠ یولیسؔ ناوٕ کِس اکِس فوجی کپتانس حوالہٕ۔   سُہ اوس صوبہ دار سنٛدِس عہدس پیٚٹھ فٲیز تہٕ سُہ اوس سِپہن ہنٛدس اکِس تعدادس منٛز شٲمل یمہِ سیدِسیٚود بادشاہ سنٛزِ ماتہتی منٛز ٲسؠ۔  
\v 2 أسؠ گے۔   آسیہؔ صوبہٕ کِس ادرمُتیمؔ شہرٕ پیٚٹھٕ جہازس منٛز سوار. یہ جہازٕ اوس آسیہؔ سمندر بٹھِس پیٚٹھ موجود جایو کِنؠ سفر کرن وول۔   یتھٕ پٲٹھؠ ؤتھؠ أسؠ سمندری سفرس۔   مکدُنیہ ہُک ارسترسخُسؔ دراو تھِسلُنِیکے پیٚٹھٕ اسہِ سٟتؠ۔  
\p
\v 3 بیٚکہِ دوٚہہ وٲتؠ أسؠ صیداؔ۔   یولیسنؔ کٔر پولُسسؔ سٟتؠ ہمدردی تہٕ دیُتنس پننٮ۪ن دوستن سٟتؠ ملاقات کرنُک اجازت یمہ تس خدمت گُزاری کرہن۔  
\v 4 پتہٕ سپُد جہازٕ تتہِ پیٚٹھٕ روانہٕ۔   أسؠ گےَ کُپرس کِس بٹھِس پیٚٹھ یُس واوٕ نِشہٕ محفوظ اوس،  تکیازِ واو اوس اسہِ مخٲلف۔  
\v 5 امہِ پتہٕ وٲتؠ أسؠ سمندرس تار دِتھ کلکیہ تہٕ پمفیلیہؔ کیٚن ساحِلن نکھٕ،  جہازٕ رُکیو لوکیہ کِس مُورہؔ شہرس منٛز۔   أسؠ وتھؠ تتہِ جہازٕ منٛزٕ بوٚن۔  
\v 6 مُورہؔ ہس منٛز میٚول یولیسسؔ اکھ جہازٕ یُس اسکندریہ پیٚٹھ آمُت اوس تہٕ جلدےٕ سپدِ اٹلیؔ کُن روانہٕ۔   چناچہِ تٔمؠ کوٚر سانہِ باپتھ اتھ جہازس منٛز سوارِ ہُنٛد انتظام،  تہٕ أسؠ دراے تتہِ پیٚٹھٕ۔  
\p
\v 7 أسؠ رودؠ وار وارٕ پکان تہٕ وٲتؠ سیٚٹھاہ مُشکلی سان کنِدُسؔ شہرس نکھٕ،  تکیازِ واو اوس اسہِ مخالف اندٕ یوان۔   امہِ پتہٕ اوس واریاہ تیز واو تہٕ تمؠ دیُت نہٕ جہازس مغرب کُن سیٚود پکنہٕ۔   امہِ بجایہ رودؠ أسؠ کریت جزیرٕ کیٚو ساحِلو کِنؠ سمندری سفر کران،  یپٲرؠ نہٕ تیز ہوا پکان اوس،  تہٕ أسؠ دراے سلمونؔ برُونٛہہ کِنؠ،  یُس زمینہ ژکُل سمندرس منٛز ٹھہرِتھ چُھ۔  
\v 8 تیز واو اوس وُنہِ،  یُس جہازس تیز پکنہٕ نِشہٕ ٹھوٚر اوس کران۔   لہٰذا رودؠ أسؠ کریت کیٚن سٲحِلن سٟتؠ وار وارٕ برونٛہہ کُن پکان،  تہٕ أسؠ وٲتؠ لسیہؔ نکھٕ اکِس قصبس منٛز یتھ جان پناہ گاہ ونان چھِ۔   یہِ اوس لسَیہ شہرس نزدیک۔  
\p
\v 9 واریاہ وقت گو تہٕ ووٚنؠ اوس جہازُک سفر مشکِل بنان تکیازِ یہُودینؔ ہنٛزٕ روزٕ واژٕ انٛد تہٕ ووٚنؠ ہُرِ سمنٛدرُک طوفان۔   چناچہِ پولُسنؔ ووٚن جہاز منٛزٕ کیٚن نفرن، 
\v 10 تِمن ونُن،  اے لوٗکو،  بہٕ چُھس وُچھان زِ اگر ووٚن أسؠ جہازس منٛز پکان رودؠ تہٕ یہ بنہٕ سانہِ باپتھ تباہی ہُنٛد بٲعث،  نہ صرن سامانہ تہٕ جہازٕ باپتھ بلکہ سانہِ زندگی باپتھ تہِ"
\v 11 مگر رومی سردارن کٔر نہٕ پولُسؔ سنٛدِس وننَس پیٚٹھ پژھ۔   امہِ بجایہ کٔر تٔمؠ جہاز رانس تہٕ جہازٕ مٲلکہ سنٛدِس وننَس پیٚٹھ پژھ،  تہٕ تٔمؠ نیٚو تی کرنُک فٲصلہٕ یہ تِمو مشورٕ دتُس۔  
\p
\v 12 بنٛدرگاہ ٲس نہٕ سردی منٛز روزنہٕ باپتھ اصٕل جاے،  لہٰذا دیُت اکثر لوٗکو امہِ بجایہ سمندرس منٛز وسنُک مشورٕ۔   تِمن ٲس امید زِ تِم واتن فینیکے تہٕ تتہِ گُذارن سرٕد کال۔   فینیکے چُھ کریتُک اکھ قصبہٕ۔   اتہِ چُھ جنوب مغرب تہٕ شمال مغرب دونونی انٛدن ہُنٛد ہوا پکان۔  
\v 13 چونکہِ جنوب طرفہٕ اوس صرف ہلکہٕ واو پکان اوٕ کِنؠ سونٛچ جہازٕ کیٚو کارنٛدو زِ تِم کرن پننہِ مرضی سفر شروع۔   چناچہِ تِمو تُل سمندر پیٚٹھ لنگر تہٕ جہازٕ دراو کریت جزیرکہِ ساحلہٕ کِنؠ۔  
\p
\v 14 کمےٕ کٲلؠ پتہٕ وُتھ سمندری ساحلہٕ پیٚٹھٕ واوٕ طوفان۔   یہ وُتھ شمالہٕ اندٕ کہ جزیرٕ پیٚٹھٕ تہٕ ٹکریاو جہازس سٟتؠ۔   اتھ واوس چُھ "یورکلُون یعنی شمال مشرقی ہوا" وننہٕ یوان۔  
\v 15 سُہ ٹکریاو زورٕ سان جہازٕ کِس برونٛہِمس انٛدس سٟتؠ تہٕ أسؠ ہیٚکؠ نہٕ اتھ برُونٛہہ کنہِ درِتھ۔   لہٰذا دیُت ملاحو واوس جہازٕ تتھ طرفس کُن ننہٕ یوٚکُن واو پکان اوس۔  
\v 16 پتہٕ گو جہازٕ کودہؔ ناوٕ کہِ اکہ لۅکٹہِ جزیرچہِ سٲحلی پچہِ سٟتؠ روانہٕ۔   أسؠ بنیاے مشکِلنےٕ ناوِ محفوظ طریقہٕ جہازس سٟتؠ گنڈنس قٲبل۔  
\p
\v 17 ییٚلہِ تِمو شکٲرؠ ہیٚور کھٲج تِمو کرِ تمچہٕ رزٕ جہازچن پکھن سٟتؠ گنٛڈنہٕ باپتھ استعمال۔   تہٕ تِم کھوژؠ زِ تِم گٔژھؠ نہٕ سورتِس منٛز سیٚکہِ ٹھیلن پیٚٹھ متھنہٕ ینؠ،  امہِ کِنؠ تروو تِمو سمندرُک لنگر بوٚن تہٕ واون نی تِم پانس سٟتؠ۔  
\p
\v 18 واو تہٕ لہرٕ آسہٕ لگ بگ جہازس نژناوان۔   چناچہِ بیٚکہِ دوٚہہ لٲگؠ ملاحو تِم چیز جہاز پیٚٹھٕ بوٚن لاینؠ یمہٕ جہازٕ پکناوان اوس۔  
\v 19 طوفانکہِ تریمہِ دوٚہہ لٲگؠ ملاحو جہازٕ لوٚژراونہٕ خٲطرٕ زیادٕ پہن بادبان،  رزٕ تہٕ تھمب بوٚن لاینؠ۔   یہ کٲم کٔر تِمو پننیٚو اتھو۔  
\v 20 واریہن دوٚہُن روز تیز ژھٹھ جٲری تہٕ آسمان رود دوٚہس راتس کریٚہنہِ ابرٕ سٟتؠ ولِتھ یُتھ نہٕ اسہِ آفتاب تہٕ تارک وُچِھتھ ہیٚکؠ۔   اسہِ تراوِ زنٛدٕ بچنچہٕ سارے امیدٕ۔  
\p
\v 21 اسہِ منٛزٕ کھیٚو نہٕ واریہن دوٚہن کانٛسہِ جہازٕ منٛزٕ کھیٚنےٕ۔   پتہٕ گو اکہِ دوٚہہ پولُسؔ اسہِ برُونٛہہ کنہِ کھڑا تہٕ ونُن،  "میانیٚو دوستو،  توٚہہِ پزِ ہو میانؠ کتھ بوزُن ییٚلہِ مےٚ ونیومو زِ اسہِ پزِنہٕ کریت پیٚٹھٕ سفر کرُن تیٚلہِ پییہِ ہے نہٕ اسہِ یہ مصیبت تہٕ نقصان وچُھن۔  
\v 22 مگر ووٚنؠ چُھسو بہٕ توٚہہِ تٲکید کران زِ کھوژیٚو مہٕ بلکہِ روزِو خوش تکیازِ اسہِ منٛزٕ مرِنہٕ کانٛہہ۔   طوفان کرِ جہازس تباہ مگر أسؠ روزو زندٕ۔  
\v 23 بہٕ چُھس یہ زانان،  پتمہِ رٲژ سوز خداین یمسُنٛد بہٕ چُھس تہٕ یمِس سنٛز عبادت بہٕ کران چُھس مےٚ نِش اکھ فرشتہٕ یُس آو تہٕ مےٚ نِش رود کھڑا۔  
\v 24 فرشتن ووٚن مےٚ پولُسؔ مہٕ کھۅژ،  ژےٚ چھی رومؔ واتُن تہٕ تتہِ چھی بادشاہس برُونٛہہ کنہِ کھڑا سپدُن تاکہ سُہ کرِ چون فٲصلہٕ۔   بہٕ چُھس یژھان زِ ژٕ گژھکھ زانُن زِ خداین کٔرنے ژےٚ یہ عنایت زِ تِم سٲری لوٗکھ یمہ ژےٚ سٟتؠ جہازس منٛز سفر کران چھِ بچن سٲری"
\v 25 میانیٚو دوستو! خوش روزیٚو،  تکیازِ مےٚ چھےٚ پژھ زِ خدا کرِ یہ،  یہ تٔمؠ ووٚن۔  
\v 26 البتہٕ جہازٕ ٹکراوِ کُنہِ جزیرس پیٚٹھ وٲتِتھ تہٕ أسؠ کھسو تٔتی بٹھِس پیٚٹھ۔  
\p
\v 27 ژۅدہَن دوٚہُن ہنٛدِ طوفانہٕ پتہٕ تہِ اوس جہازٕ ادریہؔ سمندرس اپارِ نژان۔   ملاحن باسیاو قریبن نیصف رٲژ زِ جہازٕ چُھ زمینس نزدیک یوان۔  
\v 28 اوٕ موٚکھٕ ترٲو تِمو رز بوٚن تاکہٕ آبہٕ کہ سنرُک انٛدازٕ کرٕ ہَن۔   ییٚلہ تِمو رزِ بیٚیہِ واپس لوٚم،  تِمو میون یہِ تہٕ وچُھکھ آبس ژتجی میٹر سنیٚر۔   رژھ کھنٛڈ گٔژھِتھ میٚون تِمو بیٚیہِ تہٕ اتہِ وچُھکھ ترٕٛہہ میٹر۔  
\v 29 تمہٕ کھوژؠ زِ جہازٕ گوٚژھ نہٕ کُنہِ کَنہِ سٟتؠ ٹکراونہٕ یُن اوٕ کِنؠ لگٲوؠ تِمو جہاز کہِ انٛدٕ کِنؠ ژور لنگر۔   پتہٕ کوٚر تِمو دعا زِ جلدےٕ پھۅلِن گاش تاکہِ تِم وُچھہَن زِ جہازٕ کوٚت چُھ لمان۔  
\p
\v 30 کینٛہہ ملاح ٲسؠ جہازٕ منٛزٕ ژلنُک سنٛز کران۔   اوٕ کِنؠ ترٲو تِمو شکٲرؠ سمنٛدرس منٛز تاکہِ کانٛسہِ لگہ نہٕ پےَ زِ تِم کیاہ چھِ کرُن یژھان،  تِمو بنوو بہانہٕ زِ تِم چھِ جہازس برُونٛہہ کِنؠ کینٛہہ لنگر بوٚن والٕنؠ یژھان۔  
\v 31 مگر پولُسنؔ ووٚن کمانڈرس تہٕ سِپہن زِ اگر نہٕ ملاح جہازس منٛز بیٚہن تہٕ تُہنٛدِ بچنٕچ چھیٚنہٕ کانٛہہ امید۔  
\v 32 چناچہ سِپہو ژچہٕ رزٕ تہٕ ژھنِکھ شکارؠ آبس منٛز یلہٕ۔  
\p
\v 33 گاش پھۅلنہٕ برُونٛہہ پہَن ووٚن پولُسنؔ جہازس منٛز سوار سارنی نفرن کینٛہہ کھیٚنہٕ باپتھ۔   تٔمؠ ووٚن،  "پتمیٚو ژۅدہو دوٚہو پیٚٹھٕ ووتُو توٚہہِ انتظار کران،  فاقے فُقرے وُچھان۔  
\v 34 تہٕ ووٚنؠ چُھس بہٕ توٚہہِ گُذارِش کران زِ کینٛہہ غذا کھیٚیو۔   زنٛدٕ روزنہٕ خٲطرٕ پزِ توٚہہ یہ کرُن۔   تُہنٛدِس میٚی وٲلِس گژھِ نہٕ خدشہٕ"
\v 35 پولُسؔ سنٛدِ یہ وننہٕ پتہٕ ییٚلہ سٲری وُچھان ٲسؠ تُج تٔمؠ ژۅٹ تہٕ کوٚرُن تمہِ باپتھ خدایس کُن شکُر۔   پتہٕ پُھٹرٲون ژۅٹ تہٕ لٲجِن کھیٚنؠ۔  
\p
\v 36 پتہٕ سپٕدؠ سٲری خۅش تہٕ لوگُکھ غذا کھیٚون۔  
\v 37 اسہِ سٟتؠ آسہٕ کُل 274 سوارِ جہازس منٛز۔  
\v 38 ییٚلہ ساروےٕ غذا کھیٚو تہٕ باقی کٕنکھ ژھنِکھ جہازٕ لۅژراونہٕ خٲطرٕ سمندرس منٛز۔  
\p
\v 39 گاش پھۅلونےٕ ہیٚکہ ہاو أسؠ زمین وُچِھتھ مگر ملاحن اوس نہٕ معلومےٕ زِ أسؠ کتہِ چھِ۔   تاہم ٲسؠ تِم آبہٕ کِس اندس پیٚٹھ اکھ خلیج تہٕ بوڈ سیٚکہِ علاقہٕ۔   یِمو کوٚر مشورٕ جہازٕ سمندر بٹھِس کُن نِنٕچ کوشِش کرنُک۔  
\v 40 تہٕ یِمو دِتؠ لنگر سمندرس منٛز دٲرِتھ۔   أتھؠ سٟتؠ کھوجہٕ یمو رزٕ یمہٕ پتوارن گنٛڈتھ آسہٕ تہٕ برُونٛہہ کِنؠ ترووُکھ جہازٕ یلہٕ تاکہِ ہوا اژِ اتھ منٛز۔   تِمو نیٚو جہازٕ بٹھِس کُن۔  
\v 41 مگر جہازٕ رود طوفٲنی آبس کُن پکان تہٕ کھوٚت اختی سان سیٚکہِ بٔٹھِس پیٚٹھ یُس لہرن تل اوس۔   جہازُک برُونٛہِم حصہ پھسیاو تٔتھؠ منٛز تہٕ ہیٚچن نہٕ حرکتھ کرِتھ۔   پٔتؠ کِنؠ آسہٕ آبہٕ لہرٕ جہازس چھاونہٕ یوان یِمو سٟتؠ جہازٕ پھُٹنہِ لوٚگ۔  
\p
\v 42 سِپہَن اوس خیال زِ سٲری قٲدؠ ژھنووکھ مٲرتھ تاکہ کانٛہہ ہیٚکنہٕ سرانٛٹھ وٲیِتھ ژٔلِتھ۔  
\v 43 مگر فوجی کپتان اوس پولُسسؔ بچاوُن یژھان اوٕ کِنؠ رکٲوؠ تمؠ سِپاہ یہ کرنہٕ نِشہٕ۔   امہِ بجایہ دیُت تمؠ حکم زِ یُس تہِ کانٛہہ سرانٛٹھ وٲیتھ ہیٚکہِ سُہ لایہِ آبس منٛز وۅٹھ تہٕ ترِ بٔٹھِس کُن۔  
\v 44 پتہٕ ووٚن تمؠ باقین زِ جہازچہِ پچہِ یا باقی ٹُکرن پیٚٹھ کٔھسِتھ نیریٚو بٹھیٚن کُن۔   اسہِ کوٚر تی یہ تٔمؠ ووٚن،  تہٕ یتھٕ پٲٹھؠ وٲتؠ أسؠ سٲری حفاظتہٕ سان خوشکی پیٚٹھ۔
\c 28
\p
\v 1 ییٚلہ أسؠ حفاظتہٕ سان سٲحِلس پیٚٹھ وٲتؠ تہٕ اسہِ سپُد معلوم زِ یہ چُھ مالٹا ناوُک جزیرٕ۔  
\v 2 تتہِ کیٚو روزن والیٚو لوٗکو کٔر اسہِ معمولہٕ کھۅتہٕ تہِ بہتر مہمان نوٲزی۔   تِمو زول نار تہٕ دِژکھ اسہِ وُشنیر کرنہٕ باپتھ دعوت،  تکیازِ رود اوس پیٚوان تہٕ سردی تہِ ٲس۔  
\p
\v 3 ییٚلہ پولُسنؔ کینٛہہ زِنؠ ہرِ جمع کرِتھ نارس پیٚٹھ تراوِ تہٕ نارٕ تاوٕ نِشہٕ ژلنہٕ باپتھ دراو نارٕ ڈیرٕ تلہٕ اکھ زہریلہٕ سرف تہٕ دِژٕن پولُسسؔ اتھس ٹوٚپھ تہٕ رود أتی۔  
\v 4 جزیرس پیٚٹھ روزن والیٚو لوٗکو وُچھ یہ جانور پولُسسؔ اتھس الوونت تہٕ لٔگؠ اکھ اکِس وننہِ،  "یمؠ نفرن چُھ شاید کُس تام قتٕل کوٚرمُت۔   اگر یہ سمندرس پھٹنہٕ نِشہٕ بچاو مگر انصافُک دیوتا آو أمِس موت ہیٚتھ"
\p
\v 5 مگر پولُسنؔ دیُت سرف سیٚودے نارس منٛز دٲرِتھ تہٕ تس گو نہٕ کِہین۔  
\v 6 لوٗکن ٲس یہ امید زِ پولُسسؔ کھسہِ ووٚنؠ تپہٕ سٟتؠ سٲرسےٕ پانس ورم تہٕ نتہٕ پییہِ اچانک پتھر تہٕ مرِ۔   مگر واریہس کالس پرارنہٕ پتہٕ وُچھ تِمو زِ أمِس سٟتؠ سپُد نہٕ کِہین تہِ ناکارٕ۔   اوٕ کِنؠ بدلٲو لوٗکو پنٕنؠ راے تہٕ لٔگؠ اکھ اکِس وننہ،  "یہ نفر چُھنہٕ قٲتِل۔   یہ چُھ اکھ دیوتا!"
\p
\v 7 ووٚنؠ ٲس اکھ جاے یتہِ تِم ٲسؠ،  تتہِ ٲس کینٛہہ زمین یۅسہ اکِس نفرٕ سنٛز ٲس یمِس پبلیسؔ ناو اوس۔   سُہ اوس امہِ جزیرُک سردار آفیسر۔   تٔمؠ دِژ اسہِ پنُن گھرٕ ینٕچ تہٕ تتہ روزنٕچ دعوت۔   تٔمؠ کٔر اسہِ ترین دوٚہُن سیٚٹھاہ خدمت۔  
\v 8 تمہ وقتہٕ اوس پبلیسؔ سنٛدِس مٲلِس تپھ تہٕ پیچِش تہٕ سُہ اوس بسترس منٛز پیٚتھ۔   چناچہِ پولُسؔ گو تس نِش تہٕ کوٚرُن تمہ سنٛدِ باپتھ دُعا۔   پتہٕ تھٲوؠ پولُسنؔ تمِس پیٚٹھ پنٕنؠ اتھٕ تہٕ بلرووُن سُہ۔  
\v 9 پولُسؔ سنٛدِ یہ کرنہٕ پتہٕ آے جزیرٕکؠ باقی لوٗکھ یمہ بٮ۪مار ٲسؠ تمِس نِش تہٕ تٔمؠ بٔلرٲوؠ تِم تہِ۔  
\v 10 تِمو أنؠ سانہِ خٲطرٕ تحفہٕ تہِ تہٕ باقی طریقو تہِ کوٚرُکھ یہ اِظہار زِ تِم چھِ اسہِ عزت کران۔   ییٚلہ أسؠ ترییہِ ریٚتؠ پتہٕ نیرنہٕ خٲطرٕ تیار سپٕدؠ تہٕ تِمو اوٚن سانہِ باپتھ کھیٚن تہٕ باقی چیز یِمن ہنٛز اسہِ جہازس منٛز ضرورت لگہِ ہے۔  
\p
\v 11 ترین ریتن روزنہٕ پتہٕ سپٕدؠ أسؠ اکِس جہازس پیٚٹھ سوار یُس اسکندریہ پیٚٹھٕ آمُت اوس تہٕ اٹلی کُن اوس گژھن وول۔   جہازٕ کِس برونٛہمِس حصس پیٚٹھ ٲس دُوچہِ دیوتاہن ہنٛز تصویر کھنِتھ یِمن کستورؔ تہٕ پولِکسؔ ناو اوس۔  
\v 12 ییٚلہِ أسؠ سرَکُوسہؔ شہرس منٛز وٲتؠ تہٕ تتہِ ٹھہریاے أسؠ ترین دوٚہُن۔  
\p
\v 13 پتہٕ دراے أسؠ جہازس منٛز تہٕ وٲتؠ اٹلی ہنٛدِس شہر ریگیمسؔ اندر۔   بیٚکہ دوٚہہ اوس ہوہُک رۅخ جنوبس کُن،  اوٕ کِنؠ وٲتؠ أسؠ دون دوٚہُن منٛز پُتیلیؔ شہر۔   تتہِ ترُوو اسہِ یہ جہازٕ۔  
\v 14 پُتیلیؔ منٛز کوٚر اسہِ کینٛژن ایمان والیٚن سٟتؠ ملاقات یمہٕ یژھان ٲسؠ زِ أسؠ گٔژھؠ ستن دوٚہُن تِمن سٟتؠ روزٕنؠ۔   ٲخر تہٕ وٲتؠ أسؠ امہِ پتہٕ رومؔ۔  
\v 15 رومَس منٛز بوز کینٛژو سٲتھی ایمان والیٚو اسہِ متعلق تہٕ تِم آے اسہِ سمکھنہِ۔   یمو منٛزٕ سمٕکھؠ کینٛہہ اسہِ اَپیس سڑکہِ پیٚٹھ واقع بازر ناوکِس شہرس منٛز تہٕ باقےٕ سمکھیاے اسہِ ترے سراے ناوٕکِس شہرس منٛز۔   ییٚلہِ پولُسنؔ یِم ایماندار وُچھؠ،  تمؠ کوٚر خدایس کُن شکُر تہٕ بڈییس ہیٚمتھ۔  
\v 16 ییٚلہ أسؠ رومؔ وٲتؠ تہٕ پولُسسؔ میٚول کُنی زنؠ گھرِ بہنُک اجازت۔   مگر امہِ سنٛدِ حفاظتہٕ باپتھ اوس ہمیشہِ اکھ سِپاہ تعینات۔  
\v 17 پولُسؔ سنٛدِ تتہِ ترین دوٚہُن روزنہٕ پتہٕ سوز تٔمؠ یہُودؠ رہنماہن پٲغام زِ تِم یِین تہٕ کٔرِن مےٚ سٟتؠ کتھ۔   ییٚلہ،  تِم أمِس نِش وٲتؠ تہٕ پولُسنؔ ووٚن تِمن،  "میانیٚو ٹاٹھیٚو بایو،  یودوے مےٚ پننٮ۪ن لوٗکن ہنٛز مخالفت کٔرنہٕ تہِ نہٕ کٔرم پننٮ۪ن جد اجدادن ہنٛدیٚن رسمہٕ ریواجن خلاف کانٛہہ کتھ،  مگر یروشلمس منٛز رۅٹہس بہٕ پننیٚو قٲعِدو۔   مگر امہِ برُونٛہہ زِ تِم مارٕہن مےٚ،  أکؠ رومی کمانڈرن بچووُس بہٕ تہٕ پتہٕ سوزنس بہٕ رومی حٲکمن نِش قیصریہ کِس شہرس منٛز تاکہِ مےٚ خلاف ییہِ مقدِمہ چلاونہٕ۔  
\v 18 رومی حٲکمو کٔر مےٚ پرژھٕ غٲر تہٕ ٲسؠ مےٚ یلہٕ تراوُن یژھان تکیازِ مےٚ ٲس نہٕ کانٛہہ غلط کٲم کٔرمٕژ یمہِ کِنؠ مےٚ سزاے موت میلِتھ ہیٚکہِ ہے۔  
\v 19 مگر ییٚلہ،  تتہِ کیٚو یہُودؠ رہنماوو بہٕ آزاد کرنہٕ باپتھ رومین ہنٛزِ خوٲہِشہٕ خلاف کتھ کٔر تہٕ مےٚ پیٚو یہ درخواست کرُن زِ میٚون فٲصلہ گژھِ یتہِ رومکِس بادشاہس نِش سپدُن۔   مگر میٚون یہ کرنُک وجہ اوس نہٕ یہ زِ بہٕ اوسُس پننہِ قومہٕ کٮ۪ن لیڈرن کانٛہہ اِلزام دیُن یژھان۔  
\v 20 اوٕ کِنؠ کوٚرمو مےٚ توٚہہِ درخواست زِ توٚہؠ یِیو یور تاکہِ بہٕ ونو توٚہہِ زِ بہٕ کیازِ چُھس قٲدؠ۔   امیُک وجہ چُھ یہ زِ بہٕ چُھس اتھ کتھِ پیٚٹھ یقین تھاوان زِ اسرائیل لٕکؠ لوٗکھ چھِ پوٗرٕ پژھ تھاوان زِ خدا کیا کرِ اسہِ سٟتؠ۔  
\v 21 پتہٕ ووٚن یہُودؠ قٲعِدو،  "اسہِ میٚول نہٕ یہُودیہ ہس منٛز پننیٚو سٲتھی یہُودیٚو طرفہٕ توٚہہ متعلق کانٛہہ تہِ خط۔   امہِ علاوٕ ووٚن نہٕ کانٛسہ تہِ یہُودؠ یمہ یہُودیہ پیٚٹھٕ یور آمٕتؠ چھِ توٚہہِ متعلق کانٛہہ بُرٕ کتھ۔  
\v 22 مگر أسؠ چھِ یہ بوزُن یژھان زِ توٚہؠ کیاہ چُھو اتھ جمٲژ متعلق سونٛچان یتھ سٟتؠ توٚہؠ تعلق تھاوان چُھو،  تکیازِ أسؠ چھِ زانان زِ واریہن جاین چھِ لوٗکھ اتھ خلاف ونان۔  
\v 23 لہٰذا کوٚر تِمو فٲصلہٕ زِ تِم یِن بیٚیہِ کُنہِ دوٚہہ واپس۔   ییٚلہ سُہ دوٚہہ آو تہٕ گۅڈنکہِ دوٚہہ کھۅتہٕ تہِ وٲتؠ زیادٕ لوٗکھ تور یتہِ پولُسؔ روزِتھ اوس۔   پولُسنؔ ووٚن تِمن زِ خدا کِتھ پٲٹھؠ چُھ سارنی پیٚٹھ حکومت کران۔   تٔمؠ کٔر اتھ متعلق کتھ زِ کِتھٕ پٲٹھؠ کٔر موسیٰؔ سنٛدؠ شریعتن تہٕ باقی رسولو یسوعسؔ متعلق پیشن گوئی۔   پولُسنؔ کٔر تِمن سارنی سٟتؠ کتھ یمہ صُبح پیٚٹھٕ شام تام بوزان ٲسؠ تمسنٛدِس گھرس منٛز۔  
\p
\v 24 تتھ منٛز آے کینٛہہ یہُودؠ یتھ کتھِ پیٚٹھ آمادٕ کرنہٕ زِ پولُسنؔ یہ کینٛژھا یسوعسؔ متعلق ووٚن تہِ چُھ پوٚز مگر باقیٚو مون نہٕ یہ چُھ پوٚز۔  
\v 25 ییٚلہ تِمن پانہٕ وٲنؠ اختلاف کرنہِ لٔگؠ تہ ووٚنؠ ہیٚوتُکھ نیرن تہٕ پولُسسؔ ٲس بیاکھ کتھ تہِ ونٕنؠ: "پاک روحن ووٚن تُہنٛدین جدٕ اجدادن پزر ییٚلہ تٔمؠ یمہٕ کتھٕ نبی یسعیاہسؔ ونہِ:
\q
\v 26 پننِس قومس نِش گژھِ تہٕ تِمن ون:
\q توٚہؠ چُھو پننیٚو کنو بوزان مگر زانٛہہ چُھو نہٕ یہ سمجھان زِ خدا کیاہ چُھ ونان۔  
\q توٚہؠ چُھ پننیٚو أچھو وُچھان مگر توٚہؠ چُھو نہٕ پزنہٕ پٲٹھؠ تِم چیز وُچھان یمہٕ خدا کران چُھ۔  
\v 27 یمہٕ لوٗکھ چھنہٕ سمجھان تکیازِ یِم چھِ ضدی بنیامٕتؠ۔   یہنٛدؠ کن چھِ یہ دٔپؠ زِ تہِ زٔرؠ؛
\q تہٕ یمو چھےٚ أچھ بنٛد تھاوِمژٕ تکیازِ یِم چھنہٕ وچُھن یژھان۔  
\q یِم چھنہٕ کنو بوزُن یژھان، 
\q تہٕ نہ چھِ دِلہ سٟتؠ سمجھُن یژھان، 
\q تیٚلہ ین یمہٕ مےٚ نِش واپس تہٕ بہٕ بخشہٕ یمن شِفا۔  
\p
\v 28 اوِ کِنؠ پزِ توٚہہ،  یہ زانُن زِ خدا چُھ غٲر یہُودؠ بچاونٕچ پیش کش کران تہٕ تِم بوزن۔  
\v 29 ییٚلہ تِمو یہ ونِتھ مۅکلوو تہٕ یہُودؠ دراے۔   تِمن اوس پانہٕ وٲنؠ بوٚڈ تنازٕ چلان۔  
\p
\v 30 پولُسؔ رود تتہِ کرایہِ مکانس منٛز برابر دون ورین۔   واریاہ لوٗکھ اے تس سمکھنہِ تہِ تِمو کوٚر تِمن سارنی خۅشدلی سان استقبال تہٕ تِمن سٟتؠ کرین کتھٕ۔  
\v 31 تٔمؠ دِژ لوٗکن ژینہٕ ون تہٕ ہیٚچھنٲوِن زِ خدا کِتھٕ پٲٹھؠ چُھ پننہِ بادشٲہی ہُنٛد اظہار کران تہٕ تٔمؠ ہیٚچھنٲوؠ تِم خداوند یسوعؔ مسیحؔ ہس متعلق۔   تٔمؠ کٔر بڈٕ ہمتہٕ سان یہ کٲم تہٕ کانٛسہ کٔر نہٕ سُہ رُکاونٕچ کوشش۔
