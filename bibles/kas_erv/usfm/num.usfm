\id NUM - DMT Kashmir
\toc1 گریند
\mt1 گریند
\c 1
\p
\v 1 اسرائیل لٕکؠ مِصرٕ منٛزٕ نیرنہٕ پتہٕ ؤریکہِ دویمہِ ریٚتہٕ سپُد خداوند موسیٰؔ ہَس سٟتؠ تمہِ وزِ ہمکلام ییٚلہِ سُہ سیناؔ کِس بیابانس منٛز مقدس خٟمس منٛز اوس۔ خداوندن ووٚن تمِس،
\v 2 "اسرائیل کہ پرٛتھ گرٕکؠ مرد، تُہنٛدؠ بب، جد گنٛزراوُکھ تہٕ تہنٛدیو ناوو حسابہٕ کرُکھ گرینٛد۔
\v 3 ژےٚ تہٕ ہارونس پزن تِم نفر گنٛزراونؠ یہنز وانٛس کمَس کم وُوہہ وری آسہ یم فوجس منٛز بحثیتِ سِپاہ کٲم کرِتھ ہیٚکن۔ تِمن مردن ہُنٛد تعداد کٔریٚو درج، تہنٛدیٚن قبیلن تہٕ خاندانن ہنٛدیٚو ناوو سان۔
\v 4 مےٚ چُھ پرٛتھ اکہِ قبیلہٕ منٛزٕ اکھ نفر امہِ کامہِ مۅکھٕ چانہِ مدتہٕ خٲطرٕ ژورمُت۔ پرٛتھ کانٛہہ نفر گژھِ پننہِ قبیلُک زیُٹھ آسُن۔
\v 5‏-6 تِمن ہنٛدؠ ناو چھِ یم: روبنؔ سنٛدِ قبیلہٕ منٛزٕ شدیورؔ سُنٛد نیٚچو الیصورؔ۔ شمعونؔ سنٛدِ قبیلہٕ منٛزٕ صوری شدیؔ سُنٛد نیٚچو سلُومی ایلؔ۔
\v 7 یہُوداؔ سنٛدِ قبیلہٕ منٛزٕ عِمیندآبؔ سُنٛد نیٚچو نحسونؔ۔
\v 8 اشکار سنٛدِ قبیلہٕ منٛزٕ ضُغر سُنٛد نیٚچو نتنی ایلؔ۔
\v 9 زبولون سنٛدِ قبیلہٕ منٛزٕ حیلونؔ سُنٛد نیٚچو الیابؔ۔
\v 10 یوسفؔ سنٛدیو زُریٚو منٛزٕ افرائیمؔ قبیلُک الِیسمعؔ بنِ عِمیہُودؔ تہٕ منسیؔ سنٛدِ قبیلہٕ منٛزٕ فداہ صُورؔ سُنٛد نیٚچو جملی ایل۔
\v 11 بنیمِینؔ سنٛدِ قبیلہٕ منٛزٕ جِدعونیؔ سُنٛد نیٚچو ابِدانؔ۔
\v 12 دان سنٛدِ قبیلہٕ منٛزٕ عمیشدائیؔ سُنٛد نیٚچو اخِیرع۔
\v 13 آشرؔ سنٛدِ قبیلہٕ منٛزٕ عکرانؔ سُنٛد نیٚچو فجعی۔
\v 14 جد سنٛدِ قبیلہٕ منٛزٕ دعوایلؔ سُنٛد نیٚچو الیاسبؔ
\v 15 نفتالیؔ سنٛدِ قبیلہٕ منٛزٕ عینان سُنٛد نیٚچو اخِیرع۔
\v 16 یم ٲسؠ تِم نفر یِم خداوندن لوٗکو منٛزٕ ژٲرمٕتؠ ٲسؠ۔ تِم ٲسؠ پننٮ۪ن خاندانن ہنٛدؠ زِٹھؠ تہٕ اسرائیل کیٚن قبیلن ہنٛدؠ سردار۔ ہاروننؔ تہٕ موسیٰؔ ہَن أنؠ یم سٲری قٲید ناد دِتھ۔
\v 17 ہارونن تہٕ موسیٰؔ ہن تہٕ تِمو کٔرؠ یِم سٲری باہ قبٲیلی زِٹھؠ امی دوٚہہ جمع۔
\v 18 تِمو کٔرؠ تِم سٲری لوٗکھ تٔمی ؤرؠ یکہِ دویمہِ ریتکہِ گۅڈنکہِ دوٚہہ جمع۔ تِمو کٔرؠ سارنےٕ لوٗکن ہنٛدؠ ناو درٕج یہنٛز وانٛس کمس کم وُوہہ ؤری ٲس تہٕ تہنٛدیٚن ناون سٟتؠ تھٲوِکھ قبیلن تہٕ تہنٛدین خاندانن ہنٛدؠ ناو تہِ درج۔
\v 19 یتھ پٲٹھؠ زن موسیٰؔ ہن فرموٕمُت اوس۔ یمو لیکھؠ یمہٕ ناو تمہِ وزِ ییٚلہ اسرائیل لٕکؠ سینا کِس صراوس منٛز ٲسؠ۔
\v 20‏-21 روبنؔ سنٛدِ قبیلٕکؠ ٲسؠ شیہِ تٲجی ساس پانٛژھ ہتھ نفر۔ یُس یعقوبؔ سُنٛد ساروےٕ کھۅتہٕ زیُٹھ ہیٚو نیٚچو اوس یمن ہنٛز وانٛس کمس کم وُوہہ ؤری ٲس تہٕ یم ٲسؠ جنگس منٛز لڑنَس لایق۔ تِم سٲری ٲسؠ پننیٚو ناوو، قبیلو تہٕ پننیٚو خاندٲنی جمٲژو مطٲبق درج کرنہٕ آمٕتؠ۔
\p
\v 22‏-23 شمعون سنٛدِ قبیلٕکؠ ٲسؠ کُنہٕ ہٲٹھ ساس ترےٚ ہتھ نفر۔ یہنٛز وانٛس کمس کم وُوہہ ؤری ٲس تہٕ تِم ٲسؠ لڑایہِ منٛز لڑنس لایکھ۔ تم آے پننیٚو ناوو، قبیلن تہٕ خاندٲنی گرانن ہنٛدین ناون تحت درج کرنہٕ۔
\p
\v 24‏-25 جد سنٛدِ قبیلٕکؠ ٲسؠ پنٛژتٲجی ساس شےٚ ہتھ پانٛژھ نفر۔ یہنٛز وانٛس لگ بگ وُوہہ وری ٲس تہٕ تِم تہِ ٲسؠ جنٛگس منٛز ہَر کرنس قٲبل۔ تِم تہِ آے پننیٚو ناوو، قبیلو تہٕ پننیٚو خاندٲنی جمٲژو مطٲبق درج کرنہٕ۔
\p
\v 26‏-27 یہُوداؔ سنٛدِ قبیلٕکؠ ٲسؠ ژُستَتھ ساس شےٚ ہتھ نفر۔ یہنٛز وانٛس لگ بگ وُوہہ وری ٲس تہٕ تِم تہِ ٲسؠ جنٛگس منٛز ہَر کرنس قٲبل۔ تِم آے پننیٚو ناوو، قبیلو تہٕ پننیٚو خاندٲنی جمٲژو مطٲبق درج کرنہٕ۔
\p
\v 28‏-29 اشکار سنٛدِ قبیلہٕ منٛزٕ ٲسؠ ژوٗونزاہ ساس ژور ہتھ نفر۔ یمن ہنٛز وانٛس کمس کم وُوہہ ؤری ٲس تہٕ تِم سٲری ٲسؠ جنگس منٛز لڑٲے کرنس لایق۔ تِم تہِ سپٕدؠ پننیٚو ناوو، قبیلو تہٕ پننیٚو خاندٲنی جمٲژو مطٲبق درج۔
\p
\v 30‏-31 زبولونؔ سنٛدِ قبیلٕکؠ ٲسؠ ستہٕ ونزاہ ساس ژور ہتھ نفر۔ یہنٛز وانٛس لگ بگ وُوہہ وری ٲس تہٕ تِم تہِ ٲسؠ جنٛگس منٛز ہَر کرنس قٲبل۔ تِم آے پننیٚو ناوو، قبیلو تہٕ پننیٚو خاندٲنی جمٲژو مطٲبق درج کرنہٕ۔
\p
\v 32‏-33 افرائیمؔ سنٛدِ قبیلٕکؠ ٲسؠ ژتجی ساس پانٛژھ ہتھ نفر۔ یہنٛز وانٛس کمس کم وُوہہ ؤری ٲس تہٕ تِم ٲسؠ لڑایہِ منٛز لڑنس لایکھ۔ تم آے پننیٚو ناوو، قبیلن تہٕ خاندٲنی گرانن ہنٛدین ناون تحت درج کرنہٕ۔
\p
\v 34‏-35 منسیؔ سنٛدِ قبیلٕکؠ ٲسؠ دوٗیہِ ترہ ساس زٕ ہتھ نفر۔ یہنٛز وانٛس کمس کم وُوہہ ؤری ٲس تہٕ تِم ٲسؠ لڑایہِ منٛز لڑنس لایکھ۔ تم آے پننیٚو ناوو، قبیلن تہٕ خاندٲنی گرانن ہنٛدین ناون تحت درج کرنہٕ۔
\p
\v 36‏-37 بنیمِینؔ سنٛدِ قبیلٕکؠ ٲسؠ پنژٕترٕہ ساس ژور ہتھ نفر۔ یہنٛز وانٛس لگ بگ وُوہہ وری ٲس تہٕ تِم تہِ ٲسؠ جنٛگس منٛز ہَر کرنس قٲبل۔ تِم تہِ آے پننیٚو ناوو، قبیلو تہٕ پننیٚو خاندٲنی جمٲژو مطٲبق درج کرنہٕ۔
\p
\v 38‏-39 دانؔ سنٛدِ قبیلہٕ منٛزٕ ٲسؠ دُہٲٹھ ساس ستتھ ہتھ نفر۔ یمن ہنٛز وانٛس کمس کم وُوہہ ؤری ٲس تہٕ تِم سٲری ٲسؠ جنگس منٛز لڑٲے کرنس لایق۔ تِم تہِ سپٕدؠ پننیٚو ناوو، قبیلو تہٕ پننیٚو خاندٲنی جمٲژو مطٲبق درج۔
\p
\v 40‏-41 آشرؔ سنٛدِ قبیلٕکؠ ٲسؠ اکتٲجی ساس پانٛژھ ہتھ نفر۔ یہنٛز وانٛس لگ بگ وُوہہ وری ٲس تہٕ تِم تہِ ٲسؠ جنٛگس منٛز ہَر کرنس قٲبل۔ تِم تہِ آے پننیٚو ناوو، قبیلو تہٕ پننیٚو خاندٲنی جمٲژو مطٲبق درج کرنہٕ۔
\p
\v 42‏-43 نفتالیؔ سنٛدِ قبیلٕکؠ ٲسؠ تروونزاہ ساس ژور ہتھ نفر۔ یہنٛز وانٛس کمس کم وُوہہ ؤری ٲس تہٕ تِم ٲسؠ لڑایہِ منٛز لڑنس لایکھ۔ تم آے پننیٚو ناوو، قبیلن تہٕ خاندٲنی گرانن ہنٛدین ناون تحت درج کرنہٕ۔
\p
\v 44‏-45 یہ ٲس پرٛتھ کُنہِ قبیلہٕ منٛزٕ کیٚن مردن ہنٛز تعداد۔ یم ہاروننؔ، موسیٰؔ ہَن، تہٕ اسرائیلی قبیلہٕ کیٚو بہو سردارو پننٮ۪ن قبیلہٕ والیٚن ہنٛدین ناون سٟتؠ درٕج۔
\v 46 یمن ہُنٛد کُل تعداد اوس شےٚ لچھ ترےٚ ساس پانٛژھ ہتھ پنژاہ مرد۔
\p
\v 47 مگر اتھ تعدادس منٛز ٲسؠ نہٕ لاوی قبیل کیٚن مردن ہنٛدؠ ناو شٲمل،
\v 48 تکیازِ خداوندن اوس موسیٰؔ ہس وونمُت،
\v 49 "ییٚلہ توٚہؠ اسرائیل کیٚن قبیلن ہنٛدؠ نفر گنٛزرٲووکھ تہٕ تِم مرد گنٛزرٲؠ زیوکھ نہٕ یِم لاوی قبیلٕکؠ آسن۔
\v 50 لاوینؔ ہنٛدؠ اولاد تھٲوزیٚوکھ مقدس خٟمن تہٕ تِمن اندر موجود المارین ہنٛدؠ رٲچھ در یمن منٛز تِم تختی موجود چھےٚ یِمن پٮ۪ٹھ داہ احکام لیٚکِھتھ چھِ۔ تِمن پییہِ خٟمن انٛدر موجود باقی چیزن ہُنٛد تہِ خیال تھاوُن۔ ییٚلہِ توٚہؠ سفرس نیریٚو تہٕ تِمے آسن تِم لوٗکھ یم مقدس خٟمہ تہٕ اتھ انٛدر موجود تمام چیز پانس سٟتؠ تُلن تہٕ تِمن ہنٛز پوٗرٕ رٲچھ راوٕٹ کرن تہٕ پنٕنؠ خٟمہٕ دِن تتھ انٛدؠ پٔکؠ۔\f + \fr 1‏:50 \ft اعما 7:44\f*
\v 51 ییٚلہ سُہ وقت واتہِ ییٚلہ توٚہہِ سارنی کُنہِ بدل جایہ گژھُن پییہِ تہٕ لاوی قبیلٕکؠ اولاد ژٕھنن لٲزمن مقدس خٟمہ بوٚن وٲلِتھ۔ تہٕ ییٚلہ کُنہ جایہ پڈاو دِنُک موقہٕ واتہِ تہٕ تِمے آسن یمہٕ تتھ دبارٕ کھڑا کرن۔ کانٛہہ دویم نفر اگر یہ کٲم کرنہٕ باپتھ مقدس خٟمن نزدیک گژھِ تٔمس گژھِ پھٲسؠ دِنؠ۔
\v 52 اسرائیل کہِ پرٛتھ کُنہِ قبیلٕکؠ لوٗکھ دِن پن پننِس علاقس منٛز پنُن خٟمہ تہٕ بیٚیہِ کھالن اکھ جھنڈٕ یُس تمہِ قبیلٕچ نشاندہی کران آسہ۔
\v 53 مگر لاوینؔ پیٚن پنٕنؠ خٟمہ مقدس خٟمن انٛدؠ پٔکؠ لاگٕنؠ تاکہ باقی اسرائیل کیٚن لوٗکن پییہِ نہٕ خٟمن نزدیک گژھنہٕ کِنؠ خداوند سنٛدِ طرفہٕ سزا تُلن۔ لاوینؔ ہنٛدؠ اولاد چھِ تِم یِم مقدس خٟمن انٛدؠ پٔکؠ حفاظتہٕ باپتھ کھڑا روزن\f + \fr 1‏:53 \ft لاوی چھِ ذِمہٕ دار زِ تِم دِن نہٕ کٲنٛسہِ تہِ خٟیمس نزدیک یِنہٕ۔ \f*۔"
\p
\v 54 لہٰذا کۅر اسرائیل کیٚو لوٗکو پرٮ۪تھ کینٛہہ بلکُل تِتھے پٲٹھؠ یتھٕ پٲٹھؠ موسیٰؔ ہس خداوندن کرنُک حکم کۅرمُت اوس۔
\c 2
\p
\v 1 پتہٕ دِتؠ خداوندن موسیٰؔ ہس تہٕ ہارونسؔ یِم ہدایت،
\v 2 ییٚلہ اسرائیل لٕکؠ پنٕنؠ خٟمہ تِمن جاین لاگن یمہ جایہ مقدس خٟمن انٛدؠ پٔکؠ چھےٚ مگر تتھ نزدیک آسن نہٕ۔ پرٛتھ کُنہِ قبیلہٕ کیٚن لوٗکن پزن الگ الگ جاین پن پنٕنؠ خٟمہ دِنؠ۔ پرٛتھ کُنہِ قبیلس پزِ تتِتھ پنُن اکھ جھنٛڈٕ لاگُن یُس تہنٛدِ قبیلٕچ نشاندہی کران آسہ
\v 3‏-4 یہُوداؔ قبیلٕکؠ لوٗکھ دِن پنٕنؠ خٟمہ مقدس خٟمن مشرقہ طرفہ یتِتھ تِمن پننہِ قبیلُک جھنٛڈٕ آسہ۔ عِمیندآبؔ سُنٛد نیٚچو نحسونؔ آسہ یہُوداؔ قبیلہٕ کیٚن ژُسَتتھ ساس شےٚ ہتھ نفرن ہُنٛد زیُٹھ۔\f + \fr 2‏:3‏-4 \ft زِٹھؠ سنٛدِ خٲطرٕ چُھ عِبرٲنؠ لفظ ناسی\f*
\v 5‏-6 اشکارؔ قبیلٕکؠ لوٗکھ دِن یہُوداؔ کیٚن خٟمن نِش پنٕنؠ خٟمہ۔ ضُغر سُنٛد نیٚچو نتنی ایلؔ آسہ اِشکار قبیلہٕ کیٚن ژوٗونزاہ ساس ژور ہتھ نفرن ہُنٛد سردار۔
\v 7‏-8 زبولونؔ قبیلٕکؠ لوٗکھ دِن اِشکار قبیلہٕ کیٚن خٟمن سٟتؠ پنٕنؠ خٟمہ۔ حیلونؔ سُنٛد نیٚچو الیابؔ آسہ زبولونؔ قبیلہٕ کیٚن ستتھ ونزاہ ساس ژور ہتھ نفرن ہُنٛد سردار۔
\v 9 یتھ کِنؠ آسن مقدس خٟمن مشرقہ طرفہ اکھ لچھ شیہِ شیتھ ساس ژور ہتھ فوجی۔ ییٚلہ تہ اسرائیل لٕکؠ کُنہ نوِ جایہ گژھن تہٕ یِم ترےٚ قبیلہٕ روزن باقین قبیلن برُونٛہہ کنہِ۔
\v 10‏-11 روبنؔ قبیلہٕ لاگہِ پنٕنؠ خٟمہ مقدس خٟمن جنوب طرفہ یتہِ تِمن پننہِ قبیلُک جھنٛڈٕ لٲگِتھ آسہ۔ شدیورؔ سُنٛد نیٚچو الیصورؔ آسہ روبنؔ قبیلہٕ کیٚن شیہِ تٲجی ساس تہٕ پانٛژن ہتن نفرن ہُنٛد سردار۔
\v 12‏-13 شمعونؔ قبیلٕکؠ لوٗکھ لاگن روبنؔ قبیلس سٟتؠ پنٕنؠ خٟمہ۔ صوری شدیؔ سُنٛد نیٚچو سلُومی ایلؔ آسہ شمعونؔ قبیلہٕ کیٚن کُنہٕ ہٲٹھ ساس ترےٚ ہتھ نفرن ہُند سردار۔
\v 14‏-15 جدؔ قبیلٕکؠ لوکھ لاگن شمعونؔ کیٚن خٟمن سٟتؠ پنٕنؠ خٟمہ۔ رعوایلؔ سُنٛد نیٚچو الیاسبؔ آسہ جد قبیلہٕ کیٚن پنٛژتٲجی ساس شےٚ ہتھ پنژہن نفرن ہُنٛد سردار۔
\p
\v 16 یتھ پٲٹھؠ آسن مقدس خٟمن جنوب طرفہ اکھ لچھ اَکہٕ وونزاہ ساس ژور ہتھ پنژاہ فوجی۔ یِم ترےٚ قبیلہٕ آسن گۅدنِچہ جمٲژ پتہٕ دویِم اسرائیل ین پٲروی کران ییٚلہ تِم کُنہ سفرس نیرن۔
\v 17 امہِ جمٲژ پتہٕ آسہ لاوی قبیلٕچ جماتھ یم مقدس خٟمہ تُلان آسن۔ اسرائیلی آسن امی ترتیبہٕ سان پکان تہٕ امی حسابہٕ آسن ہمیشہٕ پنٕنؠ خٟمہ لاگان۔ پرٛتھ کانٛہہ قبیلہٕ آسہ پنُن جھنٛڈٕ سٟتؠ تُلان۔
\p
\v 18‏-19 افرائیمؔ قبیلہٕ کیٚن پزن پنٕنؠ خٟمہ مقدس خٟمن مغرب طرفہٕ پننہِ قبیلہٕ کِس جھنٛڈس سٟتؠ لاگٕنؠ۔ عِمیہُودؔ سُنٛد نیٚچو الِیسمعؔ آسہ افرائیمؔ قبیلہٕ کیٚن ژتجی ساس پانٛژھ ہتھ نفرن ہُنٛد زیُٹھ۔
\p
\v 20‏-21 منسیؔ قبیلٕکؠ لوکھ دِن افرائیمؔ ہنٛدین خٟمن سٟتؠ پنٕنؠ خٟمہ۔ فداہ صُورؔ سُنٛد نیٚچو جملی ایلؔ آسہ منسیؔ قبیلہٕ کیٚن دوٗیہِ ترٕ ساس زٕ ہتھ نفرن ہُنٛد سردار۔
\p
\v 22‏-23 بنیمِینؔ قبیلٕکؠ لوکھ دِن منسیؔ قبیلہٕ کیٚن خٟمن نِش پنٕنؠ خٟمہ۔ جدعونیؔ سُنٛد نیٚچو ابِدانؔ آسہ بنیمِینؔ قبیلہٕ کیٚن پنژترٕہ ساس ژور ہتھ نفرن ہُنٛد سردار۔
\p
\v 24 یتھٕ پٲٹھؠ آسن مقدس خٟمس مغرب طرفہ اکھ لچھ ٲٹھ ساس اکھ ہتھ سِپاہ۔ یِم ترےٚ قبیلہٕ روزن لاوی سنٛدین اولادن پتہٕ پتہٕ دویمہ جمٲژ ہنٛز پٲروی کران۔ یہِ آسہ ترییِم جماتھ۔
\p
\v 25‏-26 دانؔ قبیلہٕ کیٚن پزن پنٕنؠ خٟمہ مقدس خٟمن شمال انٛدٕ پننہِ قبیلہٕ کِس جھنٛڈس نکھٕ دِنؠ۔ عمیشدائیؔ سُنٛد نیٚچو اخِیرع آسہ دان قبیلہٕ کیٚن دوٗ ہٲٹھ ساس ستتھ ہتھ نفرن ہُنٛد سردار۔
\p
\v 27‏-28 آشرؔ قبیلٕکؠ لوٗکھ دِن پنٕنؠ خٟمہٕ دانؔ ہنٛدین خٟمن نِش۔ عکرانؔ سُنٛد نیٚچو فجعی ایلؔ آسہ آشرؔ قبیلہٕ کیٚن اکہٕ تٲجی ساس پانٛژھ ہتھ نفرن ہُنٛد سردار۔
\p
\v 29‏-30 نفتالیؔ قبیلن ہنٛدؠ لوٗکھ لاگن آشرؔ قبیلہٕ کیٚن خٟمن نِش پنٕنؠ خٟمہ۔ عینانؔ سُنٛد نیٚچو اخِیرع آسہ نفتالیؔ قبیلہٕ کیٚن ترُووٛنزاہ ساس تہٕ ژورن ہتن نفرن ہُنٛد سردار۔
\p
\v 31 یتھ پٲٹھؠ آسن مقدس خٟمن شمال انٛدٕ اکھ لچھ ستونٛزاہ ساس شےٚ ہتھ فوجی۔ یم ترےٚ قبیلہٕ آسن سارنی پۅتَس۔ ییٚلہ اسرائیل لٕکؠ سفرس نیران آسن یِم آسن امی حسابہ پنُن جھنٛڈٕ ہیٚتھ۔
\p
\v 32 یتھٕ کٔنؠ ٲسؠ شےٚ لچھ ترےٚ ساس پانٛژھ ہتھ پنٛژاہ اسرائیلی جوان جنگ کرنؠ لایکھ یم سٲری پن پننہِ خاندانہٕ تہٕ اسلافن ہنٛدِ نٮ۪سبتہٕ درج ٲسؠ۔
\v 33 مگر موسیٰؔ تہٕ ہارونن ٲسؠ نہ لاوی اسرائیل ین سٟتؠ شمار کٔرؠ مٕتؠ یتھٕ کنؠ زن خداوند یہُوواہنؔ حکم دیُتمت اوس۔
\p
\v 34 اسرائیل یو کۅر تہِ سورےٕ یہ یہُوواہنؔ موسیٰؔ ہس ونمُت اوس۔ تِمو دِتؠ پننٮ۪ن قبیلہٕ کیٚن جھنٛڈن تل پنٕنؠ پنٕنؠ خٟمہ تہٕ ییٚلہ تِم کُنہ نوِ جایہ گژھٕ ہن تِم ٲسؠ پن پننٮ۪ن قبیلن تہٕ خاندٲنی جمٲژن سٟتؠ پکان۔
\c 3
\p
\v 1 یم کینٛہہ چیز سَپدؠ ہارونسؔ تہٕ موسیٰؔ ہس سٟتؠ ییٚلہ یہُوواہنؔ کوہہِ سیناؔہس پٮ۪ٹھ موسیٰؔ ہس سٟتؠ کتھ کٔر\f + \fr 3‏:1 \ft یہٕ چُھ موسیٰؔ سُنٛد پہاڑ سینا کِس تینتٲلس تام دویِم سفر، سنہری ؤژھؠ سٕنٛدِ واقہٕ پتہٕ (لہٰذا ملگروم، صفحہ 15) ییٚلہِ لٲویو یہُوواہسؔ سٕتؠ پننہِ عقیدُک مظاہرٕ کوٚر (خروج 32:26) سینا پہاڑ چُھ سُہ پہاڑ یتہٕ یہُوواہؔ مِصرس منٛز اسرائیل ین ہنٛد غلامی نش فرار گژھنس دوران موسیٰؔ ہس سٟتؠ کتھ کرنہٕ خاطرٕ آو۔\f*۔
\v 2 ہارونسؔ ٲسؠ ژور اولاد۔ زیُٹھ ہیٚو اوس ندبؔ، پتہٕ ابیہوؔ، الِیعزرؔ تہٕ اِتمرؔ۔
\v 3 یِم ٲسؠ ہارونؔ سنٛدین نیٚچوٮ۪ن ہنٛدؠ ناو یم مٲلِش کرِتھ کاہن تہٕ کاہن سنٛدِ حثیتہٕ الگ تھاونہٕ آمٕتؠ ٲسؠ، تِمن ٲس کاہنن ہنٛدؠ پٲٹھؠ خدمت گُذٲری ہنٛز ذمہ دٲری تھاونہٕ آمٕژ۔
\v 4 مگر ییٚلہِ یہُوواہؔ یہ وُچھان اوس، ندبؔ تہٕ ابیہوؔ سیناؔ کیٚن بیابانن منٛز مران تکیازِ تِمو اوس تِتھٕ کِنؠ مشُک زولمُت یۅسہ یہُوواہؔ سنٛدِ حکمٕچ نافرمٲنی ٲس۔\f + \fr 3‏:4 \ft احبار 10: 1-7\f* تِمن اوس نہٕ کانٛہہ اولاد، لہٰذا ٲسؠ الِیعزرؔ تہٕ اِتمرؔ صرف زٕ اولاد یِم پننِس مٲلِس ہارونسؔ سٟتؠ کاہن بننہٕ خٲطرٕ پتھ کُن رودؠ۔
\v 5 پتہٕ ووٚن یہُوواہنؔ موسیٰؔ ہس،
\v 6 "لاوی قبیلٕک مرٕد انُکھ تہٕ کرُکھ ہارونسؔ نِش پیش تاکہِ تِم کرن تس مدد۔
\p
\v 7 تِم لاوی کرن ہارونسؔ تہٕ باقی تمام اسرائیل ین ہنٛز خدمت۔ ییٚلہ زن تِم مقدس خٟمس انٛدرٕ نیٚبرٕ پنٕنؠ کٲم کرن۔
\v 8 تِم کرن سارنی اسرائیل ین ہنٛز خدمت تہٕ بیٚیہِ کرن تِمن تمام چیزن ہنٛز رٲچھ یِم مقدس خٟمس اندر چھِ۔
\v 9 ہارونؔ تہٕ تٔمسنٛدین دوٚن اولادن ہنٛدِ مدتہٕ خٲطرٕ کٔرؠ ووکھ تِم مقرر۔ مےٚ چھِ تِم تمام اسرائیلی لوکو منٛزٕ یہ کرنہٕ باپتھ ژٲرمٕتؠ۔
\v 10 ہارون تہٕ تمسنٛدؠ زٕ نیٚچوؠ کٔرؠ ووکھ سۅ کٲم کرنہٕ باپتھ مقرر یۅسہ کاہن کران چھِ۔ اگر بدل کانٛہہ یہ کٲم کرنہٕ باپتھ مقدس خٟمن نکھٕ ییہِ تمِس گژھِ سزایہ موت دِنہٕ یُن۔
\v 11 یہُوواہنؔ ووٚن موسیٰؔ ہس یتہِ زِ،
\v 12 "یاد تھٲیو تمام اسرائیل یو منٛزٕ چھِ مےٚ لاوی قبیلٕکؠ نفر ژٲرؠ مٕتؠ یِم اسرائیلی لوٗکن ہنٛدین گۅڈٕ زامتیٚن اولادن ہنٛز جاے رٹن۔ لاوی ین ہنٛدؠ اولاد چھِ میانؠ،
\v 13 پزی چھِ تمام زِٹھؠ اولاد میانؠ یمہِ کِنؠ زِ یمہِ دوٚہہ مےٚ مِصرٕکؠ تمام زِٹھؠ بچہٕ مٲرؠ، \f + \fr 3‏:13 \ft خروج 11:5؛ 13:2، 15:\f* مےٚ بچٲوؠ اسرائیلی لوٗکن ہنٛدؠ تمام زِٹھؠ اولاد تہٕ تھٲیم پانس باپتھ الگ۔ مےٚ تھٲوؠ تُہنٛدین چارواین ہنٛدؠ گۅڈنِکؠ نَر ژَھو تہِ الگ کٔڈِتھ۔ تِم تہِ چھِ میانؠ، یہُوواہؔ۔"
\v 14 یہُوواہنؔ کٔر سینا کیٚن بیابانن منٛز موسیٰؔ ہس سٟتؠ بیٚیہِ تہِ کتھ۔ تٔمؠ ووٚن،
\v 15 "لاوی قبیلہٕ کیٚن مردن کٔریٚو گرینٛد۔ تہنٛدؠ ناو، تہنٛدین قبیلن تہٕ خانوادن ہنٛدؠ ناو تہِ لیٚکھیٚو۔ تِم مرد تہِ گنٛزرٲوؠ زیوکھ یم کمس کم اکہِ ریٚتکؠ آسن۔
\v 16 تہٕ موسیٰؔ ہن کٔر تِمن گرینٛد یتھٕ کنؠ زن یہُوواہنؔ حکم دِتُس۔
\v 17 لاوین ٲسؠ ترےٚ نیٚچوؠ، یمن جیرسونؔ، قہاتؔ تہٕ مراریؔ ناو ٲسؠ۔
\v 18 جیرسونسؔ ٲسؠ زٕ نیٚچوؠ لبنیؔ تہٕ سمعیؔ۔ تِہنٛدِ مرِ یُس قبیلہٕ پوٚک سُتہ آو یموے دویو لٔڑکو سٟتؠ زاننہٕ۔
\v 19 قہاتسؔ ٲسؠ ژور نیٚچوؠ، عمرامؔ، اضہارؔ، حبرونؔ تہٕ عزییلؔ۔ یُس قبیلہٕ تِہُنٛد برونٛہہ پوٚک سُہ آو یموےٕ ژۅن نیٚچوٮ۪ن ہنٛدِ ناوٕ زاننہٕ۔
\v 20 مراریؔ یس ٲسؠ زٕ نیٚچوؠ، محلیؔ تہٕ موشیؔ۔ تِہنٛد قبیلہٕ تہِ پوٚک یموےٕ دویو اولادو ذریٲژ یہ برُونٛہہ۔
\p یم چھِ تِم قبیلہٕ یِم لاوی زُریٲژ منٛزٕ چھِ۔
\p
\v 21 جیرسونؔ سنٛدؠ ٲسؠ تِم زٕ قبیلہٕ یم تمسنٛدین اولادن لبنیؔ تہٕ سمعیؔ سنٛدؠ ٲسؠ۔
\v 22 یمن دوٚن قبیلن منٛز ٲسؠ ستتھ ساس پانٛژھ ہتھ لٔڑکہٕ یہنٛز وانٛس کمس کم اکھ ریٚتھ ٲس۔
\v 23 تِمن جیرسونین آو وننہٕ زِ پنٕنؠ خٟمہ لاگیٚو مقدس خٟمن مغربہ انٛدٕ۔
\v 24 یمن دوٚنونؠ قبیلن ہُنٛد سردار اوس لائیل سُنٛد نیٚچو الیاسبؔ۔
\v 25 تہنٛز کٲم ٲس مقدس خٟمن ہنٛز رٲچھ راوٹ کرٕنؠ، تمہِ علاوٕ تمہِ کیٚن پردن، تجیرن، انٛدرمیٚن دروازٕ پردن،
\v 26 تِمن پردن یمہٕ صحنس منٛز دۅسو رنٛگؠ خٟمن تہٕ قربان گاہَن انٛدؠ پٔکؠ دنہٕ یوان ٲسؠ۔ یم صحنہٕ کیٚن دروازن پٮ۪ٹھ ٲسؠ تہٕ خٟمہٕ گنڈنہٕ چن رزن۔ تِمو کٔر مقدس خٟمس نیٚبرٕ کنہِ چیزن ہنٛزِ رٲچھ راوچہِ ہنٛز تہِ سٲرےٕ کٲم۔
\v 27 قہاتؔ قبیلہٕ منٛزٕ یمہٕ ٲسؠ تِمہ ٲسؠ تمسنٛدین نیٚچوٮ۪ن عمرامؔ اضہارؔ، حبرونؔ تہٕ عُزی ایلؔ سنٛدؠ۔
\v 28 تِمن ژۅنونؠ قبیلن منٛز ٲسؠ ٲٹھ ساس شےٚ ہتھ بچہٕ یہنٛز وانٛس کمس کم اکھ رٮ۪تھ ٲس۔ امہِ قبیلہٕ کیٚن مردن ہنٛز کٲم ٲس مقدس خٟمس منٛز موجود چیزن ہنٛز رٲچھ راوٕٹ کرٕنؠ۔
\v 29 تِمو لٲگؠ مقدس خٟمس جنوٗب طرفہٕ پنٕنؠ خٟمہ۔
\v 30 یِمن ژۅنونؠ قبیلن ہُنٛد سردار اوس عزییلؔ سُنٛد نیٚچو الِیصفنؔ۔
\v 31 یِمن قبیلہٕ کیٚن نفرن ہنٛز کٲم ٲس مقدس صندوقس نظر گُزر تھاونؠ، تتھ میزس یتھ پٮ۪ٹھ کاہن مقدس ژۅٹ تھاوان ٲسؠ، ژٲنگؠ تارن، قربان گاہن، تہٕ تِمن سارنی چیزن یمہٕ کاہن مقدس خٟمس منٛز استعمال کران ٲسؠ۔ تتھ پردس یُس مقدس خٟمس انٛدر اوس۔ تِہنٛز کٲم ٲس خٟمس منٛز موجود چیزن ہُنٛد تہِ خیال تھاوُن۔
\v 32 ہارون سُنٛد نیٚچو الِیعزرؔ اوس لاوی سنٛدین سارنی زُرین ہُنٛد سردار۔ سُہ اوس تِمن سارنی کامیٚن ہنٛز نگرٲنی کران یمہٕ مقدس خٟمس منٛز آسان آسہٕ۔
\v 33 مراریؔ قبیلٕکؠ یم تہِ ٲسؠ تِم ٲسؠ محلی تہٕ موشیؔ سنٛدیو اولادو منٛزٕ۔
\v 34 یمو دوٚنویو قبیلو منٛزٕ ٲسؠ شےٚ ساس زٕ ہتھ بچہٕ یہنٛز وانٛس کمس کم اکھ ریٚتھ ٲس۔
\v 35 تِمن آو وننہٕ زِ تِم دِن پنٕنؠ خٟمہ شمال انٛدٕ۔ یمن دوٚنونؠ قبیلن ہُنٛد سردار اوس ابیحائیلؔ سُنٛد نیٚچو صوری ایلؔ۔
\v 36 یِمن دوٚنونؠ قبیلن ہنٛدین نفرن ہنٛز ذمہ دٲری ٲس تِمن چۅکاٹھن نظرگُذر تھاونؠ یِمن پٮ۪ٹھ خٟمہ دٔرِتھ ٲسؠ، کھٕژن، تھمبن تہٕ کھوریٚن ہنٛز۔ تِمو کرِ تِم سارے کامہِ یمہ یِمن چیزن سٟتؠ مُنسلِک آسہ۔
\v 37 تِمن ہنٛز کٲم ٲس تِمن ڈکھن ہنٛز حفاظت تہِ کرٕنؠ یِم صحنس منٛز بنٲومٕتیٚن دیوارن ہنٛدین پردن تھپھ ٲسؠ تہٕ تِمن پردن دٔرراونٕچہ جایہ خٟمن ہنٛدین ۅبیٚن تہٕ رزن ہنٛز رٲچھ تہِ۔
\v 38 ہارونسؔ، موسیٰؔ ہس تہٕ ہارونؔ سنٛدین نیٚچوٮ۪ن آو وننہٕ زِ تِم لاگن مقدس خٟمس برُونٛہہ کنہِ مشرقہٕ انٛدٕ پنٕنؠ خٟمہ۔ تہنٛز کٲم ٲس تِمن کامیٚن ہنٛز نگرٲنی کرنؠ یمہ مقدس خٟمس انٛدرٕ تہٕ تتھ انٛدؠ پٔکؠ، اسرائیلی لوٗکن ہنٛدِ فٲیدٕ باپتھ سپدان آسہ، یہ کرنُک اجازت اوس صرف کاہنن۔ یہُوواہنؔ کوٚر اعلان زِ اگر بیٚیہِ کانٛہہ یہ کرنہِ خٟمس نزدیک گژھِ تہٕ سۅ کٲم کرِ یۅسہ کاہن کران چھِ تس گژھِ پھٲسؠ دِنؠ۔
\v 39 ییٚلہ ہارونن تہٕ موسیٰؔ ہن تِم سٲری لڑکہٕ گنٛزرٲوؠ یہنٛز وانٛس لگ بگ اکھ ریٚتھ ٲس تہٕ یم لاوی قبیلس سٟتؠ تعلق ٲسؠ تھاوان ٲسؠ کُل زٕتووُہہ ساس۔
\v 40 امہِ پتہٕ ووٚن یہُوواہنؔ موسیٰؔ ہس زِ وۅنؠ گنٛزراوُکھ اسرائیلس منٛز باقی زِٹھؠ لٔڑکہ یِم کمس کم اکہِ ریٚتٕکؠ آسن تہٕ تہنٛدؠ ناو لیٚکھیٚو۔
\v 41 تہٕ میانہِ خٲطرٕ کٔرووکھ لاوین ہنٛدؠ اولاد دویمیٚن اسرائیلی لڑکن ہنٛدؠ متبٲدِل مقرر تہٕ میانہِ باپتھ کٔرووکھ لاوین ہنٛدیٚن اولادن ہنٛدؠ چاروٲے الگ تاکہِ تِم بنن باقی اسرائیل کیٚن زِٹھیٚن چارواین ہنٛدؠ مُتبادِل۔
\v 42 لہٰذا کۅر موسیٰؔ ہن یی۔ تٔمؠ کٔر اسرائیل کیٚن سارنی زِٹھیٚن لٔڑکن گرینٛد یتھٕ کِنؠ زن یہُوواہنؔ حکم دیتمُت اوس۔
\v 43 یِم کمس کم اکہِ ریٚتٕکؠ ٲسؠ تِہنٛز تعداد ٲس زٕ توٗووہ ساس زٕ ہتھ تروستھتھ نفر۔
\v 44 پتہٕ ووٚن یہُوواہنؔ موسیٰؔ ہس،
\v 45 "لاوین ہنٛدؠ اولاد کڈُکھ الگ تاکہِ تِم بنَن باقی اسرائیلی زِٹھیٚن لٔڑکن ہنٛدؠ مُتبٲدِل۔ لاوین ہنٛدؠ اولاد چھِ میانؠ، یہُوواہؔ۔
\v 46 باقی اسرائیل کیٚو زِٹھیٚو لٔڑکو منٛزٕ ٲسؠ 273 لاوین ہنٛدیٚو اولادو نِشہ زیادٕ۔
\v 47‏-48 یمن 273 لٔڑکن ہُنٛدِ ماوضہٕ رنٛگؠ آے پرٛتھ کانٛسہ ہنٛدِ بدلہٕ سۅنہٕ سنٛدؠ پانٛژھ پانٛژھ ٹُکرٕ جمع کرنہٕ۔ \f + \fr 3‏:47‏-48 \ft تقریباً 57 گرام چٲندؠ\f*چانٛدِ ہنٛدیٚن یِمن ٹُکرن ہُنٛد وزن گژھِ چاندِ ہنٛدیٚن ٹُکرن برابر آسُن یمہ مقدس خٟمس منٛز تھاونہٕ ٲسؠ آمٕتؠ۔ یہ چانٛدؠ دِیو ہارونسؔ تہٕ تمسنٛدین نیٚچوٮ۪ن\f + \fr 3‏:47‏-48 \ft گیرِ اوس وزنُک ساروٕے کھۅتہٕ لۅکُٹ حصہٕ، یُس 0:6 گرام کھۅتہٕ کم اوس۔\f*۔
\v 49 لہٰذا کۅر یہ موسیٰؔ ہن۔ تٔمؠ کٔر یِمن 173 تھَن نفرن ہنٛز چانٛدؠ حٲصِل۔
\v 50 \f + \fr 3‏:50 \ft تقریباً ساڑ پنداہ کلو چٲندؠ۔\f*چانٛدِ ہنٛدؠ ٲسؠ کُل اکھ ساس ترےٚ ہتھ تہٕ پنٛژہٲٹھ ٹُکرٕ۔ چانٛدِ ہنٛدِس پرٛتھ کُنہِ سِکس اوس مقدس خٟمس منٛز موجود چانٛدِ ہنٛدیٚن سِکن برابر وزن۔
\v 51 موسیٰؔ دِتؠ یمہ چانٛدِ ہنٛدؠ ٹُکرٕ ہارونسؔ تہٕ تمسنٛدین نیٚچوٮ۪ن یہ زن یہُوواہؔ سُنٛد حکم اوس۔
\c 4
\p
\v 1 پتہٕ ووٚن یہُوواہنؔ موسیٰؔ تہٕ ہارونسؔ مزید،
\v 2 تِمن نفرن ہنٛدؠ ناو لیٚکھیٚو یِم قہاتؔ قبیلس سٟتؠ تعلُقق چھِ تھاوان۔
\v 3 تِمن نفرن ہنٛدؠ ناو لیٚکھیٚو یہنٛز وانٛس 30 پٮ۪ٹھ 50 وری تام آسہ۔ یِم آسن تِم نفر یِم مقدس خٟمس منٛز کٲم کرن۔
\v 4 قہاتؔ کیٚن یِمن نفرن ہنٛز کٲم ٲس تِمن مقدس چیزن ہنٛز رٲچھ راوٕٹ کرٕنؠ یمہٕ مقدس خٟمس منٛز عبادت کرنہٕ وزِ استعمال سپدان ٲسؠ۔
\v 5 ییٚلہ توٚہؠ اسرائیل لٕکؠ کُنہِ دوٚیمہ جایہ گٔژھیٚو، ہارونؔ تہٕ تمسنٛدیٚن نیٚچوٮ۪ن پزِ خٟمس منٛز اژُن تاکہ تِم والن سُہ پردٕ یُس مقدس خٟمس منٛز مقدس مقام مقدس جایہ نِشہ الگ چُھ کران۔
\v 6 پتہٕ کرن تمہٕ تتھ اصل چمبرو غلاف۔ تمہ پتہٕ ولنس سبٕز رنٛگُک کپُر۔ تہٕ تُلنہٕ باپتھ برَن لکٕرِ ہنٛدؠ تھمب صندوق کیٚن کُنٛڈن منٛز۔
\v 7 پتہٕ تراون میزس پٮ۪ٹھ سبٕز رنٛگُک کپُر یتھ پٮ۪ٹھ کاہن خدایس برُونٛہہ کنہِ ژۅٹ تھاون۔ کپر ژادرِ پٮ۪ٹھ تھاوَن مُشکہٕ دٲنؠ، تٲو، باقی بانہٕ، شرابہٕ باپتھ نارِ یُس نیازٕ رنٛگؠ پیش سپدِ تہٕ مقدس ژۅٹ۔
\v 8 اتھ سٲرسےٕ پٮ۪ٹھ تراون تِم ضروری اکھ ۅزٕج کپر ژادر۔ تہٕ ٲخرس کرن اتھ نفیس چمبرو بناونہٕ آمٕژ غلاف۔ پتہٕ پزنَکھ میزس کونن پٮ۪ٹھ پکناونہٕ باپتھ کُنڈٕ لاگٕنؠ۔
\v 9 پتہٕ انَن سبٕز رنٛگٕچ بیاکھ کپَر ژادر سۅ ولن شمعدانن، ژانٛگیٚن، سوئتن، مجمن تہٕ ژانٛگین زالنہٕ باپتھ زیتون تیٖلہٕ کیٚن خاص بانن۔
\v 10 تِم ولن ژٲنگؠ تارن تہٕ باقی تمام چیزن اصل چمبرو بستو سٟتؠ۔ تِمن پزن یم تمام چیز پکناونہٕ باپتھ أکِس چۅکاٹھس تھاونؠ۔
\v 11 پتہٕ تھاون تِم سۅنہٕ سنٛزِ تتھ قربان جایہ پٮ۪ٹھ تہِ اکھ نیج کپر ژادر ضرور یۅسہ مُشِک زالنہٕ باپتھ استعمال سپدان چھےٚ۔ تتھ پٮ۪ٹھٕ تراون پتہٕ چمبرس بناونہٕ آمٕژ اکھ نفیس غلافہِ ہٕن۔ پتہٕ لاگن قربان گاہ کیٚن کریٚن منٛز سۅ پکناونہٕ باپتھ ڈنٛڈٕ۔
\v 12 تِم تھاون دوٚیم تمام چیز یمہ مقدس خٟمس انٛدر چھِ نیٖلِس کپرس ؤلِتھ تہٕ چمبرو زٲوجہِ بستہِ بناونہٕ آمژِ غلافہِ منٛز تہٕ یم چیز ننہٕ خٲطرٕ تھاون أکِس چۅکاٹھس پٮ۪ٹھ۔
\v 13 پتہٕ ڈُون قربان گہَس سُہ سوٗر یُس تِمو بُزٕمژو قربٲنیٚو سٟتؠ تروٕمُت اوس۔ پتہٕ ولن سۅ قربان گاہ وانٛگٕنؠ رنگہٕ کپرٕ سٟتؠ۔
\v 14 پتہٕ تراون تِم قربان گاہٕکؠ تمام چیز تتھ کپر ژادرِ پٮ۪ٹھ وہرِتھ۔ یعنی تٔتؠ ینٛگر پکناونہٕ باپتھ لیٚجہ، ماز کھنٕکؠ کانٛٹہٕ، بیلچہٕ، تِم پیالہٕ یمن منٛز لوٗکن چھکنہٕ باپتھ خوٗن چُھ رٹنہٕ یوان تہٕ باقی تمام بانہٕ بٹھٕ۔ پتہٕ تھاون یِم سٲری چیز زٲولِس چمبرس بناونہٕ آمژن نفیس غلافن ؤلِتھ۔ امہِ پتہٕ پزنکھ یہ پکناونہٕ باپتھ قربان گاہ کیٚن انٛدن پٮ۪ٹھ کریٚن منز ڈنٛڈٕ لاگٕنؠ۔
\v 15 ییٚلہ ہارون تہٕ تمسنٛدؠ اولاد یمہ سٲری چیز بنٛد کٔرِتھ مۅکلاون تہٕ اسرائیل لٕکؠ لوٗکھ اکِس نیٚیہ جایہ گژھنہٕ خٲطرٕ تیار سپدن۔ قہاتؔ سنٛدین اولادن پزِ یُن تہٕ سری مقدس چیز بییِس جایہ واتناونؠ۔ مگر قہاتؔ قبیلہٕ کیٚن اولادن پزِنہٕ کُنہِ تہِ مقدس چیزس اتھٕ لاگُن، تکیازِ اگر تِم تتھ اتھٕ لاگن تِم مرن تٔتی۔ یِم چھِ تمہٕ یمہ یمن چیزن پکنٲوِتھ ہیٛکن مگر اتھٕ ہیٚکن نہٕ لٲگِتھ۔
\p
\v 16 ہارونؔ سنٛدِس نیٚچوِس الِیعزرؔس اتھِ آسہ ژانگیٚو باپتھ زیتون تیٖل، مُشکہٕ دانہِ، قربان گاہَس پٮ۪ٹھ پرٛتھ دوٚہہ زالن وول اوٹ تہٕ کاہنن مسح کرنہٕ باپتھ زیتون تیٖل۔ الِیعزرؔ چُھ سُہ یُس مقدس خٟمس منٛز سپدن واجنیٚن کامیٚن ہنٛز نگرٲنی کرِ تہٕ یہےَ چُھ سُہ نفر یُس تتہِ پرٛتھ چیزُک نگران آسہ۔
\v 17 پتہٕ ووٚن یہُوواہنؔ ہارونس تہٕ موسیٰؔ ہس مزید،
\v 18‏-20 ییٚلہ قہاتؔ سنٛدؠ اولاد مقدس خٟمس منٛز موجود مقدس چیز کُنہ دوٚیمہ جایہ ننہٕ خٲطرِ واتن، ہارون تہٕ تمسنٛدیٚن اولادن پزِ ہمیشہٕ تِمن نشہٕ واتُن۔ تِمن نشہٕ گٔژھتھ تِمو منٛزٕ پرٛتھ اکِس ونُن زِ کۅسہٕ کٲم چھےٚ کرنؠ تہٕ کٕمہ چیٖز چھِ نِنؠ۔ مگر قہاتؔ کیٚن اولادن پزِنہٕ بیٚیہِ کُنہِ وزِ مقدس خٟمس منٛز اژُن تہٕ تتہِ موجود چیز وُچِھنؠ۔ اگر تِم یہ کرن تہٕ بہٕ تُلناوٕ تیٚلہ قہات کہ تمام قبیلہٕ نشہٕ تھف۔
\v 21 یہُوواہنؔ ووٚن موسیٰؔ ہس یتہِ زِ،
\v 22 تِمن سانی نفرن ہنٛدؠ ناو لیٚکھیٚو یِم جیرسونؔ قبیلس سٟتؠ تعلق چھِ تھاوان۔
\v 23 تِمن مردن ہنٛدؠ ناو کٔریٚو درج یِمن ہنٛز ترٛہیٚیہ پٮ۪ٹھٕ پنٛژاہ وری تام چھےٚ۔ یمے آسن تِمہ نفر یمہٕ مقدس خٟمس پٮ۪ٹھ کٲم کرن۔
\v 24 یہ چھےٚ سۅ کٲم یۅسہ تِمن ضروری کرٕنؠ چھےٚ تہٕ ییٚلہ کُنہِ نوِ جایہ گژھن یم چیز پکہٕ ناون ضروری پانس سٟتؠ:
\v 25 تِم تُلن مقدس خٟمٕکؠ پردٕ۔ تِم تُلن مقدس خٟمہٕ تہٕ تِم سٲری چیز یمو سٟتؠ سُہ ولنہٕ یوان چُھ۔ یتھ منٛز نفیس چمبرٕ سٟتؠ بناونہٕ آمٕژ نیٚبرِم غلاف تہٕ سُہ پردٕ یُس مقدس خٟمہ کِس دروازس پٮ۪ٹھ چُھ۔
\v 26 تمہٕ پردٕ تہِ تُلن یمہٕ صحنس منٛز مقدس خٟمس تہٕ قربان گاہَس انٛدؠ انٛدؠ دیوار بنٛدی لگان چھِ تہٕ سُہ پردٕ تہِ یُس صحنچہِ برٕنؠ پٮ۪ٹھ چُھ، بیٚیہِ تُلن تِمہ رزٕ یمو سٟتؠ پردٕ گنٛڈنہٕ یوان چھِ۔ تِم گنٛڈن تہٕ برن یہ سورےٕ سامانہٕ پانہ۔
\v 27 ہارونؔ تہٕ تمسنٛدؠ نیٚچوؠ کرن جیرشومؔ سنٛدین سارنی اولادن ہنٛزِ کامہ ہنٛز نگرٲنی۔ یتھ منٛز یمہٕ چیز پکناوٕنؠ تہٕ یمہٕ پکناونس منٛز ضروری شٲمل چھےٚ۔ تِم ونن جیرشومؔ سنٛدین اولادو منٛزٕ پرٮ۪تھ أکِس زِ کَس کُس چیز چُھ پکناوُن لٲزمی۔
\v 28 یِم چھےٚ تِمہ کامہ یمہٕ توٚہہ تِمن نفرن دِنہ چھےٚ یمہٕ خیرشوم قبیلس سٟتؠ تعلق تھاوان چھِ۔ ہارونؔ سُنٛد نیٚچو اِتمرؔ چُھ سُہ یُس تہنٛز کامہِ نگرٲنی کرِ۔
\v 29 مراریؔ قبیلٕکؠ نفر تہِ گنٛزرٲؠ ووکھ۔
\v 30 تِمن مردن ہنٛدؠ ناو کٔریٚو درج یمن ہنٛز وانٛس ترٛیہیہِ پٮ۪ٹھٕ پنٛژاہن ورؠ ین درمیان چھےٚ۔ یمہٕ آسن تِمہ مرد یمہٕ مقدس خٟمس منٛز تہِ کٲم کرن۔
\v 31 تِمن ہنٛز کٲم آسہ تِم چۅکاٹھ تُلٕنؠ یِمن پٮ۪ٹھ مقدس خٟمہٕ دٔرِتھ چُھ، تٔمچہِ پھلیہِ کرِ تِمہ کٔرؠ یمن پٮ۪ٹھ پردٕ دٔرِتھ چھِ تہٕ بیٚیہِ کھوٗرؠ۔
\v 32 تِمن چھِ تِمن پردن ہنٛدؠ ڈکھ تہِ تُلٕنؠ یِمو سٟتؠ صحنس منٛز دیوار بنٛدی سپدان چھےٚ، تہنٛدؠ کھوٗرؠ خٟمو خٲطرٕ چِل تہٕ پردٕ گنٛڈنہٕ خٲطرٕ رزٕ تہٕ سٟتؠ تُلنہِ۔ پرٛتھ کانٛسہِ نفرس چُھ ونُن زِ کس کُس چیز چُھ تلُن۔
\v 33 یمہٕ چھےٚ تِمہ کامہِ یمہٕ مراریؔ قبیلہٕ کیٚن مقدس خٟمس منٛز کرنہِ چھےٚ۔ ہارونؔ سُنٛد نیٚچو اِتمرؔ چُھ سُہ یُس یہنٛز نگرٲنی کرِ۔"
\v 34 چونکہِ ہارونؔ، موسیٰؔ تہٕ اسرائیلی زِٹھیٚو گنٛزرٲوؠ قہاتؔ زٲژ ہنٛدؠ تہٕ تہنٛدیٚن قبیلن تہٕ خاندٲنؠ گرانن ہنٛدؠ ناو تہِ کٔرِکھ درٕج۔
\v 35 تِمو گنٛزرٲوؠ تِمہ سٲری نفر یہنٛز وانٛس ترٛیہیہِ پٮ۪ٹھٕ پنٛژاہن ؤرین درمیان ٲس تہٕ مقدس خٟمس منٛز کٲم کرنَس قٲبل ٲسؠ۔
\v 36 کُل ٲسؠ زٕ ساس ستھ ہتھ تہٕ پنٛژاہ نفر۔
\v 37 تمہٕ ٲسؠ قہات سنٛدیو زُریٚو منٛزٕ یمہٕ مقدس خٟمس منٛز کٲم کرنس لایکھ ٲسؠ۔ ہارونؔن تہٕ موسیٰؔ ہن کۅر تِہُنٛد شُمار تِتھے پٲٹھؠ یتھ کنؠ خداوندن موسیٰؔ ہس حکم دیُتمت اوس۔
\v 38 تِمو گنٛزرٲوؠ جیرسون زٲژ ہنٛدؠ نفر تہِ تہٕ تِہنٛدین قبیلن تہٕ خاندٲنؠ ونٛڈن ہنٛدؠ ناو تہِ کٔرِکھ درٕج۔
\v 39 تِمو گنٛزرٲوؠ تِم سٲری نفر یہنٛز وانٛس ترٛیہیہِ پٮ۪ٹھٕ پنٛژاہن ؤرین تام ٲس، یم مقدس خٟمس منٛز کٲم کرنَس قٲبل ٲسؠ۔
\v 40 لٲوین ہُنٛد کُل تعداد اوس زٕ ساس شےٚ ہتھ ترٕ۔
\v 41 تِمہ چھِ جیرسون قبیلٕکؠ یمہٕ مقدس خٟمس منٛز کٲم کرٕنؠ لایکھ چھِ۔ ہاروننؔ تہٕ موسیٰؔ ہن کٔرؠ تِم تِتھے کِنؠ شمار یتھٕ کنؠ تِمن یہُوواہنؔ حکم دیُتمت اوس۔
\v 42 تِمو کٔر مراریؔ نسلٕکیٚن تہِ گرٛینٛد تہٕ تِہنٛدین قبیلن تہٕ خاندٲنؠ ونٛڈن ہنٛدؠ ناو تہِ کٔرِکھ درٕج۔
\v 43 تِمو گنٛزرٲوؠ تِم سٲری نفر یہنٛز وانٛس ترٛیہیہِ پٮ۪ٹھٕ پنٛژاہن ؤرین تام ٲس، یم مقدس خٟمس منٛز کٲم کرنَس قٲبل ٲسؠ۔
\v 44 تِہُنٛد کُل تعداد اوس ترےٚ ساس زٕ ہتھ نفر۔
\v 45 تِم ٲسؠ مراری زٲژ ہنٛدؠ یِم کٲم کرنس لایکھ ٲسؠ۔ ہارونؔن تہٕ موسیٰؔ ہن کۅر تِہُنٛد شُمار تہِ تِتھے پٲٹھؠ یتھ کنؠ یہُوواہنؔ موسیٰؔ ہس حکم کۅرمُت اوس۔
\v 46 یتھٕ کنؠ کٔرؠ ہاروننؔ، موسیٰؔ ہن تہٕ اسرائیلی زِٹھیٚو تمام لاوی شمار تہٕ یہنٛدیٚو قبیلو تہٕ خاندٲنؠ کُمبو حسابہٕ کٔرِکھ درِج۔
\v 47 تِمو گنٛزرٲوؠ تِم سٲری نفر یہنٛز وانٛس ترٛیہیہِ پٮ۪ٹھٕ پنٛژاہن ؤرین تام ٲس یمہٕ ٲسؠ تِم لوٗکھ یمہٕ مقدس خٟمس منٛز کٲم کرٕنؠ لایکھ ٲسؠ تہٕ یمہٕ خٟمہٕ تہٕ اتھ سٟتؠ مُنسلِک پرٛتھ اکھ چیز پکناوان ٲسؠ۔
\v 48 یِمن ہُنٛد کُل تعداد اوس ٲٹھ ساس پانٛژھ ہتھ شیتھ نفر۔
\v 49 یمو کٔر لاوین ہنٛدین سارنی قبیلن ہنٛز گرینٛد مکمل یتھٕ کنؠ زن موسیٰؔ ہس یہُوواہنؔ فرموٕمُت اوس۔ تہٕ تِمو ؤنؠ پرٛتھ أکِس فردس پنٕنؠ پنٕنؠ کٲم زِ کٔمِس کۅسہٕ کٲم چھےٚ مٹہِ تہٕ کٔمس کیاہ چُھ تلُن ییٚلہ تِمن کُنہِ نوِ جایہ گژھن آسہ۔
\c 5
\p
\v 1 یہُوواہنؔ ووٚن موسیٰؔ ہس مذید،
\v 2 "اسرائیلی لوٗکن ؤنیٚو زِ تِم تھاون تِمن نفرن پننیٚو خٟمو نِشہ دوٗر یمہٕ مینٛدؠ\f + \fr 5‏:2 \ft مینٛدؠ لد\f* بٮ۪مارِ منٛز مُبتلا آسن یا اگر کُنہ قسمُک پَس نیران آسیٚکھ چاہے مرٕد آسہ یا زٔنؠ، بیٚیہِ سُہ شخص یُس کانٛسہ مُردس اتھٕ لاگنہٕ سٟتؠ ناپاک گٔژھِتھ خدایس قبول آسہ نہٕ۔
\v 3 تِم لوٗکھ یِمن مٕسلن ہنٛز خوفناک بٮ۪مٲرؠ آسہ یا پَس نیران آسیٚکھ، کٔڑؠ ووکھ پننیٚو خٟمہ گاہو نِشہ دوٗر یُتھنہٕ خٟمہ گاہن ہنٛدِس علاقس منٛز یتہِ بہٕ توٚہہ سٟتؠ روزان چُھس تتہِ کیٚن لوٗکن اتھٕ لاگن تہٕ تِم سپدن میانہِ خٲطرٕ نا پسنٛد۔"
\v 4 یتھٕ پٲٹھؠ کٔر اسرائیل یو تتھ حکمس پٮ۪ٹھ عمل یُس یہُوواہنؔ موسیٰؔ ہس کۅر۔
\v 5 یہُوواہنؔ ووٚن موسیٰؔ ہس یتہِ،
\v 6 "یہ کتھ ؤنیٚو اسرائیلی لوٗکن: 'اگر کانٛہہ شخص کانٛسہِ فردٕ سنٛدؠ گناہ ہیٚوان چُھ، بہٕ چُھس زانان زِ تٔمؠ شخصن کۅر مےٚ پٮ۪ٹھ ظُلم۔
\v 7 تٔمس شخصس پزِ اقبالِ جُرم کرُن زِ بہٕ چُھس قصوروار، تہٕ أمِس پزِ تمِس شخصس کُن کفارٕ ادا کرُن یمِس سٟتؠ تٔمؠ غلط کۅرمُت آسہ یمہ سٟتؠ سُہ یا سۅ رٲزؠ سپدیس تہِ پزیٚس تس ادا کرُن، اکھتُے پزیٚس تمہِ نشہٕ وُہہ فیصد رقم زیادٕ ادا کرُن۔
\v 8 اگر سُہ شخص یمِس ظلُم کرنہٕ آمُت آسہ فوت سپدِ تہٕ کانٛہہ وٲرث آسیٚس نہٕ یس سُہ رقم دمہٕ ہو، سُہ رقم چُھ میٚون تہٕ گژھِ کاہنن حوالہٕ یُن کرنہٕ۔ امہِ علاوٕ چُھ تٔمس یمؠ غلط کۅرمُت آسہ اکھ کٹھ قربٲنی خٲطرٕ کاہنن دیٚون تاکہِ تمِس شخصہٕ سنٛدؠ گناہ سپدن معاف۔
\v 9 تِم تمام مقدس نذرانہٕ یِم اسرائیلی لوٗکھ کاہنن دِتھ مےٚ پیش کران چھِ، تِم چھِ کاہنن ہنٛدؠ
\v 10 کاہن ہیٚکن تِمہ تحفہٕ پانس تھٲوِتھ۔"
\v 11 یہُوواہنؔ ووٚن موسیٰؔ ہس یتہِ:
\v 12 "یہ کتھ وَن اسرائیلی لوٗکن، فرض کرو اگر کانٛسہِ مردس یہ باسان آسہ زِ میانؠ خاندارِنؠ چھنہٕ ہمیشہ مےٚ سٟتی شونٛگِتھ وفادٲری نباوان۔
\v 13 فرض کرو تمِس آسہ باسان زِ سۅ چھےٚ کانٛسہ دوٚیمِس نفرس نِش شونٛجمٕژ مگر یہ آسیٚس نہٕ خبر زِ یہ چھا پوٚز کِنہٕ نہ تکیازِ تٔمؠ آسہ نہٕ سۅ یہ کران وُچھمٕژ۔ سۅ آسہ نہٕ یہ کران رٹنہٕ آمٕژ تہٕ نہ ہیٚکو یہ حقیقت ثٲبت کٔرِتھ زِ امہِ چھےٚ پننِس خاندارس سٟتؠ بےوفٲیی کٔرمٕژ تکیازِ سۅ وُچھ نہٕ کٲنسہِ یہ کران۔
\v 14 وۅنؠ اگر أمِس زنہِ ہُنٛد خاندار باغٲرت آسہ تہٕ شک آسیٚس امہِ چُھ غلط کۅرمُت، تہٕ سُہ آسہ زانُن یژھان یہ چھا پوٚز کِنہٕ اپُز، تمِس ننہِ یتھٕ پٲٹھؠ زِ یہ چھےٚ مٔکٕر سپٕزمٕژ۔
\v 15 یہ پرکھاونہٕ خٲطرٕ زِ آیا امہِ چھا ناجایز کۅرمُت نِین سُہ پنٕنؠ گرٕواجِنؠ کاہنس نِش۔ تمِس پزن نیازٕ باپتھ کٕنکہٕ آٹِکؠ زٕ کِلو نِنؠ\f + \fr 5‏:15 \ft اکھ کلو اوٹ \f*۔ کاہنس پزِ نہٕ اتھ پٮ۪ٹھ نہ زیتون تیٖل تراوُن تہٕ نہ لُبان تھاوُن تکیازِ یہ چُھ سُہ نذرانہٕ یُس أمؠ نفرن امہِ حسدٕ مۅکھٕ اوٚنمُت چُھ زِ أمِس گژھِ امہِ نذرانہٕ سٟتؠ ننُن زِ سۅ چھا قصور وار کنہٕ نہ۔
\v 16 کاہن انہِ پتہٕ أمِس زنہِ تہٕ ونیٚس مےٚ تھی روز یتھ قربان گاہَس برُونٛہہ کنہِ کھڑا۔
\v 17 سُہ تراوِ کتریٚو بانس منٛز مقدس آب تہٕ پتہٕ تُلہِ مقدس خٟمہ کہ فرشہٕ پٮ۪ٹھٕ کینٛہہ میٚژ تہٕ تراوِ اتھ آبس منٛز۔
\p
\v 18 سُہ مُژراوِ أمِس زنہِ ہُنٛد مَس۔ پتہٕ دییہِ سُہ تمِس اتھس منٛز نیازُک اوٹ یُس تمسنٛدؠ غٲرت منٛد خاندار یہ نٔنراونہٕ باپتھ پیش کران چُھ زِ امہِ چھا غلط کۅرمُت کِنہ نہ۔ کاہن رٹہِ اتھس کیٚتھ اکھ پیالہٕ یتھ منٛز ٹیٚوٹھ آب آسہ یمہِ سٟتؠ سۅ زٔنؠ لانتی ثٲبت سپدِ اگر سۅ قصور وار آسہ۔
\v 19 کاہنس پزِ سۅ قسم کھیٲوِتھ اعلان کرناوٕنؠ زِ ونہِ پۅز۔ تس چُھ تمِس ضروری ونُن، "کیاہ ژےٚ سٟتؠ شونٛگا بیٚیہِ کانٛہہ وۅپر نفر؟ کیاہ ژٕ شونٛجہ کھا ایماندٲری سان صرف پننِس خاندارس سٟتؠ کِنہٕ نہ؟ اگر ژٕ کانٛسہِ دویٚمِس نفرس نِش شونٛجمٕژ چھیٚکھ نہٕ تیٚلہ اگر ژٕ یہ آب چیٚکھ ژےٚ گٔژھی نہٕ کِہین۔
\v 20 وۅنؠ اگر ژٕ کانٛسہِ دویمِس نفرس نِش شونٛجمٕژ آسکھ تہٕ یہُوواہؔ وٲلی ژےٚ لانتھ۔
\p
\v 21‏-22 اتھ وقتس پٮ۪ٹھ پزِ کاہنن یہِ ؤنِتھ زنانہِ حلف تلُن، "لوٗکن لگہ پتاہ زِ یہُوواہؔ سنٛز لعنت چھےٚ توٚہہِ پٮ۪ٹھ ییٚلہِ سُہ توٚہہِ بانجھ بناوان چُھ، یمہِ سٟتؠ تُہنٛد حمل چُھ پھُٹان۔ یمہِ سٟتؠ چٲنؠ بچہٕ دٲنؠ ژمہِ تہٕ چٲنؠ یڈ ہُنہِ۔ ژےٚ ہیٚکہٕ نےَ نہٕ زانٛہہ تہِ شُرؠ زیٚتھ امیُک نتیجہ نیرِ یہ زِ ژےٚ ٲسی پرٛتھ اکھ بددُعا دِوان تہٕ ژےٚ نِش آسن دوٗر ژلان۔ اگر ژٕ کانٛسہِ نِش شونٛجمٕژ ٲسٕکھ، تہٕ پتہٕ یہ آب چیٚکھ ژےٚ سٟتؠ سپدِ ضرور یہ۔ امہِ پتہٕ پزِ زنہِ جواب دیُن، "اگر بہٕ مجرم آسہٕ، تہٕ مےٚ سٟتؠ سپدِ یہ مےٚ چُھنہٕ تیٚلہ اعتراض۔
\v 23 پتہٕ پزن کاہنس أکس لۅکٹِس کاغذس پٮ۪ٹھ میٖلہِ سٟتؠ یمہٕ لانتہٕ لیٚکھنہِ تہٕ پتہٕ یہ میٖل اتھ ٹیٚٹھِس آبس منٛز چھلٕنؠ۔
\v 24‏-25 پتہٕ گژھِ کاہن أمِس نِشہ کٕنکہٕ اوٹ رٹُن یُس تمِس نِش آسان چُھ تہٕ تمِس پزِ سُہ مےٚ نذر کرنہٕ باپتھ تلُن تہٕ قربان گاہس پٮ۪ٹھ تراوُن۔
\v 26 تہٕ امیُک کینٛہہ حصہٕ قربانی رنٛگؠ زالُن۔ پتہٕ پزِ أمِس زنہِ یہ ٹیٚوٹھ آب چیٚون۔
\v 27 اگر امہِ زنہِ پننِس خاندارس سٟتؠ وفادٲری سان شونٛگنہٕ بجایہ ناجایز کۅرمُت آسہ تیٚلہ واتہِ امہ آبہٕ سٟتؠ تمِس واریاہ تکلیف۔ تمؠ سنٛزِ یٔڈ کھسہِ پُھۅکھ تہٕ بچہٕ دٲنؠ ژمیٚس۔ سۅ روزِ نہٕ بچہٕ دِنس قٲبل۔ تہٕ پتہٕ آسن تس پنٕنؠ رشتہٕ دار لانت ملامت کران۔
\v 28 وۅنؠ اگر سۅ بے قصور آسہ تیٚلہ واتہ نہٕ تٔمسنٛدِس جسمَس کانٛہہ نقصان تہٕ سۅ ہیٚکہِ پتہٕ بچن تہِ زایُن دِتھ۔
\v 29 یہ چھےٚ سۅ رسٕم یۅسہ تمہِ وزِ ورتاونہٕ ییہِ ییٚلہِ کانٛہہ نیترٕ واجِنؠ زٔنؠ بدکٲری ہُنٛد گناہ کرِ،
\v 30 یا ییٚلہ کانٛسہِ مردس حسد وۅتھِ تہٕ شک پٲدٕ گژھیٚس زِ تمؠ سنٛز خاندارنؠ چھےٚ کانٛسہِ نِش شونٛجمٕژ۔ کاہنس پزِ تمِس زنہِ ونُن زِ میانہِ موجودگی منٛز روز قربان گاہس پٮ۪ٹھ کھڑا تہٕ کرِ تِمن ہدایہ تن پٮ۪ٹھ عمل۔
\v 31 حطاکہِ اگر نہٕ تٔمہِ زنہِ سۅ غلط کٲم کٔرمٕژ آسہ یتھ پٮ۪ٹھ تمسنٛدس خاندارس شک گمُت آسہ تیٚلہ تہِ ییہِ نہٕ تمِس کانٛہہ سزا دنہٕ اگر تٔمؠ پنٕنؠ خاندارِنؠ امہ باپتھ کاہنس نشہٕ نیٚیہ۔ وۅنؠ اگر تمؠ سنٛز خاندارِنؠ قصوروار ٲس تیٚلہ ییہِ تمِس امیُک سزا دِنہٕ۔"
\c 6
\p
\v 1 یہُوواہنؔ ووٚن موسیٰؔ ہس یتہِ:
\v 2 "یہ کتھ ونیٚو اسرائیلی لوٗکن: اگر توٚہہِ منٛزٕ کانٛہہ یمن ہدایِتن پٮ۪ٹھ عمل کرنہٕ پتہٕ پنُن پان اکہ خاص طریقہ میانہِ باپتھ وقف کرنُک پۅختہٕ عہد کرُن یژھِ۔ تس ییہِ نذیر وننہٕ، تمیُک مطلب گو اکھ وقف شخص۔
\v 3 تٔمس چُھنہٕ دچھِ رس چیٚون تہٕ نہ پزیٚس دچھ تہٕ کِشمِش کھیٚنؠ\f + \fr 6‏:3 \ft لوق 1:15\f*۔
\v 4 ییٚلہ توٚہؠ نذیر بٔنیٚو توٚہہِ پزِنہٕ دچھِ بیلِس نیرن وول کانٛہہ تہٕ چیز کھیٚون، چاہے سُہ دٮ۪ل آسہ یا بیول۔
\p
\v 5 \f + \fr 6‏:5 \ft اعمال 21:23، 24:2\f*حالانکہ تُہنٛد مُوے تام ییہِ میانہٕ باپتھ وقف کرنہٕ ییٚلہِ توٚہؠ نذیر ٲسیٚو، لہٰذا دی زیٚو نہٕ توٚہؠ بلیڈٕ سٟتؠ کانٛسہِ پنُن مَس تہِ کاسنہٕ۔ یۅتام نہٕ مےٚ سٟتؠ تُہنٛد کۅرمُت وقف سپدنُک پۅختہٕ وعدہ پورٕ سپدِ، توٚہہِ پزِ پننِس مستس زیٹھنہٕ دیُن۔
\v 6 تہٕ یۅتام توٚہؠ نذیر چُھو تۅتام مہٕ گٔژھیٚو مۅردن نزدیک۔
\v 7 اگر زن یہ مۅردٕ تُہنٛد مول، تُہنٛز موج، تُہنٛد بوے یا تُہنٛز بیٚنہٕ تہِ آسہ۔ تمہِ باوجود تہِ ہکیٚو نہٕ توٚہؠ میتَس نزدیک گٔژھِتھ پنُن پان مےٚ نِش ناقٲبلِ قبول بنٲوِتھ۔ تُہنٛد زیُٹھ مَس آسہ یہ باوتھ کران زِ توٚہؠ چُھو اکہِ خاص طریقہ مےٚ سٟتؠ مُنسلِک، لہٰذا پزِ توٚہہِ تی کرُن یمیُک پۅختہٕ وعدہ توٚہہِ کۅرمُت چُھ تہٕ پنُن مَس مہٕ کاسہٕ نٲیو۔
\v 8 توٚہہِ پزِ ہمیشہٕ أتھؠ کامہِ سٟتؠ روزُن زِ توٚہؠ چُھو اکہِ خاص طریقہٕ مےٚ سٟتؠ وقف سپدؠ مٕتؠ۔
\v 9 اگر توٚہہِ برُونٛہہ کنہِ اچانک کانٛہہ مرِ تہٕ تُہنٛد مس یُس توٚہہِ میانہٕ خٲطرٕ وقف کۅرمُت چُھ روزنہٕ پتہٕ مقدس۔ لہٰذا پزِ توٚہہِ ستن دوٚہُن پرارنہٕ پتہٕ سُہ کٲسِتھ ژھنُن۔ پتہٕ چھےٚ توٚہہِ اکھ خاص رسٕم انجام دِنؠ یُتھ توٚہؠ بیٚیہِ میانہٕ خٲطرٕ قٲبلِ قبول بٔنیٚو۔
\v 10 لاشہِ ہنٛدِ ناپاک گژھنہٕ پتہٕ ٲٹھمہِ دوٚہہ چُھو توٚہہِ زٕ قُمرؠ یا زٕ کوتر مقدس خٟمہ کِس دروازس پٮ۪ٹھ کاہنس نِش انٕنؠ۔
\v 11 کاہنس پزن تِم زٕ جانور مٲرِتھ قربٲنی رنگؠ پیش کرٕنؠ۔ یمو منٛزٕ اکھ تُہنٛدؠ گناہ چھلنہٕ باپتھ قربانی آسہ تہٕ بیاکھ ییہِ مےٚ خوش کرنہٕ باپتھ پوٗرٕ پٲٹھؠ بُزنہٕ۔ کاہن سنٛدِ قربان گاہس پٮ۪ٹھ بُزنہٕ پتہٕ کرٕ بہٕ توٚہہِ أکِس میتَس برُونٛہہ کُن یُن معاف، تہٕ ییٚلہِ تُہنٛد مس دُبارٕ زیٹھِ تہٕ سُہ گژھِ بیٚیہِ میانہِ ناوٕ وقف۔
\v 12 پتمہِ لٹہِ ییتِس وقتس توٚہؠ میانہِ خٲطرٕ الگ ٲسیٚو سُہ ییہِ نہٕ مُجرا، تکیازِ ییٚلہ توٚہؠ نذیر ٲسیٚو تہٕ اکِس مۅردس برُونٛہہ کُن یتھ گو توٚہؠ میانہِ خٲطرٕ ناقٲبلِ قبول۔ لہٰذا چُھ توٚہہِ دُبارٕ اکھ پۅختہٕ وعدہ کرُن زِتوٚہؠ کٔریٚو پنُن پان امہِ پورٕ وقتہٕ باپتھ میانہِ خٲطرٕ وقف یور کُن توٚہہِ پتمہِ لٹہِ اشارٕ کۅرمُت چُھو۔ تہٕ توٚہہِ پزِ پنٕنؠ گناہ دور کرنہٕ خٲطرٕ وٲرشنِس برٕ سنٛز قربٲنی تہِ دِنؠ۔
\v 13 ییٚلہ سُہ وقت انٛد واتہِ یُس توٚہہِ مےٚ سٟتؠ وقف کرنُک عہد کۅرمُت چُھو ادٕ گٔژھؠ زیٚو مقدس خٟمہٕ کِس دروازس پٮ۪ٹھ،
\v 14 تہٕ کٔرؠ زیٚو میانہٕ ناوٕ تریٚن جانورن ہنٛز قربٲنی پیش یمن نہٕ کانٛہہ عٲب آسہ۔ قربٲنی خٲطرٕ اکھ وٲرشُن برٕ یُس پوٗرٕ پٲٹھؠ بُزنہٕ ییہِ، وٲرشِنؠ گٔب یۅسہ گناہ دوٗر کرنہٕ باپتھ قربان سپدِ تہٕ میانؠ رفاقت بحال کرنہٕ باپتھ گژھِ اکھ بوٚڈ کٹھ قربان یُن کرنہٕ۔
\p
\v 15 ییٚلہِ توٚہؠ یمہٕ جانور أنووکھ تہٕ توٚہؠ أنؠ زیٚو قربٲنی باپتھ کینٛہہ مےَ تہِ۔ تہٕ بیٚیہِ أنؠ زیٚو اکھ ژۅچہٕ ٹوکٕر یمہٕ توٚہہِ نفیس آٹہِ تہٕ زیتون تیٖلہٕ سٟتؠ بناومژٕ آسن۔ مگر ژۅچہ گژھِ نہٕ کانٛہہ خمیر تراونہٕ یِنؠ۔ امہِ علاوٕ گژھَن زیتون تیٖل مٔتھتھ زٲولؠ پیالہٕ کاہنن نِش واتٕنؠ۔
\v 16 کاہن تھاوِ کٹہٕ برٕ تہٕ گٔب قربان گاہس پٮ۪ٹھ تہٕ بُزیکھ پوٗرٕ پٲٹھؠ تاکہ خوش گٔژھتھ کرو بہٕ توٚہہ معاف۔
\v 17 پتہٕ کرِ سُہ میانؠ رفاقت حٲصِل کرنہٕ باپتھ بوٚڈ ہیٚو کٹھ قربان تہٕ تِم سارے ژۅچہِ، اوٹ تہٕ شراب زالہِ قربان گاہس پٮ۪ٹھ۔
\v 18 تمہِ پتہٕ گٔژھیٚو توٚہؠ مقدس خٟمہ کِس دروازس پٮ۪ٹھ تہٕ کٲسیٚو پنُن مس۔ پتہٕ ترٲیو سُہ مس تتھ نارس منٛز یُس قربٲنی ہنٛدِس تس جانورس تل آسہ یُس قربان گاہس پٮ۪ٹھ قربان کرنہٕ چُھ آمُت، تاکہ میانؠ رفاقت سپدیٚو حٲصِل۔
\v 19 کٹہٕ سنٛدِ کنٛگویُک ماز گژھِ پتہٕ سیٚونہٕ یُن۔ تیار گٔژھِتھ تھاوِ کاہن تتھ اکِس خوشک ژۅچہِ منٛز تہٕ بیٚیہِ تھاویس زیتون تیٖل مٔتھِتھ بیاکھ ژۅٹ تہٕ تھاوِ تُہنٛدین اتھن کیٚتھ۔
\v 20 پتہٕ نیٚیہ کاہن تتھ بیٚیہِ واپس تہٕ رٹہِ مےٚ پیش کرنہٕ باپتھ تھوٚد۔ وۅنؠ چھِ تِم کاہنن ہنٛدؠ، تہٕ وۅنؠ چُھ تِمن کٹہٕ سنٛدِ کنٛگوِ، کانہِ تہٕ رانہِ ہُنٛد کینٛہہ ماز کھیٚنُک اجازت، تکیازِ سُہ ماز چُھ قربٲنیہ منٛزٕ تمسُنٛد حصہٕ۔ امہِ پتہٕ ٲسیٚو نہٕ توٚہؠ نذیر، تہٕ توٚہہِ ییہِ دُبارٕ شراب چیٚنُک اجازت دِنہٕ۔
\v 21 یمہٕ چھِ تِمن نذرانن ہنٛدؠ ظٲبطٕ یِم نذیرو میانہ باپتھ وقف سپدنکہ وقتہٕ اختتام کرنہٕ باپتھ مےٚ سٟتؠ کٔرؠ۔ تِمن پزن یمہٕ نذرانہٕ انٕن، وۅنؠ اگر تِم یژھن تِم ہیٚکن مذید قربٲنیہِ تہِ انِتھ۔ تہٕ تِمن پزِ تہِ سورےٕ کرُن یمیُک تِمو تمہِ وزِ مکمل وعدہ کۅرمُت چُھ ییٚلہ تِمو پنُن پان میانہِ باپتھ وقف کۅر۔
\v 22 یہُوواہنؔ ووٚن موسیٰؔ ہس مزید،
\v 23 "ہارون تہٕ تمسنٛدین نیٚچوٮ۪ن ونیٚو زِ ییٚلہ تمہ مےٚ لوٗکن دُعا کرنہٕ خٲطرٕ ونن، تِم ونن ضرور،
\q1
\v 24 یہُوواہؔ کٔرؠ نو برکت،
\q2 تہٕ بیٚیہِ کٔرؠ نو رٲچھ۔
\v 25 سُہ روزنؠ توٚہہِ پٮ۪ٹھ خوش،
\q2 تہٕ توٚہہِ پٮ۪ٹھ روزِنؠ مہربان۔
\q1
\v 26 توٚہہِ سٟتؠ کٔرِنؠ رُت برتاو،
\q2 تہٕ تُہنٛدِ خٲطرٕ روزِنؠ جان
\p
\v 27 پتہٕ ووٚن یہُوواہنؔ، "اگر ہارونؔ تہٕ تمسنٛدؠ نیٚچوؠ مےٚ اسرائیلی لوٗکن خٲطرٕ برکت دنہٕ باپتھ ونن، تہٕ بہٕ کرٕ تِمن پٔزؠ پٲٹھؠ برکت عطا۔"
\c 7
\p
\v 1 ییٚلہ موسیٰؔ ہن مقدس خٟمہ لٲگِتھ مۅکلوو، تتھ پٮ۪ٹھ ترُووُن تیٖل تہٕ تھوون یہُوواہؔ سنٛدِس احترامس منٛز الگ۔ تٔمؠ کٔرؠ تِم سٲری چیز تتھ وقف یمہٕ مقدس خٟمس انٛدر چھِ، تہٕ قربان گاہ قربٲنی بُزنہٕ خٲطرٕ تہٕ تِم چیز یمہ قربان گاہس پٮ۪ٹھ استعمال سپدان چھِ\f + \fr 7‏:1 \ft یہٕ چُھ غٲلبن سُہ دوٚہہ یُس خروج کِس 40:17 منٛز چُھ وننہٕ یوان۔\f*۔
\v 2 اسرائیل کیٚن بہَن قبیلن ہنٛدؠ زِٹھؠ، تِمے نفر یمو ہارونَس تہٕ موسیٰؔ ہس مدد کۅر تِم نفر گنٛزراونس منٛز یِم جنٛگس منٛز لٔڈِتھ ہیٚکہٕ ہن آے پتہٕ،
\v 3 یہُوواہسؔ باپتھ مقدس خٟمس منٛز تحفہٕ ہیٚتھ۔ تِم آے شےٚ درِ گاڈِ تہٕ باہ دانٛد ہیٚتھ، پرٛتھ کانٛسہِ زِٹھؠ سنٛدِ طرفہٕ اکھ اکھ دانٛد تہٕ دوٚن زِٹھیٚن ہنٛدِ طرفہٕ اکھ اکھ گٲڑؠ۔
\p
\v 4 پتہٕ ووٚن یہُوواہنؔ موسیٰؔ ہس،
\v 5 "یمہٕ تحفہٕ کٔریٚو قبوٗل اسرائیل ین نِشہ، تاکہِ لاوی ین ہنٛدؠ اولاد کرن یِم تِمہ مقدس چیز پکناونہٕ خٲطرٕ استعمال یمہ مقدس خٟمس منٛز چھِ۔
\v 6 لہٰذا دژٕ موسیٰؔ ہن یمہ گاڈِ تہٕ دانٛد لاوین ہنٛدیٚن اولادن۔
\v 7 تٔمؠ دژٕ زٕ گاڈِ تہٕ ژور دانٛد جیرسونؔ سنٛدین اولادن تہنٛزِ کامہِ خٲطرٕ،
\v 8 تہٕ مراری سنٛدین اولادن تہنٛزِ کامہِ باپتھ ژور گاڈِ تہٕ ٲٹھ دانٛد۔ ہارونؔ سُنٛد نیٚچو اِتمرؔ اوس یِمن کامیٚن ہُنٛد نگران۔
\v 9 مگر تٔمؠ دیُت نہٕ قہاتؔ سنٛدین اولادن نہ کانٛہہ گٲڑؠ تہٕ نہ کانٛہہ دانٛد۔ تکیازِ تِم ٲسؠ تِمن مقدس چیزن ہنٛز رٲچھ راوٕٹ کران یمہٕ گاڑیٚو بجایہ نکھس پٮ۪ٹھ پکناونؠ پیٚوان ٲسؠ۔
\v 10 یمہ دوٚہہ قربان گاہ وقف کرنہٕ آیہ، تمہِ دوٚہہ آے باقی باہ زِٹھؠ دویِم نذرانہٕ ہیٚتھ تہٕ تھٲوِکھ تِم قربان گاہس برُونٛہہ کنہِ۔
\v 11 یہُوواہنؔ ووٚن موسیٰؔ ہس، "ینہٕ والیٚن بہَن دوٚہُن دوران انہِ پرٛتھ دوٚہہ اکھ اکھ زیُٹھ پنٕنؠ تحفہٕ قربان گاہس پیش کرنہٕ باپتھ۔
\pi
\v 12‏-13 \f + \fr 7‏:12‏-13 \ft اکھ چاندِ ہُنٛد پلیٹ یمیُک وزن ڈوٚڈ کِلو چُھ۔ \f*بہن دوٚہُن ہنٛدِ گۅڈنِکہ دوٚہہ اوٚن یہُوداؔ قبیلٕکؠ عِمیندآبؔ سنٛدؠ نیٚچوؠ نحسونؔن پنُن تحفہٕ: چاندِ ہُنٛد ڈۅڈٕ کِلوُن اکھ تھال تہٕ چانٛدِ ہُنٛد قریبن پاو وزنُک اکھ پیالہ، یمن دوٚنونؠ منٛز اوس نذرانہٕ باپتھ زیتون تیٖل رلاوِتھ نفیس اوٹ۔ یمہٕ دوٚنوے اے معیاری ترکرِ سٟتؠ تولنہٕ۔\f + \fr 7‏:12‏-13 \ft اکھ چاندِ ہُنٛد پیالہٕ یمیُک وزن ٲٹھ شتھ گرام چُھ۔\f*
\v 14 بیٚیہِ اوٚنُکھ سۅنہٕ سُنٛد اکھ لۅکُٹ بانہٕ\f + \fr 7‏:14 \ft اکھ ہتھ تہٕ داہ گرام سۅنہٕ سنٛز تھٲلؠ\f* یمیُک وزن اکھ ہتھ تہٕ ترُواہ گرام اوس، اتھ منٛز اوس بخور۔
\li
\v 15‏-17 تِمو اوٚن اکھ جوان دانٛد، اکھ کٹھ، تہٕ وٲرشِنؠ کٹہٕ برٕ زٕ تحفہٕ رنٛگؠ۔ یمہٕ قربان گاہس پٮ۪ٹھ پوٗرٕ پٲٹھؠ بُزِتھ قربان سپدن۔
\li لوٗکن ہنٛدؠ گناہ معاف کرنہٕ باپتھ اکھ مونٛگُر،
\li زٕ دانٛد، پانٛژھ کٹھ، پانٛژھ مونٛگر تہٕ وٲرشِنؠ پانٛژھ کٹہٕ برٕ گژھن یہُوواہسؔ سٟتؠ لوٗکن ہنٛزِ وفادٲری ہُنٛد اظہار کرنہٕ مۅکھٕ قربان کرنہٕ ینؠ۔
\pi
\v 18‏-19 دوٚیمہِ دوٚہہ آو اشکارن ہُنٛد سردار ضُغر سُنٛد نیٚچو نتنی ایلؔ پنٕنؠ تحفہ ہیٚتھ\f + \fr 7‏:18‏-19 \ft پرٛتھ أکؠ سٕنٛدؠ أنؠ مٕتؠ تحفہٕ ٲسؠ ہِوی: ڈۅڈ کلو چاندِ ہُنٛد اکھ پیالہٕ، ٲٹھ شتھ گرام چانٛدِ ہنٛز اکھ تھٲلؠ تہٕ اکھ ہتھ داہ گرام سۅنہٕ سنٛز تھٲلؠ، ہیٚتھےٕ بہَن دوٚہُن تام۔\f*:
\li چاندِ ہُنٛد ڈۅڈ کِلو وزنُک اکھ کھیٚنہ بانہ، پاو وزنُک چاندِ ہُنٛد اکھ پیالہ۔ یِمن دوٚنونؠ منٛز اوس اصل اوٹ زیتون تیٖل ترٲوِتھ نیازٕ باپتھ۔ یمہ دوٚنوے آے معیاری ترٛیکرِ سٟتؠ تولنہٕ۔
\li بیٚیہِ اکھ ہتھ تہٕ داہ گرام وزنُک اکھ لۅکُٹ سۅنہٕ سُنٛد بانہٕ یتھ منٛز بخور بٔرِتھ اوس۔
\li
\v 20‏-23 نتنی\f + \fr 7‏:20‏-23 \ft ساروٕے زِٹھیٚو کٔر ہیٚتھےٕ بہَن دوٚہُن تام اکھ ہتھ داہ گرام سۅنہٕ سنٛز تھٲلؠ پیش۔\f* ایلؔن اوٚن اکھ جوان دانٛد، اکھ کٹھ تہٕ وٲرشُن اکھ کٹہٕ برٕ یُس تحفہ رنٛگؠ مکمل طور قربان گاہس پٮ۪ٹھ بُزنہٕ ییہِ،
\li لوٗکن ہنٛدؠ کٔرمٕتؠ خطا معاف کرناونہٕ باپتھ آو اکھ ژھاوُل نذر کرنہٕ،
\pi زٕ دانٛد، پانٛژھ کٹھ، پانٛژھ مونٛگر تہٕ وٲرشِنؠ پانٛژھ کٹہٕ برٕ گژھن یہُوواہسؔ سٟتؠ لوٗکن ہنٛزِ وفادٲری ہُنٛد اظہار کرنہٕ مۅکھٕ قربان کرنہٕ ینؠ۔
\pi
\v 24‏-26 تریمہ دوٚہہ آو زبولونؔ قبیلُک سردار حیلونؔ سُنٛد نیٚچو الیابؔ پنٕنؠ تحفہٕ ہیٚتھ:
\li تٔمؠ اوٚن چانٛدِ ہُنٛد اکھ بانہٕ یمیُک وزن ڈۅڈکِلو اوس تہٕ چانٛدِ ہُنٛد اکھ پیالہٕ یمیُک وزن قریبن اکھ پاو اوس، یمن دوٚنونؠ منٛز اوس اصل اوٹ بٔرِتھ، زیتون تیٖل ترٲوِتھ یہ اوٹ اوس نذرانہٕ باپتھ۔ یمن دوٚنونؠ آو معیاری تریکرِ سٟتؠ وزن کرنہٕ۔
\li بیٚیہِ اونُن سۅنہٕ سُنٛد اکھ لۅکُٹ بانہٕ یتھ منٛز بخور بٔرِتھ تمیُک وزن اوس اکھ ہتھ تہٕ داہ گرام۔
\li
\v 27‏-29 الیابنؔ تہِ اوٚن اکھ جوان دانٛد، اکھ کٹھ تہٕ وٲرشُن اکھ کٹہٕ برٕ یُس قربان گاہس پٮ۪ٹھ پوٗرٕ پٲٹھؠ بُزنہٕ ییہِ۔
\li لوٗکن ہنٛدیٚن گناہ معاف کرناونہٕ باپتھ اکھ مونٛگر، زٕ دانٛد، پانٛژھ وٲرشِنؠ گبہِ آے لوٗکو باپتھ یہُوواہؔ سنٛز خۅشنودی حٲصِل کرنہٕ مۅکھٕ نذر کرنہٕ۔
\pi
\v 30‏-32 ژورمہِ دوٚہہ آو روبنؔ قبیلٕکؠ زیُٹھ، شدیورؔ سُنٛد نیٚچو الیصورؔ پنٕنؠ تحفہٕ ہیٚتھ:
\li چانٛدِ ہُنٛد اکھ بانہٕ یمیُک وزن ڈۅڈ کِلو اوس، تہٕ چانٛدِ ہُنٛد اکھ پیالہٕ یمیُک وزن قریبن اکھ پاو اوس، یِم دوٚنوے ٲسؠ نفیس آٹہِ سٟتؠ یتھ نذرانہٕ بٲپتھ زیتون تیٖل رلٲوِتھ اوس۔ یمن دوٚنونؠ آو معیاری تریکرِ سٟتؠ وزن کرنہٕ۔
\li اکھ ہتھ تہٕ داہ گرام وزنُک سۅنہٕ سُنٛد اکھ لۅکُٹ بانہٕ تہِ یتھ منٛز بخور بٔرِتھ اوس۔
\li
\v 33‏-35 الیصورؔن تہِ اوٚن اکھ دانٛد، اکھ کٹھ تہٕ وٲرشِنؠ کٹہٕ برٕ زٕ تاکہ تِم ین قربان گاہس پٮ۪ٹھ بُزِتھ پوٗرٕ پٲٹھؠ قربان کرنہٕ۔ لوٗکن ہنٛدؠ گناہ معاف کرناونہٕ باپتھ ییہِ اکھ مونٛگر، زٕ دانٛد، پانٛژھ کٹھ، پانٛژھ ژھاوٕلؠ تہٕ وٲرشِنؠ پانٛژھ کٹہٕ برٕ ین یہُوواہسؔ سٟتؠ لوٗکن ہنٛز عقیدت بحال کرنہٕ باپتھ نذر کرنہٕ۔
\pi
\v 36‏-38 پانٛژمہِ دوٚہہ آو شمعونؔ قبیلُک سردار صوری شدیؔ سُنٛد نیٚچو سلُومی ایلؔ تحفہ ہیٚتھ:
\li چاندِ ہُند اکھ بانہٕ یمیُک وزن ڈۅڈ کِلو اوس تہٕ چاندِ ہُنٛد اکھ پیالہٕ یمیُک وزن قریبن اکھ پاو اوس۔ یمن منٛز اوس نفیس اوٹ بٔرِتھ یتھ زیتون تیٖل ترٲوِتھ اوس یُتھ یہ نذر ییہِ کرنہٕ، یمن دوٚن آو معیاری ترٛیکرِ سٟتؠ وزن کرنہٕ،
\li اکھ ہتھ تہٕ داہ گرام وزنہٕ کِس سۅنہٕ سنٛدِس اکِس لۅکٹِس بانس منٛز اوس بخور۔
\li
\v 39‏-41 سلُومی ایلؔن اوٚن اکھ ہکُھر، اکھ کٹھ تہٕ وٲرشُن اکھ کٹہٕ برٕ، تاکہِ قربان گاہس پٮ۪ٹھ ین یِم پوٗرٕ پٲٹھؠ بُزتھ نذر کرنہٕ۔
\li لوٗکن ہنٛدؠ گناہ معاف کرناونہٕ باپتھ آو اکھ مونٛگر،
\li زٕ دانٛد، پانٛژھ وٲرشِنؠ کٹہٕ برٕ آے لوٗکو باپتھ یہُوواہؔ سنٛز خۅشنودی حٲصِل کرنہٕ مۅکھٕ نذر کرنہٕ۔
\pi
\v 42‏-44 شیمہِ دوٚہہ آو دعوایلؔ سُنٛد نیٚچو الیاسبؔ یُس جدؔ قبیلُک سردار اوس پنٕنؠ نذرانہٕ ہیٚتھ:
\li چاندِ ہُنٛد ڈۅڈ کِلو وزنُک اکھ کھیٚنہ بانہ، قریبن پاو وزنُک چاندِ ہُنٛد اکھ پیالہ۔ یِمن دوٚنونؠ منٛز اوس نفیس اوٹ زیتون تیٖل ترٲوِتھ نذرانہٕ باپتھ۔ یمہ دوٚنوے آے معیاری ترٛیکرِ سٟتؠ تولنہٕ۔
\li بیٚیہِ اکھ ہتھ تہٕ داہ گرام وزنُک اکھ لۅکُٹ سۅنہٕ سُنٛد بانہٕ یتھ منٛز بخور بٔرِتھ اوس۔
\li
\v 45‏-47 الیاسبنؔ تہِ اوٚن اکھ ہکُھر، اکھ کٹھ تہٕ وٲرشُن اکھ کٹہٕ برٕ یُتھ زن قربان گاہَس پٮ۪ٹھ پوٗرٕ پٲٹھؠ بُزِتھ نذر یِن کرنہٕ۔
\li لوٗکن ہنٛدؠ گناہ معاف کرنہٕ باپتھ آو اکھ مونٛگُر،
\li زٕ دانٛد، پانٛژھ کٹھ، پانٛژھ مونٛگر تہٕ وٲرشِنؠ پانٛژھ کٹہٕ برٕ گژھن یہُوواہسؔ سٟتؠ لوٗکن ہنٛزِ وفادٲری ہُنٛد اظہار کرنہٕ مۅکھٕ قربان کرنہٕ۔
\pi
\v 48‏-50 سٔتمہِ دوٚہہ آو افرائیمؔ قبیلٕکؠ سردار، عِمیہُودؔ سُنٛد نیٚچو الِیسمعؔ پنٕنؠ تحفہٕ ہیٚتھ:
\li چانٛدِ ہُنٛد اکھ بانہٕ یمیُک وزن ڈۅڈ کِلو اوس، تہٕ چانٛدِ ہُنٛد اکھ پیالہٕ یمیُک وزن قریبن اکھ پاو اوس، یِم دوٚنوے ٲسؠ نفیس آٹہِ سٟتؠ یتھ نذرانہٕ بٲپتھ زیتون تیٖل رلٲوِتھ اوس۔ یمن دوٚنونؠ آو معیاری تریکرِ سٟتؠ وزن کرنہٕ۔
\li اکھ ہتھ تہٕ داہ گرام وزنُک سۅنہٕ سُنٛد اکھ لۅکُٹ بانہٕ تہِ یتھ منٛز بخور بٔرِتھ اوس۔
\li
\v 51‏-53 الِیسمعؔ ہن تہِ اوٚن اکھ دانٛد، اکھ کٹھ تہٕ وٲرشِنؠ کٹہٕ برٕ زٕ تاکہ تِم ین قربان گاہس پٮ۪ٹھ بُزِتھ پوٗرٕ پٲٹھؠ قربان کرنہٕ۔ لوٗکن ہنٛدؠ گناہ معاف کرناونہٕ باپتھ ییہِ اکھ مونٛگر، زٕ دانٛد، پانٛژھ کٹھ، پانٛژھ ژھاوٕلؠ تہٕ وٲرشِنؠ پانٛژھ کٹہٕ برٕ ین یہُوواہسؔ سٟتؠ لوٗکن ہنٛز عقیدت بحال کرنہٕ باپتھ نذر کرنہٕ۔
\pi
\v 54‏-56 ٲٹھمہِ دوٚہہ آو فداہ صُورؔ سُنٛد نیٚچو جملی ایلؔ منسیؔ قبیلُک سردار پنٕنؠ تحفہ ہیٚتھ:
\li چاندِ ہُند اکھ بانہٕ یمیُک وزن ڈۅڈ کِلو اوس تہٕ چاندِ ہُنٛد اکھ پیالہٕ یمیُک وزن قریبن اکھ پاو اوس۔ یمن منٛز اوس نفیس اوٹ بٔرِتھ یتھ زیتون تیٖل ترٲوِتھ اوس یُتھ یہ نذر ییہِ کرنہٕ، یمن دوٚن آو معیاری ترٛیکرِ سٟتؠ وزن کرنہٕ،
\li اکھ ہتھ تہٕ داہ گرام وزنہٕ کِس سۅنہٕ سنٛدِس اکِس لۅکٹِس بانس منٛز اوس بخور۔
\li
\v 57‏-59 فداہ صُورؔ سُنٛد نیٚچو جملی ایلؔن اوٚن اکھ ہکُھر، اکھ کٹھ تہٕ وٲرشُن اکھ کٹہٕ برٕ، تاکہِ قربان گاہس پٮ۪ٹھ ین یِم پوٗرٕ پٲٹھؠ بُزتھ نذر کرنہٕ۔
\li لوٗکن ہنٛدؠ گناہ معاف کرناونہٕ باپتھ آے زٕ دانٛد، پانٛژھ کٹہٕ برٕ، پانٛژھ مونٛگر، تہٕ پانٛژھ ژھاوجہِ آے لوٗکو باپتھ یہُوواہؔ سنٛز خۅشنودی حٲصِل کرنہٕ مۅکھٕ نذر کرنہٕ۔
\pi
\v 60‏-62 نٔومہِ دوٚہہ آو بنیمِینؔ قبیلُک سردار جِدعونیؔ سُنٛد نیٚچو ابِدانؔ پنٕنؠ نذرانہٕ ہیٚتھ، تمسُنٛد نذرانہٕ اوس:
\li چاندِ ہُنٛد ڈۅڈ کِلو وزنُک اکھ کھیٚنہ بانہ، قریبن پاو وزنُک چاندِ ہُنٛد اکھ پیالہ۔ یِمن دوٚنونؠ منٛز اوس نفیس اوٹ زیتون تیٖل ترٲوِتھ نذرانہٕ باپتھ۔ یمہ دوٚنوے آے معیاری ترٛیکرِ سٟتؠ تولنہٕ۔
\li بیٚیہِ اکھ ہتھ تہٕ داہ گرام وزنُک اکھ لۅکُٹ سۅنہٕ سُنٛد بانہٕ یتھ منٛز بخور بٔرِتھ اوس۔
\li
\v 63‏-65 ابِدانؔن تہِ اوٚن اکھ ہکُھر، اکھ کٹھ تہٕ وٲرشُن اکھ کٹہٕ برٕ یُتھ زن قربان گاہَس پٮ۪ٹھ پوٗرٕ پٲٹھؠ بُزِتھ نذر یِن کرنہٕ۔
\li لوٗکن ہنٛدؠ گناہ معاف کرنہٕ باپتھ آو اکھ مونٛگُر،
\li زٕ دانٛد، پانٛژھ کٹھ، پانٛژھ مونٛگر تہٕ وٲرشِنؠ پانٛژھ کٹہٕ برٕ گژھن یہُوواہسؔ سٟتؠ لوٗکن ہنٛزِ وفادٲری ہُنٛد اظہار کرنہٕ مۅکھٕ قربان کرنہٕ۔
\pi
\v 66‏-68 دہمہِ دوٚہہ آو دانؔ قبیلٕکؠ سردار، عمیشدائیؔ سُنٛد نیٚچو اخِیرع پنٕنؠ تحفہٕ ہیٚتھ:
\li چانٛدِ ہُنٛد اکھ بانہٕ یمیُک وزن ڈۅڈ کِلو اوس، تہٕ چانٛدِ ہُنٛد اکھ پیالہٕ یمیُک وزن قریبن اکھ پاو اوس، یِم دوٚنوے ٲسؠ نفیس آٹہِ سٟتؠ یتھ نذرانہٕ بٲپتھ زیتون تیٖل رلٲوِتھ اوس۔ یمن دوٚنونؠ آو معیاری تریکرِ سٟتؠ وزن کرنہٕ۔
\li اکھ ہتھ تہٕ داہ گرام وزنُک سۅنہٕ سُنٛد اکھ لۅکُٹ بانہٕ تہِ یتھ منٛز بخور بٔرِتھ اوس۔
\li
\v 69‏-71 اخِیرعؔ ہن تہِ اوٚن اکھ دانٛد، اکھ کٹھ تہٕ وٲرشِنؠ کٹہٕ برٕ زٕ تاکہ تِم ین قربان گاہس پٮ۪ٹھ بُزِتھ پوٗرٕ پٲٹھؠ قربان کرنہٕ۔ لوٗکن ہنٛدؠ گناہ معاف کرناونہٕ باپتھ ییہِ اکھ مونٛگر، زٕ دانٛد، پانٛژھ کٹھ، پانٛژھ ژھاوٕلؠ تہٕ وٲرشِنؠ پانٛژھ کٹہٕ برٕ ین یہُوواہسؔ سٟتؠ لوٗکن ہنٛز عقیدت بحال کرنہٕ باپتھ نذر کرنہٕ۔
\pi
\v 72‏-74 کٔہمہِ دوٚہہ آو عکرانؔ سُنٛد نیٚچو فجعی ایلؔ یُس آشرؔ قبیلُک سردار اوس پنٕنؠ تحفہ ہیٚتھ:
\li چاندِ ہُند اکھ بانہٕ یمیُک وزن ڈۅڈ کِلو اوس تہٕ چاندِ ہُنٛد اکھ پیالہٕ یمیُک وزن قریبن اکھ پاو اوس۔ یمن منٛز اوس نفیس اوٹ بٔرِتھ یتھ زیتون تیٖل ترٲوِتھ اوس یُتھ یہ نذر ییہِ کرنہٕ، یمن دوٚن آو معیاری ترٛیکرِ سٟتؠ وزن کرنہٕ،
\li اکھ ہتھ تہٕ داہ گرام وزنہٕ کِس سۅنہٕ سنٛدِس اکِس لۅکٹِس بانس منٛز اوس بخور۔
\li
\v 75‏-77 فجعی ایلؔن تہِ اوٚن اکھ ہکُھر، اکھ کٹھ تہٕ وٲرشُن اکھ کٹہٕ برٕ، تاکہِ قربان گاہس پٮ۪ٹھ ین یِم پوٗرٕ پٲٹھؠ بُزتھ نذر کرنہٕ۔
\li لوٗکن ہنٛدؠ گناہ معاف کرناونہٕ باپتھ آو اکھ مونٛگر، زٕ دانٛد، پانٛژھ وٲرشِنؠ کٹہٕ برٕ آے لوٗکو باپتھ یہُوواہؔ سنٛز خۅشنودی حٲصِل کرنہٕ مۅکھٕ نذر کرنہٕ۔
\pi
\v 78‏-80 بہمہِ دوٚہہ آو نفتالیؔ قبیلُک منٛزٕ عینانؔ سُنٛد نیٚچو اخِیرع پنٕنؠ تحفہ ہیٚتھ:
\li یتھ منٛز چاندِ ہُند اکھ بانہٕ یمیُک وزن ڈۅڈ کِلو اوس تہٕ چاندِ ہُنٛد اکھ پیالہٕ یمیُک وزن قریبن اکھ پاو اوس۔ یمن منٛز اوس نفیس اوٹ بٔرِتھ یتھ زیتون تیٖل ترٲوِتھ اوس یُتھ یہ نذر ییہِ کرنہٕ، یمن دوٚن آو معیاری ترٛیکرِ سٟتؠ وزن کرنہٕ،
\li اکھ ہتھ تہٕ داہ گرام وزنہٕ کِس سۅنہٕ سنٛدِس اکِس لۅکٹِس پیالس منٛز اوس بخور۔
\li
\v 81‏-83 اخِیرع ہن اوٚن اکھ ہکُھر، اکھ کٹھ تہٕ وٲرشُن اکھ کٹہٕ برٕ، تاکہِ قربان گاہس پٮ۪ٹھ ین یِم پوٗرٕ پٲٹھؠ بُزتھ نذر کرنہٕ۔
\li لوٗکن ہنٛدؠ گناہ معاف کرناونہٕ باپتھ آو اکھ مونٛگر،
\li زٕ دانٛد، پانٛژھ وٲرشِنؠ کٹہٕ برٕ آے لوٗکو باپتھ یہُوواہؔ سنٛز خۅشنودی حٲصِل کرنہٕ مۅکھٕ نذر کرنہٕ۔
\li
\v 84‏-86 ییٚلہ قربان گاہ یہُوواہؔ سنٛدِ ناوٕ وقف سپٕز تہٕ یمو بہَو قبیلن ہنٛدیو زِٹھیٚو أنؠ یم تحفہٕ:
\li چاندِ ہنٛدؠ باہ تختہٕ تہٕ چاندِ ہنٛدؠ باہ پیالہٕ یمن ہُنٛد کُل وزن اوس ساڑ شیٚتووُہہ کِلو۔ یمو منٛزٕ آو پرٛتھ کینٛہہ مقدس خٟمس منٛز موجود تریٚکرِ سٟتؠ تولنہ\f + \fr 7‏:84‏-86 \ft وُچھِو ترُوٲہِم آیت\f*، \f + \fr 7‏:84‏-86 \ft چاندِ ہُنٛد کُل وزن ستووُو کلو شےٚ ہتھ گرام \f*
\li تہٕ بخور سٟتؠ بٔرِتھ سۅنہٕ سنٛدؠ باہ بانہٕ۔ یمو منٛزٕ اوس پرٛتھ کنیُک وزن ڈۅڈ کِلو\f + \fr 7‏:84‏-86 \ft کُل 1 کلو 32 گرام \f*۔
\li
\v 87‏-88 بہَو سردارو أنؠ باہ دانٛد، باہ کٹھ تہٕ وٲرشِنؠ باہ کٹہٕ برٕ یُتھ تِمہ آٹچہِ قربٲنی سٟتؠ رلٲوِتھ پوٗرٕ پٲٹھؠ بُزِتھ قربان ین کرنہٕ۔
\li لوٗکن ہنٛدین گناہ معاف کرنہٕ باپتھ آے باہ ژھاولؠ نذر کرنہٕ،
\li ژُووہہ دانٛد، شیٹھ کٹھ، شیٹھ مونٛگر تہٕ شیٹھ وٲرشِنؠ کٹہٕ برٕ آے یہُوواہؔ سنٛز خۅشنودی حٲصِل کرنہٕ مۅکھٕ نذر تھاونہٕ۔
\v 89 ییٚلہ تہِ موسیٰؔ مقدس خٟمس منٛز یہُوواہسؔ سٟتؠ کتھ کرنہٕ باپتھ اژان اوس، تمِس ٲس یہُوواہؔ سنٛز آواز تِمو مخلوقو ہنٛزو دویو تصویرو منٛزؠ یوان یمہٕ مقدس صندوق کِس ٹھانس پیٚٹھؠ کِنؠ آسہٕ۔\f + \fr 7‏:89 \ft شروبیٖم ٲسؠ پکھہٕ والٮ۪ن مخلوقن ہنٛدؠ زٕ سۅنہٕ سٕنٛدؠ پۅتٕلؠ یِم خدایہِ سنٛدِ جلالٕچ نشاندہی کران ٲسؠ تہٕ تِم ٲسؠ تمؠ سنٛزِ موجودگی سٟتؠ وابستہٕ۔ یِم مخلوق ٲسؠ پکھہٕ وٲلؠ وجود۔ یہنٛز شکل أڈ انسان تہٕ أڈ جانور ٲس۔\f*
\c 8
\p
\v 1 یہُوواہنؔ ووٚن موسیٰؔ ہس،
\v 2 ہارونسؔ وَن زِ سُہ تھاوِ ستتھ ژٲنگؠ ستن ژٲنگؠ تارن پٮ۪ٹھ تہٕ تِمن تھاوِ تتھٕ پٲٹھؠ یُتھ تِم تارن برُونٛہہ کِنؠ پرٮ۪زلن۔
\v 3 تہٕ موسیٰؔ ہن ووٚن تمِس، یہ یہُوواہنؔ وۅنُس تہٕ تٔمؠ کۅر تی۔
\v 4 یہِ ژٲنگؠ تار آو سۅنہٕ سُنٛد بناونہٕ یُس کِس بجہِ سۅنہٕ چاٹہِ گرنہٕ آو، یہ بنیاو ژکہِ پٮ۪ٹھٕ تہرِس تام پوش ہیٚو۔ ژٲنگؠ تار آو بلکُل تِتھُے بناونہٕ یتھٕ پٲٹھؠ زن یہُوواہنؔ موسیٰؔ ہس بناناوُن ونمُت اوس۔
\v 5 یہُوواہنؔ ووٚن موسیٰؔ ہس یتہِ،
\v 6 "ژٕ کرُکھ لاوی قبیلٕکؠ بٲقے اسرائیلی لوکو نشہٕ میانہٕ قبولیتہٕ خٲطرٕ الگ۔
\v 7 توٚہؠ کٔریٚو یتھٕ پٲٹھؠ زِ تِمن لٲوین کٔریٚو آبہٕ چھرکاو یہ آسہ تِہنٛدؠ گناہ چھلنہٕ ینٕچ علامت۔ پتہٕ کاسن تِمہ پننِس جسمَس بلیڈٕ سٟتؠ سورےٕ مَس تہٕ بیٚیہِ چھلن پنٕنؠ پلو۔
\v 8 پتہٕ انن تِم اکھ دانٛد تہٕ زیتون تیٖل رلٲوِتھ کینٛہہ اوٹ۔ تِم چیز ین قربٲنی ہنٛدِ باپتھ بُزنہٕ۔ تِمن پییہِ بیاکھ دانٛد تہِ انُن یُس تِہنٛدؠ گناہ چھلنہٕ باپتھ قربان ییہِ کرنہٕ۔
\v 9 پتہٕ پزن توٚہہ تمام اسرائیلی لوٗکھ مقدس خٟمس برُونٛہہ کنہِ جمع سپدنہٕ باپتھ بُلاونؠ تاکہِ تِم گژھن لاوین ہنٛدین اولادن برونٛہہ کنہِ جمع۔
\v 10 پتہٕ تھاون اسرائیل لٕکؠ لوٗکھ لاوین ہنٛدین اولادن پٮ۪ٹھ پنٕنؠ اتھٕ۔\f + \fr 8‏:10 \ft غٲلبن چھِنہٕ اسرائیل لٕکؠ لوٗکھ تمام اسرائیل ین ہند حوالہٕ دِوان، بلکہِ چھِ صرف تُہنٛدؠ نمایندٕ۔\f*
\v 11 امہِ پتہٕ کرِ ہارونؔ اسرائیلی لوٗکن تحفہٕ رنٛگؠ مےٚ برُونٛہہ کُن پیش، گویا تٔمؠ کٔرؠ تِم مےٚ سٟتؠ کھڑا، یُتھ تِم مقدس خٟمس منٛز میانہِ باپتھ کٲم کرن۔
\v 12 امہِ پتہٕ پزِ لاوینؔ ہنٛدین اولادن دوٚنونی داندن ہنٛدین کلَن پٮ۪ٹھ اتھٕ تھاوٕنؠ۔ پتہٕ ین دانٛد ذبح کٔرِتھ قربان گاہَس پٮ۪ٹھ بُزنہٕ۔ اکھ داند ییہِ سرِزد گٔمٕتؠ گناہ معاف کرنہٕ باپتھ قربان کرنہٕ، تہٕ بیاکھ ییہِ مکمل پٲٹھؠ بہٕ خوش کرنہٕ خٲطرٕ بُزنہٕ۔
\v 13 لاوین ہنٛدؠ اولاد گژھن ہارونؔ تہٕ تمسنٛدؠ نیٚچوؠ برُونٛہہ کنہِ قربان گاہس نِش کھڑا ینؠ کرنہٕ تہٕ پتہٕ کرہکھ ژٕ تِم میانہِ خٲطرٕ وقف۔ گویا تِم تھٲوتھکھ ژےٚ میانہِ باپتھ ۅدٕنؠ۔
\v 14 یہ رسٕم انجام دنہٕ سٟتؠ ترِ فکرِ زِ لاوین ہنٛدؠ اولاد چھِ اسرائیل یو نشہٕ الگ تہٕ تِم چھِ میانؠ۔
\v 15 ییٚلہ لاوین ہنٛدؠ اولاد میانہِ خٲطرٕ قٲبلِ قبول بنن تہٕ مےٚ سپدن اکہِ خاص طریقہ نذر زنتہٕ تِم میانے باپتھ تُلنہٕ آے، تِم ہیٚکن مقدس خٟمس منٛز کٲم شروع کٔرِتھ۔
\v 16 تِم آسن میانؠ۔ تِم کرن میانہِ باپتھ تمام اسرائیلی لوٗکن ہنٛدین گۅڈٕ زامتیٚن گۅبرن ہنٛدِ بدلہٕ کٲم، یِم مےٚ سٟتؠ تعلق آسن تھاوان۔
\v 17 اسرائیلس منٛز گۅڈٕ زامٕتؠ تمام مرٕد تہٕ نَر جانور چھِ میانؠ، ییٚلہ مےٚ مِصرٕ کیٚن لوٗکن ہنٛدؠ زِٹھؠ لٔڑکہٕ مٲرؠ تہٕ مےٚ تھٲوؠ تِم پننہِ باپتھ الگ۔ مگر مےٚ بچٲوؠ اسرائیل لٕکؠ سٲری نَر، اِنسانن تہٕ جانورن ہنٛدؠ زِٹھؠ اولاد، تکیازِ تِم چھِ میانؠ۔
\v 18 مگر وۅنؠ ژٲرؠ مےٚ لاوی زٲژ ہنٛدؠ تاکہِ تِم رٹن باقی اسرائیلی گۅڈٕ زامتیٚن گۅبرن ہنٛز جاے۔
\v 19 مےٚ کٔرؠ لاوین ہنٛدؠ اولاد مقدس خٟمس منٛز ہارون تہٕ تمسنٛدین گۅبرن مدد کرنہٕ خٲطرٕ مقرر، تکیازِ ہارون تہٕ تمسنٛدؠ نیٚچوؠ چھِ اسرائیلی لوٗکن ہنٛدین گُنہن ہُنٛدؠ قصور دور کرنہٕ موٚکھٕ قربٲنیہِ پیش کران، تہٕ اسرائیلی لوٗکن خٟمس نزدیک ینہٕ نشہٕ پتھ رٹان یمہ کِس نتیجس منٛز تِمو منٛز واریہن اکھ مینٛدؠ بیمار لاران تہٕ بیٚیہِ مران چھِ۔
\p
\v 20 ہاروننؔ، موسیٰؔ ہن تہٕ بیٚیہِ باقی اسرائیل یو کۅر لاوینؔ ہنٛدین اولادن پرٛتھ تتھ کامہِ منٛز مدد یمیُک یہُوواہنؔ حکم دیُتمُت اوس۔
\v 21 لاویوؔ ہنٛدیٚو اولادو کۅر پانس یہ ظٲہر کرنہٕ مۅکھٕ آبہٕ چھرکاو زِ تِمن آے پنٕنؠ کٔرمٕتؠ گناہ چھلنہٕ تہٕ پنٕنؠ پلو تہِ چھلِکھ۔ پتہٕ أنؠ ہاروننؔ تِم قربان گاہَس نِش یُتھ سُہ تِمن یہُوواہسؔ برُونٛہہ کُن پیش کرِہے، یعنی کہ تٔمؠ کٔرؠ تِم تٔمس برُونٛہہ کنہِ کھڑا، تہٕ تٔمؠ کرِ تِہنٛدؠ کٔرمٕتؠ گناہ دور کرنہٕ خٲطرٕ تہٕ تِم یہُوواہسؔ برُونٛہہ کُن أنِتھ مقبول بناونہٕ باپتھ قربٲنیہِ پیش۔
\v 22 امہِ پتہٕ کٔر لاوی سنٛدیو اولادو ہارونؔ تہٕ تمسنٛدین نیٚچوٮ۪ن مدد کرنہٕ باپتھ مقدس خٟمس منٛز کٲم کرِنؠ شروع۔ تِمو کۅر تِتھے پٲٹھؠ یتھٕ پٲٹھؠ زن یہُوواہنؔ موسیٰؔ ہس حکم کۅرمُت اوس۔
\p
\v 23 یہُوواہنؔ ووٚن موسیٰؔ ہس یتہِ،
\v 24 "لاوینؔ ہنٛدؠ اولاد یہنٛز وانٛس پنٛژہو ورؠ یو پٮ۪ٹھٕ پنژاہن ورؠ ین تام چھےٚ کرن مقدس خٟمس منٛز کٲم۔
\v 25 مگر ییٚلہ تِم پنٛژاہ ؤہرؠ واتن تِمن پزِ سبگدوش سپدُن۔
\v 26 تِم ہیٚکن پننٮ۪ن سٲتھی لاوی ہنٛدین اولادن مقدس خٟمس اندر کامہِ منٛز مدد کٔرِتھ۔ مگر پانہٕ کرن نہٕ یہ کٲم۔ یہ چُھ تہِ یہ توٚہہِ تِمن اتھ کامہِ متعلق ونُن چُھ یہ تِم کرن۔
\c 9
\p
\v 1 اسرائیلی مِصرٕ منٛزٕ نیرنہٕ پتہٕ اکہِ ؤہرؠ، دوٚیمہِ وریہ کِس گۅڈنِکِس ریٚتس منٛز، ییٚلہ اسرائیلی سیناؔ کِس صحراوس منٛز ٲسؠ، ووٚن یہُوواہنؔ موسیٰؔ ہس،
\v 2 "\f + \fr 9‏:2 \ft فسح عیدِ فسح ٲس تریٚیو بڈیٚو دوٚہو منٛزٕ اکھ یُس اسرائیلی مناوان ٲسؠ۔ \f*اسرائیلی لوٗکن ون زِ تِم مناون فسح عید دُبارٕ مقرر کرنہٕ آمتِس وقتس پٮ۪ٹھ\f + \fr 9‏:2 \ft خروج سبق 12 \f*
\v 3 تِم مناون یہِ یمہِ ریتہٕ کہ ژۅدٲہمہِ تٲریخہ شامہٕ برُونٛہہ برُونٛہہ تہٕ اتھ متعلق ورتاون تِم سٲری ہِدایت یمہٕ مےٚ توٚہہ برُونٛھےٕ ؤنمٕتؠ چھِ۔
\v 4 یتھٕ کنؠ ووٚن موسیٰؔ ہن لوٗکن زِ فسح مناونس متعلق کیاہ ووٚن یہُوواہنؔ۔
\v 5 لوٗکو منوو تتہِ سینا کیٚن بیابانن منٛز ریتہٕ کہِ ژۅدٲہمہِ تٲریخہ شامس یہ جشِن، یتھ پٲٹھؠ زن یہُوواہنؔ موسیٰؔ ہس حکم کۅرمُت اوس۔
\v 6 مگر خٟمس منٛز اسرائیل کیٚو کینٛژو لوٗکو اوس کتھ تام لاشہِ اتھٕ لوگمُت یمہِ کِنؠ تِمہ فسح مناونس لایق رودؠ نہٕ۔ حالانکہ تِمو پرُوژھ ہارونس تہٕ موسیٰؔ ہس،
\v 7 "یہ چُھ پوٚز زِ اسہِ لوگ لاشہِ اتھٕ، مگر امہِ سٟتؠ کِتھٕ کِنؠ گژھو أسؠ فسح مناونہٕ تہٕ باقین ہنٛدؠ پٲٹھؠ یہُوواہسؔ قربٲنی پیش کرنہٕ نشہٕ محروم؟"
\v 8 موسیٰؔ ہن دِتُکھ جواب، "یتی روزیٚو یۅتام بہٕ مقدس خٟمس منٛز اژٕ تہٕ معلوم کرٕ زِ یہُوواہؔ کیاہ چھِ اتھ متعلق فرماوان۔"
\v 9 پتہٕ ژاو موسیٰؔ خٟمس منٛز تہٕ پرِژُھن یہُوواہسؔ زِ سُہ کیاہ ونہِ لوٗکن تہٕ یہُوواہنؔ ونُس یتھٕ کنؠ،
\v 10 "یہ کتھ وَن اسرائیلی لوٗکن: اگر توٚہؠ یا تُہنٛدیو اولادو منٛزٕ کانٛہہ کُنہِ لاشہِ اتھٕ لاگہِ نتیجہٕ نیرِ یہ زِ سُہ آسہ نہٕ مےٚ قٲبلِ قبول، یا اگر توٚہؠ تمہِ وزِ گرٕ نشہٕ دوٗر کُنہِ زیٹِھس سفرس پٮ۪ٹھ ٲسیٚو تیٚلہ تہ آسہ توٚہہِ فسح مناونُک اجازت۔
\v 11 مگر تِمن چُھ یہ اکہِ ریٚتؠ یعنی دوٚیمہِ ریتہٕ کہ ژۅداہمہِ تٲریخہ شامس بٲگؠ مناوُن۔ فسح کہِ بڈِ دوٚہہ گژھِ کٹہٕ ماز خمبیرِ بغٲر کرِمژن ژۅچن سٟتی کھیٚون تہٕ بیٚیہِ کِھیو ٹیٚچھِ جڈی بوٹی۔
\v 12 امہِ منٛزٕ گژھِ نہٕ پگاہ کیٚوت کِہین تھاوُن تہٕ بیٚیہِ گژھِ نہٕ کٹہٕ سنٛز کانٛہہ أڈِج پُھٹراونہٕ یِنؠ۔ فسح مناونہٕ کِس سلسِلس منٛز گژھِ تمام ظٲبطن تحت روزُن۔\f + \fr 9‏:12 \ft یوحنا: 19:36\f*
\v 13 اگر توٚہہِ منٛزٕ کانٛسہِ کانٛہہ تِژھ کٲم کٔر نہٕ یمہِ کِنؠ نہٕ سُہ فسح عید مناونس لایکھ رود، تہٕ توٚہؠ ٲسیٚو نہٕ کُنہِ زیٹِھس سفرس پٮ۪ٹھ گرِ نیٚبر تہِ، تہٕ منٲسب وقتس پٮ۪ٹھ کٔرو نہٕ میانہِ خٲطرٕ قربٲنی تہِ۔ تیٚلہِ چُھو نہٕ توٚہؠ میانیٚو لوٗکو منٛزٕ۔ توٚہہِ پیٚیو سزا تلُن۔
\v 14 توٚہہِ منٛز موجود غٲر ملکی ین تہِ پزِ فسح جِشنس منٛز شٲمل سپدُن تہٕ تتھ مطلق پزیٚکھ میانیٚن تمام احکامن ہنٛز پٲروی کرٕنؠ۔
\p
\v 15‏-16 یمہِ دوٚہہ مقدس خٟمہ لاگنہٕ آو تتھ پٮ۪ٹھ رود ابُر چھٲوِتھ۔ مگر امہِ دوٚہہ آفتاب لوسنہٕ پٮ۪ٹھٕ دوٚیمہِ دوٚہہ آفتاب کھسنَس تام رود یہ ابُر اکہِ بڈِ نارٕکؠ پٲٹھؠ۔ یہ اوس پرٛتھ دوٚہہ سپدان تکیازِ اسرائیلی ٲسؠ بیانانس منٛز۔
\v 17 ییٚلہ یہ ابُر وُتھ تہٕ نوِ جایہ کُن گژھنہِ لوٚگ، اسرائیل یو لوگ اتھ پتہٕ پتہٕ پکُن۔ ییٚلہ ابُر رُکیو تہٕ اسرائیلی تہِ ٹھہریاے تٔتی تہٕ لاگِکھ پنٕنؠ خٟمہ۔
\p
\v 18 ییٚلہ یہُوواہنؔ ابُر پکنٲوِتھ تہٕ ٹھہرٲوِتھ تِمن نیرنُک اشارٕ کۅر تہٕ تِم دراے تہٕ ییٚلہ یہُوواہنؔ تِمن ٹھہرُن ووٚن تہٕ تِم ٹھہریاے۔ ییٚلہ ابُر مقدس خٟمس پٮ۪ٹھ رُکیو، تہٕ اسرائیل یو کۅر تٔتھؠ جایہ قرار۔
\v 19 کُنہ کُنہ وزِ اوس ابُر مقدس خٟمس پٮ۪ٹھ واریہن دوٚہُن ٹھہران، ییٚلہ یہ سپدان اوس تہٕ اسرائیلی ٲسؠ نہٕ اورٕ یور ڈلان۔
\v 20 کُنہ کُنہ ساعتہٕ اوس ابُر مقدس خٟمس پٮ۪ٹھ کینٛژن دوٚہنےٕ روزان۔ لوٗکھ ٲسؠ خٟمہ دِوان یتھٕ پٲٹھؠ زن یہُوواہنؔ تِمن ونمُت اوس تہٕ پتہٕ ٲسؠ تِم کُنہ نوِ جایہ کُن نیران ییٚلہ یہُوواہؔ تِمن تہِ کرنُک حکم دِوان اوس۔
\v 21 باضے اوس ابُر صرف اکِس دوٚہس کُنہ جایہ ٹھہران۔ ییٚلہ یہ سپُد، دویمہِ دوٚہہ صبحٲے اوس ابُر آسمانہٕ پٮ۪ٹھٕ ۅتھان تہٕ لوٗکھ تہِ ٲسؠ نیران۔ ییٚلہ تہ ابُر حرکت کران اوس دوٚہلہِ یا روتلہِ، لوٗکھ تہِ ٲسؠ نیرُن ہیٚوان۔
\v 22 اگرزنہٕ ابُر مقدس خٟمس پٮ۪ٹھ دوٚن دوٚہُن یا اکِس ریٚتس یا اکِس ورؠ یس تہِ ٹھہرِ ہے تہٕ تمہِ وزِ ٲسؠ لوٗکھ تٔتی روزان یتِتھ آسہٕ ہن۔ مگر ییٚلہ ابُر آسمانس کھسان اوس تِمہ تہٕ ٲسؠ نیرُن لاگان۔
\v 23 ییٚلہ یہُوواہنؔ تِمن رُکنُک یا خٟمہ لاگنُک حکم دیُت تہٕ تِمو کۅر تی۔ ییٚلہ تٔمؠ تِمن نیرنہٕ باپتھ ووٚن تہٕ تِم دراے۔ تِمو کۅر تی یہ تِمن یہُوواہنؔ موسیٰؔ سنٛدِ ذریعہ ووٚنمُت اوس کرنہٕ باپتھ۔
\c 10
\p
\v 1 یہُوواہنؔ ووٚن موسیٰؔ ہس یتہِ،
\v 2 "کانٛسہِ ون زِ سُہ بناوِ چانٛدِ دٔگِتھ زٕ ترے تُتہٕ نٲرؠ۔ یِم ہارنہٕ ین واینہٕ لوٗکن أکسےٕ جایہ سمنُک ناد دِنہٕ باپتھ تہٕ یہ اشارٕ کرنہٕ خٲطرٕ زِ تِم کرن پنٕنؠ خٟمہ بیٚیِس جایہ منتقل
\v 3 ییٚلہ دۅشوے ہارنہٕ وزن تمیُک مطلب گو زِ سارنےٕ چُھ مقدس خٟمہ کِس دروازس پٮ۪ٹھ حٲضر سپدُن۔
\v 4 وۅنؠ اگر اکےٕ ہارن واینہٕ ییہِ، تمیُک مطلب گو یہ زِ قبیلن ہنٛدیٚن صرف بہَن سردارن چُھ جمع سپدُن۔
\v 5 ییٚلہ ہارنہٕ بڈِ واینہٕ یِن تہٕ تِم قبیلہٕ یِم مقدس خٟمس مشرقہ طرفہٕ چھِ کرن نیرنٕچ تیٲری۔
\v 6 ییٚلہ ہارنہٕ دوٚیمہِ لٹہِ بڈِ ین واینہٕ تہٕ جنوب انٛدٕکؠ قبیلہٕ کرن نیرنُک سنٛز شروع۔ ہارنن پٮ۪ٹھ زوردار دھماکہٕ آسن یمہِ کتھ ہُنٛد اشارٕ زِ تِم کرن پکُن شُروع۔
\v 7 ییٚلہِ توٚہؠ صرف لوٗکھ ٲسؠ ووکھ جمع کرِنؠ یژھان تمہِ وزِ گژھن نہٕ ہارنہٕ بڈِ ینہِ واینہٕ۔
\v 8 کاہن یمہٕ ہارون سنٛدِ قبیلہٕ منٛزٕ چھِ تِمے آسن یمہٕ ہارنہٕ وایان۔ یِم چھِ تِم ظٲبطٕ یمہٕ نہٕ کُنہ وزِ بدلاونہٕ ین۔
\v 9 یِتھُےٕ توٚہؠ تِمن دشمنن سٟتؠ لٔڑیٚو یمہٕ تُہنٛدسےٕ ملکس منٛز توٚہہ پٮ۪ٹھ حملہٕ کران چھِ، کاہنن ؤنؠ زیٚو زِ واین زورٕ سان یمہٕ ہارنہٕ۔ بہٕ، یہُوواہؔ تُہنٛد خدا، بوزٕ تہِ، تہٕ بہٕ بچاوو توٚہؠ تُہنٛدیٚو دشمنو نشہٕ۔
\v 10 تہٕ کاہنن ؤنیٚو زِ تِم واین ہارنہٕ ییٚلہ لوٗکھ خوش آسن تہٕ پرٛتھ وریہ کیٚن بڈیٚن دوٚہُن پٮ۪ٹھ، تہٕ پرٛتھ ریٚتُک نوو ژۅنٛدر وُچھنہٕ کِس موقس پٮ۪ٹھ۔ تِمن ؤنیٚو زِ ییٚلہ لوٗکھ تِتھؠ قربان انن یمہٕ پوٗرٕ پٲٹھؠ بُزنہٕ ین، تہٕ ییٚلہ تِم مےٚ سٟتؠ رفاقت بحال کرنہٕ مۅکھٕ نذرانہٕ انن تمہِ وزِ واین ہارنہٕ۔ اگر تِم یہ کرن، امہِ سٟتؠ میلہِ توٚہہِ مدد مےٚ متعلق سونٛچنس منٛز۔ توٚہہِ پزِ یہ کرُن تکیازِ بہٕ یہُوواہؔ چُھس تُہنٛد خدا۔\f + \fr 10‏:10 \ft یہُوواہؔ تُہنٛد خدا کریٚو توٚہہِ مدد۔ \f*"
\v 11 مِصرٕ منٛزٕ اسرائیلی نیرنہٕ پتہٕ دویمہِ وریہ کہ دویمہ ریٚتکہِ وُہمہ تٲریخہ کھوٚت مقدس خٟمس پیٚٹھؠ کِنؠ ابُر۔
\v 12 لہٰذا دراے اسرائیلی سیناؔ کہ بیابانہٕ منٛزٕ تہٕ لٔگؠ شمالس کُن سفر کرنہِ یۅتام زن ابُر فاران کیٚن بیابانن منٛز رُکیٚو۔
\v 13 یہ اوس گۅڈنیُک موقہٕ ییٚلہ تِم تِمن ہِدایتن پٮ۪ٹھ عمل کٔرِتھ دراے یمہٕ یہُوواہنؔ موسیٰؔ ہس تِمن وننہٕ خٲطرٕ دِتمٕتؠ ٲسؠ،
\v 14 یۅسہ جماتھ ساروےٕ برُونٛہہ پنُن جھنٛڈٕ ہیٚتھ تور گییہ سۅ ٲس یہُوداؔ قبیلٕچ جماتھ۔ عِمیندآبؔ سُنٛد نیٚچو نحسونؔ اوس تِمن ہُنٛد سردار۔
\v 15 اشکار قبیلٕچ جماتھ ٲس تِمن پتہٕ۔ ضُغر سُنٛد نیٚچو نتنی ایلؔ اوس تِہُنٛد زیُٹھ۔
\v 16 امہِ پتہٕ درایہ زبولونؔ قبیلٕچ جماتھ۔ حیلونؔ سُنٛد الیابؔ اوس یہُنحد سردار۔
\v 17 پتہٕ کھول تِمو مقدس خٟمہ، جیرسونؔ تہٕ مراریؔ سنٛدیو اولادو تُل سُہ، تہٕ پٔکؠ برُونٛہہ۔
\v 18 روبنؔ سنٛدِ قبیلٕچ جماتھ درایہ امہ پتہٕ پنُن جھنٛڈٕ ہیٚتھ۔ شدیورؔ سُنٛد نیٚچو الیصورؔ اوس امہ قبیلُک سردار۔
\v 19 پتہٕ درایہ شمعونؔ سنٛدِ قبیلٕچ جماتھ صوری شدیؔ سُنٛد نیٚچو سلُومی ایل اوس یہُنحد زیُٹھ۔
\v 20 جدؔ سنٛدِ قبیلٕچ جماتھ درایہ امہ پتہٕ۔ دعوایلؔ سُنٛد نیٚچو الیاسبؔ اوس یہُنٛد سردار۔
\v 21 امہ پتٕچ جماتھ ٲس قہاتؔ۔ تمہٕ ٲسؠ مقدس خٟمٕکؠ مقدس چیز پکناوان۔ تِہنٛدِ توٚت واتنہٕ برونٛہےٕ اوس نوِ جایہ پٮ۪ٹھ مقدس خٟمہ لاگنہٕ آمُت۔
\v 22 پتہٕ ٲس افرائیمؔ قبیلٕچ جماتھ پنٕنؠ جھنٛڈٕ ہیٚتھ پکان۔ تہنٛزِ جمٲژ ہُنٛد زیُٹھ اوس عِمیہُودؔ سُنٛد نیٚچو الِیسمعؔ۔
\v 23 منسیؔ قبیلٕچ جماتھ درایہ امہِ پتہٕ۔ فداہ صُورؔ سُنٛد نیٚچو جملی ایلؔ اتھ قیادت کران۔
\v 24 پتہٕ دراو بنیمِینؔ قبیلُک کاروان۔ امِچ قیادت اوس جِدعونیؔ سُنٛد نیٚچو ابِدانؔ کران۔
\v 25 یۅسہ جماتھ پتہٕ گییہِ سۅ ٲس دان قبیلٕچ یمہ پنٕنؠ جھنٛڈٕ ہیٚتھ ٲسؠ۔ عمیشدائیؔ سُنٛد نیٚچو اخِیرع اوس امہ جمٲژ ہُنٛد سردار۔
\v 26 پتہٕ دراو آشرؔ قبیلُک قٲفلہٕ۔ عکرانؔ سُنٛد نیٚچو فجعی ایلؔ اوس امہِ قبیلُک زیُٹھ۔
\v 27 نفتالیؔ قبیلٕچ جماتھ درایہ ساروےٕ پۅتس۔ عینانؔ سُنٛد نیٚچو اخِیرع اوس اتھ جمٲژ قیادت کران۔
\v 28 یہ ٲس سۅ ترتیب یمہِ حسابہٕ اسرائیلی قبیلن ہنٛزٕ جمٲژ سفر آسہٕ کران۔
\p
\v 29 اکہ دوٚہہ ووٚن موسیٰؔ ہن پننِس مِدیانکِس بیمہٕ رعوایلسؔ سنٛدِس نیٚچوِس حُبابسؔ، "أسؠ چھِ تتھ جایہ کُن پکان یۅسہ یہُوواہنؔ اسہِ دِنُک وعدہ کۅرمُت چُھ۔ پکھ اسہِ سٟتؠ، أسؠ کرو بہتر پٲٹھؠ چٲنؠ خدمت، تکیازِ یہُوواہنؔ چُھ اسہِ یعنی اسرائیلی لوٗکن سٟتؠ بہتر کرنُک وعدہ کۅرمُت۔"
\p
\v 30 مگر حُبابنؔ دِتُس جواب، "نہ، بہٕ گژھٕ نہٕ توٚہہ سٟتؠ۔ بہٕ چُھس پنُن وطن تہٕ پننٮ۪ن گرِکیٚن نِش واپس گژھُن یژھان۔"
\p
\v 31 مگر موسیٰؔ ہن ووٚن، "مہربٲنی کٔرِتھ مہٕ تراو اسہِ۔ ژٕ چُھکھ تمہٕ جایہ زانان یتہِ أسؠ صحراوس منٛز پنٕنؠ خٟمہ لٲگتھ ہیٚکو، تہٕ ژٕ ہیککھ اسہِ رہبری\f + \fr 10‏:31 \ft رہمٲیی\f* کٔرِتھ۔
\v 32 اسہِ سٟتؠ یہ۔ أسؠ بٲگراوو ژےٚ سٟتؠ تمہ سٲری بہتر چیز یمہ یہُوواہؔ اسہِ دوان چُھ۔
\v 33 لہٰذا گو حُبابؔ اسرائیل ین سٟتؠ گژھنہٕ خٲطرٕ تیار۔ اسرائیل یو تروو کوہہِ سینا یتھ تِم یہُوواہؔ سُنٛد پہاڑ ونان ٲسؠ، تِم رودؠ تریٚن دوٚہُن پیدل پکان۔ تِم نفر یمہ مقدس صندوق ہیٚتھ ٲسؠ رودؠ تِمن تریٚن دوٚہُن باقے لوٗکن برُونٛہہ کنہِ تہٕ ٲسؠ پنٕنؠ خٟمہ لاگنہٕ باپتھ جاے ژھاران۔
\v 34 یہُوواہؔ سنٛدِ طرفہٕ سوزنہٕ آمُت ابُر اوس ہر وزِ تِمن سایہ کٔرتھ روزان۔
\p
\v 35 پرٛتھ دوٚہہ صبحٲے ییٚلہ تِم نفر یمہ مقدس صندوق ہیٚتھ ٲسؠ پکن ٲسؠ ہیٚوان، تہٕ موسیٰؔ کرِ دعا،
\q1 "اے یہُوواہؔ ؤتھیٚو!
\q2 پنٕنؠ دشمن چھکرٲے ووکھ!
\q2 توٚہہ سٟتؠ نفرت کرن وٲلؠ پانس نِش دوٗر کرنٕکؠ کٔریٚو اسباب!"
\v 36 تہٕ یتھُےٕ تِم لوٗکھ مقدس صندوق تھاونہٕ باپتھ رُکیاے تہٕ موسیٰؔ ہن کوٚر دعا،
\q1 "اے یہُوواہؔ، اسہِ ساسہٕ واد اسرائیل ین نزدیک روزیٚو۔
\c 11
\p
\v 1 اکہ دوٚہہ کٔر اسرائیلی لوٗکو یہُوواہسؔ نِش پننٮ۪ن مصیبتن ہنٛز شکایتھ۔ ییٚلہ یہُوواہنؔ تِمن ہُنٛد بوز سُہ سپُد غضبناک۔ لہٰذا سوز تٔمؠ لوٗکن درمیان اکھ نار یمؠ خٟمُک اکھ انٛد زول۔
\v 2 پتہٕ کۅر لوٗکو موسیٰؔ ہس فریاد تہٕ تٔمؠ مونٛگ یہُوواہسؔ دُعا۔ پتہٕ گو نار ژھیٚتہٕ۔
\v 3 لہٰذا تھوو تٔمؠ تتھ جایہ\f + \fr 11‏:3 \ft مطلب چُھ "زالٕنٕچ جاے"\f* تبعیرہؔ ناو، یمیُک معنی نار چُھ، تکیازِ یہُوواہؔ سُنٛد نار اوس تِمن منٛز باگ دوٚدمُت۔
\v 4 اکہِ دوٚہہ کٔر اکہِ فرہنگؠ لُکہ جمٲژ یۅسہ اسرائیلی لوٗکن سٟتؠ سفر کران ٲس بہتر کھیٚن چیٚنٕچ خٲہِش۔ تہٕ ییٚلہ تِمو یہ شکایتھ کٔر تہٕ اسرائیل یو تہِ لٲج شکایتھ کرٕنؠ۔ تِمو ووٚن، "کاش اسہِ آسہ ہے کھیٚنہٕ خٲطرٕ مازٕ ۂنا!\f + \fr 11‏:4 \ft 1 کورنتھ: 10:6\f*
\v 5 اسہِ چھےٚ سۅ گاڈ یاد یۅسہ اسہِ کھیٚییہِ ییٚلہ أسؠ مِصرس منٛز ٲسؠ، سۅ گاڈ یۅسہ اسہِ کُنہ ماوضہ بغٲرے دِژٲکھ۔ تہٕ اسہِ ٲسؠ تِم سٲری چیز یمن منٛز لٲر، خربُزؠ، لیکس، گنٛڈٕ تہٕ رہُن اوس یُس أسؠ کھیٚتھ ہیٚکہٕ ہو۔
\v 6 مگر وۅنؠ مۅکلییہِ اسہِ بۅچھے تکیازِ اسہِ چُھ وۅنؠ صرف یوٚہے مَنّ کھیٚنس۔
\p
\v 7 مَنّ چھِ یمے سفید بیلؠ پٔھلیاہ ہی۔
\v 8 پرٛتھ دوٚہہ ٲسؠ لوٗکھ صبحٲے نیران تہٕ زمینہٕ منٛزٕ کہتام سوٚمبران۔ تہٕ پتہٕ ٲسؠ سُہ پیسان یا کنیٚن پٮ۪ٹھ دٔگِتھ تتھ اوٹ بناوان۔ پتہٕ تُروہس بانس منٛز آب تہٕ سِوُکھ، نتہٕ بنٲوؠ ہس روٹ۔ روٚٹُن اوس ژۅچن ہنٛدؠ پٲٹھؠ مزٕ یمہٕ زیتون تیلس پٮ۪ٹھ پینہٕ ٲسؠ آمٕتؠ۔
\v 9 پرٛتھ رٲژ دوران اوس مَنّ زمینہٕ پٮ۪ٹھ شبنمٕکؠ پٲٹھؠ پیٚوان یتِتھ تہنٛدؠ خٟمہ لٲگِتھ ٲسؠ۔\f + \fr 11‏:9 \ft یوحنا: 6:31\f*
\p
\v 10 موسیٰؔ ہن بوز تمام اسرائیلی لوٗکھ ٲسؠ شکایت کران ییٚلہ تِم پننٮ۪ن خٟمہ کیٚن دروازن پٮ۪ٹھ ۅدٕنؠ ٲسؠ۔ یہُوواہؔ سپُد سیٹھاہ ناراض، تہٕ موسیٰؔ تہِ سپُد واریاہ پریشان۔
\v 11 سُہ گو مقدس خٟمس منٛز تہٕ پرژُھن یہُوواہسؔ، "توٚہہِ کیازِ ترٲوو مےٚ یعنی پننِس خٲدمس یہ پریشانی؟ مےٚ پٮ۪ٹھ کٔریٚو رحم! مےٚ کُس خطا چُھ کۅرمُت زِ توٚہہ تھٲوو یمن سارنی لوٗکن ہنٛزِ رٲچھ راوچہِ ہنٛز ذمہٕ دٲری مےٚ مٹہِ؟
\v 12 بہٕ چُھس نہٕ یہُنٛد مول۔ توٚہہِ کیازِ ونو مےٚ زِ یہنٛز رٲچھ راوٹ کٔریٚو یتھ کنؠ اکھ موج پننِس بچس تلان تہٕ پالان چھےٚ؟ بہٕ کِتھ کنؠ ہیٚککھ یم تتھ ملکس منٛز نِتھ یمیُک وعدہ توٚہہِ میانِس مٲلِس تہٕ بُڈِ ببَس سٟتؠ کۅرمُت چُھ؟
\v 13 بہٕ کتہِ انہٕ یمن سارنی لوٗکن ہنٛدِ باپتھ ماز؟ تِم چھِ مےٚ شکوٕ کران تہٕ ونان اسہِ دِیو کھیٚنہٕ خٲطرٕ ماز؟
\v 14 بہٕ ہیٚکنہٕ یمن سارنی لوٗکن یہ بار ویترٲوِتھ! تِم چھِ میانہِ خٲطرٕ اکھ بوٚڈ بوجھ، تہٕ بہٕ ہیٚکہٕ نہٕ مذید یہ گوٚب بار تُلِتھ۔
\v 15 اگر توٚہؠ مےٚ سٟتؠ یوٚہے سلوک کرُن یژھان چُھو تیٚلہ ژھنیٚو مےٚ وُنؠ مٲرتھ۔ وۅنؠ اگر توٚہہِ پٔزؠ پٲٹھؠ میانؠ فِکر چھےٚ، تیٚلہ کٔریٚو مےٚ پٮ۪ٹھ مہربٲنی تہٕ مےٚ ژھنیٚو مٲرتھ تاکہ یہنٛز رٲچھ راوٕٹ کرنٕچہ پریشانی نشہٕ گژھٕ بہٕ آزاد!
\p
\v 16 پتہٕ ووٚن یہُوواہنؔ موسیٰؔ ہس، "ژٕ انُکھ ستتھ نفر یمہٕ ژےٚ پتاہ چھی زِ تِم چھِ اسرائیل ین ہنٛدؠ سردار۔ تِمن ون زِ ژےٚ سٟتؠ روزن مقدس خٟمس نیٚبرٕ کنہِ کھڑا۔
\v 17 بہٕ وسہٕ بوٚن تہٕ کرٕ تِمن برُونٛہہ کنہِ ژےٚ سٟتؠ کتھ۔ پتہٕ تُلہ بہٕ پنُن کینٛہہ روحٲنی طاقت\f + \fr 11‏:17 \ft طاقت یا اختیار\f* ژےٚ نِش یُس ژےٚ چُھے تہٕ سُہ طاقت تراوٕ بہٕ تِمن پٮ۪ٹھ تہِ۔ تِم کرنے ژےٚ کینٛژن چیزن ہُنٛد خیال تھاونس منٛز مدد یمہ سٟتؠ لوٗکھ پریشان چھِ۔ تاکہ ژےٚ پیی نہٕ کُنسےٕ زٔنِس تہِ ویتراوُن۔
\v 18 امہِ مذید ون یِمن لوٗکن یتہ، پنٕنؠ پان بنٲیو میانِس قبولیتس لایکھ، تہٕ پگاہ میلیٚو توٚہہ کھیٚنہٕ خٲطرٕ ماز۔ یۅسہ توٚہؠ شکایت کران چُھو، تہٕ یہُوواہنؔ بوز تُہنٛد ییٚلہ توٚہؠ ونان ٲسیٚو، "أسؠ چھِ ماز کھیٚون یژھان۔ اسہِ اوس مِصرس منٛز بہترین کھیٚن چیٚن!" وۅنؠ دییہِ یہُوواہؔ توٚہہ کینٛہہ ماز تہٕ توٚہؠ کھییو سُہ۔
\v 19 توٚہؠ کھیٚیو نہٕ صرف اکِس یا دوٚن دوٚہُن بلکہ پانٛژن، دہن یا وُہن دوٚہُن تہِ ماز۔
\v 20 توٚہؠ کھیٚیو اکِس ریٚتس پرٛتھ دوٚہہ ماز تہٕ پتہٕ گژھیٚو توٚہہِ أمِچ نفرت تہٕ بیٚیہِ پھیرنو توٚہہِ امہِ سٟتؠ درۅکہٕ۔ یہ سپدِ اوٕ کِنؠ تکیازِ توٚہہِ تھوون یہُوواہؔ یُس یتہِ توٚہہ درمیان موجود چُھ نظر انداز تہٕ توٚہہِ وُنو تس برُونٛہہ کنہِ ودان ودان زِ اگر نہٕ اسہِ مِصر تروومُت آسہ ہے اسہِ آسہ ہے کھیٚنہ باپتھ بہترین کھیٚن۔"
\v 21 مگر موسیٰؔ ہن دیُت یہُوواہسؔ یورٕ جواب، "یتہِ چھِ مےٚ سٟتؠ شےٚ لچھ مرد، زنہٕ تہٕ شُرؠ، تہٕ توٚہؠ کیازِ چُھو ونان زِ بہٕ دمہٕ یمن کِس ریٚتس پرٛتھ دوٚہہ ماز کھیٚون؟
\v 22 اگر أسؠ سٲری تیر ژھاوِلؠ تہٕ گٲو تہِ مارووکھ توتہِ ہیٚکہ نہٕ یمن سارنی سُہ ماز پوشِتھ۔ حطاکہِ اگر أسؠ سمندرچہ سارے گاڈٕ رٹہٕ ووکھ تہٕ یمن دِمو تمہٕ تہِ پوشن نہٕ!
\v 23 مگر یہُوواہنؔ ووٚن موسیٰؔ ہس، "کیاہ ژٕ چُھکھا زانان زِ مےٚ چُھنہٕ کانٛہہ طاقت؟ وۅنؠ وُچھکھ ژٕ بہٕ ہیٚکا تہِ کٔرِتھ یہ کرنُک بہٕ ونان چُھس۔
\v 24 پتہٕ دراو موسیٰؔ مقدس خٟمہ منٛزٕ نیٚبر تہٕ ونُن اسرائیلی لوٗکن یہ یہُوواہنؔ ووٚن۔ پتہٕ کٔرؠ تٔمؠ ستتھ زِٹھؠ جمع تہٕ ونُن تِمن مقدس خٟمس نِش ۅدٕنؠ روزنہٕ باپتھ۔
\v 25 پتہٕ آو یہُوواہؔ تتھ ابرس منٛز یُس خٟمس پیٚٹھؠ کِنؠ اوس تہٕ سپُد موسیٰؔ ہس سٟتؠ ہمکلام۔ یہُوواہنؔ نیٚو موسیٰؔ ہس کینٛہہ روحٲنی طاقت واپس یُس تٔمؠ تس دیُتمُت اوس تہٕ دِتُن ستتھن سردارن۔ تِمن منٛز یُس روحٲنی طاقت آو تمہِ سٟتؠ دِژ تِمو نبوت انجام، مگر تِمو کۅر یہ صرف اکہِ پھرِ۔
\v 26 تمو ستتھَو زِٹھیٚو منٛزٕ ٲسؠ زٕ زِٹھؠ یمہٕ موسیٰؔ ہن منتخب کٔرؠ، اکھ الدادؔ تہٕ بیٚیہِ میدادؔ ٲسؠ نہٕ تمہِ تتہِ ییٚلہ باقی لوٗکھ تتہِ جمع ٲسؠ۔ تِمو ترُوو نہٕ پنُن خٟمہ أتی تہٕ گے مقدس خٟمس برُنٛہہ کنہِ کھڑا۔ مگر یہُوواہؔ سُنٛد روحٲنی طاقت گو تِمن پٮ۪ٹھ تہِ نٲزل تہٕ تِم تہِ لٔگؠ نبوت ورتاونہِ۔
\v 27 أکؠ نوجوان نفرن أنؠ دور تہٕ ونُن موسیٰؔ ہس، "الدادؔ تہٕ میدادؔ چھِ پننٮ۪ن تمام خٟمن منٛز نبوت کران۔"
\v 28 یسوعؔ یمؠ موسیٰؔ ہس لۅکچارٕ پٮ۪ٹھٕ مدد کۅر ووٚن، "جناب، تِمن ؤنیٚو زِ تِم کرن نہٕ یہ۔"
\p
\v 29 مگر موسیٰؔ ہن دِتُس جواب، "کیا توٚہہِ چھا یہ فِکر زِ تِم واتناون میانِس عزتس نقصان؟ کاش یہُوواہؔ سنٛدؠ تمام لوٗکھ ہیٚکہٕ ہن نبوت کٔرِتھ۔ کاش یہُوواہؔ دییہِ ہے تِمن سارنی پنُن روحٲنی طاقت!\f + \fr 11‏:29 \ft 1 کورنتھ: 14:5\f*
\v 30 پتہٕ گے موسیٰؔ سنٛدؠ تمام قٲید پن پننٮ۪ن خٟمن منٛز واپس۔
\v 31 پتہٕ سوز یہُوواہنؔ سمندری واوٕ طوفان۔ تٔمؠ وُڈٕنٲوؠ کمپس انٛدؠ پٔکؠ سٲری کَکو بٹیر، تہٕ کَکو پیٚے زمینس پٮ۪ٹھ ؤسؠ ؤسؠ۔ یمہٕ گے زمینہِ پٮ۪ٹھ اکھ میٹر تام تٔھدؠ جمع۔\f + \fr 11‏:31 \ft تقریباً پنداہ پٮ۪ٹھٕ وُہہ میٖل دوٗر\f*
\v 32 لہٰذا دراے لوٗکھ نیٚبر تہٕ اتھ دوٚہس تہٕ راتس تہٕ دویمہِ دوٚہہ تہِ سوٚمبراوِکھ یمہٕ کَکو۔ باسان اوس زِ پرٛتھ کانٛسہِ نفرن کٔرؠ لگ بگ زٕ کیوبِک میٹر جمع! تِمو ترٲوؠ سٲرسےٕ کیمپس انٛدؠ پٔکؠ کَکو وہرِتھ، تاکہِ تِم کَکو گژھن خوشک۔
\v 33 پتہٕ لٲگؠ تِمو رٔنِتھ تمہٕ کھیٚنؠ۔ مگر ییٚلہ تِم ماز کھیٚوان ٲسؠ تہٕ یہُوواہنؔ کۅر پننہِ ناراضگی ہُنٛد اظہار۔ تٔمؠ سوز تِمن وُبا یمہِ سٟتؠ واریاہ نفر مودؠ۔
\v 34 یمہٕ لوٗکھ مودؠ تہٕ دفن سپدؠ تِم ٲسؠ تِمے یمو ونمُت اوس زِ تِم چھِ ماز کھیٚون یژھان یتھٕ پٲٹھؠ أسؠ مِصرس منٛز کھیٚوان ٲسؠ۔ لہٰذا تھوو تِمو تتھ جایہ قبرُوت ہتاوہؔ ناو، تمیُک مطلب گو خٲہش کرن والیٚن ہنٛزٕ قبرٕ۔"\f + \fr 11‏:34 \ft 1 کورنتھ: 10:6\f*
\v 35 تتہِ پٮ۪ٹھٕ دراے اسرائیل لٕکؠ لوٗکھ مشرِقس کُن یۅتام تِمہ حصیراتؔ وٲتؠ، تتہِ ٹھہریاے تہٕ پتہٕ بیٹھؠ واریہس وقتس تٔتی۔
\c 12
\p
\v 1‏-2 موسیٰؔ سنٛزِ بٔڈ بیٚنہِ مریمؔ تہٕ تمسُنٛد بوٚڈ بوے ہارونؔ ؤلؠ حسدن تہٕ ونُکھ، "کیاہ صِرف چھا موسیٰؔ واحد شخص یمِس اتھِ یہُوواہنؔ اسہِ پٲغام سوزؠ؟ کیاہ یہُوواہؔ چُھنا اسہِ دوٚیو ذرؠ یہ تہِ پٲغام سوزان؟ تِمو بنوو موسیٰؔ تہِ تنقیدک نشانہٕ تکیازِ تٔمؠ اوس کُوشؔ\f + \fr 12‏:1‏-2 \ft ملکِ اِتھوپیاؔ\f* قبیلچہ اکِس زنہِ سٟتؠ نیتٕھر کۅرمُت۔ یہُوواہنؔ بوز زِ مریمؔ تہٕ ہارونؔ چھِ موسیٰؔ سنٛز شکایت کران۔
\p
\v 3 پزر چُھ یی زِ موسیٰؔ اوس اکھ شریف انسان۔ سُہ اوس تیوٗت شریف یوٗت نہٕ روے زمینس پٮ۪ٹھ کانٛہہ اوس۔
\v 4 یہُوواہنؔ کٔر فوری طور موسیٰؔ ہس، ہارونَس تہٕ مریمسؔ سٟتؠ کتھ۔ تٔمؠ ووٚن، "توٚہہِ ترٛینونی پزِ گژُھن تہٕ مقدس خٟمس نِش کھڑا روزُن" تہٕ تِمو کۅر تی۔
\v 5 پتہٕ دراو یہُوواہؔ خٟمہ کِس دروازس پٮ۪ٹھ ابرس ؤلِتھ یُس اکہِ بڈِ ابرٕ تھمبٕکؠ پٲٹھؠ اوس۔ تٔمؠ ووٚن ہارونسؔ تہٕ مریمسؔ برُونٛہہ کُن پکنہٕ باپتھ، تہٕ تِمو کۅر تی۔
\v 6 پتہٕ ووٚن تٔمؠ تِمن، "میانؠ کتھ بوزیٚو!
\q1 ییٚلہ کانٛہہ نبی توٚہہِ درمیان آسان چُھ،
\q1 بہٕ چُھس عمومن پنُن پان تمِس پٮ۪ٹھ ظٲہر کران یُتھ سُہ تصور کرِ،
\q1 تہٕ بہٕ چُھس خابس منٛز تس سٟتؠ کتھٕ کران۔
\q1
\v 7 مگر بہٕ چُھس نہٕ پننِس خٲدِم موسیٰؔ ہس سٟتؠ تتھٕ پٲٹھؠ کتھ کران۔\f + \fr 12‏:7 \ft تس پٮ۪ٹھ ہیکو میانٮ۪ن تمام معاملاتن متعلق بھروسہٕ کٔرِتھ \f*
\q2 مےٚ چُھ یقین زِ سُہ کرِ میانیٚن لوٗکن ہنٛز بہتر رہنمائی۔
\q1
\v 8 لہٰذا چُھس بہٕ تس سٟتؠ روبرو کتھ کران۔
\q1 بہٕ چُھس تس سٟتؠ سیٚود پٲٹھؠ کتھ کران، نکہِ تمثیلو ذرؠ یہ۔
\q1 تٔمؠ وُچھ یتہِ زِ بہٕ کیٚوتھ چُھس بوزنہٕ یوان۔
\q1 تہٕ توٚہہ پزِ میانس بنٛدٕ موسیٰؔ ہس پٮ۪ٹھ تنقید کرنس کھۅژُن۔
\p
\v 9 یہُوواہؔ سپُد مریمسؔ تہٕ ہارونسؔ واریاہ ناراض سُہ وُتھ تہٕ دراو۔
\p
\v 10 ییٚلہ ابُر مقدس خٟمہ پٮ۪ٹھٕ ژۅل تہٕ ہاروننؔ وُچھ مریمسؔ کُن تہٕ وچُھن زِ تمسُنٛد مسلہٕ اوس سفید شین ہیٚو گۅمُت تکیازِ تٔمس اوس مینٛدؠ بٮ۪مٲرؠ لاحق گمٕژ۔
\v 11 ہاروننؔ ووٚن موسیٰؔ ہس، "جناب، اسہِ مہٕ دِ امہ گنہُک سزا یُس اسہِ بےوقوفی کِنؠ سرِزد سپُد۔
\v 12 مریمؔس مہٕ دِ تس بچس ہِش بننہٕ یُس زیٚوان زیٚوانےٕ مود تہٕ یمسُنٛد نیصف جسٕم بوسیدٕ اوس سپُدمُت۔
\v 13 اوٕ مۅکھٕ کۅر موسیٰؔ ہن یہُوواہسؔ فریاد تہٕ وُننَس، "اے خدایہ بہٕ چُھسے ژےٚ اِلتجا کران زِ أمِس کر شِفا۔"
\v 14 مگر یہُوواہنؔ دِتُس جواب، "اگر تمسُنٛد مول تٔمس غلطی پٮ۪ٹھ بےٚ وٲری کرِ تہٕ بُتھِس تھۅکہ لایہ، سۅ روزِ ستن دوٚہُن شرمنٛدٕ۔ تمِس پزِ پننِس کٔرممتِس پٮ۪ٹھ شرمنٛدٕ سپدُن۔ لہٰذا تھٲؠ وون سۅ ستن دوٚہُن کیمپس نیٚبر۔ پتہٕ آسہ نہٕ تس مذید مینٛدؠ بٮ۪مٲرؠ تہٕ سۅ ہیٚکہ پتہٕ کیمپس منٛز واپس یِتھ۔"\f + \fr 12‏:14 \ft اِستِثنا 25:9؛ ایوب 30:10؛ یشعیا 50:6:\f*
\v 15 تہٕ تِمو تھٲو سۅ ستن دوٚہُن خٟمہ گاہس نیٚبر۔ تۅتام گے نہٕ یِم لوٗکھ کُنہ دوٚیمہِ جایہ یۅتام نہٕ سۅ واپس آیہ۔
\v 16 تٔمہِ پتہٕ ییٚلہ سۅ واپس آیہ تہٕ تِم دراے حصیراتؔ منٛزٕ تہٕ گے فاران کیٚن صحراون کُن تہٕ لٲگِکھ تتہِ پنٕنؠ خٟمہ۔
\c 13
\p
\v 1 یہُوواہنؔ ووٚن موسیٰؔ ہس بیٚیہِ،
\v 2 "کینٛہہ نفر سوزُکھ مُشاہدٕ باپتھ ملکِ کنعان۔ یہ چُھ سُہ ملک یُس بہ توٚہہ اسرائیلی لوٗکن دِمو۔ تِم نفر سوزؠ ووکھ یِم پننٮ۪ن قبیلن ہنٛدؠ سردار چھِ"
\p
\v 3 لہٰذا کۅر موسیٰؔ ہن تی یمیُک یہُوواہنؔ حکم کۅرُس۔ تٔمؠ سوزؠ تِم باہ اسرائیلی نفر یمہٕ تمام قبیلن ہنٛدؠ سردار ٲسؠ۔ تٔمؠ کٔڈؠ تِم فاران کِس صحراوس منٛز موجود تہنٛدیٚو کیمپو منٛزٕ۔
\v 4 یِم چھِ تِمن نفرن تہٕ تہنٛدین قبیلن ہنٛدؠ ناو یمن سٟتؠ تِم وابستہٕ چھِ:
\p روبن سنٛدِ قبیلہٕ منٛزٕ اوس زکورؔ سُنٛد نیٚچو سمُوعؔ۔
\p
\v 5 شمعونؔ سنٛدِ قبیلہٕ منٛزٕ اوس حوری سُنٛد نیٚچو سافطؔ۔
\p
\v 6 یہُوداؔ سنٛدِ قبیلہٕ منٛزٕ اوس یفُنہؔ سُنٛد نیٚچو کالبؔ۔
\p
\v 7 اشکار سنٛدِ قبیلہٕ منٛزٕ اوس یوسفؔ سُنٛد نیٚچو اِجال
\p
\v 8 افرائیمؔ سنٛدِ قبیلہٕ منٛزٕ اوس نُونؔ سُنٛد نیٚچو ہوسِیع۔
\p
\v 9 بنیمِینؔ سنٛدِ قبیلہٕ منٛزٕ اوس رفو سُنٛد نیٚچو فَلتیؔ۔
\p
\v 10 زبولونؔ سنٛدِ قبیلہٕ منٛزٕ اوس سودیؔ سُنٛد نیٚچو جدّی ایل۔
\p
\v 11 یوسفؔ سنٛدِ سِلسِلہ منٛزٕ اوس منسیؔ قبیلُک سُوسیؔ بنِ جدّی۔
\p
\v 12 دان قبیلہٕ منٛزٕ اوس جملّیؔ سُنٛد نیٚچو عمی ایلؔ۔
\p
\v 13 آشرؔ سنٛدِ قبیلہٕ منٛزٕ اوس میکاایلؔ سُنٛد نیٚچو ستُورؔ۔
\p
\v 14 نفتٲلی سنٛدِ قبیلہٕ منٛزٕ اوس وُفسیؔ سُنٛد نیٚچو نخبیؔ۔
\p
\v 15 جدؔ سنٛدِ قبیلہٕ منٛزٕ اوس ماکیؔ سُنٛد نیٚچو جیُوایلؔ۔
\m
\v 16 یمہ چھِ تِمن نفرن ہنٛدؠ ناو یمہٕ موسیٰؔ ہن کنعان دٔرؠ یافت خٲطرٕ سوزؠ۔ یہنٛدِ گژھنہٕ برُونٛہہ تھوو موسیٰؔ ہن ہوسِیع سُنٛد نوو ناو یسوعؔ۔ یمیُک معنی چُھ 'یہُوواہسؔ بچاون وول'۔\f + \fr 13‏:16 \ft یشوع مطلب یہُوواہؔ سُنٛد مدد۔\f*
\p
\v 17 امہِ برُنٛہہ زِ موسیٰؔ ہن کرِ تِمن کنعان دریافت کرنہِ، موسیٰؔ ہن ووٚن تِمن، "جنوبی یہُودیہ کیٚو بیابانو کِنؠ نیرؠ زیٚو۔ پتہٕ وٲتؠ زیٚو شمالہٕ کِنؠ پہٲڑی ملکس منٛز۔\f + \fr 13‏:17 \ft کنعانُک جنوبی صحراو \f*
\v 18 وُچھزیٚو زِ زمین کِژھ چھےٚ۔ وُچھزیٚو زِ تتِکؠ روزن وٲلؠ لوٗکھ چھا مضبوط کِنہٕ کمزور۔ وُچھو زِ تتہِ چھا واریاہ لوٗکھ کِنہٕ کمےٕ۔
\v 19 معلوم کٔرؠ زیٚو زِ تِمہ کیٚمہِ قسمٕچہ زمینہِ پٮ۪ٹھ چھِ روزان۔ سۅ چھا اصل کِنہٕ خراب؟ تِمن شہرن متعلق تہٕ کٔرؠ زیٚو معلوم یمن منٛز تِمہ روزان چھِ۔ تِمن چھا ژۅپٲرؠ دیوار کِنہ نہ؟
\v 20 میٚژِ متعلق تہِ زٲنؠ زیٚو، سۅ چھا زرخیز کِنہ نہ؟ معلوم کٔرؠ زیٚو زِ تتہِ چھا کُلؠ۔ کوشش کٔرؠ زیٚو تتہِ ۅپدن وٲلؠ کینٛہہ پھل یور اننٕچ۔ "تِمو ووٚن یہ اوٕ موٚکھٕ تکیازِ امہ وزِ اوس دچھ والنُک گۅڈٕ کال۔
\p
\v 21 یتھٕ کنؠ دراے یم باہ نفر کنعان کُن۔ تِم پھیرؠ جنوبی صِینؔ کیٚو بیابانو کِنؠ شمٲلی لبو حماتسؔ نکھٕ رحوبؔ\f + \fr 13‏:21 \ft ہمتھُک شُمٲلی دٲخلہٕ\f* شہرس تام سٲرؠ سےٕ۔
\v 22 تِم گےَ جنوبی یہُودیہ کیٚن بیابانن منٛز حبرون، یتہِ عناقؔ سنٛدؠ بٔڈؠ مُہنی اخِیمان، سیسیؔ تہٕ تلمیؔ روزان ٲسؠ۔ حبرونؔ چُھ اکھ شہر یُس مِصرس منٛز ضعانؔ شہرٕ کہ تعمیرٕ برونٛہہ ستتھ وری بناونہٕ آمُت اوس۔\f + \fr 13‏:22 \ft عنِیٲقؠ ٲسؠ کنعانٕکؠ افسانوی اصلی روزن وٲلؠ۔ وُچھِو اِستِثنا 1:28؛ 9:2:\f*
\v 23 اکِس وادی منز ژۅٹ تِمو اکہِ دچھِ باگہٕ منٛزٕ اکھ دچھِ گۅرن۔ یہ اوس سیٹھاہ بوٚڈ، یمہِ کِنؠ یہ پکہٕ ناونہٕ باپتھ دوٚن نفرن اکِس ڈنٛڈس پٮ۪ٹھ تلُن پیٚو۔ تِمو تُلؠ کینٛہہ دٲن تہٕ انجیر پننِس کیمپس منٛز ننہٕ باپتھ۔
\v 24 تِمو ووٚن تتھ جایہ اِسکال ناو، یمیُک مطلب اوس 'گۅرُن' تکیازِ تِمو اوس تتہِ سُہ بوٚڈ دچھِ گۅرُن ژوٚٹمُت۔
\v 25 برابر ژتجہن دوٚہُن زمینہِ ہُنٛد جٲئزٕ ننہٕ پتہٕ آے تِم پننِس کیمپس پٮ۪ٹھ واپس۔
\v 26 تِم آے قادِس قصبس منٛز فاران کیٚن بیابانن منٛز ہارونؔ، موسیٰؔ تہٕ باقی اسرائیلی لوٗکن نِش واپس۔ تِمو یہ کینٛژھا وُچھ تہِ ونُکھ سارنی۔ تِمو ہٲوؠ تِمن تِم میٚوٕ تہِ یمہ تِمو سٟتؠ ٲسؠ أنمٕتؠ۔
\v 27 مگر تِمو دیُت موسیٰؔ ہس یہ پٲغام زِ، أسؠ وٲتؠ تتھ ملکس منٛز یُس دریافت کرنہٕ مۅکھٕ توٚہہ أسؠ سوزیٚو۔ سۅ چھےٚ پٔزؠ پٲٹھؠ اکھ خوبصورت جاے۔ سۅ چھےٚ سیٹھاہ زرخیز زمین\f + \fr 13‏:27 \ft واریاہ ذرخیز زمین\f*۔ یکیاہ یِم چھِ کینٛہہ میٚوٕ۔
\v 28 مگر یمہ تتِکؠ لوٗکھ چھِ تِم چھِ سیٹھاہ طاقتور۔ تہنٛدؠ شہر چھِ بٔڈؠ یمہٕ ژۅپٲرؠ دیوار بنٛد چھِ۔ حالانکہ اسہِ وُچھ تتہِ واریاہ عناقؔ زٲژ ہنٛدؠ تہِ۔
\v 29 عمالیقؔ قبیلٕکؠ اولاد چھِ ملکہ کِس جنوبی حصس منٛز روزان تہٕ حِتی، یبوسؔ تہٕ امورؠؔ ین ہنٛدؠ اولاد چھِ شمال انٛدٕ کِس پہٲڑی ملکس منٛز روزان۔ سمندر کیٚن سٲحِلن تہٕ یردن درؠ یاوٕ بٔٹھؠ بٔٹھؠ چھِ کنعانیؔ زٲژ ہنٛدؠ لوٗکھ چھِ روزان۔"
\p
\v 30 کالبنؔ ووٚن یہ تِمن لوٗکن یمہٕ موسیٰؔ ہس نِش کھڑا ٲسؠ۔ پتہٕ ووٚن تٔمؠ، "اسہِ پزِ تور گژھُن تہٕ تتھ زمینَس پٮ۪ٹھ قبضہٕ کرُن، تکیازِ اسؠ چھِ یقینن سُہ فتح کرنس قٲبل۔"
\v 31 مگر یمہ نفر تس سٟتؠ گمٕتؠ ٲسؠ تِمو ووٚن، "نہ، أسؠ ہیٚکو نہٕ تِمن لوٗکن حملہٕ کرِتھ شِکس دِتھ۔ تمہٕ چھِ سانہٕ نشہٕ واریاہ طاقتور۔"
\v 32 یتھٕ کنؠ ؤنؠ تِمو نفرو اسرائیلی لوٗکن تتھ ملکس مطلق غلط خبر یُس تِمو دریافت کۅرمُت اوس۔ تِمو ووٚن، "اسہِ یمہ زمینہِ ہنٛدؠ معلومات حٲصل کٔرؠ سۅ زمین چھےٚ تِمن لوٗکن ہنٛز زندگی فناہ کران یمہٕ تتھ پٮ۪ٹھ حملہٕ کرنٕچ کوشش کران چھِ۔ تہٕ تتہِ روزن وٲلؠ تمام لوٗکھ چھِ سیٹھاہ تٔھدؠ۔
\v 33 اسہِ وُچھ تتہِ جنات تہِ۔ تِم چھِ عناقؔ سنٛدیو اولادو منٛزٕ تِم دیوقامت لوٗکھ چھِ نیفیلمؔ پٮ۪ٹھٕ آمٕتؠ ییٚلہ اسہِ تِم جنات وُچھ اسہِ باسیاو پنُن پان یمے ۅٹکُکلہٕ ہی تہٕ تِمن تہِ اوس خیال زِ أسؠ چھِ ۅٹکُکلن ہنٛدی پٲٹھؠ۔\f + \fr 13‏:33 \ft ۅٹکُکلن ہنٛدؠ پٲٹھؠ لۅکٕٹؠ\f*
\c 14
\p
\v 1 تمہِ دوٚہہ راتس ٲسؠ اسرائیلی تمام لوٗکھ بڈِ بڈِ ودان۔\f + \fr 14‏:1 \ft عبر: 3:16-18\f*
\v 2 دویمہِ دوٚہہ کٔر ساروےٕ ہارونؔ تہٕ موسیٰؔ سنٛز شکایت۔ ساروےٕ نفرو ووٚن، "کاش أسؠ مرٕہو مِصرس منٛز یا یمن بیابانن منٛز!\f + \fr 14‏:2 \ft 1 کورنتھ: 10:10\f*
\v 3 یہُوواہؔ کیازِ چُھ اسہِ تتھ ملکس منٛز نِوان یتہ أسؠ تلوارو سٟتؠ مارنہٕ یمو؟ تہٕ تِمہ بناون سانیٚن بچن تہٕ سانیٚن گرٕواجنیٚن پنٕنؠ غلام۔ کنعان گژھنہٕ کھۅتہٕ چُھ سانہِ خٲطرِ بہتر مِصر واپس گژُھن!"
\v 4 پتہٕ ووٚن تِمو منٛزٕ کینٛژۅ اکھ أکِس، "اسہِ پزِ اکھ سُہ زیُٹھ ژارُن یُس اسہِ مِصر واپس نیٚیہ۔"\f + \fr 14‏:4 \ft اعمال 7:39\f*
\p
\v 5 پتہٕ کۅر ہاروننؔ تہٕ موسیٰؔ ہن تمام اسرائیلی لوٗکن یمہ تتہِ موجود ٲسؠ برونٛہہ کنہِ سجدٕ۔
\v 6 یشُوع تہٕ یفُنہؔ سُنٛد نیٚچو کالِب ناوٕ کیٚو دوٚیو نفرو یمو یمو زمینٕچ دریافت کٔرمٕژ ٲس ژٔٹؠ پانس پلو، تکیازِ تِم گابرے سیٹھاہ۔
\v 7 تِمو ووٚن اسرائیل کیٚن، "اسہِ یمہ ملکٕچ دریافت کٔر سُہ چُھ واریاہ جان۔
\v 8 اگر یہُوواہؔ اسہِ رٲضؠ آسہ تہٕ سُہ نیٚیہ اسہِ تتھ سیٹھہےٕ زرخیز زمینہِ پٮ۪ٹھ تہٕ دییہِ سۅ اسہِ۔
\v 9 لہٰذا مہٕ کٔریٚو یہُوواہسؔ خلاف بغاوت! تہٕ تمہِ ملکہ کیٚن لوٗکن مہٕ کھۅژیٚو! أسؠ کرووکھ تِمہ ختم! تمن نشہٕ چُھنہٕ کانٛہہ یس تِہنٛز حفاظت کرِ، مگر یہُوواہؔ آسہ اسہِ سٟتؠ تہٕ کرِ اسہِ مدد۔ لہٰذا مہٕ کھۅژیٚو تِمن!"\f + \fr 14‏:9 \ft یہُوواہؔ، سٲنؠ خداین دِیُت تِمن دیوتاہن شِکست یمو تہنز حفاظت کٔر۔\f*
\p
\v 10 اسرائیلی لوٗکو ہیٚتؠ کالبؔ تہٕ یشُوع کنہِ لٲیتھ مارنٕچ کتھ کرِنؠ۔ مگر اچانک گو تِمن پٮ۪ٹھ خٟمہ منٛزٕ یہُوواہؔ سُنٛد جلال ظٲہر۔
\v 11 پتہٕ ووٚن یہُوواہنؔ موسیٰؔ ہس زِ یم لوٗکھ کۅتام روزن مےٚ رد کران؟ بہٕ آس یمو نشہٕ سیٹھاہ تنٛگ زِ بھروسہٕ نہٕ کرنہٕ یِنہٕ موجُب کیاہ ورتاوٕ بہٕ یمن سٟتؠ، تمہٕ معجزٕ ہاونہٕ باوجود یمہٕ مےٚ یِمن برُونٛہہ کنہِ کٔرؠ۔
\v 12 بس بہٕ تراوٕ یمن وُبا تہٕ تُلہ ناوٕ یمن نشہٕ تھف۔ مگر چٲنؠ اولاد بناوکھ بہٕ اکھ عظمتہٕ واجِنؠ رَیت۔ تمہِ آسن تیٚوتھ اکھ قوم یمہ تمو لوٗکو نشہٕ سیٹھاہ عظیم تہٕ زیادٕ مضبوط آسن۔
\v 13 مگر موسیٰؔ ہن ووٚن یہُوواہؔ ہس یورٕ، "مہربٲنی کٔرِتھ مہٕ کٔریوٚ تہِ، تکیازِ مِصرٕکؠ لوٗکھ بوزن اتھ متعلق! توٚہہ أنووکھ پننہٕ عظیم طاقتہٕ سٟتؠ اسرائیل لٕکؠ یم لوٗکھ مِصرٕ پٮ۪ٹھٕ واپس،
\v 14 تہٕ مِصرٕکؠ لوٗکھ ونن ملکس منٛز روزن والیٚن کنعانیٚن ہنٛدیٚن اولادن۔ یہُوواہؔ، تِمو چُھ گۅڈے توٚہہ متعلق بوزمُت۔ تِم چھِ زانان زِ توٚہؠ چُھو تِمن لوٗکن سٟتؠ روزان تہٕ تِمو وُچھہو توٚہؠ روبرو تہِ۔ تِمو بوز زِ تُہنٛد اکھ بوٚڈ ابرٕ لونٛگ چُھ تِمن پٮ۪ٹھ سایہ کٔرِتھ روزان۔ تہٕ سُہ ابُر چُھ تِمن دوٚہلہِ وتہٕ ہاوُک بنان تہٕ راتس نارٕ بٔنتھ تِمن گاش دِوان۔
\v 15 اگر توٚہؠ یِم سٲری لوٗکھ اکی ساعتہٕ مٲرؠ ووکھ تہٕ یمو لوٗکو تُہنٛدس طاقتس متعلق بوزمُت چُھ تِمہٕ ونن،
\v 16 "یہُوواہؔ اوس نہٕ یتھ قٲبل زِ سُہ انہِ ہے یِمن اسرائیل ین یتھ ملکس منٛز یمیُک تٔمؠ یِمن وعدہ کۅرمُت اوس۔ تٔمؠ ژھٕنؠ یِم صحراوس منٛز مٲرِتھ۔"\f + \fr 14‏:16 \ft 1 کورنتھ: 10:5\f*\f + \fr 14‏:16 \ft خروج 34:6-7\f*
\v 17 اے یہُوواہؔ، لہٰذا ہاو زِ ژٕ چُھکھ واریاہ طاقتہٕ وول۔ تِمو فرموو،
\v 18 "بہٕ چُھس یِتھے ناراض سپدان، بلکہ چُھس بہٕ لوٗکن سٟتؠ واریاہ محبت کران، بہٕ چُھس لوٗکن ہنٛدؠ گناہ تہٕ پننٮ۪ن حکمن ہنٛز نافرمٲنی معاف کران۔ مگر بہٕ دِمہ ہمیشہٕ تِمن سزا یِمن غلطی سرِزد سپدن۔ ییٚلہ مٲلؠ گناہ کرن تہٕ بہٕ دِمہ تِمن سزا۔ مگر بہٕ دِمہ تہنٛدیٚن اولادن، تہنٛدیٚن زُریٚن تہٕ زُریٚن ہنٛدیٚن زُریٚن تہِ سزا۔"\f + \fr 14‏:18 \ft خروج 34:6-7\f*
\v 19 چونکہ توٚہؠ چُھو پننٮ۪ن لوٗکن سٟتؠ بے لوٗث تہٕ اژھیٚون محبت کران، یمن لوٗکن کٔریٚو معاف تمہٕ گناہ یمہٕ یمو کٔرؠ مٕتؠ چھِ، یتھٕ کنؠ توٚہہ یمن سٟتؠ معاف کرنٕچ ریٚوایت قٲیم کٔرمٕژ چھےٚ ینہٕ تِمہ مِصرٕ منٛزٕ درامٕتؠ چھِ۔"
\v 20 پتہٕ دیُت یہُوواہنؔ جواب، "مےٚ کۅر یِمن معاف یتھ کنؠ مےٚ معاف کرنہٕ باپتھ توٚہہ عرضی کٔرو۔
\v 21 مگر زنتہ بہٕ اچانک زنٛدٕ گوس تہٕ سارے دُنیہٕکؠ لوٗکھ وچُھن میٚون جلال، بہٕ چُھس یہ اعلان کران زِ\f + \fr 14‏:21 \ft عبر: 3:11\f*
\v 22 یمو ساروےٕ لوٗکو وُچھ میٚون جلال تہٕ تِم سٲری معجزات یمہٕ مےٚ مِصرس تہٕ بیابانن منٛز ہٲوؠ۔ مگر تِمو کٔر میانؠ نافرمٲنی، تہٕ کٔژِ پھرِ کٔر تِمو یہ ازمٲیش زِ کیاہ أسؠ ہیٚکوا میٚون سزا تلُنہٕ بغٲر بُرٕ کامہِ جٲرے تھٲوِتھ۔\f + \fr 14‏:22 \ft عبر: 3:18\f*
\v 23 امہِ کِنؠ ہیٚکہ نہٕ تِمو منٛزٕ کانٛہہ اکھ سُہ ملک وُچِھتھ یُس دِنُک وعدہ مےٚ تہنٛدیٚن مالیٚن تہٕ بُڈِ ببن سٟتؠ کۅرمُت چُھ۔ کانٛہہ تہِ یمؠ بہٕ منسووُس ہیٚکنہٕ سۅ زمین وُچِھتھ۔
\v 24 مگر کالبؔ یُس مےٚ بہترین خدمت کران چُھ چُھ باقیٚو نشہٕ الگ۔ سُہ چُھ مکمل پٲٹھؠ میانؠ عبادت کران۔ لہٰذا انن بہٕ سُہ یتھ ملکس منٛز یُس تٔمؠ گۅڈے وُچھمُت چُھ، تہٕ تمسنٛدؠ اولاد آسن تتہِ کُنیٚکؠ وٲرث۔
\v 25 چونکہ عمالیق تہٕ کنعانؠ نسٕل یم کنعان وادی منٛز روزان ٲسؠ چھِ سیٹھاہ مضبوط، لہٰذا ییٚلہ توٚہؠ پگاہ یتہِ نیریٚو توٚہؠ گٔژھؠ زیٚو کنعانچہِ سرِزمینہِ کُن سفر کرنہٕ بجایہ ریگستانن منٛز بحرِ قُلزمؔ کِنؠ واپس۔
\v 26 پتہٕ ووٚن یہُوواہنؔ ہارونسؔ تہٕ موسیٰؔ ہس،
\v 27 "امہِ قومٕکؠ یمہٕ شرارتی لوٗکھ کٲتِس کالس روزن میانؠ شکایت کران؟ مےٚ بوز تہِ سورےٕ یہ یمو مےٚ خلاف بۅکمُت چُھ۔
\v 28 لہٰذا ؤنیٚو یمن وۅنؠ یہ زِ یۅتام بہٕ 'یہُوواہؔ' زنٛدٕ چُھس، بہٕ کرٕ تی یہِ توٚہہ وُنو۔
\v 29 بہٕ مارو توٚہؠ سٲری یتی یمنےٕ بیابانن منٛز۔ تکیازِ توٚہؠ رودیٚو میانؠ شکایت کران یمہِ کِنؠ توٚہہِ منٛزٕ کانٛہہ تہِ یمسنٛز وانٛس وُوہہ وری کھۅتہٕ زیادٕ آسہ تہٕ یُس موسیٰؔ ہن سٲری گنٛزراونہٕ وزِ شمارس اُنمُت آسہ، \f + \fr 14‏:29 \ft عبر: 3:17\f*
\v 30 گژھِ نہٕ تتھ ملکس منٛز دٲخٕل یمیُک وعدہ مےٚ توٚہہِ ٮسٟتؠ کۅرمُت چُھ۔ صرف گژھن کالبؔ تہٕ یشوعؔ تتھ ملکس منٛز دٲخٕل۔
\v 31 توٚہہِ وُنو زِ تُہنٛدؠ بچہٕ توٚہہِ نِش نِتھ بنن غلام، مگر بہٕ نِمکھ تِمہ تتھ ملکس منٛز تہٕ تمہ تُلن تتہِ روزِتھ تمہِ ملکُک لُطف یُس توٚہہِ مسترد کۅرون۔
\v 32 مگر یمہٕ توٚہؠ بالینٛگ چُھو توٚہؠ مٔریٚو یتؠ یمنےٕ بیابانن منٛز۔
\v 33 تُہنٛدؠ بچہٕ روزن یتھ بیابانس منٛز چارواین ہنٛدؠ پٲٹھؠ ژتجہن ورؠ ین تام پھیران تھۅران تکیازِ توٚہؠ بٔڈؠ چُھو نہٕ میانؠ وفادار، تُہنٛدؠ بچہٕ تُلن تۅتام دۅکھ تہٕ پریشانی یۅتام نہٕ توٚہؠ بیابانن منٛز مٔریٚو۔
\v 34 توٚہؠ روزیٚو ژتجہَن ورؠ ین پننٮ۪ن گُنہَن ہُنٛد سزا تُلان۔ یہ آسہ تِمو ژتجہو دوٚہو منٛزٕ پرٛتھ اکِس خٲطرٕ اکھ اکھ وری یمو بہَو نفرو کنعانٕچ سرِ زمین دریافت کٔر۔ تہٕ بہٕ روزٕ تُہنٛد دشمن بٔنِتھ۔\f + \fr 14‏:34 \ft اعمال 13:18\f*
\v 35 یہ سپدِ پٔزؠ پٲٹھؠ تکیازِ بہٕ 'یہُوواہؔ' چُھس یہ ونان۔ بہٕ کرٕ یمہ کتھٕ تمہِ ونٛڈٕ کِس پرٛتھ اکِس نفرس سٟتؠ یمؠ مےٚ خلاف سٲزَش کٔر۔ تِم سٲری مرن یتؠ یمنےٕ بیابانن منٛز۔"
\p
\v 36‏-37 پتہٕ کۅر یہُوواہنؔ تِمن دہن نفرن پٮ۪ٹھ حملہٕ یمو لوٗکن ہنٛز حوصلہٕ شکنی کٔر تہٕ تِمہ مودؠ۔ یمہٕ ٲسؠ تمہٕ نفر یمو کنعان دریافت کۅرمُت اوس تہٕ پتہٕ ونُکھ لوٗکن زِ تِم ہیٚکن نہٕ تتھ زمینہِ پٮ۪ٹھ قبضہٕ کٔرِتھ۔ یمو نفرو سببہٕ لاجہ لوٗکو موسیٰؔ ہس خلاف کتھٕ کرنہِ۔
\v 38 یمو بہَو نفرو کنعان دریافت کۅر تِمو منٛزٕ رودؠ صرف یسوعؔ تہٕ کالبؔ زنٛدٕ۔
\v 39 ییٚلہ موسیٰؔ ہن اسرائیل کیٚن یہُوواہؔ سنٛزِ کتھِ ہنٛز خبر دِژ تہٕ تِمو منٛزٕ سپدؠ واریاہ لوٗکھ سیٹھاہ غمگین۔
\v 40 ییٚلہ لوٗکھ بیٚیہِ دوٚہہ صبحٲے نینٛدرِ ؤتھؠ تہٕ ہیٚوتُکھ کنعان کیٚن پہٲڑی علاقن کُن پکُن۔ تِمو ووٚن، "أسؠ چھِ زانان زِ اسہِ چھِ گناہ کٔرؠ مٕتؠ، مگر أسؠ چھِ وۅنؠ تتھ ملکس منٛز اژنہٕ خٲطرٕ تیار یُس یہُوواہنؔ اسہِ دِنُک وعدہ کۅرمُت چُھ۔
\v 41 مگر موسیٰؔ ہن ووٚن، "یہُوواہنؔ کۅرنو توٚہہ حکم واپس ریگستانن منٛز گژھنُک، تہٕ وۅنؠ کیازِ چُھو توٚہؠ تمؠ سنٛز نافرمٲنی کران؟ اتھ چھنہٕ کامیٲبی۔
\v 42 وۅنؠ مہٕ کٔریٚو اتھ زمینہِ کُن گژھنٕچ کوشش۔ اگر توٚہؠ کوشش کٔریٚو تہِ تہٕ تُہنٛدؠ دشمن دِنو توٚہہِ شِکس، تکیازِ یہُوواہؔ آسہ نہٕ توٚہہِ سٟتؠ۔
\v 43 ییٚلہ توٚہؠ عمالیقؔ تہٕ کنعانؔ کیٚن اولادن سٟتؠ ہر شروع کٔریٚو تہٕ تِم کرن توٚہہِ ذبح! یہُوواہؔ ژھنیٚو توٚہہ ترٲوتھےٕ، تکیازِ توٚہہِ تروُون سُہ۔"
\v 44 مگر امہِ باوجود تہِ دراو نہٕ موسیٰؔ خٟمہ گاہ منٛزٕ، تہٕ سُہ مقدس صندوق یتھ منٛز داہ احکام ٲسؠ آو نہٕ خٟمہٕ منٛزٕ ڈالنہٕ مگر توتہِ رودؠ لوٗکھ کنعانؔ کیٚن پہاڑی علاقن کُن پکان۔
\v 45 پتہٕ آے عمالیقؔ تہٕ کنعانیٚن ہنٛدؠ اولاد یمہٕ پہاڑین منٛز روزان ٲسؠ تہٕ کۅرُکھ اسرائیل ین پٮ۪ٹھ حملہٕ۔ تِمو کٔر تِمن جنوبی حُرمہَس تام لار۔
\c 15
\p
\v 1 پتہٕ ووٚن یہُوواہنؔ موسیٰؔ ہس،
\v 2 "اسرائیلی لوٗکن ون یہ زِ، ییٚلہِ توٚہؠ تتھ ملکس منٛز وٲتیٚو یُس بہٕ توٚہہِ دِمو،
\v 3 تہٕ توٚہؠ کٔرؠ زیٚو میانہ باپتھ خاص قربٲنیہِ پیش یمہٕ مےٚ پسنٛد ین ییٚلہ کاہن تِم قربان گاہَس پٮ۪ٹھ بُزن۔ امہِ منٛزٕ آسن کینٛہہ قربٲنی تِم یمہٕ پوٗرٕ پٲٹھؠ قربان گاہَس پٮ۪ٹھ بُزنہٕ ین تہٕ کینٛہہ آسن تِمو منٛزٕ یمہ یہ باس دِن زِ توٚہہ کۅرو مےٚ سٟتؠ مکمل عہد۔ یمو منٛزٕ آسن تِم تہِ کینٛہہ یم توٚہؠ پننہِ مرضی پٮ۪ٹھ پیش کٔریٚو۔ کینٛہہ آسن تِمہ تہٕ یمہٕ توٚہؠ کُنہ وۅرسس پٮ۪ٹھ پرٛتھ وریہ پیش کران چُھو۔ یمہٕ قربٲنیہ آسن تہُنٛزن گٲون ہنٛدؠ ؤژھؠ یا تیٖرن تہٕ ژھاولیٚن ہنٛدؠ ژَھو۔
\v 4 ییٚلہ توٚہؠ یمہ قربٲنیہ پیش کٔریٚو تہٕ توٚہہِ پیٚیو مےٚ نِش قریبن زٕ کلو اوٹ اکِس لیٹر زیتون تیٖلس سٟتؠ رلٲوِتھ تہِ انُن۔
\v 5 ییٚلہ توٚہؠ کانٛہہ کٹھ یا مونٛگُر قربٲنی باپتھ پیش کٔرؠ وون یُس پوٗرٕ پٲٹھؠ بُزنہٕ ییہِ یا ییٚلہ توٚہؠ پرٛتھ اکھ کٹہٕ برٕ قربٲنی باپتھ پیش کٔرؠ وون تہٕ اکھ لیٹر مےَ تہِ پییہ توٚہہِ قربٲنی باپتھ تیار کرُن۔
\v 6 ییٚلہ توٚہؠ قربٲنی باپتھ کٹھ پیش کٔرؠ وون، تہٕ توٚہہِ تقریبن ترییہِ پٮ۪ٹھٕ ژور، پانٛژھ سیر زٲویُل پیسمُت اوٹ تہِ قربٲنی خٲطرٕ انُن یتھ سٟتؠ اکہ لیٹرُک ژورِم حصہٕ زیتون تیٖل رلٲوِتھ آسہ۔
\v 7 تہٕ قربان گاہَس پٮ۪ٹھ ترٲوؠ زیٚو تقریٖبن کِلو پانٛژھ پاوٕ مےَ تہِ۔ ییٚلہ یِم بُزنہٕ یوان آسن تہٕ أمِچ خوشبو کرِ مےٚ سیٹھاہ مُعطر۔
\v 8 کُنہ ساعتہٕ کٔرؠ زیٚون توٚہؠ اکھ جوان ہکُھر تہِ قربان گاہس پٮ۪ٹھ بُزنہٕ باپتھ پیش۔ کُنہٕ ساعتہٕ کٔرؠ زیٚو توٚہؠ یہ باور کرنہٕ باپتھ تہِ قربٲنی پیش زِ توٚہہِ چُھ مےٚ سٟتؠ پۅختہٕ وعدہ کۅرمُت۔ کُنہِ ساعتہٕ کٔرؠ زیٚو توٚہؠ میانؠ ہمدردی بحال تھاونہٕ موٚکھٕ تہِ قربٲنی پیش۔
\v 9 ییٚلہ توٚہؠ یمہ قربٲنی پیش کران ٲسیٚو، توٚہؠ ٲسؠ زیٚو تقریبن ساڑھ شےٚ سیر زٲویُل اوٹ تہِ قربٲنی باپتھ پیش کران یتھ تقریٖبن زٕ لیٹر زیتون تیٖل رلٲوِتھ آسہ۔\f + \fr 15‏:9 \ft تقریٖبن 2 لیٹر زیتون تیٖل۔ تقریبن 3 کلو زٲویُل اوٹ۔ \f*
\v 10 تہٕ قربان گاہس ترٲوؠ زیٚو زٕ کوارٹ مےَ\f + \fr 15‏:10 \ft 2 لیٹر مےَ\f* تہِ نذرانہٕ رنٛگؠ۔ ییٚلہ یمہ خاص تحفہٕ بُزنہٕ آسن یوان تہٕ اتھ ینہٕ وول مُشِک آسہ مےٚ سیٹھہےٕ خوش کران۔
\v 11 ییٚلہِ تہِ کانٛہہ شخص دانٛد، ہونٛڈ، کٹھ یا ژھاوج قربٲنی باپتھ پیش کران آسہ تہٕ تمِس پزِ سُہ یتھےَ پٲٹھؠ کرُن۔
\v 12 پرٛتھ کانٛسہِ جانورس باپتھ یُس توٚہؠ مےٚ نِش قربٲنی باپتھ أنؠ وون چھےٚ یِمن ہِدایتن پٮ۪ٹھ عمل کرٕنؠ۔
\v 13 توٚہؠ سٲری لوٗکھ یمہٕ پوٗرٕ وانٛسہِ اسرائیلی رودؠ مٕتؠ چُھو ییٚلہ یژھٕ قربٲنی پیش کران ٲسیٚو ہیزیٚو یمن اصولن کٲم یمہٕ قربان گاہَس پٮ۪ٹھ بُزنہٕ وزِ مےٚ پسنٛد ین
\v 14 اگر کانٛہہ غٲر ملکی توٚہہِ نِش ییہِ یا توٚہہِ سٟتؠ روزان آسہ سُتہ یژھٕ قربٲنیہٕ انُن یژھان آسہ یمہٕ قربان گاہَس پٮ۪ٹھ بُزنہٕ وزِ مےٚ پسنٛد ین تہٕ تِمن تہِ پزِ ہدایِتن پٮ۪ٹھ عمل کرٕنؠ۔
\v 15 بہٕ چُھس زانان زِ یمہٕ پتہٕ وتہٕ اسرائیلی چھِ تہٕ یمہٕ غٲر ملکی چھِ برابر، اوٕ کِنؠ پزن یمن سارنی کُنی ہدایت اپناوِنؠ۔ چانیٚن سارنی اولادن تہِ پزِ یِمن سارنی ہدایِتن پٮ۪ٹھ عمل کران روزُن۔
\v 16 توٚہہ اسرائیل ین تہٕ توٚہہِ سٟتؠ روزن والیٚن یِمن غٲر ملکی ین سارنی چھِ کُنی ھدایت عملاوٕنؠ۔
\v 17 یہُوواہنؔ ووٚن موسیٰؔ ہس یتہِ،
\v 18 "یمہٕ ہِدایت ون اسرائیلی لوٗکن، ییٚلہ توٚہؠ تتھ زمینہِ پٮ۪ٹھ وٲتیٚو یوٚت بہٕ توٚہؠ نِوان چُھسو۔
\v 19 تہٕ سُہ پھسٕل کھیٚیو یُس تتہِ ۅپدان چُھ، توٚہہ پزِ تمہِ منٛزٕ ضروری میانہٕ مقدس نذرانہٕ باپتھ کینٛہہ الگ تھاوُن، تہٕ سُہ کریٚو مےٚ پیش۔
\v 20 پرٛتھ ورؠ یہ ٲسیٚو اناجہٕ منٛزٕ گۅڈٕ کینٛہہ الگ تھاوان یُس توٚہؠ لوننہٕ پتہٕ جمع کران چُھو۔ گۅڈٕ گژھِ ٲٹِس اکھ ژۅٹ بناوٕنؠ یُس توٚہؠ پیسان چُھو تہٕ سۅ گژھِ مےٚ برُونٛہہ کنہِ نذرانہٕ پیش کرٕنؠ۔
\v 21 پرٛتھ ورؠ یہ یُس توٚہہ تہٕ تُہنٛدیٚن اولاد پھسٕل لونُن آسان چُھ تتھ گژھِ گۅڈنِچ ژۅٹ بنٲوِتھ مےٚ پیش کرنہٕ یِنؠ۔
\v 22 کُنہ ساعتہٕ ہیٚکہ یتہِ بٔنِتھ زِ توٚہؠ اسرائیلی کٔریٚو نہٕ تِمن سارنی ہِدایتن پٮ۪ٹھ عمل یمہٕ مےٚ موسیٰؔ ہَس توٚہہِ وننہٕ خٲطرٕ دِتمٕتؠ چھِ، مگر امہِ نہٕ زِ توٚہؠ کٔریٚو تِمن ہنٛز نافرمٲنی۔
\v 23 سُتہ آسہ وقت زِ تُہنٛدیٚو اولادو منٛزٕ آسن کینٛہہ تمن سارنی ہِدایِتن پٮ۪ٹھ عمل یمہٕ مےٚ موسیٰؔ ہس توٚہہِ وننہٕ خٲطرٕ دِتمٕتؠ چھِ۔
\v 24 اگر توٚہؠ یا تِم یمن ہدایتن پٮ۪ٹھ عمل نہ کٔرِتھ گناہ گار سپدیٚو تہٕ کانٛسہِ اسرائیلی فردس باسہِ نہٕ زِ تِم چھِ یہ کران تیٚلہ چُھ سارنی لوٗکن ہدیہِ رنٛگؠ اکھ دانٛڈ کاہنس نش انُن۔ ییٚلہ یہ قربان گاہس پٮ۪ٹھ بُزنہٕ ییہِ تہٕ مےٚ سپدِ خوشی۔ تِم انن مےٚ نِش آٹِچ قربٲنی، مےَ تہٕ اکھ مونٛگُر یُس تہنٛدؠ کٔرمٕتؠ گناہ دور کرنہٕ خٲطرٕ قربان ییہِ کرنہ:
\v 25 یمہٕ قربٲنیہِ پیش کٔرِتھ کرِ کاہن توٚہہِ سارنی اسرائیلی لوٗکن ہُنٛد کفارٕ ادا۔ پتہٕ نیرِ مےٚ نِش یمہ قربٲنی قربان گاہس پٮ۪ٹھ زٲٲلِتھ پیش کرنُک نتیجہ یہ زِ توٚہہ ییہِ معاف کرنہٕ، تکیازِ توٚہہ سپُد یہ زاننہٕ بغٲر گناہ زِ توٚہؠ چُھو گناہ کران۔
\v 26 توٚہہِ اسرائیلی لوٗکن تہٕ توٚہہِ سٟتؠ روزن والیٚن پردیسی لوٗکن سارنی ییہِ معاف کرنہٕ۔
\v 27 اگر کانٛہہ شخص یہ زاننہٕ بغٲر گناہ کران چُھ زِ یہ چُھ گناہ تہٕ سُہ شخص انہِ نذرانہٕ باپتھ مےٚ نِش اکھ ژھاوٕج تاکہ تٔمس وسہِ تمہِ گُنہُک سزا نکھٕ۔
\v 28 کاہن کرِ تٔمس شخصہٕ سنٛدؠ گناہ دور کرنہٕ خٲطرٕ سۅ پیش تہٕ تمس شخصہٕ سنٛدؠ گناہ ین معاف کرنہٕ۔
\v 29 توٚہؠ اسرائیلی تہٕ توٚہہِ درمیان روزن والیٚن سارنےٕ پردیسؠ ین پزِ یمنےٕ ہِدایِتن پٮ۪ٹھ عمل کرٕنؠ۔
\v 30 مگر یمہٕ لِکھٕ زٲنِتھ مٲنِتھ میانی حکم عدولی کران چھِ، اسرائیلی تہٕ توٚہہِ درمیان روزن وٲلؠ پردیسی چھِ یہ کٔرتھ میانیٚن گُنہن ہنٛدؠ مُرتکب سپدان۔ لہٰذا گژھن تِم تُہنٛدیٚو کیمپو منٛزٕ نیٚبر کڈنہٕ یِنؠ۔
\v 31 تِمو کٔر میانیٚن حکمن حقارت تہٕ زٲنِتھ مٲنِتھ کٔرکھ تِمن ہنٛز نافرمٲنی، لہٰذا گژھِ تِمن پننٮ۪ن گُنہن ہُنٛد سزا میلُن یُتھ نہٕ تِمن دُبارٕ توٚہہِ درمیان روزنُک اجازت میلہِ۔"
\v 32 اکہِ دوٚہہ اسرائیلی بیابانن منٛز ٲسؠ۔ تمو منٛزٕ او اکھ نفر وُچھنہٕ یُس سبت دوٚہہ زیٚون جمع کران اوس۔
\v 33 یمو سُہ یہ کران وُچھ تِمو نیٚو سُہ ہارونسؔ، موسیٰؔ ہس تہٕ باقی اسرائیلی نفرن نِش۔
\v 34 تِمو نیٚو سُہ احتیاط سان حفاظتس منٛز، تکیازِ تِمن ٲس نہٕ پتاہ زِ سزا دنہٕ خٲطرٕ کیاہ پزِ کرُن۔
\v 35 پتہٕ ووٚن یہُوواہنؔ موسیٰؔ ہس، "یہ نفر گژھِ قتل کرنہٕ یُن۔ توٚہؠ سٲری مٲرؠ وُون سُہ کیمپس نیٚبرٕ کنہِ سنگسار کٔرِتھ۔"
\v 36 تہٕ تِمو ساروےٕ کوٚڈ سُہ کیمپس نیٚبر کُن تہٕ سنگسار کٔرِتھ مورُکھ سُہ نفر، یتھ کنؠ یہُوواہنؔ موسیٰؔ ہس تہِ کرنُک حکم کۅر۔
\v 37 یہُوواہنؔ ووٚن موسیٰؔ ہس یتہِ،
\v 38 "یہ کتھ وَن اسرائیلی لوٗکن: 'توٚہؠ تہٕ تُہنٛدؠ سٲری اولاد بنٲیو ییرٕ پنن ہنٛزٕ گوٚچھِ تہٕ پتہٕ ترٲیو تِمہ نیجن ڈوٗریٚن گنٛڈتھ پننٮ۪ن پلون دامنن الوٲنتؠ۔
\v 39 ییٚلہ توٚہؠ یمہ گونٛدؠ وُچھان ٲسؠ ووکھ تہٕ توٚہہِ آسنو تمہٕ سٲری ہِدایات یاد پیٚوان یمہٕ مےٚ توٚہہِ دِتمٕتؠ چھِ تہٕ توٚہؠ ٲسیٚو تِمن پٮ۪ٹھ عمل کران۔ یتھٕ پٲٹھؠ کٔریٚو نہٕ توٚہؠ مےٚ سٟتؠ بے وفٲیی۔ توٚہؠ ٲسیٚو نہٕ تمِس بے وفا گانہِ ہنٛدؠ پٲٹھؠ یۅسہ شرمناک کٲم کران چھےٚ، تہِ وُچھان چھےٚ تہٕ پتہٕ بیٚیہِ کرٕنؠ یژھان چھےٚ۔
\v 40 یمہٕ گونٛدؠ وُچِھنہٕ سٟتؠ آسہ توٚہہِ یاد تھاونس منٛز مدد میلان زِ توٚہہِ پزِ میانیٚن تمام احکامن پٮ۪ٹھ عمل کرٕنؠ تہٕ میانؠ مقدس لوٗکھ بنٕنؠ۔
\v 41 یمہٕ مٔشرایو زِ بہٕ یہُوواہؔ چُھس تُہنٛد خدا۔ بہٕ چُھس سُے یمؠ توٚہؠ مِصرٕ منٛزٕ کٔڈتھ أننو تاکہِ توٚہؠ بٔنیٚو میانؠ۔ بہٕ چُھس یہُوواہؔ، تُہنٛد خدا۔"
\c 16
\p
\v 1 اکہ دوٚہہ کٔر اضہارؔ سنٛدؠ نیٚچی قورحؔ ہن تہٕ لاوی سنٛدؠ زُرؠ قہاتنؔ الیابؔ سنٛدین نیٚچوٮ۪ن داتنؔ تہٕ ابیرامسؔ سٟتؠ سٲزِش، تہٕ بیٚیہِ اوسکھ پلتؔ سُنٛد نیٚچو اونؔ سٟتؠ۔ یمہ سٲری ٲسؠ روبن سنٛدِ قبیلٕکؠ۔
\v 2 یمو ژورو نفرو کٔرؠ بیٚیہِ 250 نفر یم اسرائیلی لوٗکن ہنٛدؠ رہبر ٲسؠ موسیٰؔ ہس خلاف بغاوت کرنس پٮ۪ٹھ آمادٕ۔
\v 3 تِم گے ہارونسؔ تہٕ موسیٰؔ ہس کٕٹھ کڈنہٕ باپتھ جمع۔ تِمو ووٚن تِمن، "توٚہؠ زٕ چُھو تمہِ کھۅتہٕ زیادٕ زٹِھل ہاوان ییتیاہ توٚہؠ چُھو! یہُوواہنؔ تھٲوؠ أسؠ سٲری اسرائیلی الگ تہٕ سُہ چُھ اسہِ سارنےٕ سٟتؠ۔ تہٕ توٚہؠ کیازِ چُھو تہِ کران زنتہٕ توٚہؠ باقی لوٗکو کھۅتہٕ زیادٕ اہم چُھو، یمہ یہُوواہؔ سنٛدؠ چھِ؟
\v 4 ییٚلہ موسیٰؔ ہن بوز زِ یمہ کیاہ چھِ ونان تہٕ سُہ گو زمینس پٮ۪ٹھ سر بسجود دۅکھس منٛز۔
\v 5 پتہٕ ووٚن تٔمؠ قورحؔ ہس تہٕ قورحؔ سنٛدین سٲتھین، "پگاہ صُبحٲے ہاوِ یہُوواہؔ اسہِ زِ تٔمؠ کُس چُھ پنُن کاہن ژورمُت، کُس چُھ پاک تہٕ کس چُھ تس برُونٛہہ کُن ینُک اجازت۔ یہُوواہؔ دییہِ صرف تِمن نفرن اجازت یمن سُہ پانس برُونٛہہ کُن ینُک اجازت دِوان چُھ۔
\v 6 ہے قورحؔ، پگاہ کٔرزِ ژٕ تہٕ ژےٚ یمہٕ باقی سٟتؠ چھی بخور زالنہٕ باپتھ پنٕنؠ بانہٕ تیار۔
\v 7 پتہٕ زٲلؠ زیٚو توٚہؠ تتھ منٛز نار تہٕ نارس منٛز یہُوواہؔ سنٛدِس خدمتس منٛز بخور۔ پتہٕ وُچھو أسؠ زِ اسہِ منٛزٕ کُس چُھ یہُوواہنؔ پنُن مقدس خٲدم بننہٕ خٲطرٕ ژورمُت۔ یہ چُھو توٚہی لاوی یو ہنٛدیٚو اولادو انٛدرٕ لوٗکھ یمہٕ زیادٕ اختیار استعمال کرنٕچ کوشش کران چھِ!
\v 8 پتہٕ کٔر موسیٰؔ ہن دبارٕ قورحؔ ہس سٟتؠ کتھَ۔ تٔمؠ ووٚن، "اے لاوی قبیلہٕ کیٚو لوٗکو، میانؠ کتھ بوزیٚو وۅنؠ!
\v 9 توٚہؠ چھون سُہ یہُوواہؔ زانان، یمؠ اسرائیل لٕکؠ خداین توٚہؠ لاوی ژٲرؠ نو اسرائیلی قبیلو منٛزٕ تاکہِ توٚہؠ کٔریٚو تمسنٛدِ باپتھ مقدس خٟمس منٛز کٲم تہٕ سرچٲووکھ لوٗکھ۔ کیاہ توٚہہِ چُھوا پننہِ خٲطرٕ یہ کرُن اکھ معمولی کتھ باسان؟
\v 10 یہُوواہنؔ اُنکھ ژٕ قورحؔ تہٕ لاوی نسلٕکؠ سٲتھی پانس قریب۔ وۅنؠ چُھو توٚہؠ کاہن بننٕکؠ تہِ مطالبہ کران؟
\v 11 یہ چُھ سیدِ سیٚود یہُوواہؔ یمِس خلاف ژٕ تہٕ چٲنؠ سٲتھی لاوین ہنٛدؠ اولاد بغاوت کران چھِ۔ ہارونؔ چُھنہٕ اکھ یمِس خلاف توٚہؠ پزی شکایت کران چُھو۔"
\p
\v 12 پتہٕ انیاے موسیٰؔ ہن داتنؔ تہٕ ابیرامؔ ناد دِتھ مگر تِمو مونُس نہٕ۔ تِمو سوزٕس شیٚچھ زِ أسؠ یمو نہٕ ژےٚ نِش۔
\v 13 ژےٚ أنِتھ أسؠ مِصرٕ منٛزٕ کٔڈتھ یُس سیٹھاہ زرخیز ملک اوس یُتھ أسؠ یتھ سحراوس منٛز مرَو۔ سُہ گو سیٹھاہ ناکارٕ۔ مگر وۅنؠ چُھکھ ژٕ کوشش کران اسہِ پٮ۪ٹھ حکمرانی کرنٕچ، یہ گو نہٕ جان۔
\v 14 ژےٚ دِژتھ نہٕ اسہِ روزنہٕ خٲطرٕ کانٛہہ نٔو جایاہ۔ یتہِ باقی زرخیز کھاہ تہٕ دچھِ باغ آسہٕ ہن۔ ژٕ چُھکھ صرف یمہٕ لوٗکھ أنؠ بناونٕچ کوشش کران۔ امہِ کِنؠ یمو نہٕ أسؠ ژیٚنِش۔"
\v 15 موسیٰؔ ہس کھۅت یہ بوزِتھ سخت شرارتھ۔ تٔمؠ مونٛگ دعا یہُوواہسؔ، "یُس اناج یمو نذرانہٕ اوٚن سُہ کٔرؠ زیٚو نہٕ قبوٗل۔ مےٚ روٚٹ نہٕ یمن نِش کِہین، معمولی اکھ خچُر تیٚنہٕ، تہٕ مےٚ ورتوو نہٕ زانٛہہ تہِ یمن سٟتؠ کُنہِ قسمُک غلط۔ لہٰذا گژھِنہٕ یمن مےٚ سٟتؠ شکایِتُک کانٛہہ بٲعث آسن۔"
\v 16 پتہٕ ووٚن موسیٰؔ ہن قورحؔ ہسِ "ژےٚ تہٕ ژےٚ سٟتؠ روزن والیٚن پزِ پگاہ یتُتھ یُن تہٕ یہُوواہسؔ برُۅنٛہہ کنہِ کھڑا سپدُن۔ ہارونؔ تہِ اسہِ یتی۔
\v 17 ژٕ تہٕ ژےٚ سٟتؠ یمہ تمام 250 نفر رٹن اکھ اکھ تٲو تہٕ تتھ منٛز زالن یہُوواہسؔ نذرانہٕ رنٛگؠ بخور۔ ہارون تہِ کرٕ یتھے پٲٹھؠ۔"
\v 18 چونکہ تِمو منٛزٕ ٲس پرٛتھ أکِس نفرس اتھِ بخور زالنہٕ باپتھ اکھ اکھ تٲو۔ تمو بوٚر تِمن منٛز نار تہٕ تروٕہس بخور یُتھ سُہ چمکہِ، تہٕ پتہٕ گے تِم سٲری ہارونسؔ تہٕ موسیٰؔ ہس سٟتؠ مقدس خٟمہ کِس دروازس پٮ۪ٹھ کھڑا۔
\v 19 پتہٕ أنؠ قورحؔ ہن تِم ساری یمہ تسنٛدؠ حٲمی تہٕ موسیٰؔ ہس مُخالف ٲسؠ ناد دٕتھ تہٕ تِمہ تہِ گے خٟمہ کِس دروازس نِش جمع۔ پتہٕ گو یہُوواہؔ سُنٛد جلال تِمن سارنی پٮ۪ٹھ طٲری۔
\v 20 یہُوواہنؔ ووٚن ہارونسؔ تہٕ موسیٰؔ ہس،
\v 21 "یمو ساروےٕ لوٗکو نشہٕ روزیٚو دور تاکہ یم کرکھ بہٕ یکدم نابود!"
\v 22 مگر ہاروننؔ تہٕ موسیٰؔ ہن ترُوو دۅکھس منٛز زمینس پٮ۪ٹھ سجدٕ۔ تِمو منٛج یہُوواہسؔ مِنت تہٕ ونُن، "خدایہ، ژےٕ چُھکھ یمؠ یِمن لوٗکن زُوو دیُت۔ یمو منٛزٕ کۅر أکؠ فردن خطا۔ کیاہ یہ چھا تُہنٛدِ خٲطرٕ جان زِ توٚہؠ گٔژھیٚو سارنی لوٗکن ناراض؟\f + \fr 16‏:22 \ft عبر: 12:9\f*
\v 23 یہُوواہنؔ ووٚن موسیٰؔ ہس،
\v 24 "ٹھیک چُھ، مگر سارنی لوٗکن ون زِ قورحؔ، داتنؔ تہٕ ابیرامؔ سنٛدین خٟمن نِش روزیٚو دور۔"
\v 25 پتہٕ وُتھ موسیٰؔ تھوٚد تہٕ گو داتنؔ تہٕ ابیرامؔ سنٛدِس خٟمس کُن۔ اسرائیلی زِٹھؠ دراے تس پتہٕ پتہٕ۔
\v 26 یمو گناہ گار نفرن ہنٛدیٚو خٟمو نشہٕ روزیٚو دور تہٕ یہنٛدس کُنہِ چیزس مہٕ لٲگیٚو اتھٕ۔ اگر توٚہؠ کنہٕ چیزس اتھٕ لٲگیٚو یہنٛدؠ گناہ ولنہٕ ینہٕ سببہٕ مٔریٚو توٚہؠ!"
\v 27 پتہٕ ژٔلؠ تمام لوٗکھ قورحؔ، داتنؔ تہٕ ابیرامؔ سنٛدیو خٟمو نشہٕ دور۔ داتن تہٕ ابیرامؔ دراو پنٕنؠ گرٕ واجِنؠ تہٕ لۅکٕٹؠ بٔڈؠ شُرؠ ہیٚتھ خٟمہٕ منٛزٕ نیٚبر تہٕ رودؠ پننٮ۪ن خٟمہٕ کیٚن دروازن پٮ۪ٹھ وۅدٕنؠ۔
\p
\v 28 پتہٕ ووٚن موسیٰؔ ہن، بہٕ اوسُس نہٕ سُہ یمؠ یمہٕ چیز کرنُک فٲصلہٕ نِمُت اوس یمہٕ مےٚ کٔرؠ۔ یہ اوس یہُوواہؔ یمؠ بہٕ ژٲرِتھ یہ کرنہٕ خٲطرٕ سوزُس۔ تہٕ وۅنؠ کرِ سُہ توٚہہ امیُک تصدیق۔
\v 29 اگر یمہٕ لوٗکھ سیٚدِ بُتھِ مودؠ تہٕ یہ گژھِ ثٲبت زِ بہٕ اوسُس نہٕ یہُوواہنؔ ژورمُت۔
\v 30 وۅنؠ اگر یہُوواہنؔ کینٛہہ تیٚوتھ کۅر ینہٕ پتھ کُن سپُدمُت اوس، اگر سُہ تِمن کھۅرٕ تلہٕ زمینَس چاہ کٔرِتھ تِمن نفرن تہٕ تِہنٛدؠ خاندان ہیٚتھ تہنٛدؠ تمام چیز نینٛگلاوِ تہٕ تتھ چہَس منٛز دفن گژھن، تہٕ پتہٕ سپدن تمہٕ، تُہنٛدؠ خاندان تہٕ تِہُنٛد تمام مال و اسباب تتھ زمینس منٛز زنٛدے غٲب تیٚلہ زٲنؠ زیٚو توٚہؠ زِ یمو لوٗکو چُھ یہُوواہؔ سُنٛد توہین کۅرمُت۔
\v 31 وُنہ اوس موسیٰؔ یہ ونٲنی، تہٕ یمن نفرن ژٔج کھۅرو تلہٕ زمین نیرتھ۔
\v 32 تمہِ نینٛگلٲوؠ تمہٕ ساری نفر تہنٛدؠ خاندان تہٕ تمہٕ ساری لوٗکھ یمہٕ قورحؔ ہس سٟتؠ کھڑا ٲسؠ تہٕ تِہُنٛد سورےٕ مال و اسباب ہیٚتھ۔
\v 33 تِمہ گے زنٛدٕ زُوے تتھ چہَس منٛز تہٕ ننہِ وانہٕ تِہُنٛد سورےٕ مال تہِ۔ تِم گے غٲب تہٕ زمین گییہِ بیٚیہِ برابر۔
\v 34 یُتھےٕ تِم پیی تِمو لاجہِ چیخہ کڈنہٕ تہٕ یمہٕ تتہِ کھڑا ٲسؠ تِمو بوزٕ تِمہ چیخہٕ۔ لوٗکھ کھوژؠ تہٕ لٔگؠ ژلان ژلان نالہٕ زٲری کرنہِ، "أسؠ چھنہٕ یژھان زِ یہ زمین گژھِ اسہِ تہِ نینٛگلٕنؠ!
\v 35 امہِ پتہٕ ووٚتھ یہُوواہؔ سنٛدِ طرفہٕ آسمانہٕ پٮ۪ٹھ اکھ نار یمؠ تمہٕ 250 نفر زٲلؠ یمہٕ بخور زالان ٲسؠ۔
\v 36 پتہٕ وُن یہُوواہنؔ موسیٰؔ ہس،
\v 37 "ہارون سنٛدِس نیٚچوِس الِیعزرؔس ون زِ سُہ تُلہ نارٕ منٛزٕ بخور دانہِ تہٕ نارٕ تیٚونٛگل ژھنہِ تٔتی چھکرِتھ۔ تمہٕ بانہٕ یمہ لوٗکن اتھِ ٲسؠ چھِ مقدس تکیازِ تمو اوس تِمن منٛز اوس میانہٕ مۅکھٕ بخور زالنہٕ آمُت۔
\v 38 تِم لوٗلھ مودؠ پننیٚو گُنہو سببہٕ۔ لہٰذا پزِ اِلیعزرسؔ یمہٕ بانہٕ تُلٕنؠ تہٕ دۅکرِ سٟتؠ دگٕنؠ یُتھ تِم تٔنؠ بنن۔ یتھ کنؠ پزِ تس امہِ دھاتہٕ سٟتؠ قربان گاہ باپتھ اکھ غلاف بناوِنؠ۔ تمہِ بانہٕ آے مےٚ بخور زالنہٕ باپتھ استعمال کرنہٕ، اوٕ کِنؠ چھِ تِم مقدس۔ تِمن بانن سٟتؠ کیاہ سپُد روزن اسرائیلی لوٗکن ژینہٕ ون دِوان۔
\p
\v 39‏-40 کاہن الِیعزرؔن کٔرؠ 250 بانہٕ جمع یمہٕ نارس منٛز مرن وٲلؠ نفر استعمال کران ٲسؠ۔ تمؠ بنٲوؠ یمہٕ بانہٕ واریاہ تٔنؠ تہٕ کۅرُن قربان گاہ باپتھ وۅلُت تیار، یتھ کٔنؠ زن یہُوواہنؔ موسیٰؔ ہس ونمُت اوس۔ تِمو کٔرؠ اسرائیلی خبردار زِ صرف چُھ ہارون سنٛدین اولادنےٕ یوت یہُوواہسؔ باپتھ بخور زالنُک اجازت۔ اگر بدل کانٛہہ تہِ کرِ تہٕ تٔمس سٟتؠ سپدِ تی یہ قورحؔ ہس تہٕ تمسنٛدین سٲتھیٚن سٟتؠ سپُد۔
\v 41 مگر بیٚکہ دوٚہہ صبحٲے لٲج اسرائیل کیٚو لوٗکو ہارونسؔ تہٕ موسیٰؔ ہس خلاف شکایت شروع کرٕنؠ، ونُکھ توٚہہِ مٲرؠ ووکھ واریاہ لوٗکھ یمہٕ یہُوواہؔ سنٛدؠ ٲسؠ۔
\p
\v 42 ییٚلہ سٲری لوٗکھ ہارونسؔ تہٕ موسیٰؔ سنٛدِس کٔرمتِس پٮ۪ٹھ احتجاج کرنہٕ خٲطرٕ جمع گے تِمو ترٲو مقدس خٟمس کُن نظر تہٕ وچُھکھ زِ سُہ اوس مقدس ابرن ولمُت تہٕ یہُوواہؔ سُنٛد جلال اوس نوٚن سپُدمُت۔
\v 43 ہارونؔ تہٕ موسیٰؔ گے تہٕ رودؠ مقدس خٟمس برُونٛہہ کنہِ کھڑا۔
\v 44 پتہٕ ووٚن یہُوواہنؔ موسیٰؔ ہس،
\v 45 "یمو لوٗکو نشہٕ روزیٚو دوٗر تاکہ بہٕ انو توٚہؠ دوٚنوے یمن نِش زخمی گژھنہٕ بغٲر جلدےٕ بچٲوتھ۔ "مگر ہاروننؔ تہٕ موسیٰؔ ہن ترُوو پتھرِس پٮ۪ٹھ سجدٕ تہٕ پرٕکھ نماز۔
\p
\v 46 موسیٰؔ ہن ووٚن ہارونس، "جلدےٕ ان بیاکھ اکھ تٲو تہٕ تتھ منٛز تراو قربان گاہ پٮ۪ٹھٕ أنِتھ کینٛہہ تیٚونٛگل۔ تاوِ منٛز تراو بخور تہٕ لوٗکن ہنٛدیٚن گُنہن ہُنٛد کفارٕ دنہٕ باتھ نہِ سۅ لوٗکن منٛز۔ یہُوواہؔ چُھ تِمن سیٹھاہ ناراض، تہٕ بہٕ چُھس زانان زِ یمن منٛز گو اکھ خطرناکھ وباہ ظٲہر۔
\v 47 لہٰذا کۅر ہارونن تی یہ موسیٰؔ ہن تمِس ووٚن۔ تٔمؠ اوٚن دزٕوُن بخور تہٕ پھرٕوُن لوٗکو منٛزؠ۔ لوٗکن منٛز ٲس طوونہٕ بٮ۪مٲرؠ پھٲلیمٕژ، مگر ہارون رود لوٗکن ہنٛدیٚن گُنہن ہُند کفارٕ دنہٕ مۅکھٕ بخور زالان۔
\v 48 سُہ گو تِمن لوٗکن منٛزباگ کھڑا یمہ گۅڈے گذریمٕتؠ ٲسؠ تہٕ یمن منٛز وُنہِ کینٛہہ زنٛدے ٲسؠ۔ تہٕ پتہٕ رُکیٚو وباہ۔
\v 49 مگر قورحؔ ہس سٟتؠ مرن والیٚو علاوٕ ٲسؠ امہِ وباہ سٟتؠ گۅڈے ژوٗداہ ساس ستتھ ہتھ لوٗکھ گُذریمتؠ۔\f + \fr 16‏:49 \ft 1 کورنتھ: 10:10\f*
\v 50 وباہ ختم گٔژھتھ آے ہارونؔ تہٕ موسیٰؔ مقدس خٟمہ کِس دروازس پٮ۪ٹھ بیٚیہِ واپس۔
\c 17
\p
\v 1 پتہٕ ووٚن یہُوواہنؔ موسیٰؔ ہس،
\v 2 اسرائیل کیٚن لوٗکن ون زِ تمہٕ انن توٚہہِ نِش باہ لورِ۔ تِم انن بہَو قبیلو ہنٛدیٚو سردارو منٛزٕ أکِس أکِس۔ توٚہہِ چُھ پرٛتھ اکِس زِٹھؠ سُنٛد ناو تمؠ سنٛزِ لورِ پٮ۪ٹھ کھنناوُن۔
\v 3 پرٛتھ قبیلہٕ کِس زٹِھؠ سنٛدِ خٲطرٕ گژھِ اکھ الگ لور آسٕنؠ، امہِ کِنؠ پزِ توٚہہِ لاوی قبیلچہِ لورِ پٮ۪ٹھ ہارون سُنٛد ناو کھنناوُن۔
\v 4 تمہٕ آسہٕ تھٲوؠ زیٚو مقدس خٟمس منٛز تتھ مقدس صنٛدوقس نِش یتھ منٛز تِمہ مشقہٕ چھےٚ یمن پٮ۪ٹھ داہ احکام لیکِھتھ چھِ۔ یہ چھےٚ سۅ جاے یتِتھ بہٕ ہمیشہٕ توٚہہِ سٟتؠ کتھ کران چُھس
\v 5 تہٕ یُس نفر مےٚ کاہن بننہٕ خٲطرٕ ژورمُت آسہ تمؠ سنٛزِ لورِ پھُٹہِ بامُن۔ ییٚلہِ لوٗکھ یہ وُچَھن تہٕ تمہٕ تراون توٚہہِ متعلق شکایت کرٕنؠ، تکیازِ تِم سمجھن پانے زِ یوٚہے چُھ سُہ یُس مےٚ ژورمُت چُھ۔
\v 6 لہٰذا ووٚن موسیٰؔ ہن لوٗکن یہ یہُوواہنؔ وۅنُس۔ پتہٕ انہِ ہارونسؔ سان بہَو اسرائیلی زِٹھیٚو پن پننہِ لورِ موسیٰؔ ہس نِشہ۔
\v 7 موسیٰؔ ہن تھاوِ تمہ لورِ مقدس خٟمس منٛز مقدس صنٛدوقس برُنٛہہ کنہِ۔
\v 8 دویمہِ دوٚہہ صبحٲے ییٚلہ سُہ مقدس خٟمس منٛز ژاو اتہِ وچُھن ہارون سنٛزِ لورِ یۅسہ لاوی قبیلٕچ نمایندگی کران ٲس پھۅجممژ۔ اتھ اوس پن تہِ درامُت تہٕ پوش تہِ پھۅلمٕتؠ، تہٕ اتھ ٲسؠ پۅختہٕ بادام تہِ درامٕتؠ!
\v 9 موسیٰؔ ہن کجہِ سارے لورِ مقدس خٟمہ منٛزٕ نیٚبر تہٕ ہاویٚن لوٗکن۔ بہَو سردارو منٛزٕ نیٚیہ پرٛتھ أکؠ پن پنٕنؠ لور واپس۔
\v 10 پتہٕ ووٚن یہُوواہنؔ موسیٰؔ ہس، "ہارون سنٛز لور تھاوُن مقدس صنٛدوقس برُونٛہہ کنہِ تہٕ یہ گژھِ ہمیشہ خٲطرٕ تٔتی روزٕنؠ۔ یہ روزِ تِمن لوٗکن خٲطرٕ اکھ نصیحت یِم مےٚ خلاف بغاوت کرٕنؠ چھِ یژھان۔ پتہٕ مرِنہٕ بیٚیہِ کانٛہہ مےٚ خلاف شکایت کرنٕکہ سببہٕ۔\f + \fr 17‏:10 \ft عبر: 9:4\f*
\v 11 لہٰذا کۅر موسیٰؔ ہن تی یہ یہُوواہنؔ حکم دِتُس۔
\v 12 پتہٕ ووٚن اسرائیلی لوٗکو موسیٰؔ ہس، "أسؠ چھِ مرن وٲلؠ۔ أسؠ سٲری چھِ یقینن مرن وٲلؠ!
\v 13 یُس تہِ کانٛہہ یہُوواہؔ سنٛدِس خٟمس نزدیک گژھان چُھ سُہ چُھ مران۔ کیاہ اسہِ منٛزٕ چھا باقی تہِ مرن وٲلؠ؟"
\c 18
\p
\v 1 خداوندن ووٚن ہارونسؔ، "ژےٚ، چٲنِس نیٚچوِس تہٕ چٲنِس مٲلؠ سنٛدِ خاندان کیٚن باقی افرادن ییہِ سزا دِنہٕ اگر مقدس خٟمس انٛدر موجود چیزن سٟتؠ کینٛہہ بُرٕ سپُد۔ ژےٚ تہٕ چانیٚن اولادن ییہِ سزا دِنہٕ اگر کانٛہہ کاہن کینٛہہ غلط کرِ۔\f + \fr 18‏:1 \ft باقےٕ لاوی\f*
\v 2 چانہِ قبیلٕکؠ لوٗکھ مطلب یمہٕ لاوی قبیلس سٟتؠ تعلق تھاوان چھِ کرن ژےٚ تہٕ چانیٚن شُریٚن مدد ییٚلہِ تِم مقدس خٟمس منٛز پنٕنؠ کٲم کران آسن۔
\v 3 مگر ییٚلہ تِم یہ کام کران آسن، تمن پزِ نہٕ خٟمس انٛدر موجود یا قربان گاہَس نکھٕ مقدس چیزن نزدیک گژھُن۔ اگر تمہٕ یہ کرن تِمہ مرن تہٕ ژٕتہِ مرکھ!
\v 4 تمہ ہیٚکن مقدس خٟمچہ رٲچھ راوچہ ہنٛزن تمام کامیٚن منٛز ژےٚ مدد کٔرتھ مگر تتھ جایہ نزدیک آسہ نہٕ کانٛسہ ینُک اجازت یتھ جایہ ژٕ کام کران چُھکھ۔
\v 5 ژٕ چُھکھ سُہ یُس مقدس خٟمس اندر تہٕ قربان گاہس پٮ۪ٹھ کٲم کرِ۔ اگر ژٕ یمن ہدایِتن پٮ۪ٹھ عمل کرکھ، بہٕ کرنہٕ تیٚلہ دبارٕ اسرائیلی قومس پٮ۪ٹھ شرارتھ۔
\v 6 مےٚ ژٲرؠ پانے لاوی قبیلٕکؠ باقی اسرائیلی لوٗکو منٛزٕ تاکہ تِم بنن چٲنؠ خاص مدد گار۔ تِم چھِ اکہ قسمٕکؠ تحفہ یمہ مےٚ ژےٚ مقدس خٟمس منٛز کٲم کرنہٕ خٲطرٕ دِتی۔\f + \fr 18‏:6 \ft عبر: 9:6\f*
\v 7 مگر یہ چُھکھ ژٕ تہٕ چٲنؠ اولاد، یِم کاہن چھِ، دِن تمام تمہٕ تفصیلہ انجام یہُنٛد قربان گاہس متعلق مےٚ حکم دیُتمُت چُھ تہٕ یہ کینٛژھا مقدس جایہ اندر سپدان چُھ۔ بہٕ چُھسے ژےٚ بحثیتِ کاہن خدمت کرنٕچ یہ کام مٹہِ تھاوان۔ لہٰذا اگر بیٚیہِ کانٛہہ یہ کٲم کرنٕچ کوشش کرِ، سُہ گژھِ قتل کرنہٕ یُن۔
\v 8 یہُوواہنؔ ووٚن ہارونسؔ یتہِ زِ مےٚ کوٚرمکھ ژٕ تِمن تمام مقدس نذرانن ہنٛز رٲچھ راوٹ کرنہٕ باپتھ مقرر یمہٕ اسرائیلی لوٗکھ میانہِ باپتھ انان چھِ۔ مےٚ دِتی یمہ سری مقدس نذرانہٕ ژےٚ تہٕ چانیٚن نیٚچوٮ۪ن۔ ژےٚ تہٕ چانیٚن وٲرثن روزٕ یمن قربٲنیٚن ہُنٛد حصہٕ لگاتار میلان۔\f + \fr 18‏:8 \ft 1 کورنتھ: 9:13\f*
\v 9 قربٲنؠ ین ہُنٛد سُہ حصہٕ یُس نہٕ قربان گاہس پٮ۪ٹہ پوٗرٕ پٲٹھؠ دزان چُھ، چُھ چون۔ مقدس قربٲنؠ ین ہُنٛد سُہ حصہ، یتھ منٛز آٹچہِ قربٲنی سان، گُنہن ہُنٛد کفارٕ ادا کرنٕچ تہٕ گُنہن ہنٛدؠ خطا معاف کرنٕچ قربٲنی آسہ چُھس بہٕ الگ تھاونُک تقاضہٕ کران۔ بہٕ چُھس یژھان زِ سُہ گژھِ ژےٚ تہٕ چانیٚن نیٚچوٮ۪ن دنہٕ یُن۔
\v 10 توٚہؠ کھیٚزیٚو یہ مقدس ترین قربٲنی زٲنِتھ۔ تُہنٛدِ قبیلُک پرٛتھ کانٛہہ نفر ہیٚکہ یہ کھیٚتھ۔ مگر توٚہہِ چُھ یمن قربٲنیٚن ہُنٛد احترام کرُن تکیازِ یمہٕ چھےٚ تُہنٛدِ باپتھ مقدس۔
\v 11 کاہن آسن قربان گاہس برُونٛہہ کنہِ کھڑا سپدِتھ مقدس قربٲنیہ تھوٚد تلان۔ تمہ تمام قربٲنیہ یمہ اسرائیلی لوٗکھ مےٚ پیش کران چھِ تمہ سارے چھےٚ چانہِ تہٕ چانیٚن گۅبرن تہٕ کوریٚن ہنٛزٕ۔ تمہ روزن ہمیشہ چانہِ حصچہٕ۔ چانہٕ خاندانٕکؠ سٲری فرد یمو میانؠ قبولیت حٲصل کرنہٕ باپتھ عبادت کٔر تمن چُھ یمو نذرانو منٛزٕ کھیٚنُک اجازت۔
\v 12 بہٕ چُھسے ژےٚ گۅڈنیُک کھیٚن دِوان یُس لوٗکھ پرٛتھ ورؠ یہ لونِتھ مےٚ نِش انان چھِ سُہ گو زیتونُک بہترین تیٖل، نوو شراب تہٕ اناج۔
\v 13 گۅدنُک فصل یُس لوٗکھ لونِتھ مےٚ نِش واتناوان چھِ سُہ گو سورےٕ چون۔ چانہِ خاندانہٕ منٛزٕ یمؠ تہِ میانہ باپتھ قٲبلِ قبول رسٕم ادا کٔر تمِس چُھ اجازت سُہ کھیٚن کھیٚنُک۔
\v 14 اسرائیلس منٛز یہ کینٛژھا تہِ میانہِ ناوٕ وقف چُھ سُہ چُھ چون۔
\v 15 یمہ تہِ جانورن یا انسانن ہنٛدؠ گۅڈنِکؠ نر بچہ یمہ مےٚ پیش کرنہٕ ین، آسن تُہنٛدؠ۔ مگر لوٗکن پزن پنٕنؠ زِٹھؠ نیٚچوؠ تہٕ زِٹھؠ چاروٲے یمہ نہٕ قربان سپدن واپس مٔلؠ ہیٚنؠ۔
\v 16 تِمن پزن تِمہ تمہ وزِ ہیٚنؠ ییٚلہ تِم وٲرشِنؠ آسن۔ یُس قٟمت تِم دِن سُہ گژھِ پرٛتھ کِس چانٛدِ ہنٛدؠ پانٛژھ سکہٕ \f + \fr 18‏:16 \ft جیرہ اوس وزنُک ساروے کھۅتہٕ لۅکُٹ یونٹ، یُس 0:6 گرام چاندِ کھۅتہٕ کم اوس۔\f*آسُن۔ چٲنٛدؠ گژھِ تتھ تریٚکرِ منٛز تولنہٕ ینؠ یمہٕ مقدس خٟمس منٛز چھےٚ۔
\p
\v 17 بہٕ دمہٕ نہ توٚہہِ اجازت زِ توٚہؠ ہیُوٗ گۅڈٕ زامژٕ گٲو، تیر یا ژھاوٕلؠ واپس۔ تِم چھِ مقدس، بہٕ چُھس یژھان زِ توٚہؠ تھٲیِووکھ تِم میانہِ خٲطرٕ الگ۔ تِم ذبح کٔرتھ چھکیٚو تِہُنٛد خوٗن قربان گاہس۔ یتہٕ زٲلیٚو تِمن جانورن ہنٛز چربی پورٕ پٲٹھؠ قربان گاہس پٮ۪ٹھ یُتھ میانہِ خٲطرٕ قربٲنی سپدِ۔ تہنٛدِ دزنٕچ مُشِک آسہ میانہٕ خٲطرٕ سیٹھاہ خۅشونؠ۔
\v 18 یمن قربٲنین ہُنٛد ماز گو تُہنٛد۔ یتھٕ پٲٹھؠ جانورن ہنٛدؠ سیٖنہٕ تہٕ دٔچُھن بوو مےٚ سٟتؠ وفادٲری ہاونہٕ مۅکھٕ مےٚ پیش کرنہٕ یوان چھِ یتھٕ پٲٹھؠ کاہن قربان گاہس نِش تمہٕ تھوٚد تُلان چھِ۔
\v 19 یہ کینٛژھا تہِ اسرائیلی لوٗکھ مقدس تحفہٕ رنٛگؠ مےٚ پیش کران چھِ تہِ چُھسو بہٕ توٚہہِ دِوان۔ سُہ چُھ توٚہہِ تہٕ تُہنٛدین گۅبرن تہٕ کورٮ۪ن کھیٚنہٕ باپتھ۔ سُہ روزٕ ہمیشہٕ باپتھ تُہنٛد حصہٕ۔ یہ چُھ اکھ مہادٕ یُس بہٕ توٚہہِ سٟتؠ کران چُھس، سُہ مہادٕ یُس ہمیشہٕ باپتھ روزِ۔ بہٕ چُھس یہ مہادٕ تُہنٛدیٚن اولادن سٟتؠ تہِ کران۔
\v 20 یہُوواہنؔ ووٚن ہارونس یتہِ، "توٚہہِ کاہنن میلیٚو نہٕ زمین یا جادادٕ منٛزٕ کِہین یتھ پٲٹھؠ زنہٕ باقی اسرائیل ین میلہِ۔ سُہ چُھس بہٕ یُس توٚہہِ میلہِ۔
\v 21 ییٚلہ اسرائیل لٕکؠ لوٗکھ تمام فصلن تہٕ نوزٲید جانورن ہُنٛد دٔہم حصہ مےٚ نِش انن بہٕ دِمو سُہ توٚہہِ لاوی قبیلہٕ کیٚن۔ یہ آسہ تُہنٛزِ تتھ کامہِ ماوضہ یۅسہ توٚہؠ مقدس خٟمس منٛز کران چُھو۔\f + \fr 18‏:21 \ft عبر: 7:5\f*
\v 22 کاہنو ورٲے باقی اسرائیل ین پزِ نہٕ اتھ خٟمس نزدیک گژُھن۔ اگر تمہٕ اتھ نزدیک گے تہٕ بہٕ زانہٕ تہنٛز سۅ کٲم گناہ تہٕ اتھ گُنہَس پٮ۪ٹھ مرن تِمہ۔
\v 23 صرف چُھ لاوی زُرؠ یٲژےٕ یوت مقدس خٟمس منٛز کٲم کرنُک اجازت تہٕ تِمن ییہِ سزا دِنہٕ اگر تِمو اتھ سٟتؠ کینٛہہ غلط کۅر۔ یہ چُھ سُہ اکھ قانون یُس نہٕ زانٛہہ بدلاونہٕ ییہِ۔ توٚہہ لاوین ہنٛدیٚن زُرین میلہ نہٕ باقی تمام اسرائیل یو منٛزٕ کانٛہہ زمین۔
\v 24 اسرائیلی لوکھ کرن پننہِ سارے فصلُک تہٕ چارواین ہُنٛد دہم حصہ مےٚ نذرانہٕ رنٛگؠ پیش تہٕ سُہ دمہٕ بہٕ لاوین ہنٛدین وٲرثن تاکہِ تِمہ کرن سُہ پننہِ باپتھ استعمال۔ اوٕ کِنؠ ووٚن مےٚ زِ تِمن زِ لاوین ہنٛدین اولادن ترِنہٕ کانٛہہ زمین۔
\v 25 یہُوواہنؔ ووٚن موسیٰؔ ہس،
\v 26 "لاوین ہنٛدۍن زُرین ون زِ ییٚلہ توٚہؠ اسرائیلی لوٗکن نِش تمام فصلُک تہٕ جانورن ہُنٛد دٔہم حصہ وصول کٔریٚو تہٕ توٚہہ پیٚیو تمیُک دہم حصہٕ مےٚ مقدس نذرانہٕ رنٛگؠ پیش کرُن،
\v 27 یتھ پٲٹھؠ باقی اسرائیلی ۅپدایِمتہِ اناجُک تہٕ شرابُک دہِم حصہ پیش کران چھِ۔
\v 28 یہ کینٛژھا توٚہہِ اسرائیلی لوٗکو نِشہ میلان چُھ تمیُک دہم حصہٕ کٔرؠ زیٚو توٚہؠ مےٚ پیش۔ یہ آسہ تُہنٛد میانہِ باپتھ مقدس نذرانہٕ۔ یُس توٚہہ ہارونس حوالہٕ کرن چُھ۔
\v 29 یمہ چیز توٚہہِ دنہٕ ین تمو منٛزٕ ژٲریٚو توٚہؠ میانہِ باپتھ بہترین حصہ۔
\p
\v 30 تہٕ لاوین ہنٛدین زُرین ؤنیٚو یتہِ زِ ییٚلہ توٚہؠ اناجٕکؠ تہٕ شرابٕکؠ بہترین حصہٕ نذرانہٕ رنٛگؠ مےٚ پیش کٔریٚو، بہٕ زانہٕ زِ زنتہٕ یمہٕ تحفہ توٚہہِ پننہِ اناجہ تہٕ شرابہٕ منٛزٕ أنمٕتؠ چھِ۔
\v 31 توٚہہِ لاوین ہنٛدین زُرین تہٕ گرانن چُھ امیُک باقی حصہ کھیٚنُک اجازت تہٕ توٚہہِ یتِتھ خوش گژھِ تتِتھ ہکیٚو یہ کھیٚتھ تکیازِ یہ چُھ تُہنزِ تمہِ کامہِ ہُنٛد ماوضہٕ یۅسہ توٚہؠ مقدس خٟمس منٛز کران چُھ۔\f + \fr 18‏:31 \ft متی: 10:10، 1 کورنتھ: 9:13\f*
\v 32 اگر توٚہؠ کاہنن امیُک بہترین حصہٕ پیش کٔریٚو یُس توٚہہِ میلان چُھ تہٕ توٚہہِ ییہِ نہٕ یمن تحفن ہُنٛد دہم حصہٕ قبول کرنس پٮ۪ٹھ کانٛہہ تہِ سزا دِنہٕ یُس لوٗکھ مےٚ نِش انان چھِ۔ مگر توٚہہِ چھِ یمہٕ تحفہ مقدس زانٕنؠ۔ اگر توٚہؠ یمہ چیز کھیٚتھ تِمن ضٲبطن خلاف ورزی کٔرِتھ گناہ کٔریٚو یمہٕ مےٚ توٚہہِ دِتمٕتؠ چھِ، توٚہہِ ییہِ سزاے موت دِنہٕ۔"
\c 19
\p
\v 1 امہِ پتہٕ ووٚن یہُوواہنؔ ہارونسؔ تہٕ موسیٰؔ ہس،
\v 2 وۅنؠ چُھسو بہٕ توٚہہِ بیٚیہِ اکھ حکم دِوان۔ اسرائیلی لوٗکن ؤنیٚو زِ تِم انن تۅٚہہ نش گُرٕ رنٛگچ گاو یۅسہٕ نۅقصہٕ ورٲے آسہ۔ یہ گژھِ نہٕ آسٕنؠ زانٛہہ وانہِ لاگنہٕ آمٕژ
\v 3 یہ کٔرؠ وون کاہن الِیعزرؔس حوالہٕ۔ سُہ نیٚیہ أمِس کیمپس نیٚبر کُن تہٕ کرناویس کانٛسہِ اتھِ زبح۔
\v 4 تہٕ الِیعزرؔ بُڈٕناوِ اتھ خوٗنس منٛز پنٕنؠ اونٛگڈ تہٕ کرٕ امہِ سٟتؠ ستہِ لٹہ مقدس خٟمس نِش پتھرِس چِھرکاو۔
\v 5 پتہٕ روزِ الِیعزرؔ وچھان، گاو گژھِ مکمل پٲٹھؠ بُزنہٕ ینؠ، تمسُنٛد چمبرٕ، ماز، باقی خوٗن، تہٕ تمسُنٛد گُہہ تام۔
\v 6 پتہٕ تُلہ الِیعزرؔ دیودارٕچ اکھ لور، زوفا ناوچہ لکٕرِ ہُنٛد اکھ ڈنڈٕ تہٕ ۅزلہِ رنگُک کینٛہہ ییر تہٕ تراوِ تتھ نارس منٛز یتھ منٛز گاو بُزنہٕ آیہ۔\f + \fr 19‏:6 \ft عبر: 9:19\f*
\p
\v 7 پتہٕ چھِ کاہنس ضروری پنٕنؠ پلو چھلٕنؠ تہٕ سران کرُن۔ یہ کرنہٕ پتہٕ ہیٚکہ سُہ کیمپس منٛز واپس یِتھ۔ مگر امہ دوٚہہ شامس تام آسہ نہٕ سُہ کانٛہہ تہِ مقدس کٲم کرُن لایکھ۔
\v 8 گاو بُزن وول تہِ چھلہِ پنٕنؠ پلو تہٕ بیٚیہِ کرِ غسُل تہٕ سُتہ آسہ شام تام میانہِ خٲطرٕ ناقٲبلِ قبول۔
\v 9 پتہٕ یُس شخص میانہِ باپتھ ناقٲبلِ قبول آسہ نہٕ سُہ سومبراوِ گٲو ہُنٛد سوٗر تہٕ تھاوِ خٟمس نیٚبرٕ کنہِ کُنہ مقدس جایہ جمع۔ یہ سوٗر گژھِ ضروری تتھ جایہ روزُن یُتھ زن اسرائیل لٕکؠ لوٗکھ تتھ استعمال کرن ییٚلہ تِم پنٕنؠ گناہ دور کرنٕچ رسٕم انجام دنہٕ باپتھ سُہ آبس سٟتؠ رلاوِتھ چیٚن۔\f + \fr 19‏:9 \ft عبر: 9:13\f*
\v 10 یُس نفر گٲو ہُنٛد سوٗر جمع کرِ تس تہِ پزن پنٕنؠ پلو چھلٕنؠ تہٕ روزِ نہٕ امہِ دوٚہہ شام تام کانٛہہ مقدس کٲم کرنس قٲبل۔ یہ چُھ اکھ سُہ ضٲبط یُس نہٕ زانٛہہ تہِ بدلاونہٕ ییہِ۔ توٚہہِ سارنی اسرائیل ین تہٕ توٚہہِ سٟتؠ روزن والیٚن غٲر ملکی ین چھےٚ امِچ عبادت کرنؠ۔
\p
\v 11 تِم سٲری یم کانٛسہِ میتس اتھٕ لاگن روزن ستن دوٚہُن میانہِ باپتھ نا قٲبلِ قبول۔
\v 12 کُنہ لاشہ اتھٕ لاگنہٕ پتہٕ تریٚیہ دوٚہؠ تہٕ ستمہِ دوٚہؠ پتہٕ میانؠ قبولیت پراونہٕ باپتھ چُھ گۅڈٕ تِمن امہِ آبہٕ سٟتؠ پانس چھرکاو کرن تاکہ تِہنٛدؠ گناہ ین چھلنہٕ۔ اگر تِم یمن دونونؠ دوٚہُن یہ کرن نہٕ تیٚلہ روزن تِم میانہِ خٲطرٕ ناقٲبلِ قبول۔
\v 13 تِم سٲری لوٗکھ یمہ کُنہ لاشہ اتھٕ لاگن تہٕ دبارٕ مےٚ قٲبلِ قبول بننہٕ خٲطرٕ یہ رسٕم بہتر پٲٹھؠ انجام دِن تِم چھِ یہُوواہؔ سُنٛد مقدس خٟمہ ناپاک کران۔ تِمن آسہ نہٕ اسرائیلی لوٗکن سٟتؠ روزنُک اجازت۔ تِمن پٮ۪ٹھ آسہ نہ گناہ چھلنہٕ باپتھ آبُک چِھرکاو کرنہٕ آمُت، اوٕ کِنؠ آسن تِم میانہِ باپتھ نا قٲبلِ قبول۔
\v 14 بیٚیہِ تہِ چھےٚ اکھ عمل یۅسہ خٟمس منٛز کانٛسہِ ہنٛدس مرنس پٮ۪ٹھ انجام دِنؠ ضروری چھےٚ۔ تمہ تمام لوٗکھ یمہ خٟمس منٛز آسن ییٚلہ سُہ شخص مرِ یا کانٛہہ خٟمس انٛدر اژِ تمہٕ سپدن مےٚ ستن دوٚہُن خٲطرٕ ناقٲبلِ قبوٗل۔
\v 15 تتھ خٟمس منٛز اگر کانٛہہ بانہٕ ٹھانہٕ وُتھےٕ آسہ سُہ استعمال کرنُک چُھنہٕ اجازت۔
\v 16 اگر کانٛہہ شخص کھہَس پٮ۪ٹھ آسہ تہٕ تتہِ کانٛسہِ ہنٛزٕ لاشہ اتھٕ لاگہ، یُس مارنہٕ آمُت آسہ یا پانے ممُت آسہ یا کانٛہہ شخص کانٛسہِ انسان سنٛزِ أڈجہ اتھٕ لاگہ یا کُنہِ قبرِ اتھٕ لاگہ، سُہ شخص سپدِ میانہِ خٲطرٕ ستن دوٚہُن باپتھ ناقٲبلِ قبوٗل۔
\p
\v 17 اگر کانٛہہ شخص یتھٕ پٲٹھؠ دُبارٕ میانہِ خٲطرٕ قٲبلِ قبول سپُد تہٕ تمِس چُھ تمِس گٲو ہُنٛد سوٗر یۅسہ زالنہٕ آمٕژ ٲس انُن تہٕ کُنہٕ بانس منٛز برُن۔ پتہٕ اتھ سوٗرس پٮ۪ٹھ تازٕ آبہٕ ہنا تراوٕنؠ۔
\v 18 پتہٕ ییٚلہ کانٛہہ شخص یُس نہٕ میانہِ خٲطرٕ ناقٲبلِ قبوٗل سپُدمُت آسہ تمِس پزِ زوف کلِچ اکھ لنٛڈ تُلٕنؠ تہٕ سۅ آبس منٛز بُڈٕونؠ۔ پتہٕ پزِ تمِس شخصس تتھ خٟمس آبہٕ سٟتؠ چِھرکاو کرُن یتہ سُہ نفر ممُت آسہ، تتھ خٟمس منٛز موجود چیزن پٮ۪ٹھ تہٕ تِمن لوٗکن پٮ۪ٹھ یمہ خٟمس منٛز ٲسؠ۔ تمِس پزِ امہِ آبہٕ سٟتؠ تمِس شخصس تہِ چِھرکاو کرُن یمؠ کانٛسہِ انسان سنٛزِ أڈجہ تہِ اتھٕ لوگمُت آسہ یا کانٛسہِ مارنہٕ آمتِس انسانس اتھٕ لوگمُت آسہ یا کانٛسہ تِتھس نفرس یُس قُدرتی طور گُزریمُت آسہ یا یمؠ کُنہِ قبرِ اتھٕ لوگمُت آسہ۔
\v 19 تریمہِ دوٚہہ یا تمہ پتہٕ ستہِ دوٚہؠ یُس شخص مےٚ پسند چُھ چُھکھ ضروری تِمن نفرن تہِ سُہ آب یمہ میانہِ خٲطرٕ نا پسنٛد دیدٕ آسن۔ سٔتمہِ دوٚہہ یمہ لوٗکھ یہ رسم انجام دِن تاکہ تِم سپدن دُبارٕ میانہٕ باپتھ قٲبلِ قبول تِم چھلن پنٕنؠ پلو تہٕ کرن غسُل۔ اگر تِم یہ کرن تہٕ امہِ دوٚہہ شامس سپدن تمہٕ بیٚیہِ میانہِ باپتھ قٲبلِ قبول۔
\v 20 اگر تمہٕ لوٗکھ یمہ میانہٕ باپتھ ناقٲبلِ قبوٗل سپٕدؠ مٕتؠ آسن تہٕ پتھ تہِ کٔرِتھ دبارٕ میانہ باپتھ ناقٲبلِ قبوٗل سپدن تہٕ تیٚلہ آسہ نہٕ تِمن پتہٕ اسرائیلی قومس منٛز روزنُک اجازت، تکیازِ تہنٛدِ سٟتؠ سپُد میٚون مقدس خٟمہ ناپاک۔ تِمو کۅر نہٕ تمہِ آبہٕ سٟتؠ پانس چِھرکاو یمہ سٟتؠ تہنٛدؠ کٔرؠ مٕتؠ گناہ چھلنہٕ یہَن، امہِ کِنؠ روزن تِمہ میانہِ باپتھ ناقٲبلِ قبول۔
\v 21 یہ چُھ اسرائیلی لوٗکن باپتھ اکھ قانون یُس نہٕ زانٛہہ بدلہِ۔ یمہ لوٗکھ امہِ آبہٕ سٟتؠ پانس چِھرکاو کرن چھلن پنٕنؠ پلو تہِ۔ تہٕ یُس اتھ آبس اتھٕ لاگہ یُس گُنہن ہنٛدؠ قصور دوٗر چُھ کرن۔ سُہ روزِ شامس تام خدایس برُونٛہہ کنہِ ناقٲبلِ قبوٗل۔
\v 22 کانٛہہ تہِ چیز یا کانٛہہ تہِ شخص یس کانٛسہِ ناقٲبلِ قبوٗل فردن اتھٕ لوگمُت آسہ سپدِ میانہِ باپتھ ناقٲبلِ قبوٗل سُہ روزِ امہِ دوٚہہ شامس تام میانہِ باپتھ ناقٲبلِ قبوٗل۔
\c 20
\p
\v 1 دویمہِ ورؠ یکہٕ گۅڈنِکہ ریٚتہٕ دراے اسرائیل لٕکؠ لوٗکھ صِینؔ کیٚن بیابانن کُن تہٕ دتِکھؠ پنٕنؠ خٲمہٕ قادِس جایہ نِش۔ تتہِ روزنس دوران گُزرییہِ موسیٰؔ سنٛز بیٚنہِ مریمؔ تہٕ کٔرکھ تتہِ دفن۔
\p
\v 2 تتہِ اوس نہٕ لوٗکن چیٚنہٕ خٲطرٕ آبےٕ یمہ کِنؠ تِم ہارونسؔ تہٕ موسیٰؔ ہس نِش آے۔
\v 3 تِمو کٔر تتہِ شکایت تہٕ ونُکھ، "کاش أسؠ آسہٕ ہو یہُوواہؔ سنٛدِس مقدس خٟمس نِشہ گُزریمٕتؠ، ییٚلہ سٲنؠ اسرائیلی سٲتھی مودؠ!
\v 4 کیاہ توٚہہِ أنوا أسؠ یہُوواہؔ سنٛدؠ لوٗکھ یتھ ریگسانس منٛز سٲنؠ چو چاروٲے ہیٚتھ مرنہٕ باپتھ؟
\v 5 توٚہہِ کیازِ أنیٚو أسؠ مِصرٕ پٮ۪ٹھٕ یتھ منحوس جایہ؟ یتہِ نہ چُھ کانٛہہ کھیٚن چیٚن، نہ چھِ انجیر، نہ دچھ تہٕ نہ دٲن۔ تہٕ نہ چھےٚ اسہِ چیٚنہٕ باپتھ تریش۔"
\v 6 موسیٰؔ تہٕ ہارونؔ ژٔلؠ لوٗکو نشہٕ تہٕ گے مقدس خٟمہٕ کِس دروازس نِش تہٕ دتُکھ سجدٕ۔ تِتھُے گو یہُوواہؔ پننِس جلالس منٛز تِمن برُونٛہہ کنہِ ظٲہر۔
\p
\v 7 پتہٕ ووٚن یہُوواہنؔ موسیٰؔ ہس، ییٚلہ یہُوواہؔ پننِس جلالس منٛز ظٲہر سپُد،
\v 8 "ژےٚ تہٕ ہارونس پزِ ہارونؔ سُنٛد عاصہ تلُن تہٕ تمام لوٗکھ جمع کرٕنؠ۔ ییٚلہ لوٗکھ وچھان آسن، ہُتھ بجہ کنہِ دی زیٚو حکم زِ آب دِ۔ امہِ منٛزٕ نیرِ لوٗکو باپتھ آب۔ یمن سارنی باپتھ تہٕ یہنٛدین چون چارواین بابتھ نیرِ واریاہ آب۔
\v 9 موسیٰؔ ہن کۅر تی یہ یہُوواہنؔ تمِس کرُن ووٚن۔ تٔمؠ اوٚن مقدس خٟمہٕ منٛزٕ ہارون سُنٛد سُہ عاصہٕ یُس تتہِ تھومُت اوسُکھ۔
\v 10 پتہٕ أنؠ ہاروننؔ تہٕ موسیٰؔ ہن تمام لوٗکھ تتھ کنہِ نِش ناد دِتھ۔ تہٕ موسیٰؔ ہن ووٚن تِمن، "اے سرکش لوٗکو، بوزیٚو! یہ چُھ سانہِ خٲطرٕ ضروری زِ أسؠ ہیٚمو تُہنٛدِ باپتھ یتھ کنہِ آب؟
\v 11 پتہٕ تُلؠ موسیٰؔ ہن پنٕنؠ اتھٕ تہٕ کنہِ سٟتؠ کتھ کرنہٕ بجایہ دِتُن اسہِ سٟتؠ کنہِ دویہِ لٹہِ ٹاس۔ تہٕ آب لوٚگ بُبرایہ نیرنہ۔ یتھ کنؠ چییہِ تمام لوٗکو تہٕ تہنٛدیٚو چاروایو تریش یۅسہ تِم ژھانٛڈان ٲسؠ۔\f + \fr 20‏:11 \ft 1 کورنتھ: 10:4\f*
\p
\v 12 مگر یہُوواہنؔ ووٚن ہارونس تہٕ موسیٰؔ ہس، "توٚہہ کۅرو نہٕ مےٚ پٮ۪ٹھ بھروسہٕ تہٕ نہ کۅرو اسرائیلی لوٗکن برُونٛٹھ کنہِ میٚون احترام، لہٰذا ہیٚکؠ ووکھ نہٕ یِم توٚہؠ تتھ ملکس منٛز نِتھ یُس مےٚ یِمن دیُتمُت چُھ۔"
\p
\v 13 امہِ پتہٕ پیٚو اتھ جایہ مریبہؔ ناو تمیُک مطلب چُھ 'بحث کرُن'\f + \fr 20‏:13 \ft مریبہ۔ مطلب بحث کرُن۔\f* تکیازِ تتھ جایہ کۅر اسرائیل یو یہُوواہسؔ خلاف بحث تہٕ تتِتھ بچوو تٔمؠ تمہٕ تریش چیٲوِتھ پنُن عزت تہٕ تقدُس۔
\p
\v 14 ییٚلہ لوٗکھ قادِسؔ جایہ ٲسؠ تہٕ موسیٰؔ ہو سوز پنُن قٲصد عدوم کِس بادشاہس نِش یہ وننہٕ باپتھ، "تُہنٛدؠ رشتہٕ دار یعنی اسرائیلی لوٗکھ چھِ توٚہہِ یہ پٲغام سوزان۔ توٚہؠ چُھو زانان زِ اسہِ کٲتیاہ مصیبت آے۔
\v 15 توٚہؠ چُھو زانان زِ جدٕ اجداد گے مِصر۔ توٚہؠ چُھو زانان زِ تِم رودؠ تتہِ واریہن ورؠ ین۔ تِمو تُلؠ تتہِ مصیبت، تکیازِ مِصرٕ کیٚو حٲکمو بنٲوؠ تمہٕ پنٕنؠ غلام تہٕ کرنٲوِکھ سخت محنت۔
\v 16 مگر ییٚلہ تِمو یہُوواہسؔ ناد لوُے تہٕ تمؠ بوز تِہُنٛد تہٕ سوزنکھ اکھ فرشتہٕ یمؠ تمہٕ مِصرٕ منٛزٕ کڈِتھ أنؠ۔ وۅنؠ دِتؠ اسہِ یتہ چٲنِس ملکس منٛز سرحدس نِشہ واقع قادِس شہرس منٛز پنٕنؠ خٟمہٕ۔
\v 17 مہربٲنی کرِتھ دی تو اسہِ پننہ ملکہ منٛزؠ نیرنُک اجازت۔ أسؠ روزو حیٚسہٕ، چانیٚو کھہَو تہ باغو منٛزؠ نیرو نہٕ۔ أسؠ کرو نہٕ چانیٚن کریریٚن ہُنٛد آب تہِ استعمال۔ ییٚلہ أسؠ سفر کرو، أسؠ ٹھہرو شٲہی وتہِ پٮ۪ٹھ، یۅسہ مرکزی سڑک جنوب پٮ۪ٹھٕ شمال کُن گژھان چھےٚ تہٕ أسؠ وسو نہٕ تمہِ سڑکہ پٮ۪ٹھ تۅتام بۅن یۅتام نہٕ أسؠ تُہنٛدِ ملکٕکؠ سرحد پار کرو۔"
\v 18 مگر ادومٕکؠ بادشاہن مون نہٕ۔ تٔمؠ ووٚن، "میانہ ملکہٕ نیٚبر روزؠ زیٚو! اگر توٚہہ یور اژنٕچ کوشش کٔرو تہٕ بہٕ سوزٕ توٚہہِ پٮ۪ٹھ حملہٕ کرنہٕ باپتھ پنُن فوج۔
\v 19 اسرائیل کیٚو قٲصدو دِتُس جواب، "اگر أسؠ تُہنٛدِ ملکہٕ منٛزؠ نیرو أسؠ روزو مرکزی سڑکہ پٮ۪ٹھ۔ اگر اسہِ منٛزٕ یا سانیٚو چاروایو منٛزٕ کانٛہہ تُہنٛز تریش چییہِ تہٕ أسؠ دِمو تمیُک قٟمت۔ أسؠ چھِ صرف تُہنٛدِ ملکہٕ منٛزؠ سفر کرُن یژھان۔ اسہِ گژھِ نہٕ بیٚیہِ کِہین۔"
\v 20 مگر ادومٕکؠ بادشاہن وُننکھ یورٕ، "نہ! سانہِ ملکہ نشہٕ روزیٚو دوٗر! أسؠ دِمو نہٕ توٚہہِ پننہِ سرِ زمینہ منٛزؠ نیرنُک اجازت!" پتہٕ سوز تٔمؠ پننہِ فوجُک اکھ مضبوط سِپاہ یُتھ زن تِمہ بنی اسرائیلی پننِس ملکس منٛز اژنہٕ نِشہ رکاونہٕ ین۔
\v 21 چونکہ ادومٕکؠ بادشاہن کۅر اسرائیل ین پننہِ ملکہ منٛزؠ نیرنُک اجازت دِنس انکار اوٕ کِنؠ پھیرؠ تِم واپس تہٕ دراے بدل وتہِ۔
\v 22 اسرائیلی لوٗکو ترُوو قادِسؔ شہر۔ تِم گے ہور پہاڑس پٮ۪ٹھ،
\v 23 یُس ادوم سرحدس پٮ۪ٹھ چُھ۔ ییٚلہ تِم تتہِ ٹھہریاے، یہُوواہنؔ ووٚن ہارونسؔ تہٕ موسیٰؔ ہس،
\v 24 "ہارون سنٛدِ مرنُک وق ووت۔ سُہ سپدیٚنہٕ تتھ ملکس منٛز دٲخل یُس بہٕ توٚہہِ اسرائیل ین دِوان چُھس، تکیازِ توٚہہ دوٚنویو ہارونن تہٕ موسیٰؔ ہن کٔرو میانؠ نافرمٲنی ییٚلہ مےٚ توٚہہِ ووٚن زِ کنہِ سٟتؠ کٔریٚو کتھ یُتھ سۅ توٚہہِ مریبہؔ ہس منٛز آب دییہِ۔\f + \fr 20‏:24 \ft اِستِثنا 32:50\f*
\v 25 موسیٰؔ وۅنؠ نِن ژٕ، ہارونؔ تہٕ تمسُنٛد نیٚچو الِیعزرؔ ہورؔ پہاڑس پٮ۪ٹھ۔
\v 26 تتہِ کڈِ ہارونؔ تِمہ پلو نیٚبر یمہٕ سُہ بحثیتِ کاہن لاگان چُھ تہٕ لاگہ پننِس نیٚچوِس الِیعزرؔس۔ ہارونؔ گُذرِ تٔتی تہٕ رلہِ پننٮ۪ن گُذریمتٮ۪ن جدن سٟتؠ۔"
\v 27 لہٰذا کۅر موسیٰؔ ہن تی یہ یہُوواہنؔ حکم کۅرُس۔ تِم تریٚنوے کٔھتؠ ہور پہاڑس پٮ۪ٹھ، یہ زن سٲری اسرائیلی وچھان ٲسؠ۔
\v 28 پہاڑ کِس تینتٲلِس پٮ۪ٹھ کٔڈؠ موسیٰؔ ہن ہارونؔ سنٛدؠ تِم پلو یمہٕ سُہ بحثیتِ کاہن لاگان اوس تہٕ لاگِن الِیعزرؔس۔ پتہٕ گُذریٚو ہارونؔ تٔتھؠ پہاڑٕ تینتٲلِس پٮ۪ٹھ، الِیعزرؔ تہٕ موسیٰؔ ؤتھؠ واپس بوٚن۔
\v 29 ییٚلہِ اسرائیل ین پےَ لُگ زِ ہارون گُذریاو تہٕ ساروےٕ رۅٹ تمسنٛدِ باپتھ أکِس ریٚتس ماتم۔\f + \fr 20‏:29 \ft پیدائش: 50:3، اِستِثنا: 34:8\f*
\c 21
\p
\v 1 عراد شہرُک کنعانؠ بادشاہ اوس تتھ علاقس منٛز روزان یتہِ جنوبی یہُودیہ کیٚن صحراون منٛز کنعانؠ روزان ٲسؠ۔ تٔمؠ بوز اکھ خبر زِ بنی اسرائیلی چھِ اتھارِم گامچہِ وتہِ کِنؠ پکان۔ تمسنٛدؠ فوجن کۅر تِمن بنی اسرائیل ین پٮ۪ٹھ حملہٕ تہٕ کینٛہہ أنِن رٹِھتھ تہِ۔\f + \fr 21‏:1 \ft یتھٕ پٲٹھؠ جاسوٗسو ہوو۔\f*
\v 2 پتہٕ کوٚر اسرائیل یو یہ دعا زِ اے یہُوواہؔ اگر ژےٚ یمن کنعٲنٮ۪ن شِکس دِنس منٛز اسہِ مدد کۅرتھ تہٕ أسؠ کرو یہنٛدؠ تمام شہر انٛد ہیٚتھ تباہ۔
\v 3 یہُوواہنؔ بوز یہنٛز یہ عرضی تہٕ تمؠ بنٲوؠ یمہ اتھ قٲبل زِ تِم ہیٚکن کنعانؠ لوٗکن ہنٛدس فوجس شکس دِتھ۔ اسرائیلی فوجن مٲرؠ اتِکؠ سٲری لوٗکھ تہٕ تہنٛدؠ شہر کٔرِکھ تباہ۔ تتہِ پٮ۪ٹھٕ پیٚو تتھ جایہ حُرمہؔ\f + \fr 21‏:3 \ft حُرمہؔ مطلب تباہ گٔمٕژ جاے\f* ناو یمیُک مطلب 'تبٲہی' چُھ۔
\p
\v 4 پتہٕ ترُوو اسرائیلی لوٗکو کوہہِ ہُور أتی تہٕ کۅرُکھ ادومؔ چہِ سرِ زمینہِ کُن واتنہٕ باپتھ بحرِ قُلزمؔ چہِ وتہِ ہُنٛد زیوٹھ سفر شروع۔ مگر اسرائیلی آے تمہِ زیٹھِ سفر سٟتؠ تنٛگ،
\v 5 تہٕ لگؠ خدایس تہٕ موسیٰؔ ہس متعلق اورٕیور وننہِ۔ تِمو ووٚن، "توٚہہِ کیازِ أنیٚو أسؠ مِصرٕ پٮ۪ٹھٕ یتھ ریگستانس منٛز مرنہٕ باپتھ؟ یتہِ نہ چُھ کھیٚنہٕ باپتھ کینٛہہ، تہٕ نہ چیٚنہٕ باپتھ۔ تہٕ اسہِ چھےٚ یہ بےٚ مزٕ مُنّہ کھیٚنس سٟتؠ نفرت!"
\v 6 یہُوواہنؔ ترٲوؠ تِمن منٛز زہریلہٕ سرف۔ واریہن لوٗکن دژٕ سرفو ٹۅپہٕ یمہِ کِنؠ تمہٕ مودؠ۔
\v 7 پتہٕ آے لوٗکھ موسیٰؔ ہس نِش تہٕ نلہٕ دِوان وُنہس، "وۅنؠ زون اسہِ زِ اسہِ ہیٚتؠ یہُوواہؔ تہٕ تُہنٛدؠ گناہ۔ یہُوواہسؔ منٛگؠ تو زِ سُہ نیٚیہ سرفن واپس! موسیٰؔ ہن مونٛگ لوٗکو باپتھ دُعا۔
\p
\v 8 پتہٕ ووٚن یہُوواہنؔ تمِس، زِ أکِس زہریلہٕ سرفہٕ سُنٛد آکار بناو تہٕ سُہ تراون کُنہٕ کوٗٹِس پٮ۪ٹھ اویزان۔ یمن سرفو ٹۅپہٕ دژٕ اگر تِمہ تتھ آکارس کُن وچُھن تِم سپدن ٹھیک۔"
\v 9 یتھٕ کنؠ بنووو موسیٰؔ ہن سرتلہِ ہُنٛد اکھ سرف تہٕ تھووُن أکِس دُزالِس پٮ۪ٹھ۔ تہٕ یمن سرفو ٹۅپھ دِژ مٕژ ٲس تِمو وُچھ سرتلہِ ہنٛدس اتھ سُرفس کُن تہٕ سپٕدؠ ٹھیک۔
\p
\v 10 پتہٕ دراے اسرائیلی تتہِ یہٕ دِتُکھ اوبوتسؔ نٲوؠ جایہِ ڈھیرٕ۔
\p
\v 11 پتہٕ دراے تِمہ اوبوتؔ منٛزٕ موآبؔ کیٚن مشرقی سرحدن ہنٛدیٚن بیابانن کُن تہٕ وٲتؠ عی عباریمؔ\f + \fr 21‏:11 \ft "اباریم" چُھ بحیرہ مردار کس مشرقس منٛز پہٲڑی سلسلہٕ۔ وُچِھو 27:12؛ 33:47 \f* جایہ۔
\v 12 تتہِ پٮ۪ٹھٕ گے تِم وادی کُن یتہِ زرد دریاو چُھ تہٕ دِتُکھ تتہِ ڈیرٕ۔
\v 13 پتہٕ گے تِم ارنونؔ کِس شمال طرفس کُن روانہٕ۔ سُہ علاقہ چُھ بیابانو کِنؠ تتھ ملکس سٟتؠ رلان یتہِ اموریؔ روزان چھِ۔ دریاے ارنونؔ چُھ موآبؔ تہٕ اموریؔ باشنٛدن درمیان سرحد۔
\v 14 اوے چُھ یہُوواہؔ کیٚن جنٛگ نامن منٛز لیٚکِھتھ،
\q1 "واہیبؔ چُھ سُوفہَس منٛز، تہٕ تتِکؠ نار،
\q2 تہٕ دریاے ارنونؔ
\q1
\v 15 تہٕ تتِکؠ نار۔
\q1 یمہٕ موآبؔ کہ سرحدٕ پٮ۪ٹھ عار گامس تام پھٲلِتھ چھِ۔
\v 16 تتہِ پٮ۪ٹھٕ کۅر اسرائیل یو بیر\f + \fr 21‏:16 \ft عبرانی ناو بیرُک مطلب چُھ کریور۔\f* کُن سفر۔ تتہِ اوس اکھ ناگ یتِتھ برُونٛہہ یہُوواہنؔ موسیٰؔ ہس ونیٚو، لوٗکھ کرُکھ جمع، بہٕ دمہٕ تِمن آب۔"
\v 17 تتہِ گیٚو اسرائیل یو یہ بٲتھ:
\q1 "اے ناگہٕ، اسہِ دِ آب!
\q1 یتھ ناگس چُھ ونہٕ وُن!
\q1
\v 18 یتھ ناگس چُھ گیٚوُن
\q2 یُس سانیٚو قٲیدو کھوٚنمُت چُھ؛
\q2 یُس تِمو پننیٚو شٲہی عاصو تہٕ لوریٚو سٟتؠ کھوٚنمُت چُھ۔"
\m پتہٕ دراے بنی اسرائیلی یہ بیابان ترٲوِتھ متناہؔ کُن۔
\v 19 پتہٕ وٲتؠ بنی اسرائیلی تہِ نحلی ایل تہٕ بامات گام کُن۔
\v 20 پتہٕ گے تِم موآبؔ چہِ وادی منٛز یتِتھ پِسگہ پہاڑ بیابانن منٛز تھزر پرٲوِتھ چُھ۔
\v 21 پتہٕ سوزؠ بنی اسرائیل یو امورؔ قوم کِس بادشاہ سیحونؔس نِش پنٕنؠ قٲصد۔ یُس پٲغام تِمو سوز سُہ اوس یتھٕ کنؠ،
\pi
\v 22 اسہِ دیو پننہِ ملکہٕ منٛزؠ نیرنُک اجازت۔ أسؠ روزو بادشاہ سنٛزِ مرکزی وتہِ پٮ۪ٹھ، مرکزی وتھ یۅسہ جنوب پٮ۪ٹھٕ شمال کُن گژھان چھےٚ، یۅتام أسؠ تُنٛدِ ملکٕچہِ سرِزمینہِ پٮ۪ٹھ سفر اند واتہٕ ناوو نہٕ۔ أسؠ پکو نہٕ کُنہِ کھیتہِ یا دچھِ باغہٕ منٛزؠ تہٕ نہ کرو تُہنٛدین کریرین ہُنٛد آب استعمال۔
\v 23 مگر بادشاہ سیحوننؔ کۅر انکار، تمؠ دیُت نہٕ یمن پننہِ سرِ زمینہِ منٛزؠ پکنُک اجازت۔ اتھ برعکس سوز تمؠ پنُن سورےٕ فوج صحراہس کُن بنی اسرائیل ین پٮ۪ٹھ حملہٕ کرنہِ۔ تِمو کوٚر یہضؔ گامس منٛز اسرائیل ین پٮ۪ٹھ حملہٕ۔
\v 24 مگر بنی اسرائیل یو دیُت تِمن پوٗرٕ پٲٹھؠ شکس تہٕ جنوبی دریاے ارنونؔ پٮ۪ٹھٕ شمٲلی یبوقؔ دریاوس تام کۅرکھ تہنٛزِ زمینہِ پٮ۪ٹھ قبضہٕ۔ تِم رُکیاے تمہِ سرِزمینہِ کِس سرحدس نِش یتِتھ عمونؔ قبیلٕکؠ لوٗکھ روزان ٲسؠ، تکیازِ عمونیؔ فوج اوس مضبوطی سان پننِس سرحدس رٲچھ کٔرِتھ۔
\v 25 چونکہِ بنی اسرائیل یو کۅر تِمن سارنی شہرن تہٕ قصبن قبضہٕ یتہِ اموریؔ لوٗکھ روزان ٲسؠ تہٕ کینٛہہ اسرائیلی لٔگؠ یمنےٕ سٟتؠ بسنہِ۔ تِمو کوٚر دارالحکومت حسبون شہرس تہٕ تتھ انٛدؠ پٔکؠ گامن پٮ۪ٹھ قبضہٕ۔
\v 26 حسبون اوس امہِ ملکُک دارالخلافہٕ۔ یہ اوس سُہ شہر یتہِ بادشاہ سیحون حکومت کران اوس۔ تمسنٛدؠ فوجن دیُت گۅڈٕ موآبؔ کِس بادشاہس سنٛدِس فوجس شکس، تہٕ تمہِ پتہٕ لٔگؠ تمسنٛدؠ لوٗکھ جنوبس کُن دریاے ارنونس تانؠ موآبؔ کِس پوٗرٕ ملکس منٛز روزنہِ۔
\v 27 اوے اوس کمؠ تام شاعرن گۅڈے ونمُت،
\q1 "حسبونؔ وٲتؠ زیٚو، تتھ شہرس یتہِ بادشاہ سیحونؔ حکومت کران اوس۔
\q2 أسؠ چھِ یژھان شہر گوٚژھ آباد سپدُن۔
\q1
\v 28 حسبونؔ پٮ۪ٹھٕ گو نار ظٲر۔
\q2 یمؠ موآبُک عار شہر نارٕ بُزؠ کۅر۔
\q1 تمؠ کٔرؠ پہاڑن ہنٛدؠ تمام چیز تہٕ دریاے ارنونؔ بُرباد\f + \fr 21‏:28 \ft ارنونؔ دٔریاوَس سٟتؠ کٔرِکھ پہاڑ تباہ۔\f*۔
\q1
\v 29 اے موآبؔ کیٚو لوٗکو، توٚہہِ سٟتؠ آے خطرناک واقہٕ پیش!
\q2 توٚہؠ لوٗکھ یم کموس دیوتا سنٛز عبادت کران ٲسؠ گوٚو فناہ!
\q1 تِم مرد یم کموس سنٛز پوٗزا کران ٲسؠ ژٔلؠ تہٕ وۅنؠ چھِ پناہ گزین،
\q2 تہٕ یمہٕ زنہِ تمؠ سنٛز پوٗزا کران آسہٕ تمہٕ نیٚیہ امورٕکؠؔ بادشاہ سیحونؔ سنٛدؠ فوجن رٔٹِتھ۔
\q1
\v 30 مگر اسہِ دیُت تِمن عمورؔ قبیلکیٚن شکس،
\q2 پرٛتھ حسابہٕ شمٲلی دارالحکومت حسبون پٮ۪ٹھٕ جنوبہ دیبون شہرس تام۔
\q1 اسہِ کٔرؠ تِم انٛد ہیٚتھ نابود نوفؔہ تہٕ مدیباؔ شہر ہیٚتھ۔"
\p
\v 31 وۅنؠ لٔگؠ اسرائیلی لوٗکھ اتھ ملکس منٛز بسنہِ یتہِ اموریؔ روزان ٲسؠ۔
\p
\v 32 پتہٕ سوزؠ موسیٰؔ ہن کینٛہہ نفر یعزیرؔ شہرس نکھٕ علاقہٕ ژھانٛڈنہٕ خٲطرٕ، اسرائیلی لوٗکھ لٔگؠ تمہِ علاقہٕ کیٚن سارنی شہرن منٛز بسنہِ تہٕ تتِکؠ روزن وٲلؠ اموریؔ لوٗکن ہنٛزٕ جمٲژ ژھنیٚکھ کٔڈتھ۔
\v 33 پتہٕ پھیرؠ تِم شمال انٛدٕ کِس بسنؔ علاقچ کُن۔ مگر بسنؔ علاقٕکؠ بادشاہ عوجؔ تہٕ تمسنٛدیٚو ساروےٕ فوجیو کۅر ادرعیؔ شہرس پٮ۪ٹھ حملہٕ۔
\v 34 یہُوواہنؔ ووٚن موسیٰؔ ہس زِ عوجسؔ مہٕ کھۅژ تکیازِ بہٕ بناوکھ چٲنؠ نفر یتھ لایکھ زِ تِم دن تَس تہٕ تٔمسنٛدِس فوجس شکس تہٕ کرن تمسنٛدس سٲرسےٕ زمینس پٮ۪ٹھ قبضہٕ۔ ژٕ کرکھ تس سٟتؠ تی یہ ژےٚ عمورؔ کیٚن لوٗکن ہنٛدِس بادشاہ سیحونؔس سٟتؠ کۅرتھ یُس حسبونُک بادشاہ اوس۔
\v 35 تہٕ یی سپُد تہِ۔ بنی اسرائیل یو دیُت بادشاہ عوجؔ کِس فوجس شکس، بادشاہ عوجؔ تمسنٛدؠ نیٚچوؠ تہٕ باقی تمام لوٗکھ ژھنِنؠ مٲرِتھ۔ اکھ نفر تہِ بچوو نہٕ! تہٕ پتہٕ لگؠ اسرائیلی پننہِ سرِزمینہِ پٮ۪ٹھ بسنہِ۔
\c 22
\p
\v 1 پتہٕ وٲتؠ بنی اسرائیل مغرب کِنؠ موآبؔ کِس مٲدانس تام یُس دریاے یردنچہ وادی منٛز یرِیحو شہر جایہ درؠ یاوٕ اپارِ اوس۔
\p
\v 2 مگر بادشاہ بلق بنِ صفور یُس موآبسؔ پٮ۪ٹھ حکومت کران اوس، اوس زانان زِ اسرائیل یو کیاہ کۅر عمور کیٚن لوٗکن سٟتؠ۔
\v 3 ییٚلہ تٔمؠ وُچھ زِ اسرائیلی چھِ واریہس تعدادس منٛز سُہ، موآبؔ تہٕ تمؠ سنٛز ریت بامبرییہِ۔
\v 4 لہٰذا گو موآبُک بادشاہ مدیانی ونٛڈٕ کیٚن قٲیدن نشہٕ تہٕ وُننکھ،\f + \fr 22‏:4 \ft موآبٕکؠ زِٹھؠ۔\f* "اسرائیل ین ہُنٛد یہ بوٚڈ کاروان کرِ پانس انٛدؠ پٔکؠ پرٛتھ اکھ چیز تِتھٕ کنؠ صاف یتھٕ کنؠ اکھ دانٛد گاسہٕ کھیٚوان چُھ!"
\p صفور سُنٛد نیٚچو بلق اوس موآبُک بادشاہ۔
\v 5 تٔمؠ سوزؠ بعورؔ سنٛدِس نیٚچو بلعامؔ ناوٕ کِس أکِس رسولس یس نِش پنٕنؠ قٲصد یُس دریاے فراتس نکھٕ فتور جایہ پننِسےٕ علاقس منٛز روزان اوس۔ تٔمؠ سوز تس یہ پٲغام زِ بلعامؔ ییہِ تس مدتہٕ خٲطرٕ،
\pi "مِصرٕ پٮ۪ٹھٕ وٲژ لوٗکن ہنٛز اکھ بٔڈ جماتھ یور۔ باسان چُھ زِ تِم چھِ سٲرسےٕ زمینس پٮ۪ٹھ پھٲلان! تہٕ تِم وٲتؠ اسہِ نزدیک۔
\v 6 چونکہ تِم چھِ سیٹھاہ طاقتور تہٕ أسؠ چھِ تِمن کھۅژان۔ مہربٲنی کٔرِتھ یی تو تہٕ میانہِ مۅکھٕ کٔرؠ تو تِمن لانتانہٕ۔ ادٕ ہیٚکہِ میٚون فوج تِمن شکس دِتھ تمہِ علاقہٕ منٛزٕ کڈِتھ یتِتھ تمہٕ ونہِ کیٚن روزِتھ چھِ۔ بہٕ چُھس زانان، یمن لوٗکن توٚہؠ دُعا کران چُھو تِمن سٟتؠ چُھ رٕژر پیش یوان، تہٕ تِمن لوٗکن چھِ مصیبت یوان یمن توٚہؠ لانتانہٕ کران چُھو۔
\v 7 بلق سنٛدیو قٲصدو، یمہ موآبؔ تہٕ مدیان دوٚنونؠ جمٲژن ہنٛدؠ زِٹھؠ ٲسؠ تُلؠ بلعامؔس دنہٕ خٲطرٕ پونٛسہٕ تہِ سٟتؠ، تاکہ تِم ین تہٕ کرن اسرائیل ین لانتانہٕ۔ تِم گے بلعامؔس نِش تہٕ وُنہس تہِ سورےٕ یہ بلقؔن ونمُت اوسنکھ۔\f + \fr 22‏:7 \ft 2 پطرس: 2:15\f*
\v 8 بلعامنؔ وُننکھ، "از راتس روزیٚو یتؠ۔ پگاہ صبحاے یہ کینٛژھا یہُوواہؔ مےٚ ونہٕ بہٕ ونو تہِ توٚہہِ۔"
\p لہٰذا رودؠ موآبٕکؠ یمہٕ قٲصد راتس أتؠ۔
\p
\v 9 راتس دوران سپُد بلعامسؔ نِش خدا ظٲہر تہٕ پرُوژھنس، "یم کمہٕ نفر چھِ ژےٚ نِش ٹھہرِتھ؟"
\p
\v 10 بلعامنؔ دِتُس جواب، "موآبٕکؠ بادشاہ صفور سنٛدؠ نیٚچوؠ بلقنؔ چھِ یم نفر مےٚ نِش یہ پٲغام ہیٚتھ سوزؠ مٕتؠ،
\v 11 مِصرٕ پٮ۪ٹھٕ چھےٚ لوٗکن ہنٛز اکھ بٔڈ جماتھ آمٕژ یمہٕ یتھ سٲرسےٕ علاقس منٛز پھٲلِتھ چھِ۔ مہربٲنی کٔرتھ کر تہٕ جلدےٕ یمن لعنتانہٕ۔ یُتھ بہٕ یمہ یمہِ علاقہٕ منٛزٕ شکس دِتھ کٔڈتھ ژھنکھ۔"
\p
\v 12 خداین دیُت بلعامسؔ جواب، "یمن سٟتؠ مہٕ گژھِ! تِمن چُھ میٚون دُعا سٟتؠ، لہٰذا مہٕ کر تِمن لعنتانہٕ۔"
\p
\v 13 بیٚیہِ دوٚہہ صبحٲے وتِھتھ ووٚن بلعامنؔ بلق کیٚن یمن نفرن، ؤتھیٚو نیریٚو گرٕ، مگر توٚہہ چُھ کنےٕ زٔنؠ گژھُن تکیازِ یہُوواہنؔ دیُت نہٕ مےٚ توٚہہِ سٟتؠ گژھنُک اجازت۔
\v 14 یتھ کنؠ آے موآبؔ پٮ۪ٹھٕ یم نفر بلق کِس بادشاہس نشہٕ واپس تہٕ تِمو ؤنؠ تس یہ خبر زِ بلعامنؔ کۅر اسہِ سٟتؠ ینَس انکار۔"
\p
\v 15 مگر بلقنؔ سوز قٲصدن ہنٛز بیاکھ جماتھ بلعامسؔ نِش۔ یہ ٲس اکھ بٔڈ جماتھ تہٕ یم ٲسؠ گۅڈنکیٚن نفرن ہندِ کھۅتہٕ زیادٕ قٲبلِ احترام۔
\v 16 تِم گے بلعامسؔ نشہٕ تہٕ وُنہَس، "بادشاہ چُھ صفور سُنٛد نیٚچو بلقؔ چُھ یہ ونان، مہربٲنی کٔرتھ مہٕ بناو یور ینس منٛز پانس کانٛہہ چیز رۅٹ۔
\v 17 بہٕ دِمے ژےٚ واریاہ پونٛسہٕ اگر ژٕ یور واتکھ تہٕ یہ کینٛژھا ژٕ مےٚ کرن ونکھ بہٕ کرٕ تہِ۔ ۅلہٕ یہ تہٕ کر یمن اسرائیلی لوٗکن لعنتانہٕ۔"
\v 18 مگر بلعامنؔ دیُت یمن جواب، "اگر بلقؔ مےٚ چاندِ تہٕ سۅنہٕ سٟتؠ بٔرتھ محل تہِ دییہِ توتہِ کرنہٕ بہٕ پننِس خدا یہُوواہؔ سنٛز نافرمٲنی۔
\v 19 وۅنؠ روزیٚو توٚہؠ تہِ باقی قٲصدن ہنٛدؠ پٲٹھؠ أکِس راتس یتؠ یُتھ بہٕ زانہٕ زِ یہُوواہؔ ما چُھ مےٚ بیٚیہِ کینٛہہ ونُن یژھان۔
\v 20 امہِ رٲژ سپُد بلعامسؔ خدا بیٚیہِ ظٲہِر تہٕ وُننس، "یم لوٗکھ ٲے ژےٚ عرضی کرنہِ زِ ژٕ گژھکھ یمن سٟتؠ گژُھن، لہٰذا ہیٚککھ ژٕ یمن سٟتؠ گٔژِھتھ، مگر کرُن چھی تی یہ بہٕ ونے!"
\v 21 دویمہِ دوٚہہ صبحٲے کۅر بلعامن خرس زیٖن تہٕ پنٕنؠ زٕ خٲدم سٟتؠ تُلِتھ گو موآبؔ کیٚن نفرن سٟتؠ روانہٕ
\v 22 یوٚدوے زن خداین بلعامسؔ گژھنُک اجازت دیُت تہِ مگر توتہِ اوس سُہ ناراضےٕ۔ حالانکہ تٔمؠ سوز پننیٚو فرشتو منٛزٕ اکھ بلعامسؔ نِش۔ یہ فرشتہٕ سپُد بلعامسؔ وتھ رٹنہٕ باپتھ وتہِ منٛز کھڑا۔ ییٚلہ بلعام تہٕ تمسنٛدؠ زٕ نوکر خرن پٮ۪ٹھ سوار ٲسؠ،
\v 23 بلعامؔ سنٛدِس خرس پییہِ فرشتس پٮ۪ٹھ نظر۔ فرشتہٕ اوس وتہِ منٛز کھڑا تہٕ اتھس کیٚتھ ٲسٕس تلوار، مگر بلعامنؔ وُچھ نہٕ سُہ۔
\p بلعامؔ سنٛدؠ خرن ترٲو وتھ أتی تہٕ ووٚتھ ڈورِس منٛز۔ مگر بلعامنؔ دِتؠ خرس چوب تہٕ کۅرُن مجبور واپس سڑکہِ پٮ۪ٹھ کھسنہٕ باپتھ۔
\v 24 پتہٕ گو فرشتہٕ بیٚیِس جایہ سڑکہِ پٮ۪ٹھ کھڑا یتٕتھ وتھ واریاہ تنٛگ ٲس تہٕ دوٚن دچھِ باغن درمیان سڑکہِ ٲسؠ دوٚنونی انٛدن دیوار دِتھ۔
\v 25 ییٚلہِ خرن فرشتہٕ تتِتھ ودٕنؠ وُچھ تہٕ سُہ آو فرشتس نِش نیرنہٕ خٲطرٕ دیوارس سٟتؠ چارنہٕ۔ یمہِ کِس نتیجس منٛز بلعامؔ سنٛدؠ کھۅر دیوارٕ سٟتؠ زٕلنہٕ آے۔ بلعامن دِتؠ خرس بیٚیہِ چوب۔
\v 26 پتہٕ دراو فرشتہٕ بیٚیہِ برُونٛہہ کُن تہٕ رود تتھ جایہِ وتہِ پٮ۪ٹھ ودٕنؠ یتِتھ وتھ بلکُل تنٛگ ٲس، امہِ کِس نتیجس منٛز ہیٚوک نہٕ خر رژھ تہِ برُونٛہہ پٔکِتھ۔
\v 27 یمہِ لٹہ ییٚلہ خرس فرشتس پٮ۪ٹھ نظر پییہِ سُہ بیوٹھ رسے پتھر یمِس پٮ۪ٹھ بلعام سوار اوس۔ بلعامسؔ کھۅت سخت شرار، تہٕ تٔمؠ دیُت پننہِ عاصہٕ سٟتؠ تمِس بیٚیہِ مار۔
\p
\v 28 پتہٕ دیُت یہُوواہنؔ خرس کتھ کرنُک طاقت! تٔمؠ پرُژھ بلعامسؔ، "مےٚ کیاہ کۅر ژےٚ سٟتؠ بُرٕ یمہِ کِنؠ ژےٚ ترییہِ پھرِ مےٚ لویُتھ؟"\f + \fr 22‏:28 \ft 2 پطرس: 2:16\f*
\v 29 بلعامنؔ ونُس بڈِ، "مےٚ لویہِ مےَ ژےٚ اوٕ موٚکھٕ تکیازِ ژےٚ بنوٕتھس بہٕ بیوقوف۔ اگر مےٚ تلوار آسہ ہے بہٕ کرٕہتھ ژٕ قتل!"
\p
\v 30 مگر خرن دِتُس جواب، "بہٕ چُھسے ژےٚ پنُن خر، یمِس پٮ۪ٹھ ژٕ ہمیشہٕ سوار آسان چُھکھ۔ مےٚ چھا زانٛہہ یتھٕ کنؠ کۅرمُت؟"
\p بلعامنؔ ونُس، "نہ"
\p
\v 31 پتہٕ دِژ یہُوواہنؔ بلعامسؔ یہ بصارت زِ تٔمؠ وُچھ سُہ فرشتہٕ یُس تلوار ہیٚتھ وتہِ منٛز کھڑا اوس۔ بلعامس گو احساس زِ یہ چُھ فرشتہٕ تہٕ ترووُن فرشتس برُونٛہہ کنہِ زمینس پٮ۪ٹھ سجدٕ۔
\v 32 فرشتن پرُوژھ تس، "ژےٚ کیازِ لویُتھ ترییہِ لٹہِ پننِس خرس؟ بہٕ آسے ژےٚ وتھ رٹنہِ تکیازِ یہ ژٕ سونچان چُھکھ تہِ چُھ غلط۔
\v 33 ترٚییہِ پھرِ وچُھس بہٕ چٲنؠ خرن تہٕ مےٚ نِش ڈٲجن وَتھ۔ اگر نہٕ سُہ یہ کرِہے تہٕ بہٕ مارٕ ہتھ ژٕ گۅڈے تہٕ خرس دمہٕ ہا زنٛدٕ روزنہٕ۔
\v 34 پتہٕ وُن بلعامنؔ فرشتس، "مےٚ کۅر گناہ۔ مگر مےٚ گو نہٕ یہ احساس زِ ژٕ چُھکھ بُتھِ روزِتھ میانؠ وتھ رُکاونٕچ کوشش کران۔ لہٰذا اگر نہٕ چٕ یژھان چُھکھ بہٕ گژھٕ اور گژُھن تہٕ بہٕ نیرٕ گرٕ واپس۔"
\v 35 فرشتن دِتُس جواب، "بہٕ دِمے ژےٚ یمن نفرن سٟتؠ گژھنُک اجازت، مگر ژےٚ چھی تی ونُن یہ بہٕ ژےٚ ونے۔ "لہٰذا دراو بلعام تِمن نفرن سٟتؠ یمہٕ بلقنؔ سوزؠ مٕتؠ ٲسؠ۔
\v 36 ییٚلہ بلق بادشاہن بوز زِ بلعام چُھ پکان تہٕ سُہ دراو تس سمکھنہٕ خٲطرٕ دریاے ارنونس نکھٕ واقہ موآبؔ کِس اکِس شہرس نِش، یُس تمِس پننہِ زمینہِ ہنٛدس سرحدس نزدیک چُھ۔
\v 37 ییٚلہِ سُہ بلعام سنٛزِ جایہ نزدیک ووت تہٕ بلقن ووٚن تس، "مےٚ سوزٲے ژےٚ جلدےٕ ینہٕ باپتھ پٲغام۔ توٚہؠ کیازِ او نہٕ؟ ژےٚ ما سونچُتھ زِ بہٕ ہیٚکے نہٕ ژےٚ یور ینہٕ باپتھ زیادٕ رقم ادا کٔرِتھ؟
\v 38 بلعامنؔ دِتُس جواب، بہٕ آس وۅنؠ یور، مگر بہٕ ہیٚکہٕ نہٕ کہیٚن ؤنِتھ یہ بہٕ یژھان چُھس۔ بہٕ ونہٕ صرف تی یہ مےٚ خدا ونُن ونہِ۔"
\v 39 پتہٕ گو بلعامؔ بلقسؔ سٟتؠ تہٕ وٲتؠ قریتؔ حُصات قصبچہِ جایہ۔
\v 40 تتہِ کٔرؠ بلقنؔ کینٛہہ گُپن تہٕ تیٖر قربان، کینٛہہ ماز پٔھلؠ کٔرِنؠ بلعامس تہٕ تمسنٛدین سٲتھیٚن پیش۔
\v 41 تِم شونٛگؠ تٔتی تہٕ دوویمہِ دوٚہہ صبحٲےنیفو بلقنؔ بلعام پہاڑو پیٚٹھؠ بامات بعلؔ گامس تام۔ تتہِ پٮ۪ٹھٕ ہیٚکہٕ ہن تِم کینٛژن اسرائیلی لوٗکن وچِھتھ یمہٕ بوٚن کُن ٲسؠ۔\f + \fr 22‏:41 \ft بعلؔ کٮ۪ن قربان گاہن خٲطرٕ تھزٕ جایہِ۔\f*
\c 23
\p
\v 1 بلعامنؔ ووٚن بلقؔ بادشاہس، "یتہِ بناو ژٕ ستتھ قربان گاہ میانہٕ باپتھ۔ پتہٕ انُکھ قربٲنی خٲطرٕ ستتھ ہکھر تہٕ کٹھ تہٕ کرُکھ ذبح۔
\v 2 بلقنؔ کۅر تی۔ تہٕ پتہٕ بُز تٔمؠ تہٕ بلعامنؔ پرٛتھ کُنہِ قربان گاہس پٮ۪ٹھ اکھ اکھ کٹھ تہٕ اکھ اکھ ہکُھر۔
\v 3 پتہٕ وُتھ بلعامؔ بلقس کُن، "ژٕ روز یتِتھ پننٮ۪ن بُزمژن قربٲنیَن نزدیک کھڑا، تہٕ بہٕ گژھے یہُوواہسؔ نِش تہٕ پرژھس زِ تمِس ما چُھ بیٚیہِ کینٛہہ مےٚ ونُن۔ پتہٕ ونے بہٕ ژےٚ زِ تٔمؠ کیاہ ووٚن مےٚ۔"
\p بلعامؔ کھۅت پتہٕ پانہٕ کِس بالہٕ تینٛتٲلِس پٮ۪ٹھ۔
\v 4 ییٚلہ سُہ بالہٕ تینٛتٲلِس پٮ۪ٹھ اوس تہٕ خداین دیُت تس تتہِ پنُن جلوٕ۔ بلعامنؔ ووٚن خدایس، "اسہِ بنٲوؠ ستتھ قربان گاہ تہٕ مےٚ کۅر پرٛتھ قربان گاہس پٮ۪ٹھ تُہنٛدِ باپتھ اکھ اکھ ہکُھر تہٕ اکھ اکھ کٹھ ذبح تہٕ پتہٕ بُزِم۔"
\p
\v 5 پتہٕ دیُت یہُوواہنؔ بلعامسؔ بلق بادشاہس وننہٕ خٲطرٕ اکھ پٲغام۔ تہٕ وُننَس، "واپس گژھِ تہٕ تمِس ون یہ کینٛژھا مےٚ ژےٚ وۅنمے۔"
\p
\v 6 ییٚلہِ بلعامؔ بلقؔ بادشاہس نشہٕ واپس آو تہٕ بلق اوس موآبؔ کیٚن بُزرگن سٟتؠ قربان گاہس پٮ۪ٹھ بُزنہٕ آمژن قربٲنین نِش کھڑا۔
\p
\v 7 یہ چُھ سُہ پٲغام یُس بلعامن تِمن بُوو،
\q1 "بلقنؔ اوٚنُس ارامؔ پٮ۪ٹھٕ یور بہٕ ناد دِتھ۔
\q2 موآبٕکؠ بادشاہن واتنووُس بہٕ یور ارامؔ کیٚو مشرقی انٛدٕ کیٚو پہاڑو پیٚٹھؠ۔
\q1 تٔمؠ ووٚن، ۅلہٕ میانہٕ باپتھ کر یعقوب سنٛدین اولادن لعنتانہٕ!
\q2 ۅلہٕ، ون زِ یِمن اسرائیل ین سٟتؠ یِین بُرٕ واقات پیش!'
\q1
\v 8 مگر بہٕ کِتھ کنؠ سوزٕ تِمن لوٗکن پٮ۪ٹھ لعنت یمن پٮ۪ٹھ نہٕ یہُوواہنؔ لعنت کٔر؟
\q2 بہٕ کِتھٕ کنؠ کرٕ تِمن لوٗکن خلاف جنگ یمن خلاف نہٕ یہُوواہنؔ جنگ کۅر؟
\q1
\v 9 مےٚ وُچھ تِمہ کنہِ بالن ہنٛدیٚو تھزرو پیٚٹھؠ،
\q2 مےٚ وُچھ تِمہ پہاڑو پیٚٹھؠ۔
\q1 مےٚ وُچھ، سۅ چھےٚ اکھ لُکہ جماتھا یۅسہ الگ روزان چھےٚ۔
\q2 تِمو چُھ باقی قومو نِشہ پنُن پان الگ کۅڈمُت۔
\q1
\v 10 کُس ہیٚکہ یعقوبؔ سنٛدین اولادن گنٛزرٲوِتھ، یمہٕ لژھِ ہنٛدین دانن ہنٛدؠ پٲٹھؠ چھِ!
\q2 اسرائیل کیٚن لوٗکن ہُنٛد ژورِم حصہٕ تہِ کُس ہیٚکہِ گنٛزرِتھ؟
\q1 بہٕ چُھس یژھان بہٕ گوٚژھُس مُرن یتھٕ کنؠ صادق لوٗکھ مران چھِ۔
\q2 مےٚ چھےٚ امید زِ بہٕ مرٕ سکوٗنہٕ سان یتھ کنؠ تِم مرن۔
\v 11 پتہٕ وُن بلقنؔ بلعامس، "ژےٚ کیاہ کۅرتھ مےٚ سٟتؠ؟ مےٚ اُنمکھ ژٕ یور پننٮ۪ن دشمنن لعنت والنہٕ باپتھ، مگر امہِ بجایہ کۅرتھ ژےٚ یمن دعا!
\p
\v 12 مگر بلعامنؔ دتُس جواب، "بہٕ ہیٚکہٕ صرف تی ؤنِتھ یہ یہُوواہؔ مےٚ ونُن ونہِ۔ بہ ہیٚکہٕ نہٕ بیٚیہِ کہین ؤنِتھ۔"
\p
\v 13 پتہٕ وُن بلقؔ بادشاہن بلعامسؔ، "مےٚ سٟتؠ یہ بیِس جایہ۔ تتہِ یِیی ژےٚ صرف اسرائیلی قومُک اکھ حصہٕ اتھِ، تہٕ تِمن لوٗکن ہیٚککھ ژٕ میانہِ مۅکھٕ لعنت وٲلِتھ۔
\v 14 یتھ کنؠ نیٚو بلقنؔ بلعامؔ پِسگہ پہاڑی ہنٛدِس تھزرس پٮ۪ٹھ ضوفِیم نٲوؠ أکِس کھہَس منٛز۔ تتہِ بناوؠ تٔمؠ بیٚیہِ ستتھ قربان گاہ تہٕ پرٛتھ اکِس قربان گاہس پٮ۪ٹھ کۅرُن اکھ ہکُھر تہٕ اکھ کٹھ قربان۔
\v 15 اتہ تہِ وُن بلعامنؔ بادشاہس، "یتِتھ روز بُزمژن قربٲنیٚن نِش ۅدٕنؠ، بہٕ گژھٕ تہٕ کرٕ یہُوواہسؔ سٟتؠ کتھ۔"
\p
\v 16 لہٰذا کۅر بلعامن یی تہٕ یہُوواہؔ سپُد بیٚیہِ بلعامسؔ برُونٛہہ کنہِ ظٲہر تہٕ دیُتنس بیاکھ پٲغام۔ پتہٕ وُننس، "بلقسؔ نِش گژھِ واپس تہٕ سُہ بوزناوُن یہ پٲغام۔
\p
\v 17 امہ موٚکھٕ گو بلعام تتھ قربان گاہس نِش یتِتھ موآبُک بادشاہ تہٕ قٲید ۅدٕنؠ ٲسؠ تہٕ یتھ جایہ بلقنؔ قربٲنیہ بُزٕ۔ بلقن پرُوژھ تمِس، "کیاہ وننے یہُوواہنؔ؟"
\p
\v 18 تہٕ بلعامنؔ بوزنوو سُہ یہ پٲغام،
\q1 "بلق، غورٕ سان بوز،
\q2 بوز اے صفور سنٛدِ گۅبرٕ، بہٕ کیاہ چُھس ونُن یژھان!
\q1
\v 19 خدا چُھنہٕ کانٛہہ انسان۔
\q2 انسان ونہِ اپُز مگر خدا چُھنہٕ زانٛہہ اپُز ونان۔
\q1 سُہ چھنہٕ انسانن ہنٛدؠ پٲٹھؠ پنُن سونچ زانٛہہ تہِ بدلاوان۔
\q2 یہ کینٛژھا تٔمؠ ووٚن بہٕ کرٕ، تہِ چُھ سُہ کران۔
\q2 تٔمؠ یُس تہِ وعدہ کۅر سُہ کۅر تٔمؠ برابر۔\f + \fr 23‏:19 \ft 2 تیموتھی: 2:13\f*
\q1
\v 20 تٔمؠ کۅر مےٚ حکم زِ بنی اسرائیلی ین باپتھ کر مےٚ برکتٕچ عرضی۔
\q2 لہٰذا دِژ تٔمؠ تِمن برکت تہٕ بہٕ ہیٚکہ نہٕ تہِ بدلٲوِتھ۔
\v 21 یہُوواہؔ تِہنٛد خدا چُھ تِمن سٟتؠ۔
\q2 لوٗکھ چھِ نعرٕ دِوان زِ سُہ چُھ تِہُنٛد پوٚز بادشاہ۔
\q1 بے شک واتہ نہٕ یعقوبؔ سنٛدین اولادن کانٛہہ نقصان،
\q2 تِم تُلن نہٕ خدایہ سنٛدِ بغٲر کانٛہہ تہِ مصیبت۔
\q1
\v 22 خداین کٔڈؠ تِم مِصرچہِ غلامی منٛزٕ تہٕ واتناوِنؠ طاقتور جنگلی دانٛدن ہنٛدؠ پٲٹھؠ بیابانن منٛز۔
\v 23 ییٚلہ لوٗکھ یعقوبؔ سنٛدین اولادن لعنت سوزن تہٕ تِمن واتہ نہٕ کانٛہہ نقصان،
\q2 ییٚلہ لوٗکھ تِمن کانٛہہ جود کرن تہٕ تتھ آسہ نہٕ کانٛہہ طاقت۔
\q1 تہٕ وۅنؠ آسن لوٗکھ یعقوبؔ سںنٛدین اولادن متعلق یہ ونان زِ،
\q2 'خداین کیاہ کرِ بنی اسرائیلی ین باپتھ حٲران کرن واجنہِ کامہِ!'
\v 24 تِم چھِ واریاہ مضبوط، تٔمس شیمنہِ ہنٛدؠ پٲٹھؠ یۅسہ باقی جانورن پٮ۪ٹھ حملہٕ کرنہٕ خٲطرٕ تیار چھےٚ آسان۔
\q2 تِم چھِ سٕہن ہنٛدؠ پٲٹھؠ کھڑا آسان۔
\q1 سٕہہ چُھنہٕ تۅتام آرامُک ناو ہیٚوان یۅتام نہٕ تِم پننِس شکارس مٲرِتھ کھیٚن تہٕ مٲرمٕتِس جانور سُنٛد خوٗن چیٚن نہٕ۔
\p
\v 25 بلقنؔ ووٚن پتہٕ بلعامسؔ، اگر ژٕ تِمن لعنت سوزکھ نہٕ مگر بہٕ چُھس نہٕ یژھان زِ کرکھ تِمن دُعا۔"
\p
\v 26 مگر بلعامنؔ وۅنُس یورٕ، "مےٚ چُھمے ژےٚ وۅنمُت زِ بہٕ چُھس تی کران یہ مےٚ یہُوواہؔ کرنہٕ باپتھ ونان چُھ۔"
\p
\v 27 امہِ پتہٕ ووٚن بلق بادشاہن بلعامسؔ، "توٚہؠ یِیو مےٚ سٟتؠ۔ بہٕ نِمو توٚہؠ بیِس جایہ۔ شاید گژھِ یہ جاے خدایس خوش تہٕ سُہ دییہِ توٚہہ اتھ جایہ یمن پٮ۪ٹھ لعنت نٲزِل کرنُک اجازت۔"
\v 28 بلقؔ بادشاہن نیٚو بلعامؔ کوہہِ پیٚورؔ کِس تھزرس پٮ۪ٹھ یتہٕ پٮ۪ٹھٕ سُہ بوٚن کُن نظر دییہِ ہے تہٕ صحراہس منٛز موجود اسرائیل ین وُچِھتھ ہیٚکہِ ہے۔\f + \fr 23‏:28 \ft پیٚورؔ اوس اکھ پہاڑ، یُس غٲلبن بحیرہ مردار کِس شمٲلی سرس پٮ۪ٹھ تقریباً 20 کلومیٹر مشرقس منٛز اوس۔\f*
\p
\v 29 بلعامنؔ ووٚن پتہٕ بلقؔس بیٚیہِ، "میانہِ باپتھ بناو بیٚیہِ ستتھ قربان گاہ تہٕ نذرانہٕ باپتھ کرُکھ ستتھ ہکھر تہٕ ستتھ کٹھ قربان۔"
\v 30 بلقنؔ بلکُل تی یہ بلعامن تمِس کرنہٕ باپتھ ووٚن۔ تٔمؠ بُزؠ پرٛتھ قربان گاہس پٮ۪ٹھ اکھ اکھ ہکُھر تہٕ اکھ اکھ کٹھ قربٲنی خٲطرٕ۔
\c 24
\p
\v 1 بلعامس توٚر وۅنؠ فکرِ زِ یہُوواہؔ اسرائیلی لوٗکن برکت دیُن یژھان، نکہِ تِمن لعنت سوزٕنؠ یژھان۔ لہٰذا کۅر نہٕ تٔمؠ کُنہ روحٲنی طاقتُک استعمال یتھ کنؠ زنہٕ اکھ روحٲنی بزرگ زاننہٕ خٲطرٕ کران چُھ زِ یہُوواہؔ کیاہ چُھ یژھان، یتھ کنؠ زن سُہ اکثر کران اوس۔ امہِ بجایہ کۅر تٔمؠ سحراوس کُن پنُن رۅخ۔
\v 2 بلعامن وُچھ زِ اسرائیلی لوٗکھ ٲسؠ تتہِ پننٮ۪ن خٟمن منٛز ڈیرٕ دِتھ تہٕ پرٛتھ کانٛہہ قبیلہٕ اوس پنٕنؠ جمٲژ سٟتؠ۔ پتہٕ سپُد تس خدایی روح بیٚیہِ جلوٕ گر۔
\v 3 یہ چھےٚ سۅ روحٲنی شیٚچھ یۅسہ تٔمؠ بلقسؔ دِژ:
\q1 بہٕ چُھس بعورؔ سُنٛد نیٚچو بلعامؔ یہ پیشن گوئی کران۔
\q2 یہ پیشن گوئی یۅسہ بہٕ توٚہہ دِوان چُھس چُھ اکھ سُہ فرد دِوان یُس وچھان زِ آینٛدٕ کیاہ بنہِ۔
\q1
\v 4 مےٚ بوز یہ پٲغام خدایس نِش۔
\q2 یہ چھےٚ تمؠ سنٛز بشارت یُس مکمل دسگاہ تھاوان چُھ۔
\q2 میانہِ نظرٕ چھےٚ یلہٕ گژھان یِتھُے بہٕ تمِس برُونٛہہ کنہِ نمان چُھس۔
\q1
\v 5 اے یعقوبؔ سنٛدِ گۅبرٕ، چٲنؠ خٟمہٕ چھِ واریاہ خوبصوٗرت!
\q2 یتہِ ژٕ روزان چُھکھ تمہٕ جایہ تہِ چھےٚ بہترین!
\q1
\v 6 مےٚ برُونٛہہ کنہِ چھِ چٲنؠ خٟمہٕ خزٕر کُلیٚن ہنٛدؠ پٲٹھؠ تہٕ دریاوٕ بٹھِ کیٚن باغن ہنٛدؠ پٲٹھؠ پھٲلِتھ۔\f + \fr 24‏:6 \ft عبر: 8:2\f*
\q2 تِم چھِ یہُوواہؔ سنٛدیو لٲگؠ مٕتیٚو عُود کُلیٚن ہنٛدؠ پٲٹھؠ مضبوط،
\q2 تِم چھِ دریاوٕ بٹھیٚن پٮ۪ٹھ آمتیٚن دیودارن ہنٛدؠ پٲٹھؠ۔
\q1
\v 7 چٲنؠ آبہٕ نٔٹؠ روزن ہمیشہٕ بٔرِتؠ۔
\q2 ژٕ یُس تہِ بیول ووَکھ سُہ زیونہٕ خٲطرٕ آسہ تتھ ہمیشہٕ وٲفِر آب میصر۔
\q1 بنی اسرائیل لُک بادشاہ آسہ اجاجؔ بادشاہس کھۅتہٕ تھوٚد۔
\q2 یتھ سلطنتَس پٮ۪ٹھ سُہ حکومت کرِ سۅ آسہ پُر وِقار۔
\q1
\v 8 خداین أنؠ اسرائیلی مِصرٕ منٛزٕ کٔڈتھ، پننہٕ بڈِ طاقتہٕ سٟتؠ یس جنٛگلؠ سانٛڈ سُنٛد ہیٚو طاقت چُھ۔
\q2 خدا کرِ تِمن سارنی قومن نابود یِم تمؠ سنٛز مخالفت کرن۔
\q2 سُہ پُھٹراوِ تِمن سارنی لوٗکن أڈجہ، تہٕ ماریٚکھ پننیٚو تیٖرو سٟتؠ۔
\q1
\v 9 بنی اسرائیلی چھِ سٕہن ہنٛدؠ پٲٹھؠ یمہٕ شونٛگِتھ تہٕ کُملِتھ، پننِس شُکارس تھف دنہٕ خٲطرٕ تیار آسان چھِ،
\q2 تمِس سیمنہِ ہنٛدؠ پٲٹھؠ یۅسہ ارامسؔ منٛز آسان چھےٚ،
\q2 تہٕ کانٛہہ چُھنہٕ تمِس ہُشار کرنٕچ ہمتھ کران!
\q خدا کرِ تِمن سارنی برکت یُس توٚہہ اسرائیل ین برکت دییہِ۔ تہٕ ژھنہِ تس فردس لعنت یُس تُہنٛدِ خٲطرٕ لعنت منٛگہِ۔
\p
\v 10 پتہٕ سپُد بادشاہ بلقؔ بلعامسؔ سیٹھاہ ناراض۔ تٔمؠ ہوو پننیٚو اتھو سٟتؠ زِ تمِس چُھ واریاہ شرارتھ، تہٕ تٔمؠ ووٚن کریٚکھ دِتھ، "مےٚ اوٚنمکھ ژٕ پننٮ۪ن دشمنن لعنتانہٕ کرنہٕ باپتھ یور بُلٲوِتھ۔ اتھ برعکس کۅرتھ ژےٚ تِمن ترییہِ پھرِ دُعا!
\v 11 ژٕ نیر ۅن یتہ۔ گژھِ پنُن گرٕ واپس! مےٚ وۅنمے نا ژےٚ اگر ژٕ یمن لعنت ژھنکھ تہٕ بہٕ دِمے ژےٚ واریاہ رقم، مگر یہُوواہنؔ رُکوٕنکھ ژٕ کانٛہہ تنخواہ رٹنہٕ نِشہ!
\p
\v 12 بلعامنؔ ووٚن بلقسؔ، "کیاہ ژےٚ چُھے نا یاد زِ مےٚ کیاہ ووٚن تِمن قٲصدن یمہٕ ژےٚ مےٚ نِش سوزؠ مٕتؠ ٲسؠ تھکھ؟ مےٚ ونمکھ،
\v 13 "اگر بلق مےٚ چانٛدِ تہٕ سۅنہٕ سٟتؠ بٔرِتھ محل تہِ دییہِ توتہِ کرنہٕ بہٕ یہُوواہؔ سنٛز نافرمٲنی۔ بہٕ کرنہٕ کانٛہہ تہِ رٕژ یا بُرٕ کٲم یۅسہ نہٕ تس منظور آسہ۔ تہٕ مےٚ وۅنمے ژےٚ زِ بہٕ ہیٚکہ تی ونِتھ یہ یہُوواہؔ مےٚ ونہِ۔
\v 14 آ، بہٕ گژھٕ وۅنؠ پننٮ۪ن لوٗکن نِش واپس مگر گۅڈٕ دِ مےٚ یہ وننُک اجازت زِ آینٛدٕ کیاہ بنہِ توٚہہ موآبؔ کیٚن لوٗکن سٟتؠ۔"
\p
\v 15 پتہٕ وُتھ بیٚیہِ بلعام بلقسؔ کُن،
\q1 "بہٕ، بلعام، بعورؔ سُنٛد نیٚچو چُھسے نُبوت ونان۔
\q2 یۅسہ پیشن گوئی بہٕ ونان چُھسے چھےٚ اکہِ لٹہِ بیٚیہِ تمِس نفرٕ سنٛز یُس نٔنؠ پٲٹھؠ وُچھان چُھ زِ آینٛدٕ کیاہ سپدِ۔
\v 16 بہٕ چُھس خدایہ سُنٛد اکھ پٲغام بوزان۔
\q2 بہٕ چُھس تِمہ کتھٕ زانان یمہ آسمان پیٚٹھُک خدا مےٚ پٮ۪ٹھ ظٲہر کران چُھ۔
\q1 بہٕ چُھس قدرتہٕ وٲلِس خدایہ سنٛدؠ جلوٕ ڈیشان۔
\q2 میانہِ نظرٕ چھےٚ یلہٕ گژھان ییٚلہِ بہٕ تمِس برُونٛہہ کنہِ سجدٕ کران چُھس۔
\v 17 یہ کینٛژھا بہٕ مشاہِدس منٛز وُچھان چُھس تہِ چُھنہٕ وۅنؠ سپدن وول۔
\q2 بہٕ چُھس تمہ چیز وچھان یمہ خدا آینٛدٕ کرِ۔
\q1 اکھ شخص یُس یعقوبؔ سنٛدِ پشتُک آسہ نیرِ تارکٕکؠ پٲٹھؠ نوٚن۔
\q2 بنی اسرائیل منٛزٕ آسہ اکھ بادشاہ یمِس عاصہٕ ہیٚتھ آسہ۔
\q1 سُہ نیٚیہ توٚہہِ موآبؔ کیٚن لوٗکن کلہٕ تُلِتھ۔
\q2 سُہ کرِ سیٹھؔ سنٛز ذریاتھ نابود۔
\q1
\v 18 بنی اسرائیل کرِ عدومسؔ پٮ۪ٹھ قبضہٕ،
\q2 تہٕ تِم لبن پننٮ۪ن دشمنن پٮ۪ٹھ فتح یم کوہہِ شعیرسؔ نکھٕ روزان چھِ۔
\q2 بنی اسرائیل لٕکؠ لوٗکھ سپدن فتح یاب۔
\q1
\v 19 اکھ حٲکم ییہِ یُس یعقوبؔ سنٛدِ قبیلہٕ منٛزٕ آسہ۔
\q2 تمسنٛدِ سٟتؠ میلہِ تِمن تِمو لوٗکو نِشہ نجات یم وُنتہِ تتھ شہرس منٛز روزان چھِ یتہِ بلعامنؔ تہٕ بلقنؔ گۅڈنیُک ملاقات کۅر۔"
\q1
\v 20 پتہٕ وُچھ بلعامن زِ عمالیقؔ لوٗکن ہنٛز کماتھ کتہِ چھےٚ روزان، تہٕ تٔمؠ کٔر یہ پیشن گوئی:
\q1 "عمالیق قبیلہٕ آسہ ساروےٕ کھۅتہٕ بوٚڈ قبیلہٕ،
\q2 مگر تمہٕ تہِ روزن نہٕ کُنہِ۔"
\p
\v 21 پتہٕ دِژ تٔمؠ تتھ علاقس کُن نظر یتہِ کنعٲنؠ لوٗکن ہنٛز جماتھ روزِتھ ٲس، تہٕ کرٕن یہ پیشن گوئی:
\q1 "توٚہؠ ٲسیٚو زانان زِ یتھ جایہ أسؠ روزان چھِ یہ چھےٚ پہاڑن منٛز بٔنِتھ آلیٚن ہنٛدؠ پٲٹھؠ مضبوط،
\q1
\v 22 مگر ییٚلہ اسُورؔ سُنٛد فوج توٚہہِ فتح کرِ تہٕ توٚہؠ تہِ روزیٚو نہٕ کُنہِ۔"
\p
\v 23 بلعامنؔ مۅکلاوِ یہ ؤنِتھ پننہِ پیشن گوئی،
\q1 ییٚلہِ خدا یہ سورےٕ کرِ تہٕ پتہٕ کُس روزِ زنٛدٕ؟
\q1
\v 24 کتیمؔ\f + \fr 24‏:24 \ft کتیمؔ جزیرٕ \f* کہ سٲحلہٕ پٮ۪ٹھٕ ییٚلہ ٲبی جہازٕ ین،
\q2 تہٕ تِمن جہازن ہنٛدؠ نفر دِن اسُورؔ تہٕ عِبر کِس فوجس شِکس۔
\q2 مگر خدا دییہِ تتہِ تمن لوٗکن نشہٕ یہِ نجات۔
\q
\v 25 مگر پتہٕ دراے بلعامؔ تہٕ بلقؔ پنٕنؠ پٲغام مۅکلٲوِتھ تہٕ گے واپس پننہِ جایہِ پن پننٮ۪ن گرن کُن۔
\c 25
\p
\v 1 ییٚلہ اسرائیل لٕکؠ کینٛہ مرٕد اکاکِیا گروو ناوچہِ جایہ ڈیرٕ دِتھ ٲسؠ، کینٛہہ نفر گے تہٕ خدایی احکامن ہنٛز بے وفٲیی کٔرٕتھ شونٛگؠ موآبؔ قبیلچن زنیٚن نِش یمہٕ اتھ علاقس منٛز روزان آسہٕ۔\f + \fr 25‏:1 \ft عبرانی ناو شِطیمُک مطلب چُھ "اکاکِیا کُلؠ" امہٕ جایہٕ ہنٛد پورٕ ناو چُھ" ابیل شِطیم" \f*\f + \fr 25‏:1 \ft 1 کورنتھ: 10:8\f*
\v 2 پتہٕ دِژ یِمو موٲبؠ زنیٚو تِمن تمہِ وقتہٕ ینٕچ دعوت ییٚلہ تمہٕ پننؠن دیوتاہن قربٲنیہ پیش کران آسہٕ۔ اسرائیل کیٚو مردو مون یہ۔ اسرائیلی گے یمن زنیٚن سٟتؠ اتھ تقریبہِ منٛز تہٕ کٔرکھ موآبؔ کیٚن لوٗکن سٟتؠ دیوتاہن ہنٛز پوٗزا۔\f + \fr 25‏:2 \ft مُکاشفہ: 2:14\f*
\v 3 یہ کرنہٕ سٟتؠ لگؠ اسرائیلی نفر زنیٚن سٟتؠ شٲمل گژھِتھ بعلؔ دیوتا سنٛز پوٗزا کرنہِ، یتھ متعلق موٲبؠ لوٗکن ہُنٛد ونُن چُھ زِ سُہ چُھ کوہہِ فغورس پٮ۪ٹھ۔ امہ کِنؠ سپُد یہُوواہؔ پننٮ۪ن لوٗکن پٮ۪ٹھ سیٹھاہ ناراض، تہٕ تٔمؠ کۅر واریہن اسرائیلی ین پٮ۪ٹھ وباہ نٲزِل۔
\p
\v 4 یہُوواہنؔ ووٚن موسیٰؔ ہس یہ، "یم سٲری اسرائیلی زِٹھؠ رٹُکھ یم یہ کران چھِ تہٕ یم سٲری کرُکھ قتل یۅتام بہٕ وچھان روزٕ۔ یہ کر ژٕ دوٚہلہِ۔ چون یہ کرنہٕ پتہٕ روزنہٕ بہٕ اسرائیلی لوٗکن پٮ۪ٹھ بیٚیہِ ناراض۔"
\p
\v 5 امہِ کِنؠ ووٚن موسیٰؔ ہن اسرائیل کیٚن باقی زِٹھین، "توٚہہ منٛزٕ پزن پرٛتھ کانٛسہِ پنٕنؠ تِم نفر قتل کرٕنؠ یمہ بعلؔ سنٛدِس عبادتس منٛز باقیَن سٟتؠ شٲمل گے۔"
\v 6 مگر پتہٕ ییٚلہِ واریہو لوٗکو مقدس خٟمہٕ کِس دروازس پٮ۪ٹھ ودُن لوگ تہٕ اسرائیلی نفرو منٛزٕ أنؠ أکؠ مِدیٲنؠ جمٲژ ہنٛز اکھ زٔنؠ پننِس خٟمس منٛز تہٕ ہیٚوتُن تس نِش شونٛگُن۔ موسیٰؔ ہن تہٕ باقی لوٗکو بوز یہ خبر۔
\v 7 ییٚلہ ہارونؔ سنٛدؠ زُرؠ فینحاسنؔ یہ بوز سُہ وُتھ جمٲژ منٛزٕ تھوٚد تہٕ تجِن برچھی اتھس منٛز۔
\p
\v 8 تہٕ گو کُنی دوِ أمِس نفرٕ سنٛدِس خٟمس منٛز۔ تٔمؠ بُڑو سیٚودے نیزٕ مردٕ سنٛدِ جسمہٕ منٛزؠ زنہٕ ہنٛزِ یٔڈ تہٕ ژھنٕنؠ دۅشوے مٲرِتھ۔ ییٚلہِ تٔمؠ یہ کۅر تہٕ یُس وبا بنی اسرائیل ین پٮ۪ٹھ وتھمُت اوس سُہ رُکیٚو۔
\v 9 مگر امہِ وباہ سٟتؠ ٲسؠ ژُووہہ ساس نفر مُمٕتؠ۔\f + \fr 25‏:9 \ft 1 کورنتھ: 10:8\f*
\p
\v 10 پتہٕ ووٚن یہُوواہنؔ موسیٰؔ ہس،
\v 11 الِیعزرؔ سُنٛد نیٚچو "فینحاسؔ بنیاو بٲعث میٚون سُہ رٔویہ اسرائیلی لوٗکن پٮ۪ٹھ بےٚ تٲبی سان بنٛد کرنُک یُس بہٕ تِمن پٮ۪ٹھ کران اوسُس۔ بہٕ اوسُس تمام اسرائیل یو نشہٕ نجاتھ یژھان تکیازِ مےٚ اوس شرارتھ۔ مگر فینحاسنؔ رُکووُس بہٕ تہِ کرنہٕ نشہٕ۔
\v 12 مگر وۅنؠ ؤنیٚو تس زِ بہٕ چُھس تس سٟتؠ اکھ خصوصی امن مہادٕ کران۔
\v 13 اتھ مہادس منٛز چُھس بہٕ تمِس تہٕ تمسنٛدیٚن اولادن کاہن بننُک حق دِنُک وعدہ کران۔ بہٕ چُھس یہ اوٕ مۅکھٕ کران تکیازِ تٔمؠ کۅر یمیُک اظہار زِ سُہ چُھ مےٚ یعنی پننِس خدایس گناہ گٲری ہُنٛد رویہ رُکاوِتھ، عزت دِنس منٛز سیٹھاہ بے تاب، تٔمؠ کٔر اسرائیل کیٚن گُنہن خلاف میانؠ مقدس راستبٲزی تہٕ تہنٛدؠ گناہ معاف کرنہٕ باپتھ میون دِل آمادٕ۔
\p
\v 14 اسرائیل لُک سُہ فرد یُس موآبؔ قبیلچہِ زنہِ سٟتؠ مارنہٕ آو اوس سالؔو سُنٛد نیٚچو زُمریؔ یُس شمعون قبیلکہِ اکہ خاندانُک سردار اوس۔
\v 15 تمِس زنہِ ہُنٛد ناو اوس کزبیؔ۔ سۅ ٲس صُورؔ سنٛز کور یُس مِدیان قبیلکہِ اکہِ ونڈُک سردار اوس۔
\p
\v 16 یہُوواہنؔ ووٚن موسیٰؔ ہس مذید،
\v 17 "پنٕنؠ نفر ہیٚتھ نیر تہٕ مِدیان کیٚن لوٗکن پٮ۪ٹھ حملہٕ کرِتھ مارُکھ تِمہ۔
\v 18 مدیٲنؠ بنیاے چٲنؠ دشمن تکیازِ تِمو کۅر بنی اسرائیل کیٚن لوٗکن ژھل تہٕ تِمو منٛزٕ کٔرِکھ واریاہ بعلؔ سنٛز پوٗزاکرنس پٮ۪ٹھ آمادٕ، اوے کِنؠ شونٛگ چون اکھ نفر کزبیؔ نِش یۅسہ مدیان قبیلہٕ کِس اکِس سردار سنٛز کور ٲس۔ سۅ آیہ تمہِ وزِ مارنہٕ ییٚلہ وباہ شروع گو تِمن لوٗکن ہنٛدیٚو گُنہو سببہٕ یمو پیٚورؔ کوہَس پٮ۪ٹھ گناہ کٔرؠ۔"
\c 26
\p
\v 1 یہُوواہنؔ ووٚن وبا ختم سپدِتھ الِیعزرؔس تہٕ موسیٰؔ ہس،
\v 2 "تمام اسرائیلی لوٗکن کٔریٚو بیٚیہِ گرینٛد۔ تِمن سارنےٕ مردن ہنٛدؠ ناو لیکھیٚو تہنٛدیٚو خاندٲنی ناوو سان یہنٛز وانٛس کمس کم وُوہہ وری اسہِ، یم جنٛگ کرنس قٲبل آسن۔
\p
\v 3 ییٚلہ بنی اسرائیلی موآبؔ کیٚن مٲدانن منٛز یردن کِس بٹھِس پٮ۪ٹھ یریحو اپارِ ٲسؠ، الِیعزرؔ تہٕ موسیٰؔ ہن ووٚن اسرائیل کیٚن رہنماہن،
\v 4 "تمام اسرائیلی مردن ہنٛدؠ ناو لیٚکھیٚو یمن ہنٛز وانٛس کمس کم وُہہ وری آسہ، یتھٕ کنؠ زن اسہِ یہُوواہنؔ حکم کۅر موسیٰؔ ہس تہٕ اسرائیل کٮ۪ن بچن۔"
\p چناچہِ تِمو کۅر تی تہٕ یہ چُھ یعقوبؔ سنٛدین تمام اولادن ہُنٛد رِکارڈ یمہ مِصرٕ منٛزٕ نیرتھ ونیُک تام زنٛدٕ چھِ۔
\v 5‏-7 یعقوبؔ سنٛدِس ساروےٕ کھۅتہٕ بڈِس نیٚچوؠ روبنؔ سنٛدؠ اولاد ٲسؠ یِم:
\li حنوکیؔ ٲسؠ تمسنٛدِس نیٚچوؠ حنوک سنٛدؠ اولاد،
\li فلوئیؔ ٲسؠ تمسنٛدِس نیٚچوؠ فلُوؔ سنٛدؠ اولاد،
\li حصرونیؔ ٲسؠ تمسنٛدِس نیٚچوؠ حصرونؔ سنٛدؠ اولاد،
\li کرمیؔ ٲسؠ تمسنٛدِس نیٚچوؠ کرمیؔ سنٛدؠ اولاد۔
\pi اسرائیلی قٲعِدو گنٛزرٲوؠ روبنؔ سنٛدِ قبیلہٕ منٛزکؠ تیہِ تٲجی ساس ستتھ ہتھ ترٕ نفر۔
\v 8 فلُوؔ سُنٛد نیٚچو اوس الیابؔ
\v 9 تہٕ تمسنٛدؠ زُر ٲسؠ نمُوایلؔ، داتن تہٕ ابیرامؔ۔ داتنؔ تہٕ ابیرامؔ ٲسؠ تِم زٕ رہنما یمو قورحؔ ہس سٟتؠ رٔلِتھ ہارونؔس تہٕ موسیٰؔ ہس خلاف سٲزِش کٔر تہٕ یہُوواہسؔ خلاف کٔرکھ بغاوت۔
\p
\v 10 مگر زمینہِ سپُد چاہ تہٕ نین تِم تہٕ قورحؔ نینٛگلِتھ۔ یہُوواہنؔ سوز نار اکھ نار یمؠ 250 نفر زٲلِتھ نی یمو یمن تریٚن نفرن مدد کۅر۔ یہ اوس سارنی اسرائیلی لوٗکن ژینہٕ ون زِ تِم کرن تِمن رہنماہن احترام یمہ یہُوواہنؔ مقرر کٔرؠ مٕتؠ ٲسؠ۔
\v 11 مگر قورحؔ سنٛدؠ اولاد مودؠ نہٕ امہِ دوٚہہ۔
\v 12‏-14 شمعون سنٛدؠ اولاد ٲسؠ یِم:
\li نمُوایلؔ ٲسؠ تمسنٛدِس نیٚچوؠ نمُوایلؔ سنٛدؠ اولاد،
\li یمِنیؔ ٲسؠ تمسنٛدِس نیٚچوؠ یمینؔ سنٛدؠ اولاد،
\li یکینیؔ ٲسؠ تمسنٛدِس نیٚچوؠ یکینؔ سنٛدؠ اولاد،
\li زارِحیؔ ٲسؠ تمسنٛدِس نیٚچوؠ زارَح سنٛدؠ اولاد،
\li ساوُلیؔ ٲسؠ تمسنٛدِس نیٚچوؠ ساوُلؔ سنٛدؠ اولاد۔
\pi اسرائیلی قٲعِدو گنٛزرٲوؠ شمعونؔ سنٛدِ قبیلہٕ منٛزکؠ زٕ توٗووہ ساس زٕ ہتھ نفر۔
\v 15‏-18 یِم ٲسؠ جدؔ سنٛدیو اولادو منٛزٕ:
\li صفونیؔ ٲسؠ تمسنٛدِس نیٚچوؠ صفونؔ سنٛدؠ اولاد،
\li حجّوی ٲسؠ تمسنٛدِس نیٚچوؠ حجیؔ سنٛدؠ اولاد،
\li سُونویؔ ٲسؠ تمسنٛدِس نیٚچوؠ سونیؔ سنٛدؠ اولاد،
\li اُزنویؔ ٲسؠ تمسنٛدِس نیٚچوؠ اُزنیؔ سنٛدؠ اولاد،
\li عیرویؔ ٲسؠ تمسنٛدِس نیٚچوؠ عیریؔ سنٛدؠ اولاد،
\li اُردویؔ ٲسؠ تمسنٛدِس نیٚچوؠ اُرودؔ سنٛدؠ اولاد،
\li اریلویؔ ٲسؠ تمسنٛدِس نیٚچوؠ اریلیؔ سنٛدؠ اولاد۔
\pi اسرائیلی قٲعِدو گنٛزرٲوؠ جد سنٛدِ قبیلٕکؠ کُل نفر ژتجی ساس پانٛژھ ہتھ۔
\li
\v 19‏-22 یہُوداہؔ سنٛدؠ گۅبر عیرؔ تہٕ اونانؔ گذریاے کنعانس منٛزےٕ، تِمن کانٛہہ اولاد عطا سپدن برُونٛٹھےٕ۔ یہُوواہؔ سنٛدیو باقی اولادو منٛزٕ چھِ یم:\f + \fr 26‏:19‏-22 \ft پیدایش 38:3-4 تہٕ 7-10\f*
\li سیلانیؔ ٲسؠ تمسنٛدِس نیٚچوؠ سیلہؔ سنٛدؠ اولاد،
\li فارصیؔ ٲسؠ تمسنٛدِس نیٚچوؠ فارصؔ سنٛدؠ اولاد،
\li زارہیؔ ٲسؠ تمسنٛدِس نیٚچوؠ زارحؔ سنٛدؠ اولاد،
\pi پیریز اوس حصرونؔ تہٕ حمول سُنٛد مول۔
\li حصرونیؔ ٲسؠ حصرونؔ سنٛدؠ،
\li تہٕ حمُولیؔ ٲسؠ حمول سنٛدؠ۔
\pi یہُوواہؔ سنٛدِ قبیلٕکؠ ٲسؠ شوٗ ساتتھ ساس پانٛژھ ہت نفر، یِم اسرائیلی قٲعِدو گنٛزرٲوؠ۔
\pi
\v 23‏-25 اشکارؔ سنٛدؠ اولاد چھِ یِم:
\li تولعویؔ ٲسؠ تمسنٛدِس نیٚچوؠ تولؔعہ سنٛدؠ اولاد،
\li فوّہیؔ ٲسؠ تمسنٛدِس نیٚچوؠ فووہؔ سنٛدؠ اولاد،
\li یسُوبیؔ ٲسؠ تمسنٛدِس نیٚچوؠ یسُوب سیلہؔ سنٛدؠ اولاد،
\li سِمرونیؔ ٲسؠ تمسنٛدِس نیٚچوؠ سمرون سنٛدؠ اولاد،
\pi اسرائیلی قٲعِدو گنٛزرٲوؠ اِشکار سنٛدِ قبیلٕکؠ ژُہٲٹھ ساس ترےٚ ہتھ نفر۔
\pi
\v 26‏-27 زبولونؔ سنٛدؠ اولاد ٲسؠ یِم:
\li سردیؔ ٲسؠ تمسنٛدِس نیٚچوؠ سردؔ سنٛدؠ اولاد،
\li ایلوُنیؔ ٲسؠ تمسنٛدِس نیٚچوؠ ایلُونؔ سنٛدؠ اولاد،
\li پَہلی ایلویؔ ٲسؠ تمسنٛدِس نیٚچوؠ یَحلی ایلؔ سنٛدؠ اولاد،
\pi اسرائیلی قٲعِدو گنٛزرٲوؠ زبولُونؔ سنٛدِ قبیلٕکؠ شیٹھ ساس پانٛژھ ہتھ نفر۔
\v 28‏-29 منسیؔ تہٕ افرائیمؔ ٲسؠ یوسف سنٛدؠ اولاد، تہٕ منسیؔ سنٛدؠ اولاد ٲسؠ یِم:
\li مکِیریؔ ٲسؠ تمسنٛدِس نیٚچوؠ مکِیرؔ سنٛدؠ اولاد۔
\li مکِیر اوس جلعادؔ سُنٛد مول۔
\li جلعادیؔ ٲسؠ جلعادؔ سنٛدؠ اولاد۔
\pi
\v 30‏-32 یِم ٲسؠ جلعادؔ سنٛدؠ اولاد:
\li ایعزاریؔ ٲسؠ تمسنٛدِس نیٚچوؠ ایعزرؔ سنٛدؠ اولاد،
\li خلقیؔ ٲسؠ تمسنٛدِس نیٚچوؠ خلقؔ سنٛدؠ اولاد،
\li اسیری ایلویؔ ٲسؠ تمسنٛدِس نیٚچوؠ اسیری ایلؔ سنٛدؠ اولاد،
\li سِکمیؔ ٲسؠ تمسنٛدِس نیٚچوؠ سِکمؔ سنٛدؠ اولاد،
\li سمِیدعیؔ ٲسؠ تمسنٛدِس نیٚچوؠ سمِیدع سنٛدؠ اولاد،
\li حفرِوی ٲسؠ تمسنٛدِس نیٚچوؠ حفرؔ سنٛدؠ اولاد،
\pi
\v 33‏-34 حفرؔ سنٛدِس نیٚچوِس صِلافحادس اوس نہٕ کانٛہہ نیٚچو البتہٕ آسس پانٛژھ کورِ، تہٕ تِمن پانٛژن کوریٚن ہنٛدؠ ناو چھِ، محلاہؔ، نُوعاہ، حُجلاہ، مِلکاہؔ تہٕ تِرضاہ۔
\pi بنی اسرائیل کیٚو سردارو گنٛزرٲوؠ منسیؔ قبیلٕکؠ دوٗونزاہ ساس ستتھ ہتھ نفر، یمہٕ یوسفؔ سنٛزِ زُرؠ یٲژ منٛزٕ ٲسؠ۔
\p
\v 35‏-37 افرائیمؔ سنٛدؠ اولاد ٲسؠ یِم:
\li سُوتلحیؔ ٲسؠ تمسنٛدِس نیٚچوؠ سُوتلحؔ سنٛدؠ اولاد،
\li بکریؔ ٲسؠ تمسنٛدِس نیٚچوؠ بکرؔ سنٛدؠ اولاد،
\li تحنویؔ ٲسؠ تمسنٛدِس نیٚچوؠ تحنؔ سنٛدؠ اولاد،
\li سُوتلحؔ سنٛدؠ اولاد ٲسؠ یِم:
\li عیرانیؔ ٲسؠ تمسنٛدِس نیٚچوؠ عیران سنٛدؠ اولاد،
\pi اسرائیلی قٲعِدو گنٛزرٲوؠ افرائیمؔ سنٛدِ قبیلٕکؠ دویہِ ترٕ ساس پانٛژھ ہتھ نفر۔ سُہ اوس یوسفؔن بیاکھ فرزنٛد۔
\pi
\v 38‏-41 بنیمِینؔ سنٛدؠ اولاد چھِ یِم:
\li بلعَی ٲسؠ تمسنٛدِس نیٚچوؠ بلعؔ سنٛدؠ اولاد،
\li اشبیلیؔ ٲسؠ تمسنٛدِس نیٚچوؠ اشبیل سنٛدؠ اولاد،
\li آخِیرامیؔ ٲسؠ تمسنٛدِس نیٚچوؠ آخِیرامؔ سنٛدؠ اولاد،
\li سُوفامیؔ ٲسؠ تمسنٛدِس نیٚچوؠ سُوفامؔ سنٛدؠ اولاد،
\li حُوفامیؔ ٲسؠ تمسنٛدِس نیٚچوؠ حُوفامؔ سنٛدؠ اولاد۔
\pi اَردؔ تہٕ نعمانؔ ٲسؠ بلعؔ سنٛدؠ اولاد۔
\li اَردیؔ ٲسؠ تمسنٛدِس نیٚچوؠ اَردؔ سنٛدؠ اولاد۔
\li نعمانیؔ ٲسؠ تمسنٛدِس نیٚچوؠ نعمانؔ سنٛدؠ اولاد۔
\pi اسرائیلی قٲعِدو گنٛزرٲوؠ بنیمِینؔ سنٛدِ قبیلٕکؠ پنٛژتٲجی ساس شےٚ ہتھ نفر۔
\pi
\v 42‏-43 دانؔ سنٛدؠ اولاد ٲسؠ یِم:
\li سُوحامیؔ ٲسؠ تمسنٛدِس نیٚچوؠ سُوحامؔ سنٛدؠ اولاد۔
\li اَردیؔ ٲسؠ تمسنٛدِس نیٚچوؠ اَردؔ سنٛدؠ اولاد۔
\pi اسرائیلی قٲعِدو گنٛزرٲوؠ ژُہٲٹھ ساس ژور ہتھ نفر یم دان قبیلہٕ منٛزٕ ٲسؠ۔
\v 44‏-47 تہٕ آشرؔ سنٛدؠ اولاد ٲسؠ یِم:
\li یمِنیؔ ٲسؠ تمسنٛدِس نیٚچوؠ یِمنہؔ سنٛدؠ اولا،
\li اِسوہیؔ ٲسؠ تمسنٛدِس نیٚچوؠ اِسویؔ سنٛدؠ اولاد،
\li برِیعاہیؔ ٲسؠ تمسنٛدِس نیٚچوؠ برِیعاہؔ سنٛدؠ اولاد،
\pi برِیعاہؔ ہس ٲسؠ زٕ اولاد، حبرؔ تہٕ ملکی ایلؔ۔
\li حِبریؔ ٲسؠ تمسنٛدِس نیٚچوؠ احبرؔ سنٛدؠ اولاد۔
\li ملکی ایلیؔ ٲسؠ تمسنٛدِس نیٚچوؠ ملکی ایلؔ سنٛدؠ اولاد۔
\li آشرسؔ ٲس اکھ کور تہِ یمِس سِرہؔ ناو اوس۔
\pi اسرائیلی قٲعِدو گنٛزرٲوؠ تروونزاہ ساس ژور ہتھ نفر یم آشرؔ قبیلہٕ منٛزٕ ٲسؠ۔
\pi
\v 48‏-50 نفتالیؔ قبیلٕکؠ اولاد ٲسؠ یِم:
\li یحصی ایلؔی ٲسؠ تمسنٛدِس نیٚچوؠ یحصی ایلؔ سنٛدؠ اولاد،
\li جونویؔ ٲسؠ تمسنٛدِس نیٚچوؠ جونیؔ سنٛدؠ اولاد،
\li یصریؔ ٲسؠ تمسنٛدِس نیٚچوؠ یِصریؔ سنٛدؠ اولاد،
\li سلیمیؔ ٲسؠ تمسنٛدِس نیٚچوؠ سِلیمؔ سنٛدؠ اولاد۔
\pi اسرائیلی قٲعِدو گنٛزرٲوؠ نفتالیؔ قبیلہٕ منٛزٕ پنٛژتٲجی ساس ژور ہتھ نفر۔
\pi
\v 51 اسرائیل یو منٛزٕ یمہٕ نفر کُلہم پٲٹھؠ قٲعِدو گنٛزراوؠ تِہُنٛد کُل تعداد اوس شےٚ لچھ اکھ ساس ستتھ ہتھ ترٕ۔
\p
\v 52 پتہٕ ووٚن یہُوواہنؔ موسیٰؔ ہس،
\v 53 "کنعإچ زمین دِ قبیلن منٛز بٲگرِتھ۔ تُہنٛدِس فہرستس منٛز درٕج پرٛتھ قبیلکہِ نفر شُمٲری مطٲبق کر زمین تقسیم۔
\p
\v 54‏-56 چیرِ ترٲوِتھ کٔریٚو فٲصلہ زِ کۅسہٕ جماتھ کمہِ انٛدٕ رٹہِ پنُن حصہٕ، مگر ساروےٕ کھۅتہ بٔڈؠ انٛد ترٲیو تِمن یمن زیادٕ بٲژ آسن۔"
\p
\v 57 قٲعِدو گنٛزرٲوؠ لاوینؔ ہنٛدؠ مرٕد اولاد تہِ۔ تِم ٲسؠ جیرسونؔ، قہات تہٕ مراری قبیلو منٛزٕ۔
\v 58 یمن منٛز لبنیؔ، حبرون، محلی، موشیؔ، تہٕ قورحؔ قبیلٕکؠ نفر تہِ شٲمل ٲسؠ۔ یِم سٲری ٲسؠ لاوی قبیلو منٛزٕ۔ قہاتؔ ٲسؠ عمرامؔ سنٛدؠ جدٕ اجداد،
\v 59 یمسنٛز خاندارِنؠ یوکبدؔ ٲس۔ سۅتہٕ ٲس لاوی خاندانچی، مگر سۅ ٲس مِصرس منٛز زاممژ۔ تمِس ٲسؠ عمرامسؔ نِشہ زٕ لڑکہٕ ہارونؔ تہٕ موسیٰؔ تہٕ تہنٛز بٔڈ بیٚنہِ مریمؔ۔
\v 60 ہارونؔ سنٛدؠ نیٚچوؠ ٲسؠ ندبؔ، ابیہوؔ، الِیعزرؔ، تہٕ اِتمر۔
\v 61 مگر تِمو منٛزٕ مودؠ ندبؔ تہٕ ابیہوؔ تمہِ وزِ ییٚلہ تِمو تِتھٕ پٲٹھؠ یہُوواہؔ سنٛزِ قربٲنی باپتھ بخور زاجاو یمہِ سٟتؠ یہُوواہؔ سنٛدِ حکمٕچ نافرمٲنی سپٕز۔\f + \fr 26‏:61 \ft احبار 10:1-7\f*
\p
\v 62 قٲعِدو گنٛزرٲوؠ لاوی قبیلٕکؠ ترووہ ساس نفر یہنٛز عمر یِم لگ بگ وٲرشِنؠ ٲسؠ۔ مگر ییٚلہ باقی اسرائیل ین گرینٛد کٔرکھ تِم آے نہٕ گرینٛز منٛز تھاونہٕ، تکیازِ تمہِ وزِ آیہ نہٕ تِمن کانٛہہ تہِ زمین دِنہٕ۔
\p
\v 63 یمہٕ ٲسؠ تِم نفر یمہٕ الِیعزرؔ تہٕ موسیٰؔ ہن گنٛزرٲمٕتؠ ٲسؠ۔ تِمو کٔر دریاوٕ اپارِ یردنس مشرقہٕ طرفہٕ موآبؔ کیٚن مٲدانن منٛز اسرائیلی لوٗکن ہنٛز گرینٛد۔
\v 64 یمہٕ نفر تِمو شمار کٔرؠ تِمو منٛزٕ اوس نہ کانٛہہ تہِ تتھ فہرِستس منٛز یُس ہاروننؔ تہٕ موسیٰؔ ہن سیناؔ کیٚن صحراون منٛز بنی اسرائیل ین ہُنٛد بنومُت اوس۔
\v 65 تِمن آو تہِ وننہٕ یہ یہُوواہنؔ وۅنمُت اوس۔\f + \fr 26‏:65 \ft گرینٛد: 14:29-35:\f* تٔمؠ ووٚن، "تِم سٲری نافرمان اسرائیلی مرن تتھ صحراوس منٛز۔ "تہٕ تی سپُد تہِ۔ صرف ٲسؠ کینٛہہ یمہٕ ونیُک تام زنٛدٕ ٲسؠ، یمن منٛز یفُنہؔ سُنٛد نیٚچو کالِب تہٕ نُون سُنٛد نیٚچو یسوعؔ اوس۔
\c 27
\p
\v 1 اکہ دوٚہہ آیہ صِلافحادؔ سنٛزٕ پانٛژھ کورِ موسیٰؔ ہس نِش۔ تِمہ آسہ محلاہؔ، نُوعاہؔ، حُجلاہ، مِلکاہؔ تہٕ تِرضاہ۔
\v 2 تِمہ آیہ مقدس خٟمہ کِس دروازس پٮ۪ٹھ تہٕ روزٕ الِیعزرؔ، موسیٰؔ، قبٲئیلی سردارن، تہٕ باقی اسرائیلی لوٗکن برُونٛہہ کنہِ کھڑا۔
\v 3 تِمو ووٚن زِ سون مول گُذریاو تمہِ وقتہٕ ییٚلہ أسؠ بیابانن منٛز ٲسؠ تہٕ تمِس اوس نہٕ کانٛہہ لٔڑکہٕ۔ مگر سُہ اوس نہٕ تمن لوٗکن منٛز شٲمل یمو قورحؔ سنٛز حمایت کٔر، یمو یہُوواہسؔ خلاف بغاوت کٔر، تہٕ سُہ گُذریاو پننیوےٕ گُنہو سببہٕ۔ تمِس اوس نہٕ کانٛہہ لٔڑکہ۔
\v 4 تمسنٛدِ قبیلُک ناو کیازِ مۅکلہِ؟ تکیازِ سٲنِس مٲلِس اوس نہٕ کانٛہہ نیٚچو؟ لہٰذا کٔرِتھ دِیو اسہِ تہِ کینٛہہ زمین یتھٕ پٲٹھؠ سٲنِس مٲلؠ سنٛدین رشتہٕ دارن میلہِ!
\p
\v 5 اوٕ کِنؠ پرُژھ موسیٰؔ ہن یہُوواہسؔ زِ امسنٛدِس ماملس منٛز کیاہ پزِ کرُن۔
\v 6 تہٕ یہُوواہنؔ وون موسیٰؔ ہس،
\v 7 "صِلافحادؔ سنٛزٕ کورِ یہ منٛگان چھےٚ تہِ چُھ صحی۔ توٚہہِ پزِ تِمن تہِ کینٛہہ زمین دِنؠ، یتھٕ کنؠ توٚہؠ تہنٛدِس مٲلؠ سنٛدین رشتہٕ دارن دِوان چُھو۔ تِمن سارنی دِیو تمہ منٛزٕ کینٛہہ زمین یۅسہ تہنٛدین باین دنہٕ چھےٚ آمٕژ اگر تِمن نشہٕ چھےٚ۔
\p
\v 8 یہ ؤنیٚو اسرائیلی لوٗکن تہِ زِ اگر کانٛہہ فرد مرِ یس نہٕ نیٚچو آسہ تہٕ تم چیز دِیو تمؠ سنٛزن کوریٚن یِم تمسنٛدین نیٚچوٮ۪ن وراثتس منٛز میلہٕ ہن۔
\v 9 اگر نہٕ کانٛسہِ فردس نہ نیٚچوؠ آسن یا کورِ تہٕ تِم چیز دِیو تمسنٛدین باین یِم تمسنٛدین نیٚچوٮ۪ن یا کوریٚن وراثتس منٛز میلہٕ ہن۔
\v 10 اگر نہٕ تمِس فردس کانٛہہ بوے تہِ آسہ تہٕ سۅ وراثت ترِ تمسنٛدِس پِترس یۅسہ تمسنٛدین نیٚچوٮ۪ن یا کورین ترِہے۔
\v 11 اگر نہٕ تمس فردس کانٛہہ پِتٕر تہِ آسہ تیٚلہ دِیو تمسنٛدین قریبی رشتہٕ دارن تمہٕ چیز یمہ تمِس میراثس منٛز آسن۔ یِم قوٲعِد آسن اسرائیلی لوٗکن باپتھ، تکیازِ بہٕ چُھسے ژےٚ یہ حکم دِوان، موسیٰؔ، ژٕ وَن تِمن۔"
\p
\v 12 اکہِ دوٚہہ ووٚن یہُوواہنؔ موسیٰؔ ہس، "ژٕ کھس دریاے یردن کِس مشرقس منٛز عباریم بالہٕ تینٛتٲلِس پٮ۪ٹھ۔ پتہٕ وچُھن سُہ ملک یُس مےٚ اسرائیلی لوٗکن دیُن چُھ۔
\v 13 یتُھےٕ ژٕ سُہ وُچھہن تہٕ ژتہِ مرکھ تِتھے پٲٹھؠ یتھٕ پٲٹھؠ چون بوٚڈ بوے ہارونؔ گُذریو۔
\v 14 ژٕ مرکھ اوٕ موٚکھٕ تہٕ اتھ ملکس منٛز سپدکھ نہٕ دٲخل تکیازِ توٚہہِ دوٚنویو کٔرو صِینؔ کیٚن بیابانن منٛز میانیٚن فرمانن ہنٛز نافرمٲنی۔ ییٚلہ اسرائیل کیٚو لوٗکو قادِسؔ قصبس نکھٕ مریبہؔ ہس نِش میانؠ بغاوتھ کٔر تہٕ مےٚ وُنمو توٚہہِ زِ کنہِ ؤنیٚو سۅ دییہ توٚہہِ آب۔ مگر توٚہہِ دِتیٚو تتھ وننہٕ بجایہ چوب، توٚہہ کٔرو نہٕ لوٗکن برُونٛہہ کنہِ میٚانہِ مقدس طاقتٕچ باوتھ۔"\f + \fr 27‏:14 \ft گرینٛد 20:2-13\f*
\p
\v 15 پتہٕ مونٛگ موسیٰؔ ہن یہُوواہسؔ دعا،
\v 16 "اے یہُوواہؔ، ژٕ چُھکھ سُہ خدا یُس تمام لوٗکن ہنٛدین روحن ہِدایت دِوان چُھ۔ مہربٲنی کٔرِتھ کرتن اسرائیلی لوٗکن باپتھ کانٛہہ نُوو رہنماہ قٲیم۔\f + \fr 27‏:16 \ft عبر: 12:9\f*
\v 17 کانٛہہ تیٚوتھ شخص کرُن مقرر یُس چانیٚن لوٗکن ہنٛز رہنمائی کرِ ییٚلہ تِم جنٛگس نیرن یُتھ نہٕ تِم تِمن تیٖرن ہنٛدؠ پٲٹھؠ اورٕ یور پھیرن یمن نہٕ کانٛہہ پہُل آسہ۔"\f + \fr 27‏:17 \ft متی: 9:36، مرقُس 6:34 \f*
\p
\v 18 یہُوواہنؔ ووٚن موسیٰؔ ہس در جوابِ، "نونؔ سُنٛد نیٚچو یسوعؔ رٹُن یس منٛز میٚون روحٲنی طاقت چُھ۔ سُہ مقرر کرنہٕ خٲطرٕ تھاو تس پنُن اتھٕ پٮ۪ٹھ۔
\v 19 تس ون کاہن الِیعزرؔس برُونٛہہ کنہِ کھڑا گژُھن یُتھ زن سٲری لوٗکھ وچُھن تہٕ تس دِیو اسرائیلی قومُک نوو رہنما بننُک حکم۔
\p
\v 20 تمِس دِیو کینٛہہ اختیار یم توٚہہ حٲصل چھِ تاکہ سٲری اسرائیلی لوٗکھ زانن زِ تِمن پزِ تمؠ سنٛز عبادت کرنؠ۔
\v 21 ییٚلہ توٚہہ سارنی میانہ رہنمائی ہنٛز ضرورت باسیٚو تہٕ یسوعؔ سپدِ الِیعزرؔس برُونٛہہ کنہِ کھڑا۔ پتہٕ کرِ الِیعزرؔ چیٖرِ ترٲو، تھ یہ طے زِ تِمن کیاہ پزِ کرُن۔ یسوعؔ سنٛدِس حکمس پٮ۪ٹھ سپدن اسرائیل لٕکؠ تمام لوٗکھ یکجا۔
\v 22 لہٰذا کۅر موسیٰؔ ہن تی یہ یہُوواہنؔ تمِس حکم کۅر۔ تٔمؠ کۅر یسوعؔ الِیعزرؔس تہٕ تمام اسرائیلی لوٗکن برُونٛہہ کُن پیش۔
\v 23 موسیٰؔ ہن تھوو پنُن اتھٕ تمِس پٮ۪ٹھ تہٕ دیُتنس سۅ کٲم کرنُک حکم یوسہٕ یہُوواہنؔ موسیٰؔ ہس تمِس وننہٕ خٲطرٕ ونمُت اوس۔
\c 28
\p
\v 1 یہُوواہنؔ ووٚن موسیٰؔ ہس مذید،
\v 2 "اسرائیلی لوٗکن وَن، مےٚ نِش أنیٚو تِم قربٲنیہ یِم قربان گاہس پٮ۪ٹھ زالنہٕ یِن۔ ییٚلہ تِم بُزنہٕ ین تہٕ سۅ مُشٕک گژھِ مےٚ خوش۔ تہٕ تِمن ؤنیٚو زِ تِم انن تِمن منٲسب وقتس پٮ۪ٹھ۔
\v 3 تِمن ؤنیٚو زِ یہ کینٛژھا تِم پرٛتھ دوٚہہ میانہ باپتھ انن تتھ منٛز گژھن وٲرشِنؠ زٕ کٹہٕ بچہ آسٕنؠ۔ تِمن گژھِ نہٕ کانٛہہ عٲب آسُن۔ تِم گژھن پوٗرٕ پٲٹھؠ قربان گاہس پٮ۪ٹھ بُزنہٕ یِنؠ۔
\v 4 اکھ انن تِم صُبحٲے تہٕ بیاکھ انن شامس۔
\v 5 تِم انن زٲیل پیسمٕتؠ ٲٹیٚس زٕ سیر یمہٕ زیتون تیٖلہٕ کِس أکِس لیٹرس سٟتؠ رلٲوِتھ آسن۔
\v 6 یہ چُھ سُہ نذرانہٕ یُس تِم پرٛتھ دوٚہہ انٕنؠ گژھن۔ تِمو کٔرؠ تمہ نذرانہٕ تمہِ وزِ انٕنؠ شروع ییٚلہ توٚہؠ کوہہِ سینا ہَس پٮ۪ٹھ ٲسیٚو۔ ییٚلہ تمہٕ قربٲنیہ قربان گاہس بُزنہٕ ین تہٕ تہنٛز خوشبو ییہِ مےٚ سیٹھاہ پسنٛد۔
\v 7 ییٚلہِ تِم اکھ برٕ بُزان آسن تہٕ تِمن پزِ تمہِ وزِ اکھ لیٹر مےَ تہِ مقدس جایہ مقدس قربان گاہس پٮ۪ٹھ تراوُن۔
\v 8 شامس ییٚلہ تِم بیاکھ برٕ پیش کرن تہٕ تِمن پزِ مےَ تہٕ آٹِچ سۅے قربٲنی انٕنؠ یۅسہ تِم صبحٲے بُزان آسن۔ ییٚلہ تمہٕ بُزنہٕ یوان آسن تہٕ تمہٕ تمِچ مُشِک تہِ آسہ مےٚ سیٹھاہ خوش کران۔
\v 9 پرٛتھ سبت کہ دوٚہہ پٮ۪ن توٚہہ زٕ کٹہٕ برٕ یمو منٛزٕ ہر کانٛہہ وٲرشُن آسہ، تہٕ عٲبہ بغٲر آسن، تتھ سٟتؠ زیتون تیلس سٟتؠ رلاوِتھ زٕ کِلو زٲویُل اوٹ تہٕ ساڑ ژور لیٹر مےَ نذرانہٕ کرٕنؠ۔
\v 10 یمہٕ چھےٚ تمہٕ قربٲنیہ یمہ پرٛتھ سبت کہ دوٚہہ قربان گاہس پٮ۪ٹھ بُزنہِ چھےٚ۔ یمہٕ زٕ کٹہٕ برٕ تہٕ شراب آسہ تمہِ نذرانہٕ علاوٕ یُس توٚہؠ پرٛتھ دوٚہہ پیش کران ٲسیٚو۔
\v 11 پرٛتھ ریتہٕ کہ گۅڈنکہِ دوٚہہ چُھو توٚہہ زٕ ہکھر ؤژھؠ، اکھ کٹھ تہٕ وٲرشِنؠ ستتھ برٕ قربان کرٕنؠ۔ یم سٲری گژھن کُنہِ عٲبہ بغٲر آسٕنؠ۔ یِم سٲری گژھن قربان گاہس پٮ۪ٹھ پوٗرٕ پٲٹھؠ بُزنہٕ یِنؠ۔
\v 12 تہٕ پرٛتھ کٲنسہِ قربان ہکھرس سٟتؠ گژھِ ستتھ کلو بٲریک پیسمُت اوٹ زیتون تیٖلس سٟتؠ رلاوِتھ پیش یُن کرنہٕ۔ پرٮ۪تھ کٲنٛسہِ کٹس سٟتؠ گژھِ زیتون تیٖلس سٟتؠ رلاوِتھ ژور کِلو زَبر اوٹ نذر کرنہٕ یُن۔
\v 13 تہٕ پرٛتھ کٹہٕ برس سٟتؠ گژھِ زیتون تیٖل رلاوِتھ اکھ کلو زٲیل اوٹ پیش کرنہٕ یُن۔ ییٚلہ یہ سورےٕ قربان گاہس پٮ۪ٹھ زالنہٕ ییہِ تہٕ امِچ خوش بو باسہِ مےٚ سیٹھہےٕ زبر۔
\p
\v 14 پرٛتھ ہکھر ؤژھِس سٟتؠ گژھِ زٕ لیٹر مےَ تہِ انُن۔ ہر کانٛسہ کٹَس سٟتؠ گژھِ پانٛژھ پاوٕ مےَ اننہٕ یُن۔ ہر کانٛسہ کٹہٕ برس سٟتؠ گژھِ اکھ لیٹر مےَ انُن۔ یمہٕ قربٲنیہ گژھن پرٛتھ ریٚتکہِ گۅڈنِکہ تٲریخہ اننہِ تہٕ قربان گاہس پٮ۪ٹھ پوٗرٕ پٲٹھؠ بُزنہِ۔
\v 15 یمو قربٲنیٚو علاوٕ یمہ توٚہؠ بُزان چھوکھ چُھو توٚہہِ قربٲنی باپتھ مےٚ نِش اکھ ژھاوج تہِ انُن یُتھ تُہنٛدؠ سپدٕؠ مٕتؠ گناہ دوٗر ین کرنہٕ۔
\p
\v 16 پرٛتھ ؤرؠ یکہٕ گۅڈنِکہ ریٚتہٕ آسہ ژۅدٲہمہِ تٲریخہ میانس اعزازس منٛز فسح عید مناونہٕ یوان
\v 17 خمبیرِ بغٲر ژۅچہٕ ہنٛز عید آسہ دویمہِ دوٚہہ شروع سپدان۔ تہٕ مذید ستن دوٚہُن یۅسہ توٚہؠ ژۅٹ کھیٚوان ٲسیٚو سۅ گژھِ خمبیرِ بغٲر بناونہ یِنؠ۔\f + \fr 28‏:17 \ft مُکاشفہ 23:6\f*
\v 18 یمہِ تہوار کہِ گۅڈنِکہ دوٚہہ آسہ توٚہہِ میانہِ عبادتہٕ باپتھ أکسےٕ جایہ سمُن پیٚوان تہٕ امہِ دوٚہہ کٔریٚو نہٕ توٚہؠ پنٕنؠ سۅ کانٛہہ تہِ کٲم یۅسہ توٚہؠ کران ٲسیٚو۔
\p
\v 19 امہِ دوٚہہ أنیٚو توٚہؠ قربٲنی باپتھ مےٚ نِش زٕ ہکھر ؤژھؠ، اکھ کٹھ تہٕ وٲرشِنؠ ستتھ کٹہٕ برٕ یمہٕ پوٗرٕ پٲٹھؠ بُزنہٕ ینؠ گژھن۔ یمو منٛزٕ گژھِ نہٕ کانٛہہ تہِ نۅقصی آسُن۔
\v 20 یمو منٛزٕ گژھٕ ہر کانٛسہِ ہکھر ؤژھس سٟتؠ قربٲنی باپتھ زیتون تیٖلس سٟتؠ رلٲوِتھ ترےٚ کلو زٲیُل پیسِتھ آٹیُک اناج آسُن۔ ہر کانٛسہِ کٹس سٟتؠ زیتون تیٖلس سٟتؠ رلاوِتھ زٕ کلو زٲویلہِ آٹیُک اناج نذرانہٕ پاتھ۔
\v 21 تہٕ ستو کٹہٕ برو منٛزٕ پرٛتھ کانٛسہِ برس سٟتؠ زیتون تیٖل رلاوِتھ اکھ کلو زٲوِلہ آٹیُک اناج نذر کُرن۔
\v 22 پننٮ۪ن گُنہن ہُنٛد کفارٕ دنہٕ باپتھ أنزیٚون قربٲنی خٲطرٕ اکھ مُونگُر تہِ۔
\v 23 یمو نذرانو علاوٕ یمہ توٚہؠ پرٛتھ دوٚہہ صبحٲے انان چُھو أنیٚو توٚہؠ یمہٕ قربٲنیہ تہِ۔
\v 24 ستن دوٚہُن یُس تہ، اناج توٚہؠ پرٛتھ دوٚہہ قربان گاہس پٮ۪ٹھ بُزان چُھو تمِچ خوشبو روزِ مےٚ مُعطر کران۔ یمو جانورو تہٕ شرابہٕ علاوٕ أنیٚو توٚہؠ قربان گاہس پٮ۪ٹھ سُہ اناج تہِ یُس توٚہؠ تتہِ بُزان چُھو۔
\v 25 تمہِ تہوار کہ ٲخری ستمہِ دوٚہہ پزِ توٚہہ میانؠ عبادت کرنہٕ خٲطرٕ دبارٕ جمع سپدُن تہٕ پنٕنؠ سۅ کام تراوٕنؠ یۅسہ توٚہؠ کران چُھو۔
\v 26 فصل لوننٕکہِ گۅڈنکہِ دوٚہہ ییٚلہ توٚہؠ گۅڈنیُک اناج مےٚ نِش أنیٚو یُس توٚہہِ لونمُت آسہ تہٕ توٚہہ پزِ میانؠ عبادت کرنہٕ باپتھ جمع سپدُن۔ امہِ دوٚہہ پزِ توٚہہ پنٕنؠ دوٚہہ دوشٕچ کٲم ترک کرٕنؠ۔
\v 27 توٚہؠ أنیٚو زٕ ہکھر ؤژھؠ، اکھ کٹھ تہٕ وٲرشِنؠ ستتھ کٹہٕ برٕ۔ ییٚلہ تِم پوٗرٕ پٲٹھؠ قربان گاہس پٮ۪ٹھ بُزنہٕ ین تہٕ تمِچ خوشبو ییہِ مےٚ پسنٛد۔
\v 28 بیٚیہِ أنزیو زیتون تیٖل رلاوِتھ زٲیُل اوٹ تہِ۔ پرٛتھ کانٛسہِ ہکھر ؤژھؠ سنٛدِ باپتھ دوٗن شےٚ سیر تہٕ پرٛتھ کٹس سٟتؠ سۅاد ترےٚ سیر۔
\v 29 پرٮ۪تھ کٹہٕ برس سٟتؠ اکھ کلو رلاوِتھ زٲیُل اوٹ۔
\v 30 پننٮ۪ن گُنہن ہُنٛد کفارٕ دنہٕ باپتھ کٔرؠ زیٚون اکھ ژھاوج تہِ قربان۔
\v 31 یہ قربٲنی تہٕ شرابُک نذرانہٕ آسہ تِمو جانورو تہٕ آٹہِ زٲید یُس توٚہؠ پرٛتھ دوٚہہ قربان گاہس پٮ۪ٹھ زالان چُھو۔ یاد تھاوؠ زیٚو یُس تہِ جانور توٚہؠ قربان کٔرؠ وون تَس گژھنہٕ کانٛہہ عٲب آسُن۔
\c 29
\p
\v 1 پرٛتھ وریہ ستمہِ ریٚتکہِ گۅڈنِکہ دوٚہہ گٔژھؠ زیٚو میانہ عبادتہٕ باپتھ جمع، تہٕ امہ دوٚہہ کٔرؠ زیٚو نہٕ کانٛہہ تہِ کٲم یۅسہ توٚہؠ عام پٲٹھؠ کران چُھو۔ امہ تہوار دوٚہہ بجاون کاہن ضرور پنٕنؠ پوگ شہنائی\f + \fr 29‏:1 \ft عبرانی کلنڈرُک سٔتِم رٮ۪تھ چُھ ستمبرکہِ مٔنٛزمہِ حصہٕ پٮ۪ٹھٕ اکتوبر کِس مٔنٛزمِس حِصس تام۔ یہِ اوس عِبرٲنؠ ؤرؠ یُک ساروٕے کھۅتہٕ مقدس رٮ۪تھ۔ \f*
\p
\v 2 ییٚلہ امہ دوٚہہ قربان گاہس پٮ۪ٹھ سپدن واجنہِ قربٲنیہ پوٗرٕ پٲٹھؠ بُزنہٕ ین تہٕ مےٚ ییہِ تمِچ مُشِک سیٹھاہ پسنٛد۔ یمہٕ جانور توٚہہِ انٕنؠ پزن تمن منٛز آسہ اکھ ہکھر، اکھ کَٹھ تہٕ وٲرشِنؠ ستتھ کٹہٕ برٕ۔ یمن نہٕ کانٛہہ نۅقُص آسہ۔
\p
\v 3 یمن جانورن سٟتؠ أنزیٚو زیتون تیٖل رلاوِتھ زٲولہ آٹِکؠ زٕ کلو نذرانہٕ۔ ہکھرس سٟتؠ دوٗن شےٚ سیر، کٹس سٟتؠ سۅد ترےٚ سیر
\v 4 تہٕ ستن کٹہٕ برن سٟتؠ زٟ زٟ سیر۔
\v 5 پننٮ۪ن گُنہَن ہُنٛد کفارٕ دنہٕ باپتھ کٔرؠ زیٚون اکھ مُونٛگر تہِ نذرانہٕ۔
\p
\v 6 یم سٲری جانور آسن تِمو جانورو نِشہ علاوٕ یم پرٛتھ دوٚہہ صبحٲے تہٕ ہر ریتکہ گۅڈنِکہ تٲریخہ پوٗرٕ پٲٹھؠ بُزنہٕ یوان چھِ۔ مےَ یُک تہٕ آٹیُک نذرانہٕ ییہِ بلکُل تِتھے پٲٹھؠ پیش کرنہٕ یتھ کٔنؠ مےٚ توٚہہِ کرنُک حکم دیُتمُت چُھ۔ ییٚلہ یہ نذرانہٕ بُزنہٕ ییہِ تہٕ امِچ خوشبو ییہِ مےٚ سیٹھاہ پسنٛد۔\f + \fr 29‏:6 \ft احبار 23:26 تا 32\f*
\p
\v 7 پرٛتھ وریہ سٔتمہِ ریتکہِ دہمہِ تٲریخہ گٔژھؠ زیٚو میانہِ عبادتہٕ خٲطرٕ جمع۔ امہِ دوٚہہ نہ کٔرزیٚو کانٛہہ کٲم تہٕ نہ کھیی زیٚو کینٛہہ۔
\v 8 ییٚلہ توٚہؠ امہِ دوٚہہ قربان گاہس پٮ۪ٹھ قربٲنیہ بُزیٚو تہٕ امِچ خوشبو ییہِ مےٚ سیٹھاہ پسنٛد۔ یمہ جانور توٚہہ انٕنؠ پزن، تِمن منٛز آسہ اکھ ہکُھر، اکھ کٹھ تہٕ وٲرشِنؠ ستتھ کٹہٕ برٕ۔ یم نۅقصہٕ ورٲے آسن۔
\p
\v 9 ہکھرس سٟتؠ آسہ زیتون تیٖل رلاوِتھ دوٗن شےٚ سیر اوٹ، کٹس سٟتؠ سۅد ترےٚ سیر۔
\v 10 پرٛتھ کانٛسہِ کٹہٕ برس سٟتؠ زٟ سیر۔
\v 11 پننٮ۪ن گُنہَن ہُنٛد کفارٕ دنہٕ باپتھ کٔرؠ زیٚون اکھ مُونٛگر تہِ نذرانہٕ، تہٕ یِم جانور، اوٹ تہٕ مےَ آسہ تِمو جانورو، مےَ تہٕ آٹہِ علاوٕ یُس توٚہؠ پرٛتھ دوٚہہ قربان گاہس پٮ۪ٹھ مکمل پٲٹھؠ بُزِتھ پیش کران چُھو۔
\v 12 پننہِ ستمہِ ریتکہِ پنٛدہٲمہِ تٲریخہ چُھ توٚہہِ سارنی میانہِ عبادتہٕ باپتھ سمُن۔ امہِ دوٚہہ کٔریو نہٕ توٚہؠ بیٚیہِ کانٛہہ کٲم یۅسہ توٚہؠ عام پٲٹھؠ امہِ دوٚہہ کران چُھو۔ توٚہہ چُھ برابر ستن دوٚہُن یہ جشن مناوُن۔\f + \fr 29‏:12 \ft پناہ گاہن ہُند تہوار\f*
\v 13 ییٚلہ قربان گاہَس پٮ۪ٹھ قربٲنیہِ بُزنہٕ ین تہٕ امِچ خوشبو ییہِ مےٚ پسنٛد۔ یمہ جانور توٚہہِ قربٲنی خٲطرٕ انٕنؠ پزن تِم آسن تُرواہ ہکَھر ؤژھؠ، زٕ کٹھ، تہٕ وٲرشِنؠ ژۅداہ کٹہٕ برٕ۔ یمن جانورن گژھِ نہٕ کانٛہہ تہِ عٲب آسُن۔
\v 14 تُرواہ ہو ہکھرو منٛزٕ گژھِ پرٛتھ أکِس سٟتؠ زیتون تیٖل رلاوِتھ دوٗن شےٚ سیر زٲیُل پیسِتھ اوٹ آسن۔ پرٛتھ کٹَس سٟتؠ سۅاد ترےٚ سیر۔
\v 15 ژۅدہو کٹہٕ برو منٛزٕ ہر اکِس سٟتؠ زٟ زٟ سیر۔
\v 16 تہٕ پنٕنؠ گناہ چھلنہٕ باپتھ گژھِ اکِس مُونگرٕ سنٛز قربانی تہِ دِنؠ یہ آسہ تِمو جانورو، آٹہِ تہٕ مےَ علاوٕ یمہٕ پرٛتھ دوٚہہ قربان گاہَس پٮ۪ٹھ بُزنہٕ یوان چھےٚ۔
\p
\v 17 ستن دوہن ہنٛدِ امہِ تہوارکہِ دوٚیمہِ دوٚہہ أنیٚو توٚہؠ قربان گاہَس پٮ۪ٹھ باہ ہکھر ؤژھؠ، زٕ کٹھ تہٕ وٲرشِنؠ ژۅداہ کٹہٕ برٕ۔ یمن جانورن گژھِ نہٕ کانٛہہ عٲب آسُن۔
\v 18 جانورن سٟتؠ أنزیٚو اوٹ تہٕ مےَ یمِچ ضرورت چھےٚ۔
\v 19 اکھ مُونگُر تہِ أنزیٚون قربٲنی خٲطرٕ پننٮ۪ن گُنہَن ہُند کفارٕ دنہٕ باپتھ۔ یمہٕ جانور آسن قربان گاہس پٮ۪ٹھ پرٛتھ دوٚہہ بُزنہٕ ینہٕ والیٚن جانورن، آٹہِ تہٕ مےَ کہ نذرانہٕ علاوٕ
\p
\v 20 تہوار کہِ تریمہِ دوٚہہ أنزیٚوکھ توٚہؠ قربان گاہس پٮ۪ٹھ کاہ ہکھر ؤژھؠ، زٕ کٹھ، تہٕ وٲرشِنؠ ژۅداہ کٹہٕ برٕ۔ یمن جانورن گژھِ نہٕ کانٛہہ تہِ عٲب آسُن۔ یم سٲری گژھن قربان گاہس پٮ۪ٹھ بُزنہٕ ینؠ، تہٕ یہنٛزِ خوشبو سٟتؠ گژھٕ بہٕ خوش۔
\v 21 یمن جانورن سٟتؠ گژھِ اوٹ تہٕ مےَ تہِ نذرانہٕ باپتھ انُن یمِچ ضرورت پیٚوان چھےٚ۔
\v 22 پننٮ۪ن گُنہن ہُنٛد کفارٕ دنہٕ باپتھ گژھِ اکِس مُونگرٕ سنٛز تہِ قربٲنی دِنؠ۔ یمہٕ جانور آسن قربان گاہس پٮ۪ٹھ پرٛتھ دوٚہہ بُزنہٕ ینہٕ والیٚن جانورن، آٹہِ تہٕ مےَ کہ نذرانہٕ علاوٕ۔
\p
\v 23 تہوار کہ ژورمہِ دوٚہہ أنیٚو توٚہؠ قربان گاہس پٮ۪ٹھ داہ ہکھر ؤژھؠ، زٕ کٹھ تہٕ وٲرشِنؠ ژۅداہ کٹہٕ برٕ۔ یمن جانورن گژھِ نہٕ کانٛہہ عٲب آسُن۔ یمہ سٲری گژھن قربان گاہس پٮ۪ٹھ بُزنہٕ یِنؠ، تہٕ یہنٛز خۅشبوٗ کرِ مےٚ خوش۔
\v 24 یمن جانورن سٟتؠ أنزیٚو اوٹ تہٕ مےَ تہِ نذرانہٕ رنٛگؠ، یمِچ ضرورت چھےٚ۔
\v 25 پنٕنؠ گناہ چھلنہٕ باپتھ کٔرؠ زیٚون اکھ مُونٛگُر تہِ قربان۔ یمہٕ جانور آسن تِمو جانورو علاوٕ یمہٕ جانور، اوٹ تہٕ مےَ پرٛتھ دوٚہہ قربان گاہس پٮ۪ٹھ بُزنہٕ یوان چھِ۔
\v 26 تہوار کہ پانٛژمہِ دوٚہہ أنزیٚکھ توٚہؠ قربان گاہس پٮ۪ٹھ نو ہکھر، زٕ کٹھ تہٕ وارشِنؠ ژۅداہ کٹہٕ برٕ۔ یمن جانورن منٛز کانٛہہ عٲب آسہ نہٕ۔ یمہٕ سٲری گژھن قربان گاہس پٮ۪ٹھ بُزنہٕ یِنؠ، تہٕ یہنٛز خۅشبوٗ ییہِ مےٚ پسنٛد۔
\v 27 یمن جانورن سٟتؠ گژھِ اوٹ تہٕ مےَ نذرانہٕ انُن یمچ ضرورت چھےٚ۔
\v 28 تہٕ پننٮ۪ن گُنہَن ہُنٛد کفارٕ دنہٕ باپتھ کٔرزیٚون اکھ مُونگُر تہِ قربان۔ یمہ جانور آسن تِمو جانورو علاوٕ یمہِ جانور، اوٹ تہٕ مےَ پرٛتھ دوٚہہ قربان گاہس پٮ۪ٹھ نذر کرنہٕ ین۔
\p
\v 29 تہوار کہ شیمہِ دوٚہہ گژھن قربان گاہس پٮ۪ٹھ ٲٹھ ہکھر، زٕ کٹھ تہٕ وٲرشِنؠ ژۅداہ کٹہٕ برٕ انٕنؠ۔ یمن گژھِ نہٕ کُنہِ قسمُک عٲب آسُن۔ یمہٕ گژھن قربان گاہس پٮ۪ٹھ بُزنہٕ یِنؠ، تہٕ یہنٛزِ خۅشبویہِ سٟتؠ گژھٕ بہٕ سیٹھاہ خوش۔
\v 30 یمن جانورن سٟتؠ گژھِ ضرورتُک اوٹ تہٕ مےَ تہِ نذرانہٕ انُن۔
\v 31 تہٕ پنٕنؠ گناہ معاف کرناونہٕ باپتھ گژھِ اکھ مُونگُر تہِ قربانی باپتھ انُن۔ یمہ جانور آسن تِمو جانورو علاوٕ یمہِ جانور، اوٹ تہٕ مےَ پرٛتھ دوٚہہ قربان گاہس پٮ۪ٹھ پیش کرنہٕ یوان چُھ۔
\p
\v 32 تہوار کہ سٔتمہِ دوٚہہ أنیٚو توٚہؠ قربان گاہس پٮ۪ٹھ ستتھ ہکھر ؤژھؠ، زٕ کٹھ تہٕ وٲرشِنؠ ژۅداہ کٹہٕ برٕ۔ یمن جانورن گژھِ نہٕ کانٛہہ عٲب آسُن۔ یمہ سٲری گژھن قربان گاہس پٮ۪ٹھ بُزنہٕ یِنؠ، تہٕ یہنٛز خۅشبوٗ کرِ مےٚ خوش۔
\v 33 یمن جانورن سٟتؠ أنزیٚو اوٹ تہٕ مےَ تہِ نذرانہٕ رنٛگؠ، یمِچ ضرورت چھےٚ۔
\v 34 تہٕ پنٕنؠ گناہ چھلنہٕ باپتھ کٔرؠ زیٚون اکھ مُونٛگُر تہِ قربان۔ یمہٕ جانور آسن تِمو جانورو علاوٕ یمہٕ جانور، اوٹ تہٕ مےَ پرٛتھ دوٚہہ قربان گاہس پٮ۪ٹھ بُزنہٕ یوان چھِ۔
\p
\v 35 یہ تہوار شروع سپدنہٕ پتہٕ ٲٹھِ دوٚہؠ گٔژھؠ زیٚو توٚہؠ میانہ عبادتہٕ باپتھ بیٚیہِ جمع۔ توٚہہ چھنہٕ بیٚیہِ کانٛہہ سۅ کٲم کرٕنؠ یۅسہ توٚہؠ عام پٲٹھؠ دوٚہہ دوٗش کران چُھو۔
\v 36 امہِ دوٚہہ چُھ توٚہہ قربان گاہس پٮ۪ٹھ اکھ دانٛد، اکھ بوٚڈ کٹھ تہٕ وٲرشِنؠ ستتھ کٹہٕ برٕ انٕنؠ۔ یمن جانورن منٛز گژھِ نہٕ کانٛہہ عٲب آسُن۔ یمہٕ سٲری گژھن قربان گاہس پٮ۪ٹھ بُزنہٕ ینؠ، تہٕ یہنٛز مُشٕک کرِ مےٚ مُعطر۔
\p
\v 37 دانٛدس، کٹس تہٕ پرٛتھ کانٛسہِ کٹہٕ برس سٟتؠ چُھ اوٹ تہٕ مےَ تہِ قربٲنی باپتھ ضرورت۔
\v 38 تہٕ پنٕنؠ گناہ معاف کرناونہٕ باپتھ گژھِ اکھ مُونگُر تہِ قربانی باپتھ انُن۔ یمہ جانور آسن تِمو جانورو علاوٕ یمہِ جانور، اوٹ تہٕ مےَ پرٛتھ دوٚہہ قربان گاہس پٮ۪ٹھ پیش کرنہٕ یوان چُھ۔
\p
\v 39 تُہنٛدین تہوارن پٮ۪ٹھ چھےٚ یمہٕ قربٲنیہِ، یمہٕ توٚہہ مےٚ نِش اننہِ چھےٚ، تمہٕ قربٲنیہ، یمہٕ قربقن گاہس پٮ۪ٹھ پوٗرٕ پٲٹھؠ بُزنہٕ ین، اناجچ قربٲنی، مےَ یچ قربٲنی، تہٕ مےٚ سٟتؠ رفاقت قٲیم تھاونٕچ تہٕ ورتاونٕچ قربٲنی۔ یمہٕ آسن تمو نذرانو علاوٕ یمہٕ توٚہؠ مےٚ دِوان چُھو تکیازِ توٚہہ چُھو مےٚ سٟتؠ کینٛہہ کرنُک وعدہ کۅرمُت، تہٕ باقی کینٛہہ خاص نذرانہٕ یمہٕ یمہٕ توٚہؠ مےٚ دِنؠ چُھو یژھان۔
\p
\v 40 پتہٕ ونہِ موسیٰؔ ہن تمہٕ سارے کتھٕ اسرائیلی لوٗکن یمن ہُنٛد حکم یہُوواہنؔ تمِس کۅر۔\f + \fr 29‏:40 \ft اتھ آیتس چُھ عِبرٲنؠ متنس منز 30:1 نمبر دِنہٕ آمُت۔\f*
\c 30
\p
\v 1 موسیٰؔ ہن بُلٲوؠ اسرائیلی قبیلٕکؠ زِٹھؠ تہٕ ووٚنُن تِمن۔ تٔمؠ ؤنؠ تِمن تِم احکام یِم یہُوواہنؔ تمِس دِتمٕتؠ ٲسؠ:
\p
\v 2 "اگر کانٛہہ شخص یہُوواہسؔ سٟتؠ وعدہ کرِ زِ بہٕ کرٕ کینٛہہ تمِس پزِ سُہ وعدہ نباوُن۔\f + \fr 30‏:2 \ft متی: 5:33\f*
\p
\v 3 اگر کانٛہہ جوان زٔنؠ یۅسہ وُنہٕ مٲلس ماجہِ سٟتی روزان آسہ تہٕ یہُوواہسؔ سٟتؠ کینٛہہ کرنُک وعدہ کرِ،
\v 4 اگر تمسنٛدؠ مٲلؠ بوز زِ أمؠ کیاہ وعدہ کۅر تہٕ پتہٕ ونیٚس نہٕ سُہ کہین تہٕ تٔمؠ یُس وعدہ کۅرمُت آسہ سُہ پزِ تس پوٗرٕ کرُن۔
\v 5 وۅنؠ اگر تمسنٛدؠ مٲلؠ بوز زِ أمؠ کیاہ وعدہ کۅر تہٕ تٔمؠ دِتُس نہٕ تہِ کرنُک اجازت تیٚلہِ چُھنہٕ تمسنٛدِ خٲطرٕ تہِ کرُن ضروری۔ یہُوواہؔ کرِ تمِس معاف سُہ وعدہ پوٗرٕ نہ کرنہٕ خٲطرٕ یُس تٔمؠ کۅرمُت آسہ۔
\p
\v 6 اگر کانٛہہ انۂرِش زٔنؠ یہُوواہسؔ سٟتؠ وعدہ کرِ زِ سۅ کرِ کانٛہہ کٲم، مگر پتہٕ سپدِ تمسُنٛد خاندر،
\v 7 اگر سۅ تتھ اقرار تحت خاندارس سٟتؠ خاندر کرِ، یا سۅ کتھٕ پانس پٮ۪ٹھ وٲجب بنٲوِتھ کرِ، تمِس پزِ تتھ پٮ۪ٹھ قٲیم روزُن۔
\p
\v 8 وۅنؠ اگر تمسُنٛد خاندار تمہِ وزِ تس رُکاوِ ییٚلہِ سُہ تتھ متعلق بوزِ، تمہِ دوٚہہ پُھٹراوِ سۅ سُہ اقرار یُس تٔمؠ کۅرمُت اوس، تمؠ یہ زبٲنؠ سٟتؠ پانس پٮ۪ٹھ وٲجب کۅرمُت اوس تہٕ پتہٕ پالنہٕ تہِ۔ یہُوواہؔ تراوِ تس یلہٕ۔
\p
\v 9 اگر کانٛہہ مونٛڈ یا مۅکلاونہٕ آمٕژ زٔنؠ کانٛہہ وعدہ کرِ تہٕ تمِس پزِ سُہ کۅرمُت وعدہ پوٗرٕ کرُن۔
\p
\v 10 اگر کانٛہہ خانٛدرٕ واجِنؠ زٔنؠ کینٛہہ کرنُک وعدہ کرِ،
\v 11 تہٕ تمسُنٛد خاندار تتھ متعلق بوزِ تہٕ پتہٕ کرنہٕ کانٛہہ اعتراض تہٕ تمِس تہِ پزِ سُہ وعدہ برابر پوٗرٕ کرُن۔
\p
\v 12 وۅنؠ اگر تٔمؠ تتھ متعلق بوز تہٕ پتہٕ دیُتنس نہٕ تہِ کرنُک اجازت تیٚلہِ چُھنہٕ تس سُہ وعدہ پوٗرٕ کرنُک کانٛہہ ضرورت، تہٕ یہُوواہؔ کرِ تس تہِ نہ کرُن معاف۔
\p
\v 13 اکِس زنہِ ہُنٛد خاندار ہیٚکہ تس سۅ کٲم کرنہٕ باپتھ ونِتھ یمیُک تٔمؠ وعدہ آسہ کۅرمُت، نتہٕ ہیٚکیٚس نہٕ اجازتھےٕ دِتھ یمیُک تٔمؠ وعدہ آسہ کۅرمُت۔
\v 14 وۅنؠ اگر سُہ اتھ ماملس منٛز واریہس کالس کانٛہہ اعتراضےٕ کرِنہٕ تہٕ تمِس پزِ تی کرُن یمیُک تمہِ وعدہ آسہ کۅرمُت۔
\p
\v 15 اگر سۅ کینٛہہ کرنُک وعدہ کرنہٕ پتہٕ واریہس کالس پرارِ تہٕ پتہٕ ونہِ سُہ تس زِ بہٕ دِمے نہٕ ژےٚ تہِ کرنُک اجازت، اگر نہٕ پتہٕ تمہِ سُہ وعدہ پوٗرٕ کۅر یُس تمہِ کۅرمُت اوس تہٕ تمِس ییہِ نہٕ سزا دِنہٕ۔ تمسُنٛد خاندار آسہ سُہ یمِس یہُوواہؔ سزا دییہِ۔"
\p
\v 16 یم چھِ تِم ضٲبطٕ یمہٕ یہُوواہنؔ موسیٰؔ ہس خاندارن، خاندارنیٚن تہٕ جوان زنیٚن خٲطرٕ یمہٕ والدینن سٟتؠ روزن آسن دِتمٕتؠ ٲسؠ۔
\c 31
\p
\v 1 یہُوواہنؔ ووٚن موسیٰؔ ہس،
\v 2 "اسرائیلی لوٗکن ون زِ تِم دِن مِدیان کیٚن لوٗکن تمیُک بدلہٕ یہ تِمو ژےٚ سٟتؠ ورتوو۔ توٚہؠ مٔرِو تہٕ گٔژھِو پننٮ۪ن جد اجدادن سٟتؠ شٲمل، یِم گۅڈَے مودؠ مٕتؠ چھِ۔"
\p
\v 3 اوٕ موٚکھٕ ووٚن موسیٰؔ ہن لوٗکن، سِپاہ کٔرووکھ جنٛگہٕ خٲطرٕ تیار۔ یہُوواہؔ بناوِ تِمن مِدیان کیٚن لوٗکن ہنٛزِ جمٲژ تمہِ کامہِ ہُنٛد بدلہٕ دِنس قٲبل یہ تِمو اسہِ سٟتؠ کۅرمُت چُھ۔
\v 4 پرٛتھ کُنہِ قبیلہٕ منٛزٕ ژٲرؠ وون جنگہٕ باپتھ اکھ ساس نفر۔
\v 5 یتھٕ کنؠ گے باہ ساس لُکہٕ جنگ کرنہٕ باپتھ تیار، پرٛتھ کُنہ قبیلہٕ منٛزٕ اکھ ساس نفر۔
\v 6 ییٚلہ موسیٰؔ ہن تمہٕ جنگ کرنہٕ باپتھ سوزؠ تہٕ کاہن الِیعزرؔ سُنٛد نیٚچو فینحاسؔ گو تِمن سٟتؠ۔ تِمو تُلؠ مقدس خٟمہٕ منٛزٕ کینٛہہ چیز تہٕ ہارنہٕ نرسنگے پانس سٟتؠ یمہٕ جنگ شروع کرنُک اشارٕ دنہٕ باپتھ بجاونہٕ یہَن۔
\p
\v 7 اسرائیل کیٚو نفرو کۅر مِدیان جمٲژ ہنٛدین سپہَن سٟتؠ جنگ، یتھ کنؠ زن یہُوواہنؔ موسیٰؔ ہس ونمُت اوس زِ تِمن وَن تہٕ تِمو ژھٕنؠ مِدیان جمٲژ ہہنٛدؠ سٲری نفر مٲرِتھ۔
\v 8 یِم لوٗکھ تِمو قتل کٔرؠ تمن منٛز ٲسؠ مِدیان جمٲژن ہنٛدؠ پانٛژھ بادشاہ عویؔ، رقمؔ، صُورؔ، حورؔ تہٕ ربعؔ۔ تِمو کۅر بعورؔ سُنٛد نیٚچو بلعام تہِ تلوارِ سٟتؠ قتل۔
\v 9 تِمو نیٚیہ مِدیانچہٕ سارے زنہِ تہٕ شُرؠ قبضس منٛز، تہٕ تہنٛزٕ گٲو، تہنٛدؠ تیٖر تہٕ ژھاولؠ کھیٚلؠ تہٕ تِہُنٛد سورے مال۔
\v 10 پتہٕ زٲلؠ تِمو شہرن تہٕ گامن منٛز تِہنٛدؠ سٲری گرٕ یتہِ مِدیانٕکؠ لوٗکھ روزان ٲسؠ۔
\p
\v 11 مگر تِمو نیٚیہ سارے زنہٕ، شُرؠ، چاروٲے تہٕ مال و اسباب پانس سٟتؠ۔
\v 12 تِمو واتنٲوؠ تِم سٲری چیٖز الِیعزرؔس، موسیٰؔ ہس تہٕ باقی اسرائیلی لوٗکن نِش یمہٕ موآبؔ کیٚن مٲدانن منٛز یرِیحو جایہ دریاے یردنس اپارِ ڈیرٕ دِتھ ٲسؠ۔
\p
\v 13 الِیعزرؔ، موسیٰؔ تہٕ باقی لوٗکن ہنٛدؠ قائید دراے کمپ کِس دروازس پٮ۪ٹھ تِمن استقبالس۔
\p
\v 14 مگر موسیٰؔ اوس تِمن کینٛژن نفرن ناراض یمہٕ جنگہٕ پٮ۪ٹھٕ واپس آمٕتؠ ٲسؠ۔ سُہ اوس فوجی افسرن ناراض، تِمن نفرن یِم یِم ساسن نفرن ہنٛدؠ کمانڈر ٲسؠ تہٕ تِمن نفرن یمہٕ ہتن نفرن ہنٛدؠ کمانڈر ٲسؠ۔
\v 15 موسیٰؔ ہن پرُوژھ تِمن، "توٚہہِ کیازِ تھایہ ووکھ زنہِ زنٛدٕ؟
\v 16 یمہٕ ٲسؠ تِمہ یمو بلعامؔ سنٛدِس مشورس پٮ۪ٹھ پٔکمٕتؠ ٲسؠ تہٕ سانین لوٗکن اوسُکھ یہُوواہسؔ بجایہ بعلؔ سنٛز پرستِش کرنہٕ خٲطرٕ ونمُت۔ یمہِ کِس نتیجس منٛز یہُوواہنؔ پننؠن لوٗکن وُبا تُل ییٚلہ تِم پیٚورؔ جایہ ٲسؠ۔\f + \fr 31‏:16 \ft وُچھِو 25:18-19\f*
\v 17 لہٰذا چُھو توٚہہ وۅنؠ مِدیان جمٲژ ہنٛدؠ تمام لڑکہٕ قتل کرٕنؠ تہٕ تِم سارے زنہِ تہِ یمہٕ کانٛسہِ مردس نِشہ شونجمَژٕ آسن۔
\v 18 صرف ترٲؠ ووکھ انۂرشہٕ کورے یاژٕ یلہٕ۔ توٚہؠ ہیٚکووکھ توٚہؠ بحثیتِ خاندارنہِ یا کنیزٕ پانس سٟتؠ رٔٹِتھ۔
\v 19 پتہٕ ووٚن موسیٰؔ ہن سپہن توٚہہِ منٛزٕ روزن تِم سٲری لوٗکھ ستن دوٚہُن کیمپہٕ نیٚبر یمو کانٛہہ مورمُت آسہ یا جنگس منٛز مومژِ کانٛسہ لاشہِ اتھٕ آسہ لوگمُت۔ تریمہِ دوٚہہ یا سٔتمہِ دوٚہہ چھےٚ توٚہہِ یہ رسٕم ادا کرٕنؠ یُتھ توٚہؠ دبارٕ خدایس قٲبلِ قبوٗل سپدیٚو، اکھ توٚہؠ تہٕ بیٚیہِ تُہنٛدؠ قٲدؠ۔
\v 20 توٚہہِ چھِ پنٕنؠ پلو تہٕ تِم سٲری چیز چھلٕنؠ یمہ جنگس منٛز توٚہہِ سٟتؠ ٲسؠ، یمہٕ چمبرس، ییرس یا لکٕرِ ہنٛدؠ بنیمٕتؠ ٲسؠ۔"
\v 21 پتہٕ ووٚتھ الِیعزرؔ تِمن سِپہن یمہٕ جنگہٕ پٮ۪ٹھٕ واپس آمٕتؠ ٲسؠ، "یہ چُھ تہِ یہ یہُوواہنؔ موسیٰؔ ہس ووٚن۔
\v 22 سۅن، چٲنٛدؠ، سرتل، شستٕر، ٹیٖن یا مِس یہ توٚہہ جنگہٕ پٮ۪ٹھٕ واپس اُنو تہِ ترٲیو نارس منٛز۔
\v 23 پرٛتھ کانٛہہ سُہ چیز ترٲوؠ زیٚو یُس نہٕ نارس منٛز دزِ، پتہٕ بنہِ سُہ تُہنٛدِ استعمالہٕ باپتھ قٲبلِ قبول۔ مگر تِمن چیزن تہِ کٔریٚو آبہٕ چِھرکاو یُتھ زن تمہٕ چیز تہٕ لوٗکھ خدایس قٲبلِ قبوٗل بنَن۔ یمہٕ چیز نارس تراونہٕ سٟتؠ دزن تِمن گژھِ تمہِ آبُک چِھرکاو کرنہٕ یُن۔
\v 24 ستمہِ دوٚہہ چٔھلؠ زیٚو پنٕنؠ پلو خٟمس برونٛہہ کنہِ تہٕ سپدیٚو توٚہؠ خدایس برُونٛہہ کنہِ مقبول۔ یہ کرنہٕ پتہٕ ہکیٚو توٚہؠ کیمپس منٛز واپس گٔژھِتھ۔"
\v 25 یہُوواہنؔ ووٚن موسیٰؔ ہس یتہِ،
\v 26 الِیعزرؔس تہٕ خاندٲنؠ ونڈٕ کیٚن سردارن ون زِ تِم بناون تمہِ سامانُک، تمام لوٗکن تہٕ جانورن ہُنٛد فہرست یمہٕ جنگس منٛز تِمو رٔٹمٕتؠ چھِ۔
\v 27 پتہٕ ون الِیعزرؔس تہٕ خانوادن ہنٛدیٚن زِٹھیٚن زِ تِم دِن تمام چیٖز جنگس منٛز لڑن والیٚن تہٕ باقی لوٗکن بٲگرِتھ۔
\v 28 جنگس منٛز لڑن والیٚو پرٛتھ پانٛژو ہتو نفرو منٛزٕ اکھ، پرٛتھ پانٛژو ہتو گٲوو منٛزٕ اکھ تہٕ پرٛتھ پانٛژو ہتو تیٖرو تہٕ ژھاولیٚو منٛزٕ اکھ تھٲوؠ زیٚون میانہٕ باپتھ ٹیٚکسٕہ رنٛگؠ۔
\v 29 میانہِ حصٕکؠ یِم چیز نیٖزیٚوکھ الِیعزرؔس نِش یمہٕ مےٚ پیش ین کرنہٕ۔
\p
\v 30 تہٕ باقی چیٖزو منٛزٕ تُلؠ زیٚو پرٛتھ پنٛژاہو منٛزٕ اکھ۔ یِمن منٛز لوٗکھ، گٲو، خر، تیٖر، ژھاوٕلؠ تہٕ باقی جانور شٲمل چھِ۔ تِم چیٖز دیزیٚو تِمن لاوی ہنٛدیٚن اولادن یمہٕ میانہ مقدس خٟمٕچ حفاظت کران چھِ۔"\f + \fr 31‏:30 \ft گرینٛد 31:42-47، 3: 7-8، 25، 31، 36: \f*
\v 31 لہٰذا کۅر الِیعزرؔ تہٕ موسیٰؔ ہن تی یہ یہُوواہنؔ تِمن حکم کۅرمُت اوس۔
\p
\v 32‏-35 تتہِ ٲسؠ شےٚ لچھ پنزٕ ستتھ ساس تیٖر، دوٗستتھ ساس گٲوٕ، 61 ساس خر، تہٕ 32 انۂرشہٕ کورِ یمہٕ تِمو مِدیان لُکہٕ جمٲژو منٛزٕ رچمژٕ آسہٕ۔
\p
\v 36 یمہٕ سِپاہ جنگس منٛز شٲمل ٲسؠ تِمو نیی جنگہٕ منٛزٕ ترےٚ لچھ ستہٕ ترٕ ساس تیٖر،
\v 37 تہٕ تِمو منٛزٕ دِتکھ 675 یہُوواہسؔ۔
\v 38 تِمو نیی 36 ساس گٲو تہٕ تمہ، منٛزٕ دِژکھ 72 گٲو یہُوواہسؔ۔
\v 39 تِمو نیی ترٕہ ساس پانٛژھ ہتھ خر تہٕ تِمو منٛزٕ دتِکھ 61 یہُوواہسؔ۔
\v 40 تِمو نیٚیہ شےٚ ساس انۂرشہٕ کورِ تہٕ 32 دِژکھ تِمو منٛزٕ یہُوواہسؔ
\v 41 موسیٰؔ ہن دِتؠ الِیعزرؔس تِم تمام جانور یہُوواہؔ سنٛدِ حکمہٕ مطٲبق یمہٕ یہُوواہسؔ پیش آے کرنہٕ۔
\p
\v 42‏-46 موسیٰؔ ہن کٔرؠ جنگس منٛز لڑن والیٚن ہنٛدؠ چیز باقی نفرن ہنٛدیٚو چیزو نشہٕ الگ۔ لوٗکن میلؠ ترےٚ لچھ ستہٕ ترٕ ساس پانٛژھ ہتھ تیر، 36 ساس گٲو، ترٕ ساس پانٛژھ ہتھ خر تہٕ شُراہ ساس انۂرشہٕ کورِ۔
\p
\v 47 لوٗکن یہ کینٛژھا میٚول، موسیٰؔ ہن تُل پنٛژہو منٛزٕ اکھ چیٖز تہٕ دِتُن یہُوواہسؔ۔ یتھ منٛز چاروٲے تہٕ انسان شٲمل ٲسؠ۔ یتھ زن یہُوواہؔ سُنٛد حکم اوس، موسیٰؔ ہن دِتؠ تِم سٲری لاوی ہنٛدیٚن اولادن یمو مقدس خٟمٕچ رٲچھ راوٕٹ کٔر۔
\v 48 پتہٕ آے فوجی افسر یمہٕ ساسن نفرن ہنٛدؠ تہٕ ہتن نفرن ہنٛدِ جماتٕکؠ سردار ٲسؠ موسیٰؔ ہس نِش۔
\v 49 تِمو ووٚن موسیٰؔ ہس، "اسہِ یم چٲنؠ خٲدِم چھِ، گنٛزرٲوؠ تم سِپاہ یمن اسہِ حکم دیُت تہٕ اسہِ وُچھ زِ تِمو منٛزٕ اوس نہٕ کانٛہہ تہِ لاپتہ۔
\p
\v 50 یتھٕ کنؠ کٔرؠ امہِ باپتھ اسہِ یہُوواہؔ سُنٛد شُکریہ ادا کرنہٕ خٲطرٕ سۅنہٕ سنٛدین چیزن ہنٛدؠ تحفہٕ پیش۔ یمہٕ اسہِ جنٛگ کرنہٕ پتہٕ میلؠ مٕتؠ ٲسؠ، سۅنہٕ سنٛدؠ کٔرؠ، بنٛگرِ، واجہ، دوٗر تہٕ ہار۔ اسہِ چھےٚ یہ امید زٕ یہ بنہِ سانیٚن گُنہَن ہنٛد کفارٕ۔"
\p
\v 51 لہٰذا کٔرؠ الِیعزرؔ تہٕ موسیٰؔ ہن یمہٕ سۅنہٕ سنٛدؠ چیز قبول یمہٕ تِمو أنمٕتؠ ٲسؠ۔
\v 52 تِمو یُس نذرانہٕ پیش کۅر تمیُک وزن اوس قریبن اکھ ہتھ تہٕ اکنمتھ کِلو گرام۔\f + \fr 31‏:52 \ft تقریباً 200 کلو \f*
\v 53 پرٛتھ کانٛسہِ سِپہَن نیی یِم چیٖز پانس باپتھ۔\f + \fr 31‏:53 \ft گرینٛد 31:32؛ اِستِثنا20:14\f*
\v 54 الِیعزرؔ تہٕ موسیٰؔ ہن کٔرؠ سِپاہ سالارو نِشہ سۅنہٕ سنٛدؠ یِم چیز قبوٗل تہٕ لگٲوِکھ مقدس خٟمس منٛز یُتھ زن اسرائیلی لوٗکن یاد ییہِ پاونہٕ زِ یہُوواہنؔ کتھٕ پٲٹھؠ دیُت مِدیان کیٚن لُکہٕ جمٲژن ساسہٕ بٔدؠ فوجی کمانڈرو تہٕ ہتہٕ بٔدؠ فوجی کمانڈرو نِش شِکس دِنس منٛز تِہُنٛد مدد۔
\c 32
\p
\v 1 روبنؔ تہٕ جدؔ قبیلہٕ کیٚن لوٗکن نِش ٲسؠ واریاہ چو چاروٲے۔ تِمو وُچھ زِ یعزیرؔ شہرس نکھٕ دریاے یردن کہ مشرق طرفہٕ جِلعادؔ علاقہٕ چُھ چاروٲے رچھنہٕ باپتھ اصل جاے۔
\v 2 یِتھ کنؠ آے تہنٛدؠ قٲید الِیعزرؔس، لوٗکن ہنٛدیٚن سردارن تہٕ موسیٰؔ ہس نِش۔ تِمو ووٚن،
\v 3 "یہ چُھ تِمن جاین ہُنٛد فہرست یِمن جاین ہُنٛد اسہِ مُشاہدٕ کۅر: عطارات، دیبون، یعزیرؔ، نمرہؔ، حسبون، الیعالی، شبام، نبوؔ تہٕ بعُونؔ۔
\v 4 یہُوواہنؔ دیُت اسہِ اسرائیل ین اکِس تِژھِ زمینہِ پٮ۪ٹھ قبضہٕ کرنُک موقہٕ یۅسہ چاروٲے رچھنہٕ باپتھ سیٹھاہ بہتر چھےٚ۔ یعنی عطارات، دیبون، یعزیر، نمرہؔ، حسبون، الیعالی، شبام، نبُو تہٕ بعُونؔ شہرن انٛدؠ پٔکؠ۔
\v 5 اگر یہ توٚہہ اصل باسہِ تہٕ أسؠ رٹہو دریاے یردنس اپٲرمہِ انٛدچہِ زمینہ بجایہ پننہِ باپتھ یہےَ زمین۔
\p
\v 6 موسیٰؔ ہن دیُت روبن تہٕ جد قبیلہٕ کیٚن سردارن جواب، "مگر تُہنٛدین اسرائیلی سٲتھیَن باپتھ چُھنہٕ یہ ٹھیک زِ تِم گژھن جنگ کرنہِ تہٕ توٚہؠ روزیٚو یتؠ۔
\v 7 اگر توٚہؠ تہِ کٔریٚو تہٕ توٚہؠ بٔنیٚو باقی اسرائیل ین باپتھ حوصلہٕ شِکنی ہنٛدؠ بٲعِث تہٕ تِم گژھن نہٕ دریاے یردن پار کٔرِتھ تتھ ملکس منٛز یُس یہُوواہؔ تِمن دِوان چُھ۔
\v 8 سانیٚو جدٕ اجدادو تہِ اوس یی کۅرمُت۔ مےٚ سوزؠ تِم قادِس برنِیع پٮ۪ٹھٕ یمہِ باپتھ زِ تِم وچُھن کنعانُک ملک کیٚوتھ چُھ۔
\v 9 تِم گے اِسکال وادی تام، مگر ییٚلہِ تِمو ملکس منٛز بٔڈؠ بٔڈؠ لوٗکھ وُچھ تہٕ تِم پھیرؠ واپس تہٕ اسرائیل کیٚن دِتُکھ یہ ؤنِتھ حوصلہٕ زِ اسہِ پزِ نہٕ تتھ ملکس منٛز دٲخٕل سپدنٕچ کوشش کرٕنؠ یتھ متعلق یہُوواہنؔ ووٚن بہٕ چُھسو یہ توٚہہ دِوان۔\f + \fr 32‏:9 \ft گرینٛد سبق 13\f*
\v 10 پتہٕ سپُد تِمن پٮ۪ٹھ یہُوواہؔ سُنٛد غضب تہٕ تٔمؠ کۅر یمہِ کتھِ ہُنٛد اعلان،
\p
\v 11‏-12 تِمو تمام لوٗکو منٛزٕ یمہٕ مِصرٕ منٛزٕ دراے، صرف آسن تِم یم کمس کم وُوہہ ؤہرؠ آسن یِم سۅ زمین وچُھن یمیُک مےٚ ابرہامسؔ، اضحاقسؔ تہٕ یعقوبسؔ دِنُک وعدہ چُھ کۅرمُت، تِم چھِ یفُنہؔ سُنٛد نیٚچو کالِبؔ تہٕ نون سُنٛد نیٚچو یسوع، تکیازِ تِمو کۅر مےٚ پٮ۪ٹھ پوٗرٕ بھروسہٕ۔ دویمیٚن لوٗکن منٛز یمہٕ مِصرٕ منٛزٕ دراے تِمو منٛزٕ وچھنہٕ کانٛہہ تہِ سۅ سرِ زمین۔ تکیازِ تِمو کۅر نہٕ میانس طاقتس پٮ۪ٹھ مکمل یقین۔
\p
\v 13 یتھ کنؠ سپُد یہُوواہؔ سُنٛد قہر اسرائیلی لوٗکن پٮ۪ٹھ تہٕ تٔمؠ کٔرؠ أسؠ ژتجہَن ؤرین ریگِستانن منٛز پھیرنس پٮ۪ٹھ مجبوٗر۔ ٲخٕر کار سپدؠ تِم سٲری لُکھاکہِ اکہِ فوت یم یہُوواہسؔ پٮ۪ٹھ بھروسہٕ ترٲوِتھ تمؠ سنٛز نافرمٲنی کران ٲسؠ۔
\v 14 تہٕ توٚہؠ چُھو پننٮ۪ن جدٕ اجدادن ہنٛدؠ پٲٹھؠ کٲم کران! توٚہؠ گناہ گار اسرائیلی لوٗکھ کٔرؠ وون یہُوواہؔ تمہِ کھۅتہٕ زیادٕ ناراض یوٗتاہ سُہ سانیٚن جدٕ اجدادن پٮ۪ٹھ اوس۔
\v 15 اگر توٚہؠ یہُوواہسؔ پٮ۪ٹھ بھروسہٕ کرُن ترٲیو تہٕ سُہ تھایو توٚہہ تہٕ تُہنٛدین تمام اسرائیلی سٲتھین واریہس کالس ریگِستانن منٛز تہٕ توٚہہ سارنی نِش تُلہٕ ناوِ تھف۔
\p
\v 16 پتہٕ ووٚن موسیٰؔ ہس روبنؔ تہٕ جد قبیلہٕ کیٚو مردو، "گۅڈٕ بناوو أسؠ پننیٚو چاروایو باپتھ ہڈر تہٕ بیٚیہِ بناوو یتہِ پننہِ عیالہٕ باپتھ شہر۔
\v 17 پتہٕ ہیٚکن سٲنؠ عیال مضبوط شہرن منٛز روزِتھ یِمن ژۅپٲرؠ دیوار آسن تہٕ تِم روزن یتھ ملکس منٛز روزن والیٚن لوٗکو نِش محفوظ۔ پتہٕ ہیٚکو أسؠ جنٛگ کرنہٕ باپتھ تیار گٔژھِتھ۔ أسؠ ہیٚکو باقی اسرائیل ین دریاوٕ اپارِ زمین حٲصِل کرنس منٛز مدد کٔرِتھ۔
\p
\v 18 یۅتام نہٕ پرٛتھ اکِس اسرائیل یس کینٛہہ زمین میلہِ تۅتام گژھو نہٕ أسؠ پننٮ۪ن گرن واپس۔
\v 19 یردن درؠ یاوس مغرب طرفہٕ رٹو نہٕ أسؠ کانٛہہ تہِ زمین تکیازِ سٲنؠ زمین چھےٚ یتی مشرق انٛدٕ۔
\v 20 پتہٕ ووٚن موسیٰؔ ہن تِمن، "بہٕ ونو توٚہہِ زِ توٚہہِ کیاہ چُھ کرُن۔ توٚہہِ چُھ یہُوواہؔ سنٛدِ باپتھ جنٛگہٕ خٲطرٕ تیار روزُن۔
\v 21 توٚہہِ چُھ پنٕنؠ ہتھیار ہیٚتھ یردن درؠ یاوس اپور ترُن۔
\v 22 ییٚلہِ یہُوواہؔ سۅ زمین تِمن لوٗکن نِش حٲصِل کرنَس منٛز اسہِ مدد کرِ یمہٕ تتہِ روزان چھِ، تیٚلہ آسہ توٚہہِ پننٮ۪ن گرن واپس گژھنُک اجازت۔ توٚہہ یُس وعدہ یہُوواہسؔ تہٕ تہنٛدؠ اسرائیلی سٲتھی لوٗکن سٟتؠ کۅرو سُہ کٔریٚو پوٗرٕ تہٕ توٚہؠ ہیٚکوون یہ ملک یُس یردن دریاوکہِ مشرقہٕ طرفہٕ چُھ، پنُن ملکِیت بنٲوِتھ یُس یہُوواہنؔ توٚہہِ دیُتمُت چُھ۔
\v 23 وۅنؠ اگر نہٕ توٚہؠ یہ کٲم کٔریٚو تہٕ توٚہؠ ہِییُو یہُوواہؔ سنٛدؠ گناہ، تہٕ سُہ دییہِ توٚہہِ یمن گُنہَن ہُنٛد سزا۔
\v 24 وۅنؠ ہکیٚو توٚہؠ پننہِ عیالہٕ باپتھ شہر تہٕ چارواین باپتھ ہڈر بنٲوِتھ مگر یہ کرنہٕ پتہٕ پزِ توٚہہِ تی کرُن یمیُک توٚہہِ وعدہ کۅرو۔
\p
\v 25 جدؔ تہٕ روبنؔ سنٛدیو قبیلن ہنٛدیٚو سردارو دیُت موسیٰؔ ہس جواب، "أسؠ کرو تی یہ کینٛژھا توٚہہِ اسہِ کرُن ونُو، تکیازِ توٚہی چُھو سٲنؠ قٲید۔
\p
\v 26 سانہِ گرٕ واجنہِ، سٲنؠ بچہٕ، سانہِ گٲوٕ تہٕ تیٖر ژھاوٕلؠ روزن یتؠ جلعادؔ علاقہٕ کیٚن شہرن منٛز۔
\v 27 مگر أسؠ کرو جنٛگس نیرنٕچ تیاری۔ أسؠ ترو پنٕنؠ ہتھیار ہیٚتھ یردن درؠ یاوس اپور تہٕ لڑو یہُوواہؔ سنٛدِ باپتھ، یتھ کنؠ توٚہہِ یعنی سٲنؠ سردارن ووٚن۔"
\v 28 چناچہ موسیٰؔ ہن دِتؠ الِیعزرؔس، یشُوعؔس تہٕ اسرائیلی قبیلہٕ کیٚن سردارن یِمن متعلق ہِدایت۔
\v 29 موسیٰؔ ہن ووٚن تِمن، "اگر زن جدؔ تہٕ روبن قبیلٕکؠ نفر جنٛگہٕ خٲطرٕ تیار گٔژھتھ توٚہہِ سٟتؠ یردن درؠ یاوٕ اپور ترن تاکہ تِم کرن توٚہہِ یہُوواہؔ سنٛز خٲہِش تہٕ تتھ ملکس پٮ۪ٹھ قبضہٕ کرنس منٛز توٚہہِ مدد۔ توٚہؠ دِیو تِمن جلعادؔ علاقہٕ وراثتس منٛز۔
\v 30 وۅنؠ اگر تِم پنٕنؠ ہتھیار تُلِتھ جنٛگہٕ باپتھ توٚہہِ سٟتؠ نیرن نہٕ، تِم ہیٚکن نہٕ تیٚلہ یہ زمین رٔٹِتھ، تِمن پزِ تیلہِ کنعان جایہ یردن درؠ یاوٕ کہِ اپٲرمہِ پاسہٕ کینٛہہ زمین رٹٕنؠ، یتھ کنؠ توٚہہِ منٛزٕ باقی کرن۔"
\v 31 جدؔ تہٕ روبنؔ قبیلہٕ کیٚو سردارو ووٚن در جواب، "أسؠ کرو تی یہ توٚہہِ وُنو تہٕ یہُوواہنؔ فرموو۔
\v 32 أسؠ ترو یردن درؠ یاوس اپور تہٕ واتو کنعانؔ ملکس منٛز تہٕ کرو تہِ یہ یہُوواہؔ یژھان آسہ، روزیٚو جنٛگہٕ باپتھ تیار۔ مگر سٲنؠ زمین آسہ یردن درؠ یاوٕ اپارِ مشرق انٛدے۔"
\v 33 چناچہِ موسیٰؔ اوس سۅ زمین جدؔ، روبنؔ تہٕ نیصف یوسفؔ سنٛدِس نیٚچوؠ منسیؔ سنٛدین قبیلہٕ درن دِنُک خٲہِش منٛد۔ یہ ٲس سۅ سرِزمین یتہِ گۅڈٕ عمورؔ قبیلُک بادشاہ سیحونؔ حکومت کران اوس، تہٕ یہ چھےٚ سۅ سرِ زمین یمہِ کیٚن شہرن تہٕ انٛدؠ پٔکؠ زمینس پٮ۪ٹھ بسنؔ علاقک بادشاہ عوجؔ حکومت کران اوس۔
\v 34 جدؔ قبیلہٕ کیٚو لوٗکو کٔرؠ دیبونؔ، عطاراتؔ، عروعیرؔ،
\v 35 عطراتشوفانؔ، یعزیرؔ، یُگبِہاؔ،
\v 36 بیت نمرہؔ تہٕ بیت ہارنؔ شہر آباد۔ یمن شہرن انٛدؠ پٔکؠ ٲسؠ مضبوط دیوار۔ تہٕ تِمو بنٲوؠ پننیٚو تیٖرو باپتھ ہڈر تہِ۔
\p
\v 37 روبنؔ قبیلہٕ کیٚو لوٗکو بسٲوؠ حسبونؔ، الیعالی، قریتؔ یائمؔ،
\v 38 نبوؔ، بعلؔ معُونؔ تہٕ سبمہؔ شہر۔ ییٚلہِ تِمو نبوؔ، بعلؔ معُونؔ دبارٕ آباد کٔرؠ تِمو دِتؠ تِمن شہرن نٔوؠ ناو۔
\p
\v 39 منسیؔ سنٛدِس نیٚچوؠ مکِیر سنٛدؠ اولاد گے جلعادؔ ناوٕ کِس علاقس منٛز تہٕ سُہ نیوکھ عمور سنٛزِ جمٲژ نشہٕ۔
\p
\v 40 موسیٰؔ ہن دیُت منسیؔ سنٛدِس نیٚچوِس مکِیر سنٛدِس خاندانس جلعادؔ علاقہٕ تہٕ تِمو لوگ تٔتی بسُن۔
\v 41 یائیرؔ تہِ اوس منسیؔ سنٛدیو اولادو منٛزٕ سُتہ گو تہٕ لوگُن تِمے علاقہٕ کیٚن لۅکٹٮ۪ن شہرن پٮ۪ٹھ قبضہٕ کرُن تہٕ تٔمؠ تھوو تِمن 'یائیرؔ سنٛدؠ قصبہٕ' ناو۔\f + \fr 32‏:41 \ft یائیرؔ سُنٛد گام\f*
\v 42 نوبعؔ ناوٕکؠ أکؠ نفرن کۅر قناتؔ شہرس تہٕ تتھ انٛدؠ پٔکؠ قصبن پٮ۪ٹھ قبضہٕ تہٕ کۅرُن سُہ سورےٕ علاقہٕ پننِس ناوس سٟتؠ منسوٗب۔
\c 33
\p
\v 1 یہ چُھ تِمن جاین ہُنٛد فہرست یوٚت اسرائیلی ہارونؔ تہٕ موسیٰؔ سنٛزِ رہنمٲئی منٛز مِصرٕ منٛزٕ نیرتھ وٲتؠ۔
\v 2 یہُوواہنؔ دیُت موسیٰؔ ہس حکم زِ سُہ لیکھِ دستاویزن منٛز تِمن جاین ہنٛدؠ ناو یوٚت تِم گے۔
\p
\v 3 ؤریکہِ گۅڈنکہِ\f + \fr 33‏:3 \ft عِبرٲنؠ کلینڈرُک گۅڈنیُک رٮ۪تھ چُھ منٛز مارچہٕ پٮ۪ٹھٕ منٛز اپریلس تام مطابقت تھاوان۔\f* ریتہٕ کہ پنٛداہمہِ تاریخہٕ یمہِ دوٚہہ تِمو فسح ۂچ تقریب منٲو دراے تمہٕ مِصر ترٲوِتھ رعمسیسؔ پٮ۪ٹھٕ دلاوری سان ییٚلہ مِصری فوج تِمن پتہٕ پتہٕ اوس۔
\v 4 ییٚلہ تِم دراے، مِصرٕکؠ لوٗکھ ٲسؠ وۅنہِ پننٮ۪ن زِٹھیٚن شُریٚن ہنٛزٕ لاشہٕ دفناوٲنی۔ تمہٕ مٲرتھ اوس یہُوواہؔ یہ باور کرُن یژھان زِ مِصرٕکؠ لوٗکھ یمن دیوتاہن ہنٛز پوٗزا کران ٲسؠ تِم ٲسؠ اپٕزؠ دیوتا۔
\p
\v 5 رعمسیسؔ منٛزٕ نیرتھ وٲتؠ تِم گۅڈٕ سکات تہٕ لٲگِکھ تتہِ پنٕنؠ خٟمہٕ۔
\p
\v 6 پتہٕ دراے سکات منٛزٕ تہٕ وٲتؠ ایتام یُس بیابانن سٟتؠ رٔلِتھ چُھ تہٕ دتِکھ تتہِ پنٕنؠ خٟمہٕ۔
\p
\v 7 پتہٕ تُروو تِمو ایتام تہٕ وٲتؠ واپس بعلؔ صفون کِس مشرِکس منٛز فی ہخیروتؔ جایہ تہٕ دِتکھ مجدالسؔ نکھٕ پنٕنؠ خٟمہٕ۔
\p
\v 8 پتہٕ تُروو تِمو فی ہخِیروت تہٕ وٲتؠ تریٚن دوٚہُن ہنٛزِ سمندری وتہِ ایتام صحراوس منٛز تہٕ دِتُکھ مارہؔ جایہِ پنُن ٹھکانہٕ۔
\p
\v 9 مارہؔ ترٲوِتھ وٲتؠ تِم ایلیمؔ۔ تتہِ ٲسؠ باہ ناگ تہٕ ستتھ کٔھزر کُلؠ۔ تِمو لٲگؠ تتہِ پنٕنؠ خٟمہٕ۔
\p
\v 10 پتہٕ وٲتؠ تِم ایلیمؔ ترٲوِتھ بحرِ قُلزمسؔ نکھٕ تہٕ دتِکھ تتہِ پنٕنؠ خٟمہ۔
\p
\v 11 بحرِ قُلزمؔ کہ سمندری صحراوٕ منٛزٕ نیرتھ وٲتؠ تِم صیناؔ کیٚن بیابانن نکھٕ تہٕ ترُووُکھ تتہِ پنُن ڈھیرٕ۔
\p
\v 12 پتہٕ دراے صیناؔ کیٚو بیابانو منٛزٕ دُفقہؔ کُن تہٕ دِتِکھ تتہِ پنٕنؠ خٟمہ۔
\p
\v 13 دُفقہؔ منٛزٕ نیرتھ وٲتؠ تِم الوشؔ، رفِدیمؔ جایہ پنٕنؠ ڈھیرٕ دِنہِ۔
\p
\v 14 پتہٕ دراے تمہٕ الوشؔ منٛزٕ تہٕ دِتِکھ پنٕنؠ خٟمہٕ رفیدیمؔ ناوچہِ جایہ، یتہِ نہٕ تِمن چیٚنہٕ باپتھ آبےٕ اوس۔
\p
\v 15 پتہٕ ؤتھؠ تِم رفیدیمؔ منٛزٕ تہٕ وٲتؠ سینا کیٚن بیابانن منٛز تہٕ لٲگِکھ تتہِ پنٕنؠ خٟمہ۔
\p
\v 16 سینا کیٚو بیابانو منٛزٕ نیرتھ وٲتؠ تِم قبرُوت ہتّاوہؔ\f + \fr 33‏:16 \ft قبرُوت ہتّاوہؔ ہُک مطلب چُھ ترسٕچ قبر۔ \f* تہٕ ترُوُوکھ تتہِ ڈھیرٕ۔
\p
\v 17 پتہٕ دراے قبرُوت ہتّاوا ترٲوِتھ حصیراتؔ کُن پنٕنؠ خٟمہ دنہِ تہٕ دِتِکھ۔
\p
\v 18 پتہٕ وٲتؠ تِم حصیراتؔ ترٲوِتھ رِتمہؔ جایہ تہٕ دِتِکھ تتہِ پنٕنؠ خٟمہ۔
\p
\v 19 رِتمہؔ پٮ۪ٹھٕ نیرتھ وٲتؠ تِم رِمّون فارسؔ ناوچہ جایہ تہٕ دِتِکھ تتہ، پنٕنؠ خٟمہ۔
\p
\v 20 پتہٕ ترُوو تِمو رِمّون فارسؔ تہٕ وٲتؠ پنٕنؠ ڈیرٕ دنہٕ لِبناہؔ۔
\p
\v 21 پتہٕ دراے تِم لِبناہؔ منٛزٕ تہٕ وٲتؠ رسّہؔ تہٕ تتہِ دِتِکھ پنٕنؠ خٟمہ۔
\p
\v 22 رسّہؔ منٛزٕ نیرنہٕ پتہٕ وٲتؠ تِم ڈھیرٕ دنہِ باپتھ قہیلانہؔ۔
\p
\v 23 پتہٕ دراے تِم قہیلانہؔ منٛزٕ، تِم وٲتؠ سافرؔ کِس بالس پٮ۪ٹھ تہٕ دِتِکھ تتہِ پنٕنؠ خٟمہ۔
\p
\v 24 سافرؔ بالہٕ پٮ۪ٹھٕ نیرتھ گےَ تِم حرادہؔ پنٕنؠ خٟمہ دِنہٕ باپتھ۔
\p
\v 25 حرادہؔ تراوِتھ وٲتؠ تِم مقہِیلوتؔ تہٕ دِتِکھ تتہِ پنٕنؠ خٟمہ۔
\p
\v 26 پتہٕ دراے تِم مقہِیلوتؔ منٛزٕ تہٕ وٲتؠ تحتؔ تہٕ کٔرِکھ تتہِ پنٕنؠ خٟمہ کھڑا۔
\p
\v 27 پتہٕ ترُووکھ تحتؔ تہٕ ترُووُکھ تارحؔ ہس منٛز پنُن ڈھیرٕ۔
\p
\v 28 تارحؔ منٛزٕ نیرتھ وٲتؠ تِم مِتقہ تہٕ دِتِکھ تتہِ پنٕنؠ خٟمہ۔
\p
\v 29 امہ پتہٕ دراے مِتقہ منٛزٕ تہٕ وٲتؠ حشمونہؔ تہٕ لٲگِکھ تتہِ پنٕنؠ خٟمہ۔
\p
\v 30 پتہٕ دراے تِم حشمونہؔ منٛزٕ تہٕ وٲتؠ موسِیروؔت تہٕ ترووُکھ تتہِ ڈھیرٕ۔
\p
\v 31 موسِیروؔت منٛزٕ نیرتھ وٲتؠ تِم بنی یعقانؔ تہٕ دِتِکھ تتہِ پنٕنؠ خٟمہ۔
\p
\v 32 بنی یعقانؔ منٛزٕ نیرتھ گےَ تِم حورحجد جاد تہٕ لٲگِکھ تتہِ پنٕنؠ خٟمہٕ۔
\p
\v 33 پتہٕ دراے حورحجد جاد منٛزٕ تہٕ امہِ پتہٕ دِتِکھ پنٕنؠ خٟمہٕ یُوطباؔتہ جایہ۔
\p
\v 34 پتہٕ دراے یُوطباؔتہ پٮ۪ٹھٕ تہٕ وٲتؠ عبرُونؔہ پنٕنؠ خٟمہ دِنہِ۔
\p
\v 35 عبرُونؔہ منٛزٕ نیرتھ گےَ تِم عصیُونؔ جابر تہٕ دِتِکھ تتہِ پنٕنؠ خٟمہ۔
\p
\v 36 عصیُونؔ جابر منٛزٕ نیرتھ وٲتؠ تِم صِینؔ کیٚن بیابنن منٛز تہٕ دِتِکھ قادِس جایہ پنٕنؠ خٟمہ۔
\p
\v 37 پتہٕ دراے تِم قادِسؔ پٮ۪ٹھٕ ادومؔ کِس سرحدس کُن تہٕ وٲتؠ ہور پہاڑس پٮ۪ٹھ پنٕنؠ خٟمہ دِنہ۔
\v 38 کاہن ہاروننؔ اوٚن یہُوواہؔ سُنٛد حکم بجا تہٕ کھوٚت پہاڑس پٮ۪ٹھ۔ تہٕ تٔتی کۅرُن اسرائیلی مِصرٕ منٛزٕ نیرنہٕ پتہٕ ژتجہی ؤہرؠ تہنٛدِ پانٛژمہِ ریتہٕ کہِ گۅڈنکہِ تٲریخہ وفات۔
\v 39 ہارونؔ سنٛز وانٛس ٲس تمہِ وزِ 123 ؤری یمہ ساعتہٕ سُہ مود۔\f + \fr 33‏:39 \ft گرینٛد 20:22-29\f*
\p
\v 40 یہ اوس سُہ زمانہٕ ییٚلہ عراد شہرٕکؠ بادشاہن بوز زِ بنی اسرائیلی چھِ پکان۔ عرادؔ اوس کنعان ملکہٕ کیٚن جنوبی صحراون منٛز یتہِ کنعانٕکؠ لوٗکھ روزان ٲسؠ۔
\p
\v 41 بنی اسرائیلی دراے کوہہِ ہورؔ تراوِتھ، وٲتؠ ضلمونؔہ تہٕ دِتِکھ تتہِ پنٕنؠ خٟمہ۔
\p
\v 42 پتہٕ ترُوو تِمو ضلمونؔہ تہٕ گےَ فونونؔ یتہِ تِمو پنٕنؠ خٟمہ دِتؠ۔
\p
\v 43 پتہٕ دراے فونونؔ منٛزٕ تہٕ وٲتؠ اوبوتؔ قیام کرنہٕ باتھ۔
\p
\v 44 اوبوتؔ منٛزٕ نیرتھ گےَ تِم عی عباریمؔ یُس موآبؔ علاقہٕ کِس سرحدس پٮ۪ٹھ اوس تہٕ ترووُکھ تتہِ پنُن ڈھیرٕ۔
\p
\v 45 پتہٕ دراے تِم عی عباریم پٮ۪ٹھٕ تہٕ وٲتؠ دیبونؔ جد دِتِکھ تتہِ پنٕنؠ خٟمہ۔
\p
\v 46 دیبون جد منٛزٕ نیرتھ وٲتؠ تِم علموؔن دبلہ تایم تہٕ لٲگِکھ تتہِ پنٕنؠ خٟمہ۔
\p
\v 47 پتہٕ دراے تِم علموؔن دبلہ تایم منٛزٕ تہٕ گےَ نبوؔ علاقس نکھٕ عباریم کیٚن پہاڑن پٮ۪ٹھ تہٕ دِتِکھ تتہِ پنٕنؠ خٟمہ۔
\p
\v 48 عباریم کیٚو پہاڑو پٮ۪ٹھٕ واپس یتھ گےَ تِم موآبؔ کیٚن مٲدانن منٛز یریحو اپور یردن درؠ یاوس نکھٕ۔
\p
\v 49 تِمو دِتؠ تتہِ موآبؔ کیٚن مٲدانن منٛز پنٕنؠ خٟمہ۔ تہنٛدؠ خٟمہ ٲسؠ بیت یسیموتؔ پٮ۪ٹھٕ ابیل سِطیمؔ تام واریہن کلو میٹرن پٮ۪ٹھ پھٲلِتھ۔
\p
\v 50 ییٚلہِ أسؠ یردن درؠ یاوس نکھٕ موآبؔ کیٚن مٲدانن منٛز یریحو اپارِ ٲسؠ تہٕ یہُوواہؔ سپُد موسیٰؔ ہس سٟتؠ ہمکلام۔ تٔمؠ ووٚن،
\v 51 "اسرائیل کیٚن لوٗکن ون ژٕ، ییٚلہ توٚہؠ یردن درؠ یاو اپور تٔرِتھ کنعان کِس علاقس منٛز وٲتیٚو،
\v 52 توٚہؠ کٔرزیٚوکھ تتہِ روزن وٲلؠ تمام لوٗکھ تتہِ نیرنہٕ خٲطرٕ مجبور۔ تہنٛدؠ تمام گٔرمٕتؠ نشانہٕ، دھاتن پٮ۪ٹھ بنٲوتھ تمام شبیہِ۔ تِم سارے جایہ کٔرؠ چیٚوکھ تباہ یتہِ تِم پننٮ۪ن بُتن پوٗزا کران چھِ۔
\v 53 تِمن نِیو تہنٛز زمیٖن لوٗٹہٕ تہٕ تتھ پٮ۪ٹھ بٔسیٚو، تکیازِ مےٚ چھےٚ تِہنٛز زمیٖن توٚہہِ دِژمٕژ تہٕ توٚہؠ چُھو تتھ مٲلک'
\p
\v 54 چیرِ ترٲوِتھ بٲگراوؠ زیٚو زمین زِ کُس رقبہٕ کَس جمٲژ ییہِ۔ بڈؠ علاقہٕ دیزیٚو تِمن جمٲژن یمن زیادٕ نفر آسن، تہٕ لۅکٕٹؠ علاقہٕ دیزیٚو تتھ جمٲژ یتھ کم نفر آسن۔ پرٛتھ کُنہِ قبیلس میلہِ پنٕنؠ زمین۔
\v 55 اگر توٚہؠ تمہِ کنعٲنؠ ملکٕکؠ روزن وٲلؠ تتہِ نیرنس پٮ۪ٹھ مجوٗر کٔرؠ ووکھ نہٕ تہٕ تِم کرن توٚہہِ مختلف پریشانیٚن منٛز مُبتلا توٚہؠ روزیٚو تِمن أچھ منٛز کِٹُر تہٕ تِم روزن توٚہہِ ژۅپٲرؠ کنٛڈین ہنٛدؠ پٲٹھؠ۔ تہٕ تِم انن توٚہہ تتھ جایہ مصیبت یتہِ توٚہؠ روزیٚو،
\p
\v 56 اگر نہٕ توٚہؠ تِمہٕ تتہِ کٔڑؠ وُکھ تہٕ پتہٕ دمہٕ بہٕ توٚہہِ سزا یتھ کنؠ مےٚ تِمن سزا دِنک منصوبہ بنومُت چُھ۔"
\c 34
\p
\v 1 یہُوواہنؔ ووٚن موسیٰؔ ہس مذید،
\v 2 "یہ کتھ ون اسرائیلی لوٗکن زِ توٚہؠ سپدیٚو جلدےٕ کنعان ملکس منٛز دٲخٕل تہٕ سُہ سپدِ تُہنٛد۔ زمینٕکؠ سرحد روزن یتھٕ کنؠ۔
\v 3 جنوبی سرحدٕ انٛدٕ میلہِ توٚہہ صِینؔ کیٚو بیابانو منٛزٕ کینٛہہ حصہٕ یُس ادومؔ علاقہ کیٚن سرحدن نزدیک چُھ۔ مشرقہٕ طرفُک سرحد سپدِ بحیرہ مردار کہ جنوٗبی انٛدٕ پٮ۪ٹھٕ شروع۔
\v 4 تتہِ پٮ۪ٹھٕ آسہ یہ ہنا جنوب کُن بچھوؔ تام تہٕ صِینؔ کیٚو بیابانو کِنؠ قادِس برنِیع قصبہٕ کِس مغربس تام پھٲلِتھ۔ تتہِ پٮ۪ٹھٕ آسہ یہ حصرادار کِنؠ عضمون شہرس تام پھٲلِتھ۔
\v 5 عضمون پٮ۪ٹھٕ مغرب کِنؠ مِصرٕ کیٚو سرحدو پیٚٹھؠ خشک درؠ یاوس تام تہٕ پتہٕ بحیرہ رومسؔ تام۔\f + \fr 34‏:5 \ft وادی ارِش۔ \f*
\p
\v 6 مغربُک سرحد آسہ بحیرہ رومؔ۔
\p
\v 7 شمال اندُک سرحد آسہ بحیرہ رومؔ پٮ۪ٹھٕ شروع سپدِتھ مغرب کِس ہور پہاڑس تام پھٲلِتھ۔
\v 8 تتہِ پٮ۪ٹھٕ آسہ یہ لبو حمات تام تہٕ تتہِ پٮ۪ٹھٕ صِداد تام۔
\v 9 تتہِ پٮ۪ٹھٕ پھٲلہِ یہ سرحد زِفرُون تام تہٕ حصر عینانسؔ نِش واتہِ انٛد۔
\v 10 مشرِق انٛدٕچ سرحد گژھِ حصر عینانؔ پٮ۪ٹھٕ شروع تہٕ پھٲلہِ جنوب انٛدٕ سفام تانؠ۔
\v 11 تتہِ پٮ۪ٹھٕ گژھِ یہ عین کہ مشرقہٕ انٛدٕ رِبلہ تام تہٕ پتہٕ واتہِ گلیل جھیل کہ مشرِقہٕ کِنؠ پہاڑن تام۔
\v 12 پتہٕ آسہ یہ سرحد جنوب انٛدٕ درؠ یاوٕ یردنس سٟتؠ تہٕ واتہِ شور درؠ یاوس نِش انٛد۔
\p یمہٕ آسن تُہنٛدِ ملکچہٕ سرحدٕ۔"
\p
\v 13 تہٕ موسیٰؔ ہن ووٚن پتہٕ یہ سورےٕ اسرائیلی لوٗکن۔ پتہٕ ووٚن تمؠ تِمن، یہ چھےٚ سۅ زمین یۅسہ توٚہہ رٹٕنؠ چھےٚ۔ توٚہہِ چھےٚ امہ باپتھ چیٖرِ تراونہِ زِ ساڑو نوو قبیلو منٛزٕ کُس انٛد کمِس ییہِ، تکیازِ یہُوواہؔ سُنٛد فرمان چُھ زِ یہ گژھِ یِمن منٛز تقسیم کرنہٕ یُن۔
\v 14 روبنؔ، جدؔ تہٕ منسیؔ سنٛدین اڈیٚن قبیلہٕ درن چھےٚ گۅڈے سۅ زمین میجمٕژ یتھ پٮ۪ٹھ تِم بسَن۔
\v 15 تِمن دون قبیلن میج یردن درؠ یاوس مشرق انٛدٕ یریحو اپارِ زمین۔
\p
\v 16 پتہٕ ووٚن یہُوواہنؔ موسیٰؔ ہس مذید،
\q1
\v 17 "یمہٕ چھِ تمہ لوٗکھ یمہٕ زمین باگراون۔ گۅڈٕ بٲگرن الِیعزرؔ تہٕ یشُوع،
\v 18 مگر باقی بہَو قبیلو منٛزٕ کرِ پرٛتھ قبیلُک زیُٹھ تِمن زمین بٲگراونس منٛز مدد۔
\li
\v 19 یہُوداؔ سنٛدِ قبیلہٕ منٛزٕ کٔرؠ وون یفُنّہ سُنٛد نیٚچو کالِبؔ زیُٹھ مقرر۔
\q
\v 20 شمعونؔ سنٛدِ قبیلہٕ منٛزٕ کٔرؠ وون عِمیہُودؔ سُنٛد نیٚچو سموئیلؔ۔
\q
\v 21 بنیمِینؔ سنٛدِ قبیلہٕ منٛزٕ کٔرؠ وون کِسلُونؔ سُنٛد نیٚچو الِداد مقرر۔
\q
\v 22 دانؔ سنٛدِ قبیلہٕ منٛزٕ کٔرؠ وون یُگلیؔ سُنٛد نیٚچو بُقی۔
\q
\v 23 یوسف سنٛدیو نیٚچیو منزٕ منسیؔ سنٛدِ قبیلہٕ منٛزٕ کٔرؠ وون افُودؔ سُنٛد نیٚچو حنّی ایل مقرر۔
\q
\v 24 افرائیمؔ سنٛدِ قبیلہٕ منٛزٕ کٔرؠ وون سِفتانؔ سُنٛد نیٚچو قموایلؔ مقرر۔
\q
\v 25 زبولونؔ سنٛدِ قبیلہٕ منٛزٕ کٔرؠ تون فرناکؔ سُنٛد نیٚچو الِیصفنؔ مقرر۔
\q
\v 26 اشکار سنٛدِ قبیلہٕ منٛزٕ کٔرؠ زیٚون عزّانؔ سُنٛد نیٚچو فلتی ایلؔ۔
\q
\v 27 آشرؔ سنٛدِ قبیلہٕ منٛزٕ کٔرؠ زیٚون شلُومیؔ سُنٛد نیٚچو اخِیہُودؔ مقرر۔
\q
\v 28 تہٕ نفتالیؔ سنٛدِ قبیلہٕ منٛزٕ کٔرؠ وون عِمیہُودؔ سُنٛد نیٚچو فداہیلؔ مقرر۔
\p
\v 29 یہ حکم چُھ یہُوواہؔ سُنٛد زِ یِم چھِ تِم سٲری لوٗکھ یمہٕ کنعان کِس علاقس بنی اسرائیل ین منٛز تقسیم کرن۔
\c 35
\p
\v 1 یہُوواہنؔ ؤنؠ موسیٰؔ ہس یہ کتھ تمہِ وقتہٕ ییٚلہ بنی اسرائیلی یردن درؠ یاوس نکھٕ موآبؔ کِس مٲدانس منٛز یریحو اپارِ ٲسؠ،
\v 2 "اسرائیل کیٚن لوٗکن وَن زِ یۅسہ زمین تِمن میلہ تمہ منٛزٕ دِن تمہٕ ضرور کینٛہہ شہر لاوین ہنٛدین اولادن یتہِ تِم روزِتھ ہیٚکن۔ بیٚیہِ دِن لٲزمی تِمن شہرن انٛدؠ پٔکؠ تِمن کینٛہہ زمین تہِ۔
\p
\v 3 یم شہر آسن لاوی ہنٛدین اولادن بسنہٕ خٲطرٕ تہٕ شہرن انٛدؠ پٔکؠ آسہ تِمن چارواین، تیٖرن، ژھاولیٚن تہٕ باقی جانورو باپتھ ہڈرو باپتھ زمین۔
\p
\v 4 یۅسہ زمین توٚہؠ تِمن چاروایو باپتھ دِیو سۅ گژھِ شہرٕ کیٚو دیوارو پٮ۪ٹھٕ \f + \fr 35‏:4 \ft یا 450 میٹر\f*457 میٹر تام پھٲلِتھ آسٕنؠ۔
\p
\v 5 شہرٕ کہِ پرٛتھ دیوارٕ پٮ۪ٹھٕ گژھن 920 میٹر میننہٕ ینؠ۔ سۅ اضافی زمین آسہ تہنٛدیو چاروایو باپتھ شہرٕ کیٚن دیوارن نیٚبر کُن۔
\p
\v 6 یِم شہر توٚہؠ لاوی ہنٛدیٚن اولادن دِیو تِمن منٛز آسن شےٚ شہر یمن لوٗکھ ٹھیک پٲٹھؠ چلاوِتھ ہیٛکن۔ اگر کانٛہہ وشفن کانٛسہِ دویمِس مارِ، یمؠ شخصن سُہ مورمُت آسہ سُہ ہیٚکہ محفوظ روزنہٕ باپتھ یمو شہرو منٛزٕ کُنہِ أکِس شہرس منٛز گٔژھِتھ۔\f + \fr 35‏:6 \ft پناہ گاہٕکؠ شہر ٲسؠ لٲوٮ۪ن دِنہٕ آمتیٚو کُل 48 شہرن منٛز شٲمل۔ \f*
\v 7 توٚہؠ دِیو لاوی ہنٛدین اولادن مذید دویہ تٲجی شہر تہٕ تِمن شہرن انٛدؠ پٔکؠ چاروایو باپتھ زمین تہِ۔
\p
\v 8 بنی اسرائیل کیٚن یمن قبیلن زیادٕ لوٗکھ آسن تِمن قبیلن گژھن زیادٕ شہر دِنؠ تِمو قبیلو کھۅتہٕ یمن کم نفر آسن۔ پرٛتھ کُنہ قبیلس پزن پنٕنؠ کینٛہہ شہر لاوی ہنٛدین اولادن دِنؠ، یمن قبیلن نِش زیادٕ زمین آسہ تِم دِن زیادٕ شہر تہٕ یمن قبیلن نِش کم شہر آسن تِم دِن کم شہر۔"
\p
\v 9 یہُوواہنؔ ووٚن موسیٰؔ ہس یتہِ،
\v 10 "اسرائیل کیٚن لوٗکن ون یِتہِ زِ ییٚلہ توٚہؠ یردن درؠ یاوس اپور تٔرِتھ کنعان کِس علاقس منٛز وٲتیٚو،
\v 11 توٚہہ پزِ کینٛژن تِمن شہرن ہُنٛد انتخاب کرُن یمہٕ شہر لوٗکھ آرامہٕ سان چلاوِتھ ہیٚکن۔ اگر کانٛسہ بیٚیہِ کانٛہہ شخص مور، تہٕ سُہ قٲتِل ہیٚکہِ تِمو منٛزٕ کُنہِ اکِس شہرس منٛز پان بچاونہٕ باپتھ گٔژھِتھ۔
\p
\v 12 یُس شخص قتل آسہ کرنہٕ آمُت تٔمسنٛدیٚو رشتہٕ دارو منٛزٕ اگر کانٛہہ سونچہِ زِ سُہ قٲتِل قتل کرِتھ ہیٚمہٕ بہٕ تس پننِس رشتہٕ دار سُنٛد بدلہٕ۔ مگر تتھ شہرس منٛز آسہ سُہ قٲتِل محفوظ تکیازِ تمہِ شہرٕکؠ لوٗکھ کرن تمسنٛدین رشتہٕ دارن قتل اگر سُہ تتہِ بدلہٕ ہیٚنٕچ کوشش کرِ۔ یمؠ شخصن کانٛہہ وشفن قتل آسہ کۅرمُت تمِس خلاف ییہِ عدالتس منٛز مقدِمہ دٲئر کرنہٕ۔
\v 13 توٚہہِ پزن شےٚ شہر الگ تھاوٕنؠ تاکہ تِمہ آسن تیٚتھؠ شہر یتہِ کانٛہہ سُہ شخص بسِتھ ہیٚکہِ تہٕ محفوظ روزِ یمؠ سنٛدؠ دٔسؠ وشفن کانٛہہ قتل آسہ سپُدمُت۔
\p
\v 14 یمو منٛزٕ گژھن ترےٚ شہر یردن درؠ یاوس مشرقہٕ انٛدٕ تہٕ ترےٚ مغربی بٹھِس پٮ۪ٹھ کنعان علاقس منٛز آسٕنؠ گژھن۔
\v 15 یمہ شےٚ شہر آسن تمہٕ شہر یور اسرائیلی لوٗکھ ژٔلِتھ گژھِتھ محفوظ روزِتھ ہیٚکن، یوٚت پردیسٕکؠ تہٕ توٚہہِ سٟتؠ روزن وٲلؠ باقی لوٗکھ یمو وشفن کانٛسہِ ہنٛدؠ قٲتِل کۅرمُت آسہ گژھن ژٔلِتھ یمن شہرن منٛز تہٕ روزن محفوظ۔
\p
\v 16‏-18 مگر توٚہہِ چُھ یتھ پٮ۪ٹھ غور کرُن زِ یُس شخص کانٛسہِ دویمِس سمبلہِ، بجہِ کنہِ یا لکٕرِ ہنٛدِ کُنہِ ڈنٛڈٕ سٟتؠ مارِ سُہ چُھ قٲتِل تہٕ یمؠ کانٛہہ قتل کۅر تمِس گژھِ پھٲسؠ دنہٕ ینؠ۔
\p
\v 19 یُس شخص قتل کرنہٕ ییہِ تمسُنٛد رشتہٕ دار چُھ سُے یُس قٲتلس وُچھِ تہٕ وُچھتھےٕ تس پھٲسؠ دییہِ۔
\v 20 اگر کانٛہہ شخص کانٛسہِ دویمِس کٔنؠ ہیٚتھ پتہٕ دورِ یا کانٛہہ چیز لگاویس،
\v 21 یا تمِس شخصس پننہِ اتھ سٟتؠ مارِ تہٕ نتیجہٕ نیرِ سُہ مرِ، اگر تٔمؠ یہ اوٕ مۅکھٕ کۅر زِ تس آسہ تمِس فردٕ سنٛز نفرت تیلہِ گژھِ زانُن زِ سُہ چُھ تمسُنٛد قٲتِل۔ تہٕ سُہ گژھِ پھاسہِ کھالنہٕ یُن۔ مقتول سُنٛد رشتہٕ دار گژھِ تیٚوتھ آسُن زِ سُہ گژھِ تس وُچھتھےٕ پھٲسؠ دیُن۔
\v 22 مگر یتہِ ممکن زِ کانٛہہ دییہِ کانٛسہِ الغٲبہٕ دکہٕ یا لایہ الغٲبہٕ کانٛسہِ کانٛہہ چیٖز تہٕ ماریٚس مگر یمہِ کِنؠ نہٕ زِ سُہ آسہ تس نفرت کران۔
\v 23 یا پییَس نہٕ نظرے تہٕ دِییہ کانٛسہِ پٮ۪ٹھ پل دٲرِتھ۔ یتِھس نفرس باپتھ چُھ اکھ قانون یمؠ نہٕ زٲنِتھ مٲنِتھ کانٛسہِ تکلیف واتناونُک اِرادٕ کۅرمُت آسہ تہٕ مرن وٲلِس سٟتؠ آسیٚس نہٕ کانٛہہ عداوت۔
\v 24 سُہ قانون چُھ یِتھ کنؠ زِ امہِ شہرٕ کیٚن لوٗکن چُھ فٲصلہ کرُن زِ مرن وٲلؠ سنٛدین رشتہٕ دارن چھا بدلہٕ ہیٚنُک حق یا یمؠ قتل کۅر تمِس چھا پزی یہ غلطی سببہٕ سپُدمُت۔\f + \fr 35‏:24 \ft گرینٛد: 35:12، یشوع: 20:6\f*
\v 25 اگر تِم فٲصلہٕ کرن زِ قٲتلن اوس یہ نفر قتل کرنُک منصوبہ بنوومُت تیٚلہ ہیٚکن نہٕ تِم تس پننِس شہرس منٛز روزنُک اجازت دِتھ۔ وۅنؠ اگر تِمو فٲصلہٕ کۅر زِ یہ قتل چُھ الغٲبہٕ سپُدمُت، تیٚلہِ چُھ تِمن قٲتِل مقتول سنٛدیو رشتہٕ دارو دٔسؠ قتل کرنہٕ نِش بچاوُن۔ تِم گژھن قٲتلس تِمو شہرو منٛزٕ کُنہ اکِس شہرش منٛز سوزٕنؠ یتہِ سُہ محفوظ روزِ تہٕ سُہ روزِ تۅتام تٔتؠ یۅتام سردار کاہن وفات کرِ۔ امہِ پتہٕ ہیٚکہ قٲتِل پنُن گرٕ واپس گٔژھتھ، تکیازِ مرن وٲلؠ سنٛدین رشتہٕ دارن چُھنہٕ بدلہٕ ہیٚنُخ کانٛہہ حق۔
\p
\v 26 مگر یۅتام سردار کاہن زنٛدٕ چُھ، تۅتام یُس شخص تتھ محفوظ شہرس منٛز چُھ تس پزِ نہٕ تمہ شہرٕ منٛزٕ نیرُن۔
\v 27 وۅنؠ اگر سُہ تمہِ شہرٕ منٛزٕ دراو، تہٕ مقتول سنٛدؠ کانٛسہِ رشتہٕ دارن اگر سُہ وُچھ تمِس رشتہٕ دارس چُھ سُہ قتل کرنُک اجازت، تہٕ لوٗکھ گژھن نہٕ تس رشتہٕ دارس تمسنٛدِ قتلٕکؠ قصوروار ٹھہراوٕنؠ۔
\v 28 قٲتلس پزِ تٔتھؠ شہرس منٛز روزُن یتہ سُہ سردار کاہن سنٛدِس مرنس تام محفوظ روزِ۔ تمہ پتہٕ سپدِ سُہ انتقامہٕ نِشہ محفوظ، تکیازِ سردار کاہن سُنٛد مرُن ییہِ تمہِ قتلُک کفار تصوُر کرنہٕ۔ امہِ پتہٕ ہیٚکہ قٲتِل پنُن گرٕ واپس یِتھ۔
\p
\v 29 توٚہؠ یتہِ تہِ ٲسیٚو توٚہہِ پزِ ہمیشہ یمن قانونی کاروٲین ہُنٛد پابنٛد روزُن۔
\p
\v 30 اگر کانٛسہِ کانٛہہ شخص قتل کرنُک الزام آسہ تہٕ یمس پٮ۪ٹھ یہ الزام آسہ تمِس ییہِ صِرف تتھ صورتس منٛز پھٲسؠ دنہٕ ییٚلہ سُہ کانٛسہِ یہ کران وُچھمُت آسہ۔ گواہ گژھن اکہِ کھۅتہٕ زیادٕ گواہ گژھن آسٕنؠ۔ اگر صرف اکھ گواہ آسہ تیٚلہ ییہِ نہٕ کانٛسہِ پھٲسؠ دِنُک اجازت دِنہٕ۔\f + \fr 35‏:30 \ft اِستِثنا: 17:6، متی: 18:16\f*
\p
\v 31 اگر کانٛہہ قٲتِل آسہ یمِس پٔزؠ پٲٹھؠ پھٲسؠ دِنؠ آسہ، فدیہ رٹِتھ گژھِ نہٕ سُہ یلہٕ تراونہٕ یُن۔ تمِس گژھِ پھٲسؠ دِنہٕ ین۔
\p
\v 32 اگر کانٛہہ تِتھِس شہرس منٛز ژٔلِتھ گو یتہِ سُہ محفوظ روزِ تہ تٔمس چُھنہٕ توٚہہِ پونٛسہٕ دِنُک اجازت دیٚون یُتھ سُہ سردار کاہن سنٛدِ مرنہٕ برونٛہےٕ گرٕ ینُک اجازت حٲصِل کرِ۔
\p
\v 33 توٚہہِ پزِ تِمن لوٗکن پھٲسؠ دِنؠ یمہٕ پٔزؠ پٲٹھؠ بییَن قتل چھِ کران۔ اگر توٚہہِ تہِ کۅرو نہٕ توٚہؠ ٲسیٚو تمہٕ لوٗکھ یمہٕ یتھ ملکس منٛز روزن وٲلؠ میانہِ باپتھ نا قٲبل قبول آسن۔ یُس تہِ زٲنِتھ مٲنِتھ کانٛسہٕ بے قصورس قتل آسہ کران سُہ گژھِ پھاسہِ کھسُن۔\f + \fr 35‏:33 \ft اِستِثنا: 21:7\f*
\v 34 بہٕ چُھس یہُوواہؔ تہٕ بہٕ چُھس توٚہہِ بنی اسرائیل ین منٛز روزان، لہٰذا چُھنہٕ توٚہہِ یہ زمیٖن کانٛہہ ناحقہ قتل کٔرِتھ گنٛدٕ کرنُک اجازت یۅتام نہٕ تس سزا ییہِ دِنہٕ۔"\f + \fr 35‏:34 \ft اِستِثنا: 18:24\f*
\c 36
\p
\v 1 منسیؔ قبیلہٕ کہِ جلعادؔ خاندانٕکؠ قٲید، مکِیر سُنٛد اولاو گےَ اکہِ دوٚہہ موسیٰؔ ہَس تہٕ اسرائیلی قومہٕ کیٚن باقی خاندانہٕ کیٚن قٲیِدن نِش۔
\v 2 تِمو ووٚن موسیٰؔ ہس، "سانہِ سردار، یہُوواہنؔ دِتُےٕ ژےٚ حکم زِ سۅ زمین دِیو اسرائیلی قبیلن منٛز چیٖرِ ترٲوِتھ بٲگرِتھ تاکہ یہ فٲصلہٕ سپدِ زِ کُس ونڈٕ کُس انٛد رٹہِ۔ یہُوواہنؔ دیُت توٚہہِ یہ حکم تہِ زِ سۅ زمین یۅسہ سٲنِس بنی اسرائیلی سٲتھی صِلافحاد سنٛز چھےٚ دِیو تمؠ سنٛزن کوریٚن۔
\v 3 وۅنؠ اگر یمہٕ کورِ دویمیٚن اسرائیلی قبیلہٕ کیٚن مردن سٟتؠ خاندر کرن تیٚلہِ روزٕ نہٕ سۅ زمین سانہِ قبیلٕچ۔ سۅ میلہ دویمیٚن قبیلہٕ کیٚن لوٗکن۔ لہٰذا روزِ نہٕ سٲنؠ کینٛہہ زمین اسہِ نِش۔
\v 4 ییٚلہ جشنِ یوبلی مناونُک وری واتہِ، یمہِ وزِ موٚلؠ ہیٚژمٕژ سٲرےٕ زمین پننٮ۪ن اصلی وٲرث درن واپس دنہٕ ییہِ تہٕ سۅ زمین یۅسہ صلافِحاد سنٛز ٲس ییہِ تمہِ قبیلہٕ کیٚن تِمن نفرن دنہٕ یمن سٟتؠ تمؠ سنٛزو کوریٚو خاندر کۅرمُت آسہ۔ یتھ کنؠ ییہِ سٲنؠ کینٛہہ زمیٖن سۅ زمیٖن یۅسہ اسہِ مٲلؠ وراثت چھےٚ اسہِ نِشہ ننہٕ، تہٕ أسؠ آسو نہٕ پتہٕ زانٛہہ تمِکؠ مٲلک۔\f + \fr 36‏:4 \ft یوبلی سٟتؠ چُھ مراد "یوبلی ہنٛد ؤری" یُس کُنَتٲجی ورین ہنٛد چکر پتہٕ پنٛژٲہِم ؤری اوس (وُچھِو احبار 25:8-55)\f*
\v 5 یہُوواہنؔ ووٚن موسیٰؔ ہس زِ یمن کیاہ چُھ ونُن، لہٰذا ووٚن موسیٰؔ ہن تِمن، "منسیؔ سنٛدِ قبیلٕکؠ لوٗکھ چھِ ٹھیک ونان۔
\v 6 یہ چُھ تہِ یہ یہُوواہؔ صِلافحاد سنٛزن کوریٚن ونان چُھ زِ توٚہہ منٛزٕ یُس یس سٟتؠ یژھِ سۅ کرِ تس سٟتؠ خاندر، مگر توٚہہِ پزِ ضروری پننِسےٕ قبیلس منٛز کانٛسہِ سٟتؠ خاندر کرُن۔
\v 7 یتھٕ پٲٹھؠ سپدینہٕ بنی اسرائیلٕچ وراثت اکہِ قبیلہٕ پٮ۪ٹھٕ بییِس قبیلس کُن منتقل۔ اسرائیل لُک پرٛتھ کانٛہہ رٹہِ پننہِ قبیلٕچ سۅ وراثت یۅسہ تس جدٕ اجدادن ہنٛز آسہ۔
\v 8 یۅسہ زٔنؠ پننِس مٲلؠ سنٛدِ زمیٖنٕچ وٲرث آسہ سۅ ہیٚکہِ خاندر کٔرِتھ مگر تمِس چُھ پننِس قبیلہٕ کِس کانٛسہِ نفرس سٟتؠ خاندر کرُن۔ یتھٕ پٲٹھؠ کرٕ پرٛتھ کانٛہہ اسرائیلی تمہِ زمیٖنٕچ حفاظت یۅسہ تس جد اجدادن ہنٛز آسہ۔
\v 9 اکہِ قبیلمچ زمیٖن پزِنہٕ بییِس قبیلس دِنؠ۔ پرٛتھ اکِس اسرائیلی قبیلس پزِ تتھ زمیٖنس رٲچھ کرٕنؠ یۅسہ تس جدٕ اجدادن نِش میجمٕژ آسہ۔
\p
\v 10 صِلافحاد سنٛزو کوریٚو کۅر تی یہ یہُوواہنؔ موسیٰؔ ہس فرموو۔
\v 11 پانٛژوٕیو کوریٚو محلاہؔ، تِرضاہ، حُجلاہ، مِلکاہؔ تہٕ نُوعاہنؔ کۅر پننٮ۪ن پِتٕر بایَن تہٕ مٲلؠ سنٛدین رشتہٕ دارن سٟتؠ خاندر۔
\v 12 یمن مردن سٟتؠ تِمو خاندر کۅر تِم ٲسؠ منسیؔ سنٛدِ قبیلٕکؠ، اوٕ کِنؠ روز تہنٛز زمیٖن تہنٛدِس مٲلؠ سنٛدِس قبیلس تہٕ خاندانس منٛز۔
\p
\v 13 یم ٲسؠ تِم حکم تہٕ احکام یم یہُوواہنؔ موسیٰؔ ہس اسرائیل ین وننہٕ خٲطرٕ دِتؠ ییٚلہِ تِم موآبؔ کیٚن مٲدانن منٛز یردن درؠ یاوس نکھٕ یریحو اپارِ ٲسؠ۔
