\p
\v 17 بنی عزجادؔ ۂکؠ زٕ ساس ترٛے ہتھ تہٕ زٕ توٚوووہ نفر۔
\p
\v 18 ادُونقامؔ سنٛدیو اولادو منٛزٕ 667 نفر۔
\p
\v 19 بِگویؔ سنٛدیو اولادو منٛزٕ زٕ ساس ستہٲٹھ نفر۔
\p
\v 20 بنی عدینؔ ۂکؠ شےٚ ہتھ پنٛژونٛزاہ نفر۔
\p
\v 21 حِزقیاہؔ خاندانہٕ منٛزٕ ٲسؠ بنی اطِیر 98 نفر۔
\p
\v 22 بنی حاشُومؔ ۂکؠ 328 نفر۔
\p
\v 23 بضَیؔ سنٛدیو اولادو منٛزٕ 324 نفر۔
\p
\v 24 بنی خارِیفٕکؠ اکھ ہتھ تہٕ باہ نفر۔
\p
\v 25 بنی جِبعونؔ ۂکؠ پنٛژنمتھ نفر۔
\p
\v 26 بیت لحمؔ تہٕ نطُوفہ کیٚو لوکو منٛزٕ ٲسؠ 188 نفر۔
\p
\v 27 عنتوتؔ کیٚو لوٗکو منٛزٕ ٲسؠ اکھ ہتھ اٹھووُہہ نفر۔
\p
\v 28 عزماوتؔ کیٚو لوٗکو منٛز 42 نفر۔
\p
\v 29 قریتؔ یعریمؔ کفرہؔ تہٕ بیروتؔ کیٚو لوٗکو منٛزٕ 743 نفر۔
\p
\v 30 رامہ تہٕ جِبعؔ کیٚو لوٗکو منٛزٕ 621 نفر۔
\p
\v 31 مِکماسؔ کیٚو لوٗکو منٛزٕ 122 نفر۔
\p
\v 32 بیت ایلؔ تہٕ عیؔ کیٚو لوٗکو منٛزٕ 123 نفر۔
\p
\v 33 بیٚیہِ اکہ لۅکٹہِ شہرٕ نبُو کیٚو لوٗکو منٛزٕ ٲسؠ 52 نفر۔
\p
\v 34 عیلامؔ ناوٕکہ بیٚیہِ اکہ لۅکٹہِ شہرٕ پٮ۪ٹھٕ اکھ ساس زٕ ہتھ ژُونزاہ نفر۔
\p
\v 35 بنی حارِمؔ پٮ۪ٹھٕ 320 نفر۔
\p
\v 36 یریحُوؔ کیٚو لوٗکو منٛزٕ 345 نفر۔
\p
\v 37 لُود، حادیدؔ تہٕ اونوؔ کیٚو لوٗکو منٛزٕ 721 نفر۔
\p
\v 38 بنی سناآہ پٮ۪ٹھٕ ترٛے ساس نو ہتھ تہٕ ترٕ نفر۔
\p
\v 39 امہِ پتہٕ ٲسؠ کاہن یعنی یسوعؔ سٕنٛدِ خاندانہ منٛزکؠ۔
\q1 بنی یدعیاؔہ 973 نفر۔
\p
\v 40 بنی اِمیرؔ اکھ ساس تہٕ دُونزاہ۔
\p
\v 41 بنی فشحُورؔ اکھ ساس زٕ ہتھ تہٕ سٔتتٲجی۔
\p
\v 42 بنی حارِم اکھ ساس سداہ۔
\p
\v 43 امہِ پتہٕ ٲسؠ لاوی یعنی بنی ہودِواہ خاندان منٛزکؠ یسوعؔ تہٕ
\p قدمی ایلؔ کیٚو اولادو منٛزٕ 74 نفر۔
\p
\v 44 تہٕ گیٚون والیٚو فَردو منٛزٕ ٲسؠ 148 نفر، یم سٲری ٲسؠ بنی آصفؔ قبیلو انٛدرٕ۔
\p
\v 45 منٛدرٕکؠ 138 رٲچھ در تہِ ٲسؠ واپس آمٕتؠ، یم سلُومؔ، اطِیر، طلمُون، عقُوبؔ، خطِیطاؔ تہٕ سوبیؔ، قبیلو منٛزٕ ٲسؠ۔
\p
\v 46 مندرن ہنٛدؠ کینٛہہ خٲدم تہِ ٲسؠ آمٕتؠ۔ تم ٲسؠ ضیحاؔ، حسُوفاؔ تہٕ طبعُوتؔ قبیلن ہنٛدؠ۔
\p
\v 47 قروسؔ، سِیغا، فدونؔ قبیلہٕ۔
\p
\v 48 لِبانہؔ، حجابہ تہٕ شملیؔ قبیلہٕ۔
\p
\v 49 حنانؔ، جِدّیلؔ تہٕ جحرؔ قبیلہٕ۔
\p
\v 50 رَآیاہؔ، رصینؔ تہٕ نقُودا قبیلہٕ۔
\p
\v 51 جزّامؔ، عُزّاؔ تہٕ فاسخ قبیلہٕ۔
\p
\v 52 بسَیؔ، معُونِیمؔ تہٕ نفُوشسِیم قبیلہٕ۔
\p
\v 53 بقبوقؔ، حقُوفاؔ تہٕ حرحُورؔ قبیلہٕ۔
\p
\v 54 بضلِیت، محِیدؔا تہٕ حرشاؔ قبیلہٕ۔
\p
\v 55 برقوُسؔ، سِیسراؔ تہٕ تامحؔ قبیلہٕ۔
\p
\v 56 نضیاحؔ تہٕ خطِیفاؔ قبیلہٕ۔
\p
\v 57 بادشاہ سُلیمانؔ سنٛدین خٲدمن ہنٛدؠ گوڈنِچہ بھرتی ہنٛدؠ کینٛہہ اولاد یم آمٕتؠ ٲسؠ تمن منٛز ٲسؠ۔
\p سُوطیؔ، سُوفرت تہٕ فرِیدا قبیلہٕ۔
\p
\v 58 یعلہ، درقُونؔ تہٕ جِدّیلؔ قبیلہٕ۔
\p
\v 59 سفطیاہؔ، خطِیل، فُوکرت ضبائِم تہٕ امُونؔ قبیلہٕ۔
\p
\v 60 مندرن ہنٛدیو خٲدمو تہٕ سُلیمانؔ سنٛدیو خدمت گزارو تہٕ بھرتی مُزورن ہنٛدیو اولادو منٛزٕ ٲسؠ یکہٕ وٹہٕ 392 نفر آمٕتؠ۔
\p
\v 61 تہٕ یم لوٗکھ تل ملحؔ، تل حرساؔ، کرُوبؔ، ادُّون تہٕ اِمّیر قصبو پٮ۪ٹھٕ آمٕتؠ ٲسؠ تِمن ہُند اوس نہٕ پتہےٕ کٔمہِ قبیلٕکؠ چھِ۔ اسرائیلی چھا کِنہ نَہ۔
\v 62 دِلایاہؔ، طُوبیاؔہ، نقُودا 642 نفر۔
\p
\v 63 کینٛہہ پادرؠ تہِ آے واپس یم حبایاہؔ، ہقوصؔ تہٕ برزِلّیؔ سنٛدیو اولادو منٛزٕ ٲسؠ۔ یمؠ جِلعادی برزِلّیؔ سنٛزو کوریٚو منٛزٕ أکِس کورِ سٟتؠ خاندر کریو تہٕ تمسےٕ کورِ ہنٛدس ناوس سٟتؠ رودؠ منسوٗب۔
\v 64 تِمو کٔر نسب نامو منٛز پننؠ سُنٛد تلاش یۅسہ نہٕ کُنہِ درایہ۔ تِمہٕ ٲسؠ نہٕ کاہن قرار دِنہٕ آمٕتؠ۔ تمن اوس نہٕ کاہنن ہنٛدؠ حقوق تہٕ فرائض تھاونک اجازت تکیازِ یمن ہنٛد ناو اوس نہٕ نسب نامن منٛز لبنہٕ یوان۔
\v 65 یہُودؠ کٲکِم سنٛدِ فرمانہٕ مطٲبق آو تِمن وننہٕ زِ تم کھیٚن چین نہٕ تۅتام پٲکیزٕ چیزو منٛزٕ یُس کاہنو خٲطرٕ مخصوص چُھ یۅتام تہٕ کانٛہہ کاہن خدایہ سٕنٛدِ گرُک مٲلکھ پننٕنؠ فرض نکھٕ وٲلِتھ خدایس پرِژھ زِ اتھ صورتِ حالس کیاہ کرو۔ \f + \fr 7‏:65 \ft اوریمؔ تہٕ تمّیِم چھِ عِبرٲنؠ زبانہِ ہُنٛد اکھ نقل، تم ٲس شاید کُنہٕ قسمٕکؠ چیز یم کاہن خدا سنٛز مرضی ہنٛدِ تعین کرنہٕ خاطرٕ استعمال چھِ کران۔ \f*
\lf
\v 66 کُلہم پٲٹھؠ آے دویِہ تٲجی ساس ترٛے ہتھ تہٕ شیٹھ لوٗکھ یہُودیہ واپس\f + \fr 7‏:66 \ft یہِ چُھ واپس یِنہٕ والٮ۪ن جلایہِ وطنِیَن ہُنٛد کُل تعداد\f*
\p
\v 67 اتہ ٲسؠ ستتھ ساس ترٛے ہتھ تہٕ ستہٕ ترٕ مرد تہٕ زنانہٕ خٲدم تہٕ گیون والیو منٛزٕ 245 مرد تہٕ زنانہٕ۔
\p
\v 68 بنی اسرائیل یو انؠ بابلہٕ پٮ۪ٹھٕ 736 گُرؠ، 245 خر،
\v 69 435 اونٹ تہٕ شےٚ ساس ستھ ہتھ تہٕ وُوہہ خر۔
\p
\v 70 کینٛژو آبٲئی خاندانکیٚو زِٹھیو دِتؠ ہیکل نوِ سرٕ تعمیر کرنہٕ باپتھ تحفہ۔
\p حٲکمن دِتؠ خزانہٕ منٛزٕ 8 کلو سۅن خدایہ سٕنٛدِس گرس منٛز استعمال سپدنہٕ باپتھ 50 بَولہٕ تہٕ کاہنو خٲطرٕ 530 پۅشاک۔
\p
\v 71 باقی خاندانو ہنٛدیو کینٛژو زِٹھیو دتؠ خدایہ سٕنٛدِ گرٕکہِ تعمیرٕ باپتھ 153 کلو سۅن تہٕ اکھ ساس ژور ہتھ تہٕ شیٹھ کلو رۅف چٲنٛدؠ۔
\p
\v 72 یہِ باقی لوکو دیُت کاہنو باپتھ 153 کلو سۅن، اکھ ساس ترٛے ہتھ ترٕ کلو رۅف چاندؠ تہٕ 67 نٲلؠ پلو۔
\v 73 لہٰذا لٔگؠ کاہن، لاوی، رٲچھ در، گیٚون وٲلؠ خدایہ سٕنٛدِ گرٕکؠ خٲدم تہٕ واریاہ عام لوٗکھ یہُوداؔ کیٚن تمن شہرن منٛز بسنہٕ یتہِ تمن پنٕنؠ جدٕ اجداد روزان ٲسؠ۔ یم ٲسؠ سٲری بنی اسرائیلی۔ ستن ریتن اندر اندر وٲتؠ تمام بنی اسرائیلی لوٗکھ پن پننؠن شہرن تہٕ لٔگؠ تتہِ بسنہِ۔
\c 8
\p
\v 1 سٔتمہِ رٮ۪تکہِ گۅڈنکہِ دوٚہہ آو لُکہٕ ارساتھا ژٔسِتھ آبہٕ پھاٹکس نِشہ شہرٕ کِس کُھلہٕ ژُؤتِس پٮ۪ٹھ۔ تِمو ووٚن کٲتِب عزراؔ ہس موسیٰؔ سُنٛد لیٚوکھمُت شرِیعت ناوُک دستاویز تورات یُس زن پانہٕ یہُوواہؔ ہن اسرائیلی لوٗکن عنایت کوٚرمُت اوس۔ تاکہِ تم کرن امہ کیٚن قانونن پٮ۪ٹھ عمل۔ \f + \fr 8‏:1 \ft عذرا 3:1\f*
\v 2 عزراؔ یُس خدا سٕنٛدِس گرس منٛز قۅربٲنی کرنٕچ خدمت انجام دِوان اوس أنؠ تورات تہٕ تھٲون لوٗکن برونٛہہ کنہِ، مردن مستوراتن تہٕ باقین یمہٕ اتھ پرنس تہٕ سمجھنس لایکھ ٲسؠ۔ یہِ اوس امہِ ؤریکہِ سٔتمہِ ریٚتُک گۅڈنیُک دوٚہہ۔ \f + \fr 8‏:2 \fq یہِ اوس امہِ ؤریکہِ سٔتمہِ ریٚتُک گۅڈنیُک دوٚہہ۔ \ft سٔتِم رٮ۪تھ چُھ یہودی کلینڈرَس منٛز تشری ہُنٛد رٮ۪تھ۔ امہِ ریتُک گۅڈنیُک دوٚہہ آو ہردس منٛز، یُس عام طور 21 ستمبر چُھ آسان۔ \f*
\v 3 تہٕ تٔمؠ پٔر أتھؠ پھاٹکس نکھٕ شہرٕ کِس ژُؤتِس پٮ۪ٹھ تھدِ ہٹہِ صبحس ژیر تام یہِ کتاب۔ تٔمؠ پٔر یہِ سارنی لوٗکن، مستوراتن، مردن تہٕ باقی تمن لوٗکن بروںنٛہہ کنہِ یم یہِ سمجھنس لایق ٲسؠ۔ سٲری رودؠ کن دٲرِتھ اتھ شریعتس بوزنہِ یۅسہ اتھ موسیٰؔ سٕنٛدِس اتھ شریعتکِس دستاویزس پٮ۪ٹھ ٲس۔
\v 4 کٲتِب عزراؔ رود تتھ تھزِ چوکہِ پٮ۪ٹھ ۅدٕنؠ یوسہٕ لوٗکو امہِ باپتھ بنٲومٕژ ٲس۔ أمِس دٔچھنہِ پاسہٕ ٲسؠ متّتیاہؔ، سمعؔ، عنایاہؔ، اُوریاہؔ، خِلقیاہ تہٕ معسیاہؔ تہٕ کھووٕرِ طرفہٕ ٲسِس فِدایاہؔ، مِسائیلؔ، ملکِیاہؔ حاشُومؔ، حسبدانہؔ، ذکریاہؔ تہٕ مسلامؔ
\v 5 عزراؔ کھوٚت چوکہِ پٮ۪ٹھ تاکہِ سٲری لوٗکھ ہیٚکن أمِس وُچِھتھ۔ تٔمؠ کھول یہِ دستاویز، یُتھے تٔمؠ یہِ کھولُن ہیٚوت سٲری لوٗکھ سپدؠ اِستادٕ
\v 6 عزراؔ ہن کٔرؠ گۅڈٕ خدایہ سنٛدؠ تعریف بیان۔ ساروٕے لوکو تُلؠ اتھہٕ تھوٚد یہِ ہاونہٕ خٲطرٕ زِ تم تہِ چھِ اتھ عبادٔژ منٛز شٲمل۔ ذکرِ ہنٛدس ٲخرس پٮ۪ٹھ ووٚن تِمو اکؠ سےٕ آوازِ منٛز "اسہِ چُھ منظور۔ أتھؠ سٟتؠ ؤتھؠ تہٕ نمییہِ بوٚن یُتھ زِ تہنٛدؠ بُتھؠ لٔگؠ زمینس سٟتؠ۔ تہٕ کٔرکھ خداوند سنٛز عبادت۔ \f + \fr 8‏:6 \ft تِمو نۅمرٲوؠ عٲجزی سان پنٕنؠ کَلہٕ۔ کۅٹھؠ بۅن کُن کٔرِتھ زمینس اتھٕ لٲگِتھ۔ یہِ اوس خدا سٕنٛدِ عبادت تہٕ خراج تحسین پیش کرنُک اِشارٕ۔ \f*
\v 7 امہِ پتہٕ ؤتھؠ یسوعؔ، بانیؔ، سرِبیاہؔ، یامن، عقُوبؔ، سبتیؔ، ہودیاہؔ، معسیاہؔ، قلیتاؔہ، عزریاہؔ، یُوزابادؔ، حنان، فِلایاہ یم سٲری لاوی ٲسؠ، تہٕ اتہِ موجود لوٗکن برونٛہہ کنہِ کٔرکھ یمن قانونن تہٕ حکمن ہنٛز وضاحت تہٕ تشریح۔
\v 8 تِمو پٔرؠ پوٗرٕ دھیانہٕ سان خدایہِ سنٛدؠ یم دستاویز تہٕ تورُکھ لوٗکن یہُنٛد معنہِ تہٕ مفہوم فکِر تاکہِ لوٗکھ زانن زِ عذراؔ تہٕ باقیو کیاہ پوٚر۔
\v 9 ییٚلہِ لوٗکو زون زِ پرنہٕ کیاہ آو تِمو لوگ غمگین سپدِتھ بڈِ ہٹہِ ودُن۔ لہٰذا ووٚن علاقٕکؠ حٲکم نحیمیاہؔ ہن مذہبی کاہن عزراہنؔ تہٕ فقِیہہن تہٕ تِمو لاویو یمن لوٗکن یمن یم معنہِ مفہوم فِکرِ تاران ٲسؠ، "از چُھ سانہِ باپتھ وۅرسُک دوٚہہ ییٚلہِ زن اسہِ پننِس خدا سنٛز عبادت کرٕنؠ پزِ۔ مہ کٔریوٚ ماتم مہ ژٔھٹیٚو باکہٕ۔
\v 10 امہِ پتہٕ ونُکھ نحمیاؔہ ہن نیریو وُنؠ پنُن پنُن گرٕ، رُت کھیٚن چیٚنہٕ کٔریو، میٹھ پہن شربتھاہ چیو تہٕ دِیو تمن تہِ یمن نہٕ یہِ لٔزیز کھیٚن چیٚنہٕ دستیاب چُھ۔ تکیازِ از چُھ مقدس دوٚہہ پننِس خدایہ سنٛز عبادت کرنُک دوٚہہ۔ مہ روزیو بیزار تکیازِ خداوند سنٛز دنہٕ ینہٕ واجِنؠ فرحت دِیو توٚہہ ہمت۔
\v 11 تہٕ لاوی تہِ روٗدؠ لوٗکن یی ونان یمہٕ وُنہ تہِ ودن باکہٕ دِوان ٲسؠ۔ "ہے از چُھ مقدس دوٚہہ ژھۅپہٕ کٔریو مہ روزیوٚ بیزار۔
\v 12 لہٰذا دراے سٲری لوٗکھ گرٕکُن، باقین سٟتؠ بٲگرتھ کینٛہہ کھیٚنہِ چیٚنہِ۔ تم ٲسؠ واریاہ خوش زِ تمن توٚر فکرِ یہِ کینٛژھا عذراؔ ہن پوٚر تہٕ وضاحت کٔر۔
\v 13 امے سٔتمہِ رٮ۪تکہِ دویمہِ دوٚہہ سمٕکھؠ سٲری ونٛڈٕ زِٹھؠ کاہن، لاوی، کٲتِب عزراؔہس۔ تم ٲسؠ یژھان تورات مذید دھیانہٕ سان پرٕنؠ یۅسہ زن یہُوواہؔ ہن موسیٰؔ ہس عنایت کٔر۔ تم ٲسؠ اتھ پورٕ زانُن یژھان۔
\v 14 تِمو زون تورات چھےٚ ونان زِ یہُوواہؔ ہن ووٚن موسیٰؔ ہس سٔتمہِ ریٚتہٕ کِس وۅرسس پٮ۪ٹھ، لوٗکن حکم دیُن زِ تم روزن پاریٚن منٛز۔ تاکہِ تم پاون یاد زِ تہنٛدؠ جَد و اجداد ٲسؠ مِصرٕ منٛزٕ نیرنہٕ پتہٕ وٲرانن منٛز پکان روزنہٕ وزِ پاریٚن منٛز رودؠ مٕتؠ۔ \f + \fr 8‏:14 \ft احبار 23:42\f*
\v 15 تِمو ہیٚوچھ یتہِ زِ تمن پزِ پارے دِنؠ سارنےٕ شہرن، قصبن تہٕ یروشلمسؔ منٛز زِ لوٗکن پزِ پہاڑن کُن کھسُن تہٕ لنٛگ لنجہِ والنہِ۔ یم گژھن زیتون، کٔھزر تہٕ سایہِ دار کُلین ہنٛزٕ لنجہِ آسنہِ۔ تمن پزن یموےٕ سٟتؠ پننہِ پارِ کھڑا کرنہِ تہٕ وۅرسہٕ کیٚن دوٚہُن یمنےٕ منٛز روزُن یم دستاویز ٲسؠ یی لوٗکن ہیٚچھٕ ناوان۔ یہِ شریعتس منٛز لیکھِتھ اوس۔
\v 16 اوے تہٕ دراے لوٗکھ پننیٚو بٔستِیو منٛزٕ نیٚبر تہٕ أنِکھ لنجہٕ تہٕ لنٛگؠ ژھٲرؠ ژھٲرؠ پننہِ پارِ بناونہٕ خٲطرٕ۔ تِمو بناوِ پارِ پننٮ۪ن گرٕ کیٚن پشَن پٮ۪ٹھ تہٕ مندرن ہنٛدین آنٛگنن منٛز، آبہٕ پھاٹہٕ کن نکھٕ ژُوتین پٮ۪ٹھ۔ تہٕ افرائیمی پھاٹکس نکھٕ ژُو ؤتھِس پٮ۪ٹھ۔
\v 17 بابلؔ پٮ۪ٹھٕ پھیرِتھ ینہٕ والیٚوساروےٕ اسرائیل یو بناوِ پارِ تہٕ لٔگؠ بسنہِ۔ اکہ ہفتہٕ باپتھ اسرائیلی لوکو اوسنہٕ اۅتام زنٛہے امہِ آیہ پنُن بوٚڈ دوٚہہ منوومُت، نونؔ سٕنٛدِس نیٚچوِس یسوعؔ سٕنٛدِ پٮ۪ٹھٕ۔ یمؠ اسرائیلی اتھ علاقس منٛز واتنٲومٕتؠ ٲسؠ۔ تم ٲسؠ گۅڈنِکہِ پھرِ یہِ دوٚہہ مناوان۔ تہٕ لوٗکھ ٲسؠ بڈٕ خوش۔
\v 18 ہفتہٕ کیٚن سارنی دوٚہُن رود عزراؔ خدا سںنٛدؠ قانون لوٗکن برونٛہہ کنہِ بڈِ بڈِ پران۔ ستن دوٚہُن منوو تِمو یہِ بوٚڈ دوٚہہ۔ ٲٹھمہِ دوٚہہ دیُت تِمو سارنی لوٗکن اکسےٕ جایہ سمکھنُک ناد، تاکہِ تم پولُسنؔ یہِ بوٚڈ دوٚہہ انٛد واتناونُک رسٕم۔ یی اوس دستاویزُک تہِ حکم۔
\c 9
\p
\v 1 دوٚیہ دوٚہؠ پتہٕ آے اسرائیلی لوٗکھ بیہِ سمِتھ، پننؠن گونہن پٮ۪ٹھ افسوس کرنہٕ موکھٕ، تم رودؠ فاقے۔ تِمو لٲگؠ جنٛدٕ پلو تہٕ کلن بٔرکھ لژھ۔ \f + \fr 9‏:1 \ft تمام اسرائیلی آے عوٲمی روزن منٛز یِکوٹہٕ۔ اتھ سٕتؠ اوس دعاتوبہٕ تہٕ ماتمی علامژ باپتھ ماتمی پلو لاگٕنؠ۔ \f*
\v 2 اسرائیلی لوٗکو کوٚڈ پنُن پان الگ پر ملکو پٮ۪ٹھٕ آمتیٚو لوٗکو نِشہ۔ تم سمییہ تہٕ کوٚرکھ پننیٚو گونہو نِشہ توبہٕ تہٕ پننؠن جدن ہنٛدین ویکھتیٚن کارن ہُنٛد اعتراف۔
\v 3 لاوی رودؠ أتؠ تہٕ بوزٕکھ یہُوواہؔ سنٛز تورات پورٕ تریٚن گھنٹن۔ مذید تریٚن گھنٹن رودؠ پننٮ۪ن گونہن ہُنٛد اعتراف کران تہٕ اوٕ پتہٕ نمییہِ بوٚن تہٕ کٔرکھ پننِس خدایہ سنٛز عبادت۔
\v 4 کینٛہہ لاوی یمن منٛز یسوعؔ، بانیؔ، سبنیاہؔ، بُنّیؔ، سرِبیاہؔ تہٕ بیہِ زٕ زٔنؠ یمن منٛز بانیؔ تہٕ کنعانؔ اوس، رودؠ ہیرٕ پاوین پٮ۪ٹھ ودٕنؠ۔ غمزدٕ لہجس منٛز بڈٕ بڈِ پننِس خدایس التجا کران۔
\v 5 پتہٕ ووٚن کینٛژو لاوی لوکو یمَن منٛز یسوعؔ، قدمی ایلؔ، بانیؔ، حسبنیاہؔ، سرِبیاہؔ، ہودیاہؔ، سبنیاہؔ، فتحیاہؔ ٲسؠ لوٗکن "ؤتھِو تھوٚد تہٕ کٔریو تعریف پننِس خدایس، یُس ہمیشہٕ قٲیم چُھ حیات چُھ تہٕ روزِ تہِ۔ "تہٕ مبارک چُھ تُہنٛد شاندار ناو! یہِ گژھہِ سارنٕے نعمتن تہٕ تعریفَن ہیٚور۔
\v 6 ژےٕ چُھکھ سون یہُوواہؔ بیہِ نَہ کانٛہہ، ژیی بنٲوِتھ آسمان یم سارنی بالا تر چھِ، تہٕ یہِ کینٛژھا آسمانن منٛز چُھ زمینہٕ ہیٚور ژیی بنٲوتھ زمین تہٕ یہِ اتھ پٮ۪ٹھ چُھ، ژیی بنٲوِتھ سمندر تہٕ یہِ تمن منٛز چُھ، ژےٕ چُھکھ یُس زندٕ زُوَن زُوو بخشان چُھ۔ تہِ سورےٕ یہِ آسمانن منٛز چُھ زمینہِ ہیٚور چُھ چھی ژیی عبادت کران۔ \f + \fr 9‏:6 \ft آفتاب، زوٗن تہٕ تارک\f*\f + \fr 9‏:6 \ft خروج: 20:11 اِستِثنا: 6:4\f*
\v 7 ژےٕ چُھکھ یہُوواہؔ! بس ژےٕ چُھکھ خدا۔ یمؠ ابرامؔ ژٲرِتھ اوٚن کٔڈتھ اُورؔ شہرٕ منٛزٕ یتہِ کلدینی روزان ٲسؠ۔ ژیی بنووٕتھن سُہ ابرہامؔ\f + \fr 9‏:7 \ft بابلُک ملک\f*
\v 8 ژیٚہ وُچِھتھ زِ سُہ چُھ دِل و جانہٕ چون وفادار بنٛدٕ۔ ژےٚ دِتتھ تس وعدہ رتہٕ سٟتؠ لٮ۪کِھتھ زِ ژٕ بخشکھ تس تہٕ تسنٛدین زُرین اکھ زمین۔ یہےَ چھےٚ سۅ زمین یتھ پٮ۪ٹھ کنعانی، حِتی، اموریؔ، فِرزی، یبوسی تہٕ جِرجاس لسان بسان ٲسؠ۔ ژےٚ کرُتھ تی یمیٚک ژےٚ وعدہ کوٚرمُت اوسُتھ تہٕ ژٕ چُھکھ ہمیشہٕ رُتےٕ کران۔
\v 9 ژےٚ وچُھتھ پانہٕ یمو مِصری لوکو کوتاہ بدترین سلوک کوٚر سانین اجدادن سٟتؠ۔ ژےٚ بوزَتھ پانہٕ تہنٛزٕ ودن کریکہٕ "مددٕ باپتھ" ییٚلہِ تم بحرِ قُلزمسؔ نکھٕ وٲتؠ۔
\v 10 ژےٚ ٲسےٕ خبر زِ مِصری حٲکم کٲتیاہ بُتھؠ پھرؠ چھِ تہٕ سانیٚن اجدادن سٟتؠ کوتاہ بُرٕ سلوٗک کوٚر تِمو۔ اوے تہٕ ہٲوِتھ ژےٚ معجزٕ فرعونسؔ\f + \fr 9‏:10 \fq فرعونسؔ \ft مِصری بادشاہ\f*\f + \fr 9‏:10 \fq فرعونسؔ \ft فرعون چُھنہٕ اکھ صحیح ناو۔ یہٕ چھِ عنوان خاطرٕ عِبرٲنؠ لفظُک نقل یُس پورٕ مِصرس منٛز حکمران خاطرٕ استعمال اوس یوان کرنہٕ۔ \f*، تسنٛدین عہدٕدارن تہٕ مِصری لوٗکن۔ أمؠ کوٚر ثٲبت چون پوٚز خدا آسُن۔ ژےٚ کۅرتھ پنُن پان معروف تہٕ ونتہِ چُھوو معروف۔
\v 11 ژےٚ کۅرتھ سمندر دون حصن منٛز تقسیم سارنی اسرائیلی لوٗکن دیدمان۔ تہٕ دیُت تھکھ سمندرس تار خوشک زمینہِ پیٚٹھؠ مگر مِصری فوج کۅرتھن آبس منٛز غرق۔ تم پٔھٹؠ اکہ کنہِ ہنٛدؠ پٲٹھؠ سرٔنِس آبس منٛز۔
\v 12 دوٚہس پکنٲوؠ تھکھ ژےٚ پنٕنؠ لوٗکھ أکِس اُبرٕ لنٛگس پتہٕ پتہٕ یُس تھمب ہیٚو اوس تہٕ راتس أکِس چمکہٕ ونِس نارٕ الاوس یُس اکھ بوٚڈ تھمب ہیٚو اوس۔ یہِ رود تِمن برونٛہہ برونٛہہ وتھ گاشراوان تہٕ منٛزلس کُن پکناوان۔
\v 13 ییٚلہِ سٲنؠ اجداد سیناؔ کیٚن بالن کُن ٲسؠ ژٕ آکھ تِمن برونٛہہ کُن تہٕ آسمانو پیٚٹھؠ لویہِ تھکھ صدا۔ ژےٚ دِتُتھ تمن رُت ھِدایت تہٕ عملہِ لایکھ قانون۔ ژےٚ دتِتھؠ تمن رٕتؠ ضٲبطٕ تہٕ حکم۔
\v 14 ژےٚ ہیٚچھِ نٲوتھکھ تِم سبات کیٚن دوٚہُن ہنٛدؠ رسٕم۔ یہِ دوٚہہ چُھ باقیو دوٚہو منٛزٕ خاص۔ پننِس خٲدم موسیٰؔ سٕنٛدِ دٔسؠ دتِتھ ژےٚ لوٗکن احکام قانون تہٕ اصول۔
\v 15 ییٚلہِ تم بۅچھِ ۂتؠ ٲسؠ ژےٚ سوزتھکھ آسمٲنؠ غذا، ییٚلہ تم تریشہِ ۂتؠ ٲسؠ ژےٚ دِژٕتھ تِمن کنہِ پلہٕ منٛزٕ تریش۔ ژےٚ ونُتھ تِمن کنعانٕچ زمین حٲصِل کرنہٕ مۅکھٕ یۅسہ دِنٕچ ژےٚ تِمن وعدہ اوسُتھ کوٚرمُت۔ \f + \fr 9‏:15 \ft 6:31 یوحنا\f*
\v 16 مگر سٲنؠ اجداد ٲسؠ کِبری تہٕ عقلہِ ڈٔلمتؠ، تِمو کوٚر چٲنؠ حکم ماننَس اِنکار۔
\v 17 تِمو کوٚر چٲنؠ عبادت کرنس اِنکار۔ تِمن چھِنہٕ چٲنؠ معجزٕ یاد یم ژےٚ یہنٛدِ باپتھ کٔرِتھ۔ تِمن آیہ عقل کھیٚنہٕ تہٕ ژےٚ خلاف کٔرکھ بغاوت۔ تِمو کوٚر پنُن زیُٹھ کھڑا یُس تِمن واپس مِصر نیہ ہے۔ یتہِ تِمن واپس غلامی ہُنٛد طوق نٲلؠ گژھِ ہے۔ مگر ژےٕ چُھکھ سون مہربان خدا۔ اسہِ بخشن وول خدا۔ ژےٕ چُھکھ اسہِ پٮ۪ٹھ مہربان تہٕ رحیم۔ ژٕ چُھکھ نہٕ ؤلؠ شرارتس لاینہٕ یوان۔ اتھ برعکس چُھکھ ژٕ اسہِ لول بران۔ اوے ترٲوِتھ نہٕ ژےٚ سٲنؠ اجداد بیکس سیٚکہِ سحراون منٛز تنِ تنہا۔
\v 18 بےشک تھٲوتھکھ نہٕ ژےٚ تم تنِ تنہا۔ یوٚدوے تِمو پننہِ باپتھ اکھ وُژھ معبودن ژور۔ ییٚلہِ زن تِمو اکھ پۅتُل گوٚر یُس ؤژھِس ہیٚو اوس۔ أمِس ؤژھِس متعلق ووٚن یمو زِ سُہ چُھ سون خدا، یمؠ أسؠ مِصرٕ منٛزٕ نیٚبر أنؠ کٔڈتھ۔ یہِ ؤنِتھ کٔر تِمو چٲنؠ بے انتِہا بے عزتی۔ \f + \fr 9‏:18 \ft خروج 32:1-8\f*
\v 19 چونکہِ ژٕ چُھکھ ہمیشہٕ مہربان رودمُت، ژےٚ تٲوتھکھ نہٕ تم سیٚکہ سحراوس منٛز تنِ تنہا تہٕ بیکس۔ دوٚہس رود تمن اکھ تھمب ہیٚو اُوٚبرٕ لونٛگ چانہِ یژھایہِ ہُنٛد وتہٕ ہاوُک بنِتھ تہٕ روتلہِ اکھ تھمب ہِشؠ نارٕ مشٲلؠ، بس تُہنٛدِ منٛزلٕچ وتھ گاشہٕ راوان۔
\v 20 ژےٚ تھووُتھ یمن خٲرُک فرشتہٕ ہِدایتہٕ باپتھ آیہ تن۔ ژےٚ سوزتھکھ آسمٲنؠ کھیٚن ییٚلہِ تِم بۅچھِ ہتؠ ٲسؠ۔ تہٕ سوٗزتھکھ تریش ییٚلہِ تم تریشہٕ ہتؠ ٲسؠ۔
\v 21 ژَتجہن ؤرین تھووُتھ ژےٚ سہراوس منٛز تِہنٛد خیال۔ اتھ سٲرسےٕ وقتس میوٗل تمن پننہِ ضروٗرتُک پرٛتھ کانٛہہ چیز۔ یمن رٔنیو نہٕ پنُن اکھ پلو تہِ تہٕ نَہ کھۅتکھ پٔکؠ پٔکؠ کھۅرن ورم ییٚلہِ زن تم تھکہٕ روس پکان روٗدؠ۔
\v 22 ژےٚ کۅرتھ سانیٚن اجدادن تِتھیٚن دُشمَنن خلاف مدد یمن واریہن قومن پٮ۪ٹھ حکومتھ ٲس تہٕ تِہنٛدس فوجس دیاونووُتھ شکس۔ امہِ سٟتؠ دِتُتھ ژےٚ سانین اجدادن یتھ سٲرسےٕ علاقس منٛز بسنُک موقعہ۔ تِمو کٔر حٲصل سۅ زمین تہٕ تم علاقہٕ یمن شاہِ حسبونؔ راج کران اوس پننہِ شہرٕ سیحونؔ پٮ۪ٹھٕ۔ تہٕ سۅ زمین یۅسہ بادشاہ عوجؔ سٕنٛدِس راجس منٛز ٲس۔
\v 23 ژےٚ بخشِتھ سانین اجدادن تیتؠ شُرؠ زَنتہٕ آسمانس تارکھ۔ ژےٚ واتنٲوتھکھ تِم یتھ علاقس منٛز۔ یوٚت واتناونُک ژےٚ تہنٛدین مالیٚن ماجَن ونمُت اوسُتھ یہِ پننِس تلفس تل اننہٕ باپتھ۔ یُتھ تم تتہِ بسِتھ ہیٚکہٕ ہن۔
\v 24 تِہنٛدؠ شُرؠ مُرؠ وٲتؠ اوٚت تہٕ کوٚرُکھ اتھ زمینس قبضہٕ۔ ژےٚ بنٲوتھکھ تِم اتھ لایکھ زِ تم دِن شِکس اتہِ بسن والٮ۪ن۔ یم کنعانؔ نسلٕکؠ ٲسؠ۔ ژےٚ کٔرؠ تھکھ تم اتھ لایکھ زِ تم لبن اتہِ روزن والین رازن پٮ۪ٹھ فتح تہٕ بسن أتؠ۔ تِمو کوٚر تی یہِ تِمو یمن دشمن لوٗکن سٟتؠ کرُن یوٚژھ۔
\v 25 سانیٚو اجدادو کٔرؠ تم شہر فتح یمن انٛدؠ انٛدؠ فصیل تہٕ ذرخیز زمین ٲس۔ تہٕ تِمو أنؠ قبضس تل تم گرٕ یِم اصل چیزو سٟتؠ بٔرِتھ ٲسؠ، گۅڈے کھننہٕ آمٕتؠ کریرؠ، واریاہ دچھہِ باغ، تہٕ زیتون کُلؠ تہٕ میٚوٕ کُلؠ۔ تِمو یہِ یوٚژھ تہِ کھیٚوکھ تہٕ کھژٕکھ چربی۔ تِمو تُل تمن سارنی چیزن ہُنٛد لطف یہِ ژےٚ تِمن عنایت کۅرتھ۔
\v 26 مگر تم گییہِ ژےٚ بُتھؠ پِھرؠ۔ تِمو کوٚر چانین حکمن ہُنٛد اِنکار۔ تِمو کٔرؠ تم پیغمبر قتل یمو ونُکھ ژےٚ کُن واپس پھیرنہٕ باپتھ۔ تِمو کوٚر تہٕ وونُکھ ژےٚ خلاف۔ تِمو ووٚن ژےٚ خلاف اورُک یورُک تہٕ لٔگؠ بُتھِ۔
\v 27 لہٰذا دیاوٕنوتکھ پننؠن دشمنَن اتھِ شکس تہٕ انتھکھ تلفس تل۔ وُنؠ گو یتُھے تمن دشمنو ایزا لوگ دیٚون تِمو لویی ژےٚ ناد۔ ژےٚ بوزِتھ تہنٛدؠ آلو آسمانہٕ پٮ۪ٹھٕ۔ مگر ژےٕ چُھکھ مہربان۔ ژےٚ سوزؠ تھکھ پنٕنؠ لوٗکھ تمن مدتس۔ یمو زٹھیٚو أنؠ یم دشمنو نِشہ مۅکلٲوِتھ۔
\v 28 مگر یُتھے یمن سہولیت تہٕ امن میوٗل، سانیو اجدادو لاجہِ بیٚیہِ بد تہٕ ویٚکھتؠ کتھٕ ژےٚ کُن۔ ژےٚ بوزُتھ یہُنٛد پانے۔ لہٰذا أنؠ تھکھ دشمن بُلاوِتھ یمو یمہٕ زیر کٔرؠ تہٕ یمن پٮ۪ٹھ پنُن راج قٲیم کوٚر۔ مگر ییٚلہ ییٚلہِ یم واپس ژےٚ کُن پھیرؠ تہٕ ژےٚ مَدتہٕ باپتھ ناد لویہِ ہے، ژےٚ بوزتھکھ آسمانہٕ پیٚٹھےَ۔ ژےٚ مۅکلٲوتھک یم بار بار تکلیفو تلہٕ۔ تکیازِ ژٕ چُھکھ مہربان تہٕ رحیم۔
\v 29 ژےٚ کٔرؠ تھکھ تِم خبردار پننہِ بنٛدگی کُن واپس ینہٕ باپتھ تہٕ چٲنؠ حکم ماننہٕ باپتھ۔ مگر تمَن کھۅت وزِ وزِ کاڈین تہٕ بیٚیہِ بیقل۔ تم ٲسؠ نہٕ چٲنؠ حکم بوزنہٕ خٲطرٕ تیارےٕ۔ تِمو کٔرؠ گناہ چٲنؠ حکم نَہ مٲنِتھ۔ یوٚدوے اکھ انسان یمن مٲنتھےٕ زُوان چُھ۔ چٲنؠ حکم مٲنؠ نہٕ یمو زٲنِتھ مٲنِتھ۔ یم بنییہِ احمق تہٕ کوٚرکھ اِنکار چٲنؠ حکم ماننَس۔
\v 30 واریہس کالس رودُکھ ژٕ یمَن متعلق صبٕر کران۔ ژےٚ کٔرؠ تھکھ یم خبردار یہنٛدین پیغمبرن پٮ۪ٹھ فرشتو دٔسؠ شیٚچھ سوزِتھ۔ تِمو بوزٕ نَہ یمہٕ شیٚچھِ تہِ۔ لہٰذا أنؠ تھکھ ژےٚ ہمساییگی منٛزےٕ یمن دُشمن بُلاوِتھ یمو یم تلفس تل أنؠ
\v 31 چونٛکہ ژٕ رودُکھ یمن پٮ۪ٹھ مہربان۔ اوے کٔرتھکھ نہٕ یم ژےٚ ژکہِ پیٚٹھےَ بُرباد۔ ژےٚ ترٲوتھکھ نہٕ یم زنٛہے بےٚکس۔ یقینن چُھکھ ژےٕ بوٚڈ رحیم تہٕ کریم۔
\v 32 سانہِ خدایہ، ژےٕ چُھکھ عظیم طاقتہٕ وول تہٕ غلبہٕ وول۔ ژےٕ چُھکھ ہمیشہٕ وعدہ وفا کران تہٕ ہمیشہٕ ژُکہِ سان محبت کران۔ وُنؠ چھی أسؠ بس چٲنؠ عبادت کران۔ سانین مشکِلاتن متہٕ دیٖتو کِنہٕ ڈول۔ تِم تمام مشکِلات تہٕ مصیبت أنؠ تو نظرن منٛز یم سانین رازن، سانٮ۪ن زِٹھین، پیغمبرن، کاہنن تہٕ اجدادن آے۔ أسؠ چھِ یم مصیبت لگاتار للہٕ ناوان ینہٕ پٮ۪ٹھٕ اسُورؔ کیٚو رازو اسہِ پٮ۪ٹھ فتح لٔب۔ از تہِ چھِ أسؠ یمنےٕ مصیبتن منٛز ہیٚنہٕ آمٕتؠ
\v 33 اسہِ چھےٚ خبر ژےٚ کۅرتھ اسہِ پٮ۪ٹھ پوٗرٕ انصاف یم مصیبت ۅتلٲوِتھ۔ آ! أسؠ چھِ أتھؠ لایق۔ یہِ گُدرُن چھےٚ سٲنؠ کمٲے۔ اسہِ کٔرؠ ویٚکھٕتؠ کار۔
\v 34 برونٛہہ کالہِ مانؠ نہٕ سانیٚو رازو، زِٹھیٚو تہٕ کاہنو تہٕ سانیٚو اجدادو چٲنؠ حکم تہٕ قانون۔ تِمو کوٚر چانین احکامن نَہ بوزُن۔ نَہ بوٗزِکھ چٲنؠ تنٛمبہٕ۔
\v 35 تمن ٲسؠ پنٕنؠ بادشاہ۔ تِمو تُل پوٗرٕ لطف یمہِ زمینُک یۅسہ ژےٚ تِمن بخشِتھ تہٕ بیٚیہِ چانیٚن عنایِتن ہُنٛد۔ مگر توتہِ کٔر نہٕ تِمو چٲنؠ بندٕگی۔ تِمو کرِنہ بد کامہِ کرنہِ بنٛد۔
\v 36 سانہِ حالٕژ کُن وُچھو۔ از چھِ أسؠ تتھ زمینس پٮ۪ٹھ غلامن ہنٛز زنٛدگی گُذاران۔ یۅسہ ژےٚ سانین جدن بخشِتھ۔ ژےٚ دژٕتھ تمن یہِ زمین تاکہِ تِم تُلن لطف تِمن چیزن ہُنٛد یم ژٕ اتہِ وپداوان چُھکھ۔ مگر از کرتہٕ اسہِ کُن توجہ۔ أسؠ چھِ غلام یتھ زمینَس پٮ۪ٹھ۔
\v 37 یمن رازن ژےٚ اسہِ پٮ۪ٹھ راجُت دِتمُت چُھتھ چھِ امہِ زمینچہِ وۅپزٲژ ہُنٛد مزٕ تُلان۔ امہِ موجُب زِ اسہِ کٔرؠ گناہ۔ یم بادشاہ چھِ اسہِ تہٕ سانین چارواین پٮ۪ٹھ حکومت کران۔ تِمن یہِ مرضی گژھِ تہِ چھِ کران۔ أسؠ چھِ عذاب محسوس کران۔
\v 38 تہِ وُچِھتھ چھِ أسؠ سٲری اسرائیلی اکھ پۅختہٕ مہادٕ کران۔ یُس أسؠ کاغذس پٮ۪ٹھ تحریر کرو۔ أسؠ لیٚکھو پننؠن زِٹھین ہنٛدؠ، لاوی لوٗکن ہنٛدؠ تہٕ کاہنن ہنٛدؠ ناو تہٕ کرو یہِ کاغذ منظوری سٟتؠ مُہر بنٛد۔
\c 10
\p
\v 1 اتھ معاہدس پٮ۪ٹھ دستخط کرن وٲلؠ ٲسؠ: حکلیاہؔ سُنٛد نیٚچو گورنر نحیمیاہؔ، کٲتِب صِدقیاہ۔
\p
\v 2 سِرایاؔہ، عزریاہؔ، یرمیاؔہ۔
\p
\v 3 فشحُورؔ، امریاؔہ، ملکِیاہؔ۔
\p
\v 4 حطوشؔ، سبنیاؔہ، ملُوکؔ۔
\p
\v 5 حارِم، مرِیموؔت، عبدیاہؔ۔
\p
\v 6 دانی ایلؔ، جِنتوُنؔ، بارُوؔک۔
\p
\v 7 مسلامؔ، ابیاہؔ، میامِینؔ۔
\p
\v 8 معزیاؔہ، بِلجی تہٕ سمعیاؔہ یمے ٲسؠ تم کاہن یمو اتھ اقرار نامس پٮ۪ٹھ پنُن دستخط کوٚر۔
\v 9 لاوی لوٗکو منٛزٕ یمو اتھ دستخط کوٚر، تم چھِ:
\p یسوعؔ ازنیاؔہ سُنٛد پۅتُر، حندادؔ ونٛڈُک بِنویؔ بنی، قدمی ایلؔ۔
\v 10 یہنٛدیو کینٛژو رفیقو تہِ کٔرؠ اتھ دستخط؛ سبنیاہؔ، ہودیاہؔ
\p قلیتاؔہ، فِلایاہ، حنانؔ۔
\p
\v 11 مِیکاؔ، رحوبؔ، حسبیاہؔ۔
\p
\v 12 زکورؔ، سرِبیاہؔ، سبنیاہؔ۔
\p
\v 13 ہودیاہؔ، بانیؔ، بنِینُوؔ۔
\m
\v 14 اسرائیلی زِٹھؠ یمو اتھ دستخط کٔرؠ:
\p پرعُوسؔ، پخت موآبؔ
\p عیلام، زتُوؔ، بانیؔ۔
\v 15 بُنّیؔ، عزجادؔ، ببئیؔ۔
\v 16 ادونیاہؔ، بِگویؔ، عدینؔ۔
\v 17 اطِیر، حِزقیاہؔ، عزُورؔ۔
\v 18 ہودیاہؔ، حاشُومؔ، بضَیؔ۔
\v 19 خارِیفؔ، عنتوتؔ، نوبیؔ،
\v 20 مگفِیعاؔس، مسلامؔ، حزِیرؔ۔
\v 21 مشیزبیلؔ، صدوق، یدُّوؔع۔
\v 22 فِلطیاؔہ، حنانؔ، عنایاؔہ۔
\v 23 ہُوسیعؔ، حننیاہؔ، حسُوبؔ۔
\v 24 ہلوحیشؔ، فِلحاؔ، سوبیقؔ۔
\v 25 رحومؔ، حسبناؔہ، معسیاہؔ۔
\v 26 اخیاہؔ، حنانؔ، عنانؔ۔
\v 27 ملُوکؔ، حارِمؔ، بعنہؔ۔
\p
\v 28 یمو باقی لکو تہِ دیُت اتھ معاہدس ساتھ۔ مذہبی کاہن، لاوی، رٲچھ در، گیٚون وٲلؠ، پُجارؠ تہٕ امہِ علاوٕ سُہ پرٮ۪تھ کانٛہہ فرد یمو خدایہ سنٛز عبادت کرٕنؠ تہٕ حکم مانٕنؠ قبول کوٚرمُت اوس۔ یمن سٟتؠ ٲسؠ یہنٛدؠ شُرؠ بٲژ، کورِ گۅبُر یمہٕ تیتؠ بالغ ٲسؠ یِم یہِ سمجِتھ ہیٚکہٕ ہن زِ تِم کیاہ چھِ کران۔
\v 29 تِمو ساروٕے رَلوو پننؠن تمن زِٹھین سٟتؠ اتھٕ یم اہم ٲسؠ، یکوٹہٕ سمِتھ کوٚر یمو اقرار موسیٰؔ سنٛدؠ دٔسؠ خداوند سنٛدین حکمن تہٕ قانونن پٮ۪ٹھ عمل کرنُک۔ تِمو کوٚر قبوٗل، تِمو کوٚر قبول پننِس خدا خداوند سنٛدین سارنےٕ حکمن پٮ۪ٹھ عمل کرنُک تہٕ سٲری ہدایت پولُسنُک
\v 30 یہِ کیاہ اوس یہِ کرنُک تِمو عہَد کوٚر۔ "أسؠ دمو نہٕ پننہِ کورِ یتھ زمینس پٮ۪ٹھ تمن لوٗکن نیتھٕرؠ یم نہٕ خداوند سںنٛز عبادت کران آسن۔ أسؠ دِمو نہٕ پننؠن شُرین تہنٛزن کورین سٟتؠ خانٛدر کرنہٕ۔"
\v 31 باقی جمٲژن ہنٛدؠ لوٗکھ یم یتھ علاقس منٛز روزان چھِ ہیٚکن سبتہٕ کِس مٲلس منٛز پنُن تجارتی مال، کھیٚن چیٚنہٕ بیترِ یور تجارتہٕ باپتھ اوٚنتھ۔ مگر أسؠ ہمو نہٕ یمن سبت کہ یا بیٚیہِ کُنہِ مٲلکہِ دوٚہہ کانٛہہ تہِ چیز مٔلؠ۔ پرٮ۪تھ ستہِ ؤہرؠ تھاوو پنُن زمین بیوٗٹھ\f + \fr 10‏:31 \fq پرٮ۪تھ ستہِ ؤہرؠ تھاوو پنُن زمین بیوٗٹھ \ft خروج 20:8-11اِستِثنا 5:12-15\f*۔ اتھ وو نہٕ کِہین۔ امہِ وریہِ دمو نہٕ کٲنٛسہِ تہِ فردس قرضس نکھٕ وُت کرنہٕ۔ \f + \fr 10‏:31 \ft خروج 23:10-11، اِستِثنا 15:1-3\f*
\v 32 أسؠ سٲری چھِ وعدہ کران زِ أسؠ دِمو ہر کانٛہہ نفر ژور گرام روٚپھ خدایہ سٕنٛدِ گرٕکہ ضروریاتو باپتھ۔ \f + \fr 10‏:32 \ft چانٛدِ ہنٛدؠ 5 گرام\f*
\v 33 یمن ضروریاتن ہُنٛد تفصیل چُھ یہِ: مقدس ژۅٹ خدایس برونٛہہ کنہِ تھاونہٕ باپتھ پھل، قربان گاہَس پٮ۪ٹھ پرٮ۪تھ دوٚہہ زالنہٕ باپتھ، جانور یم قربان گاہس پٮ۪ٹھ پرٮ۪تھ دوٚہہ پوٗرٕ زالنہٕ ین۔ نذر و نیاز سبت کیٚن دوٚہُن، پرٮ۪تھ نوو زوٗنہٕ پچھ تہٕ باقی مقدس دوٚہہ مناونہٕ باپتھ یم خداین اسہِ حکم کٔرؠ۔ باقی نیاز یم خدایس کُن منسوٗب آسن۔ جانور اسرائیلی لوٗکن ہنٛدین گُنہن ہُنٛد کفارٕ ادا کرنہٕ باپتھ۔ باقی کامہِ تہِ یم خدایہ سٕنٛدِ گرٕ باپتھ ضروری آسن۔
\v 34 اسہِ تراوِ چیرِ یہِ مقرر کرنہٕ باپتھ زِ کاہنن، لاوی ین تہٕ باقی لوٗکن ہنٛدؠ بیوٚن بیٚون ونٛڈٕ کٔمہِ دوٚہہ انَن زِنیٚک تہٕ زالنُک نیاز مندرس۔ پرٮ۪تھ کانٛہہ ونٛڈٕ واتناوِ پرٮ۪تھ ؤرؠ یہِ مخصوٗص وقتہٕ پنُن نذرانہٕ خدایہ سٕنٛدِس گرس۔ لاوی زالن زِیُن قربٲنی زالنہٕ باپتھ، سٲنِس خدا خداوند سٕنٛدِس قربان گاہَس پٮ۪ٹھ۔ تٔمؠ چُھ یہِ اسہِ موسیٰؔ ہس دِنہٕ آمژِ پننہِ "تورات" شریعت چہِ کتابہِ منٛز حکم کوٚرمُت۔ \f + \fr 10‏:34 \ft احبار 6:12-13\f*
\v 35 بیٚیہِ انو أسؠ پننہِ گۅڈنکہِ فصلہٕ منٛزٕ اناج تہٕ کُلیو پٮ۪ٹھٕ گوڈنکہِ پھسلُک میٚوٕ نذرانہٕ باپتھ۔ \f + \fr 10‏:35 \ft خروج 23:19\f*
\v 36 أسؠ کرو بیٚیہِ تہِ واریاہ کینٛہہ یہِ خدا سُنٛد حکم آسہ۔ أسؠ انو مندرس پنٕنؠ نٔوؠ زا شُرؠ تہٕ چارواین ہنٛدؠ ژَھو کٹھ یا ژھاوٕلؠ نذرانہٕ رنٛگؠ، کاہنن نِش۔
\v 37 مذید انو أسؠ کاہنن کُن خدایہ سنٛدِ گرٕچن کُچَھن برنہٕ باپتھ غلہٕ بیترِ، اتھ منٛز آسہ لوننہٕ وِزیُک گۅڈنیُک پھسٕل تہِ، گوٚڈنُک پِشنہٕ آمُت اوٹ تہِ، کُلین ہُنٛد گۅڈنیُک پھسٕل تہِ، گۅڈنیُک کڈنہٕ آمُت شراب تہٕ زیتون تیٖل تہِ۔ أسؠ انو لاوین نِش پننہِ کمایہِ ہُنٛد دہہ فیصد حصہٕ تہِ۔ أسؠ دِمو یہِ دہہ فیصد حصہٕ تمن پرٮ۪تھ سریہ پٮ۪ٹھٕ یتہِ أسؠ کٲم کران آسو۔ \f + \fr 10‏:37 \ft رومؔ: 11:16، احبار: 23:7\f*
\v 38 ہارونؔ قبیلُک اکھ وٲرث روزِ تمن لاوین سٟتؠ امہِ دہہ فیصد حصٕچ نگرٲنی کرنہٕ باپتھ۔ امہِ پتہٕ انُن یم لاوی یہِ دہہ فیصد سوٚمبرِتھ تہٕ کاہن تھاون اتھ کُچَھن منٛز تہٕ یہِ روزِ تمن اوزقہٕ۔ \f + \fr 10‏:38 \ft گرینٛد 18:26\f*
\v 39 یتھٕ پٲٹھؠ پکہِ سٲرےٕ کٲم۔ اسرائیلی تہٕ لاوی واتناون یمن کُچَھں منٛز سورےٕ نذرانہٕ، اناج، زیتون تیٖل تہٕ شراب۔ أتی تھاون یہِ سورےٕ سامانہ یم کاہن خدایہ سٕنٛدِ گرٕ باپتھ۔ أتی تھاون تِم کاہن، رٲچھ درن، تہٕ گیون والین ہنٛدِ باپتھ کھیٚن چیٚنہٕ تہِ۔ أسؠ چھِ وعدہ بنٛد خدایہ سٕنٛدِ گرُک خیال تھاونہٕ باپتھ۔
\c 11
\p
\v 1 لہٰذا یم اسرائیلی زِٹھؠ بسییہِ پننؠ خاندان ہیٚتھ یروشلمسؔ منٛز۔ باقی لوکو تراوِ چیرِ دہو منٛزٕ اکھ گرٕ ژارنہٕ باپتھ یُس یروشلم شہرس منٛز بسہِ۔ یوٚہے شہر اوس خداوند سٕنٛدِ باپتھ الگ تھاونہٕ آمُت۔ باقی نو نو گرٕ بسییہِ باقی سرین منٛز۔ \f + \fr 11‏:1 \ft یروشلم اوس یہُوداؔ صوبُک انتظامی دارالحکومت۔ لہٰذا ٲسؠ زِٹھؠ تتہِ روزان۔ \f*
\v 2 یروشلم شہرس منٛز روزنہٕ خٲطرٕ پانے برونٛہہ کُن ینہٕ والین گرن ہنٛدِ باپتھ موٚنگ لوکو خدایس پنُن فضل تہٕ خٲر۔
\v 3 یم چھِ مقٲمی حٲکمن تہٕ عہدٕدارن ہنٛدؠ ناو یم یروشلمؔ شہرس منٛز بسییہِ۔ مگر یہُوداؔ سریہ منٛز رود پرٮ۪تھ کانٛہہ پننِس پننِس ملکِیتس پیٚٹھےٕ۔ یمن منٛز ٲسؠ اسرائیلی کاہن، لاوی، خدایہ سٕنٛدِ گرٕکؠ خٲدِم، تہٕ سُلیمانؔ سنٛدین خٲدمن ہنٛدؠ اولاد
\v 4 مگر یہُوداؔ تہٕ بنیمِینؔ لوکو منٛزٕ رودؠ کینٛہہ أتؠ یروشلم شہرس منٛزےٕ لسان بسان۔
\p یہُوداؔ سٕنٛدِ نسلہٕ منٛزٕ اوس عتایاہؔ سُنٛد نیٚچو عُزیاہؔ، ذکریاہؔ سُنٛد نیٚچو، امریاؔہ سُنٛد نیٚچو، سفطیاہؔ سُنٛد نیٚچو، مہللؔ ایلؔ سُنٛد نیٚچو تہٕ اکھ بنی فارصؔ منٛزٕ۔
\v 5 باقین منٛز ٲسؠ بارُوکؔ سُنٛد نیٚچو معسیاہؔ، کُلحوزہؔ سُنٛد نیٚچو، حزایاہؔ سُنٛد نیٚچو، عدایاہؔ سُنٛد نیٚچو، یویرِیبؔ سُنٛد نیٚچو، ذکریاہؔ سُنٛد نیٚچو، یُس زنہٕ شِلاہؔ سٕنٛدِ نسلہٕ منٛزٕ اوس۔
\v 6 سٲری ملنٲوِتھ رودؠ فارصؔ سٕنٛدِ نسلٕکؠ 468 نفر یروشلم شہرس منٛز۔ یم مرد ٲسؠ ولہٕ ویر تہٕ جنٛگی مہارتہٕ وٲلؠ۔
\v 7 یم چھِ بنیمِینؔ نسلہٕ منٛزٕ یمو یروشلم شہرس منٛز روزنُک فٲصلہٕ کوٚر۔ مُسلامؔ سُنٛد نیٚچو سلُّوؔ، یوئیدؔ سُنٛد نیٚچو، فِدیاہؔ سُنٛد نیٚچو، قولایاہؔ سُنٛد نیٚچو، معسیاہؔ سُنٛد نیٚچو، ایتی ایلؔ سُنٛد نیٚچو تہٕ یسعیاہؔ سُنٛد نیٚچو۔
\v 8 تمِس اتھٕ روٚٹ کرن وٲلؠ زٕ زٔنؠ گٔیاے جبّیؔ تہٕ سلّیؔ۔ بنیمِینؔ قبیلہٕ منٛزٕ سٲری سمِتھ رودؠ 928 نفر یروشلم شہرس منٛز۔
\v 9 یہُنٛد زیُٹھ اوس زِکریؔ سُنٛد نیٚچو یُوایلؔ۔ ہسّنُوہؔ سُنٛد نیٚچو یہُوداؔ اوس نٲئب حٲکم یروشلم شہرُک۔
\v 10 مذہبی کاہن یم یروشلم شہرس منٛز رودؠ ٲسؠ یُویرِیبؔ سُنٛد نیٚچو یدعیاؔہ تہٕ یاکین۔
\v 11 بیاکھ کاہن اوس خِلقیاہؔ سُنٛد نیٚچو شِرایاہؔ مُسلام سُنٛد نیٚچو، صدوقؔ سُنٛد نیٚچو، مِرایوتؔ سُنٛد نیٚچو، اخِیطوبؔ سُنٛد نیٚچو یہِ اوس خدایہ سٕنٛدِ گرچہِ کامہِ ہُنٛد نگران\f + \fr 11‏:11 \fq نگران \ft زیُٹھ یا بوٚڈ کاہن\f*۔
\v 12 یہنٛدیو رفیقو منٛزٕ ٲس 822 نفرن ہنٛز اکھ جماتھ یروشلم شہرس منٛز بسیمٕژ، سۅ روز خدایہ سٕنٛدِ گرچہِ کامہِ منٛز آوٕر۔ باقی کاہن یم یروشلمسؔ منٛز رودؠ ٲسؠ: یروحاؔم سُنٛد نیٚچو عدایاہؔ، فِللیاہؔ سُنٛد نیٚچو، امضیؔ سُنٛد نیٚچو، زکرِیاہؔ سُنٛد نیٚچو، فشہورؔ سُنٛد نیٚچو، تہٕ ملکِیاہؔ سُنٛد نیٚچو۔
\v 13 بیٚکِس 242 نفرن ہنٛزِ جماژ منٛز ٲسؠ یہنٛدیو رفیقو منٛزٕ یہنٛدِ خاندانٕکؠ زِٹھؠ یروشلم شہرس منٛز بسن وٲلؠ۔ بیاکھ کاہن یُس أتؠ بسیو اوس امشَیؔ، عزرایلؔ سُنٛد نیٚچو، اخسیؔ سُنٛد نیٚچو، مسِلّیموتؔ سُنٛد نیٚچو تہٕ اِمّیر سُنٛد نیٚچو۔
\v 14 یہنٛدیو رفیقو منٛزٕ ٲس بیاکھ 128 نفرن ہنٛز جماعت یمہٕ ولہٕ ویر ٲسؠ بسییہِ یروشلمسؔ منٛز یہُنٛد زیُٹھ اوس زبدی ایلؔ یُس ہجّدولیِمؔ سُنٛد نیٚچو اوس۔
\p
\v 15 لاویو منٛزٕ اوس یروشلم شہرٕ بسن وول حسُوبؔ سُنٛد نیٚچو سمعیاؔہ، عزرِیقام سُنٛد نیٚچو، حسبِیاہؔ سُنٛد نیٚچو، بنّیؔ سُنٛد نیٚچو۔
\v 16 مذید بیٚیہِ زٕ زٔنؠ ٲسؠ سبتیؔ تہٕ یُوزابادؔ یم مندرٕچہِ نیٚبرِمہ کامہِ ہنٛدؠ نگران ٲسؠ یم ٲسؠ لاوی قبیلکین لوٗکن ہنٛدؠ زِٹھؠ
\v 17 بیاکھ لاوی یُس یروشلم شہرس منٛز بسیو اوس متنِیاہؔ یُس خدا سنٛدؠ تعریف تہٕ مناجات گیٚون واجنہِ جمٲژ ہُنٛد زیُٹھ اوس۔ یہِ اوس مِیکا سُنٛد نیٚچو۔ امہِ علاوٕ ٲسؠ زبدیؔ سُنٛد نیٚچو تہٕ آصفؔ سُنٛد نیٚچو تہِ۔ متّنیاہ سُنٛد نٲئب اوس بقبُوقیاہؔ۔ بیاکھ لاوے اوس عبداؔ، سمُوعؔ سُنٛد یٚچو، جلال سُنٛد نیٚچو، یدُوتونؔ سُنٛد نیٚچو۔
\v 18 الہٕ پلہٕ بسییہِ 284 لاوی یروشلم کِس مقدس شہرس منٛز۔ \f + \fr 11‏:18 \ft یروشلمُک مقدس شہر\f*
\v 19 مقدِسٕکؠ رٲچھ در یم یروشلم شہرس منٛز لسنہِ بسنہِ لگمٕتؠ ٲسؠ: عقُوبؔ، طلمونؔ، تہٕ یہنٛدؠ 172 رفیق یم پھاٹکس راوٕٹ کران ٲسؠ۔
\v 20 باقی اسرائیلی یمن منٛز لاوی تہٕ کاہن شٲمل ٲسؠ لٔگؠ یہُوداؔ سرایہِ منٛز پننِس پننِس ملکِیتس پٮ۪ٹھ۔ بسنہِ۔
\v 21 مندرس منٛز کٲم کرن وٲلؠ ٲسؠ عوفل بالس یروشلم شہرُک اکھ بال پٮ۪ٹھ روزان۔ یہنز نگرٲنی ٲس مٹہِ ضیحاؔ تہٕ جِسفا نٲوؠ دوٚن نفرن۔
\v 22 یروشلم شہرس منٛز روزن والیٚن لاوی لوٗکن ہُنٛد نگران اوس عُزیؔ بانیؔ سُنٛد نٚچو، حسبیاہؔ سُنٛد نٚچو، متنِیاہؔ سُنٛد نٚچو، مِیکا سُنٛد نٚچو۔ عُزیؔ اوس آصفؔ سنٛدیو اولادو منٛزٕ اکھ۔ یم سٲری ٲسؠ تمہِ سازٕکؠ تہٕ گیونٕکؠ ذمہٕ دار یُس خدا سٕنٛدِس گرس منٛز خدایہِ سٕنٛدِ ذکرٕ باپتھ چلان اوس۔
\v 23 یپٲرؠ اوس فارس ملکٕکؠ بادشاہن گیٚون والین ہُنٛد مدد کرُن مٹہِ ہیٚوتمُت۔ بادشاہن اوس ووٚنمُت زِ سُہ دِیہ تہِ سورےٕ یہِ گیٚون والیٚن باپتھ درکار آسہ۔ \f + \fr 11‏:23 \ft عذرا 6:1-12\f*
\v 24 فتحیاؔہ اوس فارسٕکِس بادشاہس سٕنٛدِس دربارس منٛز اسرائیلی معاملات وُچھنُک صفیر۔ یہِ اوس مشیزبیلؔ سُنٛد نیٚچو یُس یہُوداؔ زارح سُنٛد نسلُک اوس۔ زارحؔ اوس یہُوداؔ سُنٛد نیٚچو۔
\v 25 یہُوداؔ سٕنٛدِ نسلٕکؠ کینٛہہ لوٗکھ بسییہِ نہٕ یروشلم شہرس منٛز۔ تم بسییہِ پننؠن کھہَن نکھےَ گامن تہٕ سرین منٛز۔ یمن جاین منٛز ٲسؠ قریتؔ اربعؔ تہٕ اتھ نکھٕ گام دِیبون تہٕ یقبضی ایلؔ سریہ نکھٕ۔
\v 26 یہُوداؔ سٕنٛدِ نسلٕکؠ کینٛہہ فرد تہِ بسییہِ یشُوع، مولادہؔ تہٕ بیت فلطؔ سریہ منٛز۔
\v 27 امہِ علاوٕ بسییہِ کینٛہہ حصرسوعالؔ سریہ تہٕ بیرسبعؔ شہرٕ تہٕ اتھ نکھٕ گامن منٛز۔
\v 28 کینٛہہ بسییہِ صقلاج تہٕ مقوناہ سَریہ تہٕ اتھ نکھٕ گامن منٛز۔
\v 29 مذید بسییہِ عَین رِمّون صُرعہؔ، یرموتؔ تہٕ ادولام سریہ تہٕ گامن منٛز۔
\v 30 یم بسییہِ زنواح عدُلام قصبن تہٕ شہرن منٛز، لکیس کیٚن کھہَن تہٕ عذیقہ کیٚن سرین منٛز تہٕ اہندٮ۪ن گامن منٛز۔ یم سٲری لوٗکھ بسییہِ یہُوداؔ علاقس منٛز تہٕ بیرسبعؔ یعنی جنوبی تہٕ وادی ہِنوم کِس درمیٲنی علاقس منٛز
\v 31 بنی بنیمِینؔ نسلٕکؠ کینٛہہ لوٗکھ بسییہِ یمن شہرن تہٕ سرین منٛز: جِبعؔ، مِکماسؔ، عیاہ، بیت ایلؔ تہٕ تمہِ کیٚن نکھٕ گامن منٛز۔
\v 32 بیٚیہِ بسییہِ عنتوتؔ، نوبتہٕ تہٕ عننیاہؔ۔
\v 33 تہٕ حاصور، رامہ، تہٕ جتّیم
\v 34 حادیدؔ، ضبوعیِم تہٕ نبلاط۔
\v 35 لُود تہٕ اونوؔ، "کٲرؠ گرن ہنٛز وادی۔"
\v 36 کینٛہہ لاوی یم گۅڈٕ یہُوداؔ سٕنٛدِس علاقس منٛز روزان ٲسؠ۔ بسییہَ وُنؠ بنیمِینؔ کِس پرٲنس قبیلہٕ کِس زمینس پٮ۪ٹھ۔
\c 12
\p
\v 1 تِم کاہن تہٕ لاوی یم بابلؔ پٮ۪ٹھٕ واپس یِتھؠ سالتی ایلؔ سٕنٛدِس نیٚچوِس زرُبابلؔ تہٕ زِٹھس کاہن یسوعؔ ہس سٟتؠ آے۔ کاہنو منٛزٕ ٲسؠ سِرایاؔہ، یرمیاؔہ تہٕ عزرا۔
\v 2 امریاؔہ، ملُوکؔ، حطوشؔ۔
\v 3 سِکنیاہؔ، رحومؔ، مرِیموؔت۔
\v 4 عِدُوؔ، جنّتوؔ، ابیاہؔ۔
\v 5 میامِینؔ، معدیاؔہ، بِلجہؔ۔
\v 6 سمعیاؔہ تہٕ یُویرِیبؔ، یدعیاؔہ۔
\v 7 سلُّوؔ، عمُوؔق، خِلقیاہؔ تہٕ یدعیاؔہ۔ اتہِ ٲسؠ یسوعؔ سنٛدٮ۪ن دوٚہُن منٛز کاہنن ہنٛدؠ زِٹھؠ تہٕ تِہنٛدؠ سٲتھی۔
\p
\v 8 لاویو منٛزٕ ٲسؠ یِم: یسوعؔ، بِنویؔ، قدمی ایلؔ، سرِبیاہؔ، یہُوداؔ تہٕ متنیاہؔ۔ متّنیاؔہ تہٕ تمسنٛدؠ سٲتھی ٲسؠ خدایہِ سنٛدؠ حمُد و ثناہ پیش کران۔
\v 9 تہٕ تمسنٛدؠ بٲے بقبُوقیاہؔ تہٕ عُنّوؔ ٲسؠ تمن برونٛہہ کنہِ پن پننہِ جایہِ پہرٕ دِتھ۔
\v 10 زٹِھس کاہن یسوعؔ سُنٛد اولاد اوس یُویقیِمؔ۔ یُویقیِمؔ سُنٛد الیاسبؔ، الیاسبؔ سُنٛد اولاد اوس یدُوع،
\v 11 یدُوع سُنٛد اولاد اوس یونتنؔ تہٕ یُونِتنؔ سُنٛد یدُّوؔع
\v 12 یُویقیِمؔ یمہِ وزِ زیُٹھ کاہن اوس تمہِ وزِ ٲسؠ پننؠن آبٲئی خاندانن ہنٛدؠ زیٚٹھؠ یم۔ سِرایاؔہ خاندانُک مرایاؔہ۔ یرمیاؔہ خاندانُک حننیاؔہ۔
\v 13 عزرا خاندانُک مسلامؔ۔
\p امریاؔہ خاندانُک یہُوحانانؔ۔
\v 14 ملکُو خاندانُک یونتنؔ
\p سبنیاؔہ خاندانُک یوسفؔ۔
\p
\v 15 عدناؔ اوس حارِمؔ قبیلُک زیُٹھ۔ خلقَی اوس مِرایوتؔ قبیلُک زیُٹھ۔
\v 16 عِدُوؔ خاندانُک ذکریاہؔ، جِنتوُنؔ خاندانُک مسلامؔ۔
\p
\v 17 ابیاہؔ خاندانُک زِکریؔ۔ فِلطی اوس مِنیمِین تہٕ مَوعدیاؔہ کٮ۪ن قبیلن ہُنٛد زیُٹھ۔
\p
\v 18 بِلجہؔ خاندانُک سمُوعؔ۔
\p سمعیاؔہ خاندانُک یہُونتنؔ۔
\p
\v 19 یُویرِیبؔ خاندانُک متّنی
\p یدعیاؔہ خاندانُک عُزیؔ۔
\p
\v 20 سلّی خاندانُک قَلّی۔
\p عمُوق خاندانُک عِبر۔
\p
\v 21 خِلقیاہؔ خاندانُک حسبیاہؔ۔
\p یدعیاؔہ خاندانُک نتنی ایلؔ۔
\p
\v 22 کینٛژو لیٚکھن والیٚو لیکھؠ لاوی قبیلٕکؠ زِٹھؠ، ییٚلہِ تتہِ الیاسبؔ، یُویدؔع، یُوحنانؔ تہٕ یدُّوؔع عظیم کاہنن ہُنٛد دور اوس۔ تِمو لیکھؠ کاہن زِٹھین ہنٛدؠ ناو ییٚلہِ فارسُک بادشاہ داراؔ اوس۔
\p
\v 23 توٲریخی کتابن منٛز چھِ لیکھن والیو بنی لاوی قبیلن ہنٛدؠ زِٹھؠ درٕج کٔرمٕتؠ یۅتام زن یُوحنانؔ بِن الیاسبؔ کاہنِ اعظم اوس۔
\v 24 لاوینؔ ہنٛدؠ زِٹھؠ حسبیاہؔ، سرِبیاہؔ، قدمی ایلؔ سُنٛد نیٚچو یشُوعؔ ٲسؠ خدایہِ سٕنٛدِس گرس منٛز حمد و ثناہ پرن والیٚن ہنٛز سرپرستی کران۔ تِہنٛدؠ سٟتؠ بٲج ٲسؠ تِمن لرِ لوٚر بارِ بارِ خدایہ سنٛدؠ تعریف تہٕ حمُد پران۔ یہِ سورے اوس بٔڈس خدا پرست داوود سٕنٛدِ حکمہٕ مطابق انجام دِنہٕ یوان۔
\v 25 متنیاہؔ، بقبُوقیاہؔ، عبدیاہؔ، مسلامؔ، طلمُون، عقُوبؔ ٲسؠ دربان۔ یم گُدامن ہنٛدین دروازن ہنٛز پہرٕدٲری کران ٲسؠ۔
\v 26 یمو کٔر یہِ کٲم ییٚلہِ یسوعؔ سُنٛد نیٚچو تہٕ یُوصدؔق سُنٛد زُر یُویقیِمؔ کاہنِ اعظم اوس۔ تہٕ امہِ پتہٕ دُبارٕ ییٚلہِ نحیمیاہؔ گورنر تہٕ عزراؔ کاہن تہٕ فقِیہہ اوس۔
\v 27 یروشلمٕچؠ فصیٖل منسوٗب کرنہٕ وزِ أنؠ اسہِ لاوی تمام جایو پٮ۪ٹھٕ یتہِ یتہِ روزان ٲسؠ ژھٲنٛڈِتھ۔ تہٕ واتنٲوؠ یروشلمؔ تاکہِ تم روزَن خوش اسلوٗبی سان جھانجھ، سِتارٕ، سروٗد وٲیِتھ تہٕ گیٚوِتھ خوشی تہٕ شُکرانُک اظہار کٔرتھ۔
\v 28 اسہِ أنؠ گیون وٲلؠ لاوی سونٛبرتھ یروشلمہٕؔ کیٚو نزدیکی علاقو پٮ۪ٹھٕ یتہِ تم شہرس انٛدؠ پٔکؠ آباد ٲسؠ۔ تہٕ بیٚیہِ أنؠ نطُوفہ یعنی یروشلم کیٚو جنوٗب مشرقی گامو پٮ۪ٹھٕ تہِ
\v 29 بیٚیہِ آے شمال مشرق کیٚو ترییٚو علاقو بیت الجِلجاؔل، جِبعؔ تہٕ عزماوتؔ پٮ۪ٹھٕ تہِ۔ اسہِ سونٛبرؠ یم گیٚون وٲلؠ تکیازِ یمو ٲسؠ یروشلمسؔ نزدیکےٕ پنٕنؠ گام بسٲومٕتؠ۔
\v 30 گۅڈٕ کٔرؠ یمو کاہنو تہٕ لاویو پنٕنؠ پان خدایہِ سنٛزِ عبادٔژ خٲطرٕ صاف و پاک۔ تہٕ پتہٕ کٔرِکھ عام لوٗکھ، دیوار تہٕ دروازٕ تہِ صاف۔
\v 31 امہِ پتہٕ أنؠ مےٚ یہُوداؔ قبیلٕکؠ زٹھؠ سونٛبرتھ تہٕ بہنٲوم دیوارن پٮ۪ٹھ تہٕ ونمکھ دوٚن بجن جمٲژن ہنٛز قیادت کرٕنؠ یمو دیوارو پیٚٹھؠ احاطس انٛدؠ انٛدؠ گشت کرتھ شہر وُچھ۔ اکھ جماعت درایہِ دٔچِھنؠ تہٕ درایہِ ژھۅٹہٕ برٕنؠ کُن۔
\v 32 ہُوسعیاؔہ تہٕ یہُوداؔ ہن ہنٛدؠ أڈؠ زِٹھؠ دراے یمن پتہٕ پتہٕ۔
\v 33 یم لِکھٕ یمن سٟتؠ دراے تِمن منٛز ٲسؠ۔ عزریاہؔ، عزرا، مسلامؔ۔
\v 34 یہُوداؔ، بنیمِینؔ، سمعیاؔہ تہٕ یرمیاؔہ۔
\v 35 کینٛہہ کاہن زادٕ تہٕ دراے ساز وایان یمن پتہٕ پتہٕ یمن منٛز یونتنؔ سُنٛد نیٚچو زکرِیاہؔ، سمعیاؔہ سُنٛد نیٚچو، متنیاہؔ سُنٛد نیٚچو، مِیکایاہؔ سُنٛد نیٚچو، زکورؔ سُنٛد نیٚچو، تہٕ آصفؔ سُنٛد نیٚچو ٲسؠ۔
\v 36 زکریاہ سنٛدؠ کینٛہہ سٲتھی تہِ دراے ساز و سنطور وایان، یمن منٛز سمعیاؔہ، عزراؔیل، مِللی، جِللی، ماعَی، نتنی ایلؔ، یہُوداؔ تہٕ حنانی ٲسؠ۔ یم تہِ ٲسؠ سُے ساز وایان یُس خدا ترس بادشاہ داوود وایان اوس۔ شرعی عٲلم عزُراؔ اوس یمن برونٛہہ برونٛہہ پکان۔
\v 37 ییٚلہِ امہِ جمٲژ ہنٛدؠ لوٗکھ فموار برٕنؠ نِش وٲتؠ تم کٔھتؠ سیٚودے تتھ ہیرِ پٮ۪ٹھ یتِتھ "داوود سُنٛد شہر" ناوُک علاقہ یوان اوس۔ پتہٕ ؤتھؠ تم یکہٕ وٹہٕ دیوارو پیٚٹھؠ داوود سٕنٛدِ محلہٕ کِنؠ تالاب دروازس نِش تہٕ دراے مندرکہ مشرِقہٕ طرفہٕ۔
\v 38 یہُوواہؔ سنٛدؠ شکرانٕکؠ بٲتھ گیٚون واجِنؠ بیاکھ جماتھ وٲژ پکان پکان کھووُرِ انٛدٕ کیٚو دیوارٕ پیٚٹھؠ تہٕ بہٕ رلیٚوس نیصف جماتھ ہیٚتھ تمن سٟتؠ تہٕ کٔھتؠ تندورٕ چُمنیو پیٚٹھؠ کٔھلس دیوارس کُن۔
\v 39 اتہِ پٮ۪ٹھٕ دراے أسؠ افرائیمیؔ پھاٹکہِ کِنؠ یسانہؔ برٕنؠ، گاڈٕ برٕنؠ، ہَنن ایلؔ میٖنار، ہمّیاہ تہٕ ہتھ سِپاہ نٲوؠ میٖنارٕ کِنؠ تہٕ وٲتؠ تیٖر دروازَس تام۔ اتہِ پٮ۪ٹھٕ ووت سون جلوٗس تتھ برٕنؠ نِش انٛد یۅسہ خدایہ سٕنٛدِس گرس کُن گژھان چھےٚ۔
\v 40 یتھٕ کِنؠ واژٕ دوٚنوے جمٲژ گیٚوان گیٚوان تہٕ شکُر بجا انان خدایہ سٕنٛدِس گرس منٛز تم رودؠ پن پننہِ جایہِ کھڑا تہٕ بہٕ اوسُس اتہِ موجود شہرٕ کیٚن اڈیٚن حٲکمن سٟتؠ ودٕنؠ یم مےٚ سٟتؠ آمٕتؠ ٲسؠ۔
\v 41 میانہِ جمٲژ منٛز ٲسؠ کاہن الیاقیمؔ، معسیاہؔ، مِنیمِین، مِیکایاہؔ، الیوعیناییؔ، ذکریاہ تہٕ حننیاہؔ۔ یم سٲری ٲسؠ ساز واین والیٚو منٛزٕ۔
\v 42 باقی سازندرن منٛز ٲسؠ معسیاہؔ، سمعیاؔہ، الِیعزرؔ، عُزیؔ، یہُوحانانؔ، ملکِیاہؔ، عیلاؔم تہٕ عزر یم پننِس زٹھِس گیٚون وٲلِس اِزرخیاؔہ ہس سٟتؠ تھزِ آوازِ منٛز گیٚوان ٲسؠ۔
\v 43 امہِ دوٚہہ کرِ لوٗکو واریاہ قۅربٲنیہ۔ تم ٲسؠ وِسان زِ خداین دِژ تمن بٔڈ خوشی۔ مستوراتہٕ تہٕ شُرؠ تہِ ٲسؠ تِمن سٟتؠ اتھ خوشی منٛز شٲمل۔ یروشلمؔس منٛز سَپدن والہِ امہِ جشنُک گرٛٮ۪ز اوس دوٗر دوٗر تام ووتمُت۔
\v 44 امی دوٚہہ کٔرؠ اسہِ خزانن ہنٛدؠ رٲچھ در مقرر۔ یوٚہے اوس سُہ موقہٕ ییٚلہ اِمامو دیار، اناج، پھل تہٕ پھسلُک دٔہم حصہ سونٛبُر۔ لوٗکو کٔرؠ پننیٚو کھہَو منٛزٕ یم چیز امامن تہٕ لاویو باپتھ شہرٕ کیٚن نزدیکی گُدامن منٛز جمع یہِ زن موسیٰؔ ہن دستور بنومُت اوس۔ یہُوداؔ کیٚو لوٗکو دیُت یہِ سورےٕ انجام تکیازِ تم ٲسؠ کاہنو تہٕ لاویو دٔسؠ خدا سٕنٛدِس گرَس منٛز کرنہٕ آمژِ کامہِ سٟتؠ سیٹھاہ خوش۔
\v 45 کاہن تہٕ لاوے رودؠ پننِس خدایہ سنٛز کٲم رَسمو مطٲبق عقیدتہٕ سان انجام دِوان۔ گیٚون والیو تہٕ دربانو تہِ کٔر پنٕنؠ کٲم یتھٕ کٔنؠ زَن داوود تہٕ تسنٛدس نیٚچوؠ سُلیماننؔ تِمن ونمُت اوس۔
\v 46 اسہِ کوٚر یہِ سورےٕ تکیازِ یہِ ٲس پتھ کالٕچ ریوایتھ ییٚلہ داوود بادشاہ تہٕ آصفؔ خدایہ سٕنٛدِس گرس منٛز موسیقارن ہُنٚد نگران اوس۔ تمہِ وزِ تہٕ اوس اکھ شخصا گیٚون والین ہُنٛد زیُٹھ یُس خدایہِ سنٛدؠ حمد و ثناہ پیش اوس کران۔
\v 47 امہِ وقتہٕ ییٚلہ زرُبابلؔ اتیُک گورنر اوس تہٕ لوٗکھ ٲسؠ پرٛتھ دوٚہہ گیٚون والین تہٕ دربانن باپتھ کھیٚن چیٚنُک اہتمام کران یمِچ تِمن ضروٗرت ٲس۔ تِمو کوٚر تمہِ وزِ تہِ یتھے کِنؠ ییٚلہ نحیمیاہؔ اتیُک گورنر اوس۔ تِمو دیُت پننہِ گلُک دٔہم حصہٕ لاوینؔ تہٕ لاویو دیُت تمیٚک دٔہم حصہٕ کاہنن یم گۅڈنکِس امیرِ اعلیٰ کاہن ہارونؔ سنٛدیو اولادو منٛزٕ ٲسؠ۔ \f + \fr 12‏:47 \ft زرُبّابلؔ تہٕ نحیمیاؔہ چھِ یہوداہٕکؠ زٕ سرکٲری حٲکم یمن ہُنٛد ذِکر تتھ وقتس دوران چُھ آمُت کرنہٕ یُس عذرا تہٕ نحیمیاؔہ ۂنٛزن کتابن منٛز چُھ شٲمل کرنہٕ آمُت۔ \f*
\c 13
\p
\v 1 پتہٕ آے لوٗکھ موسیٰؔ سنٛز کتاب شریعت بوزناونہٕ یتھ منٛز خدایہ سنٛدؠ دتؠ مِتؠ احکام درج ٲسؠ۔ یتھ منٛز تِمن وننہٕ آو زِ عمونیؔ تہٕ موٲبؠ لوٗکھ گژھن نہِ خدایہ سنٛز عبادت کرن والین اسرائیل ین سٟتؠ شریک تھاوٕنؠ۔ \f + \fr 13‏:1 \ft اِستِثنا 23:3-6\f*
\v 2 تکیازِ عمُّونیؔ تہٕ موٲبؠ لوٗکھ دراے نہٕ تمہِ وزِ اسرائیلی لوٗکن بُتھِ تریش یا کھیٚن چین ہیٚتھ یمہِ وزِ تمہٕ مِصرٕ منٛزٕ تپٲرؠ ہجرتس دوران دراے۔ تتھ برعکس دِیُت تِمو بلعامس ماوضہٕ زِ سُہ کرِ اسرائیل ین لعنت ملامت۔ مگر سٲنؠ خداین کٔر سۅ لعنت اسرائیل ین باپتھ رحمتس منٛز تبدیل۔
\v 3 یتھٕ کٔنؠ کٔر لوٗکو اتھ ہدایتس پٮ۪ٹھ عمل تہٕ کٔرِکھ تم سٲری وۅپر لوٗکھ پننہِ جمٲژ منٛزٕ بےٚ دخٕل یم تمن سٟتؠ رلیمٕتؠ ٲسؠ۔
\v 4 ییٚلہِ الیاسبؔ کاہنِ اعلیٰ بنیاو تہٕ خدایہ سٕنٛدِس گرس منٛز گُدامن مٲلکھ رود، طُوبیاہؔ بنیاس ٲشناو
\v 5 تٔمؠ دیُت طُوبیاؔہس تِمو کمرو منٛزٕ أکِس بٔڈس کمرس منٛز روزنُک اجازت یتھ منٛز کاہنو باپتھ اناج، قۅربٲنیہِ، نذر ونیاز، منٛدرُک ساز و سامان، اناجُک دٔہِم حصہٕ، شراب تہٕ زیتون تیٖل، یُس خدایہ سٕنٛدِ حکمہٕ مطٲبق لاوین، گیٚون والیٚن تہٕ دربانن خٲطرٕ مخصوص اوس۔ اتھ منٛز آسہ کاہنو باپتھ تھاونہٕ آمژٕ قُربٲنیہِ تہِ۔
\v 6 امہِ وقتہٕ اوسُس نہٕ بہٕ یروشلمسؔ منٛز۔ تکیازِ بہٕ اوسُس بابلؔ کِس بادشاہ ارتخششتا سٕنٛدِس 32 مِس دورِحکومتس منٛز تٔسؠ نِش تہٕ کینٛہہ کال گٔژھِتھ ہیٚوت مےٚ تس اجازت تہٕ آس یروشلم واپس۔
\v 7 ییٚلہِ بہٕ یروشلمؔ ووتُس، مےٚ سپُد معلوم زِ خدایہ سٕنٛدِس گرٕکِس احاطس منٛز کِتھٕ پٲٹھؠ چُھ الیاسبنؔ طُوبیاہؔ سٕنٛدِ باپتھ غٲر قانونی کمرٕ وقف کوٚرمُت۔
\v 8 یہِ بوزِتھ گو مےٚ کٲفی رنٛج۔ مےٚ ژھُن طُوبیاہ سُنٛد سورےٕ سامانہٕ کمرٕ منٛزٕ نیٚبر دٲرِتھ۔
\v 9 پتہٕ دیُت مےٚ کاہنن حکم زِ تم کرن رَسمہٕ مطٲبق یم کُٹھؠ صاف و پاک تہٕ پتہٕ انَن خدایہ سٕنٛدِ گرِکؠ تم سٲری بانہٕ برتن، اناج، نذرانہٕ بیترِ بیٚیہِ واپس تہٕ تھاون پن پننہِ جایہِ سمبٲلِتھ۔
\v 10 مےٚ بوز یتہِ زِ اتِکؠ ذمہٕ دار لاوی تہٕ مقدس بٲتھ گیٚون وٲلؠ تہِ ٲسؠ اتہِ درامٕتؠ تہٕ پننؠن گرن گٲمٕتؠ تکیازِ یُس گلُک دٔہم حصہٕ تمن اتہِ تران اوس سُتہ اوس بنٛد کرنہٕ آمُت ینہٕ طُوبیاہن گُدامس قبضہٕ کوٚرمُت اوس۔
\v 11 پتہٕ کٔر مےٚ شہرٕ کیٚن حٲکمن سٟتؠ لڑٲے تہٕ ونمکھ "توٚہؠ کیازِ ژٔلیو خدایہ سُنٛد گرٕ ترٲوِتھ" پتہٕ أنِم لاوی تہٕ گیٚون وٲلؠ بیٚیہِ خدایہ سںنٛدس گرَس منٛز واپس تہٕ ونمکھ پنٕنؠ کٲم کرنہٕ باپتھ۔
\v 12 امہِ پتہٕ لوگ ساروٕے یہودایوؔ پننہِ اناجُک، شرابُک، زیتون تیٖلُک دٔہم حصہٕ خدا سٕنٛدِ ناو موجود گُدامن کُن بیٚیہِ انُن۔
\v 13 مےٚ کٔرؠ بیٚیہِ تہِ کینٛہہ شخص گُدامن ہنٛدؠ رٲچھ در مقرر یمن منٛز سلمیاؔہ کاہن، صدوق فقِیہہ تہٕ لاویو منٛزٕ فِدایاہؔ مقرر سپُد تمِس رود زکورؔ سُنٛد نیٚچو تہٕ متنیاہؔ سُنٛد زُر حنانؔ مددٕتس۔ مےٚ کٔرؠ یم اوٕ موٚکھٕ تعینات تکیازِ سٲری ٲسؠ زانان زِ یم چھِ دیانت دار تہٕ یم بٲگرن ایماندٲرؠ سان پننؠن سٲتھین منٛز اجناس۔
\v 14 "میانہِ خدایہِ مےٚ دِ یہِ کرنُک رُت توفیق۔ آ! مےٚ دِ اجر تِمن رٕژَن کامین ہُنٛد یم مےٚ پننِس خدایہ سُنٛد گرٕ تہٕ امہِ گرٕ کیٚن خٲدمن باپتھ کرِ۔
\v 15 أتھؠ وقتس دوران وُچھ مےٚ کینٛہہ یہُودؠ یم سبت کہِ دوٚہہ کٲم ٲسؠ کران۔ کینٛہہ ٲسؠ شرابہٕ باپتھ دچھِ رس کڈان تہٕ کینٛہہ ٲسؠ بوٚہرین بٔرِتھ اناج خرَن بران۔ کینٛہہ ٲسؠ شراب، دچھِ ٹوکرِ، انجیر تہٕ باقی چیز سبت کہ دوٚہہ خَرن لٔدتھ یروشلم کُن روانہٕ کران۔ مےٚ کوٚر تِمن منع سبت کہ دوٚہہ یہُوداؔ کین لوٗکن غذٲیی اجناس کٔننَس۔
\v 16 بیٚیہِ وُچھ مےٚ صَور شہرٕکؠ کینٛہہ لوٗکھ یم یروشلمس منٛز روزان ٲسؠ گاڈٕ تہٕ باقی چیز انان تہٕ سبت کہ دوٚہہ یروشلمسؔ منٛز یہُوداؔ لوٗکن کٔنان
\v 17 اوے کوٚر مےٚ یہُوداؔ کیٚن سرکردٕ شہرین گرینٛز تہٕ ونمکھ "یہِ چُھنہٕ جان گژھان یہِ توٚہؠ کران چُھو! توٚہؠ چُھو سبت کِس دوٚہس بے حرمتی کران ینہٕ خدا یژھان چُھ۔
\v 18 توٚہہِ چُھ معلوم زِ تُہنٛدیو جد و اجدادو تہِ کریاو یی تہٕ خداین انییہِ سزا رنٛگؠ ملکس بٔڈ آفت! تہٕ وُنؠ چُھو توٚہؠ سبت کِس دوٚہس بے حرمتی کٔرِتھ بیٚیہِ خدایہ سنٛز ناراضگی یژھان تہٕ اسرائیل باپتھ مصیبتن تہٕ آفژن دعوت دِوان۔
\v 19 لہٰذا چُھس بہٕ دربانن حکم دِوان زِ تِم آسن جمعہ دوٚہہ شام سپدنس سٟتؠ سٟتی یروشلمٕچہِ برنہِ سبت سپدنس یعنی بٹوارِ شامس تام بنٛد تھاوان۔ مےٚ کٔرؠ پنٕنؠ کینٛہہ نوکر برنیٚن پٮ۪ٹھ اوٕ موٚکھٕ تعینات تاکہِ یہِ کتھ بنہِ یقینی زِ سبت کہ دوٚہہ کرِنہٕ کانٛہہ شہرس منٛز کانٛہہ چیز ہیٚنہٕ کننٕچ کوشِش۔
\v 20 مگر سبت کالہٕ رٲژ دوران ٲسؠ اکہ دویہِ لٹہِ کینٛہہ باپٲرؠ تہٕ سوداگر شہرٕ نیٚبرؠ دُکان سجاوان یُتھ تمہٕ پگاہ کینٛہہ نتہٕ کینٛہہ کنِتھ ہیٚکن۔
\v 21 مےٚ کٔرؠ تِم خبردار تہٕ ونمکھ، "یہِ چُھنہٕ تُہنٛدِ خٲطرٕ جان زِ توٚہؠ سجٲیو سبت کہ کالہٕ رٲژ دوران دیوارو نیٚبرؠ پنٕنؠ دکان۔ اگر توٚہؠ دُبارٕ یہِ کٔریو، بہٕ کرو توٚہؠ گِرفتار۔ امہِ پتہٕ آے نہٕ تم سبت کہ دوٚہہ زانٛہہ تہِ۔
\v 22 امہِ پتہٕ دِتؠ مےٚ لاوین ہِدایت زِ تِم کرن صاف و پاک پٲٹھؠ پننؠ رسٕم ادا تہٕ دروازن پٮ۪ٹھ پہرٕدٲری کٔرتھ دِن نہٕ سوداگرن شہرس منٛز اژنہٕ یُتھ سُہ ماحول پٲدٕ گژھِ یمہِ سٟتؠ سبت کہ مقدس دوٚہُک تقدُس بڈِ۔
\p "میانہِ خدایہ مےٚ دٕ یہِ نیک کٲم کرنُک توفیق! مےٚ پٮ۪ٹھ کرتہٕ کرم تکیازِ ژٕ چُھکھ بوٚڈ کرم فرما۔
\v 23 اتھ دوران وُچھ مےٚ یتہِ زِ کینٛژو یہودیو کرِ اشدُودیؔ، عمونیؔ تہٕ موٲبؠ شہرچہِ مستوراتہٕ نیتٕرؠ۔
\v 24 یمو منٛزٕ نیصف شُرؠ پتہٕ ویلایتی زبان بولان ٲسؠ تہٕ عِبرٲنؠ زبٲنؠ منٛز ٲسؠ نہٕ کتھےٕکٔرِتھ ہیٚکان۔ تم ٲسؠ سۅے زبان بولان یۅسہ ماجہِ بولان آسکھ۔
\v 25 اوے کٔر مےٚ تِمن بیٚوٲری۔ خدایس مونٛگم یمن وال لعنت۔ کینٛژن دِتُم مُشتو سٟتؠ مار تہٕ کینٛہہ أنِم ٹٔپِس رٔٹتھ تہٕ کرنٲوم پوٚختہٕ وعدہ یہِ زٲنِتھ زِ خدا چُھ بوزان۔ وعدہ اوس یہِ زِ تم کرن نہٕ پننٮ۪ن کورین زانٛہہ تہِ ویلایتی مردن سٟتؠ خاندر تہٕ نَہ انُن پننؠن نیٚچوٮ۪ن ویلایتی کورِ نیتٕرؠ۔
\v 26 مےٚ ووٚن تِمن۔ "توٚہہِ چُھ معلوم زِ سُلیمانؔ اوس اسرائیل لُک بادشاہ۔ تٔمؠ تہِ کوٚر یتھے پٲٹھؠ أکِس غار مُلکی بُت پرستہٕ زنہِ سٟتؠ نیتھٕر کٔرِتھ بوٚڈ اتُر۔ توٚہؠ چُھو زانان زِ سُہ اوس باقی مُلککیٚو بادشاہو منٛزٕ ساروٕے سرس۔ سُہ اوس خدایس تہِ ٹوٹھ، تہٕ تٔمؠ کرنوو سُہ سٲرسےٕ اسرائیلس راج۔ مگر ۅپر زنہِ سٟتؠ نیتھٕر کرنَن بنوو سلیمانؔ گناہ گار!
\v 27 مےٚ چُھ توٚہہِ نیسبت یہِ بوزِتھ سیٹھاہ دُکھ سپدان زِ توٚہہِ چُھ غٲر مُلکی بُت پرستہٕ زنیٚن سٟتؠ خانٛدر کٔرتھ پنُن خدا ناراض کوٚرمُت!
\v 28 اکھ شخصا چُھ یدُوع سُنٛد نیٚچو تہٕ کاہن اعظم الیاسبؔ سُنٛد زُر یمؠ سٲنِس دشمن حُورُونی سنبلط سنٛزِ کورِ سٟتؠ خاندر کوٚر۔ مےٚ ژھُن سُہ یروشلم شہرٕ منٛزٕ دفاہ کٔرِتھ۔
\v 29 "میانہِ خدایہ! یمو لوکو کٔر حکمِ عدوٗلی، یمو پُھٹرٲوؠ لاوین تہٕ کاہنن ہنٛدؠ بٲومٕتؠ عہد۔ یمن دِ سُہ سزا یمکؠ یم حقدار چھِ۔"
\v 30 یتھٕ پٲٹھؠ کٔرؠ مےٚ کاہن تہٕ لاوی پرٮ۪تھ رنٛگہٕ غٲر مذہبی تہٕ غٲر مُلکی چیزو نِشہ الگ۔ تہٕ کٔرم وژھِ وٲنجہِ کاہنن تہٕ لاوین ہنٛز خدمت تہٕ فرمودات بجا اننہٕ باپتھ تیار۔
\v 31 مےٚ کوٚر یمیُک تہٕ اہتمام زِ لوٗکھ انن وقتس پٮ۪ٹھ گۅڈنِکہِ پیداورُک حصہٕ، قۅربٲنیہِ زالنہٕ باپتھ زیُن تہٕ کرن مقرر صحنس منٛز جمع۔
\p "میانہِ خدایہ! یہِ کینٛژھا مےٚ کوٚر تہِ قبول کٔرتھ روز تہٕ مےٚ پٮ۪ٹھ مہربان!
