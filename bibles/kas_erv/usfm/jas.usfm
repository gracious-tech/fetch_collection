\id JAS - DMT Kashmiri
\toc1 یعقوب
\mt1 یعقوب
\c 1
\p
\v 1 بہٕ یعقوب چھُس خدا تہٕ خداوند یسوعؔ مسیحؔ سنٛز خدمت کران۔ بہٕ چھُس یہِ چِٹھؠ لٮ۪کھان توٚہہِ\f + \fr 1‏:1 \ft توٚیہِ مطلب چُھ تِم باہ یہُودؠ یسیعی قبیلہٕ یِم پننہِ ملکہٕ نشہِ دوٗر خاص کر ملکِ شامس تہٕ ایشیٲے صغیرس اندر روزان چھِ۔ \f*، یِمن یسوعسؔ پیٚٹھ یقین چھُ تہٕ یِمہٕ رومی سلطنت کٮ۪ن واریاہن علاقن منٛز روزان چھُ۔ بہٕ چھُسو توٚہہِ سارنےٕ سلام سوزان۔
\v 2 میانیو بایو تہٕ بینیو، واریاہ خوشی منایو ییٚلہِ توٚہؠ مختلف مشکلاتن ہُنٛد تجربہٕ چُھو کران۔
\v 3 یہِ سمجھِیو زنتہٕ توٚہؠ مشکلاتن منٛز خدایس پیٚٹھ ایمان چھُو تھاوان، یہِ کرِ توٚہہِ پۅختہٕ شخص بننس منٛز مدد۔
\v 4 تہنٛدِس ٲخرس تام کرِو مشکلات برداشت، تاکہِ توٚہؠ ہیٚکو پرٛتھ طریقہٕ مسیحؔ سٕنٛز پٲروی کٔرِتھ۔ تیٚلہِ گژھِو نہٕ توٚہؠ ناکام اصل کارکردگی کرنس منٛز۔
\v 5 اگر توٚہہِ منٛزٕ کٲنٛسہِ یہِ زاننٕچ ضرورت چھےٚ زِ کیا چھُ کرُن، تیٚلہِ پرژھِ سُہ خدایس تہٕ خدا ونہِ تٔمِس۔ خدا چُھ پرٛتھ کٲنسہِ فراخ دلی سان دِوان۔ خدا چُھنہٕ تِمن لوٗکن کھرٮ۪کھ کران یم چیز منٛگان چِھ۔
\v 6 مگر ییٚلہِ توٚہؠ خدایس دُعا چھِ منٛگان، توٚہہِ پزِ جواب دِنہٕ خٲطرٕ أمِس پیٚٹھ بھروسہٕ کرُن۔ اتھ پیٚٹھ مہٕ کرِو شک زِ سُہ دِیو نہٕ توٚہہِ جواب تہٕ کریٚو نہٕ مدد۔ یم لوک خدایس پیٚٹھ شک چِھ کران تم چِھ گۅڈٕ اکھ کأم کرنُک فٲصلہٕ کران، مگر پتہٕ چِھ تم بیٚیہِ کینٛہہ کرُن یژھان۔ تِم چھِنہٕ زانٛہہ تہِ اکسےٕ طریقس پیٚٹھ دٔرِتھ روزان۔
\v 7 درحقیقت، یِم لوٗکھ شک چھِ کران، تمن پزٕ نہٕ یہٕ سونٛچُن زِ خداوند خدا دیہِ تِمن تہِ یہِ تِم ایمانہٕ ورٲے منٛگان چھِ۔
\v 8 یِتھؠ لوٗکھ ہیٚکن نہٕ زانٛہہ تہِ فٲصلہٕ کٔرِتھ زِ کیا چھُ کرُن۔ تِم چھِ اکھ منصوبہ بناوان، مگر پتہٕ چھِنہٕ تِم اتھ پیٚٹھ عمل کران۔
\v 9 یِمن مسیحیؔ بٲے یِم غریب چھِ، تِمن پزِ خۅش روزُن، تکیازِ خداین چھُ یمن عزت بخُشمُت۔
\v 10 مگر یِمن ایمان والیٚن سٮ۪ٹھا پونٛسہٕ آسن، تِمن پزِ خۅش روزُن تکیازِ خداین چھُ تِمن بخُشمُت یہِ ہٲوِتھ زِ تہنٛز دولت بناوِنہٕ تِمن باقیو لوٗکو کھۅتہٕ زیادٕ بہتر۔ ٲخرکار، جنگلی پوشن ہنٛدؠ پأٹھؠ یِم صرف کینٛژس کالس خاطرٕ پھۅلان چھِ تہٕ پتہٕ ژھۅکان چھِ، امیر ایمان وٲلؠ مرن باقین ہنٛدؠ پأٹھؠ۔
\v 11 اکھ جنگلؠ پوش چھُ روزان کم وقتس تکیازِ ییٚلہِ آفتاب کھسان چھُ، امیُک تژر چھُ کُلٮ۪ن خشک کران تہٕ تہنٛدؠ پوش چھِ ؤسؠ پیٚوان۔ تِم چھِنہٕ زیادس کالس خۅشوٕنؠ روزان۔ یِتھٕ پٲٹھؠ پوش چھِ مران، امیر لوٗکھ تہِ مرن یودوے زن تِم پونٛسہٕ کماونس کُن لگمٕتؠ آسان چھِ\f + \fr 1‏:11 \ft مزامیر 102:11، یسعیاہؔ 40:7۔ 8\f*۔
\v 12 خدا چھِ تِمن عزت بخشان یِم تس مشکل حالاتن منٛز فرمانبردار روزن۔ بے شک دِیہِ تمن خدا انعام، تِمن پوشوٕنؠ زندگی بخشِتھ۔ یہِ زن خداین وعدٕ چھُ کوٚرمُت تِمن سارنےٕ سٟتؠ یہِ کرنُک یِم تس لول برن۔
\v 13 ییٚلہِ أسؠ گناہ کرنس تنبلو، اسہِ پزِ نہٕ یہِ سونٛچُن زِ یہِ چُھ خدا یُس اسہِ تنبلاوان چھُ۔ نہ، کانہٛہ تہِ ہیٚکہِ نہٕ خدایس بُرٕ کرنہٕ خٲطرٕ آمادٕ کٔرِتھ، تہٕ خدا چُھنہٕ زانہٛہ تہِ کٲنٛسہِ بُرٕ کرنہٕ خٲطرٕ آمادٕ کرنٕچ کوشش کران۔
\v 14 مگر لوٗکھ چھِ یژھان پنہٕ نیٚوٕے خوٲہِشو کِنؠ بُرٕ کرُن۔ ییٚلہِ تِم یہِ کران چھِ، یہِ چھُ زنتہٕ تِم چھِ کُنہِ زالس منٛز پھسیمٕتؠ
\v 15 اوٕ پتہٕ، تکیازِ تِم چھِ بُرٕ کٲم کرنٕچ خوٲہِش کران، تِم چھِ تہِ کرُن شروع کران، تہٕ ٲخر کار چھِ تِم عادتن کران۔ اگر نہٕ تم پننیٚو گناہگار حرکژو نِش پتھ ہیٚن، تم گژھن ہمیشہ خاطرٕ خدایس نش جُدا۔
\v 16 میانیٚو ایماندار سٲتھیٚو یِمن بہٕ لول چھُس بران۔ پننِس پانس دھوکھہٕ دیُن کریٚو بنٛد۔
\v 17 پرٛتھ کانہٛہ پٔزؠ یٲرؠ، اصل تہٕ کٲمل تحفہٕ چھِ بب خدایہِ سنٛدؠ طرفہٕ یوان، یُس آسمانس پیٚٹھ چُھ۔ تٔمؠ بنٲوؠ آفتاب، زوٗن تہٕ تارک مگر خدا چُھنہٕ تِتھ پٲٹھؠ بدلان یِتھٕ پٲٹھؠ یہنٛزٕ ژھایہ بدلان چھےٚ، نٔنؠ گژھان تہٕ غٲب گژھان چھِ۔ خدا چُھنہٕ زانہٛہ بدلان۔ سُہ چُھ ہمیشہٕ رُت\f + \fr 1‏:17 \ft بب خداۓ\f*۔
\v 18 خدا بنیاو سون روحٲنی بب ییٚلہِ اسہِ تسنٛدِس پٔزِس پٲغامس پیٚٹھ یقین کوٚر۔ یہِ اوس تہِ یہِ سُہ کرُن یژھان اوس۔ لہٰذا بناے یسوعسؔ پیٚٹھ ایمان انن وٲلؠ گۅڈنِکؠ لوٗکھ یم خدایس سٟتؠ امہِ قسمٕکٮیٚن تعلقن ہنٛد تجربہٕ چِھ کران یُس مستقبلس منٛز مزید لوٗکھ کرن۔
\v 19 میانیٚو ایماندار سٲتھیٚو یِمن بہٕ لول چھُس بران، بہٕ چھُس یژھان توٚہؠ زٲنؠ راوٕنؠ زِ توٚہہِ پزِ پرٛتھ اکِس صبرٕ سان بوزُن زِ باقین کیا چھُ ونُن۔ توٚہہِ پزِ احتیاط سان پنٕنؠ کتھ کرٕنؠ۔ توٚہہِ پزِ پنُن شرارت قوبو کرُن،
\v 20 تکیازِ ییٚلہِ اسہِ شرارت چھُ کھسان، اسؠ ہیٚکو نہٕ اصل چیز کٔرِتھ یہِ خدا یژھان چھُ زِ اسؠ گژھو کرٕنؠ۔
\v 21 لہٰذا تمام قسمچہٕ بُرٕ کامہِ کرنہِ کرِو بند۔ فخرٕ سان مزاحمت کرنہٕ بغٲر کرِو تہِ یہِ خداین توٚہہِ کرنہٕ باپتھ ووٚنمُت چُھ۔ خدا کرِ توٚہہِ یہِ یاد تھاونہٕ تہٕ سمجھنہٕ باپتھ مدد۔ امہِ سٟتؠ سپدِ یہِ ظٲہِر زِ توٚہؠ چھُو خدایس سٟتؠ رٔلِتھ۔
\v 22 یہِ چُھ اہم زِ خدا کیا حکم چھُ دِوان، اتھ مہٕ کرِو صرف بوزُن۔ تم لوک یم صرف یہٕ بوزان چِھ تہٕ چھِنہٕ اتھ پیٚٹھ عمل کران، تِم چِھ پننس پانس بیوقوف بناوان یہِ سونٛچِتھ زِ یہِ بچاوِ تِمن۔
\v 23 تہٕ کینٛہہ لوٗکھ چھِ ووٚنؠ خدایہِ سُنٛد پٲغام بوزان، مگر تِم چھِنہٕ تہِ کران یہِ سُہ پٲغام ونان چھُ۔ یِم لوٗکھ چھِ تٔمِس شخصہٕ سنٛدؠ پٲٹھؠ یُس پنُن بُتھ عٲنس منٛز چھُ وُچھان،
\v 24 حالانکہِ سُہ چُھ پانس کُن وُچھان، مگر سُہ چُھ شیشہٕ نِش دوٗر گژھان تہٕ فوراً چُھس مٔشِتھ گژھان زِ سُہ کیاہ چُھ باسان۔
\v 25 مگر باقےٕ لوٗکھ چھِ سونٛچِتھ سمجھِتھ خدایہِ سُنٛد قانون مانان۔ یہِ چُھ مکمل تہٕ یہِ چھُ لوٗکن رضامندی سان تہِ کرنس قٲبل بناوان یہِ خدا یژھان چھُ زِ تِم گژھن کرٕنؠ۔ یُتھ خدا تِمن برکت دییہِ۔
\v 26 کینٛہہ لوٗکھ چھِ سونچان زِ تِم چھِ خدایہ سٕنٛز صحیح پٲٹھؠ عبادت کران، مگر تِم چھِ بے ہودٕ کتھٕ کران۔ یمن لوٗکن ہُنٛد سونٛچُن چھُ غلط۔ خدا چھُنہٕ سانہِ عبادتہٕ سٟتؠ متٲثِر سپدان یودوے أسؠ ہٮ۪تھےٕ بُرٕ کتھٕ کرو\f + \fr 1‏:26 \ft مزامیر 34:13،141:3\f*۔
\v 27 تِمو چیزو منٛز، یِم اسہِ خداین ؤنؠ کرنہٕ باپتھ چھُ اکھ یہِ زِ یتیمن تہٕ مۅنٛدن ہُنٛد چھُ خیال تھاوُن یِم پریشٲنی منٛز مبتلا آسن۔ تِم لوٗکھ یِم تہِ کرن، چھِ پزی خدایہِ سنٛز عبادت کران، یُس سون بب چھُ۔ لوکھ چھِ اوٕ کِنؠ تہِ پزی خدایہِ سنٛز عبادت کران اگر نہٕ تِم باقین ہنٛدؠ پٲٹھؠ غٲر مہذب پٲٹھؠ سونٛچن یِم خدایہِ سنٛز نافرمانی چِھ کران۔ خدا چھُ تِمن لوٗکن ہُنٛد تٲیید کران یِم یِتھی چیز کران چھِ۔
\c 2
\p
\v 1 میانیٚو ایماندار سٲتھیٚو، کینٛژن لوٗکن مہٕ کٔرِو باقیو نِشہٕ زیادٕ عزت تہٕ أتھؠ دوران کٔرِو سٲنِس عظیم خداوند یسوعؔ مسیحسؔ پیٚٹھ تہِ بھروسہٕ\f + \fr 2‏:1 \ft ایوب 34:19، زبور 10- 24:7 \f*۔
\v 2 مثلاً، فرض کٔرِو زِ اکھ شخص یُس سۅنہٕ سٟتؠ سجٲوِتھ تہٕ خوبصورت پلو لٲگِتھ چُھ، گژھِ توٚہہِ سٟتؠ عبادتس منٛز شٲمِل۔ تہٕ فرض کٔرِو اکھ غریب شخص تہِ چھُ توٚہہِ سٟتؠ شٲمِل گژھان یمِس ژھٮیٚنمٕتؠ پلو لٲگِتھ چھِ۔
\v 3 تہٕ فرض کٔرِو زِ توٚہؠ دِیو اصل پلو لٲگِتھ شخصس کُن خاص توجہ۔ توٚہؠ ؤنِو تمِس، "مہربٲنی کٔرِتھ بیٚہِو یتھ اصل بیٚہن جایہِ پیٚٹھ!' مگر اکِس غریبس چھو توٚہؠ اکِس کم عزت واجنہِ جایہِ کُن گژھنہٕ باپتھ ونان یہِ دٔپِتھ، "نیر ژٕ روز ہوٚتٮ۪تھ کھڑا، یا بیٚہہ پتھرِس پیٚٹھ!"
\v 4 امہِ سٟتؠ چھُ امہِ کتھِ ہُنٛد اِشارٕ لگان زِ تُہنٛد مانُن چھُ زِ امیر لوٗکھ چھِ غریب لوٗکو کھۅتہٕ بہتر۔ امہ سٟتؠ چھُ باسان زِ توٚہؠ چھُو پنٕنؠ فٲصلہٕ کران زِ لوٗکن سٟتؠ کیُتھ سلوک پزِ کرُن یُس بُرٕ سونچنس پیٚٹھ مبنی آسان چھُ۔
\v 5 میانیٚو سٲتھی ایماندارو، یِمن بہٕ لول چھُس بران، بوزِو میون، خداین چھِ کایناتہٕ منٛزٕ غریب لوٗکھ ژٲرؠ متؠ تمِس پیٚٹھ سٮ۪ٹھا زیادٕ بھروسہٕ کرنہٕ خاطرٕ یِم نہٕ کُنہِ مۅللہِ چیزٕکؠ مٲلک بسان چھِ۔ سُہ دِیہِ تِمن عظیم چیز ییٚلہِ سُہ پرٛتھ جایہِ حکومت کرِ۔ یہِ چُھ تی یہِ تمؠ کرنُک وعدٕ چھُ کوٚرمُت زِ سُہ کرِ پرٛتھ اکِس خٲطرٕ یُس تس لول برِ۔
\v 6 مگر توٚہہِ کوٚرُو غریبن سٟتؠ بے عزتی ہُنٛد سلوک! اتھ متعلق سونٛچِو! یِم چھِ امیر لوٗکھ نہ زِ غریب، یم تُہنٛدٮ۪ن مصیبتن ہُنٛد وجہ چھِ۔ یِم چھِ امیر لوٗکھ یِم توٚہہِ زبردستی سان منصفن برونٛہہ کنہِ الزام لگاونہٕ خٲطرٕ عدالت وانن چھِ لاگان!
\v 7 تہٕ تِم چھِ تِم یِم توٚہہِ بے عزتی چھِ کران تکیازِ توٚہؠ چھُو مسیحیؔ!
\v 8 لہٰذا پزیٚو نہٕ توٚہہِ امیر لوٗکن سٟتؠ غریب لوٗکو کھۅتہٕ بہتر سلوک کرُن۔ بلکہِ پزِ توٚہہِ تتھ حکمس پیٚٹھ عمل کرٕنؠ یہِ یسوعن ووٚن زِ سُہ چھُ سٮ۪ٹھا اہم۔ یہِ چُھ موسیٰ سنٛدِس شریعتس منٛز: "پننِس ہمسایس بٔرِو لول تِتھے پٲٹھؠ یِتھٕ پٲٹھؠ توٚہؠ پانس چھُو بران" یودوے توٚہؠ پرٛتھ کٲنٛسہِ ہیووےٕ لول بٔرِو، توٚہؠ کٔرِو تہِ یہِ صحیح چھُ\f + \fr 2‏:8 \ft احبار 19:18 \f*۔
\v 9 ووٚنؠ گو، اگر توٚہؠ کینژن نفرن باقیٚو کھۅتہٕ زیادٕ احترام کرِو، تیٚلہِ چھو توٚہؠ غلط کران۔ تکیازِ توٚہؠ چھو نہٕ خدایہِ سنٛدِس حُکمس پیٚٹھ عمل کران، خدا کرِ اعلان زِ توٚہہِ چھو امسنٛدِ قانونٕچ خلاف ورزی کٔرمٕژ\f + \fr 2‏:9 \ft احبار 19:15 \f*۔
\v 10 خدا ونہِ یہِ تکیازِ اگر توٚہؠ غدایہِ سُنٛد کانہٛہ اکھ قانون پھُٹرٲیو، حتاکہِ باقین سارنےٕ پیٚٹھ عمل کٔرِتھ تہِ، یہِ گو زنتہٕ توٚہہِ چھُو پرٛتھ کانہٛہ خدایہِ سُنٛد قانون پھُٹرومُت۔
\v 11 مثلاً، خداین ووٚن، "زِنا مہٕ کرِو، "مگر تٔمؠ ووٚن یِتہِ، "کانہٛہ مہٕ کٔرؠ وون قتل" اوٕ کِنؠ اگر توٚہؠ زِنا کرنہٕ نِشہٕ پرہیز کٔرِو، مگر توٚہؠ کٔرؠ وون کانہٛہ قتل، تیٚلہِ بنیٚو توٚہؠ سُہ شخص یُس خدایہِ سنٛدین قانونن ہنٛز نافرمٲنی چھُ کران\f + \fr 2‏:11 \ft خروج 14-20:13 تثنِیہ شرع 118-5:17 \f*۔
\v 12 ہمیشہٕ کٔرِو باقین سٟتؠ امہِ طریقہٕ کتھ یُتھ تِم سمجھن زِ خدا کرِ توٚہہِ تمہِ حکمہٕ مطٲبق فٲصلہٕ یُس تٔمؠ اسہِ لوٗکن سٟتؠ لول برنہٕ باپتھ دیُت۔ ییٚلہِ اسؠ اتھ حکمس پیٚٹھ عمل کان چھِ، اسؠ چھِ پننہِ مرضی سان خدایہِ سنٛز اطاعت کران۔
\v 13 توٚہہِ پزیٚو یہِ ونُن تہٕ کرُن تکیازِ ییٚلہِ خدا فٲصلہٕ کرِ، سُہ چھُ تہنٛدِ خٲطرٕ بےٚ رحم یِمو نہٕ باقین پیٚٹھ رحم کوٚرمُت آسہِ۔ مگر یودوے اسؠ باقین پیٚٹھ مہربان آسو، تیٚلہِ ہیٚکو اسؠ خدایہِ سنٛدِ اسہِ پیٚٹھ مہربان آسنٕچ امید کٔرِتھ ییٚلہِ سُہ فٲصلہٕ کرِ۔
\v 14 میانیٚو ایماندار سٲتھیٚو، کینٛہہ لوٗکھ چھِ ونان، "بہٕ چھُس خداوند یسوع مسیحسؔ پیٚٹھ پژھ تھٲوِتھ" مگر توتہِ چھےٚ یہنٛدٮ۪ن اعمالن منٛز لولٕچ کمی آسان۔ یہِ تِم ونان چھِ تمہِ سٟتؠ سپدِ نہٕ تِمن کانہٛہ رٕژر۔ اگر تمن ہنٛد عقیدٕ صرف زبٲنی چُھ، خدا بچاوِ نہٕ تِمن ہرگِز۔
\v 15 فرض کرو زِ اکھ ایماندار سٲتھی بوے یا بیٚنہِ، چھِ پرٛتھ دوٚہہ لگاتار پلو تہٕ کھیٚنہٕ ورٲے آسان۔
\v 16 تہٕ فرض کرِو زِ توٚہہِ منٛزٕ چھُ اکھ تِمن ونان، "فِکِر مہٕ کرِو، کرِو وُشنیر، تہٕ کھیٚیِو سُہ کھیٚن یُس توٚہہِ خۅش گژھِ۔ مگر فرض کرِو زِ پتہٕ کرِو نہٕ توٚہؠ تِمن کانٛہہ پلو یا کھٮ۪ن فراہم۔ تتھ صوٗرتس منٛز آسہِ نہٕ یہِ تہنٛدِ باپتھ کانہٛہ تہِ مدد!
\v 17 یِتھے پٲٹھؠ، اگر توٚہؠ صرف ونان چھُو زِ توٚہؠ چھُو یسوعسؔ پیٚٹھ یقین کران مگر توٚہؠ چھُو نہٕ تیُتھ کینٛہہ کران یمہِ سٟتؠ زن تہِ عملی طورباسہِ، تیٚلہِ چھُو نہٕ توٚہہِ یسوعسؔ پیٚٹھ ایمان۔
\v 18 مگر کانٛہہ ہیٚکہِ توٚہہِ ؤنِتھ زِ توٚہہِ چھُو ایمان، ییٚلہِ زن مےٚ عمل چھےٚ۔ سُہ ہیٚکہِ یہِ دعویٰ کرِتھ زِ اکھ شخص ہیٚکہٕ پننہِ مذہبُک اظہار ایمان یا کامہِ سٟتؠ کرِتھ تہٕ یہِ زِ تمِس چھنہٕ دۅشوٕنی ہنٛز ضرورت۔ مگر بہٕ ونہٕ امکِس جوابس منٛز زِ توٚہؠ ہیٚکِو نہٕ مےٚ کامہِ ورٲے پنُن ایمان ہٲوتھ۔ بہٕ، ہیٚکہٕ بیٚیہِ طرفہٕ پننہِ کامہِ سٟتؠ توٚہہِ پنُن ایمان ہٲوتھ۔
\v 19 بہٕ ہاوٕ توٚہہ زِ خدایس پیٚٹھ تمسنٛدیٚن حکمن پیٚٹھ عمل کرنہٕ بغٲر ہیٚکہِ نہٕ خدایس پیٚٹھ یقین تھاوُن نجاتُک بٲعث بٔنِتھ۔ توٚہہ چھُو یقین زِ صرف چھُ اکھ حقیقی خدا۔ مگر شیطان تہِ چھِ اتھ پیٚٹھ یقین کران، تہٕ تم چِھ خوفس منٛز لرزان تکیازِ تم چھِ زانان زِ اکھ حقیقی خدا دِیہِ تمن سزا\f + \fr 2‏:19 \ft مرقُس 1:24، 5:7 عملہٕ 16:17 مرقُس 1:23، 24، 5:7 \f*۔
\v 20 امہ علاوٕ، دِمے بہٕ ژےٚ بیوقوف نفرس امہِ کتھہِ ہنٛد ثبوت زِ اگر کانٛہہ یسوعسؔ پیٚٹھ یقین کرنُک دعویٰ چُھ کران مگر سُہ چھُنہٕ کانٛہہ تِژھِ عمل کران، تیلہِ چھےٚ تمسنٛز کتھٕ فضول۔
\v 21 یہ چُھ ثبوت۔ ابرہامنؔ، یمہِ سنٛدؠ أسؠ زُرؠ چھِ، دیُت ہٲوتھ زِ سُہ اوس پنُن نیٚچو اضحاقؔ اکہِ قربانی رنگؠ خدایس پیش کرنہٕ خٲطرٕ رضامند، ہرگا خدا یژھِ ہے تمسُنٛد تہِ کرُن۔ خداین کوٚر ابرہامؔ اکھ راستباز شخص تسلیم تکیازِ تٔمؠ ہوو زِ سُہ کرِ تمسنٛز فرمانبردٲری تہٕ امہِ سٟتؠ گو ثٲبت زِ تٔمؠ کوٚر واضیح پٲٹھؠ خدایس پیٚٹھ بھروسہٕ\f + \fr 2‏:21 \ft پیدٲیش 22:9 \f*۔
\v 22 یتھِ پٲٹھؠ کٔر ابرہامنؔ خداے سنٛدین حکمن پیٚٹھ عمل تکیازِ تمِس اوس خدایس پیٚٹھ بھروسہٕ۔ ییٚلہِ تٔمؠ خدایہِ سنٛز فرمانبردٲری کٔر، تمؠ دیُت امِس مدد خدایس پیٚٹھ پوٗرٕ بھروسہٕ کرنُک۔
\v 23 سُہ گو زِ کِتھٕ پٲٹھؠ سپدؠ صحیفہٕ پوٚز ثٲبت یمن منٛز وننہٕ چُھ یوان، "تکیازِ ابرہام ؔ اوس پٔزؠ پأٹھؠ خدایس پیٚٹھ بھروسہٕ کران، خداین وُچھ سُہ زنتہٕ کانٛہہ یمؠ تہِ کوٚر یہِ صحیح اوس" باقی صحیفن منٛز چھُ یہِ وننہٕ یوان زِ ابرہامؔ اوس خدایہِ سُنٛد دوست\f + \fr 2‏:23 \ft پیدٲیش 15:6 \f*۔
\v 24 ابرہامؔ سنٛزِ مثالہِ سٟتؠ چُھ یہِ واضیح سپدان زِ خدا چُھ لوٗکن راستباز سمجھان تکیازِ تہنٛدِ کرنہٕ سببہٕ نہ زِ محض تس پیٚٹھ یقین اننہٕ کِنؠ۔
\v 25 یتھِ کِنؠ تمؠ ابرہامنہِؔ خٲطرٕ کوٚر، خدا اوس راحبس تہٕ تمہِ سببہٕ راستباز تصوُر کران یہِ تمؠ کوٚر۔ سۅ چھےٚ طوائف ٲسمٕژ، پوٚز تمؠ تھوو تِمن شیٚچھِ والیٚن ہُنٛد خیال یِم یشوعن تتھ علاقس جاسوٗسی کرنہٕ خٲطرٕ سوزؠ۔ امہِ پتہٕ کوٚر تٔمؠ تمن محفوظ وتہِ کُن ہدایت کرِتھ ژلنس منٛز مدد۔ \f + \fr 2‏:25 \ft یشوع باب 2 عبرانین 11:31 \f*
\v 26 یہٕ سورےٕ چُھ اکھ اہم حقیقت واضیح کران۔ یتھٕ کِنؠ زن کانٛسہِ شخصہٕ سُنٛد جسم چُھنہٕ زندٕ آسان اگر نہٕ سُہ ووٚنؠ شاہ آسہ کھالان، تِتھے پٲٹھؠ چھُنہٕ اکھ شخص پزؠ پٲٹھؠ خدایس پیٚٹھ بھروسہٕ کران، اگر نہٕ سُہ پننہِ کرنہٕ امہِ بھروسُک اظہار چھُ کران۔
\c 3
\p
\v 1 میانیٚو ایماندار سٲتھیٚو، توٚہہِ منٛزٕ پزِ نہٕ اکثرن خدایہِ سٕنٛدِ کلامٕکؠ وۅستاد بننٕچ خوٲہِش کرٕنؠ۔ یتھٕ کِنؠ توٚہہِ خبر چھو، خدا کرِ اسہِ وۅستادن ہُنٛد فٲصلہٕ باقیٚو لوٗکو کھۅتہٕ زیادٕ سختی سان۔
\v 2 بہٕ ونو توٚہہِ زِ توٚہہِ منٛزٕ کیازِ پزِنہٕ واریاہن وۅستاد بنُن۔ اسؠ سٲری چھِ اکثر تِم چیز کران یِم غلط چھِ۔ وۅنؠ گوو اگر کانٛہہ غلط کتھٕ وننہٕ نِشہٕ پرہیز ہیٚکہِ کرِتھ، تیٚلہ چُھ سُہ شخص تہِ بنیامُت یہ خدا تمس بناون یژھان چُھ۔ تیٚلہِ ہیٚکہِ سُہ پننٮ۪ن تمام عملن پیٚٹھ تہِ قوبو پرٲوِتھ۔
\v 3 واضیح کرنہٕ باپتھ ہیٚکو اسؠ گُرؠ سنٛدِس ٲسس منٛز اکھ لۅکُٹ دھاتو سیکھ تھٲوِتھ تہٕ کرو یہِ استعمال گُرؠ سنٛدِس تتھ طرفس کُن گژھنس یور اسؠ یژھان چھِ۔ ییٚلہِ اسؠ تہِ کرو، اسؠ ہیٚکو گُرؠ سُنٛد بارٕ جسم پکنٲوِتھ امے لۅکٹہِ دھاتو سامانہٕ سٟتؠ۔
\v 4 سمندری جہازن پیٚٹھ تہِ کرِو غور۔ اکھ سمندری جہاز ہیٚکہِ واریاہ بوٚڈ ٲسِتھ تہٕ ہوا یُس اتھ برونہٛہ کُن دکہٕ دِتھ چھُ سُہ ہیٚکہِ سٮ۪ٹھا زوردار ٲسِتھ۔ توتہِ، اکھ لۅکُٹ پتوار استعمال کرِتھ، کپتان ہیٚکہٕ جہاز پننہٕ مرضی مطٲبق کُنہٕ تہٕ منٛزلس تام واتنٲوِتھ۔
\v 5 یودوے سانہِ زٮ۪وٕ واریاہ لۅکچہ چھےٚ، أسؠ چھِ تِم یہِ تھیٚکنہٕ خٲطرٕ استعمال کران زِ اسہِ چھےٚ بجہِ کامہِ کرِمژٕ۔ یِتہِ تھٲیو یاد زِ اکھ شروع گژھوٕنؠ لۅکٕٹ نارٕ ریٚہہ ہیٚکہِ واریاہ کُلؠ زٲلِتھ۔
\v 6 یِتھٕ پٲٹھؠ نار جنگلس چھُ زالان، ییٚلہِ اسؠ بد لفظ چھِ ونان، اسؠ چھِ واریاہن لوٗکن دِل رنج کران۔ یہِ أسؠ ونان چھِ، چھُ ہٲوِتھ دِوان زِ اسہِ منٛز چھِ واریاہ بد چیز۔ ییٚلہِ اسؠ بد کلام کران چھِ، یہِ چُھ تتھ سٲرؠ سےٕ بدنس ناپاک کران یہِ أسؠ سونچان تہٕ کران چھِ۔ یہِ ہیٚکہِ سٲنؠ پوٗرٕ زندگی تباہ کٔرِتھ۔ یہ چُھ پانہٕ شیطان یُس اسہِ بد لفظ وننہٕ خاطرٕ زور چُھ دیوان۔
\v 7 بیاکھ مثال دِمو، لوٗکھ چِھ بیوٚن بیوٚن قسمن ہنٛدٮ۪ن جنگلی جانورن، جاناوارن، کھکھرٮ۪ل جاناوارن، تہٕ تِمن جانورن یِم آبس منٛز روزان چھِ، سیی بناونس قٲبل سپدیمٕتؠ۔
\v 8 وۅنؠ گوو، کانٛہہ اکھ تہِ ہیٚکہِ نہٕ تمن چیزن کاپہِ رٔٹِتھ یِم سُہ ونان چھُ۔ تِم چیز یِم لوٗکھ ونان چھِ، تم چھِ اکس خطرناک جانورس سٟتؠ مشابہت تھاوان یُس پننہٕ زہرٕ سٟتؠ باقین لگاتار ہلاک کرنہٕ نِش پتھ چُھنہٕ ہٹان۔
\v 9 أسؠ چھِ بٔلؠ خدایس تعریف کرنہٕ خٲطرٕ کتھن ہُنٛد استعمال کران یُس سون خداوند تہٕ بب چھُ۔ پوٚز اسہِ چھِ یہِ وننہٕ خٲطرٕ تہِ بٔلؠ استعمال کران زِ اسہِ چھِ یژھان لوٗکن بُرٕ چیز واقع سپدٕنؠ۔ یہِ چھُ سٮ۪ٹھا غلط، تکیازِ خداین بنٲوؠ لوٗکھ پانس ہِوؠ۔
\v 10 کانٛہہ ہیٚکہِ پننہِ بولہِ خدایہِ سنٛدؠ تعریف کرنہٕ خٲطرٕ استعمال کٔرِتھ۔ مگر، پتہٕ ہیٚکہِ سُہ امے بولہِ ذریعہٕ کٲنچھِتھ زِ باقین لوٗکن پیٚٹھٕ گوٚژھ بُرٕ سپدُن۔ میانیٚو ایماندار سٲتھیٚو، یہِ گژھہِ نہٕ سپدُن!
\v 11 حقیقتن اصل میوٹھ آب تہٕ خراب مزٕ وول آب چھِنہٕ اکے آگرٕ پیٚٹھٕ نیران۔
\v 12 میانیٚو ایماندار سٲتھیٚو، انجیرؠ کُل ہیٚکہِ نہٕ زیتون پٲدٕ کرِتھ۔ تہٕ اکھ دچھِ کُل ہیٚکہِ نہٕ انجیر پٲدٕ کرِتھ۔ نہ ہیٚکہِ نمکین آگُر اصل آب دِتھ۔ یِتھے پأٹھؠ پزِ اسہِ تی بولُن یہِ رُت چھُ۔ تہٕ اسہِ پزِ نہٕ تہِ ونُن یہِ بُرٕ چھُ۔
\v 13 اگر توٚہہِ منٛزٕ کانہٛہ واریاہ سمجھدار چھُ، تیٚلہِ ہٲوِو توٚہؠ یہِ رٕتؠ پٲٹھؠ زنٛدگی گُزٲرِتھ۔ گاٹُل آسُن چھُ اسہِ دویمٮ۪ن سٟتؠ رُت سلوک کرنہٕ خاطرٕ رہنمٲئی کران۔
\v 14 ووٚنؠ گوو، اگر توٚہؠ ژوٗرِ پٲٹھؠ باقین سٟتؠ ناراضگی تھاوان چھُو تہٕ یہِ سونٛچان چھُو زِ توٚہؠ چھُو تِمو کھۅتہٕ زیادٕ اہم، توٚہہِ پزِ نہٕ یہِ دعوا کرُن زِ توٚہؠ چھُو دانا۔ امیُک مطلب گوو یہِ ونُن زِ کینٛہہ تہِ غلط چُھ درحقیقت صحیح۔
\v 15 تِم لوٗکھ یِم حسدی تہٕ خۅد غرض چھِ، چھِنہٕ تِتھؠ دانا آسان یہِ خدا چُھ یژھان۔ بلکہِ چھِ تِم تمن لوٗکن ہنٛدؠ پأٹھؠ سونٛچان تہٕ برتاو کران یم نہٕ خدایس عزت چھِ کران، تِم چھِ پننٮ۪ن بُرٕ خٲہِشن ہنٛز پٲروی کران۔ تِم چھِ بد روحن ہنٛدؠ پأٹھؠ عمل کران۔
\v 16 اسؠ ہیٚکو ونِتھ زِ تِم لوٗکھ چھِنہٕ دانا یِم ناراضگی تھاوان چھِ تہٕ خۅد غرض چھِ، تکیازِ تم چِھ پننٮ۪ن پانن کاپہِ رٹان۔ تم چِھ مختلف گناہگار کامٮ۪ن منٛز مشغول روزان۔
\v 17 مگر سُہ شخص یس خداین رُت روزنُک ہدایت دیُت، چھُ ساروےٕ کھۅتہٕ گۅڈٕ اخلٲقی طور شوٚد آسان۔ یُتھ ہیٚو شخص چھُ باقین سٟتؠ تہِ صلح کرنٕچ کوٗشش کران۔ سُہ چھُ تِمن پیٚٹھ مہربان تہٕ تِمن سٟتؠ چھُ اصل تعلقات تھاوان۔ سُہ چُھ تِمن لوکن خٲطرٕ فراخ دل یِم نہٕ اتھ لایق چھِ، تہٕ سُہ چُھ باقین ہُنٛد عملی طور مدد کران۔ سُہ چُھنہٕ اکِس شخصہٕ سنٛدِ کھۅتہٕ بیٚیِس طرفداری ہاوان، تہٕ سُہ چھُنہٕ تہِ آسنُک بہانہ کران یُس نہٕ سُہ چُھ۔
\v 18 ییٚلہِ لوٗکھ باقین سٟتؠ رلنس منٛز مدد کرنہٕ خاطرٕ محتاط طریقو کٲم کرن، تیٚلہِ ہیٚکن تِم باقین سٟتؠ اصل تعلقات تھاونس منٛز مدد کرِتھ۔
\c 4
\p
\v 1 بہٕ ونو توٚہہ زِ توٚہؠ کیازِ چھُو پانہٕ وٲنؠ اکھ اکِس سٟتؠ لڑایہِ تہٕ جگڑٕ کران۔ یہِ چھُ اوٕ کِنؠ زِ توٚہہ منٛزٕ پرٛتھ کانہٛہ چھُ انٛدرؠ کِنؠ یژھان غلط کامہِ کرُن۔ تِمے خوٲہِشہٕ چھو توٚہہِ لڑٲے کرنس کُن پکناوان یُتھ توٚہؠ یِم چیز کٔرِتھ ہیٚکِو۔
\v 2 توٚہؠ چھُو چیزن ہنٛز خوٲہِش کران، مگر توٚہہِ چھُو نہٕ تِم حٲصِل گژھان۔ امہِ سٟتؠ چھُو توٚہہِ تِمن لوٗکن سٟتؠ سخ ناراضگی محسوس گژھان یِمن نِش تِم آسن۔ مگر توتہِ چھُو نہٕ توٚہہِ تِم چیز حٲصِل گژھان یِم توٚہؠ یژھان چھُو۔ ، لہٰذا چھُو توٚہؠ باقین سٟتؠ لڑایہِ تہٕ جگڑٕ کران۔ اگر توٚہؠ خدایس منٛگِو تِمو چیزو بدلہٕ یِم توٚہؠ یژھان چھُو، تیٚلہِ دِیو خدا توٚہہِ تہ یہِ توٚہہِ پزی ضرورت چھُو۔
\v 3 مگر یودوے توٚہؠ خدایس یِمن چیزن متعلق منٛگِو تہِ، سُہ دِیو نہٕ توٚہہِ تِم چیز۔ تکیازِ توٚہؠ چھُو غلط ارادو یِم چیز منٛگان۔ توٚہؠ چھُو یِم چیز ژھانڈان تاکہِ توٚہؠ کرِو تِم غلط طریقو پننیٚو عاشو خٲطرٕ استعمال۔
\v 4 توٚہؠ چھُو خدایہِ سنٛدین حکمن پیٚٹھ عمل نہٕ کٔرِتھ تسنٛدؠ نافرمان بنان نہ زِ لول ورتاون وٲلؠ۔ توٚہہِ پزیٚو یہِ سمجھُن زِ تِم یِم کۅکار لوٗکن ہنٛدؠ پٲٹھؠ چھِ کٲم کران، تِم چھِ خدایہِ سنٛدؠ دشمن۔ لہٰذا اگر توٚہؠ یِتھے پٲٹھؠ زندگی گُذارنُک فٲصلہٕ چھُو کران، تیٚلہِ کٔرِو توٚہؠ خدایس سٟتؠ دشمنی ہُنٛد انتخاب\f + \fr 4‏:4 \ft ہوشیع 1:3، 9:1، یرمیاہ 20، 10-3:6، مرقُس 8:38، متی 12:39، 16:14، 1یوحنا 16-2:15\f*۔
\v 5 توٚہہِ پزیٚو یہِ سمجھُن زِ خداین چُھ زٲنِتھ مٲنِتھ صحیفن منٛز اسہِ اتھ متعلق ووٚنمُت۔ اتھ منٛز چھُ سُہ اسہِ ہیٚچھناوان زِ یُس روح أمؠ اسہِ دِیُت سُہ چھُ اسہِ پننہِ زندگی تتھ طریقس پیٚٹھ زُونچ خٲہِش کران یمہِ سٟتؠ سُہ خۅش روزِ\f + \fr 4‏:5 \ft خروج 20:5، 34:14، ذکریاہ 8:2 \f*۔
\v 6 اگر اسؠ تِتھٕ پٲٹھؠ زُوو یتھٕ پٲٹھؠ خدا خۅش روزِنہٕ، سُہ چھُ اسہِ پیٚٹھ سٮ۪ٹھا مہربان۔ سُہ کرِ اسہِ مدد بدل طریقہٕ زُونہٕ باپتھ اگر اسؠ ندامتہٕ سان قبول کرو زِ اسؠ رودؠ غلط کران۔ یوٚہے چھُ وجہ زِ یہِ تعلیم چھےٚ کتابِ مقدسس منٛز درج: "خدا چُھنہٕ تِمن مدد کران یِم گمنڈی آسن، مگر سُہ چھُ تِمن مدد کران یِم حلیم چھِ\f + \fr 4‏:6 \ft امثال 3:34 \f*"
\v 7 توے کٔرِو خدایہِ سنٛزِ فرمانبردٲری باپتھ عٲجزی ہُنٛد انتخاب۔ پوٗرٕ پٲٹھؠ کٔرِو فٲصلہٕ زِ شیطان سنٛزن آزمٲیشن منٛز یِیو نہٕ ہٮ۪نہٕ۔ امہِ سٟتؠ گژھِ شیطان توٚہہِ آزماونچ کوشش کرنس منٛز ناکام۔
\v 8 خدایس سٟتؠ روزِو ایماندار تہٕ کھُلہٕ۔ اگر توٚہؠ تہِ کٔرِو، سُہ کرِ توٚہہِ پانس کُن خۅش آوے۔ توٚہؠ یِم گناہ گار چھُو، غلط کٲم کرنہٕ نِشہٕ یِیو باز تہٕ صرف کرِو تِم کامہِ یِم صحیح چھےٚ۔ توٚہؠ یِم خدایس سٟتؠ پننہِ پانچہِ وعدٕ بندی کرنس منٛز ترٮ۪ن تہٕ تروُہن منٛز آسن، منفی خیالات کٔرِو بند تہٕ صرف دِیو مثبت خیالاتن پیٚٹھ زور\f + \fr 4‏:8 \ft ذکریاہ 1:3 ملاکی 3:7 \f*۔
\v 9 غمُک اظہار کٔرِو تہٕ غمگین روزِو تہٕ ؤدِو تِمو غلط چیزو سببہٕ یِم توٚہہِ کٔرؠ مٕتؠ آسنو۔ توٚہؠ چھُو پانہٕ خوشی کران رودمٕتؠ، مگر توٚہہِ پزیٚو سنٛجیدٕ روزُن تہٕ توٚہہِ پزیٚو سمجھُن زِ توٚہہِ کٲژاہ تبدیلی ہنٛز ضرورت چھےٚ۔
\v 10 عٲجزی سان ہٲیِو خداوندس زِ توٚہہِ کوتاہ افسوس چھُ پننٮ۪ن گُنہن پیٚٹھ۔ اگر توٚہؠ یہِ کرِو، سُہ کرِ توٚہہِ عزت افزٲیی\f + \fr 4‏:10 \ft زبور 147:6 \f*۔
\v 11 میانیو ایماندار سٲتھیٚو، اکھ اکِس پیٚٹھ غلط کٲم کرنُک الزام لگاوُن کرِو بند۔ کانٛہہ تہٕ شخص یُس کٲنٛسہِ ایماندار سٲتھیس پیٚٹھ الزام لگاوان تہٕ فٲصلہٕ کران چُھ، سُہ چُھ پٔزؠ پٲٹھؠ خدایہِ سنٛدِس یتھ حُکمس پیٚٹھ الزام لگاوان تہٕ فٲصلہٕ کران زِ اسہِ پزِ اکھ اکھ اکِس لول برُن۔ ووٚنؠ گوو، اگر توٚہؠ اتھ حکمس خلاف کتھ کرِو، تیٚلہِ چھُو نہٕ توٚہؠ اتھ پیٚٹھ عمل کران۔ امہِ بجایہ چھُو توٚہؠ اکِس منصف سنٛدؠ پٲٹھؠ برتاؤ کران یُس امیُک سزا دِوان چھُ۔
\v 12 صرف سُہ اکھ وٲحد نفر یُس لوٗکن ہُنٛد فٲصلہٕ ہیٚکہِ قانونس تحت کرِتھ، چُھ سُہ یمؠ قانون بنوو۔ سُہ چُھ خدا، یمِس نہ صِرِف قانون پھُٹراونہٕ خٲطرٕ لوٗکن سزا دِنُک اختیار چُھ بلکہِ تِمن معافی دِنؠ تہنٛزِ خلاف ورزی باوجود تہِ۔ توٚہہِ چُھنہٕ حقیقی طور خدایہِ سنٛز جاے رٹنُک تہٕ باقین ہُنٛد فٲصلہٕ کرنُک حق حٲصِل۔
\v 13 توٚہہِ منٛزٕ چھِ کینٛہہ غرور سان ونان، "از یا پگاہ گژھو أسؠ کُنہِ خاص شہرس منٛز۔ أسؠ گُذارو تتہِ اکھ ؤری تہٕ أسؠ ہیٚمو تہٕ کٕنو تتہِ واریاہ مال تہٕ کماوو واریاہ دولت" ووٚنؠ بوزِو میٲنؠ کتھ!
\v 14 توٚہہِ پزیٚو نہٕ تِتھٕ پٲٹھؠ کتھ کرٕنؠ، تکیازِ توٚہؠ چھُو نہٕ زانان ز پگاہ کیا سپدِ۔ حتاکہِ توٚہؠ چھُونہٕ یِتہِ زانان زِ توٚہؠ کٲتِس وقتس روزِو زندٕ۔ کلہُم چھےٚ تہنٛز زندگی مۅختصر، وُنلہِ ہنٛدؠ پٲٹھؠ یُس مۅختصر وقتس خٲطرٕ وُچھنہٕ چھُ یِوان مگر پتہٕ چھُ غٲبےٕ گژھان\f + \fr 4‏:14 \ft امثال 27:1 \f*۔
\v 15 امہ بجایہ یہِ توٚہؠ ونان چھُو، پزیٚو توٚہہِ ونُن، "اگر خداوند رٲضی آسہِ، أسؠ آسو وُنہِ تہِ زِنٛدٕ تہٕ أسؠ ہیٚکو اکھ یا بیاکھ کٲم کٔرِتھ"
\v 16 ووٚنؠ گوو، یہِ توٚہؠ کران چھُو، سُہ گو یہِ زِ توٚہؠ چھُو تِمن سارنےٕ چیزن ہُنٛد تھٮ۪کان یہِ کرنُک توٚہؠ بندبست کران چھُو۔ امہِ قسمُک تھیٚکُن چھُ گناہ۔
\v 17 لہٰذا ہرگاہ کانہٛہ شخص تہِ کینٛژا کرِ نہٕ یتھ متعلق سُہ یہِ زانان آسہِ زِ یہ کرُن چھُ رُت، تیٚلہِ چھُ تٔمؠ گناہ کوٚرمُت۔
\c 5
\p
\v 1 ووٚنؠ چُھ مےٚ توٚہہِ دولت منٛد لوٗکن کینٛہہ ونُن یِم ونان چھِ زِ تِمن چھُ یسوعسؔ پیٚٹھ ایمان۔ مےٚ کُن دِیو توجہ! توٚہہِ پزِ بڈِ ودُن تہٕ افسوس کرُن تکیازِ توٚہؠ چھُو وٲناکھ دۅکھن ہُنٛدؠ تجربہٕ کرن وٲلؠ۔
\v 2 تہندِس دولتس چھنہٕ کانہٛہ وُقعت، زنتہٕ سۅ ضایہِ چھےٚ گمٕژ۔ تہندٮ۪ن خوبصورت پلون چھنہٕ کانہٛہ وُقعت، زنتہٕ تِم کیٚمیٚو چھِ کھیٚمٕتؠ۔
\v 3 تُہنٛد سۅن تہٕ روٚپھ چھُ بے وُقعت، زنتہٕ تِمن زنگ چھُ لوٚگمُت۔ ییٚلہِ خدا تُہنٛد فٲصلہٕ کرِ، تہنٛز یہِ بےٚ وُقعت دولت آسہِ ثبوٗت زِ توٚہہِ چھُو لالچہِ ہُنٛد خطا۔ یِتھٕ کِنؠ خَے تہٕ نار چیزن تباہ چھُ کران، تِتھے پٲٹھؠ دِیہِ توٚہہِ خدا سخت سزا۔ توٚہہِ پزیٚو نہٕ زیادٕ کھۅتہٕ زیادٕ امیر بننٕچ کوشش کرٕنؠ، یہِ زٲنِتھ زِ یسوعؔ چھُ واپس یِنہٕ وول۔ ییٚلہِ سُہ واپس ییہِ، تُہنٛدِس دولتس آسہِ نہٕ کانٛہہ تہِ وُقعت۔
\v 4 تتھ متعلق سونٛچِو یہِ توٚہہِ کوٚرمُت چھُو۔ توٚہہِ دِژو نہٕ اُجرت یُس توٚہہِ مزوٗرن دِنُک وعدٕ اوس کوٚرمُت یِمو تُہنٛد فصل لوٚن۔ یِم بقایات اجرتہٕ چھےٚ ہاوان زِ توٚہہِ چھُ یمن مزوٗرن سٟتؠ غٲر منصفانہٕ سلوک کوٚرمُت۔ تِم چھِ خدایس ودان ودان فریاد کران تکیازِ یُس توٚہہِ تِمن سٟتؠ سلوک کوٚرُو۔ سبوتُک خداوند چھُ اکھ طاقتور خدا، تہٕ سُہ چُھ تُہنٛدِ زورٕ ودنچ آواز بوزان۔ تہٕ سُہ دِیو توٚہہِ سزا تمیُک یہِ توٚہہِ کوٚرمُت چھُو\f + \fr 5‏:4 \ft احبار 19:13 \f*۔
\v 5 توٚہہِ چھُو تِم سٲری عٲش تہٕ آرام حٲصِل کٔرؠ مٕتؠ یِم توٚہؠ پننہِ باپتھ یژھان ٲسِو۔ یتھٕ پٲٹھؠ جانور پانس مۅچر تہٕ چربی چھِ کھالان، یہِ زاننہٕ ورٲے زِ تم یِن ذبح کرنہٕ، توٚہؠ چھُو صرف چیزن لطف تُلنہٕ باپتھ زنٛدٕ رودؠ مٕتؠ، امہِ احساس بغأر زِ خدا دِیہِ توٚہہِ سخت سزا۔
\v 6 توٚہہِ چھُو بیٚین سٟتؠ رٔلِتھ دیانتدار لوٗکن ہنٛز مزمت کٔرمٕژ۔ توٚہہِ چُھو باقیٚو خٲطرٕ تِمن لوٗکن ہنٛدِ قتلُک منصوبہ بنوومُت یِمو نہٕ کینٛہہ غلط چھُ کوٚرمُت۔ تِم ٲسؠ نہٕ پنٕنؠ پان توٚہہِ نِشہٕ بچاونس قٲبل۔ مگر خدا کرِ فٲصلہٕ تہِ دِیو توٚہہِ سزا یمن تمام اعمالن ہنٛد۔
\v 7 لہٰذا، میانیٚو ایماندار سٲتھیٚو، ہرگاہ امیر لوٗکھ توٚہہِ تکلیف تُلناوان چھُو، صبر کٔرِو یوٚت تام یسوعؔ مسیحؔ واپس ییہِ۔ یہِ کتھ تھٲیو ژٮ۪تس زِ ییٚلہِ زمیندار کُلؠ لاگن، تِمن چھُ قٟمتی فصل وۅپداونہٕ خٲطرٕ پرارُن، تِمن چھُ صبرٕ سان تمہِ روٗدٕ خٲطرٕ انتظار کرُن یُس وونکِس موسمس منٛز پیٚوان چھُ تہٕ بیٚیہِ ہُریمانہٕ روٗدٕ خٲطرٕ یُس فصل لونہٕ نکہِ موسمہٕ برونہٛہ پیٚوان چھُ\f + \fr 5‏:7 \ft احبار 11:14 \f*،
\v 8 یتھے پٲٹھؠ پزِ توٚہہِ صبرٕ سان پرارُن تہٕ یسوعؔ مسیحسؔ پیٚٹھ درِرٕ سان بھروسہٕ کرُن، تکیازِ سُہ ییہِ جلدے واپس تہٕ کرِ پرٛتھ کٲنٛسہِ ہُنٛد فٲصلہٕ منصفانہٕ پٲٹھؠ۔
\v 9 میانیٚو ایماندار سٲتھیٚو، اکھ أکِس متعلق مہٕ کٔرِو شکایت۔ یِتھٕ پٲٹھؠ پیٚیہِ نہٕ خداوند یسوعسؔ توٚہہِ سزا دیُن۔ سُہ چُھ سُہ یُس سون انصاف کرِ، تہٕ سُہ ییہِ جلدی یہٕ پورٕ کرنہٕ خٲطرٕ دروازس پیٚٹھ واپس۔
\v 10 میانیٚو ایماندار سٲتھیٚو، اکہِ مثالہِ رنگؠ زِ صٲبر کِتھٕ پٲٹھؠ چھُ بنُن، تمن نبین پیٚٹھ کٔرِو غور یم خداوند خداین واریاہ کال برونہٛہ تسُنٛد پٲغام واتناونہٕ باپتھ سوزؠ۔ حالانکہِ لوٗکو واتنٲوؠ تِمن واریاہ مصیبت، مگر تِمو کوٚر یہِ صبرٕ سان برداشت۔
\v 11 غور کٔرِو زِ خداین کِتھہٕ پٲٹھؠ چھےٚ تِمن برکت دِژمٕژ ییٚلہِ لوٗکھ صبرٕ سان تہٕ وفادٲری سان دۅکھ ویٚتراونس قٲبل آسان چھِ۔ امِچ اکھ مثال چھےٚ ایوبؔ نٲوؠ شخصہٕ سنٛز۔ توٚہؠ چھُو تس متعلق زانان صحیفو مطٲبق۔ توٚہؠ چھو خبر زِ تٔمؠ کٔرؠ صبرٕ سان واریاہ مشکلات برداشت۔ توٚہؠ چھُو یِتہِ زانان زِ خدا چُھ ایوبسؔ سٟتؠ اصل کرنُک ارادٕ تھاوان۔ تہٕ امہِ سٟتؠ ہیٚکو توٚہؠ ؤنِتھ زِ خدا چھُ واریاہ رحم دِل تہٕ مہربان\f + \fr 5‏:11 \ft ایوب 1:21 \f*۔
\v 12 میانیٚو ایماندار سٲتھیٚو، ووٚنؠ چھُ یہِ تہنٛدِ احساس کرنہٕ خٲطرٕ واریاہ اہم چیز۔ توٚہہِ پزِنہٕ زانہٛہ تہِ آسمان یا زمین یا بیٚیہِ کُنہِ تہِ چیزُک استعمال کٔرِتھ حلف تلُن تاکہِ توٚہؠ یُس وعدٕ کرِو، تمچی دِیو ضمانت۔ توٚہہِ چھُو صرف ونُن زِ 'آ' یا 'نَہ'۔ خدا کرِ تُہنٛد فٲصلہٕ اگر توٚہؠ امہِ علاوٕ کٔرِو تہٕ قسم کھیٚیِو مگر پتہٕ کٔرِو نہٕ پنُن وعدٕ پوٗرٕ۔
\v 13 توٚہہِ منٛزٕ کٲنٛسہِ تہِ یس مشکلات یوان چھِ، تس پزِ خدایس کُن دُعا کرُن تہٕ خوش روزُن تاکہِ سُہ کرِ تس مدد۔ یُس تہِ خۅش چھُ، تس پزن خدایہِ سنٛدؠ تعریفٕکؠ بٲتھ گیٚونہِ۔
\v 14 توٚہہِ منٛزٕ یُس کانٛہہ تہِ بٮ۪مار چُھ، تس پزن جمٲژن ہنٛدؠ زِٹھؠ بُلٲوِتھ انٕنؠ تمسنٛزِ صحت یٲبی خٲطرٕ دُعا کرنہٕ باپتھ۔ تِمن پزِ أمِس پیٚٹھ زیتون تیل مٲلش کرٕنؠ تاکہِ سُہ گژھہِ صحتیاب تہٕ خداوند سنٛدِ اختیارٕ سٟتؠ کرِو دعا۔
\v 15 ییٚلہِ یِم زِٹھؠ خدایس کُن دعا کرن عقیدت سان، خدا دِیہِ امہِ دعاکِس جوابس منٛز یِمن بٮ۪مارن شفا۔ خدا کرِ تمسُنٛد صحت بحال۔ اگر تٔمؠ شخصن گناہ آسہِ کوٚرمُت، خدا دِیہِ تس معافی تِمو گنہو خٲطرٕ۔
\v 16 تکیازِ خداوند چھُ بٮ۪مارن صحت یاب کرنس تہٕ گناہ معاف کرنس قٲبل۔ اکھ اکِس سٟتؠ کٔرِو تِمن گناہ کٮ۪ن چیزن ہُنٛد اقرار یِم توٚہہِ کٔرؠ مٕتؠ آسنو تہٕ اکھ اکِس خٲطرٕ منٛگِو دعا۔ امہِ پتہٕ دِیو توٚہہِ خدا شفا۔ ییٚلہِ نیک لوٗکھ دعا چِھ کران، خدا چُھ یہنٛدؠ دعا طاقتہٕ سان قبول تھاوان۔
\v 17 ایلیاہؔ نبی اوس اسہِ ہِیو اکھ عام شخص۔ تاہم، ییٚلہِ تٔمؠ روٗد نہ پیٚنہٕ خٲطرٕ سنٛجیدگی سان دعا کوٚر، اسرایٔیلچہِ سرِزمینہِ پیٚو نہٕ ساڑن ترٮ۪ن ؤرین تام رودےٕ۔ \f + \fr 5‏:17 \ft 1بادشاہ 17:1، 18:1، 42:45 \f*
\v 18 پتہٕ کوٚر ایلیاہنؔ دوبارٕ خدایس روٗد تراونہٕ باپتھ دعا، تہٕ خداین تروو روٗد تہٕ کُلؠ بڑییہ تہٕ کوٚرُکھ دُبارٕ فصل پٲدٕ\f + \fr 5‏:18 \ft 1بادشاہ 45-18:42 \f*۔
\v 19 میانیو ایماندار سٲتھیٚو، اگر توٚہہ منٛزٕ کانہٛہ اکھ تہِ خدایہِ سنٛدِس پٔزِس پٲغامس پیٚٹھ عمل کرٕنؠ بند کرِ، تیٚلہِ پزِ توٚہہِ منٛزٕ بیٚیہِ کٲنٛسہِ امِس شخصس دُبارٕ تہِ کرنہٕ خٲطرٕ حوصلہٕ افزٲیی کرٕنؠ یہِ خداین اسہِ ووٚن کرنہٕ باپتھ۔
\v 20 بہٕ چُھس یژھان زِ یُس اکھ تہِ گناہگارس توبہٕ کرنس منٛز مدد کرِ، سُہ زٲنِن زِ امہِ خٲطرٕ کرِمتہِ کہِ وجہہ کِنؠ بچاوِ خدا گناہگارس روحٲنی موتہٕ نِشہٕ تہٕ کرِ تمسنٛدؠ واریاہ گناہ معاف\f + \fr 5‏:20 \ft امثال 10:2 \f*۔
