\id JOS - DMT Kashmiri
\toc1 یشوع
\mt1 یشوع
\c 1
\p
\v 1 ییٚلہ یہُوواہؔ سُنٛد بنٛدٕ موسیٰؔ یمہِ عالمہٕ دراو، یہُوواہنؔ دیُت حکم نُونؔ سٕنٛدِس نیٚچوِس یسوعسؔ یُس زن موسیٰؔ سنٛدٮ۪ن خٲدمن ہُند زیُٹھ اوس تہٕ وننَس،
\v 2 "ژےٚ چھَے خبرےٕ زِ موسیٰؔ دراو۔ لہٰذا گنڈ کمر گژھِ وۅنؠ تیار یِم سٲری پننؠ لوٗکھ ہٮ۪تھ یردن دریاوس اپور ترنہٕ باپتھ۔ اژ تتھ زمیٖنس منٛز یُس بہٕ جلدٕے اسرائیل ین بخشہٕ۔
\v 3 یپٲرؠ یپٲرؠ توٚہؠ اتھ زمیٖنس پھیرِو یۅسہ بہٕ دِمہٕ توٚہہِ، یمیُک مےٚ موسیٰؔ سنٛدٮ۪ن تمام لوٗکن وعدہ دیُت۔\f + \fr 1‏:3 \ft اِستِثنا: 11:24-25\f*
\p
\v 4 یہِ زمین آسہ جنوبس منٛز بیابان پٮ۪ٹھٕ شمال مغربس منٛز لبنان پہاڑن تام دریائے فرات تام، تہٕ مغربس منٛز بحیرہ رومؔ تام، اتھ منز ییہِ سُہ سورےٕ علاقہٕ یتہِ زن حِتیِکؠ لوٗکھ لسان بسان چھِ۔
\v 5 ییتِس کالس توٚہؠ اتہِ لسان بسان روزیٚو توٚہہِ ہیٚکنہٕ ہرگز تہِ کانٛہہ تلفس تل أنِتھ۔ بہٕ روزٕ توٚہہِ ڈکھَس برابر تِتھے پٲٹھؠ یتھٕ پٲٹھؠ زَن بہٕ موسیٰؔ ہسؔ اوسُس۔ بہٕ چُھس توٚہہِ سٕتؠ وعدہ کران زِ بہٕ مشراوو نہٕ توٚہؠ زانہٛہ تہِ نَہ تراوَو توٚہؠ اورؠ۔\f + \fr 1‏:5 \ft امثال: 13:5\f*
\p
\v 6 باہمت بن تہٕ تھاو حوصلہ، تکیازِ ژےٚ چھےَ یمن لوٗکن وتھ ہاوٕنؠ تاکہِ یِم انن تتھ زمینہِ پننس تلفس تل، سۅ زمین یوٚس مےٚ یہنٛدٮ۪ن بُزرگن دِنُک وعدہ کوٚرمُت چُھ۔
\v 7 بس روز باہمت تہٕ سیٹھاہ بہودُر۔ پورٕ یقین تہٕ وثوقہ سان اپناوُکھ تم قانون یِم ژٕ میٲنؠ بندٕ موسیٰؔ ہن ہٮ۪چھنووُکھ۔ اکہِ اکہِ کر یِمن پٮ۪ٹھ عمل۔ یوٚدوے ژٕ یہِ کرکھ، کامیاب روزَکھ یوٚت یوٚت تہِ ژٕ گژھکھ۔\f + \fr 1‏:7 \ft قانونُک کانٛہہ تہِ حصہٕ مہٕ کٔرِو نظرانداز۔\f*
\p
\v 8 پانہٕ وٲنؠ کٔرِو کتھ تتھ شریعتچہِ کتابہِ پٮ۪ٹھ یۅسہ توٚہؠ موسیٰؔ ہن پرنٲیِوٕ تہٕ ہچھنٲیِوٕ۔ اتھ منز بیان سپدیمتین قانونن پٮ۪ٹھ کٔرِو بار بار تہٕ دوٚہہ راتھ پانہٕ وٲنؠ کتھ۔ یِم قانون پاننٲیِو تہٕ عمل کٔرِو امہِ کِس وننس پٮ۪ٹھ۔ تہٕ یِم چُھو توٚہہِ ہٮ۪چھناوان زندٕ روزُن تاکہِ توٚہؠ بنیو خوشحال تہٕ کامیاب۔
\v 9 یِنہ ہرگِز میون یہِ حکم مشراوکھ زِ ژٕ بن باہمت تہٕ حوصلہ منٛد۔ یِنہ کانٛہہ بیم یا بے نال ؤلی یا پس ہٮ۪متھ سپدکھ۔ بہٕ یہُوواہؔ! چون خدا روزی ہر وزِ ژےٚ سٟتؠ سٟتؠ یوٚت یوٚت تہِ ژٕ گژھکھ۔"
\p
\v 10 امہِ پتہٕ دیُت یسوعنؔ یِمن بنی اسرائیلی زِٹھٮ۪ن حکم،
\v 11 "نیرِو پھِرنٲیو سٲرسےٕ لشکرس منٛز یہِ پارَے تہٕ کٔرِو تیٲری پننہِ ہیٚکتہٕ تہٕ پننہِ ضرورتہٕ حسابہٕ پانس سٟتؠ پنُن کھیٚن چٮ۪ن تُلنہِ باپتھ۔ توٚہہِ چُھو ترٮ۪ن دوٚہُن انٛدر برونٛہہ کنہِ کِس یتھ یردن دریاوس اپور ترُن۔ تہٕ اپارِ اتھ علاقس قبضہٕ کرُن یُس زَن یہُوواہؔ تُہنٛدؠ خداین توٚہہِ بخشنُک وعدہ کوٚرمُت چُھ۔
\p
\v 12 امہِ پتہٕ ووٚن یسوعؔن بنی روبن، بنی جد تہٕ منسیؔ قبیلہٕ کٮ۪ن نیصف خانوادن یِم زَن یردن دریاو کِس مشرقس منٛز بسن وٲلؠ ٲسؠ:
\v 13 "تِم حکم تھٲیِو وارٕ ژٮ۪تس یِم توٚہہِ یہُوواہؔ سٕنٛدؠ بنٛدٕ موسیٰؔ ہن ؤنوٕ۔ موسیٰؔ ہن ووٚن، تُہنٛدؠ خداوندن یہُوواہنؔ چُھ توٚہہِ سُہ علاقہٕ دِنُک وعدہ دیُتمُت ییٚتہِ توٚہؠ مستقل پٲٹھؠ پنٕنؠ بستی قٲیِم کرِتھ ہیٚکو۔ تہٕ أتی و توٚہؠ لسِتھ بسِتھ۔
\p
\v 14 تہنزٕ آشنہِ، تُہنٛدؠ لۅکٕٹؠ شُرؠ، تہٕ تُہنٛدؠ گُپن ہیٚکن أتی یردن دریاوکس مشرقی علاقس منز لسِتھ بسِتھ، یُس توٚہہ موسیٰؔ ہن دِتو مگر چٲنؠ سٲری سِپاہ تہٕ چٲنؠ پنٕنؠ سٲتھی قبیلہٕ وٲلؠ گژھن باقیو اسرائیلی سٲتھیٚو برونٛہہ برونٛہہ اپور ترٕنؠ، تاکہِ تِمن کرن اتھہٕ روٚٹ۔
\v 15 ژےٚ پزی تِمن جنگس منٛز مدد کرُن یوٚتام خدا یِمن اسرائیلی سٲتھین کھۅر ٹھٔہراونس قٲبل بناوِ، اتھ علاقس منز یَتھ تِم تلفس تل انن تہٕ یُس خدا تِمن بخشُن یژھان چُھ۔ امہِ پتہٕ یِیو توٚہؠ سٲری واپس پننِس تتھ علاقس کُن یتہِ توٚہؠ پننہِ بستی قٲیِم کٔرِو تہٕ لٔسِو بٔسِو۔ یعنی سُہ علاقہٕ یُس توٚہہِ یہُوواہؔ سٕنٛدؠ بندن موسیٰؔ ہن دیُتمُت اوسو یردن دریاو کِس مشرقس منٛز۔
\p
\v 16 یورٕ ووٚن روبن تہٕ جد تہٕ منسیؔ ہنٛدؠ نیصف قبیلہٕ والیٚو یسوعسؔ جوابس منٛز، "أسؠ انو چٲنؠ سٲری حکم باعمل یِم ژےٚ اسہِ دِتِتھ تہٕ یوٚت یوٚت ژٕ اسہِ ونکھ گژھُن أسؠ گژھَو۔
\v 17 أسؠ مانَو چون تِتھے پٲٹھؠ یتھٕ پٲٹھؠ أسؠ موسیٰؔ سُنٛد مانان ٲسؠ۔ أسؠ چھِ دُعا کران زِ یہُوواہؔ روزِن ژےٚ سٟتؠ سٟتؠ تِتھے پٲٹھؠ یتھٕ پٲٹھؠ سُہ موسیٰؔ ہس سٟتؠ اوس۔
\v 18 أسؠ کرووکھ تِم قتل یِم زَن توٚہہِ خلاف بغاوت کرن تہٕ تُہنٛدؠ حکم ماننس اِنکار کرن۔ اکھ کتھ تھاو ژٮ۪تس، یسوع، ژٕ روز باہمت تہٕ باحوصلہٕ۔
\c 2
\p
\v 1 پننہِ لشکرکہِ اکہِ جتھہٕ پٮ۪ٹھٕ ژٲرؠ یسوعنؔ زٕ نفر۔\f + \fr 2‏:1 \ft عِبرٲنؠ ناو "شیطیم" مطلب گو کِکر۔\f* تٔمؠ ووٚن تِمن، "نیرِو تہٕ أنِو یمہِ سارے علاقٕچ خاص پٲٹھؠ یریحُو شہرس أندؠ پٔکؠ کہِ علاقٕچ زانکٲری حٲصِل کٔرِتھ۔ "تِمو تروو پنُن پڑاو تہٕ وٲتؠ یروک شہرس منٛز أکِس پاژھنہِ ہُند گرٕ۔ یمِس ناو اوس راحب۔ یِم رودؠ أتی۔
\v 2 یہِ شیٚچھ واتنٲو کٔمؠ تام یریحُو کِس بادشاہس۔ "یوکُن بوزِو! کینٛہہ اسرائیلی چھِ آمٕتؠ رات کیُت سٲنِس علاقس ژرژنہِ؟
\v 3 اوٕ کِنؠ سوز بادشاہن اکھ قٲصد راحبسؔ وننہٕ خٲطرٕ، "تِم نفر کڈُکھ تتہِ یمہٕ ژےٚ نِش وٲتؠ تہٕ چٲنِس گرس منٛز ژاے، تکیازِ تِم ٲسؠ سٲنِس ملکس منٛز ژرژنہٕ باپتھ نظرِ آمٕتؠ۔"
\p
\v 4 وۅنؠ اوس امہِ پاژھنہِ یمن پناہ دیُتمُت تہٕ تھٲوِن کٔھٹِتھ۔ تٔمؠ ووٚن بادشاہ سنٛدٮ۪ن نفرن، "آ! پزَر ہےَ چُھ زِ تِم نفر آے مےٚ نِش۔ مگر مےٚ چھنہٕ بلکل خبر تِم آے کتہِ پٮ۪ٹھٕ۔\f + \fr 2‏:4 \ft یعقوبؔ 2:25\f*
\v 5 تِم درایہ یُتھے انہِ گٹہٕ گییہِ، تمہِ وقتہٕ ییٚلہِ پہرٕدار شہرٕکؠ دروازٕ بنٛد کران چھِ۔ مےَ چھنہٕ خبر زِ تِم کورکُن ٲسؠ نیران۔ یوٚدوے توٚہؠ ہَنا وُژھ کٔرِو، توٚہؠ لٔبِو تِمن وتے۔"
\p
\v 6 مگر پزر اوس یہِ زِ امہِ پاژھنہِ ٲسؠ یِم دۅنوے نفر پننس گرکِس سٔترِس پشَس پٮ۪ٹھ کھٲلمٕتؠ تہٕ ٲسِن تِم پھمبہٕ ڈیرن تلہٕ کنہِ کٔھٹِتھ تھٲومٕتؠ یِم تٔمسٕنٛدِس پشس پٮ۪ٹھ ہوٚکھان ٲسؠ۔
\v 7 بادشاہ سٕنٛدؠ سِپاہ دورییہِ شہرٕ نٮ۪بر تِمن سڑکن ژھانڈ دِنہِ یم یردن دریاوکٮ۪ن تارن کن گژھان آسہٕ۔ یُتھےبادشاہ سٕنٛدؠ نفر نٮ۪بر درائے، رٲچھ درَو کٔرؠ شہرٕکؠ دروازٕ بنٛد۔
\p
\v 8 امہِ برونٛہہ زِ یِم زٕ اسرائیلی نفر لاگن شونٛگُن تٔمہِ رٲژ، راحبؔ کٔھژ تِمن نِش پشَس پٮ۪ٹھ۔
\v 9 تہٕ ووٚنُن تِمن، "اسہِ چھےٚ خبر زِ یہُوواہنؔ چھےٚ توٚہہِ یہِ زمیٖن دِژمٕژ۔ سٲنؠ سٲری لوٗکھ چُھو توٚہہِ کھوٚژان۔ اسہِ چُھ تُہنٛد یوٗتاہ بیٖم زِ اسہِ منٛز لگیٚو نہٕ توٚہہِ کانٛہہ اکھ تہِ بُتھِ۔
\p
\v 10 اسہِ چُھ بوزمُت سورےٕ زِ یہُوواہنؔ کِتھہٕ پٲٹھؠ ہۅکھروو بحرِ قُلزمؔ توٚہہِ اپور تارنہٕ بابتھ ییٚلہِ توٚہؠ مِصرٕ منٛزٕ دروو۔ اسہِ بوز یِتہِ زِ توٚہہِ کیاہ کوٚرُو سیحون تہٕ عوجؔ ہیون امورؠؔ بادشاہن سٟتؠ یِم یردن دریاوٕ اپارِ روزان ٲسؠ، تہٕ کِتھہٕ پٲٹھؠ کوٚرُو تہنٛدِ سلطنتُک پرٮ۪تھ کانٛہہ نفرس تہٕ چیز بُرباد۔
\v 11 ییٚلہِ اسہِ یِمن چیٖزن متٮعلق بوز، اسہِ ژایہِ یہِ دٔپؠ زِ تہِ نَٹھ۔ اسہِ منٛز چھنہٕ کٲنٛسہِ أکِس تہِ توٚہہِ بُتھِ لگنٕچ ہٮ۪مت، تکیازِ یہُوواہؔ چُھ آسمانہٕ پٮ۪ٹھٕ زمینہِ تام پرٮ۪تھ چیزُک مٲلک۔
\p
\v 12 پس بہٕ چُھس یژھان یہُوواہسؔ حٲضِر زٲنِتھ دِیو توٚہؠ مےٚ وعدہ زِ یوٚدوے توٚہؠ پنُن وعدہ پوٗرٕ کٔرِونہٕ، سُہ دییہِ توٚہہِ تمہِ وعدہ خلٲفی ہُنٛد سزا۔ کٔریٚو مےٚ سٟتؠ وعدہ زِ توٚہؠ روزیٚو مےٚ تہٕ میٲنِس عیالس پٮ۪ٹھ مہربان۔ دِیو مےٚ ضمانت زِ توٚہؠ کیا پٲلِیو پنُن وعدہ، \f + \fr 2‏:12 \ft عبر: 11:31\f*
\v 13 تہٕ روزیٚو اسہِ سارِنےٕ ۂنٛدِ زُووٕ کؠ میٲنِس مٲلِس، ماجہِ، میانٮ۪ن بٮیٚنٮ۪ن، باین تہٕ سانہِ سارے ونٛڈکؠ ضٲمن۔ تہٕ توٚہؠ بچٲیو سٲنِس ونٛڈس ییٚلہِ اسرائیلی یتھ شہرس تلُک پٮ۪ٹھ کرن۔
\p
\v 14 یِمو دوٚیو نفرو ووٚن أمِس زنانہِ، "أسؠ دِمو پنٕنؠ زُو چھپہِ یوٚدوے اسہِ پنُن وعدہ پٲلِتھ ہیوٚکنہٕ۔ یوٚدوے ژٕ سٲنِس منصوبس فاش کرکھ نہٕ، تیٚلہِ روزو أسؠ چٲنِس ونٛڈس پٮ۪ٹھ سٮ۪ٹھاہ مہربان۔ ییٚلہِ یہُوواہؔ یہِ زمیٖن اسہِ دِیہ۔"
\p
\v 15 راحبؔ نہِ گریُک اکھ نٮ۪برِم دیوار\f + \fr 2‏:15 \ft یعقوب 2:25\f* اوس شہرکہِ قصبُک حصہٕ۔ تٔمؠ ترٲو اکھ دٔر رز دیوارس منٛز بناونہٕ آمژِ دارِ کِنؠ تاکہِ یِم نفر کھسن دارِ تہٕ وسن رزِ رزِ دیوارٕ بوٚن۔
\v 16 امہِ پتہٕ ووٚنُن تِمن، "ییٚلہِ توٚہؠ یہِ شہر ترٲیو، سیٚودے کھٔسؠ زیٚو بالن کُن۔ تاکہِ تُہنٛدِس تلاشس منٛز آوٕرؠ لوٗکھ لبن نہٕ توٚہہِ۔ بالہٕ گوین تہٕ گۅپھن منٛز روزِ زیٚو ترٮ۪ن دوٚہُن ژوٗرِ یوٚتام تُہنٛدِس تلاشس منٛز ورفتار لوٗکھ واپس پھیرن۔ امہِ پتہٕ ہیٚکِو توٚہؠ پننس پڑاوس کُن نیرتھ۔"
\v 17 یِمَو دوٚیو نفرو دیُت أمِس اکھ وۅزُل نشانہٕ تہٕ ووٚن ہس، "ژےٚ پزی بلکل یی کرُن۔ یوٚدوے ژٕ یہِ کرکھ نہٕ۔ اسہِ پٮ۪ٹھ روزِ نہٕ پنُن وعدہ پالنُک کانٛہہ شرط باقی۔"
\p
\v 18 ییٚلہِ أسؠ یتھ علاقس منٛز یِمو، ژےٚ پزی یہِ وۅزج رز یتھ دارِ اویزان تراوُن یپٲرؠ ژٕ اسہِ نٮ۪بر تراوکھ، تہٕ ژےٚ پزی پنُن مول، موج، بیٚنہِ، بوے تہٕ سورےٕ مٲلؠ سُنٛد ونٛڈٕ یتی سمبراوُن۔
\v 19 یوٚدوے چانہِ ونٛڈُک کانٛہہ اکھ نفر تہِ یمہِ گرٕ نٮ۪بر دراو، سُہ تراوِ پنُن زُو ہلاکتس منٛز تہٕ یوٚدوے سُہ قتل سپدِ أسؠ آسو نہٕ تٔمِکؠ ذِمہٕ دار تہٕ یوٚدوے یتھ گرس منٛز روزِتھ کٲنٛسہِ اکِس تہِ نقصان واتہِ، أسؠ آسو ذِمہٕ دار۔
\p
\v 20 مزید یوٚدوے ژٕ سانہِ کرنُک کراونُک کانٛہہ اِشارٕ تہِ کٲنٛسہِ دِکھ، أسؠ روزو نہٕ پننہِ دِنہٕ آمتہِ لفظٕکؠ پابند ژےٚ یا چٲنِس گرس یا چانٮ۪ن گرٕوالٮ۪ن نیصبت۔"
\v 21 رحابنؔ ووٚننکھ یورٕ، "بہٕ چھس پوٗرٕ مانان یہِ توٚہہِ ونُو۔ "امہِ پتہٕ کٔرؠ تٔمؠ یِم دۅشوے روانہٕ تہٕ تِمو ترٲو سۅ پتھ کُن۔ تمہِ گونٛڈ سُہ وۅزُل نشانہٕ دار کارڈ تہٕ ترووُن اویزان۔
\p
\v 22 ییٚلہِ یِمو دوٚیو نفرو شہر تروو تِم دراے ہیٚور بالن کُن۔ اتہِ رودؠ یِم ترٮ۪ن دوٚہُن ییٚلہِ زن شاہن سوزؠ مٕتؠ نفر یِمن لگاتار ژھاران رودؠ۔ تِمو ژھٲنٛڈؠ تِم سٲرؠ سےٕ سڑکہِ ہیٚور تہٕ بوٚن۔ مگر تِم زٕ نفر لٔبِکھ نہٕ کُنہِ۔
\p
\v 23 امہِ پتہٕ دراے تِم دۅشوے نفر پننس پڑاوس کُن۔ تِم ؤتھؠ یردن دریاوٕ بوٚن کُن تہٕ لوٚبُکھ تار تہِ تہٕ وٲتؠ واپس یسوعسؔ سٲری حالات وننہِ۔ تِمو ووٚن تس سورےٕ گدرُن۔
\v 24 تِمو ووٚن یسوعسؔ، "خداوندن چھےٚ پزی یہِ زمیٖن اسہِ دِژمٕژ۔ تمہِ کنعٲنؠ ملکٕکؠ لوٗکھ چھِ تیٖتؠ خوفہٕ ۂتؠ زِ تِم چھِنہٕ اسہِ بُتھِ لگنس قٲبل۔
\c 3
\p
\v 1 یسوعؔ تہٕ باقی اسرائیلی ؤتھؠ دوٚیمہِ دوٚہہ صُبحس سُلے تہٕ دراے شطِیم کہِ پننہِ فوجی پڑاوٕ پٮ۪ٹھٕ برونٛہہ کُن دریاے یردنس کُن تہٕ ترووُکھ عارضی پڑاو أتی۔
\p
\v 2 اتھ جایہِ رودؠ تِم برابر ترٮ۪ن دوہن۔ تریٚیہِ دوٚہؠ دراے اسرائیلی زِٹھؠ لشکرٕ منٛزؠ۔
\v 3 تِمو دیُت لوٗکن حکم، "یُتھےٕ توٚہؠ لاوی قبیلٕکؠ کاہن، یہُوواہؔ تہنٛدِس خداوند سُنٛد مقدس صندوق ہٮ۪تھ نیران وُچھِو، فوراً زٲنؠ زیٚو زِ یِمن پتہٕ پتہٕ نیرنُک تُہنٛد وقت ووت۔
\v 4 تقریباً اکھ کلومیٹر دوٗر روزِزیٚو امہِ صندوقہٕ نِشہ یِنہٕ ہرگِز اتھ نزدیک یِیو۔ أتی تگہِ توٚہہِ زانُن زِ گژھُن کور چُھ۔ توٚہؠ ما چُھو یمو وتو امہِ برونٛہہ زانہٛہ پٔکؠ مٕتؠ۔
\p
\v 5 یسوعنؔ ووٚن یِمن لوٗکن، "پنُن پان شیرِو تہٕ کٔرِو پاک تہٕ صاف تاکہِ یہُوواہسؔ کھٔسِو توٚہؠ ٹارِ، تکیازِ پگاہ ترایو سُہ توٚہہِ حٲرتس منٛز پننیٚو کامیٚو سٟتؠ۔
\v 6 پتہٕ ووٚن یسوعنؔ یِمن کاہنن کُن، "یہِ صندوق تُلِو تہٕ پٔکِو لوٗکن برونٛہہ برونٛہہ۔ "پس تُل تِمو یہِ مقدس صندوق تہٕ دراے لوٗکن برونٛہہ برونٛہہ۔
\p
\v 7 امہِ پتہٕ ووٚن یہُوواہنؔ یسوعسؔ، "یوٚہے چُھ سُہ دوٚہہ ییٚلہِ بہٕ سارِنےٕ اسرائیل ین برونٛہہ کنہِ ژےٚ تھَزر تہٕ بجر بخشَے۔ ادے زانن تِم زِ بہٕ چُھس ژےٚ سٟتؠ سٟتؠ ڈَکھس یتھٕ پٲٹھؠ بہٕ موسیٰؔ ہسؔ سٟتؠ اوسُس۔
\v 8 یہِ مقدس صندوق پکناون والٮ۪ن کاہنن ؤنؠ زِ ییٚلہِ توٚہؠ یردن دریاوکِس اپٲرمِس بٔٹھِس نَکھہٕ وٲتیٚو تِم کرن آبس منٛزےٕ قرار۔"
\p
\v 9 پتہٕ ووٚن یسوعنؔ اسرائیل ین، "ؤلِو ہنا نَکھہٕ تہٕ بوزِو یہُوواہنؔ تُہنٛدؠ خداین کیاہ حکم سوز،
\v 10 ؤنؠ تریو توٚہہِ فِکرِ زِ پُرقوت تہٕ پرٮ۪تھ چیٖزس پٮ۪ٹھ حٲوی خدا چُھ توٚہہِ درمیان۔ ؤنؠ وُچھِو توٚہؠ پانے زِ سُہ خدا کِتھٕ پٲٹھؠ نِیہِ توٚہہِ دیدمان کنعٲنؠ، حِتی، حویّوںؠ، فرزیوّؠ، جِرجاسؠ، امورؠؔ تہٕ یبوسؠ لوٗکن زیر کٔرِتھ تِہُنٛد اقتدار تہٕ تِہنٛز زمیٖن تہٕ بخشیٚو توٚہہِ۔
\v 11 وُچھِو! یہِ مقدس صندوق یُس زن ساری دُنیا کِس مالک خداوند سُنٛد چُھ، ییہِ توٚہہِ برُونٛہہ کنہِ یردن دریاوس اپور تارنہٕ۔
\p
\v 12 پس توٚہؠ ژٲرِو اسرائیلی قبیلہٕ منٛز باہ نفر، اکھ اکھ نفر پرٮ۪تھ قبیلہٕ منٛزٕ۔
\v 13 ییٚلہِ مقدس صندوق ہٮ۪تھ کاہن آبس وسن، یردن دریاوُک وسہٕ وُن آب گژھِ روزِتھ تہٕ روزٕ آبہٕ ڈیر ہیٚو بے حرکت۔
\p
\v 14 ییٚلہِ اسرائیلیٚو یردن دریاو کِس تارس کُن پکُن لوگ، مقدس صندوق رود تِمن برونٛہہ برونٛہہ رہنمٲیی کران۔
\v 15 تہٕ یُتھےٕ کاہن یردن دریاوکِس بٔٹھِس نَکھہٕ وٲتؠ تہٕ آبس کھوٚر ترووُکھ۔ یہِ اوس وۅنؠ موٚت سونٛتہٕ کال، ییٚلہِ آب اوس بٹھیٚو پیٚٹھؠ پکان،
\v 16 تہٕ آب گو روزِتھ تہٕ روٚٹُن ہیٚور کُن درٕ۔ یردن دریاوس پوٚک نہٕ ضرتانسؔ نَکھہٕ آدمؔ نٲوؠ شہرٕ پٮ۪ٹھٕ مردار سٕدرس تام اکھ سِرسٲے تہِ آب بوٚن کُن۔ یتھٕ پٲٹھؠ لوٚگ اسرائیلی لوٗکن یریحُو شہرس نکھٕ دریاوس تار۔"
\p
\v 17 یِمو کاہنو یہُوواہؔ سُنٛد مقدس صندوق تُلمُت اوس، تِم روٗدؠ یردن دریاوس درمیان خشک زمینہِ پٮ۪ٹھ کھڑا تۅتام یوٚتام تمام اسرائیلی خشک زمینہِ پیٚٹھؠ دریاوٕ اپور تٔرؠ۔
\c 4
\p
\v 1 وۅنؠ ییٚلہِ سورےٕ اسرائیلی قوم یردن دریاوکِس تارس توٚر یہُوواہنؔ ووٚن یسوعس،
\v 2 "ژارُکھ باہ نفر پرٮ۪تھ کُنہِ قبیلہٕ منٛزٕ اکھ اکھ، تہٕ ونُکھ زِ پرٮ۪تھ کانٛہہ زوٚن تُلِو دریاو منٛزٕ اکھ اکھ پل تمہِ جایہِ پٮ۪ٹھ یتِتھ یِم کاہن "خشک" دریاوس منٛز کھڑا چھِ۔
\v 3 یِم پل واتہٕ نٲوِو تتھ جایہِ یتِتھ ازِچ راتھ گُذارن وٲلؠ چُھو۔"
\p
\v 4 یسوعنؔ ژٲرؠ امہِ حکمہٕ مطٲبق باہ نفر۔ اکھ اکھ نفر پرٮ۪تھ قبیلہٕ منٛزٕ تہٕ أنِن سمبرٲوِتھ
\v 5 تہٕ ووٚنُن تِمن، "گٔژِھو یتھ یردن دریاو کِس "فلحال" خشک پتھرِس تام۔ یتنس مقدس صندوق ہٮ۪تھ تہنٛدؠ کاہن وۅدٕنؠ چھِ یُس یہُوواہنؔ تہنٛدؠ خداین توٚہہِ دِتُو۔ توٚہہِ پزِ پرٮ۪تھ أکِس ہیٚکتہٕ حِسابہٕ اکھ اکھ پل تلُن۔ ژٮ۪تس تھٲیِو۔ پرٮ۪تھ قبیلہٕ منٛزٕ چھرا اکھ زوٚن۔ باہ کنہِ بہَن اسرائیلی قبیلن ہنٛزٕ۔ تہٕ اکھ اکھ پل پرٮ۪تھ زٔنِس پھیٚکِس پٮ۪ٹھ۔
\p
\v 6 یِم پل آسن سارنےٕ ۂنٛدِ باپتھ اکھ یادگار۔ یِنہٕ وٲلِس کالس منٛز پرٕژھن توٚہہِ پنٕنؠ شُرؠ "ٲخٕر یِمن پلن ہُنٛد معنہِ مطلب کیاہ؟"
\v 7 تِمن ؤنؠ زیٚو ییٚلہِ یہُوواہؔ سُنٛد دیُتمُت مقدس صندوق ہٮ۪تھ کاہن یردن دریاوس تران ٲسؠ یہِ آب گو روزِتھ تہٕ أسؠ تٔرؠ خشک پتھرِ پیٚٹھؠ اتھ دریاوس۔ یِم یتھ جایہِ تھاونہ آمٕتؠ پل چھِ تمی دوٚہکؠ تہٕ تمی سپدنٕچ یادگار یس یہُوواہؔ سٕنٛدؠ کِنؠ ممکن سپُد۔
\p
\v 8 اسرائیل یو کوٚر تی یہِ یسوعؔ سُنٛد حکم اوسُکھ۔ ژارنہٕ آمٕتؠ باہ نفر گے تہٕ أنِکھ یردن دریاوکہِ خشک پتھرِ پٮ۪ٹھ قبیلہٕ تعداد حسابہٕ اکھ اکھ پل۔ یتھٕ پٲٹھؠ زن یہُوواہنؔ یسوعسؔ ووٚنمُت اوس۔ یِم کنہِ انہِ یِمو پننہِ قرارکہ جایہ ییٚتہِ تِم راتس رودؠ تہٕ تھاویٚکھ أتی۔
\v 9 اوٕ پتہٕ تُجہ یسوعنؔ باہ بدل کنہِ تہٕ تراوٮ۪ن یِم یردن دریاو کس پتھرِس پٮ۪ٹھ یتھ جایہِ مقدس صندوق ہٮ۪تھ کاہن وۅدٕنؠ ٲسؠ۔ یِم کنہِ چھےٚ وُنہِ تہِ اتہِ یادگارٕ رٔنٛگؠ موجود۔
\p
\v 10 کاہن رودؠ مقدس صندوق ہٮ۪تھ یردن دریاوس منٛزےٕ ییتِس کالس سٲری لوٗکھ تارس تٔرؠ، یتھٕ پٲٹھؠ زن یہُوواہنؔ یسوعسؔ تِمن کرنہٕ باپتھ ووٚنمُت اوس۔ یی اوس موسیٰؔ ہنؔ تہِ یسوعسؔ حکم دیُتمُت۔ لوٗکھ تٔرؠ ؤلؠ ؤلؠ تارٕ۔
\v 11 یُتھے سٲری لوٗکھ اپور وٲتؠ یہُوواہؔ سُنٛد دیُتمُت صندوق ہٮ۪تھ تٔرؠ کاہن تہِ یِمن پتے۔ لوٗکھ روٗدؠ یِمن اپارِ بٹھِ وُچھان۔
\p
\v 12 روبنؔ، جدؔ تہٕ منسیؔ قبیلکہِ نیصف حِصٕکؠ ہتھیار بنٛد فرد تٔرؠ باقی اسرائیل یو برونٛہہ یردن دریاو اپور۔ یتھٕ پٲٹھؠ زن یِمن موسیٰؔ سُنٛد حکم اوس۔ یِم روٗدؠ أکِس منظم فوجی چھۅکہِ ہنٛدؠ پٲٹھؠ صفہٕ بنٛد۔
\v 13 ژتجی ساس روبنؔ، جدؔ تہٕ منسیؔ قبیلکؠ فرد دراے یہُوواہسؔ برونٛہہ کِنؠ۔ یِم ٲسؠ سٲری ہتھیار بنٛد تہٕ جنگہٕ باپتھ تیار۔ یریحوکس مٲدانس کن پکوُنؠ یتہِ تمن لڑُن اوس۔
\v 14 امہِ دوٚہہ وُچھ ساروٕے اسرائیلیٚو زِ یہُوواہؔ بخشہِ یسوعؔس سرفرٲزی۔ تِمو تہِ کوٚر یسوعؔ سُنٛد احترام تِتھے پٲٹھؠ یتھٕ پٲٹھؠ تِم موسیٰؔ سُنٛد کران ٲسؠ۔
\p
\v 15 یہُوواہنؔ ووٚن یسوعسؔ،
\v 16 "یِمن مُشترکہٕ عہدُک صندوق سنبالن والٮ۪ن کاہنن دِ وۅنؠ حکم زِ تِم کھسن امہِ یردن دریاوٕ کہِ خشک پتھرِ پٮ۪ٹھٕ ہیٚور۔"
\v 17 تہٕ یسوعنؔ دیُت یوٚہَے حکم یِمن کاہنن زِ تِم کھسن امہِ خشک یردن دریاوٕ کہِ پتھرِ ہیٚور بٔٹھِس پٮ۪ٹھ۔
\v 18 امہِ حکمہٕ پتہٕ کھٔتؠ موسیٰؔ ہسؔ یہُوواہؔ سٕنٛدِ طرفہٕ میلن وٲلؠ داہ احکام ہٮ۪تھ مقدس صندوق تُلِتھ کاہن بٔٹھِس۔ تہٕ یُتھےٕ یِم یردن دریاوچ خشک پتھٕر ترٲوِتھ ہیٚور کھٔتؠ، دریاوس ووٚتھ کُنے یُپ تہٕ لوٚگ برونٛٹھِم پٲٹھؠ پوٗرٕ زورٕ سان آب پکنہِ۔
\p
\v 19 امہِ ؤریکہِ گۅڈنکہِ رٮ۪تہٕ کہِ دٔہمہِ دوٚہہ تٔرؠ اسرائیلی یردن دریاوس اپور تہٕ ترووُکھ یرِیحُو شہرکِس مشرِکس منٛز جِلجاؔل جایہِ ڈیرٕ۔
\v 20 أتی جِلجاؔل جایہِ کٔرؠ یسوعنؔ یردن دریاوٕ منٛزٕ کھالنہٕ آمٕتؠ باہ کنہِ پل کھڑا۔
\v 21 أمؠ ووٚن اسرائیل ین زِ یِنہٕ وٲلِس کالس منٛز ییٚلہِ تُہنٛدؠ زُرؠ توٚہہِ پرٕژھن "یِمہٕ کنہِ پل کِتھؠ تہٕ کیاز، چھِ یتہِ؟"
\p
\v 22 ؤنِو تِمَن "یہےَ گییہِ سۅ جاے یپٲرؠ اسرائیلی یردن دریاوچہِ خشک پتھرِ اپور تٔرؠ۔"
\v 23 یہُوواہؔ، تہنٛدؠ خداین، یہنٛز توٚہؠ عبادت کران چُھو رُکوو یردن دریاوُک آب تہنٛدِ باپتھ یوٚتام توٚہؠ اتھ اپور تارٕ تٔریٚو ییٚلہِ یہُوواہنؔ ہوٚکھروو یِتھے پٲٹھؠ بحرِ قُلزمک آب یوٚتام تمہِ وزِ اسہِ سارنےٕ قُلزمسؔ تار لوٚگ۔
\p
\v 24 یہُوواہنؔ کوٚر یہِ سورےٕ چھرا اوٕ مۅکھٕ تاکہِ دُنیہِکؠ سٲری لوٗکھ زانن زِ یہُوواہؔ کوتاہ طاقتہٕ وول چُھ تہٕ لوٗکھ کرن ہمیشہٕ أمؠ سُنٛد احترام پزنہٕ پٲٹھؠ۔"
\c 5
\p
\v 1 یہِ خبر وٲژ یردن دریاوکِس مغربس منٛز آباد تمام امورؠؔ رازن تہٕ بحیرِ رومؔ کٮ۪ن بٹھٮ۪ن نَکھہٕ آباد کنعانؠؔ بادشاہن تام تہِ زِ کِتھہٕ پٲٹھؠ کوٚر یردن دریاوُک آب یہُوواہنؔ روٹہٕ یوٚتام بنی اسرائیلی تارَس تٔرؠ اوٕ کِنؠ ترہٛرییہ یِم سٲری تہٕ اسرائیل ین بُتھِ لگنس درییکھ نہٕ زنٛگے۔
\v 2 تمہِ وزِ ووٚن یہُوواہنؔ یسوعسؔ، "وۅنؠ گٔرِو کنِو کھوٗرؠ تہٕ کرنٲیو سارنےٕ تِمن اسرائیلی مردن ختنہٕ یِمن نہٕ ختنہٕ کرنہٕ آمُت چُھ۔"
\v 3 لہٰذا گرٕنٲوؠ یسوعنؔ کنیو کھوٗرؠ تہٕ کھلڑِی پہٲڑی\f + \fr 5‏:3 \ft فورسکن پہٲڑ\f* جایہِ آو سارنےٕ اسرائیلی مردن ختنہٕ کرنہٕ۔ اتھ جایہِ چھِ وۅنؠ ختنہٕ بال ونان۔
\v 4 یہِ ختنہٕ کرناونچ ضرورت پیٚیہِ اوٕ موجُب زِ تِم تمام لوٗکھ یِم لڑنس لایق ٲسؠ وۅنؠ مِصرٕ منٛزٕ نیرتھ صحراون منٛز پھیران مودمٕتؠ
\v 5 یِمن سارنےٕ اوس مِصرس منٛزے ختنہٕ سپُدمُت۔ مگر تِم لڑکہٕ یِم مِصرٕ نیرتھ صحراون منٛز زاے ٲسؠ وُنہٕ ختنہٕ روٚستُے۔
\v 6 اسرائیلی روٗدؠ صحراون منٛز ژتجہن ؤرین پھیران۔ یوٚتام تمام لوٗکھ یِم لڑنس قٲبل ٲسؠ صحراو بُزؠ گے۔ چونٛکہِ تِمو اسرائیلیٚو ٲسؠ نہٕ یہُوواہؔ سٕنٛدؠ حکم پٲلمٕتؠ لہٰذا اوس یہُوواہؔ سُنٛد یژھُن ز یِم لوٗکھ گژھن نہٕ ہرگِز تہِ سۅ ذرخیز سرِزمین وُچھِنؠ یمیُک خداوندن یہنٛدٮ۪ن بُزرگن وعدہ دیُتمُت اوس۔ یہِ وعدہ دِژمٕژ زمیٖن ٲس تیٖژاہ زرخیز زِ وننہٕ اوس یِوان زِ اتہِ چھےٚ دۅدٕ کۅلہٕ تہٕ مانچھ کۅلہٕ پھیران آبہٕ کۅلن سٟتؠ سٟتؠ۔
\v 7 یِمنے یہُوواہؔ سنٛدٮ۪ن نافرمان بندن ہنٛدٮ۪ن لڑکن کرنوو یسوعنؔ ختنہٕ جِلجالؔ شہرس منٛز۔ چونکہِ ونیُک تام ٲسؠ یِم سٲری بیابٲنؠ سفرس منٛزے لہٰذا اوسنہٕ یِمن ختنہٕ کرنہٕ آمُت۔
\v 8 سارنےٕ اسرائیلی مردن ختنہٕ کرنہٕ پتہٕ کوٚر یِمو ساروٕے اسرائیل یو أتی پننس پڑاوس پیٚٹھےَ قرار یوٚتام تِم لوٗکھ بلیے یِمن ختنہٕ اوس کرنہٕ آمُت۔
\v 9 امہِ پتہٕ ووٚن یہُوواہنؔ یسوعسؔ "از کٔرٕو مےٚ توٚہہِ مِصرٕچ سٲرے خجالتھ تہٕ رسوٲیی دوٗر۔ "اوے پیٚو اتھ جایہِ ناو جِلجالؔ\f + \fr 5‏:9 \ft عبرانی منز چُھ جِلجالؔ مطلب 'ہٹاوُن' \f* یعنی ڈولہِ گِنؠ لگن واجِنؠ جاے۔
\v 10 امہِ رٮ۪تہٕ کہِ ژۅدٲہِمہِ دوٚہہ شامس ییٚلہِ اسرائیلی اتی جِلجالس منٛز ٲسؠ یریحو شہرِ کِس مٲدٲنی علاقس نکھہٕ، تِمو منٲو اسرائیل یو فسَح عید أتی۔
\v 11 امہِ خاص دعوت کہِ دویمہِ دوٚہہ کھییہِ یِمو لوٗکو خمیرٕ ورٲے بناونہٕ آمٕژ ژوٚٹ تہٕ تٔوِتھ پھَل مۅٹھ یۅسہ کنٲنؠ شہرس منٛز وۅپدیمٕژ چھےٚ۔
\v 12 امہِ پتہٕ کوٚر خداین یِمن آسمٲنؠ غذا "مَنّ" سوزُن بنٛد۔ امہِ پتہٕ کھیٚو یِمو کنعانؔ چہِ زمیٖنہِ پٮ۪ٹھ وۅپدن وول غذا۔
\v 13 ییٚلہِ یسوعؔ یرِیحُو شہرس نَکھَے اوس تٔمؠ وُچھ اکھ انسان صوٗرت برونٛہہ کنہِ۔ یمِس اتھس منٛز ننگے تلوار ٲس۔ یسوعؔ آو أمِس نَکھہٕ تہٕ پرُژھنس، "ژٕ چُھکھا سانہِ طرفہٕ کِنہٕ دُشمنہٕ سٕنٛدِ انٛدٕ؟
\v 14 أمؠ انسانن ووٚن یسوعسؔ اورٕ، "کُنہِ تہِ انٛدٕ نہٕ۔ بہٕ چُھس یہُوواہؔ سنٛدٮ۪ن سِپہَن ہُنٛد سالار، تہٕ وۅنؠ چُھس بہٕ آمُت۔ "پتہٕ پیٚو یسوعؔ تس عزت ظٲہر کرنہٕ خٲطرٕ زمینس پٮ۪ٹھ پنُن بُتھ ہٮ۪تھ زمینس پٮ۪ٹھ۔ یسوعنؔ ووٚن أمِس، "میانہِ آغہٕ، ژٕ کیاہ چھُکھ مےٚ کرنُک حکم دِوان؟ بہٕ چُھس تُہنٛد خٲدم۔"
\v 15 یہُوواہؔ سٕنٛدِ سپہَن ہنٛدؠ سالارن ووٚن یسوعسؔ، "پنٕنؠ نالٲنؠ کٔڈِو پننٮ۪و کھۅرو منٛزٕ، تکیازِ یہِ زمیٖن یتھ پٮ۪ٹھ ژٕ وُنکٮ۪س وۅدٕنؠ چُھکھ چھےٚ مقدس۔" یہِ بوزتھےٕ کٔڈ یسوعنؔ پنٕنؠ نالٲنؠ نٮ۪بر۔
\c 6
\p
\v 1 یرِیحُو شہرُک پرٮ۪تھ دروازٕ آو بنٛد کرنہٕ تکیازِ اتِکؠ لوٗکھ ٲسؠ اسرائیلی فوجس سخ کھوٚژان۔ شہرس اندر نٮ۪بر نیرُن اوس بالکُل بنٛد۔
\v 2 خداوندن ووٚن یسوعسؔ، "روز وُچھان۔ بہٕ کرٕ کیاہ۔ یرِیحوُ شہر دِمے بہٕ ژےٚ۔ یہِ شہر روزِ یمہِ اپور وۅنؠ چٲنِس اختیارس منٛز۔ اتہِ کِس بادشاہس تہٕ تسٕنٛدٮ۪ن وۅلہٕ ویٖرن سان۔
\v 3 ژٕ پھیرکھ گۅڈٕ یریحو شہرچہِ قلایہ نٮ۪برؠ پوٗرٕ اکہِ لٹہِ۔ چٲنؠ سٲری جنگجو پھیرن اتھ انٛدؠ انٛدؠ اکہِ اکہِ لٹہِ دوٚہس پوٗرٕ شٮ۪ن دوٚہُن۔
\v 4 پننٮ۪ن ستن کاہنن تہِ ون یِمنےٕ ستؠ نیرُن۔ یِم ولہ ویر روزن برونٛہہ برونٛہہ خداوند سُنٛد مقدس صندوق ہٮ۪تھ بِگُل بجاوان بجاوان۔ سٔتمہِ دوٚہہ دِن یِم وۅلہٕ ویٖر قلایہ انٛدؠ انٛدؠ ستتھ چکر تہٕ کاہن روزن یِمن برونٛہہ بروہنٛہ تھَدِ پنٕنؠ تُرے بجاوان۔ ییٚلہِ یِم پنٕنؠ ستتھ گتھ قلایہ انٛدؠ انٛدؠ مکمل کرن۔
\v 5 کاہنن پزَن پننہِ کٹہ ہینگ تُرے یہ سٮ۪ٹھا سٮ۪ٹھا تھَدِ بجاونہِ۔ ییٚلہِ باقے اسرائیلی لوٗکھ اتھ بوزن تِمن پزن بڈِ بڈِ ہَٹہِ نعرٕ دِنؠ تہٕ أتھؠ سٟتؠ ییہِ شہرُک دیوار وٮ۪سرِتھ۔ چٲنؠ لوٗکھ اژن بڈٕ آرام سان سیٚود شہرس منٛز۔
\v 6 نُونؔ سٕنٛدؠ نیٚچوؠ یسوعنؔ أنؠ کاہن ناد دِتھ تہٕ ووننکھ۔ "ژور کاہن تُلِو خداوند سُنٛد مقدس صندوق تہٕ ستتھ کاہن روزِیو کٹہ ہٮ۪نگہٕ تُرے بجاوان صندوقس برونٛہہ برونٛہہ۔"
\v 7 امہِ پتہٕ أنِن باقی لوٗکھ تہٕ دِتُن سپہن تہٕ کاہنن حکم زِ اسہِ چُھ سارنےٕ مقدس صندوقس پتہٕ پتہٕ شہرچہِ قلایہ اکھ چکر کرن۔ صرف پکن کینٛہہ اسلاح بردار صندوقس برونٛہہ برونٛہہ۔
\v 8 سورےٕ سپُد یسوعؔ سٕنٛدِ حکمہٕ حِسابے۔ ستتھ کاہن رودؠ تُرے بجاوان مقدس صندوقس برونٛہہ برونٛہہ یِتھ کِنؠ زن یہُوواہنؔ تِمن حکم دیُتمُت اوس۔ کینٛہہ اسلاح بردار رودؠ اتھ یہُوواہؔ سٕنٛدِس صندوقس پتہٕ پتہٕ۔ ییٚلہِ تِم شہرس أنٛدؠ پٔکؠ پکان ٲسؠ، کاہنو دیُت پننٮ۪ن توٚرین پھۅکھ۔ یِمو یہُوواہؔ سُنٛد پاک صندوق تُلمُت اوس پٔکؠ تِمن پتہٕ پتہٕ۔
\v 9 باقی کاہن تہٕ عام اسرائیلی لوٗکھ ٲسؠ اسلاح بردار سِپاہ روٗدؠ تِمن کاہنن برونٛہہ یِم تُرے بجاوان ٲسؠ۔ صندوقس پتہٕ پتہٕ رودؠ سِپاہ تہِ تہٕ لوٗکھ تہِ تہٕ کاہن رودؠ لگاتار تُرے بجاوان۔ مگر باقے ستؠ پکن وٲلؠ لوٗکھ رودؠ یسوعؔ سٕنٛدِ فرمانہٕ کِنؠ ژھۅپہٕ۔
\v 10 تٔمؠ اوسُکھ ووٚنمُت یِنہٕ کانٛہہ جنگی نعرٕ بیترِ دیِو یِنہٕ کریکہٕ یا چِکہٕ دِیو یا بدل کینٛہہ ؤنِو تتھ دوٚہس تام ییٚلہِ بہٕ کرٮ۪کہٕ دِنہِ ونیو۔ تمہِ دوٚہہ ہکیٚو توٚہؠ بے پھروک جنگی نعرٕ دِتھ۔ سٲری لوٗکھ رودؠ یسوعؔ سٕنٛدِس حکمس پٮ۪ٹھ۔
\v 11 تِمو لوگ پرٮ۪تھ دوٚہہ اکھ اکھ چکر دیُن شہرچہِ قلایہ نٮ۪بٕرؠ نٮ۪بٕرؠ۔ امہِ پتہٕ روٗدؠ تِم واپس پننس پڑاوس منٛز راتھ گُذاران
\v 12 دویمہِ دوٚہہ ؤتھؠ سٲری، یسوعؔ تہٕ کاہن، سُلے تہٕ تلُکھ مقدس صندوق۔
\v 13 کٹہٕ ہینگہٕ توریہ بجاوان ستتھ کاہن رودؠ مقدس صندوق تُلن والٮ۪ن برونٛہہ برونٛہہ۔ تِم رودؠ پکان پکان بڈِ تُرے بجاوان۔ سِپاہ رودؠ یمن برونٛہہ برونٛہہ تہِ پکان تہٕ اردلس منٛز تہِ۔ کاہن روٗدؠ برابر بجاوان
\v 14 دوٚیمہِ دوٚہہ تہِ دیُت تِمو شہرکہِ دیوارُک اکھ چکر تہٕ آے واپس پننِس پڑاو پٮ۪ٹھ۔ شٮ۪ن دوٚہُن کوٚر یِمو برابر یی۔
\v 15 سٔتمہِ دوٚہہ ؤتھؠ اسرائیلی سُلہِ گاش پھۅلنَے۔ امہِ دوٚہہ دیُت یِمو سارِوٕے باقین دوٚہُن ہنٛزِ ترتیٖبہِ سانےٕ دیوارُک چکر۔ ؤنؠ گو امہِ دوٚہہ دِتؠ یِمو خداوند سٕنٛدِ حکمہٕ موجُب ستتھ چکر۔
\v 16 سٔتِم چکر دِوان دِوان بجٲو کاہنو تُرے سٮ۪ٹھہےٕ زُو زٮ۪تہٕ سان تہٕ بڈِ ہَٹہِ۔ أتھؠ ستؠ دیُت یسوعنؔ باقی لوٗکن حکم زورٕ شورٕ سان نعرٕ دِنُک۔ خداوند چُھ توٚہہِ یہِ شہر بخشُن یژھان۔
\v 17 خداوندن چُھ اعلان کوٚرمُت زِ گٔژھیٚو وٲلِو یہِ شہر چھلہِ چھلہِ تہٕ کٔریٚو امہِ کِس پرٮ۪تھ چیٖزس ڈُبہٕ ڈاس۔ تاکہِ پتاہ لگہ زِ شہر چُھ فقط خداوند سُنٛد۔ چھرا ہیٚکہِ راحب، پاژھِنؠ پنُن زُو بچٲوِتھ۔ بیٚیہِ تِم سٲری تہِ یِم امسنٛدِس گھرس منٛز آسن تکیازِ امہِ دِژ سانٮ۪ن سوزؠ مٕتٮ۪ن جاسوٗسن پننہِ گھرِ چھپَن جاے۔
\v 18 خداوند سُنٛد فرمان چُھ امہِ شہرُک پرٮ۪تھ کانٛہہ چیٖز چُھ بُرباد کرُن لہٰذا تُلہِ زیٚو نہٕ اتہِ کانٛہہ چیٖز تہِ۔ یوٚدوے تُلِو، خداوند کرِوٕ سورےٕ اسرائیلی پڑاوےٕ سمہٕ سُتُر تہٕ کرِیٚو مصیبتن منٛز گیٖر۔
\v 19 مگر سورےٕ سۅن، رۅپھ تہٕ شِستٕر تہِ چیز یِم تہِ توٚہؠ لٔبِو تھٲوؠ زیٚو خداوند سٕنٛدِ باپتھ۔ یِم چیٖز ترٲؠ زیٚو خداوند سٕنٛدِس خزانس منٛز۔
\v 20 تِمو کوٚر تی یہِ تِمن یسوعنؔ ووٚن۔ ییٚلہِ کاہنو زیوٹھ شہہ تُرے بجٲوؠ، لوٗکو دِتؠ زورٕ شورٕ نعرٕ تہٕ شہرچ دلایہ آیہِ وٮ۪سرِتھ پتھرِس لاینہٕ۔ اسرائیلی ژاے سیٚودے شہرس منٛز۔ یپٲرؠ تہِ یُس اوس تہٕ یپٲرؠ تہِ وتھ آیہ تہٕ کوٚرُکھ شہرس قبضہٕ۔\f + \fr 6‏:20 \ft عبر: 11:30\f*
\v 21 تِمو اوٚن پرٮ۪تھ کانٛہہ زِنٛدٕ زُو تلفس تل تہٕ ترٲوِکھ مرد زِنٛدٕ نَہ زنان، نَہ لوٚکُٹ نَہ بوٚڈ، تیٖر، گُپن تہٕ خر تام نِیکھ کترٲوِتھ۔
\v 22 امہِ پتہٕ ووٚن یسوعنؔ شہرچ جاسوٗسی کرن والٮ۪ن دوٚن زنٮ۪ن "نیرِو تمِس پاژھنہِ ہُنٛد گھرٕ تہٕ انؠ ہون سۅ پنٕنؠ سٲری گرٕوٲلؠ ہٮ۪تھ یوٚرؠ۔ یہِ زن توٚہہِ تس سٟتؠ وعدہ کوٚرمُت چُھو۔
\v 23 شہرس ژرژن وٲلؠ دوٚنوے زٔنؠ دراے تہٕ أنِکھ پانس ستؠ راحب۔ تِمو أنؠ تس ستؠ روزن وٲلؠ سٲری۔ تسُنٛد مول، موج، بیٚنہِ، بوے تہٕ باقی رِشتہٕ دار تہِ پننس پڑاوس دوٗرے پہن بیٚیِس أکِس جایہِ۔
\v 24 امہِ پتہٕ دِتُکھ سٲرسےٕ شہرس نار تہٕ زولُکھ تہِ سورےٕ یہِ اتھ منٛز پتھ کُن کینٛہہ رودمُت اوس۔ چھرا بچووُکھ سۅن، رۅپھ تہٕ سرتل تہٕ شِسترو بانہٕ بٹھٕ یِم اسرائیل یو خداوند سٕنٛدِس خزانس ترٲوؠ۔
\v 25 یسوعنؔ دیُت چھرا راحب، پاژھنہِ تہٕ امسنٛدٮ۪ن گرٕوالٮ۪ن یعنی مٲلِس ماجہِ تہٕ سٟتؠ بٲژن زِنٛدٕ روزنہٕ۔ أمؠ سٕنٛدؠ پوت وٲلؠ زُرؠ بیترِ چھِ از تہِ اسرائیلس منٛز لسان بسان تکیازِ أمؠ دِژ یسوعؔ سنٛدٮ۪ن یرِیحو شہرس ژرژنہ سوزن والٮ۪ن تِمن دوٚن جاسوٗسن چھپَن جاے۔ یِمو تس زندگی بخشنُک وعدہ دیُتمُت اوس۔
\v 26 اتھ موقعس پٮ۪ٹھ تُل یسوعنؔ قسم۔ خدا وند سنٛز لعنت ؤسِن تِمن پٮ۪ٹھ یِم یرِیحوہس دُبارٕ بساونچ کوشش کرن۔ اتھ شہرس گۅڈنِچ کٔنؠ لاگن وٲلِس مٔرِن پنُن آدنُک لڑکہٕ۔ تہٕ ییٚلہِ سُہ شہرُک دیوار تعمیر کٔرِتھ مۅکلہِ تمہِ وزِ مٔرؠ نس کونٛس ہیٚو نیٚچو۔
\v 27 خداوند رود یسوعسؔ ستؠ تہٕ اتھ کنعٲنؠ ملکس منٛز روزن وٲلؠ پرٮ۪تھ زِنٛدٕ زُوون زون یسوعؔ کُس تہٕ کیاہ اوس۔
\c 7
\p
\v 1 خداوند سُنٛد حکم اوس ز یرِیحُو شہرُک اکھ اکھ یہُوواہسؔ کُن منصوب چیز گژھِ یُن بُرباد کرنہٕ۔ یہِ کتھ درراونہٕ باپتھ زِ یِم ٲسؠ صرف تہٕ صرف خداوندٕ سٕنٛدؠ۔ مگر اتہِ اوس یہُوداؔ قبیلُک عکن ناوُک نفر تہِ یسُنٛد مول اوس کرمیؔ، بوٚڈ بب زبدیؔ تہٕ جدٕ بوٚڈ بب زارحؔ۔ تٔمؠ کٔر خداوند سٕنٛدِ حکمٕچ نافرمٲنی تہِ تھٲوِنؠ کینٛہہ چیٖز پانس کِتؠ۔ اتھ پٮ۪ٹھ سپُد خداوند سارنےٕ اسرائیل ین پٮ۪ٹھ برہم۔
\v 2 یسوعنؔ سوزؠ پنٕنؠ کینٛہہ نفر یرِیحُو پٮ۪ٹھٕ عی شہرس کُن۔ یُس جو بیت ایلؔ کِس مشرِقس منٛز بیت آونسؔ نکھہٕ چُھ۔ تٔمؠ ووٚن تِمن" نیرِو عی شہرس کُن تہٕ ژھٲنٛڈِو یہِ سورےٕ علاقہٕ" اوے دراے تِم اور تہٕ ژھونٛڈُکھ سورےٕ علاقہٕ۔
\v 3 واپس پھیرِتھ ووٚن تِمو یسوعسؔ اتیُک سورےٕ حال عی قصبس منٛز چھِ سٮ۪ٹھا کم لوٗکھ۔ لہٰذا سوزؠ وُکھ چھرا زٕ یا ترےٚ ساس سِپاہ تِمن حملہٕ کرنہٕ باپتھ۔ اور سٲری سِپاہ سوزنچ چھنہٕ کانٛہہ ضرورت۔
\v 4 اوے وٲتؠ عی قصبس منٛز حملہٕ کرنہٕ باپتھ چھرا ترےٚ ساس نفر۔ مگر یِمو ہیوٚکنہٕ عی بالکُل تہِ تلفس تل أنِتھ۔ اکھتُے آے مُشکلنےٕ زُو زٔٹ بچٲوِتھ واپس ژٔلِتھ۔
\v 5 دُشمنن ٲسؠ شییہ ترٕہ اسرائیلی ژھٕنمٕتؠ مٲرِتھ تہٕ باقین ٲسکھ شہرکیٚو دروازَو پٮ۪ٹھٕ بالہٕ دامنس تاں لار کٔرمٕژ تہٕ امہِ اپور تتھ جایہِ یتہِ لوٗکھ کنہِ بال پٹان ٲسؠ۔ ییٚلہِ اسرائیل یو یہِ حال وُچھ تِمن ژایہِ نَٹھ تہٕ سپٕدؠ بے ہمت۔
\v 6 یِژھ ہار وُچِھتھ سپٕدؠ یسوعؔ تہٕ باقی اسرائیلی زِٹھؠ یِتھؠ دۅکھٕ زد زِ تِمو ژٔٹؠ نٲلؠ پلو تام۔ تِم سپٕدؠ تتھ مقدس خٟمس برونٛہہ کنہِ سر بسجوٗد یتھ منٛز مقدس صندوق تھاونہٕ آمُت اوس۔ تِم رودؠ أتھؠ حالتس منٛز اتہِ شامس ژیر تام۔ پننہِ اتھ شرمندگی تہٕ خجالتس پٮ۪ٹھ دۅکھل سپدِتھ لٔز تِمو پننٮ۪ن کلن لژھ تہِ۔
\v 7 امہِ پتہٕ کٔر یسوعنؔ عبادت تہٕ کۅرُن ودان ودان التجا، ہے خداوند! سانہِ رچھن والہِ ژےٚ أنِتھ أسؠ یردن دریاوس حفاظتہٕ سان یپور تٲرِتھ۔ تیٚلہِ کیازِ چُھو وۅنؠ اسہِ یِمن امورؠؔ لوٗکن اتھہِ بُرباد کرُن یژھان؟ أسؠ ہیٚکو نا بدل فٲصلہٕ نِتھ تہٕ دریاوٕ اپارِ روزِتھ۔
\v 8 ہے سانہِ رچھن والہِ خدایہ! ژےٚ کینٛہہ منٛگنس چُھم نہٕ تارےٕ وۅتھان۔ اسرائیلی آے ہٲرِتھ ژٔلِتھ۔ أسؠ آے خجل زَد ہیٚوؠ دُشمنس نِش تھَر پھِرتھ ژٔلِتھ۔ مےٚ چُھنہٕ فِکرے تران زِ بہٕ ونہٕ کیاہ۔
\v 9 کنعٲنؠ تہٕ یتھ علاقس منٛز باقی سٲری روزن وٲلؠ بوزن یہِ سورےٕ سون گُدرُن۔ امہِ پتہٕ یِن یِم سٲری اسہِ پٮ۪ٹھ وۅگلِتھ تہٕ انُن اسہِ تلفس تل۔ امہِ پتہٕ کیاہ سنا کرکھ ژٕ پنُن یہِ عظمت وول ناو رچھنہٕ باپتھ؟
\v 10 اورٕ ووٚنُس خداوندن "وۅتھ تھوٚد۔ تراو یہِ ربہِ تہٕ لژھِ سٟتؠ پنُن بُتھ مَتھُن۔
\v 11 یِمو اسرائیلی لوٗکو کوٚر گناہ۔ توٚہہِ کٔرو میانٮ۪ن حکمن ہنٛز نافرمٲنی۔ یِمو وۅنےٕ ژےٚ اپُز۔ یِمو کٔر ژوٗر۔ یہِ یمو ژورٕ اوٚن تہٕ تھووہے پانس پننٮ۪ن چیزن سٟتؠ اتھ ژوٗرٕ مالس وۅرُن کرنہٕ باپتھ۔
\v 12 اوے ہیوٚکنہٕ اسرائیل یو پنُن دُشمن ہارنٲوِتھ۔ اوے آے یِم ژٔلِتھ۔ تہٕ وُنؠ یِکھ ژٕتہِ اتھ بُربٲدی ہنٛدِس زَدس منٛز یوٚدوے ژٕ تہِ کرَکھ نہٕ یہِ بہٕ حکم کرے تہٕ تہِ سورے کرکھ بُرباد یہِ توٚہہِ یریخو پٮ۪ٹھٕ تھَپہِ اوٚنو۔ بہٕ کرے نہٕ یمہِ اپور رَژھ تہِ مدد۔
\v 13 وُنؠ وۅتھ تہٕ ون یِمن سارنے اسرائیلی لوٗکن زِ پگاہ باپتھ کرن تِم پنُن پان الگ تیار۔ پان شوژراون تہٕ خداوند سٕنٛدِ باپتھ گژھن تیار۔ توٚہہِ رۅٹو سُہ مال پانس یُس خداوندن توٚہہِ بُرباد کرُن ووٚنمُت اوس۔ یِمہٕ ٲسؠ امہِ لِکھہٕ مےٚ کُن تراوٕنؠ۔ اسرائیل ین ہُنٛد خدا وند چُھ ونان "توٚہؠ ہیٚکِو نہٕ ہرگِز پننِس دُشمنس پوشِتھ یوٚتام نہٕ توٚہؠ تِمو ساروےٕ چیٖزَو نِشہ اتھہٕ چھلیٚو یِم توٚہہِ یریخو پٮ۪ٹھٕ اوٚنتھ پننِس مالس ستؠ مِلنٲوِتھ ژوٗرِ تھٲیِو۔
\v 14 پگاہ صبحٲے گٔژھِو سٲری قبیلہٕ وار مےٚ برونٛہہ کنہِ پیش تہٕ یُس قبیلہٕ بہٕ قرعہ ترٲوِتھ ژارن سُہ ییہِ پنُن سورےٕ خاندان ہٮ۪تھ مےٚ برونٛہہ کُن۔ یُس خاندان بہٕ ژارن سُہ ییہِ پنُن سورےٕ ونٛڈٕ ہٮ۪تھ۔ تہٕ یُس ونٛڈٕ بہٕ ژارن سُہ ییہِ اکھ اکھ بٲژبیوٚن بیوٚن مےٚ برونٛہہ کُن۔
\v 15 تہٕ سُہ نفر یمؠ میانہِ باپتھ ناو ناوِ الگ کڈنہٕ آمٕتؠ چیز پانس رٔٹؠ سُہ ییہِ نارس ترٲوِتھ بُرباد کرنہٕ۔ سُہ تہٕ تسُنٛد پرٮ۪تھ کانٛہہ چیٖز ییہِ زالنہٕ تکیازِ تٔمؠ چُھ سُہ وعدہ تہِ محاہدٕ پھُٹرومُت یُس خداوندن اسہِ سارٕنے سٟتؠ کوٚرمُت اوس۔ تہٕ تٔمؠ اکؠ زٔنؠ چُھ اسہِ سارِنےٕ اسرائیل ین منٛز اکھ انتہٲیی ذلت آمیز گۅناہ کوٚرمُت۔
\v 16 دویمہِ دوٚہہ صُبحٲے ووٚن یسوعنؔ سارِنےٕ اسرائیل ین عبادت چہِ جایہِ نکھہٕ واتنہٕ باپتھ، قبیلہٕ پتہٕ قبیلہٕ۔ ییٚلہِ تِمو تہِ کوٚر، یہُوواہنؔ دِیُت اِشارٕ زِ یہُوداؔ قبیلُک اکھ نفر اوس منتخب کرنہٕ آمُت۔
\v 17 پتہٕ کوٚر یہُوداؔ قبیلہٕ کیٚو پنُن پان پیش، تہٕ یہُوواہنؔ کوٚڈ زارہ ونڈُک زبدیؔ ناوُک گرٕ ونہِ۔
\v 18 امہِ خاندانُک اکھ اکھ بٲژ آو خداوندس برونٛہہ کُن تہٕ خداوندن کوٚڈ ونہِ امہِ گرُک عکنؔ نٲوؠ بٲژ۔ عکن اوس کرمیؔ سُنٛد نیٚچو یُس پانہٕ زبدیؔ سُنٛد اوس تہٕ زبدیؔ اوس زارحؔ سُنٛد نیٚچو
\v 19 یسوعنؔ ووٚن أمِس عکنس، "گۅبرا۔ ون سورےٕ پوٚز پوٚز اسرائیلی خداوندس برونٛہہ کنہِ۔ کینٛہہ مٕہ تھاو ژوٗرِ تہٕ ون کیاہ کۅرتھ"
\v 20 عکننؔ ووٚنُس اورٕ، "مےٚ کوٚر پزی اسرائیلی خدایس خلاف گٔژھِتھ گناہ۔ امِچ رویداد چھے یتھٕ پٲٹھؠ
\v 21 ییٚلہِ ٲسؠ یریحو شہرکِس منٛز ٲسؠ، لوٗٹہٕ مالس منٛز وُچھ مےٚ اکھ نفیس بابٕلؠ چۅغہٕ، سۅاد زٕ کِلو گرام روٚپھ تہٕ شے ہتھ گرام سۅنہٕ چٲٹؠ۔ مےٚ درایہِ کل یِم چیٖز پانس رَٹنٕچ۔ اوے تُلِم رٲسے تہٕ دۅبرٲوِم پننِس خٟمس تل۔ یِم سٲری چیٖز چھِ وُنہِ تہِ أتی ژوٗرِ۔ رۅپھ چُھ سارِوٕے چیٖزَو تلہٕ کنہِ"\f + \fr 7‏:21 \ft زٕ ہتھ سِکہٕ آسن زٕ کلو کھۅتہٕ زیادٕ۔ سۅنہٕ چاٹہِ ہُنٛد وزن اوس اوٚڈ کِلو۔ \f*
\v 22 یسوعنؔ سوزؠ پنٕنؠ کینٛہہ نفر یہٕ ژوٗرٕ مال وُچھنہِ پننِس اتھ خٟمس منٛز۔ مال اوس پزی أتی۔ رۅپھہِ ۂن ٲس تلہٕ کنہِ۔
\v 23 تِمو اوٚن یہِ سورےٕ کٔڈِتھ یسوعسؔ برونٛہہ کنہِ سارنےٕ اسرائیل ین دیدمان تہٕ ترووُکھ خداوندس برونٛہہ کُن نزرانہٕ رٔنٛگؠ۔
\v 24 یسوعؔ تہٕ باقے تمام اسرائیلیٚو وول زارحؔ سٕنٛدِس نیٚچوِس عکنسؔ عکوز وادی منٛز مکان تہِ ؤٹِتھ اوٚنُکھ عکنسؔ سٟتؠ سٟتؠ تہِ سورےٕ سمبرٲوِتھ ؤٹِتھ عکننؔ اوس۔ مال جایداد خر، گُپن، تیٖر، تسٕنٛدؠ شُرؠ بٲژ، زنان، کور، شُرؠ، حالانکہ تسٕنٛدؠ خٟمہٕ خرگاہ تٲنؠ پانس سٟتؠ
\v 25 یسوعنؔ ووٚن عکنسؔ یہِ مصیبت کیازِ اوٚنُتھ ژےٚ اسہِ؟ رَٹھ وُنؠ انَے ژےٚ پانہٕ خداوند مصیبت تُلِتھ۔ امہِ پتہٕ دیُت ساروٕے اسرائیلیٚو تس تہٕ تسٕنٛدٮ۪ن گرٕکٮ۪ن کنہِ کنہِ کٔرِتھ سارے گرٕوٮ۪ٹھ نار۔
\v 26 یہنٛدس سوٗرس پٮ۪ٹھ کھول لوٗکو اکھ کنہِ انبار۔ یِم وُنہِ تہِ اتہِ چھِ۔ اوے چھِ اتھ از تہِ لوٗکھ عکوز وادی ونان یعنی وصیتچ وادی\f + \fr 7‏:26 \ft مصیبتٕچ وادی\f*۔ امہِ پتہٕ اوس نہٕ یہُوواہؔ وۅنؠ اسرائیلی لوٗکن ناراض۔
\c 8
\p
\v 1 امہِ پتہٕ ووٚن خداوندن یسوعسؔ، "یِنہٕ وُنؠ کھوٚژِو یا پست ہمت گٔژھِو۔ ووٚتھ پنٕنؠ سٲری سِپاہ ہٮ۪تھ نٮ۪بر تہٕ کٔرِو تتھ عیؔ شہرس پٮ۪ٹھ نوو حملہٕ۔ عیؔ شہر گٔژھِو بہٕ چُھسو عیؔ شہرُک رازُت توٚہی بخشان۔ توٚہؠ أنیٚو اتِکؠ لوٗکھ تہٕ اتِچؠ زمیٖن تلفس تل۔
\v 2 چٲنؠ سِپاہ کرن عیؔ تہٕ اتہِ کِس بادشاہس سٟتؠ تی یہِ یمو یرِیحُو شہرس تہٕ اتہِ کٮ۪ن لوٗکن سٟتؠ کوٚر۔ بوزو! أزکہِ لٹہِ رٔٹیٚو توٚہؠ سُہ سورےٕ لوٗٹہٕ مال پانس یہِ اتہِ تھَپہِ تھۅسہِ أنِو۔ بیٚیہِ بوز، "کینٛہہ سِپاہ تھٲؠ وُکھ شہرس پٔتؠ کِنؠ ژرژنہِ تہٕ امہِ پتہٕ کرِ حملچ تیٲری۔
\v 3 تو پتہٕ تُل پوٗرٕ فوج ہٮ۪تھ یسوعنؔ عیؔ شہرس کُن حملہٕ کرنہٕ باپتھ قدم۔ أمؠ ژٲرؠ ترٕہ ساس سِپاہ یِم پننہِ بلہٕ تہٕ جراعت باپتھ زاننہٕ ماننہٕ ٲسؠ آمٕتؠ تہٕ کٔرِن یِم راتھ کیُتھ عیؔ شہرس کُن روانہٕ۔
\v 4 ستؠ ووننکھ کن تھٲیِو۔ توٚہہِ منٛزٕ روزیٚو کینٛہہ شہرس پٮ۪ٹھ بےٚ خبر پٲٹھؠ حملہٕ کرنہٕ باپتھ تیار۔ بس توٚہؠ شہرس پٔتؠ کِنؠ روزتھ منظم کرو۔ شہرس نکھے روزیو۔ توٚہہِ سارِنےٕ چُھو حملہٕ باپتھ تیار روزُن۔
\v 5 بہٕ تہٕ میٲنؠ باقی سِپاہ نیرن صُبحس سُلے شہرس کُن۔ تہٕ ییٚلہِ شہرٕکؠ لوٗکھ برونٛٹھِم پٲٹھؠ شہرٕ نٮ۪بر نیرتھ اسہِ سٟتؠ جنگس یِن تِمن وُچھتھےٕ پھیرو أسؠ پوٚت تہٕ لاگو تِمن نِشہ دوٗر ژَلُن
\v 6 تِمن باسہِ زِ أسؠ چھِ برونٛٹھِم پٲٹھؠ تِمن نِشہ پان بچٲوِتھ ژَلان۔ تِم کرن پنٕنؠ کِنؠ اسہِ شہر دوٗر تام لار۔ ییٚلہِ یپٲرؠ أسؠ تِمن برونٛہہ برونٛہہ ژَلان روزو
\v 7 توٚہؠ، ژوٗرِ ژھٮ۪پہِ روزن وٲلؠ سِپاہ یی زیٚو پننہِ چھپَن جایہِ پٮ۪ٹھ نیرتھ تہٕ کُنی دورِ أژؠ زیٚو شہرس تہٕ کٔرؠ زیٚو اتھ قبضہٕ۔ خداوند دِیو امہِ شہرُک راج تاج توٚہی
\v 8 شہرُک قبضہٕ رَٹوُنےٕ کٔرؠ زیٚو یہٕ شہرٕ نارٕ بُزؠ۔ تی کرو یہِ خداوندن ونُو۔ یوٚہے حکم چُھسو بٕتہ دِوان توٚہہِ۔
\v 9 امہِ پتہٕ کٔر یسوعنؔ تیٲری تہٕ سوزِن تِم ترٕہ ساس سِپاہ ژوٗرِ روزنہٕ باپتھ عیؔ تہٕ اتھ مغربس منٛزؔ بیت ایلؔ جایہِ درمیان۔ مگر امہِ رٲژ شونٛگ یسوعؔ پننٮ۪ن سپہن درمیان۔
\v 10 دوٚیمہِ دوٚہہ صُبحٲے أنؠ یسوعنؔ پنٕنؠ سِپاہ سمبرٲوِتھ: سُہ رود عیؔ شہرس پٮ۪ٹھ حملہٕ کرنہٕ باپتھ یِمن سارِنےٕ سِپہن تہٕ باقی اسرائیل ین برونٛہہ برونٛہہ رہنمٲیی کران۔
\v 11 یِمو کٔرؠ پنٕنؠ خٟمہٕ شہرکِس جنوبس منٛز کھڑا یتہِ تِمن سٲری شہرٕکؠ لوٗکھ وُچِھتھ ہیٚکن۔ تٕن تہٕ عیؔ شہرس درمیان ٲس اکھ گھاٹی۔
\v 12 یسوعسؔ ٲسؠ پانٛژھ ساس سِپاہ گۅے سوزؠ مٕتؠ تہٕ ووٚنُن تِمن زِ توٚہؠ روزیٚو شہرس پٔتؠ کِنؠ زاگہِ اچانک حملہٕ کرنہٕ باپتھ۔ شہرکِس مغربس منٛز عیؔ تہٕ بیت ایلؔ جایہِ درمیان۔
\v 13 سارِوےٕ کٔر امہِ حکمہٕ مطٲبق عمل۔ سپہن ہُنٛد مزکزی دستہٕ اوس شہرکس شمالس منٛز، باقی رودؠ زاگ دِتھ شہرکِس مغربس منٛز۔ امہِ دوٚہہ رات کیُتھ رود یسوعؔ گھاٹی منٛز۔\f + \fr 8‏:13 \ft امہِ دوٚہہ رات کیُت ووٚتھ یسوعؔ بوٚن وادی منٛز\f*
\v 14 عی شہرٕکؠ بادشاہن ڈیونٛٹھ اسرائیلی فوج، تہٕ دوٚیمہِ دوٚہہ صُبحٲے ووٚتھ سُہ پنُن فوج ہٮ۪تھ تہٕ دراو شہرٕ نٮ۪بر یمن سٟتؠ جنگس۔ تِم وٲتؠ شہرکِس مشرقس منٛز یتہِ پٮ۪ٹھٕ تِم یردن دریاوکِس مٲدٲنی علاقس پٮ۪ٹھ نظر تھٲوِتھ ہیٚکن یہِ زاننہٕ ورٲے زِ اسرائیلی فوج چُھ شہرٕ پٔتؠ کِنؠ زاگہِ روزِتھ تِمن پٮ۪ٹھ حملہٕ کرنس تیار۔
\v 15 یسوعؔ تہٕ اسرائیلی فوجن دیُت پوٗرٕ موقعہ عی کٮ۪ن فوجین تِمن دکہٕ دِتھ ژلناونُک۔ اسرائیلی فوج لوٚگ بیابانس کُن ژلنہِ۔
\v 16 عی فوجس آو حکم دِنہٕ یسوعؔ تہٕ تسٕنٛدِس فوجس پتہٕ لگنُک۔ یِمو تروو پنُن شہر تہٕ کٔرٕکھ یسوعسؔ تہٕ تمسٕنٛدِس فوجس لار۔
\v 17 عیؔ تہٕ بیت ایلؔ شہرٕ کیٚو تمام مردو تہِ کر اسرائیلی فوجس لار۔ تِمو تروو نہٕ امیُک دفاع کرنہٕ خٲطرٕ عیؔ شہرس منٛز اکھ تہِ نفر۔ تہٕ تِمو ترٲوؠ شہرٕکؠ دروازٕ کُھلہ یلہٕ کُنہِ رٲچھ ورٲے تہٕ دوریاے أنؠ دانٛدن ہنٛدؠ پٲٹھؠ اسرائیلی فوجس لار کرنہٕ باپتھ۔
\v 18 امہِ پتہٕ ووٚن یہُوواہنؔ یسوعسؔ "تُل پنُن نیزٕ تہٕ کر اشارٕ عیؔ شہرس کُن۔ بہٕ چُھسے یہِ شہر چانٮ۪ن فوجین فتح کرنس قٲبل بناون وول۔ عشوعنؔ تُل نیزٕ عیؔ شہرس کُن
\v 19 یُتھےٕ زاگہِ روزِتھ اسرائیلی فوجن یہِ اِشارٕ وُچھ تِم دورے پنہٕ نیٚو چھپَن جایو پٮ۪ٹھٕ سیٚودے شہرس کُن تہٕ اوٚنُکھ تلفس تل تہٕ دیُت ہس یکدم نار۔
\v 20 ییٚلہِ عیؔ کیٚو لوٗکو پتھ کُن وُچھ اتہِ اوس شہرس دُہےٕ دُہہ وۅتھان۔ مگر کینٛہہ کرنُک وق اوس روومُت۔ تِمو ہیوٚک نہٕ کِہین کٔرِتھ۔ اسرائیلی فوج اوس تہنز پوت پھیرنچہِ وتہِ رٔٹِتھ تہٕ برونٛہہ برونٛہہ ثلن وول آکھ پوٚت پھیرِتھ۔
\v 21 یسوعؔ تہٕ تسنٛدیٚو سٲتھی فوجیو وُچھ زِ زاگہِ روزِتھ فوجیو چُھ شہر تلفس تل اوٚنمُت تہٕ چھِ وُنؠ اتھ نارٕ بُزؠ کران۔ تِمو وُچھ پانہٕ شہرس دُہےٕ دُہہ وۅتھان۔ لہٰذا پھیرؠ تِم پوٚت تہٕ لٲگِکھ یِم عی یِکؠ دُشمن مارٕنؠ۔
\v 22 یِمو سِپہَو شہر تلفس تل اوٚن آیہِ واپس نیرتھ تہٕ رٔٹِکھ عی فوجی زنتہٕ کنٛزس منٛز۔ عی فوجی آے دونوے انٛدو اسرائیلی فوجیو دٔسؠ کنجس منٛز۔ اکھ تہِ دراو نہٕ بٔچِتھ۔ اسرائیلی روٗدؠ یِمن پیٚٹھےٕ یوٚتام اکھ عی فوجی مارنہٕ آو
\v 23 ؤنؠ گو عی شہرُک بادشاہ آو زندے رٹنہٕ تہٕ یسوعس نِش واتناونہٕ۔
\v 24 یٖتِس کالس یہِ لڑٲے روز۔ اسرائیلی فوجیو پکہٕ نٲوؠ عی شہرٕکؠ فوجی مٲدانس تہٕ بیابانس کُن تہٕ کترٲوِکھ اکہ اکہ سٲری۔ امہِ پتہٕ ژاے تِم شہرس منٛز تہٕ کوٚرُکھ نیست و نابود پرٮ۪تھ کانٛہہ چیٖز تہٕ زون یُس وُنہِ تہِ زِندے اوس
\v 25 امہِ دوٚہہ مٲرؠ یِمو باہ ساس زنہِ تہٕ مرد۔ تِمو مٲرؠ سٲری عی شہرٕکؠ بسکین۔
\v 26 یسوعؔ رود کھڑا نیزٕ شہرس کُن رٔٹِتھ یوٚتام عی یِکؠ سٲری لوٗکھ مارنہٕ آے۔
\v 27 اسرائیلیٚو رٔٹؠ اتِکؠ جانور تہٕ باقی چیٖز سٲری پانس یہِ زن خداوندن یسوعسؔ ووٚنمُت اوس کرُن۔
\v 28 یسوعؔ تہٕ تسٕنٛدیو فوجیو زول عی شہر ژوٚک تام تہٕ ترووُکھ ہمیشہٕ باپتھ ملبُک ڈیر ہیٚو پتھ کُن۔ از تہِ چُھ وٲرانےٕ۔
\v 29 یسوعنؔ تروو عی شہرُک بادشاہ أتی کلس ترۅدِ تہٕ شام تام رود سُہ أتی ڈۅلان۔ آفتابہٕ لوسہٕ وُن ووٚن یسوعنؔ پنہٕ نٮ۪ن فوجین بادشاہ ترۅدِ پٮ۪ٹھٕ والنُک تہٕ تتھ جایہِ تراونُک یتہِ نس شہرُک دروازٕ اوس۔ فوجیو کوٚر بالکُل یی تہٕ کوٚرُکھ امسنٛز لاشہِ پٮ۪ٹھ اکھ کنہِ انبار تیار یُس وُنہِ تہِ اتہِ چُھ۔
\v 30 یسوعنؔ ووٚن کینٛہہ کال پتہٕ پننٮ۪ن لوٗکن اسرائیلی خدا سٕنٛدِ احترامہٕ باپتھ عیبال بالسؔ پٮ۪ٹھ اکھ قربان گاہ تعمیر کرنہٕ خٲطرٕ۔\f + \fr 8‏:30 \ft خروج: 20:25، اِستِثنا: 27:5-6\f*
\v 31 تِمو کوٚر یہِ تعمیر تمہِ انمانہٕ یتھٕ پٲٹھؠ زن خدا سٕنٛدِ بنٛدٕ موسیٰؔ ہن اوس تتھ شریعتس منٛز لیٚوکھمُت یۅسہ تمِس خداین عنایت کٔر۔ یہِ قربان گاہ آیہ کنیو منٛزٕ کھالنہِ بغٲر گراے تہٕ شِسترو کانٛہہ اوزار لاگنہٕ ورٲے چھرا کنیو ستؠ۔ امہِ پتہٕ کٔر اسرائیلیٚو خداوندس پیش یورٕ دزن سوختی نذر۔ بیٚیہِ کوٚرُکھ تس سٟتؠ سلامتی ہُنٛد عہد پورٕ کرنہٕ باپتھ باقی نذرانہٕ تہِ پیش۔
\v 32 باقی اسرائیلی لوٗکن دیدمان لیکھ یسوعنؔ موسیٰؔ ہس دِنہٕ آمتہِ خداوند سُنٛد شریعتُک نقل کنٮ۪ن پٮ۪ٹھ۔\f + \fr 8‏:32 \ft یہٕ چُھنہٕ سونٛچُن زِ کنٮ۪ن ہُنٛد علاقہٕ کیاہ آسہ تیوٗتاہ بوٚڑ زِ تمام ہدایت تہٕ قانون گژھن لیکھنہٕ یِنؠ۔ \f*
\v 33 امہِ پتہٕ رودؠ سٲری اسرائیلی زِٹھؠ، عہددار، قٲضی تہٕ باقی منصب دار مقدس صندوقس دوٚپاسے وۅدٕنؠ۔ سٲری روٗدؠ مقدس صندوق ہٮ۪تھ لاوین تہٕ ربین کاہنن کُن بُتھ کٔرِتھ۔ اتہِ نس ٲسؠ غیر اسرائیلی تہِ کینٛہہ وۅدٕنؠ۔ نیصف لوٗکھ رودؠ عیبالؔ پہاڑکِس دامنس تل اکہ طرفہٕ تہٕ نیصف گرزِیمؔ پہاڑ کِس دامنس تل۔ مقدس صندوق اوس بوٚن گھاٹی منٛز دون درین درمیان۔ گۅڈٕ انوارِ کوٚر تِمو خداوند سٕنٛدِس بندس موسیٰؔ سٕنٛدِ وننس پٮ۪ٹھ سارنےٕ اسرائیلی لوٗکن رُت دُعا۔
\v 34 امہِ پتہٕ کٔر یسوعن تمام لوٗکو باپتھ موسیٰؔ سٕنٛدِ شریعتچ تلاوت۔ اتھ منٛز اوس خداوند سنٛدٮ۪ن حکمن تہٕ مانن والٮ۪ن ہنٛدِ باپتھ امؠ سنٛزن برکتھن تہٕ نَہ مانن والٮ۪ن ہنٛدِ باپتھ بد دُعاہن ہُنٛد تہِ بیان۔
\v 35 یسوعنؔ پٔرؠ بڈٕ احتیاطہ سان موسیٰؔ سنٛدؠ دِتمٕتؠ حکم۔ تمؠ پوٚر اکھ اکھ لفظ تمام سمیمتِس اسرائیلی اجتماعس برونٛہہ کنہِ۔ تمام زنہِ تہٕ شُرؠ تہِ ٲسؠ اتہِ تہٕ تِم غٲر ملکی تہِ یم اسرائیل ین سٟتؠ روزان ٲسؠ۔
\c 9
\p
\v 1 یردن دریاوکِس مغربی بٔٹھِس پٮ۪ٹھ ٲسؠ حِتی، امورؠؔ، کنعانؔؠ، فِرزی، حوی تہٕ یبوسؠ بادشاہ۔ یہُنٛد راج پہٲڑی علاقن، دوٗر مغربس کُن بنؠ مٮ۪ن بالن کھیٚن تام تہٕ بحیرہ رومسؔ کُن مٲدٲنی علاقن تام پھٔہلِتھ اوس عیؔ شہرُک گُدرُن بوز یِمو سورےٕ۔
\v 2 یِمو سمبرٲوؠ پنٕنؠ سٲری سِپاہ کٲنٛسہِ اکؠ سٕنٛدِس حکمس تل، یسوعسؔ تہٕ اسرائیل ین خلاف جنگ کرنہٕ باپتھ۔
\v 3 ولیکن یمہِ وزِ جِبعونؔ کیو بسکین درو بوز زِ یسوعؔ سٕنٛدیو سِپاہو أنؠ یرِیحُو تہٕ عیؔ شہر تلفس تل۔
\v 4 تِمو کۅر فٲصلہٕ زِ تِم گِنٛدن اسرائیل ین خلاف بدل کھیل۔ تِمو سوزؠ پنٕنؠ کینٛہہ نفر تِمن نِش ٲکھِتھ مٲکھِتھ سفیر بنٲوِتھ۔ یِمَو نفرو أنؠ سمبرٲوِتھ کینٛہہ پرانہِ ژھیٚنہِ مژٕ شرابہٕ مشکہٕ یِمن ٹیبہٕ آسہ دِنہٕ آمژٕ تہٕ بریٚکھ یمہ خرن پٮ۪ٹھ
\v 5 پانس لاجکھ ٹیبہٕ کٔڈؠ کٔڈؠ ژھیٚنہِ مژٕ چپنہِ تہٕ نٲلؠ زچہِ تہٕ تُجکھ سفرٕ باپتھ ہوٚچھٕ تہٕ کرُچہِ گٲمژٕ ژۅچہِ
\v 6 تِم وٲتؠ أتھؠ بظٲہِر خستہٕ حالژ منٛز جِلجالؔ یتہِ یسوعؔ تہٕ باقی اسرائیلی پڑاو دِتھ ٲسؠ تہٕ وونُکھ یِمن، "أسؠ چھِ سیٹھاہ منٛزِل کٔڈِتھ آمٕتؠ۔ مہربٲنی کٔرِتھ کرِیٚو اسہِ سٟتؠ امن معاہدٕ
\v 7 اسرائیلی زِٹھیو ووٚن یِمن جلدی زٲنِتھ ییٚلہِ زن یِم حویؔ ٲسؠ "توٚہؠ ما چُھو نکھے روزان؟ ٲسؠ کِتھٕ پٲٹھؠ کرو توٚہہِ ستؠ کانٛہہ معاہدٕ۔ توٚہؠ ہَے اسہِ نکھے روزان چُھو۔
\v 8 اورٕ ووٚن یِمو یسوعسؔ بڈٕ عٲجزی سان، "أسؠ چھِ تہنٛزِ خدمتہٕ باپتھ آمٕتؠ۔ یسوعنؔ پرٕژھُکھ یورٕ، "توٚہؠ چُھو کمہٕ تہٕ ٲخٕر آیہِ وٕ کتہِ پٮ۪ٹھٕ
\v 9 یِمو جِبعونؔ کیو وونُس درجواب، "أسؠ چھِ تُہنٛدؠ خٲدِم بنُن یژھان۔ أسؠ آے بڈٕ دوٗر دراز علاقہٕ پٮ۪ٹھٕ تُہنٛدِس خداوند سنٛز شہرت بوزِتھ۔ اسہِ بو تہِ سورےٕ یہِ أمؠ مِصرس منٛز کوٚر۔
\v 10 اسہِ چُھ تہِ سورےٕ تہِ بوزمُت یہِ أمؠ امورکیٚن یردن دریاے یَرن کِس مشرقس منٛز راجت کرن والٮ۪ن دوٚن بادشاہن حسبونؔ کِس سیحونؔ تہٕ بسنؔ کِس عوجؔ بادشاہس ستؠ کوٚر۔ یُس عستارات روزان اوس۔
\v 11 زِ اوے ووٚن اسہِ پننیٚو زِٹھیٚوِ" یہِ غذا تُلیو ستؠ تہٕ نیرِیو اسرائیل ین ستؠ سمجھوتہٕ کرنہِ۔ تِمن ؤنِو، "أسؠ چھِ یژھان تُہنٛدؠ خٲدِم بنٕنؠ لہٰذا کٔرِو اسہِ ستؠ معاہدٕ
\v 12 وُچھیٚو سٲنؠ یہِ ژوٚٹ۔ یہِ ٲس بالکُل تازٕ تہٕ گرم ییٚلہِ أسؠ پننیٚو گرو نیرتھ یورکُن دراے۔ ؤنؠ چھےٚ یہِ ژوٚٹ ہوٚچھمٕژ تہٕ برسیمٕژ
\v 13 وُچھیٚو یِم سانہِ شراب مشکہٕ۔ یِم آسہ بالکُل نیہِ ییٚلہِ سفرس نیروُن یِمن منٛز شراب بوٚر۔ ؤنؠ چھےٚ یِم پھُچمَژٕ تہٕ لِتھونہٕ آمژٕ۔ یتھ یورتام زیچھِ سڑکہِ پکان پکان چھِ ؤنؠ سٲنؠ پلو تہِ رُنیمٕتؠ تہٕ چینہٕ تہِ گسہِ آمژٕ۔
\v 14 اسرائیلی زِٹھیٚو کوٚر کینٛہہ غذا یہُنٛد قبوٗل تہٕ کھیوکھ اکھ کال یِمن ستؠ معاہدٕ مکمل کرنہٕ باپتھ۔ یمو زون نہٕ یہِ ضرورتھےٕ زِ تِم کرن پننِس خداوندس ستؠ اتھ کتھہِ پٮ۪ٹھ کانٛہہ مشورٕ
\v 15 یتھٕ پٲٹھؠ مون یسوعنؔ یِمن ستؠ امن معاہدٕ کرُن۔ اسرائیلیٚو کوٚر جِبعونؔ کٮ۪ن لوٗکن ستؠ یہِ معاہدٕ یمیُک اکھ شق یِتہِ اوس زِ تِم کرن نہٕ یِمن انزان لوٗکن قتل۔ سارِوےٕ اسرائیلیٚو کوٚر یہِ معاہدٕ پزِ دٕلہٕ سنٛجیدگی سان قبوٗل۔
\v 16 ترٮ۪ن دوٚہُن انٛدر انٛدرےٕ زون اسرائیلیٚو زِ یِم لوٗکھ ٲسؠ نزدیکھےٕ جِعونؔ پٮ۪ٹھٕ آمٕتؠ۔
\v 17 لہٰذا دراے تِم تور کن یتہِ جِعونٕکؠ لوٗکھ روزان ٲسؠ۔ ترٮ۪ن دوٚہُن ہُنٛد سفر کڈنہٕ پتے وٲتؠ یِم تیٚنٛدٮ۪ن جِبعونؔ، کفرہؔ، بیروتؔ تہٕ قریتؔ یعریمؔ شہرن نکھہٕ
\v 18 ؤنؠ گو اسرائیلیٚو کوٚر نہٕ یِمن شہرن پٮ۪ٹھ حملہٕ تکیازِ تِمو اوس قسم تُلمُت یِمن ستؠ امنہٕ سان روزنُک۔ تہٕ تہنٛدِس وعدس پٮ۪ٹھ اوس پانہٕ خداوند گواہ۔ پننٮ۪ن زِٹھٮ۪ن ہنٛدِس یتھ وتاولی منٛز کرنہٕ آمتِس وعدس پٮ۪ٹھ رودؠ سٲری اسرائیلی أنٛدری خمان
\v 19 مگر زِٹھیو ونُکھ اسہِ کوٚر یِمن ستؠ امنہٕ سان روزنُک وعدہ تہٕ سٲنؠ خداوندن بزو پانہٕ یہٰ سون وعدہ۔ ؤنؠ ہیٚکو نہٕ أسؠ یِمن کانٛہہ اِزا واتنٲوِتھ۔
\v 20 یوٚدوے أسؠ یِمن مارو، خدا سپدِ اسہِ پٮ۪ٹھ ناراض۔ سُہ دِیہ اسہِ وعدہ پھُٹراونُ سزا یُس اسہِ قسم تُلِتھ یورٕ سنٛجیدگی سان یمن لوٗکن دیُتمُت چُھ۔ ؤنؠ گو أسؠ ہیٚکو یِمن ستؠ یمہِ آیہِ روزِتھ۔
\v 21 أسؠ دِمو یِمن زِنٛدٕ روزنہٕ مگر یِم روزن سٲنؠ خٲدِم بنِتھ۔ یِم ژٹن سارنےٕ لوٗکن باپتھ زیُن تہٕ سارن آب۔ یی سپُد یہِ زن زِٹُھیو سونچ۔
\v 22 امہِ پتہٕ انہٕ نٲو یسوعنؔ جِلعونؔ شہرٕکؠ لوٗکھ ناد دِتھ تہٕ پرھژھنکھ، "توٚہہِ کیاز، ووٚنو اسہِ اپُز۔ تُہنٛدؠ گرٕ چھِ سٲنِس پڑاوس نکھَے۔ توٚہؠ چُھو نکھے بسان۔ مگر توٚہہِ ووٚنو زِ توٚہؠ چُھو سٮ۪ٹھا دوٗر علاقہٕ پٮ۪ٹھٕ آمٕتؠ۔
\v 23 توٚہہِ چُھو ؤنؠ میٲنِس شافس تل روزُن۔ توٚہؠ روزیٚو ہمیشہٕ باپتھ سٲنؠ خٲدِم توٚہؠ ژٔٹیٚو سانِس خداوند سٕنٛدِس گھرس خٲطرٕ زیُن تہٕ سٲریٚو آب۔\f + \fr 9‏:23 \ft عِبرٲنؠ متنس منٛز چُھ "خدایہِ سُنٛد گرٕ"\f*
\v 24 جِعونؔ کیٚو لوٗکو ووٚنُس درجواب، "اسہِ ووٚنو توٚہہِ اپُز تکیازِ اسہِ اوس پھرٮ۪ٹھ توٚہؠ کٔرِو اسہِ قتل۔ اسہِ اوس بوزمُت زِ یہُوواہؔ تہنٛدؠ خداین چُھ پننس بندس موسیٰؔ ہس ووٚنمُت زِ سُہ کرِ توٚہہِ پوٗرٕ مدد اسہِ سارنےٕ مارنہٕ باپتھ کنعانس منٛز، تہٕ سُہ دِیہ توٚہہِ سٲنؠ زمین۔
\v 25 ؤنؠ پزِ توٚہہِ فٲصلہٕ کرُن زِ توٚہؠ کیاہ کٔریٚو اسہِ ستؠ۔ کٔریوٚ اسہِ ستؠ تی یہِ توٚہؠ بہتر تہٕ رُت زٲنیٚو۔
\v 26 یسوعنؔ بچٲوؠ جِبعونٕکؔؠ لوُکھ مارٕ گژھنہٕ نِشہ أمؠ دیُت نہٕ اسرائیلی لوٗکن یِمن کانٛہہ اِذا واتناونہٕ۔
\v 27 امہِ بدلہٕ بنٲوؠ تٔمؠ یِم زبردستی جِبعونی خٲدم اسرائیل ین ہنٛدؠ۔ تِم رودؠ زیُن تہٕ زالُن ژٔٹِتھ انان تہٕ یہنٛدِ باپتھ آب ساران۔ یُس خداوندٕ سٕنٛدِ قربان گاہ باپتھ ضروٗری اوس۔ تہٕ جِبعونٕکؔؠ لوٗکھ چھِ برابر یی ازتام کران۔
\c 10
\p
\v 1 تٔمہِ وقتہٕ بوز یہِ شیٚچھ یروشلم شہرٕکؠ بادشاہ ادُونی صدقنؔ زِ یسوعؔ سٕنٛدؠ فوجن اوٚن عیؔ شہر تلفس تل تہٕ تھووُن اتہِ سٲرؠ سےٕ ڈُبہٕ ڈاس کٔرِتھ۔ یتھٕ پٲٹھؠ تٔمؠ یرِیحُو تہٕ اتہِ کِس رازس ستؠ کوٚرمُت اوس۔ تٔمؠ بوز مزید پتہٕ زِ جِبعونکیوؔ لوٗکو چُھ أمِس ستؠ امنُک معاہدٕ کوٚرمُت تہٕ ؤنؠ ٲسؠ تِم اسرائیل ین ستؠ روزان بسان
\v 2 یہِ بوزِتھ ژاے یروشلمٕکؠؔ لوٗکھ شرُکنٮ۪ن تکیازِ جِبعونؔ اوس اکھ اہم شہر۔ تِمن باقی شہرن ہنٛدؠ پٲٹھؠ یِمن پنُن بادشاہ تہٕ راجُت اوس۔ بلکہ اوس یہِ عیؔ شہرٕ کھۅتہٕ تہِ بوٚڈ تہٕ بیٚیہِ ٲسؠ اتِکؠ سِپاہ ژٔرؠ تجربہٕ کار۔
\v 3 لہٰذا سوزؠ شیٚچھِ وٲلؠ یروشلمٕکؠؔ بادشاہ ادُونی صدقنؔن پنُن پٲغام ہٮ۪تھ حبرون کِس بادشاہ ہُوہامسؔ نِش، یرموتؔ کِس پِیرامس، لکِیسؔ کِس بادشاہ یافیعؔ ہس تہٕ عجلُون کِس بادشاہ دبِیرسؔ
\v 4 پٲغامس منٛز ووٚننکھ زِ مہربٲنی کٔرِتھ یِیو مےٚ جِبعونسؔ پٮ۪ٹھ حملہٕ کرنس منٛز مدد کرنہِ تکیازِ یِمو جِبعونؔ کیو لوٗکو چُھ یسوعؔ تہٕ اسرائیل ین ستؠ امن معاہدٕ کوٚرمُت۔
\v 5 لہٰذا آے یِم اموریؔ پٮ۪ٹھٕ راجُت کرن وٲلؠ پانٛژوے یروشلم، حبرون، یرموتؔ، لکِیسؔ تہٕ عجلُونٕکؠ بادشاہ سمِتھ جِبعونؔ شہرس پٮ۪ٹھ پنٕنؠ سٲری لشکر ہٮ۪تھ وولِتھ تہٕ کوٚرُکھ شہرس گیرٕ اتھ پٮ۪ٹھ حملہٕ کرنہٕ باپتھ۔
\v 6 جِبعونؔ کیو لوکو واتنٲو یہِ شیٚچھ یسوعسؔ جِلجالؔ کِس پڑاوس منٛز۔ تِمو ووٚنُس۔ أسؠ چھِ چٲنؠ خٲدِم لہٰذا مٕہ تراو اسہِ لہٰذا وٲتیٚو ؤلؠ ؤلؠ مدتس تہٕ بچٲیو اسہِ۔ اسہِ کٔریو مدد تکیازِ اموریؔ بادشاہ چھِ سمُت کٔرِتھ اسہِ پٮ۪ٹھ ووغلِتھ آمٕتؠ۔
\v 7 یسوعؔ تہِ تسُنٛد فوج، سِپاہ تہٕ تسٕنٛدؠ بہترین جنگجو دراے جِلجالؔ کہِ پڑاوٕ پٮ۪ٹھٕ۔
\v 8 خداوندن ووٚن یسوعسؔ یِنہٕ تہنٛدِس فوجس ہرگِز کھوٚژِو۔ بہٕ دِمو توٚہہِ تِمن پٮ۪ٹھ فتح۔ تیٚہُنٛد کانٛہہ فوجی تہِ درِ نہٕ توٚہہِ برونٛہہ کنہِ۔
\v 9 یسوعؔ سُنٛد فوج رود رٲتی راتس پکان تہٕ سُلہِ صُبحٲے وٲتؠ تِم جِلجالؔ پٮ۪ٹھٕ تہٕ کوٚرُکھ امورؠؔ ین پٮ۪ٹھ اچانک حملہٕ۔
\v 10 خداوندن کٔرؠ تہنٛدؠ دماغ اسرائیلی فوج وُچِھتھ منتشِر۔ یسوعؔ سنٛزِ رہنمٲیی منٛزٕ کٔرؠ اسرائیلی فوجن اموریؔ فوج تلفس تل اوٚنتھ بے وایہِ قتل جِبعونؔ کِس شہرس منٛز تہٕ دورییہِ باقین بیت حورُونؔ کُن ژلن والٮ۪ن سٕہَن پتہٕ۔ یِتھَے پٲٹھؠ م رِکھ عزیقاؔہ تہٕ مقیدہؔ کُن ژلن وٲلؠ تہِ۔
\v 11 یمہِ وزِ تِم اسرائیلی فوجہٕ برونٛہہ کِنؠ ژلؠ، خداوندن واجہ یِمن پٮ۪ٹھ ڈوٹھہٕ ترٹہٕ۔ زیادٕ تر مودؠ اسرائیلی تلوارو بدلہٕ امی ڈوٹھہٕ سٟتؠ۔
\v 12 یمہِ دوٚہہ خداوندن اسرائیل ین اموریؔ فوجس پٮ۪ٹھ غلبہٕ بخُش، یسوعنؔ کوٚر دعا خداوندس، "ہے! افتابہٕ۔ جِبعونؔ کِس نبس پٮ۪ٹھ روز قٲیِم دٔرِتھ أتی۔ تہٕ ژٕ ہے زوٗنی! ٹھہراو قدم ایالونؔ چہِ گھاٹی پیٚٹھےٕ۔\f + \fr 10‏:12 \ft یہِ اوس غٲلبن یشارؔ سٕنٛدِ لیکھمتہِ پرانیٚن جنگی بٲتن ہُنٛد مجموعہٕ، وُچھِو 2 شموایل 1:18\f*
\v 13 تہٕ آفتاب گو تھامہِ تہٕ زوٗن روزِتھ یوٚتام اسرائیلی فوجن دُشمن سیاہ تلفس تل أنؠ۔ کیا یی چُھنا آشرؔ نٲوؠ کتابہِ منٛز درج۔ آفتاب گو منٛز دوٚہس تھامہِ اکسےٕ جایہِ تہٕ سٲرؠ سےٕ دوٚہس ڈوٚل نہٕ رژھ تہِ۔\f + \fr 10‏:13 \ft پوٗرٕ دوٚہُک مطلب چُھ دوٚہٕلؠ گاشُک بَہن گھٲنٹن ہُنٛد وق نہ زِ ژوُہن گھٲنٹن ہُنٛد وق۔ \f*
\v 14 امہِ دوٚہہ کوٚر خداوندن اکھ معجزٕ یُتھ کانٛہہ دوٚہہ اوسنہٕ امہِ برونٛہہ نَہ آو یُتھ کانٛہہ دوٚہہ امہِ پتہٕ ونیُک تام۔ ییٚلہِ خداوندن أکِس انسان سٕنٛدِس وننس پٮ۪ٹھ یُتھ ہیٚو معجزٕ کوٚر۔ امہِ دوٚہہ دراو پزی پانہٕ خداوند اسرائیل ین ستؠ ستؠ جنگس۔
\v 15 یسوعؔ تہٕ تسٕنٛدؠ سٲری اسرائیلی وٲتؠ واپس جِلجالؔ کِس پڑاوس پٮ۪ٹھ۔
\v 16 پانٛژوے اموریؔ بادشاہ ژٔلؠ لٔٹھؠ ہٲوِتھ تہٕ ژھٲرٕکھ چھپَن جاے مقیدہؔ شہرکِس أکِس گۅپھہِ منٛز۔
\v 17 کٔمؠ تام واتنٲو یہِ شیٚچھ یسوعسؔ نِش، "اسہِ وُچھ، تِم پانٛژھ بادشاہ پانہٕ مقیدہؔ چہِ گۅپھِ منٛز۔
\v 18 یہِ خبر بوزِتھ ووٚن یسوعنؔ پننٮ۪ن لوٗکن، "گٔژھیٚو والیٚو ڈولہٕ کنہِ پل اتھ گۅپھہِ ہنٛدِس گٔلِس پٮ۪ٹھ تہٕ روزیٚو کینٛہہ سِپاہ پہرٕ دِتھ۔
\v 19 ؤنؠ گو باقےسٲری سِپاہ روزؠزیو نہٕ أتی۔ دشمنن لگیٚو پتے۔ یِتہٕ تِمن پننٮ۪ن شہرن کُن ژلنہٕ دِیو۔ تُہنٛد خداوند دِیو توٚہہِ یِمن پٮ۪ٹھ فتح تہٕ غلبہٕ۔
\v 20 یسوعؔ سٕنٛدؠ فوجن کوٚر تی یہِ وننہٕ آکھ۔ تِمو مٲرؠ تقریباً سٲری دشمن اسرائیلی فوجی۔ ؤنؠ گو صرف کینٛہہ دشمن فوجی وٲتؠ یتھٕ تِتھٕ بٔچِتھ پننٮ۪ن شہرن تہِ۔
\v 21 یسوعؔ سٕنٛدؠ فوجی وٲتؠ امہِ پتہٕ یسوعسؔ نِش واپس۔ سُہ اوس وُنہٕ مقیدہؔ کِس پڑاوس پیٚٹھےٕ۔ امہِ پتہٕ وۅتھ نہٕ کٲنٛسہِ تارےٕ اسرائیلی فوجس خلاف۔
\v 22 امہِ پتہٕ دیُت یسوعنؔ حکم، "تُلیٚو اتھ گۅپھہِ گٔلِس یِم دولہٕ کنہِ پل تہٕ کٔڑِتھ انؠ ووکھ تِم پانٛژوے بادشاہ مےٚ نِش۔
\v 23 سِپہَو أنؠ تِم پٲنژٛھ گۅپھہِ منٛز ژامٕتؠ بادشاہ یروشلم، حبرون، یرموتؔ، لکِیسؔ تہٕ عجلُون شہرن ہنٛدؠ بادشاہ نٮ۪بر کٔڑِتھ۔
\v 24 ییٚلہِ یِم بادشاہ أنِکھ تہٕ زمیٖنہِ پٮ۪ٹھ دراز دِتھ تھٲوِکھ، یسوعنؔ أنؠ پنٕنؠ سٲری سِپاہ ناد دِتھ تہٕ ووٚنُن فوجی عہدٕدارن، "ؤلِو تہٕ رٔٹیٚو یِمن بادشاہن ہنٛزٕ گردنہٕ پننٮ۪ن کھۅرن تل" عہدٕ دارو کوٚر یی۔
\v 25 امہِ پتہٕ ووننکھ یسوعنؔ، "پننس کٲنٛسہِ دُشمنس مٕہ کھوژیو۔ نَہ مٕہ ہٲرِو حوصلہٕ۔ بہادُر تہٕ ہٮ۪متہٕ وٲلؠ بٔنیٚو۔ خداوند کرِ تِمن دُشمنن ستؠ یی یِمن ستؠ توٚہہِ لڈُن پیٚیہِ۔
\v 26 امہِ پتہٕ کٔرؠ یِم پانٛژوے بادشاہ یسوعنؔ پننہِ تلوارِ سٟتؠ قتل۔ تہٕ تہنٛدؠ جسم تراوِنؠ پانٛژن کُلین اویزان۔ آفتاب لوسنس تام تراوٮ۪ن تہنٛزٕ لاشہِ اویزان۔
\v 27 آفتاب لوسہٕ وُن ووٚنُن پننٮ۪ن سِپہن یِمہٕ لاشہِ ترودِ والنہٕ باپتھ تہٕ یِمہٕ تٔتھؠ گۅپھِ منٛز دٲرِتھ دِنہٕ باپتھ یتہِ تِم بادشاہ ژور بیٹھمٕتؠ ٲسؠ۔ سِپہو کوٚر یی۔ امہِ پتہٕ تھٲوِکھ گۅپھِ گٔلِس بیٚیہِ پل دولہٕ۔ ازتام چھِ یِمن بادشاہن ہنٛدؠ کرنٛز أتی گۅپھِ منٛز۔
\v 28 یِتھَے پٲٹھؠ اوٚن یسوعنؔ مقیدہؔ شہر تہِ حملہٕ کٔرِتھ اتھس منٛز۔ تِمو مور اتیُک بادشاہ ہٮ۪تھ باقی سٲری لوٗکھ تہِ۔ تِمو تروو نہٕ اکھ زِنٛدٕ زُو تہِ پتھ کُن۔ تِمو کوٚر اتکِس بادشاہس سٟتؠ تہِ تی یہِ تِمو یریحُو کِس بادشاہس سٟتؠ کوٚرمُت اوس۔
\v 29 امہِ پتہٕ دراو یسوعؔ پنُن اسرائیلی لشکر ہٮ۪تھ مقیدہؔ کِس جنوب شہرس کُن تہٕ کوٚرُکھ لبناہؔ شہرس پٮ۪ٹھ حملہٕ۔
\v 30 خداوندن بنٲوؠ اسرائیلی اتھ قٲبل زِ تِم انُن یہِ شہر تہٕ اتیُک بادشاہ تلفس تل۔ یسوعن مٲرؠ اتِکؠ سٲری لوٗکھ تہٕ باقی زِنٛدٕ زُو۔ تٔمؠ تروو نَہ اتیُک اکھ فرد تہِ زِنٛدٕ۔ امہِ لبناہؔ شہرُک بادشاہ تہِ مورُن یریحُو شہرکِس رزٕ سٕنٛدؠ پٲٹھؠ۔
\v 31 یسوعؔ تہٕ أمؠ سُنٛد فوج دراو لبناہؔ پٮ۪ٹھٕ جنوبس منٛز لکِیسؔ شہرس کُن۔ اتھ شہرس ترووُن گیرٕ تہٕ لٲجٕن اتھ خلاف لڈایہ
\v 32 دوٚیمہِ دوٚہہ بخُش یہِ شہر خداوندن اسرائیل ین تہٕ تِمو لوٚب فتح۔ اتھ منٛز یِتہِ اوس سُہ کوٚرُکھ بُرباد۔ اتِکؠ لوٗکھ ہٮ۪تھ۔ لکیسسؔ تہِ کوٚر تٔمؠ تی یہِ لبناہؔ شہرس کوٚرُن۔
\v 33 جزرُکؔ بادشاہ ہُورمؔ آو پنُن فوج ہٮ۪تھ لکیسؔ کِس فوجس مدتس مگر یسوعؔ سٕنٛدؠ فوجن دیُت ہُورم تہٕ تمسنٛدِس فوجس شِکس، تروو نہٕ تِمو منٛزٕ اکھ تہِ پتھ کُن زِنٛدٕ۔
\v 34 امہِ پتہٕ دراو یسوعؔ لکیسؔ کِس مغربس منٛز عجلُونؔ شہرس کُن۔ تِمو تروو اتھ گیرٕ تہٕ کوٚرہس حملہٕ۔
\v 35 امی دوٚہہ لٔب تِمو شہرس پٮ۪ٹھ فتح تہٕ مٲرِکھ سٲری یہِ زن یِمو لکیسؔ شہرس منٛز کوٚر۔
\v 36 یسوعؔ تہٕ تسُنٛد فوج دراو امہِ پتہٕ عجلُونؔ پٮ۪ٹھٕ حبرونؔ کٮ۪ن بالن کُن تہٕ کوٚرُکھ اتھ خلاف جنگ
\v 37 تہٕ زیونُکھ یہِ شہر تہِ۔ عجلُونؔ شہرٕکؠ پٲٹھؠ کوٚرُکھ اتیُک بادشاہ ہٮ۪تھ اتھ شہرس ڈُبہٕ ڈاس۔ اکھ زوٚن تہِ ترووُکھ نہٕ ناو ہٮ۪نہٕ باپتھ زِنٛدٕ۔
\v 38 امہِ پتہٕ پھیور یسوعؔ پنُن فوج ہٮ۪تھ سیٚودے دبِیرؔ شہر کُن تہٕ لوگُکھ اتھ خلاف جنگ۔
\v 39 شہر تہٕ اتیُک بادشاہ اوٚنُکھ قبضس منٛز سٟتؠ أنِکھ انٛدؠ پٔکِکؠ کینٛہہ گام تہِ۔ امہِ پتہٕ ترووُکھ نہٕ کانٛہہ تہِ زِنٛدٕ زُو مارنہٕ روٚس۔ ناو ہٮ۪نس لایق تہِ نہٕ کانٛہہ زِنٛدٕ پتھ کُن۔ اتھ شہرس تہِ گُدرووُکھ تی یہِ حبرونؔ تہٕ لبناہؔ شہرس گُدرووُکھ
\v 40 امی آنہٕ تہٕ انمانہٕ کوٚر یسوعنؔ تہٕ تسٕنٛدؠ فوجن سورےٕ جنوبی کنعان زیر۔ تِمو ہارنٲوؠ اتِکؠ بادشاہ یِم راجت کران ٲسؠ پہٲڑے علاقن، جنوبی نجب کٮ۪ن صحراون، مغرب کیٚن بالہٕ دمٕنؠ علاقن تہٕ سٔنوٲرؠ علاقن پٮ۪ٹھ تہٕ پننس خداوند سنٛدِ حکمہٕ مطٲبق مٲرِکھ یِمن علاقن ہنٛدؠ سٲری زٕنٛدٕ زُو۔
\v 41 یسوعؔ سٕنٛدؠ فوجن کٔرؠ قادِس برنِیع پٮ۪ٹھٕ غزہؔ تام تہٕ جشن کہِ تمام علاقہٕ پٮ۪ٹھٕ جِبعونؔ تام سٲری لوٗکھ۔
\v 42 چونکہِ خداوند اوس پانہٕ اسرائیل ین سٟتؠ سٟتؠ۔ تِمو کٔرؠ اکسےٕ حملس منٛز زیر یِم سٲری بادشاہ تہٕ تہنٛدؠ علاقہٕ۔
\v 43 امہِ پتہٕ پھیور یسوعؔ پنُن فوج ہٮ۪تھ واپس تہٕ ووت پننِس جِلجالؔ کِس پڑاوس پٮ۪ٹھ۔
\c 11
\p
\v 1 ییٚلہِ حصورکؠؔ بادشاہ یابیننؔ تہِ سورےٕ بوز یِمن سارنےٕ چیزن متعلق یہِ سپدیاو تٔمؠ سوز مدونؔ کِس بادشاہ یُوبابؔ، سِمروؔن کِس بادشاہس تہٕ اکشاؔف کِس بادشاہس پٲغام تہٕ کوٚرنکھ تُہنٛد فوج مدتہٕ خٲطرٕ سوزنہٕ باپتھ عرض تاکہِ تِم کرن تِمن اسرائیل ین خلاف جنگس منٛز مدد کٔرِتھ۔\f + \fr 11‏:1 \ft حصور چُھ جلعالس منٛز تقریبن پنداہ کلو میٹر شمال طرفہٕ جلعال جھیل کِس شمالس کُن۔\f*
\v 2 تٔمؠ سوز شمٲلی کوٚہستٲنی بادشاہن تہِ پٲغام بیٚیہِ نشیب کہِ مٲدٲنی علاقہٕ کٮ۪ن بادشاہن، سمندر جنوبہٕ پاسہٕ تہِ ملکہٕ بونمہِ پاسہٕ۔ تٔمؠ سوز مغرب کہِ بلند ملک دورؔ کہِ رازس تہِ پٲغام۔\f + \fr 11‏:2 \ft جلعال جھیل\f*
\v 3 کنعانِؠؔ رازن دوٚشوٕنؠ مشرق تہٕ مغرب، اموریؔ، حِتیو، فِرزی تہٕ بیٚیہِ یبوسینؔ یِ کوٚہستٲنؠ ملکس منٛز رودؠ، تہٕ بیٚیہِ حوی مونٹ حرمون مِصفاہؔ کِس حِصس منٛز۔
\v 4 تِمن سارنےٕ رازن ہُنٛد فوج سمیاو یِکہٕ وٹہٕ۔ تہنٛدؠ نفر ٲسؠ تیٖتیا زن أسؠ سمندر بٹھِکؠ سیٚکہِ ڈھیر۔ تِم آے گُرٮ۪ن تہٕ رتھن سان واریہس تعدادس منٛز۔
\v 5 تِم سٲری بادشاہ سمکھے أکِس مقرر وقتس پٮ۪ٹھ تہٕ تھووُکھ پنُن فوج میرُومؔ نٲوؠ جِھیلس پٮ۪ٹھ أکِس کمپس منٛز تیار اسرائیل ین سٟتؠ لڑنہٕ باپتھ۔
\v 6 پتہٕ ووٚن خداوندن یسوعسؔ، "تِمن مٕہ کھوٚژ، تکیازِ صُبحس یمے وقتہٕ بہٕ دمِکھَے تِم ژےٚ۔ ژٕ ہارناوہِکھ تِم تہٕ مارہَکھ سٲری۔ پتہٕ پزنے ژےٚ تہنٛدؠ سٲری گُرؠ لنٛگؠ کرٕنؠ تہٕ زالٕنؠ تہنٛدؠ سٲری رتھ نارس منٛز۔
\v 7 لہٰذا آے یسوعؔ تہٕ تمسُنٛد فوج میرُومؔ تِمن پٮ۪ٹھ ہٲوی گژھنہٕ باپتھ تہٕ کوٚرُکھ دشمنن پٮ۪ٹھ آگٲہی ورٲے حملہٕ۔
\v 8 خداوندن کٔرؠ تِم اسرائیل ین ہنٛدس قبضس منٛز۔ تِمو کوٚر تُہنٛد شکار شہر صیداؔ، مِسرفات المائِمؔ تہٕ اور مشرقس منٛز مِصفاہؔ تام۔ تِمو کوٚر تِمن پٮ۪ٹھ تۅتام حملہٕ یبوٚتام نہٕ تِم سٲری مٲرِکھ۔
\v 9 پتہٕ کوٚر یسوعنؔ تہٕ یہِ خداوندن تٕن کرنہٕ خٲطرٕ ووٚن۔ تٔمؠ کٔرؠ دُشمنن ہنٛدؠ گُرؠ لنٛگؠ تہٕ زٲلِنؠ تہنٛدؠ رتھ نارس منٛز۔
\v 10 یسوعؔ تہٕ تمسُنٛد فوج وٲتؠ شہر حصوُر واپس تہٕ کوٚرُکھ گیرٕ، تہٕ مورُکھ تُہنٛد بادشاہ۔ ساروٕے سلطنتو منٛز اوس حصور تِمو شہرو منٛز اکھ اہم شہر یِمو اسرائیلس خلاف لوٚڈ۔
\v 11 حصورسؔ منٛز یِتہِ اوس تِمو کوٚر تہِ سورےٕ بُرباد، تہٕ پتہٕ زولُکھ شہر تہٕ بنووہس سوٗر
\v 12 یسوعؔ سٕنٛدؠ فوجن کوٚر تِمن سارِنےٕ شہرن گیرٕ تہٕ مٲرِکھ تہنٛدؠ سٲری بادشاہ۔ تِمو کوٚر تی یہِ موسیٰؔ ہن یمؠ خداوند سنٛز خوب خدمت کٔر تِمن حکم دیُت کرنہٕ خٲطرٕ۔
\v 13 یسوعؔ سٕنٛدیو نفرو زول حصور، مگر تِمو زول نہٕ باقی کانٛہہ شہر یِم ٹینگن پٮ۪ٹھ بنِتھ تہٕ دیوار سٟتؠ گٔنٛڈِتھ ٲسؠ۔
\v 14 اسرائیلیٚو نی پانس خٲطرٕ چاروٲے یِم تِمو کھہَن منٛز وُچھ تہٕ بیٚیہِ تمام قٟمتی چیز۔ مگر شہرن منٛز مٲرؠ تِمو تمام انسان تہٕ تمام جاندار چیز۔
\v 15 یتھٕ پٲٹھؠ خداوندن موسیٰؔ ہس حکم اوس دیُتمُت کرنہٕ خٲطرٕ، تِتھے پٲٹھؠ دیُت موسیٰؔ ہن یسوعسؔ تہِ۔ تہٕ یسوعنؔ کوٚر تہِ سورےٕ یہِ خداوندن موسیٰؔ ہس حکم دیُت کرنہٕ خٲطرٕ۔
\v 16 یسوعؔ سٕنٛدؠ فوجن ہارنٲوؠ تمام لوٗکھ یِم اتھ زمیٖنہِ پٮ۪ٹھ روزان ٲسؠ۔ تِمو کوٚر کوٚہستٲنی ملک تہٕ جنوبی یہُوداؔ کِس صحراوس، جشن کِس سٲرؠ سےٕ علاقس، جنوبی علاقہٕ تہٕ مٲدٲنی یردن کٮ۪ن علاقن پٮ۪ٹھ قبضہٕ۔ تِمو کوٚر اسرائیل کٮ۪ن تمام پہاڑن تہٕ پہاڑس نزدیک تمام نشیبی علاقن پٮ۪ٹھ قبضہٕ۔
\v 17 تِمو کوٚر عدومؔ کِس جنوبس منٛز کوہِ حلق پٮ۪ٹھٕ شمالس منٛز لبنانؔ علاقس نزدیک وادی منٛز بلعالؔ تام کوہِ حرمونس نزدیک تمام زمینہِ پٮ۪ٹھ قبضہٕ۔ تِمو رٔٹؠ امہِ علاقٕکؠ تمام بادشاہ تہٕ مٲرکھ۔
\v 18 یسوعؔ سٕنٛدیو نفرو لوٚڈ تِمن سارِنےٕ رازن خلاف واریہس وقتس تام
\v 19 اتہِ اوس اکُے شہر یِمؠ اسرائیل ین سٟتؠ امنُک معاہدٕ کوٚر۔ تِم لوٗکھ ٲسؠ حویکؠ یِم جِبعونسؔ منٛز روزان ٲسؠ۔ اسرائیلیٚو کوٚر باقے تمام شہرن پٮ۪ٹھ قبضہٕ۔
\v 20 خداوندن بنٲوؠ تِمو سارِوےٕ جمٲژو منٛزٕ لوٗکھ سختی ہنٛدؠ بٲعِث۔ یمکہِ وجہ سٟتؠ تٔمؠ اسرائیلی فوجس خلاف لوٚڈ۔ تہٕ امہِ خٲطرٕ کوٚر خداین تِم تباہ کرنہٕ خٲطرٕ اسرائیلی فوجُک استعمال۔ خداین رُکیوو نہٕ اسرائیلی فوج دشمنن مکمل تباہ کرنہٕ نِشہ۔ یہِ چُھ تی یہِ خداوند موسیٰؔ ہس حکم دیُت کرنہٕ خٲطرٕ۔
\v 21 یسوعؔ سٕنٛدؠ فوجن لوٚڈ عناقؠ دیون سٟتؠ تہِ یِم حبرونؔ، دبِیر تہٕ عناہؔ کٮ۪ن نزدیکی کوٚہِستانن منٛز روزان ٲسؠ۔ تِمو لوٚڈ تِمن لوٗکن سٟتؠ تہِ یِم یہُوداؔ تہٕ اسرائیل کٮ۪ن کوٚہستٲنؠ علاقن منٛز روزان ٲسؠ تہٕ تِمو مٲرؠ تِم تمام لوٗکھ تہٕ کٔرِتھ تہنٛدؠ شہر تباہ۔\f + \fr 11‏:21 \ft یسوع سنٛدِ ذریعہ ختم گژھن وول دیوانن ہنٛدِس نسلس چُھ اناکیمؠؔ وننہٕ یوان، یعنی انک سنٛدؠ اولاد، گرینٛد 13:33، اِستِثنا: 2:10-11۔\f*
\v 22 نتیجتاً اوس نہٕ عناقسؔ کانٛہہ تہِ اولاد یُس اسرائیلس منٛز زندٕ رود۔ صرف رودؠ غزہؔ، جاتؔ تہٕ اشدودسؔ منٛز کینٛہہ زِنٛدٕ۔
\v 23 یسوعؔ سٕنٛدؠ فوجن کوٚر سٲرؠ سےٕ زمینہِ پٮ۪ٹھ قبضہٕ، یتھٕ پٲٹھؠ خداوندن واریاہ کال برونٛہہ موسیٰؔ ہس ووٚنمُت اوس۔ خداوندن دِژ یہِ زمین اسرائیل ین، تکیازِ تٔمؠ اوس تِمن سٟتؠ وعدہ کوٚرمُت۔ پتہٕ بٲگراو یسوعنؔ زمین اسرائیلی قبیلن منٛز۔ تہٕ امہِ پتہٕ گو مُلکس منٛز امن قٲیِم۔
\c 12
\p
\v 1 اسرائیلی لوٗکو کوٚر تتھ زمیٖنہِ پٮ۪ٹھ قبضہٕ یۅسہ یردن دریاو کِس مشرقس منٛز جنوبس منز دریائے ارنونؔ چہِ گھاٹی پٮ۪ٹھٕ شمالس منٛز کوہ حرمون تام، یردنس سٟتؠ میدانکہِ مشرقہٕ طرفہٕ زمین ٲس۔
\v 2 سِیحوُنؔ اوس امورؠؔ ین ہُنٛد بادشاہ۔ سُہ اوس حسبونؔس منٛز روزان تہٕ کوٚرُن عروعیرؔ قصبہٕ پٮ۪ٹھٕ دریائے ارنونؔ چہِ گھاٹی سٲتؠ سٲتؠ شمالس منٛز دریائے یبوقسؔ تام راج۔ تٔمؠ سنٛز زمین گییہِ گھاٹی منٛزؠ شروع یۅسہ تمہِ سنٛزِ زمیٖنہِ تہٕ عمونینؔ ہنٛزِ زمیٖنہِ درمیان سرحد اوس۔ سیحوننؔ تہِ کوٚر جلعادؔ سٕنٛدِس نیصف علاقس پٮ۪ٹھ راج۔
\v 3 سیحوننؔ کوٚر یردنس سٲتؠ سٲتؠ مشرقی مٲدانس منٛز گلیلؔ کہِ سمندر پٮ۪ٹھٕ بحیرہ مردار تام زمینہِ پٮ۪ٹھ تہِ راج۔ أمؠ کوٚر بحیرہ مردارؔ کِس مشرقس منٛز بیت یسیموتؔ پٮ۪ٹھٕ پِسگہ کوہس تام تہِ راج۔
\v 4 دویِم بادشاہ یمِس اسرائیلی فوجن شِکس دیُت، سُہ اوس بسن علاقُک بادشاہ عوجؔ۔ سُہ اوس رفایم کیو دیو قامت لوٗکن ہنٛدیو اولادو منٛزٕ ٲخری نفر۔ سُہ اوس عستارات تہٕ ادرعیؔ شہرن منٛز روزان۔
\v 5 تٔمؠ کوٚر شمالس منٛز کوہہِ حرمونؔ تہٕ سلقہؔ قصبہٕ پٮ۪ٹھٕ مشرقس منٛز سارِنےٕ بسنؔ پٮ۪ٹھ تہٕ مغربس منٛز جسُورؔ تہٕ معکاتنؔ ہنٛدٮ۪ن سرحدن تام راج۔ عوجنؔ کۅر جلعادؔ کِس نیصف حِصس پٮ۪ٹھ راج، یوٚت تام ملکہٕ کِس سرحدس تام حسبونٕکؠ بادشاہ سیحوننؔ راج کوٚر۔
\v 6 موسیٰؔ، یمؠ خداوند سنٛز وفادٲری کٔر تہٕ سارے اسرائیلی فوجن اوس تِمن رازن ہُنٛد فوج ہارنوومُت۔ پتہٕ دِژ موسیٰؔ ہن سۅ زمیٖن روبنؔ تہٕ جدؔ کٮ۪ن قبیلن تہٕ منسیؔ سٕنٛدِس أڈِس قبیلس۔\f + \fr 12‏:6 \ft یشوع 13:8-32\f*
\v 7 یسوعؔ تہٕ اسرائیلی فوجن ہارنٲوؠ تِم بادشاہ یِم دریائے یردن کہِ مغربی بٹھِ چہِ زمینہِ پٮ۪ٹھ راج ٲسؠ کران۔ سۅ زمین ٲس لبنانسؔ نزدیک وادی منٛز بعلؔ جدس درمیان کوہ ہلاکس تام یۅسہ عدومؔ گژھان ٲس۔ یسوعنؔ دِژ اسرائیل کٮ۪ن خاندانن زمین تاکہِ تِم کرن اتھ پٮ۪ٹھ قبضہ۔
\v 8 کوٚہستٲنؠ ملک، نشیبی علاقہٕ، یردن بٔٹھؠ بٔٹھؠ مٲدان، کوٚہ دامٕنؠ، بیاباننؔ تہٕ خدایہِ سنٛدٮ۪ن بیاباننؔ منٛز، حِتی، امورؠؔ، کنعٲنؠؔ، فِرزی، حوی اور یبوسیینؔ ہُنٛد ملک۔
\v 9 اسرائیل یو یِم بادشاہ زینؠ یا فتح کٔرؠ تِم ٲسؠ یِمن شہرن ہنٛدؠ یرِیحُو، عی یِم بیت ایلؔ نزدیک ٲسؠ،
\v 10 یروشلم، حبرونؔ،
\v 11 یرموتؔ، لکِیسؔ،
\v 12 عجلُون، جزرؔ،
\v 13 دبِیرؔ، جدرؔ
\v 14 حُرمہؔ، عرادؔ،
\v 15 لبناہؔ، عدُلام،
\v 16 مقیدہؔ، بیت ایلؔ،
\v 17 تفُوحؔ، حفرؔ،
\v 18 افِیقؔ، لشروؔن،
\v 19 مدونؔ، حصور،
\v 20 سِمرون مرونؔ، اکشاؔف،
\v 21 تعانکؔ، مجِدوؔ
\v 22 قادِسؔ، کرملؔ یقنِعام،
\v 23 دور مُرتفعؔ علاقُک دورؔ، گلگلؔ علاقس منٛز گوئمؔ،
\v 24 تہٕ تِرضہؔ۔ یِم ٲسؠ کُل اکترٕہ بادشاہ یِم اسرائیلی فوجن ہارنٲوؠ۔
\c 13
\p
\v 1 ییٚلہِ یسوعؔ بُڈٕ گو تہٕ خداوندن ووٚن تمِس، "یسوعؔ، ؤنؠ چُھکھ ژٕ بُڈٕ گومُت، مگر وُنہِ چھےٚ چٲنِس فوجس واریاہ زمین قبضہٕ کرنہٕ خٲطرٕ۔
\v 2 تِمن زمینن ہُنٛد فہرست چُھ یِتھٕ کِنؠ: فلستینینؔ ہُنٛد علاقہٕ تہٕ سُہ جسُورؔ ین ہُنٛد سورےٕ علاقہٕ۔
\v 3 شیحورؔ پٮ۪ٹھٕ، یُس مِصر کِس مشرقس منٛز واقع چُھ، تہٕ شمالس منٛز عقرونؔ تام، کنعانینؔ ہُنٛد علاقہ؛ فلستینٮ۪نؔ ہنٛدؠ شہر غزہؔ، اشدودؔ، اشکلونؔ، جات تہٕ عقرونؔ کہِ پانٛژوٕنی عوی ین ہُنٛد علاقہٕ۔
\v 4 جنوبس منٛز پزیو توٚہہِ وُنہِ تہِ یِمن علاقن پٮ۪ٹھ قبضہٕ کرُن ییٚتہِ کنعانٕکؠؔ لوٗکھ روزان چھِ۔ تہٕ عراہؔ یُس صیدونینؔ ہُنٛد چُھ افیکؔ پٮ۪ٹھٕ، اموریؔ سرحدس تام۔
\v 5 جبلین ہنٛز زمین، تمام لبنانؔ، مشرق طرفہٕ، حرمون کوہ بوٚنمہِ طرفہٕ بعلؔ جدؔ پٮ۪ٹھٕ لبو حماتسؔ تام۔
\v 6 تِم لوٗکھ چھِ وُنہِ رٹہٕ نےَ یِم لبنان مِسرفات المائِمؔ تام کوہساتانی علاقن منٛز روزان چھِ۔ صیداؔ شہرکؠ تمام لوٗکھ ہٮ۪تھ۔ بہٕ کڑکھ یِم چانہِ فوجہٕ برونٛہہ کِنؠ۔ ییٚلہِ ژٕ یِمن منٛز زمیٖن بٲگراوکھ تہٕ سُہ علاقہ دِیہ زِ اسرائیل کٮ۪ن لوٗکن ضروٗر۔ یُس زن مےٚ ژےٚ حکم چُھمے دیُتمُت کرنہٕ خٲطرٕ۔
\v 7 "سۅ سٲرےٕ زمین بٲگراو نون خاندانن تہٕ منسیؔ کِس أڈِس خاندانس منٛز میراث رٔنٛگؠ۔"
\v 8 منسیؔ کِس أڈِس خاندانس سٟتؠ کٔر روبنیوؔ تہٕ جدیوؔ تہِ پنٕنؠ ملکِیت حٲصِل، کیازِ کہِ موسیٰؔ ہن، یُس خداوند سنٛز بےٚ وایہِ خدمت اوس کران ٲس گۅڈَے دریائے یردن کہِ مشرق طرفچ زمین تِمن دِژمٕژ۔
\v 9 عروعیرؔ پیٚٹھٕچ یہِ زمین یۅسہ ارنونؔ وادی بٔٹھِس پٮ۪ٹھ چھےٚ تتھ شہرس سان یُس وادی منٛزباگ واقع چُھ پٮ۪ٹھٕ مدیباؔ کہِ سارے سطح مرتفعؔ تام پھٔہلِتھ ٲس تہٕ دیبون شہر تام پھٔہلِتھ ٲس۔
\v 10 یِمن علاقن منٛز ٲسؠ امورٕکؠؔ بادشاہ سیحونؔ سٕنٛدؠ شہر تہِ شٲمل۔ یُس حسبونسؔ پٮ۪ٹھ راج اوس کران تہٕ تِم ٲسؠ عمونیؔ سرحدن تام پھٔہلِتھ۔
\v 11 جِلعادؔ تہٕ جسُورؔ ین تہٕ معکاتنؔ ہُنٛد علاقہٕ بشمول سٲری کوہِ حرمونؔ تہٕ بسنُک سورےٕ علاقہٕ یُس سلقہؔ شہر تام پھٔلِتھ چُھ۔
\v 12 بسنؔ علاقس منٛز عوجچ سٲرےٕ بادشاہ دٲری، یمؠ عستارات تہٕ ادرعیؔ کٮ۪ن شہرن منٛز راج کوٚر یِم چھِ تِمے یِم رفایم منٛزٕ باقی بچیمٕتؠ ٲسؠ۔ یِم لوٗکھ ژلرٲوؠ موسیٰؔ تلوارِ سٟتؠ حملہٕ کٔرِتھ۔
\v 13 مگر اسرائیل یو ژھٕنؠ نہٕ جسُورؔ تہٕ معکاتی کنعانہٕ زبردستی کٔڈِتھ۔ امہِ بجایہ چھِ یِم لوٗکھ موجودٕ وقتس منٛز تہِ اسرائیل ین سٟتؠ روزان۔
\v 14 لٲویٚن میجؠ نہٕ زمیٖنہِ ہنٛز کانٛہہ کٲم۔ سُہ اوس واحد خاندان یِمن نہٕ زمین میجؠ۔ موسیٰؔ ہَن دیُت نہٕ تِمن کانٛہہ تہِ چیٖز۔ اسرائیل ین ہنٛدؠ خداوندن ووٚن تِم زِ تمسنٛدِ خٲطرٕ یِم قربٲنی پیش یِن کرنہٕ تِم آسن تہنٛدِ خٲطرٕملکیت۔
\v 15 موسیٰؔ ہن ٲس رُوبِن کٮِس پرٮ۪تھ خاندانس زمین دِژمٕژ۔
\v 16 یتھٕ پٲٹھؠ اوس تُہنٛد علاقہٕ عروعیرؔ تام پھپٔلیومُت یُس ارنونؔ دریاوٕ چہِ وادی ہنٛدِس بٔٹھِس پٮ۪ٹھ چُھ۔ تہٕ سُہ شہر یُس وادی منٛزباگ چُھ تہٕ تتھ منٛز چُھ مدیباہسؔ نزدیک تٔھدؠ مٲدٲنی علاقہٕ تہِ شٲمل۔
\v 17 اتھ منٛز چھِ حسبونؔ تہٕ امِکؠ سٲری شہر تہِ شٲمل یِم پلیٹو وسؔ منٛز چھِ۔ یِمن منٛز دیبونؔ، بامات بعلؔ تہٕ بیت بعلؔ میونؔ تہِ شٲمل چھِ۔
\v 18 تہٕ یحزؔ، کدیموتؔ، تہٕ مفاتؔ،
\v 19 تہٕ قریتؔ یائمؔ، تہٕ سبمہؔ تہٕ زارتؔ شہر یُس وادی منٛز أکِس کوہس پٮ۪ٹھ چُھم۔
\v 20 اتھ علاقس منٛز چھِ بیت فعورؔ، کوہ پِسگہ ہٕکؠ ڈھلوانؔ، بیت یسیموتؔ،
\v 21 پلیٹووسؔ سٟتؠ واقع سٲری شہر تہٕ امورؠؔ ین ہنٛدؠ بادشاہ سیحونُک سورےٕ رازُت تہِ شٲمل یمؠ تتہِ حسبونسؔ منٛز راج اوس کوٚرمُت، یۅسہ موسیٰؔ ہن کٔر۔ مِدیان کٮ۪ن زِٹھٮ۪ن سٲتؠ ہورُن یِم سیحونٕکؠ بادشاہ عویؔ، رقمؔ، صُورؔ، حورؔ تہٕ ربعؔ ٲسؠ یِم تتہِ راج ٲسؠ کران۔
\v 22 اسرائیل یو مور بعورؔ سُنٛد نیٚچو بلعامؔ تلوارِ سٟتؠ، یُس پیشن گویی کران اوس۔ اسرائیل یو مٲرؠ باقی لوٗکھ تہِ تلوارِ سٟتؠ۔
\v 23 روبن خاندان کٮ۪ن کوٗکن ہُند سرحد چُھ دریائے یردن۔ یہِ اوس سُہ میراث یُس روبن کٮ۪ن کوٗکن دِتمُت اوسُکھ۔ تہٕ ٲسٕکھ تہنٛدٮ۪ن سارِنےٕ خاندانن دِژمٕژ۔ تِم رودؠ تتہِ پننٮ۪ن شہرن تہٕ گامن منٛز۔
\v 24 موسیٰؔ ہن دِژ جد کٮ۪ن خاندانن، جادکٮ۪ن لوٗکن تہِ زمین، تہٕ یہنٛدٮ۪ن خاندانن منٛز دِژٕکھ سۅ زمین پرٮ۪تھ کٲنٛسہِ یتھ پٮ۪ٹھ تِمن روزنٕچ ضرورت ٲس۔
\v 25 تِم ٲسؠ روزان یعزیرؔ س نکھہٕ جلعاد کٮ۪ن سارنےٕ شہرن منٛز تہٕ نیصف ملکس منٛز ییٚتہِ عمونیؔ روزان ٲسؠ، عروعیرؔ تام یُس ربہؔ کہِ مشرقس منٛز اکھ شہر چُھ۔
\v 26 تہنٛز زمیٖن ٲس حسبونؔ پٮ۪ٹھٕ رامت المصفاہؔ تہٕ بطُونیم تام پھٔلِتھ، محنایمؔ تہٕ دبِیرؔ علاقس تام۔
\v 27 تہنٛز زمین تہِ ٲس وادی منٛز: بیت حرم بیت نمرہؔ تہٕ سُکات تہٕ صفون یعنی حسبوؔنُک بادشاہ سیحون یُس حسبونُک بادشاہ اوس۔ تٔمؠ سُنٛد راج اوس دریائے یردنس متصل تہٕ دریائے یردن کہِ مشرقہٕ طرفہٕ بحیرہ گلیل کِس بونہِ مِس حِصس تام پھٔہلِتھ۔
\v 28 یہِ چُھ جد کٮ۪ن لوٗکن ہُنٛد میراث یُس تِمن دیُتمُکھ اوسُکھ تہنٛدٮ۪ن خاندانن ہنٛزِ ضرورٔژ مطٲبق شہرن تہٕ گامن سان یٚتہِ تِم روزان ٲسؠ۔
\v 29 موسیٰؔ ہن دِژ نیصف خاندانس زمین روزنہٕ باپتھ میراث رنگؠ۔ یہِ دِتُکھ منسیؔ کِس أڈِس خاندانس تہنٛزٕ و ضرورژو مطٲبق۔
\v 30 تُہنٛد علاقہٕ اوس محنایمؔ تام، بشمول بسنُک سورےٕ علاقہٕ، بسنکِس بادشاہ عوجؔ سنٛز سٲرےٕ سلطنت تہٕ یائیرٕکؠؔ تمام سٲری شہر یِ بسنس منٛز چھِ۔ اتھ علاقس منٛز ٲسؠ شیٹھ شہر۔
\v 31 اہنٛزِ زمیٖنہِ منٛز اوس جلعادُکؔ اوٚڈ علاقہٕ تہِ شٲمل تہٕ سٟتؠ عستارات تہٕ ادرئیکؠ شہر، کُنہِ کُنہِ ساعتہٕ ٲسؠ یِمن بسنس منٛز عوجِکؠ شٲہی شہر تہِ ونان۔ یِم ٲسِکھ منسیؔ سنٛدِس نیٚچوِس مکیر سنٛدٮ۪ن لوٗکن عطا کٔرؠ مٕتؠ، تہٕ اتھ منٛز ٲسؠ مکِیر سنٛدؠ أڈؠ اولاد شٲمل، یِم اہنٛدِ ضروٗرژٕ مطٲبق پننٮ۪ن خاندانن خٲطرٕ مقرر ٲسِکھ کٔرمٕتؠ۔
\v 32 یہِم آسہ تِم زمیٖنہٕ یِم موسیٰؔ ہن اسرائیل ین موآبؔ کِس مٲدانس منٛز بٲگراوِ، ییٚلہِ تِم بلکل یریحوؔ کِس مشرقس منٛز یردن اپارِ ٲسؠ۔
\v 33 مگر لاوی سٕنٛدِس خاندانس دیُت نہٕ موسیٰؔ ہن کانٛہہ میراث۔ یہُوواہؔ، یُس اسرائیل ین ہُنٛد خدا چُھ، کوٚر یِمن سٟتؠ وعدہ زِ سُہ آسہ یہُنٛد میراث۔
\c 14
\p
\v 1 سارنے کاہنن ہنٛدؠ زِٹھؠ، الِیعزرؔ، یسوعؔ تہٕ بہَن خاندانن ہنٛدیٚو قٲعِدو کوٚر یہِ فٲصلہٕ زِ کنعانس منٛز پٮرٮ۪تھ اسرائیلی خاندانس کۅس زمین دِمو۔\f + \fr 14‏:1 \ft اعمال 13:19\f*
\v 2 یہِ کٲم ٲس ساڈَو نوو خاندانو منٛزٕ پرٮ۪تھ کٲنٛسہِ خٲطرٕ چیٖرِ ترٲوِتھ دِنہٕ آمٕژ۔ یہِ اوس تِتھَت پٲٹھؠ یتھٕ پٲٹھؠ خداوندن موسیٰؔ ہس کرنہٕ خٲطرٕ حکم اوس دیُتمُت، تاکہِ زمین ییہِ پرٮ۪تھ أکِس خاندانس منٛز تہنٛدٮ۪ن خاندانن دِنہٕ۔
\v 3‏-4 ؤنؠ ٲس موسیٰؔ ہن اسرائیلُک دریاے یردن عبور کرنہٕ برونٛہہ ڈھاین قبیلن مستٮ۪ل پٲٹھؠ زمیٖن دِژمٕژ۔ مگر لٲووین دیُت نہٕ تِمن کانٛہہ میراث۔ کاہنن ہنٛدِ رنگہٕ تہندٮ۪ن فریضن ہنٛدِ وجہہ سببہٕ کوٚرُکھ تِمن سٟتؠ مختلف سلوٗک۔ زمینُک کانٛہہ تہِ حِسہٕ دِتُکھ نہٕ لٲویٚن۔ تاہم، دِتِکھ تِمن روزنہٕ خٲطرٕ شہر، بشمول تہنٛدٮ۪ن چارواین خٲطرٕ چرایہِ تاکہِ تِم سنبالن پنٕنؠ خاندان۔ تہٕ یوسفؔ سُنٛد قوم گو منسیؔ تہٕ افرائیمؔ خاندانن منٛز تقسیم۔
\v 5 اسرائیل یو کوٚر تِتھَت پٲٹھؠ یِتھٕ پٲٹھؠ خداوندن موسیٰؔ ہس کرنہٕ خٲطرٕ حکم اوس دیُتمُت: تِمو دیُت امینہِ ہُنٛد کینٛہہ حصہٕ مستقل ملکیتہٕ طور۔
\v 6 یہُوداؔ سٕنٛدِ خاندان منٛزٕ گے کینٛہہ نفر یسوعسؔ نِش۔ ییٚلہِ سُہ تہٕ سٲری اسرائیلی جِلجالس منٛز ٲسؠ۔ تمن نفرن منٛز اوس یفُنّہؔ سُنٛد نیٚچو کالبؔ تہِ۔ تٔمؠ ووٚن یسوعسؔ، "مےٚ چُھ یقین زِ ژےٚ چھَے سۅ کتھ یاد یۅسہ خداوندن موسیٰؔ ہس ژےٚ تہٕ مےٚ متعلق ٲس فرماومٕژ ییٚلہِ أسؠ قادِس برنِیع ہس منٛز ٲسؠ۔\f + \fr 14‏:6 \ft گرینٛد 14:24\f*
\v 7 بہٕ سوسُس ژتجی وۅہُر تمہِ وزِ۔ موسیٰؔ ہن سوزانس بہٕ، ژٕ تہٕ کینٛہہ باقی نفر قادِس برنِیع پٮ۪ٹھٕ سۅ جاے ژھانٛڈنہٕ باپتھ۔ ییٚلہِ أسؠ واپس آے تہٕ مےٚ دِژ موسیٰؔ ہس پٔزے سۅ خبر یہِ اسہِ وُچھ۔
\v 8 باقی نفر یِم اسہِ سٟتؠ آمٕتؠ ٲسؠ تِمو دیُت رپورٹ یمہِ سٟتؠ لوٗکھ خوفزدٕ گے۔ مگر مےٚ کٔر پوٗرٕ پٲٹھؠ یہُوواہؔ سنٛز پیروی تہٕ پرٮ۪تھ تمہِ چیٖزٕچ کٔرٕم عمل یُس أمؠ اسہِ حکم کرنہٕ خٲطرٕ دیُت۔
\v 9 موسیٰؔ ہن کوٚر مےٚ سٟتؠ وعدہ، "یہِ چُھ اکھ پۅختہٕ وعدہ زِ یتھ مُلکس منٛز توٚہؠ پکان چُھو سُہ سپدِ ہمیشہٕ تُہنٛد تہٕ تُہنٛدٮ۪ن اولادن ہُنٛد۔ بہٕ چُھسو توٚہہِ یہِ امہِ موجُب دِوان تکیازِ توٚہہِ کٔرِو میٲنِس خدایس یہُوواہؔ سنٛزِ پرٮ۪تھ کتھِ ہنٛز عبادت۔\f + \fr 14‏:9 \ft اِستِثنا: 1:36\f*
\v 10 ؤنؠ اوس خداوندن میانہِ خٲطرٕ تہِ کوٚرمُت یہِ تٔمؠ وعدہ اوس کوٚرمُت زِ سُہ کرِ یہِ۔ تنہٕ گے پنٛژتٲجی ؤری یَنہٕ موسیٰؔ ہن یہِ مےٚ ونیاو تتھ وقتس دوران ییٚلہِ أسؠ بیابانن منٛز ٲسؠ۔ تہٕ یتھٕ پٲٹھؠ خداوندن وعدہ اوس کوٚرمُت، تٔمؠ تھووُس بہٕ تتھ وقتس تام زِنٛدٕ تہٕ تندرُست۔ مےٚ کُن وُچھ! میٲنؠ وانٛس چھےٚ پنژشیٖتھ ؤری۔
\v 11 بہٕ چُھس از تہِ تیُتھےٕ مضبوط یُتھ تمہِ دوٚہہ اوسُس ییٚلہِ بہٕ موسیٰؔ ہن یہِ سرِزمین ژھانٛڈنہٕ باپتھ سوزمُت اوسُس۔ مےٚ چُھ از تہِ سُے طاقت یُس طاقت مےٚ جوٲنی منٛز اوس۔ بہٕ ہیٚکہٕ جنگ کٔرِتھ یا ہیٚکہٕ واریاہ دوٗر گٔژھِتھ تہٕ توتہِ چُھس گرٕ یِنُک طاقت تھاوان۔
\v 12 مہربٲنی کٔرِتھ دِیو مےٚ سُہ کوٚہستٲنؠ ملک یمیُک وعدہ خداوندن واریاہ کال برونٛہہ مےٚ سٟتؠ کوٚرمُت اوس۔ تمہِ وزِ بوزُو توٚہہِ میون ونُن زِ عناقیمؔ ٲسؠ تتہِ روزان۔ ژےٚ بوزُتھ میون یہِ ونُن زِ تُہنٛدؠ شہر ٲسؠ بٔڈؠ تہٕ تہنٛدِ رٲچھ خٲطرٕ ٲسؠ تِمن ژوٚشوٕنؠ طرفن دیوار دِتھ۔ مگر ؤنؠ، کرِ شاید خداوند مےٚ مدد کہ ٲسؠ ژلراووکھ تِم سٲنِس پننِس فوجس سٟتؠ۔ یتھٕ پٲٹھؠ زن خداوندن وعدہ اوس کوٚرمُت۔
\v 13 چنانچہ یسوعؔ کوٚر یفُنّہؔ سٕنٛدِس نیٚچوِس کالبسؔ برکتھ دِنہٕ باپتھ خداوندس کُن درخواست تہٕ تٔمؠ دیُت کالبسؔ حبرون شہر۔
\v 14 یتھٕ پٲٹھؠ، بنییہِ حبرون مستقل ملکِیت تہٕ یفُنّہ قنزیؔ سٕنٛدِس نیٚچو سُنٛد گرٕ۔ از تام چھِ امہِ سٕنٛدؠ اولاد تتہِ روزان۔ تکیازِ کالبنؔ کٔر تتھ پٮ۪ٹھ عمل یہِ تس خداوندن کرنہٕ باپتھ اوس ووٚنمُت۔
\v 15 ؤنؠ اوس حبرونُک ناو گۅڈٕ قریتؔ اربعؔ عناقنؔ منٛز اوس اربعؔ ساورٕے کھۅتہٕ بوٚڈ۔ تہٕ مُلکس منٛز اوس امن۔ تِمو کوٚر نہٕ مزید جنگ کینٛہہ۔
\c 15
\p
\v 1 یوٚسہٕ زمین یہُوداؔ سٕنٛدِس خاندانس دِژمٕژ ٲسٕکھ سۅ ٲسٕکھ امہِ سنٛدٮ۪ن خاندانن منٛز بٲگرآومٕژ۔ تہنٛز زمیٖن ٲس جنوبٕ طرفہٕ عدومؔ کِس سرحدٕ پٮ۪ٹھ صِین کِس بیابانس تام پھٔلِتھ۔
\v 2 تہنٛزِ زمیٖنہِ ہُنٛد جنوبی سرحد یُس یہُوداؔ کِس خاندانس منٛز تفویض اوسُکھ کوٚرمُت، بحیرہ نمک یَتھ بحیرہ مردار تہِ ونان چھِ گو ٲخرس پٮ۪ٹھ شروع، اتھ خلیجہٕ پٮ۪ٹھٕ یُس جنوبہٕ طرفہٕ چُھ۔\f + \fr 15‏:2 \ft یا بحیرہ مردار\f*
\v 3 امہِ پتہٕ گو یہِ جنوب طرفہٕ تہٕ عقربیمؔ کِس کوٚہس ہیٚور تہٕ صِین تام رود پکان تہٕ پتہٕ گو اکہ پھرِ جنوب طرفس کُن قادِس برنِیع پٮ۪ٹھٕ، حصرونؔ نِش، اددار تام پکان، تہٕ پتہٕ پھیور قرقع تام۔
\v 4 تتہِ پٮ۪ٹھٕ رود یہٕ عضمون کِنؠ مِصر چہِ کۅلہِ نزدیک گژھان، تتہِ پٮ۪ٹھٕ گو یہِ مغربس منٛز بحیرہ رومؔ کُن۔ یہِ آسہ چون جنوبی سرحد۔
\v 5 یہُوداؔ خاندانکہِ زمیٖنہِ ہُنٛد مشرقی سرحد اوس بحیرہ مردار۔ یہِ اوس شُمالہٕ طرفہٕ یردن دریاو کِس ٲخرس تام پھٔلِتھ، ییٚتہِ یہِ بحیرہ مردارس منٛز گژھان اوس۔
\v 6 شمٲلی سرحد رود تمہِ جایہِ پٮ۪ٹھٕ جٲری تہٕ شُمال کُن پھٔلیو بیت حجلہ تام۔ تتہِ پٮ۪ٹھٕ گو یہِ بیت العربہ\f + \fr 15‏:6 \ft یردن وادی\f* کِس شمالس منٛز بوہنؔ چہِ کنہِ تام اکھ کٔنؠ یۅسہ روبنؔ سٕنٛدؠ نیٚچوؠ بوہاننؔ ٲس کھڑا کٔرمٕژ۔
\v 7 امہِ جایہِ پٮ۪ٹھٕ پھیور سرحد مغرب طرفس کُن عکوز وادی منٛزؠ دبِیر تام۔ تتہِ پٮ۪ٹھٕ پھیور یہِ جِلجال گژھنہٕ خٲطرٕ دُبسرٕ شُمال طرفس کُن۔ جِلجال چُھ تتھ سڑکہِ شُمالس منٛز یُس دریاو چہِ وادی ہنٛدِس جنوبہٕ طرفہٕ عدومیم کِس کوہس پٮ۪ٹھ گژھان چُھ۔ جِلجال پٮ۪ٹھٕ اوس سرحد مغرب طرفہٕ عین شمس کٮ۪ن ناگن تام تہٕ تتہِ پٮ۪ٹھ عین روجل تام پھٔلِتھ۔
\v 8 تمہِ جایہِ پٮ۪ٹھٕ یبوسیؔ شہر یعنی یروشلمؔ جنوبہٕ پاسہٕ سرحدس کُن۔ یہِ سرحد چُھ واتان کوہ تینتٲلِس تام وادی ہِنوم کہِ مغرب پاسہٕ یُس وادی رفایم کہِ شمالہٕ طرفہٕ چُھ۔
\v 9 تتہِ پٮ۪ٹھٕ اوس سرحد شمالہٕ مغربہ طرفہٕ کوہ تینتٲلس تام پھٔلِتھ یُس نفتوحؔ کِس ناگس تام گژھام ٲس تہٕ تتہِ پٮ۪ٹھٕ کوہ عفرونؔ نزدیک شہرن تام۔ تتہِ پٮ۪ٹھٕ اوس سرحد مغربہ طرفہٕ بعلہؔ تام پھٔلِتھ یَتھ ؤنؠ ناو چُھ قریتؔ یعریمؔ۔
\v 10 پتہٕ پھٔلیو سرحد مغربس منٛز بعلہؔ پٮ۪ٹھٕ کوہِ شعیر تام۔ پتہٕ گو سُہ کوہ یعریمؔ کہِ شمال طرفہٕ جنوب مغربس منٛز یتھ کسالونؔ تہِ ونان چھِ تہٕ گو بیت شمسؔ تام۔ تتہِ پٮ۪ٹھٕ گو یہِ تمناؔ کِنؠ۔
\v 11 سرحد رود شمال مغربس منٛز عقرون کِش شمالس منٛز کوہس تام جٲری۔ تتہِ پٮ۪ٹھٕ اوس یہِ مغرب منٛز شکیرونؔ تام پٔھہلِتھ تہٕ بعلہؔ اوس کوہ یبنی ایلؔ تام تہٕ پتہٕ اوس شمال مغربس منٛز بحیرہ رومؔ تام پھٲلِتھ۔
\v 12 امہِ زمیٖنہِ ہُنٛد مغربی سرحد یُس یہُوداؔ سٕنٛدِس خاندانس دِنہٕ اوس آمُت سُہ اوس بحیرہ رومؔ۔ یہُوداؔ ہٕکؠ سٲری خاندان ٲسؠ یِمن سرحدن انٛدر روزان۔
\v 13 خداوندن دیُت یسوعسؔ حکم دیا زِ یہُوداؔ سٕنٛدِ خاندانہ کہِ زمیٖنہِ منٛز دِ کینٛہہ حصہٕ کالبسؔ۔ یتھٕ پٲٹھؠ دیُت أمؠ قریتؔ اربعؔ ہُک شہرکالبسؔ یتھ ؤنؠ حبرونؔ چھِ ونان۔ اربہؔ اوس عناقؔ سُنٛد مول۔
\v 14 کالبنؔ کٔرؠ عناقؔ قومٕکؠ ترےٚ خاندان حبرونؔ ییٚلہِ تراونس پٮ۪ٹھ مجبور۔ تِم ٲسؠ سیسیؔ، اخِیمانؔ تہٕ تلمیؔ خاندان۔
\v 15 پتہٕ دراو تتہِ کلبؔ تہٕ گو دبِیرس منٛز روزن والٮ۪ن لوٗکن سٟتؠ لڑنہِ یتھ گۅڈٕ قریتؔ سِفر ونان ٲسؠ۔
\v 16 کالبنؔ ووٚن، "یوٚدوے کانٛہہ قریتؔ سِفر کٮ۪ن لوٗکن پٮ۪ٹھ حملہٕ کٔرِتھ تہنٛدِس شہرس پٮ۪ٹھ قبضہٕ کرِ تیٚلہِ کرٕ بہٕ پننہِ کورِ عکسہؔ سُنٛد خاندر تمِس سٟتؠ۔
\v 17 کالبؔ سٕنٛدؠ بھٲئؠ قنزؔ سٕنٛدؠ نیٚچوؠ غتنی ایلنؔ کوٚر شہرس پٮ۪ٹھ قبضہ۔ توے دِژ کالبن پنٕنؠ کور عکسہؔ أمِس خانٛدرِ خٲطرٕ۔
\v 18 ییٚلہِ کالب سنٛزِ کورِ اوتھنلسؔ سٟتؠ خانٛدر کوٚر تہٕ تٔمؠ ووٚن تمِس زِ سۅ ونہِ پننِس مٲلِس زِ سُہ دِیہ أمِس اکھ زمینہِ ٹُکرٕ۔ پتہٕ گییہِ عکسہؔ پننِس مٲلِس کالبؔس سٟتؠ کتھ کرنہِ۔ ییٚلہِ سۅ پننہِ سوارِ یُس خر اوس پٮ۪ٹھٕ بوٚن ؤژھ، کالبنؔ پرُژھ تمِس، "ژےٚ ما چھِے ضرورت کینٛہہ؟"
\p
\v 19 عکسہنؔ دیُتُس جواب، "آ، بہٕ چھیٚس یژھان زِ ژٕ کرَکھ مےٚ خٲطرٕ کینٛہہ۔ ژےٚ چھیٚتھ مےٚ جنوبی یہُودیہ کٮ۪ن بیابانن ہنٛز زمین دِژمٕژ، مگر تتہِ چُھنہٕ آب کینٛہہ۔ تہٕ مےٚ دِیو مہربٲنی کٔرِتھ سۅ زمین یتھ منٛز ناگ آسن۔ "کالبنؔ دِتؠ أمِس حبرونؔ نزدیک ہیٚرِم تہٕ بوٚنِم ناگ۔\f + \fr 15‏:19 \ft قٲضؠ 1:11-15\f*
\v 20 یہِ چُھ ملکہٕ کٮ۪ن تِمن شہرن ہُنٛد فہرست یُس خداوندن یہُوداؔ سنٛدٮ۪ن خاندانن دِنُک وعدہ اوس کوٚرمُت۔ پٮرٮ۪تھ خاندانس آیہِ زمین دِنہٕ
\v 21 یہُوداؔ سٕنٛدِس خاندانس ٲسؠ یِم سٲری شہر جنوبی یہُودیہ کٮ۪ن بیابانن منٛز، عدومؔ علاقہٕ کِس سرحدس نزدیک دِنہٕ آمٕتؠ: قبضی ایلؔ، عیدرؔ، یجُورؔ، \f + \fr 15‏:21 \ft گۅڈنِکہِ ضِلعٕکؠ شہر ٲسؠ ادومؔ کِس سرحدَس نزدیک انتہٲئی جنوبس منٛز واقہٕ۔\f*
\v 22 قینہؔ، دیمونہؔ، عدہؔ،
\v 23 قادِسؔ، حصورؔ، اِتنانؔ،
\v 24 زِیفؔ، تلمؔ تہٕ بعلوتؔ۔
\v 25 تہٕ حصُورؔ حدتہؔ، قریتؔ حصرونؔ یَتھ حصورؔ تہِ ونان چھِ
\v 26 تہٕ امامؔ، سمعؔ، مولادہؔ،
\v 27 حصار جدہؔ، حِشمونؔ بیت فلطؔ
\v 28 حصرسوعالؔ، بیرسبعؔ تہٕ بزیوتیاہؔ۔
\v 29 بعلہؔ، عییمؔ تہٕ عضمؔ تہِ،
\v 30 تہٕ اِلتولد، کِسیلؔ، حُرمہؔ
\v 31 صقلاج، مدمنّہؔ، سنسنّاؔہ۔
\v 32 لباؤتؔ سِلحِیمؔ، عَینؔ تہٕ رِمّونؔ۔ اتہِ ٲسؠ کُنترٕہ شہر تہٕ انٛدؠ پٔکِکؠ گام یکجا۔
\v 33 یہُوداؔ سٕنٛدِس خاندانس ٲسِکھ یِم شہر مغربی دامنکِس شمٲلس منٛز دِتمٕتؠ: اِستالؔ، صُرعاؔ، اشناہؔ، \f + \fr 15‏:33 \ft دوٚیِمہِ ضِلعٕکؠ شہر ٲسؠ بالہٕ دامنس تل۔\f*
\v 34 زنواح، عین جنِیّمؔ، تفُوحؔ، عَیناؔم
\v 35 یرموتؔ، عدُلام، شوکہؔ، عزیقاؔہ
\v 36 شعریمؔ عدِیتیمؔ تہٕ جدیرؔہ یَتھ جدیرتِیمؔ تہِ ونان چھِ۔ أتی ٲسؠ ژۅداہ شہر تہٕ انٛدؠ پٔکِکؠ گام یکجا۔
\v 37 یہُوداؔ سٕنٛدِس خاندانس ٲسؠ مغربی دامنکِس جنوبس منٛز نوٚم شہر حصہٕ رٔنٛگؠ آمٕتؠ دِنہٕ: ضِنانؔ داشہؔ، مجدلؔ\f + \fr 15‏:37 \ft تریِمہِ ضِلعٕکؠ شہر تہِ ٲسؠ بالہٕ دامنس تل۔\f*
\v 38 دِلعاؔن، مِصفاہؔ، یقتی ایلؔ
\v 39 لکِیسؔ، بُصقتؔ تہٕ عجلُون۔
\v 40 تہٕ کبُّونؔ، لحماؔم، کِتلِیسؔ،
\v 41 جدِیروؔت، بیت دجونؔ، نعمہؔ تہٕ مقیدہؔ۔ یِم ٲسؠ شُراہ شہر تہٕ انٛدؠ پٔکِکؠ گام۔
\v 42 یہُوداؔ کِس خاندانس تہِ ٲسِکھ یِم شہر مغربی دامنہٕ کِس مزکزے حِصَس منٛز دِتؠمٕت: لبناہؔ، عترؔ، عسنؔ، \f + \fr 15‏:42 \ft ژوٗرِمہِ ضِلعٕکؠ شہر چھِ کوہ دامن کِس مرکٔزی حِصس منٛز، دویمِس تہٕ تریمِس ضِلعس درمِیان۔\f*
\v 43 یِفتاؔح، اشناہؔ، نصِیبؔ
\v 44 کیلا، اکزِیبؔ تہٕ مریسہؔ۔ یِم ٲسؠ انٛدؠ پٔکؠ کٮ۪ن گامن سٟتؠ سٟتؠ نَو شہر۔
\v 45 اتہِ ٲسؠ عقرونؔ شہر تہِ سٟتؠ امِکؠ گام تہٕ قصبہٕ۔\f + \fr 15‏:45 \ft پٲنٛژمہِ ضِلعٕکؠ شہر ٲسؠ فلسطینی سٲحلی علاقن منٛز۔\f*
\v 46 عقرونؔ پٮ۪ٹھٕ بحیرہ رومؔ تام یہُوداؔ کِس علاقس منٛز ٲس اشدودؔ شہرس نزدیک سٲری زمین تہِ شٲمل، اتِکؠ گام ہٮ۪تھ۔
\v 47 اشدودؔ تہٕ امِکؠ انٛدؠ پکِکؠ گام؛ غزہ ہُکؔ شہر تہٕ امِکؠ انٛدؠ پکِکؠ گام مِصرٕ کِس نالس تہٕ بحیرہ رومؔ تام سرحدن کٔر بٹھٮ۪ن ہنٛز رٲچھ۔
\v 48 یہُوداؔ کٮ۪ن خاندانن آے کوٚہستٲنؠ ملکہٕ کِس جنوبی مغربی حِصس منٛز یِم شہر تہِ دِنہٕ: سمیرؔ، یتیِرؔ، شوکہؔ، \f + \fr 15‏:48 \ft شیٚیمہِ ضِلعٕکؠ شہر ٲسؠ پہٲڑی علاقن منٛز۔\f*
\v 49 دنّاہؔ، قریتؔ سنّہؔ یَتھ دبِیرؔ تہِ ونان چھِ
\v 50 عنابؔ، اِستِموہؔ، عنِیمؔ
\v 51 جشن، حولُونؔ تہٕ جِلوہؔ یِتہِ ٲسؠ انٛدؠ پٔکؠ گامن سٟتؠ سٟتؠ کاہ شہر۔
\v 52 یہُوداؔ کٮ۪ن خاندانن آے کوٚہستٲنؠ ملکہٕ کِس جنوبی وسطی حِصس منٛز یِم شہر تہِ دِنہٕ: ارابؔ، دوماہؔ، اشعانؔ
\v 53 ینیِمؔ، بیت تفوحؔ، افیقہؔ، \f + \fr 15‏:53 \ft سٔتمہِ ضِلعٕکؠ شہر تہِ ٲسؠ پہٲڑی علاقن منٛز۔\f*
\v 54 حُمطہؔ، قریتؔ اربعؔ یتھ وُنکٮ۪ن حبرونؔ چھِ ونان تہٕ صیعُورؔ۔ یِم ٲسؠ نَو شہر انٛدؠ پکِکؠ گام ہٮ۪تھ۔
\v 55 ہوداہ کٮ۪ن خاندانن آے کوٚہستٲنؠ ملکہٕ کِس جنوبی مشرقی حِصس منٛز یِم شہر تہِ دِنہٕ: معُونؔ، کرمِلؔ، زِیفؔ، یُوطہؔ۔\f + \fr 15‏:55 \ft ٲٹھمہِ ضِلعٕکؠ شہر تہِ ٲسؠ پہٲڑی علاقن منٛز۔ حبرون کس جنوب مشرقس منٛز۔\f*
\v 56 یزرعیلؔ، یقدِعاؔم، زنواح،
\v 57 قینؔ، جِبعہؔ تہٕ تِمنت۔ یِتہِ ٲسؠ انٛدؠ پٔکؠ گامن سٟتؠ سٟتؠ داہ شہر
\v 58 یہُوداؔ کٮ۪ن خاندانن آے کوٚہستٲنؠ ملکہٕ کِس وسطی حِصس منٛز یِم شہر تہِ دِنہٕ: حلحُوؔل، بیت صُورؔ، جدُورؔ، \f + \fr 15‏:58 \ft نٔومہِ ضِلعٕکؠ شہر تہِ ٲسؠ پہٲڑی علاقن منٛز۔ شمٲلی حبرونس منٛز۔\f*
\v 59 معراتؔ، بیت عنوتؔ تہٕ اِلتقوؔن۔ یِتہِ ٲسؠ انٛدؠ پٔکؠ گامن سٟتؠ سٟتؠ شٮےٚ شہر
\v 60 یہُوداؔ کٮ۪ن خاندانن ٲسؠ کوٚہستٲنؠ ملکہٕ کِس شمال حصس منٛز زٕ شہر دِنہٕ آمٕتؠ: ربہؔ تہٕ قریتؔ بعلؔ یَتھ قریتؔ یعریمؔ تہِ ونان چھِ۔\f + \fr 15‏:60 \ft دٔہِمہِ ضِلعٕکٮ۪ن شہرن منٛز ٲسؠ صِرِف زٕ شہر درٕج۔ \f*
\v 61 یہُوداؔ کٮ۪ن خاندانن ٲسؠ آے کوٚہستٲنؠ ملکہٕ کِس بحیرہ مردارسؔ نزدیک ریگستانس منٛز یِم شہر تہِ دِنہٕ: بیت العربہ، مِدینؔ، سکاکہؔ، \f + \fr 15‏:61 \ft کٔہمہٕ ضلعٕکؠ شہر ٲسؠ مشرقی خشک علاقس منٛز، یم وادی یردن تام وٲتؠ۔\f*
\v 62 نِبسانؔ، نوٗنُک شہر، تہٕ عین جیدیؔ۔ یتہِ ٲسؠ انٛدؠ پٔکؠ کٮ۪ن گامن سٟتؠ سٟتؠ شےٚ شہر۔
\p
\v 63 یہُوداؔ کٮ۪ن خاندانن ہُنٛد فوج اوسنہٕ یبوسینؔ ژٔلراونس قٲبل۔ توے رودؠ تِم یروشلمسؔ منٛزےٕ۔ تِم چھِ از تہِ یہُوداؔ کٮ۪ن خاندانن منٛزےٕ روزان۔
\c 16
\p
\v 1 سۅ زمین یۅسہ افرائیمؔ تہٕ منسیؔ ہنٛدٮ۪ن دوٚن خاندانن دِنہٕ ٲس آمٕژ یعنی سُہ خاندان یُس یوسف سنٛدِ نسلہٕ منٛز اوس، دریائے یردن پٮ۪ٹھ شروع گٔژھِتھ یرِیحُو کِنؠ بیت ایلؔ کہِ کوٚہستٲنؠ ملکہٕ کِنؠ درایہِ۔
\v 2 یہِ ٲس مغربس منٛز یریحوؔ پٮ۪ٹھٕ بیت ایلؔ تہٕ پتہٕ لُوزؔ تام پھٔلتھ تہِ سۅ ٲس اتاروتؔ گژھان یُس یہِ اوس سُہ علاقہٕ یتہِ آرکیٹسؔ روزان ٲسؠ۔\f + \fr 16‏:2 \ft اگرچہ عبرانی متنس منٛز بیت ایل تہٕ لوز زٕ مختلف جایہٕ چھےٚ، حقیقتس منٛز چُھ لوز بیت ایلُک گۅڈنیُک ناو وننہٕ یوان۔ (وُچھِو 18:13؛ قٲضؠ 1:23؛ پیدایش 28:19؛ 35:6):\f*
\v 3 تتہِ پٮ۪ٹھٕ مغرب طرفہٕ تتھ زمینہِ ہنٛدِس سرحدس تام یتہِ یفلِیطِی باشنٛدٕ روزان ٲسؠ، تہٕ پتہٕ مغربس منٛز زیریں بیت حورُونؔ نزدیک کِس علاقس تام پھٔلِتھ۔ تتہِ پٮ۪ٹھ رود یہِ مغرب طرفہٕ جزرؔ تہٕ تتہِ پٮ۪ٹھٕ بحیرہ رومؔ تام گژھان
\v 4 یہِ اوس سُہ علاقہٕ یُس یوسفؔ، منسیؔ تہٕ افرائیمؔ کیٚو لوٗکو پنٕنؠ مستقل ملکِیت کہِ حٮ۪ثیتہٕ حٲصِل کٔرمٕژ۔
\v 5 افرائیمؔ کٮ۪ن خاندانن یُس ملک مقرر کرنہٕ اوس آمُت تمیُک سرحد اوس مشرقس منٛز عطارات ادارؔ پٮ۪ٹھٕ شروع گژھان۔ یہِ پھٔلیاو بیت حورُونؔ ہیٚور تام
\v 6 تہٕ رود بحیرہ رومؔ تام جٲری۔ شمال طرفہٕ پھیور مکمیتؔاہ پٮ۪ٹھٕ مشرقٕ طرفہٕ تانت سَیلا شیلوہؔ کُن۔ تہٕ گے مشرقہٕ طرفہٕ ینوُحاہؔ تام۔
\v 7 تِم ؤتھؠ ینوُحاہؔ پٮ۪ٹھٕ بوٚن تہٕ پتہٕ گے نعراؔ۔ تتہِ پٮ۪ٹھٕ وٲتؠ تِم یریحوؔ شہر یُس دریائے یردنس پٮ۪ٹھ ختم گو۔
\v 8 شمٲلی سرحد اوس تفُوحؔ پٮ۪ٹھٕ قاناہؔ وادی تام پھٔلتھ تہٕ بحیرہ رومسؔ پٮ۪ٹھ اوس ختم گژھان۔ یہِ ٲس سۅ زمیٖن یۅسہ افرائیمؔ کٮ۪ن سارنےٕ خاندانن دِژمٕژ ٲسٕکھ۔
\v 9 افرائیمؔ کٮ۪ن لوٗکن ہنٛدِ خٲطرٕ مخصوص شہر تہٕ تِمن پٮ۪ٹھ منحصر گام ٲسؠ دراصل منسیؔ کٮ۪ن لوٗکن ہنٛدِ مقرر کرنہٕ آمتِس علاقس اندر۔
\v 10 افرائیمؔ کٮ۪ن خاندانن ہنٛدؠ لوٗکھ ہیٚکہٕ ہن نہٕ کنعانیؔ ین جزرؔ تراونس پٮ۪ٹھ مجبور کٔرِتھ۔ کنعٲنؠ ٲسؠ وُنہِ تہِ تتہِ روزان۔ تاہم، افرائیمؔ کیٚو لوٗکو کٔرؠ تِم پنٕنؠ غلام بننس پٮ۪ٹھ مجبور۔
\c 17
\p
\v 1 یہِ چُھ تمہِ زمیٖنہِ ہُنٛد فہرست یۅسہ منسیؔ سٕنٛدِ خاندانس دِنہٕ ٲس آمٕژ۔ منسیؔ سُنٛد زیُٹھ نیٚچو اوس کیرؔ تہٕ تمہِ سُنٛد زُر اوس جِلعادؔ۔ تمسٕنٛدِس اولادس آیہِ مکِیر سٕنٛدِس اعزازس منٛز جِلعاد تہٕ بسن کٮ۪ن علاقن منٛز زمینہٕ دِنہٕ یُس اکھ عظیم سپٲہی اوس۔
\v 2 منسیؔ سنٛدٮ۪ن دوٚیمٮ۪ن خاندانن تہِ ٲس زمین دِنہٕ آمٕژ: ابیعزرؔ، خلقؔ، اسیری ایلؔ، سِکم، حفرؔ تہٕ سمِیدع۔ یِم ٲسؠ منسیؔ سنٛدٮ۪ن اولادن ہنٛدؠ ناو یُس پانہٕ یوسفؔ سُنٛد نیٚچو اوس۔ پٮرٮ۪تھ خاندانہٕ خٲطرٕ ٲس زمین دِنہٕ آمٕژ۔
\v 3 جلعاد سنٛدِ نسلہٕ منٛزٕ اوس صِلافحادؔ بن حفرؔ۔ یُس مکِیر سُنٛد نیٚچو تہٕ منسیؔ سُنٛد زُر اوس۔ أمِس اوسنہٕ کانٛہہ اولاد۔ أمِس آسہ کورے یاژٕ۔ تہٕ تہنٛدؠ ناو ٲسؠ محلاہؔ، نُوعاہؔ، حُجلاہ مِلکاہؔ تہٕ تِرضاہؔ۔
\v 4 یِم مستورات گییہِ الِیعزرؔ سارنےٕ کاہنن ہنٛدؠ زِٹھؠ یسوعؔ تہٕ باقین اسرائیلی زِٹھٮ۪ن نِش۔ تِمو ووٚن، "أسؠ چھِ یژھان زِ توٚہؠ دِیو اسہِ کینٛہہ زمین تکیازِ خداین اوس موسیٰؔ ہس ووٚنمُت زِ سُہ دِیہ اسہِ کینٛہہ زمین، یتھٕ پٲٹھؠ زن توٚہہِ سانٮ۪ن خاندانن ہنٛدٮ۪ن مردن دِژٕو۔ "چنانچہ الِیعزرؔ کوٚر تی یہِ خداوندن حکم اوس دیُتمُت: أمؠ دِژ تِمن کینٛہہ زمین یتھٕ پٲٹھؠ امؠ تہنٛدٮ۪ن پِترن خٲطرٕ کوٚر۔\f + \fr 17‏:4 \ft گرینٛد 27:1-7\f*
\v 5 چنانچہ منسیؔ سٕنٛدِس خاندانس نِش ٲسؠ یردن دریاو کِس مغربس منٛز زمینٕکؠ داہ حصہٕ تہٕ جلعادؔ تہٕ بسنس منٛز دریائے یردن کِس مشرقس منٛز زٕ حصہ
\v 6 منسیؔ خاندانکٮ۪ن مستوراتن تہِ آیہِ مردن ہنٛدؠ پٲٹھؠ دریاوِ مغرب پاسہٕ زمیٖن دِنہٕ۔ جلعادِکؠ باقےٕحِصہٕ ٲسِکھ منسیؔ کعن باقی لوٗکن دِتؠ مٕتؠ۔
\v 7 منسیؔ ہنٛدِس خاندانس یۅسہ زمین دِنہٕ ٲس آمٕژ سۅ ٲس تتھ زمیٖنہِ درمیان یتہِ آشرؔ خاندان روزان اوس تہٕ سکِمؔ نزدیک مکمیتؔاہ جایہِ۔ سرحد اوس جنوبس منٛز تفوحؔ کِس ناگس تام پھٔہلِتھ۔
\v 8 تفُوحؔ شہرس نزدیکٕچ زمین ٲس منسیؔ خاندانچ۔ مگر تفوحؔ اوس پانہٕ افرائیمؔ خاندان کِس سرحد پٮ۪ٹھ تہٕ اوس درحقیقت افرائیمین ہُنٛد۔
\v 9 سرحد اوس جنوب طرفہٕ قاناؔ کۅلہِ تام پھٔہلِتھ تہٕ کۅلہِ ہنٛدِس جنوبس منٛز ٲسؠ سٲری منسیؔ یِکؠ شہر۔ منسیؔ یُک سرحد اوس قاناہؔ کۅلہِ ہنٛدِ شمالہٕ طرفہٕ۔ یہِ اوس بحیرہ رومؔ تام پھٔہلِتھ۔
\v 10 جنوبچ زمین ٲس افرائیمینؔ ہنٛز تہٕ شمالچ زمین ٲس منسیؔ خاندانن ہنٛز۔ بحیرہ رومؔ اوس منسیؔ یُک سرحد۔ آشرُؔک خاندان اوس سرحد کہِ شُمال طرفہٕ۔ ییٚلہِ زن اشکارُکؔ خاندان مشرقسؔ منٛز اوس۔
\v 11 مگر اتہِ ٲسؠ اشکارؔ تہٕ آشرؔ خاندانن دِنہٕ آمتیٚن علاقن انٛدر شہر انٛدؠ پٔکؠ کٮ۪ن گامن سٟتؠیِم ٲسؠ دراصل منسیؔ ہنٛدٮ۪ن خاندان کٮ۪ن لوٗکن دِنہٕ آمٕژ۔ یِم شہر ٲسؠ بیت شانؔ، اِبلیعامؔ، دورؔ، عین دورؔ، تعانکؔ تہٕ مجِدوؔ تہٕ فہرستس منٛز تریٚیِم شہر نافتؔ۔
\v 12 منسیؔ خاندانٕکؠ لوٗکھ ہیٚکہٕ نہٕ تتھ شہرس منٛز روزن والیٚن لوٗکن تتہِ نیرنس پٮ۪ٹھ مجبور کٔرِتھ۔ توے ٲسؠ کنعٲنؠ لوٗکھ پننِس مُلکس منٛز روزان۔
\v 13 ییٚلہِ اسرائیلی مضبوط گے تہٕ تِمو کٔرؠ یِم کنعٲنؠ غلام بنٲوِتھ کام کرنہٕ باپتھ مجبور مگر تِم ہیٚکؠ نہٕ یِمن نِش زمین تھَپہِ نِتھ۔
\v 14 یوسف سٕنٛدؠ اولادو یعنی افرائیمؔ تہٕ منسیؔ سٕنٛدؠ خاندان ووٚن یسوعسؔ، "توٚہہِ دِتو اسہِ صرف اکُے رقبہٕ، مگر سٲنِس خاندانس منٛز چھِ واریاہ لوٗکھ۔ پرٮ۪تھ انٛدٕ چھےٚ خداوندن اسہِ برکتھ کٔرمٕژ۔ تیٚلہِ کیازِ دِژٕو توٚہہِ اسہِ روزنہٕ باپتھ زمینُک اکھ کوٚکُٹ حصہ؟"
\v 15 یسوعن ووٚ تِمن، "یوٚدوے توٚہہِ نِش واریاہ لوٗکھ چھِ، امہِ خٲطرِ نیرِو تہٕ ژٔٹیٚو جنگلٕکؠ کُلؠ تہٕ بنایِو پننٮ۪ن فصلن تہٕ پانس خٲطرٕ روزن جاے فِرزی تہٕ رفایم\f + \fr 17‏:15 \ft رفایم چھِ دیوانن ہنٛز نسٕل، وُچھِو 12:4۔ \f* کٮ۪ن ملکن منٛز۔ توٚہہِ پزیٚو یی کرُن، تکیازِ کوٚہستٲنؠ ملک چُھ تہنٛدِ روزنہٕ خٲطرٕ تتہِ واریاہ تنگ"
\v 16 افرائیمؔ تہٕ منسیؔ خاندانکٮ۪و لوٗکو دیُت جواب، "کوٚہستٲنؠ ملک چُھنہٕ سانہٕ باپتھ تیوٗت بوٚڈ۔ مگر اتہِ روزن والٮ۪ن کنعٲنین ہنٛدِ موجُب ہیٚکو نہٕ أسؠ مٲدانس منٛز پھٔلِتھ۔ بیت شانؔ تہٕ اتھ انٛدؠ پٔکؠ کٮ۪ن گامن منٛز کنعٲنؠ یس نزدیک چھِ شِسترو ڈٔلہٕ وٲلؠ رتھ۔"
\v 17 یسوعنؔ دیُت بنی یوسفؔ افرائیمؔ تہٕ منسیؔ یس جواب، "تُہنٛد قوم چُھ پزی واریاہ زیادٕ تہٕ سٮ۪ٹھا طاقتور۔ تہٕ ؤنؠ دِمو بہٕ توٚہہِ بیٚیہِ اکھ زمین:
\v 18 کوٚہستٲنؠ ملک تہِ بنہِ تُہنٛد۔ توٚہہِ پٮ۪نو کُلؠ ژَٹٕنؠ تاکہِ یہِ بنٲیو توٚہؠ پنُن، تہٕ تُہنٛدِ روزنہٕ باپتھ ییہِ جاے بناونہٕ۔ توٚہؠ کٔڑؠ ووکھ کنعٲنؠ نٮ۪بر، اگرچہ تِم مضبوط آسن تہٕ تِمن نِش آسن شِسترو ڈٔلہٕ وٲلؠ رتھ۔"
\c 18
\p
\v 1 اسرائیل ین ہنٛز سٲری جماتھ گییہِ سَیلاؔ ہس منٛز جمع۔ تتہِ لوگ تِمو خٟمہٕ یتہِ تِم خداوند سنٛز عبادت ٲسؠ کران۔ ملکس منٛز اوسنہٕ مزید جنگ۔\f + \fr 18‏:1 \ft اعمال۔ 7:45\f*
\v 2 تاہم ٲس نہٕ وُنہِ اسرائیل ین ہنٛدٮ۪ن ستن خاندانن زمیٖن دِنہٕ آمٕژ۔
\v 3 یسوعنؔ ووٚن اسرائیل ین، "توٚہؠ کیازِ چُھو واریہس وقتس پراران؟ توٚہؠ کوتاہ ژیر کٔریٚو تتھ ملکس گژھنہٕ خٲطرٕ یمچ تُہنٛدؠ جد عبادت ٲسؠ کران، یُمیٚک وعدہ خداوندن توٚہہِ دٕنُک چُھ کوٚرمُت؟
\v 4 پننٮ۪و سَتو خاندانَو منٛزٕ ژٲرِوُکھ ترےٚ نفر۔ بہٕ سوزُکھ تِمہٕ سۅ زمیٖن ژھارنہِ یتھ پٮ۪ٹھ نہٕ توٚہہِ وُنہٕ قبضہٕ چُھو کوٚرمُت۔ ییٚلہِ تِم ختم کرن، تِمہٕ لٮ۪کھن اکھ رِپورٹ زِ زمیٖن کِژھ چھےٚ۔ تِم بناون اکھ نقشہٕ تہِ یہِ ہاونہٕ خٲطرٕ زِ شہر تہٕ اہم مقامات کتہِ چھِ تہٕ کُس خاندان کتھ شہرس منٛز روزِ
\v 5 تِم کرن باقی زمیٖن ستن حِصن منٛز تقسیم۔ یہُوداؔ سُنٛد خاندان تھاوِ پنٕنؠ زمیٖن برقرار، تہٕ افرائیمؔ تہٕ منسیؔ خاندان تھاون شمالس منٛز پنٕنؠ زمیٖن برقرار۔
\v 6 مگر ستن خاندانن ہنٛدٮ۪ن نفرن پزِ پننِس رپورٹس منٛز زمینٕکؠ باقی ستتھ حصہٕ یِم تِم حٲصِل کرٕنؠ چھِ یژھان بیان کرٕنؠ تہٕ مےٚ نِش رِپورٹ انُن۔ یوٚتام خداوند وُچھان چُھ، بہٕ تراوٕ چیٖرِ زِ پرٮ۪تھ خاندانس کۅسہٕ زمین ییہِ دِنہٕ۔
\v 7 مگر لاوی خانٛدانس ییہِ نہٕ کانٛہہ زمیٖن دِنہٕ، تکیازِ تُہنٛد اجر چُھ تیٚہُنٛد یہُوواہؔ سٕنٛدؠ کاہن آسُن۔ جد، روبن تہٕ منسیؔ ہنٛدٮ۪ن اڈٮ۪ن خاندانن چھےٚ گۅڈَے دریاے یردن کہِ مشرقہٕ پاسہٕ زمیٖن دِنہٕ آمٕژ، یتھٕ پٲٹھؠ موسیٰؔ ہن فٲصلہٕ اوس کوٚرمُت، یمؠ خداوند سنٛز خدمت اصل پٲٹھؠ چھےٚ کٔرمٕژ۔ یتھٕ پٲٹھؠ میلہِ نہٕ ؤنؠ تِمن مزید زمین۔"
\v 8 ییٚلہِ تِم مرد یِم ژارنہ ٲسؠ آمٕتؠ نیرنہٕ خٲطرٕ تیار گے، یسوعنؔ ووٚ تِمن، "گٔژِھو ژٲنٛڈیِو زمیٖن۔ پتہٕ بنٲؠ زیٚو تٔمیُک رپورٹ یہِ کینٛژھا تہِ وُچھِو، تہٕ أنؠ زیٚو مےٚ نِش واپس۔ پتہٕ ییٚلہِ خداوند وُچھان آسہ، بہٕ تراوٕ ییٚتہِ سَیلاہسؔ منٛز چیٖرِ تاکہِ یہِ کرو طے زِ کس قبیلس کُس علاقہٕ میلہِ۔"
\v 9 چنانچہ تِم مرد دراے تتہِ تہٕ پٔکؠ علاقس کُن۔ پتہٕ کوٚر تِمو یمو ستو حِصو منٛزٕ پرٮ۪تھ کانٛہہ حصہٕ بیان یَتھ منٛز تِمو پنٕنؠ شہر ہٮ۪تھ تقسیم ٲسؠ کٔرؠ مٕتؠ۔ پتہٕ آے تِم واپس یسوعسؔ نِش یُس ونیُک تام سَیلاہس منٛز اوس۔
\v 10 یسوعؔ سُنٛد سَیلاہسؔ منٛز تُہنٛد رپورٹ پرنہٕ پتہٕ ییٚلہِ خداوند وُچھان اوس، تٔمؠ تراوِ چیٖرِ تاکہِ یہِ ژٲر ییہِ کرنہٕ زِ اسرائیل ین ہنٛدٮ۪ن ستن خاندانو منٛز پرٮ۪تھ أکِس کۅسہٕ زمین ییہِ دِنہٕ۔
\v 11 گۅڈنیُک خاندان یمن زمیٖن ٲس دِنہٕ ٲمٕژ سُہ اوس بنیمِینؔ خاندان۔ امہِ قبیلہٕ کٮ۪ن سارنےٕ خاندانن ٲس زمیٖن دِنہٕ آمٕژ یۅسہ اتھ علاقس منٛز ٲس یۅسہ یہُوداؔ سنٛدِس خاندانس دِنہ آسہٕ آمژٕ تہٕ امہِ علاقہٕ کٮ۪ن افرائیمؔ تہٕ منسیؔ کٮ۪ن خاندانن دِنہٕ ٲس آمٕژ۔
\v 12 شمٲلی سرحد پھہلٲاو دریاوٕ یردن پٮ۪ٹھٕ یرِیحُو کِس شمالس سٟتؠ مغرب طرفہٕ کوٚہستٲنؠ ملکس تام۔ تتہِ پٮ۪ٹھٕ اوس سرحد مغرب طرفہٕ بیت آونؔ نزدیک بیابانسؔ تام پھہلِتھ۔
\v 13 تتہِ پٮ۪ٹھٕ اوس یہِ جنوبس منٛز لُوزؔ تام پھٔہلِتھ یتھ ؤنؠ بیت ایلؔ ونان چھِ۔ تتہِ پٮ۪ٹھٕ چُھ یہِ عطارات ادارؔ تام گژھان یُس لوزؔ بیت حورُونؔ کِس جنوبس منٛز کوٚہس پٮ۪ٹھ چُھ۔
\v 14 بیت حورُونؔ کِس جنوبس منٛز کوٚہس پٮ۪ٹھ، سرحد پھہلیاو جنوبس کُن پھیرِتھ قریتؔ بعلؔ تام۔ یتھ قریتؔ یعریمؔ تہِ ونان چھِ۔ یہِ چُھ سُہ شہر یٮیٚتہِ یہُوداؔ خاندانٕکؠ لوٗکھ چھِ روزان۔ سُہ اوس مغربی سرحد۔
\v 15 تہُنٛزِ زمیٖنہِ ہُنٛد جنوبی سرحد اوس قریتؔ یعریمسؔ نزدیک شروع گومُت تہٕ مغربس منٛز نفتوحؔ کٮ۪ن ناگن تام اوس پھٔہلیامُت
\v 16 تتہِ پٮ۪ٹھٕ اوس سُہ کوہ دامنن تام پھہلیامُت یُس وادی ہِنومسؔ نزدیک رفایم وادی ہنٛدِس شمالس منٛز چُھ۔ سرحد اوس وادی ہنومسؔ سٲتؠ سٲتؠ، شہرکِس جنوبس منٛز ییٚتہِ یبوسی ٲسؠ روزان، عین روجل تام پھہلیامُت۔
\v 17 تتہِ پٮ۪ٹھٕ اوس سرحد مغربس کُن عین شمس تام پھہلِتھ۔ تہٕ اوس عدومیم کوٚہن نزدیک جِلیلوت تام گژھان۔ پتہٕ پھہلیاو یہِ رُوبِنؔ سنٛدِس نیٚچو بوہانؔ سنٛزِ عظیم کنہِ تام۔
\v 18 تتہِ پٮ۪ٹھٕ اوس سرحد بیت عربہ کِس شمال انٛدٕ بٔٹھِس تام تہٕ یردن کِس بوٚنمس مٲدانس تام پھہلِتھ۔\f + \fr 18‏:18 \ft یردن وادی\f*
\v 19 تتہِ پٮ۪ٹھٕ پھٔہلیاو یہِ مشرق کرفس کُن بیت حجلہ کِس شمٲلی بٔٹھِس تام تہٕ بحیرہ مردار کِس شمٲلی سرس پٮ۪ٹھ گو ختم ییٚتہِ دریائے یردن بحیرہ مردارس منٛز پکان چُھ۔ یہِ اوس جنوبُک انٛد۔\f + \fr 18‏:19 \ft بحیرے مردار\f*
\v 20 دریائے یردن اوس بنیمِینؔ کِس خاندانس دِنہٕ آمژِ زمینہِ ہُنٛد مشرقی انٛد۔ تِمہٕ ٲسؠ زمیٖنہِ ہنٛدؠ سرحد یۅسہ تِمن دِنہٕ ٲس آمٕژ۔ پرٮ۪تھ کانٛہہ سرحد اوس بارِ بارِ اصٕلؠ پٲٹھؠ بیان آمُت کرنہٕ۔
\v 21 بنیمِینؔ کٮ۪ن خاندانن دِنہٕ آمٕتؠ علاقٕکؠ شہر ٲسؠ یرِیحُوؔ، بیت حجلہ، عیمق قصیصؔ
\v 22 بیت العربہ، صمریمؔ بیت ایلؔ
\v 23 عوّیمؔ، پارہؔ، عفرہؔ
\v 24 کفَر العمُّوؔنی عُفنیؔ تہٕ جِبعؔ۔ اتہِ ٲسؠ یِکہٕ وٹہٕ ژۅداہ شہر تہنٛدیٚو گامو بغٲر۔
\v 25 بنیمِینؔ کِس خاندانس ٲسؠ جِبعونؔ، رامہؔ، بیروتؔ شہر تہِ۔
\v 26 مِصفاہؔ، کفرہؔ، موضہؔ،
\v 27 رقمؔ، ارفیلؔ، تراؔلہ،
\v 28 ضِلعؔ، الفؔ، یبوسؔ سُہ شہر ییٚتہِ یبوسی روزان ٲسؠ، یتھ ؤنؠ یروشلمؔ ونان چھِ، جِبعتؔ، تہٕ قریتؔ۔ اتہِ ٲسؠ یِکہٕ وٹہٕ ژۅداہ شہر تہنٛدیٚو گامو بغٲر۔ سُہ سورےٕ علاقہٕ اوس آمُت بنیمِینؔ خاندانن دِنہٕ۔
\c 19
\p
\v 1 دوٚیِم خاندان یتھ زمین ٲس دِنہٕ آمٕژ سُہ اوس شمعونؔ خاندان۔ امہِ خاندانکِس پٮرٮ۪تھ قبیلس ٲس زمین دِنہٕ آمٕژ یۅسہ یہُوداؔ کِس علاقس منٛز باگ ٲس۔
\v 2 شِمعونؔ کِس زمیٖنس منٛز ٲسؠ یِم شہر شٲمل: بیرسبعؔ، سباؔ، مولادہؔ،
\v 3 حصرسوعالؔ، بالاؔہ، عضمؔ
\v 4 اِلتولد، بتُولؔ تہٕ حُرمہؔ
\v 5 شِمعونؔ کِس زمیٖنس منٛز ٲسؠ یِم شہر تہِ شٲمل: صقلاج، بیت مرکبوؔت، حصار سُوسہؔ
\v 6 بیت لِباوتؔ اور ساروحؔن۔ اتہِ ٲسؠ انٛدؠ پٔکؠ کٮ۪ن گامن سان ترُواہ شہر۔
\v 7 شمعونسؔ دِنہٕ آمژِ زمینہِ منٛز ٲسؠ یِم ژور شہر عَینؔ، رِمونؔ، عترؔ تہٕ عسنؔ تہِ اتہِ کٮ۪ن انٛدؠ پٔکؠ کٮ۪ن گامن سان شٲمل۔
\v 8 تِمن ٲسٕکھ اتھ علاقس منٛز کینٛہہ گام تہِ دِتمٕتؠ یُس جنوبس منٛز بعلاتؔ بیرؔ تام\f + \fr 19‏:8 \ft بعلاتؔ بیرؔ شہر، یُس کنعان کِس جنوبی حصس منٛز رامہ ناوٕ سٟتؠ تہِ زاننہٕ چُھ یِوان۔\f* پھٔہلِتھ اوس یتھ جنوبی بیابانن منٛز رامہؔ تہِ ونان چھِ۔ یہِ ٲس سۅ زمین یۅسہ شمعونؔ خاندان کٮ۪ن قبیلن دِنہٕ ٲس آمٕژ۔
\v 9 یہُوداؔ سٕنٛدِس خاندانس ٲس ضرورت کھۅتہٕ زیادٕ زمین دِنہٕ آمٕژ، اوے دِژٕکھ اہنٛزِ زمیٖنہِ ہُنٛد کینٛہہ حصہٕ شمعونؔ کِس خاندانس۔
\v 10 تریٚیِم خاندان یتھ زمین دِنہٕ ٲس آمٕژ سُہ اوس زبولونؔ خاناندان۔ امہ، خاندان کِس پرٮ۪تھ قبیلس ٲسٕکھ کینٛہہ زمین دِژمٕژ۔
\pi جنوبی سرحد گو ساریدؔ پٮ۪ٹھٕ شروع۔
\v 11 یہِ ٲس مغرب طرفہٕ مرعلؔہ تہٕ دبّاستؔ تام پھٔہلِتھ تہٕ ٲس یقنِعام شہر کہِ برونٛٹھمہِ پاسہٕ کۅلہِ تام پھٔہلِتھ۔
\p
\v 12 سرحد پھیور ساریدؔ پٮ۪ٹھٕ مشرق کُن تہٕ ووت کِسلوت تبورؔ کِس نزدیکی علاقس تام۔ تہٕ پتہٕ دبرتؔ پٮ۪ٹھٕ برونٛٹھ کُن یفیع تام۔
\v 13 تتہِ پٮ۪ٹھٕ پھٔلیاو مشرقس منٛز جتہ حفیرؔ تہٕ عِتہ قاضِین تامؔ تہٕ شمالس منٛز رِمُونؔ تام۔ تتہِ پٮ۪ٹھٕ پھیور نِیٮعہؔ کِس سرحدس تام۔
\v 14 نِیٮعہؔ پٮ۪ٹھٕ جنوبس منٛز حناتوُنؔ تام تہٕ تتہِ پٮ۪ٹھٕ اِفتاحؔ ایلؔ چہِ وادی تام اوس پھٔلِتھ
\v 15 زیبلونؔ کِس علاقس منٛز ٲسؠ قطّاتؔ، نحلاؔل، سِمروؔن، ادالہؔ تہٕ بیت لحمؔ شہر شٲمل۔ اتہِ ٲسؠ اتِکؠ نزدیکی گام ہٮ۪تھ باہ شہر۔
\v 16 یہِ ٲس سۅ زمیٖن یۅسہ زبولونؔ خاندان کٮ۪ن قبیلن دِنہٕ ٲس آمٕژ۔ بشمول شہر تہٕ تہنٛدؠ انٛدؠ پٔکِکؠ گام۔
\v 17 ژورِم خاندان یتھ زمیٖن دٕنہٕ ٲس آمٕژ سُہ اوس اشکارؔ خاندان۔ امہِ خاندانکِس پرٮ۪تھ قبیلس ٲس کینٛہہ نَتہٕ کینٛہ زمیٖن دِنہٕ آمٕژ۔
\v 18 تہنٛدِس علاقس منٛز ٲسؠ یِزرعیلؔ، کِسُولوؔت، شُونِیمؔ شہر
\v 19 حفارِیمؔ، شیُونؔ تہٕ اناخراؔت
\v 20 اشکارؔچہِ سرِزمینہِ منٛز ٲسؠ ربیتؔ، قِسیونؔ تہٕ اِبضؔ شہر تہِ شٲمل۔
\v 21 ریِمتؔ، عین جنیِم، عَین حدّہؔ تہٕ بیت فصیصؔ
\v 22 اِسکارؔ کِس خاندانس یُس علاقہٕ مقرر کرنہٕ اوس آمُت تمیُک سرحد اوس تبورؔ، شخصِیماہؔ تہٕ بیت شمسؔ شہرن نزدیک تہٕ مشرقس منٛز اوس دریائے یردنس نِش ختم گژھان۔ تہنٛدِ انٛدؠ پٔکؠ کٮ۪ن گامن سان ٲسؠ شُراہ شہر۔
\v 23 انٛدؠ پٔکؠ کٮ۪ن گامن سان تِم شہر ٲسؠ اشکارؔ خاندان کٮ۪ن قبیلن ہنٛزِ دِنہٕ آمژِ زمیٖنہِ منٛزٕ۔
\v 24 پٲنٛژِم خاندان یِمن زمیٖن ٲسٕکھ دِژمٕژ سُہ اوس آشرؔ خاندان۔ امہِ خاندانکِس پرٮ۪تھ قبیلس ٲس کینٛہہ نَتہٕ کینٛہ زمیٖن دِنہٕ آمٕژ۔
\v 25 یِمن قصبن منٛز ٲسؠ خِلقتؔ، حلیؔ، بطنؔ تہٕ اکشاؔف شہر۔
\v 26 اُلمّلکؔ، عمادؔ تہٕ مِسالؔ۔ مغربی سرحد گو شروع کوہِ کرملؔ تہٕ سِیُحور لِبناتؔ پٮ۪ٹھٕ شروع
\v 27 تتہِ پٮ۪ٹھٕ اوس یہِ جنوب مشرقس منٛز بیت دجونؔ شہر تام پھٔلِتھ، تہٕ تتھ علاقس تام یُس زبولونؔ کِس خاندانس دِنہٕ اوس آمُت، تہٕ تتہِ پٮ۪ٹھٕ بروںٛٹھ کُن اِفتاحؔ ایلؔ وادی تام۔ تتہِ پٮ۪ٹھٕ اوس سرحدمشرقس کُن پتہٕ شمالس منٛز بیت العمقؔ تہٕ نیٖل تہٕ کبوُل تام پھٲلِتھ۔
\v 28 تتہِ پٮ۪ٹھٕ پھٲلیاو یہِ مغرب طرفس کُن عبرُونؔ، رحوبؔ، حمّونؔ تہٕ قاناہؔ کٮ۪ن شہرن تام۔ تہٕ گو اور صیداؔ تام یُس اکھ بوٚڈ شہر اوس۔
\v 29 صیداؔ پٮ۪ٹھٕ اوس سرحد جنوبس کُن رامہؔ تہٕ ضورؔ کِس ساروٕے کُۅتہٕ بٔڈِس شہرس تام پھٲلِتھ یتھ انٛدؠ پٔکؠ مضبوط دیوار ٲسؠ۔ تتہِ پٮ۪ٹھٕ اوس سرحد مغربس منٛز حوسہؔ تام پھٲلِتھ تہٕ بحیرہ رومسؔ پٮ۪ٹھ گو ختم، محالاب تہٕ اکزیؔب کِس علاقس منٛز۔
\v 30 عُمّہ افیکؔ تہٕ رحوبؔ اتہِ ٲسؠ انٛدؠ پٔکؠ کٮ۪ن گامن سان زُتووُہ شہر۔
\v 31 تِم شہر تہٕ تہنٛدؠ گام ٲسؠ اتھ ملکس انٛدر یُس آشرؔ خاندان کٮ۪ن قبیلن دِنہ ٲس آمٕژ۔
\v 32 شیٚیِ خاندان یتھ زمین ٲس دِنہٕ آمٕژ سُہ اوس نفتالیؔ خاندان۔ امہِ خاندان کِس پرٮ۪تھ قبیلس ٲس کینٛہہ نتہٕ کینٛہہ زمین دِنہٕ آمٕژ۔
\v 33 نفتالیؔ سرِزمینہِ ہُنٛد سرحد گو مغربس منٛز حلفؔ شہرس نزدیک ضعننیمسؔ منٛز بلوط کہِ بڈِ کُلہِ پٮ۪ٹھٕ شروع۔ یہِ گو مشرقس منٛز ادامی نقبؔ تہٕ یبنی ایلؔ کِنؠ گژھان گژھان تہٕ پھٔہلیاو پتہٕ لقُوم تام تہٕ گو دریائے یردنس پٮ۪ٹھ ختم۔
\v 34 مغربی سرحد اوس ازنوت تبورؔ کِنؠ گٔژھِتھ حُقوقؔ تام پھٔہلِتھ۔ یہِ اوس جنوبس منٛز زبولونؔ خاندان کِس سرحدس تام، مغربس منٛز آشرؔ خاندان کِس سرحدس تام تہٕ مشرقس منٛز دریائے یردنس تام پھٔہلِتھ۔
\v 35 اہنٛزِ سرِزمین انٛدر ٲسؠ واریاہ شہر یِمن ژوٚشوٕنؠ طرفن مضبوط دیوار ٲسؠ۔ یِم شہر ٲسؠ صِدّیمؔ، صؔیر، حمّاتؔ، رقّتؔ، کِنّرتؔ،
\v 36 ادامہؔ، رامہؔ، حصور،
\v 37 قادِسؔ، ادرعیؔ تہٕ عَین حصُورؔ۔
\v 38 مضبوط دیوار وٲلِس نفتالیؔ شہرس منٛز ٲسؠ یرونؔ، مگدل ایلؔ، ہورمؔ، بیت عناتؔ تہٕ بیت شمسؔ تہِ شٲمل۔ یہنٛدٮ۪ن انٛدؠ پٔکؠ کٮ۪ن گام سان ٲسؠ اتہِ کُنوُوہ شہر۔
\v 39 تِم شہر تہٕ انٛدؠ پٔکِکؠ گام ٲسؠ تتھ زمینہِ منٛز یۅسہ نفتٲلی خاندانس دِنہٕ ٲس آمٕژ۔
\v 40 سٔتِم خاندان یتھ زمین دِنہٕ ٲس آمٕژ اوس دانؔ خاندان۔ امہِ خاندان کِس پرٮ۪تھ قبیلس ٲس کینٛہہ نتہٕ کینٛہہ زمیٖن دِنہٕ آمٕژ۔
\v 41 تہنٛزِ زمینہِ منٛز ٲسؠ صُرعاہؔ، اِستال تہٕ عیرشمسؔ شہر۔
\v 42 شعلبِینؔ، ایالونؔ تہٕ اِتلاؔہ۔
\v 43 دانؔ سنٛزِ زمہینہِ منٛز ٲسؠ ایلوؔن، تمناؔ، عقرون شہر تہِ،
\v 44 اِلِتقیہؔ، جِبّتوؔن، بعلاتؔ،
\v 45 یہُودؔ، بنیبرقؔ، جات رِمون،
\v 46 مَیرقُونؔ، رِقُّون تہٕ یوفاؔ ہس نزدیکُک علاقہٕ۔
\v 47 مگر دان خاندانٕکؠ لوٗکھ ٲسؠ اتھ زمینہِ پٮ۪ٹھ قبضہٕ کرنہٕ نِشہ قٲصِر یۅسہ تِمن دِہٕ ٲس آمٕژ۔ تِمہٕ گے شمال مشرقس کُن تہٕ کٔرٕکھ لڑٲے لشمؔ\f + \fr 19‏:47 \ft لشمؔس ٲسؠ لیشؔ تہِ ونان۔\f* شہرکٮ۪ن لوٗکن سٟتؠ۔ تِمو ہارنٲوؠ تِم تمام لوٗکھ تہٕ مٲرِکھ۔ پتہٕ بسیاے تِم لشم شہرس منٛز روزنہٕ خٲطرٕ، تہٕ شہرُکہ ناو بدلووُکھ تہٕ تھووہس دانؔ ناو، سُہ شخص یس منٛزٕ تُہنٛد خاندان دراو۔
\v 48 انٛدؠ پٔکؠ کٮ۪ن گامن سان ٲسؠ تِم سٲری شہر تتھ زمیٖنہِ منٛز یۅسہ دانؔ خاندان کٮ۪ن قبیلن دِژمٕکھ ٲسٕکھ۔
\v 49 اسرائیلی زِٹھیٚو دِژ زمیٖن قبیلن منٛز بٲگراونہٕ پتہٕ کینٛہہ زمیٖن یسوعؔس تہِ۔
\v 50 تِمو دیُت تمِس تمنت شہر۔ یہُوواہنؔ ووٚن زِ سُہ یُس شہر رٹُن یژھِ سُہ ہیٚکہِ رٔٹِتھ، تہٕ یوٚہے اوس سُہ شہر یُس تٔمؠ ژورمُت اوس۔ یہِ اوس کوٚہستٲنؠ مُلکس منٛز یُس افرائیمؔ خاندانس دِنہٕ اوس آمُت۔ یسوعنؔ بنوو نیہِ سَرٕ شہرٕ تہٕ اود تٔتی روزنہِ۔
\v 51 یِم ٲسؠ تِم علاقہٕ یِم اسرائیل کٮ۪ن مختلف خاندانن دِنہٕ ٲسؠ آمٕتؠ۔ الِیعزرؔ سارِنےٕ کاہنن ہُنٛد زیُٹھ، یسوعؔ تہٕ ساروٕے خاندانو ہنٛدیٚو زِٹھیٚو بٲگرٲو زمیٖن ییٚلہِ تِم سَیلاہسؔ منٛز ٲسؠ، چیٖرِ ترٲوِتھ کوٚرُکھ فٲصلہٕ زِ پرٮ۪تھ خاندانس کُس علاقہٕ میلہِ۔ تِمو کوٚر یتھٕ پٲٹھؠ تمہِ وزِ ییٚلہِ یہُوواہؔ مقدس خٟمہٕ منٛزٕ وُچھان اوس۔ یِتھٕ پٲٹھؠ کوٚر تِمو زمیٖن بٲگراونُک سِلسِلہٕ مُکمل۔
\c 20
\p
\v 1 پتہٕ ووٚن اکہِ دوٚہہ خداوندن یسوعسؔ،
\v 2 "اسرائیلی لوٗکن فرماو زِ تِم کرن تِنن کینٛژن شہرن ۂنٛز ژٲر یور کُن لوٗکھ محفوظ روزنہٕ باپتھ دورن، یتھٕ پٲٹھؠ زن مےٚ موسیٰؔ ہَس ووٚنمُت اوس کرنہٕ خٲطرٕ۔\f + \fr 20‏:2 \ft گرینٛد: 35:9-29؛ اِستِثنا۔ 4:41-43؛ 19:1-13\f*
\v 3 اگر کانٛہہ شخص کٲنسہِ دوٚیمِس شخصس غلطی سان مارِ کُنہِ اِرادٕ بغٲر تہٕ سُہ شخص ہیٚکہِ یِمو شہرَو منٛز کُنہِ أکِس شہرس کُن دوٗرِتھ تہٕ محفوظ روزِتھ۔
\v 4 ییٚلہِ سُہ شخص یمو شہرو منٛزٕ کُنہِ أکِس دروازس پٮ۪ٹھ واتہِ تہٕ تمِس پزِ اتہِ ٹھہراو کٔرِتھ امہِ شہرکٮ۪ن زِٹھٮ۪ن تہِ ونُن یہِ سپدیاو۔ اگر تِم اتھ پٮ۪ٹھ یقین کرن، تہٕ تِمن پزِ أمِس شخصس شہرس منٛز اژنُک اجازت دیُن، تہٕ تِمن پزِ أمِس شخصس پانس درمیان روزنہٕ خٲطرٕ جاے دِنؠ۔
\v 5 اگر مرن وٲلؠ سُنٛد کانٛہہ رِشہٕ دار بدلہٕ نِنہِ اتھ شہرس منٛز آو تہٕ امہِ شہرکٮ۪ن زِٹھٮ۪ن پزِ زِ تِم دِن نہٕ یمن رِشہٕ دارن قٲتلس نِنُک اجازت تکیازِ یہِ سپدیاو تہِ اوس حٲدثٲتی۔ سُہ اوس نہٕ أمِس شخصس سٟتؠ نفرت کران۔ أمؠ چُھنہٕ سُہ زٲنِتھ مٲنِتھ قتل کوٚرمُت۔
\v 6 یمؠ شخصن بیٚیہِ کانٛہہ دوٚیِم قتل کوٚر تمِس پزِ شہرس منٛز تۅتام روزُن یوٚتام نہٕ شہرُک منصف اتھ پٮ۪ٹھ مقدِمہ چلایہِ۔\f + \fr 20‏:6 \ft گرینٛد 35:25، 28\f* صرف اتھ صوٗرتس منٛز ییٚلہِ جج فٲصلہٕ کرِ زِ یُس شخص امہِ شہرٕ منٛز ژوٚل أمؠ کوٚر نہٕ دوٚیِم شخص زٲنِتھ مٲنِتھ قتل، کیا سُہ دیا أمِس اتھ شہرس منٛز روزنُک اجازت، تہٕ تمِس پزِ تتھ وقتس تام اتھ شہرس منٛز روزُن یۅتام نہٕ سردار کاہن مَرِ یُس جُرمہٕ وقتہٕ خدمت اوس کران۔ ییٚلہ سُہ نفر بحفاظت پنُن گھرٕ واپس ہیٚکہِ گٔژھِتھ۔
\v 7 چنانچہ اسرائیل یو ژٲرؠ تِم شہر بننہٕ خٲطرٕ ییٚتہِ لوٗکھ محفوظ روزنہٕ خٲطرٕ ژٔلِتھ ہیٚکہٕ ہن: جلیل کِس علاقس منٛز قادِس، تہٕ کوٚہستٲنؠ مکلس منٛز ییٚتہِ نفتٲلؠ خاندان روزان اوس۔ کوٚہِستٲنؠ ملکس منٛز سِکم ییٚتہِ افرائیمُک خانٛدان اوس روزان۔ تہٕ قریتؔ اربعؔ یتھ ؤنؠ حبرونؔ چھِ ونان کوٚہستٲنؠ ملکس منٛز ییٚتہِ یہُوداؔ سُنٛد خاندان اوس روزان۔
\v 8 دریائے یردن کہِ مشرقہٕ طرفہٕ یریحُو نزدیک، بیابانن منٛز بصرؔ ییٚتہِ روبنؔ خاندان روزان اوس۔ جِلعادکِسؔ علاقس منٛز راموتؔ، تتھ زمینہِ منٛز ییٚتہِ جدُک خاندان اوس روزان۔ تہٕ بسنؔ کِس علاقس منٛز جولانؔ ییٚتہِ منسیؔ خاندان روزان اوس۔
\v 9 کانٛہہ تہِ اسرائیلی یا کانٛہہ تہٕ غٲر ملکے یُس یِمن درمیان روزان اوس یمؠ الغٲب کانٛہہ قتل اوس کوٚرمُت، تمِس اوس یِمو شہرو منٛزِ کُنہِ أکِس کُن ژَلنُک اجازت۔ تتہِ روزِ سُہ کٲنٛسہِ مرن وٲلؠ سنٛزٕ رِشتہٕ دارس نِش محفوظ تہٕ أمِس بدلہٕ نِنہٕ باپتھ کرِتٔمِس قتل۔ سُہ ہیٚکہِ اتھ شہرس منٛز تۅتام روزِتھ یوٚتام نہِ یہِ فٲصلہٕ کرنہٕ خٲطرٕ أمِس پٮ۪ٹھ مقدِمہ چلاونہٕ ییہِ نہٕ زِ کیاہ سُہ چھا پوٚز ونان ییٚلہِ زن سُہ یہِ ونان چُھ زِ تٔمؠ کوٚر نہٕ سُہ شخص زٲنِتھ مٲنِتھ قتل۔
\c 21
\p
\v 1 یوٚدوے زن اسرائیلی وُنی سیلا شہرسےٕ منٛز ٲسؠ، لاوی قبیلٕکؠ زِٹھؠ آے سیلا الِیعزرؔ کاہن، نون سٕنٛدِس نیٚچوِس یسوعؔس تہٕ باقے اسرائیلی قبیلن ہنٛدٮ۪ن زِٹھٮ۪ن سٟتؠ کتھ باتھ کرنہِ۔
\v 2 یِمو ووٚن تِمن، "یہُوواہؔ ہن اوس موسیٰؔ ہس حکم دیُتمُت زِ اسہِ لاوے قبیلس یِن دِنہٕ سیلا شہر ییٚتہِ أسؠ روزِتھ ہیٚکو تہٕ ییٚتہِ سٲنؠ کٹھ گُپن گاسہٕ بیترِ کھیٚتھ ہیٚکن\f + \fr 21‏:2 \ft گرینٛد 35:1-8\f*
\v 3 اسرائیلی زِٹھیٚو مون یہِ خداوند سُنٛد فرمان۔ یہُوواہؔ سٕنٛدِ طرفہٕ میلہِ مٕتیو شہرو منٛزٕ تھٲوؠ تِمو لاوی قبیلس آیہِ تن شہر تہِ تہٕ گھاسہٕ مٲدان تہِ
\v 4 گۅڈٕ تراوِ اسرائیلی زِٹھیٚو چیٖرِ تاکہِ قہاتؔ سنٛدٮ۪ن اولادن میلن کینٛہہ شہر۔ یِم ٲسؠ تِم خاندان یِم ہارونؔ سٕنٛدِ نسلہٕ منٛزٕ ٲسؠ۔ تِمو دِتؠ تِمو علاقو منٛز ترُواہ شہر یِم یہُوداؔ، شمعون تہٕ بنیمِینؔ خاندانن نِش ٲسؠ۔
\v 5 اسرائیلی زِٹھیٚو کٔرؠ قہاتس سٟتؠ تعلق تھاون وٲلؠ باقی خاندانن ہنٛدِ خٲطرٕ افرائیمؔ تہٕ دان خاندانو منٛزٕ داہ شہر مقرر، سٟتؠ منسیؔ خاندان منٛزٕ سُہ حصہ یُس دریائے یردن کہِ مغرب پاسہٕ کِس بٔٹھِس پٮ۪ٹھ روزام ٲسؠ۔
\v 6 اسرائیلی زِٹھیٚو کٔرؠ جیرسونؔ سٟتؠ تعلق تھاون والٮ۪ن خاندانن ہنٛدٮ۪ن لوٗکن خٲطرٕ ترۅہن شہرن تِم علاقہٕ تفویض یِم اشکارؔ، آشرؔ تہٕ نفتٲلی ہنٛدٮ۪ن خاندانن ہنٛدِس قبضس منٛز ٲسؠ، سٟتؠ سٟتؠ بسن علاقس منٛز أڈِس منسیؔ خاندانس تہِ۔
\v 7 مراریؔ خاندانس سٟتؠ تعلق تھاون والٮ۪ن لوٗکن دِتؠ اسرائیلی زِٹھیٚو تِمن علاقن ہنٛدؠ باہ شہر یِم روبنؔ، جدؔ تہٕ زبولونؔ خاندانن نِش ٲسؠ۔
\v 8 یتھٕ پٲٹھؠ دِتؠ اسرائیلی زِٹھیٚو لٲویؔ خاندانن شہر تہٕ چرایہ، یتھٕ پٲٹھؠ زن خداوندن موسیٰؔ ہس حکم اوس دیُتمُت یہِ کرنہٕ باپتھ۔
\v 9 یِم چھِ تِمن شہرن تہٕ انٛدؠ پٔکؠ کٮ۪ن چراین ہنٛدؠ ناو یِم اسرائیلی زِٹھیٚو لاوی خاندانن تتھ منٛز مقرر کٔرؠ ییٚتہِ شمعونؔ تہٕ یہُوداؔ سٕنٛدؠ خاندان روزان ٲسؠ۔
\v 10 گۅڈٕ دِتؠ اسرائیلی رہنماہن قہاتسؔ سٟتؠ تعلق تھاون والٮ۪ن کینٛژھن خاندانن شہر، یِم ہارونؔ سٕنٛدِ نسلٕکؠ خاندان ٲسؠ، یِم لاوی خاندانٕکؠ ٲسؠ، یِم خدمت ٲسؠ کران۔ اسرائیلی زِٹھیٚو تراوِ قیاتؔ کٮ۪ن یِمن خاندانن خٲطرٕ گۅڈٕ چیٖرِ۔
\v 11 اسرائیلی زِٹھیٚو دیُت تِمن یہُوداؔ کہِ کوٚہستٲنؠ ملکہٕ منٛزٕ قریتؔ اربعؔ یَتھ ؤنؠ حبرونؔ چھِ ونان۔ اربعؔ اوس عناقؔ سُنٛد مول۔ تِمو دِژٕ أندؠ پٔکؠ چہِ جرایہِ تہِ۔
\v 12 تاہم آسہ اسرائیلی زِٹھیٚو گۅڈَے قریتؔ اربعؔ انٛدؠ پٔکیُک زمین تہٕ گام کالب بن یفُنّہ ہَس پشراومژ۔
\v 13 یتھٕ پٲٹھؠ دیُت اسرائیلی زِٹھیٚو حبرونؔ ہارون کاہن سٕنٛدِس اولادس۔ ہبرُونؔ اوس تِمو شہرو منٛزٕ اکھ ییٚتہِ لوٗکھ غلطی سببہٕ کٲنٛسہِ مارنس پٮ۪ٹھ ژٔلِتھ ہیٚکہٕ ہن۔ ہارونؔ سٕنٛدِس اولادس دیُت تِمو لبناہؔ شہر۔
\v 14 یتیِرؔ پننٮ۪ن چراین سٟتؠ، تہٕ اِشتِموع پننٮ۪ن چراین سٟتؠ،
\v 15 اسرائیلیٚو دِژٕ حولُونس تمہِ سنٛزٕ چرایہِ تہٕ دبِیرس تہِ تمہِ سنٛزٕ چرایہِ۔
\v 16 عَینؔ، یُوطہؔ تہٕ بیت شمسؔ یِم نَو شہر ٲسؠ تتہِ یتہِ یِم زٕ خاندان روزان ٲسؠ۔
\v 17 اسرائیلی زِٹھیٚو دِتؠ ہارون سٕنٛدِس اولادس تمہِ علاقٕکؠ کینٛہہ شہر تہِ یِم بنیمِینؔ خاندانس نِش ٲسؠ: جِبعونؔ، جِبعؔ،
\v 18 عنتوتؔ، تہٕ علموؔن۔ ژور شہر چرایو سان۔
\v 19 اتہِ ٲسؠ کُلہُم ترُواہ شہر أندؠ پٔکؠ چٮ۪ن چراین سان یِمہٕ اسرائیلی زِٹھیٚو کاہنن یعنی ہارون سنٛدٮ۪ن اولادن دِتۍ مٕتؠ ٲسؠ۔
\v 20 قہاتس سٟتؠ تعلق تھاون وٲلؠ دوٚیِمٮ۪ن خاندانن میلیاے افرائیمؔ کہِ خاندانہٕ منٛزٕ ژور شہر۔
\v 21 تِمن آیہِ افرائیمؔ کہِ کوٚہستٲنؠ علاقہٕ منٛزٕ سِکمؔ تہٕ امچہِ چرایہِ دِنہٕ، یہِ تہٕ چرایو سان جزرؔ ٲسؠ تمہِ سٕنٛدِ خٲطرٕ چھپَن جایہِ ہنٛدؠ شہر یُس کٲنٛسہِ بےٚ گناہ قتل اوس کران۔
\v 22 قبِضَیمؔ تہٕ بیت حورُونؔ۔ ژور شہر چرایو سان۔
\v 23 قہاتسؔ سٟتؠ تعلق تھاون والٮ۪ن یِمن مخصوص خاندانن میلیاے ژور شہر تہِ یِمن انٛدؠ پٔکؠ چہِ چرایہِ اتھ علاقس منٛز آسہ یِمہٕ دان خاندانس نِش آسہ۔ یِم ٲسؠ اِلِتقیہؔ، جِبّتوؔن شہر،
\v 24 ایالونؔ، تہٕ جات رِمون۔ ژور شہر اتپ چیو چرایو سان۔
\v 25 قہات کیٚو یِمو دوٚیو خاندانو رٔٹؠ زٕ شہر یِم منسیؔ خاندانس نِش ٲسؠ۔ یِم شہر ٲسؠ تعانکؔ تہٕ جات رِمون۔ یِمن دوٚن شہرن آسہ سارے چرایہ۔
\v 26 اتہِ ٲسؠ کُلہُم دہا شہر أندؠ پٔکؠ چیو چرایو سان یِمہٕ قہات کٮ۪ن یِمن مخصوص خاندانن میلیمژٕ آسہ۔
\v 27 اسرائیلی زِٹھیٚو تہِ تراوِ چیٖرِ تاکہِ شہر تہٕ امہِ چہِ انٛدؠ پٔکؠ چہِ چرایہِ یِن جیرسونؔ پٮ۪ٹھٕ یِنہٕ والٮ۪ن خاندانن دِنہٕ۔ یِم خاندان تہِ ٲسؠ لاوی نسلہٕ منٛزٕ۔ یِمو خاندانو رٔٹؠ منسیؔ خاندانس میلن والہ علاقہٕ منٛزٕ زٕ شہر یعنی سُہ اوڈ خاندان یُس دریاے یردن کِس مشرقس منٛز آباد اوس۔ تِمہٕ شہر ٲسؠ بسس علاقس منٛز جولانؔ، یُس یِمو شہرو منٛزٕ اکھ اوس یوٚت لوٗکھ ژٔلِتھ ہیٚکہٕ ہَن، تہٕ بعستراہؔ یعنی زِ شہر یِمن چرایہِ آسہ۔
\v 28 یِمو خاندانو تہِ رٔٹؠ امہِ علاقہٕ منٛزٕ کینٛہہ شہر تہِ یِم اشکارؔ خاندانس نِش ٲسؠ۔ تِم شہر ٲسؠ قِسیونؔ، دبرتؔ،
\v 29 یرموؔت تہٕ عین جنیِمؔ۔ ژور شہر چرایو سان
\v 30 یِمو خاندانو رٔٹؠ کینٛہہ شہر تمہِ علاقہٕ منٛزٕ یِم آشرؔ خاندانس نِش ٲسؠ۔ تِم شہر ٲسؠ مِسالؔ، عبدونؔ،
\v 31 خِلقتؔ تہٕ رحوبؔ۔ ژور شہر اتہِ چیو چرایو سان۔
\v 32 یِمو خاندانو رٔٹؠ کینٛہہ شہر تمہِ علاقہٕ منٛزٕ یِم نفتالیؔ خاندانس نِش ٲسؠ۔ یِم شہر یعنی قادِسؔ ٲسؠ جلیلؔ علاقس منٛز یِمو شہرو منٛزٕ اوس اکھ شہر سُہ یوٚت لوٗکھ ژٔلِتھ ہیٚکہٕ ہن یوٚدوے تِم کٲنٛسہِ الغاب مارٕہن، چریاو سان ترےٚ شہر یعنی حماتؔ دورؔ تہٕ کرتانؔ۔
\v 33 جیرسونیٚو رٔٹؠ کُلہُم پٲٹھؠ ترُواہ شہر انٛدؠ پٔکؠ چو چاروایو سان۔
\v 34 اسرائیلی زِٹھیٚو دِتؠ باقی لاویٮ۪ن تہِ شہر، یعنی مراری خاندانس سٟتؠ تعلق تھاون وٲلؠ لوٗکھ۔ یِمن خاندانن میلیاے یِمو علاقو منٛزٕ تِم شہر یِم زبولونؔ خاندانس نِث ٲسؠ۔ یِم شہر ٲسؠ یقنِعام، کرتاہؔ،
\v 35 دِمنہؔ، تہٕ نحلاؔل۔ ژور شہر اتہِ چیو چرایو سان۔
\v 36 مراری پٮ۪ٹھٕ یِنہٕ والٮ۪و خاندانو رٔٹؠ تمہِ علاقٕکؠ شہر تہِ یِمہٕ روبن خاندانس نِش ٲسؠ۔ یِم شہر ٲسؠ بصرؔ، یحزؔ،
\v 37 کدیموتؔ تہٕ مفاتؔ اتہِ چیو چرایو سان ژور شہر۔
\v 38 مراری پٮ۪ٹھٕ یِنہٕ والٮ۪و خاندانو رٔٹؠ تمہِ علاقٕکؠ شہر تہِ یِمہٕ جد خاندانس نِش ٲسؠ۔ یِم شہر ٲسؠ راموتؔ تہٕ محنایمؔ۔ راموتؔ اوس سُہ شہر یوٚت تِمہٕ لوٗکھ ژلِتھ ہیٚکہٕ ہن یِم غٲراِرادٕ طور کٲنٛسہِ قتل کرہن۔
\v 39 اتہِ ٲسؠ یعزیرؔ تہٕ حسبونؔ شہر یعنی کُلہُن ژور شہر اتہِ چیو چرایو سان۔
\v 40 مراری کٮ۪ن سارنےٕ خاندانن میلیاے باہ شہر تکیازِ اسرائیلی زِٹھیٚو آسہ تہنٛدِ باپتھ چیٖرِ تراوِمژٕ
\v 41 چنانچہ لاویو ٲسؠ کُلہُم پٲٹھؠ امہِ علاقہٕ منٛزٕ ارتٲجی شہر رٔٹؠ مٕتؠ یِم اسرائیل کٮ۪ن دوٚیمٮ۪ن خاندانن نِش ٲسؠ تہٕ سٟتی تِمن شہرن ہنٛزٕ چرایہِ تہِ۔
\v 42 یِمن آسہ پرٮ۪تھ کُنہِ شہرس چرایہِ۔
\v 43 یہِ اوس یتھٕ پٲٹھؠ زِ خداوندن اوس اسرائیل ین یہٕ سٲرےٕ زمین دِنُک تہنٛدٮ۪ن پتمیٚن پیٖرٮ۪ن سٟتؠ وعدہ دیُتمُت۔ اسرائیل یو کوٚر یِمن علاقن پٮ۪ٹھ قبضہ تہٕ گے أتی آباد۔
\v 44 یتھٕ پٲٹھؠ زن تٔمؠ تہنٛدٮ۪ن جدٕ اجدادن سٟتؠ وعدہ اوس کوٚرمُت، خداوندن دیُت یِمن اہنٛدٮ۪ن دشمنن سٟتؠ سکون حٲصِل کرنُک اجازت یمؠ تِم گیٖر ٲسؠ کٔرؠ مٕتؠ۔ یہنٛدؠ کٲنٛسہِ دُشمنن دیُت نہٕ یِمن شکس۔ خداوندن کوٚر اسرائیل ین پنٕنؠ سٲری دُشمن ہارناونس منٛز مدد۔
\v 45 خداوندن کوٚر اسرائیلی لوٗکن سٟتؠ وعدہ۔ پرٮ۪تھ کانٛہہ وعدہ گو پوٗرٕ۔
\c 22
\p
\v 1 اسرائیلی قبیلو کٔرؠ یردن دریاوکِس مغربس منٛز زمین فتح کرنہٕ پتہٕ یسوعنؔ طلب روبنی، جدین تہٕ منسیؔ کٮ۪ن اڈٮ۪ن خاندانن ہنٛدؠ زِٹھؠ۔
\v 2 تٔمؠ ووٚن تِمن، "توٚہہِ چُھو سورےٕ کینٛہہ کوٚرمُت یہِ موسیٰؔ ہنؔ توٚہہِ کرنہٕ خٲطرٕ حکم چُھ دیُتمُت۔ توٚہہِ چُھ تی کوٚرمُت یہِ توٚہہِ مےٚ حکم چُھو دِتمُت۔\f + \fr 22‏:2 \ft گرینٛد: 32:28-32؛ اِستِثنا: 3:18-20\f*
\v 3 واریہس وقتس تام چُھو توٚہہِ دوٚیمن خاندانن تہنٛدٮ۪ن دشمنن شکس دِنہٕ باپتھ مدد کوٚرمُت۔ توٚہہِ کٔرٕو خداوندٕ سٕنٛدِ تمہِ حکمٕچ تٲمیٖل یۅسہ خداوندن توٚہہِ ہٮ۪چھنٲو تہٕ توٚہہِ کرنہٕ خٲطرٕ حکم دِتوٕ۔
\v 4 تٔمؠ اوس تہنٛدٮ۪ن اسرائیلی سٲتھین امنُک وعدہ دیُتمُت، تہٕ تٔمؠ کوٚر پنُن وعدہ پوٗرٕ۔ یتھٕ پٲٹھؠ ہکیٚو توٚہؠ ؤنؠ پننٮ۪ن گرن واپس گٔژھِتھ، تتھ زمیٖنہِ منٛز یۅسہ توٚہہِ موسیٰؔ دِژممژ ٲسٕو، دریائے یردن\f + \fr 22‏:4 \ft عبر: 4:8\f* کِس مشرقس منٛز۔
\v 5 موسیٰؔ ہن چُھ توٚہہِ یہِ حکم تہِ دیُتمُت زِ توٚہؠ کٔریٚو پننِس خداوند یہُوواہؔ ہس سٟتؠ محبت۔ تہٕ پنٕنؠ زندگی گُزٲرِو تِتھٕ پٲٹھؠ یتھٕ پٲٹھؠ سُہ یژھان چُھ۔ تٔمؠ وٚنو توٚہہِ زِ توٚہؠ کٔریٚو تمِسنٛدٮ۪ن حکمن ہنٛز تعمیل، أمِس پٮ۪ٹھ کٔریٚو بھروسہٕ تہٕ باقی ترٲؠ ووکھ۔ یہِ کٔریٚو تِتھٕ پٲٹھؠ زن چُھو توٚہؠ تمہِ سنٛز عبادت کران تہٕ پرٮ۪تھ تتھ چیٖزس سٟتؠ یہِ توٚہؠ سونچان چُھ تہٕ یہِ توٚہؠ کران چُھو تمسٕنٛدِس خدمتس منٛز۔\f + \fr 22‏:5 \ft متی. 22:37، لوق 10:27\f*
\v 6 پتہٕ دِیُت یسوعنؔ تِمن دُعا تہٕ کٔرِن رخصت، یتھٕ پٲٹھؠ گۓ تِم پننٮ۪ن خٲمن منٛز واپس۔
\v 7 موسیٰؔ ہن اوس یردن دریاوکِس مشرقُک بسنؔ علاقہٕ منسیؔ کِس أڈِس خاندانس حصہٕ رٔنٛگؠ دیُتمُت۔ تہٕ یسوعنؔ ٲس دریائے یردن کہ مغرب طرفچ زمین امہِ خاندان کِس باقی أڈِس خاندانس دِژمٕژ۔ ییٚلہِ یسوعنؔ تِم پننٮ۪ن خٲمن منٛز سوزؠ، تٔمؠ ووٚن خداوندس تِمن برکتھ کرنہٕ خٲطرٕ۔
\v 8 تٔمؠ ووٚن تِمن، "پننٮ۪ن خٟمن منٛز گٔژھِو واریاہ رۅپیہ، واریاہ جانور چٲنٛدؠ، سۅن، پیتل، شِستٕر تہٕ واریاہ خوبصورت پلو ہٮ۪تھ واپس۔ مگر توٚہہِ پزیٚو پننٮ۪ن دُشمنن نِش حٲصِل کٔرمٕژ دولت پننٮ۪ن باین تہٕ بٮ۪نٮ۪ن منٛز بٲگراوٕنؠ۔"\f + \fr 22‏:8 \ft دُشمنن نِشہ لوٗٹنہٕ آمتہِ مالُک پننٮ۪ن سٲتھی اسرائیل ین سٟتؠ بٲگراونُک حکم چُھ اسرائیل ین ہنٛزِ قدیم ریوایژ سٟتؠ واٹھ کھٮ۪وان۔ گرینٛد. 31:27؛ 1 سموئیلؔ. 30:21-25.\f*
\v 9 چنانچہ روبن، جد تہٕ منسیؔ خاندانکیو اڈیٚو لوکو ترٲوؠ دوٚیِم اسرائیلی کنعان کِس علاقہٕ شیلوہسؔ منٛز۔ تِم آے جلعادؔ کِس علاقس منٛز واپس یُس تُہنٛد اوس، تکیازِ موسیٰؔ ہن اوس خداوند سنٛزِ حکمہٕ مطٲبق سُہ تِمن دیُتمُت۔
\v 10 تِم وٲتؠ کنعانؔ چہِ سرِزمینہِ منٛز دریائے یردن کِس مغربی بٔٹھِس پٮ۪ٹھ۔ تتہِ بنٲو روبنؔ، جد تہٕ منسیؔ کیٚ اڈیو خاندانو ہنٛدیٚو لوٗکو اکھ قربان گاہ یۅسہ واریاہ بٔڈ تہٕ شاندار قربان گاہ ٲس۔
\v 11 اسرائیل کیٚو باقیو لوٗکو بوز اتھ قربان گاہس متعلق۔ تِم ٲسؠ اتھ معاملس منٛز فکرمند زِ روبن، جد اور منسیؔ کیٚو اڈیو خاندانو ہنٛدیٚو لوٗکو کیاہ اوس بنوُمُت۔ یہِ ٲس کنعان ملکہٕ کِس دروازس پٮ۪ٹھ اکھ قربان گاہ۔ یہِ اوسُکھ یردنس نزدیک جیلیلوتؔ شہرس منٛز تتھ جایہِ بنوومُت یُس اسرائیلی سرِزمینہِ ہُنٛد حصہٕ اوس۔
\v 12 اسرائیل یو بوز یہِ تہٕ لوٗکن ۂنٛز سٲرےٕ جماعر گٔیہٕ شیلوہسؔ منٛز جمع۔ تِمو کوٚر امہِ قربان گاہ کہِ وجہ تِمن خلاف جنگ کرنُک فٲصلہٕ۔
\v 13 مگر سارِوےٕ کھۅتہٕ گۅڈٕ، اوس سوزمُت اسرائیل یو الِیعزرؔ سُنٛد نیٚچو فینحاسؔ تہٕ سٲرِی کٲہنی زِٹھؠ روبن، جد تہٕ منسیؔ کٮ۪ن لوٗکن سٟتؠ کتھ کرنہٕ باپتھ۔
\v 14 تِمو سوز دریاے یردن کِس مغربس منٛز اسرائیلی دہَو خاندانو منٛزٕ پرٮ۪تھ کُنہِ منٛزٕ اکھ اکھ زیُٹھ تہِ۔ پرٮ۪تھ کُنہِ خاندانُک زیُٹھ اوس پننہِ پننہِ خاندانُک اکھ اہم رہنما۔
\p
\v 15 تِم زِٹھؠ وٲتؠ جلعادؔ کِس علاقس منٛز روبن، جد تہٕ منسیؔ خاندانکٮ۪ن لوٗکن سٟتؠ کتھ کرنہٕ باپتھ۔ تِمو ووٚن،
\v 16 "باقی سٲری اسرائیلی چھِ پرژھان، "یہِ کیاہ چُھو توٚہہِ کوٚرمُت؟ توٚہہِ چھیٚو خداوند سٕنٛدِ حکمٕچ نافرمٲنی کٔرمٕژ۔ توٚہؠ چُھو یَتھ جایہِ پنٕنؠ قربان گاہ بناوِتھ خداوندس خلاف گٔمٕتؠ۔ توٚہہِ چھیٚو یہُوواہسؔ خلاف بغاوت کٔرمٕژ۔
\v 17 کیاہ توٚہہِ چُھوا مٔشتھےٕ گومُت ییٚلہِ اسہِ خداوند سنٛز عبادت کرٕنؠ ترٲو تہٕ دویمٮ۪ن معبودن ہنٛز عبادت کرنہِ لٔگؠ تہٕ خداوندن کُس سزا دیُت اسہِ؟ خداوندن سوز اسرائیلس منٛز اکھ مہلِک بٮ۪مٲرؠ تہٕ تمہِ سٟتؠ مودؠ واریاہ لوٗکھ۔
\v 18 بنان چُھ زِ توٚہہِ آسیٚو یہِ قربان گاہ امہِ موجُب بنٲومٕژ زِ توٚہہِ ترٲوٕو خداوند سنٛز عبادت کرٕنؠ۔ اگر یہِ پوٚز چُھ تہٕ تیٚلہِ چھیٚو توٚہہِ خداوند سنٛز یتھٕ پٲٹھؠ بغاوت کٔرمٕژ تہٕ سُہ آسہ اسرائیل کٮ۪ن تمام لوٗکن ناراض۔
\v 19 "اگر توٚہہِ باسان چُھو زِ خداوند چُھنہٕ تہنٛز زمین یتہِ عبادت کرنہٕ باپتھ ٹھیک سمجھان، تہٕ یِیو پننِہِ زمیٖنہِ پٮ۪ٹھ واپس، یتہِ خداوند سُنٛد مقدس خٲمہٕ چُھ۔ أسؠ چھِ یژھان پنٕنؠ زمین توٚہہِ سٟتؠ بٲگراوٕنؠ۔ مگر خداوندس یا اسہِ سٟتؠ مٕہ کٔریٚو بغاوت سٲنِس خداوندٕ سٕنٛدِ خٲطرٕ بیاکھ قربان گاہ بنٲوِتھ
\v 20 توٚہہِ آسیٚو بلکل یاد زِ تمہِ وزِ کیاہ اوس گومُت ییٚلہِ زارحؔ سٕنٛدؠ نیٚچوؠ عکنؔن یریحوہسؔ منٛز پٮرٮ۪تھ کانٛہہ چیز تباہ کرنہٕ باپتھ خداوند سٕنٛدِ حکمٕچ نافرمٲنی ٲس کٔرمٕژ؟ أمؠ اکؠ نفرن کٔر خداوند سٕنٛدِ حکمٕچ نافرمٲنی، مگر باقی واریہن اسرائیل ین آو أمؠ سٕنٛدِس کٔرؠ مٕتِس پٮ۪ٹھ سزا دِنہٕ۔\f + \fr 22‏:20 \ft وُچھِو 7:1-26\f*
\v 21 رُوبِنؔ، جدؔ تہٕ منسیؔ کہِ اڈِ خاندانکیو زِٹھیٚو دیُت جواب،
\v 22 "یہُوواہؔ، قدرت وول خداوند چُھ زانان زِ اسہِ کیازِ کوٚر تہِ، تہٕ أسؠ چھِ یژھان زِ ژٕتہِ زان۔ اگر نہٕ اسہِ خداوند سنٛز خدمت کرنُک پنن وعدہ وفا کوٚر تہٕ اسہِ پٮ۪ٹھ مٕہ کٔریٚو رحم بلکہ ہیٚکو امہِ دوٚہہ اسہِ مٲرِتھ۔
\v 23 یوٚدوے اسہِ یِم قربان گاہ امہِ باپتھ بنایہِ زِ أسؠ تراوو خداوند سنٛز فرمانبردٲری کرٕنؠ، یا اگر اسہِ یِم قربان گاہ قربٲنی، پھلُک نذرانہٕ یا أمِس سٟتؠ یارانہٕ کرنٕکہِ وعدہ باپتھ، امہِ باپتھ دِیِن اسہِ خداوند سزا یا نِین سانہِ زندگی پانہٕ۔
\v 24 نَہ، اسہِ بنایہِ یِم قربان گاہ امہِ باپتھ تکیازِ اسہِ اوس خوف زِ مستقبلس منٛز کرن تہنٛدؠ بچہٕ اکہ دوٚہہ سانٮ۪ن زُ سٟتؠ کتھ تہٕ پرٕژھنَکھ، "تُہنٛد کیاہ تعلق چُھ اسرائیل ین ہنٛدِس خداوند سٟتؠ؟"
\v 25 أسؠ چھِ کھوٚژان زِ تِم ونن سانٮ۪ن بچن، "خداوندن بنوودریاے یردن سرحد اسہِ تہٕ توٚہہِ جد کٮ۪ن لوٗکن درمیان تہٕ توٚہہِ روبن کٮ۪ن لوٗکن درمیان۔ توٚہہِ چُھو نہٕ خداوندن سٟتؠ کہین کرُن۔ تہٕ تہنٛدؠ بچہٕ ہیٚکن سانٮ۪ن بچن خداوند سنٛز عبادت کرنہٕ نِشہ رکٲوِتھ۔
\v 26 یتھٕ پٲٹھؠ ووٚن اسہِ، "ؤنؠ بناوو أسؠ اکھ قربان گاہ، مگر نَہ کہِ کُنہِ قربان کرنہٕ خٲطرٕ یا نذرانہٕ خٲطرٕ۔
\v 27 امہِ بدلہٕ، چھِ أسؠ ہژھان زِ یِم بنن پننپِ خٲطرٕ، سانہِ خٲطرٕ تہٕ پننہِ پانہٕ خٲطرٕ اکھ یادگار، زِ أسؠ چھِ پزی خداوند سنٛز عبادت کران۔ أسؠ چھِ پزی تٔمؠ سنٛز عبادت کران پنہٕ نیٚو دزمژو قربٲنیو سٟتؠ، پنہٕ نیٚو قربٲنیو سٟتؠ تہٕ أمِس سٟتؠ یارانُک وعدہ کرنہٕ خٲطرٕ۔ اسہِ بنٲوؠ یِم قربان گاہ تاکہِ تہنٛدؠ اولاد ونن نہٕ سانٮ۪ن اولادن زانہٛہ یہِ، "خداوندن دیُتو نہٕ توٚہہِ یتھ مُلکس منٛز کانٛہہ تہِ حصہٕ۔ توٚہؠ چُھو نہٕ یَتھ زمیٖنہ سٟتؠ تعلق تھاوان۔"
\v 28 مستقبلس منٛز، اگر تہنٛدؠ اولاد یہِ ونن، سٲنؠ اولاد ہیٚکن ؤنِتھ، "یہِ قربان گاہ وُچھِو یس سانیو بزرگو بنومُت اوس۔ یہِ چُھ بلکل شیلوہسؔ منٛز خداوند سنٛز قربان گاہٕکؠ پٲٹھؠ، مگر أسؠ چھِنہٕ اتھ پٮ۪ٹھ قربٲنی زالان۔ یہِ چھےٚ اکھ یادگار یمیُک مطلب چُھ زِ أسؠ تہٕ توٚہؠ کرو رٔلِتھ میلِتھ خداوند سنٛز عبادت!
\v 29 أسؠ چھِنہٕ یقینن یہُوواہسؔ خلاف بغاوت کرٕنؠ یژھان یا یہِ کرُن بنٛد کرُن یژھان یہِ سُہ یژھان چُھ۔ یہِ قربان گاہ ٲسنہٕ امہِ اِرادٕ خٲطرٕ زِ آٹچہِ قربٲنی کیاہ یِن زالنہٕ یا باقی قربٲنیو خٲطرٕ استعمال کرنہٕ۔ اسہِ چھےٚ پتاہ زِ سٲنِس خدا یہُوواہسؔ خاطرٕ چُھ صرف اکھ حقیقی قربان گاہ تہٕ یہِ چُھ مقدس خٟمس برونٹھہٕ کنہِ۔"
\v 30 ییٚلہِ فینحاسؔ کاہن تہٕ اسرائیل ین ہنٛدؠ باقیو داہَو زِٹھیٚو بوز زِ روبنؔ، جد تہٕ منسیؔ کیٚو لوکو کیاہ ووٚن تہٕ تِمہٕ گے خوش۔
\v 31 پتہٕ ووٚن فینحاسیٚو تِمن، "ؤنؠ چھِ، أسؠ زانان زِ خداوند چُھ اسہِ سارنےٕ اسرائیل ین سٟتؠ تہٕ ییٚلہِ توٚہہِ تِم قربان گاہ بنایمژٕ آسو تہٕ توٚہؠ ٲسِو نہٕ تمِس سٟتؠ بغاوت کران۔ تکیازِ یہِ توٚہہِ کوٚرو، توٚہہِ پھُٹرٲیو نہٕ خداوند سٕنٛدؠ قانون، اسہِ چُھ یقین زِ سُہ دِیہ نہٕ اسہِ سزا۔"
\p
\v 32 پتہٕ دراے فینحاسؔ تہٕ اسرائیلی زِٹھؠ روبنؔ تہٕ جد خاندانٕکؠ لوٗکھ جلعادؔ علاقس منٛز ترٲوِتھ تہٕ گے واپس کنعانؔ۔ تتہِ ووٚن تِمو باقی اسرائیل ین زِ کیاہ اوس سپُدمُت۔
\v 33 تِم گے خوش تہٕ کوٚرُکھ خداوند سُنٛد شُکر۔ تِمو کٔر نہٕ مزید کتھ روبنؔ تہٕ جادؔ خاندان کٮ۪ن لوٗکن خلاف لڈنٕچ یا تہنٛدِ ملکُک پرٮ۪تھ کانٛہہ چیز تباہ کرنس متعلق۔
\v 34 روبنؔ تہٕ جادؔ خاندان کیٚو لوٗکو تھوو پنَیہِ نیہِ قربان گاہ "یاد دِہٲنی" ناو تہٕ ونُکھ، "یہِ چھےٚ اسہِ سارٕنےٕ باپتھ یاد دِہٲنی زِ یہُوواہؔ چُھ خداوند۔"\f + \fr 22‏:34 \ft اسہِ درمیان اکھ گواہ زِ خداوند چُھ خدا۔\f*
\c 23
\p
\v 1 واریہو ؤرؠ یو پتہٕ، یوٚت تام خداوندن اسرائیل ین امنہٕ سان روزنُک اجازت دیُتمُت اوس، کٲنٛسہِ دشمن سٕنٛدِ خوفہٕ ورٲے یسوعؔ اوس واریاہ بزرگ گوٚمُت۔
\v 2 یسوعنؔ بلٲے اکہِ دوٚہہ اسرائیل لٕکؠ تمام بزرگ تہٕ زِٹھؠ، پنٕنؠ جج تہٕ افسر امہِ خٲطرٕ زِ تِم یِن تہٕ بوزن امسنٛزٕ کتھ۔ ییٚلہِ تِم آے تہٕ تٔمؠ کٔر کتھ کرٕنؠ شروع: "ؤنؠ چُھس بہٕ عُمر رسیدٕ گوٚمُت۔
\v 3 اسہِ ساروٕے وُچھ زِ خداوندن کیا کیا کوٚر یتھ ملکس منٛز سارنےٕ قومن سٟتؠ۔ سٲنؠ خداوندن لوٚڈ سانہِ باتھ۔
\v 4 مےٚ چھِ توٚہہِ تِم قوم دِتؠ مٕتؠ یِم باقی چھِ۔ تہنٛزٕ زمیٖنہٕ تہِ آسن تہنٛدِ مستقل ملکِیت اسرائیلی خاندانن ہنٛدِ خٲطرٕ، بلکل تِتھے پٲٹھؠ ییٚلہِ بہٕ تہنٛز قیادت اوسُس کران تہٕ یمن لوٗکن ہنٛزٕ زمیٖنہٕ سانیٚو لوٗکو تباہ کرِ، تِم سٲری باقی قوم یِم اسرائیلیٚو مشرقہٕ منٛز یردن دریاوٕ پٮ۪ٹھٕ مغربس منٛز بحیرِ رومؔ تام تباہ کٔرؠ ییٚلہِ بہٕ زیُٹھ اوسُس۔
\v 5 خداوند کڈِ تِمن باقےٕ رودؠ مٕتٮ۪ن لوٗکن تہنٛزِ زمیٖنہِ منٛزٕ نٮ۪بر۔ سُہ چھیٖنہِ تِمن نِشہ تہنٛز زمیٖن تاکہِ توٚہؠ گٔژھیٚو تِمن ملکن منٛز آباد۔ یہِ چُھ تی یہِ تٔمؠ توٚہہِ سٟتؠ کرنُک وعدہ چُھ کوٚرمُت۔
\v 6 خبردار روزیٚو تاکہِ توٚہؠ کٔرِو موسیٰؔ سنٛزِ لٮ۪چھمژِ شریعتچہِ کتابہِ پٮ۪ٹھ عمل۔ تہنز مٕہ کٔرِو نافرمٲنی تہٕ نہ مہٕ بدلٲیو تِمو منٛزٕ کینٛہہ۔
\v 7 اگر توٚہؠ موسیٰؔ سنٛدٮ۪ن قانونس پٮ۪ٹھ عمل کٔرِو تہٕ توٚہؠ رلاؠ ووکھ نہٕ سانٮ۪ن لوٗکن سٟتؠ تِمن لوٗکن ہنٛزٕ جماعتہٕ۔ تہنٛدٮ۪ن خداین ہنٛدؠ ناو تہِ مٕہ ہیٚیِو تہٕ ییٚلہِ توٚہؠ وعدہ کٔرِو یا قسم ہٲیِو تہٕ تہنٛدٮ۪ن خداین ناو کٔریو استعمال۔ تِمن دیوتاہن ہنٛز عبادت مٕہ کٔرِو تہٕ بیٚیہِ مٕہ کٔرِو تِمن سجدٕ۔
\v 8 خداوندس سٟتؠ کٔرِو محبت تہٕ تمِس پٮ۪ٹھ کٔرِو بھروسہٕ یتھٕ پٲٹھؠ توٚہؠ کران ٲسِو۔ تمؠ سنٛز عبادت کرٕنؠ مٕہ کٔرِو بنٛد۔
\v 9 خداوندن کٔرؠ بٔڈؠ تہٕ طاقتور قوم مجبور تہنٛز وتھ اختیار کرنہٕ باپتھ۔ کانٛہہ اکھ تہِ چُھو نہٕ توٚہہِ رُکاونس قٲبل۔\f + \fr 23‏:9 \ft اعمال۔ 7:45\f*
\v 10 توٚہہِ منٛزٕ آسہ ژلنہٕ باپتھ کانٛہہ اکھ سِپاہ تہنٛدٮ۪ن دشمنن ہنٛدِس فوجہٕ منٛز أکِس ساسس نفرس لڑٲے ہیاوناونس قٲبل، تکیازِ تُہنٛد خداوند چُھ تہنٛدِ خٲطرٕ لڑان۔ سُہ چُھ تی یہِ تٔمؠ کرنُک وعدہ چُھ کوٚرمُت۔
\v 11 بس توٚہؠ کٔرِو خداوندس سٟتؠ محبت کرنہٕ خٲطرٕ پرٮ۪تھ کینٛہہ۔
\p
\v 12 یوٚدوے توٚہؠ تہِ کرُن ترٲیِو یہِ خداوند یژھان چُھ؛ اگر توٚہؠ تِمن لوٗکن ساتھ دِیو یِم سانٮ۪ن لوٗکن سٟتؠ جنگ کٔرِتھ بچامٕتؠ ٲسؠ، یا اگر توٚہؠ تِمن سٟتؠ خاندر کٔرتھ تہنٛدؠ دوس بنیو، تہٕ اگر تِم توٚہہِ سٟتؠ یارانہٕ لاگن،
\v 13 تیٚلہِ تھٲیِو توٚہؠ یقین زِ سون خداوند کٔریٚو نہٕ توٚہہِ زبردستی مدد تِمن زمینہِ منٛزٕ کڑنہٕ باپتھ۔ تِم بنن پھندن ہنٛدؠ پٲٹھؠ یِم توٚہہِ رٹن۔ تِم آسن کوڈن ہنٛدؠ پٲٹھؠ یِم ژےٚ کمرس پٮ۪ٹھ لاینَے تہٕ کنٛڈٮ۪ن ہنٛدؠ پٲٹھؠ یِم چانٮ۪ن أچھن منٛز گژھن لٲرِتھ۔ چانہِ قومٕچ جماعت روزِ کمزور گژھان یوٚت تام نہٕ توٚہؠ یتھ ملکس منٛز مٔریٚو، یِژھِ اصل زمییٖنہِ منٛز یۅسہ سٲنؠ خداوندن اسہِ دِژمٕژ چھےٚ۔\f + \fr 23‏:13 \ft گرینٛد۔ 33:55\f*
\p
\v 14 یہِ چُھ میانہِ مرنُک وق۔ یِتھٕ پٲٹھؠ باقی سٲری مران چھِ۔ توٚہؠ چُھو پننہِ اندرون مطٲبق زانان زِ پرٮ۪تھ کانٛہہ کٲم یۅسہ خداوندن توٚہہِ خٲطرٕ کرنُک وعدہ اوس کوٚرمُت۔ تٔمؠ کوٚر تہِ۔
\v 15 تٔمؠ دِتؠ نو توٚہہِ تِم سٲری چیز یمیُک تٔمؠ وعدہ اوس کوٚرمُت۔ یِتھَے پٲٹھؠ باقی چیٖز یمیُک تٔمؠ وعدہ اوس کوٚرمُت، تِم چیز یِم نہٕ ٹھیک چھِ، اگر توٚہؠ بُرٲیی کٔریٚو تِم تہِ گژھن۔ اتھ صوٗرتس منٛز نِیہِ سُہ توٚہہِ نِش تہنٛز زمیٖن تہٕ تہنٛدؠ زُو چھینِتھ۔
\v 16 یوٚدوے توٚہؠ خداوندس تہٕ توٚہہِ درمیان عہدٕچ تعمیل کٔرِو نہٕ تہٕ تمِس ترٲوِتھ کٔریٚو دوٚیمٮ۪ن معبودن سجدٕ تہٕ اتھ پٮ۪ٹھ گژھِ توٚہہِ خداوند تِتھٕ پٲٹھؠ ناراض یتھٕ پٲٹھؠ نارٕ بریہہ وۅتھان چھےٚ۔ سُہ نِیو جلدی تہنٛدؠ زُو، تہٕ یہِ اصل کنعٲنؠ زمین نِیو توٚہہِ نِش چھیٖنِتھ، سوٚے زمیٖن یۅسہ ؤنؠ تٔمؠ توٚہہِ دِژمٕژ چھیٚنو۔"
\c 24
\p
\v 1 یسوعنؔ أنؠ سکِم شہرس منٛز اسرائیلی قومٕکؠ زِٹھؠ، سردار، مُصنف تہٕ باقی منصب دار سمبرٲوِتھ تہٕ سپٕدؠ سٲری پیش خداوند سٕنٛدِس حضورس منٛز۔
\v 2 یسوعنؔ ووٚن یِمن سارِنےٕ "اسہِ اسرائیل ین ہُنٛد خا چُھ فرماوان توٚہہِ سارِنےٕ واریاہ کال برونٛہہ ییٚلہِ تہنٛدؠ جد اجداد یِمن منٛز ابرہامؔ سُنٛد مول تارح تہٕ تسُنٛد کونٛژھ بوے نحورؔ تہِ اوس، دریاے فرات کہِ اپارِ بٹھِ دوٗر أکِس علاقس منٛز روزان ٲسؠ۔ اتہِ ٲسؠ تِم واریہن خداین ہنٛز پوٗزا کران۔\f + \fr 24‏:2 \ft پیدٲیش 11:27 پٮ۪ٹھٕ تام 12:9\f*
\v 3 مگر مےٚ اوٚن تُہنٛد جَد ابرہامؔ اتہِ کٔڈِتھ تہٕ واتہٕ نووُم فراتہٕ اپور کنعانؔ کِس زمیٖنس منٛز۔ مےٚ بخش تمِس اضحاقؔ سٕنٛدؠ نسلہٕ واریاہ زُرؠ تہٕ پر زُرؠ
\v 4 پانہٕ اضحاقسؔ بخشُم یعقوبؔ تہٕ عیسو زٕ گۅبر۔ عیسو ہس دِتِم شِعیرُک کوٚہستٲنؠ علاقہٕ روزنہٕ باپتھ ییٚلہِ زن یعقوبؔ تہٕ تسٕنٛدؠ شُرؠ مِصرس کُن سوزِم یٚتہِ تِم واریہن ؤرین رودؠ۔
\v 5 مےٚ سوزؠ موسیٰؔ تہٕ تسُنٛد بوے ہارونؔ تہِ مِصرٕ۔ مِصرٕ کیٚن لوٗکن پٮ۪ٹھ سوزؠ مےٚ واریاہ عذاب تہٕ تاون۔ امہِ پتہٕ أنؠ مےٚ تہنٛدؠ لوٗکھ مِصرٕ منٛزٕ نٮ۪بر کٔڈِتھ۔
\v 6 ییٚلہِ مےٚ یِم تہنٛدؠ جَد اجداد مِصرٕ نٮ۪بر کٔڈؠ تِم وٲتؠ بحرِ قُلزمؔ کِس بٔٹھِس پٮ۪ٹھ۔ مِصری فوج دوریو یِمن پتے رتھن تہٕ گُرٮ۪ن پٮ۪ٹھ۔ برابر اتھ نرکانؠن ہٛدِس سٕدرس تام"
\v 7 یسوعؔ رود کتھ جٲری تھٲوِتھ، "ییٚلہِ توٚہہِ یہُوواہسؔ متہٕ باپتھ زارٕ پارٕ کوٚرو، تٔمؠ یہُوواہنؔ کوٚر یِمن اسرائیلی لوٗکن تہٕ مِصری فوجس درمیان انہِ گوٚٹ کھڑا۔ تہٕ مِصری فوج وولُن ژۅاپٲرؠ سۅدرکہِ آبہٕ سٟتؠ تہٕ پھاٹنووُن تُہنٛد دُشمن أتھؠ آبس منٛز۔ "یہِ چُھو توٚہہِ یہُوواہؔ ژٮ۪تس پاوان "یہِ مےٚ یِمن مِصری ین سٟتؠ کوٚر تہِ وُو توٚہہِ پانے۔ امہِ پتہٕ رودیو توٚہؠ واریاہ کال صحراوس منٛز۔
\v 8 امہِ پتہٕ واتنٲیو مےٚ توٚہؠ اموریؔ لوٗکن ہنٛدِس ملکس منٛز یِم یردن دریاو کِس مشرقس منٛز روزان ٲسؠ۔ تِم آیہ وٕ اورٕ جنگس۔ مگر مےٚ دِژٕو توٚہہِ یِمن پٮ۪ٹھ فتح تہٕ یِم أنِم تلفس تل توٚہہِ اوٚنو یہُنٛد ملک اتھس منٛز۔ یہِ اوسُس بےٕ یمؠ یِم تلفس تل أنؠ تہٕ مےٚ ہووٕو توٚہہِ یہِ دیدمان زِ مےٚ کیاہ کیاہ کوٚر تہنٛدِ باپتھ۔
\v 9 امہِ پتہٕ آو توٚہہِ پٮ۪ٹھ وۅتلِتھ صفورؔ سُنٛد نیٚچو بلقؔ موآبؔ ملکُک بادشاہ تہٕ توٚہہِ پٮ۪ٹھ یہُوواہؔ سُنٛد بد دُعا حٲصِل کرنہٕ خٲطرٕ اوٚن أمؠ بعورؔ سُنٛد نیٚچو بلعامؔ ناد دِتھ۔\f + \fr 24‏:9 \ft گرینٛد 22:1 پٮ۪ٹھٕ 24:25 تام \f*
\v 10 مگر مےٚ بوز نہٕ بلعامؔ سُنٛد رَژھ تہِ۔ اکھتُےٕ مانرووُم سُہ تسٕنٛدِ باپتھ رُت کانٛچھن وول۔ تہٕ توٚہؠ رٔچھؠ مو تسٕنٛدِ بد دُعا نِشہ۔
\v 11 امہِ پتہٕ آیہِ وٕ توٚہہِ یردن دریاوٕ تٔرِتھ یرہحُو شہرس منٛز یریحُو شہرٕکؠ زِٹھؠ ؤتھؠ توٚہہِ خلاف جنگس۔ یتھٕ پٲٹھؠ زن اموریؔ، فِرزی، کنعانیؔ، حِتی، جِرجاسیؔ، حوی تہٕ یبوسیؔ فوج توٚہہِ خلاف وۅتلِتھ آو۔ مگر مےٚ أنؠ یِم سٲری تہنٛدِس اتھس منٛز۔ مےٚ بنٲیو توٚہؠ تہنٛدِ کھۅتہٕ زیادٕ طاقت ور تہٕ توٚہہِ دِتُو تِمن شِکس۔
\v 12 بےٕ اوسُس تمن انتشار تُلان۔ تِم ژٔلؠ زنٛتہٕ تِمن بد روح پتہٕ ٲسؠ۔ تہٕ توٚہہِ ژلہٕ نٲؠوٕ زٕ اموریؔ بادشاہ ییٚلہِ تہنٛدؠ فوجن برونٛہہ پٔکِتھ یِمن ژٮ۪ل اوٚن۔ مگر یہِ سپُد نہٕ تہنٛزو تلوارو تہٕ ہارنجو سٟتؠ بلکہ اوسُس ژَکہِ بہٕ خداوند توٚہہِ لرِ لوٚر پانہٕ لڈان۔
\v 13 مےٚ دِژٕو توٚہہ زمیٖن یۅسہ نہٕ توٚہہ پانہٕ شیرمٕژ ٲسو تہٕ نَہ وٲیمٕژ مٕژ تمہ مزید دِتمو تِم شہر یم نہٕ توٚہہِ پانہٕ تعمیر کرمٕتؠ ٲسیٚو۔ توٚہہِ تُجو کھیٚنہٕ باپتھ دچھِ رٲنٛٹھو پٮ۪ٹھٕ دچھ یِمنہ توٚہہ رونمژٕ آسو تہٕ کھیٚیو زیتون کُلیٚن ہُنٛد تیٖل یِم نہٕ توٚہہِ لٲگمٕتؠ ٲسیٚو۔
\v 14 یسوعنؔ تھووُکھ جٲری، "وۅنؠ کھوٚژِو یہُوواہؔ تہٕ تسٕنٛدِ عظمتس برونٛہہ کنہِ روزیٚو کلہٕ نۅمرِتھ۔ نیک نیتی سان کٔریٚو أمؠ سنٛز عبادت تہٕ ییٚلہِ تس سٟتؠ کانٛہہ عہد کٔرِیو وفادٲری سان نبٲیو سُہ عہد۔ تِم پۅتٕلؠ ژھٕنیٚو دٲرِتھ یمن تہنٛدؠ اجداد یردن کہِ اپارِ بٹھِ دور۔ تہٕ مِصرس منٛز روزِتھ پوٚزان ٲسؠ۔ چھرا کٔرِیو خداوند سنٛز عبادت۔
\v 15 یوٚدوے توٚہہِ یہُوواہؔ سنٛز عبادت کرٕنؠ چھیٚنہٕ تیٚلہِ کٔرِو أزؠ فٲصلہٕ زِ توٚہہِ کمن خداین ہنٛز عبادت چھےٚ کرٕنؠ۔ یِژھِ کُنہِ تہِ حالٕژ منٛز پزِ توٚہہِ فٲصلہٕ کرُن زِ توٚہہِ چھا پننٮ۪ن جدن ہنٛدٮ۪ن خداین پوٗزُن، یِمن تِم یردن دریاو اپارِ پوٗزان ٲسؠ۔ یا چھا توٚہہِ اموریؔ لوٗکن ہندٮ۪ن خداین پوزن یِمن تِم یتھ زمیٖنس پٮ۪ٹھ پوٗزان ٲسؠ یتھ پٮ۪ٹھ توٚہؠ از روزان چُھو۔ مگر یوٚتام یہِ میون تہٕ میانہِ خاندانُک سوال چُھ۔ أسؠ روزو بس یہُوواہؔ سنٛزےٕ عبادت کران۔
\v 16 اسرائیلیٚو دِتُس یورٕ جواب، "أسؠ تہِ کرو ہمیشہٕ یہُوواہؔ سنٛزےٕ عبادت۔ أسؠ چھِ وعدہ کران أسؠ کرَو زانہٛہ تہِ بیٚیہِ کٲنٛسہِ ہنٛز پوٗزا۔
\v 17 یہِ اوس چھرا یہُوواہؔ یِم أسؠ مِصرٕ منٛزٕ نٮ۪بر کٔڈِتھ أنؠ۔ تٔمؠ أنؠ أسؠ تتہِ بچٲوِتھ ییٚتہِ أسؠ غلام ٲسؠ۔ اسہِ وُچھ دیدمان سُہ معجزٕ کران۔ سفرس دوران تہِ کٔر تٔمؠ اسہِ رٲچھ۔ أسؠ یوٚت تہِ گے تٔمؠ کٔر رٲچھ۔ تٔمؠ رٔچھؠ أسؠ واریہن رازن ہنٛدِ فوجہِ نِشہ۔ أسؠ بنیاے اکۍ عظی قوم تہٕ ژایہِ یتھ زمیٖنس منٛز۔
\v 18 یہُوواہنؔ کھٲلؠ اسہِ برونٛہہ کنہِ سٲری لوٗکھ۔ تٔمؠ ہارنٲوؠ اموریؔ یِم یتھ زمیٖنس منٛز روزان ٲسؠ۔ أسؠ کرو بس یہُوواہؔ سنٛز عبادت تہٕ أمسےٕ برونٛہہ کنہِ تراوو پنُن کلہٕ تکیازِ سُے چُھ سون خداوند۔\f + \fr 24‏:18 \ft اعمال 7:45\f*
\v 19 یسوعنؔ ونُکھ یورٕ، "توٚہؠ ہیٚکِو نَہ یہُوواہؔ سنٛز بندگی کٔرِتھ؛ سُہ چُھ اکھ مقدس پاد خدا تہٕ سُہ دِیو نہٕ کٲنٛسہِ بیٚیِس خدایہِ سنٛز عبادت کرنہٕ۔ پنُن قانون پھُٹراوُن یا کانٛہہ گناہ کرُن کریو نہٕ سُہ زانہٛہ معاف۔
\v 20 یوٚدوے توٚہؠ یہُوواہؔ ترٲؠ وُن تہٕ باقی خدا پوزہکھ اگر سُہ مشراوہن۔ سُہ گژھیٚو ناراض تہٕ تِتھے پٲٹھؠ واتہٕ وایو نقصان یتھٕ پٲٹھؠ تٔمؠ تہنٛدٮ۪ن دُشمنن واتہٕ نوو۔ سُہ زالیٚو نارس منٛز۔ سُہ کٔریٚو یہِ سورےٕ یوٚت خٲر کرنہٕ پتہٕ تہِ یوٚدوے توٚہؠ تس نِش ژٔلِو۔
\v 21 مگر لوٗکو ووٚن یورٕ یسوعسؔ، "ہرگِز نہٕ۔ أسؠ کرو بس یہُوواہؔ سنٛز عبادت"
\v 22 امہِ پتہٕ ونُکھ یسوعنؔ، "توٚہؠ چُھو پانے پنٕنؠ گواہ زِ توٚہہِ ژوروُن یہُوواہؔ تہٕ وعدہ کوٚرو تٔسؠ یوت عبادت کرنُک۔ "تِمو ووٚنُس اور، "آ۔ اسہِ دیُت پنُن وعدہ"
\v 23 امہِ پتہٕ ونُکھ یسوعنؔ، "توٚہہِ پزن پنٕنؠ سٲری سٟتؠ تُلؠ مٕتؠ پوٚتٕلؠدوٗر دٲرِتھ دٕنؠ تہٕ پننہِ پوٗرٕ قوت سٟتؠ پزیٚو توٚہہِ یہُوواہسؔ کُن پھیرُن تہٕ تٔسؠ پنُن خدا زٲنِتھ عبادت کرٕنؠ۔"\f + \fr 24‏:23 \ft غٲر مُلکی دیوتاہن ہنٛدؠ پۅتٕلؠ\f*
\v 24 لوٗکو ووٚنُس یور، "أسؠ کرو چھرا یہُوواہؔ سنٛز عبادت یُس سون خدا چُھ تہٕ تٔسؠ سٕنٛدؠ حکم مانَو أسؠ۔"
\v 25 امے دوٚہہ کوٚر یسوعنؔ لوٗکن سٟتؠ اکھ وعدہ۔ أتی سکِم شہرس منٛزےٕ لیٚکھؠ یسوعنؔ ٲئین تہٕ قانون یِم یہُوواہنؔ یِمن ماننُک حکم دیُت۔
\v 26 تٔمؠ لیٚچھِ تِمہٕ سارے کِتھہٕ یِم خداوند سنٛزِ قانونچہِ کتابہِ منٛز آسہ۔ تٔمؠ تُل اکھ کنہِ پل تہٕ کوٚرپن اِستادٕ سکِم شہرس منٛز تتھ جایہِ یتہِ تھَس یہُوواہؔ سنٛزِ عبادت باپتھ مخصوص جایہِ نکھہٕ شاہ بلعوپک کُل اوس۔
\v 27 یسوعنؔ ووٚن سارنےٕ لوٗکن، "بوزِو۔ یہِ کنہِ پل روزِ یَتھ جایہِ سانہِ عہدُک گواہ۔ یہِ چھےٚ سۅ جاے یتہِ نس اسہِ وعدہ کوٚر زِ أسؠ کرو یہُوواہؔ سنٛز بندگی۔ یہِ پل روزِ اسہِ یہُوواہسؔ سٟتؠ کرنہٕ آمتِس وعدس ژٮ۪تس پاونٕچ جاے تہٕ مذید پاوِ یِتہِ ژٮ۪تس زِ خداوندس سٟتؠ کُنہِ وعدہ خلٲفی ہُنٛد نتیجہٕ کیاہ آسہ۔
\v 28 امہِ پتہٕ سوزؠ یسوعنؔ لوٗکھ پننٮ۪ن پننٮ۪ن کامین کُن۔
\v 29 یِمو واقاتو پتہٕ گو نونؔ سُنٛد نیٚچو یسوعؔ دوٚیمِس عالمس کُن روانہٕ۔ سُہ اوس امہِ وزِ اکھ ہَتھ تہٕ داہ وۅہُر۔
\v 30 تِمو کوٚر سُہ اوسودٕ تمنت نسرہ پنہٕ نسےٕ جایدادس منٛز۔ یہِ جاے چھےٚ جعسؔ بالہٕ کِس شمالس منٛز افرائیمؔ کِس کوٚہستٲنؠ ملکس منٛز۔
\v 31 اسرائیلیٚو کٔر یہُوواہؔ سنٛز عبادت بس یسوعؔ سٕنٛدِس صحبتس منٛز روزن والٮ۪ن زِٹھٮ۪ن نیریس مرنس تامےٕ۔ یِموےٕ اوس دیدمان وُچھمُت زِ یہُوواہنؔ کیاہ کیاہ کوٚر یِمن اسرائیل ین ہنٛدِ باپتھ۔\f + \fr 24‏:31 \ft قٲضؠ 2:7\f*
\v 32 یوسفؔ سنٛزٕ أڈجہ یِم یِمو مِصرٕ منٛزٕ کٔڈِتھ انمژٕ آسہٕ آیہِ سکِم شہرس منٛزے تتھ جایہِ اوسودٕ کرنہٕ یۅسہ یعقوبنؔ سٮ۪ٹھا برونٛہہ سکِم سٕنٛدِ مٲلِس حمورسؔ رویہِ ہنٛدٮ۪ن ہتن سِکن مٔلؠ ہٮ۪ژمٕژ ٲس۔ یہِ زمیٖنہِ ٹُکرہٕ بنییہِ یعقوبؔ سنٛدٮ۪ن زُریٚن ہنٛز مستقل ملکِیت۔\f + \fr 24‏:32 \ft پیدٲیش 33.18-20؛ اعمال 7:16\f*
\v 33 ہارونؔ سُنٛد نیٚچو الِیعزرؔ تہِ سپٕدؠ أتھؠ دوران دوٚیمِس عالمس کُن روانہٕ پتہٕ آو افرائیمؔ کِس کوٚہستٲنؠ علاقس منٛزے پننِس نیٚچوؠ فینحاسؔ سٕنٛدِس جباہؔ ناوکِس شہرس منٛزےٕ اوسودٕ کرنہٕ۔
