\id MRK - DMT Kashmiri
\toc1 مرقُس
\mt1 مرقُس
\c 1
\p
\v 1 خدایہِ سُنٛد گۅبُر یسوعؔ مسیحؔ سنٛز رٕژ شیٚچھ گییہِ یتھٕ پأٹھؠ شروع۔
\v 2 \f + \fr 1‏:2 \ft ملاکی 3:1، متی 11:10، لوقا 7:27\f*یہِ رٕژ شیٚچھ گییہِ تمہِ وزِ شروٗع ییٚلہِ نبی یسعیاہنؔ سیٹھاہ برونٛٹھ لیٚوکھمُت اوس" وُچھِو، بہٕ سوزن پنُن رسول ژےٚ برٛونٹھےٕ۔ سُہ کرِ لوٗکن تیار تمہِ وقتہٕ خٲطرٕ ییٚلہِ ژٕ یکھ۔
\v 3 \f + \fr 1‏:3 \ft یسعیاہؔ 40:3\f*کُستام چُھ بیابانن منٛز ناد دِوان، "پنن پان کریو خداوندٕ سنٛزِ خوش آوے خٲطرٕ تیار۔ تہٕ بنٲیو تمؠ سنٛدِ باپتھ وتھ سیٚود۔
\v 4 یمِس رسولس متعلق یسعیاہنؔ لیٚوکھ سُہ اوس یوحناؔ۔ یمِس لوٗکو ووٚن "بپتسمہ دنہٕ وول۔ "یوحناؔ آو بیابانن منٛز اردن دریاوس نکھٕ۔ سُہ اوس لوٗکن بپتسمہ دِوان، بیٚیہِ اوس توبہ تہٕ گناہ معاف کرنہٕ باپتھ بپتسمہ ہُک تبلیغ کران۔
\v 5 پتہٕ وٲتؠ یہُوداؔ ملکٕکؠ تہٕ یروشلمٕکؠؔ ساری لوٗکھ أمِس نِش۔ تِم ٲسؠ پننؠن گناہن ہُنٛد اقرار کران تہٕ سُہ اۅس تِمن دریایہِ یردنس منٛز بپتسمہ دِوان۔
\v 6 \f + \fr 1‏:6 \ft بادشاہ 2۔ 1:8، متی 3:4، 1۔ \f*یوحناہسؔ اوس اونٛٹ جژٔ ہُنٛد لباس لأگِتھ تہٕ کمبرس اوسس دالو ہوٚل گٔنڈِتھ، سُہ اوس ہالو تہٕ جنٛگلی مانٛچھ کھیٚوان۔
\v 7 تٔمؠ کوٚر تبلیغ زِ" مےٚ پتہٕ ییہِ اکھ زوراور شخص یمِس نہٕ بہٕ کھۅربانہٕ صاف کرنَس تہِ لگہٕ۔
\v 8 مےٚ دیتو توٚہؠ آبہٕ سٟتؠ بپتسمہ مگر سُہ دِیو توٚہہ پاک روح سٟتؠ بپتسمہ۔"
\v 9 یہِ واقہٕ سپُد تِمن دوٚہُن ییٚلہِ یسوعؔ گلیل کِہ شہر ناصرت پٮ۪ٹھٕ آو تہٕ یوحناؔہن دیٚت تمِس دریایہِ یردنس منٛز بپتسمہ۔
\v 10 یتھےٕ یُسوعؔ آبہٕ منٛزٕ کھوٚت تہٕ تمؠ وُچھ آسمانس چاکھ گژھان تہٕ خدایہِ سُنٛد روح ووٚتھ أمِس پؠٹھ کوتُر سنٛدؠ پٲٹھؠ۔
\v 11 آسمانہٕ پؠٹھٕ آیہِ آواز، "ژٕ چُھکھ میٚون ٹوٹھ گۅبُر۔ بہٕ چُھسے ژےٚ سیٹھاہ خوش۔"
\v 12 پتہٕ سوز خدایہِ سنٛدؠ روحَن یسُوعؔ وٲران علاقس کُن۔
\v 13 سُہ رود بیابانن منٛز ژَتجہَن دوٚہُن، شیطانن اوس تس ورگہٕ لاوان۔ سُہ اوس وحشی جنَگلی جانورن منٛز تہٕ فرشتہٕ رودِس خدمتس۔
\v 14 یوحناؔ سٕنٛدِ جیل برنہٕ پتہٕ ووت یسوعؔ گلیلس منٛز تہٕ خدایہِ سنٛدِ بجرٕچ رٕژ شیٚچھ لوٚگ لوٗکن وننہِ،
\v 15 سُہ اوس ونان، "ٲخٕر کار ووت سُہ وقت۔ خدایہِ سنٛز بادشٲہی چھِےٚ نزدیک، توبہٕ کٔرِو رٕژِ شیٚچھہِ پؠٹھ پژھ۔"
\v 16 اکہ دوٚہہ ییٚلہ گلیل سمندرکہ بٔٹھؠ بٔٹھؠ یسوعؔ پکان اوس تمٔس پیٚیہِ شمعونؔ تہٕ امسنٛدِس بٲیس، اندریاسسؔ پٮ۪ٹھ نظر، یِم سمندرس منٛز زال ترٛٲوِتھ گاڈٕ ٲسؠ رٹان: تِم ٲسؠ گاڈٕ رٹنس تہٕ کٕننس پؠٹھ پأنسہٕ کماوان۔
\v 17 یسوعنؔ ووٚن تِمن، "یتھٕ پٲٹھؠ توٚہہ گاڈٕ چُھو جمع کران، ؤلِو مےٚ سٟتؠ، بہٕ ہیچھناوَو توٚہہ کتھٕ پٲٹھؠ چھِ لوٗکھ میٲنؠ شٲگرد بننہٕ خٲطرٕ جمع یوان کرنہٕ۔"
\v 18 ؤلؠ ؤلؠ ژٕھنؠ تِمو زال ترٲوِتھ تہٕ درٛایہ یسوعؔ ہس پتہ پتہٕ۔
\v 19 یُتھےٕ یسُوعؔ رژھا برُونٛہہ پوٚک تہٕ یسوعنؔ وُچھ زبیدیؔ سُنٛد نیٚچو یعقوبؔ، جیمس تہٕ أمؠ سُنٛد بوے یوحناؔ، یِم پننہِ ناوِ منٛز زال گنڈان ٲسؠ۔
\v 20 یسُوعہنؔ دیٚتُ یَمن ؤلؠ ؤلؠ آلو تہٕ تمِو ترٛوو پنُن مول تہٕ کرایہِ پیٚٹھٕکؠ مُزور ہٮ۪تھ ناوِ منٛز أتی تہٕ درٛایہِ أمِس پتہٕ پتہٕ۔
\v 21 یسوعؔ، گوٚو پطرسؔ، یعقوبؔ تہٕ یوحناؔ ہٮ۪تھ نزدیک کفرنحوم شہرس منٛز۔ تتہِ لاجؠ یسوعنؔ  یہُودؠ عبادت خانس منٛز سبتکہٕ دوٚہہ تالیٖم دِنؠ۔
\v 22 لوٗکھ گےَ أمؠ سنٛز تعلیم بوزِتھ حٲران۔ أمؠ ہیٚچھِ نٲوؠ أکِس زانن وٲلِس ووستادٕ سنٛدؠ پٲٹھؠ۔ أمؠ ہیٚچھِ ناو نہٕ یہُودؠ شریعت ہیٚچھناون والیٚن ھُندٕ پٲٹھؠ، یِم مختلف چیٖز دُھراون ٲسؠ یمؠ تِمن باقیو نفرو ہیٚچھنٲوؠ متؠ ٲسؠ۔
\v 23 تہٕ تہندِس عبادت خانس منز اوس اکھ نفر یتھ ناپاک روح، تٔمؠ دِژٕ کریکہٕ۔
\v 24 سُہ اوس ونان، "ہے! یسوعؔ ناصری، ژیے کیاہ چُھے اسہِ ناپاک روحن ستؠٕ! کیاہ ژٕ چُھکھا آمُت اسہِ مارنہِ؟ مےٚ چھِےٚ پتاہ ژٕ کسُ چُھکھ۔ ژٕ چُھکھ خدایہِ سُنٛد اکھ پاک روح۔"
\v 25 یسوعؔن دِژ ناپاکھ روحس بےیزتی، تہٕ ووننس، "ژھۅپہٕ کر أمِس شخصس منٛز نیر نٮ۪بر!"
\v 26 تہِ أمؠ ناپاک روحن دِژ أمِس دٕننَ تہِ بجہ کرٛیٚکہٕ دِتھ درٛاؤ أمِس منٛزٕ نٮ۪برَ۔
\v 27 عبادت گاہس منٛز موجود سٲری لوٗکھ گےَ یہِ وُچِھتھ حٲران۔ نتِجہِ دراو، تِمو لوگ پانہٕ وٲنی بحث کرُن، "یہِ چُھ نہٕ اسہِ زانٛہہ بوزمُت! یہِ چُھ نہٕ صرف نٔوِس تہٕ حٲکمانہٕ انٛدازس منٛز تعلیم دِوان۔ سُہ چُھ ناپاک روحن تہِ حکم کران پتہٕ چھِ تِم أمؠ سُنٛد مانان۔"
\v 28 تہٕ تمِس مُتعلِق پھٔلییہِ فوراً شہرت گلیلس أنٛدؠ پٔکؠ تمام علاقن منٛز۔
\v 29 یہُودؠ عبادت خانہٕ منٛز نٮ۪برَ نیرتھ گییہِ تِم یعقوبؔ یوحناؔ ہس سٟتؠ سیٚودے شمعونؔ تہٕ اندریاؔ سُنٛد گرٕ۔
\v 30 شمعونؔ سنٛز ہش ٲس بسترس منٛز تکیازِ سۅ ٲس بیمار تمِس اوس تپھ۔ کمؠ تام ووٚن دوٗرے پہن یسُوعؔ ہس تُہنٛدس بیمار آسنس متُلق۔
\v 31 یسُوعؔ گوٚو أمِس نِشہ تہٕ اتھٕ رٔٹتھِ تجِن سۅ تھوٚد۔ تہٕ تمٔس ووٚتھ تپھ ؤلؠ ؤلؠ تہٕ لٔاجن یہٛنزٕ خدمت کرٕنؠ۔
\v 32 تمہِ دوٚہہ شامن، آفتاب لوسنہٕ پتہٕ، انؠ انٛدؠ پٔکؠ علاقو منٛز لوٗکو سأری بیٚمار تہٕ کھوژِمٕتؠ لوٗکھ أمِس نِشہ۔
\v 33 یہِ زَن تہِ باسیوو شہرٕکؠ تمام روزان وٲلؠ لوٗکھ گےَ شمعونسؔ گرَہ کسِ دروازس پٮ۪ٹھ جمَع۔
\v 34 یسُوعؔ ہنَ کٔرؠ مختلف بیمارین منٛزٕ آوٕرؠ لوٗکھ ٹھیک۔ تم کٔرؠ واریہن لوٗکن منٛز بدروح نیٚبر۔ أمؠ دیت نہٕ بدروحن پانس متعلق کہنٛہ وننکُ اجازت تکیازِ تِمن ٲس پتاہ یہِ چُھ خدایہِ سنٛدِ طرفہٕ اکھ پاک ذاتھ۔
\v 35 یسُوع ووٚتھ صبُہس انہ گٹہِ تہٕ درٛاو أکِس وٲران جایہِ کنُ تتہِ ٲسؠ نہٕ لوٗکھ۔ پتہٕ کوٚر تٔم دُعا۔
\v 36 شمعونؔ تہٕ أمؠ سنٛدؠ سٲتھی درٛایہِ یسُوعؔ ہس ژھانٛڈنہِ۔
\v 37 ییٚلہِ سُہ تِمو لوٛب تہٕ ووٚن ہس "ژیے چھےَ شہرُک ہرَ کانٛہہ نفر ژھانٛڈان۔"
\v 38 یسُوعؔ ہن ووٛن تِمن، "اسہِ چھےٚ ضروٗرت یمہِ علاقہٕ کؠن باقیو شہرن منٛز تہِ گژھنچ تاکہِ بہٕ ہیٚکہٕ اصل پٲٹھؠ تتہِ تبلیغ کٔرتھ۔ امی سببہٕ آس بہٕ یوٗر۔"
\v 39 لہٰذا، پھیٚرؠ تِم سٲرسےٕ گلیل کِس علاقس۔ تم کوٚت کۅٚت وٲتؠ، یسوعؔ اوس یہُودؠ عبادت خاننَ منٛز تبلیغ کران بیٚہِ بد روحن اوس لوٗکو منٛز نیٚبر نیرنس پؠٹھ مجبور کران۔
\v 40 اکہ دوٚہہ آو اکھ مینٛدؠ لد بیمار یسُوعؔ ہسَ نِشہ۔ سُہ نمیو یسوعؔ ہس برُونٛہہ کنہِ تہٕ کوٚرن تمِس زارٕ پارٕ۔ "مہربٲنی کٔرتھ کرتہٕ مےٚ صاف، تکیازِ ژٕ ہیککھ مےٚ صاف کرتھ اگر ژٕ یژھکھ!"
\v 41 یسُوعؔ ہسَ آو تسند عار۔ تٔم کوڈ پنن اتھٕ نٮ۪بر تہٕ ڈولن تمِس نفرس تہٕ ووننس، "یہِ چُھ میٲنؠ اِرادٕ ژٕ بلؠ راون، لہٰذا بل!"
\v 42 دستی بلیوو سُہ نفر! تہٕ سُہ اوس نہٕ وُنؠ مینٛدؠ لد!
\v 43 یسُوعؔ ہن کوٚر سُہ نفر خبردار زٕ ژٕ نیر یتہِ۔
\v 44 \f + \fr 1‏:44 \ft احبار 14:2۔ 32\f* ووٚنس، "یتُھ نہٕ کٲنسہِ نکھ، بلکہ گژھِ پنُن پان ہاو کاہنس تاکہِ سُہ وچھِ آیا ژٕچھکھا مینٛدِ نِشہ آزاد گوٚمت کِنہٕ نہٕ۔ پتہ کرِ نذرانہٕ پیش یمک حکم موسیٰؔ ہن تِمن لوٗکن دِیتمت اوس یِمنَ خداین مینٛدِس شفأ کوٚر، یہِ بنہِ عُوامس نِشہ گواہی زِ ژٕ چُھکھ نہٕ وُنؠ مینٛدؠ لد۔"
\v 45 أمؠ شخصن کٔرنہٕ یسُوعؔ سنٛدِس ہدایتس پٮ۪ٹھ عمل، سُہ دراو نیٚبر تہٕ لوگُن سارِنےٕ ونُن زِ یسوعنؔ کِتھہٕ پٲٹھٗؠ اوس سُہ ٹھیک کوٚرمُت۔ یسُوعؔ ہیٚوک نہٕ وۅنؠ نٔنؠ پٲٹھؠ کُنہِ تہِ شہرس منٛز ٲژتھ بلکہ روٚد وجارٕ جاٮ۪ن یتہِ نہٕ کانٛہہ بسان اوس۔ مگر لوٗکھ روٗدِ یسوعؔ ہس نِشہ تمہِ سارے علاقہٕ پؠٹھٕ یوان۔
\c 2
\p
\v 1 کینٛہہ دوٚہہ گٔژھتھ ییٚلہِ یسُوعؔ کفرنحوم واپس آو، یہِ خبرَ پھٲلیِیہ زِ یسوعؔ اوس واپس آمُت تہٕ سُہ چُھ أکِس مخسوٗس گرِس منٛز\f + \fr 2‏:1 \ft شاید آسہ ہے یہِ شمعون پطرسؔ سُنٛد گرٕ۔ \f*۔
\v 2 یتہِ گےَ بٔڈس تعدادس منٛز لوٗکھ جَمع۔ تتہِ ٲس نہٕ دروازس نِشہ تہِ لتھ ترٚاوٕنسَ باتھ۔ یسُوعؔ اوس تِمنَ خدایہِ سٕنٛدِ کلامُک تبلیغ کران۔
\v 3 تتھ گرس منٛز وٲتؠ کینٛہہ نفر اکھ فالجہِ لد شخص ہؠتھ۔ یمِسِ ژوٗر مہنیٚو ڈانجہ پؠٹھ پکناوان ٲسؠ۔
\v 4 لوٗکن ہنٛدِ گنٛرٕہ کِنؠ ییٚلہِ نہٕ تِم یسُوعؔس نِشہ وٲتِتھ ہیٚکؠ، تمِو نہَنوو پیٚٹھؠ کنؠِ پش تہٕ ؤتھؠ وۅگہٕ ژٔٹتھ ڈٲنجہِ سان یہِ فالجہِ لد یسوعؔ ہس نِشہ۔
\v 5 یمِنَ لوٗکن ہُنٛد ایمان زانتھ ووٚن یسوعنؔ أمِس فالجہِ لد شخصس، "گۅبریا چٲنؠ گناہ ٲئے معاف کرنہٕ!"
\v 6 اتہِ أسؠ شریعت زانن وٲلؠ کینٛہہ شخص بہِتھ۔ تِم لٔگؠ پانس سٟتؠ سونٛچنہِ۔
\v 7 \f + \fr 2‏:7 \ft یسعیاہؔ 43:25\f* "یہِ کِتھٕ پٲٹھؠ ہیٚکہِ یہِ کتھ ؤنِتھ ہے کفُر چُھ! کسُ ہیٚکہ گناہ معاف کٔرتھ صرف خدایس بغٲر؟"
\v 8 یسوعؔن زون یہِ ؤلؠ ؤلؠ پننس روحس منٛز  تہِ یہِ یِم سونچان ٲسؠ۔ تٔمؠ ووٚن تِمنَ، "تہنٛدٮ۪ن دِلنَ منٛز کیازِ یِتھؠ خیال وتھان؟ مےٚ چُھنا کانٛہہ حق گناہ معاف کرنکؠ؟
\v 9 کیاہ فالجہِ لدسَ یہِ ونُن چھا سُہلیےٕ، "چٲنؠ گناہ آے معاف کرنہٕ "یاہ "وۅتھ تھوٚد! تلُ پننؠ ڈٲنج تہٕ پکھ؟"
\v 10 مگر بہٕ چُھسو توٚہہِ یہِ زٲنؠ راوُن یژھان زِ آدمؔ سنٛدِس گۅبرس تہِ چُھ زمیٖنہِ پٮ۪ٹھ گناہ معاف کرَنک اختیار، تمٔؠ ووٚن فالجہِ لدسَ،
\v 11 "وۅتھ تھوٚد! تلُ پنٕنؠ ڈٲنجؠ تہٕ گژھِ گرٕ!"
\v 12 سُہ مہنٛیو ووٚتھ تھوٚد۔ تجِن جلدٕے پنٕنؠ ڈٲنجؠ تہٕ دراو سارِنےٕ برونٛہہ کِنؠ گرٕ کنُ۔ یتھٕ کِنؠ گےَ سأری حٲران تہٕ لٔگؠ خدایہِ سنٛدؠ تعریف کرنہِ، تِمو ووٚن، "اسہِ چُھنہٕ یُتھ واقہٕ زانہٛہ تہِ وُچھمُت!"
\v 13 یسُوعؔ ہن تروو کفرنہوم قصبہٕ تہٕ درٛاو بیٚہ گلیل کِنؠ سمندرٕ بٔٹھؠ بٔٹھؠ۔ تمِس نِشہ گےَ سیٹھاہ لوٗکھ جَمع، تہٕ دِژنَکھ تعلیم۔
\v 14 یُتھُے سُہ برُونٛہہ کنُ پوٚک امؠ وُچھ حلفیؔ سُنٛد نیٚچو لاوی گُزرسَ پٮ۪ٹھ بہتٕھ۔ أمؠ ووٚن أمِس، "پکھ مےٚ سٟتؠ، بن میون چہلہٕ۔ "سُہ ووٚتھ تہٕ دراؤ یسُوعؔ ہس پتہٕ پتہٕ۔
\v 15 یسوعؔ اوس لاوی سنٛدِ گرِ بتہٕ کھیوان۔ واریاہ ٲسؠ محصول جمع کران  یمن مذہبی سردار گناہ گار سمَجھان أسؠ، تہٕ ٲسؠ یسُوعؔ ہسَ تہٕ انَدٮ۪ن چہلن سٟتؠ کھیٚوان چٮ۪وان۔ یَتھٕ پٲٹھؠ پٔکؠ یسُوعؔ ہسَ پتہٕ پتہٕ واریاہ لوٗکھ۔
\v 16 ییٚلہِ شریعتہٕ کیو عٲلمَو، یِم فریسی فرقکؠ رُکنَ أسؠ، وُچھ یِمؠ گُذر وان گُۅنہگار لوٗکھ، یسُوعؔ ہس سٟتؠ کھٮیٚوان چیٚوان۔ تِمو پرُوژھ اہنَدین چہلنَ: یہِ کیازِ چُھ گُذر ہیٚنہ والیٚن گناہ گار لوٗکن سٟتؠ کھیٚوان چیٚوان؟"
\v 17 پتہٕ یہٕ بوزِتھ پرُوژھ یسوعؔنَ تِمنَ نفرن یِمؠ یہُودؠ شریعت ہچھناوان أسؠ، "صحت منٛد لوٗکن چھنہٕ حکیمہٕ سنٛز ضرورت آسان۔ بلکہ چھےٚ بیمارن چھِ حکیٖم سنٛزٕ ضروٚرت آسان۔ بہٕ چُھس نہِ نیکو کارن ہنٛدِ باپتھ آمُت بلٔؠ کہ چُھس بہٕ گناہ گارن ہنٛدِ باپتھ آمُت۔"
\v 18 أمؠ ساعتہٕ ٲسؠ یوحناؔ سنٛدؠ مرید؛ تہٕ فریسی فرقکؠ روزدار۔ تِم آیہِ تہٕ پرٕٛۅژکھ یسُوعؔ ہس، "یوحناؔ سنٛدؠ چہلہٕ تہٕ فریسی چھِ روزدار روزان ییٚلہِ زَن چٲنؠ چہلہٕ چھنہٕ روزدار روزان؟"
\v 19 یسوعؔن ووٚن تِمن، "ییٚلہ اکھ نفر اکِس زنہِ سٟتؠ خاندر کران چُھ تہٕ تس سٟتؠ آمٕتؠ سالرٕؠ روزنا ییٚنہِ وٲلِس اندر روزدار یۅتام مہرازٕ یِمن سٟتؠ چُھ یمہ ہیٚکن نہٕ روزدر روٗزتھ۔
\v 20 پوٚز تِم دوٚہہ یِن ییٚلہِ زن مَہبادشاہ یِمن نِش جُدا ییہِ کرنہٕ تِمن دوٚہُن روزن ادٕ تِم روزدار۔"
\v 21 یسُوعؔ گوٚو تِمنَ ونان، "لوٗکھ چھِنہٕ پرانیٚن پلون نَوِ کپرٕچ دٔج لاگان، اگر وُنؠ لاگہوس یہِ ژَٹہِ پرٲنؠ ہنَ تہِ۔ نتیجہِ نیرہ پلوک زوٚد گژھِ بڈِ کھوٗتہٕ بوٗڈ!
\v 22 یتھے پٲٹھؠ، لوٗکھ چُھنہٕ نوو شراب پرانیٚن مشقن منٛز بران، تکیازِ تازٕ شٮراب پھاٹناوہِ دالسَ تہٕ شٮراب تہِ ضایہِ تہٕ مشق تہِ۔ بہٚتھر چُھ نوٚو شٮراب برَو نویٚن مشقن منٛز!"
\v 23 \f + \fr 2‏:23 \ft احبار 23:25\f*سبتکہِ دوٚہہ ٲسؠ یسُوعؔ تہٕ تسٕنٛدؠ چہلہٕ فصلہٕ دار کھہَو مٔنٛزؠ پکان۔ امسنٛدیٚو چہلو لٲگؠ ہیٚلؠ ژَٹٔنؠ۔
\v 24 کینٛہہ فریسی أسؠ یہٕ وچھان تہٕ تِمو ووٚن یسُوعؔ ہس، "یوٗر کنُ وُچھ یِم کیازِ چھِ سَبتٕکہِ دوٚہہٕ غلط کٲم کران؟ یۅسہ سبتکہِ دوٚہہ بلکل جٲیز چھِنہٕ۔"
\v 25 یسوٗعؔ ہنَ ووٚن تِمنَ، "توٚہہِ چُھو نا زانٛہہٕ تہِ پورمت ییٚلہِ بادشاہ داوود تہٕ تمٔؠ سنٛدؠ سأتھی نفر بۅچھِ ۂتؠ ٲسؠ؟"
\v 26 \f + \fr 2‏:26 \ft سموئیلؔ 21:1۔ 6\f*تِمنَ دوٚہُن اوس ابیاترؔ زیٹھ کاہن، بادشاہ داوودؔ ژاو خدایہِ سنٛدِس گرس منٛز تہٕ منٛجن کینٛہہ ژۅچہِ۔ زٹھؠ کاہنن دِژٕ ٲمس تِمہٕ ژۅچہِ یِم خدایس برونٛہہ کنہِ نیازِ باپتھ تراوِمژِ آسکھ۔ شریعتہٕ متابق ہیٚکہ ہن یِم ژۅچہِ چھرا کاہن ہوٛت کھؠتھ! مگر داوودنؔ کھیٚیہِ کینٛہہ ژۅچہِ۔ تِمن تہِ دِژن یِم أمِس سٟتؠ ٲسؠ۔"
\v 27 یسُوعؔ ہنَ ووٚن مزید تِمنَ، "خداین بنَۅو سبت اِنسانہِ سنٛدِ آرامہٕ خٲطرٕ۔ تِم بنَنووٛ نَہ یہٕ آرامُک دوٚہہ انسانہِ سٕنٛدِ باپتھ کانٛہہ بور۔
\v 28 لہٰذا، صاف پٲٹھؠ، یہِ آدمؔ سُنٛد گۅبُر چُھ، سبت دوٚہُک تہِ خداوند!"
\c 3
\p
\v 1 یسوعؔ ژاو دویمِس دوٚہس پؠٹھ یہُودؠ سبتکہِ دوٚہہ پتہٕ بیٚیہِ یہُودؠ عبادت خانس منٛز تتہِ اوس اکھ شخص یمِس اتھٕ ہوٚکھمُت اوس۔
\v 2 کینٛہہ فیریسی فرقککھ لوٗکھ ٲس زاگہِ روٗزتھِ وُچھان، اگر أمؠ سَبتٕکہِ دوٚہہ أمِس ٹھیک کوٚر تہٕ یِمن ییہِ ہے وار ٲمِس راہ کھالنسَ۔
\v 3 یسوعؔن ووٚن أمِس اتھٕ رٔنِس، "ووٚتھ تھوٚد تہٕ گژَھ سارِنےٕ منٛز باگ اِستادٕ۔ "سُہ شخص ووٚتھ تھوٚد۔
\v 4 پتہٕ ووٚن یسوعؔن لوٗکن، "کیاہ سُہ شریعت یُس خداین موسیٰؔ ہسَ عطا کوٚر، چھِ اجازت لوٗکن دِوان زٕ سبت کہِ دوٚہہ  گژھؠ نیکی یا بدی کرنؠ؟ کیاہ سبتکہِ دوٚہہ کأنٛسہِ ہنٛزٕ زندگی بچاوٕنؠ، یاہ کانٛہہ مارُن، یا کأنٛسہِ شخصس مدد نہٕ کرُن زِ سُہ مَرِؠن؟" تتہِ گےَ سٲری کٔلؠ۔
\v 5 یسَوعؔ ہن ترٲو شٮرارتہٕ ہوٚت اوکُن یوکُن نظر، لوٗکن ہنٛزٕ سنٛگدِلی وُچِھتھ گوٚو مایوٗس تہٕ ووٚنُن أمِس شخصس، "پُنن اتھٕ زیٹھٕ راو۔ تٔمؠ کوٚڈ اتھٕ نٮ۪برَ تہٕ امؠ سُنٛد اتھٕ گو ٹھیک۔
\v 6 اوٕ پتہٕ دراے فریسی ہیکلہٕ منٛزٕ نٮ۪بر۔ تہٕ ؤلؠ ؤلؠ سمکھیٚو تِمن کٮ۪نژن یہودٮ۪ن یِم ہیرودیسؔننؠ مدد کرن والیٚن لوٗکن سٟتؠ ٲس ہیرودیسی ٲس گلیلکس اتھ علاقس پٮ۪ٹھ حکومت کران۔ تِمن کوٚر یسوعؔ ہلاک کُرنک مشورٕ۔
\v 7 یسوعؔن تہٕ أمؠ سنٛدیو چہلو تروٚو ییہِ شہر تہِ تِم درٛایہِ پتہٕ گلیل کِس سمندر سٟتؠ تتھ دوٗر أکِس علاقس کنُ۔ لوٗکن ہُنٛد اکھ بوٚڈ گرٛوٚو دراو أمِس پتہٕ پتہٕ۔ گلیل تہٕ یہُودیہ علاقو پؠٹھٕ آمُت لوٗکھ ٲس تمِس پتہٕ پتہٕ پکان۔
\v 8 شہرٕ یروشلم، علاقہٕ عدومیہؔ، دریایہِ یردنکہِ مشرقی علاقہٕ تہٕ صور تہٕ صیدا شہرکٮیٚو انٛدؠ پکھؠ علاقو پٮ۪ٹھٕ آو لوٗکھ۔ تِم آیہِ یسوعؔ نِش تکیازِ تِمو اوس بوزمُت سُہ کیاہ کامہ اوس کران۔
\v 9 تمؠ ٲسؠ واریاہ لوٗکھ بٔلرٲیمٕتؠ اوے ٲسؠ واریاہ بؠمار لوٗکھ أمِس اتھٕ لاگنہٕ باپتھ اکھ أکس دہکہٕ دِیت برونٛہہ کُن یوان۔ تِمن اوس یقین زِ ہرگاہ تِمو صرف اتھٕ لوٗگ تِم سپدن صحت یاب۔ لہٰذا ووٚن تمؠ پننؠن شٲگردن زِ تِمن پزِ تمؠ سٕنٛدِ خٲطرٕ أکس ناوِ ہنٛد انتظام کرُن یتھ نہٕ لوٗکھ تمس لاتہٕ موٗنڈ کرن ییٚلہِ تِم دہکہٕ دِیت تمس اتھٕ لاگنہٕ باپتھ برونٛہہ کُن یوان۔
\v 10 تکیازِ تِمؠ ٲس واریاہ لوٗکھ صحت یاب کرٕمتؠ، رنگہٕ رنگہٕ بٮ۪مار لوٗکھ ٲسؠ اِکس اِکھ دکہ دتھِ أمِس اتھٕ لاگنچ کوٗشِش کران، تِمن اوس یقین زِ اِمہِ سٟتؠ گژھن تِم ٹھیک۔ توے ووٚن یسوعؔن پنہٕ نیٚن چہلن، میانہِ خأطرٕ کٔریو لۅکچہ ناوِ ہُنٛد بنُدوبسَ خبر بہٕ ما گژھٕ لتہٕ مۅنٛجہ ییٚلہِ تِم مےٚ برونٛٹھ کنُ اتھٕ لاگنہٕ باپتھ دکہٕ دکہٕ کٔرتھ ین۔
\v 11 ییٚلہِ تہِ زانٛہہ بد روح تہٕ ٲسؠ یسوعؔ ہس وُچھان تِم ٲسؠ أمِس برونٛٹھٕ کِنہٕ ؤسؠ پیوان تہٕ آسکھ کریٚکہٕ نیرتھ ژلان، ٲس ونان، "ژٕ چُھکھ خدایہِ سُنٛد گۅبُر۔"
\v 12 یسوعؔ اوس تِمن بد روحن تنٛبیہہ کٔرتھ ونن لوٗکن مٕہ ونوِ۔
\v 13 تھؠ وقتس دوران گو یسوعؔ بالس پؠٹھ دُعا منٛگنہِ تہٕ دِتنُ تِمنَ ناد یِم أمِس یژھان ٲسؠ تہٕ تِم وٲتؠ أمِس نِش۔ تہٕ پٔکس پتہٕ پتہٕ۔
\v 14 أمؠ کٔرؠ باہ نفر مقرر یم أمِس سٟتؠ سفر کرہن، تہٕ یِمن سُہ تبلیغ کرنہٕ خٲطرٕ اورٕ یورٕ سوزِ ہے۔ تٔمؠ کوٚر تِمن پنٕنؠ خصوصی نمایندٕ ناو۔
\v 15 بیہِ دِتنکھ طاقت یمہِ کِنؠ تِمن لوٗکن منٛز بد روح نیٚبر کڈٕنک اختیار اوس۔
\v 16 یسوعؔن کٔرؠ یِم باہ نفر مقرر۔ شمعونسؔ کورٚن نو ناوٗ، پطرسؔ۔
\v 17 پُطرسؔس سٟتؠ سٟتؠ کوٚر یسوعؔن تہِ زبیدیؔ سُنٛد نیٚچو یعقوبؔ، تہٕ یعقوبؔنُ بوے یوحناؔ تہِ مقرر۔ تِمن دوشونی دِتِن نٔوؠ ناو، "گگرایہِ ہیٚو شخص" تِہنٛدِ وُہہ وُنہِ جوشہِ کِنؠ؛
\v 18 تہٕ أمؠ کٔرؠ اندریاسؔ، فلپسؔ، برتلمایی، متیؔ، تُوماؔ، حلفیؔ یُس یعقوبنؔ نیٚچو اوس، بیٚیہِ کٔرینؠ تدیؔ تہٕ شمعونؔ قنانیؔ مقرر۔
\v 19 تہٕ یہُوداؔ اِسکریوتی یمؠ زَن یسوعؔ پتہٕ گرفتار کرَنُوو۔
\v 20 یسوعؔ تہٕ أمؠ سنٛدؠ شٲگرد گےَ اِکس گرس منٛز۔ تتہِ گےَ آنٛتھٕ روٚس لوٗکھ جمع۔ تِمو ہیٚچ نہٕ ژوٚٹ تہِ کھیٚتھ۔
\v 21 ییٚلہِ تہنٛدیٚو گرِ کیٚو بوز، تِم درٛایہِ أمِس پانس سٟتؠ اننہٕ خٲطرٕ، تکیازِ کینٛہہ لوٗکھ ٲسؠ ونان سُہ چُھ دیوانہٕ۔
\v 22 کینٛہہ یہُودؠ شریعتکؠٕ عٲلِم ٲسؠ یروشلمہٕؔ پٮ۪ٹھٕ آمٕتؠ۔ تِمو اوس بوزمت زِ یسوعؔ چُھ بد روح لوٗکو منٛزٕ نیٚبر کڈان۔ تِم ٲسؠ ونان لوٗکن، "بعَلزبُولؔ" تہٕ بد روحن ہُنٛد بادشاہ سٕنٛدِ مددتہٕ چُھ یہِ بد روح نیٚبر کڈان۔"
\v 23 لہٰذا بُلٲوؠ یسوعؔن پانس نِشہ تہٕ ووٚننکھ مثالن ذرؠ یہِ، "شیطان کِتھٕ پٲٹھؠ ہیٚکہ شیطانس نیٚبر کٔڈتھ؟"
\v 24 اگر اِکس ملکس منٛز لُوٗکھ پانہٕ وٲنؠ لڈن، سُہ ملک روزِ نہٕ قٲیم۔
\v 25 اگر أکِس گرس منٛز تنازٕ وۅتھِ سُہ گرٕ تہِ روزِ نہٕ قٲیم۔
\v 26 یتھے پٲٹھؠ، اگر شیطان پانسےٕ خلاف لڑنہِ لوٚگ، مضبوط روزنہٕ بجایہ، گژھِ سُہ ضعیف۔
\v 27 کانٛہہ تہِ ہیٚکہ نہٕ مضبوط انسانہ سٕنٛدِس گرس منٛز أژتھ گرک جادادٕ ژوٗرِ نتھِ توٚت تام، یوٚت تام نہٕ أمِس مضبوط انسانس گٔنٛڈتھ تھاون تیلہِ ہیٚکن گرس لُٹٲوِتھ۔
\v 28 یسوعؔن ووٚن تِمن، "احتیاتہٕ سان کٔریو غورِ! لوٗکھ کٔرنِ گناہ مختلف طریقو، تِم ونن خدایس بُرٕ بلہٕ، تمہِ پتہٕ تہِ کرِ خدا تِمن معاف۔
\v 29 یُس تہِ سُہ پاک روحس خلاف بد کلامی کرِ خدایہِ کرِ نہٕ تمِس زانٛہہ تہِ معاف۔ سُہ شخص چُھ امہِ گنہک سزاوار۔"
\v 30 یسوعؔن ووٚن تِمن اوٕ مۅکھٕ زِ تِم ٲسؠ ونان "أمِس چُھو بد روح قوبو سوار!"
\v 31 یسوعؔ سنٛزِ موج تہٕ أمؠ سنٛدؠ لوٚکٕٹؠ بٲے وٲتؠ اُتن یِتن یسوعؔ تعلیم دِوان اوس۔ تِم گٔییہِ نیٚبرؠ کِنؠ کھڑا، تِمو سوز أمِس اکھ نفر آلوس گرٕ ینہٕ خٲطرٕ۔
\v 32 لوٗکھ روٗدؠ یسوعؔ ہس انٛدؠ انٛدؠ جمع۔ کمؠ تأم ووٚن أمِس، "بوز! چٲنؠ موج تہٕ چٲنؠ بیٚنہِ بٲے چھی ژےٚ نیٚبرؠ کِنؠ ژھاران۔"
\v 33 یسوعؔن ووٚن، "کسُوٚسہٕ چھِے میٲنؠ موج تہٕ کمَ چھِ میٲنؠ بٲے؟"
\v 34 أمؠ دِژ یِمن لوٗکن کُن نظر یِم أمِس انٛدؠ انٛدؠ بہتھ ٲسؠ، تہٕ ووٚننکھ، "وُچھو مےٚ کنُ توٚہؠ چُھو میٲنؠ موج تہٕ میٲنؠ بٲے۔"
\v 35 یُس تہِ خدایہِ سنٛزٕ مرضی پٮ۪ٹھ پکہِ سُہ چُھ میٚون بوے، بیٚنہِ تہٕ موج!"
\c 4
\p
\v 1 یسوعؔن کوٚر دُویمہِ لٹہِ گلیل کس سمندرس بٹھؠ بٹھؠ شہرن منٛز لوٗکن تعلیم دِنؠ شروٗع۔ تعلیمہ دوران گییہِ لوٗکن ہنٛز واریاہ بِٹھ۔ أمِس انٛدؠ انٛدؠ سیٹھاہ بِٹھ۔ سُہ ووت ناوِ منٛز۔ تہٕ ناوِ دِتُن آبس کنُ دکہٕ، لوٗکھ أسؠ بٔٹھِ پٮ۪ٹھ تعلیم بوزان۔
\v 2 تٔمؠ ہچھناوؠ تِم سَہل دلیلو سٟتؠ یِمن منٛز سبق اوس۔ تٔمؠ ووٚن تِمن یہِ:
\v 3 "بوزیٚو وُنؠ میون، اکھ شخص گوٚو کھہَس پٮ۪ٹھ کینٛہہ بیٛول وونہِ۔
\v 4 زمیٖنس بیول چھکراوان پٮؠو کینٛہہ بیول وتہِ پٮ۪ٹھ۔ پتہٕ ؤتھؠ کینٛہہ جاناوار تہٕ کھیٚوکھ سُہ بیول۔
\v 5 کینٛہہ بیٚول پٮیٚو  پتھر کنٮؠن منٛز ییٚتہِ نہٕ زیادٕ میٚژ ٲس، سُہ بیٚول کھوٚت جَلد تکیازِ تتہِ اوس نہٕ میٚژِ ہُنٛد سنیٚر۔
\v 6 تمہِ دوٚہہ ژیٖرؠ پہن ییٚلہِ اتھ نہلہِ تیز تاپھ پیٚوو پتہٕ گییہِ ہوکھتھ تکیازِ وگنیٚو موٗلو ہیٚوک نہٕ زمیٖنہِ منٛز کٔنیوٚ درمیان آبےٕ لٔبتھ۔
\v 7 أتی گوٚو سُہ ووان، کینٛہہ بیٚول پیٚو کنٛڈؠ دوٚپھَن منٛز۔ بیٚول آو سٟتؠ سٟتؠ کھٔسِتھ تہٕ کٔنڈؠ دوٚپھَن کوٗڈ واش تہٕ بیول روٗد تل کنُ۔ توے درٛاکھ نہٕ پھل۔
\v 8 پوٚز سُہ روٗد ووان، کینٛہہ بیٚول پیٚو جان زمیٖنہِ پٮ۪ٹھ۔ چوٗنکِہ نتتِجہِ درٛاو یہِ زاو، گو بوٚڈ، تہٕ درٛاس سیٹھاہ پھل۔ کیٚنژن کلن درٛاؤ ترٛہ گنہٕ تمہِ بیالیُک یہِ تٔمؠ نفرن وُوِمت اوس۔ کنیژسَ درٛاو شیٹھہٕ گنہٕ تہٕ کنیژس ہتہٕ گنہٕ پھل۔
\v 9 یسوعؔن ووٚن، "یُس بوزن یژھان آسہ، سُہ بوٗزنؠ مےٚ کیاہ چُھ ونُن۔"
\v 10  ییٚلہِ یسوعؔ کُنے زوٚن اوس تہٕ، شٲگرد آے پتہٕ پہن یسوعسؔ نِش تہٕ پرُژھہَس یِم تمٔس قریبی باہ سٲتھی ٲسؠ، تِمو پرُژھ أمِس یمن مثالن مَتلق۔
\v 11 تٔمؠ ووٚن پننؠن شٲگردن، "مےٚ چھِ توٚہیہ امہِ پٲغامچ وضاحت کٔرمژ زِ خدایہ کتھٕ پٲٹھؠ چُھ پُننٕؠ بادشٲہی ظاہر کران، مگر باقٕٮ۪ن ہنٛدِ خٲطرٕ چھےٚ یمہٕ کتھٕ مثالن منٛز یوان وننہٕ۔
\v 12 \f + \fr 4‏:12 \ft یسعیاہؔ 6:9۔ 10، یرمیاہ 5:21\f*
\q1 ییٚلہِ تِم نظر دِن بہٕ کیاہ چُھس کران، تِم ہیٚچھن نہٕ بہٕ کیازِ چُھس کران۔
\q1 ییٚلہِ تِم بوزن بہٕ کیاہ چُھس ونان، تِم سمجن نہٕ امیٚک مطلب کیاہ چُھ۔
\q1 یہِ چُھ أمؠ سببہٕ زِ تِم ما کٔرن نہٕ توبہٕ،
\q1 تہٕ خدا ما کرِنؠ تِمن معاف۔"
\v 13 یسوعؔن ووٚن پننؠن شٲگردن یتہِ، "کیاہ توٚہیہ چُھو نا یہِ تمثیل سمجھان؟ تیلہِ کتھٕ پٲٹھؠ سمجِھو توٚہؠ ییٚلہِ بہٕ توٚہہِ باقیو تمثیلہٕ ونو؟
\v 14 اتھ مثالہِ منٛز ووٚن مےٚ توٚہہِ یہِ بیٚول ووٚن وول شخص چُھ تٔمؠ سنٛز نمایندگی کران یُس بیٚین خدایہِ سُنٛد پٲغام دِوان چُھ۔
\v 15 کینٛہہ لوٗکھ چھِ تمہِ بیألچ مثال ہش آسان یُس وتہِ وتہِ پٮٚیوان چُھ۔ ییٚلہِ تِم خدایہِ سُنٛد کلام بوزان چھِ، شیطان چُھ جلدٕ یوان تہِ سُہ چُھکھ مشرأوان تہِ یہِ تِمو بوزمُت آسان چُھ۔
\v 16 کینٛہہ لوٗکھ چھِ تمہِ بیألچ مثال ہش آسان یُس گٕرویس کٮنؠن منٛز ووٚان چُھ۔ ییٚلہِ تِم خدایہِ سُنٛد پٲغام بوزان چھِ، ؤلؠ ؤلؠ چھِ خوشی سان رَٹان۔
\v 17 مگر، تِمن ٲسؠ نہٕ پُننٕؠ موٗل مضبوط، تہٕ تِمن منٛز ٲس نہٕ برداش کرَنچ صلاییحت۔ امہِ وجہ، ییٚلہِ تِمن لوٗکھ خدایہِ سنٛدِس پٲغامس پٮ۪ٹھ ستاون چھِ، تِم چھِ ؤلؠ ؤلؠ یقین تراوان۔
\v 18 کینٛہہ لوٗکھ چھِ تتھ زمیٖنہِ ہی آسان یتھ منٛز کنٛڈؠ دوٚپھ چھِ آسان۔ تِم چھِ خدایہِ سُنٛد کلامہٕ بوزان
\v 19 صرف چھِ دُنیاکیٚن دۅلابنَ منٛز گرفتار گٔژھتھ دولتُکہِ فریب کہ وجہ تِم خدایہِ سُنٛد پٲغام مشراوان۔ یِمن چیٖزن منٛز گرفتار گژھتھ، چھِ خدایہِ سُنٛد سُہ پٲغام دباوان یُس تِمن نِشہ ووتمُت اوس، تہٕ توے چُھنہٕ أمِس شخصس فَصل نیران۔
\v 20 مگر کینٛہہ لوٗکھ چھِ تتھ بیٚلس ہی آسان یُس جان زمیٖنہ منٛز وونہٕ آیوو۔ تِم چھِ خدایہ سُنٛد کلام بوزان، پتہٕ قبوٗل کران، اتھ پؠٹھ بھروسہٕ کران، تہٕ پتہٕ چھِ تِمہٕ کامہِ کران یِم خدایہِ تِمن کرناوُن یژھان چُھ۔ تِم چھِ تِمن رٕتٮ۪ن کٔلؠن ہنٛدؠ پٲٹھؠ یِم ترٛہٛہ گنہٕ، شیٹھٕ گنہٕ، یا ہتہٕ گنہٕ فصل دِوان چھِ۔
\v 21 تٔمؠ ؤنؠ تِمن شٲگردن دوٚیم مثال: لوٗکھ چھِنہٕ یقینی طور ژونگ زالان تہٕ پتہٕ گرس منٛز ژانان تاکہِ أمؠ کس گاشش ترٛاوو پردٕ پؠٹھ۔ امہِ بجایہ چھِ تِم اتھ ژٲنگس تارَس پؠٹھ تھاوان تاکہِ گاش چمکہٕ۔
\v 22 یتھَے پٲٹھؠ، یِم چیٖز کٔھٹِتھ ٲسؠ۔ اکہ دوٚہہ زانہِ تِمن ہر کانٛہہ۔ تہٕ تِم چیٖز یِم پردس تل چھِ۔ اکہ دوٚہہ وُچھ تِمن ہر کانٛہہ مکمل گاشش منٛز۔
\v 23 اگر توٚہؠ یہِ سمجن یژھان چُھو، توٚہؠ پزِ اتھ پؠٹھ غور کرُن یہِ توٚہؠ وُنؠ بوزیٚو۔"
\v 24 "ہوشیاری سان کٔریو تتھ پؠٹھ غور یہِ توٚہؠ مےٚ نِش بوزان چُھو، خدا تہِ سمجھایو توٚہہِ امہِ پیمانہٕ سٟتؠ یمہِ سٟتؠ بہٕ چھس توٚہؠ تصور کران زِ یہِ بہٕ ونان چُھس۔ سُہ سمجھایو توٚہہِ امہِ کھوٗتہٕ زیادے پہن۔
\v 25 اکہ طرفہٕ اگر أکِس شخصس سمجھ آسہ، سُہ رَٹہٕ امہِ کھۅتہٕ زیادٕ۔ دویٚمہِ طرفہٕ اگر أکِس شخصس سمجھ آسہ نہٕ، یہِ تمِس کینٛہہ ذرا آس ہے سُہ تہِ راویس۔"
\v 26 یسوعؔن ووٚن یتہِ، "ییٚلہ خدا پنٕنؠ بادشٲہی ہاونؠ شروع کران چُھ، یہِ چُھ تمِس شخصس سنٛدؠ پٲٹھؠ یِمؠ زمیٖنس پؠٹھ بیول چھۅکمُت آسہ۔
\v 27 امہِ پتہٕ چُھ سُہ بیالیُک واے برنہٕ ورٲے پرٛتھ راتس شونٛگان تہٕ دوٚہس وتھان۔ اتھ دوران چُھ بیٚول کھسان تہٕ تمہِ انٛدازٕ بڑان یمیُک نہٕ تس ظۅنےٕ چُھ آسان۔
\v 28 زمیٖنس چُھ فصل پانے ۅپدان۔ گۅڈٕ چھِ ؤتھر نیران۔ پتہٕ چِھس ہیٚلؠ بنان۔ تہٕ چھیٚس ہیٚلؠن منٛز پورٕ گوج ظاہر گژھان۔
\v 29 یتھُےٕ فصل پپان چُھ، سُہ چُھ ؤلؠ ؤلؠ مُزور  انان تہٕ اتھ دراتہِ سٟتؠ  لوٚنان، تکیازِ وُنؠ چُھ فصل لوننُک وقت۔
\v 30 یسوعؔن وٚون تِمن دویم سبق آمیز دلیل۔ تٔمؠ ووٚن، "ییٚلہِ خدا پنٕنؠ بادشٲہی ہاونؠ شروع چُھ کران، امِچ مثال کیاہ بنہِ؟ امِچ وضاحت کرنہٕ باپتھ لفظن ہنٛز کوس تصویر ورتاوٕ بہٕ؟
\v 31 یہِ چُھ تِلہٕ گۅگل بیول ہیٚو، یہِ چُھ ساروےٕ بیالیٚو کھوٗتہٕ نیٚوک بیٚول یُس زمیٖنس وونہٕ چُھ یوان، یہِ چُھ دنیاہکیو بیٚلیو منٛزٕ زٲویول بیٚول۔
\v 32 \f + \fr 4‏:32 \ft فلسطینس منٛز اوس تِلہٕ گۅگل أکس کُلس ہیو وۅپدان تہٕ جاناوار ٲسؠ تمچین لنجن منٛز پننٕؠ ٲلؠ بناون۔ \f*ییٚلہِ یہِ وونہٕ چُھ یوان، امہِ پتہٕ زُوان تہٕ کھاہ کیو باقیو کُلیٚو نِشہ بوٗڈ گژھان چھے۔ تِمن چھِ بجہِ لنجہٕ نیٚبر کڑان تاکہِ جاناوار ہیٚکؠن تہنٛدس ژھایہِ ۂلس تل ٲلؠ پُنن بنٲوِتھ۔
\v 33 یسوعؔ اوس واریاہ مثالہٕ پیش کران، ییٚلہِ سُہ لوٗکن سٟتؠ خدایہِ سنٛدِس کلامس متعلق کتھ اوس کران۔ سُہ اوس تِمن تیٚوتُے ونان یوٗتاہ تِمن فکرہِ ترِہے۔
\v 34 سُہ اوس ہمیشہِ مطلب دار دلیلہٕ پیش کران ییٚلہِ لوٗکن سٟتؠ کتھ کران اوس۔ مگر ییٚلہِ سُہ کُن زوٗن اوس آسان سُہ اوس پننؠن ژاٹن سارنےٕ مثالن ہنٛز وضاحت کران۔
\v 35 تمہِ دوٚہہٕ، ییٚلہِ افتاب اوس لوسان، یسوعؔن ووٚن پننٮ۪ن شٲگردن، "ؤلِو ٲسؠ ترو گلیلکس سمندرس بیس طرفس۔"
\v 36 یسوعؔ ووٚتھ ناوِ منٛز برونٛٹھےٕ، یتھٕ پٲٹھؠ ترٛاؤ تِمو لوٗکن ہنٛز بٹھ أتی تہٕ ٲبی سفر کران دوٗرییہِ۔ باقیو لوٗکھ تہٕ درایی پننیٚن ناون منٛز یِمن سٟتؠ۔
\v 37 اکھ زوردار طوفان ووٚتھ تہٕ لہرو ہیٚوت ناوِ منٛز ٲژنُ! ناو اوس آبہٕ سٟتؠ بٔرِتھ یِنُک خطرٕہ۔
\v 38 یسوعؔ اوس ناوِ ہنٛدس پتمِس حصس منٛز۔ سُہ اوس تکؠ یس کُن کلہٕ تراوِتھ شونٛگِتھ۔ شاگردو وزٕ نوٗو تہٕ ووٚن ہس، "وۅستاد! ژٕ چُھے نا کینٛہہ پرواہ زِ ٲسؠ چھِ مرنس تیار؟"
\v 39 تیتھٔے سُہ بیدار گو تٔمؠ دِژ واوس بیؤأری تہٕ سمندرس ووٚنُن، "ژھۅپہٕ کٔرتھ بیہٚہ! واو گوٚو بنٛد تہٕ پتہٕ گلیلوک سمندر گوٚو واریاہ خاموش۔
\v 40 \f + \fr 4‏:40 \ft زبُور 107:29\f* تٔمؠ ووٚن ژاٹن، "توٚہؠ کیازِ چُھو کھوژان؟ توٚہیہ چُھ نا ونہِ تہِ یقین زِ بہٕ ہیٚکہ ہو رٲچھ کٔرتھ؟
\v 41 تِمن اوس سخٕت ڈر۔ تِمو ووٚن اکھ أکِس، "یہِ کُس انسان چُھ؟ ہتأکہ واو تہٕ لہرٕ چھِ أمِس تٲبیٖن!"
\c 5
\p
\v 1 \f + \fr 5‏:1 \ft متی 8:28\f*یسوعؔ تہٕ أمؠ سنٛدؠ ژٲٹھ وٲتؠ گلیل سمندرکس دویمِس بٹِھس پؠٹھ۔ گراسینیؔ ناوکؠ لوٗکھ ٲسؠ تتھ جایہِ نکھٕ روزان یتہِ تِم بوٚٹھ کٔھتؠ۔
\v 2 ییٚلہِ یسوعؔ ناوٕ منٛز نیٚبر درٛاو، اکھ شخصا آو اکہ قبرِستان چو قبرو منٛزٕ نیٚبر نیرتھ۔ بد روحو اوس تمِس نال ولمُت۔
\v 3 سُہ شخص اوس مقبرٕ منٛزٕ نیران تکیازِ سُہ اوس قبرن منٛز روزان۔ تِمو لوٗکو کرایہِ وقتہٕ وقتہٕ سُہ رٹنچہِ کوٗشش۔ تِمو ہیوک نہٕ سُہ ششترٕ چو زنجیرو سٟتؠ تہِ قوبو کرتھ۔
\v 4 ییٚلہِ تہِ زانٛہہ تمِس ہتھٕ کرِ تہٕ زنجیر تراوان ٲسؠ، سُہ شخص اوس تِمن تہِ ژٹان۔ سُہ اوس تیوٗت طاقتور زِ کأنسہ اوس نہٕ طاقت یہِ رَٹنس سونٛب۔
\v 5 دوٚہس تہٕ راتس اوس سُہ پُنن وقت مقبرس منٛز تِمن جاؠن گٔزاران یتہِ لوٗکھ ٲس دفن آمٕتؠ کرنہٕ۔ سُہ اوس بالایی گأمن منٛز زورٕ کریکہٕ دِوان تہٕ کھمبرِیوٚ سٟتؠ اوس پٲنس چھوکھ دِوان۔
\v 6 ییٚلہِ تٔمؠ دورِ پؠٹھٕ یسوعؔ وُچھ ناوِ منٛز ہیٚور کھسان، سُہ لاریوو أمِس کُن تہٕ کوٚرنس سجدٕ۔
\v 7 \f + \fr 5‏:7 \ft 8: 29، بادشاہ 1۔ 17:18\f*جنن دِژ زورٕ کرؠکھ، "مےٚ مہَ کر کینٛہہ، یسوعؔ بڈِ خدایہِ سٕنٛدِ گۅبریا! خدایہِ سُنٛد قٔسم چھی زِ ژےٚ دِکھ نہٕ مےٚ ازا!" جنن ووٚن یہِ تکیازِ یسوعؔ اوس تمس ونان، "ناپاک روح، أمِس نفرس منٛز نیر نیٚبر!"
\v 8 تٔمؠ بدروحن دِژ زورٕ کریکھ، "مےٚ تراو کنُے زوٚن، اے یسوعؔ ساروےٕ کھۅتہ تھدِ پایہ کِس خدایہِ سنٛدِ گۅبرٕ! خدایہ سُنٛد قَسَم کھیٚہ زِ ژٕ دکھ نہٕ مےٚ تکلیف!" تِمؠ بدروحن ووٚن تمِس تکیازِ یسوعؔ اوس تمِس ونان، "ناپاک روح! تمِس انسانس منٛزٕ نیر نیٚبر!"
\v 9 یسوعؔن ووٚن تمِس ناپاک روحس، "ژٕ کیاہ چُھے ناو؟" تٔم دیت جواب، "میٚون ناو چُھ لشکر تکیازِ ٲسؠ چھِ واریاہ بد روح أمِس انسانس منٛز۔"
\v 10 پتہٕ رود سُہ بد روح یسوعؔ ہس زارٕ پارٕ کران زِ سُہ کرِ نہٕ تِمن أمؠ علاقہٕ منٛزٕ نیٚبر۔
\v 11 تٔمی وقتہٕ اوس سورن ہُنٛد اکھ بوٚڈ کھیوٚل نکھے بالہِ طرفہٕ گھاسہٕ کھؠۅان۔
\v 12 اوے اوس سُہ بد روح زارٕ پارٕ کرُتھ یسوعؔ ہس ونان، "ٲسؠ دِیہ اجازتھ سورن نِشہ گژھنس تاکہِ ٲس ما گژھو تِمن منٛز دٲخٕل!"
\v 13 یسوعؔن دِیُت تِمن اِجازتھ تہِ کرنس۔ لہٰذا تِمو بد روحو تروو سُہ شخص تہٕ گییہِ سورن منٛز دٲخٕل۔ تم کھیٚلؠ وٲج وسہٕ ونِس بالس دو تہٕ تقریبن زٕ ساس سور پھُٹؠ گلیلکس سمندرس منٛز۔
\v 14 تِم سورٕ رٲچھ نفر  ژٔلؠ تہٕ ونُکھ قصبس منٛز، گامس منٛز کیاہ سپدیوؤ۔ واریاہ لوٗکھ تِمو جاییو پؠٹھِ آیہِ پانہٕ یہِ واقہٕ وُچھنؠ۔
\v 15 تِم سٲری لوٗکھ وٲتؠ تتھ جایہِ یتہِ یسوعؔ اوس۔ پتہٕ وُچھ تِمو سُہ شخص یعنی لشکر یُس بد روحن برونٛہہ روٚٹمُت اوس۔ سُہ اوس تتہِ پلو لاگتھ بہتھ تہٕ وُنؠ اوس نہِ سُہ تِم حرکژ کران ییٚلہِ سُہ بد روحن رَٹَمت اوس۔ ییٚلہِ تِمو یہِ سورےٕ وُچھ تِم کھوژ۔
\v 16 تِمو لوٗکو یمو یہِ واقہٕ پانہٕ وُچھمُت اوس۔ ووٚن تِمن یِم تمہِ قصبہٕ تہٕ گامہٕ پؠٹھ آمٕتؠ ٲسؠ۔ تِمو ووٚن تِمن لوٗکن تتھ واقہس متعلق یُس تمِس شخصس سٟتؠ پیش آو یُس برونٛہہ بد روحن رُٹمت اوس۔ تِمو کرِ امِچ تہِ وضاحت زِ سورن کیاہ گوٚو۔
\v 17 پتہٕ کرِ یمو لوٗکو یسوعؔ ہس پننہِ علاقہٕ منٛزؠ نیرنُک التجاہ۔
\v 18 یتھے یسوعؔ ناوٕ منٛز ژاو، تٔمؠ شخصن یُس بد روحن رُٹمت اوس، کوٚر یسوعؔ ہس التجاہ، "مہربٲنی کرِ بہٕ روٗزٕ ژؠےسٟتؠ!"
\v 19 مگر یسوعؔن دیت نہٕ تمِس شخصس پانس سٟتؠ ینہٕ۔ بلکہ ووٚنس، "گرٕ گژھِ پننس عیالس نِش تہٕ ون تمن سورےٕ کینٛہہ زِ خداوندن کیاہ کوٚر چأنہِ خٲطرٕ، تہٕ وُن تِمن سُہ کوتاہ مہربان روٗد ژٕیہ پؠٹھ۔"
\v 20 سُہ شخص دراؤ تہٕ پھؠور تمہِ علاقن کؠن دہن قصبن منٛز۔ تٔم ووٚن لوٗکن تہِ سورےٕ یہِ یسوعؔن تُہنٛدِ خٲطرٕ کوٚڑمُت اوس۔ تمام لوٗکھ یِمو یہِ بوز یہِ تِمؠ شخصن وونُکھ سٔپدؠ حٲران۔
\v 21 تٔمؠ پتہٕ کوٚر یسوعؔن دُبارِ ناوِ منٛز سفر تہٕ ووٚت گلیل سمندر کس بیؠس طرفس، واریاہ لوٗکھ گےَ أمِس انٛدؠ انٛدؠ بٔٹھس پؠٹھ جمع۔
\v 22 یہُودینؔ ہُنٛدِ مقٲمی سمن بلک اکھ ذمدار شخص یمِس ناو یائِیرؔ اوس ووت اوت، ییٚلہِ تِمؠ یسوعؔ وُچھ، تِم ترٚوو پنن پان یسوعؔ سنٛدین کھورن تل۔
\v 23 تہٕ أمؠ کوٚر سنٛجیدگی سأن یسوعؔ ہس زارٕ پارٕ، "میأنؠ کوٚر چھےٚ بیٚمار تہٕ مرَنس تیار! مہربٲنی کٔرو میٚون گرٕ انؠو تشریف تہٕ ڈألؠو تمِس پنُن اتھٕ۔ سُہ بلراون تہٕ زِندٕ تھاون!"
\v 24 توۓ درٛاؤ یسوعؔ تمِس سٟتؠ۔ واریاہ لوٗکھ درٛایہِ تمِس پتہٕ پتہٕ، اتہِ گییہِ ژیٚلہٕ ژؠل۔
\v 25 تتہِ ٲس اکھ زنان جمہ گٹھس منٛز یمِس خوٗن یُنک مسلہٕ اوس۔ تمِس اوس بہو ورؠو پٮ۪ٹھٕ دوٚہہ دش خوٗن جٲری روٗزان۔
\v 26 تمہِ ٲس واریاہہِ وِلہِ واریہن حکیٖمن ۂنٛدِ دٔسؠ ازا تُلمُت۔ تٔمؠ اوس پنُن سورےٕ جمع پونٛسہٕ علاجس پؠٹھ خرچ کوٚڑمُت، ٹھیک گژھنہٕ بجایہ ٲس وارۓ پتھ گٲمژ۔
\v 27‏-28‏ ییٚلہِ تٔمؠ بوز زِ یسوعؔن بلرٲۓ لوٗکھ، سۅ تہٕ آیہِ اتھ لوٗکن ہنٛزٕ بِٹھِ منٛز یِم ٲمس پتہٕ پتہٕ پکان ٲسؠ۔ سۅ وٲژ أمِس نزدیک، تٔمؠ لوگ تسنٛدین پلون اتھٕ۔ سۅ ٲس سونچان، "اگر بہٕ تٔمسٕنٛدیٚن پلون اتھٕ یوت لاگہٕ، بہٕ لبہٕ شفأ۔"
\v 29 تمی دمہٕ گوٚو ٲمس خوٗن یُن بنٛد۔ تٔمؠ ساعتہٕ گوٚو تمِس پننِس جسمس منٛز محسوس زِ یسوعؔن کوٚر تٔمؠ سنٛدِس دٲدس علاج۔
\v 30 یسوعؔ ہس توٚر ؤلؠ ؤلؠ فِکرِ زِ تٔمؠ سنٛدؠ طاقتن اوس کسُتام ٹھیک کوٚڑمُت۔ تِتھُے پھیوٗر سُہ لوٗکن کُن تہٕ پرُوژھنکھ نکھَ، "میانیٚن پلون کٔمؠ لوٗگ اتھٕ؟"
\v 31 أمؠ سنٛدیو شاگردو دیت جواب، "ژےٚ چُھے پےَ زِ لُکہٕ ارسات چُھ ژےٚ نزدیک ژیلہٕ ژیلہِ کران! شاید واریہو لوٗکو ٲسی ژےٚ اتھہٕ لوٗگُمت! بیٚیہِ چُھکھ پرِژھان مےٚ کٔمؠ لوٗگ اتھہٕ؟"
\v 32 مگر یسوعؔ روٗد ژواپٲرؠ نظر دِوان تاکہِ سُہ نفر ییہِ نظرِ منٛز یِم أمِس اتھہٕ لوٗگمت اوس۔
\v 33 سۅ زنان کھوژ سیٹھاہ تہٕ ٲس تھرٕ منٛز تکیازِ تٔمؠ اوس زونمُت زِ ییٚلہِ تمہِ یسوعؔ ہس اتھہٕ لوٗگ، سۅ گییہِ ٹھیک۔ سۅ آیہِ أمِس برونٛہہ کُن تہٕ ترووُن پان پتھر تہٕ ووٚنس یہِ تمہِ کوٚڑمُت اوس۔
\v 34 یسوعؔن ووٚن تمِس زنانہِ، "کوٚری، تکیازِ ژؠے اوسُتھ یقین کوٚڑمُت زِ بہٕ ہیکتھ ژٕ ٹھیک کرِیھ، وُنؠ کٔرکھ ژٕ مےٚ ٹھیک۔ ژٕ روز سلامت، یہِ زآن زِ مےٚ کٔرکھ ژٕ ہمیشہ خٲطرٕ أمؠ بؠمارِہ نِشہ ٹھیک۔"
\v 35 یسوعؔ اوس وُنؠ أمِس زنانہِ سٟتؠ کتھٕ کران، امی ساتہٕ وٲتؠ جیرؔس سُنٛد گرٕ پیؠٹھٕ کینٛہہ لوٗکھ۔ تِمو ووٚن جیرسسؔ، چٲنؠ کوٚر مۅیہِ تہٕ ونہِ ووستادس چۅٗن گرٕ یِنہٕ خٲطرٕ ازا دُنک کیاہ ضرورت چُھ۔"
\v 36 پوٚز ییٚلہِ یسوعؔن تہِ بوز یہِ تِمو نفرو ووٚن، تٔمؠ ووٚن جیرسسؔ، "مہَ کھوٗژ زِ چٲنؠ کوٚر چھِ مومٕژ! صرف تھاؤ یقین زِ سۅ روزِ زندٕ۔"
\v 37 پتہٕ دِیت تٔمؠ صرف پننؠن ترٛؠن قریبی ژاٹن، پطرسؔ، یعقوبؔ تہٕ یوحناؔ ہس تتھ گرس منٛز گژھنہٕ خٲطرٕ پانس سٟتؠ یُنک اجازتھ۔ أمؠ دِیت نہٕ باقین لوٗکن پانس سٟتؠ ینُک اجازتھ۔
\v 38 عبادت خانہٕ کس سردار سٕنٛدِس گرس نزدیک واتہٕ ون باسیو پتہٕ، یسوعؔ ہس وُچھ زِ یِم لوٗکھ تتہِ ٲس تمن منٛز ٲس خلؠ بلؠ گٕمژ۔ تِم ٲس ودان تہٕ زورٕ واویلا کران۔
\v 39 سُہ ژاو گرس منٛز، تہٕ تٔمؠ ووٚن تتہِ لوٗکن، "توٚہؠ کیازِ چُھو پریشان تہٕ ودان؟ شُرچُھنہٕ مودمُت بٔلؠ کہِ چُھ صرف شونٛگِتھ۔"
\v 40 تِمو لوٗکو ترٛوو أمِس اسن تکیازِ تِمن ٲس پتہٕ سوٚ چھےمومژ۔ أمؠ کٔڈؠ باقیو لوٗکھ گرٕ منٛزٕ نیٚبر۔ پتہٕ نیوٗن شُرؠ سُنٛد مول تہٕ موج تہٕ تٔمؠ پنن ترٛے شٲگرد یمؠ أمِس سٟتؠ ٲس، تہٕ تِم گےَ تتھ کمرس منٛز یتہِ سُہ شُر ترٛاومژٕ آسکھ۔
\v 41 أمؠ رۅٹ شُرؠ سُنٛد اتھٕ تہٕ ووٚننس أمؠ سنٛزے زبانؠ منٛز، "تلیتا قومی! یمیُک مطلب چُھ، "لۅکٕٹ بچی، ووٚتھ تھوٚد۔"
\v 42 یکدم گییہ سۅ بچی کھڑا تہٕ لج اورٕ یور پکنہِ۔ یہِ ٲس نہٕ حٲرانگی زِ سۅ لٔج پکنہِ تکیازِ سۅ ٲس باہ ورش ییٚلہ یہِ واقع سُپد، یِم تہِ تتہِ موجود ٲسؠ گےَ زبردس حٲران۔
\v 43 یسوعؔن دیت تِمن سخٕتی سان حکم، کانٛسہ گژھہٕ نہٕ ونن یہِ مےٚ کوٚر! پتہٕ ونُکھ أمِس لڑکی دِیو کینٛہہ کھؠنہٕ خٲطرٕ۔
\c 6
\p
\v 1 یسوعؔ درٛاؤ کفرنحوم شہرِ منٛزٕ تہٕ گوٚو پنن آبٲئی وطن، ناصرت۔ تٔمؠ سنٛدؠ شٲگرد تہِ گےَ تمِس سٟتؠ۔
\v 2 یہُودؠ آرامکہ دوٚہہ سبت، سُہ ژاو یہُودؠ عبادت خانس منٛز تہٕ دِژن لوٗکن تألیٖم۔ بوزن والیٚن منٛز گےَ واریاہ حٲران۔ تِمن گوٚو تعجب أمِس کتہِ گییہ سٲرؠ داناییٔ تہٕ سُہ طاقت حاصل یمہِ سٟتؠ یہِ معجزٕ کران چُھ۔
\v 3 تِمو ووٚن، "یہِ چُھ محض اکھ معمولی چھان! ٲسؠ زانٕہوٗن یہِ تہٕ امہِ سُنٛد خاندان! ٲسؠ زانٕہوٗن امہِ سنٛزٕ موج مریمؔ! ٲسؠ زانہوٗک امہِ سُنٛد لوٚکٕٹؠ بٲے یعقوبؔ، یوسیسؔ، یہُوداؔ تہٕ شمعونؔ! تہٕ امہِ سنٛز لوکچہِ بیٚنہِ چھےٚ ییٚتہِ ٲسؠ سٟتؠ روزان!" توۓ ووت تِمن امہ سنٛزٕ تألیٖمہِ سٟتؠ تکلیف۔
\v 4 یسوعؔن ووٚن تِمن، "یہِ چُھ یقیناً پوٚز زِ باقیو جاؠن چھِ لوٗکھ نبین یزتھ کران، مگر پننس آبٲئی شہرس منٛز نہٕ! حتاکہ تُہنٛدؠ رشتہ دار تہٕ بیٚہِ تِم لوٗکھ یِم تہنٛدؠن گرَن منٛز روزان چھِ، چھِ نہٕ تِمن یزتھ کران!"
\v 5 اتہِ کٔرؠ نہٕ یسوعنؔ زیادٕ معجزٕ تکیازِ اگرچہ تٔمؠ اتہِ کینٛہہ بیمار لوٗکھ اتھٕ ڈألنہٕ سٟتؠ ٹھیک کٔرؠ، تٔم ہیٚوک نہٕ اتہِ کانٛہہ معجزٕ ہاؤتھ۔
\v 6 \f + \fr 6‏:6 \ft تِمن اکھ خبردٲری ہشؠ۔ \f*تمِس گوٚو تعجُب زِ سؠٹھاہ کم لوٗکو کوٚر تمِس پٮ۪ٹھ یقین، مگر سُہ روٗد تہنٛدؠن گامن منٛز گژھان تہٕ تِمن تعلیم دِوان۔
\v 7 یسوعؔن انؠ ناد دِتھ اکہ دوٚہہ تِم باہہوے شٲگرد۔ تٔم ووٚن تِمن زِ سُہ اوس تِمن زٕ زٕ کٔرتھ جوڑؠن منٛز نیٚبرِمیٚن واریہن شہرن منٛز تعلیم دِنہٕ خٲطرٕ سوٗزن وول۔ تٔم دِیُت تِمن لوٗکن منٛز بد روح نیٚبر کڈنک تہٕ اختیار یِم تِمو رٕٹؠ متؠ ٲسؠ۔
\v 8‏-9 تمؠ دِیت یمن حکم زِ ییٚلہِ تِم سفر کران آسن تِم لاگٔن سادٕ نالانؠِ تہٕ تھاون پانس سٟتؠ اکھ لور۔ تٔم ووٚن تِمن زِ سفرس دوران تُلؠ زؠو نہٕ کانٛہہ اکھ ٹھیلہٕ یتھ منٛز چیٖز یوان تھاؤنہٕ یا کانٛہہ پونٛسہٕ۔ تٔم دِیُت نہٕ تِمن اکھ کُرتہٕ تہِ پانس سٟتؠ تھاؤنکھ اجازت۔
\v 10 تٔم کوٚر تِمن یہِ ہدایت تہٕ، "اگر کانٛہہ شخص توٚہہِ پننِس گرس منٛز روزنچ دعوت دییہِ، تتہِ روزِ زیٚو تۅتام یۅتام توٚہؠ تمہِ قصبہٕ منٛزٕ نیریٚو۔
\v 11 یتہِ تہِ لوٗکھ توٚہیہ خوش آوے کرنو نہٕ تہٕ یتہِ لوٗکھ تُہنٛد بوزن نہٕ، تتہِ نیرؠ زیٚو پنہٕ نؠن کھۅرن ہنٛزٕ گرد تاں دٕنؠ زؠۅ تٔتی۔ تہِ کرَنہٕ سٟتؠ رو زؠۅ توٚہؠ گوٲہ زِ تِمو نہٕ کوروٕ توٚہیہ خوش آوے نہٕ بوٗزکھ تُہنٛد پٲغام۔"
\v 12 تمہِ پتہٕ گییہِ تِم شٲگرد تیُتھٕ پٲٹھؠ واریہن شہرن منٛز، تِم ٲسؠ تمہِ انٛدازٕ تبلیغ کران لوٗکھ ما کرنَ توبہٕ پنَنو گناہن نِشہ۔
\v 13 تِم ٲسؠ لوٗکن منٛز بد روح نیٚبر کڈان، تِم ٲسؠ واریاہ بیٚمار لوٗکن زیتون تیٖل ملان تہٕ تِمن ٹھیک کران۔
\v 14 وُنؠ بوز بادشاہ ہیرودیسؔن یسوعؔ ہس متعلق سُہ کیاہ اوس کران، تکیازِ واریاہ لوٗکھ ٲس تمِس متعلق کتھٕ کران۔ کینٛہہ لوٗکھ ٲس یسوعؔ ہس متعلق ونان، "یہِ گژھِ یوحناؔ بپتسمہ دِنہٕ وول آسن! یہِ چُھ مودؠ مٕتیٚو منٛزٕ زندٕ گوٗمت! توے چُھ أمِس منٛز یِم معجزٕ ہاؤنکھ طاقتھ!"
\v 15 باقیو ٲس یسوعؔ ہس متعلق ونان، "یہِ چُھ پتھ کالک نبی ایلیاہؔ، یمِس خداین دُبارِ واپس انَنہٕ نُک وعدہ اوس کوٚرمُت۔ "باقیو ٲس یسوعؔ ہس متعلق ونان، "نہٕ یہِ چُھ اکھ مختلف نبی، پرانیٚن نبین ہیوٗ اکھ نبی۔"
\v 16 تِم لوٗکھ کیاہ ٲس ونان،  بادشاہ ہیرودیسنؔ ووٚن  پٲنؠ پانس بوٗزنہٕ پتہٕ، "سُہ شخص یُس یتھٕؠ معجزٕ ہاوان چُھ گژھِ آسن یوحناؔ؛ سُہ بپتسمہ دنہِ وول! یمِس مےٚ پنہٕ نؠن سپہن کلہٕ ژٹہٕ نُک حکم دِژاوٕ، مگر یہِ چُھ بیٚہِ زندٕ!"
\v 17 اصلی اوس ہیرودیسؔ بادشاہن یوحناؔ رَٹہٕ نوومُت تہٕ قٲد خانسَ منٛز ترٛوومُت یمیٚک وجہ یہِ اوس ہیروؔدیسن اوس پننہِ بایٔؠ کاکنہِ فلپسؔ سنٛزِ زنانہِ ہیرودیاسسؔ سٟتؠ خانٛدر کوٚرمُت۔
\v 18 \f + \fr 6‏:18 \ft احبار 18:16، 20:21\f*ہیرودیسن تھوو یوحناؔ جیٚلس منٛز تکیازِ سُہ اوس ہیرودؔیسس ونان، "خدایہ سُنٛد قانون چُھے نہِ ژیہ اجازت دِوان پننِس بٲے سنٛزٕ زنانہِ سٟتؠ خاندر کٔرنَ۔"
\v 19 مگر ہیرودیسؔ آس یژھان یوحناؔ ہس امہِ کھوٗتہ تہِ بدلہٕ ہوٗن، تمہِ ہیژاو سُہ کٲنٛسہِ اتھِ قتل کرناون۔ مگر تمہِ ہیوٗکھ تہِ کرتھ، تکیازِ ییٚلہِ یوحناؔ جیٚلس منٛز اوس، ہیرودؔیسن اوس یوحناؔ أمِس نِشہ بچٲوِتھ تھوومت۔
\v 20 ہیروؔدیسن اوس یہِ امہِ سببہٕ کوٚڑمُت تکیازِ سُہ اوس یوحناہسؔ یزّتھ کران، تکیازِ تمِس ٲس پتاہ زِ سُہ اوس پٔزؠ یور شخص یمؠ پنُن پان خدایہِ سنٛدِ خٲطرٕ وقف کوٚڑمُت چُھ۔ ییٚلہِ تہِ زانٛہہ ہیرودیسؔ یوحناؔ سنٛزٕ کتھٕ بوزان اوس، ہیرودیسؔ اوس سخ پریشان گژھان، مگر یوحناؔ سنٛزٕ کتھٕ بوٗزنؠ اوس پسند کران۔
\v 21 ہیرودیسسؔ آو یوحناؔ مارنُک موقعہ تمہِ دوٚہہ ییٚلہِ تمہِ ہیرودیسس تہنٛدس زا دوٚہس پٮ۪ٹھ تمِس یزتھ بخشان ٲس۔ تٔمؠ ٲسؠ سیٹھاہ اہم سرکأری افسرن، سردارن تہٕ گلیل ضلع کؠن سیٹھاہ اہم لوٗکن سال کوٚڑمُت تہٕ یہِ دوٚہہ یمن سٟتؠ مناونہٕ خٲطرٕ دعوت دژٕمژٕ۔
\v 22 ییٚلہِ تِم ضیافت کھیوان ٲسؠ، ہیرودیاسنؔ کوٚر آیہِ کمرس اندر تہٕ نٔژ بادشاہ تہٕ تسنٛدین پژھین خٲطرٕ۔ تمہِ کرِ بادشاہ ہیرودیسؔ تہِ تمسنٛدؠ پٔژھ تیتؠ خوش زِ بادشاہن ووٚن تمِس کورِ، "منٛگ مےٚ یہِ ژٕ یژھک، تہٕ بہٕ دِمے ژےٚ!"
\v 23 تٔمؠ دِیت أمِس وعدہ، "یہِ ژٕ منٛگکھ بہٕ دِمے ژٕ! بہٕ دِمے ژٕ پننؠ سلطنتک نیصف حصہ تہِ ہرگاہ ژٕ یژھکھ۔"
\v 24 امے پتہٕ، گییہِ سۅ کوٚر پننہِ ماجہ نِش، وونن تمِس یہِ ہیرودیسنؔ تمِس وونمت اوس۔ تمہِ ووٚن پننہِ ماجہ، "بہٕ کیاہ منٛگس "ماجہ ووٚنس جوابس مَنٛز، "بادشاہس منٛگ مےٚ دِییہ یوحناؔ بپتسمہ دِنہٕ وٲلؠ سُنٛد کلہٕ!"
\v 25 ٲتی گےَ سۅ کوٚر ؤلؠ ؤلؠ تتھ کمرس منٛز واپس تہٕ سیٚودے گےَ بادشاہس نِش پٔنن عرض ہٮ۪تھ۔ تمہِ ووٚن، "بہٕ چھس یژھان ژٕ دِکھ کانٛسہ حکم یوحناؔ بپتسمہ دِنہٕ وٲلؠ سُنٛد کلہٕ ژٹٕہ نُک تہٕ ان سُہ أکِس تھألس منٛز وُنؠ مےٚ نِش!"
\v 26 بادشاہس گوٚو یہِ بوزِتھ سیٹھاہ افسوس زِ تمہِ کیاہ منٛگ تکیازِ سُہ اوس زانان یوحناؔ اوس اکھ پزٕ یور شخص۔ مگر سُہ ہیٚکہ ہے نہٕ اِنکار کرتھ یہِ تمہِ عرض کوٚڑمُت اوس، تکیازِ أمؠ اوس تمِس وعدہ دِیتمُت زِ سُہ دِیہ تمِس کینٛہہ تہِ یہِ سۅ منٛگہ، تہٕ ٲسندیو پژھو تہِ اوس یہِ وعدہ بوزمُت۔
\v 27 امی ساتہٕ کوٚر بادشاہن کسَ تام حکم "گژھِ تہٕ ژٹھ یوحناؔ ہس کلہٕ تہٕ دِیہ أمِس کورِ" پتہ گوٚو سُہ نفر جیلس منٛز تہٕ ژوٗٹن یوحناؔ ہس کلہٕ۔
\v 28 تٔم تھوو یہِ أکِس تھالس منٛز اُونن واپس، تہِ دِتُن تمِس کورِ۔ تمہِ کورِ نیٚو یہِ کلہٕ ماجہِ نِش۔
\v 29 ییٚلہِ یوحناؔ سنٛدیو شاگردو بوز کیاہ واقع سُپد، تِم  یوحنا سٕنٛدؠ شٲگرد گےَ جیٚلس منٛز تہٕ تُجکھ لاش؛ تہٕ دفنٲوٕکھ۔
\v 30 یسوعؔن یِم زٔنؠ پٔننؠ نمایندگی کرٕنہٕ باپتھ ژٲرِمتؠ ٲسؠ آیہِ واپس تِمو جأیؠو پٮ۪ٹھ یوٚت تِم سوٗزنہٕ آمُت ٲسؠ۔ تِمو بوزنوو سُہ روداد یہِ تِمو کوٚڑمُت اوس تہٕ یمچ تِمو لوٗکن تعلیم دِژمژ ٲس۔
\v 31 تٔمؠ ووٚن تِمن، "ؤلِو مےٚ سٟتؠ تتھ جایہ یتہِ نہٕ کانٛہہ آسہ روزان، تاکہِ أسؠ روزو تنہا تہٕ کرو اکھ رژھا آرام۔ "تٔمؠ ووٚن یہِ امہِ سببہ تکیازِ واریاہ لوٗکھ ٲسؠ لگاتار یمن نشہٕ یوان تہٕ گژھان، امیُک نتیجہِ دراو یہِ زِ یسوعؔ ہس تہٕ اہنٛدین ژاٹن اوس نہٕ وقت کھیٚنس تہِ چیٚنس یا بیٚیہِ کینٛہہ کرنس۔
\v 32 توے کھٔتؠ تم پانے أکِس ناوِ، وٲتؠ أکِس جایہِ یتہِ نہِ کانٛہہ انسان روزان اوس۔
\v 33 پوٚز واریہو لوٗکو وُچھ تِم نیران۔ تِمو پرزٕنٲوؠ تہِ زِ تِم ٲس یسوعؔ تہٕ تمہِ سنٛدِ ژاٹھ، تہٕ تِمو وُچھ تِم کوٚت ٲس گژھان۔ لہٰذا تِم لارییٚہ خوشک وتو تِمو تمام نزدیکی شہرو پٮ۪ٹھٕ یوٚت یسوعؔ تہٕ تمہِ سنٛدِ ژاٹھ گژھان ٲسؠ۔ تِم وٲتؠ حقیقتن یسوعؔ ہس تہٕ تہنٛدؠن شٲگردن برونٛہہ تتھ جایہِ۔
\v 34 \f + \fr 6‏:34 \ft بادشاہ۔ 22:17، توٲریخ 2۔ 18:16۔ \f* یتھے یسوعؔ تہٕ تمہِ سنٛدؠ ژاٹھ ناوٕ منٛز بوٹھ کھٔتؠ، یسوعؔن وُچھ یہِ لوٗکن ہنٛز بٹھ۔ تمِس آو یِمن پٮ۪ٹھ عار تکیازِ تِم ٲسؠ پریشان، تِم ٲسؠ تِمن تیٖرؠن ہنٛدؠ پٲٹھؠ یِمن نہِ کانٛہہ پوُہوٗل آسہ۔ توے ہیچھٕ ناونؠ تِم واریاہ چیز۔
\v 35 دوپہر ژیرِ آیہِ تمسنٛدؠ ژاٹھ تمِس نِش تہِ ووٚن ہس، "یہِ چھِے سۅ جایہ یتہِ نہِ کانٛہہ روزان چُھ، تہٕ وُنؠ گوٚو سیٹھاہ ژیر۔
\v 36 لہٰذا سوٗزکھ یِم لوٗکھ انٛدؠ پٔکؠ قصبن تہٕ گامن تاکہِ تِم ہیکن کینٛہہ غذا پانس کیت مٔلؠ ہؠتھ!"
\v 37 مگر أمؠ دِتُکھ جواب، "نہِ، توٚہؠ دِیو پانے یِمن کینٛہہ کھؠنہٕ خٲطرٕ!" تِمو دیت تمِس جواب، "أسؠ ہیکوٗے نہٕ تیٖژ ژوٗٹ مٔلؠ ہٮ۪تھ یسَ یِمن لوٗکن دِموٗ، اگرچہ اسہِ آسہ ہے تیوت رقم یتھ اکھ نفر دوٗن ہتھن دوہن کٲم کٔرنہٕ سٟتؠ زینؠ ہے!"
\v 38 مگر أمؠ دیت یِمن جواب، "تۅہہِ کٟتؠ ژوٗچہ ؤرؠ چُھو؟ گژھو تہٕ أنِو!" تِم گےَ تہِ وُچھکھ تہٕ پتہ ونُکھ أمِس، "اسہِ چھِ صرف پانٛژھ ژۅچہِ تہٕ زٕ بُزتھ گاڈٕ!"
\v 39 تٔمؠ دِیت تِمن شٲگردن ہدایت ونیٚو تمام لوٗکن سبز گاسس پؠٹھ بہینہٕ باپتھ۔
\v 40 لہٰذا بیٹھؠ تِم لوٗکھ ٹۅگجن منٛز۔ کنہِ ٹۅگجہِ منٛز ٲسؠ ہتھ لوٗکھ تہِ پنٛژاہ ٲسؠ باقیو ٹۅگجن منٛز۔
\v 41 یسوعؔن نیہ تِمہٕ پانٛژھ ژۅچہِ ؤرؠ تہِ زٕ گاڈٕ۔ تٔمؠ کٔر آسمانس کنُ نظر تہِ کوٚرن یِمن پؠٹھ خدایہِ سُنٛد شُکر ادا۔ پتہ کٔر تٔمؠ تِمن ژۅچن ٹکرٕ تہِ گاڈن کھنٛجہِ تہِ روٗد تِمن ژاٹن دِوان تاکہِ تِم کٔرن تِمن لوٗکن منٛز تقسیم۔
\v 42 ہرَ کانٛسہِ کھیٚو یڈ بٔرِتھ  یہِ غذا۔
\v 43 تِمو شاگردو کوٚر پتہ ہورمُتھ ژۅچہِ تہِ گاڈٕ جمع تِمہٕ درایہِ بوٗکہٕ باہ پجہِ۔
\v 44 \f + \fr 6‏:44 \ft تتہِ ٲسہِ زنانہٕ بیٚیہِ ٲسؠ شُرؠ مگر تِم آیہِ نہٕ گنزراونہٕ۔ متی 14:21۔ \f* یِمو لوٗکو یمہٕ ژۅچہِ تہٕ گاڈٕ کھییٚہِ تِم ٲسؠ پانٛژھ ساس مرد۔ ہتاکہ تِمو گنٛزرٲوؠ نہٕ زنانہٕ تہٕ شُرؠ۔
\v 45 یسوعؔن دِیُت پننؠن شٲگردن حکم زِ فورن وسیٚو ناوِ منٛز تہٕ گژھو برونٛہہ کنُ اکِس قصبس کُن یتھ ناو چُھ بیت صیدا، یُس تتھ گلیل کس سمندرس أندؠ پٔکؠ اوس۔ سُہ ٹھہروو تہِ دیتن تِمن واریہن لوٗکن رخصت یِم تتہِ ٲس۔
\v 46 تِمن لوٗکن رخصت دِنہٕ پتہ، سُہ کھوٚت تتھ بالس ہؠوٗر دُعا کٔرنہٕ خٲطرٕ۔
\v 47 ییٚلہِ شام ووت، تہنٛدؠن شٲگردن ہنٛز ناو ٲس تتھ سٕدرس منٛزس، تہٕ یسوعؔ اوس پانہٕ زمینہِ پٮ۪ٹھ۔
\v 48 تٔمؠ وُچھ زِ واو اوس ناو پکناوان والین مخالف۔ اوٕ کِنؠ ٲسؠ تِمن مشکلات پیش یوان۔ سُہ ووت تِمن نِش صبحس سُلے، ییٚلہِ وُنؠ گٹہٕ زولے اوس، آبس پؠٹھؠ پکان پکان۔ سُہ اوس یژھان یِمن کنِؠ پکن۔
\v 49 تِمو وُچھ سُہ آبس پؠٹھؠ پکان، مگر تِمو سونچ زِ یہِ چُھ بد روح۔ تِمو دِژٕ کریکہٕ۔
\v 50 تکیازِ تِم کھوژٕ ییٚلہِ تِمو سُہ وُچھ۔ مگر تٔمؠ کٔر تِمن سٟتؠ کتھ۔ تٔمؠ ووٚن تِمن، "ژھۅپہٕ کروُ! مٕہ کھوٗژو، تکیازِ یہِ چُھس بہٕ!"
\v 51 سُہ ووٚتھ ناوِ منٛز تہٕ بؠوٹھ تِمن سٟتؠ تہٕ واو وڑون گوٚو بنٛد۔ تِم گےَ مکمل حٲران تتھ متعلق یہِ تٔمؠ کوٚڑمُت اوس۔
\v 52 ہرگاہ تِمو اوس یسوعؔ ژوچن تہٕ گاڈن ہُرؠر کران وُچھمُت، تِمو اوس نہِ امیٚک مطلب فِکرِ توٚرمُت، یتھٕ پٲٹھؠ تِمن پٔزِہے۔
\v 53 تِم گےَ گلیلکس سمندرس انٛدؠ پٔکؠ ناوِ منٛز برونٛہہ، تِم آیہِ بٔٹھس گنیسرتؔ شہرس نِشہ۔ تِمو لاجؠ اتؠ بٹھس ناو۔
\v 54 یتھے تِم ناوِ منٛزٕ کٔھتؠ، لوٗکو پرزٕنوو یسوعؔ۔
\v 55 لہٰذا تِم گےَ دوران سٲرسےٕ شہرس منٛز زِ باقین ونہٕ ہن زِ یسوعؔ اوس تتہِ۔ پتہ تلُؠ لوٗکو بیمار ڈٲنجن پٮ۪ٹھ تہٕ پکٕناوِکھ تتھ جگہس یتؠن لوٗکو تِمن ووٚنمُت اوس زِ یسوعؔ چُھ۔
\v 56 یتھ تہِ گامس، شہرس، یا کُنہِ جگہس یسوعؔ گژھان اوس لوٗکھ ٲسؠ بازرس منٛز بیمارن انَان۔ تہٕ تِم بٮ۪مار رودؠ زارٕ پار کران یسوعسؔ زارٕپارٕ کران زِ تِمن دِین پنہٕ نؠن پلون اتھٕ لاگنہٕ تاکہِ یسوعؔ بلٕراوٕ تِمن۔ یِم تہِ اتھٕ تمِس یا تہنٛدؠن پلون اتھٕ لاگان ٲسؠ تِمن سارنےٕ اوس شفأ سپدان۔
\c 7
\p
\v 1 اکہ دوٚہہ آیہِ کینٛہہ فریسی تہٕ کینٛہہ کٲتب بیٚیہِ کژتام شخصس یِم یہُودؠ شریعت ہیٚچھِ ناوان ٲسؠ تہٕ یِم یروشلمہٕؔ پؠٹھٕ تِم گےَ یسوعؔ ہس أندؠ أندؠ جمع۔
\v 2 تِمو فریسییو وُچھ زِ تٔمؠ سٕنٛدؠ شٲگرد ٲسؠ اکثر گۅڈٕ پننؠ اتھٕ چھلہٕ نَے کھیوان یتھٕ پٲٹھؠ تُہنٛد خاص رواج اوس۔
\v 3 تِم فریسی تہٕ تِم سٲری باقی یہُودؠ ٲسؠ سختی سان پننؠن ریواجؠن مانان یِم تہنٛدیو جدو تِمن ہیٚچھِ نٲومٕتؠ ٲس۔ مثالے، تِم ٲس کھؠنس تۅتام اِنکار کران یۅتام نہٕ تِم گۅڈٕ پننؠ اتھٕ اکہ خاص رسمہٕ سان چھلہٕ ہن۔
\v 4 خاص کرِ بازرس منٛز چیٖزن ہنٛزٕ خریداری کرنہٕ پتہٕ گرٕ واپس یتھ۔ تِم ٲسؠ سونچان زِ خدا گژھِ تِمن ژأکھی اگر نہٕ تِم تہِ کرن، تکیازِ کینٛہہ لوٗکھ یا چیٖز چھِ خدایس نامنظور تِمو ما آسہ یِمن کنُ اتھٕ لوٗگہٕ متھ یا تِمن چیٖزن یِم تِمو مٔلؠ ہٮ۪تھؠ۔
\v 5 تمہِ دوٚہہ، تِمو فریسییؤو تہٕ شخصو یِمو یہُودؠ شریعت پروٕمُت اوس ووٚن زِ تہنٛدو شاگردو منٛزٕ کینٛہہ شٲگرد ٲسؠ چھلہٕ نَے  اتھو سٟتؠ غذا کھیوان تِمو آسہ نہٕ یہودی خاص رسمس مطابق اتھٕ چھلہِ مٕتؠ۔ اوے کوٚر تِمو یسوعؔ ہس سوال، "چٲنؠ ژاٹھ چھِ سانن بزرگن ہنٛزن ریوایٔژن ہنٛز نافرمانی کران! تِمو کیازِ کھیٚو غذا اگر نہِ تِمو پننؠ اتھٕ سأنہِ رسمہٕ مطابق چٔھلؠ مِتؠ ٲسؠ!"
\v 6 \f + \fr 7‏:6 \ft یسعیاہؔ 29:13\f* یسوعؔہن ووٚن تِمن، "یسعیاہؔ ہن کٔر تُہنٛدن جدن بےوٲری، تہٕ تٔمؠ سنٛزٕ کتھٕ چھے توٚہہِ لوٗکن ہنٛزٕ وضاحت اصل پٲٹھؠ کران یِم ٲکھِتھ پٲٹھؠ رُت لاگان چھِ یانے ریاکار چھِ! تِمؠ لیچھ تِمہٕ کتھٕ یِمہٕ خداین ونہِ: یِم لوٗکھ چھِ کتھٕ کران زنہٕ تہِ مےٚ یزتھ کران مگر تِم چھِنہٕ پٔزٕؠ پٲٹھؠ مےٚ متعلق یزتھ کرنُک سونچان۔
\v 7 \f + \fr 7‏:7 \ft یسعیاہؔ 29:13\f*تہنٛزٕ مےٚ عبادت کرُنؠ چھِ بےکار، تکیازِ تِم چھِ صرف سۅ تالیٖم دِوان یہِ لوٗکھ ونان چھِ زنہٕ تہِ اوس مےٚ پانے تِمن حکم دیتمت،
\v 8 توٚہؠ، چُھو پنہٕ نؠن جدنَ ہنٛدؠ پٲٹھؠ، تہِ کرنس اِنکار کران یہِ خداین حکم کوٚڑمُت چُھ۔ امہِ بدلہٕ، چُھو توٚہؠ صرف تِمنے ریوٚایٔژن پؠٹھ پکان یمن ہنٛزٕ باقےٕیو توٚہہ تألیٖم دژٕمژ چُھو۔"
\v 9 بیٚہِ ووٚن تِمن یسوعؔن، "توٚہؠ چُھو سونچان زِ توٚہہ چُھو چالاکھ تتھ اِنکار کرنس منٛز یہِ کرِ نُک خداین حکم کوٚڑمُت چُھ صرف امہِ خٲطرٕ زِ توٚہؠ پٔکؠو پننؠن ریواجن پؠٹھ!
\v 10 \f + \fr 7‏:10 \ft خروج 20:12، تثنِیہ شرع 5:16۔ \f* مثالے، سأنؠ جدنَ موسیٰؔ ہن لیکھ خدایہ سٕنٛدِ حکم، "پنہٕ نس مألس ماجہِ کٔرو یَزتھ، تٔمؠ لیوکھ یِتہِ، "اختیار تھاون وٲلؠ گژھن تمِس نفرس قتل کرُنؠ یُس پنہٕ نس مألس یا ماجہِ بد رد ونہِ،
\v 11 پوٚز توٚہؠ چُھو لوٗکن تعلیم دِوان زِ یہِ چُھ سورےٕ بلکل ٹھیک اگر لوٗکھ پننؠ چیٖز پننس مألس ماجہِ بدلہٕ خدایس قربان کرِن۔ توٚہؠ چُھو تِمن تہنٛدس مألس ماجہِ یہِ ونہٕ نُکھ تہِ اِجازتھ دِوان، "یہِ بہٕ توٚہہ دِوان اوسس، وۅنؠ چُھ مےٚ خدایس دِنُکھ وعدہ کوٚڑمُت۔ اوے ہیٚکہ نہٕ بہٕ توٚہؠ زیادٕ کألس مدد کٔرتھ!"
\v 12 امیٚک مُدعا چُھ نیران، توٚہؠ چُھو لوٗکن اصلی ونان زِ تِمن چھِنہٕ پنہِ نس مألس ماجہِ زیادٕ کألس مددکٔرُن۔
\v 13 یتھٕ پٲٹھؠ چُھو توٚہؠ خدایہ سُنٛد حکم رد کران! توٚہؠ چُھو پنہِ نیٚنےٕ چیٖزن ہنٛزٕ تعلیم باقین دِوان تہِ ونان چُھو زِ تِمن پٔزِ یمن ہنٛز فرمانبرداری کرٕنؠ۔ تہِ یتھٕ پٲٹھؠ چُھو توٚہؠ باقیو واریاہ چیٖز کران۔"
\v 14 یسوعؔن دژٕ پتہ دُبأرٕ لوٗکن نزدیک ینچ دعوت۔ تمہِ پتہ ووٚننکھ، "توٚہؠ سٲری لوٗکھ بوٗزو میون! یہِ بہٕ توٚہؠ ونن وول چُھس تہِ کرو سمجنٕچ کوٗشش۔
\v 15 کانہٛہ تہِ چیٖز چُھنہٕ یُس لوٗکھ کھیوان چھِ تہٕ خدایہ چُھ تتھ ناپاک تصور کرناوان۔ اتھ برعکس، یہِ کینژھا آدمس نِش انٛدرٕ نیران چُھ سُہ چھِ خدایہ ناپاک تصور کرناوان۔"
\v 16 توٚہؠ منٛزٕ گژھِ ہرَ کانٛہہ احتیاط سان سونٛچن تتھ متعلق یہِ مےٚ ووٚن توٚہؠ بوٗزو۔
\v 17 لوٗکہٕ ارساتہِ منٛزٕ نیرنہٕ پتہ ژاو یسوعؔ پننؠ شٲگرد ہٮ۪تھ أکِس گٔرس منٛز۔ تِمو پرُوژھ تمِس تمہِ مثالہِ ھنٛد مانے یوسہ تٔمؠ وۅنؠ وُنؠ مژٕ ٲس۔
\v 18 تٔمؠ دِیُت تِمن جواب، "کیاہ توٚہؠ تہِ چُھوا ناسمجھ؟ کیاہ توٚہیہ تہِ چُھنا فِکرِ ترٛان زِ یہِ کینژھا نیٚبرٕ یتھ آدمس اندر دٲخل گژھان چُھ سُہ چُھنہٕ خدایہ اسہِ موٗکر تصور کرناوان۔
\v 19 اوٕکنؠ زِ سُہ چُھنہٕ سٲنس دماغس منٛز دٲخل گژھان تہٕ اتھ خراب کران بٔلؠ کہ چُھ یٔڈ منٛز گژھان تہٕ نجاست بنتھ سانیٚو بدنو منٛز نیٚبر نیران" یہِ وننہٕ سٟتؠ اوس یسوعؔ اعلان کران زِ سٲری کھؠنہٕ چیٖز چھِ شوٗژ گنزرنؠ۔
\v 20 تٔمؠ ووٚن یتہِ، "یِم چھِ خیالات تہٕ عملہٕ یمہِ انسانس انَدرؠ کِنؠ نیٚبر نیران چھِ سُے چُھ خدایہ موٗکر تصور کرناوان۔
\v 21 خاص طورِ پٲٹھؠ، یہِ چھُ  أکِس انسانہٕ سُنٛد اندرون یتہِ پؠٹھٕ تِم گندٕ چیٖز ۅتلان چھِ؛ تِم چھِ حرام کامہ کران، ژوٗر کران، قتل کران۔
\v 22 تِم چھِ زنا کأری کران، تِم چھِ لالچی آسان، تِم چُھ عداوت تھاوان، تِم چھِ لوٗکن دٔغا کران۔ تِم چھِ بے شرم آسان، تِمن چُھ لوٗکن ہُنٛد حسد یوان، تِم چھِ بیین ہنٛزٕ بدنامی کران، تِمن چُھ گٔمنڈ آسان، تِمن منٛز چھِ بےہودگی آسان۔
\v 23 لوٗکھ چھِ سونچان یم چھِ خیال، تہٕ پتہ چھِ تِم یمہٕ بُرٕ کٲمہ کران، اوٕ کِنؠ چھُ خدا انسانن پانس ناپاک زانان"
\v 24 أمہِ پتہٕ ییٚلہِ یسوعؔ پنٕنؠ  شٲگرد ہٮ۪تھ گلیلِ ترٲوِتھ  گےَ  صور تہِ صیدا شہرِ کؠن انٛدؠ پٔکؠ علاقس منٛز۔ أکِس گرس منٛز دأخل گژھتھ اوس نہٕ یژھان زِ تسَ گژھِ کانٛہہ زاننُ پوٚز سُہ ہیوٗک نہٕ لوٗکن نِش تتہِ پوشیدٕ روٗزتھ۔
\v 25 اکھ خاص زنان آیہِ یسوعسؔ نِش تس متعلق خبر بوزِتھ یکدم تہٕ تسَ پیہِ کھوٗرن تل، تکیازِ تمہِ سنٛزٕ کورِ اوس ناپاکھ روح پریکس ژامت۔
\v 26 چونکہِ یہِ زنانہٕ ٲس نہٕ اکھ یہُودؠ۔ تٔمؠ سنٛدؠ جد ٲسؠ نہٕ یہُودؠ۔ سۅ ٲس پأنہٕ ضلع سیرِیا فِینیکی علاقس منٛز زآمژ گیمژٕ۔ تمہِ کوٚر یسوعؔ ہس زارٕ پارٕ زِ میٛانہِ کورِ منٛزٕ کڈ تہٕ بد روح نیٚبر۔
\v 27 تٔمؠ ون تمِس زنانہِ، "گوڈٕ گژھِ شُرؠن تیوٗت کھؠن دِیون یوٗتاہ تِم یژھان آسن، تکیازِ یہِ چُھنہٕ کانٛسہِ ہنٛدؠ خٲطرٕ جان زِ سُہ نیہ سُہ غذأ یُس ماجہِ کوٚر پننؠن شُرؠن ہنٛدِ خٲطرٕ تیار تہٕ پتہ ترٛاوو ہوٗنہِ بچن۔"
\v 28 تٔمؠ دِیُت تمِس جواب، "جناب، یہِ توٚہہِ ونُو تہِ چھُ پوٚز، مگر یتھٕ کٔنؠ چھِ گرِ ہوٗنؠ تہِ یِم میزس تل بہتھ شُرؠن ھنٚدؠ ژھٹٕۂ پھٔلؠ کھیوان چھِ۔"
\v 29 یسوعؔن ووٚن تمِس، "چأنؠ امہِ وننہ کنِؠ گژھِ گرٕ۔ چانہِ کورِ کوٚڑ مےٚ بدروح نیٚبر۔"
\v 30 سۅ زنانہ وٲژ گرٕ پُنن واپس تمہِ وُچھ تس سنٛز کوٚر ٲس بسترس پٮ۪ٹھ ژھوپہٕ کٔرتھ بہتھ تہٕ بدروح اوسس درٛامت۔
\v 31 یسوعؔن تہٕ تسَنٛدیو شاگردو تروو سُہ صورک أندؠ پکھ علاقہٕ تہٕ گےَ شُمالس کِنؠ صیدا منٛزِ، پتہٕ مشرقہِ کِنؠ دِکپُلِس کس علاقہٕ منٛزِ، تہٕ پتہ جنوبہٕ طرفہِ تِمن شہرن کن یم گلیل سمندرس نکھٕ ٲسؠ۔
\v 32 تتہِ، اوٚن لوٗکو اکھ زوٗر تہِ کوٗل نفر تمِس نِشہ۔ تِمو کوٚر یسوعؔ ہس زارٕ پارٕ تمِس نفرس اتھٕ ڈالہِ باپتھ تاکہِ تمِس سپدِ شفأ۔
\v 33 یسوعؔن نیٚو سُہ تمہِ لوٗکن ہنٛزِ بِٹھِ منٛز الگ دوٗر تاکہِ تِم زٕ روٗزن تنٕہا۔ پتہ ترٛاوین پنٗنہِ اوٚنگجہِ تمِس نفرس کنَن منٛز۔ پننؠن انٛگجِین تھوٗکھ متھنہٕ پتہٕ، مٔژھنس زیوِ پنہٕ نیٚو انٛگجِیو سٟتؠ۔
\v 34 پتہ کٔر تمٔؠ آسمانس کنُ نظراہ، ترٛوونُ ووٚش تہٕ پتہ ووٚنُن تمِس نفرس کنن منٛز تہنٛزِ زبانہِ منٛز "اِفتاحؔ" امیٚک مطلب گوٗو "مُژرنہٕ یہِ!"
\v 35 یکدم گےَ تمِس نفرس کنَ یلہِ۔ تمِس آیہ زبان مُژراونہ، یمؠ سُہ کوٗل کوٚڑمُت اوس تتھ سپدس شفأ۔
\v 36 یسوعؔن ووٚن تِمن لوٗکن زِ یہِ ونن نہٕ کأنسہِ یہِ تٔم کوٚڑمُت اوس۔ پوٚز، یوٗتاہ سُہ تِمن بانٛد بانٛد کران اوس تیوٗتاہ ٲسؠ ژر پارے سپدان۔
\v 37 یِمو لوٗکو اتھ متعلق بوز تِم گےَ سراسر حٲران تہٕ ٲسؠ ونان، "ہرَ کینٛہہ یہِ تٔمؠ کوٚر چُھ حٲران کران وول! باقیو حٲرت انٛگیز چیٖز کرنہٕ علاوٕ، تٔمؠ دِیُت زرؠن بوٗزنُک طاقت! تہٕ کلؠن کتھٕ کرنُک طاقت!"
\c 8
\p
\v 1 تِمن دوہن دوران، اکہِ دوٚہہ اکھ لوٗکہٕ ارساتہٕ گوٚو بیٚہِ جمح۔ تِم ٲسؠ تتہِ ترٛییٚو دوٚہو پٮ۪ٹھٕ پتہ کھؠن چینہِ بغٲر۔ یسوعؔن ٲنؠ پننؠ شٲگرد پانس نکھٕ، تہٕ ووٚننٛکھ،
\v 2 "مےٚ چُھ یِمن لوٗکن پؠٹھ عار یوان تکیازِ ترٛییو دوٚہو پیٹؠھ چھِ یم مےٚ سٟتؠ تہٕ کھؠنہٕ باپتھ چُھنہٕ یِمن نِشہ ونہِ کؠن کِہنؠ۔
\v 3 اگر نہٕ یِمن بۅچھِ ہتؠن گرٕ گژھنہٕ باپتھ رۅخصت کرٕ تِمو منٛزٕ گژھن کینٛہہ وتہِ بےہوش۔ تِمن چھِ کینٛہہ دوٗرِ پؠٹھِ آمٕتؠ۔"
\v 4 تمہِ سنٛدیو شٲگردو زون زِ سُہ اوس تِمن مشورٕ دوان زِ تِمے دِن لوٗکن کینٛہہ کھؠن، اوے دیُت اکؠ شٲگردن جواب، "یہِ ہیٚکہ نہِ ممکن سُپدتھ ییتِس لوٗکہٕ ارساتس کتہِ انو کھؠن۔ یتھ وجارٕ جایہِ چُھنہٕ کانٛہہ روٗزان!
\v 5 یسوعنؔ پرُژھ تِمن، "توٚہہِ نِشہ کٔژ ژۅچہِ چھِ؟" تِمو دیُت جواب، "اسہِ نِشہ چھِ ستتھ سٔترِ ژۅچہِ۔"
\v 6  یہِ بوزِتھ ووٚن یسوعنؔ یِمن لوٗکن أتی پتھرِس پیٚٹھ بیٚہنہٕ باپتھ، پتھر بہنہٕ پتہ، تٔمؠ تُجہ ستتھ ژۅچہِ خدایس کوٚرن تِمن باپتھ دُعا، تِم پھڑراوین، پتہ دِژن پننؠن شٲگردن لوٗکن دنہٕ باپتھ۔
\v 7 تِمن نِشہ آسہ کینٛہہ لوٗکچہِ گاڈٕ تہِ۔ تٔمؠ کوٚر یِمن پؠٹھ خدایس شُکر گٔزاری، تٔمؠ ووٚن پننؠن شٲگردن، "یِمہٕ تہِ دِیو تِمن۔ "پتہ دژٕ تِمو لوٗکہ ارساتس تِمہٕ گاڈٕ۔
\v 8 لوٗکو کھیٚو یہِ غذا، تہٕ، تِمو کھیٚو یڈ برٛتھ۔ تسَ سنٛدیو شاگردو کرٕ بچٲمتؠ ژۅچہِ ٹکٔرِجمع تہِ، تِمو بھرِ ستتھ ٹوکرِ۔
\v 9 تمسنٛدیو شاگردو کوٚر اندازٕ زِ اتہِ ٲسؠ أمہِ دوٚہہ ژور ساس کھٮ۪نہٕ وٲلؠ لوٗکھ یِمو تمہِ دوٚہہ کھیٚو۔ پتہ دِیت یسوعؔن تِمن رخصت۔
\v 10 تمہِ پتہ فورَن، پننؠن شٲگردن سٟتؠ کھوٗتہ ناوِ، پتہ کوٚر تِمو گلیلک سمندرٕ تٔرِتھ وٲتؠ دلمنُوتہ علاقس منٛز۔
\v 11 پتہ آیہِ کینٛہہ فریسی یسوعؔ ہس نِشہ۔ تِم لٔگؠ تمِس سٟتؠ مُجادلہٕ کٔرنہِ تہٕ زور دوان روٗدِس زِ تِمن ہاوٕ خداین سوٗزنچہ اکھ آسمأنؠ نشٲنی۔
\v 12 یسوعؔن ترٛوو زیوٹھ ووٚش پانس سٟتؠ، تہِ پتہ ووٚن تٔمؠ، "توٚہؠ کیازِ چُھو مےٚ معجزٕ ہاؤنکُ ونان؟ بہٕ کرٕ نہٕ تُہنٛدؠ باپتھ کانٛہہ معجزٕ!"
\v 13 پتہ ترٲوؠ تٔمؠ تِم أتی۔ سُہ تہِ تسندؠ شٲگرد کھتؠ بیٚہِ ناوِ تہِ گلیل سمندرس ترِ اپور۔
\v 14 تسنٛدین شٲگردن ٲس سیٹھاہ ژۅٹ پانس سٟتؠ تُلنؠ گٔمژ مٔشتھ۔ خاصکر، ناوِ منٛز ٲس تِمن نِشہ صرف کھیٚن چیٚنہٕ باپتھ سٔترِ ژۅچہِ ہُنٛد اکھ ٹُکرِ۔
\v 15 چونکہِ، تِم ٲسؠ ناوِ منٛز پکان، یسوعنؔ کٔرؠ تِم ہوشیار تہِ ونُکھ، "ہوشیار روزِو! فریسی ین ہنٛزِ خمیٖر تہٕ ہیرودیسی سنٛزِ خمیٖرِ نِشہ نجات!"
\v 16 شاگردو سمجھ سُہ غلط۔ اوے ووٚن تِمو اکھ اکِس، "تمؠ آسہ پوٚز ونمُت زِ اسہِ نش چھنہٕ ژۅچے۔"
\v 17 یسوعؔ ہس ٲس پتاہ زِ تِم کتھ پؠٹھ ٲسؠ پانہٕ وٲنؠ بحث کران، اوے ووٚن تٔمؠ تِمن، "توٚہؠ کیازِ چُھو پانہٕ وٲنؠ کتھٕ کران زِ اسہِ نش چھنہٕ زیادٕ ژۅٹ؟ توٚہہ پزٕ سمجھن یہ مےٚ ونیُک تام ووٚن! توٚہؠ چُھونا سونٛچان!
\v 18 چشمہٕ چھیٚو، پوٚز توٚہہ چُھو نہٕ سمجھان تہِ یہِ توٚہہ وچھان چُھو! توٚہہ چُھو کنَ، پوٚز توٚہہ چُھو نہٕ تہِ سمجھان تہِ یہِ مےٚ ووٚن!" پتہ پرُوژھن تِمن، "کیاہ توٚہہ چُھو ناہ یاد کیاہ سُپد
\v 19 یمہِ لٹہِ مےٚ پانٛژھ ژوچہِ پانٛژن ساسن ہُنٛدٕ باپتھ پُھٹراوِ تہِ توٚہہِ کٲژاہ پجہِ تُجو بچاوِمژَو ژۅچۅ سٟتؠ بٔرِتھ؟" تِمو دِیت جواب، "باہ پجہِ۔"
\v 20 پتہ پرُوژھکھ تٔم، "یمہِ لٹہِ مےٚ ستتھ ژۅچہِ پھُٹراوِ ژوٚن ساسن لوٗکن دِنہٕ خٲطرٕ، بیٚہِ ییٚلہِ ہرَ کانسہِ یڈ بھرتھ کھیٚو، توٚہہ کٲژاہ ٹوکرِ تُجو بچاومژٕ ژۅچہِ منٛزٕ؟ تِمو دیت جواب، "ستتھ بھرتھ پجہِ۔"
\v 21 پتہ ووٚن تٔمؠ تِمن، "توٚہیہ تُروو نا وُنہِ تہِ فِکرِ۔"
\v 22 تِم وٲتؠ بیت صیدا شہرس منٛز۔ لوٗکو أنؠ یسوعؔس نِشہ اکھ اون نفر تہٕ تمِس کوٚرکھ زارٕ پارٕ تمِس نفرس اتھٕ ڈألٕنہ خٲطرٕ تاکہِ تمِس سٕپدِ شفا۔
\v 23 تٔم کٔر ٲنس نفرس اتھس تھپھ تہٕ نیوٗن پانس سٟتؠ شہرِ نیٚبر۔ تہنٛزن أچھن تھوٗکھ متھنہٕ پتہٕ، پننؠ اتھٕ تھاون تمِس نفرس پؠٹھ، پرُوژھنس، "کیاہ سا بوٗزنہٕ چُھے یوان؟"
\v 24 تٔمؠ نفرن تُجہ أچھ تہٕ پتہ ووٚنُن، "آ، بہٕ چُھس لوٗکھ وُچھان! تِم چھِ اورٕ یوٗر پکان، مگر صاف چُھم نہٕ بوٗزنہٕ یوان۔ تِم چھِ مےٚ کُلؠ ہیوٗ باسان!"
\v 25 یسوعؔن ڈوٗلؠ تمِس ٲنس دُبارِ أچھن اتھٕ۔ سُہ نفر لوٗگ مُدے گٔنڈتھ وُچھنہَ، تمِس گوٚو تمہِ وزِ مکمل شفأ! سُہ اوس ہیکان ہرکانٛہہ چیٖز صاف صاف وُچِھتھ۔
\v 26 یسوعؔن ووٚن تمِس، "شہرس منٛز مہَ گژھِ!" پتہ سوٗزن سُہ نفر پنن گرٕ۔
\v 27 یسوعؔ تہٕ تسٕندؠ شٲگرد درٛایہِ بیت صیدا شہرِ منٛزٕ تہِ گےَ تِمن گأمنَ منٛز یِم قیصریہ فلپی شہرس نکھٕ ٲس۔ وتہِ منٛز پرُوژھ تٔمؠ تِمن، "لوٗکھ کیاہ چھِ مےٚ ونان بہٕ کسُ چُھس؟"
\v 28 تِمو دِیت جواب، "کینٛہہ لوٗکھ چھِ ونان ژٕ چُھکھ یوحناؔ بپتسمہ دنہٕ وول۔ باقیو چھِ ونان زِ ژٕ چُھکھ سُہ ایلیاہؔ رسول۔ تہٕ کینٛہہ چھِ ونان زِ ژٕ چُھکھ بروٛنٹھِمیٚو رسولو منٛزٕ اکھ رسول۔"
\v 29 \f + \fr 8‏:29 \ft مسیحؔ، یُس خدایہِ سٕنٛدِ طرفہٕ اکہِ خاص کامہِ خٲطرٕ چُھ مقرر آمُت کرنہٕ۔ \f* تٔمؠ پرُوژھ تِمن "توٚہؠ کیاہ چھِ ونان؟ توٚہؠ کیاہ چُھو ونان بہٕ کسُ چُھس؟" پطرسنؔ دِیت جواب، "اسہِ چُھ یقین ژٕ چُھکھ مسیحؔ!"
\v 30 اوٕ پتہٕ کوٚر یسوعؔن تِمن تاکید زِ وُنہِ ؤنؠ زیٚو نہٕ کٲنسے زِ سُہ اوس مسیحؔ۔
\v 31 پتہ کٔر یسوعؔن تِمن تعلیم دِنؠ شروع زِ آدمؔ سُنٛد گۅبُر، تُلہِ سیٹھاہ دوٗکھ۔ بزرگ، کاہنن ہنٛدِ سردار، یہُودینؔ ھنٛد فقِیہ زانن وٲلؠ شخصس کٔرن تمِس رد۔ سُہ سپدِ قتل، ترٛیہِ دوٚہہ پتہٕ ییہِ سُہ دُبارِ زندٕ کرنہٕ۔
\v 32 یہِ کتھ ؤنؠ تٔمؠ صاف صاف تِمن۔ مگر اتھ پٮ۪ٹھ نیٚو سُہ پطرسنؔ بیس اندس کنُ تہٕ لوٗگنس یہِ وننس پٮ۪ٹھ اعتراض کرُن۔
\v 33 یسوعؔ پھیور پتھ کنُ تہٕ پنہٕ نؠن شٲگردن کنُ کرن نظر۔ پتہٕ کٔرن پطرسسؔ کھرٛنگ ووٚننس، "امہِ طریقہٕ سونٛچن کرِ بنٛد! ژٕ چھے شیطان یژھٕ کتھٕ کرناؤان! بجایہ یہِ زِ یہِ خدایہ چُھ مےٚ یژھان کرناون، ژٕ چُھکھ مےٚ صرف تہِ یژھن مےٚ کرناؤن۔"
\v 34 پتہٕ لوٗکہٕ ارساتس ہٮ۪تھ ٲنؠ تٔمؠ پننؠٕ شٲگرد پانس کنُ تاکہِ تِم ہیکن تٔمؠ سُنٛد بوزِتھ۔ تٔمؠ ووٚن تِمن، "اگر توٚہہ منٛزٕ کانٛہہ مؠٚون شٲگرد چُھ یژھان بنن آسہ، یہِ چُھ نہٕ سٔہل۔ توٚہہ پٔزِ مجرمن ھنٛدؠ پٲٹھؠ ظلمہِ ستم برداش کرنہٕ خٲطرٕ تیار روٗزن یِمن پنن صلیب تِمن جاؠن تام واتہٕ ناونہٕ خٲطرٕ مجبور چھِ یوان کرنہٕ ییٚتہِ تِمن پھاسؠ ییہِ دِنہِ۔ یُس اکھا مؠون ژاٹھ یژھان چُھ بنَن تمِس پٔزِ یہِ کرُن۔
\v 35 توٚہہ پٔزِ تہِ کرُن تکیازِ یُس اکھاہ پُنن پان بچاوُن یژھان چھِ سُہ چُھ مؠٚون سُہ چھلہِ زندگی نِشہ اتھٕ۔ تِٔمؠ میأنؠ شٲگرد یِمن مٲرن تکیازِ تٔمؠ ٲس لوٗکن رٕژ شیٚچھ ونان، روٗزن ہمیشہ مےٚ سٟتؠ زندٕ۔
\v 36 اگر لوٗکھ ہرَ کانٛہہ چیٖز یتھ دنیاہس منٛز حاصل کرن یِم تم یژھان چھِ، پوٚز تِمن چُھنہ حاصل گژھان کینٛہہ اگر نےَ تِمن ابدی زندگی حاصل گژھؠ!
\v 37 یتھ کٔتھِ پؠٹھ کٔرؠوٗ احتیاتہٕ سان غوٗر زِ ییٚتہِ چُھنہٕ پٔزؠ پٲٹھؠ کانٛہہ سُہ چیٖز یُس انسان خدایس دییہِ ہے زِ سُہ دییہِ ہے تمِس ابدی زندگی حاصل کرنہٕ!
\v 38 تہٕ یتھ متعلق تہِ سونچُو: واریاہ لوٗکھ چھِ یہِ ونہٕ نس تہِ اِنکار کران زِ تِمؠ چھِ میأنؠ۔ یہِ بہٕ از ونان چُھس تِم چھِ اِنکار کران ییٚلہِ لوٗکھ خدایس نِشہ دوٗر گٔمتؠ چھِ تہٕ گناہن منٛز چھِ گرفتار، بہٕ، آدمؔ سُنٛد اولاد، تہِ کرِ اِنکار زِ تِمؠ چھِ میأنؠ ییٚلہِ بہٕ پاک روحن سٟتؠ واپس یمہٕ تہٕ سۅ شان آسیٚم یس میٚانس ببس چھِ!"
\c 9
\p
\v 1 یسوعؔن ووٚن لوٗکہِ ارساتس تہٕ پنہٕ نؠن شٲگردن، "بوزیٚو ہوشہٕ سان! توٚہہ منٛز یِم یتتھ وُنہ کؠن اِستادٕ چھِ چؠن نہٕ موتُک پیالہٕ توٚت تام یوٚت تام نہٕ تِمؠ خدایہ سنٛزٕ طاقتھ ور بادشٲہی وچُھن!"
\v 2 یسوعؔن تُلؠ شیٛہِ دوٚہؠ پتہٕ پطرسؔ، یعقوبؔ، تہٕ یعقوبؔ سنٛدِ بوے، یوحناؔ، پٲنس سٟتؠ تہٕ نِین أکِس تھدِس بالس پؠٹھ ییٚلہِ تِم تتہِ ٲسؠ صِرِف تِمے ہوٗت، تمِس بدلییٚہِ تِمن برونٛہہ کنہِ شکل۔
\v 3 تٔمی سنٛدؠ پلو سپدٕؠ زرقہٕ برق تہٕ سفید۔ دُنیاہس منٛز ہیٚکہ نہِ کانٛہہ تہِ دھوٗب یتھؠ سفید پلو کرتھ۔
\v 4 زٕ وارایاہ پرٲنؠ نبی موسیٰؔ تہٕ ایلیاہؔ، گےَ تِمن \f + \fr 9‏:4 \ft موسیٰؔ اوس اسرائیل کٮ۪ن لوٗکن ہنٛد اکھ بوٗڈ وتہٕ ہاوکھ تہٕ ایلیاہؔ اوس نبین منٛز اکھ بوٗڈ نبی۔ \f*برونٛہہ کنہِ ظأہر۔ پتہٕ لاجہ تِمو دۅشوے یسوعؔ ہس سٟتؠ کتھٕ کرنہِ۔
\v 5 کمےٕ وقتہٕ پتہٕ ووٚن پطرسنؔ یسوعسؔ، "ربی، ییٚتہِ روٗزن چُھ رُت! ٲسؠ بناؤو ترےٚ پٲرِ۔ اکھ چأنہِ باپتھ، اکھ موسیٰؔ تہٕ اکھ ایلیاہؔ سنٛدِ باپتھ!"
\v 6 تِمؠ ووٚن یہِ تکیازِ سُہ اوس یژھان کیتھام ونُن مگر تٔمؠ ہیوٗک نہٕ ونتھ تہِ، چونکہِ تِم ترشوۓ شٲگرد ٲسؠ واریاہ کھوٗژیمتؠ۔
\v 7 \f + \fr 9‏:7 \ft پطرس 2۔ 1:17، زبُور 2:7۔ \f*پتہ آیہِ اکھ اوبرٕ لانگا تہٕ کوٚرن یِمن پؠٹھ شُہُل۔ امی اوبرٕ منٛزٕ کرٕ خداین ووٚن تِمنِ "یہِ چُھ میٚون گۅبُر، میٚون ٹوٹھ۔ لہٰذا امی سُنٛد بوٗزو!"
\v 8 تِمو شاگردو ترٲو ژوٗواپٲرؠ نظر، اچانک وُچھ تِمو صِرِف یسوعؔ اوس تِمن سٟتؠ تہٕ ایلؔیاہ تہِ موسیٰؔ ٲسؠ نہِ کنی تتہِ۔
\v 9 بالہٕ پؠٹھ بوٗن وسان ووٚن یسوعؔن تِمن زِ توٚہہِ پٔزِ نہِ کانٛسہِ ونُن یُس واقہٕ وُنؠ أمِس سٟتؠ پیش آو۔ تٔمؠ ووٚن، "توٚہہِ ہیکؠو تِمن ؤنِتھ تمہِ پتہٕ ییٚلہِ بہٕ، آدمؔ سُنٛد اولادِ، مَرَنہٕ پتہ دُبارٕ زندٕ گژھٕ۔"
\v 10 تِمو ووٚن نہٕ یہِ کانٛسے واریہس وقتس۔ مگر تِمو کوٚر پانہٕ وٲنؠ بحث زِ امیٚک مطلب کیاہ اوس ییٚلہِ تٔمؠ ووٚن زِ سُہ گژھِ موٚردو منٛزٕ زندٕ۔
\v 11 \f + \fr 9‏:11 \ft ملاکی 4:5۔ 6\f*تِمو ترٛیو شاگردو پرُوژھ یسوعؔ ہس، "یہُودؠ فقیہٕ ہیچناوان وٲلؠ چھِ ونان زِ مسیحؔ ہس برونٛہہ ایلیؔاہن دُنیاہس ین چُھ ضوٚروری، آسہ وُچھ وۅنؠ ایلیاہؔ لہٰذا تِہنٛز تعلیم چھِ غلط؟"
\v 12‏-13 یسوعؔن ووٚن تِمن، "یہِ چُھ پوٚز زِ خداین کوٚر وعدہ ایلیاہؔ گوڈٕ سوزِنکُ ہر کانٛہہ چیٖز سیٚود کرنہٕ خٲطرٕ۔ مگر ایلیاہؔ چُھ برونٛٹھےٕ آمُت، تہٕ پننیٚو سردارو کوٚر تِمن سٟتؠ بُرٕ سلوک، یتھ پٲٹھؠ برٛونٹھے آمتیٚن نبین سٟتؠ کوٚرمُت اوسُکھ۔ پوٚز مقدس کتابن منٛز چُھ مےٚ متعلق واریاہ لیکیتھ، اولادِآدم۔ مقدس کتابہٕ چھِ ونان زِ مےٚ چھِ سیٹھاہ دوٗکھ تُلنؠ تہٕ لوٗکھ کرن مےٚ رد۔"
\v 14 یسوعؔ تہٕ تٔمؠ شٲگرد وٲتؠ تتھ جایہِ یتہِ باقیو شٲگرد ٲس۔ تِمو وُچھ شٲگردن أندؠ أندؠ لوٗکہٕ ارساتہٕ تہٕ کینٛہہ مذہب دار ٲس تِمن سٟتؠ بحث کران۔
\v 15 یسوعؔ وچھتھ گو سُہ لوٗکہٕ ارسات ہےبنُگہٕ۔ تِم لارۓ تمِس کنُ کرکھ سلام۔
\v 16 یسوعؔن پرُوژھ تمن، "توٚہہ کیاہ بحث چُھو کران؟"
\v 17 لوٗکہٕ ارساتہٕ منٛزٕ ووٚن اکی نفرن در جواب، "وۅستادٕ بہٕ چُھس پنُن نیٚچو ہٮ۪تھ ژےٚ نِشہ آمُت تاکہِ ژٕ بلراوہن۔ أمِس منٛز چُھ بد روح یس أمِس کول بناون چُھ۔
\v 18 یُتھے سُہ بد روح أمِس غالب گژھان چُھ یہِ چُھ پتھر یوان لاینہٕ۔ ٲسس چُھس پوٗس کھسان، سُہ چُھ دنٛد ٹکان تہٕ سخت گژھان۔ مےٚ ووٗن چأنؠن شٲگردن زِ تِم کڈن أمِس یہِ بد روح، پوٚز تِمو ہیوٗک نہِ کٔڈتھ۔
\v 19 یسوعؔن دیت تمن جواب یہِ ونان، "بے اعتقادو! تہنٛزٕ بے اعتقٲدی کوٚڑُس بہٕ پریشان! سُہ لڑکہٕ انُن مےٚ نِشہ۔"
\v 20 تِمو أنؠ سُہ لڑکہٕ یسوعؔ ہس نِشہ۔ ییٚلہِ بد روحن یسوعؔ وُچھ تہٕ فورن دِژ بدروحن تمِس لڑکس مٔرنَ سُہ پیوٗو زمیٖنہ پؠٹھ۔ تٔمؠ دِتؠ ڈولہِ گؠنؠ اورٕ یوٗر تہِ ٲسہٕ کنؠِ کھوٚتس پوٚس۔
\v 21 یسوعؔن پرُوژھ لڑکہِ سنٛدِس مألس، "کٲتیاہ وقتہٕ پؠٹھٕ چُھ أمِس یہِ گژھان؟" تٔمؠ دِیُت جواب، "شُرؠ پانہٕ پؠٹھٕ گوٚو أمِس یہِ شروٗع۔
\v 22 یہِ بدروح چُھنہٕ أمِس یی ہوٗت کران، بلکہ أمِس چُھ یہِ اکثر نارس منٛز تراوان بعضے آبس منٛز تہِ والان یُتھ زن سُہ أمِس مارٕ کرِ ہیے۔ ہرگاہ زِ توٚہؠ کینٛہہ ہیکیو کٔرِتھ اسہِ پؠٹھ کرِ تہِ رحم تہٕ اسہِ کرتہِ مدد!"
\v 23 یسوعؔن ووٚنُس تعجب سان، بلکل بہٕ ہیٚکہ کٔرتھ! خدایہ کرِ لوٗکن ہنٛدؠ باپتھ کینٛہہ تہِ یمن اتھ پؠٹھ یقین اسہِ زِ سُہ ہیٚکہ کٔرتھ۔"
\v 24 لڑکہٕ سنٛدؠ مألؠ دژٕ ؤلؠ ؤلؠ کرٔیکھ، "مےٚ چُھ یقین زِ ژٕ ہیککھ مےٚ مدد کٔرتھ۔ مگر مکمل بھروسہٕ چھم نہِ کینٛہہ۔ مےٚ کر مدد مضبوط یقین کٔرنس منٛز!"
\v 25 یسوعؔن وُچھ لوٗکن ہنٛز بٹھ ٲس بڑان۔ تٔمؠ کٔرؠ بدروحس ملامت: ہیوُ بد روح، ژےٚ چُھتھ یہِ لڑکہٕ کول تہِ زٔر بنؤومُت! ژےٚ چُھسے بہٕ حکم دِوان ژٕ نیر أمِس منٛز نیٚبر تہِ أمِس منٛز أژؠ زِ نہٕ زانٛہہ!"
\v 26 تٔمؠ بدروحن دژٕ کریکھ تہِ أمِس لڑکس سخ مٔرنَ دِتھ ترٛوون سُہ ییٚلہِ۔ سُہ لڑکہٕ اوس زن تہِ مودمُت۔ اوے ووٚن اکثر لوٗکو، "سُہ مود!"
\v 27 پوٚز، یسوعؔن تلُ سُہ اتھس تھپھ کٔرتھ تہِ وتھنس منٛز کوٚرنس مدد۔ پتہٕ ووٚتھ سُہ لڑکہٕ تھوٗد۔
\v 28 امے پتہ، ییٚلہِ یسوعؔ تہٕ تسنٛدٕؠ ژاٹھ أکِس گرس منٛز کنی زٔنؠ ٲس، تِمو پرُوژھ تمِس، "اسہِ کیازِ ہیوٗک نہِ أمِس سُہ بد روح نیٚبر کٔڈتھ؟"
\v 29 یسوعؔن ووٚن تِمن، "توٚہؠ ہیکوکھ نہٕ یمہِ قسمکہ بد روح صرف غذا نہٕ کھؠنہِ تہٕ خدایس دُعا منٛگنہٕ سٟتؠ نیٚبر کٔڈتھ کینٛہہ۔ اتہِ چھِنہٕ بیٚہِ کانٛہہ وتھ یِم نیٚبر کٔڈٕنچ۔"
\v 30 سُہ علاقہٕ ترٛاؤنہٕ پتہ کوٚر یسوعؔن تہِ تسٕنٛدیو شاگردو گلیل کہ علاقہٕ منٛزٕ سفر۔ یسوعؔ اوس نہٕ یژھان کانٛہہ گژھِ زانن سُہ کٔتہِ اوس۔
\v 31 یسوعؔ اوس یژھان تمِس گژھِ پننؠ شٲگرد ہیٚچھناونُک وقت ٲسن۔ سُہ اوس تِمن ونان، "کنہِ دوٚہہ کرن میأنؠ دشمن مےٚ گرفتار، آدمؔ سٕنٛدِس اولادس، تہٕ بہٕ یمہٕ یمن نفرن ہنٛدؠن اتھن منٛز دِنہٕ۔ تم نفر مارن مےٚ۔ مگرمیأنہ مرَنہٕ پتہٕ ترٛیمہِ دوٚہہ گژھٕ بہٕ دُبارٕ زندٕ!"
\v 32 شٲگردن توٚر نہٕ فِکرے زِ یسوعؔ کیاہ اوس تِمن ونان، تٔم کھوژ تمِس امیٚک مطلب پرٛژھنس۔
\v 33 پتہ آیہِ یسوعؔ تہٕ تسنٛدٕؠ شٲگرد کفرنحوم شہرس منٛز واپس۔ ییٚلہِ تٔم گرس منٛز ٲس، یسوعؔن پرُوژھ تِمن، "توٚہؠ کیاہ کتھ ٲسوٕ وتہِ پکان پکان کران؟"
\v 34 مگر شاگردو دِیت نہٕ جواب۔ تٔم گےَ شرمنٛدٕ جواب دینس منٛز تکیازِ، سفرس دوران ٲس تٔم أکِس اکھ سٟتؠ اتھ متعلق بحث کران زِ تِمن منٛز کسُ اکھ اوس زیادٕ اہم۔
\v 35 یسوعؔ بیوٗٹھ پتھر۔ تٔمؠ بُلایہِ پننؠ بہوے شٲگرد پأنس نٔکھٕ، تہٕ پتہٕ ونُن تِمن، "اگر کانٛہہ خدایس سٲرِوی منٛزٕ ٹوٹھ چُھ یژھان بنَن، تمِس پٔزِ پننِس پٲنس ساروی کھۅتہٕ کمتر مانن، تہٕ تمِس پٔزِ ہرَ کٲنٛسہِ خدمت کرٕنؠ۔"
\v 36 پتہ تلُ یسوعؔن اکھ شُر تہٕ تھوون تِمن منٛزس۔ تٔمؠ تلُ سُہ شُر کھوٗنہ، تہٕ پتہٕ وننکھ،
\v 37 "تم یِم أکِس شُرس یمِس اکؠ سنٛدؠ پٲٹھؠ قبول کران چھِ تکیازِ تٔم چھِ مےٚ محبت کران، خدا چُھ مانان تٔم چھِ مےٚ قبول کران۔ یُس کانٛہہ مےٚ قبول کرِ، زنتہِ چھِ تِم ببَ خدایس قبول کران، یِمؠ بہٕ پنُن نمایندٕ منتخب کوٚڑُس۔"
\v 38 یوحناہنؔ ووٚن یسوعؔ ہس، "ووٗستاد، آسہ وُچھ اکھا بدروحن لوٗکن منٛزٕ نیٚبر کڈان۔ سُہ چُھ دعوا کران زِ تمِس چُھ بدروح نیٚبر کڈنس سُہ اختیار۔ اسہِ کوٚر تمِس منع، تکیازِ سُہ اوس نہِ سأنیو شاگردو منٛزٕ اکھ۔"
\v 39 یسوعؔن ووٚن، "تمِس مہَ ووٚن زِ ژٕ مٕہ کر تہِ۔ یتہِ چُھ نہٕ کانٛہہ تہٕ نفر سُہ یس میأنہِ اختیار سٟتؠ کانٛہہ معجزٕ ہیٚو کٔرتھ مےٚ پتہٕ بُرٕ ونہِ۔
\v 40 تِم لوٗکھ یِم نہٕ اسہِ مُخالفت کران چھِ تِمن تہِ چُھ سوٗی مقصد یُس اسہِ چُھ۔
\v 41 خدا دِیہ تمن پٔزٕ پٲٹھؠ انعام یِم توٚہہِ کنہِ تہِ رنگٔہٕ مدد کرنؤ، ہرگاہ سُہ اکھ آبہٕ پیالہٕ توٚہہِ چنہٕ خٲطرٕ ٲسہ تکیازِ توٚہہِ چُھو مسیحؔ ہس پتہٕ پتہٕ پکان!"
\v 42 یسوعؔن ووٚن یتہِ، "پوٚز اگر توٚہہِ کانٛہہ نفر یمِس مےٚ پؠٹھ یقین آسہ، کرناوین گناہ خدایہِ دِیو توٚہہِ سخ سزا۔ اگر توٚہہ کانٛہہ گۅب کٔنؠ نٲلؠ ژٕھنتھ تہٕ سمندرس بُزؠ کرِ، سُہ چُھ تُہنٛدِ خٲطرٕ جان تمہِ کھوٗتہٕ اگر خداین توٚہہِ امہ خٲطرٕ سزا دیتو زِ توٚہؠ چُھ کانٛہہ مےٚ پؠٹھ یقین کٔرن وول گناہ کرنؤومُت۔
\v 43 اگر توٚہؠ پنن اکھ اتھٕ گۅناہ کرنہِ خٲطرٕ استعمال یژھان چُھو کرُن، یہِ مٕہ کٔریو استعمال! ہرَگاہ توٚہہ پٔننؠ اتھٕ تہِ پین شٲگردن تہٕ ژھنؠ ہُن تراوِتھ گناہن نِشہ بچنہٕ خٲطرٕ، تہِ کریو! یہِ چُھ رُت تمہِ نِشہ اگر اکہ اتھٕ ورٲے توٚہؠ دُنیاہس منٛز ہمیشہ زندٕ روزیٚو۔ پوٚز یہِ چُھنہٕ رُت زِ توٚہؠ کریو گۅناہ تہٕ خدایہ ترٛاؤو تٔہنٛدس سٲرسےٕ جسمس جہنم کس نارس منٛز۔ تتہِ، سُہ نٲر یُس نہٕ ژھٕؠتہٕ گژھن وول چُھ!
\v 44 یہِ چھِ سۅ جایہ یٚتہِ تِمن پؠٹھٕ پلن وول کیوٗم رُکہِ نہٕ زانٛہہ، تہٕ سُہ نٲر یُس دزان چُھ گژھنہٕ ژھؠتٕہٕ زانٛہہ۔
\v 45 اگر توٚہؠ یژھان چُھو پنن اکھ کھۅر گناہ کٔرنہِ خٲطرٕ ورتاون، پنن کھۅر رُکایو! اگر توٚہیہ پنن کھوٗر گۅناہ ٹالُنہٕ خٲطرٕ ہرَگاہ ژاٹن تہٕ پییٚہِ، یہِ کریو! گۅناہ نہٕ کرنہِ خٲطرٕ چُھ بہتر اگر توٚہہِ کھۅرٕ بغیرؠ دُنیاہس منٛز ہمیشہ زندٕ روزیو۔ پوٚز یہِ چُھ رُت زِ گۅناہ کرنکہ وجہِ ترٛاوُی خدا تُہنٛدؠ سورے جسم جہنمس منٛز
\v 46 ییٚتہِ نہٕ تمن پؠٹھ پلن وول کیوٗم زانٛہہ تہِ رُوٗکہ سُہ نٲر یُس دزان چُھ گژھنہٕ زانٛہہ تہِ ژھؠتہٕ۔
\v 47 اگر توٚہہِ کانٛہہ چیٖز گناہ کرنہٕ خٲطرٕ کشش کرِ، مو سہ وچھو تتھ کنُ! اگرچہ پننؠ أچھ تہِ پینیؤ نیٚبر کڈنہ تہِ گناہ ٹالنہ خٲطرٕ کڈؠ ہوٗک! یہِ چُھ بہتر خدایہ سٕنٛدِس سلطنتس منٛز روزنہٕ خٲطرٕ، پتہٕ زٕ أچھ ہٮ۪تھ تراؤو توٚہہِ خدا جہنمس منٛز۔
\v 48 \f + \fr 9‏:48 \ft یسعیاہؔ 66:24\f*تتھ جاۓ ییٚتہِ ہمیشہ کیمؠ لوٗکن پؠٹھے پلن چھِ، تہٕ سُہ نٲر گژھنہٕ ژھؠٕتہٕ زانٛہہ۔
\v 49 \f + \fr 9‏:49 \ft احبار 2:13۔ \f*توٚہہِ پزنیو مشکلات برداش کٔرنَؠ تاکہِ خدایہ روزِ توٚہہِ خوش۔ تہنٛدؠ چھِ نٲرک پٲٹھؠ یس چیٖزن پاک چُھ کران۔ تُہنٛدؠ صبر چُھ تِمن لوٗکن ہنٛدؠ پٲٹھؠ یمہٕ پننؠن قربانؠن پؠٹھ نون پاک کٔرنہٕ خٲظرٕ چھکان چھِ۔
\v 50 نون چُھ غذاہس پؠٹھ ترٛاون فایدٕمند، پوٚز توٚہؠ ہیکؠو نہٕ اتھ دُبارِ نونک مزٕ بنٲوِتھ کینٛہہ اگر یہِ بے مزٕ گوٗمت ٲسہ۔ تِیتٕھے پٲٹھؠ، پٔزٕ توٚہہ خدایس فایدٕمند روزن، تکیازِ اگر توٚہؠ بےکار ٲسیٚو پتہٕ کیتھٕ پٲٹھؠ بنو توٚہؠ خدایس فایدٕمند۔ توٚہہ پٔزِ أکِس اکھ سٟتؠ امنہٕ سان زندٕ روزن۔
\c 10
\p
\v 1 یسوعؔن ترٛاؤو سۅ جایہ پننؠ شٲگرد ہٮ۪تھ، تہٕ تِم درایہِ یہُودیہ علاقہٕ مٔنٛزؠ تہٕ دریایہِ یردنکہِ مشرقہٕ طرفہٕ پؠٹھؠ تریتھ۔ ییٚلہِ بیٚیہِ گوٚو لوٗکہٕ ارساتھا تمِس انٛدؠ انٛدؠ جمع، تٔمؠ دِژٕ تِمن حسبہِ روایت دُبارِ تعلیم۔
\v 2 ییٚلہِ یسوعؔ تعلیم دِوان اوس کینٛہہ فریسی وٲتؠ تمِس نِشہ تہِ پرُوژھس، "کیاہ سون شریعت چھا أکِس مرٕدس پننہ زنانہِ طلاق دِنُک اجازت دِوان؟" تِمو پرُوژھ تہِ تمِس ہزل کرنہٕ خٲطرٕ تِمن اوس نہٕ غرض سُہ دییہِ ہے جواب "اوۓ" یا "نا۔"
\v 3 یسوعؔن دیت تِمن جواب، "موسیٰؔ ہن کیاہ کوٚر تہنٛدؠن جدن حکم أکِس مرٕدس پننؠ زنانہِ طلاق دِنس متعلق؟"
\v 4 \f + \fr 10‏:4 \ft تثنِیہ شرع 24:1۔ 3\f*تِمو منٛزٕ دیُت اکؠ جواب، "موسیٰؔ ہن دیُت اجازت زِ اکھ مرد ہیٚکہ طلاق کاغذس پؠٹھ لیکتھ تاکہِ سُہ ہیٚکہ تمِس زنانہِ نیٚبر کڈتھ۔"
\v 5 یسوعؔن دِیُت تِمن جواب، "سُہ اوس تِہنٛد بُتھؠ پھیٚور رٔویہِ زِ موسیٰؔ ہن دِیُت تِہنٛدِ خٲطرٕ سُہ اصول۔
\v 6 \f + \fr 10‏:6 \ft پیدٲیش 1:27، 5:2\f* یاد تھؤو زِ ییٚلہِ خداین لوٗکھ گۅڈٕ پٲدٕ کٔرؠ، تٔمؠ بنوو اکھ مرد، تہٕ اکھ زٔنؠ مردٕ سنٛزٕ آشِنؠ۔
\v 7 تہِ چُھ واضیح کران خداین کیازِ ووٚن، "ییٚلہِ اکھ مرد تہٕ زٔنؠ خأندر چھِ کران، تِمن پزِنہٕ خاندرٕ پتہٕ پننؠن مالؠن تہٕ ماجؠن سٟتؠ روزن۔
\v 8 \f + \fr 10‏:8 \ft پیدٲیش 2:24\f* امہ بجایہ، تٔمؠ زٕ روزن یکجاہ، تہٕ تٔمؠ روزن تیوت نزدیک زِ زن آسن اکے نفر۔ ہرگاہ، اگرچہ تم نفر خاندرٕ برونٛہہ زٕ الگ الگ نفر ٲسؠ، خدایہ چُھ خاندرٕ پتہٕ یِمن اکےمانان اوے چُھ سُہ یژھان تٔمؠ گٔژھن أکِس اکھ خوش تھاون۔
\v 9 تکیازِ تہِ چُھ پوٚز، أکِس مردس پٔزِ نہٕ پننؠ زنانہِ کھُلا دِنؠ۔ خداین رلاؤی تم، تہٕ سُہ چُھ یژھان تٔمؠ روزن یکجاہ۔
\v 10 ییٚلہِ یسوعؔ تہٕ تسنٛدؠ شٲگرد أکِس گرس منٛز تنہاہ ٲسؠ، تِمو ووٚن تمِس اتھ متعلق دُبأرِ۔
\v 11 یسوعؔن ووٚن تِمن، "خدایہ چُھ مانان زِ اگر کانٛہہ مرد پننہِ زنانہِ کھلا دییہِ تہٕ بؠس زنانہِ سٟتؠ خاندر کرِ سُہ چُھ زِنَا کران۔
\v 12 خدایہ چُھ أکِس زنانہِ تہِ زِنَا کٔرِنچ مجرم مانان اگر سۅ پننس مردس کھلا دییہِ تہٕ بیس مردس سٟتؠ کٔرؠ خاندر۔"
\v 13 وُنؠ ٲسؠ لوٗکھ شُرؠن یسوعسؔ نِشہ اتھٕ ڈالنہٕ خٲطرٕ انان تاکہِ تِمن سپدِ شفأ۔ پوٚز تسنٛدیو شاگردو کٔر تِمن نس۔
\v 14 ییٚلہِ یسوعؔن تہِ وُچھ، تمِس کٔھژ شرارت۔ تٔمؠ ووٚن پننؠن شٲگردن، "شُرؠن دیو مےٚ نِشہ ینہٕ! تِمن مہُ کرو منع! یِمؠ چھِ حلیم لوٗکھ تہٕ خدایس پؠٹھ چُھکھ یقین تکیازِ خدایی بادشٲہی چھےٚ یہنٛزٕے۔
\v 15 لیکتھ تھَٲیو: یُس اکھٛا خدایی بادشٲہی شُرؠن ہنٛدؠ پٲٹھؠ مانہِ نہٕ سُہ ییہِ نہٕ یقیناً خدایہ سٕنٛدِس تتھ سلطنتس منٛزٕ ترٛاونہٕ یتھ سُہ بادشٲہی کران چُھ۔"
\v 16 پتہٕ تھوو یسوعؔن  یِمن بچن پیٚٹھ  اتھ۔ تمِس ڈولن پنن اتھٕ تہٕ خدایس مونٛگُن تہنٛدِ خٲطرٕ رٔژر۔
\v 17 یسوعؔ اوس پنہٕ نؠن شٲگردن سان دُبارٕ سفرس نیرنس تیار، اکھ نفر آو تس نِشہ دوران۔ سُہ جُکیٚو یسوعؔ ہس برونٛہہ کٔنہِ تہٕ پرُوژھنس، "نیک ووٗستادٕ، مےٚ کیاہ پٔزِ کرُن یُتھ زنَ مےٚ ابدی زندگی حاصل گژھؠ؟"
\v 18 یسوعؔن ووٚن تمِس، "ژےٚ چھِےُ نہِ احساس زِ ژٕ چُھکھ مےٚ رُت ونان! صرف خدایہ چُھ رُت!
\v 19 \f + \fr 10‏:19 \ft خروج 20:12۔ 16، رومین 13:19\f* پتہٕ گوٚو چٲنہِ سوالک جواب ژٕ چُھکھ موسیٰؔ سنٛدیو حکمو نِشہ وٲقف: مہَ کرنُ کانٛہہ قتل، مہَ کرِ زنا، ژوٗر مہٕ کریو، اپُز مہَ ون کُنہِ چیٖزس متعلق، کانٛسہِ مَہ دِیہ دوٛکھٕ، تہٕ پننؠس مٲلس ماجہِ کرِ یزتھ۔"
\v 20 تٔمؠ نفرن ووٚن تس، "ووٗستادٕ لوکچارٕ پٹؠھٕ چُھس بہٕ یِمن حکمن پؠٹھ عمل کران۔"
\v 21 یسوعؔن کٔر تس شفقتہٕ سان نظر۔ تس ون، "اکہ چیٖزچ چھیے ژےٚ کٔمی۔ گرٕ گژھِ، یہِ کینٛژھا ژےٚ چھے تہِ ژھن کنٛتھ تہٕ بٲگراو غریب لوٗکن منٛز۔ امی سٟتؠ میلنے آسمٲنی خزانہٕ۔ یہِ مےٚ وۅنےٕ تہِ کرنہٕ پتہٕ یہِ مےٚ سٟتؠ تہٕ روز میون شٲگرد!"
\v 22 یسوعؔ سنٛدِ ہدایات بوزِتھ گییہِ تمِس نفرس پراکٔندی۔ بڈٕ مایوس گژھِتھ دراو، تکیازِ سُہ اوس سٮ۪ٹھاہ امیر۔
\v 23 یسوعؔن ترٲو انٛدؠ انٛدؠ لوٗکن پؠٹھ نظر۔ پتہٕ ووٚننُ پننٮ۪ن شٲگردن کریکھ دِتھ، "خدٲیی بادشٲہی منٛز امیرن ہُنٛد اژُن چُھ سٮ۪ٹھاہ مشکل۔"
\v 24 شٲگرد گےَ تہِ بوزِتھ حٲران یہِ یسوعؔن ووٚن، تِمو سونچ زِ خدایہ چُھ امیر لوٗکن مَدد کران، اوے اگر نےَ خدایہ تِمن بچٲوِ، سُہ بچٲوِ نہٕ کانٛسہِ۔ یسوعؔن ووٚن دُبارٕ، "توٚہؠ میانؠو ٹاٹھو پژھ تھاون والیو یمن بہٕ رٲچھ چُھس، یہِ فأصلہِ کٔرن چُھ سیٹھاہ کریوٗٹھ کانٛسہِ تہِ زِ خدا کٔرؠ تنٛزٕ زندگی پؠٹھ حکومت۔
\v 25 یہِ چُھ ناممکن اکھ بٔوٗڈ اونٛٹس ہیوٗ جانور سٕژنہٕ پہیہ منٛزٕ اژن۔ یہِ چُھ الہٕ پلہٕ تُیتٕھۓ کریوٗٹھ امیرن ہنٛدؠ خٲطرٕ زِ تٔمؠ اژن خدایہِ سنٛزٕ بادشٲہی منٛز۔"
\v 26 شٲگردن اوس سیٹھاہ تٲجِب گوٗمت۔ اوے ووٚن تِمو یسوعؔ ہس، "اگر تہِ یہِ چُھ، پتہٕ کسَ ہؠکہِ نجات میلِتھ!"
\v 27 \f + \fr 10‏:27 \ft ایوب 42: 2، لوقا 1:37 \f* یسوعؔن کرِ تِمن نظر، تہٕ پتہ ووٚن تٔمؠ، "اُوے، یہِ چُھ انسانن نِشہ ناممکن پان بچاوُن! پوٚز خدایہ ہیٚکہ تِمن بچٲوتھ، تکیازِ خدایہ ہیٚکہ کینٛہہ تہِ کٔرتھ!"
\v 28 پطرسنؔ ووٚن، "وُچِھو، اسہ ترٛوو سورےٕ کنٛہہ، تہٕ ٲسؠ چٲنؠ شٲگرد درٛایہِ ژےٕ پتھ۔"
\v 29 یسوعؔن دتس جواب، "بہٕ چُھس یژھان یہِ زانن: یمو پنن گرٕ، بأییٔ، بیٚنہِ، مول، موج، شُرؠ، زمیٖن میون شٲگرد بنہٕ نہٕ خٲطرٕ تہٕ رژٕ شیٚچھ ہُنٛد اعلان کرنہٕ خٲطرٕ ترٛوو،
\v 30 تِمن میٖلہِ تمیک ہتہٕ گٔنہٕ یہِ تِمو پتھ کنُ ترٛوو۔ تتھ منٛزِ چھِ یوان گرٕ تہٕ خاندانکہ بٔٲژٕ: بٲے تہِ بیٚنہِ تہِ موج تہِ شُرؠ، تہٕ زمیٖن۔ بیٚیہِ، لوٗکھ دِنکھ تکلیف یتھ دُنیاہس منٛز تکیازِ تِمن چُھ مےٚ پؠٹھ یقین پوٚز برونٛہہ کنُ آسہ تِمن ابدی زندگی خدایس سٟتؠ گُزارنؠ۔
\v 31 واریاہ لوٗکھ یمن باقیو لوٗکھ اہم آسن تصور کران مگر خدایس نِش آسن نہِ اہم، واریاہ لوٗکھ یمؠ باقین نِش اہم آسن نہٕ مگر خدایس نِش آسن واریاہ اِہم!"
\v 32 کینٛژو دوٚہو پتہٕ تہِ روٗدِؠ تٔمؠ سفر کران، یسوعؔ تہٕ تٔمؠ سٕنٛدؠ شٲگرد ٲسؠ تتھ واتہِ پؠٹھ پکان یۅسہ یروشلم شہرس کنُ گژھان ٲس۔ یسوعؔ اوس تِمن برونٛہہ برونٛہہ پکان۔ شٲگرد گےَ حٲران تہِ تِمن سٟتؠ باقیو لوٗکھ کھوژؠ۔ وتہِ منٛزٕ نیہ یسوعؔن تم باہوے ژاٹھ پانس سٟتؠ دُبارِ أکِس مقامس پؠٹھ۔ پتہٕ لوٗگ سُہ تِمن وننہِ زِ مےٚ پؠٹھ کیاہ کیاہ چُھ سپدن وول۔
\v 33 تٔمؠ ووٚن، "ہوشہِ سان بوزیٚو! ٲس چھِ یروشلم گٔژھان۔ میٖرِ کاہن تہِ یہُودؠ فقِیہکچ تعلیم دنہِ وٲلؠ کرُن مےٚ گرفتار، آدمؔ سنٛدِس نیٚچوِس۔ تِم دِن مےٚ موتُک سزا۔ پتہٕ واتہٕ ناون مےٚ رومہٕ کؠن حٲکمن نِشہ۔
\v 34 تہنٛدؠ نفر کرن مےٚ ٹھٹھٕ تہٕ لاین تھوکہٕ، تٔم والن مےٚ تہٕ پتہٕ کرنم قتل۔ پوٚز تمہِ پتہٕ ترٛییہٚ دوٚہؠ سپدٕ بہٕ دُبارٕ زندٕ!"
\v 35 زبیدیؔ سنٛدؠ نیٚچوؠ یعقوبؔ تہِ یوحناؔ، آیہِ یسوعؔ ہس نِش تہِ تمِس ونُکھ، "ووٗستاد، أسؠ چھِ یژھان یہِ کینٛژھا ٲسؠ ژےٕ منٛگووے ژٕ کرکھ سانہِ باپتھ!"
\v 36 یسوعؔن ووٚن تِمن، "توٚہؠ کیاہ چُھو یژھان زِ بہٕ کرٕ تُہنٛدِ باپتھ؟"
\v 37 تِمو ووٚن تمِس، "ٲسؠ چھِ یژھان زِ ٲسؠ بیہمو چٲنس جلالس منٛز اکھ دٔچُھن تہٕ بیٛاکھ کھوٕورؠ کنِؠ۔"
\v 38 پوٚز یسوعؔن ووٚن تِمن، "توٚہہ چُھو نہٕ پےَ زِ توٚہؠ کیاہ چُھو منٛگان۔ "پتہٕ پرُوژھن تِمن "یُس پیالہٕ بہٕ چؠوان چُھس توٚہؠ ہیکوا سُہ چؠتھ؟ یُس بپتسمہ بہٕ نمہٕ توٚہؠ ہیکوا سُہ نِتھ؟"
\v 39 تِمو ووٚن تسَ، "اُوے، ٲسؠ ہؠکو تہِ کرتھ! "پتہٕ ووٚن یسوعؔن تِمن، "یہِ چُھ پوٚز زِ توٚہؠ کرُو برداش یتھ پٲٹھؠ بہٕ کرٕ، توٚہؠ تہِ نیو بپتسمہ یتھٕ پٲٹھؠ بہٕ نمہٕ۔
\v 40 پوٚز یہِ چُھنہٕ مےٚ تأم ژارن کسُ کٔمہِ انٛدٕ بہیہ مےٚ۔ خدایہ دییہِ تِمن سُہ مقام یمِس سُہ برونٛہہ ژارِ۔"
\v 41 پتہٕ بوز باقیو دہیو شاگردو تتھ متعلق یہِ یعقوبؔ تہٕ یوحناؔہن عرض کوٚڑمُت اوس۔ اوے، تِم گےَ تِمن پؠٹھ ناراض۔
\v 42 پتہٕ أنؠ یسوعؔن تِم سٲریِ پانس نِش ناد دِتھ، تہٕ ووٚنٛنکھ، "توٚہؠ چُھو زانان زِ یمؠ غٲر یہُودینؔ پؠٹھ سرداری کران چھِ تِم چھِ ہاوان زِ ٲسؠ چھِ طاقتور۔ بیٚیہِ چُھو زانان زِ تہنٛدؠ عہدٕ دار چھِ باقیو پؠٹھ حکم چلاؤنکھ اختیار تھاوان۔
\v 43 پوٚز تِمن ہیؤ مہٕ بنو! اتھ برعکس، اگر توٚہیہ منٛزٕ کانٛہہ عظمت حٲصل یژھان چُھ کٔرن، تمِس پٔزِ پنن پان لوٗکن ہُنٛد خدمت گار تصور کٔرن۔
\v 44 تہٕ، اگر توٚہہِ منٛزٕ کانٛہہ یہِ یژھان چُھ زِ خدایہ گژھِ تمِس سیٹھاہ اہم تصور کرن، تمِس پزِ سارنے ہنُد غلام بنن۔
\v 45 بہٕ تہِ، آدمؔ سُنٛد گۅبُر، آس نہٕ پانس خدمت کرناونہِ بٔلکہ خدمت کرنہ تہٕ پنن پان لوٗکن ہنٛدؠن گناہن بدٕلہِ قربان کرُن، خداین یُس سزا گناہگارن ہندِ خٲطرٕ مقرر کوٚڑمُت چُھ تمہِ نِش تِہنٛدِ خٲطرٕ آزٲدی مٔلؠ ہینؠ۔"
\v 46 یروشلم شہرس کنُ گژھان یسوعؔ تہِ تسٕندؠ شٲگرد وٲتؠ یرِیحُو شہرس منٛز۔ پتہٕ، ییٚلہِ تِم یرِیحُو پؠٹھٕ بٔڈس لوٗکہٕ ارساتھ ہٮ۪تھ نیران ٲسؠ، اکھ بیٚچھٕ وُن اُوٗن اوس وتہِ دنٛدس پؠٹھ بہتھ۔ تٔمؠ سنٛدِ ناو اوس برتِمؔاییٔ، تہٕ تُہنٛدس مالٔؠ سنٛدِ ناو اوس توتماییؔ۔
\v 47 ییٚلہِ تِمؠ لوٗکن نِش بوز زِ یسوعؔ ناصری چُھ پکان، تٔمؠ دِژ کریکھ، "یسوعؔ! ژٕ چُھکھ بادشاہ داوود سنٛزِ ذٲژ منٛز، مےٚ کر مدتھ!"
\v 48 واریہو لوٗکو کٔر تمِس نس زِ سُہ روزِ ژھوٗپہٕ کرتھ۔ امہ بجایہ دِژٕ تٔمؠ زیادے زورٕ کریکھٕ، "ژٕ چُھکھ بادشاہ داوود سنٛزِ ذٲژ منٛزٕ، مےٚ پؠٹھ کٔر رحم!"
\v 49 یسوعؔ ٹھہریو تہٕ وٚونن، "أمِس کٔریو آلو یوٗر یہِ! "تِمو کوٚر ٲنس نفرس آلو، "یسوعؔ چھِۓ ژےٚ ناد دوان! خوش گژھتھ تہِ ووٚتھ تھود تہٕ یی!"
\v 50 تٔمؠ ترٲوؠ پننؠ پلو أکِس اندس کنُ تٔم تجِن ووٚٹھ، تہٕ ووت یسوعؔ ہس نِش۔
\v 51 یسوعؔن پرُوژھ تسَ، "ژٕ کیاہ چُھکھ یژھان یہِ بہٕ چانہِ باپتھ کرٕ تٔمؠ أنؠ ووٚن تسَ، "ووٗستاد، بہٕ چُھس یژھان دُبارِ گاشدار سپدن!"
\v 52 یسوعؔن ووٚن تسَ، "ژٕ اُونتھ مےٚ پؠٹھ ایمان، مےٚ کوٚڑے ژےٚ شفأ! تمِس آو سٟتی گاش۔ تہٕ سُہ درٛاو یسوعسؔ پتہٕ پتہٕ۔
\c 11
\p
\v 1 ییٚلہِ یسوعؔ تہٕ تٔمؠ سٕنٛدؠ شٲگرد یروشلم نزدیک زیتون بالسَ نکھٕ، بیت فگےؔ تہٕ بیت عنیاہ گامن نِشہ وٲتؠ۔ پتہٕ سوٗزؠ یسوعؔن پننیٚو شاگردو منٛزٕ زٕ شٲگرد تِمن برونٹھ۔
\v 2 یسوعؔن ووٚن تِمن، "یُس گام بلکل اسہِ برونٛہہ پٕہن چُھ توٚت گٔژھؤ۔ یتھیے توٚہؠ توٚت وٲتیٚو، توٚہیہ گژھِ تتہِ اکھ خٔرنیہِ بچہ گٔنڈتھ نظرِ۔ یہِ چُھ سُہ جانور یمِس نہٕ ونیُک تام کٲنٛسہِ سوٲرؠ آسہ کٔرمٕژ۔ سُہ مُژراوہن تہٕ انیوٗن مےٚ نِشہ۔
\v 3 ہرگاہ تۅہیہِ کانٛہہ پرٕژھِ، "توٚہؠ کیاہ چُھو یہِ کران؟ ونُن گژھِکھ، "یسوعؔ ہس چُھ یہِ ضوٗرورتھ۔ سُہ سوزِ تسَ کانٛسہِ أتھؠ ضوٗرورتھ مُکاونہٕ پتہٕ جلدٕی واپس۔"
\v 4 تٔوۓ گےَ زٕ شٲگرد، تہٕ تِمو وچُھو سُہ خرَ۔ سُہ اوس أکِس گرٕ کس دروازس نکھٕ کوچس منٛز کھڑا گنڈتھ۔ تِمو مُژرو سُہ۔
\v 5 تتہِ یِم کینٛہہ لوٗکھ ٲسؠ تِمو پرُوژھ یسوعؔ سنٛدین شٲگردن، توٚہؠ کیازِ چُھو خرَ کھولان؟"
\v 6 تِمو ووٚن تِمن تی یہِ یسوعؔن تِمن حکم کوٚڑمُت اوس۔ لوٗکو دِیت تِمن خرَ ننُک اِجازتھ۔
\v 7 تِم زٕ شٲگرد آیہِ سُہ خرَ ہٮ۪تھ یسوعسؔ نِش تہٕ پننؠ پلو ترٲوکھ أمِس پؠٹھ تہٕ یسوعؔ کھوٚت أمِس خرس سوارِ۔
\v 8 واریہو لوٗکو ترٲوؠ پننؠ پلو وتہِ منٛز أمِس برٛونٹھٕ کنہِ۔ بیٚیو انہِ نکھٕ کھہَو منٛزٕ کٔھزر کٔلؠو پؠٹھٕ لنجہِ ژٔٹتھ تہٕ تِمہٕ پھٲلاوکھ وتہِ سٟتؠ سٟتؠ۔
\v 9 \f + \fr 11‏:9 \ft زبُور 118:25۔ 26، "خدا کرِن بادشاہس حفاظت"\f*تمِس برونٛہہ برونٛہہ تہٕ پتہٕ پتہٕ پکان وٲلؠ لوٗکھ ٲسؠ کریکٕہ دِوان، "خدایہ سنٛدؠ حمد! تہٕ \f + \fr 11‏:9 \ft اسہِ بَچاو! خدایس کُن اکہِ دُعاکس صورتس منٛز۔ \f* "خدایہ کرن أمِس رُت یُس خدایہ سُنٛد رسول بنتھ آو۔"
\v 10 \f + \fr 11‏:10 \ft متی 23:39\f* تِمو دِژٕ یمہٕ تہِ کریکٕہ، خداۓ کر نے رُت ییٚلہِ ژٕ بادشٲہی کرکھ یتھٕ پٲٹھؠ سانین جدن بادشاہ داوودنؔ بادشٲہی کرٕ! "تعریف تمِس خدایس یُس ساروٕے کھوٗتہٕ تھدس آسمانس منٛز چُھ"
\v 11 ییٚلہِ یسوع یروشلم شہرس منٛز ژاو تِم ہٮ۪تھ، تہٕ پتہ ژٲؤ سُہ ہیکل کس صحنس منٛز۔ تتہِ ژوٗواپٲرؠ تمام چیٖزن پؠٹھ نظراہ ترٲوتھ، دراؤ تمہِ شہرِ منٛز تکیازِ وُنؠ اوس شام ژیر گوٗمت۔ سُہ گوٚو پننیٚن بہن شٲگردن سٟتؠ بیت عنیاہ گامس منٛز واپس۔
\v 12 دوٗیمہِ دوٚہہ، ییٚلہِ یسوعؔ تہٕ تمسنٛدؠ شٲگرد بیت عنیاہ پٮ۪ٹھٕ نیران ٲسؠ، تمِس لٔج بۅچھِ۔
\v 13 تٔمؠ وُچھ دورِ پہن اکھ سرسبز اُنجیٖرٕ کُل، سُہ گوٚو وچھنہ زِ اتھ پؠٹھ ما آسن کینٛہہ انجیر۔ مگر ییٚلہِ سُہ ووت اتھ نِشہ، تتھ اوس نہٕ کانٛہہ میٚوہ، تھتھ ٲسؠ صرف پنہٕ ؤتھر۔ امیٚک وجہ اوس یہِ زِ انجیر موسم اوس نہِ ییٚلہِ انجیر کُلؠن انجیر لگہ ہن۔
\v 14 تٔمؠ ووٚن تتھ کُلس، "کانٛہہ مَہ کھیٚنؠ زانٛہہ تہِ چون پھل دُبارِ۔ "تہٕ تہندیو شاگردو بوز یہِ۔
\v 15 یسوعؔ تہٕ تٔمؠ سنٛدؠ شٲگرد گییہِ واپس یروشلم تہٕ ژٲیہِ ہیکل کس صحنس منٛز۔ تٔمؠ وُچھ لوٗکھ قربان جانورن ہنٛدِ تجارت کران۔ تٔمؠ کٔر تِمن لوٗکن ہیکلکہِ صحنہٕ منٛزٕ لار۔ بیٚیہِ کوٚر تٔمؠ صرافن ہنٛدؠن تختن ڈبہٕ ڈاس تِم ٲسؠ ہیکل لک سِکہٕ رومی سِکن سٟتؠ بدلاوان۔ تہٕ تِمن لوٗکن ہنٛزن چوکؠن کوٚرن ڈبہٕ ڈاس یم کوتُر قربانی خٲطرٕ کٕننان ٲسؠ۔
\v 16 تٔمؠ دیت نہٕ کانٛسہِ أکِس تہِ ہیکلہٕ کہ صحنہِ منٛزٕ کٕننہٕ خٲطرٕ کانٛہہ تہِ چیٖز ہٮ۪تھ نیرنُک اجازت۔
\v 17 \f + \fr 11‏:17 \ft یسعیاہؔ 56:7، یرمیاہ 7:11، لوقا 19:46۔ \f* پتہٕ دِژٕ تٔمؠ تِمن لوٗکن تعلیم، تٔمؠ ووٚن تِمن، "نبیو منٛزٕ چھِ اکہ نبین پاک کلامس منٛز لیٚوکھمُت زِ خداین ووٚن، "میون گرٕ ییہِ سارنےٕ قومن ہندِ دُعا باپتھ گٔنزراونہٕ۔ "پوٚز توٚہہ بنوؤ ییہِ ڈاکوٗن ہنٛز چھپَن جاۓ۔"
\v 18 ییٚلہِ میٖرِ کاہنن تہٕ یہُودؠ فقیہٕ ہیٚچھناون والیٚو پتہٕ بوز یسوعؔن کیاہ اوس کوٚڑمُت۔ تِمو ہیتؠ ٲمس مارنٕکؠ نٔوؠ طریقہٕ ژھانڈٕنؠ تکیازِ تِم ٲسؠ أمِس کھوژان زِ سٲری لوٗکھ چھِ أمؠ سنٛزِ تٲلیٖمہِ پؠٹھ ہاے بنگٔہ گژھان۔
\v 19 یسوعؔ تہٕ تسندؠ شٲگرد گییہِ تمہِ دوٚہہ شامن شہرِ نیٚبر بیٚیہِ شۅنگنہ بیت عنیاہ ہس منٛز۔
\v 20 صبحس ییٚلہِ تِم یروشلم وتہِ کنُ گژھان ٲسؠ، تِمو وُچھ زِ سُہ انجیر کُل اوس موٗلو تلہٕ ہوٗکھمت یتھ یسوعؔن بد دُعا کوٚڑمُت اوس۔
\v 21 پطرسسؔ پؠو یاد تہِ یہِ یسوعؔن تتھ انجیر کُلس وونمت اوس تہٕ تٔم ووٚن یسوعؔ ہس، "ووٗستاد، وُچھ! یہِ انجیر کُل چُھ سُے یتھ پؠٹھ ژےٕ راتھ لعنت سوٗزتھ چُھ ہوٗکھمت!
\v 22 یسوعؔن دیت جواب، "توٚہہ پٔزِ نہٕ حٲران گٔژھن زِ خداین کوٚر تہِ یہِ مےٚ ووٚن! توٚہہ پٔزِ خدایس پؠٹھ تھٲون ایمان زِ خدایہ کرِ تی یہِ کرُن ونہٕ ہوٗس!
\v 23 بیٚیہِ چُھسو بہٕ توٚہہ پوٚز ونان: اگر توٚہہ منٛزٕ کانٛہہ اکھاہ یتھ پہاڑس ؤنہِ "ووٚتھ تھوٗد تہٕ گژھِ سمندرس منٛز، تمِس پننس دلس منٛز کانٛہہ تہِ شک آسہ نہٕ تتھ متعلق یہِ تٔمؠ ووٚن سپدن گٔژھِ، اگر تمِس یقین چُھ زِ تہِ سپدِ، خدایہ کرِ تی تٔمؠ سنٛدِ خٲطرٕ۔
\v 24 اوے چُھس بہٕ توٚہہ ونان، یہِ کینژھا توٚہؠ خدایس دُعاہس منٛز منٛگان چُھو، پژھ تھٲوِو توٚہہ میلیٚو تیہِ، اگر توٚہہ تمِس پؠٹھ یقین اسہِ، خدایہ کرِ تی تُہنٛدِ خٲطرٕ۔
\v 25 وُنؠ، ونہٕ ھو توٚہہ یہِ تہِ ییٚلہِ توٚہؠ دُعا چُھو کران آسن، ہرگاہ کانٛسہِ خلاف کینٛہہ شیکایت چُھو تس کٔرو معاف یُتھ زنَ تُہنٛد بب یُس آسمانس منٛز چُھ تُہنٛدؠ گۅناہ کرِ معاف۔"
\v 26 اگر توٚہؠ معاف کٔرِو نہٕ تیلہِ کرِ نہٕ تُہنٛد بب، یُس آسمانس منٛز چُھ، تُہنٛدؠ گۅناہ تہِ معاف۔
\v 27 یسوعؔ تہٕ تسَنٛدؠ شٲگرد آیہِ بیٚیہِ یروشلم ہیکل کس صحنس منٛز۔ ییٚلہِ یسوعؔ تتہِ پھران اوس، سردار کاہنن تہٕ یہُودؠ فقہٕ ہیٚچھِ ناوان وول تہٕ بزرگن ہنٛز اکھ جماعتھاہ آیہِ تمِس نِشہ۔
\v 28 تِمو ووٚن تسَ، "ژٕ کمہِ اختیارٕ چُھکھ یِم چیٖز کران؟ یہِ اختیار کٔمؠ چُھے ژٕ دِتُیمُت یِمؠ چیٖز ژےٚ راتھ کٔریتھ؟"
\v 29 یسوعؔن ووٚن تِمن، "توٚہہ پرٛژھو بہٕ اکھ سوال، اگر توٚہؠ دِیو جواب، بہٕ ونوٗو پتہٕ زِ بہِ کمہِ اختیارٕ چُھس یِمؠ چیٖز کران۔
\v 30 کیاہ خداین اوسا یوحناہسؔ تِمن لوٗکن بپتسمہ دِنُک اختیار دِتُیمُت یِم تمِس نِشہ یوان ٲسؠ؟ یا لوٗکو اوسا تمِس تہِ کرنُک اختیار دِتُیمُت؟"
\v 31 تِم لٔگؠ پانہٕ وٲنؠ بحَث کرنہِ زِ تِمن کیاہ پزِ جواب دیٚون۔ تِمو ووٚن أکِس اکھ، "اگر أسؠ ونو تمِس اوس خداین اختیار دِتمُت، سُہ ونہِ اسہِ، پتہٕ توٚہہ پٔزِہے تتھ پؠٹھ پژھ کٔرنؠ یہِ یوحناہن ووٚن!
\v 32 دویمہِ طرفہٕ، اگر أسؠ ونَو یوحناہسؔ اوس لوٗکو اختیار دِتمُت، پتہٕ کیاہ بنہِ اسہِ "تِم ٲسؠ یہِ وننَس کھوژان زِ یوحناہسؔ کمہِ دِیت اختیار، تکیازِ پتہٕ لوٗکن کھسہِ تہنٛز سخ شرارت۔ تِمن ٲسؠ پتاہ زِ سٲری لوٗکھ ٲسؠ یوحناہسؔ پوٚز نبی مانان یُس خداین اوس سوٗزمت۔
\v 33 اوے ووٚن تِمو یسوعؔ ہس جواب، "أسؠ چُھنہٕ پےَ یوحناہسؔ کمؠ اوس لوٗکن بپتسمہ دِنکُ اختیار دِتمُت۔ "پتہٕ ووٚن یسوعؔن تِمن، "تکیازِ توٚہہِ دِتو نہِ میانہٕ سوالک جواب، بہٕ تہِ ونہو نہٕ توٚہہِ زِ کمؠ دِیت مےٚ اختیارٕ تم چیٖز کرنس یمؠ مےٚ راتھ یتہِ کرِ۔"
\c 12
\p
\v 1 \f + \fr 12‏:1 \ft یسعیاہؔ 5:1۔ 2۔ \f*پتہٕ لوٗگ یسوعؔ تِمن یہُودؠ سردارن سٟتؠ ورگہٕ پٲٹھؠ کتھ باتھ کرنہِ۔ تٔمؠ ووٚن، "اکؠ نفرن لوگ اکھ دچھِ باغ۔ اتھ أندؠ أندؠ کوٚرن حفاظٕتہٕ خٲطرٕ اکھ دیوار تعمیٖر۔ دچھِ رس جمع کرنہٕ خٲطرٕ کھننُ اکھ حوض یُس دچھِ نیٖرِہے۔ تٔمؠ بنَنوو اکھ ڈینگجؠ یتھ پؠٹھ کانٛہہ بہتھ دچھِ باغس رٲچھ کرِہے۔ تٔمؠ دِیُت سُہ دچھِ باغ کینٛژن لوٗکن لاگن یمؠ امِچ حفاظت کرِہن تہٕ سُہ دراؤ أکِس خاص مُلکس کنُ سفرس۔
\v 2 ییٚلہِ دچھ والنک وقت ووت، تٔمؠ مٲلکن سوز پنُن نوکر لاگن والیٚن نِش یُتھ زن سُہ دچھِ باغہٕ منٛزٕ پنُن حصہٕ نیہ ہے تِمہ دچھِ منٛزٕ یۅسہٕ اتھ باغس درامٕژ ٲس۔
\v 3 پوٚز ییٚلہِ سُہ نوکر توٚت ووت، تِمو روٚٹ سُہ تہٕ لویہ ہَس، تہٕ تِمو دیُت نہٕ تمِس میٚوٕ کینٛہہ۔ پتہٕ کوٚرکھ خٲلی واپس۔
\v 4 امہ پتہٕ دوٚیمہِ لٹہِ سوز تٔمؠ پنُن بیاکھ اکھ نوکر تِمن نِشہ۔ مگر تِمو پھاٹہٕ نو تمِس کلہٕ، تہٕ پتہٕ کرہس بےیزٔتی۔
\v 5 تمہِ پتہٕ تہِ سوٗزؠ تٔمؠ مٲلکن بیاکھ اکھ نوکر۔ تِمو دچھِ باغ لاگن والیٚو نفرو کوٚر سُہ قتل۔ یتھٕ کِنؠ سوٗزؠ تٔمؠ واریاہ پنُنؠ نوکر تِمن نِشہ مگر تِمو کٔرؠ تِمن سٟتؠ تہِ بدسلوکی۔ کیٛژن آو لاینہٕ تہٕ کینٛہہ آیہِ قتل کرنہٕ۔
\v 6 تمِس مٲلکس اوس وُنہ تہِ بیاکھ اکھ نفر پأنس سٟتؠ، سُہ اوس تٔمؠ سُنٛد گۅبر، یمِس سُہ سیٹھاہ محبتھ کران اوس۔ ٲخرس پؠٹھ سوز تٔمؠ سُہ پنُن گۅبر تِمن نِشہ، تکیازِ تٔمؠ سونچ زِ تٔمؠ پرزٕناون تُہنٛدس گۅبرس تہٕ تمِس سٟتؠ کرنِ رُت سُلوکھ۔
\v 7 پوٚز ییٚلہِ تِمو دچھِ باغ لاگن والیٚو لوٗکو تمہِ سنٛدِ نیٚچو یوان وُچھٕ، تِمو ووٚن أکِس اکھ، وُچِھو! یپارؠ آو تمِس مٲلکہٕ سُنٛد نیٚچو، یمِس کنہِ دوٚہہ یہِ دچھِ باغ وراثتس منٛزٕ ترٛارہے! ؤلِو ژٕھنون قتل کٔرتھ تہٕ دچھِ باغ بنہِ سانؠ وراثت!"
\v 8 تِمو روٚٹ سُہ مٲلکہٕ سُنٛد نیٚچو تہٕ کوٚرُکھ قتل۔ پتہٕ لایکھُ تمہِ سنٛزٕ لاش دچھِ باغہٕ نیٚبر۔
\v 9 وُنؠ وُنہ ہو بہٕ توٚہہِ سُہ دچھِ باغک مٲلکھ کیاہ کرِ۔ سُہ ییہِ، تہٕ تِمن خراب دچھِ باغ لاگن والیٚن نفرن مارٕ۔ پتہٕ دِیہ بیٚیہِ کانٛسہِ نفرس یُس امِچ حفاظت کرِ۔
\v 10 کیاہ توٚہؠ چُھو نا زانان زِ نوِشتہٕ کیاہ چھِ ونان؟
\p تِمو نفرو یمہٕ عمارت تعمیٖر کران ٲسؠ تِمو کوٚر اکھ خاص کٔنؠ اتھ لاگنس اِنکار۔ مگر خداوندن چھےٚ سۅ کنٔؠ أکِس خاص جایہ لاجمژ، تہٕ سۅ چھےٚ عمارژٕ منٛز اکھ خاص اہمیت تھاوان!
\v 11 یہِ چُھ خداوند کوٚڑمُت، تہٕ سٲنؠ کِنؠ چھِ یہِ عجیب۔"\f + \fr 12‏:11 \ft زبُور 118:22، متے 21:23، لوقا 20:17، عملہٕ 4:11، پطرس 1۔ 2:7\f*
\v 12 پتہٕ تِمن یہُودؠ سردارن توٚر فِکرِ زِ یسوعؔن ووٚن تِمن ورگہٕ پٲٹھؠ زِ تِمو بدکار لوٗکو کیاہ کوٚر۔ اوے یژھاو تِمو یہُودؠ سردارو سُہ رَٹن، پوٚز تِمؠ کھوژؠ لوٗکہٕ ارساتس تٔمؠ کیاہ کرِہن اگر یہُودؠ سردارو تہِ کریاو۔ تِمو ترٛوو سُہ أتی تہٕ درٛایہِ۔
\v 13 تِمو یہودی سردارو سوٗزی سردار کاہن تہٕ کٲتب بیٚیہِ زِٹھؠ کینٛہہ فریسی یسوعؔ ہس نِشہ یمو سونچہِ زِ یہُودینؔ پزِ صرف سُہ باج دِؠٚوٗن یُس تِہنٛدیو یہُودؠ حاکِمو لوٗکن پؠٹھ مقرر کوٚڑمُت چُھو۔ تِمو سوٗزؠ بیٚیہِ کینٛہہ تمہِ جمٲژٕ ہنٛدِ کینٛہہ رُکُن یِم ہیرودیسؔن تہٕ رومی حکومتس مددگار ٲسؠ۔ تِم ٲسؠ یژھان یسوعؔ ہس پھساون تِمؠ ٲسؠ یژھان یسوعؔ تژھ کٔتھ ونناون یمہِ سیتٟن أکِس جمٲژ شرارتھ کھٔسہِ تہٕ تِمؠ کٔرِہن تمِس خلاف الزامات دأییٚر۔
\v 14 تمِس نِشہ واتنہٕ پتہٕ، تِمو منٛز اکی نفرن ووٚن یسوعؔ ہس، "وۅستادٕ، اسہِ چھےٚ پتاہ زِ ژٕ چُھکھ پٔزرچ تعلیم دِوان۔ ٲسؠ چھِ پتاہ زِ ژےٚ چھۓ نہٕ کانٛسہِ ہنٛدِ واۓ۔ امہِ بدلہٕ، ژٕ چُھکھ پٔزؠ پٲٹھؠ سارنےٕ لوٗکن سۅ تعلیم دِوان یہِ خدایہ تِمن دیُن یژھان چُھ؛ ژٕ چُھکھ نہٕ کانٛسہِ ہنٛزٕ طرفداری کران چاہیے تٔمؠ سنٛز سماجی حثیت کیاہ تہِ آسہ۔ وُنؠ ون تہٕ اسہِ ژٕ کیاہ چُھکھ یتھ معاملس متعلق سونٛچان رومی حکومتس سون محصول دیُن چھا جٲیز کنہِ نہٕ؟ ٲسہ پزِ یہِ تِمن محصول دیُن  یا نہٕ؟"
\v 15 یسوعؔ ہس توٚر تُہنٛد مکٕر فِکرِ۔ اوے ووٚنُن تِمن، "توٚہؠ کیازِ چُھو مےٚ آزماوان، پوٚز بہٕ دِمہٕ تُہنٛدس سوالس جواب کُنہِ پٲٹھؠ۔ أنِو اکھ دینار مےٚ نِشہ یُس بہٕ وُچھٕ۔"
\v 16 دینار تمِس نِشہ انِنہٕ پتہٕ، تٔمؠ ووٚن تِمن، "یتھ دینارس پؠٹھ کٔمؠ سنٛز شٔکل تہٕ ناو چُھو؟" تِمو ووٚن، "یہِ اکھ شکل تہٕ ناو چُھ قیصرؔ سُنٛد سُہ نفر یُس رومُکؔ بادشاہ چُھ۔"
\v 17 یسوعؔن ووٚن تِمن، "تتھ معاملس منٛز یہِ رومی حکومتُک چُھ سُہ گوٗو حکومتس دِیون تہٕ یہِ خدایہِ سنٛدِ چُھ تہِ گوٗو دِیون خدایس۔ "تِمن گوٗو تتھ پؠٹھ تعجب یہِ تٔمؠ ووٚن۔
\v 18 \f + \fr 12‏:18 \ft صدوقی ٲس فیریسین ہنٛدؠ پٲٹھؠ اکھ لۅکُٹ مذہبی جمٲتھ یتھ منٛز امیٖر لوٗکھ خاص کر کاہن شٲمل ٲسؠ عملہٕ 5:17۔ تِمو کٔرؠ سٲری نوی تصور رد یتھ منٛز قیامت، ملٲیکھ، وغٲرٕ شٲمل ٲسؠ۔ عملہٕ 23:8 \f* صدوقی جمٲژ ہنٛدؠ نفر یِم مُنکر قیامت ٲسؠ زِ لوٗکھ گٔژھن نہٕ مٔرتھ دُبارِ زندٕ کینٛہہ۔ تاکہِ یسوعؔ ہس کرہن تتھ خیالس مذاق زِ لوٗکھ گٔژھن دُبارِ زندٕ، یمو منٛزٕ کینٛہہ آیہِ تمِس نِشہ تہٕ پرٛژھس،
\v 19 ووٗستادٕ، موسیٰؔ ہن چُھو ٲسہِ یہُودینؔ باپتھ حکم دِیتُمُت ہرگاہ کانٛسہِ ہُنٛد بوے مَرِ بے اولاد، تسنٛدٕ بوے گٔژھ کرن تمِس مۅنٛڈٕ زنانہِ سٟتؠ خاندر۔ پتہٕ تِمن دوٗن اولاد آسن، ہر کانٛہہ گٔژھ زانن زِ اولاد چُھ تٔمؠ سُنٛد اولاد یُس نفر مود، تہٕ یتھ پٲٹھؠ روزِ مودمتین ہنٛدِ نسٕل جٲری۔ \f + \fr 12‏:19 \ft تثنِیہ شرع 25:5، پیدٲیش 38:8۔ 9\f*
\v 20 یتِتھ چھِ اکھ مثال: أکِس خادانس منٛز ٲسؠ ستتھ بارٕنؠ۔ زیٹھ اکؠ کوٚر أکِس زنانہِ سٟتؠ خاندر مگر روٗد بے اولاد، پتہٕ مود سُہ۔
\v 21 دوٚیِم بوے پوک اتھ شرحس پؠٹھ تہٕ کوٚرن تمِس زنانہِ سٟتؠ خاندر تہٕ سُہ تہِ روٗد بے اولاد۔ پتہٕ مود سُہ۔ ترٛیِم بٲے تہِ کوٚر تی یہِ باقیو بایو کوٚڑمُت اوس۔ مگر أمِس تہِ اوس نہٕ کینٛہہ اولاد، تہٕ پتہٕ مود۔
\v 22 یِتھٕ کٔنؠ کوٚر تِمو ستو بارِنؠو اکہ اکہ تمِس زنانہِ سٟتؠ خاندر، مگر کانٛسہِ اوس نہٕ کانٛہہ اولاد، تہٕ تِم مود اکہ اکہ سٲری۔ تمہِ پتہٕ سۅ زنان تہِ موٗیہِ۔
\v 23 تمہِ کِنؠ، اگر کینٛہہ لوٗکھ ونان چھِ زِ مَرِنہٕ پتہ چُھ لوٗکن دُبارِ زندٕ گژھن آسہ پوٚز ییٚلہِ قیامژ دوٚہہ سۅ زنانہ دُبارٕ زندٕ گژھِ، یِمو ستو منٛزٕ کس سنٛز زنانہ آسہ سۅ؟ یہِ ذہنس منٛز تھأوتھ زِ تِمو ستوۓ بارِنؠو اوس تمِس سٟتؠ خاندر کوٚڑمُت!"
\v 24 یسوعؔن دیت تِمن جواب، "توٚہؠ چُھو بلکل غلط۔ توٚہیہ چھِنہٕ پتاہ زِ مقدس کتاب کیاہ چھِ اتھ متعلق تعلیم دِوان۔ توٚہؠ چُھو نہٕ لوٗکن دُبارِ زندٕ کرنچ خدایہ سنٛزِ قدرت فِکرے ترٛان۔
\v 25 سۅ زنان آسہ نہِ تِمن کانٛسؠ تہِ بٲے سنٛزٕ زنان، تکیازِ ییٚلہِ لوٗکھ دُبارِ زندٕ گژھن، خاندارو تہٕ خانہِ دارنؠو بجایہ آسن تِم آسمانس منٛز فرشتن ہؠوٗ۔ فرشتہ چھِنہٕ خاندر کران۔
\v 26 پوٚز مےٚ دِیو تِمن لوٗکن متعلق کتھ کرنہٕ یِمؠ مَرُنہٕ پتہٕ دُبارِ زندٕ سپدن۔ موسیٰؔ ہن یوسَ کتاب لیچِھِ مژ ٲس، تٔم چُھ مود متیٚن لوٗکن متعلق لیٚوکھمُت، مےٚ چُھ یقین زِ توٚہہ آسہ پورُمت۔ ییٚلہِ موسیٰؔ دزِونس کٔنڈؠ دۅپھس کنُ وُچھان اوس۔ خداین ووٚن تمِس، "بہٕ چُھس سُہ خدایہ یمِس ابرہامؔ عبادت کران اوس تہٕ سُہ خدایہ یمِس اضحاقؔ عبادت کران اوس تہٕ سُہ خدایہ یمِس یعقوبؔ عبادت کران اوس۔ خداین آسہ ہے نہٕ ووٚنمت زِ اگر نہٕ تٔمؠ تِم انسان دُبارِ زندٕ کٔریمتؠ آسہ ہن تہٕ اگر سُہ وُنؠ تہِ اوس نہٕ تُہنٛد خدا کینٛہہ۔ \f + \fr 12‏:26 \ft خروج 3:2۔ 6\f*
\v 27 وۅنؠ یِمؠ چھِنہٕ مودمٕتؠ لوٗکھ یِم خدایس عبادت چھِ کران۔ یمؠ چھِ زندٕ لوٗکھ یمؠ خدایس عبادت چھِ کران۔ ییٚلہِ توٚہؠ ونان چُھو زِ مودمٕتؠ لوٗکھ گژھن نہٕ دُبارِ زندٕ، توٚہؠ چُھو بجہِ غلطی پؠٹھ۔"
\v 28 یہُودؠ فقیہٕ ہیٚچھناون وول شخصس اوس تُہنٛد بحث بوزان۔ تٔم زون زِ یسوعؔن دِیتُ تِمن اصل پٲٹھؠ جواب۔ سُہ آو یسوعؔ ہس نکھٕ تہٕ پرُوژھن یسوعؔ ہس، "کسُ حکم چُھ زیادٕ ضروری؟"
\v 29 یسوعؔن دیت جواب، "ساروےٕ کھوٗتہِ ضروری حکم چُھو یہِ: اسرائیل کؠو لوٗکو، بوٗزو! خداوند چُھو سون خدا، سُہ چُھ واحد سون خدا۔ \f + \fr 12‏:29 \ft تثنِیہ شرع 6:4\f*
\v 30 توٚہہ پزِ پننس خداوندس یس تُہنٛد خدایہ چُھ تمِس لول برَنُ پننہِ زُوٕ جانہٕ، عقلہِ تہٕ پننہِ ساری طاقتہٕ کھوٗتہٕ زیادٕ! \f + \fr 12‏:30 \ft تثنِیہ شرع 6:5\f*
\v 31 \f + \fr 12‏:31 \ft احبار 19:18\f*دویم سیٹھاہ ضروری حکم چُھ یہِ: توٚہہ پزِ پننیٚن ہمساین تِتھے پٲٹھؠ لول برَنُ یتھٕ پٲٹھؠ پانس بران چُھو۔ یِمو دوییو حکمو تھوٗد چُھنہٕ کانٛہہ حکم!"
\v 32 تٔمؠ شخصژن ووٚن یسوعؔ ہس، "ووستاد، ژٕ دِیتتھ اصل پٲٹھؠ جواب۔ ژٕ ووٚنتھ صاف صاف زِ خدایہ چُھ اکوے خدا تہٕ تمِس ورٲے چُھنہٕ بیٚیہِ کانٛہہ خدایہ۔
\v 33 \f + \fr 12‏:33 \ft تثنِیہ شرع 6:4۔ 5، احبار 19:18، ہوشیع 6:6\f*توٚہہِ ووٚنوٕ ییٚتہِ پزٕرِ سان زِ اسہِ پٔزٕ خدایس لول برُن تتھ سٲرسےٕ منٛز یہِ ٲسؠ یژھان چھِ تہٕ محسوس کران چھِ، تتھ سٲرسےٕ منٛز یہِ ٲسؠ سونچان چھِ، تہٕ تتھ سٲرسےٕ منٛز یہِ ٲسؠ کران چھِ۔ تہٕ توٚہیہ وُنو صاف پٲٹھؠ زِ اسہِ پزٕ لوٗکن سٟتؠ ماۓ ورتاؤنؠ یمن سٟتؠ لسان بسان چھِ تِتھے پٲٹھؠ یتھ پٲٹھؠ ٲسؠ پانس سٟتؠ ورتاوان چھِ۔ توٚہیہ وُنو ییٚتہِ صاف پٲٹھؠ زِ یمہٕ کٲمہ کرنہٕ سٟتؠ چُھ خدایہ خۅٗش گژھان تہٕ یمہِ چھِ سارِنےٕ سوختی قربانین تہٕ نیازن سرس۔
\v 34 یسوعؔ ہس توٚر فِکرِ زِ تٔمؠ شخصژن دیت عقلمندی سان جواب۔ اوے ووٚننس، "مےٚ چُھ باسان زِ خدایی بادشٲہی چھِنہٕ توٚہہِ نِشہ دوٗر۔ "تمہِ پتہٕ، کوٚر نہٕ کانٛسہِ تہِ یہُودؠ سردارن تمِس بیٚیہِ سوال کرنُک جُرتھ یمہِ سٟتؠ سُہ پابند گژھے۔
\v 35 امہ پتہٕ ووٚن یسوعؔن ہیکل کس حِقس منٛز لوٗکن تٲلیٖمہِ دوران، "یہُودؠ فقِیہ ہیٚچھناون وٲلؠ کِتھٕ پٲٹھؠ چھِ یہِ ونان۔ تہٕ تِم چھِ صحیح ونان۔ زِ مسیحؔ چُھ داوود سٕنٛدِ زَر؟
\v 36 پاک روحن ونیوو داوود مسیحؔ ہس متعلق تٔم ووٚن، "خداین ووٚن میانس خداوندس۔"\f + \fr 12‏:36 \ft زبُور 110:1\f* بیٚہہ مےٚ نِش دٔچھنہِ طرفہٕ، تتھ جاۓ یتِتھ بہٕ ژٕ سارِنے کھوٗتہِ زیادٕ یزتھ بخشۓ! بؠہہ یوٚت تام نہٕ بہٕ چٲنؠنن دُشمنن اصل پٲٹھؠ شِکسِ دِمہٕ!"
\v 37 تکیازِ داوودؔ اوس پانہٕ مسیحؔ ہس، میون خداوند، ونان تمہِ کِنؠ کتھٕ پٲٹھؠ گوٗو مسیحؔ بادشاہ داوود سُنٛد زَر؟ سُہ آسہ داوودنہِ کھوٗتہِ بوٗڈ!" واریاہ لوٗکھ ٲس خوشی سان بوزان ییٚلہِ سُہ تِمن تِمؠ چیٖز ہیٚچھِ ناوان اوس۔
\v 38 یسوعؔن ووٚن تِمن لوٗکن تعلیم دِنس دوران، "خبردار زِ توٚہؠ کرٕزؠو نہٕ تتھ پٲٹھؠ عمَل یتھٕ پٲٹھؠ یہُودؠ فقِیہٕ ہیٚچھِ ناوان وولؠ شخصس کران چھِ۔ تِم چھِ تِمن لوٗکن پسند کران یمؠ تِمن یزتھ کرنِ، تِمؠ چھِ زیٹھؠ چۅغہٕ لاگان تہٕ لوٗکن پنن مرتبہٕ ہاؤنہٕ باپتھ اورٕیور پھیران۔ تِم چھِ تِمن لوٗکن پسند کران یِم تِمن بازرن منٛز یزتھٕ سان سلام کرن۔
\v 39 تِم چھِ یہُودؠ اجتماع گاہن منٛز خاص جاؠن بِہُن پسند کران۔ بڈین دوہن، پؠٹھ چھِ تِم تتھ جاۓ بہنُ پسند کران یتھس لوٗکھ تِمن زیادٕ یزتھ کٔرنِ۔
\v 40 تِم چھِ بیٚیہِ مونڈن ہنٛزٕ سٲری جایداد ژورِ نوان۔ مگر لوٗکن چھِ باسان تِم چھِ نیک، تِم چھِ لوٗکن منٛز واریہس وقتس عبادت کران۔ خدایہ دِیہ تِمن یقیٖنن سخ سزا!"
\v 41 پتہ، یسوعؔ بیوٗٹھ ہیکل کس صحنس منٛز تتھ صندوقس مُخألف طرفہٕ یتھ منٛز لوٗکھ خدایس نذرانہٕ ترٛوان ٲسؠ۔ سُہ اوس تتہِ بہتھ وُچھان، واریاہ لوٗکھ ٲس پۅنسہِ صندوقس منٛز تراوان، تہٕ تٔمؠ وُچھ واریاہ امیر لوٗکو ترٛٲو سیٹھاہ پۅنسہِ۔
\v 42 پتہٕ آیہِ اکھ غریب مۅنٛڈ تہٕ تراویٚن زٕ نٕچہِ ترامہٕ دُمرِے، یمہِ دُوشوے رومہٕ کس أکِس سِکس برابر ٲسؠ۔
\v 43‏-44 یسوعؔن کٔر پننؠ ژاٹھ پانس انٛدؠ انٛدؠ جمع تہٕ تِمن ووٚننُ، "پوٚز چُھ یہِ زِ تِمن لوٗکن چھِ سیٹھاہ پونٛسہٕ، مگر تِمو دیت تمیک کمی حصہ۔ مگر یٔمہ زنانہِ، یسَ غریب چھِ، ترٛوو پنن سٲروٕی پۅنسہِ یسَ از أمِس چیٖز مٔلؠ ہینہٕ باپتھ ضرورت اوس۔ لہٰذا امہِ موٚنڈِ بچارِ تروو ساروٕے کھۅتہٕ زیادٕ اتھ صندوقس منٛز!"
\c 13
\p
\v 1 ییٚلہ یسوعؔ ہیکل کہ صحنہٕ منٛز نیٚبر نیران اوس، تٔمؠ سنٛدیو شاگردو منٛز ووٚن تمِس اکؠ شٲگردن، "وۅستادٕ، وُچھ کٟژ حٲران کرن واجنہِ گرِتھ کنہِ چھےٚ یِمن دیوارن منٛز تہٕ کٟژٕ شاندار عمارژٕ چھےٚ یمہ!"
\v 2 یسوعؔن ووٚن تمِس، "آ، یمن شاندار عمارژن کنُ چُھکھ ژٕ وچھان مگر یمن متعلق چُھس بہٕ یژھان ژےٚ کینٛہہ ونُن۔ نیٚبرِم حملہِ آور کرن تِمن مکمل تباہ، کانٛہہ کٔنؠ روزِ نہٕ کنہِ پؠٹھ یتھ ہیکل کس علاقس منٛز یۅسہ نَہ گرِاونہٕ ییہِ۔"
\v 3 ہیکلہٕ پؠٹھٕ وادی منٛز گزرتھ زیتون بالس پؠٹھ واتہِ نہٕ پتہٕ، بؠوٹھ یسوعؔ پتھر۔ ییٚلہِ پطرسؔ، یعقوبؔ، یوحناؔ تہٕ اندریاسؔ تمِس سٟتؠ ٲسؠ، تِمو پرُوژھ تمِس،
\v 4 "اسہِ ون، تِم چیٖز کرِ سپدُن یمن ہُنٛد خداین منصوبہ بنوومُت چُھ؟ اسہِ کِتھ پٲٹھؠ ہیکو تِمہٕ وقتٕچ نشٲنی وچھتھ؟
\v 5 یسوعؔن دیت تِمن جواب، "ہوشیار زِ کیاہ سپدِ یتھ نہٕ کانٛہہ توٚہہِ وتہِ ڈالوٕ!
\v 6 واریاہ لوٗکھ یِنَؤ، تہٕ کرن میون ناو ہٮ۪تھ دعوا۔ پریتھ کانٛہہ وننو پانس متعلق، بہٕ چُھس سُہ مسیحؔ! تِمؠ کرن واریہن لوٗکن گمراہ۔
\v 7 ییٚلہِ زانٛہہ تہِ لوٗکھ توٚہہ ونن جنگن متعلق یِمؠ سپدان چھِ تہٕ تِمن جنگن متعلق یِمؠ سپدن، پریشانی گژھِ نہٕ ہؠن۔ یِمؠ چیٖز سُپدن ضوٚروٗر۔ پوٚز ییٚلہِ تٔم سُپدن، یہِ گژھِ نہٕ سونٛچن زَ یہِ چُھ دُنیاہکُ خٲتمہٕ!
\v 8 واریہن مُلکن منٛز یمؠ جمٲژ چھِ تِم کرن پانہٕ وانے لڑٲے، تہٕ واریاہ حُکومژٕ کرن اکھ أکِس سٟتؠ ہَر۔ واریہن جاین گژھِ بُنیل، تہٕ پتہٕ وتھِن درٛاگ۔ یم سُپدنہٕ پتہٕ، لوٗکن آسن صرف تکلیف وچُھنؠ۔ تِمن آسہ تکلیفو سٟتؠ تیٛژ دگ یژٕ أکِس زنانہِ چھِ آسان ییٚلہِ تمِس بچہ زیٚوان چُھ۔ تمہِ پتہٕ واتن تِمن تمہِ کھوتہِ زیادٕ تکلیف۔
\v 9 تیٛار روٗزؠو لوٗکھ کیاہ کرن توٚہہ سٟتؠ تمہِ وزِ۔ تکیازِ توٚہہ چُھ مےٚ پؠٹھ ایمان، تِم کرن توٚہہِ گرفتار تہٕ کرن مذہبی عدالتن منٛز تُہنٛز پِشی شروٗع۔ یہُودؠ اجتماع گاہن منٛز، دِنؠو چوب۔ سرکارکؠن تھدن حاکِمن نِشہ کرن لوٗکھ توٚہہ مقدِمہ۔ امیٛک نتیجہِ نیرِ، توٚہہِ ؤنؠ مےٚ متعلق۔
\v 10 میانؠ مرید گژھن تمام قومن ہنٛدؠن لوٗکن نِشہ یہِ رژٕ شیٚچھِ اعلان کرتھ تمہِ برونٛہہ واتناوٕنؠ ییٚلہِ خداین سورےٕ کینٛہہ ختم کرنُک منصوبہ بنوومت چُھ۔
\v 11 ییٚلہِ لوٗکھ توٚہہ مقدِمہ کرنہٕ باپتھ گرفتار کرنو، توٚہہ کھوژیو نہٕ تتھ متعلق یہِ توٚہؠ وونو۔ امہِ بجایہ وُنؠ زیٚو تہِ یہِ خداین تمہِ وزِ تُہنٛدس دماغس منٛز ترٛومت آسہ۔ یہِ ٲسِو نہٕ توٚہہِ کتھ کران۔ یہِ آسہ پاک روح تُہنٛزِ زؠوٕ کتھ کران۔
\v 12 \f + \fr 13‏:12 \ft لوقا 21:16، ملاکی 7:6\f* باقیو خراب چیٖز تہِ سُپدن: یِمن لوٗکن مےٚ پؠٹھ ایمان چُھنہٕ کینٛہہ تِم رٹناون تہنٛدن بینن تہٕ باین تاکہِ سرکار کرِ تِمن قتل۔ کینٛہہ والدین دِن پننن شُرن دوٗکھ تہٕ کینٛہہ شُرؠ دِن والدینن دوٗکھ زِ سرکٲری افسر کرن تہنٛدن والدینن قتل۔
\v 13 واریاہ لوٗکھ کرنوو توٚہہِ نفرت تکیازِ توٚہہِ چُھو مےٚ پؠٹھ ایمان۔ مگر خدایہ کرِ تُہنٛز حفاظت یمِس مےٚ پؠٹھ مظبوطی سان بھروسہٕ آسہ یۅتام تُہنٛز زندگی انٛد واتہِ۔
\v 14 \f + \fr 13‏:14 \ft دانیال 11:31، 12:1\f*تتھ وقتس دوران اژن ہیکلس منٛز ناپاک چیٖز۔ یِم کرن ہیکل لس گندٕ تہٕ لوٗکھ ترٛاون اور گژھن۔ ییٚلہِ توٚہؠ وُچِھو یہِ گژھِ نہٕ آسن، توٚہہ پٔزِ جلد ژٔلنُ! ہرَ کانٛہہ یُس یہِ پران چُھ ما دِیہ دھیان یتھ خبرداری کنُ! تمہِ وقتہٕ یِم لوٗکھ یہُودیہ علاقس منٛز آسن تِمن پٔزِ تھدِن بالن کنُ ژلنُ۔
\v 15 تِم لوٗکھ یِمؠ پننؠن گرن نیٚبرٕ کنہِ آسن تِمن پٔزِ نہٕ کانٛہہ چیٖز حاصل کرنہٕ خٲطرٕ پننؠن گرن منٛز اژن۔
\v 16 یِم کھہَن منٛز کٲم آسن کرن تِمن پٔزِ نہٕ بیہِ پلو حاصل کرنہٕ باپتھ پننؠن گرن منٛز واپس گژھن۔
\v 17 ییٚلہِ یہِ سپدِ، یہِ کوتاہ خطرناک آسہ گۅبہِ کھور زنانن تہٕ یِمہٕ پننؠن شُرن دۅد آسن دِوان۔
\v 18‏-19 تِمن دوہن واتن لوٗکن سیٹھاہ تکلیف۔ لوٗکو چھِنہٕ تتھ مصیبت تنہٕ پؠٹھٕ زانٛہہ وُچھمٕتؠ ینہٕ پؠٹھٕ خداین گوڈٕ یہِ دُنیاہ پٲدٕ کوٚر، لوٗکھ تُلن نہٕ دُبارِ تیتھ تکلیف یمہِ یوٗر۔ لہٰذا دُعا کریو زِ یہِ مصیبتُک وقت گوٗژھنہ ونٛدس منٛز آسن، ییٚلہِ سفر کرن سخ چُھ آسان۔
\v 20 ہرگاہ خداین آسہ ہے نہٕ فٲصلہٕ نِمُت زِ سُہ کرِ سُہ وقت مخصر ییٚلہِ لوٗکن زیادٕ تکلیف واتہِ، یمہِ سٟتؠ ما مرِ ہرَ کانٛہہ۔ پوٚز تٔمؠ چُھ فٲصلہٕ کوٚڑمُت سُہ وقت گژھِ آسن مخصر تکیازِ تمِس چھِ تِمن لوٗکن متعلق فِکر یمؠ تٔمؠ ژارِؠ متؠ چھِ۔
\v 21‏-22 لوٗکھ ونن تمہ وقتہٕ اپُز زِ تِم چھِ مسیحؔ۔ تہٕ کینٛہہ کرن خدایہ سُنٛد نبی آسنُک دعوا۔ پتہٕ ہاون تِم واریہن قسمن ہنٛدؠ معجزٕ۔ تِم کرن خدایہ سنٛدٮ۪ن ژارِؠ متین لوٗکن تہِ دوکھ دِنچ کوٗشش۔ لہٰذا تمہِ وقتہٕ اگر توٚہہِ ونہِ کانٛہہ، "وچھِو، یپٲرؠ چُھ مسیحؔ، یا ہرگاہ کانٛہہ ونہِ، وچھِو، سُہ چُھ ہُپٲرؠ! اتھ پؠٹھ کرِزو نہٕ یقین!\f + \fr 13‏:21‏-22 \ft متی 24:24\f*
\v 23 ہُشیار روزیٚو! یاد تھویو زِ مےٚ چُھو توٚہؠ برٛونٹھے اتھ متعلق خبردار کرمتؠ!
\v 24 \f + \fr 13‏:24 \ft یسعیاہؔ 13:10\f* ییٚلہِ لوٗکھ تتھ پٲٹھؠ مصیبت تُلن تمہِ وزِ کرِ خدایہ افتابس انہِ گوٚٹ تہٕ زون دِییہ نہِ چَمَک؛
\v 25 \f + \fr 13‏:25 \ft یسعیاہؔ 34:4، مُکاشفہ 6:13\f*خدایہ ترٛاو تارکن آسمانہٕ پؠٹھٕ بۅن تہٕ آسمانس منٛز تمام چیٖز ڈلن پننہ جایہِ۔
\v 26 \f + \fr 13‏:26 \ft دانیال 7:13، مُکاشفہ 1:17\f*امہ پتہٕ لوٗکھ وچُھن مےٚ، آدمؔ سٕنٛدِس گۅبرس، اوٗبرس منٛز طاقتہٕ تہٕ شاندار پٲٹھؠ یوان۔
\v 27 \f + \fr 13‏:27 \ft تثنِیہ شرع 31:4، متی 24:31\f*پتہٕ سوزکھ بہٕ پننؠ فرشتہٕ تاکہِ تِمؠ سومبراون تِمن لوٗکن یمؠ خداین ہر جایہ ژارِؠ متؠ چھِ، زمیٖنہِ ہنٛدِیو دوٗر دراز جایو پؠٹھٕ۔
\v 28 وُنؠ چُھس بہٕ یژھان توٚہؠ ہؠچِھو رژھا انجیر کلُ کِتھ پٲٹھؠ چُھ یٹھان۔ ییٚلہِ تمِچہِ لنجہِ نرم چھِ گژھان تہِ تمیکؠ پنہٕ ؤتھر چھِ نیرُن ھیوان، توٚہؠ چُھو زانان زِ ریتہٕ کول چُھ ینہٕ وول۔
\v 29 یِتھے پٲٹھؠ، ییٚلہِ توٚہؠ وچھان چُھو یمہِ واقہچ مےٚ وُنؠ وضاحت کرِ، توٚہؠ وچھو پانے زِ میانہِ واپس نیرنُک سُہ وقت چُھ سیٹھاہ نزدیک۔ سُہ آسہ تتھٕ پٲٹھؠ زنَ تہِ چُھس بہٕ برونٛٹھےٕ\f + \fr 13‏:29 \ft یسوع مسیحؔ\f* دروازس پؠٹھ۔
\v 30 یہِ تھایو ذہنس منٛز: یہِ نسٕل گژھِنہِ ختٕم توٚت تام یوٚت تام نہٕ یمو چیٖزو منٛزٕ ہرَ کانٛہہ چیٖز سپدِ\f + \fr 13‏:30 \ft یسعیاہؔ 40:8، لوقا 21:33\f*۔
\v 31 توٚہہ گژھِ مکمل یقین آسن زِ تٔمؠ چیٖز سپدن یمن ہنٛز مےٚ پیش گوییٔ کرٕ زمیٖنس تہِ آسمانس منٛز یہِ کینٛژھا چُھ گژھِ اکہ دوٚہہ ختٕم، پوٚز یَمؠ چیٖز سپدن یقیٖنن یِمؠ مےٚ توٚہہِ ؤنؠ متؠ چُھو۔
\v 32 کانٛہہ اکھ چُھنہٕ زانان صٔحیح وقت ییٚلہِ بہٕ واپس یمہٕ۔ آسمانٕکؠ فرشتہ تہِ چھِنہٕ زانان۔ حتاکہ بہٕ، خدایہ سُنٛد گۅبرُ، تہِ چُھ نہٕ زانان۔ صرف چُھ میٚون بب زنان۔
\v 33 لہٰذا روزیٚو تیار! ہمیشہِ روزیٚو ہوٗشیار تہٕ عبادت گُزار، تکیازِ توٚہہ چُھو نہٕ خبر سُہ وقت ییٚلہِ بہٕ واپس یِمہٕ!
\v 34 یہِ آسہ یتھ ہیو۔ ییٚلہِ اکھ نفرٕ أکِس دوٗر دراز جگہس کنُ سفر یژھان چُھ کرُن تہٕ وُنؠ چُھ گرِ نیرنس تیار آسان، سُہ چُھ پننؠن خدمت گارن ونان زِ تِمن پزِ گرِ سمبالُن۔ سُہ چُھ پریتھ أکِس باند باند کران زِ کس کیاہ پزِ کرُن۔ پتہٕ ونہ دروازِ کسَ رٲچھ درس ہوشیار روز بہٕ آسے واپس۔
\v 35 تمِس نفرس پٔزِ ہمیشہِ تیار روٗزن، تکیازِ تمِس چھِنہٕ پےِ یہِ مٲلکھ کرِ ییہِ واپس شامس، نیصف رٲژ، سحرن کۅکر بانگہٕ، یا صبحس افتاب آسہ آسمانس منٛز ہیٚور کھوٗمت۔ یتھےٕ پٲٹھؠ، توٚہہ تہِ پٔزِ ہمیشہِ تیار روٗزن، تکیازِ توٚہہ چُھو نہٕ پےٕ بہٕ کرِ یمہٕ واپس۔
\v 36 یہِ گوٚژھ نہٕ سپدن زِ ییٚلہِ بہٕ اچانک یِمہٕ، بہٕ وُچھ زِ توٚہؠ چُھو نہٕ تیار!
\v 37 یمہٕ کتھٕ بہٕ توٚہہِ شٲگردن چُھس ونان بہٕ چُھس ونان ہر أکِس: ہمیشہِ روزیٚو تیار!"
\c 14
\p
\v 1 وُنہِ ٲس تتھ بڈِس دوٚہس زٕ دوٚہہ باقی یُس تِم لوٗکھ پورٕ أکِس ہفتس مناون شروٗع کرِہن تتھ ٲس تِمؠ ونان فسح۔ تِمنہٕ دوٚہُن دوران ٲسؠ تِم سُہ بوٗڈ دوٚہہ تہِ مناوان یتھ تِم عیدِ فطیٖر\f + \fr 14‏:1 \ft عیٖدِ فطیٖر اوس یہُودینؔ ہُنٛد بوٚڈ دوٚہہ یتھ پؠٹھ تِم خدایس یاد کران ٲسؠ ییٚلہِ سُہ مِصرس منٛز تِہنٛدیو گرو پؠٹھؠ کِنؠ دراو تِمو کوٚر یونہٕ جانورن خش خروج۔ 12:13، 23، 27۔ عیٖدِ فطیٖر پؠٹھ ٲسؠ برٕ مارچ، اپریلس منٛز مارٕ تہٕ شامہٕ پؠٹھٕ نیصف رٲژ تام ٲسؠ کھیوان۔ \f* ونان ٲس۔ کاہن سردار تہٕ یہُودؠ فیقہٕ ہیٚچھٕ ناون وٲلؠ ٲسؠ منصوبہ بناوان زِ تِم کتھٕ پٲٹھؠ رٹن یسوعؔس فریب دِتھ۔ تِم ٲسؠ یژھان أمِس رومی حاکِمن برونٛہہ کنہِ الزام دیُن یتھٕ پٲٹھؠ تِم تمِس قتل کرہن۔
\v 2 تِم ٲسؠ أکِس اکھ ونان، "اسہِ پزِ نہٕ یہِ بوٚڈ دوٚہہ مناونس دوران کرُن کینٛہہ تکیازِ اگر اسہِ یہِ کوٚر پتہٕ لوٗکن کھٔسؠ تن شرارت تہٕ گژھن اسہِ خلاف تہٕ سپدِ فساد!"
\v 3 یسوعؔ اوس بیت عنیاہ گامس منٛز شمعونؔ یُس برونٛہہ مینٛدؠ لد اوس\f + \fr 14‏:3 \ft وۅنؠ اوس شمعونؔ ٹھیک سپدمُت، مگر تس ٲسؠ وننہِ تہِ مینٛدؠ لد ونان۔ \f*، سٕنٛدؠ گرِ مہمان۔ ییٚلہِ تِم غذا کھیوان ٲسؠ، اکھ زنان آیہِ تِمن نِشہ۔ تمِس زنانہِ اوس اکھ سنگِ مرمرکُ عطرِدان یتھ منٛز قیمتی عطر ٲس، سۅ ٲس ناردل کُلچ صاف عطر، یۅسہ سیٹھاہ محنتہٕ سٟتؠ بناونہٕ ٲس آمٕژ۔ تمہِ مُژرٲو سۅ عطرِ دٲنؠ تہٕ پتہٕ ترٲوٕن سٲری سۅ عطر یسوعؔس کلس پؠٹھ۔
\v 4 کینٛہہ لوٗکھ یِمؠ تتہِ موجود ٲسؠ تِمن آیہ شرارت تہٕ پانس کنُ ونُکھ، "یہِ چُھ غلط زِ امہِ کٔر سۅ عطر ضایہِ!
\v 5 یہِ عطر ییہِ ہے أکِس ورؠ یچہِ مُزورِ کٕننہٕ، تہٕ پتہٕ ییہِ ہے سُہ پونٛسہٕ غریب لوٗکن دِنہٕ!" تِمو کٔر تمِس بےیزتی۔
\v 6 مگر یسوعؔن ونُکھ، "أمِس مہَ کرِوُ ملامت! یہِ تمہِ کوٚر مےٚ تہِ چُھ مےٚ سٟتؠ رٕژر۔ اوے پزِ نہِ توٚہؠ یہِ پریشان کٔرنؠ!
\v 7 \f + \fr 14‏:7 \ft تثنِیہ شرع 15:11۔ \f*توٚہہِ نِشہ روٗزن غیٖریب لوٗکھ ہرَ ساعتہٕ۔ توٚہیہ ہیکؠو تِمن مدد کٔرتھ یمہٕ ساعتہٕ یژھو۔ پوٚز بہٕ روزِ نہٕ توٚہیہ سٟتؠ ییٚتہِ زیادٕ کألس کینٛہہ۔
\v 8 یہ چُھ بلکل صحی، تمہِ کوٚر تی یتھ لایق سۅ ٲس۔ زنہٕ تہِ ٲس تمِس پتاہ زِ مےٚ چُھ وۅنؠ جلدےٕ نیرُن تہٕ امہِ مٔژھ میأنس بدنس وُڑراونہٕ برونٛہےٕ عطٕر۔
\v 9 بہٕ ونہٕ ہوو توٚہہِ یہِ: ییٚلہِ تہِ زانٛہہ میٲنؠ مرید سٲرسےٕ دُنیاہس منٛز یمہِ رٔژِ شیچھ ہُنٛد تبلیغ کٔرن، تِمؠ ونن ییٚتہِ زِ تمہِ زنانہِ کیاہ کوٚر، تہٕ لوٖکھ تھاون تمِس تہِ یاد۔"
\v 10 پتہٕ گوٗو یہُوداؔ اِسکریوتی کاہن سردارس نِشہ یسوعؔ بنٛد کرُناونس منٛز مدد کرنہٕ باپتھ کٔتھ کرنیہ۔ تٔمؠ کوٚر تٔمہ پتہ تہِ سُہ اوس تِمو بہو شاگردو منٛزٕ اکھ۔
\v 11 ییٚلہِ تِمو کاہن سردارو بوز زِ سُہ اوس تُہنٛدِ خٲطرٕ یہِ کُرن یژھان، تِم گۓ سیٹھاہ خوش۔ تِمو کوٚر تمِس وعدہ زِ تِم دِن تمِس تمہِ بدلہِ پونٛسہٕ انعامہٕ۔ یہوداہنؔ کوٚر اتِفاق تہٕ لوٚگ یسوعؔ ہسَ رٹناونکُ منٲسب موقہٕ ژھانٛڈنہِ پتہ کرِہس تِمن حوالہٕ۔
\v 12 \f + \fr 14‏:12 \ft خروج 12:6، 15\f*عیٖدِ فطیٖرِکہ گۅڈنکہِ دوٚہہ، ییٚلہِ تِمو اکھ کٹہٕ بچہ فسح باپتھ ذبح کوٚر، شاگردو ووٚن، "یسوعؔ، توٚہؠ کوٚت چُھو یژھان ٲسؠ گژھو تہٕ تتہِ کرو فسح مناونہٕ باپتھ کھیٚن تیار یُتھ أسؠ ہیکؤ تہِ کھیٚتھ؟"
\v 13 \f + \fr 14‏:13 \ft دانیال 9:27، 12:11\f*یسوعؔن ژٲرِؠ پننؠ زِ ژاٹھ یِم سورےٕ تیار کرِہن۔ تِمؠ ووٚن تِمن، "توٚہؠ گٔژھو یروشلم شہرس منٛز۔ توٚہہِ سمکھیٚو اکھ شخصس یُس اکھ برتھ آبہٕ گڈو اسہِ پکناوان۔ تمِس پٔکیو پتہٕ پتہٕ۔
\v 14 ییٚلہِ سُہ أکِس گرس منٛز اژِ، تمہِ گرٕ کس خاندارس ؤنؠ زِیو، سون وۅستاد چُھ یژھان فسح مناونہٕ چُھ ٲسؠ کھیٚن تیار کرُن تاکہِ سُہ ہیٚکہ پن نین شٲگردن سٟتؠ کھیٚتھ۔ مہربٲنی کٔرتھ ہاو تہٕ آسہ کمرٕ۔
\v 15 سُہ ہاوِ توٚہہ اکھ بوٚڈ کمرٕ یُس گھرٕ کِس ہیرمِس پوٚہرس پؠٹھ اسہِ۔ اتھ آسہ فرش کرتھ، کھینہٕ خٲطرٕ آسن صوفہٕ، تہٕ بیٚیہِ آسہ کھیٚنہ خٲطرٕ میز، تہٕ یہِ آسہ سانہِ کھیٚن چیٚنہٕ خٲطرٕ تیار۔ پتہٕ کرِو تٔتی اَسہ باپتھ کھیٚن تیار۔"
\v 16 أتی درٛایہِ تِم ژاٹھ۔ تِم گییہِ شہرس منٛز تہٕ تِمو وُچھ تہِ ہر کانٛہہ چیٖز یہِ تِمن وننہٕ اوس آمُت۔ پتہٕ کوٚر تِمو فسح مناونہٕ باپتھ کھیٚن تیار۔
\v 17 ییٚلہِ شام ووت، یسوعؔ ژاو تتھ گرس منٛز باہ ژاٹھ ہٮ۪تھ۔
\v 18 \f + \fr 14‏:18 \ft زبُور 41:9\f* ییٚلہِ تِم سٲری میزس نکھٕ بہتھ کھیوان ٲسؠ، یسوعؔن ووٚن، "یہِ بوزیٚو احتیاتہٕ سان: توٚہہِ منٛز کرِ اکھ میانین دشمنن مےٚ رٹہ ناونس منٛز مدد۔ سُہ اکھ چُھ ونہِ کین مےٚ سٟتؠ کھوان!"
\v 19 شٲگرد سٔپدؠ غمگین، ہرَ اکؠ ووٚن یسوعؔ ہس، اکہ اکہ، "یقیٖنن یہِ چُھس نہٕ بہٕ یُس ژےٚ وُنکین دغاہ دییہِ؟"
\v 20 پتہٕ ووٚن تٔمؠ تِمن، "توٚہہِ بہن شٲگردن منٛز چُھ اکھ سُہ نفر یُس مےٚ سٟتؠ بانس منٛز موجود رسس منٛز پننؠ ژوٚٹ وزٕوان چُھ۔
\v 21 یہِ چُھ پوٚز زِ مےٚ، آدمؔ سٕنٛدِس گۅبرس چُھ نیرُن، تکیازِ نبیو چُھ تہِ مےٚ متعلق لیٚوکھمُت۔ مگر تمِس نفرٕ سنٛدِ خٲطرٕ اسہِ خطرناک سزا یُس مےٚ رٹناونس منٛز میانین دشمنن مدد کرِ! حقیقتس منٛز، اوس تسٕنٛدِ خٲطرٕ یہِ جان زِ سُہ گوژھنہٕ زانٛہہ پٲدے آسن گومتُ!"
\v 22 ییٚلہِ تِم کھیٚوان ٲسؠ، تٔمؠ تُج اکھ ہموار ژوٗٹ تہٕ کوٚرن خدایس امہِ خٲطرٕ شُکر ادا۔ پتہٕ کٔرؠ نس ٹُکرٕ تہٕ دِژٕن تِمن تہٕ وُننکھ، "یہِ ژوٚٹ چُھ میون بدن۔ نِیو یہِ تہٕ کھیوو۔"
\v 23 تمہِ پتہٕ، تلُ تٔمؠ اکھ پیالہٕ یتھ منٛز شراب اوس تہٕ امہِ خٲطرٕ کوٚرن خدایس شُکر ادا۔ پتہٕ دِتنُ پننؠن شٲگردن، تہِ تِمو ساروٕے چیو امہِ پیالہٕ منٛز۔
\v 24 \f + \fr 14‏:24 \ft خروج 24:8، ذکریا 9:11\f*یسوعؔن ووٚن پننن شٲگردن، "یہِ شراب چُھ میٚون خوٗن، یُس میانہِ بدنہٕ منٛز نیرِ ییٚلہِ میانؠ دشمن مےٚ قتل کرن۔ یمہِ خوٗنہٕ سٟتؠ چُھس بہٕ تمہِ اقرار نامُک تصدیق کران زِ خداین چُھ واریہن لوٗکن ہنٛدؠ گناہ معاف کرنُک اِرادٕ کوٚڑمُت۔
\v 25 بہٕ چُھس یژھان توٚہؠ گژھو یہِ زانٕنؠ: بہٕ چیمنہٕ وُنؠ تۅتام شراب یۅتام نہٕ خدایہ سنٛز بادشٲہی ژوپٲرؠ آسہ تیلہِ چیمہٕ بہٕ دُبارِ۔"
\v 26 خدایہ سنٛدین تعریفن ہُنٛد اکھ بٲتھ گیونہٕ پتہٕ گے یسوعؔ تہٕ تسَنٛدؠ شٲگرد زیتون بالس کنُ۔
\v 27 وتہِ پکان پکان ووٚن یسوعؔن پننن شٲگردن، "رسول ذکریاہؔ ہن چُھ نوشتن منٛز لیٚوکھمُت زِ خداین کیاہ ووٚن مےٚ متعلق، "بہٕ مارن سُہ پۅہۅل تہٕ تیٖرؠن گژھن چھلہِ چھانٛگر" تِم لفظ نیرن پوٚز۔ توٚہؠ تریو مےٚ تہٕ ژَلِو۔
\v 28 پوٚز تمہِ پتہٕ خدایہ کرِ مےٚ دُبارِ زندٕ، بہٕ نیرٕ توٚہہِ برونٛہہ گلیل کس علاقس کِنؠ تہٕ سمکھو تیتی۔"
\v 29 پطرسؔن ووٚن یسوعؔ ہس، "باقیو سٲری شٲگرد ما ترٛاونو توٚہہِ، مگر بہِ نہٕ! بہٕ ترٛووہو نہٕ توٚہؠ!"
\v 30 پتہٕ ووٚن یسوعؔن پطرسسؔ، "پزر چُھ یہِ زِ ازچہِ رٲژ کۅکرٕ سنٛزِ دوٗیمہِ بانگہِ تام ٲسِتھ ژٕ تریمہِ لٹہِ پانے مےٚ متعلق ووٚنمت زِ ژٕ زانکھ نہٕ مےٚ۔"
\v 31 پوٚز پطرسنؔ ووٚن تمِس پوٗرٕ پٲٹھؠ، "ہرگاہ تِم مےٚ مارن تہِ، بہٕ ونہٕ نہٕ زانٛہہ زِ بہٕ زانتھ نہٕ ژےٚ کینٛہہ۔ "باقیو ساروےٕ شاگردو تہِ ؤنؠ یہےَ کتھ۔
\v 32 یسوعؔ تہٕ تسَنٛدؠ شٲگرد گییہِ أکِس جایہ کنُ یتھ لوٗکھ گتسمنی ونان ٲسؠ۔ یسوعؔن ووٚن پننن کیٛنژن شٲگردن، "یتی روزیٚو یوٚت تام بہٕ دُعا کرٕ!"
\v 33 تٔمؠ تُلؠ پطرسؔ، یعقوبؔ تہٕ یوحناؔ پانس سٟتؠ۔ یسوعؔ گوٚو اِنتِہٲیی جَزبٲتؠ انٛدازٕ دل ملول۔
\v 34 \f + \fr 14‏:34 \ft زبُور 42:5\f* تٔمؠ ووٚن تِمن، "مےٚ چُھ سیٹھاہ افسوس۔ مےٚ چُھ باسان زن تہِ چُھ مےٚ مَرُن۔ توٚہؠ روزیٚو یتن تہٕ روزیٚو مےٚ نظرِ!"
\v 35 یسوعؔ پوٚک رِژھا برونٛہہ تہٕ ترٛووُن پننُ پان زمیٖنس پؠٹھ۔ پتہٕ کوٚر تٔمؠ دُعا زِ اگر سپدتھ ہیٚکہ ہے، تمِس گژھؠ نہٕ پیٚنؠ تکلیف تُلنؠ۔
\v 36 تٔمؠ ووٚن، "اے میانہِ ببأ، تکیازِ ژٕ ہیککھ کینٛہہ تہِ کٔرتھ، مےٚ بچاو تاکہِ مےٚ آسن نہٕ وُنؠ تکلیف تُلنؠ! پوٚز تہِ مہَ کرِ یہِ بہٕ یژھان چُھس۔ تی کرِ یہِ ژٕ یژھان چُھکھ!"
\v 37 پتہٕ آو یسوعؔ تتھ جایہِ واپس یتین تٔمؠ پطرسؔ، یعقوبؔ تہٕ یوحنا تھاوؠ مٕتؠ ٲسؠ۔ تٔمؠ وُچھ تٔم شٲگرد شونٛگِتھ۔ تٔمؠ کٔرؠ تِم بیدار تہٕ ووٚنُن پطرسسؔ، یمِس شمعونؔ تہِ ونان ٲسؠ، شمعونؔ! مےٚ چُھ دۅکھ زِ ژےٚ ترٛٲوتھ نینٛدر تہٕ ژٕ ہیٚوککھ نہٕ ییتِس کم وقتس بیدار روٗزتھ!"
\v 38 تہٕ یسوعؔن ووٚن تٔمن، "توٚہؠ چُھو یژھان تی کرُن یہِ بہٕ ونہٕ، مگر توٚہؠ چُھو نہٕ زیادٕ مضبوط۔ بیدار روزیٚو تہٕ دُعا کٔریوٗ یتھ زنَ توٚہؠ تمہِ وزِ برداش کریو یمہِ وزِ توٚہہ ازمٲیش آسہ!"
\v 39 پتہٕ گوٚو سُہ دُبارٕ دوٗر پہن تہٕ کوٚرن دُبارِ دُعا یہِ تٔمؠ برونٛہہ کوٚڑمُت اوس۔
\v 40 ییٚلہِ یسوعؔ واپس آو، تٔمؠ وُچھ تٔمؠ دُبارٕ شونٛگِتھ؛ تِم ٲسؠ مَژِ نینٛدرِ زِ تِمو ہیٚچہ نہٕ أچھ تہِ مُژرٲوتھ۔ تکیازِ تِم گے شرمنٛدٕ، ییٚلہِ تٔمؠ تِم بیدرا کٔرؠ تِمن اوس نہٕ فِکرے تران زِ تِم کیاہ جواب دِن تمِس۔
\v 41 پتہٕ گوٚو یسوعؔ تہٕ بیہِ اکہ لٹہِ کوٚرن دُعا۔ سُہ آو ترٚیمہِ لٹہِ واپس تہٕ وچھِن تِم بیہِ شونٛگِتھ۔ تٔمؠ ووٚن تِمن، "مےٚ چُھ دوکھ زِ توٚہؠ چُھو بیہِ شونٛگِتھ! توٚہہ کٔرو واریاہ نینٛدر۔ میانہِ باپتھ چُھ مصیبتُک وقت شروٗع سپدن وول۔ وچھِو! کسُ تام گناہگار نفر چُھ مےٚ آدمؔ سنٛدِس گۅبرس، رٹنانس منٛز مدد کرن وول۔
\v 42 لہٰذا وتھیٚو! أسؠ نیٛرو! وچھِو! یپٲرؠ چُھ سُہ اکھ نفر پکان یُس تِمن مےٚ رٹنس منٛز مدد چُھ کران!"
\v 43 سُہ اوس وُنہِ کتھےٕ کران، زِ یہُوداؔ ووت۔ اگرچہ سُہ یسوعؔ سنٛدیو بہو شاگردو منٛز اکھ اوس، تمہِ پتہٕ آو سُہ یسوعؔ سنٛدین دشمنن سُہ رٹناونس منٛز مدد کرنہِ۔ تمِس سٟتؠ اوس لوٗکن ہُنٛد اکھ ہجوٗم یِم تلوارٕ تہٕ ڈنڈٕ ہٮ۪تھ ٲس۔ تِم ٲسؠ یہُودؠ مجلسہِ مشاورت ہُنٛدیو سردارو سوٗزِمت۔
\v 44 یہُوداؔ، یِمؠ یسوعؔ دشمنن اتھِ رٹنوو، اوس لوٗکن ہُنٛدس ہُجومس گۅڈے یہِ ونمُت، "یمِس نفرس بہٕ موٚنؠ کرِ سوسےُ چُھ یُس توٚہؠ ژھاران چھون۔ ییٚلہِ بہٕ تمِس موٚنؠ کرٕ، توٚہؠ رُٹؠ زیون تہٕ، تہِ حفاظتہٕ سان گژھِ گنڈتھ نیٚون۔"
\v 45 لہٰذا، یہُوداؔ ووت، سُہ گوٚو ولؠ ولؠ یسوعؔ ہس نِشہ تہٕ ووٚننَس، "میانہِ ووستادٕ!" پتہٕ کریٚن یسوعؔ ہس موٚنیہِ۔
\v 46 پتہٕ لوٗکہٕ ہجومن کٔر یسوؔع ہس تھَپھ تہٕ کوٚرکھ سُہ گرفتار۔
\v 47 پوٚز تسَنٛدیو شاگردو منٛزٕ اکی شٲگردن، یسَ نکھے اِستادٕ اوس، کٔڈ پننؠ تلوار۔ تٔمؠ تُج تہِ لاین کاہن سردار سٕنٛدِس خدمت گارس، مگر تمہِ سٟتؠ ژھیٚوٚن صرف خدمت گارس کنَ۔
\v 48 یسوعؔن ووٚن تِمن، "یہِ چُھ حیرَت ناک زِ توٚہؠ چُھو تلوارٕ تہٕ ڈنڈٕ ہٮ۪تھ مےٚ گرفتار کرنہِ آمُت، زنَ تہِ بہٕ اوسس اکھ ڈاکو۔
\v 49 بےٕ اوسس توٚہہ سٟتؠ واریہن دوہن ہیکلس منٛزٕ لوٗکن تعلیم دِوان۔ توٚہہ کیازِ کٔرو نہٕ تمہِ ساعتہٕ بہٕ گرفتار کرنٕچ کۅٗشش؟ پوٚز یہِ چُھ سپدان تِتھے پٲٹھؠ یتھ پٲٹھؠ زنہٕ نبیو نوشتن منٛز مےٚ متعلق لیٚوکھمُت اوس زِ یہِ سپدِ۔"
\v 50 \f + \fr 14‏:50 \ft زبُور 88:18\f*پتہٕ ژھوٚن ساروٕے شاگردو یسوعؔ ترٛٲوتھ تہٕ ژٔلؠ۔
\v 51 تمہِ ساعتہٕ، اوس اکھ جوان یسوعؔ ہس پتہ پتہ پکان۔ تمِس ٲس اکھ للن ژادر پانس ولتھ۔ لوٗکن ۂنٛدِ ہجومن کٔر تمِس جوانس تھَپھ،
\v 52 پوٚز، تٔمؠ دِیت درٛسہٕ ژادرِ ہنٛزٕ تٕرِ پچہِ روزٕ تِمن اتھن منٛز تہٕ ژوٚل ننٚگے۔
\v 53 یمو نفرو یسوعؔ روٚٹمُت اوس تِمو واتہٕ نوو سُہ تتھ گرس منٛز یتہِ زٹھؠ کاہن روٗزان ٲسؠ۔ یہُودؠ مجلسہِ ہنٛدؠ سٲری نفر ٲسؠ تتہِ جمع گژھان۔
\v 54 پطرسؔن گوٚو یسوعؔ ہس دوٗر روزِتھ پتہٕ پتہٕ۔ سُہ گوٚو تتھ گرکس آنٛگنس منٛز یتہِ کاہن سردار روٗزان اوس، سُہ بؠوٗٹھ تِمن نفرن سٟتؠ یِم کاہن سردار سنٛدِس گرس رٲچھ ٲسؠ۔ سُہ رود نارس نکھ وُشنیر کران۔
\v 55 کاہن سردار تہٕ یہُودؠ مجلسہ ہنٛدیو نفرو کٔر کوشش تِم لوٗکھ ژھانڈنؠ یِم یسوعؔ ہس متعلق اپُز ونہن تاکہِ تِم کرن رومی حاکمن تمِس قتل کرنہٕ خٲطرٕ مطمئن۔ تِم گےَ نہٕ کامیاب۔
\v 56 لوٗکن ہُنٛد اکؠ تعدادن ووٚن یسوعؔ ہس متعلق اپُز، پوٚز تِمن بیانن منٛز اوس نہٕ اکھ أکِس سٟتؠ ہشر۔
\v 57 ٲخرس پؠٹھ گےَ کینٛہہ لوٗکھ کھڑا تہٕ یسوعؔ ہس دِتُکھ یہِ ونان اپُز الزام،
\v 58 "اسہِ بوز ییٚلہِ تٔمؠ ووٚن، "بہٕ کرن یہِ ہیکل تباہ تکیازِ یہِ اوس انسانن تعمیٖر کوٚڑمُت، تہٕ پتہٕ ترٛیٚن دوہن منٛز کرٕ بہٕ بیاکھ ہیکل تعمیٖر کانٛسہِ ہنٛدِ مدتہٕ بغٲرے۔"
\v 59 پوٚز کینٛژن نفرن ہُنٛد ونن رَلیوو نہٕ باقین ہنٛدس وننس سٟتؠ۔
\v 60 پتہٕ ووٚتھ امیر کاہن تِمن برونٛہہ کنہِ تھود تہٕ ونُن یسوعؔ ہس، "یہِ ژےٚ ونمُت چُھتھ تتھ متعلق ونُکھ نہٕ کانٛہہ جواب؟ تتھ سارسے متعلق کیاہ چُھکھ ژِ ونان یمیُک الزام ژےٚ یم دِوان چھی؟"
\v 61 پوٚز یسوعؔ رود خاموش تہٕ دِتنُ نہٕ کانٛہہ جواب۔ امیر کاہنن کٔر دُبار بیٚیہِ کوشِش۔ تٔمؠ پرُوژھس، "کیاہ ژٕ چُھکھا مسیحؔ؟ کیاہ ژٕ چُھکھا ونان زِ ژٕ چُھکھ خدایہ سُنٛد گۅبُر؟"
\v 62 \f + \fr 14‏:62 \ft دانیال 7:13، زبُور 110:1\f*یسوعؔن ووٚن، "بہٕ چُھس تمہِ علاوٕ، توٚہؠ وُچِھو مےٚ، خدایہ سُنٛد گۅبُر، خدایس نکھٕ بادشٲہی کران، یُس مکمل طاقتور چُھ۔ توٚہؠ وچھِو مےٚ اوبرٕ منٛزؠ آسمانہٕ پؠٹھٕ بوٚن وسان۔
\v 63 یسوعؔ سنٛدین لفظن ہنٛدس جوابس، ژٔٹؠ امیٖرِ کاہنن احتجاجس منٛز پننؠ پؠٹھٕ لاگمٕتؠ پلو، تہٕ تٔمؠ امیر کاہنن ووٚن، "اسہِ چھنہٕ وُنؠ یقیٖنن یمِس نفرس خلاف امہ کھۅتہٕ زیادٕ گواہی ہنٛز ضرورت!
\v 64 \f + \fr 14‏:64 \ft احبار 24:16\f* توٚہہِ بوزیٚو امہِ سُنٛد خدا آسنُک کفرُک دعوا!" تِمو ساروٕے کوٚر اتفاق زِ یسوعؔ اوس قصور وار تہٕ یہِ چُھ واجب القتل۔
\v 65 تِمو منٛزٕ لاجہِ پتہٕ کینٛژو یسوعؔ ہس تھوٚکہٕ لاینہِ۔ تِمو دِیت تمِس أچھن تھوٚپ، تہٕ پتہٕ لاگؠ ہس چوب دِنؠ تہِ ٲسس ونان، "اگر ژٕ اکھ نبی چُھکھ، ٲسؠ ون ژٕ کمؠ لاییہِ ٹاس!" یمؠ یسوعؔ ہس رٲچھ ٲس تِمو لایہِ تمِس چپٲژ۔
\v 66 پطرسؔ ییٚلہِ امیٖرِ کاہن سنٛدِس گرکس آنٛگنس نیٚبرٕ کِنؠ اوس، کوٚریو منٛز آیہِ اکھ کوٚرہ یمہِ امیٖرِ کاہن سنٛدِ خٲطرٕ کٲم کرمژ ٲس، تمِس نِشہ۔
\v 67 ییٚلہِ تمہِ پطرسؔ نارس نکھٕ وُشنیر کران وُچھ، تمہِ گنڈ تسَ غوٗرٕ سان مدے۔ پتہٕ ووٚن تمہِ، "ژٕ تہِ اوسُکھ یسوعؔ ہس سٟتؠ آسان، یُس نفر ناصرتُک اوس!"
\v 68 مگر پطرسؔن کوٚر اِنکار یہِ ونان، مےٚ چُھنہٕ فکرِ ترٛان زِ ژٕ کس متعلق چھیٚکھ کتھ کران!" پتہ ژوٚل سُہ تتہِ آنٛگنہٕ کہِ دروازِ دوٗر تہٕ کۅکرن دِژ بانگ۔
\v 69 تمہِ نوکرانہِ وُچھ سُہ تتہِ تہٕ دُبارِ ووٚن تمہِ تِمن لوٗکن یم نکھے کھڑا ٲسؠ، "یہِ نفر اوس تمِس نفرس سٟتؠ یُس توٚہہ گرفتار کوٚڑمُت چھون۔"
\v 70 مگر تمہِ کوٚر بیٚیہِ اِنکار۔ کینٛہہ وقت گٔژھتھ، تِمو لوٗکو یِم کھڑا ٲسؠ ووٚن پطرسؔس بیٚیہِ، "یمہِ انٛدازٕ ژٕ ونان چُھکھ تہِ چُھ ہاوان زِ ژٕتہِ چُھکھ گلیل علاقکک۔ لہٰذا یہِ چُھ پوٚز زِ ژٕ چُھکھ تِمو نفرو منٛزٕ اکھ یُس یسوعؔ ہس سٟتؠ اوس!"
\v 71 پوٚز تمِس گوٚو تعجب، "بہٕ زانن نہٕ سُہ کینٛہہ یمِس نفرس متعلق توٚہہ کتھٕ کران چُھو! خدا برونٛہہ کنُ زانتھ چُھس بہٕ پوٚز ونان، سُہ دییہِ مےٚ سزا اگر بہٕ اپُز ونان آسہ!"
\v 72 تمی ساعتہٕ دِژ کۅکرن بیٚیہِ بانگ۔ پتہ پییٚہِ پطرسؔس سۅ کتھ یاد یوسہ یسوعؔن تمِس گوڈٕ وُنؠ مٕژ ٲس، "کۅکرٕ سنٛزِ دویٚمہِ بانگہِ برونٛہہ اوسُتھ ژےٚ ترٛیہِ لٹہِ اِنکار کوٚڑمُت زِ ژٕ زانکھ مےٚ۔ "ییٚلہِ پطرسسؔ احساس گوٚو زِ تٔمؠ کوٚر ترٛیہِ لٹہِ یسوعؔ ہس زاننَس اِنکار، سُہ گوٚو سیٹھاہ مایوٗس۔ پطرسنؔ ووٚد۔
\c 15
\p
\v 1 صبحس سیٹھاہ سُلہِ کاہن سردار سمکھیے یکجاہ یہُودؠ مجلسہ ہنٛدین باقیو نفرن سٟتؠ یہِ مشورٕ کرنہِ باپتھ زِ یسوعؔ ہس کتھٕ پٲٹھؠ کھالنَ تِم رومکس گورنرس برونٛہہ کنہِ راہ۔ تہنٛدیو رٲچھ درو کوٚر دُبارِ یسوعؔ نیٚن اتھن گنڈ۔ تِمو نیٚو سُہ پیلاطسؔ گورنر سُنٛد گرٕ۔
\v 2 پِیلاطسؔن پرُوژھ یسوعؔ ہس، "ژٕ چُھکھا ونان زِ سُہ چُھکھ یہُودینؔ ہُنٛد بادشاہ؟" یسوعؔن دِیت تمِس جواب، "ژٕ وونتھ پانے تہِ۔"
\v 3 پتہٕ کوٚر کاہن سردارو دعوا زِ یسوعؔن آسہ واریاہ خراب کامہ کرِمژٕ۔
\v 4 لہٰذا پِیلاطسؔن پرُوژھ تمِس دُبارِ، "ژٕ چھےُ ناہ کینٛہہ ونن؟ بوز یم چھِ ونان ژٕ کٟژٕ خراب کامہ چُھتھ کرِمژ!"
\v 5 پوٚز امہِ پتہٕ تہِ کھوٚت نہٕ یسوعؔ ہس قصور، تٔمؠ ووٚن نہٕ بیٚیہِ کینٛہہ۔ نتیجہِ دراو زِ پیلاطسؔ گوٚو پانہٕ سیٹھاہ حٲران۔
\v 6 وُنؠ اوس گورنر سُنٛد رِواج پریتھ وریہ عیدٕ قطیر مناونس دوران اکھ نفر قٲد منٛز یلہِ تراون۔ روایتہٕ مطابق اوس سُہ تمِس قٲدِس ییٚلہِ تراوان یمِس متعلق لوٗکو در خواست کوٚڑمُت آسہ ہے۔
\v 7 تمہِ وقتہٕ اوس اکھ براباسؔ ناوک نفر یُس سِپاہو اوس تروومُت باقیو نفرن سٟتؠ جیلس منٛز۔ تٔمؠ نفرن ٲسؠ رومی حکومتس خلاف بغاوٕتس دوران کینٛہہ سِپاہ قتل کٔرؠ متٕؠ۔
\v 8 لوٗکن ہُنٛد اکھ گرٛوٚو ووت پیلاطسؔ نِشہ تہٕ ونہس اکھ نفر ترٛاون یلہِ، یتھٕ پٲٹھؠ سُہ عیدِ قطیرکس موقس پؠٹھ روایژ مطابق کران اوس۔
\v 9 پِیلاطسؔن دیت تِمن جواب، "کیاہ توٚہؠ کٔرؠ وا پسند بہٕ ترٛاون سُہ نفرٕ یلہِ یمِس توٚہؠ یہُودؠ لوٗکھ ونان چُھو سُہ چُھ تُھنٛد بادشاہ؟"
\v 10 تٔمؠ ووٚن یہِ تکیازِ تمِس اوس فِکرِ توٚرمُت زِ یہُودؠ سردار کیاہ ٲسؠ یژھان کرن۔ تِم ٲسؠ یسوعؔ ہس حسدٕ سٟتؠ تُہمت لاگان تکیازِ واریاہ لوٗکھ ٲسؠ تمہِ سنٛدؠ شٲگرد بنان۔
\v 11 مگر کاہن سردارو کوٚر سُہ گرٛوٚو مجبور پیلاطسؔ عرض کرنہٕ باپتھ زِ یسوعؔنہِ بدلہٕ ترٛاون براباسؔ تِھنٛدِ باپتھ یلہِ۔
\v 12 پِیلاطسؔن ووٚن تِمن، دُبارِ، "اگر بہٕ براباسؔ، ترٛاون یلہِ، توٚہؠ کیاہ چُھو یژھان بہٕ کرِ تمِس نفرس سٟتؠ یمِس توٚہؠ یہُودؠ ونان چُھو سُہ چُھ تُہنٛد بادشاہ؟"
\v 13 پتہٕ دِژ تِمو کریکھٕ دُبارِ، "پنہِ نؠن سِپاہن دِیو حکم تمِس دارس کھالہِ نکُ!"
\v 14 پتہٕ ووٚن تِمن پِیلاطسنؔ، "کیازِ؟ تمؠ کُس جرم چُھ کوٚڑمُت؟" مگر تِمو دِژِ تمہِ کھۅتہٕ زورٕ کریکھٕ، "پنہ نؠن سِپاہن دِیو سُہ دارس کھالہٕ نکُ حکم!"
\v 15 تکیازِ پیلاطسؔ اوس یژھان لوٗکن ہنٛدس گرٛوٚوہس خوش کرن، توے تروو تٔمؠ براباسؔ تِھنٛدِ خٲطرٕ یلہِ۔ تنٛدیو سِپاہو ٲس یسوعؔ دالہِ کیو رَنٛدٕکو سٟتؠ کوڑٕ دِتؠ متؠ یمن منٛز ششتٟرک تہٕ اڑجن ہنٛدِ ٹُکرٕ دباؤتھ ٲسؠ، پتہٕ پیلاطسنؔ ووٚن سِپاہن نی ہنُ یسوعؔ تہٕ کھالِہ ہُن دارس۔
\v 16 پِیلاؔطسنؤ سِپاہو نیٚو یسوعؔ محلہٕ کس آنٛگنس منٛز یتہِ پیلاطسؔ بسان اوس۔ سۅ جاے ٲس حکومتُک مرکزی دفتر۔ پتہٕ کوٚر تِمو تٔمن سارِنے سِپاہن ہنٛز پلٹن حکم یس تتہِ تعینات ٲس۔
\v 17 تِم سِپاہ جمع گژھنہٕ پتہٕ، تِمو لاگؠ یسوعؔ ہس ووٚزُل جامہٕ۔ تِمو تھوٚو تسَ کٔلس پؠٹھ اکھ تاج یُس تِمو دوپھِ کنٛڈیو ھنٛزؤ کانؤ سٟتؠ ووٚنمُت اوس۔ تٔم چیٖز ٲسؠ تٔمؠ تمِس ٹھٹھٕ کرنہٕ سبؠٕ کران تٔمؠ ٲسؠ ٲکتھ پٲٹھؠ ونان زِ سُہ اوس تُہنٛد بادشاہ۔
\v 18 پتہٕ ٲسؠ تِم تمِس تتھٕ پٲٹھؠ سلام کران یتھٕ پٲٹھؠ تِم أکِس بادشاہس کرِہن، دُبارِ تمِس ٹھٹھٕ کرنہٕ خٲطرٕ ٲسؠ تِم ونان، "خوشی تمِس بادشاہ سٕنٛدِ خٲطرٕ یُس یہُودینؔ حکومت کران چُھ!"
\v 19 تِمؠ ٲسؠ تسنٛدس کلس بار بار گۅبہِ بٲنسہِ سٟتؠ ٹاس لایان، تہٕ تِمؠ ٲسؠ تمِس تھوٚکہٕ لایان۔ تِم ٲسؠ ٲکتھ پٲٹھؠ تمِس نمِتھ سٔجدٕ کران۔
\v 20 ییٚلہِ تِمو تمِس ٹھٹھٕ کٔرتھ سپدییہِ، تِمو کوٚر تمِس ووٚزُل جامہٕ نیٚبر۔ تمِس لاگؠ تِمو پننؠ پلو، تہٕ پتہٕ کوٚر تِمو سُہ شہرِ نیٚبر تاکہِ تمِس کھالن تِم دارس۔
\v 21 \f + \fr 15‏:21 \ft کرینی، شمٲلی افریقہکہِ ضلع کرِنیکا ہچؠ راجدٲنی۔ \f*یسوعؔن تُل پنن صلیب کمےٕ فٲصلِس۔ پتہ سمکھیوو تِمن اکھ شمعونؔ ناوٕک نفرٕ یُس کرینی شہرک اوس۔ سُہ اوس سکندرؔ تہٕ روفسؔ سُنٛد مول۔ سُہ اوس تمہِ وزِ شہرِ نیٚبرٕ پؠٹھٕ گرٕ کنُ پکان۔ تِمو سِپہَو کوٚر سُہ یسوعؔ سٕنٛدِ بدلہٕ صلیب تُلنہٕ خٲطرٕ مجبوٗر، تکیازِ یسوعؔ ہس یُس ازا ووتمُت اوس تمہِ سٟتؠ اوس سُہ کمزور گومت۔
\v 22 سِپہَو واتہٕ ناوؠ تِم دوٗنوےٕ أکِس جایہِ یتھ تِم گُلگتا ونان ٲسؠ۔ تمہِ ناوک مطلب چُھ، "کلہٕ کھاپرِن ہنٛز جاے۔"
\v 23 تِمو کرِ کوٗشش یسوعؔ ہس شراب دِنچ یتھ مُر دوا رل اوس، پوٚز تٔمؠ کوٚر یہِ چینس اِنکار۔
\v 24 \f + \fr 15‏:24 \ft زبُور 22:18\f*کینٛژو سِپاہو نیہ تمِس پلو۔ پتہٕ دِتہِس صلیبس کنُ کیٔلؠ۔ تمہِ پتہٕ بٲگرکھ پانہٕ وانؠ تسَنٛدٕ پلو شطرجہِ زَارک پٲٹھؠ۔ یہِ کوٚر تِمو امہِ سبہٕ کسَ کیاہ پلو ییہِ حصہٕ۔
\v 25 صبحچہِ نَو آسہ بجیمژٕ ییٚلہِ تِمو سُہ دارس کھول۔
\v 26 دارس پؠٹھٕ یسوعؔ سنٛدِس کلس پٹھؠ کِنؠ اوس اکھ نشانہٕ لگاوتِھ یتھ پؠٹھ کمؠ تام سُہ وجہ لیٚوکھمُت اوس زِ تم کیازِ ٲسؠ تمِس دارس کنُ کیٔل دوان۔ یہِ اوس لیکتھ، "یہُودینؔ ہُنٛد بادشاہ۔"
\v 27 تِمو کھالہِ بیٚیہِ زٕ قٲدٕ پھہہِ یمؠ ڈاکو ٲسؠ۔ تِمو دِیت أکِس یسوعؔ ہس دٔچِھنؠ کِنؠ تہٕ بیس کھووٕرؠ کِنؠ صلیبس پؠٹھ کٔیل۔
\v 28 \f + \fr 15‏:28 \ft یسعیاہؔ 53:12\f* تہٕ تمِس ڈاکوہن سٟتؠ صلیبس کھالنہٕ سٟتؠ کوٚر تِمو نوشتن منٛز بٲوتھ پوٗرٕ زِ، "تہٕ تٔمؠ گنٛزرن تمِس بدکارن منٛز۔
\v 29 \f + \fr 15‏:29 \ft زبُور 22:7، 109:25\f*وتہِ پکن وٲلؠ لوٗکھ ٲسؠ پننؠ اتھٕ ہلاوتھ تمِس زَلالت کران۔ تِمؠ ٲسؠ ونان، "ہوٕ! ژےٚ ونتھ زِ ژٕ کرہک ہیکل تباہ تہٕ ترٛؠن دوہن منٛز کرہن دُبارِ تعمیٖر۔
\v 30 اگر ژٕ تہِ ہیٚکہ ہکھ کرتھ، تیلہِ صلیبہٕ پؠٹھ بوٚن وسِتھ بچاو پنُن پان!"
\v 31 کاہن سردار تہٕ یہُودؠ قانون ہیٚچھناون وٲلؠ تہِ، ٲسؠ یژھان یسوعؔ ہس مذاق کرن۔ اوے ٲسؠ تِمؠ اکھ أکِس ونان، "لوٗکھ چھِ دعوا کران زِ أمؠ بچٲوؠ باقیو تکلیفو نِشہ، پوٚز پنُن پان ہیٚکہ نہٕ بچٲوتھ!"
\v 32 أمؠ کوٚر مسیحؔ آسنُک تہٕ اسرائیل کؠن لوٗکن ہُنٛد بادشاہ آسنُک دعوا۔ اگر أمؠ سنٛدؠ الفاظ پٔزؠ چھِ، أمِس پزِ صلیبہٕ پؠٹھٕ بوٚن وسن! پتہٕ کرو ٲسؠ أمِس پؠٹھ بھروسہٕ!" یمؠ زٕ نفر أمِس نکھٕ صلیبس پؠتھ ٲسؠ تِمو تہِ کرِ أمِس ملامت۔
\v 33 دُپہرس گییہِ سٲرؠ سےٕ ملکس منٛز انہِ گٹہٕ، تہٕ یہِ روز دُپہرس ترےٚ بجے تام۔
\v 34 ترےٚ بجۓ دِژ یسوعؔن کریکھ، "اِلاھِی، اِلاھِی، لماِ شَبقتانی؟" یمیُک مطلب چُھ، "میانہِ خدایہ، میانہِ خدایہ، ژےٚ کیازِ ترٛووتھس بہٕ؟"
\v 35 ییٚلہِ کینٛژو لوٗکو یمؠ تتہِ موجود ٲسؠ بوز، اِلاھیِ، تِمو سمجھ یہِ غلط تہٕ تِمو ووٚن، "بوٗزو! یہِ چُھ ایلیاہسؔ ناد لایان!"
\v 36 \f + \fr 15‏:36 \ft زبُور 69:21 \f*تِمو منٛز اکھ لاریوو تہٕ بۅرن اکِس سپنجس منٛز ژوک شراب۔ تٔمؠ تھوو یہِ بٲنٛس لورِ ہنٛدس تینٛتِس پؠٹھ، تہٕ پتہٕ یہ ہیٚور کُن رٹِتھ کٔرن کوشِش یسوعؔ ہس سُہ شراب چیاوناونہٕ خاطرٕ۔ ییٚلہِ سُہ تہِ کران اوس، کمؠ تام ووٚنس، "ٹھہر! أسؠ وُچھو ایلیاہؔ ما ییہِ أمِس دارٕ پؠٹھٕ بوٗن والنہِ!"
\v 37 تہٕ پتہٕ، یسوعؔن دِژٕ زورٕ کریکھ، تٔمؠ ٹھٔہرُوو شہٕ تہٕ دِتنُ زُو۔
\v 38 تمہِ وزِ ژھیوٚن سۅ ہیکل لک سارِوے کھۅتہٕ پاک جایہِ ہُنٛد گوٚب تہٕ موٗٹ پردٕ ہیرٕ پؠٹھٕ بوٗن تام تتھ گییہِ زٕ ٹُکرٕ۔
\v 39 سُہ افسر یُس تِمن سپہن ھُنٕٛز نگرأنی کران اوس یمو یسوعؔ صلیبس کھولمت اوس، اوس یسوعؔ ہس برونٛہہ کنہِ وۅدِنی۔ ییٚلہِ تٔمؠ وُچھ یسوعؔن کِتھٕ پٲٹھؠ دِیت زُو، تٔمؠ ووٚن حٲرتس منٛز، "یقیٖنن، یی خدایہ سُنٛد گۅبر یسوعؔ اوس!"
\v 40‏-41 تتہِ آسہ بیٚیہِ کینٛہہ زنانہٕ، دوٗرِ پؠٹھٕ وُچھان کیاہ سُپد۔ تِمو اوس یسوعؔ ہس ساتھ دِتمُت ییٚلہِ سُہ گلیل علاقس منٛز اوس، تہٕ تِمو اوس تمِس ضورورتک ہر کانٛہہ چیٖز دتمُت۔ تِمہ، تہٕ باقیو واریاہ زنانہٕ، آسہ تمِس سٟتؠ یروشلم شہرس منٛز آمژٕ۔ تِمن زنانن منٛز ٲس مریمؔ مگدلِینی قصبچ۔ تتہِ ٲس بیاکھ اکھ مریمؔ، یس لوکٹِس یعقوبؔ تہٕ یوسیسؔن موج ٲس۔ بیٚیہِ ٲس تتہِ سلومیؔ۔
\v 42‏-43 ییٚلہِ شام\f + \fr 15‏:42‏-43 \ft جمعہ دوٚہہ\f* سپدن وول اوس، یوسفؔ ناوُک اکھ نفر یُس ارِمتیہ قصبہٕ پؠٹھٕ آمُت اوس، آو تپٲرؠ۔ سُہ اوس یہُودؠ مجلسہِ ہُنٛد اکھ رُکن، یمِس ہر کانٛہہ یزتھ کران اوس۔ سُہ اوس تِمو منٛزٕ یم خدایہ سنٛز بادشٲہی شروٗع گژھنچ توقعہٕ سان انتظار کران ٲسؠ۔ سُہ اوس زانان زِ، یہودی شریعہٕ مطابق، اکھ نفر دفن کٔرن چُھ ضوروٗری یمہِ دوٚہہ سُہ شخص انتقال کرِ۔ تمِس گوٚو یہِ تہِ احساس زِ یہِ اوس تیٲری ھُند دوٚہہ، سُہ دوٚہہ ییٚلہِ لوٗکھ آسن یہُودؠ سبت دوٚہہ خٲطرٕ چیٖز تیار کران، تہٕ یہُودؠ سبتکُ دوٚہہ گژھے افتاب لوسنہٕ پؠٹھٕ شروٗع۔ وُنؠ اوس شام واتن وول۔ ہمتہٕ سان، گوٚو سُہ پیلاطسؔ نِشہ یسوعؔ سنٛز لاش پہہِ کوٹہِ پؠٹھ بوٗن والنس تہٕ، یہِ جلد دفن کرنُک اجازت منٛگنس۔
\v 44 پیلاطسؔ سُپد حٲران ییٚلہِ تم بوز زِ یسوعؔ اوس برٛونٹھے گُذریمت۔ لہٰذا بُلوو تٔمؠ سُہ افسر یُس تِمن سپہن ہُنٛد نگرانی کران اوس یمو یسوعؔ پھاسہِ کھولمت اوس، تہٕ پرُوژھن تِمن آیا یسوعؔ اوسا بروٛنٹھے گُذریمُت۔
\v 45 ییٚلہِ تٔمؠ افسرن ووٚن پیلاطسؔ زِ یسوعؔ اوس گُذریمت، پیلاطسؔن دیت یوسفسؔ لاش نِنُک اجازت۔
\v 46 یوسفنؔ اوس اکھ للن کپر ژادر مٔلؠ ہوتمت تمہِ پتہٕ، تٔمؠ تہٕ باقیو وٲج یسوعؔ سنٛز لاش پہہِ کوٹہِ پؠٹھ بوٗن۔ تِمو وول تتھ للن کپرٕ تہٕ ترٛوکُھ أکِس قبرِ منٛز یوسہ برٛونٹھے کنؠن منٛز کٔھنتھ ٲس۔ تہٕ قبر بنٛد کرنہٕ باپتھ أنِکھ اکھ بٔڑ پوتر کٔنؠ ڈٔلوان ڈٔولوان تہٕ تھاوکھ اتھ قبرِ بتھِ دِتھ۔
\v 47 مگدلِینچ مریمؔ تہٕ یوسیس سنٛز موج ٲس وُچھان تِمو کتھ جایہِ تھاو یسوعؔ سنٛز لاش۔
\c 16
\p
\v 1 بٹہٕ وارِ دوٚہہ شامن ییٚلہِ یہُودؠ سبتکُ دوٚہہ اند ووتمُت اوس، مگدلِینچ مریمؔن، یعقوبؔ سنٛزِ ماجہ تہٕ سلومیؔ ین ہوٗت مشکہٕ دار مرہم مٔلؠ یُس زنَ یسوعؔ سنٛدِس بدنس ملہٕ ہنَ۔ یمہٕ زنانہٕ آسہ یژھان دفن کرنکؠ یہُودؠ رسم پُوٗرٕ کرٕنؠ۔
\v 2 ہفتٕکہِ گوڈنکؠ دوٚہہ، آتھوارِ سیٹھاہ سُلہِ، افتاب کھسنہٕ وزِ، آیہِ تِم مقبرس پؠٹھ سۅ مُشکہٕ دار مرہم ہٮ۪تھ۔
\v 3 وتہِ وتہِ آسہ، تِم پانہٕ وٲنؠ أکِس اکھ ونان، "کسُ کرِ اسہِ مدد سۅ گوٚب کٔنؠ ڈُلناونس منٛز یوسہ مقبرس بتھِ چھِ؟"
\v 4 توٚت وٲتِتھ، تِمو وُچھ تہٕ سُپدؠ حٲران زِ کمؠ تام ٲس سۅ کٔنؠ ڈلُنٲومژٕ، تکیازِ سۅ ٲس سیٹھاہ بٔڈ۔
\v 5 تِم ژأیہِ مقبرس اندر تہٕ وُچُھکھ اکھ نوجوان نفر۔ تمِس ٲس سفید جامہٕ لٲگتھ تہٕ سُہ اوس گۅپھِ دٔچِھنؠ کنَ بہتھ۔ سۅ نظارٕ وُچِھتھ گوٚو تِمن خطرٕ پٲدٕ!
\v 6 تٔمؠ نوجوان نفرن ووٚن تِمن، "مہ کھوٗژو! مےٚ چھِ پتاہ توٚہؠ چُھو ہن یسوعؔ تلاش کران، سُہ ناصرت شہرک نفر یُس پھہہِ کوٗٹس کھالنہٕ آو۔ پوٚز سُہ گوٚو دُبارِ زندٕ! سُہ چُھ نہٕ یتہِ! وُچِھو! یہِ چھِ سۅ جاۓ یتہِ تِمو تس سنٛز لاش تھٲو۔
\v 7 یتہِ روزنہٕ بجایہ چُھ یہِ، پوٚز توٚہؠ گژھو تہٕ ونوِ تٔمؠ سنٛدین شٲگردن! خاص کٔرتھ، توٚہؠ وُنؠ زیوِ خُصوصن پطرسسؔ۔ تِمن ونیو، "یسوعؔ چُھ توٚہہ برونٛہہ برونٛہہ گلیل کس علاقس کنُ گٔژھان، تہٕ توٚہؠ وُچھوون سُہ تٔتی، یتھٕ کِنؠ زَن تٔمؠ توٚہہ برونٛٹھے ووٚنمت اوسو۔"
\v 8 تِمہٕ زنانہٕ درایہِ نیٚبر کنُ تہٕ مقبرٕ نِشہ ژجہِ۔ تِمن ٲس تھرٕ تھرِ تکیازِ تِمہٕ آسہٕ کھۅژان، تہٕ تِمہٕ گےَ حٲران۔ مگر تِمو ووٚن نہٕ کٲنٛسہِ اتھ متعلق، تکیازِ تِمہٕ آسہٕ کھۅژان۔
\v 9 \f + \fr 16‏:9 \ft آتھوارِ دوٚہہ۔ \f* ییٚلہِ یسوعؔ آتھوارِ دوٚہہ صبُٲۓ، ہفتٕکہِ گۅڈ نکہ دوٚہہ، دُبارِ زندٕ گوٚو، سُہ گوٚو مگدلِینچہِ مریمؔس سارنےٕ برونٛہہ نظرِ۔ سۅ ٲس سۅ زنان یمِس تٔمؠ ستہِ لٹہِ بد روح نیٚبر کٔڈیمتٕؠ ٲس۔
\v 10 سۅ گییہِ تِمن نِشہ یمؠ یسوعؔ ہس سٟتؠ ٲسؠ متؠ ٲسؠ، ییٚلہِ تِم ودان تہٕ رِوان ٲسؠ۔ تمہِ ووٚن تِمن یہِ تمہِ وُچھمُت اوس۔
\v 11 پوٚز ییٚلہِ تمہِ تِمن ووٚن زِ یسوعؔ سُپد دُبارِ زندٕ تہٕ یہِ زن تمہِ وُچھمُت اوس، تِمن آیہِ نہٕ پژھےٕ یہِ تمہِ ووٚن۔
\v 12 تمہِ دوٚہہ پتہٕ، یسوعؔ گوٚو پننیٚن دوٗن مریدن نظرِ یمؠ یروشلمہٕؔ پؠٹھٕ انٛدؠ پٔکؠ علاقن منٛز پنن گرٕ کنُ پکان ٲسؠ۔ تِمو پرزٕنوو نہٕ سُہ جلد تکیازِ سُہ اوس سیٹھاہ مختلف بوٗزنہٕ یوان۔
\v 13 تِمو ییٚلہِ سُہ پرزٕنوو تٔمؠ گییہِ یروشلم واپس۔ تِمو ووٚن باقین مریدن یہِ سپدمُت اوس، مگر تِمو کوٚر نہٕ تتھ پؠٹھ یقین یہِ تِمو بوز۔
\v 14 امہِ پتہٕ یسوعؔ گوٚو تِمن کٔہن شٲگردن نِشہ ظاہر ییٚلہِ تٔمؠ غذا کھیوان ٲسؠ۔ تٔمؠ کرٕ تِمن سخ ملامت، تکیازِ تِمو اوس تِمن خبرن پؠٹھ یقین کرنس سخ پٲٹھؠ اِنکار کوٚڑمُت یمو نفرو سُہ وُچھمُت اوس ییٚلہ سُہ دُبارِ زندٕ گومت اوس۔
\v 15 تٔمؠ ووٚن تِمن، "گٔژھو سٲرؠ سےٕ دُنیاہس منٛز تہٕ کرو پرٛتھ کُنہِ چیزُک پرٛتھ  کٲنسہِ نِش رژٕ شیچھِ ہُنٛد پرچار!
\v 16 خدایہ دییہِ ہرَ کانٛسہِ نجات یُس تُہنٛدس پٲغامس پؠٹھ یقین کرِ تہٕ یمِس بپتسمہ دنہِ ییہِ۔ پوٚز یُس نہٕ تُہنٛدس پٲغامس یقین کرِ خدایہ دییہِ تمِس سزا۔
\v 17 یِم رٕژ شیچھِ پؠٹھ یقین کرن تم ہاون معجزٕ۔ خاص پٲٹھؠ، تِم کٔڈن لوٗکن منٛز بد روح میٚانہِ طاقتہٕ سٟتؠ نیٚبر۔ تِم بولن تِم زبانہ یِم نہٕ تِمو ہیٚچھٕ مژے آسن۔
\v 18 اگر تِم اکھ سرف تُلن یا تِم چؠن کانٛہہ آب یتھ زہر آسہ، تِمن واتہِ نہٕ کانٛہہ نۅقصان۔ خدایہ کرِ تِمن بیمار لوٗکن شفأ یِمن تِمؠ اتھٕ ڈالن۔"
\v 19 \f + \fr 16‏:19 \ft پطرس 1۔ 3:22 \f* خداوند یسوعؔن پنہٕ نین شٲگردن سٟتؠ یہِ کالامہٕ کرنہٕ پتہٕ، خداین نیٚو سُہ ہؠوٗر آسمانس منٛز۔ پتہٕ بیوٗٹھ سُہ پننِس تختس خدایس دٔچِھنؠ کنِؠ، یس یزتچ سارِوۓ کھوٗتہٕ تھزٕ جاے چھِ، تمِس سٟتؠ بادشٲہی کرنہِ۔
\v 20 یوٚت تام زَن شٲگردن ہُنٛد تعلق اوس، تِم گییہِ یروشلمہٕؔ نیٚبر، تہٕ کوٚرکھ پرٛتھ جایہ پرچار۔ ییٚلہِ تہِ تِم گییہِ، خداوند یسوعؔن کوٚر تِمن معجزٕ ہاونس منٛز مدد۔ یہِ کرنہٕ سٟتؠ، ہوو تٔمؠ لوٗکن زِ خدایہ سُنٛد پٲغام چُھ پوٚز۔
