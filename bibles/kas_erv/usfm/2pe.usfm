\id 2PE - DMT Kashmiri
\toc1 2 پطرس
\mt1 2 پطرس
\c 1
\p
\v 1 بہٕ، شمعون پطرس، چُھس یسوع مسیحؔ سنٛز خدمت کران، تہٕ تسُنٛد مقرر کرنہٕ آمُت رسول۔ بہٕ چُھس یہِ نامہٕ لیٚکھان توٚہہِ یِم خداین بنٲوؠ مسیحؔ ہس پٮ۪ٹھ ایمان تھاون وٲلؠ یتھٕ پٲٹھؠ تٔمؠ أسؠ رسول ایمان تھاون وٲلؠ بنٲوؠ مسیحؔ ہس پٮ۪ٹھ۔ یسوعنؔ بنوو یہِ ممکن پننہِ پزَ عملہِ کِنؠ۔ یسوع مسیحؔ چُھ سون خدا تہٕ سُے چُھ اسہِ نجات دِنہٕ وول۔
\v 2 بہٕ چُھس خدایس دعا منٛگان زِ سُہ ہُررٲوِنؠ پنٕنؠ رحمتٕچ عمل توٚہہِ کُن تہٕ تھٲوِنو زیادٕ کھۅتہٕ زیادٕ امنہٕ سان اوٕ کِنؠ زِ توٚہؠ چُھو زانان خدایس تہٕ یسوعس یُس سون خداوند چُھ۔
\v 3 خداین چُھ اسہِ بخُشمُت تہِ سورےٕ یہِ اسہِ تسنٛدِس عزتس لایق زندگی گزارنہٕ باپتھ ضروری چُھ۔ تٔمؠ کوٚر یہِ بحثیتہِ خدا پننہِ قدرتہٕ سٟتؠ۔ تٔمؠ کوٚر یہِ تمہِ سٟتؠ یہِ أسؠ تمِس متعلق زانان چھِ۔ اسہِ چُھ ژاران خدا پننیٚو لوٗکو کِنؠ پننہِ پرٮ۪زلونہِ تہٕ عظیم قوتہٕ کِنؠ۔
\v 4 پننہِ پرٮ۪زلونہِ تہٕ عظیم قوتہٕ سٟتؠ، چُھ خداین اسہِ پنُن وعدٕ دیُتمُت زِ سُہ انہِ سانہِ باپتھ مۅلہٕ ونہِ تہٕ عظیم کامہِ بارسس۔ تٔمؠ کوٚر یہِ، تاکہِ تسنٛدِس وعدس پٮ۪ٹھ پژھ تھٲوِتھ کٔرِو توٚہؠ تہِ خدایہِ سٕنٛدؠ پٲٹھؠ عمل۔ تہٕ کُنہِ اخلٲقی وٮ۪کھژارس منٛز یِیو نہٕ ہٮ۪نہٕ۔ یہِ زن یتھ دنیاہس منٛز گناہ کرنچہِ کُنہِ غلط خٲہشہِ کِنؠ وۅپدان چُھ۔
\v 5 اوٕ کِنؠ زِ خداین کوٚر یہِ سورےٕ، توٕ کِنؠ تھٲیو نہ صرف پوٗرِ پوٗر پژھ مسیحؔ ہس پٮ۪ٹھ بلکہِ کٔرِو رٕژ عمل تہِ۔ تہٕ بنٲیو نہ صرف یہِ کتھ یقینی زِ توٚہؠ کٔرِو رژٕ عملہٕ بلکہِ کٔرِو خدایس متعلق ژوٚر ژوٚر زاننچ کوشش تہِ۔
\v 6 تہٕ سٟتؠ بنٲیو یہِ کتھ یقینی زِ توٚہؠ کٔرِو نہٕ صرف خدایس متعلق ژوٚر ژوٚر علم پراونُک ژھل بل، بلکہِ رٔٹِو پنٕنؠ عمل تہٕ کتھ تہِ کاپہِ۔ تہٕ سٟتی روزیٚو مشکلاتو باوجود خدایس سنٛدؠ وفادار۔ تہٕ یِتہِ بنٲیو یقینی زِ توٚہؠ رٔٹِو نہٕ صرف پنٕنؠ عمل تہٕ کتھ تہِ کاپہِ بلکہِ روزیٚو خدایس وفادار پننٮ۪ن مشکِلاتن منٛز، تہٕ یِتہِ بنٲیو یقینی زِ توٚہؠ روزیٚو نہٕ خدایس وفادار پننٮ۪ن مشکِلاتن منٛز بلکہِ کٔرِو خدایہِ سُنٛد عزت تہِ۔
\v 7 تہٕ یقینی بنٲیو زِ توٚہؠ کٔرِو نہ صرف خدایہِ سُنٛد عزت بلکہِ بڑٲیو اکھ أکؠ سُنٛد سریہہ تہِ زنتہِ اکے خاندانٕکؠ فرد ٲسِو۔ تہٕ یقینی بنٲیو اکھ أکؠ سنٛدِ باپتھ نہ صرف پنن سریہہ زنتہٕ اکی ٹبرٕکؠ فرد ٲسِو بلکہِ بٔرِو باقین لول تہِ۔
\v 8 یہِ سورےٕ کریٚو تکیازِ یوٚدوے توٚہؠ یہِ کینٛژھا ژوٚر ژوٚر کرِیٚو، توٚہؠ بٔنیٚو زیادٕ کھۅتہٕ زیادٕ سٲنِس خداوند یسوع مسیحؔ ہس زاننس منٛز وۅپدایک۔
\v 9 یہِ سورےٕ کٔرِو تکیازِ یُس نفر یہِ سورےٕ کرِ نہٕ چُھنہٕ خبردار زِ یِم چیز چھِ اہم۔ یُتھ انسان چُھ زنتہٕ اوٚن یُس پنُن اونٛد پوٚک وُچھتھےٕ ہیٚکہِ نہٕ، یا اکھ کمزور نظرِ وول یُس چھرا نکھہٕ چیزے یٲتؠ وُچِھتھ ہیٚکہِ۔ یِتھِس انسانس چُھ یِتہِ مٔشِتھ گوٚمُت آسان زِ خداین کٔرؠ امسنٛدؠ کٲتؠ پتھ کالہِ کٔرؠ مٕتؠ گناہ معاف۔
\v 10 اوے کِنؠ، میانیو ایماندار سٲتھیو، زیادٕ زیادٕ ژھل بل کٔرِو یہِ یقینی بناونہٕ باپتھ زِ خداین کیا چُھو توٚہؠ ژٲرؠ مٕتؠ پنٕنؠ لوٗکھ۔ یوٚدوے توٚہؠ یہِ سورےٕ کٔرِو یہِ مےٚ توٚہہِ وُنؠ وُنؠ ووٚن، توٚہؠ سپدِیو نہٕ زانہٛہ تہِ پننِس خدایس نِش ژھٮ۪نہٕ۔
\v 11 یہِ چُھ پوٚز تکیازِ تہنٛدِ یہِ کرنہٕ سٟتؠ دِیو خدا توٚہہِ کھُلہٕ دِلہٕ تتھ جایہِ اژنہٕ یٮ۪تہِ لوٗکن پٮ۪ٹھ پوشوٕنؠ حکومت آسہ نجات دِنہٕ وٲلِس خداوند یسوع مسیحؔ سنٛز۔
\v 12 اوے کِنؠ، تکیازِ یِم چیز چھِ ضروری، چُھس بہٕ توٚہہِ لگؠ تھےٕ امہِ سارِچ ون ون کران روزان۔ بہٕ روزٕ توٚہہِ ون ون کران روزان یوٚدوے زن توٚہؠ یہِ سورےٕ زانان تہِ ٲسِو تہٕ پزِ تعلیمہ پٮ۪ٹھ پوٗرٕ دٔرِتھ تہِ ٲسِو۔
\v 13 وۅنؠ گو بہٕ چُھس توٚہہِ یہِ کرنہٕ باپتھ ون ون کرٕنؠ پنُن فرض زانان یِمن چیزن متعلق ییتِس کالس تہِ بہٕ زنٛدٕ چُھس۔
\v 14 بہٕ چُھس توٚہہِ یِم چیز کِنؠ یاد پاوٕنؠ یژھان تکیازِ بہٕ چُھس زانان زِ مےٚ آسہ ؤلؠ مرُن۔ بہٕ مرٕ یتھٕ کِنؠ زن خداوند یسوع مسیحؔ ہن برونٛہےٕ مےٚ پٮ۪ٹھ ظٲہِر کوٚر۔
\v 15 امہِ ہُریمانہٕ، روزٕ بہٕ پوٗرٕ کوشش کران پننیٚو یِمو لِکھو سٟتؠ پننہِ مرنہٕ پتہٕ تہِ یِمہٕ کتھہٕ توٚہہِ یاد پاوان۔
\v 16 بہٕ کرٕ یہِ اوٕ کِنؠ، زِ ییٚلہِ أسؠ رسول توٚہہِ سٲنِس خداوند یسوع مسیحؔ سُنٛد دُبارٕ کُنہِ دوٚہہ اقتدارس منٛز یِنُک ونان ٲسؠ، أسؠ ٲسؠ نہٕ توٚہہِ پٲنؠ پانے وننہٕ آمژن کتھن ہنٛدِس بنیادس پٮ۪ٹھ یہِ ونان۔ بلکہِ ووٚن تہِ یہِ اسہِ وُچھ پننیٚو أچھو دیدمان، خدٲیی عظمت وول یسوع۔
\v 17 بہٕ ہیٚکہٕ ؤنِتھ أسؠ ٲسؠ گواہ تکیازِ أسؠ ٲسؠ تٔتی ییٚلہِ بب خداین تس عزت تہٕ عظمت بخٕش، ییٚلہِ یسوعنؔ بوز عظیم پُرنوٗر خدایہِ سنٛز آواز۔ تہٕ امہِ آوازِ ووٚن، "یہِ چُھ میون گۅبُر، یمِس بہٕ سٮ۪ٹھا لول بران چُھس۔ بہٕ چُھس أمِس سٮ۪ٹھا خوش۔"
\v 18 خدایہِ سٕنٛدِ طرفہٕ یہِ آسمانو پٮ۪ٹھٕ یِنہٕ واجِنؠ آواز بوز اسہِ تہِ ییٚلہِ أسؠ یسوعسؔ سٟتؠ تتھ مقدس بالس پٮ۪ٹھ أسؠ۔
\v 19 تہٕ اسہِ نِش چُھ تتہِ یہِ نبیو اوس لیٚوکھمُت برونٛہےٕ، یہِ زن سورےٕ پوٚز چُھ۔ یہِ تِمو لیٚوکھ تتھ دِیو دھیان، تکیازِ یہِ زٲنتو اکھ ژونگ یُس انہِ گٹہِ زوتان چُھ یُس لوٗکن پنٕنؠ وتھ ہاونس منٛز مدد چُھ کران۔ یہِ ژونٛگ روزِ دزٕوُن تتھ دوٚہس تام یوٚتام مسیحؔ سٕنٛدِ یِنُک گاش پھۅلہِ صبحک تارکھ دییہِ تُہنٛدِس دماغس بہتر سمجھ۔
\v 20 امہِ سٲرے گٔژھِتھ، پزِ توٚہہِ زانُن زِ کانٛہہ تہِ نبی ہیٚکہِ نہٕ پننہِ خیالہٕ تعبیر کٔرِتھ۔
\v 21 یہِ چُھ پزر تکیازِ کٲنٛسہِ تہِ ہیٚچھؠ نہٕ زانٛہہ تہِ کانٛہہ پٔز پیش گویی کٔرِتھ انسٲنؠ منٛگہِ مطٲبق۔ اتھ برعکس، تِمو یِمو خدایہِ سنٛدِ طرفہٕ پیش گویی کرِ تِمن رود ہدایت دِنس پانہٕ پاک روح۔
\c 2
\p
\v 1 مگر اسرائیل ین منٛز ٲسؠ خدٲیی پٲغام واتنُک اپزُے دعوا کرن وٲلؠ تہِ۔ یِتھے پٲٹھؠ ہیٚکن توٚہہِ منٛزٕ اپُز تعلیم دِنہٕ وٲلؠ تہِ ٲسِتھ۔ تِم تراون توٚہہِ منٛز تِم بدعت یِمو باپتھ پوشہٕ وُن سزا آسہ۔ یِتھؠ لوٗکھ کرن پننس مٲلکس یسوعسؔ مسیحس تہِ انکار، یمؠ یِم لوٗکھ بوٚٹھ لٲگؠ۔ امیُک تر آسہ یہِ زِ خدا کرِ تِمن ہمیشہٕ ہمیشہٕ باپتھ رسوا۔
\v 2 تہٕ واریاہ لوٗکھ کرن یِتھے پٲٹھؠ یِمن اپزٮ۪ن وۅستادن ہنٛدؠ پٲٹھؠ بے گنٛڈ کار۔ یِمن اپزؠ یارٮ۪ن وۅستادن ہنٛدِ سببہٕ ونن بے دین لوٗکھ مسیحؔ یتس بدرد۔
\v 3 تہٕ پننہِ انٛدرمہِ بیٚچھِ گی کِنؠ کرن یِم اپزؠ یٲرؠ وۅستاد توٚہہِ اپُز ؤنؠ ؤنؠ ماوضہ وصول۔ خداین کٔرؠ یِم سٮ۪ٹھا برونٛہہ رسوا تہٕ خدا کرِ یِمن بے شک بُرباد۔
\v 4 یہِ عدالت لگہ ضرور تکیازِ خداین ترٲوؠ نہٕ سزا ورٲے اتُر کرن وٲلؠ فرشتہٕ تہِ۔ بلکہِ بٔرِن جہنمس یتہِ تِم ہانکلو سٟتؠ انہِ گٔٹِس منٛز گنٛڈِتھ چھِ۔ خداین بنٲوؠ یِم گناہ گار فرشتہٕ بٲنٛدؠ اتی تاکہِ تِمن لگہ عدالت۔
\v 5 خداین ترٲوؠ نہٕ سٮ۪ٹھا پتھ کالہِ دنیاہس منٛز بسن وٲلؠ لوٗکھ تہِ سزا ورٲے۔ وۅنؠ گو تٔمؠ ترٲوؠ مُچھِ ٲٹھ نفر یِمن منٛز راستبٲزی ہُنٛد تلقین کرن وول نوح تہِ اوس، ییٚلہِ تٔمؠ خداین بے ایمان لوٗکھ یِم تمہِ وقتہٕ دنیہس منٛز بسان ٲسؠ سٲلابہٕ بُزؠ کٔرؠ۔
\v 6 خداین کٔرؠ سدومؔ تہٕ عمورہ نٲوؠ شہر سزا دِتھ نارٕ بُزؠ تہٕ مکمل پٲٹھؠ کوٚرنکھ سوٗر۔ خداین بنٲوؠ یتھٕ پٲٹھؠ یِم شہر خدا سنٛز نافرمٲنی کرن والیٚن ہنٛدِ باپتھ مثال۔
\v 7 خداین بخُش لوٗطس نجات یُس راستباز اوس۔ لوٗط اوس سٮ۪ٹھہے پریشان، لوٗکن ہنٛدیٚو بے گنٛڈ بد اخلاق کارو کِنؠ یِم سدومس منٛز لاقانونیت پھہلاوان ٲسؠ۔
\v 8 ییٚلہِ سُہ یِمن بدکار تہٕ بدخواہ لوٗکن سٟتؠ سدومؔ شہرس منٛز روزان اوس۔ سُہ راستباز نفر لوٗط اوس پرٮ۪تھ دوٚہہ تُہنٛد وُچھان تہٕ بوزان پریشان روزان۔ تٔمؠ کوٚر یہِ اوٕ کِنؠ زِ لوٗکھ یہِ کران کراوان ٲسؠ تہِ اوس سیٚودے خدا سنٛدِس شریعتس خلاف۔
\v 9 یوٚدوے یِم سٲری چیز پٔزؠ چھِ، تیٚلہِ پزِ توٚہہِ یقین تھاوُن زِ خداوند چُھ زانان زِ تِم لوٗکھ کِتھہٕ پٲٹھؠ چھِ کُنہِ تہِ سزا نِشہ بچاوٕنؠ یِم تس عزت دِن۔ تہٕ خداوند چُھ یِتہِ زانان زِ تِم لوٗکھ کِتھہٕ پٲٹھؠ تھٲوِکھ تیار بہ تیار سزا باپتھ ییٚلہِ عدالت لاگنُک وق واتہِ یِمن بدکار لوٗکن۔
\v 10 تہٕ سُہِ دِیہ سزا خاص پٲٹھؠ تِمن لوٗکن یِم لٔگؠ تھےٕ تِم کار کران روزن یہ تِمن پنُن گناہ گار دِل ونہِ، تِم کار یِم خدایس ناپسند چھِ۔ یِم لوٗکھ چھِ خدٲیی حکمن تہِ توہین کران۔ یِم کٲتیاہ دلیر چھِ! یِمن یہِ دِل یژھِ یِم چھِ تی کران! یِم چھِنہٕ خدا سنٛدٮ۪ن شاندار فرشتن تہِ توہین کرنس پژان۔
\v 11 وۅنؠ گو خدا سٕنٛدؠ فرشتہٕ یوٚدوے یِمو لوٗکو کھۅتہٕ زیادٕ قوت وٲلؠ چھِ، چھِنہٕ تِم خدایس برونٛہہ کنہِ پرٮ۪زلوٕنٮ۪ن زٲژن نس تالہِ لٔدِتھ کانٛہہ راہ کھالان۔
\v 12 وۅنؠ گو، یِم اپٕزؠ وۅستاد چھِ زٲنتو چاروٲے یِم بے عقل چھِ۔ یمہِ آیہِ یِم چاروٲے قدرتی طور وتھٕ ژھانٹھ کران چھِ، یِم سپدؠ پٲدٕ توٕکِنؠ زِ یِم یِن باقیو دٔسؠ رٹنہٕ تہٕ مارنہٕ۔ یِم چھِ تِمن چیزن متعلق بدرد ونان یِمن متعلق نہٕ یِم کہین زانان چھِ۔ خدا کرِ یِمن بُرباد ییٚلہِ یہنٛزِ بُربٲدی ہُنٛد وق واتہِ۔
\v 13 یِمن اپزٮ۪ن وۅستادن آسہ مصیبت تُلُن پننیٚو کوٕ کارن ہنٛدیٚو منٲسب سزہو کِنؠ۔ یِم چھِ پنٕنؠ بداخلاقی عیٲشی دوٚہلہ تہِ مناوان آسان۔ پلون پٮ۪ٹھ کُنہِ بدنُما داغٕکؠ پٲٹھؠ چھِ یِم تہندٮ۪ن سمکھن جاین منٛز زلالتہٕ بٔرِتھ آسان! یِم چھِ توٚہہِ سٟتؠ کھیٚوان چیٚوان تہٕ پننٮ۪ن کۅ کارن پٮ۪ٹھ تھیٚکان روزان۔
\v 14 یِم یس زنانہِ تہِ وچُھن تس سٟتؠ چھِ یِم غٲر اخلٲقی جنسی تعلقات قٲیِم کرٕنؠ یژھان۔ یِم چھِنہٕ گناہ کرٕنؠ رُکاوِتھ ہیٚکان۔ یِم چھِ روحٲنی طور لیٚژٮ۪ن لوٗکن گناہ کرنس کُن رٲغب کران۔ یتھٕ پٲٹھؠ کھِلٲڑؠ کُنہِ کھیٚلہِ باپتھ تیار چھِ کرنہٕ یِوان، تِتھے پٲٹھؠ چھِ یِم اپٕزؠ وۅستاد پنُن پان لالچہِ باپتھ تیار کران۔ خداین چھےٚ یِمن لعنت سوزمٕژ!
\v 15 یِم چھِ خدایہِ سنٛزِ یژھایہِ مطٲبق زنٛدٕ روزنس نکار کران۔ یِم چھِ کمین گی سان عمل کران۔ یِم چھِ بعورؔ سنٛدِس نیٚچوِس بلعامسؔ پتہٕ پتہٕ پکان، پتھ کالہِ تسنٛدِ کرنہٕ کراونُک نقل کٔرِتھ۔ سُہ اوس پننٮ۪ن کۅ کارن باپتھ پونٛسہٕ رنگؠ ماوضہٕ رٹُن پسنٛد کران۔
\v 16 وۅنؠ گو خداین کوٚر سُہ دفع اسرائیل ین خلاف کۅ کار کرنہٕ کِنؠ۔ یوٚدوے زن خَر کتھہٕ چھِنہٕ کران، خداین کرنوو بلعام سُنٛد خَر انسٲنؠ بولہِ منٛز کتھہٕ کرنٲوِتھ امسٕنٛدؠ کۅ کار بند۔
\v 17 یِم اپٕزؠ وۅستاد چھِ فضول، تِمن ناگن ہنٛدؠ پٲٹھؠ یِمن آبےٕ ہوٚکھمُت چُھ۔ یِم چھِ زنتہٕ تِم اۅبرٕ لنٛگ یِمن واوٕ طوفان دوٗر چھکان چُھ امہِ برونٛہہ زِ یِم تراون روٗد۔ خداین چُھ مخصوس کوٚرمُت جہنمُک انہِ گوٚٹ یہنٛدِ باپتھ۔
\v 18 یہِ چُھ پوٚز تکیازِ تِم چھِ لوٗکن گناہ کرنہٕ باپتھ قٲیل کران یم حالےٕ ایمان وٲلؠ چھِ بنیمٕتؠ تہٕ کوٚرکھ یہٕ کرُن بند یہِ کمین بے ایمان لوٗکھ چھِ کران۔ یِم اپٕزؠ وۅستاد چھِ یہ کران تھیکنیل لفظ ورتٲوِتھ یِمن نہٕ کانٛہہ مۅل چُھ۔ یِم چھِ یمن لوٗکن کتھو سٟتؠ بیرِ والان۔ یہِ کینژھا تہِ گناہ گار فطرت کرناوُن یژھِ۔
\v 19 تِم چھِ یہِ کران پننٮ۪ن بوزن والیٚن یہِ ؤنِتھ تہِ زِ تِم چھِ آزاد پننہِ یژھایہِ مطٲبق کینٛہہ تہِ کرنہٕ باپتھ۔ أتھؠ وقتس دوران، چھِ یِمن پننہِ گناہ گار خوٲہشہٕ پنٕنؠ غلام بنٲوِتھ یِمہٕ یِمن برباد کرن۔ یہِ چُھ پزر تکیازِ یِم چیز کٲنٛسہِ انسانس پننس قبضس تل رٹن تِمے چیز چھِ تس پنُن غلام بنٲوِتھ پکناوان۔
\v 20 یوٚدوے یِتھیٚو لوٗکو زانہٛہ کٲلؠ تِژھٕ یچھِ کامہِ کرنہِ تراوِمژٕ آسن تہٕ یِم انسٲنی سماجس گنٛڈ تُلن تس یسوع مسیحؔ ہس زٲنِتھ یُس اسہِ پٮ۪ٹھ راج تاج کران چُھ تہٕ اسہِ نجات بخشان چُھ۔ مگر تِم گنٛدٕ تہٕ ذہن اولودٕ کرن وٲلؠ چیز چِھکھ بیٚیہِ ولان تہٕ قبضس تل انان۔ یتھٕ پٲٹھؠ چُھ یہُنٛد ازکال پتمہِ کھۅتہٕ تہِ بدتر گژھان۔
\v 21 یہِ چُھ اوٕ کِنؠ تکیازِ یہِ روزِہے یہنٛدِ باپتھ بہتر یوٚدوے تِمو خدایہِ سنٛزِ پسنٛد مطٲبق زُوون زونمُت آسہ ہے نہٕ یمہِ بدلہٕ زِ خدایہِ سٕنٛدؠ مقدس حکم یِم تسٕنٛدیو رسولو یِم ہیچھنٲوؠ کِتھہٕ پٲٹھؠ کرو رد۔
\v 22 یہ چُھ اکھ پوٚز ونِیوٚت یُس یہِ باوان چُھ زِ یِمن اپزٮ۪ن وۅستادن کیا بنیاو: "تِم چھِ زنتہٕ ہوٗنؠ یِم پنٕنؠ درۅکھ کھیٚنہِ واپس پھیران چھِ" تہٕ "تِم چھِ زنتہٕ سوٗر یِمو پنُن پان چھوٚل تہٕ دِتِکھ ربہِ منٛز ڈۅلٕنؠ۔"
\c 3
\p
\v 1 ایماندار سٲتھیو یِمن بہٕ لول بران چُھس، یہِ نامہٕ یُس بہٕ توٚہہِ وۅنؠ لیٚکھان چُھس چُھ میون دوٚیِم نامہٕ یُس مےٚ توٚہہِ لیٚوکھ۔ مےٚ لیٚکھؠ یِم دوٚنوے نامہٕ توٚہہِ ژٮ۪تس پاونہٕ باپتھ تِم چیز یِم تُہنٛد خلوص وول دماغ برونٛٹھےٕ زانان چُھ۔
\v 2 مےٚ لیٚکھؠ یِم نامہٕ توٚہہِ ژٮ۪تس پاونہٕ باپتھ تِم زنوانہٕ یِم پاک نبیو برونٛٹھے کرِمژٕ چھےٚ۔ بہٕ چُھس سٟتی یِتہِ یژھان توٚہہِ ژٮ۪تس پاوُن یہِ اسہِ پٮ۪ٹھ راج تاج کرن وٲلؠ تہٕ اسہِ نجات بخشن وٲلؠ توٚہہِ حکم کوٚرُو پننیٚو رسولو ہنٛزِ تعلیمہ سٟتؠ یِم اسہِ توٚہہِ کُن سوزؠ۔
\v 3 یہِ زانُن چُھ تُہنٛدِ باپتھ اہم زِ ٹھٹھٕ مذاق کرن وٲلؠ کرن ٹھٹھٕ مذاق یسوع سنٛدِس دُبارٕ یِنس تتھ وقتس دوران یُس یسوعؔ سنٛدِس یِنس نکھہٕ آسہ۔ تِم لوٗکھ روزن کران یہِ کینژھا تِم یژھن۔
\v 4 یِم مسخر ونن، "یسوعؔ سنٛدِ ینُک وعدٕ چُھ ٹَر۔ أسؠ چھِ یہِ زانان تکیازِ ینہٕ اسرائیل ین ہنٛدؠ جد مودؠ، تنہٕ بدلیو نہٕ کہین۔ ینہٕ خداین یہِ دنیا بنوو تنہٕ چُھ تی چلان!"
\v 5 تِم ونن یہِ تکیازِ تِم چھِ زٲنِتھ مٲنِتھ یہِ کتھ مشراوان زِ خداین أنؠ وجودس آسمان سٮ۪ٹھا کالہٕ برونٛہہ پننہِ حکمہٕ سٟتؠ، تہٕ تٔمؠ أنؠ زمین آبہٕ منٛزٕ وجودس تہٕ کھٲجِن ہیٚور اتھ یہِ بننُک حکم کٔرِتھ۔
\v 6 تہٕ خداین کوٚر پننہِ حکمہٕ تہٕ آبہٕ سٟتؠ تمہِ وقتہٕ موجود دنیا بُرباد۔ تٔمؠ کوٚر یہ زمینہِ آبہٕ یُپ أنِتھ۔
\v 7 وۅنؠ گو خداین کٔر پننہِ امی حکمہٕ دۅشوے زمین تہٕ آسمان بیوٚن بیوٚن یِم وۅنؠ نارٕ باپتھ موجود چھِ۔ خدا چُھ یِمن کُنہِ وقتہٕ باپتھ تھٲوِتھ ییٚلہِ سُہ عدالت لاگہِ تہٕ کمین گی کرن والیٚن برباد کرِ۔
\v 8 ایماندار سٲتھیو یِمن بہٕ لول بران چُھس، یہِ اکھ پزر مہٕ مشرٲیو: خدایہِ سنٛدِس حوالس منٛز چھنہٕ ژھوٚٹ کال زیٹھِ کالہٕ نِشہ بدون کینٛہہ۔
\v 9 خداوند چُھنہٕ لۅتہِ لۅتہِ یسوعؔ سنٛدِ واپس یِنُک وعدٕ پوٗرٕ کران۔ کینژن لوٗکن ہُنٛد چُھ یی خیال۔ امہِ بجایہ چُھ خدا توٚہہِ سٟتؠ صٲبر، تکیازِ سُہ چُھنہٕ یژھان زِ توٚہہِ منٛز کٲنٛسہِ تہِ میلہِ ہمیشہٕ ہمیشہٕ باپتھ سزا۔ بلکہِ چُھ یژھان سارنےٕ ہُنٛد توبہٕ کرُن۔
\v 10 یِمن ٹھٹھٕ کرن والیٚن ہنٛدِس وننس بجایہ واتہِ خداوند سنٛدِ یِنُک وق اچانک۔ تٔمہِ وقتہٕ وۅتھہِ تھدِ شور آسمانن راوِ آسنُے۔ خدا زالہِ نار پرٮ۪تھ فطری چیزٕکؠ ژکہِ عنصر۔ پتہٕ کر خدا زمین ظٲہر تہٕ تہِ سورےٕ یہِ اتھ منٛز بناونہٕ آمُت آسہ۔
\v 11 اوٕ کِنؠ زِ خدا کرِ فناہ یِم سٲری چیز یہُنٛد مےٚ وُنؠ وُنؠ ذِکر کوٚر یمہِ آیہِ مےٚ ذکر کوٚر، توٚہہِ پزِ بڈٕ راستبٲزی سان ویوہار کرُن تہٕ تہِ کرُن یہِ خدایس پسنٛد چُھ۔
\v 12 یِم چیز کٔرِو توقع سان تہٕ یسوعؔ سنٛدِ یِنہٕ باپتھ وُژھ کٔرِتھ۔ تمہِ دوٚہہ کِنؠ کرِ خدا آسمانن فناہ نارٕ سٟتؠ تہٕ ملاوِ فطرت کٮ۪ن بنیٲدی عنصرن تاوٕ تژرٕ سٟتؠ
\v 13 یوٚدوے زن تہِ سورےٕ سپدِ، أسؠ چھِ نوٮ۪ن آسمانن تہٕ نوِ زمینہِ ہُنٛد توقع کران یِم خداین بارسس اننُک وعدٕ کوٚرمُت چُھ۔ تتھ نٔوِس کایناتس منٛز آسہ پرٮ۪تھ کانٛہہ راستباز۔
\v 14 اوٕ کِنؠ زِ یہِ چُھ پوٚز! ایماندار سٲتھیو یِمن بہٕ لول بران چُھس، ییٚلہِ زن توٚہؠ یہِ سپدنس پراران چُھو، تنہٕ منہٕ لگیٚو پان شیرنس یہِ یقینی بناونہٕ باپتھ زِ یُتھنہٕ یسوعؔ توٚہہِ وُچھِ گناہ گار زندگی زُوان۔ توٚہؠ روزیٚو خدایس سٟتؠ امنہٕ سان جورِتھ۔
\v 15 تہٕ یتھ پٮ۪ٹھ سونٛچِو: سون خداوند یسوعؔ چُھ صٲبر تاکہِ ژٔرؠ ژٔرؠ لوٗکھ پراون نجات۔ پولُسؔ، اکھ ایماندار سٲتھی یمِس أسؠ لول چھِ بران، تہِ چُھ یی لیٚکھِتھ تہٕ ؤنِتھ گوٚمُت توٚہہِ۔ تٔمؠ لیٚوکھ خدایہِ سنٛدِ بخشمژِ دانٲیی سان۔
\v 16 پننٮ۪ن تمام نامن منٛز یِم پولُسنؔ لیٚکھؠ، تٔمؠ لیٚچھِ یِمہٕ کتھہٕ تہِ یِم مےٚ وُنؠ وُنؠ ونیٚو۔ یِمن تمسنٛدٮ۪ن نامن منٛز چھےٚ کینٛہہ کتھہٕ بڈٕ مُشکل سمجھنہِ۔ یِمن لوٗکن علمچ تہٕ قرارچ ویٚژھے چھےٚ تِم چھِ اتھ مشکل تعلیمہ تہٕ باقے صحیفن غلط تٲویل کران۔ خدا دِیہ تِمن امہِ باپتھ سزا۔
\v 17 اوٕ کِنؠ زِ یِم سٲری چیز چھِ پٔزؠ۔ ایماندار سٲتھیو یِمن بہٕ لول بران چُھس تہٕ بیٚیہِ توٚہؠ یِم برونٛٹھےٕ یِمن چیزن متعلق زانان چھِ، پنُن پان رٔٹِو الگ۔ تہٕ تِمن غلط تعلیمن پٮ۪ٹھ مہٕ روزیٚو یِم توٚہہِ گنہن کُن نِن زنتہٕ کانٛہہ قانون چُھنہٕ تہٕ توٚہؠ روزیٚو تابعدار زندگی زُو نہٕ نِش مُچھہِ۔
\v 18 بلکہِ روز زُوان تِتھٕ پٲٹھؠ زِ توٚہؠ ژٮ۪ترٲیو زیادٕ کھۅتہٕ زیادٕ مہربٲنی پننس حٲکم یسوعؔ مسیحؔ سنٛز تہٕ یمؠ توٚہہِ نجات بخُش۔ تہٕ تِتھٕ پٲٹھؠ گُذٲرِو زندگی زِ توٚہؠ زٲنِو ژوٚر ژوٚر تمِس متعلق۔
\p بہٕ چُھس دُعا کران زِ پرٮ۪تھ کانٛہہ پرٮ۪زلاوِ یسوعسؔ وُنکٮ۪س تہٕ پرٮ۪تھ وقتہٕ۔ آمین یہِ سپدِن!
