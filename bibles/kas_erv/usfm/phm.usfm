\id PHM - DMT Kashmiri
\toc1 فلیمون
\mt1 فلیمون
\c 1
\p
\v 1 بہٕ پولُسؔ چُھس ونکیٚن قٲدخانس منٛز یسوع مسیحؔ سٕنٛز خدمت کران۔ مےٚ سٟتؠ چُھ ییٚتہِ سون ایمان بوج تیمُتھیس۔ بہٕ چُھس یہِ چٹھؠ ژےٚ فلیمونسؔ سٲتھی کارکنس لیٚکھان۔ توٚہؠ تہِ چھُو مسیحسؔ خدمت کران، تہٕ أسؠ چھُو توٚہہِ لول بران۔ \f + \fr 1‏:1 \ft یہ چٹھؠ چُھ پولُس لیٚکھان ییٚلہِ زن تیمُتھیس صرف سلام و دُعا کرنس منٛز تِمن سٟتؠ شٲمِل سپدان چُھ۔ \f*
\v 2 بہٕ چُھس ایمان تھاوان واجنہِ سانہِ بیٚنہِ افیہَسؔ لیٚکھان بییٚہِ ارخپُسؔ یُس أکس سپاہ سنٛدؠ پٲٹھؠ اسہِ سٟتؠ مسیحؔ سٕنٛز خدمت کران چُھ۔ بییٚہِ چُھس بہٕ تہنٛدِس گھرس منٛز سمن والین ایماندارن ہنٛزِ جماتس تہِ لیٚکھان۔
\v 3 بہٕ چُھس دعا منٛگان زِ سٲنس ببَ خداۓ تہٕ سٲنس خداوند یسوع مسیحؔ سنٛدِ طرفہٕ روزؠ نو توٚہہِ سارنےٕ پیٚٹھ سلامتی تہٕ فضل حٲصل سپدان۔
\v 4 ییٚلہِ بہٕ دعا چُھس منٛگان، فلیمونؔ، بہٕ چُھس ہمیشہِ خداۓ سٕنٛز شُکر گزٲری چانہِ باپتھ کران،
\v 5 تکیازِ لوٗکھ چھِ مےٚ ونان زِ ژےٚ کوتاہ بھروسہٕ چُھےٚ خداوند یسوعس پیٚٹھ بییٚہِ کوتاہ چھُک ژےٚ تمس بییٚہِ خداۓ سنٛدین سارنےٕ لوٗکن لول بران۔
\v 6 بہٕ چُھس یِتہِ دعا منٛگان زِ توٚہؠ تہِ کریو مسیحسؔ پیٚٹھ تیوٚت بھروسہٕ یوٚت اسہِ چُھ، توٚہہِ ترن تِم سٲری رٕتؠ چیز ہنا زیادے پہن فکرِ یِم مسیحنؔ اسہِ تمس خدمت کران عطا کٔرؠ۔
\v 7 میون ٹوٹھ دوس، ژےٚ کٔرٕتھ مےٚ سؠٹھاہ حوصلہٕ افزٲئی تہٕ بہٕ سپدس بڈٕ خۅش۔ توٚہؠ چھُو خدا سٕندٮ۪ن لوٗکن پننہِ لولہٕ سٟتؠ حوصلہٕ افزٲئی کران روٗدمٕتؠ۔
\v 8 لہٰذا تُہنٛزِ خداے سٕندٮ۪ن لوٗکن ہنٛزِ مایہِ بییٚہِ بہٕ مسیحؔ سُنٛد رسول آسنہٕ سببہٕ، چُھ مےٚ مکمل بھروسہٕ زِ مسیحؔ دیہِ مےٚ توٚہہِ حکم کرنُک اجازت زِ توٚہہِ کیاہ پزِ کرُن۔
\v 9 توٚہہِ حکم دِنہٕ بجایہ، اسہِ چھِ اکھ أکس لول بران، بہٕ پولُسؔ چُھس اکھ وٲنسہِ آمُت نفر بییٚہِ چُھس اکھ قٲدؠ یسوع مسیحؔ سٕنٛز خدمت کرنہٕ سببہٕ، میٲنؠ چھِ گذٲرش زِ اسہِ چھِ یہِ کرُن۔ \f + \fr 1‏:9 \ft وچھو لوک 1:18، طیطسؔ 2:2، 2:3 \f*
\v 10 بہٕ چُھس توٚہہِ التماس کران زِ انیسمسؔ سنٛدِ خٲطرٕ کریو کینٛہہ۔ سُہ چُھ قٲدس منٛز  میون اکھ نیٚچو ہیو بنیمُت زنجیرو سٟتؠ بند۔ چونکہ تمس چُھ مےٚ یتہِ مسیحسؔ متعلق ونومُت۔
\v 11 سُہ اوس گۅڈٕ تُہندِ خٲطرٕ بے فٲیدٕ، مگر وونؠ چُھ سُہ اسہِ دوٚشوٕنؠ ہندِ خٲطرٕ فٲیدٕ منٛد!
\v 12 سُہ مےٚ سؠٹھاہ ٹوٹھ آسنہٕ پتہٕ تہِ چُھسن بہٕ سُہ توٚہہِ کن واپس سوزان۔
\v 13 بہٕ اوسس یژھان زِ سُہ تھاون بہٕ پانس نِش یوٚت زن سُہ مےٚ تُہندِ بدلہٕ خدمت کرِ، خاص کر سُہ کرِ مسیحسؔ متعلق رٕژِ شیچھِ ہنٛد تبلیغ زنجیرن منٛز میٲنس قٲد خانس اندر روزنس دوران۔
\v 14 بہرحال، بہٕ چُھسن سُہ توٚہہِ نِش واپس سوزان تکیازِ توٚہہِ ووٚنو نہٕ مےٚ زِ سُہ تھاوُن پانس نِش ییٚتی۔ بہٕ چُھس یژھان زِ توٚہؠ کریو تمس اصل پٲٹھؠ مدد تکیازِ توٚہہِ یژھو میون مدد، نہٕ کہ مےٚ کروٕ توٚہؠ مدد کرنس پیٚٹھ مجبور۔
\v 15 یہِ تہِ ہیٚکہِ أسِتھ زِ خداین دِیت انیسمسؔ یتھ مخصر وقتس تسؠ نِش دور روزنُک اجازت یتھ سُہ أکس ایماندار سنٛدؠ رنگؠ تس نِش واپس ییہِ تہٕ روزِ ہمیشہِ خٲطرٕ تسؠ سٟتؠ۔
\v 16 انیسمسؔ چُھنہٕ وونؠ اکھ غلام بلکہ سُہ چُھ أکس غلامہٕ سنٛدؠ کھوٚتہٕ بہتر۔ ونہِ کہِ پیٚٹھ ہیکیو توٚہؠ تمس أکس ایمان بٲج سنٛدؠ پٲٹھؠ لول بریتھ! سُہ چُھ مےٚ سؠٹھاہ ٹوٹھ، مگر سُہ چُھ یقیٖنن توٚہہِ تمہِ کھۅتہٕ زیادٕ ٹوٹھ۔ وونؠ چُھنہٕ سُہ تُہند صرف اکھ غلام بلکہ سُہ چُھ خداوندٕ سُنٛد تہِ۔
\v 17 لہٰذا ہرگاہ توٚہؠ مےٚ خداۓ سٕنٛز کٲم کرنس منٛز یِس مےٚ تمؠ عطا کٔرمٕژ چھِ، پنُن اکھ سٲتھی مانان چھُو، تیلہِ کریو پننِس گھرس منٛز تمہِ اندازٕ خۅش اوے یمہِ اندازٕ مےٚ کرِہیو۔
\v 18 ہرگاہ تمؠ توٚہہِ نِش کینٛہہ نِمُت چُھ، یا ہرگاہ سُہ دارِ توٚہہِ کانٛہہ تہِ چیز، بہٕ دِمہٕ ہو توٚہہِ سُہ واپس۔
\v 19 بہٕ، پولُسؔ چُھس وونؠ یہِ پننہِ اتھٕ سٟتؠ لیٚکھان: بہٕ کرٕ سُہ سورےٕ توٚہہِ ادا یہِ سُہ توٚہہِ دارِ۔ مےٚ چُھ یقین زِ مےٚ پییہِ نہٕ توٚہہِ یاد پاونٕچ ضرورت زِ توٚہؠ یہِ دٲریو مےٚ تمہِ کھۅتہٕ میون قرض چُھ انیسمسؔ، تکیازِ خداین بچٲو تُہنٛز زندگی ییٚلہِ مےٚ توٚہہِ مسیحسؔ متعلق خبر دِژ۔
\v 20 آ، میانہِ  ایماندار سٲتھی، ژےٚ تری فکرِ زِ بہٕ کیاہ چھُس ونان۔ بہٕ چُھس یژھان توٚہؠ کریو یہِ میانہٕ خٲطرٕ أمی سببہٕ زِ خداوندن کیاہ کور تُہندِ خٲطرٕ۔ مےٚ دِیو خۅش روزنُک بیاکھ اکھ سبب زِ أسؠ دوشوے چھِ مسیحسؔ سٟتؠ شٲمل۔
\v 21 چونکہ بہٕ چُھس یہِ چٹھؠ توٚہہِ لیٚکھان، مےٚ چُھ یقین زِ توٚہؠ کریو تیی یہِ بہٕ توٚہہِ کرنچ گزٲرش کران چُھس۔ بہٕ چُھس زانان زِ توٚہؠ کریو پزؠ پٲٹھؠ تمہِ کھۅتہٕ زیادے پہن یمِچ بہٕ توٚہہِ گزٲرش کران چُھس۔
\v 22 ییٚلہِ توٚہؠ تہِ کران چھُو یہِ توٚہہِ بہٕ گزٲرش چُھس کران، بییٚہِ چُھس بہٕ توٚہہِ ییتہِ گزٲرش کران زِ توٚہؠ کریو پنہٕ نِس گھرس منٛز مےٚ جاے دِنچ تیٲری۔ تکیازِ توٚہؠ سٲری چھُو میانہِ خٲطرٕ دعا کران روٗدمٕتؠ، مےٚ چُھے پوٚرٕ پٲٹھؠ امید زِ خداے کرِ مےٚ قٲدٕ منٛز آزاد تہِ بہٕ واتہٕ توٚہہِ سارنے نِش۔
\v 23 ایپفراسؔ یُس قٲدس منٛز یسوع مسیحسؔ خدمت کران تکلیف تلان چُھ، سُہ چُھ توٚہہِ سلام ونان۔
\v 24 مرقُسؔ، ارسترسخُسؔ، دیماسؔ بییٚہِ لوقاؔ یِم میٲنؠ سٲتھی کارکن چھِ، تِم تہِ چھے توٚہہِ سلام ونان۔
\v 25 بہٕ چُھس دعا منٛگان زِ سون خداوند یسوع مسیحؔ روزِ توٚہہِ پیٚٹھ مہربان روحٲنی طور۔ آمین۔
