\id 2TH - DMT Kashmiri
\toc1 2 تھِس
\mt1 2 تھِس
\c 1
\p
\v 1 بہٕ، پولُسؔ\f + \fr 1‏:1 \ft یہِ خط چُھ پولُسنؔ لیٚوکھمُت تہٕ سلوانسؔ تہٕ تیمُتھیس گیہِ تس صرف مبارکبٲدی وزِ شٲمل\f* تہٕ مےٚ سٟتؠ سیلاسؔ\f + \fr 1‏:1 \ft سلوانسؔ چُھ سیلاس سُنٛد بیاکھ ناو۔ \f* تہٕ تیمُتھیس چھِ یہِ چِٹھؠ توٚہہِ تھِسلُنِیکے شہرٕ کؠن مسیحیؔ جمٲژ ہنٛدین ایمان والیٚن باین سوٗزان، یِمن سٲنس ببَ خدایس تہٕ سٲنس خداوند یسوع مسیحؔ سٕنٛدؠ چھِ۔
\v 2 سون ببَ خدا تہٕ خداوند یسوع مسیحؔ روٗزِن ہمیشہِ توٚہہِ پیٚٹھ مہربان بییٚہِ تھٲوِنو سلامت۔
\v 3 سانیو ٹاٹھیو بایو تہٕ بینیو، اسہِ پزِ اکثر تُہنٛدِ باپتھ خدایہِ سُنٛد سؠٹھاہ شکُر گذٲری کرنؠ، یُس سون فرض چُھ!یہِ چُھ منٲسب زِ اسہِ پزِ یہِ کرُن تکیازِ خداوند یسوعسؔ پیٚٹھ تُہنٛدس ایمانس منٛز چُھ زیادٕ کھوٚتہٕ زیادٕ ہُریر سپدان بییٚہِ چُھ أکس بیٚیِس سٟتؠ تُہنٛد لول زیادٕ کھۅتہٕ زیادٕ ہُران۔
\v 4 یوٚت تام زن أسؠ چھِ خدایہِ سنٛدین کلیسن منٛز توٚہہِ پیٚٹھ فخر کران زِ یِم دوکھ تہٕ مصیبت توٚہؠ ہمیشہِ تُلان چھُو اتھ منٛز چُھ تُہنٛد ایمان تہٕ صبر ظٲہر سپدان۔
\v 5 أسؠ ہیٚکو وارٕ پٲٹھؠ وُچھِتھ زِ خداین چھُو توٚہؠ یسوعؔ سنٛدِ خٲطرٕ وفادار بنٲؠ مٕتؠ یودوے توٚہہِ لوٗکھ عِذا چھِ دِوان۔ أمہِ تلہٕ چھِ أسؠ زانان زِ خدا چُھ پزؠ پٲٹھؠ انصاف کران تکیازِ سُہ چُھ توٚہہِ ہمیشہِ خٲطرٕ پننٕؠ لوٗکھ بناونس لایق مانان۔ توے چھُو توٚہؠ تکلیف ویٚتراوان۔
\v 6 خدا چُھ انصافٕچ عدالت کران، سُہ دِیہِ یقیٖنن تِمن لوٗکن تکلیف یِم توٚہہِ تکلیف تُلناوان چھُو۔
\v 7 سُہ تھاوِ توٚہہِ دوٚکھ ویٚتراوان اسہِ سٟتؠ آرامہٕ سان یمہِ وِزِ خداوند یسوع پننہِ قدرژ ہنٛدین ملٲیکن سٟتؠ آسمانہٕ ظٲہر سپدِ۔ \f + \fr 1‏:7 \ft 1پطرس 1:14۔ 15، مُکاشفہ 14:13\f*
\v 8 پتہٕ دِیہِ سُہ تِمن خدایس تہٕ سٲنس خداوند یسوع سنٛزِ رٕژِ شیٚچھِ انکار کرن والیٚن لوٗکن نارٕ ریہہ سٟتؠ سزا۔ \f + \fr 1‏:8 \ft مزامیر 79:6، احبار 66:15، یرمیاہ 10:25\f*
\v 9 خداوند یمہِ دوٚہہ واپس واتہِ تِم لوٗکھ روٗزن خدا وند سٕنٛدِ جلٲلی قدرژ نِشہٕ ہمیشہ لوٚب تہِ تِمن آسہِ ابدی ہلاکژ ہُنٛد سزا۔ \f + \fr 1‏:9 \ft مُکاشفہ 21:8، متی 25:41، 46، یسعیاہؔ 2:19، 21\f*
\v 10 یہِ سپدِ تمہِ وِزِ ییٚلہِ خداوند یسوع خدایہِ سٕنٛدِ فٲصلہٕ مطٲبق آسمان پیٚٹھ واپس واتہِ، أسؠ کرو تمس تعریف تہٕ سپدو حٲران۔ تِمن منٛز ٲسیٚو توٚہؠ تہِ شٲمل تکیازِ ییٚلہِ اسہِ توٚہہِ یسوعسؔ متعلق ووٚنوٕ تہٕ توٚہہِ اوٚنو ایمان۔ \f + \fr 1‏:10 \ft 1تھسلونینؔ 2:13، 1کورنتھین 1:6، مزامیر 89:7، یسعیاہؔ 49:3\f*
\v 11 أمی سببہٕ چھِ أسؠ تُہنٛدِ خٲطرٕ پرٛتھ وِزِ روٗزن دعا کران زِ خدا بنٲوِن توٚہہِ نیک لوٗکھ بننس لایق تہٕ تُہنٛز پرٛتھ کانٛہہ خوٲہِش سپدِن قدرتہٕ سٟتؠ پوٚرٕ۔
\v 12 أسؠ چھِ تُہندِ باپتھ خدایس دُعا منٛگان یُتھ زن خدا تہٕ خداوند یسوع سٕنٛدِ فضلہٕ سٟتؠ روزِ سٲنس خداوند یسوع سُنٛد ناو توٚہہِ منٛز پرٛزلہِ تہٕ توٚہؠ روزِو تس منٛز۔ \f + \fr 1‏:12 \ft یسعیاہؔ 24:15، 66:5، 1پطرس 1:7۔ 8\f*
\c 2
\p
\v 1 ووٚنؠ چُھس بہٕ توٚہہِ تتھ وقتس متعلق یژھن لیکھن ییٚلہِ سون خداوند یسوع مسیحؔ دنیاہس پیٚٹھ واپس واتہِ تہِ سمکھنہٕ باپتھ کرِ اسہِ جمع۔ میانیو ایماندار سٲتھیو، بہٕ چُھس توٚہہِ عرض کرن
\v 2 زِ توٚہؠ سونچِو کٲنسہِ ہنٛدِس کلامس متعلق خاموشی سان، یوس توٚہہِ نِشہٕ ووتمُت آسہِ زِ خداوند یسوع چُھ برونٛٹھے دنیاہس پیٚٹھ واپس آمُت۔ أمہِ کلام سٟتؠ لگہِ نہٕ پریشان سپدن۔ یہِ چُھنہٕ کانٛہہ مسلہٕ ہرگاہ سُہ کلام واتہِ توٚہہِ نِشہٕ أکس روح سٕنٛدِ دسؠ یا أکس شخصہٕ سٕنٛدِ دسؠ یا چِٹھِ سٟتؠ یودوے سانہِ طرفہٕ چھِ۔
\v 3 کٲنسہِ ہنٛدِس کُنہِ تہِ فریبس منٛز مَہ یِیو۔ یہِ چُھنہٕ پوٚز، لٲزم چُھ زِ گوٚڈٕ سپدن واریاہ لوٗکھ خدایس خلاف، تمؠ سنٛدین حکمن کرِن انکار تمہِ پتہٕ کمےٕ کٲلؠ کرِ خدا تِمن برباد ادٕ سپدِ خداوند ظٲہر۔ \f + \fr 2‏:3 \ft شیطان\f*
\v 4 یُس مُخالفت کرِ تہٕ پانس پرٛتھ تس ہیٚور مانہِ یس خدا یا معبود وننہٕ یوان چُھ یا یمسٕنٛز عبادت کرنہٕ یوان چھےٚ یوٚت تام سُہ خدایہِ سنٛزِ ہیکلہٕ منٛز بہتھ پنہٕ نس پانس بطورِ خدا ظٲہر کرِ۔ \f + \fr 2‏:4 \ft عذرا 28:2، دانیال 11:36۔ 37\f*
\v 5 مےٚ چُھ یقین زِ توٚہہِ آسہِ یاد زِ یمہٕ سارے کتھٕ ونہِ مےٚ توٚہہِ ییٚلہِ بہٕ تھسلونی منٛز توٚہہِ سٟتؠ اوسس۔
\v 6 تہٕ توٚہؠ چھُو زانان زِ مقرر وقتہٕ برونٛٹھ ظٲہر سپدن کُس چیز چُھ تمس رُکاون۔
\v 7 بے دینی ہُنٛد طاقت چُھ پوشیدٕ پٲٹھؠ پنُن اثر تراوان ییٚلہِ زن اکھ رُکاون وول چُھ ونہِ تہٕ موجود تہٕ یوٚت تام سُہ وتہِ پیٚٹھ ہٹاونہٕ ییہِ سُہ روزِ تس رُکاوان۔
\v 8 پتہٕ تراوِ خدا تمس انسانس ہر کٲنسہِ پنُن پان ہاونہٕ خٲطرٕ ییٚلہِ یُس مکمل پٲٹھؠ خدایہِ سنٛدین حکمن انکار ووٚل چُھ۔ ٲخرس پیٚٹھ سپدِ خداوند یسوع ظٲہر۔ تمس انسانس سپدِ سُہ وُچھِتھ مکمل پٲٹھؠ طاقت ختم۔ پتہٕ سپدِ سُہ انسان خداوند یسوع سنٛدِ اکہِ پھۅکہٕ سٟتؠ ہلاک۔ \f + \fr 2‏:8 \ft ایوب 4:9، یسعیاہؔ 11:4\f*
\v 9 أمہِ برونٛہہ کرِ شیطان أمِس انسان سٕنٛدؠ دسؠ سؠٹھاہ طاقتہٕ سان کٲم۔ شیطان بخشہِ تس خدایہِ سٕنٛدؠ پٲٹھؠ معجزٕ ہاونٕکؠ ہربہٕ۔
\v 10 یہِ انسان آسہِ بوٚڈ بدبخت تہٕ دِیہِ واریاہن لوٗکن دوٚکھٕ۔ یِم لوٗکھ سپدن ہلاک تکیازِ تِمو کٔر نہٕ یسوعسؔ متعلق پزِ شیٚچھِ ہنٛز قدر اوے بچاونہٕ تِمن خداۓ۔
\v 11 یِمن لوٗکن تراوِ خدا گمرٲہی ہُنٛد اثر اوے کرن تِم پزرٕ بدلہٕ اپزس پیٚٹھ یقین۔
\v 12 خداۓ دِیہِ تِمن لوٗکن سزا یِم یسوع سنٛزِ پزِ شیٚچھِ انکار کرِتھ بدکٲری کرن۔
\v 13 سانیو بایو تہٕ بینیو، اسہِ پزِ تُہنٛدِ باپتھ خدایہِ سنٛز شکُر گُذٲری کرنؠ زِ توٚہؠ چھُو سون خداوند یسوع لول بران بییٚہِ ژٲرؠ نو توٚہؠ خداین پننؠن لوٗکن منٛز یِمو گۅڈٕنیٚھ یسوعسؔ متعلق پزِ شیٚچھِ پیٚٹھ ایمان اوٚن۔ خداین ژٲرؠ نو توٚہؠ پننہِ پاک روح سٕنٛدِ دسؠ یِمن نجات میلہِ۔ \f + \fr 2‏:13 \ft افسینؔ 1:4۔ 5، 1پطرس 1:1۔ 5، تثنِیہ شرع 33:12\f*
\v 14 خداین دِژوٕ توٚہہِ پانس کُن ینٕچ تتھ یسوع سنٛزِ رٕژِ شیٚچھِ پیٚٹھ دعوت یمیُک اعلان اسہِ توٚہہِ نِشہٕ کوٚر یتھ زن توٚہؠ خداوند یسوع مسیحؔ سُنٛد جلال حٲصٕل کرِو۔
\v 15 لہٰذا سانیو بایو، مسیحؔ سنٛدِس ایمانس پیٚٹھ روزِو درِتھ۔ تتھ پزِ تعلیمہِ پیٚٹھ روزِو ایمان دررٲیِتھ یوٚسہٕ اسہِ زبٲنؠ تہٕ اکہِ چِٹھِ ہنٛدِ ذریعہٕ توٚہہِ دِژ۔
\v 16‏-17‏ سون بب خداۓ چھُو توٚہہِ لول بران تکیازِ سُہ چُھ اسہِ پیٚٹھ سؠٹھاہ مہربان، سُہ روزِ اسہِ ہمت بخشان تہٕ أسؠ ہیکو امید تھٲوِتھ زِ اسہِ سپدِ رُتےٕ حٲصٕل۔ أسؠ چھِ دعا منٛگان زِ سُہ تہٕ سون خداوند مسیحؔ کرِن توٚہہِ رٕژٕ کامہِ کرنس منٛز ہمیشہِ توٚہہِ حوصلہٕ افزٲئی۔
\c 3
\p
\v 1 یہِ چُھ تمیٛک ٲخری حصہٕ یہِ بہٕ ونُن یژھن چُھس۔  سانیو ایماندار سٲتھِیو، سانہِ خٲطرٕ منٛگِو دعا زِ خداوند یسوع سُنٛد کلام بوزن واریاہ لوٗکھ جل جل تہٕ تیُتھ جلال پرٲوِن یتھ زن توٚہہِ منٛز چُھ۔ 
\v 2 بییٚہِ منٛگِو سانہِ باپتھ دعا زِ خدا روٗزِن اسہِ بُرٕ لوٗکن ہنٛدِ شرٕ نِشہٕ بچاون۔  توٚہہِ چھِ خبر زِ اکثر لوٗکن چُھنہٕ خداوندس پیٚٹھ ایمان۔ 
\v 3 امہِ باوجود، خداوند یسوع چُھ وفادار! سُہ بخشہِ توٚہہِ روحٲنی طاقت تہٕ شیطان سٕنٛدِ شرٕ نِشہٕ کرِوٕ توٚہہِ حفاظت۔ 
\v 4 تکیازِ توٚہہِ چھُو سٲنس خداوند یسوعسؔ سٟتؠ رٔلِتھ، اسہِ چُھ بییٚہِ بھروسہٕ زِ توٚہؠ چھُو تتھ پیٚٹھ عمل کران یِم اسہِ توٚہہِ حکم دِیُت تہٕ توٚہؠ کرِو تِمن حکمن پیٚٹھ تہِ عمل یِم أسؠ یتھ چِٹھِ منٛز توٚہہِ دِوان چھِ۔ 
\v 5 أسؠ چھِ دعا منٛگان زِ سون خداوند یسوعؔ کرِن تُہنٛدین دِلن ہُنٛد خدایہِ سُنٛد لولہٕ تہٕ مسیحؔ سنٛدِ صبرٕ کِنؠ ہدایت۔ 
\v 6 سانیو ایماندار سٲتھِیو، ووٚنؠ یہِ توٚہہِ أسؠ وُنو زن تہِ آسہِ خداوند یسوع مسیحؔ پانے ونان زِ أسؠ چھِ توٚہہِ حکم دِوان زِ تمس پریتھ کٲنسہِ ایماندار سٲتھیس نِشہٕ روزِو دوٗر یُس بےٚ قٲیدگی سان کٲم کران چُھ۔  یِم لوٗکھ چھِنہٕ تمہِ طریقہٕ زندگی بسر کران یمہِ طریقہٕ یسوعنؔ أسؠ ہیٚچھنٲومٕتؠ چھِ تہٕ أسؠ چھِ تیٖ توٚہہِ پننہِ انوارِ پیٚٹھ ہیٚچھناون۔ 
\v 7 یہِ چھِ أسؠ توٚہہِ ونن تکیازِ توٚہؠ چھُو پانہٕ زانن زِ توٚہہِ پزِ سٲنؠ پٲٹھؠ پیش یُن۔  أسؠ روٗدؠ نہٕ کامہِ بغٲر ییٚلہِ أسؠ توٚہہِ سٟتؠ روٗزان ٲسؠ۔ 
\v 8 أسؠ ٲسؠ نہٕ کٲنسہِ نِشہٕ مفت کھیوان۔  تمہِ بجایہ، کٔر اسہِ سارسے وقتس دوران پانس مدد کرنہٕ خٲطرٕ سخ محنت۔  اسہِ کوٚر تہِ أمہِ سببہٕ یُتھ زن نہٕ توٚہہِ پیٚٹھ سون کانٛہہ بار پییٚہِ۔ 
\v 9 خداین چُھ اسہِ یقینی طوٗر پننہِ ضرورتٕکؠ چیز تمؠ سنٛدین لوٗکن نِشہٕ رٹنُک اختیار دیُتمُت۔  مگر لوٗکن نِشہٕ چیز منٛگنہٕ بدلہٕ کٔر اسہِ سخ محنت یُتھ زن توٚہؠ وُچھِتھ ہیکیو زِ خدایہِ کٔتہٕ کِنؠ چُھ پننؠن لوٗکن پننٕؠ زندگی بسر کرنؠ یژھان، تہٕ پتہٕ ہیکیو توٚہؠ سٲنؠ پٲٹھؠ پننٕؠ زندگی بسر کرِتھ۔ 
\v 10 یاد تھٲوو ییٚلہِ أسؠ توٚہہِ سٟتؠ ٲسؠ، أسؠ روٗدؠ توٚہہِ حکم دِوان زِ ہرگاہ کانٛہہ ایمان وول سٲتھی کٲم کرنس انکار کرِ، توٚہہِ پزِ نہٕ تس کھیٚنہٕ خٲطرٕ غذا دِیُن۔ 
\v 11 ووٚنؠ چھِ أسؠ توٚہہِ یہِ دُبارٕ ونن تکیازِ لوٗکو ووٚن اسہِ زِ توٚہہِ منٛز چھِ کینٛہہ کٲہل تہِ تِم چھِ نہٕ کانٛہہ تہِ کٲم کران۔  یُتےٕ یوٚت نہٕ کینٛہہ بلؠ کہ چھِ باقی لوٗکن ہنٛزن کامیٚن منٛز دخل دِوان۔ 
\v 12 ووٚنؠ أسؠ یہِ توٚہہِ ونو تتھ پیٚٹھ کرِو عمل زن تہِ آسہِ خداوند یسوع مسیحؔ پانے ونان؛ أسؠ چھِ تِمن کٲم نہٕ کرن والیٚن حکم تہٕ عرض کرن زِ ژھوٚپہٕ کٔرِتھ کٔرِو پننٕؠ کٲم یتھ زن تِمن تہِ حٲصل سپدِ یہٕ تِمن زندگی منٛز ضروٗرت چھۓ۔ 
\v 13 ایماندار سٲتھیو یوٚت تام زن تُہنٛد تٲلق چُھ، توٚہؠ چھُو سخ محنت کران، نیک کٲم کرنس منٛز مَہ ہٲرِو زانٛہہ تہِ ہمت!
\v 14 ہرگاہ کانٛہہ ایماندار سٲتھی تتھ پیٚٹھ عمل کرِنہٕ یہِ اسہِ یتھ چِٹھِ منٛز لیٚوکھمُت چُھ، عوامس منٛز کرِو تمس نفرٕ سٕنٛز شناخت۔  پتہٕ مَہ تھوو تمس سٟتؠ صحبت یُتھ زن سُہ شرمندٕ سپدِ زِ سُہ چُھنہٕ کٲم کران۔ 
\v 15 سُہ مہٕ زٲنؠ وون پنُن دشمن؛ تمہِ بدلہٕ کرِو تمس نصیحت یتھٕ پٲٹھؠ توٚہؠ باقین ایماندار سٲتھین کرِن چھُو۔ 
\v 16 بہٕ چُھس دعا منٛگن زِ سون خداوند چُھ سُہ یُس کٲنسہِ تہِ پزِ پٲٹھؠ اطمنان ہیکہِ بخشتھ، سُہ بخشن پرٛتھ حالتس منٛز توٚہہِ اطمنان۔  بہٕ چُھس دعا منٛگن زِ سون خداوند یسوع کرن توٚہہِ سارنے ہمیشہِ مدد۔ 
\v 17 ووٚنؠ نیو مےٚ پننِس کٲتبس قلم تہٕ بہٕ پولُسؔ چُھس توٚہہِ پانہٕ سلام لیکھن۔  بہٕ چُھس یہِ پننہِ پریتھ چِٹھِ کرن یُتھ زن توٚہؠ زانو زِ یہِ چھِ پزِؠ پٲٹھؠ بہٕ یمؠ یہِ چِٹھؠ سوز۔  یتھۓ پٲٹھؠ چُھس بہٕ پننہِ سارے چِٹھِ اند واتناون۔ 
\v 18 بہٕ چُھس دعا منٛگن زِ سون خداوند یسوع مسیحؔ روٗزِن توٚہہِ سارنےٕ پیٚٹھ ہمیشہِ مہربان۔
