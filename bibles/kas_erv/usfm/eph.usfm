\id EPH EPH - DMT Kashmiri
\toc1 اِفسِیونؔ
\mt1 اِفسِیونؔ
\c 1
\p
\v 1 بہٕ چُھس پولُسؔ۔ یسوعؔ مسیحؔ ہن سوزُس بہٕ تمؠ سنٛز نمایندگی کرنہِ تکیازِ یہٕ چُھ تی یہِ خدا یژھان اوس۔ بہٕ چُھس یہ چِٹھؠ تِمن لوٗکن لیٚکھان یِم خداین پانس کِتؠ الگ چھِ کٔڈؠ مٕتؠ یِم افسس شہرس منٛز چھِ روزان تہٕ یِم یسوعؔ مسیحؔ سٕنٛدؠ وفادار چھِ۔
\v 2 سون بب خدا تہٕ سون خداوند یسوع مسیحؔ بٔنِن لگاتار توٚہہِ پٮ۪ٹھ مہربان تہٕ بنٲوؠ نےَ ژےٚ پُر امن۔
\v 3 خدایہ سٕنٛدؠ کٔرِو تعریف، یُس سٲنِس خداوند یسوعؔ مسیحؔ سُنٛد بب چُھ! تٔمؠ چھےٚ اسہِ آسمانہٕ پٮ۪ٹھٕ یِنہٕ واجنہِ پرٮ۪تھ قٕسمٕچ روحٲنی نعمت بخشمٕژ تکیازِ أسؠ چھِ مسیحؔ ہس سٟتؠ تعلُق تھاوان۔
\v 4 درحقیقت، دنیا بناونہٕ برونٛہہ کوٚر خداین سون مسیحؔ ہس سٟتؠ تعلق تھاونہٕ باپتھ انتخاب، تاکہِ مسیحؔ ہیٚکہٕ اسہِ پننہٕ خاطرٕ پوٗرٕ پاک بنٲوِتھ۔ تکیازِ خدا چُھ اسہِ لول بران،
\v 5 تٔمؠ کوٚر فٲصلہٕ واریاہ برونٛہہ زِ سُہ نِیہِ اسہِ پننیٚو شُریٚو رنٛگؠ منٛگتہ یسوعؔ مسیحؔ سٕنٛدِ ذریعہ۔ یہِ کرنہٕ سٟتؠ گو سُہ خوش، لہٰذا کوٚر تٔمؠ تی یہِ سُہ کرُن یژھان اوس۔
\v 6 امہِ وجہ کِنؠ، چھِ أسؠ وۅنؠ خدایہِ سٕنٛدؠ تعریف کران زِ سُہ چُھ اسہِ پٮ۪ٹھ واریاہ مہربان، تمہِ کھۅتہٕ زیادٕ یمِکؠ أسؠ حقدار چھِ، یتھٕ پٲٹھؠ تٔمؠ اسہِ برکتھ دِژ پننِس گۅبٕرؠ سٕنٛدِ ذریعہ یمِس سُہ لول بران چُھ۔
\v 7 ییٚلہِ یسوعؔ سانہِ بدل مود، تٔمؠ چُکوو سانہِ گنہُک قٟمت، یعنی، ییٚلہ سُہ سانہِ باپتھ مود، خداین دِژ اسہِ سانٮ۪ن گُنہن معافی تکیازِ سُہ چُھ سٮ۪ٹھا کثرت سان تہٕ فراخ دلی سان اسہِ پٮ۪ٹھ مہربان۔
\v 8 خدایس ٲس پتاہ زِ اسہِ پیٚیہِ أمؠ سنٛز ضروٗرت زِ سُہ روزِ اسہِ پٮ۪ٹھ یتھٕ پٲٹھؠ مہربان تکیازِ خدا چُھ سورےٕ زانان تہٕ چُھ پوٗرٕ دٲنش منٛد۔
\v 9 یتھٕ پٲٹھؠ کۅر خداین وۅنؠ پنُن منصوبہ اسہِ نِش ظٲہر یُس نہٕ تٔمؠ امہِ برُونٛہہ کٲنسہِ نِش تہِ ظٲہر اوس کۅرمُت، اکھ تیُتھ منصوبہ یُس سُہ مسیحؔ سنٛزِ کامہِ سٟتؠ پورٕ کرنس منٛز خۅش اوس۔
\v 10 اتھ منصوبس منٛز، ییٚلہ وق بالکل صحیح اوس، مسیحؔ کرِ تمام چیزن پانس تحت یکجا تاکہِ آسمانس منٛز تمام چیز تہٕ زمینس پٮ۪ٹھ تمام چیز بنن مسیحؔ سٕنٛدؠ۔
\v 11 تکیازِ یمہِ کِنؠ مسیحؔ ہن یہِ کوٚر، خداین تہِ اوس دعویٰ کۅرمُت اسہِ پنُن زاننُک۔ تٔمؠ کوٚر یہِ کرنُک واریاہ برونٛہہ منصوبہ، تہٕ سُہ چُھ ہمیشہٕ بالکل تی کران یہِ سُہ یژھان چُھ۔
\v 12 خدایہِ سٕنٛدِس منصوبس منٛز، ٲسؠ أسؠ یہُودؠ، یمو مسیحؔ ہس پٮ۪ٹھ ساروٕے برُونٛہہ بھروسہٕ کۅر، روزن خدایہ سٕنٛدؠ تعریف کرنہٕ باپتھ زندٕ تکیازِ سُہ چُھ واریاہ عظیم۔
\v 13 پتہٕ بوزُو توٚہہ غٲر یہُودیو تہِ پوٚز پٲغام، یہٕ رٕژ شیٚچھ زِ خدا کِتھ کٔنؠ چُھ توٚہہِ بچاوان، تہٕ توٚہہِ کوٚرو مسیحؔ ہس پٮ۪ٹھ اعتماد۔ ییٚلہِ توٚہہ تہِ کوٚرُو، خداین جوڑِو توٚہؠ مسیحؔ ہس سٟتؠ پاک روح دِتھ، یِتھ کِنؠ تٔمؠ وعدٕ اوس کوٚرمُت۔
\v 14 پاک روح چُھ تٔمہِ رقمٕکؠ پٲٹھؠ یُس یہِ ثٲبت چُھ کران زِ خدا دِیہ اسہِ باقی تِم چیز تہِ یِم تٔمؠ اسہِ دِنُک وعدٕ چُھ کوٚرمُت تمہِ وزِ ییٚلہ سُہ سٲری چیز یلہٕ تراوِ یِم سانہِ باپتھ چھِ۔ خدا سٕنٛدؠ تعریٖف کٔرِو تکیازِ سُہ چُھ واریاہ عظیم!
\v 15 تکیازِ خداین چُھ یہٕ سورےٕ توٚہہِ خٲطرٕ کوٚرمُت، تہٕ امہِ کِنؠ زِ لوٗکو چُھ مےٚ ووٚنمُت زِ توٚہؠ کِتھٕ کِنؠ چُھو خداوند یسوع ہس پٮ۪ٹھ بھروسہٕ کران تہٕ توٚہؠ کوتاہ چُھو تمام مومِنن لول بران،
\v 16 بہٕ چُھس تہنٛدِ باپتھ لگاتار خدایہِ سُنٛد شُکریہ ادا کران یہِ زن بہٕ خدایس کتھ کرنہٕ وِزِ توٚہہِ متعلق ونان چُھس ییٚلہِ بہٕ تس سنٛز عبادت چُھس کران۔
\v 17 بہٕ چُھس دُعا کران زِ سون خداوند یسوع مسیحؔ سُنٛد بب، بخشہِ پنُن روح توٚہہِ عقلمند بناونہٕ باپتھ تہٕ توٚہہِ برونٛہہ ظٲہِر گژھنہٕ باپتھ تاکہ توٚہؠ ہیٚکؠ وون سُہ بہتر پٲٹھؠ زٲنِتھ۔\f + \fr 1‏:17 \ft یسعیاہؔ 11:2\f*
\v 18 بہٕ چُھس دعا کران زِ خدا بناوِ توٚہہِ چیز وُچھنس قٲبل یتھٕ پٲٹھؠ تِم پٔزی چھِ تاکہ توٚہہ لگن خدایہِ سٕنٛدؠ سانہِ باپتھ پتاہ حٲرتہٕ وٲلؠ منصوبہ تکیازِ تٔمؠ چھِ أسؠ پنٕنؠ لوٗکھ مٲنؠ مٕتؠ۔ بہٕ چُھس دُعا کران زِ توٚہہِ لگہ پتاہ تِمن حٲرت انگیز تہٕ شاندار چیزن ہُنٛد یِم تٔمؠ اسہِ تہٕ سارنٕے مومِنن دِنُک وعدٕ چُھ کوٚرمُت۔
\v 19 تہٕ بہٕ چُھس دعا کران زِ توٚہہِ لگہ پتاہ زِ خدا کوتاہ طاقتور طریقو چُھ اسہِ خاطرٕ کٲم کران یِمن مسیحؔ ہس پٮ۪ٹھ یقین چُھ۔ سُہ چُھ سانہِ باپتھ تِتھے طاقتہٕ سان مضبوط
\v 20 یتھٕ پٲٹھؠ سُہ مسیحؔ سنٛدِ خٲطرٕہ اوس ییٚلہ تٔمؠ مسیحؔ مرنہٕ پتہٕ بیٚیہِ زندٕہ گژھنُک سبب بنوو، تہٕ تُلُن سُہٕ آسمانس منز ساروٕے کھۅتہٕ تھدِ اعزازکِس مقامس پٮ۪ٹھ۔\f + \fr 1‏:20 \ft عبرانین 10:22، زبور 110:1\f*
\v 21 مسیحؔ چُھ تتہِ پورٕ اختیارٕ سان پرٛتھ کٲنسہِ حٲکمس تہٕ طاقتور روحس پؠٹھ اختیارٕ کس پرٛتھ أکس سۅتھرِس پؠٹھ حکمرانی کران بیٚیہِ تتھ پرٮ۪تھ کُنہِ ذٲژ پؠٹھ یتھ لوکھ تعظیٖم کران چھِ۔ سُہ چُھ تِمن پؠٹھ حکمرٲنی کران أزؠ یوت نہٕ کینٛہہ بلکہ ہمیشہ خٲطرٕ۔
\v 22 خداین بنوو سورےٕ کینٛہہ مسیحؔ سُنٛد تابعہ تہٕ چُھن پریتھ جایہٕ تمام مومِنن منز پریتھ چیزس پٮ۪ٹھ مسیحؔ حکمران مقرر کوٚرمُت۔\f + \fr 1‏:22 \ft کولوسین 2:10، زبور 8:6\f*
\v 23 أسؠ ایماندار چھِ مسیحسؔ سٟتؠ تعلق تھاوان یتھٕ پٲٹھؠ أکِس شخصہٕ سنٛدؠ جسمٕکؠ تان چھِ امسنٛدِس کلس سٟتؠ تعلق تھاوان۔ سُہ چُھ تمام ایماندارن تِم تمام چیز سوزان یمچ تِمن کمی چھےٚ تِتھے پٲٹھؠ یتھٕ پٲٹھؠ سُہ پرٮ۪تھ جایہٕ چُھ ہر کانٛہہ چیز مکمل چُھ کران۔
\c 2
\p
\v 1 مسیحؔ ہس پٮ۪ٹھ بھروسہٕ کرنہٕ برونٛہہ، ٲسِو توٚہؠ روحٲنی طور مودمٕتؠ توٚہؠ ٲسِو نہٕ گناہ کرُن رُکٲوِتھ ہیٚکان۔
\v 2 توٚہؠ ٲسِو یمہِ دنیا کہِ مارمتہِ گناہ گار طریقو روزان، یمہِ دنیاہ کِس روحس تابعہ روٗزتھ۔ توٚہہِ کرنو بد روحن ہنٛدؠ حکمران رہنمائی یِمن یمہِ دنیاہ کٮ۪ن حٲکمن پٮ۪ٹھ اختیار چُھ۔ یہٕ حکمران چُھ شیطان، یُس وۅنؠ تِمن لوٗکن ہنٛدِ ذریعہ کٲم کران چُھ یِم خدایہ سنٛز نافرمٲنی چھِ کران۔
\v 3 أسؠ سٲری ٲسؠ تِتھے پٲٹھؠ روزان یتھ پٲٹھؠ یِم لوٗکھ روزان ٲسؠ یِم خدایہِ سنٛز نافرمٲنی چھِ کران۔ اسہِ کٔرؠ تِم بُرٕ چیز یِم اسہِ یژھؠ، تِم چیز یِم سانین جسمن تہٕ دماغن منٛز خوشی انن۔ أسؠ ٲسؠ مستحق زِ خدا گژھہِ اسہِ واریاہ ناراض گژھُن، تِتھے پٲٹھؠ یتھٕ پٲٹھؠ سُہ باقین لوٗکن سٟتؠ چُھ۔
\v 4 مگر خدا چُھ اسہِ پٮ۪ٹھ واریاہ مہربان تکیازِ سُہ چُھ اسہِ واریاہ لول بران۔
\v 5 خداین بوٚر اسہِ واریاہ لول سُتہ ییٚلہِ أسؠ روحٲنی طور مودمٕتؠ ٲسؠ تہٕ لگاتار گناہ کران ٲسؠ، تٔمؠ کٔرؠ أسؠ مسیحؔ ہس سٟتؠ رلنہٕ باپتھ زنٛدٕ۔ یاد تھٲیِو، ییٚلہِ خداین توٚہؠ روحٲنی طور مرنہٕ نِشہ بچٲیو، سُہ اوس توٚہہِ سٟتؠ واریاہ مہربان تِتھٕ پٲٹھؠ یمِکؠ نہٕ توٚہؠ حقدار ٲسِو۔
\v 6 خداین بچٲوؠ أسؠ روحٲنی طور مرنہٕ نِشہ تِتھے پٲٹھؠ یِتھٕ پٲٹھؠ تٔمؠ یسوع جسمٲنی طور مرنہٕ نِشہ بچوو تہٕ تٔمؠ تھٲوؠ أسؠ روحٲنی طور پانس سٟتؠ زندٕ۔ پتہٕ دِژ تٔمؠ اسہِ اعزازچ نِشستہٕ یسوع مسیحؔ ہس سٟتؠ آسمانس منٛز حکمرٲنی کرنہٕ باپتھ۔
\v 7 تٔمۍ کوٚر یہٕ پرٮ۪تھ کٲنسہِ ہاونہٕ باپتھ یِنہٕ وٲلِس پرٮ۪تھ وقتس منٛز زِ سُہ کوتاہ مہربان چُھ یسوع مسیحؔ ہس سٟتؠ سون شٲمل گژھِتھ۔
\v 8 لہٰذا اوس خدا توٚہہِ پٮ۪ٹھ تِتھٕ پٲٹھؠ واریاہ مہربان یتھ زن نہٕ توٚہؠ مستحق ٲسِو ییٚلہِ تٔمؠ توٚہؠ روحٲنی طور مرنہٕ نِشہ بچٲیو۔ تٔمؠ کوٚر یہِ اوٕ موجُب تکیازِ توٚہؠ چُھو یسوع ہس پٮ۪ٹھ بھروسہٕ کران۔ توٚہہِ چُھنہٕ پنُن پان پانہٕ بچومُت۔ یِہ چُھ خدایہِ سٕنٛدِ طرفہٕ تحفہٕ۔
\v 9 اکھ تحفہٕ یُس نہٕ کانٛہہ تہِ ہیٚکہِ کمٲوِتھ، لہٰذا ہیٚکہِ نہٕ کانٛہہ تہِ فخر کٔرِتھ تہٕ ؤنِتھ زِ تٔمؠ چُھ پنُن پان بچومُت۔
\v 10 لہٰذا چُھ خدا اسہِ تی بناوان یہِ سُہ یژھان چُھ؛ یسوع مسیحؔ سٕنٛدِ ذریعہ چُھ تٔمؠ أسؠ بنٲومٕتؠ نٔوؠ لوٗکھ اصل کامہِ کرنہٕ باپتھ تِم چیز یِمن ہُنٛد خداین سانہِ باپتھ گۅڈے بندوبست اوس کوٚرمُت۔
\v 11 لہٰذا، یاد تھٲیِو زِ توٚہؠ غٲر یہُودؠ لوٗکھ تُہنٛدیو جدٕاجدادو مطٲبق ٲسِو نہٕ خدایہِ سنٛدٮ۪ن لوٗکن سٟتؠ تعلق تھاوان۔ یہُودیو کٔر توٚہہ "غٲر ختنہٕ" ؤنِتھ توٚہہ بےعزتی۔ تم چھِ پننس پانس "ختنہٕ دار" ونان۔ امہِ سٟتؠ چُھ یہُنٛد مطلب زِ تم چھِ خدایہِ سٕنٛدؠ لوٗکھ، نَہ زِ توٚہؠ، حالانکہ ختنہٕ چُھ سُہ چیز یُس انسان چُھ کران یُس صرف جسمس تبدیل چُھ کران، نَہ کہ تیوٚتھ کینٛہہ چیز یُس خدا چُھ کران یُس روح تبدیل چُھ کران۔
\v 12 یاد تھٲیِو، تٔمہِ وِزِ ٲسِو توٚہؠ مسیحؔ ہس نِش الگ گٔمٕتؠ۔ توٚہؠ ٲسِو اسرائیلی لوٗکن باپتھ غٲر ملکی۔ توٚہہ نیو نہٕ تِمن چیزن منٛز حصہٕ یِمن ہُنٛد وعدٕ خداین تِمن سٟتؠ پننٮ۪ن معاہدن منٛز اوس کوٚرمُت۔ توٚہہِ کٔرِو نہٕ بھروسہٕ سان امید زِ خدا کیا بچاوِ توٚہہِ، نَہ، توٚہؠ ٲسِو خدایہِ سٕنٛدِ ورٲے پوٗرٕ پٲٹھؠ یتھ دنیاہ ہَس منٛز روزان۔
\v 13 مگر وۅنؠ، کٔروٕ توٚہؠ خداین امسنٛدِس عیالس منٛز شٲمل، تکیازِ توٚہہِ چُھو یسوع مسیحؔ ہس پٮ۪ٹھ بھروسہٕ کوٚرمُت، حالانکہ امہِ برونٛہہ ٲسؠ وون نہٕ توٚہؠ یہِ زانان۔ یہِ اوس ممکن تکیازِ مسیحؔ مود صلیبِ پٮ۪ٹھ تہنٛدِ باپتھ۔
\v 14 یہٕ پانہٕ مسیحؔ یمؠ یہُودینؔ تہٕ غأر یہُودینؔ باپتھ اکھ أکس سٟتؠ پُر امن طریقہٕ روزُن ممکن بنوو۔ تٔمؠ بناوِ زٕ بیوٚن بیٚون جمٲژٕ کُنی جماتھ۔ دۅشوے جمٲژ آسہٕ اَکھ أکِس نفرت کران، مگر تٔمۍ تُل اکھ أکِس نفرتُک پرٛتھ وجہ الگ ییٚلہِ سُہ اسہِ سارنٕے خٲطرٕ مود۔
\v 15 تٔمؠ بنوو نہٕ وۅنؠ یہٕ سانہِ باپتھ ضروری زِ أسؠ کرو یہُودی شریعتکٮ۪ن حکمن تہٕ تقاضن ہنٛز اطاعت تاکہِ سُہٕ کرِ اسہِ قبول۔ تٔمؠ کوٚر یہٕ یہُودؠ تہٕ غٲر یہُودؠ لوٗکھ نویٚن لوٗکن منز تبدیل کرنہٕ خٲطرٕہ یِم یِکوٹہٕ امنہٕ سان روزن تِمس سٟتؠ پنن تعلق قٲیم کرنہٕ سببہٕ۔
\v 16 تٔمؠ کوٚر یہِ تِمن دۅشوٕنؠ جمٲژن خدایس سٕتؠ رلاونہٕ خٲطرٕہ کُنی جماتھ بنٲوِتھ ییٚلہِ سُہ تِمن سارنےٕ ہندِ خٲطرٕ صلیبہِ پٮ۪ٹھ مود۔ تُہنٛدِ باپتھ مرنہٕ سٟتؠ بنوو یسوع ممکن زِ تمن گژھِ روٚٹ اکھ اکؠ سنٛدؠ تہٕ خدایہِ سنٛدؠ دشمن بننس۔
\v 17 یسوع آو تہٕ کوٚرُن خوش خبری ہُنٛد اعلان زِ أسؠ ہیٚکو خدایس سٟتؠ امنہٕ سان روزِتھ۔ تٔمؠ کوٚر یہٕ اعلان توٚہہِ غٲر یہُودینؔ سٟتؠ، یِمنہٕ خدایس متعلق زانان ٲسؠ، تہٕ اسہِ یہُودینؔ، یم خدایس متعلق زانان ٲسؠ۔
\v 18 امہِ وجہ کِنؠ یہ یسوعنؔ اسہِ باپتھ کوٚر، یہُودؠ تہٕ غٲر یہُودؠ دۅشوے ہیکن وۅنؠ خدایہِ سٕنٛدِ روح کہ مدتہٕ سٟتؠ بب خدایس نِش یِتھ۔
\v 19 لہٰذا چُھو نہٕ وۅنؠ توٚہؠ غٲر یہُودؠ ایماندار خدایہِ سنٛدیو لوٗکو نِش الگ تراونہٕ یوان، مگر امہِ بجایہ چُھو توٚہؠ تِمن لوٗکن ہنٛدؠ سٲتھی یِم خداین پننہِ خٲطرٕہ الگ چھِ کٔرؠ مٕتؠ، تہٕ توٚہؠ چُھو خدایہِ سٕنٛدِس خاندانس سٕتؠ تعلق تھاوان۔
\v 20 توٚہؠ چُھو تِمن کنٮ۪ن ہنٛدؠ پأٹھؠ یِمہٕ خداین أکِس عمارژ منٛز یِکوٹہٕ چھےٚ تھاومژٕ، تہٕ رسول تہٕ نبی چھِ امہِ عمارژ ہنٛزن کٕنہٕ کنٮ۪ن ہنٛدؠ پٲٹھؠ۔ توٚہؠ چُھو تہنٛدِس ہیچھنٲوؠ مٕتِس پٮ۪ٹھ منحصر، یتھٕ پٲٹھؠ عمارژ ہنٛزٕ کنہِ تِمن بوٚنمٮ۪ن کٕنہٕ کنٮ۪ن پٮ۪ٹھ منحصر چھےٚ آسان یِمہٕ اکھ سیٚود تہٕ مضبوط دیوار بناوان چھِ۔ یسوعؔ مسیحؔ چُھ پانہٕ زن کُنہِ کنہِ ہنٛدؠ پٲٹھؠ، یۅسہٕ عمارژ ہنٛز اکھ اہم کٔنؠ چھےٚ۔
\v 21 یسوعؔ چُھ یمہِ کتھہِ ہُنٛد فٲصلہٕ کران زِ پرٮ۪تھ شخص کتھ سٟتؠ چُھ تعلق تھاوان، یتھٕ پٲٹھؠ اکھ کوٗنہٕ کٔنؠ چھےٚ یمہِ کتھہِ ہُنٛد فٲصلہٕ کران زِ عمارژ منٛز کۅس کٔنؠ کتہِ شوٗبہِ۔ یتھٕ کِنؠ اکھ عمارت بناون وول کنہِ یِکہٕ وٹہٕ جوڑان چُھ اکھ پاک ہیکل بناونہٕ خٲطرٕ، یسوع چُھ پننہِ خاندانکٮ۪ن مومِنن یِکہٕ وٹہٕ اکھ کُنی پاک جماتھ بننہٕ خاطرٕ جمع کران یۅسہ خداوند سنٛز خدمت کرِ۔
\v 22 تکیازِ توٚہؠ چُھو یسوع ہس سٟتؠ تعلق تھاوان، سُہ چُھو توٚہہ یہوٗدٮ۪ن تہٕ غٲر یہوٗدٮ۪ن دۅشوٕنؠ یکوٹہٕ أکِس خاندانس منز انان یۅسہٕ اکہِ عمارژ ہنٛدؠ پٲٹھؠ چھےٚ یتھ منز خدا پننہِ روح کہِ ذریعہ روزان چُھ۔
\c 3
\p
\v 1 تکیازِ خدا چُھ اتھ منصوبس پٮ۪ٹھ توٚہہِ غٲر یہودٮ۪ن خٲطرٕہ کٲم کران، بہٕ پولُسؔ چُھس ببس دعا منٛگان توٚہہِ خٲطرٕ یوٚدوے بہٕ جیلس منٛز تہِ چُھس تکیازِ بہٕ چُھس تہنٛدِ باپتھ یسوعؔ مسیحؔ سنٛز خدمت کران۔
\v 2 بہٕ چُھس انٛدازٕ کران زِ لوٗکو چُھ توٚہہ میٲنِس بارس منٛز ووٚنمُت، زِ خداین چھےٚ مےٚ توٚہہِ غٲر یہودٮ۪ن سٟتؠ انتہٲئی مہربان روزنکہِ منصوبچ کتھ باتھ کرنٕچ کٲم دِژمٕژ۔
\v 3 خداین ووٚن مےٚ یہٕ پٲغام یُس نہٕ لوکو گۅڈٕ سمُجھ تہٕ مےٚ سیٚدِ سیٚود ظٲہر اوس کوٚرمُت، یتھ پٲٹھؠ زَن مےٚ توٚہہِ مختصرن گۅڈے لیٚوکھمُت اوس۔
\v 4 ییٚلہ توٚہؠ سُہ پٔریٚو، توٚہؠ ہیٚکو محسوس کٔرتھ زِ بہٕ چُھس واضیح پٲٹھؠ تِم چیز سمجھان یم نہٕ خداین مسیحؔ ہس متعلق گۅڈٕ ٲسؠ ظٲہر کٔرمٕتؠ۔
\v 5 گۅڈنیٚتھ اوس نہٕ خداین یہٕ پٲغام لوٗکن برونٛہہ کنہِ پورٕ پٲٹھؠ ظٲہر کوٚرمُت، مگر وۅنؠ چُھ تمسنٛدؠ روحن یہٕ پننیٚن پاک رسولن تہٕ نبین نِش ظٲہر کوٚرمُت۔
\v 6 پٲغام چُھ یتھ کِنؠ: غأر یہُودؠ چھِ وۅنؠ یہُودٮ۪ن سٕتؠ خدایہِ سنٛدِ روحٲنی دولتُک اِشتراک کران تہٕ خدایہِ سنٛدٮ۪ن لوٗکن ہنٛزِ تٔتھؠ جمٲژ سٟتؠ تعلق تھاوان تہٕ تِمن تمام چیزن ہُنٛد کرن اِشتراک یمن ہُنٛد خداین پننٮ۪ن لوٗکن سٟتؠ وعدہ چُھ کوٚرمُت تکیازِ تِم چھِ شٲمل گٔمٕتؠ یسوع مسیحؔ ہس سٟتؠ رٕژ شیٚچھِ پٮ۪ٹھ یقین کرنہٕ کِس نتیجس منٛز۔
\v 7 بہٕ چُھس وۅنؠ لوٗکن یہِ اصل خبر ؤنِتھ خدایہِ سنٛز خدمت کران۔ خدا اوس مےٚ پٮ۪ٹھ واریاہ مہربان تہٕ دِژن مےٚ یہٕ کٲم کرنہٕ خٲطرٕ حالانکہ بہٕ چُھس نہٕ اتھ لائق، تہٕ سُوٛ چُھ مےٚ یہٕ کٲم طاقتہٕ سان کرنس قٲبل بناوان۔
\v 8 یوٚدوے خدایہِ سنٛدیو ساروٕے لوکو منٛزٕ بہٕ کم پایہ چُھس، خداین دیُت مہربٲنی کٔرتھ مےٚ یہِ تحفہٕ: تٔمؠ کوٚرُس بہٕ تعینات نہ ختم گژھن واجنہِ روحٲنی برکتن ہنٛز خوشخبری ہُنٛد اعلان کرنہٕ باپتھ یۅسہ مسیحؔ ہس اسہِ خٲطرٕ چھِ
\v 9 تہٕ پرٮ۪تھ کانٛہہ یہٕ سمجھنس قٲبل بناوُن زِ خدایہ سُنٛد منصوبہ کیا چُھ۔ یہٕ منصوبہ چُھ سُہ کینٛہہ یُس خداین، یمؠ پریتھ کانٛہہ چیز پٲدٕ کور، واریاہ برونٛہہ پوشیدٕ تھوومُت اوس۔
\v 10 خدایس اوس یہٕ منصوبہ تاکہ یُتھےٕ سُہ یہِ ظٲہِر کرِ وۅنؠ تِمن لوٗکن منٛز یِم مانن وٲلؠ چھِ، سُہ چُھ اعلیٰ سطحن پٮ۪ٹھ روحٲنی حکامن تہِ یہِ ظٲہر کران زِ سُہ کوتاہ تھوٚد عقلمند چُھ۔
\v 11 یہٕ چُھ سُہ منصوبہ یُس خدایس ہمیشہٕ چُھ رودمُت، تہٕ یہٕ چُھ سُہ یُس تٔمؠ سٲنِس خداوند، یسوع مسیحؔ سنٛزِ کامہِ ذریعہ پورٕ کوٚر۔
\v 12 لہٰذا وۅنؠ، ہیٚکو أسؠ یسوع سنٛزِ کامہِ ہنٛدِ سٟتؠ آزادانہٕ تہٕ اعتمادٕ سٟتؠ خدایس نزدیک یِتھ تکیازِ ییٚلہِ أسؠ یسوع ہس پٮ۪ٹھ بھروسہٕ کران چھِ، سُہ چُھ اسہِ پانس سٟتؠ شٲمل کران۔
\v 13 لہٰذا مہربٲنی کٔرِتھ مہٕ گٔژھِو تِمَو چیزو سٟتؠ پس ہمت یِم مےٚ یتہِ تُہنٛدِ طرفہٕ جیلَس منٛز وؠتراوٕنؠ پیوان چھِ، تکیازِ تِم چھِ توٚہہِ خٲطرٕ اکھ شاندار نتیجہٕ پٲدٕ کران۔
\v 14 تکیازِ خداین چُھ توٚہہِ خٲطرٕ یہِ سورےٕ کوٚرمُت، بہٕ چُھس کۅٹھٮ۪ن پٮ۪ٹھ وسِتھ پننِس بب خدایس دُعا منٛگان۔
\v 15 سُہ چُھ اصلی بب، یمؠ آسمانس تہٕ زمینس پٮ۪ٹھ پرٮ۪تھ خاندانس پٲروی کرنہٕ خاطرٕ نمونہٕ دیُت۔
\v 16 بہٕ چُھس دعا کران زِ خدا دِیہ توٚہہِ پنُن روح تُہنٛد روح مضبوط کرنہٕ خٲطرٕ زِ سُہ کوتاہ عظیم چُھ کثرت سان۔
\v 17 بہٕ چُھس دعا کران زِ مسیحؔ روزِ توٚہہِ پنٮ۪ن دِلن ۂنٛدؠ پٲٹھؠ نزدیک تکیازِ توٚہؠ چُھو أمِس پٮ۪ٹھ بھروسہٕ کران، تہٕ تہِ سورےٕ کینٛہہ یہِ توٚہؠ کٔرِو تہٕ ؤنِو آسہِ توٚہہِ خٲطرٕ خدایہِ سٕنٛدِ لولُک تہٕ تٔمِس تہٕ باقین خٲطرٕ تُہنٛدِ لولُک نتیجہٕ
\v 18 تاکہ توٚہؠ ہیٚکو خدایہِ سنٛدٮ۪ن تمام لوٗکن سٟتؠ پوٗرٕ پٲٹھؠ سمجِتھ زِ مسیحؔ کوتاہ لول چُھ اسہِ بران۔
\v 19 بہٕ چُھس دُعا کران زِ توٚہہِ لگہ پتاہ زِ مسیحؔ کوتاہ چُھ لول بران، حالانکہ سُہ چُھ اسہِ یوٗتاہ لول بران زِ أسؠ ہیٚکو نہٕ یہِ سمجِتھ۔ بہٕ چُھس دُعا کران زِ خدا دِیہ توٚہہِ پرٮ۪تھ کُنہِ چیزُک پوٗرٕ پیمانہٕ یہِ سُہ چُھ۔
\v 20 خدایہِ سٕنٛدؠ کٔرِو تعریٖف، یُس تٔمہِ کُنہِ تہِ چیزٕ کھۅتہٕ زیادٕ کٲم کرنس قٲبل چُھ یۅسہٕ أسؠ أمِس ونان چھِ، یا تہِ یہِ أسؠ سونچان چھِ زِ سُہ ہیٚکہِ کٔرِتھ، تکیازِ سُہ کٔمہِ طاقتہٕ چُھ اسہِ اندر کٲم کران!
\v 21 سٲری ایمان وٲلؠ گژھن تمسنٛدؠ تعریف کرٕنؠ زِ سُہ کوتاہ عظیم چُھ تہٕ تمؠ سنٛزِ زبردست کامہِ ہنٛدؠ یۅسہٕ تٔمؠ کٔرمٕژ چھےٚ مسیحؔ یسوع سٕنٛدِ ذریعہ! تِم گژھن سٲری نسٕل ہمیشہٕ خٲطرٕ امسنٛدؠ تعریٖف کرٕنؠ! یہِ گژھہِ آسُن۔
\c 4
\p
\v 1 تکیازِ یِمَو سارِوٕے کِنؠ، بطورِ کٲنٛسہِ یُس جیلس منٛز چُھ تکیازِ بہٕ چُھس خداوند یسوع سنٛز خدمت کران، بہٕ چُھسو توٚہہِ تلقیٖن کران تِتھٕ پٲٹھؠ زِنٛدگی گزارنچ یمہِ ستٟؠ یسوعس احترام سپدِ، یمؠ توٚہؠ أمؠ سٕنٛدِ خٲطرٕ زِنٛدٕ روزنہٕ خٲطرٕ بُلایو۔
\v 2 ہمیشہٕ روزیٚو عٲجزی تہٕ نرمی سان۔ اکھ أکِس سٟتؠ روزیٚو صبرٕ سان تہٕ تِم پریشان کرن وٲلؠ چیٖز کٔرِو برداشت یِم باقےٕ کران چھِ تکیازِ توٚہؠ چُھو اکھ أکِس لول بران۔
\v 3 چونکہ خدایہِ سٕنٛدؠ روحن چُھو توٚہؠ یِکہٕ وٹہٕ کٔرؠ مٕتؠ، اکھ أکِس سٟتؠ یِکہٕ وٹہٕ روزنہٕ باپتھ کٔرِو پرٮ۪تھ کانٛہہ چیز یُس توٚہؠ کٔرِتھ ہیٚکو۔ اکھ أکِس سٟتؠ امنہٕ سان کٲم کٔرِتھ تھٲیِو پنُن پان پابنٛد۔
\v 4 خدایس چُھ صرف اکھ خاندان ایمان والیٚن ہُنٛد تہٕ اکھ پاک روح، یتھٕ کِنؠ زن سُہ توٚہہِ سارنےٕ اکھ تہٕ واحد چیز حأصل کرنہٕ خاطرٕ چُھ ونان یمِچ لوکھ امید ہیٚکن کٔرِتھ، سُہ چُھ توٚہہِ سٟتؠ تعلق تھاوان یِم خداین بُلاے مٕتؠ چھِ۔
\v 5 یتہِ چُھ صرف اکھ خداوند، یسوع مسیحؔ، أمِس پٮ۪ٹھ یقین کرنُک صرف اکھ طریقہٕ، تہٕ تمو کوٚر اسہِ یہٕ ظٲہر کرنہٕ خٲطرٕ بپتسمہ زِ أسؠ چھِ صرف أمِس سٟتؠ تعلُق تھاوان۔
\v 6 اکُے خدا چُھ، یُس اسہِ سارنےٕ ہُنٛد بب چُھ، چاہے یہُودؠ ٲسؠ تن یا غٲر یہُودؠ۔ سُہ چُھ اسہِ سارنےٕ پٮ۪ٹھ حکومت کران، اسہِ سارنےٕ ذریعہ کٲم کران، تہٕ چُھ اسہِ سارِنےٕ منٛز۔
\v 7 اسہِ منز چھِ پرٮ۪تھ کٲنسہِ خداین روحٲنی تحفہٕ دِتمٕتؠ یتھٕ کِنؠ مسیحؔ ہن چُھ فٲصلہٕ کوٚرمُت زِ اسہِ گژھن تِم آسٕنؠ۔
\v 8 یہٕ چُھ اوٕ کِنؠ زِ صحیفن منٛز چُھ لیٚکھِتھ، یُتھےٕ سُہٕ تھزرس پٮ۪ٹھ ووت، تٔمؠ أنؠ پانس سٟتؠ واریاہ لوٗکھ یِم تٔمؠ رٔٹِتھ ٲسؠ أنؠ مٕتؠ، تہٕ دِتِن پننٮ۪ن لوٗکن تحفہٕ۔\f + \fr 4‏:8 \ft عبرانین 2:9، یوحنا 3:13\f*
\v 9 لفظ "سُہ ووت تھزرس" چھِ اسہِ یقیناً زٲنؠ راوان زِ مسیحؔ تہِ اوس امہِ برونٛہہ زمین کیٚن بوٚنمٮ۪ن حِصن تام گومُت۔
\v 10 مسیحؔ، یُس آسمانہٕ پٮ۪ٹھٕ زمینس پٮ۪ٹھ آو، سُہ تہِ چُھ سُہ یُس آسمانس منٛز ساروے کھۅتہٕ زیادٕ تھدِس مقامس پٮ۪ٹھ ہیٚور کُن واپس کھۅت تاکہ سُہ ہیٚکہٕ کایناتس بھٔرِتھ۔
\v 11 پننٮ۪ن لوٗکن تحفہٕ رٔنٛگؠ کٔرؠ تٔمؠ یِمن منٛز کینٛہہ رسول مقرر، کینٛہہ نبی بننہٕ خاطرٕ، کینٛہہ لوکن یسوعس متعلق خوش خبر وننہٕ خاطرٕ، تہٕ کینٛہہ ایمان والیٚن کینژھن ایمان والین جمٲژن ہُند خیال تھاونہٕ تہٕ تِمن تعلیم دِنہٕ خاطرٕ۔\f + \fr 4‏:11 \ft 2 کورنتھین 12:29، 29\f*
\v 12 خداین کٔرؠ تِم سٲری خدایہ سٕنٛدؠ لوٗکھ مقرر باقین خدمت کرنہٕ خٲطرٕ تاکہِ سٲری لوٗکھ یِم مسیحؔ ہس سٟتؠ تعلُق چھِ تھاون گژھن روحٲنی طور مضبوط۔
\v 13 یہِ کٲم روزِ تۅتام جٲری یوٚتام نہٕ أسؠ سٲری یِکوٹہٕ تہِ بنَو یہِ خدا چُھ یژھان: ییٚلہِ أسؠ یِکوٹہٕ خدایہِ سنٛدِس گۅبرِس پٮ۪ٹھ پوٗرٕ پأٹھؠ بھروسہٕ چھِ کران تہٕ اسہِ منٛزٕ امسُنٛد کأم کرنُک تجربہٕ چُھ کران، تہٕ مکمل پٲٹھؠ چھِ ایماندارن ہنٛزِ اکہِ جمٲژ رنٛگؠ پۅختہٕ سپدان، خدایس پٮ۪ٹھ بھروسہٕ کرنس تہٕ سُہ زاننس منٛز مکمل پٲٹھؠ پۅختہٕ سپدِتھ یتھٕ پٲٹھؠ پانہٕ مسیحؔ چُھ۔
\v 14 تیلہٕ روزو نہٕ أسؠ روحٲنی طور نابالغ، یتھٕ پٲٹھؠ لۅکٕٹؠ شُرؠ چھِ نابالغ آسان۔ أسؠ کرَو نہٕ وۅنؠ پرٮ۪تھ نوِ تعلیمہ ہنٛز پٲروی، ہمیشہٕ یہٕ تبدیلی روزان گژھان یُس أسؠ أکِس ناوِ ۂنٛدؠ پأٹھؠ یقین چھِ کران یُس اکہٕ تہٕ بیٚیہِ طرفہٕ چُھ گژھان ییٚلہِ ہوا تہٕ لہرٕ چھےٚ سِمت تبدیل کران۔ أسؠ دِمو نہٕ چالاک لوٗکن اجازت یِم تہِ ہیٚچھناوان چھِ یہِ غلط چُھ تہٕ چھِ اسہِ پننہِ اپزِ سٟتؠ دھوکہٕ دِوان۔
\v 15 امہِ بجایہ، ییٚلہ أسؠ اکھ أکِس سٟتؠ لولہٕ ہوٚت سۅ کتھ چھِ کران یہِ پوٚز چُھ، أسؠ گژھو ہر طریقہٕ زیادٕ کھۅتہٕ زیادٕ مسیحؔ سٕنٛدؠ پأٹھؠ بنٕنؠ یتھٕ پٲٹھؠ سُہ اسہِ ہدایت چُھ دِوان، یتھٕ پٲٹھؠ أکِس شخصہٕ سُنٛد کلہٕ تٔمسٕنٛدِس جسمس ہدایت چُھ دِوان۔
\v 16 سُہ چُھ سُہ یُس اسہِ سارِنےٕ یِکہٕ وٹہٕ شٲمل چُھ کران تہٕ چُھ اسہِ اَکھ أکِس سٟتؠ جوران۔ سُہ چُھ اسہِ ہیٚچھناوان اکھ أکِس کِتھہٕ پٲٹھؠ چُھ سہارٕ دیُن تہٕ مربوط طریقہٕ کِتھہٕ پٲٹھؠ چھےٚ کٲم کرٕن تکیازِ سُہ چُھ سۅ صلٲحیت دِوان یۅسہٕ اسہِ پرٮ۪تھ کٲنٛسہِ خٲطرٕ موزوٗن چھےٚ، یتھٕ پٲٹھؠ أکِس شخصہٕ سُنٛد کلہٕ چُھ تسٕنٛدِٮ۪ن جسمہٕ کٮ۪ن تانن باپتھ کران۔ یتھٕ پٲٹھؠ، یتھٕ کِنؠ أسؠ اکھ أکس سٟتؠ لول چھِ بران، أسؠ گژھو یِکوٹہٕ بڑان تہٕ اکھ أکس مضبوط بناوان۔
\v 17 امہِ وجہ سٟتؠ، تہٕ خداوند یسوع سُنٛد اختیارٕ سٟتؠ، چُھسو بہٕ توٚہہ یہِ ونان: وُنکہِ پٮ۪ٹھٕ پزٕ نہٕ توٚہہ تتھٕ پٲٹھؠ روزُن یتھٕ پٲٹھؠ باقے غٲر یہوٗدی روزان چھِ۔ یتھٕ پٲٹھؠ تِم روزان چھِ چُھ سونٛچنہ کہِ خٲلی طریقہٕ سٟتؠ یِوان۔
\v 18 تم چُھنہٕ واضیح پٲٹھؠ سونٛچِتھ ہیٚکان زِ کیا چُھ صحیح یا غلط تکیازِ تم چھِ خدایس نِشہ مکمل پٲٹھؠ الگ زندگی گزارنچ کوشش کران۔ تم چھِ یہِ کران تکیازِ تِمن چھنہٕ پتاہ زِ تِمن کمہِ چیزچ چھِ کمی تہٕ تِم چھِ ہٹدرمی سٟتؠ خدایہِ سنٛز فرمانبردٲری کرنس انکار کران۔
\v 19 تِم چُھنہٕ یہِ سمجھتھےٕ ہیٚکان زِ کیا کانٛہہ چیز چھا اصل یا خراب، تہٕ امہِ موجُب چُھ تِمو پنُن پان تِمن شرمناک کامہِ کرنہٕ خاطرٕ وقف کوٚرمُت یمہٕ یہُنٛد جِسم یژھان چُھ۔ تم چھِ پرٮ۪تھ قسمٕکؠ غٲر اخلٲقی اعمال کران تہٕ تِم چھِ یِمن کامٮ۪ن زیادٕ کھۅتہٕ زیادٕ کرُن یژھان۔
\v 20 مگر ییٚلہ توٚہہ مسیحؔ ہس متعلق معلوم گوو توٚہہ چُھنہٕ یتھٕ کِنؠ زِندٕ روزُن ہیٚچھمُت،
\v 21 اتھ حدس تام زِ توٚہہِ چُھو یسوع ہس متعلق پٲغام بوزمُت تہٕ سمجھمُت تہٕ تمِس نِش ہیٚچھمُت، تکیازِ تٔمسُنٛد طریقہٕ چُھ زندٕ روزنُک حقیقی طریقہٕ۔
\v 22 تُہنٛدٮ۪و وۅستادو ہیٚچھنٲیو توٚہؠ تِتھٕ پٲٹھؠ روزُن بند کرُن یتھٕ پٲٹھؠ توٚہؠ روزان ٲسِو۔ تکیازِ توٚہؠ ٲسِو بُرٕ کامہِ کرنہِ یژھان، توٚہہِ دِتُو یہِ سونٛچِتھ پننِس پانس دھوکھہٕ زِ تِم چیٖز ٲسؠ اصل۔ یتھٕ پٲٹھؠ روزُن اوس توٚہہِ روحٲنی طور تباہ کران۔
\v 23 لہٰذا پزیٚو توٚہہِ خدایس اکھ نوو روح تہٕ سونٛچنُک اکھ نوٚو طریقہٕ بخشنُک موقعہ دیُن۔
\v 24 تہٕ توٚہہِ پزِ تمِس نٔوِس شخصہٕ سٕنٛدؠ پٲٹھؠ زندٕ روزُن شروع کرُن یُس خداین پننہِ بنن واجنہِ صورٔژ پؠٹھ پٲدٕ کۅر۔ تٔمؠ بنٲیو توٚہؠ اکھ أکِس سٟتؠ تہٕ پانس سٟتؠ، یسوع سٕنٛدؠ پٲٹھؠ صحیح تہٕ پزِ طریقہٕ زندگی گزارنہٕ خٲطرٕ، \f + \fr 4‏:24 \ft کولوسین 3:10، 2 کورتھین 5:17\f*
\v 25 تہٕ اکھ أکِس اپُز وننہٕ نِشہ روزیٚو لوٚب۔ اَکھ أکِس سٟتؠ کٔرِو پزرٕ سان کتھ تکیازِ أسؠ چھِ خدایہِ سٕنٛدِ خاندانکؠن رُکُنن ہندِ رنگؠ اَکھ أکِس سٟتؠ رشتہٕ تھوان۔\f + \fr 4‏:25 \ft کولوسین 3:9، رومین 12:5، ذکریاہ 8:16\f*
\v 26 غصہٕ کرِو گناہ کِس وطیرس پٮ۪ٹھ، مگر گناہ مہٕ کٔرِو تکیازِ توٚہہِ چُھو شرارتہٕ ہتؠ۔ پرٮ۪تھ دوٚہہ لوسنہٕ برونٛہہ کٔرِو یہِ خیال زِ توٚہہِ کٔمؠ چیزن کھول شرارت۔\f + \fr 4‏:26 \ft زبور 4:4 \f*
\v 27 تاکہ توٚہؠ دِیو نہٕ شیطانس پانس درمیان بُرٕ کٲم کرنُک اجازت۔
\v 28 یِم ژوٗر چھِ کران تِمن پَزِ نہٕ وۅنؠ ژوٗر کرٕنؠ۔ امہِ بجایہ پزِ تِمَن محنتہٕ سان کٲم کرٕنؠ، پننہِ کوششہِ سٟتؠ اصل کٲم کرٕنؠ تاکہِ تِمَن نِش آسہِ تِمَن لوٗکن دِنہٕ خٲطرٕ کینٛہہ یِم ضروٗرت منٛد چھِ۔
\v 29 نقصان دہ کتھہٕ مہٕ کٔرِو۔ امہِ بجایہ کٔرِو اصل کتھ یِم لوٗکن حوصلہٕ افزٲیی کرن یمہِ ساعتہٕ تِمن مدتٕچ ضروٗرت پیٚیہ تاکہِ خدا ہیٚکہِ تُہٕنٛدٮ۪و کتھو ذریعہ تِمن فٲیدٕ واتنٲوِتھ یِم بوزان چھِ۔
\v 30 خداین چُھنو توٚہؠ پاک روح دِتھ پانس کُن منصوب کٔرؠ مٕتؠ، یُس توٚہہِ سٟتؠ تتھ دوٚہس تام روزِ ییٚلہِ مسیحؔ توٚہہِ یمہِ دُنیا نِش بچاوٕ۔ توَے مہٕ کٔرِو خدایہِ سُنٛد روح القدس غمگین امہِ سٟتؠ زِ یتھٕ پٲٹھؠ توٚہؠ زِنٛدٕگی چُھو بسر کران۔\f + \fr 4‏:30 \ft افسینؔ 1:13، 14، یسعیاہؔ 63:10\f*
\v 31 پننہِ طرفہٕ کٔرِو بہتر کوشش یتھٕ پٲٹھؠ برتاو کرُن بنٛد کرنہٕ خٲطرٕ: باقین سٟتؠ مہٕ گٔژھِو ناراض یا مہٕ کٔریِو شرارت۔ باقین پٮ۪ٹھ مہٕ کٔرِو بدسلوکی یا تہنٛز بدنٲمی۔ زانہہ تہِ مہٕ کٔرِو کُنہِ تہِ طریقہٕ بدنیتی سان کٲم۔
\v 32 یتھٕ پٲٹھؠ پیش یِنہٕ بجایہ، روزیٚو اکھ أکِس پٮ۪ٹھ مہربان۔ اکھ أکِس سٟتؠ یِیو رحمدِلی سان پیش۔ اَکھ أکِس کٔرِو تِتھے پٲٹھؠ معاف یتھٕ کِنؠ خداین توٚہہِ تہِ معافی دِژو یہِ زن مسیحؔ ہن توٚہہِ خٲطرٕ کوٚر۔
\c 5
\p
\v 1 امہِ کِنؠ یہِ خداین تُہنٛد خٲطرٕ کوٚرمُت چُھ، تِتھے پٲٹھؠ کٔرِو امؠ سُنٛد نقل یتھٕ پٲٹھؠ شُرؠ تمِس مٲلِس نقل کران چھِ یُس تِمن سٮ۪ٹھاہ لول بران چُھ۔
\v 2 پرٮ۪تھ کانٛہہ چیز کٔرِو تِتھٕ پٲٹھؠ یُس یہِ ہٲوتھ دِیہ زِ توٚہؠ چُھو اکھ أکِس لول بران۔ مسیحؔ ہس ہیوؠ بٔنِو، یمؠ اسہِ تیوٗت لول بوٚر زِ سُہ مود پننہِ مرضی سٟتؠ صلیبہِ پٮ۪ٹھ سانہِ باپتھ سانہِ جایہِ خدایہِ سنٛدِ خٲطرٕ قربٲنی رنگؠ۔ امہِ قربٲنی سٟتؠ گو خدا واریاہ خوش۔\f + \fr 5‏:2 \ft یوحنا 13:34، غلتین 2:20\f*
\v 3 مگر کٲنسہِ خٲطرٕ گژھِ نہٕ یہِ وجہ آسُن حتاکہِ تجویز تہِ نہٕ زِ توٚہہِ منٛزٕ گژھہِ کانٛہہ تہِ جنسی گناہ یا کُنہِ تہِ قسمُک غٲر اخلٲقی یا جنونی جنسی رویس منٛز شٲمل۔ یِتھؠ گناہ چُھنہٕ خدایہِ سنٛدٮ۪ن لوٗکن سٟتؠ تعلق تھاوان۔
\v 4 ییٚلہِ توٚہؠ اَکھ أکِس سٟتؠ کتھ کٔرِو، فحش دلیلہٕ مہٕ ؤنِو یا بیوقوفی ہنٛز کَتھٕ یا مذاق مہٕ کٔریِو یمہِ سٟتؠ گناہ سرِزد گژھن۔ یتھؠ چیز چھِ نہٕ تِم لوٗکھ کران یِم خدایس سٟتؠ تعلق چھِ تھاوان۔ امہِ بجایہ کٔرِو تِمن چیٖزن ہُنٛد اِظہار یِمن ہُنٛد توٚہؠ شُکُر گُزار چُھو۔
\v 5 یہٕ چُھ بالکل صحیح زِ یم لوٗکھ یِن مسیحؔ سنٛزِ بادشٲہی منٛز خٲرج کرنہٕ یُس خدا چُھ: پرٮ۪تھ کانٛہہ سُہ یُس جنسی طور غأر اخلٲقی یا ناشٲیستہ چُھ، یا یُس جنسس سٟتؠ دِوان چُھ، چُھ بُت سنٛز عبادت کرنس برابر۔
\v 6 کٲنٛسہِ مہٕ دِیو پانس پٮ۪ٹھ یمہِ دھوکہٕ سٟتؠ ہٲوی گژھنہٕ زِ خدا کیا دِیہ نہٕ یِژھ کٲم کرن والیٚن لوٗکن سزا۔ یِمو چیزو سٟتؠ دِیہ خدا تِمن لوٗکن سزا یِم تس سنٛز نافرمانی چھِ کران۔
\v 7 توَے مہٕ گٔژھِو شٲمل تِمن لوٗکن سٟتؠ یِم امہِ قٕسمٕکؠ گناہ چھِ کران۔
\v 8 یاد تھٲیِو زِ خداوند یسوعس پٮ۪ٹھ یقین کرنہٕ برُونٛہہ ٲس نہٕ توٚہہِ پتاہ زِ پوٚز کیا چُھ، یِتھ کِنؠ تِم لوٗکھ انہِ گٔٹِس منٛز چھِ، یِمن نہٕ پتاہ چُھ زِ تِمن أنٛدؠ پٔکؠ کیا چُھ۔ مگر وۅنؠ چُھ یہِ تیوٗتھ زنٛتہِ توٚہؠ گاشس منٛز آیِوٕ، تکیازِ خداوندن چُھو توٚہہِ ہوومُت زِ کیا چُھ پوٚز۔ لہٰذا گُزٲرِو زندگی تمہِ طریقہٕ یہِ خداوندن توٚہہِ ہوومُت چُھو۔
\v 9 تکیازِ یتھٕ پٲٹھؠ گاش تھاون وٲلؠ لوٗکھ چھِ صحیح طریقہٕ پکان، یسوع زاننہٕ کِس نتیجس منٛز ہیٚکو توٚہؠ ہمیشہٕ اتھ طریقس پٮ۪ٹھ زِنٛدٕ روزِتھ یُس اصل، صحیح تہٕ پوٚز چُھ۔
\v 10 ییٚلہِ توٚہؠ یتھٕ پٲٹھؠ زِنٛدگی گُزٲرِو، تیٚلہِ روزیٚو تہِ ہیٚچھان یہِ خداوندس پسنٛد ییہِ۔
\v 11 لہٰذا، تمن لوٗکن سٟتؠ مہٕ کٔرِو یِکوٹہٕ شرکت یِم فضول کٲم چھِ کران یِم روحأنی انہِ گٔٹِس منٛز چھِ۔ امہِ بجایہ کٔڈؠ وُن پرٮ۪تھ کانٛہہ نوٚن زِ یِم کامہِ کٲژا فضول چھےٚ۔
\v 12 یقیناً چُھ یہِ خدایہِ سنٛدین لوٗکن خٲطرٕ شرمناک زِ تِم کرَن تِمن بُرٕ چیزن مُتعلق کتھ یِم تِم لوٗکھ ژھیپہِ روزِتھ چھِ کران،
\v 13 مگر اسہِ خٲطرٕ چُھ یہٕ ضروری زِ تم کرن تمن بےنقاب تاکہِ لوٗکن لگہ پتاہ تہٕ سمجن زِ یم چھِ بُرٕ اعمال۔ یہ چُھ یتھ کنؠ زِ ییٚلہ أسؠ کانٛہہ چیز گاشس کُن انان چھِ تاکہِ پرٮ۪تھ کٲنسہ یہٕ ظٲہر کرنہٕ خاطرٕ زِ یہ کیا چُھ پٔزؠ پأٹھؠ۔ لوٗکھ ہیٚکن اتھ چیزس معائنہ تہٕ فٲصلہ کٔرتھ زِ یہِ چُھ گاشن بےنقاب کۅرمُت۔
\v 14 خدایس زاننہٕ برونٛہہ ٲسِو توٚہؠ زنتہِ سُہ شخص یمِس نینٛدر ٲس یا اوس أکس انہِ گٹہِ جایہِ مودمُت۔ یہِ چُھ تہِ یہِ زن ایمان وٲلؠ ونان چھِ ییٚلہِ تِم ونان چھِ زِ،
\q "توٚہؠ یِم نینٛدرِ چُھو، بیدار گژھیو!
\q توٚہؠ یِم مودؠ مٕتؠ چُھو، انہِ گٹہِ منٛزٕ نیرِو نٮ۪بر تہٕ زندٕ روزیٚو!
\q مسیحؔ ہایو توٚہہِ زِ پوٚز کیا چُھ،
\q تِتھے پٲٹھؠ یتھٕ پٲٹھؠ اکھ گاش یُس زوتان چُھ تہٕ ہاوان چُھ لوٗکن زِ انہِ گٔٹِس منٛز کیا اوس۔"
\p
\v 15 لہٰذا روزیٚو ہوشیار زِ توٚہؠ کِتھہٕ پٲٹھؠ بٔسِو۔ بیوقوف لوٗکن ہنٛدؠ پٲٹھؠ مہٕ کٔریو برتاو۔ بلکہِ کٔرِو دانا لوٗکن ہنٛدؠ پٲٹھؠ برتاو۔
\v 16 یُس وق توٚہہِ نِش چُھ اتھ منٛز کٔرِو ساروٕے کھۅتہٕ اصل، تکیازِ لوٗکھ چھِ پرٮ۪تھ دوٚہہ زیادٕ کھۅتہٕ زیادٕ بُرٕ کامہِ کران۔\f + \fr 5‏:16 \ft عاموس 5:13، کولوسین 4:5\f*
\v 17 توے روزیٚو دانا پٲٹھؠ، اصل پٲٹھؠ سمجِھو زِ کیا چُھ یہِ خداوند یسوع چُھ یژھان زِ توٚہؠ کٔرِو، تہٕ کٔرِو یہِ!
\v 18 خمار کھالن والہِ شراب چیٚنہٕ سٟتؠ مہٕ بنیٚو شرٲبؠ، تکیازِ لوٗکھ ہیٚکَن نہٕ شراب چٮ۪تھ پنُن پان قوبو کٔرِتھ ییٚلہِ تِم خمارٕ ہتؠ آسن۔ امہِ بجایہ، گژھِ خدایہِ سُنٛد روح قوبو کرُن زِ توٚہؠ کیا چُھو پریتھ وقتس منٛز کران۔\f + \fr 5‏:18 \ft امثال 23:31، 32، غلتین 5:21، 25\f*
\v 19 اکھ أکِس گیوو زبور مسیحؔ ہس متعلق تہٕ تِم بٲتھ یِم خدایہِ سُنٛد روح توٚہہِ بخشان چُھو۔ یہِ ساز گژھہِ توٚہہِ انٛدر پٮ۪ٹھٕ خداوند سٕنٛدؠ پوٗرٕ پٲٹھؠ تعریٖف کرنہٕ خٲطرٕ وُزٕنؠ۔\f + \fr 5‏:19 \ft کولوسین 3:16، 1 کورنتھین 14:26\f*
\v 20 پریتھ وقتہٕ کٔرِو پرٮ۪تھ چیزٕ خٲطرٕ خدا یعنی ببہٕ سُنٛد شُکُر ادا امہِ باپتھ زِ یہِ سٲنؠ خداوند یسوع مسیحؔ ہن چُھ توٚہہِ خٲطرٕ کوٚرمُت۔
\v 21 عٲجزی سان کٔرِو پنُن پان اکھ أکِس تابعہ تکیازِ توٚہؠ چُھو مسیحؔ سُنٛد سٮ۪ٹھاہ احترام کران۔
\p
\v 22‏-23 آشنٮ۪ن پَزِ پننٮ۪ن خانٛدارن ہنٛدِس قیادتس تابعہ گژھُن یتھٕ پٲٹھؠ تِم خداوند یسوعس تابعہ چھِ روزان تکیازِ خاندار چُھ خاندارنہِ ہُنٛد رہنُما تہٕ مسیحؔ تہِ چُھ تمام ایمان والیٚن ہنٛزِ عالمگیر جمٲژ ہُند رہنما۔ سُہ چُھ نجات دِنہٕ وول یمؠ تمام ایمان وٲلؠ تِہنٛدین گنُہَن ہُنٛد سزا پراونہٕ نِشہ بچٲوؠ۔\f + \fr 5‏:22‏-23 \ft کولوسین 3:18، پطرس 3:1، پیدٲیش 3:16 \f*
\v 24 یوٚتام آشنٮ۪ن ہُنٛد تعلُق چُھ، یتھٕ کِنؠ تمام ایمان وٲلؠ پنن پان مسیحؔ سٕنٛدِس اختیارس تابعہ چھِ تھاوان، تِتھے کِنؠ پزِ زنانن تہِ پنن پان پوٗرٕ پٲٹھؠ پننٮ۪ن خاندارن ہنٛدس اختیارس تابعہ کرُن۔
\v 25 توٚہہِ منٛزٕ چُھ پرٮ۪تھ کانٛہہ خاندار پننہِ خاندارنہِ سٟتؠ تیوٗت لول بران یوٗتاہ مسیحؔ تِمن سارِنےٕ سٟتؠ لول بران چُھ یمن تمِس پٮ۪ٹھ پژھ کرن۔ تٔمؠ دِژ سانہِ باپتھ پنٕنؠ زندگی چھپہِ صلیبس پٮ۪ٹھ
\v 26 تاکہِ سُہ ہیٚکہِ اسہِ پننہِ خٲطرٕ الگ کٔرِتھ۔ تٔمؠ کٔرؠ أسؠ پاک پنُن منصوبہ ؤنِتھ تہٕ معاف کٔرِتھ تہٕ سٲنؠ گناہ ہٹٲوِتھ زنتہٕ تِم آبس منٛز چٔھلِن۔
\v 27 تٔمؠ کوٚر یہِ تاکہِ سُہ ہیٚکہِ تمام ایمان والیٚن ہنٛز جماتھ پانس برونٛہہ کُن اکھ شاندار جمٲژ ہنٛدِس صورتس منٛز پیش کٔرِتھ یتھ نہٕ کانٛہہ گناہ یا اخلٲقی خٲمی آسہِ، مگر امہِ بجایہ چُھ پاک تہٕ کٲمل، یتھ کِنؠ زَن اکھ شاندار مہرِنؠ پننِس مہرازس میلنہٕ خٲطرٕہ تیار چھےٚ۔
\v 28 تِتھے پٲٹھؠ پَزِ پرٮ۪تھ نفرس پننہِ خاندارنہِ سٟتؠ تیوٗتا لول برُن یوٗتاہ سُہ پننِس جسمس سٟتؠ لول چُھ بران۔ اکھ شخص یُس پننہِ خاندارنہِ لول چُھ بران سُتہ چُھ یہِ کرنہٕ سٟتؠ پانس زن لول بران
\v 29‏-30 تکیازِ کٲنٛسہِ تہِ چھیٚنہٕ زانہٛہ تہِ پننِس جسمس نفرت کٔرمٕژ۔ امہِ بجایہ، چُھ سُہ پننس جسمس کھیاوان تہٕ امیُک خیال تھاوان، تِتھے پٲٹھؠ یتھٕ پٲٹھؠ زن مسیحؔ تہِ چُھ اسہِ تمام ایماندارن ہُنٛد خیال یتھ عالمگیر جماتس منٛز تھاوان۔ أسؠ چھِ ایمان والیٚن ہنٛز اکھ جماتھ بنیمٕژ یۅسہٕ تس سٟتؠ تعلق چھےٚ تھاوان۔
\v 31 صحیفہٕ چھِ تِمن لوٗکن متعلق یہِ ونان یِم خاندر کران چھِ:
\q "تمہِ کِنؠ تراوِ اکھ نفر پنُن مول تہٕ پنٕنؠ موج تہٕ کرِ پانس پننہِ خاندارنہِ سٟتؠ شٲمل، تہٕ یِم دۅشوے روزن یتھٕ کِنؠ زنتہٕ تِم اکھ نفر ٲسؠ۔"\f + \fr 5‏:31 \ft پیدٲیش 2:24\f*
\p
\v 32 اتھ بارس منٛز چُھ واریاہ کینٛہہ یُس نہٕ أسؠ سمجِتھ ہیٚکو، مگر بہٕ چُھسو توٚہہ ونان زِ خاندار تہٕ خاندارنہٕ ہنٛز یہِ مِثال چھےٚ اسہِ مسیحؔ تہٕ تمِس سٟتؠ تعلق تھاون واجنہِ جمٲژ درمیان تعلقات سمجھنس منٛز تہِ مدد کران۔
\v 33 وۅنؠ گو، تُہنٛدِ مطٲبق پزِ پرٮ۪تھ نفرس پننہِ خاندارنہِ تِتھٕ پٲٹھؠ لول برُن یتھٕ پٲٹھؠ سُہ پانس لول چُھ بران، تہٕ پرٮ۪تھ خاندارنہِ پزِ پننِس خاندار سُنٛد سٮ۪ٹھا احترام کرُن۔
\c 6
\p
\v 1 یۅتام تُہنٛد تعلق چُھ یِم زن شُرؠ چھِ، پننِس مٲلِس ماجہِ ہنٛز کٔرِو اطاعت زنتہٕ خداوند یسوعؔ سنٛز خدمت چُھو کران تکیازِ یہِ کرُن چُھ تہنٛدِ باپتھ صحیح۔
\v 2 خداین دِیُت صحیفن منٛز حکم،
\p "پننِس مٲلِس تہٕ ماجہِ ہُنٛد کٔرِو واریاہ احترام۔ "یہِ چُھ گۅڈنیُک قانون یمیُک حکم خداین دِیُت یتھ منٛز تٔمؠ کُنہِ چیزُک وعدٕ تہِ کوٚر۔ تٔمؠ کوٚر وعدٕ،
\v 3 "اگر توٚہؠ تہِ کٔرِو، تیٚلہِ ہیٚکِو توٚہؠ خۅشحٲلی پرٲوِتھ، تہٕ توٚہؠ روزیٚو زمینس پٮ۪ٹھ واریہس کالس زِنٛدٕ۔"\f + \fr 6‏:3 \ft خروج 20:12، تثنِیہ شرع 5:16\f*
\v 4 یۅتام تِہُنٛد تعلق چُھ یِم مٲلؠ چھِ، پننٮ۪ن شُرٮ۪ن سٟتؠ مہٕ کٔرِو سُہ سلوک یمہِ سٟتؠ تِمن شرارتھ کھسہِ۔ امہِ بجایہ کٔرِو تِمن ہِدایت دِتھ حوصلہٕ افزٲیی سان نظم و ضبطچ تربیت یہ خداوند یسوع توٚہہِ نِش یژھان چُھ۔\f + \fr 6‏:4 \ft تثنِیہ شرع 6:7، امثال 3:11، 12، 19:18، 22:6، کولوسین 3:2\f*
\v 5 یۅتام تُہنٛد تعلق چُھ یم غلام چھِ، سٮ۪ٹھا احترامہٕ تہٕ خلوصہٕ سان کٔرِو تِمن لوٗکن ۂنٛز اطاعت یم زمینس پٮ۪ٹھ تُہنٛدؠ آغہٕ چھِ، یتھٕ پٲٹھؠ توٚہؠ مسیحؔ سنٛز اطاعت چُھو کران۔
\v 6 تِمن ۂنٛز اطاعت کٔرِو نہٕ صرِف تٔمہِ وِزِ ییٚلہِ توٚہہِ   پننٕؠ  مٲلکھ وُچھان آسن، یِتھ کِنؠ زَن لوٗکھ کران چھِ یِم صرف امہِ چیزچ فِکر چھِ تھاوان زِ تمن گژھن وُچِھن کٲم کران۔ امہِ بجایہ، کٔرِو تِتھٕ کِنؠ کٲم زنتہٕ ٲسِو توٚہؠ مسیحؔ سٕنٛدؠ غلام، یتھٕ پٲٹھؠ خدا یژھان چُھ زِ توٚہؠ کٔرِو جوشہٕ سان کٲم۔
\v 7 پننٮ۪ن آغن ہنٛز کٔرِو رضامنٛدی سان خدمت، یتھٕ کِنؠ زَن توٚہؠ لوٗکو بدلہٕ خداوند یسوعؔ سنٛز خدمت کران چُھو۔
\v 8 یہِ کٔرِو تکیازِ توٚہؠ چُھو زانان زِ خداوند یسوعؔ دِیہ پرٮ۪تھ شخصس تمؠ سنٛزِ اصل کامہِ ہُنٛد انعامہٕ۔ اتھ چھنہٕ کانٛہہ فرق زِ سُہ شخص اوسا غلام یا آزاد۔
\v 9 یۅتام تُہنٛد تعلق چُھ یِم آغہٕ چھِ، یتھٕ کِنؠ تُہنٛدؠ غلام توٚہہِ اصل پٲٹھؠ خدمت کران چھِ تِتھے کِنؠ پزِ توٚہہِ تہِ تِمَن سٟتؠ اصل پٲٹھؠ پیش یُن۔ تِمن دھمکی دِنؠ کٔرِو بنٛد۔ یہِ مہٕ مٔشرٲیو زِ سُہ یعنی توٚہہِ دۅشوٕنؠ ہُنٛد خداوند چُھ آسمانس پٮ۪ٹھ تہٕ سُہ چُھ تمام لوٗکن ہُنٛد ہیٚووٕے فٲصلہٕ کران یوٚدوے تُہنٛد رۅتبہٕ تھوٚد ٲسؠ تن یا کم۔\f + \fr 6‏:9 \ft لوقا 6:38، تثنِیہ شرع 10:17، 2 توٲریخ 19:7\f*
\v 10 ٲخٕرکار تھٲیِو خداوند یسوعسؔ پٮ۪ٹھ مکمل بھروسہٕ یُتھ سُہ توٚہہِ روحٲنی طور مضبوط کرِ تکیازِ سُہ چُھ بے پناہ مضبوط۔
\v 11 یتھٕ کِنؠ اکھ سِپاہ پننِس دشمنس خلاف لڑنہٕ باپتھ پوٗرٕ ذِرہ بکتر نٲلؠ ترٲوِتھ تھاوان چُھ، توٚہہ پزِ خدایہِ سٕنٛدِ طرفہٕ فراہم کرنہٕ آمُت پرٮ۪تھ کُنہِ روحٲنی وصیلُک استعمال کرُن تاکہِ توٚہؠ ہیٚکو شیطانس کامیٲبی سان مزاحمت کٔرتھ ییٚلہِ سُہ چالٲکی سان توٚہہِ خلاف منصوبہ بناوان چُھ۔
\v 12 یاد تھٲیِو زِ أسؠ چھِنہٕ باقین انسانن خلاف لڑان۔ بلکہِ چھِ أسؠ تِمن شیطانَن خلاف لڑان یِمن یَتھ بُرٕ وقتس منٛز بُرٕ کٲم کرن والیٚن لوٗکن پٮ۪ٹھ حکومت کرنُک اختیار چُھ، یعنی ہوہَس منٛز روزَن والیٚن بد روحن خلاف۔
\v 13 امی مۅکھہٕ پَزن توٚہہِ تِم تمام روحٲنی وسٲیِل اصٕل پٲٹھؠ استعمال کرٕنؠ یِم خداین توٚہہِ دِتؠ مٕتؠ چھِ، یتھٕ کِنؠ اکھ سِپاہ پنُن سورےٕ ذِرہ بکتر لٲگِتھ تھاوان چُھ۔ اگر توٚہؠ یہِ کٔرِو، تیٚلہِ ہیٚکو توٚہؠ بد روحَن ہُنٛد مقابلہٕ کٔرِتھ ییٚلہِ تِم توٚہہِ پٮ۪ٹھ حملہٕ کرن۔ توٚہؠ روزیٚو تٔمہِ وِزِ تہِ تیار ییٚلہِ تِم توٚہہِ پٮ۪ٹھ بیٚیہِ حملہٕ کرن تہٕ توٚہؠ بنیٚو خدایہِ سٕنٛدِ خٲطرٕ بہتر پٲٹھؠ زِنٛدٕ روزنس قٲبل
\v 14 توٚہہِ پَزِ شیطانَس تہٕ أمؠ سنٛدٮ۪ن بد روحَن خلاف مزاحمت کرنہٕ خٲطرٕ تیار روزُن یتھٕ پٲٹھؠ سِپہن پزِ دشمنس سٟتؠ لڑنہٕ خٲطرٕ تیار روزُن۔ یہِ کرنہٕ خٲطرٕ روزیٚو تِمن پزٮ۪ن چیزن مُتعلق سونچان یِم خداین توٚہہِ ہٲوِمٕتؠ چھِ۔ راستبٲزی سان کٲم کرٕنؠ تہِ تھٲیِو جٲری۔ یہِ کۅرو توٚہہِ تِتھٕ پٲٹھؠ بچاو یِتھ پٲٹھؠ أکِس سِپاہ سُنٛد بکھتر چُھ امسنٛدِس سینس بچاو کرن۔\f + \fr 6‏:14 \ft یسعیاہؔ 11:15\f*
\v 15 یتھٕ کِنؠ اکھ سِپاہ یُس پَنُن بوٗٹھ لٲگؠ تھےٕ چُھ تھاوان، تتہِ روزیٚو کُنہِ تہِ جایہِ گژھنہٕ خٲطرٕ تیار یوٚت توٚہہِ ضروٗرت آسہِ رٕژِ خبرِ خٲطرٕ یۅسہ لوٗکن خدایس سٟتؠ امنہٕ سان روزُن ونان چھےٚ۔\f + \fr 6‏:15 \ft یسعیاہؔ 57:2، ناحومؔ 1:15\f*
\v 16 یتھٕ کِنؠ اکھ سِپاہ تِم تیٖر رُکاونہٕ خٲطرٕ ڈھال تھاوان چُھ یِم امسنٛدؠ دُشمن أمِس پٮ۪ٹھ چلاوان چھِ، توٚہہِ پزِ پرٮ۪تھ وِزِ خداوندس پٮ۪ٹھ پوٗرٕ پٲٹھؠ بھروسہٕ کرُن۔ یہِ بچاوِ توٚہہِ تِمو تمام چیزو نِشہ یِم تُہنٛدؠ دُشمن، شیطان، بد روح، توٚہہِ روحٲنی طور نقصان واتناونہٕ خٲطرٕ کوشِش کرن۔
\v 17 یتھٕ کِنؠ اکھ سِپاہ پننِس کلَس بچاونہٕ خٲطرٕ تہِ شِستٕر ٹوپہِ پٮ۪ٹھ انحصار چُھ کران، اتھ حقیقتس پٮ۪ٹھ کٔرِو انحصار زِ خداین بچٲیو توٚہؠ۔ تہٕ یتھٕ پٲٹھؠ اکھ سِپاہ پننِس دشمنس ہارناونہٕ باپتھ تلوارِ ہُنٛد استعمال چُھ کران۔ یہِ ہتھیار کٔرِو استعمال یُس خداین سٕنٛدؠ روحن توٚہہِ دِتُو۔ یۅسہٕ اکھ شیٚچھؠ چھےٚ یۅسہٕ خدایہِ سٕنٛدِ طرفہٕ چھےٚ یِوان۔\f + \fr 6‏:17 \ft یسعیاہؔ 49:2، عبرانین 4:12، یسعیاہؔ 59:17\f*
\v 18 ییٚلہِ تہِ توٚہؠ خدایس دُعا چُھو کران تہٕ چُھوس کُنہِ چیزٕچ عرضی کران، ہمیشہٕ گژھہِ خدایہ سُنٛد روح توٚہہِ ہدایت دیُن زِ توٚہؠ کِتھہٕ کِنؠ کٔرِو دعا تہٕ کمہِ خٲطرٕ چُھ دعا کرُن۔ ساروےٕ کھۅتہٕ زیادٕ موثر گژھنہٕ خاطرٕ، روزیٚو وُچھان زِ خدا کیا چُھ کران، تہٕ روزیٚو مستقل ییٚلہ توٚہؠ خدایہ سنٛدٮ۪ن سارنےٕ لوٗکن خاطرٕ دعا چُھو کران۔
\v 19 میانہٕ خٲطرٕ کٔرِو دُعا، زِ خدا ونہِ مےٚ زِ ییٚلہِ تہِ بہٕ کتھ کرٕ تہٕ بہٕ کیا ونہٕ، تاکہِ بہٕ ونہٕ دلیری سان یِمن مسیحؔ ہس متعلق رٕژ شیٚچھ یۅسہٕ نہٕ لوٗکن گۅڈٕ پتاہ آسہِ۔
\v 20 امیُک وجہ چُھ یہِ زِ بہٕ چُھس لوٗکن مسیحؔ ہس مُتعلق ونان زِ بہٕ چُھس وۅنؠ جیلَس منٛز امسنٛز نمایندگی کران۔ دعا کٔرِو زِ بہٕ روزٕ یتھٕ کِنؠ باقین مسیحؔ ہس متعلق ونان روزان، بہٕ گژھٕ ہیٚکُن دلیری سان کتھ کٔرِتھ تکیازِ مےٚ پزِ یتھے پٲٹھؠ کتھ کرٕنؠ۔
\v 21 وۅنؠ ییٚلہِ توٚہہِ یہِ پتاہ لگہ زِ مےٚ سٟتؠ کیا چُھ گژھان تہٕ بہٕ کیا چُھس کران، تُخِکسؔ ونہِ توٚہہِ تہِ سورےٕ کینٛہہ یہِ ییٚتہِ گژھان چُھ۔ سُہ چُھ اکھ ایماندار سٲتھی یمِس أسؠ سٲری واریاہ لول چھِ بران، تہٕ سُہ چُھ خداوند یسوعؔ سنٛز وفادٲری سان خدمت کران۔
\v 22 یہِ چُھ وجہ زِ بہٕ چُھسن سُہ توٚہہِ نِش یہِ چِٹھؠ ہٮ۪تھ سوزان؛ بہٕ چُھس یژھان زِ توٚہؠ زٲنِو زِ أسؠ کِتھؠ چھِ، تہٕ بہٕ چُھس یژھان زِ سُہ دِیہ توٚہہِ تسلی تہٕ کرِ حوصلہٕ افزٲیی۔
\v 23 بہٕ چُھس دُعا کران زِ خدا سون بب تہٕ خداوند یسوع مسیحؔ دِییہ توٚہہِ سارنےٕ ایماندار سٲتھین اکھ پُر امن جذبہٕ تہٕ بناوِ توٚہہِ اَکھ أکِس سٟتؠ لول برنس تہٕ خدایس پٮ۪ٹھ بھروسہٕ جٲری تھاونس قٲبل۔
\v 24 بہٕ چُھس دُعا کران زِ خدا روزِ تِمَن تمام لوٗکن پٮ۪ٹھ مہربٲنی سان کٲم کران یِم سٲنِس خداوند یسوع مسیحؔ ہس سٟتؠ ثابت قدمی سان لول چھِ بران۔
