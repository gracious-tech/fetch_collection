\id EST - DMT Kashmiri
\toc1 ایستر
\mt1 ایستر
\c 1
\p
\v 1 یہ چھےٚ اکھ سۅ دلیل یۅسہ تتھ زمانس منٛز سپٕز ییٚلہِ اخسویرسؔ ناوُک اکھ بادشاہ فارس ملُکس پٮ۪ٹھ حکومت کران اوس۔ اخسویرسؔ سٕنٛدِس سلطنتس منٛز ٲسؠ اکھ ہتھ تہٕ ستووُہہ صوبہ، تہٕ اتھ منٛز ٲسؠ تِم سٲری علاقہٕ شٲمل یِم مشرقی ہندوستانہٕ پؠٹھٕ مغربی اِتھوپیاؔہس تام پھٲلِتھ ٲسؠ۔
\v 2 تمہِ وقتہٕ اوس بادشاہ اخسویرسؔ سوسن پٮ۪ٹھٕ حکومت چلاوان یۅسہ فارسچ رازدٲنؠ ٲس۔
\v 3 اخسویرسنؔ کوٚر حکومٔژ ہنٛدس تریمِس وریس منٛز سارنےٕ حٲکمن تہٕ تس پرٮ۪تھ أکِس اہم شخصس باپتھ یِمؠ تہِ تہنٛدِ خٲطرٕ کٲم کرمژ ٲس، اکہ ضیافٔژ ہُنٛد سنٛز۔ بیٚیہِ کٔر تٔمؠ فوجہ کیٚن تمن افسرن تہِ دعوت یِم فارس تہٕ مادی حکومتی نظامس منٛز یکہٕ وٹہٕ پنٕنؠ خدمت انجام دِوان ٲسؠ، بیٚیہِ کٔرکھؠ امیر جٲگیردار تہٕ صوبن ہنٛدؠ عہدٕ دار تہِ اتھ منٛز شٲمل۔ بادشاہ اوس پانہٕ امہِ تقریبہِ ہنٛز نگرٲنی کران۔
\v 4 اخسویرسنؔ کٔرؠ پننؠ مہمان حدٕ کھۅتہٕ زیادٕ خوش، تکیازِ سُہ اوس ہاوُن یژھان زِ تٔمؠ سنٛز سلطنت چھےٚ مٲلامال تہٕ سُہ چُھ سیٹھاہ امیر تہٕ طاقتور بادشاہ۔ ضیافژٕ کھیاونُک یہِ سلسلہٕ رود شیٚن ریتن جٲری۔
\v 5 شییہِ ریتؠ یم ضیافژٕ موٚکلِتھ کوٚر ٲخرس پٮ۪ٹھ بادشاہن بیٚیہِ اکہ ضیافتُک اہتمام۔ یہِ ضیافت ٲس تِمن سارنےٕ لوٗکن امیرن کِہو غیٖریبن ہنٛدِ خٲطرٕ یِم سوسن کِس مضبوط شاہی قلعس منٛز روزان ٲسؠ۔ تٔمؠ کوٚر امہ ضیافٔژ ہُنٛد انتظار محلہٕ خانہٕ کس آنٛگٕنؠ باغس منٛز۔ یہِ رود برابر أکِس ہفتس جٲری۔
\v 6 آنٛگنس منٛز ٲسؠ سفید تہٕ نیٖلؠ پردٕ، وانٛگٕنؠ تہٕ سفید رٔزَو سٟتؠ گنٛڈتھ چاندِ ہنٛدین کرین منٛز سنگ مر مر کین تھمبن پؠٹھ اویزان۔ مہمان ٲسؠ سۅنہٕ تہٕ چاندِ سٟتؠ بناونہٕ آمتیٚن پلنٛگن سٟتؠ ڈوٚکھ دِتھ۔ تتہِ اوس اکھ پچہ کٲری کٔرتھ فرش، ووٚزلس، سفید تہٕ سیاہ سنگٕ مرمرس پٮ۪ٹھ ترٲوِتھ۔ یتھ انٛدؠ انٛدؠ سیاہ سنٛگ مرمرس جوٲہرات جٔرِتھ ٲسؠ۔
\v 7 خدمت گزار ٲسؠ سۅنہٕ سنٛدین پیالن منٛز شراب پیش کران۔ بادشاہ اوس سیٹھاہ امیر تہٕ تمِس ٲس یمن پیالن ہنٛز بہتات تہٕ کانٛہہ پیالہٕ اوس نہٕ بییس پیالس ہیوٗ۔ بادشاہن چاوٕناوؠ مہمان خدمت گزارو دٔسؠ بسیار شٲہی شراب۔
\v 8 اخسویرسؔ بادشاہن دیت پنہٕ نین مہمانن اکھ خاص امتیٲزی حَق۔ تٔمؠ بنٲوؠ شراب پیش کرن وٲلؠ خدمت گزار یمہِ اصولکؠ پابند زِ، "یُس نہٕ یژھان آسہ تس گژھِ نہٕ شراب دِنہٕ یُن۔ "تمام مہمان چین کم یا زیادٕ پننہِ مرضی مطٲبق۔
\v 9 ییٚلہِ بادشاہ آنٛگنس منٛز مرد مہمانن خٲطرٕ دٲری کران اوس، تمؠ سنٛز ملکانؠ وشتیؔ ٲس زنانن ہنٛزن ضیافژن ہنٛز میزبانی کران۔ سۅ ٲس شاہی محلس انٛدر میزبانی کران یتہِ بادشاہ اخسویرسؔ روزان اوس۔
\v 10 سٔتمہِ دوٚہؠ، ییٚلہِ بادشاہ اخسویرسؔ شراب چیٚتھ مست گوٚو، تٔمؠ دیت تِمن سَتن حفاظت کرن والین ناد یِم تمِس ذٲتی طور خدمت کران ٲسؠ۔ تہنٛدؠ ناو ٲسؠ، مہومانؔ، بزتاؔ، خربوناؔ، بگتاؔ، ابگتاؔ، زتارؔ تہٕ کرکسؔ۔
\v 11 وشتیؔ ملکانؠ ٲس سیٹھاہ خوبصورت زنانہٕ۔ بادشاہ اوس یژھان شاہی دربارکٮ۪ن لوٗکن تہٕ عہدٕ دارن ہاوُن زِ سہٕ کٲژا خوبصورت چھےٚ۔ لہٰذا ووٚن تٔمؠ تِمن پننؠن سَتن ذٲتی خدمت گارن وشتیؔ ملکٲنؠ تس نِش اننہٕ باپتھ۔ تٔمؠ ووٚن تِمن یتہِ زِ سۅ دِیہ پننِس کلس شٲہی تاج۔
\v 12 پوٚز ییٚلہِ ملکانہِ وشتیؔ نِشہ محافظ آے تہٕ ونہَس یہِ تمِس بادشاہ سُنٛد حکم اوس، تمہِ کوٚر اِنکار۔ محافظو کوٚر بادشاہ امہِ نِشہ باخبر تہٕ بادشاہس کھوٚت سیٹھاہ شرارت۔
\v 13 بادشاہ سُنٛد اوس یہِ معمول تِمن خاص مشیرن سٟتؠ مشورٕ کرُن یِم قانون ٲسؠ زانان تہٕ رٕتؠ فٲصلہٕ نِوان ٲسؠ۔ لہٰذا کوٚر تٔمؠ تِمن مشیرن سٟتؠ مشورٕ یِم اصل پٲٹھؠ کام کرٕنؠ زانان ٲسؠ۔
\v 14 بادشاہ سٕنٛدؠ قریبی مشیر ٲسؠ کارشیناؔ، ستارؔ، ادماتاؔ، ترسیسؔ، مرسؔ، مرسؔنا تہٕ مموکانؔ۔ یِم ستتھ قریبی عہدٕ دار تہٕ مادی سلطنت کیو مختلف جایو پٮ۪ٹھٕ۔ تِم ٲسؠ بادشاہس ذٲتی طور مشورٕ دِوان۔ تِم ٲسؠ سلطنتن ہنٛدؠ ساروٕے کھوٚتہٕ زیادٕ اختیار تھاوان وٲلؠ عہدٕدار۔
\v 15 بادشاہن ووٚن تِمن، "مےٚ سوٗزؠ پنٕنؠ محافظ ملکانہِ وشتیؔ نِش اکھ پٲغام ہیٚتھ، مگر تمہِ کوٚر تورٕ اِنکار اخسویرسؔ بادشاہ سنٛدِس حکمس۔ اسہِ کیاہ پزٕ قانونی ضٲبطو مطٲبق تس سٟتؠ کرُن؟"
\v 16 پتہٕ ووٚن مموکانَن بادشاہس سیٹھاہ زورٕ سان یُتھ سۅ تہٕ تمسنٛدؠ عہدٕدار تہِ بوزَن۔ تٔمؠ ووٚن، "ملکانہِ وشتیؔ چُھ توہین کۅرمُت، نہٕ صرف بادشاہ سُنٛد بلکہ چُھس تِمن سارِنےٕ عہدٕ دارن تہٕ لُکہ جمٲژن ہُنٛد توہین کۅرمُت یِم تِمن تمام صوبن منٛز بسان چھِ یِمن پؠٹھ بادشاہ اخسویرسؔ سنٛز حکومت چھےٚ!
\v 17 "یہِ کیاہ زن سپُد۔ سلطنتس منٛز موجود سارے مستوراتہٕ ییٚلہِ یہِ بوزن زِ ملکٲنہِ کیاہ کوٚر۔ تِم ونن، "بادشاہ اخسویرسنؔ کوٚر پنہٕ نین نوکرن حکم وشتیؔ ملکٲنؠ تس نِشہ اننُک، مگر سۅ آیس نہٕ! اگر ملکانہِ بادشاہس نافرمٲنی کٔر، أسؠ کیازِ کرو پننؠن خاندارن ہنٛز فرمٲنبردٲری؟ پتہٕ کرن نہٕ خاندارنہِ پننؠن خاندارن یزتھ۔
\v 18 اگر از تہِ فارس تہٕ مادی چہِ بزرگ خوتونہٕ بوزَن زِ ملکانہِ کیاہ کوٚر۔ تِم لاگن پننؠن خاندارن ہنٛز نافرمٲنی کرٕنؠ، ہرگاہ تِمہ بادشاہ سنٛدین عہدٕ دارن ہنٛزٕ آشنہِ تہِ آسن۔ تمہ کرن تِمن سٟتؠ بدسلوکی، تہٕ تمہِ سٟتؠ کھسہِ تہنٛدین خاندارن شرارت۔ یتھ کِنؠ گژھن پانے بجہِ خرٲبیہِ پٲدٕ۔ یہِ خبر گژھِ نہٕ نیٚبر کُن پھٲلٕنؠ۔
\v 19 "اے بادشاہ، ہرگاہ توٚہہِ منٲسب باسہِ، توٚہہ پزِ اکھ شٲہی فرمان جٲری کرُن، یُس زن فارس تہٕ مادی ہنٛدین قانوٗنن منٛز درجٕ گژھِ سپدُن یتھ نہٕ کانٛہہ اکھ تہِ اتھ منٛز بدلاو انہِ۔ یہِ فرمان گژھِ یہِ آسُن زِ وشتیؔ ییہِ نہٕ دُبارٕ زانٛہہ تہِ اخسویرسؔ سنٛزِ بارگاہِ منٛز۔ توٚہہ پزِ کٲنٛسہِ بدل خوتونہِ ہُنٛد انتِخاب کرُن یۅسہ تُہنٛز ملکٲنؠ بنہِ، یۅسہ توٚہہِ فرمابردار روزِ۔
\v 20 تکیازِ تُہنٛز سلطنت چھےٚ واریاہ وسیع ہر کانٛہہ بوزِ اتھ فرمٲنس متعلق، تہٕ زانہِ زِ ہرگاہ کانٛہہ تہِ زٔنؠ پننِس رٲنِس نافرمٲنی کرِ، سُہ ہیٚکہِ تمِس ہٹٲوِتھ تہٕ طلاق دِتھ یتھٕ پٲٹھؠ توٚہہ وشتیؔ سٟتؠ کٔریو۔ پتہٕ کرن سارے زنانہٕ پننؠن ضاندارن یزتھ۔ یہِ روزِ سلطنتس منٛز ہر کانٛسہِ مردس یزتھ۔
\v 21 یہِ باسیوو بادشاہس تہٕ تہنٛدین امیرن اکھ رُت خیال۔ لہٰذا کٔر بادشاہ اخسویرسنؔ مموکانؔ سنٛدِس مشورس پٮ۪ٹھ عمل۔
\v 22 بادشاہن سوز پننس سلطنتس منٛز ہر کُنہِ صوبس چِٹھؠ۔ تٔمؠ لیوکھ ہر أکِس صوبس تہٕ لوٗکن ہنٛزن جمٲژن تہنٛزے زبٲنؠ منٛز۔ چِٹھین منٛز آو وننہٕ زِ مرد گژھن پننؠن زنانن تہٕ شُرین ہنٛدؠ مٲلکھ آسٕنؠ۔ تِمن منٛز اوس یہِ تہِ وننہٕ آمُت زِ مردس پزِ پننہِ زنانہِ تہنٛزے قومچہ زبٲنؠ منٛز حکم کرُن تہٕ تس پزِ سمجن تہٕ مانن۔
\c 2
\p
\v 1 کینٛژِ کٲلؠ ییٚلہِ بادشاہ اخسویرسؔ شرارت ووٚتھ، تمِس پییہِ وشتیؔ یاد۔ مگر تمہِ ٲس بادشاہ سنٛدِس حکمس نافرمٲنی کرمژ تہٕ بادشاہن اوس فرمان جٲری کۅرمُت زِ سۅ گژھِ نہٕ أمِس نِشہ دُبارٕ زانٛہہ یِنؠ۔
\v 2 لہٰذا کینٛژو نوجوان خدمتگارو ووٚن بادشاہس، "تُہنٛز شان ٲسِنؠ بُلنٛد، توٚہہ پزِ وُنؠ نُوو نیتھٕر کرُن، توٚہؠ ہیکیو پننؠن خدمت گارن ؤنِتھ تِم ژھانٛڈن کانٛہہ انہرِش مٲرؠ مٔنٛز نوجوان کور۔
\v 3 "ییہِ ہیکیو توٚہؠ پننہِ سلطنت کین ریاستن ہنٛدین افسرن یہِ ذمہ داری تہِ تھٲوِتھ زِ تٔم انُن خوبصورت انہرؠ شن کورین سوسن شہرچہِ رازدانہِ منٛز۔ یتہِ تمہٕ کورین ہنٛدس حرم خانہٕ کِس شٲہی نگران ہیجاییؔ یس حوالہٕ روزن، یُس تتہِ موجود نوجوان مستوراتن ہنٛز رٲچھ کران چُھ۔ سُہ کرِ تِمن ۂنٛدِ پٲراونُک تہِ انتظام۔
\v 4 "پتہٕ نِیو توٚہؠ پانے فٲصلہٕ زِ کۅسہٕ ہِش زٔنؠ آیہِ توٚہہ پسنٛد، سۅ کٔروون توٚہؠ وشتیؔ ھنٛدِ بدلہٕ ملکٲنؠ تسلیم۔ "بادشاہس آیہِ تِہنٛز یہِ تجویز پسنٛد، تہٕ تٔمؠ کوٚر تی۔
\v 5 تِمن دوٚہُن اوس شہرِ سوسن چہِ رازدانہِ منٛز اکھ یہُودؠ روزان یمِس مردکیؔ ناو اوس۔ سُہ اوس بنیمِینؔ قبیلس سٟتؠ تعلق تھاوان۔ تہنٛدِس مٲلس اوس یاییرؔ ناو، تمہِ سٕنٛدِس بڈِببس اوس سمعیؔ ناو، تہٕ تہنٛدس بڈٕ بڈِ ببس اوس قیس ناو۔
\v 6 واریاہ ورؠ برونٛٹھ اوس بابلٕکؠ بادشاہ نبوکدنضرن قیسؔ یروشلمہٕؔ منٛزٕ جلاۓ وطن کۅرمُت تہٕ اوسُن کینٛژن قٲدین سٟتؠ بابلؔ اُنمُت۔ نبوُکدنفرؔن اوس سُہ تمہِ وقتہٕ یروشلمہٕؔ جلاۓ وطن کۅرمُت ییٚلہِ تٔمؠ یہودایہ ہُکھ بادشاہ جیکونیؔ یروشلمہٕؔ منٛز نیٚبر کوٚڈ تہٕ انُن سُہ بابلؔ۔
\v 7 وُنؠ اوس مردکیؔ پنٕنؠ پِتٕر بیٚنہِ رچھان، یۅسہ یتیم ٲس۔ تسُنٛد عِبرٲنؠ ناو اوس ہدؔسّاہ تہٕ فارسی ٲسِس آستیرؔ ونان۔ ییٚلہِ تسنٛد مول تہٕ موج مودؠ، مردکائینؔ رٹ سۅ کورِ گرینٛز پانس سٟتؠ۔ آستیرؔ ٲس وُنؠ اکھ نوجوان زنانہ، تہٕ سۅ ٲس حدٕ کھۅتہٕ زیادٕ لوٗبہٕ وُنؠ۔
\v 8 تہٕ پتہٕ سَپد یتھٕ پٲٹھؠ زِ: قٲصد گے سارسٕے سلطنتس کُن روانہٕ تہٕ کوٚرکھ تمہِ نَویہ فرمانکُ اعلان یُس بادشاہن ووٚنُمت اوس۔ اتھ دوران انہِ تِمو افسرو یمہٕ بادشاہن پریتھ صوبہٕ باپتھ مقرر کٔرمٕتؠ ٲسؠ حسین تہٕ جمیل نوجوان زنانہٕ سوسن شہرچہِ رازدانہِ منٛز تہٕ تھاویکھ ہیجاییؔ سنٛزِ نگرٲنی تل۔ سُہ اوس سُہ نفر یُس نوجوان زنانن ھنٛز نگرٲنی پٮ۪ٹھ مقرر اوس۔ یمہٕ انہرشہِ زنانہٕ حرم خٲنس منٛز روزان آسہ۔ تکیازِ آستیرؔ ٲس حدٕ کھۅتہٕ زیادٕ حسین افسرو أنؠ سۅتہِ بادشاہ سنٛدِس محلس منٛز تہٕ تھٲوکھ ہیجاییؔ سنٛزِ نگرٲنی تل۔
\v 9 ہیجاییؔ گوٚو آستیرؔ نہِ سٟتؠ سیٹھاہ مُتٲثر تہٕ تٔمؠ کوٚر تس سٟتؠ موٲفق سلوک۔ تٔمؠ کوٚر جل آستیرؔ نہِ باپتھ زیورن تہٕ کھیٚن چیٚنُک انتظام۔ بیٚیہِ ژارِ تٔمؠ شٲہی محلچہِ ستتھ دآیہِ تہٕ تِمہ تہٕ تھاوین تس سٕنٛدِس خدمتس۔ بیٚیہِ نِین آستیرؔ تہٕ تمؠ سنٛزٕ دایہِ انہرؠ شن کورین ہنٛدس ساروٕے کھۅتہٕ رٕتِس حرم خانَس منٛز۔
\v 10 مردکیؔ ین ٲس آستیرؔ خبردار کٔرمژ زِ تمِس پزِ نہِ کانٛسہِ ونُن سۅ کٔمہِ خاندانٕچ چھےٚ۔ لہٰذا ووٚن نہٕ مردکیؔ کانٛسہِ زِ سۅ چھےٚاکھ یہُودؠ یا تمہِ سُنٛد رشتہٕ دار کُس چُھ۔
\v 11 مردکیؔ اوس یژھان زاننُ آستیرؔ کیاہ ٲس کران تہٕ تمِس سٟتؠ کیاہ اوس سَپدان۔ اوے اوس سُہ پرٮ۪تھ دوٚہہ انہرؠ شن زنانن ہنٛدس حرم خانہِ کس آنٛگنس برونٛہہ کنہِ اورٕ یور پھیران آسان۔ یتہِ کِنؠ اوس سُہ حرم خانس منٛز انٛدر نیٚبر نیرن والین نِشہ معلوم کران زِ سۅ کیاہ چھےٚکران۔
\v 12 حرم خانہٕ پؠٹھٕ ٲس پرٛیتھ وقتہٕ اکھ اکھ انہرِش زنانہ بادشاہ اخسویرسؔ نِشہ بحثیت لونٛڈی جِنسی تعلق بناونہٕ باپتھ گژھان۔ وٲرؠ واتنہٕ برونٛٹھ ٲس پرٛتھ اکھ زنانہ برابر أکِس ورؠ یس پولوسؔنہٕ تہٕ پٲراونہٕ یوان تِمو طریقو سٟتؠ یِم یمن خٲطرٕ فارسس منٛز بناونہٕ آمٕتؠ ٲسؠ۔ یہِ پٲراو اوس یتھٕ پٲٹھؠ مکمل سپدان: گوڈٕ نکین شین ریتن آسہ دایہ أکِس زنانہ بدنس پرٛتھ دوٚہہ زیتون تیٖلہِ تہٕ مشکہٕ دار گوندٕ سٟتؠ مٲلش کران۔ دوٚیمن شین ریتن دوران آسہ تمہِ سنٛزٕ دایہِ تسنٛدس بدنس پرٛیتھ دوٚہہ عطر ملان تہٕ مہلامہ کران۔
\v 13 امی طریقہٕ آسہ تِمہ أکِس انہرؠ شہ کورِ بادشاہ سٕنٛدِ باپتھ پٲراون تہٕ یتھ کِنؠ ٲس تمؠ سنٛز اکھ لونڈی تیار سپدان۔ یہِ کینٛژھا پوشاک تہٕ زیورات یُس حرم خانس منٛز انہرؠ شن باپتھ آسان اوس سۅ پسنٛد کرِہے تہِ اوس تس دِنہ یوان۔ تہٕ سُہ لٲگِتھ ٲس سۅ بادشاہ سنٛدِس محلہٕ خانس منٛز نِنہٕ یوان۔
\v 14 بادشاہ سنٛدؠ خدمت گار ٲسؠ تمِس بادشاہ سنٛدِس ذٲتی کمرن منٛز شامس نِوان تہٕ صبحس ٲسِس تتھ حرم خانس منٛز انان یُس لونڈیو باپتھ مخصوص اوس۔ شعشجزؔ ناوٕ کِس أکِس نفرس یُس لونڈین ہُنٛد شٲہی رٲچھ در تہٕ نگران اوس حوالہٕ کرنہٕ یوان۔ امہِ پتہٕ ٲس سۅ نوجوان کورِہن تٔتی پنمنؠ باقی زندگی بسر کران۔ سۅ ٲس نہٕ تۅتام بادشاہس نِشہ گژھان یۅتام نہٕ سُہ تس پانس نِشہ بُلاوِہے۔ تکیازِ تٔمؠ اوس آسان تٔمؠ سُنٛد مَزٕ تلمُت۔
\v 15 ٲخٕر ییٚلہِ سُہ شام ووت ییٚلہِ آستیرؔ بادشاہس نِشہ گژھنٕچ وٲرؠ ٲس یۅسہ مردکیؔ ین منٛگتہ نِتھ پنٕنؠ کور ٲس بنٲومژ۔ تہنٛدس مٲلس اوس ابیخیلؔ ناو، یُس مردکیؔ سُنٛد پِتٕر اوس۔ ییٚلہِ سۅ بادشاہس نِشہ گثھنہٕ باپتھ تیار گییہ تمہِ موٚنگ تی یہِ ہیجایَن تس مشورٕ دیُت یُس شٲہی محلہٕ خانس منٛز انہرشہِ مستوراتن ہُنٛد نگران اوس۔ یمؠ تہِ آستیرؔ وُچھ سُہ گو متٲثر، سۅ ٲس سیٹھاہ شوٗبہ وٕنؠ تہٕ لوٗبہٕ وٕنؠ۔
\v 16 بادشاہ سنٛدیو خدمت گارو واتنٲو آستیرؔ بادشاہ اخسویرسؔ سنٛدِس محلہٕ خانس منٛز۔ یہِ اوس ؤرؠ یُک دہِم ریٚتھ یعنی طیبت، فارس کِس بادشاہ سٕنٛدِ حثیتہٕ تمؠ سنٛزِ حکومتُک سٔتم ؤری
\v 17 بادشاہن ورتوو آستیرِؔ سٟتؠ ساروٕے زنانو کھۅتہٕ زیادٕ لول۔ تٔمؠ کوٚر تسَ سٟتؠ باقی ساروٕے انہرؠ شو کھۅتہٕ زیادٕ رُت تہٕ موٲفق سلوک۔ یمہٕ اۅتام تس سنٛزٕ لونڈی بنیمژٕ آسہ۔ لہٰذا تھوو بادشاہ اخسویرسنؔ شٲہی تاج تہنٛدسےٕ کلس پٮ۪ٹھ۔ تہٕ تٔمؠ بنٲو سۅ وشتیؔ سنٛزِ جایہِ ملٔکٲنؠ۔
\v 18 پتہٕ کوٚر بادشاہن اکہ بڈِ ضیافتُک سنٛز تہٕ دِژن پننؠن سارنےٕ ملٲزمن تہٕ خدمت گارن دعوت۔ یہِ سال دِتُن آستیرؔ ہنٛدس مِلکٲنؠ بننَس پؠٹھ۔ تٔمؠ کوٚر اعلان زِ یہِ مناون تسَنٛدِس سلطنتس منٛز تمام صوبن ہنٛدؠ لوٗکھ، یِمہٕ ساعتہ نہٕ تِمن محصول تہِ دیٚون پیٚیہِ، تہٕ تٔمؠ دِتؠ لوٗکن وژھِ وٲنجہِ مختلف تحفہٕ۔
\v 19 امہِ پتہٕ ووٚن اخسویرسنؔ پننٮ۪ن ملٲزمن بیٚیہِ تہِ سوسن انہرشہِ کورِ اننہٕ باپتھ تہٕ تتھ دوران اوس مردکیؔ بادشاہ سنٛدِ خٲطرٕ تمِسنٛدس دروازس پؠٹھ روزِتھ کٲم کران۔
\v 20 آستیرِؔ اوس نہٕ وُنتہِ کانٛسی پننہِ خاندانکُ پے پتاہ ووٚنمت، تکیازِ تس اوس مردکیؔ ین کٲنسہِ نِش امیٚک اظہار کرنہٕ نشہٕ منع کوٚرمُت۔ سۅ روز مکمل پٲٹھؠ مردکیؔ سنٛدین ہدایتن پؠٹھ عمل کران، تِتھے کِنؠ یتھٕ کٔنؠ سۅ پننِس گرس منٛز پرٛتھنس دوران کران ٲس۔
\v 21 تٔتھؠ وقتس دوران ییٚلہِ مردکیؔ بادشاہ سنٛدِس دروازس پؠٹھ پنٕنؠ کٲم کران اوس، بادشاہ سٕنٛدؠ بیٚیہِ زٕ رٲچھ در یِم دروازس رٲچھ ٲسؠ آسان گییہ بادشاہ سنٛز کہتام ناراضگی۔ تِمو بنوو بادشاہ اخسویرسؔ قتل کرنُک منصوبہ۔ تِمن ہُنٛد ناو اوس بگتانؔ تہٕ ترشؔ۔
\v 22 مگر مردکیؔ ین کوٚر تِہنٛدس تتھ منصوبس متعلق پے پتاہ۔ تٔمؠ ووٚن اتھ متعلق ملکانہِ آستیرِؔ، تہٕ تمہِ ووٚن بادشاہس۔ تمہِ کوٚر انکِشاف زِ مردکیؔ ین دِژ تمِس یہِ خبر۔
\v 23 بادشاہ سنٛدیو ملٲزمو کوٚر مردکیؔ سنٛزِ شیٚچھِ تحقیقات تہٕ دریافت کٔرتھ دراو یہِ پوٚز۔ لہٰذا دیُت بادشاہن تِمن دوٚشونے پھٲسؠ دِنک حکم۔ یہِ کتھ آیہ بادشاہس برونٛہہ کنہِ شٲہی تٲریخ نامس منٛز درج کرنہٕ۔
\c 3
\p
\v 1 کمےٕ کٲلؠ پتہٕ دِژ بادشاہ اخسویرسنؔ پننِس أکِس ملٲزم ہامانسؔ ترقی، یُس اجاج ذٲژ ہنٛدس ہمداتاؔ سُنٛد نیٚچو اوس۔ بادشاہن دیُت تس ساروےٕ ملٲزمو کھۅتہٕ اکھ خاص عہدٕ۔
\v 2 بادشاہن اوس یہِ باور کرُن یژھان زِ تٔمؠ چُھ ہامانؔ اکھ رۅتبہٕ وول عہدٕدار بنومُت یمہِ کِنؠ تٔمؠ تمام ملٲزمن یم دروزن پٮ۪ٹھ رٲچھ ٲسؠ حکم دیُت زِ ییٚلہِ تہٕ ہامان یوان نیران آسہ تمِسنٛدس احترامس منٛز گژھن دروازن پٮ۪ٹھ موجود سٲری رٲچھ در سجدٕ کرٕنؠ۔ مگر مردکیؔ ین کوٚر ہامانسؔ سٔجدٕ کرنَس اِنکار، تکیازِ سُہ اوس اکھ یہُودؠ یُس یہُوواہسؔ بغٲر کانٛسے عبادت کران اوس نہٕ۔
\v 3 بادشاہ سنٛدیو باقیو خدمت گارو وُچھ زِ مردکیؔ چُھ سجدٕ کرنس اِنکار کران، تہٕ تِمو پرُوژھ تمِس، "ژٕ کیازِ چُھکھ بادشاہ سنٛدِس حکمس اِنکار کران؟"
\v 4 مردکیؔ ین ووٚن تِمن زِ بہٕ چُھس اکھ یہُودؠ تہٕ یہُودؠ چھِ صرف یہُوواہسؔ عبادت کران۔ تِمو خدمت گارو کوٚر مردکیؔ پرٛتھ دوٚہہ خبردار زِ تمِس ییہِ سخ سزا دِنہٕ اگر سُہ بادشاہ سٕنٛدِ حکمٕچ نافرمانی کران رود تہٕ تہنٛدس خاص عہدٕدارس کرِنہٕ احترام۔ مگر مردکیؔ ین کوٚر تٔمہِ پتہٕ تہِ سجدٕ کرنس اِنکار۔ تِمو ووٚن ہامانسؔ اتھ متعلق، یہِ وُچھنہٕ باپتھ زِ سُہ دِیاوٕ ناویا مردکیؔ یَس سجدٕ نَہ کرنُک اجازت۔ تکیازِ سُہ چُھ اکھ یہُودؠ۔
\v 5 ییٚلہِ ہاماننؔ وُچھ زِ مردکیؔ کرِنہٕ تمِس سجدٕ، تمِس کٔھژ سخ ژَکھ۔
\v 6 باقیو خدمت گارو ووٚن ہامانسؔ زِ مردکیؔ اوس نہٕ تمِس اوٕ موکھٕ سجدٕ کران تکیازِ سُہ اوس اکھ یہُودؠ۔ توے نیو ہاماننؔ یہِ فٲصلہٕ زِ سُہ مارنہٕ صرف مردکیؔ یسےٕ یوت بلکہ کرِ سُہ کوشش اخسویرسؔ سٕنٛدِس سلطنتس منٛز موجود تمام یہُودینؔ کتراوٕنچ۔
\v 7 اوے تراوِناوین پننؠن خدمت گارن اتھِ ریواجہِ مطابق چیرِ، تہٕ رود یہِ وُچھان زِ کٔمہِ ریتُک کُس دوٚہہ روزِ یم یہُودؠ قتل کرنہٕ خٲطرٕ منٲسب۔ تِمو کوٚر یہِ بادشاہ اخسویرسؔ سنٛزِ فارسس پٮ۪ٹھ حکومتکہ بہمہِ ریٚتہٕ یعنی نیسان ریٚتس منٛز۔ چیریو منٛز درٛاو امہِ ؤرؠ یُک بہم ریتھ، ادار۔ یتھ ریٚتس منٛز ہامانؔ پننِس منصوبس عملی شکل دِتھ ہیٚکہ ہے۔
\v 8 پتہٕ گوٚو ہامانؔ بادشاہ اخسویرسؔ نِشہ تہٕ وُننَس، "تُہنٛز شان ٲسن بُلنٛد، تہنٛدس سلطنتس منٛز چھِ تِمن لوٗکن ہُنٛد اکھ خاص تعداد روزان یم باقی قومو منٛزٕ چھِ۔ تِم چھِ سارنےٕ صوبن منٛز روٗزان۔ تِمن چھِ پنٕنؠ الگ قانون، اوٕ کِنؠ چِھنہ تِم تُہنٛدؠ قانون مانان۔ یہِ چُھنہٕ تُہنٛدِ خٲطرٕ جان زِ توٚہؠ دیو تِمن پننِس سلطنتس منٛز روزنُک اجازت۔
\v 9 "اے بادشاہ، ہرگاہ توٚہہِ یہِ منصوبہ پسند ییہِ تیٚلہِ کٔریو توٚہؠ اکھ فرمان جٲری زِ تم تمام یہُودؠ گژھن قتل کرنہٕ یِنؠ۔ تِم قتل کرنہٕ پتہٕ ہیٚکو أسؠ تِہُنٛد سورےٕ جاداد حٲصل کرتھ تہٕ تمہِ منٛزٕ دِمہٕ بہٕ ترےٚ ہتھ ٹن چٲندؠ تُہنٛدس حکومَتس یُس شٲہی خزانس منٛزجمع گژھِ۔"
\v 10 بادشاہس آو ہاماننؔ ونُن پسنٛد، تٔمؠ دِژ ہامانسؔ پننہِ اتھٕچ شٲہی وٲج کٔڈتھ یتھ پؠٹھ سرکٲری مُہر ٲس۔ یمہِ سٟتؠ ہامانؔ پانے بادشاہ سٕنٛدِ طرفہٕ قانون ہیٚکہ ہا بنٲوِتھ۔ ہمداتاؔ اجاجی سُنٛد نیٚچو ہامانؔ اوس یہُودینؔ ہُنٛد نوٚن دشمن۔
\v 11 بادشاہن ووٚن ہامانس، "ژٕ ہیٚککھ پونٛسہٕ پانس نِشہ تھٲوِتھ تہٕ ژٕ کرِ تتھ قومس سٟتؠ تہِ یہِ ژےٚ بہتر بٲسی۔"
\v 12 امی وریہ گوڈنِکے رؠتہِ کہِ تُروٲہمہ تٲریخہ دِیت ہامانن بادشاہ سنٛدین کٲتبن ناد تہٕ دیُت نکھ اکھ چِٹھؠ لیٚکھنُک حکم۔ تٔمؠ ووٚن تِمن زِ امیٚک نقل گژھِ شٲہی ملٲزمن، پریتھ صوبہٕ کس گورنرس تہٕ ہر أکِس قومہٕ کس سردارس واتُن۔ کٲتبو لیوکھ یہِ پرٮ۪تھ صوبہٕ کیٚن استعمٲلی اچھرن منٛز تہٕ پرٛتھ علاقچہِ زبٲنؠ تہٕ تہنٛدس رسمِ خطس منٛز۔ یہِ ہاونہٕ خٲطرٕ زِ یہِ چُھس بہٕ بادشاہ اخسویرسؔ سنٛدِ حکمہٕ سوزان، اوس سُہ پرٮ۪تھ نقلس بادشاہ سنٛزِ دژِمژِ واجہ سٟتؠ مُہر تراوان۔
\v 13 چِٹھِ بردارو دٔسؠ آیہِ تِم چٹھِ پریتھ کانٛسہِ صوبہٕ کس عہدٕ دارس واتناونہٕ۔ تِمن چِٹھین منٛز اوس وننہٕ آمُت زِ تمام یہُودؠ ین اکہ دوٚہہ شُرؠ بٲژ ہٮ۪تھ مکمل طوٗر قتل کرنہٕ۔ سُہ دوٚہہ چُھ یتھؠ وریس منٛز ادار ریتُک تُروٲہِم تٲریخ۔ تتھ چٹھِ منٛز اوس یتہِ وننہٕ آمُت زِ یہُودینؔ قتل کرن وٲلؠ ہیکن تِہنٛد پرٮ۪تھ کانٛہہ چیز لوٹہٕ نِتھ۔
\v 14 چِٹھِ منٛز اوس عہدٕدارن وننہٕ آمُت زِ میُک نقل گژھِ تتھ جایہِ مرنہٕ یُن یتتھ پرٮ۪تھ کانٛہہ وُچِھتھ ہیٚکہ۔ یتھٕ کِنؠ زانن سٲری لوٗکھ زِ یہِ چُھ بادشاہن حکم جٲری کۅرمُت تاکہِ تِم روزن تیار زِ ییٚلہِ سُہ دوٚہہ واتہِ اسہِ کیاہ چُھ کرُن۔
\v 15 بادشاہ سٕنٛدِ حکمہٕ کنِؠ دراے چِٹھِ بردار دوان دوان سلطنتکس پریتھ صوبس کُن۔ امہِ حکمک اعلان آو سوسن شہرس منٛز تہِ کرنہٕ۔ بادشاہ تہٕ ہامانؔ بیٹھؠ سۅکھٕ سوٚچھِ تہٕ کوٚرکھ یکہٕ وٹہٕ روزتھ شراب نوش۔ مگر سوسن شہرٕ کیٚن لوٗکن گو تہٕ بوزِتھ ژس یہِ سپدن وول اوس۔
\c 4
\p
\v 1 ییٚلہِ مردکیؔ یَس ہامانؔ سٕنٛدِس تمام یہُودؠ مارنہٕ کِس منصوبس متعلق خبر لٔج، یہِ ٲس مصیبتٕچ نشٲنی، تٔمؠ ژٔٹؠ پنٕنؠ پلو تہٕ پانس ولُن ژھینمُت ٹاٹھ بیٚیہِ مُلن پانس سوٗر۔ امہِ پتہٕ لوٚگ بادشاہ سنٛدِس محل خانس تام شہرٕ کس مرکزس کنُ پکنہ مصیبت زدٕ کریکہٕ دِوان دِوان۔
\v 2 مگر ٹاٹھ ؤلِتھ اوس نہٕ کانٛسہِ تہِ نفرس بادشاہ سٕنٛدِس دروازس انٛدر گژھنکُ اجازت۔ لہٰذا ییٚلہِ مردکیؔ دروازس نِشہ ووت، تمِس پیو نیٚبرٕ کنے ٹھہرُن۔
\v 3 سلطنت کِس پرٛتھ صوبس منٛز وٲژ سۅ چیٹھؠ یتھ منٛز یہُودؠ تباہ کرنُک حکم اوس۔ عوامس منٛز آو امیٚک اعلان کرنہٕ۔ ییٚلہِ یہُودیو اتھ متعلق بوز تِمن سپُد سیٹھاہ ماتم۔ تِمو ترُوو کھیٚن چیٚنہٕ تہٕ لٔگؠ زورٕ زورٕ واویلا کرنہِ۔ تِمو منٛز ترٲوؠ واریہو ٹاٹھ نٲلؠ تہٕ سوٗر مٔلِتھ ترٛووکھ پان زمیٖنس پؠٹھ۔
\v 4 آستیرؔ سنٛزٕ دایہ آیہِ تسنٛدین محافظن سٟتؠ تہٕ وُنہس زِ مردکیؔ اوس ٹاٹھ ؤلِتھ دروازس نیٚبرٕ کنہِ۔ ییٚلہِ تمہِ اتھ متعلق بوز، آستیرؔ ملکٲنؠ کھوٚژ پانہٕ تہِ۔ تٔمؠ سوزؠ مردکیؔ یس لاگنہٕ باپتھ کینٛہہ پلو تاکہِ سُہ کڈِ ہے ٹاٹھ نیٚبر، پوٚز تٔمؠ کوٚر تم لاگنَس اِنکار۔
\v 5 بادشاہن ٲسؠ کینٛہہ ذٲتی شٲہی نگران آستیرؔ ملکانہِ تھٲومٕتؠ۔ آستیرؔ کوٚر تِموے منٛز أکِس آلو، یس ہتاکؔ ناو اوس۔ تمہِ ووٚن تسَ ژٕ نیر نیٚبر تہٕ مردکیؔ یس پرٛژھ زِ سُہ کیازِ چُھ ٹاٹھ ؤلِتھ بادشاہ سٕنٛدِس دروازس پٮ۪ٹھ، تس کیاہ پریشانی چھےٚ۔
\v 6 لہٰذا دراو ہتاکؔ شہرٕ کس ژُو ؤتھِس پؠٹھ مردکیؔ یَس سٟتؠ کتھ کرنہِ یُس بادشاہ سٕنٛدِس دروازس برونٛہہ کنہِ اوس۔
\v 7 مردکیؔ ین ووٚن ہتاکؔس ہامانُنؔ سُہ سورےٕ منصوبہ یُس تٔمؠ یہُودؠ مارنُک بنومُت اوس۔ تٔمؠ ووٚن تس یتہِ زِ ہامانؔن ووٚن بادشاہس زِ شٲہی خزانس کٲژاہ دولت بنہِ اگر بادشاہ لوٗکن حکم دییہِ یہُودؠ قتل کرنُک۔
\v 8 مردکیؔ ین دیُت ہتاکؔس تمہِ چٹھِ ہُنٛد نقل تہِ یۅسہ قٲصدو سوسن شہرکؠ لوٗکھ بوزنٲومٕتؠ ٲسؠ زِ تمام یہُودؠ کٔرؠ ووکھ قتل۔ تٔمؠ ووٚن ہتاکؔس سۅ چٹھؠ آستیرِؔ ہاونہٕ باپتھ تاکہِ سۅ زانہِ اصلی حقیقت کیاہ چھےٚ۔ تٔمؠ ووٚن تس تمِس بانٛد بانٛد کرنہٕ موٚکھٕ زِ سۅ گژھِ بادشاہس تہٕ کریس زارٕ پارٕ پننُ قوم تباہی نِشہ بچاونہٕ باپتھ۔
\v 9 واپس یتھ ونہ ہتاکنؔ آستیرِؔ مردکیؔ سنٛزٕ یمہٕ سارے کتھٕ۔
\v 10 پتہٕ ووٚن آستیرِؔ ہتاکسؔ واپس گژھِ مردکیؔ یس نِشہ یہِ شیٚچھ ہٮ۪تھ:
\v 11 "بادشاہس نِشہ گژھنہٕ خٲطرٕ چُھ اکھ قانون یُس سلطنتس منٛز مجود ہر کانٛسہِ نفرس پؠٹھ لاگو سپدان چُھ، مرد ٲسؠ تن یا زٔنؠ۔ ہرگاہ کانٛہہ بادشاہ سٕنٛدِس انٛدرمِس محلس منٛز ووت یتہِ تمِس بادشاہ وُچِھتھ ہیٚکہ تہٕ بادشاہن آسہ نہٕ سُہ بُلوومُت، سُہ نفر گژھِ قتل۔ صرف نہٕ سُہ یَس وُچِھتھ بادشاہ پنُن سۅنہٕ سُنٛد عاصہٕ تھود تُلِتھ ہاوِ۔ یہِ قانون چُھ سلطنتس منٛز ہر أکِس معلوم۔ لہٰذا کتھِ کٔنؠ گژھٕ بہٕ بادشاہس نِشہ یتھٕ پٲٹھؠ ژٕ ونان چُھکھ۔ بادشاہ سنٛدِ طرفہٕ چُھنہٕ مےٚ پتمہِ اکہ ریتہٕ پؠٹھ ناد تہِ سوزنہٕ آمُت، تہٕ ہرگاہ بہٕ نادٕ ورأی گژھٕ بہٕ گژھٕ مارٕ۔
\v 12 لہٰذا واتناوِ ہتاکنؔ آستیرؔ نہِ یمہٕ کتھٕ مردکیؔ یس نِش۔
\v 13 مردکیؔ ین ووٚن ہتاکسؔ آستیرِؔ وننہٕ خٲظرٕ "ژےٚ مٕہ روزنُے یہِ گمانہ زِ ژٕ روزکھ زندٕ تکیازِ ژٕ چھیٚکھ بادشاہ سٕنٛدِس محل خانس انٛدرےٕ روزان تہٕ تِمن چُھ ساری یہُودؠ قتل کرنُک منصوبہ۔
\v 14 اگر وُنؠ کیٚس ژٕ ژھۅپہٕ کٔرِتھ روزکھ، یہُودینؔ ییہِ کنہِ جایہ پٮ۪ٹھٕ بدل کانٛہہ نفر بچاونہِ، مگر چٲنؠ رشتہٕ دار روزن نہٕ زندٕ۔ کس چھےٚ پتاہ، شاید ما ژھیٚکھ ژٕ یموٕے حالاتو کنِؠ وُنہِ کیٚن ملکٲنؠ بنتھ بادشٲہی تام واژمٕژ۔"
\v 15 ہتاکنؔ ییٚلہِ یہِ ووٚن آستیرِؔ ووٚن، تمہِ سوز سُہ مردکیؔ یس نِشہ واپس یہِ وننہٕ خٲطرٕ زِ:
\v 16 سوسن شہرس منٛز بسَن وٲلؠ سٲری یہُودؠ کرکھ جمع تہٕ تِمن ون میانہِ باپتھ کرن دُعا تہٕ بیٚیہِ تھاون روزٕ۔ تِمن ون ترٛین دوٚہُن تہٕ ترٛین رٲژن نہٕ کِہین کھیوٚن چیٚون۔ میأنہِ نوکرانہِ تہٕ بہٕ روزو یتھے پٲٹھؠ روزدار۔ ترٛیو دوٚہو پتہٕ، اژٕ بہٕ بادشاہس سٟتؠ کتھ کرنہِ اگرچہ تہِ قانونس خلاف تہِ چُھ۔ بہٕ کرٕیہ ضرور ہرگاہ مےٚ زُو تہِ پیہِ چھپہِ دِیون۔"
\v 17 لہٰذا ووٚن ہتاکنؔ تس یہِ، تہٕ پتہٕ دراو مردکیؔ تہٕ کوٚرُن تہٕ سورےٕ یہِ آستیرؔ کرُن وُننَس۔
\c 5
\p
\v 1 ترییہِ دوٚہؠ پتہٕ کٔر آستیرؔ تہٕ تمؠ سنٛزو نوکرانیو اکھ بٔڈ ضیافت تیار۔ پتہٕ لوگ تمہِ شٲہی لباس، تہٕ سپٕز شٲہی محلہٕ کس انٛدرمِس آنٛگنس منٛز دربارؠ تختس برونٛہہ کنہِ اِستادٕ۔ بادشاہ اوس شٲہی محلس خانہٕ کِس دروازس سیدِ سیٚود پننِس شٲہی تختس پؠٹھ بہتھ۔
\v 2 یُتھےٕ بادشاہن ملکٲنؠ آستیرؔ آنٛگنس منٛز وۅدنؠ وُچھ، سُہ گوٚو سیٹھاہ خوش۔ أتی نیٚو تٔمؠ پنُن عاصہٕ تس کنُ، یہِ ہاونہٕ خٲطرٕ زِ سۅ ہیٚکہِ اصل پٲٹھؠ تمِس نِش یتھ۔ لہٰذا گییہِ آستیرؔ تختس نِشہ تہٕ عاصہٕ کِس کلس لوگُن اتھٕ۔
\v 3 پتہٕ پرُوژھ بادشاہن تس، "ملکٲنؠ آستیرؔ ژٕ کیازِ آیکھ یور؟ ژٕ کیا چھیٚکھ ونُن یژھان؟ مےٚ ون، یہِ ژٕ منٛگکھ تہِ یی ژےٚ دِنہٕ، یوٚدوے سُہ کوتاہ تہِ بوٗڈ آسہ۔"
\v 4 آستیرؔ فرموو یورٕ، "اے بادشاہ، ہرگاہ توٚہہ خوش گژھِ تیلہِ یی تو مہربٲنی کٔرتھ ہامانؔ ہیٚتھ تتھ دعوتس پٮ۪ٹھ یمیُک مےٚ تُہنٛدِ باپتھ سنٛز چُھ کۅرمُت۔"
\v 5 بادشاہن ووٚن پننؠن خدمت گارن، "گٔژھیو أنوون ہامانؔ فورن یُتھ زن أسؠ آستیرؔ ہُنٛد ونن بجا ہیٚکو اوٚنتھ! "لہٰذا گےَ بادشاہ تہٕ ہامانؔ تتھ دعوتس پٮ۪ٹھ یمیُک انتظار آستیرؔ تہٕ تہنٛزو نوکرانیو تِہنٛدِ خٲطرٕ کوٚرمُت اوس۔
\v 6 شراب چیٚنہٕ وزِ ووٚن بادشاہن آستیرِؔ، "وُنؠ ونتہٕ مہربٲنی کٔرِتھ ژٕ کیاہ چھیٚکھ اصلی یژھان۔ بہٕ چُھس تہِ دنہٕ خٲطرٕ تیار، یہِ کینٛژھا ژٕ منٛگکھ، سُہ کوتاہ تہِ بوٚڈ ٲسؠ تن۔ بہٕ چُھسے یہِ سۅدلہٕ ونان۔"
\v 7 آستیرؔ دِتُس یورٕ جواب، "یہِ بہٕ بنیٲدی یژھان چھیٚس تہِ چُھ یتھ کِنؠ زِ:
\v 8 ہرگاہ توٚہؠ مےٚ خوش چُھو، تہٕ مےٚ چُھو پزی یژھان، اے بادشاہ! تیٚلہِ دی تو مےٚ تہِ یہِ بہٕ یژھان چھیٚس، مہربٲنی کٔرتھ یی تو ہامانؔ ہیٚتھ پگاہ میٲنس دعوتس پؠٹھ بیٚیہِ یۅسہ بہٕ تُہنٛدِ باپتھ تیار کرٕ۔ پتہٕ دِمہٕ بہٕ تُہنٛدین سوالن جواب۔"
\v 9 ہامانؔ اوس خوشی محسوس کران ییٚلہِ سُہ تمہِ دوٚہہ دعوتہٕ پتہٕ درٛاو۔ مگر اتہِ وچُھن مردکیؔ بادشاہ سنٛدِس دروازس پٮ۪ٹھ بہتھ۔ مردکیؔ ووٚتھ نہٕ تمِس یزتھ کرنہٕ باپتھ تھوٚد یا سُہ وُچِھتھ ژایس نہٕ خوفہٕ سٟتؠ تھرٕ۔ امہ سٟتؠ کٔھژ ہامانسؔ مردکیؔ سنٛز سخ شرارت۔
\v 10 یوٚدوے ہامانَسؔ ژکھ سٮ۪ٹھاہ ژکھ کٔھژ مگر تٔمؠ ژٲپ یہِ ژکھ انٛدری۔ یہِ باس دنہٕ بجایہ گو سُہ گرٕ تہٕ تتہِ سونٛبرِن پنٕنؠ دوس تہٕ گرٕ واجِنؠ زرِشؔ،
\v 11 پتہٕ لوگ ہاماننؔ تِمن پنُن بجر تھیٚکُن تہٕ پننؠن اولادن ہُنٛد تہِ۔ اکھتُے تھیٚکنکھ یتہِ زِ بادشاہن کِتھ کٔنؠ دِژ مےٚ وزِ وزِ ترقی تہٕ تٔمؠ کِتھ کٔنؠ تھووُس بہٕ سارنی حٲکمن تہٕ عہدٕدارن سرس۔
\v 12 تمہِ علاوٕ ووٚن ہامانن، "یتُے یوت نہٕ، بہٕ چُھس سُہ واحد شخص یُس ملکایہ آستیرؔ بادشاہس سٟتؠ تتھ دعوتس پٮ۪ٹھ بُلوو یۅسہ تمہِ از سانہِ باپتھ دِژ، تہٕ سٟتی کٔرن صرف مےٚ أکِس دعوت پگاہ بیٚیہِ بادشاہس سٟتؠ سالس ینٕچ۔"
\v 13 پتہٕ ووٚن ہاماؔنن، "پوٚز تۅتام میلہٕ نہٕ مےٚ خوشی یوٚتام بہٕ سُہ یہُودؠ مردکیؔ بادشاہ سٕنٛدِس دروازس پؠٹھ بہِتھ وُچَھن یُس مےٚ احترام کرنَس اِنکار کران چُھ۔"
\v 14 پتہٕ کٔر ہامانؔ نہِ خاندارنہِ زرِشؔ تہٕ تمِسنٛدیو دوستو یہِ تجویز پیش زِ، "گۅڈٕ کرناو پننؠن خدمت گارن اتھِ پنٛژٕہہ میٹر تھوٚد اکھ کوٗٹ کھڑا۔ پتہٕ گژھِ صبحس بادشاہس نِشہ تہٕ ونُس زِ بہٕ چُھس یژھان مردکیؔ اتھ پؠٹھ پھٲسہِ کھالُن تہٕ مردکی قتل کرنہٕ پتہٕ ہکیٚو توٚہؠ پتہٕ اصل پٲٹھؠ بادشاہس سٟتؠ سالس گٔژھتھ۔ "ہامانؔن سونچ زِ یہِ چُھ اکھ رُت منصوبہ، لہٰذا ووٚن تٔمؠ پننٮ۪ن خدمت گارن پھَہہ کوٗٹ کھڑا کرنہٕ باپتھ۔
\c 6
\p
\v 1 تمہِ رٲژ آیہِ نہٕ بادشاہس نینٛدر۔ أتی ووٚن تٔمؠ تِمن جوانن یِم تمِس خدمتس ٲسؠ، أنیٚو سا پتمہِ شٲہی کاروٲیہِ۔ اکؠ جوانن انہِ پتمہِ کاروٲیہِ تہٕ لاجَن بادشاہس نِشہ زورٕ زورٕ پرنہِ۔
\v 2 پتمیٚن کاروٲین منٛز اوس لیکھتھ زِ شٲہی محٲفظ بگتاناؔ تہٕ ترشؔ یِم بادشاہ سٕنٛدِس ذٲتی رہٲیش گاہ کِس برانٛدس نگرٲنی ٲسؠ، ٲسؠ بادشاہ اخسویرسؔ قتل کرنُک منصوبہ بناوان۔ تتھ کاروٲیہِ منٛز اوس یتہِ درج زِ مردکیؔ ین ٲس تِہنٛز سۅ سٲزش فاش کٔرمژ تہٕ بادشاہ اوسُن تتھ متعلق خبردار کۅرمُت۔ تہِ کرنہٕ سٟتؠ بچٲوٕن بادشاہ سنٛز زنٛدگی۔
\v 3 پتہٕ پُرژھ بادشاہن، "اتھ عوض کُس اعزازا چُھ مےٚ مردکیؔ یس دیُتمت یمؠ میانؠ زنٛدگی بچٲومٕژ چھےٚ؟" تٔمؠ جوانن دِتُس جواب یُس تمِس خدمتس اوس زِ، "تمِس خٲطرٕ چُھنہٕ کانٛسہِ کینٛہہ کۅرمُت۔"
\v 4 تمی وزِ ژاو ہامانؔ بادشاہ سٕنٛدِس نیٚبرِمس آنٛگنس منٛز، یہِ وننہٕ باپتھ زِ سُہ چُھ یژھان مردکیؔ تتھ پھاسہِ کوٗٹس پؠٹھ کھالُن یُس تٔمؠ تسنٛدِ خٲطرٕ تیار اوس کوٚرمُت۔ یپٲرؠ اوس بادشاہ یژھان کانٛسہِ سٟتؠ مشورٕ کٔرتھ یہِ طے کرُن زِ مردکیؔ یس کِتھٕ پٲٹھؠ ییہِ عزت افزایی کرنہٕ، اوے پُرژھ تٔمؠ، "آنٛگنس منٛز کسُ چُھ؟"
\v 5 جوانن دِتُس جواب، "اے بادشاہ، ہامانؔ چُھ آنٛگنس منٛز کھڑا۔ "بادشاہن ووٚن، "سُہ أنوون یورؠ۔"
\v 6 ہامانؔ ییٚلہِ انٛدر ژاو، بادشاہن پُرژھ تمِس، "مےٚ کیاہ پزِ تمِس نفرٕ سٕنٛدِ خٲطرٕ کرُن یمِس بہٕ سۅدِلہٕ یزتھ کرُن چُھس یژھان؟ ہاماننؔ سونچ پانس متعلق، "یقینن چُھس بہٕ سُہ شخص یمِس بادشاہ ساروٕے کھۅتہٕ زیادٕ یزتھ دیُن چُھ یژھان!"
\v 7 ہاماننؔ ووٚن بادشاہس، "ہرگاہ توٚہؠ پٔزؠ پٲٹھؠ کانٛسہِ یزتھ بخشن یژھان چُھو،
\v 8 تیٚلہِ ؤنِو پننؠن خدمت گارن زِ تِم انَن سُہ شٲہی لباس یُس توٚہہ لوگمُت آسہ۔ بیٚیہِ انُن سُہ اکھ گُر یمِس توٚہہ سوٲرؠ کٔرمژ آسہ تہٕ پتہٕ تھٲیِو تہنٛدس کلس پؠٹھ اکھ شٲہی تاج یُتھ یہِ باس لگہ زِ یہِ چُھ تُہنٛد۔
\v 9 "پتہٕ گژھِ تُہنٛدِ طرفہٕ تُہنٛد کانٛہہ تھوٚد امیر تمِس یہِ لباس تہٕ گُر پیش کرُن۔ تُہنٛدؠ خدمت گار لاگن تمِس نفرس پلو یمِس توٚہؠ سۅدلہٕ یزتھ چُھو کرُن یژھان۔ گُرس کھٲلتھ گژھِ سُہ شہرس پھِرناونہٕ یُن۔ تہٕ سٟتؠ سٟتؠ گژھِ پارے دِنہٕ یِنؠ زِ یہِ چُھ بادشاہ سٕنٛدِ حکمہٕ سپدان، تکیازِ سُہ چُھ یمِس شخصس پزنہٕ پٲٹھؠ یزتھ دیُن یژھان!"
\v 10 بادشاہس آو یہِ منصوبہ پسنٛد تٔمؠ ووٚن ہامانؔس، "ؤلؠ ؤلؠ گژھِ! لباس تہٕ گُر ان تیار کٔرتھ تہٕ کرِ یہُودؠ مردکیؔ سنٛدِ خٲطرٕ تہِ یہِ ژےٚ وُنؠ ونُتھ۔ سُتہ چُھ میٚون اکھ خدمت گار یُس محلہٕ کِس دروازس پؠٹھ بہتھ چُھ۔ یاد تھاو یہِ ژےٚ ونُتھ تہِ کٔرؠ زِ سورےٕ۔
\v 11 لہٰذا کوٚر ہامانن بادشاہ سُنٛد حکم پوٗرٕ، تٔمؠ نیٚو لباس تہٕ گُر۔ تٔمؠ لٲگؠ مردکیؔ یَس پلو، گُرِس کھٲلِتھ پھرنوون شہرٕ منٛزؠ۔ تٔمؠ دِژ ژۅپٲرؠ پارے تہٕ ونُن، "بادشاہ چُھ یہِ اوٕ موٚکھٕ کران تکیازِ سُہ چُھ پزی یمِس شخصس یزتھ افزٲیی کران!"
\v 12 مردکیؔ آو بادشاہ سنٛدِس دروازس پؠٹھ واپس تہٕ ہامانؔ ژول شرمنٛدٕ گٔژھِتھ پنُن گرٕ۔
\v 13 ہاماننؔ کٔرؠ پنٕنؠ سٲری دوس بیٚیہِ جمع۔ تٔمؠ ووٚن تِمن تہٕ پننہِ زنانہِ زرِشؔ تہِ سورےٕ یہِ تمہِ دوٚہہ تمِس سٟتؠ واقع سَپدمُت اوس۔ تمؠ سنٛزِ خاندارنہِ تہٕ کینٛژو دوستو یِم تمِس مشیر تہِ ٲسؠ ووٚن تمِس، "مردکیؔ ین ہیٚوتےٕ ژےٚ شِکس دیُن۔ سُہ چُھ یہُودؠ لہٰذا ہیٚککھ نہٕ ژٕ تمِس پوشِتھ۔ سُہ ہارنٲوی ژےٚ۔
\v 14 تِم ٲسؠ وُنہِ پانہٕ وٲنؠ کتھےٕ کران تہٕ بادشاہ سنٛدؠ کینٛہہ محٲفظ آے ہامانسؔ آستیرؔ سنٛدِس سالس پٮ۪ٹھ ننہٕ خٲطرٕ یُس تمہِ تیار اوس کۅرمُت۔
\c 7
\p
\v 1 لہٰذا وٲتؠ بادشاہ تہٕ ہامانؔ ملکانہِ آستیرؔ سٕنٛدِس دویمِس سالس، یُس تمہِ تیار کوٚرمُت اوس۔
\v 2 دویمِس سالس دوران ییٚلہِ تِم شراب ٲسؠ نوش کران، بادشاہن پرُوژھ آستیرِؔ دُبارٕ، "ملکا آستیرؔ، مہربٲنی کٔرتھ ون مےٚ ژٕ کیاہ چھیٚکھ اصلی یژھان۔ ون مےٚ، بہٕ کرٕ تہِ چانہِ باپتھ۔ بہٕ دِمے ژےٚ کینٛہہ تہِ یہِ ژٕ منٛگکھ، چاہے سُہ کوتاہ تہِ بوٚڈ ٲسہ۔"
\v 3 ملکانہِ آستیرؔ ووٚن پتہٕ یورٕ، "اے بادشاہ، ہرَگاہ بہٕ ژےٚ خوش کران چھیٚسےَ، مےٚ چھےٚ امید زِ ژٕ کرکھ تہِ یہِ بہٕ منٛگہ۔ مہربٲنی کٔرتھ دِیو مےٚ زندٕ روزنُک موقہٕ، تہٕ مہربان روزِتھ بچٲوؠ توکھ میانؠ لوٗکھ۔ یہِ چُھ تہِ یہِ بہٕ منٛگان چھیٚس۔
\v 4 بہٕ چھیٚس توٚہہ گُزٲرش کران، تکیازِ کُستام چُھ مےٚ تہٕ میانین لوٗکن ہُنٛد دشمن بنیٚومُت، تہٕ سُہ چُھ اسہِ پوٗرٕ پٲٹھؠ تباہ کرنہِ درامتُ۔ ہرَگاہ تِمن مردن تہٕ مستوراتن کانٛہہ غلام بنٲوِتھ کٕنہِ ہے، تیٚلہِ ونہٕ ہو نہٕ بہٕ تتھ متعلق توٚہہ کینٛہہ تہِ، تکیازِ تمہِ باپتھ توٚہؠ بادشاہ تنٛگ کرٕنؠ اوس نہٕ ضروری۔
\v 5 بادشاہ اخسویرسنؔ دِیُت ملکانہِ آستیرؔ جواب، "یہِ کمؠ چُھ کۅرمُت؟ کتہِ چُھ سُہ شخص یمؠ یژھ کٲم کرنٕچ حماقت کٔرمٕژ چھےٚ؟
\v 6 آستیرؔ وتُھس یورٕ، "سُہ شخص یُس سون بوٚڈ دشمن چُھ، چُھ یہِ بدبخت شخص ہامانؔ! "امہِ سٟتؠ کھوٚژ ہامانؔ بادشاہس تہٕ ملکانہِ برونٛہہ کنہِ۔
\v 7 بادشاہس کٔھژ تیژ شرارت زِ سُہ ووٚتھ شرابہٕ محفلہِ منٛزٕ تھوٚد تہٕ درٛاو۔ سُہ دراو نیٚبر محلہٕ خانہٕ کِس باغس منٛز، وُنؠ کیاہ فٲصلہٕ نمہٕ۔ مگر ہامانؔ ٹھہریوو انٛدرے تہٕ لوٚگ ملکانہِ آستیرِؔ پننہِ زُو برٲنٛژ باپتھ زارٕ پارٕ کرنہِ، تکیازِ تمِس توٚر فِکرِ زِ بادشاہ کرِ تمِس قتل۔
\v 8 سُہ اوس پننہِ زنٛدٕگی باپتھ زارٕ پارٕ کران، ہامانؔ گو تمِس تتھ پلنٛگس نزدیک یتھ پؠٹھ آستیرؔ بہتھ ٲس۔ بادشاہ ییٚلہِ محلکہِ باغہٕ منٛز تتھ کمرس کُن واپس آو یتہِ سُہ مےَ نوشی کران اوس، تٔمؠ وُچھ یہِ۔ بادشاہن دِژ کریٚکھ، "سُہ چُھ میانہِ ملکانہِ میانہِ موجودگی منٛز تہِ میانؠ سےٕ گرس منٛز بےٚ ہرُمٔتی کرنٕچ کوشش کرٕنؠ ہیٚوان! "یتُھےٕ بادشاہن یہِ ووٚن، تہنٛدیو کینٛژو خدمت گارو دبوو ہامانؔ سُنٛد بُتھ، قتل کرنہٕ ینُک اوس سُہ اکھ اِشارٕ۔
\v 9 بادشاہ سنٛدین محافظن منٛز اوس اکھ محافظ خربوناؔ یُس بادشاہس ذٲتی خدمت گار اوس، تٔمؠ ووٚن، "اے بادشاہ! ہامانؔن چُھ پننہِ گرِ بیٚیہِ اکھ پنٛژٕہہ میٹر تھوٚد پھاسہِ کوٗٹ کھڑا کوٚرمُت۔ تکیازِ سُہ چُھ یژھان مردکیؔ یَس تتھ پؠٹھ پھٲسؠ دِنؠ۔ مگر مردکیؔ ین بچٲو تُہنٛز زنٛدٕگی۔ "بادشاہن ووٚن، "تتھ پؠٹھ دِیو ہامانس پھٲسؠ!"
\v 10 لہٰذا دِیُت تِموؔ ہامانؔ تتھ پؠٹھ پھہہ یُس تٔمؠ مردکیؔ سٕنٛدِ باپتھ تیار کوٚرمُت اوس۔ ادٕ ووٚتھ بادشاہس تہِ شرارتھ۔
\c 8
\p
\v 1 تمہِ دوٚہہ، کوٚر بادشاہ اخسویرسنؔ ہامانُن سورےٕ جایٔداد ملکایہِ آستیرؔ حوالہٕ۔ سُہ اوس یہُودینؔ ہُنٛد دشمن روٗدمت۔ آستیرؔ ووٚن بادشاہس زِ مردکیؔ چُھ تس پِتٕر بوے، سُہ چُھ مےٚ مٲلس برابر۔ یہِ بوزِتھ اننوو بادشاہن مردکیؔ پانس نِش۔
\v 2 ییٚلہِ بادشاہن ہامانَؔس موتُک سزا لیٚوکھ، تٔمؠ ہیٚژ تس سۅ وٲج واپس یتھ پؠٹھ بادشاہ سنٛز مُہر ٲس تہٕ بادشاہن لٲج سۅ دُبارٕ واپس۔ بادشاہن کڈ پتہٕ سۅ بیٚیہِ نیٚبر تہٕ دِژن مردکیؔ یس، یہِ ہاونہٕ خٲطرٕ زِ مردکیؔ یَس آسن بادشاہ سٕنٛدِ حکمہٕ سٟتؠ بادشاہ سنٛدؠ اختیار۔ آستیرؔ تہِ بنوو مردکیؔ ہامانؔ سٕنٛدِ سٲری جائیدادک تحویل دار۔
\v 3 پتہٕ آیہِ آستیرؔ کتھ کرنہٕ باپتھ دُبارٕ بادشاہس برونٛہہ کُن۔ تس عٲجزی تہٕ زارٕپارٕ کرنہٕ موکھٕ، تمہِ کوٚر سجدٕ تہٕ پنُن بُتھ تُرووُن بادشاہس کھوٚرن پؠٹھ۔ تمہِ کوٚر تس ودان ودان زارِ پارٕ تہٕ وننس زِ یہُودؠ مارنُک ہامانؔن خوفناک منصوبہ رکٲوؠ تو۔
\v 4 بادشاہن کوٚڈ آستیرؔ کُن پنُن سۅنہٕ سُنٛد عاصہٕ، لہٰذا ؤژھ سۅ فرشہِ پؠٹھٕ تھوٗد تہٕ بُتھ کوٚرن بادشاہس کنُ۔
\v 5 پتہٕ ووٚن آستیرؔ، "تہنٛز شان ٲسِن بُلنٛد، ہرگاہ توٚہہ باسان چُھ تہِ کرُن چُھ جان تہٕ ہرَگاہ توٚہؠ مےٚ رٲضؠ چُھو، تیٚلہِ لیکھؠ تو مہربٲنی کٔرتھ اکھ نٔو چِٹھؠ یۅسہ اجاجی ہمداتاؔ سٕنٛدِس نیٚچوؠ سنٛز نیٚبر سوزمَژن چِٹھین رَد کرِ۔ تِہنٛزن چِٹھین منٛز اوس تُہنٛدس سلطنتس منٛز کُنہِ تہِ جایہِ بسان وٲلؠ تمام یہُودؠ ختم کرنُک حکم دِنہِ آمُت۔
\v 6 بہٕ چھیٚس یہِ اوٕ موٚکھٕ ونان تکیازِ بہٕ کرنہٕ پننؠن لوٗکن ہنٛز سپدن واجِنؠ تبأہی وُچھنؠ برداش۔ تِم چھِ میٲنؠ رشتہٕ دار۔ بہٕ ہیٚکہٕ نہٕ تِمن لوٗکن ہنٛز تبأہی برداش کٔرتھ۔
\v 7 بادشاہ اخسویرسنؔ ووٚن ملکانہِ آستیرؔ تہٕ یہُودؠ مردکیؔ یَس، "توٚہہ چُھ یہِ پتاہ زِ مےٚ دیُت ہاماؔنُن سورےٕ جائیداد آستیرؔ ملکایہ، تہٕ مےٚ کھالہٕ نوو ہامانؔ پننیٚو خدمت گارو دٔسؠ أکِس لکٕرِ ہنٛدس کوٗٹس پؠٹھ پھاسہِ تکیازِ سُہ اوس یژھان تمام یہُودؠ قتل کرٕنؠ۔
\v 8 توٚہؠ چُھو یتہِ زانان زِ کانٛہہ اکھ تہِ ہیٚکہ نہٕ میٲنؠ چِٹھؠ منسوخ کٔرتھ یتھ میٚون ناو تہٕ مُہر آسہ۔ یتھٕ پٲٹھؠ ہامانؔن سۅ چِٹھؠ لیٚچھؠ۔ لہٰذا پزِ توٚہہ یہُودینؔ مدد کرنہٕ باپتھ یِتھؠ کٔنؠ کرُن زِ توٚہؠ لیٚکھیو اکھ نُو خط، یتھٕ پٲٹھؠ توٚہہ رُت باسہِ۔ میٚون آسہ توٚہہ اِجازتھ تتھ چِٹھ پؠٹھ میٚون ناو لیٚکھنک تہٕ میانہِ واجہ ہنٛز مُہر تراونُک یۅسہ میانؠ سرکأری مُہر چھےٚ۔"
\v 9 اوے سوزؠ بادشاہن پنٕنؠ کٲتب۔ تِم آیہِ تہٕ تِمو کٔر سۅ پرٛتھ کانٛہہ کتھ تحریر یۅسہ مردکیؔ ین تِمن لیکھنؠ ؤنؠ۔ تِمو لیچھؠ یہِ چِٹھؠ تُرٛووُہمہِ تٲریخہٕ ورؠ یکہٕ ترٛیمہِ ریتہٕ سیوانکِس ریٚتس منٛز، باہ ورؠ برونٛٹھ یمہِ دوٚہہ اخسویرسنؔ فارس کِس بادشاہ سٕنٛدِ حثیتہٕ استعفیٰ دِتمُت اوس۔ چِٹھؠ آیہِ سلطنتس منٛز یہُودینؔ ہنٛدِ ناوٕ تحریر کرنہٕ، مگر تمیٚک نقل آو شٲہی امیرن، تہٕ پرٛتھ صوبہٕ کیٚن گورنرن تہٕ سردارن سوزنہٕ۔ اخسویرسؔ سٕنٛدِس سلطنتس منٛز ٲسؠ اکھ ہتھ تہٕ ستووُہہ صوبہٕ، یم ہندوستان کہ مشرقہٕ طرفہٕ پؠٹھٕ اِتھوپیاؔ کِس مغربس تام پھلِتھ ٲسؠ۔ کٲتبو لیٚوکھ پرٛتھ صوبہٕ کیٚن لوٗکن پن پننہِ زبٲنؠ تہٕ حرفن منٛز۔ تِمو لیٚوکھ خصوصی طور یہُودینؔ، تہنٛزِ زبٲنؠ تہٕ تہنٛدِنےٕ حرفن منٛز۔
\v 10 مردکیؔ ین کوٚر چِٹھِ ہنٛدِس پرٛتھ نقلس بادشاہ اخسویرسؔ سنٛدِ ناوٕ سٟتؠ دستخط تہٕ بیٚیہِ ترٲوٕن پرٛتھ کنہِ بادشاہ سنٛزِ تمہِ واجہ سٟتؠ مُہر یۅسہ بادشاہ سنٛز سرکٲرؠ مُہر ٲس۔ تمہٕ چٹھِ آیہِ گُرین پؠٹھ شیٚچھِ گرین ہنٛدِ دٔسؠ پرٮ۪تھ جایہ واتناونہٕ۔ تِم گے تِمن تیز گُرین پؠٹھ سوار یِم صرف بادشاہ سنٛزن کٲمیٚن باپتھ مقرر ٲسؠ۔ تِم گُرؠ ٲسؠ شٲہی طبیلن منٛز تیار گمٕتؠ۔
\v 11 ہَرکُنہِ چٹھِ منٛز اوس وننہٕ آمُت زِ بادشاہ چُھ سٲرسےٕ سلطنتس منٛز تمام یہُودینؔ متحد گژھنُک تہٕ پانس رٲچھ کرنہٕ باپتھ لڑنُک اجازت دِوان۔ بادشاہ سنٛز چٹھؠ ٲس تِمن یِتہِ اجازت دِوان زِ تِم ہیٚکن تِمن ہتھیار بنٛد جمٲژن ہنٛدین نفرن بُرباد کٔرتھ یِم تِمن پؠٹھ حملہٕ کرن چاہے تِم کُنہِ تہِ صوبس منٛز آسن۔ چٹھؠ ٲس تِمن بیٚیہِ یتہِ اجازت دِوان زِ تِمن پؠٹھ حملہِ کرن والین ہنٛدؠ شُرؠ تہٕ زنانہٕ گژھن قتل کرنہِ، تہٕ تِہنٛد جائیداد گژھن ضبط کرٕنؠ۔
\v 12 چٹھِ دیُت اخسویرسؔ سلطنت کین سارنےٕ صوبن منٛز تمام یہُودینؔ تمہِ ورؠ یہِ ادار ریتہٕ کِس ترٛوہٲمِس دوٚہس پؠٹھ یہِ کرنس اِجازتھ۔ یہِ اوس تِمن اکی دوٚہہ کرُن۔
\v 13 چِٹھیٚن منٛز اوس عہدٕدارن لؠکھنہٕ آمُت زِ تِم لاگن یمَن چِٹھیٚن ہُنٛد نقل تتھ جایہِ یتن تمام لوٗکھ یہِ وُچِھتھ ہیٚکن تہٕ زانن بادشاہ سُنٛد یہِ حکم، تہٕ یتھٕ پٲٹھؠ روزَن یہُودؠ پننؠن دشمَنن خلاف لڑنہٕ باپتھ تیار ییٚلہِ سُہ موقہٕ واتہِ۔
\v 14 بادشاہن کوٚر شیٚچھِ گرین چِٹھؠ ؤلؠ ؤلؠ واتناونُک حکم۔ تٔمؠ سوزؠ تِم پننؠن تیز رفتار گُرین پؠٹھ۔ بادشاہ سنٛدیو عہدٕدارو تہِ کوٚر چِٹھین ہُنٛد نقل ہاوِتھ سوسن شہرچہ رازدانہِ منٛز نَوِ فرمانُک اعلان۔
\v 15 بادشاہن دیُت مردکیؔ یَس خاص پوشاک لاگنہٕ خٲطرٕ تاکہِ سُہ باسہِ وُنؠ بادشاہ سُنٛد سیٹھاہ اہم عہدٕدار۔ تٔمؠ دِیُت تمِس اکھ نیوٗل تہٕ سفید شٲہی پوشاک، اکھ بوٚڈ سۅنہٕ سُنٛد تاج، تہٕ اکھ لِلنہِ ہُنٛد فیروزی رنگہٕ جامہٕ۔ مردکیؔ درٛاو محلہٕ منٛز سُہ پوشاک لٲگتھ۔ ییٚلہِ سُہ سوسن کیٚو لوٗکو وُچھ تِمو دتؠ خوشی ہنٛدؠ نعرٕ۔
\v 16 سوسنس منٛز بسن وٲلؠ یہُودؠ گے سیٹھاہ خوش، تہٕ باقی لوٗکو کوٚر تِمن یزتھ۔
\v 17 یتھ یتھ صوبس تہٕ یتھ شہرس شیٚچھِ گریو چٹھِ واتناوِ یمن منٛز شٲہی فرمانُک اعلان اوس، یہُودینؔ سپز خوشی تہٕ منووُکھ جشن۔ سلطنتس منٛز گوٚو واریہن لوٗکن یہُودینؔ ہُنٛد خوف تہٕ تِم بنییہِ پانہٕ تہِ یہُودؠ۔
\c 9
\p
\v 1 تمی وریکہِ بہمہِ ریٚتہٕ یانے ادار ریٚتکہِ تُروٲہمہِ دوٚہہ ییٚلہِ بادشاہ سٕنٛدِس تتھ فرمانس پؠٹھ ہر کٲنٛسہِ عمل کرنُک حکم اوس یُس تٔمؠ چِٹھین منٛز جٲری اوس کۅرمُت۔ یہُودینؔ ہنٛدین دشمَنن ٲس امید زِ تمہِ دوٚہہ ین یہُودؠ بُرباد کرنہٕ۔ مگر تتھ گوو ادلہٕ بدل۔ تمہِ بجایہ کٔرؠ یہُودیو پنٕنؠ دُشمن بُرباد۔
\v 2 پوٗرٕ اخسویرسؔ سلطنتس منٛز گے یہُودؠ پننؠن پننؠن شہرن منٛز جمع، یُتھ زن تِم تِمن نِشہ پانس حفاطت کرہَن یِم تِمن نقصان واتناوُن یژھان ٲسؠ۔ تِمن سٟتؠ لڑنہٕ خٲطرٕ اوس نہٕ کانٛسہِ طاقتھ، تکیازِ سٲرسےٕ سلطنتس منٛز اوس ہر أکِس تُہنٛد خوف، کانٛسہِ اکؠ تہِ کوٚر نہٕ یہُودینؔ پؠٹھ حملہِ کرنس منٛز تِمن مدد۔
\v 3 ہَر أکِس صوبس منٛز ٲسؠ تمام سردار، شٲہی عہدٕدار، حٲکم تہٕ ہرِ کانٛہہ یُس بادشاہ سنٛزِ کامہِ ہُنٛد مختار اوس یہُودینؔ مدد کران، تکیازِ تِمن اوس مردکیؔ سُنٛد روب بیوٹھمُت۔
\v 4 تِم ٲسؠ مردکیؔ یس کھۅژان تکیازِ سُہ اوس اکھ تھوٚد شٲہی عہدٕدار۔ پوٗرٕ سلطنتس منٛز اوس ہَر کانٛہہ تہنٛدِس بُجرس متعلق بوزان، تکیازِ مردکیؔ اوس زیادٕ کھۅتہٕ زیادٕ تھزر لبان۔
\v 5 یمہِ دوٚہہ تِمن پانس حفاظت کرنُک اجازت اوس، تِمو یہُودیو کٔڈؠ پنٕنؠ ہتھیار تہٕ لُڈکھ پننؠن تمام دُشمنن خلاف۔ تِمو یہُودیو کٔرؠ تِم مکمل تباہ۔ تِمن اوس پننؠن دُشمنن سٟتؠ تہِ کرنُک طاقت یہِ تِم یژھٕ ہَن۔
\v 6 سوسن چہِ رازدانہِ منٛز کٔرؠ یہُودیو پانٛژھ ہتھ نفر قتل۔
\v 7 تِمو یہُودیو کٔرؠ بیٚیہِ ہاماننؔؠ داہ نیٚچوؠ قتل۔ تہنٛدین نیٚچوٮ۪ن ہنٛدؠ ناو ٲسؠ پرسنداتاؔ، دلفونؔ، اسپاتاؔ،
\v 8 پوراتاؔ، ادلیاہؔ، اردتاؔ،
\v 9 پرمشتاؔ، اریسیؔ، اردیؔ تہٕ ویزاتاؔ۔
\v 10 ہمداتاؔ سٕنٛدِس نیٚچوِس ہامانؔس ٲسؠ داہ نیٚچوؠ یِم یہُودینؔ ہنٛدؠ دشمن ٲسؠ۔ یہُودیو کٔرؠ تِم قتل مگر تِمو لوٗٹ نہِ تِہنٛد جایٔیداد۔
\v 11 سُہ دوٚہہ انٛد واتنہٕ پتہٕ آو کُستام بادشاہس نِشہ تہٕ دِژن تس خبر زِ سوسن شہرچہ رازدانہِ منٛز کٟتؠ لوٗکھ آیہِ یہُودیو دسؠ قتل کرنہٕ۔
\v 12 لہٰذا ووٚن بادشاہن ملکٲنہِ آستیرِؔ، "یتہِ سوسن شہرچہِ رازدانہ منٛز کٔرؠ یہُودیو ہامان نیٚن نیٚچوٮ۪ن سان پانٛژھ ہتھ نفر قتل۔ میانہِ سلطنتہِ کیٚن باقیو حصن منٛز آسن تِمو امہِ کھۅتہٕ تہِ زیادٕ نفر قتل کٔرمٕتؠ! لہٰذا ونتہٕ بیٚیہِ کیا چھیٚکھ ژٕ یژھان؟ مےٚ ون، بہٕ کرٕ تتہِ چانہِ باپتھ یہِ ژٕ ونکھ، مہربٲنی کٔرتھ کرِ ژٕ پنٕنؠ خٲہش ظٲہِر۔"
\v 13 آستیرؔ دیُت جواب، "اے بادشاہ، اگر توٚہہ باسہِ زِ یہِ چُھ اکھ رُت منصوبہ، تیٚلہِ گوٚژھ مہربٲنی کٔرتھ پگاہ تہِ یہُودینؔ دُبارٕ تہِ کرنُک اجازت دِنہٕ یُن یہِ تِمو از سوسن شہرس منٛز کوٚر۔ بیٚیہِ کٔرؠ تو پننؠن خدمت گارن حکم زِ تِم تھاوٕہن ہامانؔ سنٛدین دہن نیٚچوٮ۪ن ہنٛزٕ لاشہٕ پھہہِ کوٗٹین پؠٹھ اویزان۔"
\v 14 بادشاہن کوٚر تی یہِ آستیرؔ ووٚن۔ تٔمؠ کوٚر اکھ فرمان جٲری یتھ منٛز یہُودینؔ سوسن شہرس منٛز دویمہِ دوٚہہ تہِ پننؠن دشمنن خلاف لڑنُک اِجازتھ دِنہٕ آو، تہٕ تٔمؠ کوٚر پننؠن خدمت گارن حکم زِ ہاماننینؔ دہن نیٚچوٮ۪ن ہنٛزٕ لاشہِ گژھن اویزان تراونہٕ یِنہِ۔
\v 15 تہٕ ادار ریتکہِ ژوٚدٲہمہِ دوٚہہ تہِ گییہِ سوسن شہرس منٛز بسَن وٲلؠ یہُودؠ جمع تہٕ بیٚیہِ ترٛےٚ ہتھ نفر کرِکھ قتل۔ مگر بیٚیہِ تہِ لوٗٹ نہٕ تِمو تِمن نفرن ہُنٛد جائیداد۔
\v 16 یِم یہُودؠ سلطنتہٕ کین باقین حصن منٛز روزان ٲسؠ تِم تہِ ٲسؠ ادار ریٚتکہِ ترٛوٲہمہِ تٲریخہ جمع سپدمتؠ، تہِ پننؠن دشمنن ٲسُکھ شِکس دیتمُت تہٕ پنٛژسَتتھ ساس نفر کٔرؠ تِمو قتل۔ مگر پننؠن دشمنن ہنٛدس جائیدادس ترووُکھ نہٕ اتھٕ۔
\v 17 ادار ریتکہِ ترٛوٲہمہِ تٲریخہ پننؠن دشمنن شِکس دِنہٕ پتہ کوٚر تِمو ژووٚدٲہمہِ تٲریخہ آرام۔ ژۅدٲہمہِ تٲریخہ منوو تِمو شٲدؠ یانہٕ۔
\v 18 مگر سوسن شہرس منٛز روزَن وٲلؠ یہُودؠ روٗدؠ ادار ریتکہِ ترٛوٲہمہِ تہٕ ژۅدٲہمہِ دوٚہہ پننؠن دشمنن خلاف لڑان۔ تِمو کوٚر پندٲہمہِ دوٚہہ آرام۔ تِمو منوو سُہ شٲدؠ یانُک دوٚہہ۔
\v 19 توے چھِ گأمی علاقن منٛز یہُودؠ لوٗکھ ادار ریتکہ پندٲہمہِ دوٚہہ بوٗڈ دوٚہہ مناوان نہٕ کہ ژۅدٲہمہِ تٲریخہٕ۔ تِم چھِ امہِ دوٚہہ شادمٲنی کران تہٕ اکھ أکِس ڈالہِ نِوان۔
\v 20 مردکیؔ ین لیوکھ تہِ سورےٕ یہِ سپدمتُ اوس۔ پتہ لیچھِ تٔمؠ پورٕ اخسویرسؔ سلطنتس منٛز تمام یہُودینؔ چِٹھِ، یتہِ تِم روزان ٲسؠ۔
\v 21 تٔمؠ کٔر ادار ریتُک ژۅدٲہم تہٕ پندٲہم تٲریخ چُھٹی مقرر۔ تٔمؠ ووٚن یہُودینؔ وریس منٛز اکہ لٹہِ یہِ دوٚہہ مناون۔
\v 22 تکیازِ تِمن دوٚہُن کوٚر یہُودیو آرام تہٕ تِمن اوس نہٕ وُنؠ پننؠن دشمنن سٟتؠ لڑُن۔ تمی ریتہٕ بدلیو تہنٛدِ خٲطرٕ سورےٕ کینٛہہ۔ تم ٲسؠ سیٹھاہ تکلیفس منٛز آسان، تکیازِ تہنٛدؠ دشمن ٲسؠ تِمن بُرباد کرن وٲلؠ۔ مگر پتہٕ سپدؠ تِم سیٹھاہ خوش۔ وُنؠ ٲسؠ تِم پننؠن دشمنن نِشہ محفوظ۔ لہٰذا ووٚن مردکیؔ ین تِمن زِ تمہ دوٚہہ منٲیو خوشی، اکھ أکِس دِیو ڈألؠ۔ مردکیؔ ین ووٚن تِمن بیٚیہِ گژھِ تِمن دوٚہُن غریبن مدد یُن کرنہٕ۔
\v 23 یہُودؠ ٲسؠ برونٛہہ تہٕ تِم دوٚہہ تِتھے کِنؠ مناوان۔ لہٰذا کوٚر تِمو مردکیؔ سنٛدین ہدایتن سٟتؠ اتفاق۔
\v 24 تمہٕ دوٚہہ منٲوتھ اوس یاد کرنہٕ یوان زِ اجاجی ہمداتاؔ سنٛدؠ نیٚچوؠ ہامانؔن کمہِ طریقہٕ کٔر تمام یہُودؠ تباہ کرنچ کوٗشش۔ تٔمؠ آسہ یہُودینؔ پؠٹھ حملہ کرنہٕ باپتھ رُت دوٚہہ ژارنہٕ خٲطرٕ چیرِ تراوِمژٕ تاکہِ تِم گژھن مکمل طور تباہ۔
\v 25 تِم کرن آستیرؔ ہنٛز سۅ ہمتھ یاد، ییٚلہِ سۅ بادشاہس نِشہ گییہِ۔ یمہِ ساعتہٕ نہٕ تسَ بادشاہ سُنٛد ناد اوس۔ پتہٕ دِیُت بادشاہن مردکیؔ یس اجازت پورٕ سلطنتس اکھ چِٹھؠ سوزنُک، یتھ منٛز یہُودؠ تباہ کرنُک ہامانؔ سُنٛد شیطانی منصوبہ بدلاونہٕ آو۔ بادشاہن دِیُت پننؠن خدمت گارن حکم زِ ہامانؔس کھالن لکٕرِ ہنٛدس کوٗٹِس پؠٹھ پھاسہ۔ ییٚلہِ یہُودیو ہامانؔنؠ داہ نیٚچوؠ قتل کٔرؠ، بادشاہن کھالناوِ تہنٛزٕ لاشہٕ پننؠن خدمت گارن اتھِ پھہہِ کوٗتین پٮ۪ٹھ۔
\v 26 چیرِ، لفظکُ فارسی مطلب چُھ "پُور" توے چُھ یہُودیو اتھ جشنَس پُورم ناو تھوومتُ۔ تکیازِ تِمن ٲسؠ تتھ دوران حٲرت انٛگیز واقات پیش آمٕتؠ تہٕ پتہٕ لیوکھ مردکیؔ ین تِمن سُہ دوٚہہ گژھِ بڈِ دوٚہہ رنگؠ مناونہٕ یُن،
\v 27 یہُودیو کوٚر تتھ سٟتؠ اتفاق زِ تِم زٕ دوٚہہ ین تِتھے پٲٹھؠ مناونہٕ یتھٕ پٲٹھؠ مردکیؔ ین تِمن ووٚنُمت اوس۔ تِمو کوٚر اتِفاق زِ تِم تہٕ تِہنٛدؠ ینہِ وٲلؠ نسٕل تہِ یِم یہُودؠ لوٗکن ہنٛدؠ حصہٕ بیٚیہِ مناون ہمیشہِ خٲطرٕ پرٛتھ ورؠ یہِ یہِ پُورم بوٚڈ دوٚہہ۔
\v 28 اوے چُھ ہَر کانٛہہ یہُودؠ خاندان سُہ کُنہِ تہِ جایہ ٲسؠ تن تنہٕ پؠٹھٕ یہِ دوٚہہ مناوان آمُت۔ یہُودؠ قوم تہٕ تہنٛدؠ وٲرث مناون ہمیشہِ یہِ پوٗرم بوٚڈ دوٚہہ وفادٲری سان۔
\v 29 پتہٕ لیوکھ ابیخیلؔ سنٛزِ کورِ آستیرؔ ملکانہِ مردکیؔ یہُودؠ سٕنٛدِ مدٕتہٕ دوٚیم خط پورِیؔمس متعلق۔ تکیازِ آستیرؔ ٲس مٔلکٲنؠ، تمِس اوس یہُودینؔ حکم کرنُک اختیار یہِ زن مردکیؔ ین تِمن پورِیمس متعلق لیکھنہٕ آمتِس خطس منٛز لیٚوکھ۔
\v 30 تِمو سوزؠ تِمہِ دوٚیمہِ خطکؠ نقل اخسویرسؔ سنٛدِس دُرس سلطنتس منٛز تمام یہُودینؔ۔ امہِ سٟتؠ گٔییہِ تِمن حوصلہٕ افزایی زِ تِہنٛدِ خٲطرٕ ٲسؠ وُنؠ حالات ٹھیک پُر امن تہٕ تِم ٲسؠ محفوٗظ۔
\v 31 دوٚیمس خطس، منٛز اوس یہُودؠ مردکیؔ ین تہٕ ملکانہِ آستیرؔ تِمن یقین دِیتمُت زِ تِم روزَن ادار ریتکہِ ژۅدٲہمہ تہٕ پندٲہمہِ دوٚہہ پوریم مناوان۔ تِمو لیوکھ تِمن یِتہِ زِ یہُودینؔ پزن یِمن موقن پٮ۪ٹھ روزٕ تہِ تھاونہِ تہٕ ماتم تہِ کرُن۔ یہِ زن یہُودیو پننہِ تہٕ پننؠن زُریٚن ہنٛدِ خٲطرٕ قایٔم کوٚرمُت چُھ۔
\v 32 آستیرِؔ کوٚر اکھ فرمان جٲری یتھ منٛز یہُودینؔ پورِیم کِس موقس پٮ۪ٹھ چُھٹی ہُنٛد اعلان کرنہٕ آو، تہٕ شٲہی کٲتبو لیٚوکھ یہِ قانونچہِ کتابہِ منٛز۔
\c 10
\p
\v 1 پتہٕ کوٚر بادشاہ اخسویرسنؔ سلطنت کِس پرٮ۪تھ فردس پٮ۪ٹھ باج مقرر، ہتاکہ تِمن پؠٹھ تہِ یِم سمندر کیٚن جزیرن منٛز روزان ٲسؠ۔
\v 2 بادشاہ سنٛدیو کٲتِبو کٔرؠ مادی تہٕ فارس کین شٲہی توٲریخن منٛز بادشاہ اخسویرسؔ سنٛزٕ تمام مکمل کرِمژٕ بجہِ کامہِ درج۔ تکیازِ سُہ اوس تیوٗت طاقتور۔ بیٚیہِ لیٚوکھ تِمو تتھ کتابہِ منٛز تفصیلن مردکیؔ سنٛدؠ دسؠ کرنہٕ آمژن بجن کامین ہُنٛد تہِ، تکیازِ بادشاہن ٲس تمِس ترقی دِتھ اہم عہدٕ بخشمُت۔
\v 3 یہُودؠ مردکیؔ ہیٚوک واریاہ کینٛہہ کٔرتھ تکیازِ سلطنتس منٛز اوس سُہ بادشاہ اخسویرسؔ پتہٕ زیادٕ اختیار وول شخص۔ سُہ اوس پننہِ قومُک اکھ سردار تہِ۔ تمام یہُودؠ برادری ٲس تمِس یزتھ کران۔ تٔمؠ کٔر سَخت محنت زِ یہُودؠ گٔژھؠ ہمیشہ خوشحال آسٕنؠ۔
