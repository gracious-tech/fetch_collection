\id 1TH - DMT Kashmiri
\toc1 1 تھِس
\mt1 1 تھِس
\c 1
\p
\v 1 بہٕ پولُسؔ چھُس یہِ نامہٕ لیٚکھان۔ سلوانسؔ\f + \fr 1‏:1 \ft پولُسؔ چُھ پننس اکس سٲتھیس سلوانسؔ ونان مگر سُہ چُھ سوے شخص یمِس "عملہٕ" کتابہٕ اندر سلاسؔ ونان چھِ\f* تہٕ تیمُتھیس چھِ مےٚ سٟتؠ۔ أسؠ چھی یہِ نامہٕ توٚہہِ تھِسلُنِیکا شہرس منٛز مسیحؔ یس پیٚٹھ ایمان تھاون والیٚن سوزان، یِم بب خدایس بیٚیہِ خداوند یسوع مسیحسؔ سٟتؠ متحد چھِ۔ خدا روزِن توٚہہِ پیٚٹھ فضل تہٕ سلامتی سوٗزن۔ \f + \fr 1‏:1 \ft یہِ خط چُھ پولُسؔ لیٚکھان، سلوانسؔ تہٕ تموتھیسؔ چھِ تس صرف خوش آوے منٛز شٲمل سپدن۔ \f*
\v 2 أسؠ چھِ اکثر تُہنٛدِ باپتھ دُعا کرن۔ أسؠ چھِ توٚہہِ سارنےٕ ہنٛدِ باپتھ خدایہِ سُنٛد شکُر ادا کران۔
\v 3 أسؠ چھِ پننِس ببَ خدایس تُہنٛزِ تتھ کامہِ پیٚٹھ شکُر گُزار یِس توٚہؠ کرن چھیو تکیازِ توٚہہِ چھِ تس پیٚٹھ پژھ۔ أسؠ چھِ تمس تُہنٛدس تتھ طریقس پیٚٹھ شکُر گزار زِ توٚہؠ چھیو ہمتہٕ سان لوٗکن مدد کران تکیازِ توٚہؠ چھیو لول بران۔ أسؠ چھِ تمس تتھ تُہنٛدس طریقس پیٚٹھ شکُر ادا کران زِ توٚہؠ چھیو صبرٕ سان برداش کران تکیازِ توٚہؠ چھِ اعتماد سان امید زِ توٚہہِ روزیٚو سٲنس خداوند یسوع مسیحؔ سُنٛد وعدٕ پالان۔
\v 4 أسؠ چھِ بییٚہِ خدایس شکُر ادا کران تکیازِ اسہِ چھِ پتاہ زِ سُہ چُھ توٚہہِ مسیحؔ ہس پیٚٹھ ایمان تھاون والین سانؠن باین لول بران، تہٕ توٚہؠ ژٲرؠ نو تمؠ سٕنٛدؠ لوٗکھ بننہٕ خٲطرٕ۔ \f + \fr 1‏:4 \ft افسینؔ 1:4\f*
\v 5 اسہِ چھِ پتاہ زِ خداین ژٲرؠ نو توٚہؠ تکیازِ ییٚلہِ اسہِ توٚہہِ نِشہٕ یسوعسؔ متعلق رٕژ شیچھ واتنٲوؠ، سۅ ٲس نہٕ صرف لفظو سٟتی، بلؠ کہِ پاک روح اوس طاقتہٕ سان سانہِ دسؠ کٲم کران۔ تمؠ دِیتُ اسہِ پوٚرٕ بھروسہٕ زِ تمؠ ٲسوٕ توٚہؠ ژٲرمٕتؠ۔ أتی ترِ توٚہہِ فِکرِ زِ أسؠ کٔم لوٗکھ چھِ، تکیازِ ییٚلہِ أسؠ توٚہہِ سٟتؠ ٲسؠ، یہِ کینٛژھا اسہِ کوٚر تہِ اوس توٚہہِ فٲیدٕ واتناوُن۔
\v 6 یوٚت تام زن تُہنٛد طٲلق چُھ، توٚہہِ تہِ کٔروٕ زندگی سٲنی پٲٹھؠ بسر کرنؠ شروع یتھٕ پٲٹھؠ یسوع خداوند زندگی بسر کٔر۔ ییٚلہِ توٚہہِ رٕژِ شیچھِ پیٚٹھ ایمان أنوٕ، لوٗکو واتنوو توٚہہِ تکلیف۔ مگر تمہِ پتہٕ تہِ تھٲوٕ توٚہؠ پاک روحن خوش۔
\v 7 تکیازِ مکدُنیہ تہٕ اخیہ صوبن منٛز مسیحؔ ہس پیٚٹھ ایمان تھاون والیو ساروےٕ لوٗکو بوٚز زِ توٚہؠ کٔتہٕ پٲٹھؠ رودِو خوش ییٚلہِ لوٗکو توٚہہِ تکلیف واتنٲو، تِمو تہِ یوٚژھ تُہنٛدِ پٲٹھؠ زندٕ روزُن۔
\v 8 حقیقتن، واریاہو لوٗکو بوٚز خداوند یسوعسؔ متعلق تُہنٛد سُہ پٲغام وُنان۔ پتہٕ کوٚر تِمو تہِ مکدُنیہ تہٕ اخیہ صوبن منٛز روٗزن والیٚن سارنے لوٗکن تمہِ پٲغامُک تبلیغ۔ تمہِ نیٚبر دوٗر دراز جاین پیٚٹھ بسن والیو لوٗکو تہِ بوٚز زِ توٚہہِ کوتاہ ایمان چُھ خدایس پیٚٹھ۔ تمیٛک نتیجہ دراو زِ ووٚنؠ چھنہٕ اسہِ لوٗکن کینٛہہ وننٕچ ضرورت زِ خداین کیاہ چُھ تُہنٛدِ باپتھ کوٚرمُت۔
\v 9 توٚہہِ نِشہٕ دوٗر بسن وٲلؠ تِم لوٗکھ چھِ باقی لوٗکن ونان زِ توٚہؠ کتھٕ پٲٹھؠ چھُو جوشہٕ سان اسہِ خوش آوے کران۔ تِم چھِ باقین لوٗکن یہِ تہِ ونان زِ توٚہہِ کٔروٕ پۅتلیٚن، بُتن تہٕ اپزین خداین ہنٛز عبادت کرنؠ بند تہٕ کٔروٕ زندٕ خدایہِ سٕنٛز عبادت یُس پوٚز خدا چُھ۔
\v 10 تِم چھِ باقی لوٗکن یہِ تہِ ونان زِ توٚہہِ کٔروٕ اپزین خداین ہنٛز عبادت کرنؠ بند یُتھ زن توٚہؠ خدایہِ سنٛدِس گوٚبرؠ سُنٛد آسمان پیٚٹھ زمیٖنس پیٚٹھ واپس یِنُک ہیکیو بے تٲبی سان انتظار کٔرِتھ۔ توٚہہِ چھِ پتاہ، خداین کوٚر یسوع مرنہٕ پتہٕ بییٚہِ زندٕ، تہٕ یسوع چُھ سُہ اکھ یُس اسہِ تمہِ وِزِ بچاوِ ییٚلہِ خدا گناہگار لوٗکن سزا دِیہِ۔
\c 2
\p
\v 1 مسیحسؔ پیٚٹھ ایمان دار سانیو بایو، توٚہہِ چھیو پوٚرٕ پٲٹھؠ زانان زِ یُس وقت اسہِ توٚہہِ سٟتؠ گُزور سُہ اوس بلکل فٲیدٕ منٛد۔
\v 2 یتھٕ پٲٹھؠ توٚہؠ زانان چھیو، پتمہِ لٹہِ واتنوو اسہِ فلپی شہرس منٛز لوٗکو تکلیف بییٚہِ ونِکھ اسہِ بدرد، مگر سٲنؠ خداین دِژ اسہِ تمسنٛز رٕژ شیچھ باونس خٲطرٕ ہمت ہرگاہ مُخٲلفو کٔر اسہِ رُکاونہٕ باپتھ واریاہ کۅشش مگر أسؠ روٗدؠ خدایہِ سنٛز رٕژ شیٚچھ توٚہہِ نِشہٕ واتناوان۔
\v 3 یقیناً، ییٚلہِ أسؠ توٚہہِ خدایہِ سنٛزِ رٕژِ شیچھِ پیٚٹھ ایمان تھاونس پیٚٹھ حوصلہٕ دِتو، اسہِ کٔر نہٕ کانہٛہ غٲر اخلٲقی  یا توٚہہِ  گمراہ کرنچ کوشش۔ اسہِ اوس نہٕ کانٛہہ ذٲتی مقصد۔ اسہِ کٔر نہٕ توٚہہِ دوٚکھٕ دِنچؠ کوٚشش۔
\v 4 دراصل، چھِ أسؠ خدایہِ سٕنٛز رٕژ شیٚچھ باوان ییٚلہِ زن تمؠ اسہِ پٮ۪ٹھ یقین چھُ کوٚرمُت تہٕ أسؠ کرِن پسنٛد زِ أسؠ چھِ سۅ کٲم کرنس لایق۔ ییٚلہِ أسؠ خدایہِ سٕنٛز رٕژ شیٚچھِ باوان چھِ، أسؠ چھِنہٕ لوٗکھ خوش کرنچؠ کۅشش کران۔ تمہِ بدلہٕ چھِ أسؠ خداۓ خوش کرنچؠ کۅشش کران۔ خداۓ چُھ سُہ یُس اسہِ ہمیشہ آزماوان چُھ یمہِ سٟتؠ أسؠ تمؠ سٕنٛز رٕژ شیٚچھ باوان چھِ۔ \f + \fr 2‏:4 \ft طیطسؔ 1:3۔ افسینؔ 6:6\f*
\v 5 حقیقتن، ییٚلہِ أسؠ پتمہِ لٹہِ آیہِ، اسہِ کٔر نہٕ توٚہہِ اپزؠ تعریف کٔرِتھ توٚہؠ خوش کرنچؠ کوٚشش۔ توٚہہِ چھِ پتاہ زِ یہِ چُھ پوٚز۔ اسہِ چھِنہٕ کانٛہہ لالٕچ، اوے چھِنہٕ سۅ کانٛہہ تہِ کتھ وننٕچ ضروٗرت یمہِ سٟتؠ أسؠ پننٕؠ ذٲتی لالچ توٚہہِ نِشہٕ کٔھٹِتھ ہیکو تھٲوِتھ۔ اتھ چُھ خدا گواہ!
\v 6 اسہِ چھِنہٕ یہِ امید زِ لوٗکھ کرن اسہِ، توٚہہِ تہٕ باقین احترام۔
\v 7 اسہِ ٲسؠ ہِیو توٚہہِ پانس تٲبین کٔرِمٕتؠ، ییٚلہِ زن أسؠ مسیحؔ سٕنٛدؠ بااختیار نمایندٕ چھِ۔ تمہِ بدلہٕ کوٚر اسہِ توٚہہِ سٟتؠ سُہ سلوک زن تہِ ٲسؠ أسؠ توٚہہِ سٟتؠ شُرؠ۔ اسہِ کوٚر توٚہہِ سٟتؠ سُہ سلوک یتھٕ پٲٹھؠ زن اکھ موج پننؠن شُریٚن رچھنہٕ وِزِ آرام دِوان چھِ۔
\v 8 ییٚلہِ زن أسؠ تُہنٛدؠ مشتاق چھِ، اسہِ چھِ توٚہہِ نِشہٕ خدایہِ سٕنٛز رٕژ شیٚچھ واتناونس پیٚٹھ خوشی۔ تیٖ ہوٚت نہٕ کینٛہہ، بلؠ کہ أسؠ چھِ پننٕؠ زندگی تہِ توٚہہِ دِنس پیٚٹھ رٲضی تکیازِ توٚہؠ چھیو اسہِ سؠٹھاہ ٹٲٹھؠ سَپدؠ مٕتؠ۔
\v 9 سانیو بایو توٚہہِ چھِ سٲنؠ سخ محنت تہٕ مشقت یاد۔ أسؠ روٗدؠ راتس دوٚہس کٲم کران۔ اسہِ آسہِ نہٕ توٚہہِ منٛز کٲنسہِ أکس تہِ ووٚنمُت زِ اسہِ کر مٲلی مدد۔ أسؠ روٗدؠ تٔمہِ پتہٕ تہِ کٲم کران، تہٕ ونہِ تہِ چھِ خدایہِ سنٛزِ رٕژِ شیٚچھِ ہنٛز پارے توٚہہِ دِوان۔
\v 10 توٚہؠ تہٕ خداۓ چُھ سانہِ وفادٲری، راستبٲزی تہٕ معصومیتکؠ گواہ یمہِ سٟتؠ أسؠ توٚہہِ سارنے خدایس پیٚٹھ ایمان تھاون والین سٟتؠ پیش آیہِ۔
\v 11 توٚہہِ منٛز چُھ پریتھ کانٛہہ اکھ ذٲتی طوٗر زانان: اسہِ کوٚر توٚہہِ سٟتؠ سوۓ سلوک یتھٕ پٲٹھؠ اکھ مۅل پننؠن شُریٚن سٟتؠ کران چُھ۔
\v 12 أسؠ روٗدؠ توٚہہِ تلقین کران، توٚہہِ ہمت بخشان تہٕ ثبوت دِوان زِ توٚہہِ پزِ سۅ زندگی بسر کرنؠ یۅسہٕ خدا لوٗکن بسر کرنؠ یژھان چُھ! تکیازِ خدا چُھ توٚہہِ پننہِ شاندار بادشٲہی منٛز دٲخل سپدنچؠ دعوت دِوان۔
\v 13 أسؠ چھِ بییٚہِ خدایہِ سُنٛد ہمیشہ أمہِ خٲطرٕ شکُر گُزٲری کران: توٚہہِ یُس خدایہِ سُنٛد کلام سانہِ دسؠ بوزوٕ سُہ کوٚروٕ قبول۔ توٚہہِ مونُو نہٕ سُہ صرف اکھ انسٲنی پٲغام۔ توٚہہِ مونُو سُہ خدایہِ سُنٛد پٲغام۔ اصلی دِیُت سُہ پٲغام اسہِ خداین لوٗکن نِشہٕ واتناوٕ خٲطرٕ! أسؠ چھِ بییٚہِ خدایہِ سُنٛد شکُر ادا کران زِ توٚہہِ اوٚنو تمس پیٚٹھ ایمان، خدا چُھ موثر اندازس منٛز تُہنٛزِ زندگی منٛز تمہِ قسمچؠ تبدیلی انان یتھٕ پٲٹھؠ تمؠ سنٛدین لوٗکن پزِ زندٕ روزُن۔
\v 14‏-15 یہودیو کٔرؠ نہٕ یہُودیا ہس منٛز سؠٹھاہ پرانہِ وقتہٕ پیٚٹھٕ صرف نبی قتل بلؠ کہ حال حالےٕ کوٚرکھ بییٚہِ خداوند یسوع تہِ قتل۔ تِمو کٔر اسہِ رسولن سٟتؠ بدسلوکی تہِ۔ یِمو یہوداکیو انکار کرن والیو لوٗکو واتنوو بییٚہِ تِمن مسیحسؔ پیٚٹھ ایمان تھاون والیٚن لوٗکن تہِ تکلیف۔ مسیحسؔ پیٚٹھ ایمان تھاون والیو سانیو بایو، توٚہؠ پٔکِو تِمنےٕ یہُودیا ہس منٛز خدایہِ سنٛزن مجلسن ہنٛدس نقشہِ قدمس پیٚٹھ زِ توٚہہِ چھِ یسوع مسیحسؔ پیٚٹھ پوٚرٕ پٲٹھؠ ایمان تکیازِ توٚہہِ چھیو تِمے تکلیف پننیٚو ملکہٕ کیٚو بایو ہنٛدؠ دسؠ تُلان۔ خدا چُھ پوٚرٕ پٲٹھؠ تِمن مُنکر یہُودینؔ ناراض۔ بییٚہِ چھِ یِم تمام انسانن ہنٛدؠ دشمن!
\v 16 تِم مُنکر یہُود چھِ غٲر یہُودین تام خدایہِ سٕنٛز رٕژ شیٚچھ واتناونس منٛز اسہِ رُکاونٕچ کۅشش کران۔ تکیازِ تِم مُنکر یہُود چھِنہٕ یژھان زِ خدا گژھِ تِمن یہودی لوٗکو نِشہٕ بچاون۔ یِمو مُنکر یہودی چُھ لگاتار گناہ کران زِ تِمو چھِ گناہن ہنٛدؠ سٲری حد پار کٔرمٕتؠ۔ ییٚلہِ تِم غٲفل سپدن، خدایہِ دِیہِ تِمن ٲخرکار وقتس پیٚٹھ سزا۔
\v 17 سانیو ایمان تھاون والیو بایو، دوٗر آس نہٕ سببہٕ کِنؠ اسہِ وُچھوٕ نہٕ توٚہؠ اکہِ لٹہِ تہِ۔ ہرگاہ أسؠ توٚہہِ نِشہٕ سؠٹھاہ دوٗر ٲسؠ ٲسوٕ نہٕ تُہنٛز ماۓ کم کینٛہہ۔ أسؠ ٲسؠ تُہنٛز صوٗرت وُچھنہٕ خٲطرٕ بےقرار۔
\v 18 بےشک، اسہِ یژھاو توٚہہِ نِشہٕ واتُن۔ مےٚ پولُسنؔ کرایہِ دویہِ لٹہِ ینٕچ کۅشش، مگر ییٚلہِ تہِ کۅشش کٔر أسؠ ڈٲلؠ شیطانن۔
\v 19 اسہِ یژھاو توٚہہِ سمکھن تکیازِ اسہِ چھِ تُہنٛدس خدایس پیٚٹھ ایمانُک بھروسہٕ زِ اسہِ سپدِہے توٚہہِ سٟتؠ ملاقات کرنہٕ سٟتؠ خوشی۔ اسہِ چُھ یقین زِ اسہِ کوٚر تہِ حٲصل یہِ خداین سانہِ دسؠ کرُن یوٚژھمُت اوس۔ اسہِ چُھ یتھ پیٚٹھ پوٚرٕ یقین زِ أسؠ سٲری ٲسیٚو یکجاہ ییٚلہِ سون خداوند یسوع دُبارِ ییہِ!
\v 20 تکیازِ تُہنٛدی سٟتؠ چھِ أسؠ خدایہِ سٕنٛدؠ تعریف کرن تہٕ خوشی مناون!
\c 3
\p
\v 1 ٲخر ییٚلہِ اسہِ وؠترِتھ ہیوٚک نہٕ أتی زون اسہِ یی منٲسب زِ سلاسؔ تہٕ بہٕ روزو پتھ کُن ایتھنیس شہرس منٛز کُنی زٔنؠ۔  
\v 2 مگر تمہِ پتہٕ تہِ سوز اسہِ تیمُتھیس توٚہہِ نِشہٕ یُس اسہِ سٟتؠ سٟتؠ مسیحسؔ متعلق رٕژِ شیٚچھِ ہُنٛد تبلیغ کران خدایہِ سٕنٛز خدمت چُھ کران۔   سلاسنؔ تہٕ مےٚ سوز سُہ امہِ سببہٕ یُتھ سُہ توٚہہِ خدایس پیٚٹھ تُہنٛدِ ایمانس بڈراوؠو تہٕ ہمت دِیہِ۔  
\v 3 بییٚہِ سوز اسہِ تِیمُتِھیؔ توٚہہِ نِشہٕ أمہِ خٲطرٕ ییٚلہِ لوٗکھ اسہِ رسولن ستاون،  تمہِ سٟتؠ گوٚژھ نہٕ تُہنٛدس ایمان منٛز خلل سپدن۔   توٚہؠ چھیو پوٚرٕ پٲٹھؠ زانان زِ خدایس چھِ خبر زِ لوٗکھ ستاون اسہِ رسولن۔  
\v 4 ییٚلہِ أسؠ رسول توٚہہِ نِشہٕ واتان ٲسؠ،  حقیقتن روٗدؠ أسؠ توٚہہِ وقتہٕ برونٛٹھۓ خبردار کران زِ خدایس چھِ خبر زِ اسہِ رسولن ستاون لوٗکھ۔  توٚہہِ چھیو پوٚرٕ پٲٹھؠ زانان زِ یہِ چُھ بلکل تیٖ یہِ سپدیوو۔  
\v 5 مےٚ ہیوٚک نہٕ بییٚہِ دُبارٕ برداش کٔرِتھ اوے سوز مےٚ تِیمُتِھیؔ توٚہہِ نِشہٕ یہِ زانہٕ خٲطرٕ زِ توٚہہِ چھا ونہِ خدایس پیٚٹھ ایمان شیطانن ما چھیو توٚہہِ ورگلاون تہٕ سٲنؠ محنت ما گیہِ ضایہِ!
\v 6 تِیمُتِھیؔ ووت حال حالےٕ سلاسؔ پیٚٹھٕ توٚہہِ سٟتؠ ملاقاتہٕ پتہٕ مےٚ نِشہٕ واپس۔  تمؠ ووٚنؠ اسہِ توٚہہِ متعلق خدایس پیٚٹھ تُہنٛدِ ایمانچ تہٕ خدایس سٟتؠ تُہنٛدِ لولچؠ رٕژ شیٚچھ۔  تمؠ ووٚن اسہِ ییٚلہِ توٚہہِ أسؠ یاد پیوان چھیو، تمؠ سٟتؠ چھے توٚہہِ خوشی سپدان، تۅہہِ چھِ سٲنؠ ماۓ تہٕ یتھۓ پٲٹھؠ چھِ اسہِ تہِ تُہنٛز ماۓ!
\v 7 مسیحسؔ پیٚٹھ ایمان تھاون والیو سانیو بایو، تتھ سارسے وقتس دوران ووٚنؠ لوٗکو اسہِ بدرد بییٚہِ ستٲوکھ۔   خداین دِژ اسہِ توٚہہِ متعلق ہمت۔  اسہِ گیہِ حوصلہٕ افزٲیی ییٚلہِ تِیمُتِھینؔ اسہِ ووٚن زِ توٚہہِ چُھ ونہِ تہِ خدایس پیٚٹھ ایمان۔  
\v 8 بےشک، أسؠ گیہِ دُبارٕ زندٕ زِ تُہنٛد ایمان چُھ خداوند یسوعؔ پیٚٹھ دٔرِتھ!
\v 9 بےشک، أسؠ ہیکو نہٕ خدایہِ سُنٛد تیوٚت زیادٕ شکُر ادا کٔرِتھ یوٚت تمؠ تُہنٛدِ خٲطرٕ کوٚر!ییٚلہِ تہِ أسؠ پننِس خدایس دُعا چھِ منٛگان، اسہِ چھِ سؠٹھاہ زیادٕ شادمٲنی سپدان تکیازِ توٚہہِ کوتاہ ایمان چُھ تمس پیٚٹھ!
\v 10 أسؠ چھِ لگاتار تہٕ خصوصن خدایس منت منٛگان زِ توٚہؠ وُچِھو أسؠ روبرو۔  اسہِ چُھ یہِ تہِ شوق زِ أسؠ کرہو تُہندِ ایمانچ کمی پوٚرٕ!
\v 11 ووٚنؠ چھِ أسؠ پننِس بب خدایس تہٕ پننِس خداوند یسوعسؔ دُعا منٛگان زِ تِم ہٲون اسہِ دِیہِ توٚہہِ کُن وَتھ۔  
\v 12 أسؠ چھِ خداوند یسوعسؔ دعا منٛگان زِ سُہ کرِ تُہنٛدس تتھ لولس منٛز ہُریر یُس توٚہؠ پننؠن باین سٟتؠ بٔٲگراوان چھُو۔  أسؠ چھِ بییٚہِ تہِ دُعا منٛگان زِ سُہ بناوِ توٚہہِ سارنےٕ لوٗکن سٟتؠ لول برنس منٛز اعلیٰ۔  توے چھِ اسہِ تُہنٛز ماے!
\v 13 أسؠ چھِ پننِس خداوند یسوعسؔ دعا منٛگان زِ سُہ بڑٲوِن تُہنٛز پانہٕ ونے ماے۔   أسؠ چھِ خداوند یسوعسؔ دعا منٛگان زِ سُہ کرن توٚہہِ سۅ زندگی عطا یوٚسہِ سٲنس ببَ خدایس نِشہٕ پاک چھِ۔   أسؠ چھِ یِم سٲری دعا أمہِ سببہٕ کران یُتھ زن أسؠ تیار ییٚلہِ سون خداوند یسوع دوٚیمہِ لٹہِ پننؠن سارنےٕ لوٗکن ہٮ۪تھ واپس ییہِ۔  خدایہِ یی سپدِن!\f + \fr 3‏:13 \ft کولوسین 1:22،  افسینؔ 5:27\f*
\c 4
\p
\v 1‏-2 مسیحسؔ پیٚٹھ ایمان تھاوُن والیٚو سانیو بایو، یمہِ چِٹھِ ہنٛد خُلاصہٕ چُھ یتھٕ کِنؠ۔ ییٚلہِ زنہٕ أسؠ خداوند یسوع سٕنٛدؠ مبالغؠ چھِ، أسؠ چھِ یتھ کتھِ پیٚٹھ توٚہہِ زوٗر دِوان تہٕ ہمت بخشان زِ تتھ پیٚٹھ کریو عمل یہِ اسہِ توٚہؠ ہیٚچھنٲیو۔ یہِ چُھ تُہنزِ زندگی تہٕ خدا خوش کرنہٕ خٲطرٕ ضروٗری۔ پتہٕ کریو توٚہؠ تمہِ کھوٚتہٕ زیادٕ ترقی، تکیازِ توٚہؠ چھُو زانان زِ اسہِ کیاہ کیاہ حکم چھِ توٚہہِ خداوند یسوع سٕنٛدِ طرفہٕ دِتؠ مٕتؠ۔
\v 3 خدا چُھ یقیناً یژھان زِ توٚہؠ روزیٚو تمہِ اندازٕ زندٕ یمہِ سٟتؠ یہِ باسہِ زِ توٚہؠ چھُو تمؠ سٕنٛدؠ پوٚرٕ پٲٹھؠ تمؠ سٕنٛز خوٲہِش چھِ یہِ زِ توٚہؠ روزیٚو جنسی طور غٲر اخلٲقی کٲمیو نِشہٕ دوٗر۔
\v 4 خدا چُھ یژھن زِ توٚہہِ منٛز کرِ ہر کانٛہہ صرف پننہِ زنانہِ سٟتؠ جنسی رشتہٕ قٲیِم۔ خدا چُھ یژھن زِ توٚہؠ کریو پننؠن زنانن سٟتؠ رُت سلوک بییٚہِ کریو تِمن عزت۔
\v 5 توٚہہِ پزن نہٕ پننہِ زنانہٕ تِمن قومن ہنٛدؠ پٲٹھؠ جنس حوسہٕ خٲطرٕ استعمال کرنہِ یِم نہٕ خدایہِ سنٛزِ وتہِ پیٚٹھ پکن چھِ۔
\v 6 خدا چُھ یژھن زِ کانٛہہ اکھ تہِ کرِ نہٕ خلاف ورزی تہٕ تُلہِ مسیحسؔ پیٚٹھ ایمان تھون وٲلِس پننِس بٲے سنٛزِ زنانہٕ ہُنٛد یتھٕ پٲٹھؠ فٲیدٕ۔ تکیازِ خداوند یسوع ہییٚہِ یِمن سارنےٕ حرام کٲمنؠ ہُنٛد برابر تِتھے پٲٹھؠ بدلہٕ یِتھٕ پٲٹھؠ اسہِ توٚہہِ پتمہِ لٹہِ ووٚن تہٕ پوٚرٕ پٲٹھؠ توٚہؠ خبردار کٔروٕ۔ \f + \fr 4‏:6 \ft مزامیر 94:1\f*
\v 7 خدا چُھنہٕ اسہِ مسیحسؔ پیٚٹھ ایمان تھاون والیٚن پننہِ بادشٲہی منٛز ناپاک کٲمنؠ ہنٛدِ خٲطرٕ بُلاون۔ تمہِ بدلہٕ چُھ خدا یژھن زِ أسؠ کرو تمؠ سنٛدین لوٗکن ہنٛدؠ پٲٹھؠ پننٕؠ زندگی بسر۔
\v 8 أمی سببہٕ کِنؠ چُھس بہٕ توٚہہِ منٛز پرٛتھ کانٛہہ خبردار کرن ییٚلہِ زن خداین اسہِ یمہٕ کتھٕ توٚہہِ بناونُک ووٚنمُت چُھ، ہرگاہ کانٛہہ اکھ سٲنس وونس رد کرِ تیلہِ چھُو توٚہؠ اکھ انسان رد کرن۔ نا توٚہؠ چھُو خدایہِ سنٛدِس ذاتس انکار کرن! توٚہؠ چھُو تمس خدایس انکار کرن یُس ہمیشہ پنُن پاک روح اسہِ سارنےٕ عطا کران چُھ!
\v 9 ووٚنؠ چھِنہٕ پٔزؠ پٲٹھؠ تُہنٛدس سوالس متعلق کٲنسہِ أکس تہِ لیٚکھنٕچ یا یاد پاونٕچ ضروٗرت زِ مسیحسؔ پیٚٹھ ایمان تھاون والیٚن باین کِتھٕ پٲٹھؠ پزِ پانہٕ وٲنؠ محبت تھون۔ تکیازِ توٚہہِ چھُو برونٛٹھۓ ہیٚچھمُت زِ خدا چُھ ہیٚچھناون، "اکھ أکس بریو لول"
\v 10 توٚہؠ چھُو برونٛٹھۓ سٲرسے مکدُنیہس منٛز سارنے مسیحیؔ باین سٟتؠ لول بٲگراوان۔ سانیو مسیحیؔ بایو، تمہِ پتہٕ تہِ چھِ أسؠ یژھان تہٕ توٚہہِ پیٚٹھ تلقین کران زِ توٚہؠ سٲری بریو أمہِ کھۅتہٕ زیادٕ اکھ أکس لول!
\v 11 أسؠ چھِ بییٚہِ توٚہہِ حکم دِوان زِ توٚہؠ کریو امنہٕ سان زندگی بسر کرنُکھ آرِزو۔ تہٕ پننٮ۪ن پننٮ۪ن کامٮ۪ن سٟتؠ روزِو آوٕرؠ۔ پنُن کاروبار کریو یُتھ توٚہؠ تہِ کمٲیو یہِ توٚہہِ زندٕ روزنہٕ خٲطرٕ ضروٗرت چِھ۔ تہِ کریو یمیٛک اسہِ توٚہہِ برونٛٹھۓ حکم دِیتُمُت چُھ۔
\v 12 أسؠ چھِ توٚہہِ یمہٕ کامہِ کرنس پیٚٹھ زوٗر دِوان، یُتھ زن توٚہؠ وُنکینٕچ تُہنٛز شٲیشگی سان زندگی گُزارن چھُو سۅ ہیکہِ بنتھ تِمن ہنٛدِ خٲطرٕ اکھ مثال یِمن نہٕ مسیحسؔ پیٚٹھ ایمان چُھ۔ تہٕ پتہٕ ٲسیٚو نہٕ توٚہؠ پننٕؠ زندگی گزارنہٕ خٲطرٕ کُنہِ چیزکؠ محتاج۔
\v 13 سانیو مسیحیؔ بایو، بییٚہِ چھِ أسؠ یژھان زِ توٚہؠ زانیو تِمن مسیحین کیاہ سپدِ یِم مۅردٕ چھِ۔ تُہنٛد پزِ نہٕ باقی انسانن ہنٛدؠ پٲٹھؠ آسن یِمن نہٕ مسیحسؔ پیٚٹھ ایمان چُھ، تِم چھِ سخ پریشان تکیازِ تِمن چُھنہٕ پوٚرٕ پٲٹھؠ بھروسہٕ زِ لوٗکھ سپدن مرنہٕ پتہٕ بییٚہِ زندٕ۔
\v 14 یقیٖنن، اسہِ رسولن چُھ اطمنان زِ یسوع مود تہٕ سپد بییٚہِ زندٕ۔ توے چُھ اسہِ یقین زِ خدا کرِ تِمن لوٗکن بییٚہِ زندٕ یِم یسوعسؔ سٟتؠ چھِ۔ پتہٕ سوزِ تِمن خدا یسوعسؔ سٟتؠ واپس ییٚلہِ یسوع دنیاہس پیٚٹھ دُبارٕ واپس ییہِ۔
\v 15 حقیقتن، أسؠ رسول چھِ ونہِ کؠن توٚہہِ یسوع سُنٛدکلام بوزناون۔ ییٚلہِ یسوع دُبارٕ واتہِ تمام مسیحیؔ کرن تس استقبال چاہے تِم مودمٕتؠ آسن یا تمہِ ساعتہٕ آسن زندٕ۔
\v 16 خداوند یسوعؔ وسہِ آسمان پیٚٹھٕ بوٚن تہٕ سُہ دیہِ پانے سارنے زندٕ سپدنُک حکم۔ ملٲیکن ہُنٛد سردار دِیہِ کریکھ۔ خدایہِ سنٛدِس بگلس سپدِ دماکہٕ۔ پتہٕ سپدن گوٚڈٕ یمہِ عالمہٕ گٲمتٕؠ سٲری مسیحیؔ زمینہِ منٛز زندٕ۔
\v 17 تمہِ پتہٕ کھالہِ خدا اسہِ سارنےٕ زندٕ مسیحنؔ زمینہِ پیٚٹھ ہیٚور کُن یُتھ زن أسؠ اوبرس منٛز خداوند یسوعسؔ ہیکو ملاقات کٔرِتھ۔ مسیحیؔ دوٚشوے جمٲژ سمکھن پانہٕ وٲنؠ اوبرس پیٚٹھ۔ یتھٕ پٲٹھؠ روزِو أسؠ سٲری خداوند یسوعسؔ سٟتؠ ہمیشہ خٲطرٕ یکجاہ!
\v 18 لہٰذا توٚہہِ پزِ یمہِ کلامہٕ سٟتؠ اکھ أکس حوصلہٕ افزٲئی کرنؠ!
\c 5
\p
\v 1 سانیو مسیحیؔ بایو، ووٚنؠ چُھس بہٕ یژھان زِ بہٕ دِمہو توٚہؠ تتھ وقتس متعلق زان یمہِ ساعتہٕ سون خداوند دنیاہس پیٚٹھ واپس ییہِ، اسہِ چِھنہٕ سٲنس خداوند سنٛزِ وٲپسی ہنٛدس خاص وقتس متعلق لیٚکھنٕچ ضروٗرت۔
\v 2 توٚہؠ چھُو پانے برونٛٹھۓ اصل پٲٹھؠ تتھ وقتس متعلق زانان ییٚلہِ خداوند یسوع واپس ییہِ۔ توٚہؠ چھُو یہِ تہِ زانن زِ سُہ ییہِ بےخبری منٛز، یتھٕ پٲٹھؠ اکھ ژوٗر رٲژ منٛز یوان چُھ۔
\v 3 خداوند یسوع ییہِ تمہِ وِزِ یکدم ییٚلہِ لوٗکھ آسن ونان، "أسؠ چھِ سہی سلامت" پتہٕ أنہِ تِمن خدا اچانک گیرس منٛز تہٕ کریکھ برباد! یہِ آسہِ تِتھے پٲٹھؠ یتھٕ پٲٹھؠ اکھ گۅبہِ کھوٚرِ زنانہِ خلٲسی ہنٛزِ دگہِ نِشہٕ ژٲلِتھ ہیکہِ نہٕ۔ یتھۓ پٲٹھؠ ہیکؠن نہٕ تِم لوٗکھ زانٛہہ ژٲلِتھ ییٚلہِ خدا تِمن برباد کرِ!\f + \fr 5‏:3 \ft متی 24:37 39\f*
\v 4 بہرحال، سانیو مسیحیؔ بایو، توٚہؠ چھُو نہٕ تِمو لوٗکو منٛزٕ یِمن نہٕ مولوم چُھ کیاہ سپدِ، ییٚلہِ لوٗکھ انہِ گٔٹِس منٛز چھِ۔ اوے ییٚلہِ خداوند یسوع دنیاہس پیٚٹھ تِمن لوٗکن سزا دِنہِ واپس ییہِ، سُہ تراوِ نہٕ توٚہہِ حٲرتس منٛز أکس ژوٗرِ سٕنٛدؠ پٲٹھؠ۔
\v 5 ییٚلہِ زن توٚہؠ سٲری خدایہِ سٕنٛدؠ شُرؠ چھُو، توٚہہِ پزِ یسوع سٕنٛدِ دنیاہس پیٚٹھ واپس ینہٕ بٲپتھ تیار روٗزُن، تِمن لوٗکن ہنٛدؠ پٲٹھؠ یِم گاشش منٛز چھِ یا دوٚہس یہِ زانتھ بیدار آسن زِ کیاہ چُھ سپدان۔ أسؠ چھِنہٕ شیطان سٕنٛدؠ شُرؠ یِمن نہٕ رٲژ منٛز یا أنہِ گٔٹِس منٛز روٗزن والیٚن لوٗکن ہنٛدؠ پٲٹھؠ مولوم آسہِ زِ کیاہ سپدِ۔ تِم ہیکن نہٕ ٹھیک پٲٹھؠ اندازٕ کٔرِتھ۔
\v 6 لہٰذا، اسہِ خدایہِ سنٛدین شُریٚن پزِ تمہِ خٲطرٕ تیار روٗزنُ یہِ سپدن ووٚل آسہِ۔ اسہِ پزِ نہٕ باقی انسانن ہنٛدؠ پٲٹھؠ غٲفل سپدن، یِم زنہٕ شونٛگِتھ آسن چھِ۔ اسہِ پزِ ہوشیار روٗزُن زِ یسوع ییہِ دنیاہس پیٚٹھ واپس۔
\v 7 سٲری چھِ زانان زِ ییٚلہِ راتس لوٗکھ شوٚنگان چھِ تِم چھِ بےخبر آسن تہٕ ییٚلہِ لوٗکھ چیٚتھ چھِ آسان تِمن چھِ بےخبر آسن۔ تِم چھِ اکثر رٲژ منٛز چیٚوان یمہِ سٟتؠ تِم مست سپدن چھِ۔
\v 8 پوٚز أسؠ چھِ خداوند یسوع سُنٛد دنیاہس پیٚٹھ واپس یینہٕ خٲطرٕ تیار، أسؠ چھِنہٕ تِمن لوٗکن ہنٛدؠ پٲٹھؠ زندٕ یِم بےخبر چھِ۔ اسہِ پزِ خیال تھوٚن۔ اسہِ پزِ سپہن ہنٛدؠ پٲٹھؠ سامان گنڈ دِتھ روزُن، خدایہِ سُنٛد محبت گژھِ سینس پیٚٹھ سپرِ ہنٛدؠ پٲٹھؠ روزُن۔ شِستٕر ٹوپؠ  دِتھ روزُن۔ \f + \fr 5‏:8 \ft یسعیاہؔ 59:17\f*
\v 9 یودوے أسؠ تمسنٛدؠ لوٗکھ چھِ، خداین چھِنہٕ أسؠ غضبہٕ خٲطرٕ بلکہِ امہِ باپتھ گنزٲرؠ مٕتؠ زِ أسؠ کرو پننِس خداوند یسوع مسیحؔ سٕنٛدِ وسیلہٕ نجات حٲصل۔
\v 10 یسوع دِیت زُو سانہِ بدلہٕ یتھ زن أسؠ چاہے شونٛگِتھ یا بیدار آسو تسؠ سٟتؠ زُوو۔
\v 11 اوے دِیو توٚہؠ أکس بیٚس تسلی تہٕ أکس بیٚیہِ سنٛدِ فٲیدُک بنِو بٲعث ییٚلہِ زن توٚہؠ یہِ چھُو کران۔
\v 12 سانیو مسیحیؔ بایو ٲخرس پیٚٹھ چھِ أسؠ توٚہہِ عرض کران زِ پننؠن روحٲنی پیشواہن کریو قدر یِم توٚہہِ منٛز زُو ژٹان چھِ یتھٕ پٲٹھؠ توٚہؠ خداوند یسوعسؔ قدر کران چھُو۔ توٚہہِ پزِ تِمن قدر کرنؠ تکیازِ تِم چھِ ہمیشہ توٚہہِ خبردار کرن بییٚہِ نصیحت کران۔
\v 13 تکیازِ تِہنٛزِ کامہِ ہنٛدِ سببہٕ کریو تِمن لولہٕ سان عزت پانہٕ وٲنؠ روزِو امنہٕ سان۔
\v 14 سانیو مسیحیؔ بایو، أسؠ چھِ توٚہہِ ہدایت دِوان زِ ہجہِ وتہِ پکن والیٚن کرِو تلقین، کم ہمتن دِیو دِلاسہٕ، کمزورن پیٚٹھ تھٲوو اتھِ تہٕ سارنےٕ سٟتؠ یِیو صبرٕ سان پیش۔
\v 15 ہوش تھٲوو یُتھ نہٕ کانٛہہ بدی بدلہٕ بدی کرِ بلؠ کہ روزِو توٚہؠ پانہٕ وٲنؠ تہٕ سارنےٕ سٟتؠ پریتھ وزِ رُت کرنس پتہٕ۔ \f + \fr 5‏:15 \ft 1پطرس 3:9\f*
\v 16 ہمیشہِ روزِو خوش!
\v 17 لگاتار کرِو دُعا!
\v 18 پرٛتھ حالتس منٛز روزِو خدایہِ سٕنٛز شکُرگُزٲری کران! بےشک، توٚہہِ سارنےٕ مسیحسؔ پیٚٹھ ایمان تھٲون والیٚن چھےٚ یمہٕ سارے کامہِ کرنہِ۔
\v 19 پاک روحس مہَ دِیو ژھتہٕ گژھنہٕ۔
\v 20 نبووَتن مَہ کٔرِو حقارت!
\v 21 سارے کتھٕ آزمٲیو یۅسہٕ رٕژ آسہِ سۅ تھٲوون لونچہِ منٛز۔
\v 22 پرٛتھ بدی ہنٛزِ صوٗرژ نشہٕ ہییٚو لوٚب۔ \f + \fr 5‏:22 \ft فلپین 4:8\f*
\v 23 مخصر، أسؠ چھِ دُعا منٛگان زِ خدا بناوٕ توٚہہِ پننؠن پاک  لوٗکن ہیوؠ۔ خدا چُھ سلامتی بخشان۔ أسؠ چھِ بییٚہِ دُعا منٛگان زِ خدا کرِ تُہنز معصوم آسنس خداوند یسوع مسیحؔ سنٛدِس دُبارٕ دنیاہس پیٚٹھ یِنس تام حفاطت۔
\v 24 توٚہہِ ہمیشہِ ناد دِنہٕ وول خدا چُھ بھروسہٕ مند۔ سُہ کرِ یتھۓ ہیو۔
\v 25 سانیو مسیحیؔ بایو، أسؠ چھِ توٚہہِ عرض کران زِ توٚہؠ روزِو میانہِ، سیلاسؔ تہٕ تِیمُتِھیؔ سٕنٛدِ خٲطرٕ دُعا منٛگان!
\v 26 عبادت خٲطرٕ جمع سپدنہٕ وِزِ کٔرِو مایہِ سان پننؠن باین سلام۔
\v 27 بہٕ چھِسو توٚہہِ خداوند یسوع سُنٛد قسم تھاون زِ یہِ چِٹھؠ گژھِ ینؠ سارنےٕ مسیحیؔ باین برونٛہہ کنہِ پرنہٕ!
\v 28 سٲنس خداوند یسوع مسیحؔ سُنٛد فضل روٗزِن توٚہہِ سارنےٕ ہمیشہِ سٟتؠ!
