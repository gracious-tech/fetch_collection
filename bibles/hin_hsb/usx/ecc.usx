<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ECC" style="id">HINDI STANDARD BIBLE©, Copyright © 2024 by Global Bible Initiative [Export Date: April 10, 2024]</book>
  <para style="h">Ecc</para>
  <para style="mt1">Ecc</para>
  <chapter number="1" style="c" sid="ECC 1" />
  <para style="s1">सब कुछ व्यर्थ है</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 1:1" />यरूशलेम के राजा और दाऊद के पुत्र, उपदेशक के वचन। <verse eid="ECC 1:1" /><verse number="2" style="v" sid="ECC 1:2" />उपदेशक कहता है, “व्यर्थ ही व्यर्थ, व्यर्थ ही व्यर्थ! सब कुछ व्यर्थ है!” <verse eid="ECC 1:2" /><verse number="3" style="v" sid="ECC 1:3" />मनुष्य को अपने सारे परिश्रम से जो वह सूर्य के नीचे करता है, क्या लाभ होता है? <verse eid="ECC 1:3" /><verse number="4" style="v" sid="ECC 1:4" />एक पीढ़ी जाती है, और दूसरी पीढ़ी आती है, परंतु पृथ्वी सर्वदा बनी रहती है। <verse eid="ECC 1:4" /><verse number="5" style="v" sid="ECC 1:5" />सूर्य उदय होता और अस्त होता है, और फिर शीघ्र ही उस स्थान पर जाता है, जहाँ से वह फिर उदय होता है। <verse eid="ECC 1:5" /><verse number="6" style="v" sid="ECC 1:6" />वायु दक्षिण की ओर बहती है, और उत्तर की ओर घूम जाती है; वह घूमती हुई आगे बढ़ती है, और फिर अपने चक्र में लौट आती है। <verse eid="ECC 1:6" /><verse number="7" style="v" sid="ECC 1:7" />सब नदियाँ समुद्र में जा मिलती हैं, फिर भी समुद्र नहीं भरता। जिस स्थान से नदियाँ निकलती हैं, उसी स्थान को वे फिर लौट जाती हैं। <verse eid="ECC 1:7" /><verse number="8" style="v" sid="ECC 1:8" />सब बातें थकानेवाली हैं; मनुष्य इसका वर्णन नहीं कर सकता। न तो आँखें कभी देखने से और न कान कभी सुनने से तृप्‍त होते हैं। <verse eid="ECC 1:8" /><verse number="9" style="v" sid="ECC 1:9" />जो पहले हो चुका है वह फिर होगा, और जो बन चुका है वह फिर बनाया जाएगा; और ऐसा कुछ भी नहीं जो सूर्य के नीचे नया हो। <verse eid="ECC 1:9" /><verse number="10" style="v" sid="ECC 1:10" />क्या कुछ ऐसा है जिसके विषय कोई कह सके, “देखो, यह नया है?” ऐसा तो हमसे पहले प्राचीन युगों में भी था। <verse eid="ECC 1:10" /><verse number="11" style="v" sid="ECC 1:11" />पूर्व-काल के लोगों को कोई स्मरण नहीं रखता; और न ही आनेवाले लोगों को वे स्मरण रखेंगे जो उनके बाद आएँगे।<verse eid="ECC 1:11" /></para>
  <para style="s1">उपदेशक का अनुभव</para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 1:12" />मैं, जो उपदेशक हूँ, यरूशलेम में इस्राएल का राजा था। <verse eid="ECC 1:12" /><verse number="13" style="v" sid="ECC 1:13" />मैंने अपना मन लगाया कि जो कुछ आकाश के नीचे किया जाता है, उसकी खोज और छान-बीन बुद्धि से करूँ। यह दुखदाई कार्य है जिसे परमेश्‍वर ने मनुष्यों के लिए ठहराया है कि वे इसमें लगे रहें। <verse eid="ECC 1:13" /><verse number="14" style="v" sid="ECC 1:14" />मैंने उन सब कार्यों को देखा जो सूर्य के नीचे किए जाते हैं; देखो, वे सब व्यर्थ और वायु को पकड़ने के समान हैं। <verse eid="ECC 1:14" /><verse number="15" style="v" sid="ECC 1:15" />जो टेढ़ा है, वह सीधा नहीं किया जा सकता; और जो है ही नहीं, उसकी गिनती नहीं हो सकती।<verse eid="ECC 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 1:16" />मैंने अपने मन में कहा, “देख, मैंने उन सब से अधिक बुद्धि प्राप्‍त की है जिन्होंने मुझसे पहले यरूशलेम पर शासन किया। मैंने बहुत बुद्धि और ज्ञान का अनुभव किया है।” <verse eid="ECC 1:16" /><verse number="17" style="v" sid="ECC 1:17" />मैंने अपना मन लगाया कि बुद्धि को समझूँ, और पागलपन तथा मूर्खता को भी जान लूँ। मैं समझ गया कि यह भी वायु को पकड़ने के समान है।<verse eid="ECC 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 1:18" />क्योंकि बहुत बुद्धि के साथ</para>
  <para style="q2" vid="ECC 1:18">बहुत कष्‍ट भी आता है,</para>
  <para style="q1" vid="ECC 1:18">और ज्ञान बढ़ने से</para>
  <para style="q2" vid="ECC 1:18">दुःख भी बढ़ता है।<verse eid="ECC 1:18" /></para>
  <chapter eid="ECC 1" />
  <chapter number="2" style="c" sid="ECC 2" />
  <para style="s1">आनंद का खालीपन</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 2:1" />मैंने अपने मन से कहा, “चल, मैं सुख-विलास देकर तुझे जाँचूँगा; इसलिए तू आनंद मना।” परंतु देखो, यह भी व्यर्थ है। <verse eid="ECC 2:1" /><verse number="2" style="v" sid="ECC 2:2" />मैंने हँसी के विषय में कहा, “यह पागलपन है,” और सुख-विलास के विषय में, “इससे क्या प्राप्‍त होता है?” <verse eid="ECC 2:2" /><verse number="3" style="v" sid="ECC 2:3" />मैंने अपने मन में सोचा कि मैं अपनी देह को दाखमधु से कैसे बहलाऊँ और कैसे मेरी बुद्धि बनी रहे; और कैसे मैं मूर्खता को थामे रहूँ, जब तक यह पता न लगा लूँ कि वह अच्छा काम कौन सा है जिसे मनुष्य आकाश के नीचे अपने छोटे से जीवन में कर सकता है।<verse eid="ECC 2:3" /></para>
  <para style="s1">संपत्ति का खालीपन</para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 2:4" />मैंने बड़े-बड़े काम किए; मैंने अपने लिए घर बनवाए और दाख की बारियाँ लगवाईं। <verse eid="ECC 2:4" /><verse number="5" style="v" sid="ECC 2:5" />मैंने अपने लिए बाग और बगीचे लगवाए, और उनमें सब प्रकार के फलदाई वृक्ष लगवाए। <verse eid="ECC 2:5" /><verse number="6" style="v" sid="ECC 2:6" />मैंने अपने लिए तालाब बनवाए कि उनसे उपवन के पौधों की सिंचाई की जाए। <verse eid="ECC 2:6" /><verse number="7" style="v" sid="ECC 2:7" />मैंने दास और दासियाँ मोल लीं, और मेरे घर में दास भी उत्पन्‍न हुए; और मेरे पास इतने गाय-बैलों और भेड़-बकरियों के झुंड थे, जितने मुझसे पहले यरूशलेम में अन्य किसी के पास नहीं थे। <verse eid="ECC 2:7" /><verse number="8" style="v" sid="ECC 2:8" />मैंने अपने लिए सोना-चाँदी तथा राजाओं और प्रांतों की संपत्ति का भी संचय किया। मैंने अपने लिए गायक-गायिकाएँ और बहुत सी रखैलियाँ भी रख लीं जिनसे पुरुष सुख पाते हैं। <verse eid="ECC 2:8" /><verse number="9" style="v" sid="ECC 2:9" />इस प्रकार मैं महान हो गया; और मैं उन सब से अधिक संपन्‍न हो गया जो मुझसे पहले यरूशलेम में हुए थे। मेरी बुद्धि भी मुझमें बनी रही। <verse eid="ECC 2:9" /><verse number="10" style="v" sid="ECC 2:10" />मेरी आँखों ने जो कुछ चाहा उन सब को प्राप्‍त करने से मैं न रुका; मैंने अपने मन को किसी प्रकार के सुख-विलास से वंचित नहीं रखा। मेरा मन मेरे सब परिश्रम के कारण आनंदित हुआ, और यही मेरे सारे परिश्रम का फल था। <verse eid="ECC 2:10" /><verse number="11" style="v" sid="ECC 2:11" />तब मैंने अपने हाथों द्वारा किए सब कार्यों पर विचार किया, और उस परिश्रम पर भी विचार किया जो मैंने उन्हें पूरा करने के लिए किया था; और देखो, वे सब व्यर्थ और वायु को पकड़ने के समान हैं, और संसार में उनसे कोई लाभ नहीं।<verse eid="ECC 2:11" /></para>
  <para style="s1">बुद्धि का महत्व</para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 2:12" />तब मैं मुड़कर बुद्धि, पागलपन और मूर्खता पर विचार करने लगा। वह जो राजा का उत्तराधिकारी होगा, क्या करेगा? केवल वही जो पहले से किया गया है। <verse eid="ECC 2:12" /><verse number="13" style="v" sid="ECC 2:13" />तब मैंने देखा कि जैसे प्रकाश अंधकार से बढ़कर है, वैसे ही बुद्धि मूर्खता से बढ़कर है। <verse eid="ECC 2:13" /><verse number="14" style="v" sid="ECC 2:14" />बुद्धिमान की आँखें उसके सिर में होती हैं, परंतु मूर्ख अंधकार में चलता है; फिर भी मैं जानता हूँ कि दोनों का अंत एक जैसा होता है। <verse eid="ECC 2:14" /><verse number="15" style="v" sid="ECC 2:15" />तब मैंने अपने मन में कहा, “जैसा मूर्ख का अंत होगा, वैसा मेरा भी होगा; फिर मेरे बुद्धिमान होने का क्या लाभ?” अतः मैंने अपने मन में कहा, “यह भी व्यर्थ है।” <verse eid="ECC 2:15" /><verse number="16" style="v" sid="ECC 2:16" />क्योंकि मूर्ख के समान बुद्धिमान का स्मरण भी सर्वदा बना न रहेगा, और आने वाले दिनों में वे सब भुला दिए जाएँगे। देखो, बुद्धिमान भी मूर्ख के समान ही मरता है! <verse eid="ECC 2:16" /><verse number="17" style="v" sid="ECC 2:17" />इसलिए मैंने जीवन से घृणा की, क्योंकि जो कार्य संसार में होता है वह मुझे बुरा लगा; वह सब व्यर्थ और वायु को पकड़ने के समान है।<verse eid="ECC 2:17" /></para>
  <para style="s1">कार्य का खालीपन</para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 2:18" />तब मैंने अपने सारे परिश्रम से जिसे मैंने संसार में किया था घृणा की, क्योंकि मुझे उसका फल उस व्यक्‍ति के लिए छोड़ना पड़ेगा जो मेरे बाद आएगा। <verse eid="ECC 2:18" /><verse number="19" style="v" sid="ECC 2:19" />कौन जानता है कि वह बुद्धिमान होगा या मूर्ख? फिर भी वह मेरे सारे परिश्रम के फल पर अधिकार रखेगा जिसके लिए मैंने संसार में बुद्धिमानी के साथ परिश्रम किया। यह भी व्यर्थ है। <verse eid="ECC 2:19" /><verse number="20" style="v" sid="ECC 2:20" />तब मैं अपने मन में उस सारे परिश्रम के विषय निराश हुआ, जो मैंने संसार में किया था। <verse eid="ECC 2:20" /><verse number="21" style="v" sid="ECC 2:21" />कोई ऐसा भी मनुष्य होता है जो बुद्धिमानी, ज्ञान और निपुणता से परिश्रम करता है, परंतु अपनी सारी संपत्ति ऐसे मनुष्य के लिए छोड़ जाता है जिसने उसके लिए कोई परिश्रम नहीं किया है। यह भी व्यर्थ और बहुत बुरा है। <verse eid="ECC 2:21" /><verse number="22" style="v" sid="ECC 2:22" />मनुष्य को आखिर अपने सारे परिश्रम और प्रयासों से क्या मिलता है जो वह संसार में करता है? <verse eid="ECC 2:22" /><verse number="23" style="v" sid="ECC 2:23" />उसके सब दिन तो दुःखों से भरे रहते हैं, और उसका कार्य कष्‍टदायक होता है; यहाँ तक कि रात को भी उसका मन चैन नहीं पाता। यह भी व्यर्थ है।<verse eid="ECC 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ECC 2:24" />मनुष्य के लिए इससे अच्छा और कुछ नहीं कि वह खाए-पीए और अपने परिश्रम में संतुष्‍टि पाए। मैंने देखा कि यह भी परमेश्‍वर की ओर से मिलता है; <verse eid="ECC 2:24" /><verse number="25" style="v" sid="ECC 2:25" />क्योंकि उसकी सहायता के बिना कौन खा-पी और आनंद मना सकता है? <verse eid="ECC 2:25" /><verse number="26" style="v" sid="ECC 2:26" />जिस मनुष्य से वह प्रसन्‍न होता है, उसे वह बुद्धि, ज्ञान और आनंद प्रदान करता है; परंतु पापी को वह धन का संचय करने और उसका ढेर लगाने का कार्य देता है कि उसे उस मनुष्य को दे जो परमेश्‍वर को प्रसन्‍न करता है। यह भी व्यर्थ और वायु को पकड़ने के समान है।<verse eid="ECC 2:26" /></para>
  <chapter eid="ECC 2" />
  <chapter number="3" style="c" sid="ECC 3" />
  <para style="s1">सब कामों का एक निश्‍चित समय</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 3:1" />प्रत्येक बात का एक नियुक्‍त समय है। आकाश के नीचे प्रत्येक कार्य का एक समय है :<verse eid="ECC 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 3:2" />जन्म का समय, और मृत्यु का भी समय;</para>
  <para style="q2" vid="ECC 3:2">बोने का समय, और बोए हुए को</para>
  <para style="q3" vid="ECC 3:2">उखाड़ने का भी समय;<verse eid="ECC 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 3:3" />घात करने का समय,</para>
  <para style="q2" vid="ECC 3:3">और स्वस्थ करने का भी समय;</para>
  <para style="q1" vid="ECC 3:3">गिराने का समय,</para>
  <para style="q2" vid="ECC 3:3">और बनाने का भी समय;<verse eid="ECC 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 3:4" />रोने का समय,</para>
  <para style="q2" vid="ECC 3:4">और हँसने का भी समय;</para>
  <para style="q1" vid="ECC 3:4">छाती पीटने का समय,</para>
  <para style="q2" vid="ECC 3:4">और नाचने का भी समय;<verse eid="ECC 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 3:5" />पत्थर फेंकने का समय,</para>
  <para style="q2" vid="ECC 3:5">और पत्थर बटोरने का भी समय;</para>
  <para style="q1" vid="ECC 3:5">गले लगाने का समय,</para>
  <para style="q2" vid="ECC 3:5">और गले लगाने से रुकने का भी समय;<verse eid="ECC 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 3:6" />ढूँढ़ने का समय,</para>
  <para style="q2" vid="ECC 3:6">और खो देने का भी समय;</para>
  <para style="q1" vid="ECC 3:6">रख लेने का समय,</para>
  <para style="q2" vid="ECC 3:6">और फेंक देने का भी समय;<verse eid="ECC 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 3:7" />फाड़ने का समय, और सीने का भी समय;</para>
  <para style="q2" vid="ECC 3:7">चुप रहने का समय,</para>
  <para style="q3" vid="ECC 3:7">और बोलने का भी समय;<verse eid="ECC 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 3:8" />प्रेम करने का समय,</para>
  <para style="q2" vid="ECC 3:8">और बैर करने का भी समय;</para>
  <para style="q1" vid="ECC 3:8">युद्ध का समय,</para>
  <para style="q2" vid="ECC 3:8">और शांति का भी समय।<verse eid="ECC 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 3:9" />कार्य करनेवाले को अपने परिश्रम से</para>
  <para style="q2" vid="ECC 3:9">क्या लाभ होता है?<verse eid="ECC 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 3:10" />मैंने कार्य के उस बोझ को देखा जो परमेश्‍वर ने मनुष्य के लिए ठहराया है कि वह उसमें उलझा रहे। <verse eid="ECC 3:10" /><verse number="11" style="v" sid="ECC 3:11" />उसने सब कुछ को ऐसा बनाया है कि वे अपने-अपने समय में सुंदर होते हैं। उसने मनुष्यों के मन में अनंतता का विचार भी रखा है, फिर भी वे उन कार्यों को समझ नहीं सकते जो परमेश्‍वर ने आदि से अंत तक किए हैं। <verse eid="ECC 3:11" /><verse number="12" style="v" sid="ECC 3:12" />मैंने जान लिया है कि मनुष्यों के लिए आनंद करने और जीवन भर भलाई करने से अच्छा कुछ भी नहीं; <verse eid="ECC 3:12" /><verse number="13" style="v" sid="ECC 3:13" />और यह भी परमेश्‍वर का दान है कि मनुष्य खाए-पीए और अपने सब परिश्रम में सुखी रहे। <verse eid="ECC 3:13" /><verse number="14" style="v" sid="ECC 3:14" />मैं जानता हूँ कि परमेश्‍वर जो कुछ करता है वह सदा स्थिर रहता है; उसमें न तो कुछ जोड़ा जा सकता है और न उसमें से कुछ घटाया जा सकता है। परमेश्‍वर ने ऐसा इसलिए किया है कि मनुष्य उसका भय माने। <verse eid="ECC 3:14" /><verse number="15" style="v" sid="ECC 3:15" />जो कुछ है, वह पहले भी हो चुका है; जो होने वाला है, वह भी हो चुका है; और जो हो चुका है, परमेश्‍वर उसे दोहराता है।<verse eid="ECC 3:15" /></para>
  <para style="s1">संसार में अन्याय और मृत्यु</para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 3:16" />यही नहीं, मैंने देखा है कि संसार में न्याय के स्थान में दुष्‍टता होती है, और धार्मिकता के स्थान में भी दुष्‍टता होती है। <verse eid="ECC 3:16" /><verse number="17" style="v" sid="ECC 3:17" />मैंने अपने मन में कहा, “परमेश्‍वर धर्मी और दुष्‍ट दोनों का न्याय करेगा, क्योंकि प्रत्येक बात और प्रत्येक कार्य का एक समय होता है।” <verse eid="ECC 3:17" /><verse number="18" style="v" sid="ECC 3:18" />मनुष्यों के विषय में मैंने अपने मन में सोचा कि परमेश्‍वर उन्हें जाँचता है जिससे वे जान लें कि वे पशु-समान हैं। <verse eid="ECC 3:18" /><verse number="19" style="v" sid="ECC 3:19" />मनुष्यों और पशुओं का अंत तो एक जैसा ही होता है। जैसे एक मरता है वैसे ही दूसरा भी मरता है। उन सब में एक ही श्‍वास है, तथा मनुष्य किसी बात में पशु से बढ़कर नहीं। सब कुछ व्यर्थ है। <verse eid="ECC 3:19" /><verse number="20" style="v" sid="ECC 3:20" />सब एक ही स्थान को जाते हैं। सब मिट्टी से बने हैं, और सब मिट्टी में फिर मिल जाते हैं। <verse eid="ECC 3:20" /><verse number="21" style="v" sid="ECC 3:21" />कौन जानता है कि मनुष्यों का प्राण ऊपर की ओर चढ़ता है, और पशुओं का प्राण नीचे की ओर पृथ्वी में समाता है? <verse eid="ECC 3:21" /><verse number="22" style="v" sid="ECC 3:22" />अतः मैंने देखा कि मनुष्य के लिए इससे अच्छा कुछ भी नहीं कि वह अपने कार्यों में आनंदित रहे, क्योंकि यही उसका भाग है! कौन उसे वापस लाएगा कि वह उन बातों को देख सके जो उसके बाद होंगी?<verse eid="ECC 3:22" /></para>
  <chapter eid="ECC 3" />
  <chapter number="4" style="c" sid="ECC 4" />
  <para style="nb">
    <verse number="1" style="v" sid="ECC 4:1" />तब मैंने संसार में होनेवाले सब अंधेर के कामों को भी देखा, और क्या पाया कि अंधेर सहनेवालों के आँसू बह रहे हैं, और उन्हें सांत्वना देनेवाला कोई नहीं है। अंधेर करनेवालों के हाथ में शक्‍ति है, परंतु अंधेर सहनेवालों को कोई सांत्वना नहीं देता। <verse eid="ECC 4:1" /><verse number="2" style="v" sid="ECC 4:2" />इसलिए मैंने उन मृतकों को जो मर चुके हैं, उन जीवितों से अधिक सराहा जो अब तक जीवित हैं। <verse eid="ECC 4:2" /><verse number="3" style="v" sid="ECC 4:3" />परंतु उन दोनों से अच्छा तो वह है जो अब तक जन्मा ही नहीं, और जिसने वे बुरे काम नहीं देखे जो संसार में होते हैं।<verse eid="ECC 4:3" /></para>
  <para style="s1">धन का अकेलापन</para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 4:4" />फिर मैंने लोगों को अपने पड़ोसी से जलन रखने के कारण सब परिश्रम और सब निपुणता के कार्यों को करते हुए देखा। यह भी व्यर्थ और वायु को पकड़ने के समान है। <verse eid="ECC 4:4" /><verse number="5" style="v" sid="ECC 4:5" />मूर्ख हाथ पर हाथ रखे बैठा रहता है, और अपनी ही देह का नाश करता है। <verse eid="ECC 4:5" /><verse number="6" style="v" sid="ECC 4:6" />शांति के साथ एक मुट्ठी प्राप्‍त करना, परिश्रम के साथ दो मुट्ठी प्राप्‍त करने और वायु को पकड़ने से अच्छा है।<verse eid="ECC 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 4:7" />तब मैंने संसार में फिर से एक व्यर्थ बात देखी : <verse eid="ECC 4:7" /><verse number="8" style="v" sid="ECC 4:8" />एक व्यक्‍ति है जिसका कोई नहीं है; उसका न तो कोई पुत्र है और न भाई, फिर भी उसके परिश्रम का अंत नहीं होता; और उसकी आँखें धन से संतुष्‍ट नहीं होतीं; और न वह यह सोचता है कि मैं किसके लिए परिश्रम करता हूँ और क्यों अपने को सुख से वंचित रखता हूँ? यह भी व्यर्थ और दुःखद कार्य है।<verse eid="ECC 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 4:9" />एक से दो अच्छे हैं, क्योंकि उन्हें अपने परिश्रम का अच्छा प्रतिफल मिलता है। <verse eid="ECC 4:9" /><verse number="10" style="v" sid="ECC 4:10" />क्योंकि यदि उनमें से एक गिरे, तो दूसरा उसे उठाएगा; परंतु हाय उस पर जो अकेला होने पर गिरे और उसे उठानेवाला कोई न हो। <verse eid="ECC 4:10" /><verse number="11" style="v" sid="ECC 4:11" />फिर यदि दो व्यक्‍ति साथ सोएँ तो वे गरम रहते हैं, परंतु एक अकेला कैसे गरम रह सकता है? <verse eid="ECC 4:11" /><verse number="12" style="v" sid="ECC 4:12" />अकेले व्यक्‍ति पर तो कोई प्रबल हो सकता है, परंतु दो लोग उसका सामना कर सकते हैं। तीन लड़ियों से बटी रस्सी जल्दी नहीं टूटती।<verse eid="ECC 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 4:13" />बुद्धिमान लड़का दरिद्र होने पर भी उस बूढ़े और मूर्ख राजा से अच्छा है जो अब सम्मति पर ध्यान नहीं देता। <verse eid="ECC 4:13" /><verse number="14" style="v" sid="ECC 4:14" />क्योंकि चाहे वह अपने राज्य में दरिद्र ही उत्पन्‍न हुआ हो, फिर भी वह राजा होने के लिए बंधनों से निकल आया है। <verse eid="ECC 4:14" /><verse number="15" style="v" sid="ECC 4:15" />मैंने देखा कि संसार में चलने-फिरनेवाले सब जीवित लोग उस लड़के के साथ हो लिए थे, जो शासन करने के लिए खड़ा हुआ था। <verse eid="ECC 4:15" /><verse number="16" style="v" sid="ECC 4:16" />वे सब लोग अनगिनित थे जिन पर वह प्रधान हुआ था। परंतु जो बाद में आए वे उससे आनंदित नहीं हुए। यह भी व्यर्थ और वायु को पकड़ने के समान है।<verse eid="ECC 4:16" /></para>
  <chapter eid="ECC 4" />
  <chapter number="5" style="c" sid="ECC 5" />
  <para style="s1">उतावली में मन्‍न‍त न मानना</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 5:1" />जब तू परमेश्‍वर के भवन में जाए तो अपने कदमों की चौकसी करना; मूर्खों जैसा बलिदान चढ़ाने की अपेक्षा आज्ञा मानने के लिए परमेश्‍वर के निकट जाना उत्तम है, क्योंकि मूर्ख नहीं जानते कि वे बुरा करते हैं। <verse eid="ECC 5:1" /><verse number="2" style="v" sid="ECC 5:2" />बोलने में जल्दबाज़ी न करना, और न परमेश्‍वर के सामने अपने मन से कोई बात उतावली में निकालना, क्योंकि परमेश्‍वर स्वर्ग में है और तू पृथ्वी पर है। अतः तेरे शब्द थोड़े ही हों।<verse eid="ECC 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 5:3" />क्योंकि कार्य की अधिकता के कारण स्वप्‍न दिखाई देता है और बहुत सी बातें करनेवाला मूर्ख ठहरता है।<verse eid="ECC 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 5:4" />जब तू परमेश्‍वर के लिए मन्‍न‍त माने तो उसे पूरी करने में विलंब न करना, क्योंकि वह मूर्खों से प्रसन्‍न‍ नहीं होता। जो मन्‍न‍त तूने मानी हो उसे अवश्य पूरी करना। <verse eid="ECC 5:4" /><verse number="5" style="v" sid="ECC 5:5" />मन्‍न‍त मानकर पूरी न करने से तो मन्‍न‍त न मानना ही अच्छा है। <verse eid="ECC 5:5" /><verse number="6" style="v" sid="ECC 5:6" />तू अपनी बातों के कारण पाप में न फँसना, और न परमेश्‍वर के दूत के सामने कहना कि यह भूल से हुआ; परमेश्‍वर तेरी बातों से क्यों अप्रसन्‍न हो, और तेरे हाथ के कार्यों को नष्‍ट करे?<verse eid="ECC 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 5:7" />क्योंकि बहुत स्वप्‍नों और बहुत शब्दों का होना भी व्यर्थ है। परंतु तू परमेश्‍वर का भय मान।<verse eid="ECC 5:7" /></para>
  <para style="s1">जीवन निस्सार है</para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 5:8" />यदि तू किसी प्रांत में निर्धनों पर अत्याचार होते और न्याय तथा धर्म को बिगड़ता देखे, तो इससे चकित न होना; क्योंकि एक अधिकारी पर उससे बड़ा अधिकारी निगरानी रखता है, और उनके ऊपर भी अधिकारी होते हैं। <verse eid="ECC 5:8" /><verse number="9" style="v" sid="ECC 5:9" />भूमि सब के लिए लाभदायक होती है, यहाँ तक कि खेती से राजा का भी लाभ होता है।<verse eid="ECC 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 5:10" />जो धन से प्रेम रखता है वह धन से संतुष्‍ट नहीं होगा, और धन-संपत्ति से प्रेम रखनेवाला भी उसके लाभ से संतुष्‍ट नहीं होगा। यह भी व्यर्थ है। <verse eid="ECC 5:10" /><verse number="11" style="v" sid="ECC 5:11" />जब संपत्ति बढ़ती है तो उसके खानेवाले भी बढ़ते हैं। अतः उसके स्वामी को इसके अतिरिक्‍त क्या लाभ होगा कि वह संपत्ति को अपनी आँखों से देखकर तृप्‍त हो? <verse eid="ECC 5:11" /><verse number="12" style="v" sid="ECC 5:12" />श्रमिक चाहे थोड़ा खाए या बहुत, उसे मीठी नींद आती है; परंतु धनी को उसके धन की बहुतायत सोने नहीं देती।<verse eid="ECC 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 5:13" />मैंने संसार में एक दुखदायक बुराई देखी है : धन का स्वामी उसका संचय अपनी ही हानि के लिए करता है। <verse eid="ECC 5:13" /><verse number="14" style="v" sid="ECC 5:14" />वह धन किसी विपत्ति में नष्‍ट हो जाता है, और उसके घर पुत्र उत्पन्‍न होता है परंतु उसके हाथ में कुछ नहीं होता। <verse eid="ECC 5:14" /><verse number="15" style="v" sid="ECC 5:15" />जैसे वह अपनी माँ के गर्भ से नंगा आया था, वैसे ही नंगा लौट जाएगा। वह अपने परिश्रम के फल में से कुछ भी अपने साथ नहीं ले जा सकेगा। <verse eid="ECC 5:15" /><verse number="16" style="v" sid="ECC 5:16" />यह भी एक दुखदायक बुराई है : जैसा वह आया था, ठीक वैसा ही जाएगा, तो उसके इस व्यर्थ परिश्रम से उसे क्या लाभ? <verse eid="ECC 5:16" /><verse number="17" style="v" sid="ECC 5:17" />वह तो दुःख, बीमारी और क्रोध से घिरा रहकर अंधकार में अपना जीवन बिताता है।<verse eid="ECC 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 5:18" />सुन, मैंने एक बात देखी है जो भली और उचित है कि मनुष्य परमेश्‍वर द्वारा दिए गए अपने छोटे से जीवन में खाए, पीए और अपने उस परिश्रम में सुखी रहे, जो वह संसार में करता है; क्योंकि यही उसका प्रतिफल है। <verse eid="ECC 5:18" /><verse number="19" style="v" sid="ECC 5:19" />यही नहीं, परमेश्‍वर जिसे धन-संपत्ति देता है उसे उसका उपभोग करने के योग्य बनाता है; और वह उसे उसमें से अपना प्रतिफल प्राप्‍त करने और अपने परिश्रम में आनंदित रहने की शक्‍ति भी देता है। यह परमेश्‍वर का वरदान है। <verse eid="ECC 5:19" /><verse number="20" style="v" sid="ECC 5:20" />वह अपने जीवन के दिनों के बारे में बहुत सोच-विचार नहीं करता, क्योंकि परमेश्‍वर उसके हृदय को आनंद से भरे रखता है।<verse eid="ECC 5:20" /></para>
  <chapter eid="ECC 5" />
  <chapter number="6" style="c" sid="ECC 6" />
  <para style="nb">
    <verse number="1" style="v" sid="ECC 6:1" />एक बुराई मैंने संसार में देखी है और वह मनुष्यों में व्याप्‍त है : <verse eid="ECC 6:1" /><verse number="2" style="v" sid="ECC 6:2" />परमेश्‍वर किसी मनुष्य को इतनी धन संपत्ति और प्रतिष्‍ठा देता है कि उसे किसी भी मनचाही वस्तु का अभाव नहीं रहता, परंतु परमेश्‍वर उसे उसका उपभोग करने नहीं देता; कोई दूसरा ही उसका उपभोग करता है। यह भी व्यर्थ और भयानक बुराई है। <verse eid="ECC 6:2" /><verse number="3" style="v" sid="ECC 6:3" />यदि किसी पुरुष के सौ बच्‍चे हों और वह बहुत वर्ष जीवित रहे और वह दीर्घायु हो, पर उसका प्राण अच्छी वस्तुओं से संतुष्‍ट न रहे और न उसे उचित रीति से दफ़नाया जाए, तो मैं कहता हूँ कि ऐसे मनुष्य से अच्छा तो मृत जन्मा हुआ बच्‍चा है। <verse eid="ECC 6:3" /><verse number="4" style="v" sid="ECC 6:4" />ऐसा बच्‍चा व्यर्थ ही आता है और अंधकार में चला जाता है, और उसका नाम अंधकार में खो जाता है। <verse eid="ECC 6:4" /><verse number="5" style="v" sid="ECC 6:5" />वह न तो सूर्य को देख पाता है और न ही कुछ जान पाता है, फिर भी उसे उस मनुष्य से अधिक विश्राम मिलता है। <verse eid="ECC 6:5" /><verse number="6" style="v" sid="ECC 6:6" />यदि वह मनुष्य दो हज़ार वर्ष भी जीवित रहता, तो भी उत्तम वस्तुओं का उपभोग नहीं कर पाता। क्या सब के सब एक ही स्थान में नहीं जाते?<verse eid="ECC 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 6:7" />मनुष्य का सारा परिश्रम उसके पेट के लिए होता है, फिर भी उसका जी नहीं भरता। <verse eid="ECC 6:7" /><verse number="8" style="v" sid="ECC 6:8" />बुद्धिमान व्यक्‍ति किस बात में मूर्ख से बढ़कर है? और उस दरिद्र को क्या लाभ जो यह जानता है कि लोगों के सामने कैसा व्यवहार करना चाहिए? <verse eid="ECC 6:8" /><verse number="9" style="v" sid="ECC 6:9" />मन के भटकने से अच्छा आँखों से देख लेना है; यह भी व्यर्थ और वायु को पकड़ने के समान है।<verse eid="ECC 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 6:10" />जो अस्तित्व में है उसे पहले ही एक नाम दिया जा चुका है, और यह भी ज्ञात है कि मनुष्य क्या है; परंतु वह उससे नहीं लड़ सकता जो उससे अधिक बलवान है। <verse eid="ECC 6:10" /><verse number="11" style="v" sid="ECC 6:11" />जितनी अधिक बातें उतना अधिक व्यर्थ जीवन! फिर मनुष्य को इससे क्या लाभ? <verse eid="ECC 6:11" /><verse number="12" style="v" sid="ECC 6:12" />कौन जानता है कि मनुष्य के व्यर्थ जीवन के थोड़े से दिनों में क्या अच्छा है? वह उसे छाया के समान बिता देगा। मनुष्य को कौन बता सकता है कि उसके बाद इस संसार में क्या होगा?<verse eid="ECC 6:12" /></para>
  <chapter eid="ECC 6" />
  <chapter number="7" style="c" sid="ECC 7" />
  <para style="s1">जीवन से संबंधित बुद्धि के कथन</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 7:1" />बहुमूल्य इत्र की अपेक्षा अच्छा नाम, और जन्म के दिन की अपेक्षा मृत्यु का दिन उत्तम है।<verse eid="ECC 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 7:2" />उत्सव मनानेवाले के घर जाने की अपेक्षा शोक मनानेवाले के घर जाना उत्तम है; क्योंकि सब मनुष्यों का अंत यही है, और जो जीवित है वह मन लगाकर इस पर विचार करेगा।<verse eid="ECC 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 7:3" />हँसी की अपेक्षा दुःख उत्तम है, क्योंकि चेहरा उदास होने पर भी मन आनंदित हो सकता है।<verse eid="ECC 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 7:4" />बुद्धिमानों का मन शोक करनेवालों के घर की ओर लगा रहता है, परंतु मूर्खों का मन सुख-विलास करनेवालों के घर की ओर लगा रहता है।<verse eid="ECC 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ECC 7:5" />मूर्खों के गीत सुनने की अपेक्षा बुद्धिमान की घुड़की सुनना उत्तम है।<verse eid="ECC 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ECC 7:6" />मूर्ख की हँसी हाँड़ी के नीचे जलते हुए काँटों की चरचराहट के समान होती है; यह भी व्यर्थ है।<verse eid="ECC 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 7:7" />निश्‍चय ही अत्याचार बुद्धिमान को बुद्धिहीन कर देता है, और घूस मन को भ्रष्‍ट कर देती है।<verse eid="ECC 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 7:8" />किसी कार्य के आरंभ से उसका अंत उत्तम है; और मनुष्य का धैर्य उसके अहंकार से उत्तम है।<verse eid="ECC 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 7:9" />अपने मन में शीघ्रता से क्रोधित न हो, क्योंकि क्रोध मूर्खों के ही हृदय में रहता है।<verse eid="ECC 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 7:10" />यह न कहना, “बीते हुए दिन इन दिनों से अच्छे क्यों थे?” क्योंकि यह पूछना बुद्धिमानी की बात नहीं।<verse eid="ECC 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 7:11" />उत्तराधिकार के साथ बुद्धि का होना भी अच्छा है, और जीवित रहनेवालों के लिए यह लाभदायक है।<verse eid="ECC 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 7:12" />क्योंकि धन के समान बुद्धि भी सुरक्षा प्रदान करती है; परंतु यह जानना लाभदायक है कि जिनके पास बुद्धि है वह उनके जीवन की रक्षा करती है।<verse eid="ECC 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 7:13" />परमेश्‍वर के कार्य पर विचार कर : जिस वस्तु को उसने टेढ़ा किया हो उसे कौन सीधा कर सकता है?<verse eid="ECC 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ECC 7:14" />सुख के दिन आनंदित रह, और दुःख के दिन सोच; परमेश्‍वर ने ही इन दोनों को बनाया है जिससे मनुष्य यह नहीं समझ सकता कि उसके बाद क्या होने वाला है।<verse eid="ECC 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 7:15" />मैंने अपने व्यर्थ जीवनकाल में यह सब देखा है : कोई धर्मी जन धार्मिकता के मार्ग पर चलते हुए शीघ्र मर जाता है जबकि दुष्‍ट जन बुराई के मार्ग पर चलते हुए लंबी आयु पाता है। <verse eid="ECC 7:15" /><verse number="16" style="v" sid="ECC 7:16" />तू न तो अधिक धर्मी बन, और न अधिक बुद्धिमान। तू क्यों अपने ही नाश का कारण बने? <verse eid="ECC 7:16" /><verse number="17" style="v" sid="ECC 7:17" />तू अधिक दुष्‍ट भी मत बन, और न ही मूर्ख। तू क्यों अपने समय से पहले मरे? <verse eid="ECC 7:17" /><verse number="18" style="v" sid="ECC 7:18" />यह अच्छा है कि तू एक बात को तो पकड़े रहे, और दूसरी बात को भी अपने हाथ से जाने न दे, क्योंकि जो परमेश्‍वर का भय मानता है वह सब कठिनाइयों से पार हो जाता है।<verse eid="ECC 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ECC 7:19" />बुद्धि एक बुद्धिमान मनुष्य को नगर के दस शासकों से अधिक शक्‍तिशाली बनाती है। <verse eid="ECC 7:19" /><verse number="20" style="v" sid="ECC 7:20" />निस्संदेह पृथ्वी पर कोई ऐसा धर्मी मनुष्य नहीं है जो निरंतर भलाई ही करता है और कभी पाप नहीं करता।<verse eid="ECC 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ECC 7:21" />कही हुई सब बातों पर गंभीरता से ध्यान मत देना, कहीं ऐसा न हो कि तू सुने कि तेरा दास तुझे ही शाप दे रहा है। <verse eid="ECC 7:21" /><verse number="22" style="v" sid="ECC 7:22" />क्योंकि तू तो स्वयं जानता है कि तूने भी बहुत बार दूसरों को शाप दिया है।<verse eid="ECC 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ECC 7:23" />मैंने बुद्धि के द्वारा इन सब बातों को जाँचा; मैंने कहा, “मैं बुद्धिमान बनूँगा,” परंतु यह मुझसे दूर रहा। <verse eid="ECC 7:23" /><verse number="24" style="v" sid="ECC 7:24" />जो बहुत दूर और अत्यंत गहरा है, उसका भेद कौन पा सकता है? <verse eid="ECC 7:24" /><verse number="25" style="v" sid="ECC 7:25" />मैंने अपना मन लगाया कि बुद्धि और समझ को जानूँ, उनकी छान-बीन करूँ और उन्हें खोजूँ; और यह भी जानूँ कि मूर्खता की बुराई और पागलपन की मूर्खता क्या है। <verse eid="ECC 7:25" /><verse number="26" style="v" sid="ECC 7:26" />तब मैंने पाया कि मृत्यु से भी कड़वी वह स्‍त्री है जिसका हृदय फंदे और जाल के समान तथा जिसके हाथ बेड़ियों के समान हैं। जिससे परमेश्‍वर प्रसन्‍न है, वह उस स्‍त्री से बच जाएगा; परंतु पापी उसका शिकार हो जाएगा। <verse eid="ECC 7:26" /><verse number="27" style="v" sid="ECC 7:27" />उपदेशक कहता है, “देख, मैंने सच्‍चाई को जानने के लिए एक-एक करके बातों को जोड़ने का प्रयास किया। <verse eid="ECC 7:27" /><verse number="28" style="v" sid="ECC 7:28" />परंतु जिसे मेरा मन अब तक ढूँढ़ता आया है, उसे नहीं पाया। हज़ार में से मुझे एक सच्‍चा पुरुष मिला, परंतु उनमें एक भी ऐसी स्‍त्री नहीं मिली। <verse eid="ECC 7:28" /><verse number="29" style="v" sid="ECC 7:29" />देखो, मैंने केवल यह बात पाई है कि जब परमेश्‍वर ने मनुष्य को बनाया तो वह धर्मी था, परंतु उसने बहुत सी बुरी युक्‍तियाँ निकाल ली हैं।”<verse eid="ECC 7:29" /></para>
  <chapter eid="ECC 7" />
  <chapter number="8" style="c" sid="ECC 8" />
  <para style="s1">बुद्धि, अधिकारी, और पक्षपात</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 8:1" />बुद्धिमान के तुल्य कौन है? किसी बात का अर्थ कौन बता सकता है? मनुष्य की बुद्धि उसके मुख को चमका देती है, और उसके मुख की कठोरता जाती रहती है। <verse eid="ECC 8:1" /><verse number="2" style="v" sid="ECC 8:2" />मैं कहता हूँ कि परमेश्‍वर के सम्मुख खाई शपथ के कारण तू राजा की आज्ञा मान। <verse eid="ECC 8:2" /><verse number="3" style="v" sid="ECC 8:3" />राजा के सामने से लौटने में उतावली मत कर। किसी बुरी बात का साथ न दे; क्योंकि वह जो चाहता है, वही करता है। <verse eid="ECC 8:3" /><verse number="4" style="v" sid="ECC 8:4" />राजा का वचन अधिकारपूर्ण होता है, इसलिए कौन उससे कह सकता है कि तू क्या करता है? <verse eid="ECC 8:4" /><verse number="5" style="v" sid="ECC 8:5" />जो उसकी आज्ञा का पालन करता है वह विपत्ति में नहीं पड़ता, क्योंकि बुद्धिमान मनुष्य उचित समय और नियम को जानता है। <verse eid="ECC 8:5" /><verse number="6" style="v" sid="ECC 8:6" />प्रत्येक कार्य का उपयुक्‍त समय और नियम होता है, यद्यपि मनुष्य का दुःख उसके लिए बहुत भारी होता है। <verse eid="ECC 8:6" /><verse number="7" style="v" sid="ECC 8:7" />जब कोई जानता ही नहीं कि क्या होने वाला है, तो कौन बता सकता है कि वह कब होगा? <verse eid="ECC 8:7" /><verse number="8" style="v" sid="ECC 8:8" />किसी व्यक्‍ति का अपने प्राण पर अधिकार नहीं होता कि उसे रोके रहे, और न ही किसी के पास मृत्यु के दिन पर अधिकार होता है; युद्ध के समय किसी को अवकाश नहीं मिल सकता, और न ही बुराई करनेवालों को उनकी बुराई बचा सकती है। <verse eid="ECC 8:8" /><verse number="9" style="v" sid="ECC 8:9" />मैंने इन सब बातों को देखा है, और संसार में किए जानेवाले हर कार्य पर अपना मन लगाया है; जब-जब मनुष्य ने दूसरे पर अधिकार जमाया है तो उसने अपनी ही हानि की है।<verse eid="ECC 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 8:10" />फिर मैंने उन दुष्‍टों को गाड़े जाते देखा है, जो पवित्रस्थान में आते-जाते थे; वे अपने ही नगर में भुला दिए गए जहाँ वे दुष्‍टता के कार्य किया करते थे। यह भी व्यर्थ है। <verse eid="ECC 8:10" /><verse number="11" style="v" sid="ECC 8:11" />बुरे काम के दंड की आज्ञा तुरंत नहीं दी जाती, इस कारण मनुष्यों का मन बुरा काम करने की इच्छा से भरा रहता है। <verse eid="ECC 8:11" /><verse number="12" style="v" sid="ECC 8:12" />पापी चाहे सौ बार पाप करे और बहुत समय तक जीवित रहे, फिर भी मैं जानता हूँ कि जो परमेश्‍वर का भय मानते हैं और उसकी उपस्थिति में भय से चलते हैं, उनका भला ही होगा। <verse eid="ECC 8:12" /><verse number="13" style="v" sid="ECC 8:13" />परंतु दुष्‍ट का भला नहीं होगा और न उसके दिन छाया के समान बढ़ सकेंगे, क्योंकि वह परमेश्‍वर का भय नहीं मानता।<verse eid="ECC 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ECC 8:14" />एक और व्यर्थ बात है जो पृथ्वी पर घटती है : ऐसे धर्मी जन हैं जिन्हें दुष्‍टों की करनी का फल भोगना पड़ता है, और ऐसे दुष्‍ट भी हैं जिन्हें धर्मियों के भले कार्यों का फल मिलता है। मैं कहता हूँ कि यह भी व्यर्थ है। <verse eid="ECC 8:14" /><verse number="15" style="v" sid="ECC 8:15" />तब मैंने सुख-विलास को सराहा, क्योंकि संसार में मनुष्य के लिए खाने-पीने और आनंद मनाने को छोड़ और कुछ भी अच्छा नहीं, क्योंकि परमेश्‍वर ने उसे इस संसार में जितने दिन दिए हैं, उतने दिन उसके परिश्रम में यह आनंद उसके साथ रहेगा।<verse eid="ECC 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 8:16" />जब मैंने बुद्धि को जानने और पृथ्वी पर किए जानेवाले कार्यों को देखने के लिए अपना मन लगाया कि कैसे मनुष्य दिन-रात जागता रहता है, <verse eid="ECC 8:16" /><verse number="17" style="v" sid="ECC 8:17" />तब मैंने परमेश्‍वर के प्रत्येक कार्य को देखा और पाया कि मनुष्य उसे नहीं समझ सकता जो सूर्य के नीचे किया जाता है। चाहे मनुष्य उसे खोजने में कितना भी परिश्रम करे, फिर भी उसे न जान पाएगा; और बुद्धिमान चाहे कितना भी कहे कि मैं समझता हूँ, फिर भी उसे न समझ सकेगा।<verse eid="ECC 8:17" /></para>
  <chapter eid="ECC 8" />
  <chapter number="9" style="c" sid="ECC 9" />
  <para style="s1">मृत्यु के बावजूद जीवन का आनंद ले</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 9:1" />मैंने इन सब बातों पर मन लगाया और इस निष्कर्ष पर पहुँचा कि धर्मी और बुद्धिमान और उनके कार्य परमेश्‍वर के हाथ में हैं; मनुष्य के सामने सब प्रकार की बातें हैं पर वह नहीं जानता कि वे प्रेम की हैं या बैर की। <verse eid="ECC 9:1" /><verse number="2" style="v" sid="ECC 9:2" />सब बातें सब के लिए समान होती हैं : धर्मी हो या दुष्‍ट, भला हो या बुरा, शुद्ध हो या अशुद्ध, बलिदान चढ़ानेवाला हो या बलिदान न चढ़ानेवाला सब का एक ही परिणाम होता है। जैसी दशा भले मनुष्य की होती है, वैसी ही पापी मनुष्य की; जैसी दशा शपथ खानेवाले की वैसी ही शपथ से डरनेवाले की। <verse eid="ECC 9:2" /><verse number="3" style="v" sid="ECC 9:3" />संसार में जो कुछ होता है उसमें यह बुराई है कि सब मनुष्यों के अंत की दशा एक जैसी होती है; और साथ ही लोगों के मन बुराई से भरे रहते हैं और जब तक वे जीवित हैं, उनके हृदय में पागलपन समाया रहता है। उसके बाद वे मृतकों में जा मिलते हैं। <verse eid="ECC 9:3" /><verse number="4" style="v" sid="ECC 9:4" />जो जीवितों के बीच पाया जाता है उसके लिए आशा है; निश्‍चय ही जीवित कुत्ता मृत सिंह से अच्छा है। <verse eid="ECC 9:4" /><verse number="5" style="v" sid="ECC 9:5" />जीवित तो जानते हैं कि वे मरेंगे; परंतु मृतक कुछ भी नहीं जानते और न उन्हें अब कोई प्रतिफल मिलेगा, क्योंकि उनका नाम तक भुला दिया गया है। <verse eid="ECC 9:5" /><verse number="6" style="v" sid="ECC 9:6" />सचमुच उनका प्रेम, उनका बैर और उनका उत्साह सब नष्‍ट हो चुका है, और संसार के सारे क्रियाकलाप में अब उनका कोई भाग नहीं रहा।<verse eid="ECC 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 9:7" />जा, आनंद के साथ अपनी रोटी खा, और प्रसन्‍नचित्त होकर अपना दाखमधु पी, क्योंकि परमेश्‍वर ने तेरे कार्यों को स्वीकार कर लिया है।<verse eid="ECC 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 9:8" />तेरे वस्‍त्र सदा उजले रहें, और तेरे सिर पर तेल का अभाव न हो।<verse eid="ECC 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 9:9" />अपनी प्रिय पत्‍नी के साथ अपने जीवन का आनंद ले, अर्थात् उस व्यर्थ जीवन के दिनों का जो परमेश्‍वर ने संसार में तेरे लिए ठहराए हैं; क्योंकि तेरे जीवन में और तेरे उस परिश्रम में जो तू संसार में करता है, तेरा यही भाग है। <verse eid="ECC 9:9" /><verse number="10" style="v" sid="ECC 9:10" />तू अपने हाथों से जो कुछ भी करे, उसे पूरी लगन से करना; क्योंकि अधोलोक में जहाँ तू जा रहा है वहाँ कोई कार्य, या युक्‍ति, या बुद्धिमानी नहीं होगी।<verse eid="ECC 9:10" /></para>
  <para style="s1">बुद्धि की सीमितता</para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 9:11" />मैंने संसार में यह भी देखा है कि न दौड़ में तेज़ दौड़नेवाले, और न युद्ध में शूरवीर जीतते हैं; न रोटी बुद्धिमानों को, न धन-संपत्ति समझदारों को, और न ही कृपा योग्य लोगों को प्राप्‍त होती है। सब कुछ समय और संयोग पर निर्भर करता है। <verse eid="ECC 9:11" /><verse number="12" style="v" sid="ECC 9:12" />इसके अतिरिक्‍त, मनुष्य नहीं जानता कि उसका समय कब आएगा। जैसे मछलियाँ जाल में, और पक्षी फंदे में फँस जाते हैं, वैसे ही मनुष्य ऐसे बुरे समय में फँस जाते हैं जो उन पर अचानक आ पड़ता है।<verse eid="ECC 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 9:13" />मैंने संसार में<note caller="+" style="f"><char style="fr" closed="false">9:13 </char><char style="ft" closed="false">अक्षरशः सूर्य के नीचे</char></note> बुद्धि का एक उदाहरण भी देखा है, जिससे मैं बहुत प्रभावित हुआ। <verse eid="ECC 9:13" /><verse number="14" style="v" sid="ECC 9:14" />एक छोटा नगर था जिसमें थोड़े से लोग रहते थे। एक बड़े राजा ने उस पर चढ़ाई करके उसे घेर लिया, और उसके विरुद्ध बड़ा मोर्चा बाँधा। <verse eid="ECC 9:14" /><verse number="15" style="v" sid="ECC 9:15" />परंतु उसमें एक दरिद्र बुद्धिमान पुरुष था जिसने उस नगर को अपनी बुद्धि से बचा लिया; फिर भी किसी ने उस दरिद्र को स्मरण न रखा। <verse eid="ECC 9:15" /><verse number="16" style="v" sid="ECC 9:16" />तब मैंने कहा, “बल से बुद्धि उत्तम है।” परंतु दरिद्र की बुद्धि तुच्छ समझी जाती है और उसकी बातों पर कोई ध्यान नहीं देता।<verse eid="ECC 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ECC 9:17" />मूर्खों पर प्रभुता करनेवाले की चिल्लाहट की अपेक्षा बुद्धिमानों द्वारा शांति से कहे गए वचन अधिक ग्रहणयोग्य हैं। <verse eid="ECC 9:17" /><verse number="18" style="v" sid="ECC 9:18" />युद्ध के हथियारों से बुद्धि उत्तम है, परंतु एक पापी बहुत से भले कार्यों को नष्‍ट कर देता है।<verse eid="ECC 9:18" /></para>
  <chapter eid="ECC 9" />
  <chapter number="10" style="c" sid="ECC 10" />
  <para style="s1">मूर्खता का बोझ</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 10:1" />मरी हुई मक्खियों के कारण सुगंधित तेल भी सड़ जाता है और उसमें से दुर्गंध आने लगती है। इसी प्रकार थोड़ी सी मूर्खता बुद्धि और प्रतिष्‍ठा को घटा देती है। <verse eid="ECC 10:1" /><verse number="2" style="v" sid="ECC 10:2" />बुद्धिमान का मन उचित बात की ओर लगा रहता है, परंतु मूर्ख का मन उसके विपरीत रहता है। <verse eid="ECC 10:2" /><verse number="3" style="v" sid="ECC 10:3" />मार्ग पर चलते हुए भी मूर्ख में समझ का अभाव होता है, और वह सब को दिखा देता है कि वह मूर्ख है।<verse eid="ECC 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 10:4" />यदि शासक का क्रोध तुझ पर भड़के तो अपना स्थान न छोड़ना, क्योंकि संयम रखने से बड़े-बड़े अपराध रुक जाते हैं।<verse eid="ECC 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ECC 10:5" />मैंने संसार में एक बुराई देखी है जो शासक की भूल से उत्पन्‍न होती है : <verse eid="ECC 10:5" /><verse number="6" style="v" sid="ECC 10:6" />मूर्खों को कई उच्‍च स्थानों पर स्थापित किया जाता है, जबकि धनवान लोग निम्‍‍न स्थानों पर बैठते हैं। <verse eid="ECC 10:6" /><verse number="7" style="v" sid="ECC 10:7" />मैंने दासों को घोड़ों पर सवार, और राजकुमारों को दासों के समान भूमि पर पैदल चलते देखा है।<verse eid="ECC 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 10:8" />जो गड्‌ढा खोदेगा वह उसी में गिर पड़ेगा, और जो दीवार में सेंध लगाएगा उसे सर्प डसेगा। <verse eid="ECC 10:8" /><verse number="9" style="v" sid="ECC 10:9" />जो खदान से पत्थर निकालता है, वह उसी से घायल होगा, और जो लकड़ी चीरता है, उसे उसी से खतरा होगा। <verse eid="ECC 10:9" /><verse number="10" style="v" sid="ECC 10:10" />यदि कुल्हाड़ी में धार न हो और मनुष्य उसे पैनी न करे, तो उसे अधिक बल लगाना पड़ेगा; परंतु सफलता के लिए बुद्धि लाभदायक होती है। <verse eid="ECC 10:10" /><verse number="11" style="v" sid="ECC 10:11" />यदि सपेरे द्वारा मंत्र-मुग्ध किए जाने से पहले ही साँप डस ले तो उसे कोई लाभ नहीं।<verse eid="ECC 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 10:12" />बुद्धिमान के मुख से निकले वचन कृपा का कारण होते हैं, परंतु मूर्ख के होंठ उसके विनाश का कारण बनते हैं; <verse eid="ECC 10:12" /><verse number="13" style="v" sid="ECC 10:13" />उसके मुख से निकली बातों का आरंभ मूर्खतापूर्ण, और उनका अंत भारी पागलपन होता है। <verse eid="ECC 10:13" /><verse number="14" style="v" sid="ECC 10:14" />मूर्ख बातें बढ़ाकर बोलता है। कोई मनुष्य नहीं जानता कि कल क्या होगा, और न ही कोई यह बता सकता है कि उसके बाद क्या होने वाला है। <verse eid="ECC 10:14" /><verse number="15" style="v" sid="ECC 10:15" />मूर्ख का परिश्रम उसे इतना थका देता है कि उसे यह भी नहीं सूझता कि नगर में कैसे जाए।<verse eid="ECC 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 10:16" />हे देश, तुझ पर हाय, क्योंकि तेरा राजा बच्‍चा है, और तेरे प्रधान सवेरे उठते ही दावत उड़ाने लगते हैं। <verse eid="ECC 10:16" /><verse number="17" style="v" sid="ECC 10:17" />हे देश, तू धन्य है, क्योंकि तेरा राजा कुलीन घराने का है, और तेरे प्रधान समय पर भोज करते हैं, और वह भी मतवाले होने के लिए नहीं, बल्कि बल बढ़ाने के लिए।<verse eid="ECC 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 10:18" />आलस्य के कारण छत की कड़ियाँ दब जाती हैं, और हाथों की सुस्ती से घर चूता है। <verse eid="ECC 10:18" /><verse number="19" style="v" sid="ECC 10:19" />भोज हँसी खुशी के लिए किया जाता है, और दाखमधु जीवन को आनंद से भर देता है; और रुपयों से सब कुछ प्राप्‍त हो जाता है। <verse eid="ECC 10:19" /><verse number="20" style="v" sid="ECC 10:20" />तू अपने मन में भी राजा को शाप न दे, और न किसी धनवान को अपने शयनकक्ष में शाप दे; क्योंकि आकाश का पक्षी तेरी वाणी को ले उड़ेगा, और उड़नेवाला पक्षी तेरी बात को प्रकट कर देगा।<verse eid="ECC 10:20" /></para>
  <chapter eid="ECC 10" />
  <chapter number="11" style="c" sid="ECC 11" />
  <para style="s1">बुद्धिमान का आचरण</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 11:1" />अपनी रोटी जल की सतह पर डाल दे, क्योंकि बहुत दिन के बाद तू उसे फिर पाएगा। <verse eid="ECC 11:1" /><verse number="2" style="v" sid="ECC 11:2" />अपना भाग सात बल्कि आठ जनों को बाँट दे, क्योंकि तू नहीं जानता कि पृथ्वी पर क्या विपत्ति आ पड़ेगी। <verse eid="ECC 11:2" /><verse number="3" style="v" sid="ECC 11:3" />यदि बादल पानी से भरे हैं, तो वे पृथ्वी पर बरसते हैं। वृक्ष चाहे दक्षिण की ओर गिरे या उत्तर की ओर, वह जहाँ गिरता है वहीं पड़ा रहता है। <verse eid="ECC 11:3" /><verse number="4" style="v" sid="ECC 11:4" />जो वायु को ताकता रहता है, वह बीज नहीं बो पाता; और जो बादलों को देखता रहता है, वह लवने नहीं पाता। <verse eid="ECC 11:4" /><verse number="5" style="v" sid="ECC 11:5" />जैसे तू वायु का मार्ग नहीं जानता और न यह जानता है कि स्‍त्री के गर्भ में हड्डियाँ कैसे बढ़ती हैं, वैसे ही तू परमेश्‍वर का कार्य नहीं जानता जो सब कुछ रचता है।<verse eid="ECC 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ECC 11:6" />तू भोर को अपना बीज बो, और साँझ को भी अपना हाथ न रोक; क्योंकि तू नहीं जानता कि कौन सा सफल होगा, यह या वह, अथवा दोनों के दोनों एक समान अच्छे निकलेंगे। <verse eid="ECC 11:6" /><verse number="7" style="v" sid="ECC 11:7" />उजियाला मनभावना होता है, और सूर्य का प्रकाश देखकर आँखें प्रसन्‍न‍ हो जाती हैं। <verse eid="ECC 11:7" /><verse number="8" style="v" sid="ECC 11:8" />यदि मनुष्य बहुत वर्षों तक जीवित रहे तो वह उन सब में आनंदित रहे, परंतु यह भी स्मरण रखे कि अंधकार के दिन भी बहुत होंगे। जो कुछ भी होने वाला है, वह व्यर्थ है।<verse eid="ECC 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 11:9" />हे जवान, अपनी जवानी में आनंद कर, और तेरी जवानी के दिनों में तेरा हृदय तुझे प्रसन्‍न रखे; अपने मन और अपनी आँखों की अभिलाषा के अनुसार चल। परंतु स्मरण रख कि इन सब बातों के विषय परमेश्‍वर तेरा न्याय करेगा। <verse eid="ECC 11:9" /><verse number="10" style="v" sid="ECC 11:10" />अपने मन से दुःख और अपनी देह से कष्‍ट को दूर कर, क्योंकि लड़कपन और जवानी दोनों क्षणभंगुर हैं।<verse eid="ECC 11:10" /></para>
  <chapter eid="ECC 11" />
  <chapter number="12" style="c" sid="ECC 12" />
  <para style="s1">जवान को सलाह</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 12:1" />अपनी जवानी के दिनों में अपने सृजनहार को स्मरण रख : इससे पहले कि विपत्ति के दिन आएँ और ऐसे वर्ष आ पहुँचें जिनमें तू कहे कि मेरा मन इनमें नहीं लगता; <verse eid="ECC 12:1" /><verse number="2" style="v" sid="ECC 12:2" />इससे पहले कि सूर्य और प्रकाश और चंद्रमा और तारागण अंधकारमय हो जाएँ, और वर्षा के बाद बादल फिर से घिर आएँ; <verse eid="ECC 12:2" /><verse number="3" style="v" sid="ECC 12:3" />इससे पहले कि घर के रखवाले काँपें, बलवान पुरुष झुक जाएँ, पीसनेवालियाँ थोड़ी होने के कारण कार्य करना बंद कर दें, और झरोखों में से झाँकनेवालियों की आँखें धुंधली पड़ जाएँ; <verse eid="ECC 12:3" /><verse number="4" style="v" sid="ECC 12:4" />इससे पहले कि गली के द्वार बंद हो जाएँ और चक्‍की की आवाज़ धीमी हो जाए, और कोई व्यक्‍ति चिड़ियों के चहचहाने पर जाग उठे, तथा गानेवालियों का स्वर धीमा हो जाए; <verse eid="ECC 12:4" /><verse number="5" style="v" sid="ECC 12:5" />इससे पहले कि वे ऊँचाई से और सड़क के खतरों से डरें, बादाम के वृक्ष में फूल खिले, उन्हें टिड्डी भी भारी लगे, और उनकी इच्छाएँ मरने लगें; क्योंकि मनुष्य तो अपने अनंत निवास में चला जाएगा और शोक करनेवाले सड़कों पर फिरेंगे। <verse eid="ECC 12:5" /><verse number="6" style="v" sid="ECC 12:6" />इससे पहले कि चाँदी का तार दो टुकड़े हो जाए, तथा सोने का कटोरा टूट जाए, सोते के पास रखा घड़ा फूट जाए, और कुएँ का रहट टूट जाए; <verse eid="ECC 12:6" /><verse number="7" style="v" sid="ECC 12:7" />तब मिट्टी ज्यों की त्यों भूमि में मिल जाएगी, और आत्मा परमेश्‍वर के पास जिसने उसे दिया, लौट जाएगी। <verse eid="ECC 12:7" /><verse number="8" style="v" sid="ECC 12:8" />उपदेशक कहता है, “व्यर्थ ही व्यर्थ! सब कुछ व्यर्थ है!”<verse eid="ECC 12:8" /></para>
  <para style="s1">उपदेशक के उद्देश्य और मनुष्य का संपूर्ण कर्तव्य</para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 12:9" />उपदेशक न केवल बुद्धिमान था बल्कि वह लोगों को ज्ञान की बातें भी सिखाता था; उसने बहुत से नीतिवचनों पर चिंतन किया, उनकी जाँच-पड़ताल की, और उन्हें क्रम में रखा। <verse eid="ECC 12:9" /><verse number="10" style="v" sid="ECC 12:10" />उपदेशक ने बड़ा यत्‍न करके मनोहर वचनों को प्राप्‍त किया और सीधाई से उन सत्य वचनों को लिख दिया।<verse eid="ECC 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 12:11" />बुद्धिमानों के वचन अंकुश के समान और संकलित वचन सीधी ठोंकी हुई कीलों के समान होते हैं—ये वचन एक ही चरवाहे के द्वारा प्रदान किए गए हैं।<verse eid="ECC 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 12:12" />हे मेरे पुत्र, इन्हें छोड़ अन्य शिक्षाओं से चौकस रह। अनेक पुस्तकों की रचना का अंत नहीं होता, और बहुत पढ़ना देह को थका देता है।<verse eid="ECC 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 12:13" />जब सब कुछ सुन लिया गया है तो निष्कर्ष यह है : परमेश्‍वर का भय मान और उसकी आज्ञाओं का पालन कर, क्योंकि यही मनुष्य का संपूर्ण कर्त्तव्य है। <verse eid="ECC 12:13" /><verse number="14" style="v" sid="ECC 12:14" />क्योंकि परमेश्‍वर प्रत्येक कार्य और प्रत्येक गुप्‍त बात का, चाहे वह भली हो या बुरी, न्याय करेगा।<verse eid="ECC 12:14" /></para>
  <chapter eid="ECC 12" />
</usx>